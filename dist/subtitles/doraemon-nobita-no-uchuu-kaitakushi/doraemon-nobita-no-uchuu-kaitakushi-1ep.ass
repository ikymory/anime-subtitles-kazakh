Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:26.81,0:00:31.82,Default,,0,0,0,,♪〜
Dialogue: 0,0:01:04.60,0:01:10.61,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:26.87,0:01:28.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:36.63,0:01:37.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:38.47,0:01:39.47,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:01:39.76,0:01:43.18,Default,,0,0,0,,Уф... Мен қашып құтыла алмаймын. Айналайық.
Dialogue: 0,0:01:43.31,0:01:44.43,Default,,0,0,0,,Е, бұл қауіпті.
Dialogue: 0,0:01:44.89,0:01:46.94,Default,,0,0,0,,Олар өлтіргеннен жақсы
Dialogue: 0,0:01:47.06,0:01:48.90,Default,,0,0,0,,Күту режимі
Dialogue: 0,0:01:52.15,0:01:53.53,Default,,0,0,0,,Мен не болатынын білмеймін
Dialogue: 0,0:01:53.94,0:01:55.07,Default,,0,0,0,,Энергия заряды ОК
Dialogue: 0,0:01:55.65,0:01:56.44,Default,,0,0,0,,Бұрыс!
Dialogue: 0,0:02:07.41,0:02:12.04,Default,,0,0,0,,Цк, сіз гиперкеңістікке тап болдыңыз, ақымақтар.
Dialogue: 0,0:02:12.38,0:02:15.09,Default,,0,0,0,,Жоғары жылдамдықта бұрылып, қауіпсіз кетуге мүмкіндік жоқ.
Dialogue: 0,0:02:15.21,0:02:15.96,Default,,0,0,0,,Ит!? Әрине, мүмкін емес—осы ит!?
Dialogue: 0,0:02:27.89,0:02:29.81,Default,,0,0,0,,Ахх...
Dialogue: 0,0:02:35.28,0:02:39.74,Default,,0,0,0,,Жо… Жосукэнің жарақаты…
Dialogue: 0,0:02:39.86,0:02:41.70,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:02:41.82,0:02:46.12,Default,,0,0,0,,Нобита-кун Нобита-кун, оян!
Dialogue: 0,0:02:53.08,0:02:54.88,Default,,0,0,0,,Неге сонша аңырап қалдың?
Dialogue: 0,0:02:55.00,0:02:56.34,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:02:56.46,0:02:57.63,Default,,0,0,0,,Сонымен не!
Dialogue: 0,0:02:58.38,0:03:02.59,Default,,0,0,0,,Иә, мен түс көрдім. Бұл ғылыми фантастика сияқты.
Dialogue: 0,0:03:02.72,0:03:05.05,Default,,0,0,0,,Бірақ бұл өте айқын түс.
Dialogue: 0,0:03:05.18,0:03:06.06,Default,,0,0,0,,Иә
Dialogue: 0,0:03:06.18,0:03:10.27,Default,,0,0,0,,А, Джианның шұғыл ісі бар, сондықтан дереу бос жерге келіңіз.
Dialogue: 0,0:03:10.39,0:03:13.52,Default,,0,0,0,,Джан? Мен бұл не деп ойлаймын ...
Dialogue: 0,0:03:14.31,0:03:18.36,Default,,0,0,0,,Ол ұзақ уақыт бойы біздің Алпауыттардың мекені болды.
Dialogue: 0,0:03:18.48,0:03:20.49,Default,,0,0,0,,Бізді қуып жібер.
Dialogue: 0,0:03:20.99,0:03:22.57,Default,,0,0,0,,Мұндай өзімшіл нәрсе...
Dialogue: 0,0:03:22.70,0:03:24.53,Default,,0,0,0,,Сіз мұны өзімшілдік деп ойлайсыз, солай емес пе?
Dialogue: 0,0:03:24.66,0:03:25.45,Default,,0,0,0,,Иә
Dialogue: 0,0:03:25.95,0:03:27.33,Default,,0,0,0,,Кез келген адам осылай ойлайды.
Dialogue: 0,0:03:27.45,0:03:29.41,Default,,0,0,0,,Үндемей қала аламыз ба?
Dialogue: 0,0:03:30.00,0:03:31.29,Default,,0,0,0,,Жақсы емес!
Dialogue: 0,0:03:31.41,0:03:36.38,Default,,0,0,0,,Басқа адам орта мектеп оқушысы ма, жоқ па, қарамастан, біз өз құқығымызды берік қорғауымыз керек.
Dialogue: 0,0:03:36.50,0:03:38.00,Default,,0,0,0,,Күткендей хаха
Dialogue: 0,0:03:38.13,0:03:40.67,Default,,0,0,0,,Біз күткен нәрселер бар.
Dialogue: 0,0:03:40.80,0:03:46.43,Default,,0,0,0,,Сіз Гиганттардың өкілі болып, орта мектеп оқушыларымен келіссөздер жүргізуге таңдалдыңыз!
Dialogue: 0,0:03:46.55,0:03:47.60,Default,,0,0,0,,О, солай…
Dialogue: 0,0:03:48.26,0:03:51.60,Default,,0,0,0,,Жарайсың ба? Жауапкершілікті мойныңызға алып, бос жерді қайтарып аласыз.
Dialogue: 0,0:03:51.73,0:03:54.65,Default,,0,0,0,,Әйтпесе, мен сені бұдан былай командаға қоспаймын.
Dialogue: 0,0:03:54.77,0:03:55.48,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:03:55.61,0:03:58.98,Default,,0,0,0,,Уф, сәл күте тұрыңыз, аа... хмм...
Dialogue: 0,0:03:59.11,0:04:01.44,Default,,0,0,0,,Яна рөлі маған бірден мәжбүр болады.
Dialogue: 0,0:04:02.24,0:04:04.82,Default,,0,0,0,,Не! Осы бос жерді қайтарғыңыз келе ме?
Dialogue: 0,0:04:04.99,0:04:05.87,Default,,0,0,0,,Иә Иә Иә
Dialogue: 0,0:04:05.99,0:04:09.37,Default,,0,0,0,,Бейсбол командасы болса, мектеп алаңында ойнаса...
Dialogue: 0,0:04:09.49,0:04:11.08,Default,,0,0,0,,Біз бейсбол клубы емеспіз.
Dialogue: 0,0:04:11.20,0:04:12.58,Default,,0,0,0,,Жоқ, жоқ, жоқ (Кіші мектеп оқушысы В) Үйге бар, үйге бар.
Dialogue: 0,0:04:13.16,0:04:14.33,Default,,0,0,0,,Егер сіз кірсеңіз...
Dialogue: 0,0:04:14.46,0:04:15.96,Default,,0,0,0,,Олар мені кіргізбейді.
Dialogue: 0,0:04:16.08,0:04:18.29,Default,,0,0,0,,Хмм... О, түсіндім.
Dialogue: 0,0:04:18.42,0:04:21.71,Default,,0,0,0,,Мен бейсболды жақсы көремін, бірақ мен оны ойнағаным сонша, олар мені кіргізбейді ме?
Dialogue: 0,0:04:21.84,0:04:23.47,Default,,0,0,0,,О, о, рах...
Dialogue: 0,0:04:23.59,0:04:25.72,Default,,0,0,0,,Бізді ең қызықтыратын нәрсе...
Dialogue: 0,0:04:25.84,0:04:26.76,Default,,0,0,0,,Сіз маған айттыңыз.
Dialogue: 0,0:04:27.35,0:04:29.26,Default,,0,0,0,,Уау, кешіріңіз!
Dialogue: 0,0:04:29.89,0:04:33.18,Default,,0,0,0,,Күте тұрыңыз, сәлем
Dialogue: 0,0:04:33.43,0:04:35.27,Default,,0,0,0,,Маған көмектесіңізші...
Dialogue: 0,0:04:35.40,0:04:38.73,Default,,0,0,0,,Ой және...
Dialogue: 0,0:04:38.86,0:04:40.73,Default,,0,0,0,,Иә, иә, ә
Dialogue: 0,0:04:41.69,0:04:42.69,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:04:42.82,0:04:44.28,Default,,0,0,0,,Жылдам жүгіруші
Dialogue: 0,0:04:44.40,0:04:45.11,Default,,0,0,0,,Менің қашып кетуіме жол берме.
Dialogue: 0,0:04:45.24,0:04:46.49,Default,,0,0,0,,Балалар, соны іздеңдер.
Dialogue: 0,0:04:46.61,0:04:47.28,Default,,0,0,0,,О
Dialogue: 0,0:04:48.41,0:04:50.58,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:04:52.50,0:04:54.71,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:05:05.05,0:05:07.39,Default,,0,0,0,,Му Му
Dialogue: 0,0:05:08.39,0:05:10.14,Default,,0,0,0,,Роль…
Dialogue: 0,0:05:10.26,0:05:12.22,Default,,0,0,0,,Сәлем Чумми
Dialogue: 0,0:05:12.35,0:05:15.39,Default,,0,0,0,,Түсіндім, сіз бүгілу кезінде орныңыздан лақтырылды.
Dialogue: 0,0:05:15.98,0:05:17.85,Default,,0,0,0,,Бұл үлкен мәселе. Не болып жатыр?
Dialogue: 0,0:05:17.98,0:05:21.61,Default,,0,0,0,,Бұл! Ах, міне...
Dialogue: 0,0:05:26.07,0:05:29.49,Default,,0,0,0,,Ол гиперкеңістікте тоқтатылды. Ол бұзылған.
Dialogue: 0,0:05:30.66,0:05:33.95,Default,,0,0,0,,Өйткені, жоғары жылдамдықпен ұшып бара жатқанда бұрылу мүмкін емес еді.
Dialogue: 0,0:05:34.83,0:05:37.67,Default,,0,0,0,,Мынаны қарашы, сен мені тыңдамайсың.
Dialogue: 0,0:05:38.25,0:05:40.54,Default,,0,0,0,,Бұлай айтатын уақыт емес.
Dialogue: 0,0:05:41.09,0:05:43.00,Default,,0,0,0,,Мен оны қандай да бір жолмен түзетуім керек.
Dialogue: 0,0:05:47.34,0:05:48.72,Default,,0,0,0,,Оңай түзетілсе екен.
Dialogue: 0,0:05:57.94,0:05:59.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:04.19,0:06:07.65,Default,,0,0,0,,Бұл жер қойма болуы керек, бірақ ол қайда?
Dialogue: 0,0:06:08.36,0:06:09.03,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:06:09.16,0:06:12.62,Default,,0,0,0,,(Лоплдың жөтелі)
Dialogue: 0,0:06:14.54,0:06:16.79,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:16.91,0:06:20.92,Default,,0,0,0,,Қойма есігі мен бұрын көрмеген әлемге ашылды.
Dialogue: 0,0:06:21.04,0:06:22.25,Default,,0,0,0,,А...
Dialogue: 0,0:06:28.80,0:06:32.26,Default,,0,0,0,,Сонымен, сіз қалай ойлайсыз? Ақаулық түзетіледі ме?
Dialogue: 0,0:06:32.93,0:06:35.93,Default,,0,0,0,,Эй, үйге барсақ болады ма? Үйге бара алмайсың ба?
Dialogue: 0,0:06:36.06,0:06:37.68,Default,,0,0,0,,Шулы! (Мамми) Му...
Dialogue: 0,0:06:38.35,0:06:40.56,Default,,0,0,0,,Тыныш, Чумми.
Dialogue: 0,0:06:40.69,0:06:42.86,Default,,0,0,0,,Мен бұл не екенін білмеймін.
Dialogue: 0,0:06:42.98,0:06:45.69,Default,,0,0,0,,Мен дұрыс ойлай алмаймын.
Dialogue: 0,0:06:46.69,0:06:48.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:48.65,0:06:51.36,Default,,0,0,0,,Ой...
Dialogue: 0,0:06:51.53,0:06:53.70,Default,,0,0,0,,Корат Нобита (Нобита) уау
Dialogue: 0,0:06:53.83,0:06:55.12,Default,,0,0,0,,күрсіну... Ах.
Dialogue: 0,0:06:55.87,0:06:57.91,Default,,0,0,0,,Егер сіз тым кеш деп ойласаңыз
Dialogue: 0,0:06:58.04,0:07:00.04,Default,,0,0,0,,Сіз әлсіреп қалдыңыз.
Dialogue: 0,0:07:00.16,0:07:02.04,Default,,0,0,0,,Мен барып, дұрыс келіссөз жүргіздім.
Dialogue: 0,0:07:02.63,0:07:05.04,Default,,0,0,0,,Сонымен, бос жер сізге қайтарылды, солай ма?
Dialogue: 0,0:07:05.17,0:07:09.13,Default,,0,0,0,,Өзіңнің айтқаның дұрыс деп батыл айтқан жоқсың ба?
Dialogue: 0,0:07:09.26,0:07:10.59,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:11.76,0:07:14.18,Default,,0,0,0,,Олар бейсболды жақсы көретіндерін айтады.
Dialogue: 0,0:07:14.55,0:07:16.93,Default,,0,0,0,,Мен де солаймын. Мұның мәні неде?
Dialogue: 0,0:07:17.06,0:07:19.98,Default,,0,0,0,,Аа, сіз жақсы болдыңыз.
Dialogue: 0,0:07:20.10,0:07:21.31,Default,,0,0,0,,Бұл... тым қатты!
Dialogue: 0,0:07:21.44,0:07:22.60,Default,,0,0,0,,Пайдасыз!
Dialogue: 0,0:07:22.77,0:07:24.56,Default,,0,0,0,,О, маған көмектес, маған көмектес...
Dialogue: 0,0:07:24.69,0:07:27.61,Default,,0,0,0,,Күте тұрыңыз! Алдамаңыз!
Dialogue: 0,0:07:27.73,0:07:28.94,Default,,0,0,0,,Уау
Dialogue: 0,0:07:29.57,0:07:30.57,Default,,0,0,0,,Корат Нобита
Dialogue: 0,0:07:30.70,0:07:32.49,Default,,0,0,0,,Күтіңіз.
Dialogue: 0,0:07:34.16,0:07:36.03,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:07:36.16,0:07:38.49,Default,,0,0,0,,Ой...
Dialogue: 0,0:07:38.62,0:07:40.33,Default,,0,0,0,,Сізді тағы да қуып жатыр ма?
Dialogue: 0,0:07:40.46,0:07:42.00,Default,,0,0,0,,Бұл жігіттер қорқынышты.
Dialogue: 0,0:07:42.29,0:07:44.38,Default,,0,0,0,,Не болды? Бірге
Dialogue: 0,0:07:44.50,0:07:47.04,Default,,0,0,0,,Шидзука-чан ғана мейірімді.
Dialogue: 0,0:07:47.17,0:07:50.30,Default,,0,0,0,,Джиан орта мектеп оқушыларынан бос жерді қайтарып ала алмаса ше?
Dialogue: 0,0:07:50.42,0:07:52.05,Default,,0,0,0,,Мені кінәлаңыз
Dialogue: 0,0:07:52.18,0:07:53.51,Default,,0,0,0,,Ал... (Сунео) О, болды.
Dialogue: 0,0:07:53.63,0:07:55.89,Default,,0,0,0,,Ах (Сунео) Мен оның осындай жерде екенін білдім.
Dialogue: 0,0:07:56.01,0:07:57.89,Default,,0,0,0,,Эй, Нобита, мен сенің қашып кетуіңе жол бермеймін.
Dialogue: 0,0:07:58.01,0:07:59.02,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:59.14,0:08:01.31,Default,,0,0,0,,Эй Таке-кун, Сунео-кун
Dialogue: 0,0:08:01.43,0:08:04.27,Default,,0,0,0,,Жауапкершілікті жалғыз Нобита-кунға жүктегенім үшін өзімді жаман сезінемін.
Dialogue: 0,0:08:04.40,0:08:05.48,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,0:08:05.61,0:08:06.81,Default,,0,0,0,,Қайта тексеріңіз
Dialogue: 0,0:08:06.94,0:08:09.07,Default,,0,0,0,,Бұл әркімнің проблемасы, солай ма?
Dialogue: 0,0:08:09.19,0:08:11.90,Default,,0,0,0,,Сабырлырақ сөйлесейік
Dialogue: 0,0:08:12.24,0:08:13.95,Default,,0,0,0,,Бұл туралы айтсақ та
Dialogue: 0,0:08:14.07,0:08:15.78,Default,,0,0,0,,Оның орнын толтыратын бос жер жоқ.
Dialogue: 0,0:08:15.91,0:08:17.91,Default,,0,0,0,,Эй, сенде қандай да бір ой бар ма?
Dialogue: 0,0:08:18.03,0:08:18.95,Default,,0,0,0,,Міне, міне, міне
Dialogue: 0,0:08:19.08,0:08:22.58,Default,,0,0,0,,Хм... Аа, солай. Дораэмоннан бірдеңе істеуін сұрайық.
Dialogue: 0,0:08:22.71,0:08:23.87,Default,,0,0,0,,Атты...
Dialogue: 0,0:08:24.17,0:08:25.29,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:25.42,0:08:28.79,Default,,0,0,0,,Эй, эй, Нобита-кун, менен сұрап көріңізші, эй, эй.
Dialogue: 0,0:08:28.92,0:08:30.25,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:31.96,0:08:34.22,Default,,0,0,0,,Жарайды, қалжыңдама.
Dialogue: 0,0:08:34.59,0:08:37.47,Default,,0,0,0,,Мен тіпті бос жерді құра алмаймын.
Dialogue: 0,0:08:37.60,0:08:40.01,Default,,0,0,0,,Мен мұны айтасыз деп ойладым, бірақ бірдеңе жасаңыз.
Dialogue: 0,0:08:40.14,0:08:41.97,Default,,0,0,0,,Дораемон мұны істей алмайды.
Dialogue: 0,0:08:42.10,0:08:45.35,Default,,0,0,0,,Егер сіз мұны істей алмасаңыз, онда мен сізден қате сұрап тұрмын.
Dialogue: 0,0:08:45.48,0:08:47.48,Default,,0,0,0,,Барлығы осылай дейді
Dialogue: 0,0:08:47.61,0:08:49.65,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:08:49.77,0:08:52.65,Default,,0,0,0,,Айтсаң да, іздесең де.
Dialogue: 0,0:08:53.32,0:08:55.45,Default,,0,0,0,,Егер жер бейсбол ойнауға жеткілікті үлкен болса...
Dialogue: 0,0:08:55.57,0:08:58.95,Default,,0,0,0,,Біреу оны әлдеқашан бірдеңе үшін пайдаланған болуы керек.
Dialogue: 0,0:09:02.83,0:09:04.04,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:09:04.33,0:09:07.21,Default,,0,0,0,,Жапония кішкентай.
Dialogue: 0,0:09:09.04,0:09:12.92,Default,,0,0,0,,Егер бұл жұлдыз алыс жерде болса, ол жерде болмас еді.
Dialogue: 0,0:09:13.05,0:09:13.71,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:09:13.84,0:09:15.34,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:09:16.22,0:09:18.05,Default,,0,0,0,,А, сен ұйықтайсың ба?
Dialogue: 0,0:09:18.18,0:09:19.85,Default,,0,0,0,,Бұл туралы жалғыз ойланыңыз
Dialogue: 0,0:09:20.76,0:09:21.81,Default,,0,0,0,,Өтінемін, Дораемон
Dialogue: 0,0:09:22.27,0:09:23.47,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:09:23.60,0:09:27.27,Default,,0,0,0,,Уау, бұл маған көмектесті. Уау, уф...
Dialogue: 0,0:09:28.77,0:09:32.82,Default,,0,0,0,,Мен қиыншылыққа тап болдым деді.
Dialogue: 0,0:09:34.24,0:09:37.24,Default,,0,0,0,,А, мұның бәрі тамақ үшін.
Dialogue: 0,0:09:37.78,0:09:43.20,Default,,0,0,0,,Ғарышқа аттанғанда кем дегенде бір айлық қорыңыз болуы керек.
Dialogue: 0,0:09:44.04,0:09:47.16,Default,,0,0,0,,Мен бүгін кешке үйге баруым керек еді.
Dialogue: 0,0:09:47.29,0:09:50.67,Default,,0,0,0,,Сонымен қатар, сізде мұндай қосымша тағам бар ма?
Dialogue: 0,0:09:50.79,0:09:53.17,Default,,0,0,0,,Коя Коя планетасының барлығы аш.
Dialogue: 0,0:09:53.96,0:09:57.38,Default,,0,0,0,,А, мен қойма есігінің сыртын зерттеймін.
Dialogue: 0,0:09:57.51,0:09:59.68,Default,,0,0,0,,Жейтін бірдеңе болуы мүмкін
Dialogue: 0,0:09:59.80,0:10:02.01,Default,,0,0,0,,Жүр, сұмдық ауа тұншығып қалады.
Dialogue: 0,0:10:02.14,0:10:03.72,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:07.14,0:10:12.98,Default,,0,0,0,,Уф, уф, былай көрінсе де, адамнан күшті...
Dialogue: 0,0:10:16.86,0:10:22.16,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:10:22.28,0:10:23.41,Default,,0,0,0,,Хмм… (соққы дыбысы)
Dialogue: 0,0:10:23.53,0:10:25.54,Default,,0,0,0,,Ой, бұл жер сілкінісі, жер сілкінісі, жер сілкінісі, жер сілкінісі
Dialogue: 0,0:10:26.04,0:10:28.00,Default,,0,0,0,,Не? Жер сілкінісі? Ах
Dialogue: 0,0:10:28.91,0:10:30.46,Default,,0,0,0,,Нобитаға не болды?
Dialogue: 0,0:10:30.75,0:10:31.83,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:10:31.96,0:10:33.88,Default,,0,0,0,,Ахх... Иә?
Dialogue: 0,0:10:34.00,0:10:35.34,Default,,0,0,0,,Ой...
Dialogue: 0,0:10:35.71,0:10:36.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:36.55,0:10:37.55,Default,,0,0,0,,Бұл ештеңе емес, солай ма?
Dialogue: 0,0:10:37.67,0:10:39.38,Default,,0,0,0,,Жоқ, ол... сөзсіз дірілдеп кетті.
Dialogue: 0,0:10:39.59,0:10:41.26,Default,,0,0,0,,Мен тағы да жартылай ұйықтап жатырмын.
Dialogue: 0,0:10:41.39,0:10:43.35,Default,,0,0,0,,Түннің бір уағында неге шулайсың?
Dialogue: 0,0:10:43.85,0:10:46.31,Default,,0,0,0,,Бұл шынымен де жер сілкінісі болды, сеніңіз.
Dialogue: 0,0:10:46.72,0:10:48.02,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:10:48.14,0:10:51.02,Default,,0,0,0,,Сау болыңыз және ерте ұйықтаңыз.
Dialogue: 0,0:10:51.94,0:10:55.61,Default,,0,0,0,,Әке, ана, рас болса!
Dialogue: 0,0:10:55.73,0:10:58.40,Default,,0,0,0,,Балаңызға енді сене алмайсыз ба?
Dialogue: 0,0:10:58.53,0:11:03.53,Default,,0,0,0,,Оған көмектесу мүмкін емес. Жартылай ұйықтау маған ата-анамнан қалған нәрсе...
Dialogue: 0,0:11:07.87,0:11:09.66,Default,,0,0,0,,Мен жартылай ұйықтап жатқан шығармын.
Dialogue: 0,0:11:10.58,0:11:13.58,Default,,0,0,0,,(Чуммидің айқайы)
Dialogue: 0,0:11:14.92,0:11:15.75,Default,,0,0,0,,Музыка…
Dialogue: 0,0:11:16.59,0:11:18.76,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:18.76,0:11:19.80,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:18.76,0:11:19.80,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:11:19.80,0:11:21.51,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:21.51,0:11:21.88,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:21.51,0:11:21.88,Default,,0,0,0,,Уау! маған көмектес
Dialogue: 0,0:11:21.88,0:11:25.05,Default,,0,0,0,,Уау! маған көмектес
Dialogue: 0,0:11:26.72,0:11:29.77,Default,,0,0,0,,Додо додо... Дораемон!
Dialogue: 0,0:11:29.89,0:11:31.81,Default,,0,0,0,,Шулы
Dialogue: 0,0:11:31.94,0:11:34.65,Default,,0,0,0,,Бір нәрсе... дададада...
Dialogue: 0,0:11:35.19,0:11:37.69,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:11:37.82,0:11:40.28,Default,,0,0,0,,Татамиден бірдеңе секірді
Dialogue: 0,0:11:40.40,0:11:42.20,Default,,0,0,0,,Онда ештеңе жоқ, солай ма?
Dialogue: 0,0:11:42.32,0:11:42.99,Default,,0,0,0,,О, сонда!
Dialogue: 0,0:11:43.11,0:11:44.45,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:11:47.49,0:11:52.37,Default,,0,0,0,,(шу)
Dialogue: 0,0:12:03.59,0:12:05.59,Default,,0,0,0,,А, түсінде... А?
Dialogue: 0,0:12:07.81,0:12:10.14,Default,,0,0,0,,Ааа!
Dialogue: 0,0:12:10.27,0:12:11.18,Default,,0,0,0,,Фунгияа
Dialogue: 0,0:12:17.65,0:12:18.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:18.94,0:12:20.99,Default,,0,0,0,,Бұл жердегі жануар емес.
Dialogue: 0,0:12:21.11,0:12:22.03,Default,,0,0,0,,Саған қашып кетуге рұқсат етемін бе?
Dialogue: 0,0:12:22.15,0:12:23.53,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:23.65,0:12:25.07,Default,,0,0,0,,Карс Супер Ажаны іздеді —
Dialogue: 0,0:12:25.41,0:12:27.45,Default,,0,0,0,,Күте тұрыңыз! Корра!
Dialogue: 0,0:12:27.70,0:12:29.03,Default,,0,0,0,,Күтіңіз, күтіңіз!
Dialogue: 0,0:12:29.95,0:12:31.04,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:31.16,0:12:33.16,Default,,0,0,0,,Ugh (Нобита) ittetetete
Dialogue: 0,0:12:39.04,0:12:40.30,Default,,0,0,0,,Ақырында мен оны ұстадым.
Dialogue: 0,0:12:40.42,0:12:42.55,Default,,0,0,0,,Сіз өте әлсіз сияқтысыз.
Dialogue: 0,0:12:42.67,0:12:46.09,Default,,0,0,0,,Енді жоқ, ауа нашар, тұншығып бара жатқандай болдым.
Dialogue: 0,0:12:46.22,0:12:46.89,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:12:47.22,0:12:51.02,Default,,0,0,0,,А-а, күмән жоқ, бұл арман шындық еді.
Dialogue: 0,0:12:51.14,0:12:52.35,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:12:52.93,0:12:56.31,Default,,0,0,0,,Эй, сенімді болу үшін сенің жаныңда басқа адам болды ғой, солай ма?
Dialogue: 0,0:12:56.69,0:13:00.15,Default,,0,0,0,,Ой, сен Роппуру-кунды білесің бе?
Dialogue: 0,0:13:00.73,0:13:02.40,Default,,0,0,0,,Иә, мен нақты білемін.
Dialogue: 0,0:13:02.53,0:13:05.45,Default,,0,0,0,,Енді еркін сөйлесіңіз.
Dialogue: 0,0:13:05.57,0:13:08.87,Default,,0,0,0,,Мен тамақ іздеу үшін ғарыш кемесінің есігін ашқанда...
Dialogue: 0,0:13:09.45,0:13:11.41,Default,,0,0,0,,Мен бұл жерге келдім
Dialogue: 0,0:13:11.54,0:13:15.41,Default,,0,0,0,,Мұндай ғарыш кемесі еш жерде жоқ.
Dialogue: 0,0:13:15.54,0:13:17.54,Default,,0,0,0,,Өйткені бұл шындық
Dialogue: 0,0:13:18.46,0:13:20.88,Default,,0,0,0,,Олай болса мені сол ғарыш кемесіне апарыңыз.
Dialogue: 0,0:13:23.92,0:13:26.13,Default,,0,0,0,,Ух, ғарыш кемесі қоймасының есігі...
Dialogue: 0,0:13:26.26,0:13:27.84,Default,,0,0,0,,Сізді осында әкелді ме?
Dialogue: 0,0:13:29.43,0:13:31.56,Default,,0,0,0,,Ғарыш кемесін армандағаным үшін бе?
Dialogue: 0,0:13:33.31,0:13:36.44,Default,,0,0,0,,Түсіндім, біз бір-бірімізді телепатиялық түрде шақырған болуымыз керек.
Dialogue: 0,0:13:36.56,0:13:37.73,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,0:13:37.85,0:13:38.56,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:13:39.31,0:13:41.19,Default,,0,0,0,,Ааааааааххх...
Dialogue: 0,0:13:42.02,0:13:42.90,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:13:43.03,0:13:44.86,Default,,0,0,0,,Иә... әйтеуір.
Dialogue: 0,0:13:44.99,0:13:46.03,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:13:46.15,0:13:48.66,Default,,0,0,0,,Тесіктен өткенде тік және көлденең жақтары әртүрлі болады.
Dialogue: 0,0:13:48.78,0:13:49.95,Default,,0,0,0,,Бұл біршама күрделі.
Dialogue: 0,0:13:50.07,0:13:53.08,Default,,0,0,0,,Уау, тутто... аа
Dialogue: 0,0:13:53.20,0:13:53.91,Default,,0,0,0,,Біртүрлі сезім
Dialogue: 0,0:13:54.04,0:13:56.04,Default,,0,0,0,,Ол бұралып, бір-біріне жабысып қалған болуы керек.
Dialogue: 0,0:13:56.16,0:13:58.17,Default,,0,0,0,,А...
Dialogue: 0,0:13:58.62,0:14:00.54,Default,,0,0,0,,Ауа өте сергітеді.
Dialogue: 0,0:14:00.67,0:14:02.88,Default,,0,0,0,,Расында да жер өте лас.
Dialogue: 0,0:14:03.34,0:14:05.67,Default,,0,0,0,,Енді мен осының үстіндемін.
Dialogue: 0,0:14:08.47,0:14:09.34,Default,,0,0,0,,Йойшо Йойшо
Dialogue: 0,0:14:09.47,0:14:12.26,Default,,0,0,0,,Йотто... уф
Dialogue: 0,0:14:15.72,0:14:18.14,Default,,0,0,0,,Чумми, бұл адамдар мен роботтар кімдер?
Dialogue: 0,0:14:18.69,0:14:20.56,Default,,0,0,0,,Сіз Роппуру-кунсыз ба?
Dialogue: 0,0:14:20.69,0:14:23.07,Default,,0,0,0,,Менің атым Нобита. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:14:23.19,0:14:24.73,Default,,0,0,0,,Мен Дораемонмын
Dialogue: 0,0:14:24.86,0:14:27.28,Default,,0,0,0,,Жердегі аздап танымал робот
Dialogue: 0,0:14:27.40,0:14:32.41,Default,,0,0,0,,Не? Жер? Бұл мен ешқашан естімеген жұлдыз.
Dialogue: 0,0:14:32.53,0:14:34.87,Default,,0,0,0,,Күн жүйесіндегі үшінші планетаны білесіңдер.
Dialogue: 0,0:14:35.29,0:14:37.83,Default,,0,0,0,,Әй, бұл мен түсімде көрген ғарыш кемесі ғой.
Dialogue: 0,0:14:38.37,0:14:39.50,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:14:39.62,0:14:43.29,Default,,0,0,0,,Мен Коя Коя планетасына бет алдым, бірақ бұл қойма есігінің сыртындағы Жер ме?
Dialogue: 0,0:14:43.50,0:14:46.76,Default,,0,0,0,,Мен Коя Коя сияқты жұлдызды естімеппін.
Dialogue: 0,0:14:46.88,0:14:50.26,Default,,0,0,0,,Бұл бір-бірінен өте алыс орналасқан жұлдыздардың...
Dialogue: 0,0:14:50.38,0:14:52.01,Default,,0,0,0,,Мен қондыруды аяқтадым.
Dialogue: 0,0:14:52.14,0:14:53.51,Default,,0,0,0,,Түсіндің бе? Нобита-кун
Dialogue: 0,0:14:53.64,0:14:54.68,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:14:54.81,0:14:55.76,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:14:56.72,0:14:58.48,Default,,0,0,0,,Бәлкім, мен бұрылыстан өтпеген шығармын—
Dialogue: 0,0:14:58.60,0:15:01.77,Default,,0,0,0,,Гиперкеңістіктің бұрмалану қисығы бұрмаланған сияқты.
Dialogue: 0,0:15:01.90,0:15:03.86,Default,,0,0,0,,Бұл мүмкін емес еді.
Dialogue: 0,0:15:03.98,0:15:04.73,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:05.52,0:15:08.49,Default,,0,0,0,,Біз бұл туралы аздап айтып отырмыз, бірақ деформация дегеніміз не?
Dialogue: 0,0:15:08.61,0:15:11.24,Default,,0,0,0,,Білесіз бе, ол ғылыми фантастикада жиі кездеседі.
Dialogue: 0,0:15:11.36,0:15:15.12,Default,,0,0,0,,Хмм... Мен бұл туралы естідім, бірақ мен оны түсінбеймін.
Dialogue: 0,0:15:15.24,0:15:17.54,Default,,0,0,0,,Қарапайым тілмен айтқанда, оның мағынасы осы
Dialogue: 0,0:15:17.66,0:15:22.71,Default,,0,0,0,,Жұлдыздар арасындағы қашықтық жүздеген мың жарық жылына тең.
Dialogue: 0,0:15:22.83,0:15:27.21,Default,,0,0,0,,Сонымен біз қайта-қайта бұрылып, кеңістікте алға жылжамыз.
Dialogue: 0,0:15:27.80,0:15:30.84,Default,,0,0,0,,Ол орасан зор энергияны зарядтайды.
Dialogue: 0,0:15:30.97,0:15:33.18,Default,,0,0,0,,Механизм ұзаққа бармайды және оңай бұзылады.
Dialogue: 0,0:15:33.93,0:15:36.47,Default,,0,0,0,,Бірақ ғарыш кемесі істен шықты...
Dialogue: 0,0:15:36.60,0:15:38.93,Default,,0,0,0,,Жерге неліктен бекітілген?
Dialogue: 0,0:15:39.06,0:15:41.77,Default,,0,0,0,,Егер бұл белдеу ғалам болса...
Dialogue: 0,0:15:41.89,0:15:46.27,Default,,0,0,0,,Бұл ғарыш кемесі мен Жердің осылай бұралғанын білдіре ме?
Dialogue: 0,0:15:46.77,0:15:48.73,Default,,0,0,0,,Жоқ, мен мұны түсінбеймін.
Dialogue: 0,0:15:48.86,0:15:51.99,Default,,0,0,0,,Айтайын дегенім, барлық жер есік сияқты.
Dialogue: 0,0:15:52.53,0:15:55.20,Default,,0,0,0,,Есік сынды, мен аштым...
Dialogue: 0,0:15:55.32,0:15:57.95,Default,,0,0,0,,Мен күтпеген жерде қалдым.
Dialogue: 0,0:15:58.16,0:16:01.54,Default,,0,0,0,,Не? Сіз мұны басынан айтуыңыз керек еді.
Dialogue: 0,0:16:01.66,0:16:04.71,Default,,0,0,0,,Бірақ уайымдамаңыз, Дораэмон оны түзетеді.
Dialogue: 0,0:16:04.83,0:16:05.50,Default,,0,0,0,,Хехехе
Dialogue: 0,0:16:09.67,0:16:13.30,Default,,0,0,0,,Менің ойымша, өлшемді діріл басы білігі бұралған.
Dialogue: 0,0:16:13.43,0:16:15.47,Default,,0,0,0,,Әй, керемет меха
Dialogue: 0,0:16:16.05,0:16:18.60,Default,,0,0,0,,Мен не болып жатқанын білмеймін.
Dialogue: 0,0:16:19.10,0:16:23.64,Default,,0,0,0,,Бірақ бұл машина сынғанға дейін сынған жоқ, солай ма?
Dialogue: 0,0:16:23.77,0:16:27.90,Default,,0,0,0,,Ашық нәрселерді айтпа, сен шынымен солайсың
Dialogue: 0,0:16:28.02,0:16:29.82,Default,,0,0,0,,Көремін, фурошики уақытында
Dialogue: 0,0:16:30.40,0:16:32.61,Default,,0,0,0,,Дұрыс, оны қайта өзгертіңіз.
Dialogue: 0,0:16:32.74,0:16:34.11,Default,,0,0,0,,Иә, жасап көрейік.
Dialogue: 0,0:16:34.24,0:16:35.78,Default,,0,0,0,,Уақыт Фурошики!
Dialogue: 0,0:16:36.24,0:16:37.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:38.41,0:16:41.70,Default,,0,0,0,,Бұл тез арада түзетеді деп үміттенемін.
Dialogue: 0,0:16:42.75,0:16:45.50,Default,,0,0,0,,Рахмет, ол жөнделгенше күтуім керек.
Dialogue: 0,0:16:45.62,0:16:48.09,Default,,0,0,0,,Келіңіздер! (3 адам) А
Dialogue: 0,0:16:48.21,0:16:49.50,Default,,0,0,0,,Бұл Чумми
Dialogue: 0,0:16:49.63,0:16:50.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:50.88,0:16:52.92,Default,,0,0,0,,Кеттік (Дораэмон/Нобита) Иә
Dialogue: 0,0:16:57.05,0:16:57.85,Default,,0,0,0,,Анашым!
Dialogue: 0,0:16:58.26,0:16:59.47,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:16:59.60,0:17:00.39,Default,,0,0,0,,Бұл жұлдызды аспан
Dialogue: 0,0:17:00.51,0:17:01.56,Default,,0,0,0,,Ол бекітілген.
Dialogue: 0,0:17:01.68,0:17:03.81,Default,,0,0,0,,Иә, мен гиперкеңістіктен құтылдым.
Dialogue: 0,0:17:04.23,0:17:08.27,Default,,0,0,0,,Хаха, қарашы, жұлдызымыз жақын
Dialogue: 0,0:17:12.23,0:17:14.11,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:14.24,0:17:16.41,Default,,0,0,0,,Коя Коя жұлдызы?
Dialogue: 0,0:17:16.74,0:17:19.91,Default,,0,0,0,,Өйткені, мұның бәрі Дораемонның фурошикі уақытының арқасында.
Dialogue: 0,0:17:20.03,0:17:24.91,Default,,0,0,0,,Хи хи хи, енді бұл ғарыш кемесі Коякоя планетасына оралуы мүмкін.
Dialogue: 0,0:17:25.04,0:17:28.38,Default,,0,0,0,,Күте тұрыңыз, сонда татамидегі тесік жоғалады!
Dialogue: 0,0:17:28.50,0:17:29.33,Default,,0,0,0,,О, солай!
Dialogue: 0,0:17:29.59,0:17:33.26,Default,,0,0,0,,(Екі дүрбелең дауысы)
Dialogue: 0,0:17:33.76,0:17:35.63,Default,,0,0,0,,Ахх (Нобита) Уау, уау
Dialogue: 0,0:17:37.55,0:17:40.64,Default,,0,0,0,,Уф... хмм...
Dialogue: 0,0:17:45.23,0:17:47.48,Default,,0,0,0,,Жақсы, біз әлі де байланыстамыз.
Dialogue: 0,0:17:47.60,0:17:48.85,Default,,0,0,0,,Мен қазір асығып тұрмын.
Dialogue: 0,0:17:48.98,0:17:51.15,Default,,0,0,0,,Бірақ бұл ғарыш кемесі қозғалса да
Dialogue: 0,0:17:51.27,0:17:52.90,Default,,0,0,0,,Неліктен тек осында ғана қосылған?
Dialogue: 0,0:17:53.36,0:17:56.86,Default,,0,0,0,,Келіңіздер, мен де білмеймін.
Dialogue: 0,0:17:56.99,0:18:01.53,Default,,0,0,0,,Менің ойымша, бұралған кеңістіктің кейбір бөлігі әлі де тұрып қалды.
Dialogue: 0,0:18:01.66,0:18:03.49,Default,,0,0,0,,Қандай да бір күшпен
Dialogue: 0,0:18:04.12,0:18:05.29,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:18:05.41,0:18:06.46,Default,,0,0,0,,(Лоплдың жөтелі)
Dialogue: 0,0:18:06.58,0:18:07.46,Default,,0,0,0,,Бөлінген...
Dialogue: 0,0:18:07.58,0:18:08.71,Default,,0,0,0,,(Лоплдың жөтелі)
Dialogue: 0,0:18:08.83,0:18:11.13,Default,,0,0,0,,Жердің ауасы сізге жарамайды.
Dialogue: 0,0:18:11.25,0:18:12.75,Default,,0,0,0,,Есікті қазір жапқаныңыз жөн.
Dialogue: 0,0:18:13.09,0:18:16.42,Default,,0,0,0,,Иә, барлығы үшін рахмет. Мен сені ешқашан ұмытпаймын.
Dialogue: 0,0:18:16.55,0:18:17.80,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:18:17.93,0:18:19.68,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:18:19.80,0:18:21.76,Default,,0,0,0,,Чумми, мен сені түсімде тағы көремін.
Dialogue: 0,0:18:21.89,0:18:23.60,Default,,0,0,0,,Му Му
Dialogue: 0,0:18:23.72,0:18:26.02,Default,,0,0,0,,Нобита-кун, біздің планетаға кел
Dialogue: 0,0:18:26.14,0:18:27.23,Default,,0,0,0,,Иә, егер барсам.
Dialogue: 0,0:18:27.35,0:18:28.23,Default,,0,0,0,,Келетініңізге сенімдімін.
Dialogue: 0,0:18:28.35,0:18:29.52,Default,,0,0,0,,Иә, мен міндетті түрде барамын.
Dialogue: 0,0:18:29.65,0:18:30.35,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:18:30.48,0:18:31.48,Default,,0,0,0,,Мен күтетініме сенімдімін.
Dialogue: 0,0:18:31.61,0:18:32.40,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:18:32.90,0:18:33.69,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:18:33.82,0:18:35.19,Default,,0,0,0,,Қош бол
Dialogue: 0,0:18:50.04,0:18:51.58,Default,,0,0,0,,Хи хи хи хи хи хи
Dialogue: 0,0:18:51.71,0:18:54.29,Default,,0,0,0,,...
Dialogue: 0,0:19:05.35,0:19:10.44,Default,,0,0,0,,Бұл бөлмедегі татами төсеніші алыс жұлдызды аспан арқылы саяхаттап бара жатқан ғарыш кемесіне жалғанған.
Dialogue: 0,0:19:10.56,0:19:12.23,Default,,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 0,0:19:30.79,0:19:32.88,Default,,0,0,0,,...
Dialogue: 0,0:19:33.00,0:19:35.59,Default,,0,0,0,,Бос жерге не болғанын сұрағым келді.
Dialogue: 0,0:19:35.71,0:19:38.13,Default,,0,0,0,,Ол сабақтан кейін жоғалып кетті.
Dialogue: 0,0:19:39.13,0:19:40.59,Default,,0,0,0,,Қауіпті Қауіпті
Dialogue: 0,0:19:50.48,0:19:53.73,Default,,0,0,0,,А... Біраз уақытты өлтіріп, үйге қайтайық.
Dialogue: 0,0:19:54.73,0:20:01.20,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:20:06.45,0:20:10.16,Default,,0,0,0,,Менің ойымша, Жапониядағы ғарыш кемесі елге аман-есен жетті ме?
Dialogue: 0,0:20:10.29,0:20:13.79,Default,,0,0,0,,(Кіші мектеп оқушыларының дыбыстары)
Dialogue: 0,0:20:14.83,0:20:16.34,Default,,0,0,0,,Кіші орта мектеп аяқталды
Dialogue: 0,0:20:16.46,0:20:18.75,Default,,0,0,0,,Кешегі топтағы адамдармен кездесу қиын болар еді.
Dialogue: 0,0:20:18.88,0:20:21.26,Default,,0,0,0,,Айналмалы жолмен үйге қайтайық.
Dialogue: 0,0:20:24.13,0:20:28.93,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:20:29.06,0:20:30.14,Default,,0,0,0,,Ақыры үйге аман-есен жетті
Dialogue: 0,0:20:30.27,0:20:32.43,Default,,0,0,0,,тым кеш, солай емес пе?
Dialogue: 0,0:20:32.56,0:20:33.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:34.19,0:20:35.15,Default,,0,0,0,,Сәлем Нобита
Dialogue: 0,0:20:35.27,0:20:37.23,Default,,0,0,0,,Менің ойымша, сіз Дораэмоннан дұрыс сұрадыңыз.
Dialogue: 0,0:20:37.48,0:20:39.23,Default,,0,0,0,,Ал... бұл қазірдің өзінде... әрине.
Dialogue: 0,0:20:39.36,0:20:40.94,Default,,0,0,0,,Сіз сұраған шығарсыз.
Dialogue: 0,0:20:41.07,0:20:41.74,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:20:41.86,0:20:43.15,Default,,0,0,0,,Оның растығын тексеріңіз
Dialogue: 0,0:20:43.28,0:20:44.20,Default,,0,0,0,,Келіңіздер (Нобита) Ах!
Dialogue: 0,0:20:50.41,0:20:51.91,Default,,0,0,0,,Иә? Дораемон
Dialogue: 0,0:20:52.04,0:20:53.41,Default,,0,0,0,,Ол жерде жоқ.
Dialogue: 0,0:20:53.54,0:20:54.79,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:20:54.92,0:20:56.83,Default,,0,0,0,,Не болды? (Нобита) Ауырады, ауырады, ауырады
Dialogue: 0,0:20:56.96,0:20:59.21,Default,,0,0,0,,Мен оның бос жерді іздегеніне сенімдімін.
Dialogue: 0,0:20:59.34,0:21:00.05,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:21:00.17,0:21:00.92,Default,,0,0,0,,Иә
Dialogue: 0,0:21:01.17,0:21:03.63,Default,,0,0,0,,Иә, бұл қызық.
Dialogue: 0,0:21:03.76,0:21:04.84,Default,,0,0,0,,Дораемон күткендей
Dialogue: 0,0:21:05.26,0:21:08.68,Default,,0,0,0,,Хехехе, Дораемон оны міндетті түрде табады.
Dialogue: 0,0:21:08.80,0:21:11.81,Default,,0,0,0,,Маған біреу сенім артса, қиын болар еді.
Dialogue: 0,0:21:12.22,0:21:14.52,Default,,0,0,0,,Ах (Сунео) Бар емес пе?
Dialogue: 0,0:21:14.64,0:21:16.19,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:21:16.31,0:21:20.44,Default,,0,0,0,,Мен тығылғандай емес, жай ғана ойланып қалдым.
Dialogue: 0,0:21:20.57,0:21:22.53,Default,,0,0,0,,Эй, эй, Дораемон, сен ойға келдің бе?
Dialogue: 0,0:21:22.65,0:21:24.24,Default,,0,0,0,,Мен сенетін жалғыз адамсың
Dialogue: 0,0:21:24.36,0:21:25.11,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:21:25.24,0:21:27.53,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:21:27.66,0:21:28.45,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:21:28.70,0:21:30.91,Default,,0,0,0,,Ей, берілме, айтшы.
Dialogue: 0,0:21:31.03,0:21:31.95,Default,,0,0,0,,Бос жер қай жерде?
Dialogue: 0,0:21:32.58,0:21:35.37,Default,,0,0,0,,Мен бос жерді ала алмаймын, бірақ мен мұнымен келісемін.
Dialogue: 0,0:21:36.25,0:21:38.17,Default,,0,0,0,,Шағын ойнатқыш!
Dialogue: 0,0:21:38.29,0:21:39.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:39.13,0:21:40.50,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:21:40.96,0:21:44.92,Default,,0,0,0,,Ойнатқыштың түймешігін сүйікті орында басқан кезде—
Dialogue: 0,0:21:45.05,0:21:46.51,Default,,0,0,0,,Итерген адамның денесіне айналады
Dialogue: 0,0:21:46.76,0:21:48.84,Default,,0,0,0,,Әй, қайсысы?
Dialogue: 0,0:21:49.97,0:21:50.97,Default,,0,0,0,,Уау, бұл рас!
Dialogue: 0,0:21:51.39,0:21:53.43,Default,,0,0,0,,Бейсболды өз қалауыңызша ойнай аласыз.
Dialogue: 0,0:21:53.56,0:21:54.68,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:21:54.81,0:21:58.23,Default,,0,0,0,,Бірақ жақсы адамдардың қуыршақтары жақсырақ
Dialogue: 0,0:21:58.35,0:22:00.73,Default,,0,0,0,,Басқа қуыршақтар
Dialogue: 0,0:22:00.86,0:22:02.82,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:22:03.19,0:22:07.90,Default,,0,0,0,,Қуыршақпен ойнау маған бәрібір, жерді не істейміз?
Dialogue: 0,0:22:08.03,0:22:09.87,Default,,0,0,0,,Міне!
Dialogue: 0,0:22:11.66,0:22:12.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:12.87,0:22:13.95,Default,,0,0,0,,Шағын стадион!
Dialogue: 0,0:22:14.08,0:22:15.08,Default,,0,0,0,,Уау, өте керемет
Dialogue: 0,0:22:15.20,0:22:17.79,Default,,0,0,0,,Осының көмегімен сіз әрқашан өз үйіңізде ойнай аласыз.
Dialogue: 0,0:22:18.17,0:22:20.04,Default,,0,0,0,,А... Мен мүлде түсінбеймін.
Dialogue: 0,0:22:20.17,0:22:23.75,Default,,0,0,0,,Біз мұны өзіміз жасағымыз келеді, осы өлшемде.
Dialogue: 0,0:22:24.00,0:22:27.42,Default,,0,0,0,,Түсіндім, түсіндім, мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:22:27.55,0:22:28.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:28.51,0:22:31.68,Default,,0,0,0,,Бұл қызық сияқты, сондықтан мен оны қарызға аламын.
Dialogue: 0,0:22:31.80,0:22:34.47,Default,,0,0,0,,Нахахаха...
Dialogue: 0,0:22:35.35,0:22:36.31,Default,,0,0,0,,Не?
Dialogue: 0,0:22:36.43,0:22:37.93,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:22:38.23,0:22:39.56,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:22:39.69,0:22:43.36,Default,,0,0,0,,Енді мен не істеуім керек? Мен шығындамын.
Dialogue: 0,0:22:46.61,0:22:48.99,Default,,0,0,0,,Қош бол Нобита-кун
Dialogue: 0,0:22:50.57,0:22:52.07,Default,,0,0,0,,Келетініңізге сенімдімін
Dialogue: 0,0:22:52.20,0:22:52.87,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:22:55.08,0:22:57.16,Default,,0,0,0,,Сен аман-есен келдің бе?
Dialogue: 0,0:22:57.29,0:22:58.25,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:22:58.37,0:23:02.79,Default,,0,0,0,,Бірақ татами кенет секіріп кеткенде таң қалдым.
Dialogue: 0,0:23:02.92,0:23:04.88,Default,,0,0,0,,Иә, дәл осы жерде.
Dialogue: 0,0:23:07.80,0:23:09.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:09.67,0:23:11.01,Default,,0,0,0,,Не болды?
Dialogue: 0,0:23:11.13,0:23:14.18,Default,,0,0,0,,Аа, есік әлі бекітілген...
Dialogue: 0,0:23:14.30,0:23:16.97,Default,,0,0,0,,Ғарыш кемесіне әлі де қосылды
Dialogue: 0,0:23:17.10,0:23:18.56,Default,,0,0,0,,Ал...
Dialogue: 0,0:23:26.44,0:23:27.86,Default,,0,0,0,,Жер бетінде не болды?
Dialogue: 0,0:23:27.98,0:23:30.49,Default,,0,0,0,,Роппуру-кун және басқалары үйлеріне кетуі керек еді.
Dialogue: 0,0:23:32.03,0:23:32.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:34.78,0:23:35.62,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:23:35.74,0:23:38.25,Default,,0,0,0,,Ангарға ұқсайды.
Dialogue: 0,0:23:38.45,0:23:39.83,Default,,0,0,0,,Мен қонамын.
Dialogue: 0,0:23:39.96,0:23:41.25,Default,,0,0,0,,Сыртқа шығайық
Dialogue: 0,0:23:41.37,0:23:42.08,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:23:44.25,0:23:45.54,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:23:45.67,0:23:48.05,Default,,0,0,0,,Эй (Нобита) Қайдасың?
Dialogue: 0,0:23:48.92,0:23:50.17,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:23:55.60,0:23:56.97,Default,,0,0,0,,Иә? Шығу жоқ
Dialogue: 0,0:23:57.10,0:23:58.22,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:23:59.56,0:24:01.69,Default,,0,0,0,,Бұл қандай қосқыш?
Dialogue: 0,0:24:01.81,0:24:02.56,Default,,0,0,0,,Уау
Dialogue: 0,0:24:02.69,0:24:05.27,Default,,0,0,0,,Уф, уф, нана... Бұл не?
Dialogue: 0,0:24:05.40,0:24:06.27,Default,,0,0,0,,«Донэван мырза, сіз мүлде дұрыс айтасыз» де.
Dialogue: 0,0:24:06.40,0:24:08.11,Default,,0,0,0,,Жиренішті~
Dialogue: 0,0:24:08.23,0:24:08.98,Default,,0,0,0,,Бұл лифт.
Dialogue: 0,0:24:09.11,0:24:13.82,Default,,0,0,0,,(Таңданған екі дауыс)
Dialogue: 0,0:24:13.95,0:24:16.41,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:24:17.08,0:24:18.62,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:24:18.83,0:24:20.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:26.33,0:24:27.88,Default,,0,0,0,,Уау...
Dialogue: 0,0:24:28.80,0:24:33.34,Default,,0,0,0,,♪〜
Dialogue: 0,0:24:55.11,0:24:59.53,Default,,0,0,0,,Көк ай мен қызыл ай, сондықтан күлгін жарық
Dialogue: 0,0:24:59.66,0:25:02.70,Default,,0,0,0,,Әдемі, бірақ екі ай болса, қорқынышты.
Dialogue: 0,0:25:02.83,0:25:04.04,Default,,0,0,0,,Иә
Dialogue: 0,0:25:06.54,0:25:08.29,Default,,0,0,0,,Бұл сіздің планетаңыз ба?
Dialogue: 0,0:25:08.42,0:25:10.80,Default,,0,0,0,,Иә, бұл Коя Коя жұлдызы сияқты.
Dialogue: 0,0:25:12.34,0:25:16.26,Default,,0,0,0,,Бірақ бізде қала былай тұрсын, бірде-бір үй жоқ.
Dialogue: 0,0:25:17.26,0:25:17.84,Default,,0,0,0,,Иә...
Dialogue: 0,0:25:17.84,0:25:18.01,Default,,0,0,0,,Иә...
Dialogue: 0,0:25:17.84,0:25:18.01,Default,,0,0,0,,〜♪
Dialogue: 0,0:25:18.01,0:25:18.14,Default,,0,0,0,,〜♪
Dialogue: 0,0:25:18.14,0:25:19.93,Default,,0,0,0,,〜♪
Dialogue: 0,0:25:18.14,0:25:19.93,Default,,0,0,0,,Не болды, Дораемон?
Dialogue: 0,0:25:19.93,0:25:20.06,Default,,0,0,0,,〜♪
Dialogue: 0,0:25:20.06,0:25:22.18,Default,,0,0,0,,〜♪
Dialogue: 0,0:25:20.06,0:25:22.18,Default,,0,0,0,,Егер бүкіл планета бос жер болса...
Dialogue: 0,0:25:22.18,0:25:22.31,Default,,0,0,0,,〜♪
Dialogue: 0,0:25:22.31,0:25:23.68,Default,,0,0,0,,〜♪
Dialogue: 0,0:25:22.31,0:25:23.68,Default,,0,0,0,,Түсінемін, егер біз бұл жерді бос жер етсек.
Dialogue: 0,0:25:23.68,0:25:25.14,Default,,0,0,0,,Түсінемін, егер біз бұл жерді бос жер етсек.
Dialogue: 0,0:25:25.27,0:25:27.52,Default,,0,0,0,,Сіз кез келген нәрсені істей аласыз, тіпті бейсбол.
Dialogue: 0,0:25:27.65,0:25:29.36,Default,,0,0,0,,Мен оны таптым. Апыр-ай!
Dialogue: 0,0:25:29.36,0:25:29.81,Default,,0,0,0,,Мен оны таптым. Апыр-ай!
Dialogue: 0,0:25:29.36,0:25:29.81,Default,,0,0,0,,(топырақтың көтерілу дыбысы)
Dialogue: 0,0:25:29.81,0:25:29.94,Default,,0,0,0,,(Топырақтың көтерілу дыбысы)
Dialogue: 0,0:25:29.94,0:25:30.65,Default,,0,0,0,,(Топырақтың көтерілу дыбысы)
Dialogue: 0,0:25:29.94,0:25:30.65,Default,,0,0,0,,А... (Нобита) Иә?
Dialogue: 0,0:25:30.65,0:25:31.48,Default,,0,0,0,,А... (Нобита) Иә?
Dialogue: 0,0:25:34.82,0:25:35.57,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,0:25:35.78,0:25:38.28,Default,,0,0,0,,Не... Не? Ах... Не... Не?
Dialogue: 0,0:25:47.04,0:25:48.54,Default,,0,0,0,,Аа, дәл осы.
Dialogue: 0,0:25:48.67,0:25:50.29,Default,,0,0,0,,Бұл ағаш бақа.
Dialogue: 0,0:25:51.54,0:25:55.34,Default,,0,0,0,,(Қабырғадағы бақа жылайды)
Dialogue: 0,0:25:55.59,0:25:58.55,Default,,0,0,0,,Уау, бұл жиіркенішті.
Dialogue: 0,0:25:55.59,0:25:58.55,Default,,0,0,0,,Уау, адам көп жиналып жатыр.
Dialogue: 0,0:25:59.05,0:26:01.05,Default,,0,0,0,,Тш шш біз жерлеспіз
Dialogue: 0,0:26:01.18,0:26:03.35,Default,,0,0,0,,Сен екеуміз доспыз
Dialogue: 0,0:26:06.14,0:26:07.60,Default,,0,0,0,,(Қабырғадағы бақа жылайды)
Dialogue: 0,0:26:12.32,0:26:13.32,Default,,0,0,0,,Иә? а?
Dialogue: 0,0:26:13.44,0:26:14.86,Default,,0,0,0,,Барлығы қашып кетті.
Dialogue: 0,0:26:14.99,0:26:16.15,Default,,0,0,0,,Не болды?
Dialogue: 0,0:26:16.28,0:26:19.66,Default,,0,0,0,,Иә? Уау
Dialogue: 0,0:26:27.29,0:26:28.83,Default,,0,0,0,,Уау, теңіз жоқ
Dialogue: 0,0:26:28.96,0:26:29.92,Default,,0,0,0,,Бұл үлкен цунами.
Dialogue: 0,0:26:30.04,0:26:31.63,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:26:38.43,0:26:39.51,Default,,0,0,0,,Қаш!
Dialogue: 0,0:26:39.63,0:26:40.43,Default,,0,0,0,,Қайда?
Dialogue: 0,0:26:50.73,0:26:52.65,Default,,0,0,0,,Тек жүгіріңіз
Dialogue: 0,0:26:53.86,0:26:55.90,Default,,0,0,0,,А, мен жете алмаймын.
Dialogue: 0,0:26:56.03,0:26:56.82,Default,,0,0,0,,А, қараңдаршы
Dialogue: 0,0:26:56.94,0:26:59.70,Default,,0,0,0,,Сіз қашан сонша жылдам жүгіре алдыңыз?
Dialogue: 0,0:26:59.82,0:27:01.61,Default,,0,0,0,,Міне!
Dialogue: 0,0:27:02.24,0:27:05.62,Default,,0,0,0,,Қараңызшы, бұл жылдамдық спорт мерекесінде міндетті түрде бірінші орынды алады.
Dialogue: 0,0:27:05.74,0:27:07.58,Default,,0,0,0,,Міне, солай
Dialogue: 0,0:27:07.70,0:27:09.71,Default,,0,0,0,,Itte Itte
Dialogue: 0,0:27:09.83,0:27:12.42,Default,,0,0,0,,Бұл сіздің тым көп сөйлегеніңіз үшін.
Dialogue: 0,0:27:12.54,0:27:14.50,Default,,0,0,0,,Оишо...
Dialogue: 0,0:27:15.17,0:27:17.96,Default,,0,0,0,,(Дораэмон/Нобитаның ауыр тыныс алуы)
Dialogue: 0,0:27:18.80,0:27:21.26,Default,,0,0,0,,Ха, мұнда бәрі жақсы.
Dialogue: 0,0:27:21.38,0:27:22.84,Default,,0,0,0,,Хаа, бұл қорқынышты болды.
Dialogue: 0,0:27:22.97,0:27:23.93,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:27:24.55,0:27:26.43,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:27:26.93,0:27:30.85,Default,,0,0,0,,Уау, дұрыс, мен Takecopter туралы ұмытып кетіппін.
Dialogue: 0,0:27:31.23,0:27:32.56,Default,,0,0,0,,Және... иә
Dialogue: 0,0:27:35.52,0:27:36.52,Default,,0,0,0,,Уау
Dialogue: 0,0:27:37.94,0:27:41.24,Default,,0,0,0,,А, бұл бүкіл планетаны су басқан ба?
Dialogue: 0,0:27:41.53,0:27:44.62,Default,,0,0,0,,Біз келген жерді де шайып кеткен сияқты.
Dialogue: 0,0:27:44.74,0:27:47.70,Default,,0,0,0,,Алдымен мен Роппуру-кунмен және басқалармен кездесуім керек.
Dialogue: 0,0:27:48.70,0:27:51.46,Default,,0,0,0,,Олай десеңіз де, қайда екеніңізді білмеймін.
Dialogue: 0,0:27:51.58,0:27:53.96,Default,,0,0,0,,Сондықтан мен сені іздеп жүрмін, әзірге.
Dialogue: 0,0:27:54.08,0:27:56.54,Default,,0,0,0,,Құтқарушы сал!
Dialogue: 0,0:28:02.43,0:28:03.26,Default,,0,0,0,,Міне кеттік
Dialogue: 0,0:28:03.39,0:28:05.97,Default,,0,0,0,,Эй, бұл жақсы.
Dialogue: 0,0:28:06.60,0:28:09.43,Default,,0,0,0,,Эй Дораемон, сен қазір қайда барасың?
Dialogue: 0,0:28:09.56,0:28:11.23,Default,,0,0,0,,Бұл екі жағдайда да мағынасыз.
Dialogue: 0,0:28:11.77,0:28:14.23,Default,,0,0,0,,Аа, ертең емтиханым бар.
Dialogue: 0,0:28:14.35,0:28:16.90,Default,,0,0,0,,Маған тезірек Жерге қайтып, дайындалу керек.
Dialogue: 0,0:28:17.02,0:28:19.23,Default,,0,0,0,,Сіз бәрібір жақсы баға ала алмайсыз.
Dialogue: 0,0:28:20.57,0:28:22.32,Default,,0,0,0,,Бәрібір ұйықтаңыз
Dialogue: 0,0:28:22.45,0:28:23.61,Default,,0,0,0,,Иә
Dialogue: 0,0:28:29.66,0:28:32.71,Default,,0,0,0,,Анам мен әкем мені сөгетін шығар.
Dialogue: 0,0:28:53.64,0:28:56.65,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:29:08.45,0:29:11.33,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:29:35.52,0:29:37.27,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:29:39.61,0:29:42.23,Default,,0,0,0,,Көктем келді! Көктем келді!
Dialogue: 0,0:29:44.99,0:29:47.99,Default,,0,0,0,,А-а, көп болды. Ақыры көктем.
Dialogue: 0,0:29:48.45,0:29:52.08,Default,,0,0,0,,Күлсін... Сырттың ауасы дәмді ғой.
Dialogue: 0,0:29:54.70,0:29:56.54,Default,,0,0,0,,Қараңдаршы, жақсы топырақ.
Dialogue: 0,0:29:56.66,0:29:59.17,Default,,0,0,0,,Олай болса биыл да мол өнім аламыз.
Dialogue: 0,0:29:59.29,0:30:02.96,Default,,0,0,0,,Роппл Бұл жерде біртүрлі нәрсе бар.
Dialogue: 0,0:30:03.09,0:30:03.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:04.55,0:30:06.67,Default,,0,0,0,,Бұл не, Чумми?
Dialogue: 0,0:30:12.18,0:30:14.43,Default,,0,0,0,,Бұл не? Мен оны бұрын ешқашан көрген емеспін.
Dialogue: 0,0:30:14.56,0:30:15.77,Default,,0,0,0,,Тексеріңіз
Dialogue: 0,0:30:15.89,0:30:16.73,Default,,0,0,0,,Сау бол, Чумми
Dialogue: 0,0:30:16.89,0:30:18.23,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:30:18.35,0:30:19.19,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:30:20.06,0:30:21.15,Default,,0,0,0,,Не болды, Чумми?
Dialogue: 0,0:30:21.27,0:30:22.11,Default,,0,0,0,,Ах
Dialogue: 0,0:30:22.94,0:30:25.94,Default,,0,0,0,,Ахаха Нобита-кун (Нобита) Сәлем Чумми
Dialogue: 0,0:30:26.07,0:30:27.61,Default,,0,0,0,,А, Роппл-кун
Dialogue: 0,0:30:27.74,0:30:29.49,Default,,0,0,0,,Жердегі Нобита-кун Дораемон
Dialogue: 0,0:30:29.82,0:30:30.74,Default,,0,0,0,,Ропле-кун
Dialogue: 0,0:30:30.87,0:30:32.28,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:30:32.41,0:30:34.66,Default,,0,0,0,,Ол кезде бәрі жақсы болды деп үміттенемін.
Dialogue: 0,0:30:34.79,0:30:36.91,Default,,0,0,0,,Ал әйелдер ше?
Dialogue: 0,0:30:37.16,0:30:40.29,Default,,0,0,0,,А, бұл менің анам мен әпкем Клем.
Dialogue: 0,0:30:40.42,0:30:41.92,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:30:42.46,0:30:44.88,Default,,0,0,0,,Сіз маған қауіпті жерде көмектескен сияқтысыз.
Dialogue: 0,0:30:45.00,0:30:46.97,Default,,0,0,0,,Алыс жерге қош келдіңіз
Dialogue: 0,0:30:47.09,0:30:50.26,Default,,0,0,0,,Жоқ, бұл тек татамиді аударып алу.
Dialogue: 0,0:30:50.39,0:30:52.60,Default,,0,0,0,,Бірақ бұл кіреберіс су астында қалды...
Dialogue: 0,0:30:52.72,0:30:55.93,Default,,0,0,0,,Ал, мен жертөледе қалдырған Достықты...
Dialogue: 0,0:31:01.06,0:31:02.44,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,0:31:02.56,0:31:05.98,Default,,0,0,0,,Гараж қалдықтары қазір үлкен шұңқырға айналды.
Dialogue: 0,0:31:06.11,0:31:08.70,Default,,0,0,0,,Мен ол көліксіз ешқайда бара алмаймын.
Dialogue: 0,0:31:08.82,0:31:10.24,Default,,0,0,0,,Мен тіпті егістіктерді өңдей алмаймын.
Dialogue: 0,0:31:10.36,0:31:11.28,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:31:11.41,0:31:15.29,Default,,0,0,0,,Үйіміз боран мен ерте көктемгі су тасқынынан қорғалған.
Dialogue: 0,0:31:15.41,0:31:18.08,Default,,0,0,0,,Бұл арада жер астында көміліп жатыр.
Dialogue: 0,0:31:18.20,0:31:19.71,Default,,0,0,0,,Мен бір жамандық жасадым.
Dialogue: 0,0:31:19.83,0:31:23.75,Default,,0,0,0,,Әй, бұл сенің кінәң емес, бұл жай ғана уақыттың дұрыс еместігі.
Dialogue: 0,0:31:23.88,0:31:26.75,Default,,0,0,0,,Ұлы тасқын шығыстағы ұлы көлден келеді.
Dialogue: 0,0:31:26.88,0:31:29.55,Default,,0,0,0,,Сондықтан оны шайып кетсе, батысқа қарай болар еді.
Dialogue: 0,0:31:29.67,0:31:30.84,Default,,0,0,0,,Енді оны іздеп көрейік
Dialogue: 0,0:31:30.97,0:31:32.39,Default,,0,0,0,,Сау бол, Роппл
Dialogue: 0,0:31:33.01,0:31:34.22,Default,,0,0,0,,Нобита-кун да.
Dialogue: 0,0:31:34.35,0:31:37.35,Default,,0,0,0,,Иә, жоқ, жарайды, хехехехе...
Dialogue: 0,0:31:37.47,0:31:38.89,Default,,0,0,0,,Нобита-кун ұялшақ
Dialogue: 0,0:31:39.02,0:31:41.48,Default,,0,0,0,,Хмф, не?
Dialogue: 0,0:31:41.60,0:31:44.98,Default,,0,0,0,,Эй, мен Takecopter-ді пайдалана аламын ба? иә
Dialogue: 0,0:31:49.49,0:31:52.07,Default,,0,0,0,,Қыс енді ғана өтті, лайдан басқа ештеңе жоқ...
Dialogue: 0,0:31:52.20,0:31:56.53,Default,,0,0,0,,Ертең өсімдіктер бүршік жарып, айналаңыз жасыл желекке оранады.
Dialogue: 0,0:31:56.66,0:31:58.04,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:32:05.13,0:32:06.42,Default,,0,0,0,,Бұл көрші Каморан мырза.
Dialogue: 0,0:32:06.54,0:32:09.51,Default,,0,0,0,,Аа, мынау көрші үй, әлдеқайда алыс.
Dialogue: 0,0:32:09.84,0:32:11.42,Default,,0,0,0,,Қазірдің өзінде егістік жер жыртуда
Dialogue: 0,0:32:11.55,0:32:13.47,Default,,0,0,0,,Сіз еңбекқорсыз, солай емес пе?
Dialogue: 0,0:32:16.14,0:32:17.89,Default,,0,0,0,,Сәлеметсіз бе, Каморан мырза
Dialogue: 0,0:32:18.43,0:32:21.35,Default,,0,0,0,,Эй Роппуру, Жаңа жыл құтты болсын.
Dialogue: 0,0:32:22.27,0:32:23.52,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:32:23.65,0:32:25.15,Default,,0,0,0,,Сәлем Каморан мырза, Бубу.
Dialogue: 0,0:32:25.27,0:32:27.36,Default,,0,0,0,,Біздің Достық мәселесі туралы білмейсіз бе?
Dialogue: 0,0:32:28.07,0:32:29.57,Default,,0,0,0,,Жоқ, мен көрмедім...
Dialogue: 0,0:32:29.69,0:32:30.86,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:32:30.99,0:32:33.32,Default,,0,0,0,,Мен көремін. Мені тасқын шайып кетті...
Dialogue: 0,0:32:33.61,0:32:36.32,Default,,0,0,0,,Сонымен, сендерді топыраққа көмілген күйде табуға болады ма?
Dialogue: 0,0:32:36.45,0:32:38.70,Default,,0,0,0,,Бұл бубу ха...
Dialogue: 0,0:32:38.83,0:32:40.95,Default,,0,0,0,,Жақын арада таппасаң, қиналып қаласың
Dialogue: 0,0:32:41.08,0:32:43.29,Default,,0,0,0,,Жарайды, мен сені кейін іздеймін.
Dialogue: 0,0:32:43.87,0:32:46.63,Default,,0,0,0,,Кешіріңіз, өтінемін.
Dialogue: 0,0:32:50.92,0:32:53.59,Default,,0,0,0,,Мұнда бірнеше ғана үй бар.
Dialogue: 0,0:32:53.72,0:32:55.26,Default,,0,0,0,,Өйткені бұл пионер жұлдызы.
Dialogue: 0,0:32:55.39,0:32:59.01,Default,,0,0,0,,Біз Тоқай Тоқай деген планетада дүниеге келдік...
Dialogue: 0,0:32:59.14,0:33:01.27,Default,,0,0,0,,Орын ғимараттарға толы болды, сондықтан...
Dialogue: 0,0:33:01.39,0:33:04.23,Default,,0,0,0,,Мен осы Коя Коя планетасына көштім.
Dialogue: 0,0:33:08.02,0:33:09.36,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:33:09.48,0:33:13.95,Default,,0,0,0,,Бұдан былай бұл таулы аймақ, тіпті су тасқыны да жетпеуі керек...
Dialogue: 0,0:33:14.07,0:33:15.70,Default,,0,0,0,,Мен мұнда алғаш ретмін, бірақ күтпеген жерден тарлық сезімі мүлде жоқ қой, иә?
Dialogue: 0,0:33:17.82,0:33:19.99,Default,,0,0,0,,А, міне, солай.
Dialogue: 0,0:33:21.95,0:33:23.08,Default,,0,0,0,,Жоқ, жасырын.
Dialogue: 0,0:33:23.20,0:33:24.58,Default,,0,0,0,,Не… не болды? Уау
Dialogue: 0,0:33:24.71,0:33:26.17,Default,,0,0,0,,Біртүрлі үлкен ғарыш кемесі...
Dialogue: 0,0:33:26.29,0:33:28.46,Default,,0,0,0,,Тез, тез, тез, а, а, а
Dialogue: 0,0:33:28.84,0:33:30.25,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:33:30.38,0:33:34.09,Default,,0,0,0,,Бұл бізді қуып жеткен Галтит тау-кен ғарыш кемесі.
Dialogue: 0,0:33:34.22,0:33:35.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:33:35.17,0:33:37.39,Default,,0,0,0,,Бұл таудың ішінде шахта бар.
Dialogue: 0,0:33:37.51,0:33:41.10,Default,,0,0,0,,Ол бізді үнемі қорлап, зорлық көрсетеді.
Dialogue: 0,0:33:41.22,0:33:41.97,Default,,0,0,0,,Хмм.
Dialogue: 0,0:33:42.10,0:33:45.02,Default,,0,0,0,,Бірақ полиция мені жиі кешіреді.
Dialogue: 0,0:33:45.14,0:33:49.40,Default,,0,0,0,,Gartite Mining – штаб-пәтері Токай Токай планетасында орналасқан ірі компания.
Dialogue: 0,0:33:49.52,0:33:52.48,Default,,0,0,0,,Сондықтан полиция дәлелсіз әрекет ете алмайды.
Dialogue: 0,0:33:52.61,0:33:53.57,Default,,0,0,0,,Ха…
Dialogue: 0,0:34:04.25,0:34:05.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:05.16,0:34:08.54,Default,,0,0,0,,Өкінішке орай, бұл планета Гартит массасы.
Dialogue: 0,0:34:08.67,0:34:12.34,Default,,0,0,0,,Олар барлық тұрғындарды қуып шығып, бүкіл планетаны иемденгісі келеді.
Dialogue: 0,0:34:12.59,0:34:14.71,Default,,0,0,0,,Хмм, олар қорқынышты.
Dialogue: 0,0:34:14.84,0:34:17.55,Default,,0,0,0,,Бірақ Гартит дегеніміз не?
Dialogue: 0,0:34:17.68,0:34:20.14,Default,,0,0,0,,Ах, Чумми, ол жерде құлап жатқан жоқ па?
Dialogue: 0,0:34:20.26,0:34:22.68,Default,,0,0,0,,Меу Мия Миям
Dialogue: 0,0:34:23.35,0:34:24.77,Default,,0,0,0,,Бұл галтит.
Dialogue: 0,0:34:24.89,0:34:26.43,Default,,0,0,0,,Бұл әдемі кристалл.
Dialogue: 0,0:34:26.56,0:34:29.31,Default,,0,0,0,,Егер осы кристалдың осін баяу жылжытсақ...
Dialogue: 0,0:34:30.02,0:34:31.31,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:34:32.90,0:34:35.28,Default,,0,0,0,,Қараңыз, кері қайтару энергиясы өндіріледі.
Dialogue: 0,0:34:35.90,0:34:40.07,Default,,0,0,0,,Кристалл өлшемін және ауытқу бұрышын реттеу арқылы еркін реттеуге болады
Dialogue: 0,0:34:40.20,0:34:43.20,Default,,0,0,0,,Өркениетімізге тірек болған асыл кен.
Dialogue: 0,0:34:43.58,0:34:46.16,Default,,0,0,0,,Әй, бұл қызық. Көріп көрейік.
Dialogue: 0,0:34:49.04,0:34:51.29,Default,,0,0,0,,«Kaebuki Tsuyu» әріптерін сұрақ қойып шығара алмаймын
Dialogue: 0,0:34:51.83,0:34:52.84,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,0:34:52.96,0:34:54.05,Default,,0,0,0,,Мен тым алыс ұшып кеттім
Dialogue: 0,0:34:54.17,0:34:55.17,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:34:55.30,0:34:57.22,Default,,0,0,0,,Мен саған мүлдем қамқорлық жасай алмаймын.
Dialogue: 0,0:34:58.51,0:34:59.72,Default,,0,0,0,,Мен қаншалықты алысқа бардым деп ойлаймын
Dialogue: 0,0:35:00.43,0:35:02.10,Default,,0,0,0,,Эй, мен таптым!
Dialogue: 0,0:35:02.22,0:35:03.68,Default,,0,0,0,,А, сол жерде
Dialogue: 0,0:35:04.35,0:35:06.14,Default,,0,0,0,,Гартиттің арқасында мен оны таптым.
Dialogue: 0,0:35:07.64,0:35:08.39,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:35:08.52,0:35:09.81,Default,,0,0,0,,Нобита-кунның да жағдайы жақсы болған сияқты.
Dialogue: 0,0:35:09.94,0:35:11.10,Default,,0,0,0,,Менің жолым болды.
Dialogue: 0,0:35:11.52,0:35:14.27,Default,,0,0,0,,Мені осындай жерге апарып тастағанына сене алар емеспін.
Dialogue: 0,0:35:14.40,0:35:16.65,Default,,0,0,0,,Оның сынғанын тексерейік.
Dialogue: 0,0:35:18.57,0:35:20.53,Default,,0,0,0,,Жақсы сияқты.
Dialogue: 0,0:35:20.66,0:35:21.74,Default,,0,0,0,,Ешқандай ауытқулар жоқ.
Dialogue: 0,0:35:21.86,0:35:22.70,Default,,0,0,0,,(Жан) Эй, бір минут — мұндай жерде шынымен біреу тұра ма?
Dialogue: 0,0:35:22.82,0:35:24.03,Default,,0,0,0,,Енді сіз Жерге орала аласыз.
Dialogue: 0,0:35:24.16,0:35:27.66,Default,,0,0,0,,Ой, бұл жақсы болды, Дораемон
Dialogue: 0,0:35:24.16,0:35:27.66,Default,,0,0,0,,Жақсы, жақсы, жақсы.
Dialogue: 0,0:35:36.59,0:35:37.96,Default,,0,0,0,,Қызыл ай шығып жатыр
Dialogue: 0,0:35:38.09,0:35:41.30,Default,,0,0,0,,Бүгін түн қызыл түн, ертең көк түн
Dialogue: 0,0:35:41.43,0:35:43.93,Default,,0,0,0,,Екі ай өз орнына шығады ма?
Dialogue: 0,0:35:44.05,0:35:44.89,Default,,0,0,0,,Иә, біраз уақытқа.
Dialogue: 0,0:35:45.39,0:35:47.68,Default,,0,0,0,,Күлгін түн – су тасқынының түні.
Dialogue: 0,0:35:47.81,0:35:51.31,Default,,0,0,0,,Олар бізге қиыр шығыстағы көлден құнарлы топырақ әкеледі.
Dialogue: 0,0:35:51.77,0:35:53.02,Default,,0,0,0,,Хмм.
Dialogue: 0,0:35:53.15,0:35:55.73,Default,,0,0,0,,Ей, келесі жолы досымды әкеле аламын ба?
Dialogue: 0,0:35:56.32,0:35:57.11,Default,,0,0,0,,...
Dialogue: 0,0:35:57.23,0:35:59.74,Default,,0,0,0,,Сіз қалағаныңызша жер аласыз, сондықтан сіз көп қызық аласыз.
Dialogue: 0,0:36:00.28,0:36:02.70,Default,,0,0,0,,Иә, мен Джианға берген уәдемді орындай аламын деп ойлаймын.
Dialogue: 0,0:36:03.03,0:36:04.49,Default,,0,0,0,,Дұрыс, хехехе
Dialogue: 0,0:36:04.62,0:36:07.54,Default,,0,0,0,,Роппл мен Клемде ертең мектеп бар...
Dialogue: 0,0:36:07.66,0:36:09.16,Default,,0,0,0,,Қысқы демалыста үй тапсырмасын орындадың ба?
Dialogue: 0,0:36:09.66,0:36:10.91,Default,,0,0,0,,Өкінішке орай, мұнда көп нәрсе жоқ.
Dialogue: 0,0:36:11.04,0:36:13.88,Default,,0,0,0,,Менде де сынақ болды. Мен тезірек оралуым керек ...
Dialogue: 0,0:36:14.00,0:36:17.30,Default,,0,0,0,,Ал, тағы да қош бол. Мен жалғызбын...
Dialogue: 0,0:36:18.25,0:36:19.67,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:36:19.80,0:36:21.38,Default,,0,0,0,,Қайырлы түн, қайта келіңіз.
Dialogue: 0,0:36:21.88,0:36:23.55,Default,,0,0,0,,Иә, ертең қайтамын.
Dialogue: 0,0:36:23.68,0:36:25.05,Default,,0,0,0,,Қош бол
Dialogue: 0,0:36:25.51,0:36:27.81,Default,,0,0,0,,Келетініңізге сенімдімін. (Нобита) Иә, кездескенше.
Dialogue: 0,0:36:28.31,0:36:30.81,Default,,0,0,0,,Асығыңыз, асығыңыз...
Dialogue: 0,0:36:40.40,0:36:41.36,Default,,0,0,0,,Жақсы
Dialogue: 0,0:36:41.49,0:36:42.82,Default,,0,0,0,,Әлі де қосылған
Dialogue: 0,0:36:42.95,0:36:45.70,Default,,0,0,0,,Yahoo! Апыр-ай!
Dialogue: 0,0:36:45.82,0:36:48.91,Default,,0,0,0,,Хехехе хаха Ах жақсы жақсы жақсы
Dialogue: 0,0:36:49.04,0:36:50.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:36:50.87,0:36:53.12,Default,,0,0,0,,Ойлап қарасам, екі күн болдым.
Dialogue: 0,0:36:53.25,0:36:56.08,Default,,0,0,0,,Сонда сен де сабаққа келмейсің бе?
Dialogue: 0,0:36:56.21,0:36:58.84,Default,,0,0,0,,Ана қаншалықты уайымдап, ашулы?
Dialogue: 0,0:36:58.96,0:37:01.13,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:37:01.55,0:37:04.43,Default,,0,0,0,,А, а, а... уф
Dialogue: 0,0:37:04.55,0:37:05.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:05.64,0:37:09.35,Default,,0,0,0,,Тата... Мен үйдемін Хэхехехехехехе
Dialogue: 0,0:37:09.56,0:37:11.68,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:37:11.81,0:37:13.85,Default,,0,0,0,,Олар ештеңе айтпады, бірақ...
Dialogue: 0,0:37:13.98,0:37:15.94,Default,,0,0,0,,Бұл шынымен ашулы.
Dialogue: 0,0:37:16.06,0:37:17.23,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:37:17.36,0:37:19.98,Default,,0,0,0,,Айтар алдында алдымен кешірім сұрау керек.
Dialogue: 0,0:37:20.11,0:37:21.03,Default,,0,0,0,,Иә
Dialogue: 0,0:37:21.44,0:37:23.99,Default,,0,0,0,,Не, сен екі күн болдың ба?
Dialogue: 0,0:37:24.28,0:37:25.82,Default,,0,0,0,,Иә, кешір мені.
Dialogue: 0,0:37:25.95,0:37:28.16,Default,,0,0,0,,Мені кешіріңіз.
Dialogue: 0,0:37:29.16,0:37:30.24,Default,,0,0,0,,Біз есімізді жоғалтқан болармыз, иә?
Dialogue: 0,0:37:30.37,0:37:34.00,Default,,0,0,0,,Таке-кун мен оның достарының ертерек оралғанына екі сағаттай ғана уақыт болды.
Dialogue: 0,0:37:34.33,0:37:35.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:35.37,0:37:37.54,Default,,0,0,0,,Шамамен 2 сағат?
Dialogue: 0,0:37:37.67,0:37:40.42,Default,,0,0,0,,Біртүрлі сөздер айтпа, мені мазақ етпе. Сен одан да көп нәрсені үйрендің бе?
Dialogue: 0,0:37:41.00,0:37:42.84,Default,,0,0,0,,Иә
Dialogue: 0,0:37:43.51,0:37:45.59,Default,,0,0,0,,Уау, бұл пайдалы болды!
Dialogue: 0,0:37:45.72,0:37:46.43,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:37:46.55,0:37:49.39,Default,,0,0,0,,Сәлеметсіз бе, гиперкеңістіктің екінші жағында және осы жағында ...
Dialogue: 0,0:37:49.51,0:37:51.31,Default,,0,0,0,,Уақыт басқаша өтіп бара жатқан сияқты.
Dialogue: 0,0:37:51.51,0:37:53.10,Default,,0,0,0,,Иә, өткен күн...
Dialogue: 0,0:37:53.22,0:37:55.85,Default,,0,0,0,,Бұл жерде бір сағаттай ғана болады.
Dialogue: 0,0:37:55.98,0:37:59.27,Default,,0,0,0,,Күнде сол жаққа барсаңыз, көп көңіл көтересіз.
Dialogue: 0,0:37:59.40,0:38:02.07,Default,,0,0,0,,Қандай керемет жұлдыз!
Dialogue: 0,0:38:02.19,0:38:04.11,Default,,0,0,0,,Коякоя жұлдызы аман болсын!
Dialogue: 0,0:38:04.24,0:38:06.24,Default,,0,0,0,,Фуфуфуфуфу (Нобита) Иә
Dialogue: 0,0:38:06.36,0:38:07.53,Default,,0,0,0,,Хехехе
Dialogue: 0,0:38:17.08,0:38:18.21,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:38:18.33,0:38:20.96,Default,,0,0,0,,Қош келдіңіз, қайда барасыз?
Dialogue: 0,0:38:21.09,0:38:24.05,Default,,0,0,0,,Иә, мен қазірден бастап Алпамыстарды қуантамын.
Dialogue: 0,0:38:24.26,0:38:26.88,Default,,0,0,0,,Нобита-кун сондай бақытты болар еді.
Dialogue: 0,0:38:27.51,0:38:29.47,Default,,0,0,0,,Хехехехехехехе
Dialogue: 0,0:38:30.47,0:38:31.80,Default,,0,0,0,,Яй Нобита
Dialogue: 0,0:38:31.93,0:38:33.60,Default,,0,0,0,,Бұл дұрыс болды. Сіз кімсіз?
Dialogue: 0,0:38:33.72,0:38:35.98,Default,,0,0,0,,Күте тұрыңыз... Мен бос жер таптым.
Dialogue: 0,0:38:36.10,0:38:37.52,Default,,0,0,0,,О, таптың ба?
Dialogue: 0,0:38:37.64,0:38:38.44,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:38:38.56,0:38:41.52,Default,,0,0,0,,Ей, жан досы.
Dialogue: 0,0:38:42.98,0:38:44.03,Default,,0,0,0,,Рахмет Рахмет
Dialogue: 0,0:38:44.15,0:38:46.61,Default,,0,0,0,,Бүгіннен бастап біз жақын доспыз, тату болайық.
Dialogue: 0,0:38:46.74,0:38:48.20,Default,,0,0,0,,Маған үзіліс беріңіз, келіңіз.
Dialogue: 0,0:38:48.86,0:38:52.83,Default,,0,0,0,,Сунео мен Шизука-чанды да шақырмасаң жаман болар еді.
Dialogue: 0,0:38:52.95,0:38:55.08,Default,,0,0,0,,Иә, оларды да қуантайық.
Dialogue: 0,0:38:56.45,0:38:59.71,Default,,0,0,0,,А, эй, Нобита, бұл қашан болады...
Dialogue: 0,0:38:59.83,0:39:00.62,Default,,0,0,0,,А, аз, аз
Dialogue: 0,0:39:00.75,0:39:01.83,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:39:01.96,0:39:02.75,Default,,0,0,0,,Тоқта, ауырады, ауырады
Dialogue: 0,0:39:02.88,0:39:05.30,Default,,0,0,0,,А, Джанды да үрлеп жібер.
Dialogue: 0,0:39:05.42,0:39:08.55,Default,,0,0,0,,(Итадори) Ха! (Кугисаки) Уф
Dialogue: 0,0:39:08.67,0:39:10.93,Default,,0,0,0,,Я... Джан, сұмдық, сен мені ұрдың.
Dialogue: 0,0:39:11.30,0:39:14.51,Default,,0,0,0,,Менің ең жақын досыммен аралассаң, мен түсінбеймін.
Dialogue: 0,0:39:14.64,0:39:17.10,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:39:19.19,0:39:20.98,Default,,0,0,0,,Мен де Шизука-чанды шақырамын.
Dialogue: 0,0:39:21.10,0:39:21.85,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:39:23.11,0:39:26.32,Default,,0,0,0,,Біз қазір үйдің ішінде ойнап жатырмыз.
Dialogue: 0,0:39:26.44,0:39:29.28,Default,,0,0,0,,Келіңіздер, бәріңіз, өтінемін, көтеріліңіздер!
Dialogue: 0,0:39:29.70,0:39:30.86,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:39:30.99,0:39:31.78,Default,,0,0,0,,Сәлем
Dialogue: 0,0:39:31.91,0:39:33.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:39:36.79,0:39:37.58,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:39:37.70,0:39:39.58,Default,,0,0,0,,Иә, бұл кіреберіс пе?
Dialogue: 0,0:39:39.71,0:39:41.96,Default,,0,0,0,,Сіз бұл саңылауды қашан жасадыңыз?
Dialogue: 0,0:39:42.08,0:39:43.67,Default,,0,0,0,,Жарайды, жарайды, алға.
Dialogue: 0,0:39:44.13,0:39:45.38,Default,,0,0,0,,Мен №1
Dialogue: 0,0:39:45.50,0:39:47.92,Default,,0,0,0,,№ 2 Yahoo!
Dialogue: 0,0:39:48.05,0:39:49.38,Default,,0,0,0,,Мен... (Сунео) А...
Dialogue: 0,0:39:49.51,0:39:51.93,Default,,0,0,0,,Биіктігі мен ені өзгереді, сондықтан абай болыңыз.
Dialogue: 0,0:39:52.05,0:39:53.89,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:39:54.01,0:39:56.39,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:39:56.85,0:39:59.10,Default,,0,0,0,,Жүр, тезірек (Нобита) Иә.
Dialogue: 0,0:39:59.93,0:40:01.14,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:40:02.85,0:40:03.52,Default,,0,0,0,,Ал...
Dialogue: 0,0:40:04.52,0:40:05.40,Default,,0,0,0,,Керемет
Dialogue: 0,0:40:05.52,0:40:06.19,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:40:06.52,0:40:08.78,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:40:15.95,0:40:18.62,Default,,0,0,0,,Бір күннің ішінде мен ойымды толығымен өзгерттім.
Dialogue: 0,0:40:18.74,0:40:20.41,Default,,0,0,0,,Армандай сұлу жұлдыз
Dialogue: 0,0:40:20.87,0:40:23.62,Default,,0,0,0,,Қандай ғажап жер, жан досым.
Dialogue: 0,0:40:23.75,0:40:25.38,Default,,0,0,0,,Сіз қалағаныңызша көп дәлел ала аласыз
Dialogue: 0,0:40:25.88,0:40:28.34,Default,,0,0,0,,Мұнда көп күн болды.
Dialogue: 0,0:40:28.55,0:40:30.26,Default,,0,0,0,,А, бұл Роппуру-кун.
Dialogue: 0,0:40:31.01,0:40:32.30,Default,,0,0,0,,Сәлем Нобита-кун
Dialogue: 0,0:40:32.43,0:40:34.26,Default,,0,0,0,,Сен өзіңмен достарыңды ала келдің.
Dialogue: 0,0:40:34.76,0:40:37.35,Default,,0,0,0,,Иә, мен бірден қонаққа келдім, хехехехе
Dialogue: 0,0:40:37.47,0:40:38.43,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:40:38.56,0:40:39.39,Default,,0,0,0,,Оссу
Dialogue: 0,0:40:39.52,0:40:40.22,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:40:41.14,0:40:44.19,Default,,0,0,0,,Сол орманнан өтіп бара жатқанда, кең өріс жатыр.
Dialogue: 0,0:40:44.31,0:40:46.65,Default,,0,0,0,,Біз ол жерде кейінірек боламыз, сондықтан ойнаңыз.
Dialogue: 0,0:40:46.77,0:40:48.15,Default,,0,0,0,,♪ Мен Джанмын
Dialogue: 0,0:40:48.57,0:40:49.32,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:40:49.44,0:40:51.74,Default,,0,0,0,,Қандай жеңіл нәрсе!
Dialogue: 0,0:40:51.86,0:40:53.03,Default,,0,0,0,,Сіздің денеңізде қанаттар өскен сияқты
Dialogue: 0,0:40:53.57,0:40:55.32,Default,,0,0,0,,Хехе, ауа таза.
Dialogue: 0,0:40:55.45,0:40:56.99,Default,,0,0,0,,Өзіңізді сергек сезініңіз
Dialogue: 0,0:41:00.16,0:41:02.37,Default,,0,0,0,,Ахахха Уау (Сунео) Ахахха
Dialogue: 0,0:41:02.50,0:41:03.83,Default,,0,0,0,,Уау (Сунео) Керемет
Dialogue: 0,0:41:04.21,0:41:06.88,Default,,0,0,0,,Әй, эй, эй, не болып жатыр?
Dialogue: 0,0:41:07.00,0:41:07.75,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:41:07.88,0:41:09.09,Default,,0,0,0,,Ах
Dialogue: 0,0:41:15.97,0:41:20.31,Default,,0,0,0,,Не? Сіз біртүрлі әрекет етесіз. Мен сенің мойыныңды созамын.
Dialogue: 0,0:41:21.14,0:41:22.89,Default,,0,0,0,,Тіпті аяғыңыз ұзағырақ, қараңыз.
Dialogue: 0,0:41:23.02,0:41:23.73,Default,,0,0,0,,Қосымша
Dialogue: 0,0:41:23.93,0:41:28.19,Default,,0,0,0,,Қараңызшы, бұл қорқынышты емес. Олардың барлығы жұмсақ жануарлар.
Dialogue: 0,0:41:28.31,0:41:29.73,Default,,0,0,0,,Ей, ұялма
Dialogue: 0,0:41:29.86,0:41:30.65,Default,,0,0,0,,Уау
Dialogue: 0,0:41:30.86,0:41:33.61,Default,,0,0,0,,Шарға ұқсайтын панда
Dialogue: 0,0:41:33.74,0:41:34.90,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:41:36.95,0:41:39.37,Default,,0,0,0,,Не, мен ауа жұтпасам болады ма?
Dialogue: 0,0:41:42.16,0:41:44.08,Default,,0,0,0,,Бұл әлі жұмыртқа болып қалатын құс.
Dialogue: 0,0:41:44.21,0:41:45.75,Default,,0,0,0,,Оны ұстап алып, қуырылған жұмыртқаға айналдырыңыз
Dialogue: 0,0:41:45.87,0:41:46.96,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:41:47.08,0:41:48.21,Default,,0,0,0,,Зорлық-зомбылық жасамаңыз
Dialogue: 0,0:41:48.46,0:41:49.38,Default,,0,0,0,,Урсея
Dialogue: 0,0:41:49.50,0:41:51.59,Default,,0,0,0,,Маған аздап берсең жақсы болмай ма?
Dialogue: 0,0:41:51.71,0:41:54.38,Default,,0,0,0,,Уау
Dialogue: 0,0:41:54.51,0:41:55.63,Default,,0,0,0,,сол қылмыскер деп саналатын адам
Dialogue: 0,0:41:55.76,0:41:57.01,Default,,0,0,0,,Ах
Dialogue: 0,0:41:57.26,0:41:59.09,Default,,0,0,0,,Егер ол жұмыс істемесе, оны орындаңыз.
Dialogue: 0,0:41:59.22,0:41:59.97,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:42:00.30,0:42:01.72,Default,,0,0,0,,Егер бұлай болса, мен қыңырмын.
Dialogue: 0,0:42:01.85,0:42:04.06,Default,,0,0,0,,Соңына дейін бөлемін, бөлемін, бөлемін.
Dialogue: 0,0:42:04.18,0:42:07.23,Default,,0,0,0,,Қырықпырлы дүрбелең шығарып жатыр.
Dialogue: 0,0:42:07.35,0:42:09.44,Default,,0,0,0,,А, мен оны енді қаламаймын. (Сунео) А-а.
Dialogue: 0,0:42:09.73,0:42:12.36,Default,,0,0,0,,Не? Қанша сындырсаң да, ол бәрібір қабық.
Dialogue: 0,0:42:12.48,0:42:15.24,Default,,0,0,0,,Сәлеметсіз бе, піл мырза. Сәлем.
Dialogue: 0,0:42:15.36,0:42:16.90,Default,,0,0,0,,Паоо
Dialogue: 0,0:42:17.03,0:42:18.32,Default,,0,0,0,,Бұл екі аяқ па?
Dialogue: 0,0:42:18.99,0:42:19.91,Default,,0,0,0,,Уау аааа
Dialogue: 0,0:42:20.03,0:42:20.95,Default,,0,0,0,,Паоо
Dialogue: 0,0:42:21.08,0:42:21.91,Default,,0,0,0,,Сіз маған көлік бересіз бе?
Dialogue: 0,0:42:22.79,0:42:24.25,Default,,0,0,0,,Жарайды ма? Сіз мінсеңіз де
Dialogue: 0,0:42:24.70,0:42:26.66,Default,,0,0,0,,Мен де атқа мінейін.
Dialogue: 0,0:42:26.79,0:42:28.25,Default,,0,0,0,,Паоо
Dialogue: 0,0:42:28.62,0:42:31.34,Default,,0,0,0,,Енді далаға барайық
Dialogue: 0,0:42:31.46,0:42:37.47,Default,,0,0,0,,(♪«Дораэмон әні»)
Dialogue: 0,0:43:27.81,0:43:31.52,Default,,0,0,0,,Иә
Dialogue: 0,0:43:32.61,0:43:33.15,Default,,0,0,0,,〜♪
Dialogue: 0,0:43:33.15,0:43:34.15,Default,,0,0,0,,〜♪
Dialogue: 0,0:43:33.15,0:43:34.15,Default,,0,0,0,,Мұнда немесе мұнда
Dialogue: 0,0:43:34.15,0:43:34.27,Default,,0,0,0,,〜♪
Dialogue: 0,0:43:34.27,0:43:35.57,Default,,0,0,0,,〜♪
Dialogue: 0,0:43:34.27,0:43:35.57,Default,,0,0,0,,Уау, бұл кең.
Dialogue: 0,0:43:35.57,0:43:35.69,Default,,0,0,0,,〜♪
Dialogue: 0,0:43:35.69,0:43:37.57,Default,,0,0,0,,〜♪
Dialogue: 0,0:43:35.69,0:43:37.57,Default,,0,0,0,,Көзге көрінетіндей кең өрістер
Dialogue: 0,0:43:37.57,0:43:38.36,Default,,0,0,0,,〜♪
Dialogue: 0,0:43:38.36,0:43:38.61,Default,,0,0,0,,〜♪
Dialogue: 0,0:43:38.36,0:43:38.61,Default,,0,0,0,,Мұнда нағыз бейсбол стадионын салайық. Сізде бұл үшін құралдар жоқ па?
Dialogue: 0,0:43:38.61,0:43:42.16,Default,,0,0,0,,Мұнда нағыз бейсбол алаңын салайық. Сізде бұл үшін құралдар жоқ па?
Dialogue: 0,0:43:42.28,0:43:43.45,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:43:43.78,0:43:46.16,Default,,0,0,0,,Бұл стадионды «Нобита стадионы» деп атаңыз—
Dialogue: 0,0:43:46.29,0:43:49.25,Default,,0,0,0,,Нобитаның жетістіктерін мәңгі мадақтайық.
Dialogue: 0,0:43:49.96,0:43:51.21,Default,,0,0,0,,Доп ойнау
Dialogue: 0,0:43:51.67,0:43:53.38,Default,,0,0,0,,Жарайды, мен оны қолымнан келгенше лақтырамын.
Dialogue: 0,0:43:53.50,0:43:54.21,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:43:54.50,0:43:57.13,Default,,0,0,0,,Жарайды, Нобитаның добын кәдімгі доппен ойнауға болмайды.
Dialogue: 0,0:43:57.25,0:43:59.51,Default,,0,0,0,,Баяу доппен, мінекей!
Dialogue: 0,0:43:59.92,0:44:00.84,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:44:01.05,0:44:02.47,Default,,0,0,0,,О, менің...
Dialogue: 0,0:44:02.59,0:44:04.64,Default,,0,0,0,,Мен допты онша биіктете алмаймын.
Dialogue: 0,0:44:04.76,0:44:06.18,Default,,0,0,0,,Мен жаңа допты жоғалтып алдым
Dialogue: 0,0:44:06.68,0:44:09.60,Default,,0,0,0,,Мен жылдам доптың не екенін білемін, бұл рас.
Dialogue: 0,0:44:09.73,0:44:12.77,Default,,0,0,0,,Кешіріңіз, мен сәл есінен танып қалдым.
Dialogue: 0,0:44:12.90,0:44:15.15,Default,,0,0,0,,Жарайды, бұл жолы ортада.
Dialogue: 0,0:44:15.27,0:44:16.65,Default,,0,0,0,,Таа
Dialogue: 0,0:44:16.77,0:44:17.78,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:44:17.90,0:44:20.15,Default,,0,0,0,,Уау Шизука-чан артқа артқа секіру
Dialogue: 0,0:44:20.28,0:44:21.57,Default,,0,0,0,,Иә
Dialogue: 0,0:44:21.82,0:44:23.61,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:44:24.32,0:44:26.12,Default,,0,0,0,,А-а-а
Dialogue: 0,0:44:26.24,0:44:27.87,Default,,0,0,0,,Шизука-чан, жақсысың ба?
Dialogue: 0,0:44:27.99,0:44:29.04,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:44:29.62,0:44:31.91,Default,,0,0,0,,Нобита осылай үйге жүгірді!
Dialogue: 0,0:44:32.04,0:44:34.00,Default,,0,0,0,,Иә, доп жақсы ұшып бара жатқан сияқты.
Dialogue: 0,0:44:34.54,0:44:37.38,Default,,0,0,0,,Мен кәдімгідей секіріп кетсем де...
Dialogue: 0,0:44:37.50,0:44:38.75,Default,,0,0,0,,Иә, ұмытып қалдым.
Dialogue: 0,0:44:39.38,0:44:42.17,Default,,0,0,0,,Бұл жұлдыздың ауырлық күші өте аз.
Dialogue: 0,0:44:42.51,0:44:45.01,Default,,0,0,0,,Қараңдаршы, ол галтит деген кеннен жасалған.
Dialogue: 0,0:44:45.14,0:44:46.60,Default,,0,0,0,,Ол жерден жеңіл болады
Dialogue: 0,0:44:47.05,0:44:50.43,Default,,0,0,0,,Неге, біртүрлі екен деп ойладым. Мұндай планетада бейсбол ойнауға бола ма?
Dialogue: 0,0:44:50.56,0:44:53.39,Default,,0,0,0,,Мен екі жаңа допты жоғалтып алдым.
Dialogue: 0,0:44:53.52,0:44:55.56,Default,,0,0,0,,Бұл мен ғана, мен әдемі киінемін
Dialogue: 0,0:44:55.69,0:44:57.02,Default,,0,0,0,,Сіз мені осында әкелдіңіз.
Dialogue: 0,0:44:57.15,0:44:58.65,Default,,0,0,0,,Жоқ, өтінемін... бұл түсінбеушілік.
Dialogue: 0,0:44:58.77,0:45:00.03,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:45:00.23,0:45:01.49,Default,,0,0,0,,Е, мен осында келе жатырмын.
Dialogue: 0,0:45:01.86,0:45:03.20,Default,,0,0,0,,А, жаман адам.
Dialogue: 0,0:45:03.32,0:45:04.41,Default,,0,0,0,,Бұл үлкен ғарыш кемесі.
Dialogue: 0,0:45:09.49,0:45:12.16,Default,,0,0,0,,(Барлығы дүрбелең)
Dialogue: 0,0:45:14.83,0:45:16.50,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:45:20.71,0:45:23.13,Default,,0,0,0,,Ааааааааааааааааааааа
Dialogue: 0,0:45:48.24,0:45:49.32,Default,,0,0,0,,Бұл сендерсіңдер, балалар.
Dialogue: 0,0:45:49.45,0:45:51.95,Default,,0,0,0,,Кім допты осылай соғып, біздің көлікке үлкен тесік жасады.
Dialogue: 0,0:45:52.45,0:45:53.62,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,0:45:53.75,0:45:55.91,Default,,0,0,0,,Тек доппен мұндай соққыны жіберіп алу қиын.
Dialogue: 0,0:45:56.42,0:45:58.00,Default,,0,0,0,,А, бұл бейтаныс бет.
Dialogue: 0,0:45:58.13,0:46:00.88,Default,,0,0,0,,Сіз жаңа иммигрантсыз ба? Сіз қай планетадансыз?
Dialogue: 0,0:46:01.17,0:46:03.38,Default,,0,0,0,,Біз Жерденміз.
Dialogue: 0,0:46:03.51,0:46:04.84,Default,,0,0,0,,Доп... Допты маған қайтарыңыз.
Dialogue: 0,0:46:05.13,0:46:08.72,Default,,0,0,0,,Жер тұрғындары? Мен бұл планетаға қажетсіз нәрселердің келгенін ұнатпаймын.
Dialogue: 0,0:46:08.84,0:46:10.76,Default,,0,0,0,,Тез үйге баруым керек...
Dialogue: 0,0:46:13.68,0:46:14.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:15.10,0:46:17.56,Default,,0,0,0,,Ааа... аааа!
Dialogue: 0,0:46:19.81,0:46:21.98,Default,,0,0,0,,Қорқынышты, қорқынышты, қорқынышты, ой
Dialogue: 0,0:46:24.61,0:46:25.36,Default,,0,0,0,,Джан
Dialogue: 0,0:46:25.49,0:46:28.28,Default,,0,0,0,,Джан... Джан, сәл күте тұр.
Dialogue: 0,0:46:28.41,0:46:29.70,Default,,0,0,0,,Егер мені сонша қорқытсаң...
Dialogue: 0,0:46:29.82,0:46:32.28,Default,,0,0,0,,Ол енді келмейді.
Dialogue: 0,0:46:32.41,0:46:36.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:46:36.33,0:46:37.92,Default,,0,0,0,,Не деген…
Dialogue: 0,0:46:54.72,0:46:56.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:56.60,0:46:57.48,Default,,0,0,0,,Яй Нобита
Dialogue: 0,0:46:57.60,0:47:00.15,Default,,0,0,0,,Сіз мені осындай қорқынышты планетаға әкелдіңіз.
Dialogue: 0,0:47:00.27,0:47:01.69,Default,,0,0,0,,Жұлдыздың бұл түрі кішкентай
Dialogue: 0,0:47:01.81,0:47:03.52,Default,,0,0,0,,Мен сені енді досым деп санамаймын.
Dialogue: 0,0:47:03.65,0:47:06.24,Default,,0,0,0,,Жүр, Шидзука-чан, Жерге қайтайық.
Dialogue: 0,0:47:06.36,0:47:07.49,Default,,0,0,0,,Бех!
Dialogue: 0,0:47:07.61,0:47:10.36,Default,,0,0,0,,Сонымен... Ақыры осы ойын алаңын таптым.
Dialogue: 0,0:47:10.49,0:47:11.70,Default,,0,0,0,,Шизука-чанға дейін
Dialogue: 0,0:47:11.82,0:47:14.20,Default,,0,0,0,,Паон
Dialogue: 0,0:47:15.54,0:47:16.79,Default,,0,0,0,,Бұлай болмауы керек еді.
Dialogue: 0,0:47:16.91,0:47:19.12,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:47:19.25,0:47:23.71,Default,,0,0,0,,Иә? Сонда сіз қорқытқандықтан қашып кеттіңіз бе?
Dialogue: 0,0:47:23.84,0:47:25.21,Default,,0,0,0,,5 адам бар, ол сыпайы.
Dialogue: 0,0:47:25.34,0:47:28.22,Default,,0,0,0,,Мен сені тістеп немесе тырнап аламын.
Dialogue: 0,0:47:28.34,0:47:29.63,Default,,0,0,0,,Дөрекі болма, Чумми
Dialogue: 0,0:47:29.76,0:47:31.34,Default,,0,0,0,,Сенің зардап шекпегеніңе қуаныштымын.
Dialogue: 0,0:47:31.47,0:47:33.64,Default,,0,0,0,,Иә, олардың маған не істейтінін білмеймін.
Dialogue: 0,0:47:34.01,0:47:36.35,Default,,0,0,0,,Оларды қудалау одан сайын күшейе түседі.
Dialogue: 0,0:47:36.64,0:47:37.89,Default,,0,0,0,,Бұл қорқынышты жұлдыз.
Dialogue: 0,0:47:38.02,0:47:41.10,Default,,0,0,0,,Полицияға сене алмасақ, не істеуіміз керек?
Dialogue: 0,0:47:41.77,0:47:46.19,Default,,0,0,0,,Әкем олардың зорлық-зомбылығы туралы шағымдану үшін полицияға бара жатыр.
Dialogue: 0,0:47:46.32,0:47:50.03,Default,,0,0,0,,Ол астероид соғылып қайтыс болған деседі...
Dialogue: 0,0:47:50.15,0:47:51.99,Default,,0,0,0,,Мүмкін олардың қолында...
Dialogue: 0,0:47:52.11,0:47:55.12,Default,,0,0,0,,Мына шок мылтық әкемнің естелігі.
Dialogue: 0,0:47:55.24,0:47:58.50,Default,,0,0,0,,Мен сені ренжіте алмаймын, бірақ тым болмаса есінен танып құлатып аламын...
Dialogue: 0,0:47:59.45,0:48:01.96,Default,,0,0,0,,Ақырында, өзіңді қорғаудан басқа амалың жоқ.
Dialogue: 0,0:48:02.08,0:48:03.17,Default,,0,0,0,,Иә
Dialogue: 0,0:48:04.63,0:48:06.50,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:48:09.01,0:48:09.88,Default,,0,0,0,,Ах
Dialogue: 0,0:48:10.38,0:48:12.01,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:48:12.13,0:48:14.09,Default,,0,0,0,,Көрші тармақты көздедім.
Dialogue: 0,0:48:14.22,0:48:14.93,Default,,0,0,0,,О, менің...
Dialogue: 0,0:48:15.80,0:48:17.72,Default,,0,0,0,,Сен тек ағаңнан жеңілесің.
Dialogue: 0,0:48:17.85,0:48:18.56,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:48:19.14,0:48:21.69,Default,,0,0,0,,Ей, неге бәріміз Жерге келмейміз?
Dialogue: 0,0:48:21.81,0:48:23.52,Default,,0,0,0,,Мен сені тұратын жерден табамын.
Dialogue: 0,0:48:24.02,0:48:25.44,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:48:25.56,0:48:28.48,Default,,0,0,0,,Біз бұл Коякоя планетасынан бас тарта алмаймыз.
Dialogue: 0,0:48:29.03,0:48:30.94,Default,,0,0,0,,Менің қайтыс болған әкем үшін...
Dialogue: 0,0:48:37.08,0:48:39.20,Default,,0,0,0,,(Допты доппен соғу дыбысы)
Dialogue: 0,0:48:39.33,0:48:40.29,Default,,0,0,0,,Айнал, бұрыл
Dialogue: 0,0:48:40.41,0:48:41.54,Default,,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,0:48:44.25,0:48:46.46,Default,,0,0,0,,Мм... А, мына бос жер.
Dialogue: 0,0:48:46.79,0:48:48.55,Default,,0,0,0,,А, Нобита, бұл жер кішкентай ғой, солай емес пе?
Dialogue: 0,0:48:48.67,0:48:51.47,Default,,0,0,0,,Кіші мектеп оқушылары оны өздерінің ақымақтықтарымен ұшырды.
Dialogue: 0,0:48:51.59,0:48:54.05,Default,,0,0,0,,Маңайдағы терезелерді сындырып, қуып жібердім.
Dialogue: 0,0:48:54.18,0:48:55.43,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:48:56.09,0:48:57.35,Default,,0,0,0,,Хмф, маңызды емес.
Dialogue: 0,0:48:57.47,0:48:58.18,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:48:58.31,0:49:01.35,Default,,0,0,0,,Мен енді сен сияқты пайдасыз адамдарды қосқым келмейді.
Dialogue: 0,0:49:01.48,0:49:03.14,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:49:03.27,0:49:06.02,Default,,0,0,0,,Ештеңе етпейді, мен де бұл жерде қолым бос емес.
Dialogue: 0,0:49:12.32,0:49:15.07,Default,,0,0,0,,Дұрыс, Нобитада бесіктен де көп нәрсе бар.
Dialogue: 0,0:49:15.20,0:49:16.95,Default,,0,0,0,,Менде бұл ерекше дағды болды.
Dialogue: 0,0:49:17.16,0:49:20.45,Default,,0,0,0,,Иә, мен сізге Роппуруға және басқаларға көмектесемін.
Dialogue: 0,0:49:20.58,0:49:24.37,Default,,0,0,0,,Бірақ пластикалық оқтар сізге жақсылық әкелмейді.
Dialogue: 0,0:49:24.71,0:49:28.25,Default,,0,0,0,,Мен сені тым болмаса қорқыта аламын, бірақ бұл жоқтан жақсы...
Dialogue: 0,0:49:28.50,0:49:30.34,Default,,0,0,0,,Сіз қайтадан Коя Кояға барасыз ба?
Dialogue: 0,0:49:30.46,0:49:32.38,Default,,0,0,0,,Бұл анық, оны жай қалдыра аласыз ба?
Dialogue: 0,0:49:32.51,0:49:33.47,Default,,0,0,0,,Бірақ мүмкін болса –
Dialogue: 0,0:49:33.59,0:49:36.05,Default,,0,0,0,,Мен бұл екі қорқынышты адамды кездестіргім келмейді.
Dialogue: 0,0:49:36.18,0:49:36.93,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:49:37.05,0:49:38.26,Default,,0,0,0,,Доккоишотто
Dialogue: 0,0:49:41.81,0:49:44.39,Default,,0,0,0,,Иә? Не болып жатыр? Кабинет жоқ.
Dialogue: 0,0:49:44.52,0:49:46.02,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:49:52.98,0:49:55.07,Default,,0,0,0,,Қызық, Коя Коя соншалықты дамыды ма?
Dialogue: 0,0:49:55.40,0:49:57.99,Default,,0,0,0,,Қаншалықты жылдам болса да...
Dialogue: 0,0:49:58.12,0:49:59.07,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:49:59.62,0:50:01.74,Default,,0,0,0,,Бұл Токай Токай планетасы болуы керек.
Dialogue: 0,0:50:01.87,0:50:04.66,Default,,0,0,0,,Роппл, сендер мұнда бизнес үшін келдіңдер.
Dialogue: 0,0:50:04.79,0:50:06.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:50:07.00,0:50:08.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:50:13.21,0:50:14.67,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:50:14.80,0:50:16.76,Default,,0,0,0,,Эй Роппл, мен тағы келдім.
Dialogue: 0,0:50:16.88,0:50:18.80,Default,,0,0,0,,Бұл үлкен қала.
Dialogue: 0,0:50:18.93,0:50:22.26,Default,,0,0,0,,Иә, біздің арал – ғаламның орталығы.
Dialogue: 0,0:50:22.39,0:50:24.89,Default,,0,0,0,,Енді, бірге Коякоя планетасына оралайық.
Dialogue: 0,0:50:25.02,0:50:26.06,Default,,0,0,0,,Иә
Dialogue: 0,0:50:45.25,0:50:47.04,Default,,0,0,0,,Төмендегі ғимарат - қалалық әкімдік
Dialogue: 0,0:50:47.16,0:50:49.37,Default,,0,0,0,,Оң жақта Ғарыш федерациясының штаб-пәтері көрінеді.
Dialogue: 0,0:50:49.50,0:50:51.38,Default,,0,0,0,,Ғарыш мұражайы сол жақта.
Dialogue: 0,0:50:52.00,0:50:53.71,Default,,0,0,0,,Әлгі әсем ғимарат ше?
Dialogue: 0,0:50:53.84,0:50:55.42,Default,,0,0,0,,Гартитті өндіру жөніндегі штаб
Dialogue: 0,0:50:55.55,0:50:57.26,Default,,0,0,0,,Иә, бұл...
Dialogue: 0,0:51:01.47,0:51:05.06,Default,,0,0,0,,Агрессивті даму қалай үлкен компанияға айналды?
Dialogue: 0,0:51:05.52,0:51:08.64,Default,,0,0,0,,Қанша адамды жылаттым білмеймін
Dialogue: 0,0:51:28.83,0:51:32.04,Default,,0,0,0,,Гравитацияға қарсы қозғалтқышты тоқтатыңыз. Бірден бұрмалауды енгізіңіз.
Dialogue: 0,0:51:32.50,0:51:34.21,Default,,0,0,0,,Энергия заряды ОК
Dialogue: 0,0:51:38.55,0:51:40.09,Default,,0,0,0,,Радар орнату Жарайды
Dialogue: 0,0:51:40.43,0:51:41.47,Default,,0,0,0,,Бұрыс!
Dialogue: 0,0:51:54.11,0:51:57.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:57.90,0:51:58.82,Default,,0,0,0,,Бұл біртүрлі көрінеді.
Dialogue: 0,0:51:58.94,0:52:01.40,Default,,0,0,0,,Терезенің сырты біртүрлі түске боялған.
Dialogue: 0,0:52:01.95,0:52:04.74,Default,,0,0,0,,Жақында қалыпты кеңістікке ораламыз.
Dialogue: 0,0:52:10.16,0:52:12.12,Default,,0,0,0,,Жарайды, бұрмалау аяқталды.
Dialogue: 0,0:52:12.25,0:52:14.79,Default,,0,0,0,,Бұл мені құтқарды. Бұл жолы бұзылмады.
Dialogue: 0,0:52:14.92,0:52:16.96,Default,,0,0,0,,Бұл өте ескі машина.
Dialogue: 0,0:52:17.17,0:52:20.84,Default,,0,0,0,,Өйткені, кез келген машина ескірген кезде біртүрлі болып қалады.
Dialogue: 0,0:52:20.97,0:52:22.84,Default,,0,0,0,,Өте өкінішті, бұл пайдаланылған робот болды!
Dialogue: 0,0:52:22.97,0:52:23.93,Default,,0,0,0,,жаман жаман
Dialogue: 0,0:52:28.64,0:52:30.85,Default,,0,0,0,,Мен таныс шоқжұлдыздарды көрмеймін.
Dialogue: 0,0:52:31.23,0:52:32.39,Default,,0,0,0,,Әрине.
Dialogue: 0,0:52:32.52,0:52:36.31,Default,,0,0,0,,Бұл галактикадан алыс орналасқан тағы бір ғаламшар аралы.
Dialogue: 0,0:52:36.94,0:52:39.61,Default,,0,0,0,,Біраз уақытқа гравитацияға қарсы қозғалысқа ауысыңыз—
Dialogue: 0,0:52:39.73,0:52:42.07,Default,,0,0,0,,Айналмалы энергияны зарядтаңыз.
Dialogue: 0,0:52:44.66,0:52:46.45,Default,,0,0,0,,Mew Mew
Dialogue: 0,0:52:48.91,0:52:50.41,Default,,0,0,0,,Енді бұрмалауға болмайды.
Dialogue: 0,0:52:50.54,0:52:53.42,Default,,0,0,0,,Иә, ғарышқа саяхат сіз үйренгеннен кейін ештеңе емес.
Dialogue: 0,0:52:53.54,0:52:55.25,Default,,0,0,0,,Вааааааааааааааааааааааааа
Dialogue: 0,0:52:55.58,0:52:56.50,Default,,0,0,0,,​​Артында!
Dialogue: 0,0:52:56.63,0:52:57.75,Default,,0,0,0,,Міне, біз тағы да келдік!
Dialogue: 0,0:53:02.55,0:53:03.72,Default,,0,0,0,,Бұл тағы да солар
Dialogue: 0,0:53:03.84,0:53:05.55,Default,,0,0,0,,Мен сені көргім келмесе де...
Dialogue: 0,0:53:12.73,0:53:14.14,Default,,0,0,0,,Ахх
Dialogue: 0,0:53:18.19,0:53:19.57,Default,,0,0,0,,Жарайды, жүгіріп барайық.
Dialogue: 0,0:53:43.34,0:53:44.63,Default,,0,0,0,,Барлығың ауырып қалды ма?
Dialogue: 0,0:53:45.22,0:53:46.84,Default,,0,0,0,,Ол қауіпсіз сияқты.
Dialogue: 0,0:53:46.97,0:53:48.55,Default,,0,0,0,,Мен мұны соңы деп ойладым
Dialogue: 0,0:53:48.68,0:53:51.39,Default,,0,0,0,,Біз сыртқа тез жүгіруіміз керек.
Dialogue: 0,0:53:51.51,0:53:53.56,Default,,0,0,0,,Бірақ бізде ғарыштық костюм жоқ.
Dialogue: 0,0:53:54.10,0:53:56.10,Default,,0,0,0,,Дорэмон, не болып жатыр?
Dialogue: 0,0:53:56.23,0:53:58.56,Default,,0,0,0,,Иә, бұл туралы не деуге болады?
Dialogue: 0,0:53:58.73,0:54:00.48,Default,,0,0,0,,Жеуге болатын ғарыштық костюм!
Dialogue: 0,0:54:01.11,0:54:03.74,Default,,0,0,0,,Осыны жеген кезде денеңізде оттегі пайда болады.
Dialogue: 0,0:54:03.86,0:54:06.95,Default,,0,0,0,,Сыртынан пленка пайда болып, оны скафандр кигенмен бірдей етеді.
Dialogue: 0,0:54:07.16,0:54:10.87,Default,,0,0,0,,Не қаласаң да, тез шықпасаң, жамандар келеді.
Dialogue: 0,0:54:18.17,0:54:19.54,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:54:19.67,0:54:20.67,Default,,0,0,0,,Иә...
Dialogue: 0,0:54:41.15,0:54:42.61,Default,,0,0,0,,Балалар тағы да?
Dialogue: 0,0:54:42.73,0:54:45.69,Default,,0,0,0,,Коякоядан үнсіз кету керек...
Dialogue: 0,0:54:46.36,0:54:49.45,Default,,0,0,0,,Кім кетеді? Бұл біз ашқан планета.
Dialogue: 0,0:54:50.07,0:54:51.28,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:54:51.41,0:54:53.41,Default,,0,0,0,,Менің ойымша, сізде онша интеллект жоқ.
Dialogue: 0,0:54:57.62,0:54:58.54,Default,,0,0,0,,Мен бірдеңе істеуім керек...
Dialogue: 0,0:54:58.54,0:54:59.75,Default,,0,0,0,,Мен бірдеңе істеуім керек...
Dialogue: 0,0:54:58.54,0:54:59.75,Default,,0,0,0,,Хмм, бұл жақсы емес.
Dialogue: 0,0:55:00.13,0:55:01.04,Default,,0,0,0,,Мен сені аяймын...
Dialogue: 0,0:55:01.17,0:55:02.67,Default,,0,0,0,,Бұл жолы дайын болыңыз
Dialogue: 0,0:55:02.96,0:55:04.30,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,0:55:08.17,0:55:08.97,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:55:09.63,0:55:11.01,Default,,0,0,0,,Хехехе
Dialogue: 0,0:55:14.60,0:55:15.52,Default,,0,0,0,,Иә...
Dialogue: 0,0:55:15.64,0:55:16.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:16.81,0:55:17.23,Default,,0,0,0,,Ах
Dialogue: 0,0:55:17.23,0:55:17.93,Default,,0,0,0,,Ах
Dialogue: 0,0:55:17.23,0:55:17.93,Default,,0,0,0,,Бұл өтірік. Бұл пластикалық оқ.
Dialogue: 0,0:55:17.93,0:55:18.94,Default,,0,0,0,,Бұл өтірік. Бұл пластикалық оқ.
Dialogue: 0,0:55:19.06,0:55:20.27,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:55:20.65,0:55:22.15,Default,,0,0,0,,Уау, қаш!
Dialogue: 0,0:55:22.27,0:55:24.23,Default,,0,0,0,,Эй, мені жібер!
Dialogue: 0,0:55:24.69,0:55:27.19,Default,,0,0,0,,Жылдам, өйткені ауырлық күші аз
Dialogue: 0,0:55:30.82,0:55:32.32,Default,,0,0,0,,Мен бүгін еске саламын
Dialogue: 0,0:55:32.45,0:55:33.20,Default,,0,0,0,,Жібер!
Dialogue: 0,0:55:33.58,0:55:33.66,Default,,0,0,0,,Ноби-чан Дора-чан
Dialogue: 0,0:55:33.66,0:55:36.04,Default,,0,0,0,,Ноби-чан Дора-чан
Dialogue: 0,0:55:33.66,0:55:36.04,Default,,0,0,0,,Мына жігіт, ашуланба.
Dialogue: 0,0:55:36.16,0:55:39.12,Default,,0,0,0,,Уау, уау, уау, тез, тез...
Dialogue: 0,0:55:39.41,0:55:40.29,Default,,0,0,0,,Мен толық шеңберге шықтым.
Dialogue: 0,0:55:40.42,0:55:41.33,Default,,0,0,0,,Ол бір жерге кетіп қалды
Dialogue: 0,0:55:41.46,0:55:43.17,Default,,0,0,0,,Кет, кет, кет
Dialogue: 0,0:55:43.75,0:55:44.71,Default,,0,0,0,,Кет...
Dialogue: 0,0:55:44.88,0:55:46.59,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:55:47.88,0:55:48.63,Default,,0,0,0,,Бұл керемет күш.
Dialogue: 0,0:55:48.76,0:55:49.55,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:55:49.97,0:55:52.51,Default,,0,0,0,,Осы уақытқа дейін неге байқамадым?
Dialogue: 0,0:55:57.68,0:56:00.81,Default,,0,0,0,,Біз осы планетадағы суперменміз
Dialogue: 0,0:56:00.94,0:56:01.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:01.73,0:56:04.19,Default,,0,0,0,,Мен енді саған оңайлықпен бармаймын. Мен түсінбедім.
Dialogue: 0,0:56:04.31,0:56:06.48,Default,,0,0,0,,Мен оларды бала деп ойлағанымда, бұл балалар
Dialogue: 0,0:56:06.61,0:56:07.78,Default,,0,0,0,,Мен сені құлатамын
Dialogue: 0,0:56:07.90,0:56:08.57,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:56:08.69,0:56:09.61,Default,,0,0,0,,Дорэмон қорқынышты
Dialogue: 0,0:56:09.74,0:56:11.61,Default,,0,0,0,,Міндетті түрде жеңе алсаңыз, келіңіз.
Dialogue: 0,0:56:11.86,0:56:12.99,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:56:13.36,0:56:14.57,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:56:16.28,0:56:17.49,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:56:17.62,0:56:19.08,Default,,0,0,0,,Ия, иә, иә!
Dialogue: 0,0:56:19.20,0:56:20.46,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:56:20.58,0:56:23.75,Default,,0,0,0,,Хе хе хе хе хе хе...
Dialogue: 0,0:56:23.88,0:56:25.96,Default,,0,0,0,,Рас, неге екені белгісіз күшейіп барады.
Dialogue: 0,0:56:26.54,0:56:29.88,Default,,0,0,0,,Жүр! (Нобита) Уау!
Dialogue: 0,0:56:31.30,0:56:33.09,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:56:33.34,0:56:35.51,Default,,0,0,0,,Барыңды істе, Нобита-кун!
Dialogue: 0,0:56:35.64,0:56:36.55,Default,,0,0,0,,Дора-чан, мықты бол!
Dialogue: 0,0:56:41.64,0:56:43.85,Default,,0,0,0,,Сен істедің, Нобита-кун.
Dialogue: 0,0:56:43.98,0:56:44.73,Default,,0,0,0,,Мен оны ессіз түрде жеңдім
Dialogue: 0,0:56:44.85,0:56:46.98,Default,,0,0,0,,Дора-чан Мен оны қарап шықтым.
Dialogue: 0,0:56:47.15,0:56:50.49,Default,,0,0,0,,Әй, бұл жай ғана арман шығар. Мен сондай күштімін...
Dialogue: 0,0:56:50.61,0:56:53.32,Default,,0,0,0,,Иә, бұл міндетті түрде арман.
Dialogue: 0,0:56:53.45,0:56:55.45,Default,,0,0,0,,Мен тағы да жақсы түс көріп жатырмын.
Dialogue: 0,0:56:55.87,0:56:59.04,Default,,0,0,0,,Нобита-кун қазірдің өзінде қатты қиыншылықта.
Dialogue: 0,0:56:59.16,0:57:01.41,Default,,0,0,0,,Олай болса, армандайтын машина!
Dialogue: 0,0:57:05.00,0:57:06.33,Default,,0,0,0,,Itte Itatata
Dialogue: 0,0:57:06.67,0:57:07.84,Default,,0,0,0,,Қараңызшы, бұл арман емес.
Dialogue: 0,0:57:07.96,0:57:10.30,Default,,0,0,0,,Жарайды, тоқтат, бұл түс емес еді.
Dialogue: 0,0:57:10.59,0:57:11.71,Default,,0,0,0,,Цк, есіңізде болсын.
Dialogue: 0,0:57:11.84,0:57:14.26,Default,,0,0,0,,Мен бұл ренішті тазартатыныма сенімдімін.
Dialogue: 0,0:57:14.51,0:57:17.51,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:57:18.72,0:57:22.18,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:57:22.64,0:57:25.23,Default,,0,0,0,,Дұрыс, тіпті көзге де түспейді.
Dialogue: 0,0:57:25.35,0:57:28.15,Default,,0,0,0,,Нобитаның екі тапаншасы оларды шауып тастады.
Dialogue: 0,0:57:28.31,0:57:31.11,Default,,0,0,0,,Жоқ, бұл жай ғана кездейсоқ, хехехе...
Dialogue: 0,0:57:31.48,0:57:33.28,Default,,0,0,0,,Нобита-кун күшті ғой, солай ма?
Dialogue: 0,0:57:33.40,0:57:36.53,Default,,0,0,0,,Сосын Дора-чанның соққысы шешілді.
Dialogue: 0,0:57:36.66,0:57:38.95,Default,,0,0,0,,Екеуміз кездейсоқ кездесіп қалдық...
Dialogue: 0,0:57:39.08,0:57:41.45,Default,,0,0,0,,Қиындық хехехехе...
Dialogue: 0,0:57:41.87,0:57:44.41,Default,,0,0,0,,Әй, осындай мықтыларымыз болса ғой...
Dialogue: 0,0:57:44.54,0:57:46.33,Default,,0,0,0,,Гартит кеншілері де -
Dialogue: 0,0:57:46.46,0:57:50.63,Default,,0,0,0,,Мен бұрынғыдай жаман ештеңе істей алмайтын шығармын.
Dialogue: 0,0:57:50.75,0:57:52.38,Default,,0,0,0,,Бұл өте пайдалы.
Dialogue: 0,0:57:53.05,0:57:55.55,Default,,0,0,0,,Бәріңе сәлем, Нобита мен Дораемон...
Dialogue: 0,0:57:55.68,0:57:58.30,Default,,0,0,0,,Құрметті азамат ретінде қарсы алуға рұқсат етіңіздер!
Dialogue: 0,0:57:58.43,0:58:02.31,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:58:02.81,0:58:04.14,Default,,0,0,0,,Иә, бұл кәдесый.
Dialogue: 0,0:58:04.27,0:58:05.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:58:05.27,0:58:06.02,Default,,0,0,0,,Не болды?
Dialogue: 0,0:58:13.78,0:58:15.24,Default,,0,0,0,,Бакамон!
Dialogue: 0,0:58:15.36,0:58:17.20,Default,,0,0,0,,Екі үлкен ересек балаға және роботқа айналады.
Dialogue: 0,0:58:17.61,0:58:19.74,Default,,0,0,0,,Қолсыз бұралған.
Dialogue: 0,0:58:19.87,0:58:22.66,Default,,0,0,0,,Сіз осындай күлкілі есепті штабқа жібере аласыз ба?
Dialogue: 0,0:58:22.91,0:58:24.45,Default,,0,0,0,,Бірақ... Бас Богант
Dialogue: 0,0:58:24.58,0:58:26.87,Default,,0,0,0,,Балалар жай адамдар емес.
Dialogue: 0,0:58:27.00,0:58:28.79,Default,,0,0,0,,Жер жұлдыздардан шыққанға ұқсайды...
Dialogue: 0,0:58:28.92,0:58:31.13,Default,,0,0,0,,Бұл мен туралы естіген Супермен.
Dialogue: 0,0:58:31.54,0:58:33.51,Default,,0,0,0,,Қандай супермен?
Dialogue: 0,0:58:33.63,0:58:35.30,Default,,0,0,0,,Цк, мен қорқып кеттім.
Dialogue: 0,0:58:35.42,0:58:37.09,Default,,0,0,0,,Ол жігіттерден тез құтыл!
Dialogue: 0,0:58:37.34,0:58:40.39,Default,,0,0,0,,Сонымен, біз Суперменміз.
Dialogue: 0,0:58:40.51,0:58:44.52,Default,,0,0,0,,Токай Токай, Коя Коя, мүмкін сол жердегі барлық жұлдыздар...
Dialogue: 0,0:58:44.64,0:58:46.81,Default,,0,0,0,,Оның аз ғана ауырлық күші бар.
Dialogue: 0,0:58:46.94,0:58:49.85,Default,,0,0,0,,Менің ойымша, бұл Гартиттің арқасында.
Dialogue: 0,0:58:49.98,0:58:50.69,Default,,0,0,0,,Хмм.
Dialogue: 0,0:58:50.81,0:58:52.94,Default,,0,0,0,,Басқаша айтқанда, ауырлық күші аз болса—
Dialogue: 0,0:58:53.07,0:58:56.24,Default,,0,0,0,,Қозғалыс үшін көп күш қажет емес.
Dialogue: 0,0:58:56.36,0:58:58.20,Default,,0,0,0,,Егер сіз осындай жұлдызға барсаңыз...
Dialogue: 0,0:58:58.32,0:59:01.62,Default,,0,0,0,,Тіпті Нобита да Супермен.
Dialogue: 0,0:59:01.74,0:59:02.49,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:59:02.99,0:59:07.12,Default,,0,0,0,,Мен Коякоя планетасындағы Суперменмін, бірақ...
Dialogue: 0,0:59:07.25,0:59:09.79,Default,,0,0,0,,Жерде әлсіз болу сенің жаман екеніңді білдірмейді.
Dialogue: 0,0:59:09.92,0:59:12.21,Default,,0,0,0,,Дұрыс, қайырлы түн.
Dialogue: 0,0:59:12.34,0:59:13.29,Default,,0,0,0,,Умм...
Dialogue: 0,0:59:17.97,0:59:20.18,Default,,0,0,0,,Сәлем Нобита...
Dialogue: 0,0:59:20.30,0:59:22.26,Default,,0,0,0,,Сіз не туралы айтып жатырсыз? Жүр, тезірек.
Dialogue: 0,0:59:22.39,0:59:24.93,Default,,0,0,0,,Допты осында әкеліңіз.
Dialogue: 0,0:59:25.06,0:59:28.10,Default,,0,0,0,,Допты ал, бірақ мен оны салмаймын.
Dialogue: 0,0:59:28.23,0:59:30.31,Default,,0,0,0,,Кууууууууу
Dialogue: 0,0:59:32.06,0:59:33.23,Default,,0,0,0,,Нихихихихи... (Сунео) Фуфуфу
Dialogue: 0,0:59:33.57,0:59:34.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:35.40,0:59:38.24,Default,,0,0,0,,Доптарды осылай лақтыра берсең, біраз уақыт ішке кіре алмайсың.
Dialogue: 0,0:59:38.36,0:59:38.57,Default,,0,0,0,,Допты алу да жақсы идея хахахахаха
Dialogue: 0,0:59:38.57,0:59:40.49,Default,,0,0,0,,Допты алу да жақсы идея хахахахаха
Dialogue: 0,0:59:38.57,0:59:40.49,Default,,0,0,0,,Не?!
Dialogue: 0,0:59:40.49,0:59:42.37,Default,,0,0,0,,Допты алу да жақсы идея хахахахаха
Dialogue: 0,0:59:43.95,0:59:44.95,Default,,0,0,0,,Нобита-кун...
Dialogue: 0,0:59:48.08,0:59:54.09,Default,,0,0,0,,♪〜
Dialogue: 0,1:00:21.74,1:00:27.74,Default,,0,0,0,,〜♪
Dialogue: 0,1:00:36.63,1:00:37.38,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:00:42.47,1:00:44.68,Default,,0,0,0,,ияййййййййййййййййййййййййййййййййййййййййййййй!
Dialogue: 0,1:00:47.26,1:00:48.26,Default,,0,0,0,,Тоқта, өтінемін.
Dialogue: 0,1:00:48.72,1:00:50.18,Default,,0,0,0,,Уау
Dialogue: 0,1:00:50.31,1:00:52.19,Default,,0,0,0,,Уф аххх
Dialogue: 0,1:00:52.31,1:00:54.69,Default,,0,0,0,,Эй, эй
Dialogue: 0,1:00:54.81,1:00:56.69,Default,,0,0,0,,Әке
Dialogue: 0,1:01:04.70,1:01:06.12,Default,,0,0,0,,Б-бірақ… сәби аман.
Dialogue: 0,1:01:06.87,1:01:07.83,Default,,0,0,0,,Хахаха
Dialogue: 0,1:01:07.95,1:01:11.87,Default,,0,0,0,,Енді сабақ алдың, бұл планетадан кет!
Dialogue: 0,1:01:12.00,1:01:13.04,Default,,0,0,0,,О, бұл...
Dialogue: 0,1:01:13.16,1:01:13.83,Default,,0,0,0,,Не?
Dialogue: 0,1:01:16.71,1:01:18.04,Default,,0,0,0,,Сен тағы да мені мазаламақ болып келдің.
Dialogue: 0,1:01:18.17,1:01:18.92,Default,,0,0,0,,Оны жең!
Dialogue: 0,1:01:22.30,1:01:24.34,Default,,0,0,0,,Хирари плащы!
Dialogue: 0,1:01:29.43,1:01:30.89,Default,,0,0,0,,Уау (С бағыныңқысы) Уау
Dialogue: 0,1:01:31.77,1:01:33.02,Default,,0,0,0,,Уау
Dialogue: 0,1:01:37.77,1:01:38.94,Default,,0,0,0,,Иә
Dialogue: 0,1:01:39.69,1:01:41.48,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:01:41.61,1:01:43.90,Default,,0,0,0,,Уау
Dialogue: 0,1:01:46.28,1:01:47.28,Default,,0,0,0,,Бұл қандай зат?
Dialogue: 0,1:01:47.41,1:01:48.99,Default,,0,0,0,,Бұл тым қауіпті! Біз Сантананы өлтіруіміз керек.
Dialogue: 0,1:01:49.12,1:01:49.99,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:53.37,1:01:56.54,Default,,0,0,0,,(Каморанның айқайы)
Dialogue: 0,1:02:01.46,1:02:04.59,Default,,0,0,0,,Нобита, сен осы күндері мүлдем оқымадың.
Dialogue: 0,1:02:04.72,1:02:06.09,Default,,0,0,0,,Жұмыс үстеліңізге отырыңыз
Dialogue: 0,1:02:06.22,1:02:07.14,Default,,0,0,0,,Иә Иә Иә
Dialogue: 0,1:02:07.51,1:02:10.64,Default,,0,0,0,,Тесттен 0 балл алсаңыз да, білмейсіз.
Dialogue: 0,1:02:14.14,1:02:15.81,Default,,0,0,0,,Хе хе хи хи хи хи хи хи
Dialogue: 0,1:02:15.94,1:02:21.94,Default,,0,0,0,,♪〜
Dialogue: 0,1:02:42.71,1:02:48.72,Default,,0,0,0,,〜♪
Dialogue: 0,1:02:48.84,1:02:50.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:50.30,1:02:51.22,Default,,0,0,0,,Ахх...
Dialogue: 0,1:02:51.35,1:02:52.18,Default,,0,0,0,,(Джан Сунеоның күлкісі)
Dialogue: 0,1:02:52.31,1:02:54.47,Default,,0,0,0,,♪ Елеусіз Нобита
Dialogue: 0,1:02:54.60,1:02:55.64,Default,,0,0,0,,Мен тамаша бөксе көрдім
Dialogue: 0,1:02:55.77,1:02:57.23,Default,,0,0,0,,♪ Мен көрдім, көрдім
Dialogue: 0,1:02:57.77,1:02:58.90,Default,,0,0,0,,Уншо
Dialogue: 0,1:03:01.40,1:03:03.07,Default,,0,0,0,,Кеттік, Дораемон
Dialogue: 0,1:03:05.57,1:03:07.24,Default,,0,0,0,,Өйткені адамдар өзгереді.
Dialogue: 0,1:03:07.36,1:03:08.07,Default,,0,0,0,,Нобита!
Dialogue: 0,1:03:08.20,1:03:10.41,Default,,0,0,0,,Ах
Dialogue: 0,1:03:12.16,1:03:13.12,Default,,0,0,0,,О... О?
Dialogue: 0,1:03:13.58,1:03:15.79,Default,,0,0,0,,Мен сені енді кетті деп ойладым, бірақ сен енді жоқсың.
Dialogue: 0,1:03:15.91,1:03:17.04,Default,,0,0,0,,Шынымен, бала...
Dialogue: 0,1:03:28.72,1:03:29.68,Default,,0,0,0,,Радиобасқарылатын модель ұшақ! Ха!
Dialogue: 0,1:03:29.80,1:03:31.47,Default,,0,0,0,,Барлығын күлге айналдыр
Dialogue: 0,1:03:31.59,1:03:33.64,Default,,0,0,0,,Не дедің!
Dialogue: 0,1:03:35.26,1:03:36.68,Default,,0,0,0,,Әй, асыл дақылдар...
Dialogue: 0,1:03:36.81,1:03:37.48,Default,,0,0,0,,Тоқтату керек
Dialogue: 0,1:03:37.73,1:03:39.23,Default,,0,0,0,,Мен көптен күттім. Сіз бұл жолы істемейсіз.
Dialogue: 0,1:03:39.48,1:03:41.44,Default,,0,0,0,,Өкінбеймін.
Dialogue: 0,1:03:43.15,1:03:43.94,Default,,0,0,0,,Жоқ, солай.
Dialogue: 0,1:03:44.07,1:03:47.03,Default,,0,0,0,,Жарайды, пластмассадан жасалған оқты үлкейтейік.
Dialogue: 0,1:03:47.15,1:03:48.90,Default,,0,0,0,,Ал, бұл қайсысы болды?
Dialogue: 0,1:03:49.03,1:03:51.99,Default,,0,0,0,,Хмм, қайтару шамы жақсы емес.
Dialogue: 0,1:03:52.11,1:03:54.03,Default,,0,0,0,,Люкс жарығы үшін кескін шамы
Dialogue: 0,1:03:54.16,1:03:56.33,Default,,0,0,0,,Ай сәулесі және флуоресцентті шамдар Хмм...
Dialogue: 0,1:03:56.45,1:03:57.25,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:03:57.62,1:03:58.45,Default,,0,0,0,,Үлкен жарық!
Dialogue: 0,1:03:58.79,1:03:59.79,Default,,0,0,0,,Ичини
Dialogue: 0,1:03:59.91,1:04:00.67,Default,,0,0,0,,Күн!
Dialogue: 0,1:04:03.96,1:04:05.71,Default,,0,0,0,,Ал, мен бүгін жасаймын.
Dialogue: 0,1:04:05.84,1:04:07.46,Default,,0,0,0,,Пинсер шабуылы
Dialogue: 0,1:04:09.42,1:04:10.30,Default,,0,0,0,,Ичини
Dialogue: 0,1:04:10.42,1:04:11.22,Default,,0,0,0,,Күн!
Dialogue: 0,1:04:12.59,1:04:13.39,Default,,0,0,0,,Наранция Гилго 1984 жылы, Арыстан белгісінің астында дүниеге келген
Dialogue: 0,1:04:13.51,1:04:14.35,Default,,0,0,0,,Менің қашып кетуіме жол берме.
Dialogue: 0,1:04:14.47,1:04:16.18,Default,,0,0,0,,Уау...
Dialogue: 0,1:04:17.14,1:04:19.14,Default,,0,0,0,,А, мұнда кел. Апыр-ай!
Dialogue: 0,1:04:19.68,1:04:20.98,Default,,0,0,0,,Қауіпті Нобита-кун
Dialogue: 0,1:04:21.10,1:04:23.10,Default,,0,0,0,,Кішкентай жарық!
Dialogue: 0,1:04:23.23,1:04:25.11,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:04:26.19,1:04:28.32,Default,,0,0,0,,А-а, бұл мені құтқарды.
Dialogue: 0,1:04:28.48,1:04:30.65,Default,,0,0,0,,Жарайсыңдар балалар
Dialogue: 0,1:04:31.40,1:04:33.53,Default,,0,0,0,,Қашқаннан пайда жоқ
Dialogue: 0,1:04:34.78,1:04:36.45,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:04:37.87,1:04:38.58,Default,,0,0,0,,Фу…
Dialogue: 0,1:04:40.71,1:04:41.66,Default,,0,0,0,,Бұл қандай зат?
Dialogue: 0,1:04:41.79,1:04:43.79,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,1:04:44.83,1:04:47.21,Default,,0,0,0,,Не, тағы да былдырдың ба?
Dialogue: 0,1:04:47.84,1:04:50.88,Default,,0,0,0,,Мен олардың бірнеше рет үзілгеніне сене алар емеспін ...
Dialogue: 0,1:04:51.01,1:04:53.38,Default,,0,0,0,,Міне нағыз Супермен.
Dialogue: 0,1:04:53.51,1:04:54.68,Default,,0,0,0,,Бұл өте көңілсіз
Dialogue: 0,1:04:54.97,1:04:55.97,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:04:56.10,1:04:57.60,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,1:04:57.72,1:04:58.93,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,1:04:59.06,1:05:02.64,Default,,0,0,0,,Мен штабтан күшті көмек сұрадым.
Dialogue: 0,1:05:35.72,1:05:38.68,Default,,0,0,0,,Біздің компания осы арал әлемінде ізашар болғаннан бері—
Dialogue: 0,1:05:38.80,1:05:42.31,Default,,0,0,0,,Гальтит кенін өндіру кестеге сай жүргізілуде.
Dialogue: 0,1:05:42.43,1:05:45.48,Default,,0,0,0,,Осы Коя Коя ғана қалды.
Dialogue: 0,1:05:45.73,1:05:48.19,Default,,0,0,0,,Сонымен бұл Гильерминнің пікірі...
Dialogue: 0,1:05:48.31,1:05:50.57,Default,,0,0,0,,Суперменді алып тастау туралы ойлану -
Dialogue: 0,1:05:50.69,1:05:52.61,Default,,0,0,0,,Жерлік деп аталатын Супермен...
Dialogue: 0,1:05:52.74,1:05:55.40,Default,,0,0,0,,Сіз бұл планетаға қалай жетесіз?
Dialogue: 0,1:05:55.61,1:05:58.37,Default,,0,0,0,,Гот әйел Мені дереу табыңыз.
Dialogue: 0,1:05:58.49,1:05:59.24,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,1:05:59.37,1:06:02.16,Default,,0,0,0,,Алайда, білсең де, менімен араласпа.
Dialogue: 0,1:06:02.29,1:06:03.83,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,1:06:04.58,1:06:09.59,Default,,0,0,0,,Қалғаны сізге байланысты, өлтіруші Гильермин.
Dialogue: 0,1:06:29.31,1:06:31.07,Default,,0,0,0,,Уау, қыс келді
Dialogue: 0,1:06:31.19,1:06:34.53,Default,,0,0,0,,Қызыл-көк қар жауып, күлгін қар үйіліп жатыр.
Dialogue: 0,1:06:34.65,1:06:37.20,Default,,0,0,0,,Әй, бұл әдемі емес пе?
Dialogue: 0,1:06:41.83,1:06:46.71,Default,,0,0,0,,Менің бұл планетада жүргеніме бір жылдай болды.
Dialogue: 0,1:06:46.83,1:06:49.04,Default,,0,0,0,,Күндер өте тез өтеді.
Dialogue: 0,1:06:49.67,1:06:52.55,Default,,0,0,0,,Анам қыстауға дайындалып жатыр.
Dialogue: 0,1:06:52.67,1:06:53.92,Default,,0,0,0,,Бірақ биылғы қыс...
Dialogue: 0,1:06:54.05,1:06:57.84,Default,,0,0,0,,Мен Нобита-кун үйреткен бесікті ойнап, қызық боламын деп ойлаймын.
Dialogue: 0,1:06:57.97,1:06:59.39,Default,,0,0,0,,Сәлем Клем-чан
Dialogue: 0,1:06:59.51,1:07:00.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:00.51,1:07:03.64,Default,,0,0,0,,Біз қайта келе алмауымыз мүмкін.
Dialogue: 0,1:07:03.76,1:07:05.93,Default,,0,0,0,,Келесі көктемге дейін сәл қоштасамыз.
Dialogue: 0,1:07:06.35,1:07:07.77,Default,,0,0,0,,Жалғыздықты сезіну
Dialogue: 0,1:07:07.89,1:07:09.73,Default,,0,0,0,,Жақында тағы кездесеміз
Dialogue: 0,1:07:09.85,1:07:10.69,Default,,0,0,0,,Иә.
Dialogue: 0,1:07:14.86,1:07:17.07,Default,,0,0,0,,Пами
Dialogue: 0,1:07:17.19,1:07:18.70,Default,,0,0,0,,Радиобасқарылатын модель ұшақ! Ха!
Dialogue: 0,1:07:20.66,1:07:22.41,Default,,0,0,0,,Кел, Бубу-кун.
Dialogue: 0,1:07:22.53,1:07:25.95,Default,,0,0,0,,Егер сіз маған жердегілердің қалай келетінін айтып берсеңіз...
Dialogue: 0,1:07:26.08,1:07:28.54,Default,,0,0,0,,Сіз, Каморан отбасы, мен сізді қумаймын.
Dialogue: 0,1:07:28.66,1:07:29.83,Default,,0,0,0,,Оның үстіне әкем...
Dialogue: 0,1:07:29.96,1:07:32.54,Default,,0,0,0,,Біз Gartite Mining кеншілерін қарсы аламыз—
Dialogue: 0,1:07:32.67,1:07:34.59,Default,,0,0,0,,Мен президенттен сұраймын
Dialogue: 0,1:07:34.80,1:07:39.55,Default,,0,0,0,,Әлде мен сені соққылы мылтықпен айтуға мәжбүрлеуім керек пе?
Dialogue: 0,1:07:39.88,1:07:45.01,Default,,0,0,0,,Хехе, мен ешнәрсе істемеймін, сондықтан маған айтшы, Бубу-кун.
Dialogue: 0,1:07:45.14,1:07:47.18,Default,,0,0,0,,Мен... түсінемін.
Dialogue: 0,1:07:47.85,1:07:49.89,Default,,0,0,0,,Жарайсыңдар, бәрің де сау болыңдар, бар күш-жігеріңді салыңдар.
Dialogue: 0,1:07:50.02,1:07:51.40,Default,,0,0,0,,Нобита-кун мен Дораемон да.
Dialogue: 0,1:07:51.52,1:07:52.19,Default,,0,0,0,,Жақсы көңіл-күй
Dialogue: 0,1:07:52.52,1:07:54.48,Default,,0,0,0,,Көктем келгенде тағы да кел.
Dialogue: 0,1:07:54.61,1:07:56.11,Default,,0,0,0,,Қош бол, сенің келетініңе сенімдімін
Dialogue: 0,1:07:56.23,1:07:57.40,Default,,0,0,0,,Қош бол
Dialogue: 0,1:07:57.86,1:07:59.40,Default,,0,0,0,,Жүр, Клем, сен суық тиіп кетесің.
Dialogue: 0,1:07:59.53,1:08:00.61,Default,,0,0,0,,Иә...
Dialogue: 0,1:08:02.82,1:08:04.45,Default,,0,0,0,,Му Му
Dialogue: 0,1:08:04.58,1:08:08.58,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:08:16.30,1:08:19.17,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,1:08:24.89,1:08:29.23,Default,,0,0,0,,Бас кеңседен күткендей, сізде басқа деңгейдегі интеллект бар.
Dialogue: 0,1:08:29.35,1:08:33.56,Default,,0,0,0,,Сол жердегілер кіретін есікке жарылғыш зат қоямыз деп ойлау...
Dialogue: 0,1:08:33.69,1:08:35.02,Default,,0,0,0,,Жоқ, мен қорықтым.
Dialogue: 0,1:08:35.15,1:08:37.11,Default,,0,0,0,,Тек өлтіруші болып жұмыс істемеңіз.
Dialogue: 0,1:08:37.23,1:08:40.40,Default,,0,0,0,,Айла компьютермен жойылмайды.
Dialogue: 0,1:08:40.53,1:08:41.49,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:41.61,1:08:44.03,Default,,0,0,0,,Дұрыс хахаха
Dialogue: 0,1:08:44.20,1:08:45.45,Default,,0,0,0,,Су толқындары, олар кеткен жерге шабуыл жасаңдар
Dialogue: 0,1:08:49.54,1:08:51.71,Default,,0,0,0,,Хи хи хи хи...
Dialogue: 0,1:08:53.29,1:08:54.17,Default,,0,0,0,,Сонымен қатар, бұл миссия «Büki» операциясының сәттілігі мен сәтсіздігі үшін шешуші болғандықтан, артық уайымдамаңыз
Dialogue: 0,1:08:54.29,1:08:56.75,Default,,0,0,0,,Күнде, күнде, Мен тым алысқа барамын.
Dialogue: 0,1:08:56.88,1:08:58.25,Default,,0,0,0,,Әзірше сыртқа шығуға рұқсат етілмейді.
Dialogue: 0,1:08:58.50,1:09:00.80,Default,,0,0,0,,Жарайды, Дора-чан, мені бақылап жүр.
Dialogue: 0,1:09:00.92,1:09:04.09,Default,,0,0,0,,Әйтпесе, сізге де Нобита сияқты көшеге шығуға тыйым салынады.
Dialogue: 0,1:09:04.22,1:09:05.22,Default,,0,0,0,,Иә, анашым
Dialogue: 0,1:09:09.56,1:09:10.64,Default,,0,0,0,,Иә.
Dialogue: 0,1:09:14.98,1:09:18.36,Default,,0,0,0,,Ха, о... ой
Dialogue: 0,1:09:20.40,1:09:22.49,Default,,0,0,0,,Қазірдің өзінде... уф.
Dialogue: 0,1:09:28.41,1:09:30.33,Default,,0,0,0,,Ах
Dialogue: 0,1:09:30.66,1:09:31.66,Default,,0,0,0,,Ах
Dialogue: 0,1:09:32.37,1:09:34.04,Default,,0,0,0,,Ах! (Чамми) Бұл жер сілкінісі!
Dialogue: 0,1:09:38.34,1:09:39.46,Default,,0,0,0,,Ах
Dialogue: 0,1:09:40.21,1:09:43.13,Default,,0,0,0,,Коякоя планетасының пионер иммигранттары
Dialogue: 0,1:09:43.26,1:09:48.35,Default,,0,0,0,,Бұл жұлдыз тектоникалық қозғалыстарға байланысты бірнеше күн ішінде жарылуы мүмкін.
Dialogue: 0,1:09:48.47,1:09:53.43,Default,,0,0,0,,Тез арада эвакуациялаңыз, әйтпесе иммигранттардың өміріне кепілдік жоқ.
Dialogue: 0,1:09:56.19,1:09:57.86,Default,,0,0,0,,Богант
Dialogue: 0,1:09:58.23,1:09:59.77,Default,,0,0,0,,Бұл сөзсіз өтірік
Dialogue: 0,1:10:00.23,1:10:03.07,Default,,0,0,0,,Әкем бұл жұлдызды тауып, оны байқады.
Dialogue: 0,1:10:03.19,1:10:06.86,Default,,0,0,0,,Жер қыртысы өте тұрақты болғандықтан, осы жерге көшуді жөн көрдік.
Dialogue: 0,1:10:06.99,1:10:11.04,Default,,0,0,0,,Мен мұны кенеттен тектоникалық ығысу деп елестете алмаймын.
Dialogue: 0,1:10:12.12,1:10:14.79,Default,,0,0,0,,Енді ойлап қарасам, ол кісі бірде осылай депті.
Dialogue: 0,1:10:14.91,1:10:17.63,Default,,0,0,0,,«Олар Гартитке толы планетада».
Dialogue: 0,1:10:17.75,1:10:22.76,Default,,0,0,0,,«Біз жер астына негізгі құрылғы деп аталатын нәрсені отырғызып, оны жоймақпыз».
Dialogue: 0,1:10:23.51,1:10:27.43,Default,,0,0,0,,Ах... Осындай уақытта Супермен келсе екен.
Dialogue: 0,1:10:28.80,1:10:31.64,Default,,0,0,0,,Не? Жұмыс істемей жатыр…
Dialogue: 0,1:10:33.27,1:10:35.14,Default,,0,0,0,,(Піл дыбыстары)
Dialogue: 0,1:10:45.19,1:10:45.99,Default,,0,0,0,,Не? Жұмыс істемей жатыр…
Dialogue: 0,1:10:45.99,1:10:47.61,Default,,0,0,0,,Не? Жұмыс істемей жатыр…
Dialogue: 0,1:10:45.99,1:10:47.61,Default,,0,0,0,,Қорқынышты (Ана) Ах.
Dialogue: 0,1:10:47.99,1:10:52.58,Default,,0,0,0,,Не? Жұмыс істемей жатыр…
Dialogue: 0,1:10:53.12,1:10:53.87,Default,,0,0,0,,Тыңда, Чумми.
Dialogue: 0,1:10:53.99,1:10:56.16,Default,,0,0,0,,Мен бұрын естіген нәрсе - ядроны жою құрылғысы.
Dialogue: 0,1:10:56.29,1:10:58.50,Default,,0,0,0,,Ол шахтада терең жер астында орнатылған болуы керек.
Dialogue: 0,1:10:58.62,1:11:01.50,Default,,0,0,0,,Біздің планетаны қорғаудың жалғыз жолы - оны жою.
Dialogue: 0,1:11:01.63,1:11:04.13,Default,,0,0,0,,Анам мен Клемге айтпа.
Dialogue: 0,1:11:04.42,1:11:06.17,Default,,0,0,0,,Роп
Dialogue: 0,1:11:08.13,1:11:09.80,Default,,0,0,0,,Барма, бұл қауіпті!
Dialogue: 0,1:11:10.47,1:11:12.30,Default,,0,0,0,,Лоплу!
Dialogue: 0,1:11:12.68,1:11:14.68,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:11:15.47,1:11:16.64,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:11:16.77,1:11:19.19,Default,,0,0,0,,Нобитаның жетекшісі болғаныңыз үшін рахмет.
Dialogue: 0,1:11:19.31,1:11:23.02,Default,,0,0,0,,Шизука-чанмен бірге болсаң, аздап сабақ оқисың деп ойлаймын.
Dialogue: 0,1:11:23.15,1:11:24.69,Default,,0,0,0,,Иә, түсіндім, апай.
Dialogue: 0,1:11:24.90,1:11:26.65,Default,,0,0,0,,Мен жаңа ғана супермаркетке бардым.
Dialogue: 0,1:11:27.15,1:11:30.32,Default,,0,0,0,,Ей, Нобита-кун, сәл байыптап оқиық.
Dialogue: 0,1:11:30.45,1:11:32.49,Default,,0,0,0,,Түс сияқты нәрселерді жай айтпаңыз
Dialogue: 0,1:11:32.62,1:11:34.37,Default,,0,0,0,,Бұл арман емес, солай ма?
Dialogue: 0,1:11:34.49,1:11:37.62,Default,,0,0,0,,Біз бұл планетада шынымен Суперменміз.
Dialogue: 0,1:11:37.75,1:11:38.58,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,1:11:38.71,1:11:42.08,Default,,0,0,0,,Иә, бұл тек біз емес, жер бетіндегі әрбір адам.
Dialogue: 0,1:11:43.38,1:11:44.04,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:12:01.94,1:12:03.31,Default,,0,0,0,,О-о-о-о-о
Dialogue: 0,1:12:03.44,1:12:05.32,Default,,0,0,0,,А-а-а-а
Dialogue: 0,1:12:06.44,1:12:08.07,Default,,0,0,0,,Вааах!
Dialogue: 0,1:12:09.99,1:12:11.45,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:12:11.82,1:12:13.41,Default,,0,0,0,,Ах
Dialogue: 0,1:12:16.45,1:12:17.62,Default,,0,0,0,,Иә!
Dialogue: 0,1:12:17.75,1:12:20.00,Default,,0,0,0,,Супермен де тек ағаштың бір бөлігі.
Dialogue: 0,1:12:24.21,1:12:26.21,Default,,0,0,0,,Ноби-чан Дора-чан
Dialogue: 0,1:12:34.14,1:12:35.43,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:12:36.31,1:12:37.26,Default,,0,0,0,,Уау, Чумми
Dialogue: 0,1:12:37.60,1:12:39.27,Default,,0,0,0,,Не... не болды? Ах, жақсы...
Dialogue: 0,1:12:46.40,1:12:49.61,Default,,0,0,0,,Е, Роппуру-кун, сен шахтаға жалғыз бардың ба?
Dialogue: 0,1:12:49.74,1:12:51.65,Default,,0,0,0,,Қанша болса да...
Dialogue: 0,1:12:51.78,1:12:53.61,Default,,0,0,0,,Олар ондай емес.
Dialogue: 0,1:12:53.74,1:12:55.37,Default,,0,0,0,,Маған көмектесіңізші.
Dialogue: 0,1:12:55.49,1:12:56.58,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:12:57.12,1:12:58.70,Default,,0,0,0,,Шизука-чан, мен естігендей болды.
Dialogue: 0,1:12:58.83,1:13:01.54,Default,,0,0,0,,Анам не десе де мен барамын.
Dialogue: 0,1:13:01.66,1:13:03.54,Default,,0,0,0,,Достарыңызды жалғыз қалдыра алмайсыз
Dialogue: 0,1:13:03.67,1:13:05.50,Default,,0,0,0,,Бірақ жалғыз болған дұрыс па?
Dialogue: 0,1:13:05.63,1:13:08.38,Default,,0,0,0,,Әрине мен сенің соңынан еремін, уайымдама.
Dialogue: 0,1:13:08.50,1:13:09.51,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,1:13:10.38,1:13:11.92,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,1:13:12.05,1:13:13.18,Default,,0,0,0,,А-а-а
Dialogue: 0,1:13:13.93,1:13:18.10,Default,,0,0,0,,Жаман, гиперкеңістік байланысы жойылғалы тұр.
Dialogue: 0,1:13:18.22,1:13:21.14,Default,,0,0,0,,Бәлкім, осылай бөлек қалармыз...
Dialogue: 0,1:13:21.48,1:13:23.60,Default,,0,0,0,,Мүмкін мені осы уақытқа дейін байланыстырған жалғыз нәрсе —
Dialogue: 0,1:13:23.73,1:13:25.94,Default,,0,0,0,,Бұл біртүрлі, өйткені бұл бірдеңе болды
Dialogue: 0,1:13:26.06,1:13:27.11,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:13:27.40,1:13:29.86,Default,,0,0,0,,Бірақ біраз уақытқа дейін бәрі жақсы болады, солай ма?
Dialogue: 0,1:13:29.98,1:13:31.07,Default,,0,0,0,,Иә, мүмкін.
Dialogue: 0,1:13:31.78,1:13:33.57,Default,,0,0,0,,Өтінемін, анаңды алдап көр.
Dialogue: 0,1:13:33.70,1:13:34.53,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,1:13:34.66,1:13:36.03,Default,,0,0,0,,Бұл! Алақай!
Dialogue: 0,1:13:36.62,1:13:39.28,Default,,0,0,0,,Тоттотто... Ахх
Dialogue: 0,1:13:39.74,1:13:41.37,Default,,0,0,0,,Уф уф...
Dialogue: 0,1:13:42.00,1:13:44.29,Default,,0,0,0,,Бұл қорқынышты болады.
Dialogue: 0,1:13:44.42,1:13:45.67,Default,,0,0,0,,Бұл олардың кінәсі болуы керек.
Dialogue: 0,1:13:45.79,1:13:47.38,Default,,0,0,0,,Тез
Dialogue: 0,1:13:48.25,1:13:50.59,Default,,0,0,0,,Мен достарымды жалғыз қалдыра алмаймын
Dialogue: 0,1:13:50.71,1:13:51.92,Default,,0,0,0,,Ха…
Dialogue: 0,1:13:53.76,1:13:55.22,Default,,0,0,0,,Ах... о, Шизука-чан
Dialogue: 0,1:13:55.34,1:13:56.09,Default,,0,0,0,,Мен бірден қайтамын
Dialogue: 0,1:13:56.22,1:13:57.55,Default,,0,0,0,,Иә... иә?
Dialogue: 0,1:14:07.10,1:14:08.61,Default,,0,0,0,,Ропле-кун
Dialogue: 0,1:14:12.65,1:14:14.74,Default,,0,0,0,,Жақындау жолы бар ма?
Dialogue: 0,1:14:15.24,1:14:17.49,Default,,0,0,0,,Эй, өтінемін, Нобита-кунмен татуласып көр.
Dialogue: 0,1:14:17.70,1:14:18.53,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:18.66,1:14:21.70,Default,,0,0,0,,Маған жорғалап келіп кешірім сұрамаса.
Dialogue: 0,1:14:21.83,1:14:23.41,Default,,0,0,0,,Мұрын арқылы спагетти жеу -
Dialogue: 0,1:14:23.54,1:14:25.87,Default,,0,0,0,,Нанкин бұршақтарын көзіңізбен шайнауға тырыспаңыз.
Dialogue: 0,1:14:26.00,1:14:28.08,Default,,0,0,0,,Бұлай айтқанда мені тыңда!
Dialogue: 0,1:14:43.47,1:14:44.68,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,1:14:49.98,1:14:51.15,Default,,0,0,0,,Ах
Dialogue: 0,1:14:52.07,1:14:54.53,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,1:14:56.40,1:14:57.49,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:14:57.61,1:14:58.28,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:14:58.41,1:14:59.53,Default,,0,0,0,,Роппл мырза!
Dialogue: 0,1:14:59.70,1:15:01.24,Default,,0,0,0,,Ухухухуху
Dialogue: 0,1:15:01.37,1:15:02.66,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:15:02.78,1:15:04.20,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:15:04.62,1:15:07.12,Default,,0,0,0,,Нобита достарымен осындай қауіпті жерге барды ма?
Dialogue: 0,1:15:07.25,1:15:09.33,Default,,0,0,0,,Сен ақымақсың. Кел, Сунео.
Dialogue: 0,1:15:09.46,1:15:10.17,Default,,0,0,0,,Хун ғұн
Dialogue: 0,1:15:12.42,1:15:13.88,Default,,0,0,0,,Уау...
Dialogue: 0,1:15:20.34,1:15:24.22,Default,,0,0,0,,Қараңызшы, Гильермин, ядроны жою құрылғысы бар қол...
Dialogue: 0,1:15:24.35,1:15:27.60,Default,,0,0,0,,Біз бұл планетаның орталығына да жеттік.
Dialogue: 0,1:15:27.73,1:15:33.98,Default,,0,0,0,,Сол қызыл шам жарқырап, сары-ақтан көк-аққа ауысқанда...
Dialogue: 0,1:15:34.36,1:15:36.15,Default,,0,0,0,,Не? Жұмыс істемей жатыр…
Dialogue: 0,1:15:39.99,1:15:43.83,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:15:44.20,1:15:47.62,Default,,0,0,0,,Бұл коя коя бөліктерге бөлінеді
Dialogue: 0,1:15:47.75,1:15:48.83,Default,,0,0,0,,Не дедің!
Dialogue: 0,1:15:48.96,1:15:50.92,Default,,0,0,0,,Богант мырза
Dialogue: 0,1:15:51.04,1:15:53.84,Default,,0,0,0,,Мен жаңа ғана жартастың басынан вагонетканың құлағанын көрдім...
Dialogue: 0,1:15:54.04,1:15:56.42,Default,,0,0,0,,Бакамон! Троллейбус өздігінен құлай ма?
Dialogue: 0,1:15:56.55,1:15:58.30,Default,,0,0,0,,Анықтау добын атып, зерттеңіз.
Dialogue: 0,1:15:58.59,1:15:59.80,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,1:16:02.43,1:16:03.60,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:07.14,1:16:10.06,Default,,0,0,0,,Жоғары дайындықта болыңыз. Сіз бұлай жақындай алмайсыз.
Dialogue: 0,1:16:10.19,1:16:13.81,Default,,0,0,0,,Бұл жеткіліксіз. Егер біз жойқын құрылғыны тоқтатпасақ, бұл планета...
Dialogue: 0,1:16:13.94,1:16:16.44,Default,,0,0,0,,Дораемон, тез бірдеңе жасашы.
Dialogue: 0,1:16:16.57,1:16:19.19,Default,,0,0,0,,Хмм, сіз айттыңыз ...
Dialogue: 0,1:16:19.65,1:16:21.82,Default,,0,0,0,,Менің таңдауым жоқ. Мен мұны пайдалануым керек пе?
Dialogue: 0,1:16:21.95,1:16:25.12,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,1:16:25.66,1:16:27.74,Default,,0,0,0,,Гирокапсула!
Dialogue: 0,1:16:27.87,1:16:29.04,Default,,0,0,0,,Тез
Dialogue: 0,1:16:29.91,1:16:31.62,Default,,0,0,0,,Эй, Дораемон күткендей
Dialogue: 0,1:16:31.75,1:16:32.50,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:16:33.00,1:16:36.42,Default,,0,0,0,,Бұл капсула кез келген пішінді қабылдай алады.
Dialogue: 0,1:16:42.88,1:16:43.89,Default,,0,0,0,,Кеттік
Dialogue: 0,1:16:49.39,1:16:52.64,Default,,0,0,0,,Айналса да, арнайы серіппенің арқасында ішінде бір деңгейде қалады.
Dialogue: 0,1:16:53.10,1:16:55.06,Default,,0,0,0,,А, жоқ, бағытты өзгерт.
Dialogue: 0,1:16:59.53,1:17:00.90,Default,,0,0,0,,А, мен таң қалдым.
Dialogue: 0,1:17:01.03,1:17:02.03,Default,,0,0,0,,Бұл құлап жатқан тас.
Dialogue: 0,1:17:02.61,1:17:04.11,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:17:04.24,1:17:05.87,Default,,0,0,0,,Нобита және басқалары қайда?
Dialogue: 0,1:17:05.99,1:17:08.58,Default,,0,0,0,,О, жоқ... бұл кім! (Сунео) Ах!
Dialogue: 0,1:17:08.70,1:17:12.21,Default,,0,0,0,,Балалар сендер жерлессіңдер, солай ма? Сіз Суперменнің досысыз ба?
Dialogue: 0,1:17:12.33,1:17:13.71,Default,,0,0,0,,Супермен? Бұл Нобита-кун туралы.
Dialogue: 0,1:17:14.08,1:17:16.63,Default,,0,0,0,,Әй, эй, бұл қалай болды?
Dialogue: 0,1:17:17.13,1:17:18.67,Default,,0,0,0,,Барлығы, менің кінәм.
Dialogue: 0,1:17:18.80,1:17:21.55,Default,,0,0,0,,Өйткені мен оларға есіктің сырын айттым.
Dialogue: 0,1:17:21.88,1:17:23.51,Default,,0,0,0,,Мен болған жағдайға көмектесе алмаймын.
Dialogue: 0,1:17:23.63,1:17:26.22,Default,,0,0,0,,Одан гөрі Нобита-кун мен басқалардың қайда кеткенін айт.
Dialogue: 0,1:17:26.35,1:17:29.97,Default,,0,0,0,,Е, жақсысың ба? Әрине, мен сізге жол көрсетемін
Dialogue: 0,1:17:30.43,1:17:33.10,Default,,0,0,0,,Ақымақ, неге ертерек хабарламадың?
Dialogue: 0,1:17:33.23,1:17:35.69,Default,,0,0,0,,Бірақ мұнда тастардың құлауы сирек емес...
Dialogue: 0,1:17:35.98,1:17:39.69,Default,,0,0,0,,Мұқият қараңыз. Ол жартас өз еркімен қозғалып жатқаны анық.
Dialogue: 0,1:17:40.19,1:17:41.65,Default,,0,0,0,,Біреу жасырынып кіріп келеді.
Dialogue: 0,1:17:41.78,1:17:43.57,Default,,0,0,0,,Оны дереу жарып жіберіңіз!
Dialogue: 0,1:17:51.08,1:17:52.29,Default,,0,0,0,,Онда ештеңе жоқ. Екі жағы да бос.
Dialogue: 0,1:17:58.34,1:17:59.38,Default,,0,0,0,,Онда ештеңе жоқ. Екі жағы да бос.
Dialogue: 0,1:18:05.18,1:18:06.64,Default,,0,0,0,,Дискіні маған қалдырыңыз.
Dialogue: 0,1:18:06.76,1:18:09.55,Default,,0,0,0,,Әуе зеңбірегі! Бум
Dialogue: 0,1:18:09.81,1:18:12.10,Default,,0,0,0,,Уф... БУМ!
Dialogue: 0,1:18:12.64,1:18:14.18,Default,,0,0,0,,<Алғашқы қадамды жасау>
Dialogue: 0,1:18:16.19,1:18:19.11,Default,,0,0,0,,Бум бум бум...
Dialogue: 0,1:18:19.23,1:18:21.32,Default,,0,0,0,,Уф хааааа
Dialogue: 0,1:18:21.44,1:18:23.32,Default,,0,0,0,,Уау! Бум!
Dialogue: 0,1:18:23.61,1:18:24.82,Default,,0,0,0,,Жарайсың, Дораемон!
Dialogue: 0,1:18:24.95,1:18:25.78,Default,,0,0,0,,Ішке асығамыз.
Dialogue: 0,1:18:25.90,1:18:26.82,Default,,0,0,0,,Міне!
Dialogue: 0,1:18:28.66,1:18:30.41,Default,,0,0,0,,Мұндай жерде шынымен де Хамон мұғалімі бар ма?
Dialogue: 0,1:18:32.79,1:18:33.62,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:34.66,1:18:36.08,Default,,0,0,0,,Оны әлі тірі деп ойлау...
Dialogue: 0,1:18:36.21,1:18:38.38,Default,,0,0,0,,Тез құтыл, Гильермин.
Dialogue: 0,1:18:38.50,1:18:41.25,Default,,0,0,0,,Кішкентай бәйбішелер, сен әрқашан менің серіктесім бола аласың.
Dialogue: 0,1:18:41.88,1:18:44.88,Default,,0,0,0,,Қалағаныңыз осы, өкінбеңіз.
Dialogue: 0,1:18:45.01,1:18:47.38,Default,,0,0,0,,Мен мұны бір рет айтқым келді, бірақ...
Dialogue: 0,1:18:47.51,1:18:49.18,Default,,0,0,0,,Нобита-кун, маған қалдыр!
Dialogue: 0,1:18:49.30,1:18:50.05,Default,,0,0,0,,Жоқ, бұл менмін!
Dialogue: 0,1:18:50.47,1:18:52.64,Default,,0,0,0,,Біз бәріміз саған қарсылас боламыз.
Dialogue: 0,1:18:52.76,1:18:55.18,Default,,0,0,0,,Хэхехехехе...
Dialogue: 0,1:18:56.77,1:18:58.94,Default,,0,0,0,,Бұл Нобитаға қауіп төндіреді.
Dialogue: 0,1:18:59.06,1:19:00.81,Default,,0,0,0,,Ум, у, а, мынау, мынау, мынау.
Dialogue: 0,1:19:00.94,1:19:03.11,Default,,0,0,0,,Үлкен апатқа қарсы оқу-жаттығу ұшағы!
Dialogue: 0,1:19:03.40,1:19:06.07,Default,,0,0,0,,Мен сені мұнымен қорқытамын, ә...
Dialogue: 0,1:19:07.28,1:19:09.32,Default,,0,0,0,,Сен… сен сорлы! Қалай батылың жетті!
Dialogue: 0,1:19:18.87,1:19:20.88,Default,,0,0,0,,Уф, бұл су тасқыны.
Dialogue: 0,1:19:21.00,1:19:21.75,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:19:22.09,1:19:23.71,Default,,0,0,0,,Енді қашайық.
Dialogue: 0,1:19:23.84,1:19:25.92,Default,,0,0,0,,Түсіндім, бұл Дораемонның құралдарының арқасында.
Dialogue: 0,1:19:26.05,1:19:27.84,Default,,0,0,0,,Тез, тез
Dialogue: 0,1:19:27.97,1:19:28.72,Default,,0,0,0,,Уау
Dialogue: 0,1:19:28.84,1:19:30.09,Default,,0,0,0,,Бұқа пойызына мініңіз
Dialogue: 0,1:19:31.43,1:19:32.97,Default,,0,0,0,,Бұл қашатын нәрсе ме?
Dialogue: 0,1:19:34.60,1:19:36.06,Default,,0,0,0,,Ропле-кун, ат!
Dialogue: 0,1:19:36.27,1:19:38.19,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:38.31,1:19:41.02,Default,,0,0,0,,Ахх...
Dialogue: 0,1:19:43.40,1:19:45.48,Default,,0,0,0,,Уф, тез көтер.
Dialogue: 0,1:19:50.66,1:19:51.74,Default,,0,0,0,,А, бұл жаман.
Dialogue: 0,1:19:52.91,1:19:55.20,Default,,0,0,0,,Қалжың, не болып жатыр?
Dialogue: 0,1:19:58.25,1:19:59.12,Default,,0,0,0,,Ол жоғалды...
Dialogue: 0,1:19:59.25,1:19:59.92,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,1:20:01.17,1:20:02.42,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:02.63,1:20:04.00,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,1:20:04.13,1:20:05.17,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,1:20:05.30,1:20:07.42,Default,,0,0,0,,Жарайды, мен сені Хирари жадағайымен қорғаймын.
Dialogue: 0,1:20:07.55,1:20:09.05,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:20:11.05,1:20:14.55,Default,,0,0,0,,Ой... ааа...
Dialogue: 0,1:20:15.51,1:20:17.06,Default,,0,0,0,,Ахххх
Dialogue: 0,1:20:25.48,1:20:26.65,Default,,0,0,0,,Міне! (Чамми) А.
Dialogue: 0,1:20:29.61,1:20:30.40,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:20:30.53,1:20:31.24,Default,,0,0,0,,Дораемон
Dialogue: 0,1:20:31.36,1:20:32.28,Default,,0,0,0,,Эй
Dialogue: 0,1:20:32.66,1:20:35.20,Default,,0,0,0,,Джан Сунео Шизука-чан да
Dialogue: 0,1:20:35.74,1:20:36.99,Default,,0,0,0,,Хехехехехе...
Dialogue: 0,1:20:37.37,1:20:38.75,Default,,0,0,0,,Хехехехехехехе
Dialogue: 0,1:20:39.29,1:20:40.29,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:20:40.66,1:20:41.75,Default,,0,0,0,,Олар қандай?
Dialogue: 0,1:20:41.87,1:20:43.00,Default,,0,0,0,,Жаңа Суперменде
Dialogue: 0,1:20:43.12,1:20:44.33,Default,,0,0,0,,Тіпті қыздар да аман
Dialogue: 0,1:20:44.46,1:20:47.21,Default,,0,0,0,,Оны дірілдеген бұқа пойызымен сықырлатыңыз!
Dialogue: 0,1:20:48.51,1:20:49.17,Default,,0,0,0,,Уау
Dialogue: 0,1:20:50.92,1:20:52.34,Default,,0,0,0,,Қараңдар, мен оны тез лақтыруым керек.
Dialogue: 0,1:20:52.47,1:20:54.64,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,1:20:54.76,1:20:55.64,Default,,0,0,0,,Міне!
Dialogue: 0,1:21:00.43,1:21:01.77,Default,,0,0,0,,Ұшыңыз!
Dialogue: 0,1:21:04.31,1:21:05.65,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:21:07.52,1:21:08.69,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,1:21:08.94,1:21:10.57,Default,,0,0,0,,Керемет доп!
Dialogue: 0,1:21:11.11,1:21:12.61,Default,,0,0,0,,О, жоқ!
Dialogue: 0,1:21:14.28,1:21:15.24,Default,,0,0,0,,Қозғалтқыш бұзылған
Dialogue: 0,1:21:15.37,1:21:16.28,Default,,0,0,0,,Биіктік төмендеуде
Dialogue: 0,1:21:16.41,1:21:18.45,Default,,0,0,0,,Жоқ, қашыңыз!
Dialogue: 0,1:21:25.83,1:21:31.05,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:21:31.34,1:21:33.51,Default,,0,0,0,,Уау...
Dialogue: 0,1:21:34.30,1:21:35.51,Default,,0,0,0,,Уау...
Dialogue: 0,1:21:35.64,1:21:37.30,Default,,0,0,0,,(Барлығының қуаныш дауысы)
Dialogue: 0,1:21:37.43,1:21:39.39,Default,,0,0,0,,Көрейік!
Dialogue: 0,1:21:39.51,1:21:42.98,Default,,0,0,0,,Ууууууууууууууу...
Dialogue: 0,1:21:43.10,1:21:46.06,Default,,0,0,0,,Мен бұқа пойызымды жақсы көремін...
Dialogue: 0,1:21:46.19,1:21:47.81,Default,,0,0,0,,Бірақ қуануға әлі ерте
Dialogue: 0,1:21:47.94,1:21:52.44,Default,,0,0,0,,Өзекті жою құрылғысы жақын арада бұл планетаны бөлшектейді.
Dialogue: 0,1:21:52.65,1:21:53.45,Default,,0,0,0,,Бұл кетті (Чумми) Ия!
Dialogue: 0,1:21:53.65,1:21:54.45,Default,,0,0,0,,Бұл...
Dialogue: 0,1:21:54.57,1:21:55.24,Default,,0,0,0,,Бұл сұмдық...
Dialogue: 0,1:21:55.36,1:21:56.32,Default,,0,0,0,,Жарайды... (Сунео) Не істеуім керек...
Dialogue: 0,1:21:56.45,1:21:57.24,Default,,0,0,0,,Бітті.
Dialogue: 0,1:21:57.45,1:21:58.24,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,1:21:58.37,1:21:59.87,Default,,0,0,0,,Біз оны тез тоқтатуымыз керек, асығайық.
Dialogue: 0,1:21:59.99,1:22:02.25,Default,,0,0,0,,Жарылысқа 30 секунд қалды
Dialogue: 0,1:22:02.83,1:22:05.04,Default,,0,0,0,,Мен бұл күмбездің ішіне тез кіруім керек.
Dialogue: 0,1:22:05.17,1:22:06.71,Default,,0,0,0,,Дорэмон, бірдеңе істе.
Dialogue: 0,1:22:07.46,1:22:10.84,Default,,0,0,0,,Бір минут күте тұрыңыз...
Dialogue: 0,1:22:11.25,1:22:13.30,Default,,0,0,0,,Мүмкін уақыт фурошикі жұмыс істемейтін шығар...
Dialogue: 0,1:22:13.55,1:22:16.18,Default,,0,0,0,,Жоқ, жоқ, күмбезге кіретін құрал болса.
Dialogue: 0,1:22:16.72,1:22:18.51,Default,,0,0,0,,Хмм...
Dialogue: 0,1:22:18.85,1:22:22.35,Default,,0,0,0,,А, мен түсіндім, бұл құрсау арқылы өтетін.
Dialogue: 0,1:22:22.47,1:22:25.64,Default,,0,0,0,,Енді барайық.
Dialogue: 0,1:22:25.77,1:22:27.44,Default,,0,0,0,,Роппуру-кун, осы жерде күте тұрыңыз.
Dialogue: 0,1:22:27.56,1:22:28.48,Default,,0,0,0,,Иә (Нобита) Иә.
Dialogue: 0,1:22:28.61,1:22:29.36,Default,,0,0,0,,Му
Dialogue: 0,1:22:29.94,1:22:32.15,Default,,0,0,0,,Жарылысқа 20 секунд қалды
Dialogue: 0,1:22:33.28,1:22:35.15,Default,,0,0,0,,А, мен қай қосқышты өшіретінін білмеймін.
Dialogue: 0,1:22:35.15,1:22:36.11,Default,,0,0,0,,А, мен оны қай қосқыш өшіретінін білмеймін.
Dialogue: 0,1:22:35.15,1:22:36.11,Default,,0,0,0,,Бұл
Dialogue: 0,1:22:36.36,1:22:38.03,Default,,0,0,0,,15 секунд қалды
Dialogue: 0,1:22:38.16,1:22:39.53,Default,,0,0,0,,Тез, тез
Dialogue: 0,1:22:40.45,1:22:42.45,Default,,0,0,0,,Уақыт фурошики…
Dialogue: 0,1:22:42.58,1:22:43.29,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,1:22:43.58,1:22:46.21,Default,,0,0,0,,Кері санақ басталды. Эвакуациялау уақыты келді ме?
Dialogue: 0,1:22:46.33,1:22:47.71,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:22:47.96,1:22:48.79,Default,,0,0,0,,Қашып кетсем де...
Dialogue: 0,1:22:48.92,1:22:49.63,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:22:53.17,1:22:57.34,Default,,0,0,0,,10 ９ ８ ７ ６…
Dialogue: 0,1:22:57.97,1:23:02.64,Default,,0,0,0,,５ ４ ３ ２ １…
Dialogue: 0,1:23:02.89,1:23:03.60,Default,,0,0,0,,Нөл…
Dialogue: 0,1:23:05.81,1:23:07.31,Default,,0,0,0,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,1:23:07.77,1:23:09.65,Default,,0,0,0,,Эй (Сунео) Уау!
Dialogue: 0,1:23:18.41,1:23:22.20,Default,,0,0,0,,Хмм... Уақыт шегіне жеткенімен, бұл біртүрлі.
Dialogue: 0,1:23:23.79,1:23:25.12,Default,,0,0,0,,Мен құтқарылдым.
Dialogue: 0,1:23:25.25,1:23:26.58,Default,,0,0,0,,Жарық қайтып келеді!
Dialogue: 0,1:23:27.21,1:23:29.12,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:23:29.25,1:23:32.50,Default,,0,0,0,,Бұрын Дораемон достық машинасын жасау үшін Time Furoshiki пайдаланған.
Dialogue: 0,1:23:32.75,1:23:36.51,Default,,0,0,0,,Мен оны бұзылмай тұрып қайтардым, сондықтан...
Dialogue: 0,1:23:37.51,1:23:41.85,Default,,0,0,0,,Сондықтан оны жою құрылғысының үстіне қойдыңыз ба?
Dialogue: 0,1:23:50.35,1:23:53.57,Default,,0,0,0,,Өйткені, Роппуру-кун – бұл планетаның құтқарушысы.
Dialogue: 0,1:23:53.69,1:23:55.86,Default,,0,0,0,,Хаха... Мұның бәрі сенің арқаң, Дораемон.
Dialogue: 0,1:23:55.98,1:23:57.15,Default,,0,0,0,,Рахмет саған Дора-чан
Dialogue: 0,1:23:57.28,1:23:59.86,Default,,0,0,0,,Сіз Ропплға несие алуға рұқсат бересіз.
Dialogue: 0,1:23:59.99,1:24:02.62,Default,,0,0,0,,Өйткені бұл әрқашан Нобита-кун.
Dialogue: 0,1:24:02.74,1:24:03.78,Default,,0,0,0,,Ухухухухуху
Dialogue: 0,1:24:04.03,1:24:06.24,Default,,0,0,0,,Нанана на... бұл не нәрсе
Dialogue: 0,1:24:06.37,1:24:08.83,Default,,0,0,0,,Менің ең жақсы жоспарларымды да сол бәйбішелер жоққа шығарды...
Dialogue: 0,1:24:08.96,1:24:10.04,Default,,0,0,0,,Бастық, артық емес.
Dialogue: 0,1:24:10.17,1:24:11.71,Default,,0,0,0,,Ғарыш патрульдік командасы
Dialogue: 0,1:24:11.83,1:24:13.88,Default,,0,0,0,,Не! Уф, уф...
Dialogue: 0,1:24:17.09,1:24:21.30,Default,,0,0,0,,Богант ядроны жою құрылғысын пайдаланғаны үшін қылмыс үстінде ұсталды!
Dialogue: 0,1:24:22.64,1:24:25.89,Default,,0,0,0,,Сондай-ақ, біраз уақыттан бері тергеуде болған Гартит тау-кен штабы ...
Dialogue: 0,1:24:26.01,1:24:28.14,Default,,0,0,0,,Маған рейд жасалды.
Dialogue: 0,1:24:28.27,1:24:33.19,Default,,0,0,0,,Президенттен бастап барлық басшылар қамауға алынды және компания жабылатын сияқты.
Dialogue: 0,1:24:33.31,1:24:36.40,Default,,0,0,0,,А-а-а-а-а-а-а
Dialogue: 0,1:24:36.52,1:24:40.03,Default,,0,0,0,,Mi… mi… барлығына мен мұны штабтың бұйрығымен жасадым.
Dialogue: 0,1:24:40.15,1:24:41.70,Default,,0,0,0,,Бұл менің кінәм емес
Dialogue: 0,1:24:41.82,1:24:43.95,Default,,0,0,0,,(Боганттың айқайы)
Dialogue: 0,1:24:44.07,1:24:46.12,Default,,0,0,0,,Мырзалар, мен ұсыныс жасаймын.
Dialogue: 0,1:24:46.24,1:24:50.00,Default,,0,0,0,,Осы даңқты жеңіс күнін мәңгі сақтау үшін —
Dialogue: 0,1:24:50.12,1:24:53.75,Default,,0,0,0,,Бұл күн осы ұлы ұлдар үшін мереке күні болып белгіленген.
Dialogue: 0,1:24:53.88,1:24:56.21,Default,,0,0,0,,Мен мүсін жасау керек деп ойлаймын.
Dialogue: 0,1:24:56.34,1:24:59.21,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,1:25:00.59,1:25:01.88,Default,,0,0,0,,Бұл қар гүлі
Dialogue: 0,1:25:02.01,1:25:04.18,Default,,0,0,0,,Рахмет, мен сені жақсы көремін.
Dialogue: 0,1:25:04.84,1:25:05.93,Default,,0,0,0,,Сәлем Нобита
Dialogue: 0,1:25:06.05,1:25:08.18,Default,,0,0,0,,Асықпасаң, үйге бара алмайсың.
Dialogue: 0,1:25:08.31,1:25:09.43,Default,,0,0,0,,Иә
Dialogue: 0,1:25:09.56,1:25:12.06,Default,,0,0,0,,Кешіріңіз, Шизука-чан, сізді қорқынышты сезінгенім үшін.
Dialogue: 0,1:25:12.19,1:25:13.60,Default,,0,0,0,,Өте қызық болды.
Dialogue: 0,1:25:14.02,1:25:14.77,Default,,0,0,0,,Не? Мұндай тұнық, тар планетаға қайта оралуға болмайды. Жоқ.
Dialogue: 0,1:25:14.77,1:25:16.40,Default,,0,0,0,,Не? Мұндай тұнық, тар планетаға қайта оралуға болмайды. Жоқ.
Dialogue: 0,1:25:14.77,1:25:16.40,Default,,0,0,0,,Ауырады, ауырады, ауырады
Dialogue: 0,1:25:16.40,1:25:16.52,Default,,0,0,0,,Не? Мұндай тұнық, тар планетаға қайта оралуға болмайды. Жоқ.
Dialogue: 0,1:25:16.52,1:25:18.78,Default,,0,0,0,,Не? Мұндай тұнық, тар планетаға қайта оралуға болмайды. Жоқ.
Dialogue: 0,1:25:16.52,1:25:18.78,Default,,0,0,0,,Жарайды, жарайды, қара, жарайды.
Dialogue: 0,1:25:18.90,1:25:21.53,Default,,0,0,0,,Чумми, ойланба.
Dialogue: 0,1:25:21.65,1:25:23.40,Default,,0,0,0,,Әр адамның өз жұлдызы бар
Dialogue: 0,1:25:24.36,1:25:25.99,Default,,0,0,0,,Әй, ол қайтадан алыстап барады.
Dialogue: 0,1:25:26.12,1:25:27.37,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,1:25:27.49,1:25:28.20,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,1:25:28.33,1:25:30.95,Default,,0,0,0,,Біз туралы ұмытпаңыз
Dialogue: 0,1:25:31.08,1:25:34.29,Default,,0,0,0,,Қалай ұмытуға болады? Біз бәріміз шынымен жақсы дос болдық.
Dialogue: 0,1:25:36.63,1:25:40.46,Default,,0,0,0,,(♪«Жүрегіңді тербет»)
Dialogue: 0,1:27:14.06,1:27:15.64,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:27:18.35,1:27:19.02,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,1:27:18.35,1:27:19.02,Default,,0,0,0,,〜♪
Dialogue: 0,1:27:19.02,1:27:19.15,Default,,0,0,0,,〜♪
Dialogue: 0,1:27:19.15,1:27:19.81,Default,,0,0,0,,〜♪
Dialogue: 0,1:27:19.15,1:27:19.81,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,1:27:19.81,1:27:19.94,Default,,0,0,0,,〜♪
Dialogue: 0,1:27:19.94,1:27:21.23,Default,,0,0,0,,〜♪
Dialogue: 0,1:27:19.94,1:27:21.23,Default,,0,0,0,,Есеп № 006
Dialogue: 0,1:27:21.23,1:27:22.23,Default,,0,0,0,,〜♪
Dialogue: 0,1:27:23.90,1:27:27.70,Default,,0,0,0,,Барлығына не болды? Түстен енді ғана оянған сияқтысың...
Dialogue: 0,1:27:27.82,1:27:29.70,Default,,0,0,0,,Сәлем, бұл татамиде бірдеңе дұрыс емес.
Dialogue: 0,1:27:29.91,1:27:31.37,Default,,0,0,0,,Ой...
Dialogue: 0,1:27:29.91,1:27:31.37,Default,,0,0,0,,Е... бұл ештеңе, ештеңе емес.
Dialogue: 0,1:27:31.37,1:27:32.12,Default,,0,0,0,,Е... бұл ештеңе, ештеңе емес.
Dialogue: 0,1:27:32.24,1:27:33.24,Default,,0,0,0,,Барған сайын күдікті болып барады.
Dialogue: 0,1:27:33.37,1:27:34.24,Default,,0,0,0,,Енді көрсетіңізші.
Dialogue: 0,1:27:34.37,1:27:35.08,Default,,0,0,0,,Аа, тоқта, тоқта…
Dialogue: 0,1:27:35.20,1:27:36.54,Default,,0,0,0,,Ах... (Нобита) А, а.
Dialogue: 0,1:27:37.00,1:27:37.25,Default,,0,0,0,,(тышқан жылайды)
Dialogue: 0,1:27:37.25,1:27:38.83,Default,,0,0,0,,(тышқан жылайды)
Dialogue: 0,1:27:37.25,1:27:38.83,Default,,0,0,0,,Е-а-а-а-а-а-а-а
Dialogue: 0,1:27:38.96,1:27:40.21,Default,,0,0,0,,Яаааа!
Dialogue: 0,1:27:40.79,1:27:42.34,Default,,0,0,0,,Тез, тез, тез Татами татами...
Dialogue: 0,1:27:42.46,1:27:44.88,Default,,0,0,0,,Тездетіп, татамиді киіңіз. Тезірек татами киіңіз.
Dialogue: 0,1:27:45.00,1:27:46.46,Default,,0,0,0,,А, мен таң қалдым.
Dialogue: 0,1:27:46.59,1:27:47.63,Default,,0,0,0,,Бұл ештеңе емес, солай ма?
Dialogue: 0,1:27:47.76,1:27:49.84,Default,,0,0,0,,Иә... ерте жат.
Dialogue: 0,1:27:49.97,1:27:51.05,Default,,0,0,0,,Иә
Dialogue: 0,1:27:52.18,1:27:54.68,Default,,0,0,0,,Хехехе, сонау алыс...
Dialogue: 0,1:27:54.81,1:27:58.23,Default,,0,0,0,,Мен алыстағы жұлдызда болдым, тіпті телескоп оны көре алмайды...
Dialogue: 0,1:27:58.35,1:27:59.69,Default,,0,0,0,,Саған ешкім сенбейді.
Dialogue: 0,1:27:59.81,1:28:02.65,Default,,0,0,0,,Иә, шынымен, шынымен.
Dialogue: 0,1:28:03.19,1:28:05.40,Default,,0,0,0,,Роппл-кун мен Клем-чан да...
Dialogue: 0,1:28:05.53,1:28:07.82,Default,,0,0,0,,Сіз қазір маған қарап отырған боларсыз.
Dialogue: 0,1:28:08.36,1:28:11.24,Default,,0,0,0,,Иә, Чумми де.
Dialogue: 0,1:28:11.36,1:28:17.37,Default,,0,0,0,,♪〜
Dialogue: 0,1:28:43.15,1:28:49.15,Default,,0,0,0,,〜♪
Dialogue: 0,1:28:49.28,1:28:55.28,Default,,0,0,0,,♪〜
Dialogue: 0,1:30:20.54,1:30:26.54,Default,,0,0,0,,〜♪
