Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.19,0:00:42.21,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:42.21,0:00:46.14,Default,,0,0,0,,Сабер! Ха ха ха
Dialogue: 0,0:00:46.14,0:00:49.14,Default,,0,0,0,,Сабер!
Dialogue: 0,0:00:56.15,0:00:58.15,Default,,0,0,0,,Сабер?
Dialogue: 0,0:01:01.16,0:01:03.16,Default,,0,0,0,,Сабер!
Dialogue: 0,0:01:03.16,0:01:24.18,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:24.18,0:01:26.18,Default,,0,0,0,,Сабер
Dialogue: 0,0:01:30.19,0:01:32.19,Default,,0,0,0,,Жақсы
Dialogue: 0,0:01:32.19,0:01:34.19,Default,,0,0,0,,Дәл уақытында... Ха
Dialogue: 0,0:01:34.19,0:01:46.14,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:46.14,0:01:49.14,Default,,0,0,0,,Сабер! Ах
Dialogue: 0,0:01:53.14,0:01:55.14,Default,,0,0,0,,Ha
Dialogue: 0,0:02:01.15,0:02:05.15,Default,,0,0,0,,Неге тағы да осындасың...
Dialogue: 0,0:02:10.16,0:02:14.17,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:02:14.17,0:02:25.18,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:25.18,0:02:30.18,Default,,0,0,0,,Сіз кімсіз...
Dialogue: 0,0:02:30.18,0:02:34.18,Default,,0,0,0,,Не болып жатыр өзі?
Dialogue: 0,0:02:38.19,0:02:44.99,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,0:02:47.13,0:02:52.13,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:02:57.14,0:02:59.14,Default,,0,0,0,,Я...
Dialogue: 0,0:03:06.15,0:03:10.15,Default,,0,0,0,,[Монитор] (Жаңалық жүргізуші) Біз алға жылжып жатырмыз, бірақ бүгін таңертең полиция оқиға орнына келді...
Dialogue: 0,0:03:10.15,0:03:12.16,Default,,0,0,0,,Ум... Сенпай [Монитор] Ғибадатхана ғимаратының бір бөлігі...
Dialogue: 0,0:03:12.16,0:03:14.16,Default,,0,0,0,,Олар оның құлағанын тапқанын айтады.
Dialogue: 0,0:03:14.16,0:03:19.16,Default,,0,0,0,,Сенпай? Аа, не?
Dialogue: 0,0:03:19.16,0:03:21.17,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:21.17,0:03:25.17,Default,,0,0,0,,Сабердің Жапонияға оралуы күтпеген жерден болды.
Dialogue: 0,0:03:25.17,0:03:27.17,Default,,0,0,0,,О
Dialogue: 0,0:03:27.17,0:03:29.17,Default,,0,0,0,,[Монитор] (Репортер) Ішін көру мүмкін емес
Dialogue: 0,0:03:29.17,0:03:35.18,Default,,0,0,0,,Бұл жолы құлаған ғимарат Рюдоужи храмы аумағындағы тоған болды...
Dialogue: 0,0:03:35.18,0:03:37.18,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:03:37.18,0:03:42.19,Default,,0,0,0,,Енді түнде көшеге шығудың қажеті жоқ, солай ма?
Dialogue: 0,0:03:42.19,0:03:48.09,Default,,0,0,0,,Сізге енді қауіп төнбейді, солай ма?
Dialogue: 0,0:03:53.13,0:03:55.13,Default,,0,0,0,,Жоқ... ха
Dialogue: 0,0:03:55.13,0:03:58.14,Default,,0,0,0,,Жоқ, Сакура
Dialogue: 0,0:03:58.14,0:04:01.14,Default,,0,0,0,,Мен Сабермен кездеспедім...
Dialogue: 0,0:04:01.14,0:04:04.14,Default,,0,0,0,,Сабырды бірге ұстаған мен едім.
Dialogue: 0,0:04:04.14,0:04:09.15,Default,,0,0,0,,Мен бұдан былай үйден алыс болуым мүмкін.
Dialogue: 0,0:04:09.15,0:04:12.15,Default,,0,0,0,,Бірақ мен үйге кеш келемін...
Dialogue: 0,0:04:12.15,0:04:16.15,Default,,0,0,0,,Кіре берісте күтуді тоқтатыңыз.
Dialogue: 0,0:04:21.16,0:04:25.16,Default,,0,0,0,,《Иә, әлі біткен жоқ》
Dialogue: 0,0:04:27.17,0:04:30.17,Default,,0,0,0,,《Кіммен ұрыссам екен...?
Dialogue: 0,0:04:32.17,0:04:36.17,Default,,0,0,0,,Әлі де осы қалада》
Dialogue: 0,0:04:36.17,0:06:01.13,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:01.13,0:06:03.13,Default,,0,0,0,,《Жаңа капитал》
Dialogue: 0,0:06:03.13,0:06:06.13,Default,,0,0,0,,《Орталық саябақ》
Dialogue: 0,0:06:06.13,0:06:09.13,Default,,0,0,0,,《Рюдоджи храмы》
Dialogue: 0,0:06:09.13,0:06:14.14,Default,,0,0,0,,《Көлеңке тәрізді адамның мақсаты не? 》
Dialogue: 0,0:06:14.14,0:06:18.14,Default,,0,0,0,,《Ішкі ағзалармен байланыс...》
Dialogue: 0,0:06:18.14,0:06:20.14,Default,,0,0,0,,《Жұмыс істейсің бе? 》
Dialogue: 0,0:06:20.14,0:06:24.14,Default,,0,0,0,,《Жоқ, сіз оны жай ғана пайдаланып жатырсыз ба? 》
Dialogue: 0,0:06:25.15,0:06:28.15,Default,,0,0,0,,Мен де Тохсакадан сұрауым керек...
Dialogue: 0,0:06:31.16,0:06:33.16,Default,,0,0,0,,Уф…
Dialogue: 0,0:06:36.16,0:06:38.16,Default,,0,0,0,,Не?
Dialogue: 0,0:06:39.16,0:06:42.17,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:42.17,0:06:46.07,Default,,0,0,0,,А, сен тірісің, аға.
Dialogue: 0,0:06:49.11,0:06:51.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:53.11,0:06:57.12,Default,,0,0,0,,Маған атыңызды айтыңызшы, иә?
Dialogue: 0,0:06:57.12,0:07:00.12,Default,,0,0,0,,Үлкен ағаның аты
Dialogue: 0,0:07:00.12,0:07:05.12,Default,,0,0,0,,А-а, мен Ширумын... Эмия Ширу
Dialogue: 0,0:07:05.12,0:07:09.13,Default,,0,0,0,,Ширу! Широ... Широ.
Dialogue: 0,0:07:09.13,0:07:11.13,Default,,0,0,0,,Иә
Dialogue: 0,0:07:14.13,0:07:16.13,Default,,0,0,0,,Тааа!
Dialogue: 0,0:07:17.14,0:07:21.14,Default,,0,0,0,,Уау! Эй... эй! Күте тұрыңыз!
Dialogue: 0,0:07:21.14,0:07:23.14,Default,,0,0,0,,Біз жаумыз, Ильясвиел!
Dialogue: 0,0:07:23.14,0:07:25.14,Default,,0,0,0,,Илья жақсы.
Dialogue: 0,0:07:25.14,0:07:29.15,Default,,0,0,0,,Шеберлер тек түнде ғана шайқаса алады.
Dialogue: 0,0:07:29.15,0:07:32.15,Default,,0,0,0,,Мен Ширумен сөйлесуге келдім.
Dialogue: 0,0:07:32.15,0:07:37.16,Default,,0,0,0,,Білесің бе, кенет біреуді кесіп тастады...
Dialogue: 0,0:07:37.16,0:07:39.16,Default,,0,0,0,,Бұл жай ғана әңгіме
Dialogue: 0,0:07:39.16,0:07:43.16,Default,,0,0,0,,Не, бұл басқаша.
Dialogue: 0,0:07:43.16,0:07:47.10,Default,,0,0,0,,Ширу әлсіз болса да сыртқа секіргендіктен емес!
Dialogue: 0,0:07:47.10,0:07:51.10,Default,,0,0,0,,Қазір де мен сені өлтіре аламын.
Dialogue: 0,0:07:51.10,0:07:56.11,Default,,0,0,0,,Сабырсыз Ширу көзді ашып-жұмғанша жоғалып кетті.
Dialogue: 0,0:07:56.11,0:07:58.11,Default,,0,0,0,,Уф…
Dialogue: 0,0:08:01.11,0:08:03.11,Default,,0,0,0,,Және-
Dialogue: 0,0:08:03.11,0:08:06.12,Default,,0,0,0,,Мен осы уақыт бойы күттім ...
Dialogue: 0,0:08:06.12,0:08:09.12,Default,,0,0,0,,Бұл жеткілікті жақсы емес пе?
Dialogue: 0,0:08:12.12,0:08:16.13,Default,,0,0,0,,Сонымен, Илья ормандағы сарайда тұрады ма?
Dialogue: 0,0:08:16.13,0:08:19.13,Default,,0,0,0,,Жалғыз ба? Сера мен Лиз де менімен бірге.
Dialogue: 0,0:08:19.13,0:08:22.13,Default,,0,0,0,,Бүгін де Сераның көзін ұрлап...
Dialogue: 0,0:08:22.13,0:08:24.14,Default,,0,0,0,,Мен Шируды көруге келдім.
Dialogue: 0,0:08:24.14,0:08:27.14,Default,,0,0,0,,Құрметке ие болыңыз
Dialogue: 0,0:08:27.14,0:08:29.14,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:08:31.14,0:08:35.15,Default,,0,0,0,,Ал, мен сенен тағы бір нәрсе сұрасам болады ма?
Dialogue: 0,0:08:35.15,0:08:39.15,Default,,0,0,0,,Кирицугу Эмия есімі есіңізде ме?
Dialogue: 0,0:08:46.09,0:08:48.09,Default,,0,0,0,,Илья?
Dialogue: 0,0:08:49.09,0:08:51.10,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:08:51.10,0:08:55.10,Default,,0,0,0,,Мен бұл есімді білмеймін.
Dialogue: 0,0:08:55.10,0:08:58.10,Default,,0,0,0,,Мен үйге барамын
Dialogue: 0,0:08:58.10,0:09:01.10,Default,,0,0,0,,Әй... Ілияс!
Dialogue: 0,0:09:05.11,0:09:07.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:07.11,0:09:09.11,Default,,0,0,0,,Эмия-кун?
Dialogue: 0,0:09:13.12,0:09:15.12,Default,,0,0,0,,Ах Тохсака...
Dialogue: 0,0:09:22.13,0:09:24.13,Default,,0,0,0,,≪(Рин) Дұрыс болды.
Dialogue: 0,0:09:24.13,0:09:28.13,Default,,0,0,0,,Мен де Эмия-кунмен сөйлескім келді.
Dialogue: 0,0:09:28.13,0:09:32.14,Default,,0,0,0,,Әңгіме болса, оны мектепте...
Dialogue: 0,0:09:32.14,0:09:34.14,Default,,0,0,0,,≪(Рин) Арчер, маған бір кесе шай дайындап беріңізші.
Dialogue: 0,0:09:36.14,0:09:40.14,Default,,0,0,0,,Иә? Сізге ұнамайды ма? бұл қандай бет
Dialogue: 0,0:09:40.14,0:09:43.14,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:09:54.16,0:09:56.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:56.16,0:09:58.16,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:01.17,0:10:03.17,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:03.17,0:10:06.17,Default,,0,0,0,,Енді стратегиялық кездесуді бастайық!
Dialogue: 0,0:10:08.17,0:10:12.18,Default,,0,0,0,,(Пойыздың жөнелту қоңырауы)
Dialogue: 0,0:10:12.18,0:10:16.18,Default,,0,0,0,,) (Пойыздың есігінің жабылған дыбысы)
Dialogue: 0,0:10:22.19,0:10:25.19,Default,,0,0,0,,)
Dialogue: 0,0:10:25.19,0:10:55.04,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:01.16,0:11:06.16,Default,,0,0,0,,Кешкі ас дайындау... Мен керек.
Dialogue: 0,0:11:10.17,0:11:14.17,Default,,0,0,0,,Ах…
Dialogue: 0,0:11:14.17,0:11:17.17,Default,,0,0,0,,Тез айт, Сакураның қызуы көтеріліп қалды!
Dialogue: 0,0:11:17.17,0:11:21.17,Default,,0,0,0,,Тохсака сөйлесуге рұқсат бермеген шығар.
Dialogue: 0,0:11:22.18,0:11:24.18,Default,,0,0,0,,Ашық
Dialogue: 0,0:11:24.18,0:11:28.18,Default,,0,0,0,,Сакура Сіз ояусыз ба?
Dialogue: 0,0:11:31.19,0:11:36.19,Default,,0,0,0,,[TEL] (рингтон)
Dialogue: 0,0:11:36.19,0:11:40.20,Default,,0,0,0,,Бұл шындық. Бұл не? Бұл қол! Ауырды!
Dialogue: 0,0:11:40.20,0:11:42.20,Default,,0,0,0,,Уау, Эмия-кун! ?
Dialogue: 0,0:11:42.20,0:11:44.20,Default,,0,0,0,,А, қазірдің өзінде!
Dialogue: 0,0:11:44.20,0:11:55.00,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:59.15,0:12:02.15,Default,,0,0,0,,Синдзи! Шие гүлдерін босатыңыз
Dialogue: 0,0:12:02.15,0:12:04.15,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:12:05.16,0:12:07.16,Default,,0,0,0,,Хехехе
Dialogue: 0,0:12:07.16,0:12:09.16,Default,,0,0,0,,Синдзи!
Dialogue: 0,0:12:09.16,0:12:12.16,Default,,0,0,0,,Уайымдама, Сакура.
Dialogue: 0,0:12:12.16,0:12:15.17,Default,,0,0,0,,Мен Эмияны өлтірмеймін.
Dialogue: 0,0:12:15.17,0:12:17.17,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:12:17.17,0:12:21.17,Default,,0,0,0,,Мен сені азапқа салуым керек.
Dialogue: 0,0:12:21.17,0:12:23.17,Default,,0,0,0,,Шабандозмен мәміле
Dialogue: 0,0:12:23.17,0:12:27.18,Default,,0,0,0,,Егер бәрі жақсы болса, оны босатуға болады.
Dialogue: 0,0:12:27.18,0:12:29.18,Default,,0,0,0,,Иә
Dialogue: 0,0:12:29.18,0:12:31.18,Default,,0,0,0,,Жасай бер! шабандоз
Dialogue: 0,0:12:32.18,0:12:37.19,Default,,0,0,0,,Егер сіз күресуге дайын болсаңыз -
Dialogue: 0,0:12:37.19,0:12:41.19,Default,,0,0,0,,Жалғыз келмеу керек еді
Dialogue: 0,0:12:41.19,0:12:43.19,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:12:43.19,0:12:52.14,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:52.14,0:12:54.14,Default,,0,0,0,,Ах-ах-ах
Dialogue: 0,0:12:54.14,0:13:06.15,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:06.15,0:13:08.15,Default,,0,0,0,,(Кітап сөресінің құлаған дыбысы)
Dialogue: 0,0:13:14.16,0:13:17.16,Default,,0,0,0,,(Кітап сөресі құлаған дыбыс)
Dialogue: 0,0:13:17.16,0:13:19.16,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:13:19.16,0:13:22.17,Default,,0,0,0,,Хахаха не болды? Эмия
Dialogue: 0,0:13:22.17,0:13:26.17,Default,,0,0,0,,Жай ғана бас тарту қызықсыз!
Dialogue: 0,0:13:30.17,0:13:32.17,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:13:33.18,0:13:36.18,Default,,0,0,0,,Сіздің шыдамдылығыңыз жеңеді.
Dialogue: 0,0:13:36.18,0:13:39.18,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:13:39.18,0:13:41.19,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:13:41.19,0:13:46.12,Default,,0,0,0,,Жақсы, енді ештеңе істей алмаймыз.
Dialogue: 0,0:13:46.12,0:13:50.13,Default,,0,0,0,,Мені өлтір, шабандоз!
Dialogue: 0,0:13:50.13,0:13:52.13,Default,,0,0,0,,Бауырым, тоқта...
Dialogue: 0,0:13:57.13,0:14:01.14,Default,,0,0,0,,Хахахаха! Хехе
Dialogue: 0,0:14:01.14,0:14:03.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:14.15,0:14:16.15,Default,,0,0,0,,Сакура…
Dialogue: 0,0:14:17.15,0:14:20.15,Default,,0,0,0,,Сен… Сен…
Dialogue: 0,0:14:21.16,0:14:23.16,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:14:26.16,0:14:31.17,Default,,0,0,0,,Уф... ой
Dialogue: 0,0:14:31.17,0:14:35.17,Default,,0,0,0,,Не... неге...
Dialogue: 0,0:14:35.17,0:14:45.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:47.12,0:14:49.12,Default,,0,0,0,,Сиқыр...
Dialogue: 0,0:14:52.12,0:14:57.13,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:14:57.13,0:14:59.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:59.13,0:15:01.13,Default,,0,0,0,,Гү!
Dialogue: 0,0:15:01.13,0:15:05.14,Default,,0,0,0,,Ааааа... уф
Dialogue: 0,0:15:05.14,0:15:08.14,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:08.14,0:15:10.14,Default,,0,0,0,,Ой...
Dialogue: 0,0:15:10.14,0:15:16.15,Default,,0,0,0,,Гуаааааааааааааааааааааааааааа
Dialogue: 0,0:15:16.15,0:15:18.15,Default,,0,0,0,,Шабандоз!
Dialogue: 0,0:15:18.15,0:15:21.15,Default,,0,0,0,,Мына жігітті өлтіріңіз!
Dialogue: 0,0:15:27.16,0:15:29.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:29.16,0:15:41.96,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:43.17,0:15:45.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:45.11,0:15:47.11,Default,,0,0,0,,(Шабандоздың құлаған дыбысы)
Dialogue: 0,0:15:47.11,0:15:49.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:54.12,0:15:58.12,Default,,0,0,0,,Ал... Тохсака... неге?
Dialogue: 0,0:15:58.12,0:16:02.13,Default,,0,0,0,,Эмия-кун екеуміз ынтымақтастық қарым-қатынастамыз.
Dialogue: 0,0:16:02.13,0:16:06.13,Default,,0,0,0,,Бүгіннің өзінде бұл біздің мәңгі бірге болғанымызды білдіреді.
Dialogue: 0,0:16:07.13,0:16:10.13,Default,,0,0,0,,Шие гүлдерін пайдаланудан басқа
Dialogue: 0,0:16:10.13,0:16:14.14,Default,,0,0,0,,Сіз мені толығымен өзіңізге қарсы қойдыңыз.
Dialogue: 0,0:16:14.14,0:16:16.14,Default,,0,0,0,,Ой...
Dialogue: 0,0:16:16.14,0:16:20.14,Default,,0,0,0,,Шие гүлі... Шие гүлі Шие гүлі—
Dialogue: 0,0:16:20.14,0:16:23.15,Default,,0,0,0,,Шие гүлдейді Шие гүлі!
Dialogue: 0,0:16:23.15,0:16:26.15,Default,,0,0,0,,Мұндай жігіт маңызды емес!
Dialogue: 0,0:16:26.15,0:16:29.15,Default,,0,0,0,,Шебер болған менмін!
Dialogue: 0,0:16:33.16,0:16:36.16,Default,,0,0,0,,Тұрған шабандоз
Dialogue: 0,0:16:36.16,0:16:39.16,Default,,0,0,0,,Гаха! Ах! (Синджи) Бұл!
Dialogue: 0,0:16:40.16,0:16:42.16,Default,,0,0,0,,Ах! Құдай-ай!
Dialogue: 0,0:16:43.17,0:16:45.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:45.10,0:16:48.11,Default,,0,0,0,,Шабандоз №...
Dialogue: 0,0:16:48.11,0:16:50.11,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:16:50.11,0:16:52.11,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:16:52.11,0:16:57.11,Default,,0,0,0,,Ааааааааа!
Dialogue: 0,0:16:57.11,0:16:59.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:59.12,0:17:01.12,Default,,0,0,0,,Сакура... (Рин) Эмия-кун, жат!
Dialogue: 0,0:17:02.12,0:17:04.12,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:17:06.12,0:17:08.12,Default,,0,0,0,,Бұл шындық. Бұл не? Бұл қол! Ауырды!
Dialogue: 0,0:17:16.13,0:17:21.13,Default,,0,0,0,,Өтірік... Бұл Шабандоз ба?
Dialogue: 0,0:17:26.14,0:17:28.15,Default,,0,0,0,,Керемет, шабандоз!
Dialogue: 0,0:17:28.15,0:17:31.15,Default,,0,0,0,,Барлығынан құтылыңыз!
Dialogue: 0,0:17:33.15,0:17:36.15,Default,,0,0,0,,Сәлем, шабандоз!
Dialogue: 0,0:17:36.15,0:17:38.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:38.16,0:17:40.16,Default,,0,0,0,,Дұрыс па? А?
Dialogue: 0,0:17:40.16,0:17:42.16,Default,,0,0,0,,Матудың қаны әлдеқашан ескірген.
Dialogue: 0,0:17:42.16,0:17:46.10,Default,,0,0,0,,Сиқырды қолдана алатын адамдар шығарылмайды.
Dialogue: 0,0:17:46.10,0:17:49.10,Default,,0,0,0,,Мен, Зоукен, шабандозды шақырдым...
Dialogue: 0,0:17:49.10,0:17:52.10,Default,,0,0,0,,Мен оны Синдзимен қалдыратын шығарсың деп ойладым.
Dialogue: 0,0:17:52.10,0:17:55.11,Default,,0,0,0,,Бірақ оқиға қарапайым болды.
Dialogue: 0,0:17:55.11,0:17:57.11,Default,,0,0,0,,Тохсака?
Dialogue: 0,0:17:57.11,0:17:59.11,Default,,0,0,0,,Қазір Мату отбасында -
Dialogue: 0,0:17:59.11,0:18:03.11,Default,,0,0,0,,Шебер болуға ең қолайлы адам...
Dialogue: 0,0:18:06.12,0:18:09.12,Default,,0,0,0,,Матудың заңды мұрагері —
Dialogue: 0,0:18:09.12,0:18:12.12,Default,,0,0,0,,Сен осы ұрпақтың сиқыршысысың.
Dialogue: 0,0:18:12.12,0:18:14.12,Default,,0,0,0,,Сакура
Dialogue: 0,0:18:14.12,0:18:16.13,Default,,0,0,0,,Ha
Dialogue: 0,0:18:16.13,0:18:20.13,Default,,0,0,0,,Сакура... Ұстаз?
Dialogue: 0,0:18:20.13,0:18:23.13,Default,,0,0,0,,Пәрменнің заклинанияларын тасымалдау
Dialogue: 0,0:18:23.13,0:18:27.13,Default,,0,0,0,,Бұл Синдзи Матоудың нұсқауларын орындауға берілген бұйрық па?
Dialogue: 0,0:18:28.14,0:18:30.14,Default,,0,0,0,,Нәтижесінде Синдзи...
Dialogue: 0,0:18:30.14,0:18:32.14,Default,,0,0,0,,Шабандоз шебері бол... (Синдзи) Эй.
Dialogue: 0,0:18:32.14,0:18:36.15,Default,,0,0,0,,Осы уақыт ішінде сіз шебер ретіндегі беделіңізді жоғалтасыз.
Dialogue: 0,0:18:36.15,0:18:38.15,Default,,0,0,0,,Жай ғана сиқыршы бол
Dialogue: 0,0:18:38.15,0:18:43.15,Default,,0,0,0,,Қайда қарап тұрсыңдар...
Dialogue: 0,0:18:43.15,0:18:46.09,Default,,0,0,0,,Командалық заклинанияны жасаған Мату болғандықтан...
Dialogue: 0,0:18:46.09,0:18:50.09,Default,,0,0,0,,Бұл айла мүмкін еді, Сакура.
Dialogue: 0,0:18:55.10,0:18:59.10,Default,,0,0,0,,Сәлем! Міне қара!
Dialogue: 0,0:19:00.10,0:19:02.11,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:19:02.11,0:19:04.11,Default,,0,0,0,,Тағы да, Сакура!
Dialogue: 0,0:19:04.11,0:19:08.11,Default,,0,0,0,,Тағы да бақылауды маған тапсыр!
Dialogue: 0,0:19:11.11,0:19:13.12,Default,,0,0,0,,Неге қазір жақсы қыз сияқты әрекет етесің?
Dialogue: 0,0:19:13.12,0:19:16.12,Default,,0,0,0,,Тағы бір команда емлесі бар!
Dialogue: 0,0:19:16.12,0:19:18.12,Default,,0,0,0,,Оны қолданыңыз...
Dialogue: 0,0:19:18.12,0:19:22.13,Default,,0,0,0,,Синдзи Пәрмен емлесі болмаса, Райдер бос болар еді.
Dialogue: 0,0:19:22.13,0:19:25.13,Default,,0,0,0,,Бұл жағдайда мен жалған тақырыптар кітабын жасасам да—
Dialogue: 0,0:19:25.13,0:19:28.13,Default,,0,0,0,,Ол бірден өртеніп кетуі мүмкін.
Dialogue: 0,0:19:28.13,0:19:32.14,Default,,0,0,0,,Сізді қарызға алынған пәрмен сиқыры басқарды...
Dialogue: 0,0:19:32.14,0:19:36.14,Default,,0,0,0,,Мен әу бастан шебер болған емеспін.
Dialogue: 0,0:19:36.14,0:19:38.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:42.15,0:19:44.15,Default,,0,0,0,,Синдзи
Dialogue: 0,0:19:49.15,0:19:52.16,Default,,0,0,0,,Иә... Мен мұны білдім.
Dialogue: 0,0:19:52.16,0:19:56.16,Default,,0,0,0,,Білдім, білдім, білдім!
Dialogue: 0,0:19:56.16,0:19:58.16,Default,,0,0,0,,Мұндай нәрсе басынан бері жұмыс істемеді.
Dialogue: 0,0:19:58.16,0:20:00.16,Default,,0,0,0,,Мен оны білдім!
Dialogue: 0,0:20:00.16,0:20:03.17,Default,,0,0,0,,Ааа...аа
Dialogue: 0,0:20:03.17,0:20:08.17,Default,,0,0,0,,Сонымен... сіз мұны істейсіз.
Dialogue: 0,0:20:08.17,0:20:13.17,Default,,0,0,0,,Мен үшін оларды өлтір, Сакура.
Dialogue: 0,0:20:15.18,0:20:19.18,Default,,0,0,0,,Жоқ, аға.
Dialogue: 0,0:20:19.18,0:20:21.18,Default,,0,0,0,,Оны қазірдің өзінде тоқтатайық
Dialogue: 0,0:20:21.18,0:20:25.19,Default,,0,0,0,,Ағам уәдесін бұзды.
Dialogue: 0,0:20:25.19,0:20:28.19,Default,,0,0,0,,Менің ағам оны өлтірмеймін десе де.
Dialogue: 0,0:20:28.19,0:20:31.19,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:33.20,0:20:35.20,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:36.20,0:20:38.20,Default,,0,0,0,,Өлме, сен
Dialogue: 0,0:20:38.20,0:20:41.20,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:20:41.20,0:20:45.10,Default,,0,0,0,,Уф... Иә?
Dialogue: 0,0:20:46.14,0:20:48.15,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:20:48.15,0:20:50.15,Default,,0,0,0,,Шие гүлдері! ?
Dialogue: 0,0:20:50.15,0:20:57.15,Default,,0,0,0,,Сенпай, маған ұнамайды... қарама.
Dialogue: 0,0:20:57.15,0:21:01.16,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:21:01.16,0:21:03.16,Default,,0,0,0,,Кук… (есіктің ашылған дыбысы)
Dialogue: 0,0:21:03.16,0:21:05.16,Default,,0,0,0,,Ha
Dialogue: 0,0:21:07.16,0:21:09.16,Default,,0,0,0,,Сакура…
Dialogue: 0,0:21:11.17,0:21:13.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:14.17,0:21:17.17,Default,,0,0,0,,Не? Tsk
Dialogue: 0,0:21:17.17,0:21:20.17,Default,,0,0,0,,Бұл бақылаудан шыққан сияқты.
Dialogue: 0,0:21:21.18,0:21:23.18,Default,,0,0,0,,Бұл жерден кет
Dialogue: 0,0:21:23.18,0:21:26.18,Default,,0,0,0,,Біреуге сиқырлы күш-қуатты нашар берсең, оны қайтара алмайсың!
Dialogue: 0,0:21:26.18,0:21:28.19,Default,,0,0,0,,Иә! Coo
Dialogue: 0,0:21:28.19,0:21:31.19,Default,,0,0,0,,Мазаламау
Dialogue: 0,0:21:31.19,0:21:33.19,Default,,0,0,0,,Райдер жабыңыз
Dialogue: 0,0:21:33.19,0:21:35.19,Default,,0,0,0,,Сіздің шеберіңіз бақылаудан шықты.
Dialogue: 0,0:21:35.19,0:21:39.20,Default,,0,0,0,,Бұлай жалғаса берсе, ол өзінің сиқырлы күшін жеп, өзін-өзі жойып жібереді.
Dialogue: 0,0:21:39.20,0:21:44.20,Default,,0,0,0,,Сізге сиқырлы күшті жоғалтқаннан гөрі көбірек сіңіру керек.
Dialogue: 0,0:21:45.14,0:21:48.14,Default,,0,0,0,,Цк, шебер өзгерген кезде—
Dialogue: 0,0:21:48.14,0:21:51.14,Default,,0,0,0,,Бұл жыныс түбірі өзгермейді дегенді білдіре ме?
Dialogue: 0,0:21:51.14,0:22:04.15,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:04.15,0:22:07.16,Default,,0,0,0,,Ах... Кедергі! ?
Dialogue: 0,0:22:07.16,0:22:10.16,Default,,0,0,0,,Цк (шабандоз) Ха!
Dialogue: 0,0:22:14.16,0:22:16.17,Default,,0,0,0,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:22:16.17,0:22:19.17,Default,,0,0,0,,Тоқта, шабандоз.
Dialogue: 0,0:22:19.17,0:22:23.17,Default,,0,0,0,,Мен осындай нәрсені жасағым келеді.
Dialogue: 0,0:22:23.17,0:22:26.18,Default,,0,0,0,,Мен саған қоңырау шалған жоқпын
Dialogue: 0,0:22:26.18,0:22:29.18,Default,,0,0,0,,Мен бұл бұйрықты тыңдай алмаймын.
Dialogue: 0,0:22:29.18,0:22:34.18,Default,,0,0,0,,Мен сенің өміріңді бәрінен жоғары қоямын.
Dialogue: 0,0:22:34.18,0:22:47.13,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:47.13,0:22:49.13,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:22:49.13,0:22:55.14,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:22:55.14,0:22:58.14,Default,,0,0,0,,Өтірік Жатыр көз...
Dialogue: 0,0:22:58.14,0:23:01.14,Default,,0,0,0,,Ах... Тохсака!
Dialogue: 0,0:23:01.14,0:23:03.15,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:23:03.15,0:23:17.16,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:17.16,0:23:20.16,Default,,0,0,0,,Ах... Тохсака!
Dialogue: 0,0:23:27.17,0:23:29.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:31.17,0:23:36.17,Default,,0,0,0,,Мен оны жек көремін! !
Dialogue: 0,0:23:43.19,0:23:47.09,Default,,0,0,0,,Саку… Ра…
Dialogue: 0,0:23:58.14,0:24:02.14,Default,,0,0,0,,Шие гүлдері! Уф жақсы...
Dialogue: 0,0:24:06.14,0:24:09.14,Default,,0,0,0,,Эмия-кун, жақсысың ба?
Dialogue: 0,0:24:10.15,0:24:12.15,Default,,0,0,0,,Тохсака
Dialogue: 0,0:24:12.15,0:24:14.15,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:24:14.15,0:24:18.16,Default,,0,0,0,,Сіз ақыры ояндыңыз ба?
Dialogue: 0,0:24:18.16,0:24:22.16,Default,,0,0,0,,Матоу Сакураның емделуі жаңа ғана аяқталды.
Dialogue: 0,0:24:22.16,0:24:25.16,Default,,0,0,0,,Сакура... Сакура қауіпсіз бе? ?
Dialogue: 0,0:24:25.16,0:24:30.17,Default,,0,0,0,,Сабыр ет, Райдер екеуміз сені осында әкелдік.
Dialogue: 0,0:24:30.17,0:24:32.17,Default,,0,0,0,,Кирей: Сакураның жағдайы қандай?
Dialogue: 0,0:24:32.17,0:24:35.17,Default,,0,0,0,,Тұрақты болмаса да—
Dialogue: 0,0:24:35.17,0:24:38.17,Default,,0,0,0,,Оның өмірі сақталды.
Dialogue: 0,0:24:40.18,0:24:42.18,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:24:42.18,0:24:45.12,Default,,0,0,0,,Сиқырлы мөрмен не істедің?
Dialogue: 0,0:24:45.12,0:24:48.12,Default,,0,0,0,,Фу…
Dialogue: 0,0:24:48.12,0:24:53.12,Default,,0,0,0,,Матоу Сакураны емдеу үшін мұның бәрін пайдаланудан басқа амалым қалмады.
Dialogue: 0,0:24:53.12,0:24:56.13,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:24:56.13,0:25:00.13,Default,,0,0,0,,Емдеу нәтижесінде...
Dialogue: 0,0:25:02.13,0:25:04.13,Default,,0,0,0,,Жәндіктер ...
Dialogue: 0,0:25:04.13,0:25:08.14,Default,,0,0,0,,Не болды? Бұл...
Dialogue: 0,0:25:08.14,0:25:11.14,Default,,0,0,0,,Оны тірі сиқырлы контур ретінде қарастырыңыз.
Dialogue: 0,0:25:11.14,0:25:15.15,Default,,0,0,0,,Бірде штамптаушы жәндік сізді тістеп алса...
Dialogue: 0,0:25:15.15,0:25:18.15,Default,,0,0,0,,Дененің әр бұрышына енеді—
Dialogue: 0,0:25:18.15,0:25:21.15,Default,,0,0,0,,Мәнді бір ауыздан жеу
Dialogue: 0,0:25:21.15,0:25:25.16,Default,,0,0,0,,Теріні шырышпен шағып, сулаңыз—
Dialogue: 0,0:25:25.16,0:25:29.16,Default,,0,0,0,,Ләззат орталығын көтеру және құлату арқылы —
Dialogue: 0,0:25:29.16,0:25:32.16,Default,,0,0,0,,Аштықты қанағаттандыру
Dialogue: 0,0:25:32.16,0:25:37.17,Default,,0,0,0,,Нәтижесінде осы жәндіктердің шабуылына ұшыраған әйел...
Dialogue: 0,0:25:37.17,0:25:42.17,Default,,0,0,0,,Ақыл мен дене толығымен бұзылған.
Dialogue: 0,0:25:42.17,0:25:45.11,Default,,0,0,0,,жойылды
Dialogue: 0,0:25:45.11,0:25:48.11,Default,,0,0,0,,Мату Сакура да...
Dialogue: 0,0:25:48.11,0:25:50.11,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:25:50.11,0:25:54.12,Default,,0,0,0,,Түсіндіру қажет деп ойладым.
Dialogue: 0,0:25:54.12,0:25:57.12,Default,,0,0,0,,Бұл зат сіздің денеңіздің ішінде болса -
Dialogue: 0,0:25:57.12,0:26:01.12,Default,,0,0,0,,Тіршілік энергиясы болып табылатын сиқырлы күш шексіз сіңеді.
Dialogue: 0,0:26:01.12,0:26:05.13,Default,,0,0,0,,Оны жалғыз қалдырсаң, өміріңнен айырыласың.
Dialogue: 0,0:26:05.13,0:26:08.13,Default,,0,0,0,,Операция сәтті өтті, солай ма?
Dialogue: 0,0:26:08.13,0:26:13.14,Default,,0,0,0,,Барлығы емес, 11 жыл.
Dialogue: 0,0:26:13.14,0:26:17.14,Default,,0,0,0,,Оны күштеп тартып алсаң, денесі әлсірейді.
Dialogue: 0,0:26:17.14,0:26:20.14,Default,,0,0,0,,Толық жою үшін—
Dialogue: 0,0:26:20.14,0:26:25.14,Default,,0,0,0,,Сондықтан бізде Қасиетті Граилға сенуден басқа амал жоқ.
Dialogue: 0,0:26:37.16,0:26:40.16,Default,,0,0,0,,Тохсака?
Dialogue: 0,0:26:43.17,0:26:47.10,Default,,0,0,0,,Фуюкидің әкімшісі ретінде мен жазаны аламын.
Dialogue: 0,0:26:47.10,0:26:49.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:49.11,0:26:53.11,Default,,0,0,0,,Фу утилизациясы
Dialogue: 0,0:26:53.11,0:26:58.11,Default,,0,0,0,,Мату: Сакура? (Рин) Иә.
Dialogue: 0,0:26:58.11,0:27:02.12,Default,,0,0,0,,Өз күшін басқара алмаған сиқыршыны тірі қалдыру мүмкін емес.
Dialogue: 0,0:27:02.12,0:27:07.12,Default,,0,0,0,,Бұл бала қазірдің өзінде ақылсыз шебер.
Dialogue: 0,0:27:07.12,0:27:12.12,Default,,0,0,0,,Бұл менің нағыз әпкем болса да... солай ма?
Dialogue: 0,0:27:14.13,0:27:18.13,Default,,0,0,0,,А... әпке?
Dialogue: 0,0:27:20.14,0:27:23.14,Default,,0,0,0,,Я...
Dialogue: 0,0:27:23.14,0:27:28.14,Default,,0,0,0,,Тохсаканың бастапқыда екі баласы болды.
Dialogue: 0,0:27:28.14,0:27:31.15,Default,,0,0,0,,Бірақ сиқыр ұрпақтан-ұрпаққа беріледі.
Dialogue: 0,0:27:31.15,0:27:35.15,Default,,0,0,0,,Мен Тохсақаның сиқырын мұра еттім.
Dialogue: 0,0:27:35.15,0:27:39.16,Default,,0,0,0,,Сакураның қаны таусылған еді, Мату...
Dialogue: 0,0:27:39.16,0:27:44.16,Default,,0,0,0,,Макири мұрагері ретінде қабылданды
Dialogue: 0,0:27:44.16,0:27:46.10,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:27:46.10,0:27:50.10,Default,,0,0,0,,Сакура екеуміз нағыз апамыз.
Dialogue: 0,0:27:50.10,0:27:54.10,Default,,0,0,0,,Біз бір-бірімізді ешқашан олай атаған емеспіз.
Dialogue: 0,0:27:54.10,0:27:58.10,Default,,0,0,0,,Күте тұрыңыз, Тохсака! Сонда бәрі жақсы...
Dialogue: 0,0:28:02.11,0:28:04.11,Default,,0,0,0,,Ах…
Dialogue: 0,0:28:05.12,0:28:08.12,Default,,0,0,0,,Егер мен ол баланы осылай жалғыз қалдырсам...
Dialogue: 0,0:28:08.12,0:28:12.12,Default,,0,0,0,,Дәл солай қайталанады
Dialogue: 0,0:28:12.12,0:28:15.13,Default,,0,0,0,,Енді бейтаныс адамға
Dialogue: 0,0:28:15.13,0:28:17.13,Default,,0,0,0,,Еріксіз
Dialogue: 0,0:28:17.13,0:28:20.13,Default,,0,0,0,,Сондықтан мен—
Dialogue: 0,0:28:20.13,0:28:22.13,Default,,0,0,0,,Мен ол баланы өлтіремін.
Dialogue: 0,0:28:27.14,0:28:31.14,Default,,0,0,0,,≪(найзағай)
Dialogue: 0,0:28:31.14,0:28:33.14,Default,,0,0,0,,Фу…
Dialogue: 0,0:28:34.14,0:28:37.14,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:28:46.09,0:28:48.09,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,0:29:00.10,0:29:03.11,Default,,0,0,0,,)
Dialogue: 0,0:29:03.11,0:29:05.11,Default,,0,0,0,,)
Dialogue: 0,0:29:05.11,0:29:30.13,Default,,0,0,0,,♪♪～
Dialogue: 0,0:29:30.13,0:29:35.14,Default,,0,0,0,,((Мен өзімді жақсы көретін адамнан маңызды нәрсе алдым...
Dialogue: 0,0:29:35.14,0:29:39.14,Default,,0,0,0,,Бұл екінші рет))
Dialogue: 0,0:29:39.14,0:30:00.16,Default,,0,0,0,,♪♪～
Dialogue: 0,0:30:00.16,0:30:06.16,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:30:07.17,0:30:12.17,Default,,0,0,0,,《Шие гүлдері... Мен оларды Тохсакадан бұрын табуым керек.》
Dialogue: 0,0:30:14.18,0:30:20.18,Default,,0,0,0,,《Бірақ мен шие гүлдерін тапқанда, мен...》
Dialogue: 0,0:30:22.19,0:30:24.19,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:30:24.19,0:30:27.19,Default,,0,0,0,,Қайырлы кеш Ширу
Dialogue: 0,0:30:30.19,0:30:33.20,Default,,0,0,0,,Түнде ұрыспайсың ба?
Dialogue: 0,0:30:33.20,0:30:37.20,Default,,0,0,0,,Ширу енді шебер емес.
Dialogue: 0,0:30:37.20,0:30:40.20,Default,,0,0,0,,Хехе, мен бәрін білемін.
Dialogue: 0,0:30:40.20,0:30:45.14,Default,,0,0,0,,Шабандоздың шебері құлады, екеуі ғана қалды.
Dialogue: 0,0:30:45.14,0:30:48.14,Default,,0,0,0,,Ширу шабандоздың шеберіне көмектескісі келеді, бірақ...
Dialogue: 0,0:30:48.14,0:30:50.15,Default,,0,0,0,,Мен оны таба алмаймын.
Dialogue: 0,0:30:50.15,0:30:53.15,Default,,0,0,0,,Шулы! Ахх
Dialogue: 0,0:30:53.15,0:30:55.15,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,0:30:55.15,0:30:58.15,Default,,0,0,0,,Ах…
Dialogue: 0,0:30:58.15,0:31:00.15,Default,,0,0,0,,Кук
Dialogue: 0,0:31:04.16,0:31:07.16,Default,,0,0,0,,Ширу жылайтын сияқты
Dialogue: 0,0:31:07.16,0:31:10.17,Default,,0,0,0,,Ілияс, ашуланбайсың ба?
Dialogue: 0,0:31:10.17,0:31:12.17,Default,,0,0,0,,Мен ашуланбаймын
Dialogue: 0,0:31:12.17,0:31:15.17,Default,,0,0,0,,Мен Ширудың одақтасымын.
Dialogue: 0,0:31:17.17,0:31:21.17,Default,,0,0,0,,Менің... одақтасым?
Dialogue: 0,0:31:22.18,0:31:28.18,Default,,0,0,0,,Бүгінгі таңғы оқиға: Мен Кирицугу туралы білдім.
Dialogue: 0,0:31:28.18,0:31:33.19,Default,,0,0,0,,Менің дүниеге келу себебім Қасиетті Граил соғысында жеңіске жету болды...
Dialogue: 0,0:31:33.19,0:31:39.20,Default,,0,0,0,,Өйткені Ильяның мақсаты Кирицугу мен Шируды өлтіру болатын.
Dialogue: 0,0:31:39.20,0:31:46.14,Default,,0,0,0,,Бірақ, егер Ширу өзін жақсы көретін адамдарды қорғағысы келетінін айтса...
Dialogue: 0,0:31:46.14,0:31:50.14,Default,,0,0,0,,Мен Ширудың жағындамын.
Dialogue: 0,0:31:50.14,0:31:55.14,Default,,0,0,0,,Сүйген балаңды қорғау табиғи нәрсе ғой, солай ма?
Dialogue: 0,0:31:55.14,0:31:58.14,Default,,0,0,0,,Себебі мен білемін
Dialogue: 0,0:32:10.16,0:32:18.06,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:32:25.17,0:32:29.18,Default,,0,0,0,,Енді... Менің қайтатын жерім бар.
Dialogue: 0,0:32:29.18,0:32:32.18,Default,,0,0,0,,Бәрі де кетті...
Dialogue: 0,0:32:42.19,0:32:44.19,Default,,0,0,0,,Сакура
Dialogue: 0,0:32:49.13,0:32:52.13,Default,,0,0,0,,Сен… Сен…
Dialogue: 0,0:32:53.14,0:32:56.14,Default,,0,0,0,,Сакура
Dialogue: 0,0:32:56.14,0:33:00.14,Default,,0,0,0,,Үйге қайтайық. Сіз суықтан айыққан жоқсыз.
Dialogue: 0,0:33:03.15,0:33:05.15,Default,,0,0,0,,Мен үйге бара алмаймын
Dialogue: 0,0:33:05.15,0:33:10.15,Default,,0,0,0,,Мен жоғарыда айтқан бұл нәрсе улы емес немесе басқа нәрсе емес.
Dialogue: 0,0:33:10.15,0:33:14.16,Default,,0,0,0,,Бұл жай ғана сіздің сезімдеріңізді сезімтал ететін дәрі.
Dialogue: 0,0:33:14.16,0:33:18.16,Default,,0,0,0,,Сол себепті мен өзімді түсінбедім...
Dialogue: 0,0:33:18.16,0:33:22.17,Default,,0,0,0,,Мен ағамды ренжіттім! ауыртпау
Dialogue: 0,0:33:22.17,0:33:25.17,Default,,0,0,0,,Мен мұнымен жақсымын.
Dialogue: 0,0:33:25.17,0:33:28.17,Default,,0,0,0,,Мен Матудан келген сиқыршымын.
Dialogue: 0,0:33:28.17,0:33:31.17,Default,,0,0,0,,Мен оны ұзақ жасырдым.
Dialogue: 0,0:33:31.17,0:33:34.18,Default,,0,0,0,,Тіпті мен шебер болдым...
Dialogue: 0,0:33:34.18,0:33:36.18,Default,,0,0,0,,Мен Сакураға айтқан жоқпын.
Dialogue: 0,0:33:36.18,0:33:38.18,Default,,0,0,0,,Мен ағамның үйіне бардым...
Dialogue: 0,0:33:38.18,0:33:41.18,Default,,0,0,0,,Мен атама қарсы шығудан қорқамын!
Dialogue: 0,0:33:41.18,0:33:46.08,Default,,0,0,0,,Мен ағамды көмектесемін деп алдап жүрмін!
Dialogue: 0,0:33:47.12,0:33:50.13,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,0:33:50.13,0:33:54.13,Default,,0,0,0,,Әрқашан... Мен әрқашан ойладым
Dialogue: 0,0:33:54.13,0:33:58.13,Default,,0,0,0,,Мен үлкендермен араласатын жақсы адам емеспін.
Dialogue: 0,0:33:58.13,0:34:01.14,Default,,0,0,0,,Сондықтан мен мұны бүгін ғана істеймін...
Dialogue: 0,0:34:01.14,0:34:06.14,Default,,0,0,0,,Ертеңнен бастап бөтен болып көрінейік.
Dialogue: 0,0:34:06.14,0:34:09.15,Default,,0,0,0,,Біз дәлізде кездессек те, бір-бірімізден өтеміз...
Dialogue: 0,0:34:09.15,0:34:13.15,Default,,0,0,0,,Сабақтан кейін де мен сені бейтаныс адамдай танымайтындай кейіп таныттым.
Dialogue: 0,0:34:13.15,0:34:16.15,Default,,0,0,0,,Үйге өзің бар.
Dialogue: 0,0:34:16.15,0:34:19.15,Default,,0,0,0,,Не болғанын ұмытайық...
Dialogue: 0,0:34:22.16,0:34:25.16,Default,,0,0,0,,Бірақ мен мұны істей алмадым!
Dialogue: 0,0:34:25.16,0:34:29.17,Default,,0,0,0,,Өлім білегіме пышақ тигеннен де қорқынышты.
Dialogue: 0,0:34:29.17,0:34:34.17,Default,,0,0,0,,Мен үлкендерімді алдап, оларды тоқтатудан қорқамын...
Dialogue: 0,0:34:34.17,0:34:38.17,Default,,0,0,0,,Менің айналамның бәрі қорқынышты нәрселерге толы...
Dialogue: 0,0:34:38.17,0:34:41.18,Default,,0,0,0,,Мен енді бір дюймді де қозғалта алмаймын...
Dialogue: 0,0:34:41.18,0:34:44.18,Default,,0,0,0,,Мен не істерімді білмедім
Dialogue: 0,0:34:47.12,0:34:53.12,Default,,0,0,0,,Мен ағаммен өткізген уақытымды одан әрі қорғағым келді...
Dialogue: 0,0:34:53.12,0:34:59.13,Default,,0,0,0,,Мен... Мен үшін бәрі...
Dialogue: 0,0:34:59.13,0:35:02.13,Default,,0,0,0,,Бұл мағынасы болды
Dialogue: 0,0:35:11.14,0:35:13.14,Default,,0,0,0,,《Мен нені қорғағым келеді》
Dialogue: 0,0:35:13.14,0:35:16.14,Default,,0,0,0,,《Мен үшін маңызды нәрселер》
Dialogue: 0,0:35:18.15,0:35:23.15,Default,,0,0,0,,《Егер оны бұдан былай жылатқың келмесе...
Dialogue: 0,0:35:23.15,0:35:26.16,Default,,0,0,0,,Сакураны ешкім кінәламайды.
Dialogue: 0,0:35:26.16,0:35:30.16,Default,,0,0,0,,Сакураның өзін кінәлаудан басқа амалы болмаса...
Dialogue: 0,0:35:30.16,0:35:33.16,Default,,0,0,0,,Мен қолымды тартып аламын
Dialogue: 0,0:35:33.16,0:35:37.17,Default,,0,0,0,,Мені күн сәулесі түсетін жерге апарыңыз.
Dialogue: 0,0:35:37.17,0:35:40.17,Default,,0,0,0,,Басқа ешкім рұқсат етпесе де...》
Dialogue: 0,0:35:47.11,0:35:49.11,Default,,0,0,0,,Мен...
Dialogue: 0,0:35:49.11,0:35:54.11,Default,,0,0,0,,Шие гүлінің орнына шие гүлдерін кешіруді жалғастырыңыз
Dialogue: 0,0:35:55.12,0:35:57.12,Default,,0,0,0,,Рабу
Dialogue: 0,0:35:57.12,0:36:02.12,Default,,0,0,0,,Мен Сакураның жаман жігіт екенін білдім.
Dialogue: 0,0:36:05.13,0:36:10.13,Default,,0,0,0,,Бұрынғыдай қашан ренжійтінімді білмеймін...
Dialogue: 0,0:36:10.13,0:36:14.14,Default,,0,0,0,,Мен қайтымсыз нәрсе жасайтыныма сенімдімін.
Dialogue: 0,0:36:14.14,0:36:19.14,Default,,0,0,0,,Қай жерге оралуға болады? ?
Dialogue: 0,0:36:22.14,0:36:24.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:25.15,0:36:29.15,Default,,0,0,0,,Бұл Сакураның үйі.
Dialogue: 0,0:36:29.15,0:36:34.15,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:36:36.16,0:36:40.16,Default,,0,0,0,,I… I…—
Dialogue: 0,0:36:40.16,0:36:43.16,Default,,0,0,0,,Сен қыз емессің ғой?
Dialogue: 0,0:36:45.10,0:36:50.11,Default,,0,0,0,,Менің бірінші тәжірибем аяқталды.
Dialogue: 0,0:36:50.11,0:36:52.11,Default,,0,0,0,,Бұл ғана емес...
Dialogue: 0,0:36:52.11,0:36:54.11,Default,,0,0,0,,Содан бері—
Dialogue: 0,0:36:54.11,0:36:58.11,Default,,0,0,0,,Түсінбеген нәрседен денем түрткі болды.
Dialogue: 0,0:36:58.11,0:37:01.11,Default,,0,0,0,,Менің ағам мені қорғайды деген қандай біліктілік!
Dialogue: 0,0:37:03.12,0:37:05.12,Default,,0,0,0,,Ха…
Dialogue: 0,0:37:07.12,0:37:09.13,Default,,0,0,0,,Мен қорғаймын
Dialogue: 0,0:37:09.13,0:37:11.13,Default,,0,0,0,,Не болса да—
Dialogue: 0,0:37:11.13,0:37:14.13,Default,,0,0,0,,Сакураны өзі өлтірмек болса да...
Dialogue: 0,0:37:14.13,0:37:18.13,Default,,0,0,0,,Мен шие гүлдерін қорғаймын
Dialogue: 0,0:37:20.14,0:37:24.14,Default,,0,0,0,,Сен… Сен…
Dialogue: 0,0:37:27.14,0:37:32.14,Default,,0,0,0,,Мен Сакураның әділдіктің жалғыз одақтасы боламын.
Dialogue: 0,0:37:34.15,0:37:37.15,Default,,0,0,0,,Жоқ, сенпай.
Dialogue: 0,0:37:37.15,0:37:42.15,Default,,0,0,0,,Олай болса аға ағаңызды ренжітетініңізге сенімдімін.
Dialogue: 0,0:37:45.09,0:37:48.09,Default,,0,0,0,,Ауырса да...
Dialogue: 0,0:37:57.11,0:37:59.11,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:37:59.11,0:38:09.12,Default,,0,0,0,,♪♪～
Dialogue: 0,0:38:09.12,0:38:12.12,Default,,0,0,0,,Ах...ха
Dialogue: 0,0:38:16.13,0:38:18.13,Default,,0,0,0,,Сакура
Dialogue: 0,0:38:20.13,0:38:22.13,Default,,0,0,0,,Әпке...
Dialogue: 0,0:38:24.13,0:38:27.14,Default,,0,0,0,,Тохсака Сенпай
Dialogue: 0,0:38:27.14,0:38:50.09,Default,,0,0,0,,♪♪～
Dialogue: 0,0:38:50.09,0:38:52.09,Default,,0,0,0,,Ширу Эмия
Dialogue: 0,0:38:52.09,0:38:57.10,Default,,0,0,0,,Ескі сенімдеріңізді сақтасаңыз, бұл жақсы.
Dialogue: 0,0:38:57.10,0:39:00.10,Default,,0,0,0,,Соңы көрініп тұр
Dialogue: 0,0:39:00.10,0:39:04.11,Default,,0,0,0,,Бірақ егер сіз басқа жолды таңдасаңыз—
Dialogue: 0,0:39:04.11,0:39:07.11,Default,,0,0,0,,Ширу Эмиияның болашағы жоқ.
Dialogue: 0,0:39:07.11,0:39:12.11,Default,,0,0,0,,Сіз бәрін жоғалтасыз
Dialogue: 0,0:39:12.11,0:39:23.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:39:26.13,0:39:29.13,Default,,0,0,0,,Сіз шаршадыңыз. Біраз демалыңыз.
Dialogue: 0,0:39:29.13,0:39:32.13,Default,,0,0,0,,Ах... иә
Dialogue: 0,0:39:32.13,0:39:36.14,Default,,0,0,0,,Иә? ше? шие гүлдері
Dialogue: 0,0:39:36.14,0:39:38.14,Default,,0,0,0,,Сізде қызба бар ма?
Dialogue: 0,0:39:38.14,0:39:41.14,Default,,0,0,0,,Өйткені жаңбырдың астында ұзақ болдым
Dialogue: 0,0:39:41.14,0:39:45.15,Default,,0,0,0,,Немесе... бұл суық емес...
Dialogue: 0,0:39:45.15,0:39:47.15,Default,,0,0,0,,Біраз сиқырлы күш—
Dialogue: 0,0:39:47.15,0:39:51.15,Default,,0,0,0,,жеткіліксіз...
Dialogue: 0,0:39:51.15,0:39:56.16,Default,,0,0,0,,А... Мен де көмектесе аламын ба?
Dialogue: 0,0:39:56.16,0:39:59.16,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:40:01.16,0:40:03.17,Default,,0,0,0,,Ум...
Dialogue: 0,0:40:03.17,0:40:07.17,Default,,0,0,0,,Өйткені ол
Dialogue: 0,0:40:07.17,0:40:12.17,Default,,0,0,0,,Жоқ... маған қан беріңізші, мен жақсы боламын.
Dialogue: 0,0:40:12.17,0:40:15.18,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:40:15.18,0:40:17.18,Default,,0,0,0,,(саусақтардың тістеген дыбысы)
Dialogue: 0,0:40:17.18,0:40:20.18,Default,,0,0,0,,Біріншіден, Хаторидің өлімі.
Dialogue: 0,0:40:20.18,0:40:23.19,Default,,0,0,0,,Иә
Dialogue: 0,0:40:23.19,0:40:26.19,Default,,0,0,0,,Я...
Dialogue: 0,0:40:26.19,0:40:29.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:29.19,0:40:31.19,Default,,0,0,0,,Я...
Dialogue: 0,0:40:42.20,0:40:48.14,Default,,0,0,0,,Хмм... га...
Dialogue: 0,0:40:48.14,0:40:52.15,Default,,0,0,0,,А... жақсысың ба?
Dialogue: 0,0:40:52.15,0:40:55.15,Default,,0,0,0,,Я...
Dialogue: 0,0:40:58.15,0:41:00.16,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:41:00.16,0:41:04.16,Default,,0,0,0,,Ал... қайырлы түн.
Dialogue: 0,0:41:04.16,0:41:06.16,Default,,0,0,0,,Иә
Dialogue: 0,0:41:14.17,0:41:16.17,Default,,0,0,0,,Я...
Dialogue: 0,0:41:16.17,0:41:21.18,Default,,0,0,0,,Артық емес.
Dialogue: 0,0:41:21.18,0:41:25.18,Default,,0,0,0,,Ағаның абыройын түсіре алмайтын нәрселер
Dialogue: 0,0:41:36.19,0:41:41.20,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:41:41.20,0:41:43.20,Default,,0,0,0,,(Газетті пошта жәшігіне тастау дыбысы)
Dialogue: 0,0:41:43.20,0:41:46.10,Default,,0,0,0,,(Мотоцикл қозғалтқышының дыбысы)
Dialogue: 0,0:41:51.14,0:41:54.14,Default,,0,0,0,,Шие гүлдерін сақтаңыз.
Dialogue: 0,0:41:54.14,0:41:56.15,Default,,0,0,0,,Иә
Dialogue: 0,0:41:56.15,0:41:59.15,Default,,0,0,0,,Шпинатпен не істейсіз?
Dialogue: 0,0:41:59.15,0:42:02.15,Default,,0,0,0,,Бүгін күнжіт жейміз бе?
Dialogue: 0,0:42:02.15,0:42:05.15,Default,,0,0,0,,Сакура жұмыртқасы Иә
Dialogue: 0,0:42:07.16,0:42:09.16,Default,,0,0,0,,(Дайындау дыбысы)
Dialogue: 0,0:42:11.16,0:42:13.16,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:42:16.17,0:42:18.17,Default,,0,0,0,,Хехе
Dialogue: 0,0:42:18.17,0:42:22.17,Default,,0,0,0,,Мен мұндай нәрсені істегеніме біраз болды.
Dialogue: 0,0:42:22.17,0:42:24.17,Default,,0,0,0,,Иә
Dialogue: 0,0:42:26.18,0:42:29.18,Default,,0,0,0,,А... жемейсің бе?
Dialogue: 0,0:42:29.18,0:42:32.18,Default,,0,0,0,,Ұстаудың қажеті жоқ.
Dialogue: 0,0:42:34.18,0:42:39.19,Default,,0,0,0,,Бізге сіз жасаған тағамның түрі қажет емес.
Dialogue: 0,0:42:39.19,0:42:43.19,Default,,0,0,0,,Шынымен бе? Сабыр жақсы тамақтанып отырды.
Dialogue: 0,0:42:43.19,0:42:46.13,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:42:46.13,0:42:50.13,Default,,0,0,0,,Сенің мінезің маған жараспайды.
Dialogue: 0,0:42:50.13,0:42:54.13,Default,,0,0,0,,Сонда не...
Dialogue: 0,0:43:04.15,0:43:07.15,Default,,0,0,0,,Болашақ саясатқа келетін болсақ...
Dialogue: 0,0:43:07.15,0:43:12.15,Default,,0,0,0,,Мен Сакураның жеңіске жетуіне және Қасиетті Граалды пайдалануға мүмкіндік беремін.
Dialogue: 0,0:43:12.15,0:43:16.16,Default,,0,0,0,,Бірақ Сакура үйден шықпауы керек деп ойлаймын.
Dialogue: 0,0:43:16.16,0:43:20.16,Default,,0,0,0,,Зоукенмен тікелей кездесу қауіпті.
Dialogue: 0,0:43:20.16,0:43:23.17,Default,,0,0,0,,Бұл ой дұрыс.
Dialogue: 0,0:43:23.17,0:43:28.17,Default,,0,0,0,,Бірақ сол сиқыршыны қалай жеңесің?
Dialogue: 0,0:43:30.17,0:43:34.18,Default,,0,0,0,,Менің ойымша, біз басқа шеберлермен ынтымақтастықта болуымыз керек.
Dialogue: 0,0:43:34.18,0:43:38.18,Default,,0,0,0,,Ал кім қалды?
Dialogue: 0,0:43:38.18,0:43:42.18,Default,,0,0,0,,Тохсака садақшысы Сакура шабандозы
Dialogue: 0,0:43:42.18,0:43:46.12,Default,,0,0,0,,Зоукеннің қасында Ассасин бар.
Dialogue: 0,0:43:46.12,0:43:52.13,Default,,0,0,0,,Сосын Ильяның «Берсеркер»...
Dialogue: 0,0:43:52.13,0:43:54.13,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,0:43:55.13,0:43:58.13,Default,,0,0,0,,Екінші форма: Суиша!
Dialogue: 0,0:43:58.13,0:44:00.14,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,0:44:00.14,0:44:04.14,Default,,0,0,0,,Онда Сакура сыртқа шықпауы керек.
Dialogue: 0,0:44:11.15,0:44:15.15,Default,,0,0,0,,Өкінбейсіз бе?
Dialogue: 0,0:44:15.15,0:44:20.16,Default,,0,0,0,,Мен енді өкіне алмаймын.
Dialogue: 0,0:44:20.16,0:44:26.16,Default,,0,0,0,,Шабандоз, егер қауіпті болса, ағаңызды үйге қайтарыңыз.
Dialogue: 0,0:44:26.16,0:44:29.16,Default,,0,0,0,,Бірақ шие гүлдейді
Dialogue: 0,0:44:29.16,0:44:32.17,Default,,0,0,0,,Мен ол қарт емеспін...
Dialogue: 0,0:44:32.17,0:44:36.17,Default,,0,0,0,,Менің ойымша, бұл діни қызметкерге абай болу керек.
Dialogue: 0,0:44:38.17,0:44:43.18,Default,,0,0,0,,Иә... Мен де солай ойлаймын.
Dialogue: 0,0:44:43.18,0:44:47.12,Default,,0,0,0,,Бірақ уайымдама, шабандоз.
Dialogue: 0,0:44:47.12,0:44:53.12,Default,,0,0,0,,Өйткені ол адам мені жеңе алмайды.
Dialogue: 0,0:44:55.12,0:44:57.12,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:45:01.13,0:45:05.13,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:45:06.14,0:45:13.14,Default,,0,0,0,,Ха ха ха... ха ха...
Dialogue: 0,0:45:13.14,0:45:20.15,Default,,0,0,0,,Ха ха ха ха... ха
Dialogue: 0,0:45:20.15,0:45:22.15,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:45:22.15,0:45:28.16,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:45:28.16,0:45:33.16,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:45:33.16,0:45:35.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:35.16,0:45:41.17,Default,,0,0,0,,Ха ха ха ха нннн...
Dialogue: 0,0:45:41.17,0:45:44.17,Default,,0,0,0,,Сенпай!
Dialogue: 0,0:45:45.11,0:45:51.11,Default,,0,0,0,,(Ағын су дыбысы)
Dialogue: 0,0:45:51.11,0:45:54.12,Default,,0,0,0,,(суды өшіріп жатқан кранның дыбысы)
Dialogue: 0,0:45:54.12,0:46:04.13,Default,,0,0,0,,♪♪～
Dialogue: 0,0:46:04.13,0:46:08.13,Default,,0,0,0,,Дұрыс, оны шығарудың қажеті жоқ.
Dialogue: 0,0:46:08.13,0:46:10.13,Default,,0,0,0,,Содан кейін—
Dialogue: 0,0:46:10.13,0:46:14.14,Default,,0,0,0,,Сізге бұдан былай қауіп төнбейді.
Dialogue: 0,0:46:14.14,0:46:18.14,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:46:18.14,0:46:22.14,Default,,0,0,0,,Мен не ойлап отырмын...
Dialogue: 0,0:46:26.15,0:46:33.05,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:46:42.16,0:46:44.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:44.17,0:46:47.10,Default,,0,0,0,,Ой... иә
Dialogue: 0,0:46:47.10,0:46:51.10,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:46:59.11,0:47:02.12,Default,,0,0,0,,Менің артымнан еремін дейсіз бе?
Dialogue: 0,0:47:02.12,0:47:12.13,Default,,0,0,0,,♪♪～
Dialogue: 0,0:47:12.13,0:47:15.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:15.13,0:47:18.13,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:47:20.14,0:47:22.14,Default,,0,0,0,,​​О?
Dialogue: 0,0:47:23.14,0:47:26.14,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:47:29.14,0:47:31.14,Default,,0,0,0,,Уф!
Dialogue: 0,0:47:32.15,0:47:34.15,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:47:37.15,0:48:08.12,Default,,0,0,0,,♪♪～
Dialogue: 0,0:48:08.12,0:48:13.12,Default,,0,0,0,,Ха... Сіз де қожайыныңыз сияқты қорқақ қызметшісіз.
Dialogue: 0,0:48:13.12,0:48:18.13,Default,,0,0,0,,Сенің бізбен соғысуға ерік-жігерің жоқ сияқты.
Dialogue: 0,0:48:18.13,0:48:22.13,Default,,0,0,0,,Сіздің өміріңіз соншалықты маңызды ма?
Dialogue: 0,0:48:22.13,0:48:26.13,Default,,0,0,0,,О, бұл маңызды.
Dialogue: 0,0:48:26.13,0:48:30.14,Default,,0,0,0,,Менің тілегім – өлместік
Dialogue: 0,0:48:30.14,0:48:33.14,Default,,0,0,0,,Мына денені қараңыз
Dialogue: 0,0:48:33.14,0:48:36.14,Default,,0,0,0,,Шірік иіс шығарып, сәт сайын шіриді.
Dialogue: 0,0:48:36.14,0:48:40.15,Default,,0,0,0,,Жиналған білімді жоғалту
Dialogue: 0,0:48:40.15,0:48:47.09,Default,,0,0,0,,Тірі кезінде шірудің азабын, азабын түсінесің бе?
Dialogue: 0,0:48:47.09,0:48:51.09,Default,,0,0,0,,Өлімнен қорықпайтын адам жоқ.
Dialogue: 0,0:48:54.10,0:49:00.10,Default,,0,0,0,,Бұл менің тілегім орындалатынын білдірсе—
Dialogue: 0,0:49:00.10,0:49:06.10,Default,,0,0,0,,Мен бүкіл әлемде адамдарды бір-бірлеп өлтіріп жатырмын.
Dialogue: 0,0:49:12.11,0:49:14.12,Default,,0,0,0,,Мен таң қалдым...
Dialogue: 0,0:49:14.12,0:49:19.12,Default,,0,0,0,,Макири мұны ұмытып қалды.
Dialogue: 0,0:49:19.12,0:49:23.13,Default,,0,0,0,,Біздің шын ниетімізді есте сақтаңыз -
Dialogue: 0,0:49:23.13,0:49:28.13,Default,,0,0,0,,Ғажайыпты аңсау қайдан пайда болады?
Dialogue: 0,0:49:28.13,0:49:32.13,Default,,0,0,0,,Неліктен біз адам болып қала береміз?
Dialogue: 0,0:49:32.13,0:49:37.13,Default,,0,0,0,,Сіз адам жоқ жерге жетуге тырыстыңыз ба?
Dialogue: 0,0:49:39.14,0:49:44.15,Default,,0,0,0,,Ғұн, қуыршақтай кейіпкер жақсы айтты.
Dialogue: 0,0:49:44.15,0:49:49.15,Default,,0,0,0,,Сонымен ата-бабаңызға еліктеу жасалып қойған ба?
Dialogue: 0,0:49:49.15,0:49:52.15,Default,,0,0,0,,Қызық осымен аяқталады.
Dialogue: 0,0:49:53.16,0:49:55.16,Default,,0,0,0,,Эйнцберннің Қасиетті Граясы —
Dialogue: 0,0:49:55.16,0:49:59.16,Default,,0,0,0,,Бұл Мато Zou сия тасы алынады.
Dialogue: 0,0:49:59.16,0:50:03.17,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:50:03.17,0:50:29.19,Default,,0,0,0,,♪♪～
Dialogue: 0,0:50:29.19,0:50:32.19,Default,,0,0,0,,Жоқ! Жабайы!
Dialogue: 0,0:50:39.20,0:50:41.20,Default,,0,0,0,,Уау! ?
Dialogue: 0,0:50:41.20,0:50:55.15,Default,,0,0,0,,♪♪～
Dialogue: 0,0:50:55.15,0:50:58.15,Default,,0,0,0,,Тохсака! ? неге
Dialogue: 0,0:50:58.15,0:51:03.15,Default,,0,0,0,,Мен Эмия-кунның дәл осылай ойлағанына сене алар емеспін.
Dialogue: 0,0:51:04.16,0:51:06.16,Default,,0,0,0,,Ах…
Dialogue: 0,0:51:06.16,0:51:30.19,Default,,0,0,0,,♪♪～
Dialogue: 0,0:51:30.19,0:51:32.19,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:51:32.19,0:51:50.14,Default,,0,0,0,,♪♪～
Dialogue: 0,0:51:50.14,0:51:52.14,Default,,0,0,0,,Ол жерден аулақ болыңыз!
Dialogue: 0,0:51:52.14,0:51:56.14,Default,,0,0,0,,Егер ол жігіт мені өлтірсе, мен қайтып орала алмаймын!
Dialogue: 0,0:52:05.15,0:52:07.15,Default,,0,0,0,,Ах…
Dialogue: 0,0:52:08.16,0:52:10.16,Default,,0,0,0,,Бұл шайқас болды.
Dialogue: 0,0:52:10.16,0:52:13.16,Default,,0,0,0,,Қалғанын сізге қалдырамын.
Dialogue: 0,0:52:13.16,0:52:17.16,Default,,0,0,0,,Эйнцберннің қызы, оның қашып кетуіне жол берме.
Dialogue: 0,0:52:28.18,0:52:30.18,Default,,0,0,0,,Жабырқаушы!
Dialogue: 0,0:52:31.18,0:52:33.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:37.19,0:52:40.19,Default,,0,0,0,,Ух, Илья!
Dialogue: 0,0:52:43.19,0:52:46.09,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:52:50.13,0:52:52.13,Default,,0,0,0,,Уу-у...
Dialogue: 0,0:52:55.14,0:52:58.14,Default,,0,0,0,,Садақшы Сіз...
Dialogue: 0,0:53:01.14,0:53:04.14,Default,,0,0,0,,Берсеркер…
Dialogue: 0,0:53:15.16,0:53:19.16,Default,,0,0,0,,Сіздің қарсыласыңыз – мен.
Dialogue: 0,0:53:20.16,0:53:22.16,Default,,0,0,0,,Git!
Dialogue: 0,0:53:25.17,0:53:28.17,Default,,0,0,0,,Садақшы
Dialogue: 0,0:53:28.17,0:53:31.17,Default,,0,0,0,,Мен мұны сұрадым.
Dialogue: 0,0:53:31.17,0:53:33.17,Default,,0,0,0,,Иә
Dialogue: 0,0:53:41.18,0:54:00.14,Default,,0,0,0,,♪♪～
Dialogue: 0,0:54:00.14,0:54:02.14,Default,,0,0,0,,Бітті
Dialogue: 0,0:54:05.14,0:54:07.14,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:54:09.14,0:54:15.15,Default,,0,0,0,,Таза қаһармандық рух сол қарғыс атқан дүниеге қарсы тұра алмайды.
Dialogue: 0,0:54:15.15,0:54:20.15,Default,,0,0,0,,Сенің дәл қазір осы орманды толтырып тұрған кекшіл рухтардан айырмашылығың жоқ.
Dialogue: 0,0:54:23.16,0:54:25.16,Default,,0,0,0,,Git
Dialogue: 0,0:54:25.16,0:54:41.18,Default,,0,0,0,,♪♪～
Dialogue: 0,0:54:41.18,0:54:43.18,Default,,0,0,0,,Жабырқаушы!
Dialogue: 0,0:54:50.12,0:54:52.12,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:54:53.12,0:54:55.12,Default,,0,0,0,,Берсеркер…
Dialogue: 0,0:54:55.12,0:54:58.13,Default,,0,0,0,,Берсеркер
Dialogue: 0,0:54:58.13,0:55:02.13,Default,,0,0,0,,Жабырқаушы!
Dialogue: 0,0:55:07.14,0:55:10.14,Default,,0,0,0,,(Берсеркердің айқайы)
Dialogue: 0,0:55:24.15,0:55:26.15,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:55:53.11,0:55:55.12,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:55:55.12,0:56:38.16,Default,,0,0,0,,♪♪～
Dialogue: 0,0:56:38.16,0:56:40.16,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:56:40.16,0:56:59.11,Default,,0,0,0,,♪♪～
Dialogue: 0,0:56:59.11,0:57:01.12,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:57:01.12,0:57:24.14,Default,,0,0,0,,♪♪～
Dialogue: 0,0:57:24.14,0:57:27.14,Default,,0,0,0,,(Берсеркердің айқайы)
Dialogue: 0,0:57:27.14,0:57:36.15,Default,,0,0,0,,♪♪～
Dialogue: 0,0:57:36.15,0:57:40.16,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:57:40.16,0:58:20.13,Default,,0,0,0,,♪♪～
Dialogue: 0,0:58:20.13,0:58:23.13,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:58:49.09,0:58:53.09,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:59:30.13,0:59:33.13,Default,,0,0,0,,Менің рөлім орындалды.
Dialogue: 0,0:59:33.13,0:59:35.14,Default,,0,0,0,,Қалғанын сізге қалдырамын.
Dialogue: 0,0:59:35.14,0:59:39.14,Default,,0,0,0,,Құдайға шүкір, жіберіп алған ұпайларымызды қайтарып аламыз.
Dialogue: 0,0:59:43.14,0:59:46.14,Default,,0,0,0,,Сабер!
Dialogue: 0,0:59:51.15,0:59:53.15,Default,,0,0,0,,Апамды айқайлата алмай тұрып, оған не істедің?
Dialogue: 0,0:59:53.15,0:59:58.16,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:59:58.16,1:00:00.16,Default,,0,0,0,,Хмм...
Dialogue: 0,1:00:04.17,1:00:07.17,Default,,0,0,0,,Ах! Илья!
Dialogue: 0,1:00:07.17,1:00:09.17,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,1:00:09.17,1:00:12.17,Default,,0,0,0,,Ах... у... ха!
Dialogue: 0,1:00:21.18,1:00:23.18,Default,,0,0,0,,Осымен
Dialogue: 0,1:00:23.18,1:00:26.18,Default,,0,0,0,,Сен маған керек емессің
Dialogue: 0,1:00:28.19,1:00:31.19,Default,,0,0,0,,А... (Садақшы) Әй!
Dialogue: 0,1:00:32.19,1:00:36.20,Default,,0,0,0,,Ғұн, күтпеген жерден шабуыл болмаса, баланың басын да алып тастай алмайсың ба?
Dialogue: 0,1:00:36.20,1:00:38.20,Default,,0,0,0,,Үшінші деңгей
Dialogue: 0,1:00:40.20,1:00:44.21,Default,,0,0,0,,Мұнда неге келуге болады?
Dialogue: 0,1:00:44.21,1:00:46.14,Default,,0,0,0,,Ал...
Dialogue: 0,1:00:46.14,1:00:48.14,Default,,0,0,0,,Садақшы!
Dialogue: 0,1:00:48.14,1:00:50.14,Default,,0,0,0,,Асығыңыз! (Рин) Ех
Dialogue: 0,1:00:50.14,1:00:52.15,Default,,0,0,0,,Ол нәрсе мені қуып жетсе, бітті.
Dialogue: 0,1:00:52.15,1:00:54.15,Default,,0,0,0,,Ах…
Dialogue: 0,1:01:01.16,1:01:03.16,Default,,0,0,0,,Сұрау кейінірек келеді.
Dialogue: 0,1:01:03.16,1:01:05.16,Default,,0,0,0,,Жүгір, балақай.
Dialogue: 0,1:01:05.16,1:01:10.16,Default,,0,0,0,,Енді Ильяның қолын алдың, оны соңына дейін қорға.
Dialogue: 0,1:01:17.17,1:01:19.17,Default,,0,0,0,,Кеттік
Dialogue: 0,1:01:23.18,1:01:25.18,Default,,0,0,0,,Хмм...
Dialogue: 0,1:01:28.18,1:01:30.18,Default,,0,0,0,,Иә!
Dialogue: 0,1:01:30.18,1:01:32.19,Default,,0,0,0,,Уау! Хмф
Dialogue: 0,1:01:32.19,1:01:34.19,Default,,0,0,0,,Ха…
Dialogue: 0,1:01:35.19,1:01:37.19,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:01:37.19,1:01:39.19,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:40.19,1:01:42.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:01:42.20,1:01:44.20,Default,,0,0,0,,Неліктен қозғалуға болады?
Dialogue: 0,1:01:44.20,1:01:46.13,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:01:46.13,1:01:48.14,Default,,0,0,0,,Менің білетінім (Нағыз өлтіруші) Мен...
Dialogue: 0,1:01:48.14,1:01:50.14,Default,,0,0,0,,Мен, басқалар сияқты
Dialogue: 0,1:01:50.14,1:01:52.14,Default,,0,0,0,,Дұрыс батыр емес
Dialogue: 0,1:01:52.14,1:01:54.14,Default,,0,0,0,,Ол таза емес
Dialogue: 0,1:01:54.14,1:01:57.15,Default,,0,0,0,,Аздап кірге жол беріңіз
Dialogue: 0,1:01:57.15,1:02:01.15,Default,,0,0,0,,Басқаша айтқанда, бұл дене де бұрмаланған батырлық рух!
Dialogue: 0,1:02:01.15,1:02:04.15,Default,,0,0,0,,Уф!
Dialogue: 0,1:02:06.15,1:02:10.16,Default,,0,0,0,,Гаар!
Dialogue: 0,1:02:10.16,1:02:12.16,Default,,0,0,0,,Джиджи
Dialogue: 0,1:02:22.17,1:02:25.17,Default,,0,0,0,,Садақшы еңбегіңіз үшін рахмет
Dialogue: 0,1:02:25.17,1:02:28.18,Default,,0,0,0,,Сіз өзіңіздің рухани пішініңізге орала аласыз.
Dialogue: 0,1:02:28.18,1:02:30.18,Default,,0,0,0,,Тезірек осы жерден... (Арчер) Нгх!
Dialogue: 0,1:02:30.18,1:02:33.18,Default,,0,0,0,,Тохсака! иә?
Dialogue: 0,1:02:36.18,1:02:38.18,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:39.19,1:02:41.19,Default,,0,0,0,,Өтірікші...
Dialogue: 0,1:02:43.19,1:02:46.09,Default,,0,0,0,,Садақшы!
Dialogue: 0,1:02:48.13,1:02:50.13,Default,,0,0,0,,Тохсака!
Dialogue: 0,1:02:50.13,1:02:52.13,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:02:52.13,1:02:56.14,Default,,0,0,0,,Тез қашуым керек еді...
Dialogue: 0,1:02:56.14,1:02:58.14,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:07.15,1:03:09.15,Default,,0,0,0,,Сиқырлы күш жиналуда!
Dialogue: 0,1:03:09.15,1:03:11.15,Default,,0,0,0,,және тек үшеуміз – анам, әкем және мен – бірге өмір сүремін…
Dialogue: 0,1:03:12.15,1:03:14.16,Default,,0,0,0,,О... (Рин) Ха!
Dialogue: 0,1:03:14.16,1:03:16.16,Default,,0,0,0,,Жүгір, Тохсака!
Dialogue: 0,1:03:24.17,1:03:29.17,Default,,0,0,0,,Мен қылышымның сүйегімін
Dialogue: 0,1:03:29.17,1:03:32.17,Default,,0,0,0,,Болат менің денем
Dialogue: 0,1:03:33.17,1:03:36.18,Default,,0,0,0,,Мен жасадым—
Dialogue: 0,1:03:36.18,1:03:39.18,Default,,0,0,0,,мыңнан астам жүздер
Dialogue: 0,1:03:44.19,1:03:48.12,Default,,0,0,0,,Ро Айас
Dialogue: 0,1:03:48.12,1:04:00.13,Default,,0,0,0,,♪♪～
Dialogue: 0,1:04:00.13,1:04:04.14,Default,,0,0,0,,Ууууууууууууууууууу...
Dialogue: 0,1:04:04.14,1:04:06.14,Default,,0,0,0,,Ахх...
Dialogue: 0,1:04:06.14,1:04:20.15,Default,,0,0,0,,♪♪～
Dialogue: 0,1:04:20.15,1:04:22.15,Default,,0,0,0,,Уф…
Dialogue: 0,1:04:23.16,1:04:25.16,Default,,0,0,0,,Хмм...
Dialogue: 0,1:04:25.16,1:04:27.16,Default,,0,0,0,,Абай бол, ДжоДжо!
Dialogue: 0,1:04:28.16,1:04:30.16,Default,,0,0,0,,Ширу...
Dialogue: 0,1:04:31.17,1:04:33.17,Default,,0,0,0,,Ах…
Dialogue: 0,1:04:33.17,1:04:35.17,Default,,0,0,0,,Неге...
Dialogue: 0,1:04:35.17,1:04:37.17,Default,,0,0,0,,Ширу
Dialogue: 0,1:04:39.17,1:04:43.17,Default,,0,0,0,,Широ... Широ!
Dialogue: 0,1:04:49.12,1:04:51.12,Default,,0,0,0,,Осы уақытқа дейін?
Dialogue: 0,1:04:54.12,1:04:58.12,Default,,0,0,0,,Сіз сарапшысыз, Тохсака.
Dialogue: 0,1:05:01.13,1:05:03.13,Default,,0,0,0,,Хмм...
Dialogue: 0,1:05:03.13,1:05:17.14,Default,,0,0,0,,♪♪～
Dialogue: 0,1:05:17.14,1:05:19.14,Default,,0,0,0,,​​Есіңіз дұрыс па?
Dialogue: 0,1:05:23.15,1:05:27.15,Default,,0,0,0,,Егер сіз мұны істесеңіз...
Dialogue: 0,1:05:27.15,1:05:30.16,Default,,0,0,0,,Бұл туралы ойлаудың қажеті жоқ
Dialogue: 0,1:05:30.16,1:05:33.16,Default,,0,0,0,,Ештеңе жасамасақ, екі адам жоғалады...
Dialogue: 0,1:05:33.16,1:05:38.16,Default,,0,0,0,,Осылай жасасаңыз, міндетті түрде бір адам құтқарылады.
Dialogue: 0,1:05:41.17,1:05:43.17,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,1:05:50.11,1:05:53.11,Default,,0,0,0,,Сакура қазір
Dialogue: 0,1:05:53.11,1:05:56.12,Default,,0,0,0,,А, дұрыс.
Dialogue: 0,1:05:56.12,1:05:59.12,Default,,0,0,0,,Сіз бұлай көрінсе, таң қаласыз.
Dialogue: 0,1:05:59.12,1:06:02.12,Default,,0,0,0,,А, мен жеңіл жарақат алдым.
Dialogue: 0,1:06:02.12,1:06:05.13,Default,,0,0,0,,Өйткені ол өте оралған ...
Dialogue: 0,1:06:05.13,1:06:08.13,Default,,0,0,0,,Бұл асыра сілтеу сияқты көрінеді, бірақ бұл үлкен мәселе емес.
Dialogue: 0,1:06:08.13,1:06:10.13,Default,,0,0,0,,Ха…
Dialogue: 0,1:06:11.13,1:06:15.14,Default,,0,0,0,,А, мен Тохсаканы сонда кездестірдім.
Dialogue: 0,1:06:15.14,1:06:19.14,Default,,0,0,0,,Сіз маған көмектестіңіз, сондықтан әзірше бітім.
Dialogue: 0,1:06:19.14,1:06:22.14,Default,,0,0,0,,Сонымен... бұл Илья.
Dialogue: 0,1:06:22.14,1:06:26.15,Default,,0,0,0,,Жарайды... бұл тым кенет, бірақ...
Dialogue: 0,1:06:26.15,1:06:28.15,Default,,0,0,0,,Ах… Ммм…
Dialogue: 0,1:06:32.15,1:06:34.16,Default,,0,0,0,,Қарулардың қозғалуы?
Dialogue: 0,1:06:34.16,1:06:37.16,Default,,0,0,0,,Жоқ... (Рин) Менің ойымша.
Dialogue: 0,1:06:37.16,1:06:40.16,Default,,0,0,0,,Қызметшінің денесін адамға ауыстыру...
Dialogue: 0,1:06:40.16,1:06:42.16,Default,,0,0,0,,Бұл өте ұят.
Dialogue: 0,1:06:43.16,1:06:45.10,Default,,0,0,0,,Сонымен…
Dialogue: 0,1:06:45.10,1:06:47.10,Default,,0,0,0,,Егер сіз бұл қолды бір рет болса да қолдансаңыз—
Dialogue: 0,1:06:47.10,1:06:50.10,Default,,0,0,0,,Садақшының сиқырлы тізбегі іске қосылады
Dialogue: 0,1:06:50.10,1:06:54.11,Default,,0,0,0,,Ал сіздің денеңіз сиқырға шыдамайды...
Dialogue: 0,1:06:54.11,1:06:56.11,Default,,0,0,0,,Ішінен құлап кетеді
Dialogue: 0,1:06:56.11,1:06:58.11,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,1:06:58.11,1:07:00.11,Default,,0,0,0,,Сонда мына шүберекті...
Dialogue: 0,1:07:00.11,1:07:02.11,Default,,0,0,0,,Мөр
Dialogue: 0,1:07:05.12,1:07:07.12,Default,,0,0,0,,Тохсака Рахмет
Dialogue: 0,1:07:07.12,1:07:11.13,Default,,0,0,0,,Не? Не... кенеттен не болды?
Dialogue: 0,1:07:11.13,1:07:15.13,Default,,0,0,0,,Мен Зоукенді жеңгенше ынтымақтасуға ниеттемін.
Dialogue: 0,1:07:15.13,1:07:17.13,Default,,0,0,0,,Және-
Dialogue: 0,1:07:17.13,1:07:20.13,Default,,0,0,0,,Ол қыздың қасында болу ыңғайлы.
Dialogue: 0,1:07:21.14,1:07:25.14,Default,,0,0,0,,Менің ойымша, сіз Сакура туралы ойлап отырсыз.
Dialogue: 0,1:07:25.14,1:07:27.14,Default,,0,0,0,,≪(Рин) Сонымен...
Dialogue: 0,1:07:27.14,1:07:30.14,Default,,0,0,0,,≪Хаха, және—
Dialogue: 0,1:07:30.14,1:07:32.15,Default,,0,0,0,,Мен де шебер болуым керек...
Dialogue: 0,1:07:32.15,1:07:36.15,Default,,0,0,0,,Осылайша мен Тохсаканы ешқашан танымадым.
Dialogue: 0,1:07:37.15,1:07:41.16,Default,,0,0,0,,Бұл сәл басқаша
Dialogue: 0,1:07:41.16,1:07:44.16,Default,,0,0,0,,≪Мен сіз туралы білмеймін, бірақ...
Dialogue: 0,1:07:44.16,1:07:47.09,Default,,0,0,0,,Мен сізді бұрыннан білемін.
Dialogue: 0,1:07:47.09,1:07:49.09,Default,,0,0,0,,Ha
Dialogue: 0,1:07:50.10,1:07:52.10,Default,,0,0,0,,Шамамен 4 жыл бұрын
Dialogue: 0,1:07:52.10,1:07:55.10,Default,,0,0,0,,Сіз күн батқанша
Dialogue: 0,1:07:55.10,1:07:58.11,Default,,0,0,0,,Сіз биіктікке секірдіңіз бе?
Dialogue: 0,1:07:58.11,1:08:01.11,Default,,0,0,0,,Ах... ≪(Рин) Мен сонда болдым.
Dialogue: 0,1:08:01.11,1:08:03.11,Default,,0,0,0,,Ха…
Dialogue: 0,1:08:03.11,1:08:06.11,Default,,0,0,0,,Амал жоқ, мен секіріп кете бердім, ақымақ...
Dialogue: 0,1:08:06.11,1:08:09.12,Default,,0,0,0,,Ақыр соңында, мен саған ақымақ сияқты қарап тұрдым.
Dialogue: 0,1:08:09.12,1:08:13.12,Default,,0,0,0,,Егер мен мұны істей алмаймын деп шешсем...
Dialogue: 0,1:08:13.12,1:08:15.12,Default,,0,0,0,,Мен жай ғана артқа тартып жатырмын.
Dialogue: 0,1:08:15.12,1:08:18.13,Default,,0,0,0,,Негізінен суық.
Dialogue: 0,1:08:18.13,1:08:21.13,Default,,0,0,0,,Жарайды, бірақ сен сиқыршысың, солай ма?
Dialogue: 0,1:08:21.13,1:08:26.13,Default,,0,0,0,,Өмірім жақсы ма деп жүргенімде...
Dialogue: 0,1:08:26.13,1:08:30.14,Default,,0,0,0,,Маған мүлдем қарама-қарсы адам көрсетілді.
Dialogue: 0,1:08:30.14,1:08:32.14,Default,,0,0,0,,Ха, бұл өте таң қалдырды, солай емес пе?
Dialogue: 0,1:08:32.14,1:08:38.14,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:08:50.09,1:08:52.09,Default,,0,0,0,,)
Dialogue: 0,1:08:55.10,1:09:00.10,Default,,0,0,0,,Бұл естеліктерді алып тастамаңыз...
Dialogue: 0,1:09:09.11,1:09:12.11,Default,,0,0,0,,Бұл шындық. Бұл не? Бұл қол! Ауырды!
Dialogue: 0,1:09:13.11,1:09:15.11,Default,,0,0,0,,Бір...
Dialogue: 0,1:09:17.12,1:09:19.12,Default,,0,0,0,,Фу…
Dialogue: 0,1:09:25.13,1:09:28.13,Default,,0,0,0,,Күтпеген жерден матаны алсаңыз...
Dialogue: 0,1:09:28.13,1:09:30.13,Default,,0,0,0,,Заттар бұрынғыдай.
Dialogue: 0,1:09:44.14,1:09:48.15,Default,,0,0,0,,Буха…
Dialogue: 0,1:09:48.15,1:09:52.15,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:09:52.15,1:09:54.15,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:09:54.15,1:09:58.16,Default,,0,0,0,,Бұл…—
Dialogue: 0,1:09:58.16,1:10:00.16,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:10:09.17,1:10:11.17,Default,,0,0,0,,Ширу
Dialogue: 0,1:10:13.17,1:10:17.18,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,1:10:17.18,1:10:20.18,Default,,0,0,0,,Сакураның бақыты –
Dialogue: 0,1:10:20.18,1:10:23.18,Default,,0,0,0,,Тірі екеніңді, жанымда екеніңді
Dialogue: 0,1:10:23.18,1:10:27.19,Default,,0,0,0,,Оның қалаған басқа ештеңесі жоқ.
Dialogue: 0,1:10:27.19,1:10:31.19,Default,,0,0,0,,Мен оның аман қалғанын қалаймын.
Dialogue: 0,1:10:31.19,1:10:33.19,Default,,0,0,0,,Мен—
Dialogue: 0,1:10:33.19,1:10:35.19,Default,,0,0,0,,Өйткені ол маған ұнайды
Dialogue: 0,1:10:39.20,1:10:45.14,Default,,0,0,0,,((Широу, сен Сакураның жағындасың ба?))
Dialogue: 0,1:10:45.14,1:10:50.14,Default,,0,0,0,,)
Dialogue: 0,1:10:51.15,1:10:53.15,Default,,0,0,0,,Хмм...
Dialogue: 0,1:10:53.15,1:10:56.15,Default,,0,0,0,,≪Аға
Dialogue: 0,1:10:56.15,1:10:58.15,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:59.15,1:11:01.15,Default,,0,0,0,,Ах… Ммм…
Dialogue: 0,1:11:04.16,1:11:08.16,Default,,0,0,0,,Аа, сиқырлы күшіңіз жетпей ме?
Dialogue: 0,1:11:08.16,1:11:11.17,Default,,0,0,0,,Кіріңіз және күтіңіз.
Dialogue: 0,1:11:11.17,1:11:15.17,Default,,0,0,0,,Ым, кескішті қайда қойдыңыз?
Dialogue: 0,1:11:40.19,1:11:42.19,Default,,0,0,0,,Ах…
Dialogue: 0,1:11:43.20,1:11:47.10,Default,,0,0,0,,Са... шие гүлдейді?
Dialogue: 0,1:11:48.14,1:11:52.14,Default,,0,0,0,,Неліктен менің аға...
Dialogue: 0,1:11:52.14,1:11:55.14,Default,,0,0,0,,Сен мені қорғайсың ба?
Dialogue: 0,1:11:57.14,1:12:01.15,Default,,0,0,0,,Бұл...
Dialogue: 0,1:12:01.15,1:12:05.15,Default,,0,0,0,,Мен Сакураның сонда болғанын қаладым.
Dialogue: 0,1:12:05.15,1:12:08.16,Default,,0,0,0,,Маған шие гүлдері керек
Dialogue: 0,1:12:08.16,1:12:11.16,Default,,0,0,0,,Кету -
Dialogue: 0,1:12:11.16,1:12:13.16,Default,,0,0,0,,Мен тіпті ойлай да алмадым
Dialogue: 0,1:12:14.16,1:12:18.17,Default,,0,0,0,,Бұл отбасы ретінде ме?
Dialogue: 0,1:12:18.17,1:12:20.17,Default,,0,0,0,,Немесе—
Dialogue: 0,1:12:20.17,1:12:25.17,Default,,0,0,0,,Қыз ретінде...?
Dialogue: 0,1:12:29.18,1:12:31.18,Default,,0,0,0,,О
Dialogue: 0,1:12:31.18,1:12:34.18,Default,,0,0,0,,Маған шие гүлдері ұнайды
Dialogue: 0,1:12:34.18,1:12:36.18,Default,,0,0,0,,Ха…
Dialogue: 0,1:12:39.19,1:12:43.19,Default,,0,0,0,,Олай болса, мені ұстаңыз.
Dialogue: 0,1:12:43.19,1:12:45.13,Default,,0,0,0,,Хех хех хех. Пфу.
Dialogue: 0,1:12:45.13,1:12:47.13,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:50.13,1:12:55.13,Default,,0,0,0,,Сенпай... Мен кірмін бе?
Dialogue: 0,1:12:56.14,1:13:00.14,Default,,0,0,0,,Бұл біртүрлі... солай емес пе?
Dialogue: 0,1:13:00.14,1:13:05.15,Default,,0,0,0,,Мен жаңа ғана ағаның бөлмесіне келдім...
Dialogue: 0,1:13:05.15,1:13:07.15,Default,,0,0,0,,Міне осылай
Dialogue: 0,1:13:07.15,1:13:09.15,Default,,0,0,0,,Мен сені жалғыз жұбатсам да...
Dialogue: 0,1:13:09.15,1:13:12.15,Default,,0,0,0,,Бұл мүлдем сәйкес келмейді...
Dialogue: 0,1:13:12.15,1:13:17.16,Default,,0,0,0,,Мен қазір тек үлкендерімді ойлаймын...
Dialogue: 0,1:13:17.16,1:13:20.16,Default,,0,0,0,,Бұл... лас...
Dialogue: 0,1:13:21.16,1:13:23.16,Default,,0,0,0,,Ха…
Dialogue: 0,1:13:24.16,1:13:26.17,Default,,0,0,0,,Жоқ
Dialogue: 0,1:13:26.17,1:13:29.17,Default,,0,0,0,,Ол кір емес
Dialogue: 0,1:13:29.17,1:13:32.17,Default,,0,0,0,,Шие гүлдері әдемі
Dialogue: 0,1:13:33.17,1:13:35.17,Default,,0,0,0,,Ол ешқашан да болмайды!
Dialogue: 0,1:13:48.12,1:13:51.13,Default,,0,0,0,,Иа... Ахх.
Dialogue: 0,1:13:51.13,1:13:54.13,Default,,0,0,0,,Иә...
Dialogue: 0,1:13:54.13,1:13:59.13,Default,,0,0,0,,А... иә...
Dialogue: 0,1:13:59.13,1:14:01.13,Default,,0,0,0,,Бұл шындық. Бұл не? Бұл қол! Ауырды!
Dialogue: 0,1:14:04.14,1:14:08.14,Default,,0,0,0,,Мен алмаймын.
Dialogue: 0,1:14:08.14,1:14:10.14,Default,,0,0,0,,Дәл қазір, әпкем...
Dialogue: 0,1:14:10.14,1:14:13.15,Default,,0,0,0,,Мен жаңа ғана ағамды алып кеттім...
Dialogue: 0,1:14:13.15,1:14:18.15,Default,,0,0,0,,Мен қатты қорықтым.
Dialogue: 0,1:14:18.15,1:14:20.15,Default,,0,0,0,,Я...
Dialogue: 0,1:14:20.15,1:14:23.15,Default,,0,0,0,,Ой...
Dialogue: 0,1:14:28.16,1:14:30.16,Default,,0,0,0,,Ах…
Dialogue: 0,1:14:32.17,1:14:35.17,Default,,0,0,0,,Мен байқамай тұра алмадым...
Dialogue: 0,1:14:35.17,1:14:37.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:14:37.17,1:14:39.17,Default,,0,0,0,,Ха…
Dialogue: 0,1:14:41.18,1:14:44.18,Default,,0,0,0,,Сен… Сен…
Dialogue: 0,1:14:44.18,1:14:58.13,Default,,0,0,0,,♪♪～
Dialogue: 0,1:14:58.13,1:15:00.13,Default,,0,0,0,,Сакура
Dialogue: 0,1:15:00.13,1:15:02.13,Default,,0,0,0,,Ha
Dialogue: 0,1:15:06.13,1:15:10.13,Default,,0,0,0,,Мен сені сүйемін, Сенпай.
Dialogue: 0,1:15:18.15,1:15:21.15,Default,,0,0,0,,Бата берейік
Dialogue: 0,1:15:21.15,1:15:23.15,Default,,0,0,0,,Бата?
Dialogue: 0,1:15:25.15,1:15:27.15,Default,,0,0,0,,Не?
Dialogue: 0,1:15:27.15,1:15:31.16,Default,,0,0,0,,Тағы бір Қасиетті Граил жасалуда
Dialogue: 0,1:15:31.16,1:15:35.16,Default,,0,0,0,,Бұл дүниедегі барлық жамандық деп аталады.
Dialogue: 0,1:15:35.16,1:15:38.17,Default,,0,0,0,,Адамдар жасаған кезде —
Dialogue: 0,1:15:38.17,1:15:42.17,Default,,0,0,0,,Құрамында адамдар қаламайтын нәрсе бар
Dialogue: 0,1:15:42.17,1:15:45.11,Default,,0,0,0,,Жақсылық пен жамандықтың орны
Dialogue: 0,1:15:45.11,1:15:47.11,Default,,0,0,0,,Жауап берудің орнына
Dialogue: 0,1:15:47.11,1:15:52.11,Default,,0,0,0,,Сізге жауап бере алатын нәрсені жасасаңыз не болар еді?
Dialogue: 0,1:15:55.12,1:15:58.12,Default,,0,0,0,,Жауап жақын
Dialogue: 0,1:15:58.12,1:16:03.12,Default,,0,0,0,,Бұл сұрақ күпірлік болса...
Dialogue: 0,1:16:03.12,1:16:05.13,Default,,0,0,0,,Құдайдың алдында -
Dialogue: 0,1:16:05.13,1:16:08.13,Default,,0,0,0,,Бар жүрегіммен—
Dialogue: 0,1:16:08.13,1:16:11.13,Default,,0,0,0,,Тіпті қожайыным да жауапқа тартылады.
Dialogue: 0,1:16:18.14,1:16:20.14,Default,,0,0,0,,Өйткені мен саған қамқор боламын...
Dialogue: 0,1:16:20.14,1:16:23.14,Default,,0,0,0,,Мен саған таңғы ас әзірлеуге рұқсат етемін.
Dialogue: 0,1:16:27.15,1:16:30.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:30.15,1:16:32.15,Default,,0,0,0,,А, мен—
Dialogue: 0,1:16:32.15,1:16:35.16,Default,,0,0,0,,Мен Тохсақа-сенпайға көмектесемін.
Dialogue: 0,1:16:35.16,1:16:37.16,Default,,0,0,0,,Сакура
Dialogue: 0,1:16:37.16,1:16:40.16,Default,,0,0,0,,Иә? иә
Dialogue: 0,1:16:40.16,1:16:43.16,Default,,0,0,0,,Білесіз бе, Тохсакада...
Dialogue: 0,1:16:43.16,1:16:47.06,Default,,0,0,0,,Жарайды, не істеймін…
Dialogue: 0,1:16:49.10,1:16:51.10,Default,,0,0,0,,Әпке-
Dialogue: 0,1:16:51.10,1:16:54.11,Default,,0,0,0,,Мен мына көкөністерді жуамын.
Dialogue: 0,1:16:54.11,1:16:58.11,Default,,0,0,0,,Иә, өтінемін... Мен...
Dialogue: 0,1:17:00.11,1:17:02.11,Default,,0,0,0,,Хмм...
Dialogue: 0,1:17:04.12,1:17:07.12,Default,,0,0,0,,Әлі де біртүрлі ме?
Dialogue: 0,1:17:07.12,1:17:09.12,Default,,0,0,0,,Апа
Dialogue: 0,1:17:09.12,1:17:15.13,Default,,0,0,0,,О... о... таңқаларлық ештеңе жоқ.
Dialogue: 0,1:17:15.13,1:17:17.13,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:17:17.13,1:17:19.13,Default,,0,0,0,,Ахахаха
Dialogue: 0,1:17:23.14,1:17:27.14,Default,,0,0,0,,Илья: Мен өз бөлмемде тұра аламын ба?
Dialogue: 0,1:17:27.14,1:17:30.14,Default,,0,0,0,,Иә? Мысал қандай?
Dialogue: 0,1:17:30.14,1:17:32.15,Default,,0,0,0,,Тіпті мұнда —
Dialogue: 0,1:17:32.15,1:17:35.15,Default,,0,0,0,,Сізге бір-екі құпия қару қажет болуы мүмкін деп ойлайсыз ба?
Dialogue: 0,1:17:35.15,1:17:37.15,Default,,0,0,0,,Садақшының қолында
Dialogue: 0,1:17:37.15,1:17:41.15,Default,,0,0,0,,Эйнцберндер туралы біліміңіз бар ма?
Dialogue: 0,1:17:41.15,1:17:46.09,Default,,0,0,0,,Мен Тохсаканың оны пайдаланатын бірдеңесі болуы мүмкін деп ұсындым.
Dialogue: 0,1:17:46.09,1:17:52.10,Default,,0,0,0,,Мені Кишуа Зелретчтің сувенирлері қызықтырмайды, бірақ...
Dialogue: 0,1:17:52.10,1:17:56.10,Default,,0,0,0,,Сиқыршы қалдырған қазына сандығы —
Dialogue: 0,1:17:56.10,1:17:58.10,Default,,0,0,0,,Өйткені ол әдемі көрінеді
Dialogue: 0,1:18:00.11,1:18:04.11,Default,,0,0,0,,Кишуа... Зел... (Суды өшіріп жатқан кранның дыбысы)
Dialogue: 0,1:18:04.11,1:18:06.11,Default,,0,0,0,,Сенпай иә?
Dialogue: 0,1:18:07.11,1:18:09.12,Default,,0,0,0,,Бұл…—
Dialogue: 0,1:18:09.12,1:18:12.12,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:18:12.12,1:18:14.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:14.12,1:18:18.13,Default,,0,0,0,,((Мен әрқашан алыстан бақылағанмен
Dialogue: 0,1:18:18.13,1:18:21.13,Default,,0,0,0,,Мен сені «не-сан» деп атайтын күн келеді деп үміттенемін...
Dialogue: 0,1:18:21.13,1:18:23.13,Default,,0,0,0,,Мен олай ойламадым))
Dialogue: 0,1:18:23.13,1:18:26.13,Default,,0,0,0,,((Матудың үйіне барғаннан кейін —
Dialogue: 0,1:18:26.13,1:18:29.14,Default,,0,0,0,,Тохсакамен қарым-қатынасыңыз болмады ма? ))
Dialogue: 0,1:18:29.14,1:18:31.14,Default,,0,0,0,,()
Dialogue: 0,1:18:31.14,1:18:33.14,Default,,0,0,0,,((Мен және менің әпкем...
Dialogue: 0,1:18:33.14,1:18:37.14,Default,,0,0,0,,Мен апалы-сіңлілі екенімізді енді ғана білдім...
Dialogue: 0,1:18:37.14,1:18:42.14,Default,,0,0,0,,Мен мүмкіндігінше араласудан аулақ болуға тырыстым))
Dialogue: 0,1:18:43.15,1:18:47.09,Default,,0,0,0,,((Егер олар менің сиқырымды білсе ...
Dialogue: 0,1:18:47.09,1:18:49.09,Default,,0,0,0,,Мені жек көретініне сенімдімін))
Dialogue: 0,1:18:50.09,1:18:54.09,Default,,0,0,0,,)
Dialogue: 0,1:18:56.10,1:18:59.10,Default,,0,0,0,,((Матоудың жұмысы ...
Dialogue: 0,1:18:59.10,1:19:03.10,Default,,0,0,0,,Әу бастан басқалардан ұрлаумен шектелетін сиқыр))
Dialogue: 0,1:19:03.10,1:19:08.10,Default,,0,0,0,,)
Dialogue: 0,1:19:10.11,1:19:14.11,Default,,0,0,0,,)
Dialogue: 0,1:19:14.11,1:19:19.12,Default,,0,0,0,,((Оқыту қатал болғаны рас, бірақ...
Dialogue: 0,1:19:19.12,1:19:21.12,Default,,0,0,0,,Ауырлық дәрежесі бойынша —
Dialogue: 0,1:19:21.12,1:19:24.12,Default,,0,0,0,,Үлкендермен бәсекеге түсе алмайсың))
Dialogue: 0,1:19:24.12,1:19:28.13,Default,,0,0,0,,((Сіздің аға буыныңыз түнде қандай жаттығу жасайды?
Dialogue: 0,1:19:28.13,1:19:31.13,Default,,0,0,0,,Мен оны бұрын көргенмін))
Dialogue: 0,1:19:31.13,1:19:36.13,Default,,0,0,0,,)
Dialogue: 0,1:19:37.14,1:19:42.14,Default,,0,0,0,,)
Dialogue: 0,1:19:42.14,1:19:48.15,Default,,0,0,0,,)
Dialogue: 0,1:19:48.15,1:19:52.15,Default,,0,0,0,,((Ешкім сізді мұны істеуге мәжбүрлемейді -
Dialogue: 0,1:19:52.15,1:19:56.16,Default,,0,0,0,,Мен осы уақыт бойы жалғыз болдым, мен сені қыңырлықпен қорғадым))
Dialogue: 0,1:19:56.16,1:20:03.16,Default,,0,0,0,,)
Dialogue: 0,1:20:03.16,1:20:09.16,Default,,0,0,0,,)
Dialogue: 0,1:20:19.18,1:20:24.18,Default,,0,0,0,,)
Dialogue: 0,1:20:24.18,1:20:30.18,Default,,0,0,0,,)
Dialogue: 0,1:20:32.19,1:20:35.19,Default,,0,0,0,,Ааа!
Dialogue: 0,1:20:37.20,1:20:42.20,Default,,0,0,0,,Сіз оны алдыңыз! Эмия~!
Dialogue: 0,1:20:42.20,1:20:50.00,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:21:04.16,1:21:10.16,Default,,0,0,0,,Неліктен ештеңе болып жатқан жоқ?
Dialogue: 0,1:21:14.17,1:21:19.17,Default,,0,0,0,,Уф... ой...
Dialogue: 0,1:21:19.17,1:21:24.18,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:21:24.18,1:21:27.18,Default,,0,0,0,,[Монитор] (Жаңалықтар жүргізуші) Келесі жаңалықтар.
Dialogue: 0,1:21:27.18,1:21:31.18,Default,,0,0,0,,Фуюки қаласындағы Синто қаласындағы Орталық саябақта өлтірілген деп есептелген мәйіт табылды...
Dialogue: 0,1:21:31.18,1:21:33.19,Default,,0,0,0,,Мынаны қара!
Dialogue: 0,1:21:33.19,1:21:35.19,Default,,0,0,0,,Арамшөптер қараланып барады.
Dialogue: 0,1:21:35.19,1:21:38.19,Default,,0,0,0,,Сол көлеңке...
Dialogue: 0,1:21:38.19,1:21:41.19,Default,,0,0,0,,Зоукен сені осылай жасауға мәжбүр етті ме?
Dialogue: 0,1:21:41.19,1:21:43.20,Default,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,1:21:43.20,1:21:46.13,Default,,0,0,0,,Мен бұлай дәлел қалдыруды елестете алмаймын.
Dialogue: 0,1:21:46.13,1:21:48.13,Default,,0,0,0,,[Монитор] (Жаңалық жүргізуші) Полиция тергеу жүргізіп жатыр.
Dialogue: 0,1:21:48.13,1:21:50.14,Default,,0,0,0,,Келесі - ертеңгі ауа райы.
Dialogue: 0,1:21:50.14,1:21:53.14,Default,,0,0,0,,Ауа райын болжау орталығы Сато мырза [Монитор] (Сато) Иә.
Dialogue: 0,1:21:54.14,1:21:59.14,Default,,0,0,0,,《Иә? Дәмі жоқ...》
Dialogue: 0,1:22:05.15,1:22:08.15,Default,,0,0,0,,《Жылы》
Dialogue: 0,1:22:08.15,1:22:14.16,Default,,0,0,0,,《Жақсы, мен оны әлі де сеземін》
Dialogue: 0,1:22:14.16,1:22:19.16,Default,,0,0,0,,《Енді мәңгі өмір сүргенін қалаймын》
Dialogue: 0,1:22:28.17,1:22:30.18,Default,,0,0,0,,)
Dialogue: 0,1:22:30.18,1:22:59.14,Default,,0,0,0,,♪♪～
Dialogue: 0,1:22:59.14,1:23:01.14,Default,,0,0,0,,《Жаяу серуендеу》
Dialogue: 0,1:23:01.14,1:23:04.14,Default,,0,0,0,,《Юраюраның басы бос...
Dialogue: 0,1:23:04.14,1:23:08.15,Default,,0,0,0,,Нақты мақсат – бос нәрсе.
Dialogue: 0,1:23:08.15,1:23:12.15,Default,,0,0,0,,《Дірілдеп, дірілдеп, жүре бер》
Dialogue: 0,1:23:12.15,1:23:16.16,Default,,0,0,0,,《Күлдір және ән айт》
Dialogue: 0,1:23:16.16,1:23:20.16,Default,,0,0,0,,《Бос мүшелер қағаз шар тәрізді.''
Dialogue: 0,1:23:20.16,1:23:24.16,Default,,0,0,0,,Жерде домалау》
Dialogue: 0,1:23:24.16,1:23:28.17,Default,,0,0,0,,《Есейген кезде ғана үлпілдек ұша аласыз.》
Dialogue: 0,1:23:28.17,1:23:33.17,Default,,0,0,0,,《Бару-бару-бару》
Dialogue: 0,1:23:33.17,1:23:36.17,Default,,0,0,0,,《Гого》
Dialogue: 0,1:23:55.13,1:23:57.13,Default,,0,0,0,,()
Dialogue: 0,1:24:03.14,1:24:06.14,Default,,0,0,0,,《Біреу саған қарай келе жатыр》
Dialogue: 0,1:24:06.14,1:24:09.14,Default,,0,0,0,,《Күлкі》
Dialogue: 0,1:24:09.14,1:24:13.14,Default,,0,0,0,,《Мені азғырғаным есімде жоқ》
Dialogue: 0,1:24:21.15,1:24:23.16,Default,,0,0,0,,()
Dialogue: 0,1:24:23.16,1:24:25.16,Default,,0,0,0,,)
Dialogue: 0,1:24:31.16,1:24:34.16,Default,,0,0,0,,《Кинкин, қатты естіледі...》
Dialogue: 0,1:24:42.18,1:24:45.08,Default,,0,0,0,,《Менің ішім дірілдеп кетті》
Dialogue: 0,1:24:52.12,1:24:55.12,Default,,0,0,0,,Көңіліңізді көтермеңіз
Dialogue: 0,1:24:55.12,1:24:59.12,Default,,0,0,0,,Сол кезде өлуге рұқсат етіңіз дедім.
Dialogue: 0,1:25:12.14,1:25:16.14,Default,,0,0,0,,Жарқыраған, әдемі...
Dialogue: 0,1:25:27.15,1:25:30.16,Default,,0,0,0,,Жеңілдік кезеңі аяқталды.
Dialogue: 0,1:25:30.16,1:25:32.16,Default,,0,0,0,,Ең болмаса мейірім деп біл.
Dialogue: 0,1:25:45.10,1:25:50.11,Default,,0,0,0,,Ааа аа... аа
Dialogue: 0,1:25:50.11,1:25:53.11,Default,,0,0,0,,Ах ха…
Dialogue: 0,1:25:53.11,1:25:57.12,Default,,0,0,0,,Не? Ол әлі дем алып жатыр ма?
Dialogue: 0,1:25:57.12,1:26:02.12,Default,,0,0,0,,Оның көлеңкесі ғана емес, денесі де өзгерді.
Dialogue: 0,1:26:04.12,1:26:06.12,Default,,0,0,0,,(шу)
Dialogue: 0,1:26:31.15,1:26:34.15,Default,,0,0,0,,Сен мені тізерлеп отырсың!
Dialogue: 0,1:26:34.15,1:27:07.12,Default,,0,0,0,,♪♪～
Dialogue: 0,1:27:07.12,1:27:10.12,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,1:27:10.12,1:27:26.14,Default,,0,0,0,,♪♪～
Dialogue: 0,1:27:26.14,1:27:29.14,Default,,0,0,0,,О...
Dialogue: 0,1:27:29.14,1:27:32.15,Default,,0,0,0,,Бар болғаны...
Dialogue: 0,1:27:32.15,1:27:34.15,Default,,0,0,0,,Ахмм
Dialogue: 0,1:27:34.15,1:27:59.11,Default,,0,0,0,,♪♪～
Dialogue: 0,1:27:59.11,1:28:01.11,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,1:28:01.11,1:28:04.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:04.11,1:28:07.11,Default,,0,0,0,,Эй, көрдің бе?
Dialogue: 0,1:28:07.11,1:28:09.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:09.12,1:28:31.14,Default,,0,0,0,,♪♪～
Dialogue: 0,1:28:31.14,1:28:33.14,Default,,0,0,0,,Ширу!
Dialogue: 0,1:28:35.14,1:28:37.14,Default,,0,0,0,,Қазір қонақ бөлмеге келіңіз!
Dialogue: 0,1:28:43.15,1:28:45.08,Default,,0,0,0,,[Монитор] (Репортер) Бүгін шамамен 22:30—
Dialogue: 0,1:28:45.08,1:28:49.09,Default,,0,0,0,,Синтостанцияның айналасында ауқымды электр қуаты үзілді.
Dialogue: 0,1:28:49.09,1:28:52.09,Default,,0,0,0,,Менің көршім тағы да жоғалып кетті,
Dialogue: 0,1:28:52.09,1:28:54.09,Default,,0,0,0,,кенет жоғалып кетті, т.б.
Dialogue: 0,1:28:54.09,1:28:57.10,Default,,0,0,0,,Полицияға көптеген жұмбақ хабарламалар келіп жатқан сияқты.
Dialogue: 0,1:28:57.10,1:28:59.10,Default,,0,0,0,,≪(шу)
Dialogue: 0,1:29:02.10,1:29:05.10,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,1:29:05.10,1:29:07.11,Default,,0,0,0,,Сакура!
Dialogue: 0,1:29:07.11,1:29:11.11,Default,,0,0,0,,Күте тұрыңыз! Емдік құралдарыңызды әкеліңіз!
Dialogue: 0,1:29:11.11,1:29:13.11,Default,,0,0,0,,Оқу…
Dialogue: 0,1:29:17.12,1:29:20.12,Default,,0,0,0,,《Байқама》
Dialogue: 0,1:29:20.12,1:29:22.12,Default,,0,0,0,,《Тоқта》
Dialogue: 0,1:29:30.13,1:29:33.13,Default,,0,0,0,,《Оларды ұқсас деп ойлама》
Dialogue: 0,1:29:35.13,1:29:38.14,Default,,0,0,0,,[Монитор] (Жаңалықтар жүргізуші) Тіпті қазір жәбірленуші белгілі болса да...
Dialogue: 0,1:29:38.14,1:29:40.14,Default,,0,0,0,,60-тан астам адам
Dialogue: 0,1:29:40.14,1:29:45.14,Default,,0,0,0,,Тұрғындардың қайда екені белгісіз 40 ғимарат бар делінген.
Dialogue: 0,1:29:45.14,1:29:48.15,Default,,0,0,0,,(Қашықтан басқару пультінің дыбысы)
Dialogue: 0,1:29:48.15,1:29:51.15,Default,,0,0,0,,Шие гүлдері ше?
Dialogue: 0,1:29:51.15,1:29:53.15,Default,,0,0,0,,Мен тірімін
Dialogue: 0,1:29:56.16,1:29:58.16,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:29:58.16,1:30:01.16,Default,,0,0,0,,Бірдеңе бар ма?
Dialogue: 0,1:30:01.16,1:30:06.17,Default,,0,0,0,,Шиенің денесі гүлдейді, тек сыртқы түрі ғана ұқыпты байланысқан...
Dialogue: 0,1:30:06.17,1:30:09.17,Default,,0,0,0,,Аяқ-қолымдағы бұлшық еттерім үзіліп кетті.
Dialogue: 0,1:30:09.17,1:30:14.17,Default,,0,0,0,,Ол бала бір рет өлді.
Dialogue: 0,1:30:14.17,1:30:17.18,Default,,0,0,0,,Мен мұны кім жасағанын білмеймін, бірақ...
Dialogue: 0,1:30:17.18,1:30:22.18,Default,,0,0,0,,Ауырсыну сіздің денеңізді ғана емес, миыңызды да зақымдауы мүмкін.
Dialogue: 0,1:30:22.18,1:30:28.19,Default,,0,0,0,,Мен Зукен мен сол көлеңкені тезірек жеңемін.
Dialogue: 0,1:30:28.19,1:30:31.19,Default,,0,0,0,,Оған қол жеткізу үшін қолдан келгеннің бәрін жасайық.
Dialogue: 0,1:30:36.20,1:30:40.20,Default,,0,0,0,,Бірақ Ширу
Dialogue: 0,1:30:40.20,1:30:45.14,Default,,0,0,0,,Ішкі мүшелер мен сол қара көлеңке мүлде басқа болса...
Dialogue: 0,1:30:45.14,1:30:48.14,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,1:30:54.15,1:30:57.15,Default,,0,0,0,,(Шодзи жабылған дыбыс)
Dialogue: 0,1:31:00.15,1:31:03.16,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:31:03.16,1:31:07.16,Default,,0,0,0,,Сіз әлі де қалдыңыз ба? Сакура (есік жабылған дыбыс)
Dialogue: 0,1:31:07.16,1:31:11.16,Default,,0,0,0,,Мұндай жанды қайдан алдың?
Dialogue: 0,1:31:11.16,1:31:14.17,Default,,0,0,0,,Әлі Ассасин мен Райдер қалды...
Dialogue: 0,1:31:14.17,1:31:17.17,Default,,0,0,0,,Мен сіздің көңіліңізден шыққаныңызға таң қалдым.
Dialogue: 0,1:31:22.18,1:31:28.18,Default,,0,0,0,,Сакура, бұдан былай саған не болатынын білесің бе?
Dialogue: 0,1:31:28.18,1:31:33.19,Default,,0,0,0,,Мен білмеймін. Не болады? мен
Dialogue: 0,1:31:33.19,1:31:37.19,Default,,0,0,0,,Мен өлемін. Мен ешқашан құтқарылмаймын.
Dialogue: 0,1:31:45.13,1:31:47.13,Default,,0,0,0,,≪(есіктің ашылу дыбысы)
Dialogue: 0,1:31:47.13,1:31:51.14,Default,,0,0,0,,Мен үйдемін! Мен біраз уақытқа оралдым ...
Dialogue: 0,1:31:51.14,1:31:55.14,Default,,0,0,0,,Не? Ширу сонда емес пе?
Dialogue: 0,1:31:57.14,1:31:59.14,Default,,0,0,0,,Кім?
Dialogue: 0,1:32:00.15,1:32:02.15,Default,,0,0,0,,Ммм, мүлде емес...
Dialogue: 0,1:32:02.15,1:32:05.15,Default,,0,0,0,,Ширу қайда кетті?
Dialogue: 0,1:32:05.15,1:32:08.15,Default,,0,0,0,,Сакура-чан қиналғанда
Dialogue: 0,1:32:10.16,1:32:12.16,Default,,0,0,0,,Хмм...
Dialogue: 0,1:32:12.16,1:32:15.16,Default,,0,0,0,,А... жоқ, мәжбүрлеме.
Dialogue: 0,1:32:15.16,1:32:21.17,Default,,0,0,0,,Менің ағам мені қорғайтынын айтты.
Dialogue: 0,1:32:21.17,1:32:25.17,Default,,0,0,0,,О, бірақ...
Dialogue: 0,1:32:25.17,1:32:30.18,Default,,0,0,0,,Кешіріңіз, бұл менің кінәм...
Dialogue: 0,1:32:30.18,1:32:33.18,Default,,0,0,0,,Мен ағаның арманын бұзамын.
Dialogue: 0,1:32:35.18,1:32:37.18,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:32:37.18,1:32:40.19,Default,,0,0,0,,Бұл...
Dialogue: 0,1:32:40.19,1:32:44.19,Default,,0,0,0,,Өйткені мен жаман адаммын
Dialogue: 0,1:32:44.19,1:32:48.13,Default,,0,0,0,,Ширу жамандық жасай алмайтынын айтады.
Dialogue: 0,1:32:48.13,1:32:50.13,Default,,0,0,0,,Дұрыс ұрыса алатын бала.
Dialogue: 0,1:32:50.13,1:32:56.14,Default,,0,0,0,,Сакура-чан да дұрыс емес нәрсені түзеткісі келеді, солай ма?\NЕгер бұл
Dialogue: 0,1:32:56.14,1:32:58.14,Default,,0,0,0,,Иә
Dialogue: 0,1:32:58.14,1:33:01.14,Default,,0,0,0,,болса, онда бәрі жақсы
Dialogue: 0,1:33:01.14,1:33:06.15,Default,,0,0,0,,Оның үстіне Ширудың арманы әділдік жағында, солай емес пе?
Dialogue: 0,1:33:06.15,1:33:09.15,Default,,0,0,0,,Сіз қорғағыңыз келетін адамдар бар екені анық емес.
Dialogue: 0,1:33:09.15,1:33:14.15,Default,,0,0,0,,Бірақ бәрі бірдей...
Dialogue: 0,1:33:14.15,1:33:17.16,Default,,0,0,0,,Ширудың мақсаты Кирицугу болса...
Dialogue: 0,1:33:17.16,1:33:21.16,Default,,0,0,0,,Өйткені, сіз үшін маңызды адамның болғаны дұрыс.
Dialogue: 0,1:33:21.16,1:33:23.16,Default,,0,0,0,,Ах…
Dialogue: 0,1:33:25.16,1:33:30.17,Default,,0,0,0,,Кирицугу да өте ұнады.
Dialogue: 0,1:33:30.17,1:33:34.17,Default,,0,0,0,,Мен осы қалада тұра бастағаннан кейін де—
Dialogue: 0,1:33:34.17,1:33:40.18,Default,,0,0,0,,Кирицугу шетелге талай рет шықты.
Dialogue: 0,1:33:40.18,1:33:44.18,Default,,0,0,0,,Менің денем қозғалмайынша солай болды
Dialogue: 0,1:33:48.12,1:33:52.12,Default,,0,0,0,,Сіз шынымен кездескіңіз келетін адам бар екеніне сенімдімін.
Dialogue: 0,1:33:56.13,1:34:01.13,Default,,0,0,0,,Сіз үшін маңызды адамды көре алмау өте ауыр.
Dialogue: 0,1:34:01.13,1:34:04.13,Default,,0,0,0,,Әділеттің одақтасы болсаң да
Dialogue: 0,1:34:08.14,1:34:10.14,Default,,0,0,0,,Сонымен—
Dialogue: 0,1:34:10.14,1:34:15.14,Default,,0,0,0,,Сакура-чан, Ширудың қасында болшы.
Dialogue: 0,1:34:33.17,1:34:35.17,Default,,0,0,0,,《Сен маған опасыздық жасайсың ба? 》
Dialogue: 0,1:34:42.17,1:34:46.07,Default,,0,0,0,,《Бұрынғы өзіңе опасыздық жасайсың ба? 》
Dialogue: 0,1:34:53.12,1:34:55.12,Default,,0,0,0,,)
Dialogue: 0,1:34:58.12,1:35:00.12,Default,,0,0,0,,()
Dialogue: 0,1:35:01.13,1:35:05.13,Default,,0,0,0,,《Егер сен опасыздық жасасаң...
Dialogue: 0,1:35:05.13,1:35:07.13,Default,,0,0,0,,Сіз...》
Dialogue: 0,1:35:08.13,1:35:10.13,Default,,0,0,0,,)
Dialogue: 0,1:35:15.14,1:35:17.14,Default,,0,0,0,,Ах…
Dialogue: 0,1:35:21.15,1:35:26.15,Default,,0,0,0,,Жоқ, олай болуы мүмкін емес...
Dialogue: 0,1:35:32.16,1:35:36.16,Default,,0,0,0,,≪(Нағыз өлтіруші) Ширу Эмия...
Dialogue: 0,1:35:36.16,1:35:39.17,Default,,0,0,0,,Менде сиқыршы-донодан хабар бар.
Dialogue: 0,1:35:39.17,1:35:54.11,Default,,0,0,0,,♪♪～
Dialogue: 0,1:35:54.11,1:35:58.12,Default,,0,0,0,,Жарайды, мен күткеннен ерте келдің.
Dialogue: 0,1:35:58.12,1:36:01.12,Default,,0,0,0,,Эмиияның шағын петициясы
Dialogue: 0,1:36:01.12,1:36:04.12,Default,,0,0,0,,Сия тас
Dialogue: 0,1:36:04.12,1:36:07.13,Default,,0,0,0,,Мен бір ғана нәрсені айтамын.
Dialogue: 0,1:36:07.13,1:36:10.13,Default,,0,0,0,,Сакураны қазір босатыңыз.
Dialogue: 0,1:36:10.13,1:36:16.13,Default,,0,0,0,,Азаттық... солай айта аласыз ба?
Dialogue: 0,1:36:18.14,1:36:20.14,Default,,0,0,0,,Ширу Эмия —
Dialogue: 0,1:36:20.14,1:36:25.14,Default,,0,0,0,,Бүгін сізге қоңырау шалу себебім жақсылық сұрау еді.
Dialogue: 0,1:36:25.14,1:36:29.14,Default,,0,0,0,,Сол көлеңкені өлтіргеніңді қалаймын.
Dialogue: 0,1:36:31.15,1:36:34.15,Default,,0,0,0,,Бұл сенің досың болуы керек.
Dialogue: 0,1:36:34.15,1:36:36.16,Default,,0,0,0,,(Шинобу) Мұнда тірі қалғандар жоқ сияқты.
Dialogue: 0,1:36:36.16,1:36:40.16,Default,,0,0,0,,Ол затпен байланысуға болады ма?
Dialogue: 0,1:36:40.16,1:36:45.10,Default,,0,0,0,,Мен енді сыртымнан тыныштала алмаймын.
Dialogue: 0,1:36:45.10,1:36:47.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:47.10,1:36:49.10,Default,,0,0,0,,О, бұған дейін...
Dialogue: 0,1:36:49.10,1:36:54.11,Default,,0,0,0,,Мен саған сол көлеңкенің не екенін айтуым керек еді.
Dialogue: 0,1:36:54.11,1:36:57.11,Default,,0,0,0,,Ал, айтайын...
Dialogue: 0,1:36:57.11,1:37:01.11,Default,,0,0,0,,Бұл Қасиетті Граилдың мазмұны.
Dialogue: 0,1:37:01.11,1:37:05.12,Default,,0,0,0,,Қасиетті Граил деп аталатын қақпадан асып түсетін ерік—
Dialogue: 0,1:37:05.12,1:37:08.12,Default,,0,0,0,,Бұл көлеңке.
Dialogue: 0,1:37:08.12,1:37:12.12,Default,,0,0,0,,Көлеңке және... Қақпа...
Dialogue: 0,1:37:12.12,1:37:18.12,Default,,0,0,0,,Мен саған көлеңкені өлтір дедім, бірақ бұл қиын болар еді.
Dialogue: 0,1:37:19.13,1:37:24.13,Default,,0,0,0,,Бірақ сіз қақпаны өлтіре аласыз.
Dialogue: 0,1:37:26.14,1:37:30.14,Default,,0,0,0,,Оны мен және Тохсака қызының бойынан сезінесіз.
Dialogue: 0,1:37:30.14,1:37:33.15,Default,,0,0,0,,Қызметші жай ғана жем
Dialogue: 0,1:37:33.15,1:37:36.15,Default,,0,0,0,,Суда шын мәнінде өз мүмкіндігін көрсететін техникалар бар!
Dialogue: 0,1:37:36.15,1:37:39.15,Default,,0,0,0,,Қасиетті Граилдың фрагментін ендіру—
Dialogue: 0,1:37:39.15,1:37:46.09,Default,,0,0,0,,Мен 10 жыл бойы өсіріп келе жатқан Матудың киелі шөбін кім өлтіре алады...
Dialogue: 0,1:37:46.09,1:37:48.09,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:37:49.09,1:37:53.10,Default,,0,0,0,,Сіз байқаған боларсыз?
Dialogue: 0,1:37:53.10,1:37:56.10,Default,,0,0,0,,Анау мен шие гүлдері ұқсас.
Dialogue: 0,1:37:59.10,1:38:02.11,Default,,0,0,0,,Ах... Жақсы...
Dialogue: 0,1:38:02.11,1:38:06.11,Default,,0,0,0,,Сол жерде тұрған қуыршақ...
Dialogue: 0,1:38:06.11,1:38:09.11,Default,,0,0,0,,Мен сүйген адамның қолында аяқталады.
Dialogue: 0,1:38:09.11,1:38:12.11,Default,,0,0,0,,Бұл сіздің қалауыңыз болуы керек.
Dialogue: 0,1:38:13.12,1:38:15.12,Default,,0,0,0,,Артық уақыт жоқ
Dialogue: 0,1:38:15.12,1:38:18.12,Default,,0,0,0,,Сакураның санасы бос болған кезде—
Dialogue: 0,1:38:18.12,1:38:24.13,Default,,0,0,0,,Бейсаналықтан алынған Қасиетті Граил бетін көрсетеді.
Dialogue: 0,1:38:24.13,1:38:28.13,Default,,0,0,0,,10 жыл бұрынғы апат қайта көрсетіледі
Dialogue: 0,1:38:31.14,1:38:34.14,Default,,0,0,0,,Сакураны құтқарғыңыз келсе—
Dialogue: 0,1:38:34.14,1:38:38.14,Default,,0,0,0,,Қасиетті Граил соғысы аяқталғанша шыдаңыз.
Dialogue: 0,1:38:38.14,1:38:44.15,Default,,0,0,0,,Өткен мысалдарға сүйенсек, оған шамамен 4 күн кетеді.
Dialogue: 0,1:38:44.15,1:38:48.09,Default,,0,0,0,,Ал ше? Сіздің ойыңызша, шие гүлі ұзаққа созылады ма?
Dialogue: 0,1:38:48.09,1:38:52.09,Default,,0,0,0,,Моцу... бұл сөзсіз моцу!
Dialogue: 0,1:38:52.09,1:38:56.10,Default,,0,0,0,,Бірақ басқа адамдар мұны істемейді.
Dialogue: 0,1:38:56.10,1:39:01.10,Default,,0,0,0,,Менің ашкөздігімнен қарным тоқ шығар, бірақ...
Dialogue: 0,1:39:01.10,1:39:06.11,Default,,0,0,0,,Ертең ол қайтадан қозғалады.
Dialogue: 0,1:39:06.11,1:39:13.01,Default,,0,0,0,,Осы қаладағы барлық адамдар толық тамақтанғанша неше күн қажет?
Dialogue: 0,1:39:15.11,1:39:17.12,Default,,0,0,0,,Түсіну
Dialogue: 0,1:39:17.12,1:39:20.12,Default,,0,0,0,,Баршаның жақсылығы үшін жамандық үшін кек алу
Dialogue: 0,1:39:20.12,1:39:25.12,Default,,0,0,0,,Егер сіз Кирицугу Эмиияның мұрагері болғыңыз келсе...
Dialogue: 0,1:39:25.12,1:39:31.12,Default,,0,0,0,,Сакура Мату сенің жауың.
Dialogue: 0,1:39:54.15,1:39:57.15,Default,,0,0,0,,Сакура, сен ояусың ба?
Dialogue: 0,1:40:00.16,1:40:06.16,Default,,0,0,0,,Иә, қайырлы таң, Сенпай.
Dialogue: 0,1:40:08.17,1:41:14.17,Default,,0,0,0,,♪♪～
Dialogue: 0,1:41:14.17,1:41:18.17,Default,,0,0,0,,Бұл шайқас аяқталғанда, Сакура...
Dialogue: 0,1:41:18.17,1:41:21.17,Default,,0,0,0,,Бірдеңе істегіңіз келеді ме?
Dialogue: 0,1:41:21.17,1:41:27.18,Default,,0,0,0,,Хмм, менің ойыма ештеңе келмейді.
Dialogue: 0,1:41:27.18,1:41:32.18,Default,,0,0,0,,Мен сенің ағаң болған жақсы емес деп ойлаймын.
Dialogue: 0,1:41:32.18,1:41:37.19,Default,,0,0,0,,Олай болса бірге бір жерге барайық.
Dialogue: 0,1:41:37.19,1:41:40.19,Default,,0,0,0,,Қайда барғыңыз келеді?
Dialogue: 0,1:41:40.19,1:41:42.19,Default,,0,0,0,,Ах…
Dialogue: 0,1:41:42.19,1:41:48.09,Default,,0,0,0,,Ал, мен шие гүлдерін көргім келеді...
Dialogue: 0,1:41:50.14,1:41:56.14,Default,,0,0,0,,Жарайды, мен уәде беремін.
Dialogue: 0,1:42:10.16,1:42:16.16,Default,,0,0,0,,《Мұздатылған жүрекпен жылы иллюзия жасау》
Dialogue: 0,1:42:16.16,1:42:22.17,Default,,0,0,0,,《Бір күні қыс өтіп, жаңа көктем келгенде...
Dialogue: 0,1:42:22.17,1:42:28.17,Default,,0,0,0,,Шие гүлдерін бірге тамашалайық》
Dialogue: 0,1:42:47.13,1:42:52.13,Default,,0,0,0,,《Иә, көктем келгенде》
Dialogue: 0,1:42:53.13,1:42:56.13,Default,,0,0,0,,)
Dialogue: 0,1:42:58.14,1:43:00.14,Default,,0,0,0,,)
Dialogue: 0,1:43:00.14,1:43:02.14,Default,,0,0,0,,()
Dialogue: 0,1:43:02.14,1:43:06.14,Default,,0,0,0,,)
Dialogue: 0,1:43:06.14,1:43:08.15,Default,,0,0,0,,)
Dialogue: 0,1:43:08.15,1:43:10.15,Default,,0,0,0,,)
Dialogue: 0,1:43:10.15,1:43:14.15,Default,,0,0,0,,)
Dialogue: 0,1:43:14.15,1:43:17.15,Default,,0,0,0,,)
Dialogue: 0,1:43:25.16,1:43:29.17,Default,,0,0,0,,Ой... а... а...
Dialogue: 0,1:43:29.17,1:43:32.17,Default,,0,0,0,,Ааа... аа...
Dialogue: 0,1:43:34.17,1:43:41.18,Default,,0,0,0,,Ух... у... а... а
Dialogue: 0,1:43:41.18,1:43:43.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:43.18,1:44:05.14,Default,,0,0,0,,♪♪～
Dialogue: 0,1:44:05.14,1:44:08.14,Default,,0,0,0,,《Сен маған опасыздық жасайсың ба? 》
Dialogue: 0,1:44:11.14,1:44:16.14,Default,,0,0,0,,О, мен саған опасыздық жасасам да.
Dialogue: 0,1:44:22.15,1:44:24.16,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:44:24.16,1:44:47.11,Default,,0,0,0,,♪♪～
Dialogue: 0,1:44:47.11,1:44:51.12,Default,,0,0,0,,《Рахмет, Сенпай》
Dialogue: 0,1:44:51.12,1:44:54.12,Default,,0,0,0,,《Мен көп нәрсені алдым》
Dialogue: 0,1:44:54.12,1:44:58.12,Default,,0,0,0,,《Рахмет, әпке》
Dialogue: 0,1:44:58.12,1:45:02.13,Default,,0,0,0,,《Мен сені әпке деп атағаныма өте қуаныштымын》
Dialogue: 0,1:45:02.13,1:45:07.13,Default,,0,0,0,,《Рахмет, профессор Фудзимура》
Dialogue: 0,1:45:09.13,1:45:14.13,Default,,0,0,0,,《Кешіріңіз, мен уәдемді орындай алмадым》
Dialogue: 0,1:45:18.14,1:45:20.15,Default,,0,0,0,,Шабандоз —
Dialogue: 0,1:45:20.15,1:45:26.15,Default,,0,0,0,,Менің ағамды өлтірмегеніңіз үшін рахмет.
Dialogue: 0,1:45:28.15,1:45:30.15,Default,,0,0,0,,Сакура…
Dialogue: 0,1:45:34.16,1:45:39.16,Default,,0,0,0,,Бұл команданың соңғы емлесі.
Dialogue: 0,1:45:39.16,1:45:42.16,Default,,0,0,0,,Шабандозды сұрау
Dialogue: 0,1:45:48.11,1:45:52.11,Default,,0,0,0,,《Мен қартты тоқтатамын》
Dialogue: 0,1:45:52.11,1:45:55.11,Default,,0,0,0,,《Тым кеш...
Dialogue: 0,1:45:55.11,1:45:59.11,Default,,0,0,0,,Мен бұдан былай қиындық туғыза алмаймын.
Dialogue: 0,1:46:02.12,1:46:05.12,Default,,0,0,0,,Сакура Қайырлы таң
Dialogue: 0,1:46:05.12,1:46:08.12,Default,,0,0,0,,Не?
Dialogue: 0,1:46:12.13,1:46:16.13,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,1:46:23.14,1:46:25.14,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,1:46:29.68,1:46:32.68,Default,,0,0,0,,Сатқын
Dialogue: 0,1:46:33.32,1:46:36.15,Default,,0,0,0,,Үйге өте кеш келдіңіз, солай емес пе?
Dialogue: 0,1:46:36.74,1:46:39.10,Default,,0,0,0,,Ха…
Dialogue: 0,1:46:42.16,1:46:46.56,Default,,0,0,0,,Мм... Бауырым, мен...
Dialogue: 0,1:46:47.10,1:46:51.10,Default,,0,0,0,,Тек ұстаңыз, иә? Уау
Dialogue: 0,1:46:53.68,1:46:55.76,Default,,0,0,0,,Бұл қауіпті емес.
Dialogue: 0,1:46:58.11,1:47:00.11,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,1:47:05.12,1:47:08.12,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,1:47:08.12,1:47:11.12,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,1:47:11.12,1:47:17.13,Default,,0,0,0,,Хехе, шие гүлдері керемет.
Dialogue: 0,1:47:17.13,1:47:19.13,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,1:47:19.80,1:47:24.62,Default,,0,0,0,,Мүмкін бір күні Тохсаканы кесіп өтерміз?
Dialogue: 0,1:47:25.14,1:47:31.14,Default,,0,0,0,,Не? Бауырым...?
Dialogue: 0,1:47:31.14,1:47:32.36,Default,,0,0,0,,Иә!
Dialogue: 0,1:47:40.78,1:47:43.16,Default,,0,0,0,,Сіз сондай тәкаппарсыз
Dialogue: 0,1:47:44.06,1:47:47.06,Default,,0,0,0,,Бұл менің қуыршағым болса да
Dialogue: 0,1:47:50.84,1:47:54.10,Default,,0,0,0,,《Мен тағы да қателестім》
Dialogue: 0,1:47:54.54,1:47:57.10,Default,,0,0,0,,《Сондықтан саған қорқынышты істер жасалды》
Dialogue: 0,1:47:58.72,1:48:00.11,Default,,0,0,0,,《Жарайды...
Dialogue: 0,1:48:00.70,1:48:05.11,Default,,0,0,0,,Әдеттегідей, сізге сәл шыдамдылық қажет》
Dialogue: 0,1:48:05.92,1:48:10.82,Default,,0,0,0,,《Сабырлы бол, сабырлы бол, сабырлы бол》
Dialogue: 0,1:48:11.12,1:48:12.46,Default,,0,0,0,,)
Dialogue: 0,1:48:13.62,1:48:14.72,Default,,0,0,0,,Бұл көп уақытты алады
Dialogue: 0,1:48:14.84,1:48:16.90,Default,,0,0,0,,Хех хех хех. Пфу.
Dialogue: 0,1:48:18.50,1:48:23.08,Default,,0,0,0,,Маған ұнамайды, мен уже ағама тиесілімін!
Dialogue: 0,1:48:24.13,1:48:29.80,Default,,0,0,0,,Не? Сізді біршама қолға түсірдіңіз!
Dialogue: 0,1:48:30.66,1:48:35.14,Default,,0,0,0,,Маған ұнамайды! (Синджи) Эй! ше! ?
Dialogue: 0,1:48:35.14,1:48:37.80,Default,,0,0,0,,《Неге әрқашан осылай болады?》
Dialogue: 0,1:48:39.14,1:48:41.76,Default,,0,0,0,,《Мен бұл туралы көп ойладым》
Dialogue: 0,1:48:42.15,1:48:45.05,Default,,0,0,0,,《Менің саған көптен бері өшім бар еді》
Dialogue: 0,1:48:46.68,1:48:49.96,Default,,0,0,0,,《Неге мені қоршаған әлем...
Dialogue: 0,1:48:50.58,1:48:55.09,Default,,0,0,0,,Сіз мені қатты жек көресіз деп ойлаймын》
Dialogue: 0,1:48:55.09,1:48:57.10,Default,,0,0,0,,Хе хе... хе
Dialogue: 0,1:48:57.10,1:49:02.10,Default,,0,0,0,,А, мен де Эмиияға айтуым керек.
Dialogue: 0,1:49:02.10,1:49:07.11,Default,,0,0,0,,Осы уақытқа дейін сен маған қанша уақыт жабысып жүрсің?
Dialogue: 0,1:49:08.36,1:49:10.11,Default,,0,0,0,,Қаншалықты лас —
Dialogue: 0,1:49:10.42,1:49:13.11,Default,,0,0,0,,Енді жолдарымызды кесіп өткенімізді көрейік!
Dialogue: 0,1:49:13.11,1:49:16.11,Default,,0,0,0,,Ха!
Dialogue: 0,1:49:17.16,1:49:21.02,Default,,0,0,0,,《Осындай адамдар болмағанын қалаймын》
Dialogue: 0,1:49:23.12,1:49:25.12,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,1:49:31.13,1:49:33.13,Default,,0,0,0,,Хех хех хех. Пфу.
Dialogue: 0,1:49:35.13,1:49:37.14,Default,,0,0,0,,Хаха
Dialogue: 0,1:49:37.14,1:49:40.14,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:49:41.14,1:49:47.14,Default,,0,0,0,,А... аға...
Dialogue: 0,1:49:51.15,1:49:55.15,Default,,0,0,0,,Ааа...
Dialogue: 0,1:50:02.16,1:50:04.16,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,1:50:08.17,1:50:22.18,Default,,0,0,0,,♪♪～
Dialogue: 0,1:50:22.18,1:50:25.18,Default,,0,0,0,,Ах Ах Ах
Dialogue: 0,1:50:25.18,1:50:28.18,Default,,0,0,0,,Ха ха... ха
Dialogue: 0,1:50:31.19,1:50:34.19,Default,,0,0,0,,Ha
Dialogue: 0,1:50:40.20,1:50:43.20,Default,,0,0,0,,Ха ха ха
Dialogue: 0,1:50:43.20,1:50:45.14,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:50:45.14,1:50:48.14,Default,,0,0,0,,Сакура~!
Dialogue: 0,1:50:48.14,1:51:13.16,Default,,0,0,0,,♪♪～
Dialogue: 0,1:51:20.17,1:55:45.06,Default,,0,0,0,,♪♪～
Dialogue: 0,1:55:51.50,1:55:53.11,Default,,0,0,0,,Мен айттым.
