Dialogue: 0,0:49:05.64,0:49:06.26,JPN,NTP,0000,0000,0000,,





Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:09.73,0:01:11.72,JPN,NTP,0000,0000,0000,,Сәлем! Ханымдар мен мырзалар!
Dialogue: 0,0:01:11.83,0:01:14.67,JPN,NTP,0000,0000,0000,,Соңында, кампус фестивалінің ең үлкен тартымдылығы
Dialogue: 0,0:01:14.67,0:01:18.07,JPN,NTP,0000,0000,0000,,Ауыл аруы байқауы…
Dialogue: 0,0:01:18.17,0:01:21.34,JPN,NTP,0000,0000,0000,,—Бұл басталғалы жатыр! Лиз - белбеу - күтіңіз.
Dialogue: 0,0:01:21.44,0:01:24.44,JPN,NTP,0000,0000,0000,,Бұл «Ауыл аруы» байқауын мектебіміз өткізеді...
Dialogue: 0,0:01:24.55,0:01:25.98,JPN,NTP,0000,0000,0000,,Сіз не туралы шатасасыз?
Dialogue: 0,0:01:26.21,0:01:29.67,JPN,NTP,0000,0000,0000,,Мен барлық қалтамдағы ақшамды сіздің патшайымыңызға тігемін
Dialogue: 0,0:01:30.62,0:01:33.71,JPN,NTP,0000,0000,0000,,Егер бәс тігуім керек болса, мен бұны кимес едім.
Dialogue: 0,0:01:34.42,0:01:36.41,JPN,NTP,0000,0000,0000,,Ой! әдемі аяқтар
Dialogue: 0,0:01:36.56,0:01:38.36,JPN,NTP,0000,0000,0000,,Сесили Фэрчайлд!
Dialogue: 0,0:01:38.46,0:01:42.95,JPN,NTP,0000,0000,0000,,Менің ойымша, сіз машина жасау факультетіндегі біреуге соншалықты мейірімді емессіз.
Dialogue: 0,0:01:43.80,0:01:46.27,JPN,NTP,0000,0000,0000,,Сесили, осында кел.
Dialogue: 0,0:01:46.37,0:01:48.84,JPN,NTP,0000,0000,0000,,Мен ставка емеспін!
Dialogue: 0,0:01:49.40,0:01:51.63,JPN,NTP,0000,0000,0000,,Сіз ұсынылдыңыз!
Dialogue: 0,0:01:51.74,0:01:53.21,JPN,NTP,0000,0000,0000,,Мұны Сесилисіз орындаңыз
Dialogue: 0,0:01:53.31,0:01:54.57,JPN,NTP,0000,0000,0000,,Сесили!
Dialogue: 0,0:02:27.68,0:02:30.54,JPN,NTP,0000,0000,0000,,Сіз әскери қызметкерсіз! Сен не істеп жатырсың!
Dialogue: 0,0:02:40.42,0:02:41.79,JPN,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:02:41.89,0:02:44.26,JPN,NTP,0000,0000,0000,,Иә? Діріл болды ма?
Dialogue: 0,0:02:45.36,0:02:47.49,JPN,NTP,0000,0000,0000,,Мен ешқандай жаттығу жасамадым!
Dialogue: 0,0:02:47.60,0:02:49.69,JPN,NTP,0000,0000,0000,,Порттың жағдайын қарастырайық.
Dialogue: 0,0:02:51.33,0:02:52.36,JPN,NTP,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:02:52.47,0:02:53.37,JPN,NTP,0000,0000,0000,,Жау?
Dialogue: 0,0:02:53.47,0:02:54.37,JPN,NTP,0000,0000,0000,,Әскери аймақ!
Dialogue: 0,0:02:54.47,0:02:56.20,JPN,NTP,0000,0000,0000,,Бұл күндері жаулар бар ма?
Dialogue: 0,0:02:56.30,0:02:57.93,JPN,NTP,0000,0000,0000,,Шамасы
Dialogue: 0,0:02:58.71,0:03:02.61,JPN,NTP,0000,0000,0000,,Сесили: Сіз күткен уақыт келді.
Dialogue: 0,0:03:06.35,0:03:08.21,JPN,NTP,0000,0000,0000,,Бұл қауесет рас па?
Менің ойымша,
Dialogue: 0,0:03:08.35,0:03:09.37,JPN,NTP,0000,0000,0000,,...
Dialogue: 0,0:03:09.52,0:03:11.68,JPN,NTP,0000,0000,0000,,Crossbone Vanguard - қарақшылардың аты!
Dialogue: 0,0:03:11.82,0:03:13.98,JPN,NTP,0000,0000,0000,,Бұл сөзсіз бүлік әрекеті!
Dialogue: 0,0:03:14.12,0:03:15.65,JPN,NTP,0000,0000,0000,,Барлық қызметкерлер эвакуациялансын!
Dialogue: 0,0:03:16.22,0:03:20.99,JPN,NTP,0000,0000,0000,,Көтерілісшілер әскері тамаша дайындық жасады! Қарсы тұру мүмкін емес!
Dialogue: 0,0:03:43.28,0:03:48.12,JPN,NTP,0000,0000,0000,,Сәлем! Биылғы ауыл ханшайымы
Dialogue: 0,0:03:48.56,0:03:50.75,JPN,NTP,0000,0000,0000,,Сесили Фэрчайлд!
Dialogue: 0,0:03:50.86,0:03:54.42,JPN,NTP,0000,0000,0000,,Мен? Өйткені, бұл ауыл емес...
Dialogue: 0,0:03:54.53,0:03:57.69,JPN,NTP,0000,0000,0000,,Жақсы! Егер сіз әдемі болсаңыз! Ештене етпейді!
Dialogue: 0,0:03:57.80,0:03:59.93,JPN,NTP,0000,0000,0000,,Шулы! Инженерлік бөлім! ауызыңды жап!
Dialogue: 0,0:04:00.20,0:04:02.03,JPN,NTP,0000,0000,0000,,Бұл Лиздің ағасы емес пе?
Dialogue: 0,0:04:02.14,0:04:03.73,JPN,NTP,0000,0000,0000,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:04:04.27,0:04:09.47,JPN,NTP,0000,0000,0000,,Менде мұндай адамдардың дауысы болғандықтан, менің жалғыз мүмкіндігім - бас тарту...
Dialogue: 0,0:04:09.58,0:04:11.77,JPN,NTP,0000,0000,0000,,Теңіз кітабының бұған еш қатысы жоқ!
Dialogue: 0,0:04:23.96,0:04:25.93,JPN,NTP,0000,0000,0000,,Қандай жылжымалы костюм?
Dialogue: 0,0:04:29.86,0:04:31.86,JPN,NTP,0000,0000,0000,,Берто Сесили
Dialogue: 0,0:04:37.87,0:04:39.00,JPN,NTP,0000,0000,0000,,Жүгіру!
Dialogue: 0,0:04:39.11,0:04:41.08,JPN,NTP,0000,0000,0000,,Уф! Жинап қою!
Dialogue: 0,0:04:44.78,0:04:47.34,JPN,NTP,0000,0000,0000,,Осы жолмен! Оны эвакуациялық капсулаға салыңыз!
Dialogue: 0,0:04:47.88,0:04:50.51,JPN,NTP,0000,0000,0000,,Бұл бала өлді!
Dialogue: 0,0:04:50.65,0:04:53.59,JPN,NTP,0000,0000,0000,,Дороти! Тұру! Мұнда!
Dialogue: 0,0:04:57.49,0:04:59.59,JPN,NTP,0000,0000,0000,,Кеттік, осы жаққа кел!
Dialogue: 0,0:04:59.69,0:05:00.39,JPN,NTP,0000,0000,0000,,Оны енгізіңіз.
Dialogue: 0,0:05:00.50,0:05:02.52,JPN,NTP,0000,0000,0000,,Кешіріңіз, бірақ бұл орын толы.
Dialogue: 0,0:05:02.86,0:05:03.99,JPN,NTP,0000,0000,0000,,Мен үйге бара жатырмын
Dialogue: 0,0:05:04.10,0:05:05.46,JPN,NTP,0000,0000,0000,,Сесили!
Dialogue: 0,0:05:05.57,0:05:07.69,JPN,NTP,0000,0000,0000,,Азаматтарды шұғыл эвакуациялау баспанасына жеткізу
Dialogue: 0,0:05:08.00,0:05:11.53,JPN,NTP,0000,0000,0000,,Бұл Дуайт Кэмри. Мен Камридің екінші командирімін!
Dialogue: 0,0:05:11.64,0:05:14.77,JPN,NTP,0000,0000,0000,,Бұл менің ұлым! Желі өшіп қалды ма?
Dialogue: 0,0:05:36.36,0:05:37.39,JPN,NTP,0000,0000,0000,,Сен!
Dialogue: 0,0:05:37.50,0:05:40.87,JPN,NTP,0000,0000,0000,,Теми! Қозғалма! Ой... аа!
Dialogue: 0,0:05:47.31,0:05:49.67,JPN,NTP,0000,0000,0000,,Бұл соғыс сияқты көрінеді, бірақ бұл шындық.
Dialogue: 0,0:05:49.88,0:05:52.00,JPN,NTP,0000,0000,0000,,Бауырым, маған аман қалған жағдайды бер!
Dialogue: 0,0:05:52.21,0:05:53.01,JPN,NTP,0000,0000,0000,,Ах!
Dialogue: 0,0:05:57.49,0:06:00.01,JPN,NTP,0000,0000,0000,,Анамның ғарыштық колониясы қауіпсіз бе?
Dialogue: 0,0:06:00.15,0:06:03.56,JPN,NTP,0000,0000,0000,,Теледидар Мүлдем жақсы емес Қараңыз! Сен не істеп жатырсың!
Dialogue: 0,0:06:03.66,0:06:04.35,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:06:06.09,0:06:07.62,JPN,NTP,0000,0000,0000,,Бұл жақсы!
Dialogue: 0,0:06:11.50,0:06:12.99,JPN,NTP,0000,0000,0000,,Міне, басталды — басымызбен…
Dialogue: 0,0:06:17.54,0:06:23.24,JPN,NTP,0000,0000,0000,,Менің Crossbone Vanguard жалпы жұртшылыққа ешқандай зиян келтірмейді...
Dialogue: 0,0:06:23.34,0:06:25.61,JPN,NTP,0000,0000,0000,,Әке! Қайтып келмедің бе?
Dialogue: 0,0:06:26.11,0:06:27.21,JPN,NTP,0000,0000,0000,,Шио!
Dialogue: 0,0:06:28.58,0:06:32.52,JPN,NTP,0000,0000,0000,,Біз жалпы халыққа ешқандай зиян келтірмейміз, сондықтан біраз уақытқа...
Dialogue: 0,0:06:32.62,0:06:35.71,JPN,NTP,0000,0000,0000,,Бұл мен анамның көйлегін кигендіктен болды!
Dialogue: 0,0:06:35.86,0:06:37.79,JPN,NTP,0000,0000,0000,,Әкем де әке
Dialogue: 0,0:06:43.33,0:06:47.29,JPN,NTP,0000,0000,0000,,Анам мені тастап кетсе де, өкінемін.
Dialogue: 0,0:06:51.07,0:06:52.63,JPN,NTP,0000,0000,0000,,Балалар
Dialogue: 0,0:07:02.72,0:07:03.58,JPN,NTP,0000,0000,0000,,Үлкен әпке!
Dialogue: 0,0:07:03.72,0:07:04.28,JPN,NTP,0000,0000,0000,,Анам ше?
Dialogue: 0,0:07:04.42,0:07:06.39,JPN,NTP,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,0:07:06.99,0:07:09.51,JPN,NTP,0000,0000,0000,,Ол өртеніп кетеді! Біреу...
Dialogue: 0,0:07:09.66,0:07:10.82,JPN,NTP,0000,0000,0000,,Берто! Ал ана ше?
Dialogue: 0,0:07:10.93,0:07:11.89,JPN,NTP,0000,0000,0000,,Жел соғып тұр
Dialogue: 0,0:07:12.06,0:07:13.46,JPN,NTP,0000,0000,0000,,Ол жоқ!
Dialogue: 0,0:07:14.20,0:07:15.79,JPN,NTP,0000,0000,0000,,Келесі блокқа көшейік!
Dialogue: 0,0:07:18.93,0:07:20.46,JPN,NTP,0000,0000,0000,,- Сесили! Артур!
Dialogue: 0,0:07:20.57,0:07:22.00,JPN,NTP,0000,0000,0000,,Жақсы ма?
Dialogue: 0,0:07:22.10,0:07:24.80,JPN,NTP,0000,0000,0000,,Дороти! Онда жылжымалы костюмдер ұшады!
Dialogue: 0,0:07:24.97,0:07:26.30,JPN,NTP,0000,0000,0000,,Азума!
Dialogue: 0,0:07:27.61,0:07:29.20,JPN,NTP,0000,0000,0000,,Жыламайсың ба?
Dialogue: 0,0:07:29.38,0:07:33.01,JPN,NTP,0000,0000,0000,,Ғарыш колониясының бір жерінде тесік бар ма деп ойлаймын.
Dialogue: 0,0:07:33.11,0:07:34.24,JPN,NTP,0000,0000,0000,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,0:07:34.92,0:07:37.51,JPN,NTP,0000,0000,0000,,Лия, мама сені тауып береді.
Dialogue: 0,0:07:37.65,0:07:40.68,JPN,NTP,0000,0000,0000,,Бұл қандай әскер? Бұл жерде!
Dialogue: 0,0:07:45.73,0:07:47.06,JPN,NTP,0000,0000,0000,,Төмен!
Dialogue: 0,0:08:01.91,0:08:03.34,JPN,NTP,0000,0000,0000,,Осындай жерде!
Dialogue: 0,0:08:09.32,0:08:11.75,JPN,NTP,0000,0000,0000,,Федералдық армия ұрыс алаңын кеңейтуде!
Dialogue: 0,0:08:11.85,0:08:13.98,JPN,NTP,0000,0000,0000,,Сіз әуесқой сияқтысыз!
Dialogue: 0,0:08:22.00,0:08:22.96,JPN,NTP,0000,0000,0000,,Дуайт
Dialogue: 0,0:08:23.46,0:08:25.63,JPN,NTP,0000,0000,0000,,Сенің әкең әскери адам болғандықтан...
Dialogue: 0,0:08:25.90,0:08:28.23,JPN,NTP,0000,0000,0000,,Сэм! Азума! Мен оны сізге жіберемін!
Dialogue: 0,0:08:28.57,0:08:30.87,JPN,NTP,0000,0000,0000,,Әкем әлі қашып кеткен жоқ!
Dialogue: 0,0:08:31.97,0:08:33.27,JPN,NTP,0000,0000,0000,,Дуайт! кел!
Dialogue: 0,0:08:37.35,0:08:38.51,JPN,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:08:42.08,0:08:45.05,JPN,NTP,0000,0000,0000,,Бұл жерде жақсы емес, Дуайт мұнда.
Dialogue: 0,0:08:45.15,0:08:46.28,JPN,NTP,0000,0000,0000,,Мынадай болуы керек
Dialogue: 0,0:08:46.42,0:08:47.22,JPN,NTP,0000,0000,0000,,Бұл рас!
Dialogue: 0,0:08:47.32,0:08:49.48,JPN,NTP,0000,0000,0000,,Мен оны әкемнен естідім, сондықтан сенімдімін.
Dialogue: 0,0:08:50.73,0:08:51.59,JPN,NTP,0000,0000,0000,,Осы жолмен.
Dialogue: 0,0:08:51.69,0:08:52.42,JPN,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:09:03.34,0:09:04.20,JPN,NTP,0000,0000,0000,,Азума!
Dialogue: 0,0:09:10.31,0:09:12.18,JPN,NTP,0000,0000,0000,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:09:14.58,0:09:16.35,JPN,NTP,0000,0000,0000,,Өйткені, бұл мұражай ғой!
Dialogue: 0,0:09:16.48,0:09:17.31,JPN,NTP,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:09:17.52,0:09:19.82,JPN,NTP,0000,0000,0000,,Бұл фойеде.
Dialogue: 0,0:09:22.19,0:09:23.35,JPN,NTP,0000,0000,0000,,Мен тыңдамаймын!
Dialogue: 0,0:09:23.46,0:09:25.55,JPN,NTP,0000,0000,0000,,Сондықтан ешкім келмейді
Dialogue: 0,0:09:25.99,0:09:28.22,JPN,NTP,0000,0000,0000,,Қараңдаршы, менің есте сақтау қабілетім дұрыс.
Dialogue: 0,0:09:32.03,0:09:35.09,JPN,NTP,0000,0000,0000,,Жау келе жатыр... Лиз, артқа тұр! Сэм де!
Dialogue: 0,0:09:42.04,0:09:43.01,JPN,NTP,0000,0000,0000,,Резервуар?
Dialogue: 0,0:09:43.11,0:09:45.48,JPN,NTP,0000,0000,0000,,Бұл танк, бірақ жылжымалы костюм.
Dialogue: 0,0:09:46.21,0:09:47.61,JPN,NTP,0000,0000,0000,,Бұл жерден қозғалма!
Dialogue: 0,0:09:51.32,0:09:53.79,JPN,NTP,0000,0000,0000,,Бұған жеңіл қарама, жұмбақ әскер!
Dialogue: 0,0:09:53.92,0:09:55.25,JPN,NTP,0000,0000,0000,,-Осылай! -Иә!
Dialogue: 0,0:09:55.36,0:09:56.55,JPN,NTP,0000,0000,0000,,Дуайт
Dialogue: 0,0:09:58.29,0:09:59.35,JPN,NTP,0000,0000,0000,,Жолдан кет!
Dialogue: 0,0:09:59.49,0:10:04.30,JPN,NTP,0000,0000,0000,,Бұл жерді қорғауды Рой соғысы мұражайының директоры Рой Юнг өз мойнына алады!
Dialogue: 0,0:10:05.73,0:10:10.80,JPN,NTP,0000,0000,0000,,Не болды? Бұл қаруға әуесқой генерал Рой ма? Уф!
Dialogue: 0,0:10:14.18,0:10:16.37,JPN,NTP,0000,0000,0000,,Хм...мен артқа тартайын!
Dialogue: 0,0:10:16.78,0:10:18.68,JPN,NTP,0000,0000,0000,,Міне, біз тағы да келдік! Апыр-ай!
Dialogue: 0,0:10:20.52,0:10:21.57,JPN,NTP,0000,0000,0000,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:10:21.72,0:10:25.15,JPN,NTP,0000,0000,0000,,- Бұл өзгерген мобильді костюм - Бұл ескі танк.
Dialogue: 0,0:10:25.92,0:10:26.91,JPN,NTP,0000,0000,0000,,балаларды сұрау
Dialogue: 0,0:10:27.86,0:10:29.15,JPN,NTP,0000,0000,0000,,Маған сыртта не бар екені қызық!
Dialogue: 0,0:10:29.26,0:10:30.16,JPN,NTP,0000,0000,0000,,Дороти!
Dialogue: 0,0:10:30.26,0:10:31.66,JPN,NTP,0000,0000,0000,,Бұл баспана.
Dialogue: 0,0:10:33.59,0:10:35.69,JPN,NTP,0000,0000,0000,,Баспанада бөлек телефон желісі болды, солай ма?
Dialogue: 0,0:10:35.93,0:10:38.90,JPN,NTP,0000,0000,0000,,Иә, мүмкін біз әскерилермен байланыса аламыз.
Dialogue: 0,0:10:39.23,0:10:42.10,JPN,NTP,0000,0000,0000,,Азума! Артур! Сен не істеп жатырсың!
Dialogue: 0,0:10:45.71,0:10:48.40,JPN,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:48.84,0:10:50.94,JPN,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:52.18,0:10:55.51,JPN,NTP,0000,0000,0000,,Олар Ұлттық диета ғимаратын осы резервуармен қайтарамыз деп отыр.
Dialogue: 0,0:10:55.65,0:10:58.78,JPN,NTP,0000,0000,0000,,Бұл 10 жылдан астам уақыт бұрын өзгерген мобильді костюм.
Dialogue: 0,0:10:58.92,0:11:00.05,JPN,NTP,0000,0000,0000,,Анно мырза!
Dialogue: 0,0:11:00.59,0:11:03.25,JPN,NTP,0000,0000,0000,,Сіз сыртқы қабырғадағы 24-ші пирсті білесіз бе?
Dialogue: 0,0:11:03.36,0:11:04.32,JPN,NTP,0000,0000,0000,,Ах...
Dialogue: 0,0:11:05.13,0:11:07.46,JPN,NTP,0000,0000,0000,,Босқындарды әскери кеме күтіп тұр.
Dialogue: 0,0:11:07.56,0:11:09.46,JPN,NTP,0000,0000,0000,,Әскери жетекшілер қашып жүр ме?
Dialogue: 0,0:11:09.56,0:11:10.72,JPN,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:14.67,0:11:16.07,JPN,NTP,0000,0000,0000,,Крис! Алға ұмтыл!
Dialogue: 0,0:11:16.17,0:11:17.33,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,0:11:17.64,0:11:20.27,JPN,NTP,0000,0000,0000,,Ғарыштық колония шекарасын қорғау үшін IV
Dialogue: 0,0:11:20.37,0:11:23.17,JPN,NTP,0000,0000,0000,,Мұражайға қаржы алатын жер болмайды!
Dialogue: 0,0:11:23.28,0:11:25.44,JPN,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:25.91,0:11:28.25,JPN,NTP,0000,0000,0000,,Иә! Ол жоғарғы мұқабада.
Dialogue: 0,0:11:28.62,0:11:30.68,JPN,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:30.82,0:11:32.29,JPN,NTP,0000,0000,0000,,Баспанаға кіріңіз!
Dialogue: 0,0:11:32.39,0:11:35.72,JPN,NTP,0000,0000,0000,,-Осындай жерде өлгенше... -Басқыншылықпен күресу керек!
Dialogue: 0,0:11:35.82,0:11:37.79,JPN,NTP,0000,0000,0000,,Неліктен жабылмайды?
Dialogue: 0,0:11:37.89,0:11:39.59,JPN,NTP,0000,0000,0000,,Сіз парламент ғимаратын көре аласыз
Dialogue: 0,0:11:44.50,0:11:46.49,JPN,NTP,0000,0000,0000,,Дәл алдында! Rover!
Dialogue: 0,0:11:54.68,0:11:55.70,JPN,NTP,0000,0000,0000,,Артур
Dialogue: 0,0:11:55.81,0:11:56.74,JPN,NTP,0000,0000,0000,,Бұл ақылға қонымсыз!
Dialogue: 0,0:12:08.22,0:12:10.09,JPN,NTP,0000,0000,0000,,Сэм Артур ше?
Dialogue: 0,0:12:10.19,0:12:13.09,JPN,NTP,0000,0000,0000,,Не? Мен жоғарыда едім, не болды?
Dialogue: 0,0:12:13.19,0:12:14.82,JPN,NTP,0000,0000,0000,,Генерал ше? Не болды?
Dialogue: 0,0:12:14.93,0:12:15.66,JPN,NTP,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:12:15.76,0:12:17.56,JPN,NTP,0000,0000,0000,,Мен баспананы пайдалана алмаймын!
Dialogue: 0,0:12:17.67,0:12:18.63,JPN,NTP,0000,0000,0000,,Генерал Рой!
Dialogue: 0,0:12:18.73,0:12:20.10,JPN,NTP,0000,0000,0000,,Сіз оны пайдалана алмайсыз ба?
Dialogue: 0,0:12:20.30,0:12:21.77,JPN,NTP,0000,0000,0000,,Сіз қашып кетпедіңіз!
Dialogue: 0,0:12:22.74,0:12:24.17,JPN,NTP,0000,0000,0000,,Артурды ұмыт!
Dialogue: 0,0:12:24.27,0:12:25.36,JPN,NTP,0000,0000,0000,,Бірақ...
Dialogue: 0,0:12:26.27,0:12:30.47,JPN,NTP,0000,0000,0000,,Сіз баспанадан ғарыш колониясының сыртқы қабырғасындағы өткелге түсе аласыз.
Dialogue: 0,0:12:30.58,0:12:34.17,JPN,NTP,0000,0000,0000,,Баспанаға шығатын жолды бұзған генерал Рой болды.
Dialogue: 0,0:12:34.28,0:12:38.31,JPN,NTP,0000,0000,0000,,Кәдімгі костюм, оттегі, тамақ жоқ.
Dialogue: 0,0:12:44.33,0:12:48.63,JPN,NTP,0000,0000,0000,,Эй, эй! Артур Артур! Эй!
Dialogue: 0,0:12:49.03,0:12:53.13,JPN,NTP,0000,0000,0000,,Сен мұнда не істеп жүрсің? Эй! Мінеки!
Dialogue: 0,0:12:53.27,0:12:57.29,JPN,NTP,0000,0000,0000,,Қазір әзілдейтін уақыт емес! Артур! Көзіңді аш!
Dialogue: 0,0:12:57.41,0:13:00.07,JPN,NTP,0000,0000,0000,,Сендей адамдар болмаса, бәрі қиыншылықта болар еді!
Dialogue: 0,0:13:00.17,0:13:03.77,JPN,NTP,0000,0000,0000,,Тоқтатпа, мен жеңілдетуім керек...
Dialogue: 0,0:13:04.31,0:13:10.68,JPN,NTP,0000,0000,0000,,Өйткені бұл Артур... Уф... Уф...
Dialogue: 0,0:13:13.62,0:13:15.42,JPN,NTP,0000,0000,0000,,Азума-кун!
Dialogue: 0,0:13:16.12,0:13:17.65,JPN,NTP,0000,0000,0000,,Сол резервуарда қашу...
Dialogue: 0,0:13:17.79,0:13:18.76,JPN,NTP,0000,0000,0000,,Теңіз кітабы...
Dialogue: 0,0:13:19.76,0:13:22.09,JPN,NTP,0000,0000,0000,,Анно мырза, бәріміз кеттік.
Dialogue: 0,0:13:22.20,0:13:23.32,JPN,NTP,0000,0000,0000,,Бару...
Dialogue: 0,0:13:23.43,0:13:26.03,JPN,NTP,0000,0000,0000,,Сенің де қарындасың бар!
Dialogue: 0,0:13:26.93,0:13:30.06,JPN,NTP,0000,0000,0000,,Мен білемін, мен білемін ...
Dialogue: 0,0:13:33.17,0:13:39.14,JPN,NTP,0000,0000,0000,,Бірақ бұл не? Екі армия керемет жұмыс істеп жатыр!
Dialogue: 0,0:13:40.21,0:13:43.74,JPN,NTP,0000,0000,0000,,Үлкен кісіге ыңғайлы болу үшін өлтіруге бола ма?
Dialogue: 0,0:13:55.03,0:13:56.09,JPN,NTP,0000,0000,0000,,Қызым-ау—
Dialogue: 0,0:13:56.20,0:13:57.36,JPN,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:57.47,0:13:58.36,JPN,NTP,0000,0000,0000,,Бұл жібек.
Dialogue: 0,0:13:58.47,0:14:00.30,JPN,NTP,0000,0000,0000,,Теңіз кітабының жылдамдығы Бұл жылдам емес пе?
Dialogue: 0,0:14:00.40,0:14:03.37,JPN,NTP,0000,0000,0000,,Үдеткіш дұрыс оралмайды. Бұл Федерация күштері!
Dialogue: 0,0:14:04.77,0:14:06.00,JPN,NTP,0000,0000,0000,,Тоқта!
Dialogue: 0,0:14:07.98,0:14:12.31,JPN,NTP,0000,0000,0000,,Уау! Хмм...сендер!
Dialogue: 0,0:14:12.41,0:14:13.85,JPN,NTP,0000,0000,0000,,Өте алмайсыз ба?
Dialogue: 0,0:14:13.95,0:14:16.58,JPN,NTP,0000,0000,0000,,Дұрыс! Мына жігіттерді пайдаланыңыз!
Dialogue: 0,0:14:16.92,0:14:19.55,JPN,NTP,0000,0000,0000,,Егер сіз шайқасқыңыз келсе, бізбен бірге болыңыз!
Dialogue: 0,0:14:19.69,0:14:22.99,JPN,NTP,0000,0000,0000,,Біз жай ғана 24-планға барғымыз келеді.
Dialogue: 0,0:14:23.09,0:14:25.49,JPN,NTP,0000,0000,0000,,Әй, бұл не болды!
Dialogue: 0,0:14:30.36,0:14:31.59,JPN,NTP,0000,0000,0000,,Ауырды
Dialogue: 0,0:14:31.70,0:14:32.60,JPN,NTP,0000,0000,0000,,Не!
Dialogue: 0,0:14:32.70,0:14:35.10,JPN,NTP,0000,0000,0000,,Біз жауды осы жерде ұстауымыз керек!
Dialogue: 0,0:14:35.47,0:14:37.20,JPN,NTP,0000,0000,0000,,Барлығыңыз, шегініңіздер!
Dialogue: 0,0:14:39.31,0:14:44.04,JPN,NTP,0000,0000,0000,,Балаңды қалқан етіп алсаң, жау шаппайды! Тоқта!
Dialogue: 0,0:14:44.25,0:14:45.30,JPN,NTP,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:14:45.41,0:14:46.47,JPN,NTP,0000,0000,0000,,Үлкен аға
Dialogue: 0,0:14:57.83,0:15:00.66,JPN,NTP,0000,0000,0000,,Баланы қалқан ретінде пайдалансаңыз ше? Бұл рас па?
Dialogue: 0,0:15:01.06,0:15:02.82,JPN,NTP,0000,0000,0000,,Баланы нокаутқа түсіріңіз!
Dialogue: 0,0:15:05.20,0:15:06.86,JPN,NTP,0000,0000,0000,,Келме, Келме!
Dialogue: 0,0:15:06.97,0:15:07.99,JPN,NTP,0000,0000,0000,,Тоқта!
Dialogue: 0,0:15:08.37,0:15:10.80,JPN,NTP,0000,0000,0000,,Сіз қарсы тұрасыз ба? Түсіріңіз!
Dialogue: 0,0:15:11.51,0:15:13.77,JPN,NTP,0000,0000,0000,,Менің айтқым келгені бұл емес!
Dialogue: 0,0:15:16.11,0:15:18.24,JPN,NTP,0000,0000,0000,,Тек аяқты жойыңыз!
Dialogue: 0,0:15:18.35,0:15:19.97,JPN,NTP,0000,0000,0000,,Енді сіздің дауысыңыз қандай...
Dialogue: 0,0:15:20.35,0:15:21.78,JPN,NTP,0000,0000,0000,,Құлағыңызды жабыңыз!
Dialogue: 0,0:15:21.92,0:15:22.97,JPN,NTP,0000,0000,0000,,Сіз мұны істейсіз бе?
Dialogue: 0,0:15:33.93,0:15:35.76,JPN,NTP,0000,0000,0000,,Сіз қайда қашуды жоспарлап отырсыз?
Dialogue: 0,0:15:35.86,0:15:39.42,JPN,NTP,0000,0000,0000,,Әке, 24-присте кеме қалды.
Dialogue: 0,0:15:39.53,0:15:41.50,JPN,NTP,0000,0000,0000,,Келесі бұрышта солға жүріңіз
Dialogue: 0,0:15:42.24,0:15:43.46,JPN,NTP,0000,0000,0000,,Ағай
Dialogue: 0,0:15:43.90,0:15:46.46,JPN,NTP,0000,0000,0000,,Кешіріңіз, бәрі осы ма? Сэм
Dialogue: 0,0:15:46.67,0:15:48.97,JPN,NTP,0000,0000,0000,,Артур жеңілді...
Dialogue: 0,0:15:49.08,0:15:50.98,JPN,NTP,0000,0000,0000,,Ах! шу
Dialogue: 0,0:15:53.75,0:15:55.44,JPN,NTP,0000,0000,0000,,Мәңгі жыламайсың ба?
Dialogue: 0,0:15:55.58,0:15:57.28,JPN,NTP,0000,0000,0000,,Мигеннің көзқарасы
Dialogue: 0,0:15:57.75,0:16:00.72,JPN,NTP,0000,0000,0000,,Минералды су және қоюландырылған сүт...сондықтан...
Dialogue: 0,0:16:00.86,0:16:03.52,JPN,NTP,0000,0000,0000,,Қараңызшы, бұл емізік емес.
Dialogue: 0,0:16:05.06,0:16:09.39,JPN,NTP,0000,0000,0000,,Емшек ішетін қыздар бар ма? Оң жақтағы мылтық ыдысын пайдалануға болады.
Dialogue: 0,0:16:09.50,0:16:10.43,JPN,NTP,0000,0000,0000,,О, расымен бе?
Dialogue: 0,0:16:10.53,0:16:11.76,JPN,NTP,0000,0000,0000,,Сол жақта.
Dialogue: 0,0:16:11.87,0:16:15.17,JPN,NTP,0000,0000,0000,,Анамның маған қалдырып кеткені шырылдап тұрған сияқты...
Dialogue: 0,0:16:15.40,0:16:17.30,JPN,NTP,0000,0000,0000,,Теңіз кітабы! Сіз өте аласыз ба?
Dialogue: 0,0:16:17.40,0:16:19.24,JPN,NTP,0000,0000,0000,,Барлығын ұстаңыз
Dialogue: 0,0:16:25.58,0:16:27.27,JPN,NTP,0000,0000,0000,,Мына лифт жұмыс істеп тұрған сияқты.
Dialogue: 0,0:16:27.55,0:16:28.45,JPN,NTP,0000,0000,0000,,Ол қозғалады ма?
Dialogue: 0,0:16:28.58,0:16:29.55,JPN,NTP,0000,0000,0000,,Ах!
Dialogue: 0,0:16:29.85,0:16:32.18,JPN,NTP,0000,0000,0000,,Сэм, сенде кәдімгі костюм жоқ, солай ма?
Dialogue: 0,0:16:32.29,0:16:34.65,JPN,NTP,0000,0000,0000,,Тірі қалған жағдайда оттегі маскасы аз...
Dialogue: 0,0:16:35.22,0:16:38.12,JPN,NTP,0000,0000,0000,,Доротидің әкесі пристанда жатыр ма?
Dialogue: 0,0:16:38.23,0:16:40.72,JPN,NTP,0000,0000,0000,,Мен телефон соққанда әлі барлау бюросында едім.
Dialogue: 0,0:16:41.33,0:16:44.96,JPN,NTP,0000,0000,0000,,Азума-кун, сенің мұнда қалыпты костюмің жоқ па?
Dialogue: 0,0:16:45.07,0:16:47.73,JPN,NTP,0000,0000,0000,,Бұл лифт көліктерге арналған.
Dialogue: 0,0:16:47.84,0:16:48.56,JPN,NTP,0000,0000,0000,,Сонымен...
Dialogue: 0,0:16:48.67,0:16:50.53,JPN,NTP,0000,0000,0000,,Ол пирсте болуы керек.
Dialogue: 0,0:16:51.54,0:16:53.97,JPN,NTP,0000,0000,0000,,Құлағымның шырылдауы азайды...
Dialogue: 0,0:16:55.88,0:17:00.25,JPN,NTP,0000,0000,0000,,Әке, сыртта қалай болды? Кроссбоне авангард деп аталатын әскер.
Dialogue: 0,0:17:00.45,0:17:04.58,JPN,NTP,0000,0000,0000,,Хм, мен соғыс кемесінің жақындап келе жатқанын естідім...
Dialogue: 0,0:17:08.59,0:17:10.06,JPN,NTP,0000,0000,0000,,Жоғарыдағы баспана қауіпсіз!
Dialogue: 0,0:17:10.79,0:17:12.76,JPN,NTP,0000,0000,0000,,Қалыпты костюм қайда!
Dialogue: 0,0:17:15.53,0:17:17.50,JPN,NTP,0000,0000,0000,,Қазір қайда бара жатырсың?
Dialogue: 0,0:17:17.73,0:17:19.79,JPN,NTP,0000,0000,0000,,Кеме кетіп қалды.
Dialogue: 0,0:17:20.40,0:17:21.23,JPN,NTP,0000,0000,0000,,Ағай!
Dialogue: 0,0:17:21.34,0:17:24.30,JPN,NTP,0000,0000,0000,,Хмм, бұл бір қабат төмен!
Dialogue: 0,0:17:25.04,0:17:27.97,JPN,NTP,0000,0000,0000,,Кем дегенде бір ғарыш кемесі болуы керек.
Dialogue: 0,0:17:31.51,0:17:32.50,JPN,NTP,0000,0000,0000,,Сіз барасыз ба?
Dialogue: 0,0:17:32.61,0:17:34.08,JPN,NTP,0000,0000,0000,,Оны тоқтатайық
Dialogue: 0,0:17:34.18,0:17:35.15,JPN,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:17:38.39,0:17:42.88,JPN,NTP,0000,0000,0000,,Миновский бөлшектерінің арқасында Сесилиді ұстауға біраз уақыт кетті.
Dialogue: 0,0:17:43.12,0:17:46.12,JPN,NTP,0000,0000,0000,,Жаңа ғана үлкен жігіттер қашып кетті.
Dialogue: 0,0:17:46.43,0:17:49.26,JPN,NTP,0000,0000,0000,,Мен көрші III шекараға қашуым керек пе? Ой!
Dialogue: 0,0:17:58.37,0:17:59.93,JPN,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:18:28.37,0:18:32.53,JPN,NTP,0000,0000,0000,,Бұл сөзсіз, өйткені бейбіт тұрғындар біздің болашақ әскери күшімізге айналады.
Dialogue: 0,0:18:32.64,0:18:35.94,JPN,NTP,0000,0000,0000,,Дегенмен, үш жеган түрі болды.
Dialogue: 0,0:18:36.04,0:18:39.14,JPN,NTP,0000,0000,0000,,Түсінемін, бірақ амалсыз қашатын адамдар қорқынышты.
Dialogue: 0,0:18:39.25,0:18:41.58,JPN,NTP,0000,0000,0000,,Мен құтқарылу үшін не қажет болса, соны істеймін.
Dialogue: 0,0:18:41.68,0:18:42.34,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,0:18:42.48,0:18:44.68,JPN,NTP,0000,0000,0000,,Тергеу сақтықпен жалғасуда.
Dialogue: 0,0:18:44.82,0:18:45.61,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,0:18:45.75,0:18:46.72,JPN,NTP,0000,0000,0000,,Чип… Чип, чип!
Dialogue: 0,0:18:57.20,0:18:58.63,JPN,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:18:58.73,0:19:01.72,JPN,NTP,0000,0000,0000,,Сіз лифт жарылғанына алаңдайсыз ба?
Dialogue: 0,0:19:01.84,0:19:04.33,JPN,NTP,0000,0000,0000,,Сэм, әкеңмен тезірек кел.
Dialogue: 0,0:19:04.44,0:19:05.41,JPN,NTP,0000,0000,0000,,О!
Dialogue: 0,0:19:05.51,0:19:06.30,JPN,NTP,0000,0000,0000,,Мен де барамын!
Dialogue: 0,0:19:06.47,0:19:07.77,JPN,NTP,0000,0000,0000,,Жақсы!
Dialogue: 0,0:19:09.54,0:19:10.74,JPN,NTP,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:19:10.84,0:19:12.40,JPN,NTP,0000,0000,0000,,Мен білемін
Dialogue: 0,0:19:14.52,0:19:15.61,JPN,NTP,0000,0000,0000,,Мені жылатпа
Dialogue: 0,0:19:15.75,0:19:17.65,JPN,NTP,0000,0000,0000,,Сіз істеп жатырсыз!
Dialogue: 0,0:19:17.75,0:19:19.78,JPN,NTP,0000,0000,0000,,Азума, келе жатырсың ба?
Dialogue: 0,0:19:20.15,0:19:22.68,JPN,NTP,0000,0000,0000,,Кейбір жағдайларда сырты мазасыз болып көрінеді.
Dialogue: 0,0:19:22.82,0:19:26.12,JPN,NTP,0000,0000,0000,,Сіз отырғанша қорқатын ештеңе жоқ.
Dialogue: 0,0:19:26.96,0:19:27.86,JPN,NTP,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:19:27.96,0:19:29.19,JPN,NTP,0000,0000,0000,,Кешіріңізші!
Dialogue: 0,0:19:29.26,0:19:30.99,JPN,NTP,0000,0000,0000,,Дуайт Сіз мұны істей аласыз ба?
Dialogue: 0,0:19:31.10,0:19:33.16,JPN,NTP,0000,0000,0000,,Осы сияқты нәрсе көлікпен бірдей емес пе?
Dialogue: 0,0:19:33.30,0:19:38.47,JPN,NTP,0000,0000,0000,,Мен қалжыңдаған жоқпын, біз бір рет жаттығу жасадық.
Dialogue: 0,0:19:38.91,0:19:40.84,JPN,NTP,0000,0000,0000,,люкті әлі аша алмайсыз ба?
Dialogue: 0,0:19:42.14,0:19:43.73,JPN,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:19:43.84,0:19:44.64,JPN,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:19:45.68,0:19:49.38,JPN,NTP,0000,0000,0000,,Сол жақта сіздің алдыңызда байланыс желісінің қосқышы бар.
Dialogue: 0,0:19:49.52,0:19:52.18,JPN,NTP,0000,0000,0000,,«Тері жанасу сызығы»
Dialogue: 0,0:19:52.35,0:19:56.88,JPN,NTP,0000,0000,0000,,Қуат өшірілді, бірақ палуба люкін қолмен ашуға болады.
Dialogue: 0,0:19:57.16,0:19:59.13,JPN,NTP,0000,0000,0000,,Ағаң не істейді?
Dialogue: 0,0:19:59.23,0:20:00.49,JPN,NTP,0000,0000,0000,,Барлығын бортқа отырғызыңыз!
Dialogue: 0,0:20:00.59,0:20:01.58,JPN,NTP,0000,0000,0000,,Ах...
Dialogue: 0,0:20:01.70,0:20:03.09,JPN,NTP,0000,0000,0000,,Сіз бірден кете аласыз.
Dialogue: 0,0:20:05.87,0:20:06.66,JPN,NTP,0000,0000,0000,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:20:06.77,0:20:07.76,JPN,NTP,0000,0000,0000,,(азаматтардың қошемет шапалақтары)
Dialogue: 0,0:20:07.87,0:20:08.77,JPN,NTP,0000,0000,0000,,Мен білмеймін!
Dialogue: 0,0:20:09.27,0:20:11.00,JPN,NTP,0000,0000,0000,,Сесили дегеніміз не?
Dialogue: 0,0:20:11.11,0:20:12.16,JPN,NTP,0000,0000,0000,,Барма!
Dialogue: 0,0:20:12.61,0:20:14.67,JPN,NTP,0000,0000,0000,,Достарыңызды ұмытыңыз.
Dialogue: 0,0:20:15.71,0:20:19.08,JPN,NTP,0000,0000,0000,,Не істеп жатырсың! Келесіде мылтық атсаң, мен сені атамын!
Dialogue: 0,0:20:20.05,0:20:23.07,JPN,NTP,0000,0000,0000,,Аузыңды жап! Ата-ана мен бала мәселесіне араласпаңыз!
Dialogue: 0,0:20:24.18,0:20:27.62,JPN,NTP,0000,0000,0000,,Ата-аналар... ата-аналар балаларына мылтық тақты!
Dialogue: 0,0:20:27.72,0:20:28.69,JPN,NTP,0000,0000,0000,,Шулы!
Dialogue: 0,0:20:30.09,0:20:31.08,JPN,NTP,0000,0000,0000,,Сен!
Dialogue: 0,0:20:33.53,0:20:35.02,JPN,NTP,0000,0000,0000,,Тоқтаңыз!
Dialogue: 0,0:20:37.83,0:20:38.76,JPN,NTP,0000,0000,0000,,Неге?! Неге?!
Dialogue: 0,0:20:41.57,0:20:42.43,JPN,NTP,0000,0000,0000,,Барма!
Dialogue: 0,0:20:42.54,0:20:45.94,JPN,NTP,0000,0000,0000,,Неге! сен менің досымды атып алдың
Dialogue: 0,0:20:46.04,0:20:49.13,JPN,NTP,0000,0000,0000,,Анаңыздың сырғасы болуының мағынасын ойлаңыз.
Dialogue: 0,0:20:49.24,0:20:51.21,JPN,NTP,0000,0000,0000,,Бүгін ерекше күн!
Dialogue: 0,0:20:53.28,0:20:54.11,JPN,NTP,0000,0000,0000,,Теңіз кітабы!
Dialogue: 0,0:20:54.21,0:20:55.98,JPN,NTP,0000,0000,0000,,Сесили, жоқ!
Dialogue: 0,0:20:57.75,0:20:59.18,JPN,NTP,0000,0000,0000,,Жоқ!
Dialogue: 0,0:21:00.89,0:21:01.95,JPN,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:21:22.24,0:21:23.50,JPN,NTP,0000,0000,0000,,Лорд Дрелл?
Dialogue: 0,0:21:23.61,0:21:27.94,JPN,NTP,0000,0000,0000,,Бұл ойлағандай болмады, Тео Фэрчайлд.
Dialogue: 0,0:21:28.08,0:21:29.28,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,0:21:30.28,0:21:32.08,JPN,NTP,0000,0000,0000,,Ол қыз менің әпкем.
Dialogue: 0,0:21:37.39,0:21:43.23,JPN,NTP,0000,0000,0000,,Қорықпа. Жақында ағаңыз сізді үйге қайтарады.
Dialogue: 0,0:21:45.10,0:21:49.30,JPN,NTP,0000,0000,0000,,Үйге қайтасыз ба? неге? Неліктен?
Dialogue: 0,0:21:49.40,0:21:52.40,JPN,NTP,0000,0000,0000,,Менің ойымша, сіз Рона отбасына керексіз.
Dialogue: 0,0:21:52.51,0:21:56.34,JPN,NTP,0000,0000,0000,,Мен тек атамның өсиетін орындап жатырмын.
Dialogue: 0,0:21:56.44,0:21:58.93,JPN,NTP,0000,0000,0000,,Мен? Ата?
Dialogue: 0,0:21:59.05,0:22:02.35,JPN,NTP,0000,0000,0000,,Бұл әлі қауіпсіз емес. Асығыңыз.
Dialogue: 0,0:22:04.18,0:22:05.38,JPN,NTP,0000,0000,0000,,Дорел Рона?
Dialogue: 0,0:22:05.52,0:22:06.58,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:22:07.05,0:22:09.52,JPN,NTP,0000,0000,0000,,Бірақ мен анамның рұқсатын алуым керек.
Dialogue: 0,0:22:09.89,0:22:11.38,JPN,NTP,0000,0000,0000,,Не айту керек
Dialogue: 0,0:22:11.53,0:22:14.49,JPN,NTP,0000,0000,0000,,Анаңның қашып кетуіне мүмкіндік берген Шиоға рахмет.
Dialogue: 0,0:22:14.60,0:22:17.46,JPN,NTP,0000,0000,0000,,Ол әлі хабарсыз.
Dialogue: 0,0:22:17.63,0:22:20.10,JPN,NTP,0000,0000,0000,,Анаңды іздеу
Dialogue: 0,0:22:20.20,0:22:23.26,JPN,NTP,0000,0000,0000,,Crossbone Vanguard тобына қосылу ақылдырақ болар еді.
Dialogue: 0,0:22:23.47,0:22:26.84,JPN,NTP,0000,0000,0000,,Ол үшін...үйге қайту...
Dialogue: 0,0:22:31.01,0:22:34.64,JPN,NTP,0000,0000,0000,,Тыныштанған соң, тілегіңді орындайық.
Dialogue: 0,0:22:35.15,0:22:38.68,JPN,NTP,0000,0000,0000,,Рона отбасы ата-анасының алғысын ешқашан ұмытпайды!
Dialogue: 0,0:22:39.12,0:22:40.09,JPN,NTP,0000,0000,0000,,Хаха!
Dialogue: 0,0:23:01.98,0:23:03.27,JPN,NTP,0000,0000,0000,,Үлкен аға!
Dialogue: 0,0:23:04.68,0:23:06.15,JPN,NTP,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:23:06.75,0:23:09.31,JPN,NTP,0000,0000,0000,,Лиз: қайшы және дезинфекциялаушы.
Dialogue: 0,0:23:11.79,0:23:14.88,JPN,NTP,0000,0000,0000,,Сіз не істеп жатырсыз? Барлығы отырады!
Dialogue: 0,0:23:16.69,0:23:18.49,JPN,NTP,0000,0000,0000,,Сэм, сенің әкең кім?
Dialogue: 0,0:23:18.59,0:23:20.99,JPN,NTP,0000,0000,0000,,Ол люкті ашуға бұрылды.
Dialogue: 0,0:23:21.09,0:23:22.89,JPN,NTP,0000,0000,0000,,Түсіндім! Уф!
Dialogue: 0,0:23:24.63,0:23:29.13,JPN,NTP,0000,0000,0000,,Барлығың қауіпсіздік белдіктерін тақыңдар. Азума, мен сені көре алмаймын.
Dialogue: 0,0:23:29.30,0:23:30.93,JPN,NTP,0000,0000,0000,,Аа, оны маған қалдырыңыз.
Dialogue: 0,0:23:31.14,0:23:33.07,JPN,NTP,0000,0000,0000,,Жақында ашылады, Азума-кун.
Dialogue: 0,0:23:33.17,0:23:34.77,JPN,NTP,0000,0000,0000,,Иә! Өтінемін
Dialogue: 0,0:23:35.31,0:23:37.07,JPN,NTP,0000,0000,0000,,Люкке дейін көтеріңіз
Dialogue: 0,0:23:37.18,0:23:38.64,JPN,NTP,0000,0000,0000,,Қазір ерте.
Dialogue: 0,0:23:38.75,0:23:40.98,JPN,NTP,0000,0000,0000,,-Дұрыс істе... -Ауырып тұр-!
Dialogue: 0,0:23:54.39,0:23:56.26,JPN,NTP,0000,0000,0000,,Ағай!
Dialogue: 0,0:24:06.74,0:24:08.71,JPN,NTP,0000,0000,0000,,Мұны тыныш орындаңыз!
Dialogue: 0,0:24:08.91,0:24:10.14,JPN,NTP,0000,0000,0000,,Сабырлы болыңыз!
Dialogue: 0,0:24:10.24,0:24:11.68,JPN,NTP,0000,0000,0000,,Біз істеп жатырмыз!
Dialogue: 0,0:24:17.48,0:24:21.15,JPN,NTP,0000,0000,0000,,Қараңдар! Біздің қала осылай өртеніп жатыр
Dialogue: 0,0:24:22.82,0:24:25.76,JPN,NTP,0000,0000,0000,,6000 метр биіктіктен ештеңе айта алмайсың.
Dialogue: 0,0:24:25.86,0:24:29.82,JPN,NTP,0000,0000,0000,,Бұл түтін жолағы колониядағы тесік емес пе?
Dialogue: 0,0:24:39.97,0:24:40.96,JPN,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:24:41.07,0:24:42.77,JPN,NTP,0000,0000,0000,,Колонияда тесік бар!
Dialogue: 0,0:24:44.48,0:24:45.78,JPN,NTP,0000,0000,0000,,Сізге шабуыл жасалып жатыр ма?
Dialogue: 0,0:25:04.97,0:25:08.56,JPN,NTP,0000,0000,0000,,Өз-өзіңе қол жұмсамаймын десең де сол жердесің бе?
Dialogue: 0,0:25:08.67,0:25:14.61,JPN,NTP,0000,0000,0000,,Иә, мен Белла Ронаны әкеңмен және атаңмен таныстырмайынша.
Dialogue: 0,0:25:15.88,0:25:20.90,JPN,NTP,0000,0000,0000,,Мен Белла Рона емес, Сесили Фэрчайлмын
Dialogue: 0,0:25:21.01,0:25:22.24,JPN,NTP,0000,0000,0000,,Мұнда рух бар.
Dialogue: 0,0:25:22.38,0:25:27.82,JPN,NTP,0000,0000,0000,,Сіз космо аристократияны жақтайтын Рона отбасының үлкен қызысыз.
Dialogue: 0,0:25:27.95,0:25:31.75,JPN,NTP,0000,0000,0000,,Мен сіздердің бізден төмендердің үстемдік етуіне үйренгеніңізді қалаймын.
Dialogue: 0,0:25:31.86,0:25:35.45,JPN,NTP,0000,0000,0000,,Бұл да тектілердің міндеті.
Dialogue: 0,0:25:35.56,0:25:36.53,JPN,NTP,0000,0000,0000,,Міндеттеме?
Dialogue: 0,0:25:36.63,0:25:37.56,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:25:41.84,0:25:43.20,JPN,NTP,0000,0000,0000,,Сіз бұған ауысқыңыз келе ме?
Dialogue: 0,0:25:43.30,0:25:43.93,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:25:44.04,0:25:46.44,JPN,NTP,0000,0000,0000,,Жарайды, мен өзім жасаймын.
Dialogue: 0,0:25:46.54,0:25:48.94,JPN,NTP,0000,0000,0000,,Жоқ, мен саған көмектесемін.
Dialogue: 0,0:25:51.61,0:25:53.17,JPN,NTP,0000,0000,0000,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:26:00.75,0:26:03.19,JPN,NTP,0000,0000,0000,,Күздің ортасы ғана болса да
Dialogue: 0,0:26:03.29,0:26:06.09,JPN,NTP,0000,0000,0000,,Иә, біздің әуе шабуылына байланысты.
Dialogue: 0,0:26:06.19,0:26:09.36,JPN,NTP,0000,0000,0000,,Ауа райы компьютері дұрыс жұмыс істемейді деген қауесет бар.
Dialogue: 0,0:26:09.46,0:26:10.66,JPN,NTP,0000,0000,0000,,Бұл өтірік емес
Dialogue: 0,0:28:00.84,0:28:06.80,JPN,NTP,0000,0000,0000,,О, аман бол, Белла, үйіңе оралуыңмен құттықтаймын.
Dialogue: 0,0:28:10.92,0:28:16.41,JPN,NTP,0000,0000,0000,,Сен сондай болғаның үшін, тіпті анаңның да саған соншалықты мейірбан болғанын түсінбейсің бе?
Dialogue: 0,0:28:16.56,0:28:20.93,JPN,NTP,0000,0000,0000,,Менің мұны істеуден басқа амалым қалмады...
Dialogue: 0,0:28:28.20,0:28:31.83,JPN,NTP,0000,0000,0000,,Тіпті анаммен бірге ер адам қашып кетті...
Dialogue: 0,0:28:31.94,0:28:34.37,JPN,NTP,0000,0000,0000,,Құрметті Белла Рона, өтінемін
Dialogue: 0,0:28:35.24,0:28:38.21,JPN,NTP,0000,0000,0000,,Әке сені күтіп отыр.
Dialogue: 0,0:28:44.35,0:28:49.15,JPN,NTP,0000,0000,0000,,Көріп отырғаныңыздай, сырттағы шайқас әлі басылған жоқ, бірақ жиі келіп тұрады...
Dialogue: 0,0:28:49.26,0:28:50.52,JPN,NTP,0000,0000,0000,,Белла!
Dialogue: 0,0:28:51.99,0:28:56.29,JPN,NTP,0000,0000,0000,,Бұл дауысты есте сақтау керек. Бұл мен. Бұл Кароццо.
Dialogue: 0,0:28:56.40,0:28:59.02,JPN,NTP,0000,0000,0000,,Олай болса, масканы шешіңіз.
Dialogue: 0,0:29:00.23,0:29:05.69,JPN,NTP,0000,0000,0000,,Мен әйелімді сол жігітке жоғалтқан аянышты адаммын, оның үстіне,
Dialogue: 0,0:29:05.81,0:29:10.40,JPN,NTP,0000,0000,0000,,Майза – Мен де атамның мұратын жүзеге асыруға ант еттім.
Dialogue: 0,0:29:10.51,0:29:17.68,JPN,NTP,0000,0000,0000,,Содан бері мен осындай болдым, өйткені мен өзімнің осал менмен күресе бастадым.
Dialogue: 0,0:29:18.05,0:29:23.46,JPN,NTP,0000,0000,0000,,Өзің айтқандай, қайсарлығың – әкең екені сөзсіз.
Dialogue: 0,0:29:23.56,0:29:26.39,JPN,NTP,0000,0000,0000,,Бірақ мен сенің мінезіңді қабылдай алмаймын.
Dialogue: 0,0:29:26.49,0:29:30.90,JPN,NTP,0000,0000,0000,,Неліктен анам ажырасудан басқа амалымыз болмағанын мойындай алмайды?
Dialogue: 0,0:29:31.00,0:29:34.36,JPN,NTP,0000,0000,0000,,Надядан көп естіген сияқтымын.
Dialogue: 0,0:29:34.90,0:29:38.60,JPN,NTP,0000,0000,0000,,Мен осылай мәңгі қалуды жоспарламаймын.
Dialogue: 0,0:29:38.84,0:29:41.31,JPN,NTP,0000,0000,0000,,Негізі мен Шионы кешіремін.
Dialogue: 0,0:29:41.41,0:29:45.47,JPN,NTP,0000,0000,0000,,Мен сені шыдай алмаған ұятпен кездестірдім.
Dialogue: 0,0:29:45.91,0:29:48.47,JPN,NTP,0000,0000,0000,,Сол үшін сізге бұл маска керек пе?
Dialogue: 0,0:29:48.58,0:29:50.14,JPN,NTP,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:29:54.05,0:29:57.05,JPN,NTP,0000,0000,0000,,Космо Вавилония құрылысы аяқталғанға дейін.
Dialogue: 0,0:29:57.19,0:30:01.32,JPN,NTP,0000,0000,0000,,Мен бұл масканы шешпеймін деп ант бердім. Өтінемін, мені кешірші.
Dialogue: 0,0:30:01.96,0:30:05.02,JPN,NTP,0000,0000,0000,,Космо Вавилония? Бұл не?
Dialogue: 0,0:30:05.47,0:30:11.63,JPN,NTP,0000,0000,0000,,Біздің Рона отбасымыздың 1000 жылдық арманы – адамзатты мәңгілік тірі қалдыру
Dialogue: 0,0:30:11.81,0:30:12.79,JPN,NTP,0000,0000,0000,,Сіз жақсысыз ба?
Dialogue: 0,0:30:13.74,0:30:19.08,JPN,NTP,0000,0000,0000,,10 жыл болды. Атаң да сенімен кездескісі келеді. Мен сізге айналаны көрсетуге рұқсат етіңіз.
Dialogue: 0,0:30:19.18,0:30:21.81,JPN,NTP,0000,0000,0000,,Сіз IV шекарадасыз ба?
Dialogue: 0,0:30:21.92,0:30:25.21,JPN,NTP,0000,0000,0000,,Енді бұл колония IV шекара емес.
Dialogue: 0,0:30:25.42,0:30:28.01,JPN,NTP,0000,0000,0000,,Вавилон Космо Вавилон
Dialogue: 0,0:30:54.05,0:30:56.24,JPN,NTP,0000,0000,0000,,Сізге кім қоңырау шалды?
Dialogue: 0,0:30:57.18,0:31:00.41,JPN,NTP,0000,0000,0000,,Космо Вавилония құрылысы аяқталғанға дейін
Dialogue: 0,0:31:00.52,0:31:03.79,JPN,NTP,0000,0000,0000,,Мен сенің менің ханшайым болғаныңды қалаймын.
Dialogue: 0,0:31:03.89,0:31:05.72,JPN,NTP,0000,0000,0000,,Королеваны ойнағың келе ме?
Dialogue: 0,0:31:06.36,0:31:10.13,JPN,NTP,0000,0000,0000,,Көпшілік үнемі пұттарды талап етеді.
Dialogue: 0,0:31:10.73,0:31:15.33,JPN,NTP,0000,0000,0000,,Қалаға шығып, қиыншылықты үйренсең, сенде пұтқа айналдыратын қасиет бар.
Dialogue: 0,0:31:15.44,0:31:18.77,JPN,NTP,0000,0000,0000,,Бұл... үлкен қателік.
Dialogue: 0,0:31:19.77,0:31:22.40,JPN,NTP,0000,0000,0000,,Бұл менің қолымнан келетін нәрсе емес.
Dialogue: 0,0:31:22.54,0:31:29.28,JPN,NTP,0000,0000,0000,,Иә? Жоқ, мен алға ұмтылуға өте қуаныштымын. Өтінемін, мені кешір, Белла.
Dialogue: 0,0:31:29.42,0:31:34.22,JPN,NTP,0000,0000,0000,,Ата... менің өзімшілдігімді кешіріңіз.
Dialogue: 0,0:31:41.59,0:31:46.09,JPN,NTP,0000,0000,0000,,Қанның осыншама мөлшерімен біз мұнда отырған адамның өлгеніне сенімді бола алмаймыз, солай ма?
Dialogue: 0,0:31:46.27,0:31:49.26,JPN,NTP,0000,0000,0000,,Мұнда да көп ұрыс болған сияқты.
Dialogue: 0,0:31:49.37,0:31:52.36,JPN,NTP,0000,0000,0000,,Біздің әскерилердің екі жылжымалы костюмі де бүлінген.
Dialogue: 0,0:31:52.47,0:31:55.17,JPN,NTP,0000,0000,0000,,Ал ауаның шығуы әлі де жалғасуда.
Dialogue: 0,0:31:56.11,0:31:57.20,JPN,NTP,0000,0000,0000,,Асығыңыз
Dialogue: 0,0:31:57.31,0:31:59.01,JPN,NTP,0000,0000,0000,,Мен білемін
Dialogue: 0,0:32:03.95,0:32:09.45,JPN,NTP,0000,0000,0000,,Теңіз кітабы Не істеуім керек?
Dialogue: 0,0:32:17.90,0:32:22.43,JPN,NTP,0000,0000,0000,,Шекара жағындағы Федерацияның барлық кемелері II шекараға шығарылады.
Dialogue: 0,0:32:22.54,0:32:26.16,JPN,NTP,0000,0000,0000,,Иә, бірақ біз оларды жеңуіміз уақыт мәселесі.
Dialogue: 0,0:32:26.27,0:32:30.77,JPN,NTP,0000,0000,0000,,Иә, бірақ енді бізде ғарыш колониясын тазалау міндеті тұр.
Dialogue: 0,0:32:30.88,0:32:32.28,JPN,NTP,0000,0000,0000,,White Sox шықты
Dialogue: 0,0:32:32.38,0:32:34.61,JPN,NTP,0000,0000,0000,,О! Мұнда келіп өлме!
Dialogue: 0,0:32:34.71,0:32:36.15,JPN,NTP,0000,0000,0000,,Әрине!
Dialogue: 0,0:32:56.57,0:33:00.53,JPN,NTP,0000,0000,0000,,Колонияны оның жанында негізгі қозғалтқышты жарып, жоймаңыз!
Dialogue: 0,0:33:00.64,0:33:04.67,JPN,NTP,0000,0000,0000,,Бұл колония Космо Вавилонияның жаңа жеріне айналады.
Dialogue: 0,0:33:04.78,0:33:05.84,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,0:33:07.28,0:33:09.01,JPN,NTP,0000,0000,0000,,Сол Colony Corporation жігіттері де.
Dialogue: 0,0:33:09.15,0:33:13.61,JPN,NTP,0000,0000,0000,,Бізбен ешқашан араласпаңыз. Біздің жалғыз жауымыз – Жер Федерациясының күштері.
Dialogue: 0,0:33:14.45,0:33:15.51,JPN,NTP,0000,0000,0000,,Міне, басталды!
Dialogue: 0,0:33:19.29,0:33:21.99,JPN,NTP,0000,0000,0000,,Жауынгерлік капитан! Апыр-ай!
Dialogue: 0,0:33:38.88,0:33:40.47,JPN,NTP,0000,0000,0000,,Қаш! барлығы!
Dialogue: 0,0:33:44.22,0:33:45.68,JPN,NTP,0000,0000,0000,,Бұл картоп.
Dialogue: 0,0:33:46.19,0:33:47.12,JPN,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:33:47.72,0:33:48.91,JPN,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:33:49.79,0:33:51.31,JPN,NTP,0000,0000,0000,,Бұл Федерацияның әскери кемесі.
Dialogue: 0,0:33:51.46,0:33:52.22,JPN,NTP,0000,0000,0000,,Сүйегім сынды!
Dialogue: 0,0:33:57.20,0:34:03.19,JPN,NTP,0000,0000,0000,,You guys! Мұнда ауырлық бар, уау! Мұндай нәрсе...
Dialogue: 0,0:34:04.17,0:34:05.50,JPN,NTP,0000,0000,0000,,Қолдарыңызбен ұшыңыз!
Dialogue: 0,0:34:05.61,0:34:06.63,JPN,NTP,0000,0000,0000,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:34:09.01,0:34:11.34,JPN,NTP,0000,0000,0000,,Мануэла Керемет!
Dialogue: 0,0:34:11.44,0:34:14.44,JPN,NTP,0000,0000,0000,,Crossbone Vanguard жекпе-жек алдында осындай нәрсе
Dialogue: 0,0:34:14.65,0:34:15.94,JPN,NTP,0000,0000,0000,,Өлгенше ұрып-соғуға болмайды!
Dialogue: 0,0:34:16.08,0:34:21.42,JPN,NTP,0000,0000,0000,,Сіз айтқандай, отставкадағы офицер, нұсқаушы ұшқыш енді ғана кетіп қалды.
Dialogue: 0,0:34:21.52,0:34:24.18,JPN,NTP,0000,0000,0000,,Сержанттар да, офицерлер де зениттік ұрыста қалады.
Dialogue: 0,0:34:24.29,0:34:28.25,JPN,NTP,0000,0000,0000,,Бұл кемені I шекараға әкелген жалғыз біз болсақ та...
Dialogue: 0,0:34:28.36,0:34:32.56,JPN,NTP,0000,0000,0000,,Сондықтан мен бұл оқу-жаттығу кемесін қарсыласу фракциясының базасы ретінде пайдаланамын деп айтып отырмын!
Dialogue: 0,0:34:32.67,0:34:37.13,JPN,NTP,0000,0000,0000,,Жақын арада жаулар келеді, сондықтан F91 қолданыңыз! Түсіндім!
Dialogue: 0,0:34:37.24,0:34:38.33,JPN,NTP,0000,0000,0000,,Қай жағынан!
Dialogue: 0,0:34:38.44,0:34:40.43,JPN,NTP,0000,0000,0000,,Қарсылықты осында шақырыңыз!
Dialogue: 0,0:34:44.91,0:34:47.64,JPN,NTP,0000,0000,0000,,Иә? Не? сендер жігіттер
Dialogue: 0,0:34:47.75,0:34:50.48,JPN,NTP,0000,0000,0000,,Егер қашуға уақыт болса, сол ғарыш доғасына барып, шайқас!
Dialogue: 0,0:34:50.62,0:34:52.08,JPN,NTP,0000,0000,0000,,Барлығы балаларға қатысты.
Dialogue: 0,0:34:52.62,0:34:55.82,JPN,NTP,0000,0000,0000,,Егер сіз бұл қайықты басқара алсаңыз, сіз соғыса аласыз! Бар!
Dialogue: 0,0:34:55.92,0:34:59.02,JPN,NTP,0000,0000,0000,,Сәлем! Мен төменге түсемін!
Dialogue: 0,0:34:59.79,0:35:01.23,JPN,NTP,0000,0000,0000,,Онда!
Dialogue: 0,0:35:03.20,0:35:04.09,JPN,NTP,0000,0000,0000,,Жарайды!
Dialogue: 0,0:35:11.17,0:35:12.23,JPN,NTP,0000,0000,0000,,Теңіз кітабы!
Dialogue: 0,0:35:20.41,0:35:21.40,JPN,NTP,0000,0000,0000,,Жарайды!
Dialogue: 0,0:35:21.51,0:35:22.88,JPN,NTP,0000,0000,0000,,Leah! Жіберу!
Dialogue: 0,0:35:23.02,0:35:23.57,JPN,NTP,0000,0000,0000,,Өте…
Dialogue: 0,0:35:23.72,0:35:24.74,JPN,NTP,0000,0000,0000,,Жабу!
Dialogue: 0,0:35:25.62,0:35:26.81,JPN,NTP,0000,0000,0000,,Кешіріңізші!
Dialogue: 0,0:35:29.12,0:35:30.09,JPN,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:35:30.22,0:35:32.62,JPN,NTP,0000,0000,0000,,Жоқ, Доротидің қолдары жылдам еді.
Dialogue: 0,0:35:32.73,0:35:33.69,JPN,NTP,0000,0000,0000,,Fluke Fluke
Dialogue: 0,0:35:33.83,0:35:36.59,JPN,NTP,0000,0000,0000,,Бірақ енді сіз кемені осылай жасыра алмайсыз ба?
Dialogue: 0,0:35:36.70,0:35:39.06,JPN,NTP,0000,0000,0000,,Алыстан қарасаң, тасқа немесе ағашқа ұқсайды.
Dialogue: 0,0:35:39.17,0:35:40.13,JPN,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:35:40.30,0:35:42.73,JPN,NTP,0000,0000,0000,,Тамақтанып болған соң мына жерді де жабыңыз!
Dialogue: 0,0:35:42.84,0:35:45.86,JPN,NTP,0000,0000,0000,,Мен іште жұмыс істеп жатырмын, сондықтан ешқандай жарықтың ағып кетуін қаламаймын.
Dialogue: 0,0:35:45.97,0:35:46.80,JPN,NTP,0000,0000,0000,,—Түсінікті—Иә!
Dialogue: 0,0:35:46.91,0:35:47.96,JPN,NTP,0000,0000,0000,,Ха! Сержант-майор Нант Рус!
Dialogue: 0,0:35:48.37,0:35:49.67,JPN,NTP,0000,0000,0000,,Көңіл көтерме!
Dialogue: 0,0:35:49.94,0:35:51.41,JPN,NTP,0000,0000,0000,,Балаларыңызды дұрыс тәртіпке келтіріңіздер!
Dialogue: 0,0:35:51.51,0:35:52.84,JPN,NTP,0000,0000,0000,,Менің балам емес
Dialogue: 0,0:35:53.75,0:35:55.21,JPN,NTP,0000,0000,0000,,Ас үшін рахмет
Dialogue: 0,0:35:55.98,0:35:56.97,JPN,NTP,0000,0000,0000,,Теңіз кітабы!
Dialogue: 0,0:35:57.12,0:36:00.05,JPN,NTP,0000,0000,0000,,Once the wound has closed, you don't have to hang it anymore.
Dialogue: 0,0:36:00.19,0:36:01.59,JPN,NTP,0000,0000,0000,,Біраз ауырады.
Dialogue: 0,0:36:01.69,0:36:03.92,JPN,NTP,0000,0000,0000,,Мен өлмеймін.
Dialogue: 0,0:36:04.42,0:36:08.29,JPN,NTP,0000,0000,0000,,Капитан Лаогэйр міндетін атқарушы! Жарайды ма?
Dialogue: 0,0:36:08.46,0:36:12.99,JPN,NTP,0000,0000,0000,,I'm tired because I suddenly took over the helm and entered this colony.
Dialogue: 0,0:36:13.10,0:36:14.46,JPN,NTP,0000,0000,0000,,Жерден.
Dialogue: 0,0:36:14.57,0:36:17.37,JPN,NTP,0000,0000,0000,,Аа, бастық демалыста.
Dialogue: 0,0:36:17.47,0:36:20.84,JPN,NTP,0000,0000,0000,,Ah, Frontier Side is a new multi-tenant colony, right?
Dialogue: 0,0:36:21.27,0:36:23.71,JPN,NTP,0000,0000,0000,,Мас адамдар арасындағы төбелес сияқты.
Dialogue: 0,0:36:23.71,0:36:25.51,JPN,NTP,0000,0000,0000,,Ол жайғасқанша күтемін, көремін.
Dialogue: 0,0:36:25.71,0:36:28.48,JPN,NTP,0000,0000,0000,,Не! Бұл ресми пікір болса...
Dialogue: 0,0:36:28.58,0:36:31.31,JPN,NTP,0000,0000,0000,,Crossbone Vanguard әзіл ме?
Dialogue: 0,0:36:34.82,0:36:38.15,JPN,NTP,0000,0000,0000,,Ей, біздің колонияның бұл қалашығы.
Dialogue: 0,0:36:38.26,0:36:42.06,JPN,NTP,0000,0000,0000,,Мен бұл өте классикалық болуы керек деп ойладым.
Dialogue: 0,0:36:42.16,0:36:45.10,JPN,NTP,0000,0000,0000,,I felt like I understood when Crossbone Vanguard came.
Dialogue: 0,0:36:45.20,0:36:46.43,JPN,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:36:47.77,0:36:52.47,JPN,NTP,0000,0000,0000,,Федералдық үкімет, Колония корпорациясы және т.б. Crossbone Vanguard
Dialogue: 0,0:36:52.57,0:36:54.67,JPN,NTP,0000,0000,0000,,I wonder if there are people who are gurus?
Dialogue: 0,0:36:54.77,0:36:56.24,JPN,NTP,0000,0000,0000,,Сіз мұны айта аласыз.
Dialogue: 0,0:36:56.34,0:36:57.64,JPN,NTP,0000,0000,0000,,Ол әдемі!
Dialogue: 0,0:36:58.81,0:37:03.41,JPN,NTP,0000,0000,0000,,Brother, take this to Mr. Gurus who maintains mobile suits.
Dialogue: 0,0:37:03.55,0:37:04.57,JPN,NTP,0000,0000,0000,,Хмм!
Dialogue: 0,0:37:08.49,0:37:10.92,JPN,NTP,0000,0000,0000,,Мен сізге түн жарымында тамақ әкелдім, Гурус мырза.
Dialogue: 0,0:37:11.09,0:37:12.39,JPN,NTP,0000,0000,0000,,Оны сол жерде қалдырыңыз
Dialogue: 0,0:37:12.49,0:37:14.55,JPN,NTP,0000,0000,0000,,Жерден хабар естідіңіз бе?
Dialogue: 0,0:37:14.66,0:37:20.33,JPN,NTP,0000,0000,0000,,People on Earth know that Crossbones won't attack Earth.
Dialogue: 0,0:37:21.47,0:37:22.46,JPN,NTP,0000,0000,0000,,Оларға мұқият қарап тұр.
Dialogue: 0,0:37:22.57,0:37:23.69,JPN,NTP,0000,0000,0000,,Техникалық қызмет көрсету жөніндегі нұсқаулық.
Dialogue: 0,0:37:24.00,0:37:25.03,JPN,NTP,0000,0000,0000,,Бұл ма?
Dialogue: 0,0:37:25.14,0:37:28.84,JPN,NTP,0000,0000,0000,,Ах, F91 де жақсы прототип.
Dialogue: 0,0:37:28.94,0:37:31.60,JPN,NTP,0000,0000,0000,,Once you go out, you have to redo everything.
Dialogue: 0,0:37:31.71,0:37:33.98,JPN,NTP,0000,0000,0000,,Is it a handwritten manual on a word processor?
Dialogue: 0,0:37:34.08,0:37:36.05,JPN,NTP,0000,0000,0000,,Беттер де толық емес.
Dialogue: 0,0:37:36.18,0:37:38.51,JPN,NTP,0000,0000,0000,,Иә? Маған қалыпты көрсетіңіз
Dialogue: 0,0:37:38.65,0:37:39.62,JPN,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:37:39.75,0:37:40.91,JPN,NTP,0000,0000,0000,,Бұл менің анам
Dialogue: 0,0:37:41.05,0:37:42.18,JPN,NTP,0000,0000,0000,,Доктор Анно?
Dialogue: 0,0:37:42.32,0:37:43.35,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:37:44.32,0:37:48.05,JPN,NTP,0000,0000,0000,,He said he wanted to do bio-computer research and left home.
Dialogue: 0,0:37:48.16,0:37:51.72,JPN,NTP,0000,0000,0000,,After all, what I was doing was helping with the development of mobile suits.
Dialogue: 0,0:37:51.96,0:37:52.99,JPN,NTP,0000,0000,0000,,Міне!
Dialogue: 0,0:37:53.10,0:37:58.50,JPN,NTP,0000,0000,0000,,Егер сіз ата-ана мен бала болсаңыз, мұнда доктор Анно не айтып тұрғанын түсінбейсіз бе?
Dialogue: 0,0:37:58.60,0:38:01.57,JPN,NTP,0000,0000,0000,,Мұндай қиын нәрсені түсіну мүмкін емес!
Dialogue: 0,0:38:02.18,0:38:05.94,JPN,NTP,0000,0000,0000,,Менің әпкем туралы үндемеңіз! Мен мұндай нәрсе бар екеніне сене алмаймын
Dialogue: 0,0:38:30.54,0:38:32.03,JPN,NTP,0000,0000,0000,,Ысырманы жабыңыз!
Dialogue: 0,0:38:32.14,0:38:33.66,JPN,NTP,0000,0000,0000,,Жауынгерлік көпірге барыңыз!
Dialogue: 0,0:38:34.04,0:38:36.34,JPN,NTP,0000,0000,0000,,Жылжымалы костюм бөлімі, өтінемін!
Dialogue: 0,0:38:36.44,0:38:37.93,JPN,NTP,0000,0000,0000,,30 градус төмен бұрылыңыз
Dialogue: 0,0:38:38.98,0:38:43.94,JPN,NTP,0000,0000,0000,,The generals of Crossbone Vanguard should be in the government office or guesthouse. Онда барыңыз.
Dialogue: 0,0:38:44.08,0:38:47.58,JPN,NTP,0000,0000,0000,,Бұл аймақта мыңдаған босқындар лагерін қамтыған болуы мүмкін.
Dialogue: 0,0:38:47.72,0:38:51.49,JPN,NTP,0000,0000,0000,,If the war ends with that much damage, it's cheap!
Dialogue: 0,0:39:04.27,0:39:05.60,JPN,NTP,0000,0000,0000,,Әскери-теңіз күштерінің атысы!
Dialogue: 0,0:39:05.71,0:39:08.67,JPN,NTP,0000,0000,0000,,Қонақ үйді нысанаға алған шығар!
Dialogue: 0,0:39:12.91,0:39:14.11,JPN,NTP,0000,0000,0000,,Құрметті Белла Рона
Dialogue: 0,0:39:14.21,0:39:16.81,JPN,NTP,0000,0000,0000,,Жарықты сөндір, таң атқан.
Dialogue: 0,0:39:16.95,0:39:18.14,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:39:19.25,0:39:21.72,JPN,NTP,0000,0000,0000,,Біздің аяқ астынан ғарыштан шабуыл...
Dialogue: 0,0:39:22.66,0:39:23.64,JPN,NTP,0000,0000,0000,,Ешқандай ауытқу жоқ.
Dialogue: 0,0:39:23.79,0:39:25.52,JPN,NTP,0000,0000,0000,,It's better not to be near the Rona family!
Dialogue: 0,0:39:25.63,0:39:26.96,JPN,NTP,0000,0000,0000,,Анашым! Анашым!
Dialogue: 0,0:39:27.06,0:39:30.03,JPN,NTP,0000,0000,0000,,Қалаға бетпе-бет кіріңіз! Осындай жерде біз федералды армияны нысанаға алып жатырмыз...
Dialogue: 0,0:39:30.13,0:39:31.99,JPN,NTP,0000,0000,0000,,Уа, мәртебелі!
Dialogue: 0,0:39:32.30,0:39:33.89,JPN,NTP,0000,0000,0000,,(Жибрил) Мен бұны Мәстер үшін дайындадым—
Dialogue: 0,0:39:34.00,0:39:37.73,JPN,NTP,0000,0000,0000,,тым кеш, Белла, әлі қашуға дайындалып жатқан жоқ.
Dialogue: 0,0:39:37.84,0:39:39.63,JPN,NTP,0000,0000,0000,,Өйткені мұндай шабуыл
Dialogue: 0,0:39:39.74,0:39:43.00,JPN,NTP,0000,0000,0000,,Дайын болуға уақытыңыз болмауы мүмкін, сондықтан...
Dialogue: 0,0:39:43.11,0:39:46.14,JPN,NTP,0000,0000,0000,,Кейде сіз мұны сәттілікке қалдырасыз...
Dialogue: 0,0:39:48.31,0:39:54.22,JPN,NTP,0000,0000,0000,,That's right... There are times in life when you can predict your future in this way.
Dialogue: 0,0:39:54.32,0:39:57.35,JPN,NTP,0000,0000,0000,,Келесі жарқ еткен жарық менің аяғымның астынан шықты.
Dialogue: 0,0:39:57.52,0:40:01.08,JPN,NTP,0000,0000,0000,,Сіз мені және сіздің денеңізді буландыра аласыз.
Dialogue: 0,0:40:01.19,0:40:03.25,JPN,NTP,0000,0000,0000,,Өтінемін кешір мені, Белла...
Dialogue: 0,0:40:03.36,0:40:05.16,JPN,NTP,0000,0000,0000,,Жоқ…
Dialogue: 0,0:40:05.90,0:40:09.63,JPN,NTP,0000,0000,0000,,Мен анам Рона әулетінен қашқаннан бері мұндайға үйреніп қалғанмын.
Dialogue: 0,0:40:09.74,0:40:12.17,JPN,NTP,0000,0000,0000,,Осылай айтсаң ыстық.
Dialogue: 0,0:40:12.27,0:40:14.93,JPN,NTP,0000,0000,0000,,Even when we made a surprise attack on this colony.
Dialogue: 0,0:40:15.04,0:40:19.14,JPN,NTP,0000,0000,0000,,The Crossbone Vanguard did not touch civilians at all.
Dialogue: 0,0:40:19.25,0:40:22.18,JPN,NTP,0000,0000,0000,,And yet the soldiers of the Federation do this.
Dialogue: 0,0:40:22.28,0:40:25.74,JPN,NTP,0000,0000,0000,,This is the reality of a military based on absolute democracy.
Dialogue: 0,0:40:25.89,0:40:31.08,JPN,NTP,0000,0000,0000,,Without any reason, I react to the slight change in front of me.
Dialogue: 0,0:40:31.72,0:40:35.18,JPN,NTP,0000,0000,0000,,You mean the results after the civil revolution...?
Dialogue: 0,0:40:35.29,0:40:36.59,JPN,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:40:38.06,0:40:40.97,JPN,NTP,0000,0000,0000,,Approximately when humans started living in space
Dialogue: 0,0:40:41.07,0:40:45.06,JPN,NTP,0000,0000,0000,,Бұл жер табиғатының жойылуын төлеуге арналған.
Dialogue: 0,0:40:45.17,0:40:49.63,JPN,NTP,0000,0000,0000,,This is how life in a space colony becomes a daily routine.
Dialogue: 0,0:40:49.74,0:40:52.84,JPN,NTP,0000,0000,0000,,Humans have begun to return to Earth again.
Dialogue: 0,0:40:53.61,0:40:56.98,JPN,NTP,0000,0000,0000,,Бұл тек федералды үкіметтегі үлкен адамдар.
Dialogue: 0,0:40:57.12,0:41:00.71,JPN,NTP,0000,0000,0000,,Азаматтардың Жерге оралуына рұқсат етілмейді.
Dialogue: 0,0:41:01.59,0:41:02.75,JPN,NTP,0000,0000,0000,,Isn't it cold?
Dialogue: 0,0:41:02.89,0:41:03.88,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:41:08.09,0:41:09.58,JPN,NTP,0000,0000,0000,,Іс тынышталған сияқты ма?
Dialogue: 0,0:41:10.20,0:41:13.03,JPN,NTP,0000,0000,0000,,Ah, your father Carozzo trained me.
Dialogue: 0,0:41:13.13,0:41:15.97,JPN,NTP,0000,0000,0000,,Crossbone Vanguard - бұл үлкен мәселе.
Dialogue: 0,0:41:16.07,0:41:17.30,JPN,NTP,0000,0000,0000,,Оның әкесі...
Dialogue: 0,0:41:17.40,0:41:22.34,JPN,NTP,0000,0000,0000,,Дегенмен, Жерді қалпына келтіру үшін орасан көп уақыт қажет болады.
Dialogue: 0,0:41:22.44,0:41:27.54,JPN,NTP,0000,0000,0000,,Адамзат болашақта бұл ғаламды өзінің мәңгілік мекеніне айналдыруы керек.
Dialogue: 0,0:41:27.65,0:41:28.51,JPN,NTP,0000,0000,0000,,Иә...
Dialogue: 0,0:41:28.75,0:41:32.21,JPN,NTP,0000,0000,0000,,Жерге оралғандарға қарамастан
Dialogue: 0,0:41:32.35,0:41:36.81,JPN,NTP,0000,0000,0000,,Ғарышта қалғандарды тастап кету саясатын жүзеге асырғанымызға көп уақыт болды.
Dialogue: 0,0:41:36.96,0:41:41.79,JPN,NTP,0000,0000,0000,,Бірақ сіз айтқан ақсүйектер болса да, кемсітушілік әлі де болады.
Dialogue: 0,0:41:41.89,0:41:45.30,JPN,NTP,0000,0000,0000,,Асыл адамның атқаратын белгілі бір міндеттері бар.
Dialogue: 0,0:41:45.40,0:41:46.37,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:41:46.47,0:41:51.99,JPN,NTP,0000,0000,0000,,Мысалы, ұрыс даласында қарапайым адамдар қорқып, қашып кетті деп айта алады, бірақ
Dialogue: 0,0:41:52.10,0:41:54.27,JPN,NTP,0000,0000,0000,,Асыл адам Асыл адам
Dialogue: 0,0:41:54.37,0:41:59.21,JPN,NTP,0000,0000,0000,,Қан төгуден қорықпа, көш бастау керек
Dialogue: 0,0:41:59.31,0:42:01.54,JPN,NTP,0000,0000,0000,,Адамдар тең емес пе?
Dialogue: 0,0:42:01.91,0:42:06.37,JPN,NTP,0000,0000,0000,,Адам құқығы тең, бірақ екі бірдей адам болмайды.
Dialogue: 0,0:42:06.52,0:42:10.25,JPN,NTP,0000,0000,0000,,Ең бастысы, адамзат пен әлемді билеуші
Dialogue: 0,0:42:10.36,0:42:15.69,JPN,NTP,0000,0000,0000,,Өз қанын төгуден қорықпайтын асыл адам басқарсын.
Dialogue: 0,0:42:15.80,0:42:21.50,JPN,NTP,0000,0000,0000,,Кішкентай кезімде сіз маған осындай оқиғаларды көп айттыңыз.
Dialogue: 0,0:42:22.27,0:42:26.10,JPN,NTP,0000,0000,0000,,Бірақ сол қағидаға ренжіген менің анам болды.
Dialogue: 0,0:42:26.47,0:42:29.87,JPN,NTP,0000,0000,0000,,Мен Надяға тым қатал болдым.
Dialogue: 0,0:42:29.98,0:42:34.04,JPN,NTP,0000,0000,0000,,Сөйтіп ол ақсүйектер жолына түсті.
Dialogue: 0,0:42:34.15,0:42:37.81,JPN,NTP,0000,0000,0000,,Мен ананың қызымын.
Dialogue: 0,0:42:49.33,0:42:52.76,JPN,NTP,0000,0000,0000,,Сәлем! Себебі, мен тіректерге дұрыс қарамаймын.
Dialogue: 0,0:42:52.93,0:42:55.26,JPN,NTP,0000,0000,0000,,In this fog Wow!
Dialogue: 0,0:42:55.37,0:42:57.77,JPN,NTP,0000,0000,0000,,Кім палубаны еңкейтеді!
Dialogue: 0,0:42:57.87,0:42:59.20,JPN,NTP,0000,0000,0000,,Why a snake gun?
Dialogue: 0,0:42:59.31,0:43:01.64,JPN,NTP,0000,0000,0000,,Жылжымалы костюмдердің артық болуы мүмкін емес.
Dialogue: 0,0:43:02.64,0:43:04.51,JPN,NTP,0000,0000,0000,,Жанды оқтармен ойнамаңыз!
Dialogue: 0,0:43:09.08,0:43:11.91,JPN,NTP,0000,0000,0000,,Өзіңіз тудырған тәртіпсіздікті өзіңіз тазалаңыз!
Dialogue: 0,0:43:14.22,0:43:16.65,JPN,NTP,0000,0000,0000,,Мен сені бірден лагерьге жіберемін.
Dialogue: 0,0:43:16.76,0:43:19.42,JPN,NTP,0000,0000,0000,,Менің айтайын дегенім осы, Минми, өтінемін!
Dialogue: 0,0:43:19.53,0:43:20.22,JPN,NTP,0000,0000,0000,,Иә!
Dialogue: 0,0:43:22.86,0:43:24.49,JPN,NTP,0000,0000,0000,,Лия Сүт, асығыңыз!
Dialogue: 0,0:43:24.60,0:43:25.56,JPN,NTP,0000,0000,0000,,Right away!
Dialogue: 0,0:43:25.66,0:43:27.06,JPN,NTP,0000,0000,0000,,What a baby!
Dialogue: 0,0:43:27.17,0:43:30.76,JPN,NTP,0000,0000,0000,,I know! Лиз-чан, түсіндің бе?
Dialogue: 0,0:43:30.87,0:43:32.27,JPN,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:43:32.37,0:43:36.74,JPN,NTP,0000,0000,0000,,Сіз апамнан анам туралы айтпауды өтіндіңіз!
Dialogue: 0,0:43:36.84,0:43:40.57,JPN,NTP,0000,0000,0000,,Соғыс аяқталғаннан кейін жеке эмоциялық мәселелермен айналысыңыз!
Dialogue: 0,0:43:40.68,0:43:41.94,JPN,NTP,0000,0000,0000,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:43:42.11,0:43:47.31,JPN,NTP,0000,0000,0000,,Ақырында анасын ұмыта алатын бала қандай сезімде болады?
Dialogue: 0,0:43:47.49,0:43:48.45,JPN,NTP,0000,0000,0000,,Космо!
Dialogue: 0,0:43:48.59,0:43:49.45,JPN,NTP,0000,0000,0000,,Бұл қорқынышты!
Dialogue: 0,0:43:49.56,0:43:53.12,JPN,NTP,0000,0000,0000,,Бұлай істесең, анаңның айтқанын айтпаймын!
Dialogue: 0,0:43:53.23,0:43:56.19,JPN,NTP,0000,0000,0000,,Не! Сіз бұл кодты түсіндіңіз бе?
Dialogue: 0,0:43:56.36,0:43:59.13,JPN,NTP,0000,0000,0000,,Бұл код немесе басқа нәрсе емес.
Dialogue: 0,0:43:59.23,0:44:00.22,JPN,NTP,0000,0000,0000,,Лидс
Dialogue: 0,0:44:00.50,0:44:02.73,JPN,NTP,0000,0000,0000,,Уайымдама, ағайын.
Dialogue: 0,0:44:02.84,0:44:07.93,JPN,NTP,0000,0000,0000,,Мен анамның қандай адам екенін аздап түсіндім.
Dialogue: 0,0:44:08.47,0:44:09.37,JPN,NTP,0000,0000,0000,,Мен...
Dialogue: 0,0:44:09.88,0:44:11.60,JPN,NTP,0000,0000,0000,,Анам ешқашан
Dialogue: 0,0:44:11.71,0:44:16.61,JPN,NTP,0000,0000,0000,,Сен әкеңді де, бізді де жек көріп үйден шықпадың.
Dialogue: 0,0:44:17.12,0:44:21.55,JPN,NTP,0000,0000,0000,,Мен мұны Гурус мырза көрсеткен бейнеден анық түсіндім.
Dialogue: 0,0:44:21.99,0:44:22.95,JPN,NTP,0000,0000,0000,,Бұл таңқаларлық
Dialogue: 0,0:44:23.09,0:44:26.06,JPN,NTP,0000,0000,0000,,Үлкендердің атқаратын істері көп.
Dialogue: 0,0:44:26.19,0:44:28.75,JPN,NTP,0000,0000,0000,,Хахахаха Лиз-чан
Dialogue: 0,0:44:28.86,0:44:33.46,JPN,NTP,0000,0000,0000,,Түсіндіңіз бе? Бұл сол сегіз жақты көпірді ашып, аспалы көпірге айналу кодексі.
Dialogue: 0,0:44:33.67,0:44:37.12,JPN,NTP,0000,0000,0000,,Қараңыз, бұл код емес!
Dialogue: 0,0:44:37.24,0:44:38.23,JPN,NTP,0000,0000,0000,,Бесік...
Dialogue: 0,0:44:38.34,0:44:40.46,JPN,NTP,0000,0000,0000,,Бесік белгі болды ма?
Dialogue: 0,0:44:40.57,0:44:43.20,JPN,NTP,0000,0000,0000,,F91 мысалындағы сымға сілтеме жасайсыз ба?
Dialogue: 0,0:44:45.14,0:44:48.27,JPN,NTP,0000,0000,0000,,Анашым, ол бұған жақсы болды.
Dialogue: 0,0:44:52.48,0:44:54.61,JPN,NTP,0000,0000,0000,,Қараңдаршы, сегіз ілулі аспалы көпір
Dialogue: 0,0:44:54.75,0:44:58.21,JPN,NTP,0000,0000,0000,,Міне! Үстіңгі жағы - қатты компьютер тақтасының жағы...
Dialogue: 0,0:44:58.89,0:45:00.45,JPN,NTP,0000,0000,0000,,Сымдар өшіп жатыр -
Dialogue: 0,0:45:00.56,0:45:03.05,JPN,NTP,0000,0000,0000,,Биокомпьютерлер үшін параллель сызыққа айналатын нәрсе.
Dialogue: 0,0:45:03.16,0:45:04.49,JPN,NTP,0000,0000,0000,,Иә! Бұл дұрыс!
Dialogue: 0,0:45:04.60,0:45:08.59,JPN,NTP,0000,0000,0000,,Жоқ- бұл отбасы ғой! Хахахаха...
Dialogue: 0,0:45:09.34,0:45:12.03,JPN,NTP,0000,0000,0000,,Енді F91 пернесін пайдалануға болады
Dialogue: 0,0:45:12.14,0:45:16.04,JPN,NTP,0000,0000,0000,,Ұшқыш полковниктің қарсылық көрсетушілерінің қатарында, солай ма?
Dialogue: 0,0:45:16.14,0:45:19.51,JPN,NTP,0000,0000,0000,,Инженерлік факультет студенттері бар. Сіздердің біреулеріңіз мұны істеу керек!
Dialogue: 0,0:45:20.25,0:45:21.27,JPN,NTP,0000,0000,0000,,​​Есіңіз дұрыс па?
Dialogue: 0,0:45:21.38,0:45:23.87,JPN,NTP,0000,0000,0000,,Қарақшыларға ұқсас Crossbone Vanguard
Dialogue: 0,0:45:23.98,0:45:26.61,JPN,NTP,0000,0000,0000,,Бір колония бүлінді!
Dialogue: 0,0:45:26.75,0:45:30.00,JPN,NTP,0000,0000,0000,,Мен апамды өлтіріп, салқын ғаламға тастағанын қаламаймын.
Dialogue: 0,0:45:30.00,0:45:31.52,JPN,NTP,0000,0000,0000,,Ұшқыш бол!
Dialogue: 0,0:45:31.62,0:45:33.15,JPN,NTP,0000,0000,0000,,Күресудің қажеті жоқ!
Dialogue: 0,0:45:33.29,0:45:35.12,JPN,NTP,0000,0000,0000,,Бұл тапсырыс! Жақсы!
Dialogue: 0,0:45:35.23,0:45:39.22,JPN,NTP,0000,0000,0000,,Иә, сіз мобильді костюмді басқара аласыз ба?
Dialogue: 0,0:45:39.33,0:45:40.30,JPN,NTP,0000,0000,0000,,Мен сені бортқа апара алмаймын.
Dialogue: 0,0:45:40.40,0:45:41.23,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:45:41.33,0:45:45.13,JPN,NTP,0000,0000,0000,,Дегенмен, бұл сіздің анаңыз жасаған биокомпьютер.
Dialogue: 0,0:45:45.24,0:45:49.67,JPN,NTP,0000,0000,0000,,Егер сіз Newtype болсаңыз, жақсы сәйкес болуы мүмкін.
Dialogue: 0,0:45:49.78,0:45:51.14,JPN,NTP,0000,0000,0000,,Жаңа тип дегеніміз не?
Dialogue: 0,0:45:51.24,0:45:55.94,JPN,NTP,0000,0000,0000,,Мен ұшқыш сипаттамалары бар біреу туралы айтып отырмын. Сіз жақсы екеніңізге сенімдісіз бе?
Dialogue: 0,0:45:56.08,0:45:59.57,JPN,NTP,0000,0000,0000,,Витео анамды көргенде қатты қуандым.
Dialogue: 0,0:45:59.75,0:46:03.42,JPN,NTP,0000,0000,0000,,Бұл жай ғана бесік туралы әңгіме еді.
Dialogue: 0,0:46:03.52,0:46:09.02,JPN,NTP,0000,0000,0000,,Байқадым... анаң мына жылжымалы костюмге қолын тигізді.
Dialogue: 0,0:46:09.36,0:46:11.52,JPN,NTP,0000,0000,0000,,Ах! Бұл дұрыс!
Dialogue: 0,0:46:19.91,0:46:23.90,JPN,NTP,0000,0000,0000,,Керемет жұмыс! Сіз негізгі қимылдарды меңгердіңіз.
Dialogue: 0,0:46:24.01,0:46:25.74,JPN,NTP,0000,0000,0000,,Менің қолым емес
Dialogue: 0,0:46:26.45,0:46:30.64,JPN,NTP,0000,0000,0000,,Мен жылжымалы костюмнің өте жұмсақ машина екенін сезіндім.
Dialogue: 0,0:46:30.78,0:46:33.45,JPN,NTP,0000,0000,0000,,Егер сіз осылай сезінсеңіз, бұл шынайы.
Dialogue: 0,0:46:37.26,0:46:39.49,JPN,NTP,0000,0000,0000,,Бұлай болуы мүмкін емес!
Dialogue: 0,0:46:39.59,0:46:45.46,JPN,NTP,0000,0000,0000,,Менің кезектілігім бір тренердің кесірінен 10 минутқа кешіктірілді ме? Сен кімсің?
Dialogue: 0,0:46:45.56,0:46:47.93,JPN,NTP,0000,0000,0000,,Ол Рона әулетінің тікелей ұрпағы болуы керек!
Dialogue: 0,0:46:48.03,0:46:50.06,JPN,NTP,0000,0000,0000,,Лорд Дрель кеше түннен бері көрінбеді?
Dialogue: 0,0:46:50.17,0:46:51.80,JPN,NTP,0000,0000,0000,,I шекарадағы операция
Dialogue: 0,0:46:51.90,0:46:52.77,JPN,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:46:52.97,0:46:54.87,JPN,NTP,0000,0000,0000,,Скаутинг бүгінде алыс.
Dialogue: 0,0:46:55.01,0:46:56.10,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,0:46:59.04,0:47:03.57,JPN,NTP,0000,0000,0000,,Капитан Сабина тікелей қарауы тиіс тренерлер жоқ.
Dialogue: 0,0:47:03.72,0:47:04.48,JPN,NTP,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:47:04.62,0:47:05.41,JPN,NTP,0000,0000,0000,,Иә!
Dialogue: 0,0:47:15.83,0:47:18.70,JPN,NTP,0000,0000,0000,,Федералдық армияның қарсылығы да жылдам.
Dialogue: 0,0:47:18.80,0:47:24.79,JPN,NTP,0000,0000,0000,,Бұл сіз I шекараның ресурстық колония екенін және біз оны жоймайтынымызды білесіз бе?
Dialogue: 0,0:47:42.29,0:47:43.25,JPN,NTP,0000,0000,0000,,Жарайды!
Dialogue: 0,0:47:43.49,0:47:47.12,JPN,NTP,0000,0000,0000,,Егер сіз осы жерден тура жүрсеңіз, I шекаралық колонияға кіруіңіз керек.
Dialogue: 0,0:47:47.23,0:47:50.66,JPN,NTP,0000,0000,0000,,Алайда бүгінгі стратегия тек осы шахта оқпанын басқару болып табылады.
Dialogue: 0,0:47:50.80,0:47:52.46,JPN,NTP,0000,0000,0000,,Енді бұлайша оңай болмайды.
Dialogue: 0,0:47:52.83,0:47:56.93,JPN,NTP,0000,0000,0000,,Егер сізде артық қуат болса, келесі операцияға барлау жасау керек.
Dialogue: 0,0:48:04.41,0:48:06.47,JPN,NTP,0000,0000,0000,,Балам, бұл бұйрықты бұзу.
Dialogue: 0,0:48:06.58,0:48:09.84,JPN,NTP,0000,0000,0000,,Ішін сүрту Вавилондық декларациядан кейін орындалады...
Dialogue: 0,0:48:09.98,0:48:14.75,JPN,NTP,0000,0000,0000,,Шулы! Тек мойынсұнғандар ғана келсін! ішкі қабырғаны ашыңыз
Dialogue: 0,0:48:25.90,0:48:27.33,JPN,NTP,0000,0000,0000,,Иә, солға артқа жылжыңыз.
Dialogue: 0,0:48:27.43,0:48:29.66,JPN,NTP,0000,0000,0000,,Корпус онша күшті емес, білесіз бе!
Dialogue: 0,0:48:29.77,0:48:30.56,JPN,NTP,0000,0000,0000,,Мен білемін
Dialogue: 0,0:48:30.67,0:48:33.04,JPN,NTP,0000,0000,0000,,Біз сіздерді қарсы алуға келгенімізге қарамастан!
Dialogue: 0,0:48:33.14,0:48:34.04,JPN,NTP,0000,0000,0000,,Космо...
Dialogue: 0,0:48:34.81,0:48:38.44,JPN,NTP,0000,0000,0000,,Абайлаңыз! Космо біз туралы біледі ме?
Dialogue: 0,0:48:38.54,0:48:40.88,JPN,NTP,0000,0000,0000,,Ол ұшқыш.
Dialogue: 0,0:48:40.98,0:48:45.58,JPN,NTP,0000,0000,0000,,Бұл кемеде IV шекаралық босқындардың балалары да бар ма?
Dialogue: 0,0:48:45.85,0:48:47.32,JPN,NTP,0000,0000,0000,,Сіз қай топтасыз?
Dialogue: 0,0:48:47.42,0:48:48.72,JPN,NTP,0000,0000,0000,,Ричмонд
Dialogue: 0,0:48:48.82,0:48:53.55,JPN,NTP,0000,0000,0000,,Spaceac да сол жерден қашып кетті, сондықтан біреуі болуы керек.
Dialogue: 0,0:48:54.83,0:48:58.09,JPN,NTP,0000,0000,0000,,Жарайды, жарайды, тоқта!
Dialogue: 0,0:48:58.66,0:49:00.72,JPN,NTP,0000,0000,0000,,Гурулар! Бұл да күш бола ма?
Dialogue: 0,0:49:00.83,0:49:01.93,JPN,NTP,0000,0000,0000,,Бұл менің ниетім
Dialogue: 0,0:49:02.03,0:49:03.80,JPN,NTP,0000,0000,0000,,О, оның аузы бар.
Dialogue: 0,0:49:03.90,0:49:05.53,JPN,NTP,0000,0000,0000,,Масканы жабыңыз!
Dialogue: 0,0:49:06.37,0:49:07.46,JPN,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:49:07.87,0:49:11.04,JPN,NTP,0000,0000,0000,,Ертеде бет-әлпеті осындай жылжымалы костюм болған.
Dialogue: 0,0:49:11.18,0:49:12.47,JPN,NTP,0000,0000,0000,,Қайсысы?
Dialogue: 0,0:49:12.88,0:49:13.50,JPN,NTP,0000,0000,0000,,Эй!
Dialogue: 0,0:49:13.61,0:49:17.17,JPN,NTP,0000,0000,0000,,Ах! Қараңызшы, мен Гундам дедім.
Dialogue: 0,0:49:17.32,0:49:21.08,JPN,NTP,0000,0000,0000,,Гурус Бұны Gundam F91 деп кодтайық.
Dialogue: 0,0:49:21.19,0:49:21.88,JPN,NTP,0000,0000,0000,,Эх!
Dialogue: 0,0:49:22.02,0:49:23.78,JPN,NTP,0000,0000,0000,,Әй, бұл бала қайда?
Dialogue: 0,0:49:23.89,0:49:25.36,JPN,NTP,0000,0000,0000,,Теңіз кітабы?
Dialogue: 0,0:49:25.56,0:49:27.89,JPN,NTP,0000,0000,0000,,Сіз ғарыш кемесінің баласына не істеп жатырсыз?
Dialogue: 0,0:49:27.99,0:49:29.22,JPN,NTP,0000,0000,0000,,Не...
Dialogue: 0,0:49:29.53,0:49:32.00,JPN,NTP,0000,0000,0000,,Мұны біреу істеу керек, солай ма?
Dialogue: 0,0:49:32.10,0:49:37.36,JPN,NTP,0000,0000,0000,,Осы колонияда болған Sanary F91 әзірлеу тобы қашып кетті, солай емес пе?
Dialogue: 0,0:49:38.34,0:49:42.21,JPN,NTP,0000,0000,0000,,Ол доктор Анноның ұлы, сондықтан ол мұны істей алады, солай ма?
Dialogue: 0,0:49:42.31,0:49:44.43,JPN,NTP,0000,0000,0000,,Ана маңызды емес, солай ма?
Dialogue: 0,0:49:44.54,0:49:47.64,JPN,NTP,0000,0000,0000,,Капитан міндетін атқарушы! Тез арада көпірге көтеріліңіз.
Dialogue: 0,0:49:49.11,0:49:50.24,JPN,NTP,0000,0000,0000,,Теңіз кітабы
Dialogue: 0,0:49:50.38,0:49:50.94,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:49:51.08,0:49:52.31,JPN,NTP,0000,0000,0000,,Негізгі қосқышты қосу мүмкін емес.
Dialogue: 0,0:49:52.45,0:49:53.01,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:49:53.15,0:49:54.05,JPN,NTP,0000,0000,0000,,Жасаңыз.
Dialogue: 0,0:49:54.15,0:49:54.85,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:49:58.16,0:49:59.85,JPN,NTP,0000,0000,0000,,Ол қозғалады ма?
Dialogue: 0,0:50:00.09,0:50:02.53,JPN,NTP,0000,0000,0000,,Дуайт, тез тамақтан! Берто да
Dialogue: 0,0:50:02.76,0:50:03.79,JPN,NTP,0000,0000,0000,,Yes
Dialogue: 0,0:50:03.90,0:50:05.59,JPN,NTP,0000,0000,0000,,Балаларыңызға көмектесуге рұқсат етесіз бе?
Dialogue: 0,0:50:05.70,0:50:07.32,JPN,NTP,0000,0000,0000,,Қарағаш ханым, медицина ше?
Dialogue: 0,0:50:07.43,0:50:09.02,JPN,NTP,0000,0000,0000,,Мен оны алып жүруге рұқсат етемін.
Dialogue: 0,0:50:09.13,0:50:11.69,JPN,NTP,0000,0000,0000,,Сіз жылжымалы костюм ала алмадыңыз ба?
Dialogue: 0,0:50:15.54,0:50:17.74,JPN,NTP,0000,0000,0000,,Бұл қазірдің өзінде ұрыс алаңы!
Dialogue: 0,0:50:17.84,0:50:19.04,JPN,NTP,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,0:50:19.14,0:50:21.44,JPN,NTP,0000,0000,0000,,Олар осымен қарсылық қозғалысын жасауға тырысуда.
Dialogue: 0,0:50:22.08,0:50:22.98,JPN,NTP,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,0:50:23.08,0:50:24.48,JPN,NTP,0000,0000,0000,,Мен жұмыс істеймін!
Dialogue: 0,0:50:24.62,0:50:26.21,JPN,NTP,0000,0000,0000,,Мен де жұмыс істеймін.
Dialogue: 0,0:50:26.35,0:50:27.55,JPN,NTP,0000,0000,0000,,Мені бер
Dialogue: 0,0:50:27.69,0:50:30.02,JPN,NTP,0000,0000,0000,,Мен ыдыстарды да жуамын...
Dialogue: 0,0:50:30.12,0:50:31.18,JPN,NTP,0000,0000,0000,,Мен оны жеймін.
Dialogue: 0,0:50:31.32,0:50:32.29,JPN,NTP,0000,0000,0000,,Бар.
Dialogue: 0,0:50:34.69,0:50:35.82,JPN,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:50:35.93,0:50:36.59,JPN,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:50:36.70,0:50:38.89,JPN,NTP,0000,0000,0000,,Ол Сесилияны іздеп жатыр.
Dialogue: 0,0:50:39.00,0:50:40.73,JPN,NTP,0000,0000,0000,,Сесили?
Dialogue: 0,0:50:41.57,0:50:44.33,JPN,NTP,0000,0000,0000,,4-топ жоғарғы палубаға жиналуы керек!
Dialogue: 0,0:50:44.47,0:50:48.87,JPN,NTP,0000,0000,0000,,Егер есімде дұрыс болса, Сесили анасының жоғалып кеткенін айтты.
Dialogue: 0,0:50:48.97,0:50:51.70,JPN,NTP,0000,0000,0000,,Мобильді костюмге жақындап келе жатқан жау!
Dialogue: 0,0:50:51.91,0:50:56.31,JPN,NTP,0000,0000,0000,,Қарсыластың ғарыш доғасына жақындауына жол бермеу. Барлық жауынгерлік емес қызметкерлерді эвакуациялаңыз!
Dialogue: 0,0:50:56.42,0:50:57.58,JPN,NTP,0000,0000,0000,,Лиз мен Кочун ше?
Dialogue: 0,0:50:57.72,0:50:59.21,JPN,NTP,0000,0000,0000,,Ғарыш қайығында, солай ма?
Dialogue: 0,0:51:01.85,0:51:03.51,JPN,NTP,0000,0000,0000,,Балалар, мені мазалауға келдіңдер ме?
Dialogue: 0,0:51:03.69,0:51:05.21,JPN,NTP,0000,0000,0000,,Биргитт машинасы жіберіледі.
Dialogue: 0,0:51:07.33,0:51:09.95,JPN,NTP,0000,0000,0000,,Қарсыластың жылжымалы костюмдермен кемеге жақындауына жол бермеу.
Dialogue: 0,0:51:10.06,0:51:11.83,JPN,NTP,0000,0000,0000,,Биржит ше?
Dialogue: 0,0:51:13.30,0:51:14.32,JPN,NTP,0000,0000,0000,,Қорықпа.
Dialogue: 0,0:51:14.67,0:51:15.72,JPN,NTP,0000,0000,0000,,Неге!
Dialogue: 0,0:51:15.93,0:51:18.99,JPN,NTP,0000,0000,0000,,Ғарыш кемесіне тым көп адам жиналды. Гундамды шығарыңыз!
Dialogue: 0,0:51:19.57,0:51:22.27,JPN,NTP,0000,0000,0000,,Сіз бұл F91-ді алдау ретінде пайдаланасыз ба?
Dialogue: 0,0:51:22.37,0:51:26.40,JPN,NTP,0000,0000,0000,,Идиот! Бар болғаны тау мен ағаштарды қалқан етіп алып қашу керек! Бар!
Dialogue: 0,0:51:26.71,0:51:28.08,JPN,NTP,0000,0000,0000,,Жолдан кет! Мен барамын!
Dialogue: 0,0:51:28.18,0:51:28.98,JPN,NTP,0000,0000,0000,,Қорықпа.
Dialogue: 0,0:51:29.08,0:51:29.98,JPN,NTP,0000,0000,0000,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:51:30.08,0:51:34.14,JPN,NTP,0000,0000,0000,,Барсаң, Артурға ұқсайсың. Мен барамын!
Dialogue: 0,0:51:34.29,0:51:35.12,JPN,NTP,0000,0000,0000,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:51:35.22,0:51:36.98,JPN,NTP,0000,0000,0000,,Өлімге асығып тұрған сияқтысың.
Dialogue: 0,0:51:37.29,0:51:38.59,JPN,NTP,0000,0000,0000,,Тіпті сіз...
Dialogue: 0,0:51:41.39,0:51:43.88,JPN,NTP,0000,0000,0000,,Қашып кетсең өлмейсің
Dialogue: 0,0:51:44.00,0:51:47.56,JPN,NTP,0000,0000,0000,,F91 Gundam Seabook Annault-пен бірге жүреді
Dialogue: 0,0:51:47.70,0:51:49.96,JPN,NTP,0000,0000,0000,,Биргит! 24-ші ұшақ, шығыңыз!
Dialogue: 0,0:51:53.91,0:51:55.60,JPN,NTP,0000,0000,0000,,Сіз Гундамды орнынан тұрғыза аласыз ба?
Dialogue: 0,0:51:55.71,0:51:56.67,JPN,NTP,0000,0000,0000,,Бұл менің ниетім
Dialogue: 0,0:51:56.78,0:51:58.00,JPN,NTP,0000,0000,0000,,Байқап көріңіз
Dialogue: 0,0:52:00.58,0:52:02.81,JPN,NTP,0000,0000,0000,,Ол қозғалды, ол жұмыс істейді, солай ма?
Dialogue: 0,0:52:02.91,0:52:04.51,JPN,NTP,0000,0000,0000,,Тек сонда тұрыңыз!
Dialogue: 0,0:52:04.98,0:52:06.81,JPN,NTP,0000,0000,0000,,Көшіп кеткеніңізге қуаныштымын.
Dialogue: 0,0:52:06.95,0:52:09.28,JPN,NTP,0000,0000,0000,,Аа, бәрі Лиз-чанның арқасында.
Dialogue: 0,0:52:10.56,0:52:14.75,JPN,NTP,0000,0000,0000,,Уау! Ұшқыш костюмсіз денем түзелмей ме деп ойлаймын...
Dialogue: 0,0:52:14.86,0:52:17.06,JPN,NTP,0000,0000,0000,,Мылтықты ал, оның үстіндегі.
Dialogue: 0,0:52:17.16,0:52:18.65,JPN,NTP,0000,0000,0000,,Ех! Ол сәйкес келе ме?
Dialogue: 0,0:52:19.00,0:52:21.49,JPN,NTP,0000,0000,0000,,Бұл 91-ге арналған. Түзету аяқталды.
Dialogue: 0,0:52:22.97,0:52:26.13,JPN,NTP,0000,0000,0000,,Не істеп жатырсың! Мен мұны соңғы минутта автоматты түрде жасаймын.
Dialogue: 0,0:52:27.27,0:52:30.54,JPN,NTP,0000,0000,0000,,Теңіз кітабы? Биргитті сыртта қанша күтесің?
Dialogue: 0,0:52:30.64,0:52:31.54,JPN,NTP,0000,0000,0000,,Полковник Козмо!
Dialogue: 0,0:52:31.64,0:52:34.84,JPN,NTP,0000,0000,0000,,Мен команданы осында аламын, өйткені сіз оны көре алмайсыз!
Dialogue: 0,0:52:37.62,0:52:41.35,JPN,NTP,0000,0000,0000,,Ах! Мен анамның мұндай нәрсені жасағанына сене алар емеспін
Dialogue: 0,0:52:41.49,0:52:44.51,JPN,NTP,0000,0000,0000,,Оны катапультқа сал! Seabook мұны істей алады!
Dialogue: 0,0:52:44.66,0:52:46.49,JPN,NTP,0000,0000,0000,,Сенің ағаң осылай істеп жатыр ма?
Dialogue: 0,0:52:46.69,0:52:50.89,JPN,NTP,0000,0000,0000,,Жарайды! Гундамды шығарайық! Апыр-ай!
Dialogue: 0,0:52:52.93,0:52:53.86,JPN,NTP,0000,0000,0000,,Машина бөлмесі!
Dialogue: 0,0:52:53.97,0:52:55.09,JPN,NTP,0000,0000,0000,,Кеме де суға түсуде!
Dialogue: 0,0:52:55.20,0:52:56.50,JPN,NTP,0000,0000,0000,,Қазір шықсаң, табасың.
Dialogue: 0,0:52:57.07,0:52:59.87,JPN,NTP,0000,0000,0000,,Мен әлі де нысанаға айналамын ба?
Dialogue: 0,0:53:08.41,0:53:12.21,JPN,NTP,0000,0000,0000,,Хмф! Мұндай колонияны басқару оңай болар еді.
Dialogue: 0,0:53:12.35,0:53:15.81,JPN,NTP,0000,0000,0000,,Неге тартынасыз? Атасы мен әкесі...
Dialogue: 0,0:53:15.95,0:53:17.35,JPN,NTP,0000,0000,0000,,Осыншама!
Dialogue: 0,0:53:26.10,0:53:29.56,JPN,NTP,0000,0000,0000,,Уау! Қанша жау бар?
Dialogue: 0,0:53:30.97,0:53:34.37,JPN,NTP,0000,0000,0000,,Иә? Орманда крейсер тығылып жатыр. Уа!
Dialogue: 0,0:53:39.85,0:53:40.71,JPN,NTP,0000,0000,0000,,Бұл жігіт-!
Dialogue: 0,0:53:42.61,0:53:43.58,JPN,NTP,0000,0000,0000,,Келе жатыр!
Dialogue: 0,0:53:52.06,0:53:55.25,JPN,NTP,0000,0000,0000,,Құлап жатыр... Биргитт!
Dialogue: 0,0:53:59.33,0:54:01.42,JPN,NTP,0000,0000,0000,,F91! Сіз жасай аласыз ба?
Dialogue: 0,0:54:01.53,0:54:02.47,JPN,NTP,0000,0000,0000,,Әйтеуір...
Dialogue: 0,0:54:07.44,0:54:08.70,JPN,NTP,0000,0000,0000,,Мен жасадым...
Dialogue: 0,0:54:10.54,0:54:15.34,JPN,NTP,0000,0000,0000,,Ұшқыш өлді... өлді... у...
Dialogue: 0,0:54:19.55,0:54:25.49,JPN,NTP,0000,0000,0000,,Әлсіз күштер болмауы керек, бірақ 3 ұшақ атып түсіріліп, 2 ұшақ зақымдалды?
Dialogue: 0,0:54:25.66,0:54:28.49,JPN,NTP,0000,0000,0000,,Тәкаппарлық ашуды тудырады дейсіз бе?
Dialogue: 0,0:54:29.49,0:54:34.06,JPN,NTP,0000,0000,0000,,Мен де сене алмадым, мен сізді байыпты наубайшы деп ойладым.
Dialogue: 0,0:54:34.17,0:54:36.36,JPN,NTP,0000,0000,0000,,Шио сатқын болды.
Dialogue: 0,0:54:36.47,0:54:40.80,JPN,NTP,0000,0000,0000,,Қонақ үйдің жанына көшіп, Рона отбасына құйрығын бұлғап тұр.
Dialogue: 0,0:54:40.91,0:54:42.07,JPN,NTP,0000,0000,0000,,Ах! Сесили ше?
Dialogue: 0,0:54:42.24,0:54:45.04,JPN,NTP,0000,0000,0000,,Хан! Рона отбасынан шыққан әйел...
Dialogue: 0,0:54:47.75,0:54:50.84,JPN,NTP,0000,0000,0000,,Рона отбасының әйелі? Не айтқың келеді?
Dialogue: 0,0:54:57.56,0:54:58.85,JPN,NTP,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:54:58.96,0:55:00.52,JPN,NTP,0000,0000,0000,,Уақыт таяп қалды
Dialogue: 0,0:55:06.43,0:55:09.92,JPN,NTP,0000,0000,0000,,Датчикті тексеріп көрейік. Сымды жалғаңыз!
Dialogue: 0,0:55:10.27,0:55:12.43,JPN,NTP,0000,0000,0000,,Қараңдар! Ол астындағы штепсель.
Dialogue: 0,0:55:12.54,0:55:13.83,JPN,NTP,0000,0000,0000,,Иә!
Dialogue: 0,0:55:14.44,0:55:15.27,JPN,NTP,0000,0000,0000,,Кеттік!
Dialogue: 0,0:55:16.68,0:55:18.01,JPN,NTP,0000,0000,0000,,Сәлем!
Dialogue: 0,0:55:32.49,0:55:37.89,JPN,NTP,0000,0000,0000,,Мен жалғыз өмір сүре алмаймын және оған дайын емеспін...
Dialogue: 0,0:55:47.44,0:55:49.46,JPN,NTP,0000,0000,0000,,Сіз кімсіз! Күзетші!
Dialogue: 0,0:55:49.57,0:55:50.54,JPN,NTP,0000,0000,0000,,Сесили күткендей
Dialogue: 0,0:55:50.64,0:55:53.74,JPN,NTP,0000,0000,0000,,Теңіз кітабы! сен тірі едің
Dialogue: 0,0:55:53.91,0:55:56.57,JPN,NTP,0000,0000,0000,,Барлығы алаңдаулы. Мен сені алып кетуге келдім.
Dialogue: 0,0:55:56.68,0:55:57.84,JPN,NTP,0000,0000,0000,,Алу...
Dialogue: 0,0:55:57.98,0:55:58.64,JPN,NTP,0000,0000,0000,,Келіңіздер!
Dialogue: 0,0:55:58.95,0:56:01.71,JPN,NTP,0000,0000,0000,,Енді неге келдің? Қазірдің өзінде кеш!
Dialogue: 0,0:56:01.82,0:56:03.12,JPN,NTP,0000,0000,0000,,Кеш болды...
Dialogue: 0,0:56:03.96,0:56:05.42,JPN,NTP,0000,0000,0000,,Қазір!
Dialogue: 0,0:56:14.97,0:56:16.83,JPN,NTP,0000,0000,0000,,Қандай қозғалыс?
Dialogue: 0,0:56:16.97,0:56:18.53,JPN,NTP,0000,0000,0000,,(Рей) Уф~ Нұсқауларды мінсіз орындадым
Dialogue: 0,0:56:19.17,0:56:20.54,JPN,NTP,0000,0000,0000,,Шашыңызды алдыңыз ба?
Dialogue: 0,0:56:20.64,0:56:21.97,JPN,NTP,0000,0000,0000,,Иә...
Dialogue: 0,0:56:23.38,0:56:26.64,JPN,NTP,0000,0000,0000,,Сіздің қауіпсіз болғаныңызға қуаныштымын. Бұл шашқа не болды?
Dialogue: 0,0:56:26.95,0:56:33.51,JPN,NTP,0000,0000,0000,,Иә, мен шашымды қидым, себебі Рона отбасының мүшесі болу үшін әлі де жаттығу керек деп ойладым.
Dialogue: 0,0:56:33.65,0:56:35.62,JPN,NTP,0000,0000,0000,,Бұл өскенде
Dialogue: 0,0:56:35.75,0:56:38.22,JPN,NTP,0000,0000,0000,,Мен Космо Вавилонияның мұрагері болғым келеді...
Dialogue: 0,0:56:38.32,0:56:42.05,JPN,NTP,0000,0000,0000,,Түсіндім...сол шешім оны бұзақыға айналдырды ма?
Dialogue: 0,0:56:42.13,0:56:43.65,JPN,NTP,0000,0000,0000,,Бұл ұры ма?
Dialogue: 0,0:56:43.76,0:56:48.29,JPN,NTP,0000,0000,0000,,Сондықтан мен Федерацияның саясатын түзетуіміз керек екенін түсіндім.
Dialogue: 0,0:56:48.40,0:56:51.93,JPN,NTP,0000,0000,0000,,Түсіндім, жаңа заманның кумиріне айналасың ба?
Dialogue: 0,0:57:04.68,0:57:06.74,JPN,NTP,0000,0000,0000,,О! Міне, керемет!
Dialogue: 0,0:57:06.89,0:57:09.22,JPN,NTP,0000,0000,0000,,Бұл Денан Зонг! Бұл Денанг ойыны!
Dialogue: 0,0:57:09.32,0:57:11.15,JPN,NTP,0000,0000,0000,,40-тан астам ұшақ?
Dialogue: 0,0:57:21.57,0:57:23.19,JPN,NTP,0000,0000,0000,,Жарық жалауша! Бұлай етпе!
Dialogue: 0,0:57:23.50,0:57:25.97,JPN,NTP,0000,0000,0000,,Бүгін, Бүкіләлемдік ғасырдың бірінші ғасырынан кейін
Dialogue: 0,0:57:26.07,0:57:30.06,JPN,NTP,0000,0000,0000,,Жер Федерациясының үкімет қызметкерлері Жерді тағы да ластады.
Dialogue: 0,0:57:30.18,0:57:31.97,JPN,NTP,0000,0000,0000,,Жалғыз...
Dialogue: 0,0:57:32.08,0:57:32.91,JPN,NTP,0000,0000,0000,,...
Dialogue: 0,0:57:33.08,0:57:34.60,JPN,NTP,0000,0000,0000,,Бұл түсіруге болмайтын нәрсе ме?
Dialogue: 0,0:57:34.71,0:57:35.68,JPN,NTP,0000,0000,0000,,Әйтеуір...
Dialogue: 0,0:57:35.78,0:57:37.41,JPN,NTP,0000,0000,0000,,Мен… алдымен сені өлтіремін… Буга…ратти…
Dialogue: 0,0:57:39.52,0:57:42.58,JPN,NTP,0000,0000,0000,,Crossbone Vanguard осы мақсатқа арналған найзаның ұшынан басқа ештеңе емес.
Dialogue: 0,0:57:42.72,0:57:44.75,JPN,NTP,0000,0000,0000,,Осы қайта салынған колонияда —
Dialogue: 0,0:57:44.89,0:57:47.79,JPN,NTP,0000,0000,0000,,Өздерін тастап кеткендей өмір сүруге қайтарылған әрбір адамның күшімен
Dialogue: 0,0:57:47.89,0:57:51.33,JPN,NTP,0000,0000,0000,,Біз бүкіл жер шарын қорғауымыз керек
Dialogue: 0,0:57:52.10,0:57:54.33,JPN,NTP,0000,0000,0000,,Не! Мені атып тастаған біреу бар!
Dialogue: 0,0:57:54.87,0:57:57.33,JPN,NTP,0000,0000,0000,,Бізбен келіспейтіндер!
Dialogue: 0,0:57:57.44,0:58:01.17,JPN,NTP,0000,0000,0000,,Сен келіп мені өлтіре аласың! Мен қашпаймын немесе жасырмаймын!
Dialogue: 0,0:58:01.27,0:58:02.93,JPN,NTP,0000,0000,0000,,Керемет— Темір маскасы!
Dialogue: 0,0:58:03.04,0:58:04.57,JPN,NTP,0000,0000,0000,,Жер Федерациясының үкіметін құлат!
Dialogue: 0,0:58:04.68,0:58:08.58,JPN,NTP,0000,0000,0000,,Біз саясаткерлерді жерге түсіру үшін салық төлеп жатқан жоқпыз!
Dialogue: 0,0:58:09.75,0:58:15.74,JPN,NTP,0000,0000,0000,,Сесили Әскери күшпен шыққандар тек әскери бақылауды ойлайды.
Dialogue: 0,0:58:15.92,0:58:17.51,JPN,NTP,0000,0000,0000,,Неге білмейсің...
Dialogue: 0,0:58:17.66,0:58:20.92,JPN,NTP,0000,0000,0000,,Материалдық тұрғыдан ештеңе өзгермесе де...
Dialogue: 0,0:58:21.29,0:58:22.92,JPN,NTP,0000,0000,0000,,Seabook-kun
Dialogue: 0,0:58:23.70,0:58:24.86,JPN,NTP,0000,0000,0000,,Мен таптым!
Dialogue: 0,0:58:25.93,0:58:27.83,JPN,NTP,0000,0000,0000,,Crossbone Vanguard-да әлемді жаңарту!
Dialogue: 0,0:58:28.03,0:58:29.80,JPN,NTP,0000,0000,0000,,Алға!
Dialogue: 0,0:58:34.04,0:58:35.23,JPN,NTP,0000,0000,0000,,Жүр!
Dialogue: 0,0:58:38.11,0:58:38.97,JPN,NTP,0000,0000,0000,,Ол оны сіңіріп алмаған—
Dialogue: 0,0:58:40.51,0:58:44.14,JPN,NTP,0000,0000,0000,,Аннамари отряды, Джорджия көшесінің 5-ші блогына асығыңыз!
Dialogue: 0,0:58:45.75,0:58:48.22,JPN,NTP,0000,0000,0000,,Gundam? Бұл мобильді костюм бе?
Dialogue: 0,0:58:48.35,0:58:51.69,JPN,NTP,0000,0000,0000,,А...бұл жерде наразылық акциясын өткізу қисынсыз болар еді.
Dialogue: 0,0:59:07.37,0:59:09.64,JPN,NTP,0000,0000,0000,,Белгісіз тиесілігі бір ғана ұшақ?
Dialogue: 0,0:59:09.74,0:59:13.61,JPN,NTP,0000,0000,0000,,Аннамари сізді бақылап, қарсылық негізін табыңыз.
Dialogue: 0,0:59:14.85,0:59:16.54,JPN,NTP,0000,0000,0000,,Әсіресе бұл жаңа модель болса!
Dialogue: 0,0:59:17.12,0:59:18.38,JPN,NTP,0000,0000,0000,,Польнарефф?
Dialogue: 0,0:59:24.02,0:59:27.92,JPN,NTP,0000,0000,0000,,Лиз де күтіп тұр, аздап тырысыңыз.
Dialogue: 0,0:59:28.03,0:59:33.12,JPN,NTP,0000,0000,0000,,Жарайды, менің ойымша, сізде Моника туралы түсінбеушілік бар...
Dialogue: 0,0:59:33.12,0:59:36.25,JPN,NTP,0000,0000,0000,,Не? Сіздің сөмкеңіз ше? Менде жоқ
Dialogue: 0,0:59:36.56,0:59:41.26,JPN,NTP,0000,0000,0000,,Лиз кеткеннен бері Моника истерикаға айналды.
Dialogue: 0,0:59:41.37,0:59:46.89,JPN,NTP,0000,0000,0000,,Мен Мониканы жақсы көретінмін, бірақ оның жұмысын да жақсы көрдім.
Dialogue: 0,0:59:47.20,0:59:50.70,JPN,NTP,0000,0000,0000,,Бірақ мұндай қару жасау үшін емес еді, солай емес пе?
Dialogue: 0,0:59:51.31,0:59:56.08,JPN,NTP,0000,0000,0000,,Биокомпьютерді дамыту жеке деңгейде жүзеге асырылмайды.
Dialogue: 0,0:59:56.18,1:00:00.62,JPN,NTP,0000,0000,0000,,Бірақ менің әкем оның қорытпасынан жасалған зерттеулерін әскерилер пайдаланғанын қаламады.
Dialogue: 0,1:00:00.72,1:00:05.35,JPN,NTP,0000,0000,0000,,Дәнекерлеуші ​​болып, бала тәрбиелеп... өкінбедің бе?
Dialogue: 0,1:00:05.46,1:00:09.19,JPN,NTP,0000,0000,0000,,Мен сені және Лизді дұрыс тәрбиеледім.
Dialogue: 0,1:00:09.29,1:00:12.52,JPN,NTP,0000,0000,0000,,Уф... Мен оларды дұрыс тәрбиеледім...
Dialogue: 0,1:00:12.63,1:00:16.62,JPN,NTP,0000,0000,0000,,Әке әке! Әке!
Dialogue: 0,1:00:23.71,1:00:28.70,JPN,NTP,0000,0000,0000,,Біз кездескенде... осындай оқиға болды...
Dialogue: 0,1:00:28.85,1:00:31.37,JPN,NTP,0000,0000,0000,,Неге, әке!
Dialogue: 0,1:00:34.32,1:00:36.88,JPN,NTP,0000,0000,0000,,Лиз: Мәйіт ғарышта жерленеді...
Dialogue: 0,1:00:37.09,1:00:39.06,JPN,NTP,0000,0000,0000,,Жоқ! Мен әрқашан сенің жаныңда боламын!
Dialogue: 0,1:00:41.03,1:00:45.39,JPN,NTP,0000,0000,0000,,Түсіндің бе? Бұл сіздің өсуіңіздің нәтижесі!
Dialogue: 0,1:00:45.50,1:00:48.43,JPN,NTP,0000,0000,0000,,Гундамды басқара алатындықтан, жалғыз шығудың қажеті жоқ.
Dialogue: 0,1:00:48.53,1:00:50.52,JPN,NTP,0000,0000,0000,,Әкем ешқашан өлмеген!
Dialogue: 0,1:00:50.67,1:00:52.93,JPN,NTP,0000,0000,0000,,Баяғыда Newtype деген не болды?
Dialogue: 0,1:00:53.04,1:00:56.13,JPN,NTP,0000,0000,0000,,Жылжымалы костюмдерге келгенде бір маман бар еді ғой?
Dialogue: 0,1:00:56.24,1:00:59.70,JPN,NTP,0000,0000,0000,,Бұл нәрселердің көпшілігі жеке бақытсыздық болды, солай емес пе?
Dialogue: 0,1:00:59.91,1:01:03.91,JPN,NTP,0000,0000,0000,,Жарайсың Біргит! Мұнда теңіз кітабымен не істеуіміз керек?
Dialogue: 0,1:01:03.91,1:01:05.14,JPN,NTP,0000,0000,0000,,Сәлем Нант
Dialogue: 0,1:01:05.25,1:01:08.48,JPN,NTP,0000,0000,0000,,Егер сіз әскери қызметкер болсаңыз, түрмеге жабылуыңыз мүмкін, бірақ...
Dialogue: 0,1:01:08.59,1:01:10.95,JPN,NTP,0000,0000,0000,,Егер сені сол жігіттер ұстап алса ше?
Dialogue: 0,1:01:11.06,1:01:12.82,JPN,NTP,0000,0000,0000,,Мен қатардағы жауынгерлерді әкелдім.
Dialogue: 0,1:01:12.92,1:01:14.65,JPN,NTP,0000,0000,0000,,Хмм, бұл Гудам ба?
Dialogue: 0,1:01:14.76,1:01:16.19,JPN,NTP,0000,0000,0000,,Жылу қоздырушы!
Dialogue: 0,1:01:16.29,1:01:17.69,JPN,NTP,0000,0000,0000,,3-ші армияның лейтенанты Балдо!
Dialogue: 0,1:01:17.80,1:01:20.92,JPN,NTP,0000,0000,0000,,О! Мен енді капитанның міндетін атқарушымын деп айта алмаймын.
Dialogue: 0,1:01:21.03,1:01:24.73,JPN,NTP,0000,0000,0000,,Бұл жаттығу кемесі болса да, оны Crossbone-ның жойылу шайқасына қатысуға рұқсат етіңіз.
Dialogue: 0,1:01:25.10,1:01:27.37,JPN,NTP,0000,0000,0000,,Тұрақты экипаж жоқ!
Dialogue: 0,1:01:27.47,1:01:29.56,JPN,NTP,0000,0000,0000,,Жалақы алатын сарбаздан артық
Dialogue: 0,1:01:29.67,1:01:33.37,JPN,NTP,0000,0000,0000,,Осы жерде тұрып қалғандар әлдеқайда практикалық.
Dialogue: 0,1:01:33.51,1:01:36.84,JPN,NTP,0000,0000,0000,,Гундаммен бірге барлау сапарына шыққан сіз бе?
Dialogue: 0,1:01:37.18,1:01:38.24,JPN,NTP,0000,0000,0000,,Жақсы, онда
Dialogue: 0,1:01:39.08,1:01:41.05,JPN,NTP,0000,0000,0000,,Эй, бұл сенсің!
Dialogue: 0,1:01:41.52,1:01:45.75,JPN,NTP,0000,0000,0000,,Бұрынғы полковник Козмо Ол әуесқой. Бұл мүмкін емес!
Dialogue: 0,1:01:45.86,1:01:50.12,JPN,NTP,0000,0000,0000,,Crossbone осы колониядағы барлық адамдарды өлтіруді жоспарлап отыр.
Dialogue: 0,1:01:50.23,1:01:53.92,JPN,NTP,0000,0000,0000,,Міне, балалар, өсек-аяң осы емес пе?
Dialogue: 0,1:01:54.03,1:01:58.56,JPN,NTP,0000,0000,0000,,Crossbones Cosmo Babylonia адам ресурстарын қажет етеді, бірақ
Dialogue: 0,1:01:58.67,1:02:03.16,JPN,NTP,0000,0000,0000,,Жер мен айды ластайтын артық халықты жоямын деді!
Dialogue: 0,1:02:03.27,1:02:06.44,JPN,NTP,0000,0000,0000,,Бұл колониядағы барлық адамдар қырылады!
Dialogue: 0,1:02:06.58,1:02:07.54,JPN,NTP,0000,0000,0000,,Сіз газды пайдаланасыз ба?
Dialogue: 0,1:02:07.64,1:02:11.08,JPN,NTP,0000,0000,0000,,Тек адамдарды өлтіретін машина бар екендігі туралы ақпарат.
Dialogue: 0,1:02:14.35,1:02:20.69,JPN,NTP,0000,0000,0000,,Сесили... Сесили барлығын өлтіруге көмектесе ме?
Dialogue: 0,1:02:23.23,1:02:25.35,JPN,NTP,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,1:02:27.93,1:02:34.96,JPN,NTP,0000,0000,0000,,А... Әке, мен не істеймін?
Dialogue: 0,1:02:54.93,1:02:56.12,JPN,NTP,0000,0000,0000,,Аты-жөніңізді енгізіңіз.
Dialogue: 0,1:02:56.23,1:02:57.99,JPN,NTP,0000,0000,0000,,Шио Фэрчайлд
Dialogue: 0,1:03:04.90,1:03:06.73,JPN,NTP,0000,0000,0000,,Кароццо мырза кеңсесінде ме?
Dialogue: 0,1:03:06.84,1:03:09.17,JPN,NTP,0000,0000,0000,,А? Біз қазір стратегиялық кеңесте жатырмыз.
Dialogue: 0,1:03:09.27,1:03:12.27,JPN,NTP,0000,0000,0000,,Түсіндім, мен сені күтемін.
Dialogue: 0,1:03:13.11,1:03:15.44,JPN,NTP,0000,0000,0000,,Сіз шынымен кездесуді жоспарлап отырсыз ба? надия
Dialogue: 0,1:03:15.55,1:03:17.38,JPN,NTP,0000,0000,0000,,Мен Сесилияны саған сеніп тапсырдым.
Dialogue: 0,1:03:17.48,1:03:20.64,JPN,NTP,0000,0000,0000,,Бұл менің атам мен бұрынғы күйеуімді таң қалдыру үшін болды.
Dialogue: 0,1:03:21.35,1:03:24.88,JPN,NTP,0000,0000,0000,,Мен саған айтпағанымды білемін.
Dialogue: 0,1:03:24.99,1:03:28.01,JPN,NTP,0000,0000,0000,,Сіздің табылғаныңызды түсініңіз.
Dialogue: 0,1:03:28.29,1:03:29.49,JPN,NTP,0000,0000,0000,,Иә...
Dialogue: 0,1:03:30.79,1:03:33.99,JPN,NTP,0000,0000,0000,,Рона отбасымен бірге тұру да оңай емес.
Dialogue: 0,1:03:34.73,1:03:36.03,JPN,NTP,0000,0000,0000,,Кароццо.
Dialogue: 0,1:03:36.37,1:03:37.86,JPN,NTP,0000,0000,0000,,Уайымдама, Белла.
Dialogue: 0,1:03:37.97,1:03:38.56,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:03:38.67,1:03:40.80,JPN,NTP,0000,0000,0000,,Белла... Сесили!
Dialogue: 0,1:03:41.07,1:03:42.30,JPN,NTP,0000,0000,0000,,Қазір жаман!
Dialogue: 0,1:03:44.04,1:03:45.87,JPN,NTP,0000,0000,0000,,Түсіңіз! Бұл Надя
Dialogue: 0,1:03:46.44,1:03:48.17,JPN,NTP,0000,0000,0000,,Сесили, үйге қайтайық.
Dialogue: 0,1:03:48.31,1:03:49.37,JPN,NTP,0000,0000,0000,,Барлығы кемеге
Dialogue: 0,1:03:49.51,1:03:50.28,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,1:03:50.38,1:03:54.25,JPN,NTP,0000,0000,0000,,Сен Кароццо болсаң да, мен саған бұл баланы бере алмаймын.
Dialogue: 0,1:03:54.35,1:03:57.12,JPN,NTP,0000,0000,0000,,Мен осындай нәрсені киюге мәжбүр болған себебім
Dialogue: 0,1:03:57.22,1:04:00.99,JPN,NTP,0000,0000,0000,,Бұның бәрі сенің арқаңда екенін білсем, олай айтпас едім!
Dialogue: 0,1:04:01.12,1:04:04.18,JPN,NTP,0000,0000,0000,,Қылмыскерді жәбірленуші деп көрсетуді доғарыңыз.
Dialogue: 0,1:04:04.53,1:04:08.66,JPN,NTP,0000,0000,0000,,Атаң осында жүргенде сонша жолдан неге келдің?
Dialogue: 0,1:04:08.77,1:04:12.77,JPN,NTP,0000,0000,0000,,Асыл өмір сүруді ойламай, сезіммен ғана жүгіретін әйел!
Dialogue: 0,1:04:12.77,1:04:14.73,JPN,NTP,0000,0000,0000,,Менің қызым емес
Dialogue: 0,1:04:14.84,1:04:18.14,JPN,NTP,0000,0000,0000,,Белланың болашағын өзі таңдай алады.
Dialogue: 0,1:04:18.31,1:04:20.50,JPN,NTP,0000,0000,0000,,Сіз әлі онша қартайған жоқсыз!
Dialogue: 0,1:04:20.64,1:04:24.88,JPN,NTP,0000,0000,0000,,Анашым, ота біткен соң жайлап сөйлесейікші.
Dialogue: 0,1:04:24.98,1:04:27.58,JPN,NTP,0000,0000,0000,,Сесили, сен Белла Рона емессің.
Dialogue: 0,1:04:27.85,1:04:32.12,JPN,NTP,0000,0000,0000,,Жоқ, мен Бегуина Гвинаның ұшқышы Белла Ронамын.
Dialogue: 0,1:04:32.22,1:04:36.78,JPN,NTP,0000,0000,0000,,Сіз айтып отырған еркіндік қашуға сылтау сияқты естіледі.
Dialogue: 0,1:04:37.06,1:04:37.96,JPN,NTP,0000,0000,0000,,Бұл дұрыс емес!
Dialogue: 0,1:04:38.06,1:04:41.79,JPN,NTP,0000,0000,0000,,Надя Адам - ​​дәстүрлі эмоционалды жануар.
Dialogue: 0,1:04:41.90,1:04:44.90,JPN,NTP,0000,0000,0000,,Ол Жер шарының өзін жұтып қоятын дәрежеге жетті.
Dialogue: 0,1:04:44.90,1:04:47.17,JPN,NTP,0000,0000,0000,,Мен неге екенін түсінбеймін
Dialogue: 0,1:04:47.60,1:04:51.37,JPN,NTP,0000,0000,0000,,Бетіңізге бұлай айтуға батылыңыз жетпеді!
Dialogue: 0,1:04:52.58,1:04:54.81,JPN,NTP,0000,0000,0000,,Мен де сезімге толы адаммын.
Dialogue: 0,1:04:54.95,1:04:58.68,JPN,NTP,0000,0000,0000,,Егер мен шын болсам, дәл қазір сені ұрып-соғуым мүмкін еді.
Dialogue: 0,1:04:58.78,1:05:01.34,JPN,NTP,0000,0000,0000,,Оны басатын маска.
Dialogue: 0,1:05:01.45,1:05:05.58,JPN,NTP,0000,0000,0000,,Біз адамзат өзінің құмарлықтарын басу керек заманда өмір сүріп жатырмыз.
Dialogue: 0,1:05:05.69,1:05:09.96,JPN,NTP,0000,0000,0000,,Мен біраз уақыт үзіліс жасаймын. Атаңмен татулассаң қуанамын.
Dialogue: 0,1:05:12.23,1:05:13.70,JPN,NTP,0000,0000,0000,,Шио!
Dialogue: 0,1:05:16.80,1:05:18.63,JPN,NTP,0000,0000,0000,,Өлтіруші!
Dialogue: 0,1:05:18.74,1:05:20.26,JPN,NTP,0000,0000,0000,,Ах! не!
Dialogue: 0,1:05:30.21,1:05:35.91,JPN,NTP,0000,0000,0000,,Барлық үш бағыттағы барлау сигналы берілгеннен кейін мобильді костюм тобы басталады.
Dialogue: 0,1:05:36.02,1:05:36.68,JPN,NTP,0000,0000,0000,,Хаха!
Dialogue: 0,1:05:36.79,1:05:37.38,JPN,NTP,0000,0000,0000,,Кеттік!
Dialogue: 0,1:05:37.49,1:05:38.08,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,1:05:38.19,1:05:42.99,JPN,NTP,0000,0000,0000,,Сонымен, егер біз осы стратегия арқылы I шекараны бағындырсақ, өмір сүріп, көңіл көтере аламыз ба?
Dialogue: 0,1:05:43.09,1:05:45.56,JPN,NTP,0000,0000,0000,,Жерді тазалау операциясы бар.
Dialogue: 0,1:05:48.27,1:05:49.70,JPN,NTP,0000,0000,0000,,Қайтадан сынақтан өтіңіз!
Dialogue: 0,1:05:50.33,1:05:51.53,JPN,NTP,0000,0000,0000,,Мен бірден барамын
Dialogue: 0,1:05:51.64,1:05:52.19,JPN,NTP,0000,0000,0000,,Иә!
Dialogue: 0,1:05:52.30,1:05:52.93,JPN,NTP,0000,0000,0000,,Кимоноым шаңмен кірленді.
Dialogue: 0,1:05:53.04,1:05:53.83,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,1:05:53.94,1:05:54.90,JPN,NTP,0000,0000,0000,,Сабина-сама
Dialogue: 0,1:05:55.01,1:05:55.97,JPN,NTP,0000,0000,0000,,Аннамари
Dialogue: 0,1:05:56.44,1:06:01.34,JPN,NTP,0000,0000,0000,,Мен ойлағаннан да көп жау бар сияқты. Барлаумен абай болыңыз.
Dialogue: 0,1:06:01.75,1:06:04.37,JPN,NTP,0000,0000,0000,,Сабина-сама, найзаның ұшы болыңыз.
Dialogue: 0,1:06:04.51,1:06:07.04,JPN,NTP,0000,0000,0000,,А, мен саусағымды люкке іліндім...
Dialogue: 0,1:06:07.58,1:06:08.95,JPN,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:06:09.09,1:06:11.42,JPN,NTP,0000,0000,0000,,Белла Рона-сама да жіберіледі ме?
Dialogue: 0,1:06:11.99,1:06:14.01,JPN,NTP,0000,0000,0000,,Бұл кедергі болуы мүмкін, бірақ
Dialogue: 0,1:06:14.12,1:06:17.06,JPN,NTP,0000,0000,0000,,Сабина онымен айналысамын дейді.
Dialogue: 0,1:06:17.59,1:06:21.29,JPN,NTP,0000,0000,0000,,Сақ болыңыз, мен бірінші боламын.
Dialogue: 0,1:06:22.10,1:06:24.62,JPN,NTP,0000,0000,0000,,Ұшқышты сұрау
Dialogue: 0,1:06:26.47,1:06:29.20,JPN,NTP,0000,0000,0000,,Бірақ біреуге ұнайтыны қызық
Dialogue: 0,1:06:29.20,1:06:31.93,JPN,NTP,0000,0000,0000,,Сіз бұл Замас Гару туралы бәрін білмейсіз бе?
Dialogue: 0,1:06:32.04,1:06:35.01,JPN,NTP,0000,0000,0000,,Тіпті капитан да білмейді. Бұл солай.
Dialogue: 0,1:06:35.41,1:06:36.78,JPN,NTP,0000,0000,0000,,Сонымен...
Dialogue: 0,1:06:36.91,1:06:42.58,JPN,NTP,0000,0000,0000,,Бұл кемені I шекараның метеориттік жағына орналастырып, оны жағажай басы ретінде пайдаланыңыз.
Dialogue: 0,1:06:42.69,1:06:45.15,JPN,NTP,0000,0000,0000,,Бұл стратегия сізге қажет нәрсе ме?
Dialogue: 0,1:06:45.39,1:06:46.41,JPN,NTP,0000,0000,0000,,Иә?
Dialogue: 0,1:06:46.52,1:06:50.15,JPN,NTP,0000,0000,0000,,Ол менің әкем болса да, мен неге Кароццоға сене алмаймын?
Dialogue: 0,1:06:50.63,1:06:53.19,JPN,NTP,0000,0000,0000,,Сіз басқа нәрсені ойлап тұрған сияқтысыз.
Dialogue: 0,1:06:53.70,1:06:58.23,JPN,NTP,0000,0000,0000,,Джире Темір Маскаға көбірек ұқсайды, сондықтан оның сөзі мен іс-әрекетіне назар аударсаңыз.
Dialogue: 0,1:06:58.34,1:07:01.67,JPN,NTP,0000,0000,0000,,Баку сияқты кодтардың мағынасын түсінейік.
Dialogue: 0,1:07:02.14,1:07:03.11,JPN,NTP,0000,0000,0000,,Тапир?
Dialogue: 0,1:07:03.21,1:07:07.37,JPN,NTP,0000,0000,0000,,Бұл ұйым туралы бәрін білу қаншалықты қиын екенін көрсететін мысал.
Dialogue: 0,1:07:07.51,1:07:10.11,JPN,NTP,0000,0000,0000,,Сіз Рона отбасын менсінбейсіз, солай емес пе?
Dialogue: 0,1:07:10.25,1:07:13.48,JPN,NTP,0000,0000,0000,,Мен Crossbones армиясын құруға көмектестім.
Dialogue: 0,1:07:13.58,1:07:15.41,JPN,NTP,0000,0000,0000,,Мейтцер мырза және темір маска
Dialogue: 0,1:07:15.92,1:07:20.15,JPN,NTP,0000,0000,0000,,Мен сіздің жеке сезімдеріңізді идеалдарыңызбен шатастырмайтыныңызды білемін.
Dialogue: 0,1:07:20.26,1:07:22.28,JPN,NTP,0000,0000,0000,,Мен де солаймын.
Dialogue: 0,1:07:22.73,1:07:25.75,JPN,NTP,0000,0000,0000,,Аннамари барлау бөлімі шықты! дайындық!
Dialogue: 0,1:07:37.44,1:07:38.67,JPN,NTP,0000,0000,0000,,Бұл да
Dialogue: 0,1:07:38.81,1:07:40.33,JPN,NTP,0000,0000,0000,,Лияға рахмет
Dialogue: 0,1:07:41.21,1:07:46.21,JPN,NTP,0000,0000,0000,,Менің ағам үйге жақында бара алатынын айтты, сондықтан сәл күте тұрыңыз.
Dialogue: 0,1:07:46.85,1:07:49.88,JPN,NTP,0000,0000,0000,,Сіз қалай ойлайсыз? Егер Сесили Рона отбасында болса
Dialogue: 0,1:07:49.99,1:07:52.42,JPN,NTP,0000,0000,0000,,Ол сені міндетті түрде сүйеді
Dialogue: 0,1:07:52.52,1:07:53.42,JPN,NTP,0000,0000,0000,,Теңіз кітабы
Dialogue: 0,1:07:53.52,1:07:56.46,JPN,NTP,0000,0000,0000,,Егер сіз осы F91-ді өзіңізбен бірге алсаңыз.
Dialogue: 0,1:07:56.56,1:07:59.65,JPN,NTP,0000,0000,0000,,Олар бізді Вавилон азаматы ететін шығар.
Dialogue: 0,1:07:59.70,1:08:02.89,JPN,NTP,0000,0000,0000,,Бірақ Дуайт әлі де әскери бала ма?
Dialogue: 0,1:08:03.00,1:08:05.70,JPN,NTP,0000,0000,0000,,Дороти, Сэм және Азума барлығы келіседі, солай емес пе?
Dialogue: 0,1:08:05.84,1:08:10.10,JPN,NTP,0000,0000,0000,,Тіпті капитанның міндетін атқарушы Лаогэйр де осы жерден қашуды ойлап жүр.
Dialogue: 0,1:08:10.21,1:08:13.94,JPN,NTP,0000,0000,0000,,Сесилиді көргің келгендіктен осылай айтып отырсың.
Dialogue: 0,1:08:14.08,1:08:15.51,JPN,NTP,0000,0000,0000,,Жоқ!
Dialogue: 0,1:08:16.81,1:08:21.48,JPN,NTP,0000,0000,0000,,Сіз шайқасқа дайынсыз! Newtypes пилоттық костюмдерге ауыса ма?
Dialogue: 0,1:08:21.59,1:08:23.08,JPN,NTP,0000,0000,0000,,Жаңа типтерге кімдер жатады?
Dialogue: 0,1:08:23.19,1:08:24.92,JPN,NTP,0000,0000,0000,,Сіз мұны істейсіз.
Dialogue: 0,1:08:25.19,1:08:28.02,JPN,NTP,0000,0000,0000,,Кішкентай сіңліңіз бен балаларыңыздың өлімі жақсы ма?
Dialogue: 0,1:08:28.43,1:08:30.92,JPN,NTP,0000,0000,0000,,Бұл... қарт...
Dialogue: 0,1:08:31.36,1:08:32.49,JPN,NTP,0000,0000,0000,,Оңға қарай сәл!
Dialogue: 0,1:08:32.60,1:08:33.56,JPN,NTP,0000,0000,0000,,Тіпті руль!
Dialogue: 0,1:08:33.66,1:08:35.06,JPN,NTP,0000,0000,0000,,Мен білемін!
Dialogue: 0,1:08:36.57,1:08:39.00,JPN,NTP,0000,0000,0000,,Осыған ұқсас нәрсе негіз бола ма?
Dialogue: 0,1:08:39.10,1:08:40.93,JPN,NTP,0000,0000,0000,,Мұның бәрі балапандар.
Dialogue: 0,1:08:41.17,1:08:44.23,JPN,NTP,0000,0000,0000,,Ол бізге қонуды жеңілдетті.
Dialogue: 0,1:08:46.34,1:08:48.04,JPN,NTP,0000,0000,0000,,Иә! Мен күштімін!
Dialogue: 0,1:08:48.18,1:08:51.64,JPN,NTP,0000,0000,0000,,Енді төменнен шабуылдар туралы алаңдамайсыз.
Dialogue: 0,1:08:51.82,1:08:54.05,JPN,NTP,0000,0000,0000,,Иә! Өйткені ол таудың басында
Dialogue: 0,1:08:54.18,1:08:57.02,JPN,NTP,0000,0000,0000,,Кан Биргитт пен Seabook айналаны барлау.
Dialogue: 0,1:08:57.25,1:08:59.65,JPN,NTP,0000,0000,0000,,Ой! Қашу жолыңызды тексеріңіз!
Dialogue: 0,1:08:59.69,1:09:00.66,JPN,NTP,0000,0000,0000,,Капитан міндетін атқарушы!
Dialogue: 0,1:09:00.76,1:09:01.66,JPN,NTP,0000,0000,0000,,Биргитт
Dialogue: 0,1:09:01.76,1:09:05.09,JPN,NTP,0000,0000,0000,,Палубаны ашыңыз! Қарсыластың мобильді костюмдерін қамтиды
Dialogue: 0,1:09:05.20,1:09:05.92,JPN,NTP,0000,0000,0000,,Мен мұны істеп жатырмын
Dialogue: 0,1:09:06.16,1:09:08.96,JPN,NTP,0000,0000,0000,,Биргитт 24 Кеттік!
Dialogue: 0,1:09:10.33,1:09:12.16,JPN,NTP,0000,0000,0000,,Сіз жақсы ұшқыш емессіз бе?
Dialogue: 0,1:09:12.27,1:09:16.80,JPN,NTP,0000,0000,0000,,Мен командалар тізбегі 3-ші армиядан немесе 35-ші армиядан басталғанын қалаймын.
Dialogue: 0,1:09:16.91,1:09:19.74,JPN,NTP,0000,0000,0000,,Олар колонияны сыртта қорғап тұр!
Dialogue: 0,1:09:19.88,1:09:21.28,JPN,NTP,0000,0000,0000,,Seabook Gundam
Dialogue: 0,1:09:21.85,1:09:23.44,JPN,NTP,0000,0000,0000,,F91 пайда болады
Dialogue: 0,1:09:23.58,1:09:25.28,JPN,NTP,0000,0000,0000,,Тым араласпаңыз!
Dialogue: 0,1:09:32.92,1:09:33.79,JPN,NTP,0000,0000,0000,,Жақсы!
Dialogue: 0,1:09:33.89,1:09:35.22,JPN,NTP,0000,0000,0000,,Не!
Dialogue: 0,1:09:36.96,1:09:38.79,JPN,NTP,0000,0000,0000,,А, бұл жаңа үлгі.
Dialogue: 0,1:09:38.90,1:09:40.80,JPN,NTP,0000,0000,0000,,Сіз оны пайдалана алмайсыз ба?
Dialogue: 0,1:09:44.53,1:09:46.16,JPN,NTP,0000,0000,0000,,Теңіз кітабы! Сенімен бәрі жақсы ма?
Dialogue: 0,1:09:46.27,1:09:47.46,JPN,NTP,0000,0000,0000,,Оның жартысы пьеса.
Dialogue: 0,1:09:48.57,1:09:51.17,JPN,NTP,0000,0000,0000,,Әңгімелейтін нәрсе бар деп айтпадың ба?
Dialogue: 0,1:09:51.27,1:09:55.80,JPN,NTP,0000,0000,0000,,О! Мұны айтып отырған себебім, желіні тікелей тыңдау мүмкін емес.
Dialogue: 0,1:09:56.11,1:09:56.74,JPN,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:09:56.88,1:10:01.44,JPN,NTP,0000,0000,0000,,Мен ғарыш кемесінің қашу жолын зерттеу үшін порттың кіреберісіне барамын.
Dialogue: 0,1:10:01.55,1:10:02.58,JPN,NTP,0000,0000,0000,,Иә!
Dialogue: 0,1:10:02.79,1:10:05.35,JPN,NTP,0000,0000,0000,,Осы жерді бастарыңызға алыңыз!
Dialogue: 0,1:10:05.46,1:10:06.35,JPN,NTP,0000,0000,0000,,Иә!
Dialogue: 0,1:10:10.99,1:10:15.43,JPN,NTP,0000,0000,0000,,Бұл биосенсор менің биоритміме сәйкес келе ме?
Dialogue: 0,1:10:15.77,1:10:17.39,JPN,NTP,0000,0000,0000,,Менің анам күткендей...
Dialogue: 0,1:10:20.20,1:10:21.26,JPN,NTP,0000,0000,0000,,Не? не?
Dialogue: 0,1:10:22.17,1:10:24.20,JPN,NTP,0000,0000,0000,,Мен сені өлтіремін! Жолдан кет!
Dialogue: 0,1:10:28.41,1:10:32.54,JPN,NTP,0000,0000,0000,,Үлкен болып, әскерді асыраған жақсы ма?
Dialogue: 0,1:10:34.25,1:10:38.92,JPN,NTP,0000,0000,0000,,Осы Замс Гарды I шекараның шахта бөлігінің жанына әкеліңіз.
Dialogue: 0,1:10:39.02,1:10:42.08,JPN,NTP,0000,0000,0000,,«Баку» оянғаннан кейін бұл операция аяқталады.
Dialogue: 0,1:10:42.36,1:10:48.03,JPN,NTP,0000,0000,0000,,Ха! Егер бұл сынақ ойдағыдай өтсе, біз Ай мен Жердегі адамзатты жойып жібереміз.
Dialogue: 0,1:10:48.13,1:10:50.22,JPN,NTP,0000,0000,0000,,Бұл осы мақсат үшін сынақ алаңы.
Dialogue: 0,1:10:50.33,1:10:54.43,JPN,NTP,0000,0000,0000,,Тағы бір рет колонияның негізгі бөлігін бүлдірмеуді бұйырамын!
Dialogue: 0,1:10:54.87,1:10:57.57,JPN,NTP,0000,0000,0000,,Желдетуді бастаңыз! Барлығы борттағы!
Dialogue: 0,1:10:58.14,1:11:01.20,JPN,NTP,0000,0000,0000,,Сабина, назар аударғаныңызға рахмет.
Dialogue: 0,1:11:01.78,1:11:06.65,JPN,NTP,0000,0000,0000,,Жоқ. Сіз бұл бастаушы-гвинаны Денан түріне қарағанда өңдеу оңай деп айтасыз.
Dialogue: 0,1:11:06.75,1:11:10.78,JPN,NTP,0000,0000,0000,,Белла Рона-сама нағыз Ньютайп сияқты.
Dialogue: 0,1:11:11.25,1:11:15.09,JPN,NTP,0000,0000,0000,,Өтінемін, адамдарға жағымпазданып, мені бірінші тапсырмамда жалғыз қалдырмаңыз.
Dialogue: 0,1:11:15.19,1:11:19.86,JPN,NTP,0000,0000,0000,,Менің қара эскадрильям сізді айналаңыздан қорғайды. Сонымен...
Dialogue: 0,1:11:20.50,1:11:23.16,JPN,NTP,0000,0000,0000,,Жылжымалы костюм бөлімшелері бірінен соң бірі шығады!
Dialogue: 0,1:11:42.92,1:11:45.42,JPN,NTP,0000,0000,0000,,Дрелл батальоны жолдағы кез келген кедергіні елемейді.
Dialogue: 0,1:11:45.42,1:11:47.25,JPN,NTP,0000,0000,0000,,Метеорит жағына тура жүріңіз
Dialogue: 0,1:11:47.36,1:11:49.42,JPN,NTP,0000,0000,0000,,Менің туыммен жүр!
Dialogue: 0,1:11:57.17,1:11:59.16,JPN,NTP,0000,0000,0000,,Енді әрі қарай жүрейік.
Dialogue: 0,1:11:59.27,1:12:00.60,JPN,NTP,0000,0000,0000,,Өтінемін
Dialogue: 0,1:12:06.58,1:12:08.48,JPN,NTP,0000,0000,0000,,Мен ұша аламын...
Dialogue: 0,1:12:09.98,1:12:12.38,JPN,NTP,0000,0000,0000,,Чар тұқымының елтаңбасы?
Dialogue: 0,1:12:15.22,1:12:17.71,JPN,NTP,0000,0000,0000,,Жақын арада формация құра аламын деп ойламадым.
Dialogue: 0,1:12:17.82,1:12:19.52,JPN,NTP,0000,0000,0000,,Оны сол күйінде көру
Dialogue: 0,1:12:19.62,1:12:23.52,JPN,NTP,0000,0000,0000,,Өзінің мәнін түсіне алатындарды жаңа типтер деп атайды.
Dialogue: 0,1:12:23.66,1:12:25.13,JPN,NTP,0000,0000,0000,,Мен сенгім келді
Dialogue: 0,1:12:30.40,1:12:34.03,JPN,NTP,0000,0000,0000,,Егер біз Федерацияны күшейтуді тоқтатсақ, Сабинадан жеңілмейміз.
Dialogue: 0,1:12:41.11,1:12:45.51,JPN,NTP,0000,0000,0000,,Егер ол бір апта бұрын аударған болса, деректерді түрлендіру оңайырақ болар еді.
Dialogue: 0,1:12:45.62,1:12:46.45,JPN,NTP,0000,0000,0000,,Бұл ма?
Dialogue: 0,1:12:46.55,1:12:49.88,JPN,NTP,0000,0000,0000,,А, бұл дәл, себебі ол Crossbone Vanguard деректерінен алынған.
Dialogue: 0,1:12:49.99,1:12:53.55,JPN,NTP,0000,0000,0000,,Аннамари Лизге құрбандық үстелін тазалауға көмектесіп жатыр ма?
Dialogue: 0,1:12:53.66,1:12:56.22,JPN,NTP,0000,0000,0000,,Әй, кішкентайлар үйреніп барады.
Dialogue: 0,1:12:56.33,1:13:00.19,JPN,NTP,0000,0000,0000,,Не! Бұл бояу ше? осырық-!
Dialogue: 0,1:13:01.93,1:13:04.20,JPN,NTP,0000,0000,0000,,Аннамари төбелеспекші ме?
Dialogue: 0,1:13:04.30,1:13:05.93,JPN,NTP,0000,0000,0000,,Ғарыштың қуанышында шек жоқ
Dialogue: 0,1:13:06.04,1:13:06.76,JPN,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:13:06.87,1:13:08.00,JPN,NTP,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,1:13:08.10,1:13:12.56,JPN,NTP,0000,0000,0000,,Ол өте адам болуы керек, неге ол жағын өзгертті?
Dialogue: 0,1:13:13.31,1:13:15.54,JPN,NTP,0000,0000,0000,,Сэм! Азума! Өтінемін тез бітіріңіз!
Dialogue: 0,1:13:15.88,1:13:17.64,JPN,NTP,0000,0000,0000,,Дәл осында!
Dialogue: 0,1:13:17.78,1:13:19.75,JPN,NTP,0000,0000,0000,,Барлық мүшелер! Бірінші ұрыс позициясында күтеміз!
Dialogue: 0,1:13:19.88,1:13:21.35,JPN,NTP,0000,0000,0000,,Кез келген уақытта қашып құтылу
Dialogue: 0,1:13:21.48,1:13:22.04,JPN,NTP,0000,0000,0000,,О
Dialogue: 0,1:13:25.89,1:13:29.83,JPN,NTP,0000,0000,0000,,38 Эскадрилья метеорит жағына бұрылады. Бұл жаққа айқас сүйек бекітілген сияқты.
Dialogue: 0,1:13:30.19,1:13:32.32,JPN,NTP,0000,0000,0000,,Шарды инъекциялау!
Dialogue: 0,1:13:35.63,1:13:38.73,JPN,NTP,0000,0000,0000,,Мобильді костюм теңіздегі атыс аяқталғаннан кейін 3 минуттан кейін іске қосылады!
Dialogue: 0,1:13:38.84,1:13:39.82,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,1:13:39.94,1:13:44.13,JPN,NTP,0000,0000,0000,,Лазерлік талдау басталды! Қарсыластың көлеңкелері екінші атыс шегінде болады. Ілгері жүру!
Dialogue: 0,1:13:44.27,1:13:47.07,JPN,NTP,0000,0000,0000,,Қарақшыларға шекара жағы ұнамасын!
Dialogue: 0,1:13:47.21,1:13:51.91,JPN,NTP,0000,0000,0000,,Әрбір кеме! Барлығы бірден! Ат!
Dialogue: 0,1:14:05.73,1:14:09.60,JPN,NTP,0000,0000,0000,,Қарсыластың қорғаныс шебінен солтүстікке барыңыз. Жалғастыру!
Dialogue: 0,1:14:16.84,1:14:18.36,JPN,NTP,0000,0000,0000,,Хаа… Хаа…
Dialogue: 0,1:14:18.54,1:14:19.74,JPN,NTP,0000,0000,0000,,Құрметті Белла Рона
Dialogue: 0,1:14:19.88,1:14:20.93,JPN,NTP,0000,0000,0000,,Ах! иә!
Dialogue: 0,1:14:21.61,1:14:24.38,JPN,NTP,0000,0000,0000,,Дрелл батальоны жойған жау ұшақтарын тазалаңыз
Dialogue: 0,1:14:24.48,1:14:28.11,JPN,NTP,0000,0000,0000,,Вера мырза, егер ұялшақ достық ұшақ болса, оны ұрысыңыз.
Dialogue: 0,1:14:28.42,1:14:31.48,JPN,NTP,0000,0000,0000,,Маған Сабинаны зерттеуге рұқсат етіңіз.
Dialogue: 0,1:14:48.74,1:14:51.87,JPN,NTP,0000,0000,0000,,Жау кемелеріне шабуылды тексеру! Ат!
Dialogue: 0,1:14:58.41,1:14:59.64,JPN,NTP,0000,0000,0000,,Сэм мен Азума ше?
Dialogue: 0,1:14:59.68,1:15:03.08,JPN,NTP,0000,0000,0000,,Сіз Ғарыш кемесінде зениттік жекпе-жекке өте қуаныштысыз, солай емес пе?
Dialogue: 0,1:15:03.19,1:15:05.81,JPN,NTP,0000,0000,0000,,Иә? Гочун, сенің бетің біртүрлі қызарған көрінеді.
Dialogue: 0,1:15:09.53,1:15:12.09,JPN,NTP,0000,0000,0000,,Жоқ! Ауа жоқ!
Dialogue: 0,1:15:15.10,1:15:15.96,JPN,NTP,0000,0000,0000,,Идиот!
Dialogue: 0,1:15:16.07,1:15:17.62,JPN,NTP,0000,0000,0000,,Қосымша тапсырманы орындаңыз
Dialogue: 0,1:15:17.73,1:15:19.60,JPN,NTP,0000,0000,0000,,Бұл әдейі емес
Dialogue: 0,1:15:20.07,1:15:22.30,JPN,NTP,0000,0000,0000,,Тіпті Лия дұрыс істеп жатыр, солай ма?
Dialogue: 0,1:15:23.41,1:15:24.57,JPN,NTP,0000,0000,0000,,Жарайды, жарайды
Dialogue: 0,1:15:24.71,1:15:25.47,JPN,NTP,0000,0000,0000,,Ах!
Dialogue: 0,1:15:26.71,1:15:27.97,JPN,NTP,0000,0000,0000,,Барлығына! Отыр!
Dialogue: 0,1:15:28.41,1:15:30.17,JPN,NTP,0000,0000,0000,,Кеңістік доғасы қозғалады ма?
Dialogue: 0,1:15:30.28,1:15:31.18,JPN,NTP,0000,0000,0000,,Басталып жатыр ма?
Dialogue: 0,1:15:31.28,1:15:32.11,JPN,NTP,0000,0000,0000,,Құрметті Дуайт!
Dialogue: 0,1:15:32.22,1:15:33.58,JPN,NTP,0000,0000,0000,,Иә, капитанның міндетін атқарушы Лаогэйр!
Dialogue: 0,1:15:34.35,1:15:39.55,JPN,NTP,0000,0000,0000,,Мобильді костюмді іске қосқаннан кейін колонияның күн жағындағы порттың кіреберісіне өтіңіз.
Dialogue: 0,1:15:39.69,1:15:41.52,JPN,NTP,0000,0000,0000,,Жау шахтада.
Dialogue: 0,1:15:41.62,1:15:43.02,JPN,NTP,0000,0000,0000,,Сіз қашып құтылуыңыз керек
Dialogue: 0,1:15:43.13,1:15:44.46,JPN,NTP,0000,0000,0000,,Шығуыңызды өтінемін.
Dialogue: 0,1:15:45.40,1:15:46.76,JPN,NTP,0000,0000,0000,,Енді жүр!
Dialogue: 0,1:15:47.40,1:15:50.96,JPN,NTP,0000,0000,0000,,Seabook пен Аннамари менің оң және сол жағымда тұра алады.
Dialogue: 0,1:15:51.07,1:15:52.83,JPN,NTP,0000,0000,0000,,Мұны колонияда жасауға бола ма?
Dialogue: 0,1:15:52.94,1:15:54.40,JPN,NTP,0000,0000,0000,,Мен сыртта ұрысамын
Dialogue: 0,1:15:55.10,1:15:56.57,JPN,NTP,0000,0000,0000,,Ақымақ болма!
Dialogue: 0,1:15:56.91,1:16:00.00,JPN,NTP,0000,0000,0000,,Жау мина жағындағы қорғаныс шебімізді бұзып өткен сияқты.
Dialogue: 0,1:16:00.14,1:16:00.97,JPN,NTP,0000,0000,0000,,Биргит!
Dialogue: 0,1:16:01.11,1:16:02.27,JPN,NTP,0000,0000,0000,,Оса!
Dialogue: 0,1:16:03.75,1:16:07.18,JPN,NTP,0000,0000,0000,,F91 Gundam теңіз кітабы Кеттік!
Dialogue: 0,1:16:07.28,1:16:08.38,JPN,NTP,0000,0000,0000,,Өтінемін!
Dialogue: 0,1:16:09.65,1:16:13.82,JPN,NTP,0000,0000,0000,,Федерация шағын, бірақ қуатты мобильді костюмдер әзірледі ме?
Dialogue: 0,1:16:13.92,1:16:16.29,JPN,NTP,0000,0000,0000,,Сіз сенімдісіз бе? Анна Мари
Dialogue: 0,1:16:16.66,1:16:19.86,JPN,NTP,0000,0000,0000,,Crossbones найзасының ұшы шахта жағына бекітілді.
Dialogue: 0,1:16:20.76,1:16:24.39,JPN,NTP,0000,0000,0000,,Мен Рона отбасынан шыққан әйелді жеңу мүмкін емес.
Dialogue: 0,1:16:24.50,1:16:25.63,JPN,NTP,0000,0000,0000,,Не?
Dialogue: 0,1:16:25.87,1:16:28.13,JPN,NTP,0000,0000,0000,,Аннамари мен сені шығарамын!
Dialogue: 0,1:16:28.24,1:16:30.47,JPN,NTP,0000,0000,0000,,Оны жіберу қиын емес.
Dialogue: 0,1:16:30.57,1:16:33.44,JPN,NTP,0000,0000,0000,,Иә? Иә, Аннамари, шығыңыз!
Dialogue: 0,1:16:33.91,1:16:36.67,JPN,NTP,0000,0000,0000,,Рахмет, капитан міндетін атқарушы Лаогейр.
Dialogue: 0,1:16:41.62,1:16:44.05,JPN,NTP,0000,0000,0000,,F91 әлі де ұшуда...
Dialogue: 0,1:16:44.62,1:16:47.75,JPN,NTP,0000,0000,0000,,Осы Санарыға келсем де қосалқы бөлшектері жоқ.
Dialogue: 0,1:16:49.59,1:16:54.22,JPN,NTP,0000,0000,0000,,Ғарыш кемесіне қашып кеткен балаларды қалай қарсы аламын?
Dialogue: 0,1:16:56.90,1:16:58.30,JPN,NTP,0000,0000,0000,,Бұл ғарыш кемесі!
Dialogue: 0,1:17:04.47,1:17:09.21,JPN,NTP,0000,0000,0000,,Ақпарат берген әйел маған опасыздық жасайды деп ойламаймын...
Dialogue: 0,1:17:09.45,1:17:12.51,JPN,NTP,0000,0000,0000,,Теңіз кітабы! Саған менің алдымда көрінбе дедім ғой!
Dialogue: 0,1:17:12.65,1:17:15.08,JPN,NTP,0000,0000,0000,,Мен оны жалғыз қалдыра алмаймын.
Dialogue: 0,1:17:15.35,1:17:16.91,JPN,NTP,0000,0000,0000,,Уф! Бұл шахта
Dialogue: 0,1:17:21.92,1:17:25.05,JPN,NTP,0000,0000,0000,,Жердегі Козмо отрядының алға шығуына рұқсат беруіміз керек пе?
Dialogue: 0,1:17:25.16,1:17:27.86,JPN,NTP,0000,0000,0000,,Аа, бұл жерді де басып алады.
Dialogue: 0,1:17:30.10,1:17:32.83,JPN,NTP,0000,0000,0000,,Колонияны басатын күштер кіріп келеді. Иә?
Dialogue: 0,1:17:41.18,1:17:42.67,JPN,NTP,0000,0000,0000,,Бейқам болмаңыз!
Dialogue: 0,1:17:44.25,1:17:47.11,JPN,NTP,0000,0000,0000,,Не? Эй! Не болды!
Dialogue: 0,1:17:47.42,1:17:50.68,JPN,NTP,0000,0000,0000,,Олар жылдам, бұл үлкен Джеган түрі жұмыс істемейді.
Dialogue: 0,1:17:51.15,1:17:54.09,JPN,NTP,0000,0000,0000,,Солай ма... Биргитте?
Dialogue: 0,1:18:02.03,1:18:03.12,JPN,NTP,0000,0000,0000,,Иә, аға, сен кереметсің.
Dialogue: 0,1:18:04.43,1:18:06.33,JPN,NTP,0000,0000,0000,,Арқалық мылтық жақсы емес пе?
Dialogue: 0,1:18:14.78,1:18:16.94,JPN,NTP,0000,0000,0000,,Бұл жігіт... тым күшті...
Dialogue: 0,1:18:19.98,1:18:21.57,JPN,NTP,0000,0000,0000,,Теңіз кітабы Жарайсың!
Dialogue: 0,1:18:21.68,1:18:23.71,JPN,NTP,0000,0000,0000,,Сәйкестік Бұл кездейсоқтық!
Dialogue: 0,1:18:23.82,1:18:28.48,JPN,NTP,0000,0000,0000,,Иә, атыс күші және ұтқырлық. Мен сені бақылауда ұстаймын, сондықтан сен оны таста!
Dialogue: 0,1:18:28.89,1:18:30.32,JPN,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,1:18:36.60,1:18:37.79,JPN,NTP,0000,0000,0000,,Аннамари!
Dialogue: 0,1:18:42.74,1:18:43.71,JPN,NTP,0000,0000,0000,,Бұл Даги Илс пе?
Dialogue: 0,1:18:43.91,1:18:44.93,JPN,NTP,0000,0000,0000,,Сенің есі дұрыс па?
Dialogue: 0,1:18:48.21,1:18:51.11,JPN,NTP,0000,0000,0000,,Жау аумағына кіріп, тоқтай алатын адам бар ма? О!
Dialogue: 0,1:18:53.92,1:18:54.88,JPN,NTP,0000,0000,0000,,Аннамари!
Dialogue: 0,1:18:55.99,1:18:57.48,JPN,NTP,0000,0000,0000,,Кел! Сабина!
Dialogue: 0,1:19:05.40,1:19:08.13,JPN,NTP,0000,0000,0000,,Ноконоко мен Белла Ронаны өзіңізбен бірге алыңыз!
Dialogue: 0,1:19:11.53,1:19:13.80,JPN,NTP,0000,0000,0000,,Сіз шынымен үйіңізге ат алғыңыз келе ме?
Dialogue: 0,1:19:13.90,1:19:16.13,JPN,NTP,0000,0000,0000,,Мені достық ұшақтың коды шатастырды!
Dialogue: 0,1:19:16.61,1:19:20.20,JPN,NTP,0000,0000,0000,,Иә! Мені қылышпен өлтіруді талап етесің бе?
Dialogue: 0,1:19:21.51,1:19:23.07,JPN,NTP,0000,0000,0000,,Аннамари!
Dialogue: 0,1:19:24.21,1:19:26.08,JPN,NTP,0000,0000,0000,,Мен дәл осылай күткенмін!
Dialogue: 0,1:19:26.22,1:19:28.01,JPN,NTP,0000,0000,0000,,Бірге өлейік!
Dialogue: 0,1:19:30.32,1:19:34.05,JPN,NTP,0000,0000,0000,,«Арық дәуірі» атауын алғаннан кейін бұл адамзатты тазарту деп аталды!
Dialogue: 0,1:19:37.73,1:19:40.79,JPN,NTP,0000,0000,0000,,Екеуміз өлсек, өкінішіңіз сейіле ме?
Dialogue: 0,1:19:41.80,1:19:43.46,JPN,NTP,0000,0000,0000,,Аннамари! Құтылып кету!
Dialogue: 0,1:19:49.14,1:19:53.13,JPN,NTP,0000,0000,0000,,Мен сізге эмоцияларын көтере алмайтын адамдар қоқыс екенін айтуым керек еді ...
Dialogue: 0,1:19:55.38,1:19:57.51,JPN,NTP,0000,0000,0000,,Сабина Сіз нені айтып тұрсыз?
Dialogue: 0,1:19:57.88,1:20:02.28,JPN,NTP,0000,0000,0000,,Қарап отырсаңыз, қол астындағыларымның сатқындығы – өзімнің масқаралығым.
Dialogue: 0,1:20:02.39,1:20:03.48,JPN,NTP,0000,0000,0000,,Мені кешіріңіз.
Dialogue: 0,1:20:03.72,1:20:07.85,JPN,NTP,0000,0000,0000,,Солай ма... Тылшы алға, Сабина артқа кетеді!
Dialogue: 0,1:20:08.06,1:20:10.05,JPN,NTP,0000,0000,0000,,Жоқ! Белла Рона
Dialogue: 0,1:20:11.83,1:20:14.30,JPN,NTP,0000,0000,0000,,Бобблдар! Вера машинасынан көзіңізді алмаңыз!
Dialogue: 0,1:20:14.40,1:20:15.66,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,1:20:17.87,1:20:21.33,JPN,NTP,0000,0000,0000,,Аннаның қатысуы жоғалып кетті. Сізге шабуыл жасалды ма... Биргитте!
Dialogue: 0,1:20:25.84,1:20:28.24,JPN,NTP,0000,0000,0000,,Қарсылық жасамаңыз! Барайық!
Dialogue: 0,1:20:30.51,1:20:31.41,JPN,NTP,0000,0000,0000,,Қараңдар!
Dialogue: 0,1:20:39.89,1:20:41.36,JPN,NTP,0000,0000,0000,,Теңіз кітабы! Кешіріңіз!
Dialogue: 0,1:20:41.46,1:20:42.55,JPN,NTP,0000,0000,0000,,Мен осындамын
Dialogue: 0,1:20:45.76,1:20:48.56,JPN,NTP,0000,0000,0000,,Мақсат қоймаңыз! Тек алға ат!
Dialogue: 0,1:20:51.67,1:20:52.93,JPN,NTP,0000,0000,0000,,Иә!
Dialogue: 0,1:20:58.61,1:21:02.98,JPN,NTP,0000,0000,0000,,Жасайық! 3… 2… 1…
Dialogue: 0,1:21:03.11,1:21:04.48,JPN,NTP,0000,0000,0000,,Енді мен сені өз қолыммен бөліп-жарып тастауға мәжбүрмін.
Dialogue: 0,1:21:07.22,1:21:08.58,JPN,NTP,0000,0000,0000,,Керемет!
Dialogue: 0,1:21:19.20,1:21:21.46,JPN,NTP,0000,0000,0000,,Тоқта! Қосымша жұмыс қоспаңыз!
Dialogue: 0,1:21:24.77,1:21:27.83,JPN,NTP,0000,0000,0000,,Сіз жасырын түрде өтіп кеткен жау!
Dialogue: 0,1:21:28.34,1:21:29.93,JPN,NTP,0000,0000,0000,,Ах... жоқ...
Dialogue: 0,1:21:33.58,1:21:37.01,JPN,NTP,0000,0000,0000,,Үш ғарыш доғасы әлі алда ма?
Dialogue: 0,1:21:43.15,1:21:45.31,JPN,NTP,0000,0000,0000,,Бұл жерге не үшін келдің?
Dialogue: 0,1:21:48.79,1:21:52.82,JPN,NTP,0000,0000,0000,,Уф! Колонияның ішінде абайсызда атуға болмайды.
Dialogue: 0,1:22:01.70,1:22:04.83,JPN,NTP,0000,0000,0000,,Колония ішінде жылжымалы костюмді пайдалану...
Dialogue: 0,1:22:08.91,1:22:12.14,JPN,NTP,0000,0000,0000,,Колонияда крейсер бар ма? Белла Рона ше?
Dialogue: 0,1:22:13.38,1:22:16.04,JPN,NTP,0000,0000,0000,,Көпір! Негізгі мылтық сәулесі тым шоғырланған!
Dialogue: 0,1:22:16.15,1:22:17.18,JPN,NTP,0000,0000,0000,,Жеңіңіз! Сіз соқтыңыз!
Dialogue: 0,1:22:18.75,1:22:20.05,JPN,NTP,0000,0000,0000,,Ол қашып кетті!
Dialogue: 0,1:22:20.16,1:22:21.71,JPN,NTP,0000,0000,0000,,Осы мүмкіндікті пайдаланып, басыңызды 180 градусқа бұрыңыз!
Dialogue: 0,1:22:21.82,1:22:23.02,JPN,NTP,0000,0000,0000,,Мен істеп жатырмын!
Dialogue: 0,1:22:23.96,1:22:27.26,JPN,NTP,0000,0000,0000,,Кейн Биржит пен Сибукке шегінуге бұйрық береді!
Dialogue: 0,1:22:27.36,1:22:28.35,JPN,NTP,0000,0000,0000,,Польнарефф?
Dialogue: 0,1:22:36.24,1:22:40.00,JPN,NTP,0000,0000,0000,,Олай болса үйге бара алу керек. Шығу! Сіз әлі сондасыз ба?
Dialogue: 0,1:22:44.95,1:22:46.11,JPN,NTP,0000,0000,0000,,Иә, аға, сен кереметсің.
Dialogue: 0,1:22:51.49,1:22:53.35,JPN,NTP,0000,0000,0000,,Деректерге кірмеген ұшақтар
Dialogue: 0,1:22:59.70,1:23:00.68,JPN,NTP,0000,0000,0000,,Жоқ!
Dialogue: 0,1:23:07.30,1:23:10.00,JPN,NTP,0000,0000,0000,,Олар бұл жерге топ-тобымен келеді!
Dialogue: 0,1:23:10.21,1:23:11.94,JPN,NTP,0000,0000,0000,,Мылтық ұңғы дірілдеп тұр!
Dialogue: 0,1:23:22.65,1:23:24.38,JPN,NTP,0000,0000,0000,,Құрметті Белла!
Dialogue: 0,1:23:30.13,1:23:31.79,JPN,NTP,0000,0000,0000,,Мен жасадым...
Dialogue: 0,1:23:41.00,1:23:43.40,JPN,NTP,0000,0000,0000,,Бұл тыныс алу теңіз кітабы, солай ма?
Dialogue: 0,1:23:44.67,1:23:46.57,JPN,NTP,0000,0000,0000,,Теңіз кітабы, солай ма? Теңіз кітабы!
Dialogue: 0,1:23:46.71,1:23:49.14,JPN,NTP,0000,0000,0000,,Сесили... Сесили?
Dialogue: 0,1:23:49.25,1:23:54.48,JPN,NTP,0000,0000,0000,,Мен Seabook байланыс желісін естимін және сіз оны шынымен басқарып отырсыз.
Dialogue: 0,1:23:54.82,1:23:59.12,JPN,NTP,0000,0000,0000,,Сесили - ақ түсті мобильді костюм киген... неге?
Dialogue: 0,1:24:00.62,1:24:01.78,JPN,NTP,0000,0000,0000,,Сесили!
Dialogue: 0,1:24:02.39,1:24:05.83,JPN,NTP,0000,0000,0000,,Бұлай болды, осылай болды!
Dialogue: 0,1:24:05.93,1:24:07.12,JPN,NTP,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,1:24:07.23,1:24:09.13,JPN,NTP,0000,0000,0000,,Не істеуім керек...
Dialogue: 0,1:24:09.23,1:24:12.93,JPN,NTP,0000,0000,0000,,Сесили шашын кесіп, Рона отбасына оралуды жоспарлаған болатын, солай ма?
Dialogue: 0,1:24:13.04,1:24:16.23,JPN,NTP,0000,0000,0000,,Жоқ! Өйткені сен бәрің де кетіп қалдың...
Dialogue: 0,1:24:16.34,1:24:18.24,JPN,NTP,0000,0000,0000,,Өйткені мен басқа ештеңе істей алмайтындай сезіндім!
Dialogue: 0,1:24:18.64,1:24:20.11,JPN,NTP,0000,0000,0000,,Солай болды ма?
Dialogue: 0,1:24:20.64,1:24:23.51,JPN,NTP,0000,0000,0000,,Мен әлі де Сесили Фэрчайлмын
Dialogue: 0,1:24:28.22,1:24:30.58,JPN,NTP,0000,0000,0000,,Тағы бір бейтаныс мобильді костюм.
Dialogue: 0,1:24:32.96,1:24:35.86,JPN,NTP,0000,0000,0000,,Мен бұл жай ғана жай мәселе емес екенін мойындаймын.
Dialogue: 0,1:24:35.96,1:24:38.72,JPN,NTP,0000,0000,0000,,Мен де ол үйде тұра алмаймын.
Dialogue: 0,1:24:38.83,1:24:40.56,JPN,NTP,0000,0000,0000,,Оны орнатқан сол!
Dialogue: 0,1:24:40.66,1:24:43.56,JPN,NTP,0000,0000,0000,,Сондықтан IV шекарада қырғын болды!
Dialogue: 0,1:24:43.67,1:24:45.26,JPN,NTP,0000,0000,0000,,Бұл Сесили! Уф...
Dialogue: 0,1:24:45.37,1:24:50.30,JPN,NTP,0000,0000,0000,,Мұндағы экипаждың бәрі өлді, ал әскери кемені әуесқойлар басқарады!
Dialogue: 0,1:24:50.41,1:24:54.24,JPN,NTP,0000,0000,0000,,Атам осындай жүйені түзеткісі келді.
Dialogue: 0,1:24:55.21,1:24:58.08,JPN,NTP,0000,0000,0000,,Қазір жай ғана айтып жатқан жоқсың ба? cecily
Dialogue: 0,1:24:58.41,1:24:59.85,JPN,NTP,0000,0000,0000,,Барлығы соған түсіп қалды.
Dialogue: 0,1:24:59.98,1:25:02.75,JPN,NTP,0000,0000,0000,,Мен де жау ұшағын түсірдім. Бұл Айко.
Dialogue: 0,1:25:03.09,1:25:06.82,JPN,NTP,0000,0000,0000,,Әзіл емес! Егер Crossbones-тің де жаңа түрлері болса
Dialogue: 0,1:25:06.92,1:25:08.55,JPN,NTP,0000,0000,0000,,Мен бұл жерде бірдеңе айтуым керек!
Dialogue: 0,1:25:08.66,1:25:09.82,JPN,NTP,0000,0000,0000,,Биргит!
Dialogue: 0,1:25:09.93,1:25:11.39,JPN,NTP,0000,0000,0000,,Капитан міндетін атқарушы…
Dialogue: 0,1:25:11.49,1:25:15.19,JPN,NTP,0000,0000,0000,,Сізге қатысты жағдай күрделі сияқты.
Dialogue: 0,1:25:16.00,1:25:20.03,JPN,NTP,0000,0000,0000,,Бірақ мен нағыз жаудың не екенін көрдім деп ойладым.
Dialogue: 0,1:25:20.14,1:25:25.23,JPN,NTP,0000,0000,0000,,Сонымен... Грусс мырза, мен ол қолданған мобильді костюмді пайдалана аламын ба?
Dialogue: 0,1:25:25.34,1:25:28.31,JPN,NTP,0000,0000,0000,,Гундамның дірілдегені әлдеқайда ауыр.
Dialogue: 0,1:25:28.41,1:25:30.64,JPN,NTP,0000,0000,0000,,Қақпақты осында бекітсеңіз болғаны!
Dialogue: 0,1:25:30.95,1:25:32.85,JPN,NTP,0000,0000,0000,,Барлық ұшақтарды жөндеуге асығыңыз.
Dialogue: 0,1:25:33.78,1:25:36.34,JPN,NTP,0000,0000,0000,,Сіз не ойлап отырсыз?
Dialogue: 0,1:25:36.45,1:25:38.85,JPN,NTP,0000,0000,0000,,Мен мұның абсурд екенін біле тұра осы уақытқа дейін келдім.
Dialogue: 0,1:25:38.95,1:25:42.52,JPN,NTP,0000,0000,0000,,Бірақ бұдан артық кездейсоқтық күтуге болмайды, солай ма?
Dialogue: 0,1:25:42.63,1:25:45.39,JPN,NTP,0000,0000,0000,,Сіз қашу үшін қолыңыздан келгеннің бәрін пайдалануыңыз керек.
Dialogue: 0,1:25:46.03,1:25:51.63,JPN,NTP,0000,0000,0000,,Жарайды... Күннің бұл жағында далада шайқас қалай өтіп жатыр екен...
Dialogue: 0,1:25:51.77,1:25:52.93,JPN,NTP,0000,0000,0000,,Дұрыс...
Dialogue: 0,1:25:53.04,1:25:55.37,JPN,NTP,0000,0000,0000,,Ғарыш кемесі! Мен оны осында қоямын!
Dialogue: 0,1:25:55.47,1:25:56.37,JPN,NTP,0000,0000,0000,,Нант мырза!
Dialogue: 0,1:25:56.47,1:25:57.94,JPN,NTP,0000,0000,0000,,Иә, біз байлаймыз!
Dialogue: 0,1:25:58.04,1:25:59.20,JPN,NTP,0000,0000,0000,,Өтінемін!
Dialogue: 0,1:25:59.84,1:26:04.37,JPN,NTP,0000,0000,0000,,Бұл әскери кеме емес, сондықтан Сесилидің осында болғаны дұрыс.
Dialogue: 0,1:26:04.51,1:26:05.88,JPN,NTP,0000,0000,0000,,Маған көмектес~! Гү…
Dialogue: 0,1:26:08.15,1:26:10.14,JPN,NTP,0000,0000,0000,,Бірінші! бұрын!
Dialogue: 0,1:26:15.69,1:26:18.02,JPN,NTP,0000,0000,0000,,Сесили, не болды?
Dialogue: 0,1:26:21.00,1:26:25.59,JPN,NTP,0000,0000,0000,,Мен... у...
Dialogue: 0,1:26:30.11,1:26:33.67,JPN,NTP,0000,0000,0000,,Жарайды, Сесили осында қала алады.
Dialogue: 0,1:26:37.08,1:26:39.55,JPN,NTP,0000,0000,0000,,—Ой, бұл қорқынышты! -Тоқта мына баланы!
Dialogue: 0,1:26:41.98,1:26:42.85,JPN,NTP,0000,0000,0000,,Оны ашыңыз!
Dialogue: 0,1:26:42.95,1:26:43.65,JPN,NTP,0000,0000,0000,,Иә!
Dialogue: 0,1:26:43.75,1:26:44.65,JPN,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:26:44.75,1:26:45.88,JPN,NTP,0000,0000,0000,,Басқа ештеңе!
Dialogue: 0,1:26:45.99,1:26:47.58,JPN,NTP,0000,0000,0000,,Бұл жігіт! Жіберу!
Dialogue: 0,1:26:47.69,1:26:49.42,JPN,NTP,0000,0000,0000,,Неге кіре алмайсың?
Dialogue: 0,1:26:51.23,1:26:53.96,JPN,NTP,0000,0000,0000,,Санары қызметкерлері түгел Айға бармады ма?
Dialogue: 0,1:26:54.06,1:26:56.40,JPN,NTP,0000,0000,0000,,Бұл жерде де қайтарып алу туралы бұйрық шығарылды.
Dialogue: 0,1:26:56.50,1:26:58.33,JPN,NTP,0000,0000,0000,,F91 осы жерде соғысып жатыр.
Dialogue: 0,1:26:58.43,1:26:59.42,JPN,NTP,0000,0000,0000,,Мен білмеймін!
Dialogue: 0,1:26:59.60,1:27:02.40,JPN,NTP,0000,0000,0000,,Ғарыш кемесі де осы портқа кірді.
Dialogue: 0,1:27:02.50,1:27:03.97,JPN,NTP,0000,0000,0000,,Бұл жер жабық
Dialogue: 0,1:27:04.11,1:27:05.16,JPN,NTP,0000,0000,0000,,Мен… алдымен сені өлтіремін… Буга…ратти…
Dialogue: 0,1:27:05.27,1:27:07.04,JPN,NTP,0000,0000,0000,,Не? о абай бол
Dialogue: 0,1:27:07.18,1:27:09.04,JPN,NTP,0000,0000,0000,,Бүкіл қайықты пайдаланыңыз!
Dialogue: 0,1:27:09.71,1:27:11.68,JPN,NTP,0000,0000,0000,,Қара әскерлер жойылды...
Dialogue: 0,1:27:11.81,1:27:14.51,JPN,NTP,0000,0000,0000,,Өсек – өсек, басқа сөз айтпа!
Dialogue: 0,1:27:14.62,1:27:17.02,JPN,NTP,0000,0000,0000,,Сабинаға да шабуыл жасалған сияқты.
Dialogue: 0,1:27:17.12,1:27:19.18,JPN,NTP,0000,0000,0000,,Ең жақсысы.
Dialogue: 0,1:27:19.29,1:27:21.38,JPN,NTP,0000,0000,0000,,Мұны жаудың бір ғана ұшағы орындады.
Dialogue: 0,1:27:21.49,1:27:23.25,JPN,NTP,0000,0000,0000,,Енді сіздің несие алу мүмкіндігіңіз бар.
Dialogue: 0,1:27:23.49,1:27:26.76,JPN,NTP,0000,0000,0000,,Бұл электр станциясы қайтадан Федерацияның қарамағына өте ме?
Dialogue: 0,1:27:26.86,1:27:27.85,JPN,NTP,0000,0000,0000,,Чип… Чип, чип!
Dialogue: 0,1:27:27.96,1:27:29.66,JPN,NTP,0000,0000,0000,,Замс Галға қуат беру басталады
Dialogue: 0,1:27:29.77,1:27:32.56,JPN,NTP,0000,0000,0000,,Біздің күзет болатынымызға сене алмайсыз ба?
Dialogue: 0,1:27:35.27,1:27:36.74,JPN,NTP,0000,0000,0000,,Ескіргенімен
Dialogue: 0,1:27:36.84,1:27:42.00,JPN,NTP,0000,0000,0000,,Мен қысқа уақыт ішінде үлкен көлемдегі электр энергиясын алу үшін ядролық синтез энергиясын өндіру қажет екенін түсінемін.
Dialogue: 0,1:27:42.14,1:27:44.81,JPN,NTP,0000,0000,0000,,Неліктен бұл Замс Гарда?
Dialogue: 0,1:27:45.65,1:27:50.64,JPN,NTP,0000,0000,0000,,Менің ойымша, бұл байланысты жалғыз нәрсе - «Баку» кодтық атауы...
Dialogue: 0,1:27:59.66,1:28:01.19,JPN,NTP,0000,0000,0000,,Мен Сабина Шаллмын
Dialogue: 0,1:28:01.30,1:28:03.53,JPN,NTP,0000,0000,0000,,Катапульт палубасы жабық
Dialogue: 0,1:28:03.63,1:28:06.07,JPN,NTP,0000,0000,0000,,Жөндеу және жабдықтау туралы не істеуім керек?
Dialogue: 0,1:28:06.17,1:28:10.66,JPN,NTP,0000,0000,0000,,Бұл кеме Темір масканың тікелей басшылығымен арнайы тапсырманы орындауда.
Dialogue: 0,1:28:10.77,1:28:12.97,JPN,NTP,0000,0000,0000,,Жабдықты жөндеу басқа кемеде жүргізілуі керек.
Dialogue: 0,1:28:13.94,1:28:18.51,JPN,NTP,0000,0000,0000,,Бүкіл мобильді костюмдер отряды қалған жауларды жойып, Замс-Галды қорғауы керек.
Dialogue: 0,1:28:18.65,1:28:19.77,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,1:28:22.05,1:28:24.25,JPN,NTP,0000,0000,0000,,Белланың бастаушысы/гуинасы да бар емес пе...
Dialogue: 0,1:28:24.45,1:28:28.25,JPN,NTP,0000,0000,0000,,Жарайды, соғыста өлсе, сол қария түсінер еді.
Dialogue: 0,1:28:28.36,1:28:33.23,JPN,NTP,0000,0000,0000,,Жире Күн жағындағы шайқас Баку іске қосылмай тұрып аяқталуы мүмкін бе?
Dialogue: 0,1:28:33.50,1:28:36.19,JPN,NTP,0000,0000,0000,,Ха! Мен бұл туралы алаңдамаймын
Dialogue: 0,1:28:37.63,1:28:41.09,JPN,NTP,0000,0000,0000,,Мен әлемді бірте-бірте жаңартқым келеді...
Dialogue: 0,1:28:45.14,1:28:48.60,JPN,NTP,0000,0000,0000,,Жарайсың Лиз, рахмет.
Dialogue: 0,1:28:49.31,1:28:50.84,JPN,NTP,0000,0000,0000,,Лидс?
Dialogue: 0,1:28:52.21,1:28:56.05,JPN,NTP,0000,0000,0000,,Егер колонияда болсаң, неге ертерек келмедің?
Dialogue: 0,1:28:56.15,1:29:00.52,JPN,NTP,0000,0000,0000,,Бірде айға барамын деген ниетпен кемеге мініп, қайта оралдың.
Dialogue: 0,1:29:00.66,1:29:02.39,JPN,NTP,0000,0000,0000,,Әкеңе жаным ашиды.
Dialogue: 0,1:29:02.49,1:29:07.16,JPN,NTP,0000,0000,0000,,Жоқ, мені ағам әкелді, сондықтан әкем жалғыз емес еді.
Dialogue: 0,1:29:07.30,1:29:08.79,JPN,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:29:08.90,1:29:13.53,JPN,NTP,0000,0000,0000,,Мен де әкемнен рұқсат алып жұмысқа шықтым.
Dialogue: 0,1:29:13.64,1:29:18.13,JPN,NTP,0000,0000,0000,,Жоқ, бұл дұрыс емес. Жұмыс қызықты болды.
Dialogue: 0,1:29:20.64,1:29:22.11,JPN,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:29:22.91,1:29:26.31,JPN,NTP,0000,0000,0000,,Оған тимеңіз! Өйткені сіз Gundam немесе басқа нәрсе жасайсыз.
Dialogue: 0,1:29:26.42,1:29:28.85,JPN,NTP,0000,0000,0000,,Тіпті ағаң да өліп қала жаздады!
Dialogue: 0,1:29:28.95,1:29:30.32,JPN,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,1:29:30.42,1:29:34.45,JPN,NTP,0000,0000,0000,,Сіздің ұлыңыз Newtype болуы мүмкін. Оның сезімталдығы жақсы.
Dialogue: 0,1:29:34.56,1:29:35.89,JPN,NTP,0000,0000,0000,,Сол бала...
Dialogue: 0,1:29:35.99,1:29:39.72,JPN,NTP,0000,0000,0000,,Иә, біз үлкен нәтижелерге қол жеткіздік.
Dialogue: 0,1:29:39.83,1:29:43.56,JPN,NTP,0000,0000,0000,,Біз соғысып жатырмыз! Тіпті Гундам дірілдейді.
Dialogue: 0,1:29:43.67,1:29:44.56,JPN,NTP,0000,0000,0000,,Мына бала ше?
Dialogue: 0,1:29:44.67,1:29:46.13,JPN,NTP,0000,0000,0000,,Мен қазір демалып жатырмын.
Dialogue: 0,1:29:46.24,1:29:49.30,JPN,NTP,0000,0000,0000,,Ол өлгендей ұйықтап жатыр. Мен оны аяймын...
Dialogue: 0,1:29:49.41,1:29:51.34,JPN,NTP,0000,0000,0000,,Бізге әлі де күш керек
Dialogue: 0,1:29:51.47,1:29:55.07,JPN,NTP,0000,0000,0000,,Тек басқару жүйесін тексеруге көмектессеңіз, мен риза болар едім.
Dialogue: 0,1:29:55.78,1:29:59.61,JPN,NTP,0000,0000,0000,,Мен баламның қару ұстайтынына сенбеймін! Осындай нәрсе үшін
Dialogue: 0,1:29:59.72,1:30:02.62,JPN,NTP,0000,0000,0000,,Мен F91 әзірлеуге қатысқан жоқпын!
Dialogue: 0,1:30:02.72,1:30:04.41,JPN,NTP,0000,0000,0000,,Сонымен не? Ханым!
Dialogue: 0,1:30:04.99,1:30:09.52,JPN,NTP,0000,0000,0000,,Балаңыздан басқа біреу төбелесіп өлсе бәрібір дейсіз бе?
Dialogue: 0,1:30:09.63,1:30:13.39,JPN,NTP,0000,0000,0000,,Жоқ, бұл да дұрыс емес! Бұл дұрыс емес!
Dialogue: 0,1:30:13.50,1:30:14.83,JPN,NTP,0000,0000,0000,,Мұндағылардың бәрі...
Dialogue: 0,1:30:14.93,1:30:19.77,JPN,NTP,0000,0000,0000,,Мына оғаш соғыстан құтылғым келеді, бірақ далаға шығуға қорқамын.
Dialogue: 0,1:30:20.17,1:30:25.80,JPN,NTP,0000,0000,0000,,Сонымен не істеуім керек? Лиза, маған айтыңызшы.
Dialogue: 0,1:30:26.01,1:30:29.17,JPN,NTP,0000,0000,0000,,Соғыс қорқынышты, қорқынышты, біз оны жасамауымыз керек.
Dialogue: 0,1:30:29.31,1:30:31.75,JPN,NTP,0000,0000,0000,,Иә, сондықтан анам
Dialogue: 0,1:30:31.85,1:30:34.41,JPN,NTP,0000,0000,0000,,Биокомпьютерлерді игілікке пайдалану үшін...
Dialogue: 0,1:30:34.55,1:30:35.57,JPN,NTP,0000,0000,0000,,Жо-жоқ… мүмкін емес… осы сөмкенің ішінде не бар!
Dialogue: 0,1:30:36.02,1:30:40.72,JPN,NTP,0000,0000,0000,,Ересектердің ойлауы жақсы. Дәл қазір мобильді костюмді сақтау - менің басты басымдығым.
Dialogue: 0,1:30:40.82,1:30:43.12,JPN,NTP,0000,0000,0000,,Олай етпесек, бәріміз өлеміз.
Dialogue: 0,1:30:43.36,1:30:45.05,JPN,NTP,0000,0000,0000,,Теңіз кітабы…
Dialogue: 0,1:30:45.43,1:30:48.69,JPN,NTP,0000,0000,0000,,Сен есейдің, Лиз екеуміз де.
Dialogue: 0,1:30:50.17,1:30:54.83,JPN,NTP,0000,0000,0000,,Сесили екеуміз мобильді костюмдерді қалай пайдалана алдық?
Dialogue: 0,1:30:54.94,1:30:58.13,JPN,NTP,0000,0000,0000,,Соғыс біткен соң ойланып көрейік.
Dialogue: 0,1:30:58.24,1:31:01.40,JPN,NTP,0000,0000,0000,,Бірақ Newtypes - бұл адамның жаңалықтары.
Dialogue: 0,1:31:01.54,1:31:04.48,JPN,NTP,0000,0000,0000,,Соғысты жеңуге болатын теория да бар, солай ма?
Dialogue: 0,1:31:04.61,1:31:07.64,JPN,NTP,0000,0000,0000,,Олай болса, бізді анықтама ретінде пайдаланыңыз
Dialogue: 0,1:31:07.78,1:31:13.15,JPN,NTP,0000,0000,0000,,Бүкіл адамзаттың жаңа типке айналу жолын ойластыру жаман ой емес пе?
Dialogue: 0,1:31:13.42,1:31:16.72,JPN,NTP,0000,0000,0000,,Иә, енді біз аман қалуымыз керек.
Dialogue: 0,1:31:17.09,1:31:18.58,JPN,NTP,0000,0000,0000,,Өлгеннен кейін ойлау
Dialogue: 0,1:31:18.69,1:31:22.32,JPN,NTP,0000,0000,0000,,Қайтадан бастау қиын, солай емес пе? Әке...
Dialogue: 0,1:31:22.43,1:31:26.16,JPN,NTP,0000,0000,0000,,Жарайды, мен саған әкеңнің бөлігін орындауға көмектесемін.
Dialogue: 0,1:31:26.27,1:31:28.36,JPN,NTP,0000,0000,0000,,Рахмет, анашым.
Dialogue: 0,1:31:30.11,1:31:32.20,JPN,NTP,0000,0000,0000,,Мен бақыттымын Seabook
Dialogue: 0,1:31:33.14,1:31:34.40,JPN,NTP,0000,0000,0000,,Лидс…
Dialogue: 0,1:31:52.86,1:31:54.83,JPN,NTP,0000,0000,0000,,Ұрыс ұзақ жолдан өтті.
Dialogue: 0,1:31:54.93,1:31:57.63,JPN,NTP,0000,0000,0000,,Ол пайда болған бойда Айға қарай бағытты өзгертіңіз.
Dialogue: 0,1:31:57.73,1:31:59.22,JPN,NTP,0000,0000,0000,,Жарайды!
Dialogue: 0,1:32:04.77,1:32:06.64,JPN,NTP,0000,0000,0000,,Ол люкті де ашпа!
Dialogue: 0,1:32:06.78,1:32:09.54,JPN,NTP,0000,0000,0000,,Егер біз жолымызды бөгеп тастасақ, біз кедергі болар едік!
Dialogue: 0,1:32:09.68,1:32:11.91,JPN,NTP,0000,0000,0000,,Пулемет мұнарасы сыртындағыдай!
Dialogue: 0,1:32:12.01,1:32:15.45,JPN,NTP,0000,0000,0000,,Барлығыңыз, қару-жарақ бөлмесіне немесе кеменің ортасына көшіңіздер!
Dialogue: 0,1:32:15.58,1:32:17.58,JPN,NTP,0000,0000,0000,,Қандай люкті пайдалануым керек?
Dialogue: 0,1:32:17.69,1:32:18.95,JPN,NTP,0000,0000,0000,,Бұл кеменің ортасы!
Dialogue: 0,1:32:19.05,1:32:21.25,JPN,NTP,0000,0000,0000,,—Біздің де балаларымыз бар! — Жоқ!
Dialogue: 0,1:32:21.36,1:32:23.09,JPN,NTP,0000,0000,0000,,Бұл жерде қауіпті!
Dialogue: 0,1:32:23.59,1:32:25.62,JPN,NTP,0000,0000,0000,,Неге бортқа бейбіт тұрғындарды отырғыздың!
Dialogue: 0,1:32:25.73,1:32:29.32,JPN,NTP,0000,0000,0000,,Барлығының қолы бос емес екенін байқаған кезде осылай болды.
Dialogue: 0,1:32:29.43,1:32:34.06,JPN,NTP,0000,0000,0000,,Жылжымалы костюммен кемеде қызыл крест белгісін жазу оңай.
Dialogue: 0,1:32:34.17,1:32:35.26,JPN,NTP,0000,0000,0000,,Бұл жақсы!
Dialogue: 0,1:32:35.37,1:32:36.77,JPN,NTP,0000,0000,0000,,Жылжымалы костюмдермен не істеу керек?
Dialogue: 0,1:32:36.87,1:32:39.67,JPN,NTP,0000,0000,0000,,Белгіні жазған соң лақтырамын хаха...
Dialogue: 0,1:32:39.81,1:32:42.90,JPN,NTP,0000,0000,0000,,Бұл шынымен босқын кемесі немесе аурухана кемесі емес пе?
Dialogue: 0,1:32:43.05,1:32:44.71,JPN,NTP,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,1:32:45.48,1:32:48.88,JPN,NTP,0000,0000,0000,,I шекарада шайқас қайта басталған сияқты.
Dialogue: 0,1:32:48.98,1:32:50.11,JPN,NTP,0000,0000,0000,,Полиция қызметкері айтқандай—
Dialogue: 0,1:32:50.45,1:32:53.15,JPN,NTP,0000,0000,0000,,Иә, Космо отряды жойылғалы жатыр!
Dialogue: 0,1:32:53.26,1:32:54.35,JPN,NTP,0000,0000,0000,,Мистер Столкер
Dialogue: 0,1:32:54.46,1:32:56.15,JPN,NTP,0000,0000,0000,,Мен сызықтан өтемін!
Dialogue: 0,1:32:56.26,1:32:59.02,JPN,NTP,0000,0000,0000,,Мен оның не екенін білмеймін! Көмек сұраңыз!
Dialogue: 0,1:32:59.13,1:33:01.06,JPN,NTP,0000,0000,0000,,Айға бағытты бағдарлаңыз
Dialogue: 0,1:33:01.16,1:33:04.96,JPN,NTP,0000,0000,0000,,Ұялы костюм қашу жолында іске қосылуға дайын!
Dialogue: 0,1:33:05.07,1:33:08.23,JPN,NTP,0000,0000,0000,,Миновский бөлшектері жауынгерлік шоғырлануды сақтайды!
Dialogue: 0,1:33:11.91,1:33:13.53,JPN,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,1:33:13.68,1:33:15.64,JPN,NTP,0000,0000,0000,,Сіз тіпті шықпайсыз.
Dialogue: 0,1:33:15.74,1:33:18.91,JPN,NTP,0000,0000,0000,,Сіз сондай бірдеңе жасасаңыз да, маған бірден сенбейсіз!
Dialogue: 0,1:33:19.01,1:33:23.21,JPN,NTP,0000,0000,0000,,Не айтып тұрғаныңызды түсіндім, бірақ бұл бастама
Dialogue: 0,1:33:23.32,1:33:27.55,JPN,NTP,0000,0000,0000,,Crossbone досы/дұшпанының сәйкестендіру коды әлі де сіздің одақтас екеніңізді айтады.
Dialogue: 0,1:33:27.66,1:33:30.15,JPN,NTP,0000,0000,0000,,Сондықтан мен екеуіңе қолдау көрсетуім керек.
Dialogue: 0,1:33:30.26,1:33:32.99,JPN,NTP,0000,0000,0000,,Сізді федералды армия нысанаға алады.
Dialogue: 0,1:33:33.10,1:33:35.83,JPN,NTP,0000,0000,0000,,Ол кезде мен жалғыз боламын.
Dialogue: 0,1:33:35.93,1:33:37.46,JPN,NTP,0000,0000,0000,,Сесили...
Dialogue: 0,1:33:37.83,1:33:42.40,JPN,NTP,0000,0000,0000,,Бұл кеме мені ештеңе айтпастан қабылдады.
Dialogue: 0,1:33:42.50,1:33:44.13,JPN,NTP,0000,0000,0000,,Мен бақытты болдым.
Dialogue: 0,1:33:50.01,1:33:52.00,JPN,NTP,0000,0000,0000,,Биргит, өтінемін.
Dialogue: 0,1:33:52.15,1:33:53.94,JPN,NTP,0000,0000,0000,,Не? Егер бұл Seabook болса...
Dialogue: 0,1:33:54.05,1:33:56.31,JPN,NTP,0000,0000,0000,,Ол қыз өледі.
Dialogue: 0,1:33:56.42,1:33:57.72,JPN,NTP,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,1:33:57.89,1:34:01.38,JPN,NTP,0000,0000,0000,,Ол крест сүйектерінің ханшайымы бола алатын әйел, солай ма?
Dialogue: 0,1:34:04.26,1:34:06.75,JPN,NTP,0000,0000,0000,,Мен сізді естідім, мама.
Dialogue: 0,1:34:09.16,1:34:13.62,JPN,NTP,0000,0000,0000,,Мен анамның басқаларға осылай алаңдағанын бірінші рет көруім.
Dialogue: 0,1:34:13.84,1:34:16.93,JPN,NTP,0000,0000,0000,,Солай ма? Сен жақсы қызсың
Dialogue: 0,1:34:17.04,1:34:18.47,JPN,NTP,0000,0000,0000,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,1:34:27.48,1:34:30.68,JPN,NTP,0000,0000,0000,,Бастапқы жауап мінсіз, егер ол жоспарланғандай өссе.
Dialogue: 0,1:34:30.79,1:34:35.28,JPN,NTP,0000,0000,0000,,I шекарасының 3 миллион халқын тазалауды 2-3 күнде аяқтауға болады.
Dialogue: 0,1:34:35.39,1:34:40.26,JPN,NTP,0000,0000,0000,,Егер бұл сынақ ойдағыдай өтсе, дереу Ай мен Жерге қателерді тастап көрейік.
Dialogue: 0,1:34:40.50,1:34:44.26,JPN,NTP,0000,0000,0000,,Бұл ешкімнің ар-ұжданына зиян келтірмейтін жақсы стратегия болды.
Dialogue: 0,1:34:44.37,1:34:47.06,JPN,NTP,0000,0000,0000,,Машина арқылы кездейсоқ тазалау…
Dialogue: 0,1:35:04.69,1:35:06.48,JPN,NTP,0000,0000,0000,,Бір ғана бөлік!
Dialogue: 0,1:35:12.23,1:35:14.02,JPN,NTP,0000,0000,0000,,Колония жойылады.
Dialogue: 0,1:35:28.64,1:35:31.11,JPN,NTP,0000,0000,0000,,Бұл жылжымалы костюм емес. Бұл не?
Dialogue: 0,1:35:32.61,1:35:35.08,JPN,NTP,0000,0000,0000,,Мен елестете алмаймын, кешіріңіз.
Dialogue: 0,1:35:37.05,1:35:38.68,JPN,NTP,0000,0000,0000,,Оны қалқан ретінде пайдаланыңыз
Dialogue: 0,1:35:38.79,1:35:40.12,JPN,NTP,0000,0000,0000,,Бұл!
Dialogue: 0,1:36:00.11,1:36:01.23,JPN,NTP,0000,0000,0000,,Биргит!
Dialogue: 0,1:36:02.74,1:36:04.23,JPN,NTP,0000,0000,0000,,Бұл тапир ме?
Dialogue: 0,1:36:05.61,1:36:07.78,JPN,NTP,0000,0000,0000,,Бұл қандай машина?
Dialogue: 0,1:36:07.88,1:36:11.51,JPN,NTP,0000,0000,0000,,Мен білмеймін. Бірден көп Crossbone Vanguard бар.
Dialogue: 0,1:36:11.62,1:36:14.56,JPN,NTP,0000,0000,0000,,Жерде мұндай жауыздық қолданылса...
Dialogue: 0,1:36:17.59,1:36:20.19,JPN,NTP,0000,0000,0000,,Күте тұрыңыз! Жеңіске жетуге мүмкіндігіңіз бар ма?
Dialogue: 0,1:36:20.30,1:36:23.23,JPN,NTP,0000,0000,0000,,Оны саған атаң жасады ма? иә? А?
Dialogue: 0,1:36:36.41,1:36:38.38,JPN,NTP,0000,0000,0000,,Биргит! Бұл ақымақ!
Dialogue: 0,1:36:46.32,1:36:48.48,JPN,NTP,0000,0000,0000,,Тек адамдарды өлтіретін машина!
Dialogue: 0,1:36:55.26,1:36:57.20,JPN,NTP,0000,0000,0000,,Осы себепті!
Dialogue: 0,1:37:01.97,1:37:03.30,JPN,NTP,0000,0000,0000,,Көбірек жылжытыңыз!
Dialogue: 0,1:37:06.37,1:37:08.43,JPN,NTP,0000,0000,0000,,Мына жігіттер! Бұл жігіттер! Бұл жігіт!
Dialogue: 0,1:37:10.35,1:37:11.61,JPN,NTP,0000,0000,0000,,Телефон қоңырау шалуда! Телефон...
Dialogue: 0,1:37:24.43,1:37:25.95,JPN,NTP,0000,0000,0000,,Биргитт…
Dialogue: 0,1:37:29.50,1:37:30.69,JPN,NTP,0000,0000,0000,,Бұл өте талғамсыз екен.
Dialogue: 0,1:37:30.80,1:37:32.60,JPN,NTP,0000,0000,0000,,Мен барлық адамдарды өлтіремін.
Dialogue: 0,1:37:32.73,1:37:36.86,JPN,NTP,0000,0000,0000,,Мобильді костюм бөлімшелерін Crossbones флотының муляждары жіберді ме?
Dialogue: 0,1:37:36.97,1:37:40.31,JPN,NTP,0000,0000,0000,,Бұл қарт, флот, тіпті Сабина да білмейтін нәрсе!
Dialogue: 0,1:37:40.44,1:37:41.47,JPN,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,1:37:41.61,1:37:42.54,JPN,NTP,0000,0000,0000,,Темір маска!
Dialogue: 0,1:37:42.64,1:37:43.54,JPN,NTP,0000,0000,0000,,Сіз бір адам туралы айтып отырсыз ба?
Dialogue: 0,1:37:43.65,1:37:46.05,JPN,NTP,0000,0000,0000,,Онда сізде Iron Mask ойнаудан басқа амалыңыз жоқ!
Dialogue: 0,1:37:47.58,1:37:50.42,JPN,NTP,0000,0000,0000,,Тапирлер өте көп. Біз не істеуіміз керек?
Dialogue: 0,1:37:51.09,1:37:54.28,JPN,NTP,0000,0000,0000,,Не? Бұл қауіпті! Бұл жалғыз нәрсе...
Dialogue: 0,1:38:11.74,1:38:12.83,JPN,NTP,0000,0000,0000,,Артында?
Dialogue: 0,1:38:21.55,1:38:23.45,JPN,NTP,0000,0000,0000,,Толығырақ! көбірек! Көбірек кел!
Dialogue: 0,1:38:26.32,1:38:27.55,JPN,NTP,0000,0000,0000,,Уау!
Dialogue: 0,1:39:04.06,1:39:07.09,JPN,NTP,0000,0000,0000,,Қалай қарасаңыз да, бұл Замс Гарудың садақ бөлігі.
Dialogue: 0,1:39:47.84,1:39:48.83,JPN,NTP,0000,0000,0000,,Ядролық?
Dialogue: 0,1:39:50.67,1:39:52.26,JPN,NTP,0000,0000,0000,,Сесили сен мұны істедің бе...
Dialogue: 0,1:39:52.37,1:39:54.27,JPN,NTP,0000,0000,0000,,Гар Плоу жоғалып кетті!
Dialogue: 0,1:39:54.41,1:39:56.17,JPN,NTP,0000,0000,0000,,Мен білемін! тергеу жүргізу
Dialogue: 0,1:39:56.31,1:39:58.18,JPN,NTP,0000,0000,0000,,Жоқ, мен тексеремін.
Dialogue: 0,1:39:58.98,1:40:01.61,JPN,NTP,0000,0000,0000,,Бұл отбасылық мәселе.
Dialogue: 0,1:40:01.72,1:40:03.45,JPN,NTP,0000,0000,0000,,Сіз Раффлезияны босатасыз ба?
Dialogue: 0,1:40:07.56,1:40:10.58,JPN,NTP,0000,0000,0000,,Күте тұрыңыз, бұл шынымен Замс Гару ма?
Dialogue: 0,1:40:10.86,1:40:12.19,JPN,NTP,0000,0000,0000,,Вера ұшағы нысанаға алынды.
Dialogue: 0,1:40:12.89,1:40:13.79,JPN,NTP,0000,0000,0000,,Жарайды, абайлайық.
Dialogue: 0,1:40:13.90,1:40:17.49,JPN,NTP,0000,0000,0000,,Айда жаңа достық сәйкестендіру сигналы пайда болды.
Dialogue: 0,1:40:18.70,1:40:21.64,JPN,NTP,0000,0000,0000,,Бұл ма? Бұл менің одақтасымның түсі...
Dialogue: 0,1:40:21.87,1:40:24.46,JPN,NTP,0000,0000,0000,,Мен мұндай кодты бүгінге дейін көрген емеспін.
Dialogue: 0,1:40:24.57,1:40:26.94,JPN,NTP,0000,0000,0000,,Компьютерде тіркелген
Dialogue: 0,1:40:27.08,1:40:29.24,JPN,NTP,0000,0000,0000,,Тапир? Темір маска!
Dialogue: 0,1:40:29.41,1:40:30.47,JPN,NTP,0000,0000,0000,,Оны Белланың машинасына орнатыңыз
Dialogue: 0,1:40:30.61,1:40:31.58,JPN,NTP,0000,0000,0000,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,1:40:31.68,1:40:34.51,JPN,NTP,0000,0000,0000,,Белла-саманың жүріс-тұрысы біртүрлі! Осы қарқынмен...
Dialogue: 0,1:40:37.62,1:40:39.61,JPN,NTP,0000,0000,0000,,Федералдық армияның жаңа түрі?
Dialogue: 0,1:40:39.72,1:40:44.62,JPN,NTP,0000,0000,0000,,Бұл мүмкін. Себебі, қарт Белла Рона сияқты нәрселерге әуес!
Dialogue: 0,1:40:45.23,1:40:48.79,JPN,NTP,0000,0000,0000,,Мен қателестім. Белла Рона машинасы бүлік шығарды!
Dialogue: 0,1:40:48.90,1:40:49.59,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,1:40:57.21,1:40:59.87,JPN,NTP,0000,0000,0000,,Бір жылжымалы костюм болса да, оның қашып кетуіне жол бермеңіз.
Dialogue: 0,1:41:00.01,1:41:02.24,JPN,NTP,0000,0000,0000,,Барлығына! Әрқайсысына несие беріңіз!
Dialogue: 0,1:41:08.75,1:41:11.28,JPN,NTP,0000,0000,0000,,Үшінші армия мақсатына жете алмады...
Dialogue: 0,1:41:17.43,1:41:21.23,JPN,NTP,0000,0000,0000,,Біз федерацияның айындағы қосымша күштерді алдық.
Dialogue: 0,1:41:34.54,1:41:39.31,JPN,NTP,0000,0000,0000,,Не? Аналық кеме жойылды! Ол жақта жау флоты бар ма?
Dialogue: 0,1:41:42.28,1:41:44.08,JPN,NTP,0000,0000,0000,,Бұл келе жатыр!
Dialogue: 0,1:41:51.19,1:41:53.66,JPN,NTP,0000,0000,0000,,Сіз жалғыз емессіз бе? Белла
Dialogue: 0,1:41:57.53,1:42:00.30,JPN,NTP,0000,0000,0000,,Бетперде кимей ештеңе істей алмайтын адам
Dialogue: 0,1:42:00.40,1:42:01.89,JPN,NTP,0000,0000,0000,,Бұл әлемді реформалау туралы екенін білдіре ме?
Dialogue: 0,1:42:02.14,1:42:05.04,JPN,NTP,0000,0000,0000,,Мұндайды жоспарлаған жау қорқынышты!
Dialogue: 0,1:42:05.14,1:42:06.84,JPN,NTP,0000,0000,0000,,Иә, жау!
Dialogue: 0,1:42:07.44,1:42:10.50,JPN,NTP,0000,0000,0000,,Айдан келген арматуралар жойылған сияқты...
Dialogue: 0,1:42:10.65,1:42:12.94,JPN,NTP,0000,0000,0000,,Мен қайғы ортақ деп ойлағым келеді...
Dialogue: 0,1:42:13.35,1:42:16.78,JPN,NTP,0000,0000,0000,,Сондықтан оны ұру керек, солай ма?
Dialogue: 0,1:42:17.19,1:42:19.59,JPN,NTP,0000,0000,0000,,Иә, бірақ бұл жарық...
Dialogue: 0,1:42:19.69,1:42:24.25,JPN,NTP,0000,0000,0000,,Бұл маған ғаламды мазалаған құбыжық сияқты сезіледі.
Dialogue: 0,1:42:28.00,1:42:30.99,JPN,NTP,0000,0000,0000,,Бұл сөзсіз F91 және Beginner болды, солай ма?
Dialogue: 0,1:42:31.20,1:42:34.17,JPN,NTP,0000,0000,0000,,Ғарыш кемесінің телескопымен расталған
Dialogue: 0,1:42:34.27,1:42:36.70,JPN,NTP,0000,0000,0000,,Бауырым, төбелесіп жүрсің бе?
Dialogue: 0,1:42:36.81,1:42:40.14,JPN,NTP,0000,0000,0000,,Біз қашу жолын да қамтамасыз етуді жоспарлап отырмыз.
Dialogue: 0,1:42:40.28,1:42:42.24,JPN,NTP,0000,0000,0000,,Жоғарғы оң жақтағы жауынгерлік отты әлі де көре аласыз ба?
Dialogue: 0,1:42:42.34,1:42:43.37,JPN,NTP,0000,0000,0000,,Иә!
Dialogue: 0,1:42:43.95,1:42:48.21,JPN,NTP,0000,0000,0000,,Оның босқындар кемесі сияқты көрінуін күту Доктор Аннауд Тынымсыз еңбегіңіз үшін рахмет.
Dialogue: 0,1:42:48.32,1:42:50.55,JPN,NTP,0000,0000,0000,,Жоқ. Сіз тек екі ұшақ көрдіңіз бе?
Dialogue: 0,1:42:50.65,1:42:53.09,JPN,NTP,0000,0000,0000,,Иә Биргитт жауап бермейді
Dialogue: 0,1:42:53.19,1:42:59.18,JPN,NTP,0000,0000,0000,,Сонымен...F91 мен Бегинаның ұшу шарттары қалыптыдан жоғары сияқты.
Dialogue: 0,1:42:59.59,1:43:02.12,JPN,NTP,0000,0000,0000,,Ақылсыз ескерту үшін кешіріңіз.
Dialogue: 0,1:43:02.23,1:43:06.43,JPN,NTP,0000,0000,0000,,Жоқ, мен сіздің I шекарадағы жұмысыңыздың негізінде солай ойлаймын.
Dialogue: 0,1:43:07.14,1:43:11.87,JPN,NTP,0000,0000,0000,,Теңіз кітабы бізге Гундам мен...
Dialogue: 0,1:43:14.48,1:43:17.41,JPN,NTP,0000,0000,0000,,Рахмет... Капитан міндетін атқарушы...
Dialogue: 0,1:43:23.45,1:43:24.35,JPN,NTP,0000,0000,0000,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:43:29.42,1:43:30.86,JPN,NTP,0000,0000,0000,,Бұл ақымақ! Сесили!
Dialogue: 0,1:43:35.06,1:43:36.66,JPN,NTP,0000,0000,0000,,Бұл да қате ме?
Dialogue: 0,1:43:42.90,1:43:45.34,JPN,NTP,0000,0000,0000,,Кет! Сесили!
Dialogue: 0,1:43:50.21,1:43:54.08,JPN,NTP,0000,0000,0000,,Сесили! Колонияның қалдықтарын қалқан ретінде пайдаланыңыз! Апыр-ай!
Dialogue: 0,1:43:57.22,1:43:58.62,JPN,NTP,0000,0000,0000,,Сесили! Шығу!
Dialogue: 0,1:43:58.72,1:43:59.69,JPN,NTP,0000,0000,0000,,Бірақ бұл!
Dialogue: 0,1:43:59.72,1:44:01.48,JPN,NTP,0000,0000,0000,,Маған қалдырыңыз!
Dialogue: 0,1:44:10.37,1:44:11.30,JPN,NTP,0000,0000,0000,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:44:14.67,1:44:17.19,JPN,NTP,0000,0000,0000,,Қандық байланысты өз қолыңмен үз!
Dialogue: 0,1:44:22.58,1:44:26.64,JPN,NTP,0000,0000,0000,,Иә? Жақсы қозғалады! Сіз оны жаңа түрі деп атай аласыз!
Dialogue: 0,1:44:29.25,1:44:31.31,JPN,NTP,0000,0000,0000,,Бұл кабина
Dialogue: 0,1:44:33.05,1:44:34.32,JPN,NTP,0000,0000,0000,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,1:44:36.52,1:44:38.01,JPN,NTP,0000,0000,0000,,Олай болса, осылай істе!
Dialogue: 0,1:44:52.67,1:44:55.77,JPN,NTP,0000,0000,0000,,Гире Мен оның осы кемеден шыққанын байқадым.
Dialogue: 0,1:44:56.34,1:44:57.44,JPN,NTP,0000,0000,0000,,Шынында да солай емес пе?
Dialogue: 0,1:44:57.58,1:45:01.31,JPN,NTP,0000,0000,0000,,Раффлезия, бірақ мен онымен байланысты емеспін.
Dialogue: 0,1:45:01.48,1:45:05.08,JPN,NTP,0000,0000,0000,,Не! Темір маска осылай жұмыс істей ме?
Dialogue: 0,1:45:05.19,1:45:08.42,JPN,NTP,0000,0000,0000,,Мен қатысым жоқ деп айтамын.
Dialogue: 0,1:45:12.26,1:45:13.12,JPN,NTP,0000,0000,0000,,Сесили!
Dialogue: 0,1:45:15.56,1:45:17.72,JPN,NTP,0000,0000,0000,,Мен өз бетімше шешім қабылдай алмаймын.
Dialogue: 0,1:45:17.83,1:45:20.16,JPN,NTP,0000,0000,0000,,Бірақ егер сіз Темір Масканың тікелей бақылауында болмасаңыз.
Dialogue: 0,1:45:20.27,1:45:23.40,JPN,NTP,0000,0000,0000,,Қалағаныңызша жұмыс істей алмасаңыз, бұл басқа әңгіме!
Dialogue: 0,1:45:23.50,1:45:25.23,JPN,NTP,0000,0000,0000,,Сабина! Апыр-ай!
Dialogue: 0,1:45:25.34,1:45:29.74,JPN,NTP,0000,0000,0000,,Рафлезия оқиғасы: Мен бұл туралы білмесем, Мейтцер де білмеді.
Dialogue: 0,1:45:36.08,1:45:40.18,JPN,NTP,0000,0000,0000,,Замс Гару осы әуе кеңістігінде Темір маскасы қайтып келгенше күтеді! Жақсы!
Dialogue: 0,1:45:40.29,1:45:41.52,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,1:45:51.90,1:45:53.23,JPN,NTP,0000,0000,0000,,Бұл тым көп!
Dialogue: 0,1:45:55.50,1:45:58.60,JPN,NTP,0000,0000,0000,,Егер оны адамдар жасаған болса! Ах! Ах!
Dialogue: 0,1:46:04.05,1:46:05.01,JPN,NTP,0000,0000,0000,,Темір маска!
Dialogue: 0,1:46:05.11,1:46:08.61,JPN,NTP,0000,0000,0000,,Маған жақындағың келген сияқты, мен осылай істедім...
Dialogue: 0,1:46:08.75,1:46:13.71,JPN,NTP,0000,0000,0000,,Мен сені шынымен жаман қыз деп ойлаймын. Үлкендердің не істейтініне күмәндану дұрыс емес.
Dialogue: 0,1:46:14.02,1:46:15.28,JPN,NTP,0000,0000,0000,,Тіпті сен
Dialogue: 0,1:46:15.39,1:46:18.83,JPN,NTP,0000,0000,0000,,Ол адам болып жаратылғандықтан, ол атасына қарсы шығып жатыр!
Dialogue: 0,1:46:18.93,1:46:21.92,JPN,NTP,0000,0000,0000,,Бірақ егер сіздің бойыңызда әлі де адамшылық болса, дәл қазір.
Dialogue: 0,1:46:22.03,1:46:23.40,JPN,NTP,0000,0000,0000,,Мұны істеме!
Dialogue: 0,1:46:23.50,1:46:27.80,JPN,NTP,0000,0000,0000,,Егер саған адамзаттың оннан тоғызын жою бұйырылса, солай болар еді!
Dialogue: 0,1:46:27.90,1:46:30.39,JPN,NTP,0000,0000,0000,,Машиналар сөйлей алады!
Dialogue: 0,1:46:33.47,1:46:34.74,JPN,NTP,0000,0000,0000,,Сесили!
Dialogue: 0,1:46:40.85,1:46:45.44,JPN,NTP,0000,0000,0000,,Мен машина емеспін, мен өз миссиямды орындау үшін бар болғаны эгомын күшейтушімін!
Dialogue: 0,1:46:47.46,1:46:50.19,JPN,NTP,0000,0000,0000,,Қашуға арналған қазан да жұмыс істемей ме?
Dialogue: 0,1:46:55.10,1:46:57.53,JPN,NTP,0000,0000,0000,,Фухахаха қорықпайсың ба?
Dialogue: 0,1:47:06.84,1:47:08.74,JPN,NTP,0000,0000,0000,,Сонымен қатар, ми толқындарын басқаруға болады
Dialogue: 0,1:47:15.22,1:47:19.45,JPN,NTP,0000,0000,0000,,Сонымен қатар, мен бұл машинаны пайдаланып қол-аяғымды пайдаланбай-ақ өзімді басқара аламын.
Dialogue: 0,1:47:19.55,1:47:21.52,JPN,NTP,0000,0000,0000,,Маған Надя сияқты менсінбей қарайтыныңызға сенбеймін!
Dialogue: 0,1:47:21.76,1:47:24.52,JPN,NTP,0000,0000,0000,,Әйелдерді басқару қиын!
Dialogue: 0,1:47:24.63,1:47:28.19,JPN,NTP,0000,0000,0000,,Бұған себепші болған сен едің, масканы шеше алмайсың!
Dialogue: 0,1:47:28.30,1:47:29.79,JPN,NTP,0000,0000,0000,,Сіз әлі де айтасыз ба?
Dialogue: 0,1:47:32.03,1:47:33.09,JPN,NTP,0000,0000,0000,,Не?!
Dialogue: 0,1:47:40.84,1:47:42.74,JPN,NTP,0000,0000,0000,,Қанша ұшақ бар және жау ше?
Dialogue: 0,1:47:46.35,1:47:47.41,JPN,NTP,0000,0000,0000,,Сесили!
Dialogue: 0,1:47:54.59,1:47:57.42,JPN,NTP,0000,0000,0000,,Сіз бұл массасы бар кейінгі кескін деп айтасыз ба?
Dialogue: 0,1:48:00.06,1:48:01.29,JPN,NTP,0000,0000,0000,,Сіз ұсталып қаласыз ба?
Dialogue: 0,1:48:04.53,1:48:07.16,JPN,NTP,0000,0000,0000,,Сіз кейінгі кескінге шабуыл жасайсыз ба?
Dialogue: 0,1:48:07.34,1:48:08.43,JPN,NTP,0000,0000,0000,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,1:48:12.07,1:48:14.63,JPN,NTP,0000,0000,0000,,Сен маған мұны пайдалануымды айтып тұрсың ба, Сесили?
Dialogue: 0,1:48:22.72,1:48:26.62,JPN,NTP,0000,0000,0000,,Бір ғана мобильді костюм қозғалтқышы және бәрі де!
Dialogue: 0,1:48:30.19,1:48:31.42,JPN,NTP,0000,0000,0000,,Онда?
Dialogue: 0,1:48:39.43,1:48:40.76,JPN,NTP,0000,0000,0000,,О, Құдайым!
Dialogue: 0,1:48:44.81,1:48:46.80,JPN,NTP,0000,0000,0000,,Бұл құбыжық па?
Dialogue: 0,1:49:02.06,1:49:05.03,JPN,NTP,0000,0000,0000,,Жылжымалы костюмдердің осындай үлкен армиясы болды ма?
Dialogue: 0,1:49:05.13,1:49:06.12,JPN,NTP,0000,0000,0000,,Жауларды іздеңіз Асығыңыз!
Dialogue: 0,1:49:06.23,1:49:07.13,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,1:49:15.70,1:49:20.07,JPN,NTP,0000,0000,0000,,Сесили Сесили! Қайда кетті?
Dialogue: 0,1:49:20.21,1:49:22.47,JPN,NTP,0000,0000,0000,,Ол қайда? Бұл қайда! Сесили!
Dialogue: 0,1:49:22.68,1:49:26.41,JPN,NTP,0000,0000,0000,,Бұлай істеудің қажеті жоқ!
Dialogue: 0,1:49:34.12,1:49:35.82,JPN,NTP,0000,0000,0000,,Бұл бір ғана ұшақ болса ше?
Dialogue: 0,1:49:35.92,1:49:40.26,JPN,NTP,0000,0000,0000,,Бұл қабілетсіз мобильді костюм осы әуе кеңістігіндегі жалғыз киім бе?
Dialogue: 0,1:49:40.36,1:49:41.95,JPN,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,1:49:48.90,1:49:53.24,JPN,NTP,0000,0000,0000,,Сесили, маған жарық шығаратын сигналды көрсет! Бұл қайда?
Dialogue: 0,1:49:53.34,1:49:56.44,JPN,NTP,0000,0000,0000,,Сесили? Белла Ронаны іздеп жүрсіз бе?
Dialogue: 0,1:49:57.41,1:50:01.14,JPN,NTP,0000,0000,0000,,Осылайша сіз Раффлезияны жеңе алдыңыз... Бұл көп жұмыс болды.
Dialogue: 0,1:50:14.13,1:50:15.25,JPN,NTP,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,1:50:15.36,1:50:18.20,JPN,NTP,0000,0000,0000,,Капитанның міндетін атқарушының жауабын тыңдау
Dialogue: 0,1:50:24.31,1:50:27.30,JPN,NTP,0000,0000,0000,,200 босқындар сол кемеде расталды.
Dialogue: 0,1:50:28.54,1:50:30.07,JPN,NTP,0000,0000,0000,,Жарайды, мен сені шығарып саламын.
Dialogue: 0,1:50:30.31,1:50:33.75,JPN,NTP,0000,0000,0000,,Бірақ бұл жаттығу кемесі болса да, ол әлі де әскери кеме.
Dialogue: 0,1:50:33.88,1:50:36.48,JPN,NTP,0000,0000,0000,,Біз де тапир мен рафлезия болуды жоспарлап отырмыз ба?
Dialogue: 0,1:50:36.58,1:50:38.05,JPN,NTP,0000,0000,0000,,Жоқ, бірақ...
Dialogue: 0,1:50:38.15,1:50:40.78,JPN,NTP,0000,0000,0000,,Содан кейін кем дегенде бір босқын кемесін жіберіп алыңыз.
Dialogue: 0,1:50:40.89,1:50:41.95,JPN,NTP,0000,0000,0000,,Хмм...
Dialogue: 0,1:50:42.06,1:50:44.05,JPN,NTP,0000,0000,0000,,Бұл оның анасы болуы мүмкін.
Dialogue: 0,1:50:44.16,1:50:44.89,JPN,NTP,0000,0000,0000,,Не?
Dialogue: 0,1:50:44.99,1:50:49.36,JPN,NTP,0000,0000,0000,,Жоқ, жақсы. Мен Дрелл батальонымен қосылып, жеңіспен ораламын!
Dialogue: 0,1:50:49.46,1:50:50.43,JPN,NTP,0000,0000,0000,,Ха!
Dialogue: 0,1:51:00.27,1:51:02.04,JPN,NTP,0000,0000,0000,,Жылжымалы костюм қалыптастыру
Dialogue: 0,1:51:02.48,1:51:05.64,JPN,NTP,0000,0000,0000,,Олар Федерацияның күшейткіштеріне айдан шабуыл жасағандар.
Dialogue: 0,1:51:10.02,1:51:14.35,JPN,NTP,0000,0000,0000,,Мен оны аз уақыттан кейін шығарамын. Қараңызшы, ай әдемі, солай емес пе?
Dialogue: 0,1:51:14.52,1:51:16.22,JPN,NTP,0000,0000,0000,,Теңіз кітабы әлі де тірі!
Dialogue: 0,1:51:16.32,1:51:18.12,JPN,NTP,0000,0000,0000,,Не деп айқайлап тұрсың? теңіз кітабы
Dialogue: 0,1:51:18.46,1:51:20.12,JPN,NTP,0000,0000,0000,,Сесили жынды болды ма?
Dialogue: 0,1:51:20.23,1:51:22.82,JPN,NTP,0000,0000,0000,,Бегина Джина жеңілді, солай ма?
Dialogue: 0,1:51:23.26,1:51:25.46,JPN,NTP,0000,0000,0000,,Иә? Бұл рас па?
Dialogue: 0,1:51:25.60,1:51:28.30,JPN,NTP,0000,0000,0000,,Иә! Тек Сесили таң қалды ма?
Dialogue: 0,1:51:28.57,1:51:32.20,JPN,NTP,0000,0000,0000,,Бұл рас па? Иә...! Сіз оны көрдіңіз!
Dialogue: 0,1:51:32.31,1:51:36.47,JPN,NTP,0000,0000,0000,,Миновский бөлшектері жіңішкерсе де, біздің радарымыз жақсы емес!
Dialogue: 0,1:51:36.84,1:51:40.18,JPN,NTP,0000,0000,0000,,Мені сол жерден және ғарыш кемесінің радарынан табыңыз!
Dialogue: 0,1:51:40.28,1:51:42.27,JPN,NTP,0000,0000,0000,,Әлем әлі толық анық емес!
Dialogue: 0,1:51:42.42,1:51:45.68,JPN,NTP,0000,0000,0000,,Айналада көптеген машиналар бөліктері қалқып жүр.
Dialogue: 0,1:51:45.79,1:51:47.95,JPN,NTP,0000,0000,0000,,Сондықтан мені жалғыз қалдыра алмайсың!
Dialogue: 0,1:51:48.06,1:51:49.52,JPN,NTP,0000,0000,0000,,Айға бармайсың ба?
Dialogue: 0,1:51:49.62,1:51:54.62,JPN,NTP,0000,0000,0000,,Иә? Апатты іздейтін барлық мүшелерді 360 градустық бақылау!
Dialogue: 0,1:51:54.73,1:51:57.82,JPN,NTP,0000,0000,0000,,Сесили ғарышта тірі ме?
Dialogue: 0,1:51:59.37,1:52:00.99,JPN,NTP,0000,0000,0000,,Тыныш бол, Кочун
Dialogue: 0,1:52:01.40,1:52:04.86,JPN,NTP,0000,0000,0000,,Ай ана жерде... I шекара сол жерде...
Dialogue: 0,1:52:05.01,1:52:10.07,JPN,NTP,0000,0000,0000,,Күн ана жақта болды... Сол жарылыстан осында ағып кетті...
Dialogue: 0,1:52:10.41,1:52:12.57,JPN,NTP,0000,0000,0000,,Теңіз кітабы Мен оны іздей аламын!
Dialogue: 0,1:52:13.61,1:52:14.64,JPN,NTP,0000,0000,0000,,Ана
Dialogue: 0,1:52:14.78,1:52:18.51,JPN,NTP,0000,0000,0000,,Псикомму мен радар координаталарын қабаттастыруға болады.
Dialogue: 0,1:52:18.62,1:52:19.61,JPN,NTP,0000,0000,0000,,Анашым!
Dialogue: 0,1:52:22.49,1:52:23.58,JPN,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,1:52:23.69,1:52:27.96,JPN,NTP,0000,0000,0000,,F91-де ми толқындарына жауап беретін жүйе бар екенін білесіз бе?
Dialogue: 0,1:52:28.06,1:52:28.86,JPN,NTP,0000,0000,0000,,Аз
Dialogue: 0,1:52:28.96,1:52:30.69,JPN,NTP,0000,0000,0000,,Оны сенсорға айналдырыңыз.
Dialogue: 0,1:52:30.80,1:52:31.89,JPN,NTP,0000,0000,0000,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,1:52:32.00,1:52:34.19,JPN,NTP,0000,0000,0000,,Бұл жылуды анықтау деңгейі
Dialogue: 0,1:52:34.30,1:52:38.14,JPN,NTP,0000,0000,0000,,Адам шығаратын жылудың толқын ұзындығын ғана сүзіңіз.
Dialogue: 0,1:52:38.24,1:52:40.73,JPN,NTP,0000,0000,0000,,Оны радар дисплейіне қосыңыз…
Dialogue: 0,1:52:40.88,1:52:43.84,JPN,NTP,0000,0000,0000,,Бұл сіздің қабылдауыңызды бірнеше есе арттыруы керек...
Dialogue: 0,1:52:46.58,1:52:48.41,JPN,NTP,0000,0000,0000,,Бірақ бұл сіздің сезімталдығыңызға байланысты.
Dialogue: 0,1:52:49.25,1:52:51.22,JPN,NTP,0000,0000,0000,,Басқаша айтқанда, оны сезесіз бе?
Dialogue: 0,1:52:51.35,1:52:52.84,JPN,NTP,0000,0000,0000,,Иә, иә...
Dialogue: 0,1:52:53.45,1:52:57.39,JPN,NTP,0000,0000,0000,,Машина оны пайдаланатын адамнан кем емес! Сіз қалай ойлайсыз?
Dialogue: 0,1:52:57.76,1:53:04.03,JPN,NTP,0000,0000,0000,,Қарғыс атсын! Камералардың жартысынан көбі өлі!
Dialogue: 0,1:53:04.13,1:53:06.53,JPN,NTP,0000,0000,0000,,Егер сіз алдарыңыздағы табиғат көрінісіне түсіп қалсаңыз
Dialogue: 0,1:53:06.63,1:53:09.60,JPN,NTP,0000,0000,0000,,Мен ештеңе көрмеймін, мен ештеңе сезбеймін!
Dialogue: 0,1:53:09.70,1:53:13.57,JPN,NTP,0000,0000,0000,,Бірақ жоқ! Мен ештеңе сезе алмаймын!
Dialogue: 0,1:53:13.71,1:53:18.58,JPN,NTP,0000,0000,0000,,Тыныштық жасама, ойыңды тыныш ұста, сезіміңді біріктір.
Dialogue: 0,1:53:18.68,1:53:20.08,JPN,NTP,0000,0000,0000,,Санаңызды босатыңыз
Dialogue: 0,1:53:20.08,1:53:24.81,JPN,NTP,0000,0000,0000,,Ғарышта қалқып бара жатқан өмірдің жүрек соғысына ғана сезімдеріңізді ашыңыз.
Dialogue: 0,1:53:25.19,1:53:29.09,JPN,NTP,0000,0000,0000,,Тек сені қалайтын өмір шақырады, солай ма?
Dialogue: 0,1:53:35.86,1:53:36.96,JPN,NTP,0000,0000,0000,,Ол қозғалды.
Dialogue: 0,1:53:37.06,1:53:38.26,JPN,NTP,0000,0000,0000,,Түсіндіңіз бе?
Dialogue: 0,1:53:38.37,1:53:40.27,JPN,NTP,0000,0000,0000,,Радионы қолданбаңыз!
Dialogue: 0,1:54:00.45,1:54:04.75,JPN,NTP,0000,0000,0000,,Теңіз кітабы Ол қызға сенен басқа кім қамқор болады?
Dialogue: 0,1:54:05.03,1:54:09.79,JPN,NTP,0000,0000,0000,,Бірақ бірақ! Мен ештеңе сезе алмаймын!
Dialogue: 0,1:54:10.40,1:54:16.30,JPN,NTP,0000,0000,0000,,Олай болса, жақынырақ тартыңыз! Бұл адам өмірінің құдіреті.
Dialogue: 0,1:54:16.77,1:54:19.03,JPN,NTP,0000,0000,0000,,Тартады дейді...
Dialogue: 0,1:54:24.85,1:54:26.40,JPN,NTP,0000,0000,0000,,Бұл жарық ше?
Dialogue: 0,1:54:27.08,1:54:28.07,JPN,NTP,0000,0000,0000,,Бұл Верния!
Dialogue: 0,1:54:28.22,1:54:29.68,JPN,NTP,0000,0000,0000,,Не? не болды?
Dialogue: 0,1:54:30.18,1:54:32.02,JPN,NTP,0000,0000,0000,,Сіз мұны сездіңіз бе? Сесили
Dialogue: 0,1:54:32.49,1:54:36.32,JPN,NTP,0000,0000,0000,,Жоқ, бұл гүл. Бұл Сесилидің гүлі!
Dialogue: 0,1:54:36.52,1:54:37.65,JPN,NTP,0000,0000,0000,,Сесили гүлі?
Dialogue: 0,1:54:37.76,1:54:40.19,JPN,NTP,0000,0000,0000,,Сіз Сесили туралы шешім қабылдадыңыз!
Dialogue: 0,1:54:41.43,1:54:43.66,JPN,NTP,0000,0000,0000,,Бір нониус тым көп!
Dialogue: 0,1:55:44.83,1:55:46.38,JPN,NTP,0000,0000,0000,,Сесили
Dialogue: 0,1:55:56.30,1:55:57.96,JPN,NTP,0000,0000,0000,,Сесили!
Dialogue: 0,1:56:06.85,1:56:09.11,JPN,NTP,0000,0000,0000,,Ах... Теңіз кітабы...
Dialogue: 0,0:26:32.03,0:26:36.12,Song,NTP,0000,0000,0000,,Мұңның бір бөлшегі сияқты
Dialogue: 0,0:26:37.13,0:26:41.52,Song,NTP,0000,0000,0000,,Қаланы жауып тұрған шыны түсті қар
Dialogue: 0,0:26:42.43,0:26:46.22,Song,NTP,0000,0000,0000,,Ертеңгі күнді іздеген көздер де
Dialogue: 0,0:26:47.13,0:26:52.02,Song,NTP,0000,0000,0000,,Қараңғылықтың арғы жағындағы бұлт
Dialogue: 0,0:26:52.63,0:26:56.82,Song,NTP,0000,0000,0000,,Белгісіз күш сыпырып алып кетті
Dialogue: 0,0:26:57.43,0:27:01.92,Song,NTP,0000,0000,0000,,Жүрегім бір жерде аурады
Dialogue: 0,0:27:02.63,0:27:07.52,Song,NTP,0000,0000,0000,,Кеуденің тереңінде, Көзімнен жас ағып кететіндей
Dialogue: 0,0:27:07.93,0:27:13.62,Song,NTP,0000,0000,0000,,Тек жүрек соғуы ғана шын тірі
Dialogue: 0,0:27:16.13,0:27:20.52,Song,NTP,0000,0000,0000,,Жарқыраған желде
Dialogue: 0,0:27:21.00,0:27:25.70,Song,NTP,0000,0000,0000,,Даусыңды естимін
Dialogue: 0,0:27:26.33,0:27:30.72,Song,NTP,0000,0000,0000,,Тыныштықты мәңгілік бұзбау үшін дұға ет
Dialogue: 0,0:27:31.13,0:27:37.32,Song,NTP,0000,0000,0000,,Мен бұл кереметке сенемін
Dialogue: 0,1:55:38.78,1:55:42.72,ED,NTP,0000,0000,0000,,Мұңның бір бөлшегі сияқты
Dialogue: 0,1:55:44.13,1:55:48.42,ED,NTP,0000,0000,0000,,Қаланы бұлт басқан шыны түсті қар
Dialogue: 0,1:55:49.35,1:55:53.12,ED,NTP,0000,0000,0000,,Тіпті ертеңгі күнді іздеген көздер
Dialogue: 0,1:55:54.50,1:55:58.92,ED,NTP,0000,0000,0000,,Қараңғылықтың арғы жағында бұлтты
Dialogue: 0,1:55:59.40,1:56:03.82,ED,NTP,0000,0000,0000,,Белгісіз күш сыпырып алып кетті
Dialogue: 0,1:56:04.55,1:56:09.02,ED,NTP,0000,0000,0000,,Жүрегім бір жерде аурады
Dialogue: 0,1:56:09.85,1:56:14.32,ED,NTP,0000,0000,0000,,Кеуденің тереңінде, Көз жасымды төге жаздадым
Dialogue: 0,1:56:14.80,1:56:20.52,ED,NTP,0000,0000,0000,,Тек жүрек соғуы ғана шын тірі
Dialogue: 0,1:56:22.85,1:56:27.42,ED,NTP,0000,0000,0000,,Жарқыраған желде
Dialogue: 0,1:56:27.65,1:56:32.70,ED,NTP,0000,0000,0000,,Мен сенің дауысыңды естимін
Dialogue: 0,1:56:33.30,1:56:37.72,ED,NTP,0000,0000,0000,,Тыныштықты мәңгілік бұзбау үшін дұға ет
Dialogue: 0,1:56:38.10,1:56:44.42,ED,NTP,0000,0000,0000,,Мен бұл кереметке сенемін
Dialogue: 0,1:56:59.65,1:57:03.72,ED,NTP,0000,0000,0000,,Көк көкжиек
Dialogue: 0,1:57:05.03,1:57:09.22,ED,NTP,0000,0000,0000,,Өйткені бұл көздер әлі есінде
Dialogue: 0,1:57:10.03,1:57:14.32,ED,NTP,0000,0000,0000,,Қабағымды жұмысам, үйге бара аламын.
Dialogue: 0,1:57:15.43,1:57:19.72,ED,NTP,0000,0000,0000,,Жылы шақ, естеліктер
Dialogue: 0,1:57:20.33,1:57:24.62,ED,NTP,0000,0000,0000,,Қателерді үнемі қайталау
Dialogue: 0,1:57:25.43,1:57:29.82,ED,NTP,0000,0000,0000,,Ақымақ жаратылысқа айналу
Dialogue: 0,1:57:30.63,1:57:35.02,ED,NTP,0000,0000,0000,,Тіпті сіздің өмір сүруіңіз тек зиян тигізсе де
Dialogue: 0,1:57:35.50,1:57:41.42,ED,NTP,0000,0000,0000,,Көз жасы сондай, Мен оны ешқашан көрсетпеймін.
Dialogue: 0,1:57:43.65,1:57:48.25,ED,NTP,0000,0000,0000,,Жарқыраған желде
Dialogue: 0,1:57:48.63,1:57:53.52,ED,NTP,0000,0000,0000,,Сіз күліп тұрсыз
Dialogue: 0,1:57:54.10,1:57:58.52,ED,NTP,0000,0000,0000,,Тыныштықты мәңгілік бұзбау үшін дұға ет
Dialogue: 0,1:57:59.03,1:58:06.42,ED,NTP,0000,0000,0000,,Сол жалт-жұлтқа қарап
Dialogue: 0,1:58:25.83,1:58:29.82,ED,NTP,0000,0000,0000,,Төзгісіз ауырсыну кімге арналған?
Dialogue: 0,1:58:31.00,1:58:35.52,ED,NTP,0000,0000,0000,,Мен мұны түсіндім деп ойлаймын.
Dialogue: 0,1:58:36.33,1:58:40.42,ED,NTP,0000,0000,0000,,Кездейсоқ кездесу - осындай керемет.
Dialogue: 0,1:58:41.43,1:58:45.92,ED,NTP,0000,0000,0000,,Миллиардтаған жұлдыздар қыдыратын ғалам
Dialogue: 0,1:58:46.33,1:58:50.92,ED,NTP,0000,0000,0000,,Қош бол мені үйретті
Dialogue: 0,1:58:51.43,1:58:56.12,ED,NTP,0000,0000,0000,,Сіздің шынайы мейірімділігіңіз
Dialogue: 0,1:58:56.95,1:59:01.22,ED,NTP,0000,0000,0000,,Басқа біреуден маңыздырақ
Dialogue: 0,1:59:01.85,1:59:08.02,ED,NTP,0000,0000,0000,,Мен мұны күнде мақтанышпен айта аламын
Dialogue: 0,1:59:10.00,1:59:14.40,ED,NTP,0000,0000,0000,,Жарқыраған желде
Dialogue: 0,1:59:14.80,1:59:19.75,ED,NTP,0000,0000,0000,,Сіз күліп тұрсыз
Dialogue: 0,1:59:20.23,1:59:24.70,ED,NTP,0000,0000,0000,,Тыныштықты мәңгілік бұзбау үшін дұға ет
Dialogue: 0,1:59:25.05,1:59:30.95,ED,NTP,0000,0000,0000,,Сол жалт-жұлтқа қарап
Dialogue: 0,1:59:30.95,1:59:35.12,ED,NTP,0000,0000,0000,,Тыныштықты мәңгілік бұзбау үшін дұға ет
Dialogue: 0,1:59:35.60,1:59:45.22,ED,NTP,0000,0000,0000,,Ыстық көздеріңе күйіп кет
