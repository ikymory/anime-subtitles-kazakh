Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.00,0:00:48.01,Default,,0,0,0,,/～
Dialogue: 0,0:00:48.01,0:00:51.18,Default,,0,0,0,,Долорис.
Dialogue: 0,0:00:51.18,0:00:55.85,Default,,0,0,0,,Долорис Ал, бұл оянатын түн.
Dialogue: 0,0:00:55.85,0:00:58.35,Default,,0,0,0,,Мен сені оятайын ба?
Dialogue: 0,0:00:58.35,0:01:01.19,Default,,0,0,0,,Егер мен өзімді оятуға мәжбүр етсем, жаным жойылуы мүмкін.
Dialogue: 0,0:01:01.19,0:01:03.69,Default,,0,0,0,,Әпке... (Шоко) Жарайды.
Dialogue: 0,0:01:03.69,0:01:06.36,Default,,0,0,0,,Ай сәулесі сені оятады.
Dialogue: 0,0:01:06.36,0:01:11.03,Default,,0,0,0,,Көлеңке жұтқан ай қайта тіріледі>
Dialogue: 0,0:01:11.03,0:01:15.70,Default,,0,0,0,,Бейшара қуыршақ басқа өмірге кіріседі.
Dialogue: 0,0:01:15.70,0:01:31.72,Default,,0,0,0,,/～
Dialogue: 0,0:01:31.72,0:01:35.49,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:01:35.49,0:01:37.49,Default,,0,0,0,,Енді бастайық.
Dialogue: 0,0:01:37.49,0:01:40.16,Default,,0,0,0,,Бүгін кешке маскарад!
Dialogue: 0,0:01:40.16,0:01:48.67,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:48.67,0:02:15.03,Default,,0,0,0,,/～
Dialogue: 0,0:02:15.03,0:02:19.70,Default,,0,0,0,,/ «Ойналатын және барлық жерде тамшылататын дыбыссыз дыбыс»
Dialogue: 0,0:02:19.70,0:02:24.54,Default,,0,0,0,,/ "Атыңнан бас тарттың. Мозаикаң жылап тұр."
Dialogue: 0,0:02:24.54,0:02:26.88,Default,,0,0,0,,/「ｃａｎ ｎｏｔ， ｃａｎ ｎｏｔ， ｎｏｔ， ｎｏｔ， ｎｏｔ ｄｅｎｙ」
Dialogue: 0,0:02:26.88,0:02:30.55,Default,,0,0,0,,/ «Даусыз шындық»
Dialogue: 0,0:02:30.55,0:02:34.15,Default,,0,0,0,,/ «Енді, оны сол жерде қалдырып, кері қайтыңыз».
Dialogue: 0,0:02:34.15,0:02:40.32,Default,,0,0,0,,/ «Энергия - бұл цикл, дәл қазір гравитация жоқ»
Dialogue: 0,0:02:40.32,0:02:47.66,Default,,0,0,0,,/ «Символдық шеру, бұл айлы түнде жоғары қара»
Dialogue: 0,0:02:47.66,0:02:53.00,Default,,0,0,0,,/ «'Толықтық' Ах, өмір нұрын ұста.
Dialogue: 0,0:02:53.00,0:02:55.34,Default,,0,0,0,,/「ＫｉＬＬＫｉＳＳ ｊｕｄｙ．．， ＫｉＬＬＫｉＳＳ ｊｕｄｅ．．，」
Dialogue: 0,0:02:55.34,0:02:57.67,Default,,0,0,0,,/ «KiLLKiSS жуда.., алдау»
Dialogue: 0,0:02:57.67,0:03:00.18,Default,,0,0,0,,/「ＫｉＬＬＫｉＳＳ ｊｕｄｙ．．， ＫｉＬＬＫｉＳＳ ｊｕｄｅ．．，」
Dialogue: 0,0:03:00.18,0:03:02.68,Default,,0,0,0,,/"KiLLKiSS жуда..., мені құшақта"
Dialogue: 0,0:03:02.68,0:03:05.01,Default,,0,0,0,,/ «Ей, сен қорғансызсың».
Dialogue: 0,0:03:05.01,0:03:10.69,Default,,0,0,0,,/ «Адамдарды әдемі ойын бұзады»
Dialogue: 0,0:03:10.69,0:03:12.85,Default,,0,0,0,,/ «Бұл күлкілі».
Dialogue: 0,0:03:12.85,0:03:22.20,Default,,0,0,0,,/～
Dialogue: 0,0:03:22.20,0:03:27.04,Default,,0,0,0,,/「‘ｃｕｚ ｗｅ’ｒｅ ａｌｌ ａｌｏｎｅ ａｌｏｎｅ，」
Dialogue: 0,0:03:27.04,0:03:31.54,Default,,0,0,0,,/ «Егер сіз тістегеннен кейін де ауырса»
Dialogue: 0,0:03:31.54,0:03:40.32,Default,,0,0,0,,/ «Қолыңызды көтеріңіз, өтінемін»
Dialogue: 0,0:03:40.32,0:03:45.15,Default,,0,0,0,,/ «Ой, қан кеткенде, көлеңкеңді планетаға түсір».
Dialogue: 0,0:03:45.15,0:03:51.66,Default,,0,0,0,,/ "Ей, мен өз әлемім туралы білгім келеді. Жүр."
Dialogue: 0,0:03:51.66,0:03:53.83,Default,,0,0,0,,/「ｙｏｕ ｂｌｅｅｄ， ｙｅｓ， ｂｌｅｅｄ」
Dialogue: 0,0:03:53.83,0:04:00.50,Default,,0,0,0,,/ «Егер мен көктегі таяқтарды сол қанмен қайта жаза алсам».
Dialogue: 0,0:04:00.50,0:04:02.67,Default,,0,0,0,,/「ｃｏｄｅ ‘ＫｉＬＬＫｉＳＳ’ ｕｈ．．，」
Dialogue: 0,0:04:02.67,0:04:04.84,Default,,0,0,0,,/「ＫｉＬＬＫｉＳＳ ｊｕｄｙ．．， ＫｉＬＬＫｉＳＳ ｊｕｄｅ．．，」
Dialogue: 0,0:04:04.84,0:04:07.18,Default,,0,0,0,,/ “KiLLKiSS жуда.., алдау”
Dialogue: 0,0:04:07.18,0:04:09.68,Default,,0,0,0,,/「ＫｉＬＬＫｉＳＳ ｊｕｄｙ．．， ＫｉＬＬＫｉＳＳ ｊｕｄｅ．．，」
Dialogue: 0,0:04:09.68,0:04:12.18,Default,,0,0,0,,/"KiLLKiSS жуда..., мені құшақта"
Dialogue: 0,0:04:12.18,0:04:17.02,Default,,0,0,0,,/ "Ей, бұл анық. Бұл шіркін аяқталды."
Dialogue: 0,0:04:17.02,0:04:22.36,Default,,0,0,0,,/ «Бәрі өзгереді, ол өткінші».
Dialogue: 0,0:04:22.36,0:04:24.36,Default,,0,0,0,,/～
Dialogue: 0,0:04:24.36,0:04:36.30,Default,,0,0,0,,/ «Иә, осылай сындырыңыз.»
Dialogue: 0,0:04:36.30,0:04:44.48,Default,,0,0,0,,/～
Dialogue: 0,0:04:44.48,0:04:46.98,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:04:46.98,0:04:50.99,Default,,0,0,0,,《Сіз қазір не көресіз》
Dialogue: 0,0:04:50.99,0:04:56.29,Default,,0,0,0,,Сыры бар қыздың әңгімесі》
Dialogue: 0,0:05:07.67,0:05:09.67,Default,,0,0,0,,Уф….
Dialogue: 0,0:05:09.67,0:05:11.67,Default,,0,0,0,,Сұхбат 5 минуттан кейін басталады.
Dialogue: 0,0:05:11.67,0:05:13.68,Default,,0,0,0,,Жоқ! Мен макияжымды түзетуім керек!
Dialogue: 0,0:05:13.68,0:05:15.68,Default,,0,0,0,,Ол масканың артында жасырылған ба?
Dialogue: 0,0:05:15.68,0:05:18.68,Default,,0,0,0,,Мен оны көрмеймін деп, бұрыштарды кескім келмейді.
Dialogue: 0,0:05:18.68,0:05:21.85,Default,,0,0,0,,Сіз Умиконың бұрыштарды қиғанын көргіңіз келмейді, солай ма?
Dialogue: 0,0:05:21.85,0:05:25.85,Default,,0,0,0,,Муцуми Бұл сұхбат. Иә….
Dialogue: 0,0:05:25.85,0:05:28.19,Default,,0,0,0,,Мен бірінші барамын. А, күтіңіз, күтіңіз!
Dialogue: 0,0:05:28.19,0:05:30.19,Default,,0,0,0,,Міндетті түрде түзетіңіз.
Dialogue: 0,0:05:30.19,0:05:32.13,Default,,0,0,0,,Біздің миссиямыз >
Dialogue: 0,0:05:32.13,0:05:35.13,Default,,0,0,0,,Қонақтарымызды армандату.
Dialogue: 0,0:05:35.13,0:05:37.80,Default,,0,0,0,,Келесі Будокандағы Мухика даңғылы әлемінде>
Dialogue: 0,0:05:37.80,0:05:41.64,Default,,0,0,0,,Егер сіз кезіп жүрсеңіз, мен үшін үлкен қуаныш болар еді.
Dialogue: 0,0:05:41.64,0:05:43.97,Default,,0,0,0,,Будокан керемет, солай емес пе?
Dialogue: 0,0:05:43.97,0:05:45.97,Default,,0,0,0,,Сіздің дебютіңізден бері біраз уақыт өтті.
Dialogue: 0,0:05:45.97,0:05:48.81,Default,,0,0,0,,Мен бұл тарихтағы ең жылдам екенін атап өткім келеді.
Dialogue: 0,0:05:48.81,0:05:51.98,Default,,0,0,0,,бұл... Иә. Сіз ше, Мортис?
Dialogue: 0,0:05:51.98,0:05:54.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:54.82,0:05:56.82,Default,,0,0,0,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:05:59.32,0:06:02.82,Default,,0,0,0,,Көріп отырғаныңыздай, Мортис біраз ұялшақ.
Dialogue: 0,0:06:02.82,0:06:05.16,Default,,0,0,0,,Мортис Бүгінгі күн үшін рахмет.
Dialogue: 0,0:06:05.16,0:06:07.83,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:06:07.83,0:06:09.83,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:06:09.83,0:06:12.50,Default,,0,0,0,,Болат келгенде, оны бірден бұраңыз.
Dialogue: 0,0:06:12.50,0:06:15.17,Default,,0,0,0,,күрсіну~ Әзірше осы...
Dialogue: 0,0:06:15.17,0:06:17.67,Default,,0,0,0,,Киім бөлмесіне қайтып келгенше оны шешпеңіз.
Dialogue: 0,0:06:17.67,0:06:19.84,Default,,0,0,0,,Сіз кімнің қарап тұрғанын білмейсіз.
Dialogue: 0,0:06:19.84,0:06:22.51,Default,,0,0,0,,Иә? Ол толығымен басып озады ма?
Dialogue: 0,0:06:22.51,0:06:25.35,Default,,0,0,0,,Амористің шынайы тұлғасы - Ням... Аморис!
Dialogue: 0,0:06:25.35,0:06:28.85,Default,,0,0,0,,Міне, біз>
Dialogue: 0,0:06:28.85,0:06:31.35,Default,,0,0,0,,Сіз мәңгілікке маска киесіз бе?
Dialogue: 0,0:06:31.35,0:06:34.86,Default,,0,0,0,,Бет пен сандар шатастырылған.
Dialogue: 0,0:06:37.46,0:06:39.46,Default,,0,0,0,,Сумимидің алғашқы гүлі.
Dialogue: 0,0:06:39.46,0:06:43.30,Default,,0,0,0,,Комед Вакаба мен актриса Минами Моридің қызы.
Dialogue: 0,0:06:43.30,0:06:47.80,Default,,0,0,0,,Тек масканы алып тастау арқылы сіз әлемнің барлық назарын аудара аласыз.
Dialogue: 0,0:06:47.80,0:06:50.31,Default,,0,0,0,,Ave Mujica өнімді төмен бағамен сатпайды.
Dialogue: 0,0:06:50.31,0:06:52.97,Default,,0,0,0,,Біріншіден, өз тәжірибеңізді қалыптастырыңыз және музыкалық қабілетіңізді бағалаңыз...
Dialogue: 0,0:06:52.97,0:06:54.98,Default,,0,0,0,,Мен сені кеше жақсы көрсем де...
Dialogue: 0,0:06:54.98,0:06:57.65,Default,,0,0,0,,Мен бүгін жалықтым. Ха!
Dialogue: 0,0:06:57.65,0:06:59.65,Default,,0,0,0,,Өйткені дүние қатыгез>
Dialogue: 0,0:06:59.65,0:07:02.98,Default,,0,0,0,,Бәлкім, әбігерге түсе берсең, жалығып кетерсің.
Dialogue: 0,0:07:02.98,0:07:04.99,Default,,0,0,0,,Мен бұл топпын>
Dialogue: 0,0:07:04.99,0:07:07.66,Default,,0,0,0,,Оны сән ретінде аяқтау ниетіміз жоқ.
Dialogue: 0,0:07:07.66,0:07:10.66,Default,,0,0,0,,Мен айттым ғой, солай ма? қалған өмір >
Dialogue: 0,0:07:10.66,0:07:13.83,Default,,0,0,0,,Маған беріңізші. Аа….
Dialogue: 0,0:07:13.83,0:07:16.33,Default,,0,0,0,,Һмм.
Dialogue: 0,0:07:16.33,0:07:19.50,Default,,0,0,0,,Масканы шешу - ең жақсы кезең>
Dialogue: 0,0:07:19.50,0:07:22.67,Default,,0,0,0,,Керемет уақытта.
Dialogue: 0,0:07:22.67,0:07:26.17,Default,,0,0,0,,Мен дәл қазір таңдандым.
Dialogue: 0,0:07:26.17,0:07:30.51,Default,,0,0,0,,Мен Аве Мухика мен үшін өте маңызды деп естідім.
Dialogue: 0,0:07:30.51,0:07:32.45,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:07:32.45,0:07:34.62,Default,,0,0,0,,Өйткені мен сенің өміріңе жауаптымын.
Dialogue: 0,0:07:34.62,0:07:37.45,Default,,0,0,0,,Дебют жасағаннан кейін соншалықты танымал болғаныңызға сене алмаймын>
Dialogue: 0,0:07:37.45,0:07:41.46,Default,,0,0,0,,Өйткені, Шо-чан керемет. Мұның бәрі Хатсуканың арқасында.
Dialogue: 0,0:07:41.46,0:07:45.79,Default,,0,0,0,,Аве Мухиканың алдыңғы жағы ретінде мен бұдан жақсы ештеңе жоқ деп ойлаймын.
Dialogue: 0,0:07:45.79,0:07:48.80,Default,,0,0,0,,((Хатсука: иә? Топ? Иә.
Dialogue: 0,0:07:48.80,0:07:51.13,Default,,0,0,0,,Мен мұны кәсіпқой ретінде жасаймын.
Dialogue: 0,0:07:51.13,0:07:55.30,Default,,0,0,0,,Хмм... Жарайды, жақсы.
Dialogue: 0,0:07:55.30,0:07:57.97,Default,,0,0,0,,Шынымен бе? Әлі ештеңе...
Dialogue: 0,0:07:57.97,0:07:59.97,Default,,0,0,0,,Бұл Шоу Чанның өтініші))
Dialogue: 0,0:08:01.98,0:08:03.98,Default,,0,0,0,,Бұл жақсы болды ма?
Dialogue: 0,0:08:03.98,0:08:06.31,Default,,0,0,0,,Ештеңені сұрамай. Иә.
Dialogue: 0,0:08:06.31,0:08:10.99,Default,,0,0,0,,Иә. Хатсука - бұл кристалдар сияқты заттарды сатып алуға мәжбүр болатын адам түрі.
Dialogue: 0,0:08:10.99,0:08:14.32,Default,,0,0,0,,А, бұл қорқынышты. Бір кеңсе болса да>
Dialogue: 0,0:08:14.32,0:08:17.33,Default,,0,0,0,,Сумимен қатар жұмыс істеу қиын, солай емес пе?
Dialogue: 0,0:08:17.33,0:08:20.83,Default,,0,0,0,,Барынша жүк болмауға тырысыңыз. Бұл мүлдем ауыртпалық емес.
Dialogue: 0,0:08:20.83,0:08:23.53,Default,,0,0,0,,Керісінше, бұл жылдамдықтың өзгеруі.
Dialogue: 0,0:08:26.17,0:08:29.00,Default,,0,0,0,,№.
Dialogue: 0,0:08:29.00,0:08:33.61,Default,,0,0,0,,Менің арманым Шомен мәңгі бірге болу>
Dialogue: 0,0:08:33.61,0:08:35.61,Default,,0,0,0,,Өйткені ол орындалды.
Dialogue: 0,0:08:35.61,0:08:37.61,Default,,0,0,0,,Бірінші гүл…. []
Dialogue: 0,0:08:37.61,0:08:39.61,Default,,0,0,0,,Иә! []
Dialogue: 0,0:08:39.61,0:08:41.78,Default,,0,0,0,,[]
Dialogue: 0,0:08:41.78,0:08:44.62,Default,,0,0,0,,Жұмыс? Иә. Тағы да Хатсука. []
Dialogue: 0,0:08:44.62,0:08:47.32,Default,,0,0,0,,Я... Бұл Тоёкава.
Dialogue: 0,0:08:50.13,0:08:52.13,Default,,0,0,0,,Осы жерді басыңыз.
Dialogue: 0,0:08:52.13,0:08:55.13,Default,,0,0,0,,Мен тағы да артқы аллеяда мас күйде ес-түссіз қалдым.
Dialogue: 0,0:08:55.13,0:08:58.83,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:09:04.97,0:09:07.64,Default,,0,0,0,,Әке. (нақтылау) Ух...
Dialogue: 0,0:09:07.64,0:09:10.31,Default,,0,0,0,,Мен жоқ болсам жақсы...
Dialogue: 0,0:09:10.31,0:09:13.15,Default,,0,0,0,,Мм...!
Dialogue: 0,0:09:13.15,0:09:15.65,Default,,0,0,0,,Түсінбейтін нәрселерді айтпа>
Dialogue: 0,0:09:15.65,0:09:18.65,Default,,0,0,0,,Қараңдар, берік болыңдар! Мен үйге бара жатырмын.
Dialogue: 0,0:09:29.33,0:09:31.33,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:09:34.10,0:09:36.10,Default,,0,0,0,,《Будоканның 4 әні.
Dialogue: 0,0:09:36.10,0:09:38.27,Default,,0,0,0,,Хатсуканың мәтінін жазуға кеткен уақытты ескере отырып>
Dialogue: 0,0:09:38.27,0:09:42.44,Default,,0,0,0,,Осы демалыс күндері кем дегенде екі ән...》
Dialogue: 0,0:09:42.44,0:09:51.29,Default,,0,0,0,,/
Dialogue: 0,0:09:51.29,0:09:53.96,Default,,0,0,0,,((Мидзухо: Сіз мұны өте жақсы білесіз. (Шапалақтау)
Dialogue: 0,0:09:53.96,0:09:57.46,Default,,0,0,0,,Бұл анаңның сүйікті әні, сондықтан біз оны көп жаттық.
Dialogue: 0,0:09:57.46,0:09:59.79,Default,,0,0,0,,Келесі жолы Муцумиге де телефон соғыңыз... Ах!
Dialogue: 0,0:09:59.79,0:10:02.30,Default,,0,0,0,,Не? Ештеңе!
Dialogue: 0,0:10:02.30,0:10:05.97,Default,,0,0,0,,Анаңның туған күніне дейін құпия.
Dialogue: 0,0:10:05.97,0:10:08.80,Default,,0,0,0,,Шоко Мизухо мен үйдемін.
Dialogue: 0,0:10:08.80,0:10:11.47,Default,,0,0,0,,Әке! Қайтадан қош келдіңіз!
Dialogue: 0,0:10:11.47,0:10:13.64,Default,,0,0,0,,Жұмысыңыз қалай болды? Ха.
Dialogue: 0,0:10:13.64,0:10:15.81,Default,,0,0,0,,Қайын атам бүгін тағы ұрысты.
Dialogue: 0,0:10:15.81,0:10:20.15,Default,,0,0,0,,Егер бұлай болса, мен өз компаниямды былай қойғанда, асыл қызымды сеніп тапсыра алмаймын.
Dialogue: 0,0:10:20.15,0:10:23.49,Default,,0,0,0,,Мен қаталмын, өйткені мен Сейхон мырзаны тәрбиелегім келеді.
Dialogue: 0,0:10:23.49,0:10:27.29,Default,,0,0,0,,Жарайды. Сіздің адалдығыңыз - қасиет.
Dialogue: 0,0:10:29.49,0:10:33.16,Default,,0,0,0,,Мизухо-чан, әлі ерте...
Dialogue: 0,0:10:33.16,0:10:36.06,Default,,0,0,0,,Бірақ бұл ұзаққа созылатын еді...
Dialogue: 0,0:10:50.35,0:10:54.85,Default,,0,0,0,,Ха... Ана...
Dialogue: 0,0:10:54.85,0:11:00.02,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:11:00.02,0:11:04.63,Default,,0,0,0,,Шоко әке Мен бар күшімді саламын.
Dialogue: 0,0:11:07.20,0:11:11.87,Default,,0,0,0,,Иә, түстен кейін музыка фестивалі болады. Аудиторияға көшейік.
Dialogue: 0,0:11:11.87,0:11:13.87,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:19.04,0:11:21.88,Default,,0,0,0,,Shove.
Dialogue: 0,0:11:21.88,0:11:25.55,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:11:25.55,0:11:28.72,Default,,0,0,0,,/ «Алтынға прелюдия»
Dialogue: 0,0:11:28.72,0:11:31.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:31.89,0:11:33.99,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:11:33.99,0:11:36.49,Default,,0,0,0,,Бұл Морфоника болды! (қол шапалақтап, қошемет көрсету)
Dialogue: 0,0:11:36.49,0:11:38.83,Default,,0,0,0,,Морфоника? Цукиномириде>
Dialogue: 0,0:11:38.83,0:11:42.00,Default,,0,0,0,,Алғаш рет топ құрған орта мектеп оқушысы.
Dialogue: 0,0:11:42.00,0:11:45.00,Default,,0,0,0,,Жолақ…. Муцуми!
Dialogue: 0,0:11:45.00,0:11:47.00,Default,,0,0,0,,Біз де топ құрайық!
Dialogue: 0,0:11:47.00,0:11:49.67,Default,,0,0,0,,Иә? Бұл топ!
Dialogue: 0,0:11:49.67,0:11:54.68,Default,,0,0,0,,Сойо Нагасаки Сенің сондай жағымды адам болғаныңа қуаныштымын.
Dialogue: 0,0:11:54.68,0:11:56.84,Default,,0,0,0,,Қалғаны...
Dialogue: 0,0:11:56.84,0:11:58.85,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:12:01.35,0:12:03.85,Default,,0,0,0,,Жоқ! (Жарық) Уф!
Dialogue: 0,0:12:03.85,0:12:07.36,Default,,0,0,0,,Сізді итеріп жібергенім үшін кешіріңіз. Бірақ мен өле алмаймын!
Dialogue: 0,0:12:07.36,0:12:09.36,Default,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:12:09.36,0:12:11.53,Default,,0,0,0,,Бұдан былай біз топпыз>
Dialogue: 0,0:12:11.53,0:12:16.03,Default,,0,0,0,,Тағдыры ортақ, ән шырқайтын қауымға айналамыз.
Dialogue: 0,0:12:16.03,0:12:18.87,Default,,0,0,0,,Мен бірінші рет ән мәтінін жаздым.
Dialogue: 0,0:12:18.87,0:12:21.20,Default,,0,0,0,,Осы уақытқа дейін не болды? (Жарық) Мм...
Dialogue: 0,0:12:21.20,0:12:25.71,Default,,0,0,0,,Мен түсіндім. бұл….
Dialogue: 0,0:12:25.71,0:12:31.05,Default,,0,0,0,,``Kasuga Kage'' бұл... біздің әніміз.
Dialogue: 0,0:12:31.05,0:12:41.49,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:12:41.49,0:12:43.49,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:43.49,0:12:46.10,Default,,0,0,0,,《Хм... Әкең ше? 》
Dialogue: 0,0:12:46.10,0:12:49.16,Default,,0,0,0,,Мен ештеңе түсінбеймін! Мен сені блоктаймын!
Dialogue: 0,0:12:49.16,0:12:52.00,Default,,0,0,0,,Тацуки-чан блоктан гөрі мылқау.
Dialogue: 0,0:12:52.00,0:12:55.50,Default,,0,0,0,,Аа, бірақ басқа адамдар оны көбінесе мақтайды. []
Dialogue: 0,0:12:55.50,0:12:57.51,Default,,0,0,0,,А...? иә?
Dialogue: 0,0:13:00.01,0:13:02.01,Default,,0,0,0,,Шо-чан?
Dialogue: 0,0:13:05.35,0:13:07.35,Default,,0,0,0,,Бұл ас үй.
Dialogue: 0,0:13:07.35,0:13:09.85,Default,,0,0,0,,Сенің әкең қайда? Сіз білесіз бе?
Dialogue: 0,0:13:09.85,0:13:12.85,Default,,0,0,0,,Бұл адам енді Тоёкаваның адамы емес.
Dialogue: 0,0:13:12.85,0:13:16.19,Default,,0,0,0,,Мен алаяқтық үшін жауапкершілікті өз мойныма алдым және жұмыстан кеттім.
Dialogue: 0,0:13:16.19,0:13:20.36,Default,,0,0,0,,Алаяқтық…. Бұл 16,8 миллиард шығын.
Dialogue: 0,0:13:20.36,0:13:22.70,Default,,0,0,0,,Иә! Болды...
Dialogue: 0,0:13:22.70,0:13:26.03,Default,,0,0,0,,Сәтсіздік. сәттілік?
Dialogue: 0,0:13:26.03,0:13:29.70,Default,,0,0,0,,Әкеңді ұмыт, менің қызым бол.
Dialogue: 0,0:13:29.70,0:13:33.47,Default,,0,0,0,,Бұл Мидзухоның ұмытылған естелігі. Мен оның қиналғанын қаламаймын.
Dialogue: 0,0:13:33.47,0:13:36.14,Default,,0,0,0,,Ха... уф!
Dialogue: 0,0:13:36.14,0:13:38.15,Default,,0,0,0,,Шоко!
Dialogue: 0,0:13:38.15,0:13:41.65,Default,,0,0,0,,Сіз сияқты қорапты адам қалай өмір сүреді?
Dialogue: 0,0:13:41.65,0:13:44.85,Default,,0,0,0,,Анаң... осының бәрі...
Dialogue: 0,0:13:49.32,0:13:51.53,Default,,0,0,0,,Қош бол.
Dialogue: 0,0:13:57.00,0:13:59.60,Default,,0,0,0,,Бұл...?
Dialogue: 0,0:14:03.34,0:14:05.84,Default,,0,0,0,,Әке...? Уф...
Dialogue: 0,0:14:09.34,0:14:11.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:11.35,0:14:14.35,Default,,0,0,0,,Әке! Әке, мықты болыңыз!
Dialogue: 0,0:14:14.35,0:14:16.68,Default,,0,0,0,,Уф….
Dialogue: 0,0:14:16.68,0:14:19.19,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:14:21.69,0:14:23.69,Default,,0,0,0,,Зенитсу! Иносуке!
Dialogue: 0,0:14:23.69,0:14:26.19,Default,,0,0,0,,Хмм... Қарғыс атсын!
Dialogue: 0,0:14:33.63,0:14:37.31,Default,,0,0,0,,[] (Менеджер) Кіші мектеп оқушысы? (Шоко) Иә.
Dialogue: 0,0:14:37.31,0:14:41.81,Default,,0,0,0,,[]Орта сынып оқушылары жоқ. Сізді ешкім жұмысқа алмайды, солай ма?
Dialogue: 0,0:14:41.81,0:14:46.15,Default,,0,0,0,,Иә. Жалғыз жұмысым газет жеткізу болатын.
Dialogue: 0,0:14:46.15,0:14:48.15,Default,,0,0,0,,[]Ата-анаң ше?
Dialogue: 0,0:14:48.15,0:14:50.32,Default,,0,0,0,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:14:50.32,0:14:53.02,Default,,0,0,0,,[] Мен аудармаға сенімді емеспін...
Dialogue: 0,0:14:56.16,0:15:00.33,Default,,0,0,0,,Бұл торғайдың көз жасы.
Dialogue: 0,0:15:00.33,0:15:03.83,Default,,0,0,0,,Не? Сіз шынымен бас тартасыз ба?
Dialogue: 0,0:15:03.83,0:15:05.83,Default,,0,0,0,,Сіз Муцумиді білесіз бе?
Dialogue: 0,0:15:05.83,0:15:08.67,Default,,0,0,0,,Цукиномориде оқу ақысы өте қымбат.
Dialogue: 0,0:15:08.67,0:15:10.87,Default,,0,0,0,,CRYCHIC туралы не деуге болады?
Dialogue: 0,0:15:13.01,0:15:17.31,Default,,0,0,0,,Мен әйтеуір уақыт табамын, әзірге ешкімге айтпа.
Dialogue: 0,0:15:19.51,0:15:21.52,Default,,0,0,0,,Әлі уақыт бар.
Dialogue: 0,0:15:21.52,0:15:23.52,Default,,0,0,0,,[]
Dialogue: 0,0:15:23.52,0:15:25.52,Default,,0,0,0,,Сойо.
Dialogue: 0,0:15:27.52,0:15:29.52,Default,,0,0,0,,Иә? []
Dialogue: 0,0:15:29.52,0:15:31.96,Default,,0,0,0,,[]
Dialogue: 0,0:15:31.96,0:15:35.26,Default,,0,0,0,,Иә. иә?
Dialogue: 0,0:15:39.80,0:15:41.97,Default,,0,0,0,,Неліктен ішімдік ішесің?
Dialogue: 0,0:15:41.97,0:15:46.97,Default,,0,0,0,,Шоко... Әке, мен барымды саламын...
Dialogue: 0,0:15:46.97,0:15:49.48,Default,,0,0,0,,Әке…. []
Dialogue: 0,0:15:55.65,0:15:57.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:02.99,0:16:08.66,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:16:08.66,0:16:11.83,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:11.83,0:16:15.67,Default,,0,0,0,,Мен CRYCHIC пайдалануды тоқтатамын.
Dialogue: 0,0:16:15.67,0:16:20.17,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:20.17,0:16:22.51,Default,,0,0,0,,Өткен күнгі тікелей шоу қызық болды.
Dialogue: 0,0:16:22.51,0:16:25.18,Default,,0,0,0,,Сіз мұны қайтадан жасағыңыз келетінін айттыңыз, солай ма?
Dialogue: 0,0:16:25.18,0:16:28.35,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:28.35,0:16:30.35,Default,,0,0,0,,Жарық сені күтіп тұрды!
Dialogue: 0,0:16:30.35,0:16:33.62,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:33.62,0:16:36.79,Default,,0,0,0,,Сіз шынымен де тастағыңыз келе ме? ))
Dialogue: 0,0:16:36.79,0:16:43.00,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:48.97,0:16:51.47,Default,,0,0,0,,Сіз жабысқақ жазбаларды жинайсыз ба?
Dialogue: 0,0:16:51.47,0:16:53.64,Default,,0,0,0,,Өйткені сөздерді ретке келтіруге болады.
Dialogue: 0,0:16:53.64,0:16:55.64,Default,,0,0,0,,Хмм?
Dialogue: 0,0:16:55.64,0:16:57.98,Default,,0,0,0,,Үйде пайдаланбайтын түрі бар ма?
Dialogue: 0,0:16:57.98,0:17:00.31,Default,,0,0,0,,Ха... иә. (Айна) Әй!
Dialogue: 0,0:17:00.31,0:17:03.15,Default,,0,0,0,,Дайындалды! керемет!
Dialogue: 0,0:17:03.15,0:17:05.82,Default,,0,0,0,,Не? Мухика даңғылы>
Dialogue: 0,0:17:05.82,0:17:07.99,Default,,0,0,0,,Будокан маскарадына билеттер!
Dialogue: 0,0:17:07.99,0:17:11.16,Default,,0,0,0,,Көбейткіштің жоғары болғаны сонша, мен бұл мүмкін емес деп ойладым.
Dialogue: 0,0:17:11.16,0:17:13.16,Default,,0,0,0,,Әй, бұл жақсы.
Dialogue: 0,0:17:13.16,0:17:15.50,Default,,0,0,0,,Абсолютті Аморис - нямути!
Dialogue: 0,0:17:15.50,0:17:17.67,Default,,0,0,0,,Нямучи Бұл Нямучи ме?
Dialogue: 0,0:17:17.67,0:17:21.00,Default,,0,0,0,,Дауыс: Нямучи Бұл туралы алдыңғы бейнеде айтылған.
Dialogue: 0,0:17:21.00,0:17:23.84,Default,,0,0,0,,Бұл болды ма? Оны көргенде түсінесіз.
Dialogue: 0,0:17:23.84,0:17:26.01,Default,,0,0,0,,Ей, кеттік, Томорин! Ах.
Dialogue: 0,0:17:26.01,0:17:28.68,Default,,0,0,0,,Аве Мухиканың маскарады Екі данасы бар.
Dialogue: 0,0:17:28.68,0:17:31.51,Default,,0,0,0,,Ту-чан, көп адам бар жерлерді ұнатпайсың ба?
Dialogue: 0,0:17:31.51,0:17:35.78,Default,,0,0,0,,Иә? Бір күні MyGO! ! ! ! ! Мүмкін бізде үлкенірек жерде тікелей эфир болады ма?
Dialogue: 0,0:17:35.78,0:17:37.79,Default,,0,0,0,,Қазір үйреніп алғаныңыз жөн!
Dialogue: 0,0:17:37.79,0:17:39.79,Default,,0,0,0,,Мазасыздық. Ах...
Dialogue: 0,0:17:39.79,0:17:42.12,Default,,0,0,0,,Дауыс Бұл үлкен. Рикки, барасың ба?
Dialogue: 0,0:17:42.12,0:17:44.63,Default,,0,0,0,,А... рахмет. Маған бұл қызықты емес
Dialogue: 0,0:17:44.63,0:17:46.79,Default,,0,0,0,,Мухика даңғылы? сондықтан?
Dialogue: 0,0:17:46.79,0:17:50.46,Default,,0,0,0,,Дәл қазір ең көп назар аударатын топ осы ма? Қараңыз.
Dialogue: 0,0:17:50.46,0:17:53.13,Default,,0,0,0,,p[Адамның иісі болса, ала алмайсың.
Dialogue: 0,0:17:53.13,0:17:55.47,Default,,0,0,0,,p[Жоқ, мен қиындыққа тап болдым!
Dialogue: 0,0:17:55.47,0:17:58.81,Default,,0,0,0,,Драма? Олар тікелей шоулар арасында скит жасайды.
Dialogue: 0,0:17:58.81,0:18:01.98,Default,,0,0,0,,Бұл әлем. Бұл топ емес.
Dialogue: 0,0:18:01.98,0:18:03.98,Default,,0,0,0,,Бұл топ...
Dialogue: 0,0:18:03.98,0:18:08.48,Default,,0,0,0,,Е-е, бір кесекпен не істеймін... Хм.
Dialogue: 0,0:18:08.48,0:18:10.79,Default,,0,0,0,,Не?
Dialogue: 0,0:18:14.16,0:18:16.49,Default,,0,0,0,,Мен кетемін.
Dialogue: 0,0:18:16.49,0:18:19.99,Default,,0,0,0,,Әке? Бұл Будокан.
Dialogue: 0,0:18:19.99,0:18:24.00,Default,,0,0,0,,А... е-е, сен мұны білдің.
Dialogue: 0,0:18:24.00,0:18:26.83,Default,,0,0,0,,Шоко керемет. Хехе….
Dialogue: 0,0:18:26.83,0:18:30.84,Default,,0,0,0,,Жалғыз алға жылжу. Әке?
Dialogue: 0,0:18:30.84,0:18:35.44,Default,,0,0,0,,Мен енді тырыса алмаймын... Қарғыс атсын...!
Dialogue: 0,0:18:35.44,0:18:38.78,Default,,0,0,0,,Анаң әкеңді қазір көрсе, ол да қайғыр еді.
Dialogue: 0,0:18:38.78,0:18:40.78,Default,,0,0,0,,Анашым, мен солай айттым.
Dialogue: 0,0:18:40.78,0:18:42.95,Default,,0,0,0,,Әкеңнің қандай қасиеті бар? шулы!
Dialogue: 0,0:18:42.95,0:18:44.95,Default,,0,0,0,,Арх! Уф! ?
Dialogue: 0,0:18:44.95,0:18:47.46,Default,,0,0,0,,Ух... ой...
Dialogue: 0,0:18:47.46,0:18:51.63,Default,,0,0,0,,Мені жалғыз қалдырыңыз...
Dialogue: 0,0:18:51.63,0:18:56.80,Default,,0,0,0,,Сендей жақсы қыздың болғаны мені... аянышты...!
Dialogue: 0,0:18:56.80,0:19:00.97,Default,,0,0,0,,Өтінемін... кетіңізші...!
Dialogue: 0,0:19:00.97,0:19:04.47,Default,,0,0,0,,Ха...! Қарғыс атсын!
Dialogue: 0,0:19:07.31,0:19:10.48,Default,,0,0,0,,Шо…. Барайық!
Dialogue: 0,0:19:10.48,0:19:14.32,Default,,0,0,0,,Әкешім...! Осы уақытқа дейін өзімді қалай сезіндім...!
Dialogue: 0,0:19:14.32,0:19:17.32,Default,,0,0,0,,Шо…. Мен ол жерге енді қайтып бармаймын.
Dialogue: 0,0:19:17.32,0:19:19.65,Default,,0,0,0,,Мен қайтып бара алмаймын!
Dialogue: 0,0:19:19.65,0:19:23.16,Default,,0,0,0,,Шо Будокан Жақсысың ба?
Dialogue: 0,0:19:25.16,0:19:27.33,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:19:27.33,0:19:29.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:29.50,0:19:32.43,Default,,0,0,0,,Сіз неге сонша көп жұмыс жасадым деп ойлайсыз?
Dialogue: 0,0:19:32.43,0:19:37.27,Default,,0,0,0,,Өкінішіңді үзіп, бәрін ұмыт.
Dialogue: 0,0:19:37.27,0:19:42.48,Default,,0,0,0,,Мухика даңғылы мен үшін жалғыз орын...
Dialogue: 0,0:19:49.45,0:19:53.25,Default,,0,0,0,,Аморис маскасы. Иә.
Dialogue: 0,0:19:57.12,0:20:01.80,Default,,0,0,0,,Долорис I Қайғыдан қорықпа.
Dialogue: 0,0:20:01.80,0:20:04.13,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:04.13,0:20:07.30,Default,,0,0,0,,Мұқият қараңыз. Бұл тамаша күлкі.
Dialogue: 0,0:20:07.30,0:20:10.64,Default,,0,0,0,,Күлімдегенді ұнатпасаң, жыласаң да болады.
Dialogue: 0,0:20:10.64,0:20:13.64,Default,,0,0,0,,Өйткені мен кез келген бетті жасай аламын.
Dialogue: 0,0:20:13.64,0:20:17.14,Default,,0,0,0,,Мм... Қызық сценарий.
Dialogue: 0,0:20:17.14,0:20:19.55,Default,,0,0,0,,Иә? мен барамын.
Dialogue: 0,0:20:23.48,0:20:27.66,Default,,0,0,0,,Аморис Мен махаббаттан қорықпаймын.
Dialogue: 0,0:20:27.66,0:20:32.33,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:32.33,0:20:38.33,Default,,0,0,0,,Oblibionis I Ұмытудан қорықпаймын.
Dialogue: 0,0:20:38.33,0:20:43.34,Default,,0,0,0,,Жақында бізге тұтынушы болады.
Dialogue: 0,0:20:43.34,0:20:46.51,Default,,0,0,0,,Кім келеді? Долорис, күтіңіз.
Dialogue: 0,0:20:46.51,0:20:50.68,Default,,0,0,0,,Достар. Мортис Менің шашым шашыраңқы.
Dialogue: 0,0:20:50.68,0:20:53.68,Default,,0,0,0,,Бұл жаңа иелері.
Dialogue: 0,0:20:53.68,0:20:56.02,Default,,0,0,0,,Тимор жағасы түзу.
Dialogue: 0,0:20:56.02,0:20:59.02,Default,,0,0,0,,Бүгін мен сені тауып беремін.
Dialogue: 0,0:20:59.02,0:21:04.19,Default,,0,0,0,,Аморис Сізге тек тамаша күтім және тамаша күлімсіреу қажет.
Dialogue: 0,0:21:04.19,0:21:08.03,Default,,0,0,0,,Тұтынушыларға өзіңіздің ең жақсы нұсқаңызды көрсетуіңіз керек.
Dialogue: 0,0:21:08.03,0:21:10.03,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:10.03,0:21:12.53,Default,,0,0,0,,(Аукциондық балға соғу дыбысы)
Dialogue: 0,0:21:12.53,0:21:15.04,Default,,0,0,0,,Сізді ұзақ күттіргенім үшін кешіріңіз.
Dialogue: 0,0:21:15.04,0:21:18.71,Default,,0,0,0,,Аве Мухиканың маскарадына қош келдіңіз.
Dialogue: 0,0:21:18.71,0:21:20.88,Default,,0,0,0,,Бүгінгі кешке қонақтарымыз үшін>
Dialogue: 0,0:21:20.88,0:21:23.88,Default,,0,0,0,,Біз сендерге әдемі қуыршақтар дайындадық.
Dialogue: 0,0:21:23.88,0:21:26.21,Default,,0,0,0,,Ақылды Тиморис.
Dialogue: 0,0:21:26.21,0:21:28.22,Default,,0,0,0,,Қайырымдылық аморисы.
Dialogue: 0,0:21:28.22,0:21:30.38,Default,,0,0,0,,Мейірімді Долорис.
Dialogue: 0,0:21:30.38,0:21:32.65,Default,,0,0,0,,Мойынсұнғыш Мортис.
Dialogue: 0,0:21:32.65,0:21:36.82,Default,,0,0,0,,Ал мен асыл Облибиониспін.
Dialogue: 0,0:21:36.82,0:21:40.66,Default,,0,0,0,,Мұқият қарап шығыңыз. Бұл тамаша күлкі.
Dialogue: 0,0:21:40.66,0:21:43.00,Default,,0,0,0,,Керемет пе? Хмм...
Dialogue: 0,0:21:43.00,0:21:47.17,Default,,0,0,0,,Ахахаха! Қандай берік күлкі>
Dialogue: 0,0:21:47.17,0:21:49.67,Default,,0,0,0,,Оны ешкім қаламайды.
Dialogue: 0,0:21:49.67,0:21:53.17,Default,,0,0,0,,Ах! ? Мен шын жүректен күлуім керек.
Dialogue: 0,0:21:53.17,0:21:56.34,Default,,0,0,0,,Осылай!
Dialogue: 0,0:21:56.34,0:21:58.85,Default,,0,0,0,,Нямучи! ? неге?
Dialogue: 0,0:21:58.85,0:22:02.18,Default,,0,0,0,,Қараңдар! Бұл Нямучи болды!
Dialogue: 0,0:22:02.18,0:22:04.19,Default,,0,0,0,,Уфуфуфуфу!
Dialogue: 0,0:22:04.19,0:22:07.19,Default,,0,0,0,,О, құдайым…. Мен сені ести алмаймын!
Dialogue: 0,0:22:07.19,0:22:12.86,Default,,0,0,0,,Эй, Мортис, сенің шынайы жүзің қандай?
Dialogue: 0,0:22:12.86,0:22:14.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:14.86,0:22:18.53,Default,,0,0,0,,Өтірік...! Ах! Вакаба мен Минами Моридің қызы!
Dialogue: 0,0:22:18.53,0:22:22.70,Default,,0,0,0,,Уф...! Ахахха, тартылған бет.
Dialogue: 0,0:22:22.70,0:22:28.04,Default,,0,0,0,,Сіз нені айтасыз? Хехехе. Сіздің бетіңіз қандай?
Dialogue: 0,0:22:28.04,0:22:30.21,Default,,0,0,0,,Бұзылу қоңырауы! ? ДДСҰ?
Dialogue: 0,0:22:30.21,0:22:34.98,Default,,0,0,0,,Әдемі тұлға қызықсыз.
Dialogue: 0,0:22:34.98,0:22:38.99,Default,,0,0,0,,《Қарғыс атсын... сен істедің.》 《Хатсука: Шоу-чан...》
Dialogue: 0,0:22:38.99,0:22:41.49,Default,,0,0,0,,《Бұл ағынды тоқтату мүмкін емес. Бір рет төмен түсіңіз...》
Dialogue: 0,0:22:41.49,0:22:44.66,Default,,0,0,0,,Oblibionis Алға күту.
Dialogue: 0,0:22:44.66,0:22:47.16,Default,,0,0,0,,Қараңызшы, шашыңыз шашылып жатыр.
Dialogue: 0,0:22:47.16,0:22:51.50,Default,,0,0,0,,Жағаның түзу екеніне сенімдімін, солай ма?
Dialogue: 0,0:22:51.50,0:22:54.67,Default,,0,0,0,,《Бұл...! 》Сізге не қажет>
Dialogue: 0,0:22:54.67,0:22:59.17,Default,,0,0,0,,Керемет күтім және тамаша күлкі!
Dialogue: 0,0:22:59.17,0:23:03.51,Default,,0,0,0,,Біз тұтынушыларымызға кім екенімізді көрсетуіміз керек.
Dialogue: 0,0:23:03.51,0:23:05.81,Default,,0,0,0,,Эй?
Dialogue: 0,0:23:10.35,0:23:12.55,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:23:16.02,0:23:18.83,Default,,0,0,0,,Е, Соёрин...
Dialogue: 0,0:23:23.70,0:23:25.70,Default,,0,0,0,,Керемет жүз!
Dialogue: 0,0:23:25.70,0:23:28.70,Default,,0,0,0,,Сіз не істейсіз? Эх...
Dialogue: 0,0:23:37.14,0:23:39.31,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:23:39.31,0:23:41.48,Default,,0,0,0,,Ха! Бұл Хатсука-чан! неге! ?
Dialogue: 0,0:23:41.48,0:23:43.98,Default,,0,0,0,,Сумими! ? Мухика Яба даңғылы!
Dialogue: 0,0:23:47.32,0:23:49.49,Default,,0,0,0,,《Хатсука: Оның құпиясы》
Dialogue: 0,0:23:49.49,0:23:51.66,Default,,0,0,0,,Ай астында ашылған>
Dialogue: 0,0:23:51.66,0:23:56.50,Default,,0,0,0,,Қуыршақтар қайтадан адам кейпіне енеді.
Dialogue: 0,0:23:56.50,0:24:00.50,Default,,0,0,0,,Бұл бақыт па, әлде жойылу ма?
Dialogue: 0,0:24:00.50,0:24:03.67,Default,,0,0,0,,Тағдырдың берілістері...
Dialogue: 0,0:24:03.67,0:24:06.67,Default,,0,0,0,,Тоқтамайды》
Dialogue: 0,0:24:08.17,0:24:14.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
