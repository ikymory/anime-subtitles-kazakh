Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.58,0:00:17.58,Default,,0,0,0,,Мемлекеттік департаменттің мәліметі бойынша, Пенумстан уақытша үкіметінің мүшелері...
Dialogue: 0,0:00:17.66,0:00:20.04,Default,,0,0,0,,Даллес халықаралық әуежайына келу
Dialogue: 0,0:00:20.12,0:00:24.70,Default,,0,0,0,,АҚШ үкіметімен болашақ қолдау шараларын талқылағаннан кейін...
Dialogue: 0,0:00:32.87,0:00:37.54,Default,,0,0,0,,Президент Грэм қол қою рәсімінде сөйлейді.
Dialogue: 0,0:01:19.70,0:01:20.70,Default,,0,0,0,,Джейсон
Dialogue: 0,0:01:21.37,0:01:22.41,Default,,0,0,0,,Сәлем Джейсон!
Dialogue: 0,0:01:26.37,0:01:27.75,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:01:43.54,0:01:49.33,Default,,0,0,0,,Капкомның «Resident Evil» ойынына негізделген
Dialogue: 0,0:02:43.00,0:02:46.37,Default,,0,0,0,,«Мотель»
Dialogue: 0,0:02:56.12,0:02:59.29,Default,,0,0,0,,2000 жылы Пенумстанда азамат соғысы басталды
Dialogue: 0,0:02:59.37,0:03:03.16,Default,,0,0,0,,Іс жүзінде анархия жағдайы болды.
Dialogue: 0,0:03:03.25,0:03:04.75,Default,,0,0,0,,Америка Құрама Штаттары БҰҰ-ның қарарын күтпей-ақ әскери араласуға шешім қабылдады, бірақ...
Dialogue: 0,0:03:04.75,0:03:08.00,Default,,0,0,0,,Америка Құрама Штаттары БҰҰ-ның қарарын күтпестен әскери араласуға шешім қабылдады, бірақ...
Dialogue: 0,0:03:04.75,0:03:08.00,Default,,0,0,0,,``Америка әскерлер жібереді''
Dialogue: 0,0:03:08.08,0:03:11.25,Default,,0,0,0,,Пенхамстан милициясы табанды қарсылық көрсетті
Dialogue: 0,0:03:11.33,0:03:15.79,Default,,0,0,0,,Бұл халықаралық құқықты бұзу болып табылады. БҰҰ далалық тергеуінің маңызы қандай?
Dialogue: 0,0:03:11.33,0:03:15.79,Default,,0,0,0,,«Пенамстан»
Dialogue: 0,0:03:15.87,0:03:19.12,Default,,0,0,0,,Қауіпсіздік Кеңесі тиімді шараларды қолдана алмаса ——
Dialogue: 0,0:03:19.20,0:03:21.95,Default,,0,0,0,,Гуманитарлық мақсатта әскери араласуға болады
Dialogue: 0,0:03:22.04,0:03:23.70,Default,,0,0,0,,Гуманитарлық мақсатта?
Dialogue: 0,0:03:23.79,0:03:27.91,Default,,0,0,0,,Американың ниеті барлығына түсінікті
Dialogue: 0,0:03:28.00,0:03:32.95,Default,,0,0,0,,Олар гуманитарлық көмек емес, Қытайда тірек орнатуға тырысуда.
Dialogue: 0,0:03:33.04,0:03:35.12,Default,,0,0,0,,Қытайдың қатысы жоқ
Dialogue: 0,0:03:35.20,0:03:38.16,Default,,0,0,0,,Пенхамстан азаматтық соғысты аяқтайды——
Dialogue: 0,0:03:38.25,0:03:42.00,Default,,0,0,0,,Демократияға өту үшін әскери қолдау қажет
Dialogue: 0,0:03:42.08,0:03:46.41,Default,,0,0,0,,Уақытша үкімет демократияландыруға бет алды.
Dialogue: 0,0:03:46.50,0:03:50.58,Default,,0,0,0,,Біз жаңа соғысты бастап жатырмыз...
Dialogue: 0,0:03:52.00,0:03:54.29,Default,,0,0,0,,«Пайдасыз соғыс»
Dialogue: 0,0:03:55.29,0:03:58.75,Default,,0,0,0,,«Елді шегеру үшін қиян-кескі шайқас қиратты».
Dialogue: 0,0:04:00.04,0:04:02.08,Default,,0,0,0,,«Пенхамстан батыры»
Dialogue: 0,0:04:09.04,0:04:12.37,Default,,0,0,0,,«Ақылсыз иттер Пенхамстаннан оралды»
Dialogue: 0,0:04:12.45,0:04:15.70,Default,,0,0,0,,«Генерал-майор Вильсон қош келдіңіз»
Dialogue: 0,0:04:21.75,0:04:23.62,Default,,0,0,0,,«Ақылсыз иттер»
Dialogue: 0,0:04:30.70,0:04:35.12,Default,,0,0,0,,«Маңай тұрғындары суицидтен шошып кетті»
Dialogue: 0,0:04:45.83,0:04:49.00,Default,,0,0,0,,«Ақылсыз иттердің өзін-өзі өлтіруі»
Dialogue: 0,0:04:50.95,0:04:52.87,Default,,0,0,0,,Көбісі өз-өзіне қол жұмсайды
Dialogue: 0,0:04:55.87,0:04:59.87,Default,,0,0,0,,Джейсон және тағы бір адам әлі тірі.
Dialogue: 0,0:05:06.16,0:05:09.58,Default,,0,0,0,,Mad Dogs жасағы, дереу құрамға оралыңыз.
Dialogue: 0,0:05:28.00,0:05:28.75,Default,,0,0,0,,Таза
Dialogue: 0,0:05:28.83,0:05:29.45,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:05:36.66,0:05:37.54,Default,,0,0,0,,Таза!
Dialogue: 0,0:05:37.62,0:05:38.87,Default,,0,0,0,,Менің серігім ұсталды.
Dialogue: 0,0:05:47.29,0:05:48.62,Default,,0,0,0,,Бір адам бар.
Dialogue: 0,0:05:51.54,0:05:53.54,Default,,0,0,0,,Сіз қозғала аласыз ба?
Dialogue: 0,0:05:56.12,0:05:56.83,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:06:00.79,0:06:02.41,Default,,0,0,0,,Жарайды, мен дем алып жатырмын.
Dialogue: 0,0:06:12.91,0:06:14.95,Default,,0,0,0,,Тоқта, атуды күт!
Dialogue: 0,0:06:16.20,0:06:19.37,Default,,0,0,0,,Зардап шеккендерді алып жүру және қолдау көрсету.
Dialogue: 0,0:06:19.45,0:06:20.25,Default,,0,0,0,,Кеттік
Dialogue: 0,0:06:44.16,0:06:46.70,Default,,0,0,0,,Штабқа 7 адамды құтқаруды сұраңыз.
Dialogue: 0,0:06:46.79,0:06:48.70,Default,,0,0,0,,Бір адам ауыр жарақат алды
Dialogue: 0,0:06:48.79,0:06:50.91,Default,,0,0,0,,Тез кел!
Dialogue: 0,0:06:53.20,0:06:54.16,Default,,0,0,0,,Қап!
Dialogue: 0,0:06:56.58,0:06:58.58,Default,,0,0,0,,Оларды өлтіріп, үйге тез қайтайық.
Dialogue: 0,0:06:58.66,0:07:02.62,Default,,0,0,0,,Бұл мүмкін емес, солай ма? Сен ақымақсың ба?
Dialogue: 0,0:07:02.70,0:07:04.75,Default,,0,0,0,,Міне, көзілдірік.
Dialogue: 0,0:07:12.20,0:07:15.29,Default,,0,0,0,,Мен бұған сенбеймін. Бұл не?
Dialogue: 0,0:07:15.37,0:07:16.37,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:07:16.45,0:07:19.16,Default,,0,0,0,,Негізге және есеп беруге оралу
Dialogue: 0,0:07:19.25,0:07:21.66,Default,,0,0,0,,Ол жерде қауіпсіз емес.
Dialogue: 0,0:07:21.75,0:07:25.54,Default,,0,0,0,,Ақымақ болма, мен саған тез арада хабарлауым керек.
Dialogue: 0,0:07:25.62,0:07:28.00,Default,,0,0,0,,Ол неге өлмейді?
Dialogue: 0,0:07:28.08,0:07:29.29,Default,,0,0,0,,Бұл нашар жағдай.
Dialogue: 0,0:07:29.37,0:07:32.25,Default,,0,0,0,,Сондықтан бұл туралы хабарлау керек.
Dialogue: 0,0:07:32.33,0:07:34.37,Default,,0,0,0,,Бұған кім сенеді?
Dialogue: 0,0:07:34.45,0:07:38.58,Default,,0,0,0,,Оның бөлімшесі құпия тапсырмада болуы мүмкін.
Dialogue: 0,0:07:38.66,0:07:39.87,Default,,0,0,0,,Ол өлетін еді.
Dialogue: 0,0:07:39.95,0:07:43.79,Default,,0,0,0,,Олардың бәрін милиция қырып кетсе де, олар әлі де солай...
Dialogue: 0,0:07:43.87,0:07:45.45,Default,,0,0,0,,Қалай болғанда да, есеп беріңіз.
Dialogue: 0,0:07:45.54,0:07:47.70,Default,,0,0,0,,Командование қаланы бомбалады.
Dialogue: 0,0:07:47.79,0:07:51.50,Default,,0,0,0,,Оны да өшіретін болдық. Сөйлессек өлтіреміз.
Dialogue: 0,0:07:53.12,0:07:54.45,Default,,0,0,0,,Күте тұрыңыз, атпаңыз.
Dialogue: 0,0:07:57.00,0:07:57.91,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:07:59.54,0:08:03.12,Default,,0,0,0,,Бұл 5-сыныпты старшина Шенмей.
Dialogue: 0,0:08:03.20,0:08:04.58,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:08:05.75,0:08:08.75,Default,,0,0,0,,Байланыстарыңызды ұстап алу...
Dialogue: 0,0:08:36.50,0:08:37.87,Default,,0,0,0,,Джунси
Dialogue: 0,0:08:53.25,0:08:59.83,Default,,0,0,0,,Қытайдың аумақтық суларына жақын Шанхайға дейін 12 теңіз мильі
Dialogue: 0,0:09:01.95,0:09:05.70,Default,,0,0,0,,Қытайдың аумақтық суларына кіру Анықталған жоқ
Dialogue: 0,0:09:05.79,0:09:08.16,Default,,0,0,0,,Жарайды, сол қалпында қал.
Dialogue: 0,0:09:21.91,0:09:22.83,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,0:09:28.91,0:09:30.70,Default,,0,0,0,,Сіз қорқынышты түс көрдіңіз.
Dialogue: 0,0:09:34.16,0:09:37.54,Default,,0,0,0,,Барлығы мені «Пенхамстанның Батыры» деп атайды
Dialogue: 0,0:09:39.29,0:09:41.37,Default,,0,0,0,,Қандай батыр!
Dialogue: 0,0:09:49.00,0:09:51.41,Default,,0,0,0,,Мен күнде түнде бірдей қорқынышты түс көремін
Dialogue: 0,0:09:53.58,0:09:55.50,Default,,0,0,0,,Пенумстан
Dialogue: 0,0:09:56.20,0:09:57.58,Default,,0,0,0,,Сол күні...
Dialogue: 0,0:09:59.91,0:10:01.58,Default,,0,0,0,,Пенумстан ———
Dialogue: 0,0:10:04.08,0:10:05.25,Default,,0,0,0,,Бұл тозақ болды
Dialogue: 0,0:10:06.04,0:10:07.25,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:08.29,0:10:09.29,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:10:11.45,0:10:13.00,Default,,0,0,0,,Сіз түсінбейсіз
Dialogue: 0,0:10:15.66,0:10:19.75,Default,,0,0,0,,Сенің сезіміңді түсіндім деп айтпаймын.
Dialogue: 0,0:10:21.54,0:10:23.87,Default,,0,0,0,,Бірақ менде де азапты оқиға болды.
Dialogue: 0,0:10:25.45,0:10:27.00,Default,,0,0,0,,Ракон қаласында
Dialogue: 0,0:10:28.20,0:10:30.25,Default,,0,0,0,,Сол жоғалып кеткен қала?
Dialogue: 0,0:10:32.29,0:10:33.50,Default,,0,0,0,,Сіз аман қалдыңыз.
Dialogue: 0,0:10:34.12,0:10:34.95,Default,,0,0,0,,О
Dialogue: 0,0:10:36.33,0:10:39.29,Default,,0,0,0,,Мен жаңадан келген полиция қызметкері едім, келген күні өте кеш болдым.
Dialogue: 0,0:10:41.87,0:10:43.83,Default,,0,0,0,,Сондықтан мен өлген жоқпын
Dialogue: 0,0:10:45.58,0:10:47.45,Default,,0,0,0,,Қала зомбиге толы
Dialogue: 0,0:10:48.79,0:10:52.62,Default,,0,0,0,,Тұрғындардың айқайы есімде...
Dialogue: 0,0:10:53.91,0:10:55.04,Default,,0,0,0,,Еңіреп
Dialogue: 0,0:10:57.41,0:10:59.29,Default,,0,0,0,,Тістеген және өзгерген...
Dialogue: 0,0:11:01.37,0:11:02.70,Default,,0,0,0,,Бұл қорқынышты болды
Dialogue: 0,0:11:06.12,0:11:08.37,Default,,0,0,0,,Бұл көрініс жай ғана...
Dialogue: 0,0:11:09.12,0:11:10.54,Default,,0,0,0,,Тозақ?
Dialogue: 0,0:11:12.62,0:11:13.50,Default,,0,0,0,,О
Dialogue: 0,0:11:16.70,0:11:19.25,Default,,0,0,0,,Үкімет қаланы жасыру үшін жарып жібереді
Dialogue: 0,0:11:19.33,0:11:22.50,Default,,0,0,0,,Дұрыс, біз түсінбеушілікті жойдық.
Dialogue: 0,0:11:23.33,0:11:26.87,Default,,0,0,0,,Елді қорғау үшін қала жойылды.
Dialogue: 0,0:11:28.25,0:11:30.83,Default,,0,0,0,,Бұл қиын шешім болуы керек
Dialogue: 0,0:11:30.91,0:11:33.29,Default,,0,0,0,,Қалада аман қалғандар болды.
Dialogue: 0,0:11:33.37,0:11:36.54,Default,,0,0,0,,Ата-ана мен бала болсақ та, мен оларды тастадым.
Dialogue: 0,0:11:36.62,0:11:38.41,Default,,0,0,0,,Шешім қабылдау қандай қиын
Dialogue: 0,0:11:38.50,0:11:41.50,Default,,0,0,0,,Сенің сезіміңді білемін, сен полицей едің.
Dialogue: 0,0:11:41.58,0:11:45.50,Default,,0,0,0,,Менің жұмысым – адамдарға көмектесу және әділдік орнату.
Dialogue: 0,0:11:45.58,0:11:49.75,Default,,0,0,0,,Бірақ агенттерге бұлай ойлаудың қажеті жоқ.
Dialogue: 0,0:11:50.33,0:11:53.29,Default,,0,0,0,,Найт Ай артта.
Dialogue: 0,0:11:53.37,0:11:57.66,Default,,0,0,0,,Елін халқын ойламай құтқару мүмкін емес.
Dialogue: 0,0:12:02.00,0:12:05.29,Default,,0,0,0,,«Мен қорықтым» дедіңіз.
Dialogue: 0,0:12:07.87,0:12:10.83,Default,,0,0,0,,«Қорқыныштың» түбірі неде деп ойлайсыңдар?
Dialogue: 0,0:12:10.91,0:12:11.91,Default,,0,0,0,,Саана
Dialogue: 0,0:12:13.79,0:12:15.62,Default,,0,0,0,,«Қорқыныш» - «террор»
Dialogue: 0,0:12:19.45,0:12:20.41,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:22.58,0:12:23.58,Default,,0,0,0,,Адамдар ——
Dialogue: 0,0:12:24.95,0:12:27.04,Default,,0,0,0,,Белгісізден қорқу
Dialogue: 0,0:12:27.95,0:12:31.54,Default,,0,0,0,,Этикалық тұрақсыз және——
Dialogue: 0,0:12:32.08,0:12:33.58,Default,,0,0,0,,Өлшенбейтіндік
Dialogue: 0,0:12:34.50,0:12:37.29,Default,,0,0,0,,Белгісізден қорқу...
Dialogue: 0,0:12:37.87,0:12:40.70,Default,,0,0,0,,Адамдардың жүрегінде қорқыныш тудырыңыз
Dialogue: 0,0:12:44.50,0:12:47.50,Default,,0,0,0,,Иә, грек философиясы да осылай дейді.
Dialogue: 0,0:12:48.75,0:12:51.16,Default,,0,0,0,,«Қорқынышты нәрселер көп...»
Dialogue: 0,0:12:53.25,0:12:55.54,Default,,0,0,0,,«Олардың ең ұлысы – адам»
Dialogue: 0,0:12:58.50,0:12:59.95,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:13:23.66,0:13:25.25,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,0:13:31.75,0:13:32.79,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:13:45.75,0:13:49.50,Default,,0,0,0,,Күте тұрыңыз, кемеде мылтық қолдану - өз-өзіне қол жұмсау.
Dialogue: 0,0:14:32.95,0:14:35.41,Default,,0,0,0,,Неліктен ешкім жауап бермейді?
Dialogue: 0,0:14:35.50,0:14:40.54,Default,,0,0,0,,Күдікті вирус жұқтыру Су өткізбейтін есікті жауып, оқшаулаңыз
Dialogue: 0,0:14:40.62,0:14:41.50,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:14:41.58,0:14:44.20,Default,,0,0,0,,Бұл уақытша шара. Жабыңыз.
Dialogue: 0,0:14:44.29,0:14:45.50,Default,,0,0,0,,Жабуға дайындық
Dialogue: 0,0:14:45.58,0:14:46.75,Default,,0,0,0,,Ластанған жер қай жерде?
Dialogue: 0,0:14:46.83,0:14:47.70,Default,,0,0,0,,Садақтың жанында.
Dialogue: 0,0:14:47.79,0:14:49.79,Default,,0,0,0,,Жабу
Dialogue: 0,0:14:52.00,0:14:53.25,Default,,0,0,0,,Жабу аяқталды
Dialogue: 0,0:16:17.54,0:16:18.37,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:16:23.54,0:16:24.91,Default,,0,0,0,,Эй, сен қалжыңдап тұрсың ба?
Dialogue: 0,0:16:39.87,0:16:41.37,Default,,0,0,0,,Бұл B.O.W.
Dialogue: 0,0:16:49.33,0:16:51.79,Default,,0,0,0,,13-код орындалды
Dialogue: 0,0:16:51.87,0:16:55.20,Default,,0,0,0,,Бұл кеме 5 минутта өзін-өзі жояды.
Dialogue: 0,0:16:55.29,0:16:59.16,Default,,0,0,0,,Экипаж көлік қорабында эвакуациялануы керек.
Dialogue: 0,0:16:59.25,0:17:02.66,Default,,0,0,0,,Кері санақ басталады, өзін-өзі жоюға 5 минут қалды
Dialogue: 0,0:17:03.29,0:17:04.41,Default,,0,0,0,,Ірімшік жоқ
Dialogue: 0,0:17:35.50,0:17:37.37,Default,,0,0,0,,Ол тек жақсырақ болады.
Dialogue: 0,0:17:39.50,0:17:42.75,Default,,0,0,0,,Өзін-өзі жоюға дейін 3 минут 30 секунд
Dialogue: 0,0:18:01.79,0:18:04.04,Default,,0,0,0,,Өзін-өзі жоюға дейін 3 минут
Dialogue: 0,0:18:25.58,0:18:26.83,Default,,0,0,0,,Егер Хигучи екінші Кира сияқты тек қарап-ақ адам өлтіре алса, онда Кираның шын кім екені бағдарлама соңында ашылады!
Dialogue: 0,0:18:27.58,0:18:30.12,Default,,0,0,0,,Өзін-өзі жоюға дейін 60 секунд
Dialogue: 0,0:18:30.75,0:18:33.33,Default,,0,0,0,,59… 58…
Dialogue: 0,0:18:33.95,0:18:36.95,Default,,0,0,0,,57… 56…
Dialogue: 0,0:18:37.54,0:18:38.79,Default,,0,0,0,,55…
Dialogue: 0,0:18:42.33,0:18:43.87,Default,,0,0,0,,Бұл егеуқұйрық емес.
Dialogue: 0,0:18:45.41,0:18:47.16,Default,,0,0,0,,Мылтықты орнына қойыңыз.
Dialogue: 0,0:18:48.50,0:18:50.08,Default,,0,0,0,,Бұл өз-өзіне қол жұмсау
Dialogue: 0,0:18:51.91,0:18:53.91,Default,,0,0,0,,Мен сіздің кездесуіңізді үздім бе?
Dialogue: 0,0:19:12.04,0:19:14.29,Default,,0,0,0,,Апат дабылынан бері бір сағат өтті.
Dialogue: 0,0:19:14.95,0:19:19.29,Default,,0,0,0,,Радарға жауап болмады және онымен байланыс үзілді.
Dialogue: 0,0:19:19.37,0:19:23.54,Default,,0,0,0,,Жақын жерде қытай флоты болса керек.
Dialogue: 0,0:19:23.62,0:19:25.70,Default,,0,0,0,,Бұл ең нашар жағдай сценарийі.
Dialogue: 0,0:19:25.79,0:19:27.87,Default,,0,0,0,,Қорғаныс дайындығын (DEFCON) арттыру
Dialogue: 0,0:19:30.29,0:19:33.16,Default,,0,0,0,,Бұл менмін. Мен дағдарыс бөлмесіне бара жатырмын.
Dialogue: 0,0:19:37.95,0:19:39.66,Default,,0,0,0,,<Мен ауа райын айтамын>
Dialogue: 0,0:19:39.66,0:19:40.58,Default,,0,0,0,,<Мен ауа-райын айтамын>
Dialogue: 0,0:19:39.66,0:19:40.58,Default,,0,0,0,,Шанхай, Қытай Халық Республикасы
Dialogue: 0,0:19:40.58,0:19:40.66,Default,,0,0,0,,Шанхай, Қытай Халық Республикасы
Dialogue: 0,0:19:40.66,0:19:44.25,Default,,0,0,0,,Шанхай, Қытай Халық Республикасы
Dialogue: 0,0:19:40.66,0:19:44.25,Default,,0,0,0,,<Кешкі ауа райы ашық, ауа температурасы 16 градус>
Dialogue: 0,0:19:44.25,0:19:45.54,Default,,0,0,0,,<Кешкі ауа райы ашық, ауа температурасы 16 градус>
Dialogue: 0,0:19:45.62,0:19:48.37,Default,,0,0,0,,〈Ертең де күн ашық болады〉
Dialogue: 0,0:19:56.62,0:19:57.66,Default,,0,0,0,,Осы мектепті бітіру – шеберліктің дәлелі.
Dialogue: 0,0:20:03.62,0:20:04.62,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:44.66,0:20:48.16,Default,,0,0,0,,Біз қондық. Түсіндіре аласыз ба?
Dialogue: 0,0:20:51.91,0:20:54.66,Default,,0,0,0,,Алдымен шынайы мақсатыңызды табыңыз
Dialogue: 0,0:20:57.16,0:20:59.25,Default,,0,0,0,,Тіпті экипаж мүшелерін де өлтіріңіз
Dialogue: 0,0:20:59.33,0:21:01.37,Default,,0,0,0,,Бұл үлкен мақсат емес пе?
Dialogue: 0,0:21:04.20,0:21:08.29,Default,,0,0,0,,Егер сен институтқа бармасаң, мұнда неге келдің?
Dialogue: 0,0:21:09.62,0:21:12.20,Default,,0,0,0,,Мен, әрине, басқа мақсатпен келдім.
Dialogue: 0,0:21:13.62,0:21:15.37,Default,,0,0,0,,Бір нәрсені қалпына келтіріңіз
Dialogue: 0,0:21:17.04,0:21:18.08,Default,,0,0,0,,Тіпті араластырсам да—
Dialogue: 0,0:21:19.79,0:21:23.16,Default,,0,0,0,,АҚШ үкіметінің қастандығын әшкерелейтін дәлелдер
Dialogue: 0,0:21:30.16,0:21:32.66,Default,,0,0,0,,Сатқындық? Қызық
Dialogue: 0,0:21:32.75,0:21:34.70,Default,,0,0,0,,Мемлекетке опасыздық жасау туралы хабарлау
Dialogue: 0,0:21:53.87,0:21:55.29,Default,,0,0,0,,Бұл пайдасыз.
Dialogue: 0,0:21:55.37,0:21:58.25,Default,,0,0,0,,Ол бәрібір жабылады
Dialogue: 0,0:21:59.50,0:22:02.41,Default,,0,0,0,,Менің бір нәрсені жасыруға шебер екенімді білесің.
Dialogue: 0,0:22:03.37,0:22:05.62,Default,,0,0,0,,Олар кінәлі
Dialogue: 0,0:22:07.45,0:22:08.83,Default,,0,0,0,,Дәлел дегеніміз не?
Dialogue: 0,0:22:10.20,0:22:11.75,Default,,0,0,0,,Мен қазір оны алуға бара жатырмын.
Dialogue: 0,0:22:12.66,0:22:14.54,Default,,0,0,0,,Маған көмектесейін.
Dialogue: 0,0:22:15.50,0:22:16.91,Default,,0,0,0,,Анықтама?
Dialogue: 0,0:22:18.04,0:22:20.25,Default,,0,0,0,,Экипажды өлтіргендер?
Dialogue: 0,0:22:25.95,0:22:28.29,Default,,0,0,0,,Сіз «қорқыныш» туралы айттыңыз.
Dialogue: 0,0:22:30.25,0:22:32.29,Default,,0,0,0,,Қорқыныш тарайды——
Dialogue: 0,0:22:33.33,0:22:36.79,Default,,0,0,0,,Танылғаннан кейін ол қорқынышқа айналады (террор)
Dialogue: 0,0:22:36.87,0:22:37.91,Default,,0,0,0,,Міне...
Dialogue: 0,0:22:39.54,0:22:41.20,Default,,0,0,0,,Нағыз қорқыныш
Dialogue: 0,0:22:43.45,0:22:46.95,Default,,0,0,0,,Сіз бұл оқиғаны әскери сотта қалағаныңызша айта аласыз.
Dialogue: 0,0:22:48.58,0:22:50.37,Default,,0,0,0,,Көмек бергіңіз келмейді ме?
Dialogue: 0,0:22:55.66,0:22:56.75,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:23:31.58,0:23:32.41,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:23:40.08,0:23:44.25,Default,,0,0,0,,Хироюки Кобаяши жетекшілік етеді
Dialogue: 0,0:25:28.79,0:25:31.70,Default,,0,0,0,,Жапон субтитрлері Канан Фукузава
Dialogue: 0,0:25:33.20,0:25:39.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
