Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:24.62,0:01:27.41,Default,,0,0,0,,«Ақылсыз иттер»
Dialogue: 0,0:02:17.25,0:02:18.79,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:02:23.95,0:02:25.20,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:02:34.12,0:02:39.91,Default,,0,0,0,,Капкомның «Resident Evil» ойынына негізделген
Dialogue: 0,0:03:39.29,0:03:43.66,Default,,0,0,0,,Шанхайдан 1 сағаттық жерде орналасқан қала маңы
Dialogue: 0,0:04:13.04,0:04:15.25,Default,,0,0,0,,Юен мырза сізді күтіп отыр.
Dialogue: 0,0:04:41.62,0:04:44.33,Default,,0,0,0,,〈“Джен терезеге қарады да...”〉
Dialogue: 0,0:04:44.41,0:04:49.37,Default,,0,0,0,,〈“Үлкен кеме портта зәкір қалды”〉
Dialogue: 0,0:04:50.79,0:04:55.04,Default,,0,0,0,,〈“Тағы кездескенше, әке”〉
Dialogue: 0,0:04:55.87,0:04:58.37,Default,,0,0,0,,<“Уәде беремін”>
Dialogue: 0,0:05:00.50,0:05:01.87,Default,,0,0,0,,Шэньмэй
Dialogue: 0,0:05:01.95,0:05:03.20,Default,,0,0,0,,Ата
Dialogue: 0,0:05:05.25,0:05:08.50,Default,,0,0,0,,Бұл балаға бұрыннан оқып берген кітап.
Dialogue: 0,0:05:09.08,0:05:10.45,Default,,0,0,0,,Оған әлі де ұнайтын сияқты
Dialogue: 0,0:05:12.12,0:05:13.58,Default,,0,0,0,,Жақынырақ
Dialogue: 0,0:05:14.37,0:05:16.70,Default,,0,0,0,,Бетіңді көрсетіп, маған айт
Dialogue: 0,0:05:23.70,0:05:25.29,Default,,0,0,0,,...
Dialogue: 0,0:05:29.25,0:05:30.16,Default,,0,0,0,,Хаоран!
Dialogue: 0,0:05:31.25,0:05:32.66,Default,,0,0,0,,Оқ жаудыр!
Dialogue: 0,0:05:38.79,0:05:40.58,Default,,0,0,0,,Енді түсіндіріңіз.
Dialogue: 0,0:05:45.37,0:05:48.45,Default,,0,0,0,,Мұнда ұйықтап жатқан адам - ​​Джунши.
Dialogue: 0,0:05:52.75,0:05:54.16,Default,,0,0,0,,Менің ағам
Dialogue: 0,0:05:58.41,0:06:01.00,Default,,0,0,0,,АҚШ үкіметі оған осылай жасады.
Dialogue: 0,0:06:06.12,0:06:07.87,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:06:09.79,0:06:11.83,Default,,0,0,0,,Джейсон айтқандай
Dialogue: 0,0:06:13.41,0:06:16.00,Default,,0,0,0,,АҚШ үкіметінің қастандықтарын әшкерелеу
Dialogue: 0,0:06:16.66,0:06:20.66,Default,,0,0,0,,Мен осында Қорғаныс хатшысының ұйымдастырушы екенін дәлелдеуге келдім.
Dialogue: 0,0:06:21.95,0:06:24.00,Default,,0,0,0,,Альфа 2 көрінеді
Dialogue: 0,0:06:24.08,0:06:28.08,Default,,0,0,0,,Координаталар 42SWA 9465067929
Dialogue: 0,0:06:28.16,0:06:30.08,Default,,0,0,0,,Басқа құрылғылар күту режимінде.
Dialogue: 0,0:06:30.16,0:06:33.12,Default,,0,0,0,,3 және 6 командалар күту режимінде.
Dialogue: 0,0:06:35.29,0:06:37.66,Default,,0,0,0,,3 және 6 топтарды қайталау...
Dialogue: 0,0:06:37.75,0:06:40.25,Default,,0,0,0,,Нұсқау берілгенше күтіңіз
Dialogue: 0,0:06:44.33,0:06:46.66,Default,,0,0,0,,Mk77 бомбасымен зарарсыздандырыңыз
Dialogue: 0,0:06:46.75,0:06:50.08,Default,,0,0,0,,Құтқару тобы әлі де қалада.
Dialogue: 0,0:06:50.16,0:06:54.20,Default,,0,0,0,,Оларды жұқтырғандай емдеп, барлығын өртеп жіберіңіз.
Dialogue: 0,0:06:54.91,0:06:56.12,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:06:56.20,0:06:58.54,Default,,0,0,0,,3 секунд бұрын түсіруге дайын
Dialogue: 0,0:06:58.62,0:07:00.70,Default,,0,0,0,,Түсіруден 2 секунд бұрын
Dialogue: 0,0:07:00.79,0:07:02.54,Default,,0,0,0,,Атум
Dialogue: 0,0:07:03.66,0:07:04.70,Default,,0,0,0,,Әсер
Dialogue: 0,0:07:05.95,0:07:09.04,Default,,0,0,0,,Мен қала сыртындағы шатырға келдім.
Dialogue: 0,0:07:09.12,0:07:12.37,Default,,0,0,0,,Тірі қалған адамды қамтамасыз ету. Есімі Джунши.
Dialogue: 0,0:07:13.04,0:07:15.83,Default,,0,0,0,,Бұл Mad Dogs командасы. Мен көмек сұраймын.
Dialogue: 0,0:07:19.58,0:07:22.33,Default,,0,0,0,,Олардың бәрін милиция қырып кетсе де, олар әлі де солай көрінеді...
Dialogue: 0,0:07:22.41,0:07:23.87,Default,,0,0,0,,Қалай болғанда да, бұл есеп.
Dialogue: 0,0:07:23.95,0:07:25.83,Default,,0,0,0,,Командование қаланы бомбалады.
Dialogue: 0,0:07:25.91,0:07:29.83,Default,,0,0,0,,Оны да өшіретін болдық. Сөйлессек өлтіреміз.
Dialogue: 0,0:07:31.45,0:07:32.70,Default,,0,0,0,,Күте тұрыңыз, атпаңыз.
Dialogue: 0,0:07:35.20,0:07:36.16,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:07:37.91,0:07:41.04,Default,,0,0,0,,Бұл 5-сыныпты старшина Шенмей.
Dialogue: 0,0:07:41.62,0:07:42.75,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:07:44.41,0:07:47.33,Default,,0,0,0,,Байланыстарыңызды ұстап алу...
Dialogue: 0,0:08:39.12,0:08:43.04,Default,,0,0,0,,Джунси арнайы жасақта өте құпия тапсырмада болды.
Dialogue: 0,0:08:43.91,0:08:47.50,Default,,0,0,0,,Ол кезде Вильсон генерал-майор және қолбасшы болды.
Dialogue: 0,0:08:48.50,0:08:51.66,Default,,0,0,0,,Бірақ сахна артында олар фармацевтикалық компаниялармен бірігіп кетті...
Dialogue: 0,0:08:51.75,0:08:55.00,Default,,0,0,0,,Б.О.В.-ны жоспарлы әскери қолдану.
Dialogue: 0,0:08:57.12,0:09:00.70,Default,,0,0,0,,Сіз бұл тәжірибені Пенхамстанда жасадыңыз ба?
Dialogue: 0,0:09:01.95,0:09:03.45,Default,,0,0,0,,Әлгі бейбақ
Dialogue: 0,0:09:08.79,0:09:11.41,Default,,0,0,0,,Тағы бір адам өз-өзіне қол жұмсады.
Dialogue: 0,0:09:40.37,0:09:42.29,Default,,0,0,0,,Жарайды, мен дем алып жатырмын.
Dialogue: 0,0:09:49.95,0:09:52.62,Default,,0,0,0,,Штабқа 7 адамды құтқаруды сұраңыз.
Dialogue: 0,0:09:52.70,0:09:54.54,Default,,0,0,0,,Бір адам ауыр жарақат алды
Dialogue: 0,0:09:54.62,0:09:56.70,Default,,0,0,0,,Тез кел!
Dialogue: 0,0:09:57.62,0:09:58.58,Default,,0,0,0,,Қап!
Dialogue: 0,0:09:59.70,0:10:02.29,Default,,0,0,0,,Мықты бол, көмек келеді.
Dialogue: 0,0:10:08.75,0:10:11.45,Default,,0,0,0,,Уақытым аз қалды ма деп қорқамын.
Dialogue: 0,0:10:20.37,0:10:22.95,Default,,0,0,0,,Йо аға, сіздің атыңыз кім?
Dialogue: 0,0:10:23.54,0:10:24.87,Default,,0,0,0,,Джунси
Dialogue: 0,0:10:26.08,0:10:31.16,Default,,0,0,0,,Джунси Шынымды айтсам, ешқандай көмек келмейді.
Dialogue: 0,0:10:32.12,0:10:34.83,Default,,0,0,0,,Менің өз күшіммен күресуден басқа амалым жоқ.
Dialogue: 0,0:10:34.91,0:10:36.29,Default,,0,0,0,,Мұны істейік
Dialogue: 0,0:10:37.50,0:10:39.91,Default,,0,0,0,,Мен сені базаға қайтарамын.
Dialogue: 0,0:10:40.54,0:10:42.37,Default,,0,0,0,,Маған тоқырау керек.
Dialogue: 0,0:10:42.45,0:10:44.20,Default,,0,0,0,,Сыртында біртүрлі нәрсе бар.
Dialogue: 0,0:10:49.41,0:10:51.25,Default,,0,0,0,,Мәйіт қайда?
Dialogue: 0,0:11:30.91,0:11:32.37,Default,,0,0,0,,Тістеген!
Dialogue: 0,0:11:40.41,0:11:42.58,Default,,0,0,0,,Атпа! Тоқта!
Dialogue: 0,0:11:44.04,0:11:47.37,Default,,0,0,0,,Не болып жатыр? Чикусо!
Dialogue: 0,0:11:49.37,0:11:50.37,Default,,0,0,0,,Соғыс күші жағынан олар сөзсіз сенімді.
Dialogue: 0,0:12:05.50,0:12:07.29,Default,,0,0,0,,Инъекция.
Dialogue: 0,0:12:12.16,0:12:13.66,Default,,0,0,0,,Ингибитор
Dialogue: 0,0:12:13.75,0:12:14.66,Default,,0,0,0,,Не?
Dialogue: 0,0:12:17.25,0:12:18.37,Default,,0,0,0,,Бұл сөмке.
Dialogue: 0,0:12:24.00,0:12:25.87,Default,,0,0,0,,Олар сені тістеп алды, солай ма?
Dialogue: 0,0:12:28.95,0:12:30.08,Default,,0,0,0,,Инъекция.
Dialogue: 0,0:12:32.87,0:12:33.75,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:12:33.83,0:12:35.20,Default,,0,0,0,,Ингибитор
Dialogue: 0,0:12:37.58,0:12:40.16,Default,,0,0,0,,Соқпасаң құбыжық боласың.
Dialogue: 0,0:12:46.83,0:12:48.08,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:12:58.04,0:13:00.16,Default,,0,0,0,,Баяндамашы: Клэр Редфилд
Dialogue: 0,0:13:00.25,0:13:02.54,Default,,0,0,0,,Мәйіттің өлгеніне бірнеше күн болды.
Dialogue: 0,0:13:02.62,0:13:05.66,Default,,0,0,0,,Мылтықпен өз-өзіне қол жұмсаған көрінеді
Dialogue: 0,0:13:07.66,0:13:10.87,Default,,0,0,0,,Жауапты детектив сізбен кейінірек хабарласады.
Dialogue: 0,0:13:20.79,0:13:23.08,Default,,0,0,0,,Олардың барлығы жұқтырған.
Dialogue: 0,0:13:31.58,0:13:34.04,Default,,0,0,0,,Маған басқышты беріңіз——
Dialogue: 0,0:13:35.75,0:13:37.41,Default,,0,0,0,,Ол осылай көрінеді
Dialogue: 0,0:13:48.00,0:13:48.95,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:13:50.00,0:13:52.25,Default,,0,0,0,,Пікірлер әртүрлі болуы мүмкін, бірақ...
Dialogue: 0,0:13:53.54,0:13:55.00,Default,,0,0,0,,Шындық қатал
Dialogue: 0,0:13:55.79,0:13:59.20,Default,,0,0,0,,Мен мұны істеймін. Қарсылық танытқандар...
Dialogue: 0,0:13:59.95,0:14:03.54,Default,,0,0,0,,Жоқ деп айта аласыз, мен сізді бұлай етуге мәжбүрлемеймін.
Dialogue: 0,0:14:05.12,0:14:08.66,Default,,0,0,0,,Джейсон штабқа емес, ағасының аман қалуына сенеді...
Dialogue: 0,0:14:08.75,0:14:11.75,Default,,0,0,0,,атамызға хабарлаған
Dialogue: 0,0:14:12.33,0:14:16.20,Default,,0,0,0,,Менің атам Шанхайдағы конгломераттың басшысы болған.
Dialogue: 0,0:14:16.29,0:14:19.62,Default,,0,0,0,,Мен сол қулықпен ағамды кіргіздім.
Dialogue: 0,0:14:21.37,0:14:23.58,Default,,0,0,0,,Әскерлер базаға оралды
Dialogue: 0,0:14:23.66,0:14:27.16,Default,,0,0,0,,Ал Вильсон оларды қаһарман ретінде мадақтады.
Dialogue: 0,0:14:27.75,0:14:32.33,Default,,0,0,0,,Тежегіштерсіз олар адам бола алмайды.
Dialogue: 0,0:14:32.41,0:14:35.79,Default,,0,0,0,,Басушыны берудің орнына Уилсон —
Dialogue: 0,0:14:35.87,0:14:38.16,Default,,0,0,0,,Бұйрықтарға бағыну
Dialogue: 0,0:14:38.25,0:14:42.00,Default,,0,0,0,,Ол өз әскерлерін жеке бас пайдасы үшін жасалған қастандықтың бір бөлігіне айналдырды.
Dialogue: 0,0:14:43.16,0:14:45.04,Default,,0,0,0,,Вильсонның иті
Dialogue: 0,0:14:45.12,0:14:48.66,Default,,0,0,0,,Қорғаныс министрі болу үшін осылай көтерілдіңіз бе?
Dialogue: 0,0:14:49.25,0:14:50.62,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:14:52.25,0:14:54.91,Default,,0,0,0,,Ол мемлекеттік қызметкер болғанымен...
Dialogue: 0,0:14:55.00,0:15:00.37,Default,,0,0,0,,Біз фармацевтикалық компаниялармен B.O.W.
Dialogue: 0,0:15:00.91,0:15:03.79,Default,,0,0,0,,Мен оқиғаны толық білмеймін...
Dialogue: 0,0:15:03.87,0:15:06.20,Default,,0,0,0,,Үлкен пайда табу үшін——
Dialogue: 0,0:15:06.29,0:15:08.91,Default,,0,0,0,,Табыстың кілті - ингибитор.
Dialogue: 0,0:15:09.79,0:15:14.04,Default,,0,0,0,,Ақ үй мен сүңгуір қайық оқиғасына кім себепкер болды?
Dialogue: 0,0:15:14.62,0:15:18.08,Default,,0,0,0,,Қытайды қатаң ұстанымға мәжбүрлеу ме?
Dialogue: 0,0:15:19.16,0:15:22.50,Default,,0,0,0,,Джунши алып кеткенде, ол қазірдің өзінде...
Dialogue: 0,0:15:23.50,0:15:27.87,Default,,0,0,0,,Вирус эрозиясы қатты болды және ол біртүрлі пішінге ие болды.
Dialogue: 0,0:15:34.50,0:15:38.54,Default,,0,0,0,,Мен бұл балаға көмектесу үшін ақшамды саламын...
Dialogue: 0,0:15:38.62,0:15:42.25,Default,,0,0,0,,Мен вирусты жоюдың жолын іздедім.
Dialogue: 0,0:15:44.16,0:15:45.70,Default,,0,0,0,,Бірақ ол жұмыс істемеді
Dialogue: 0,0:15:57.20,0:16:02.16,Default,,0,0,0,,Уилсоннан кек алу үшін мен қастандық дәлелдерін іздедім.
Dialogue: 0,0:16:02.25,0:16:04.83,Default,,0,0,0,,Бақылаудан құтылу үшін Джейсон...
Dialogue: 0,0:16:04.91,0:16:06.70,Default,,0,0,0,,Сіз менімен қол ұстастыңыз
Dialogue: 0,0:16:08.08,0:16:10.41,Default,,0,0,0,,Түсіну үшін маған 6 жыл қажет болды
Dialogue: 0,0:16:10.50,0:16:13.33,Default,,0,0,0,,Уилсонды құртатын дәлелдер ——
Dialogue: 0,0:16:13.41,0:16:15.58,Default,,0,0,0,,Ол жақын жерде болды.
Dialogue: 0,0:16:16.79,0:16:21.25,Default,,0,0,0,,Б.О.В. прототипіне айналған сарбаздың денесінде чип болған.
Dialogue: 0,0:16:21.33,0:16:26.25,Default,,0,0,0,,Өмірлік және жауынгерлік деректер жазылады.
Dialogue: 0,0:16:26.33,0:16:27.83,Default,,0,0,0,,Чип?
Dialogue: 0,0:16:28.41,0:16:30.79,Default,,0,0,0,,Джунсидің барлық жазбалары осында
Dialogue: 0,0:16:30.87,0:16:34.16,Default,,0,0,0,,Оны қаруға айналдырып, ұрыс даласына кім жібергенін білеміз.
Dialogue: 0,0:16:35.04,0:16:36.16,Default,,0,0,0,,Оны өртеп жіберіңіз
Dialogue: 0,0:16:40.50,0:16:43.41,Default,,0,0,0,,Сіз барлық дәлелдерді өртеп жібердім деп ойлаған болуыңыз керек.
Dialogue: 0,0:16:44.16,0:16:45.91,Default,,0,0,0,,Соның ішінде інім де бар.
Dialogue: 0,0:16:49.87,0:16:52.62,Default,,0,0,0,,Егер бұл жария етілсе, Вилсон биліктен шығарылады.
Dialogue: 0,0:16:52.70,0:16:57.45,Default,,0,0,0,,Б.О.В. дамуы. аяқталды, ал Джейсон енді бақылауда емес.
Dialogue: 0,0:16:57.54,0:16:58.58,Default,,0,0,0,,Шығарылды
Dialogue: 0,0:17:05.70,0:17:06.54,Default,,0,0,0,,Хаоран!
Dialogue: 0,0:17:06.62,0:17:07.66,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:17:17.29,0:17:19.08,Default,,0,0,0,,Қаш! Асығыңыз!
Dialogue: 0,0:17:19.16,0:17:21.45,Default,,0,0,0,,Джунси ата
Dialogue: 0,0:17:21.54,0:17:23.29,Default,,0,0,0,,Жоқ, мен оны артта қалдыра алмаймын!
Dialogue: 0,0:17:23.37,0:17:24.91,Default,,0,0,0,,Джунси!
Dialogue: 0,0:17:25.83,0:17:26.50,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:26.58,0:17:28.87,Default,,0,0,0,,Джунси ата!
Dialogue: 0,0:17:29.95,0:17:31.16,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:31.75,0:17:32.58,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:17:39.62,0:17:41.37,Default,,0,0,0,,Ол соңғы кезде...
Dialogue: 0,0:17:41.45,0:17:45.16,Default,,0,0,0,,Бұл сөз аздап арандатушылық.
Dialogue: 0,0:17:45.75,0:17:48.16,Default,,0,0,0,,Қытай ыңғайсыз болуы мүмкін
Dialogue: 0,0:17:48.25,0:17:51.83,Default,,0,0,0,,Президент қатаң ұстанымға келісті.
Dialogue: 0,0:17:51.91,0:17:55.62,Default,,0,0,0,,Сақтықпен әрекет еткен дұрыс емес пе?
Dialogue: 0,0:17:55.70,0:17:59.45,Default,,0,0,0,,Қытаймен арақашықтық сезімін сақтау керек пе?
Dialogue: 0,0:18:00.66,0:18:03.29,Default,,0,0,0,,Егер сіз осындай баяндама жасасаңыз——
Dialogue: 0,0:18:03.37,0:18:06.75,Default,,0,0,0,,Ұйқыдағы арыстанды оят
Dialogue: 0,0:18:07.41,0:18:12.58,Default,,0,0,0,,Әлемдік экономикаға әсер етеді және соғысқа әкелуі мүмкін.
Dialogue: 0,0:18:12.66,0:18:16.83,Default,,0,0,0,,Биотерроризмді бұзу Сүңгуір қайықтағы шабуыл ——
Dialogue: 0,0:18:16.91,0:18:19.04,Default,,0,0,0,,Егер одақтас болса, мен мұны істемеймін.
Dialogue: 0,0:18:19.12,0:18:20.95,Default,,0,0,0,,Қытай екенін анықтау мүмкін емес.
Dialogue: 0,0:18:21.04,0:18:26.12,Default,,0,0,0,,Пенумстандағы азаматтық соғыста Қытай сахнаның артында жұмыс істеді.
Dialogue: 0,0:18:26.20,0:18:26.83,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:18:26.91,0:18:28.29,Default,,0,0,0,,Қыңқылдауды қой.
Dialogue: 0,0:18:28.91,0:18:31.91,Default,,0,0,0,,Егер біз Пенумстанға әскерлер жібере алсақ ——
Dialogue: 0,0:18:32.00,0:18:34.33,Default,,0,0,0,,Қытайда өз орнын алу
Dialogue: 0,0:18:34.41,0:18:37.41,Default,,0,0,0,,Қытай мен Еуропа арасындағы сол елден——
Dialogue: 0,0:18:37.50,0:18:40.75,Default,,0,0,0,,Қажет болса, бізге қысым көрсетуге болады
Dialogue: 0,0:18:40.83,0:18:43.37,Default,,0,0,0,,Ол уақыт міндетті түрде келеді.
Dialogue: 0,0:18:44.04,0:18:45.95,Default,,0,0,0,,Дайын бол
Dialogue: 0,0:18:46.04,0:18:49.50,Default,,0,0,0,,Әлемге күшті Американы көрсету——
Dialogue: 0,0:18:49.58,0:18:53.29,Default,,0,0,0,,Еркін дүниенің мүддесін қорғайтыныңызды көрсетіңіз.
Dialogue: 0,0:18:54.20,0:18:57.62,Default,,0,0,0,,«2006 жылғы Бейбітшілік келісімі»
Dialogue: 0,0:19:26.33,0:19:27.50,Default,,0,0,0,,Джейсон
Dialogue: 0,0:19:31.29,0:19:34.95,Default,,0,0,0,,Қорғаныс хатшысы Мен Пенумстанды қолдаймын.
Dialogue: 0,0:19:35.04,0:19:35.87,Default,,0,0,0,,Сіздің талапыңыз қандай?
Dialogue: 0,0:19:35.95,0:19:38.62,Default,,0,0,0,,Мен Mad Dogs туралы шындықты білгім келеді
Dialogue: 0,0:19:38.70,0:19:41.37,Default,,0,0,0,,Сұхбат алу үшін жауапты бөлімнен өтіңіз.
Dialogue: 0,0:19:41.45,0:19:44.75,Default,,0,0,0,,Өз-өзіне қол жұмсаған сарбаздар қалдырған жазбалар бар.
Dialogue: 0,0:20:08.70,0:20:11.45,Default,,0,0,0,,Сіз «қорқыныш» туралы айттыңыз.
Dialogue: 0,0:20:13.33,0:20:15.45,Default,,0,0,0,,Қорқыныш тарайды——
Dialogue: 0,0:20:16.12,0:20:19.12,Default,,0,0,0,,Танылғаннан кейін ол қорқынышқа айналады (террор)
Dialogue: 0,0:20:19.75,0:20:21.25,Default,,0,0,0,,Міне...
Dialogue: 0,0:20:22.12,0:20:23.83,Default,,0,0,0,,Нағыз қорқыныш
Dialogue: 0,0:20:35.66,0:20:37.00,Default,,0,0,0,,Ұшты қайтарыңыз
Dialogue: 0,0:20:38.37,0:20:42.83,Default,,0,0,0,,Уилсонның барлық теріс қылықтарын көпшілік алдында ашыңыз
Dialogue: 0,0:20:42.91,0:20:46.00,Default,,0,0,0,,Сізді АҚШ агенттері нысанаға алады.
Dialogue: 0,0:20:46.58,0:20:48.20,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:20:48.29,0:20:51.37,Default,,0,0,0,,Ағамның басынан өткен қайғылы оқиға қайталанбас үшін
Dialogue: 0,0:20:54.12,0:20:56.00,Default,,0,0,0,,Тіпті сен——
Dialogue: 0,0:20:57.20,0:20:59.41,Default,,0,0,0,,Ракон-Ситиден аман қалған адам, солай ма?
Dialogue: 0,0:21:02.00,0:21:05.04,Default,,0,0,0,,Оны қараңғыда ұстамаңыз
Dialogue: 0,0:21:08.16,0:21:10.41,Default,,0,0,0,,Джейсон да соны қалайды.
Dialogue: 0,0:21:10.50,0:21:14.66,Default,,0,0,0,,Жоқ, Джейсон үшін әділдік маңызды емес.
Dialogue: 0,0:21:15.95,0:21:18.58,Default,,0,0,0,,Мен сізге нағыз сұмдықты көрсеткім келеді
Dialogue: 0,0:21:19.29,0:21:21.12,Default,,0,0,0,,Оның көрген сұмдықтары
Dialogue: 0,0:21:22.25,0:21:25.08,Default,,0,0,0,,Барлығын қорқынышты шындықпен қарсы алу...
Dialogue: 0,0:21:25.75,0:21:27.62,Default,,0,0,0,,Мен бәрін өртеп жіберемін.
Dialogue: 0,0:21:27.70,0:21:29.37,Default,,0,0,0,,Мұндай адам емес
Dialogue: 0,0:21:30.79,0:21:32.08,Default,,0,0,0,,Мен саған сәл толқын тудыруға рұқсат етемін деп ойладым…
Dialogue: 0,0:21:47.37,0:21:48.50,Default,,0,0,0,,Шэньмэй
Dialogue: 0,0:21:50.50,0:21:52.20,Default,,0,0,0,,Джейсон қайда?
Dialogue: 0,0:22:55.04,0:22:59.20,Default,,0,0,0,,Хироюки Кобаяши жетекшілік етеді
Dialogue: 0,0:24:43.75,0:24:46.66,Default,,0,0,0,,Жапон субтитрлері Канан Фукузава
Dialogue: 0,0:24:48.16,0:24:54.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
