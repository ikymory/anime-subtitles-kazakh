Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:49.88,0:00:54.88,Default,,0,0,0,,♪~
Dialogue: 0,0:01:45.14,0:01:50.15,Default,,0,0,0,,~♪
Dialogue: 0,0:02:14.17,0:02:17.80,Default,,0,0,0,,Ұлы қараңғылық жасағандар
Dialogue: 0,0:02:18.51,0:02:23.05,Default,,0,0,0,,Бәрін жалмап тұрған қара жалын
Dialogue: 0,0:02:24.01,0:02:28.39,Default,,0,0,0,,Абыржыған дауылда қара күш ессіз билейді.
Dialogue: 0,0:02:30.15,0:02:35.90,Default,,0,0,0,,Бірақ жалын өткеннен кейін құнарлы жер жанданады.
Dialogue: 0,0:02:36.90,0:02:41.99,Default,,0,0,0,,Жер тағы да құнарлылыққа, қуанышқа толы болады.
Dialogue: 0,0:02:58.30,0:03:00.43,Default,,0,0,0,,Егер Yggdrasil өз жолы болса
Dialogue: 0,0:03:00.84,0:03:04.85,Default,,0,0,0,,Біздің әлемді цифрлық әлем жұтып қояды
Dialogue: 0,0:03:09.48,0:03:10.44,Default,,0,0,0,,(Големонның шайқас айқайы)
Dialogue: 0,0:03:55.40,0:03:56.65,Default,,0,0,0,,Үлкен аға...?
Dialogue: 0,0:04:17.38,0:04:19.17,Default,,0,0,0,,Біз мәңгі бірге болдық
Dialogue: 0,0:04:23.80,0:04:25.64,Default,,0,0,0,,Сол дауылды күннің өзінде
Dialogue: 0,0:04:26.26,0:04:27.97,Default,,0,0,0,,Сол шуақты күн де
Dialogue: 0,0:04:28.97,0:04:30.22,Default,,0,0,0,,Жаңбырлы күндерде де
Dialogue: 0,0:04:30.97,0:04:32.31,Default,,0,0,0,,Уайымдаған күндердің өзінде
Dialogue: 0,0:04:32.98,0:04:34.52,Default,,0,0,0,,Тіпті ашулы күндерде
Dialogue: 0,0:04:36.31,0:04:38.31,Default,,0,0,0,,Мен қарап отырдым...
Dialogue: 0,0:04:39.77,0:04:42.78,Default,,0,0,0,,(оятар дабылы)
Dialogue: 0,0:05:16.69,0:05:17.85,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:05:19.48,0:05:21.07,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:05:22.65,0:05:25.28,Default,,0,0,0,,Қазірдің өзінде! Оян!
Dialogue: 0,0:05:25.65,0:05:27.41,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:05:35.04,0:05:36.25,Default,,0,0,0,,Хикари-чан!
Dialogue: 0,0:05:45.76,0:05:46.80,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:47.18,0:05:48.01,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:09.45,0:06:11.37,Default,,0,0,0,,Ах! Мынаны қара
Dialogue: 0,0:06:16.87,0:06:19.25,Default,,0,0,0,,Ах! Одайба ма?
Dialogue: 0,0:06:19.42,0:06:20.46,Default,,0,0,0,,Мен солай ойлаймын
Dialogue: 0,0:06:20.54,0:06:22.25,Default,,0,0,0,,Мұнда және мұнда бұрмаланулар
Dialogue: 0,0:06:26.05,0:06:28.26,Default,,0,0,0,,Нақты әлем мен цифрлық әлем арасындағы шекара
Dialogue: 0,0:06:28.34,0:06:30.01,Default,,0,0,0,,Ол жоғалып барады.
Dialogue: 0,0:06:30.18,0:06:30.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:31.34,0:06:35.43,Default,,0,0,0,,Егер бұл орын алса, сіз шынайы әлемге қалағаныңызша бара аласыз.
Dialogue: 0,0:06:35.52,0:06:37.35,Default,,0,0,0,,Джомен кез келген уақытта кездесе аласыз.
Dialogue: 0,0:06:37.43,0:06:38.85,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:06:38.94,0:06:42.77,Default,,0,0,0,,Бұдан кейін нақты дүние қала ма деген сұрақ туындайды.
Dialogue: 0,0:06:43.11,0:06:45.48,Default,,0,0,0,,Сандық әлем бәрін жұтып қойса ше?
Dialogue: 0,0:06:45.57,0:06:47.74,Default,,0,0,0,,Йггдрасил қалағандай
Dialogue: 0,0:06:48.40,0:06:49.07,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:50.49,0:06:52.32,Default,,0,0,0,,Сіз маған мұны істеуге рұқсат бересіз бе?
Dialogue: 0,0:06:53.16,0:06:56.83,Default,,0,0,0,,Мені алаңдататын нәрсе — болашақта гомеостаздың қалай дамитындығы.
Dialogue: 0,0:06:57.16,0:07:00.29,Default,,0,0,0,,Мейкомон қараңғы дамыған Офанимонды сіңірді.
Dialogue: 0,0:07:01.33,0:07:03.42,Default,,0,0,0,,Ол одан да күшті болды.
Dialogue: 0,0:07:05.59,0:07:08.30,Default,,0,0,0,,Тұрақтылық пен үйлесімділікке бағытталған гомеостаз,
Dialogue: 0,0:07:08.38,0:07:09.80,Default,,0,0,0,,Мен мұны жай қалдырмаймын деп ойлаймын.
Dialogue: 0,0:07:10.05,0:07:12.01,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:07:12.09,0:07:13.55,Default,,0,0,0,,Мен Мэй Чанды табуым керек.
Dialogue: 0,0:07:16.68,0:07:17.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:18.39,0:07:19.89,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:07:20.18,0:07:23.90,Default,,0,0,0,,Бұл бұрмалау нақты әлеммен байланысты сияқты.
Dialogue: 0,0:07:24.02,0:07:25.06,Default,,0,0,0,,Сол жерден оралуға болады
Dialogue: 0,0:07:36.03,0:07:36.87,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:15.41,0:08:16.24,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:16.41,0:08:17.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:18.45,0:08:19.79,Default,,0,0,0,,Тайчиге көмектесуге барсам да
Dialogue: 0,0:08:20.20,0:08:20.95,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:22.29,0:08:25.25,Default,,0,0,0,,Біз бұдан былай істерді жалғыз басқарамыз.
Dialogue: 0,0:08:25.67,0:08:27.50,Default,,0,0,0,,Сіз Тайчиді тапқыңыз келеді, солай ма?
Dialogue: 0,0:08:27.59,0:08:29.25,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:08:30.05,0:08:31.67,Default,,0,0,0,,Оның орнына, қазір
Dialogue: 0,0:08:31.84,0:08:34.05,Default,,0,0,0,,Әлемді құтқару үшін бізге бір нәрсе істеу керек
Dialogue: 0,0:08:37.43,0:08:38.18,Default,,0,0,0,,(бос күрсіну)
Dialogue: 0,0:08:41.22,0:08:43.64,Default,,0,0,0,,Мен оны әлі сезбеймін...
Dialogue: 0,0:08:46.31,0:08:48.31,Default,,0,0,0,,Сондай-ақ профессор Нишижима туралы
Dialogue: 0,0:08:48.77,0:08:51.23,Default,,0,0,0,,Сондай-ақ Мейкомон және Тайлмон туралы
Dialogue: 0,0:08:53.61,0:08:54.99,Default,,0,0,0,,Сондай-ақ Тайчи туралы...
Dialogue: 0,0:09:00.49,0:09:01.58,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,0:09:04.83,0:09:06.33,Default,,0,0,0,,Сәлем Ямато
Dialogue: 0,0:09:08.50,0:09:11.75,Default,,0,0,0,,Мен оны жай дауыспен айта аламын ба?
Dialogue: 0,0:09:11.84,0:09:12.59,Default,,0,0,0,,О
Dialogue: 0,0:09:20.01,0:09:22.14,Default,,0,0,0,,Тайчи қауіпсіз, солай ма?
Dialogue: 0,0:09:24.18,0:09:27.23,Default,,0,0,0,,Тайчи... Ол өлмейді, солай ма?
Dialogue: 0,0:09:49.04,0:09:49.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:52.59,0:09:53.38,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:09:53.88,0:09:54.96,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:55.30,0:09:56.76,Default,,0,0,0,,Аспан~!
Dialogue: 0,0:09:56.84,0:09:57.63,Default,,0,0,0,,Ах
Dialogue: 0,0:09:58.55,0:09:59.55,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:09:59.64,0:10:00.89,Default,,0,0,0,,Иә? Кя!
Dialogue: 0,0:10:01.30,0:10:02.10,Default,,0,0,0,,Мен сені жылаттым ба? Апыр-ай!
Dialogue: 0,0:10:02.18,0:10:03.68,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:10:03.76,0:10:06.23,Default,,0,0,0,,Не болды, Сора? Ямато сізді қорлады ма?
Dialogue: 0,0:10:06.31,0:10:08.27,Default,,0,0,0,,Біртүрлі махаббат жыры айтылды?
Dialogue: 0,0:10:08.35,0:10:09.27,Default,,0,0,0,,Ән айтпа!
Dialogue: 0,0:10:09.35,0:10:10.65,Default,,0,0,0,,Сіз ән айтасыз!
Dialogue: 0,0:10:18.78,0:10:20.45,Default,,0,0,0,,Тайчи…
Dialogue: 0,0:10:22.78,0:10:26.37,Default,,0,0,0,,Зақым ауыр болды және бүкіл әлемде бір уақытта орын алды.
Dialogue: 0,0:10:26.45,0:10:29.67,Default,,0,0,0,,Электр қуатының үзілуі және сандық құрылғының үзілуі жиі орын алады.
Dialogue: 0,0:10:30.25,0:10:32.96,Default,,0,0,0,,Сонымен қатар, әлемнің кез келген жерінде
Dialogue: 0,0:10:33.04,0:10:35.71,Default,,0,0,0,,Әлі де өте агрессивті Дигимондар бар.
Dialogue: 0,0:10:35.80,0:10:37.97,Default,,0,0,0,,Қайталанатын деструктивті мінез-құлық
Dialogue: 0,0:10:38.30,0:10:40.64,Default,,0,0,0,,Аа, бұл цифрлық әлемнен.
Dialogue: 0,0:10:40.72,0:10:44.18,Default,,0,0,0,,Бұл нақты әлемге басып кіру әрекетінің бөлігі деп болжанады.
Dialogue: 0,0:10:45.68,0:10:47.85,Default,,0,0,0,,Шұғыл әрекет қажет
Dialogue: 0,0:10:48.48,0:10:51.19,Default,,0,0,0,,Әр елдің әскерилерімен бірлесіп жұмыс істеу керек
Dialogue: 0,0:10:54.90,0:10:56.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:59.61,0:11:03.99,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:11:07.37,0:11:11.21,Default,,0,0,0,,Өкінішке орай, бұл адамдар басқара алмайтын жағдай.
Dialogue: 0,0:11:13.75,0:11:14.96,Default,,0,0,0,,(Изуку) Токоями! (Қара көлеңке) Ой!
Dialogue: 0,0:11:15.38,0:11:18.96,Default,,0,0,0,,Гомеостаз Таразыны жоя алмады
Dialogue: 0,0:11:19.17,0:11:19.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:40.03,0:11:41.61,Default,,0,0,0,,Ординемон дүниеге келді
Dialogue: 0,0:11:42.07,0:11:44.91,Default,,0,0,0,,Дүниенің үйлесімділігі жойылды.
Dialogue: 0,0:11:45.49,0:11:46.66,Default,,0,0,0,,Мешин бұл...
Dialogue: 0,0:11:46.95,0:11:48.54,Default,,0,0,0,,Бұл балалар аман ба?
Dialogue: 0,0:11:48.83,0:11:52.75,Default,,0,0,0,,Гомеостаз басқа құрбандықтарды қажет етпейді.
Dialogue: 0,0:11:54.63,0:11:58.00,Default,,0,0,0,,Барлық хаосты күшпен тоқтату үшін
Dialogue: 0,0:11:58.42,0:12:02.55,Default,,0,0,0,,Соңғы жоспарды іске асырудан басқа амалымыз жоқ.
Dialogue: 0,0:12:04.47,0:12:08.51,Default,,0,0,0,,Ординемонды тоқтатпасақ, бұл дүниенің болашағы жоқ.
Dialogue: 0,0:12:11.10,0:12:15.23,Default,,0,0,0,,Бұл адамзат үшін қалған жалғыз нұсқа
Dialogue: 0,0:12:15.44,0:12:19.15,Default,,0,0,0,,Біз мұны жасамасақ, дүние міндетті түрде жойылады.
Dialogue: 0,0:12:19.78,0:12:22.15,Default,,0,0,0,,Пайдасыз қарсылыққа уақыт жоқ.
Dialogue: 0,0:12:27.28,0:12:27.99,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:39.63,0:12:41.09,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:12:41.17,0:12:42.67,Default,,0,0,0,,Хокс та керемет болды.
Dialogue: 0,0:12:43.42,0:12:46.18,Default,,0,0,0,,Бұрын бүкіл жағалаудағы қосалқы орталық
Dialogue: 0,0:12:46.30,0:12:49.05,Default,,0,0,0,,Төтенше жағдай жарияланды.
Dialogue: 0,0:12:49.56,0:12:53.48,Default,,0,0,0,,Азаматтар, мүмкіндігінше көшеге шықпауларыңызды сұраймыз.
Dialogue: 0,0:12:55.85,0:12:59.44,Default,,0,0,0,,Мейкомон туралы әлі толық ақпарат жоқ.
Dialogue: 0,0:12:59.90,0:13:01.65,Default,,0,0,0,,Сіз осында емессіз бе?
Dialogue: 0,0:13:01.73,0:13:03.36,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:13:03.74,0:13:04.90,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:13:05.07,0:13:07.91,Default,,0,0,0,,Ол кезде ол бұрмалануға айналып кеткені сөзсіз.
Dialogue: 0,0:13:07.99,0:13:10.20,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:13:10.41,0:13:11.66,Default,,0,0,0,,Тұр, мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:13:11.79,0:13:14.75,Default,,0,0,0,,Бірақ бұл өте күшті Дигимон.
Dialogue: 0,0:13:14.83,0:13:17.71,Default,,0,0,0,,Біз оны осы дүниеде қайта пайда болғанша тоқтатуымыз керек.
Dialogue: 0,0:13:17.96,0:13:21.63,Default,,0,0,0,,Мен үшін бе?
Dialogue: 0,0:13:21.88,0:13:22.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:25.05,0:13:26.43,Default,,0,0,0,,Менің...
Dialogue: 0,0:13:27.76,0:13:28.84,Default,,0,0,0,,Хикари-сан!
Dialogue: 0,0:13:32.01,0:13:34.31,Default,,0,0,0,,Сенің ағаң қайда?
Dialogue: 0,0:13:35.56,0:13:37.02,Default,,0,0,0,,Қайтып кел...
Dialogue: 0,0:13:42.82,0:13:43.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:44.90,0:13:46.40,Default,,0,0,0,,(Мимидің айқайы)
Dialogue: 0,0:13:46.49,0:13:48.49,Default,,0,0,0,,Мими неге жылап жатыр?
Dialogue: 0,0:13:48.57,0:13:50.66,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:13:51.08,0:13:53.99,Default,,0,0,0,,Үлкен аға...чан...
Dialogue: 0,0:13:55.00,0:13:56.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:56.46,0:13:57.29,Default,,0,0,0,,Хикари-чан!
Dialogue: 0,0:13:57.87,0:13:59.46,Default,,0,0,0,,Қатты қызба...
Dialogue: 0,0:14:00.71,0:14:02.00,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:14:02.17,0:14:04.30,Default,,0,0,0,,Мен өзімді мәжбүрлеген болуым керек.
Dialogue: 0,0:14:07.26,0:14:09.39,Default,,0,0,0,,Мен, Хикари-сан
Dialogue: 0,0:14:09.47,0:14:11.30,Default,,0,0,0,,Мен кешірім сұрауды білмеймін.
Dialogue: 0,0:14:11.89,0:14:12.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:14.14,0:14:17.06,Default,,0,0,0,,Өйткені бастапқыда бәрі...
Dialogue: 0,0:14:17.14,0:14:19.23,Default,,0,0,0,,Мэй мен Мэй араласты.
Dialogue: 0,0:14:19.31,0:14:20.81,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз
Dialogue: 0,0:14:21.27,0:14:22.82,Default,,0,0,0,,Ондай нәрсе жоқ!
Dialogue: 0,0:14:23.57,0:14:26.36,Default,,0,0,0,,Жақсы немесе жаман туралы ойлама
Dialogue: 0,0:14:26.69,0:14:29.57,Default,,0,0,0,,Енді асыға күтейік.
Dialogue: 0,0:14:30.32,0:14:31.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:32.78,0:14:35.20,Default,,0,0,0,,Хикари-чан, мен саған демалуға рұқсат етемін.
Dialogue: 0,0:14:39.62,0:14:42.79,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:14:42.88,0:14:43.75,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:46.96,0:14:49.38,Default,,0,0,0,,Біздің де Тайчидің үлесі бар.
Dialogue: 0,0:14:53.05,0:14:54.85,Default,,0,0,0,,Ұзындығы~ (Ұзындығы) Иә?
Dialogue: 0,0:14:55.51,0:14:56.89,Default,,0,0,0,,Не болды? Гомамон
Dialogue: 0,0:14:56.97,0:14:58.43,Default,,0,0,0,,Қараңдаршы, Коромон.
Dialogue: 0,0:14:58.52,0:15:01.60,Default,,0,0,0,,Ах... ха... а...
Dialogue: 0,0:15:02.02,0:15:03.86,Default,,0,0,0,,Гуватто! Бұл қиын!
Dialogue: 0,0:15:04.32,0:15:05.90,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:15:05.98,0:15:06.82,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:15:06.90,0:15:09.70,Default,,0,0,0,,Қанша ұрыс-керіс болған соң, қарның аш емес пе?
Dialogue: 0,0:15:09.78,0:15:11.66,Default,,0,0,0,,Қарным ашса бәрібір.
Dialogue: 0,0:15:11.74,0:15:13.12,Default,,0,0,0,,Мен айтамын
Dialogue: 0,0:15:13.74,0:15:15.91,Default,,0,0,0,,Ансан, оны кешкі асқа қойғың келе ме?
Dialogue: 0,0:15:15.99,0:15:18.12,Default,,0,0,0,,Әлде ваннаға түсуім керек пе?
Dialogue: 0,0:15:18.37,0:15:20.62,Default,,0,0,0,,Әй, сен жас әйел сияқтысың.
Dialogue: 0,0:15:20.83,0:15:22.83,Default,,0,0,0,,Күріш күріш!
Dialogue: 0,0:15:22.92,0:15:24.38,Default,,0,0,0,,Тамақ! Ия, кешкі ас!
Dialogue: 0,0:15:24.46,0:15:25.59,Default,,0,0,0,,Кешкі ас! Кешкі ас!
Dialogue: 0,0:15:25.67,0:15:26.84,Default,,0,0,0,,Кешкі ас! Кешкі ас!
Dialogue: 0,0:15:26.92,0:15:29.13,Default,,0,0,0,,Күріш күріш! Түскі ас!
Dialogue: 0,0:15:52.53,0:15:53.36,Default,,0,0,0,,(Ямато күрсінуі)
Dialogue: 0,0:16:00.29,0:16:01.37,Default,,0,0,0,,Тайчи…
Dialogue: 0,0:16:06.04,0:16:08.67,Default,,0,0,0,,Осы маңызды уақытта жоғалып кетпеңіз...
Dialogue: 0,0:16:10.09,0:16:11.30,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:16:11.80,0:16:13.18,Default,,0,0,0,,А... Габумон!
Dialogue: 0,0:16:14.01,0:16:16.14,Default,,0,0,0,,Көп жегеннен кейін мен үлкен болып кеттім.
Dialogue: 0,0:16:16.22,0:16:17.18,Default,,0,0,0,,Мен ең жек көретін сөздерім—
Dialogue: 0,0:16:17.43,0:16:19.39,Default,,0,0,0,,Ах... хехе
Dialogue: 0,0:16:21.18,0:16:24.85,Default,,0,0,0,,“ko” әрпінен басталатын Ямато Дигимон Карута таңбалары
Dialogue: 0,0:16:24.94,0:16:25.73,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:16:25.81,0:16:27.19,Default,,0,0,0,,ше? Карута?
Dialogue: 0,0:16:27.82,0:16:31.19,Default,,0,0,0,,«Егер сізде қандай да бір қиындық туындаса, серіктесіңіз Дигимонмен кеңесіңіз.»
Dialogue: 0,0:16:31.57,0:16:34.41,Default,,0,0,0,,Жоқ, бірінші рет естіп тұрмын.
Dialogue: 0,0:16:34.86,0:16:36.62,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:36.70,0:16:38.95,Default,,0,0,0,,Мен оны рұқсатсыз жасадым.
Dialogue: 0,0:16:39.03,0:16:39.95,Default,,0,0,0,,Хехе...
Dialogue: 0,0:16:40.45,0:16:41.12,Default,,0,0,0,,Иә
Dialogue: 0,0:16:43.46,0:16:44.71,Default,,0,0,0,,Ямато О
Dialogue: 0,0:16:46.21,0:16:47.63,Default,,0,0,0,,Мен осындамын, солай ма?
Dialogue: 0,0:16:47.71,0:16:49.21,Default,,0,0,0,,Маған бірдеңе айтыңыз
Dialogue: 0,0:16:49.29,0:16:51.46,Default,,0,0,0,,Жалғыз нәрселер, азапты заттар
Dialogue: 0,0:16:51.76,0:16:52.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:54.51,0:16:56.14,Default,,0,0,0,,Мен әрқашан сенің жаныңда боламын
Dialogue: 0,0:16:56.22,0:16:59.26,Default,,0,0,0,,Ямато «Жоқ» десе де, мен сенімен бірге боламын.
Dialogue: 0,0:17:00.47,0:17:01.18,Default,,0,0,0,,Иә
Dialogue: 0,0:17:01.47,0:17:04.27,Default,,0,0,0,,Ямато үйленіп, балалы болса ше?
Dialogue: 0,0:17:04.39,0:17:06.77,Default,,0,0,0,,Мен балаға қамқор боламын.
Dialogue: 0,0:17:06.85,0:17:07.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:07.94,0:17:10.02,Default,,0,0,0,,Ямато ағай болғанда
Dialogue: 0,0:17:10.11,0:17:11.73,Default,,0,0,0,,Саунаға бірге бару
Dialogue: 0,0:17:11.98,0:17:13.57,Default,,0,0,0,,Ямато ата болған кезде
Dialogue: 0,0:17:13.65,0:17:15.49,Default,,0,0,0,,Ендеше бірге серуендейміз
Dialogue: 0,0:17:15.78,0:17:17.41,Default,,0,0,0,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:17:17.53,0:17:19.16,Default,,0,0,0,,Тіпті Ямато ересек адамға айналса да
Dialogue: 0,0:17:19.24,0:17:24.29,Default,,0,0,0,,Мен мәңгілік керек болсам...
Dialogue: 0,0:17:24.37,0:17:26.37,Default,,0,0,0,,Мен әрқашан...
Dialogue: 0,0:17:29.42,0:17:31.88,Default,,0,0,0,,Мен бәрін істей аламын
Dialogue: 0,0:17:35.13,0:17:36.97,Default,,0,0,0,,Сіз әлемді құтқарасыз ба?
Dialogue: 0,0:17:39.14,0:17:43.35,Default,,0,0,0,,Жетеді... Түсінемін.
Dialogue: 0,0:17:46.14,0:17:49.10,Default,,0,0,0,,Мен қазір түсінгендеймін.
Dialogue: 0,0:17:53.44,0:17:54.90,Default,,0,0,0,,Тайчи не айтты
Dialogue: 0,0:17:56.20,0:17:59.24,Default,,0,0,0,,Сізді не уайымдады? Бұл сен сияқты емес.
Dialogue: 0,0:17:59.45,0:18:01.37,Default,,0,0,0,,Ескі болсаң...
Dialogue: 0,0:18:01.74,0:18:03.20,Default,,0,0,0,,Қолымыздан келмейді ғой, иә?
Dialogue: 0,0:18:04.54,0:18:06.25,Default,,0,0,0,,Бұрынғыдан басқаша.
Dialogue: 0,0:18:11.79,0:18:16.01,Default,,0,0,0,,Мен бұрынғыдан көп нәрсені көремін, енді оларды түсінбеймін.
Dialogue: 0,0:18:17.88,0:18:21.22,Default,,0,0,0,,Біздің істеп жатқан ісіміз жақсы ма?
Dialogue: 0,0:18:22.30,0:18:26.43,Default,,0,0,0,,Әлде бұл жаман нәрсе ме...
Dialogue: 0,0:18:36.40,0:18:39.11,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ екенін де білемін.
Dialogue: 0,0:18:39.95,0:18:42.32,Default,,0,0,0,,Бірақ бұл оңай емес.
Dialogue: 0,0:18:43.58,0:18:44.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:46.16,0:18:48.33,Default,,0,0,0,,Бұл жай ғана қашып кетті.
Dialogue: 0,0:18:53.67,0:18:55.71,Default,,0,0,0,,Маңызды нәрсені жоғалтудан қорқу...
Dialogue: 0,0:18:57.46,0:18:58.97,Default,,0,0,0,,Тайчи кетті...
Dialogue: 0,0:19:01.47,0:19:02.30,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:03.97,0:19:04.97,Default,,0,0,0,,Ямато
Dialogue: 0,0:19:07.39,0:19:10.35,Default,,0,0,0,,Ямато - Тайчиді алмастыра алатын жалғыз адам.
Dialogue: 0,0:19:10.89,0:19:13.90,Default,,0,0,0,,Тайчидің де мұны қалайтынына сенімдімін.
Dialogue: 0,0:19:14.44,0:19:15.11,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:16.73,0:19:18.69,Default,,0,0,0,,Ямато біледі, солай ма?
Dialogue: 0,0:19:22.95,0:19:24.58,Default,,0,0,0,,(Яматоның жылағаны)
Dialogue: 0,0:19:29.37,0:19:31.04,Default,,0,0,0,,Жылама
Dialogue: 0,0:19:31.92,0:19:33.29,Default,,0,0,0,,Мені жылатпа
Dialogue: 0,0:19:38.30,0:19:39.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:39.46,0:19:41.38,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:19:41.93,0:19:43.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:45.35,0:19:47.56,Default,,0,0,0,,А...
Dialogue: 0,0:19:53.69,0:19:55.31,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:19:55.48,0:19:57.61,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:01.53,0:20:03.78,Default,,0,0,0,,Сол жігіттер...
Dialogue: 0,0:20:04.07,0:20:05.53,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:20:06.99,0:20:09.37,Default,,0,0,0,,
Dialogue: 0,0:20:09.45,0:20:11.08,Default,,0,0,0,,Жоқ! Бұрмалау?
Dialogue: 0,0:20:16.29,0:20:17.09,Default,,0,0,0,,Yamato!
Dialogue: 0,0:20:19.71,0:20:20.42,Default,,0,0,0,,О
Dialogue: 0,0:20:20.51,0:20:21.47,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:20:28.31,0:20:31.10,Default,,0,0,0,,
Dialogue: 0,0:20:34.81,0:20:35.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:51.50,0:20:52.37,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:21:07.39,0:21:13.60,Default,,0,0,0,,(Ординемонның айқайы)
Dialogue: 0,0:21:13.77,0:21:14.64,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:21:14.73,0:21:15.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:16.14,0:21:17.65,Default,,0,0,0,,Мейкомон пайда болды!
Dialogue: 0,0:21:20.77,0:21:22.65,Default,,0,0,0,,Бұл өте қауіпті жағдай! (Адамдардың үрейлі дауыстары)
Dialogue: 0,0:21:22.73,0:21:25.86,Default,,0,0,0,,Айналадағы адамдар дереу эвакуациялануы керек.
Dialogue: 0,0:21:45.76,0:21:51.18,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:21:59.60,0:22:04.19,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,0:22:05.03,0:22:08.78,Default,,0,0,0,,Неліктен мұндай қиыншылықты тудырар едіңіз?
Dialogue: 0,0:22:09.20,0:22:12.03,Default,,0,0,0,,Дәл мен қалаған нәрсе.
Dialogue: 0,0:22:12.33,0:22:14.95,Default,,0,0,0,,Дұрыс, істе, көп жаса!
Dialogue: 0,0:22:15.62,0:22:17.66,Default,,0,0,0,,Бәрін құрт!
Dialogue: 0,0:22:17.75,0:22:19.96,Default,,0,0,0,,Дүние бәрібір шіріген қоқыс сияқты.
Dialogue: 0,0:22:20.58,0:22:23.46,Default,,0,0,0,,Менің ойымша, тіпті адамдардың табақшасында тым көп нәрсе бар!
Dialogue: 0,0:22:24.21,0:22:27.17,Default,,0,0,0,,Бәрін құрт, мен онымен айналысамын.
Dialogue: 0,0:22:27.26,0:22:28.88,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:22:28.97,0:22:32.47,Default,,0,0,0,,Йггдрасил басқаратын жаңа әлем дүниеге келді!
Dialogue: 0,0:22:32.76,0:22:35.97,Default,,0,0,0,,Құтты болсын, дүние жүзінің бейбақтары!
Dialogue: 0,0:22:36.85,0:22:38.98,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:22:39.44,0:22:41.56,Default,,0,0,0,,Жақын жерде тұрсаңыз, тынышталыңыз.
Dialogue: 0,0:22:41.65,0:22:43.94,Default,,0,0,0,,Алдымен өзіңізді қорғаңыз.
Dialogue: 0,0:22:49.61,0:22:51.32,Default,,0,0,0,,Тайчи мен Хикариден естідіңіз бе?
Dialogue: 0,0:22:51.41,0:22:53.08,Default,,0,0,0,,Жоқ, әлі жоқ...
Dialogue: 0,0:22:53.16,0:22:55.12,Default,,0,0,0,,Біз де хабарласа алмаймыз.
Dialogue: 0,0:22:55.20,0:22:58.21,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:23:10.51,0:23:14.51,Default,,0,0,0,,Жарайды, ол балалар оны әрқашан жеңіп шықты.
Dialogue: 0,0:23:16.22,0:23:18.02,Default,,0,0,0,,Сенуден басқа амалым жоқ
Dialogue: 0,0:23:18.35,0:23:19.18,Default,,0,0,0,,Иә
Dialogue: 0,0:23:22.90,0:23:24.48,Default,,0,0,0,,Би!
Dialogue: 0,0:23:26.27,0:23:28.11,Default,,0,0,0,,Көбірек биле!
Dialogue: 0,0:23:29.03,0:23:30.28,Default,,0,0,0,,Аға, неге әрдайым кешірім сұрайсың?
Dialogue: 0,0:23:31.70,0:23:33.28,Default,,0,0,0,,Би!
Dialogue: 0,0:23:34.12,0:23:38.58,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:23:52.63,0:23:55.80,Default,,0,0,0,,Сабыр ет! Өтінемін, сабыр сақтаңыз!
Dialogue: 0,0:24:07.44,0:24:08.69,Default,,0,0,0,,Бұл...
Dialogue: 0,0:24:08.78,0:24:10.32,Default,,0,0,0,,Бұл макияж ма?
Dialogue: 0,0:24:10.94,0:24:12.61,Default,,0,0,0,,Офанимонды жұту
Dialogue: 0,0:24:12.70,0:24:15.07,Default,,0,0,0,,Бұл үлкен мәселе болады...
Dialogue: 0,0:24:15.49,0:24:17.78,Default,,0,0,0,,Мэй...чан...
Dialogue: 0,0:24:19.29,0:24:23.83,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:24:27.88,0:24:29.09,Default,,0,0,0,,Кеттік, Габумон!
Dialogue: 0,0:24:29.38,0:24:30.09,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:24:42.81,0:24:45.31,Default,,0,0,0,,Тентомон эволюциясы! Габумон эволюциясы!
Dialogue: 0,0:25:04.16,0:25:05.50,Default,,0,0,0,,Гарурумон! Тогемон!
Dialogue: 0,0:25:05.58,0:25:07.25,Default,,0,0,0,,Бердрамон! Кабутеримон!
Dialogue: 0,0:25:07.33,0:25:08.96,Default,,0,0,0,,Иккакумон!
Dialogue: 0,0:25:19.89,0:25:23.64,Default,,0,0,0,,Birdramon супер эволюциясы!
Dialogue: 0,0:25:33.28,0:25:34.36,Default,,0,0,0,,Weregarurumon!
Dialogue: 0,0:25:34.44,0:25:36.32,Default,,0,0,0,,Атлас Кабутеримон!
Dialogue: 0,0:25:36.40,0:25:37.86,Default,,0,0,0,,Зудомон!
Dialogue: 0,0:25:38.45,0:25:40.87,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:25:48.96,0:25:50.46,Default,,0,0,0,,Нихихи... Иә?
Dialogue: 0,0:25:50.84,0:25:51.50,Default,,0,0,0,,Біріншіден, қарсыласты гайка кілтесімен есінен тандырарлықтай ұрудың қаталдығы
Dialogue: 0,0:25:55.92,0:25:58.47,Default,,0,0,0,,Сіз бұл пішінді әлі де пайдаланасыз ба?
Dialogue: 0,0:25:58.55,0:26:01.35,Default,,0,0,0,,Дүниелердің бірігуі ілгері баспайтын сияқты.
Dialogue: 0,0:26:01.81,0:26:04.85,Default,,0,0,0,,Цк, гомеостаздағы ит...
Dialogue: 0,0:26:05.64,0:26:07.19,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:26:07.60,0:26:09.98,Default,,0,0,0,,Сіз қатыгез шоуды көруге келдіңіз бе?
Dialogue: 0,0:26:10.56,0:26:14.32,Default,,0,0,0,,Жойылып бара жатқан халықтың соңғы биі
Dialogue: 0,0:26:14.40,0:26:17.90,Default,,0,0,0,,Біз әлемде үйлесімділік пен тұрақтылықты қалаймыз
Dialogue: 0,0:26:17.99,0:26:20.24,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,0:26:20.32,0:26:21.53,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:26:21.62,0:26:24.41,Default,,0,0,0,,Дүниедегі үйлесімділік пен тұрақтылық дегеніміз не?
Dialogue: 0,0:26:24.58,0:26:27.83,Default,,0,0,0,,Бәрін құртты ғой, олар да біз сияқты емес пе?
Dialogue: 0,0:26:28.04,0:26:30.38,Default,,0,0,0,,Менің ойым сізден бөлек.
Dialogue: 0,0:26:30.46,0:26:33.84,Default,,0,0,0,,Гомеостаз – дүниенің тәртібі
Dialogue: 0,0:26:34.25,0:26:36.67,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:26:36.76,0:26:38.55,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:26:38.88,0:26:41.89,Default,,0,0,0,,Сіз бірдеңені жоғары сөйлеп, кейін сізді абайсызда сататын адамсыз ба?
Dialogue: 0,0:26:41.97,0:26:44.72,Default,,0,0,0,,Мен бұл ойынды жақсы көремін.
Dialogue: 0,0:26:44.81,0:26:47.35,Default,,0,0,0,,Хоум-чан, бұл өте жиіркенішті, мен ессіз қалдым!
Dialogue: 0,0:26:47.64,0:26:49.98,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,0:26:50.48,0:26:54.48,Default,,0,0,0,,Ординемонның санасы қалған сияқты.
Dialogue: 0,0:26:54.90,0:26:57.36,Default,,0,0,0,,Ол серіктестерінің дауысына жауап берді.
Dialogue: 0,0:26:57.82,0:26:59.74,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:26:59.82,0:27:01.87,Default,,0,0,0,,Олардың бәрі бәрібір жоғалады.
Dialogue: 0,0:27:02.24,0:27:04.87,Default,,0,0,0,,Гомеостаз қазір не істесе де, ол пайдасыз.
Dialogue: 0,0:27:04.87,0:27:05.62,Default,,0,0,0,,Қазір гомеостаз не істесе де, пайдасы жоқ.
Dialogue: 0,0:27:04.87,0:27:05.62,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:27:12.75,0:27:15.05,Default,,0,0,0,,Өзіңізге ұнамайтын нәрсені жойыңыз
Dialogue: 0,0:27:15.13,0:27:16.92,Default,,0,0,0,,Сіз ойдың не екенін білесіз бе?
Dialogue: 0,0:27:17.09,0:27:18.63,Default,,0,0,0,,Йггдрасилге сәлем!
Dialogue: 0,0:27:49.50,0:27:50.83,Default,,0,0,0,,Пайдасы жоқ.
Dialogue: 0,0:27:54.13,0:27:54.92,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:27:56.04,0:28:00.42,Default,,0,0,0,,Атлас Кабутеримонның соңғы эволюциясы!
Dialogue: 0,0:28:13.52,0:28:14.81,Default,,0,0,0,,Металл Гарурумон!
Dialogue: 0,0:28:14.90,0:28:16.94,Default,,0,0,0,,Геркуле Кабутеримон!
Dialogue: 0,0:28:17.02,0:28:18.11,Default,,0,0,0,,Вайкемон!
Dialogue: 0,0:28:19.19,0:28:21.99,Default,,0,0,0,,Арктикалық боран!
Dialogue: 0,0:28:25.41,0:28:27.70,Default,,0,0,0,,Гаруру Томахавк!
Dialogue: 0,0:28:28.83,0:28:31.83,Default,,0,0,0,,Жұлдыз жарығы!
Dialogue: 0,0:28:32.71,0:28:35.29,Default,,0,0,0,,Тыйым салынған азғыру!
Dialogue: 0,0:28:36.46,0:28:38.50,Default,,0,0,0,,Giga Blaster!
Dialogue: 0,0:28:43.13,0:28:43.88,Default,,0,0,0,,Не!
Dialogue: 0,0:28:45.09,0:28:46.14,Default,,0,0,0,,Бұл жұмыс істемейді...
Dialogue: 0,0:28:46.68,0:28:47.89,Default,,0,0,0,,Бұл...
Dialogue: 0,0:28:48.35,0:28:50.18,Default,,0,0,0,,(Ординемонның айқайы)
Dialogue: 0,0:28:56.31,0:28:58.57,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:29:25.34,0:29:26.05,Default,,0,0,0,,Гррр…
Dialogue: 0,0:29:26.76,0:29:28.43,Default,,0,0,0,,Қарғыс атсын... күшті!
Dialogue: 0,0:29:28.55,0:29:30.22,Default,,0,0,0,,Таңдалған балалар
Dialogue: 0,0:29:30.76,0:29:32.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:33.35,0:29:36.14,Default,,0,0,0,,Мен гомеостаз хабаршысымын
Dialogue: 0,0:29:36.23,0:29:38.73,Default,,0,0,0,,Және сіздің достарыңыз
Dialogue: 0,0:29:42.82,0:29:45.49,Default,,0,0,0,,Хакмон... және соңғы түрі...
Dialogue: 0,0:29:47.70,0:29:48.95,Default,,0,0,0,,Джесмон
Dialogue: 0,0:29:49.49,0:29:51.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:00.63,0:30:02.96,Default,,0,0,0,,Ку... Сол кезде...
Dialogue: 0,0:30:05.05,0:30:06.38,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:30:06.59,0:30:08.76,Default,,0,0,0,,Сіз, Тайчи және басқалар үшін...
Dialogue: 0,0:30:08.84,0:30:10.39,Default,,0,0,0,,Мими-кун! Уф...
Dialogue: 0,0:30:10.68,0:30:14.64,Default,,0,0,0,,Йггдрасил Таразыны «әлемді жоюдың кілті» деп атады.
Dialogue: 0,0:30:15.39,0:30:19.15,Default,,0,0,0,,Олай болса, жаңадан жасалған Ординемон
Dialogue: 0,0:30:19.48,0:30:21.65,Default,,0,0,0,,Сандық әлем және нақты әлем
Dialogue: 0,0:30:21.73,0:30:24.11,Default,,0,0,0,,Екі дүниені бұзудың кілті
Dialogue: 0,0:30:27.53,0:30:28.78,Default,,0,0,0,,Ординемон...
Dialogue: 0,0:30:30.11,0:30:32.95,Default,,0,0,0,,Балалар, сендер менімен тең емессіңдер.
Dialogue: 0,0:30:33.37,0:30:36.58,Default,,0,0,0,,Өзінің басым күшін басқара алмау
Dialogue: 0,0:30:37.04,0:30:40.17,Default,,0,0,0,,Мақсатсыз кезіп жүрген қайғылы қауіп
Dialogue: 0,0:30:40.25,0:30:40.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:41.38,0:30:45.21,Default,,0,0,0,,Гомеостаз қазірдің өзінде жоспарлаудың соңғы сатысында
Dialogue: 0,0:30:45.84,0:30:49.34,Default,,0,0,0,,Менің енді Йггдрасилге қалағанын жасауға рұқсат ету ойым жоқ.
Dialogue: 0,0:30:49.43,0:30:51.18,Default,,0,0,0,,Қорытынды жоспар?
Dialogue: 0,0:30:52.01,0:30:54.31,Default,,0,0,0,,Бұл нақты әлемнің қайта жүктелуі.
Dialogue: 0,0:30:54.56,0:30:55.56,Default,,0,0,0,,(Барлығының таңданған дауысы)
Dialogue: 0,0:30:57.77,0:30:58.89,Default,,0,0,0,,Қайта жүктеу…
Dialogue: 0,0:31:00.56,0:31:04.94,Default,,0,0,0,,Нақты әлем мен цифрлық әлемнің астарлы грамматикасы әртүрлі.
Dialogue: 0,0:31:05.48,0:31:11.41,Default,,0,0,0,,Бұл бастапқыда айналар қосындысы болды және ол екі дүниенің айырмашылығы ретінде көрінді.
Dialogue: 0,0:31:12.78,0:31:16.37,Default,,0,0,0,,Дегенмен, нақты әлемнің цифрлық деректері қазірдің өзінде
Dialogue: 0,0:31:16.45,0:31:18.96,Default,,0,0,0,,Сандық әлемнің грамматикасымен тозған
Dialogue: 0,0:31:19.04,0:31:21.42,Default,,0,0,0,,Оның құрылымы қайта жазылуда
Dialogue: 0,0:31:21.83,0:31:25.71,Default,,0,0,0,,Есептеулер бойынша барлығы 94524 секундта қайта жазылады.
Dialogue: 0,0:31:26.21,0:31:29.72,Default,,0,0,0,,Шынайы әлем өзгереді және кванттық мұхитқа оралады.
Dialogue: 0,0:31:30.22,0:31:31.34,Default,,0,0,0,,Не?
Dialogue: 0,0:31:32.84,0:31:34.68,Default,,0,0,0,,Оның алдын алу үшін
Dialogue: 0,0:31:34.76,0:31:37.22,Default,,0,0,0,,Шынайы әлемді қайта жүктеуден басқа таңдау жоқ
Dialogue: 0,0:31:37.89,0:31:39.85,Default,,0,0,0,,Қайта жүктеу аяқталуы керек...
Dialogue: 0,0:31:40.06,0:31:43.86,Default,,0,0,0,,Бұл Дигимонның естеліктері қайтадан жоғалады дегенді білдіре ме?
Dialogue: 0,0:31:43.94,0:31:46.86,Default,,0,0,0,,Жоқ, мен оны басқа күні жасадым.
Dialogue: 0,0:31:46.94,0:31:48.82,Default,,0,0,0,,Сақтық көшірме өрісі дайындалғандықтан
Dialogue: 0,0:31:48.90,0:31:50.65,Default,,0,0,0,,Менің ойымша, бәрі жақсы...
Dialogue: 0,0:31:51.15,0:31:53.78,Default,,0,0,0,,Оның орнына барлық цифрлық құрылғылар
Dialogue: 0,0:31:53.87,0:31:55.74,Default,,0,0,0,,Егер бастапқы күйге оралсақ
Dialogue: 0,0:31:55.83,0:31:57.99,Default,,0,0,0,,Зиян өлшеусіз.
Dialogue: 0,0:31:58.37,0:32:02.96,Default,,0,0,0,,Егер сәтті болса, әлемді жою кілті бастапқы күйіне оралады.
Dialogue: 0,0:32:03.04,0:32:07.25,Default,,0,0,0,,Нақты әлемді қайта жүктеу - адамзаттың соңғы үміті.
Dialogue: 0,0:32:10.30,0:32:12.84,Default,,0,0,0,,Бұл менің оны қабылдаудан басқа амалым жоқ дегенді білдіре ме?
Dialogue: 0,0:32:13.34,0:32:15.39,Default,,0,0,0,,Шынайы әлемді сақтау үшін...
Dialogue: 0,0:32:22.39,0:32:24.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:32:36.45,0:32:39.70,Default,,0,0,0,,Тайчи не айтар еді?
Dialogue: 0,0:32:40.24,0:32:41.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:43.21,0:32:44.71,Default,,0,0,0,,Мен оның солай екеніне сенімдімін
Dialogue: 0,0:32:44.96,0:32:47.50,Default,,0,0,0,,Мүмкіндігінше, ең аз құрбандықпен жолды таңдауға тырысыңыз.
Dialogue: 0,0:32:56.84,0:32:58.01,Default,,0,0,0,,Мен қарсымын!
Dialogue: 0,0:32:58.43,0:33:02.27,Default,,0,0,0,,Электр газ Суды қаржыландыру Авиациялық теміржол медицинасы
Dialogue: 0,0:33:02.35,0:33:05.81,Default,,0,0,0,,Ал ғарыш және ядролық материалдарға байланысты мемлекеттік органдар...
Dialogue: 0,0:33:05.90,0:33:09.02,Default,,0,0,0,,Әлемнің кез келген жері цифрлыға айналды!
Dialogue: 0,0:33:09.27,0:33:11.53,Default,,0,0,0,,Қайта жүктеу тым қауіпті!
Dialogue: 0,0:33:12.36,0:33:13.53,Default,,0,0,0,,Мен берілмеймін
Dialogue: 0,0:33:14.15,0:33:16.82,Default,,0,0,0,,Біз соңына дейін басқа жолдарды іздеуді жалғастырамыз!
Dialogue: 0,0:33:17.03,0:33:19.12,Default,,0,0,0,,Ах... Коуширо
Dialogue: 0,0:33:22.04,0:33:25.54,Default,,0,0,0,,Қайта жүктеу гомеостаз еркімен басталады
Dialogue: 0,0:33:26.62,0:33:31.75,Default,,0,0,0,,Оған дейін біз Ординемонның бұл жерде жабайы болуына жол бере алмаймыз.
Dialogue: 0,0:33:31.84,0:33:34.05,Default,,0,0,0,,Мен оны теңізге тарта аламын ба?
Dialogue: 0,0:33:34.67,0:33:36.55,Default,,0,0,0,,Уау, мен?
Dialogue: 0,0:33:43.22,0:33:45.14,Default,,0,0,0,,Бұл жерде зиянның үлкен екені рас.
Dialogue: 0,0:33:47.06,0:33:49.31,Default,,0,0,0,,Оларды кеңірек жерге апарған дұрыс.
Dialogue: 0,0:33:49.40,0:33:51.61,Default,,0,0,0,,Қоршаған ортаға әсері аз
Dialogue: 0,0:33:53.15,0:33:54.07,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:33:57.28,0:33:58.45,Default,,0,0,0,,Сынап көрейін
Dialogue: 0,0:34:04.66,0:34:06.33,Default,,0,0,0,,Бәрің жақсысыңдар ма?
Dialogue: 0,0:34:06.41,0:34:08.33,Default,,0,0,0,,Әй, эй, бұл сыйлық.
Dialogue: 0,0:34:08.58,0:34:11.29,Default,,0,0,0,,Көп тамақтаныңыз және өзіңізді жақсы сезініңіз
Dialogue: 0,0:34:11.96,0:34:14.84,Default,,0,0,0,,Уф, мен өмірге қайта оралдым.
Dialogue: 0,0:34:15.30,0:34:17.34,Default,,0,0,0,,Рахмет Джо
Dialogue: 0,0:34:17.76,0:34:20.85,Default,,0,0,0,,(Агумонның тамақ ішкен дыбысы)
Dialogue: 0,0:34:23.64,0:34:25.60,Default,,0,0,0,,Агумон көп жейді
Dialogue: 0,0:34:25.68,0:34:28.10,Default,,0,0,0,,Көңіл-күйімді көтеру үшін жақсы тамақтануым керек.
Dialogue: 0,0:34:28.56,0:34:31.36,Default,,0,0,0,,Тайчи қайтып келген жағдайда
Dialogue: 0,0:34:31.77,0:34:32.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:34.48,0:34:35.36,Default,,0,0,0,,Агумон
Dialogue: 0,0:34:37.86,0:34:40.74,Default,,0,0,0,,Куу~ Сен мені жылатпайсың ба?
Dialogue: 0,0:34:41.12,0:34:42.99,Default,,0,0,0,,Сая махёға сенеді
Dialogue: 0,0:34:43.16,0:34:44.87,Default,,0,0,0,,Тайлмон Ханмо Мейку Ханмо
Dialogue: 0,0:34:44.95,0:34:47.04,Default,,0,0,0,,Барлығыңыз қайтып келіңіздер!
Dialogue: 0,0:34:47.12,0:34:50.71,Default,,0,0,0,,Иә! Мен сені тағы көремін!
Dialogue: 0,0:34:58.01,0:34:59.97,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:35:00.05,0:35:00.89,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:35:00.97,0:35:04.93,Default,,0,0,0,,Жоқ... Мен бірдеңе табуым керек.
Dialogue: 0,0:35:05.06,0:35:07.52,Default,,0,0,0,,Қайта жүктеуді болдырмаудың кез келген жолы...
Dialogue: 0,0:35:07.60,0:35:08.81,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:35:09.27,0:35:10.27,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:35:11.10,0:35:13.19,Default,,0,0,0,,
Dialogue: 0,0:35:17.15,0:35:20.15,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:35:29.58,0:35:32.00,Default,,0,0,0,,Бұл бұрын да болған.
Dialogue: 0,0:35:32.63,0:35:34.79,Default,,0,0,0,,Сандық әлемді қайта жүктеу уақыты
Dialogue: 0,0:35:35.63,0:35:37.96,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:35:38.42,0:35:41.18,Default,,0,0,0,,Кешіріңіз, есімде жоқ.
Dialogue: 0,0:35:41.47,0:35:44.22,Default,,0,0,0,,көремін. Бұл дұрыс.
Dialogue: 0,0:35:46.89,0:35:48.18,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:36:00.78,0:36:03.24,Default,,0,0,0,,Һм! Ұф!
Dialogue: 0,0:36:10.91,0:36:14.00,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:36:25.55,0:36:26.22,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:36:27.72,0:36:30.39,Default,,0,0,0,,Амансың ба? Ягами...
Dialogue: 0,0:36:31.52,0:36:32.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:33.39,0:36:34.23,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:36:38.44,0:36:39.57,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:36:41.78,0:36:42.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:48.41,0:36:52.46,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын...
Dialogue: 0,0:36:53.66,0:36:55.96,Default,,0,0,0,,Әй, мұғалім...
Dialogue: 0,0:37:00.42,0:37:02.26,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:37:02.59,0:37:03.84,Default,,0,0,0,,Артық кетпеген дұрыс
Dialogue: 0,0:37:04.51,0:37:05.43,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:37:05.89,0:37:09.81,Default,,0,0,0,,Енді... Сандық әлемнің бір жерінде, менің ойымша.
Dialogue: 0,0:37:11.06,0:37:13.23,Default,,0,0,0,,(Компьютер жұмысының дыбысы)
Dialogue: 0,0:37:13.48,0:37:14.14,Default,,0,0,0,,Не!
Dialogue: 0,0:37:25.11,0:37:26.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:32.16,0:37:32.83,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:37:33.87,0:37:36.12,Default,,0,0,0,,Дайсуке! Барлығына да!
Dialogue: 0,0:37:37.42,0:37:38.83,Default,,0,0,0,,(компьютер жұмысының дыбысы)
Dialogue: 0,0:37:38.92,0:37:40.04,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:37:40.46,0:37:43.55,Default,,0,0,0,,Ой, мен ұйықтап жатырмын.
Dialogue: 0,0:37:44.97,0:37:45.88,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:37:47.18,0:37:50.55,Default,,0,0,0,,Менің сендерден жасырып жүрген бір үлкен сырым бар.
Dialogue: 0,0:37:53.02,0:37:54.52,Default,,0,0,0,,Дайсуке Мотомия
Dialogue: 0,0:37:54.85,0:37:56.19,Default,,0,0,0,,Кен Ичидодзи
Dialogue: 0,0:37:56.39,0:37:57.81,Default,,0,0,0,,Мияко Иноуэ
Dialogue: 0,0:37:57.90,0:37:59.15,Default,,0,0,0,,Иори Хида
Dialogue: 0,0:37:59.48,0:38:02.40,Default,,0,0,0,,Төрт адам көптен бері хабарсыз кеткен.
Dialogue: 0,0:38:02.48,0:38:03.19,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:38:04.11,0:38:06.78,Default,,0,0,0,,Факті жасыруға бұйрық берілді
Dialogue: 0,0:38:06.86,0:38:09.53,Default,,0,0,0,,Ақпарат мұқият бақылауға алынды
Dialogue: 0,0:38:11.24,0:38:12.70,Default,,0,0,0,,Неліктен бұлай...
Dialogue: 0,0:38:13.62,0:38:17.16,Default,,0,0,0,,Ол Йггдрасилдің жоспарын тауып, жойылды.
Dialogue: 0,0:38:18.21,0:38:21.25,Default,,0,0,0,,Маған нұсқау берген адам директор Химекава болды.
Dialogue: 0,0:38:21.79,0:38:23.59,Default,,0,0,0,,Йггдрасилмен одақтас
Dialogue: 0,0:38:24.92,0:38:29.14,Default,,0,0,0,,Өткен шайқаста Химе-чанның Дигимоны құрбан болды.
Dialogue: 0,0:38:29.59,0:38:30.34,Default,,0,0,0,,Қайта жүктеу арқылы
Dialogue: 0,0:38:30.43,0:38:32.85,Default,,0,0,0,,Серіктесіңіз Дигимонды тірілтіңіз
Dialogue: 0,0:38:33.10,0:38:35.10,Default,,0,0,0,,Бұл оның мақсаты болды
Dialogue: 0,0:38:36.48,0:38:39.65,Default,,0,0,0,,Ол ештеңеге қарамастан қайта жүктеуге бәс тігеді
Dialogue: 0,0:38:39.77,0:38:41.90,Default,,0,0,0,,Жоғалған байланыстарды қалпына келтіруге тырысты
Dialogue: 0,0:38:43.07,0:38:44.57,Default,,0,0,0,,Сіз оны қайтардыңыз ба?
Dialogue: 0,0:38:45.86,0:38:47.70,Default,,0,0,0,,Жоқ, білмеймін.
Dialogue: 0,0:38:49.91,0:38:51.57,Default,,0,0,0,,Сіз қазір де тірісіз бе?
Dialogue: 0,0:38:52.95,0:38:56.12,Default,,0,0,0,,Кейде серіктес Дигимонның болуы адамды құтқара алады.
Dialogue: 0,0:38:56.58,0:38:58.87,Default,,0,0,0,,Кейде ол адамды жынды етеді
Dialogue: 0,0:38:59.29,0:39:01.79,Default,,0,0,0,,Мен Химе-чанды ертерек тоқтатқан болсам ғой.
Dialogue: 0,0:39:02.63,0:39:04.21,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:39:08.05,0:39:09.97,Default,,0,0,0,,Шешім қаншалықты ауыр болса да
Dialogue: 0,0:39:10.30,0:39:12.30,Default,,0,0,0,,Бас тартуға тура келетін кездер болады.
Dialogue: 0,0:39:14.51,0:39:17.27,Default,,0,0,0,,Басқа адам дос болса да...
Dialogue: 0,0:39:18.89,0:39:19.77,Default,,0,0,0,,Мэй-чан...
Dialogue: 0,0:39:20.73,0:39:21.81,Default,,0,0,0,,Достар...?
Dialogue: 0,0:39:23.48,0:39:24.15,Default,,0,0,0,,Құт
Dialogue: 0,0:39:25.86,0:39:27.32,Default,,0,0,0,,Құбыжықтармен күресетіндер
Dialogue: 0,0:39:27.40,0:39:30.86,Default,,0,0,0,,Өзіміз құбыжық болудан сақ болуымыз керек.
Dialogue: 0,0:39:31.28,0:39:32.07,Default,,0,0,0,,Не!
Dialogue: 0,0:39:34.08,0:39:36.45,Default,,0,0,0,,Тұңғиыққа қарайтындар
Dialogue: 0,0:39:36.54,0:39:40.37,Default,,0,0,0,,Тұңғиық та маған қарап тұр.
Dialogue: 0,0:39:40.46,0:39:41.12,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:39:44.25,0:39:46.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:51.43,0:39:53.14,Default,,0,0,0,,Тіршілікті қамтамасыз ету жүйесі тоқтатылды ма?
Dialogue: 0,0:39:53.89,0:39:57.93,Default,,0,0,0,,Оларға көмектесу үшін оларды нақты әлемге жеткізіңіз.
Dialogue: 0,0:39:58.27,0:40:02.14,Default,,0,0,0,,Дегенмен, сіз оны орындаған кезде, міне...
Dialogue: 0,0:40:02.23,0:40:03.90,Default,,0,0,0,,<Алғашқы қадамды жасау>
Dialogue: 0,0:40:04.27,0:40:05.56,Default,,0,0,0,,Жоқ! (Нишижима) Ах!
Dialogue: 0,0:40:06.48,0:40:08.82,Default,,0,0,0,,Орындар сізге бөлінген.
Dialogue: 0,0:40:08.90,0:40:12.20,Default,,0,0,0,,Мейірімді Лорд Йггдрасилдің ұйымдастыруымен.
Dialogue: 0,0:40:12.28,0:40:14.20,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:40:14.57,0:40:16.66,Default,,0,0,0,,Бір адамға ғана жетеді!
Dialogue: 0,0:40:16.74,0:40:20.16,Default,,0,0,0,,Ах! Кешіріңіз!
Dialogue: 0,0:40:20.25,0:40:25.25,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,0:40:29.13,0:40:32.26,Default,,0,0,0,,Адамның дәрменсіздігін есте сақта!
Dialogue: 0,0:40:32.34,0:40:37.05,Default,,0,0,0,,Өйткені, балалар, Дигимонсыз ештеңе істей алмайсыңдар!
Dialogue: 0,0:40:37.22,0:40:41.14,Default,,0,0,0,,Аяғыңды босқа айқастырып алған сайқымазақсың. Сіз клоунсыз!
Dialogue: 0,0:40:41.35,0:40:45.52,Default,,0,0,0,,Қатты айқайлау арқылы маған күресулеріңізді көрсетіңіз! Эй!
Dialogue: 0,0:40:45.65,0:40:47.44,Default,,0,0,0,,Таңдаулы балалар!
Dialogue: 0,0:40:47.77,0:40:52.78,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,0:40:54.66,0:40:57.45,Default,,0,0,0,,Ұят, адамдар!
Dialogue: 0,0:40:57.53,0:40:59.45,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,0:41:01.54,0:41:02.20,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:41:03.08,0:41:03.87,Default,,0,0,0,,Ягами...
Dialogue: 0,0:41:03.96,0:41:05.96,Default,,0,0,0,,Бір нәрсе болуы керек, мүлдем!
Dialogue: 0,0:41:06.83,0:41:08.96,Default,,0,0,0,,Барлығына көмектесу тәсілі!
Dialogue: 0,0:41:09.09,0:41:10.00,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:41:13.80,0:41:15.18,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,0:41:20.89,0:41:23.89,Default,,0,0,0,,(компьютер жұмысының дыбысы)
Dialogue: 0,0:41:28.23,0:41:29.36,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:41:29.44,0:41:31.48,Default,,0,0,0,,Тасымалдау құрылғысын тексеріңіз.
Dialogue: 0,0:41:32.40,0:41:36.91,Default,,0,0,0,,Егер біз оны нақты әлемге көшіре алсақ, сол жерден байланысуымыз мүмкін.
Dialogue: 0,0:41:37.07,0:41:37.87,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:41:45.62,0:41:47.00,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:41:47.08,0:41:47.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:48.21,0:41:50.17,Default,,0,0,0,,Ауыстыруға дайындықты бастаңыз
Dialogue: 0,0:41:50.25,0:41:51.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:52.13,0:41:55.01,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:41:56.01,0:41:57.01,Default,,0,0,0,,♬~
Dialogue: 0,0:41:57.43,0:42:01.64,Default,,0,0,0,,(Нишидзиманың ауыр тыныс алуы)
Dialogue: 0,0:42:01.72,0:42:04.02,Default,,0,0,0,,Мен оны сұрадым... Ягами
Dialogue: 0,0:42:06.06,0:42:07.02,Default,,0,0,0,,Аһ!
Dialogue: 0,0:42:12.19,0:42:14.15,Default,,0,0,0,,Арх! мұғалім!
Dialogue: 0,0:42:14.24,0:42:15.03,Default,,0,0,0,,Жүр!
Dialogue: 0,0:42:17.86,0:42:20.03,Default,,0,0,0,,Ашық! Арх! (Нишижима) Кеттік.
Dialogue: 0,0:42:22.16,0:42:22.33,Default,,0,0,0,,Арх! Өтінемін, ашыңыз!
Dialogue: 0,0:42:22.33,0:42:23.99,Default,,0,0,0,,Арх! Өтінемін, ашыңыз!
Dialogue: 0,0:42:22.33,0:42:23.99,Default,,0,0,0,,Мен бас тартқан жоқпын
Dialogue: 0,0:42:23.99,0:42:24.75,Default,,0,0,0,,Арх! Өтінемін, ашыңыз!
Dialogue: 0,0:42:24.83,0:42:25.37,Default,,0,0,0,,Мұғалім! Уф!
Dialogue: 0,0:42:25.37,0:42:26.50,Default,,0,0,0,,Мұғалім! Уф!
Dialogue: 0,0:42:25.37,0:42:26.50,Default,,0,0,0,,Балалар сендер маған үйреттіңдер.
Dialogue: 0,0:42:26.50,0:42:27.25,Default,,0,0,0,,Балалар сендер маған үйреттіңдер.
Dialogue: 0,0:42:27.25,0:42:27.41,Default,,0,0,0,,Балалар сендер маған үйреттіңдер.
Dialogue: 0,0:42:27.25,0:42:27.41,Default,,0,0,0,,Уф! Арх!
Dialogue: 0,0:42:27.41,0:42:28.00,Default,,0,0,0,,Уф! Арх!
Dialogue: 0,0:42:28.00,0:42:29.71,Default,,0,0,0,,Уф! Арх!
Dialogue: 0,0:42:28.00,0:42:29.71,Default,,0,0,0,,Мен соңына дейін істей алатын бір нәрсе болуы керек.
Dialogue: 0,0:42:29.71,0:42:30.04,Default,,0,0,0,,Мен соңына дейін істей алатын бірдеңе болуы керек.
Dialogue: 0,0:42:32.17,0:42:35.21,Default,,0,0,0,,Болашақ жалғасады... байланысты
Dialogue: 0,0:42:35.84,0:42:37.34,Default,,0,0,0,,Саған сеніп тапсырамын
Dialogue: 0,0:42:37.88,0:42:39.72,Default,,0,0,0,,Мен ересек адам болдым...
Dialogue: 0,0:42:41.76,0:42:42.93,Default,,0,0,0,,Біздің...
Dialogue: 0,0:42:44.93,0:42:45.81,Default,,0,0,0,,Үміт…
Dialogue: 0,0:42:49.94,0:42:51.48,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:42:52.23,0:42:53.57,Default,,0,0,0,,Тыңда, Ягами.
Dialogue: 0,0:42:54.32,0:42:58.65,Default,,0,0,0,,Сізді қандай азапты шындық күтіп тұрса да, ешқашан берілмеңіз
Dialogue: 0,0:42:59.20,0:43:01.28,Default,,0,0,0,,Балалар, сендер болашақты жасайсыңдар
Dialogue: 0,0:43:04.91,0:43:06.12,Default,,0,0,0,,Арман бұл...
Dialogue: 0,0:43:07.25,0:43:08.46,Default,,0,0,0,,Үлкен!
Dialogue: 0,0:43:08.54,0:43:09.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:33.73,0:43:36.90,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:43:45.49,0:43:46.62,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:44:02.13,0:44:04.64,Default,,0,0,0,,Меймей, шынымен жақсысың ба?
Dialogue: 0,0:44:05.14,0:44:06.64,Default,,0,0,0,,Біз де сенімен біргеміз.
Dialogue: 0,0:44:07.06,0:44:09.64,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:44:10.14,0:44:11.44,Default,,0,0,0,,Біз де сондамыз
Dialogue: 0,0:44:11.77,0:44:12.85,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:44:12.94,0:44:14.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:44:15.19,0:44:19.15,Default,,0,0,0,,Ол сонымен қатар Тайлмон және Мейкомон...
Dialogue: 0,0:44:19.53,0:44:20.57,Default,,0,0,0,,Иә...
Dialogue: 0,0:44:22.15,0:44:22.86,Default,,0,0,0,,Иә...
Dialogue: 0,0:44:22.95,0:44:24.16,Default,,0,0,0,,Ммм
Dialogue: 0,0:44:24.87,0:44:26.78,Default,,0,0,0,,Мен қалай көмектесе аламын?
Dialogue: 0,0:44:27.03,0:44:29.04,Default,,0,0,0,,Мейкомон және Тайлмон
Dialogue: 0,0:44:29.41,0:44:31.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:35.04,0:44:37.92,Default,,0,0,0,,
Dialogue: 0,0:44:41.13,0:44:42.68,Default,,0,0,0,,Барлық жерде бәрі ақылсыз болып жатыр.
Dialogue: 0,0:44:43.55,0:44:45.39,Default,,0,0,0,,Ординемонның әсері
Dialogue: 0,0:44:51.52,0:44:53.69,Default,,0,0,0,,Мен мұнда не істеуім керек?
Dialogue: 0,0:44:54.40,0:44:56.36,Default,,0,0,0,,Ештеңе істеудің қажеті жоқ
Dialogue: 0,0:44:56.81,0:44:59.11,Default,,0,0,0,,Біздің болжамымыз дұрыс болса
Dialogue: 0,0:44:59.23,0:45:01.07,Default,,0,0,0,,Сіздің қозғалыстарыңызға байланысты
Dialogue: 0,0:45:01.32,0:45:03.90,Default,,0,0,0,,Ординемон да табиғи түрде қозғала бастайды.
Dialogue: 0,0:45:03.99,0:45:05.82,Default,,0,0,0,,Бұл шынымен солай ма?
Dialogue: 0,0:45:07.03,0:45:09.62,Default,,0,0,0,,Қазір сол қыз, Мэй Чан
Dialogue: 0,0:45:10.33,0:45:12.41,Default,,0,0,0,,Мен осылай бітсем де
Dialogue: 0,0:45:12.50,0:45:14.71,Default,,0,0,0,,Мені есіңізде ме?
Dialogue: 0,0:45:14.79,0:45:17.54,Default,,0,0,0,,Дигимон мен адамдар арасындағы серіктестік
Dialogue: 0,0:45:17.63,0:45:19.46,Default,,0,0,0,,Шексіз мүмкіндіктер бар
Dialogue: 0,0:45:19.71,0:45:22.46,Default,,0,0,0,,Қандай жағдай болса да таң қалмаймыз.
Dialogue: 0,0:45:22.59,0:45:23.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:23.92,0:45:27.18,Default,,0,0,0,,Гомеостаз біздің досымыз ма?
Dialogue: 0,0:45:27.30,0:45:28.47,Default,,0,0,0,,Әлде жау?
Dialogue: 0,0:45:28.72,0:45:31.97,Default,,0,0,0,,«Тұрақтылық пен келісімді қалайтындар».
Dialogue: 0,0:45:34.18,0:45:37.77,Default,,0,0,0,,Мей-чанды қорғағың келе ме, әлде оны жойғың келе ме?
Dialogue: 0,0:45:38.69,0:45:40.27,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:45:40.61,0:45:43.99,Default,,0,0,0,,Сіз бұл дүние туралы қаншалықты ойлайсыз?
Dialogue: 0,0:45:46.45,0:45:47.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:45:47.99,0:45:50.99,Default,,0,0,0,,Менің бұлай айтуға құқығым жоқ.
Dialogue: 0,0:45:51.41,0:45:53.91,Default,,0,0,0,,Дүниені осындай дүрбелеңде ұстайық...
Dialogue: 0,0:45:57.62,0:45:59.29,Default,,0,0,0,,Кешірім сұраудың қажеті жоқ
Dialogue: 0,0:45:59.75,0:46:03.46,Default,,0,0,0,,Біз сізді өз себептерімізбен қатыстырдық.
Dialogue: 0,0:46:04.38,0:46:07.26,Default,,0,0,0,,Қайта жүктеу менің де ниетім емес.
Dialogue: 0,0:46:07.76,0:46:08.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:12.68,0:46:17.44,Default,,0,0,0,,(Ординемонның айқайы)
Dialogue: 0,0:46:17.52,0:46:18.60,Default,,0,0,0,,Мэй-чан...
Dialogue: 0,0:46:32.49,0:46:33.62,Default,,0,0,0,,Қозғала бастады
Dialogue: 0,0:46:37.54,0:46:38.54,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:46:38.62,0:46:39.29,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:46:39.63,0:46:43.00,Default,,0,0,0,,Бұл жалғаса берсе, ақырында қайта жүктеу орын алуы мүмкін.
Dialogue: 0,0:46:43.30,0:46:47.01,Default,,0,0,0,,Егер нақты әлем қайта іске қосылса, хаос болады.
Dialogue: 0,0:46:47.09,0:46:49.38,Default,,0,0,0,,О, сөзсіз.
Dialogue: 0,0:46:49.47,0:46:52.89,Default,,0,0,0,,Әлем бұрын-соңды болмаған дағдарысқа ұшырауы мүмкін.
Dialogue: 0,0:46:52.97,0:46:57.10,Default,,0,0,0,,Бірақ Yggdrasil гомеостаз...
Dialogue: 0,0:46:57.52,0:46:59.90,Default,,0,0,0,,Қандай жоспар орындалса да
Dialogue: 0,0:46:59.98,0:47:01.31,Default,,0,0,0,,Дүниені құтқару мүмкін емес
Dialogue: 0,0:47:04.65,0:47:06.40,Default,,0,0,0,,Ординемонға енгізілген
Dialogue: 0,0:47:06.49,0:47:08.32,Default,,0,0,0,,Мейкомон және Тайлмон
Dialogue: 0,0:47:08.57,0:47:10.32,Default,,0,0,0,,Не болады екен деп ойлаймын
Dialogue: 0,0:47:10.86,0:47:12.24,Default,,0,0,0,,Біз де білмейміз
Dialogue: 0,0:47:12.32,0:47:13.58,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:47:13.70,0:47:14.95,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:47:15.04,0:47:15.74,Default,,0,0,0,,Әй?
Dialogue: 0,0:47:16.20,0:47:18.46,Default,,0,0,0,,Коуширо?
Dialogue: 0,0:47:18.71,0:47:19.46,Default,,0,0,0,,Не болды?
Dialogue: 0,0:47:19.71,0:47:22.04,Default,,0,0,0,,Ол бұрын Сандық әлемде ұсталған.
Dialogue: 0,0:47:22.13,0:47:24.34,Default,,0,0,0,,Дайсуке мен оның достары табылды!
Dialogue: 0,0:47:24.71,0:47:25.59,Default,,0,0,0,,Не?
Dialogue: 0,0:47:25.67,0:47:27.42,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін.
Dialogue: 0,0:47:27.51,0:47:29.84,Default,,0,0,0,,Ауруханаға ертерек жеткізілген сияқты.
Dialogue: 0,0:47:29.97,0:47:32.64,Default,,0,0,0,,Бірақ маңызды мәселе цифрлық әлемде
Dialogue: 0,0:47:32.72,0:47:33.85,Default,,0,0,0,,Оларды ашыңыз
Dialogue: 0,0:47:33.93,0:47:36.10,Default,,0,0,0,,Бұл сізді құтқарған адам бар дегенді білдіреді.
Dialogue: 0,0:47:36.18,0:47:37.64,Default,,0,0,0,,Қазір! Ах...
Dialogue: 0,0:47:42.48,0:47:44.52,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:47:45.40,0:47:46.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:48.11,0:47:50.74,Default,,0,0,0,,Ух... ха...
Dialogue: 0,0:47:51.49,0:47:52.53,Default,,0,0,0,,Хикари
Dialogue: 0,0:47:52.91,0:47:53.62,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:48:01.87,0:48:02.96,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:48:03.13,0:48:04.63,Default,,0,0,0,,Мен үнемі таң қалдым.
Dialogue: 0,0:48:07.38,0:48:09.51,Default,,0,0,0,,Менің де жоғалып кеткім келеді...
Dialogue: 0,0:48:09.92,0:48:11.13,Default,,0,0,0,,Хикари-чан!
Dialogue: 0,0:48:13.14,0:48:15.51,Default,,0,0,0,,Неге бәрін көтеріп жүрсің!
Dialogue: 0,0:48:15.72,0:48:17.14,Default,,0,0,0,,Жалғыз өзіңізді қамауға алмаңыз!
Dialogue: 0,0:48:20.43,0:48:22.89,Default,,0,0,0,,Мен сені уайымдаймын.
Dialogue: 0,0:48:26.32,0:48:27.36,Default,,0,0,0,,Ха!
Dialogue: 0,0:48:29.03,0:48:30.99,Default,,0,0,0,,Жарайды, Тәкеру, мен көрген жоқпын.
Dialogue: 0,0:48:31.07,0:48:33.16,Default,,0,0,0,,Мен оны мүлдем көрмедім.
Dialogue: 0,0:48:33.28,0:48:36.16,Default,,0,0,0,,(терезе әйнегі діріл шуы)
Dialogue: 0,0:48:36.28,0:48:38.29,Default,,0,0,0,,Не? Қазір!
Dialogue: 0,0:48:48.34,0:48:49.34,Default,,0,0,0,,Тайлмон...
Dialogue: 0,0:48:50.01,0:48:51.47,Default,,0,0,0,,Менің де баруым керек...
Dialogue: 0,0:48:54.97,0:48:56.09,Default,,0,0,0,,Мэй-чан!
Dialogue: 0,0:49:02.43,0:49:03.44,Default,,0,0,0,,А...
Dialogue: 0,0:49:16.20,0:49:20.70,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:49:31.80,0:49:34.34,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:49:40.43,0:49:43.23,Default,,0,0,0,,Енді жарқырай берейік! (Қараңғы Тиранномонның шайқас айқайы)
Dialogue: 0,0:49:43.35,0:49:45.56,Default,,0,0,0,,Бәрін құртып, қайта туыл!
Dialogue: 0,0:49:45.64,0:49:46.98,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз.
Dialogue: 0,0:49:47.15,0:49:51.48,Default,,0,0,0,,Адамзаттың ақырына сәйкес келетін керемет жойылу жиынтығы!
Dialogue: 0,0:49:52.36,0:49:55.24,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,0:49:55.36,0:49:57.86,Default,,0,0,0,,Йггдрасил Банзай!
Dialogue: 0,0:50:10.21,0:50:12.80,Default,,0,0,0,,Мэй-чан... Тэйлмон...
Dialogue: 0,0:50:13.34,0:50:14.51,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:50:16.47,0:50:19.30,Default,,0,0,0,,Сізде есте қалған нәрсе бар ма?
Dialogue: 0,0:50:19.85,0:50:20.76,Default,,0,0,0,,Тайлмон!
Dialogue: 0,0:50:20.85,0:50:21.76,Default,,0,0,0,,Мейкомон!
Dialogue: 0,0:50:21.89,0:50:24.77,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:50:25.85,0:50:28.48,Default,,0,0,0,,Мен Мейкомонды немесе Тайлмонды ренжіткім келмейді.
Dialogue: 0,0:50:28.69,0:50:29.48,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:50:30.61,0:50:32.27,Default,,0,0,0,,Жаман нәрсе болса, оны тоқтату керек.
Dialogue: 0,0:50:34.44,0:50:35.28,Default,,0,0,0,,Габумон
Dialogue: 0,0:50:35.86,0:50:36.53,Default,,0,0,0,,Иә
Dialogue: 0,0:50:36.95,0:50:39.78,Default,,0,0,0,,Мен қазір дами алмаймын, сондықтан...
Dialogue: 0,0:50:40.28,0:50:41.03,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:50:41.37,0:50:43.29,Default,,0,0,0,,Уақыты келгенде мен дайынмын.
Dialogue: 0,0:50:44.12,0:50:47.29,Default,,0,0,0,,Біздің достарымыздың ғана қолынан келетін істер бар.
Dialogue: 0,0:50:47.58,0:50:48.33,Default,,0,0,0,,Иә
Dialogue: 0,0:50:50.83,0:50:51.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:50:54.63,0:50:56.55,Default,,0,0,0,,Ямато дұрыс ойлайды.
Dialogue: 0,0:50:57.51,0:50:59.55,Default,,0,0,0,,Мен Яматого сенемін
Dialogue: 0,0:51:04.77,0:51:07.02,Default,,0,0,0,,Тайлмон мен Мейкомон үшін
Dialogue: 0,0:51:07.10,0:51:08.73,Default,,0,0,0,,Күшімізді біріктірейік!
Dialogue: 0,0:51:13.73,0:51:16.07,Default,,0,0,0,,
Dialogue: 0,0:51:16.61,0:51:18.32,Default,,0,0,0,,Жоқ, сіз оны пайдалана алмайсыз.
Dialogue: 0,0:51:46.89,0:51:51.73,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:52:17.67,0:52:18.71,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:52:18.84,0:52:20.22,Default,,0,0,0,,Шабуыл жасауға қалай батылы барады?
Dialogue: 0,0:52:20.34,0:52:22.13,Default,,0,0,0,,Осылай жүре берсең, қуып кетесің!
Dialogue: 0,0:52:24.97,0:52:25.76,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:53:03.30,0:53:04.89,Default,,0,0,0,,Габумон, өтінемін!
Dialogue: 0,0:53:04.97,0:53:05.68,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:53:05.93,0:53:06.68,Default,,0,0,0,,Гомамон!
Dialogue: 0,0:53:06.76,0:53:07.43,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:53:07.80,0:53:08.68,Default,,0,0,0,,Пальмон!
Dialogue: 0,0:53:08.76,0:53:09.56,Default,,0,0,0,,Ой, ой… Бұл жарамайды. Шынымен де жарамайды.
Dialogue: 0,0:53:09.64,0:53:11.22,Default,,0,0,0,,Биомон өтінемін!
Dialogue: 0,0:53:11.31,0:53:12.18,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:53:24.99,0:53:27.57,Default,,0,0,0,,Габумон эволюциясы! Гомамон эволюциясы!
Dialogue: 0,0:53:46.76,0:53:47.72,Default,,0,0,0,,Гарурумон!
Dialogue: 0,0:53:47.80,0:53:49.01,Default,,0,0,0,,Бірдрамон!
Dialogue: 0,0:53:49.10,0:53:49.97,Default,,0,0,0,,Тогемон!
Dialogue: 0,0:53:50.06,0:53:51.68,Default,,0,0,0,,Иккакумон!
Dialogue: 0,0:54:02.23,0:54:05.20,Default,,0,0,0,,Гарурумонның супер эволюциясы!
Dialogue: 0,0:54:15.25,0:54:17.08,Default,,0,0,0,,Weregarurumon!
Dialogue: 0,0:55:02.50,0:55:05.09,Default,,0,0,0,,(Вергарурумонның қабығы)
Dialogue: 0,0:55:08.59,0:55:10.68,Default,,0,0,0,,(Хикаридің ауыр тыныс алуы)
Dialogue: 0,0:55:10.76,0:55:11.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:12.14,0:55:14.10,Default,,0,0,0,,(Зұлымдықтың айқайы)
Dialogue: 0,0:55:14.81,0:55:15.47,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:55:16.18,0:55:18.23,Default,,0,0,0,,Патамон кеттік! иә!
Dialogue: 0,0:55:30.95,0:55:33.32,Default,,0,0,0,,Патамон эволюциясы!
Dialogue: 0,0:55:53.22,0:55:54.18,Default,,0,0,0,,Анджемон!
Dialogue: 0,0:56:06.40,0:56:09.44,Default,,0,0,0,,Анжемонның супер эволюциясы!
Dialogue: 0,0:56:20.12,0:56:22.04,Default,,0,0,0,,Қасиетті Ангемон!
Dialogue: 0,0:56:32.76,0:56:34.55,Default,,0,0,0,,Дигимон барлық жерде...
Dialogue: 0,0:56:34.68,0:56:38.10,Default,,0,0,0,,Yggdrasil шынайы әлемді жою үшін...
Dialogue: 0,0:56:46.06,0:56:51.07,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,0:56:51.40,0:56:52.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:56:52.45,0:56:53.45,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:56:53.86,0:56:55.91,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:56:55.99,0:56:57.74,Default,,0,0,0,,Мынау
Dialogue: 0,0:56:57.83,0:57:00.33,Default,,0,0,0,,Жүрегім әлі жарылмағанына сене алар емеспін.
Dialogue: 0,0:57:00.45,0:57:03.33,Default,,0,0,0,,Жойқыншылық әкелетін зұлым құдай
Dialogue: 0,0:57:03.87,0:57:04.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:05.67,0:57:08.34,Default,,0,0,0,,Сізбен қайта кездескеніме қуаныштымын.
Dialogue: 0,0:57:08.42,0:57:12.47,Default,,0,0,0,,Ол гомеостаз туралы пайғамбарлықты жоққа шығарып, ағасын бұрышқа ...
Dialogue: 0,0:57:13.51,0:57:16.85,Default,,0,0,0,,Сіз маған шынайы әлемді жоюға мүмкіндік бердіңіз, солай ма?
Dialogue: 0,0:57:16.93,0:57:17.85,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:57:18.30,0:57:22.02,Default,,0,0,0,,Адамдар да осы дүние сияқты нәзік жаратылыс.
Dialogue: 0,0:57:22.52,0:57:26.86,Default,,0,0,0,,Мен тіпті эмоцияларымды басқара алмаймын. Кемелсіз адамдар тек кедергі.
Dialogue: 0,0:57:27.44,0:57:28.36,Default,,0,0,0,,Өшіру
Dialogue: 0,0:57:30.11,0:57:31.36,Default,,0,0,0,,Өшіру
Dialogue: 0,0:57:32.99,0:57:35.36,Default,,0,0,0,,Өшіру!
Dialogue: 0,0:57:51.50,0:57:52.63,Default,,0,0,0,,Қасиетті Ангемон!
Dialogue: 0,0:57:52.96,0:57:55.72,Default,,0,0,0,,А, бұл қызықсыз.
Dialogue: 0,0:57:56.01,0:57:59.05,Default,,0,0,0,,Біраз қиынырақ нәрсе бар емес пе?
Dialogue: 0,0:57:59.64,0:58:01.14,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:58:04.73,0:58:06.39,Default,,0,0,0,,(Девимонның ұрыс айқайы)
Dialogue: 0,0:59:00.20,0:59:01.37,Default,,0,0,0,,Мешин-сан?
Dialogue: 0,0:59:06.45,0:59:09.00,Default,,0,0,0,,(Мейкомонның айқайы)
Dialogue: 0,0:59:09.62,0:59:10.67,Default,,0,0,0,,Үлкен кеуделер…
Dialogue: 0,0:59:10.75,0:59:11.83,Default,,0,0,0,,Жарайды
Dialogue: 0,0:59:12.13,0:59:12.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:20.97,0:59:22.30,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:59:29.27,0:59:30.14,Default,,0,0,0,,Хикари
Dialogue: 0,0:59:36.32,0:59:36.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:59:37.65,0:59:38.65,Default,,0,0,0,,Тайлмон!
Dialogue: 0,0:59:39.82,0:59:41.20,Default,,0,0,0,,Мен қауіпсізмін
Dialogue: 0,0:59:41.57,0:59:42.78,Default,,0,0,0,,Барма!
Dialogue: 0,0:59:43.37,0:59:46.24,Default,,0,0,0,,Мейкомон басқаларға қарағанда көбірек зардап шегеді.
Dialogue: 0,0:59:46.54,0:59:46.91,Default,,0,0,0,,(Мейкомонның айқайы)
Dialogue: 0,0:59:46.91,0:59:48.50,Default,,0,0,0,,(Мейкомонның айқайы)
Dialogue: 0,0:59:46.91,0:59:48.50,Default,,0,0,0,,Өйткені ол бала мейірімді
Dialogue: 0,0:59:48.83,0:59:51.17,Default,,0,0,0,,Достарымызға Бізге
Dialogue: 0,0:59:52.08,0:59:53.50,Default,,0,0,0,,Көмек сұрау
Dialogue: 0,0:59:53.63,0:59:54.29,Default,,0,0,0,,(Мейкомонның айқайы)
Dialogue: 0,0:59:54.29,0:59:56.50,Default,,0,0,0,,(Мейкомонның айқайы)
Dialogue: 0,0:59:54.29,0:59:56.50,Default,,0,0,0,,Мен бұл қорқынышты нәрсенің біткенін қалаймын.
Dialogue: 0,0:59:57.13,0:59:59.26,Default,,0,0,0,,Хикариді өтінемін
Dialogue: 0,1:00:00.17,1:00:03.47,Default,,0,0,0,,Барлық жарық Мейкомонның ішінде...
Dialogue: 0,1:00:09.77,1:00:12.77,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,1:00:20.24,1:00:23.91,Default,,0,0,0,,«Барлық жарық Мейкомонның ішінде»
Dialogue: 0,1:00:24.41,1:00:25.45,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:00:25.58,1:00:28.79,Default,,0,0,0,,Мұны маған Тэйлмон үйретті.
Dialogue: 0,1:00:29.20,1:00:31.00,Default,,0,0,0,,Мен белгісіз жерде болдым
Dialogue: 0,1:00:32.17,1:00:34.25,Default,,0,0,0,,Деректер көп болатын жерде
Dialogue: 0,1:00:38.13,1:00:39.05,Default,,0,0,0,,Әрине
Dialogue: 0,1:00:39.51,1:00:42.51,Default,,0,0,0,,Хикари-санның жұмбақ қабілеті бар.
Dialogue: 0,1:00:43.09,1:00:45.22,Default,,0,0,0,,Бұл да бір пайғамбарлық сияқты...
Dialogue: 0,1:00:45.93,1:00:47.68,Default,,0,0,0,,«Барлық жарық»
Dialogue: 0,1:00:48.81,1:00:50.06,Default,,0,0,0,,Ах! Мүмкін...
Dialogue: 0,1:00:50.14,1:00:51.23,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:54.77,1:00:57.23,Default,,0,0,0,,Нақты әлемнің қайта жүктелуі басталды!
Dialogue: 0,1:00:57.57,1:00:59.23,Default,,0,0,0,,Ах... (Орнынан тұрған дыбыс)
Dialogue: 0,1:00:59.53,1:01:00.61,Default,,0,0,0,,Бізге асығу керек!
Dialogue: 0,1:01:16.88,1:01:18.00,Default,,0,0,0,,Жүр!
Dialogue: 0,1:01:24.18,1:01:26.51,Default,,0,0,0,,(Ординамонның ырылдауы)
Dialogue: 0,1:01:27.64,1:01:29.47,Default,,0,0,0,,(Ординемонның ырылдауы)
Dialogue: 0,1:01:30.01,1:01:32.02,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:01:42.90,1:01:44.07,Default,,0,0,0,,Аһ!
Dialogue: 0,1:01:44.57,1:01:45.78,Default,,0,0,0,,Иккакумон!
Dialogue: 0,1:02:55.98,1:03:00.86,Default,,0,0,0,,(Ординемонның айқайы)
Dialogue: 0,1:03:02.82,1:03:04.86,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:03:29.09,1:03:30.97,Default,,0,0,0,,Жоқ, егер осылай қала берсе...
Dialogue: 0,1:03:31.59,1:03:33.64,Default,,0,0,0,,Түпкілікті эволюция мүмкін емес!
Dialogue: 0,1:03:36.39,1:03:37.77,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,1:03:51.03,1:03:55.91,Default,,0,0,0,,(Ординемонның айқайы)
Dialogue: 0,1:04:20.43,1:04:21.10,Default,,0,0,0,,Не!
Dialogue: 0,1:04:43.83,1:04:47.63,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,1:04:47.71,1:04:49.71,Default,,0,0,0,,(Дигимонның айқайы)
Dialogue: 0,1:04:50.05,1:04:52.22,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:04:52.43,1:04:55.26,Default,,0,0,0,,Дигимонға араласпаңыз!
Dialogue: 0,1:04:55.93,1:04:56.80,Default,,0,0,0,,А...
Dialogue: 0,1:04:57.97,1:04:59.72,Default,,0,0,0,,Бұл өте қорқынышты...
Dialogue: 0,1:05:00.22,1:05:01.48,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:05:01.89,1:05:04.85,Default,,0,0,0,,Неліктен мен осыдан өтуім керек?
Dialogue: 0,1:05:07.06,1:05:07.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:05:08.77,1:05:12.74,Default,,0,0,0,,Сіз бұл әдіспен келісесіз бе?
Dialogue: 0,1:05:13.82,1:05:16.57,Default,,0,0,0,,Гомеостаз қайта жүктеле бастады
Dialogue: 0,1:05:17.87,1:05:21.62,Default,,0,0,0,,Сіздің қасіретіңіз жақында бітеді...
Dialogue: 0,1:05:21.70,1:05:22.58,Default,,0,0,0,,Шу!
Dialogue: 0,1:05:23.21,1:05:25.50,Default,,0,0,0,,Сізге ыңғайлы болу үшін бірдеңе айтпаңыз!
Dialogue: 0,1:05:26.38,1:05:28.50,Default,,0,0,0,,Гомеостаз мен Йггдрасилдің бұған еш қатысы жоқ!
Dialogue: 0,1:05:29.05,1:05:33.51,Default,,0,0,0,,Біз... әлемді өз жолымызбен құтқарамыз!
Dialogue: 0,1:05:36.34,1:05:41.85,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:05:42.10,1:05:42.77,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:05:54.24,1:05:56.99,Default,,0,0,0,,Мешин-сан, сен маған Digivice-ді бере аласың ба?
Dialogue: 0,1:05:57.07,1:05:58.28,Default,,0,0,0,,Иә
Dialogue: 0,1:05:59.37,1:06:01.29,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,1:06:01.70,1:06:04.29,Default,,0,0,0,,«Барлық жарық Мейкомонның ішінде»
Dialogue: 0,1:06:08.25,1:06:09.63,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:06:11.13,1:06:13.21,Default,,0,0,0,,Сандық әлем қайта жүктелгеннен кейін
Dialogue: 0,1:06:13.30,1:06:15.22,Default,,0,0,0,,Естеліктері қалған жалғыз Мейкомон болды.
Dialogue: 0,1:06:15.30,1:06:16.30,Default,,0,0,0,,Ол кептеліп қалды
Dialogue: 0,1:06:17.01,1:06:20.81,Default,,0,0,0,,Сақтық көшірме деректерін сақтауға болады ма?
Dialogue: 0,1:06:21.89,1:06:23.81,Default,,0,0,0,,Соңғы қайта жүктеу алдында
Dialogue: 0,1:06:24.39,1:06:25.48,Default,,0,0,0,,Мен Тентомонмын және т.б.
Dialogue: 0,1:06:25.56,1:06:27.69,Default,,0,0,0,,Деректердің сақтық көшірмесін жасауға тырысты
Dialogue: 0,1:06:27.94,1:06:28.81,Default,,0,0,0,,Бұл жағдайда...
Dialogue: 0,1:06:29.19,1:06:31.15,Default,,0,0,0,,Бұл шайқас кезінде түсінбеушіліктен болды ма?
Dialogue: 0,1:06:31.23,1:06:33.73,Default,,0,0,0,,Мейкомонның кейбір деректері араласып кеткен.
Dialogue: 0,1:06:34.03,1:06:35.44,Default,,0,0,0,,Оны талдау
Dialogue: 0,1:06:35.53,1:06:38.82,Default,,0,0,0,,Қандай да бір себептермен басқа Digimon деректері де сақталды.
Dialogue: 0,1:06:42.49,1:06:45.71,Default,,0,0,0,,Енді бізге қолжетімді желілерді толық пайдалану арқылы...
Dialogue: 0,1:06:45.96,1:06:47.83,Default,,0,0,0,,Meshin's Digivice арқылы
Dialogue: 0,1:06:47.96,1:06:49.83,Default,,0,0,0,,Мен Мейкомонның деректерін қайта растадым.
Dialogue: 0,1:06:52.46,1:06:53.55,Default,,0,0,0,,бүгін өте ұзақ күн болды, мен қатты шаршадым…
Dialogue: 0,1:06:53.92,1:06:55.38,Default,,0,0,0,,Кейбір мейкомондар
Dialogue: 0,1:06:55.46,1:06:58.93,Default,,0,0,0,,Барлық Digimon жады деректерінің үлкен көлемі сақталады.
Dialogue: 0,1:06:59.72,1:07:02.35,Default,,0,0,0,,Не? «Барлығы»...
Dialogue: 0,1:07:03.14,1:07:06.10,Default,,0,0,0,,Бұл Патамон мен басқалардың жады деректері қалады дегенді білдіре ме?
Dialogue: 0,1:07:07.14,1:07:08.60,Default,,0,0,0,,Қайта жүктеуге дейінгі деректер де бар ма?
Dialogue: 0,1:07:09.06,1:07:09.94,Default,,0,0,0,,Иә
Dialogue: 0,1:07:11.40,1:07:15.11,Default,,0,0,0,,Мен Мэй Чанды жақсы көремін
Dialogue: 0,1:07:16.69,1:07:17.78,Default,,0,0,0,,Агумон...
Dialogue: 0,1:07:18.99,1:07:21.45,Default,,0,0,0,,Meicoomon барлық Digimon деректерін жинайды.
Dialogue: 0,1:07:21.53,1:07:23.20,Default,,0,0,0,,Өйткені ол қамтылған
Dialogue: 0,1:07:23.28,1:07:25.12,Default,,0,0,0,,Оның сонша күші бар еді.
Dialogue: 0,1:07:25.75,1:07:27.12,Default,,0,0,0,,Ұлы Кочча
Dialogue: 0,1:07:27.20,1:07:29.08,Default,,0,0,0,,Олай болса мына деректерге қараңыз
Dialogue: 0,1:07:29.17,1:07:31.13,Default,,0,0,0,,Мен бір нәрсені байқадым.
Dialogue: 0,1:07:31.21,1:07:33.63,Default,,0,0,0,,Мұнда мөрленген кейбір арнайы деректер бар.
Dialogue: 0,1:07:34.25,1:07:35.96,Default,,0,0,0,,Бұл гипотеза.
Dialogue: 0,1:07:36.21,1:07:38.30,Default,,0,0,0,,Мейкомонды қорқыныш тудырды.
Dialogue: 0,1:07:38.38,1:07:39.63,Default,,0,0,0,,Бақылаусыз әрекет ете бастады
Dialogue: 0,1:07:40.26,1:07:42.47,Default,,0,0,0,,Бастапқыда бұл Мейкомонда болуы керек.
Dialogue: 0,1:07:42.55,1:07:46.06,Default,,0,0,0,,Мейірімділік, адалдық, Мешін-санмен естеліктер
Dialogue: 0,1:07:46.22,1:07:49.06,Default,,0,0,0,,Сол жылы естеліктерді жабу арқылы
Dialogue: 0,1:07:49.14,1:07:51.65,Default,,0,0,0,,Жаман жағын арттырмады ма?
Dialogue: 0,1:07:52.35,1:07:54.90,Default,,0,0,0,,Басқаша айтқанда, бұл мөрленген жад деректері
Dialogue: 0,1:07:54.98,1:07:56.44,Default,,0,0,0,,Егер сіз оны аша аласыз
Dialogue: 0,1:07:56.53,1:07:58.11,Default,,0,0,0,,бұрынғыдай Мейкомон
Dialogue: 0,1:07:58.19,1:08:00.91,Default,,0,0,0,,Тұрақты жағдайды қалпына келтіру мүмкін болуы мүмкін
Dialogue: 0,1:08:00.99,1:08:01.66,Default,,0,0,0,,Ха!
Dialogue: 0,1:08:02.07,1:08:05.66,Default,,0,0,0,,Егер ол тұрақтанса, Ordinemon да жабайы жұмысын тоқтатуы мүмкін.
Dialogue: 0,1:08:06.12,1:08:09.08,Default,,0,0,0,,Бұл не соққы, не сәтсіздік, бірақ байқап көруге тұрарлық.
Dialogue: 0,1:08:09.41,1:08:10.66,Default,,0,0,0,,Менің басқа амалым жоқ.
Dialogue: 0,1:08:11.08,1:08:12.88,Default,,0,0,0,,Бірақ мен не істеуім керек?
Dialogue: 0,1:08:13.08,1:08:15.67,Default,,0,0,0,,Сақталған деректер құлыпталған.
Dialogue: 0,1:08:16.80,1:08:18.59,Default,,0,0,0,,Құпия сөз қажет
Dialogue: 0,1:08:19.38,1:08:21.13,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,1:08:21.51,1:08:23.43,Default,,0,0,0,,Мейкомон таңдауы мүмкін сөздер
Dialogue: 0,1:08:23.84,1:08:24.76,Default,,0,0,0,,Мэй-чан...
Dialogue: 0,1:08:24.85,1:08:27.85,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,1:08:46.74,1:08:48.41,Default,,0,0,0,,Кейбір түйінді сөз
Dialogue: 0,1:08:48.70,1:08:50.66,Default,,0,0,0,,ерекше есте қалады
Dialogue: 0,1:08:50.75,1:08:51.71,Default,,0,0,0,,Ал...
Dialogue: 0,1:08:52.16,1:08:53.71,Default,,0,0,0,,«Мешін» атауы туралы не айтасыз?
Dialogue: 0,1:08:53.92,1:08:55.96,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,1:08:56.04,1:08:56.71,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,1:08:57.34,1:08:59.05,Default,,0,0,0,,«Мочизуки Мешин» (қате дыбысы)
Dialogue: 0,1:08:59.13,1:09:00.51,Default,,0,0,0,,«Мэй-чан» (қате дыбысы)
Dialogue: 0,1:09:00.59,1:09:02.13,Default,,0,0,0,,«Мамыр» (қате дыбысы)
Dialogue: 0,1:09:02.22,1:09:04.47,Default,,0,0,0,,Мен оны бір рет көрдім, бірақ ол жұмыс істемейтін сияқты.
Dialogue: 0,1:09:04.55,1:09:05.72,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:08.89,1:09:10.22,Default,,0,0,0,,Басқа сөздер!
Dialogue: 0,1:09:12.64,1:09:15.02,Default,,0,0,0,,Мешин-чан, есте сақтауға тырыс
Dialogue: 0,1:09:15.19,1:09:18.15,Default,,0,0,0,,Мейкомонға жиі айтылатын сөздер.
Dialogue: 0,1:09:18.23,1:09:19.73,Default,,0,0,0,,Алғашқы айтылған сөздер
Dialogue: 0,1:09:20.99,1:09:21.99,Default,,0,0,0,,Хмм...
Dialogue: 0,1:09:37.17,1:09:38.04,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:42.42,1:09:44.51,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,1:09:57.98,1:10:00.07,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:10:06.95,1:10:08.03,Default,,0,0,0,,Оған не салдыңыз?
Dialogue: 0,1:10:08.45,1:10:11.99,Default,,0,0,0,,Бұл менің Мэйге мағынасын үйреткен бірінші сөз.
Dialogue: 0,1:10:12.16,1:10:13.83,Default,,0,0,0,,Менімен бірге болғаныңыз үшін
Dialogue: 0,1:10:14.29,1:10:16.54,Default,,0,0,0,,Менімен серіктес болғаныңыз үшін рахмет...
Dialogue: 0,1:10:20.71,1:10:24.13,Default,,0,0,0,,Мэй Чан, маған барлығы тегін көмектесті.
Dialogue: 0,1:10:24.47,1:10:26.01,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:10:27.84,1:10:28.68,Default,,0,0,0,,Біртіндеп
Dialogue: 0,1:10:29.14,1:10:30.05,Default,,0,0,0,,Біртіндеп
Dialogue: 0,1:10:30.51,1:10:32.06,Default,,0,0,0,,Не? Не?
Dialogue: 0,1:10:32.43,1:10:33.39,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:34.43,1:10:37.52,Default,,0,0,0,,«рахмет» дегенді білдіреді
Dialogue: 0,1:10:44.61,1:10:48.36,Default,,0,0,0,,Барлық жад деректері қалпына келтіріле бастады!
Dialogue: 0,1:11:42.42,1:11:44.38,Default,,0,0,0,,Менің есімде, Тайчи.
Dialogue: 0,1:11:45.38,1:11:48.72,Default,,0,0,0,,Біз тағы да кездестік
Dialogue: 0,1:11:49.47,1:11:50.51,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:11:52.26,1:11:53.35,Default,,0,0,0,,Сонда да...
Dialogue: 0,1:11:54.68,1:11:56.89,Default,,0,0,0,,Мен Яматомен қоштасуым керек.
Dialogue: 0,1:11:57.64,1:12:00.19,Default,,0,0,0,,Бұл өте ауыр болды...
Dialogue: 0,1:12:01.35,1:12:04.73,Default,,0,0,0,,Джомен бірге болу
Dialogue: 0,1:12:04.82,1:12:06.82,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,1:12:10.95,1:12:12.41,Default,,0,0,0,,Тіпті жұқтырған кезде де...
Dialogue: 0,1:12:13.16,1:12:16.20,Default,,0,0,0,,Тәкеру әрқашан мейірімді болды.
Dialogue: 0,1:12:17.29,1:12:20.83,Default,,0,0,0,,Мен үшін үнемі алаңдап жүргеніңіз үшін рахмет.
Dialogue: 0,1:12:21.00,1:12:22.67,Default,,0,0,0,,Мен көремін...
Dialogue: 0,1:12:23.42,1:12:25.42,Default,,0,0,0,,Аспанды ұмыттың.
Dialogue: 0,1:12:26.42,1:12:28.09,Default,,0,0,0,,Кешіріңіз Аспан
Dialogue: 0,1:12:28.76,1:12:30.72,Default,,0,0,0,,Сіз қаншалықты уайымдадыңыз?
Dialogue: 0,1:12:33.47,1:12:36.64,Default,,0,0,0,,Уэйт пен Коушироу Сейана
Dialogue: 0,1:12:36.85,1:12:39.31,Default,,0,0,0,,Ауырған сезімді жеңу
Dialogue: 0,1:12:39.60,1:12:42.02,Default,,0,0,0,,Қазір бар
Dialogue: 0,1:12:43.10,1:12:44.94,Default,,0,0,0,,Менің есімде, Мими!
Dialogue: 0,1:12:45.61,1:12:48.36,Default,,0,0,0,,Барлығы, барлығы, маңызды естеліктер
Dialogue: 0,1:12:48.82,1:12:52.78,Default,,0,0,0,,Біздің ең жақсы серіктестер екендігіміз
Dialogue: 0,1:13:15.80,1:13:16.47,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:18.22,1:13:20.97,Default,,0,0,0,,Хикари! Күте тұрыңыз!
Dialogue: 0,1:13:21.35,1:13:22.23,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,1:13:23.27,1:13:25.40,Default,,0,0,0,,Осы жерден!
Dialogue: 0,1:13:26.19,1:13:29.15,Default,,0,0,0,,Ух... мм!
Dialogue: 0,1:13:29.23,1:13:30.23,Default,,0,0,0,,Хикари!
Dialogue: 0,1:13:30.36,1:13:32.32,Default,,0,0,0,,Ха! Тайлмон?
Dialogue: 0,1:13:39.79,1:13:42.50,Default,,0,0,0,,Жерде не...?
Dialogue: 0,1:14:25.91,1:14:28.29,Default,,0,0,0,,Адамдармен байланыс туралы естеліктер...
Dialogue: 0,1:14:28.92,1:14:31.38,Default,,0,0,0,,Сіз жаңа күштерді ояттыңыз ба?
Dialogue: 0,1:14:42.01,1:14:43.39,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:14:43.47,1:14:45.81,Default,,0,0,0,,Жадыңызды қалпына келтіресіз бе?
Dialogue: 0,1:14:45.89,1:14:49.61,Default,,0,0,0,,Қайта жүктеуге дейінгі естеліктер қайтарылды ма? Дигимонға
Dialogue: 0,1:14:52.82,1:14:56.11,Default,,0,0,0,,Ординамонда да айқын өзгерістер бар.
Dialogue: 0,1:14:57.74,1:15:00.07,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,1:15:00.16,1:15:04.08,Default,,0,0,0,,Жабылып қалған естеліктер бірінен соң бірі қалпына келтірілуде!
Dialogue: 0,1:15:05.25,1:15:06.25,Default,,0,0,0,,Ординемон...
Dialogue: 0,1:15:07.58,1:15:10.33,Default,,0,0,0,,Жоқ, Мейкомон және Тайлмон да.
Dialogue: 0,1:15:13.17,1:15:16.34,Default,,0,0,0,,Бұл таңдаған балалардың күші ме?
Dialogue: 0,1:15:17.13,1:15:18.72,Default,,0,0,0,,Шынымен де керемет...
Dialogue: 0,1:15:19.01,1:15:20.84,Default,,0,0,0,,Қайта жүктеуді тоқтатыңыз!
Dialogue: 0,1:15:21.60,1:15:23.89,Default,,0,0,0,,Сақталған деректерді қалпына келтіру аяқталғанша
Dialogue: 0,1:15:24.18,1:15:28.39,Default,,0,0,0,,Аз ғана уақыт қажет, қайта жүктеудің қажеті жоқ!
Dialogue: 0,1:15:53.79,1:15:54.71,Default,,0,0,0,,Хикари!
Dialogue: 0,1:15:55.13,1:15:56.13,Default,,0,0,0,,Тайлмон?
Dialogue: 0,1:15:59.55,1:16:00.59,Default,,0,0,0,,Мен All Might бізге осы туралы айтып береді деп үміттенемін.
Dialogue: 0,1:16:00.80,1:16:04.93,Default,,0,0,0,,Ординемон тұрақтылық пен үйлесімділікті қалпына келтіруге тырысады.
Dialogue: 0,1:16:16.44,1:16:22.32,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:16:23.95,1:16:24.99,Default,,0,0,0,,Соңғысы, бәрібір тағы бір сапар шегу ғана қолымнан келеді
Dialogue: 0,1:16:38.92,1:16:44.34,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:16:44.89,1:16:45.85,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:16:46.39,1:16:47.64,Default,,0,0,0,,Барма!
Dialogue: 0,1:17:06.83,1:17:07.99,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,1:17:28.31,1:17:29.35,Default,,0,0,0,,Тайлмон!
Dialogue: 0,1:17:34.65,1:17:37.11,Default,,0,0,0,,Тайлмон! Тайлмон!
Dialogue: 0,1:17:51.37,1:17:52.62,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:17:53.08,1:17:54.21,Default,,0,0,0,,Хикари…
Dialogue: 0,1:17:54.96,1:17:56.21,Default,,0,0,0,,Рахмет
Dialogue: 0,1:17:57.75,1:17:58.42,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:03.80,1:18:05.63,Default,,0,0,0,,Қайта жүктеуді болдырмау
Dialogue: 0,1:18:05.72,1:18:06.84,Default,,0,0,0,,Бұл керемет емес пе!
Dialogue: 0,1:18:06.93,1:18:08.80,Default,,0,0,0,,Жақсы, шынымен...
Dialogue: 0,1:18:08.89,1:18:10.68,Default,,0,0,0,,Хакмонға рахмет.
Dialogue: 0,1:18:10.76,1:18:11.56,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:18:12.72,1:18:13.77,Default,,0,0,0,,(Су шашыраған дыбысы)
Dialogue: 0,1:18:16.14,1:18:17.19,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:18:17.98,1:18:20.90,Default,,0,0,0,,Бұл әлі мен білетін Мэй Чан...
Dialogue: 0,1:18:21.69,1:18:23.65,Default,,0,0,0,,Неге олайсың!
Dialogue: 0,1:18:24.15,1:18:25.24,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,1:18:25.32,1:18:26.86,Default,,0,0,0,,Эволюция емес...
Dialogue: 0,1:18:27.45,1:18:30.45,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,1:18:34.33,1:18:35.62,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:18:35.71,1:18:37.29,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:45.84,1:18:47.09,Default,,0,0,0,,Сіз оны сіңіресіз бе?
Dialogue: 0,1:18:47.18,1:18:49.80,Default,,0,0,0,,Деректердегі олқылықты пайдаландым!
Dialogue: 0,1:18:50.35,1:18:51.60,Default,,0,0,0,,Yggdrasil!
Dialogue: 0,1:18:51.68,1:18:54.52,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,1:18:54.60,1:18:58.31,Default,,0,0,0,,Орындалды! Йггдрасилдің жұмағы!
Dialogue: 0,1:19:11.62,1:19:13.87,Default,,0,0,0,,Мэй Чан не істеді?
Dialogue: 0,1:19:17.21,1:19:19.08,Default,,0,0,0,,Мені бұдан былай қинамаңыз!
Dialogue: 0,1:19:33.72,1:19:36.98,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:19:38.14,1:19:39.02,Default,,0,0,0,,Идиот!
Dialogue: 0,1:19:47.99,1:19:48.95,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:24.06,1:20:25.40,Default,,0,0,0,,Тайчи!
Dialogue: 0,1:20:26.15,1:20:28.78,Default,,0,0,0,,Қайтадан қош келдіңіз! Тайчи!
Dialogue: 0,1:20:30.32,1:20:31.07,Default,,0,0,0,,Тайчи…
Dialogue: 0,1:20:31.15,1:20:31.91,Default,,0,0,0,,Тайчи-сан!
Dialogue: 0,1:20:57.81,1:20:58.68,Default,,0,0,0,,Кеш!
Dialogue: 0,1:21:02.64,1:21:03.69,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,1:21:04.27,1:21:05.31,Default,,0,0,0,,Тыныштық
Dialogue: 0,1:21:11.49,1:21:12.45,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:21:27.17,1:21:30.92,Default,,0,0,0,,Агумон эволюциясы!
Dialogue: 0,1:21:48.52,1:21:50.03,Default,,0,0,0,,Греймон!
Dialogue: 0,1:22:02.75,1:22:05.42,Default,,0,0,0,,Греймонның супер эволюциясы!
Dialogue: 0,1:22:16.34,1:22:18.43,Default,,0,0,0,,Металл Греймон!
Dialogue: 0,1:22:20.64,1:22:23.98,Default,,0,0,0,,Металл Греймонның соңғы эволюциясы!
Dialogue: 0,1:22:36.99,1:22:40.03,Default,,0,0,0,,Соғыс Греймон!
Dialogue: 0,1:22:43.16,1:22:44.83,Default,,0,0,0,,(Металл Гарурумонның жауынгерлік айқайы)
Dialogue: 0,1:23:05.06,1:23:06.64,Default,,0,0,0,,(Ординемонның айқайы)
Dialogue: 0,1:23:06.73,1:23:08.35,Default,,0,0,0,,Тоқта, ағайын!
Dialogue: 0,1:23:08.90,1:23:09.85,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,1:23:10.27,1:23:11.40,Default,,0,0,0,,Хикари-чан...
Dialogue: 0,1:23:12.36,1:23:13.57,Default,,0,0,0,,Мені өлтірме!
Dialogue: 0,1:23:14.65,1:23:17.11,Default,,0,0,0,,Әр адамның жүрегінде жарық пен қараңғылық бар!
Dialogue: 0,1:23:21.20,1:23:24.62,Default,,0,0,0,,Бірақ мен жарыққа сенгім келеді
Dialogue: 0,1:23:25.25,1:23:27.91,Default,,0,0,0,,Мейкомонға көмектесу жолын іздеймін!
Dialogue: 0,1:23:28.21,1:23:29.25,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,1:23:35.51,1:23:37.17,Default,,0,0,0,,Сіз қандай болсаңыз, солай қаласыз.
Dialogue: 0,1:23:37.38,1:23:38.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:39.97,1:23:41.39,Default,,0,0,0,,Мені жек көр
Dialogue: 0,1:23:41.93,1:23:42.68,Default,,0,0,0,,Ха!
Dialogue: 0,1:23:53.48,1:23:55.98,Default,,0,0,0,,Біз енді таңдалған балалар емеспіз.
Dialogue: 0,1:23:56.11,1:23:56.90,Default,,0,0,0,,Таңдаудан басқа амалыңыз жоқ
Dialogue: 0,1:23:57.99,1:24:01.74,Default,,0,0,0,,Қанша қиын болса да, болашағымызды қорғай аламыз
Dialogue: 0,1:24:05.41,1:24:06.29,Default,,0,0,0,,Мен...
Dialogue: 0,1:24:07.45,1:24:11.12,Default,,0,0,0,,Ағаңды кешірмейтініңе сенімдімін.
Dialogue: 0,1:24:14.75,1:24:16.42,Default,,0,0,0,,Бірақ сол себепті...
Dialogue: 0,1:24:17.30,1:24:18.92,Default,,0,0,0,,Мен де бірге күресемін!
Dialogue: 0,1:24:21.38,1:24:23.60,Default,,0,0,0,,Хикари, мен де
Dialogue: 0,1:24:23.68,1:24:24.35,Default,,0,0,0,,Иә
Dialogue: 0,1:24:33.81,1:24:36.57,Default,,0,0,0,,Tailmon супер эволюциясы!
Dialogue: 0,1:24:48.54,1:24:49.95,Default,,0,0,0,,Анджюмон!
Dialogue: 0,1:24:52.25,1:24:55.04,Default,,0,0,0,,Angewomon соңғы эволюциясы!
Dialogue: 0,1:25:11.39,1:25:12.94,Default,,0,0,0,,Холидрамон!
Dialogue: 0,1:25:41.17,1:25:42.63,Default,,0,0,0,,Қасиетті алау!
Dialogue: 0,1:25:49.26,1:25:51.93,Default,,0,0,0,,(Ординемонның айқайы)
Dialogue: 0,1:26:01.69,1:26:02.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:12.08,1:26:12.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:25.36,1:27:29.28,Default,,0,0,0,,(Ординемонның айқайы)
Dialogue: 0,1:27:36.37,1:27:41.29,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:28:08.36,1:28:13.57,Default,,0,0,0,,(Ординемонның айқайы)
Dialogue: 0,1:28:22.54,1:28:23.71,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,1:28:27.38,1:28:28.97,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,1:28:39.93,1:28:40.60,Default,,0,0,0,,мамыр…
Dialogue: 0,1:28:41.39,1:28:42.81,Default,,0,0,0,,Е? Ах… Ау!
Dialogue: 0,1:28:46.19,1:28:47.28,Default,,0,0,0,,мамыр!
Dialogue: 0,1:28:48.03,1:28:49.03,Default,,0,0,0,,Мэй-чан!
Dialogue: 0,1:28:57.04,1:28:58.29,Default,,0,0,0,,Біртіндеп
Dialogue: 0,1:29:01.50,1:29:02.17,Default,,0,0,0,,Уф...
Dialogue: 0,1:29:06.38,1:29:07.38,Default,,0,0,0,,Хехе
Dialogue: 0,1:29:09.26,1:29:10.59,Default,,0,0,0,,Аха хехехе...
Dialogue: 0,1:29:11.51,1:29:12.47,Default,,0,0,0,,Аа…
Dialogue: 0,1:30:03.60,1:30:04.85,Default,,0,0,0,,Біртіндеп...
Dialogue: 0,1:30:15.86,1:30:20.87,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,1:30:25.92,1:30:26.96,Default,,0,0,0,,Ммм
Dialogue: 0,1:30:27.54,1:30:30.21,Default,,0,0,0,,Әр адамның ішінде бір бала жасырынған.
Dialogue: 0,1:30:30.67,1:30:33.05,Default,,0,0,0,,Бұл бала ойнағысы келеді.
Dialogue: 0,1:30:39.80,1:30:41.81,Default,,0,0,0,,Келесі жындар болады ма?
Dialogue: 0,1:30:42.35,1:30:44.06,Default,,0,0,0,,Диаборомон?
Dialogue: 0,1:31:04.58,1:31:06.54,Default,,0,0,0,,Менің қарным ашты...
Dialogue: 0,1:31:21.85,1:31:26.56,Default,,0,0,0,,Мешиннің Тотториге оралғанына үш ай болды.
Dialogue: 0,1:31:27.64,1:31:32.69,Default,,0,0,0,,Сол күні қираған қала біртіндеп қалпына келе бастады.
Dialogue: 0,1:31:34.15,1:31:36.36,Default,,0,0,0,,Дайсуке мен оның ауруханаға түскен достары қазір жақсы.
Dialogue: 0,1:31:37.03,1:31:39.91,Default,,0,0,0,,Цифрлық әлемде гомеостаз - Yggdrasil.
Dialogue: 0,1:31:39.99,1:31:41.82,Default,,0,0,0,,Мәжбүрлеп өшіру болған сияқты.
Dialogue: 0,1:31:43.37,1:31:45.87,Default,,0,0,0,,Патамон мен оның достары Сандық әлемге оралды.
Dialogue: 0,1:31:46.91,1:31:50.79,Default,,0,0,0,,Қоғамның Дигимонға деген сыны әлі де күшті.
Dialogue: 0,1:31:51.25,1:31:53.59,Default,,0,0,0,,Коушироның «бұрмалау» туралы зерттеулері негізінде
Dialogue: 0,1:31:53.67,1:31:57.13,Default,,0,0,0,,Freely move between two worlds without D-3
Dialogue: 0,1:31:57.22,1:31:59.01,Default,,0,0,0,,Since we started developing the gate
Dialogue: 0,1:32:02.14,1:32:05.14,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,1:32:16.57,1:32:17.90,Default,,0,0,0,,Taichi goes to cram school?
Dialogue: 0,1:32:18.40,1:32:19.11,Default,,0,0,0,,Иә
Dialogue: 0,1:32:19.82,1:32:21.32,Default,,0,0,0,,Hikari-chan said that
Dialogue: 0,1:32:21.70,1:32:22.91,Default,,0,0,0,,Ол өзінің мансап жолын өзгерткенін айтты.
Dialogue: 0,1:32:23.20,1:32:24.20,Default,,0,0,0,,Иә
Dialogue: 0,1:32:24.28,1:32:28.12,Default,,0,0,0,,Нишижима мырзаның маған айтқанын ұмыта алмайтын сияқтымын.
Dialogue: 0,1:32:29.08,1:32:31.92,Default,,0,0,0,,“You guys create the future”
Dialogue: 0,1:32:32.08,1:32:33.88,Default,,0,0,0,,Бұл үлкен үй тапсырмасы.
Dialogue: 0,1:32:37.96,1:32:40.42,Default,,0,0,0,,Creating the future...?
Dialogue: 0,1:32:43.55,1:32:46.93,Default,,0,0,0,,If so, should I aim for space?
Dialogue: 0,1:32:47.39,1:32:49.60,Default,,0,0,0,,Sora-san, did you cut your hair?
Dialogue: 0,1:32:49.85,1:32:51.35,Default,,0,0,0,,Не? Иә
Dialogue: 0,1:32:51.44,1:32:53.19,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,1:32:53.27,1:32:55.40,Default,,0,0,0,,Жоқ, аға.
Dialogue: 0,1:32:56.48,1:32:57.98,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:32:58.48,1:32:59.57,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,1:33:04.66,1:33:06.91,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,1:33:13.50,1:33:14.50,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,1:33:14.75,1:33:15.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:16.34,1:33:17.46,Default,,0,0,0,,Ягами-кун?
Dialogue: 0,1:33:18.09,1:33:18.75,Default,,0,0,0,,О
Dialogue: 0,1:33:23.18,1:33:24.43,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,1:33:24.89,1:33:25.55,Default,,0,0,0,,Иә
Dialogue: 0,1:33:26.22,1:33:27.14,Default,,0,0,0,,Қалайсың?
Dialogue: 0,1:33:27.22,1:33:30.98,Default,,0,0,0,,Ах... Сіздің пакетіңіз келді ме?
Dialogue: 0,1:33:31.73,1:33:32.98,Default,,0,0,0,,Иә
Dialogue: 0,1:33:33.44,1:33:35.02,Default,,0,0,0,,Бүгін келді.
Dialogue: 0,1:33:35.48,1:33:37.69,Default,,0,0,0,,Барлығынан Рождестволық сыйлықтар
Dialogue: 0,1:33:37.77,1:33:38.98,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,1:33:40.19,1:33:41.28,Default,,0,0,0,,Біртіндеп
Dialogue: 0,1:33:42.53,1:33:43.57,Default,,0,0,0,,Ум...
Dialogue: 0,1:33:50.83,1:33:51.50,Default,,0,0,0,,Е...
Dialogue: 0,1:33:54.21,1:33:55.21,Default,,0,0,0,,Фу…
Dialogue: 0,1:33:57.50,1:33:59.63,Default,,0,0,0,,Many things happened, but
Dialogue: 0,1:34:03.22,1:34:04.55,Default,,0,0,0,,Э? Мен сені естімеймін!
Dialogue: 0,1:34:09.64,1:34:12.60,Default,,0,0,0,,Ах... мм...
Dialogue: 0,1:34:13.93,1:34:16.98,Default,,0,0,0,,We'll always be friends!
Dialogue: 0,1:34:17.15,1:34:17.98,Default,,0,0,0,,Хэхе…
Dialogue: 0,1:34:18.15,1:34:23.15,Default,,0,0,0,,♪~
Dialogue: 0,1:34:34.21,1:34:35.71,Default,,0,0,0,,Хехе...
Dialogue: 0,1:34:39.88,1:34:43.05,Default,,0,0,0,,(Digimon's excited voices)
Dialogue: 0,1:38:24.81,1:38:29.82,Default,,0,0,0,,~♪
Dialogue: 0,1:38:34.49,1:38:37.99,Default,,0,0,0,,(Сандық шарлардың пайда болуының дыбысы)
