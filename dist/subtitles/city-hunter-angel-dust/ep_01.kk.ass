Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:58.89,0:01:01.22,Default,,0,0,0,,Кайто Сентай мысықтың көзі!
Dialogue: 0,0:01:02.64,0:01:04.93,Default,,0,0,0,,...Қандай көрініс!
Dialogue: 0,0:01:05.02,0:01:08.27,Default,,0,0,0,,О... Мені Райо жолдас етіп жүр...
Dialogue: 0,0:01:08.35,0:01:12.69,Default,,0,0,0,,Мен де Cat's Eye мүшесі бола аламын деп ойладым!
Dialogue: 0,0:01:12.78,0:01:13.94,Default,,0,0,0,,(шаш қию дыбысы)
Dialogue: 0,0:01:14.03,0:01:15.99,Default,,0,0,0,,Бұл... қорқынышты...
Dialogue: 0,0:01:17.32,0:01:20.87,Default,,0,0,0,,Алдын ала мәлімет бойынша нысана сол пентхауста.
Dialogue: 0,0:01:20.95,0:01:22.66,Default,,0,0,0,,Бүгін таңға дейін
Dialogue: 0,0:01:22.74,0:01:25.62,Default,,0,0,0,,Бүгін мені жертөледегі баспана бөлмесіне ауыстырды.
Dialogue: 0,0:01:25.71,0:01:27.54,Default,,0,0,0,,Барған сайын күдікті болып барады.
Dialogue: 0,0:01:28.00,0:01:29.92,Default,,0,0,0,,Сонымен, бұл С жоспары.
Dialogue: 0,0:01:30.00,0:01:30.84,Default,,0,0,0,,Айо
Dialogue: 0,0:01:32.00,0:01:33.05,Default,,0,0,0,,Иә
Dialogue: 0,0:01:50.27,0:01:51.48,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:56.32,0:01:57.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:57.24,0:01:58.82,Default,,0,0,0,,Эй, қарашы.
Dialogue: 0,0:01:59.41,0:02:01.32,Default,,0,0,0,,Не? Бұл жігіттер
Dialogue: 0,0:02:03.87,0:02:05.45,Default,,0,0,0,,Мас болып қалдың ба?
Dialogue: 0,0:02:05.54,0:02:08.29,Default,,0,0,0,,Бұлшықеттік мачо бұзық
Dialogue: 0,0:02:08.37,0:02:10.21,Default,,0,0,0,,- (С күзетшісі) Мені ұстаңыз! -(Күзетшілер) Хмм...
Dialogue: 0,0:02:12.34,0:02:13.88,Default,,0,0,0,,(Дабыл сигналы)
Dialogue: 0,0:02:21.18,0:02:23.18,Default,,0,0,0,,Махаббат өтінемін
Dialogue: 0,0:02:23.26,0:02:24.51,Default,,0,0,0,,Жарайды, мен осындамын.
Dialogue: 0,0:02:29.39,0:02:32.06,Default,,0,0,0,,Iccho up
Dialogue: 0,0:02:35.98,0:02:37.36,Default,,0,0,0,,Міне болды! Ол төбеде!
Dialogue: 0,0:02:37.44,0:02:38.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:46.91,0:02:48.58,Default,,0,0,0,,Сіз құрдассыз ба?
Dialogue: 0,0:02:48.66,0:02:49.87,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:02:50.92,0:02:53.59,Default,,0,0,0,,Бұл құрылғы әдеттен тыс.
Dialogue: 0,0:02:53.67,0:02:56.71,Default,,0,0,0,,Балалар, сендердің киінулерің ерекше!
Dialogue: 0,0:02:56.80,0:02:58.26,Default,,0,0,0,,Балалар сендер кімсіңдер! ?
Dialogue: 0,0:02:58.97,0:03:00.13,Default,,0,0,0,,Біреуге қоңырау шалыңыз...
Dialogue: 0,0:03:00.97,0:03:02.43,Default,,0,0,0,,Қалалық аңшы
Dialogue: 0,0:03:02.51,0:03:04.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:04.26,0:03:05.31,Default,,0,0,0,,Оны мұнда әкелме!
Dialogue: 0,0:03:05.89,0:03:07.43,Default,,0,0,0,,Аа... Ах!
Dialogue: 0,0:03:07.52,0:03:08.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:08.43,0:03:09.27,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:09.81,0:03:11.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:11.77,0:03:12.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:13.69,0:03:14.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:16.90,0:03:18.78,Default,,0,0,0,,Ол жай ғана бұзық емес!
Dialogue: 0,0:03:31.92,0:03:32.96,Default,,0,0,0,,Бинго!
Dialogue: 0,0:03:42.55,0:03:43.59,Default,,0,0,0,,болды
Dialogue: 0,0:03:43.68,0:03:44.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:45.05,0:03:46.10,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:03:47.22,0:03:48.26,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:48.85,0:03:50.52,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:03:50.60,0:03:53.73,Default,,0,0,0,,Сурет жалықтырғыш, кадр нашар
Dialogue: 0,0:04:16.33,0:04:17.71,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:17.79,0:04:19.05,Default,,0,0,0,,- (Хитоми) Ах! -(Көз жас/махаббат) Ах!
Dialogue: 0,0:04:19.13,0:04:19.96,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:20.05,0:04:21.63,Default,,0,0,0,,(Сурет жақтауының сынған дыбысы)
Dialogue: 0,0:04:32.10,0:04:34.10,Default,,0,0,0,,Ей, мен саған оны қайтарып берейін!
Dialogue: 0,0:04:40.27,0:04:41.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:41.99,0:04:43.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:45.74,0:04:48.99,Default,,0,0,0,,Colt Python Бұл жақсы мылтық емес пе?
Dialogue: 0,0:04:49.78,0:04:51.12,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:52.16,0:04:54.21,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:54.29,0:04:55.67,Default,,0,0,0,,...
Dialogue: 0,0:04:57.96,0:04:58.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:58.88,0:05:00.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:00.75,0:05:02.71,Default,,0,0,0,,Маған бетіңізді көрсетсеңіз қалай болады?
Dialogue: 0,0:05:03.67,0:05:04.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:05.26,0:05:06.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:06.38,0:05:07.22,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:07.30,0:05:08.22,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:08.30,0:05:09.30,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:05:14.14,0:05:15.18,Default,,0,0,0,,(сымның ату дыбысы)
Dialogue: 0,0:05:29.53,0:05:33.24,Default,,0,0,0,,♪~
Dialogue: 0,0:06:51.95,0:06:57.95,Default,,0,0,0,,~♪
Dialogue: 0,0:07:04.92,0:07:06.84,Default,,0,0,0,,Sunrise авиакомпаниясынан...
Dialogue: 0,0:07:06.92,0:07:09.13,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:07:10.68,0:07:11.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:12.64,0:07:13.97,Default,,0,0,0,,- (Эспада) Нихи... - (Бала) Сәлем!
Dialogue: 0,0:07:14.97,0:07:16.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:17.47,0:07:19.31,Default,,0,0,0,,Борттағы жолаушылар —
Dialogue: 0,0:07:19.39,0:07:22.52,Default,,0,0,0,,Жіберу кассасына келіңіз.
Dialogue: 0,0:07:23.15,0:07:25.65,Default,,0,0,0,,Бүгін Sunrise Airlines авиакомпаниясын қайта пайдаланыңыз...
Dialogue: 0,0:07:25.73,0:07:27.02,Default,,0,0,0,,Сіз оны таптыңыз ба?
Dialogue: 0,0:07:39.33,0:07:42.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:42.33,0:07:44.79,Default,,0,0,0,,—
Dialogue: 0,0:07:44.88,0:07:47.17,Default,,0,0,0,,Бұл әйелдің қолжазбасы.
Dialogue: 0,0:07:47.25,0:07:49.76,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:07:49.84,0:07:51.47,Default,,0,0,0,,Егер клиент әдемі әйел болса—
Dialogue: 0,0:07:51.55,0:07:55.14,Default,,0,0,0,,...
Dialogue: 0,0:07:55.22,0:07:57.60,Default,,0,0,0,,Ах! Бірақ бұл жалғаса берсе...
Dialogue: 0,0:07:57.68,0:08:01.89,Default,,0,0,0,,...
Dialogue: 0,0:08:01.98,0:08:03.02,Default,,0,0,0,,Я...
Dialogue: 0,0:08:04.56,0:08:05.61,Default,,0,0,0,,О...
Dialogue: 0,0:08:05.69,0:08:09.73,Default,,0,0,0,,...
Dialogue: 0,0:08:10.32,0:08:11.36,Default,,0,0,0,,Ннн…
Dialogue: 0,0:08:11.44,0:08:13.82,Default,,0,0,0,,Менің өмір сүруден басқа амалым жоқ.
Dialogue: 0,0:08:14.66,0:08:17.24,Default,,0,0,0,,♪ Сәйкестік сәйкестігі
Dialogue: 0,0:08:17.33,0:08:19.74,Default,,0,0,0,,♪ Мак Чинг Гу~
Dialogue: 0,0:08:19.83,0:08:20.87,Default,,0,0,0,,Ухуху…
Dialogue: 0,0:08:20.95,0:08:23.25,Default,,0,0,0,,Бүгін қай баланы таңдауым керек?
Dialogue: 0,0:08:23.33,0:08:27.42,Default,,0,0,0,,～ …
Dialogue: 0,0:08:27.50,0:08:28.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:28.75,0:08:29.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:29.67,0:08:31.63,Default,,0,0,0,,Сіз не туралы шатасасыз?
Dialogue: 0,0:08:31.71,0:08:33.63,Default,,0,0,0,,О, Каору-чан, қош келдің.
Dialogue: 0,0:08:33.72,0:08:34.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:36.26,0:08:39.51,Default,,0,0,0,,“”
Dialogue: 0,0:08:39.60,0:08:44.06,Default,,0,0,0,,Сен осындай атпен тіркелгенің үшін ақымақсың ба?
Dialogue: 0,0:08:44.14,0:08:47.44,Default,,0,0,0,,…
Dialogue: 0,0:08:47.52,0:08:48.98,Default,,0,0,0,,Біз де солай істеп жатырмыз ба?
Dialogue: 0,0:08:49.07,0:08:50.52,Default,,0,0,0,,Ухахаха!
Dialogue: 0,0:08:50.61,0:08:51.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:53.86,0:08:54.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:54.99,0:08:57.66,Default,,0,0,0,,Уау! Моккори-чан!
Dialogue: 0,0:08:57.74,0:08:58.78,Default,,0,0,0,,～
Dialogue: 0,0:08:58.87,0:08:59.91,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:08:59.99,0:09:04.87,Default,,0,0,0,,...
Dialogue: 0,0:09:04.96,0:09:07.71,Default,,0,0,0,,...
Dialogue: 0,0:09:07.79,0:09:10.59,Default,,0,0,0,,А... Өкінішке орай, дұрыс айтасыз.
Dialogue: 0,0:09:11.00,0:09:15.80,Default,,0,0,0,,～…
Dialogue: 0,0:09:15.88,0:09:18.39,Default,,0,0,0,,…
Dialogue: 0,0:09:18.47,0:09:19.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:19.80,0:09:20.85,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:09:23.60,0:09:26.39,Default,,0,0,0,,Моккори-чаннан бері біраз уақыт өтті...
Dialogue: 0,0:09:26.48,0:09:28.90,Default,,0,0,0,,Рё Чан өте бақытты!
Dialogue: 0,0:09:28.98,0:09:30.77,Default,,0,0,0,,Жылама, шіркін!
Dialogue: 0,0:09:30.86,0:09:33.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:33.94,0:09:35.28,Default,,0,0,0,,Бұл тек болжам ғана, айтпақшы.
Dialogue: 0,0:09:35.36,0:09:39.07,Default,,0,0,0,,...
Dialogue: 0,0:09:39.16,0:09:41.41,Default,,0,0,0,,...
Dialogue: 0,0:09:41.49,0:09:44.79,Default,,0,0,0,,—
Dialogue: 0,0:09:44.87,0:09:47.92,Default,,0,0,0,,Біз кез келген нәрсені қабылдаймыз.
Dialogue: 0,0:09:48.37,0:09:51.38,Default,,0,0,0,,Саеба... Рё
Dialogue: 0,0:09:52.38,0:09:54.80,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:09:54.88,0:09:57.34,Default,,0,0,0,,Маған Рё Чан деп қоңырау шалыңыз.
Dialogue: 0,0:09:57.43,0:09:58.97,Default,,0,0,0,,Сонымен сенің атың кім?
Dialogue: 0,0:09:59.05,0:10:00.14,Default,,0,0,0,,Ннн…
Dialogue: 0,0:10:00.22,0:10:02.56,Default,,0,0,0,,Өйткені менің жұмысымнан хабарым жоқ!
Dialogue: 0,0:10:02.64,0:10:03.93,Default,,0,0,0,,Аа, аты...
Dialogue: 0,0:10:04.02,0:10:04.85,Default,,0,0,0,,Иә
Dialogue: 0,0:10:04.93,0:10:08.69,Default,,0,0,0,,＝ ･
Dialogue: 0,0:10:08.77,0:10:10.31,Default,,0,0,0,,Бұл ұзын атау, сондықтан Энн...
Dialogue: 0,0:10:10.40,0:10:11.98,Default,,0,0,0,,Бұл Энджи!
Dialogue: 0,0:10:12.06,0:10:13.11,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:13.77,0:10:15.74,Default,,0,0,0,,...
Dialogue: 0,0:10:15.82,0:10:16.90,Default,,0,0,0,,Неше жаста?
Dialogue: 0,0:10:16.99,0:10:19.61,Default,,0,0,0,,Үш өлшем қандай? Мен болжай аламын ба?
Dialogue: 0,0:10:19.70,0:10:20.78,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:20.87,0:10:22.07,Default,,0,0,0,,-（） -（）…
Dialogue: 0,0:10:22.16,0:10:24.99,Default,,0,0,0,,Бұл туралы уайымдама, жыныстық қудалаушы!
Dialogue: 0,0:10:25.54,0:10:26.91,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:10:27.00,0:10:29.71,Default,,0,0,0,,…
Dialogue: 0,0:10:29.79,0:10:30.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:30.79,0:10:33.75,Default,,0,0,0,,Сіз Рио туралы білесіз бе?
Dialogue: 0,0:10:33.84,0:10:34.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:34.84,0:10:36.09,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:10:37.42,0:10:39.55,Default,,0,0,0,,Сен не айтып тұрсың, Каори?
Dialogue: 0,0:10:40.01,0:10:44.72,Default,,0,0,0,,...
Dialogue: 0,0:10:44.81,0:10:48.35,Default,,0,0,0,,Ендеше мұқият қарайық...
Dialogue: 0,0:10:48.43,0:10:50.85,Default,,0,0,0,,Бөкселерімізді жинап алайық
Dialogue: 0,0:10:50.94,0:10:53.52,Default,,0,0,0,,Ендеше неге тоқтамайсың?
Dialogue: 0,0:10:53.86,0:10:54.90,Default,,0,0,0,,《Міне, басталды!》
Dialogue: 0,0:10:55.86,0:10:59.28,Default,,0,0,0,,Ах! Қол!
Dialogue: 0,0:11:01.03,0:11:02.66,Default,,0,0,0,,Мысықты іздеп жүрсіз бе?
Dialogue: 0,0:11:02.74,0:11:03.91,Default,,0,0,0,,Иә
Dialogue: 0,0:11:03.99,0:11:07.95,Default,,0,0,0,,Мен оны туған жерімнен әкелдім, бірақ ол жоғалып кетті...
Dialogue: 0,0:11:08.04,0:11:09.58,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:10.16,0:11:11.62,Default,,0,0,0,,О, өте сүйкімді!
Dialogue: 0,0:11:12.33,0:11:14.09,Default,,0,0,0,,Аты - Калико
Dialogue: 0,0:11:14.17,0:11:16.21,Default,,0,0,0,,Бұл бала Жапонияның әйгілі жерлеріне саяхат жасайды—
Dialogue: 0,0:11:16.30,0:11:19.22,Default,,0,0,0,,Мен бейне арна ашуды ойладым...
Dialogue: 0,0:11:19.30,0:11:21.72,Default,,0,0,0,,Әй, бұл калико мысық па?
Dialogue: 0,0:11:21.80,0:11:22.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:22.72,0:11:27.06,Default,,0,0,0,,Мен мұны бұрын көрген сияқтымын...
Dialogue: 0,0:11:29.10,0:11:32.94,Default,,0,0,0,,Мм, сен Жапонияға мысықтарды суретке түсіру үшін бардың ба?
Dialogue: 0,0:11:33.02,0:11:34.06,Default,,0,0,0,,Иә
Dialogue: 0,0:11:34.15,0:11:36.86,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:11:36.94,0:11:38.36,Default,,0,0,0,,Бір сәт кешіріңіз.
Dialogue: 0,0:11:38.98,0:11:42.24,Default,,0,0,0,,Сәлем, сіз бұдан сұрау салу ақысын күтуіңіз мүмкін.
Dialogue: 0,0:11:42.32,0:11:43.53,Default,,0,0,0,,Хош иісті заттар...
Dialogue: 0,0:11:43.61,0:11:47.12,Default,,0,0,0,,Клиентке осылай ғана қарауға болады ма?
Dialogue: 0,0:11:47.20,0:11:48.24,Default,,0,0,0,,Ннн…
Dialogue: 0,0:11:48.33,0:11:50.83,Default,,0,0,0,,Қаржы мәселесіне тым немқұрайлы қарағандықтан болар!
Dialogue: 0,0:11:50.91,0:11:52.62,Default,,0,0,0,,Маған күн көру қаншалықты қиын деп ойлаймын...
Dialogue: 0,0:11:52.71,0:11:55.08,Default,,0,0,0,,Мм... өтемақыға қатысты...
Dialogue: 0,0:11:55.17,0:11:57.13,Default,,0,0,0,,Камадо!
Dialogue: 0,0:11:57.21,0:11:59.13,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:11:59.21,0:12:03.01,Default,,0,0,0,,Мынау... міне... бұл жақсы ма!? ?
Dialogue: 0,0:12:03.09,0:12:04.14,Default,,0,0,0,,Иә
Dialogue: 0,0:12:04.22,0:12:06.22,Default,,0,0,0,,Өйткені Калико - өте маңызды мысық.
Dialogue: 0,0:12:06.30,0:12:08.18,Default,,0,0,0,,Нмм...
Dialogue: 0,0:12:08.26,0:12:10.22,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:12:10.60,0:12:14.31,Default,,0,0,0,,Мен ол мысықты міндетті түрде табамын!
Dialogue: 0,0:12:23.61,0:12:26.24,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:12:26.32,0:12:29.08,Default,,0,0,0,,Бұл мысық мысық осында екені анық.
Dialogue: 0,0:12:29.16,0:12:30.20,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:12:30.62,0:12:33.21,Default,,0,0,0,,Мен ешбір калико мысықтарын таба алмаймын.
Dialogue: 0,0:12:33.29,0:12:36.88,Default,,0,0,0,,Осы сұрауды орындасаңыз, біраз уақыт өмір сүре аласыз.
Dialogue: 0,0:12:36.96,0:12:40.17,Default,,0,0,0,,Иә? О, Энджи, сен де осындай жерлерді суретке түсіресің бе?
Dialogue: 0,0:12:40.71,0:12:43.42,Default,,0,0,0,,Бейне продюсерлер үшін де оңай емес.
Dialogue: 0,0:12:43.51,0:12:46.01,Default,,0,0,0,,Бейне тақырыбына айналатын нәрсені қашан түсіре аламын?
Dialogue: 0,0:12:46.09,0:12:47.26,Default,,0,0,0,,Себебі мен білмеймін
Dialogue: 0,0:12:47.34,0:12:50.18,Default,,0,0,0,,Энджи-кун, сіз суретке түскеніңіз жөн...
Dialogue: 0,0:12:50.26,0:12:52.22,Default,,0,0,0,,Сіз фотода жақсырақ көрінесіз
Dialogue: 0,0:12:52.31,0:12:53.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:53.56,0:12:54.94,Default,,0,0,0,,Гуфуфу~!
Dialogue: 0,0:12:55.02,0:12:58.44,Default,,0,0,0,,Өйткені оның денесі сондай толымды.
Dialogue: 0,0:12:58.52,0:12:59.57,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,0:12:59.65,0:13:02.49,Default,,0,0,0,,Ах! Мен мысық емеспін.
Dialogue: 0,0:13:02.57,0:13:05.61,Default,,0,0,0,,-（） -（）
Dialogue: 0,0:13:09.16,0:13:10.87,Default,,0,0,0,,Мен мысық іздеп жүрмін!
Dialogue: 0,0:13:10.95,0:13:12.50,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:13:12.58,0:13:14.54,Default,,0,0,0,,Сіз бұл мысықты білмейсіз бе?
Dialogue: 0,0:13:14.62,0:13:17.50,Default,,0,0,0,,Көрсеңіз, бізге хабарлаңыз!
Dialogue: 0,0:13:17.58,0:13:19.38,Default,,0,0,0,,Мен бұл мысықты іздеп жүрмін!
Dialogue: 0,0:13:19.46,0:13:22.67,Default,,0,0,0,,Егер тауып алсаңыз, осы нөмірге хабарласыңыз!
Dialogue: 0,0:13:23.55,0:13:25.09,Default,,0,0,0,,Каору-сан, бұл керемет...
Dialogue: 0,0:13:25.17,0:13:28.18,Default,,0,0,0,,Мүмкін бұл Энджидің сыйлығына байланысты шығар.
Dialogue: 0,0:13:29.22,0:13:32.22,Default,,0,0,0,,Нысананы ұрлаған адамның жеке басы мен тұрған жері.
Dialogue: 0,0:13:32.31,0:13:33.77,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,0:13:34.27,0:13:38.94,Default,,0,0,0,,Ұйым біздің қозғалыстарымызды сезіп, қозғалған болуы мүмкін.
Dialogue: 0,0:13:39.02,0:13:40.27,Default,,0,0,0,,Осы мәселеге қатысты...
Dialogue: 0,0:13:40.36,0:13:41.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:41.86,0:13:45.69,Default,,0,0,0,,Бұдан былай маған сенсіз істеуге рұқсат бергім келеді.
Dialogue: 0,0:13:45.78,0:13:46.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:47.66,0:13:49.57,Default,,0,0,0,,Түсіндірме бар сияқты.
Dialogue: 0,0:13:50.20,0:13:54.45,Default,,0,0,0,,Әрине, мен нысананы қайта алуға көмектесемін.
Dialogue: 0,0:13:54.54,0:13:59.12,Default,,0,0,0,,Маған дүкеннің жөндеу шығындарының үлкен сомасын жабуды сұрады.
Dialogue: 0,0:13:59.21,0:14:00.84,Default,,0,0,0,,- (Үмибозу) А? -(Махаббат) Әрине
Dialogue: 0,0:14:01.67,0:14:04.96,Default,,0,0,0,,Арқалықтарды аса қалың оқ өткізбейтін шыны және болат жақтаулармен күшейту
Dialogue: 0,0:14:05.05,0:14:07.84,Default,,0,0,0,,Сіз бұған біраз уақыт кетті дедіңіз.
Dialogue: 0,0:14:08.80,0:14:11.39,Default,,0,0,0,,Мен саған кофе әкелдім.
Dialogue: 0,0:14:11.47,0:14:14.93,Default,,0,0,0,,О, Умикобозу-чан, сен кереметсің.
Dialogue: 0,0:14:15.02,0:14:16.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:17.14,0:14:18.27,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:14:18.35,0:14:20.48,Default,,0,0,0,,А, бұл жақсы емес!
Dialogue: 0,0:14:20.56,0:14:21.94,Default,,0,0,0,,Не?
Dialogue: 0,0:14:22.02,0:14:23.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:23.82,0:14:24.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:25.48,0:14:27.61,Default,,0,0,0,,Қорғаныс режимін қосу
Dialogue: 0,0:14:34.99,0:14:37.16,Default,,0,0,0,,Міне, осыны білдіреді!
Dialogue: 0,0:14:37.25,0:14:39.87,Default,,0,0,0,,Жөндеу шығындарын ескерсек, бұл қымбат.
Dialogue: 0,0:14:39.96,0:14:41.67,Default,,0,0,0,,Масқара...
Dialogue: 0,0:14:42.71,0:14:44.80,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:14:44.88,0:14:46.96,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:14:47.05,0:14:48.30,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:14:48.38,0:14:50.88,Default,,0,0,0,,Маған сіздің күнделікті өміріңізді көбірек суретке түсіруге рұқсат етіңіз.
Dialogue: 0,0:14:50.97,0:14:53.80,Default,,0,0,0,,Бізді суретке түсіру үшін не істейсіз?
Dialogue: 0,0:14:53.89,0:14:55.18,Default,,0,0,0,,Қызықты ештеңе жоқ...
Dialogue: 0,0:14:55.26,0:14:56.97,Default,,0,0,0,,Жоқ! Ол міндетті түрде вирусқа айналады!
Dialogue: 0,0:14:57.06,0:14:58.10,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:58.18,0:15:03.48,Default,,0,0,0,,Дүние жүзіндегі адамдарға осы сирек кездесетін жапондық жұптың өмірі туралы айтып беріңізші!
Dialogue: 0,0:15:03.56,0:15:04.48,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:15:04.98,0:15:07.86,Default,,0,0,0,,...
Dialogue: 0,0:15:07.94,0:15:11.36,Default,,0,0,0,,Ал... Райо екеуміз шын мәнінде жұп емеспіз.
Dialogue: 0,0:15:11.45,0:15:14.49,Default,,0,0,0,,Біздің қызметіміздің сипатына байланысты фотосуретке түсіруге рұқсат бермейміз.
Dialogue: 0,0:15:14.58,0:15:16.87,Default,,0,0,0,,А... шынымен бе?
Dialogue: 0,0:15:17.33,0:15:19.58,Default,,0,0,0,,Біз Каликоны тапқанша...
Dialogue: 0,0:15:19.66,0:15:21.33,Default,,0,0,0,,Маған осында қалуға рұқсат етіңіз.
Dialogue: 0,0:15:21.42,0:15:24.04,Default,,0,0,0,,Мен қонақүйден шығып үлгердім.
Dialogue: 0,0:15:24.13,0:15:25.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:25.25,0:15:27.80,Default,,0,0,0,,Қош келдіңіз Энджи!
Dialogue: 0,0:15:27.88,0:15:29.72,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:15:29.80,0:15:33.01,Default,,0,0,0,,Клиенттер тегін тұра алады.
Dialogue: 0,0:15:33.09,0:15:34.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:34.22,0:15:36.06,Default,,0,0,0,,Мен Каликоны тапқанша маған қамқорлық жасаңыз...
Dialogue: 0,0:15:36.14,0:15:39.02,Default,,0,0,0,,Маған қарыздар екеніңізге сене алар емеспін!
Dialogue: 0,0:15:39.10,0:15:42.56,Default,,0,0,0,,Ауыр ештеңе айтпа Релакс Релакс
Dialogue: 0,0:15:42.65,0:15:44.31,Default,,0,0,0,,Иә, жұмсақ
Dialogue: 0,0:15:44.40,0:15:47.44,Default,,0,0,0,,Осы толымды кеуде туралы~
Dialogue: 0,0:15:47.52,0:15:49.32,Default,,0,0,0,,Гухихихихи…
Dialogue: 0,0:15:49.40,0:15:50.24,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:50.32,0:15:53.07,Default,,0,0,0,,Нмм...
Dialogue: 0,0:15:53.41,0:15:56.08,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:15:56.16,0:15:57.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:58.04,0:16:00.41,Default,,0,0,0,,Мен сені ертең шындап іздеймін.
Dialogue: 0,0:16:00.50,0:16:03.29,Default,,0,0,0,,Иә, мен бөлістім...
Dialogue: 0,0:16:15.64,0:16:17.55,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:16:30.19,0:16:31.19,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:32.19,0:16:33.57,Default,,0,0,0,,Я...
Dialogue: 0,0:16:36.49,0:16:40.33,Default,,0,0,0,,Мм... Мен мысық іздедім.
Dialogue: 0,0:16:40.41,0:16:42.20,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:16:42.71,0:16:45.92,Default,,0,0,0,,Егер мен оны таба алмасам ше?
Dialogue: 0,0:16:46.00,0:16:48.04,Default,,0,0,0,,Алдын ала толық төленген өтемақы
Dialogue: 0,0:16:48.13,0:16:50.84,Default,,0,0,0,,Мен оның барлығын жинаған шоттарымды төлеуге жұмсадым.
Dialogue: 0,0:16:50.92,0:16:52.51,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:16:52.59,0:16:55.22,Default,,0,0,0,,...
Dialogue: 0,0:16:55.30,0:16:56.89,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:16:56.97,0:16:57.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:57.93,0:17:00.39,Default,,0,0,0,,Ха... мүмкін емес...
Dialogue: 0,0:17:00.47,0:17:01.89,Default,,0,0,0,,Ннн…
Dialogue: 0,0:17:02.52,0:17:03.89,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:17:04.27,0:17:06.40,Default,,0,0,0,,Әлгі бейбақ!
Dialogue: 0,0:17:06.48,0:17:08.69,Default,,0,0,0,,Бұл сізді табысты етеді!
Dialogue: 0,0:17:08.77,0:17:10.90,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:17:14.11,0:17:17.28,Default,,0,0,0,,(шу)
Dialogue: 0,0:17:17.36,0:17:20.78,Default,,0,0,0,,Энджи Чей!
Dialogue: 0,0:17:21.45,0:17:23.58,Default,,0,0,0,,Уваааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:17:23.66,0:17:25.71,Default,,0,0,0,,Менің хош иісті затым...
Dialogue: 0,0:17:25.79,0:17:26.62,Default,,0,0,0,,Бұл… бұл…
Dialogue: 0,0:17:26.71,0:17:29.38,Default,,0,0,0,,Сіз тіпті осындай нәрсені жасадыңыз!
Dialogue: 0,0:17:29.46,0:17:32.30,Default,,0,0,0,,Бірақ бәрібір тым тәтті!
Dialogue: 0,0:17:32.38,0:17:33.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:33.59,0:17:35.84,Default,,0,0,0,,Сіз қолдарыңызды көтердіңіз...
Dialogue: 0,0:17:36.43,0:17:37.76,Default,,0,0,0,,Сен бірдеңемен алдап жатырсың.
Dialogue: 0,0:17:37.84,0:17:41.10,Default,,0,0,0,,Мен мұндай нәрседен бас тартатын адам емеспін!
Dialogue: 0,0:17:41.18,0:17:43.10,Default,,0,0,0,,Оля!
Dialogue: 0,0:17:43.18,0:17:44.98,Default,,0,0,0,,Мм! Нгаа!
Dialogue: 0,0:17:45.35,0:17:46.73,Default,,0,0,0,,Та-да!
Dialogue: 0,0:17:46.81,0:17:48.85,Default,,0,0,0,,Кун Кун Кун Кун Кун Кун Кун Кун Кун Кун Кун Кун Кун Кун Кун Кун Кун Кун Күн
Dialogue: 0,0:17:48.94,0:17:49.98,Default,,0,0,0,,Қазір!
Dialogue: 0,0:17:50.06,0:17:52.23,Default,,0,0,0,,О, осындай жерде...
Dialogue: 0,0:17:52.32,0:17:54.82,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:54.90,0:17:57.28,Default,,0,0,0,,Nyohohoho...
Dialogue: 0,0:17:57.36,0:17:58.53,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:58.61,0:18:00.37,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:18:00.87,0:18:02.49,Default,,0,0,0,,Спорттық көкірекше…
Dialogue: 0,0:18:03.08,0:18:05.95,Default,,0,0,0,,Мынаны киіп, сол көлемді алыңыз!
Dialogue: 0,0:18:06.04,0:18:09.37,Default,,0,0,0,,Не болып жатыр!? ?
Dialogue: 0,0:18:09.46,0:18:11.84,Default,,0,0,0,,Ngo!
Dialogue: 0,0:18:11.92,0:18:14.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:16.84,0:18:19.93,Default,,0,0,0,,Бұл жерде!
Dialogue: 0,0:18:20.01,0:18:21.09,Default,,0,0,0,,Гуде!
Dialogue: 0,0:18:22.81,0:18:26.52,Default,,0,0,0,,Ондаған жылдар бойы осылай істеп келе жатырсың, ақымақ генерал!
Dialogue: 0,0:18:26.60,0:18:28.52,Default,,0,0,0,,Немесе… ладан…
Dialogue: 0,0:18:28.60,0:18:31.23,Default,,0,0,0,,Ол Энджиге тиіп кетсе ауырады.
Dialogue: 0,0:18:31.31,0:18:33.40,Default,,0,0,0,,А, Энджи, жақсысың ба?
Dialogue: 0,0:18:33.48,0:18:35.82,Default,,0,0,0,,Иә?Иә
Dialogue: 0,0:18:35.90,0:18:37.15,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:18:37.24,0:18:38.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:38.15,0:18:39.24,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:18:39.32,0:18:41.62,Default,,0,0,0,,А... А, рахмет.
Dialogue: 0,0:18:41.70,0:18:44.83,Default,,0,0,0,,Ол жақтағы адамдар өте қарапайым.
Dialogue: 0,0:18:44.91,0:18:48.00,Default,,0,0,0,,Ал... енді түсіндің, солай ма?
Dialogue: 0,0:18:48.08,0:18:52.04,Default,,0,0,0,,Менің досым осындай, қолыңнан келсе сақ бол.
Dialogue: 0,0:18:52.13,0:18:55.75,Default,,0,0,0,,Шайтанның қолы созылса, қашып кетсең пайдалы болар еді...
Dialogue: 0,0:18:56.46,0:18:57.76,Default,,0,0,0,,Одан да көп, Каору-сан.
Dialogue: 0,0:18:57.84,0:18:58.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:58.76,0:19:01.34,Default,,0,0,0,,Сен Саеба-саннан күштісің, солай ма?
Dialogue: 0,0:19:01.43,0:19:04.64,Default,,0,0,0,,Не? Хахахаха! Бұл...
Dialogue: 0,0:19:04.72,0:19:07.56,Default,,0,0,0,,Иә? Темір шар? Неліктен бұлай? Хахаха…
Dialogue: 0,0:19:07.64,0:19:09.14,Default,,0,0,0,,Иә? Бұл біртүрлі
Dialogue: 0,0:19:19.24,0:19:20.45,Default,,0,0,0,,Та-да!
Dialogue: 0,0:19:20.53,0:19:21.99,Default,,0,0,0,,Кункун Кункун
Dialogue: 0,0:19:22.07,0:19:23.12,Default,,0,0,0,,Қазір!
Dialogue: 0,0:19:23.20,0:19:25.08,Default,,0,0,0,,О, мына жерде...
Dialogue: 0,0:19:25.16,0:19:27.24,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:27.33,0:19:29.00,Default,,0,0,0,,Nyohohoho...
Dialogue: 0,0:19:29.87,0:19:32.25,Default,,0,0,0,,Бұл Рио Саеба...
Dialogue: 0,0:19:34.54,0:19:35.84,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:37.21,0:19:40.80,Default,,0,0,0,,Бұл сіздің ең жақсы жұмысыңыз ба?
Dialogue: 0,0:19:55.27,0:19:56.32,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:19:58.82,0:19:59.94,Default,,0,0,0,,《Міне, басталды!》
Dialogue: 0,0:20:01.11,0:20:04.03,Default,,0,0,0,,Сіз кенеттен не істеп жатырсыз? Саеко
Dialogue: 0,0:20:04.11,0:20:05.74,Default,,0,0,0,,Сіз қосымша миль жүрдіңіз.
Dialogue: 0,0:20:05.82,0:20:06.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:07.16,0:20:09.95,Default,,0,0,0,,Транзакция келесі күні болатыны туралы ақпарат.
Dialogue: 0,0:20:10.04,0:20:11.54,Default,,0,0,0,,Мен мынаны ұстадым.
Dialogue: 0,0:20:11.62,0:20:12.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:12.75,0:20:14.67,Default,,0,0,0,,Оқиға орнында оны алу шаралары жүргізілді.
Dialogue: 0,0:20:14.75,0:20:17.59,Default,,0,0,0,,Балалар, сендер жағдайды нашарлатуларың керек!
Dialogue: 0,0:20:19.21,0:20:20.76,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:20:20.84,0:20:22.93,Default,,0,0,0,,Бұл қоғамдық қауіпсіздіктен Шимоямада!
Dialogue: 0,0:20:23.72,0:20:27.01,Default,,0,0,0,,...Ал ішінде нақты не бар?
Dialogue: 0,0:20:28.22,0:20:31.10,Default,,0,0,0,,Биотехнологиялық компания Zoltic оны өмірге қайтарды.
Dialogue: 0,0:20:31.18,0:20:33.98,Default,,0,0,0,,Ібілістің өнертабысы Әскери мақсатта қолдану
Dialogue: 0,0:20:38.23,0:20:40.11,Default,,0,0,0,,«Періште шаңы»
Dialogue: 0,0:20:40.69,0:20:43.57,Default,,0,0,0,,Иә, періште шаңы
Dialogue: 0,0:20:44.15,0:20:47.62,Default,,0,0,0,,Наномашиналар көмегімен физикалық қабілеттерін арттыру
Dialogue: 0,0:20:47.70,0:20:50.66,Default,,0,0,0,,Адамның ауру сезімін, қорқыныш сезімін салдандыру
Dialogue: 0,0:20:50.74,0:20:54.08,Default,,0,0,0,,Сізді адамнан тыс сарбазға айналдыратын қараңғы технология
Dialogue: 0,0:20:54.79,0:20:59.80,Default,,0,0,0,,Жанама әсерлерді басатын екінші буын ұрыс даласында бұрыннан қолданылған сияқты.
Dialogue: 0,0:21:01.00,0:21:03.76,Default,,0,0,0,,Қайта шығару мүмкін емес деп есептелген түпнұсқа...
Dialogue: 0,0:21:03.84,0:21:06.72,Default,,0,0,0,,Жақсартылған нұсқа ретінде қайта жасалуда
Dialogue: 0,0:21:07.89,0:21:09.72,Default,,0,0,0,,«Ангел шаңы өзгертілген»
Dialogue: 0,0:21:10.22,0:21:12.22,Default,,0,0,0,,Бірінші әріпті алыңыз—
Dialogue: 0,0:21:12.31,0:21:15.23,Default,,0,0,0,,«ADM» Ол осылай аталады.
Dialogue: 0,0:21:16.44,0:21:18.06,Default,,0,0,0,,Оны біреу алып кетті...
Dialogue: 0,0:21:18.15,0:21:22.23,Default,,0,0,0,,Адам, бұл дүниеде әлі бір ғана жиын бар.
Dialogue: 0,0:21:23.69,0:21:25.20,Default,,0,0,0,,Иә, сонда...
Dialogue: 0,0:21:25.28,0:21:29.20,Default,,0,0,0,,Қызыл Пегас бар ма?
Dialogue: 0,0:21:29.28,0:21:30.33,Default,,0,0,0,,Иә
Dialogue: 0,0:21:30.83,0:21:33.66,Default,,0,0,0,,Хмф... Бұл жақсы идея.
Dialogue: 0,0:21:33.75,0:21:35.58,Default,,0,0,0,,Сіз бір тесіктенсіз бе?
Dialogue: 0,0:21:36.46,0:21:39.79,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:21:45.76,0:21:47.13,Default,,0,0,0,,Макимура…
Dialogue: 0,0:21:47.22,0:21:49.22,Default,,0,0,0,,Ух... иә... хош иісті зат...
Dialogue: 0,0:21:49.30,0:21:51.22,Default,,0,0,0,,Та... сұраңыз
Dialogue: 0,0:21:52.56,0:21:56.81,Default,,0,0,0,,Тозақ біраз уақыт жалғыз қалуы мүмкін...
Dialogue: 0,0:21:56.89,0:22:01.06,Default,,0,0,0,,Мен оны бірден жандандырамын, Макимұра.
Dialogue: 0,0:22:02.48,0:22:05.90,Default,,0,0,0,,Сіздің бұрынғы серіктесіңіз… менің әріптесім де болды—
Dialogue: 0,0:22:05.99,0:22:09.91,Default,,0,0,0,,Хидеюки Макимураның жауы... Қызыл Пегас
Dialogue: 0,0:22:09.99,0:22:15.54,Default,,0,0,0,,Жапонияның ең ірі қылмыстық ұйымы соңғы жылдары белсендірек бола бастады.
Dialogue: 0,0:22:15.62,0:22:18.21,Default,,0,0,0,,Сол тыныс Золтикке байланысты.
Dialogue: 0,0:22:18.29,0:22:21.08,Default,,0,0,0,,Клиенттің сапа талаптары қатаң болған сияқты...
Dialogue: 0,0:22:21.17,0:22:23.80,Default,,0,0,0,,Ақырында біз бір жиынтықты жасай алдық.
Dialogue: 0,0:22:23.88,0:22:26.63,Default,,0,0,0,,Сондықтан мен оны қазір ұстағым келді!
Dialogue: 0,0:22:26.72,0:22:32.35,Default,,0,0,0,,Осылайша үш апалы-сіңлілі Моккори оны ұрлап, қараңғылыққа көмуге тырысты.
Dialogue: 0,0:22:32.43,0:22:36.68,Default,,0,0,0,,Бұйрықшы... Басқаша айтқанда, Қызыл Пегастың жоғары ұйымы...
Dialogue: 0,0:22:36.77,0:22:39.85,Default,,0,0,0,,Өйткені мен сіз көтере алатын адам емеспін.
Dialogue: 0,0:22:39.94,0:22:42.31,Default,,0,0,0,,Не! ? Ннн...
Dialogue: 0,0:22:42.40,0:22:46.36,Default,,0,0,0,,Сізде оның жоғары ұйымы туралы түсінік бар сияқты.
Dialogue: 0,0:22:48.49,0:22:51.36,Default,,0,0,0,,Мүмкін Union Teope
Dialogue: 0,0:22:51.45,0:22:52.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:52.95,0:22:55.99,Default,,0,0,0,,Сіз сол алып синдикаттансыз ба?
Dialogue: 0,0:22:56.08,0:22:57.87,Default,,0,0,0,,Сипаттамалар болды ма?
Dialogue: 0,0:22:58.66,0:22:59.71,Default,,0,0,0,,Егер бар болса...
Dialogue: 0,0:23:01.63,0:23:06.51,Default,,0,0,0,,Мен сияқты, Colt Python 357 Magnum пайдаланады.
Dialogue: 0,0:23:10.01,0:23:12.39,Default,,0,0,0,,Саеба-сан, қайда бара жатырсың?
Dialogue: 0,0:23:12.47,0:23:14.76,Default,,0,0,0,,Бұлай іш киім киюге болмайды!
Dialogue: 0,0:23:14.85,0:23:16.97,Default,,0,0,0,,Ең жақсы толық кеудеге арналған...
Dialogue: 0,0:23:17.81,0:23:19.94,Default,,0,0,0,,Сізге мұндай нәрсе жарасады!
Dialogue: 0,0:23:20.02,0:23:21.06,Default,,0,0,0,,Гуфуфуфуфу…
Dialogue: 0,0:23:22.15,0:23:23.36,Default,,0,0,0,,Мфуфуфуфуфуфу…
Dialogue: 0,0:23:23.44,0:23:24.52,Default,,0,0,0,,Ии!
Dialogue: 0,0:23:24.61,0:23:26.61,Default,,0,0,0,,Жүр, мысықты тауып алайық!
Dialogue: 0,0:23:26.69,0:23:29.65,Default,,0,0,0,,Энджи, маған көмектес!
Dialogue: 0,0:23:29.74,0:23:31.28,Default,,0,0,0,,...
Dialogue: 0,0:23:31.36,0:23:35.03,Default,,0,0,0,,Әйелдер үшін олардың өлшеміне алаңдайтындар да бар...
Dialogue: 0,0:23:35.12,0:23:36.37,Default,,0,0,0,,Иә, бәлкім…
Dialogue: 0,0:23:37.66,0:23:41.33,Default,,0,0,0,,Ммм! Аняру!
Dialogue: 0,0:23:41.42,0:23:43.42,Default,,0,0,0,,Ахах... ахах...
Dialogue: 0,0:23:43.50,0:23:46.21,Default,,0,0,0,,...Қажетсіз күш салмаңыз!
Dialogue: 0,0:23:46.88,0:23:48.67,Default,,0,0,0,,Әй, әйтеуір бүгін...
Dialogue: 0,0:23:48.76,0:23:50.92,Default,,0,0,0,,Уф! Аа, кешіріңіз, кешіріңіз
Dialogue: 0,0:23:51.01,0:23:52.97,Default,,0,0,0,,Басқа жаққа қарау қауіпті.
Dialogue: 0,0:23:53.05,0:23:55.76,Default,,0,0,0,,Ах, Умибозу мырза, Мики мырза
Dialogue: 0,0:23:55.85,0:23:58.18,Default,,0,0,0,,Сіз де шоппинг жасайсыз ба?
Dialogue: 0,0:23:58.27,0:24:00.73,Default,,0,0,0,,Әй, мына баланы танымайсың ба?
Dialogue: 0,0:24:00.81,0:24:01.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:02.23,0:24:04.65,Default,,0,0,0,,Нененене... мысық! ?
Dialogue: 0,0:24:04.73,0:24:06.02,Default,,0,0,0,,Ухуху…
Dialogue: 0,0:24:06.11,0:24:09.40,Default,,0,0,0,,Мүмкін бұл мысық...
Dialogue: 0,0:24:12.36,0:24:13.41,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:24:13.49,0:24:17.87,Default,,0,0,0,,Иә! ? 3D мысық?
Dialogue: 0,0:24:17.95,0:24:19.95,Default,,0,0,0,,Эй, мен де! Мен де!
Dialogue: 0,0:24:20.04,0:24:23.58,Default,,0,0,0,,Бұл интернеттен табылған сурет екенін білдіре ме?
Dialogue: 0,0:24:25.08,0:24:28.25,Default,,0,0,0,,...
Dialogue: 0,0:24:28.34,0:24:31.88,Default,,0,0,0,,«Маякта қараңғы» Мұны бәрі біледі.
Dialogue: 0,0:24:31.97,0:24:33.72,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:24:34.43,0:24:35.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:35.34,0:24:38.56,Default,,0,0,0,,Энджи-сан, сен неге бұлай істеп жатырсың?
Dialogue: 0,0:24:38.64,0:24:40.14,Default,,0,0,0,,Сұраныс құнының өзі соншалықты көп...
Dialogue: 0,0:24:40.89,0:24:41.93,Default,,0,0,0,,Фу…
Dialogue: 0,0:24:44.23,0:24:45.60,Default,,0,0,0,,(шарлардың ұшып шыққан дыбысы)
Dialogue: 0,0:24:50.69,0:24:52.19,Default,,0,0,0,,- (Әйел) Иә? -(Ер) А...
Dialogue: 0,0:24:52.28,0:24:54.61,Default,,0,0,0,,- (Әйел) Бірдеңе? -(Әйел) Бірдеңе болды ма?
Dialogue: 0,0:25:00.91,0:25:02.95,Default,,0,0,0,,Ешқандай белгі жоқ.
Dialogue: 0,0:25:03.04,0:25:06.92,Default,,0,0,0,,Әй, назарды аудару үшін шарды көздеу...
Dialogue: 0,0:25:07.00,0:25:10.63,Default,,0,0,0,,Екіншісі саған бағытталған сияқты...
Dialogue: 0,0:25:11.09,0:25:12.51,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:25:14.34,0:25:15.51,Default,,0,0,0,,Бұл...
Dialogue: 0,0:25:16.68,0:25:18.30,Default,,0,0,0,,Шындығында, мен...
Dialogue: 0,0:25:19.76,0:25:22.43,Default,,0,0,0,,Менің өмірім нысанаға алынған.
Dialogue: 0,0:25:26.69,0:25:29.52,Default,,0,0,0,,Мен айтуға қорқып сөйлей алмадым.
Dialogue: 0,0:25:29.61,0:25:32.78,Default,,0,0,0,,Адал болғаныңызға қуаныштымын.
Dialogue: 0,0:25:32.86,0:25:33.90,Default,,0,0,0,,Рахмет
Dialogue: 0,0:25:33.99,0:25:35.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:35.36,0:25:36.78,Default,,0,0,0,,Камадо!
Dialogue: 0,0:25:39.91,0:25:41.66,Default,,0,0,0,,Егер мен Саеба-санның қасында болсам...
Dialogue: 0,0:25:41.74,0:25:46.00,Default,,0,0,0,,Шындықты айтпасам да өзімді қорғай аламын деп ойладым...
Dialogue: 0,0:25:46.08,0:25:47.25,Default,,0,0,0,,Әлі-
Dialogue: 0,0:25:47.33,0:25:51.04,Default,,0,0,0,,Мысықты іздеу біртүрлі өтірік болды.
Dialogue: 0,0:25:51.13,0:25:54.84,Default,,0,0,0,,Үйге келгенше мысықпен бірдеңе болды ма?
Dialogue: 0,0:25:54.92,0:25:57.38,Default,,0,0,0,,Эй Каору-сан, Энджи-сан
Dialogue: 0,0:25:57.47,0:25:58.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:58.93,0:26:00.85,Default,,0,0,0,,Осыны қолданып көріңіз
Dialogue: 0,0:26:00.93,0:26:02.85,Default,,0,0,0,,Уау! не? бұл
Dialogue: 0,0:26:02.93,0:26:05.10,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:26:05.18,0:26:06.35,Default,,0,0,0,,Ухуху…
Dialogue: 0,0:26:06.43,0:26:10.06,Default,,0,0,0,,Келесі жолы құймақ жәрмеңкесін өткізу ойымда бар.
Dialogue: 0,0:26:10.15,0:26:12.48,Default,,0,0,0,,Егер сізге ұнаса, өз ойыңызды айтыңыз.
Dialogue: 0,0:26:12.57,0:26:15.36,Default,,0,0,0,,Хух~ Мики-санға ұқсайды.
Dialogue: 0,0:26:15.44,0:26:17.24,Default,,0,0,0,,Бұл Сұңқардың идеясы болды.
Dialogue: 0,0:26:17.32,0:26:19.28,Default,,0,0,0,,Иә? Бұл дұрыс па?
Dialogue: 0,0:26:20.20,0:26:21.32,Default,,0,0,0,,Гохон!
Dialogue: 0,0:26:21.41,0:26:22.58,Default,,0,0,0,,Ол қою терілі жігіт, детективтік әңгімедегі жаман кейіпкерге ұқсайды…
Dialogue: 0,0:26:22.66,0:26:23.99,Default,,0,0,0,,Нихихихихи…
Dialogue: 0,0:26:24.08,0:26:27.75,Default,,0,0,0,,Ендеше келіңіздер!
Dialogue: 0,0:26:29.08,0:26:30.29,Default,,0,0,0,,Уау, өте жұмсақ!
Dialogue: 0,0:26:32.00,0:26:33.88,Default,,0,0,0,,Мм! Дәмді!
Dialogue: 0,0:26:33.96,0:26:35.76,Default,,0,0,0,,Бұл дәмді!
Dialogue: 0,0:26:35.84,0:26:36.97,Default,,0,0,0,,Сіз қалай ойлайсыз? Энджи
Dialogue: 0,0:26:37.05,0:26:37.88,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:26:37.97,0:26:38.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:38.88,0:26:41.39,Default,,0,0,0,,А... Мистер Энджи?
Dialogue: 0,0:26:41.47,0:26:44.35,Default,,0,0,0,,Ахаха... Оны жеу қандай ерекше.
Dialogue: 0,0:26:44.76,0:26:45.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:46.31,0:26:47.35,Default,,0,0,0,,Ннн…
Dialogue: 0,0:26:50.90,0:26:52.31,Default,,0,0,0,,Ха…
Dialogue: 0,0:26:52.77,0:26:55.32,Default,,0,0,0,,Уау, дәмді!
Dialogue: 0,0:26:55.40,0:26:56.48,Default,,0,0,0,,... дұрыс па?
Dialogue: 0,0:26:56.57,0:26:58.86,Default,,0,0,0,,Жақсы. Бұл менің талғамыма сәйкес келеді.
Dialogue: 0,0:26:58.95,0:27:02.49,Default,,0,0,0,,Иә! Ылғалды, жұмсақ және серпімді.
Dialogue: 0,0:27:02.57,0:27:04.49,Default,,0,0,0,,Бай, бірақ жеңіл
Dialogue: 0,0:27:04.58,0:27:07.83,Default,,0,0,0,,Жаңғақтың әлсіз иісі ыңғайлы таралады...
Dialogue: 0,0:27:08.37,0:27:12.13,Default,,0,0,0,,Мен мұндай дәмді нәрсе бар екеніне сене алар емеспін.
Dialogue: 0,0:27:12.21,0:27:14.54,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:27:15.25,0:27:17.55,Default,,0,0,0,,Мен ешкім емеспін
Dialogue: 0,0:27:17.63,0:27:19.67,Default,,0,0,0,,Егер сізге ұнаса...
Dialogue: 0,0:27:19.76,0:27:21.22,Default,,0,0,0,,Осыған ұқсас нәрсе де бар
Dialogue: 0,0:27:21.68,0:27:23.01,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:27:23.09,0:27:24.14,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:27:24.22,0:27:26.06,Default,,0,0,0,,Әдемі! Өте керемет!
Dialogue: 0,0:27:26.51,0:27:27.97,Default,,0,0,0,,Тағы да бар!
Dialogue: 0,0:27:28.06,0:27:29.56,Default,,0,0,0,,Не? ?
Dialogue: 0,0:27:29.64,0:27:30.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:30.89,0:27:33.36,Default,,0,0,0,,Келіңіздер, рахат алыңыз!
Dialogue: 0,0:27:33.44,0:27:34.81,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:27:36.02,0:27:37.69,Default,,0,0,0,,- (Хош иісті зат) Иә, дәмді! -(Мики) Қалай ойлайсың? мыс?
Dialogue: 0,0:27:37.78,0:27:39.40,Default,,0,0,0,,Бақытты!
Dialogue: 0,0:27:42.49,0:27:44.41,Default,,0,0,0,,Иә? Ой!
Dialogue: 0,0:27:44.49,0:27:45.74,Default,,0,0,0,,Әдемі әйелді таптым!
Dialogue: 0,0:27:46.12,0:27:48.12,Default,,0,0,0,,Әпке!
Dialogue: 0,0:27:48.20,0:27:51.25,Default,,0,0,0,,Менімен шай ішкіңіз келе ме? Бұл дүкеннен басқа
Dialogue: 0,0:27:51.33,0:27:52.58,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:27:52.67,0:27:53.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:53.88,0:27:54.92,Default,,0,0,0,,Хмм…
Dialogue: 0,0:27:55.00,0:27:58.59,Default,,0,0,0,,Күте тұрыңыз! Менің Моккори-чаным!
Dialogue: 0,0:27:58.67,0:28:00.34,Default,,0,0,0,,...Мен ол жігітті қалаймын
Dialogue: 0,0:28:00.42,0:28:04.68,Default,,0,0,0,,Ху... Энджиді нысанаға алып жатыр.
Dialogue: 0,0:28:04.76,0:28:07.39,Default,,0,0,0,,Каору-сан, сенен сұрайын дегенім бар...
Dialogue: 0,0:28:07.47,0:28:09.02,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:28:09.10,0:28:10.60,Default,,0,0,0,,Саеба мырзаның айтқаны—
Dialogue: 0,0:28:11.10,0:28:13.35,Default,,0,0,0,,«Моккори» дегеніміз не?
Dialogue: 0,0:28:13.44,0:28:15.15,Default,,0,0,0,,- (Хош иісті зат) Иә? -(Мики) Уф!
Dialogue: 0,0:28:16.15,0:28:17.90,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:28:17.98,0:28:20.82,Default,,0,0,0,,А-а, мынау...
Dialogue: 0,0:28:20.90,0:28:24.16,Default,,0,0,0,,Мүмкін бұл сөз әйелдерді мақтау үшін айтылатын шығар?
Dialogue: 0,0:28:24.24,0:28:27.49,Default,,0,0,0,,Иә, менің ойымша, бұл солай.
Dialogue: 0,0:28:27.58,0:28:29.24,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:28:29.33,0:28:31.20,Default,,0,0,0,,Бұл Рионың айтқанын білдіреді...
Dialogue: 0,0:28:31.29,0:28:33.96,Default,,0,0,0,,«Ол тартымды әйел» дегенді қалай түсінесіңдер?
Dialogue: 0,0:28:34.04,0:28:36.33,Default,,0,0,0,,Ол мені мақтап жатыр ма?
Dialogue: 0,0:28:36.42,0:28:38.50,Default,,0,0,0,,Иә, иә, иә.
Dialogue: 0,0:28:38.59,0:28:42.67,Default,,0,0,0,,Онда неге Саэба-сан Каори-санға ашуланбайды?
Dialogue: 0,0:28:42.76,0:28:43.63,Default,,0,0,0,,Сәлем! ?
Dialogue: 0,0:28:43.72,0:28:44.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:28:45.72,0:28:48.60,Default,,0,0,0,,Сонымен… бұл…
Dialogue: 0,0:28:48.68,0:28:50.77,Default,,0,0,0,,Жоқ... бұл жақсы.
Dialogue: 0,0:28:50.85,0:28:52.68,Default,,0,0,0,,Бұл менің өтінішім.
Dialogue: 0,0:28:52.77,0:28:53.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:55.19,0:28:56.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:28:57.15,0:28:59.61,Default,,0,0,0,,...Таку Моккори Идиот!
Dialogue: 0,0:28:59.69,0:29:02.61,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:29:02.69,0:29:03.90,Default,,0,0,0,,-（） -（）～
Dialogue: 0,0:29:03.99,0:29:07.12,Default,,0,0,0,,Қорқынышты! Каору-чан, тоқта!
Dialogue: 0,0:29:07.53,0:29:10.49,Default,,0,0,0,,Мм... екеуің ғашықсыңдар ма?
Dialogue: 0,0:29:10.58,0:29:12.04,Default,,0,0,0,,Әй, солай ма?
Dialogue: 0,0:29:12.12,0:29:13.16,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:29:13.25,0:29:16.62,Default,,0,0,0,,А, жоқ, Саэба-сан мен Каори-сан.
Dialogue: 0,0:29:16.71,0:29:18.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:18.33,0:29:20.84,Default,,0,0,0,,Сол екеуі...
Dialogue: 0,0:29:21.59,0:29:24.63,Default,,0,0,0,,Екеуміз бірге тұрсақ екен деп тілеймін Ухуху...
Dialogue: 0,0:29:24.72,0:29:27.39,Default,,0,0,0,,- (Мики) Біз сияқты - (Умибозу) Эй, ми... Мики
Dialogue: 0,0:29:27.47,0:29:28.89,Default,,0,0,0,,Даба!
Dialogue: 0,0:29:28.97,0:29:30.01,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:29:30.10,0:29:32.02,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:29:32.10,0:29:34.18,Default,,0,0,0,,Бір-біріне жабыспайтын сияқты.
Dialogue: 0,0:29:34.27,0:29:37.15,Default,,0,0,0,,Олардың арасына ешкім кіре алмайды.
Dialogue: 0,0:29:38.48,0:29:39.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:39.48,0:29:40.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:40.61,0:29:42.15,Default,,0,0,0,,Ой...
Dialogue: 0,0:29:42.23,0:29:44.78,Default,,0,0,0,,Ngggggggggg...
Dialogue: 0,0:29:44.86,0:29:45.90,Default,,0,0,0,,Хмф!
Dialogue: 0,0:29:46.36,0:29:48.74,Default,,0,0,0,,Не, сонша қант?
Dialogue: 0,0:29:48.82,0:29:52.29,Default,,0,0,0,,Иә, жақсылап араластырыңыз, мен еттен дәмді картоп жасаймын.
Dialogue: 0,0:29:52.70,0:29:54.08,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:29:54.70,0:29:57.87,Default,,0,0,0,,Кешіріңіз, мистер Энджи, бірақ мына ағаш қасықты сол жаққа апара аласыз ба?
Dialogue: 0,0:29:57.96,0:29:59.00,Default,,0,0,0,,Иә? мм...
Dialogue: 0,0:29:59.08,0:30:01.25,Default,,0,0,0,,Қараңдаршы, мынау ілулі тұр.
Dialogue: 0,0:30:01.34,0:30:03.42,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:30:03.51,0:30:05.09,Default,,0,0,0,,Бұл...?
Dialogue: 0,0:30:05.17,0:30:07.22,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:30:07.30,0:30:08.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:30:08.84,0:30:11.93,Default,,0,0,0,,Жарайды, бұл жерден кетпе.
Dialogue: 0,0:30:12.01,0:30:13.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:13.14,0:30:15.64,Default,,0,0,0,,Егер мұны жасасаңыз, қазір қауіпсіз боласыз.
Dialogue: 0,0:30:18.02,0:30:19.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:30:19.15,0:30:20.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:21.02,0:30:24.03,Default,,0,0,0,,Хмм... Мүмкін мен қантты аздап қосу керек шығар.
Dialogue: 0,0:30:24.11,0:30:25.15,Default,,0,0,0,,Иә
Dialogue: 0,0:30:25.65,0:30:28.03,Default,,0,0,0,,Тағы бір қасық
Dialogue: 0,0:30:28.11,0:30:31.45,Default,,0,0,0,,Бұл менің жапон тағамдарын бірінші рет көруім...
Dialogue: 0,0:30:31.53,0:30:36.45,Default,,0,0,0,,I wonder if I could make it for my father if I could remember at least one thing and go home.
Dialogue: 0,0:30:36.54,0:30:39.08,Default,,0,0,0,,О, бұл тамаша! Бұлай етпе
Dialogue: 0,0:30:39.17,0:30:40.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:40.08,0:30:42.17,Default,,0,0,0,,Мен рецептті кейінірек жазамын.
Dialogue: 0,0:30:42.79,0:30:46.09,Default,,0,0,0,,Meat potatoes are good, but Japanese curry is also delicious.
Dialogue: 0,0:30:46.17,0:30:48.30,Default,,0,0,0,,Материалдар да бірдей дерлік.
Dialogue: 0,0:30:48.38,0:30:49.63,Default,,0,0,0,,Мынадай нәрсе бар ма?
Dialogue: 0,0:30:49.72,0:30:51.59,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:30:53.76,0:30:54.81,Default,,0,0,0,,Каори-сан
Dialogue: 0,0:30:54.89,0:30:55.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:56.85,0:30:59.85,Default,,0,0,0,,Саеба қазір өлтірілсе...
Dialogue: 0,0:30:59.94,0:31:00.98,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:31:01.06,0:31:02.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:03.44,0:31:05.48,Default,,0,0,0,,Ол қала сыпырушы...
Dialogue: 0,0:31:07.32,0:31:08.44,Default,,0,0,0,,Иә...
Dialogue: 0,0:31:08.53,0:31:11.32,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:31:15.41,0:31:16.45,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:31:17.66,0:31:18.96,Default,,0,0,0,,Рё өлмейді
Dialogue: 0,0:31:19.04,0:31:20.08,Default,,0,0,0,,Ха…
Dialogue: 0,0:31:20.79,0:31:23.25,Default,,0,0,0,,Не болды? Энджи
Dialogue: 0,0:31:23.33,0:31:25.75,Default,,0,0,0,,Мұндайды сұрауға қалай дәтің бар?
Dialogue: 0,0:31:26.30,0:31:28.76,Default,,0,0,0,,Мен Рио Саебамын...
Dialogue: 0,0:31:29.67,0:31:32.59,Default,,0,0,0,,Себебі мен Сити аңшысын өлтіруге келдім.
Dialogue: 0,0:31:35.60,0:31:37.47,Default,,0,0,0,,Фуфуфу... хахахаха...
Dialogue: 0,0:31:37.56,0:31:39.23,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:31:39.31,0:31:42.85,Default,,0,0,0,,No, Angie, there's something interesting about it.
Dialogue: 0,0:31:42.94,0:31:46.19,Default,,0,0,0,,I wonder what you're going to say when you're dressed like that...
Dialogue: 0,0:31:46.27,0:31:47.32,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:31:47.40,0:31:51.07,Default,,0,0,0,,No, I thought you were someone who never joked.
Dialogue: 0,0:31:51.15,0:31:53.24,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:31:53.32,0:31:56.91,Default,,0,0,0,,Most of the time, you have to say those lines while holding a knife!
Dialogue: 0,0:31:56.99,0:31:59.08,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:32:01.16,0:32:02.67,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:32:04.63,0:32:06.09,Default,,0,0,0,,Сол қыз...
Dialogue: 0,0:32:06.17,0:32:07.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:07.30,0:32:08.92,Default,,0,0,0,,Анджи...
Dialogue: 0,0:32:09.96,0:32:11.22,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:32:11.67,0:32:14.09,Default,,0,0,0,,Неге екенін білмеймін...
Dialogue: 0,0:32:14.18,0:32:17.72,Default,,0,0,0,,When I looked at her, I remembered my old self.
Dialogue: 0,0:32:18.47,0:32:21.23,Default,,0,0,0,,Бірдеңені іздеп... біреуді...
Dialogue: 0,0:32:22.06,0:32:24.23,Default,,0,0,0,,Жүрегіммен күресіп жатқандай...
Dialogue: 0,0:32:45.38,0:32:46.38,Default,,0,0,0,,Хаха~!
Dialogue: 0,0:32:54.30,0:32:55.34,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:32:56.22,0:32:57.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:32:57.55,0:32:59.85,Default,,0,0,0,,Аноним
Dialogue: 0,0:33:00.39,0:33:03.10,Default,,0,0,0,,Сіз бұзақылық жасадыңыз, солай емес пе?
Dialogue: 0,0:33:03.18,0:33:06.85,Default,,0,0,0,,No matter where we are, we know where we belong.
Dialogue: 0,0:33:06.94,0:33:09.07,Default,,0,0,0,,Ол оны кез келген уақытта өлтіруі мүмкін еді.
Dialogue: 0,0:33:09.15,0:33:10.19,Default,,0,0,0,,Кеше...
Dialogue: 0,0:33:10.27,0:33:13.07,Default,,0,0,0,,Сіздің қолыңыз түтіккен жоқ па? Эспада
Dialogue: 0,0:33:13.15,0:33:15.78,Default,,0,0,0,,Апираркудың кешіріміне қол жеткізе алмаймын.
Dialogue: 0,0:33:15.86,0:33:18.66,Default,,0,0,0,,«Мен сізден естігенше»
Dialogue: 0,0:33:18.74,0:33:21.16,Default,,0,0,0,,Әкім сізге қарап тұр.
Dialogue: 0,0:33:23.00,0:33:25.79,Default,,0,0,0,,Неліктен ол адамның аманатына опасыздық жасадың?
Dialogue: 0,0:33:25.87,0:33:29.46,Default,,0,0,0,,Мен ешқашан әкімге опасыздық жасаған емеспін.
Dialogue: 0,0:33:29.54,0:33:30.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:33:30.46,0:33:33.13,Default,,0,0,0,,Біздің рөліміз қарапайым.
Dialogue: 0,0:33:33.21,0:33:36.84,Default,,0,0,0,,If ordered by Mayor, the head of the organization, carry it out.
Dialogue: 0,0:33:36.93,0:33:39.85,Default,,0,0,0,,Олай болмаса, қозғалудың қажеті жоқ.
Dialogue: 0,0:33:39.93,0:33:42.47,Default,,0,0,0,,Өз еркінің қажеті жоқ
Dialogue: 0,0:33:42.56,0:33:46.56,Default,,0,0,0,,Let me also tell you why you approached City Hunter.
Dialogue: 0,0:33:46.98,0:33:50.48,Default,,0,0,0,,Менің ойымша, мен қазірдің өзінде өшірілетін нысана болдым.
Dialogue: 0,0:33:50.57,0:33:52.07,Default,,0,0,0,,Сұрақтар мен жауаптар пайдасыз болуы керек.
Dialogue: 0,0:33:53.86,0:33:56.74,Default,,0,0,0,,Оған дейін маған Адамды бер.
Dialogue: 0,0:33:57.45,0:33:58.49,Default,,0,0,0,,Бұл...
Dialogue: 0,0:33:59.28,0:34:00.74,Default,,0,0,0,,Қолданбау керек
Dialogue: 0,0:34:00.83,0:34:03.87,Default,,0,0,0,,Union Teope - біздің үйіміз.
Dialogue: 0,0:34:03.95,0:34:05.71,Default,,0,0,0,,Қайтаратын үйім болмаса, жақсы ма?
Dialogue: 0,0:34:06.62,0:34:08.33,Default,,0,0,0,,Әлі де мен—
Dialogue: 0,0:34:08.42,0:34:11.67,Default,,0,0,0,,Басқалардан гөрі әкімге қажет адам болыңыз.
Dialogue: 0,0:34:11.75,0:34:15.34,Default,,0,0,0,,Иа... Ақырында, қиындататын кез келді.
Dialogue: 0,0:34:15.42,0:34:16.63,Default,,0,0,0,,Мм! Ха ха!
Dialogue: 0,0:34:19.97,0:34:20.85,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:34:21.43,0:34:22.35,Default,,0,0,0,,ал күнделікті шығындарға қалған ақшаны алыстағы туысы жымқырып кетті
Dialogue: 0,0:34:23.22,0:34:24.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:29.02,0:34:30.56,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:34:30.65,0:34:31.86,Default,,0,0,0,,Уууу…
Dialogue: 0,0:34:32.40,0:34:33.86,Default,,0,0,0,,Ннн…
Dialogue: 0,0:34:33.94,0:34:37.24,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:34:37.90,0:34:38.95,Default,,0,0,0,,Ха…
Dialogue: 0,0:34:39.03,0:34:40.57,Default,,0,0,0,,А... хаха!
Dialogue: 0,0:34:42.33,0:34:44.16,Default,,0,0,0,,Ах! Уууу...
Dialogue: 0,0:34:44.24,0:34:45.95,Default,,0,0,0,,- (Pirarucu) Анонимо - (Энджи) Бақыт...
Dialogue: 0,0:34:46.04,0:34:50.88,Default,,0,0,0,,Сіз жақсы жалдамалысыз, бірақ тек бұйрықпен.
Dialogue: 0,0:34:50.96,0:34:54.92,Default,,0,0,0,,Ағымдағы әрекеттер дұрыс пайымдауға негізделмеген.
Dialogue: 0,0:34:55.00,0:34:56.46,Default,,0,0,0,,Адамды тапсыр
Dialogue: 0,0:34:56.55,0:35:00.68,Default,,0,0,0,,Біз періште шаңының бастапқы күшін қайта аламыз.
Dialogue: 0,0:35:02.72,0:35:03.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:10.31,0:35:13.61,Default,,0,0,0,,Ұлы державалар бір-бірімен соғысса, дүние жойылады.
Dialogue: 0,0:35:13.69,0:35:15.69,Default,,0,0,0,,Ең жақсысы - қастандық.
Dialogue: 0,0:35:16.11,0:35:19.61,Default,,0,0,0,,Оны кез келген жағдайда орындау үшін—
Dialogue: 0,0:35:19.70,0:35:21.32,Default,,0,0,0,,Адам керек
Dialogue: 0,0:35:21.41,0:35:24.37,Default,,0,0,0,,Бұл бір күні бәрін жояды
Dialogue: 0,0:35:24.45,0:35:25.49,Default,,0,0,0,,Мэр
Dialogue: 0,0:35:25.58,0:35:26.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:35:26.79,0:35:29.29,Default,,0,0,0,,Соғыс өзгерсе, ұйым мен әкім...
Dialogue: 0,0:35:29.37,0:35:32.21,Default,,0,0,0,,Бізге керегі періште шаңы емес.
Dialogue: 0,0:35:33.17,0:35:34.59,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:35:35.04,0:35:36.09,Default,,0,0,0,,Я...
Dialogue: 0,0:35:36.71,0:35:39.59,Default,,0,0,0,,Itte... Ah...
Dialogue: 0,0:35:39.67,0:35:40.72,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:35:40.80,0:35:42.84,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:35:43.43,0:35:46.10,Default,,0,0,0,,Періште Шаң және әлгі адам...
Dialogue: 0,0:35:46.18,0:35:47.64,Default,,0,0,0,,Әкім ауысты
Dialogue: 0,0:35:47.72,0:35:48.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:35:50.06,0:35:50.94,Default,,0,0,0,,Ооо... Ааа...
Dialogue: 0,0:35:51.02,0:35:55.77,Default,,0,0,0,,Кезінде жанжалды реттеп, революцияға көмектескен!
Dialogue: 0,0:35:58.15,0:35:59.57,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:35:59.99,0:36:02.36,Default,,0,0,0,,Ол адамнан асып түс!
Dialogue: 0,0:36:05.45,0:36:06.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:10.00,0:36:11.12,Default,,0,0,0,,Ннн!
Dialogue: 0,0:36:13.83,0:36:14.67,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:36:14.75,0:36:15.67,Default,,0,0,0,,Уууу…
Dialogue: 0,0:36:23.05,0:36:24.68,Default,,0,0,0,,А... ха...
Dialogue: 0,0:36:28.97,0:36:30.02,Default,,0,0,0,,Фу…
Dialogue: 0,0:36:31.10,0:36:32.44,Default,,0,0,0,,Уф!
Dialogue: 0,0:36:35.98,0:36:40.94,Default,,0,0,0,,(Энджидің ыңырсыуы)
Dialogue: 0,0:36:41.03,0:36:42.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:53.12,0:36:54.17,Default,,0,0,0,,Саеба…
Dialogue: 0,0:36:54.25,0:36:57.08,Default,,0,0,0,,Менің сөйлескенімді естідің.
Dialogue: 0,0:36:57.17,0:36:59.50,Default,,0,0,0,,Пех! Қалалық аңшы?
Dialogue: 0,0:36:59.59,0:37:00.42,Default,,0,0,0,,Ахх...
Dialogue: 0,0:37:00.50,0:37:02.13,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:37:05.64,0:37:07.09,Default,,0,0,0,,Уф! Ахх...
Dialogue: 0,0:37:08.18,0:37:09.06,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:37:12.89,0:37:14.31,Default,,0,0,0,,Уф! Уууу...
Dialogue: 0,0:37:15.73,0:37:16.81,Default,,0,0,0,,Уууу…
Dialogue: 0,0:37:17.48,0:37:19.36,Default,,0,0,0,,Әлі де олай емес...
Dialogue: 0,0:37:19.44,0:37:22.11,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:37:22.19,0:37:25.74,Default,,0,0,0,,А... Ннн...
Dialogue: 0,0:37:27.78,0:37:28.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:31.83,0:37:32.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:32.87,0:37:34.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:36.00,0:37:36.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:39.09,0:37:42.13,Default,,0,0,0,,Оны бейнеге түсіру тым көп емес пе?
Dialogue: 0,0:37:42.21,0:37:43.42,Default,,0,0,0,,Маған көмек керек емес
Dialogue: 0,0:37:44.05,0:37:46.38,Default,,0,0,0,,Маған телефон соққан сен едің ғой?
Dialogue: 0,0:37:46.84,0:37:48.14,Default,,0,0,0,,Рио Саеба…
Dialogue: 0,0:37:48.22,0:37:51.39,Default,,0,0,0,,Мен жеңетін соңғы адам сенсің.
Dialogue: 0,0:37:52.06,0:37:53.89,Default,,0,0,0,,Сіз өзіңіздің шынайы бетіңізді ақыры көрсеттіңіз.
Dialogue: 0,0:37:53.98,0:37:55.69,Default,,0,0,0,,Espada арқылы жүгіріңіз
Dialogue: 0,0:37:55.77,0:37:57.35,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:37:57.44,0:37:59.61,Default,,0,0,0,,Сіз ойлағандай таяз емес
Dialogue: 0,0:37:59.69,0:38:01.36,Default,,0,0,0,,Оны тез емдеңіз.
Dialogue: 0,0:38:02.90,0:38:06.53,Default,,0,0,0,,Фуфу…
Dialogue: 0,0:38:06.61,0:38:09.49,Default,,0,0,0,,Tsk! Есіңізде болсын!
Dialogue: 0,0:38:12.66,0:38:15.58,Default,,0,0,0,,«Есте сақтау» нені білдіреді? ол
Dialogue: 0,0:38:15.66,0:38:19.75,Default,,0,0,0,,Не? Жоқ, мен бірдеңе айтуым керек сияқты.
Dialogue: 0,0:38:22.84,0:38:24.34,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:38:24.42,0:38:26.92,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа ххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххх булы?
Dialogue: 0,0:38:27.01,0:38:28.76,Default,,0,0,0,,- (Pirarucu) міну - (Эспада) А...
Dialogue: 0,0:38:33.93,0:38:35.27,Default,,0,0,0,,Сіз оны қашан байқадыңыз?
Dialogue: 0,0:38:36.10,0:38:39.35,Default,,0,0,0,,Золтиктің төбесінде сенімен шайқасқан мен едім.
Dialogue: 0,0:38:39.44,0:38:41.65,Default,,0,0,0,,Ах, мм...
Dialogue: 0,0:38:41.73,0:38:43.98,Default,,0,0,0,,Мен сенің бөксеңді бірінші рет ұстадым
Dialogue: 0,0:38:44.44,0:38:49.32,Default,,0,0,0,,Керемет еті бар толық жамбасқа оралған тамаша gluteus maximus.
Dialogue: 0,0:38:49.41,0:38:51.82,Default,,0,0,0,,Мен де сол кездегідей сезімде болдым.
Dialogue: 0,0:38:51.91,0:38:53.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:53.24,0:38:56.37,Default,,0,0,0,,Ал белдің тарлығы...
Dialogue: 0,0:38:56.45,0:38:59.21,Default,,0,0,0,,Сондай-ақ, әлсіз жағымды хош иіс
Dialogue: 0,0:38:59.29,0:39:00.71,Default,,0,0,0,,бұл... басынан бастап...
Dialogue: 0,0:39:00.79,0:39:01.83,Default,,0,0,0,,Әрине!
Dialogue: 0,0:39:01.92,0:39:05.55,Default,,0,0,0,,Бейне продюсер болу уақытша ғана нәрсе екені де рас.
Dialogue: 0,0:39:05.63,0:39:09.18,Default,,0,0,0,,Фотоның 3D мысық екенін бірден түсіндім.
Dialogue: 0,0:39:09.26,0:39:10.80,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:39:10.89,0:39:13.05,Default,,0,0,0,,Сізде ештеңе жоқ, солай ма?
Dialogue: 0,0:39:13.14,0:39:16.52,Default,,0,0,0,,Сендей сұлудың кекін қай кезде таптым?
Dialogue: 0,0:39:16.60,0:39:17.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:39:17.52,0:39:21.77,Default,,0,0,0,,Екеуміз ешқашан кездеспегенімізге қарамастан, сенің маған ренішің бар шығар?
Dialogue: 0,0:39:23.23,0:39:25.32,Default,,0,0,0,,Қалай болғанда да, мен сізге алғыс айтқым келеді.
Dialogue: 0,0:39:27.32,0:39:31.07,Default,,0,0,0,,Қалалық аңшыны өлтіру арқылы кім өзінің атын шығарғысы келеді?
Dialogue: 0,0:39:31.16,0:39:33.16,Default,,0,0,0,,Олардың көптігі сонша, оларды сыпырып, лақтырып тастауға болады.
Dialogue: 0,0:39:33.78,0:39:38.04,Default,,0,0,0,,Егер сен солардың бірі болсаң, мен сені тоқтатпаймын.
Dialogue: 0,0:39:38.12,0:39:41.29,Default,,0,0,0,,Олар сені өлтіргенше соңынан ереді.
Dialogue: 0,0:39:41.37,0:39:43.92,Default,,0,0,0,,Оларды жеңсең, басқа қуғыншы келеді.
Dialogue: 0,0:39:44.00,0:39:46.34,Default,,0,0,0,,Бұл жер асты әлемінің ережесі.
Dialogue: 0,0:39:46.42,0:39:48.55,Default,,0,0,0,,Барлығын өз қолыңмен жең
Dialogue: 0,0:39:48.63,0:39:51.38,Default,,0,0,0,,Саеба Рё, сен де.
Dialogue: 0,0:39:53.80,0:39:56.22,Default,,0,0,0,,Барып, көңіл көтергіңіз келе ме?
Dialogue: 0,0:39:56.31,0:39:57.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:57.72,0:40:00.60,Default,,0,0,0,,Сіз өмір сүрген әлемде не жетіспейді?
Dialogue: 0,0:40:00.68,0:40:02.73,Default,,0,0,0,,Мұнда көп нәрсе бар
Dialogue: 0,0:40:04.44,0:40:06.90,Default,,0,0,0,,Сіз менің клиентімсіз.
Dialogue: 0,0:40:06.98,0:40:09.19,Default,,0,0,0,,Шартты соңына дейін сақтаңыз
Dialogue: 0,0:40:09.28,0:40:10.32,Default,,0,0,0,,Уф…
Dialogue: 0,0:40:11.07,0:40:12.11,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:40:13.11,0:40:14.16,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:40:16.49,0:40:17.99,Default,,0,0,0,,Энджи!
Dialogue: 0,0:40:18.08,0:40:20.04,Default,,0,0,0,,Амансың ба? Жақсы болды ма?
Dialogue: 0,0:40:21.12,0:40:24.04,Default,,0,0,0,,-（）  -（）
Dialogue: 0,0:40:24.13,0:40:26.54,Default,,0,0,0,,Әтеш!
Dialogue: 0,0:40:30.51,0:40:33.30,Default,,0,0,0,,Жарайды, ауырады ма? (қайшының дыбысы)
Dialogue: 0,0:40:33.38,0:40:35.09,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:40:35.18,0:40:36.22,Default,,0,0,0,,Я...
Dialogue: 0,0:40:37.01,0:40:38.06,Default,,0,0,0,,Фу…
Dialogue: 0,0:40:41.85,0:40:44.10,Default,,0,0,0,,Мақсаттардың саны артты.
Dialogue: 0,0:40:45.35,0:40:47.73,Default,,0,0,0,,Сіз City Hunter туралы айтып отырсыз ба?
Dialogue: 0,0:40:47.82,0:40:51.82,Default,,0,0,0,,«Кедергі жасайтындарды жою» - әкімнің еркі.
Dialogue: 0,0:40:52.32,0:40:53.90,Default,,0,0,0,,Ешқандай ерекшелік жоқ.
Dialogue: 0,0:40:54.36,0:40:55.95,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:40:56.03,0:40:57.16,Default,,0,0,0,,Құлықсыз
Dialogue: 0,0:40:57.24,0:40:58.87,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:40:58.95,0:41:00.49,Default,,0,0,0,,Бұл Анонимо туралы.
Dialogue: 0,0:41:00.87,0:41:03.83,Default,,0,0,0,,Егер біз мұны жасамасақ, біз жойыламыз.
Dialogue: 0,0:41:03.91,0:41:06.67,Default,,0,0,0,,Аға-іні болып өскендіктен бе?
Dialogue: 0,0:41:08.04,0:41:11.13,Default,,0,0,0,,Хан... Орындалса екен.
Dialogue: 0,0:41:11.21,0:41:14.38,Default,,0,0,0,,Мен өзімді үнемі ыңғайсыз сезіне алмадым.
Dialogue: 0,0:41:17.14,0:41:20.85,Default,,0,0,0,,Бұл әйел ешқашан мұны қолдануға тырыспайды.
Dialogue: 0,0:41:20.93,0:41:22.64,Default,,0,0,0,,Бірақ бәрінен де көп...
Dialogue: 0,0:41:24.10,0:41:26.15,Default,,0,0,0,,Таяу Шығыста болғанда—
Dialogue: 0,0:41:26.23,0:41:28.36,Default,,0,0,0,,Ол сені де құтқарды.
Dialogue: 0,0:41:30.44,0:41:32.69,Default,,0,0,0,,Біз «Ылғалды жұмыстармыз»
Dialogue: 0,0:41:33.15,0:41:35.99,Default,,0,0,0,,Арнайы қастандық миссияларын орындаңыз -
Dialogue: 0,0:41:36.07,0:41:39.37,Default,,0,0,0,,Әкім бар болғаны үш адамнан тұратын команданы таңдады.
Dialogue: 0,0:41:40.45,0:41:41.49,Default,,0,0,0,,Хмм…
Dialogue: 0,0:41:42.62,0:41:46.71,Default,,0,0,0,,Мен сол жерде қиналғанда, осы жігіттің арқасында аман қалдым.
Dialogue: 0,0:41:46.79,0:41:48.46,Default,,0,0,0,,Бұл бірінші рет болды.
Dialogue: 0,0:41:49.17,0:41:52.55,Default,,0,0,0,,Сіз өлімші жарақат алсаңыз да билей аласыз.
Dialogue: 0,0:41:52.63,0:41:55.01,Default,,0,0,0,,Бұл тура мағынасында бойтұмар.
Dialogue: 0,0:41:59.80,0:42:00.85,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:42:00.93,0:42:02.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:02.35,0:42:03.39,Default,,0,0,0,,（）
Dialogue: 0,0:42:03.47,0:42:06.35,Default,,0,0,0,,Иә? Бұл сізге ұнайтын адам емес пе?
Dialogue: 0,0:42:07.10,0:42:08.81,Default,,0,0,0,,Сізге де ұнауы мүмкін.
Dialogue: 0,0:42:09.77,0:42:10.81,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:42:13.03,0:42:15.69,Default,,0,0,0,,Көп ішпе, жараңды ауыртады.
Dialogue: 0,0:42:15.78,0:42:17.95,Default,,0,0,0,,Онда мен оны ішпес едім!
Dialogue: 0,0:42:18.70,0:42:20.95,Default,,0,0,0,,Бұл түсінбеушілік!
Dialogue: 0,0:42:21.49,0:42:23.62,Default,,0,0,0,,Рё-чан, мен ештеңе істеген жоқпын.
Dialogue: 0,0:42:23.70,0:42:25.20,Default,,0,0,0,,Бұл жағымсыз.
Dialogue: 0,0:42:25.29,0:42:27.08,Default,,0,0,0,,Ол парамен ұсталатын еді.
Dialogue: 0,0:42:27.62,0:42:31.25,Default,,0,0,0,,...Бірақ қазіргі жағдайды мен ғана түсінбеймін.
Dialogue: 0,0:42:31.34,0:42:33.25,Default,,0,0,0,,...
Dialogue: 0,0:42:33.34,0:42:37.97,Default,,0,0,0,,Сондықтан Энджидің өмірін жұмбақ ұйым нысанаға алады.
Dialogue: 0,0:42:38.05,0:42:39.84,Default,,0,0,0,,Біз оны қорғаймыз
Dialogue: 0,0:42:39.93,0:42:41.51,Default,,0,0,0,,Бұл сұраудың түрі, солай ма?
Dialogue: 0,0:42:41.60,0:42:44.60,Default,,0,0,0,,Менің бірінші өтінішім мысық табу болды.
Dialogue: 0,0:42:44.68,0:42:48.81,Default,,0,0,0,,Мен олардың келуін күтіп демімді басып тұрмын.
Dialogue: 0,0:42:48.89,0:42:53.19,Default,,0,0,0,,Көпшілікте бұл қауіпсіз, сондықтан кездесуге барайық...
Dialogue: 0,0:42:53.27,0:42:56.19,Default,,0,0,0,,Бұл жүзімен де, бұл сенімді емес.
Dialogue: 0,0:42:56.28,0:42:59.45,Default,,0,0,0,,Мен Энджидің мұндай күшті екенін естіген емеспін.
Dialogue: 0,0:43:01.37,0:43:06.16,Default,,0,0,0,,Бұл өлтірушілер тым адамгершілікке жатпайды ма?
Dialogue: 0,0:43:06.25,0:43:07.29,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:43:07.37,0:43:09.87,Default,,0,0,0,,Аспан асты елінде мұндай адамдар бар...
Dialogue: 0,0:43:09.96,0:43:11.17,Default,,0,0,0,,Сенің жұлының далаға лақтырылып, шіріп кетті, тіпті шыбындар да тимейді—
Dialogue: 0,0:43:11.25,0:43:13.00,Default,,0,0,0,,Эй, Каору-кун, тоқта!
Dialogue: 0,0:43:13.09,0:43:15.25,Default,,0,0,0,,Сіз бірдеңені жасырып отырсыз.
Dialogue: 0,0:43:15.34,0:43:16.67,Default,,0,0,0,,Айт!
Dialogue: 0,0:43:16.76,0:43:19.34,Default,,0,0,0,,Қауіпті, қауіпті! Мен алда не күтіп тұрғанын көре алмаймын!
Dialogue: 0,0:43:20.09,0:43:21.14,Default,,0,0,0,,Хмм…
Dialogue: 0,0:43:21.76,0:43:23.89,Default,,0,0,0,,О, сондай...
Dialogue: 0,0:45:03.45,0:45:05.24,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:45:05.32,0:45:08.45,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:45:09.03,0:45:13.16,Default,,0,0,0,,Banagher Links Unicorn Gundam Кеттік!
Dialogue: 0,0:45:13.75,0:45:15.04,Default,,0,0,0,,Гува~
Dialogue: 0,0:45:16.58,0:45:19.25,Default,,0,0,0,,Сіз ғана құлайсыз!
Dialogue: 0,0:45:19.34,0:45:21.55,Default,,0,0,0,,Оны тастамаңыз!
Dialogue: 0,0:45:23.92,0:45:25.88,Default,,0,0,0,,Уф…
Dialogue: 0,0:45:26.64,0:45:28.80,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:45:40.32,0:45:41.98,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:45:42.40,0:45:45.82,Default,,0,0,0,,...Олар мұны істеп көңілді болды.
Dialogue: 0,0:45:47.24,0:45:49.78,Default,,0,0,0,,Көпшілікте адасып кету қалыпты жағдай.
Dialogue: 0,0:45:49.87,0:45:50.91,Default,,0,0,0,,Ол өседі
Dialogue: 0,0:45:50.99,0:45:52.33,Default,,0,0,0,,О
Dialogue: 0,0:45:54.16,0:45:55.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:57.58,0:45:58.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:59.04,0:46:00.79,Default,,0,0,0,,Әзірге қозғалыс жоқ.
Dialogue: 0,0:46:00.88,0:46:04.76,Default,,0,0,0,,Сіз Жапонияға дейін келген соң, неге ең болмаса суши жемейсіз?
Dialogue: 0,0:46:04.84,0:46:06.55,Default,,0,0,0,,Жұмыс аяқталғаннан кейін
Dialogue: 0,0:46:06.93,0:46:09.89,Default,,0,0,0,,Сіз маған бірдеңе жеуімді сұрап тұрсыз ба?
Dialogue: 0,0:46:11.22,0:46:12.47,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:46:12.56,0:46:14.18,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:46:15.81,0:46:17.31,Default,,0,0,0,,Жапония туралы айту—
Dialogue: 0,0:46:17.39,0:46:20.77,Default,,0,0,0,,Жапон автомобильдері ескі болса да жақсы жанармай үнемдейді.
Dialogue: 0,0:46:20.86,0:46:25.36,Default,,0,0,0,,Мэр жапондық заттар неғұрлым ескі болса, соғұрлым жақсы деді.
Dialogue: 0,0:46:25.44,0:46:27.24,Default,,0,0,0,,Бірақ бұл өте тар.
Dialogue: 0,0:46:27.32,0:46:29.62,Default,,0,0,0,,Сен екеуміз тұншығып жатырмыз.
Dialogue: 0,0:46:29.70,0:46:31.83,Default,,0,0,0,,Біз өзара.
Dialogue: 0,0:46:31.91,0:46:32.99,Default,,0,0,0,,Онда бір нәрсе бар.
Dialogue: 0,0:46:33.87,0:46:34.91,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:46:40.63,0:46:41.75,Default,,0,0,0,,...
Dialogue: 0,0:46:41.84,0:46:43.80,Default,,0,0,0,,Осы уақыттағы менің көмекші жұмысым...
Dialogue: 0,0:46:43.88,0:46:44.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:44.80,0:46:48.80,Default,,0,0,0,,Үш апалы-сіңлілі Моккори өнер жинайды деген өтірік.
Dialogue: 0,0:46:49.22,0:46:53.10,Default,,0,0,0,,Мен Red Pegasus схемасын бұзуға тырыстым, бірақ...
Dialogue: 0,0:46:53.89,0:46:55.72,Default,,0,0,0,,Қызыл Пегас...
Dialogue: 0,0:46:55.81,0:46:56.93,Default,,0,0,0,,Менің ағам...
Dialogue: 0,0:46:58.52,0:46:59.77,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:46:59.85,0:47:04.15,Default,,0,0,0,,Бұл есімді естігенде ренжіп қаламын деп ойладың ба?
Dialogue: 0,0:47:04.23,0:47:06.69,Default,,0,0,0,,Бірақ бұл сіз естігіңіз келетін есім емес пе?
Dialogue: 0,0:47:06.78,0:47:07.99,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:47:08.70,0:47:09.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:47:09.91,0:47:13.16,Default,,0,0,0,,Сонымен? Сен Энджимен жекпе-жекке шығасың ба?
Dialogue: 0,0:47:15.74,0:47:17.83,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:47:17.91,0:47:18.96,Default,,0,0,0,,О
Dialogue: 0,0:47:19.04,0:47:24.00,Default,,0,0,0,,Red Pegasus-тың жоғары ұйымының қолына түскелі тұрған технология.
Dialogue: 0,0:47:24.09,0:47:27.63,Default,,0,0,0,,Ол ұйымның мүшесі болды және оны алып кетті.
Dialogue: 0,0:47:28.80,0:47:30.13,Default,,0,0,0,,​​Не үшін?
Dialogue: 0,0:47:31.26,0:47:32.64,Default,,0,0,0,,Бұл...
Dialogue: 0,0:47:33.18,0:47:36.47,Default,,0,0,0,,Бұл адамды адамгершілігінен кем етеді.
Dialogue: 0,0:47:52.53,0:47:53.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:57.12,0:47:58.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:59.83,0:48:05.38,Default,,0,0,0,,(қыз жылап жатыр)
Dialogue: 0,0:48:05.46,0:48:08.34,Default,,0,0,0,,Ана... қайда?
Dialogue: 0,0:48:08.42,0:48:11.34,Default,,0,0,0,,(қыз жылап жатыр)
Dialogue: 0,0:48:17.51,0:48:18.81,Default,,0,0,0,,Ха…
Dialogue: 0,0:48:20.27,0:48:23.19,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:48:25.56,0:48:30.49,Default,,0,0,0,,(қыз жылап жатыр)
Dialogue: 0,0:48:30.57,0:48:34.28,Default,,0,0,0,,(қыз жылап жатыр)
Dialogue: 0,0:48:34.36,0:48:36.78,Default,,0,0,0,,Каору жіберген фотосуреттер мен—
Dialogue: 0,0:48:36.87,0:48:39.54,Default,,0,0,0,,Мен елге кірген кездегі бейнежазбаларды тексере алдым.
Dialogue: 0,0:48:39.62,0:48:42.66,Default,,0,0,0,,Жазба иммиграциялық кеңседе тексерілуде.
Dialogue: 0,0:48:42.75,0:48:45.54,Default,,0,0,0,,Шығудың жалғыз жолы – теңіз.
Dialogue: 0,0:48:45.63,0:48:49.46,Default,,0,0,0,,Мен бұл мәселені өзім шешкім келді, бірақ...
Dialogue: 0,0:48:49.55,0:48:51.76,Default,,0,0,0,,Мен көп араластым.
Dialogue: 0,0:48:52.55,0:48:55.84,Default,,0,0,0,,Біреу солай істемек болса, менің атқа мінуден басқа амалым жоқ.
Dialogue: 0,0:48:55.93,0:48:59.18,Default,,0,0,0,,Бірақ мен оның мен қалағандай аяқталуына жол бермеймін.
Dialogue: 0,0:49:01.68,0:49:06.15,Default,,0,0,0,,Мен оны қуғыншыларды тойтару үшін қолдануға әлі кеш емес деп ойлаймын...
Dialogue: 0,0:49:06.23,0:49:08.48,Default,,0,0,0,,Мен сені енді танымаймын.
Dialogue: 0,0:49:08.57,0:49:10.23,Default,,0,0,0,,Мен бұлай айтқым келген жоқ
Dialogue: 0,0:49:10.73,0:49:14.03,Default,,0,0,0,,Бұл питон сізге тым ауыр емес пе?
Dialogue: 0,0:49:14.40,0:49:17.99,Default,,0,0,0,,Мен сені мына мылтықпен өлтіруім керек.
Dialogue: 0,0:49:18.08,0:49:20.83,Default,,0,0,0,,Шедевр екенін дәлелдеу
Dialogue: 0,0:49:23.08,0:49:24.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:26.88,0:49:27.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:28.75,0:49:32.17,Default,,0,0,0,,Бұл кім үшін жақсы?
Dialogue: 0,0:49:32.26,0:49:33.47,Default,,0,0,0,,Ха…
Dialogue: 0,0:49:36.22,0:49:39.72,Default,,0,0,0,,Қайбара Шын... Ол менің әкем.
Dialogue: 0,0:49:39.81,0:49:42.02,Default,,0,0,0,,Ол да сенің әкең.
Dialogue: 0,0:49:42.10,0:49:43.81,Default,,0,0,0,,Менен сұрасаңыз—
Dialogue: 0,0:49:43.89,0:49:48.27,Default,,0,0,0,,Сіз өзіңіз сияқты ең жақсы әйелсіз.
Dialogue: 0,0:49:48.94,0:49:52.11,Default,,0,0,0,,Менің әкем қойған есім жоқ.
Dialogue: 0,0:49:54.19,0:49:55.07,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:49:55.32,0:49:58.57,Default,,0,0,0,,Сонымен Аноним... «Анонимді»?
Dialogue: 0,0:49:59.16,0:50:00.66,Default,,0,0,0,,Айналамдағылар солай атайды.
Dialogue: 0,0:50:03.62,0:50:04.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:06.50,0:50:07.79,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:50:10.00,0:50:12.30,Default,,0,0,0,,Маған қамқор болғандарыңызға рахмет.
Dialogue: 0,0:50:12.38,0:50:14.55,Default,,0,0,0,,Саебаға мұндай нәрсе ұнайды, солай ма?
Dialogue: 0,0:50:15.97,0:50:17.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:17.09,0:50:18.76,Default,,0,0,0,,Бұл сүйкімді
Dialogue: 0,0:50:18.84,0:50:21.60,Default,,0,0,0,,Мен бұл туралы ешқашан ойламаппын, білмедім.
Dialogue: 0,0:50:22.97,0:50:24.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:26.18,0:50:28.73,Default,,0,0,0,,Каорудан оны киюін сұраңыз.
Dialogue: 0,0:50:28.81,0:50:30.73,Default,,0,0,0,,Және ренжімеңіз
Dialogue: 0,0:50:30.81,0:50:31.65,Default,,0,0,0,,Ннн…
Dialogue: 0,0:50:31.73,0:50:33.82,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:50:33.90,0:50:35.74,Default,,0,0,0,,Неге Рионы өлтіргің келеді?
Dialogue: 0,0:50:36.24,0:50:39.11,Default,,0,0,0,,…
Dialogue: 0,0:50:39.61,0:50:41.58,Default,,0,0,0,,Мен сені ешқашан кездестірмедім, бірақ...
Dialogue: 0,0:50:42.24,0:50:44.54,Default,,0,0,0,,Бір адамды біл
Dialogue: 0,0:50:44.62,0:50:45.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:45.75,0:50:48.75,Default,,0,0,0,,Келесі жолы сен де, Рио Саеба.
Dialogue: 0,0:50:50.46,0:50:51.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:51.88,0:50:53.92,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:50:54.00,0:50:54.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:54.92,0:50:59.30,Default,,0,0,0,,Маған Энджидің кигені ұнайды~
Dialogue: 0,0:50:59.38,0:51:02.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:02.89,0:51:06.14,Default,,0,0,0,,Бұл ең маңызды оқиға!
Dialogue: 0,0:51:06.73,0:51:07.77,Default,,0,0,0,,Ғафу!
Dialogue: 0,0:51:09.39,0:51:11.02,Default,,0,0,0,,- (Энджи) А, а... - (Тәтті түтін) Ах!
Dialogue: 0,0:51:11.10,0:51:12.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:14.11,0:51:16.65,Default,,0,0,0,,Noooo!
Dialogue: 0,0:51:16.74,0:51:18.40,Default,,0,0,0,,Нһ... нһ!
Dialogue: 0,0:51:19.03,0:51:20.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:20.86,0:51:21.74,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:51:22.24,0:51:24.53,Default,,0,0,0,,Фааа... Хидео Анджи-чан!
Dialogue: 0,0:51:24.62,0:51:28.29,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:51:28.37,0:51:29.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:29.62,0:51:30.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:31.04,0:51:32.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:32.17,0:51:33.38,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:51:33.46,0:51:35.13,Default,,0,0,0,,Уау! Ннн...
Dialogue: 0,0:51:35.21,0:51:38.05,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:51:38.13,0:51:39.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:39.55,0:51:40.59,Default,,0,0,0,,Үлкен...
Dialogue: 0,0:51:43.68,0:51:46.10,Default,,0,0,0,,(кептіргіш дыбысы)
Dialogue: 0,0:51:46.64,0:51:50.23,Default,,0,0,0,,Оның бұл сөздерді айтқысы келгеніне сене алар емеспін...
Dialogue: 0,0:51:51.77,0:51:53.02,Default,,0,0,0,,Менде жағымсыз сезім бар...
Dialogue: 0,0:51:57.07,0:51:59.44,Default,,0,0,0,,Хе... Қызық, ол қандай ванна?
Dialogue: 0,0:51:59.53,0:52:00.57,Default,,0,0,0,,Эй?
Dialogue: 0,0:52:00.65,0:52:02.16,Default,,0,0,0,,Оны асыға күтемін...
Dialogue: 0,0:52:03.41,0:52:05.08,Default,,0,0,0,,Ммм... Нмм...
Dialogue: 0,0:52:08.16,0:52:10.75,Default,,0,0,0,,Гуфуфуфуфу…
Dialogue: 0,0:52:10.83,0:52:12.21,Default,,0,0,0,,Джи...
Dialogue: 0,0:52:13.04,0:52:14.88,Default,,0,0,0,,Мүлікті бүлдіруді тоқтатыңыз!
Dialogue: 0,0:52:15.29,0:52:16.55,Default,,0,0,0,,Ғафу! Уф...
Dialogue: 0,0:52:16.63,0:52:19.46,Default,,0,0,0,,(шаш кептіргіш дыбысы)
Dialogue: 0,0:52:19.55,0:52:21.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:21.72,0:52:23.26,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:52:23.34,0:52:26.26,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:52:26.35,0:52:28.72,Default,,0,0,0,,(шу)
Dialogue: 0,0:52:28.81,0:52:30.02,Default,,0,0,0,,Не! ? бұл адам
Dialogue: 0,0:52:30.10,0:52:31.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:31.56,0:52:34.48,Default,,0,0,0,,Энджи, сен қайда бардың?
Dialogue: 0,0:52:35.23,0:52:36.40,Default,,0,0,0,,Мохимохи?
Dialogue: 0,0:52:39.03,0:52:42.86,Default,,0,0,0,,The Tokyo Bay Maritime Transportation Center's system was hacked.
Dialogue: 0,0:52:43.70,0:52:45.82,Default,,0,0,0,,Union Teope кемесі портқа кірсін.
Dialogue: 0,0:52:46.45,0:52:48.99,Default,,0,0,0,,Мен Адамды тапсырамын.
Dialogue: 0,0:52:49.91,0:52:52.62,Default,,0,0,0,,Three people have been confirmed to have entered the country.
Dialogue: 0,0:52:52.71,0:52:54.08,Default,,0,0,0,,Біреуі – әйел
Dialogue: 0,0:52:54.17,0:52:55.83,Default,,0,0,0,,Мүмкін жер асты әлемінде—
Dialogue: 0,0:52:55.92,0:52:59.25,Default,,0,0,0,,Ылғалды жұмыстар деп аталатын қастандық тобы
Dialogue: 0,0:52:59.34,0:53:03.80,Default,,0,0,0,,Ондаған VIP-ті өлтірді деп есептеледі.
Dialogue: 0,0:53:04.26,0:53:06.43,Default,,0,0,0,,Адамды ұстап тұруды ұмытпаңыз
Dialogue: 0,0:53:06.51,0:53:08.01,Default,,0,0,0,,Мен заттай дәлелдеуді қалаймын.
Dialogue: 0,0:53:08.10,0:53:09.68,Default,,0,0,0,,Ә, қысқа үзіліс жасайық па?
Dialogue: 0,0:53:15.85,0:53:17.56,Default,,0,0,0,,Түннің осы уақытында қайда барасың?
Dialogue: 0,0:53:17.65,0:53:19.27,Default,,0,0,0,,Дәлелдердің бәрі бар.
Dialogue: 0,0:53:19.36,0:53:20.94,Default,,0,0,0,,Дәлелдеме?
Dialogue: 0,0:53:21.03,0:53:23.61,Default,,0,0,0,,Сіздің әпкеңіз заңсыз тергеуде тапқан дәлелдер...
Dialogue: 0,0:53:23.70,0:53:26.32,Default,,0,0,0,,Дәлел ретінде бұл не? аа! ?
Dialogue: 0,0:53:26.82,0:53:29.03,Default,,0,0,0,,Бұл не? ? сол көзқарас
Dialogue: 0,0:53:29.53,0:53:31.16,Default,,0,0,0,,Оны сәл өзгертейік.
Dialogue: 0,0:53:31.87,0:53:32.91,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:53:33.41,0:53:34.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:39.29,0:53:41.05,Default,,0,0,0,,Сіз тым жылдам жүрдіңіз.
Dialogue: 0,0:53:41.13,0:53:43.09,Default,,0,0,0,,Әдіс те аздап өрескел
Dialogue: 0,0:53:43.17,0:53:44.93,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:53:45.01,0:53:48.30,Default,,0,0,0,,Адал болсаң, шындық ашылмайды.
Dialogue: 0,0:53:48.68,0:53:54.18,Default,,0,0,0,,Полиция ұйымдары мен заңдарының әлсіздігі мен шектеулерін басқа жолдармен жеңуге болады.
Dialogue: 0,0:53:54.27,0:53:55.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:55.60,0:53:57.98,Default,,0,0,0,,Қолда бар қылмыс қана емес
Dialogue: 0,0:53:58.06,0:54:01.32,Default,,0,0,0,,You pay close attention to the background.
Dialogue: 0,0:54:01.40,0:54:04.07,Default,,0,0,0,,That's why the current situation is so frustrating.
Dialogue: 0,0:54:04.15,0:54:05.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:06.70,0:54:09.41,Default,,0,0,0,,What you can do because you are in an organization...
Dialogue: 0,0:54:09.49,0:54:12.74,Default,,0,0,0,,Біз мұны барынша пайдаланамыз.
Dialogue: 0,0:54:13.62,0:54:15.08,Default,,0,0,0,,Хидеюки…
Dialogue: 0,0:54:15.83,0:54:16.96,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:54:39.94,0:54:41.31,Default,,0,0,0,,- (Ер адам) Сен! -(Энджи) Иә?
Dialogue: 0,0:54:41.40,0:54:43.40,Default,,0,0,0,,Бұл тым сексуалды!
Dialogue: 0,0:54:43.48,0:54:45.24,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:54:45.32,0:54:48.03,Default,,0,0,0,,Уақытыңыз бар ма? Далаға шыққың келеді ме?
Dialogue: 0,0:54:48.11,0:54:49.36,Default,,0,0,0,,Олай болса, келесі аялдамадан неге түспейсің?
Dialogue: 0,0:54:51.53,0:54:52.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:52.66,0:54:55.16,Default,,0,0,0,,Сен де маған ашулысың ба?
Dialogue: 0,0:54:55.25,0:54:57.66,Default,,0,0,0,,Ой! Mokkori?
Dialogue: 0,0:54:57.75,0:54:59.04,Default,,0,0,0,,Әңгіме Ура!
Dialogue: 0,0:54:59.12,0:55:00.17,Default,,0,0,0,,Уф!
Dialogue: 0,0:55:01.79,0:55:02.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:02.79,0:55:05.30,Default,,0,0,0,,Hey, what? Lie, eh? Ахх...
Dialogue: 0,0:55:05.38,0:55:06.80,Default,,0,0,0,,О, шынымен! ?
Dialogue: 0,0:55:08.17,0:55:10.26,Default,,0,0,0,,Жаттығу жеткіліксіз
Dialogue: 0,0:55:10.34,0:55:11.39,Default,,0,0,0,,Мүмкін оның мақсаты – Эренді жеп қою.
Dialogue: 0,0:55:12.18,0:55:13.89,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:55:19.60,0:55:22.61,Default,,0,0,0,,Энджи Кавасакиге қарай бет алды.
Dialogue: 0,0:55:22.69,0:55:25.07,Default,,0,0,0,,Иә, иә, түсіндім!
Dialogue: 0,0:55:25.57,0:55:26.82,Default,,0,0,0,,Let's go, Kaori!
Dialogue: 0,0:55:26.90,0:55:27.82,Default,,0,0,0,,«Бұл мүлдем керісінше! Менің жайымды қарашы!»
Dialogue: 0,0:55:32.45,0:55:33.49,Default,,0,0,0,,Сәлем, Райо.
Dialogue: 0,0:55:33.58,0:55:37.04,Default,,0,0,0,,Бұл бюстгалтер қорабында келетін қорап сияқты...
Dialogue: 0,0:55:37.12,0:55:39.41,Default,,0,0,0,,Бұл оның ниеті туралы мәлімдемесі.
Dialogue: 0,0:55:40.12,0:55:43.21,Default,,0,0,0,,«Бұл маған қажет емес, мен оны біраз уақытқа қалдырамын».
Dialogue: 0,0:55:43.29,0:55:46.38,Default,,0,0,0,,Сонда Адам осының ішінде ме?
Dialogue: 0,0:55:46.46,0:55:49.80,Default,,0,0,0,,Бірақ неге сонша маңызды нәрсені сақтайсың...
Dialogue: 0,0:55:49.88,0:55:52.22,Default,,0,0,0,,Мен мәселені жалғыз шешемін.
Dialogue: 0,0:55:54.43,0:55:56.26,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:55:56.35,0:55:57.89,Default,,0,0,0,,Хэхе... Нһ...
Dialogue: 0,0:55:59.43,0:56:00.48,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:56:02.94,0:56:05.27,Default,,0,0,0,,Хяхо~!
Dialogue: 0,0:56:05.36,0:56:08.36,Default,,0,0,0,,Машина соншалықты кең болуы керек!
Dialogue: 0,0:56:11.11,0:56:12.16,Default,,0,0,0,,(Ангелдің шаңын қосу дыбысы)
Dialogue: 0,0:56:13.03,0:56:14.07,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:56:18.08,0:56:22.04,Default,,0,0,0,,Энджи-сан, сен қуғыншыларды өз бетімен тартуды жоспарлап отырсың ба?
Dialogue: 0,0:56:22.12,0:56:23.17,Default,,0,0,0,,О
Dialogue: 0,0:56:23.25,0:56:27.25,Default,,0,0,0,,Менің ойымша, олар Райо мен Каориді ішкі шайқасқа тартпауға тырысады.
Dialogue: 0,0:56:27.71,0:56:29.71,Default,,0,0,0,,Оның соңы жоқ екеніне сенімдімін.
Dialogue: 0,0:56:29.80,0:56:32.59,Default,,0,0,0,,Шайқастан қашып құтыла алмайсың
Dialogue: 0,0:56:32.68,0:56:35.68,Default,,0,0,0,,Сен аман болсаң, өткен сені қуады.
Dialogue: 0,0:56:36.93,0:56:39.35,Default,,0,0,0,,Сіз ешқашан қашып құтыла алмайсыз
Dialogue: 0,0:56:39.43,0:56:41.64,Default,,0,0,0,,Егер мұндай нәрсе болмаса...
Dialogue: 0,0:56:42.06,0:56:44.35,Default,,0,0,0,,Періште шаңының оралуы...
Dialogue: 0,0:56:44.44,0:56:47.15,Default,,0,0,0,,Адам екеуміз оны үйге апаруға рұқсат бермейміз.
Dialogue: 0,0:56:50.40,0:56:51.86,Default,,0,0,0,,Иә? не? Бұл
Dialogue: 0,0:56:51.95,0:56:53.78,Default,,0,0,0,,-（）  -（）
Dialogue: 0,0:56:55.70,0:56:56.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:56.62,0:56:57.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:57.87,0:56:58.91,Default,,0,0,0,,Сіз мұны істедіңіз!
Dialogue: 0,0:56:58.99,0:57:00.04,Default,,0,0,0,,Уф!
Dialogue: 0,0:57:04.17,0:57:05.42,Default,,0,0,0,,Уау...
Dialogue: 0,0:57:06.04,0:57:07.09,Default,,0,0,0,,(Терезе әйнегі сынған дыбыс)
Dialogue: 0,0:57:07.17,0:57:08.50,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:57:08.59,0:57:10.96,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:57:11.88,0:57:13.30,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,0:57:14.30,0:57:15.93,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:57:16.01,0:57:17.26,Default,,0,0,0,,Хяхо~!
Dialogue: 0,0:57:17.35,0:57:18.97,Default,,0,0,0,,Уф! Айта та та та!
Dialogue: 0,0:57:19.56,0:57:20.60,Default,,0,0,0,,Хош иісті зат!
Dialogue: 0,0:57:23.02,0:57:24.14,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:57:25.56,0:57:26.81,Default,,0,0,0,,Хмм... иә...
Dialogue: 0,0:57:26.90,0:57:27.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:28.61,0:57:29.61,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:57:29.69,0:57:31.11,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:57:31.19,0:57:32.24,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:57:33.15,0:57:33.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:35.41,0:57:37.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:37.41,0:57:38.45,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:57:39.53,0:57:41.54,Default,,0,0,0,,-（）… -（）…
Dialogue: 0,0:57:43.87,0:57:44.87,Default,,0,0,0,,Уууу…
Dialogue: 0,0:57:44.96,0:57:46.08,Default,,0,0,0,,Ннн…
Dialogue: 0,0:57:49.25,0:57:53.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:54.38,0:57:55.51,Default,,0,0,0,,Ннн…
Dialogue: 0,0:57:55.59,0:57:58.18,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:57:58.60,0:58:00.89,Default,,0,0,0,,Ха... Мен өлемін деп ойладым.
Dialogue: 0,0:58:01.64,0:58:02.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:58:03.10,0:58:04.81,Default,,0,0,0,,Бәрі бітті.
Dialogue: 0,0:58:04.89,0:58:06.31,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:58:06.90,0:58:11.94,Default,,0,0,0,,Сіз қазір қолданып жатқан қуаттан мүлдем басқа деңгейде қуат ала аласыз.
Dialogue: 0,0:58:12.03,0:58:14.90,Default,,0,0,0,,Бұл періште шаңында болған күш.
Dialogue: 0,0:58:15.78,0:58:21.24,Default,,0,0,0,,Соғысқа аттануға сайланғандардың барлығы оған төтеп бере алмай, қаза тапты.
Dialogue: 0,0:58:21.33,0:58:23.66,Default,,0,0,0,,Бір адамнан басқа...
Dialogue: 0,0:58:24.08,0:58:25.25,Default,,0,0,0,,Бұл —
Dialogue: 0,0:58:25.33,0:58:28.08,Default,,0,0,0,,Ол мэр Рио Саеба деп атаған солдат бала.
Dialogue: 0,0:58:28.17,0:58:29.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:30.42,0:58:31.84,Default,,0,0,0,,...Ей, не істеп жатырсың!
Dialogue: 0,0:58:31.92,0:58:33.92,Default,,0,0,0,,Жоқ, мен байқап көрейін деп ойладым.
Dialogue: 0,0:58:34.01,0:58:36.55,Default,,0,0,0,,Идиот! Менің міндетім - оны қайтару.
Dialogue: 0,0:58:36.63,0:58:38.43,Default,,0,0,0,,Бір туралы жақсы болар еді.
Dialogue: 0,0:58:38.51,0:58:39.64,Default,,0,0,0,,Мен жаңа ғана City Hunter ұтып алдым.
Dialogue: 0,0:58:39.72,0:58:40.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:41.26,0:58:42.97,Default,,0,0,0,,Мен оны алып кетейін.
Dialogue: 0,0:58:43.06,0:58:45.89,Default,,0,0,0,,Анонимодан құтылу керек.
Dialogue: 0,0:58:45.98,0:58:47.31,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:58:47.39,0:58:48.65,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:58:48.73,0:58:51.02,Default,,0,0,0,,Сіз құштар емес екеніңізді айттыңыз.
Dialogue: 0,0:58:51.11,0:58:53.11,Default,,0,0,0,,Бұл сіздің бетіңізде де жазылған.
Dialogue: 0,0:58:53.19,0:58:55.40,Default,,0,0,0,,Әкімнің өсиетін орындаңыз
Dialogue: 0,0:58:58.15,0:58:59.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:59.70,0:59:01.49,Default,,0,0,0,,City Hunter мүшесі.
Dialogue: 0,0:59:01.57,0:59:04.45,Default,,0,0,0,,Мен сенен сәлден кейін құтыламын.
Dialogue: 0,0:59:07.25,0:59:08.29,Default,,0,0,0,,О!
Dialogue: 0,0:59:08.37,0:59:10.83,Default,,0,0,0,,Сұңқар? Қандай қызық!
Dialogue: 0,0:59:10.92,0:59:13.80,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:59:13.88,0:59:15.21,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:59:18.47,0:59:19.30,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:59:19.38,0:59:20.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:59:21.76,0:59:22.93,Default,,0,0,0,,Ннн…
Dialogue: 0,0:59:23.26,0:59:24.31,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:59:26.72,0:59:28.10,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:59:28.69,0:59:29.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:59:30.35,0:59:31.44,Default,,0,0,0,,Ннн…
Dialogue: 0,0:59:34.82,0:59:36.15,Default,,0,0,0,,Чи…
Dialogue: 0,0:59:38.44,0:59:39.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:40.86,0:59:42.66,Default,,0,0,0,,Индукцияланған...
Dialogue: 0,0:59:42.74,0:59:44.03,Default,,0,0,0,,Ал, кейінірек.
Dialogue: 0,0:59:44.53,0:59:45.66,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз
Dialogue: 0,0:59:45.74,0:59:47.20,Default,,0,0,0,,Чороймонса
Dialogue: 0,0:59:47.29,0:59:48.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:59:48.58,0:59:49.62,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:59:49.71,0:59:51.58,Default,,0,0,0,,(Жан) Не…
Dialogue: 0,0:59:54.17,0:59:55.59,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:59:55.67,0:59:57.21,Default,,0,0,0,,Аа... Ннн...
Dialogue: 0,0:59:59.55,1:00:01.97,Default,,0,0,0,,Хаха~!
Dialogue: 0,1:00:02.05,1:00:04.18,Default,,0,0,0,,Ахх...
Dialogue: 0,1:00:07.56,1:00:10.73,Default,,0,0,0,,Хан! Олар маңызды емес.
Dialogue: 0,1:00:10.81,1:00:12.65,Default,,0,0,0,,Келесі операцияға көшейік!
Dialogue: 0,1:00:12.73,1:00:15.48,Default,,0,0,0,,Ал, детектив Ногами, мен не істеуім керек?
Dialogue: 0,1:00:15.57,1:00:17.19,Default,,0,0,0,,А, детектив Ногами?
Dialogue: 0,1:00:17.28,1:00:18.94,Default,,0,0,0,,Асығыс болсам да...
Dialogue: 0,1:00:19.03,1:00:22.16,Default,,0,0,0,,Біз қазір орбитаның қауіпсіздігін тексеріп жатырмыз.
Dialogue: 0,1:00:22.24,1:00:25.12,Default,,0,0,0,,Көліктен дереу жақын маңдағы есік арқылы шығыңыз.
Dialogue: 0,1:00:31.66,1:00:32.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:33.79,1:00:35.08,Default,,0,0,0,,Керемет кеме.
Dialogue: 0,1:00:35.59,1:00:36.88,Default,,0,0,0,,Сіз мінгіңіз келе ме?
Dialogue: 0,1:00:39.26,1:00:41.26,Default,,0,0,0,,Уау... Сәттілік!
Dialogue: 0,1:00:41.34,1:00:42.59,Default,,0,0,0,,♪ Жүгіру…
Dialogue: 0,1:00:42.68,1:00:44.39,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,1:00:44.47,1:00:45.51,Default,,0,0,0,,...Не?
Dialogue: 0,1:00:46.89,1:00:49.02,Default,,0,0,0,,Эй!
Dialogue: 0,1:00:49.10,1:00:51.52,Default,,0,0,0,,Бір минут күтіңіз, бұл менің кемем!
Dialogue: 0,1:00:51.60,1:00:52.64,Default,,0,0,0,,...Уау!
Dialogue: 0,1:01:01.82,1:01:02.86,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:01:05.49,1:01:06.53,Default,,0,0,0,,Ха…
Dialogue: 0,1:01:10.50,1:01:11.54,Default,,0,0,0,,Мен оны сағындым.
Dialogue: 0,1:01:11.62,1:01:12.79,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,1:01:20.13,1:01:21.17,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:24.26,1:01:26.64,Default,,0,0,0,,Ннн!
Dialogue: 0,1:01:26.72,1:01:30.18,Default,,0,0,0,,Каору-чан, сен жұмыс тапқан сияқтысың.
Dialogue: 0,1:01:30.26,1:01:31.39,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:01:31.85,1:01:33.10,Default,,0,0,0,,Сәлем Люпин
Dialogue: 0,1:01:33.18,1:01:35.94,Default,,0,0,0,,Егер сіз басқа жаққа қарасаңыз, кездесуге кешігіп қаласыз.
Dialogue: 0,1:01:36.02,1:01:38.73,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,1:01:38.82,1:01:40.02,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,1:01:46.45,1:01:47.49,Default,,0,0,0,,Уау...
Dialogue: 0,1:01:58.50,1:01:59.54,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:02:01.63,1:02:03.05,Default,,0,0,0,,(Электр көлігінің іске қосылу дыбысы)
Dialogue: 0,1:02:07.39,1:02:08.93,Default,,0,0,0,,Қашпа!
Dialogue: 0,1:02:09.01,1:02:11.64,Default,,0,0,0,,Каору-чан, темір жол бойында!
Dialogue: 0,1:02:11.72,1:02:13.35,Default,,0,0,0,,Уф... уау!
Dialogue: 0,1:02:17.77,1:02:19.73,Default,,0,0,0,,Маған қашуға рұқсат етіңіз!
Dialogue: 0,1:02:55.68,1:02:56.81,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,1:02:56.89,1:02:58.23,Default,,0,0,0,,Мен сенің қашуыңа ешқашан жол бермеймін!
Dialogue: 0,1:02:58.31,1:02:59.90,Default,,0,0,0,,Аа... нх!
Dialogue: 0,1:02:59.98,1:03:01.90,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:03:01.98,1:03:03.57,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,1:03:03.65,1:03:05.82,Default,,0,0,0,,Сізге қауіп төніп тұр.
Dialogue: 0,1:03:05.90,1:03:07.03,Default,,0,0,0,,Каориді тыныштандыр
Dialogue: 0,1:03:07.11,1:03:09.36,Default,,0,0,0,,Бұл сабырлы болудың кілті!
Dialogue: 0,1:03:09.45,1:03:11.03,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,1:03:11.12,1:03:12.37,Default,,0,0,0,,Иә, басқа жол!
Dialogue: 0,1:03:26.26,1:03:29.38,Default,,0,0,0,,Мен сенімен шайқаса аламын, Анонимо!
Dialogue: 0,1:03:29.84,1:03:32.05,Default,,0,0,0,,Мен әрқашан қабылдаймын
Dialogue: 0,1:03:34.85,1:03:36.60,Default,,0,0,0,,Бұл артық емес пе?
Dialogue: 0,1:03:44.48,1:03:45.57,Default,,0,0,0,,Хаха!
Dialogue: 0,1:03:53.20,1:03:54.24,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:03:56.99,1:03:58.20,Default,,0,0,0,,үшін!
Dialogue: 0,1:03:58.54,1:03:59.58,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:00.33,1:04:01.54,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:04:01.62,1:04:02.67,Default,,0,0,0,,Уф…
Dialogue: 0,1:04:03.79,1:04:04.84,Default,,0,0,0,,Уф…
Dialogue: 0,1:04:05.29,1:04:06.34,Default,,0,0,0,,Хмм...
Dialogue: 0,1:04:07.80,1:04:09.22,Default,,0,0,0,,Ннн…
Dialogue: 0,1:04:10.30,1:04:12.84,Default,,0,0,0,,Сіз құлықсызсыз ба?
Dialogue: 0,1:04:13.51,1:04:14.80,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,1:04:16.89,1:04:18.14,Default,,0,0,0,,О, Энджи!
Dialogue: 0,1:04:18.22,1:04:19.35,Default,,0,0,0,,(көлік дыбысы)
Dialogue: 0,1:04:21.02,1:04:23.15,Default,,0,0,0,,Ол қайтадан екіге бөлінді ме?
Dialogue: 0,1:04:23.23,1:04:26.77,Default,,0,0,0,,Екіншісі портқа бағыт алуы керек.
Dialogue: 0,1:04:26.86,1:04:28.19,Default,,0,0,0,,Оның соңынан еріңіз
Dialogue: 0,1:04:28.28,1:04:29.32,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:04:29.69,1:04:31.20,Default,,0,0,0,,- (Хош иісті зат) Қарыз бер! - (Үмибозу) Әй... Әй!
Dialogue: 0,1:04:31.28,1:04:33.16,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,1:04:33.24,1:04:34.07,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,1:04:34.16,1:04:36.20,Default,,0,0,0,,Егер Энджиге тиіп кетсе, қауіпті болар еді...
Dialogue: 0,1:04:36.28,1:04:37.95,Default,,0,0,0,,О...
Dialogue: 0,1:04:38.54,1:04:39.91,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:04:40.00,1:04:40.83,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:42.16,1:04:44.63,Default,,0,0,0,,Хмф... Мынау жаман!
Dialogue: 0,1:04:45.17,1:04:46.00,Default,,0,0,0,,Хмм...
Dialogue: 0,1:04:46.09,1:04:47.80,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:04:55.26,1:04:56.30,Default,,0,0,0,,Хмм...
Dialogue: 0,1:04:59.77,1:05:00.81,Default,,0,0,0,,Иә!
Dialogue: 0,1:05:02.98,1:05:04.10,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,1:05:04.19,1:05:05.15,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,1:05:05.77,1:05:06.81,Default,,0,0,0,,Ахх...
Dialogue: 0,1:05:07.32,1:05:08.15,Default,,0,0,0,,Ах…
Dialogue: 0,1:05:08.23,1:05:10.11,Default,,0,0,0,,Ахх... Ахх...
Dialogue: 0,1:05:11.24,1:05:14.11,Default,,0,0,0,,А... Міне, осындай нәрсе.
Dialogue: 0,1:05:17.49,1:05:19.12,Default,,0,0,0,,Неге екен?
Dialogue: 0,1:05:19.20,1:05:22.54,Default,,0,0,0,,Менің отбасымды өлтірген адамға...
Dialogue: 0,1:05:23.04,1:05:26.04,Default,,0,0,0,,Ол менің жалғыз отбасым.
Dialogue: 0,1:05:26.13,1:05:27.38,Default,,0,0,0,,Фу…
Dialogue: 0,1:05:27.46,1:05:31.26,Default,,0,0,0,,Сен ақымақсың ғой, Анонимо...
Dialogue: 0,1:05:35.80,1:05:36.84,Default,,0,0,0,,Хмм...
Dialogue: 0,1:05:56.95,1:06:00.45,Default,,0,0,0,,(тұман)
Dialogue: 0,1:06:01.16,1:06:04.79,Default,,0,0,0,,Бұл жерді қызыл Пегас алып жатқан сияқты.
Dialogue: 0,1:06:04.87,1:06:06.67,Default,,0,0,0,,Саекодан сізбен байланысуын сұраңыз
Dialogue: 0,1:06:06.75,1:06:08.04,Default,,0,0,0,,Мен аламын
Dialogue: 0,1:06:14.42,1:06:15.26,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:06:16.13,1:06:17.22,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:06:30.27,1:06:31.11,Default,,0,0,0,,Уау...
Dialogue: 0,1:06:31.19,1:06:32.40,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,1:06:34.28,1:06:36.11,Default,,0,0,0,,Каори Көмек сұраңыз
Dialogue: 0,1:06:36.20,1:06:37.70,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:06:38.41,1:06:39.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:39.53,1:06:40.74,Default,,0,0,0,,...
Dialogue: 0,1:06:40.83,1:06:41.95,Default,,0,0,0,,Хмм...
Dialogue: 0,1:06:42.03,1:06:43.45,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:06:44.37,1:06:45.20,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:06:45.29,1:06:47.29,Default,,0,0,0,,Ах, мен мұны қайтадан жасадым.
Dialogue: 0,1:06:47.37,1:06:48.71,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:48.79,1:06:50.79,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,1:06:59.84,1:07:01.68,Default,,0,0,0,,Мен оны қайтара аламын ба?
Dialogue: 0,1:07:04.56,1:07:06.02,Default,,0,0,0,,Рио Саеба…
Dialogue: 0,1:07:07.10,1:07:10.94,Default,,0,0,0,,Періштенің шаңына жұтылмаған жалғыз адам
Dialogue: 0,1:07:12.40,1:07:14.15,Default,,0,0,0,,Сіздің қателігіңіз...
Dialogue: 0,1:07:14.69,1:07:18.32,Default,,0,0,0,,Мэрдің ең жақсы жауынгері болу
Dialogue: 0,1:07:19.03,1:07:22.07,Default,,0,0,0,,Мен ол адамды тастап кеттім.
Dialogue: 0,1:07:23.08,1:07:28.54,Default,,0,0,0,,Мэр де, Анонимо да сізге деген құмарлығын жоя алмайды.
Dialogue: 0,1:07:29.33,1:07:32.29,Default,,0,0,0,,Мен сені жеңсем, мен бәрін қиып аламын!
Dialogue: 0,1:07:40.09,1:07:41.14,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:42.26,1:07:43.80,Default,,0,0,0,,Мен мынаны аламын.
Dialogue: 0,1:07:43.89,1:07:45.39,Default,,0,0,0,,Ха... аа...
Dialogue: 0,1:07:45.47,1:07:46.47,Default,,0,0,0,,Хмм...
Dialogue: 0,1:07:46.56,1:07:47.39,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:07:48.23,1:07:49.39,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:49.48,1:07:51.40,Default,,0,0,0,,...
Dialogue: 0,1:07:51.48,1:07:52.61,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:08:04.33,1:08:05.37,Default,,0,0,0,,Ха…
Dialogue: 0,1:08:06.79,1:08:07.83,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:08:10.71,1:08:11.92,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:20.72,1:08:22.09,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,1:08:22.18,1:08:23.68,Default,,0,0,0,,Бірақ мен оны шешемін.
Dialogue: 0,1:09:06.10,1:09:09.47,Default,,0,0,0,,Менімен бірге жүр Анонимо
Dialogue: 0,1:09:09.56,1:09:12.10,Default,,0,0,0,,Мен әкімнен кешірім сұраймын.
Dialogue: 0,1:09:13.14,1:09:15.69,Default,,0,0,0,,Мен Эспаданы өлтірдім
Dialogue: 0,1:09:15.77,1:09:19.28,Default,,0,0,0,,Мен ұйымға қайтып бара алмаймын, енді қайтуға ниетім де жоқ.
Dialogue: 0,1:09:19.86,1:09:21.11,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,1:09:22.32,1:09:25.20,Default,,0,0,0,,Бұл оның шедеврі ...
Dialogue: 0,1:09:26.20,1:09:30.04,Default,,0,0,0,,Енді мұның қажеті жоқ екенін дәлелдеймін.
Dialogue: 0,1:09:31.00,1:09:33.00,Default,,0,0,0,,Сол адамның көз алдында
Dialogue: 0,1:09:33.08,1:09:36.00,Default,,0,0,0,,Оған дейін мен сені өлтіремін.
Dialogue: 0,1:09:36.50,1:09:39.21,Default,,0,0,0,,Оны ұйымға қайтарыңыз, Anonimo.
Dialogue: 0,1:09:39.80,1:09:44.09,Default,,0,0,0,,Менің өмірім әкіммен кездескен күннен басталды.
Dialogue: 0,1:09:44.18,1:09:45.22,Default,,0,0,0,,Әрқашан әкім...
Dialogue: 0,1:09:46.01,1:09:47.97,Default,,0,0,0,,Умихарашинмен бірге болды
Dialogue: 0,1:09:48.05,1:09:49.35,Default,,0,0,0,,Бұл әрі қарай да солай болады.
Dialogue: 0,1:09:50.56,1:09:52.06,Default,,0,0,0,,Күнә істер...
Dialogue: 0,1:09:53.39,1:09:54.44,Default,,0,0,0,,Хмм...
Dialogue: 0,1:09:54.52,1:09:56.06,Default,,0,0,0,,Hah... stop it!
Dialogue: 0,1:10:02.82,1:10:03.74,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:10:03.82,1:10:04.86,Default,,0,0,0,,Иә!
Dialogue: 0,1:10:04.95,1:10:05.99,Default,,0,0,0,,Уууу…
Dialogue: 0,1:10:08.62,1:10:14.58,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:10:17.08,1:10:17.92,Default,,0,0,0,,Ха…
Dialogue: 0,1:10:18.00,1:10:18.83,Default,,0,0,0,,Ннн…
Dialogue: 0,1:10:20.84,1:10:22.21,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:10:22.30,1:10:24.01,Default,,0,0,0,,- (Пираручу) Уф! -(Энджи) Ха...
Dialogue: 0,1:10:24.09,1:10:26.22,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:10:26.30,1:10:29.22,Default,,0,0,0,,Ооо... Ааа...
Dialogue: 0,1:10:29.30,1:10:31.68,Default,,0,0,0,,Ууууууууууууууууууууууууууууууу...
Dialogue: 0,1:10:31.76,1:10:33.06,Default,,0,0,0,,Пираручу!
Dialogue: 0,1:10:33.64,1:10:34.68,Default,,0,0,0,,Пираручу!
Dialogue: 0,1:10:35.18,1:10:38.85,Default,,0,0,0,,Еспада жігіт оңай дүниеден өтті ме екен...
Dialogue: 0,1:10:38.94,1:10:40.19,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,1:10:40.27,1:10:42.52,Default,,0,0,0,,Барар жері тозақ болса да...
Dialogue: 0,1:10:42.61,1:10:43.44,Default,,0,0,0,,Ах…
Dialogue: 0,1:10:43.53,1:10:45.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:46.03,1:10:49.49,Default,,0,0,0,,Саебаға барыңыз...
Dialogue: 0,1:10:51.12,1:10:52.79,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:53.62,1:10:54.87,Default,,0,0,0,,Сіз...
Dialogue: 0,1:10:56.29,1:10:57.83,Default,,0,0,0,,Тікелей...
Dialogue: 0,1:10:57.92,1:10:59.17,Default,,0,0,0,,Ха…
Dialogue: 0,1:10:59.25,1:11:00.63,Default,,0,0,0,,Пираручу…
Dialogue: 0,1:11:02.71,1:11:03.75,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:11:06.55,1:11:07.72,Default,,0,0,0,,Ннн…
Dialogue: 0,1:11:14.01,1:11:15.93,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:11:27.57,1:11:28.90,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,1:11:39.16,1:11:41.96,Default,,0,0,0,,Бұл... Энджи ме?
Dialogue: 0,1:11:43.17,1:11:44.21,Default,,0,0,0,,…
Dialogue: 0,1:11:51.84,1:11:53.30,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:11:54.39,1:11:55.76,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:55.85,1:11:59.31,Default,,0,0,0,,Энджимен төбелеспеудің жолы бар ма?
Dialogue: 0,1:11:59.39,1:12:01.56,Default,,0,0,0,,Онымен ұрысуға себеп жоқ, солай ма?
Dialogue: 0,1:12:02.31,1:12:03.36,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:04.02,1:12:07.07,Default,,0,0,0,,Бірақ қашып құтыла алмайсың
Dialogue: 0,1:12:07.15,1:12:08.49,Default,,0,0,0,,...
Dialogue: 0,1:12:08.57,1:12:10.74,Default,,0,0,0,,Сақ болсаң, жеңуге болады.
Dialogue: 0,1:12:10.82,1:12:11.86,Default,,0,0,0,,Ха…
Dialogue: 0,1:12:11.95,1:12:15.45,Default,,0,0,0,,Энджи мен соғысқандардың бәрінен де күшті.
Dialogue: 0,1:12:16.12,1:12:17.49,Default,,0,0,0,,-（） -（）…
Dialogue: 0,1:12:18.54,1:12:19.37,Default,,0,0,0,,Бұл...
Dialogue: 0,1:12:19.46,1:12:20.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:12:21.29,1:12:22.33,Default,,0,0,0,,Сұрамаңыз
Dialogue: 0,1:12:23.67,1:12:24.71,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:12:32.38,1:12:35.30,Default,,0,0,0,,Саеба Рё мен сені жеңемін
Dialogue: 0,1:12:36.18,1:12:38.02,Default,,0,0,0,,Мен сенен асып түстім
Dialogue: 0,1:12:48.82,1:12:50.19,Default,,0,0,0,,Саеба жоғалып кетті
Dialogue: 0,1:12:52.65,1:12:55.99,Default,,0,0,0,,...
Dialogue: 0,1:12:56.08,1:12:57.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:03.67,1:13:04.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:11.84,1:13:15.09,Default,,0,0,0,,Каори-сан, мен осыны қалаймын.
Dialogue: 0,1:13:19.60,1:13:21.10,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:13:38.62,1:13:39.45,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:13:41.20,1:13:42.50,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:13:43.29,1:13:44.71,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:13:47.04,1:13:47.63,Default,,0,0,0,,Незуко! Мен төмен түсемін
Dialogue: 0,1:13:48.17,1:13:48.75,Default,,0,0,0,,Уф!
Dialogue: 0,1:13:50.75,1:13:52.63,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,1:13:52.71,1:13:55.22,Default,,0,0,0,,Өмірлік маңызды нүктелерді әдейі ұру...
Dialogue: 0,1:13:57.55,1:13:58.97,Default,,0,0,0,,Ннн…
Dialogue: 0,1:14:01.43,1:14:03.68,Default,,0,0,0,,Рё... Шынайы...
Dialogue: 0,1:14:06.52,1:14:09.57,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:14:09.94,1:14:10.86,Default,,0,0,0,,Уф!
Dialogue: 0,1:14:12.69,1:14:13.74,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:14:14.32,1:14:15.36,Default,,0,0,0,,Ннн…
Dialogue: 0,1:14:15.45,1:14:16.32,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:14:16.41,1:14:17.24,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:14:17.78,1:14:19.07,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:19.99,1:14:21.03,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:25.25,1:14:27.46,Default,,0,0,0,,Мен білмейтін дәуір...
Dialogue: 0,1:14:28.13,1:14:30.75,Default,,0,0,0,,Мен ешқашан алмаған көзқарас
Dialogue: 0,1:14:31.96,1:14:34.88,Default,,0,0,0,,Мен жүрегімді қайтарғым келеді!
Dialogue: 0,1:14:34.97,1:14:36.01,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:14:37.84,1:14:38.89,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:14:38.97,1:14:40.05,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,1:14:40.14,1:14:41.01,Default,,0,0,0,,Энджи!
Dialogue: 0,1:14:41.81,1:14:42.85,Default,,0,0,0,,Ахх...
Dialogue: 0,1:14:43.89,1:14:45.48,Default,,0,0,0,,Бұл шайқас болды.
Dialogue: 0,1:14:45.56,1:14:46.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:46.69,1:14:48.85,Default,,0,0,0,,Оның қолы қазірдің өзінде...
Dialogue: 0,1:14:49.40,1:14:50.98,Default,,0,0,0,,Ах... көкек...
Dialogue: 0,1:14:51.06,1:14:51.90,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:53.98,1:14:55.03,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,1:14:56.11,1:15:00.24,Default,,0,0,0,,Бұл мылтық қазір саған тым ауыр.
Dialogue: 0,1:15:04.08,1:15:05.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:08.04,1:15:11.00,Default,,0,0,0,,Бұл сіздің шедевріңіз бе?
Dialogue: 0,1:15:13.34,1:15:14.59,Default,,0,0,0,,Уф…
Dialogue: 0,1:15:15.51,1:15:16.55,Default,,0,0,0,,Фу…
Dialogue: 0,1:15:18.43,1:15:21.09,Default,,0,0,0,,Энджи күліп тұр...
Dialogue: 0,1:15:37.11,1:15:39.28,Default,,0,0,0,,Тілектеріңіз орындалсын
Dialogue: 0,1:15:39.91,1:15:41.62,Default,,0,0,0,,Шектен асып кету
Dialogue: 0,1:15:46.66,1:15:48.12,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:48.21,1:15:49.46,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:56.09,1:15:57.97,Default,,0,0,0,,Ооо... Ааа...
Dialogue: 0,1:15:58.92,1:16:00.34,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:00.84,1:16:02.76,Default,,0,0,0,,Әкім…
Dialogue: 0,1:16:02.84,1:16:04.81,Default,,0,0,0,,-（） -（）…
Dialogue: 0,1:16:04.89,1:16:05.76,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,1:16:07.93,1:16:09.06,Default,,0,0,0,,Уф!
Dialogue: 0,1:16:09.14,1:16:10.39,Default,,0,0,0,,...
Dialogue: 0,1:16:14.27,1:16:16.98,Default,,0,0,0,,А... не?
Dialogue: 0,1:16:17.07,1:16:18.90,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:21.45,1:16:23.57,Default,,0,0,0,,Хмм... га...
Dialogue: 0,1:16:23.66,1:16:24.95,Default,,0,0,0,,(Жан) Не…
Dialogue: 0,1:16:25.41,1:16:26.45,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:27.74,1:16:28.91,Default,,0,0,0,,Ммм!
Dialogue: 0,1:16:29.00,1:16:30.16,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:30.25,1:16:31.12,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:33.63,1:16:34.67,Default,,0,0,0,,Иә!
Dialogue: 0,1:16:35.21,1:16:36.09,Default,,0,0,0,,Иә!
Dialogue: 0,1:16:36.67,1:16:37.67,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,1:16:37.75,1:16:38.92,Default,,0,0,0,,Уф!
Dialogue: 0,1:16:39.84,1:16:42.59,Default,,0,0,0,,Күш... бұл...
Dialogue: 0,1:16:45.10,1:16:46.26,Default,,0,0,0,,Ха…
Dialogue: 0,1:16:46.35,1:16:47.47,Default,,0,0,0,,Уууу…
Dialogue: 0,1:16:47.56,1:16:49.02,Default,,0,0,0,,-（） -（）
Dialogue: 0,1:16:49.10,1:16:50.14,Default,,0,0,0,,Уууу…
Dialogue: 0,1:16:52.27,1:16:55.65,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:16:58.40,1:16:59.44,Default,,0,0,0,,Не?
Dialogue: 0,1:17:02.36,1:17:03.91,Default,,0,0,0,,Саебаның қимылдары...
Dialogue: 0,1:17:04.70,1:17:05.74,Default,,0,0,0,,Мен оны көріп тұрмын!
Dialogue: 0,1:17:06.95,1:17:09.12,Default,,0,0,0,,Бұл менің денем бе?
Dialogue: 0,1:17:11.33,1:17:13.67,Default,,0,0,0,,Қандай әдемі көрініс!
Dialogue: 0,1:17:13.75,1:17:15.04,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,1:17:15.13,1:17:16.46,Default,,0,0,0,,Уау!
Dialogue: 0,1:17:20.84,1:17:21.88,Default,,0,0,0,,Иә!
Dialogue: 0,1:17:28.01,1:17:29.18,Default,,0,0,0,,Иә!
Dialogue: 0,1:17:29.26,1:17:30.31,Default,,0,0,0,,Уф!
Dialogue: 0,1:17:30.93,1:17:34.77,Default,,0,0,0,,Мен Саебадан асып түстім бе?
Dialogue: 0,1:17:34.85,1:17:36.36,Default,,0,0,0,,Ух... Ах!
Dialogue: 0,1:17:37.94,1:17:39.82,Default,,0,0,0,,Жоқ, ха...
Dialogue: 0,1:17:39.90,1:17:41.86,Default,,0,0,0,,Мен не істеймін...
Dialogue: 0,1:17:42.36,1:17:44.36,Default,,0,0,0,,Осылай... Бұл...
Dialogue: 0,1:17:44.45,1:17:45.53,Default,,0,0,0,,Энджи!
Dialogue: 0,1:17:45.61,1:17:47.49,Default,,0,0,0,,Хахаха...
Dialogue: 0,1:17:47.57,1:17:49.58,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,1:17:52.41,1:17:54.33,Default,,0,0,0,,Ннн…
Dialogue: 0,1:18:01.59,1:18:03.13,Default,,0,0,0,,Суда шын мәнінде өз мүмкіндігін көрсететін техникалар бар!
Dialogue: 0,1:18:03.22,1:18:05.72,Default,,0,0,0,,Бұл менің еркім емес!
Dialogue: 0,1:18:05.80,1:18:07.18,Default,,0,0,0,,Анджи!
Dialogue: 0,1:18:07.26,1:18:10.22,Default,,0,0,0,,Мені басып алмаңыз...
Dialogue: 0,1:18:10.31,1:18:12.52,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:18:12.60,1:18:13.93,Default,,0,0,0,,Ой~!
Dialogue: 0,1:18:14.02,1:18:15.52,Default,,0,0,0,,Шығу!
Dialogue: 0,1:18:15.60,1:18:16.44,Default,,0,0,0,,Уф!
Dialogue: 0,1:18:18.02,1:18:19.36,Default,,0,0,0,,Энджи!
Dialogue: 0,1:18:19.44,1:18:22.19,Default,,0,0,0,,Осындай әрекетті орындаңыз...
Dialogue: 0,1:18:22.28,1:18:24.61,Default,,0,0,0,,Мен Саебаны жеңсем де...
Dialogue: 0,1:18:24.69,1:18:25.74,Default,,0,0,0,,Ахх...
Dialogue: 0,1:18:26.91,1:18:27.95,Default,,0,0,0,,Бұл...
Dialogue: 0,1:18:28.70,1:18:30.03,Default,,0,0,0,,Періште шаңы…
Dialogue: 0,1:18:30.12,1:18:31.16,Default,,0,0,0,,Уф!
Dialogue: 0,1:18:31.79,1:18:35.37,Default,,0,0,0,,Маған неге бұлай істедің?
Dialogue: 0,1:18:36.12,1:18:38.13,Default,,0,0,0,,Әкім…
Dialogue: 0,1:18:38.21,1:18:39.54,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:40.46,1:18:42.63,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,1:18:42.71,1:18:44.13,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:46.30,1:18:50.14,Default,,0,0,0,,өлтіру өлтіру өлтіру
Dialogue: 0,1:18:50.72,1:18:52.56,Default,,0,0,0,,Мені өлтірмесең...
Dialogue: 0,1:18:54.18,1:18:55.89,Default,,0,0,0,,Сүймейді
Dialogue: 0,1:18:56.44,1:18:58.35,Default,,0,0,0,,Барлығын жою
Dialogue: 0,1:18:58.44,1:19:00.86,Default,,0,0,0,,Барлығын өшіріңіз!
Dialogue: 0,1:19:00.94,1:19:02.61,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,1:19:02.69,1:19:03.94,Default,,0,0,0,,Уф…
Dialogue: 0,1:19:07.74,1:19:08.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:09.24,1:19:10.37,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,1:19:11.95,1:19:12.99,Default,,0,0,0,,Иә!
Dialogue: 0,1:19:13.79,1:19:14.62,Default,,0,0,0,,Иә!
Dialogue: 0,1:19:14.70,1:19:15.58,Default,,0,0,0,,Уф!
Dialogue: 0,1:19:16.08,1:19:16.91,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:17.00,1:19:19.50,Default,,0,0,0,,Рионың барлық қимылдары назардан тыс қалды.
Dialogue: 0,1:19:19.58,1:19:20.71,Default,,0,0,0,,және тек үшеуміз – анам, әкем және мен – бірге өмір сүремін…
Dialogue: 0,1:19:20.79,1:19:21.84,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:21.92,1:19:25.34,Default,,0,0,0,,Бірақ періштенің шаңы сейілгенше шыдасаң...
Dialogue: 0,1:19:25.42,1:19:27.72,Default,,0,0,0,,- (Умибозу) Оның рухы тұрмайды - (Мики) Иә?
Dialogue: 0,1:19:27.80,1:19:31.43,Default,,0,0,0,,Егер Энджи болмаса, ол әлдеқашан басқарылатын еді.
Dialogue: 0,1:19:31.51,1:19:33.22,Default,,0,0,0,,Ал қазірдің өзінде...
Dialogue: 0,1:19:33.64,1:19:34.72,Default,,0,0,0,,Бұл...
Dialogue: 0,1:19:34.81,1:19:36.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:36.14,1:19:37.27,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:38.89,1:19:40.98,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:43.27,1:19:44.11,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:45.44,1:19:46.49,Default,,0,0,0,,Ха…
Dialogue: 0,1:19:47.19,1:19:49.11,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:49.20,1:19:50.36,Default,,0,0,0,,Уф!
Dialogue: 0,1:19:55.79,1:19:57.20,Default,,0,0,0,,Уууу…
Dialogue: 0,1:19:58.12,1:19:59.87,Default,,0,0,0,,Ннн…
Dialogue: 0,1:20:07.38,1:20:08.84,Default,,0,0,0,,...
Dialogue: 0,1:20:12.93,1:20:15.18,Default,,0,0,0,,Ооо... Ааа...
Dialogue: 0,1:20:15.26,1:20:16.31,Default,,0,0,0,,Уууу…
Dialogue: 0,1:20:16.39,1:20:17.22,Default,,0,0,0,,Ха…
Dialogue: 0,1:20:17.31,1:20:19.73,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,1:20:19.81,1:20:21.06,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:20:22.02,1:20:23.06,Default,,0,0,0,,Энджи!
Dialogue: 0,1:20:23.15,1:20:23.98,Default,,0,0,0,,Эй!
Dialogue: 0,1:20:24.06,1:20:26.73,Default,,0,0,0,,Каори Келме!
Dialogue: 0,1:20:26.82,1:20:28.36,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:29.24,1:20:30.07,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:35.33,1:20:37.20,Default,,0,0,0,,Ах... у...
Dialogue: 0,1:20:37.29,1:20:38.95,Default,,0,0,0,,Ахх...
Dialogue: 0,1:20:43.17,1:20:44.54,Default,,0,0,0,,Ха…
Dialogue: 0,1:20:44.63,1:20:45.84,Default,,0,0,0,,Энджи!
Dialogue: 0,1:20:45.92,1:20:51.17,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,1:20:51.93,1:20:53.01,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:20:53.09,1:20:53.93,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:20:55.51,1:20:56.35,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:20:57.39,1:20:59.72,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,1:21:01.94,1:21:02.81,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:21:02.89,1:21:05.19,Default,,0,0,0,,Бұл Адам...
Dialogue: 0,1:21:05.27,1:21:09.07,Default,,0,0,0,,Періште шаңының күші болса...
Dialogue: 0,1:21:09.90,1:21:10.74,Default,,0,0,0,,Хмм...
Dialogue: 0,1:21:10.82,1:21:12.32,Default,,0,0,0,,Энджи!
Dialogue: 0,1:21:12.40,1:21:14.95,Default,,0,0,0,,Энджи өз өмірін қиғалы жатыр
Dialogue: 0,1:21:15.03,1:21:16.07,Default,,0,0,0,,Ха…
Dialogue: 0,1:21:16.16,1:21:19.12,Default,,0,0,0,,Бірақ періште шаңы бұған жол бермейді.
Dialogue: 0,1:21:19.20,1:21:20.29,Default,,0,0,0,,Бұл...
Dialogue: 0,1:21:20.37,1:21:21.66,Default,,0,0,0,,Олай болса...
Dialogue: 0,1:21:25.33,1:21:28.34,Default,,0,0,0,,Энджи білуі керек.
Dialogue: 0,1:21:29.21,1:21:32.34,Default,,0,0,0,,Мен бұл жағдайдан қалай шыға аламын?
Dialogue: 0,1:21:33.68,1:21:34.72,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,1:21:34.80,1:21:35.64,Default,,0,0,0,,Энджи!
Dialogue: 0,1:21:35.72,1:21:39.35,Default,,0,0,0,,А, Райо да түсінеді.
Dialogue: 0,1:21:42.27,1:21:46.19,Default,,0,0,0,,Бұл мені біреу өлтірмейінше бітпейді дегенді білдіре ме?
Dialogue: 0,1:21:46.90,1:21:48.61,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:21:48.69,1:21:50.78,Default,,0,0,0,,Және бұл ...
Dialogue: 0,1:21:51.40,1:21:54.36,Default,,0,0,0,,Міне... Міне, солай!
Dialogue: 0,1:22:05.25,1:22:06.29,Default,,0,0,0,,Анджи!
Dialogue: 0,1:22:09.79,1:22:10.84,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:22:17.34,1:22:18.72,Default,,0,0,0,,Я...
Dialogue: 0,1:22:18.80,1:22:21.77,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,1:22:21.85,1:22:24.98,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,1:22:25.98,1:22:27.60,Default,,0,0,0,,Ах... ха...
Dialogue: 0,1:22:28.73,1:22:30.11,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:22:30.65,1:22:31.69,Default,,0,0,0,,Уф…
Dialogue: 0,1:22:31.78,1:22:34.32,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,1:22:37.86,1:22:40.83,Default,,0,0,0,,Әй... Эй... Гай...
Dialogue: 0,1:22:40.91,1:22:43.58,Default,,0,0,0,,Сізде әлі де өзіндік сезім бар ма?
Dialogue: 0,1:22:43.66,1:22:44.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:47.62,1:22:48.92,Default,,0,0,0,,Ннн…
Dialogue: 0,1:22:55.84,1:22:58.68,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,1:22:58.76,1:23:01.18,Default,,0,0,0,,...
Dialogue: 0,1:23:02.01,1:23:05.10,Default,,0,0,0,,Енді... жеңілдетіңіз!
Dialogue: 0,1:23:11.15,1:23:13.02,Default,,0,0,0,,Та... ішу...
Dialogue: 0,1:23:13.11,1:23:15.44,Default,,0,0,0,,Sae… Ba…
Dialogue: 0,1:23:15.53,1:23:17.53,Default,,0,0,0,,Оның өтініші!
Dialogue: 0,1:23:17.61,1:23:19.45,Default,,0,0,0,,...
Dialogue: 0,1:23:25.25,1:23:27.00,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:23:28.92,1:23:29.75,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:23:30.63,1:23:31.67,Default,,0,0,0,,Уф!
Dialogue: 0,1:23:45.22,1:23:46.52,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:23:47.56,1:23:49.98,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:23:51.02,1:23:52.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:23:53.57,1:23:54.61,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:24:21.93,1:24:22.76,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:24:28.73,1:24:29.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:24:30.31,1:24:31.35,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:24:32.81,1:24:33.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:24:35.69,1:24:36.82,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:24:51.08,1:24:52.42,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:57.21,1:24:58.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:02.26,1:25:03.30,Default,,0,0,0,,Әкем…
Dialogue: 0,1:25:10.06,1:25:11.10,Default,,0,0,0,,Энджи!
Dialogue: 0,1:25:29.45,1:25:30.79,Default,,0,0,0,,…
Dialogue: 0,1:25:30.87,1:25:33.79,Default,,0,0,0,,Сіз әрқашан менің күткенімнен асып кетесіз.
Dialogue: 0,1:25:35.42,1:25:36.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:43.09,1:25:46.80,Default,,0,0,0,,Мен де сен сияқты жақсы көргім келді...
Dialogue: 0,1:25:49.81,1:25:51.27,Default,,0,0,0,,Энджи!
Dialogue: 0,1:25:56.44,1:26:00.40,Default,,0,0,0,,Рахмет, Каору-сан...
Dialogue: 0,1:26:00.90,1:26:02.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:05.86,1:26:09.49,Default,,0,0,0,,Босаңсығаным ұят...
Dialogue: 0,1:26:10.66,1:26:12.00,Default,,0,0,0,,…
Dialogue: 0,1:26:16.42,1:26:17.71,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:17.79,1:26:20.17,Default,,0,0,0,,Энджи!
Dialogue: 0,1:26:20.92,1:26:24.34,Default,,0,0,0,,(тәтті түтіннің айқайы)
Dialogue: 0,1:26:30.97,1:26:33.43,Default,,0,0,0,,Жарайсың Анонимо
Dialogue: 0,1:26:37.35,1:26:40.06,Default,,0,0,0,,Сен менің шедеврімсің
Dialogue: 0,1:26:50.37,1:26:51.83,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,1:26:51.91,1:26:53.75,Default,,0,0,0,,Бұл өте әдемі
Dialogue: 0,1:26:53.83,1:26:57.25,Default,,0,0,0,,
Dialogue: 0,1:26:58.79,1:27:02.42,Default,,0,0,0,,Жарайды, мені ала кет!
Dialogue: 0,1:27:05.17,1:27:08.80,Default,,0,0,0,,Детектив Ногами «Әділет орнайды»!
Dialogue: 0,1:27:08.89,1:27:10.68,Default,,0,0,0,,Ахахха!
Dialogue: 0,1:27:14.52,1:27:20.52,Default,,0,0,0,,Соңында еріксіз шайқас басталады.
Dialogue: 0,1:27:27.95,1:27:30.03,Default,,0,0,0,,Union Teope…
Dialogue: 0,1:27:30.11,1:27:32.95,Default,,0,0,0,,Әрі қарай зерттеген дұрыс.
Dialogue: 0,1:27:38.67,1:27:41.83,Default,,0,0,0,,Адамды полиция қалпына келтірді деп естідім.
Dialogue: 0,1:27:42.38,1:27:44.75,Default,,0,0,0,,Осы арқылы Zoltic-ті де басқаруға болады.
Dialogue: 0,1:27:46.05,1:27:49.97,Default,,0,0,0,,Энджи мұхитты жылжытты
Dialogue: 0,1:27:50.05,1:27:52.30,Default,,0,0,0,,Сіз солай ойлай аласыз...
Dialogue: 0,1:28:02.40,1:28:05.32,Default,,0,0,0,,Мен сол екеуін кездестіре аламын ба деп ойлаймын...
Dialogue: 0,1:28:06.07,1:28:07.11,Default,,0,0,0,,О
Dialogue: 0,1:28:08.65,1:28:12.24,Default,,0,0,0,,Бұл үшеуінің бірін-бірі өлтіруінің қажеті жоқ еді.
Dialogue: 0,1:28:15.12,1:28:16.58,Default,,0,0,0,,Ха…
Dialogue: 0,1:28:31.01,1:28:32.26,Default,,0,0,0,,…
Dialogue: 0,1:28:40.23,1:28:41.60,Default,,0,0,0,,Егер сіз оны қойсаңыз...
Dialogue: 0,1:28:41.69,1:28:43.15,Default,,0,0,0,,Мен сені атып тастаймын
Dialogue: 0,1:28:43.23,1:28:44.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:46.90,1:28:47.94,Default,,0,0,0,,...
Dialogue: 0,1:28:49.65,1:28:52.41,Default,,0,0,0,,Бұл оның сүйікті гүлі болды.
Dialogue: 0,1:28:53.03,1:28:55.70,Default,,0,0,0,,Мен сіздің құрбандық шалғаныңызды қаламаймын.
Dialogue: 0,1:28:55.78,1:28:57.79,Default,,0,0,0,,Сіз оны өлтірген болуыңыз керек.
Dialogue: 0,1:28:58.87,1:28:59.91,Default,,0,0,0,,Жоғал
Dialogue: 0,1:29:00.58,1:29:01.79,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:02.42,1:29:04.54,Default,,0,0,0,,Қайтадан бастайық.
Dialogue: 0,1:29:07.21,1:29:09.38,Default,,0,0,0,,Кешіріңіз, жас ханым.
Dialogue: 0,1:29:16.76,1:29:18.93,Default,,0,0,0,,Рё Саеба есімі...
Dialogue: 0,1:29:19.02,1:29:20.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:21.93,1:29:24.15,Default,,0,0,0,,Сізге ұнаған сияқты.
Dialogue: 0,1:29:27.69,1:29:29.65,Default,,0,0,0,,♪~
Dialogue: 0,1:29:29.73,1:29:32.03,Default,,0,0,0,,Бір күні тағы кездесейік
Dialogue: 0,1:33:19.71,1:33:25.72,Default,,0,0,0,,~♪
Dialogue: 0,1:33:31.14,1:33:32.48,Default,,0,0,0,,-（）  -（）
Dialogue: 0,1:33:32.56,1:33:35.65,Default,,0,0,0,,Сіз сол кезде не айтқыңыз келді?
Dialogue: 0,1:33:35.73,1:33:37.19,Default,,0,0,0,,Сол кезде ше?
Dialogue: 0,1:33:37.27,1:33:40.78,Default,,0,0,0,,Сонымен, сен маған бірдеңе айтқың келді!
Dialogue: 0,1:33:41.28,1:33:43.86,Default,,0,0,0,,Бұл... сен әдеттегіден басқаша көрінесің.
Dialogue: 0,1:33:44.36,1:33:46.49,Default,,0,0,0,,Менің ойымша?
Dialogue: 0,1:33:46.91,1:33:49.49,Default,,0,0,0,,Міне, тез арада ақымақ боласың.
Dialogue: 0,1:33:49.58,1:33:51.04,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:33:53.66,1:33:56.13,Default,,0,0,0,,Мен өлмеймін
Dialogue: 0,1:34:01.26,1:34:02.47,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:34:03.97,1:34:09.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory