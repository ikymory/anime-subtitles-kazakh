Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.52,0:00:25.27,Default,,0,0,0,,Үміт тілеп, қарғысты қабылда
Dialogue: 0,0:00:25.35,0:00:27.61,Default,,0,0,0,,Соғысты жалғастыратындар бар
Dialogue: 0,0:00:27.69,0:00:29.44,Default,,0,0,0,,Бұл сиқырлы қыз
Dialogue: 0,0:00:30.98,0:00:35.61,Default,,0,0,0,,Ғажайыпқа жетудің құны ретінде шайқасқа сотталған жан.
Dialogue: 0,0:00:36.24,0:00:39.28,Default,,0,0,0,,Соңғы нәтиже - жойылу арқылы рельеф
Dialogue: 0,0:00:39.91,0:00:44.41,Default,,0,0,0,,Бұл дүниеден жоғалу арқылы біз үмітсіздіктің себеп-салдарынан құтыламыз.
Dialogue: 0,0:00:46.67,0:00:48.71,Default,,0,0,0,,Дүние жүзінен келген әйелдер
Dialogue: 0,0:00:48.79,0:00:51.21,Default,,0,0,0,,Тілектеріңіз орындалсын
Dialogue: 0,0:00:51.30,0:00:53.13,Default,,0,0,0,,Санап болмайтын әйел
Dialogue: 0,0:00:53.21,0:00:55.01,Default,,0,0,0,,Құбыжықтармен күрес
Dialogue: 0,0:00:55.09,0:00:57.97,Default,,0,0,0,,Ақырында бәрі соңынан ерді.
Dialogue: 0,0:00:58.60,0:01:00.76,Default,,0,0,0,,Күннің ақыры бір күні келеді
Dialogue: 0,0:01:01.26,0:01:03.60,Default,,0,0,0,,«Шеңбер принципі» бойынша басшылықты күту
Dialogue: 0,0:01:04.10,0:01:06.06,Default,,0,0,0,,Біз күресуді жалғастырамыз
Dialogue: 0,0:01:07.77,0:01:10.44,Default,,0,0,0,,Сиқырлы құдай оянды
Dialogue: 0,0:01:10.52,0:01:12.94,Default,,0,0,0,,Барлық сиқырлы қыздар...
Dialogue: 0,0:01:13.07,0:01:15.74,Default,,0,0,0,,Тек қайғы мен жек көрушілікті қайталау —
Dialogue: 0,0:01:15.82,0:01:17.95,Default,,0,0,0,,Осы үмітсіз дүниеде
Dialogue: 0,0:01:18.95,0:01:24.29,Default,,0,0,0,,Сол сағыныш күлкіні қайта кездестіруді армандау
Dialogue: 0,0:02:26.60,0:02:27.77,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:28.35,0:02:29.19,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:02:30.52,0:02:32.11,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:49.66,0:02:50.46,Default,,0,0,0,,Хехе
Dialogue: 0,0:02:51.75,0:02:52.25,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:02:55.92,0:02:56.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:09.02,0:03:10.73,Default,,0,0,0,,Бинго, Мадока!
Dialogue: 0,0:03:17.65,0:03:19.74,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:03:47.35,0:03:54.23,Default,,0,0,0,,♪ Таңертең түс көремін
Dialogue: 0,0:03:54.73,0:03:59.03,Default,,0,0,0,,♪ Әлі емес, әлі жоқ.
Dialogue: 0,0:03:59.11,0:04:03.15,Default,,0,0,0,,♪ Таң қандай түсті болады?
Dialogue: 0,0:04:03.24,0:04:07.66,Default,,0,0,0,,♪ Әлі емес, әлі жоқ.
Dialogue: 0,0:04:07.74,0:04:11.91,Default,,0,0,0,,♪ Мен бүгін кешкі тамақты әлі жарты жолдамын.
Dialogue: 0,0:04:12.00,0:04:19.00,Default,,0,0,0,,♪ Ұйықтап жатқан бала қайда?
Dialogue: 0,0:04:21.84,0:04:26.80,Default,,0,0,0,,♪ Қайырлы таң Nightmare
Dialogue: 0,0:04:27.30,0:04:31.06,Default,,0,0,0,,♪ Жаман армандар
Dialogue: 0,0:04:32.31,0:04:37.36,Default,,0,0,0,,♪ Міне
Dialogue: 0,0:04:43.11,0:04:43.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:47.57,0:04:48.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:52.41,0:04:55.33,Default,,0,0,0,,Хаа~ Таң болды ма?
Dialogue: 0,0:04:57.29,0:04:58.92,Default,,0,0,0,,Қайырлы таң Күйбей
Dialogue: 0,0:04:59.63,0:05:00.38,Default,,0,0,0,,Cu?
Dialogue: 0,0:05:01.34,0:05:01.84,Default,,0,0,0,,Кю
Dialogue: 0,0:05:04.55,0:05:06.05,Default,,0,0,0,,Қайырлы таң әке
Dialogue: 0,0:05:06.13,0:05:07.68,Default,,0,0,0,,Қайырлы таң Мадока
Dialogue: 0,0:05:07.76,0:05:08.47,Default,,0,0,0,,Анам ше?
Dialogue: 0,0:05:08.97,0:05:10.51,Default,,0,0,0,,Тацуя бара жатыр
Dialogue: 0,0:05:10.60,0:05:11.93,Default,,0,0,0,,Маған көмектес
Dialogue: 0,0:05:12.02,0:05:13.06,Default,,0,0,0,,Иә
Dialogue: 0,0:05:14.02,0:05:14.81,Default,,0,0,0,,Иә
Dialogue: 0,0:05:14.89,0:05:17.10,Default,,0,0,0,,Мама! Мама!
Dialogue: 0,0:05:17.19,0:05:19.86,Default,,0,0,0,,Ах! Ахх!
Dialogue: 0,0:05:20.48,0:05:24.07,Default,,0,0,0,,Мама! Мама!
Dialogue: 0,0:05:28.36,0:05:29.37,Default,,0,0,0,,Оян!
Dialogue: 0,0:05:29.45,0:05:31.62,Default,,0,0,0,,Уау! О!
Dialogue: 0,0:05:33.37,0:05:34.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:34.08,0:05:35.54,Default,,0,0,0,,(Ағып жатқан судың дыбысы)
Dialogue: 0,0:05:37.75,0:05:39.42,Default,,0,0,0,,Соңғы уақытта не істедіңіз?
Dialogue: 0,0:05:39.50,0:05:41.54,Default,,0,0,0,,Хитоми-чан аздап қиын
Dialogue: 0,0:05:41.63,0:05:44.55,Default,,0,0,0,,Мен сіздің кестеңіз Камиджоу-кунға сәйкес келмейтінін естідім.
Dialogue: 0,0:05:44.63,0:05:45.63,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:05:45.72,0:05:49.55,Default,,0,0,0,,Нағыз қиыншылық танысқаннан кейін келеді.
Dialogue: 0,0:05:49.64,0:05:52.51,Default,,0,0,0,,Берілме, асықпа, берілме
Dialogue: 0,0:05:55.68,0:05:56.27,Default,,0,0,0,,Хой
Dialogue: 0,0:05:56.35,0:05:57.94,Default,,0,0,0,,Мұғалім, сәл күте тұрыңыз.
Dialogue: 0,0:05:58.02,0:06:00.52,Default,,0,0,0,,Олар кенеттен ақырзаман туралы айта бастайды.
Dialogue: 0,0:06:00.61,0:06:03.07,Default,,0,0,0,,Мүмкін ол шынымен де депрессияға ұшыраған шығар.
Dialogue: 0,0:06:03.15,0:06:04.53,Default,,0,0,0,,Ача~
Dialogue: 0,0:06:04.61,0:06:08.07,Default,,0,0,0,,Жақында мен мұнда бірдеңе орнатамын деп ойлаймын.
Dialogue: 0,0:06:09.82,0:06:12.87,Default,,0,0,0,,Кадзуко Сенсей, сен неге танымал емессің?
Dialogue: 0,0:06:12.95,0:06:15.33,Default,,0,0,0,,Кейбір өте сүйкімді бөліктер бар.
Dialogue: 0,0:06:15.41,0:06:18.21,Default,,0,0,0,,Ол әрқашан тым үлкен үміт артқан.
Dialogue: 0,0:06:18.71,0:06:21.54,Default,,0,0,0,,Жақсы болсын, жаман болсын, ымыраға келме.
Dialogue: 0,0:06:22.04,0:06:22.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:26.92,0:06:28.67,Default,,0,0,0,,Жарайсыңдар! Ха
Dialogue: 0,0:06:29.72,0:06:34.47,Default,,0,0,0,,Әй, бүгін ауысатын студент келеді.
Dialogue: 0,0:06:34.56,0:06:37.48,Default,,0,0,0,,Иә, мұндай уақытта бұл ерекше емес пе?
Dialogue: 0,0:06:38.56,0:06:39.94,Default,,0,0,0,,Ол қандай бала?
Dialogue: 0,0:06:40.44,0:06:42.69,Default,,0,0,0,,Біз дос бола аламыз деп үміттенемін
Dialogue: 0,0:06:47.03,0:06:49.45,Default,,0,0,0,,Кю~ Кю Кю
Dialogue: 0,0:06:49.53,0:06:51.66,Default,,0,0,0,,Ахх
Dialogue: 0,0:06:52.16,0:06:54.24,Default,,0,0,0,,Ах! Және...
Dialogue: 0,0:06:54.74,0:06:55.33,Default,,0,0,0,,Қауіпсіз
Dialogue: 0,0:06:56.24,0:06:58.25,Default,,0,0,0,,Иә, тамақ қалдықтарын қалдырмай жей беріңіз.
Dialogue: 0,0:06:58.33,0:06:59.75,Default,,0,0,0,,Ах~
Dialogue: 0,0:07:00.25,0:07:02.04,Default,,0,0,0,,Тағы бір шыны кофе туралы не деуге болады?
Dialogue: 0,0:07:04.54,0:07:05.96,Default,,0,0,0,,Иә, жоқ.
Dialogue: 0,0:07:09.30,0:07:10.01,Default,,0,0,0,,(сүю дыбысы)
Dialogue: 0,0:07:10.09,0:07:11.30,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:13.47,0:07:14.05,Default,,0,0,0,,(сүю дыбысы)
Dialogue: 0,0:07:17.01,0:07:19.60,Default,,0,0,0,,Ой! Сосын мен барамын
Dialogue: 0,0:07:20.10,0:07:22.23,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:07:22.31,0:07:24.27,Default,,0,0,0,,Жүр, Мадока, біз асығуымыз керек.
Dialogue: 0,0:07:24.36,0:07:25.73,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:07:26.90,0:07:28.03,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:07:28.11,0:07:30.57,Default,,0,0,0,,Қош келдіңіз! Рақмет сізге!
Dialogue: 0,0:07:32.28,0:07:34.16,Default,,0,0,0,,Кю фуфуфуфу
Dialogue: 0,0:07:35.58,0:07:37.58,Default,,0,0,0,,♪～
Dialogue: 0,0:09:05.71,0:09:07.71,Default,,0,0,0,,～♪
Dialogue: 0,0:09:14.13,0:09:15.30,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:09:15.38,0:09:16.51,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:17.09,0:09:17.72,Default,,0,0,0,,Иә
Dialogue: 0,0:09:17.80,0:09:20.01,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:22.06,0:09:22.56,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:22.64,0:09:24.77,Default,,0,0,0,,Кеттік, Мадока.
Dialogue: 0,0:09:25.60,0:09:26.98,Default,,0,0,0,,Yube-дегі қажырлы жұмысыңыз үшін рахмет~
Dialogue: 0,0:09:27.69,0:09:28.48,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:32.23,0:09:34.90,Default,,0,0,0,,Сен кеше бір қызбен үйге бардың хахахаха
Dialogue: 0,0:09:35.49,0:09:37.15,Default,,0,0,0,,Содан бері дұрыс ұйықтай алдыңыз ба?
Dialogue: 0,0:09:37.24,0:09:38.49,Default,,0,0,0,,Кез келген жағдайда.
Dialogue: 0,0:09:38.57,0:09:41.20,Default,,0,0,0,,Бірақ бүгінгі үй тапсырмасын орындауға уақытым болмады.
Dialogue: 0,0:09:41.28,0:09:43.24,Default,,0,0,0,,Егер дұрыс түсінсеңіз, ол нашар болуы мүмкін.
Dialogue: 0,0:09:43.33,0:09:45.16,Default,,0,0,0,,Әлі де жақсырақ, солай емес пе?
Dialogue: 0,0:09:45.25,0:09:48.08,Default,,0,0,0,,Мен барлық үй тапсырмасын орындадым.
Dialogue: 0,0:09:48.17,0:09:51.25,Default,,0,0,0,,Құдай-ау, шындап хаха хехе
Dialogue: 0,0:09:51.34,0:09:53.92,Default,,0,0,0,,Эй Мадока, кейінірек суретке түсуге рұқсат етіңіз, жарай ма?
Dialogue: 0,0:09:54.01,0:09:57.68,Default,,0,0,0,,Сәлем! Мадоканың мұндай қулыққа араласуына жол берме!
Dialogue: 0,0:09:57.76,0:10:00.22,Default,,0,0,0,,Себебі сен маған көрсетпейсің.
Dialogue: 0,0:10:00.80,0:10:03.85,Default,,0,0,0,,Көбінесе үй тапсырмасын өз бетімше орындаймын.
Dialogue: 0,0:10:03.93,0:10:06.14,Default,,0,0,0,,Саяқа ең сорақысы емес пе?
Dialogue: 0,0:10:06.23,0:10:08.77,Default,,0,0,0,,Үйге келе сала бірге жасаймыз дедім.
Dialogue: 0,0:10:08.85,0:10:10.98,Default,,0,0,0,,Теледидар көргенің үшін сен кінәлісің!
Dialogue: 0,0:10:11.06,0:10:13.86,Default,,0,0,0,,Ей... Әй, эй, екеуің...
Dialogue: 0,0:10:13.94,0:10:14.69,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:10:14.78,0:10:17.78,Default,,0,0,0,,Өйткені, сиқырлы қыз болу мен мектепке баруды теңестіру мүмкін емес.
Dialogue: 0,0:10:17.86,0:10:20.07,Default,,0,0,0,,Менің ойнауға уақытым жоқ.
Dialogue: 0,0:10:20.16,0:10:22.66,Default,,0,0,0,,Біріншіден, «Қызық болайық» деген ой біртүрлі екен!
Dialogue: 0,0:10:22.74,0:10:24.74,Default,,0,0,0,,Мен ойнағым келеді!
Dialogue: 0,0:10:24.83,0:10:25.49,Default,,0,0,0,,Cu
Dialogue: 0,0:10:25.58,0:10:27.96,Default,,0,0,0,,Міне! Күте тұрыңыз!
Dialogue: 0,0:10:31.38,0:10:32.13,Default,,0,0,0,,(Казуконың жөтелі)
Dialogue: 0,0:10:32.21,0:10:33.42,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:10:33.50,0:10:36.51,Default,,0,0,0,,Майя күнтізбесі болжаған ақырзаманнан аман қалғанымыз үшін.
Dialogue: 0,0:10:36.59,0:10:38.13,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:10:38.22,0:10:40.80,Default,,0,0,0,,Жоқ, жоқ, әлі алыс.
Dialogue: 0,0:10:41.89,0:10:43.80,Default,,0,0,0,,Белгілі бір діни мерекеге сәйкес келу
Dialogue: 0,0:10:43.89,0:10:46.93,Default,,0,0,0,,Күн мен Айдың тұтылуы алты рет болады деген әңгіме.
Dialogue: 0,0:10:47.02,0:10:49.56,Default,,0,0,0,,Бұл қорқынышты. Жаман.
Dialogue: 0,0:10:49.64,0:10:51.06,Default,,0,0,0,,Хехе... Ухехе
Dialogue: 0,0:10:51.65,0:10:55.57,Default,,0,0,0,,Ал 2050 жылға қарай не болады...
Dialogue: 0,0:10:56.28,0:10:57.69,Default,,0,0,0,,Иә, Наказава-кун!
Dialogue: 0,0:10:57.78,0:11:01.70,Default,,0,0,0,,Иә! Мм... жоқ, мен сенің не айтып тұрғаныңды білмеймін...
Dialogue: 0,0:11:01.78,0:11:02.99,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:11:03.49,0:11:06.33,Default,,0,0,0,,Бұл елде халықтың 41 пайызы
Dialogue: 0,0:11:06.41,0:11:10.21,Default,,0,0,0,,Құдай Ұлының 40 жылдан аз уақытта қайтатынына сенеді.
Dialogue: 0,0:11:10.29,0:11:13.21,Default,,0,0,0,,Ақырзаман кернейі естілуі мүмкін.
Dialogue: 0,0:11:16.05,0:11:17.96,Default,,0,0,0,,Жарайды, сэр.
Dialogue: 0,0:11:18.05,0:11:21.97,Default,,0,0,0,,Дүниенің ақыры болса жақсы болар еді деп ойлаймын.
Dialogue: 0,0:11:22.05,0:11:25.47,Default,,0,0,0,,Қазірдің өзінде ерлер мен әйелдердің қарым-қатынасы, махаббат және т.б. сияқты көптеген нәрселер бар.
Dialogue: 0,0:11:25.55,0:11:28.97,Default,,0,0,0,,Дөңгелектеп, 40 жаста дей берсең.
Dialogue: 0,0:11:29.06,0:11:32.60,Default,,0,0,0,,Бәрі бітсе жақсы болар еді...
Dialogue: 0,0:11:32.69,0:11:35.27,Default,,0,0,0,,Мм... Сенсей?
Dialogue: 0,0:11:35.36,0:11:35.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:36.07,0:11:37.65,Default,,0,0,0,,Иә, иә, қазір ойласам
Dialogue: 0,0:11:37.73,0:11:40.70,Default,,0,0,0,,Бүгін мен барлығына ауысатын студентті таныстыруым керек.
Dialogue: 0,0:11:40.78,0:11:42.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:42.11,0:11:43.66,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:11:44.24,0:11:46.74,Default,,0,0,0,,Ал, Әкеми-сан, қош келдің.
Dialogue: 0,0:11:50.50,0:11:51.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:51.33,0:11:51.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:52.04,0:11:52.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:55.08,0:11:56.54,Default,,0,0,0,,Бұл Хомура Акеми.
Dialogue: 0,0:11:57.04,0:11:58.71,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:11:58.80,0:12:02.88,Default,,0,0,0,,Акеми-сан жүрек ауруына байланысты ұзақ уақыт ауруханада жатты.
Dialogue: 0,0:12:02.97,0:12:06.35,Default,,0,0,0,,Сіздің мектепке барғаныңызға көп уақыт болды, сондықтан сіз көп нәрседен шатасып қалуыңыз мүмкін.
Dialogue: 0,0:12:06.43,0:12:09.01,Default,,0,0,0,,Барлығы, маған көмектесіңізші.
Dialogue: 0,0:12:09.10,0:12:10.73,Default,,0,0,0,,Иә
Dialogue: 0,0:12:10.81,0:12:11.56,Default,,0,0,0,,Иә
Dialogue: 0,0:12:12.35,0:12:13.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:13.73,0:12:14.73,Default,,0,0,0,,Жан дүниесі!
Dialogue: 0,0:12:14.81,0:12:16.81,Default,,0,0,0,,Сонда мен ол баланы...
Dialogue: 0,0:12:16.90,0:12:20.23,Default,,0,0,0,,Орынға келсек... жарайды, Наказава-кунның жанындағы орын бос.
Dialogue: 0,0:12:22.19,0:12:25.41,Default,,0,0,0,,Иә! Сонда Мами білді ме?
Dialogue: 0,0:12:25.49,0:12:26.99,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:12:27.07,0:12:30.29,Default,,0,0,0,,Бірақ мен бәрін таң қалдырғым келді.
Dialogue: 0,0:12:30.37,0:12:33.75,Default,,0,0,0,,Негізі мен сізге жеке сәлем беруім керек еді.
Dialogue: 0,0:12:33.83,0:12:36.88,Default,,0,0,0,,О, кез келген жағдайда, Юбенің кошмарын жойыңыз.
Dialogue: 0,0:12:36.96,0:12:39.71,Default,,0,0,0,,Біз оны бұрыштаған жерде ол бізді күтіп тұрды.
Dialogue: 0,0:12:39.80,0:12:41.01,Default,,0,0,0,,Мами ғана емес...
Dialogue: 0,0:12:41.09,0:12:44.72,Default,,0,0,0,,Иә, Акеми-сан да маған көмектесті.
Dialogue: 0,0:12:44.80,0:12:46.97,Default,,0,0,0,,Оның сиқыры керемет.
Dialogue: 0,0:12:47.05,0:12:51.06,Default,,0,0,0,,Шабуыл күші комбинациялар арқылы бірнеше рет қысылуы мүмкін.
Dialogue: 0,0:12:51.14,0:12:53.93,Default,,0,0,0,,Мен... Қолымнан келгені тек сені қолдау.
Dialogue: 0,0:12:54.02,0:12:56.02,Default,,0,0,0,,Шабуылдың өзі қаракиши.
Dialogue: 0,0:12:56.10,0:12:58.44,Default,,0,0,0,,Иә, бірақ бұл сенімді.
Dialogue: 0,0:12:58.52,0:13:01.19,Default,,0,0,0,,Соңғы уақытта үлкен Nightmares көп шығып жатыр.
Dialogue: 0,0:13:01.28,0:13:02.57,Default,,0,0,0,,Ол пайдаланылды
Dialogue: 0,0:13:02.65,0:13:06.24,Default,,0,0,0,,Егер сіздің қабілетіңіз кеше дәлелденсе.
Dialogue: 0,0:13:06.32,0:13:08.37,Default,,0,0,0,,Менің де шағымданатын ештеңем жоқ.
Dialogue: 0,0:13:08.45,0:13:10.87,Default,,0,0,0,,Бұл қайтадан Хомура Акеми.
Dialogue: 0,0:13:10.95,0:13:14.41,Default,,0,0,0,,Бұдан былай біз сіздермен бірге осы қаланың түнгі түндеріне қарсы күресеміз.
Dialogue: 0,0:13:14.50,0:13:16.17,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:13:17.21,0:13:18.25,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.33,0:13:18.83,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:20.25,0:13:21.05,Default,,0,0,0,,Ах
Dialogue: 0,0:13:21.13,0:13:23.55,Default,,0,0,0,,Барымызды бірге жасайық, Хомура-чан
Dialogue: 0,0:13:24.13,0:13:25.05,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:25.13,0:13:27.72,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:13:43.53,0:13:44.82,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:13:44.90,0:13:45.40,Default,,0,0,0,,Иә
Dialogue: 0,0:13:48.74,0:13:52.62,Default,,0,0,0,,Хомура-чанның бұл мектепке ауысқанына бір ай болды.
Dialogue: 0,0:13:52.70,0:13:53.74,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:13:53.83,0:13:56.29,Default,,0,0,0,,Мен мәңгі бірге болатындай сезінемін.
Dialogue: 0,0:13:56.37,0:13:58.42,Default,,0,0,0,,Өте тез өтіп кеткендей.
Dialogue: 0,0:13:58.50,0:13:59.96,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:00.04,0:14:04.30,Default,,0,0,0,,Мен бүгін түнде түнде түнгі ұйқысыз бәрі бақытты ұйықтай алады деп үміттенемін.
Dialogue: 0,0:14:04.38,0:14:05.92,Default,,0,0,0,,Кю~
Dialogue: 0,0:14:06.01,0:14:07.34,Default,,0,0,0,,Кю~
Dialogue: 0,0:14:07.42,0:14:08.63,Default,,0,0,0,,Бұл біртүрлі
Dialogue: 0,0:14:09.13,0:14:10.09,Default,,0,0,0,,Осы сияқты
Dialogue: 0,0:14:11.10,0:14:14.27,Default,,0,0,0,,Мен Хомура-чанмен жай сөйлескім келеді.
Dialogue: 0,0:14:14.35,0:14:16.23,Default,,0,0,0,,Мен әрқашан осылай ойлаған сияқтымын
Dialogue: 0,0:14:16.31,0:14:19.23,Default,,0,0,0,,Бұл ештеңе болмаса да, біртүрлі.
Dialogue: 0,0:14:19.31,0:14:22.11,Default,,0,0,0,,Ертең мектепте тағы кездесеміз.
Dialogue: 0,0:14:22.19,0:14:23.90,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:23.98,0:14:25.94,Default,,0,0,0,,Бірақ мен де солаймын.
Dialogue: 0,0:14:26.44,0:14:31.53,Default,,0,0,0,,Мадокамен уақыт өткізу үшін осы сәтті күткендей болдым.
Dialogue: 0,0:14:33.08,0:14:37.75,Default,,0,0,0,,(Жел шуы)
Dialogue: 0,0:14:44.88,0:14:45.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:46.42,0:14:47.30,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:14:47.38,0:14:52.97,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:14:54.39,0:14:58.31,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:14:58.81,0:15:00.39,Default,,0,0,0,,Иә Моши Моши (Хитоми) Ах!
Dialogue: 0,0:15:00.48,0:15:03.40,Default,,0,0,0,,А... Сәлеметсіз бе, Камиджоу-кун?
Dialogue: 0,0:15:03.48,0:15:06.03,Default,,0,0,0,,Қазір уақытыңыз бар ма?
Dialogue: 0,0:15:06.11,0:15:08.44,Default,,0,0,0,,Эй, Шизуки-сан, не болды?
Dialogue: 0,0:15:08.53,0:15:11.07,Default,,0,0,0,,Түнде келгенім үшін кешіріңіз.
Dialogue: 0,0:15:11.16,0:15:12.16,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:13.24,0:15:17.49,Default,,0,0,0,,Осы жексенбіге жоспарларыңыз бар ма?
Dialogue: 0,0:15:21.12,0:15:22.63,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:15:22.71,0:15:25.34,Default,,0,0,0,,Мен де сол күнді сабаққа пайдалануым керек.
Dialogue: 0,0:15:25.42,0:15:28.30,Default,,0,0,0,,Келесі презентацияға аз уақыт қалды.
Dialogue: 0,0:15:28.38,0:15:29.84,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:15:30.34,0:15:33.18,Default,,0,0,0,,Уақыт әрқашан дұрыс бола бермейтіні үшін кешірім сұраймын.
Dialogue: 0,0:15:33.26,0:15:35.72,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:15:35.80,0:15:38.60,Default,,0,0,0,,Еңбек етіп жүрген Камиджоу-кунды ойлап отырмын.
Dialogue: 0,0:15:38.68,0:15:40.27,Default,,0,0,0,,Себебі мен сені жақсы көремін!
Dialogue: 0,0:15:41.10,0:15:42.23,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:15:42.31,0:15:45.44,Default,,0,0,0,,Иә, ертең мектепте кездескенше.
Dialogue: 0,0:15:45.52,0:15:48.19,Default,,0,0,0,,Иә, қайырлы түн.
Dialogue: 0,0:15:48.28,0:15:49.15,Default,,0,0,0,,(Қоңырау ажыратылған дыбыс)
Dialogue: 0,0:15:51.32,0:15:52.32,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:57.12,0:15:58.45,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:58.54,0:16:03.21,Default,,0,0,0,,Әрқашан аянбай еңбек ететін Камиджо-кун өте сүйкімді және сүйкімді.
Dialogue: 0,0:16:03.29,0:16:05.33,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:16:06.17,0:16:07.46,Default,,0,0,0,,көрінгендей, шамамен 36 дана шығады.
Dialogue: 0,0:16:08.17,0:16:10.88,Default,,0,0,0,,Мен үшін қолыңнан келгеннің бәрін жасасаң да
Dialogue: 0,0:16:10.97,0:16:12.38,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:16:12.47,0:16:13.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:19.56,0:16:21.31,Default,,0,0,0,,Не? Денің сау ма? (Миямура) Иә.
Dialogue: 0,0:16:21.81,0:16:24.19,Default,,0,0,0,,Маған енді жексенбі керек емес!
Dialogue: 0,0:16:25.44,0:16:28.57,Default,,0,0,0,,Қайырлы әңгіме болмаса жақсы болар еді.
Dialogue: 0,0:16:29.57,0:16:30.65,Default,,0,0,0,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:16:30.73,0:16:33.03,Default,,0,0,0,,Мен… Мен…
Dialogue: 0,0:16:50.00,0:16:56.72,Default,,0,0,0,,(Мамидың ызылдағаны)
Dialogue: 0,0:16:56.80,0:16:58.18,Default,,0,0,0,,(Бебенің дауысы)
Dialogue: 0,0:16:58.68,0:17:01.31,Default,,0,0,0,,Бебе, мына шаш қыстырғышын берші
Dialogue: 0,0:17:02.85,0:17:03.64,Default,,0,0,0,,Мобет
Dialogue: 0,0:17:05.19,0:17:06.02,Default,,0,0,0,,Губе!
Dialogue: 0,0:17:06.90,0:17:07.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:11.78,0:17:13.82,Default,,0,0,0,,Тағы да не?
Dialogue: 0,0:17:17.03,0:17:18.16,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:18.24,0:17:19.16,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:17:21.74,0:17:23.66,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:17:23.75,0:17:27.12,Default,,0,0,0,,Кеш тұру – сұлулықтың табиғи жауы.
Dialogue: 0,0:17:37.76,0:17:41.39,Default,,0,0,0,,Эй, бұл Хитоми Шизукидің түнгі түні ме?
Dialogue: 0,0:17:41.97,0:17:44.06,Default,,0,0,0,,Хитоми де қиналып жатыр~
Dialogue: 0,0:17:44.14,0:17:47.44,Default,,0,0,0,,Сондықтан мен осындай сезімсіз адамды жігітіме айналдырдым.
Dialogue: 0,0:17:47.52,0:17:50.23,Default,,0,0,0,,Ой, сенің айтқаныңның салмағы бөлек.
Dialogue: 0,0:17:50.31,0:17:51.52,Default,,0,0,0,,Эххе
Dialogue: 0,0:17:51.61,0:17:55.40,Default,,0,0,0,,Ал не? Сіздің өмірлік тәжірибеңіз қандай?
Dialogue: 0,0:17:55.49,0:17:56.78,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:17:56.86,0:17:58.41,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:18:00.28,0:18:02.20,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:03.66,0:18:07.83,Default,,0,0,0,,Екеуің ойнап, байыппен қабылдамасаңдар, қауіпті.
Dialogue: 0,0:18:07.92,0:18:09.08,Default,,0,0,0,,Иә
Dialogue: 0,0:18:09.58,0:18:10.96,Default,,0,0,0,,Мадока мен Хомура?
Dialogue: 0,0:18:11.54,0:18:13.50,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз!
Dialogue: 0,0:18:14.92,0:18:16.67,Default,,0,0,0,,Екеуің де баяусыңдар!
Dialogue: 0,0:18:16.76,0:18:19.76,Default,,0,0,0,,Хехехе, кешіріңіз, Саяка-чан.
Dialogue: 0,0:18:20.64,0:18:22.47,Default,,0,0,0,,Сықырлау~
Dialogue: 0,0:18:23.06,0:18:24.39,Default,,0,0,0,,Гавк Гаук
Dialogue: 0,0:18:28.14,0:18:29.31,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.65,0:18:33.15,Default,,0,0,0,,Кәне, кеттік, бәріміз!
Dialogue: 0,0:18:34.15,0:18:35.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:16.27,0:21:19.11,Default,,0,0,0,,Пуэлла Маги Қасиетті Квинтет!
Dialogue: 0,0:21:29.28,0:21:30.28,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:21:41.42,0:21:42.00,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:44.09,0:21:45.67,Default,,0,0,0,,Мадока! Томе мырза!
Dialogue: 0,0:21:45.76,0:21:47.09,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:47.18,0:21:47.68,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:49.97,0:21:51.72,Default,,0,0,0,,Хомура-чан өтінемін!
Dialogue: 0,0:21:52.35,0:21:52.85,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:52.93,0:21:53.77,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:22:10.32,0:22:11.78,Default,,0,0,0,,Тило дуэт!
Dialogue: 0,0:22:16.04,0:22:16.71,Default,,0,0,0,,Босатыңыз!
Dialogue: 0,0:22:41.40,0:22:44.98,Default,,0,0,0,,Сенің сезіміңді түсінемін, бірақ Хитомиді тыныштандыр!
Dialogue: 0,0:22:47.15,0:22:48.24,Default,,0,0,0,,Гомейсама
Dialogue: 0,0:22:49.36,0:22:51.24,Default,,0,0,0,,Лилиан!
Dialogue: 0,0:22:51.32,0:22:52.28,Default,,0,0,0,,Киоко!
Dialogue: 0,0:22:52.37,0:22:52.95,Default,,0,0,0,,Иә
Dialogue: 0,0:22:53.70,0:22:54.95,Default,,0,0,0,,Амико Микакай!
Dialogue: 0,0:23:07.51,0:23:09.22,Default,,0,0,0,,Қозғалыс тоқтады!
Dialogue: 0,0:23:10.38,0:23:13.01,Default,,0,0,0,,Керемет жұмыс! Қане, бәріміз, аяқтаймыз!
Dialogue: 0,0:23:26.32,0:23:28.74,Default,,0,0,0,,Торт торты♪
Dialogue: 0,0:23:28.82,0:23:31.24,Default,,0,0,0,,Дөңгелек торт♪
Dialogue: 0,0:23:31.32,0:23:32.61,Default,,0,0,0,,Дөңгелек торт♪
Dialogue: 0,0:23:32.70,0:23:33.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:33.70,0:23:35.49,Default,,0,0,0,,Гааах!
Dialogue: 0,0:23:36.28,0:23:38.58,Default,,0,0,0,,Modu модуль jubebe?
Dialogue: 0,0:23:38.66,0:23:40.71,Default,,0,0,0,,Чи-га-у♪
Dialogue: 0,0:23:41.21,0:23:43.42,Default,,0,0,0,,Мен таңқураймын♪
Dialogue: 0,0:23:43.50,0:23:48.13,Default,,0,0,0,,Дөңгелек торт қызыл♪
Dialogue: 0,0:23:48.63,0:23:50.97,Default,,0,0,0,,Торт Киоко ма?
Dialogue: 0,0:23:51.05,0:23:53.09,Default,,0,0,0,,Чи~га~у♪
Dialogue: 0,0:23:53.59,0:23:57.97,Default,,0,0,0,,Мен алмамын♪
Dialogue: 0,0:23:58.72,0:24:03.10,Default,,0,0,0,,Маған Бебенің дөңгелек торты ұнайды♪
Dialogue: 0,0:24:03.73,0:24:05.15,Default,,0,0,0,,Торт - бұл Мама!
Dialogue: 0,0:24:06.19,0:24:08.11,Default,,0,0,0,,Чи-га-у♪
Dialogue: 0,0:24:08.69,0:24:10.94,Default,,0,0,0,,Мен сырмын♪
Dialogue: 0,0:24:11.03,0:24:15.70,Default,,0,0,0,,Дөңгелек торт өте суық♪
Dialogue: 0,0:24:15.78,0:24:17.95,Default,,0,0,0,,Торт Акеми-сан ба?
Dialogue: 0,0:24:18.70,0:24:20.08,Default,,0,0,0,,Жоқ...♪
Dialogue: 0,0:24:20.16,0:24:23.83,Default,,0,0,0,,Мен... мен асқабақпын♪
Dialogue: 0,0:24:23.92,0:24:27.79,Default,,0,0,0,,Дөңгелек торт тәтті♪
Dialogue: 0,0:24:28.80,0:24:31.09,Default,,0,0,0,,Торт Мадока ма?
Dialogue: 0,0:24:31.17,0:24:33.22,Default,,0,0,0,,Чи~га~у♪
Dialogue: 0,0:24:33.30,0:24:35.97,Default,,0,0,0,,Мен қауынмын♪
Dialogue: 0,0:24:36.05,0:24:40.31,Default,,0,0,0,,Қауын сынса, тәтті арман♪
Dialogue: 0,0:24:40.81,0:24:45.73,Default,,0,0,0,,Бүгінгі түннің түсі ащы түс♪
Dialogue: 0,0:24:45.81,0:24:50.32,Default,,0,0,0,,Табақтағы мысықтың арманы♪
Dialogue: 0,0:24:50.82,0:24:53.24,Default,,0,0,0,,Толығымен семіз♪
Dialogue: 0,0:24:53.32,0:24:56.20,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:25:01.12,0:25:03.91,Default,,0,0,0,,Mojo Pape~!
Dialogue: 0,0:25:04.75,0:25:05.42,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:25:09.79,0:25:10.75,Default,,0,0,0,,Могу!
Dialogue: 0,0:25:24.02,0:25:30.86,Default,,0,0,0,,Косэй тағы да күйреуге ұшырайды.
Dialogue: 0,0:26:12.32,0:26:13.73,Default,,0,0,0,,Фу…
Dialogue: 0,0:26:31.21,0:26:32.96,Default,,0,0,0,,Могу~
Dialogue: 0,0:26:33.04,0:26:33.67,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:26:33.75,0:26:34.67,Default,,0,0,0,,Сіз мұны істедіңіз!
Dialogue: 0,0:26:34.75,0:26:35.55,Default,,0,0,0,,Кю~!
Dialogue: 0,0:26:36.05,0:26:38.51,Default,,0,0,0,,Жақсы, егер бірге жұмыс жасасақ
Dialogue: 0,0:26:38.59,0:26:40.01,Default,,0,0,0,,Бұл өте қызық, солай емес пе?
Dialogue: 0,0:26:40.51,0:26:42.89,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз!
Dialogue: 0,0:26:43.39,0:26:44.56,Default,,0,0,0,,А... Иә
Dialogue: 0,0:26:45.22,0:26:47.60,Default,,0,0,0,,Бүгін де аздап қорықтым.
Dialogue: 0,0:26:48.10,0:26:50.06,Default,,0,0,0,,Осылай уағыз айтқаным үшін кешірім сұраймын.
Dialogue: 0,0:26:50.77,0:26:53.82,Default,,0,0,0,,Ал, торт пен шай болса ше?
Dialogue: 0,0:26:53.90,0:26:55.57,Default,,0,0,0,,Сәлем, Киоко!
Dialogue: 0,0:26:55.65,0:26:57.57,Default,,0,0,0,,Мен жақсы ештеңе айтып тұрған жоқпын!
Dialogue: 0,0:26:57.65,0:26:58.57,Default,,0,0,0,,Хехе
Dialogue: 0,0:26:58.65,0:26:59.95,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:27:00.66,0:27:02.32,Default,,0,0,0,,Бәрің менің үйіме келесіңдер ме?
Dialogue: 0,0:27:02.41,0:27:03.91,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:27:17.46,0:27:18.92,Default,,0,0,0,,Уау...
Dialogue: 0,0:27:51.08,0:27:53.33,Default,,0,0,0,,Хахаха, ой, сай, Саяка!
Dialogue: 0,0:27:53.42,0:27:55.46,Default,,0,0,0,,(Сая мен Киоконың күлкісі)
Dialogue: 0,0:27:56.21,0:27:58.88,Default,,0,0,0,,Дұрыс, кешегі түймедақ шайы.
Dialogue: 0,0:27:58.96,0:28:00.76,Default,,0,0,0,,Тағы бір доза қалды.
Dialogue: 0,0:28:00.84,0:28:03.68,Default,,0,0,0,,Уау~ Бұл өте дәмді болды.
Dialogue: 0,0:28:03.76,0:28:07.35,Default,,0,0,0,,Менің де жаңадан ашылған Exair...
Dialogue: 0,0:28:07.43,0:28:11.02,Default,,0,0,0,,Ех! Мен қышқыл болғым келмейді.
Dialogue: 0,0:28:11.10,0:28:14.31,Default,,0,0,0,,Хахаха Киоконың дәмі әлі балаға тән.
Dialogue: 0,0:28:14.40,0:28:16.23,Default,,0,0,0,,Не болды!
Dialogue: 0,0:28:18.19,0:28:21.86,Default,,0,0,0,,Иә, иә, Бебенің де сыйлығы бар.
Dialogue: 0,0:28:24.07,0:28:24.61,Default,,0,0,0,,Уау
Dialogue: 0,0:28:29.70,0:28:31.66,Default,,0,0,0,,Хомура-чан, не болды?
Dialogue: 0,0:28:31.75,0:28:34.79,Default,,0,0,0,,Не? Жоқ, ештеңе емес.
Dialogue: 0,0:28:34.87,0:28:36.04,Default,,0,0,0,,Хехехе
Dialogue: 0,0:28:40.76,0:28:42.55,Default,,0,0,0,,Біздің шайқас
Dialogue: 0,0:28:43.80,0:28:46.18,Default,,0,0,0,,Бұл... жақсы ма?
Dialogue: 0,0:30:13.26,0:30:16.27,Default,,0,0,0,,Эй, Хомура-чан, қуырылған тауық ше?
Dialogue: 0,0:30:16.35,0:30:17.69,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:30:18.81,0:30:19.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:30:19.77,0:30:20.90,Default,,0,0,0,,Хехе
Dialogue: 0,0:30:22.15,0:30:23.19,Default,,0,0,0,,Фу…
Dialogue: 0,0:30:59.89,0:31:01.98,Default,,0,0,0,,-де? Әңгіме қандай?
Dialogue: 0,0:31:02.06,0:31:03.69,Default,,0,0,0,,Ум, бұл...
Dialogue: 0,0:31:05.40,0:31:09.36,Default,,0,0,0,,Сакура-сан, соңғы кездері бірдеңе дұрыс болмады деп ойламайсың ба?
Dialogue: 0,0:31:09.45,0:31:12.37,Default,,0,0,0,,Иә? Не? Не?
Dialogue: 0,0:31:12.45,0:31:15.49,Default,,0,0,0,,Бұл... әйтеуір
Dialogue: 0,0:31:15.58,0:31:16.62,Default,,0,0,0,,Бірақ бәрі...
Dialogue: 0,0:31:16.70,0:31:19.83,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сенімен бәрі жақсы ма?
Dialogue: 0,0:31:19.91,0:31:20.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:20.79,0:31:24.54,Default,,0,0,0,,Мен бәрінен бұрын Сакура-санмен кеңестім.
Dialogue: 0,0:31:24.63,0:31:27.09,Default,,0,0,0,,Өйткені сен ең біртүрлісің...
Dialogue: 0,0:31:27.80,0:31:28.30,Default,,0,0,0,,Әй?
Dialogue: 0,0:31:28.38,0:31:31.72,Default,,0,0,0,,Сіз туралы менің алған әсерім және ол...
Dialogue: 0,0:31:31.80,0:31:33.97,Default,,0,0,0,,Сәйкессіздіктер өте көп.
Dialogue: 0,0:31:34.05,0:31:36.31,Default,,0,0,0,,Сакура-сан мұндай болған деп ойламаймын...
Dialogue: 0,0:31:36.39,0:31:38.47,Default,,0,0,0,,Эй, эй, не? Сіз
Dialogue: 0,0:31:38.56,0:31:40.89,Default,,0,0,0,,Бұл кездейсоқ төбелес кезінде сатылған ба?
Dialogue: 0,0:31:40.98,0:31:43.90,Default,,0,0,0,,Сакура-сан, сен қазір қайда тұрасың?
Dialogue: 0,0:31:43.98,0:31:46.44,Default,,0,0,0,,Мен Саяқаның үйінде тұрамын.
Dialogue: 0,0:31:46.52,0:31:48.23,Default,,0,0,0,,Сіз соншалықты көп білесіз, солай ма?
Dialogue: 0,0:31:48.32,0:31:50.32,Default,,0,0,0,,Митакара орта мектебіне қашан бара бастадыңыз?
Dialogue: 0,0:31:50.40,0:31:52.61,Default,,0,0,0,,Ол мұнда сізден бұрын көшіп келген.
Dialogue: 0,0:31:52.70,0:31:53.91,Default,,0,0,0,,Бұл қашан болды?
Dialogue: 0,0:31:53.99,0:31:54.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:55.45,0:31:58.91,Default,,0,0,0,,Мм, былтыр... ммм.
Dialogue: 0,0:32:02.71,0:32:03.88,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:32:04.46,0:32:06.13,Default,,0,0,0,,Бұл қашан болды?
Dialogue: 0,0:32:06.21,0:32:08.38,Default,,0,0,0,,Бірақ неге бұлай ойлайсың?
Dialogue: 0,0:32:08.46,0:32:10.76,Default,,0,0,0,,Митакараға келгенге дейін қайда бардыңыз?
Dialogue: 0,0:32:10.84,0:32:12.97,Default,,0,0,0,,Бұл көрші үйдегі Казумино.
Dialogue: 0,0:32:13.05,0:32:15.14,Default,,0,0,0,,Өйткені ол жақтағы қала тыныштық орнады.
Dialogue: 0,0:32:15.22,0:32:17.68,Default,,0,0,0,,Мәмидің жері көп әбігерге түсіп жатыр.
Dialogue: 0,0:32:17.76,0:32:18.89,Default,,0,0,0,,Сіз маған көмектесесіз бе?
Dialogue: 0,0:32:19.56,0:32:22.02,Default,,0,0,0,,Сіз Казумино қаласына жақында оралдыңыз ба?
Dialogue: 0,0:32:22.10,0:32:25.65,Default,,0,0,0,,Әй, менің басқа шаруам жоқ.
Dialogue: 0,0:32:30.57,0:32:32.74,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:32:40.29,0:32:44.46,Default,,0,0,0,,Сакура-сан, қазір менімен Казумино қаласына барғың келе ме?
Dialogue: 0,0:32:44.54,0:32:46.21,Default,,0,0,0,,Иә? Не үшін?
Dialogue: 0,0:32:46.29,0:32:48.75,Default,,0,0,0,,Барып көріңіз.
Dialogue: 0,0:32:48.84,0:32:52.09,Default,,0,0,0,,Егер бұл шынымен де сіз білетін қала болса
Dialogue: 0,0:32:52.17,0:32:53.13,Default,,0,0,0,,Кешірім сұраймын
Dialogue: 0,0:32:53.22,0:32:56.43,Default,,0,0,0,,Бұл жағдайда бәрі менің тарапымнан түсінбеушілік болды.
Dialogue: 0,0:32:56.51,0:32:59.14,Default,,0,0,0,,Мен оны түсінбеймін.
Dialogue: 0,0:32:59.22,0:33:02.89,Default,,0,0,0,,Сіз мені мазақ етіп жатқан сияқтысыз.
Dialogue: 0,0:33:02.98,0:33:04.73,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:33:05.73,0:33:06.60,Default,,0,0,0,,Иә
Dialogue: 0,0:33:07.27,0:33:08.11,Default,,0,0,0,,Хаа…
Dialogue: 0,0:33:11.23,0:33:14.70,Default,,0,0,0,,Туған жерімде мен баратын жақсы рамен мейрамханасы бар.
Dialogue: 0,0:33:15.20,0:33:16.99,Default,,0,0,0,,Маған сол жерден кешкі ас сатып ал.
Dialogue: 0,0:33:17.49,0:33:19.33,Default,,0,0,0,,Бұл шарт
Dialogue: 0,0:33:21.41,0:33:22.50,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:34:20.51,0:34:23.97,Default,,0,0,0,,Келесі аялдама Казумино қаласы.
Dialogue: 0,0:34:30.35,0:34:31.44,Default,,0,0,0,,(түсіру қоңырауы)
Dialogue: 0,0:34:31.52,0:34:34.61,Default,,0,0,0,,Келесі Митакара 3-чоме
Dialogue: 0,0:34:34.69,0:34:36.19,Default,,0,0,0,,Жан тыныштығы мен сенім...
Dialogue: 0,0:34:36.28,0:34:38.95,Default,,0,0,0,,Не? Жоқ, мұнда...
Dialogue: 0,0:34:39.53,0:34:41.53,Default,,0,0,0,,Мен солға бұрылуым керек еді!
Dialogue: 0,0:34:42.03,0:34:43.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:35:01.47,0:35:02.09,Default,,0,0,0,,Ах
Dialogue: 0,0:35:03.85,0:35:05.68,Default,,0,0,0,,Сіз дұрыс емес автобусқа отырдыңыз ба?
Dialogue: 0,0:35:06.31,0:35:07.64,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:35:08.14,0:35:10.39,Default,,0,0,0,,Сіз Казумино станциясына баратын пойызға отырдыңыз, солай ма?
Dialogue: 0,0:35:11.48,0:35:13.52,Default,,0,0,0,,Келесі автобуспен қайтайық.
Dialogue: 0,0:35:14.02,0:35:16.61,Default,,0,0,0,,Бұл жолы қателік жасамаңыз
Dialogue: 0,0:35:20.53,0:35:21.78,Default,,0,0,0,,Ах (Киоко) Ах
Dialogue: 0,0:35:26.04,0:35:28.54,Default,,0,0,0,,Бұл сөзсіз рас, солай ма?
Dialogue: 0,0:35:54.73,0:35:55.77,Default,,0,0,0,,(түсіру қоңырауы)
Dialogue: 0,0:35:55.86,0:35:58.28,Default,,0,0,0,,Келесі Митакара 2-чоме
Dialogue: 0,0:35:58.36,0:35:58.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:58.94,0:36:01.03,Default,,0,0,0,,Муниципалдық Митакара бастауыш мектебіне
Dialogue: 0,0:36:01.11,0:36:03.24,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:36:03.32,0:36:04.28,Default,,0,0,0,,(♪ «Twinkle, Twinkle, Little Star» әніне варияциялар»)
Dialogue: 0,0:36:09.12,0:36:10.37,Default,,0,0,0,,Ах! Эх...
Dialogue: 0,0:36:15.38,0:36:16.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:36:17.42,0:36:19.71,Default,,0,0,0,,Бір минут күтіңіз! Эй, мұнда!
Dialogue: 0,0:36:24.22,0:36:24.76,Default,,0,0,0,,Цк
Dialogue: 0,0:36:36.56,0:36:38.32,Default,,0,0,0,,Осындай нәрсе бар ма?
Dialogue: 0,0:36:38.40,0:36:40.44,Default,,0,0,0,,Келесі жолы жаяу жүріп тексерейік.
Dialogue: 0,0:36:40.94,0:36:43.15,Default,,0,0,0,,Жолда өткен үш жақты қиылыстан солға бұрылыңыз.
Dialogue: 0,0:36:43.65,0:36:46.37,Default,,0,0,0,,Демек, сіз Казуминоға жетуіңіз керек еді.
Dialogue: 0,0:36:46.45,0:36:47.45,Default,,0,0,0,,О
Dialogue: 0,0:37:04.26,0:37:05.13,Default,,0,0,0,,Эй
Dialogue: 0,0:37:05.22,0:37:06.64,Default,,0,0,0,,Сол үш жақты қиылысқа дейін
Dialogue: 0,0:37:06.72,0:37:08.64,Default,,0,0,0,,Ол соншалықты алыс болды ма?
Dialogue: 0,0:37:08.72,0:37:09.56,Default,,0,0,0,,Жоқ
Dialogue: 0,0:37:10.06,0:37:12.39,Default,,0,0,0,,Осы уақытқа дейін жеткеніміз біртүрлі болар еді.
Dialogue: 0,0:37:14.23,0:37:14.98,Default,,0,0,0,,Ах
Dialogue: 0,0:37:16.98,0:37:19.15,Default,,0,0,0,,Мен… қатты қорқып, Арбаларды шақыруды мүлде ұмытып кеттім
Dialogue: 0,0:37:20.02,0:37:21.44,Default,,0,0,0,,Сен де, мен де
Dialogue: 0,0:37:21.53,0:37:24.15,Default,,0,0,0,,Соншалықты үлкен үш жақты қиылыстан мен байқамай өтіп кеттім.
Dialogue: 0,0:37:24.24,0:37:26.07,Default,,0,0,0,,Мен сіздің ақымақ емес екеніңізге сенімдімін.
Dialogue: 0,0:37:26.16,0:37:28.78,Default,,0,0,0,,Бұл галлюцинация немесе басқа нәрсе ме?
Dialogue: 0,0:37:29.28,0:37:32.33,Default,,0,0,0,,Бізді Митакарадан аулақ ұстау үшін...
Dialogue: 0,0:37:32.41,0:37:32.91,Default,,0,0,0,,Ах
Dialogue: 0,0:37:33.70,0:37:36.42,Default,,0,0,0,,Мүмкін бұл оңай емес шығар.
Dialogue: 0,0:37:36.50,0:37:40.29,Default,,0,0,0,,Бұл Митакарада сыртта жоқ шығар.
Dialogue: 0,0:37:40.38,0:37:41.92,Default,,0,0,0,,Эй... эй
Dialogue: 0,0:37:43.38,0:37:47.93,Default,,0,0,0,,Сакура-сан, өтінемін, мұны біраз уақытқа дейін бәрінен құпия сақташы.
Dialogue: 0,0:37:48.01,0:37:51.22,Default,,0,0,0,,Мен әлі де өз бетімше зерттегім келетін бір нәрсе бар.
Dialogue: 0,0:37:51.31,0:37:53.77,Default,,0,0,0,,Идиот! Сіз бұл оғаш нәрсені жай қалдыра аласыз ба?
Dialogue: 0,0:37:54.27,0:37:55.23,Default,,0,0,0,,Жарайды
Dialogue: 0,0:37:55.31,0:37:59.19,Default,,0,0,0,,Мен мұны байқамадым деп айту қауіпсіз деп ойлаймын.
Dialogue: 0,0:37:59.27,0:38:00.73,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:38:02.98,0:38:05.03,Default,,0,0,0,,Керісінше, сіз неғұрлым нашар қозғалсаңыз, соғұрлым көп
Dialogue: 0,0:38:05.11,0:38:06.32,Default,,0,0,0,,Бұрышта тұру
Dialogue: 0,0:38:06.95,0:38:09.24,Default,,0,0,0,,Бұл қандай да бір тұзақ болса керек.
Dialogue: 0,0:38:09.32,0:38:11.49,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:38:11.58,0:38:12.41,Default,,0,0,0,,Иә
Dialogue: 0,0:38:12.95,0:38:14.91,Default,,0,0,0,,Ендеше бұдан былай қозғалып, көзге түскен дұрыс.
Dialogue: 0,0:38:15.71,0:38:17.92,Default,,0,0,0,,Бұдан былай оны маған қалдыр.
Dialogue: 0,0:38:24.96,0:38:27.34,Default,,0,0,0,,Бізді алдаған адам
Dialogue: 0,0:38:27.43,0:38:30.51,Default,,0,0,0,,Бүгінге дейін мен бұдан артық ештеңе істеген жоқпын.
Dialogue: 0,0:38:31.05,0:38:34.31,Default,,0,0,0,,Сіз сабырлы және алданған болсаңыз, ешқандай қауіп болмауы керек.
Dialogue: 0,0:38:34.81,0:38:37.39,Default,,0,0,0,,Ха... түсіндім.
Dialogue: 0,0:38:44.65,0:38:45.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:47.49,0:38:48.99,Default,,0,0,0,,Менің жадым
Dialogue: 0,0:38:49.07,0:38:52.16,Default,,0,0,0,,Шынында да кейбір сәйкессіздіктер болуы мүмкін.
Dialogue: 0,0:38:52.24,0:38:53.28,Default,,0,0,0,,Сакура-сан?
Dialogue: 0,0:38:53.78,0:38:55.54,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:38:55.62,0:38:59.33,Default,,0,0,0,,Мен Хомура Акемиді бірінші рет көріп тұрмын.
Dialogue: 0,0:38:59.92,0:39:02.46,Default,,0,0,0,,Мен оны мүлдем таң қалдырмаймын.
Dialogue: 0,0:39:02.54,0:39:05.09,Default,,0,0,0,,Керісінше, бұл дұрыс сияқты.
Dialogue: 0,0:39:05.59,0:39:06.46,Default,,0,0,0,,Иә
Dialogue: 0,0:39:08.72,0:39:10.55,Default,,0,0,0,,Уау! Аттто...
Dialogue: 0,0:39:10.63,0:39:11.59,Default,,0,0,0,,Ах
Dialogue: 0,0:39:12.34,0:39:13.10,Default,,0,0,0,,Иә
Dialogue: 0,0:39:15.85,0:39:18.56,Default,,0,0,0,,Бұл есімде жалғыз мен ғана қалдым ба?
Dialogue: 0,0:39:32.20,0:39:35.12,Default,,0,0,0,,Иә, мен бұл қулықты білемін.
Dialogue: 0,0:39:35.74,0:39:37.70,Default,,0,0,0,,Жабық фантомдық кеңістік
Dialogue: 0,0:39:37.79,0:39:41.62,Default,,0,0,0,,Жыртқышты азғырып, шатастыратын жолы жоқ лабиринт.
Dialogue: 0,0:39:49.17,0:39:51.18,Default,,0,0,0,,Бұл жердің...
Dialogue: 0,0:39:52.38,0:39:53.68,Default,,0,0,0,,Бұл сиқыршының тосқауылы.
Dialogue: 0,0:39:55.43,0:39:57.93,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:40:06.86,0:40:08.53,Default,,0,0,0,,«Сақсы», яғни
Dialogue: 0,0:40:09.15,0:40:11.78,Default,,0,0,0,,Үмітсіздікті тарататын апат хабаршысы
Dialogue: 0,0:40:18.62,0:40:19.66,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:40:19.75,0:40:24.29,Default,,0,0,0,,Үмітсіздікке батқан сиқырлы қыздардың қарғысқа ұшыраған түрі
Dialogue: 0,0:40:30.01,0:40:34.01,Default,,0,0,0,,Бір рет мен бір уақытты қайта-қайта қайталадым.
Dialogue: 0,0:40:34.09,0:40:36.89,Default,,0,0,0,,Мен сол қатыгез тағдырға қарсы тұру үшін күрестім.
Dialogue: 0,0:40:43.64,0:40:44.65,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:40:45.15,0:40:47.73,Default,,0,0,0,,Соңында қызды құрбан ету арқылы
Dialogue: 0,0:40:48.23,0:40:51.49,Default,,0,0,0,,Үміт пен үмітсіздіктің қатал тізбегі үзілді.
Dialogue: 0,0:40:53.24,0:40:57.74,Default,,0,0,0,,Дүниені жаңа принципке жетелеу керек еді
Dialogue: 0,0:41:06.88,0:41:07.79,Default,,0,0,0,,Бірақ
Dialogue: 0,0:41:08.63,0:41:10.55,Default,,0,0,0,,біз ұмытамыз
Dialogue: 0,0:41:10.63,0:41:13.30,Default,,0,0,0,,Жоқ, мен ұмытуға мәжбүр болдым.
Dialogue: 0,0:41:14.09,0:41:18.39,Default,,0,0,0,,Біреу біздің естеліктерімізді алдамақшы.
Dialogue: 0,0:41:19.39,0:41:23.06,Default,,0,0,0,,Осы жалған Митакара қаласында
Dialogue: 0,0:41:40.20,0:41:41.91,Default,,0,0,0,,Мобе джеже!
Dialogue: 0,0:41:41.99,0:41:44.46,Default,,0,0,0,,Уау, мен суланып қалдым.
Dialogue: 0,0:41:45.04,0:41:47.83,Default,,0,0,0,,Тым бұзық болсаң, Сырға айналасың.
Dialogue: 0,0:41:52.42,0:41:53.59,Default,,0,0,0,,Могу! (Мадока/Мами) Иә?
Dialogue: 0,0:41:54.09,0:41:55.01,Default,,0,0,0,,Моп?
Dialogue: 0,0:41:56.55,0:41:58.51,Default,,0,0,0,,(Мадока мен Мәмидің күлкісі)
Dialogue: 0,0:41:58.59,0:42:01.68,Default,,0,0,0,,Мами мен Бебе шынымен жақын, солай емес пе?
Dialogue: 0,0:42:02.18,0:42:05.14,Default,,0,0,0,,Ойлап қарасам, Мәми-санмен алғаш кездескенімде,
Dialogue: 0,0:42:05.23,0:42:06.56,Default,,0,0,0,,Сіз Бебемен бірге болдыңыз, солай ма?
Dialogue: 0,0:42:07.90,0:42:11.57,Default,,0,0,0,,Иә, Бебе ескі дос.
Dialogue: 0,0:42:11.65,0:42:12.78,Default,,0,0,0,,Моб!
Dialogue: 0,0:42:14.86,0:42:16.82,Default,,0,0,0,,Біз бұрыннан танысқанбыз
Dialogue: 0,0:42:17.53,0:42:20.70,Default,,0,0,0,,Біз бір-бірімізді Канаме-сан мен Мики-саннан бұрын білеміз.
Dialogue: 0,0:42:21.91,0:42:24.20,Default,,0,0,0,,Бебе Томое мырзаға не үшін келді?
Dialogue: 0,0:42:24.87,0:42:25.83,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:42:25.91,0:42:26.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:27.04,0:42:28.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:28.92,0:42:29.54,Default,,0,0,0,,Шындығында, Марио — Цезардың ер адамға қоятын идеалы еді
Dialogue: 0,0:42:36.22,0:42:36.88,Default,,0,0,0,,Иә
Dialogue: 0,0:42:37.68,0:42:39.43,Default,,0,0,0,,Аздап алаңдадым
Dialogue: 0,0:42:44.06,0:42:48.23,Default,,0,0,0,,Баяғыда сияқты.
Dialogue: 0,0:42:48.94,0:42:54.61,Default,,0,0,0,,Ол кезде мен Митакарадағы жалғыз сиқырлы қыз едім.
Dialogue: 0,0:42:54.69,0:42:58.36,Default,,0,0,0,,Жалғыз қалғанда мені қолдап, жігерлендірген
Dialogue: 0,0:42:58.45,0:42:59.78,Default,,0,0,0,,Тек Бебе болды.
Dialogue: 0,0:43:02.78,0:43:03.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:04.24,0:43:04.99,Default,,0,0,0,,Иә
Dialogue: 0,0:43:05.49,0:43:07.00,Default,,0,0,0,,Егер бұл бала мұнда болмаса
Dialogue: 0,0:43:07.08,0:43:09.58,Default,,0,0,0,,Менің ойымша, мен қазірдің өзінде бұзылдым.
Dialogue: 0,0:43:09.67,0:43:11.46,Default,,0,0,0,,Болды... Мәми-сан
Dialogue: 0,0:43:12.96,0:43:16.34,Default,,0,0,0,,Томое-сан күштірек және берік адам.
Dialogue: 0,0:43:16.42,0:43:17.97,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:43:18.47,0:43:22.43,Default,,0,0,0,,Мен сенімді аға ретінде әрекет еткен кезім болды.
Dialogue: 0,0:43:23.55,0:43:27.56,Default,,0,0,0,,Бірақ Канаме-сан мен Мики-сан толыққанды адамдарға айналды.
Dialogue: 0,0:43:28.06,0:43:31.23,Default,,0,0,0,,Сакура-сан мен Акеми-сан да біз жақта.
Dialogue: 0,0:43:32.02,0:43:35.65,Default,,0,0,0,,Қазір менің айналамда сенім арта алатын достарым бар.
Dialogue: 0,0:43:36.15,0:43:40.24,Default,,0,0,0,,Бұрынғыдай белді созып, көп жұмыс істеудің қажеті жоқ.
Dialogue: 0,0:43:40.74,0:43:41.32,Default,,0,0,0,,Ах
Dialogue: 0,0:43:46.08,0:43:46.74,Default,,0,0,0,,Жолдан кет! Эй!
Dialogue: 0,0:43:46.83,0:43:48.04,Default,,0,0,0,,Хехе
Dialogue: 0,0:43:48.54,0:43:50.83,Default,,0,0,0,,Қошмар да күшейе түсті
Dialogue: 0,0:43:50.91,0:43:53.04,Default,,0,0,0,,Сәйкесінше сиқырлы қыздар да көбейді.
Dialogue: 0,0:43:53.13,0:43:56.17,Default,,0,0,0,,Енді сіз бұрынғыға қарағанда көбірек жан тыныштығымен күресе аласыз.
Dialogue: 0,0:43:56.75,0:43:59.38,Default,,0,0,0,,Мұндай нәрсе жанды және көңілді болуы мүмкін.
Dialogue: 0,0:43:59.47,0:44:04.01,Default,,0,0,0,,Енді... түнгі түндерді жою енді ойын емес, Канаме-сан.
Dialogue: 0,0:44:04.68,0:44:05.72,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:44:08.85,0:44:10.14,Default,,0,0,0,,Бірақ иә
Dialogue: 0,0:44:10.64,0:44:11.94,Default,,0,0,0,,Ретроспективада
Dialogue: 0,0:44:12.52,0:44:16.57,Default,,0,0,0,,Мүмкін мен армандаған күнделікті өмір осы шығар.
Dialogue: 0,0:44:17.15,0:44:20.11,Default,,0,0,0,,Тағдырын сиқырлы қыз деп мойындайтын өмір жолы.
Dialogue: 0,0:44:20.61,0:44:23.57,Default,,0,0,0,,Мен соншалықты бақытты және орындалғаныма сене алар емеспін.
Dialogue: 0,0:44:24.20,0:44:26.53,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:44:31.41,0:44:34.50,Default,,0,0,0,,Томое мырза, мен сіздің шайыңызды толтырып алайын ба?
Dialogue: 0,0:44:34.58,0:44:35.54,Default,,0,0,0,,О.
Dialogue: 0,0:44:38.05,0:44:41.01,Default,,0,0,0,,Біраз күте тұрыңыз, мен қазір суды қайнатамын.
Dialogue: 0,0:44:48.97,0:44:49.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:50.68,0:44:52.56,Default,,0,0,0,,Хомура-чан, не болды?
Dialogue: 0,0:44:53.19,0:44:54.69,Default,,0,0,0,,Кешіріңіз Мадока
Dialogue: 0,0:45:09.03,0:45:12.29,Default,,0,0,0,,Могу? Моб? Mobegya Mobegya!
Dialogue: 0,0:45:12.37,0:45:14.67,Default,,0,0,0,,Осы фарсты доғарайық.
Dialogue: 0,0:45:16.21,0:45:18.50,Default,,0,0,0,,Сенің кім екенің есімде.
Dialogue: 0,0:45:19.09,0:45:22.51,Default,,0,0,0,,Бұрын кім болғаның есімде.
Dialogue: 0,0:45:22.59,0:45:23.97,Default,,0,0,0,,Могу~?
Dialogue: 0,0:45:24.05,0:45:28.85,Default,,0,0,0,,Барлығының естеліктерін жасақтау және оларды Митакихараның жалған тосқауылында ұстау
Dialogue: 0,0:45:29.43,0:45:30.76,Default,,0,0,0,,Мұндай трюктерді кім жасай алады?
Dialogue: 0,0:45:30.85,0:45:34.14,Default,,0,0,0,,Бебе, сен жалғызсың
Dialogue: 0,0:45:37.77,0:45:38.65,Default,,0,0,0,,Может!
Dialogue: 0,0:45:39.23,0:45:40.69,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:45:40.77,0:45:43.28,Default,,0,0,0,,Бізбен осылай ойыншық
Dialogue: 0,0:45:43.36,0:45:45.03,Default,,0,0,0,,Оның не қызығы бар?
Dialogue: 0,0:45:46.53,0:45:47.91,Default,,0,0,0,,Губе…
Dialogue: 0,0:45:50.37,0:45:51.79,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:46:04.30,0:46:06.51,Default,,0,0,0,,Есте сақтау қиын нәрсе, солай емес пе?
Dialogue: 0,0:46:08.01,0:46:09.51,Default,,0,0,0,,Бір нәрсені қайтарып алсаңыз
Dialogue: 0,0:46:09.60,0:46:12.10,Default,,0,0,0,,Қосымша естеліктер бірінен соң бірі келеді
Dialogue: 0,0:46:17.44,0:46:20.61,Default,,0,0,0,,Иә, есімде, Томое Мами.
Dialogue: 0,0:46:21.86,0:46:23.90,Default,,0,0,0,,Маған ол кісі ұнамады.
Dialogue: 0,0:46:24.40,0:46:26.74,Default,,0,0,0,,Күшті болыңыз, өзіңізді тым қатты итеріңіз
Dialogue: 0,0:46:27.24,0:46:29.91,Default,,0,0,0,,Соған қарамастан оның жүрегі басқаларға қарағанда сезімтал.
Dialogue: 0,0:46:31.53,0:46:35.58,Default,,0,0,0,,Ол адамның алдында шындықты ашу әрқашан тым қатыгездік.
Dialogue: 0,0:46:35.66,0:46:37.00,Default,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:46:38.33,0:46:40.42,Default,,0,0,0,,Мен ұмытып қалғым келді.
Dialogue: 0,0:46:41.08,0:46:42.96,Default,,0,0,0,,Осы уақытқа дейін И
Dialogue: 0,0:46:43.05,0:46:46.34,Default,,0,0,0,,Қанша адамның жүрегін таптадым?
Dialogue: 0,0:46:52.35,0:46:53.56,Default,,0,0,0,,Мойындау
Dialogue: 0,0:46:53.64,0:46:57.14,Default,,0,0,0,,Бұндай айналмалы қулықты қолданудың мақсаты қандай?
Dialogue: 0,0:47:02.31,0:47:02.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:04.11,0:47:05.40,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:47:07.82,0:47:09.57,Default,,0,0,0,,Сонда сен қорқынышты тү көріпсің ғой.
Dialogue: 0,0:47:10.74,0:47:13.49,Default,,0,0,0,,Мен жағдайды түсінгенше сізді тыңдағым келді, бірақ
Dialogue: 0,0:47:14.62,0:47:16.20,Default,,0,0,0,,Мен Бебенің бұдан былай қорланғанын қаламаймын.
Dialogue: 0,0:47:16.29,0:47:18.54,Default,,0,0,0,,Мен қарап отыра алмаймын.
Dialogue: 0,0:47:21.88,0:47:23.92,Default,,0,0,0,,Амал жоқ, басынан...
Dialogue: 0,0:47:24.00,0:47:25.88,Default,,0,0,0,,Не айтқыңыз келетінін түсіндіре аласыз ба?
Dialogue: 0,0:47:26.38,0:47:28.30,Default,,0,0,0,,Ол бала не істеді?
Dialogue: 0,0:47:30.97,0:47:32.80,Default,,0,0,0,,Сізді Бебе алдап жатыр
Dialogue: 0,0:47:32.89,0:47:35.31,Default,,0,0,0,,Бұл нағыз Митакара емес.
Dialogue: 0,0:47:35.39,0:47:38.18,Default,,0,0,0,,Біз бәрімізге жалған естеліктер салынған.
Dialogue: 0,0:47:38.27,0:47:39.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:39.77,0:47:43.27,Default,,0,0,0,,Тоқта... Акеми-сан? Не болды?
Dialogue: 0,0:47:52.86,0:47:53.37,Default,,0,0,0,,Құт
Dialogue: 0,0:47:53.45,0:47:55.12,Default,,0,0,0,,Могиоге~!
Dialogue: 0,0:47:55.20,0:47:55.87,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:48:00.29,0:48:00.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:48:01.04,0:48:02.29,Default,,0,0,0,,Бебе, жүгір!
Dialogue: 0,0:48:02.37,0:48:03.58,Default,,0,0,0,,Модуль!
Dialogue: 0,0:48:05.25,0:48:05.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:11.05,0:48:11.72,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:48:17.10,0:48:19.27,Default,,0,0,0,,Ештеңеге қарамастан оны қорғайсың ба?
Dialogue: 0,0:48:19.85,0:48:21.77,Default,,0,0,0,,Мені қууға тырыспа
Dialogue: 0,0:48:22.35,0:48:23.69,Default,,0,0,0,,Әйтпесе менімен бірге
Dialogue: 0,0:48:24.48,0:48:26.06,Default,,0,0,0,,Сізге күресуге тура келеді
Dialogue: 0,0:48:26.15,0:48:27.07,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:48:41.66,0:48:43.29,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:49:05.35,0:49:07.02,Default,,0,0,0,,Gyobe!
Dialogue: 0,0:49:09.94,0:49:10.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:11.40,0:49:12.07,Default,,0,0,0,,Ха!
Dialogue: 0,0:49:12.86,0:49:13.49,Default,,0,0,0,,Әй!
Dialogue: 0,0:49:17.57,0:49:19.49,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:49:28.13,0:49:29.88,Default,,0,0,0,,Бір-бірінің қимылдарын оқу.
Dialogue: 0,0:49:30.75,0:49:33.09,Default,,0,0,0,,Бірақ сіз мені дәл осындай жағдайда жеңе аласыз ба?
Dialogue: 0,0:49:33.17,0:49:35.01,Default,,0,0,0,,Түбірлерді салыстырсаңыз, ұтылмайсыз!
Dialogue: 0,0:49:44.35,0:49:45.31,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:49:52.44,0:49:53.19,Default,,0,0,0,,Әй!
Dialogue: 0,0:49:53.28,0:49:53.94,Default,,0,0,0,,Уф!
Dialogue: 0,0:49:54.03,0:49:55.45,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:49:55.53,0:49:56.32,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:49:57.91,0:49:58.91,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:50:02.33,0:50:03.08,Default,,0,0,0,,Уф!
Dialogue: 0,0:50:04.00,0:50:04.62,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:50:04.71,0:50:05.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:06.46,0:50:06.96,Default,,0,0,0,,Ха!
Dialogue: 0,0:50:07.79,0:50:08.42,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:50:11.50,0:50:14.17,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:50:16.68,0:50:21.30,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:50:35.28,0:50:41.20,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:50:41.28,0:50:44.20,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:50:44.29,0:50:47.21,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:51:09.77,0:51:12.36,Default,,0,0,0,,(Жыйрау дыбысы)
Dialogue: 0,0:51:27.75,0:51:30.12,Default,,0,0,0,,Қараңызшы, бұл түсініксіз.
Dialogue: 0,0:51:33.09,0:51:33.71,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:51:35.46,0:51:36.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:49.43,0:51:50.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:52.27,0:51:53.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:53.73,0:51:54.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:51:55.40,0:51:56.53,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:51:57.65,0:51:58.65,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:52:02.49,0:52:03.66,Default,,0,0,0,,Акеми-сан!
Dialogue: 0,0:52:05.70,0:52:06.62,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:52:09.96,0:52:10.46,Default,,0,0,0,,Уф
Dialogue: 0,0:52:10.54,0:52:15.29,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:52:36.82,0:52:37.86,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:52:50.87,0:52:51.37,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:52:58.17,0:52:58.80,Default,,0,0,0,,(Соққы дыбысы)
Dialogue: 0,0:52:58.88,0:52:59.46,Default,,0,0,0,,Ха!
Dialogue: 0,0:53:01.72,0:53:02.38,Default,,0,0,0,,Ха!
Dialogue: 0,0:53:02.47,0:53:03.13,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:53:03.22,0:53:03.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:53:08.64,0:53:10.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:53:11.77,0:53:13.85,Default,,0,0,0,,Сіздің сиқырыңыз таңқаларлық.
Dialogue: 0,0:53:14.64,0:53:18.77,Default,,0,0,0,,Қарсыласыңыздан әрқашан жоғары позициядамын деп ойламаңыз.
Dialogue: 0,0:53:18.86,0:53:19.77,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:53:21.15,0:53:24.32,Default,,0,0,0,,Томое мырза, сіз ештеңе байқамайсыз ба?
Dialogue: 0,0:53:24.40,0:53:26.95,Default,,0,0,0,,Қазір өзіңізге ыңғайсыздық сезінбейсіз бе?
Dialogue: 0,0:53:27.45,0:53:29.78,Default,,0,0,0,,Өмірлік маңызды нүктелерді атуға тырыспау туралы
Dialogue: 0,0:53:29.87,0:53:33.29,Default,,0,0,0,,Менің қауіпсіздігім үшін алаңдайтын сезімдеріңіз әлі де жеткілікті сияқты.
Dialogue: 0,0:53:33.37,0:53:36.17,Default,,0,0,0,,Бірақ неге Бебеге шабуыл жасадың?
Dialogue: 0,0:53:36.25,0:53:37.63,Default,,0,0,0,,Ол сиқыршы!
Dialogue: 0,0:53:37.71,0:53:41.46,Default,,0,0,0,,Есіңізде болсын, біз сиқырлы қыздардың жауымыз!
Dialogue: 0,0:53:41.55,0:53:43.17,Default,,0,0,0,,Мен бақсыларды білмеймін.
Dialogue: 0,0:53:43.26,0:53:45.84,Default,,0,0,0,,Біздің жауымыз құбыжық, солай ма?
Dialogue: 0,0:53:47.64,0:53:48.26,Default,,0,0,0,,Ах
Dialogue: 0,0:53:48.35,0:53:49.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:53:51.35,0:53:55.23,Default,,0,0,0,,Иә... Мен өмір бойы құбыжықтармен күресіп келемін.
Dialogue: 0,0:53:56.10,0:53:59.98,Default,,0,0,0,,Сонымен, Nightmare дегеніміз не...
Dialogue: 0,0:54:05.36,0:54:06.36,Default,,0,0,0,,Ал сөмкемедегі заттар да…
Dialogue: 0,0:54:12.08,0:54:12.79,Default,,0,0,0,,Әй!
Dialogue: 0,0:54:20.42,0:54:22.55,Default,,0,0,0,,Сіз нені айтасыз? Не деген...
Dialogue: 0,0:54:22.63,0:54:25.42,Default,,0,0,0,,Міне, мен түсіндіремін.
Dialogue: 0,0:54:25.51,0:54:26.76,Default,,0,0,0,,Ха…
Dialogue: 0,0:54:32.72,0:54:34.64,Default,,0,0,0,,Не? Сіз...
Dialogue: 0,0:54:36.02,0:54:36.77,Default,,0,0,0,,Бебе?
Dialogue: 0,0:54:37.69,0:54:40.02,Default,,0,0,0,,Осы уақытқа дейін үндемегенім үшін кешіріңіз.
Dialogue: 0,0:54:40.77,0:54:44.69,Default,,0,0,0,,Бірақ мен сенің тынышталып, мені тыңдағаныңды қалаймын.
Dialogue: 0,0:54:51.20,0:54:51.83,Default,,0,0,0,,Ах
Dialogue: 0,0:55:03.50,0:55:05.84,Default,,0,0,0,,А... сен...
Dialogue: 0,0:55:05.92,0:55:06.84,Default,,0,0,0,,Гааах!
Dialogue: 0,0:55:06.92,0:55:10.68,Default,,0,0,0,,Ең жақсы формадағы Мами-санмен төбелесуге қалай батылыңыз бар?
Dialogue: 0,0:55:10.76,0:55:13.01,Default,,0,0,0,,Сіз тым сенімдісіз бе, әлде ақымақсыз ба?
Dialogue: 0,0:55:15.22,0:55:17.77,Default,,0,0,0,,Томое: Мамимен қақтығыс болмай қалмады.
Dialogue: 0,0:55:17.85,0:55:20.02,Default,,0,0,0,,Мен оны мақсат еткен жоқпын...
Dialogue: 0,0:55:20.10,0:55:21.81,Default,,0,0,0,,Бебе, солай ма?
Dialogue: 0,0:55:21.90,0:55:25.28,Default,,0,0,0,,Неліктен ол бақсы болғаны үшін оны нысанаға алу керек?
Dialogue: 0,0:55:25.36,0:55:27.61,Default,,0,0,0,,Өзіңізден озып кетудің шегі бар.
Dialogue: 0,0:55:27.69,0:55:29.86,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:55:33.41,0:55:35.45,Default,,0,0,0,,Өйткені бұл менің рөлім.
Dialogue: 0,0:55:35.95,0:55:38.87,Default,,0,0,0,,Сіз бұл біртүрлі деп ойламайсыз ба?
Dialogue: 0,0:55:38.96,0:55:43.13,Default,,0,0,0,,Митакара қаласы: Толығымен қайта құруға болатындай үлкен тосқауыл қойған бақсы.
Dialogue: 0,0:55:43.21,0:55:46.17,Default,,0,0,0,,Басқа адамдарға шабуыл жасамаңыз және өлтірмеңіз.
Dialogue: 0,0:55:46.25,0:55:49.92,Default,,0,0,0,,Олар бізді қамап, басқа ештеңе істемеді.
Dialogue: 0,0:55:50.76,0:55:52.34,Default,,0,0,0,,Сіздің есіңізде қалған кәмпит-ведьма
Dialogue: 0,0:55:53.09,0:55:55.35,Default,,0,0,0,,Ол мұндай оғаш нәрселерді жасайтын адам емес еді.
Dialogue: 0,0:55:57.93,0:56:00.39,Default,,0,0,0,,Ойланып қарасаң, түсіну керек.
Dialogue: 0,0:56:00.48,0:56:04.11,Default,,0,0,0,,Бұл бақсының тосқауылы тамақ жинауға арналған қақпан емес.
Dialogue: 0,0:56:04.19,0:56:08.69,Default,,0,0,0,,Тосқауылды басқаратын бақсының мақсаты - статус-квоны сақтау.
Dialogue: 0,0:56:09.19,0:56:13.20,Default,,0,0,0,,Басқаша айтқанда, қазір болып жатқан жағдай кімге тиімді?
Dialogue: 0,0:56:13.78,0:56:15.45,Default,,0,0,0,,Егер сіз сол жерден қорытынды жасасаңыз...
Dialogue: 0,0:56:18.54,0:56:21.21,Default,,0,0,0,,Сіз қайтадан өз уақытыңызға қашуды жоспарлап отырсыз ба?
Dialogue: 0,0:56:22.00,0:56:23.46,Default,,0,0,0,,Бұл сенің жаман әдетің.
Dialogue: 0,0:56:24.04,0:56:25.96,Default,,0,0,0,,Сіз сол сиқырға тым көп сенесіз
Dialogue: 0,0:56:26.04,0:56:27.05,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:56:29.67,0:56:31.72,Default,,0,0,0,,Осы жағдайды қалаған адам
Dialogue: 0,0:56:32.30,0:56:34.43,Default,,0,0,0,,Арамызда...?
Dialogue: 0,0:56:34.93,0:56:36.01,Default,,0,0,0,,Бұл сізді таң қалдырады
Dialogue: 0,0:56:36.10,0:56:37.81,Default,,0,0,0,,Бұл әңгіме емес, солай ма?
Dialogue: 0,0:56:37.89,0:56:39.22,Default,,0,0,0,,Шындығында, Мәми-сан
Dialogue: 0,0:56:39.31,0:56:40.73,Default,,0,0,0,,Бұл сіз бұрын айттыңыз.
Dialogue: 0,0:56:40.81,0:56:43.44,Default,,0,0,0,,Мен қазір ең бақыттымын
Dialogue: 0,0:56:43.94,0:56:46.69,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз Мамиді сиқыршы деп ойлайсыз ба?
Dialogue: 0,0:56:47.86,0:56:51.19,Default,,0,0,0,,Ведьма - сиқырлы қыздардың баратын жері
Dialogue: 0,0:56:51.69,0:56:54.74,Default,,0,0,0,,Иә, бұл мүмкін.
Dialogue: 0,0:56:55.99,0:56:57.99,Default,,0,0,0,,Бұл сіздің әдеттегі жауабыңыз.
Dialogue: 0,0:56:58.08,0:57:00.75,Default,,0,0,0,,Олай болса, тағы бір нәрсе сұрайын.
Dialogue: 0,0:57:01.41,0:57:03.75,Default,,0,0,0,,Осы бөгетті жасаған бақсыны табыңыз
Dialogue: 0,0:57:04.42,0:57:06.25,Default,,0,0,0,,Сонымен, сіз не істейсіз?
Dialogue: 0,0:57:07.46,0:57:09.88,Default,,0,0,0,,Әрине...
Dialogue: 0,0:57:09.96,0:57:11.26,Default,,0,0,0,,Одан құтыласың ба?
Dialogue: 0,0:57:11.34,0:57:12.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:57:13.55,0:57:15.89,Default,,0,0,0,,Ол сиқыршы болғандықтан ба?
Dialogue: 0,0:57:15.97,0:57:17.10,Default,,0,0,0,,СМАШ АҚШ-ы!
Dialogue: 0,0:57:22.89,0:57:23.60,Default,,0,0,0,,Иә
Dialogue: 0,0:57:24.52,0:57:27.73,Default,,0,0,0,,Эй, бұл шынымен жаман ба?
Dialogue: 0,0:57:28.73,0:57:32.65,Default,,0,0,0,,Ешкіммен ұрыспай бірге өмір сүрейік
Dialogue: 0,0:57:33.53,0:57:34.90,Default,,0,0,0,,Ол үшін дұға еткен жүрек
Dialogue: 0,0:57:34.99,0:57:38.49,Default,,0,0,0,,Сотталуға тура келетіндей күнәкар ма?
Dialogue: 0,0:57:38.58,0:57:42.20,Default,,0,0,0,,Ха! Сіз... сиқыршы рөлін алуды жоспарлап отырсыз ба?
Dialogue: 0,0:57:42.29,0:57:45.12,Default,,0,0,0,,Бұл біз ақыры аяқталады.
Dialogue: 0,0:57:45.62,0:57:47.54,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:57:49.79,0:57:53.97,Default,,0,0,0,,Мен де ең маңыздысын есіме түсірдім.
Dialogue: 0,0:57:55.68,0:58:00.56,Default,,0,0,0,,Томое: Мәмидің есінде қалған естелік бақсы емес, жын-шайтанмен болған шайқас болды.
Dialogue: 0,0:58:01.35,0:58:05.35,Default,,0,0,0,,Киоко Сакураның сиқыршының тосқауылының мүмкіндігі туралы болжам жасамауының себебі
Dialogue: 0,0:58:05.85,0:58:07.94,Default,,0,0,0,,Бұл бақсы туралы ұмытып кеткендіктен емес.
Dialogue: 0,0:58:08.02,0:58:11.02,Default,,0,0,0,,Олар бақсылардың бар екенін білмейді.
Dialogue: 0,0:58:12.15,0:58:13.19,Default,,0,0,0,,Әрине
Dialogue: 0,0:58:13.28,0:58:16.53,Default,,0,0,0,,Енді бұл ғаламда бақсылар жоқ.
Dialogue: 0,0:58:17.03,0:58:19.20,Default,,0,0,0,,Барлық сиқырлы қыздардың жаны
Dialogue: 0,0:58:19.28,0:58:22.41,Default,,0,0,0,,Бақсы болмас бұрын шеңбер принципі бойынша жиналады.
Dialogue: 0,0:58:22.91,0:58:26.21,Default,,0,0,0,,Сол бала әлемді солай болатындай етіп өзгертті.
Dialogue: 0,0:58:27.58,0:58:29.58,Default,,0,0,0,,Өз есебінен
Dialogue: 0,0:58:30.75,0:58:31.88,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:58:32.55,0:58:34.59,Default,,0,0,0,,Есіңізде болса керек.
Dialogue: 0,0:58:35.17,0:58:36.34,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:58:36.42,0:58:40.18,Default,,0,0,0,,Есімде қалған жалғыз мен болсам керек.
Dialogue: 0,0:58:42.97,0:58:46.31,Default,,0,0,0,,Мұнда бірінші кезекте болмауы керек үш болмыс бар.
Dialogue: 0,0:58:46.39,0:58:49.15,Default,,0,0,0,,Бірі - бұл бөгетті жасаған бақсы.
Dialogue: 0,0:58:49.23,0:58:52.15,Default,,0,0,0,,Екіншісі - бақсы кейпіндегі Бебе.
Dialogue: 0,0:58:53.98,0:58:55.15,Default,,0,0,0,,Соңында
Dialogue: 0,0:58:55.90,0:58:58.40,Default,,0,0,0,,Сіз сиқыршы туралы білесіз
Dialogue: 0,0:59:00.03,0:59:01.41,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:59:01.49,0:59:04.41,Default,,0,0,0,,Бұл шынымен Саяка Мики ме?
Dialogue: 0,0:59:08.62,0:59:10.33,Default,,0,0,0,,Сәлемдесу.
Dialogue: 0,0:59:10.42,0:59:12.92,Default,,0,0,0,,Мен дәл сен мені танитын адаммын.
Dialogue: 0,0:59:13.50,0:59:14.55,Default,,0,0,0,,Студентті ауыстыру
Dialogue: 0,0:59:17.92,0:59:18.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:19.88,0:59:20.72,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:59:28.14,0:59:32.31,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:59:47.25,0:59:49.16,Default,,0,0,0,,Сіз тым жылдам қашып бара жатырсыз.
Dialogue: 0,0:59:49.75,0:59:52.71,Default,,0,0,0,,Сіз ебедейсіз бала болуыңыз керек еді.
Dialogue: 0,0:59:53.33,0:59:56.59,Default,,0,0,0,,Менің сұрағыма да жауап бермедіңіз.
Dialogue: 0,0:59:57.09,1:00:01.01,Default,,0,0,0,,Бұл Митакихараны жою шынымен дұрыс па?
Dialogue: 0,1:00:01.80,1:00:04.01,Default,,0,0,0,,Шешім қабылдамас бұрын мұқият ойланыңыз.
Dialogue: 0,1:00:04.72,1:00:07.27,Default,,0,0,0,,Ешқандай өкініш қалдырмаңыз
Dialogue: 0,1:00:22.20,1:00:23.99,Default,,0,0,0,,Бұл жалған қала
Dialogue: 0,1:00:24.07,1:00:26.87,Default,,0,0,0,,Біреу армандаған қалау әлемі
Dialogue: 0,1:00:27.37,1:00:30.29,Default,,0,0,0,,Форт! Да! Форт! Да! Форт! Да!
Dialogue: 0,1:00:30.37,1:00:35.34,Default,,0,0,0,,Форт! Да! Форт! Да! Форт! Да! Форт! Да!
Dialogue: 0,1:00:35.42,1:00:39.30,Default,,0,0,0,,Форт! Да! Форт! Да! Форт! Да!
Dialogue: 0,1:00:39.38,1:00:41.88,Default,,0,0,0,,Форт! Да! Форт! Да!
Dialogue: 0,1:00:51.23,1:00:54.23,Default,,0,0,0,,Мәмиге оның аумағына көмектесіп жатқан жоқсың ба?
Dialogue: 0,1:01:00.57,1:01:04.16,Default,,0,0,0,,Бәлкім, мен армандайтын әр күнім шығар.
Dialogue: 0,1:01:08.99,1:01:12.21,Default,,0,0,0,,Эй, бұл шынымен жаман ба?
Dialogue: 0,1:01:13.46,1:01:15.33,Default,,0,0,0,,Барлығын қатыстыру
Dialogue: 0,1:01:15.42,1:01:18.09,Default,,0,0,0,,Бұл мүмкін емес әлемге қашып кеткен адамдар бар.
Dialogue: 0,1:01:18.59,1:01:21.01,Default,,0,0,0,,Жындармен күресу миссиясына арқамды бұру
Dialogue: 0,1:01:21.51,1:01:24.80,Default,,0,0,0,,Мұндай әлсіздікті кешіруге болмайды.
Dialogue: 0,1:01:26.22,1:01:29.22,Default,,0,0,0,,Сиқырлы қыздар күресуді жалғастыру керек
Dialogue: 0,1:01:30.18,1:01:32.43,Default,,0,0,0,,Ғажайып тілеу дегеннің құны осы
Dialogue: 0,1:01:34.02,1:01:37.19,Default,,0,0,0,,Өйткені біз сондаймыз, ол бала
Dialogue: 0,1:01:37.77,1:01:39.98,Default,,0,0,0,,Ол мені құтқару үшін өз өмірін қатерге тіккен.
Dialogue: 0,1:01:47.91,1:01:52.25,Default,,0,0,0,,Бұл фарс Мадоканың құрбандығын босқа ысырап етуде.
Dialogue: 0,1:01:53.37,1:01:54.46,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,1:01:55.25,1:01:56.67,Default,,0,0,0,,Бармын!
Dialogue: 0,1:01:56.75,1:01:59.50,Default,,0,0,0,,Бармын! Бұл керек!
Dialogue: 0,1:02:08.01,1:02:09.72,Default,,0,0,0,,Әй, Хомура-чан!
Dialogue: 0,1:02:09.80,1:02:10.76,Default,,0,0,0,,Ах
Dialogue: 0,1:02:13.18,1:02:13.68,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:13.77,1:02:14.73,Default,,0,0,0,,Әй!
Dialogue: 0,1:02:15.77,1:02:18.19,Default,,0,0,0,,Уау! Ах! Уф... Уау!
Dialogue: 0,1:02:18.94,1:02:19.44,Default,,0,0,0,,Кю
Dialogue: 0,1:02:20.86,1:02:22.40,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:22.48,1:02:23.53,Default,,0,0,0,,Хаа~
Dialogue: 0,1:02:24.36,1:02:27.36,Default,,0,0,0,,Керемет, мен сені іздедім.
Dialogue: 0,1:02:27.99,1:02:30.12,Default,,0,0,0,,Мәми қатты қобалжыды.
Dialogue: 0,1:02:30.20,1:02:32.37,Default,,0,0,0,,Не болды?
Dialogue: 0,1:02:35.91,1:02:37.12,Default,,0,0,0,,Мен...
Dialogue: 0,1:02:42.55,1:02:46.01,Default,,0,0,0,,Хомура-чан, сен жалғыз болсаң жақсы емес.
Dialogue: 0,1:02:49.09,1:02:52.47,Default,,0,0,0,,Тіпті мен тыңдап тұрсам да...
Dialogue: 0,1:02:55.68,1:02:58.56,Default,,0,0,0,,Оның ешқандай пайдасы болмауы мүмкін
Dialogue: 0,1:02:59.06,1:03:03.23,Default,,0,0,0,,Десе де, жалғыз уайымдағаннан әлдеқайда жақсы деп ойлаймын.
Dialogue: 0,1:03:06.82,1:03:10.87,Default,,0,0,0,,Хомура-чан қиналып жатқанда мен ештеңе істей алмаймын.
Dialogue: 0,1:03:11.37,1:03:13.20,Default,,0,0,0,,Маған да қиын
Dialogue: 0,1:03:23.13,1:03:26.34,Default,,0,0,0,,Мен өте қорқынышты түс көрдім.
Dialogue: 0,1:03:26.42,1:03:27.42,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,1:03:29.43,1:03:34.14,Default,,0,0,0,,Алысқа кеткенің сонша, мен сені енді ешқашан көрмеймін.
Dialogue: 0,1:03:34.64,1:03:39.19,Default,,0,0,0,,Бірақ дүниедегі бәрі мұны ұмытты...
Dialogue: 0,1:03:41.35,1:03:42.77,Default,,0,0,0,,Тек I
Dialogue: 0,1:03:42.86,1:03:45.48,Default,,0,0,0,,Мадока жалғыз адам ретінде есімде
Dialogue: 0,1:03:45.57,1:03:46.94,Default,,0,0,0,,Артында қалды...
Dialogue: 0,1:03:48.40,1:03:49.36,Default,,0,0,0,,(Хомураның жылауы)
Dialogue: 0,1:03:50.53,1:03:52.20,Default,,0,0,0,,(Хомураның жылауы)
Dialogue: 0,1:03:52.28,1:03:54.58,Default,,0,0,0,,Жалғыз болсам да, мұңайсам да
Dialogue: 0,1:03:55.08,1:03:57.95,Default,,0,0,0,,Менің сезімімді ешкім түсіне алмайды
Dialogue: 0,1:03:58.54,1:04:01.58,Default,,0,0,0,,Осы арада Мадоканың естеліктері
Dialogue: 0,1:04:01.67,1:04:05.04,Default,,0,0,0,,Бұл менің өзім ойлап тапқан қиял емес пе?
Dialogue: 0,1:04:05.13,1:04:07.80,Default,,0,0,0,,Мен енді өзіме сене алмаймын...
Dialogue: 0,1:04:09.05,1:04:10.97,Default,,0,0,0,,(Хомураның жылауы)
Dialogue: 0,1:04:11.05,1:04:11.97,Default,,0,0,0,,Ха!
Dialogue: 0,1:04:12.59,1:04:16.18,Default,,0,0,0,,Иә, бұл өте жаман түс.
Dialogue: 0,1:04:16.26,1:04:16.89,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:18.06,1:04:20.23,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,1:04:20.31,1:04:24.98,Default,,0,0,0,,Мен ешкімді көре алмайтындай алысқа жалғыз бара жатқаныма сенбеймін.
Dialogue: 0,1:04:25.06,1:04:26.73,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,1:04:28.28,1:04:29.32,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:04:29.94,1:04:32.03,Default,,0,0,0,,Мұны қалай айта аласыз?
Dialogue: 0,1:04:35.03,1:04:36.03,Default,,0,0,0,,Фу…
Dialogue: 0,1:04:36.12,1:04:38.20,Default,,0,0,0,,Мен болғандықтан ба?
Dialogue: 0,1:04:38.29,1:04:41.37,Default,,0,0,0,,Ауырғандығы сонша, тіпті Хомура-чан да жылап жіберетін
Dialogue: 0,1:04:41.46,1:04:43.54,Default,,0,0,0,,Мен оған қарсы тұра алмаймын.
Dialogue: 0,1:04:43.62,1:04:45.33,Default,,0,0,0,,Ха…
Dialogue: 0,1:04:46.92,1:04:51.80,Default,,0,0,0,,Саған шыдау тым қиын ба?
Dialogue: 0,1:04:51.88,1:04:53.55,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:04:53.63,1:04:56.01,Default,,0,0,0,,Хомура-чан Саяка-чан
Dialogue: 0,1:04:56.64,1:04:58.56,Default,,0,0,0,,Мами-сан мен Киоко-чан
Dialogue: 0,1:04:59.31,1:05:01.31,Default,,0,0,0,,Әкем, анам, Тацуя
Dialogue: 0,1:05:01.39,1:05:05.10,Default,,0,0,0,,Ал Хитоми-чан және сыныптағылардың барлығы.
Dialogue: 0,1:05:06.77,1:05:09.53,Default,,0,0,0,,Ешкіммен қоштасқым келмейді
Dialogue: 0,1:05:10.65,1:05:13.90,Default,,0,0,0,,Басқа істейтін ештеңе болмаса да
Dialogue: 0,1:05:13.99,1:05:16.28,Default,,0,0,0,,Менде ондай батылдық жоқ.
Dialogue: 0,1:05:17.28,1:05:17.91,Default,,0,0,0,,Ха!
Dialogue: 0,1:05:19.08,1:05:20.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:23.58,1:05:26.17,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,1:05:26.92,1:05:30.09,Default,,0,0,0,,Егер сіз шынымен де солай сезінсеңіз
Dialogue: 0,1:05:30.67,1:05:34.38,Default,,0,0,0,,Мен... қандай ақымақ қателік...
Dialogue: 0,1:05:40.18,1:05:42.81,Default,,0,0,0,,Мен мұны мойындамауым керек еді.
Dialogue: 0,1:05:43.31,1:05:46.27,Default,,0,0,0,,Сол кезде мен қолымнан келгеннің бәрін жасадым
Dialogue: 0,1:05:46.35,1:05:48.40,Default,,0,0,0,,Мен сені тоқтатуым керек еді
Dialogue: 0,1:05:51.90,1:05:52.65,Default,,0,0,0,,Мадока
Dialogue: 0,1:05:53.15,1:05:53.65,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:54.15,1:05:55.28,Default,,0,0,0,,Сізге
Dialogue: 0,1:05:55.78,1:05:58.07,Default,,0,0,0,,Қанша азап болса да,
Dialogue: 0,1:05:58.57,1:06:01.45,Default,,0,0,0,,Сіз мұны таңдауға батылсыз ба?
Dialogue: 0,1:06:01.54,1:06:02.91,Default,,0,0,0,,Фалко, мен саған бір өтінішпен жүгінер едім…
Dialogue: 0,1:06:03.00,1:06:05.46,Default,,0,0,0,,Сіз тек сіз жасай алатын нәрсе бар екенін білсеңіз
Dialogue: 0,1:06:06.17,1:06:09.34,Default,,0,0,0,,Сіз тіпті түсінбейсіз
Dialogue: 0,1:06:09.42,1:06:11.71,Default,,0,0,0,,Тым мейірімді, тым күшті
Dialogue: 0,1:06:12.55,1:06:15.38,Default,,0,0,0,,Мен білемін.
Dialogue: 0,1:06:15.47,1:06:17.64,Default,,0,0,0,,А... Хомура-чан?
Dialogue: 0,1:06:21.76,1:06:22.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:06:23.06,1:06:26.23,Default,,0,0,0,,Өйткені, тіпті Мадоканың есінде ештеңе жоқ.
Dialogue: 0,1:06:28.60,1:06:31.94,Default,,0,0,0,,Мүмкін сен елес шығарсың
Dialogue: 0,1:06:32.73,1:06:35.86,Default,,0,0,0,,Біреу дайындаған фейк шығар деп ойладым.
Dialogue: 0,1:06:36.36,1:06:39.78,Default,,0,0,0,,Егер бұл болмаса, мен сені бұлай кездестіре алмас едім.
Dialogue: 0,1:06:41.03,1:06:43.04,Default,,0,0,0,,Қалай қарасаң да біртүрлі.
Dialogue: 0,1:06:43.12,1:06:44.95,Default,,0,0,0,,А... А?
Dialogue: 0,1:06:46.71,1:06:50.04,Default,,0,0,0,,Бірақ мен түсіндім, сен нағыз Мадокасың.
Dialogue: 0,1:06:50.92,1:06:53.00,Default,,0,0,0,,Екеуміз осылай сөйлесе алдық.
Dialogue: 0,1:06:53.50,1:06:55.63,Default,,0,0,0,,Тағы да маған мейірімді болыңыз.
Dialogue: 0,1:06:56.13,1:06:58.09,Default,,0,0,0,,Мен шынымен бақыттымын
Dialogue: 0,1:06:59.97,1:07:00.97,Default,,0,0,0,,Рахмет
Dialogue: 0,1:07:01.47,1:07:05.35,Default,,0,0,0,,Осының өзі мені бақытты етті.
Dialogue: 0,1:07:10.31,1:07:11.48,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,1:07:11.56,1:07:14.07,Default,,0,0,0,,Өйткені менің әлі аяқталмаған ісім бар
Dialogue: 0,1:07:14.15,1:07:16.36,Default,,0,0,0,,А... Хомура-чан?
Dialogue: 0,1:07:16.44,1:07:17.45,Default,,0,0,0,,Иә
Dialogue: 0,1:07:28.96,1:07:31.88,Default,,0,0,0,,Не болды екен... Хомура-чан
Dialogue: 0,1:07:31.96,1:07:32.88,Default,,0,0,0,,Кю~
Dialogue: 0,1:07:35.21,1:07:38.13,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,1:07:38.22,1:07:38.97,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:07:39.05,1:07:40.68,Default,,0,0,0,,Сәлеметсіз бе, Хомура?
Dialogue: 0,1:07:41.18,1:07:42.43,Default,,0,0,0,,Сәлем Сакура-сан
Dialogue: 0,1:07:42.93,1:07:45.35,Default,,0,0,0,,Сиқыршы есіңізде ме?
Dialogue: 0,1:07:46.60,1:07:48.10,Default,,0,0,0,,Бұл бірдеңе ме?
Dialogue: 0,1:07:48.18,1:07:51.15,Default,,0,0,0,,Егер рас болса, есте сақтауым керек біртүрлі нәрсе ме?
Dialogue: 0,1:07:51.23,1:07:53.61,Default,,0,0,0,,Жоқ, білмесеңіз дұрыс айтасыз.
Dialogue: 0,1:07:53.69,1:07:54.57,Default,,0,0,0,,Әй!
Dialogue: 0,1:07:55.07,1:07:57.57,Default,,0,0,0,,Сәлем! Мені мазақ етпе!
Dialogue: 0,1:07:57.65,1:07:59.36,Default,,0,0,0,,Сонда Мадока Канаме ше?
Dialogue: 0,1:07:59.45,1:08:00.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:00.28,1:08:02.82,Default,,0,0,0,,Ол сіздің есіңізде ме?
Dialogue: 0,1:08:03.41,1:08:06.29,Default,,0,0,0,,Бұл анық. Не...
Dialogue: 0,1:08:06.37,1:08:08.20,Default,,0,0,0,,Ах! Эй, болмайды...
Dialogue: 0,1:08:08.29,1:08:09.29,Default,,0,0,0,,Иә
Dialogue: 0,1:08:09.79,1:08:12.58,Default,,0,0,0,,Ол туралы білуге мүмкіндік жоқ.
Dialogue: 0,1:08:12.67,1:08:14.54,Default,,0,0,0,,Бұл жады жалған
Dialogue: 0,1:08:14.63,1:08:15.63,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:16.50,1:08:18.76,Default,,0,0,0,,Менің ойымша, бұл жаман әзіл емес.
Dialogue: 0,1:08:19.26,1:08:20.05,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,1:08:22.97,1:08:24.76,Default,,0,0,0,,Осы сияқты қарапайым нәрсе
Dialogue: 0,1:08:25.47,1:08:27.89,Default,,0,0,0,,Біраз ойланып қарасам, түсініп алуым керек еді.
Dialogue: 0,1:08:28.81,1:08:31.56,Default,,0,0,0,,Мадока бар әлемді ойлап шығарсаңыз.
Dialogue: 0,1:08:31.64,1:08:35.02,Default,,0,0,0,,Бұл тек Мадоканы білетіндерге арналған.
Dialogue: 0,1:08:36.90,1:08:38.53,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,1:08:39.03,1:08:40.36,Default,,0,0,0,,Енді түсіндім.
Dialogue: 0,1:08:40.86,1:08:43.16,Default,,0,0,0,,Барлығымыздың естеліктерді қайта жазу
Dialogue: 0,1:08:43.91,1:08:48.58,Default,,0,0,0,,Жалған Митакихарада қамалған адам кім?
Dialogue: 0,1:08:49.08,1:08:50.04,Default,,0,0,0,,Сәлем, Хомура!
Dialogue: 0,1:08:50.12,1:08:53.04,Default,,0,0,0,,Амансың ба? Қазір қайдасың?
Dialogue: 0,1:08:54.13,1:08:54.63,Default,,0,0,0,,Ха!
Dialogue: 0,1:09:05.09,1:09:08.14,Default,,0,0,0,,Соңында, мен растағым келетін бір нәрсе бар.
Dialogue: 0,1:09:09.14,1:09:11.27,Default,,0,0,0,,Бұл бәрін реттейді.
Dialogue: 0,1:09:11.35,1:09:13.35,Default,,0,0,0,,Қолдарыңыз мазаламайды.
Dialogue: 0,1:09:13.44,1:09:14.60,Default,,0,0,0,,Эй!
Dialogue: 0,1:09:15.94,1:09:17.73,Default,,0,0,0,,Сізді қатысқаным үшін кешіріңіз.
Dialogue: 0,1:09:17.82,1:09:18.48,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:09:28.83,1:09:31.00,Default,,0,0,0,,Жаным асыл тас берсем де
Dialogue: 0,1:09:31.08,1:09:33.12,Default,,0,0,0,,Денем қозғалса
Dialogue: 0,1:09:33.71,1:09:36.75,Default,,0,0,0,,Шектеу ең көбі 100 метр болуы керек.
Dialogue: 0,1:10:01.78,1:10:03.19,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,1:10:05.70,1:10:08.62,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:10:14.71,1:10:16.12,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:10:19.21,1:10:22.00,Default,,0,0,0,,Форт. Да. Форт. Да.
Dialogue: 0,1:10:22.09,1:10:24.51,Default,,0,0,0,,Форт. Да. Форт. Да.
Dialogue: 0,1:10:24.59,1:10:28.01,Default,,0,0,0,,Форт. Да. Форт. Да. Форт. Да.
Dialogue: 0,1:10:34.10,1:10:35.27,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:10:36.10,1:10:37.52,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:10:37.60,1:10:39.77,Default,,0,0,0,,Форт! Да! Форт! Да!
Dialogue: 0,1:10:40.40,1:10:42.69,Default,,0,0,0,,Форт! Да! Форт! Да!
Dialogue: 0,1:10:42.78,1:10:46.70,Default,,0,0,0,,Форт! Да! Форт! Да! Форт! Да! Форт! Да!
Dialogue: 0,1:11:01.13,1:11:04.05,Default,,0,0,0,,(түсіру қоңырауы)
Dialogue: 0,1:11:04.13,1:11:07.13,Default,,0,0,0,,Келесі Митакара 2-чоме
Dialogue: 0,1:11:07.63,1:11:11.39,Default,,0,0,0,,Митакара қалалық бастауыш мектебіне өту үшін осы жерді басыңыз
Dialogue: 0,1:11:11.89,1:11:13.60,Default,,0,0,0,,(♪ «Twinkle, Twinkle, Little Star» әніне варияциялар»)
Dialogue: 0,1:11:14.68,1:11:15.93,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:11:23.52,1:11:26.07,Default,,0,0,0,,Басқаша айтқанда...
Dialogue: 0,1:11:26.65,1:11:29.20,Default,,0,0,0,,Сонда ол тіпті сиқырлы қыз емес пе?
Dialogue: 0,1:11:31.41,1:11:33.45,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:11:40.71,1:11:43.38,Default,,0,0,0,,Неліктен? Эй...
Dialogue: 0,1:11:47.38,1:11:52.01,Default,,0,0,0,,Мен неге мұндаймын...
Dialogue: 0,1:11:53.97,1:11:56.35,Default,,0,0,0,,Қандай нүктеде?
Dialogue: 0,1:11:56.93,1:11:57.93,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,1:11:58.43,1:12:00.02,Default,,0,0,0,,Сіз бақсы болдыңыз ба?
Dialogue: 0,1:12:16.91,1:12:17.91,Default,,0,0,0,,Форт! (Бала) Форт!
Dialogue: 0,1:12:18.00,1:12:19.04,Default,,0,0,0,,Форт! (Балалар) Форт!
Dialogue: 0,1:12:19.12,1:12:19.71,Default,,0,0,0,,Форт!
Dialogue: 0,1:12:26.00,1:12:29.21,Default,,0,0,0,,Сіз шындықты білгіңіз де келмейтін шығар.
Dialogue: 0,1:12:29.30,1:12:32.34,Default,,0,0,0,,Соған қарамастан мен оны жалғастыра алмаймын
Dialogue: 0,1:12:32.43,1:12:35.10,Default,,0,0,0,,Адамның қызығушылығы дегеніміз не?
Dialogue: 0,1:12:36.43,1:12:37.85,Default,,0,0,0,,Бұл ақылға қонымсыз.
Dialogue: 0,1:12:38.56,1:12:39.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:39.68,1:12:41.98,Default,,0,0,0,,Ал, мен сенемін, ақырында
Dialogue: 0,1:12:42.06,1:12:44.44,Default,,0,0,0,,Жауабын табатынымды білдім.
Dialogue: 0,1:12:45.56,1:12:46.94,Default,,0,0,0,,Хомура Акеми
Dialogue: 0,1:12:47.44,1:12:48.98,Default,,0,0,0,,Инкубатор
Dialogue: 0,1:12:50.44,1:12:52.20,Default,,0,0,0,,Өйткені, бәрі
Dialogue: 0,1:12:52.70,1:12:54.99,Default,,0,0,0,,Бұл сіздің әрекетіңіз болды.
Dialogue: 0,1:12:55.07,1:12:56.62,Default,,0,0,0,,Қалған сұрақтар
Dialogue: 0,1:12:56.70,1:13:00.50,Default,,0,0,0,,Қазір өміріңіз бен жаныңыз қайда?
Dialogue: 0,1:13:02.08,1:13:05.58,Default,,0,0,0,,Жауабын айтайын.
Dialogue: 0,1:13:14.84,1:13:18.01,Default,,0,0,0,,Бұл жалған Митакара қаласының сырты.
Dialogue: 0,1:13:19.01,1:13:21.39,Default,,0,0,0,,Сіз шынайы әлемде осылай көрінесіз.
Dialogue: 0,1:13:22.60,1:13:23.89,Default,,0,0,0,,Бұл...
Dialogue: 0,1:13:24.52,1:13:27.15,Default,,0,0,0,,Біз жасаған кедергілерді блоктау өрісі
Dialogue: 0,1:13:27.23,1:13:29.65,Default,,0,0,0,,Жан дүниеңді орау
Dialogue: 0,1:13:29.73,1:13:32.74,Default,,0,0,0,,Өзінің шегіне жеткен жан асыл тас,
Dialogue: 0,1:13:32.82,1:13:36.87,Default,,0,0,0,,Сырттан әсер ете алмайтын ортада шектелген кезде
Dialogue: 0,1:13:37.37,1:13:38.70,Default,,0,0,0,,Не болады?
Dialogue: 0,1:13:44.25,1:13:45.17,Default,,0,0,0,,Сол жерде қылмыскер өліп қалған болар.
Dialogue: 0,1:13:45.25,1:13:48.96,Default,,0,0,0,,Сиқырлы қыздарды тазарту және жою күші
Dialogue: 0,1:13:49.50,1:13:54.63,Default,,0,0,0,,Сіз құбылыстан оқшауланған кезде «дөңгелек принцип» деп атайсыз.
Dialogue: 0,1:13:54.72,1:13:56.76,Default,,0,0,0,,Жан дүниесі не болмақ?
Dialogue: 0,1:13:57.26,1:14:00.64,Default,,0,0,0,,Мен бірнеше қызықты нәтижелерді байқадым.
Dialogue: 0,1:14:01.14,1:14:05.14,Default,,0,0,0,,Бірегей заңдармен басқарылатын тұйық кеңістіктің қалыптасуы
Dialogue: 0,1:14:05.23,1:14:07.60,Default,,0,0,0,,Сыртқы құрбандарды тарту және ұстау
Dialogue: 0,1:14:11.02,1:14:14.19,Default,,0,0,0,,Бір күні маған дәл осылай түсіндірдің.
Dialogue: 0,1:14:14.82,1:14:17.45,Default,,0,0,0,,Бұл «бақсы» сияқты қабілет, солай емес пе?
Dialogue: 0,1:14:20.37,1:14:22.66,Default,,0,0,0,,Блоктау өрісімен қорғалған жан асыл тас
Dialogue: 0,1:14:22.74,1:14:24.54,Default,,0,0,0,,Әлі бұзылмаған
Dialogue: 0,1:14:24.62,1:14:28.79,Default,,0,0,0,,Сіз бақсыға толық айнала алмадыңыз.
Dialogue: 0,1:14:29.54,1:14:31.42,Default,,0,0,0,,Жұмыртқаны сындыра алмаған балапан
Dialogue: 0,1:14:32.09,1:14:35.05,Default,,0,0,0,,Сіз қабықтың ішінде өскен сияқтысыз.
Dialogue: 0,1:14:35.67,1:14:40.26,Default,,0,0,0,,Сонымен, сіз өз ішіңізге тосқауыл қоюды шештіңіз.
Dialogue: 0,1:14:40.89,1:14:46.27,Default,,0,0,0,,Бүкіл қаланы көшіріп, қайта жасауға болатыны таңқаларлық.
Dialogue: 0,1:14:49.73,1:14:50.90,Default,,0,0,0,,Солай болар деп ойлаймын? Жарай берсін, маңызды емес. Маған сен.
Dialogue: 0,1:14:50.98,1:14:54.07,Default,,0,0,0,,Бұл сіздің жан дүниеңіздің асыл тастары.
Dialogue: 0,1:14:57.78,1:14:59.24,Default,,0,0,0,,Бұл логика біртүрлі.
Dialogue: 0,1:15:00.24,1:15:01.78,Default,,0,0,0,,Сыртқы дүниемен байланысы үзілсе
Dialogue: 0,1:15:01.87,1:15:04.87,Default,,0,0,0,,Біреу бұл тосқауылға кіріп кетуі мүмкін.
Dialogue: 0,1:15:04.95,1:15:05.91,Default,,0,0,0,,Бұл болмауы керек еді, солай ма?
Dialogue: 0,1:15:06.00,1:15:07.29,Default,,0,0,0,,Біз сондамыз
Dialogue: 0,1:15:07.37,1:15:09.00,Default,,0,0,0,,Мен оны реттеп жатырмын.
Dialogue: 0,1:15:09.50,1:15:11.08,Default,,0,0,0,,Өрістің блоктау күші тең
Dialogue: 0,1:15:11.17,1:15:13.05,Default,,0,0,0,,Бұл тек бір жақты көше.
Dialogue: 0,1:15:13.13,1:15:16.01,Default,,0,0,0,,Сырттан келген кедергі тойтарылса да
Dialogue: 0,1:15:16.72,1:15:18.72,Default,,0,0,0,,Ішінен нұсқаумен
Dialogue: 0,1:15:19.51,1:15:21.64,Default,,0,0,0,,Жәбірленушілер әкелінуі мүмкін
Dialogue: 0,1:15:22.35,1:15:26.48,Default,,0,0,0,,Сіз бақсы ретінде бейсаналық іздеген жалғыз нысана
Dialogue: 0,1:15:27.06,1:15:28.89,Default,,0,0,0,,Сіз бұл әлемге кіре аласыз
Dialogue: 0,1:15:29.94,1:15:31.94,Default,,0,0,0,,Шарттарды осы уақытқа дейін шектегеннен кейін,
Dialogue: 0,1:15:32.52,1:15:34.73,Default,,0,0,0,,Дегенмен, дөңгелек сақинаның болуы
Dialogue: 0,1:15:34.82,1:15:38.28,Default,,0,0,0,,Егер сіз Хомура Акемиге хабарласқыңыз келсе,
Dialogue: 0,1:15:38.36,1:15:39.49,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,1:15:39.57,1:15:43.58,Default,,0,0,0,,Сіздің тосқауылыңызға шақырылған жәбірленуші ретінде
Dialogue: 0,1:15:43.66,1:15:45.37,Default,,0,0,0,,Біздің бұл дүниеде заттанудан басқа амалымыз жоқ
Dialogue: 0,1:15:46.83,1:15:49.29,Default,,0,0,0,,Бұл жағдайда біз инкубаторлар
Dialogue: 0,1:15:49.37,1:15:53.04,Default,,0,0,0,,Сиқырлы қыздардың жоғалу себебі осы уақытқа дейін жұмбақ болып келді.
Dialogue: 0,1:15:53.13,1:15:56.17,Default,,0,0,0,,Соңында анықтап, бақылай алады
Dialogue: 0,1:15:56.67,1:15:59.09,Default,,0,0,0,,Шын мәнінде, сіз жасаған кедергі
Dialogue: 0,1:15:59.17,1:16:02.43,Default,,0,0,0,,Шынайы әлемде енді жоқ кейіпкер
Dialogue: 0,1:16:02.51,1:16:04.60,Default,,0,0,0,,Біртүрлі түрде қатысу
Dialogue: 0,1:16:04.68,1:16:06.60,Default,,0,0,0,,ерекше қызығушылық тудырады
Dialogue: 0,1:16:06.68,1:16:10.48,Default,,0,0,0,,Өткен естеліктерде немесе болашақ мүмкіндіктерде жоқ
Dialogue: 0,1:16:10.56,1:16:12.19,Default,,0,0,0,,Қыз бала
Dialogue: 0,1:16:15.27,1:16:19.03,Default,,0,0,0,,Бұл ғаламмен себепті байланысы болмаса да
Dialogue: 0,1:16:19.11,1:16:22.99,Default,,0,0,0,,Ол сіздің әлеміңізге еш ыңғайсыздықсыз кіріп кетті.
Dialogue: 0,1:16:24.07,1:16:28.50,Default,,0,0,0,,Маған бірінші кезекте қараудың қажеті жоқ еді.
Dialogue: 0,1:16:28.58,1:16:30.25,Default,,0,0,0,,Мені қиындықтан құтқарған
Dialogue: 0,1:16:31.08,1:16:33.58,Default,,0,0,0,,Сіз өзіңіз Хомура Акемисіз
Dialogue: 0,1:16:34.08,1:16:37.13,Default,,0,0,0,,Сіз дөңгелек принцип туралы біраз уақыттан бері айтып жүрсіз.
Dialogue: 0,1:16:37.21,1:16:40.38,Default,,0,0,0,,Ол мені Мадока Канаме деп атайтын.
Dialogue: 0,1:16:41.05,1:16:43.39,Default,,0,0,0,,Сонда бұл бала...
Dialogue: 0,1:16:43.47,1:16:45.51,Default,,0,0,0,,Жалғыз қиыншылық болды
Dialogue: 0,1:16:45.60,1:16:48.89,Default,,0,0,0,,Мадока Канаме белгісіз күштерді қолданып жатқан сияқты.
Dialogue: 0,1:16:48.97,1:16:50.77,Default,,0,0,0,,Мен оны мүлдем көрсетпедім.
Dialogue: 0,1:16:51.39,1:16:53.90,Default,,0,0,0,,Тосқауылдың шебері ретінде сіздің есте сақтау операцияларыңыз
Dialogue: 0,1:16:53.98,1:16:56.98,Default,,0,0,0,,Мадокаға да әсер еткен сияқты.
Dialogue: 0,1:16:57.48,1:17:01.03,Default,,0,0,0,,Ол сені құтқарғысы келген жоқ.
Dialogue: 0,1:17:01.11,1:17:05.16,Default,,0,0,0,,Мен тіпті өз күшімді және шынайы болмысымды ұмытып кеткен сияқтымын.
Dialogue: 0,1:17:05.24,1:17:07.62,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,1:17:11.62,1:17:18.55,Default,,0,0,0,,(Бақсылардың ән айтуы)
Dialogue: 0,1:17:26.64,1:17:29.93,Default,,0,0,0,,Мадока Канаме өзінің құдай екенін ұмытады.
Dialogue: 0,1:17:30.02,1:17:33.44,Default,,0,0,0,,Хомура Акеми өзінің бақсы екенін ұмытады.
Dialogue: 0,1:17:33.52,1:17:34.85,Default,,0,0,0,,Сізге рахмет, біз
Dialogue: 0,1:17:34.94,1:17:38.27,Default,,0,0,0,,Мен осындай мағынасыз шеруден өтуге мәжбүр болдым.
Dialogue: 0,1:17:38.77,1:17:41.44,Default,,0,0,0,,Мен шыдамдылықпен күтуді жоспарлап едім.
Dialogue: 0,1:17:42.07,1:17:46.74,Default,,0,0,0,,Енді сіз шындыққа жеттіңіз, теңгерім ақыры бұзылады.
Dialogue: 0,1:17:47.28,1:17:49.33,Default,,0,0,0,,Кел, Хомура Акеми
Dialogue: 0,1:17:49.91,1:17:52.00,Default,,0,0,0,,Мадокадан көмек сұраңыз
Dialogue: 0,1:17:52.08,1:17:53.83,Default,,0,0,0,,Бұл да оның есіне түсіреді.
Dialogue: 0,1:17:54.41,1:17:55.96,Default,,0,0,0,,Мен кіммін
Dialogue: 0,1:17:56.04,1:17:58.09,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,1:17:59.17,1:18:02.67,Default,,0,0,0,,Инкубатор Сіздің мақсатыңыз қандай?
Dialogue: 0,1:18:02.76,1:18:03.76,Default,,0,0,0,,Әрине
Dialogue: 0,1:18:03.84,1:18:06.80,Default,,0,0,0,,Осы уақытқа дейін тек гипотеза болып келген дөңгелек сақина принципі.
Dialogue: 0,1:18:06.89,1:18:09.30,Default,,0,0,0,,Өз көзіммен көремін
Dialogue: 0,1:18:10.47,1:18:11.56,Default,,0,0,0,,Не үшін?
Dialogue: 0,1:18:12.27,1:18:14.89,Default,,0,0,0,,Қызығудың қисынсыз екенін айтсам да.
Dialogue: 0,1:18:15.39,1:18:18.56,Default,,0,0,0,,Мадоканың бар екенін растау үшін
Dialogue: 0,1:18:18.65,1:18:21.57,Default,,0,0,0,,Менің мұндай әсіре кезеңге баруым мүмкін емес.
Dialogue: 0,1:18:26.70,1:18:29.07,Default,,0,0,0,,Сіз Мадоканы басқарғыңыз келеді!
Dialogue: 0,1:18:35.08,1:18:35.62,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:18:37.17,1:18:39.13,Default,,0,0,0,,Соңғы мақсатқа қатысты
Dialogue: 0,1:18:39.21,1:18:40.59,Default,,0,0,0,,Мен оны жоққа шығармаймын
Dialogue: 0,1:18:40.67,1:18:42.67,Default,,0,0,0,,Ал, жол қиын болады.
Dialogue: 0,1:18:43.38,1:18:47.43,Default,,0,0,0,,Бұл құбылыс біз үшін толық жұмбақ болды.
Dialogue: 0,1:18:48.09,1:18:51.93,Default,,0,0,0,,Бір нәрсенің бар екенін растай алмасақ, оған қол тигізе алмаймыз.
Dialogue: 0,1:18:52.01,1:18:53.39,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:18:53.47,1:18:56.02,Default,,0,0,0,,Бұл сіздің бас тартатын уақыт емес.
Dialogue: 0,1:18:56.10,1:18:57.39,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:18:57.48,1:18:59.60,Default,,0,0,0,,Егер сіз оны байқай алсаңыз, сіз кедергі жасай аласыз.
Dialogue: 0,1:19:00.19,1:19:02.61,Default,,0,0,0,,Егер сіз кедергі жасай алсаңыз, сіз де басқара аласыз
Dialogue: 0,1:19:02.69,1:19:07.99,Default,,0,0,0,,Бір күні біздің зерттеуіміз шеңберлік принципті толығымен жеңеді.
Dialogue: 0,1:19:08.07,1:19:11.16,Default,,0,0,0,,Олай болса, сиқырлы қыз бақсы болады.
Dialogue: 0,1:19:11.24,1:19:13.87,Default,,0,0,0,,Энергияның одан әрі қалпына келуін күтуге болады
Dialogue: 0,1:19:14.83,1:19:17.37,Default,,0,0,0,,Үміт пен үмітсіздік арасындағы фазалық ауысу
Dialogue: 0,1:19:17.46,1:19:20.75,Default,,0,0,0,,Сол эмоциядан айналатын энергияның жалпы мөлшері
Dialogue: 0,1:19:21.79,1:19:23.38,Default,,0,0,0,,Бұл мен күткеннен де көп болды.
Dialogue: 0,1:19:24.09,1:19:27.76,Default,,0,0,0,,Өйткені, сиқырлы қыздардың мүмкіндіктері шексіз.
Dialogue: 0,1:19:28.34,1:19:32.89,Default,,0,0,0,,Сіз бақсыға айналу арқылы бар болмысыңызды орындауыңыз керек.
Dialogue: 0,1:19:32.97,1:19:33.76,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:19:35.43,1:19:36.77,Default,,0,0,0,,Неге ашуланасың?
Dialogue: 0,1:19:36.85,1:19:39.27,Default,,0,0,0,,Бұл енді сізге қатысы жоқ.
Dialogue: 0,1:19:39.85,1:19:42.15,Default,,0,0,0,,Хомура Әкемінің өмір сүруі аяқталды
Dialogue: 0,1:19:42.23,1:19:44.65,Default,,0,0,0,,Қатал тағдырыңның соңында
Dialogue: 0,1:19:44.73,1:19:48.49,Default,,0,0,0,,Көптен күткен болмыспен қауышу туралы уәдені орындау.
Dialogue: 0,1:19:48.99,1:19:51.28,Default,,0,0,0,,Бұл қуанышты нәрсе ме?
Dialogue: 0,1:19:52.12,1:19:53.03,Default,,0,0,0,,Жоқ
Dialogue: 0,1:19:53.12,1:19:56.12,Default,,0,0,0,,Мен мұндай бақытты қаламаймын.
Dialogue: 0,1:20:00.58,1:20:01.92,Default,,0,0,0,,Бұл...
Dialogue: 0,1:20:02.00,1:20:05.80,Default,,0,0,0,,Өзің қарғыс шақырып не ойлап тұрсың?
Dialogue: 0,1:20:05.88,1:20:07.55,Default,,0,0,0,,Тазалау уақытында аяқталмайды!
Dialogue: 0,1:20:08.84,1:20:11.55,Default,,0,0,0,,Енді білуге мүмкіндік жоқ, бірақ
Dialogue: 0,1:20:11.64,1:20:12.89,Default,,0,0,0,,(Нишики) Бұл... осы туралы сұрауға мен дұрыс адаммын ба?
Dialogue: 0,1:20:13.39,1:20:14.39,Default,,0,0,0,,«Мадоканы құтқару»
Dialogue: 0,1:20:15.10,1:20:17.64,Default,,0,0,0,,Дәл сол дұғамен мен сиқырлы қызға айналдым.
Dialogue: 0,1:20:19.02,1:20:20.77,Default,,0,0,0,,Бұл жолы да солай.
Dialogue: 0,1:20:22.81,1:20:25.23,Default,,0,0,0,,Мадоканың құпиясы ашылғанын қалаймын.
Dialogue: 0,1:20:25.73,1:20:29.03,Default,,0,0,0,,Мен бақсы болуды жалғастырамын.
Dialogue: 0,1:20:29.11,1:20:32.95,Default,,0,0,0,,Мен ол баланың инкубаторға енді қол тигізуіне жол бермеймін.
Dialogue: 0,1:20:33.03,1:20:35.95,Default,,0,0,0,,Осы себепті жеңілдіктен бас тартасыз ба?
Dialogue: 0,1:20:39.70,1:20:44.00,Default,,0,0,0,,Сіз қарғыспен мәңгілік өмір сүруді жоспарлап отырсыз ба?
Dialogue: 0,1:20:45.04,1:20:46.29,Default,,0,0,0,,Жарайды
Dialogue: 0,1:20:46.38,1:20:48.09,Default,,0,0,0,,Мен бұл кедергіге сенімдімін
Dialogue: 0,1:20:48.17,1:20:50.38,Default,,0,0,0,,Бұл менің өлетін жерім болады
Dialogue: 0,1:20:50.47,1:20:53.84,Default,,0,0,0,,Мами Томое мен Киоко Сакура да осында.
Dialogue: 0,1:20:53.93,1:20:55.76,Default,,0,0,0,,Мен оларға сенемін
Dialogue: 0,1:20:57.22,1:20:58.31,Default,,0,0,0,,Ақымақ...
Dialogue: 0,1:20:58.39,1:21:01.39,Default,,0,0,0,,Осы блоктау өрісінің ішінде өлу нені білдіреді?
Dialogue: 0,1:21:01.48,1:21:02.89,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,1:21:02.98,1:21:04.65,Default,,0,0,0,,Өз қабығыңыздан шығудан бас тартыңыз
Dialogue: 0,1:21:04.73,1:21:07.65,Default,,0,0,0,,Егер сіз жұмыртқаның ішінде бақсы болып аяқталған болсаңыз ше?
Dialogue: 0,1:21:07.73,1:21:12.15,Default,,0,0,0,,Сіз тіпті айналма принцип арқылы анықталмай жойыласыз.
Dialogue: 0,1:21:12.24,1:21:15.53,Default,,0,0,0,,Жаныңды үмітсіздіктен енді ешкім құтқара алмайды.
Dialogue: 0,1:21:15.62,1:21:18.66,Default,,0,0,0,,Мадока Канамемен қайта кездесуге мүмкіндігіңіз бар.
Dialogue: 0,1:21:18.74,1:21:20.54,Default,,0,0,0,,Оны мәңгілікке жоғалту керек пе?
Dialogue: 0,1:21:22.41,1:21:25.42,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,1:21:26.33,1:21:27.13,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,1:21:27.21,1:21:27.88,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:21:28.50,1:21:30.55,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,1:21:30.63,1:21:31.67,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:21:33.51,1:21:36.55,Default,,0,0,0,,Бұл сіз үшін де ең нашар аяқталу шығар.
Dialogue: 0,1:21:36.64,1:21:37.30,Default,,0,0,0,,Ха!
Dialogue: 0,1:21:37.80,1:21:40.47,Default,,0,0,0,,Адамдар дәл неге ойлайды?
Dialogue: 0,1:21:40.56,1:21:42.23,Default,,0,0,0,,Бұл қаншалықты қисынсыз?
Dialogue: 0,1:21:42.31,1:21:43.31,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:21:44.27,1:21:45.90,Default,,0,0,0,,Форт! Да! Форт! Да!
Dialogue: 0,1:21:45.98,1:21:46.98,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:21:54.15,1:21:54.95,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:58.87,1:21:59.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:00.91,1:22:02.08,Default,,0,0,0,,Мадока?
Dialogue: 0,1:22:04.46,1:22:04.96,Default,,0,0,0,,Ха!
Dialogue: 0,1:22:05.75,1:22:06.88,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,1:22:13.47,1:22:14.26,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:22:14.88,1:22:17.47,Default,,0,0,0,,Уф! Уф! Қарғыс атқыр...
Dialogue: 0,1:22:21.56,1:22:23.35,Default,,0,0,0,,Бұл... бақсы
Dialogue: 0,1:22:24.85,1:22:28.31,Default,,0,0,0,,Сезімдерім мені қуып барады
Dialogue: 0,1:22:46.71,1:22:50.54,Default,,0,0,0,,Тек жылтырлық пен өкініш
Dialogue: 0,1:22:51.71,1:22:54.51,Default,,0,0,0,,Мен енді есімде жоқ
Dialogue: 0,1:23:04.10,1:23:05.56,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:23:09.69,1:23:10.52,Default,,0,0,0,,О
Dialogue: 0,1:23:11.36,1:23:14.11,Default,,0,0,0,,Бұл менің...
Dialogue: 0,1:23:15.11,1:23:16.24,Default,,0,0,0,,Үмітсіздік
Dialogue: 0,1:23:26.12,1:23:27.91,Default,,0,0,0,,Мадока
Dialogue: 0,1:23:28.71,1:23:34.05,Default,,0,0,0,,Мені осындай жерде қарсы алуға келгеніңіз үшін рахмет.
Dialogue: 0,1:23:34.13,1:23:35.26,Default,,0,0,0,,Рахмет
Dialogue: 0,1:23:36.88,1:23:40.18,Default,,0,0,0,,Ақыры мен қоштаса алмаймын
Dialogue: 0,1:23:41.97,1:23:42.55,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:23:59.65,1:24:01.82,Default,,0,0,0,,(дыбыстық сигналды ашу)
Dialogue: 0,1:24:43.45,1:24:47.37,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:24:49.37,1:24:50.87,Default,,0,0,0,,Бұл... бақсы ма?
Dialogue: 0,1:24:51.66,1:24:53.54,Default,,0,0,0,,Қорықпа
Dialogue: 0,1:24:53.63,1:24:56.75,Default,,0,0,0,,Әй, қарағым, ең қиыны – өзі.
Dialogue: 0,1:24:57.67,1:24:58.96,Default,,0,0,0,,Бұл күлкілі емес.
Dialogue: 0,1:24:59.46,1:25:00.51,Default,,0,0,0,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,1:25:00.59,1:25:02.80,Default,,0,0,0,,Бұл Хомура Акеми.
Dialogue: 0,1:25:02.88,1:25:04.89,Default,,0,0,0,,Достарыңызбен төбелескіңіз келе ме?
Dialogue: 0,1:25:05.64,1:25:06.89,Default,,0,0,0,,Күбей...
Dialogue: 0,1:25:06.97,1:25:10.14,Default,,0,0,0,,Эй, сен қалыпты сөйлей алдың.
Dialogue: 0,1:25:12.48,1:25:14.10,Default,,0,0,0,,Ұят болды, Күйбей.
Dialogue: 0,1:25:14.60,1:25:17.27,Default,,0,0,0,,Енді Бебенің әңгімесіне сенуден басқа амалым жоқ сияқты.
Dialogue: 0,1:25:17.98,1:25:20.78,Default,,0,0,0,,Мадока, сіз Хомураны құтқара алуыңыз керек.
Dialogue: 0,1:25:21.40,1:25:24.28,Default,,0,0,0,,Егер сізде бар шынайы күш-қуатты түсінсеңіз!
Dialogue: 0,1:25:24.91,1:25:25.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:26.37,1:25:28.41,Default,,0,0,0,,Бұл жеңілдеді, Мадока.
Dialogue: 0,1:25:28.49,1:25:29.91,Default,,0,0,0,,Жарайды
Dialogue: 0,1:25:29.99,1:25:32.29,Default,,0,0,0,,Менің айтқанымды орында.
Dialogue: 0,1:25:32.37,1:25:33.62,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:25:34.12,1:25:36.54,Default,,0,0,0,,Папа Папа Папа…
Dialogue: 0,1:25:36.63,1:25:38.67,Default,,0,0,0,,Пармиджиано Реджиано!
Dialogue: 0,1:25:49.72,1:25:51.56,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:25:52.68,1:25:53.18,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:25:54.69,1:25:57.23,Default,,0,0,0,,(Ведмияның айқайы)
Dialogue: 0,1:25:59.65,1:26:00.65,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:26:01.15,1:26:02.44,Default,,0,0,0,,Дүрбелеңге салынбаңыз
Dialogue: 0,1:26:03.24,1:26:06.41,Default,,0,0,0,,Мен сені шығарайын деп жатқан жоқпын... Жоқ!
Dialogue: 0,1:26:20.38,1:26:23.05,Default,,0,0,0,,Сен... сен несің...
Dialogue: 0,1:26:23.13,1:26:26.30,Default,,0,0,0,,Біз бір кездері үміт артқанбыз
Dialogue: 0,1:26:26.38,1:26:29.05,Default,,0,0,0,,Бір кезде қарғыс атқандар
Dialogue: 0,1:26:29.14,1:26:31.81,Default,,0,0,0,,Ал енді шеңберді басшылыққа алады
Dialogue: 0,1:26:31.89,1:26:34.81,Default,,0,0,0,,Бұл дүниенің себеп-салдарынан адасқандар
Dialogue: 0,1:26:40.52,1:26:41.69,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:26:45.78,1:26:46.57,Default,,0,0,0,,Егер сіз мұны істесеңіз
Dialogue: 0,1:26:46.65,1:26:49.70,Default,,0,0,0,,Мен сіздің назарыңызды ұрлап, айналайын деп ойладым.
Dialogue: 0,1:26:50.28,1:26:51.20,Default,,0,0,0,,Инкубатор
Dialogue: 0,1:26:52.83,1:26:56.96,Default,,0,0,0,,Сіз Мадокаға нөл беріп, ұсталып қалдыңыз.
Dialogue: 0,1:26:57.04,1:26:58.37,Default,,0,0,0,,Бұл...
Dialogue: 0,1:26:58.46,1:26:59.71,Default,,0,0,0,,Онда сендер де балалар
Dialogue: 0,1:26:59.79,1:27:01.34,Default,,0,0,0,,Дөңгелек сақина принципі
Dialogue: 0,1:27:01.42,1:27:05.26,Default,,0,0,0,,Жарайды, қысқасы, сөмке көтергендей.
Dialogue: 0,1:27:05.84,1:27:07.93,Default,,0,0,0,,Мадока қалдырған естеліктер мен күштер
Dialogue: 0,1:27:08.01,1:27:10.93,Default,,0,0,0,,Оны біреу алып жүруі керек еді.
Dialogue: 0,1:27:11.01,1:27:13.31,Default,,0,0,0,,Төтенше жағдайда бұл мен немесе Саяка.
Dialogue: 0,1:27:13.39,1:27:15.27,Default,,0,0,0,,Қайсысы қауіпсіз?
Dialogue: 0,1:27:15.35,1:27:19.10,Default,,0,0,0,,Ол Мадокаға сақтаған шынайы естеліктерін қайтаруы керек еді.
Dialogue: 0,1:27:23.11,1:27:25.23,Default,,0,0,0,,Хомура Мен бір адамды алып кетейін.
Dialogue: 0,1:27:25.32,1:27:26.99,Default,,0,0,0,,Оған үш адам қажет болды.
Dialogue: 0,1:27:30.74,1:27:33.41,Default,,0,0,0,,Сіз маған көп қиындық келтірдіңіз.
Dialogue: 0,1:27:35.75,1:27:39.54,Default,,0,0,0,,Менің одан басқа амалым жоқ деп ойлаймын.
Dialogue: 0,1:27:40.17,1:27:42.13,Default,,0,0,0,,Осы уақытқа дейін көп еңбек еткендер үшін
Dialogue: 0,1:27:42.21,1:27:44.55,Default,,0,0,0,,Қандай да бір сыйлық болса жақсы болар еді.
Dialogue: 0,1:27:46.59,1:27:48.01,Default,,0,0,0,,Саяка-чан
Dialogue: 0,1:27:48.09,1:27:48.59,Default,,0,0,0,,Ах!
Dialogue: 0,1:27:48.68,1:27:51.80,Default,,0,0,0,,Канаме-сан, біз де барамыз!
Dialogue: 0,1:27:51.89,1:27:53.89,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,1:27:58.94,1:27:59.69,Default,,0,0,0,,Әй!
Dialogue: 0,1:28:05.40,1:28:07.49,Default,,0,0,0,,Тоқта... қазірдің өзінде тоқтат!
Dialogue: 0,1:28:07.99,1:28:10.91,Default,,0,0,0,,Мен бұл дүниеде өлуім керек!
Dialogue: 0,1:28:23.88,1:28:24.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:34.26,1:28:35.31,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:28:36.26,1:28:37.77,Default,,0,0,0,,Да~қара~ра!
Dialogue: 0,1:28:38.77,1:28:42.85,Default,,0,0,0,,Оны жалғыз алып жүруге тырыспаңыз!
Dialogue: 0,1:28:47.57,1:28:48.74,Default,,0,0,0,,Цк
Dialogue: 0,1:28:48.82,1:28:51.36,Default,,0,0,0,,Мағынасы жоқ нәрселерге араласу
Dialogue: 0,1:28:51.45,1:28:52.74,Default,,0,0,0,,Ой
Dialogue: 0,1:28:52.82,1:28:54.16,Default,,0,0,0,,Рахмет
Dialogue: 0,1:28:54.24,1:28:54.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:55.41,1:28:57.74,Default,,0,0,0,,Мен ауыр түс көрдім.
Dialogue: 0,1:28:58.87,1:29:00.79,Default,,0,0,0,,Сіздің өліп жатқаныңызды армандаңыз
Dialogue: 0,1:29:02.83,1:29:05.63,Default,,0,0,0,,Бірақ бұл шын мәнінде шындық.
Dialogue: 0,1:29:05.71,1:29:09.42,Default,,0,0,0,,Дәл қазір осылай күресу біз үшін арман...
Dialogue: 0,1:29:09.92,1:29:12.59,Default,,0,0,0,,Солай ма? Саяка
Dialogue: 0,1:29:15.97,1:29:20.35,Default,,0,0,0,,Бұл арман сияқты қайғылы емес.
Dialogue: 0,1:29:21.35,1:29:23.73,Default,,0,0,0,,Мен өкінбеймін деп ойладым, бірақ
Dialogue: 0,1:29:24.94,1:29:27.36,Default,,0,0,0,,Соның өзінде
Dialogue: 0,1:29:28.15,1:29:31.15,Default,,0,0,0,,Мен мұндай рөлді алып, қайта оралғаныма сене алар емеспін.
Dialogue: 0,1:29:32.15,1:29:35.91,Default,,0,0,0,,Мен өкінетін шығармын.
Dialogue: 0,1:29:36.49,1:29:39.41,Default,,0,0,0,,Мен сені артта қалдырдым
Dialogue: 0,1:29:39.99,1:29:44.04,Default,,0,0,0,,Нағиса жаңа ғана ірімшік жегісі келді.
Dialogue: 0,1:29:44.12,1:29:44.67,Default,,0,0,0,,Уф...
Dialogue: 0,1:29:44.75,1:29:48.09,Default,,0,0,0,,Сәлем! Атмосфераны оқыңыз!
Dialogue: 0,1:29:51.21,1:29:51.88,Default,,0,0,0,,Иә
Dialogue: 0,1:29:53.13,1:29:54.13,Default,,0,0,0,,Иә!
Dialogue: 0,1:29:54.97,1:29:56.26,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:29:57.22,1:29:58.68,Default,,0,0,0,,Иә!
Dialogue: 0,1:30:03.73,1:30:05.27,Default,,0,0,0,,Иә! (Киоко) Қарғыс атсын!
Dialogue: 0,1:30:32.42,1:30:34.34,Default,,0,0,0,,Тиро финалы!
Dialogue: 0,1:30:34.42,1:30:35.51,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:30:38.76,1:30:40.43,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:30:48.40,1:30:49.56,Default,,0,0,0,,Хомура-чан!
Dialogue: 0,1:30:49.65,1:30:52.07,Default,,0,0,0,,Тоқта... Мадока!
Dialogue: 0,1:31:11.42,1:31:14.09,Default,,0,0,0,,Мен оны көріп тұрмын! Бұл инкубатордың мөрі!
Dialogue: 0,1:31:15.05,1:31:18.68,Default,,0,0,0,,Сол нәрсені құртсаң, бостан бола аласың, Хомура.
Dialogue: 0,1:31:19.18,1:31:21.55,Default,,0,0,0,,Инкубатор кедергісіз
Dialogue: 0,1:31:22.05,1:31:25.35,Default,,0,0,0,,Нағыз Мадоканы сыртқы әлемде қарсы алыңыз!
Dialogue: 0,1:31:28.31,1:31:29.06,Default,,0,0,0,,Ах!
Dialogue: 0,1:31:31.31,1:31:32.86,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,1:31:44.79,1:31:47.00,Default,,0,0,0,,Жоқ, Хомура-чан
Dialogue: 0,1:31:47.83,1:31:51.38,Default,,0,0,0,,Мен саған жалғыз болма дедім.
Dialogue: 0,1:31:51.46,1:31:52.71,Default,,0,0,0,,Мадока…
Dialogue: 0,1:31:53.21,1:31:56.76,Default,,0,0,0,,Қандай жағдай болмасын, Хомура-чан - Хомура-чан.
Dialogue: 0,1:31:56.84,1:31:59.26,Default,,0,0,0,,Мен сені ешқашан тастамаймын
Dialogue: 0,1:31:59.84,1:32:01.97,Default,,0,0,0,,Сондықтан берілмеңіз
Dialogue: 0,1:32:02.97,1:32:08.52,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:32:10.10,1:32:11.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:32:12.77,1:32:15.27,Default,,0,0,0,,Мен... қыңыр болдым.
Dialogue: 0,1:32:15.36,1:32:18.28,Default,,0,0,0,,Мен сені қайта көргім келеді
Dialogue: 0,1:32:18.36,1:32:20.86,Default,,0,0,0,,Мен бұл сезімге опасыздық жасар едім...
Dialogue: 0,1:32:21.36,1:32:24.91,Default,,0,0,0,,Иә, мен кез келген күнәні көтере аламын.
Dialogue: 0,1:32:26.08,1:32:28.54,Default,,0,0,0,,Қандай пішінде болсаң да
Dialogue: 0,1:32:28.62,1:32:30.41,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін.
Dialogue: 0,1:32:30.50,1:32:33.29,Default,,0,0,0,,Сен менің жанымда болғанша
Dialogue: 0,1:32:34.13,1:32:37.26,Default,,0,0,0,,Жүр, Хомура-чан, менімен бірге жүр.
Dialogue: 0,1:32:38.67,1:32:39.47,Default,,0,0,0,,Иә
Dialogue: 0,1:32:52.48,1:32:54.31,Default,,0,0,0,,Хомура-чан, қорықпайсың ба?
Dialogue: 0,1:32:54.81,1:32:56.44,Default,,0,0,0,,Егер ол оны өзінің Қабілетімен көтерсе, бастаманы өз қолына алады
Dialogue: 0,1:32:57.32,1:33:00.19,Default,,0,0,0,,Мен енді тартынбаймын
Dialogue: 0,1:33:14.58,1:33:16.71,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:33:17.92,1:33:19.17,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,1:33:59.25,1:34:00.67,Default,,0,0,0,,Сен кеттің бе?
Dialogue: 0,1:34:01.67,1:34:04.38,Default,,0,0,0,,Саякамо, сенің де бебең...
Dialogue: 0,1:34:16.90,1:34:17.69,Default,,0,0,0,,Жоқ
Dialogue: 0,1:34:18.36,1:34:18.98,Default,,0,0,0,,Иә?
Dialogue: 0,1:34:20.78,1:34:24.49,Default,,0,0,0,,Енді мен оны өзіммен бірге алып бара жатырмын.
Dialogue: 0,1:34:27.53,1:34:29.99,Default,,0,0,0,,Бұл... Мадока Канаме ме?
Dialogue: 0,1:34:30.08,1:34:30.74,Default,,0,0,0,,Иә
Dialogue: 0,1:34:32.45,1:34:36.50,Default,,0,0,0,,Бізді бір күні басшылыққа алатын дөңгелек принцип
Dialogue: 0,1:34:51.85,1:34:53.10,Default,,0,0,0,,Бұл болды
Dialogue: 0,1:34:53.60,1:34:57.27,Default,,0,0,0,,Мен Хомура-чан үшін...
Dialogue: 0,1:35:00.11,1:35:03.48,Default,,0,0,0,,Мен маңызды нәрсені ұмытып кеткеніме сене алар емеспін.
Dialogue: 0,1:35:03.57,1:35:06.53,Default,,0,0,0,,Бұл қажетсіз кедергі.
Dialogue: 0,1:35:06.61,1:35:09.95,Default,,0,0,0,,Менің ойымша, бұл аздап айналма жол болды.
Dialogue: 0,1:35:10.03,1:35:11.53,Default,,0,0,0,,О, тәңірім!
Dialogue: 0,1:35:22.55,1:35:24.55,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,1:35:26.38,1:35:29.43,Default,,0,0,0,,Бүгінге дейін тынбай еңбек еттіңіз ғой, солай емес пе?
Dialogue: 0,1:35:30.85,1:35:32.30,Default,,0,0,0,,Мадока…
Dialogue: 0,1:35:32.39,1:35:34.39,Default,,0,0,0,,Келесі кезекте біз
Dialogue: 0,1:35:34.89,1:35:37.39,Default,,0,0,0,,Бұдан былай біз мәңгі бірге боламыз.
Dialogue: 0,1:35:37.89,1:35:40.19,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,1:35:41.02,1:35:42.23,Default,,0,0,0,,Осы уақытта
Dialogue: 0,1:35:44.11,1:35:45.23,Default,,0,0,0,,Мен күттім
Dialogue: 0,1:35:48.36,1:35:50.70,Default,,0,0,0,,Ах! Хомура-чан?
Dialogue: 0,1:35:51.41,1:35:52.41,Default,,0,0,0,,Ақырында...
Dialogue: 0,1:35:54.20,1:35:55.58,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,1:35:57.91,1:35:59.12,Default,,0,0,0,,О... Эй!
Dialogue: 0,1:35:59.21,1:36:00.88,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,1:36:00.96,1:36:02.46,Default,,0,0,0,,Акеми-сан!
Dialogue: 0,1:36:03.46,1:36:06.88,Default,,0,0,0,,Soul Gem қарғысқа қарағанда қорқынышты түске айналды...
Dialogue: 0,1:36:06.96,1:36:08.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:36:08.34,1:36:11.26,Default,,0,0,0,,Қалау? Обсессия? Жоқ, олай емес
Dialogue: 0,1:36:11.84,1:36:14.14,Default,,0,0,0,,Хомура Акеми сен кімсің...
Dialogue: 0,1:36:15.10,1:36:16.14,Default,,0,0,0,,Ха…
Dialogue: 0,1:36:19.44,1:36:21.52,Default,,0,0,0,,Түсінбеуіңіз таңқаларлық емес.
Dialogue: 0,1:36:22.31,1:36:25.23,Default,,0,0,0,,Иә, ешкім айта алмайды.
Dialogue: 0,1:36:25.73,1:36:26.65,Default,,0,0,0,,Уф...
Dialogue: 0,1:36:26.73,1:36:29.65,Default,,0,0,0,,Бұл сезім тек менікі
Dialogue: 0,1:36:30.32,1:36:32.16,Default,,0,0,0,,Мадока үшін бір нәрсе
Dialogue: 0,1:36:36.87,1:36:39.00,Default,,0,0,0,,(Пілдің айқайы)
Dialogue: 0,1:36:39.96,1:36:42.00,Default,,0,0,0,,Хомура-чан... жоқ
Dialogue: 0,1:36:43.58,1:36:45.00,Default,,0,0,0,,Мен жыртамын!
Dialogue: 0,1:36:48.26,1:36:50.13,Default,,0,0,0,,Мен саған айттым ғой, Мадока.
Dialogue: 0,1:36:51.59,1:36:54.01,Default,,0,0,0,,Мен сені енді ешқашан жібермеймін
Dialogue: 0,1:37:01.60,1:37:02.31,Default,,0,0,0,,Уф!
Dialogue: 0,1:37:02.39,1:37:03.06,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:03.15,1:37:03.77,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:03.85,1:37:04.52,Default,,0,0,0,,Ах!
Dialogue: 0,1:38:09.88,1:38:12.59,Default,,0,0,0,,Дүние қайта жазылуда
Dialogue: 0,1:38:12.67,1:38:16.84,Default,,0,0,0,,Бұл ғаламда жаңа ұғым туды ма?
Dialogue: 0,1:38:16.93,1:38:20.43,Default,,0,0,0,,Ойлап қарасам, есіңде жоқ.
Dialogue: 0,1:38:21.43,1:38:23.77,Default,,0,0,0,,Мен оны екінші рет көріп тұрмын
Dialogue: 0,1:38:23.85,1:38:25.27,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:38:26.06,1:38:29.48,Default,,0,0,0,,Хомура Акеми, сен не араласып тұрсың?
Dialogue: 0,1:38:29.57,1:38:31.48,Default,,0,0,0,,Сіз нені өзгерттіңіз?
Dialogue: 0,1:38:33.82,1:38:34.49,Default,,0,0,0,,Иә
Dialogue: 0,1:38:34.57,1:38:36.24,Default,,0,0,0,,Сенгісіз
Dialogue: 0,1:38:36.32,1:38:38.45,Default,,0,0,0,,Қарғыс атқан жанның асылы
Dialogue: 0,1:38:38.53,1:38:40.78,Default,,0,0,0,,Жоғалып кетуі керек еді сенің жаның
Dialogue: 0,1:38:41.29,1:38:42.16,Default,,0,0,0,,Неге...
Dialogue: 0,1:38:42.79,1:38:43.87,Default,,0,0,0,,есіме түсті
Dialogue: 0,1:38:44.66,1:38:46.71,Default,,0,0,0,,Бүгінгі күнге дейін қайта-қайта
Dialogue: 0,1:38:46.79,1:38:49.04,Default,,0,0,0,,Барлық қайғы-қасірет
Dialogue: 0,1:38:49.13,1:38:51.21,Default,,0,0,0,,Мен Мадоканы ойладым.
Dialogue: 0,1:38:51.96,1:38:55.63,Default,,0,0,0,,Сондықтан да қазір мен үшін азаптың өзі қымбат
Dialogue: 0,1:38:56.22,1:38:58.34,Default,,0,0,0,,Менің жан дүниемді не бұлтты?
Dialogue: 0,1:38:58.84,1:39:00.89,Default,,0,0,0,,Бұл енді қарғыс емес еді.
Dialogue: 0,1:39:00.97,1:39:03.39,Default,,0,0,0,,Сонда не болды...
Dialogue: 0,1:39:04.56,1:39:07.06,Default,,0,0,0,,Оны түсіну мүмкін емес.
Dialogue: 0,1:39:07.14,1:39:08.06,Default,,0,0,0,,Инкубатор
Dialogue: 0,1:39:09.77,1:39:13.11,Default,,0,0,0,,Бұл адам сезімінің шыңы
Dialogue: 0,1:39:13.61,1:39:17.49,Default,,0,0,0,,Үміттен ыстық, үмітсіздіктен терең
Dialogue: 0,1:39:18.57,1:39:19.70,Default,,0,0,0,,Махаббат
Dialogue: 0,1:39:22.79,1:39:25.83,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,1:39:25.91,1:39:28.21,Default,,0,0,0,,Сиқырлы қыз немесе бақсы емес
Dialogue: 0,1:39:28.29,1:39:31.00,Default,,0,0,0,,Жер бетінде сіз қай жерге жетуге тырысасыз?
Dialogue: 0,1:39:31.67,1:39:32.80,Default,,0,0,0,,Иә.
Dialogue: 0,1:39:33.30,1:39:36.47,Default,,0,0,0,,Шынында да, мен қазір бақсы да емеспін.
Dialogue: 0,1:39:37.68,1:39:40.59,Default,,0,0,0,,Ол құдай бірдей киелі.
Dialogue: 0,1:39:40.68,1:39:42.72,Default,,0,0,0,,Не жойылды?
Dialogue: 0,1:39:43.26,1:39:45.47,Default,,0,0,0,,Осындай нәрсені істей алатын тіршілік иесі
Dialogue: 0,1:39:45.56,1:39:49.23,Default,,0,0,0,,Менің ойымша, оны қазір шайтан деп атаған жөн.
Dialogue: 0,1:39:52.19,1:39:53.52,Default,,0,0,0,,Енді түсінікті
Dialogue: 0,1:39:54.53,1:39:58.61,Default,,0,0,0,,Сіздің адами сезімдеріңізді пайдалану үшін тым қауіпті.
Dialogue: 0,1:39:58.70,1:40:03.62,Default,,0,0,0,,Бізде мұндай төтенше нәтижеге бақылау жоқ.
Dialogue: 0,1:40:03.70,1:40:05.37,Default,,0,0,0,,Иә
Dialogue: 0,1:40:07.45,1:40:08.58,Default,,0,0,0,,Уау!
Dialogue: 0,1:40:09.21,1:40:10.37,Default,,0,0,0,,Бірақ
Dialogue: 0,1:40:10.87,1:40:14.13,Default,,0,0,0,,Біздің әлемде пайда болған қарғыспен қалай күресуге болады
Dialogue: 0,1:40:14.71,1:40:18.26,Default,,0,0,0,,Бізге сіздің қатысуыңыз қажет.
Dialogue: 0,1:40:19.01,1:40:21.14,Default,,0,0,0,,Мен сізден ынтымақтастық туралы сұраймын.
Dialogue: 0,1:40:23.43,1:40:25.51,Default,,0,0,0,,Инкубатор
Dialogue: 0,1:41:05.05,1:41:06.10,Default,,0,0,0,,(кесенің сынған дыбысы)
Dialogue: 0,1:41:06.60,1:41:07.22,Default,,0,0,0,,Ах
Dialogue: 0,1:41:32.37,1:41:32.87,Default,,0,0,0,,Ах
Dialogue: 0,1:41:35.50,1:41:36.25,Default,,0,0,0,,Иә
Dialogue: 0,1:41:43.01,1:41:43.68,Default,,0,0,0,,Ах!
Dialogue: 0,1:41:58.07,1:42:01.19,Default,,0,0,0,,Сіз не істегеніңізді білесіз бе?
Dialogue: 0,1:42:01.86,1:42:05.32,Default,,0,0,0,,Қарап тұрсаңыз, не болғанын түсінген сияқтысыз.
Dialogue: 0,1:42:05.41,1:42:06.82,Default,,0,0,0,,Саяка Мики
Dialogue: 0,1:42:07.57,1:42:11.29,Default,,0,0,0,,Сіз шеңбер принципінің бір бөлігін үздіңіз!
Dialogue: 0,1:42:11.79,1:42:14.21,Default,,0,0,0,,Сиқырлы қыздың үміті құтқару күші еді...
Dialogue: 0,1:42:15.08,1:42:18.54,Default,,0,0,0,,Менің алып кеткенім бір үзінді ғана.
Dialogue: 0,1:42:19.21,1:42:23.97,Default,,0,0,0,,Мадока Мадока болуды тоқтатқанға дейін адам болғаны туралы ғана жазбалар.
Dialogue: 0,1:42:26.14,1:42:28.35,Default,,0,0,0,,Шамасы, сендер де қатыстыңдар.
Dialogue: 0,1:42:28.97,1:42:32.35,Default,,0,0,0,,Мен бұрынғы орныма орала алмайтын сияқтымын.
Dialogue: 0,1:42:32.43,1:42:33.98,Default,,0,0,0,,Сіздің қандай құқықтарыңыз бар?
Dialogue: 0,1:42:34.06,1:42:34.85,Default,,0,0,0,,Манет осылай...
Dialogue: 0,1:42:36.48,1:42:39.36,Default,,0,0,0,,Мен қазір «шайтанмын»
Dialogue: 0,1:42:40.11,1:42:43.86,Default,,0,0,0,,Ақыл-ойды бұзып, мына дүниені таптайтын болмыс
Dialogue: 0,1:42:44.44,1:42:47.74,Default,,0,0,0,,Құдайдың заңына қарсы тұру табиғи нәрсе емес пе?
Dialogue: 0,1:42:49.12,1:42:52.04,Default,,0,0,0,,Сіз бұл ғаламсыз
Dialogue: 0,1:42:52.87,1:42:53.87,Default,,0,0,0,,Сіз оны жоюды жоспарлап отырсыз ба?
Dialogue: 0,1:42:55.71,1:42:58.33,Default,,0,0,0,,Барлық жын-шайтан аңдары жойылғаннан кейін
Dialogue: 0,1:42:58.42,1:42:59.88,Default,,0,0,0,,Бұл да жақсы болуы мүмкін.
Dialogue: 0,1:43:00.63,1:43:02.21,Default,,0,0,0,,Содан кейін қайтадан
Dialogue: 0,1:43:02.96,1:43:05.30,Default,,0,0,0,,Мен сенің жауың боламын
Dialogue: 0,1:43:06.51,1:43:08.09,Default,,0,0,0,,Бірақ Саяка Мики
Dialogue: 0,1:43:08.18,1:43:10.80,Default,,0,0,0,,Сіз маған қарсы тұра аласыз ба?
Dialogue: 0,1:43:11.97,1:43:12.60,Default,,0,0,0,,Уф...
Dialogue: 0,1:43:13.52,1:43:16.77,Default,,0,0,0,,Қазірдің өзінде есте сақтау қабілетіңіз бірте-бірте өзгеріп жатыр, солай ма?
Dialogue: 0,1:43:19.15,1:43:20.56,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:43:20.65,1:43:23.07,Default,,0,0,0,,Хэхе хахаха
Dialogue: 0,1:43:23.15,1:43:24.28,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:43:25.19,1:43:30.28,Default,,0,0,0,,Мен... әрине, үлкенірек нәрсенің бір бөлігі болдым.
Dialogue: 0,1:43:31.07,1:43:34.66,Default,,0,0,0,,Мен бұл дүниеден тыс күшке қосылған болсам да.
Dialogue: 0,1:43:34.75,1:43:38.79,Default,,0,0,0,,Енді мен бұл сезімді қайтара алмаймын
Dialogue: 0,1:43:38.87,1:43:40.29,Default,,0,0,0,,Хэхе хаха
Dialogue: 0,1:43:40.38,1:43:43.05,Default,,0,0,0,,Мен мұнда емес, бір жерде болуым керек еді...
Dialogue: 0,1:43:43.71,1:43:44.96,Default,,0,0,0,,Адал болыңыз
Dialogue: 0,1:43:45.05,1:43:47.72,Default,,0,0,0,,Мен қайтадан адамдық өмірге қол жеткізе алдым.
Dialogue: 0,1:43:47.80,1:43:49.55,Default,,0,0,0,,Менің ойымша, сіз бақытты болуыңыз керек.
Dialogue: 0,1:43:49.64,1:43:52.68,Default,,0,0,0,,Ақырында не болғанын ұмытасың.
Dialogue: 0,1:43:52.76,1:43:54.93,Default,,0,0,0,,Сіз тіпті ыңғайсыздықты да сезбейсіз.
Dialogue: 0,1:43:56.02,1:43:58.69,Default,,0,0,0,,Солай болса да, мен мұны ешқашан ұмытпаймын.
Dialogue: 0,1:43:59.81,1:44:01.19,Default,,0,0,0,,Хомура Акеми сен
Dialogue: 0,1:44:02.19,1:44:03.44,Default,,0,0,0,,Бұл шайтан!
Dialogue: 0,1:44:05.15,1:44:07.69,Default,,0,0,0,,Тым болмаса қалыпты тіл табысуға тырысыңыз.
Dialogue: 0,1:44:08.28,1:44:09.82,Default,,0,0,0,,Егер сіз тым даулассаңыз
Dialogue: 0,1:44:10.95,1:44:13.28,Default,,0,0,0,,Ол бала да мені жек көреді.
Dialogue: 0,1:44:14.16,1:44:15.58,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:44:15.66,1:44:17.54,Default,,0,0,0,,Хахаха хехехе
Dialogue: 0,1:44:18.04,1:44:19.00,Default,,0,0,0,,Сәлем Саяка
Dialogue: 0,1:44:19.08,1:44:19.58,Default,,0,0,0,,Ах
Dialogue: 0,1:44:19.67,1:44:20.67,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:44:20.75,1:44:22.71,Default,,0,0,0,,Қайырлы таң Саяка-сан
Dialogue: 0,1:44:23.50,1:44:25.67,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,1:44:27.97,1:44:30.26,Default,,0,0,0,,Мм... Қайырлы таң.
Dialogue: 0,1:44:30.76,1:44:32.93,Default,,0,0,0,,Иә, қайырлы таң, екеуің де.
Dialogue: 0,1:44:33.51,1:44:35.26,Default,,0,0,0,,Не болды? Саяка
Dialogue: 0,1:44:35.35,1:44:37.72,Default,,0,0,0,,Хехехехе, бұл не екені қызық.
Dialogue: 0,1:44:37.81,1:44:41.27,Default,,0,0,0,,Киосуке мен Хитомиге тағы да "қайырлы таң" деп айта алатыныма сене алар емеспін.
Dialogue: 0,1:44:41.35,1:44:43.65,Default,,0,0,0,,Осының өзі мені бақытты етеді
Dialogue: 0,1:44:43.73,1:44:46.86,Default,,0,0,0,,Мен оны ешқашан елестеткен емеспін.
Dialogue: 0,1:44:47.73,1:44:51.57,Default,,0,0,0,,Саяка әдеттегідей оғаш сөздер айтады.
Dialogue: 0,1:44:51.66,1:44:54.99,Default,,0,0,0,,Дұрыс, мен әрқашан таңқаларлық қыз болдым.
Dialogue: 0,1:44:55.08,1:44:57.79,Default,,0,0,0,,Хехехе ахаха
Dialogue: 0,1:44:57.87,1:44:58.70,Default,,0,0,0,,Хахаха
Dialogue: 0,1:45:01.21,1:45:02.75,Default,,0,0,0,,Барлық қыздар, өтінемін
Dialogue: 0,1:45:02.83,1:45:06.25,Default,,0,0,0,,Жартылай піскен тамақты жемейтін немесе тамақты өткізіп жіберетін жігітпен кездеспеңіз!
Dialogue: 0,1:45:06.34,1:45:08.59,Default,,0,0,0,,Барлық ұлдар міндетті түрде
Dialogue: 0,1:45:08.67,1:45:12.51,Default,,0,0,0,,Жұмыртқаларыңыздың дайындығына таңдай қақтыратын ересек адам болмаңыз!
Dialogue: 0,1:45:13.30,1:45:15.10,Default,,0,0,0,,Иә, кейінірек
Dialogue: 0,1:45:15.18,1:45:18.10,Default,,0,0,0,,Бүгін мен бәріңізге ауысатын студентті таныстырғым келеді.
Dialogue: 0,1:45:18.18,1:45:19.64,Default,,0,0,0,,Канаме-сан, қош келдіңіз.
Dialogue: 0,1:45:28.15,1:45:32.15,Default,,0,0,0,,Мм... Танысқаныма қуаныштымын, мен Мадока Канамамын.
Dialogue: 0,1:45:32.24,1:45:36.32,Default,,0,0,0,,Ана... А... Анамның шетелдегі іссапарында
Dialogue: 0,1:45:36.41,1:45:39.29,Default,,0,0,0,,Менің бүкіл отбасым Америкада үш жыл тұрды.
Dialogue: 0,1:45:39.87,1:45:42.91,Default,,0,0,0,,Өткен аптада мен Митакараға оралдым.
Dialogue: 0,1:45:43.00,1:45:46.54,Default,,0,0,0,,Бүгіннен бастап мен сіздермен осы мектепте жұмыс істеймін.
Dialogue: 0,1:45:46.63,1:45:50.30,Default,,0,0,0,,Сонымен... иә... рахмет!
Dialogue: 0,1:45:50.38,1:45:51.67,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:45:51.76,1:45:53.68,Default,,0,0,0,,Біраз уақыттан кейін алғаш рет жапон мектебінде
Dialogue: 0,1:45:53.76,1:45:56.05,Default,,0,0,0,,Шатастыруы мүмкін көптеген нәрселер болуы мүмкін.
Dialogue: 0,1:45:56.14,1:45:58.68,Default,,0,0,0,,Барлығың бір-біріңмен жақсы қарым-қатынаста болыңдар.
Dialogue: 0,1:46:01.52,1:46:04.85,Default,,0,0,0,,Эй, Канаме-сан, Америкада мектеп қалай болды?
Dialogue: 0,1:46:04.94,1:46:09.19,Default,,0,0,0,,Ағылшын тілінде еркін сөйлейсіз бе? Керемет! Мен қызғанамын~
Dialogue: 0,1:46:09.27,1:46:11.40,Default,,0,0,0,,Бұл кішкентай және сүйкімді, солай емес пе?
Dialogue: 0,1:46:11.49,1:46:12.57,Default,,0,0,0,,Бастауыш сынып оқушысына ұқсайды
Dialogue: 0,1:46:13.24,1:46:16.82,Default,,0,0,0,,Ахаха... Ал, ой, не айтайын...
Dialogue: 0,1:46:18.53,1:46:19.58,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,1:46:19.66,1:46:23.25,Default,,0,0,0,,Канаме-сан бірден тым көп сұрақ қойғаны үшін қиналады.
Dialogue: 0,1:46:23.75,1:46:25.29,Default,,0,0,0,,Мен аздап ұстануым керек.
Dialogue: 0,1:46:25.37,1:46:27.04,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,1:46:28.59,1:46:29.34,Default,,0,0,0,,Ах...
Dialogue: 0,1:46:29.42,1:46:31.25,Default,,0,0,0,,Мен Хомура Акемимін
Dialogue: 0,1:46:31.76,1:46:34.09,Default,,0,0,0,,Танысқаныма қуаныштымын, Мадока Канаме
Dialogue: 0,1:46:34.93,1:46:36.84,Default,,0,0,0,,Мен сені Мадока деп атасам бола ма?
Dialogue: 0,1:46:36.93,1:46:39.35,Default,,0,0,0,,Иә?Мм... иә
Dialogue: 0,1:46:39.43,1:46:42.72,Default,,0,0,0,,Мен саған бірден мектепті көрсетемін.
Dialogue: 0,1:46:42.81,1:46:43.93,Default,,0,0,0,,Маған еріңіз
Dialogue: 0,1:46:50.90,1:46:54.03,Default,,0,0,0,,Ах... Акеми...?
Dialogue: 0,1:46:54.11,1:46:55.53,Default,,0,0,0,,Хомура жақсы.
Dialogue: 0,1:46:55.61,1:46:56.24,Default,,0,0,0,,Ах
Dialogue: 0,1:46:58.91,1:47:01.03,Default,,0,0,0,,Хомура…чан?
Dialogue: 0,1:47:01.99,1:47:05.79,Default,,0,0,0,,Мм... сен неге...
Dialogue: 0,1:47:05.87,1:47:08.13,Default,,0,0,0,,Көп уақыттан кейін туған қалаңыз қалай?
Dialogue: 0,1:47:08.75,1:47:10.79,Default,,0,0,0,,Мм... иә
Dialogue: 0,1:47:10.88,1:47:13.17,Default,,0,0,0,,Қандай да бір сағыныш сезімін тудырады.
Dialogue: 0,1:47:13.26,1:47:16.22,Default,,0,0,0,,Бірақ бірдеңе басқаша сияқты.
Dialogue: 0,1:47:16.72,1:47:17.76,Default,,0,0,0,,Біртүрлі сезім
Dialogue: 0,1:47:18.59,1:47:21.26,Default,,0,0,0,,Таңқаларлық емес, 3 жыл болды.
Dialogue: 0,1:47:37.07,1:47:37.95,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:47:38.49,1:47:41.83,Default,,0,0,0,,Ештеңе өзгермеген сияқты.
Dialogue: 0,1:47:42.41,1:47:46.00,Default,,0,0,0,,Бір нәрсе болса, не өзгерді?
Dialogue: 0,1:47:46.50,1:47:47.87,Default,,0,0,0,,Мен сияқты...
Dialogue: 0,1:47:51.50,1:47:52.38,Default,,0,0,0,,Ах!
Dialogue: 0,1:47:55.71,1:47:58.26,Default,,0,0,0,,Маған иә
Dialogue: 0,1:47:58.34,1:48:00.34,Default,,0,0,0,,Басқа көзқарас...
Dialogue: 0,1:48:00.84,1:48:02.85,Default,,0,0,0,,Басқа рөл болған болуы керек. Ах!
Dialogue: 0,1:48:02.93,1:48:03.89,Default,,0,0,0,,Ха…
Dialogue: 0,1:48:03.97,1:48:05.10,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,1:48:06.22,1:48:07.31,Default,,0,0,0,,Неге...
Dialogue: 0,1:48:15.48,1:48:17.53,Default,,0,0,0,,Хо... Хомура-чан!
Dialogue: 0,1:48:17.61,1:48:19.49,Default,,0,0,0,,Эй, эй...
Dialogue: 0,1:48:19.57,1:48:22.62,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:48:23.20,1:48:24.28,Default,,0,0,0,,Жарайды
Dialogue: 0,1:48:24.78,1:48:28.37,Default,,0,0,0,,Сіз сөзсіз нағыз өзіңізсіз.
Dialogue: 0,1:48:29.29,1:48:29.83,Default,,0,0,0,,Иә?
Dialogue: 0,1:48:33.34,1:48:33.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:48:36.17,1:48:37.55,Default,,0,0,0,,Мадока Канаме
Dialogue: 0,1:48:37.63,1:48:40.59,Default,,0,0,0,,Бұл дүние қымбат деп ойлайсың ба?
Dialogue: 0,1:48:40.68,1:48:43.01,Default,,0,0,0,,Сіз тілектен гөрі тәртіпті бағалайсыз ба?
Dialogue: 0,1:48:43.09,1:48:43.97,Default,,0,0,0,,Иә?
Dialogue: 0,1:48:44.47,1:48:48.64,Default,,0,0,0,,Бұл... у...
Dialogue: 0,1:48:48.73,1:48:51.14,Default,,0,0,0,,I... I
Dialogue: 0,1:48:51.23,1:48:52.77,Default,,0,0,0,,Менің ойымша, бұл қымбат ...
Dialogue: 0,1:48:54.36,1:48:58.11,Default,,0,0,0,,Өйткені өзімшілдікпен тәртіп бұзу
Dialogue: 0,1:48:58.19,1:48:59.95,Default,,0,0,0,,Бұл жаман нәрсе емес пе?
Dialogue: 0,1:49:00.95,1:49:01.91,Default,,0,0,0,,Иә
Dialogue: 0,1:49:02.86,1:49:07.16,Default,,0,0,0,,Бір күні сен менің жауым боласың.
Dialogue: 0,1:49:07.24,1:49:07.87,Default,,0,0,0,,Иә?
Dialogue: 0,1:49:07.95,1:49:10.41,Default,,0,0,0,,Бірақ бұл маңызды емес.
Dialogue: 0,1:49:11.25,1:49:14.17,Default,,0,0,0,,Себебі мен сен бақытты болатын әлемді қалаймын.
Dialogue: 0,1:49:15.00,1:49:18.00,Default,,0,0,0,,Не? Хомура-чан?
Dialogue: 0,1:49:18.09,1:49:18.67,Default,,0,0,0,,Ум...
Dialogue: 0,1:49:21.30,1:49:24.18,Default,,0,0,0,,Сен маған жақсырақ көрінесің ғой.
Dialogue: 0,1:49:24.26,1:49:25.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:50:05.55,1:50:07.55,Default,,0,0,0,,♪～
Dialogue: 0,1:55:02.47,1:55:04.48,Default,,0,0,0,,～♪
Dialogue: 0,1:55:34.46,1:55:35.26,Default,,0,0,0,,(бұталардың дірілдеген дыбысы)
Dialogue: 0,1:55:35.34,1:55:35.88,Default,,0,0,0,,Ах!
Dialogue: 0,1:55:57.95,1:55:58.49,Default,,0,0,0,,Иә
Dialogue: 0,1:55:59.99,1:56:05.99,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory