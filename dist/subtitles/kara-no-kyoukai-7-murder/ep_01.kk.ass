Dialogue: 0,0:00:01.55,0:00:07.55,CNsub,NTP,0,0,0,,КамиГами
Dialogue: 0,1:59:53.05,1:59:58.15,CNsub,NTP,0,0,0,,＠/···
Dialogue: 0,1:50:30.73,1:50:38.83,EDJ,NTP,0000,0000,0000,,Мен сенің ән айтқаныңды қалаймын
Dialogue: 0,1:50:39.05,1:50:47.52,EDJ,NTP,0000,0000,0000,,Махаббаттың үнсіз сөздері
Dialogue: 0,1:50:48.12,1:50:55.39,EDJ,NTP,0000,0000,0000,,Кім жылап тұрды?
Dialogue: 0,1:50:55.95,1:51:04.43,EDJ,NTP,0000,0000,0000,,Бұл сенің кінәң емес
Dialogue: 0,1:51:05.08,1:51:20.50,EDJ,NTP,0000,0000,0000,,Түнде жоғалып кетті
Dialogue: 0,1:51:20.78,1:51:39.53,EDJ,NTP,0000,0000,0000,,Мен Аваюкимен қоштастым.
Dialogue: 0,1:51:52.60,1:52:02.64,EDJ,NTP,0000,0000,0000,,Мен оны қараңғылықтан естідім
Dialogue: 0,1:52:02.94,1:52:07.05,EDJ,NTP,0000,0000,0000,,Менің жүрегім соғады
Dialogue: 0,1:52:07.28,1:52:21.71,EDJ,NTP,0000,0000,0000,,Сіз маған ауырсынуды үйреттіңіз
Dialogue: 0,1:52:21.96,1:52:28.87,EDJ,NTP,0000,0000,0000,,Мына жараны сүй
Dialogue: 0,1:52:29.03,1:52:35.04,EDJ,NTP,0000,0000,0000,,Бір-біріне лезде тиетін саусақтар
Dialogue: 0,1:52:35.47,1:52:47.26,EDJ,NTP,0000,0000,0000,,Мені жіберме
Dialogue: 0,1:52:47.65,1:52:57.48,EDJ,NTP,0000,0000,0000,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,1:52:58.58,1:53:05.42,EDJ,NTP,0000,0000,0000,,Осындай жарық дүниеге
Dialogue: 0,1:53:05.98,1:53:12.93,EDJ,NTP,0000,0000,0000,,Сіз мені әкелдіңіз
Dialogue: 0,1:53:13.31,1:53:18.67,EDJ,NTP,0000,0000,0000,,Көзін қағып, көз ілмей тұр
Dialogue: 0,1:53:18.88,1:53:23.89,EDJ,NTP,0000,0000,0000,,Мен ештеңе көре алмаймын
Dialogue: 0,1:53:24.15,1:53:28.23,EDJ,NTP,0000,0000,0000,,Жарықта
Dialogue: 0,1:53:28.31,1:53:34.48,EDJ,NTP,0000,0000,0000,,Мені қатты ұстаңыз
Dialogue: 0,1:53:34.76,1:53:42.98,EDJ,NTP,0000,0000,0000,,Қатқан тынысты бөлісу
Dialogue: 0,1:53:43.05,1:53:50.02,EDJ,NTP,0000,0000,0000,,Сен және мен
Dialogue: 0,1:53:50.11,1:53:56.94,EDJ,NTP,0000,0000,0000,,Қалған қар ериді
Dialogue: 0,1:53:55.72,1:53:57.22,EDJ,NTP,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,1:53:57.43,1:54:04.26,EDJ,NTP,0000,0000,0000,,арманшыл
Dialogue: 0,1:54:04.77,1:54:10.45,EDJ,NTP,0000,0000,0000,,Күндерде
Dialogue: 0,1:54:10.93,1:54:18.63,EDJ,NTP,0000,0000,0000,,Сіз күліп тұрсыз
Dialogue: 0,1:54:15.27,1:54:20.78,EDJ,NTP,0000,0000,0000,,Бұл жеткілікті
Dialogue: 0,1:54:19.03,1:54:32.13,EDJ,NTP,0000,0000,0000,,Мен сенің жаныңда болғандықтан
Dialogue: 0,1:54:30.22,1:54:32.97,EDJ,NTP,0000,0000,0000,,Енді жалғыз емес
Dialogue: 0,1:54:33.15,1:54:37.60,EDJ,NTP,0000,0000,0000,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,1:54:37.75,1:54:39.52,EDJ,NTP,0000,0000,0000,,Бірге жүріңіз
Dialogue: 0,1:54:39.67,1:54:48.72,EDJ,NTP,0000,0000,0000,,Махороба
Dialogue: 0,1:55:02.10,1:55:19.07,EDJ,NTP,0000,0000,0000,,Мен сенің ән айтқаныңды қалаймын
Dialogue: 0,1:55:19.14,1:55:27.47,EDJ,NTP,0000,0000,0000,,Сіздің шахтаңыз
Dialogue: 0,1:55:27.58,1:55:35.52,EDJ,NTP,0000,0000,0000,,түнгі таң
Dialogue: 0,1:55:35.91,1:55:43.77,EDJ,NTP,0000,0000,0000,,...
Dialogue: 0,1:55:44.20,1:56:02.70,EDJ,NTP,0000,0000,0000,,Аспанды шолу
Dialogue: 0,1:50:30.73,1:50:38.83,EDC,NTP,0000,0000,0000,,Ойды жырлау
Dialogue: 0,1:50:39.05,1:50:47.52,EDC,NTP,0000,0000,0000,,...
Dialogue: 0,1:50:48.12,1:50:55.39,EDC,NTP,0000,0000,0000,,Гасо-рюу Көз жасы
Dialogue: 0,1:50:55.95,1:51:04.43,EDC,NTP,0000,0000,0000,,Бұл сенің кінәң емес.
Dialogue: 0,1:51:05.08,1:51:20.50,EDC,NTP,0000,0000,0000,,Сондықтан мен түн ортасындамын
Dialogue: 0,1:51:20.78,1:51:39.53,EDC,NTP,0000,0000,0000,,Аваюкидің өлімі туралы есеп
Dialogue: 0,1:51:52.60,1:52:02.64,EDC,NTP,0000,0000,0000,,Қараңғыда
Dialogue: 0,1:52:02.94,1:52:07.05,EDC,NTP,0000,0000,0000,,Жүрекке жетудің толғанысы
Dialogue: 0,1:52:07.28,1:52:21.71,EDC,NTP,0000,0000,0000,,Шіркеудің соңы азапты болды.
Dialogue: 0,1:52:21.96,1:52:28.87,EDC,NTP,0000,0000,0000,,Төменгі тыртық
Dialogue: 0,1:52:29.03,1:52:35.04,EDC,NTP,0000,0000,0000,,Бос жерге тиетін саусақ ұштары
Dialogue: 0,1:52:35.47,1:52:47.26,EDC,NTP,0000,0000,0000,,Кездесусіз бөлу
Dialogue: 0,1:52:47.65,1:52:57.48,EDC,NTP,0000,0000,0000,,Тікелей мәңгілікке
Dialogue: 0,1:52:58.58,1:53:05.42,EDC,NTP,0000,0000,0000,,Сен маған келдің
Dialogue: 0,1:53:05.98,1:53:12.93,EDC,NTP,0000,0000,0000,,Осы жарық дүниедегідей
Dialogue: 0,1:53:13.31,1:53:18.67,EDC,NTP,0000,0000,0000,,Керемет көздер
Dialogue: 0,1:53:18.88,1:53:23.89,EDC,NTP,0000,0000,0000,,...
Dialogue: 0,1:53:24.15,1:53:28.23,EDC,NTP,0000,0000,0000,,Жарық қай жерде жарқырайды?
Dialogue: 0,1:53:28.31,1:53:34.48,EDC,NTP,0000,0000,0000,,ену
Dialogue: 0,1:53:34.76,1:53:42.98,EDC,NTP,0000,0000,0000,,Осы суық тыныс алуды сезіну
Dialogue: 0,1:53:43.05,1:53:50.02,EDC,NTP,0000,0000,0000,,Сен және мен
Dialogue: 0,1:53:50.11,1:53:56.94,EDC,NTP,0000,0000,0000,,Қалған қардың еруі
Dialogue: 0,1:53:55.72,1:53:57.22,EDC,NTP,0000,0000,0000,,...
Dialogue: 0,1:53:57.43,1:54:04.26,EDC,NTP,0000,0000,0000,,Армандай
Dialogue: 0,1:54:04.77,1:54:10.45,EDC,NTP,0000,0000,0000,,Күндізгі уақытта
Dialogue: 0,1:54:10.93,1:54:18.63,EDC,NTP,0000,0000,0000,,Сіз күлесіз
Dialogue: 0,1:54:15.27,1:54:20.78,EDC,NTP,0000,0000,0000,,Және ол бірте-бірте сынып, бөлшектерге айналып барады
Dialogue: 0,1:54:19.03,1:54:32.13,EDC,NTP,0000,0000,0000,,Сіз сонда болғандықтан
Dialogue: 0,1:54:30.22,1:54:32.97,EDC,NTP,0000,0000,0000,,Қайтадан немесе жалғыз адам емес
Dialogue: 0,1:54:33.15,1:54:37.60,EDC,NTP,0000,0000,0000,,Мәңгілік
Dialogue: 0,1:54:37.75,1:54:39.52,EDC,NTP,0000,0000,0000,,Екі адам бірге
Dialogue: 0,1:54:39.67,1:54:48.72,EDC,NTP,0000,0000,0000,,Өткен бақ
Dialogue: 0,1:55:02.10,1:55:19.07,EDC,NTP,0000,0000,0000,,Ойды жырлау
Dialogue: 0,1:55:19.14,1:55:27.47,EDC,NTP,0000,0000,0000,,Сен менікісің
Dialogue: 0,1:55:27.58,1:55:35.52,EDC,NTP,0000,0000,0000,,Түн мен күндізгі жарық
Dialogue: 0,1:55:35.91,1:55:43.77,EDC,NTP,0000,0000,0000,,Мұхиттық
Dialogue: 0,1:55:44.20,1:56:02.70,EDC,NTP,0000,0000,0000,,Аспан әуені
Dialogue: 0,0:00:43.14,0:00:45.48,JPsub,NTP,0000,0000,0000,,Онда не бар?
Dialogue: 0,0:00:48.63,0:00:49.38,JPsub,NTP,0000,0000,0000,,Уау, суық, суық
Dialogue: 0,0:00:50.21,0:00:52.60,JPsub,NTP,0000,0000,0000,,Мен кілтті тез қолдансам ғой.
Dialogue: 0,0:01:04.82,0:01:05.94,JPsub,NTP,0000,0000,0000,,Бұған не болды?
Dialogue: 0,0:01:07.32,0:01:08.49,JPsub,NTP,0000,0000,0000,,Тоуконың жеке көрмесі
Dialogue: 0,0:01:09.05,0:01:11.80,JPsub,NTP,0000,0000,0000,,Бүгінгі күнге дейін болды, сондықтан мен көрмеге қойылғанын алдым.
Dialogue: 0,0:01:22.01,0:01:23.58,JPsub,NTP,0000,0000,0000,,Тұтынушы кірді ме?
Dialogue: 0,0:01:24.02,0:01:27.77,JPsub,NTP,0000,0000,0000,,Иә, мен сатуға қойған қуыршақтардың барлығында сатып алушы болды.
Dialogue: 0,0:01:28.62,0:01:31.65,JPsub,NTP,0000,0000,0000,,Әйтеуір, осы айдың айлығын аламын деп ойлаймын.
Dialogue: 0,0:01:32.30,0:01:33.00,JPsub,NTP,0000,0000,0000,,Хун
Dialogue: 0,0:01:33.90,0:01:35.13,JPsub,NTP,0000,0000,0000,,Күніңіз қалай өтті?
Dialogue: 0,0:01:36.06,0:01:38.38,JPsub,NTP,0000,0000,0000,,Мен таңертең мектепке бардым.
Dialogue: 0,0:01:39.01,0:01:39.76,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:01:43.42,0:01:45.65,JPsub,NTP,0000,0000,0000,,Мен оны сол жердегі автоматтан сатып алғанымды ұмытып кетіппін.
Dialogue: 0,0:01:46.31,0:01:47.68,JPsub,NTP,0000,0000,0000,,Сусын? Ол сізді жылытады
Dialogue: 0,0:01:49.17,0:01:51.56,JPsub,NTP,0000,0000,0000,,Тәтті жақсы
Dialogue: 0,0:01:52.48,0:01:54.84,JPsub,NTP,0000,0000,0000,,Иә, бұл жақсы.
Dialogue: 0,0:02:04.28,0:02:05.67,JPsub,NTP,0000,0000,0000,,Бұл — әуе кемелерін қорғап қалудың жалғыз жолы.
Dialogue: 0,0:02:05.95,0:02:06.91,JPsub,NTP,0000,0000,0000,,Аздап ішіңіз
Dialogue: 0,0:02:19.99,0:02:21.08,JPsub,NTP,0000,0000,0000,,Жылы
Dialogue: 0,0:02:45.39,0:02:47.21,JPsub,NTP,0000,0000,0000,,Мысалы, қар
Dialogue: 0,0:02:48.51,0:02:52.26,JPsub,NTP,0000,0000,0000,,Біз алғаш кездестірген ақ түн мен қара қолшатыр
Dialogue: 0,0:00:00.00,0:00:00.00,JPsub,NTP,0000,0000,0000,,//ОП
Dialogue: 0,0:04:53.59,0:04:55.58,JPsub,NTP,0000,0000,0000,,Үйге қайтайық, Микия.
Dialogue: 0,0:04:56.40,0:04:58.90,JPsub,NTP,0000,0000,0000,,Менің ойымша, бәрібір артық жұмыс ақысы жоқ.
Dialogue: 0,0:05:00.22,0:05:03.69,JPsub,NTP,0000,0000,0000,,Иә, егер мен мұны жай ғана түсіндірсем.
Dialogue: 0,0:05:11.05,0:05:12.03,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:05:21.93,0:05:25.36,JPsub,NTP,0000,0000,0000,,А, сіз тағы да осындай нәрсені сатып алдыңыз ба?
Dialogue: 0,0:05:25.71,0:05:29.56,JPsub,NTP,0000,0000,0000,,Мен оны сатып алған жоқпын, мен оны кездестірдім.
Dialogue: 0,0:05:29.73,0:05:31.92,JPsub,NTP,0000,0000,0000,,Романтик болудың пайдасы жоқ.
Dialogue: 0,0:05:32.50,0:05:34.10,JPsub,NTP,0000,0000,0000,,Ах, қарным ашты.
Dialogue: 0,0:05:43.00,0:05:43.79,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:05:44.86,0:05:46.05,JPsub,NTP,0000,0000,0000,,Жарайды, жүр.
Dialogue: 0,0:05:46.45,0:05:49.95,JPsub,NTP,0000,0000,0000,,Оны орап алсаңыз, ол затты адамдар да жей алмайды.
Dialogue: 0,0:05:52.44,0:05:53.35,JPsub,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:05:58.60,0:05:59.72,JPsub,NTP,0000,0000,0000,,(Виолет) Енді біз майордан бұйрық алмаймыз ба?
Dialogue: 0,0:06:20.19,0:06:23.01,JPsub,NTP,0000,0000,0000,,Бұл қылмысты көшедегі сериялық қылмыс оқиғасы сияқты бір орындаушы жасаған деген қорытындыға келеді.
Dialogue: 0,0:06:23.14,0:06:24.41,JPsub,NTP,0000,0000,0000,,Біз тергеу жүргізіп жатырмыз.
Dialogue: 0,0:06:25.48,0:06:28.66,JPsub,NTP,0000,0000,0000,,Канбуко қаласындағы үздіксіз тонау оқиғаларынан зардап шеккендердің саны - 7.
Dialogue: 0,0:06:28.99,0:06:31.71,JPsub,NTP,0000,0000,0000,,Төрт жыл бұрынғы оқиғаны қосқанда қазір 13 адам.
Dialogue: 0,0:06:32.86,0:06:35.77,JPsub,NTP,0000,0000,0000,,Азаматтар бірнеше кісі өлтірушілер тудырған дүрбелеңді тоқтата алмайтын полицияға тап болады
Dialogue: 0,0:06:36.16,0:06:37.77,JPsub,NTP,0000,0000,0000,,Қанағаттанбаған дауыстар шықты
Dialogue: 0,0:06:42.41,0:06:44.28,JPsub,NTP,0000,0000,0000,,Ол кісі өлтіруші, Микия.
Dialogue: 0,0:06:44.63,0:06:47.10,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл 10-нан астам құрбан болғандықтан.
Dialogue: 0,0:06:47.93,0:06:50.96,JPsub,NTP,0000,0000,0000,,Бірақ оны өлтіруші деп айту тым шектен шығады деп ойлаймын.
Dialogue: 0,0:06:51.17,0:06:54.19,JPsub,NTP,0000,0000,0000,,Жоқ, сіз мұны дұрыс пайдаланасыз.
Dialogue: 0,0:06:55.27,0:06:57.50,JPsub,NTP,0000,0000,0000,,Бұл жағдайда кінәлі бар болса
Dialogue: 0,0:06:57.95,0:07:00.77,JPsub,NTP,0000,0000,0000,,Ол кісі өлтірушіден басқа ештеңе емес.
Dialogue: 0,0:07:01.61,0:07:04.77,JPsub,NTP,0000,0000,0000,,Кінәлі бұлай аталса қуанатынына сенімдімін.
Dialogue: 0,0:07:05.40,0:07:07.63,JPsub,NTP,0000,0000,0000,,Кісі өлтірушіге себеп керек емес.
Dialogue: 0,0:07:08.06,0:07:12.49,JPsub,NTP,0000,0000,0000,,Жәбірленушіге тек солға немесе оңға бұрылғаны үшін шабуыл жасалды.
Dialogue: 0,0:07:13.07,0:07:15.74,JPsub,NTP,0000,0000,0000,,Демек, бұл жігіт ешкімді өлтірген жоқ.
Dialogue: 0,0:07:16.25,0:07:19.68,JPsub,NTP,0000,0000,0000,,Кісі өлтіруші ешкімді өлтірмегенін айтады.
Dialogue: 0,0:07:20.40,0:07:23.01,JPsub,NTP,0000,0000,0000,,Кісі өлтіру мен өлтірудің айырмашылығы бар.
Dialogue: 0,0:07:24.35,0:07:25.98,JPsub,NTP,0000,0000,0000,,Қара пауловния есімде
Dialogue: 0,0:07:27.18,0:07:30.72,JPsub,NTP,0000,0000,0000,,Сіз басқа адамды өміріңізде бір рет қана өлтіре аласыз.
Dialogue: 0,0:07:31.99,0:07:33.73,JPsub,NTP,0000,0000,0000,,Тек бір адамды өлтіре алады
Dialogue: 0,0:07:37.55,0:07:40.41,JPsub,NTP,0000,0000,0000,,Жақсы, себебі бұл қызықсыз.
Dialogue: 0,0:07:41.26,0:07:42.45,JPsub,NTP,0000,0000,0000,,Одан жақсырақ
Dialogue: 0,0:07:42.78,0:07:43.46,JPsub,NTP,0000,0000,0000,,Мен оны естідім.
Dialogue: 0,0:07:43.76,0:07:47.87,JPsub,NTP,0000,0000,0000,,Рейен оқиғасынан кейін Сеньканы мейрамханаға апарғаныңды естідім, солай ма?
Dialogue: 0,0:07:48.02,0:07:49.08,JPsub,NTP,0000,0000,0000,,Жаңа гүлдер
Dialogue: 0,0:07:49.52,0:07:54.59,JPsub,NTP,0000,0000,0000,,Бір қызығы, бұл мейрамхана мен әрқашан барғым келетін жер.
Dialogue: 0,0:07:54.96,0:07:57.58,JPsub,NTP,0000,0000,0000,,Бастапқыда мен Сенькаға кісі өлтіру ниеті болдым.
Dialogue: 0,0:07:57.93,0:08:00.06,JPsub,NTP,0000,0000,0000,,Оған көмектесу мүмкін емес, мен шешім қабылдадым.
Dialogue: 0,0:08:00.29,0:08:02.77,JPsub,NTP,0000,0000,0000,,Енді мені өзіңізге ұнайтын кез келген дүкенге апарыңыз.
Dialogue: 0,0:08:02.93,0:08:04.26,JPsub,NTP,0000,0000,0000,,Мен мұны істеуім керек.
Dialogue: 0,0:08:19.62,0:08:22.41,JPsub,NTP,0000,0000,0000,,Өлгеннен кейін екі-үш күннен кейін.
Dialogue: 0,0:08:24.04,0:08:29.90,JPsub,NTP,0000,0000,0000,,Жыртылған қимаға қарағанда, бұл жолы да «артық тамақтың» жұмысы сияқты.
Dialogue: 0,0:08:31.27,0:08:32.93,JPsub,NTP,0000,0000,0000,,Хидена
Dialogue: 0,0:08:33.74,0:08:35.36,JPsub,NTP,0000,0000,0000,,Мен бұрын айтқанымдай
Dialogue: 0,0:08:35.65,0:08:39.62,JPsub,NTP,0000,0000,0000,,Мәйіттің жағдайын ескерсек, бұл адамның қолынан шыққан дегенге сену қиын.
Dialogue: 0,0:08:40.19,0:08:42.19,JPsub,NTP,0000,0000,0000,,Менің көретінім - қолтырауын немесе басқасы
Dialogue: 0,0:08:42.65,0:08:43.78,JPsub,NTP,0000,0000,0000,,Табылды
Dialogue: 0,0:09:38.27,0:09:40.19,JPsub,NTP,0000,0000,0000,,Бүгін осында ұйықта.
Dialogue: 0,0:09:42.64,0:09:43.36,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:10:38.34,0:10:40.08,JPsub,NTP,0000,0000,0000,,Олай болса, мен бірінші барамын.
Dialogue: 0,0:10:42.86,0:10:43.48,JPsub,NTP,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:11:23.60,0:11:24.30,JPsub,NTP,0000,0000,0000,,Тооко-сан
Dialogue: 0,0:11:24.96,0:11:25.68,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:26.58,0:11:28.40,JPsub,NTP,0000,0000,0000,,Алдымен кешірім сұрай аламын ба?
Dialogue: 0,0:11:36.86,0:11:39.50,JPsub,NTP,0000,0000,0000,,Бүгін тағы да салтанатты жиынға барасыз ба?
Dialogue: 0,0:11:46.23,0:11:49.25,JPsub,NTP,0000,0000,0000,,Төрт жыл бұрынғы оқиға және бұл жолы кісі өлтіруші
Dialogue: 0,0:11:54.19,0:11:57.40,JPsub,NTP,0000,0000,0000,,Курогири Шикидің шығармасы деп ойлайсың ба?
Dialogue: 0,0:11:57.92,0:12:00.36,JPsub,NTP,0000,0000,0000,,Мәйітті табу кешіктірілген кеше түнгі оқиға
Dialogue: 0,0:12:00.68,0:12:01.59,JPsub,NTP,0000,0000,0000,,Өткен оқиғалар да
Dialogue: 0,0:12:02.33,0:12:07.29,JPsub,NTP,0000,0000,0000,,Дененің жағдайына қарап қылмыстың нақты уақытын анықтау қиынға соғатын сияқты.
Dialogue: 0,0:12:08.46,0:12:11.16,JPsub,NTP,0000,0000,0000,,Тек шамамен күн мен уақыт белгілі
Dialogue: 0,0:12:14.37,0:12:16.67,JPsub,NTP,0000,0000,0000,,Және уақыт кезеңі
Dialogue: 0,0:12:16.83,0:12:18.46,JPsub,NTP,0000,0000,0000,,Формула алиби жоқ
Dialogue: 0,0:12:21.06,0:12:22.71,JPsub,NTP,0000,0000,0000,,Тек фактілерді келтірсеңіз
Dialogue: 0,0:12:23.40,0:12:25.35,JPsub,NTP,0000,0000,0000,,Теріске дәлелдер жеткіліксіз.
Dialogue: 0,0:12:26.95,0:12:28.36,JPsub,NTP,0000,0000,0000,,Мен оны қарап шықтым.
Dialogue: 0,0:12:29.69,0:12:31.85,JPsub,NTP,0000,0000,0000,,Осыны ескерсек, бұл біртүрлі бет.
Dialogue: 0,0:12:33.32,0:12:35.85,JPsub,NTP,0000,0000,0000,,Жалпы кінәсіздікті дәлелдеуден гөрі
Dialogue: 0,0:12:36.64,0:12:40.19,JPsub,NTP,0000,0000,0000,,Күрогири, бұдан да маңызды сұрақ болуы керек.
Dialogue: 0,0:12:41.88,0:12:42.81,JPsub,NTP,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:12:43.52,0:12:48.44,JPsub,NTP,0000,0000,0000,,Рәсімде Ори-күн деген еркек кейіпкер жоқ.
Dialogue: 0,0:12:50.89,0:12:55.39,JPsub,NTP,0000,0000,0000,,Комадан оянғаннан кейін ол жалғыз қалды.
Dialogue: 0,0:12:56.09,0:13:01.94,JPsub,NTP,0000,0000,0000,,Бұл екі рәсімде де болған кісі өлтіру тұлғасының жойылуын білдіреді.
Dialogue: 0,0:13:02.80,0:13:07.16,JPsub,NTP,0000,0000,0000,,Сіздің нақты сұрағыңыз мынау.
Егер
Dialogue: 0,0:13:08.07,0:13:12.83,JPsub,NTP,0000,0000,0000,,болса, онда Шикидің енді кісі өлтіру дәмі болмауы керек емес пе?
Dialogue: 0,0:13:14.36,0:13:15.46,JPsub,NTP,0000,0000,0000,,Б-барлаушы? Не туралы айтып тұрсыздар?
Dialogue: 0,0:13:17.37,0:13:19.86,JPsub,NTP,0000,0000,0000,,Бірақ онда қазіргі формула неге
Dialogue: 0,0:13:20.85,0:13:22.92,JPsub,NTP,0000,0000,0000,,Бұл өтемақылық акт, солай емес пе?
Dialogue: 0,0:13:23.75,0:13:26.00,JPsub,NTP,0000,0000,0000,,Фуджино Асагамимен бірдей жағдай.
Dialogue: 0,0:13:26.94,0:13:31.04,JPsub,NTP,0000,0000,0000,,Өмірге қол тигізбесең, өз өміріңді сезіне алмайсың.
Dialogue: 0,0:13:31.84,0:13:35.26,JPsub,NTP,0000,0000,0000,,Бұл біршама алаңдататын әдіс емес пе?
Dialogue: 0,0:13:36.10,0:13:38.47,JPsub,NTP,0000,0000,0000,,Егер сіз шынымен алаңдасаңыз
Dialogue: 0,0:13:38.92,0:13:41.18,JPsub,NTP,0000,0000,0000,,Салтанатта күні бойы қалсаңыз жақсы болар еді.
Dialogue: 0,0:13:41.71,0:13:42.55,JPsub,NTP,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,0:13:50.10,0:13:51.58,JPsub,NTP,0000,0000,0000,,Мен жаңа ғана алған ақпарат бойынша,
Dialogue: 0,0:13:51.96,0:13:53.79,JPsub,NTP,0000,0000,0000,,Канбуко қаласындағы Футакакита-чодағы аллеяда
Dialogue: 0,0:13:54.15,0:13:56.97,JPsub,NTP,0000,0000,0000,,Сериялық өлтірушінің жаңа құрбаны табылды
Dialogue: 0,0:13:57.96,0:14:01.24,JPsub,NTP,0000,0000,0000,,Сериялық өлтірушінің жаңа құрбаны табылды
Dialogue: 0,0:14:02.22,0:14:03.61,JPsub,NTP,0000,0000,0000,,Куәгерлердің мәліметі бойынша
Dialogue: 0,0:14:04.03,0:14:05.41,JPsub,NTP,0000,0000,0000,,Бұрынғы қылмыстар сияқты
Dialogue: 0,0:14:05.81,0:14:07.92,JPsub,NTP,0000,0000,0000,,Оқиға орнынан көп мөлшерде қан табылды.
Dialogue: 0,0:14:08.31,0:14:11.13,JPsub,NTP,0000,0000,0000,,Адамдардың білек-бұтағы мен тобығы жан-жаққа шашылып жатты.
Dialogue: 0,0:14:12.43,0:14:14.54,JPsub,NTP,0000,0000,0000,,Жәбірленушінің жеке басы әлі белгісіз
Dialogue: 0,0:14:15.73,0:14:18.81,JPsub,NTP,0000,0000,0000,,Мәйіт көп уақыт бұрын өлтірілген жоқ.
Dialogue: 0,0:14:19.10,0:14:22.45,JPsub,NTP,0000,0000,0000,,Кінәлі әлі де жақын жерде жасырынып жүрген болуы мүмкін.
Dialogue: 0,0:14:22.77,0:14:26.05,JPsub,NTP,0000,0000,0000,,Полиция жедел әрекет етуде
Dialogue: 0,0:14:26.91,0:14:28.01,JPsub,NTP,0000,0000,0000,,Қайталаңыз
Dialogue: 0,0:14:28.84,0:14:30.43,JPsub,NTP,0000,0000,0000,,Мен жаңа ғана алған ақпарат бойынша,
Dialogue: 0,0:14:30.78,0:14:32.50,JPsub,NTP,0000,0000,0000,,Канбуко қаласындағы Футокита-чо көшесінде
Dialogue: 0,0:14:17.90,0:14:19.07,JPsub,NTP,0000,0000,0000,,Моши Моши Моши
Dialogue: 0,0:14:19.18,0:14:21.27,JPsub,NTP,0000,0000,0000,,Мен қазір жоқпын.
Dialogue: 0,0:14:21.94,0:14:28.80,JPsub,NTP,0000,0000,0000,,Қандай да бір сұрақтарыңыз болса, дыбыстық сигналдан кейін хабарлама жазыңыз.
Dialogue: 0,0:14:40.95,0:14:41.57,JPsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,0:14:57.05,0:14:58.02,JPsub,NTP,0000,0000,0000,,Төрт жыл бұрын
Dialogue: 0,0:14:58.84,0:15:02.27,JPsub,NTP,0000,0000,0000,,Шики менің өлтіруші екенімді айтты
Dialogue: 0,0:15:03.60,0:15:04.82,JPsub,NTP,0000,0000,0000,,Бірақ бұл өтірік
Dialogue: 0,0:15:06.05,0:15:07.88,JPsub,NTP,0000,0000,0000,,Ол ешқашан ешкімді өлтіре алмайды
Dialogue: 0,0:15:08.89,0:15:10.40,JPsub,NTP,0000,0000,0000,,Мен сені қаласам да өлтіре алмаймын
Dialogue: 0,0:15:11.49,0:15:14.41,JPsub,NTP,0000,0000,0000,,Мен бұған әрқашан сенетінмін, солай емес пе?
Dialogue: 0,0:15:15.56,0:15:16.39,JPsub,NTP,0000,0000,0000,,Ол тез.
Dialogue: 0,0:16:07.09,0:16:08.93,JPsub,NTP,0000,0000,0000,,Курогири, бірдеңе айт.
Dialogue: 0,0:16:09.45,0:16:10.32,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:16:11.64,0:16:16.96,JPsub,NTP,0000,0000,0000,,Менің өлгім келмейді
Dialogue: 0,0:16:23.01,0:16:25.76,JPsub,NTP,0000,0000,0000,,Мен сені өлтіргім келеді
Dialogue: 0,0:16:34.61,0:16:35.94,JPsub,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:17:04.93,0:17:05.97,JPsub,NTP,0000,0000,0000,,Ойын жарақаты
Dialogue: 0,0:17:08.39,0:17:11.65,JPsub,NTP,0000,0000,0000,,Мен мұндай күйреуді қаламадым.
Dialogue: 0,0:17:31.67,0:17:34.24,JPsub,NTP,0000,0000,0000,,Қарсыласымды өлтіре аламын ба?
Dialogue: 0,0:17:35.29,0:17:37.66,JPsub,NTP,0000,0000,0000,,Егер бұл өмір сүру үшін өлтіру болса
Dialogue: 0,0:17:37.80,0:17:38.98,JPsub,NTP,0000,0000,0000,,Миссияны соншалықты тез аяқтағаның үшін абыройлысың
Dialogue: 0,0:17:39.33,0:17:43.01,JPsub,NTP,0000,0000,0000,,Бірақ бұл қашу үшін өлтіру.
Dialogue: 0,0:17:43.86,0:17:46.40,JPsub,NTP,0000,0000,0000,,Өз құндылығыңызды төмендетпеңіз
Dialogue: 0,0:17:47.16,0:17:50.20,JPsub,NTP,0000,0000,0000,,Сіз тек біреуге тиесілісіз
Dialogue: 0,0:17:51.19,0:17:53.06,JPsub,NTP,0000,0000,0000,,Бір адамдай өмір сүру
Dialogue: 0,0:17:53.57,0:17:55.98,JPsub,NTP,0000,0000,0000,,Бір кісідей аяқтаймыз
Dialogue: 0,0:17:56.59,0:18:02.24,JPsub,NTP,0000,0000,0000,,Дау-дамай спиралы - бұл сізге лайықты аяқталу.
Dialogue: 0,0:18:08.97,0:18:10.27,JPsub,NTP,0000,0000,0000,,Кенже
Dialogue: 0,0:18:12.03,0:18:12.82,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:18:17.25,0:18:17.95,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:18:22.45,0:18:26.55,JPsub,NTP,0000,0000,0000,,Бұл затты жоюға әлі ерте.
Dialogue: 0,0:18:35.36,0:18:38.93,JPsub,NTP,0000,0000,0000,,Ол кезде мен үйге жалғыз келе жатқан едім.
Dialogue: 0,0:18:39.55,0:18:41.09,JPsub,NTP,0000,0000,0000,,Мен онымен болуды таңдадым.
Dialogue: 0,0:18:42.56,0:18:44.14,JPsub,NTP,0000,0000,0000,,Бұл дұрыс болды ма?
Dialogue: 0,0:18:44.74,0:18:46.40,JPsub,NTP,0000,0000,0000,,Шынымды айтсам, мен әлі білмеймін.
Dialogue: 0,0:19:31.29,0:19:32.24,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:21:49.99,0:21:51.81,JPsub,NTP,0000,0000,0000,,Мен бұл елге келдім
Dialogue: 0,0:21:52.06,0:21:54.40,JPsub,NTP,0000,0000,0000,,Себебі Арая Сорен мені сұрады.
Dialogue: 0,0:21:54.92,0:21:59.04,JPsub,NTP,0000,0000,0000,,Маған екі жыл бұрынғы ұмытып кеткен естеліктеріңізді қайтаруыңызды қалаймын.
Dialogue: 0,0:22:00.45,0:22:02.55,JPsub,NTP,0000,0000,0000,,Жоқтауды ойнау
Dialogue: 0,0:22:03.03,0:22:04.69,JPsub,NTP,0000,0000,0000,,Ұмытып кетсем де
Dialogue: 0,0:22:05.10,0:22:08.63,JPsub,NTP,0000,0000,0000,,Сіздің жадыңыз міндетті түрде сізге жазылған.
Dialogue: 0,0:22:15.44,0:22:17.88,JPsub,NTP,0000,0000,0000,,Мен қазір жоқпын.
Dialogue: 0,0:22:18.57,0:22:25.77,JPsub,NTP,0000,0000,0000,,Сұрақтарыңыз болса, дыбыстық сигналдан кейін хабарламаңызды жазып алыңыз.
Dialogue: 0,0:22:29.39,0:22:30.29,JPsub,NTP,0000,0000,0000,,Бұл Куротоири.
Dialogue: 0,0:22:30.81,0:22:32.43,JPsub,NTP,0000,0000,0000,,Сіз әлі оралмаған сияқтысыз.
Dialogue: 0,0:22:33.07,0:22:34.77,JPsub,NTP,0000,0000,0000,,Бұны естісеңіз, маған хабарласыңыз.
Dialogue: 0,0:22:35.37,0:22:36.41,JPsub,NTP,0000,0000,0000,,Мен сізге қайта қоңырау шаламын
Dialogue: 0,0:22:37.57,0:22:42.93,JPsub,NTP,0000,0000,0000,,8 ақпан, 16:33.
Dialogue: 0,0:22:43.46,0:22:46.42,JPsub,NTP,0000,0000,0000,,Он жеті хабар
Dialogue: 0,0:23:17.65,0:23:18.47,JPsub,NTP,0000,0000,0000,,Ақша, мәртебе және әдемі әйел.
Dialogue: 0,0:23:20.29,0:23:22.64,JPsub,NTP,0000,0000,0000,,Күнде түнде қайда қыдырдың?
Dialogue: 0,0:23:23.98,0:23:26.16,JPsub,NTP,0000,0000,0000,,Сіз бұл сағатта не істеп жатырсыз?
Dialogue: 0,0:23:26.70,0:23:29.22,JPsub,NTP,0000,0000,0000,,Жоқ, сен мұнда тергеуге келдің.
Dialogue: 0,0:23:29.73,0:23:30.80,JPsub,NTP,0000,0000,0000,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:23:38.66,0:23:42.94,JPsub,NTP,0000,0000,0000,,Сіз үш жыл бұрын Рёгидің үйінің алдынан өлі денені таптыңыз.
Dialogue: 0,0:23:44.60,0:23:47.35,JPsub,NTP,0000,0000,0000,,Қылмыскер қайтадан әрекет ете бастағанын білесіз.
Dialogue: 0,0:23:53.72,0:23:54.75,JPsub,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:23:56.03,0:23:58.35,JPsub,NTP,0000,0000,0000,,Қылмыскердің ізі табылды.
Dialogue: 0,0:23:59.71,0:24:04.12,JPsub,NTP,0000,0000,0000,,Осы жылдың басынан бері қылмыстар қала орталығындағы аудандардың артқы аллеяларында орын алған.
Dialogue: 0,0:24:05.10,0:24:08.21,JPsub,NTP,0000,0000,0000,,Кісі өлтіру болған жердің айналасында үлкен көше болды.
Dialogue: 0,0:24:08.62,0:24:10.78,JPsub,NTP,0000,0000,0000,,Әрине, қарап отырғандар аз емес.
Dialogue: 0,0:24:11.88,0:24:16.09,JPsub,NTP,0000,0000,0000,,Онда үнемі кимоно киген адам көрінеді.
Dialogue: 0,0:24:17.72,0:24:19.51,JPsub,NTP,0000,0000,0000,,Сәлем Микия
Dialogue: 0,0:24:20.93,0:24:24.07,JPsub,NTP,0000,0000,0000,,Саған не болды?
Dialogue: 0,0:24:26.28,0:24:28.53,JPsub,NTP,0000,0000,0000,,Жарайды, кем дегенде сенде жаулық ниет жоқ екеніне көз жеткіздім.
Dialogue: 0,0:24:35.04,0:24:35.81,JPsub,NTP,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:24:38.62,0:24:39.85,JPsub,NTP,0000,0000,0000,,Оның не екенін білесің бе?
Dialogue: 0,0:24:41.40,0:24:45.19,JPsub,NTP,0000,0000,0000,,Маркалар LSD, ал жапырақтары каннабис.
Dialogue: 0,0:24:46.06,0:24:48.05,JPsub,NTP,0000,0000,0000,,Өткен аптада өлтірілген құрбандар
Dialogue: 0,0:24:48.11,0:24:51.21,JPsub,NTP,0000,0000,0000,,Бұл менің алғанымның жартысынан көбі.
Dialogue: 0,0:24:51.63,0:24:52.46,JPsub,NTP,0000,0000,0000,,Ууух!
Dialogue: 0,0:24:53.22,0:24:56.16,JPsub,NTP,0000,0000,0000,,Тіпті полицейлер де дерек көзін әлі тапқан жоқ.
Dialogue: 0,0:24:56.56,0:25:00.25,JPsub,NTP,0000,0000,0000,,Жастар арасында жасырын түрде танымал болса керек.
Dialogue: 0,0:25:05.64,0:25:06.95,JPsub,NTP,0000,0000,0000,,Бұл пайдасыз болуы мүмкін, бірақ
Dialogue: 0,0:25:07.34,0:25:10.03,JPsub,NTP,0000,0000,0000,,Формуланы табудың басқа жолы жоқ.
Dialogue: 0,0:25:10.94,0:25:15.10,JPsub,NTP,0000,0000,0000,,Қалай болғанда да, мен бұл есірткі мен оқиғаның байланысын зерттегім келеді.
Dialogue: 0,0:25:15.70,0:25:16.66,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:25:17.36,0:25:20.15,JPsub,NTP,0000,0000,0000,,Бұл біраз ұзақ үзіліс болуы мүмкін.
Dialogue: 0,0:25:21.57,0:25:22.96,JPsub,NTP,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:25:23.52,0:25:24.28,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:25:24.86,0:25:26.50,JPsub,NTP,0000,0000,0000,,Мөлшермен қабылдаңыз
Dialogue: 0,0:25:36.41,0:25:37.86,JPsub,NTP,0000,0000,0000,,Менің атым Аосаки.
Dialogue: 0,0:25:38.09,0:25:39.84,JPsub,NTP,0000,0000,0000,,Детектив Акими, өтінемін.
Dialogue: 0,0:27:29.29,0:27:31.79,JPsub,NTP,0000,0000,0000,,Бауырым, бірдеңе іздеп жүрсің бе?
Dialogue: 0,0:27:36.34,0:27:36.95,JPsub,NTP,0000,0000,0000,,Ah tsk
Dialogue: 0,0:27:40.97,0:27:41.80,JPsub,NTP,0000,0000,0000,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:27:42.41,0:27:43.91,JPsub,NTP,0000,0000,0000,,Дәрі-дәрмекті басқа жерден сатып алыңыз
Dialogue: 0,0:27:44.58,0:27:47.54,JPsub,NTP,0000,0000,0000,,Маған қызыл түсті қолданатын ешкім керек емес.
Dialogue: 0,0:27:48.02,0:27:49.26,JPsub,NTP,0000,0000,0000,,Бұл туралы не деуге болады?
Dialogue: 0,0:27:50.11,0:27:50.93,JPsub,NTP,0000,0000,0000,,Кез келген нәрсе
Dialogue: 0,0:27:53.40,0:27:54.69,JPsub,NTP,0000,0000,0000,,Тағы да жаңбыр жауып тұр ма?
Dialogue: 0,0:27:55.09,0:27:56.20,JPsub,NTP,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:27:56.60,0:27:58.06,JPsub,NTP,0000,0000,0000,,Бұл жұмыс болуы керек.
Dialogue: 0,0:28:11.53,0:28:12.35,JPsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,0:29:47.60,0:29:49.84,JPsub,NTP,0000,0000,0000,,Есірткімен ойнап жатсаңыз, басқа біреуді таңдаңыз.
Dialogue: 0,0:30:17.49,0:30:20.18,JPsub,NTP,0000,0000,0000,,Жарайды, біраз ынталандыруды қалайсыз, солай ма?
Dialogue: 0,0:30:20.48,0:30:23.72,JPsub,NTP,0000,0000,0000,,Мен сізді өзіңіз қалағандай жақсы сезінемін.
Dialogue: 0,0:30:56.12,0:31:00.72,JPsub,NTP,0000,0000,0000,,Токиодағы сериялық кісі өлтірулердің жаңа құрбаны табылды
Dialogue: 0,0:31:01.62,0:31:04.29,JPsub,NTP,0000,0000,0000,,Кеше түнде қаладағы қонақүйдің сыртындағы аллеяда.
Dialogue: 0,0:31:04.72,0:31:10.93,JPsub,NTP,0000,0000,0000,,өтіп бара жатқан адам көп мөлшерде қан мен адамға ұқсайтын дене мүшелерін тапты.
Dialogue: 0,0:31:11.38,0:31:12.43,JPsub,NTP,0000,0000,0000,,қайнатылған қайнатылған
Dialogue: 0,0:31:12.85,0:31:13.47,JPsub,NTP,0000,0000,0000,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:31:13.71,0:31:14.95,JPsub,NTP,0000,0000,0000,,Жақсырақ болды ма?
Dialogue: 0,0:31:15.98,0:31:18.61,JPsub,NTP,0000,0000,0000,,Жарайды, айналайын.
Dialogue: 0,0:31:19.25,0:31:21.33,JPsub,NTP,0000,0000,0000,,Ол шамамен 4 сағат ішінде күшіне енеді.
Dialogue: 0,0:31:25.74,0:31:27.31,JPsub,NTP,0000,0000,0000,,Қылмысты сериялық кісі өлтіру ісімен бірдей орындаушы жасаған деген қорытынды жасалды. Ол қызық адам.
Dialogue: 0,0:31:27.71,0:31:30.98,JPsub,NTP,0000,0000,0000,,Соңғы кездері нарықта пайда болған дәрілердің кез келгенін қолданып көрдіңіз бе?
Dialogue: 0,0:31:36.95,0:31:38.44,JPsub,NTP,0000,0000,0000,,Тағы бір кісі өлтіруші
Dialogue: 0,0:31:44.37,0:31:46.92,JPsub,NTP,0000,0000,0000,,Кінәлі – кимоно киген адам.
Dialogue: 0,0:31:47.51,0:31:48.48,JPsub,NTP,0000,0000,0000,,Бұл іс жарыққа шыққанына төрт айдан асты.
Dialogue: 0,0:31:51.80,0:31:54.37,JPsub,NTP,0000,0000,0000,,Микия Бұны орындасақ не болады?
Dialogue: 0,0:31:55.86,0:31:57.76,JPsub,NTP,0000,0000,0000,,Мен оны ұсынбаймын.
Dialogue: 0,0:31:58.32,0:32:00.95,JPsub,NTP,0000,0000,0000,,Өзіңізді «Гансель мен Гретель» сияқты сезініңіз
Dialogue: 0,0:32:12.87,0:32:15.25,JPsub,NTP,0000,0000,0000,,Сіз көптен бері осындайсыз.
Dialogue: 0,0:32:17.82,0:32:19.77,JPsub,NTP,0000,0000,0000,,Жақсы, қалыпты жағдайда.
Dialogue: 0,0:32:26.15,0:32:29.24,JPsub,NTP,0000,0000,0000,,Полиция бұл күдікті адамды кимоно киіп алған.
Dialogue: 0,0:32:29.44,0:32:32.14,JPsub,NTP,0000,0000,0000,,Сериялық кісі өлтіру істерінің кілтін ұстайтын адам ретінде
Dialogue: 0,0:32:32.34,0:32:34.68,JPsub,NTP,0000,0000,0000,,Біздің саясатымыз - бағытталған тергеу жүргізу.
Dialogue: 0,0:33:16.61,0:33:17.73,JPsub,NTP,0000,0000,0000,,Танысқаныма қуаныштымын
Dialogue: 0,0:33:19.07,0:33:20.92,JPsub,NTP,0000,0000,0000,,Біз кеше кездестік.
Dialogue: 0,0:33:21.14,0:33:22.05,JPsub,NTP,0000,0000,0000,,Есіңде ме?
Dialogue: 0,0:33:26.27,0:33:28.98,JPsub,NTP,0000,0000,0000,,Кешіріңіз, мен сізден бірнәрсе сұрайын деп едім.
Dialogue: 0,0:33:34.49,0:33:36.37,JPsub,NTP,0000,0000,0000,,Мені неге іздеп жүрсің?
Dialogue: 0,0:33:38.21,0:33:40.14,JPsub,NTP,0000,0000,0000,,Бұл әйел болды, солай ма?
Dialogue: 0,0:33:40.47,0:33:41.72,JPsub,NTP,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:33:42.02,0:33:42.78,JPsub,NTP,0000,0000,0000,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:33:42.91,0:33:43.74,JPsub,NTP,0000,0000,0000,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:33:44.32,0:33:47.55,JPsub,NTP,0000,0000,0000,,Бұл ауданда коктейль сатпайтын жалғыз сен едің.
Dialogue: 0,0:33:48.27,0:33:51.30,JPsub,NTP,0000,0000,0000,,Мен сізден коктейльдер туралы естимін деп ойладым.
Dialogue: 0,0:33:51.58,0:33:52.42,JPsub,NTP,0000,0000,0000,,Барлығы осы
Dialogue: 0,0:33:52.90,0:33:56.72,JPsub,NTP,0000,0000,0000,,Неліктен барлық есірткі сатушылар коктейльдер туралы аузын жауып тастайды?
Dialogue: 0,0:33:56.95,0:33:58.09,JPsub,NTP,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:34:00.45,0:34:02.55,JPsub,NTP,0000,0000,0000,,Жақсы Сіз не сұрағыңыз келеді?
Dialogue: 0,0:34:05.53,0:34:06.39,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:34:06.69,0:34:12.07,JPsub,NTP,0000,0000,0000,,Коктейльді ішкен жігіт пен кісі өлтірушінің арасында қандай да бір байланыс бар.
Dialogue: 0,0:34:12.46,0:34:13.10,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:34:13.47,0:34:16.69,JPsub,NTP,0000,0000,0000,,Оған дейін, сен оны неге зерттейсің?
Dialogue: 0,0:34:19.41,0:34:22.08,JPsub,NTP,0000,0000,0000,,Жарайды, жоқ, мен айтайын.
Dialogue: 0,0:34:23.23,0:34:24.25,JPsub,NTP,0000,0000,0000,,Жаңалықтар бойынша
Dialogue: 0,0:34:24.61,0:34:26.94,JPsub,NTP,0000,0000,0000,,Кимоно киген жігіт - кісі өлтіруші.
Dialogue: 0,0:34:28.28,0:34:30.47,JPsub,NTP,0000,0000,0000,,Мен сенімен біраз кездескеннен кейін.
Dialogue: 0,0:34:31.20,0:34:35.51,JPsub,NTP,0000,0000,0000,,Мен жас жігіттің төрт жыл бойы кимоно киген әйелмен жыныстық қатынасқа түскенін көрдім.
Dialogue: 0,0:34:36.26,0:34:37.08,JPsub,NTP,0000,0000,0000,,Аралау
Dialogue: 0,0:34:38.21,0:34:39.70,JPsub,NTP,0000,0000,0000,,Бірақ кимоно киген әйел
Dialogue: 0,0:34:39.95,0:34:42.00,JPsub,NTP,0000,0000,0000,,Жаңалықтарда жынысы белгісіз болды
Dialogue: 0,0:34:42.57,0:34:45.67,JPsub,NTP,0000,0000,0000,,Сіз бұл қараңғы жерде қыз екенін білуге болады.
Dialogue: 0,0:34:46.38,0:34:49.64,JPsub,NTP,0000,0000,0000,,Оның дене сызықтары алыстан ғана әдемі көрінетін.
Dialogue: 0,0:34:49.87,0:34:52.48,JPsub,NTP,0000,0000,0000,,Сіз не айтасыз, сіз сол баланың танысысыз ба?
Dialogue: 0,0:34:55.06,0:34:57.37,JPsub,NTP,0000,0000,0000,,Менің ойымша, сіз ол баланы тоқтатуыңыз керек.
Dialogue: 0,0:34:57.73,0:34:58.74,JPsub,NTP,0000,0000,0000,,Уф… Қолымды қозғалтсам.
Dialogue: 0,0:34:59.54,0:35:02.74,JPsub,NTP,0000,0000,0000,,Әлгі әйелді төрт ер адам қоршап алып, абайламады.
Dialogue: 0,0:35:03.44,0:35:04.35,JPsub,NTP,0000,0000,0000,,Релаксация
Dialogue: 0,0:35:04.50,0:35:05.94,JPsub,NTP,0000,0000,0000,,Өлтірме, тірі қалдырма
Dialogue: 0,0:35:06.31,0:35:08.89,JPsub,NTP,0000,0000,0000,,Сізді қайта-қайта кесуге
Dialogue: 0,0:35:17.98,0:35:21.41,JPsub,NTP,0000,0000,0000,,Мен тым жылы адамдарды көп көрдім.
Dialogue: 0,0:35:22.31,0:35:23.94,JPsub,NTP,0000,0000,0000,,Бұл мен бірінші рет
Dialogue: 0,0:35:27.88,0:35:30.26,JPsub,NTP,0000,0000,0000,,Кешіріңіз, мен депрессияға ұшырадым.
Dialogue: 0,0:35:30.70,0:35:35.49,JPsub,NTP,0000,0000,0000,,Әй, өлтірілген төрт адам, сіз оқығаныңыздай, коктейльге тәуелді адамдар.
Dialogue: 0,0:35:37.02,0:35:40.55,JPsub,NTP,0000,0000,0000,,Қарсы болмасаңыз, коктейльдер туралы толығырақ айтып бере аласыз ба?
Dialogue: 0,0:35:41.14,0:35:44.62,JPsub,NTP,0000,0000,0000,,Осының бәрін естігеннен кейін, мен әлі кимоно киген әйелді іздеп жүрмін.
Dialogue: 0,0:35:45.12,0:35:46.06,JPsub,NTP,0000,0000,0000,,Өтінемін
Dialogue: 0,0:35:48.21,0:35:49.28,JPsub,NTP,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:35:50.08,0:35:54.11,JPsub,NTP,0000,0000,0000,,Сіз айтып отырған коктейль қышқыл мен марихуананың жаңа комбинациясы.
Dialogue: 0,0:35:54.63,0:35:55.29,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:35:55.68,0:35:58.78,JPsub,NTP,0000,0000,0000,,Бұл өте тәуелді және өте тиімді.
Dialogue: 0,0:35:59.04,0:36:01.47,JPsub,NTP,0000,0000,0000,,Мұндай дәрі сізді шынымен құртады.
Dialogue: 0,0:36:01.87,0:36:04.09,JPsub,NTP,0000,0000,0000,,Сондықтан мен коктейльдерді емдемеймін.
Dialogue: 0,0:36:04.40,0:36:06.79,JPsub,NTP,0000,0000,0000,,Қанға да рұқсат етілмейді.
Dialogue: 0,0:36:07.09,0:36:09.29,JPsub,NTP,0000,0000,0000,,Қан талшықтары
Dialogue: 0,0:36:10.54,0:36:12.52,JPsub,NTP,0000,0000,0000,,Қан чипі дегеніміз не?
Dialogue: 0,0:36:12.63,0:36:13.60,JPsub,NTP,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:36:14.20,0:36:19.19,JPsub,NTP,0000,0000,0000,,Коктейльге қанағаттанбаған адамдар үшін одан да жақсы коктейльдер.
Dialogue: 0,0:36:23.39,0:36:25.60,JPsub,NTP,0000,0000,0000,,Қосымша коктейльдер
Dialogue: 0,0:36:27.64,0:36:29.71,JPsub,NTP,0000,0000,0000,,Мені алаңдататын бір нәрсе бар.
Dialogue: 0,0:36:30.20,0:36:33.98,JPsub,NTP,0000,0000,0000,,Қан чипі коктейль сияқты мөртабан тәрізді.
Dialogue: 0,0:36:34.37,0:36:35.70,JPsub,NTP,0000,0000,0000,,Бірдей қызыл түс
Dialogue: 0,0:36:36.41,0:36:37.38,JPsub,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:36:37.74,0:36:42.62,JPsub,NTP,0000,0000,0000,,Сондықтан шеттері қою қызыл түске боялған.
Dialogue: 0,0:36:43.00,0:36:44.82,JPsub,NTP,0000,0000,0000,,Не, сен білмейсің бе?
Dialogue: 0,0:36:45.42,0:36:49.89,JPsub,NTP,0000,0000,0000,,Бұл бұлыңғыр қызыл түс - Motojime арнайы жасаған ерекше бұйым.
Dialogue: 0,0:36:51.53,0:36:53.83,JPsub,NTP,0000,0000,0000,,Бұл әйгілі әңгіме ме?
Dialogue: 0,0:36:54.22,0:36:54.94,JPsub,NTP,0000,0000,0000,,Mochi
Dialogue: 0,0:36:55.17,0:36:59.90,JPsub,NTP,0000,0000,0000,,Тек қан чиптерін сатушылар тек балалармен айналысады.
Dialogue: 0,0:37:00.18,0:37:02.60,JPsub,NTP,0000,0000,0000,,Ұйымның төменгі жағындағы дилерлер біледі
Dialogue: 0,0:37:03.06,0:37:04.88,JPsub,NTP,0000,0000,0000,,Мен жоғарыда айтылғандармен айналыспаймын.
Dialogue: 0,0:37:05.33,0:37:08.22,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл жай ғана балалардың ойыны.
Dialogue: 0,0:37:08.57,0:37:12.11,JPsub,NTP,0000,0000,0000,,Неліктен полиция әлі күнге дейін Blood Chip туралы білмейді?
Dialogue: 0,0:37:13.31,0:37:15.91,JPsub,NTP,0000,0000,0000,,Рахмет, бұл пайдалы болды.
Dialogue: 0,0:37:17.31,0:37:18.99,JPsub,NTP,0000,0000,0000,,Тым абай болмаңыз
Dialogue: 0,0:37:19.64,0:37:21.91,JPsub,NTP,0000,0000,0000,,Қан чипін жасайтындар үшін
Dialogue: 0,0:37:22.27,0:37:24.29,JPsub,NTP,0000,0000,0000,,Өйткені сатушы харизматикалық.
Dialogue: 0,0:37:24.61,0:37:27.48,JPsub,NTP,0000,0000,0000,,Ережелер жаңа дін сияқты.
Dialogue: 0,0:37:30.22,0:37:30.90,JPsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:37:31.99,0:37:34.10,JPsub,NTP,0000,0000,0000,,Мен шебердің есімін білемін.
Dialogue: 0,0:37:34.94,0:37:37.04,JPsub,NTP,0000,0000,0000,,Мен мұны білмедім.
Dialogue: 0,0:38:04.87,0:38:07.98,JPsub,NTP,0000,0000,0000,,Сіз шынымен де барлық сайттарға кірдіңіз бе?
Dialogue: 0,0:38:09.07,0:38:09.74,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:38:11.13,0:38:12.59,JPsub,NTP,0000,0000,0000,,Сіз не білдіңіз?
Dialogue: 0,0:38:15.63,0:38:19.30,JPsub,NTP,0000,0000,0000,,Полиция негізге алатын ештеңе жоқ
Dialogue: 0,0:38:20.39,0:38:23.16,JPsub,NTP,0000,0000,0000,,Өткен жылдан биылғы жылға дейін болған оқиғалар
Dialogue: 0,0:38:23.71,0:38:25.54,JPsub,NTP,0000,0000,0000,,Төрт жыл бұрын көшеде жын өлтіру
Dialogue: 0,0:38:26.65,0:38:28.76,JPsub,NTP,0000,0000,0000,,Кісі өлтіру оқиғасының жақындығынан басқа
Dialogue: 0,0:38:29.19,0:38:31.16,JPsub,NTP,0000,0000,0000,,Жалпы жақтары жоқтың қасы.
Dialogue: 0,0:38:31.93,0:38:36.12,JPsub,NTP,0000,0000,0000,,Алайда тергеу осы күнге дейін жалғасып келе жатқандықтан, мен неге екенін әлі түсінбеймін.
Dialogue: 0,0:38:36.30,0:38:39.17,JPsub,NTP,0000,0000,0000,,Бір жігіт пен жұмыс екен деп ойламаймын.
Dialogue: 0,0:38:39.49,0:38:40.55,JPsub,NTP,0000,0000,0000,,Мен келісемін.
Dialogue: 0,0:38:41.24,0:38:42.09,JPsub,NTP,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:38:43.18,0:38:43.98,JPsub,NTP,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:38:45.17,0:38:47.52,JPsub,NTP,0000,0000,0000,,Шекара!
Dialogue: 0,0:38:48.44,0:38:52.39,JPsub,NTP,0000,0000,0000,,Иә, көп рахмет.
Dialogue: 0,0:39:01.55,0:39:02.53,JPsub,NTP,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:39:11.91,0:39:15.71,JPsub,NTP,0000,0000,0000,,Оқиға елсіз жерден қала орталығына жақындап қалды.
Dialogue: 0,0:39:16.54,0:39:19.21,JPsub,NTP,0000,0000,0000,,Жерлеуді сыртта өткізу керек еді.
Dialogue: 0,0:39:19.81,0:39:24.95,JPsub,NTP,0000,0000,0000,,Бүгінде қайырымды адамдардың өмірінің саласы бұдан да терең қараңғылыққа толы.
Dialogue: 0,0:39:26.64,0:39:30.91,JPsub,NTP,0000,0000,0000,,Жаңа көршіңіздің қашан құрбан немесе қылмыскер болатынын ешқашан білмейсіз.
Dialogue: 0,0:39:32.30,0:39:33.87,JPsub,NTP,0000,0000,0000,,Қала жарқыраған сайын
Dialogue: 0,0:39:34.19,0:39:37.92,JPsub,NTP,0000,0000,0000,,Жарық жоқ жерлерде көлеңкелердің тереңірек болуы заңды ма?
Dialogue: 0,0:39:39.23,0:39:40.84,JPsub,NTP,0000,0000,0000,,Қаладағы қараңғылық тереңдей түседі
Dialogue: 0,0:39:41.30,0:39:44.23,JPsub,NTP,0000,0000,0000,,Адамның зұлматы тереңдей түсті
Dialogue: 0,0:39:45.24,0:39:47.12,JPsub,NTP,0000,0000,0000,,Не іздеп жатқаныңызды білмеймін.
Dialogue: 0,0:39:47.98,0:39:51.14,JPsub,NTP,0000,0000,0000,,Өз жүрегіңді өз-өзіңмен нұрландыра алмайсың.
Dialogue: 0,0:39:51.39,0:39:52.13,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:39:58.34,0:40:02.62,JPsub,NTP,0000,0000,0000,,Түн тереңдеген сайын қараңғылық да тереңдей түседі.
Dialogue: 0,0:40:03.74,0:40:05.75,JPsub,NTP,0000,0000,0000,,Бос қалада жүру
Dialogue: 0,0:40:06.47,0:40:09.14,JPsub,NTP,0000,0000,0000,,Жалғыз қалғым келгендіктен деп ойлаймын.
Dialogue: 0,0:40:10.04,0:40:15.56,JPsub,NTP,0000,0000,0000,,Әлде мен өзімді жалғыз қалғандай сезінгім келгендіктен бе?
Dialogue: 0,0:41:55.78,0:41:57.45,JPsub,NTP,0000,0000,0000,,Мен сені сағындым
Dialogue: 0,0:42:00.36,0:42:03.98,JPsub,NTP,0000,0000,0000,,Риоги рәсімі
Dialogue: 0,0:42:05.63,0:42:06.74,JPsub,NTP,0000,0000,0000,,Мен білемін
Dialogue: 0,0:42:12.18,0:42:13.32,JPsub,NTP,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:42:13.81,0:42:14.78,JPsub,NTP,0000,0000,0000,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:43:02.72,0:43:05.65,JPsub,NTP,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:43:06.07,0:43:07.51,JPsub,NTP,0000,0000,0000,,Осындай нәрсе бар ма?
Dialogue: 0,0:43:11.60,0:43:13.23,JPsub,NTP,0000,0000,0000,,Екі ырым
Dialogue: 0,0:43:47.03,0:43:51.88,JPsub,NTP,0000,0000,0000,,Неге мұны байыппен істемейсіз?
Dialogue: 0,0:43:53.20,0:43:55.81,JPsub,NTP,0000,0000,0000,,Сіз төрт жыл бұрынғыдан басқа адамсыз, солай емес пе?
Dialogue: 0,0:43:56.43,0:44:00.03,JPsub,NTP,0000,0000,0000,,Қазірдің өзінде мені өлтіргіңіз келсе, өлтіре алар едіңіз.
Dialogue: 0,0:44:01.01,0:44:03.73,JPsub,NTP,0000,0000,0000,,Сызықты кесіп өтуге тырыспау
Dialogue: 0,0:44:04.29,0:44:07.76,JPsub,NTP,0000,0000,0000,,Сен маған қатты керексің
Dialogue: 0,0:44:08.91,0:44:13.15,JPsub,NTP,0000,0000,0000,,Енді уақытым болмағандықтан сені көруге келдім.
Dialogue: 0,0:44:14.61,0:44:16.97,JPsub,NTP,0000,0000,0000,,Мұның бәрі сіз үшін
Dialogue: 0,0:44:17.44,0:44:18.87,JPsub,NTP,0000,0000,0000,,Ол да біреуді өлтірді.
Dialogue: 0,0:44:19.35,0:44:22.23,JPsub,NTP,0000,0000,0000,,Ол да артына түсінікті мәйіт қалдырды.
Dialogue: 0,0:44:23.94,0:44:25.46,JPsub,NTP,0000,0000,0000,,(Баяндау) Бір күні адамсыз жүзуші кеме табылды.
Dialogue: 0,0:44:26.70,0:44:30.15,JPsub,NTP,0000,0000,0000,,Мен төрт жыл бұрынғыны есіме түсіреді деп ойладым.
Dialogue: 0,0:44:33.06,0:44:35.45,JPsub,NTP,0000,0000,0000,,Бірақ сен мені елемей жүрдің.
Dialogue: 0,0:44:38.24,0:44:41.42,JPsub,NTP,0000,0000,0000,,Бірақ ол басқаша жұмыс істеді.
Dialogue: 0,0:44:43.61,0:44:45.79,JPsub,NTP,0000,0000,0000,,Иә, ол кісі өлтіруші.
Dialogue: 0,0:44:46.19,0:44:50.08,JPsub,NTP,0000,0000,0000,,Бұл есімді менің атым жоқ кезде берді
Dialogue: 0,0:44:51.84,0:44:54.02,JPsub,NTP,0000,0000,0000,,Бұл өте алыс, солай емес пе?
Dialogue: 0,0:44:54.75,0:44:56.36,JPsub,NTP,0000,0000,0000,,Мен өте қуаныштымын
Dialogue: 0,0:44:56.74,0:45:00.18,JPsub,NTP,0000,0000,0000,,Өткен апта сіздің үмітіңізді ақтады.
Dialogue: 0,0:45:00.45,0:45:05.22,JPsub,NTP,0000,0000,0000,,Кісі өлтіруші адамдарды бәрі күткендей өлтіруі керек.
Dialogue: 0,0:45:05.43,0:45:06.35,JPsub,NTP,0000,0000,0000,,Солай емес пе?
Dialogue: 0,0:45:08.57,0:45:10.57,JPsub,NTP,0000,0000,0000,,Сіз білуіңіз керек.
Dialogue: 0,0:45:11.00,0:45:11.82,JPsub,NTP,0000,0000,0000,,Рёги
Dialogue: 0,0:45:13.16,0:45:16.43,JPsub,NTP,0000,0000,0000,,Міне, қызғанып мені іздедің.
Dialogue: 0,0:45:17.77,0:45:22.64,JPsub,NTP,0000,0000,0000,,Тезірек бостандық алғым келді, мен өзім сияқты адамды тапқым келді.
Dialogue: 0,0:45:25.34,0:45:27.17,JPsub,NTP,0000,0000,0000,,А, мен білемін.
Dialogue: 0,0:45:27.44,0:45:28.83,JPsub,NTP,0000,0000,0000,,Білсең де
Dialogue: 0,0:45:31.23,0:45:35.82,JPsub,NTP,0000,0000,0000,,Себебі мен сені ең жақсы түсінетін адаммын.
Dialogue: 0,0:45:36.32,0:45:38.68,JPsub,NTP,0000,0000,0000,,Не істесең де, көңілің толмайды.
Dialogue: 0,0:45:38.97,0:45:41.71,JPsub,NTP,0000,0000,0000,,Өйткені сіз өз бастауыңызға қарсы шығып жатырсыз.
Dialogue: 0,0:45:41.94,0:45:43.63,JPsub,NTP,0000,0000,0000,,Ұстаудың қажеті жоқ
Dialogue: 0,0:45:43.80,0:45:46.59,JPsub,NTP,0000,0000,0000,,Тек адал ниетпен істегіңіз келетін нәрсені жасаңыз.
Dialogue: 0,0:45:48.66,0:45:50.28,JPsub,NTP,0000,0000,0000,,Мен мұны бұрын айттым.
Dialogue: 0,0:45:50.49,0:45:52.35,JPsub,NTP,0000,0000,0000,,Мен саған қызық емеспін.
Dialogue: 0,0:45:54.15,0:45:56.40,JPsub,NTP,0000,0000,0000,,Мен жай ғана көз жеткізгім келді.
Dialogue: 0,0:45:56.96,0:45:59.20,JPsub,NTP,0000,0000,0000,,Бұл өтірік. Бұл өтірік. Бұл өтірік.
Dialogue: 0,0:46:01.12,0:46:05.68,JPsub,NTP,0000,0000,0000,,Бұл сенің көздерің менің өлгенімді көріп тұрғанының дәлелі.
Dialogue: 0,0:46:08.34,0:46:09.81,JPsub,NTP,0000,0000,0000,,Мен өзімді ұстамаймын
Dialogue: 0,0:46:10.11,0:46:11.23,JPsub,NTP,0000,0000,0000,,Екі рәсім
Dialogue: 0,0:46:13.23,0:46:16.62,JPsub,NTP,0000,0000,0000,,Сіз маған өз қалауыңыз бойынша келдіңіз, солай ма?
Dialogue: 0,0:46:16.87,0:46:19.98,JPsub,NTP,0000,0000,0000,,Сен мені өлтіргің келгендіктен осынша соңынан ердің ғой, солай ма?
Dialogue: 0,0:46:21.72,0:46:24.10,JPsub,NTP,0000,0000,0000,,Кел, мені істе.
Dialogue: 0,0:46:28.53,0:46:32.70,JPsub,NTP,0000,0000,0000,,Бұл қайтып оралуға болмайтынын білдіреді.
Dialogue: 0,0:46:32.97,0:46:35.40,JPsub,NTP,0000,0000,0000,,Сонда себепті өлтіруден басқа амалымыз жоқ.
Dialogue: 0,0:46:37.64,0:46:41.58,JPsub,NTP,0000,0000,0000,,Қазір екі ырымды байланыстыратын нәрсе.
Dialogue: 0,0:46:42.49,0:46:45.58,JPsub,NTP,0000,0000,0000,,Сонда бәрі шешіледі.
Dialogue: 0,0:46:48.66,0:46:49.51,JPsub,NTP,0000,0000,0000,,Кім
Dialogue: 0,0:47:00.18,0:47:01.84,JPsub,NTP,0000,0000,0000,,Сіз кімді өлтіресіз?
Dialogue: 0,0:47:16.10,0:47:17.80,JPsub,NTP,0000,0000,0000,,Ябари
Dialogue: 0,0:47:18.69,0:47:19.75,JPsub,NTP,0000,0000,0000,,Жарайсың.
Dialogue: 0,0:47:20.22,0:47:22.09,JPsub,NTP,0000,0000,0000,,Бұл орын алатын сияқты
Dialogue: 0,0:47:23.24,0:47:26.19,JPsub,NTP,0000,0000,0000,,Сіз шыныменсіз бе?
Dialogue: 0,0:47:41.32,0:47:43.27,JPsub,NTP,0000,0000,0000,,Қарапайым емес пе?
Dialogue: 0,0:47:46.77,0:47:49.22,JPsub,NTP,0000,0000,0000,,Бар болғаны кедергілерді алып тастау керек
Dialogue: 0,0:49:44.35,0:49:46.70,JPsub,NTP,0000,0000,0000,,1995 жылғы сәуір
Dialogue: 0,0:49:47.44,0:49:49.10,JPsub,NTP,0000,0000,0000,,Мен оны кездестірдім
Dialogue: 0,0:49:58.47,0:49:59.19,JPsub,NTP,0000,0000,0000,,мамыр
Dialogue: 0,0:49:59.72,0:50:01.44,JPsub,NTP,0000,0000,0000,,Ол туралы сөйлесейік
Dialogue: 0,0:50:03.12,0:50:06.92,JPsub,NTP,0000,0000,0000,,Қазір де оны көргенде өзімді жоғалтып аламын.
Dialogue: 0,0:50:08.29,0:50:09.88,JPsub,NTP,0000,0000,0000,,Қарап тұрсам да
Dialogue: 0,0:50:10.90,0:50:12.95,JPsub,NTP,0000,0000,0000,,Мен мүлдем кетіп қалдым.
Dialogue: 0,0:50:14.44,0:50:17.04,JPsub,NTP,0000,0000,0000,,Менің күнделікті өмірім тозып барады
Dialogue: 0,0:50:18.53,0:50:21.07,JPsub,NTP,0000,0000,0000,,Сол орта мектепте оқитын ғажайып оқушы қыз
Dialogue: 0,0:50:22.45,0:50:25.49,JPsub,NTP,0000,0000,0000,,Мүмкін мен оған ғашық шығармын
Dialogue: 0,0:50:28.56,0:50:29.56,JPsub,NTP,0000,0000,0000,,шілде
Dialogue: 0,0:50:30.12,0:50:31.75,JPsub,NTP,0000,0000,0000,,Мен әлсіз адамдарды жек көремін
Dialogue: 0,0:50:32.29,0:50:34.45,JPsub,NTP,0000,0000,0000,,Ол сабырмен айтты.
Dialogue: 0,0:50:35.09,0:50:38.39,JPsub,NTP,0000,0000,0000,,Екі ырым да мені осылай жоққа шығарды.
Dialogue: 0,0:50:39.58,0:50:41.37,JPsub,NTP,0000,0000,0000,,Мен әлсіз адамдарды жек көремін
Dialogue: 0,0:50:41.89,0:50:44.90,JPsub,NTP,0000,0000,0000,,Мен мұның не екенін түсінбедім.
Dialogue: 0,0:50:45.83,0:50:48.81,JPsub,NTP,0000,0000,0000,,Сол түні мен бірінші рет біреуді ұрдым.
Dialogue: 0,0:50:50.07,0:50:53.23,JPsub,NTP,0000,0000,0000,,Сол түні мен бірінші рет біреуді өлтірдім.
Dialogue: 0,0:50:55.98,0:50:57.80,JPsub,NTP,0000,0000,0000,,Мен сол күннен бері бірде-бір көз қыспадым.
Dialogue: 0,0:50:58.41,0:51:01.57,JPsub,NTP,0000,0000,0000,,Қорыққаным сонша, тіпті сыртта жүре алмаймын.
Dialogue: 0,0:51:02.38,0:51:04.59,JPsub,NTP,0000,0000,0000,,Мен жай ғана аман қалғаным үшін өзімді жек көремін.
Dialogue: 0,0:51:05.17,0:51:06.82,JPsub,NTP,0000,0000,0000,,Айнаға да қарай алмайды
Dialogue: 0,0:51:08.47,0:51:10.29,JPsub,NTP,0000,0000,0000,,Мен ең нашар адаммын
Dialogue: 0,0:51:11.11,0:51:12.74,JPsub,NTP,0000,0000,0000,,Менің ешнәрсе істегім келмейді.
Dialogue: 0,0:51:13.36,0:51:14.92,JPsub,NTP,0000,0000,0000,,Менің ештеңе жегім келмейді.
Dialogue: 0,0:51:15.67,0:51:17.41,JPsub,NTP,0000,0000,0000,,Мен ең нашар адаммын
Dialogue: 0,0:51:18.36,0:51:19.82,JPsub,NTP,0000,0000,0000,,Мен оны жетінші күні байқадым.
Dialogue: 0,0:51:20.61,0:51:24.50,JPsub,NTP,0000,0000,0000,,Сол кезде қайтыс болған жалғыз адам емес.
Dialogue: 0,0:51:25.45,0:51:27.72,JPsub,NTP,0000,0000,0000,,Неге маған ешкім айтпады?
Dialogue: 0,0:51:28.29,0:51:34.73,JPsub,NTP,0000,0000,0000,,Қарапайым шындық, біреуді өлтіргенде, өзіңізді де өлтіресіз.
Dialogue: 0,0:51:36.37,0:51:37.43,JPsub,NTP,0000,0000,0000,,тамыз
Dialogue: 0,0:51:37.78,0:51:40.03,JPsub,NTP,0000,0000,0000,,Мен жынды бола бастадым
Dialogue: 0,0:51:40.58,0:51:42.23,JPsub,NTP,0000,0000,0000,,Арая-сан дұрыс айтады.
Dialogue: 0,0:51:42.60,0:51:43.73,JPsub,NTP,0000,0000,0000,,Мен дұрыс айтамын
Dialogue: 0,0:51:44.32,0:51:48.91,JPsub,NTP,0000,0000,0000,,Ақылсыз болсаң, адамды өлтірмейсің.
Dialogue: 0,0:51:49.55,0:51:51.72,JPsub,NTP,0000,0000,0000,,Сонда да өзімді еркін сезіне алмаймын.
Dialogue: 0,0:51:52.21,0:51:53.86,JPsub,NTP,0000,0000,0000,,Мен жалғыз қалуға тым уайымдаймын
Dialogue: 0,0:51:54.63,0:51:59.05,JPsub,NTP,0000,0000,0000,,Маған өзім сияқты адамгершілігінен жоғары дос керек екенін түсіндім.
Dialogue: 0,0:52:22.75,0:52:23.87,JPsub,NTP,0000,0000,0000,,Көптен бері көрмеген
Dialogue: 0,0:52:24.28,0:52:25.53,JPsub,NTP,0000,0000,0000,,Менің ойымша, үш жыл болды.
Dialogue: 0,0:52:25.66,0:52:26.70,JPsub,NTP,0000,0000,0000,,Курогири-кун
Dialogue: 0,0:52:28.71,0:52:30.20,JPsub,NTP,0000,0000,0000,,Бұл мен күткеннен жылдамырақ болды.
Dialogue: 0,0:52:30.97,0:52:35.02,JPsub,NTP,0000,0000,0000,,Мен сенің бұл жерге келгенше көп уақыт болады деп жоспарлаған едім.
Dialogue: 0,0:52:37.19,0:52:39.64,JPsub,NTP,0000,0000,0000,,Мен бірдеңені дұрыс істемедім бе?
Dialogue: 0,0:52:40.04,0:52:43.04,JPsub,NTP,0000,0000,0000,,Бір ғана себеп болды
Dialogue: 0,0:52:44.37,0:52:48.33,JPsub,NTP,0000,0000,0000,,Қараша айында мен көпқабатты үйдің тұрғындарын тексеруге мүмкіндік алдым.
Dialogue: 0,0:52:48.88,0:52:50.60,JPsub,NTP,0000,0000,0000,,Бұл қарапайым пәтер емес.
Dialogue: 0,0:52:51.29,0:52:56.10,JPsub,NTP,0000,0000,0000,,Сіз сонда болғаныңыз үшін салтанатты рәсімге қалай да қатыстыңыз.
Dialogue: 0,0:52:57.23,0:52:57.97,JPsub,NTP,0000,0000,0000,,Ицумида-сан ба?
Dialogue: 0,0:52:58.22,0:52:59.51,JPsub,NTP,0000,0000,0000,,Ширазуми Рио Сенпай
Dialogue: 0,0:53:01.52,0:53:05.05,JPsub,NTP,0000,0000,0000,,Арая-сан да маған қызықсыз трюктар жасады.
Dialogue: 0,0:53:07.32,0:53:10.38,JPsub,NTP,0000,0000,0000,,Түріңе қарағанда сен бәрін білетін сияқтысың.
Dialogue: 0,0:53:10.72,0:53:13.21,JPsub,NTP,0000,0000,0000,,Иә, бұл үш жыл бұрын болды.
Dialogue: 0,0:53:14.27,0:53:17.67,JPsub,NTP,0000,0000,0000,,Сіз екі салтанаттың сарайына барған кезде мені кездестірдіңіз.
Dialogue: 0,0:53:17.86,0:53:18.83,JPsub,NTP,0000,0000,0000,,Бұл кездейсоқтық емес
Dialogue: 0,0:53:19.39,0:53:24.54,JPsub,NTP,0000,0000,0000,,Мен сені тоқтаттым, себебі мен саған оның өлтірілген жерін көрсеткім келді.
Dialogue: 0,0:53:25.80,0:53:31.02,JPsub,NTP,0000,0000,0000,,Оның шынайы болмысын білмей, құрбандыққа шыдай алмадың.
Dialogue: 0,0:53:32.68,0:53:36.39,JPsub,NTP,0000,0000,0000,,Менің ағам төрт жылдан бері қылмыс жасап жүр.
Dialogue: 0,0:53:40.92,0:53:44.59,JPsub,NTP,0000,0000,0000,,Бірақ төрт жыл бұрын көшедегі кісі өлтіруге мен жауапты емес едім.
Dialogue: 0,0:53:45.42,0:53:46.71,JPsub,NTP,0000,0000,0000,,Бұл екі рәсім де.
Dialogue: 0,0:53:46.81,0:53:48.16,JPsub,NTP,0000,0000,0000,,Бұл өтірік
Dialogue: 0,0:53:48.42,0:53:49.09,JPsub,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:53:54.13,0:53:55.88,JPsub,NTP,0000,0000,0000,,Сіздің аға не істегісі келеді?
Dialogue: 0,0:53:56.10,0:53:57.38,JPsub,NTP,0000,0000,0000,,Бұл оқиға болды ма?
Dialogue: 0,0:54:00.42,0:54:01.34,JPsub,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:54:03.09,0:54:04.18,JPsub,NTP,0000,0000,0000,,Қол
Dialogue: 0,0:54:05.06,0:54:07.12,JPsub,NTP,0000,0000,0000,,Маған екі ырым да шабуыл жасады.
Dialogue: 0,0:54:17.77,0:54:20.52,JPsub,NTP,0000,0000,0000,,Мен бір ғана қол жоқ деп ойладым.
Dialogue: 0,0:54:21.03,0:54:22.76,JPsub,NTP,0000,0000,0000,,Бұны түзету қиын
Dialogue: 0,0:54:23.11,0:54:25.94,JPsub,NTP,0000,0000,0000,,Менің ойымша, өлтіру деген осы.
Dialogue: 0,0:54:26.47,0:54:27.24,JPsub,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:54:27.78,0:54:30.44,JPsub,NTP,0000,0000,0000,,Неге сонша рет кісі өлтірдің?
Dialogue: 0,0:54:30.92,0:54:33.99,JPsub,NTP,0000,0000,0000,,Мен өлтіргім келгендіктен өлтірмеймін.
Dialogue: 0,0:54:34.22,0:54:35.30,JPsub,NTP,0000,0000,0000,,Сонда неге?
Dialogue: 0,0:54:35.85,0:54:38.19,JPsub,NTP,0000,0000,0000,,Өйткені мен өзімнің шыққан тегімді оята алдым.
Dialogue: 0,0:54:38.48,0:54:42.13,JPsub,NTP,0000,0000,0000,,Сорен Арая есімді адамның терісін киген жын.
Dialogue: 0,0:54:42.96,0:54:45.46,JPsub,NTP,0000,0000,0000,,Курогири-кун, менің шыққан тегім қандай?
Dialogue: 0,0:54:46.07,0:54:48.40,JPsub,NTP,0000,0000,0000,,Бұл тамақ ішу туралы болды.
Dialogue: 0,0:54:49.03,0:54:51.29,JPsub,NTP,0000,0000,0000,,Мен өзімнің шыққан тегім туралы ояндым.
Dialogue: 0,0:54:51.71,0:54:52.89,JPsub,NTP,0000,0000,0000,,Менің тамақтан басқа амалым жоқ
Dialogue: 0,0:54:53.49,0:54:56.48,JPsub,NTP,0000,0000,0000,,Мен адам жейтін қанішермін.
Dialogue: 0,0:54:56.99,0:54:57.93,JPsub,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:54:58.24,0:54:59.12,JPsub,NTP,0000,0000,0000,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:54:59.42,0:55:00.70,JPsub,NTP,0000,0000,0000,,Бірдеңе дұрыс емес.
Dialogue: 0,0:55:01.18,0:55:03.56,JPsub,NTP,0000,0000,0000,,Жарайды, жалғастыруға рұқсат етіңіз.
Dialogue: 0,0:55:04.52,0:55:08.53,JPsub,NTP,0000,0000,0000,,Бұл біздің дұрыс сөйлесетін соңғы рет болуы мүмкін.
Dialogue: 0,0:55:09.32,0:55:13.85,JPsub,NTP,0000,0000,0000,,Ол кісі өлтіруші ретінде маған керек.
Dialogue: 0,0:55:15.05,0:55:15.91,JPsub,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:55:16.50,0:55:17.69,JPsub,NTP,0000,0000,0000,,Өйткені сіз осындасыз
Dialogue: 0,0:55:18.67,0:55:21.28,JPsub,NTP,0000,0000,0000,,Рёги бұл дүниеге келмейді.
Dialogue: 0,0:55:21.87,0:55:24.10,JPsub,NTP,0000,0000,0000,,Ол менде жалғыз
Dialogue: 0,0:55:24.84,0:55:25.80,JPsub,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:55:28.34,0:55:29.80,JPsub,NTP,0000,0000,0000,,Токо-санға барайық.
Dialogue: 0,0:55:30.22,0:55:32.42,JPsub,NTP,0000,0000,0000,,Мүмкін ол адам бірдеңе істей алады.
Dialogue: 0,0:55:35.28,0:55:37.84,JPsub,NTP,0000,0000,0000,,Жоқ, мен ерекшемін.
Dialogue: 0,0:55:38.74,0:55:40.08,JPsub,NTP,0000,0000,0000,,Бірақ дәл солай
Dialogue: 0,0:55:42.92,0:55:44.40,JPsub,NTP,0000,0000,0000,,Сіз өте мейірімдісіз
Dialogue: 0,0:55:45.77,0:55:46.84,JPsub,NTP,0000,0000,0000,,Бұл болды
Dialogue: 0,0:55:48.04,0:55:51.66,JPsub,NTP,0000,0000,0000,,Рио Ширазумиге әрқашан жалғыз сен қарадың.
Dialogue: 0,0:55:52.24,0:55:55.81,JPsub,NTP,0000,0000,0000,,Сондықтан мен қазір өзімді осылай ұстай аламын.
Dialogue: 0,0:55:56.39,0:55:57.83,JPsub,NTP,0000,0000,0000,,Мұның бәрі сіздің арқаңызда.
Dialogue: 0,0:56:01.53,0:56:02.39,JPsub,NTP,0000,0000,0000,,Бұл анық
Dialogue: 0,0:56:02.56,0:56:03.65,JPsub,NTP,0000,0000,0000,,Кісі өлтіруші
Dialogue: 0,0:56:06.94,0:56:07.76,JPsub,NTP,0000,0000,0000,,Бұл анық
Dialogue: 0,0:56:07.95,0:56:09.07,JPsub,NTP,0000,0000,0000,,Уф… Қолымды қозғалтсам.
Dialogue: 0,0:56:09.46,0:56:11.18,JPsub,NTP,0000,0000,0000,,Өтінемін, олай айтпаңыз.
Dialogue: 0,0:56:12.30,0:56:13.17,JPsub,NTP,0000,0000,0000,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:56:13.57,0:56:14.82,JPsub,NTP,0000,0000,0000,,Мен ештеңе істей алмаймын
Dialogue: 0,0:56:15.51,0:56:18.14,JPsub,NTP,0000,0000,0000,,Мен тірі болғанша олай болмайды.
Dialogue: 0,0:56:28.08,0:56:30.24,JPsub,NTP,0000,0000,0000,,Мені енді іздеме
Dialogue: 0,0:56:31.99,0:56:33.97,JPsub,NTP,0000,0000,0000,,Келесіде өлтіру болады
Dialogue: 0,0:56:36.23,0:56:37.16,JPsub,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:56:45.08,0:56:49.36,JPsub,NTP,0000,0000,0000,,Өтінемін, менің ағама жалғыз Туко-сан ғана көмектесе алады.
Dialogue: 0,0:56:49.75,0:56:51.80,JPsub,NTP,0000,0000,0000,,Сіз бұрынғыдай мейірімдісіз.
Dialogue: 0,0:56:52.27,0:56:54.07,JPsub,NTP,0000,0000,0000,,Тағы қосқым келетін бір нәрсе бар.
Dialogue: 0,0:56:54.32,0:56:55.54,JPsub,NTP,0000,0000,0000,,Мен бәрібір қайтамын.
Dialogue: 0,0:56:55.73,0:56:56.76,JPsub,NTP,0000,0000,0000,,Мені тыңда
Dialogue: 0,0:56:57.39,0:56:58.65,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл мүмкін емес.
Dialogue: 0,0:56:59.08,0:56:59.81,JPsub,NTP,0000,0000,0000,,Олай болса
Dialogue: 0,0:58:37.50,0:58:38.43,JPsub,NTP,0000,0000,0000,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:58:42.74,0:58:43.61,JPsub,NTP,0000,0000,0000,,Формула, солай ма?
Dialogue: 0,0:58:48.80,0:58:50.32,JPsub,NTP,0000,0000,0000,,Мына ақымақ
Dialogue: 0,0:58:51.59,0:58:53.81,JPsub,NTP,0000,0000,0000,,Сен қайда қыдырдың?
Dialogue: 0,0:58:54.42,0:58:56.65,JPsub,NTP,0000,0000,0000,,Сыртта қауіпті екенін білесіз.
Dialogue: 0,0:58:59.52,0:59:01.48,JPsub,NTP,0000,0000,0000,,Аман болсаң болды, жетеді.
Dialogue: 0,0:59:02.16,0:59:04.37,JPsub,NTP,0000,0000,0000,,Токоның орнында біраз уақыт бол.
Dialogue: 0,0:59:04.94,0:59:06.13,JPsub,NTP,0000,0000,0000,,Мұның бәрі бар.
Dialogue: 0,0:59:06.44,0:59:08.39,JPsub,NTP,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:59:09.61,0:59:11.22,JPsub,NTP,0000,0000,0000,,Микияға қатысы жоқ
Dialogue: 0,0:59:11.40,0:59:12.32,JPsub,NTP,0000,0000,0000,,Бұл маңызды.
Dialogue: 0,0:59:12.84,0:59:14.98,JPsub,NTP,0000,0000,0000,,Сіз кісі өлтірушіні қуып бара жатырсыз, солай ма? Формула болып табылады
Dialogue: 0,0:59:16.31,0:59:17.22,JPsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:59:17.86,0:59:18.93,JPsub,NTP,0000,0000,0000,,Өрнегі жоқ
Dialogue: 0,0:59:19.29,0:59:20.24,JPsub,NTP,0000,0000,0000,,Мен қайтып келемін
Dialogue: 0,0:59:20.91,0:59:24.10,JPsub,NTP,0000,0000,0000,,Ол адамды өлтірмеу керек.
Dialogue: 0,0:59:30.33,0:59:31.95,JPsub,NTP,0000,0000,0000,,Өлтірме
Dialogue: 0,0:59:34.01,0:59:36.99,JPsub,NTP,0000,0000,0000,,Енді мен біраз үнемдей алатын шығармын.
Dialogue: 0,0:59:37.38,0:59:38.58,JPsub,NTP,0000,0000,0000,,Ендеше тез тауып ал
Dialogue: 0,0:59:39.04,0:59:41.76,JPsub,NTP,0000,0000,0000,,Сіз Шираджунмен кездестіңіз бе?
Dialogue: 0,0:59:42.55,0:59:43.39,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:59:44.34,0:59:46.09,JPsub,NTP,0000,0000,0000,,Барып оны табыңыз
Dialogue: 0,0:59:46.31,0:59:47.21,JPsub,NTP,0000,0000,0000,,Менеджер болудан басқа.
Dialogue: 0,0:59:51.89,0:59:55.54,JPsub,NTP,0000,0000,0000,,Не істеуім керек? Мен оны енді кешіре алмаймын.
Dialogue: 0,0:59:55.85,0:59:56.59,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:59:56.99,0:59:58.19,JPsub,NTP,0000,0000,0000,,Жоқ, мен сені өлтіремін.
Dialogue: 0,0:59:58.85,1:00:00.03,JPsub,NTP,0000,0000,0000,,Жоқ, жоқ.
Dialogue: 0,1:00:00.36,1:00:02.55,JPsub,NTP,0000,0000,0000,,Менің асыл олжамды қашып құтылуға ниетім жоқ.
Dialogue: 0,1:00:03.12,1:00:06.03,JPsub,NTP,0000,0000,0000,,Өйткені ол мен көптен бері кездеспеген адам.
Dialogue: 0,1:00:06.53,1:00:08.19,JPsub,NTP,0000,0000,0000,,Жан-тәнімізбен.
Dialogue: 0,1:00:08.89,1:00:13.46,JPsub,NTP,0000,0000,0000,,Басқа адам қанша қылмыс жасаса да, біреуді өлтіру дұрыс емес.
Dialogue: 0,1:00:14.56,1:00:17.51,JPsub,NTP,0000,0000,0000,,Жалпылауларыңызды естуден шаршадым, Курогири.
Dialogue: 0,1:00:19.08,1:00:22.12,JPsub,NTP,0000,0000,0000,,Рио Ширазуми тым көп адамды өлтірді, сондықтан
Dialogue: 0,1:00:22.24,1:00:24.00,JPsub,NTP,0000,0000,0000,,Ешкім өлтіруге лайық емес.
Dialogue: 0,1:00:25.26,1:00:26.84,JPsub,NTP,0000,0000,0000,,Ол тым кеш
Dialogue: 0,1:00:27.03,1:00:28.03,JPsub,NTP,0000,0000,0000,,Уф… Қолымды қозғалтсам.
Dialogue: 0,1:00:29.71,1:00:31.35,JPsub,NTP,0000,0000,0000,,Әйтеуір, қайтып келемін.
Dialogue: 0,1:00:31.94,1:00:32.77,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:00:41.27,1:00:42.11,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:00:50.02,1:00:50.80,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:00:51.60,1:00:52.89,JPsub,NTP,0000,0000,0000,,Егер сіз ағаңызды өлтірсеңіз
Dialogue: 0,1:00:53.68,1:00:55.59,JPsub,NTP,0000,0000,0000,,Өйткені мен сені кешірмеймін
Dialogue: 0,1:01:02.62,1:01:03.37,JPsub,NTP,0000,0000,0000,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,1:01:04.02,1:01:04.82,JPsub,NTP,0000,0000,0000,,Сол жылы тағы бір үрей басталды
Dialogue: 0,1:01:06.67,1:01:07.67,JPsub,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,1:01:09.32,1:01:12.00,JPsub,NTP,0000,0000,0000,,Өйткені мен де ол сияқты кісі өлтірушімін.
Dialogue: 0,1:01:12.89,1:01:14.08,JPsub,NTP,0000,0000,0000,,Сіз басқасыз.
Dialogue: 0,1:01:14.81,1:01:16.69,JPsub,NTP,0000,0000,0000,,Мен ешкімді өлтірген жоқпын, солай ма?
Dialogue: 0,1:01:17.43,1:01:19.70,JPsub,NTP,0000,0000,0000,,Сәйкестік Осы уақытқа дейін
Dialogue: 0,1:01:21.11,1:01:22.38,JPsub,NTP,0000,0000,0000,,Бірақ ол өзгермейді
Dialogue: 0,1:01:22.96,1:01:24.35,JPsub,NTP,0000,0000,0000,,Мен байқадым, Микия.
Dialogue: 0,1:01:25.85,1:01:29.13,JPsub,NTP,0000,0000,0000,,Төрт жыл бұрын мен кісі өлтіруге жақын қалдым.
Dialogue: 0,1:01:29.69,1:01:32.41,JPsub,NTP,0000,0000,0000,,Өйткені Ори өлтіруден басқа ештеңе істемейтін адам болатын.
Dialogue: 0,1:01:34.81,1:01:36.45,JPsub,NTP,0000,0000,0000,,Бірақ солай
Dialogue: 0,1:01:36.72,1:01:38.87,JPsub,NTP,0000,0000,0000,,Ори тек кісі өлтіреді
Dialogue: 0,1:01:39.29,1:01:41.35,JPsub,NTP,0000,0000,0000,,Мен адам өлтіргенді ұнатпадым.
Dialogue: 0,1:01:42.31,1:01:44.11,JPsub,NTP,0000,0000,0000,,Сол апаттан кейін мен жалғыз қалдым.
Dialogue: 0,1:01:44.44,1:01:47.32,JPsub,NTP,0000,0000,0000,,Ори жоқ болса да, мен өлтіру әрекетіне алаңдаймын.
Dialogue: 0,1:01:48.53,1:01:53.13,JPsub,NTP,0000,0000,0000,,Қанішерлердің соңынан өлген Ори емес.
Dialogue: 0,1:01:53.71,1:01:56.02,JPsub,NTP,0000,0000,0000,,Бұл сақталған формула.
Dialogue: 0,1:01:56.80,1:01:57.85,JPsub,NTP,0000,0000,0000,,Сондықтан бұл жақсы емес.
Dialogue: 0,1:01:58.40,1:02:00.18,JPsub,NTP,0000,0000,0000,,Мен ол жерге қайтып бармаймын.
Dialogue: 0,1:02:02.52,1:02:03.52,JPsub,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,1:02:04.45,1:02:06.90,JPsub,NTP,0000,0000,0000,,Микияның күтудің қажеті жоқ.
Dialogue: 0,1:02:09.87,1:02:11.89,JPsub,NTP,0000,0000,0000,,Бұл сіздің қателігіңіз.
Dialogue: 0,1:02:12.20,1:02:12.96,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:02:13.47,1:02:14.98,JPsub,NTP,0000,0000,0000,,Сен мұны айтпадың ба?
Dialogue: 0,1:02:15.45,1:02:18.36,JPsub,NTP,0000,0000,0000,,Адам өмірінде бір өлімнің ауыртпалығын көтереді дейді.
Dialogue: 0,1:02:19.57,1:02:21.49,JPsub,NTP,0000,0000,0000,,Сіз мұны бағалайсыз.
Dialogue: 0,1:02:21.98,1:02:25.06,JPsub,NTP,0000,0000,0000,,Бәрінен бұрын мен кісі өлтірудің азабын басқалардан артық білемін.
Dialogue: 0,1:02:26.38,1:02:28.14,JPsub,NTP,0000,0000,0000,,Сіз ешкімді өлтірмейсіз
Dialogue: 0,1:02:28.53,1:02:30.70,JPsub,NTP,0000,0000,0000,,Мен ешкімді өлтірген жоқпын.
Dialogue: 0,1:02:31.49,1:02:32.54,JPsub,NTP,0000,0000,0000,,Мені күлдірме
Dialogue: 0,1:02:33.00,1:02:35.43,JPsub,NTP,0000,0000,0000,,Мұндай сәйкестік осы уақытқа дейін қалай жалғасуы мүмкін?
Dialogue: 0,1:02:37.13,1:02:39.83,JPsub,NTP,0000,0000,0000,,Сіз әрқашан өз еркіңізбен шыдап жүрдіңіз.
Dialogue: 0,1:02:40.58,1:02:42.26,JPsub,NTP,0000,0000,0000,,Адамдар басқаша ойлайды.
Dialogue: 0,1:02:42.61,1:02:45.64,JPsub,NTP,0000,0000,0000,,Формула жай ғана қанішер емес пе?
Dialogue: 0,1:02:47.33,1:02:51.47,JPsub,NTP,0000,0000,0000,,Сіз маған өткен жылдың соңында Бродбриджде айттыңыз
Dialogue: 0,1:02:52.09,1:02:55.87,JPsub,NTP,0000,0000,0000,,Менің өлтіруші құмарлықтарым мен ойлағандай жаман емес еді.
Dialogue: 0,1:02:56.50,1:02:59.86,JPsub,NTP,0000,0000,0000,,Осыны айтып күлгеніңді көріп, көзім жетті.
Dialogue: 0,1:03:00.74,1:03:02.31,JPsub,NTP,0000,0000,0000,,Сіз ешкімді өлтірмейсіз
Dialogue: 0,1:03:02.87,1:03:05.65,JPsub,NTP,0000,0000,0000,,Мен бұған шыдадым, шыдаймын.
Dialogue: 0,1:03:06.10,1:03:07.12,JPsub,NTP,0000,0000,0000,,Мүлдем
Dialogue: 0,1:03:11.56,1:03:13.05,JPsub,NTP,0000,0000,0000,,Мен түсінбейтін абсолютті деген не?
Dialogue: 0,1:03:14.02,1:03:17.36,JPsub,NTP,0000,0000,0000,,Сіз қайдан білесіз?
Dialogue: 0,1:03:17.69,1:03:18.48,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,1:03:25.85,1:03:30.30,JPsub,NTP,0000,0000,0000,,Өйткені... сен мейірімдісің.
Dialogue: 0,1:03:40.06,1:03:41.64,JPsub,NTP,0000,0000,0000,,Сен өзгермейсің, айттым ғой.
Dialogue: 0,1:03:42.46,1:03:43.43,JPsub,NTP,0000,0000,0000,,Мен саған айттым
Dialogue: 0,1:03:43.92,1:03:48.43,JPsub,NTP,0000,0000,0000,,Орихаса, мен сені жек көретінмін.
Dialogue: 0,1:03:49.69,1:03:51.66,JPsub,NTP,0000,0000,0000,,Өрнегі әртүрлі.
Dialogue: 0,1:04:24.10,1:04:27.79,JPsub,NTP,0000,0000,0000,,Өйткені... сен мейірімдісің.
Dialogue: 0,1:04:29.32,1:04:34.38,JPsub,NTP,0000,0000,0000,,Неліктен бақытты адам
Dialogue: 0,1:04:38.80,1:04:40.94,JPsub,NTP,0000,0000,0000,,Бастапқыда оянған адам дегеніміз не?
Dialogue: 0,1:04:41.77,1:04:45.28,JPsub,NTP,0000,0000,0000,,Араяның да артында қызықсыз кәдесыйлары қалды.
Dialogue: 0,1:04:46.59,1:04:49.27,JPsub,NTP,0000,0000,0000,,Бастауыш нені білдіреді?
Dialogue: 0,1:04:56.78,1:04:59.19,JPsub,NTP,0000,0000,0000,,Өткен өмірге сенесің бе?
Dialogue: 0,1:05:00.53,1:05:02.94,JPsub,NTP,0000,0000,0000,,Мен оны жоққа шығармаймын, бірақ оны да растамаймын.
Dialogue: 0,1:05:04.52,1:05:05.95,JPsub,NTP,0000,0000,0000,,Рух немесе жан
Dialogue: 0,1:05:06.47,1:05:11.93,JPsub,NTP,0000,0000,0000,,Өмір идеясын алып тастасаң, бәрі бірдеңе болып қайта туады.
Dialogue: 0,1:05:12.66,1:05:15.64,JPsub,NTP,0000,0000,0000,,Бұрынғы өмір Алдыңғы өмір Бұдан кейінгі алдыңғы өмір
Dialogue: 0,1:05:16.17,1:05:20.84,JPsub,NTP,0000,0000,0000,,Хаотикалық заңдарды іздейтін болмыстың тізбегі
Dialogue: 0,1:05:21.44,1:05:23.59,JPsub,NTP,0000,0000,0000,,Жаныңыздың бастауы
Dialogue: 0,1:05:24.12,1:05:28.02,JPsub,NTP,0000,0000,0000,,Сенің тіршілігің басталған жер бар екені сөзсіз.
Dialogue: 0,1:05:30.02,1:05:35.18,JPsub,NTP,0000,0000,0000,,Бірақ онда өмір жоқ
Dialogue: 0,1:05:37.35,1:05:43.41,JPsub,NTP,0000,0000,0000,,Заттарды анықтайтын бастаманың себебі, бағыты ғана бар.
Dialogue: 0,1:05:44.25,1:05:48.28,JPsub,NTP,0000,0000,0000,,Ал бұл ретсіз импульс магияда бастау деп аталады.
Dialogue: 0,1:05:48.96,1:05:51.67,JPsub,NTP,0000,0000,0000,,Қарапайым тілмен айтқанда, «инстинкт» деп аталады.
Dialogue: 0,1:05:52.64,1:05:58.05,JPsub,NTP,0000,0000,0000,,Дегенмен, шығу тегі тек себеп болып табылады және жеке тұлғаны басқармайды.
Dialogue: 0,1:05:58.50,1:06:01.82,JPsub,NTP,0000,0000,0000,,Егер сіз бұл туралы қандай да бір себептермен білмесеңіз.
Dialogue: 0,1:06:02.24,1:06:06.23,JPsub,NTP,0000,0000,0000,,Басқаша айтқанда, егер сіз оны білсеңіз, сіз сол бағытқа бой алдырасыз.
Dialogue: 0,1:06:06.70,1:06:10.10,JPsub,NTP,0000,0000,0000,,Рио Ширазумидің өз импульстарын қайталаудан басқа амалы жоқ.
Dialogue: 0,1:06:10.77,1:06:14.38,JPsub,NTP,0000,0000,0000,,Тамақтану өте ерекше серпін.
Dialogue: 0,1:06:15.95,1:06:18.41,JPsub,NTP,0000,0000,0000,,Араяның байқағаны таңқаларлық емес.
Dialogue: 0,1:06:21.67,1:06:22.75,JPsub,NTP,0000,0000,0000,,Тыңда, Куротори
Dialogue: 0,1:06:24.05,1:06:26.07,JPsub,NTP,0000,0000,0000,,Тамақтанудың бастауы болса
Dialogue: 0,1:06:26.81,1:06:31.36,JPsub,NTP,0000,0000,0000,,Рио Ширазумидің бұрынғы өмірі жыртқыш тіршілік иелерімен байланысты болды, солай емес пе?
Dialogue: 0,1:06:32.01,1:06:35.87,JPsub,NTP,0000,0000,0000,,Өзінің шыққан тегі оянғандар өздері жинақтаған өткен өмірге ие болады.
Dialogue: 0,1:06:38.85,1:06:41.50,JPsub,NTP,0000,0000,0000,,Рио Ширазуми жалғыз адам емес.
Dialogue: 0,1:06:41.86,1:06:43.89,JPsub,NTP,0000,0000,0000,,Оны бірнеше хайуан ретінде көрген дұрыс.
Dialogue: 0,1:06:44.72,1:06:48.08,JPsub,NTP,0000,0000,0000,,Рио Ширазумидің жеке басы сақталғандықтан, бұл әлі де жақсы.
Dialogue: 0,1:06:48.50,1:06:53.02,JPsub,NTP,0000,0000,0000,,Егер ол жоғалып кетсе, ол шынымен хайуанаттар колониясына айналады.
Dialogue: 0,1:06:56.12,1:06:58.51,JPsub,NTP,0000,0000,0000,,Бұл қызық па?
Dialogue: 0,1:06:58.92,1:07:01.66,JPsub,NTP,0000,0000,0000,,Себеп - мұны істеген сиқыршы, солай ма?
Dialogue: 0,1:07:02.06,1:07:04.05,JPsub,NTP,0000,0000,0000,,Бір ғана аға болса, мұндай жағдай болмас еді...
Dialogue: 0,1:07:04.73,1:07:05.69,JPsub,NTP,0000,0000,0000,,Менің ойымша, солай
Dialogue: 0,1:07:06.46,1:07:08.38,JPsub,NTP,0000,0000,0000,,Өзінің шығу тегін ояту өнері
Dialogue: 0,1:07:08.91,1:07:12.40,JPsub,NTP,0000,0000,0000,,Бұл жасырын әдіс, егер кастер мен субъект келіспейінше орындау мүмкін емес.
Dialogue: 0,1:07:13.46,1:07:16.28,JPsub,NTP,0000,0000,0000,,Рио Ширазуми оны өзі таңдады.
Dialogue: 0,1:07:16.83,1:07:22.34,JPsub,NTP,0000,0000,0000,,Өз еркімен аңға айналып, өз еркімен өлтіреді.
Dialogue: 0,1:07:23.06,1:07:24.22,JPsub,NTP,0000,0000,0000,,тым кеш
Dialogue: 0,1:07:24.78,1:07:28.80,JPsub,NTP,0000,0000,0000,,Тіпті Туко-сан да Ширазуми Рио-сенпайға көмектесе алмайды.
Dialogue: 0,1:07:29.32,1:07:32.95,JPsub,NTP,0000,0000,0000,,Шығу ояну жан формасын ұстанады
Dialogue: 0,1:07:33.26,1:07:36.62,JPsub,NTP,0000,0000,0000,,Бұл оның тамырына жеткізуге тырысқан адамның қолынан шыққан жарқыраған әдіс.
Dialogue: 0,1:07:37.76,1:07:42.57,JPsub,NTP,0000,0000,0000,,Мамандығым – физикалық, бірақ жанға келгенде, қолымнан келмейді.
Dialogue: 0,1:07:44.29,1:07:45.39,JPsub,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,1:07:47.15,1:07:50.39,JPsub,NTP,0000,0000,0000,,Бірақ менде әлі де ағалық тұлға болғандықтан,
Dialogue: 0,1:07:50.71,1:07:52.73,JPsub,NTP,0000,0000,0000,,Мен сізге не істей аламын?
Dialogue: 0,1:07:53.33,1:07:57.97,JPsub,NTP,0000,0000,0000,,Ең болмаса өзіңді еркін сезінетін нәрсені істей аласың.
Dialogue: 0,1:07:58.61,1:08:01.72,JPsub,NTP,0000,0000,0000,,Бірақ мұның еш мәні жоқ.
Dialogue: 0,1:08:02.04,1:08:04.78,JPsub,NTP,0000,0000,0000,,Осы уақытқа дейін Рио-Ширазуми болып қала алғаным бір ғажайып.
Dialogue: 0,1:08:06.89,1:08:11.66,JPsub,NTP,0000,0000,0000,,Сізді түсіну өте оңай, Курогири.
Dialogue: 0,1:08:12.42,1:08:15.96,JPsub,NTP,0000,0000,0000,,Жарайды, мен сені тоқтата алмаймын, бірақ басқа адам - ​​қанішер.
Dialogue: 0,1:08:16.65,1:08:19.68,JPsub,NTP,0000,0000,0000,,Бұндай нәрсені формулаға қалдырған дұрыс.
Dialogue: 0,1:08:20.74,1:08:24.98,JPsub,NTP,0000,0000,0000,,Менің ойымша, олар төрт жыл бұрынғы оқиғаны шешу үшін қанішерді қуып жатыр.
Dialogue: 0,1:08:26.06,1:08:30.17,JPsub,NTP,0000,0000,0000,,Туко-сан, адамдар неге адамдарды өлтіреді?
Dialogue: 0,1:08:31.43,1:08:36.16,JPsub,NTP,0000,0000,0000,,Басқа адамға деген сезіміңіз сіздің мүмкіндігіңізден асып кетсе.
Dialogue: 0,1:08:38.48,1:08:40.51,JPsub,NTP,0000,0000,0000,,Махаббат па, жек көру ме
Dialogue: 0,1:08:40.95,1:08:45.67,JPsub,NTP,0000,0000,0000,,Өз ыдысыңыз толып кеткенде, оны қандай да бір жолмен өшіруден басқа амалыңыз жоқ.
Dialogue: 0,1:08:46.44,1:08:50.39,JPsub,NTP,0000,0000,0000,,Әдіс шектен шыққанда, ол кісі өлтіруге айналады.
Dialogue: 0,1:08:52.12,1:08:54.84,JPsub,NTP,0000,0000,0000,,Бірақ кейбір адамдар себепсіз адамдарды өлтіреді.
Dialogue: 0,1:08:55.06,1:08:57.88,JPsub,NTP,0000,0000,0000,,Бұл кісі өлтіру емес, бұл кісі өлтіру.
Dialogue: 0,1:08:59.07,1:09:04.77,JPsub,NTP,0000,0000,0000,,Адамдар бір-бірінің қадір-қасиетін, дәрежесін өлшегенде ғана, қайсысы оларды жояды.
Dialogue: 0,1:09:04.92,1:09:06.29,JPsub,NTP,0000,0000,0000,,Бұл кісі өлтіру болар еді.
Dialogue: 0,1:09:06.85,1:09:09.87,JPsub,NTP,0000,0000,0000,,Мен біреуді өлтірудің мағынасы мен кінәсін көтеремін.
Dialogue: 0,1:09:10.45,1:09:11.90,JPsub,NTP,0000,0000,0000,,Бірақ сою басқа.
Dialogue: 0,1:09:12.50,1:09:17.35,JPsub,NTP,0000,0000,0000,,Өлтірген адам - ​​адам, бірақ өлтірген адамның тұлға ретінде қадір-қасиеті де, мәні де жоқ.
Dialogue: 0,1:09:19.17,1:09:24.60,JPsub,NTP,0000,0000,0000,,Біреуді өлтіру - өзіңді өлтіру
Dialogue: 0,1:09:26.22,1:09:28.46,JPsub,NTP,0000,0000,0000,,Сонымен, кісі өлтіруші деген не?
Dialogue: 0,1:09:29.46,1:09:31.17,JPsub,NTP,0000,0000,0000,,Бұл айтылған емес пе?
Dialogue: 0,1:09:32.39,1:09:37.36,JPsub,NTP,0000,0000,0000,,Бұл адамды өлтіретін жын, сондықтан табиғи апатпен бірдей.
Dialogue: 0,1:09:38.33,1:09:40.87,JPsub,NTP,0000,0000,0000,,Оған ілінгендердің жолы болмайды.
Dialogue: 0,1:09:44.16,1:09:45.56,JPsub,NTP,0000,0000,0000,,Эй, Курогири-кун
Dialogue: 0,1:09:46.46,1:09:50.18,JPsub,NTP,0000,0000,0000,,Адам өмірінде бір адамды ғана өлтіре алады
Dialogue: 0,1:09:50.63,1:09:52.57,JPsub,NTP,0000,0000,0000,,Менің есімде...
Dialogue: 0,1:09:54.94,1:10:00.39,JPsub,NTP,0000,0000,0000,,Бұл атамның салтанатты жиында маған айтқан өсиеті.
Dialogue: 0,1:10:01.12,1:10:04.17,JPsub,NTP,0000,0000,0000,,Формула ұзақ уақыт бойы оны осылай сақтауға тырысты.
Dialogue: 0,1:10:04.53,1:10:06.28,JPsub,NTP,0000,0000,0000,,Оны жоғалтуға тырысу
Dialogue: 0,1:10:07.13,1:10:08.13,JPsub,NTP,0000,0000,0000,,Таңғажайып емес пе? Көз жеткен жердің бәрінде Ятоитерлер!
Dialogue: 0,1:10:08.60,1:10:09.30,JPsub,NTP,0000,0000,0000,,Сіз барасыз ба?
Dialogue: 0,1:10:09.80,1:10:10.36,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:10:10.76,1:10:14.76,JPsub,NTP,0000,0000,0000,,Егер солай болса, онда оларды тоқтату ақымақтық болар еді.
Dialogue: 0,1:10:16.65,1:10:18.63,JPsub,NTP,0000,0000,0000,,Қош келдіңіз, Курогири
Dialogue: 0,1:10:19.56,1:10:21.89,JPsub,NTP,0000,0000,0000,,Егер қарым-қатынас жалғаса берсе, ертең кездескенше
Dialogue: 0,1:11:03.31,1:11:04.19,JPsub,NTP,0000,0000,0000,,Тооко-сан
Dialogue: 0,1:11:06.08,1:11:07.48,JPsub,NTP,0000,0000,0000,,Сіздің үлкен ағаңыз бар ма?
Dialogue: 0,1:11:08.98,1:11:10.96,JPsub,NTP,0000,0000,0000,,Мен саған қанша қоңырау шалсам да, сен маған хабарласпадың.
Dialogue: 0,1:11:12.46,1:11:13.81,JPsub,NTP,0000,0000,0000,,Бұл Микияның жігіті.
Dialogue: 0,1:11:14.19,1:11:15.95,JPsub,NTP,0000,0000,0000,,Сол әйелдің орнында.
Dialogue: 0,1:11:18.15,1:11:19.97,JPsub,NTP,0000,0000,0000,,Маған мәжбүрлесең, жарайды.
Dialogue: 0,1:11:20.77,1:11:24.11,JPsub,NTP,0000,0000,0000,,Мен осындай жеңіліске ұшырағаным үшін кешірім сұраймын.
Dialogue: 0,1:11:24.83,1:11:29.56,JPsub,NTP,0000,0000,0000,,Тооко-сан, ағаңа тезірек ``Мен ол әйелмен байланысымды үземін'' деп айт.
Dialogue: 0,1:11:30.00,1:11:31.98,JPsub,NTP,0000,0000,0000,,Қолымды кесу керек пе?
Dialogue: 0,1:11:32.43,1:11:35.14,JPsub,NTP,0000,0000,0000,,Әрине, бұл сәл тым ұзақ.
Dialogue: 0,1:11:35.62,1:11:39.48,JPsub,NTP,0000,0000,0000,,Олай емес сияқты, бірақ маған қатты ұнады.
Dialogue: 0,1:11:49.57,1:11:52.46,JPsub,NTP,0000,0000,0000,,Енді тазалаудан кейін бастайық.
Dialogue: 0,1:11:53.20,1:11:54.92,JPsub,NTP,0000,0000,0000,,Бір жерге шыққыңыз келе ме?
Dialogue: 0,1:11:56.87,1:11:57.85,JPsub,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,1:13:30.47,1:13:34.42,JPsub,NTP,0000,0000,0000,,Қамқорлықпен өсірсем де босқа
Dialogue: 0,1:14:22.76,1:14:23.59,JPsub,NTP,0000,0000,0000,,Жасаңыз
Dialogue: 0,1:14:27.75,1:14:32.61,JPsub,NTP,0000,0000,0000,,Мені жалғыз қалдыр да, нағыз өзіңе орал.
Dialogue: 0,1:14:33.55,1:14:35.38,JPsub,NTP,0000,0000,0000,,Екі рәсім
Dialogue: 0,1:14:36.19,1:14:37.07,JPsub,NTP,0000,0000,0000,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,1:14:54.79,1:14:57.19,JPsub,NTP,0000,0000,0000,,Мен сені кешірмеймін...
Dialogue: 0,1:14:58.91,1:15:00.98,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,1:15:29.04,1:15:30.63,JPsub,NTP,0000,0000,0000,,Бұл оның кінәсі
Dialogue: 0,1:15:34.97,1:15:37.23,JPsub,NTP,0000,0000,0000,,Ол рәсім және тоқыма
Dialogue: 0,1:15:37.59,1:15:40.77,JPsub,NTP,0000,0000,0000,,Бұл менің де, басқаның да арманы еді.
Dialogue: 0,1:15:41.74,1:15:47.36,JPsub,NTP,0000,0000,0000,,Тек қинайтын, ешқашан орындалмайтын арман
Dialogue: 0,1:16:00.56,1:16:01.50,JPsub,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,1:16:03.09,1:16:05.02,JPsub,NTP,0000,0000,0000,,Курогиримен бірге болу өте ауыр.
Dialogue: 0,1:16:05.82,1:16:08.53,JPsub,NTP,0000,0000,0000,,Мен саған қолымнан келмейтін нәрсені көрсетемін
Dialogue: 0,1:16:09.37,1:16:11.75,JPsub,NTP,0000,0000,0000,,Бұл мені тұрақсыз етеді.
Dialogue: 0,1:16:13.15,1:16:16.41,JPsub,NTP,0000,0000,0000,,Сондықтан мен сені өлтіруім керек.
Dialogue: 0,1:16:19.39,1:16:20.45,JPsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:16:21.74,1:16:23.45,JPsub,NTP,0000,0000,0000,,Мені өлтірме
Dialogue: 0,1:16:25.00,1:16:27.39,JPsub,NTP,0000,0000,0000,,Бірақ мен алмаймын.
Dialogue: 0,1:16:28.22,1:16:31.74,JPsub,NTP,0000,0000,0000,,Өйткені сен біздің арманымызсың
Dialogue: 0,1:16:32.36,1:16:33.20,JPsub,NTP,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,1:16:34.28,1:16:40.76,JPsub,NTP,0000,0000,0000,,Мен сені өшіре алмасам, жоқ болып кетуден басқа амалым жоқ.
Dialogue: 0,1:16:51.41,1:16:52.22,JPsub,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,1:16:53.82,1:16:57.49,JPsub,NTP,0000,0000,0000,,Мен сені өлтіре алмаймын
Dialogue: 0,1:16:59.22,1:17:02.70,JPsub,NTP,0000,0000,0000,,Бұл Оридің соңғы жүрегі.
Dialogue: 0,1:17:03.89,1:17:06.89,JPsub,NTP,0000,0000,0000,,Ори оны өлтіру арқылы ғана біреумен араласа алады.
Dialogue: 0,1:17:07.67,1:17:08.88,JPsub,NTP,0000,0000,0000,,Сөз
Dialogue: 0,1:17:10.07,1:17:13.54,JPsub,NTP,0000,0000,0000,,Айтқым келген адамға да айта алмадым
Dialogue: 0,1:17:15.28,1:17:16.17,JPsub,NTP,0000,0000,0000,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,1:17:17.41,1:17:18.42,JPsub,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:17:19.72,1:17:20.65,JPsub,NTP,0000,0000,0000,,Қайғылы
Dialogue: 0,1:17:33.60,1:17:36.25,JPsub,NTP,0000,0000,0000,,Не, сен әлі тірісің бе?
Dialogue: 0,1:17:39.18,1:17:44.16,JPsub,NTP,0000,0000,0000,,Токиори менің орныма өлді.
Dialogue: 0,1:17:45.14,1:17:48.65,JPsub,NTP,0000,0000,0000,,Бақытты өмір сүру туралы арманын қорғау
Dialogue: 0,1:17:54.09,1:17:56.90,JPsub,NTP,0000,0000,0000,,Мен туралы не сенуге болады?
Dialogue: 0,1:17:59.60,1:18:05.47,JPsub,NTP,0000,0000,0000,,Ешқандай дәлел болмаса да, мен формулаға сенуді жалғастырамын деп ойлаймын.
Dialogue: 0,1:18:07.28,1:18:11.35,JPsub,NTP,0000,0000,0000,,Мен сені жақсы көретіндіктен сенуді жалғастырғым келеді
Dialogue: 0,1:18:17.24,1:18:21.88,JPsub,NTP,0000,0000,0000,,Тоқуды жақсы көретін Микия Курогиридің арманы
Dialogue: 0,1:18:22.77,1:18:29.09,JPsub,NTP,0000,0000,0000,,Өлтіруді ғана білетін Ори бірінші рет кісі өлтіруден басқа эмоцияларға ие болды.
Dialogue: 0,1:18:30.21,1:18:33.57,JPsub,NTP,0000,0000,0000,,Әрқашан арман болсын
Dialogue: 0,1:18:34.70,1:18:39.25,JPsub,NTP,0000,0000,0000,,Ендеше, ең болмағанда...Мен оның Ориді есіне түсіргенін қалаймын.
Dialogue: 0,1:18:40.33,1:18:44.64,JPsub,NTP,0000,0000,0000,,Өйткені дәл қазір мен Оридің арманымын.
Dialogue: 0,1:19:15.72,1:19:16.84,JPsub,NTP,0000,0000,0000,,Үлкен аға
Dialogue: 0,1:19:32.32,1:19:37.25,JPsub,NTP,0000,0000,0000,,Әр адам өмірінде бір рет болса да біреуді өлтіруі керек.
Dialogue: 0,1:19:38.14,1:19:45.06,JPsub,NTP,0000,0000,0000,,Ақыр соңында өзімізді өлуге мүмкіндік беретін бір ғана мүмкіндігіміз бар.
Dialogue: 0,1:19:46.16,1:19:47.80,JPsub,NTP,0000,0000,0000,,Өзіңіз үшін
Dialogue: 0,1:19:48.38,1:19:53.26,JPsub,NTP,0000,0000,0000,,Бұл сіздің өміріңіз болғандықтан, ол сіздікі дегенді білдірмейді.
Dialogue: 0,1:19:53.51,1:19:55.18,JPsub,NTP,0000,0000,0000,,Сонымен, ата?
Dialogue: 0,1:19:55.42,1:19:57.52,JPsub,NTP,0000,0000,0000,,Меніңше, атам мұны істей алмайды.
Dialogue: 0,1:19:58.11,1:20:00.68,JPsub,NTP,0000,0000,0000,,Мен көп адамды өлтірдім.
Dialogue: 0,1:20:01.02,1:20:06.82,JPsub,NTP,0000,0000,0000,,Атаның өлімі оны бос қалдырады, оған қарайтын ешкім жоқ.
Dialogue: 0,1:20:07.10,1:20:08.91,JPsub,NTP,0000,0000,0000,,Тек бір рет
Dialogue: 0,1:20:09.39,1:20:13.88,JPsub,NTP,0000,0000,0000,,Аа, сіз тек бір рет өлтіре аласыз.
Dialogue: 0,1:20:14.55,1:20:18.54,JPsub,NTP,0000,0000,0000,,Біреуді өлтіріп, оны пайдаланатындар
Dialogue: 0,1:20:18.96,1:20:22.85,JPsub,NTP,0000,0000,0000,,Сіз өзіңізді мәңгілікке өлтіре алмайсыз
Dialogue: 0,1:20:23.22,1:20:25.45,JPsub,NTP,0000,0000,0000,,Мен адам болып өле алмаймын.
Dialogue: 0,1:20:26.20,1:20:28.38,JPsub,NTP,0000,0000,0000,,Ата, не болды?
Dialogue: 0,1:20:28.73,1:20:30.33,JPsub,NTP,0000,0000,0000,,Қоштасу рәсімі
Dialogue: 0,1:20:30.88,1:20:36.05,JPsub,NTP,0000,0000,0000,,Тым болмаса тыныш өлесің.
Dialogue: 0,1:20:36.84,1:20:39.53,JPsub,NTP,0000,0000,0000,,Ата, не болды?
Dialogue: 0,1:20:43.07,1:20:46.47,JPsub,NTP,0000,0000,0000,,Сәлем, ата.
Dialogue: 0,1:21:15.71,1:21:18.08,JPsub,NTP,0000,0000,0000,,Маған сенің көздеріңдегі көзқарас ұнайды
Dialogue: 0,1:21:18.75,1:21:22.01,JPsub,NTP,0000,0000,0000,,Өйткені, екі ырым да солай болуы керек.
Dialogue: 0,1:21:55.15,1:21:57.90,JPsub,NTP,0000,0000,0000,,Мен сенсіз жақсы емеспін
Dialogue: 0,1:22:18.73,1:22:23.20,JPsub,NTP,0000,0000,0000,,Бірақ сен мені кеше түнде де өлтіре алмадың.
Dialogue: 0,1:22:26.51,1:22:29.36,JPsub,NTP,0000,0000,0000,,Менен де кісі өлтірушісің.
Dialogue: 0,1:22:37.01,1:22:38.06,JPsub,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,1:22:50.59,1:22:53.97,JPsub,NTP,0000,0000,0000,,Мен ешқашан адам өлтірген емеспін.
Dialogue: 0,1:23:03.72,1:23:07.75,JPsub,NTP,0000,0000,0000,,Мен Арая сияқты адам емеспін. Мен оған қарсы ойнасам да, бұл жақсы емес.
Dialogue: 0,1:23:16.60,1:23:20.03,JPsub,NTP,0000,0000,0000,,Мен не істеп жатырмын?
Dialogue: 0,1:23:22.53,1:23:24.80,JPsub,NTP,0000,0000,0000,,Егер шынымен де кісі өлтіруші болса
Dialogue: 0,1:23:25.93,1:23:28.28,JPsub,NTP,0000,0000,0000,,Мен кісі өлтіруші емеспін
Dialogue: 0,1:23:30.73,1:23:32.34,JPsub,NTP,0000,0000,0000,,Мен қайтқым келеді
Dialogue: 0,1:23:33.64,1:23:36.10,JPsub,NTP,0000,0000,0000,,Мен онымен болған өмірді сүргім келеді.
Dialogue: 0,1:23:37.38,1:23:39.93,JPsub,NTP,0000,0000,0000,,Мен қалыпты өмір сүре алатынымды дәлелдегім келеді.
Dialogue: 0,1:23:43.45,1:23:48.07,JPsub,NTP,0000,0000,0000,,Мен кісі өлтірушімен істі шешуім керек.
Dialogue: 0,1:23:52.37,1:23:53.38,JPsub,NTP,0000,0000,0000,,Барлығы
Dialogue: 0,1:23:54.89,1:23:56.69,JPsub,NTP,0000,0000,0000,,Бұл оның кінәсі
Dialogue: 0,1:24:02.11,1:24:05.70,JPsub,NTP,0000,0000,0000,,Ол сонда болғандықтан, мен әлсіреп қалдым.
Dialogue: 0,1:24:09.10,1:24:13.50,JPsub,NTP,0000,0000,0000,,Ол болмаса мен кім болмас едім.
Dialogue: 0,1:24:19.59,1:24:27.60,JPsub,NTP,0000,0000,0000,,Сондықтан мен онсыз өмір сүре де алмаймын.
Dialogue: 0,1:24:41.52,1:24:43.80,JPsub,NTP,0000,0000,0000,,Нағыз ақымақ
Dialogue: 0,1:25:09.35,1:25:10.29,JPsub,NTP,0000,0000,0000,,Жаман ит
Dialogue: 0,1:25:31.99,1:25:35.07,JPsub,NTP,0000,0000,0000,,Сен келмесең, бәлеге қаламыз.
Dialogue: 0,1:25:56.32,1:25:57.50,JPsub,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,1:25:59.45,1:26:03.80,JPsub,NTP,0000,0000,0000,,Мен сізді байланыстыратын себепті бірден жоямын.
Dialogue: 0,1:26:52.42,1:26:53.51,JPsub,NTP,0000,0000,0000,,Бұл
Dialogue: 0,1:26:54.78,1:26:57.16,JPsub,NTP,0000,0000,0000,,Мен болғым келген жерде емес
Dialogue: 0,1:27:02.14,1:27:03.12,JPsub,NTP,0000,0000,0000,,Не болды, Ниа?
Dialogue: 0,1:27:04.52,1:27:05.98,JPsub,NTP,0000,0000,0000,,Мен үйге баруым керек
Dialogue: 0,1:27:09.04,1:27:10.39,JPsub,NTP,0000,0000,0000,,жеке үй
Dialogue: 0,1:27:11.68,1:27:16.09,JPsub,NTP,0000,0000,0000,,Мен сол жерге оралуым керек
Dialogue: 0,1:27:22.72,1:27:25.10,JPsub,NTP,0000,0000,0000,,Мен саған мені іздеме деп айтпадым ба?
Dialogue: 0,1:27:29.41,1:27:31.95,JPsub,NTP,0000,0000,0000,,Міне, осылай болады
Dialogue: 0,1:27:32.13,1:27:32.91,JPsub,NTP,0000,0000,0000,,Аға
Dialogue: 0,1:27:36.98,1:27:38.71,JPsub,NTP,0000,0000,0000,,Бірақ мен таң қалдым.
Dialogue: 0,1:27:38.86,1:27:41.73,JPsub,NTP,0000,0000,0000,,Қалғанның бәріне қыңырсың.
Dialogue: 0,1:27:44.48,1:27:47.25,JPsub,NTP,0000,0000,0000,,Ол менің төрт жыл бұрын өлтірген бірінші адам болды.
Dialogue: 0,1:27:47.43,1:27:49.98,JPsub,NTP,0000,0000,0000,,Ол бір ғана соққыдан кейін қайтыс болды.
Dialogue: 0,1:27:50.52,1:27:52.64,JPsub,NTP,0000,0000,0000,,Бір ғана соққы
Dialogue: 0,1:27:55.02,1:27:57.05,JPsub,NTP,0000,0000,0000,,Мен сені ұруым керек еді
Dialogue: 0,1:27:57.72,1:28:01.99,JPsub,NTP,0000,0000,0000,,Сонда мен де кісі өлтіруші болмас едім.
Dialogue: 0,1:28:05.46,1:28:07.61,JPsub,NTP,0000,0000,0000,,Бірақ мен де бақыттымын.
Dialogue: 0,1:28:08.55,1:28:12.49,JPsub,NTP,0000,0000,0000,,Сонда да сен мені іздедің
Dialogue: 0,1:28:13.34,1:28:17.54,JPsub,NTP,0000,0000,0000,,Өйткені, мен сіздің Ширазуми Риоға қарап тұрғаныңызды білдім.
Dialogue: 0,1:28:18.11,1:28:20.32,JPsub,NTP,0000,0000,0000,,Оны Рёгиге беру босқа кетеді.
Dialogue: 0,1:28:20.94,1:28:24.39,JPsub,NTP,0000,0000,0000,,Менің досым болғаныңды қалаймын.
Dialogue: 0,1:28:25.13,1:28:26.72,JPsub,NTP,0000,0000,0000,,Дос бола алмайсың.
Dialogue: 0,1:28:27.55,1:28:30.99,JPsub,NTP,0000,0000,0000,,Өйткені сіздің аға дәрігеріңіз ешқашан сәтті болмады, солай ма?
Dialogue: 0,1:28:31.87,1:28:34.70,JPsub,NTP,0000,0000,0000,,Мен сені соншалықты көп біледі деп ойламадым.
Dialogue: 0,1:28:35.07,1:28:38.03,JPsub,NTP,0000,0000,0000,,Куротоу Дұрыс айтасыз.
Dialogue: 0,1:28:38.45,1:28:41.49,JPsub,NTP,0000,0000,0000,,Мен өзім сияқты біреуді қалаймын.
Dialogue: 0,1:28:42.03,1:28:44.94,JPsub,NTP,0000,0000,0000,,Бірақ мұндай адамды тек Рёоги ғана емдей алады.
Dialogue: 0,1:28:45.53,1:28:48.41,JPsub,NTP,0000,0000,0000,,Сонда жалғыз нұсқа – оны жасанды түрде жасау.
Dialogue: 0,1:28:49.07,1:28:52.58,JPsub,NTP,0000,0000,0000,,Осы қоймаға отырғызылған қарасораны маған Арая берді.
Dialogue: 0,1:28:53.07,1:28:55.72,JPsub,NTP,0000,0000,0000,,Басқа каннабистерден аздап ерекшеленеді
Dialogue: 0,1:28:56.07,1:28:58.13,JPsub,NTP,0000,0000,0000,,Тәуелді емес және шыдамсыз
Dialogue: 0,1:28:58.47,1:29:00.98,JPsub,NTP,0000,0000,0000,,Бұл организмде ыдырамайтын улану.
Dialogue: 0,1:29:01.29,1:29:06.05,JPsub,NTP,0000,0000,0000,,Ондаған рет қайталасаң, ақылыңды мүлде жояды дейді.
Dialogue: 0,1:29:06.20,1:29:08.06,JPsub,NTP,0000,0000,0000,,Бұл өте жоғары дәрі.
Dialogue: 0,1:29:08.78,1:29:12.95,JPsub,NTP,0000,0000,0000,,Сонда сіз оған ондаған дозаны бергеннен кейін оған қан чипін бердіңіз бе?
Dialogue: 0,1:29:13.62,1:29:17.16,JPsub,NTP,0000,0000,0000,,Үміткерлердің бәрі үшін қателік.
Dialogue: 0,1:29:17.94,1:29:22.04,JPsub,NTP,0000,0000,0000,,Бұл арнайы жасалып, қаныма сіңген.
Dialogue: 0,1:29:23.19,1:29:25.54,JPsub,NTP,0000,0000,0000,,Кейбіреулері жай ғана есірткі;
Dialogue: 0,1:29:25.65,1:29:27.95,JPsub,NTP,0000,0000,0000,,Кейбіреулер шыдай алмай өлді.
Dialogue: 0,1:29:28.66,1:29:32.11,JPsub,NTP,0000,0000,0000,,Соған шыдасаң, мендей болып кетер едің.
Dialogue: 0,1:29:32.62,1:29:36.06,JPsub,NTP,0000,0000,0000,,Мен жегім келмеген мәйітті тастауға мәжбүр болдым.
Dialogue: 0,1:29:36.84,1:29:39.53,JPsub,NTP,0000,0000,0000,,Дүйсенбіде төрт адамның өліміне сіз жауапты болдыңыз.
Dialogue: 0,1:29:40.12,1:29:42.58,JPsub,NTP,0000,0000,0000,,А, бұл керемет болды.
Dialogue: 0,1:29:43.10,1:29:45.36,JPsub,NTP,0000,0000,0000,,Мен оны құшақтап, маған шабуыл жасауға рұқсат етсем де.
Dialogue: 0,1:29:45.67,1:29:48.27,JPsub,NTP,0000,0000,0000,,Рёги ешқашан шекарадан өткен емес
Dialogue: 0,1:29:48.77,1:29:51.96,JPsub,NTP,0000,0000,0000,,Бұл екі жағын да байлап тұрғандықтан.
Dialogue: 0,1:29:52.39,1:29:55.48,JPsub,NTP,0000,0000,0000,,Ақырында, сол дүниеде өмір сүргенше
Dialogue: 0,1:29:55.75,1:29:57.22,JPsub,NTP,0000,0000,0000,,Рёги мұнда келмейді
Dialogue: 0,1:29:57.74,1:30:01.89,JPsub,NTP,0000,0000,0000,,Онда не өлуден, не бұл дүниеге келуден басқа амалың жоқ.
Dialogue: 0,1:30:05.95,1:30:08.27,JPsub,NTP,0000,0000,0000,,Амал жоқ, амал жоқ, рәсім
Dialogue: 0,1:30:08.53,1:30:11.73,JPsub,NTP,0000,0000,0000,,Өзгелер туралы уайымдаудан гөрі өзіңді көбірек уайымда
Dialogue: 0,1:31:01.43,1:31:05.33,JPsub,NTP,0000,0000,0000,,Каннабистің қазір қалыпты 10 дозасы бар.
Dialogue: 0,1:31:07.21,1:31:09.23,JPsub,NTP,0000,0000,0000,,Мені жалғыз қалдырсаң, өлесің.
Dialogue: 0,1:31:24.54,1:31:26.35,JPsub,NTP,0000,0000,0000,,Мұны істе, Куротоу
Dialogue: 0,1:31:27.58,1:31:31.48,JPsub,NTP,0000,0000,0000,,Осыны істе де, өз еркіңмен осы дүниеге кел.
Dialogue: 0,1:31:33.72,1:31:36.58,JPsub,NTP,0000,0000,0000,,Мен сияқты ерекше болыңыз
Dialogue: 0,1:31:40.56,1:31:44.14,JPsub,NTP,0000,0000,0000,,Сіз не істеп жатырсыз? Бірдеңе жасамасаң, өлесің.
Dialogue: 0,1:32:02.23,1:32:03.73,JPsub,NTP,0000,0000,0000,,Сусын, Микия
Dialogue: 0,1:32:10.48,1:32:11.31,JPsub,NTP,0000,0000,0000,,Микия
Dialogue: 0,1:32:14.99,1:32:16.63,JPsub,NTP,0000,0000,0000,,Ішпесең өлесің.
Dialogue: 0,1:32:17.01,1:32:20.40,JPsub,NTP,0000,0000,0000,,Сіздің ағзаңыз жаңа қабылдаған дәрінің әсеріне төтеп бере алмайды.
Dialogue: 0,1:32:21.10,1:32:24.46,JPsub,NTP,0000,0000,0000,,Қарапайым адам болып өлу мен ерекше адам болып өмір сүрудің айырмашылығы бар.
Dialogue: 0,1:32:24.73,1:32:27.68,JPsub,NTP,0000,0000,0000,,Қайсысы жақсы екенін ойлаудың қажеті жоқ, неге?
Dialogue: 0,1:32:30.15,1:32:31.03,JPsub,NTP,0000,0000,0000,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,1:32:38.33,1:32:41.32,JPsub,NTP,0000,0000,0000,,Бұл қызық емес сияқты.
Dialogue: 0,1:32:44.28,1:32:47.65,JPsub,NTP,0000,0000,0000,,Мен кәдімгі аға болғанды ​​жөн көремін.
Dialogue: 0,1:32:48.56,1:32:52.56,JPsub,NTP,0000,0000,0000,,Ерекше болғым келмейді, ерекше болғым келмейді.
Dialogue: 0,1:32:54.96,1:32:58.59,JPsub,NTP,0000,0000,0000,,Сіз қалыпты емессіз. Сіз не ойласаңыз да, сіз біртүрлі екенсіз.
Dialogue: 0,1:32:58.89,1:33:00.84,JPsub,NTP,0000,0000,0000,,Біртүрлісі осы емес пе, Сенпай?
Dialogue: 0,1:33:01.62,1:33:04.09,JPsub,NTP,0000,0000,0000,,Біртүрлі болғанымен, өмір сүре білдің.
Dialogue: 0,1:33:04.49,1:33:09.09,JPsub,NTP,0000,0000,0000,,Адам өлтіріп жатсың, бірақ қылмысыңнан көзіңді бұрып қаштың.
Dialogue: 0,1:33:09.73,1:33:13.85,JPsub,NTP,0000,0000,0000,,Қалыпты емес адамның әдеттен тыс әрекеттер жасауы табиғи деп жалған сену.
Dialogue: 0,1:33:14.26,1:33:15.25,JPsub,NTP,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,1:33:16.62,1:33:20.06,JPsub,NTP,0000,0000,0000,,Сізді қанішер деп айту қате болды.
Dialogue: 0,1:33:20.57,1:33:21.60,JPsub,NTP,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,1:33:22.63,1:33:26.45,JPsub,NTP,0000,0000,0000,,Сізде өрнектердегідей ауыртпалық жоқ.
Dialogue: 0,1:33:27.74,1:33:29.93,JPsub,NTP,0000,0000,0000,,Сіз өрнекпен бірдей емессіз
Dialogue: 0,1:33:30.71,1:33:32.61,JPsub,NTP,0000,0000,0000,,Ол мүлдем керісінше.
Dialogue: 0,1:33:34.23,1:33:35.39,JPsub,NTP,0000,0000,0000,,Біреуді өлтіру
Dialogue: 0,1:33:36.01,1:33:38.73,JPsub,NTP,0000,0000,0000,,Күнәні өз күнәм деп мойындай да алмаймын.
Dialogue: 0,1:33:39.97,1:33:41.06,JPsub,NTP,0000,0000,0000,,Тек қашып кет
Dialogue: 0,1:33:41.32,1:33:44.84,JPsub,NTP,0000,0000,0000,,Кісі өлтірушінің аты аталмаған қашқыны
Dialogue: 0,1:33:46.79,1:33:50.54,JPsub,NTP,0000,0000,0000,,Бұл сенің шынайы болмысың, Сенпай.
Dialogue: 0,1:33:50.94,1:33:53.03,JPsub,NTP,0000,0000,0000,,Шулы, Куротори
Dialogue: 0,1:34:18.99,1:34:20.78,JPsub,NTP,0000,0000,0000,,Хаха...оның болғанына қуаныштымын.
Dialogue: 0,1:34:21.66,1:34:23.91,JPsub,NTP,0000,0000,0000,,Енді қалыпты жағдайға оралды
Dialogue: 0,1:35:06.38,1:35:09.37,JPsub,NTP,0000,0000,0000,,Бас бармақты негізден тістеп алу
Dialogue: 0,1:35:15.16,1:35:16.80,JPsub,NTP,0000,0000,0000,,Сіз ең жақсысыз
Dialogue: 0,1:35:17.63,1:35:20.04,JPsub,NTP,0000,0000,0000,,Ол мінсіз кісі өлтіруші.
Dialogue: 0,1:35:25.60,1:35:28.03,JPsub,NTP,0000,0000,0000,,Кеттік, Рёги.
Dialogue: 0,1:35:28.61,1:35:31.70,JPsub,NTP,0000,0000,0000,,Мен сені біреуді өлтіруге мәжбүр етемін
Dialogue: 0,1:35:32.47,1:35:34.18,JPsub,NTP,0000,0000,0000,,Келіңіздер.
Dialogue: 0,1:35:34.71,1:35:35.42,JPsub,NTP,0000,0000,0000,,Келіңіздер
Dialogue: 0,1:35:38.73,1:35:41.23,JPsub,NTP,0000,0000,0000,,Басқа біреуді ұр, мен мұны істемеймін
Dialogue: 0,1:35:42.27,1:35:44.04,JPsub,NTP,0000,0000,0000,,Не...
Dialogue: 0,1:35:44.99,1:35:48.62,JPsub,NTP,0000,0000,0000,,Саған уақытым жоқ дедім.
Dialogue: 0,1:36:15.24,1:36:17.77,JPsub,NTP,0000,0000,0000,,Сен де маған опасыздық жасайсың ба?
Dialogue: 0,1:36:18.12,1:36:19.80,JPsub,NTP,0000,0000,0000,,Мен бұған жол бермеймін.
Dialogue: 0,1:36:20.18,1:36:22.18,JPsub,NTP,0000,0000,0000,,Сіз үшін біреуді өлтіріңіз
Dialogue: 0,1:36:22.46,1:36:26.21,JPsub,NTP,0000,0000,0000,,Сен үшін осы уақытқа дейін келген мені тастап бара жатырсың ба?
Dialogue: 0,1:36:27.21,1:36:31.35,JPsub,NTP,0000,0000,0000,,Мен көремін. Сіз Микияға қайтасыз ба? Риоги.
Dialogue: 0,1:36:38.32,1:36:44.46,JPsub,NTP,0000,0000,0000,,Онда кетудің қажеті жоқ, ол дәл осында.
Dialogue: 0,1:36:57.05,1:36:59.41,JPsub,NTP,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,1:37:04.12,1:37:07.83,JPsub,NTP,0000,0000,0000,,Мен оны қайтарамын. Бұзғаным үшін кешірім сұраймын.
Dialogue: 0,1:37:18.37,1:37:22.14,JPsub,NTP,0000,0000,0000,,Әй, сен өлдің бе?
Dialogue: 0,1:37:46.89,1:37:48.63,JPsub,NTP,0000,0000,0000,,Мен оны өлтірдім.
Dialogue: 0,1:37:48.90,1:37:51.02,JPsub,NTP,0000,0000,0000,,Сіз еркін болуыңыз үшін
Dialogue: 0,1:37:51.81,1:37:53.08,JPsub,NTP,0000,0000,0000,,Микияның жігіті
Dialogue: 0,1:37:53.52,1:37:56.79,JPsub,NTP,0000,0000,0000,,Соңына дейін өзін жақсы адам етіп көрсетіп, уағыз айтты.
Dialogue: 0,1:37:57.79,1:38:01.78,JPsub,NTP,0000,0000,0000,,Идиот, сен Тоокомен кездесуге барамын дедің.
Dialogue: 0,1:37:57.20,1:38:00.50,JPsub,NTP,0000,0000,0000,,Күлкі болмаңыз, өйткені сіз бен біз мүлдем қарама-қарсымыз.
Dialogue: 0,1:38:01.03,1:38:04.23,JPsub,NTP,0000,0000,0000,,Екеуміздің бір-біріне ұқсап кеткендіктен ғой, ақымақ.
Dialogue: 0,1:38:02.75,1:38:04.79,JPsub,NTP,0000,0000,0000,,Мен ағамды өлтірсем, олар мені кешірмейді.
Dialogue: 0,1:38:05.12,1:38:06.39,JPsub,NTP,0000,0000,0000,,Ал сіз
Dialogue: 0,1:38:07.83,1:38:12.34,JPsub,NTP,0000,0000,0000,,Өлгенде де ақымақ болу саған тән нәрсе.
Dialogue: 0,1:38:25.61,1:38:27.49,JPsub,NTP,0000,0000,0000,,Жарайды, жасайық.
Dialogue: 0,1:38:32.07,1:38:33.92,JPsub,NTP,0000,0000,0000,,Сіз мені кешіре алмаймын дедіңіз.
Dialogue: 0,1:38:34.74,1:38:37.85,JPsub,NTP,0000,0000,0000,,Шынында да, біз бір жағынан ұқсаспыз.
Dialogue: 0,1:39:05.79,1:39:06.69,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,1:39:08.50,1:39:09.55,JPsub,NTP,0000,0000,0000,,Сізбен бірге
Dialogue: 0,1:39:10.38,1:39:11.78,JPsub,NTP,0000,0000,0000,,Жай ғана жымиып
Dialogue: 0,1:39:12.41,1:39:13.82,JPsub,NTP,0000,0000,0000,,Мен бақытты болдым
Dialogue: 0,1:39:33.57,1:39:34.62,JPsub,NTP,0000,0000,0000,,Сіздермен бірге
Dialogue: 0,1:39:35.48,1:39:36.81,JPsub,NTP,0000,0000,0000,,Жай жүру
Dialogue: 0,1:39:37.50,1:39:38.73,JPsub,NTP,0000,0000,0000,,Мен бақытты болдым
Dialogue: 0,1:40:07.44,1:40:09.89,JPsub,NTP,0000,0000,0000,,Бір күні екеуміз бір жерде болсақ екен
Dialogue: 0,1:40:10.35,1:40:11.60,JPsub,NTP,0000,0000,0000,,Сен күлдің
Dialogue: 0,1:40:16.66,1:40:18.26,JPsub,NTP,0000,0000,0000,,Осы сөздерді айта беріңіз
Dialogue: 0,1:40:19.49,1:40:21.50,JPsub,NTP,0000,0000,0000,,Маған біреу айтқанын қалаймын
Dialogue: 0,1:41:01.03,1:41:02.06,JPsub,NTP,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,1:41:03.32,1:41:04.38,JPsub,NTP,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,1:41:05.60,1:41:08.98,JPsub,NTP,0000,0000,0000,,Ол күндер түс сияқты болды.
Dialogue: 0,1:41:16.69,1:41:17.76,JPsub,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,1:41:20.83,1:41:23.26,JPsub,NTP,0000,0000,0000,,Бірақ кешіріңіз.
Dialogue: 0,1:41:24.75,1:41:27.32,JPsub,NTP,0000,0000,0000,,Мен бәрін жоғалтатынымды білемін
Dialogue: 0,1:41:28.25,1:41:29.17,JPsub,NTP,0000,0000,0000,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,1:41:33.04,1:41:33.91,JPsub,NTP,0000,0000,0000,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,1:41:35.95,1:41:38.44,JPsub,NTP,0000,0000,0000,,Мен сені өлтірген бұл жігітті кешіре алмаймын.
Dialogue: 0,1:42:58.94,1:43:00.16,JPsub,NTP,0000,0000,0000,,Жетеді
Dialogue: 0,1:43:01.64,1:43:04.15,JPsub,NTP,0000,0000,0000,,Мен үйге бұлай қарап бармаймын.
Dialogue: 0,1:43:05.93,1:43:10.24,JPsub,NTP,0000,0000,0000,,Үйге балшық болып барсам да ұрысады.
Dialogue: 0,1:43:22.20,1:43:25.76,JPsub,NTP,0000,0000,0000,,Сонда да сен мені күттің.
Dialogue: 0,1:43:27.64,1:43:30.12,JPsub,NTP,0000,0000,0000,,Түсімде сондай күн болды
Dialogue: 0,1:43:31.72,1:43:35.34,JPsub,NTP,0000,0000,0000,,Рас Бұл өтірік сияқты
Dialogue: 0,1:44:07.87,1:44:09.05,JPsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:44:12.37,1:44:13.30,JPsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:44:33.99,1:44:34.85,JPsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:44:40.59,1:44:43.47,JPsub,NTP,0000,0000,0000,,Егер сен ағаңды өлтірсең, мен сені кешірмеймін.
Dialogue: 0,1:44:44.31,1:44:46.24,JPsub,NTP,0000,0000,0000,,Егер сіз ағаңызды өлтірсеңіз
Dialogue: 0,1:44:51.17,1:44:53.64,JPsub,NTP,0000,0000,0000,,Себебі мен сенің бақытты болғаныңды қалаймын
Dialogue: 0,1:44:55.96,1:44:58.38,JPsub,NTP,0000,0000,0000,,Себебі мен сенің бұдан былай ренжігеніңді қаламаймын.
Dialogue: 0,1:45:03.33,1:45:06.96,JPsub,NTP,0000,0000,0000,,Себебі сен сені сүйесің
Dialogue: 0,1:46:06.58,1:46:07.57,JPsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:46:51.88,1:46:52.65,JPsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:47:24.19,1:47:26.03,JPsub,NTP,0000,0000,0000,,Пайдасыз
Dialogue: 0,1:47:38.79,1:47:41.08,JPsub,NTP,0000,0000,0000,,Сен жылап тұрсың ба, Курогири?
Dialogue: 0,1:47:49.79,1:47:51.94,JPsub,NTP,0000,0000,0000,,Мен Шираджунды өлтірдім.
Dialogue: 0,1:47:52.89,1:47:53.70,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:48:05.89,1:48:08.44,JPsub,NTP,0000,0000,0000,,Мен мұнымен көп нәрсені жоғалттым.
Dialogue: 0,1:48:09.12,1:48:10.79,JPsub,NTP,0000,0000,0000,,Бірақ бұл маңызды емес.
Dialogue: 0,1:48:12.67,1:48:16.55,JPsub,NTP,0000,0000,0000,,Мен саған оны алып кетемін дедім.
Dialogue: 0,1:48:17.83,1:48:20.20,JPsub,NTP,0000,0000,0000,,Иә, жаздың аяғында
Dialogue: 0,1:48:20.59,1:48:22.94,JPsub,NTP,0000,0000,0000,,Мен саған алғаш рет күлдім деп ант бердім
Dialogue: 0,1:48:27.35,1:48:30.19,JPsub,NTP,0000,0000,0000,,Мен сенің орныңда кінәні мойныма аламын.
Dialogue: 0,1:48:31.10,1:48:34.67,JPsub,NTP,0000,0000,0000,,Сондықтан мен сені өлтіремін
Dialogue: 0,1:48:36.57,1:48:39.86,JPsub,NTP,0000,0000,0000,,Өлгенше Өлгенше
Dialogue: 0,1:48:40.58,1:48:42.85,JPsub,NTP,0000,0000,0000,,Ешқашан өзіңізді жалғыз қалдырмаңыз
Dialogue: 0,1:48:46.05,1:48:48.36,JPsub,NTP,0000,0000,0000,,Мен кісі өлтіруші болсам да...
Dialogue: 0,1:48:51.35,1:48:53.93,JPsub,NTP,0000,0000,0000,,Мен саған біреуді өлтіру дұрыс емес дедім.
Dialogue: 0,1:48:54.57,1:48:57.85,JPsub,NTP,0000,0000,0000,,Бірақ сен оны қорғай алмаған ақымақсың.
Dialogue: 0,1:48:58.94,1:49:04.04,JPsub,NTP,0000,0000,0000,,Бұл жолы мен ашуландым. Ашуым бар деп жылаудың пайдасы жоқ.
Dialogue: 0,1:49:04.68,1:49:08.29,JPsub,NTP,0000,0000,0000,,Неге, жыласам да кешірмейсің.
Dialogue: 0,1:49:09.15,1:49:12.32,JPsub,NTP,0000,0000,0000,,А, сен міндетті түрде алданып қаласың.
Dialogue: 0,1:49:49.22,1:49:50.12,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:50:00.44,1:50:03.96,JPsub,NTP,0000,0000,0000,,Мен сені ешқашан жібермеймін
Dialogue: 0,0:00:00.00,0:00:00.00,JPsub,NTP,0000,0000,0000,,//ED
Dialogue: 0,1:56:42.25,1:56:46.70,JPsub,NTP,0000,0000,0000,,Сен мені көруге ешқашан келмедің.
Dialogue: 0,1:56:47.97,1:56:49.89,JPsub,NTP,0000,0000,0000,,Сенька маған ұрысты.
Dialogue: 0,1:56:50.51,1:56:53.56,JPsub,NTP,0000,0000,0000,,Аурухана бөлмесінде бетімді көрсетсем, мені өлтіретін.
Dialogue: 0,1:56:54.12,1:56:55.62,JPsub,NTP,0000,0000,0000,,Менің барғым келмейді.
Dialogue: 0,1:56:56.14,1:56:57.28,JPsub,NTP,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,1:56:59.10,1:57:00.20,JPsub,NTP,0000,0000,0000,,Сол көз
Dialogue: 0,1:57:02.01,1:57:03.91,JPsub,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,1:57:09.71,1:57:13.06,JPsub,NTP,0000,0000,0000,,Қараңызшы, дәл Шизунэ-чан айтқандай болып шықты.
Dialogue: 0,1:57:13.40,1:57:16.40,JPsub,NTP,0000,0000,0000,,Бұл болашақты көре алатын әйел туралы, есімде.
Dialogue: 0,1:57:16.78,1:57:22.70,JPsub,NTP,0000,0000,0000,,Иә, бала тойға аралассаң жаман жағдайға тап болады деді.
Dialogue: 0,1:57:23.35,1:57:26.34,JPsub,NTP,0000,0000,0000,,Пайғамбарлық орындалып, мен өте жаман оқиғаға тап болдым.
Dialogue: 0,1:57:27.27,1:57:29.21,JPsub,NTP,0000,0000,0000,,Сіз кенеттен не істеп жатырсыз?
Dialogue: 0,1:57:30.29,1:57:32.81,JPsub,NTP,0000,0000,0000,,Не, бұл балдақтың орнын басатын ба?
Dialogue: 0,1:57:33.76,1:57:35.12,JPsub,NTP,0000,0000,0000,,Бір апта қалды
Dialogue: 0,1:57:35.37,1:57:36.96,JPsub,NTP,0000,0000,0000,,Мен оны формулаға қалдырамын.
Dialogue: 0,1:57:39.62,1:57:42.18,JPsub,NTP,0000,0000,0000,,Неліктен мен мұны істеуім керек?
Dialogue: 0,1:57:42.84,1:57:44.06,JPsub,NTP,0000,0000,0000,,Себебі мен сені қалаймын
Dialogue: 0,1:57:45.05,1:57:46.66,JPsub,NTP,0000,0000,0000,,Ұнамаса, жақсы.
Dialogue: 0,1:57:49.11,1:57:51.04,JPsub,NTP,0000,0000,0000,,Маған ерекше ұнамайды.
Dialogue: 0,1:57:51.89,1:57:55.34,JPsub,NTP,0000,0000,0000,,Бірақ менде ертеңнен бастап мектеп бар.
Dialogue: 0,1:57:56.10,1:57:57.40,JPsub,NTP,0000,0000,0000,,Бұлай жасамаңыз.
Dialogue: 0,1:57:57.71,1:57:58.70,JPsub,NTP,0000,0000,0000,,Бұл сенсің
Dialogue: 0,1:58:04.12,1:58:08.10,JPsub,NTP,0000,0000,0000,,Мен күлдім, өйткені сіз әлсіреу туралы әдеттен тыс нәрсе айттыңыз.
Dialogue: 0,1:58:09.03,1:58:11.05,JPsub,NTP,0000,0000,0000,,Сіз өзімшіл адамсыз.
Dialogue: 0,1:58:13.68,1:58:14.69,JPsub,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,1:58:15.50,1:58:19.42,JPsub,NTP,0000,0000,0000,,Мен сені ұната бастағаныма көп жыл болды.
Dialogue: 0,1:58:20.35,1:58:21.01,JPsub,NTP,0000,0000,0000,,Қазір де
Dialogue: 0,1:58:21.86,1:58:26.14,JPsub,NTP,0000,0000,0000,,Сондықтан мен Шикиге ұнамаса да қамқорлық жасауды шештім.
Dialogue: 0,1:58:30.31,1:58:32.59,JPsub,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,1:58:32.83,1:58:34.35,JPsub,NTP,0000,0000,0000,,Мұндай жолдар жақсы емес пе?
Dialogue: 0,1:58:35.34,1:58:38.03,JPsub,NTP,0000,0000,0000,,Осы уақытқа дейін сіз өзіңізді өте нашар деп айттыңыз, солай ма?
Dialogue: 0,1:58:38.89,1:58:40.22,JPsub,NTP,0000,0000,0000,,Шынында да.
Dialogue: 0,1:58:44.90,1:58:46.39,JPsub,NTP,0000,0000,0000,,Сондықтан Микия
Dialogue: 0,1:58:47.23,1:58:51.69,JPsub,NTP,0000,0000,0000,,Мен бұлай айтуды жек көрмейтінімді айттым.
Dialogue: 0,1:59:04.08,1:59:05.70,JPsub,NTP,0000,0000,0000,,Келесі кезекте біз
Dialogue: 0,1:59:07.93,1:59:11.75,JPsub,NTP,0000,0000,0000,,Менің қалағаным пышақ немесе басқа нәрсе емес еді.
Dialogue: 0,1:59:12.36,1:59:14.30,JPsub,NTP,0000,0000,0000,,Бұл жай ғана алақан еді.
Dialogue: 0,1:59:15.60,1:59:20.80,JPsub,NTP,0000,0000,0000,,Болашақта не болса да, мен бұл қолды ешқашан жібермеймін деп ойлаймын.
Dialogue: 0,1:59:22.29,1:59:25.04,JPsub,NTP,0000,0000,0000,,Сонымен менің әңгімем аяқталды.
Dialogue: 0,1:59:25.94,1:59:30.91,JPsub,NTP,0000,0000,0000,,Мен өзімді қазіргідей және бұрынғыдай қабылдай аламын.
Dialogue: 0,1:59:31.45,1:59:33.29,JPsub,NTP,0000,0000,0000,,Күнделікті өмір сүру
Dialogue: 0,0:00:43.14,0:00:45.48,CNsub,NTP,0000,0000,0000,,Менің үйден шыққым келмейді.
Dialogue: 0,0:00:48.63,0:00:49.38,CNsub,NTP,0000,0000,0000,,Суық сүйгіш Суық сүйгіш
Dialogue: 0,0:00:50.21,0:00:52.60,CNsub,NTP,0000,0000,0000,,Meimei тікелей қолданатын қасық аяқталды.
Dialogue: 0,0:01:04.82,0:01:05.94,CNsub,NTP,0000,0000,0000,,Бұл Надунсидің оқиғасы ма?
Dialogue: 0,0:01:07.32,0:01:08.49,CNsub,NTP,0000,0000,0000,,Оранж ханымның жеке профилі
Dialogue: 0,0:01:09.05,0:01:11.80,CNsub,NTP,0000,0000,0000,,Мен оны соңғы рет көргендіктен, бұл көрмеге қойылған зергерлік бұйымдар.
Dialogue: 0,0:01:22.01,0:01:23.58,CNsub,NTP,0000,0000,0000,,Сіз қонақсыз ба?
Dialogue: 0,0:01:24.02,0:01:27.77,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:28.62,0:01:31.65,CNsub,NTP,0000,0000,0000,,Ай сайынғы орындалған жұмысқа шолу.
Dialogue: 0,0:01:32.30,0:01:33.00,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:01:33.90,0:01:35.13,CNsub,NTP,0000,0000,0000,,Енді не қалайсыз?
Dialogue: 0,0:01:36.06,0:01:38.38,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:39.01,0:01:39.76,CNsub,NTP,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:01:43.42,0:01:45.65,CNsub,NTP,0000,0000,0000,,Айырмашылықты ұмытыңыз.
Dialogue: 0,0:01:46.31,0:01:47.68,CNsub,NTP,0000,0000,0000,,Міндетті айқайлау керек пе? өте жылы жүрек
Dialogue: 0,0:01:49.17,0:01:51.56,CNsub,NTP,0000,0000,0000,,Тәтті есептеу аяқталды
Dialogue: 0,0:01:52.48,0:01:54.84,CNsub,NTP,0000,0000,0000,,Бұл көңіл көтерудің ең жақсы тәсілі.
Dialogue: 0,0:02:04.28,0:02:05.67,CNsub,NTP,0000,0000,0000,,Директорды өзгерту
Dialogue: 0,0:02:05.95,0:02:06.91,CNsub,NTP,0000,0000,0000,,Ұсақ бопсалау
Dialogue: 0,0:02:19.99,0:02:21.08,CNsub,NTP,0000,0000,0000,,Жақсы және жылы үйлесімділік
Dialogue: 0,0:02:45.39,0:02:47.21,CNsub,NTP,0000,0000,0000,,Қар
Dialogue: 0,0:02:48.51,0:02:52.26,CNsub,NTP,0000,0000,0000,,Юкияказу Куросукэнің алғашқы пайда болуы
Dialogue: 0,0:00:00.00,0:00:00.00,CNsub,NTP,0000,0000,0000,,//ОП
Dialogue: 0,0:04:53.59,0:04:55.58,CNsub,NTP,0000,0000,0000,,Каня
Dialogue: 0,0:04:56.40,0:04:58.90,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:00.22,0:05:03.69,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:11.05,0:05:12.03,CNsub,NTP,0000,0000,0000,,Мама…
Dialogue: 0,0:05:21.93,0:05:25.36,CNsub,NTP,0000,0000,0000,,Сіз оны қайтадан сатып ала аласыз ба?
Dialogue: 0,0:05:25.71,0:05:29.56,CNsub,NTP,0000,0000,0000,,Сатып алмау, сатып алмау.
Dialogue: 0,0:05:29.73,0:05:31.92,CNsub,NTP,0000,0000,0000,,Манья Сороның өлімі
Dialogue: 0,0:05:32.50,0:05:34.10,CNsub,NTP,0000,0000,0000,,～
Dialogue: 0,0:05:43.00,0:05:43.79,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:05:44.86,0:05:46.05,CNsub,NTP,0000,0000,0000,,Күнтізбе
Dialogue: 0,0:05:46.45,0:05:49.95,CNsub,NTP,0000,0000,0000,,Накако, топтан шыққан адамның оқиғасы.
Dialogue: 0,0:05:52.44,0:05:53.35,CNsub,NTP,0000,0000,0000,,Алдын ала отставкаға кету
Dialogue: 0,0:05:58.60,0:05:59.72,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз
Dialogue: 0,0:06:20.19,0:06:23.01,CNsub,NTP,0000,0000,0000,,Бастапқы үкім шығарылғанға дейін бірлескен кісі өлтіру ісі бірдей кінәлі болып табылады.
Dialogue: 0,0:06:23.14,0:06:24.41,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта бақылауда
Dialogue: 0,0:06:25.48,0:06:28.66,CNsub,NTP,0000,0000,0000,,Қалаға байланысты 7 құрбан болды.
Dialogue: 0,0:06:28.99,0:06:31.71,CNsub,NTP,0000,0000,0000,,Төрт жыл бұрын 13 адам
Dialogue: 0,0:06:32.86,0:06:35.77,CNsub,NTP,0000,0000,0000,,Адам өлтірудің және тұрақты шабуылдың заңсыз алдын алу
Dialogue: 0,0:06:36.16,0:06:37.77,CNsub,NTP,0000,0000,0000,,Полицияның болуы немесе болмауының сәйкессіздігі
Dialogue: 0,0:06:38.11,0:06:42.34,CNsub,NTP,0000,0000,0000,,Тергеу соңғы төрт жыл бойы жүргізілді...
Dialogue: 0,0:06:42.41,0:06:44.28,CNsub,NTP,0000,0000,0000,,Бұл кісі өлтірушінің ессіздігі, Каня
Dialogue: 0,0:06:44.63,0:06:47.10,CNsub,NTP,0000,0000,0000,,10 немесе одан да көп қудалау құрбандары
Dialogue: 0,0:06:47.93,0:06:50.96,CNsub,NTP,0000,0000,0000,,Дегенмен, «өлтіруші ессіздік» айқайлау әдісі ұсынылмайды.
Dialogue: 0,0:06:51.17,0:06:54.19,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:55.27,0:06:57.50,CNsub,NTP,0000,0000,0000,,Бұл қалай болды?
Dialogue: 0,0:06:57.95,0:07:00.77,CNsub,NTP,0000,0000,0000,,「」
Dialogue: 0,0:07:01.61,0:07:04.77,CNsub,NTP,0000,0000,0000,,Қылмыскердің аты да жоғары.
Dialogue: 0,0:07:05.40,0:07:07.63,CNsub,NTP,0000,0000,0000,,«Өлтіруші ессіздікке» сұраныстың болмауының себебі
Dialogue: 0,0:07:08.06,0:07:12.49,CNsub,NTP,0000,0000,0000,,Жәбірленуші жарақат алған жағдайда ғана солға немесе оңға бұрыла алады.
Dialogue: 0,0:07:13.07,0:07:15.74,CNsub,NTP,0000,0000,0000,,Демек, марқұм отбасында қайтыс болды.
Dialogue: 0,0:07:16.25,0:07:19.68,CNsub,NTP,0000,0000,0000,,Өлген адам? Бұл кісі өлтіруші ме?
Dialogue: 0,0:07:20.40,0:07:23.01,CNsub,NTP,0000,0000,0000,,Өлтіру мен бауыздау бір нәрсе емес.
Dialogue: 0,0:07:24.35,0:07:25.98,CNsub,NTP,0000,0000,0000,,Жазуға бола ма? қара пауловния
Dialogue: 0,0:07:27.18,0:07:30.72,CNsub,NTP,0000,0000,0000,,Адамның өмірі бір ғана өлім.
Dialogue: 0,0:07:31.99,0:07:33.73,CNsub,NTP,0000,0000,0000,,Бір ғана адам өлтірілді...
Dialogue: 0,0:07:37.55,0:07:40.41,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:07:41.26,0:07:42.45,CNsub,NTP,0000,0000,0000,,Бірінші ас
Dialogue: 0,0:07:42.78,0:07:43.46,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:07:43.76,0:07:47.87,CNsub,NTP,0000,0000,0000,,Бақша оқиғасынан кейін жапон стиліндегі мейрамханаға оралдыңыз ба?
Dialogue: 0,0:07:48.02,0:07:49.08,CNsub,NTP,0000,0000,0000,,Фука…
Dialogue: 0,0:07:49.52,0:07:54.59,CNsub,NTP,0000,0000,0000,,Бір қызығы, жапон стиліндегі мейрамхана бұрын есімде.
Dialogue: 0,0:07:54.96,0:07:57.58,CNsub,NTP,0000,0000,0000,,Мен бірінші гүлді өлтіруді шештім.
Dialogue: 0,0:07:57.93,0:08:00.06,CNsub,NTP,0000,0000,0000,,Нағыз жою әдісі Мен шындықты түсіндім
Dialogue: 0,0:08:00.29,0:08:02.77,CNsub,NTP,0000,0000,0000,,Қайтып келу
Dialogue: 0,0:08:02.93,0:08:04.26,CNsub,NTP,0000,0000,0000,,Осы жерден бастау керек.
Dialogue: 0,0:08:19.62,0:08:22.41,CNsub,NTP,0000,0000,0000,,Өлу ықтималдығы жоғары
Dialogue: 0,0:08:24.04,0:08:29.90,CNsub,NTP,0000,0000,0000,,Жергілікті жерге барғанымда маған «адам жегіш маньяк» деген диагноз қойылды.
Dialogue: 0,0:08:31.27,0:08:32.93,CNsub,NTP,0000,0000,0000,,Нағыз қатыгездік
Dialogue: 0,0:08:33.74,0:08:35.36,CNsub,NTP,0000,0000,0000,,Дегенмен, алдыңғы әңгімелердің бірі
Dialogue: 0,0:08:35.65,0:08:39.62,CNsub,NTP,0000,0000,0000,,Адам денесінің физикалық күйі көрінбейді.
Dialogue: 0,0:08:40.19,0:08:42.19,CNsub,NTP,0000,0000,0000,,Мен көріп тұрған сурет категорияға жатады
Dialogue: 0,0:08:42.65,0:08:43.78,CNsub,NTP,0000,0000,0000,,Таптым.
Dialogue: 0,0:09:38.27,0:09:40.19,CNsub,NTP,0000,0000,0000,,Бүгін кешке мен ұйықтап жатырмын
Dialogue: 0,0:09:42.64,0:09:43.36,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:10:38.34,0:10:40.08,CNsub,NTP,0000,0000,0000,,Нага бірінші жарысы аяқталды
Dialogue: 0,0:10:42.86,0:10:43.48,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:11:23.60,0:11:24.30,CNsub,NTP,0000,0000,0000,,Апельсин апа
Dialogue: 0,0:11:24.96,0:11:25.68,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:11:26.58,0:11:28.40,CNsub,NTP,0000,0000,0000,,Мен бірінші жүгірдім бе?
Dialogue: 0,0:11:36.86,0:11:39.50,CNsub,NTP,0000,0000,0000,,Теня Кадзюошики Нари ме?
Dialogue: 0,0:11:46.23,0:11:49.25,CNsub,NTP,0000,0000,0000,,Төрт жыл бұрынғы оқиғадан кейінгі «Кісі өлтіру маниясы».
Dialogue: 0,0:11:54.19,0:11:57.40,CNsub,NTP,0000,0000,0000,,Қара тунгты көріп тұрсың ба?
Dialogue: 0,0:11:57.92,0:12:00.36,CNsub,NTP,0000,0000,0000,,Кеше түнде солай болды.
Dialogue: 0,0:12:00.68,0:12:01.59,CNsub,NTP,0000,0000,0000,,Өткен оқиғалар да
Dialogue: 0,0:12:02.33,0:12:07.29,CNsub,NTP,0000,0000,0000,,Физикалық жағдай белгілі болғандықтан уақытты анықтау қиын.
Dialogue: 0,0:12:08.46,0:12:11.16,CNsub,NTP,0000,0000,0000,,Шамамен белгілі бір күндер
Dialogue: 0,0:12:14.37,0:12:16.67,CNsub,NTP,0000,0000,0000,,Бірақ...
Dialogue: 0,0:12:16.83,0:12:18.46,CNsub,NTP,0000,0000,0000,,Сөздің бар немесе жоқтығын куәландыру
Dialogue: 0,0:12:21.06,0:12:22.71,CNsub,NTP,0000,0000,0000,,Табыс оқиғалары туралы анекдоттық әңгімелер
Dialogue: 0,0:12:23.40,0:12:25.35,CNsub,NTP,0000,0000,0000,,Жетпейді
Dialogue: 0,0:12:26.95,0:12:28.36,CNsub,NTP,0000,0000,0000,,Сіз реттеуге болады
Dialogue: 0,0:12:29.69,0:12:31.85,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл жанама әсері жоқ өрнек.
Dialogue: 0,0:12:33.32,0:12:35.85,CNsub,NTP,0000,0000,0000,,Хики негізінен жерді растау стилі мөлдір ақ
Dialogue: 0,0:12:36.64,0:12:40.19,CNsub,NTP,0000,0000,0000,,Негізгі сұраққа қатысты сұрақтарыңыз болса, Black Tung
Dialogue: 0,0:12:41.88,0:12:42.81,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:43.52,0:12:48.44,CNsub,NTP,0000,0000,0000,,Физикалық дененің аяқталуы және ер тұлғасының аяқталуы
Dialogue: 0,0:12:50.89,0:12:55.39,CNsub,NTP,0000,0000,0000,,Мен комадан оянғаннан кейін толығымен өзгеріп, жалғыз қалдым.
Dialogue: 0,0:12:56.09,0:13:01.94,CNsub,NTP,0000,0000,0000,,Бұл кезде екі денеде де кісі өлтірушінің тұлғасы жойылады.
Dialogue: 0,0:13:02.80,0:13:07.16,CNsub,NTP,0000,0000,0000,,Демек, бұл шынайы сұрақ.
Dialogue: 0,0:13:08.07,0:13:12.83,CNsub,NTP,0000,0000,0000,,«Біреуді қайтадан өлтіру мүмкін емес пе?»
Dialogue: 0,0:13:14.36,0:13:15.46,CNsub,NTP,0000,0000,0000,,Өзімшілдік
Dialogue: 0,0:13:17.37,0:13:19.86,CNsub,NTP,0000,0000,0000,,Дегенмен, ағымдағы өрнек те бірдей...
Dialogue: 0,0:13:20.85,0:13:22.92,CNsub,NTP,0000,0000,0000,,Ауыстыру
Dialogue: 0,0:13:23.75,0:13:26.00,CNsub,NTP,0000,0000,0000,,Васасаками Фуджино оқиғасы кезінде
Dialogue: 0,0:13:26.94,0:13:31.04,CNsub,NTP,0000,0000,0000,,Ешқашан кетпейтін өмір тарихы;
Dialogue: 0,0:13:31.84,0:13:35.26,CNsub,NTP,0000,0000,0000,,Бұл жай ғана қауіпті бағыт.
Dialogue: 0,0:13:36.10,0:13:38.47,CNsub,NTP,0000,0000,0000,,Әңгімелесу
Dialogue: 0,0:13:38.92,0:13:41.18,CNsub,NTP,0000,0000,0000,,Келуге 24 сағат кетті.
Dialogue: 0,0:13:41.71,0:13:42.55,CNsub,NTP,0000,0000,0000,,Еріксіз араласу
Dialogue: 0,0:13:50.10,0:13:51.58,CNsub,NTP,0000,0000,0000,,Жаңалықтар жақында келеді
Dialogue: 0,0:13:51.96,0:13:53.79,CNsub,NTP,0000,0000,0000,,Сяохутунг-ри, Канфубей қаласы, Канбузи қаласы
Dialogue: 0,0:13:54.15,0:13:56.97,CNsub,NTP,0000,0000,0000,,Кісі өлтіру ісінің жаңа құрбаны
Dialogue: 0,0:13:57.96,0:14:01.24,CNsub,NTP,0000,0000,0000,,Кісі өлтіру ісінің жаңа құрбаны
Dialogue: 0,0:14:02.22,0:14:03.61,CNsub,NTP,0000,0000,0000,,Мәселенің түбірі туралы ақпарат
Dialogue: 0,0:14:04.03,0:14:05.41,CNsub,NTP,0000,0000,0000,,Зиян келтіруге құқығы жоқ жалғыз жәбірленуші
Dialogue: 0,0:14:05.81,0:14:07.92,CNsub,NTP,0000,0000,0000,,Қанның көп мөлшері бар
Dialogue: 0,0:14:08.31,0:14:11.13,CNsub,NTP,0000,0000,0000,,Жәбірленушінің қолдары, қолдары, аяқтары, балтырлары мен тобықтары кесіледі.
Dialogue: 0,0:14:12.43,0:14:14.54,CNsub,NTP,0000,0000,0000,,Жәбірленушінің өлімін растау
Dialogue: 0,0:14:15.73,0:14:18.81,CNsub,NTP,0000,0000,0000,,Жәбірленушіні физикалық тексеру және жарақаттан кейінгі уақыт ұзақтығы
Dialogue: 0,0:14:19.10,0:14:22.45,CNsub,NTP,0000,0000,0000,,Қылмыскер жасырынуы мүмкін жердің жанында
Dialogue: 0,0:14:22.77,0:14:26.05,CNsub,NTP,0000,0000,0000,,Бұл аумақта полиция қызметкерлері жоғары дайындықта.
Dialogue: 0,0:14:26.91,0:14:28.01,CNsub,NTP,0000,0000,0000,,Джуджуй Иппен
Dialogue: 0,0:14:28.84,0:14:30.43,CNsub,NTP,0000,0000,0000,,Жаңалықтар жақында келеді
Dialogue: 0,0:14:30.78,0:14:32.50,CNsub,NTP,0000,0000,0000,,Сяохутунг-ри, Гуанфубей қаласы, Гуанбузи қаласы…
Dialogue: 0,0:14:17.90,0:14:19.07,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:14:19.18,0:14:21.27,CNsub,NTP,0000,0000,0000,,Телефон қоңырауының күйі
Dialogue: 0,0:14:21.94,0:14:28.80,CNsub,NTP,0000,0000,0000,,「」
Dialogue: 0,0:14:40.95,0:14:41.57,CNsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,0:14:57.05,0:14:58.02,CNsub,NTP,0000,0000,0000,,Төрт жыл бұрын...
Dialogue: 0,0:14:58.84,0:15:02.27,CNsub,NTP,0000,0000,0000,,Мен өзімді қанішер деп жарияладым.
Dialogue: 0,0:15:03.60,0:15:04.82,CNsub,NTP,0000,0000,0000,,Тадина – адам баласы.
Dialogue: 0,0:15:06.05,0:15:07.88,CNsub,NTP,0000,0000,0000,,Кісі өлтіруші
Dialogue: 0,0:15:08.89,0:15:10.40,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:11.49,0:15:14.41,CNsub,NTP,0000,0000,0000,,Мен тікелей қалаға барғым келмейді.
Dialogue: 0,0:15:15.56,0:15:16.39,CNsub,NTP,0000,0000,0000,,Корреспонденцияны қабылдау…
Dialogue: 0,0:16:07.09,0:16:08.93,CNsub,NTP,0000,0000,0000,,Қара тунг…оны осы жерден оқи аласыз
Dialogue: 0,0:16:09.45,0:16:10.32,CNsub,NTP,0000,0000,0000,,Қара тунг!
Dialogue: 0,0:16:11.64,0:16:16.96,CNsub,NTP,0000,0000,0000,,Мен...мен...күтпеген өлім...
Dialogue: 0,0:16:23.01,0:16:25.76,CNsub,NTP,0000,0000,0000,,Мен...Мен өлімді ойладым.
Dialogue: 0,0:16:34.61,0:16:35.94,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:17:04.93,0:17:05.97,CNsub,NTP,0000,0000,0000,,Ақымақ
Dialogue: 0,0:17:08.39,0:17:11.65,CNsub,NTP,0000,0000,0000,,Менің үмітім үзілмейді.
Dialogue: 0,0:17:31.67,0:17:34.24,CNsub,NTP,0000,0000,0000,,Мен жауаптымын.
Dialogue: 0,0:17:35.29,0:17:37.66,CNsub,NTP,0000,0000,0000,,Нәтижесінде қайтыс болған адам әлі тірі.
Dialogue: 0,0:17:37.80,0:17:38.98,CNsub,NTP,0000,0000,0000,,Наяның жұмысы аяқталды
Dialogue: 0,0:17:39.33,0:17:43.01,CNsub,NTP,0000,0000,0000,,Алайда қашып кеткен адам өлтірілді.
Dialogue: 0,0:17:43.86,0:17:46.40,CNsub,NTP,0000,0000,0000,,Тағы бір төмен өзіндік өмір сүру
Dialogue: 0,0:17:47.16,0:17:50.20,CNsub,NTP,0000,0000,0000,,Сіз тек жеке адамға тиесілісіз.
Dialogue: 0,0:17:51.19,0:17:53.06,CNsub,NTP,0000,0000,0000,,Өндіріс құрылымы
Dialogue: 0,0:17:53.57,0:17:55.98,CNsub,NTP,0000,0000,0000,,Жеке емдеудің аяқталуы
Dialogue: 0,0:17:56.59,0:18:02.24,CNsub,NTP,0000,0000,0000,,Қарама-қайшы спиральдық дарындылық синонимдік қорытынды
Dialogue: 0,0:18:08.97,0:18:10.27,CNsub,NTP,0000,0000,0000,,Оны оқып берейін.
Dialogue: 0,0:18:12.03,0:18:12.82,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:18:17.25,0:18:17.95,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:18:22.45,0:18:26.55,CNsub,NTP,0000,0000,0000,,Қазіргі жойылу жағдайы әлі ерте.
Dialogue: 0,0:18:35.36,0:18:38.93,CNsub,NTP,0000,0000,0000,,Күннің соңында қалпына келтірудің бірегей жолы
Dialogue: 0,0:18:39.55,0:18:41.09,CNsub,NTP,0000,0000,0000,,Таңдау аяқталды.
Dialogue: 0,0:18:42.56,0:18:44.14,CNsub,NTP,0000,0000,0000,,Түзетуші таңдау нұсқаулығы
Dialogue: 0,0:18:44.74,0:18:46.40,CNsub,NTP,0000,0000,0000,,Менің қазір өлгенім көрініп тұр
Dialogue: 0,0:19:31.29,0:19:32.24,CNsub,NTP,0000,0000,0000,,Қара пауловния...
Dialogue: 0,0:21:49.99,0:21:51.81,CNsub,NTP,0000,0000,0000,,Мен бұл елден қайдан келдім
Dialogue: 0,0:21:52.06,0:21:54.40,CNsub,NTP,0000,0000,0000,,Бұл сіз Араяның бұйрығын алғаныңыз үшін.
Dialogue: 0,0:21:54.92,0:21:59.04,CNsub,NTP,0000,0000,0000,,Екі жыл бұрын ұмытып кеткен бір естелік.
Dialogue: 0,0:22:00.45,0:22:02.55,CNsub,NTP,0000,0000,0000,,Ауыр күрсіну
Dialogue: 0,0:22:03.03,0:22:04.69,CNsub,NTP,0000,0000,0000,,Ұмыту және ұмыту
Dialogue: 0,0:22:05.10,0:22:08.63,CNsub,NTP,0000,0000,0000,,Дыбыс шыққанда есте сақтау да расталды.
Dialogue: 0,0:22:15.44,0:22:17.88,CNsub,NTP,0000,0000,0000,,Телефон қоңырауының күйі
Dialogue: 0,0:22:18.57,0:22:25.77,CNsub,NTP,0000,0000,0000,,「」
Dialogue: 0,0:22:29.39,0:22:30.29,CNsub,NTP,0000,0000,0000,,Мен қара пауловниямын
Dialogue: 0,0:22:30.81,0:22:32.43,CNsub,NTP,0000,0000,0000,,Жақсы мүсін дүниеден өтті
Dialogue: 0,0:22:33.07,0:22:34.77,CNsub,NTP,0000,0000,0000,,Қосымша ақпарат алу үшін маған хабарласыңыз.
Dialogue: 0,0:22:35.37,0:22:36.41,CNsub,NTP,0000,0000,0000,,Гадокай Учирай
Dialogue: 0,0:22:37.57,0:22:42.93,CNsub,NTP,0000,0000,0000,,8 ақпан, 14:00, 4 ұпай, 33 минут
Dialogue: 0,0:22:43.46,0:22:46.42,CNsub,NTP,0000,0000,0000,,Иә 17-бап Ескерту
Dialogue: 0,0:23:17.65,0:23:18.47,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:23:20.29,0:23:22.64,CNsub,NTP,0000,0000,0000,,Сіз күнде түнде қаладасыз ба?
Dialogue: 0,0:23:23.98,0:23:26.16,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:23:26.70,0:23:29.22,CNsub,NTP,0000,0000,0000,,Істің келгеніне қанша уақыт болды?
Dialogue: 0,0:23:29.73,0:23:30.80,CNsub,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:23:38.66,0:23:42.94,CNsub,NTP,0000,0000,0000,,Үш жыл бұрын мен өзімнің резиденциямның алдында болған жоқпын.
Dialogue: 0,0:23:44.60,0:23:47.35,CNsub,NTP,0000,0000,0000,,Қылмыскердің жеке басы да анықталды.
Dialogue: 0,0:23:53.72,0:23:54.75,CNsub,NTP,0000,0000,0000,,Сіз біреуді көрдіңіз бе?
Dialogue: 0,0:23:56.03,0:23:58.35,CNsub,NTP,0000,0000,0000,,Қылмыскер ізіне түсті
Dialogue: 0,0:23:59.71,0:24:04.12,CNsub,NTP,0000,0000,0000,,Биылғы жылы жасалған қылмыстар қаладағы адам көп жүретін Сяохутунгли көшесінде.
Dialogue: 0,0:24:05.10,0:24:08.21,CNsub,NTP,0000,0000,0000,,Кісі өлтіру орнын қоршау – басты көше.
Dialogue: 0,0:24:08.62,0:24:10.78,CNsub,NTP,0000,0000,0000,,Әрине, адамдар басқалармен кездесе алмайды.
Dialogue: 0,0:24:11.88,0:24:16.09,CNsub,NTP,0000,0000,0000,,Кимоно киген адам астанада тұрған сайын келеді.
Dialogue: 0,0:24:17.72,0:24:19.51,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:20.93,0:24:24.07,CNsub,NTP,0000,0000,0000,,Сіз бізге қонаққа келгенде
Dialogue: 0,0:24:26.28,0:24:28.53,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:35.04,0:24:35.81,CNsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:24:38.62,0:24:39.85,CNsub,NTP,0000,0000,0000,,Бұл білудің жолы
Dialogue: 0,0:24:41.40,0:24:45.19,CNsub,NTP,0000,0000,0000,,Дауыс – LSD.
Dialogue: 0,0:24:46.06,0:24:48.05,CNsub,NTP,0000,0000,0000,,Косэй Джиридің құрбаны
Dialogue: 0,0:24:48.11,0:24:51.21,CNsub,NTP,0000,0000,0000,,Егер сізде бір жарым жылдан астам тұрғылықты жеріңіз болса
Dialogue: 0,0:24:51.63,0:24:52.46,CNsub,NTP,0000,0000,0000,,Қайда бару керек?
Dialogue: 0,0:24:53.22,0:24:56.16,CNsub,NTP,0000,0000,0000,,Жұмыспен қамту полициясының пайда болуы
Dialogue: 0,0:24:56.56,0:25:00.25,CNsub,NTP,0000,0000,0000,,Жақсы бейне – жыл өмір сүретін адамдар арасындағы құпия кітап.
Dialogue: 0,0:25:05.64,0:25:06.95,CNsub,NTP,0000,0000,0000,,Дүкенді қайда пайдалану керек
Dialogue: 0,0:25:07.34,0:25:10.03,CNsub,NTP,0000,0000,0000,,Алайда курс тоқтатылды.
Dialogue: 0,0:25:10.94,0:25:15.10,CNsub,NTP,0000,0000,0000,,Улы өнім оқиғасына үлес
Dialogue: 0,0:25:15.70,0:25:16.66,CNsub,NTP,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:25:17.36,0:25:20.15,CNsub,NTP,0000,0000,0000,,Талқылаудың анықталмаған барысы
Dialogue: 0,0:25:21.57,0:25:22.96,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:23.52,0:25:24.28,CNsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:25:24.86,0:25:26.50,CNsub,NTP,0000,0000,0000,,Сақ болыңыз.
Dialogue: 0,0:25:36.41,0:25:37.86,CNsub,NTP,0000,0000,0000,,Гаку Коидзаки
Dialogue: 0,0:25:38.09,0:25:39.84,CNsub,NTP,0000,0000,0000,,Полиция қызметкері Цю Ми
Dialogue: 0,0:27:29.29,0:27:31.79,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:27:36.34,0:27:36.95,CNsub,NTP,0000,0000,0000,,Бізге асығыс керек.
Dialogue: 0,0:27:40.97,0:27:41.80,CNsub,NTP,0000,0000,0000,,Уолтер Эванс (59)
Dialogue: 0,0:27:42.41,0:27:43.91,CNsub,NTP,0000,0000,0000,,Улы өнім туралы әңгіме
Dialogue: 0,0:27:44.58,0:27:47.54,CNsub,NTP,0000,0000,0000,,Қызыл түстің түсі пайдаланылмаған.
Dialogue: 0,0:27:48.02,0:27:49.26,CNsub,NTP,0000,0000,0000,,Сіз қай жерденсіз
Dialogue: 0,0:27:50.11,0:27:50.93,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:27:53.40,0:27:54.69,CNsub,NTP,0000,0000,0000,,Мата Шитааме Рёу
Dialogue: 0,0:27:55.09,0:27:56.20,CNsub,NTP,0000,0000,0000,,Ақшаны жоғалту
Dialogue: 0,0:27:56.60,0:27:58.06,CNsub,NTP,0000,0000,0000,,Қосаконың терең сезімі туралы әңгіме
Dialogue: 0,0:28:11.53,0:28:12.35,CNsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,0:29:47.60,0:29:49.84,CNsub,NTP,0000,0000,0000,,Уытты есірткі туралы әңгімелер
Dialogue: 0,0:30:17.49,0:30:20.18,CNsub,NTP,0000,0000,0000,,Қиялыңызды ояту жақсы.
Dialogue: 0,0:30:20.48,0:30:23.72,CNsub,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:30:56.12,0:31:00.72,CNsub,NTP,0000,0000,0000,,Шығыс Киотодағы Канбузи қаласындағы кісі өлтіру ісінде жаңа жәбірленуші пайда болды.
Dialogue: 0,0:31:01.62,0:31:04.29,CNsub,NTP,0000,0000,0000,,Қазір Тянь Линчэн қаладағы белгілі бір қонақ үй ауданында орналасқан.
Dialogue: 0,0:31:04.72,0:31:10.93,CNsub,NTP,0000,0000,0000,,Жалған адам санатындағы қанның көп мөлшері және шашыраңқы дене бөліктері
Dialogue: 0,0:31:11.38,0:31:12.43,CNsub,NTP,0000,0000,0000,,Су ашылды Су ашылды
Dialogue: 0,0:31:12.85,0:31:13.47,CNsub,NTP,0000,0000,0000,,Ол саған ұнайды ма?
Dialogue: 0,0:31:13.71,0:31:14.95,CNsub,NTP,0000,0000,0000,,Жақсы жақ бар ма?
Dialogue: 0,0:31:15.98,0:31:18.61,CNsub,NTP,0000,0000,0000,,Сәтсіздік
Dialogue: 0,0:31:19.25,0:31:21.33,CNsub,NTP,0000,0000,0000,,4
Dialogue: 0,0:31:25.74,0:31:27.31,CNsub,NTP,0000,0000,0000,,Сіздің шынайы махаббатыңыз бірнеше рет.
Dialogue: 0,0:31:27.71,0:31:30.98,CNsub,NTP,0000,0000,0000,,Жақында қолданып көрдіңіз бе?
Dialogue: 0,0:31:36.95,0:31:38.44,CNsub,NTP,0000,0000,0000,,Сондай-ақ, бұл «өлтіруші ессіздік».
Dialogue: 0,0:31:44.37,0:31:46.92,CNsub,NTP,0000,0000,0000,,Кінәлі жапон киімін киген адам ма?
Dialogue: 0,0:31:47.51,0:31:48.48,CNsub,NTP,0000,0000,0000,,Атау
Dialogue: 0,0:31:51.80,0:31:54.37,CNsub,NTP,0000,0000,0000,,Кездесуден кейін кездесуді алуға болады ма?
Dialogue: 0,0:31:55.86,0:31:57.76,CNsub,NTP,0000,0000,0000,,Маған оны жазудың қажеті жоқ.
Dialogue: 0,0:31:58.32,0:32:00.95,CNsub,NTP,0000,0000,0000,,「」
Dialogue: 0,0:31:58.32,0:32:00.95,CNsub,NTP,0000,0000,0000,,(«Қант дүкені» балалар ертегісінің екі басты кейіпкері)
Dialogue: 0,0:32:12.87,0:32:15.25,CNsub,NTP,0000,0000,0000,,Сіз қаладан бір нүкте қашықтықтасыз.
Dialogue: 0,0:32:17.82,0:32:19.77,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:32:26.15,0:32:29.24,CNsub,NTP,0000,0000,0000,,Полиция форма киген күдіктіні тергеу
Dialogue: 0,0:32:29.44,0:32:32.14,CNsub,NTP,0000,0000,0000,,Кісі өлтіру ісінің кілті
Dialogue: 0,0:32:32.34,0:32:34.68,CNsub,NTP,0000,0000,0000,,Жұмыс барысын шолу
Dialogue: 0,0:33:16.61,0:33:17.73,CNsub,NTP,0000,0000,0000,,Сәттілік пен сәттілік.
Dialogue: 0,0:33:19.07,0:33:20.92,CNsub,NTP,0000,0000,0000,,Өткен тарих
Dialogue: 0,0:33:21.14,0:33:22.05,CNsub,NTP,0000,0000,0000,,Жазып ала аласыз ба?
Dialogue: 0,0:33:26.27,0:33:28.98,CNsub,NTP,0000,0000,0000,,Жағымсыз ниеттер
Dialogue: 0,0:33:34.49,0:33:36.37,CNsub,NTP,0000,0000,0000,,Не істеу керек
Dialogue: 0,0:33:38.21,0:33:40.14,CNsub,NTP,0000,0000,0000,,Сіз әйел адамсыз
Dialogue: 0,0:33:40.47,0:33:41.72,CNsub,NTP,0000,0000,0000,,Маңыздың түрі жоқ
Dialogue: 0,0:33:42.02,0:33:42.78,CNsub,NTP,0000,0000,0000,,Жылдамдық
Dialogue: 0,0:33:42.91,0:33:43.74,CNsub,NTP,0000,0000,0000,,Негізсіз
Dialogue: 0,0:33:44.32,0:33:47.55,CNsub,NTP,0000,0000,0000,,Маңайда бір ғана улы зат бар.
Dialogue: 0,0:33:48.27,0:33:51.30,CNsub,NTP,0000,0000,0000,,Аузыңызда не айтарыңызды білгіңіз келсе, улы өнімдерді де қолдануға болады.
Dialogue: 0,0:33:51.58,0:33:52.42,CNsub,NTP,0000,0000,0000,,Тек мұны істеу керек пе?
Dialogue: 0,0:33:52.90,0:33:56.72,CNsub,NTP,0000,0000,0000,,Барлық улы өнімдерге қатаң тыйым салынады.
Dialogue: 0,0:33:56.95,0:33:58.09,CNsub,NTP,0000,0000,0000,,Вокзал қауіпті болса да, оған сенуден басқа амалымыз жоқ.
Dialogue: 0,0:34:00.45,0:34:02.55,CNsub,NTP,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:34:05.53,0:34:06.39,CNsub,NTP,0000,0000,0000,,Оларды таба аламыз ба, Мелони?
Dialogue: 0,0:34:06.69,0:34:12.07,CNsub,NTP,0000,0000,0000,,Улы өнімдерге тәуелді және «өлтіруші мания» бар адамның белгілі бір түрі бар ма?
Dialogue: 0,0:34:12.46,0:34:13.10,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:34:13.47,0:34:16.69,CNsub,NTP,0000,0000,0000,,Менің алдымда
Dialogue: 0,0:34:19.41,0:34:22.08,CNsub,NTP,0000,0000,0000,,Түсінгеніңізге рахмет.
Dialogue: 0,0:34:23.23,0:34:24.25,CNsub,NTP,0000,0000,0000,,Жаңа станцияны пайдалану жолы
Dialogue: 0,0:34:24.61,0:34:26.94,CNsub,NTP,0000,0000,0000,,Кимонодағы үйді жоғалту - бұл «адам өлтіру маниясы»
Dialogue: 0,0:34:28.28,0:34:30.47,CNsub,NTP,0000,0000,0000,,Шындық – кеше түнде көргеніңіз.
Dialogue: 0,0:34:31.20,0:34:35.51,CNsub,NTP,0000,0000,0000,,Мен төрт жыл бойы жапон киімін киген ерлерді және жапон киімін киген әйелдерді көрдім.
Dialogue: 0,0:34:36.26,0:34:37.08,CNsub,NTP,0000,0000,0000,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:34:38.21,0:34:39.70,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз. «Жапон киіміндегі әйел».
Dialogue: 0,0:34:39.95,0:34:42.00,CNsub,NTP,0000,0000,0000,,Жаңа нұсқадан айырмашылығы бар ма?
Dialogue: 0,0:34:42.57,0:34:45.67,CNsub,NTP,0000,0000,0000,,Аспанның түсі қараңғыдан айырмашылығы бар ма? Бұл әйелдік пе?
Dialogue: 0,0:34:46.38,0:34:49.64,CNsub,NTP,0000,0000,0000,,Мен кеткенде таң қалдым, бірақ дененің бағыты сондай әдемі болды.
Dialogue: 0,0:34:49.87,0:34:52.48,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:55.06,0:34:57.37,CNsub,NTP,0000,0000,0000,,Мен сізге көмектесу үшін келдім.
Dialogue: 0,0:34:57.73,0:34:58.74,CNsub,NTP,0000,0000,0000,,Аномалия
Dialogue: 0,0:34:59.54,0:35:02.74,CNsub,NTP,0000,0000,0000,,Әйелдің қызының қызының баласының төрт түлігі.
Dialogue: 0,0:35:03.44,0:35:04.35,CNsub,NTP,0000,0000,0000,,Ұстау өлшемі?
Dialogue: 0,0:35:04.50,0:35:05.94,CNsub,NTP,0000,0000,0000,,Өлтірмеу немесе босатпау
Dialogue: 0,0:35:06.31,0:35:08.89,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:35:17.98,0:35:21.41,CNsub,NTP,0000,0000,0000,,Мен көптеген психикалық ауытқуларды көрдім.
Dialogue: 0,0:35:22.31,0:35:23.94,CNsub,NTP,0000,0000,0000,,Бұл бірінші бақылау.
Dialogue: 0,0:35:27.88,0:35:30.26,CNsub,NTP,0000,0000,0000,,Жағымсыз ниеттер
Dialogue: 0,0:35:30.70,0:35:35.49,CNsub,NTP,0000,0000,0000,,Өлтірілген төрт адам, жапондық стильді ойлаған бір адам ханзада болды.
Dialogue: 0,0:35:37.02,0:35:40.55,CNsub,NTP,0000,0000,0000,,Мүмкін және мүмкін емес қайта хабарлау: Улы өнімдер
Dialogue: 0,0:35:41.14,0:35:44.62,CNsub,NTP,0000,0000,0000,,Сіз жапондық киім киген әйелсіз бе?
Dialogue: 0,0:35:45.12,0:35:46.06,CNsub,NTP,0000,0000,0000,,Сіздің сұранысыңызды сұраймыз
Dialogue: 0,0:35:48.21,0:35:49.28,CNsub,NTP,0000,0000,0000,,Түсінемін
Dialogue: 0,0:35:50.08,0:35:54.11,CNsub,NTP,0000,0000,0000,,Каннабистің қандай жаңа түрлері туралы айтуға болады?
Dialogue: 0,0:35:54.63,0:35:55.29,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:35:55.68,0:35:58.78,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:35:59.04,0:36:01.47,CNsub,NTP,0000,0000,0000,,Түрлі улы өнімдер, адамның ақыл-ойын жоюдың шынайы қабілеті.
Dialogue: 0,0:36:01.87,0:36:04.09,CNsub,NTP,0000,0000,0000,,Сондықтан мен улы өнім емеспін.
Dialogue: 0,0:36:04.40,0:36:06.79,CNsub,NTP,0000,0000,0000,,Сондай-ақ Bloodchip рұқсат етілмеген
Dialogue: 0,0:36:07.09,0:36:09.29,CNsub,NTP,0000,0000,0000,,Қан...чип?
Dialogue: 0,0:36:10.54,0:36:12.52,CNsub,NTP,0000,0000,0000,,Қан талшығы дегеніміз не?
Dialogue: 0,0:36:12.63,0:36:13.60,CNsub,NTP,0000,0000,0000,,Надансың ба?
Dialogue: 0,0:36:14.20,0:36:19.19,CNsub,NTP,0000,0000,0000,,Жеңіл және улы өнімдер;
Dialogue: 0,0:36:23.39,0:36:25.60,CNsub,NTP,0000,0000,0000,,Түзетуші у...
Dialogue: 0,0:36:27.64,0:36:29.71,CNsub,NTP,0000,0000,0000,,Менде не бар
Dialogue: 0,0:36:30.20,0:36:33.98,CNsub,NTP,0000,0000,0000,,Қан талшықтары – улы өнім.
Dialogue: 0,0:36:34.37,0:36:35.70,CNsub,NTP,0000,0000,0000,,Бұл қызыл ма?
Dialogue: 0,0:36:36.41,0:36:37.38,CNsub,NTP,0000,0000,0000,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 0,0:36:37.74,0:36:42.62,CNsub,NTP,0000,0000,0000,,Бұл салыстырмалы түрде қою қызыл түс пе?
Dialogue: 0,0:36:43.00,0:36:44.82,CNsub,NTP,0000,0000,0000,,Бастапқы оқиғаның оқиғасы
Dialogue: 0,0:36:45.42,0:36:49.89,CNsub,NTP,0000,0000,0000,,Бұл қызыл түсті зат, улы бас, арнайы жасалған арнайы бұйым.
Dialogue: 0,0:36:51.53,0:36:53.83,CNsub,NTP,0000,0000,0000,,Бұл шебердің шебері.
Dialogue: 0,0:36:54.22,0:36:54.94,CNsub,NTP,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:36:55.17,0:36:59.90,CNsub,NTP,0000,0000,0000,,Қан талшықтары тек кәмелетке толмағандарға арналған
Dialogue: 0,0:37:00.18,0:37:02.60,CNsub,NTP,0000,0000,0000,,Улы мінез-құлық негізінде жатыр
Dialogue: 0,0:37:03.06,0:37:04.88,CNsub,NTP,0000,0000,0000,,Алайда басшының негіздері басқарылмайды.
Dialogue: 0,0:37:05.33,0:37:08.22,CNsub,NTP,0000,0000,0000,,Оны көру аздық етеді, бірақ кішкентай бала.
Dialogue: 0,0:37:08.57,0:37:12.11,CNsub,NTP,0000,0000,0000,,Полиция мен Шираничи қанды чипке не болды?
Dialogue: 0,0:37:13.31,0:37:15.91,CNsub,NTP,0000,0000,0000,,Анықтама үшін келесіні оқыңыз.
Dialogue: 0,0:37:17.31,0:37:18.99,CNsub,NTP,0000,0000,0000,,Тағы бір өрт оқиғасы
Dialogue: 0,0:37:19.64,0:37:21.91,CNsub,NTP,0000,0000,0000,,Бұрын Bloodchip енгізгені
Dialogue: 0,0:37:22.27,0:37:24.29,CNsub,NTP,0000,0000,0000,,Улы құрбандық – императордың жалпы тіршілігі
Dialogue: 0,0:37:24.61,0:37:27.48,CNsub,NTP,0000,0000,0000,,Жаңа діни сезімдер
Dialogue: 0,0:37:30.22,0:37:30.90,CNsub,NTP,0000,0000,0000,,Растау
Dialogue: 0,0:37:31.99,0:37:34.10,CNsub,NTP,0000,0000,0000,,Улы өнімнің атын білесіз бе?
Dialogue: 0,0:37:34.94,0:37:37.04,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:38:04.87,0:38:07.98,CNsub,NTP,0000,0000,0000,,Шынайы өткен иелік дегеніміз не?
Dialogue: 0,0:38:09.07,0:38:09.74,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:38:11.13,0:38:12.59,CNsub,NTP,0000,0000,0000,,Сіз осындасыз ба?
Dialogue: 0,0:38:15.63,0:38:19.30,CNsub,NTP,0000,0000,0000,,Полиция қызметінің міндеттері туралы ақпарат
Dialogue: 0,0:38:20.39,0:38:23.16,CNsub,NTP,0000,0000,0000,,Өткен жылдан осы жылға дейінгі оқиғалар
Dialogue: 0,0:38:23.71,0:38:25.54,CNsub,NTP,0000,0000,0000,,Төрт жыл бұрын өлтіру жоспары
Dialogue: 0,0:38:26.65,0:38:28.76,CNsub,NTP,0000,0000,0000,,Өлім болған жерге жақын адамдардан басқа
Dialogue: 0,0:38:29.19,0:38:31.16,CNsub,NTP,0000,0000,0000,,Ортақ нүктелер жоқ
Dialogue: 0,0:38:31.93,0:38:36.12,CNsub,NTP,0000,0000,0000,,Алайда қазіргі жағдай белгісіз.
Dialogue: 0,0:38:36.30,0:38:39.17,CNsub,NTP,0000,0000,0000,,Реніш сезімі сол адам.
Dialogue: 0,0:38:39.49,0:38:40.55,CNsub,NTP,0000,0000,0000,,Мен сізбен келісемін.
Dialogue: 0,0:38:41.24,0:38:42.09,CNsub,NTP,0000,0000,0000,,Тадаши…
Dialogue: 0,0:38:43.18,0:38:43.98,CNsub,NTP,0000,0000,0000,,Дәл осы ма?
Dialogue: 0,0:38:45.17,0:38:47.52,CNsub,NTP,0000,0000,0000,,өлім
Dialogue: 0,0:38:48.44,0:38:52.39,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:01.55,0:39:02.53,CNsub,NTP,0000,0000,0000,,Тадаши…
Dialogue: 0,0:39:11.91,0:39:15.71,CNsub,NTP,0000,0000,0000,,Көше көп жүретін көшенің жанында сирек кездесетін және адамдар жүретін аймақ
Dialogue: 0,0:39:16.54,0:39:19.21,CNsub,NTP,0000,0000,0000,,Шетелдік студенттерге арналған естеліктер
Dialogue: 0,0:39:19.81,0:39:24.95,CNsub,NTP,0000,0000,0000,,Қазіргі таңда жақсы адамның күнделікті өмірінде дарынды тұлға болып өсуде терең зұлмат бар.
Dialogue: 0,0:39:26.64,0:39:30.91,CNsub,NTP,0000,0000,0000,,Жаңа тұрғылықты жері қашан пайда болды және жәбірленуші немесе кінәлі
Dialogue: 0,0:39:32.30,0:39:33.87,CNsub,NTP,0000,0000,0000,,Цуицу Кайдо Чантоку Тоука Цумэй
23-бөлім
Dialogue: 0,0:39:34.19,0:39:37.92,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:39.23,0:39:40.84,CNsub,NTP,0000,0000,0000,,Тас жолдағы қара және қара генерал
Dialogue: 0,0:39:41.30,0:39:44.23,CNsub,NTP,0000,0000,0000,,Адам табының және генералдардың қара және қара беттері де қол жетімді.
Dialogue: 0,0:39:45.24,0:39:47.12,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:47.98,0:39:51.14,CNsub,NTP,0000,0000,0000,,Алайда адамның өз санасы ғана өзімшіл.
Dialogue: 0,0:39:51.39,0:39:52.13,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:39:58.34,0:40:02.62,CNsub,NTP,0000,0000,0000,,Түн ортасынан кейін
Dialogue: 0,0:40:03.74,0:40:05.75,CNsub,NTP,0000,0000,0000,,Тұрғындар басқарылатын қала көшелері
Dialogue: 0,0:40:06.47,0:40:09.14,CNsub,NTP,0000,0000,0000,,Өйткені мен өзімді жалғыздық деп ойлаймын
Dialogue: 0,0:40:10.04,0:40:15.56,CNsub,NTP,0000,0000,0000,,Ойлан, өзіңді көр, жалғыз сезін
Dialogue: 0,0:41:55.78,0:41:57.45,CNsub,NTP,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:42:00.36,0:42:03.98,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:42:05.63,0:42:06.74,CNsub,NTP,0000,0000,0000,,Мен сені түсінемін
Dialogue: 0,0:42:12.18,0:42:13.32,CNsub,NTP,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:42:13.81,0:42:14.78,CNsub,NTP,0000,0000,0000,,Ол осылайша жанды шығарып алады ма?
Dialogue: 0,0:43:02.72,0:43:05.65,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:43:06.07,0:43:07.51,CNsub,NTP,0000,0000,0000,,Сіз қанша уақыт болдыңыз?
Dialogue: 0,0:43:11.60,0:43:13.23,CNsub,NTP,0000,0000,0000,,Екі түрі
Dialogue: 0,0:43:47.03,0:43:51.88,CNsub,NTP,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:43:53.20,0:43:55.81,CNsub,NTP,0000,0000,0000,,Ол толық емес болды.
Dialogue: 0,0:43:56.43,0:44:00.03,CNsub,NTP,0000,0000,0000,,Менің қазіргі көңіл-күйім қандай?
Dialogue: 0,0:44:01.01,0:44:03.73,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:04.29,0:44:07.76,CNsub,NTP,0000,0000,0000,,Мен осы жерге баратын сияқтымын.
Dialogue: 0,0:44:08.91,0:44:13.15,CNsub,NTP,0000,0000,0000,,Еш қиындықсыз кездескенше
Dialogue: 0,0:44:14.61,0:44:16.97,CNsub,NTP,0000,0000,0000,,Мұның бәрі сіз үшін.
Dialogue: 0,0:44:17.44,0:44:18.87,CNsub,NTP,0000,0000,0000,,Киллер де
Dialogue: 0,0:44:19.35,0:44:22.23,CNsub,NTP,0000,0000,0000,,Кітапты оқу керек екені анық.
Dialogue: 0,0:44:23.94,0:44:25.46,CNsub,NTP,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:44:26.70,0:44:30.15,CNsub,NTP,0000,0000,0000,,Бұл оқиға төрт жыл бұрын мен жұмыс істей бастағанда болды.
Dialogue: 0,0:44:33.06,0:44:35.45,CNsub,NTP,0000,0000,0000,,Дегенмен, оны елемеу тривиальды.
Dialogue: 0,0:44:38.24,0:44:41.42,CNsub,NTP,0000,0000,0000,,Басқа бағыттың болмауы
Dialogue: 0,0:44:43.61,0:44:45.79,CNsub,NTP,0000,0000,0000,,Өлім – «өлтіруші ессіздік»
Dialogue: 0,0:44:46.19,0:44:50.08,CNsub,NTP,0000,0000,0000,,Менің атым жасырын
Dialogue: 0,0:44:51.84,0:44:54.02,CNsub,NTP,0000,0000,0000,,Мен мақсатыма жеттім бе?
Dialogue: 0,0:44:54.75,0:44:56.36,CNsub,NTP,0000,0000,0000,,Себебі, себебі жоғары.
Dialogue: 0,0:44:56.74,0:45:00.18,CNsub,NTP,0000,0000,0000,,Мен басқалардан не күтемін?
Dialogue: 0,0:45:00.45,0:45:05.22,CNsub,NTP,0000,0000,0000,,``Ассассин маниясы'' Қарастырылып отырған адам - өлтірілді деп болжанған адам
Dialogue: 0,0:45:05.43,0:45:06.35,CNsub,NTP,0000,0000,0000,,артқа
Dialogue: 0,0:45:08.57,0:45:10.57,CNsub,NTP,0000,0000,0000,,Сіз екеніңіз анық
Dialogue: 0,0:45:11.00,0:45:11.82,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:45:13.16,0:45:16.43,CNsub,NTP,0000,0000,0000,,Сондықтан мен өз еңбек жолымды бастағым келді.
Dialogue: 0,0:45:17.77,0:45:22.64,CNsub,NTP,0000,0000,0000,,Ләззат алу еркіндігі.
Dialogue: 0,0:45:25.34,0:45:27.17,CNsub,NTP,0000,0000,0000,,Маған түсінікті
Dialogue: 0,0:45:27.44,0:45:28.83,CNsub,NTP,0000,0000,0000,,Бұл маған түсінікті
Dialogue: 0,0:45:31.23,0:45:35.82,CNsub,NTP,0000,0000,0000,,Өйткені мен ең түсінетін адаммын.
Dialogue: 0,0:45:36.32,0:45:38.68,CNsub,NTP,0000,0000,0000,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:45:38.97,0:45:41.71,CNsub,NTP,0000,0000,0000,,Бұл өз шығу тегіне байланысты.
Dialogue: 0,0:45:41.94,0:45:43.63,CNsub,NTP,0000,0000,0000,,Рұқсат етілмейтін қажеттілік
Dialogue: 0,0:45:43.80,0:45:46.59,CNsub,NTP,0000,0000,0000,,Сұраныс мүлде кетіп, өзін-өзі ойлайтын іс бітті.
Dialogue: 0,0:45:48.66,0:45:50.28,CNsub,NTP,0000,0000,0000,,Менің бұрынғы тәжірибем қандай болды?
Dialogue: 0,0:45:50.49,0:45:52.35,CNsub,NTP,0000,0000,0000,,Мен саған қызығамын
Dialogue: 0,0:45:54.15,0:45:56.40,CNsub,NTP,0000,0000,0000,,Мен өз ойымды растаймын.
Dialogue: 0,0:45:56.96,0:45:59.20,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:01.12,0:46:05.68,CNsub,NTP,0000,0000,0000,,Растау менің өлімім.
Dialogue: 0,0:46:08.34,0:46:09.81,CNsub,NTP,0000,0000,0000,,Пайдаланылмаған басу өзін-өзі құмарлық
Dialogue: 0,0:46:10.11,0:46:11.23,CNsub,NTP,0000,0000,0000,,Екі түрі
Dialogue: 0,0:46:13.23,0:46:16.62,CNsub,NTP,0000,0000,0000,,Сен менің инстинктивті тілегімсің.
Dialogue: 0,0:46:16.87,0:46:19.98,CNsub,NTP,0000,0000,0000,,Осыны ойласам, ойыма келді.
Dialogue: 0,0:46:21.72,0:46:24.10,CNsub,NTP,0000,0000,0000,,Келесі
Dialogue: 0,0:46:28.53,0:46:32.70,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:32.97,0:46:35.40,CNsub,NTP,0000,0000,0000,,Өзгерістің себебі өзгертілді.
Dialogue: 0,0:46:37.64,0:46:41.58,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:42.49,0:46:45.58,CNsub,NTP,0000,0000,0000,,Есепті шешу керек пе деген сұрақ
Dialogue: 0,0:46:48.66,0:46:49.51,CNsub,NTP,0000,0000,0000,,Кім?
Dialogue: 0,0:47:00.18,0:47:01.84,CNsub,NTP,0000,0000,0000,,Кімді өлтіргіңіз келеді?
Dialogue: 0,0:47:16.10,0:47:17.80,CNsub,NTP,0000,0000,0000,,Миста әдеттегідей көшеде мақсатсыз серуендеп жүрді
Dialogue: 0,0:47:18.69,0:47:19.75,CNsub,NTP,0000,0000,0000,,Миста әдеттегідей көшеде мақсатсыз серуендеп жүрді
Dialogue: 0,0:47:20.22,0:47:22.09,CNsub,NTP,0000,0000,0000,,Бұлай екені анық.
Dialogue: 0,0:47:23.24,0:47:26.19,CNsub,NTP,0000,0000,0000,,Бұл шынайы мақала.
Dialogue: 0,0:47:41.32,0:47:43.27,CNsub,NTP,0000,0000,0000,,Бұл жай әңгіме емес
Dialogue: 0,0:47:46.77,0:47:49.22,CNsub,NTP,0000,0000,0000,,Кедергіні өлтіру аяқталды.
Dialogue: 0,0:49:44.35,0:49:46.70,CNsub,NTP,0000,0000,0000,,1995 жылғы сәуір
Dialogue: 0,0:49:47.44,0:49:49.10,CNsub,NTP,0000,0000,0000,,Мен мұны түсінемін
Dialogue: 0,0:49:58.47,0:49:59.19,CNsub,NTP,0000,0000,0000,,мамыр
Dialogue: 0,0:49:59.72,0:50:01.44,CNsub,NTP,0000,0000,0000,,Келесі әңгіме
Dialogue: 0,0:50:03.12,0:50:06.92,CNsub,NTP,0000,0000,0000,,Есеп енді, мен абдырап қалдым.
Dialogue: 0,0:50:08.29,0:50:09.88,CNsub,NTP,0000,0000,0000,,Қараңызшы
Dialogue: 0,0:50:10.90,0:50:12.95,CNsub,NTP,0000,0000,0000,,Мен мүлдем қалыпты емеспін.
Dialogue: 0,0:50:14.44,0:50:17.04,CNsub,NTP,0000,0000,0000,,Менің күнделікті өмірімнің эрозиясы
Dialogue: 0,0:50:18.53,0:50:21.07,CNsub,NTP,0000,0000,0000,,Сол жер, орта мектеп, орта мектеп, ғажайып оқушы қыз
Dialogue: 0,0:50:22.45,0:50:25.49,CNsub,NTP,0000,0000,0000,,Негізінен дұрыс айтамын...Мен сені жақсы көремін.
Dialogue: 0,0:50:28.56,0:50:29.56,CNsub,NTP,0000,0000,0000,,шілде
Dialogue: 0,0:50:30.12,0:50:31.75,CNsub,NTP,0000,0000,0000,,«Мен әлсізмін»
Dialogue: 0,0:50:32.29,0:50:34.45,CNsub,NTP,0000,0000,0000,,Қарапайым тілдің пробосы
Dialogue: 0,0:50:35.09,0:50:38.39,CNsub,NTP,0000,0000,0000,,Мен рәсімге қатысудан бас тартамын.
Dialogue: 0,0:50:39.58,0:50:41.37,CNsub,NTP,0000,0000,0000,,«Мен әлсізмін»
Dialogue: 0,0:50:41.89,0:50:44.90,CNsub,NTP,0000,0000,0000,,Мен түпнұсқа мәтіннің мағынасын түсінбеймін.
Dialogue: 0,0:50:45.83,0:50:48.81,CNsub,NTP,0000,0000,0000,,Мен бірінші соққышымын
Dialogue: 0,0:50:50.07,0:50:53.23,CNsub,NTP,0000,0000,0000,,Натен Акигами Мен бірінші өлтірушімін.
Dialogue: 0,0:50:55.98,0:50:57.80,CNsub,NTP,0000,0000,0000,,Аспанның оянуы және оянуы
Dialogue: 0,0:50:58.41,0:51:01.57,CNsub,NTP,0000,0000,0000,,Жақсылық пен жамандық Жақсылық пен жамандық
Dialogue: 0,0:51:02.38,0:51:04.59,CNsub,NTP,0000,0000,0000,,Өйткені мен жағдайға тәуелсіз.
Dialogue: 0,0:51:05.17,0:51:06.82,CNsub,NTP,0000,0000,0000,,Жалғасы
Dialogue: 0,0:51:08.47,0:51:10.29,CNsub,NTP,0000,0000,0000,,Мен ең басқа адаммын.
Dialogue: 0,0:51:11.11,0:51:12.74,CNsub,NTP,0000,0000,0000,,Елорданың болашағы
Dialogue: 0,0:51:13.36,0:51:14.92,CNsub,NTP,0000,0000,0000,,Ши но Тофусу
Dialogue: 0,0:51:15.67,0:51:17.41,CNsub,NTP,0000,0000,0000,,Мен ең басқа адаммын.
Dialogue: 0,0:51:18.36,0:51:19.82,CNsub,NTP,0000,0000,0000,,7-ші аспан Мен оны көрдім
Dialogue: 0,0:51:20.61,0:51:24.50,CNsub,NTP,0000,0000,0000,,Белгілі бір уақытта өлетін адамдар
Dialogue: 0,0:51:25.45,0:51:27.72,CNsub,NTP,0000,0000,0000,,Қайтыс болған адамның қайтыс болуы туралы хабарлама
Dialogue: 0,0:51:28.29,0:51:34.73,CNsub,NTP,0000,0000,0000,,Өзіңді өлтіру басқа адамды өлтірумен тең.
Dialogue: 0,0:51:36.37,0:51:37.43,CNsub,NTP,0000,0000,0000,,тамыз
Dialogue: 0,0:51:37.78,0:51:40.03,CNsub,NTP,0000,0000,0000,,Мен ойынды ойнай бастадым.
Dialogue: 0,0:51:40.58,0:51:42.23,CNsub,NTP,0000,0000,0000,,Профессор Араяның айтқанының бір бөлігі
Dialogue: 0,0:51:42.60,0:51:43.73,CNsub,NTP,0000,0000,0000,,Мен өзімнің түзетуіме сенімдімін.
Dialogue: 0,0:51:44.32,0:51:48.91,CNsub,NTP,0000,0000,0000,,Оның себебі, адамның өлімі заңды іс болып табылады
Dialogue: 0,0:51:49.55,0:51:51.72,CNsub,NTP,0000,0000,0000,,Мен есептеуге алаңдамаймын
Dialogue: 0,0:51:52.21,0:51:53.86,CNsub,NTP,0000,0000,0000,,Жалғыз қария мазасызданады
Dialogue: 0,0:51:54.63,0:51:59.05,CNsub,NTP,0000,0000,0000,,Менің көретінім маған қажет және мен қалаған нәрсе.
Dialogue: 0,0:52:22.75,0:52:23.87,CNsub,NTP,0000,0000,0000,,Йошихиса Фьюси
Dialogue: 0,0:52:24.28,0:52:25.53,CNsub,NTP,0000,0000,0000,,1996 жылы қайтыс болды
Dialogue: 0,0:52:25.66,0:52:26.70,CNsub,NTP,0000,0000,0000,,Куротоу-кун
Dialogue: 0,0:52:28.71,0:52:30.20,CNsub,NTP,0000,0000,0000,,Хига ерте келді деп ойлады
Dialogue: 0,0:52:30.97,0:52:35.02,CNsub,NTP,0000,0000,0000,,Шыққаннан бері сіз уақыт бойынша әрі қарай саяхаттадыңыз.
Dialogue: 0,0:52:37.19,0:52:39.64,CNsub,NTP,0000,0000,0000,,Мен қателестім бе?
Dialogue: 0,0:52:40.04,0:52:43.04,CNsub,NTP,0000,0000,0000,,Болмау
Dialogue: 0,0:52:44.37,0:52:48.33,CNsub,NTP,0000,0000,0000,,қараша Мен белгілі бір қоғамдық резиденцияға бардым.
Dialogue: 0,0:52:48.88,0:52:50.60,CNsub,NTP,0000,0000,0000,,Нафу - қарапайым халық аңызы
Dialogue: 0,0:52:51.29,0:52:56.10,CNsub,NTP,0000,0000,0000,,Егер сіз жиналысқа жаңадан келген болсаңыз, белгілі бір форматта бізге хабарласыңыз.
Dialogue: 0,0:52:56.31,0:52:56.95,CNsub,NTP,0000,0000,0000,,Тесілмеген, бірақ бірдеңе бар…
Dialogue: 0,0:52:57.23,0:52:57.97,CNsub,NTP,0000,0000,0000,,Жоғалдың ба?
Dialogue: 0,0:52:58.22,0:52:59.51,CNsub,NTP,0000,0000,0000,,Ақ таза ауылдың алдыңғы жағы
Dialogue: 0,0:53:01.52,0:53:05.05,CNsub,NTP,0000,0000,0000,,Арая Сенсейдің де тыңдамай шағын пьесасы бар.
Dialogue: 0,0:53:07.32,0:53:10.38,CNsub,NTP,0000,0000,0000,,Бет әлпетіне қараңыз.
Dialogue: 0,0:53:10.72,0:53:13.21,CNsub,NTP,0000,0000,0000,,Бұл үш жыл бұрын болған.
Dialogue: 0,0:53:14.27,0:53:17.67,CNsub,NTP,0000,0000,0000,,Сіз қашан келесіз?
Dialogue: 0,0:53:17.86,0:53:18.83,CNsub,NTP,0000,0000,0000,,Бұл кездейсоқтық
Dialogue: 0,0:53:19.39,0:53:24.54,CNsub,NTP,0000,0000,0000,,Мен сені ойлап, кісі өлтірушінің түрін көріп тұрмын.
Dialogue: 0,0:53:25.80,0:53:31.02,CNsub,NTP,0000,0000,0000,,Мен сізді қабылдай алмағандықтан, сіздің шынайы болмысыңыз қандай екенін білмеймін.
Dialogue: 0,0:53:32.68,0:53:36.39,CNsub,NTP,0000,0000,0000,,Төрт жыл бұрын қылмыс жасалған.
Dialogue: 0,0:53:40.92,0:53:44.59,CNsub,NTP,0000,0000,0000,,...Төрт жыл бұрынғы кісі өлтіруге мен кінәлімін.
Dialogue: 0,0:53:45.42,0:53:46.71,CNsub,NTP,0000,0000,0000,,Бұл басқа рәсім.
Dialogue: 0,0:53:46.81,0:53:48.16,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:53:48.42,0:53:49.09,CNsub,NTP,0000,0000,0000,,Алғаш
Dialogue: 0,0:53:54.13,0:53:55.88,CNsub,NTP,0000,0000,0000,,Алғы сөзді еске түсіру
Dialogue: 0,0:53:56.10,0:53:57.38,CNsub,NTP,0000,0000,0000,,Қандай нәрселерді білгіңіз келеді?
Dialogue: 0,0:54:00.42,0:54:01.34,CNsub,NTP,0000,0000,0000,,Алдыңғы…
Dialogue: 0,0:54:03.09,0:54:04.18,CNsub,NTP,0000,0000,0000,,Құрметті…
Dialogue: 0,0:54:05.06,0:54:07.12,CNsub,NTP,0000,0000,0000,,Ол екі әдіспен де қамтылады.
Dialogue: 0,0:54:17.77,0:54:20.52,CNsub,NTP,0000,0000,0000,,Түпнұсқадан бастап ол тәуелсіз болды
Dialogue: 0,0:54:21.03,0:54:22.76,CNsub,NTP,0000,0000,0000,,Дегенмен, зақым келтірмеу үшін заңды міндеттеме жоқ.
Dialogue: 0,0:54:23.11,0:54:25.94,CNsub,NTP,0000,0000,0000,,Өлім жазасы туралы мәліметтер
Dialogue: 0,0:54:26.47,0:54:27.24,CNsub,NTP,0000,0000,0000,,Алғаш
Dialogue: 0,0:54:27.78,0:54:30.44,CNsub,NTP,0000,0000,0000,,Көп адамды өлтіргің келсе
Dialogue: 0,0:54:30.92,0:54:33.99,CNsub,NTP,0000,0000,0000,,Менің де біреуді өлтіргім келмейді.
Dialogue: 0,0:54:34.22,0:54:35.30,CNsub,NTP,0000,0000,0000,,Натажуя
Dialogue: 0,0:54:35.85,0:54:38.19,CNsub,NTP,0000,0000,0000,,Себеп бастаудан ояту
Dialogue: 0,0:54:38.48,0:54:42.13,CNsub,NTP,0000,0000,0000,,Атауы: Арая Сорайдың адам терісін көрсетуі
Dialogue: 0,0:54:42.96,0:54:45.46,CNsub,NTP,0000,0000,0000,,Куротоу-кун Менің шығу тегім
Dialogue: 0,0:54:46.07,0:54:48.40,CNsub,NTP,0000,0000,0000,,«тамақ»
Dialogue: 0,0:54:49.03,0:54:51.29,CNsub,NTP,0000,0000,0000,,Менің пайда болуым және оянуым
Dialogue: 0,0:54:51.71,0:54:52.89,CNsub,NTP,0000,0000,0000,,Тоқтауға болмайды
Dialogue: 0,0:54:53.49,0:54:56.48,CNsub,NTP,0000,0000,0000,,Мен "кісі өлтіруші маньякпын"
Dialogue: 0,0:54:56.99,0:54:57.93,CNsub,NTP,0000,0000,0000,,Көшбасшы
Dialogue: 0,0:54:58.24,0:54:59.12,CNsub,NTP,0000,0000,0000,,Сізге қажет емес пе?
Dialogue: 0,0:54:59.42,0:55:00.70,CNsub,NTP,0000,0000,0000,,Сіз жұмбақ адамсыз
Dialogue: 0,0:55:01.18,0:55:03.56,CNsub,NTP,0000,0000,0000,,Бөлек, мен әңгіменің аяқталғанын түсінемін.
Dialogue: 0,0:55:04.52,0:55:08.53,CNsub,NTP,0000,0000,0000,,Шу Масахарудың оқиғаның қысқаша мазмұны
Dialogue: 0,0:55:09.32,0:55:13.85,CNsub,NTP,0000,0000,0000,,Менің жеке іздеуімнің бір бөлігі «өлтіруші ессіздік»
Dialogue: 0,0:55:15.05,0:55:15.91,CNsub,NTP,0000,0000,0000,,Сіз…
Dialogue: 0,0:55:16.50,0:55:17.69,CNsub,NTP,0000,0000,0000,,Капитал сізге тиесілі...
Dialogue: 0,0:55:18.67,0:55:21.28,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:55:21.87,0:55:24.10,CNsub,NTP,0000,0000,0000,,Мэй Мин Мен оны түсірдім
Dialogue: 0,0:55:24.84,0:55:25.80,CNsub,NTP,0000,0000,0000,,Алдыңғы…
Dialogue: 0,0:55:28.34,0:55:29.80,CNsub,NTP,0000,0000,0000,,Қызғылт сары баланы қалдыру
Dialogue: 0,0:55:30.22,0:55:32.42,CNsub,NTP,0000,0000,0000,,Ойлаудың анықталмаған тәсілі
Dialogue: 0,0:55:35.28,0:55:37.84,CNsub,NTP,0000,0000,0000,,Тәртіпсіздік Себебі мен ерекшемін
Dialogue: 0,0:55:38.74,0:55:40.08,CNsub,NTP,0000,0000,0000,,Дегенмен, әрі қарай талқылау…
Dialogue: 0,0:55:42.92,0:55:44.40,CNsub,NTP,0000,0000,0000,,Сіз жылы және жұмсақсыз.
Dialogue: 0,0:55:45.77,0:55:46.84,CNsub,NTP,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:55:48.04,0:55:51.66,CNsub,NTP,0000,0000,0000,,Бірінші ауысымнан бері таза дос болдың.
Dialogue: 0,0:55:52.24,0:55:55.81,CNsub,NTP,0000,0000,0000,,Мен қазіргі уақытта осы өзіндік сананы сақтауға қабілеттімін.
Dialogue: 0,0:55:56.39,0:55:57.83,CNsub,NTP,0000,0000,0000,,Капитал сен бар болғандықтан.
Dialogue: 0,0:56:01.53,0:56:02.39,CNsub,NTP,0000,0000,0000,,Оны оқып берейін.
Dialogue: 0,0:56:02.56,0:56:03.65,CNsub,NTP,0000,0000,0000,,Бұл кісі өлтірген адам.
Dialogue: 0,0:56:06.94,0:56:07.76,CNsub,NTP,0000,0000,0000,,Оны оқып берейін.
Dialogue: 0,0:56:07.95,0:56:09.07,CNsub,NTP,0000,0000,0000,,Аномалия
Dialogue: 0,0:56:09.46,0:56:11.18,CNsub,NTP,0000,0000,0000,,Басқа сөздер
Dialogue: 0,0:56:12.30,0:56:13.17,CNsub,NTP,0000,0000,0000,,Оны оқып берейін.
Dialogue: 0,0:56:13.57,0:56:14.82,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:56:15.51,0:56:18.14,CNsub,NTP,0000,0000,0000,,Жұмысқа орналасуға үміттену
Dialogue: 0,0:56:28.08,0:56:30.24,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:56:31.99,0:56:33.97,CNsub,NTP,0000,0000,0000,,Төменде қараңыз
Dialogue: 0,0:56:36.23,0:56:37.16,CNsub,NTP,0000,0000,0000,,Алғаш
Dialogue: 0,0:56:45.08,0:56:49.36,CNsub,NTP,0000,0000,0000,,Көмек сұрау.
Dialogue: 0,0:56:49.75,0:56:51.80,CNsub,NTP,0000,0000,0000,,Өткен махаббат сияқты.
Dialogue: 0,0:56:52.27,0:56:54.07,CNsub,NTP,0000,0000,0000,,Мен қайда баруым керек?
Dialogue: 0,0:56:54.32,0:56:55.54,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:56:55.73,0:56:56.76,CNsub,NTP,0000,0000,0000,,Басқа мәселелер
Dialogue: 0,0:56:57.39,0:56:58.65,CNsub,NTP,0000,0000,0000,,Менің сезімім түсінілмейді.
Dialogue: 0,0:56:59.08,0:56:59.81,CNsub,NTP,0000,0000,0000,,Жұмыс орны
Dialogue: 0,0:58:37.50,0:58:38.43,CNsub,NTP,0000,0000,0000,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 0,0:58:42.74,0:58:43.61,CNsub,NTP,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:58:48.80,0:58:50.32,CNsub,NTP,0000,0000,0000,,Сіз осындасыз...
Dialogue: 0,0:58:51.59,0:58:53.81,CNsub,NTP,0000,0000,0000,,Сен кеттің бе?
Dialogue: 0,0:58:54.42,0:58:56.65,CNsub,NTP,0000,0000,0000,,Сыртқы дүниенің қауіптілігі
Dialogue: 0,0:58:59.52,0:59:01.48,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:59:02.16,0:59:04.37,CNsub,NTP,0000,0000,0000,,Сіз қызғылт сары бөлмеде болғанда
Dialogue: 0,0:59:04.94,0:59:06.13,CNsub,NTP,0000,0000,0000,,Маңызды мәліметтер
Dialogue: 0,0:59:06.44,0:59:08.39,CNsub,NTP,0000,0000,0000,,Өрнек Сіз барсыз ба?
Dialogue: 0,0:59:09.61,0:59:11.22,CNsub,NTP,0000,0000,0000,,Ваканья өлімінің сериясы
Dialogue: 0,0:59:11.40,0:59:12.32,CNsub,NTP,0000,0000,0000,,Юкан-кей!
Dialogue: 0,0:59:12.84,0:59:14.98,CNsub,NTP,0000,0000,0000,,«Кісі өлтіру ессіздігі» бар ма?
Dialogue: 0,0:59:16.31,0:59:17.22,CNsub,NTP,0000,0000,0000,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 0,0:59:17.86,0:59:18.93,CNsub,NTP,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:59:19.29,0:59:20.24,CNsub,NTP,0000,0000,0000,,Кайкай
Dialogue: 0,0:59:20.91,0:59:24.10,CNsub,NTP,0000,0000,0000,,Сіз... мүмкін емес өлім және т.б.
Dialogue: 0,0:59:30.33,0:59:31.95,CNsub,NTP,0000,0000,0000,,Мүмкін емес өлім?
Dialogue: 0,0:59:34.01,0:59:36.99,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта тіл белгісіз.
Dialogue: 0,0:59:37.38,0:59:38.58,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:59:39.04,0:59:41.76,CNsub,NTP,0000,0000,0000,,Сіз...көрдіңіз бе?
Dialogue: 0,0:59:42.55,0:59:43.39,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:59:44.34,0:59:46.09,CNsub,NTP,0000,0000,0000,,Кету және басқалар?
Dialogue: 0,0:59:46.31,0:59:47.21,CNsub,NTP,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:59:51.89,0:59:55.54,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:59:55.85,0:59:56.59,CNsub,NTP,0000,0000,0000,,Формула!
Dialogue: 0,0:59:56.99,0:59:58.19,CNsub,NTP,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:59:58.85,1:00:00.03,CNsub,NTP,0000,0000,0000,,Қайдасың, Жороно? Апачай?
Dialogue: 0,1:00:00.36,1:00:02.55,CNsub,NTP,0000,0000,0000,,Мен не істегім келетінін елестете алмаймын.
Dialogue: 0,1:00:03.12,1:00:06.03,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:00:06.53,1:00:08.19,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл...
Dialogue: 0,1:00:08.89,1:00:13.46,CNsub,NTP,0000,0000,0000,,Кісі өлтіруші қылмысты жасағаны үшін кінәлі емес.
Dialogue: 0,1:00:14.56,1:00:17.51,CNsub,NTP,0000,0000,0000,,Менімен әрқашан таныссың қара тунг
Dialogue: 0,1:00:19.08,1:00:22.12,CNsub,NTP,0000,0000,0000,,Мұның себебі ...
Dialogue: 0,1:00:22.24,1:00:24.00,CNsub,NTP,0000,0000,0000,,Бұл дүниеде өлтірілген адам
Dialogue: 0,1:00:25.26,1:00:26.84,CNsub,NTP,0000,0000,0000,,Накая өлімнен құтқарылды.
Dialogue: 0,1:00:27.03,1:00:28.03,CNsub,NTP,0000,0000,0000,,Әрқашан есте сақтаңыз
Dialogue: 0,1:00:29.71,1:00:31.35,CNsub,NTP,0000,0000,0000,,Кайкай Кайкай
Dialogue: 0,1:00:31.94,1:00:32.77,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:00:41.27,1:00:42.11,CNsub,NTP,0000,0000,0000,,Формула!
Dialogue: 0,1:00:50.02,1:00:50.80,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:00:51.60,1:00:52.89,CNsub,NTP,0000,0000,0000,,Сіз қалай өлдіңіз?
Dialogue: 0,1:00:53.68,1:00:55.59,CNsub,NTP,0000,0000,0000,,Мен сенімен кездескім келмейді.
Dialogue: 0,1:01:02.62,1:01:03.37,CNsub,NTP,0000,0000,0000,,3-бөлім: Түрмедегі бандиттермен кездесу
Dialogue: 0,1:01:04.02,1:01:04.82,CNsub,NTP,0000,0000,0000,,Өзімшілдік
Dialogue: 0,1:01:06.67,1:01:07.67,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:01:09.32,1:01:12.00,CNsub,NTP,0000,0000,0000,,Өйткені мен «кісі өлтіруші маньякпын»
Dialogue: 0,1:01:12.89,1:01:14.08,CNsub,NTP,0000,0000,0000,,Сіз мұны қаламайсыз.
Dialogue: 0,1:01:14.81,1:01:16.69,CNsub,NTP,0000,0000,0000,,Сіз қанша адамды өлтірдіңіз?
Dialogue: 0,1:01:17.43,1:01:19.70,CNsub,NTP,0000,0000,0000,,Кездейсоқтық... Ол жай ғана болмай қалады.
Dialogue: 0,1:01:21.11,1:01:22.38,CNsub,NTP,0000,0000,0000,,Дегенмен, бастапқы сапа өзгеруі мүмкін.
Dialogue: 0,1:01:22.96,1:01:24.35,CNsub,NTP,0000,0000,0000,,Мен оны көрдім.
Dialogue: 0,1:01:25.85,1:01:29.13,CNsub,NTP,0000,0000,0000,,Төрт жыл бұрын мені өлтіре жаздады.
Dialogue: 0,1:01:29.69,1:01:32.41,CNsub,NTP,0000,0000,0000,,Осыған байланысты ол тек біреуді өлтіруді білетін адам.
Dialogue: 0,1:01:34.81,1:01:36.45,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл жай ғана.
Dialogue: 0,1:01:36.72,1:01:38.87,CNsub,NTP,0000,0000,0000,,Осыған байланысты бұл жай ғана кісі өлтіруші.
Dialogue: 0,1:01:39.29,1:01:41.35,CNsub,NTP,0000,0000,0000,,Бірақ олай емес.
Dialogue: 0,1:01:42.31,1:01:44.11,CNsub,NTP,0000,0000,0000,,Апат салдарынан мен жалғызбын.
Dialogue: 0,1:01:44.44,1:01:47.32,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:01:48.53,1:01:53.13,CNsub,NTP,0000,0000,0000,,Күннің соңында
Dialogue: 0,1:01:53.71,1:01:56.02,CNsub,NTP,0000,0000,0000,,Бұл өмірдің келуінің көрінісі.
Dialogue: 0,1:01:56.80,1:01:57.85,CNsub,NTP,0000,0000,0000,,Осыған байланысты мен келген жоқпын.
Dialogue: 0,1:01:58.40,1:02:00.18,CNsub,NTP,0000,0000,0000,,Мен сені ешқашан тастамадым.
Dialogue: 0,1:02:02.52,1:02:03.52,CNsub,NTP,0000,0000,0000,,Өмір сыйлай алатын кезіңде өсімдіктерді өсір.
Dialogue: 0,1:02:04.45,1:02:06.90,CNsub,NTP,0000,0000,0000,,Мен оны пайдалануға болатынын түсіндім.
Dialogue: 0,1:02:09.87,1:02:11.89,CNsub,NTP,0000,0000,0000,,Бұл сіздің түсіндірмеңіз
Dialogue: 0,1:02:12.20,1:02:12.96,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:02:13.47,1:02:14.98,CNsub,NTP,0000,0000,0000,,Менімен сөйлескіңіз келмейді.
Dialogue: 0,1:02:15.45,1:02:18.36,CNsub,NTP,0000,0000,0000,,Жеке өлім
Dialogue: 0,1:02:19.57,1:02:21.49,CNsub,NTP,0000,0000,0000,,Сіз бұл өмір үшін маңыздысыз.
Dialogue: 0,1:02:21.98,1:02:25.06,CNsub,NTP,0000,0000,0000,,Өлтіру азабы
Dialogue: 0,1:02:26.38,1:02:28.14,CNsub,NTP,0000,0000,0000,,Қанша адамды өлтіру керек?
Dialogue: 0,1:02:28.53,1:02:30.70,CNsub,NTP,0000,0000,0000,,Айтылуы: «Қанша адам кездейсоқ қайтыс болды?»
Dialogue: 0,1:02:31.49,1:02:32.54,CNsub,NTP,0000,0000,0000,,Тағы бір ойын
Dialogue: 0,1:02:33.00,1:02:35.43,CNsub,NTP,0000,0000,0000,,Оның кездейсоқ болуы мүмкін бе?
Dialogue: 0,1:02:37.13,1:02:39.83,CNsub,NTP,0000,0000,0000,,Сіз өзіңіздің ерік-жігеріңізсіз
Dialogue: 0,1:02:40.58,1:02:42.26,CNsub,NTP,0000,0000,0000,,Адамның қалауы гомологиялық емес
Dialogue: 0,1:02:42.61,1:02:45.64,CNsub,NTP,0000,0000,0000,,Ең дұрысы - адамды өлтіру.
Dialogue: 0,1:02:47.33,1:02:51.47,CNsub,NTP,0000,0000,0000,,Өткен жазда Кең көпірде
Dialogue: 0,1:02:52.09,1:02:55.87,CNsub,NTP,0000,0000,0000,,Өзін-өзі өлтіру
Dialogue: 0,1:02:56.50,1:02:59.86,CNsub,NTP,0000,0000,0000,,Хабарды естігеніңізге сенімдімін.
Dialogue: 0,1:03:00.74,1:03:02.31,CNsub,NTP,0000,0000,0000,,Сіз қанша адамды өлтірдіңіз?
Dialogue: 0,1:03:02.87,1:03:05.65,CNsub,NTP,0000,0000,0000,,Болашақта бұған күмән жоқ.
Dialogue: 0,1:03:06.10,1:03:07.12,CNsub,NTP,0000,0000,0000,,Толық қабілет!
Dialogue: 0,1:03:11.56,1:03:13.05,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:03:14.02,1:03:17.36,CNsub,NTP,0000,0000,0000,,Сіз не істеп жатқаныңызды білесіз бе? !
Dialogue: 0,1:03:17.69,1:03:18.48,CNsub,NTP,0000,0000,0000,,Қара тунг!
Dialogue: 0,1:03:25.85,1:03:30.30,CNsub,NTP,0000,0000,0000,,Өйткені...сен өте жылы әрі жұмсақсың.
Dialogue: 0,1:03:40.06,1:03:41.64,CNsub,NTP,0000,0000,0000,,Сіз қаладан бір нүкте қашықтықтасыз.
Dialogue: 0,1:03:42.46,1:03:43.43,CNsub,NTP,0000,0000,0000,,Менің айтайын дегенім
Dialogue: 0,1:03:43.92,1:03:48.43,CNsub,NTP,0000,0000,0000,,Өрнек ең толық.
Dialogue: 0,1:03:49.69,1:03:51.66,CNsub,NTP,0000,0000,0000,,Өрнек негізсіз Мен...
Dialogue: 0,1:04:24.10,1:04:27.79,CNsub,NTP,0000,0000,0000,,Өйткені...сен өте жылы әрі икемдісің.
Dialogue: 0,1:04:29.32,1:04:34.38,CNsub,NTP,0000,0000,0000,,Шындық... жай ғана білетін бақытты адам
Dialogue: 0,1:04:38.80,1:04:40.94,CNsub,NTP,0000,0000,0000,,Бастапқы оятушы
Dialogue: 0,1:04:41.77,1:04:45.28,CNsub,NTP,0000,0000,0000,,Араяның шындығы – ол миниатюралық мүсін болып қала береді
Dialogue: 0,1:04:46.59,1:04:49.27,CNsub,NTP,0000,0000,0000,,«Шығу тегі» - шығу тегінің аты.
Dialogue: 0,1:04:56.78,1:04:59.19,CNsub,NTP,0000,0000,0000,,Сен Сангсиннің бұрынғы өмірі
Dialogue: 0,1:05:00.53,1:05:02.94,CNsub,NTP,0000,0000,0000,,Мен Тадаяның мүмкін емес растауын жоққа шығармаймын
Dialogue: 0,1:05:04.52,1:05:05.95,CNsub,NTP,0000,0000,0000,,Рухани үйлесімділік Жан
Dialogue: 0,1:05:06.47,1:05:11.93,CNsub,NTP,0000,0000,0000,,Қаладағы барлық тіршілікті алып тастаңыз.
Dialogue: 0,1:05:12.66,1:05:15.64,CNsub,NTP,0000,0000,0000,,Бұрынғы өмір алдыңғы өмір Алдыңғы өмір алдыңғы өмір
Dialogue: 0,1:05:16.17,1:05:20.84,CNsub,NTP,0000,0000,0000,,Артына ізі жоқ реттелген заң, өмір сүрудің ұзақ желісі
Dialogue: 0,1:05:21.44,1:05:23.59,CNsub,NTP,0000,0000,0000,,Сіздің жан дүниеңіздің бастауы
Dialogue: 0,1:05:24.12,1:05:28.02,CNsub,NTP,0000,0000,0000,,Сіз экзистенциалды шыққан жеріңізде өмір сүруіңіз керек.
Dialogue: 0,1:05:30.02,1:05:35.18,CNsub,NTP,0000,0000,0000,,Такинари жоқ тіршілік шығыс пен батыс
Dialogue: 0,1:05:37.35,1:05:43.41,CNsub,NTP,0000,0000,0000,,Болмыс тек себеп пен салдардың бастауы, анықталған заттардың бағыты
Dialogue: 0,1:05:44.25,1:05:48.28,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл сиқырлы әлемде «Шығып» атауы
Dialogue: 0,1:05:48.96,1:05:51.67,CNsub,NTP,0000,0000,0000,,Қысқаша әңгіме: Бұл инстинкт
Dialogue: 0,1:05:52.64,1:05:58.05,CNsub,NTP,0000,0000,0000,,Дегенмен, «бастапқы» тек бір адаммен және бақылаушы тұлғамен туындайды
Dialogue: 0,1:05:58.50,1:06:01.82,CNsub,NTP,0000,0000,0000,,Өзін де, өзгені де көруге мүмкіндігі жоқ хабаршының «шығу тегі».
Dialogue: 0,1:06:02.24,1:06:06.23,CNsub,NTP,0000,0000,0000,,Бұл да дұрыс.
Dialogue: 0,1:06:06.70,1:06:10.10,CNsub,NTP,0000,0000,0000,,Ақ тазалықты жалғыз тоқтату мүмкін емес, және оның өз әрекеттері
Dialogue: 0,1:06:10.77,1:06:14.38,CNsub,NTP,0000,0000,0000,,Ерекше «тағам» шын мәнінде бірегей әрекет түрі болып табылады.
Dialogue: 0,1:06:15.95,1:06:18.41,CNsub,NTP,0000,0000,0000,,Ягокай Араякайкай Канжо және т.б.
Dialogue: 0,1:06:21.67,1:06:22.75,CNsub,NTP,0000,0000,0000,,Қара тунг
Dialogue: 0,1:06:24.05,1:06:26.07,CNsub,NTP,0000,0000,0000,,Табиғи «шығу» - «тамақ»
Dialogue: 0,1:06:26.81,1:06:31.36,CNsub,NTP,0000,0000,0000,,Ақ тазалықтың өткен өміріндегі жыртқыш бір жақты тіршілік иелері
Dialogue: 0,1:06:32.01,1:06:35.87,CNsub,NTP,0000,0000,0000,,Origin Адамның бұрынғы өмір салмағын қосу қабілетін ояту
Dialogue: 0,1:06:38.85,1:06:41.50,CNsub,NTP,0000,0000,0000,,Сіз ең жақсы және қажетсіз адамсыз.
Dialogue: 0,1:06:41.86,1:06:43.89,CNsub,NTP,0000,0000,0000,,Дегенмен, басқа да жабайы жануарлар көп
Dialogue: 0,1:06:44.72,1:06:48.08,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта басқа да жұмыстары «Ақ тазалық» Тұлғаның уақыт мәселесі
Dialogue: 0,1:06:48.50,1:06:53.02,CNsub,NTP,0000,0000,0000,,Алайда, тұлға жойылғанда, басқа шынайы бірлестік, бір салалық дала әскері,
Dialogue: 0,1:06:56.12,1:06:58.51,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:06:58.92,1:07:01.66,CNsub,NTP,0000,0000,0000,,Себеп өзгерді, басқа сиқырлы шебер аяқталды
Dialogue: 0,1:07:02.06,1:07:04.05,CNsub,NTP,0000,0000,0000,,Бұрын өзін-өзі жеңу
Dialogue: 0,1:07:04.73,1:07:05.69,CNsub,NTP,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,1:07:06.46,1:07:08.38,CNsub,NTP,0000,0000,0000,,Хабаршының шығу сиқыры
Dialogue: 0,1:07:08.91,1:07:12.40,CNsub,NTP,0000,0000,0000,,Беруші мен берушінің талантын жетілдірудің сыры осында.
Dialogue: 0,1:07:13.46,1:07:16.28,CNsub,NTP,0000,0000,0000,,Ақ тазалық - бұл өзін-өзі таңдау және ояту «шығу»
Dialogue: 0,1:07:16.83,1:07:22.34,CNsub,NTP,0000,0000,0000,,Басқалары - өз еркімен адамдар.
Dialogue: 0,1:07:23.06,1:07:24.22,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:07:24.78,1:07:28.80,CNsub,NTP,0000,0000,0000,,Қызғылт сары баланың өлімі
Dialogue: 0,1:07:29.32,1:07:32.95,CNsub,NTP,0000,0000,0000,,Бастапқыда ояну – жанның ізденуі.
Dialogue: 0,1:07:33.26,1:07:36.62,CNsub,NTP,0000,0000,0000,,Жоспарлау ізденісі, адам үшін соңғы техника
Dialogue: 0,1:07:37.76,1:07:42.57,CNsub,NTP,0000,0000,0000,,Менің еңбегім тәнге емес, жанға пайдалы.
Dialogue: 0,1:07:44.29,1:07:45.39,CNsub,NTP,0000,0000,0000,,Бұл себеп
Dialogue: 0,1:07:47.15,1:07:50.39,CNsub,NTP,0000,0000,0000,,Алайда бұрынғы болмыстың тұлғасына қалдық әсері бар
Dialogue: 0,1:07:50.71,1:07:52.73,CNsub,NTP,0000,0000,0000,,Басқа мәліметтер қолжетімді болуы мүмкін.
Dialogue: 0,1:07:53.33,1:07:57.97,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:07:58.61,1:08:01.72,CNsub,NTP,0000,0000,0000,,Дегенмен, мәліметтер маңызды емес.
Dialogue: 0,1:08:02.04,1:08:04.78,CNsub,NTP,0000,0000,0000,,Қызмет ету қабілетін әлі де сақтайтын қалыптан тыс тұлғалық дарындылық
Dialogue: 0,1:08:06.89,1:08:11.66,CNsub,NTP,0000,0000,0000,,Оңай ләззат алатыныңыз рас. Қара тунг
Dialogue: 0,1:08:12.42,1:08:15.96,CNsub,NTP,0000,0000,0000,,Мен сенімен кездескім келмейді.
Dialogue: 0,1:08:16.65,1:08:19.68,CNsub,NTP,0000,0000,0000,,Әр түрлі адамдар келу және еңбек келісім-шартымен алмасу рәсімі
Dialogue: 0,1:08:20.74,1:08:24.98,CNsub,NTP,0000,0000,0000,,4 жыл бұрын болған оқиға және өлтіруші із-түссіз жоғалып кетті.
Dialogue: 0,1:08:26.06,1:08:30.17,CNsub,NTP,0000,0000,0000,,Бір адамды өлтіру себебі мынау.
Dialogue: 0,1:08:31.43,1:08:36.16,CNsub,NTP,0000,0000,0000,,Бұл адамның жеке эмоциясы өзінің эго мүмкіндігінен асып кеткендіктен.
Dialogue: 0,1:08:38.48,1:08:40.51,CNsub,NTP,0000,0000,0000,,Ешбір бақылау – махаббат, махаббат – жек көру.
Dialogue: 0,1:08:40.95,1:08:45.67,CNsub,NTP,0000,0000,0000,,Эгоның мүмкіндігі асып кеткенде, белгілі бір құралдар келіп, жойылады.
Dialogue: 0,1:08:46.44,1:08:50.39,CNsub,NTP,0000,0000,0000,,Бұл түрдегі құралдар өлімнің соңына дейін өзгерді.
Dialogue: 0,1:08:52.12,1:08:54.84,CNsub,NTP,0000,0000,0000,,Дегенмен, өліп, өз бетінше өмір сүретін адамдар бар.
Dialogue: 0,1:08:55.06,1:08:57.88,CNsub,NTP,0000,0000,0000,,Мынау кісі өлтіруші, мынау кісі өлтіруші
15-бөлім
Dialogue: 0,1:08:59.07,1:09:04.77,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:09:04.92,1:09:06.29,CNsub,NTP,0000,0000,0000,,Киллер қауымдастығының құрылуы
Dialogue: 0,1:09:06.85,1:09:09.87,CNsub,NTP,0000,0000,0000,,Бұл адамның ниетін бұзу болып табылады.
Dialogue: 0,1:09:10.45,1:09:11.90,CNsub,NTP,0000,0000,0000,,Алайда өлтіру бірдей емес.
Dialogue: 0,1:09:12.50,1:09:17.35,CNsub,NTP,0000,0000,0000,,Өлтіріліп жатқан адам - ​​өлтірілетін адам, бірақ болмыстың мәні - өлтірілген адамның қадір-қасиеті.
Dialogue: 0,1:09:19.17,1:09:24.60,CNsub,NTP,0000,0000,0000,,Біреуді өлтіру - өзін өлтіру...
Dialogue: 0,1:09:26.22,1:09:28.46,CNsub,NTP,0000,0000,0000,,Бұл адам ессіздігінің түпкі мақсаты.
Dialogue: 0,1:09:29.46,1:09:31.17,CNsub,NTP,0000,0000,0000,,Екеуінің есімі
Dialogue: 0,1:09:32.39,1:09:37.36,CNsub,NTP,0000,0000,0000,,Өлтіруші жын – табиғи апат.
Dialogue: 0,1:09:32.39,1:09:37.36,CNsub,NTP,0000,0000,0000,,(Ескерту: «Куджинкио» және «Кутинки» жапондық нұсқасы)
Dialogue: 0,1:09:38.33,1:09:40.87,CNsub,NTP,0000,0000,0000,,Бұл зиянды адам тасымалдауға жарамсыз.
Dialogue: 0,1:09:44.16,1:09:45.56,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:09:46.46,1:09:50.18,CNsub,NTP,0000,0000,0000,,Адам өмірінде бір ғана адам өлтірілуі мүмкін.
Dialogue: 0,1:09:50.63,1:09:52.57,CNsub,NTP,0000,0000,0000,,Мен ояндым...
Dialogue: 0,1:09:54.94,1:10:00.39,CNsub,NTP,0000,0000,0000,,Салтанат алдында атамның сөзі
Dialogue: 0,1:10:01.12,1:10:04.17,CNsub,NTP,0000,0000,0000,,Ресми ережелер мен ережелерді сақтау
Dialogue: 0,1:10:04.53,1:10:06.28,CNsub,NTP,0000,0000,0000,,Қазіргі генералға деген сенімнің жоғалуы
Dialogue: 0,1:10:07.13,1:10:08.13,CNsub,NTP,0000,0000,0000,,Шайқас аяқталды
Dialogue: 0,1:10:08.60,1:10:09.30,CNsub,NTP,0000,0000,0000,,Сізге кету керек
Dialogue: 0,1:10:09.80,1:10:10.36,CNsub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,1:10:10.76,1:10:14.76,CNsub,NTP,0000,0000,0000,,Міне, Нагая жақсы емес.
Dialogue: 0,1:10:16.65,1:10:18.63,CNsub,NTP,0000,0000,0000,,Қорқақ Куротоу көшесі
Dialogue: 0,1:10:19.56,1:10:21.89,CNsub,NTP,0000,0000,0000,,Nyoka Arihiro Meiten қайта қарау
Dialogue: 0,1:11:03.31,1:11:04.19,CNsub,NTP,0000,0000,0000,,Апельсин апа
Dialogue: 0,1:11:06.08,1:11:07.48,CNsub,NTP,0000,0000,0000,,Шатқалдың жоқтығы
Dialogue: 0,1:11:08.98,1:11:10.96,CNsub,NTP,0000,0000,0000,,Телефон қоңырауының немесе басқа капиталдың болмауына байланысты тоқтатылды
Dialogue: 0,1:11:12.46,1:11:13.81,CNsub,NTP,0000,0000,0000,,Шинзеки Каньянаясуке
Dialogue: 0,1:11:14.19,1:11:15.95,CNsub,NTP,0000,0000,0000,,Матарена Онна Нари Рио
Dialogue: 0,1:11:18.15,1:11:19.97,CNsub,NTP,0000,0000,0000,,Басқа қызметтерді тікелей пайдаланғыңыз келмесе,
Dialogue: 0,1:11:20.77,1:11:24.11,CNsub,NTP,0000,0000,0000,,Отбасылық иттің жағдайлары бір-бірінен ерекшеленеді.
Dialogue: 0,1:11:24.83,1:11:29.56,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:11:30.00,1:11:31.98,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,1:11:32.43,1:11:35.14,CNsub,NTP,0000,0000,0000,,Растау уақытының ұзақтығы
Dialogue: 0,1:11:35.62,1:11:39.48,CNsub,NTP,0000,0000,0000,,Менің елестетпейтін бейнем, бірақ өз ойым.
Dialogue: 0,1:11:39.85,1:11:40.51,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,1:11:49.57,1:11:52.46,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыстың жақсы басталуы және орналасуы
Dialogue: 0,1:11:53.20,1:11:54.92,CNsub,NTP,0000,0000,0000,,Сізге есіктен шығу керек
Dialogue: 0,1:11:56.87,1:11:57.85,CNsub,NTP,0000,0000,0000,,Айырмашылығы жоқ
Dialogue: 0,1:13:30.47,1:13:34.42,CNsub,NTP,0000,0000,0000,,Гананың рухы тәрбиеленеді.
Dialogue: 0,1:14:22.76,1:14:23.59,CNsub,NTP,0000,0000,0000,,Маневр жасау
Dialogue: 0,1:14:27.75,1:14:32.61,CNsub,NTP,0000,0000,0000,,Мені өлтіріп, шындықты өзгерт.
Dialogue: 0,1:14:33.55,1:14:35.38,CNsub,NTP,0000,0000,0000,,Екі түрі
Dialogue: 0,1:14:36.19,1:14:37.07,CNsub,NTP,0000,0000,0000,,Фукайхара-кю
Dialogue: 0,1:14:54.79,1:14:57.19,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:14:58.91,1:15:00.98,CNsub,NTP,0000,0000,0000,,Қара тунг!
Dialogue: 0,1:15:29.04,1:15:30.63,CNsub,NTP,0000,0000,0000,,Миякоканаяно
Dialogue: 0,1:15:34.97,1:15:37.23,CNsub,NTP,0000,0000,0000,,Жапон тілінің басқа түрлері
Dialogue: 0,1:15:37.59,1:15:40.77,CNsub,NTP,0000,0000,0000,,Менің жеке арманым
Dialogue: 0,1:15:41.74,1:15:47.36,CNsub,NTP,0000,0000,0000,,Тек азапты және мүмкін емес арман
Dialogue: 0,1:16:00.56,1:16:01.50,CNsub,NTP,0000,0000,0000,,Жылдамдық
Dialogue: 0,1:16:03.09,1:16:05.02,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:16:05.82,1:16:08.53,CNsub,NTP,0000,0000,0000,,Өйткені сен шығыс пен батыстасың
Dialogue: 0,1:16:09.37,1:16:11.75,CNsub,NTP,0000,0000,0000,,Бұл тұрақсыз.
Dialogue: 0,1:16:13.15,1:16:16.41,CNsub,NTP,0000,0000,0000,,Осыған байланысты...
Dialogue: 0,1:16:19.39,1:16:20.45,CNsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:16:21.74,1:16:23.45,CNsub,NTP,0000,0000,0000,,Сізді өлтіруі керек
Dialogue: 0,1:16:25.00,1:16:27.39,CNsub,NTP,0000,0000,0000,,Мүмкін, мен оған жете алмаймын...
Dialogue: 0,1:16:28.22,1:16:31.74,CNsub,NTP,0000,0000,0000,,Өйткені сен менің арманымсың
Dialogue: 0,1:16:32.36,1:16:33.20,CNsub,NTP,0000,0000,0000,,Арман?
Dialogue: 0,1:16:34.28,1:16:40.76,CNsub,NTP,0000,0000,0000,,Мен мүлдем жоғалып кеттім.
Dialogue: 0,1:16:51.41,1:16:52.22,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,1:16:53.82,1:16:57.49,CNsub,NTP,0000,0000,0000,,Мен сені өлтірмеймін
Dialogue: 0,1:16:59.22,1:17:02.70,CNsub,NTP,0000,0000,0000,,Na - түпкі ниет
Dialogue: 0,1:17:03.89,1:17:06.89,CNsub,NTP,0000,0000,0000,,Қайтыс болған адам мен басқа адам арасындағы байланыс
Dialogue: 0,1:17:07.67,1:17:08.88,CNsub,NTP,0000,0000,0000,,Сөз тіркестерін түсіну өте мүмкін емес
Dialogue: 0,1:17:10.07,1:17:13.54,CNsub,NTP,0000,0000,0000,,Жүйе туралы білгісі келетін адамдар
Dialogue: 0,1:17:15.28,1:17:16.17,CNsub,NTP,0000,0000,0000,,Нашуга
Dialogue: 0,1:17:17.41,1:17:18.42,CNsub,NTP,0000,0000,0000,,Азшылық
Dialogue: 0,1:17:19.72,1:17:20.65,CNsub,NTP,0000,0000,0000,,Трагедия
Dialogue: 0,1:17:33.60,1:17:36.25,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:17:39.18,1:17:44.16,CNsub,NTP,0000,0000,0000,,Сол кезде мен өмірден өттім.
Dialogue: 0,1:17:45.14,1:17:48.65,CNsub,NTP,0000,0000,0000,,«Бақытқа жету» армандары
Dialogue: 0,1:17:54.09,1:17:56.90,CNsub,NTP,0000,0000,0000,,Бұл сіздің кінәлі ме?
Dialogue: 0,1:17:59.60,1:18:05.47,CNsub,NTP,0000,0000,0000,,Мен не істерімді білмеймін, бірақ менің көргенім - менің көргенім және мәңгі көретінім.
Dialogue: 0,1:18:07.28,1:18:11.35,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:18:17.24,1:18:21.88,CNsub,NTP,0000,0000,0000,,Ең қуанышты қара тунг ағашы - армандай көрініс.
Dialogue: 0,1:18:22.77,1:18:29.09,CNsub,NTP,0000,0000,0000,,Кісі өлтірушінің кісі өлтірушіні жай ғана білудегі алғашқы тәжірибесінен басқа эмоциялар
Dialogue: 0,1:18:30.21,1:18:33.57,CNsub,NTP,0000,0000,0000,,Na сезімдері «ешқашан кетпейтін арман»
Dialogue: 0,1:18:34.70,1:18:39.25,CNsub,NTP,0000,0000,0000,,Сондықтан менің үмітім де, басқа жазбам да жоқ.
Dialogue: 0,1:18:40.33,1:18:44.64,CNsub,NTP,0000,0000,0000,,Өйткені мен қазір армандамын.
Dialogue: 0,1:19:15.72,1:19:16.84,CNsub,NTP,0000,0000,0000,,Гор
Dialogue: 0,1:19:32.32,1:19:37.25,CNsub,NTP,0000,0000,0000,,Өмір бойы бір адам өлтірілуі керек.
Dialogue: 0,1:19:38.14,1:19:45.06,CNsub,NTP,0000,0000,0000,,Өлгеннен кейін мен ғана өлетінімді ескеріңіз.
Dialogue: 0,1:19:46.16,1:19:47.80,CNsub,NTP,0000,0000,0000,,Сіз өзімшілсіз бе?
Dialogue: 0,1:19:48.38,1:19:53.26,CNsub,NTP,0000,0000,0000,,«Өз өмірің өз өмірің» деген сөз.
Dialogue: 0,1:19:53.51,1:19:55.18,CNsub,NTP,0000,0000,0000,,Бұл рас па?
Dialogue: 0,1:19:55.42,1:19:57.52,CNsub,NTP,0000,0000,0000,,Температура мінез-құлық
Dialogue: 0,1:19:58.11,1:20:00.68,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:20:01.02,1:20:06.82,CNsub,NTP,0000,0000,0000,,Соғыста қанша адам қаза тауып, қаза тапты?
Dialogue: 0,1:20:07.10,1:20:08.91,CNsub,NTP,0000,0000,0000,,Тадано Ичиго
Dialogue: 0,1:20:09.39,1:20:13.88,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:20:14.55,1:20:18.54,CNsub,NTP,0000,0000,0000,,Қайтыс болған, бірақ негізгі тұлға болып табылатын адам.
Dialogue: 0,1:20:18.96,1:20:22.85,CNsub,NTP,0000,0000,0000,,Мәңгілік көрінбейтін сән-салтанат
Dialogue: 0,1:20:23.22,1:20:25.45,CNsub,NTP,0000,0000,0000,,Сондай-ақ заңды жұмыс болмады және адам қайтыс болды.
Dialogue: 0,1:20:26.20,1:20:28.38,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:20:28.73,1:20:30.33,CNsub,NTP,0000,0000,0000,,Қайта қарау рәсімі
Dialogue: 0,1:20:30.88,1:20:36.05,CNsub,NTP,0000,0000,0000,,Әйтсе де өкіметпен кездесуге келген адамның өлімі
Dialogue: 0,1:20:36.84,1:20:39.53,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:20:43.07,1:20:46.47,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:21:15.71,1:21:18.08,CNsub,NTP,0000,0000,0000,,Алыс көз құдайы шын футунг
Dialogue: 0,1:21:18.75,1:21:22.01,CNsub,NTP,0000,0000,0000,,Екі адамды жұмысқа қабылдау рәсімі
Dialogue: 0,1:21:55.15,1:21:57.90,CNsub,NTP,0000,0000,0000,,Мен ештеңе істеген жоқпын.
Dialogue: 0,1:22:18.73,1:22:23.20,CNsub,NTP,0000,0000,0000,,Сіз кеше түнде өле аласыз ба?
Dialogue: 0,1:22:26.51,1:22:29.36,CNsub,NTP,0000,0000,0000,,Сен Мин Айхи Гамасара мүсінін өлтірген маньяк
Dialogue: 0,1:22:37.01,1:22:38.06,CNsub,NTP,0000,0000,0000,,Жылдамдық
Dialogue: 0,1:22:50.59,1:22:53.97,CNsub,NTP,0000,0000,0000,,Бірінші рет қайтыс болған адам
Dialogue: 0,1:23:03.72,1:23:07.75,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:23:16.60,1:23:20.03,CNsub,NTP,0000,0000,0000,,Мен осындамын
Dialogue: 0,1:23:22.53,1:23:24.80,CNsub,NTP,0000,0000,0000,,Адамды қалай өлтіресің?
Dialogue: 0,1:23:25.93,1:23:28.28,CNsub,NTP,0000,0000,0000,,Мен адамдарды өлтіруге ақымақ емеспін.
Dialogue: 0,1:23:30.73,1:23:32.34,CNsub,NTP,0000,0000,0000,,Мен жай ғана ойланып отырмын
Dialogue: 0,1:23:33.64,1:23:36.10,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:23:37.38,1:23:39.93,CNsub,NTP,0000,0000,0000,,Қалыпты өмір сүре алатыныңызға сеніңіз.
Dialogue: 0,1:23:43.45,1:23:48.07,CNsub,NTP,0000,0000,0000,,Осыған байланысты кісі өлтірушінің ессіздігінің процедурасын аяқтау керек.
Dialogue: 0,1:23:52.37,1:23:53.38,CNsub,NTP,0000,0000,0000,,Барлығы…
Dialogue: 0,1:23:54.89,1:23:56.69,CNsub,NTP,0000,0000,0000,,Миякокай және т.б.
Dialogue: 0,1:24:02.11,1:24:05.70,CNsub,NTP,0000,0000,0000,,Басқа себептерге байланысты
Dialogue: 0,1:24:09.10,1:24:13.50,CNsub,NTP,0000,0000,0000,,Мен не істерімді білмеймін.
Dialogue: 0,1:24:19.59,1:24:27.60,CNsub,NTP,0000,0000,0000,,Сондықтан мен жұмысқа орналаса алмадым.
Dialogue: 0,1:24:41.52,1:24:43.80,CNsub,NTP,0000,0000,0000,,Джикоға ұқсас шынайы бейне
Dialogue: 0,1:25:09.35,1:25:10.29,CNsub,NTP,0000,0000,0000,,Инелердің түрлері
Dialogue: 0,1:25:31.99,1:25:35.07,CNsub,NTP,0000,0000,0000,,Сен келмесең, қиналамын.
Dialogue: 0,1:25:56.32,1:25:57.50,CNsub,NTP,0000,0000,0000,,Джиорно, жараландың ба?
Dialogue: 0,1:25:59.45,1:26:03.80,CNsub,NTP,0000,0000,0000,,Топтаманы жиналыстан алып тастау себебі
Dialogue: 0,1:26:52.42,1:26:53.51,CNsub,NTP,0000,0000,0000,,Фури
Dialogue: 0,1:26:54.78,1:26:57.16,CNsub,NTP,0000,0000,0000,,Өзімді ойлағым келмейтін жер.
Dialogue: 0,1:27:02.14,1:27:03.12,CNsub,NTP,0000,0000,0000,,Негізгі ойлар
Dialogue: 0,1:27:04.52,1:27:05.98,CNsub,NTP,0000,0000,0000,,Реверсия
Dialogue: 0,1:27:09.04,1:27:10.39,CNsub,NTP,0000,0000,0000,,Өзіндік үйге жету
Dialogue: 0,1:27:11.68,1:27:16.09,CNsub,NTP,0000,0000,0000,,Мен бастапқы адамға барған кезде
Dialogue: 0,1:27:22.72,1:27:25.10,CNsub,NTP,0000,0000,0000,,Маған айқайлаудың қажеті жоқ.
Dialogue: 0,1:27:29.41,1:27:31.95,CNsub,NTP,0000,0000,0000,,Нәтижесінде сіз топты бағыттай алмайсыз
Dialogue: 0,1:27:32.13,1:27:32.91,CNsub,NTP,0000,0000,0000,,Алғаш
Dialogue: 0,1:27:36.98,1:27:38.71,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз
Dialogue: 0,1:27:38.86,1:27:41.73,CNsub,NTP,0000,0000,0000,,Мен туралы шынайы мағына;
Dialogue: 0,1:27:44.48,1:27:47.25,CNsub,NTP,0000,0000,0000,,Төрт жыл бұрын мен бірінші өлтірілдім.
Dialogue: 0,1:27:47.43,1:27:49.98,CNsub,NTP,0000,0000,0000,,Шабуыл аяқталып, басқалары қайтыс болды.
Dialogue: 0,1:27:50.52,1:27:52.64,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:27:55.02,1:27:57.05,CNsub,NTP,0000,0000,0000,,Жолмен жылдам таныстыру
Dialogue: 0,1:27:57.72,1:28:01.99,CNsub,NTP,0000,0000,0000,,Нагая Фукайсей Нарухито Ассасин
Dialogue: 0,1:28:05.46,1:28:07.61,CNsub,NTP,0000,0000,0000,,Менің өмірімде жоқ
Dialogue: 0,1:28:08.55,1:28:12.49,CNsub,NTP,0000,0000,0000,,Жедел жеткізу осында.
Dialogue: 0,1:28:13.34,1:28:17.54,CNsub,NTP,0000,0000,0000,,Мен жолды осылай білдім.
Dialogue: 0,1:28:18.11,1:28:20.32,CNsub,NTP,0000,0000,0000,,Мәліметтерді осы жерден оқыңыз.
Dialogue: 0,1:28:20.94,1:28:24.39,CNsub,NTP,0000,0000,0000,,Менімен қалай жүресің?
Dialogue: 0,1:28:25.13,1:28:26.72,CNsub,NTP,0000,0000,0000,,Сіз менімен бірге жүре алмайсыз
Dialogue: 0,1:28:27.55,1:28:30.99,CNsub,NTP,0000,0000,0000,,Өйткені өткенде улы өнімнің бір сәтті үлгісі қалада ешқашан пайда болған емес.
Dialogue: 0,1:28:31.87,1:28:34.70,CNsub,NTP,0000,0000,0000,,Ойлану межелі жерге жетті.
Dialogue: 0,1:28:35.07,1:28:38.03,CNsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,1:28:38.45,1:28:41.49,CNsub,NTP,0000,0000,0000,,Менің ойым және менің серігім
Dialogue: 0,1:28:42.03,1:28:44.94,CNsub,NTP,0000,0000,0000,,Алайда басқа түрлер тізімнен шығарылуы мүмкін.
Dialogue: 0,1:28:45.53,1:28:48.41,CNsub,NTP,0000,0000,0000,,Жасанды өндіріс мүмкін емес.
Dialogue: 0,1:28:49.07,1:28:52.58,CNsub,NTP,0000,0000,0000,,Бұл аудандағы каннабистің түрі.
Dialogue: 0,1:28:53.07,1:28:55.72,CNsub,NTP,0000,0000,0000,,Каннабис бар ма, жоқ па
Dialogue: 0,1:28:56.07,1:28:58.13,CNsub,NTP,0000,0000,0000,,Сәйкессіздік және сәйкессіздік
Dialogue: 0,1:28:58.47,1:29:00.98,CNsub,NTP,0000,0000,0000,,Ағзада ыдырамайтын улы зат.
Dialogue: 0,1:29:01.29,1:29:06.05,CNsub,NTP,0000,0000,0000,,Ондаған шама ретін шығарып алыңыз
Dialogue: 0,1:29:06.20,1:29:08.06,CNsub,NTP,0000,0000,0000,,Бұл өте улы өнім.
Dialogue: 0,1:29:08.78,1:29:12.95,CNsub,NTP,0000,0000,0000,,Қан микросхемасы аяқталғаннан кейін оны бірнеше ондаған адам пайдалана алды.
Dialogue: 0,1:29:13.62,1:29:17.16,CNsub,NTP,0000,0000,0000,,Бұл мүмкін жыныстық адам.
Dialogue: 0,1:29:17.94,1:29:22.04,CNsub,NTP,0000,0000,0000,,Бұл менің ерекше қан уларым.
Dialogue: 0,1:29:23.19,1:29:25.54,CNsub,NTP,0000,0000,0000,,Қабылданғаннан кейін белгілі бір адамдарға қарсы қолдануға болатын кең таралған улы өнімдердің тізімі.
Dialogue: 0,1:29:25.65,1:29:27.95,CNsub,NTP,0000,0000,0000,,Ұшқышсыз тұру салдарынан улану салдарынан болған өлім
Dialogue: 0,1:29:28.66,1:29:32.11,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:29:32.62,1:29:36.06,CNsub,NTP,0000,0000,0000,,Нәтижесінде мен өзім қалаған кітапты ала аламын.
Dialogue: 0,1:29:36.84,1:29:39.53,CNsub,NTP,0000,0000,0000,,Шуичи төрт адамды өлтірді.
Dialogue: 0,1:29:40.12,1:29:42.58,CNsub,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,1:29:43.10,1:29:45.36,CNsub,NTP,0000,0000,0000,,Менде басқа адамдар үшін жерді жобалауда ерекше артықшылықтар бар.
Dialogue: 0,1:29:45.67,1:29:48.27,CNsub,NTP,0000,0000,0000,,Мұны ешқандай шектеусіз жасауға болады.
Dialogue: 0,1:29:48.77,1:29:51.96,CNsub,NTP,0000,0000,0000,,Сенің осында болуыңның және осында болуыңның себебі осы.
Dialogue: 0,1:29:52.39,1:29:55.48,CNsub,NTP,0000,0000,0000,,Мағынасы жай ғана дүниеде екеніңді білдіреді
Dialogue: 0,1:29:55.75,1:29:57.22,CNsub,NTP,0000,0000,0000,,Біз бұрын соңды кездеспеген дүние
Dialogue: 0,1:29:57.74,1:30:01.89,CNsub,NTP,0000,0000,0000,,Бұл сіздің өлуіңіз үшін жақсы тәжірибе.
Dialogue: 0,1:30:05.95,1:30:08.27,CNsub,NTP,0000,0000,0000,,……
Dialogue: 0,1:30:08.53,1:30:11.73,CNsub,NTP,0000,0000,0000,,Өзіңіз үшін алаңдамаңыз.
Dialogue: 0,1:31:01.43,1:31:05.33,CNsub,NTP,0000,0000,0000,,Сіз тұтынатын каннабис мөлшері қалыпты мөлшерден 10 есе көп.
Dialogue: 0,1:31:07.21,1:31:09.23,CNsub,NTP,0000,0000,0000,,Егер сіз бұл жерді қараусыз қалдырсаңыз, сіз өлесіз.
Dialogue: 0,1:31:24.54,1:31:26.35,CNsub,NTP,0000,0000,0000,,Қара пауловнияны қайдан сатып алуға болады
Dialogue: 0,1:31:27.58,1:31:31.48,CNsub,NTP,0000,0000,0000,,Дүниеге өз еркімізден түсейік
Dialogue: 0,1:31:33.72,1:31:36.58,CNsub,NTP,0000,0000,0000,,Осыдан кейін мен ерекше болмыспен дүниеге келдім.
Dialogue: 0,1:31:40.56,1:31:44.14,CNsub,NTP,0000,0000,0000,,Тамақ іше алмайсың, бірақ өлдің.
Dialogue: 0,1:32:02.23,1:32:03.73,CNsub,NTP,0000,0000,0000,,Каня
Dialogue: 0,1:32:10.48,1:32:11.31,CNsub,NTP,0000,0000,0000,,Кения
Dialogue: 0,1:32:14.99,1:32:16.63,CNsub,NTP,0000,0000,0000,,Сіз тамақтанғыңыз келмейді ме?
Dialogue: 0,1:32:17.01,1:32:20.40,CNsub,NTP,0000,0000,0000,,Ағзаңда өмір сүрмейтін улы зат.
Dialogue: 0,1:32:21.10,1:32:24.46,CNsub,NTP,0000,0000,0000,,Шығарма – кәдімгі тіршіліктің өтуі; шығарма – ерекше болмыстың өтуі.
Dialogue: 0,1:32:24.73,1:32:27.68,CNsub,NTP,0000,0000,0000,,Өзгеріс жолын түбегейлі қажетсіз түсіну
Dialogue: 0,1:32:30.15,1:32:31.03,CNsub,NTP,0000,0000,0000,,Жылдамдық
Dialogue: 0,1:32:38.33,1:32:41.32,CNsub,NTP,0000,0000,0000,,Өйткені бұл сізге ұнамайды
Dialogue: 0,1:32:44.28,1:32:47.65,CNsub,NTP,0000,0000,0000,,Жапон тіліндегі «Қалыпты».
Dialogue: 0,1:32:48.56,1:32:52.56,CNsub,NTP,0000,0000,0000,,Маған өз талантым керек емес... Ерекше болмысты дамыту үшін менің талантым қажет емес
Dialogue: 0,1:32:54.96,1:32:58.59,CNsub,NTP,0000,0000,0000,,Сіз астанада бір нүктеден ауытқусыз.
Dialogue: 0,1:32:58.89,1:33:00.84,CNsub,NTP,0000,0000,0000,,Жұмбақ - сенің алдындағы.
Dialogue: 0,1:33:01.62,1:33:04.09,CNsub,NTP,0000,0000,0000,,Сіздің біртүрлі тіршілігіңіздің арқасында сіз қазір тірісіз.
Dialogue: 0,1:33:04.49,1:33:09.09,CNsub,NTP,0000,0000,0000,,Бұл сенің қашуың.
Dialogue: 0,1:33:09.73,1:33:13.85,CNsub,NTP,0000,0000,0000,,Өздігінен сөйлеу қалыпты емес, ал қалыптан тыс нәрселер табиғи.
Dialogue: 0,1:33:14.26,1:33:15.25,CNsub,NTP,0000,0000,0000,,Жабық тұмсық
Dialogue: 0,1:33:16.62,1:33:20.06,CNsub,NTP,0000,0000,0000,,`` Маньяк өлтіруші '' танымал есім.
Dialogue: 0,1:33:20.57,1:33:21.60,CNsub,NTP,0000,0000,0000,,Жабық тұмсық
Dialogue: 0,1:33:22.63,1:33:26.45,CNsub,NTP,0000,0000,0000,,Сезбеудің азабын сезінесің
Dialogue: 0,1:33:27.74,1:33:29.93,CNsub,NTP,0000,0000,0000,,Жапон стилі ерекше емес.
Dialogue: 0,1:33:30.71,1:33:32.61,CNsub,NTP,0000,0000,0000,,Адамдардың бір-біріне қарама-қайшы екі түрі бар.
Dialogue: 0,1:33:34.23,1:33:35.39,CNsub,NTP,0000,0000,0000,,Өлген адам
Dialogue: 0,1:33:36.01,1:33:38.73,CNsub,NTP,0000,0000,0000,,Бұлтартпас мойындау - өзін-өзі айыптау
Dialogue: 0,1:33:39.97,1:33:41.06,CNsub,NTP,0000,0000,0000,,Жиналыстан қашу
Dialogue: 0,1:33:41.32,1:33:44.84,CNsub,NTP,0000,0000,0000,,Қабілетінен айырылған маниакалды қашқын.
Dialogue: 0,1:33:46.79,1:33:50.54,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:33:50.94,1:33:53.03,CNsub,NTP,0000,0000,0000,,Сізге қара тунг ұнайды
Dialogue: 0,1:34:18.99,1:34:20.78,CNsub,NTP,0000,0000,0000,,Және ол бірте-бірте сынып, бөлшектерге айналып барады
Dialogue: 0,1:34:21.66,1:34:23.91,CNsub,NTP,0000,0000,0000,,Бұл менің дағдыларымды бірінші рет өзгертуім.
Dialogue: 0,1:35:06.38,1:35:09.37,CNsub,NTP,0000,0000,0000,,Бас бармағын ұстап, тамырын тісте.
Dialogue: 0,1:35:15.16,1:35:16.80,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:35:17.63,1:35:20.04,CNsub,NTP,0000,0000,0000,,Бұл кісі өлтіру маниясы
Dialogue: 0,1:35:25.60,1:35:28.03,CNsub,NTP,0000,0000,0000,,Келесі жолы, бірінші рет, екінші рет
Dialogue: 0,1:35:28.61,1:35:31.70,CNsub,NTP,0000,0000,0000,,Мен сені өлтіру үшін келдім.
Dialogue: 0,1:35:32.47,1:35:34.18,CNsub,NTP,0000,0000,0000,,Жақында
Dialogue: 0,1:35:34.71,1:35:35.42,CNsub,NTP,0000,0000,0000,,Келесі жолы
Dialogue: 0,1:35:38.73,1:35:41.23,CNsub,NTP,0000,0000,0000,,Мен талантты емеспін
Dialogue: 0,1:35:42.27,1:35:44.04,CNsub,NTP,0000,0000,0000,,……
Dialogue: 0,1:35:44.99,1:35:48.62,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,1:36:15.24,1:36:17.77,CNsub,NTP,0000,0000,0000,,Астанаға қарсы көтеріліс
Dialogue: 0,1:36:18.12,1:36:19.80,CNsub,NTP,0000,0000,0000,,Мен қандай істермен айналысамын?
Dialogue: 0,1:36:20.18,1:36:22.18,CNsub,NTP,0000,0000,0000,,Мен сені өлтіремін.
Dialogue: 0,1:36:22.46,1:36:26.21,CNsub,NTP,0000,0000,0000,,Бірінші қадамым сол жерге жету болды.
Dialogue: 0,1:36:27.21,1:36:31.35,CNsub,NTP,0000,0000,0000,,Бұл сіз Нариге қонаққа келген жер.
Dialogue: 0,1:36:38.32,1:36:44.46,CNsub,NTP,0000,0000,0000,,Сіз орыннан шыққан кезде
Dialogue: 0,1:36:57.05,1:36:59.41,CNsub,NTP,0000,0000,0000,,Сіз…сіз…
Dialogue: 0,1:37:04.12,1:37:07.83,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:37:18.37,1:37:22.14,CNsub,NTP,0000,0000,0000,,Өлген кезде
Dialogue: 0,1:37:46.89,1:37:48.63,CNsub,NTP,0000,0000,0000,,Мен сізді және басқаларды алып тастадым.
Dialogue: 0,1:37:48.90,1:37:51.02,CNsub,NTP,0000,0000,0000,,Сіз еркін оқи аласыз
Dialogue: 0,1:37:51.81,1:37:53.08,CNsub,NTP,0000,0000,0000,,Каньяная үйі
Dialogue: 0,1:37:53.52,1:37:56.79,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:37:57.79,1:38:01.78,CNsub,NTP,0000,0000,0000,,Мен не айтарымды білмеймін.
Dialogue: 0,1:37:57.20,1:38:00.50,CNsub,NTP,0000,0000,0000,,Басқаша айтқанда, мен мүлдем қарама-қайшымын.
Dialogue: 0,1:38:01.03,1:38:04.23,CNsub,NTP,0000,0000,0000,,Мен осы жүздің бейнесімін.
Dialogue: 0,1:38:02.75,1:38:04.79,CNsub,NTP,0000,0000,0000,,Маған айтсаң, қадірі жоқ.
Dialogue: 0,1:38:05.12,1:38:06.39,CNsub,NTP,0000,0000,0000,,Сіз одан бұрын... құтыла аласыз ба?
Dialogue: 0,1:38:07.83,1:38:12.34,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:38:25.61,1:38:27.49,CNsub,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,1:38:32.07,1:38:33.92,CNsub,NTP,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,1:38:34.74,1:38:37.85,CNsub,NTP,0000,0000,0000,,Бұл жерде менің мүсінім бар.
Dialogue: 0,1:39:05.79,1:39:06.69,CNsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,1:39:08.50,1:39:09.55,CNsub,NTP,0000,0000,0000,,Бар болғаны.
Dialogue: 0,1:39:10.38,1:39:11.78,CNsub,NTP,0000,0000,0000,,Жай ғана күлгім келеді
Dialogue: 0,1:39:12.41,1:39:13.82,CNsub,NTP,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,1:39:33.57,1:39:34.62,CNsub,NTP,0000,0000,0000,,Бар болғаны.
Dialogue: 0,1:39:35.48,1:39:36.81,CNsub,NTP,0000,0000,0000,,Тек іске қосыңыз және іске қосыңыз
Dialogue: 0,1:39:37.50,1:39:38.73,CNsub,NTP,0000,0000,0000,,Танысқаныма қуаныштымын
Dialogue: 0,1:40:07.44,1:40:09.89,CNsub,NTP,0000,0000,0000,,Біз бәріміз бір аймақта өмір сүруге қабілеттіміз.
Dialogue: 0,1:40:10.35,1:40:11.60,CNsub,NTP,0000,0000,0000,,Күлімсірегенде, оқиға жалғасады
Dialogue: 0,1:40:16.66,1:40:18.26,CNsub,NTP,0000,0000,0000,,Бұл тіркес – менің тура сөзім.
Dialogue: 0,1:40:19.49,1:40:21.50,CNsub,NTP,0000,0000,0000,,Менімен үмітті адамдар сөйлесе алады
Dialogue: 0,1:41:01.03,1:41:02.06,CNsub,NTP,0000,0000,0000,,На…
Dialogue: 0,1:41:03.32,1:41:04.38,CNsub,NTP,0000,0000,0000,,Шынайы принциптер
Dialogue: 0,1:41:05.60,1:41:08.98,CNsub,NTP,0000,0000,0000,,Арманшыл күндізгі балаға
Dialogue: 0,1:41:16.69,1:41:17.76,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,1:41:20.83,1:41:23.26,CNsub,NTP,0000,0000,0000,,Алайда олай емес.
Dialogue: 0,1:41:24.75,1:41:27.32,CNsub,NTP,0000,0000,0000,,Гачидо-кай толығымен жоғалды
Dialogue: 0,1:41:28.25,1:41:29.17,CNsub,NTP,0000,0000,0000,,Осы сияқты дереу жеткізу…
Dialogue: 0,1:41:33.04,1:41:33.91,CNsub,NTP,0000,0000,0000,,Жедел жеткізу әдісі
Dialogue: 0,1:41:35.95,1:41:38.44,CNsub,NTP,0000,0000,0000,,Бұл мені заңсыз өлтірген адам.
Dialogue: 0,1:42:58.94,1:43:00.16,CNsub,NTP,0000,0000,0000,,Тоқтату
Dialogue: 0,1:43:01.64,1:43:04.15,CNsub,NTP,0000,0000,0000,,Котоя Кайфурёя
Dialogue: 0,1:43:05.93,1:43:10.24,CNsub,NTP,0000,0000,0000,,Бүкіл денесі лай жер, сонымен қатар тапсырыс беруші.
Dialogue: 0,1:43:22.20,1:43:25.76,CNsub,NTP,0000,0000,0000,,Есептеулер қалай орындалады.
Dialogue: 0,1:43:27.64,1:43:30.12,CNsub,NTP,0000,0000,0000,,Меймей Арина Ньо Юген Ничико
Dialogue: 0,1:43:31.72,1:43:35.34,CNsub,NTP,0000,0000,0000,,Қандай шындық...
Dialogue: 0,1:44:07.87,1:44:09.05,CNsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:44:12.37,1:44:13.30,CNsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:44:33.99,1:44:34.85,CNsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:44:40.59,1:44:43.47,CNsub,NTP,0000,0000,0000,,Мені қалай өлтірдің?
Dialogue: 0,1:44:44.31,1:44:46.24,CNsub,NTP,0000,0000,0000,,Бұрын қалай өлдіңіз...
Dialogue: 0,1:44:51.17,1:44:53.64,CNsub,NTP,0000,0000,0000,,Сіз бақытты бола аласыз деп үміттенемін
Dialogue: 0,1:44:55.96,1:44:58.38,CNsub,NTP,0000,0000,0000,,Егер сіз оны қайта алғыңыз келмесе
Dialogue: 0,1:45:03.33,1:45:06.96,CNsub,NTP,0000,0000,0000,,Себебі...себебі мен сені жақсы көремін
Dialogue: 0,1:46:06.58,1:46:07.57,CNsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:46:51.88,1:46:52.65,CNsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,1:47:24.19,1:47:26.03,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,1:47:38.79,1:47:41.08,CNsub,NTP,0000,0000,0000,,Сіз Қара Тунға жылап отырсыз
Dialogue: 0,1:47:49.79,1:47:51.94,CNsub,NTP,0000,0000,0000,,Мен өлі ақпын
Dialogue: 0,1:47:52.89,1:47:53.70,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,1:48:05.89,1:48:08.44,CNsub,NTP,0000,0000,0000,,Мен адасып қалдым
Dialogue: 0,1:48:09.12,1:48:10.79,CNsub,NTP,0000,0000,0000,,Алайда бұл қолданылмайды.
Dialogue: 0,1:48:12.67,1:48:16.55,CNsub,NTP,0000,0000,0000,,Жоғалтқаныңыз үшін кешірім сұраймын.
Dialogue: 0,1:48:17.83,1:48:20.20,CNsub,NTP,0000,0000,0000,,Жазда жоғалған
Dialogue: 0,1:48:20.59,1:48:22.94,CNsub,NTP,0000,0000,0000,,Саған күлемін деген алғашқы антым
Dialogue: 0,1:48:27.35,1:48:30.19,CNsub,NTP,0000,0000,0000,,Мен сатқындық жасағаны үшін кінәлі емеспін.
Dialogue: 0,1:48:31.10,1:48:34.67,CNsub,NTP,0000,0000,0000,,Өйткені мен өлдім.
Dialogue: 0,1:48:36.57,1:48:39.86,CNsub,NTP,0000,0000,0000,,Өлімге тікелей келді. Өлім сәтінде тікелей келді
Dialogue: 0,1:48:40.58,1:48:42.85,CNsub,NTP,0000,0000,0000,,Жалғыз қалғанда жалғызсың
Dialogue: 0,1:48:46.05,1:48:48.36,CNsub,NTP,0000,0000,0000,,Мен өлдім...
Dialogue: 0,1:48:51.35,1:48:53.93,CNsub,NTP,0000,0000,0000,,Мені өлтірген адам екінші емес деймін.
Dialogue: 0,1:48:54.57,1:48:57.85,CNsub,NTP,0000,0000,0000,,Ықтимал және бұлтартпас сақтау уәдесі шындық.
Dialogue: 0,1:48:58.94,1:49:04.04,CNsub,NTP,0000,0000,0000,,Келесіде туылғанда өмірден айырылдым.
Dialogue: 0,1:49:04.68,1:49:08.29,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:49:09.15,1:49:12.32,CNsub,NTP,0000,0000,0000,,Оны сенімен араластыру мүмкін емес.
Dialogue: 0,1:49:49.22,1:49:50.12,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:50:00.44,1:50:03.96,CNsub,NTP,0000,0000,0000,,Менің өмірім астанадан азат болады.
Dialogue: 0,0:00:00.00,0:00:00.00,CNsub,NTP,0000,0000,0000,,//ED
Dialogue: 0,1:56:42.25,1:56:46.70,CNsub,NTP,0000,0000,0000,,Шындықтың нәтижесінде сіз ауруды бірінші орыннан зерттей аласыз.
Dialogue: 0,1:56:47.97,1:56:49.89,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:56:50.51,1:56:53.56,CNsub,NTP,0000,0000,0000,,Ауруханаға келгенде келесі мақаланы оқып шығыңыз.
Dialogue: 0,1:56:54.12,1:56:55.62,CNsub,NTP,0000,0000,0000,,Гатокай туралы естеліктер
Dialogue: 0,1:56:56.14,1:56:57.28,CNsub,NTP,0000,0000,0000,,Нашу өлім заңы
Dialogue: 0,1:56:59.10,1:57:00.20,CNsub,NTP,0000,0000,0000,,Сіздің сол көзіңіз…
Dialogue: 0,1:57:02.01,1:57:03.91,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:57:09.71,1:57:13.06,CNsub,NTP,0000,0000,0000,,Бір сөйлемде тыныш дауысты алуға болады.
Dialogue: 0,1:57:13.40,1:57:16.40,CNsub,NTP,0000,0000,0000,,Мен әйелдің болашағын көре аламын.
Dialogue: 0,1:57:16.78,1:57:22.70,CNsub,NTP,0000,0000,0000,,「 」
Dialogue: 0,1:57:23.35,1:57:26.34,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:57:27.27,1:57:29.21,CNsub,NTP,0000,0000,0000,,Сіз кенет кеуіп қалдыңыз.
Dialogue: 0,1:57:30.29,1:57:32.81,CNsub,NTP,0000,0000,0000,,Құрғақ? Қарызға алынған иық пен таяқ
Dialogue: 0,1:57:33.76,1:57:35.12,CNsub,NTP,0000,0000,0000,,Өлу менің құрметім.
Dialogue: 0,1:57:35.37,1:57:36.96,CNsub,NTP,0000,0000,0000,,Бұл адамды тағайындау аяқталды.
Dialogue: 0,1:57:39.62,1:57:42.18,CNsub,NTP,0000,0000,0000,,Бұл мәселе бойынша не білуім керек?
Dialogue: 0,1:57:42.84,1:57:44.06,CNsub,NTP,0000,0000,0000,,Себебі мен сенің солай еткеніңді қалаймын.
Dialogue: 0,1:57:45.05,1:57:46.66,CNsub,NTP,0000,0000,0000,,Әдейі емес әңгіме аяқталды
Dialogue: 0,1:57:49.11,1:57:51.04,CNsub,NTP,0000,0000,0000,,Бұл менің ниетім де емес...
Dialogue: 0,1:57:51.89,1:57:55.34,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл менің еңбек жолымның басы.
Dialogue: 0,1:57:56.10,1:57:57.40,CNsub,NTP,0000,0000,0000,,Тіркелу жақсы.
Dialogue: 0,1:57:57.71,1:57:58.70,CNsub,NTP,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,1:58:04.12,1:58:08.10,CNsub,NTP,0000,0000,0000,,Сіз анық сөйлей алмайсыз.
Dialogue: 0,1:58:09.03,1:58:11.05,CNsub,NTP,0000,0000,0000,,Өзіңнің сөзің өзіңсің.
Dialogue: 0,1:58:13.68,1:58:14.69,CNsub,NTP,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:58:15.50,1:58:19.42,CNsub,NTP,0000,0000,0000,,2000 жыл бұрын басталған.
Dialogue: 0,1:58:20.35,1:58:21.01,CNsub,NTP,0000,0000,0000,,Бар болу және бақыт
Dialogue: 0,1:58:21.86,1:58:26.14,CNsub,NTP,0000,0000,0000,,Сондықтан есептеу формуласы қажет емес.
Dialogue: 0,1:58:30.31,1:58:32.59,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:58:32.83,1:58:34.35,CNsub,NTP,0000,0000,0000,,Бұл туралы айтқыңыз келмесе
Dialogue: 0,1:58:35.34,1:58:38.03,CNsub,NTP,0000,0000,0000,,Бұрын ол қабылданбаған.
Dialogue: 0,1:58:38.89,1:58:40.22,CNsub,NTP,0000,0000,0000,,Бұл да жақсы емес.
Dialogue: 0,1:58:44.90,1:58:46.39,CNsub,NTP,0000,0000,0000,,Менің есімімді Каня жазған
Dialogue: 0,1:58:47.23,1:58:51.69,CNsub,NTP,0000,0000,0000,,Өзгермейтін бар өрнектер
Dialogue: 0,1:59:04.08,1:59:05.70,CNsub,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,1:59:07.93,1:59:11.75,CNsub,NTP,0000,0000,0000,,Менің ойымша, бұл Шығыста немесе Батыста қысқа қылыш емес, бірақ бұл басқа.
Dialogue: 0,1:59:12.36,1:59:14.30,CNsub,NTP,0000,0000,0000,,Бұл жай ғана қол.
Dialogue: 0,1:59:15.60,1:59:20.80,CNsub,NTP,0000,0000,0000,,Осыдан кейін мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,1:59:22.29,1:59:25.04,CNsub,NTP,0000,0000,0000,,Сонымен менің әңгімем аяқталды.
Dialogue: 0,1:59:25.94,1:59:30.91,CNsub,NTP,0000,0000,0000,,Мен қазіргі өзімді, алдыңғы өрнекті алдым
Dialogue: 0,1:59:31.45,1:59:33.29,CNsub,NTP,0000,0000,0000,,Жиналыстағы қарапайым күн
Dialogue: 0,1:59:59.65,2:00:05.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
