Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:10.01,0:00:12.84,Default,,0,0,0,,Финал Мегалонияға бару үшін шешуші матч
Dialogue: 0,0:00:12.97,0:00:15.80,Default,,0,0,0,,Матч екінші раундта.
Dialogue: 0,0:00:21.56,0:00:24.27,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:43.46,0:00:44.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:49.42,0:00:50.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:52.80,0:00:54.68,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:01:03.14,0:01:06.44,Default,,0,0,0,,Менің алдымда тұрма! Жылжыту үшін аяқтарыңызды пайдаланыңыз!
Dialogue: 0,0:01:08.69,0:01:10.11,Default,,0,0,0,,Хакутоның қолы басым.
Dialogue: 0,0:01:10.23,0:01:11.19,Default,,0,0,0,,Ойынды жалғастыру -
Dialogue: 0,0:01:11.32,0:01:13.44,Default,,0,0,0,,Тіссіз Джо қорғаныста.
Dialogue: 0,0:01:13.57,0:01:15.57,Default,,0,0,0,,Бүгінгі күннің жақсылығы жоқ.
Dialogue: 0,0:01:19.91,0:01:20.74,Default,,0,0,0,,Гуах
Dialogue: 0,0:01:20.87,0:01:22.24,Default,,0,0,0,,Huh «Бұлай болмауы керек».
Dialogue: 0,0:01:22.62,0:01:24.00,Default,,0,0,0,,Сіз осылай ойлайсыз, солай ма?
Dialogue: 0,0:01:24.12,0:01:25.41,Default,,0,0,0,,Аа уф
Dialogue: 0,0:01:25.54,0:01:26.33,Default,,0,0,0,,Төмен! (Нанбу/Сачио) Ах
Dialogue: 0,0:01:26.62,0:01:27.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:27.62,0:01:28.79,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:01:30.71,0:01:31.80,Default,,0,0,0,,Екі
Dialogue: 0,0:01:32.42,0:01:33.42,Default,,0,0,0,,Уф
Dialogue: 0,0:01:34.01,0:01:35.17,Default,,0,0,0,,Үш
Dialogue: 0,0:01:37.13,0:01:38.22,Default,,0,0,0,,Төрт
Dialogue: 0,0:01:38.76,0:01:40.22,Default,,0,0,0,,Ағай
Dialogue: 0,0:01:40.39,0:01:40.89,Default,,0,0,0,,Бес
Dialogue: 0,0:01:40.68,0:01:41.68,Default,,0,0,0,,Әй, бұл етке жауап береді, Бес.
Dialogue: 0,0:01:41.68,0:01:43.77,Default,,0,0,0,,Әй, етіне әрекет етеді.
Dialogue: 0,0:01:43.85,0:01:44.35,Default,,0,0,0,,Алты
Dialogue: 0,0:01:44.10,0:01:45.06,Default,,0,0,0,,Қателік жасамаңыз, бұл алдыңғы беріліс алтыдан өзгеше
Dialogue: 0,0:01:45.06,0:01:47.06,Default,,0,0,0,,Қате жасамаңыз, ол бұрынғы берілістерден ерекшеленеді.
Dialogue: 0,0:01:47.06,0:01:48.23,Default,,0,0,0,,Жеті Қате болма, ол бұрынғы беріліспен ерекшеленеді.
Dialogue: 0,0:01:48.23,0:01:48.73,Default,,0,0,0,,Қате болмаңыз, ол бұрынғы берілістерден ерекшеленеді.
Dialogue: 0,0:01:49.61,0:01:50.19,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:01:50.19,0:01:51.32,Default,,0,0,0,,Сегіз (Джо) Уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:01:51.32,0:01:52.73,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:01:53.28,0:01:54.40,Default,,0,0,0,,Тоғыз
Dialogue: 0,0:01:54.65,0:01:55.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:56.95,0:01:58.03,Default,,0,0,0,,Я...
Dialogue: 0,0:01:59.03,0:02:04.04,Default,,0,0,0,,♪~
Dialogue: 0,0:03:39.41,0:03:41.46,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:41.75,0:03:44.75,Default,,0,0,0,,Әлсіз жақтарды жеңетін жаңа модель...
Dialogue: 0,0:03:50.97,0:03:53.09,Default,,0,0,0,,Юриймен күресу
Dialogue: 0,0:04:06.94,0:04:10.11,Default,,0,0,0,,Дұрыс, ол да бұл үлгіні әлі білмейді.
Dialogue: 0,0:04:10.57,0:04:14.57,Default,,0,0,0,,Етке қанша әрекет етсеңіз де, сізде әлі де бір дерек жоқ...
Dialogue: 0,0:04:14.99,0:04:17.70,Default,,0,0,0,,Әй, «Эйс» ақылды.
Dialogue: 0,0:04:23.75,0:04:25.04,Default,,0,0,0,,Ах
Dialogue: 0,0:04:25.17,0:04:26.42,Default,,0,0,0,,Төмен!
Dialogue: 0,0:04:27.63,0:04:28.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:29.55,0:04:32.34,Default,,0,0,0,,Сіз бұл жұмыс істейді деп ойладыңыз ба?
Dialogue: 0,0:04:32.47,0:04:35.34,Default,,0,0,0,,Сіздің қарапайым қайталанатын тәжірибеңіз
Dialogue: 0,0:04:35.47,0:04:37.89,Default,,0,0,0,,Не! ? Қарғыс атсын
Dialogue: 0,0:04:38.10,0:04:39.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:39.97,0:04:40.72,Default,,0,0,0,,Уау
Dialogue: 0,0:04:41.64,0:04:42.81,Default,,0,0,0,,Ах
Dialogue: 0,0:04:43.31,0:04:45.65,Default,,0,0,0,,Слип (аудитория) Бұл жағымсыз, Джо!
Dialogue: 0,0:04:45.77,0:04:48.11,Default,,0,0,0,,Бұл бұзақылар арасындағы төбелес емес!
Dialogue: 0,0:04:48.23,0:04:49.57,Default,,0,0,0,,Қаңғыбас ит
Dialogue: 0,0:04:49.69,0:04:50.98,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:04:51.11,0:04:53.15,Default,,0,0,0,,Осымен екінші айналым аяқталады.
Dialogue: 0,0:04:53.28,0:04:56.57,Default,,0,0,0,,Бұл өте нашар раунд болды.
Dialogue: 0,0:04:56.70,0:04:57.57,Default,,0,0,0,,Джо!
Dialogue: 0,0:04:57.70,0:04:58.78,Default,,0,0,0,,Құт
Dialogue: 0,0:04:58.91,0:05:01.04,Default,,0,0,0,,Нәтижелерді көрген сияқтысыз.
Dialogue: 0,0:05:02.16,0:05:04.08,Default,,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:05:04.21,0:05:04.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:05.96,0:05:09.42,Default,,0,0,0,,Қайсысы нақты екенін дәлелдеу үшін...
Dialogue: 0,0:05:09.88,0:05:12.42,Default,,0,0,0,,Сіз бұл сақинаны дайындаған жоқсыз ба?
Dialogue: 0,0:05:12.76,0:05:13.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:21.10,0:05:24.02,Default,,0,0,0,,Эй, мен өзімді сергек сезінемін.
Dialogue: 0,0:05:25.52,0:05:27.73,Default,,0,0,0,,Әрбір қимыл оқылады.
Dialogue: 0,0:05:27.85,0:05:31.48,Default,,0,0,0,,Үйренген үлгілерді өз бетінше жасаңыз
Dialogue: 0,0:05:31.94,0:05:35.57,Default,,0,0,0,,Сіз бұл құралмен қаншалықты көп күрессеңіз, соғұрлым ол күшейе түседі.
Dialogue: 0,0:05:35.70,0:05:38.07,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:38.41,0:05:40.99,Default,,0,0,0,,Егер комбинация жұмыс істемесе...
Dialogue: 0,0:05:41.12,0:05:43.12,Default,,0,0,0,,Басқа ештеңе істей алмаймыз
Dialogue: 0,0:05:43.25,0:05:45.83,Default,,0,0,0,,Қария, сен үнемі осылай айтатынсың, солай ма?
Dialogue: 0,0:05:45.96,0:05:49.58,Default,,0,0,0,,«Нәтижені шешетін құрал емес», солай ма?
Dialogue: 0,0:05:49.71,0:05:50.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:53.67,0:05:56.63,Default,,0,0,0,,Сачио Оны да салқындатыңыз.
Dialogue: 0,0:06:00.60,0:06:01.93,Default,,0,0,0,,Синхрондау жылдамдығы қандай?
Dialogue: 0,0:06:02.06,0:06:03.52,Default,,0,0,0,,Ол тұрақты өсуде.
Dialogue: 0,0:06:03.64,0:06:06.94,Default,,0,0,0,,Менің ойымша, өнімділік келесі раундта оңтайландырылады, сондықтан...
Dialogue: 0,0:06:07.06,0:06:08.73,Default,,0,0,0,,Дәл осылай... (Кюо) Бұл болжам емес.
Dialogue: 0,0:06:08.85,0:06:10.40,Default,,0,0,0,,Мен сандарды тыңдаймын.
Dialogue: 0,0:06:10.52,0:06:11.73,Default,,0,0,0,,Иә
Dialogue: 0,0:06:11.86,0:06:14.19,Default,,0,0,0,,Қазіргі уақытта 73%
Dialogue: 0,0:06:14.32,0:06:16.28,Default,,0,0,0,,Сіз мұны қанша уақыттан бері істеп жүрсіз? Ах
Dialogue: 0,0:06:18.86,0:06:20.32,Default,,0,0,0,,Үшінші топтағы адамдар
Dialogue: 0,0:06:21.66,0:06:23.33,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,0:06:23.70,0:06:25.75,Default,,0,0,0,,Жасанды интеллектпен синхрондау -
Dialogue: 0,0:06:25.87,0:06:29.29,Default,,0,0,0,,Бұл денеге де, санаға да үлкен шығын әкеледі.
Dialogue: 0,0:06:29.83,0:06:33.96,Default,,0,0,0,,Егер сіз жаңа эйс болсаңыз, құны өлшеусіз болады.
Dialogue: 0,0:06:34.09,0:06:36.51,Default,,0,0,0,,Бұл берілістің шегі
Dialogue: 0,0:06:36.63,0:06:40.89,Default,,0,0,0,,Gear оны басқара алатын адамдарсыз болашағы жоқ.
Dialogue: 0,0:06:41.39,0:06:45.31,Default,,0,0,0,,Сол сияқты, Хакутоның болашағын жүзеге асыру біліктілігі де бар
Dialogue: 0,0:06:46.39,0:06:48.98,Default,,0,0,0,,Мен мұны мына сақинамен дәлелдеймін.
Dialogue: 0,0:06:49.60,0:06:53.82,Default,,0,0,0,,Хакутоға лайықты нағыз адам кім?
Dialogue: 0,0:07:00.03,0:07:01.70,Default,,0,0,0,,Шуш шушшуш
Dialogue: 0,0:07:06.04,0:07:07.87,Default,,0,0,0,,Автоматты басқаруды 50-ге дейін арттырыңыз
Dialogue: 0,0:07:08.54,0:07:13.17,Default,,0,0,0,,Синхрондау жылдамдығы 38 49 55
Dialogue: 0,0:07:14.88,0:07:16.17,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:07:17.21,0:07:20.88,Default,,0,0,0,,79 85 98
Dialogue: 0,0:07:21.13,0:07:22.55,Default,,0,0,0,,Толығырақ!
Dialogue: 0,0:07:24.60,0:07:25.76,Default,,0,0,0,,Шекті мән
Dialogue: 0,0:07:27.56,0:07:28.35,Default,,0,0,0,,(Ескерту)
Dialogue: 0,0:07:28.48,0:07:33.98,Default,,0,0,0,,Синхрондау жылдамдығы 60 54 32 Тұрақты емес
Dialogue: 0,0:07:36.57,0:07:39.44,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:07:47.29,0:07:51.00,Default,,0,0,0,,Куку куку гуа ах
Dialogue: 0,0:07:51.33,0:07:56.67,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааа...
Dialogue: 0,0:08:02.76,0:08:06.85,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:07.76,0:08:10.06,Default,,0,0,0,,60-дан өзгертілді
Dialogue: 0,0:08:10.39,0:08:13.40,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:08:16.86,0:08:19.94,Default,,0,0,0,,Үшінші раундқа өткеннен кейін де жағдай бұрынғысынша сақталады.
Dialogue: 0,0:08:20.07,0:08:21.90,Default,,0,0,0,,Гуа-а-а-а
Dialogue: 0,0:08:22.70,0:08:24.57,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:08:24.70,0:08:26.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:26.70,0:08:29.37,Default,,0,0,0,,Төбелесе алмайтын жігітке күлме!
Dialogue: 0,0:08:29.49,0:08:32.66,Default,,0,0,0,,Джо, мына жігіттерге тағы бір қараңызшы!
Dialogue: 0,0:08:32.79,0:08:35.46,Default,,0,0,0,,Уррей Джо!
Dialogue: 0,0:08:35.71,0:08:36.96,Default,,0,0,0,,А... уф
Dialogue: 0,0:08:37.13,0:08:38.84,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:08:38.96,0:08:42.22,Default,,0,0,0,,Қарап отырсақ, сен жай ғана блеф және фейк екенсің.
Dialogue: 0,0:08:46.39,0:08:47.60,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,0:08:52.06,0:08:53.77,Default,,0,0,0,,Не болды? (Кио) Иә?
Dialogue: 0,0:08:54.35,0:08:56.35,Default,,0,0,0,,Нағыз соққы...
Dialogue: 0,0:08:57.02,0:08:58.90,Default,,0,0,0,,Бұлай емес еді.
Dialogue: 0,0:08:59.48,0:09:00.61,Default,,0,0,0,,Құт
Dialogue: 0,0:09:01.28,0:09:02.61,Default,,0,0,0,,Уф
Dialogue: 0,0:09:03.95,0:09:05.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:06.91,0:09:08.95,Default,,0,0,0,,Физикалық түрде ондай үстел жоқ.
Dialogue: 0,0:09:09.08,0:09:12.25,Default,,0,0,0,,Күшті жоғарғы жақ Джоны рингтен түсіреді!
Dialogue: 0,0:09:12.37,0:09:14.08,Default,,0,0,0,,Джо аға...
Dialogue: 0,0:09:16.88,0:09:20.25,Default,,0,0,0,,Сізде шындықты айтуға біліктілігіңіз жоқ.
Dialogue: 0,0:09:20.92,0:09:23.17,Default,,0,0,0,,Қоқыс итті алдау
Dialogue: 0,0:09:24.34,0:09:25.97,Default,,0,0,0,,Джо! (Оңтүстік бөлігі) Иә?
Dialogue: 0,0:09:26.47,0:09:28.30,Default,,0,0,0,,Оған қол тигізбеңіз! Ах
Dialogue: 0,0:09:28.43,0:09:32.43,Default,,0,0,0,,Екінші болып көмектессеңіз, фол бойынша жеңілесіз.
Dialogue: 0,0:09:32.56,0:09:35.94,Default,,0,0,0,,Уайымдама, Сачио.
Dialogue: 0,0:09:36.31,0:09:37.35,Default,,0,0,0,,Джо
Dialogue: 0,0:09:38.77,0:09:43.15,Default,,0,0,0,,Сіз айтқандай, матчты шешуші құрал емес.
Dialogue: 0,0:09:45.36,0:09:46.82,Default,,0,0,0,,Бұл ет пен қан.
Dialogue: 0,0:09:47.70,0:09:49.45,Default,,0,0,0,,Маған жанашырлығыңызды көрсетіңіз
Dialogue: 0,0:09:50.08,0:09:51.87,Default,,0,0,0,,Сіздің кадрыңыз
Dialogue: 0,0:09:52.91,0:09:54.41,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:09:54.75,0:09:56.58,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:10:01.67,0:10:03.76,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:03.88,0:10:04.59,Default,,0,0,0,,Ах
Dialogue: 0,0:10:32.33,0:10:33.54,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:33.74,0:10:35.95,Default,,0,0,0,,Неге менің эйсімді лақтырдың?
Dialogue: 0,0:10:36.08,0:10:38.96,Default,,0,0,0,,Сен сол сұрықсыз, құбыжық құралды таңдадың ба?
Dialogue: 0,0:10:39.46,0:10:41.92,Default,,0,0,0,,Юкикоға адалдық?
Dialogue: 0,0:10:42.21,0:10:45.13,Default,,0,0,0,,Жеңіске жету үшін бәрі.
Dialogue: 0,0:10:45.26,0:10:48.26,Default,,0,0,0,,Олай болса, қай беріліс мықты?
Dialogue: 0,0:10:48.38,0:10:50.55,Default,,0,0,0,,Осы жерде дәлелдеңіз.
Dialogue: 0,0:10:53.05,0:10:56.35,Default,,0,0,0,,Тек жеңімпаз ғана менімен күресуге құқылы.
Dialogue: 0,0:10:56.47,0:10:57.52,Default,,0,0,0,,Құт
Dialogue: 0,0:10:57.85,0:11:00.31,Default,,0,0,0,,Шынайы нәрсе тек сізге арналған ба?
Dialogue: 0,0:11:00.44,0:11:02.69,Default,,0,0,0,,Ақ астанаға қоныстанған аңның шетінде
Dialogue: 0,0:11:04.44,0:11:07.07,Default,,0,0,0,,Нені дәлелдегің келеді?
Dialogue: 0,0:11:07.19,0:11:08.40,Default,,0,0,0,,Не?
Dialogue: 0,0:11:13.58,0:11:15.08,Default,,0,0,0,,Беріліс емес
Dialogue: 0,0:11:15.20,0:11:17.12,Default,,0,0,0,,Нағыз мегало боксшысы -
Dialogue: 0,0:11:17.25,0:11:20.71,Default,,0,0,0,,Өз еркіңізбен жұдырықтарыңызды басқарып, рингте тұрыңыз
Dialogue: 0,0:11:24.92,0:11:27.09,Default,,0,0,0,,Сіз сол күзетшісіз бе?
Dialogue: 0,0:11:28.01,0:11:30.38,Default,,0,0,0,,Әлде Эйс пе?
Dialogue: 0,0:11:33.05,0:11:34.68,Default,,0,0,0,,Эйс бұл...
Dialogue: 0,0:11:43.15,0:11:43.94,Default,,0,0,0,,Эйс бұл...
Dialogue: 0,0:11:47.11,0:11:48.48,Default,,0,0,0,,оның қан тамырларының қабырғаларынан шығып келе жатқанын—
Dialogue: 0,0:11:48.90,0:11:50.28,Default,,0,0,0,,О! (Джо) Ха!
Dialogue: 0,0:11:50.82,0:11:51.74,Default,,0,0,0,,Ах
Dialogue: 0,0:11:51.86,0:11:54.87,Default,,0,0,0,,Сіз нағыз мәміле екеніңізге сенімдісіз бе?
Dialogue: 0,0:11:54.99,0:11:56.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:56.78,0:12:00.46,Default,,0,0,0,,Бұл 90% синхрондау жылдамдығы...
Dialogue: 0,0:12:00.75,0:12:02.17,Default,,0,0,0,,Әлі де көтерілуде
Dialogue: 0,0:12:02.29,0:12:05.13,Default,,0,0,0,,Көбірек, көбірек!
Dialogue: 0,0:12:06.46,0:12:07.80,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:12:10.88,0:12:12.34,Default,,0,0,0,,Сен менің абыройымды осы лайға батырдың!
Dialogue: 0,0:12:12.84,0:12:14.68,Default,,0,0,0,,Бұл Джо (Кюо) Ах.
Dialogue: 0,0:12:15.64,0:12:17.01,Default,,0,0,0,,Мен Джомын!
Dialogue: 0,0:12:17.22,0:12:18.26,Default,,0,0,0,,Га
Dialogue: 0,0:12:18.81,0:12:21.64,Default,,0,0,0,,Куу! (Джо) Ахх!
Dialogue: 0,0:12:21.77,0:12:22.64,Default,,0,0,0,,Джо! Ахх
Dialogue: 0,0:12:22.85,0:12:24.40,Default,,0,0,0,,Сіз мені естисіз бе? Джо
Dialogue: 0,0:12:24.52,0:12:25.73,Default,,0,0,0,,Джо!
Dialogue: 0,0:12:25.86,0:12:28.32,Default,,0,0,0,,Әйтеуір, «Тас-Қағаз-Қышқыл» баласының да осындай жағдайы болған.
Dialogue: 0,0:12:28.94,0:12:30.11,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:30.23,0:12:31.32,Default,,0,0,0,,Бірге барайық.
Dialogue: 0,0:12:31.44,0:12:35.28,Default,,0,0,0,,(аудиторияның күлкілері)
Dialogue: 0,0:12:35.62,0:12:38.33,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:12:42.62,0:12:43.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:43.67,0:12:45.75,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:12:45.88,0:12:48.00,Default,,0,0,0,,Джоның табандылығы мен...
Dialogue: 0,0:12:48.13,0:12:50.51,Default,,0,0,0,,Хакутоның күрес жүргізуіне байланысты-
Dialogue: 0,0:12:50.63,0:12:52.97,Default,,0,0,0,,Екі ойыншыға да фол беріледі
Dialogue: 0,0:12:53.09,0:12:56.22,Default,,0,0,0,,Ақымақ болма! Қайда қарап тұрсың? Сонымен қатар, үш фолдың нүктесінде бұл фолды жоғалту ...
Dialogue: 0,0:12:56.34,0:12:59.89,Default,,0,0,0,,Ағай, егер осылай жүре берсеңіз, Джо өлтіріледі!
Dialogue: 0,0:12:59.89,0:13:00.39,Default,,0,0,0,,(Тұрмыстық сигнал)
Dialogue: 0,0:13:00.01,0:13:01.18,Default,,0,0,0,,Хмм (жалған дыбыс сигналы)
Dialogue: 0,0:13:01.47,0:13:03.39,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:13:04.48,0:13:05.35,Default,,0,0,0,,Ах
Dialogue: 0,0:13:10.36,0:13:11.73,Default,,0,0,0,,Не?
Dialogue: 0,0:13:12.44,0:13:13.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:13.49,0:13:16.11,Default,,0,0,0,,Сіз не істеп жатырсыз? Джо, сақ бол!
Dialogue: 0,0:13:16.24,0:13:17.78,Default,,0,0,0,,Күзетші! күзетші!
Dialogue: 0,0:13:18.20,0:13:21.24,Default,,0,0,0,,Сіз қандайсыз!
Dialogue: 0,0:13:22.08,0:13:23.00,Default,,0,0,0,,Га
Dialogue: 0,0:13:24.58,0:13:26.50,Default,,0,0,0,,Қаа… Қуа
Dialogue: 0,0:13:30.09,0:13:31.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:32.26,0:13:34.13,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:13:34.59,0:13:36.18,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:36.30,0:13:38.30,Default,,0,0,0,,Күзетсіз Gearless Джоның алдында
Dialogue: 0,0:13:38.43,0:13:40.51,Default,,0,0,0,,Хакуто шабуыл жасай алмайды.
Dialogue: 0,0:13:40.64,0:13:42.18,Default,,0,0,0,,Оны тез жең!
Dialogue: 0,0:13:42.31,0:13:44.31,Default,,0,0,0,,Мәңгілік ойнама!
Dialogue: 0,0:13:44.39,0:13:44.89,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:13:44.64,0:13:45.69,Default,,0,0,0,,Га (дыбыс)
Dialogue: 0,0:13:45.69,0:13:46.19,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:13:45.81,0:13:46.31,Default,,0,0,0,,Мұнда үшінші раундтың уақыты аяқталды (дыбыс)
Dialogue: 0,0:13:46.19,0:13:48.60,Default,,0,0,0,,Мұнда 3 раундқа уақыт берілген.
Dialogue: 0,0:13:49.11,0:13:50.98,Default,,0,0,0,,Бұл дамуды қалай көресіз?
Dialogue: 0,0:13:51.11,0:13:54.90,Default,,0,0,0,,Жарайды, Хакутоның басымдығы бар сияқты...
Dialogue: 0,0:14:04.08,0:14:06.37,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:14:11.84,0:14:14.30,Default,,0,0,0,,Неге менің ағам барып оны жеңбейді?
Dialogue: 0,0:14:14.59,0:14:16.59,Default,,0,0,0,,Мен оны тоқтаттым (Юкико) Иә?
Dialogue: 0,0:14:16.88,0:14:18.84,Default,,0,0,0,,Тағы бір жігіт
Dialogue: 0,0:14:19.18,0:14:22.26,Default,,0,0,0,,Тез отыр, біраз демалып, келесі айналымға дайындал.
Dialogue: 0,0:14:22.39,0:14:24.81,Default,,0,0,0,,Отырсаң, қайта тұра алмайсың.
Dialogue: 0,0:14:25.35,0:14:27.56,Default,,0,0,0,,Одан да көп, Сачио, а?
Dialogue: 0,0:14:27.89,0:14:29.27,Default,,0,0,0,,Оның берілістері -
Dialogue: 0,0:14:29.40,0:14:31.77,Default,,0,0,0,,Сіз менің шабуыл үлгісін де ешқашан көрген емессіз...
Dialogue: 0,0:14:31.90,0:14:33.32,Default,,0,0,0,,Сіз көп нәрсені үйрендіңіз, солай емес пе?
Dialogue: 0,0:14:33.44,0:14:36.24,Default,,0,0,0,,Иә, екінші рет жұмыс істемейді.
Dialogue: 0,0:14:36.36,0:14:38.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:38.65,0:14:39.82,Default,,0,0,0,,Қартты да көрдіңіз бе?
Dialogue: 0,0:14:41.91,0:14:45.20,Default,,0,0,0,,Ол түзу тартқанда
Dialogue: 0,0:14:45.45,0:14:48.79,Default,,0,0,0,,Түсіндім! Мен Джо бірдеңе жасайды деп ойладым...
Dialogue: 0,0:14:48.92,0:14:52.88,Default,,0,0,0,,Gear стратегиясын өзгертті, сондықтан біз шабуыл жасай алмадық.
Dialogue: 0,0:14:53.00,0:14:55.34,Default,,0,0,0,,Олай болса, сен күзетіңді төмендеттің...
Dialogue: 0,0:14:55.46,0:14:56.92,Default,,0,0,0,,блеф
Dialogue: 0,0:14:57.63,0:15:02.14,Default,,0,0,0,,Хе! Сіз осы соңғы минутта ақылсыз нәрсе туралы ойлайсыз.
Dialogue: 0,0:15:02.35,0:15:04.31,Default,,0,0,0,,Оның мақсаты - оны көру ...
Dialogue: 0,0:15:04.43,0:15:06.77,Default,,0,0,0,,Аяқтау соққысын тигізгенде
Dialogue: 0,0:15:06.97,0:15:08.89,Default,,0,0,0,,Бұл есептегіш пе?
Dialogue: 0,0:15:09.02,0:15:12.15,Default,,0,0,0,,А, мен бір оқпен шешемін.
Dialogue: 0,0:15:15.98,0:15:20.07,Default,,0,0,0,,Егер мен автоматты басқаруды сол кезде алып тастасам, мен оны жеңе алар едім.
Dialogue: 0,0:15:20.70,0:15:22.95,Default,,0,0,0,,Эйс шешімде қателесті...
Dialogue: 0,0:15:23.70,0:15:26.54,Default,,0,0,0,,Мен өзіме күмәнданамын ба?
Dialogue: 0,0:15:26.66,0:15:29.37,Default,,0,0,0,,Синхрондау жылдамдығы 80%-дан төмен түсті
Dialogue: 0,0:15:29.50,0:15:33.67,Default,,0,0,0,,Сандар тұрақты, бірақ редукторсыз иектер өз шегіне жетіп жатыр.
Dialogue: 0,0:15:33.79,0:15:36.13,Default,,0,0,0,,Эйстің автоматты басқаруынан бас тартсам да, ешқандай проблема болмайды деп ойлаймын...
Dialogue: 0,0:15:36.25,0:15:38.01,Default,,0,0,0,,Балалар сендер не білесіңдер? Ах
Dialogue: 0,0:15:39.26,0:15:41.84,Default,,0,0,0,,Эйстің шешімі менің шешімім!
Dialogue: 0,0:15:41.97,0:15:43.80,Default,,0,0,0,,Бұған сенуге болмайды!
Dialogue: 0,0:15:43.93,0:15:45.76,Default,,0,0,0,,Біраздан соң—
Dialogue: 0,0:15:46.68,0:15:50.23,Default,,0,0,0,,Ол не істесе де, мұнымен аяқталады.
Dialogue: 0,0:15:50.35,0:15:53.19,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:53.31,0:15:54.90,Default,,0,0,0,,Ең күшті механизмге қарсы―
Dialogue: 0,0:15:55.02,0:15:56.98,Default,,0,0,0,,Көмекке келмейтін тісті доңғалақсыз жақ
Dialogue: 0,0:15:57.11,0:15:59.24,Default,,0,0,0,,Бұрын мен сақтығымды төмендететінмін.
Dialogue: 0,0:15:59.36,0:16:01.11,Default,,0,0,0,,Ол өз шегінде ме?
Dialogue: 0,0:16:01.24,0:16:04.24,Default,,0,0,0,,Бұл раунд шешуші фактор бола ма?
Dialogue: 0,0:16:04.37,0:16:07.74,Default,,0,0,0,,Бұл көздеріммен мен енді ештеңе көрмеймін.
Dialogue: 0,0:16:07.87,0:16:11.33,Default,,0,0,0,,Ол соңғы оқпен не істейді?
Dialogue: 0,0:16:11.46,0:16:12.71,Default,,0,0,0,,Қария шешсін.
Dialogue: 0,0:16:12.83,0:16:15.79,Default,,0,0,0,,Ей, сен маған бакучиге сенесің...
Dialogue: 0,0:16:15.92,0:16:17.59,Default,,0,0,0,,Сіз пісіруге дайынсыз ба?
Dialogue: 0,0:16:20.01,0:16:22.76,Default,,0,0,0,,Сонда да мен саған бәс тігемін.
Dialogue: 0,0:16:23.59,0:16:26.72,Default,,0,0,0,,Оң жақта сол жақта ма?
Dialogue: 0,0:16:26.85,0:16:29.85,Default,,0,0,0,,Әй, бұрын да болған.
Dialogue: 0,0:16:30.31,0:16:31.77,Default,,0,0,0,,Біз Антоки-
Dialogue: 0,0:16:32.35,0:16:35.27,Default,,0,0,0,,Мен оның тыртықтанған етіне бәс тігемін.
Dialogue: 0,0:16:35.61,0:16:38.27,Default,,0,0,0,,Егер бұл жігіт ең мықты құрал болса...
Dialogue: 0,0:16:39.07,0:16:41.78,Default,,0,0,0,,Бұл ең күшті тіршілік иесі.
Dialogue: 0,0:16:42.82,0:16:45.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:45.45,0:16:47.33,Default,,0,0,0,,Оның соңғы соққысы -
Dialogue: 0,0:16:51.75,0:16:54.46,Default,,0,0,0,,Бұрынғыдай, тура оңға.
Dialogue: 0,0:16:54.75,0:16:56.96,Default,,0,0,0,,Сол жағыңызды сол жақпен туралаңыз.
Dialogue: 0,0:16:57.17,0:16:58.21,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:58.46,0:17:00.71,Default,,0,0,0,,Бұл Эйстің ниеті ме?
Dialogue: 0,0:17:03.63,0:17:05.68,Default,,0,0,0,,Әлде мен бе?
Dialogue: 0,0:17:08.55,0:17:11.52,Default,,0,0,0,,Оххх
Dialogue: 0,0:17:12.35,0:17:13.73,Default,,0,0,0,,Хааа!
Dialogue: 0,0:17:14.81,0:17:15.98,Default,,0,0,0,,Оқыңыз! ?
Dialogue: 0,0:17:16.10,0:17:17.23,Default,,0,0,0,,Уақытында емес
Dialogue: 0,0:17:18.36,0:17:19.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:24.78,0:17:26.70,Default,,0,0,0,,Ах
Dialogue: 0,0:17:37.33,0:17:38.71,Default,,0,0,0,,Төмен!
Dialogue: 0,0:17:39.13,0:17:41.05,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:41.17,0:17:42.51,Default,,0,0,0,,Ааах…
Dialogue: 0,0:17:42.63,0:17:45.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:45.63,0:17:47.47,Default,,0,0,0,,Жақсы! (Тұтынушылар) О?
Dialogue: 0,0:17:47.76,0:17:50.10,Default,,0,0,0,,Ооо? а? Ах...
Dialogue: 0,0:17:50.22,0:17:52.06,Default,,0,0,0,,Бес алты
Dialogue: 0,0:17:52.18,0:17:55.94,Default,,0,0,0,,Жеті сегіз тоғыз он
Dialogue: 0,0:17:57.81,0:18:00.90,Default,,0,0,0,,4 раунд 2 минут 16 секунд КО
Dialogue: 0,0:18:01.02,0:18:05.19,Default,,0,0,0,,Жеңімпаз Gearless Joe!
Dialogue: 0,0:18:05.19,0:18:06.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:06.20,0:18:08.16,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:18:08.28,0:18:10.07,Default,,0,0,0,,Ия, иә, иә! (Диктор) Мен сене алар емеспін!
Dialogue: 0,0:18:10.20,0:18:12.49,Default,,0,0,0,,Gearless Джоның үлкен оралуы!
Dialogue: 0,0:18:12.95,0:18:15.83,Default,,0,0,0,,Жарақаттармен жабылған Джо атқылаған бір оқ...
Dialogue: 0,0:18:15.96,0:18:18.83,Default,,0,0,0,,Хакуто кілемшеге батырылды.
Dialogue: 0,0:18:18.96,0:18:20.59,Default,,0,0,0,,Шынында да ғажайып!
Dialogue: 0,0:18:20.71,0:18:21.88,Default,,0,0,0,,Рейтингтің төменгі жағынан-
Dialogue: 0,0:18:22.00,0:18:22.50,Default,,0,0,0,,Біз күтпеген жерден финалда жеңіске жеттік.
Dialogue: 0,0:18:22.50,0:18:24.84,Default,,0,0,0,,Джо! Джо! Мен күтпеген финалда жеңіске жеттім.
Dialogue: 0,0:18:24.84,0:18:25.34,Default,,0,0,0,,Джо! Джо!
Dialogue: 0,0:18:24.96,0:18:27.38,Default,,0,0,0,,Бұл Megalonia байқауының соңғы қатысушысы (аудитория) Джо! Джо!
Dialogue: 0,0:18:27.51,0:18:28.01,Default,,0,0,0,,Gearless Joe таңдалды!
Dialogue: 0,0:18:27.84,0:18:29.89,Default,,0,0,0,,Джо! Джо! Gearless Джо таңдалды!
Dialogue: 0,0:18:29.89,0:18:30.39,Default,,0,0,0,,Gearless Joe таңдалды!
Dialogue: 0,0:18:30.01,0:18:31.22,Default,,0,0,0,,Джо! Джо! Gearless Джо таңдалды!
Dialogue: 0,0:18:31.22,0:18:34.02,Default,,0,0,0,,Джо! Джо!
Dialogue: 0,0:18:34.27,0:18:35.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:36.85,0:18:40.02,Default,,0,0,0,,Эй, бұл сенің атың.
Dialogue: 0,0:18:41.77,0:18:42.65,Default,,0,0,0,,Иә
Dialogue: 0,0:18:42.77,0:18:44.78,Default,,0,0,0,,Неліктен? (Джо) О?
Dialogue: 0,0:18:48.90,0:18:52.58,Default,,0,0,0,,Сіз қайдан білдіңіз? соңғы соққы
Dialogue: 0,0:18:52.87,0:18:55.54,Default,,0,0,0,,Ха, мен бұл туралы ойламадым.
Dialogue: 0,0:18:55.66,0:18:58.33,Default,,0,0,0,,Менің денем өздігінен қозғалды.
Dialogue: 0,0:18:58.46,0:19:01.21,Default,,0,0,0,,Ха, сен де солай ма?
Dialogue: 0,0:19:01.33,0:19:02.34,Default,,0,0,0,,Ах
Dialogue: 0,0:19:03.21,0:19:04.25,Default,,0,0,0,,Ha
Dialogue: 0,0:19:10.64,0:19:12.51,Default,,0,0,0,,Джосуке Хигашиката!
Dialogue: 0,0:19:17.27,0:19:19.23,Default,,0,0,0,,Егер мен сол кезде болсам...
Dialogue: 0,0:19:19.35,0:19:21.85,Default,,0,0,0,,Егер мен сіздің мұрагеріңіз болудан бас тартсам...
Dialogue: 0,0:19:21.98,0:19:23.65,Default,,0,0,0,,Бұл менмендік
Dialogue: 0,0:19:23.77,0:19:24.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:24.82,0:19:29.45,Default,,0,0,0,,Жалғыздықтан қорықпай, Кису Хакутоның өмірін өткізді.
Dialogue: 0,0:19:29.70,0:19:32.99,Default,,0,0,0,,Соңына дейін күресу жолын орындаңыз.
Dialogue: 0,0:19:33.12,0:19:35.28,Default,,0,0,0,,Мен оны дәлелдедім.
Dialogue: 0,0:19:36.33,0:19:38.50,Default,,0,0,0,,Сіз өкінесіз бе? (Юкико) Иә?
Dialogue: 0,0:19:38.62,0:19:40.75,Default,,0,0,0,,Матч шешілді
Dialogue: 0,0:19:41.21,0:19:46.05,Default,,0,0,0,,Ең мықты беріліс бір ғана, сен оны дәлелдейсің.
Dialogue: 0,0:19:46.17,0:19:48.63,Default,,0,0,0,,Мегалонияның рингінде кім шығады?
Dialogue: 0,0:19:48.76,0:19:50.59,Default,,0,0,0,,Бұл өзгермейді.
Dialogue: 0,0:19:52.97,0:19:55.22,Default,,0,0,0,,Сәлем, чемпион (Юрий)?
Dialogue: 0,0:19:55.60,0:19:56.68,Default,,0,0,0,,Я...
Dialogue: 0,0:19:59.43,0:20:03.52,Default,,0,0,0,,Уәде еткендей мен сенің жүзігіңе келдім.
Dialogue: 0,0:20:06.98,0:20:10.53,Default,,0,0,0,,Әй, мен қаңғыбас иттермен төбелеспеймін.
Dialogue: 0,0:20:10.65,0:20:11.90,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:20:12.99,0:20:13.91,Default,,0,0,0,,Джо
Dialogue: 0,0:20:14.03,0:20:15.57,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:20:21.25,0:20:23.92,Default,,0,0,0,,Тістеп, жібермейтін аң
Dialogue: 0,0:20:40.64,0:20:43.89,Default,,0,0,0,,Жеңілген адамға ештеңе берме...
Dialogue: 0,0:20:49.98,0:20:53.65,Default,,0,0,0,,Маған бүгін қатты әсер етті.
Dialogue: 0,0:20:53.78,0:20:56.24,Default,,0,0,0,,Мен өзімді шірік сезіндім, бұл жерде жақсы ештеңе жоқ деп ойладым ...
Dialogue: 0,0:20:56.37,0:20:59.08,Default,,0,0,0,,Сіз біздің мақтанышымызсыз.
Dialogue: 0,0:20:59.20,0:21:01.00,Default,,0,0,0,,Мен мұны бұрын естігенмін.
Dialogue: 0,0:21:01.12,0:21:04.50,Default,,0,0,0,,Әй, сен менің қызыма үйленесің бе?
Dialogue: 0,0:21:04.75,0:21:06.50,Default,,0,0,0,,Неке! ? Мен?
Dialogue: 0,0:21:06.63,0:21:08.96,Default,,0,0,0,,Бұл Джо, Джо.
Dialogue: 0,0:21:09.09,0:21:12.55,Default,,0,0,0,,Ол әлі шыққан жоқ, бірақ ұялшақ, хехехехе
Dialogue: 0,0:21:12.67,0:21:15.38,Default,,0,0,0,,Білесің бе, мен әлі туылған жоқпын.
Dialogue: 0,0:21:15.97,0:21:20.22,Default,,0,0,0,,Сонымен... бұл жігіттердің барлығы бірге өте әсерлі сапарға шықты.
Dialogue: 0,0:21:20.35,0:21:23.10,Default,,0,0,0,,Иә? Эй Сачио! а?
Dialogue: 0,0:21:23.23,0:21:25.48,Default,,0,0,0,,Балалар, сендер де мәңгі бақытты бола алмайсыңдар!
Dialogue: 0,0:21:25.60,0:21:26.73,Default,,0,0,0,,Шу!
Dialogue: 0,0:21:26.85,0:21:30.15,Default,,0,0,0,,Соңғы соққыны күтпеген жерден жасаған қария болды.
Dialogue: 0,0:21:30.27,0:21:33.03,Default,,0,0,0,,Канаваги, қайта ашылма.
Dialogue: 0,0:21:33.15,0:21:34.40,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:21:34.70,0:21:36.57,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:21:36.70,0:21:40.41,Default,,0,0,0,,Қалай болғанда да, Мегалония құтты болсын!
Dialogue: 0,0:21:40.53,0:21:43.75,Default,,0,0,0,,Сіз шынымен ұйықтауға рұқсат бергіңіз келе ме?
Dialogue: 0,0:21:44.04,0:21:45.41,Default,,0,0,0,,(Итадори) «Ха! Кугисаки, сол қанға тиме!»
Dialogue: 0,0:21:45.54,0:21:47.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:48.79,0:21:50.88,Default,,0,0,0,,Ау…
Dialogue: 0,0:21:51.59,0:21:53.51,Default,,0,0,0,,Сіз қашып кетесіз бе? Ағай!
Dialogue: 0,0:21:53.63,0:21:55.26,Default,,0,0,0,,Бұл ұят
Dialogue: 0,0:22:06.98,0:22:08.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:08.44,0:22:11.32,Default,,0,0,0,,Мен Джоға және басқаларға әлі айтқан жоқпын.
Dialogue: 0,0:22:11.57,0:22:14.03,Default,,0,0,0,,Сіз оны бүгінге ала аласыз ба?
Dialogue: 0,0:22:14.24,0:22:15.65,Default,,0,0,0,,Фудзимаки мырза
Dialogue: 0,0:22:19.70,0:22:21.49,Default,,0,0,0,,бар.
Dialogue: 0,0:22:21.62,0:22:27.58,Default,,0,0,0,,Сенің нәпсі тамырыңа көзімді жұмып, Армандар уға толы шаяндай.
Dialogue: 0,0:22:32.29,0:22:36.92,Default,,0,0,0,,Кешіріңіз, Нанбу мырза, бұл соңғы нүкте.
Dialogue: 0,0:22:40.18,0:22:45.85,Default,,0,0,0,,♪~
Dialogue: 0,0:22:47.35,0:22:52.35,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
