Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.98,STAFF 2,,0,0,0,,[²]，～
Dialogue: 0,0:00:00.00,0:00:02.98,STAFF 2,,0,0,0,,Жапондық көшіру және аударма және кейінгі кезең: Эча Роши мектебі және қауын: Корольдің мата жинағы
Dialogue: 2,0:00:00.00,0:00:02.98,-,,0,0,0,,Ән айт! Жанның тарихы!
Dialogue: 1,0:00:00.80,0:00:02.30,-,,0,0,0,,Енот Carcar тобы
Dialogue: 0,0:00:00.80,0:00:02.30,-,,0,0,0,,...
Dialogue: 1,0:00:03.66,0:00:05.46,-,,0,0,0,,Әркімнің айтары бар.
Dialogue: 0,0:00:03.66,0:00:05.46,-,,0,0,0,,Үй иесінің әңгімесі
Dialogue: 1,0:00:06.70,0:00:08.10,-,,0,0,0,,Тапсырманың екінші күнінің таңы
Dialogue: 0,0:00:06.70,0:00:08.10,-,,0,0,0,,Екінші аспанның келуі
Dialogue: 1,0:00:08.33,0:00:10.16,-,,0,0,0,,Миддл мырза айтып берді
Dialogue: 0,0:00:08.33,0:00:10.16,-,,0,0,0,,Йонеда мырзаның маған хабарламасы
Dialogue: 1,0:00:10.46,0:00:11.53,-,,0,0,0,,Біз туралы
Dialogue: 0,0:00:10.46,0:00:11.53,-,,0,0,0,,Сізді алаңдататын нәрселер
Dialogue: 1,0:00:11.53,0:00:12.53,-,,0,0,0,,Жұмыс туралы
Dialogue: 0,0:00:11.53,0:00:12.53,-,,0,0,0,,Өндірушінің мәселесі
Dialogue: 1,0:00:12.90,0:00:14.13,-,,0,0,0,,Біз қазір
Dialogue: 0,0:00:12.90,0:00:14.13,-,,0,0,0,,Мен бармын
Dialogue: 1,0:00:14.43,0:00:16.46,-,,0,0,0,,Мұнда не істеуіміз керек?
Dialogue: 0,0:00:14.43,0:00:16.46,-,,0,0,0,,Қайдасың?
Dialogue: 1,0:00:16.90,0:00:17.46,-,,0,0,0,,Міндеттемелер
Dialogue: 0,0:00:16.90,0:00:17.46,-,,0,0,0,,Міндет
Dialogue: 1,0:00:17.46,0:00:18.36,-,,0,0,0,,Жоқ... сен әзілдеп тұрсың ғой?
Dialogue: 0,0:00:17.46,0:00:18.36,-,,0,0,0,,Жауапкершілік
Dialogue: 1,0:00:18.66,0:00:19.30,-,,0,0,0,,Миссия
Dialogue: 0,0:00:18.66,0:00:19.30,-,,0,0,0,,Миссия
Dialogue: 1,0:00:19.30,0:00:20.13,-,,0,0,0,,Өмір
Dialogue: 0,0:00:19.30,0:00:20.13,-,,0,0,0,,Өмір
Dialogue: 1,0:00:20.13,0:00:22.03,-,,0,0,0,,Мен мұны бірінші рет білдім
Dialogue: 0,0:00:20.13,0:00:22.03,-,,0,0,0,,Бастапқы даналық жолы
Dialogue: 1,0:00:22.03,0:00:25.33,-,,0,0,0,,Бұл кеңседе нөлдік сату бар.
Dialogue: 0,0:00:22.03,0:00:25.33,-,,0,0,0,,Сіздің кеңсеңіздегі музыка нөлге тең.
Dialogue: 1,0:00:25.33,0:00:26.70,-,,0,0,0,,Нөлден алыс
Dialogue: 0,0:00:25.33,0:00:26.70,-,,0,0,0,,Нөл дегеніміз не?
Dialogue: 0,0:00:24.42,0:00:25.92,-,,0,0,0,,《Көрнекі қуат》
Dialogue: 0,0:00:24.42,0:00:25.92,-,,0,0,0,,《Қанша піл》
Dialogue: 0,0:00:24.42,0:00:25.92,-,,0,0,0,,《Үй иесі оны қалай мақұлдай алады?》
Dialogue: 0,0:00:24.42,0:00:25.92,-,,0,0,0,,《рентабельділікті арттыру әдістері》
Dialogue: 1,0:00:26.70,0:00:28.73,-,,0,0,0,,Бұл теріс
Dialogue: 0,0:00:26.70,0:00:28.73,-,,0,0,0,,Алымдар саны
Dialogue: 1,0:00:28.73,0:00:31.46,-,,0,0,0,,Мені бас кеңсе байқады
Dialogue: 0,0:00:28.73,0:00:31.46,-,,0,0,0,,Жоғарыда аталған компания жарияланды.
Dialogue: 1,0:00:31.46,0:00:33.70,-,,0,0,0,,Жағдайы нашарлай бастайды.
Dialogue: 0,0:00:31.46,0:00:33.70,-,,0,0,0,,Өте жағымсыз жағдайлар
Dialogue: 1,0:00:33.70,0:00:36.53,-,,0,0,0,,Ішкі жүйе қысымының үмітсіздігі
Dialogue: 0,0:00:33.70,0:00:36.53,-,,0,0,0,,Ішкі мүшелік
Dialogue: 1,0:00:36.53,0:00:38.46,-,,0,0,0,,Сатуды арттыру керек
Dialogue: 0,0:00:36.53,0:00:38.46,-,,0,0,0,,Қажетті жоғары көлем
Dialogue: 1,0:00:38.46,0:00:39.86,-,,0,0,0,,Сатуды ұлғайту
Dialogue: 0,0:00:38.46,0:00:39.86,-,,0,0,0,,Маған не істеу керек?
Dialogue: 1,0:00:39.86,0:00:40.66,-,,0,0,0,,Сату
Dialogue: 0,0:00:39.86,0:00:40.66,-,,0,0,0,,...
Dialogue: 1,0:00:40.66,0:00:41.36,-,,0,0,0,,Сату
Dialogue: 0,0:00:40.66,0:00:41.36,-,,0,0,0,,...
Dialogue: 1,0:00:41.36,0:00:43.70,-,,0,0,0,,Бірақ жауабын ешкім білмейді
Dialogue: 0,0:00:41.36,0:00:43.70,-,,0,0,0,,Алайда белгісіз жауап кім?
Dialogue: 1,0:00:44.30,0:00:46.80,-,,0,0,0,,Өйткені біз бізбіз
Dialogue: 0,0:00:44.30,0:00:46.80,-,,0,0,0,,Өйткені мен осындамын.
Dialogue: 1,0:00:46.80,0:00:49.36,-,,0,0,0,,Иә, бізге жауап жоқ.
Dialogue: 0,0:00:46.80,0:00:49.36,-,,0,0,0,,Иә, менде жауап жоқ.
Dialogue: 1,0:00:49.63,0:00:52.06,-,,0,0,0,,Өйткені біз бізбіз.
Dialogue: 0,0:00:49.63,0:00:52.06,-,,0,0,0,,Себебі мен осындамын.
Dialogue: 1,0:00:52.90,0:00:53.70,-,,0,0,0,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:00:52.90,0:00:53.70,-,,0,0,0,,...
Dialogue: 1,0:00:55.03,0:00:57.83,-,,0,0,0,,Өйткені біз бізбіз
Dialogue: 0,0:00:55.03,0:00:57.83,-,,0,0,0,,Себебі мен осындамын.
Dialogue: 1,0:00:57.83,0:00:58.86,-,,0,0,0,,Иә~
Dialogue: 0,0:00:57.83,0:00:58.86,-,,0,0,0,,～
Dialogue: 0,0:01:00.03,0:01:02.87,-,,0,0,0,,Ура! Барыңыз! Ура! Барыңыз!
Dialogue: 0,0:01:00.03,0:01:02.87,-,,0,0,0,,...
Dialogue: 0,0:01:02.87,0:01:06.00,-,,0,0,0,,Сәлем! Барыңыз! Ура! Бар!
Dialogue: 0,0:01:02.87,0:01:06.00,-,,0,0,0,,...
Dialogue: 0,0:01:07.92,0:01:08.67,-,,0,0,0,,Неліктен?
Dialogue: 0,0:01:07.92,0:01:08.67,-,,0,0,0,,...
Dialogue: 0,0:01:10.17,0:01:11.13,-,,0,0,0,,Бұл уақыт әлдеқашан ба?!
Dialogue: 0,0:01:10.17,0:01:11.13,-,,0,0,0,,Қашан келді? !
Dialogue: 0,0:01:11.13,0:01:15.30,-,,0,0,0,,Аа, 0 сағат айналады, дірілдеп
Dialogue: 0,0:01:11.13,0:01:15.30,-,,0,0,0,,~
Dialogue: 0,0:01:15.30,0:01:18.09,-,,0,0,0,,Түсімде ұшатынмын
Dialogue: 0,0:01:15.30,0:01:18.09,-,,0,0,0,,Ауылда болу - кеңеюдің табиғи жолы.
Dialogue: 0,0:01:18.09,0:01:20.81,-,,0,0,0,,Рикиру Рикиру Әлемдегі ең жеңіл
Dialogue: 0,0:01:18.09,0:01:20.81,-,,0,0,0,,Әлемдегі ең күшті
Dialogue: 0,0:01:20.81,0:01:23.52,-,,0,0,0,,Рикиру Рикиру Жеңіл шешіңіз!
Dialogue: 0,0:01:20.81,0:01:23.52,-,,0,0,0,,...
Dialogue: 0,0:01:23.52,0:01:26.35,-,,0,0,0,,Дүниені оңай жаулап ал
Dialogue: 0,0:01:23.52,0:01:26.35,-,,0,0,0,,...
Dialogue: 0,0:01:26.35,0:01:29.61,-,,0,0,0,,Рикиру Рикиру Мен саған Ханамаруды оңай беремін.
