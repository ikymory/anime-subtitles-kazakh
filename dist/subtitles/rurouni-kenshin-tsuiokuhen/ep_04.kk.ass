Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.30,0:00:11.96,Default,,0,0,0,,Инсайдер бұзылды
Dialogue: 0,0:00:13.34,0:00:14.11,Default,,0,0,0,,Томое.
Dialogue: 0,0:00:15.13,0:00:17.00,Default,,0,0,0,,Таудың арғы жағындағы ғибадатханада бір досым бар.
Dialogue: 0,0:00:17.85,0:00:19.47,Default,,0,0,0,,Томое сонда шығар
Dialogue: 0,0:00:21.22,0:00:22.18,Default,,0,0,0,,Одан құтылыңыз
Dialogue: 0,0:01:04.46,0:01:05.24,Default,,0,0,0,,Әпке
Dialogue: 0,0:02:03.40,0:02:04.35,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:02:05.35,0:02:09.58,Default,,0,0,0,,Ұзақ тұрудың қажеті жоқ. Енді ары қарай жүрейік.
Dialogue: 0,0:02:18.04,0:02:19.47,Default,,0,0,0,,Көріскенше Химура
Dialogue: 0,0:02:39.41,0:02:41.64,Default,,0,0,0,,Біз бұл күйде қанша уақыт тұра аламыз?
Dialogue: 0,0:02:47.48,0:02:49.18,Default,,0,0,0,,Неліктен шеттерді қатыстырдыңыз?
Dialogue: 0,0:02:49.69,0:02:53.00,Default,,0,0,0,,Мен Киотодағы әпкем туралы сұрадым.
Dialogue: 0,0:02:53.27,0:02:55.77,Default,,0,0,0,,Басшы сол монахты әкелді.
Dialogue: 0,0:02:56.16,0:02:59.04,Default,,0,0,0,,Әңгіме дәл сізбен бірдей.
Dialogue: 0,0:03:00.29,0:03:01.38,Default,,0,0,0,,Қалғандары ше?
Dialogue: 0,0:03:01.75,0:03:04.67,Default,,0,0,0,,Тауда шашылғанды күту
Dialogue: 0,0:03:05.10,0:03:06.65,Default,,0,0,0,,Менің жаңалықтарымды естімей ме?
Dialogue: 0,0:03:06.90,0:03:07.72,Default,,0,0,0,,Жаңалықтар?
Dialogue: 0,0:03:09.10,0:03:11.38,Default,,0,0,0,,Хитокири Баттоусайдың осал тұсы осы болды.
Dialogue: 0,0:03:11.63,0:03:12.83,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:03:13.17,0:03:14.15,Default,,0,0,0,,Олай болса
Dialogue: 0,0:03:14.55,0:03:17.37,Default,,0,0,0,,Мен не үшінмін?
Dialogue: 0,0:03:18.17,0:03:19.01,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:19.61,0:03:22.70,Default,,0,0,0,,Хитогири қаншалықты суық жүректі болса да,
Dialogue: 0,0:03:23.01,0:03:24.90,Default,,0,0,0,,Мейірімсіз еркек жоқ.
Dialogue: 0,0:03:25.80,0:03:28.38,Default,,0,0,0,,Оның дәл қазір ең үлкен әлсіздігі
Dialogue: 0,0:03:28.93,0:03:30.33,Default,,0,0,0,,Сіз өзіңізсіз.
Dialogue: 0,0:03:31.32,0:03:33.13,Default,,0,0,0,,Ол осында келе жатыр.
Dialogue: 0,0:03:33.47,0:03:35.57,Default,,0,0,0,,Әрине, сізбен кездесу үшін.
Dialogue: 0,0:03:36.02,0:03:38.74,Default,,0,0,0,,Бірақ ол өзіне ұнаған әйелдің алаяқ екенін білді.
Dialogue: 0,0:03:39.10,0:03:41.03,Default,,0,0,0,,Менің жүрегім мың дана
Dialogue: 0,0:03:41.30,0:03:45.57,Default,,0,0,0,,Қазіргі жігіт өзінің бастапқы күшін пайдалана алмайды.
Dialogue: 0,0:03:45.84,0:03:48.31,Default,,0,0,0,,Бұл біздің шынайы мақсатымыз
Dialogue: 0,0:03:48.61,0:03:49.70,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:03:50.11,0:03:51.95,Default,,0,0,0,,Бұл менің басынан бастап ниетім болатын...
Dialogue: 0,0:03:52.75,0:03:54.19,Default,,0,0,0,,мен
Dialogue: 0,0:03:54.47,0:03:56.79,Default,,0,0,0,,Олай болса... сен не істер едің?
Dialogue: 0,0:04:45.10,0:04:46.11,Default,,0,0,0,,Сіз ғашық болдыңыз ба?
Dialogue: 0,0:04:46.81,0:04:49.43,Default,,0,0,0,,Қыздар қиын нәрселер.
Dialogue: 0,0:04:49.74,0:04:52.17,Default,,0,0,0,,Бұл түсінікті.
Dialogue: 0,0:04:52.47,0:04:54.76,Default,,0,0,0,,Адамның сезімдері құбылмалы.
Dialogue: 0,0:04:54.97,0:04:56.69,Default,,0,0,0,,Ол неғұрлым күшті және күштірек болса
Dialogue: 0,0:04:56.73,0:04:58.56,Default,,0,0,0,,Мен өзіме көмектесе алмаймын
Dialogue: 0,0:04:59.21,0:05:04.70,Default,,0,0,0,,Жек көру мен ғашық болу арасындағы айырмашылық тіпті жіңішке сызық емес шығар.
Dialogue: 0,0:05:05.46,0:05:08.27,Default,,0,0,0,,Бұл адам еңбегі.
Dialogue: 0,0:05:08.85,0:05:12.74,Default,,0,0,0,,Қаншалықты жақсы хитокир болса да, әйел жұмысының алдында,
Dialogue: 0,0:05:12.93,0:05:14.08,Default,,0,0,0,,Сәби сияқты
Dialogue: 0,0:05:17.96,0:05:19.42,Default,,0,0,0,,Басынан бастап...
Dialogue: 0,0:05:29.61,0:05:30.78,Default,,0,0,0,,Абайсызда болмаңыз
Dialogue: 0,0:05:33.33,0:05:37.29,Default,,0,0,0,,Тіліңді тістеп алу үшін көп күш пен жігер керек.
Dialogue: 0,0:05:37.38,0:05:38.07,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:05:39.07,0:05:41.97,Default,,0,0,0,,Өлгенде не болатыны маңызды емес.
Dialogue: 0,0:06:18.25,0:06:20.18,Default,,0,0,0,,Өлгің келсе, қалағаныңды істе.
Dialogue: 0,0:06:21.26,0:06:24.18,Default,,0,0,0,,Бірақ бұл бәрінің қалай басталғанын ұмыттық дегенді білдірмейді.
Dialogue: 0,0:06:24.76,0:06:26.92,Default,,0,0,0,,Мен неге өлуім керек болды?
Dialogue: 0,0:06:27.17,0:06:28.13,Default,,0,0,0,,Киёсато...
Dialogue: 0,0:06:44.78,0:06:47.42,Default,,0,0,0,,Киёсато сіз үшін қандай?
Dialogue: 0,0:06:47.45,0:06:48.87,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:06:49.71,0:06:52.18,Default,,0,0,0,,Бұл таптырмас нәрсе емес пе еді?
Dialogue: 0,0:06:53.96,0:06:55.78,Default,,0,0,0,,Кем дегенде Киёсато үшін
Dialogue: 0,0:06:55.86,0:06:58.62,Default,,0,0,0,,Сіз таптырмас едіңіз.
Dialogue: 0,0:06:59.16,0:07:00.19,Default,,0,0,0,,болмаса
Dialogue: 0,0:07:00.39,0:07:01.69,Default,,0,0,0,,Менің шеберлігіме сенімді емес
Dialogue: 0,0:07:01.86,0:07:03.86,Default,,0,0,0,,Дүрбелең астанаға ешкім келмейді.
Dialogue: 0,0:07:04.05,0:07:06.03,Default,,0,0,0,,Тіпті өмірімді қатерге тігіп
Dialogue: 0,0:07:06.21,0:07:08.54,Default,,0,0,0,,Ол сені бақытты еткісі келген шығар.
Dialogue: 0,0:07:09.95,0:07:15.78,Default,,0,0,0,,Егер солай болса, жанымда болса болғаны... маған керегі осы...
Dialogue: 0,0:07:15.95,0:07:18.10,Default,,0,0,0,,Бұл адамның жұмысы.
Dialogue: 0,0:07:18.32,0:07:20.22,Default,,0,0,0,,Әйелді бақытты ету
Dialogue: 0,0:07:20.29,0:07:21.44,Default,,0,0,0,,Үй, ауыл
Dialogue: 0,0:07:21.61,0:07:24.34,Default,,0,0,0,,Біз осы Токугава әлемін сақтауымыз керек.
Dialogue: 0,0:07:24.60,0:07:28.36,Default,,0,0,0,,Дүниеде тыныштық болмаса, жеке бақытқа қол жеткізу мүмкін емес.
Dialogue: 0,0:07:28.86,0:07:31.29,Default,,0,0,0,,Осы Токугава әлемінде зиян келтіретін адам болса
Dialogue: 0,0:07:31.46,0:07:33.83,Default,,0,0,0,,Бүршік қанша кішкентай болса да
Dialogue: 0,0:07:34.00,0:07:36.23,Default,,0,0,0,,Мұны кез келген жолмен алыңыз
Dialogue: 0,0:07:36.50,0:07:38.37,Default,,0,0,0,,Бұл сақтық
Dialogue: 0,0:07:38.57,0:07:41.10,Default,,0,0,0,,Токугава 300 жылдық бейбітшіліктің себебі
Dialogue: 0,0:07:41.30,0:07:43.82,Default,,0,0,0,,Біз оны қолдадық.
Dialogue: 0,0:07:44.05,0:07:46.74,Default,,0,0,0,,Бұл біздің жұмысымыз.
Dialogue: 0,0:07:47.01,0:07:50.45,Default,,0,0,0,,Біз де адамдардың бақытын қорғаймыз...
Dialogue: 0,0:07:50.65,0:07:52.26,Default,,0,0,0,,Өз өміріңізге қауіп төндіріңіз
Dialogue: 0,0:07:53.96,0:07:55.24,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:07:55.72,0:07:59.18,Default,,0,0,0,,Біз бәріміз бір топ қу адамдармыз.
Dialogue: 0,0:08:07.59,0:08:11.55,Default,,0,0,0,,Сол кармада өмір сүр және өл
Dialogue: 0,0:08:12.41,0:08:15.39,Default,,0,0,0,,Бұл адамның анықтамасы.
Dialogue: 0,0:08:27.53,0:08:29.47,Default,,0,0,0,,Біз Токугава үшінміз
Dialogue: 0,0:08:29.64,0:08:32.21,Default,,0,0,0,,Осы әлемді қорғау үшін оны жеңіңіз
Dialogue: 0,0:08:32.65,0:08:36.04,Default,,0,0,0,,Сенің оны ұнатқаныңның бәрі кармаға байланысты болды.
Dialogue: 0,0:08:36.43,0:08:39.07,Default,,0,0,0,,Қателік жасамайтын адам болмайды.
Dialogue: 0,0:08:39.29,0:08:41.11,Default,,0,0,0,,Кийосатоны еске түсіріңіз
Dialogue: 0,0:08:41.21,0:08:44.22,Default,,0,0,0,,Қайта алмас адам, Киёсато...
Dialogue: 0,0:08:52.11,0:08:53.17,Default,,0,0,0,,Және де...
Dialogue: 0,0:08:58.81,0:09:00.02,Default,,0,0,0,,То... мо...
Dialogue: 0,0:09:27.84,0:09:29.62,Default,,0,0,0,,Және де...
Dialogue: 0,0:09:35.78,0:09:37.03,Default,,0,0,0,,Жарты жылдан астам
Dialogue: 0,0:09:37.08,0:09:39.81,Default,,0,0,0,,Қосымша құрбандықтар қажет пе?
Dialogue: 0,0:09:40.35,0:09:42.53,Default,,0,0,0,,Бірақ мен мұны да білемін.
Dialogue: 0,0:09:42.96,0:09:45.24,Default,,0,0,0,,Мен оны міндетті түрде өлтіремін.
Dialogue: 0,0:09:45.63,0:09:47.47,Default,,0,0,0,,Киёсатоның мәні осы.
Dialogue: 0,0:09:47.64,0:09:50.26,Default,,0,0,0,,Ал сегунат үшін бытырап кеткен көптеген қарамағындағылардың өлімі.
Dialogue: 0,0:09:50.26,0:09:54.06,Default,,0,0,0,,Бекер өлмеудің жалғыз жолы
Dialogue: 0,0:09:54.33,0:09:57.62,Default,,0,0,0,,Ал сіз оны өз көзіңізбен көруіңіз керек.
Dialogue: 0,0:09:57.82,0:10:01.82,Default,,0,0,0,,Бұл сіздің бақытыңызды қорғаймын деп өлген Киёсатоға.
Dialogue: 0,0:10:02.00,0:10:04.00,Default,,0,0,0,,Ең болмағанда жерлеу болады.
Dialogue: 0,0:10:06.33,0:10:08.39,Default,,0,0,0,,Киёсато мырза...
Dialogue: 0,0:11:12.28,0:11:14.33,Default,,0,0,0,,Үй иесі, мен бөлме алғым келеді.
Dialogue: 0,0:11:14.90,0:11:17.18,Default,,0,0,0,,Чошу руы бос емес.
Dialogue: 0,0:11:17.59,0:11:19.53,Default,,0,0,0,,Хитокири болған соң қызды алғыңыз келе ме?
Dialogue: 0,0:11:20.55,0:11:24.21,Default,,0,0,0,,Ештеңе... ол менің әйелім емес.
Dialogue: 0,0:11:25.16,0:11:26.84,Default,,0,0,0,,Ешкім олай ойламайды.
Dialogue: 0,0:11:27.14,0:11:29.30,Default,,0,0,0,,Ол мен бір рет көмектескен әйел болуы мүмкін.
Dialogue: 0,0:11:30.94,0:11:33.03,Default,,0,0,0,,Катсура-сан, аман бол!
Dialogue: 0,0:11:33.53,0:11:35.43,Default,,0,0,0,,Өлгенімді қалаймын.
Dialogue: 0,0:11:36.27,0:11:38.05,Default,,0,0,0,,Енді мен бәрінен айырылдым
Dialogue: 0,0:12:26.46,0:12:28.14,Default,,0,0,0,,Сіз Отсуға барасыз ба?
Dialogue: 0,0:12:30.50,0:12:32.89,Default,,0,0,0,,Сіз Отсуға барасыз ба?
Dialogue: 0,0:12:39.96,0:12:41.27,Default,,0,0,0,,Сіз Отсуға барасыз ба?
Dialogue: 0,0:12:46.78,0:12:47.67,Default,,0,0,0,,Отсуға…
Dialogue: 0,0:12:53.15,0:12:55.99,Default,,0,0,0,,Барамыз ба! Отсуға...
Dialogue: 0,0:13:34.75,0:13:35.57,Default,,0,0,0,,Оның сыртқы түрі
Dialogue: 0,0:13:36.56,0:13:39.90,Default,,0,0,0,,Осы нүктеге жету үшін біз жасай алатын ең жақсы нәрсе ме?
Dialogue: 0,0:13:40.55,0:13:41.81,Default,,0,0,0,,Баттосай болса да
Dialogue: 0,0:13:41.93,0:13:43.37,Default,,0,0,0,,Қорғайтын ештеңесі жоқ шайқас
Dialogue: 0,0:13:43.39,0:13:45.35,Default,,0,0,0,,Бұл қатал.
Dialogue: 0,0:13:46.33,0:13:47.94,Default,,0,0,0,,Ең алдымен,
Dialogue: 0,0:13:48.11,0:13:50.25,Default,,0,0,0,,Сізде басынан бастап қорғайтын ештеңе болған жоқ.
Dialogue: 0,0:13:50.28,0:13:51.99,Default,,0,0,0,,Бізге ұқсамайды
Dialogue: 0,0:13:53.10,0:13:54.53,Default,,0,0,0,,Сегунаттың бұйрығымен
Dialogue: 0,0:13:54.69,0:13:56.96,Default,,0,0,0,,Ями но Такешидің жетекшісі ретінде мен мәселені қазірден бастап шешемін.
Dialogue: 0,0:13:57.18,0:13:59.85,Default,,0,0,0,,Сонымен қатар, қол астындағылардың өкінішін қайтарамын.
Dialogue: 0,0:14:00.35,0:14:02.85,Default,,0,0,0,,Бұл мен бере алатын жалғыз өтемақы
Dialogue: 0,0:14:03.51,0:14:06.44,Default,,0,0,0,,Оларды қорға, мен!
Dialogue: 0,0:16:26.29,0:16:30.72,Default,,0,0,0,,Мен әлсіздердің бақытын қорғау үшін адамдарды өлтірдім.
Dialogue: 0,0:16:32.92,0:16:37.23,Default,,0,0,0,,Бірақ... соның кесірінен бақытыңыздан айырылдыңыз.
Dialogue: 0,0:16:38.61,0:16:42.61,Default,,0,0,0,,Мен сенен қымбат нәрсе ұрлап алдым.
Dialogue: 0,0:16:43.39,0:16:44.69,Default,,0,0,0,,Білмей...
Dialogue: 0,0:16:45.56,0:16:47.26,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:50.14,0:16:54.43,Default,,0,0,0,,Менде сізді қорғайтын біліктілік болмады.
Dialogue: 0,0:16:57.81,0:17:02.33,Default,,0,0,0,,Сонда да мен... сіз…
Dialogue: 0,0:17:06.17,0:17:09.74,Default,,0,0,0,,And it sold better than I expected...
Dialogue: 0,0:17:09.74,0:17:12.25,Default,,0,0,0,,Жоқ, жеуге онша дәмді емес көрінеді...
Dialogue: 0,0:17:12.25,0:17:14.79,Default,,0,0,0,,Бірақ мен әйтеуір бір ойдан адасып кеткендей болдым...
Dialogue: 0,0:17:14.79,0:17:17.09,Default,,0,0,0,,In the evening, I saw Акане Акане.
Dialogue: 0,0:17:30.26,0:17:31.18,Default,,0,0,0,,Томое
Dialogue: 0,0:17:33.22,0:17:38.09,Default,,0,0,0,,I will protect you
Dialogue: 0,0:17:52.42,0:17:53.77,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:17:54.57,0:17:57.01,Default,,0,0,0,,What a girl is...
Dialogue: 0,0:18:01.33,0:18:02.77,Default,,0,0,0,,Tomoe
Dialogue: 0,0:18:20.40,0:18:22.10,Default,,0,0,0,,Tomoe
Dialogue: 0,0:18:57.65,0:19:04.02,Default,,0,0,0,,Кешіріңіз...сіз...
Dialogue: 0,0:19:31.98,0:19:33.19,Default,,0,0,0,,Әпке...
Dialogue: 0,0:19:51.82,0:19:55.99,Default,,0,0,0,,Tomoe, I lost you.
Dialogue: 0,0:19:56.97,0:20:00.04,Default,,0,0,0,,Мен сенің қиналғаныңды түсінгендей болдым.
Dialogue: 0,0:20:01.35,0:20:04.35,Default,,0,0,0,,Сіз бұл сезімдерге көптен бері шыдап жүрсіз ғой, солай емес пе?
Dialogue: 0,0:20:04.70,0:20:05.89,Default,,0,0,0,,It must have been painful.
Dialogue: 0,0:20:06.26,0:20:07.56,Default,,0,0,0,,Мен оны жек көретін едім
Dialogue: 0,0:20:08.47,0:20:12.04,Default,,0,0,0,,But you protected me
Dialogue: 0,0:20:12.65,0:20:15.11,Default,,0,0,0,,You kept me alive like this.
Dialogue: 0,0:20:16.46,0:20:20.77,Default,,0,0,0,,Бірақ енді өзіңізді жаман сезінудің қажеті жоқ.
Dialogue: 0,0:20:21.54,0:20:23.13,Default,,0,0,0,,Сізге азап шегудің қажеті жоқ, солай ма?
Dialogue: 0,0:20:24.31,0:20:27.58,Default,,0,0,0,,I will live with this pain on my back.
Dialogue: 0,0:20:28.12,0:20:30.91,Default,,0,0,0,,I must find a way to make amends.
Dialogue: 0,0:20:31.59,0:20:33.94,Default,,0,0,0,,With the person who died protecting me
Dialogue: 0,0:20:34.56,0:20:37.94,Default,,0,0,0,,To avenge the lives of those I killed...
Dialogue: 0,0:20:38.96,0:20:39.79,Default,,0,0,0,,Бұл өте ауыр
Dialogue: 0,0:20:40.40,0:20:42.11,Default,,0,0,0,,I think it's probably okay.
Dialogue: 0,0:20:42.66,0:20:44.13,Default,,0,0,0,,It has always been that way.
Dialogue: 0,0:20:44.72,0:20:49.62,Default,,0,0,0,,Сіз маған үйреткен адамдардың жылы лебізін есіме түсіре алсам...
Dialogue: 0,0:20:49.72,0:20:52.26,Default,,0,0,0,,Maybe I...
Dialogue: 0,0:20:53.53,0:20:56.55,Default,,0,0,0,,I have to say goodbye to you.
Dialogue: 0,0:20:56.95,0:21:00.47,Default,,0,0,0,,Әзірше... дәл қазір
Dialogue: 0,0:21:01.44,0:21:05.18,Default,,0,0,0,,Just like this, the two of us together...
Dialogue: 0,0:21:07.54,0:21:08.54,Default,,0,0,0,,Tomoe
Dialogue: 0,0:21:15.04,0:21:15.92,Default,,0,0,0,,Қайық кетіп бара жатыр.
Dialogue: 0,0:21:15.92,0:21:18.17,Default,,0,0,0,,Енді мен білмес бұрын
Dialogue: 0,0:21:18.25,0:21:19.85,Default,,0,0,0,,Opened
Dialogue: 0,0:21:19.45,0:21:21.17,Default,,0,0,0,,Тез қызыққыңыз келе ме?
Dialogue: 0,0:21:24.72,0:21:27.17,Default,,0,0,0,,Tsk! Бұл жолы тексерілетін кезегім бе?
Dialogue: 0,0:21:28.23,0:21:31.35,Default,,0,0,0,,Бірақ олар: «Қалқымалы дүниенің бәрі құмар ойыны» дейді...
Dialogue: 0,0:21:32.73,0:21:33.93,Default,,0,0,0,,Where do you go?
Dialogue: 0,0:21:34.53,0:21:36.75,Default,,0,0,0,,Бұл өсуді жалғастырғанша!
Dialogue: 0,0:21:42.90,0:21:43.55,Default,,0,0,0,,Гимура
Dialogue: 0,0:21:44.35,0:21:46.91,Default,,0,0,0,,Мен мұнда не болғанын көп зерттедім.
Dialogue: 0,0:21:47.83,0:21:48.65,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:21:49.60,0:21:50.56,Default,,0,0,0,,Катсура мырза...
Dialogue: 0,0:21:51.46,0:21:53.01,Default,,0,0,0,,Ақпарат беруші жойылды
Dialogue: 0,0:21:53.92,0:21:56.15,Default,,0,0,0,,Білікті бір адамды табыңыз.
Dialogue: 0,0:22:05.78,0:22:08.33,Default,,0,0,0,,Жаңа жыл ерте келді...
Dialogue: 0,0:22:13.82,0:22:15.53,Default,,0,0,0,,Болашақта қастандық бизнесі
Dialogue: 0,0:22:15.83,0:22:17.64,Default,,0,0,0,,Мен мұны оған қалдыруды шештім.
Dialogue: 0,0:22:19.71,0:22:23.14,Default,,0,0,0,,Бірақ сіз семсерді көбірек ұстауыңыз керек.
Dialogue: 0,0:22:23.72,0:22:25.11,Default,,0,0,0,,Киото өте ауыр жағдайда.
Dialogue: 0,0:22:25.51,0:22:26.73,Default,,0,0,0,,Синсенгуми жетекші орында
Dialogue: 0,0:22:26.94,0:22:28.76,Default,,0,0,0,,Шогундық патриоттарды іздеуді күшейтуде.
Dialogue: 0,0:22:29.40,0:22:30.97,Default,,0,0,0,,Біреу қылышпен қарсы тұруы керек
Dialogue: 0,0:22:31.27,0:22:32.32,Default,,0,0,0,,Толық жойылу сөзсіз
Dialogue: 0,0:22:33.58,0:22:34.50,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:22:36.09,0:22:36.83,Default,,0,0,0,,Гимура
Dialogue: 0,0:22:37.42,0:22:37.98,Default,,0,0,0,,Иә
Dialogue: 0,0:22:39.07,0:22:41.07,Default,,0,0,0,,Мен бірде Томое мырзадан сұрадым.
Dialogue: 0,0:22:41.84,0:22:44.47,Default,,0,0,0,,Мен сіздің «артық денені» ұстайтын «қапшық» болғаныңызды қалаймын.
Dialogue: 0,0:22:44.80,0:22:45.51,Default,,0,0,0,,Қабық?
Dialogue: 0,0:22:46.05,0:22:50.03,Default,,0,0,0,,Иә, ол әлі сенің қынабың.
Dialogue: 0,0:22:50.70,0:22:51.98,Default,,0,0,0,,Бұл жігітті шын мәнінде өлтіру керек.
Dialogue: 0,0:22:56.41,0:22:57.22,Default,,0,0,0,,Катсура-сан
Dialogue: 0,0:22:58.73,0:23:00.21,Default,,0,0,0,,Менің қазір істей алатыным
Dialogue: 0,0:23:00.51,0:23:02.81,Default,,0,0,0,,Тек қылышыңды сермеп жүр...
Dialogue: 0,0:23:03.33,0:23:05.19,Default,,0,0,0,,Өйткені Томо да соны қалады.
Dialogue: 0,0:23:05.58,0:23:07.95,Default,,0,0,0,,Ол мені қорғады деп ойлаймын.
Dialogue: 0,0:23:08.40,0:23:09.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:23:09.65,0:23:11.63,Default,,0,0,0,,Бірақ «жаңа дәуір» келгенде...
Dialogue: 0,0:23:12.15,0:23:13.32,Default,,0,0,0,,Қылышымды лақтыруым керек пе?
Dialogue: 0,0:23:13.70,0:23:14.65,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:23:15.11,0:23:16.92,Default,,0,0,0,,Алайда, сол кезде
Dialogue: 0,0:23:17.21,0:23:20.88,Default,,0,0,0,,Мен енді ешқашан басқа адамды өлтірмеймін. Енді ешқашан...
Dialogue: 0,0:23:24.41,0:23:27.55,Default,,0,0,0,,Шинсаку Сіз айтқандай болды.
Dialogue: 0,0:23:27.94,0:23:29.07,Default,,0,0,0,,Менің қателігім
Dialogue: 0,0:23:29.74,0:23:30.86,Default,,0,0,0,,Hiten's sword is
Dialogue: 0,0:23:31.10,0:23:32.96,Default,,0,0,0,,Ескі дәуірді жоймау
Dialogue: 0,0:23:33.13,0:23:35.59,Default,,0,0,0,,Оны жаңа дәуірді қорғау үшін пайдалану керек еді.
Dialogue: 0,0:23:36.43,0:23:38.55,Default,,0,0,0,,Кешіріңіз Химура
Dialogue: 0,0:23:43.05,0:23:43.84,Default,,0,0,0,,Tomoe
Dialogue: 0,0:23:45.15,0:23:47.31,Default,,0,0,0,,Then I'll go.
Dialogue: 0,0:24:13.91,0:24:14.93,Default,,0,0,0,,Міне болды! Бұл осылай
Dialogue: 0,0:24:15.10,0:24:15.63,Default,,0,0,0,,(Кристи) Ах! (Нат) Ах…
Dialogue: 0,0:24:15.97,0:24:17.82,Default,,0,0,0,,Ешкімнің қашып кетуіне жол берме. Асықшы!
Dialogue: 0,0:24:26.29,0:24:26.96,Default,,0,0,0,,Қабылдамау
Dialogue: 0,0:24:27.16,0:24:27.71,Default,,0,0,0,,Не!
Dialogue: 0,0:24:27.75,0:24:29.27,Default,,0,0,0,,Не? Сіз
Dialogue: 0,0:24:29.65,0:24:31.54,Default,,0,0,0,,Егер шегінсең, өмірің сақталады.
Dialogue: 0,0:24:33.19,0:24:34.21,Default,,0,0,0,,Мен шегінуім керек...
Dialogue: 0,0:24:34.72,0:24:35.54,Default,,0,0,0,,Қызыл шаш...
Dialogue: 0,0:24:35.71,0:24:37.27,Default,,0,0,0,,Сол жақ бетіндегі айқас жара
Dialogue: 0,0:24:37.96,0:24:39.76,Default,,0,0,0,,Сіз «хитокирисіз»
Dialogue: 0,0:24:39.91,0:24:40.77,Default,,0,0,0,,Boss
Dialogue: 0,0:25:16.39,0:25:18.28,Default,,0,0,0,,Окита-кун, артта қал.
Dialogue: 0,0:25:18.71,0:25:19.59,Default,,0,0,0,,Mr. Saito
Dialogue: 0,0:25:20.70,0:25:22.64,Default,,0,0,0,,Мен қанның иісіне сезімталмын.
Dialogue: 0,0:25:23.05,0:25:26.20,Default,,0,0,0,,Оның үстіне қазіргі денеңмен оны өлтіре алмайсың.
Dialogue: 0,0:25:39.43,0:25:40.21,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:29:02.05,0:29:03.19,Default,,0,0,0,,Монахтың аты кім?
Dialogue: 0,0:29:03.51,0:29:04.23,Default,,0,0,0,,Синта
Dialogue: 0,0:29:04.76,0:29:07.14,Default,,0,0,0,,Ол тым мейірімді, қылышшыға жараспайды.
Dialogue: 0,0:29:07.53,0:29:09.85,Default,,0,0,0,,Бұдан былай өзіңізді «Кеншін» деп атаңыз.
Dialogue: 0,0:29:10.35,0:29:11.99,Default,,0,0,0,,Sword…heart
Dialogue: 0,0:29:13.49,0:29:18.49,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
