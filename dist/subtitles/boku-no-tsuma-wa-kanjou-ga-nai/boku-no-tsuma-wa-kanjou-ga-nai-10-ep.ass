Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.75,0:00:05.13,Default,,0,0,0,,Кайсэйдзин қиыншылықта!
Dialogue: 0,0:00:05.21,0:00:06.75,Default,,0,0,0,,Кайсэйцзин Кайдзин…
Dialogue: 0,0:00:06.84,0:00:10.01,Default,,0,0,0,,Мен Кайдзинді Такумамен бірге көп көрдім!
Dialogue: 0,0:00:10.09,0:00:11.92,Default,,0,0,0,,Бұл фильм туралы.
Dialogue: 0,0:00:12.63,0:00:16.18,Default,,0,0,0,,Мен үлкен адаммен бірге тұрамын!
Dialogue: 0,0:00:16.26,0:00:19.31,Default,,0,0,0,,Бұл проектордың көмегімен жасалған үлкен проекция.
Dialogue: 0,0:00:19.39,0:00:22.68,Default,,0,0,0,,Нақты алып адамдар жоқ.
Dialogue: 0,0:00:23.23,0:00:26.35,Default,,0,0,0,,Марстардың да осы уақытқа дейін анықталған жоқ.
Dialogue: 0,0:00:26.44,0:00:27.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:28.31,0:00:30.44,Default,,0,0,0,,Қабілеттік сынақтан өтпеген роботтар
Dialogue: 0,0:00:30.53,0:00:32.94,Default,,0,0,0,,Кинотеатрларға кірмеңіз
Dialogue: 0,0:00:33.03,0:00:36.70,Default,,0,0,0,,Мамору Кешірім сұраған соң жадымызды пішімдеп алайық.
Dialogue: 0,0:00:36.78,0:00:39.62,Default,,0,0,0,,Иә! Уууу...
Dialogue: 0,0:00:39.70,0:00:41.45,Default,,0,0,0,,Ууууу~
Dialogue: 0,0:00:50.30,0:00:51.76,Default,,0,0,0,,1-сынып
Dialogue: 0,0:00:51.84,0:00:54.22,Default,,0,0,0,,Такума мырзамен тексеруге бардыңыз ба?
Dialogue: 0,0:00:54.30,0:00:57.22,Default,,0,0,0,,Мен бардым! 1-сынып Керемет?
Dialogue: 0,0:00:57.80,0:00:59.26,Default,,0,0,0,,оның қазір қайда екенін немесе не істеп жатқанын білуге рұқсат жоқ па? Тіпті соны да білмейміз бе?
Dialogue: 0,0:01:04.31,0:01:07.35,Default,,0,0,0,,-(Мина) Мен 2-сыныпта оқимын -Уау!
Dialogue: 0,0:01:08.23,0:01:09.40,Default,,0,0,0,,Бұл таңқаларлық па?
Dialogue: 0,0:01:09.48,0:01:11.86,Default,,0,0,0,,Мина: Керемет. Маморудан да керемет!
Dialogue: 0,0:01:12.61,0:01:15.36,Default,,0,0,0,,1-сыныпта, егер шебер еріп жүрсе
Dialogue: 0,0:01:15.45,0:01:17.24,Default,,0,0,0,,Әртүрлі жерлерге баруға болады
Dialogue: 0,0:01:17.86,0:01:21.99,Default,,0,0,0,,2-сыныпқа жеткенде өз бетіңізше әрекет ете аласыз.
Dialogue: 0,0:01:22.08,0:01:25.41,Default,,0,0,0,,Керемет! Мина, өзің шыға аласың ба?
Dialogue: 0,0:01:26.29,0:01:27.54,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:01:27.62,0:01:30.38,Default,,0,0,0,,Енді өзіміз дүкен аралайық.
Dialogue: 0,0:01:31.54,0:01:32.88,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:01:32.96,0:01:34.42,Default,,0,0,0,,Мамору сенімен бірге барады ма?
Dialogue: 0,0:01:34.51,0:01:37.93,Default,,0,0,0,,Мамору дүкенге адамсыз кіре алмайды.
Dialogue: 0,0:01:38.01,0:01:39.84,Default,,0,0,0,,Торда т.б.
Dialogue: 0,0:01:39.93,0:01:43.18,Default,,0,0,0,,Егер сіз еркін әрекет ете алмасаңыз, онда проблема жоқ.
Dialogue: 0,0:01:45.02,0:01:47.19,Default,,0,0,0,,Менің тоңазытқыш қоймама кірейік.
Dialogue: 0,0:01:47.27,0:01:49.19,Default,,0,0,0,,Енгізіңіз! мен...
Dialogue: 0,0:01:49.27,0:01:51.56,Default,,0,0,0,,Сізге әлі кірудің қажеті жоқ.
Dialogue: 0,0:01:49.27,0:01:51.56,Default,,0,0,0,,Иә...
Dialogue: 0,0:01:51.56,0:01:52.82,Default,,0,0,0,,Иә...
Dialogue: 0,0:01:52.82,0:01:54.69,Default,,0,0,0,,Иә...
Dialogue: 0,0:01:52.82,0:01:54.69,Default,,0,0,0,,Дүкенге келгеннен кейін
Dialogue: 0,0:01:54.69,0:01:55.94,Default,,0,0,0,,Иә...
Dialogue: 0,0:01:56.03,0:02:01.70,Default,,0,0,0,,♪～
Dialogue: 0,0:03:19.57,0:03:24.57,Default,,0,0,0,,～♪
Dialogue: 0,0:03:29.50,0:03:31.37,Default,,0,0,0,,Жолды түсінесің бе?
Dialogue: 0,0:03:31.46,0:03:34.88,Default,,0,0,0,,Жарайды, картаға кіруге болады.
Dialogue: 0,0:03:40.88,0:03:42.97,Default,,0,0,0,,Дайын, кеттік.
Dialogue: 0,0:03:43.89,0:03:46.72,Default,,0,0,0,,Көшеге шыққанда абай болу керек ең бастысы - көлігіңіз.
Dialogue: 0,0:03:47.51,0:03:50.64,Default,,0,0,0,,Жоғары өнімді AI енді автомобильдерге орнатылды.
Dialogue: 0,0:03:50.73,0:03:52.81,Default,,0,0,0,,Жазатайым оқиғалар айтарлықтай азайды, бірақ
Dialogue: 0,0:03:52.89,0:03:56.86,Default,,0,0,0,,Соған қарамастан жыл сайын 1000-нан астам адам жол-көлік оқиғаларынан қайтыс болады.
Dialogue: 0,0:03:56.94,0:03:59.32,Default,,0,0,0,,Жедел жәрдем шақырыңыз
Dialogue: 0,0:03:59.40,0:04:02.45,Default,,0,0,0,,Дәл қазір ешқандай апат жоқ, сондықтан қоңырау шалмаңыз.
Dialogue: 0,0:04:02.95,0:04:04.57,Default,,0,0,0,,Көз?
Dialogue: 0,0:04:06.07,0:04:07.87,Default,,0,0,0,,Мина кішірейді?
Dialogue: 0,0:04:07.95,0:04:10.29,Default,,0,0,0,,Бұл жолмен жүру оңайырақ.
Dialogue: 0,0:04:11.79,0:04:14.12,Default,,0,0,0,,Жаяу жүргіншілерге арналған жалпы жол қозғалысы ережелері
Dialogue: 0,0:04:14.21,0:04:16.50,Default,,0,0,0,,Оң жақ тротуармен жүру
Dialogue: 0,0:04:16.58,0:04:18.42,Default,,0,0,0,,Сигналдарға бағыну
Dialogue: 0,0:04:18.50,0:04:21.46,Default,,0,0,0,,Үш нәрсе: жаяу жүргіншілер өткелінен өту.
Dialogue: 0,0:04:22.05,0:04:23.63,Default,,0,0,0,,Хокоша?
Dialogue: 0,0:04:23.72,0:04:25.59,Default,,0,0,0,,Жаяу жүрген адам
Dialogue: 0,0:04:25.68,0:04:27.26,Default,,0,0,0,,Осы ережені ұстанғаныңызша
Dialogue: 0,0:04:27.35,0:04:29.89,Default,,0,0,0,,Жол-көлік оқиғаларының ықтималдығы айтарлықтай төмендейді
Dialogue: 0,0:04:31.06,0:04:32.85,Default,,0,0,0,,Орталық жол – жол
Dialogue: 0,0:04:32.93,0:04:35.48,Default,,0,0,0,,Оның жанындағы тар жол тротуар.
Dialogue: 0,0:04:35.56,0:04:37.90,Default,,0,0,0,,Такума-сама да осында серуендеп жүрген.
Dialogue: 0,0:04:37.98,0:04:40.90,Default,,0,0,0,,Сәлем! Мен Минаны жақсы білемін!
Dialogue: 0,0:04:40.98,0:04:44.90,Default,,0,0,0,,Мен бір рет пикникке бардым.
Dialogue: 0,0:04:46.36,0:04:49.91,Default,,0,0,0,,Мамору, қарашы, бұл жаяу жүргіншілер сигналы.
Dialogue: 0,0:04:50.79,0:04:53.91,Default,,0,0,0,,Қазір қызыл шам жанып тұр. Кетпеңіз.
Dialogue: 0,0:04:54.71,0:04:56.87,Default,,0,0,0,,Тек көк бөлік жарқырап тұрғанда
Dialogue: 0,0:04:56.96,0:05:00.46,Default,,0,0,0,,Бұл жаяу жүргіншілер өткеліндегі жол жүру құқығы жаяу жүргіншілерге беріледі.
Dialogue: 0,0:05:01.50,0:05:03.55,Default,,0,0,0,,-(Мина) Күте тұрыңыз -Ия!
Dialogue: 0,0:05:13.77,0:05:15.94,Default,,0,0,0,,- Мина - (Мина) Бұл не?
Dialogue: 0,0:05:16.02,0:05:18.44,Default,,0,0,0,,Бұл қандай түйме?
Dialogue: 0,0:05:26.03,0:05:29.95,Default,,0,0,0,,Осыны басып, күтсеңіз, шам жасыл болып жанады.
Dialogue: 0,0:05:30.03,0:05:32.95,Default,,0,0,0,,Мина... неге баспадың?
Dialogue: 0,0:05:34.62,0:05:35.83,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:38.67,0:05:39.96,Default,,0,0,0,,Енді көк
Dialogue: 0,0:05:40.54,0:05:43.67,Default,,0,0,0,,Көліктерге назар аудара отырып, жаяу жүргіншілер өткелінен өту.
Dialogue: 0,0:05:51.39,0:05:54.47,Default,,0,0,0,,Егер жаяу жүргіншілер өткелінен алда өтсеңіз, супермаркетке жетесіз.
Dialogue: 0,0:05:54.56,0:05:56.23,Default,,0,0,0,,Мина керемет
Dialogue: 0,0:05:58.81,0:06:01.98,Default,,0,0,0,,Жоқ, бұл жаяу жүргіншілер өткелінде ақау бар.
Dialogue: 0,0:06:02.07,0:06:03.48,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:03.57,0:06:05.99,Default,,0,0,0,,-(Мина) Қарашы, Мамору -Ай?
Dialogue: 0,0:06:07.11,0:06:09.24,Default,,0,0,0,,Жаяу жүргіншілер сигналдары жоқ
Dialogue: 0,0:06:09.32,0:06:11.74,Default,,0,0,0,,Қалай өту керек?
Dialogue: 0,0:06:11.82,0:06:14.24,Default,,0,0,0,,(Мысық есінейді)
Dialogue: 0,0:06:16.00,0:06:17.71,Default,,0,0,0,,Бұл ешкімге мүмкін емес
Dialogue: 0,0:06:17.79,0:06:20.42,Default,,0,0,0,,Оған көмектесу мүмкін емес, айналма жолмен жүрейік.
Dialogue: 0,0:06:20.50,0:06:24.00,Default,,0,0,0,,Ai? көлік тоқтады
Dialogue: 0,0:06:25.17,0:06:28.01,Default,,0,0,0,,Бұл адам не істеп жатыр? Неге тоқтады?
Dialogue: 0,0:06:36.22,0:06:38.27,Default,,0,0,0,,Бұл бас бармақ деп аталады.
Dialogue: 0,0:06:38.35,0:06:40.02,Default,,0,0,0,,Бұл басқа адамды мақтау қимылы.
Dialogue: 0,0:06:40.81,0:06:44.02,Default,,0,0,0,,Дүкенге бару Олар бізді мақтады.
Dialogue: 0,0:06:44.11,0:06:46.28,Default,,0,0,0,,Сіз өте мейірімдісіз!
Dialogue: 0,0:06:48.65,0:06:51.03,Default,,0,0,0,,-(Мина) келді -Ятта
Dialogue: 0,0:06:51.11,0:06:52.78,Default,,0,0,0,,Кеттік
Dialogue: 0,0:06:52.87,0:06:54.12,Default,,0,0,0,,Көз
Dialogue: 0,0:06:56.66,0:06:59.91,Default,,0,0,0,,Бұл сіз онлайн тапсырыс берген өнім.
Dialogue: 0,0:07:00.79,0:07:03.79,Default,,0,0,0,,Бұл сөмке қатып қалған.
Dialogue: 0,0:07:05.29,0:07:07.09,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:08.51,0:07:10.30,Default,,0,0,0,,Мен үйге бара жатырмын, Мамору.
Dialogue: 0,0:07:11.26,0:07:12.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:19.31,0:07:21.81,Default,,0,0,0,,Мина, сен неге бармайсың?
Dialogue: 0,0:07:23.73,0:07:25.77,Default,,0,0,0,,Картаға қол жеткізу мүмкін емес
Dialogue: 0,0:07:26.40,0:07:28.32,Default,,0,0,0,,Ура!
Dialogue: 0,0:07:29.15,0:07:31.15,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:07:31.24,0:07:32.70,Default,,0,0,0,,Қайғырма.
Dialogue: 0,0:07:33.41,0:07:36.53,Default,,0,0,0,,Мен әр бұрыштағы көрнекті жерлерді суретке түсірдім.
Dialogue: 0,0:07:36.62,0:07:38.74,Default,,0,0,0,,Кері ретпен өту арқылы кері оралуға болады.
Dialogue: 0,0:07:40.25,0:07:43.04,Default,,0,0,0,,Супермаркеттен шыққанда үлкен тақта тұр.
Dialogue: 0,0:07:43.12,0:07:44.75,Default,,0,0,0,,Сол жаққа бұрылыңыз
Dialogue: 0,0:07:45.42,0:07:46.79,Default,,0,0,0,,Келесі…
Dialogue: 0,0:07:50.13,0:07:54.34,Default,,0,0,0,,Осы жолдың бойымен тура жүріңіз де, қара мысықтың қиылысында солға бұрылыңыз.
Dialogue: 0,0:07:55.30,0:07:56.85,Default,,0,0,0,,Қара мысық?
Dialogue: 0,0:07:58.81,0:08:01.27,Default,,0,0,0,,Қара мысықтар жоқ.
Dialogue: 0,0:08:02.44,0:08:03.73,Default,,0,0,0,,Бұл біртүрлі
Dialogue: 0,0:08:03.81,0:08:06.86,Default,,0,0,0,,Мысықтың қиылысына жетуге кететін уақыт мөлшері
Dialogue: 0,0:08:06.94,0:08:08.86,Default,,0,0,0,,Оның құны үш есе көп.
Dialogue: 0,0:08:10.65,0:08:12.86,Default,,0,0,0,,Мина Мысықтар жүре ме?
Dialogue: 0,0:08:13.65,0:08:15.20,Default,,0,0,0,,Сирек жүреді
Dialogue: 0,0:08:16.20,0:08:17.78,Default,,0,0,0,,Мысық қайда кетті?
Dialogue: 0,0:08:17.87,0:08:20.83,Default,,0,0,0,,Мысық пен қиылыс Ол ажырап қалды!
Dialogue: 0,0:08:21.54,0:08:22.87,Default,,0,0,0,,Бұл мүмкін.
Dialogue: 0,0:08:24.12,0:08:25.29,Default,,0,0,0,,Енді қайтайық
Dialogue: 0,0:08:26.25,0:08:28.67,Default,,0,0,0,,Супермаркеттен спираль бойынша қозғалу
Dialogue: 0,0:08:28.75,0:08:31.38,Default,,0,0,0,,Келесі белгіні іздеу
Dialogue: 0,0:08:31.46,0:08:33.88,Default,,0,0,0,,Келесі белгі?
Dialogue: 0,0:08:33.97,0:08:36.05,Default,,0,0,0,,Бұл үлкен жүк көлігі
Dialogue: 0,0:08:38.39,0:08:39.39,Default,,0,0,0,,Көз?
Dialogue: 0,0:08:47.23,0:08:50.15,Default,,0,0,0,,Мен мүлдем адасып қалдым.
Dialogue: 0,0:08:50.23,0:08:52.57,Default,,0,0,0,,Сауда жасау қиын.
Dialogue: 0,0:08:52.65,0:08:54.90,Default,,0,0,0,,Үйге қалай жетуге болады?
Dialogue: 0,0:08:55.57,0:08:57.24,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:08:57.32,0:09:01.87,Default,,0,0,0,,Мен Такума-санмен немесе Сайонжи Мина-санмен сөйлесе алмаймын.
Dialogue: 0,0:09:01.95,0:09:03.41,Default,,0,0,0,,Барлық опциялар аяқталды
Dialogue: 0,0:09:04.66,0:09:08.63,Default,,0,0,0,,Мен осы саябақта мәңгі тұруым мүмкін.
Dialogue: 0,0:09:08.71,0:09:10.42,Default,,0,0,0,,көремін.
Dialogue: 0,0:09:11.46,0:09:14.22,Default,,0,0,0,,Менде күн энергиясының функциясы бар
Dialogue: 0,0:09:14.30,0:09:16.43,Default,,0,0,0,,Сіз мәңгі белсенді бола аласыз
Dialogue: 0,0:09:17.30,0:09:21.60,Default,,0,0,0,,Дегенмен, Маморудың батареясы 40 сағат ішінде таусылды.
Dialogue: 0,0:09:21.68,0:09:24.14,Default,,0,0,0,,Сіз мәңгі ұйықтайсыз
Dialogue: 0,0:09:25.60,0:09:28.31,Default,,0,0,0,,Кешіріңіз Мамору
Dialogue: 0,0:09:28.40,0:09:31.19,Default,,0,0,0,,Мамору Мен ұйықтағанды ұнатамын, ол үшін уайымдама
Dialogue: 0,0:09:31.27,0:09:34.24,Default,,0,0,0,,Көңіліңді көтер, Мина
Dialogue: 0,0:09:34.32,0:09:36.32,Default,,0,0,0,,Мен әрқашан жақсымын
Dialogue: 0,0:09:36.40,0:09:37.82,Default,,0,0,0,,Өйткені бұл робот
Dialogue: 0,0:09:37.91,0:09:40.83,Default,,0,0,0,,Мина: Даусыңыз бәсеңдеп қалды ма?
Dialogue: 0,0:09:41.66,0:09:44.62,Default,,0,0,0,,Мен бірінші жұмыс істей алмайтын жағдайда
Dialogue: 0,0:09:44.70,0:09:46.96,Default,,0,0,0,,Мен өз білгенімді айтайын
Dialogue: 0,0:09:47.92,0:09:49.83,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:09:50.96,0:09:53.71,Default,,0,0,0,,Сіздің иесі - Такума Косуги
Dialogue: 0,0:09:53.80,0:09:56.72,Default,,0,0,0,,Бізді отбасы ретінде ойлаудан басқа.
Dialogue: 0,0:09:56.80,0:09:58.84,Default,,0,0,0,,Мен кәдімгі ересек ер адаммын.
Dialogue: 0,0:09:58.93,0:10:03.01,Default,,0,0,0,,Асахи қаласы, Асахи-чо, 4-12-3 мекенжайында орналасқан
Dialogue: 0,0:10:03.10,0:10:05.68,Default,,0,0,0,,Мен Luminous Asahi деп аталатын пәтерде тұрамын.
Dialogue: 0,0:10:05.77,0:10:07.35,Default,,0,0,0,,Көз
Dialogue: 0,0:10:07.94,0:10:09.19,Default,,0,0,0,,Ұялы телефон нөмірі...
Dialogue: 0,0:10:09.27,0:10:11.94,Default,,0,0,0,,4 12 3… Бұл сәл басқаша.
Dialogue: 0,0:10:12.02,0:10:14.86,Default,,0,0,0,,- (Мина) Мамору? -Мина солай!
Dialogue: 0,0:10:14.94,0:10:17.36,Default,,0,0,0,,Бірдей таңбалар жазылған
Dialogue: 0,0:10:17.45,0:10:19.36,Default,,0,0,0,,Тек сандар әртүрлі!
Dialogue: 0,0:10:22.83,0:10:25.87,Default,,0,0,0,,Бұл... мекен-жай шығар.
Dialogue: 0,0:10:25.95,0:10:29.21,Default,,0,0,0,,Біздің мақсатымыз - Жарқын Асахи 4-chome
Dialogue: 0,0:10:29.29,0:10:30.88,Default,,0,0,0,,Бұл 2 таңдаулы.
Dialogue: 0,0:10:32.00,0:10:34.25,Default,,0,0,0,,Мамору 4-ші көшені іздейік.
Dialogue: 0,0:10:34.34,0:10:35.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:35.96,0:10:38.92,Default,,0,0,0,,Жоқ, бұл 1-компьютер.
Dialogue: 0,0:10:39.01,0:10:40.89,Default,,0,0,0,,Арғы бетке барайық
Dialogue: 0,0:10:40.97,0:10:42.89,Default,,0,0,0,,Мамору 3-чоме
Dialogue: 0,0:10:42.97,0:10:45.39,Default,,0,0,0,,Аха!
Dialogue: 0,0:11:05.99,0:11:08.79,Default,,0,0,0,,Жарқыраған Асахиге келді
Dialogue: 0,0:11:08.87,0:11:10.37,Default,,0,0,0,,Yatter
Dialogue: 0,0:11:12.21,0:11:13.42,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:11:13.50,0:11:15.42,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:11:15.50,0:11:17.21,Default,,0,0,0,,Кешкі ас ішуді қалайсыз ба?
Dialogue: 0,0:11:17.30,0:11:18.55,Default,,0,0,0,,Иә
Dialogue: 0,0:11:19.17,0:11:21.76,Default,,0,0,0,,Бүгін түстен кейін үлкен байланыс ақауы орын алды.
Dialogue: 0,0:11:21.84,0:11:23.05,Default,,0,0,0,,Орындалды
Dialogue: 0,0:11:23.14,0:11:25.89,Default,,0,0,0,,Бұл өте қиын болды.
Dialogue: 0,0:11:25.97,0:11:28.06,Default,,0,0,0,,Мен жұмыста интернетті пайдалана алмаймын.
Dialogue: 0,0:11:28.14,0:11:29.89,Default,,0,0,0,,Енді ол қалпына келтірілді
Dialogue: 0,0:11:29.98,0:11:32.19,Default,,0,0,0,,Кейбір аймақтарда қосылу қиын.
Dialogue: 0,0:11:32.27,0:11:34.73,Default,,0,0,0,,Біз себебін мүмкіндігінше тезірек зерттеуді жоспарлап отырмыз.
Dialogue: 0,0:11:34.81,0:11:36.65,Default,,0,0,0,,Хабарланды
Dialogue: 0,0:11:38.98,0:11:43.07,Default,,0,0,0,,Ингредиенттер біржақты болған сияқты...
Dialogue: 0,0:11:43.74,0:11:45.07,Default,,0,0,0,,Тағы да көп
Dialogue: 0,0:11:45.16,0:11:48.62,Default,,0,0,0,,Мен мұздатылған теңіз өнімдері мен брокколиді тұтынғым келді.
Dialogue: 0,0:11:48.70,0:11:51.12,Default,,0,0,0,,Мен аздап көп жасадым.
Dialogue: 0,0:11:51.21,0:11:52.21,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:52.29,0:11:55.04,Default,,0,0,0,,Мұздатылған теңіз өнімдері мен брокколи
Dialogue: 0,0:11:55.13,0:11:57.34,Default,,0,0,0,,Өйткені мен тұтынғым келді
Dialogue: 0,0:11:57.42,0:12:00.84,Default,,0,0,0,,Мм... Итадакимасу
Dialogue: 0,0:12:03.47,0:12:05.85,Default,,0,0,0,,Такума Бұл дәмді ме?
Dialogue: 0,0:12:05.93,0:12:07.51,Default,,0,0,0,,Жолсыз жерлерге арналған көлік қолайлырақ болар еді, білесің бе?
Dialogue: 0,0:12:07.60,0:12:08.93,Default,,0,0,0,,Йокатане
Dialogue: 0,0:12:09.01,0:12:12.60,Default,,0,0,0,,Мамору-кун да бір күні жеп қалар деп үміттенемін.
Dialogue: 0,0:12:12.69,0:12:14.35,Default,,0,0,0,,Ай
Dialogue: 0,0:12:14.94,0:12:18.90,Default,,0,0,0,,Маморуға әзірше қымбат тамақтану функциясы қажет емес.
Dialogue: 0,0:12:20.40,0:12:23.40,Default,,0,0,0,,Мина-чан солай ойлауы мүмкін, бірақ
Dialogue: 0,0:12:23.49,0:12:25.61,Default,,0,0,0,,Мен оны кигім келеді.
Dialogue: 0,0:12:25.70,0:12:28.16,Default,,0,0,0,,Әсер емес, объективті бағалау
Dialogue: 0,0:12:28.24,0:12:30.37,Default,,0,0,0,,Біз оның қажет еместігін анықтадық.
Dialogue: 0,0:12:31.16,0:12:33.37,Default,,0,0,0,,Тіпті қазіргі уақытта қол жетімді функциялар
Dialogue: 0,0:12:33.46,0:12:36.38,Default,,0,0,0,,Өйткені Мамору керемет жұмыс істейді.
Dialogue: 0,0:12:36.46,0:12:38.71,Default,,0,0,0,,Бірақ Мамору-кун...
Dialogue: 0,0:12:39.38,0:12:40.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:41.42,0:12:42.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:55.60,0:12:58.61,Default,,0,0,0,,Мина-чан мен шомыламын.
Dialogue: 0,0:12:58.69,0:13:01.23,Default,,0,0,0,,Жарайды, мен бірден кетемін.
Dialogue: 0,0:13:01.32,0:13:03.53,Default,,0,0,0,,Әй, екеуің қайда барасыңдар?
Dialogue: 0,0:13:04.28,0:13:05.53,Default,,0,0,0,,Ванна
Dialogue: 0,0:13:05.61,0:13:09.53,Default,,0,0,0,,Адам денсаулығы мен гигиенасы үшін ыстық суға шомылады.
Dialogue: 0,0:13:15.92,0:13:17.54,Default,,0,0,0,,Неліктен кішірек?
Dialogue: 0,0:13:17.63,0:13:20.54,Default,,0,0,0,,Су өткізбейтін функцияны жақсарту үшін
Dialogue: 0,0:13:21.80,0:13:23.17,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:13:24.63,0:13:26.55,Default,,0,0,0,,Көз?
Dialogue: 0,0:13:27.55,0:13:29.01,Default,,0,0,0,,Мамору-кун?
Dialogue: 0,0:13:29.09,0:13:32.39,Default,,0,0,0,,Уф! Мина Мамору да ыстық суды қалайды!
Dialogue: 0,0:13:32.47,0:13:36.06,Default,,0,0,0,,Жоқ, Mamoru су өткізбейтін жоғары өнімділікке ие емес.
Dialogue: 0,0:13:36.69,0:13:38.56,Default,,0,0,0,,Су өткізбейтін өнімділік жоғары болмаса
Dialogue: 0,0:13:38.65,0:13:41.07,Default,,0,0,0,,Роботтар ваннаға түспеуі керек
Dialogue: 0,0:13:41.86,0:13:45.07,Default,,0,0,0,,Біртіндеп жүктеме түседі және ол үзіледі.
Dialogue: 0,0:13:45.15,0:13:48.16,Default,,0,0,0,,Менде су өткізбейтін қорғаныс дәрежесі 8.
Dialogue: 0,0:13:48.24,0:13:50.07,Default,,0,0,0,,Сіз кіре аласыз.
Dialogue: 0,0:13:50.16,0:13:53.49,Default,,0,0,0,,Ал ыстық су десек, 42 градус.
Dialogue: 0,0:13:53.58,0:13:56.08,Default,,0,0,0,,-Уау~ -Аа...
Dialogue: 0,0:13:56.16,0:13:58.33,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:13:59.46,0:14:00.58,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:04.59,0:14:08.97,Default,,0,0,0,,Такума: Минамен кіргенде... окситоцин аласыз ба?
Dialogue: 0,0:14:09.05,0:14:12.35,Default,,0,0,0,,Иә, бұл жалғыз кіруден мүлдем басқа.
Dialogue: 0,0:14:12.43,0:14:14.47,Default,,0,0,0,,Йокаттан
Dialogue: 0,0:14:16.43,0:14:19.85,Default,,0,0,0,,Такума-сама, денең суып кетпей тұрып ұйықтайық.
Dialogue: 0,0:14:19.94,0:14:21.36,Default,,0,0,0,,Иә
Dialogue: 0,0:14:21.44,0:14:23.07,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:14:23.15,0:14:24.57,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:14:31.41,0:14:33.49,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:14:34.24,0:14:36.75,Default,,0,0,0,,Ах~ Қайырлы таң Мина Чан
Dialogue: 0,0:14:36.83,0:14:38.54,Default,,0,0,0,,Бүгін таңғы асқа не бар?
Dialogue: 0,0:14:38.62,0:14:40.50,Default,,0,0,0,,-(Мина) Бип - А?
Dialogue: 0,0:14:40.58,0:14:43.00,Default,,0,0,0,,-(Мина) Бибі Бибі - А? сурет?
Dialogue: 0,0:14:43.09,0:14:44.00,Default,,0,0,0,,Көз?
Dialogue: 0,0:14:44.09,0:14:46.84,Default,,0,0,0,,-(Мина) Б-Б-Б-Б-Бірдеңе сөйлеп тұр ма?
Dialogue: 0,0:14:46.92,0:14:48.09,Default,,0,0,0,,Бибби сигналы
Dialogue: 0,0:14:48.17,0:14:50.01,Default,,0,0,0,,Кешіріңіз, мен түсінбеймін.
Dialogue: 0,0:14:50.09,0:14:53.01,Default,,0,0,0,,Биби Биби Бибибиби…
Dialogue: 0,0:14:53.10,0:14:56.02,Default,,0,0,0,,Білмеймін Білмеймін Білмеймін!
Dialogue: 0,0:14:53.10,0:14:56.02,Default,,0,0,0,,Бибибибибиби…
Dialogue: 0,0:14:56.10,0:14:58.02,Default,,0,0,0,,Морзе коды?
Dialogue: 0,0:15:04.52,0:15:05.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:08.11,0:15:09.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:10.03,0:15:11.03,Default,,0,0,0,,А…?
Dialogue: 0,0:15:17.87,0:15:19.87,Default,,0,0,0,,Ол бұзылды.
Dialogue: 0,0:15:20.37,0:15:23.83,Default,,0,0,0,,Мүмкін мен Мина Сайонджимен күрескен кезде шығармын?
Dialogue: 0,0:15:25.13,0:15:28.38,Default,,0,0,0,,Спикерлерден басқасының бәрі дұрыс па?
Dialogue: 0,0:15:31.84,0:15:33.05,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:15:33.72,0:15:36.18,Default,,0,0,0,,Спикерлерден басқасының бәрі дұрыс па?
Dialogue: 0,0:15:36.26,0:15:37.56,Default,,0,0,0,,А…?
Dialogue: 0,0:15:37.64,0:15:39.31,Default,,0,0,0,,«Мәселе жоқ»
Dialogue: 0,0:15:39.39,0:15:42.56,Default,,0,0,0,,«Суға түсуді жалғастыр»
Dialogue: 0,0:15:42.65,0:15:45.06,Default,,0,0,0,,Жоқ, тоқтайық.
Dialogue: 0,0:15:47.65,0:15:51.65,Default,,0,0,0,,Тек дыбыстық сигналдарды пайдаланып белгілі бір дәрежеде сөйлесе алу.
Dialogue: 0,0:15:52.70,0:15:55.74,Default,,0,0,0,,Бір ұзақ дыбыспен растау немесе растау айтылады
Dialogue: 0,0:15:55.82,0:15:57.58,Default,,0,0,0,,- (Мина) Дыбыстық сигнал - Иә.
Dialogue: 0,0:15:57.66,0:15:59.50,Default,,0,0,0,,Мамору-кун түсінді ме?
Dialogue: 0,0:15:59.58,0:16:00.58,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:16:00.66,0:16:03.58,Default,,0,0,0,,Мамору-кун, сіз қалыпты сөйлесе аласыз.
Dialogue: 0,0:16:03.67,0:16:05.58,Default,,0,0,0,,Мамору да Биді ойнағысы келеді
Dialogue: 0,0:16:05.67,0:16:09.09,Default,,0,0,0,,Хмм... Егер солай болса, мен оны жақсы түсіне алмаймын.
Dialogue: 0,0:16:09.80,0:16:12.38,Default,,0,0,0,,Оны жоққа шығарғың келсе, екі қысқа дыбыспен айт.
Dialogue: 0,0:16:12.47,0:16:13.47,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:16:13.55,0:16:17.55,Default,,0,0,0,,Маған қоңырау шалғанда, үш рет «та-ку-ма» деп айт.
Dialogue: 0,0:16:17.64,0:16:19.10,Default,,0,0,0,,Бип-бип-бип
Dialogue: 0,0:16:19.18,0:16:20.85,Default,,0,0,0,,Төтенше жағдайда
Dialogue: 0,0:16:20.93,0:16:23.69,Default,,0,0,0,,Сіз қысқа тондар қатарын ойнай аласыз ба?
Dialogue: 0,0:16:23.77,0:16:25.69,Default,,0,0,0,,Бибибибибибибиби…
Dialogue: 0,0:16:25.77,0:16:26.94,Default,,0,0,0,,Және ұста!
Dialogue: 0,0:16:27.02,0:16:29.19,Default,,0,0,0,,Бибибибибибибиби…
Dialogue: 0,0:16:29.27,0:16:33.11,Default,,0,0,0,,Иә, мен ұмытамын деп ойлаймын, әзірше осымен.
Dialogue: 0,0:16:33.20,0:16:34.45,Default,,0,0,0,,Жақсы
Dialogue: 0,0:16:34.53,0:16:37.70,Default,,0,0,0,,Қолдау орталығына хабарласуым керек пе?
Dialogue: 0,0:16:37.78,0:16:39.12,Default,,0,0,0,,А…?
Dialogue: 0,0:16:45.62,0:16:46.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:49.46,0:16:51.46,Default,,0,0,0,,Онда мен жұмысқа барамын.
Dialogue: 0,0:16:51.55,0:16:53.30,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған хабарлаңыз.
Dialogue: 0,0:16:53.38,0:16:55.68,Default,,0,0,0,,- (Мина) дыбыстық сигнал - дыбыстық сигнал
Dialogue: 0,0:16:55.76,0:16:57.01,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:16:57.09,0:16:58.43,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:17:02.98,0:17:05.48,Default,,0,0,0,,Мина, сенің де бүгін оқығың келе ме?
Dialogue: 0,0:17:05.56,0:17:07.90,Default,,0,0,0,,- (Мина) Дыбыс - Сен не істейсің?
Dialogue: 0,0:17:10.40,0:17:11.40,Default,,0,0,0,,Не істеу керек!?
Dialogue: 0,0:17:15.86,0:17:17.78,Default,,0,0,0,,Онда не айтылған?
Dialogue: 0,0:17:22.58,0:17:24.54,Default,,0,0,0,,Онда не айтылған?
Dialogue: 0,0:17:24.62,0:17:25.54,Default,,0,0,0,,Әй!?
Dialogue: 0,0:17:27.12,0:17:29.63,Default,,0,0,0,,Не... деп жазылған?
Dialogue: 0,0:17:30.13,0:17:31.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:31.63,0:17:33.05,Default,,0,0,0,,Көз?
Dialogue: 0,0:17:33.13,0:17:35.47,Default,,0,0,0,,А…аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:17:35.55,0:17:38.39,Default,,0,0,0,,Ай... Әй?
Dialogue: 0,0:17:38.89,0:17:41.05,Default,,0,0,0,,Қорғау деп жазылған ба?
Dialogue: 0,0:17:41.14,0:17:42.31,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:17:42.39,0:17:44.68,Default,,0,0,0,,A~A~ Мені мақтады!
Dialogue: 0,0:17:44.77,0:17:46.06,Default,,0,0,0,,Ааааа…
Dialogue: 0,0:17:47.31,0:17:48.52,Default,,0,0,0,,Онда не айтылған?
Dialogue: 0,0:17:48.60,0:17:49.56,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:17:50.31,0:17:53.07,Default,,0,0,0,,Ах~
Dialogue: 0,0:17:53.65,0:17:55.57,Default,,0,0,0,,Онда мина деп жазылған ба?
Dialogue: 0,0:17:57.11,0:17:59.07,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:17:59.16,0:18:00.87,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:00.95,0:18:02.58,Default,,0,0,0,,Ааааа...
Dialogue: 0,0:18:06.46,0:18:08.58,Default,,0,0,0,,-Енот ит? -(Мина) Ашық
Dialogue: 0,0:18:11.17,0:18:12.88,Default,,0,0,0,,-Жылан? -(Мина) Жанды!
Dialogue: 0,0:18:13.38,0:18:14.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:14.96,0:18:15.96,Default,,0,0,0,,Теледидар
Dialogue: 0,0:18:16.59,0:18:18.97,Default,,0,0,0,,Хоучу... Жоқ...
Dialogue: 0,0:18:19.55,0:18:22.85,Default,,0,0,0,,Рейзуко… Денширенджи!
Dialogue: 0,0:18:24.85,0:18:25.85,Default,,0,0,0,,Футон!
Dialogue: 0,0:18:25.93,0:18:29.35,Default,,0,0,0,,- (Мина) Дыбыстық сигнал - Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:29.44,0:18:31.52,Default,,0,0,0,,-Хабураши-(Мина) Ара
Dialogue: 0,0:18:31.61,0:18:34.07,Default,,0,0,0,,Юфуку... А, Сета?
Dialogue: 0,0:18:34.15,0:18:35.36,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,0:18:38.78,0:18:40.36,Default,,0,0,0,,Хирагана...
Dialogue: 0,0:18:40.45,0:18:42.37,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:18:44.70,0:18:47.29,Default,,0,0,0,,Қалған әріпті сөздерді таба алмайсыз ба?
Dialogue: 0,0:18:47.37,0:18:48.37,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:18:48.46,0:18:50.79,Default,,0,0,0,,Қалғаны…
Dialogue: 0,0:18:50.87,0:18:53.21,Default,,0,0,0,,«Жоқ»!? «Жоқ» деген не?
Dialogue: 0,0:18:55.71,0:18:57.17,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:18:57.26,0:18:59.13,Default,,0,0,0,,-Бұл «оның»? -(Мина) Дабыл
Dialogue: 0,0:18:59.22,0:19:01.09,Default,,0,0,0,,Сонда «ну» ше?
Dialogue: 0,0:19:01.18,0:19:02.26,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:19:02.34,0:19:03.76,Default,,0,0,0,,- «му» дегеніміз не? -(Мина) Пи
Dialogue: 0,0:19:03.85,0:19:05.14,Default,,0,0,0,,- «Я» ше? -(Мина) Пи
Dialogue: 0,0:19:05.22,0:19:07.18,Default,,0,0,0,,Осы ғана қалды!
Dialogue: 0,0:19:07.27,0:19:09.14,Default,,0,0,0,,Мұны қалай оқисыз?
Dialogue: 0,0:19:12.23,0:19:16.15,Default,,0,0,0,,Көз? Неліктен кейбір әріптердің дыбысы бірдей?
Dialogue: 0,0:19:16.23,0:19:17.32,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:19:19.57,0:19:21.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:21.91,0:19:22.95,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:19:23.49,0:19:24.91,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:19:26.66,0:19:28.41,Default,,0,0,0,,Бұл Катакана
Dialogue: 0,0:19:28.50,0:19:30.41,Default,,0,0,0,,Я~
Dialogue: 0,0:19:31.33,0:19:34.00,Default,,0,0,0,,Неліктен Хирагана мен Катакана бар?
Dialogue: 0,0:19:34.50,0:19:36.67,Default,,0,0,0,,- (Мина) Пи - Хое?
Dialogue: 0,0:19:38.01,0:19:40.26,Default,,0,0,0,,Ай!
Dialogue: 0,0:19:41.88,0:19:45.43,Default,,0,0,0,,Бұл «o» және бұл «wo» Неліктен?
Dialogue: 0,0:19:48.72,0:19:49.93,Default,,0,0,0,,Ву~
Dialogue: 0,0:19:51.06,0:19:52.27,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:19:55.19,0:19:56.69,Default,,0,0,0,,Ой!
Dialogue: 0,0:19:57.65,0:20:01.07,Default,,0,0,0,,Мен қателесіп екі жасадым.
Dialogue: 0,0:20:03.61,0:20:05.20,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:20:05.28,0:20:07.70,Default,,0,0,0,,Шығар, шығар!
Dialogue: 0,0:20:07.78,0:20:09.20,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:09.29,0:20:10.70,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:20:10.79,0:20:12.21,Default,,0,0,0,,Пя!
Dialogue: 0,0:20:13.50,0:20:15.96,Default,,0,0,0,,Су... қарбыз?
Dialogue: 0,0:20:16.04,0:20:17.21,Default,,0,0,0,,Аю!
Dialogue: 0,0:20:17.29,0:20:18.75,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,0:20:18.84,0:20:21.30,Default,,0,0,0,,Ихихи иә!
Dialogue: 0,0:20:21.38,0:20:23.22,Default,,0,0,0,,Ия иә~ Аххх
Dialogue: 0,0:20:24.30,0:20:25.72,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:20:25.80,0:20:27.85,Default,,0,0,0,,Байо~Поп~
Dialogue: 0,0:20:27.93,0:20:30.02,Default,,0,0,0,,Не? Не... не?!
Dialogue: 0,0:20:30.10,0:20:31.48,Default,,0,0,0,,«Қош келдіңіз»
Dialogue: 0,0:20:31.56,0:20:34.60,Default,,0,0,0,,«Бүгін мен гамбургер жеп жатырмын», - дедім мен.
Dialogue: 0,0:20:34.69,0:20:36.02,Default,,0,0,0,,Осы қысқа уақыт ішінде?
Dialogue: 0,0:20:36.10,0:20:37.48,Default,,0,0,0,,Мен~Хихе...
Dialogue: 0,0:20:37.56,0:20:41.49,Default,,0,0,0,,«Мен динамиктерден әртүрлі дыбыстар шыққанын білдім».
Dialogue: 0,0:20:41.57,0:20:44.70,Default,,0,0,0,,«Мен Маморумен кеңесіп, сөздерді жасадым».
Dialogue: 0,0:20:44.78,0:20:45.86,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:20:45.95,0:20:47.24,Default,,0,0,0,,Айқай~
Dialogue: 0,0:20:47.32,0:20:49.12,Default,,0,0,0,,Рим Папасы побон?
Dialogue: 0,0:20:49.20,0:20:51.25,Default,,0,0,0,,«Оны қазір жегің келе ме?»
Dialogue: 0,0:20:51.33,0:20:53.25,Default,,0,0,0,,-Аа... жеп ал -Бибибі
Dialogue: 0,0:20:53.33,0:20:54.87,Default,,0,0,0,,Byobyopupyyo
Dialogue: 0,0:20:54.96,0:20:56.75,Default,,0,0,0,,Powwoo дыбыстық сигналы
Dialogue: 0,0:20:56.83,0:20:58.92,Default,,0,0,0,,- (Мина) Пау - Ихи
Dialogue: 0,0:20:59.00,0:21:00.75,Default,,0,0,0,,Сәлем! Сәл ғана...
Dialogue: 0,0:21:00.84,0:21:02.17,Default,,0,0,0,,Пюбубубу
Dialogue: 0,0:21:02.26,0:21:03.26,Default,,0,0,0,,Артында...
Dialogue: 0,0:21:08.35,0:21:10.97,Default,,0,0,0,,Бибиппуп пиопупепепо
Dialogue: 0,0:21:11.06,0:21:12.81,Default,,0,0,0,,Попепаио
Dialogue: 0,0:21:12.89,0:21:14.77,Default,,0,0,0,,Иә, бүгін де дәмді.
Dialogue: 0,0:21:14.85,0:21:16.31,Default,,0,0,0,,- (Мина) Попё - А?
Dialogue: 0,0:21:16.40,0:21:18.65,Default,,0,0,0,,Парапеньо Такума Пайропу
Dialogue: 0,0:21:18.73,0:21:20.48,Default,,0,0,0,,- Не? - Пибиопу
Dialogue: 0,0:21:20.57,0:21:22.57,Default,,0,0,0,,А... Йокатане
Dialogue: 0,0:21:22.65,0:21:24.74,Default,,0,0,0,,Иә... Иә...
Dialogue: 0,0:21:26.99,0:21:28.57,Default,,0,0,0,,Мен өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:21:31.37,0:21:34.20,Default,,0,0,0,,Папио Пипипио Попипипипав
Dialogue: 0,0:21:34.29,0:21:35.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:35.37,0:21:37.92,Default,,0,0,0,,...
Dialogue: 0,0:21:39.96,0:21:41.29,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:21:41.38,0:21:43.80,Default,,0,0,0,,Дыбыс… Пипуп
Dialogue: 0,0:21:43.88,0:21:46.80,Default,,0,0,0,,Пипуп Қайырлы таң.
Dialogue: 0,0:21:46.88,0:21:48.39,Default,,0,0,0,,Көкнәр сорғы
Dialogue: 0,0:21:48.47,0:21:49.93,Default,,0,0,0,,Күшік
Dialogue: 0,0:21:50.01,0:21:53.31,Default,,0,0,0,,Бүгінгі канжи жаттығуы қиын болады.
Dialogue: 0,0:21:54.31,0:21:55.81,Default,,0,0,0,,Ұзақ уақыт тыңдағанда
Dialogue: 0,0:21:55.89,0:21:58.81,Default,,0,0,0,,Мен оны қалай да түсінемін.
Dialogue: 0,0:21:58.90,0:22:00.73,Default,,0,0,0,,Попепапе
Dialogue: 0,0:22:00.81,0:22:01.94,Default,,0,0,0,,Бибипупу
Dialogue: 0,0:22:02.02,0:22:03.40,Default,,0,0,0,,Күшік дыбысы?
Dialogue: 0,0:22:03.48,0:22:04.53,Default,,0,0,0,,Папило Пепопо?
Dialogue: 0,0:22:04.61,0:22:06.11,Default,,0,0,0,,Паапэ Пипю
Dialogue: 0,0:22:06.82,0:22:11.83,Default,,0,0,0,,♪～
Dialogue: 0,0:23:29.32,0:23:35.33,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.37,0:23:38.45,Default,,0,0,0,,Келесі жолы…
Dialogue: 0,0:23:38.54,0:23:40.12,Default,,0,0,0,,-(Мина) Менің... -Әйелім!
