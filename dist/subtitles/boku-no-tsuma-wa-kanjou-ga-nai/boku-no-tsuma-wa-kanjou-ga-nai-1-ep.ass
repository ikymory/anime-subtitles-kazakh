Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.16,0:00:04.54,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:09.88,0:00:13.55,Default,,0,0,0,,(Дыбыс фокусы)
Dialogue: 0,0:00:27.65,0:00:28.98,Default,,0,0,0,,Сіз әлі үйге бармайсыз ба?
Dialogue: 0,0:00:29.07,0:00:32.07,Default,,0,0,0,,А, осы деректерді енгізуді аяқтаймыз.
Dialogue: 0,0:00:32.15,0:00:34.90,Default,,0,0,0,,Түсіндім... сосын алға.
Dialogue: 0,0:00:34.99,0:00:36.41,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:00:43.16,0:00:46.33,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:00:49.42,0:00:52.46,Default,,0,0,0,,Жарайды... Аа~
Dialogue: 0,0:00:55.01,0:00:57.09,Default,,0,0,0,,Осыншама ұзақ па?
Dialogue: 0,0:00:58.14,0:00:59.10,Default,,0,0,0,,(соңғы дыбыс)
Dialogue: 0,0:01:06.60,0:01:08.23,Default,,0,0,0,,Уау... ау
Dialogue: 0,0:01:08.81,0:01:11.86,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:01:11.94,0:01:13.82,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:01:15.61,0:01:18.24,Default,,0,0,0,,Жалғыз өмір сүре бастағаныма үш жыл
Dialogue: 0,0:01:18.32,0:01:20.58,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:01:26.37,0:01:28.67,Default,,0,0,0,,Күнделікті жұмыс қарбалас...
Dialogue: 0,0:01:32.30,0:01:34.21,Default,,0,0,0,,Мияу?
Dialogue: 0,0:01:43.81,0:01:46.64,Default,,0,0,0,,Менің үй шаруасымен айналысуға уақытым жоқ...
Dialogue: 0,0:01:47.69,0:01:50.11,Default,,0,0,0,,(Пісіру дыбысы)
Dialogue: 0,0:01:52.44,0:01:54.69,Default,,0,0,0,,(Есікті қағады)
Dialogue: 0,0:01:54.78,0:01:56.19,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:02:00.49,0:02:01.78,Default,,0,0,0,,Тұрмыстық техниканы сатып алды
Dialogue: 0,0:02:07.46,0:02:10.21,Default,,0,0,0,,Қош келдіңіз, Такума-сама
Dialogue: 0,0:02:10.75,0:02:13.67,Default,,0,0,0,,(Дыбыс фокусы)
Dialogue: 0,0:02:14.46,0:02:16.09,Default,,0,0,0,,Үй жұмысына арналған робот
Dialogue: 0,0:02:19.01,0:02:22.01,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:02:24.01,0:02:29.69,Default,,0,0,0,,♪～
Dialogue: 0,0:03:47.56,0:03:52.56,Default,,0,0,0,,～♪
Dialogue: 0,0:03:57.19,0:03:58.19,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:03:58.27,0:04:02.20,Default,,0,0,0,,Үй жұмысының роботы деп аталса да, арзан екінші қол өнім.
Dialogue: 0,0:04:02.28,0:04:06.20,Default,,0,0,0,,Бұл тағам дайындауға және ыдыс жууға ғана рұқсат беретін шектеулі нұсқа.
Dialogue: 0,0:04:07.45,0:04:10.08,Default,,0,0,0,,Тағамды тоңазытқышта сақтасаңыз
Dialogue: 0,0:04:10.16,0:04:12.83,Default,,0,0,0,,Тіркелген рецепттерден кездейсоқ таңдалған тағамдар
Dialogue: 0,0:04:12.91,0:04:15.08,Default,,0,0,0,,Ол көрсетілген уақытта дайындалады.
Dialogue: 0,0:04:16.21,0:04:17.96,Default,,0,0,0,,Бірақ солай.
Dialogue: 0,0:04:18.04,0:04:22.84,Default,,0,0,0,,Бұл тұрмыстық техника болса да, сізге тамақ дайындайтын адам бар.
Dialogue: 0,0:04:22.92,0:04:24.47,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:25.18,0:04:28.68,Default,,0,0,0,,Әйелім болса осылай болар ма екен деп ойлаймын.
Dialogue: 0,0:04:28.76,0:04:32.02,Default,,0,0,0,,Керемет... Мен сенімен сырласқым келеді.
Dialogue: 0,0:04:34.27,0:04:35.94,Default,,0,0,0,,- Мина-чан - (Мина) Иә.
Dialogue: 0,0:04:36.02,0:04:37.73,Default,,0,0,0,,Бүгін кешкі асқа не бар?
Dialogue: 0,0:04:39.36,0:04:40.73,Default,,0,0,0,,Омлет күріш
Dialogue: 0,0:04:41.32,0:04:42.69,Default,,0,0,0,,Омлет күріш…
Dialogue: 0,0:04:42.78,0:04:45.15,Default,,0,0,0,,Бұл Такума-саманың сүйікті тағамы.
Dialogue: 0,0:04:45.24,0:04:47.62,Default,,0,0,0,,О, әрине...
Dialogue: 0,0:04:47.70,0:04:50.12,Default,,0,0,0,,Сіз де осындай ақпаратты есіңізде сақтайсыз.
Dialogue: 0,0:04:58.21,0:04:59.38,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:04:59.46,0:05:03.38,Default,,0,0,0,,Бірақ... менің сүйіктім Мина Чан.
Dialogue: 0,0:05:03.46,0:05:06.13,Default,,0,0,0,,Менің әйелім боласың ба?
Dialogue: 0,0:05:07.89,0:05:09.39,Default,,0,0,0,,Ха! Аа!?
Dialogue: 0,0:05:15.14,0:05:16.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:20.40,0:05:23.44,Default,,0,0,0,,О... не... не?
Dialogue: 0,0:05:23.53,0:05:25.40,Default,,0,0,0,,Ахахха... Ахахха...
Dialogue: 0,0:05:25.49,0:05:28.74,Default,,0,0,0,,Маған тағамдар дайындап бере аласыз ба?
Dialogue: 0,0:05:28.82,0:05:30.16,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:05:30.24,0:05:31.41,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:31.49,0:05:33.16,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:05:33.24,0:05:36.58,Default,,0,0,0,,Бұл ақылды күріш пешімен сөйлескендей.
Dialogue: 0,0:05:40.08,0:05:41.46,Default,,0,0,0,,Ақымаққа ұқсайды
Dialogue: 0,0:05:45.21,0:05:46.22,Default,,0,0,0,,Такума-сама
Dialogue: 0,0:05:46.84,0:05:47.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:48.01,0:05:49.64,Default,,0,0,0,,Омлет күріш дайын
Dialogue: 0,0:05:49.72,0:05:50.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:52.35,0:05:53.72,Default,,0,0,0,,Е...
Dialogue: 0,0:05:53.81,0:05:55.73,Default,,0,0,0,,Аа, иә, иә...
Dialogue: 0,0:06:16.66,0:06:17.75,Default,,0,0,0,,Ха… ха ха…
Dialogue: 0,0:06:18.37,0:06:20.79,Default,,0,0,0,,Хаха... хахаха...
Dialogue: 0,0:06:28.63,0:06:30.64,Default,,0,0,0,,Нұсқауларды қанша оқысаңыз да
Dialogue: 0,0:06:30.72,0:06:33.14,Default,,0,0,0,,Бұл мүмкіндік тізімде жоқ.
Dialogue: 0,0:06:35.97,0:06:39.35,Default,,0,0,0,,Жасырын функция... Қызық, бұл не?
Dialogue: 0,0:06:42.19,0:06:43.52,Default,,0,0,0,,Өйткені ол пайдаланылған зат
Dialogue: 0,0:06:43.61,0:06:46.65,Default,,0,0,0,,Мүмкін алдыңғы иесі бағдарламаны өзгерткен болуы мүмкін.
Dialogue: 0,0:06:48.90,0:06:51.41,Default,,0,0,0,,Қазір 11:30
Dialogue: 0,0:06:54.37,0:06:57.08,Default,,0,0,0,,-Хмм? -(Мина) Мен түскі ас әзірлеймін.
Dialogue: 0,0:06:59.08,0:07:00.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:01.17,0:07:04.84,Default,,0,0,0,,Бұл Такума-саманың сүйікті тағамы.
Dialogue: 0,0:07:06.17,0:07:09.42,Default,,0,0,0,,Әйтеуір, бір орында тұра алмадым.
Dialogue: 0,0:07:09.51,0:07:10.80,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:07:16.60,0:07:19.27,Default,,0,0,0,,Такума мырза, отырыңыз және күтіңіз.
Dialogue: 0,0:07:19.35,0:07:23.69,Default,,0,0,0,,Хехе... Қуырылған жұмыртқаны да жей аламын...
Dialogue: 0,0:07:23.77,0:07:26.48,Default,,0,0,0,,Рецепт атауы - дашимаки тамаго.
Dialogue: 0,0:07:28.23,0:07:31.15,Default,,0,0,0,,Өлшемі шамамен 5 мм болатын қабықтың екі бөлігінен тұрады.
Dialogue: 0,0:07:31.24,0:07:32.28,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:07:32.99,0:07:34.32,Default,,0,0,0,,Онда мен сізді арттан сәл итермелеуге тура келеді —
Dialogue: 0,0:07:37.37,0:07:38.95,Default,,0,0,0,,Жарайды, пісірейік.
Dialogue: 0,0:07:39.04,0:07:40.50,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:07:40.58,0:07:41.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:43.25,0:07:46.13,Default,,0,0,0,,Дәмдеуіштерді алдын ала араластырыңыз
Dialogue: 0,0:07:46.21,0:07:48.30,Default,,0,0,0,,Қуыруға арналған табада май жоқ.
Dialogue: 0,0:07:48.38,0:07:50.80,Default,,0,0,0,,Не? Мен... көремін.
Dialogue: 0,0:07:52.34,0:07:54.68,Default,,0,0,0,,Барлық жұмыртқаны бірден қоспаңыз
Dialogue: 0,0:07:54.76,0:07:55.80,Default,,0,0,0,,А... неге?
Dialogue: 0,0:07:58.39,0:07:59.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:59.47,0:08:00.68,Default,,0,0,0,,Артық пісірілген
Dialogue: 0,0:08:00.77,0:08:02.73,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:08:02.81,0:08:06.06,Default,,0,0,0,,Кішкене қызарса жақсы болар еді...
Dialogue: 0,0:08:06.15,0:08:07.69,Default,,0,0,0,,(Дыбыс фокусы)
Dialogue: 0,0:08:09.23,0:08:11.15,Default,,0,0,0,,Ау!
Dialogue: 0,0:08:12.15,0:08:13.74,Default,,0,0,0,,Ми... Мина-чан?
Dialogue: 0,0:08:13.82,0:08:15.41,Default,,0,0,0,,Такума-сама отырады.
Dialogue: 0,0:08:16.20,0:08:18.08,Default,,0,0,0,,Бізді күтіңіздер.
Dialogue: 0,0:08:19.70,0:08:21.66,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:08:28.92,0:08:29.88,Default,,0,0,0,,Баяғыда...
Dialogue: 0,0:08:30.67,0:08:33.59,Default,,0,0,0,,Мен бұрын қыздармен кездескенмін.
Dialogue: 0,0:08:34.13,0:08:35.13,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:36.39,0:08:38.64,Default,,0,0,0,,Соңында нәтиже болмады
Dialogue: 0,0:08:40.26,0:08:41.64,Default,,0,0,0,,Содан бері...
Dialogue: 0,0:08:41.72,0:08:43.98,Default,,0,0,0,,Мен махаббаттан бас тарттым.
Dialogue: 0,0:08:48.23,0:08:50.40,Default,,0,0,0,,Мен бас тарттым...
Dialogue: 0,0:08:50.48,0:08:51.57,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:08:52.07,0:08:54.78,Default,,0,0,0,,Ыдыс жууға көмектесейін.
Dialogue: 0,0:08:54.86,0:08:58.41,Default,,0,0,0,,Жарайды, Такума-сама, отырыңызшы.
Dialogue: 0,0:09:00.74,0:09:03.33,Default,,0,0,0,,32 секундта аяқталады
Dialogue: 0,0:09:06.00,0:09:08.21,Default,,0,0,0,,Ах... анау ми... Мина-чан
Dialogue: 0,0:09:08.29,0:09:09.46,Default,,0,0,0,,Иә
Dialogue: 0,0:09:09.54,0:09:11.67,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:09:12.21,0:09:14.67,Default,,0,0,0,,Сізге қандай адам ұнайды?
Dialogue: 0,0:09:14.76,0:09:17.51,Default,,0,0,0,,Менің тамақ жеуге мүмкіндігім жоқ, сондықтан білмеймін.
Dialogue: 0,0:09:17.59,0:09:19.18,Default,,0,0,0,,Бұл тамақ туралы емес.
Dialogue: 0,0:09:19.93,0:09:23.18,Default,,0,0,0,,Мм... омлет күріш... Юбенің...
Dialogue: 0,0:09:23.85,0:09:25.69,Default,,0,0,0,,Бұл омлет күріш, бірақ...
Dialogue: 0,0:09:25.77,0:09:28.69,Default,,0,0,0,,Неге... бұл...
Dialogue: 0,0:09:28.77,0:09:30.27,Default,,0,0,0,,Сізде қиындықтар болды ма?
Dialogue: 0,0:09:30.36,0:09:32.19,Default,,0,0,0,,Жоқ... у...
Dialogue: 0,0:09:35.15,0:09:36.78,Default,,0,0,0,,Бұл өте дәмді болды.
Dialogue: 0,0:09:36.86,0:09:39.12,Default,,0,0,0,,Мен көремін. Бұл жақсы.
Dialogue: 0,0:09:39.20,0:09:40.74,Default,,0,0,0,,Сіз оны қайтадан жасай аласыз ба?
Dialogue: 0,0:09:40.83,0:09:42.45,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:09:45.08,0:09:46.29,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:09:47.21,0:09:49.96,Default,,0,0,0,,Бұл шынайы махаббат па?
Dialogue: 0,0:09:50.04,0:09:53.50,Default,,0,0,0,,Әлде бұл функция болды ма?
Dialogue: 0,0:09:53.59,0:09:59.51,Default,,0,0,0,,(Сағаттың секунд тілі дыбысы)
Dialogue: 0,0:10:04.89,0:10:06.48,Default,,0,0,0,,Мен ұйықтай алмаймын...
Dialogue: 0,0:10:06.56,0:10:09.19,Default,,0,0,0,,Күтіңіз, күтіңіз! Махаббат деген не?
Dialogue: 0,0:10:09.27,0:10:12.40,Default,,0,0,0,,Бұл бала тек тұрмыстық техника!
Dialogue: 0,0:10:13.23,0:10:14.53,Default,,0,0,0,,Такума-сама
Dialogue: 0,0:10:17.11,0:10:21.28,Default,,0,0,0,,О... Иә? Сіз ұйықтай алмадыңыз ба?
Dialogue: 0,0:10:21.37,0:10:23.95,Default,,0,0,0,,Маған ұнайтын нәрсені айтыңызшы
Dialogue: 0,0:10:24.04,0:10:25.54,Default,,0,0,0,,Ертеңгі мәзір?
Dialogue: 0,0:10:25.62,0:10:28.04,Default,,0,0,0,,Хмм, кездейсоқ таңдау жақсы.
Dialogue: 0,0:10:28.12,0:10:30.04,Default,,0,0,0,,Сізге не ұнайды?
Dialogue: 0,0:10:30.67,0:10:33.54,Default,,0,0,0,,Маған тіркелген рецепттердің барлығы ұнайды.
Dialogue: 0,0:10:33.63,0:10:35.63,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:10:35.71,0:10:38.30,Default,,0,0,0,,…
Dialogue: 0,0:10:41.76,0:10:42.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:43.72,0:10:46.06,Default,,0,0,0,,Сізге қандай адам ұнайды?
Dialogue: 0,0:10:52.40,0:10:53.56,Default,,0,0,0,,Сіз...
Dialogue: 0,0:10:54.36,0:10:57.07,Default,,0,0,0,,Мен сені жақсы көремін, сен ең жақсысың...
Dialogue: 0,0:10:57.90,0:10:59.57,Default,,0,0,0,,Маған ұнады...
Dialogue: 0,0:11:04.41,0:11:06.04,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:11:07.16,0:11:09.25,Default,,0,0,0,,Ах... Ха!
Dialogue: 0,0:11:09.33,0:11:14.09,Default,,0,0,0,,Е... те... және... ку... ку~
Dialogue: 0,0:11:14.17,0:11:17.09,Default,,0,0,0,,Гуоооооо
Dialogue: 0,0:11:19.01,0:11:20.09,Default,,0,0,0,,Такума-сама
Dialogue: 0,0:11:20.17,0:11:22.05,Default,,0,0,0,,Иә? Ммм
Dialogue: 0,0:11:22.13,0:11:24.05,Default,,0,0,0,,Тамақ дайын.
Dialogue: 0,0:11:24.14,0:11:25.81,Default,,0,0,0,,Бүгін бізде мереке.
Dialogue: 0,0:11:26.56,0:11:29.52,Default,,0,0,0,,Такума-саманың сүйіктісі...
Dialogue: 0,0:11:31.31,0:11:34.81,Default,,0,0,0,,Минаның Кабутояки...
Dialogue: 0,0:11:35.31,0:11:36.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:36.82,0:11:41.03,Default,,0,0,0,,Күтіңіз, күтіңіз! Жоқ!
Dialogue: 0,0:11:42.32,0:11:43.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:44.03,0:11:45.74,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:11:45.83,0:11:47.54,Default,,0,0,0,,Такума-сама
Dialogue: 0,0:11:48.12,0:11:49.75,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:11:50.62,0:11:53.75,Default,,0,0,0,,Ха! Қайырлы таң
Dialogue: 0,0:11:53.83,0:11:56.50,Default,,0,0,0,,Бүгін таңертең тіркеу мәзірлерінің бірі
Dialogue: 0,0:11:56.59,0:11:59.84,Default,,0,0,0,,...
Dialogue: 0,0:11:59.92,0:12:01.72,Default,,0,0,0,,Бізде басқа мәзір бар ма?
Dialogue: 0,0:12:02.72,0:12:04.51,Default,,0,0,0,,… …
Dialogue: 0,0:12:05.22,0:12:07.60,Default,,0,0,0,,Иә... жей бер...
Dialogue: 0,0:12:07.68,0:12:09.01,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:12:13.10,0:12:14.52,Default,,0,0,0,,Мина-чан
Dialogue: 0,0:12:15.90,0:12:18.86,Default,,0,0,0,,...
Dialogue: 0,0:12:19.78,0:12:24.11,Default,,0,0,0,,…
Dialogue: 0,0:12:24.99,0:12:26.49,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:12:30.16,0:12:32.37,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:12:32.46,0:12:33.87,Default,,0,0,0,,Такума-сама
Dialogue: 0,0:12:33.96,0:12:38.13,Default,,0,0,0,,...
Dialogue: 0,0:12:38.21,0:12:41.76,Default,,0,0,0,,...
Dialogue: 0,0:12:43.09,0:12:46.43,Default,,0,0,0,,...
Dialogue: 0,0:12:47.22,0:12:48.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.80,0:12:50.72,Default,,0,0,0,,Аа... иә...
Dialogue: 0,0:12:56.85,0:12:58.23,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:12:58.31,0:13:00.90,Default,,0,0,0,,...
Dialogue: 0,0:13:03.03,0:13:06.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:07.87,0:13:10.62,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:13:10.70,0:13:13.33,Default,,0,0,0,,Сізге роботтар ұнайды ма, ұнамайды ма?
Dialogue: 0,0:13:17.54,0:13:20.59,Default,,0,0,0,,Жалғыз өмір сүру тым жалғыздық, солай емес пе?
Dialogue: 0,0:13:20.67,0:13:23.26,Default,,0,0,0,,Біз мұны тоқтатуымыз керек...
Dialogue: 0,0:13:24.38,0:13:26.80,Default,,0,0,0,,Минаны да жібер...
Dialogue: 0,0:13:27.72,0:13:29.30,Default,,0,0,0,,Жібер...
Dialogue: 0,0:13:31.18,0:13:35.02,Default,,0,0,0,,Мина-чан, мен саған ұнайсың ба?
Dialogue: 0,0:13:38.65,0:13:40.56,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:41.57,0:13:42.98,Default,,0,0,0,,(бос банкалардың домалап жатқан дыбысы)
Dialogue: 0,0:13:44.32,0:13:47.24,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:13:47.95,0:13:50.32,Default,,0,0,0,,Такума мырза, мен көп іштім.
Dialogue: 0,0:13:50.41,0:13:53.08,Default,,0,0,0,,Такума тұтынатын сыраның сәйкес мөлшері қандай?
Dialogue: 0,0:13:53.16,0:13:55.00,Default,,0,0,0,,2 ұзын банкаға тең
Dialogue: 0,0:13:55.08,0:13:58.17,Default,,0,0,0,,Ішкім келеді, сондықтан оған көмектесу мүмкін емес.
Dialogue: 0,0:14:03.84,0:14:05.34,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:14:05.42,0:14:07.76,Default,,0,0,0,,(шу)
Dialogue: 0,0:14:08.34,0:14:12.01,Default,,0,0,0,,Сіз тұтынатын сыра сияқты суды ішіңіз
Dialogue: 0,0:14:12.10,0:14:13.26,Default,,0,0,0,,Е... а...
Dialogue: 0,0:14:13.85,0:14:16.43,Default,,0,0,0,,Жарайды... Мен онша көп іше алмаймын.
Dialogue: 0,0:14:16.52,0:14:19.44,Default,,0,0,0,,-Е!? -(Мина) Өтінемін іш.
Dialogue: 0,0:14:19.52,0:14:22.11,Default,,0,0,0,,Жоқ, сондықтан бұл мүмкін емес...
Dialogue: 0,0:14:25.73,0:14:27.61,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:14:27.70,0:14:30.61,Default,,0,0,0,,Угу… Угу…
Dialogue: 0,0:14:34.58,0:14:37.04,Default,,0,0,0,,Ми... Минахян
Dialogue: 0,0:14:37.12,0:14:40.21,Default,,0,0,0,,Тағы біреуі! Сыра~
Dialogue: 0,0:14:41.46,0:14:43.25,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:14:53.60,0:14:55.01,Default,,0,0,0,,Такума-сама
Dialogue: 0,0:14:55.10,0:14:57.35,Default,,0,0,0,,А... а?
Dialogue: 0,0:14:59.94,0:15:02.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:03.06,0:15:06.03,Default,,0,0,0,,Сыра қоймада жоқ
Dialogue: 0,0:15:06.82,0:15:09.32,Default,,0,0,0,,Не?
Dialogue: 0,0:15:12.36,0:15:14.74,Default,,0,0,0,,Мина~
Dialogue: 0,0:15:15.70,0:15:17.49,Default,,0,0,0,,-Уау! -(Мина) Иә.
Dialogue: 0,0:15:17.58,0:15:19.12,Default,,0,0,0,,Мина-чан...
Dialogue: 0,0:15:19.20,0:15:20.62,Default,,0,0,0,,Не?
Dialogue: 0,0:15:25.54,0:15:28.80,Default,,0,0,0,,Мен туралы не ойлайсың?
Dialogue: 0,0:15:28.88,0:15:31.13,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:32.30,0:15:36.14,Default,,0,0,0,,Мина-чанға, мен қандаймын...?
Dialogue: 0,0:15:37.93,0:15:40.02,Default,,0,0,0,,Такума-сама менің күйеуім
Dialogue: 0,0:15:40.10,0:15:41.14,Default,,0,0,0,,Иә!?
Dialogue: 0,0:15:41.73,0:15:43.56,Default,,0,0,0,,Айтуынша, кеше ол мөлдір сәбиді немесе сондай бір нәрсені тапқан екен—
Dialogue: 0,0:15:43.65,0:15:44.98,Default,,0,0,0,,Бұрын, Такума-сама
Dialogue: 0,0:15:45.06,0:15:47.65,Default,,0,0,0,,Ол маған тұрмысқа шығуымды өтінді.
Dialogue: 0,0:15:47.73,0:15:51.15,Default,,0,0,0,,Келін болу – неке қатынасына түсу.
Dialogue: 0,0:15:51.24,0:15:52.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:53.49,0:15:56.58,Default,,0,0,0,,Менің сүйіктім Мина Чан~
Dialogue: 0,0:15:56.66,0:16:00.16,Default,,0,0,0,,Менің әйелім боласың ба?
Dialogue: 0,0:16:01.54,0:16:03.17,Default,,0,0,0,,Мен оны интернеттен қарадым.
Dialogue: 0,0:16:04.00,0:16:05.42,Default,,0,0,0,,Бұл қате болды ма?
Dialogue: 0,0:16:05.50,0:16:07.88,Default,,0,0,0,,-Иә!? -(Мина) Мен өзгертемін.
Dialogue: 0,0:16:07.96,0:16:09.92,Default,,0,0,0,,Жоқ... жоқ, күте тұр, күт!
Dialogue: 0,0:16:10.01,0:16:12.51,Default,,0,0,0,,Сіз қателеспейсіз! Оны өзгертпе!
Dialogue: 0,0:16:12.59,0:16:15.39,Default,,0,0,0,,Сонымен, сен менің әйелің екеніме сенімдісің бе?
Dialogue: 0,0:16:15.47,0:16:16.93,Default,,0,0,0,,Жақсы! жақсы!
Dialogue: 0,0:16:17.97,0:16:19.47,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:16:19.56,0:16:22.60,Default,,0,0,0,,Маған ерлі-зайыптылар ретінде қарағанына өте қуаныштымын.
Dialogue: 0,0:16:22.69,0:16:24.69,Default,,0,0,0,,Мен өзімді ессіз сезінемін
Dialogue: 0,0:16:24.77,0:16:28.57,Default,,0,0,0,,Әйеліммен не істеуім керек?
Dialogue: 0,0:16:28.65,0:16:30.19,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:16:30.82,0:16:34.28,Default,,0,0,0,,Хмм, менімен боласың ба?
Dialogue: 0,0:16:34.36,0:16:38.08,Default,,0,0,0,,Сен маған күнде мисо сорпасын дайындайсың...
Dialogue: 0,0:16:38.16,0:16:41.79,Default,,0,0,0,,Бұл сіздің әдеттегі істегеніңізден еш айырмашылығы жоқ сияқты.
Dialogue: 0,0:16:41.87,0:16:42.96,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:43.66,0:16:45.37,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:16:45.46,0:16:50.17,Default,,0,0,0,,Мм, мен де үй шаруасымен айналысқым келеді...
Dialogue: 0,0:16:50.25,0:16:51.51,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:16:51.59,0:16:55.63,Default,,0,0,0,,Көп нәрсе...Олармен бөліскім келеді.
Dialogue: 0,0:16:55.72,0:16:57.22,Default,,0,0,0,,Фу фу…
Dialogue: 0,0:16:57.30,0:17:01.01,Default,,0,0,0,,Ас әзірлеу және үй жұмыстары... Уф~
Dialogue: 0,0:17:01.10,0:17:04.44,Default,,0,0,0,,Маған да салмағымның жартысын тастауға рұқсат етіңіз~
Dialogue: 0,0:17:04.52,0:17:07.90,Default,,0,0,0,,Ұсынылмайды Өткен журналдарды тексеру негізінде
Dialogue: 0,0:17:07.98,0:17:10.90,Default,,0,0,0,,Жұмыс тиімділігі айтарлықтай төмендеді
Dialogue: 0,0:17:10.98,0:17:12.99,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:17:14.15,0:17:17.74,Default,,0,0,0,,Такума-сама ұйқы күйіне өту процесінде тұрған сияқты.
Dialogue: 0,0:17:17.82,0:17:20.20,Default,,0,0,0,,Футонды орналастыр
Dialogue: 0,0:17:20.28,0:17:23.16,Default,,0,0,0,,Ух... ммм...
Dialogue: 0,0:17:23.25,0:17:25.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:25.96,0:17:27.42,Default,,0,0,0,,Мина-чан...
Dialogue: 0,0:17:27.50,0:17:29.38,Default,,0,0,0,,- Мина-чан - (Мина) Иә.
Dialogue: 0,0:17:30.79,0:17:33.38,Default,,0,0,0,,Ендеше бірге кірейік.
Dialogue: 0,0:17:33.46,0:17:34.55,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:17:34.63,0:17:37.26,Default,,0,0,0,,Ерлі-зайыптылар бірге ұйықтайды!
Dialogue: 0,0:17:37.34,0:17:40.55,Default,,0,0,0,,Ұсынылмайды Сапалы ұйқы үшін
Dialogue: 0,0:17:40.64,0:17:43.64,Default,,0,0,0,,Жеткілікті орын қамтамасыз етілуі керек
Dialogue: 0,0:17:44.98,0:17:46.64,Default,,0,0,0,,Мина-чан
Dialogue: 0,0:17:47.27,0:17:51.36,Default,,0,0,0,,Мина-чан, бірге...
Dialogue: 0,0:17:52.73,0:17:55.15,Default,,0,0,0,,…
Dialogue: 0,0:17:58.49,0:17:59.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:02.87,0:18:04.16,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:18:12.59,0:18:14.88,Default,,0,0,0,,- Мина-чан - (Мина) Иә.
Dialogue: 0,0:18:14.96,0:18:16.67,Default,,0,0,0,,Көздер... қорқынышты
Dialogue: 0,0:18:17.51,0:18:18.68,Default,,0,0,0,,Жабық
Dialogue: 0,0:18:18.76,0:18:20.34,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:18:21.76,0:18:23.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:23.22,0:18:25.39,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:18:25.47,0:18:27.10,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:18:27.18,0:18:31.48,Default,,0,0,0,,Жүрек айну, бас айналу немесе тыныс алудың қиындауы сияқты белгілер болса
Dialogue: 0,0:18:31.56,0:18:33.82,Default,,0,0,0,,Алкогольмен улану қаупі
Dialogue: 0,0:18:33.90,0:18:35.57,Default,,0,0,0,,(Шоко) Есікті ашамын. Киініп жатқанда да апат болуы мүмкін, білесің бе.
Dialogue: 0,0:18:36.44,0:18:38.78,Default,,0,0,0,,Сол футонда қыз ұйықтап жатыр
Dialogue: 0,0:18:38.86,0:18:41.82,Default,,0,0,0,,Уау... сондай мүйізді
Dialogue: 0,0:18:43.45,0:18:45.04,Default,,0,0,0,,Мүйізділік дегеніміз не?
Dialogue: 0,0:18:45.12,0:18:47.62,Default,,0,0,0,,Е! Ах... аа...
Dialogue: 0,0:18:47.70,0:18:51.04,Default,,0,0,0,,Мен... ұмытамын, ұмытамын, қазір ұйықтаймын.
Dialogue: 0,0:18:51.13,0:18:52.33,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:18:54.92,0:18:59.09,Default,,0,0,0,,Такума-сама жыныстық толқуда ма?
Dialogue: 0,0:18:59.17,0:19:02.30,Default,,0,0,0,,Е! Мүмкін сіз интернеттен іздеген шығарсыз?
Dialogue: 0,0:19:02.39,0:19:03.60,Default,,0,0,0,,Мен жасадым
Dialogue: 0,0:19:04.81,0:19:06.10,Default,,0,0,0,,Болмаңыз...
Dialogue: 0,0:19:06.97,0:19:09.06,Default,,0,0,0,,Оның тыныс алуы тұрақсыз, ол қиналып жатқан сияқты.
Dialogue: 0,0:19:09.14,0:19:11.60,Default,,0,0,0,,Мен істей алатын бірдеңе бар ма?
Dialogue: 0,0:19:12.94,0:19:14.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:18.49,0:19:19.95,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:19:20.95,0:19:24.83,Default,,0,0,0,,Менің қасымда Мина Чан болды...
Dialogue: 0,0:19:24.91,0:19:28.00,Default,,0,0,0,,Керемет... Мен өте қуаныштымын.
Dialogue: 0,0:19:30.62,0:19:32.12,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:19:38.84,0:19:41.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:43.55,0:19:48.02,Default,,0,0,0,,Мен мас болып, ессіз нәрсе жасадым.
Dialogue: 0,0:19:48.10,0:19:49.27,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:19:49.35,0:19:52.94,Default,,0,0,0,,Уау! Бәрі есімде!
Dialogue: 0,0:19:53.02,0:19:54.81,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:19:54.90,0:19:56.73,Default,,0,0,0,,Таңғы ас дайын.
Dialogue: 0,0:19:57.23,0:19:58.78,Default,,0,0,0,,Ах... қайырлы таң
Dialogue: 0,0:19:58.86,0:20:01.03,Default,,0,0,0,,Мина... Иә!?
Dialogue: 0,0:20:02.53,0:20:03.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:04.36,0:20:06.74,Default,,0,0,0,,Не? Көзіңе не болды?
Dialogue: 0,0:20:06.83,0:20:08.04,Default,,0,0,0,,(Тсубаки) Дегенмен, Косэйдің аяғына зақым келгеніне қуаныштымын—
Dialogue: 0,0:20:08.12,0:20:09.66,Default,,0,0,0,,Ұйқыңыз келе ме?
Dialogue: 0,0:20:09.75,0:20:12.37,Default,,0,0,0,,Маған ұйқы керек емес
Dialogue: 0,0:20:12.46,0:20:13.67,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:20:15.58,0:20:17.75,Default,,0,0,0,,Көру бірлігі нәзік болғандықтан
Dialogue: 0,0:20:17.84,0:20:19.59,Default,,0,0,0,,Өтінемін, қолыңды тиме
Dialogue: 0,0:20:19.67,0:20:21.17,Default,,0,0,0,,Бұл! Ittete…
Dialogue: 0,0:20:21.26,0:20:23.51,Default,,0,0,0,,Бір жерде сынған ба?
Dialogue: 0,0:20:23.59,0:20:26.18,Default,,0,0,0,,Еш жерде ақау жоқ. Бұл қалыпты жағдай.
Dialogue: 0,0:20:27.39,0:20:28.68,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:20:30.22,0:20:32.68,Default,,0,0,0,,Такума-сама өзін жақсы сезіне ме?
Dialogue: 0,0:20:32.77,0:20:35.06,Default,,0,0,0,,Асқабақтану қаупі
Dialogue: 0,0:20:35.15,0:20:37.94,Default,,0,0,0,,А... енді ойлап қарасам, жарайды.
Dialogue: 0,0:20:38.69,0:20:41.69,Default,,0,0,0,,Су Мен көп ішкендіктен шығар.
Dialogue: 0,0:20:43.82,0:20:46.74,Default,,0,0,0,,Йоккорасетто
Dialogue: 0,0:20:51.50,0:20:52.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:55.54,0:20:57.13,Default,,0,0,0,,Мина-чан
Dialogue: 0,0:20:57.21,0:20:58.25,Default,,0,0,0,,Не?
Dialogue: 0,0:20:58.34,0:21:01.00,Default,,0,0,0,,Кеше көзіңнен қорқамын дедің.
Dialogue: 0,0:21:01.09,0:21:04.47,Default,,0,0,0,,Маған жақыннан қарасаң...
Dialogue: 0,0:21:04.55,0:21:07.01,Default,,0,0,0,,«Қорқынышты» бұл сіздің жүрегіңізді соғады дегенді білдіреді.
Dialogue: 0,0:21:08.60,0:21:09.76,Default,,0,0,0,,Мина-чан
Dialogue: 0,0:21:09.85,0:21:12.47,Default,,0,0,0,,Сенің көздерің өте әдемі.
Dialogue: 0,0:21:12.56,0:21:13.77,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:25.86,0:21:27.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:30.37,0:21:31.95,Default,,0,0,0,,Бүгінгі таңғы ас
Dialogue: 0,0:21:32.04,0:21:35.79,Default,,0,0,0,,Грильде пісірілген лосось, бальзам қосылған мисо сорпасы, шпинат сорпасы
Dialogue: 0,0:21:35.87,0:21:37.79,Default,,0,0,0,,Және күріш.
Dialogue: 0,0:21:39.42,0:21:40.79,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:21:58.40,0:21:59.90,Default,,0,0,0,,Мина-чан
Dialogue: 0,0:21:59.98,0:22:01.31,Default,,0,0,0,,Иә
Dialogue: 0,0:22:01.40,0:22:02.86,Default,,0,0,0,,Жолсыз жерлерге арналған көлік қолайлырақ болар еді, білесің бе?
Dialogue: 0,0:22:02.94,0:22:04.40,Default,,0,0,0,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:22:06.95,0:22:11.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:29.49,0:23:35.49,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.79,0:23:37.99,Default,,0,0,0,,Келесі жолы…
Dialogue: 0,0:23:39.49,0:23:45.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
