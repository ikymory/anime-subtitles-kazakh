Dialogue: 0,0:02:10.03,0:02:12.60,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:02:10.03,0:02:12.60,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:10.03,0:02:12.60,Default,,0000,0000,0000,,Ашулану үшін не істеуім керек...
Dialogue: 0,0:02:10.03,0:02:12.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:12.60,0:02:14.60,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:12.60,0:02:14.60,Default,,0000,0000,0000,,Есіктің ашылған дыбысы
Dialogue: 0,0:02:12.60,0:02:14.60,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:12.60,0:02:14.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:14.60,0:02:16.64,Default,,0000,0000,0000,,Хаг
Dialogue: 0,0:02:14.60,0:02:16.64,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:14.60,0:02:16.64,Default,,0000,0000,0000,,Яри Теба
Dialogue: 0,0:02:14.60,0:02:16.64,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:14.60,0:02:16.64,Default,,0000,0000,0000,,Соңында
Dialogue: 0,0:02:14.60,0:02:16.64,Default,,0000,0000,0000,,Сіз ояусыз ба?
Dialogue: 0,0:02:16.64,0:02:19.04,Default,,0000,0000,0000,,Джиджо
Dialogue: 0,0:02:16.64,0:02:19.04,Default,,0000,0000,0000,,Менің жезөкшем
Dialogue: 0,0:02:16.64,0:02:19.04,Default,,0000,0000,0000,,Мен өзімді өтеуге тырысамын➡
Dialogue: 0,0:02:19.04,0:02:22.04,Default,,0000,0000,0000,,Күміс 1000 немесе 2000
Dialogue: 0,0:02:19.04,0:02:22.04,Default,,0000,0000,0000,,Бұл мен сатып алатын нәрсе болуы керек➡
Dialogue: 0,0:02:22.04,0:02:25.04,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:02:22.04,0:02:25.04,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:22.04,0:02:25.04,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:02:22.04,0:02:25.04,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:22.04,0:02:25.04,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:02:22.04,0:02:25.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:25.04,0:02:28.55,Default,,0000,0000,0000,,Егер 10 000 күміс жеткіліксіз болса
Dialogue: 0,0:02:25.04,0:02:28.55,Default,,0000,0000,0000,,Тіпті 20 000
Dialogue: 0,0:02:25.04,0:02:28.55,Default,,0000,0000,0000,,Тіпті 30 000
Dialogue: 0,0:02:25.04,0:02:28.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:28.55,0:02:31.55,Default,,0000,0000,0000,,Күтілгендей, 10
Dialogue: 0,0:02:28.55,0:02:31.55,Default,,0000,0000,0000,,Бұл аздап қиын
Dialogue: 0,0:02:28.55,0:02:31.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:31.55,0:02:34.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:31.55,0:02:34.55,Default,,0000,0000,0000,,Яри Теба
Dialogue: 0,0:02:31.55,0:02:34.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:31.55,0:02:34.55,Default,,0000,0000,0000,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:02:31.55,0:02:34.55,Default,,0000,0000,0000,,Тездетіңіз
Dialogue: 0,0:02:31.55,0:02:34.55,Default,,0000,0000,0000,,Мұнда кел
Dialogue: 0,0:02:31.55,0:02:34.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:34.55,0:02:37.06,Default,,0000,0000,0000,,Мен сізге ұнайтын нәрсені таңдауға рұқсат етемін.
Dialogue: 0,0:02:34.55,0:02:37.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:38.63,0:02:41.09,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:02:38.63,0:02:41.09,Default,,0000,0000,0000,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:02:38.63,0:02:41.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:47.03,0:02:48.54,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:47.03,0:02:48.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:48.54,0:03:03.55,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:03.55,0:03:07.09,Default,,0000,0000,0000,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:03:03.55,0:03:07.09,Default,,0000,0000,0000,,Мен үш ханшайымды қоса аламын ба?
Dialogue: 0,0:03:07.09,0:03:13.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:07.09,0:03:13.03,Default,,0000,0000,0000,,Яри Теба
Dialogue: 0,0:03:07.09,0:03:13.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:07.09,0:03:13.03,Default,,0000,0000,0000,,Мен сізге ұнаған нәрсені айттым.
Dialogue: 0,0:03:07.09,0:03:13.03,Default,,0000,0000,0000,,Бұл сома
Dialogue: 0,0:03:07.09,0:03:13.03,Default,,0000,0000,0000,,Мен көп ақша аламын.
Dialogue: 0,0:03:07.09,0:03:13.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:13.03,0:03:16.03,Default,,0000,0000,0000,,Онда адамдар бар. Екеуі.
Dialogue: 0,0:03:13.03,0:03:16.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:16.03,0:03:20.53,Default,,0000,0000,0000,,«Жезөкше қанша жақсы киінсе де,
Dialogue: 0,0:03:16.03,0:03:20.53,Default,,0000,0000,0000,,Бұл жай ғана Go тасына ұқсайды...》
Dialogue: 0,0:03:20.53,0:03:24.07,Default,,0000,0000,0000,,《Ондай жағдайда
Dialogue: 0,0:03:20.53,0:03:24.07,Default,,0000,0000,0000,,Меймей
Dialogue: 0,0:03:20.53,0:03:24.07,Default,,0000,0000,0000,,Мені жақсы сезінген Умеумеге➡
Dialogue: 0,0:03:24.07,0:03:27.04,Default,,0000,0000,0000,,Мүмкін сізді марапаттау дұрыс шығар》
Dialogue: 0,0:03:30.58,0:03:33.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:30.58,0:03:33.05,Default,,0000,0000,0000,,Аяқ дыбыстары
Dialogue: 0,0:03:30.58,0:03:33.05,Default,,0000,0000,0000,,)
