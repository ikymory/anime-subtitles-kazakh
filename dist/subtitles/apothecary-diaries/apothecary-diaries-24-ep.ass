Dialogue: 0,0:05:32.53,0:05:36.54,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:05:32.53,0:05:36.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:32.53,0:05:36.54,Default,,0000,0000,0000,,That's right.
Dialogue: 0,0:05:32.53,0:05:36.54,Default,,0000,0000,0000,,Мен таңдауым керек...
Dialogue: 0,0:05:32.53,0:05:36.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:36.54,0:05:39.01,Default,,0000,0000,0000,,Ки…
Dialogue: 0,0:05:36.54,0:05:39.01,Default,,0000,0000,0000,,Сіз тыңдап жатырсыз ба?
Dialogue: 0,0:05:47.55,0:05:51.08,Default,,0000,0000,0000,,Мен бұл әйелден сұраймын
Dialogue: 0,0:05:47.55,0:05:51.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:51.08,0:05:53.12,Default,,0000,0000,0000,,Мен ақымақ емеспін!
Dialogue: 0,0:05:53.12,0:05:56.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:53.12,0:05:56.06,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:05:53.12,0:05:56.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:53.12,0:05:56.06,Default,,0000,0000,0000,,Бұл кез келген адам болуы мүмкін деп кім айтты?
Dialogue: 0,0:05:53.12,0:05:56.06,Default,,0000,0000,0000,,Кемпір болса керек.
Dialogue: 0,0:05:53.12,0:05:56.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:56.06,0:05:58.52,Default,,0000,0000,0000,,Ақша дегеніміз
Dialogue: 0,0:05:56.06,0:05:58.52,Default,,0000,0000,0000,,Қолымыздан келгенше жұмсайық
Dialogue: 0,0:05:56.06,0:05:58.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:58.52,0:06:01.56,Default,,0000,0000,0000,,Мен сізге 100 000 немесе 200 000 төлеймін.
Dialogue: 0,0:05:58.52,0:06:01.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:01.56,0:06:03.53,Default,,0000,0000,0000,,Не туралы айтып тұрсың?!
Dialogue: 0,0:06:03.53,0:06:05.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:03.53,0:06:05.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:07.53,0:06:11.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:07.53,0:06:11.54,Default,,0000,0000,0000,,Го тастарын шығару дыбысы
Dialogue: 0,0:06:07.53,0:06:11.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:22.05,0:06:36.56,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:36.56,0:06:39.07,Default,,0000,0000,0000,,Go ойнаймыз
Dialogue: 0,0:06:36.56,0:06:39.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:39.07,0:06:45.67,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:45.67,0:06:51.14,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:06:45.67,0:06:51.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:53.05,0:06:56.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:53.05,0:06:56.05,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:06:53.05,0:06:56.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:53.05,0:06:56.05,Default,,0000,0000,0000,,Хоо~
Dialogue: 0,0:06:53.05,0:06:56.05,Default,,0000,0000,0000,,Сіз мұнда келдіңіз бе?
Dialogue: 0,0:06:53.05,0:06:56.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:56.05,0:06:59.55,Default,,0000,0000,0000,,Сіздің қозғалысыңыз
Dialogue: 0,0:06:56.05,0:06:59.55,Default,,0000,0000,0000,,Әрқашан шектен шыққан
Dialogue: 0,0:06:56.05,0:06:59.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:59.55,0:07:02.52,Default,,0000,0000,0000,,Мао Мао
Dialogue: 0,0:06:59.55,0:07:02.52,Default,,0000,0000,0000,,Мысық мысық
Dialogue: 0,0:06:59.55,0:07:02.52,Default,,0000,0000,0000,,Сіз сондайсыз.
Dialogue: 0,0:06:59.55,0:07:02.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:02.52,0:07:08.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:02.52,0:07:08.06,Default,,0000,0000,0000,,Жылау
Dialogue: 0,0:07:02.52,0:07:08.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:08.06,0:07:10.10,Default,,0000,0000,0000,,Не-сан
Dialogue: 0,0:07:08.06,0:07:10.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:08.06,0:07:10.10,Default,,0000,0000,0000,,Умеуме
Dialogue: 0,0:07:08.06,0:07:10.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:08.06,0:07:10.10,Default,,0000,0000,0000,,Үлкен әпке…
Dialogue: 0,0:07:08.06,0:07:10.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:10.10,0:07:14.67,Default,,0000,0000,0000,,Әу бастан шыншыл болсам ғой.
Dialogue: 0,0:07:10.10,0:07:14.67,Default,,0000,0000,0000,,Бұл жақсы болар еді...
Dialogue: 0,0:07:10.10,0:07:14.67,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:14.67,0:07:17.57,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:07:14.67,0:07:17.57,Default,,0000,0000,0000,,Жылдамырақ…
Dialogue: 0,0:07:14.67,0:07:17.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:17.57,0:07:21.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:17.57,0:07:21.57,Default,,0000,0000,0000,,Жылау
Dialogue: 0,0:07:17.57,0:07:21.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:21.57,0:07:26.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:21.57,0:07:26.05,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:07:21.57,0:07:26.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:21.57,0:07:26.05,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:07:21.57,0:07:26.05,Default,,0000,0000,0000,,Мен бұл жезөкшені құрбандыққа шаламын.
Dialogue: 0,0:07:21.57,0:07:26.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:28.55,0:07:35.56,Default,,0000,0000,0000,,Хосенька
Dialogue: 0,0:07:28.55,0:07:35.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:28.55,0:07:35.56,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:07:28.55,0:07:35.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:28.55,0:07:35.56,Default,,0000,0000,0000,,《Феникс гүліндей
Dialogue: 0,0:07:28.55,0:07:35.56,Default,,0000,0000,0000,,Буси!
Dialogue: 0,0:07:28.55,0:07:35.56,Default,,0000,0000,0000,,Бұл әйел...》
Dialogue: 0,0:07:44.03,0:07:47.03,Default,,0000,0000,0000,,Рокушокан
Dialogue: 0,0:07:44.03,0:07:47.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:44.03,0:07:47.03,Default,,0000,0000,0000,,Мысық мысық
Dialogue: 0,0:07:44.03,0:07:47.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:44.03,0:07:47.03,Default,,0000,0000,0000,,《Ол кісіні Риокусейканға апар
Dialogue: 0,0:07:44.03,0:07:47.03,Default,,0000,0000,0000,,Сізді шығарып салу үшін➡
Dialogue: 0,0:07:47.03,0:07:51.04,Default,,0000,0000,0000,,Бәсен
Dialogue: 0,0:07:47.03,0:07:51.04,Default,,0000,0000,0000,,Менімен бірге келген адам Мәсен болатын.
Dialogue: 0,0:07:51.04,0:07:53.54,Default,,0000,0000,0000,,《Мен шаршадым...》
Dialogue: 0,0:07:53.54,0:07:55.04,Default,,0000,0000,0000,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:07:55.04,0:07:58.04,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:55.04,0:07:58.04,Default,,0000,0000,0000,,Масен
Dialogue: 0,0:07:55.04,0:07:58.04,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:55.04,0:07:58.04,Default,,0000,0000,0000,,Чи…
Dialogue: 0,0:07:55.04,0:07:58.04,Default,,0000,0000,0000,,Қара жүректі ата-ана мен бала
Dialogue: 0,0:07:55.04,0:07:58.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:00.05,0:08:02.62,Default,,0000,0000,0000,,Луранхи
Dialogue: 0,0:08:00.05,0:08:02.62,Default,,0000,0000,0000,,《Бұл консорт Лулан》
Dialogue: 0,0:08:02.62,0:08:06.55,Default,,0000,0000,0000,,《Бақ кешінен кейін
Dialogue: 0,0:08:02.62,0:08:06.55,Default,,0000,0000,0000,,Сіз осында қалдыңыз ба?
Dialogue: 0,0:08:06.55,0:08:10.02,Default,,0000,0000,0000,,《Ол кісі
Dialogue: 0,0:08:06.55,0:08:10.02,Default,,0000,0000,0000,,Сарайдағы қызы
Dialogue: 0,0:08:06.55,0:08:10.02,Default,,0000,0000,0000,,Оны итеруге мәжбүр болған деседі➡
Dialogue: 0,0:08:10.02,0:08:13.03,Default,,0000,0000,0000,,Лоуланның әкесі әйелі ме?
Dialogue: 0,0:08:13.03,0:08:15.03,Default,,0000,0000,0000,,《Солай болса да➡
Dialogue: 0,0:08:15.03,0:08:20.03,Default,,0000,0000,0000,,Осындай жерде
Dialogue: 0,0:08:15.03,0:08:20.03,Default,,0000,0000,0000,,Жоғары лауазымды шенеуніктерді жамандау
Dialogue: 0,0:08:15.03,0:08:20.03,Default,,0000,0000,0000,,Мен сенің тоқтағаныңды қалаймын》
Dialogue: 0,0:08:20.03,0:08:22.07,Default,,0000,0000,0000,,《Біреу сізден сұраса➡
Dialogue: 0,0:08:22.07,0:08:25.10,Default,,0000,0000,0000,,Мен де жаман сөздер айттым.
Dialogue: 0,0:08:22.07,0:08:25.10,Default,,0000,0000,0000,,Қате түсіндім》
Dialogue: 0,0:08:25.10,0:08:27.14,Default,,0000,0000,0000,,《Бұл әлі көк》
Dialogue: 0,0:08:27.14,0:08:29.54,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:08:27.14,0:08:29.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:27.14,0:08:29.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:29.54,0:08:31.44,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:08:29.54,0:08:31.44,Default,,0000,0000,0000,,Джиндзи-сама сені шақырып жатыр.
Dialogue: 0,0:08:29.54,0:08:31.44,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:34.05,0:08:36.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:08:34.05,0:08:36.55,Default,,0000,0000,0000,,Аяқ дыбыстары
Dialogue: 0,0:08:34.05,0:08:36.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:08:34.05,0:08:36.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:08:34.05,0:08:36.55,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:08:34.05,0:08:36.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:08:34.05,0:08:36.55,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:08:34.05,0:08:36.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:36.55,0:08:39.05,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:08:36.55,0:08:39.05,Default,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:08:36.55,0:08:39.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:39.05,0:08:41.05,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:08:39.05,0:08:41.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:08:39.05,0:08:41.05,Default,,0000,0000,0000,,Су лотосу
Dialogue: 0,0:08:39.05,0:08:41.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:08:39.05,0:08:41.05,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:08:41.05,0:08:44.06,Default,,0000,0000,0000,,О, менің...
Dialogue: 0,0:08:41.05,0:08:44.06,Default,,0000,0000,0000,,Мен көп салмақ жоғалттым
Dialogue: 0,0:08:41.05,0:08:44.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:44.06,0:08:45.56,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:08:44.06,0:08:45.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:46.63,0:08:50.56,Default,,0000,0000,0000,,Сяомао
Dialogue: 0,0:08:46.63,0:08:50.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:08:46.63,0:08:50.56,Default,,0000,0000,0000,,Су лотосу
Dialogue: 0,0:08:46.63,0:08:50.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:08:46.63,0:08:50.56,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:46.63,0:08:50.56,Default,,0000,0000,0000,,Конеко
Dialogue: 0,0:08:46.63,0:08:50.56,Default,,0000,0000,0000,,Көп тамақтаныңыз.
Dialogue: 0,0:08:46.63,0:08:50.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:50.56,0:08:54.53,Default,,0000,0000,0000,,Мен саған көбірек әкелемін.
Dialogue: 0,0:08:50.56,0:08:54.53,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:08:50.56,0:08:54.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:56.54,0:08:59.57,Default,,0000,0000,0000,,Гунши-ден туралы
Dialogue: 0,0:08:56.54,0:08:59.57,Default,,0000,0000,0000,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:08:56.54,0:08:59.57,Default,,0000,0000,0000,,Теккири➡
Dialogue: 0,0:08:59.57,0:09:02.04,Default,,0000,0000,0000,,Менің саған деген өшім бар сияқты.
Dialogue: 0,0:08:59.57,0:09:02.04,Default,,0000,0000,0000,,Мен солай ойладым.
Dialogue: 0,0:08:59.57,0:09:02.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:02.04,0:09:04.54,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:09:02.04,0:09:04.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:04.54,0:09:06.58,Default,,0000,0000,0000,,Мен кек сақтамаймын
Dialogue: 0,0:09:04.54,0:09:06.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:06.58,0:09:09.65,Default,,0000,0000,0000,,Біз болсақ
Dialogue: 0,0:09:06.58,0:09:09.65,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:09:06.58,0:09:09.65,Default,,0000,0000,0000,,Мені ұрғаныңыз үшін рақмет➡
Dialogue: 0,0:09:09.65,0:09:13.55,Default,,0000,0000,0000,,Мен осында болғандықтан
Dialogue: 0,0:09:09.65,0:09:13.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:09.65,0:09:13.55,Default,,0000,0000,0000,,Мұны айтудың басқа жолы бар ма?
Dialogue: 0,0:09:13.55,0:09:15.52,Default,,0000,0000,0000,,Бұл рас
Dialogue: 0,0:09:13.55,0:09:15.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:15.52,0:09:18.06,Default,,0000,0000,0000,,Не елестеткеніңізді білмеймін, бірақ➡
Dialogue: 0,0:09:18.06,0:09:21.53,Default,,0000,0000,0000,,Куртизанның келісімінсіз
Dialogue: 0,0:09:18.06,0:09:21.53,Default,,0000,0000,0000,,Бала
Dialogue: 0,0:09:18.06,0:09:21.53,Default,,0000,0000,0000,,Жүкті емес
Dialogue: 0,0:09:18.06,0:09:21.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:22.53,0:09:25.03,Default,,0000,0000,0000,,Сондай-ақ контрацептивтер мен түсік түсіретін дәрілер бар➡
Dialogue: 0,0:09:25.03,0:09:28.07,Default,,0000,0000,0000,,Оны бастапқы кезеңде де іске қосуға болады.
Dialogue: 0,0:09:25.03,0:09:28.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:28.07,0:09:31.47,Default,,0000,0000,0000,,Кім дүниеге әкелді
Dialogue: 0,0:09:28.07,0:09:31.47,Default,,0000,0000,0000,,Бәлкім, ниеті солай болса керек.
Dialogue: 0,0:09:28.07,0:09:31.47,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:32.64,0:09:36.04,Default,,0000,0000,0000,,штамп картаңды қатты үнемдеп жинап, дәл қолданар сәтте оның мерзімі өтіп кеткенін байқағандай жүз жаса,
Dialogue: 0,0:09:32.64,0:09:36.04,Default,,0000,0000,0000,,Бұл сюжет емес пе еді?
Dialogue: 0,0:09:36.04,0:09:38.04,Default,,0000,0000,0000,,Әскери қолбасшы ше?
Dialogue: 0,0:09:38.04,0:09:42.05,Default,,0000,0000,0000,,Кокацу
Dialogue: 0,0:09:38.04,0:09:42.05,Default,,0000,0000,0000,,Әйелдер айлакер жаратылыс.
Dialogue: 0,0:09:38.04,0:09:42.05,Default,,0000,0000,0000,,Қан айналымының циклін оқысаңыз➡
Dialogue: 0,0:09:42.05,0:09:46.05,Default,,0000,0000,0000,,Балалы болу оңай болатын күндер мен уақыттар, т.б.
Dialogue: 0,0:09:42.05,0:09:46.05,Default,,0000,0000,0000,,Белгілі бір дәрежеде
Dialogue: 0,0:09:42.05,0:09:46.05,Default,,0000,0000,0000,,Болжалды
Dialogue: 0,0:09:42.05,0:09:46.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:46.05,0:09:48.05,Default,,0000,0000,0000,,Фуми
Dialogue: 0,0:09:46.05,0:09:48.05,Default,,0000,0000,0000,,Егер сіз әдепті болсаңыз, хат жазыңыз ➡
Dialogue: 0,0:09:48.05,0:09:51.56,Default,,0000,0000,0000,,Келу күні
Dialogue: 0,0:09:48.05,0:09:51.56,Default,,0000,0000,0000,,Оны өзгертуге де болады.
Dialogue: 0,0:09:48.05,0:09:51.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:51.56,0:09:58.03,Default,,0000,0000,0000,,《Сол себепті
Dialogue: 0,0:09:51.56,0:09:58.03,Default,,0000,0000,0000,,Мақсатыңызды жіберіп алған кезде
Dialogue: 0,0:09:51.56,0:09:58.03,Default,,0000,0000,0000,,Сіз мені ұмытқан болуыңыз керек...》
Dialogue: 0,0:09:58.03,0:10:02.54,Default,,0000,0000,0000,,《Тіпті өзімді қинадым
Dialogue: 0,0:09:58.03,0:10:02.54,Default,,0000,0000,0000,,Мен мұны істеуге дайынмын.
Dialogue: 0,0:10:02.54,0:10:04.57,Default,,0000,0000,0000,,《Мен бұған қанағаттанбаймын➡
Dialogue: 0,0:10:04.57,0:10:08.54,Default,,0000,0000,0000,,Нәрестенің кішкентай саусағын қосыңыз
Dialogue: 0,0:10:04.57,0:10:08.54,Default,,0000,0000,0000,,Жіберілген мәтін》
Dialogue: 0,0:10:10.04,0:10:13.58,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:10:10.04,0:10:13.58,Default,,0000,0000,0000,,Кеңсе сыртындағы әлгі адам➡
Dialogue: 0,0:10:13.58,0:10:16.62,Default,,0000,0000,0000,,Маған не айтылды
Dialogue: 0,0:10:13.58,0:10:16.62,Default,,0000,0000,0000,,Жоқ, солай ма?
Dialogue: 0,0:10:16.62,0:10:18.15,Default,,0000,0000,0000,,Айтып тұрғасын...
Dialogue: 0,0:10:16.62,0:10:18.15,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:18.15,0:10:21.05,Default,,0000,0000,0000,,Сол адам
Dialogue: 0,0:10:18.15,0:10:21.05,Default,,0000,0000,0000,,Мен адамдардың жүзін тани алмаймын.
Dialogue: 0,0:10:18.15,0:10:21.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:21.05,0:10:24.06,Default,,0000,0000,0000,,Сіз білмейсіз бе?
Dialogue: 0,0:10:21.05,0:10:24.06,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:10:24.06,0:10:29.03,Default,,0000,0000,0000,,Көздер мен ауыздың пішінін көретін болсам да
Dialogue: 0,0:10:24.06,0:10:29.03,Default,,0000,0000,0000,,Барлығын бірден тану мүмкін емес➡
Dialogue: 0,0:10:29.03,0:10:32.06,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:10:29.03,0:10:32.06,Default,,0000,0000,0000,,Бірдей бет
Dialogue: 0,0:10:29.03,0:10:32.06,Default,,0000,0000,0000,,Сіз оны көріп тұрған сияқтысыз.
Dialogue: 0,0:10:29.03,0:10:32.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:32.06,0:10:34.57,Default,,0000,0000,0000,,Бұл ұят...
Dialogue: 0,0:10:32.06,0:10:34.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:34.57,0:10:39.71,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:10:34.57,0:10:39.71,Default,,0000,0000,0000,,Бұл оқиғаны маған асырап алған әкем де айтып берді.
Dialogue: 0,0:10:34.57,0:10:39.71,Default,,0000,0000,0000,,Ол осылай деді
Dialogue: 0,0:10:34.57,0:10:39.71,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:39.71,0:10:42.24,Default,,0000,0000,0000,,Луомен
Dialogue: 0,0:10:39.71,0:10:42.24,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:39.71,0:10:42.24,Default,,0000,0000,0000,,Рамон
Dialogue: 0,0:10:39.71,0:10:42.24,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:39.71,0:10:42.24,Default,,0000,0000,0000,,｟Кедей жігіт｠
Dialogue: 0,0:10:42.24,0:10:45.14,Default,,0000,0000,0000,,｟Сондықтан
Dialogue: 0,0:10:42.24,0:10:45.14,Default,,0000,0000,0000,,Мен ұзақ уақыт бойы азап шегіп жүрмін｠
Dialogue: 0,0:10:45.14,0:10:47.55,Default,,0000,0000,0000,,｟Хмм｠
Dialogue: 0,0:10:47.55,0:10:54.05,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:10:47.55,0:10:54.05,Default,,0000,0000,0000,,Аударма: Xianyu Experience Blackfeather | Авторлары: Xiao Wu, Cuo Nan | Тексерген: Kuma Star's Wayward Sheep
Dialogue: 0,0:10:47.55,0:10:54.05,Default,,0000,0000,0000,,Тек менің және асырап алған әкемнің жүздері
Dialogue: 0,0:10:47.55,0:10:54.05,Default,,0000,0000,0000,,Сіз мұны жақсы түсінген сияқтысыз.
Dialogue: 0,0:10:47.55,0:10:54.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:54.05,0:10:59.13,Default,,0000,0000,0000,,Бұл біртүрлі құмарлық
Dialogue: 0,0:10:54.05,0:10:59.13,Default,,0000,0000,0000,,Бұл себеп болған сияқты
Dialogue: 0,0:10:54.05,0:10:59.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:59.13,0:11:01.66,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:10:59.13,0:11:01.66,Default,,0000,0000,0000,,Сол моноклге➡
Dialogue: 0,0:11:01.66,0:11:05.56,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:11:01.66,0:11:05.56,Default,,0000,0000,0000,,Мені әке деп атаңыз
Dialogue: 0,0:11:01.66,0:11:05.56,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:11:01.66,0:11:05.56,Default,,0000,0000,0000,,Сұраған кезде
Dialogue: 0,0:11:01.66,0:11:05.56,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:05.56,0:11:09.04,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:05.56,0:11:09.04,Default,,0000,0000,0000,,Көзілдірікті сындырғым келеді
Dialogue: 0,0:11:05.56,0:11:09.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:09.04,0:11:10.54,Default,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:11:12.54,0:11:18.04,Default,,0000,0000,0000,,Ол өзінің әкесімін деп мәлімдейді.
Dialogue: 0,0:11:12.54,0:11:18.04,Default,,0000,0000,0000,,Ең жақсысы, айғыр жақсы жер.
Dialogue: 0,0:11:12.54,0:11:18.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:20.05,0:11:24.62,Default,,0000,0000,0000,,Суби
Dialogue: 0,0:11:20.05,0:11:24.62,Default,,0000,0000,0000,,《Ол кісі
Dialogue: 0,0:11:20.05,0:11:24.62,Default,,0000,0000,0000,,Құрғаған раушан гүлінің мағынасы
Dialogue: 0,0:11:20.05,0:11:24.62,Default,,0000,0000,0000,,Байқадыңыз ба...》
Dialogue: 0,0:11:24.62,0:11:28.02,Default,,0000,0000,0000,,《Жақсы
Dialogue: 0,0:11:24.62,0:11:28.02,Default,,0000,0000,0000,,Түсінбесеңіз
Dialogue: 0,0:11:24.62,0:11:28.02,Default,,0000,0000,0000,,Жарайды》
Dialogue: 0,0:11:28.02,0:11:29.56,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:11:28.02,0:11:29.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:29.56,0:11:33.03,Default,,0000,0000,0000,,Тіпті жек көрсең де
Dialogue: 0,0:11:29.56,0:11:33.03,Default,,0000,0000,0000,,Мен кек сақтамаймын
Dialogue: 0,0:11:29.56,0:11:33.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:33.03,0:11:37.53,Default,,0000,0000,0000,,Жалғыз нәрсе - мен Рамонның қызы болдым.
Dialogue: 0,0:11:33.03,0:11:37.53,Default,,0000,0000,0000,,Мен ризамын.
Dialogue: 0,0:11:33.03,0:11:37.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:37.53,0:11:41.53,Default,,0000,0000,0000,,Сол себепті
Dialogue: 0,0:11:37.53,0:11:41.53,Default,,0000,0000,0000,,Бұл анық ұнатпау сияқты көрінді ме?
Dialogue: 0,0:11:41.53,0:11:45.07,Default,,0000,0000,0000,,Джинджи мырза да
Dialogue: 0,0:11:41.53,0:11:45.07,Default,,0000,0000,0000,,Өміріңде —
Dialogue: 0,0:11:41.53,0:11:45.07,Default,,0000,0000,0000,,Сіз шынымен түсінбейсіз.
Dialogue: 0,0:11:41.53,0:11:45.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:45.07,0:11:49.64,Default,,0000,0000,0000,,Фестивальді тоқтатуға тырысқанда
Dialogue: 0,0:11:45.07,0:11:49.64,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:11:45.07,0:11:49.64,Default,,0000,0000,0000,,Ол кісі мені құтқарды.
Dialogue: 0,0:11:45.07,0:11:49.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:49.64,0:11:53.55,Default,,0000,0000,0000,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:11:49.64,0:11:53.55,Default,,0000,0000,0000,,бірдеңе болады
Dialogue: 0,0:11:49.64,0:11:53.55,Default,,0000,0000,0000,,Мен мұны сезіндім.
Dialogue: 0,0:11:49.64,0:11:53.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:53.55,0:11:58.05,Default,,0000,0000,0000,,Гунши-доно?
Dialogue: 0,0:11:53.55,0:11:58.05,Default,,0000,0000,0000,,Сол кезде
Dialogue: 0,0:11:53.55,0:11:58.05,Default,,0000,0000,0000,,Сіз ештеңе білмеуіңіз керек еді, солай ма?
Dialogue: 0,0:11:58.05,0:12:02.02,Default,,0000,0000,0000,,Мен сияқты дәлелдерді жинаңыз
Dialogue: 0,0:11:58.05,0:12:02.02,Default,,0000,0000,0000,,Болжам жасаудың орнына➡
Dialogue: 0,0:12:02.02,0:12:05.02,Default,,0000,0000,0000,,Ауыратын сияқты нәрселер
Dialogue: 0,0:12:02.02,0:12:05.02,Default,,0000,0000,0000,,Интуицияңызды пайдаланыңыз➡
Dialogue: 0,0:12:05.02,0:12:08.03,Default,,0000,0000,0000,,Мен оны сирек шешемін
Dialogue: 0,0:12:05.02,0:12:08.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:08.03,0:12:11.56,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:12:08.03,0:12:11.56,Default,,0000,0000,0000,,Тітіркендіргіш➡
Dialogue: 0,0:12:11.56,0:12:15.13,Default,,0000,0000,0000,,Мен жалқаумын
Dialogue: 0,0:12:11.56,0:12:15.13,Default,,0000,0000,0000,,Мен өз бетіммен қозғала алмаймын.
Dialogue: 0,0:12:11.56,0:12:15.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:15.13,0:12:20.04,Default,,0000,0000,0000,,《Егер
Dialogue: 0,0:12:15.13,0:12:20.04,Default,,0000,0000,0000,,осындай қабырғаны оңай-ақ айналып өтіп кетеді
Dialogue: 0,0:12:15.13,0:12:20.04,Default,,0000,0000,0000,,Егер сіз ашық әрекет етсеңіз➡
Dialogue: 0,0:12:20.04,0:12:26.05,Default,,0000,0000,0000,,Жаңғыру
Dialogue: 0,0:12:20.04,0:12:26.05,Default,,0000,0000,0000,,Қазір туралы
Dialogue: 0,0:12:20.04,0:12:26.05,Default,,0000,0000,0000,,Қайта тірілу эликсирі
Dialogue: 0,0:12:20.04,0:12:26.05,Default,,0000,0000,0000,,Қолда болуы мүмкін…》
Dialogue: 0,0:12:26.05,0:12:28.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:28.05,0:12:31.05,Default,,0000,0000,0000,,《Мен білемін
Dialogue: 0,0:12:28.05,0:12:31.05,Default,,0000,0000,0000,,Бұл қызғаныш》
Dialogue: 0,0:12:31.05,0:12:34.05,Default,,0000,0000,0000,,《Менің әкем
Dialogue: 0,0:12:31.05,0:12:34.05,Default,,0000,0000,0000,,Ештеңе айтпай мақтасам да➡
Dialogue: 0,0:12:34.05,0:12:38.59,Default,,0000,0000,0000,,Ол кісі өзінің құтты талантын пайдаланды
Dialogue: 0,0:12:34.05,0:12:38.59,Default,,0000,0000,0000,,Мен білмеймін》
Dialogue: 0,0:12:38.59,0:12:41.13,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:12:38.59,0:12:41.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:41.13,0:12:45.56,Default,,0000,0000,0000,,Мен сені одақтас ете алмаймын, бірақ
Dialogue: 0,0:12:41.13,0:12:45.56,Default,,0000,0000,0000,,Оны өзіңе жау қылмағаның дұрыс.
Dialogue: 0,0:12:41.13,0:12:45.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:45.56,0:12:48.53,Default,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:12:45.56,0:12:48.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:48.53,0:12:50.54,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:12:50.54,0:12:53.54,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:12:50.54,0:12:53.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:50.54,0:12:53.54,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:12:50.54,0:12:53.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:50.54,0:12:53.54,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:12:50.54,0:12:53.54,Default,,0000,0000,0000,,Әлемде➡
Dialogue: 0,0:12:53.54,0:12:58.04,Default,,0000,0000,0000,,Сіз қандай әкені жақсы көріп, жек көре аласыз?
Dialogue: 0,0:12:53.54,0:12:58.04,Default,,0000,0000,0000,,Жоқ деп есептеңіз
Dialogue: 0,0:12:53.54,0:12:58.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:58.04,0:13:00.01,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:12:58.04,0:13:00.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:05.02,0:13:07.52,Default,,0000,0000,0000,,《Ішкі сарайға оралғаннан кейін бірнеше күннен кейін➡
Dialogue: 0,0:13:07.52,0:13:10.52,Default,,0000,0000,0000,,Не-чан
Dialogue: 0,0:13:07.52,0:13:10.52,Default,,0000,0000,0000,,Кури
Dialogue: 0,0:13:07.52,0:13:10.52,Default,,0000,0000,0000,,Мэй Мэй Сяоцзиден хат келді》
Dialogue: 0,0:13:10.52,0:13:15.03,Default,,0000,0000,0000,,《Ішінде
Dialogue: 0,0:13:10.52,0:13:15.03,Default,,0000,0000,0000,,Кімді кім төледі?
Dialogue: 0,0:13:10.52,0:13:15.03,Default,,0000,0000,0000,,Жазбаша хат және ➡
Dialogue: 0,0:13:15.03,0:13:18.13,Default,,0000,0000,0000,,Фин
Dialogue: 0,0:13:15.03,0:13:18.13,Default,,0000,0000,0000,,Ішінде әдемі мата бар еді.
Dialogue: 0,0:13:18.13,0:13:20.13,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:18.13,0:13:20.13,Default,,0000,0000,0000,,Умеуме
Dialogue: 0,0:13:18.13,0:13:20.13,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:18.13,0:13:20.13,Default,,0000,0000,0000,,｟Жарайды ма?
Dialogue: 0,0:13:18.13,0:13:20.13,Default,,0000,0000,0000,,мысық мысық｠
Dialogue: 0,0:13:20.13,0:13:24.17,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:20.13,0:13:24.17,Default,,0000,0000,0000,,Умеуме
Dialogue: 0,0:13:20.13,0:13:24.17,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:20.13,0:13:24.17,Default,,0000,0000,0000,,｟Мен өтелген кезде
Dialogue: 0,0:13:20.13,0:13:24.17,Default,,0000,0000,0000,,Дұрыс билеңіз｠
Dialogue: 0,0:13:24.17,0:13:25.67,Default,,0000,0000,0000,,｟Hehehe…｠
Dialogue: 0,0:13:31.54,0:13:36.52,Default,,0000,0000,0000,,《Шын мәнінде
Dialogue: 0,0:13:31.54,0:13:36.52,Default,,0000,0000,0000,,Мен Мисс Мэй Мейді жібергім келді.
Dialogue: 0,0:13:38.05,0:13:43.06,Default,,0000,0000,0000,,《Басқалардан да кіндік
Dialogue: 0,0:13:38.05,0:13:43.06,Default,,0000,0000,0000,,Сол жезөкше...》
Dialogue: 0,0:13:51.56,0:14:11.55,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:11.55,0:14:31.64,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:31.64,0:14:51.52,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:51.52,0:15:11.54,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:11.54,0:15:31.56,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:31.56,0:15:51.52,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:51.52,0:15:56.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:56.02,0:16:01.03,Default,,0000,0000,0000,,《Күтпеген жерден
Dialogue: 0,0:15:56.02,0:16:01.03,Default,,0000,0000,0000,,Менің есімде...》
Dialogue: 0,0:16:01.03,0:16:02.53,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:16:01.03,0:16:02.53,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:16:01.03,0:16:02.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:02.53,0:16:04.06,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:02.53,0:16:04.06,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:04.06,0:16:05.56,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:16:12.50,0:16:15.54,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:12.50,0:16:15.54,Default,,0000,0000,0000,,Джинджи мырза?
Dialogue: 0,0:16:15.54,0:16:18.04,Default,,0000,0000,0000,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:16:15.54,0:16:18.04,Default,,0000,0000,0000,,Сіз осындасыз ба?
Dialogue: 0,0:16:18.04,0:16:20.51,Default,,0000,0000,0000,,Тағы бір оғаш әйел
Dialogue: 0,0:16:18.04,0:16:20.51,Default,,0000,0000,0000,,Сыртқы қабырғада
Dialogue: 0,0:16:18.04,0:16:20.51,Default,,0000,0000,0000,,Тауға көтерілу кезінде➡
Dialogue: 0,0:16:20.51,0:16:23.52,Default,,0000,0000,0000,,Есепті алған кезде
Dialogue: 0,0:16:20.51,0:16:23.52,Default,,0000,0000,0000,,Онымен күресуден басқа амалымыз жоқ.
Dialogue: 0,0:16:20.51,0:16:23.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:23.52,0:16:26.02,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:23.52,0:16:26.02,Default,,0000,0000,0000,,Сыбырда
Dialogue: 0,0:16:23.52,0:16:26.02,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:23.52,0:16:26.02,Default,,0000,0000,0000,,Жасырын
Dialogue: 0,0:16:23.52,0:16:26.02,Default,,0000,0000,0000,,Мен мұны істеп жүрдім
Dialogue: 0,0:16:23.52,0:16:26.02,Default,,0000,0000,0000,,Бұл менің ниетім еді➡
Dialogue: 0,0:16:26.02,0:16:28.05,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:16:26.02,0:16:28.05,Default,,0000,0000,0000,,Сізді анықтай аласыз ба?
Dialogue: 0,0:16:26.02,0:16:28.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:28.05,0:16:29.09,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:29.09,0:16:31.12,Default,,0000,0000,0000,,Оны қиындыққа айналдырмаңыз
Dialogue: 0,0:16:29.09,0:16:31.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:31.12,0:16:33.53,Default,,0000,0000,0000,,Жолыңнан кет
Dialogue: 0,0:16:31.12,0:16:33.53,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:16:31.12,0:16:33.53,Default,,0000,0000,0000,,Тіпті сіз жоқ болсаңыз да➡
Dialogue: 0,0:16:33.53,0:16:37.03,Default,,0000,0000,0000,,Басқа біреу келсе жақсы емес пе?
Dialogue: 0,0:16:37.03,0:16:40.03,Default,,0000,0000,0000,,Мейірімді күзетші
Dialogue: 0,0:16:37.03,0:16:40.03,Default,,0000,0000,0000,,Мен сіздің жүзіңізді білемін➡
Dialogue: 0,0:16:40.03,0:16:42.53,Default,,0000,0000,0000,,Мен мұнда сенімен сөйлесу үшін келдім.
Dialogue: 0,0:16:40.03,0:16:42.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:42.53,0:16:44.54,Default,,0000,0000,0000,,Сіз мұны анық істеп жатырмын деп ойласаңыз да➡
Dialogue: 0,0:16:44.54,0:16:47.04,Default,,0000,0000,0000,,Айналасында
Dialogue: 0,0:16:44.54,0:16:47.04,Default,,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:16:44.54,0:16:47.04,Default,,0000,0000,0000,,Есте сақта
Dialogue: 0,0:16:44.54,0:16:47.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:47.04,0:16:48.57,Default,,0000,0000,0000,,Бакуго жеңіске жетті!
Dialogue: 0,0:16:47.04,0:16:48.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:48.57,0:16:53.05,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:16:48.57,0:16:53.05,Default,,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:16:48.57,0:16:53.05,Default,,0000,0000,0000,,Сіздің кезегіңіз...
Dialogue: 0,0:16:48.57,0:16:53.05,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:54.51,0:16:58.52,Default,,0000,0000,0000,,Ханамачи
Dialogue: 0,0:16:54.51,0:16:58.52,Default,,0000,0000,0000,,Қызыл жарық ауданында
Dialogue: 0,0:16:54.51,0:16:58.52,Default,,0000,0000,0000,,Құтқарылған жезөкшені ұзатқанда➡
Dialogue: 0,0:16:58.52,0:17:02.55,Default,,0000,0000,0000,,Басқа куртизандар билейді
Dialogue: 0,0:16:58.52,0:17:02.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:02.55,0:17:04.02,Default,,0000,0000,0000,,Не ол?
Dialogue: 0,0:17:04.02,0:17:08.03,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:17:04.02,0:17:08.03,Default,,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,0:17:04.02,0:17:08.03,Default,,0000,0000,0000,,Мен билей аламын деп ойладым.
Dialogue: 0,0:17:04.02,0:17:08.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:10.06,0:17:14.13,Default,,0000,0000,0000,,Негізгі білімнің бірі ретінде
Dialogue: 0,0:17:10.06,0:17:14.13,Default,,0000,0000,0000,,Мен үйрендім
Dialogue: 0,0:17:10.06,0:17:14.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:14.13,0:17:19.54,Default,,0000,0000,0000,,(Есік ашылу дыбысы)
Dialogue: 0,0:17:14.13,0:17:19.54,Default,,0000,0000,0000,,Бұл сырттағы өсек еді.
Dialogue: 0,0:17:14.13,0:17:19.54,Default,,0000,0000,0000,,Бұл оғаш жезөкше сатып алғанда,
Dialogue: 0,0:17:14.13,0:17:19.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:19.54,0:17:21.51,Default,,0000,0000,0000,,(Танжиро) Ал, баста! (Үшеуі) Бар күшіңді сал!
Dialogue: 0,0:17:19.54,0:17:21.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:21.51,0:17:23.54,Default,,0000,0000,0000,,Маған демалыс туралы хабарлама да берілді.
Dialogue: 0,0:17:21.51,0:17:23.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:23.54,0:17:26.51,Default,,0000,0000,0000,,Ол 10 күн демалуды жоспарлап отырған көрінеді.
Dialogue: 0,0:17:23.54,0:17:26.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:26.51,0:17:31.55,Default,,0000,0000,0000,,Бұл шынымен тітіркендіргіш.
Dialogue: 0,0:17:26.51,0:17:31.55,Default,,0000,0000,0000,,Әне
Dialogue: 0,0:17:26.51,0:17:31.55,Default,,0000,0000,0000,,Бұл кішкентай апаның хатында жазылған.
Dialogue: 0,0:17:26.51,0:17:31.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:31.55,0:17:36.06,Default,,0000,0000,0000,,Үш күн мен үш түн ғана емес.
Dialogue: 0,0:17:31.55,0:17:36.06,Default,,0000,0000,0000,,Утаж
Dialogue: 0,0:17:31.55,0:17:36.06,Default,,0000,0000,0000,,7 күн және 7 түн
Dialogue: 0,0:17:31.55,0:17:36.06,Default,,0000,0000,0000,,Той болатын сияқты.
Dialogue: 0,0:17:31.55,0:17:36.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:36.06,0:17:40.13,Default,,0000,0000,0000,,《Фидия ретінде
Dialogue: 0,0:17:36.06,0:17:40.13,Default,,0000,0000,0000,,Мен қанша жұмсағанымды білмеймін➡
Dialogue: 0,0:17:40.13,0:17:42.53,Default,,0000,0000,0000,,Андон
Dialogue: 0,0:17:40.13,0:17:42.53,Default,,0000,0000,0000,,Енді ұшайық➡
Dialogue: 0,0:17:42.53,0:17:45.53,Default,,0000,0000,0000,,Сол жерде
Dialogue: 0,0:17:42.53,0:17:45.53,Default,,0000,0000,0000,,Бұл жезөкшенің ақысына тең келмейді.
Dialogue: 0,0:17:45.53,0:17:51.04,Default,,0000,0000,0000,,《Алайда
Dialogue: 0,0:17:45.53,0:17:51.04,Default,,0000,0000,0000,,Құтқарылған жезөкше
Dialogue: 0,0:17:45.53,0:17:51.04,Default,,0000,0000,0000,,Ол ешқашан көпшілікке көрінбейді》
Dialogue: 0,0:17:51.04,0:17:53.04,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:51.04,0:17:53.04,Default,,0000,0000,0000,,Жезөкшелердің күлкілері
Dialogue: 0,0:17:51.04,0:17:53.04,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:53.04,0:17:56.54,Default,,0000,0000,0000,,《Рёкусейкан туралы ғана қауесеттер бар.
Dialogue: 0,0:17:53.04,0:17:56.54,Default,,0000,0000,0000,,Үлкенірек болыңыз》
Dialogue: 0,0:17:56.54,0:18:00.08,Default,,0000,0000,0000,,《Ятебаба істегісі келетіндей》
Dialogue: 0,0:18:00.08,0:18:04.65,Default,,0000,0000,0000,,Солай болса да, әскери қолбасшы
Dialogue: 0,0:18:00.08,0:18:04.65,Default,,0000,0000,0000,,Мәңгілік шың тек менікі
Dialogue: 0,0:18:00.08,0:18:04.65,Default,,0000,0000,0000,,Кімді құрбандыққа шалдың?
Dialogue: 0,0:18:04.65,0:18:07.05,Default,,0000,0000,0000,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:18:04.65,0:18:07.05,Default,,0000,0000,0000,,Қызық, бұл кім?
Dialogue: 0,0:18:04.65,0:18:07.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:07.05,0:18:09.05,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:18:09.05,0:18:12.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:18:09.05,0:18:12.52,Default,,0000,0000,0000,,Қарапайым оқуда
Dialogue: 0,0:18:09.05,0:18:12.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:18:09.05,0:18:12.52,Default,,0000,0000,0000,,Кез келген сұлулық
Dialogue: 0,0:18:09.05,0:18:12.52,Default,,0000,0000,0000,,Джинджи мырзаға
Dialogue: 0,0:18:09.05,0:18:12.52,Default,,0000,0000,0000,,Бұл болмайды.
Dialogue: 0,0:18:09.05,0:18:12.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:12.52,0:18:14.53,Default,,0000,0000,0000,,Бұл жауап болмаса да
Dialogue: 0,0:18:12.52,0:18:14.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:14.53,0:18:17.03,Default,,0000,0000,0000,,《Оны жоққа шығармайсың ба?》
Dialogue: 0,0:18:17.03,0:18:22.57,Default,,0000,0000,0000,,《Ол кісі төлемге алған әйел
Dialogue: 0,0:18:17.03,0:18:22.57,Default,,0000,0000,0000,,Бұл ұзаққа созылмайды》
Dialogue: 0,0:18:22.57,0:18:24.57,Default,,0000,0000,0000,,Джиро
Dialogue: 0,0:18:22.57,0:18:24.57,Default,,0000,0000,0000,,《Гарнизонда болған кезімде➡
Dialogue: 0,0:18:24.57,0:18:28.54,Default,,0000,0000,0000,,Мені дүниеге әкелген әйелдің оқиғасы
Dialogue: 0,0:18:24.57,0:18:28.54,Default,,0000,0000,0000,,Мен бұл туралы ешқашан естіген емеспін》
Dialogue: 0,0:18:28.54,0:18:32.51,Default,,0000,0000,0000,,«Мен сенімдімін
Dialogue: 0,0:18:28.54,0:18:32.51,Default,,0000,0000,0000,,Яри Тебаба
Dialogue: 0,0:18:28.54,0:18:32.51,Default,,0000,0000,0000,,Ол аузын жапқан болуы керек.
Dialogue: 0,0:18:32.51,0:18:34.51,Default,,0000,0000,0000,,《Алайда
Dialogue: 0,0:18:32.51,0:18:34.51,Default,,0000,0000,0000,,Мұндай әңгіме➡
Dialogue: 0,0:18:34.51,0:18:37.55,Default,,0000,0000,0000,,Кішкене нәрседен
Dialogue: 0,0:18:34.51,0:18:37.55,Default,,0000,0000,0000,,Бұл сыртқа ағып жатқан нәрсе.
Dialogue: 0,0:18:37.55,0:18:42.52,Default,,0000,0000,0000,,《Гокусейкан
Dialogue: 0,0:18:37.55,0:18:42.52,Default,,0000,0000,0000,,Құлаудың себебі болды
Dialogue: 0,0:18:37.55,0:18:42.52,Default,,0000,0000,0000,,Менде бар》
Dialogue: 0,0:18:42.52,0:18:45.06,Default,,0000,0000,0000,,《Мұрнымды сағынғаныма ұялдым➡
Dialogue: 0,0:18:45.06,0:18:50.13,Default,,0000,0000,0000,,Ол өзінен алшақтап жатқанын айтты.
Dialogue: 0,0:18:45.06,0:18:50.13,Default,,0000,0000,0000,,Әйел кім...》
Dialogue: 0,0:18:50.13,0:18:54.63,Default,,0000,0000,0000,,《Сол қорқынышты түс
Dialogue: 0,0:18:50.13,0:18:54.63,Default,,0000,0000,0000,,Бұл шынымен болды...》
Dialogue: 0,0:18:57.04,0:19:00.04,Default,,0000,0000,0000,,《Әйелдің анасы болғаным есімде жоқ》
Dialogue: 0,0:19:00.04,0:19:02.91,Default,,0000,0000,0000,,«Қазір бізде бар нәрсе
Dialogue: 0,0:19:00.04,0:19:02.91,Default,,0000,0000,0000,,Жай ғана бұрмаланған кішкентай саусақ》
Dialogue: 0,0:19:05.51,0:19:08.51,Default,,0000,0000,0000,,《Оның енді маған еш қатысы жоқ》
Dialogue: 0,0:19:08.51,0:19:13.55,Default,,0000,0000,0000,,《Рамонның қызы ретінде
Dialogue: 0,0:19:08.51,0:19:13.55,Default,,0000,0000,0000,,Себебі мен бақытты болдым》
Dialogue: 0,0:19:13.55,0:19:16.52,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:19:13.55,0:19:16.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:13.55,0:19:16.52,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:19:18.16,0:19:22.53,Default,,0000,0000,0000,,Саусағыңыздың ұшы
Dialogue: 0,0:19:18.16,0:19:22.53,Default,,0000,0000,0000,,Сіз оны кесіп тастасаңыз да
Dialogue: 0,0:19:18.16,0:19:22.53,Default,,0000,0000,0000,,Ол өседі.
Dialogue: 0,0:19:18.16,0:19:22.53,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:19:18.16,0:19:22.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:22.53,0:19:24.53,Default,,0000,0000,0000,,Көп емес екен, иә?
Dialogue: 0,0:19:22.53,0:19:24.53,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:19:24.53,0:19:26.53,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:24.53,0:19:26.53,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:24.53,0:19:26.53,Default,,0000,0000,0000,,(
Dialogue: 0,0:19:24.53,0:19:26.53,Default,,0000,0000,0000,,Етекті көтеру дыбысы
Dialogue: 0,0:19:24.53,0:19:26.53,Default,,0000,0000,0000,,)
Dialogue: 0,0:19:26.53,0:19:28.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:28.03,0:19:32.04,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:19:28.03,0:19:32.04,Default,,0000,0000,0000,,Не істеп жатырсың?!
Dialogue: 0,0:19:28.03,0:19:32.04,Default,,0000,0000,0000,,Жара ашылды.
Dialogue: 0,0:19:28.03,0:19:32.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:32.04,0:19:34.04,Default,,0000,0000,0000,,Бұл ашық, солай ма?
Dialogue: 0,0:19:34.04,0:19:37.54,Default,,0000,0000,0000,,Өйткені мен биледім
Dialogue: 0,0:19:34.04,0:19:37.54,Default,,0000,0000,0000,,Қызық, денем қызып бара жатыр ма?
Dialogue: 0,0:19:34.04,0:19:37.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:37.54,0:19:42.08,Default,,0000,0000,0000,,Бұл есірткі эксперименттеріне байланысты ма?
Dialogue: 0,0:19:37.54,0:19:42.08,Default,,0000,0000,0000,,Әйтеуір, менің ауырсыну сезімім түтіккен.
Dialogue: 0,0:19:37.54,0:19:42.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:42.08,0:19:43.62,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:19:42.08,0:19:43.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:43.62,0:19:46.52,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:19:43.62,0:19:46.52,Default,,0000,0000,0000,,Мен оны бірден тігемін.
Dialogue: 0,0:19:43.62,0:19:46.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:46.52,0:19:48.02,Default,,0000,0000,0000,,Қалғанын саған қалдырамын.
Dialogue: 0,0:19:48.02,0:19:52.52,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:19:48.02,0:19:52.52,Default,,0000,0000,0000,,Мен тіге алмаймын.
Dialogue: 0,0:19:48.02,0:19:52.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:48.02,0:19:52.52,Default,,0000,0000,0000,,​​Мұнда тігуге болмайды!
Dialogue: 0,0:19:52.52,0:19:55.03,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:52.52,0:19:55.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:55.03,0:19:56.53,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:19:56.53,0:19:58.53,Default,,0000,0000,0000,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:20:01.03,0:20:04.57,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:20:01.03,0:20:04.57,Default,,0000,0000,0000,,Джинши…
Dialogue: 0,0:20:01.03,0:20:04.57,Default,,0000,0000,0000,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,0:20:01.03,0:20:04.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:04.57,0:20:08.14,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:20:04.57,0:20:08.14,Default,,0000,0000,0000,,Оны қойыңыз.
Dialogue: 0,0:20:04.57,0:20:08.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:08.14,0:20:10.54,Default,,0000,0000,0000,,Жара кеңейеді.
Dialogue: 0,0:20:08.14,0:20:10.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:10.54,0:20:13.55,Default,,0000,0000,0000,,Егер сізді біреу көрсе
Dialogue: 0,0:20:10.54,0:20:13.55,Default,,0000,0000,0000,,Сіз не істемексіз?
Dialogue: 0,0:20:13.55,0:20:16.52,Default,,0000,0000,0000,,Бәрібір көру мүмкін емес тым қараңғы.
Dialogue: 0,0:20:13.55,0:20:16.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:16.52,0:20:20.02,Default,,0000,0000,0000,,Юкине-кун, барсың ба?
Dialogue: 0,0:20:16.52,0:20:20.02,Default,,0000,0000,0000,,Тасымалдау тәсілі осылай
Dialogue: 0,0:20:16.52,0:20:20.02,Default,,0000,0000,0000,,Бұл екінші рет.
Dialogue: 0,0:20:16.52,0:20:20.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:20.02,0:20:24.02,Default,,0000,0000,0000,,《Жарақатымның кесірінен есін жоғалттым.
Dialogue: 0,0:20:20.02,0:20:24.02,Default,,0000,0000,0000,,Сол кезде...》
Dialogue: 0,0:20:24.02,0:20:26.53,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:20:24.02,0:20:26.53,Default,,0000,0000,0000,,Джинджи мырза➡
Dialogue: 0,0:20:26.53,0:20:29.09,Default,,0000,0000,0000,,Осындай кездерде
Dialogue: 0,0:20:26.53,0:20:29.09,Default,,0000,0000,0000,,Кешіріңіз➡
Dialogue: 0,0:20:29.09,0:20:32.03,Default,,0000,0000,0000,,Мен көптен бері айтуды ұмытып кеткен бір нәрсе
Dialogue: 0,0:20:29.09,0:20:32.03,Default,,0000,0000,0000,,болды
Dialogue: 0,0:20:29.09,0:20:32.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:32.03,0:20:35.03,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:20:32.03,0:20:35.03,Default,,0000,0000,0000,,Кенеттен өзгерді
Dialogue: 0,0:20:32.03,0:20:35.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:35.03,0:20:37.50,Default,,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:20:35.03,0:20:37.50,Default,,0000,0000,0000,,Айтуға тура келеді➡
Dialogue: 0,0:20:37.50,0:20:40.04,Default,,0000,0000,0000,,Бұл маңызды болды...
Dialogue: 0,0:20:37.50,0:20:40.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:40.04,0:20:46.51,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:46.51,0:20:49.51,Default,,0000,0000,0000,,Маған қазір айта аласыз ба?
Dialogue: 0,0:20:51.62,0:20:53.52,Default,,0000,0000,0000,,Джинджи мырза…
Dialogue: 0,0:20:51.62,0:20:53.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:53.52,0:20:59.52,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:59.52,0:21:02.03,Default,,0000,0000,0000,,Гу
Dialogue: 0,0:20:59.52,0:21:02.03,Default,,0000,0000,0000,,Маған сиыр етінің сарысын беріңіз
Dialogue: 0,0:20:59.52,0:21:02.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:02.03,0:21:04.53,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:21:02.03,0:21:04.53,Default,,0000,0000,0000,,Няня...!
Dialogue: 0,0:21:04.53,0:21:06.53,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:21:04.53,0:21:06.53,Default,,0000,0000,0000,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:21:06.53,0:21:08.03,Default,,0000,0000,0000,,Реми мұнда әрдайым мен үшін терезені ашады, білесің бе.
Dialogue: 0,0:21:06.53,0:21:08.03,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:21:08.03,0:21:10.54,Default,,0000,0000,0000,,Мен оны әлі дайындағаныма сене алар емеспін.
Dialogue: 0,0:21:08.03,0:21:10.54,Default,,0000,0000,0000,,Бұл?
Dialogue: 0,0:21:10.54,0:21:13.11,Default,,0000,0000,0000,,Дөрекі нәрселерді қалдырмаңыз!
Dialogue: 0,0:21:13.11,0:21:15.14,Default,,0000,0000,0000,,Мүлдем емес...
Dialogue: 0,0:21:13.11,0:21:15.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:15.14,0:21:18.64,Default,,0000,0000,0000,,《Кенеттен бас ұру дегеніміз не?
Dialogue: 0,0:21:15.14,0:21:18.64,Default,,0000,0000,0000,,жетілмеген》
Dialogue: 0,0:21:20.51,0:21:24.05,Default,,0000,0000,0000,,《Бірақ
Dialogue: 0,0:21:20.51,0:21:24.05,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:21:20.51,0:21:24.05,Default,,0000,0000,0000,,Жетілмеген жақсы➡
Dialogue: 0,0:21:24.05,0:21:27.02,Default,,0000,0000,0000,,Біз сөйлескенде мен өзімді еркін сезінемін.
Dialogue: 0,0:21:27.02,0:21:38.53,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:40.07,0:21:42.60,Default,,0000,0000,0000,,Ммм
Dialogue: 0,0:21:40.07,0:21:42.60,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:21:40.07,0:21:42.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:42.60,0:21:46.04,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:21:42.60,0:21:46.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:46.04,0:21:48.01,Default,,0000,0000,0000,,Инфа
Dialogue: 0,0:21:46.04,0:21:48.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:21:46.04,0:21:48.01,Default,,0000,0000,0000,,Сакурака
Dialogue: 0,0:21:46.04,0:21:48.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:21:46.04,0:21:48.01,Default,,0000,0000,0000,,⚟Мысық мысық! ⚞
Dialogue: 0,0:21:46.04,0:21:48.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:48.01,0:21:50.51,Default,,0000,0000,0000,,⚟Мистер
Dialogue: 0,0:21:48.01,0:21:50.51,Default,,0000,0000,0000,,Сіз осындасыз! ⚞
Dialogue: 0,0:21:50.51,0:21:52.01,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:50.51,0:21:52.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:52.01,0:21:54.51,Default,,0000,0000,0000,,Гёкуюхи
Dialogue: 0,0:21:52.01,0:21:54.51,Default,,0000,0000,0000,,(
Dialogue: 0,0:21:52.01,0:21:54.51,Default,,0000,0000,0000,,Гёкуйо ханшайымы
Dialogue: 0,0:21:52.01,0:21:54.51,Default,,0000,0000,0000,,)
Dialogue: 0,0:21:52.01,0:21:54.51,Default,,0000,0000,0000,,Сондықтан мен сол болашақты өзгерту үшін өткенге ораламын.
Dialogue: 0,0:21:52.01,0:21:54.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:54.51,0:21:58.02,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:21:54.51,0:21:58.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:54.51,0:21:58.02,Default,,0000,0000,0000,,(
Dialogue: 0,0:21:54.51,0:21:58.02,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:21:54.51,0:21:58.02,Default,,0000,0000,0000,,)
Dialogue: 0,0:21:54.51,0:21:58.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:59.55,0:22:02.59,Default,,0000,0000,0000,,Денсаулығыңызды қалпына келтірдіңіз бе?
Dialogue: 0,0:22:02.59,0:22:06.53,Default,,0000,0000,0000,,Нефрит
Dialogue: 0,0:22:02.59,0:22:06.53,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:22:02.59,0:22:06.53,Default,,0000,0000,0000,,Нефрит сарайында
Dialogue: 0,0:22:02.59,0:22:06.53,Default,,0000,0000,0000,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:22:02.59,0:22:06.53,Default,,0000,0000,0000,,Өйткені ол сенің істеріңді жақсартады.
Dialogue: 0,0:22:02.59,0:22:06.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,Хонгнянг
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,Бени Мусуме
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:22:06.53,0:22:10.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:10.03,0:22:13.50,Default,,0000,0000,0000,,Айтпақшы
Dialogue: 0,0:22:10.03,0:22:13.50,Default,,0000,0000,0000,,Сізге қажет нәрсе бар ма?
Dialogue: 0,0:22:15.00,0:22:17.04,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:22:15.00,0:22:17.04,Default,,0000,0000,0000,,Не…➡
Dialogue: 0,0:22:17.04,0:22:22.07,Default,,0000,0000,0000,,Маған қызықты оқиға келді.
Dialogue: 0,0:22:17.04,0:22:22.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:22.07,0:22:24.64,Default,,0000,0000,0000,,Менің сенен сұрайтыным бар.
Dialogue: 0,0:22:22.07,0:22:24.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:24.64,0:22:28.11,Default,,0000,0000,0000,,《Аа~
Dialogue: 0,0:22:24.64,0:22:28.11,Default,,0000,0000,0000,,Тағы да…》
Dialogue: 0,0:22:31.02,0:22:36.52,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:22:31.02,0:22:36.52,Default,,0000,0000,0000,,Мен кіммін?
Dialogue: 0,0:22:31.02,0:22:36.52,Default,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:22:31.02,0:22:36.52,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:22:38.52,0:22:40.53,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:22:38.52,0:22:40.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:40.53,0:22:45.03,Default,,0000,0000,0000,,<Мысық пен мысық оқиғасы енді ғана басталды>
Dialogue: 0,0:22:45.03,0:22:50.04,Default,,0000,0000,0000,,<Келесі
Dialogue: 0,0:22:45.03,0:22:50.04,Default,,0000,0000,0000,,Қандай оқиға
Dialogue: 0,0:22:45.03,0:22:50.04,Default,,0000,0000,0000,,Сіз қолға түсесіз бе?
Dialogue: 0,0:22:51.54,0:22:57.54,Default,,0,0,0,,{\\an8\\fs18\\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\\NБарлық құқықтары қорғалған • github.com/ikymory
