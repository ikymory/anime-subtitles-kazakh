Dialogue: 0,0:01:36.10,0:01:38.10,Default,,0000,0000,0000,,Лакан
Dialogue: 0,0:01:36.10,0:01:38.10,Default,,0000,0000,0000,,Фэн Шэн
Dialogue: 0,0:01:36.10,0:01:38.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:01:36.10,0:01:38.10,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:01:36.10,0:01:38.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:01:36.10,0:01:38.10,Default,,0000,0000,0000,,《Хосен…》
Dialogue: 0,0:01:38.10,0:01:44.07,Default,,0000,0000,0000,,《Мен қалған қызыммен бірге болғым келеді.
Dialogue: 0,0:01:38.10,0:01:44.07,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:01:38.10,0:01:44.07,Default,,0000,0000,0000,,Бұл менің жалғыз тілегім еді》
Dialogue: 0,0:01:45.57,0:01:48.61,Default,,0000,0000,0000,,《Жек көруден пайда жоқ.》
Dialogue: 0,0:01:48.61,0:01:51.58,Default,,0000,0000,0000,,《Әлі
Dialogue: 0,0:01:48.61,0:01:51.58,Default,,0000,0000,0000,,Мен оны жанымда ұстағым келді...》
Dialogue: 0,0:01:55.65,0:01:57.08,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:01:55.65,0:01:57.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:01:57.08,0:02:02.09,Default,,0000,0000,0000,,《Алайда
Dialogue: 0,0:01:57.08,0:02:02.09,Default,,0000,0000,0000,,Шайқаста жеңілгеннен де көп
Dialogue: 0,0:01:57.08,0:02:02.09,Default,,0000,0000,0000,,Осы жолы бас тартайық》
Dialogue: 0,0:02:02.09,0:02:05.06,Default,,0000,0000,0000,,Тіпті егер
Dialogue: 0,0:02:02.09,0:02:05.06,Default,,0000,0000,0000,,Ол адам...
Dialogue: 0,0:02:02.09,0:02:05.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:05.06,0:02:10.03,Default,,0000,0000,0000,,Мен кешіре алмаймын...
Dialogue: 0,0:02:05.06,0:02:10.03,Default,,0000,0000,0000,,Матч кезінде
Dialogue: 0,0:02:05.06,0:02:10.03,Default,,0000,0000,0000,,Үш рет
Dialogue: 0,0:02:05.06,0:02:10.03,Default,,0000,0000,0000,,Қызыңыздың иығына қолыңызды қойыңыз
Dialogue: 0,0:02:05.06,0:02:10.03,Default,,0000,0000,0000,,.
