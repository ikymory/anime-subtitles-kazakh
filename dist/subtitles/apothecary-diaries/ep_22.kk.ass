Dialogue: 0,0:02:12.60,0:02:16.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:12.60,0:02:16.07,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:02:12.60,0:02:16.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:18.04,0:02:20.54,Default,,0000,0000,0000,,Ай
Dialogue: 0,0:02:18.04,0:02:20.54,Default,,0000,0000,0000,,Хэхе…
Dialogue: 0,0:02:18.04,0:02:20.54,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:02:18.04,0:02:20.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:20.54,0:02:25.55,Default,,0000,0000,0000,,《Әр күн орындалған кезде
Dialogue: 0,0:02:20.54,0:02:25.55,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:02:20.54,0:02:25.55,Default,,0000,0000,0000,,Күндер тез өтеді》
Dialogue: 0,0:02:25.55,0:02:29.05,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:02:25.55,0:02:29.05,Default,,0000,0000,0000,,《Екі ай бойы мен Джиндзи-саманың ғимаратында болдым
Dialogue: 0,0:02:25.55,0:02:29.05,Default,,0000,0000,0000,,Бұл қажетсіз ұзақ болды.
Dialogue: 0,0:02:29.05,0:02:30.55,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:30.55,0:02:32.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:30.55,0:02:32.52,Default,,0000,0000,0000,,Сузурей ханшайымы
Dialogue: 0,0:02:30.55,0:02:32.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:30.55,0:02:32.52,Default,,0000,0000,0000,,Ай
Dialogue: 0,0:02:30.55,0:02:32.52,Default,,0000,0000,0000,,Ай…
Dialogue: 0,0:02:30.55,0:02:32.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:34.59,0:02:37.12,Default,,0000,0000,0000,,Қайтадан сурет салғыңыз келе ме?
Dialogue: 0,0:02:37.12,0:02:38.63,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:02:40.06,0:02:43.56,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:40.06,0:02:43.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:40.06,0:02:43.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:40.06,0:02:43.56,Default,,0000,0000,0000,,Күңдер
Dialogue: 0,0:02:40.06,0:02:43.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:40.06,0:02:43.56,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:43.56,0:02:46.07,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:02:43.56,0:02:46.07,Default,,0000,0000,0000,,Ол Карахатсутаке деп аталады.
Dialogue: 0,0:02:43.56,0:02:46.07,Default,,0000,0000,0000,,Улы саңырауқұлақтар…
Dialogue: 0,0:02:43.56,0:02:46.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:46.07,0:02:50.07,Default,,0000,0000,0000,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:02:46.07,0:02:50.07,Default,,0000,0000,0000,,Қалыпты гүлді салыңыз
Dialogue: 0,0:02:46.07,0:02:50.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:50.07,0:02:53.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:50.07,0:02:53.07,Default,,0000,0000,0000,,Сузурей ханшайымы
Dialogue: 0,0:02:50.07,0:02:53.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:50.07,0:02:53.07,Default,,0000,0000,0000,,Ай~
Dialogue: 0,0:02:50.07,0:02:53.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:50.07,0:02:53.07,Default,,0000,0000,0000,,《Қарапайым гүл》
Dialogue: 0,0:02:53.07,0:02:54.57,Default,,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:02:53.07,0:02:54.57,Default,,0000,0000,0000,,《Ауырып тұр...》
Dialogue: 0,0:02:54.57,0:02:57.11,Default,,0000,0000,0000,,Суби
Dialogue: 0,0:02:54.57,0:02:57.11,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:54.57,0:02:57.11,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:02:54.57,0:02:57.11,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:54.57,0:02:57.11,Default,,0000,0000,0000,,Бұл көк раушан ба?
Dialogue: 0,0:02:57.11,0:03:00.65,Default,,0000,0000,0000,,Лакан
Dialogue: 0,0:02:57.11,0:03:00.65,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:57.11,0:03:00.65,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:02:57.11,0:03:00.65,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:57.11,0:03:00.65,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:02:57.11,0:03:00.65,Default,,0000,0000,0000,,Сіз білмейсіз бе?
Dialogue: 0,0:03:00.65,0:03:06.05,Default,,0000,0000,0000,,Көздің жауын алатын көк жапырақшалар
Dialogue: 0,0:03:00.65,0:03:06.05,Default,,0000,0000,0000,,Бұл әдемі, солай емес пе?
Dialogue: 0,0:03:00.65,0:03:06.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:06.05,0:03:10.06,Default,,0000,0000,0000,,Бұрын император сарайында болған
Dialogue: 0,0:03:06.05,0:03:10.06,Default,,0000,0000,0000,,Көбінесе ол тірі қалды.
Dialogue: 0,0:03:06.05,0:03:10.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:10.06,0:03:16.06,Default,,0000,0000,0000,,Түс көрдіңіз бе?
Dialogue: 0,0:03:10.06,0:03:16.06,Default,,0000,0000,0000,,Көк раушан гүлдері жоқ.
Dialogue: 0,0:03:10.06,0:03:16.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:16.06,0:03:20.07,Default,,0000,0000,0000,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:03:16.06,0:03:20.07,Default,,0000,0000,0000,,​​Бар.
Dialogue: 0,0:03:16.06,0:03:20.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:20.07,0:03:24.10,Default,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:03:20.07,0:03:24.10,Default,,0000,0000,0000,,Қайта кездескенше
Dialogue: 0,0:03:20.07,0:03:24.10,Default,,0000,0000,0000,,Мен оған таңданғым келеді.
Dialogue: 0,0:03:20.07,0:03:24.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:24.10,0:03:27.67,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:03:24.10,0:03:27.67,Default,,0000,0000,0000,,Біз бұл туралы бірдеңе істей аламыз ба?
Dialogue: 0,0:03:27.67,0:03:32.05,Default,,0000,0000,0000,,Егер сіз
Dialogue: 0,0:03:27.67,0:03:32.05,Default,,0000,0000,0000,,Орындауға болмайтын нәрселер
Dialogue: 0,0:03:27.67,0:03:32.05,Default,,0000,0000,0000,,Мүмкін емес пе?
Dialogue: 0,0:03:32.05,0:03:34.05,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:03:32.05,0:03:34.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:34.05,0:03:37.55,Default,,0000,0000,0000,,Егер мұндай раушан бар болса
Dialogue: 0,0:03:34.05,0:03:37.55,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:03:34.05,0:03:37.55,Default,,0000,0000,0000,,Мен оны көргім келеді
Dialogue: 0,0:03:34.05,0:03:37.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:37.55,0:03:39.59,Default,,0000,0000,0000,,Бұл шешілді.
Dialogue: 0,0:03:37.55,0:03:39.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:39.59,0:03:43.59,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:03:39.59,0:03:43.59,Default,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:03:39.59,0:03:43.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:43.59,0:03:45.56,Default,,0000,0000,0000,,Олай болса
Dialogue: 0,0:03:43.59,0:03:45.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:48.60,0:03:51.56,Default,,0000,0000,0000,,Келесі айдағы бақша кешінде
Dialogue: 0,0:03:48.60,0:03:51.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:53.17,0:03:54.57,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:03:53.17,0:03:54.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:54.57,0:03:59.07,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:03:54.57,0:03:59.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:54.57,0:03:59.07,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:03:54.57,0:03:59.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:54.57,0:03:59.07,Default,,0000,0000,0000,,Біз алғаш кездескенде түн бойы
Dialogue: 0,0:03:54.57,0:03:59.07,Default,,0000,0000,0000,,Сіз бос емес болсаңыз да.
Dialogue: 0,0:03:54.57,0:03:59.07,Default,,0000,0000,0000,,Қосымша жобалармен айналысудың қажеті жоқ
Dialogue: 0,0:03:54.57,0:03:59.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:59.07,0:04:03.58,Default,,0000,0000,0000,,Деме...
Dialogue: 0,0:03:59.07,0:04:03.58,Default,,0000,0000,0000,,Әзірге
Dialogue: 0,0:03:59.07,0:04:03.58,Default,,0000,0000,0000,,Бүкіл ел бойынша гүл дүкендерін ұтып алыңыз.
Dialogue: 0,0:03:59.07,0:04:03.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:09.05,0:04:14.65,Default,,0000,0000,0000,,Гүл өсіруші әңгімесінде
Dialogue: 0,0:04:09.05,0:04:14.65,Default,,0000,0000,0000,,Қазір раушан гүлінің мезгілі емес.
Dialogue: 0,0:04:09.05,0:04:14.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:14.65,0:04:16.56,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:04:14.65,0:04:16.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:16.56,0:04:19.53,Default,,0000,0000,0000,,Кенеттен маған қоңырау шалыңыз
Dialogue: 0,0:04:16.56,0:04:19.53,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:04:16.56,0:04:19.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:21.53,0:04:26.03,Default,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:04:21.53,0:04:26.03,Default,,0000,0000,0000,,Келесі жолы
Dialogue: 0,0:04:21.53,0:04:26.03,Default,,0000,0000,0000,,Бәріміз көк раушан гүлдеріне тамсанайық
Dialogue: 0,0:04:21.53,0:04:26.03,Default,,0000,0000,0000,,Бұл болды
Dialogue: 0,0:04:21.53,0:04:26.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:26.03,0:04:30.07,Default,,0000,0000,0000,,Көк раушан?
Dialogue: 0,0:04:26.03,0:04:30.07,Default,,0000,0000,0000,,Мен фармацевтпін.
Dialogue: 0,0:04:26.03,0:04:30.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:30.07,0:04:32.57,Default,,0000,0000,0000,,О
Dialogue: 0,0:04:30.07,0:04:32.57,Default,,0000,0000,0000,,Мен білемін...
Dialogue: 0,0:04:30.07,0:04:32.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:32.57,0:04:38.14,Default,,0000,0000,0000,,《Себебі бар ма?
Dialogue: 0,0:04:32.57,0:04:38.14,Default,,0000,0000,0000,,Мен қатты шаршадым.
Dialogue: 0,0:04:38.14,0:04:42.55,Default,,0000,0000,0000,,«Раушан?»
Dialogue: 0,0:04:38.14,0:04:42.55,Default,,0000,0000,0000,,Менің біраз білімім бар.
Dialogue: 0,0:04:42.55,0:04:47.05,Default,,0000,0000,0000,,Джиджо
Dialogue: 0,0:04:42.55,0:04:47.05,Default,,0000,0000,0000,,《Жезөкшелермен араласып, қалтаңа ақша тап.
Dialogue: 0,0:04:42.55,0:04:47.05,Default,,0000,0000,0000,,Мен онымен айналыстым》
Dialogue: 0,0:04:47.05,0:04:48.55,Default,,0000,0000,0000,,Бірақ Стрикстің мақсаты – Десмондпен үздіксіз байланыс орнату
Dialogue: 0,0:04:48.55,0:04:51.52,Default,,0000,0000,0000,,Сіз шынымен көк раушан гүлін көрдіңіз бе?
Dialogue: 0,0:04:51.52,0:04:53.03,Default,,0000,0000,0000,,О
Dialogue: 0,0:04:51.52,0:04:53.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:54.53,0:04:57.03,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:04:54.53,0:04:57.03,Default,,0000,0000,0000,,Галлюциногендер танымал бола ма?
Dialogue: 0,0:04:57.03,0:04:59.60,Default,,0000,0000,0000,,Бұндай істер жалғаса берсе, ел жойылады!
Dialogue: 0,0:04:59.60,0:05:01.63,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:04:59.60,0:05:01.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:01.63,0:05:03.57,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:05:01.63,0:05:03.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:03.57,0:05:06.04,Default,,0000,0000,0000,,Бұл мүмкін емес пе?
Dialogue: 0,0:05:08.04,0:05:12.05,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:05:08.04,0:05:12.05,Default,,0000,0000,0000,,Қалай
Dialogue: 0,0:05:08.04,0:05:12.05,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:05:12.05,0:05:15.05,Default,,0000,0000,0000,,Оны келесі айдағы бақша кешіне дайындай аласыз ба?
Dialogue: 0,0:05:15.05,0:05:17.55,Default,,0000,0000,0000,,Келесі айда?
Dialogue: 0,0:05:15.05,0:05:17.55,Default,,0000,0000,0000,,Раушан гүлдер гүлдейді➡
Dialogue: 0,0:05:17.55,0:05:20.59,Default,,0000,0000,0000,,Кем дегенде
Dialogue: 0,0:05:17.55,0:05:20.59,Default,,0000,0000,0000,,Екі айдан астам уақыт қалды.
Dialogue: 0,0:05:17.55,0:05:20.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:20.59,0:05:22.62,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:05:20.59,0:05:22.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:22.62,0:05:25.06,Default,,0000,0000,0000,,Жоқ деп айтуым керек...
Dialogue: 0,0:05:22.62,0:05:25.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:25.06,0:05:26.56,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:25.06,0:05:26.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:26.56,0:05:29.06,Default,,0000,0000,0000,,《Джиндзи-саманың
Dialogue: 0,0:05:26.56,0:05:29.06,Default,,0000,0000,0000,,Бұл реакция》
Dialogue: 0,0:05:29.06,0:05:33.53,Default,,0000,0000,0000,,《Және мүмкін емес тапсырма
Dialogue: 0,0:05:29.06,0:05:33.53,Default,,0000,0000,0000,,Мәжбүрлеу
Dialogue: 0,0:05:29.06,0:05:33.53,Default,,0000,0000,0000,,Яригучи》
Dialogue: 0,0:05:33.53,0:05:35.54,Default,,0000,0000,0000,,Бұл оқиға
Dialogue: 0,0:05:33.53,0:05:35.54,Default,,0000,0000,0000,,Мүмкін➡
Dialogue: 0,0:05:35.54,0:05:38.54,Default,,0000,0000,0000,,Белгілі бір тактиктен
Dialogue: 0,0:05:35.54,0:05:38.54,Default,,0000,0000,0000,,Сізге жақындады ма?
Dialogue: 0,0:05:40.04,0:05:41.57,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:40.04,0:05:41.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:41.57,0:05:44.61,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:05:41.57,0:05:44.61,Default,,0000,0000,0000,,Мен сіздің өтінішіңізді қабылдаймын.
Dialogue: 0,0:05:41.57,0:05:44.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:44.61,0:05:46.65,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:05:46.65,0:05:50.05,Default,,0000,0000,0000,,Мен мұны істей алатынымды білмеймін.
Dialogue: 0,0:05:46.65,0:05:50.05,Default,,0000,0000,0000,,Мен мүмкіндігінше тырысамын
Dialogue: 0,0:05:46.65,0:05:50.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:50.05,0:05:53.02,Default,,0000,0000,0000,,《Тек қашу ашуландырады.》
Dialogue: 0,0:05:55.52,0:06:00.03,Default,,0000,0000,0000,,《Не болса да
Dialogue: 0,0:05:55.52,0:06:00.03,Default,,0000,0000,0000,,Бұл күлімсіреу
Dialogue: 0,0:05:55.52,0:06:00.03,Default,,0000,0000,0000,,Монокл
Dialogue: 0,0:05:55.52,0:06:00.03,Default,,0000,0000,0000,,Мен оны бөліктерге бөлемін》
Dialogue: 0,0:06:00.03,0:06:02.56,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:06:00.03,0:06:02.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:02.56,0:06:06.07,Default,,0000,0000,0000,,Біраз нәрсені сұрасам да.
Dialogue: 0,0:06:02.56,0:06:06.07,Default,,0000,0000,0000,,(Есік ашылған дыбыс) (Recovery Girl) Қарым-қатынас дағдылары
Dialogue: 0,0:06:06.07,0:06:10.14,Default,,0000,0000,0000,,Оны пайдалануға рұқсат бергеніңіз үшін рахмет.
Dialogue: 0,0:06:06.07,0:06:10.14,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:06:06.07,0:06:10.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:10.14,0:06:13.04,Default,,0000,0000,0000,,Refa
Dialogue: 0,0:06:10.14,0:06:13.04,Default,,0000,0000,0000,,Рика-сама
Dialogue: 0,0:06:10.14,0:06:13.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:10.14,0:06:13.04,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:10.14,0:06:13.04,Default,,0000,0000,0000,,Рика ханшайым
Dialogue: 0,0:06:10.14,0:06:13.04,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:10.14,0:06:13.04,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:06:10.14,0:06:13.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:13.04,0:06:16.04,Default,,0000,0000,0000,,Бұл бастапқыда болды
Dialogue: 0,0:06:13.04,0:06:16.04,Default,,0000,0000,0000,,Оның жасалуына сен себепкерсің.
Dialogue: 0,0:06:13.04,0:06:16.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:16.04,0:06:17.54,Default,,0000,0000,0000,,Сондықтан мен сол болашақты өзгерту үшін өткенге ораламын.
Dialogue: 0,0:06:16.04,0:06:17.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:17.54,0:06:19.55,Default,,0000,0000,0000,,《Сондай ностальгиялық》
Dialogue: 0,0:06:19.55,0:06:23.05,Default,,0000,0000,0000,,《Бұрын
Dialogue: 0,0:06:19.55,0:06:23.05,Default,,0000,0000,0000,,Удың құрбаны болған Рика-самаға➡
Dialogue: 0,0:06:23.05,0:06:25.05,Default,,0000,0000,0000,,Менде бу моншасы салынды.
Dialogue: 0,0:06:25.05,0:06:30.09,Default,,0000,0000,0000,,《Бұл жолы
Dialogue: 0,0:06:25.05,0:06:30.09,Default,,0000,0000,0000,,Мен мұны қарызға алғым келеді.
Dialogue: 0,0:06:25.05,0:06:30.09,Default,,0000,0000,0000,,Бұл тегін болғаны үшін кешірім сұраймын.
Dialogue: 0,0:06:30.09,0:06:33.63,Default,,0000,0000,0000,,Микадо
Dialogue: 0,0:06:30.09,0:06:33.63,Default,,0000,0000,0000,,Сау!
Dialogue: 0,0:06:30.09,0:06:33.63,Default,,0000,0000,0000,,Қолдауыңызға рахмет
Dialogue: 0,0:06:30.09,0:06:33.63,Default,,0000,0000,0000,,Бұл императордың сүйікті кітабы.
Dialogue: 0,0:06:30.09,0:06:33.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:33.63,0:06:36.13,Default,,0000,0000,0000,,Мен мұны бағалаймын.
Dialogue: 0,0:06:33.63,0:06:36.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:37.56,0:06:40.53,Default,,0000,0000,0000,,Джиро
Dialogue: 0,0:06:37.56,0:06:40.53,Default,,0000,0000,0000,,《Мен оны сот ғимаратынан бұйырдым.
Dialogue: 0,0:06:37.56,0:06:40.53,Default,,0000,0000,0000,,Жақсы》
Dialogue: 0,0:06:43.04,0:06:45.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:43.04,0:06:45.54,Default,,0000,0000,0000,,Құрылыс дыбыстары
Dialogue: 0,0:06:43.04,0:06:45.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:45.54,0:06:48.07,Default,,0000,0000,0000,,Мұны сұраңыз
Dialogue: 0,0:06:45.54,0:06:48.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:45.54,0:06:48.07,Default,,0000,0000,0000,,Канган
Dialogue: 0,0:06:45.54,0:06:48.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:45.54,0:06:48.07,Default,,0000,0000,0000,,Евнухтар
Dialogue: 0,0:06:45.54,0:06:48.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:45.54,0:06:48.07,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:48.07,0:06:51.04,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:06:48.07,0:06:51.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:48.07,0:06:51.04,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:06:48.07,0:06:51.04,Default,,0000,0000,0000,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:06:48.07,0:06:51.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:51.04,0:06:55.62,Default,,0000,0000,0000,,Айтылғандай
Dialogue: 0,0:06:51.04,0:06:55.62,Default,,0000,0000,0000,,Мен оны салдым, бірақ
Dialogue: 0,0:06:51.04,0:06:55.62,Default,,0000,0000,0000,,Біз не істейміз?
Dialogue: 0,0:06:55.62,0:06:57.65,Default,,0000,0000,0000,,Бұл раушан гүлдерін жынды етеді
Dialogue: 0,0:06:55.62,0:06:57.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:57.65,0:07:01.62,Default,,0000,0000,0000,,Раушанды жынды қылу керек пе?
Dialogue: 0,0:06:57.65,0:07:01.62,Default,,0000,0000,0000,,Келісім жасасамыз ба?
Dialogue: 0,0:06:57.65,0:07:01.62,Default,,0000,0000,0000,,Фармация
Dialogue: 0,0:06:57.65,0:07:01.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:05.06,0:07:06.53,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:05.06,0:07:06.53,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:08.53,0:07:14.03,Default,,0000,0000,0000,,Күн сәулесін кіргізіңіз
Dialogue: 0,0:07:08.53,0:07:14.03,Default,,0000,0000,0000,,Сол жерден
Dialogue: 0,0:07:08.53,0:07:14.03,Default,,0000,0000,0000,,Сарайға буды жіберіңіз
Dialogue: 0,0:07:08.53,0:07:14.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:14.03,0:07:17.54,Default,,0000,0000,0000,,Мен раушан гүлдерін жылы бөлмеде өсіремін.
Dialogue: 0,0:07:14.03,0:07:17.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:17.54,0:07:22.11,Default,,0000,0000,0000,,Гүлдер гүлденетін мезгіл
Dialogue: 0,0:07:17.54,0:07:22.11,Default,,0000,0000,0000,,Сіз қате түсінуіңіз мүмкін.
Dialogue: 0,0:07:17.54,0:07:22.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:22.11,0:07:24.61,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:07:22.11,0:07:24.61,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:07:22.11,0:07:24.61,Default,,0000,0000,0000,,Жынды болу
Dialogue: 0,0:07:22.11,0:07:24.61,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:07:22.11,0:07:24.61,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:07:22.11,0:07:24.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:24.61,0:07:27.11,Default,,0000,0000,0000,,Оның гүлденуіне кепілдік жоқ.
Dialogue: 0,0:07:24.61,0:07:27.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:34.55,0:07:36.06,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:07:34.55,0:07:36.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:37.52,0:07:39.06,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:07:37.52,0:07:39.06,Default,,0000,0000,0000,,А...
Dialogue: 0,0:07:37.52,0:07:39.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:39.06,0:07:41.06,Default,,0000,0000,0000,,Сяоран
Dialogue: 0,0:07:39.06,0:07:41.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:39.06,0:07:41.06,Default,,0000,0000,0000,,Сяоран
Dialogue: 0,0:07:39.06,0:07:41.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:39.06,0:07:41.06,Default,,0000,0000,0000,,Мысық мысық~!
Dialogue: 0,0:07:41.06,0:07:44.06,Default,,0000,0000,0000,,Сяоран?
Dialogue: 0,0:07:41.06,0:07:44.06,Default,,0000,0000,0000,,Мен де саған көмектесемін!
Dialogue: 0,0:07:44.06,0:07:47.57,Default,,0000,0000,0000,,Аяқ жарақаты
Dialogue: 0,0:07:44.06,0:07:47.57,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:07:47.57,0:07:50.04,Default,,0000,0000,0000,,《Мошия
Dialogue: 0,0:07:47.57,0:07:50.04,Default,,0000,0000,0000,,Сен маған қарайсың ба? 》
Dialogue: 0,0:07:53.14,0:07:57.58,Default,,0000,0000,0000,,《Мүмкін емес нәрсені жасама.
Dialogue: 0,0:07:53.14,0:07:57.58,Default,,0000,0000,0000,,Бұл туралы маған көп айтылды.
Dialogue: 0,0:07:57.58,0:08:00.08,Default,,0000,0000,0000,,Мен жақсымын
Dialogue: 0,0:07:57.58,0:08:00.08,Default,,0000,0000,0000,,Маған көмектескеніңіз үшін кешіріңіз.
Dialogue: 0,0:07:57.58,0:08:00.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:00.08,0:08:02.58,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:08:00.08,0:08:02.58,Default,,0000,0000,0000,,Біз бірге болғанымызға біраз болды.
Dialogue: 0,0:08:00.08,0:08:02.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:02.58,0:08:04.55,Default,,0000,0000,0000,,Хи хи хи...
Dialogue: 0,0:08:02.58,0:08:04.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:04.55,0:08:06.52,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:04.55,0:08:06.52,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:08:04.55,0:08:06.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:10.06,0:08:13.03,Default,,0000,0000,0000,,《Мен әкелген раушан гүлдері болды
Dialogue: 0,0:08:10.06,0:08:13.03,Default,,0000,0000,0000,,100-ден астам акциялар》
Dialogue: 0,0:08:16.13,0:08:18.53,Default,,0000,0000,0000,,Бұл соңы
Dialogue: 0,0:08:16.13,0:08:18.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:18.53,0:08:21.53,Default,,0000,0000,0000,,Сен… кімсің?
Dialogue: 0,0:08:18.53,0:08:21.53,Default,,0000,0000,0000,,Құндыз жүріп келеді.
Dialogue: 0,0:08:18.53,0:08:21.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:21.53,0:08:25.54,Default,,0000,0000,0000,,《Түрлері болып табылады
Dialogue: 0,0:08:21.53,0:08:25.54,Default,,0000,0000,0000,,Бөлініп кетсін
Dialogue: 0,0:08:21.53,0:08:25.54,Default,,0000,0000,0000,,Мүмкіндігінше
Dialogue: 0,0:08:21.53,0:08:25.54,Default,,0000,0000,0000,,Мен ерте гүлдейтіндерді таңдадым.
Dialogue: 0,0:08:25.54,0:08:27.57,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:08:25.54,0:08:27.57,Default,,0000,0000,0000,,Ол гүлдейді ме?
Dialogue: 0,0:08:27.57,0:08:30.44,Default,,0000,0000,0000,,Мен солай деп үміттенемін.
Dialogue: 0,0:08:27.57,0:08:30.44,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:38.62,0:08:41.09,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:08:38.62,0:08:41.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:42.56,0:08:46.03,Default,,0000,0000,0000,,《Температураны реттеу үшін
Dialogue: 0,0:08:42.56,0:08:46.03,Default,,0000,0000,0000,,Мұқият назар аударыңыз》
Dialogue: 0,0:08:46.03,0:08:49.03,Default,,0000,0000,0000,,《Бірнеше адам
Dialogue: 0,0:08:46.03,0:08:49.03,Default,,0000,0000,0000,,Мені осында жіберді➡
Dialogue: 0,0:08:49.03,0:08:52.53,Default,,0000,0000,0000,,Басқаларға не қалдыру керек
Dialogue: 0,0:08:49.03,0:08:52.53,Default,,0000,0000,0000,,Бұл қиын тапсырма》
Dialogue: 0,0:08:52.53,0:08:55.07,Default,,0000,0000,0000,,《Қате
Dialogue: 0,0:08:52.53,0:08:55.07,Default,,0000,0000,0000,,Оның бәрі қурап қалмасын➡
Dialogue: 0,0:08:55.07,0:08:57.04,Default,,0000,0000,0000,,Бітті.
Dialogue: 0,0:09:01.61,0:09:06.08,Default,,0000,0000,0000,,《Шуақты күнде далаға шығарыңыз
Dialogue: 0,0:09:01.61,0:09:06.08,Default,,0000,0000,0000,,Күн ашық болсын》
Dialogue: 0,0:09:07.05,0:09:09.05,Default,,0000,0000,0000,,Жақсы сезінеді~
Dialogue: 0,0:09:07.05,0:09:09.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:09.05,0:09:11.05,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:09.05,0:09:11.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:09.05,0:09:11.05,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:09:09.05,0:09:11.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:11.05,0:09:13.55,Default,,0000,0000,0000,,Жағдайыңыз қалай?
Dialogue: 0,0:09:11.05,0:09:13.55,Default,,0000,0000,0000,,Сізге бұл қалай ұнайды?
Dialogue: 0,0:09:11.05,0:09:13.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:11.05,0:09:13.55,Default,,0000,0000,0000,,2 адам
Dialogue: 0,0:09:11.05,0:09:13.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:11.05,0:09:13.55,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:13.55,0:09:15.55,Default,,0000,0000,0000,,Бұл сыйлық.
Dialogue: 0,0:09:13.55,0:09:15.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:18.02,0:09:21.56,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:18.02,0:09:21.56,Default,,0000,0000,0000,,Хи хи хи...
Dialogue: 0,0:09:18.02,0:09:21.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:18.02,0:09:21.56,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:09:18.02,0:09:21.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:21.56,0:09:26.60,Default,,0000,0000,0000,,Мен жұмысты сағындым
Dialogue: 0,0:09:21.56,0:09:26.60,Default,,0000,0000,0000,,Тағамға дейін
Dialogue: 0,0:09:21.56,0:09:26.60,Default,,0000,0000,0000,,Оны алу өте жақсы.
Dialogue: 0,0:09:21.56,0:09:26.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:26.60,0:09:29.64,Default,,0000,0000,0000,,Бұл да жұмыс.
Dialogue: 0,0:09:26.60,0:09:29.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:29.64,0:09:31.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:29.64,0:09:31.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:31.54,0:09:33.54,Default,,0000,0000,0000,,Чип! Чип, чип, чип, чип!
Dialogue: 0,0:09:33.54,0:09:36.54,Default,,0000,0000,0000,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:09:33.54,0:09:36.54,Default,,0000,0000,0000,,Бұл әдеттен тыс нәрсе ме?
Dialogue: 0,0:09:36.54,0:09:39.55,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:09:36.54,0:09:39.55,Default,,0000,0000,0000,,Сіз қорқынышты нәрсе көрдіңіз бе? 》
Dialogue: 0,0:09:39.55,0:09:41.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:39.55,0:09:41.01,Default,,0000,0000,0000,,Күңдер
Dialogue: 0,0:09:39.55,0:09:41.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:39.55,0:09:41.01,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:39.55,0:09:41.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:42.55,0:09:44.55,Default,,0000,0000,0000,,Келесі
Dialogue: 0,0:09:42.55,0:09:44.55,Default,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:09:44.55,0:09:48.59,Default,,0000,0000,0000,,Көп жаңа бүршіктері бар көшеттер болса
Dialogue: 0,0:09:44.55,0:09:48.59,Default,,0000,0000,0000,,Кейбіреуін таңдай аласыз ба?
Dialogue: 0,0:09:48.59,0:09:51.66,Default,,0000,0000,0000,,Концентрленген тамақтану
Dialogue: 0,0:09:48.59,0:09:51.66,Default,,0000,0000,0000,,Ол оңайырақ гүлдейді➡
Dialogue: 0,0:09:51.66,0:09:56.56,Default,,0000,0000,0000,,Ол аурулардың алдын алуға көмектеседі.
Dialogue: 0,0:09:51.66,0:09:56.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:51.66,0:09:56.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:51.66,0:09:56.56,Default,,0000,0000,0000,,Евнухтар
Dialogue: 0,0:09:51.66,0:09:56.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:51.66,0:09:56.56,Default,,0000,0000,0000,,Сол сияқты, бір күні, бір жерде кездесесіздер.
Dialogue: 0,0:09:51.66,0:09:56.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:56.56,0:09:59.03,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:59.03,0:10:02.07,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:09:59.03,0:10:02.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:59.03,0:10:02.07,Default,,0000,0000,0000,,Ал Кира
Dialogue: 0,0:09:59.03,0:10:02.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:02.07,0:10:04.04,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:10:02.07,0:10:04.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:04.04,0:10:05.54,Default,,0000,0000,0000,,Пои
Dialogue: 0,0:10:04.04,0:10:05.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,Евнух
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,Сяоран
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,Жоқ~
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:08.04,0:10:11.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:08.04,0:10:11.08,Default,,0000,0000,0000,,Алыстағы найзағай
Dialogue: 0,0:10:08.04,0:10:11.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:11.08,0:10:13.08,Default,,0000,0000,0000,,Өтінемін, асығыңыз!
Dialogue: 0,0:10:16.05,0:10:18.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:16.05,0:10:18.05,Default,,0000,0000,0000,,Қатты жаңбыр дыбысы
Dialogue: 0,0:10:16.05,0:10:18.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:18.05,0:10:20.05,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:10:18.05,0:10:20.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:20.05,0:10:24.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:20.05,0:10:24.56,Default,,0000,0000,0000,,Сяоран
Dialogue: 0,0:10:20.05,0:10:24.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:20.05,0:10:24.56,Default,,0000,0000,0000,,Бүршік
Dialogue: 0,0:10:20.05,0:10:24.56,Default,,0000,0000,0000,,Ол жиі шыға бермейді...
Dialogue: 0,0:10:20.05,0:10:24.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:29.10,0:10:31.96,Default,,0000,0000,0000,,《Суық қайтқан күн...》
Dialogue: 0,0:10:36.64,0:10:39.14,Default,,0000,0000,0000,,《Түні бойы үйді жылыту》
Dialogue: 0,0:10:45.58,0:10:48.08,Default,,0000,0000,0000,,《Ауа райы
Dialogue: 0,0:10:45.58,0:10:48.08,Default,,0000,0000,0000,,Оған адал болыңыз》
Dialogue: 0,0:10:55.09,0:10:57.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:55.09,0:10:57.06,Default,,0000,0000,0000,,Есту
Dialogue: 0,0:10:55.09,0:10:57.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:58.56,0:11:00.59,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:10:58.56,0:11:00.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:00.59,0:11:02.63,Default,,0000,0000,0000,,Сен де кеше түнде ұйықтамадың ба?
Dialogue: 0,0:11:02.63,0:11:05.16,Default,,0000,0000,0000,,Мен ұйықтадым
Dialogue: 0,0:11:02.63,0:11:05.16,Default,,0000,0000,0000,,Таң
Dialogue: 0,0:11:02.63,0:11:05.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:05.16,0:11:07.07,Default,,0000,0000,0000,,Таң атқанда
Dialogue: 0,0:11:05.16,0:11:07.07,Default,,0000,0000,0000,,Дәл қазір!?
Dialogue: 0,0:11:07.07,0:11:10.57,Default,,0000,0000,0000,,Не істей аласыз
Dialogue: 0,0:11:07.07,0:11:10.57,Default,,0000,0000,0000,,Ақыры осында
Dialogue: 0,0:11:07.07,0:11:10.57,Default,,0000,0000,0000,,Неге ұйықтамайсың?
Dialogue: 0,0:11:10.57,0:11:13.57,Default,,0000,0000,0000,,Шығыс Патшалығының астанасы – Баррингтон
Dialogue: 0,0:11:10.57,0:11:13.57,Default,,0000,0000,0000,,Мен сені жібере алмаймын
Dialogue: 0,0:11:10.57,0:11:13.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:13.57,0:11:17.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:13.57,0:11:17.54,Default,,0000,0000,0000,,Сяоран
Dialogue: 0,0:11:13.57,0:11:17.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:13.57,0:11:17.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:13.57,0:11:17.54,Default,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:11:13.57,0:11:17.54,Default,,0000,0000,0000,,Маған қарап тұрсың ба?
Dialogue: 0,0:11:13.57,0:11:17.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:17.54,0:11:21.08,Default,,0000,0000,0000,,《Күн сайын күн сайын
Dialogue: 0,0:11:17.54,0:11:21.08,Default,,0000,0000,0000,,Мен одан ешқашан жалықпаймын.
Dialogue: 0,0:11:21.08,0:11:23.62,Default,,0000,0000,0000,,《Дәлірек айтсақ, алаңдататын》
Dialogue: 0,0:11:23.62,0:11:27.12,Default,,0000,0000,0000,,《Егер бір нәрсе мені алаңдатса...》
Dialogue: 0,0:11:29.06,0:11:30.42,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:11:29.06,0:11:30.42,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:31.56,0:11:36.56,Default,,0000,0000,0000,,Шымшу мүмкін емес
Dialogue: 0,0:11:31.56,0:11:36.56,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:11:31.56,0:11:36.56,Default,,0000,0000,0000,,Бұл тырнақ бояуы ма?
Dialogue: 0,0:11:36.56,0:11:39.07,Default,,0000,0000,0000,,Ханамачи
Dialogue: 0,0:11:36.56,0:11:39.07,Default,,0000,0000,0000,,Қызыл жарық ауданында
Dialogue: 0,0:11:36.56,0:11:39.07,Default,,0000,0000,0000,,Барлығы мұны істеп жатыр.
Dialogue: 0,0:11:36.56,0:11:39.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:39.07,0:11:42.07,Default,,0000,0000,0000,,Бұл әдемі!
Dialogue: 0,0:11:39.07,0:11:42.07,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:11:39.07,0:11:42.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:44.57,0:11:47.04,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:11:44.57,0:11:47.04,Default,,0000,0000,0000,,Хэхе…
Dialogue: 0,0:11:44.57,0:11:47.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:44.57,0:11:47.04,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:11:44.57,0:11:47.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:51.54,0:11:56.05,Default,,0000,0000,0000,,Нгуен
Dialogue: 0,0:11:51.54,0:11:56.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:51.54,0:11:56.05,Default,,0000,0000,0000,,Таказоно
Dialogue: 0,0:11:51.54,0:11:56.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:51.54,0:11:56.05,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:11:51.54,0:11:56.05,Default,,0000,0000,0000,,Сіз мысықтар мен мысықтарды да ойнайсыз ба?
Dialogue: 0,0:11:51.54,0:11:56.05,Default,,0000,0000,0000,,Өте сүйкімді!
Dialogue: 0,0:11:56.05,0:11:58.55,Default,,0000,0000,0000,,Айран
Dialogue: 0,0:11:56.05,0:11:58.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:56.05,0:11:58.55,Default,,0000,0000,0000,,Ай Ай
Dialogue: 0,0:11:56.05,0:11:58.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:56.05,0:11:58.55,Default,,0000,0000,0000,,Жақында
Dialogue: 0,0:11:56.05,0:11:58.55,Default,,0000,0000,0000,,Бұл танымал, солай емес пе?
Dialogue: 0,0:11:56.05,0:11:58.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:58.55,0:12:00.52,Default,,0000,0000,0000,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:11:58.55,0:12:00.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:02.05,0:12:08.16,Default,,0000,0000,0000,,Чоай
Dialogue: 0,0:12:02.05,0:12:08.16,Default,,0000,0000,0000,,`` Императордың ықыласына ие болған жоғары дәрежелі жұбай
Dialogue: 0,0:12:02.05,0:12:08.16,Default,,0000,0000,0000,,Өйткені бұл соңғы тренд.
Dialogue: 0,0:12:08.16,0:12:10.13,Default,,0000,0000,0000,,｟Hehe｠
Dialogue: 0,0:12:12.63,0:12:16.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:12.63,0:12:16.57,Default,,0000,0000,0000,,Бени Мусуме
Dialogue: 0,0:12:12.63,0:12:16.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:12.63,0:12:16.57,Default,,0000,0000,0000,,Тиімсіз.
Dialogue: 0,0:12:12.63,0:12:16.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:12.63,0:12:16.57,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:12:16.57,0:12:20.04,Default,,0000,0000,0000,,《Қызыл қыз
Dialogue: 0,0:12:16.57,0:12:20.04,Default,,0000,0000,0000,,Сәнмен жұмыс жасау》
Dialogue: 0,0:12:21.54,0:12:25.04,Default,,0000,0000,0000,,Енді улану сынағы аяқталды,
Dialogue: 0,0:12:21.54,0:12:25.04,Default,,0000,0000,0000,,Кристал Палас дегенге қайта келу
Dialogue: 0,0:12:21.54,0:12:25.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:25.04,0:12:29.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:25.04,0:12:29.05,Default,,0000,0000,0000,,Гёкуйо ханшайымы
Dialogue: 0,0:12:25.04,0:12:29.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:25.04,0:12:29.05,Default,,0000,0000,0000,,Қазірдің өзінде?
Dialogue: 0,0:12:25.04,0:12:29.05,Default,,0000,0000,0000,,Менің бақ кешіне дейін уақытым жоқ, сондықтан
Dialogue: 0,0:12:25.04,0:12:29.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:29.05,0:12:31.05,Default,,0000,0000,0000,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:12:29.05,0:12:31.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:31.05,0:12:36.16,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:12:31.05,0:12:36.16,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:12:31.05,0:12:36.16,Default,,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:12:31.05,0:12:36.16,Default,,0000,0000,0000,,Гёкуха ханым жоқ болады.
Dialogue: 0,0:12:31.05,0:12:36.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:36.16,0:12:40.06,Default,,0000,0000,0000,,Луран
Dialogue: 0,0:12:36.16,0:12:40.06,Default,,0000,0000,0000,,Лоуран-саманың ашылуы
Dialogue: 0,0:12:36.16,0:12:40.06,Default,,0000,0000,0000,,Бұл өз орнын беру сияқты.
Dialogue: 0,0:12:36.16,0:12:40.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:40.06,0:12:43.06,Default,,0000,0000,0000,,《Жүктілігін жасыру үшін бе?》
Dialogue: 0,0:12:43.06,0:12:45.56,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:12:43.06,0:12:45.56,Default,,0000,0000,0000,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:12:43.06,0:12:45.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:45.56,0:12:48.57,Default,,0000,0000,0000,,Инфа
Dialogue: 0,0:12:45.56,0:12:48.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:45.56,0:12:48.57,Default,,0000,0000,0000,,Сакурака
Dialogue: 0,0:12:45.56,0:12:48.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:45.56,0:12:48.57,Default,,0000,0000,0000,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:12:45.56,0:12:48.57,Default,,0000,0000,0000,,Хрусталь сарайда бәрі жақсы ма?
Dialogue: 0,0:12:48.57,0:12:51.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:48.57,0:12:51.07,Default,,0000,0000,0000,,Таказоно
Dialogue: 0,0:12:48.57,0:12:51.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:48.57,0:12:51.07,Default,,0000,0000,0000,,Дондон
Dialogue: 0,0:12:48.57,0:12:51.07,Default,,0000,0000,0000,,Сіз жалқау болып бара жатырсыз ба?
Dialogue: 0,0:12:51.07,0:12:53.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:51.07,0:12:53.57,Default,,0000,0000,0000,,Ай Ай
Dialogue: 0,0:12:51.07,0:12:53.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:51.07,0:12:53.57,Default,,0000,0000,0000,,Өзіңізді қатты итермеңіз.
Dialogue: 0,0:12:51.07,0:12:53.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:53.57,0:12:55.54,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:12:53.57,0:12:55.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:02.58,0:13:05.05,Default,,0000,0000,0000,,А...
Dialogue: 0,0:13:02.58,0:13:05.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:06.09,0:13:08.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:06.09,0:13:08.55,Default,,0000,0000,0000,,Сяоран
Dialogue: 0,0:13:06.09,0:13:08.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:06.09,0:13:08.55,Default,,0000,0000,0000,,⚟Мысық мысық~! ⚞
Dialogue: 0,0:13:06.09,0:13:08.55,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:08.55,0:13:12.06,Default,,0000,0000,0000,,Мысық мысық
Dialogue: 0,0:13:08.55,0:13:12.06,Default,,0000,0000,0000,,Екі рет секіру ме? Әзілдеп тұрсың ғой.
Dialogue: 0,0:13:08.55,0:13:12.06,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:13:15.56,0:13:19.10,Default,,0000,0000,0000,,Бүршік…
Dialogue: 0,0:13:15.56,0:13:19.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:15.56,0:13:19.10,Default,,0000,0000,0000,,Мен оны жаңа ғана таптым.
Dialogue: 0,0:13:15.56,0:13:19.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:19.10,0:13:23.07,Default,,0000,0000,0000,,А...
Dialogue: 0,0:13:19.10,0:13:23.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:19.10,0:13:23.07,Default,,0000,0000,0000,,Ақырында бірінші!
Dialogue: 0,0:13:19.10,0:13:23.07,Default,,0000,0000,0000,,Аха...!
Dialogue: 0,0:13:23.07,0:13:28.04,Default,,0000,0000,0000,,Егер жағдай осылай жалғаса берсе...
Dialogue: 0,0:13:23.07,0:13:28.04,Default,,0000,0000,0000,,Мүмкін ол әйтеуір гүлдейді...
Dialogue: 0,0:13:23.07,0:13:28.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:28.04,0:13:31.04,Default,,0000,0000,0000,,Мысық мысық…
Dialogue: 0,0:13:28.04,0:13:31.04,Default,,0000,0000,0000,,Мысық мысық?
Dialogue: 0,0:13:31.04,0:13:32.55,Default,,0000,0000,0000,,мысық мысық⁉
Dialogue: 0,0:13:41.09,0:13:43.16,Default,,0000,0000,0000,,Фармацевттен естідіңіз бе?
Dialogue: 0,0:13:43.16,0:13:45.02,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:13:43.16,0:13:45.02,Default,,0000,0000,0000,,«Сенім артамын.»
Dialogue: 0,0:13:43.16,0:13:45.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:45.02,0:13:48.06,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:13:45.02,0:13:48.06,Default,,0000,0000,0000,,Соңғы бірнеше күн
Dialogue: 0,0:13:45.02,0:13:48.06,Default,,0000,0000,0000,,Жүзін көрсете алмады
Dialogue: 0,0:13:45.02,0:13:48.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:48.06,0:13:52.03,Default,,0000,0000,0000,,Бір-біріне
Dialogue: 0,0:13:48.06,0:13:52.03,Default,,0000,0000,0000,,Бақша кешіне дайындық
Dialogue: 0,0:13:48.06,0:13:52.03,Default,,0000,0000,0000,,Себебі мені қуып жүрді.
Dialogue: 0,0:13:48.06,0:13:52.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:55.03,0:13:57.54,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:13:55.03,0:13:57.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:55.03,0:13:57.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:58.57,0:14:00.04,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:58.57,0:14:00.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:07.01,0:14:25.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:25.03,0:14:29.54,Default,,0000,0000,0000,,Шишо
Dialogue: 0,0:14:25.03,0:14:29.54,Default,,0000,0000,0000,,Бұл Кошодононың қызы.
Dialogue: 0,0:14:25.03,0:14:29.54,Default,,0000,0000,0000,,Лу Ланфей?
Dialogue: 0,0:14:25.03,0:14:29.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:33.51,0:14:36.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:33.51,0:14:36.01,Default,,0000,0000,0000,,Азаматтық
Dialogue: 0,0:14:33.51,0:14:36.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:33.51,0:14:36.01,Default,,0000,0000,0000,,Қандай керемет
Dialogue: 0,0:14:33.51,0:14:36.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:36.01,0:14:48.52,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:48.52,0:14:51.02,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:48.52,0:14:51.02,Default,,0000,0000,0000,,Цзы-чан
Dialogue: 0,0:14:48.52,0:14:51.02,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:48.52,0:14:51.02,Default,,0000,0000,0000,,Лоуланға...
Dialogue: 0,0:14:48.52,0:14:51.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:53.06,0:14:58.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:53.06,0:14:58.03,Default,,0000,0000,0000,,Цзы-чан
Dialogue: 0,0:14:53.06,0:14:58.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:53.06,0:14:58.03,Default,,0000,0000,0000,,Кемшіліктер бар ма?
Dialogue: 0,0:14:58.03,0:15:01.50,Default,,0000,0000,0000,,Маған бірдеңе айтыңызшы
Dialogue: 0,0:14:58.03,0:15:01.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:04.04,0:15:07.51,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:04.04,0:15:07.51,Default,,0000,0000,0000,,Луланфей
Dialogue: 0,0:15:04.04,0:15:07.51,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:04.04,0:15:07.51,Default,,0000,0000,0000,,Не болса да
Dialogue: 0,0:15:04.04,0:15:07.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:04.04,0:15:07.51,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:04.04,0:15:07.51,Default,,0000,0000,0000,,Императрица Довагер
Dialogue: 0,0:15:04.04,0:15:07.51,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:04.04,0:15:07.51,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:15:04.04,0:15:07.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:07.51,0:15:10.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:07.51,0:15:10.01,Default,,0000,0000,0000,,Шырылдау
Dialogue: 0,0:15:07.51,0:15:10.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:10.01,0:15:19.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:19.12,0:15:22.12,Default,,0000,0000,0000,,Көк раушан
Dialogue: 0,0:15:19.12,0:15:22.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:19.12,0:15:22.12,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:15:19.12,0:15:22.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:27.03,0:15:29.53,Default,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:15:27.03,0:15:29.53,Default,,0000,0000,0000,,Бүршіктерді жақсы көр➡
Dialogue: 0,0:15:29.53,0:15:34.50,Default,,0000,0000,0000,,Толық гүлдеген
Dialogue: 0,0:15:29.53,0:15:34.50,Default,,0000,0000,0000,,Бұл туралы ойлау қызық па?
Dialogue: 0,0:15:29.53,0:15:34.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:34.50,0:15:39.04,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:34.50,0:15:39.04,Default,,0000,0000,0000,,Император
Dialogue: 0,0:15:34.50,0:15:39.04,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:34.50,0:15:39.04,Default,,0000,0000,0000,,Хмм
Dialogue: 0,0:15:34.50,0:15:39.04,Default,,0000,0000,0000,,Өте әдемі
Dialogue: 0,0:15:34.50,0:15:39.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:39.04,0:15:43.54,Default,,0000,0000,0000,,《Джиншиге бағытталған
Dialogue: 0,0:15:39.04,0:15:43.54,Default,,0000,0000,0000,,Көрінетін барлық жолдар》
Dialogue: 0,0:15:43.54,0:15:47.11,Default,,0000,0000,0000,,《Сыртыңыз қаншалықты жақсы болса да➡
Dialogue: 0,0:15:47.11,0:15:50.52,Default,,0000,0000,0000,,Жас уәзір
Dialogue: 0,0:15:47.11,0:15:50.52,Default,,0000,0000,0000,,Маған интрузивті болу көбірек ұнайды➡
Dialogue: 0,0:15:50.52,0:15:53.02,Default,,0000,0000,0000,,Мемлекеттік қызметкерлердің барлығы жанқияр емес.
Dialogue: 0,0:15:54.52,0:15:57.02,Default,,0000,0000,0000,,《Нәпсі – бұл
Dialogue: 0,0:15:54.52,0:15:57.02,Default,,0000,0000,0000,,Жақсы》
Dialogue: 0,0:15:57.02,0:15:59.49,Default,,0000,0000,0000,,《Оны қолданудың көптеген жолдары бар》
Dialogue: 0,0:16:01.49,0:16:04.50,Default,,0000,0000,0000,,《Қызғаныш та
Dialogue: 0,0:16:01.49,0:16:04.50,Default,,0000,0000,0000,,Жақсы…
Dialogue: 0,0:16:01.49,0:16:04.50,Default,,0000,0000,0000,,Өңдеу оңай》
Dialogue: 0,0:16:04.50,0:16:06.53,Default,,0000,0000,0000,,《Қиындық туғызатын нәрсе➡
Dialogue: 0,0:16:06.53,0:16:10.10,Default,,0000,0000,0000,,Сіз не ойлап отырсыз?
Dialogue: 0,0:16:06.53,0:16:10.10,Default,,0000,0000,0000,,Түсінбейтін көздер
Dialogue: 0,0:16:10.10,0:16:15.51,Default,,0000,0000,0000,,《Цзумаса…
Dialogue: 0,0:16:10.10,0:16:15.51,Default,,0000,0000,0000,,Лоуланның биологиялық әкесінің жұбайы
Dialogue: 0,0:16:10.10,0:16:15.51,Default,,0000,0000,0000,,Императрица ұнатқан адам》
Dialogue: 0,0:16:15.51,0:16:19.01,Default,,0000,0000,0000,,《Тіпті қазір де
Dialogue: 0,0:16:15.51,0:16:19.01,Default,,0000,0000,0000,,Император басын көтере алмайды.
Dialogue: 0,0:16:19.01,0:16:23.02,Default,,0000,0000,0000,,《Сол себепті
Dialogue: 0,0:16:19.01,0:16:23.02,Default,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:16:19.01,0:16:23.02,Default,,0000,0000,0000,,Ешқашан күлуді тоқтатпа》
Dialogue: 0,0:16:23.02,0:16:27.02,Default,,0000,0000,0000,,《Ал қазір
Dialogue: 0,0:16:23.02,0:16:27.02,Default,,0000,0000,0000,,Цзы-чанг➡дан да қиын не бар
Dialogue: 0,0:16:27.02,0:16:30.52,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:16:27.02,0:16:30.52,Default,,0000,0000,0000,,Ол адам》
Dialogue: 0,0:16:32.56,0:16:34.09,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:16:32.56,0:16:34.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:34.09,0:16:36.13,Default,,0000,0000,0000,,Шенеуніктер күлкілерін басып отыр.
Dialogue: 0,0:16:36.13,0:16:37.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:39.50,0:16:42.00,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:39.50,0:16:42.00,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:16:39.50,0:16:42.00,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:39.50,0:16:42.00,Default,,0000,0000,0000,,Қандай жиіркенішті...
Dialogue: 0,0:16:39.50,0:16:42.00,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:44.50,0:16:47.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:44.50,0:16:47.01,Default,,0000,0000,0000,,Ұйқыдағы тыныс
Dialogue: 0,0:16:44.50,0:16:47.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:47.01,0:16:48.51,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:16:47.01,0:16:48.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:48.51,0:16:52.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:48.51,0:16:52.01,Default,,0000,0000,0000,,Сакурака
Dialogue: 0,0:16:48.51,0:16:52.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:48.51,0:16:52.01,Default,,0000,0000,0000,,Байқадыңыз ба?
Dialogue: 0,0:16:48.51,0:16:52.01,Default,,0000,0000,0000,,Охка-сан…
Dialogue: 0,0:16:48.51,0:16:52.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:52.01,0:16:54.51,Default,,0000,0000,0000,,Енді Хрусталь сарайға бармаңыз.
Dialogue: 0,0:16:52.01,0:16:54.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:54.51,0:16:58.58,Default,,0000,0000,0000,,Әрқашан
Dialogue: 0,0:16:54.51,0:16:58.58,Default,,0000,0000,0000,,Хаггард
Dialogue: 0,0:16:54.51,0:16:58.58,Default,,0000,0000,0000,,Мен қайтып келемін
Dialogue: 0,0:16:54.51,0:16:58.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:58.58,0:17:00.52,Default,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:16:58.58,0:17:00.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:00.52,0:17:02.99,Default,,0000,0000,0000,,Сіз ояндыңыз ба?
Dialogue: 0,0:17:00.52,0:17:02.99,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:00.52,0:17:02.99,Default,,0000,0000,0000,,2 адам
Dialogue: 0,0:17:00.52,0:17:02.99,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:00.52,0:17:02.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:05.02,0:17:08.03,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:17:05.02,0:17:08.03,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:17:05.02,0:17:08.03,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:17:05.02,0:17:08.03,Default,,0000,0000,0000,,. [жиырма төрт] .
Dialogue: 0,0:17:10.03,0:17:13.50,Default,,0000,0000,0000,,Сіз отыруға болады.
Dialogue: 0,0:17:10.03,0:17:13.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:13.50,0:17:18.57,Default,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,0:17:13.50,0:17:18.57,Default,,0000,0000,0000,,Гүлденуіне жетпеді.
Dialogue: 0,0:17:13.50,0:17:18.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:18.57,0:17:23.01,Default,,0000,0000,0000,,Бұл маған қарсы
Dialogue: 0,0:17:18.57,0:17:23.01,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:17:18.57,0:17:23.01,Default,,0000,0000,0000,,Менің ойымша, бұл сіздің айтқыңыз келген нәрсе емес.
Dialogue: 0,0:17:18.57,0:17:23.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:23.01,0:17:28.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:23.01,0:17:28.01,Default,,0000,0000,0000,,Пыс, пыс… Э?
Dialogue: 0,0:17:23.01,0:17:28.01,Default,,0000,0000,0000,,Бұл жеткілікті
Dialogue: 0,0:17:23.01,0:17:28.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:28.01,0:17:30.52,Default,,0000,0000,0000,,Бұл не болып жатыр?
Dialogue: 0,0:17:30.52,0:17:32.55,Default,,0000,0000,0000,,Мен оны жаңа ғана боядым.
Dialogue: 0,0:17:30.52,0:17:32.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:32.55,0:17:36.02,Default,,0000,0000,0000,,Сіз оны боядыңыз ба?
Dialogue: 0,0:17:32.55,0:17:36.02,Default,,0000,0000,0000,,Тіркелген ештеңе жоқ, солай ма?
Dialogue: 0,0:17:36.02,0:17:40.53,Default,,0000,0000,0000,,Сыртта емес
Dialogue: 0,0:17:36.02,0:17:40.53,Default,,0000,0000,0000,,Ішінен боялған.
Dialogue: 0,0:17:36.02,0:17:40.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:43.00,0:17:44.13,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:17:43.00,0:17:44.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:44.13,0:17:47.63,Default,,0000,0000,0000,,Бұл раушан
Dialogue: 0,0:17:44.13,0:17:47.63,Default,,0000,0000,0000,,Бастапқыда
Dialogue: 0,0:17:44.13,0:17:47.63,Default,,0000,0000,0000,,Барлық гүлдер ақ.
Dialogue: 0,0:17:44.13,0:17:47.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:49.54,0:17:54.04,Default,,0000,0000,0000,,Түрлі түсті сулар жасау
Dialogue: 0,0:17:49.54,0:17:54.04,Default,,0000,0000,0000,,Мен оны ақ бүршікке сорғыздым.
Dialogue: 0,0:17:49.54,0:17:54.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:54.04,0:17:57.54,Default,,0000,0000,0000,,Сондықтан тек көк емес
Dialogue: 0,0:17:54.04,0:17:57.54,Default,,0000,0000,0000,,Түстер көп болды ма?
Dialogue: 0,0:17:54.04,0:17:57.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:57.54,0:18:01.05,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:17:57.54,0:18:01.05,Default,,0000,0000,0000,,Жапырақтары
Dialogue: 0,0:17:57.54,0:18:01.05,Default,,0000,0000,0000,,Өйткені ол қою қара түске боялған➡
Dialogue: 0,0:18:01.05,0:18:04.05,Default,,0000,0000,0000,,Алдын ала
Dialogue: 0,0:18:01.05,0:18:04.05,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:18:01.05,0:18:04.05,Default,,0000,0000,0000,,Мен оны жұлып алдым.
Dialogue: 0,0:18:01.05,0:18:04.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:04.05,0:18:08.12,Default,,0000,0000,0000,,Қалғандары
Dialogue: 0,0:18:04.05,0:18:08.12,Default,,0000,0000,0000,,Бақша кеші кезінде
Dialogue: 0,0:18:04.05,0:18:08.12,Default,,0000,0000,0000,,Түстің түсуін болдырмаңыз➡
Dialogue: 0,0:18:08.12,0:18:11.56,Default,,0000,0000,0000,,Боялған суға малынған мақтаны түзетсеңіз,
Dialogue: 0,0:18:08.12,0:18:11.56,Default,,0000,0000,0000,,Аяқталды
Dialogue: 0,0:18:08.12,0:18:11.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:11.56,0:18:14.03,Default,,0000,0000,0000,,Бұл өте қарапайым
Dialogue: 0,0:18:11.56,0:18:14.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:14.03,0:18:19.53,Default,,0000,0000,0000,,《Нақты
Dialogue: 0,0:18:14.03,0:18:19.53,Default,,0000,0000,0000,,Сүйектері сынған.
Dialogue: 0,0:18:14.03,0:18:19.53,Default,,0000,0000,0000,,Раушан гүлдегенге дейін.
Dialogue: 0,0:18:19.53,0:18:22.03,Default,,0000,0000,0000,,Бұл, әрине, қарапайым.
Dialogue: 0,0:18:19.53,0:18:22.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:22.03,0:18:27.07,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:18:22.03,0:18:27.07,Default,,0000,0000,0000,,Шағымданатын нәрсе
Dialogue: 0,0:18:22.03,0:18:27.07,Default,,0000,0000,0000,,Бұны орындайтын мемлекеттік қызметкер болуы мүмкін
Dialogue: 0,0:18:22.03,0:18:27.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:27.07,0:18:30.64,Default,,0000,0000,0000,,Императорға
Dialogue: 0,0:18:27.07,0:18:30.64,Default,,0000,0000,0000,,Мен алдымен егжей-тегжейлерді аштым.
Dialogue: 0,0:18:27.07,0:18:30.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:30.64,0:18:34.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:18:30.64,0:18:34.05,Default,,0000,0000,0000,,Маомаоның дауысы
Dialogue: 0,0:18:30.64,0:18:34.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:18:30.64,0:18:34.05,Default,,0000,0000,0000,,Алдымен құпияны білу
Dialogue: 0,0:18:30.64,0:18:34.05,Default,,0000,0000,0000,,және тек үшеуміз – анам, әкем және мен – бірге өмір сүремін…
Dialogue: 0,0:18:30.64,0:18:34.05,Default,,0000,0000,0000,,Бақытты көрінеді➡
Dialogue: 0,0:18:34.05,0:18:37.05,Default,,0000,0000,0000,,Көңілді сияқты
Dialogue: 0,0:18:34.05,0:18:37.05,Default,,0000,0000,0000,,Сіз тыңдадыңыз.
Dialogue: 0,0:18:34.05,0:18:37.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:37.05,0:18:41.55,Default,,0000,0000,0000,,Өткенде
Dialogue: 0,0:18:37.05,0:18:41.55,Default,,0000,0000,0000,,Король сарайында
Dialogue: 0,0:18:37.05,0:18:41.55,Default,,0000,0000,0000,,Сіз көк раушан гүлін көргеніңізді айттыңыз ...
Dialogue: 0,0:18:37.05,0:18:41.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:41.55,0:18:47.03,Default,,0000,0000,0000,,Күн сайын күн сайын
Dialogue: 0,0:18:41.55,0:18:47.03,Default,,0000,0000,0000,,Көк суды раушан гүліне айналдыр
Dialogue: 0,0:18:41.55,0:18:47.03,Default,,0000,0000,0000,,Шылым шегуге рұқсат беретін бос уақыты бар біреу болса керек.
Dialogue: 0,0:18:41.55,0:18:47.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:49.56,0:18:52.10,Default,,0000,0000,0000,,Неге тағы?
Dialogue: 0,0:18:49.56,0:18:52.10,Default,,0000,0000,0000,,Сен мұны істедің бе?
Dialogue: 0,0:18:52.10,0:18:56.54,Default,,0000,0000,0000,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:18:52.10,0:18:56.54,Default,,0000,0000,0000,,Тіпті әйелді баурап алатын құрал ретінде
Dialogue: 0,0:18:52.10,0:18:56.54,Default,,0000,0000,0000,,Сіз мұны қаладыңыз ба?
Dialogue: 0,0:18:56.54,0:19:00.04,Default,,0000,0000,0000,,Шындығында, 2-сыныпты үш тәжірибеші мен бір 1-сыныпты тәжірибеші қызмет барысында қаза тапты.
Dialogue: 0,0:18:56.54,0:19:00.04,Default,,0000,0000,0000,,Сіз тырнақтарыңызды бояп жатырсыз ба?
Dialogue: 0,0:19:00.04,0:19:02.54,Default,,0000,0000,0000,,Бұл маған сәйкес келмейді.
Dialogue: 0,0:19:00.04,0:19:02.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:02.54,0:19:07.51,Default,,0000,0000,0000,,Хосенка
Dialogue: 0,0:19:02.54,0:19:07.51,Default,,0000,0000,0000,,Катабами
Dialogue: 0,0:19:02.54,0:19:07.51,Default,,0000,0000,0000,,《Егер Хосенька мен Катакуми болса
Dialogue: 0,0:19:02.54,0:19:07.51,Default,,0000,0000,0000,,Ол әдемірек боялады.
Dialogue: 0,0:19:07.51,0:19:12.55,Default,,0000,0000,0000,,Цумабени
Dialogue: 0,0:19:07.51,0:19:12.55,Default,,0000,0000,0000,,《Хосенка, тырнақ қызыл деп те аталады
Dialogue: 0,0:19:07.51,0:19:12.55,Default,,0000,0000,0000,,Катакуми, сонымен қатар Некоаши деген атпен белгілі
Dialogue: 0,0:19:12.55,0:19:15.09,Default,,0000,0000,0000,,《Екеуін бірге араластырыңыз
Dialogue: 0,0:19:12.55,0:19:15.09,Default,,0000,0000,0000,,Тырнақтарға қолданғанда➡
Dialogue: 0,0:19:15.09,0:19:17.12,Default,,0000,0000,0000,,Ашық қызыл түске айналады》
Dialogue: 0,0:19:17.12,0:19:20.03,Default,,0000,0000,0000,,《Жақсы
Dialogue: 0,0:19:17.12,0:19:20.03,Default,,0000,0000,0000,,Әдемі бояғаннан кейін...》
Dialogue: 0,0:19:20.03,0:19:23.53,Default,,0000,0000,0000,,《Тіпті бұл
Dialogue: 0,0:19:20.03,0:19:23.53,Default,,0000,0000,0000,,Мен қалыпты болдым.》
Dialogue: 0,0:19:23.53,0:19:26.53,Default,,0000,0000,0000,,Гаошун мырза
Dialogue: 0,0:19:23.53,0:19:26.53,Default,,0000,0000,0000,,Сіз не сұрадыңыз?
Dialogue: 0,0:19:26.53,0:19:29.03,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:26.53,0:19:29.03,Default,,0000,0000,0000,,Айтқандай
Dialogue: 0,0:19:26.53,0:19:29.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:29.03,0:19:32.04,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:19:29.03,0:19:32.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:32.04,0:19:35.57,Default,,0000,0000,0000,,《Сахна қойылды》
Dialogue: 0,0:19:35.57,0:19:41.58,Default,,0000,0000,0000,,《Қалғаны
Dialogue: 0,0:19:35.57,0:19:41.58,Default,,0000,0000,0000,,Ұнамайтындар үшін
Dialogue: 0,0:19:35.57,0:19:41.58,Default,,0000,0000,0000,,Жай ғана көпіршіктендіріңіз.
Dialogue: 0,0:19:43.55,0:19:49.05,Default,,0000,0000,0000,,《Тіпті
Dialogue: 0,0:19:43.55,0:19:49.05,Default,,0000,0000,0000,,Бұл арандатушылық болады деп күткен жоқпын.
Dialogue: 0,0:19:43.55,0:19:49.05,Default,,0000,0000,0000,,Бұл сәтсіздікпен аяқталады…》
Dialogue: 0,0:19:52.52,0:19:54.53,Default,,0000,0000,0000,,(
Dialogue: 0,0:19:52.52,0:19:54.53,Default,,0000,0000,0000,,Есту
Dialogue: 0,0:19:52.52,0:19:54.53,Default,,0000,0000,0000,,)
Dialogue: 0,0:19:55.99,0:20:00.60,Default,,0000,0000,0000,,(
Dialogue: 0,0:19:55.99,0:20:00.60,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:19:55.99,0:20:00.60,Default,,0000,0000,0000,,)
Dialogue: 0,0:19:55.99,0:20:00.60,Default,,0000,0000,0000,,《Адамның бет-бейнесі көп
Dialogue: 0,0:19:55.99,0:20:00.60,Default,,0000,0000,0000,,Бұл жай ғана Go тасына ұқсайды.
Dialogue: 0,0:20:00.60,0:20:03.54,Default,,0000,0000,0000,,《Ер адам Куроиши
Dialogue: 0,0:20:00.60,0:20:03.54,Default,,0000,0000,0000,,Әйел - Ширайши》
Dialogue: 0,0:20:03.54,0:20:09.04,Default,,0000,0000,0000,,《Тіпті әскерге бағынатын адамдар
Dialogue: 0,0:20:03.54,0:20:09.04,Default,,0000,0000,0000,,Шан-Чи
Dialogue: 0,0:20:03.54,0:20:09.04,Default,,0000,0000,0000,,Ең жақсы жағдайда олар шахмат ойынындағы фигуралар.
Dialogue: 0,0:20:09.04,0:20:11.54,Default,,0000,0000,0000,,《Көбі солдат.
Dialogue: 0,0:20:09.04,0:20:11.54,Default,,0000,0000,0000,,
Dialogue: 0,0:20:09.04,0:20:11.54,Default,,0000,0000,0000,,Бітіру➡
Dialogue: 0,0:20:11.54,0:20:16.05,Default,,0000,0000,0000,,Дәреже неғұрлым жоғары
Dialogue: 0,0:20:11.54,0:20:16.05,Default,,0000,0000,0000,,Жылқы
Dialogue: 0,0:20:11.54,0:20:16.05,Default,,0000,0000,0000,,
Dialogue: 0,0:20:11.54,0:20:16.05,Default,,0000,0000,0000,,Зеңбірек болу》
Dialogue: 0,0:20:16.05,0:20:18.58,Default,,0000,0000,0000,,《Әскери жұмыс оңай》
Dialogue: 0,0:20:18.58,0:20:22.15,Default,,0000,0000,0000,,《Бөлімдерге сәйкес орналасу
Dialogue: 0,0:20:18.58,0:20:22.15,Default,,0000,0000,0000,,Жай ғана жасаңыз》
Dialogue: 0,0:20:22.15,0:20:27.49,Default,,0000,0000,0000,,《Дұрыс адам дұрыс жерде
Dialogue: 0,0:20:22.15,0:20:27.49,Default,,0000,0000,0000,,Көптеген шайқастарды осылай жеңесіз.
Dialogue: 0,0:20:27.49,0:20:29.53,Default,,0000,0000,0000,,《Бұл қиын емес》
Dialogue: 0,0:20:29.53,0:20:31.50,Default,,0000,0000,0000,,《Егер қабілетсіз болсам да➡
Dialogue: 0,0:20:31.50,0:20:36.00,Default,,0000,0000,0000,,Тапсырманы орындағаныңызша
Dialogue: 0,0:20:31.50,0:20:36.00,Default,,0000,0000,0000,,Ол жұмысты рұқсатсыз аяқтайды》
Dialogue: 0,0:20:36.00,0:20:40.01,Default,,0000,0000,0000,,《Мм...
Dialogue: 0,0:20:36.00,0:20:40.01,Default,,0000,0000,0000,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:20:36.00,0:20:40.01,Default,,0000,0000,0000,,Менің көзім әдеттегіден көбірек ауырады.
Dialogue: 0,0:20:40.01,0:20:43.04,Default,,0000,0000,0000,,《Қызыл түс қандай да бір себептермен жыпылықтайды》
Dialogue: 0,0:20:43.04,0:20:44.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:20:43.04,0:20:44.58,Default,,0000,0000,0000,,Әйелдер
Dialogue: 0,0:20:43.04,0:20:44.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:20:43.04,0:20:44.58,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:20:43.04,0:20:44.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:44.58,0:20:47.11,Default,,0000,0000,0000,,Шымшу мүмкін емес
Dialogue: 0,0:20:44.58,0:20:47.11,Default,,0000,0000,0000,,(
Dialogue: 0,0:20:44.58,0:20:47.11,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:20:44.58,0:20:47.11,Default,,0000,0000,0000,,)
Dialogue: 0,0:20:44.58,0:20:47.11,Default,,0000,0000,0000,,《Тырнақ қызыл...》
Dialogue: 0,0:20:47.11,0:20:52.55,Default,,0000,0000,0000,,Цумабени
Dialogue: 0,0:20:47.11,0:20:52.55,Default,,0000,0000,0000,,«Менің жадымдағы тырнақ бояуы
Dialogue: 0,0:20:47.11,0:20:52.55,Default,,0000,0000,0000,,Бұл жарқыраған қызыл емес.》
Dialogue: 0,0:20:52.55,0:20:57.02,Default,,0000,0000,0000,,《Феникс гүлдерінен аздап боялған қызыл》
Dialogue: 0,0:20:59.02,0:21:00.39,Default,,0000,0000,0000,,Ах...
