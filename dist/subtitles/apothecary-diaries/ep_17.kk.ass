Dialogue: 0,0:01:48.54,0:01:51.08,Default,,0000,0000,0000,,《Бұл қажет емес》
Dialogue: 0,0:01:51.08,0:01:53.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:53.11,0:01:56.55,Default,,0000,0000,0000,,《Тарих бар
Dialogue: 0,0:01:53.11,0:01:56.55,Default,,0000,0000,0000,,Мағынасыз шайқас
Dialogue: 0,0:01:53.11,0:01:56.55,Default,,0000,0000,0000,,Көп➡ бар
Dialogue: 0,0:01:56.55,0:01:58.55,Default,,0000,0000,0000,,Олардың кейбіреулері ➡
Dialogue: 0,0:01:58.55,0:02:01.55,Default,,0000,0000,0000,,Елге жақын ару арқылы
Dialogue: 0,0:01:58.55,0:02:01.55,Default,,0000,0000,0000,,Себеп болған》
Dialogue: 0,0:02:01.55,0:02:06.56,Default,,0000,0000,0000,,《Жәннаттардың сұлулығы осында.
Dialogue: 0,0:02:01.55,0:02:06.56,Default,,0000,0000,0000,,Макияж туралы ше...》
Dialogue: 0,0:02:06.56,0:02:08.56,Default,,0000,0000,0000,,Елді де құртуды ойлайсың ба?
Dialogue: 0,0:02:08.56,0:02:10.56,Default,,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:02:08.56,0:02:10.56,Default,,0000,0000,0000,,Бұл болады!
Dialogue: 0,0:02:10.56,0:02:14.10,Default,,0000,0000,0000,,Мүлдем емес
Dialogue: 0,0:02:10.56,0:02:14.10,Default,,0000,0000,0000,,Сіз не елестетесіз?
Dialogue: 0,0:02:10.56,0:02:14.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:14.10,0:02:17.67,Default,,0000,0000,0000,,Сіздің ұнтақ
Dialogue: 0,0:02:14.10,0:02:17.67,Default,,0000,0000,0000,,Ол қалай жасалады?
Dialogue: 0,0:02:17.67,0:02:22.04,Default,,0000,0000,0000,,《Ах
Dialogue: 0,0:02:17.67,0:02:22.04,Default,,0000,0000,0000,,Оны әдемі етудің орнына
Dialogue: 0,0:02:17.67,0:02:22.04,Default,,0000,0000,0000,,Оны түтіккен сен бе?
Dialogue: 0,0:02:22.04,0:02:27.58,Default,,0000,0000,0000,,Сазды құрғатып, оны ұнтаққа айналдырыңыз
Dialogue: 0,0:02:22.04,0:02:27.58,Default,,0000,0000,0000,,Майда ерітілген
Dialogue: 0,0:02:22.04,0:02:27.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:27.58,0:02:29.58,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:02:27.58,0:02:29.58,Default,,0000,0000,0000,,Мұны қазір жасауға бола ма?
Dialogue: 0,0:02:29.58,0:02:31.95,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:02:29.58,0:02:31.95,Default,,0000,0000,0000,,Бір түн
Dialogue: 0,0:02:29.58,0:02:31.95,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:33.55,0:02:36.06,Default,,0000,0000,0000,,Джинджи-сама үшін бұл аздап қараңғы.
Dialogue: 0,0:02:33.55,0:02:36.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:36.06,0:02:39.59,Default,,0000,0000,0000,,Бетті өзгерте алады
Dialogue: 0,0:02:36.06,0:02:39.59,Default,,0000,0000,0000,,Менде дәрі-дәрмек болса ыңғайлы болар еді.
Dialogue: 0,0:02:36.06,0:02:39.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:39.59,0:02:45.03,Default,,0000,0000,0000,,Бетке лак жағу жеткілікті.
Dialogue: 0,0:02:39.59,0:02:45.03,Default,,0000,0000,0000,,Менің жаным… Ұйықтар алдында әр түн сайын➡
Dialogue: 0,0:02:39.59,0:02:45.03,Default,,0000,0000,0000,,Ол қайтып оралмайды
Dialogue: 0,0:02:39.59,0:02:45.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:45.03,0:02:47.07,Default,,0000,0000,0000,,Келесі, мына жігіт
Dialogue: 0,0:02:45.03,0:02:47.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:47.07,0:02:50.54,Default,,0000,0000,0000,,Мен қарапайым адам болып көрінгім келеді
Dialogue: 0,0:02:47.07,0:02:50.54,Default,,0000,0000,0000,,Егер солай болса➡
Dialogue: 0,0:02:50.54,0:02:53.04,Default,,0000,0000,0000,,Менің қолымнан келмейтін ештеңе жоқ.
Dialogue: 0,0:02:50.54,0:02:53.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:53.04,0:02:55.54,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:02:53.04,0:02:55.54,Default,,0000,0000,0000,,Оны сұраңыз
Dialogue: 0,0:02:53.04,0:02:55.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:55.54,0:02:59.05,Default,,0000,0000,0000,,Мен қазір
Dialogue: 0,0:02:55.54,0:02:59.05,Default,,0000,0000,0000,,Мені мүлде басқа адам ет.
Dialogue: 0,0:02:55.54,0:02:59.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:02.08,0:03:04.58,Default,,0000,0000,0000,,Мәңгілік шың тек менікі
Dialogue: 0,0:03:02.08,0:03:04.58,Default,,0000,0000,0000,,Сіз не істемексіз?
Dialogue: 0,0:03:02.08,0:03:04.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:06.65,0:03:08.12,Default,,0000,0000,0000,,Тек...
Dialogue: 0,0:03:06.65,0:03:08.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:09.56,0:03:12.06,Default,,0000,0000,0000,,Егер мұны істегіңіз келсе, оны мұқият орындаңыз!
Dialogue: 0,0:03:12.06,0:03:14.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:12.06,0:03:14.56,Default,,0000,0000,0000,,Желдің дыбысы
Dialogue: 0,0:03:12.06,0:03:14.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:14.56,0:03:17.06,Default,,0000,0000,0000,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:03:14.56,0:03:17.06,Default,,0000,0000,0000,,Суық...
Dialogue: 0,0:03:14.56,0:03:17.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:17.06,0:03:19.57,Default,,0000,0000,0000,,Қайырлы таң...
Dialogue: 0,0:03:17.06,0:03:19.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:23.57,0:03:26.07,Default,,0000,0000,0000,,《О...》
Dialogue: 0,0:03:26.07,0:03:29.14,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:03:26.07,0:03:29.14,Default,,0000,0000,0000,,Бүгін таңертеңнен бері көңіл-күйіңіз нашар.
Dialogue: 0,0:03:26.07,0:03:29.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:29.14,0:03:33.55,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:03:29.14,0:03:33.55,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:03:29.14,0:03:33.55,Default,,0000,0000,0000,,Бүгін тағы бір күн
Dialogue: 0,0:03:29.14,0:03:33.55,Default,,0000,0000,0000,,Бұл әдемі емес пе?
Dialogue: 0,0:03:29.14,0:03:33.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:33.55,0:03:35.55,Default,,0000,0000,0000,,Сізге жаңа ойыншылар ұнамайды ма?
Dialogue: 0,0:03:35.55,0:03:40.09,Default,,0000,0000,0000,,Джинджи мырза шынымен
Dialogue: 0,0:03:35.55,0:03:40.09,Default,,0000,0000,0000,,Сіз басқа біреу болғыңыз келе ме?
Dialogue: 0,0:03:40.09,0:03:42.59,Default,,0000,0000,0000,,Кеше түннен бері
Dialogue: 0,0:03:40.09,0:03:42.59,Default,,0000,0000,0000,,Міне, сіз айтып отырсыз.
Dialogue: 0,0:03:40.09,0:03:42.59,Default,,0000,0000,0000,,. [жиырма бес] .
Dialogue: 0,0:03:42.59,0:03:45.06,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:03:42.59,0:03:45.06,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:03:42.59,0:03:45.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:48.56,0:03:50.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:48.56,0:03:50.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:52.10,0:03:54.13,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:03:52.10,0:03:54.13,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:52.10,0:03:54.13,Default,,0000,0000,0000,,Су лотосу
Dialogue: 0,0:03:52.10,0:03:54.13,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:52.10,0:03:54.13,Default,,0000,0000,0000,,Раббым!
Dialogue: 0,0:03:52.10,0:03:54.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:54.13,0:03:56.07,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:54.13,0:03:56.07,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:03:54.13,0:03:56.07,Default,,0000,0000,0000,,Кенеттен
Dialogue: 0,0:03:54.13,0:03:56.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:56.07,0:04:00.07,Default,,0000,0000,0000,,Осындай тамаша хош иісті заттарды тартатын қарапайым халық
Dialogue: 0,0:03:56.07,0:04:00.07,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:03:56.07,0:04:00.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:00.07,0:04:04.54,Default,,0000,0000,0000,,Джиндзи-саманың қазіргі киімі
Dialogue: 0,0:04:00.07,0:04:04.54,Default,,0000,0000,0000,,Көбінесе төменгі лауазымдағы шенеуніктің күнделікті киімі.
Dialogue: 0,0:04:00.07,0:04:04.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:04.54,0:04:07.55,Default,,0000,0000,0000,,Теңіздің арғы жағынан бұйырды
Dialogue: 0,0:04:04.54,0:04:07.55,Default,,0000,0000,0000,,Ең жоғары сапалы хош иісті ағаш қандай?➡
Dialogue: 0,0:04:07.55,0:04:10.08,Default,,0000,0000,0000,,Ешқандай байланыс болмауы керек.
Dialogue: 0,0:04:07.55,0:04:10.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:07.55,0:04:10.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:07.55,0:04:10.08,Default,,0000,0000,0000,,Иіскеу дыбысы
Dialogue: 0,0:04:07.55,0:04:10.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:10.08,0:04:11.58,Default,,0000,0000,0000,,Мен түсінемін.
Dialogue: 0,0:04:10.08,0:04:11.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:11.58,0:04:16.66,Default,,0000,0000,0000,,Дәрілік және улы шөптерді ажырату
Dialogue: 0,0:04:11.58,0:04:16.66,Default,,0000,0000,0000,,Мен жақсы мұрынды жаңа ғана үйрендім.
Dialogue: 0,0:04:11.58,0:04:16.66,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:16.66,0:04:19.56,Default,,0000,0000,0000,,Джиро
Dialogue: 0,0:04:16.66,0:04:19.56,Default,,0000,0000,0000,,Гарнизонның қонақтарын қалай анықтауға болады
Dialogue: 0,0:04:16.66,0:04:19.56,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:04:19.56,0:04:22.56,Default,,0000,0000,0000,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:04:19.56,0:04:22.56,Default,,0000,0000,0000,,Дене пішіні немесе киім бе?
Dialogue: 0,0:04:22.56,0:04:26.07,Default,,0000,0000,0000,,Бұл да бар.
Dialogue: 0,0:04:22.56,0:04:26.07,Default,,0000,0000,0000,,Тағы бір нәрсе
Dialogue: 0,0:04:22.56,0:04:26.07,Default,,0000,0000,0000,,Бұл иіс.
Dialogue: 0,0:04:22.56,0:04:26.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:26.07,0:04:29.57,Default,,0000,0000,0000,,Дәмсіз хош иісті зат
Dialogue: 0,0:04:26.07,0:04:29.57,Default,,0000,0000,0000,,Бірнеше рет дрейфтейтін тұтынушы ➡
Dialogue: 0,0:04:29.57,0:04:33.57,Default,,0000,0000,0000,,Менде ақша бар, бірақ жыныстық жолмен берілетін аурулардың ықтималдығы жоғары.
Dialogue: 0,0:04:29.57,0:04:33.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:33.57,0:04:37.61,Default,,0000,0000,0000,,Малдың иісін сезсең
Dialogue: 0,0:04:33.57,0:04:37.61,Default,,0000,0000,0000,,Ваннаға түспеу және гигиеналық талаптарға сай келмеу
Dialogue: 0,0:04:33.57,0:04:37.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:37.61,0:04:41.65,Default,,0000,0000,0000,,Рокушокан
Dialogue: 0,0:04:37.61,0:04:41.65,Default,,0000,0000,0000,,Рёкусейканға келіңіз
Dialogue: 0,0:04:37.61,0:04:41.65,Default,,0000,0000,0000,,Ичигеннің тұтынушысы
Dialogue: 0,0:04:37.61,0:04:41.65,Default,,0000,0000,0000,,Қуып кете жаздады
Dialogue: 0,0:04:37.61,0:04:41.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:41.65,0:04:43.58,Default,,0000,0000,0000,,Хо…
Dialogue: 0,0:04:41.65,0:04:43.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:43.58,0:04:45.59,Default,,0000,0000,0000,,Лакан
Dialogue: 0,0:04:43.58,0:04:45.59,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:43.58,0:04:45.59,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:04:43.58,0:04:45.59,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:43.58,0:04:45.59,Default,,0000,0000,0000,,｟Осындай нәрсе➡
Dialogue: 0,0:04:45.59,0:04:48.55,Default,,0000,0000,0000,,Дүниені танитындарға
Dialogue: 0,0:04:45.59,0:04:48.55,Default,,0000,0000,0000,,Сұрау жылдамырақ＠
Dialogue: 0,0:04:50.06,0:04:54.06,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:04:50.06,0:04:54.06,Default,,0000,0000,0000,,Гаошун мырза
Dialogue: 0,0:04:50.06,0:04:54.06,Default,,0000,0000,0000,,Қосымша киім дайындаңыз
Dialogue: 0,0:04:50.06,0:04:54.06,Default,,0000,0000,0000,,Өтінемін?
Dialogue: 0,0:04:54.06,0:04:58.10,Default,,0000,0000,0000,,Мүмкін болса
Dialogue: 0,0:04:54.06,0:04:58.10,Default,,0000,0000,0000,,Иіс қалады
Dialogue: 0,0:04:54.06,0:04:58.10,Default,,0000,0000,0000,,Жуу алдында жақсырақ.
Dialogue: 0,0:04:54.06,0:04:58.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:58.10,0:04:59.63,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:04:58.10,0:04:59.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:59.63,0:05:02.17,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:59.63,0:05:02.17,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:04:59.63,0:05:02.17,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:59.63,0:05:02.17,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:04:59.63,0:05:02.17,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:59.63,0:05:02.17,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:04:59.63,0:05:02.17,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:02.17,0:05:04.14,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:05:02.17,0:05:04.14,Default,,0000,0000,0000,,Осы арада…
Dialogue: 0,0:05:02.17,0:05:04.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:07.57,0:05:11.04,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:05:07.57,0:05:11.04,Default,,0000,0000,0000,,Май және тұз
Dialogue: 0,0:05:07.57,0:05:11.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:11.04,0:05:16.58,Default,,0000,0000,0000,,Бұл шашыңыздың жылтырын кетіреді.
Dialogue: 0,0:05:11.04,0:05:16.58,Default,,0000,0000,0000,,Текстураны нашарлатады
Dialogue: 0,0:05:11.04,0:05:16.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:16.58,0:05:19.59,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:05:16.58,0:05:19.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:16.58,0:05:19.59,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:16.58,0:05:19.59,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:16.58,0:05:19.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:21.09,0:05:31.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:31.06,0:05:33.57,Default,,0000,0000,0000,,《Уақыт келді
Dialogue: 0,0:05:31.06,0:05:33.57,Default,,0000,0000,0000,,Жақсы ма?》
Dialogue: 0,0:05:34.57,0:05:38.57,Default,,0000,0000,0000,,О.
Dialogue: 0,0:05:34.57,0:05:38.57,Default,,0000,0000,0000,,«Сенім артамын.»
Dialogue: 0,0:05:34.57,0:05:38.57,Default,,0000,0000,0000,,Бұндай сынықпен байламасаң да
Dialogue: 0,0:05:34.57,0:05:38.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:38.57,0:05:42.08,Default,,0000,0000,0000,,Қарапайым адамдар
Dialogue: 0,0:05:38.57,0:05:42.08,Default,,0000,0000,0000,,Егер оны қорытындылауға болатын болса
Dialogue: 0,0:05:38.57,0:05:42.08,Default,,0000,0000,0000,,Бәрі жақсы.
Dialogue: 0,0:05:38.57,0:05:42.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:42.08,0:05:45.55,Default,,0000,0000,0000,,Мұның дұрыс екеніне сенімдісіз бе?
Dialogue: 0,0:05:47.08,0:05:49.62,Default,,0000,0000,0000,,Күн
Dialogue: 0,0:05:47.08,0:05:49.62,Default,,0000,0000,0000,,Кункун…
Dialogue: 0,0:05:47.08,0:05:49.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:49.62,0:05:53.09,Default,,0000,0000,0000,,Сасық болғанын қалаймын.
Dialogue: 0,0:05:49.62,0:05:53.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:49.62,0:05:53.09,Default,,0000,0000,0000,,Эй...!
Dialogue: 0,0:05:53.09,0:05:55.56,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:05:53.09,0:05:55.56,Default,,0000,0000,0000,,Киіміңізді шешіңіз.
Dialogue: 0,0:05:53.09,0:05:55.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:55.56,0:05:57.56,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:55.56,0:05:57.56,Default,,0000,0000,0000,,О
Dialogue: 0,0:05:55.56,0:05:57.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:00.06,0:06:01.56,Default,,0000,0000,0000,,А...
Dialogue: 0,0:06:00.06,0:06:01.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:01.56,0:06:04.06,Default,,0000,0000,0000,,《Аспанның қызындай болса да➡
Dialogue: 0,0:06:04.06,0:06:07.07,Default,,0000,0000,0000,,Жақсы пропорционалды және бұлшықетті дене.
Dialogue: 0,0:06:08.57,0:06:11.17,Default,,0000,0000,0000,,Мен бұл орамалды қолдана аламын ба?
Dialogue: 0,0:06:11.17,0:06:14.17,Default,,0000,0000,0000,,Мен қарсы емеспін.
Dialogue: 0,0:06:11.17,0:06:14.17,Default,,0000,0000,0000,,Сіз не істейсіз?
Dialogue: 0,0:06:14.17,0:06:16.58,Default,,0000,0000,0000,,Дене пішініңізді өзгертіңіз
Dialogue: 0,0:06:14.17,0:06:16.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:16.58,0:06:20.05,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:06:16.58,0:06:20.05,Default,,0000,0000,0000,,Екеуің де
Dialogue: 0,0:06:16.58,0:06:20.05,Default,,0000,0000,0000,,Маған көмектесе аласыз ба?
Dialogue: 0,0:06:21.55,0:06:25.08,Default,,0000,0000,0000,,Лорд Гаошун
Dialogue: 0,0:06:21.55,0:06:25.08,Default,,0000,0000,0000,,Осылайша
Dialogue: 0,0:06:21.55,0:06:25.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:21.55,0:06:25.08,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:21.55,0:06:25.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:25.08,0:06:28.05,Default,,0000,0000,0000,,Сүйрен-сама
Dialogue: 0,0:06:25.08,0:06:28.05,Default,,0000,0000,0000,,Мұнда басыңыз
Dialogue: 0,0:06:25.08,0:06:28.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:25.08,0:06:28.05,Default,,0000,0000,0000,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:06:25.08,0:06:28.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:28.05,0:06:30.59,Default,,0000,0000,0000,,Үстінен киім кисеңіз...
Dialogue: 0,0:06:28.05,0:06:30.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:30.59,0:06:33.59,Default,,0000,0000,0000,,Хоо~
Dialogue: 0,0:06:30.59,0:06:33.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:30.59,0:06:33.59,Default,,0000,0000,0000,,О, құдай!
Dialogue: 0,0:06:30.59,0:06:33.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:33.59,0:06:35.13,Default,,0000,0000,0000,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:06:33.59,0:06:35.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:35.13,0:06:39.20,Default,,0000,0000,0000,,《Дене пішіні дұрыс емес
Dialogue: 0,0:06:35.13,0:06:39.20,Default,,0000,0000,0000,,Джинджи-саманың бет-бейнесі ➡
Dialogue: 0,0:06:39.20,0:06:41.07,Default,,0000,0000,0000,,Бұл өте біртүрлі.
Dialogue: 0,0:06:41.07,0:06:44.07,Default,,0000,0000,0000,,Келесі бет.
Dialogue: 0,0:06:41.07,0:06:44.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:41.07,0:06:44.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:44.07,0:06:47.57,Default,,0000,0000,0000,,Қара ұнтақ
Dialogue: 0,0:06:44.07,0:06:47.57,Default,,0000,0000,0000,,Мен кейбір нәрселерді өңдедім.
Dialogue: 0,0:06:44.07,0:06:47.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:47.57,0:06:51.54,Default,,0000,0000,0000,,Енді қарапайым адам сияқты
Dialogue: 0,0:06:47.57,0:06:51.54,Default,,0000,0000,0000,,Күйген теріні жасаңыз
Dialogue: 0,0:06:47.57,0:06:51.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:51.54,0:06:53.58,Default,,0000,0000,0000,,Көзіңізді жұмыңыз
Dialogue: 0,0:06:51.54,0:06:53.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:53.58,0:06:55.08,Default,,0000,0000,0000,,О
Dialogue: 0,0:06:53.58,0:06:55.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:58.08,0:07:01.12,Default,,0000,0000,0000,,《Жақын жерде ұстасаңыз да
Dialogue: 0,0:06:58.08,0:07:01.12,Default,,0000,0000,0000,,Қажетсіз әдемі》
Dialogue: 0,0:07:01.12,0:07:04.56,Default,,0000,0000,0000,,《Мен сақалымды былай қойғанда, тері тесіктерімді де көре алмаймын.》
Dialogue: 0,0:07:04.56,0:07:07.06,Default,,0000,0000,0000,,《Әйелдер боянып жүрсең
Dialogue: 0,0:07:04.56,0:07:07.06,Default,,0000,0000,0000,,Маңызды емес...》
Dialogue: 0,0:07:07.06,0:07:09.06,Default,,0000,0000,0000,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:07:09.06,0:07:10.56,Default,,0000,0000,0000,,《Hehe~》
Dialogue: 0,0:07:10.56,0:07:12.06,Default,,0000,0000,0000,,《Няняняня~》
Dialogue: 0,0:07:12.06,0:07:16.07,Default,,0000,0000,0000,,Меймей Ни Чан
Dialogue: 0,0:07:12.06,0:07:16.07,Default,,0000,0000,0000,,《Ол жерде болды~
Dialogue: 0,0:07:12.06,0:07:16.07,Default,,0000,0000,0000,,Мэй Мэйге
Dialogue: 0,0:07:12.06,0:07:16.07,Default,,0000,0000,0000,,Мені мәжбүрлеген адам》
Dialogue: 0,0:07:16.07,0:07:17.57,Default,,0000,0000,0000,,Қара…
Dialogue: 0,0:07:16.07,0:07:17.57,Default,,0000,0000,0000,,Әлі емес пе?
Dialogue: 0,0:07:17.57,0:07:21.67,Default,,0000,0000,0000,,Аузыңызды жауып жібере аласыз ба?
Dialogue: 0,0:07:17.57,0:07:21.67,Default,,0000,0000,0000,,Ешбір күшсіз
Dialogue: 0,0:07:17.57,0:07:21.67,Default,,0000,0000,0000,,. [жиырма бір] .
Dialogue: 0,0:07:21.67,0:07:23.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:21.67,0:07:23.64,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:07:21.67,0:07:23.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:31.55,0:07:33.55,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:07:33.55,0:07:36.06,Default,,0000,0000,0000,,《Осы үш адам болғанына қуаныштымын》
Dialogue: 0,0:07:36.06,0:07:39.56,Default,,0000,0000,0000,,«Егер басқа біреу болса
Dialogue: 0,0:07:36.06,0:07:39.56,Default,,0000,0000,0000,,Бұл апат болды》
Dialogue: 0,0:07:39.56,0:07:42.56,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:07:39.56,0:07:42.56,Default,,0000,0000,0000,,Сүйегім сынды!
Dialogue: 0,0:07:42.56,0:07:45.06,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:07:42.56,0:07:45.06,Default,,0000,0000,0000,,Ештеңе
Dialogue: 0,0:07:42.56,0:07:45.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:45.06,0:07:47.07,Default,,0000,0000,0000,,Бұл ауырады
Dialogue: 0,0:07:45.06,0:07:47.07,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:07:47.07,0:07:48.60,Default,,0000,0000,0000,,Ештеңе
Dialogue: 0,0:07:47.07,0:07:48.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:48.60,0:07:51.67,Default,,0000,0000,0000,,Ештеңе.
Dialogue: 0,0:07:48.60,0:07:51.67,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:48.60,0:07:51.67,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:48.60,0:07:51.67,Default,,0000,0000,0000,,Ештеңе жоқ.
Dialogue: 0,0:07:48.60,0:07:51.67,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:51.67,0:07:54.07,Default,,0000,0000,0000,,Өзіңізді ұсыныңыз...
Dialogue: 0,0:07:51.67,0:07:54.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:54.07,0:07:57.08,Default,,0000,0000,0000,,Бетіңізге ұнтақпен дақ қойыңыз➡
Dialogue: 0,0:07:57.08,0:08:00.08,Default,,0000,0000,0000,,Әлі емес.
Dialogue: 0,0:07:57.08,0:08:00.08,Default,,0000,0000,0000,,Қою түстермен қара шеңберлер жасаңыз
Dialogue: 0,0:07:57.08,0:08:00.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:00.08,0:08:02.08,Default,,0000,0000,0000,,Моль қосыңыз➡
Dialogue: 0,0:08:02.08,0:08:07.09,Default,,0000,0000,0000,,Сол және оң қастың өлшемін өзгерту кезінде
Dialogue: 0,0:08:02.08,0:08:07.09,Default,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:08:02.08,0:08:07.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:07.09,0:08:11.62,Default,,0000,0000,0000,,Қалған ұнтақ
Dialogue: 0,0:08:07.09,0:08:11.62,Default,,0000,0000,0000,,Дақтар жасау үшін дененің әртүрлі бөліктеріне жағыңыз➡
Dialogue: 0,0:08:11.62,0:08:15.70,Default,,0000,0000,0000,,Сондай-ақ тырнақтарыңыздың арасына салыңыз.
Dialogue: 0,0:08:11.62,0:08:15.70,Default,,0000,0000,0000,,Антисанитариялық қолдар жасайды
Dialogue: 0,0:08:11.62,0:08:15.70,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:15.70,0:08:17.56,Default,,0000,0000,0000,,《Жақсы адамның қолдары》
Dialogue: 0,0:08:17.56,0:08:20.07,Default,,0000,0000,0000,,《Ақ балық қолынан күткендей...》
Dialogue: 0,0:08:20.07,0:08:22.57,Default,,0000,0000,0000,,《Хмм?
Dialogue: 0,0:08:20.07,0:08:22.57,Default,,0000,0000,0000,,Сегізаяқ бар》
Dialogue: 0,0:08:22.57,0:08:26.07,Default,,0000,0000,0000,,《Әдетте
Dialogue: 0,0:08:22.57,0:08:26.07,Default,,0000,0000,0000,,Тек щетка немесе таяқша
Dialogue: 0,0:08:22.57,0:08:26.07,Default,,0000,0000,0000,,Менде бұл болмайды деп ойладым.
Dialogue: 0,0:08:26.07,0:08:30.08,Default,,0000,0000,0000,,《Қылыш шеберлігі немесе таяқ жеу
Dialogue: 0,0:08:26.07,0:08:30.08,Default,,0000,0000,0000,,Сіз мұны істеп жатырсыз ба? 》
Dialogue: 0,0:08:30.08,0:08:33.58,Default,,0000,0000,0000,,Канган
Dialogue: 0,0:08:30.08,0:08:33.58,Default,,0000,0000,0000,,《Бастапқыда
Dialogue: 0,0:08:30.08,0:08:33.58,Default,,0000,0000,0000,,Евнухқа
Dialogue: 0,0:08:30.08,0:08:33.58,Default,,0000,0000,0000,,Бұл қажет емес...》
Dialogue: 0,0:08:33.58,0:08:37.65,Default,,0000,0000,0000,,《Жақсы
Dialogue: 0,0:08:33.58,0:08:37.65,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:08:33.58,0:08:37.65,Default,,0000,0000,0000,,Ақылсыз сұрақ қойыңыз
Dialogue: 0,0:08:33.58,0:08:37.65,Default,,0000,0000,0000,,Қажет емес
Dialogue: 0,0:08:37.65,0:08:40.59,Default,,0000,0000,0000,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:08:37.65,0:08:40.59,Default,,0000,0000,0000,,Кір сияқты
Dialogue: 0,0:08:37.65,0:08:40.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:40.59,0:08:42.09,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:08:40.59,0:08:42.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:42.09,0:08:44.56,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:42.09,0:08:44.56,Default,,0000,0000,0000,,Сусын?
Dialogue: 0,0:08:47.06,0:08:48.56,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:08:48.56,0:08:50.06,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:48.56,0:08:50.06,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:08:48.56,0:08:50.06,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:08:48.56,0:08:50.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:50.06,0:08:53.57,Default,,0000,0000,0000,,Ерніңді сулағандай
Dialogue: 0,0:08:50.06,0:08:53.57,Default,,0000,0000,0000,,Баяу жалаңыз
Dialogue: 0,0:08:50.06,0:08:53.57,Default,,0000,0000,0000,,Enge
Dialogue: 0,0:08:50.06,0:08:53.57,Default,,0000,0000,0000,,Өтінемін, жұтып қойыңыз
Dialogue: 0,0:08:50.06,0:08:53.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:53.57,0:08:56.64,Default,,0000,0000,0000,,Ерні мен тамағы ісінген
Dialogue: 0,0:08:53.57,0:08:56.64,Default,,0000,0000,0000,,Өйткені дауыс өзгереді
Dialogue: 0,0:08:53.57,0:08:56.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:56.64,0:08:58.67,Default,,0000,0000,0000,,Онда не бар?
Dialogue: 0,0:08:58.67,0:09:00.57,Default,,0000,0000,0000,,Бірнеше тітіркендіргіштер
Dialogue: 0,0:08:58.67,0:09:00.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:00.57,0:09:05.08,Default,,0000,0000,0000,,Бұл өте ауыр
Dialogue: 0,0:09:00.57,0:09:05.08,Default,,0000,0000,0000,,Ол улы емес.
Dialogue: 0,0:09:00.57,0:09:05.08,Default,,0000,0000,0000,,Уайымдамаңыз
Dialogue: 0,0:09:00.57,0:09:05.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:05.08,0:09:07.08,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:09:05.08,0:09:07.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:10.08,0:09:12.05,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:09:10.08,0:09:12.05,Default,,0000,0000,0000,,Ішіңіз
Dialogue: 0,0:09:10.08,0:09:12.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:12.05,0:09:15.59,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:12.05,0:09:15.59,Default,,0000,0000,0000,,Қатты дауыспен
Dialogue: 0,0:09:12.05,0:09:15.59,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:12.05,0:09:15.59,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:12.05,0:09:15.59,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:12.05,0:09:15.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:15.59,0:09:18.66,Default,,0000,0000,0000,,Соңғы жанасулар
Dialogue: 0,0:09:15.59,0:09:18.66,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:18.66,0:09:23.16,Default,,0000,0000,0000,,Мақта
Dialogue: 0,0:09:18.66,0:09:23.16,Default,,0000,0000,0000,,Контурды өзгерту үшін
Dialogue: 0,0:09:18.66,0:09:23.16,Default,,0000,0000,0000,,Оны бетіңізге жағыңыз.
Dialogue: 0,0:09:18.66,0:09:23.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:26.60,0:09:29.57,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:09:26.60,0:09:29.57,Default,,0000,0000,0000,,Аяқталды
Dialogue: 0,0:09:26.60,0:09:29.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:34.11,0:09:37.08,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:09:34.11,0:09:37.08,Default,,0000,0000,0000,,​​Шынымен де, Ботчан?
Dialogue: 0,0:09:37.08,0:09:39.55,Default,,0000,0000,0000,,Ботчан
Dialogue: 0,0:09:37.08,0:09:39.55,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:09:37.08,0:09:39.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:39.55,0:09:42.58,Default,,0000,0000,0000,,《Әлі екінші жарымға жуық
Dialogue: 0,0:09:39.55,0:09:42.58,Default,,0000,0000,0000,,Өйткені сіз оны көре аласыз➡
Dialogue: 0,0:09:42.58,0:09:45.12,Default,,0000,0000,0000,,Түпнұсқа ізгілік – проблема.
Dialogue: 0,0:09:45.12,0:09:49.12,Default,,0000,0000,0000,,《Бәрібір
Dialogue: 0,0:09:45.12,0:09:49.12,Default,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:09:51.56,0:09:55.06,Default,,0000,0000,0000,,Жүр
Dialogue: 0,0:09:51.56,0:09:55.06,Default,,0000,0000,0000,,Менің үйге оралмағаныма көп уақыт болды.
Dialogue: 0,0:09:51.56,0:09:55.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:55.06,0:09:58.56,Default,,0000,0000,0000,,Сяомао
Dialogue: 0,0:09:55.06,0:09:58.56,Default,,0000,0000,0000,,Конеко
Dialogue: 0,0:09:55.06,0:09:58.56,Default,,0000,0000,0000,,Мен бүгін ата-анамның үйіне барғанымда,
Dialogue: 0,0:09:55.06,0:09:58.56,Default,,0000,0000,0000,,Сіз мұны айттыңыз
Dialogue: 0,0:09:55.06,0:09:58.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:58.56,0:10:01.07,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:58.56,0:10:01.07,Default,,0000,0000,0000,,Ертеңге дейін бос уақытым бар, сондықтан
Dialogue: 0,0:09:58.56,0:10:01.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:01.07,0:10:02.57,Default,,0000,0000,0000,,А...
Dialogue: 0,0:10:01.07,0:10:02.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:02.57,0:10:06.57,Default,,0000,0000,0000,,《Гаошун мырза үшін,
Dialogue: 0,0:10:02.57,0:10:06.57,Default,,0000,0000,0000,,Бұл әдеттен тыс өрнек.
Dialogue: 0,0:10:06.57,0:10:10.64,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:10:06.57,0:10:10.64,Default,,0000,0000,0000,,Джиндзи-сама да
Dialogue: 0,0:10:06.57,0:10:10.64,Default,,0000,0000,0000,,Бұл жол бойы бірдей жол.
Dialogue: 0,0:10:06.57,0:10:10.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:10.64,0:10:13.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:10.64,0:10:13.18,Default,,0000,0000,0000,,《Гах...》
Dialogue: 0,0:10:13.18,0:10:15.08,Default,,0000,0000,0000,,Басқа біреу ретінде жасырылған кезде➡
Dialogue: 0,0:10:15.08,0:10:19.09,Default,,0000,0000,0000,,Неге әдеттегідей қызметшіні әкелмеске?
Dialogue: 0,0:10:15.08,0:10:19.09,Default,,0000,0000,0000,,Бұл біртүрлі болып көрінеді
Dialogue: 0,0:10:15.08,0:10:19.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:19.09,0:10:22.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:19.09,0:10:22.09,Default,,0000,0000,0000,,Су лотосу
Dialogue: 0,0:10:19.09,0:10:22.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:19.09,0:10:22.09,Default,,0000,0000,0000,,О.
Dialogue: 0,0:10:19.09,0:10:22.09,Default,,0000,0000,0000,,Міне саған – қоштасу сүйісі.
Dialogue: 0,0:10:19.09,0:10:22.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:22.09,0:10:25.06,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:10:22.09,0:10:25.06,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:10:22.09,0:10:25.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:22.09,0:10:25.06,Default,,0000,0000,0000,,Джинджи мырза да
Dialogue: 0,0:10:22.09,0:10:25.06,Default,,0000,0000,0000,,Жарайды онда. Мен перделерді жауып, шамдарды өшіремін.
Dialogue: 0,0:10:25.06,0:10:27.59,Default,,0000,0000,0000,,That's right.
Dialogue: 0,0:10:25.06,0:10:27.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:27.59,0:10:30.10,Default,,0000,0000,0000,,Келсеңіз пайдалы болар еді.
Dialogue: 0,0:10:27.59,0:10:30.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:30.10,0:10:32.63,Default,,0000,0000,0000,,《Мен қаламаймын
Dialogue: 0,0:10:30.10,0:10:32.63,Default,,0000,0000,0000,,Джинджи мырза да ынталы! 》
Dialogue: 0,0:10:32.63,0:10:34.67,Default,,0000,0000,0000,,Кешіріңіз➡
Dialogue: 0,0:10:34.67,0:10:38.07,Default,,0000,0000,0000,,Джинджи мырзаның соңынан ерсем де
Dialogue: 0,0:10:34.67,0:10:38.07,Default,,0000,0000,0000,,Мен оның орнына жақсырақ көрінеді деп ойладым...
Dialogue: 0,0:10:34.67,0:10:38.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:38.07,0:10:40.57,Default,,0000,0000,0000,,Қарапайым киінген шеберге өте қолайлы➡
Dialogue: 0,0:10:40.57,0:10:43.58,Default,,0000,0000,0000,,Қарапайым қызметші жақсырақ
Dialogue: 0,0:10:40.57,0:10:43.58,Default,,0000,0000,0000,,Бұл қолайлы болуы мүмкін➡
Dialogue: 0,0:10:43.58,0:10:47.08,Default,,0000,0000,0000,,Мен де бөлмесі бар қызметшімін.
Dialogue: 0,0:10:43.58,0:10:47.08,Default,,0000,0000,0000,,Белгілі...
Dialogue: 0,0:10:43.58,0:10:47.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:47.08,0:10:48.58,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:10:47.08,0:10:48.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:48.58,0:10:52.08,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:10:48.58,0:10:52.08,Default,,0000,0000,0000,,Егер Конеко да бетперде болса
Dialogue: 0,0:10:48.58,0:10:52.08,Default,,0000,0000,0000,,Міне — жер астында.
Dialogue: 0,0:10:52.08,0:10:54.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:52.08,0:10:54.62,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:10:52.08,0:10:54.62,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:10:52.08,0:10:54.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:54.62,0:10:57.69,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:54.62,0:10:57.69,Default,,0000,0000,0000,,Макияжға арналған щетка
Dialogue: 0,0:10:54.62,0:10:57.69,Default,,0000,0000,0000,,Шаш қыстырғыш➡
Dialogue: 0,0:10:57.69,0:10:59.56,Default,,0000,0000,0000,,Әртүрлі
Dialogue: 0,0:10:57.69,0:10:59.56,Default,,0000,0000,0000,,Барлығы сонда.
Dialogue: 0,0:10:57.69,0:10:59.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:59.56,0:11:01.06,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:10:59.56,0:11:01.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:01.06,0:11:04.60,Default,,0000,0000,0000,,Even though it doesn't look like usual, it doesn't look like it.
Dialogue: 0,0:11:01.06,0:11:04.60,Default,,0000,0000,0000,,Мен қалаймын, солай ма?
Dialogue: 0,0:11:04.60,0:11:05.56,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:11:04.60,0:11:05.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:05.56,0:11:07.60,Default,,0000,0000,0000,,Эй?
Dialogue: 0,0:11:07.60,0:11:09.57,Default,,0000,0000,0000,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:11:07.60,0:11:09.57,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:11:07.60,0:11:09.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:09.57,0:11:12.07,Default,,0000,0000,0000,,《Менде тек жаман сезім бар》
Dialogue: 0,0:11:18.54,0:11:21.05,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:11:18.54,0:11:21.05,Default,,0000,0000,0000,,Сіздің қалпыңыз тым әдемі
Dialogue: 0,0:11:18.54,0:11:21.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:21.05,0:11:23.05,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:21.05,0:11:23.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:23.05,0:11:25.02,Default,,0000,0000,0000,,Бұл сізсіз
Dialogue: 0,0:11:23.05,0:11:25.02,Default,,0000,0000,0000,,Бұл дыбысты тоқтатыңыз.
Dialogue: 0,0:11:23.05,0:11:25.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:25.02,0:11:28.05,Default,,0000,0000,0000,,Егер сіз оған өз атыңызды айтсаңыз
Dialogue: 0,0:11:25.02,0:11:28.05,Default,,0000,0000,0000,,Бетперделеудің мағынасы жоқ.
Dialogue: 0,0:11:25.02,0:11:28.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:28.05,0:11:31.09,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:11:28.05,0:11:31.09,Default,,0000,0000,0000,,Оны қалай атау керек?
Dialogue: 0,0:11:28.05,0:11:31.09,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:11:31.09,0:11:33.63,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:11:31.09,0:11:33.63,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:11:31.09,0:11:33.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:33.63,0:11:38.53,Default,,0000,0000,0000,,Джинка
Dialogue: 0,0:11:33.63,0:11:38.53,Default,,0000,0000,0000,,Сіз мені Михуа деп атай аласыз.
Dialogue: 0,0:11:33.63,0:11:38.53,Default,,0000,0000,0000,,Маған қоңырау шалыңыз
Dialogue: 0,0:11:33.63,0:11:38.53,Default,,0000,0000,0000,,Ханым
Dialogue: 0,0:11:33.63,0:11:38.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:38.53,0:11:40.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:40.03,0:11:44.04,Default,,0000,0000,0000,,Сыртқы түрі бойынша
Dialogue: 0,0:11:40.03,0:11:44.04,Default,,0000,0000,0000,,Менің ойымша, бұл ақылға қонымды.
Dialogue: 0,0:11:40.03,0:11:44.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:44.04,0:11:46.54,Default,,0000,0000,0000,,《Шынында да...➡
Dialogue: 0,0:11:46.54,0:11:48.54,Default,,0000,0000,0000,,Сүйрен-саманың қызына тиесілі➡
Dialogue: 0,0:11:48.54,0:11:52.55,Default,,0000,0000,0000,,Матасы, дизайны және тігуі жақсы.
Dialogue: 0,0:11:48.54,0:11:52.55,Default,,0000,0000,0000,,Ескі емес➡
Dialogue: 0,0:11:52.55,0:11:55.05,Default,,0000,0000,0000,,Егер бұл тек сыртқы көрініске қатысты болса
Dialogue: 0,0:11:52.55,0:11:55.05,Default,,0000,0000,0000,,Жақсы орын
Dialogue: 0,0:11:52.55,0:11:55.05,Default,,0000,0000,0000,,Мені жас ханым десең де➡
Dialogue: 0,0:11:55.05,0:11:57.12,Default,,0000,0000,0000,,Бұл таңқаларлық емес》
Dialogue: 0,0:11:57.12,0:12:00.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:57.12,0:12:00.12,Default,,0000,0000,0000,,Ах, мен аштан қарип кеттім.
Dialogue: 0,0:11:57.12,0:12:00.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:00.12,0:12:03.02,Default,,0000,0000,0000,,《Не?
Dialogue: 0,0:12:00.12,0:12:03.02,Default,,0000,0000,0000,,Бұл өте қызық》
Dialogue: 0,0:12:06.03,0:12:09.56,Default,,0000,0000,0000,,Міне карта
Dialogue: 0,0:12:06.03,0:12:09.56,Default,,0000,0000,0000,,Конеко...
Dialogue: 0,0:12:06.03,0:12:09.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:09.56,0:12:13.53,Default,,0000,0000,0000,,Жас ханым туралы
Dialogue: 0,0:12:09.56,0:12:13.53,Default,,0000,0000,0000,,Оны маған қалдырыңыз
Dialogue: 0,0:12:09.56,0:12:13.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:13.53,0:12:16.04,Default,,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:12:13.53,0:12:16.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:19.54,0:12:22.58,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:12:19.54,0:12:22.58,Default,,0000,0000,0000,,Джинка-сама
Dialogue: 0,0:12:19.54,0:12:22.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:22.58,0:12:24.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:26.65,0:12:28.05,Default,,0000,0000,0000,,Мика
Dialogue: 0,0:12:26.65,0:12:28.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:28.05,0:12:31.02,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:28.05,0:12:31.02,Default,,0000,0000,0000,,Ханым
Dialogue: 0,0:12:28.05,0:12:31.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:31.02,0:12:34.02,Default,,0000,0000,0000,,Поза тым жақсы
Dialogue: 0,0:12:31.02,0:12:34.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:31.02,0:12:34.02,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:12:39.02,0:12:40.56,Default,,0000,0000,0000,,《Мика-ни》
Dialogue: 0,0:12:40.56,0:12:43.56,Default,,0000,0000,0000,,《Осындай көп
Dialogue: 0,0:12:40.56,0:12:43.56,Default,,0000,0000,0000,,Бұл біртүрлі бүркеншік ат емес➡
Dialogue: 0,0:12:43.56,0:12:47.63,Default,,0000,0000,0000,,Неге алаңдату керек?
Dialogue: 0,0:12:43.56,0:12:47.63,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:12:43.56,0:12:47.63,Default,,0000,0000,0000,,Хана
Dialogue: 0,0:12:43.56,0:12:47.63,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:12:43.56,0:12:47.63,Default,,0000,0000,0000,,Кейіпкер
Dialogue: 0,0:12:43.56,0:12:47.63,Default,,0000,0000,0000,,Мен онда не бар екенін айта алмаймын.
Dialogue: 0,0:12:47.63,0:12:51.57,Default,,0000,0000,0000,,《Джинджи есімі де рас.
Dialogue: 0,0:12:47.63,0:12:51.57,Default,,0000,0000,0000,,Ер адамның атынан
Dialogue: 0,0:12:47.63,0:12:51.57,Default,,0000,0000,0000,,Көп қолданбайды》
Dialogue: 0,0:12:51.57,0:12:55.04,Default,,0000,0000,0000,,《Әйел болып киінгені абзал.
Dialogue: 0,0:12:51.57,0:12:55.04,Default,,0000,0000,0000,,Жақсы болды ма?》
Dialogue: 0,0:12:57.04,0:13:01.55,Default,,0000,0000,0000,,《Жоқ
Dialogue: 0,0:12:57.04,0:13:01.55,Default,,0000,0000,0000,,Әлемдік бейбітшілік үшін
Dialogue: 0,0:12:57.04,0:13:01.55,Default,,0000,0000,0000,,Одан аулақ болған абзал.
Dialogue: 0,0:13:01.55,0:13:04.55,Default,,0000,0000,0000,,Баратын жеріңіз қандай?
Dialogue: 0,0:13:04.55,0:13:07.62,Default,,0000,0000,0000,,Ханамачи
Dialogue: 0,0:13:04.55,0:13:07.62,Default,,0000,0000,0000,,Бұл қызыл шам аймағының алдындағы мейрамхана.
Dialogue: 0,0:13:04.55,0:13:07.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:07.62,0:13:10.12,Default,,0000,0000,0000,,Сол жерде бір таныспен кездесіңіз
Dialogue: 0,0:13:07.62,0:13:10.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:11.69,0:13:13.16,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:13:11.69,0:13:13.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:14.56,0:13:17.53,Default,,0000,0000,0000,,Бәсен
Dialogue: 0,0:13:14.56,0:13:17.53,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:14.56,0:13:17.53,Default,,0000,0000,0000,,Масен
Dialogue: 0,0:13:14.56,0:13:17.53,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:14.56,0:13:17.53,Default,,0000,0000,0000,,Мен неге эскортпын...
Dialogue: 0,0:13:14.56,0:13:17.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:19.06,0:13:21.57,Default,,0000,0000,0000,,Және жасырынып жатқанда
Dialogue: 0,0:13:19.06,0:13:21.57,Default,,0000,0000,0000,,Мағынасы...
Dialogue: 0,0:13:19.06,0:13:21.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:21.57,0:13:23.54,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:13:21.57,0:13:23.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:23.54,0:13:25.54,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:13:23.54,0:13:25.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:31.58,0:13:36.15,Default,,0000,0000,0000,,«Қызметші қожайынының алдына келеді».
Dialogue: 0,0:13:31.58,0:13:36.15,Default,,0000,0000,0000,,Әлі жоқ.
Dialogue: 0,0:13:36.15,0:13:38.55,Default,,0000,0000,0000,,Микка
Dialogue: 0,0:13:36.15,0:13:38.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:38.55,0:13:41.05,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:13:38.55,0:13:41.05,Default,,0000,0000,0000,,Ханым
Dialogue: 0,0:13:38.55,0:13:41.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:41.05,0:13:43.06,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:13:41.05,0:13:43.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:46.06,0:13:49.06,Default,,0000,0000,0000,,Маусымдық үлгі
Dialogue: 0,0:13:46.06,0:13:49.06,Default,,0000,0000,0000,,Жапырақты өсімдіктер әлі көп емес.
Dialogue: 0,0:13:46.06,0:13:49.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:49.06,0:13:51.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:51.06,0:13:54.07,Default,,0000,0000,0000,,О!
Dialogue: 0,0:13:51.06,0:13:54.07,Default,,0000,0000,0000,,Қалта ақшасы да
Dialogue: 0,0:13:51.06,0:13:54.07,Default,,0000,0000,0000,,Мен түсіндім➡
Dialogue: 0,0:13:54.07,0:13:56.64,Default,,0000,0000,0000,,Тауықты тұншықтырып өлтіріңіз
Dialogue: 0,0:13:54.07,0:13:56.64,Default,,0000,0000,0000,,Оны бірге қайнатамыз ба?
Dialogue: 0,0:13:54.07,0:13:56.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:56.64,0:13:59.17,Default,,0000,0000,0000,,Сіз шоппинг жасайсыз ба?
Dialogue: 0,0:13:56.64,0:13:59.17,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:59.17,0:14:01.07,Default,,0000,0000,0000,,Бұл киімде ме?
Dialogue: 0,0:14:03.54,0:14:05.04,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:14:03.54,0:14:05.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:08.55,0:14:12.02,Default,,0000,0000,0000,,《Әкемді тамақтандыр
Dialogue: 0,0:14:08.55,0:14:12.02,Default,,0000,0000,0000,,Мен мұны істегім келді》
Dialogue: 0,0:14:12.02,0:14:14.52,Default,,0000,0000,0000,,Кусуши
Dialogue: 0,0:14:12.02,0:14:14.52,Default,,0000,0000,0000,,《Дәрігер де, фармацевт ретінде де➡
Dialogue: 0,0:14:14.52,0:14:18.56,Default,,0000,0000,0000,,Оң жақта тұрғандар
Dialogue: 0,0:14:14.52,0:14:18.56,Default,,0000,0000,0000,,Кетіп қалды
Dialogue: 0,0:14:14.52,0:14:18.56,Default,,0000,0000,0000,,Қандай үлкен қария➡
Dialogue: 0,0:14:18.56,0:14:20.63,Default,,0000,0000,0000,,Мен не істедім➡
Dialogue: 0,0:14:20.63,0:14:23.53,Default,,0000,0000,0000,,Пайда мен шығын есебі дегеніміз не?
Dialogue: 0,0:14:20.63,0:14:23.53,Default,,0000,0000,0000,,Жоқ》
Dialogue: 0,0:14:23.53,0:14:27.03,Default,,0000,0000,0000,,《Алғашында сізге рахмет
Dialogue: 0,0:14:23.53,0:14:27.03,Default,,0000,0000,0000,,Бөлек тағам
Dialogue: 0,0:14:23.53,0:14:27.03,Default,,0000,0000,0000,,Бұл қызықсыз жұмыс болса да➡
Dialogue: 0,0:14:27.03,0:14:29.03,Default,,0000,0000,0000,,Анна
Dialogue: 0,0:14:27.03,0:14:29.03,Default,,0000,0000,0000,,Үйде тұру》
Dialogue: 0,0:14:29.03,0:14:31.04,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:14:29.03,0:14:31.04,Default,,0000,0000,0000,,Хун
Dialogue: 0,0:14:29.03,0:14:31.04,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:14:31.04,0:14:34.51,Default,,0000,0000,0000,,《Аштан өлуге сонша жақын болсаң
Dialogue: 0,0:14:31.04,0:14:34.51,Default,,0000,0000,0000,,Хаг
Dialogue: 0,0:14:31.04,0:14:34.51,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:14:31.04,0:14:34.51,Default,,0000,0000,0000,,Яри Теба ➡
Dialogue: 0,0:14:34.51,0:14:37.54,Default,,0000,0000,0000,,Күрішті құйғанша
Dialogue: 0,0:14:34.51,0:14:37.54,Default,,0000,0000,0000,,Сіз мұны істейтініңізге сенімдімін...》
Dialogue: 0,0:14:37.54,0:14:40.01,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:14:37.54,0:14:40.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:42.62,0:14:44.58,Default,,0000,0000,0000,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:14:47.02,0:14:48.52,Default,,0000,0000,0000,,Не ол?
Dialogue: 0,0:14:48.52,0:14:50.52,Default,,0000,0000,0000,,Неге үндемейсің?
Dialogue: 0,0:14:50.52,0:14:53.53,Default,,0000,0000,0000,,Бұл сізде сөйлесетін ештеңе болмағандықтан ба?
Dialogue: 0,0:14:56.53,0:14:59.03,Default,,0000,0000,0000,,《Бір нәрсе
Dialogue: 0,0:14:56.53,0:14:59.03,Default,,0000,0000,0000,,Мен жаман нәрсе айттым ба? 》
Dialogue: 0,0:14:59.03,0:15:01.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:59.03,0:15:01.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:59.03,0:15:01.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:59.03,0:15:01.03,Default,,0000,0000,0000,,Иіскеу дыбысы
Dialogue: 0,0:14:59.03,0:15:01.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:01.03,0:15:02.57,Default,,0000,0000,0000,,Бұл иіс...
Dialogue: 0,0:15:01.03,0:15:02.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:02.57,0:15:04.10,Default,,0000,0000,0000,,Якитори!
Dialogue: 0,0:15:04.10,0:15:07.14,Default,,0000,0000,0000,,Сәл күте тұрыңыз.
Dialogue: 0,0:15:04.10,0:15:07.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:04.10,0:15:07.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:07.14,0:15:10.61,Default,,0000,0000,0000,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:15:07.14,0:15:10.61,Default,,0000,0000,0000,,2 шашлық
Dialogue: 0,0:15:07.14,0:15:10.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:07.14,0:15:10.61,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:07.14,0:15:10.61,Default,,0000,0000,0000,,өзі құдаймын деп айтқан адаммен кездескеннен бері.
Dialogue: 0,0:15:07.14,0:15:10.61,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:07.14,0:15:10.61,Default,,0000,0000,0000,,Айо
Dialogue: 0,0:15:07.14,0:15:10.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:12.04,0:15:16.05,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:15:12.04,0:15:16.05,Default,,0000,0000,0000,,Суық болмай тұрып тамақтанып алайық.
Dialogue: 0,0:15:12.04,0:15:16.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:16.05,0:15:17.55,Default,,0000,0000,0000,,Хи хи хи...
Dialogue: 0,0:15:16.05,0:15:17.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:17.55,0:15:20.52,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:15:17.55,0:15:20.52,Default,,0000,0000,0000,,О
Dialogue: 0,0:15:17.55,0:15:20.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:25.02,0:15:28.03,Default,,0000,0000,0000,,《Тәтті тауықтың терісі
Dialogue: 0,0:15:25.02,0:15:28.03,Default,,0000,0000,0000,,Біркелкі таралатын май
Dialogue: 0,0:15:28.03,0:15:31.10,Default,,0000,0000,0000,,《Сотта
Dialogue: 0,0:15:28.03,0:15:31.10,Default,,0000,0000,0000,,Мен оны жей алмаймын...》
Dialogue: 0,0:15:31.10,0:15:35.53,Default,,0000,0000,0000,,Оны жемейсің бе?
Dialogue: 0,0:15:31.10,0:15:35.53,Default,,0000,0000,0000,,Бұл көше
Dialogue: 0,0:15:31.10,0:15:35.53,Default,,0000,0000,0000,,Бұл улы емес.
Dialogue: 0,0:15:31.10,0:15:35.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:35.53,0:15:37.04,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:15:35.53,0:15:37.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:37.04,0:15:41.01,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:15:37.04,0:15:41.01,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:15:37.04,0:15:41.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:49.55,0:15:51.05,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:51.05,0:15:54.09,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:15:51.05,0:15:54.09,Default,,0000,0000,0000,,Кемпинг кезінде
Dialogue: 0,0:15:51.05,0:15:54.09,Default,,0000,0000,0000,,Сақ бол.
Dialogue: 0,0:15:51.05,0:15:54.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:54.09,0:15:56.12,Default,,0000,0000,0000,,Тұз естіледі
Dialogue: 0,0:15:54.09,0:15:56.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:56.12,0:15:58.02,Default,,0000,0000,0000,,《Лагерь?
Dialogue: 0,0:15:56.12,0:15:58.02,Default,,0000,0000,0000,,Енухтар қалыпты ➡
Dialogue: 0,0:15:58.02,0:16:01.43,Default,,0000,0000,0000,,Әскери офицерлер сияқты жұмыс
Dialogue: 0,0:15:58.02,0:16:01.43,Default,,0000,0000,0000,,Мен сіз істемейсіз деп ойладым, бірақ…》
Dialogue: 0,0:16:03.03,0:16:05.53,Default,,0000,0000,0000,,《Солай болса да,
Dialogue: 0,0:16:03.03,0:16:05.53,Default,,0000,0000,0000,,Дәмді тамақтаныңыз》
Dialogue: 0,0:16:05.53,0:16:07.00,Default,,0000,0000,0000,,Juru…
Dialogue: 0,0:16:05.53,0:16:07.00,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:09.03,0:16:12.04,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:09.03,0:16:12.04,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:16:09.03,0:16:12.04,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:09.03,0:16:12.04,Default,,0000,0000,0000,,О.
Dialogue: 0,0:16:09.03,0:16:12.04,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:16:09.03,0:16:12.04,Default,,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,0:16:09.03,0:16:12.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:12.04,0:16:15.04,Default,,0000,0000,0000,,Кури
Dialogue: 0,0:16:12.04,0:16:15.04,Default,,0000,0000,0000,,Дьериге тиіспеңіз.
Dialogue: 0,0:16:12.04,0:16:15.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:15.04,0:16:17.58,Default,,0000,0000,0000,,Өйткені мен жай ғана хурма шырынын жағып алдым
Dialogue: 0,0:16:15.04,0:16:17.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:17.58,0:16:21.55,Default,,0000,0000,0000,,Бұл баланың ойыншығы.
Dialogue: 0,0:16:17.58,0:16:21.55,Default,,0000,0000,0000,,Бұл ностальгиялық, солай ма?
Dialogue: 0,0:16:21.55,0:16:23.05,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:21.55,0:16:23.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:23.05,0:16:25.55,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:16:23.05,0:16:25.55,Default,,0000,0000,0000,,және оны осы кезеңде бізге қалдыру қисынсыз болар еді, иә?
Dialogue: 0,0:16:25.55,0:16:28.02,Default,,0000,0000,0000,,Менің көңіл-күйім керемет болды.
Dialogue: 0,0:16:25.55,0:16:28.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:28.02,0:16:34.56,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:16:28.02,0:16:34.56,Default,,0000,0000,0000,,Сізге
Dialogue: 0,0:16:28.02,0:16:34.56,Default,,0000,0000,0000,,Ойланған ұсыныс жасау
Dialogue: 0,0:16:28.02,0:16:34.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:34.56,0:16:37.06,Default,,0000,0000,0000,,Тек бір рет қана.
Dialogue: 0,0:16:34.56,0:16:37.06,Default,,0000,0000,0000,,Маған ұнады
Dialogue: 0,0:16:34.56,0:16:37.06,Default,,0000,0000,0000,,Ойыншықтарыңыз болса➡
Dialogue: 0,0:16:37.06,0:16:40.60,Default,,0000,0000,0000,,Ботчан
Dialogue: 0,0:16:37.06,0:16:40.60,Default,,0000,0000,0000,,Осымен ғана ойнадым.
Dialogue: 0,0:16:37.06,0:16:40.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:40.60,0:16:43.04,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:16:40.60,0:16:43.04,Default,,0000,0000,0000,,Егер сіз оны жасырын түрде жасырсаңыз➡
Dialogue: 0,0:16:43.04,0:16:46.54,Default,,0000,0000,0000,,Мен оны көтере алмаймын
Dialogue: 0,0:16:43.04,0:16:46.54,Default,,0000,0000,0000,,Мен жыладым
Dialogue: 0,0:16:43.04,0:16:46.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:46.54,0:16:49.54,Default,,0000,0000,0000,,Сіз жаңа ойыншық аласыз
Dialogue: 0,0:16:46.54,0:16:49.54,Default,,0000,0000,0000,,Әкеліңіз➡
Dialogue: 0,0:16:49.54,0:16:52.58,Default,,0000,0000,0000,,Мен бұл туралы бірдеңе істеуге тырыстым.
Dialogue: 0,0:16:49.54,0:16:52.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:52.58,0:16:54.58,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:16:52.58,0:16:54.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:54.58,0:16:57.58,Default,,0000,0000,0000,,Бір нәрсеге байлану
Dialogue: 0,0:16:54.58,0:16:57.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:57.58,0:17:01.99,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:16:57.58,0:17:01.99,Default,,0000,0000,0000,,Рұқсат етілген жағдайда
Dialogue: 0,0:16:57.58,0:17:01.99,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:16:57.58,0:17:01.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:03.56,0:17:06.06,Default,,0000,0000,0000,,Бұлай асығудың қажеті жоқ
Dialogue: 0,0:17:03.56,0:17:06.06,Default,,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:17:06.06,0:17:08.56,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:17:06.06,0:17:08.56,Default,,0000,0000,0000,,Менің ойымша, бұл кездесу?
Dialogue: 0,0:17:08.56,0:17:12.06,Default,,0000,0000,0000,,Ерте барған жөн
Dialogue: 0,0:17:08.56,0:17:12.06,Default,,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:17:12.06,0:17:15.53,Default,,0000,0000,0000,,Менімен бірге
Dialogue: 0,0:17:12.06,0:17:15.53,Default,,0000,0000,0000,,Мен сенімен бірден ажырасқым келетін сияқты.
Dialogue: 0,0:17:12.06,0:17:15.53,Default,,0000,0000,0000,,Бұл жай ғана ауызша сөз.
Dialogue: 0,0:17:12.06,0:17:15.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:15.53,0:17:17.57,Default,,0000,0000,0000,,Бұл дәл өткен жолымен бірдей, кішкентай сорлы!
Dialogue: 0,0:17:17.57,0:17:20.11,Default,,0000,0000,0000,,《Әрине
Dialogue: 0,0:17:17.57,0:17:20.11,Default,,0000,0000,0000,,Біз ажырасқанда
Dialogue: 0,0:17:17.57,0:17:20.11,Default,,0000,0000,0000,,Қайтадан оралыңыз➡
Dialogue: 0,0:17:20.11,0:17:23.08,Default,,0000,0000,0000,,Шалғам және тауық еті
Dialogue: 0,0:17:20.11,0:17:23.08,Default,,0000,0000,0000,,Мен оны сатып алуды ойлап жүрмін.
Dialogue: 0,0:17:23.08,0:17:26.05,Default,,0000,0000,0000,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,0:17:23.08,0:17:26.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:23.08,0:17:26.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:26.05,0:17:29.55,Default,,0000,0000,0000,,Соттағы өмір де жаман емес.
Dialogue: 0,0:17:26.05,0:17:29.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:31.05,0:17:35.05,Default,,0000,0000,0000,,Қызыл жарық ауданындағы өмірден
Dialogue: 0,0:17:31.05,0:17:35.05,Default,,0000,0000,0000,,Менің ойымша, бұл әлдеқайда жақсы.
Dialogue: 0,0:17:31.05,0:17:35.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:35.05,0:17:38.59,Default,,0000,0000,0000,,Бұл, әрине, жаман емес.
Dialogue: 0,0:17:35.05,0:17:38.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:38.59,0:17:41.66,Default,,0000,0000,0000,,Мен өз еркіммен жұмыс істеп жатырмын➡
Dialogue: 0,0:17:41.66,0:17:44.56,Default,,0000,0000,0000,,Берілген бөлме де
Dialogue: 0,0:17:41.66,0:17:44.56,Default,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:17:41.66,0:17:44.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:44.56,0:17:47.07,Default,,0000,0000,0000,,Тек...
Dialogue: 0,0:17:44.56,0:17:47.07,Default,,0000,0000,0000,,Жалғыз қалған асырап алған әке➡
Dialogue: 0,0:17:47.07,0:17:51.04,Default,,0000,0000,0000,,Сіз дұрыс өмір сүре аласыз ба?
Dialogue: 0,0:17:47.07,0:17:51.04,Default,,0000,0000,0000,,Мен уайымдап тұрмын, сондықтан
Dialogue: 0,0:17:47.07,0:17:51.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:51.04,0:17:53.04,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:17:53.04,0:17:57.51,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:17:53.04,0:17:57.51,Default,,0000,0000,0000,,Дәрі мен уланудан басқа не істейсің?
Dialogue: 0,0:17:53.04,0:17:57.51,Default,,0000,0000,0000,,Сақ болу дегеніміз...
Dialogue: 0,0:17:53.04,0:17:57.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:57.51,0:17:59.04,Default,,0000,0000,0000,,Сен оны білесің бе, Аводөл? (Аводөл) Ах… өте
Dialogue: 0,0:17:59.04,0:18:01.08,Default,,0000,0000,0000,,Менің асырап алған әкем – медицина саласының шебері➡
Dialogue: 0,0:18:01.08,0:18:04.02,Default,,0000,0000,0000,,Маған әлі ұзақ өмір сүру керек.
Dialogue: 0,0:18:01.08,0:18:04.02,Default,,0000,0000,0000,,Мен қиындыққа тап болдым.
Dialogue: 0,0:18:01.08,0:18:04.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:04.02,0:18:07.55,Default,,0000,0000,0000,,Ол өте қабілетті фармацевт сияқты.
Dialogue: 0,0:18:04.02,0:18:07.55,Default,,0000,0000,0000,,Сіздің асырап алған әкеңіз
Dialogue: 0,0:18:04.02,0:18:07.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:07.55,0:18:11.52,Default,,0000,0000,0000,,Қытай медицинасы ғана емес
Dialogue: 0,0:18:07.55,0:18:11.52,Default,,0000,0000,0000,,Батыс медицинасына дейін
Dialogue: 0,0:18:07.55,0:18:11.52,Default,,0000,0000,0000,,Өйткені менде білім бар
Dialogue: 0,0:18:07.55,0:18:11.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:11.52,0:18:16.06,Default,,0000,0000,0000,,Мен жас кезімде Батыста шетелде оқыдым.
Dialogue: 0,0:18:11.52,0:18:16.06,Default,,0000,0000,0000,,Шамасы, кездер болды
Dialogue: 0,0:18:11.52,0:18:16.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:16.06,0:18:20.07,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:18:16.06,0:18:20.07,Default,,0000,0000,0000,,Ол шынымен жақсы емес пе еді?
Dialogue: 0,0:18:20.07,0:18:23.64,Default,,0000,0000,0000,,Шетелде оқу сіздің еліңіз таңдаған жағдайда ғана мүмкін болады.
Dialogue: 0,0:18:20.07,0:18:23.64,Default,,0000,0000,0000,,Сіз бара алмауыңыз керек.
Dialogue: 0,0:18:20.07,0:18:23.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:23.64,0:18:26.04,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:23.64,0:18:26.04,Default,,0000,0000,0000,,Ол керемет адам.
Dialogue: 0,0:18:23.64,0:18:26.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:26.04,0:18:30.54,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:18:26.04,0:18:30.54,Default,,0000,0000,0000,,Аспан екі нәрсені бермейді.
Dialogue: 0,0:18:26.04,0:18:30.54,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:18:26.04,0:18:30.54,Default,,0000,0000,0000,,деп аталса да
Dialogue: 0,0:18:26.04,0:18:30.54,Default,,0000,0000,0000,,Кейбір адамдарға беріледі
Dialogue: 0,0:18:26.04,0:18:30.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:30.54,0:18:33.55,Default,,0000,0000,0000,,Бұл үлкен құрмет.
Dialogue: 0,0:18:30.54,0:18:33.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:33.55,0:18:37.55,Default,,0000,0000,0000,,Мұндай мейірімділік
Dialogue: 0,0:18:33.55,0:18:37.55,Default,,0000,0000,0000,,Неліктен қызыл жарық аймағында дәріхана ашу керек?
Dialogue: 0,0:18:37.55,0:18:41.09,Default,,0000,0000,0000,,Тек сәттілік
Dialogue: 0,0:18:37.55,0:18:41.09,Default,,0000,0000,0000,,Оның жоқтығынан шығар.
Dialogue: 0,0:18:37.55,0:18:41.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:41.09,0:18:43.12,Default,,0000,0000,0000,,Қанша затыңыз болса да➡
Dialogue: 0,0:18:43.12,0:18:45.59,Default,,0000,0000,0000,,Ихимоцуо
Dialogue: 0,0:18:43.12,0:18:45.59,Default,,0000,0000,0000,,Өйткені оны алып кеткен.
Dialogue: 0,0:18:43.12,0:18:45.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:47.16,0:18:51.06,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:18:47.16,0:18:51.06,Default,,0000,0000,0000,,Сіздің асырап алған әкеңіз
Dialogue: 0,0:18:47.16,0:18:51.06,Default,,0000,0000,0000,,Бұл оның евнух екенін білдіре ме?
Dialogue: 0,0:18:51.06,0:18:53.03,Default,,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:18:51.06,0:18:53.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:55.03,0:19:00.04,Default,,0000,0000,0000,,《Аа...
Dialogue: 0,0:18:55.03,0:19:00.04,Default,,0000,0000,0000,,Ханамачи стиліндегі әзілдер
Dialogue: 0,0:18:55.03,0:19:00.04,Default,,0000,0000,0000,,Сіз тайып кеттіңіз бе?》
Dialogue: 0,0:19:00.04,0:19:03.04,Default,,0000,0000,0000,,《Оядзи бұл
Dialogue: 0,0:19:00.04,0:19:03.04,Default,,0000,0000,0000,,Батыста шетелде оқуына байланысты➡
Dialogue: 0,0:19:03.04,0:19:09.11,Default,,0000,0000,0000,,Алдыңғы императордың анасы
Dialogue: 0,0:19:03.04,0:19:09.11,Default,,0000,0000,0000,,Яғни
Dialogue: 0,0:19:03.04,0:19:09.11,Default,,0000,0000,0000,,Бұрынғы императрица Довагерге
Dialogue: 0,0:19:03.04,0:19:09.11,Default,,0000,0000,0000,,Шамасы, оны уәзірге айналдырған.
Dialogue: 0,0:19:09.11,0:19:12.55,Default,,0000,0000,0000,,Евнух
Dialogue: 0,0:19:09.11,0:19:12.55,Default,,0000,0000,0000,,Якуши
Dialogue: 0,0:19:09.11,0:19:12.55,Default,,0000,0000,0000,,Медицина қызметкері…
Dialogue: 0,0:19:09.11,0:19:12.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:12.55,0:19:15.52,Default,,0000,0000,0000,,《Оны айтқан жоқпын ба?》
Dialogue: 0,0:19:15.52,0:19:17.02,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:15.52,0:19:17.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:17.02,0:19:21.03,Default,,0000,0000,0000,,《Солай ма?
Dialogue: 0,0:19:17.02,0:19:21.03,Default,,0000,0000,0000,,Жоғарыда қонақ үй бар.
Dialogue: 0,0:19:17.02,0:19:21.03,Default,,0000,0000,0000,,Төменде асхана бар ма?
Dialogue: 0,0:19:21.03,0:19:24.53,Default,,0000,0000,0000,,Тоқтаңыз!
Dialogue: 0,0:19:21.03,0:19:24.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:21.03,0:19:24.53,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:19:21.03,0:19:24.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:24.53,0:19:26.53,Default,,0000,0000,0000,,《Ах
Dialogue: 0,0:19:24.53,0:19:26.53,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:19:26.53,0:19:31.10,Default,,0000,0000,0000,,《Неге алаңдау керек?
Dialogue: 0,0:19:26.53,0:19:31.10,Default,,0000,0000,0000,,Неліктен оның бетпердеге дейін барғанын түсінемін.
Dialogue: 0,0:19:31.10,0:19:34.04,Default,,0000,0000,0000,,Содан кейін Ханамачиге барыңыз
Dialogue: 0,0:19:31.10,0:19:34.04,Default,,0000,0000,0000,,Келсең, саған жақсылық тілеймін...
Dialogue: 0,0:19:31.10,0:19:34.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:34.04,0:19:36.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:34.04,0:19:36.54,Default,,0000,0000,0000,,Келісім жасасамыз ба?
Dialogue: 0,0:19:36.54,0:19:38.01,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:36.54,0:19:38.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:39.55,0:19:44.05,Default,,0000,0000,0000,,Фармация
Dialogue: 0,0:19:39.55,0:19:44.05,Default,,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,0:19:39.55,0:19:44.05,Default,,0000,0000,0000,,Риокусейканның таныстығына
Dialogue: 0,0:19:39.55,0:19:44.05,Default,,0000,0000,0000,,Сіз онымен таныссыз ба?
Dialogue: 0,0:19:44.05,0:19:47.52,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:44.05,0:19:47.52,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:19:44.05,0:19:47.52,Default,,0000,0000,0000,,Тұтынушы өзін көрсетіп жатса
Dialogue: 0,0:19:44.05,0:19:47.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:47.52,0:19:49.56,Default,,0000,0000,0000,,Қандай жігіт бар?
Dialogue: 0,0:19:49.56,0:19:52.56,Default,,0000,0000,0000,,Бұл құпия
Dialogue: 0,0:19:49.56,0:19:52.56,Default,,0000,0000,0000,,Құпиялылық міндеттемелеріне байланысты
Dialogue: 0,0:19:49.56,0:19:52.56,Default,,0000,0000,0000,,. [жиырма үш] .
Dialogue: 0,0:19:54.13,0:19:55.63,Default,,0000,0000,0000,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:19:54.13,0:19:55.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:57.53,0:20:01.53,Default,,0000,0000,0000,,Джиджо
Dialogue: 0,0:19:57.53,0:20:01.53,Default,,0000,0000,0000,,Жезөкшелердің құнын түсіру
Dialogue: 0,0:19:57.53,0:20:01.53,Default,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:20:01.53,0:20:06.04,Default,,0000,0000,0000,,Мен жағымсыз нәрсе естідім.
Dialogue: 0,0:20:01.53,0:20:06.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:06.04,0:20:09.04,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:20:06.04,0:20:09.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:09.04,0:20:13.55,Default,,0000,0000,0000,,Көп.
Dialogue: 0,0:20:09.04,0:20:13.55,Default,,0000,0000,0000,,Әсіресе егер сіз жоғары дәрежелі сыпайы адам болсаңыз.
Dialogue: 0,0:20:09.04,0:20:13.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:13.55,0:20:18.12,Default,,0000,0000,0000,,Камуро
Dialogue: 0,0:20:13.55,0:20:18.12,Default,,0000,0000,0000,,Рёокусейканда
Dialogue: 0,0:20:13.55,0:20:18.12,Default,,0000,0000,0000,,Тақыр жаста
Dialogue: 0,0:20:13.55,0:20:18.12,Default,,0000,0000,0000,,Толық оқуды аяқтаңыз
Dialogue: 0,0:20:13.55,0:20:18.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:18.12,0:20:23.02,Default,,0000,0000,0000,,Олардың ішінде келбеттілері де бар
Dialogue: 0,0:20:18.12,0:20:23.02,Default,,0000,0000,0000,,Болмайтындар➡ болып бөлінеді
Dialogue: 0,0:20:23.02,0:20:26.02,Default,,0000,0000,0000,,Соңғысы Каомиз аяқталған кезде.
Dialogue: 0,0:20:23.02,0:20:26.02,Default,,0000,0000,0000,,Тұтынушыларды дереу алыңыз➡
Dialogue: 0,0:20:26.02,0:20:28.03,Default,,0000,0000,0000,,Мен өзімді сатамын
Dialogue: 0,0:20:26.02,0:20:28.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:28.03,0:20:31.53,Default,,0000,0000,0000,,Екінші жағынан
Dialogue: 0,0:20:28.03,0:20:31.53,Default,,0000,0000,0000,,Уәде берушілер
Dialogue: 0,0:20:28.03,0:20:31.53,Default,,0000,0000,0000,,Шай ішуден бастау➡
Dialogue: 0,0:20:31.53,0:20:33.53,Default,,0000,0000,0000,,Білім беру арқылы тұтынушыларды тарту
Dialogue: 0,0:20:31.53,0:20:33.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:33.53,0:20:36.03,Default,,0000,0000,0000,,Мән
Dialogue: 0,0:20:33.53,0:20:36.03,Default,,0000,0000,0000,,Дондон
Dialogue: 0,0:20:33.53,0:20:36.03,Default,,0000,0000,0000,,Көтеру➡
Dialogue: 0,0:20:36.03,0:20:38.54,Default,,0000,0000,0000,,Мен тұрған кезде
Dialogue: 0,0:20:36.03,0:20:38.54,Default,,0000,0000,0000,,Экспозицияны азайту ➡
Dialogue: 0,0:20:38.54,0:20:43.11,Default,,0000,0000,0000,,Бір жылдық күміс тек шай ішу арқылы таусылады.
Dialogue: 0,0:20:38.54,0:20:43.11,Default,,0000,0000,0000,,Танымал жезөкше құрылады
Dialogue: 0,0:20:38.54,0:20:43.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:43.11,0:20:45.54,Default,,0000,0000,0000,,Төлеуге дейін
Dialogue: 0,0:20:43.11,0:20:45.54,Default,,0000,0000,0000,,Тұтынушыға ешқашан бір рет емес➡
Dialogue: 0,0:20:45.54,0:20:48.55,Default,,0000,0000,0000,,Қол тигізбейді
Dialogue: 0,0:20:45.54,0:20:48.55,Default,,0000,0000,0000,,Кейде
Dialogue: 0,0:20:45.54,0:20:48.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:48.55,0:20:52.52,Default,,0000,0000,0000,,Өйткені ол қол тимеген гүл
Dialogue: 0,0:20:48.55,0:20:52.52,Default,,0000,0000,0000,,Бұл тұрарлық.
Dialogue: 0,0:20:48.55,0:20:52.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:52.52,0:20:55.52,Default,,0000,0000,0000,,Егер сіз оны қолмен бүктесеңіз
Dialogue: 0,0:20:52.52,0:20:55.52,Default,,0000,0000,0000,,Мұның өзі мәнді екі есе азайтады.
Dialogue: 0,0:20:52.52,0:20:55.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:55.52,0:20:58.52,Default,,0000,0000,0000,,Әрі қарай➡
Dialogue: 0,0:20:58.52,0:21:03.60,Default,,0000,0000,0000,,Егер сіз бала көтерсеңіз
Dialogue: 0,0:20:58.52,0:21:03.60,Default,,0000,0000,0000,,Оның құндылығы жоқ.
Dialogue: 0,0:20:58.52,0:21:03.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:03.60,0:21:05.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:03.60,0:21:05.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:10.04,0:21:30.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:30.06,0:21:50.54,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:50.54,0:21:54.55,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:54.55,0:22:14.53,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:14.53,0:22:36.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
