Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:14.97,0:01:16.95,Default,,0,0,0,,Бұл дүниеде
Dialogue: 0,0:01:16.95,0:01:20.95,Default,,0,0,0,,Қарапайым көзге көрінбейтін қараңғылықта өмір сүретін адамдар бар.
Dialogue: 0,0:01:20.95,0:01:23.96,Default,,0,0,0,,Кейде азу тістерін жалаңаштады
Dialogue: 0,0:01:23.96,0:01:27.94,Default,,0,0,0,,Сізге келе жатыр
Dialogue: 0,0:01:27.94,0:01:29.95,Default,,0,0,0,,Ол
Dialogue: 0,0:01:29.95,0:01:32.95,Default,,0,0,0,,Сені мұндай адамдардан қорғау үшін
Dialogue: 0,0:01:32.95,0:01:35.95,Default,,0,0,0,,Мен тозақтың түбінен келдім.
Dialogue: 0,0:01:35.95,0:01:37.95,Default,,0,0,0,,Әділет елшісі
Dialogue: 0,0:01:37.95,0:01:40.95,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:01:44.95,0:01:46.95,Default,,0,0,0,,Нубе!
Dialogue: 0,0:03:12.95,0:03:14.95,Default,,0,0,0,,Жазғы демалыс ақыры ертең басталады.
Dialogue: 0,0:03:14.95,0:03:17.95,Default,,0,0,0,,Қайда бара жатырсың? Ә?
Dialogue: 0,0:03:17.95,0:03:20.96,Default,,0,0,0,,Әй, Нубенің артынан барайық. Эй?
Dialogue: 0,0:03:20.96,0:03:22.96,Default,,0,0,0,,Тыңдаңдар, балалар, жаз бір нәрсе.
Dialogue: 0,0:03:22.96,0:03:25.96,Default,,0,0,0,,Осындай кондиционері бар бөлмеде тыныш болған дұрыс.
Dialogue: 0,0:03:25.96,0:03:27.95,Default,,0,0,0,,Әй, жұмақ, жұмақ
Dialogue: 0,0:03:27.95,0:03:29.95,Default,,0,0,0,,Сіз қартсыз ба?
Dialogue: 0,0:03:29.95,0:03:32.95,Default,,0,0,0,,Қамқоршы керек, сол үшін сұрап отырсың.
Dialogue: 0,0:03:32.95,0:03:34.96,Default,,0,0,0,,Мен өтемін
Dialogue: 0,0:03:34.96,0:03:36.96,Default,,0,0,0,,Мен түсінбеймін, неге біреу ыстық жерге барады.
Dialogue: 0,0:03:36.96,0:03:38.96,Default,,0,0,0,,Нухахаха…
Dialogue: 0,0:03:38.96,0:03:40.96,Default,,0,0,0,,Суық.
Dialogue: 0,0:03:40.96,0:03:42.96,Default,,0,0,0,,Менің сүйкімді оқушыларым көп нәрсені сұрайды!
Dialogue: 0,0:03:42.96,0:03:44.95,Default,,0,0,0,,Не болды? Барлығы, о, Рицуко-сенсэй
Dialogue: 0,0:03:44.95,0:03:47.95,Default,,0,0,0,,Бізді теңізге апаруыңды қалаймын.
Dialogue: 0,0:03:47.95,0:03:49.95,Default,,0,0,0,,Не? Теңізге? Ой кешір
Dialogue: 0,0:03:49.95,0:03:51.96,Default,,0,0,0,,Бұл жігіттерге келсек, олар өзімшіл.
Dialogue: 0,0:03:51.96,0:03:53.96,Default,,0,0,0,,Теңіз... Керемет.
Dialogue: 0,0:03:53.96,0:03:55.96,Default,,0,0,0,,Маған жақсы болса, мен сенімен бірге барғым келеді.
Dialogue: 0,0:03:55.96,0:03:57.96,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:03:57.96,0:03:59.96,Default,,0,0,0,,Дұрыс, жаз теңіз дегенді білдіреді.
Dialogue: 0,0:03:59.96,0:04:03.95,Default,,0,0,0,,Қане, бәріміз, теңіз шақырып жатыр.
Dialogue: 0,0:04:03.95,0:04:05.95,Default,,0,0,0,,Рицуко Сенсеймен бірге теңізде
Dialogue: 0,0:04:05.95,0:04:07.95,Default,,0,0,0,,Ләззат алу ләззат алу
Dialogue: 0,0:04:07.95,0:04:09.96,Default,,0,0,0,,Ухьяхаха...
Dialogue: 0,0:04:09.96,0:04:11.96,Default,,0,0,0,,Күрсін, бұл қандай купальник?
Dialogue: 0,0:04:11.96,0:04:13.96,Default,,0,0,0,,Не болды? Барлығы
Dialogue: 0,0:04:13.96,0:04:15.96,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:04:15.96,0:04:17.96,Default,,0,0,0,,Иә
Dialogue: 0,0:04:33.96,0:04:36.96,Default,,0,0,0,,Ауа райы жақсы болғанына қуаныштымын.
Dialogue: 0,0:04:41.96,0:04:43.96,Default,,0,0,0,,Сен сондасың ба, Рицуко-сенсэй?
Dialogue: 0,0:04:43.96,0:04:47.96,Default,,0,0,0,,Иә, бұл өте жақсы жер деп естідім.
Dialogue: 0,0:04:47.96,0:04:49.96,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:04:49.96,0:04:52.95,Default,,0,0,0,,Таза ақ құмды жағажай, шексіз көк теңіз және аспан
Dialogue: 0,0:04:52.95,0:04:54.95,Default,,0,0,0,,Бұл ең жақсы жазғы демалыс болатын сияқты
Dialogue: 0,0:04:54.95,0:04:56.95,Default,,0,0,0,,Тез жүз, күте алмаймын.
Dialogue: 0,0:04:56.95,0:04:59.96,Default,,0,0,0,,Әй, мұндай жерде киіміңді шешпе.
Dialogue: 0,0:04:59.96,0:05:02.96,Default,,0,0,0,,А, мен теңіз шалбарын әкелуді ұмытып кетіппін.
Dialogue: 0,0:05:02.96,0:05:05.96,Default,,0,0,0,,Бірақ бәрібір, жүзуді жалғастыра бер.
Dialogue: 0,0:05:05.96,0:05:07.96,Default,,0,0,0,,Жақсы емес!
Dialogue: 0,0:05:09.95,0:05:11.95,Default,,0,0,0,,Хиро Жақсы болмаса, жақсы, сәл ғана.
Dialogue: 0,0:05:11.95,0:05:13.95,Default,,0,0,0,,Біреу бір нәрсені ұмытып кеткен болуы керек. Бұл қорқынышты.
Dialogue: 0,0:05:13.95,0:05:15.96,Default,,0,0,0,,Тас, қағаз, қайшы Хуэй! мен жеңдім
Dialogue: 0,0:05:15.96,0:05:17.96,Default,,0,0,0,,Ах, ол кір емес. Маған да көрсет.
Dialogue: 0,0:05:17.96,0:05:19.96,Default,,0,0,0,,Не? Оны да көре алмайсың.
Dialogue: 0,0:05:19.96,0:05:21.96,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:23.96,0:05:25.97,Default,,0,0,0,,Әй... Әй, маған да көрсетші.
Dialogue: 0,0:05:25.97,0:05:28.95,Default,,0,0,0,,Итермеңіз Ааааааааааааааааааааааааа
Dialogue: 0,0:05:28.95,0:05:30.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:33.96,0:05:35.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:35.96,0:05:38.96,Default,,0,0,0,,Сәлем, балалар!
Dialogue: 0,0:05:38.96,0:05:41.97,Default,,0,0,0,,Бұл жалаңаш болуы мүмкін бе?
Dialogue: 0,0:05:41.97,0:05:44.95,Default,,0,0,0,,Мен осындай бірдеңе болуы мүмкін деп ойлап, оны балық аулайтын жіппен байладым.
Dialogue: 0,0:05:44.95,0:05:46.95,Default,,0,0,0,,Қауіпті Қауіпті Бұл өрмекші емес.
Dialogue: 0,0:05:46.95,0:05:49.96,Default,,0,0,0,,Мен кедей болсам да, бұл қымбат болды.
Dialogue: 0,0:05:49.96,0:05:51.96,Default,,0,0,0,,А... дұрыс, мен көрдім.
Dialogue: 0,0:05:51.96,0:05:53.96,Default,,0,0,0,,Бұрын бұл аралда бір қыз болған...
Dialogue: 0,0:05:53.96,0:05:55.96,Default,,0,0,0,,Е, қыз қайда?
Dialogue: 0,0:05:55.96,0:05:57.96,Default,,0,0,0,,Онда жоқ.
Dialogue: 0,0:05:57.96,0:05:59.97,Default,,0,0,0,,Иә? Бұл біртүрлі
Dialogue: 0,0:05:59.97,0:06:02.95,Default,,0,0,0,,Расында да жартастың үстінде жалаңаш қыз бар еді.
Dialogue: 0,0:06:02.95,0:06:04.95,Default,,0,0,0,,Жалаңаш?
Dialogue: 0,0:06:04.95,0:06:06.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:06.96,0:06:09.96,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:06:09.96,0:06:11.96,Default,,0,0,0,,Бұл азғын маймыл адам! Вахахаха
Dialogue: 0,0:06:11.96,0:06:13.96,Default,,0,0,0,,Азғын! Ахахха...
Dialogue: 0,0:06:18.95,0:06:20.95,Default,,0,0,0,,Тағдырымыз тоғысса екен.
Dialogue: 0,0:06:20.95,0:06:22.95,Default,,0,0,0,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 0,0:06:25.96,0:06:28.96,Default,,0,0,0,,Ей, алысқа барма.
Dialogue: 0,0:06:28.96,0:06:30.96,Default,,0,0,0,,Уау
Dialogue: 0,0:06:30.96,0:06:33.97,Default,,0,0,0,,Уау, Цуко-сенсэй өзінің купальнигімен керемет көрінеді.
Dialogue: 0,0:06:33.97,0:06:35.95,Default,,0,0,0,,О, рахмет Норико-чан
Dialogue: 0,0:06:35.95,0:06:38.96,Default,,0,0,0,,Ухаха Мен келгеніме қуаныштымын.
Dialogue: 0,0:06:38.96,0:06:40.96,Default,,0,0,0,,Бірақ Норико-чан да жоқ.
Dialogue: 0,0:06:40.96,0:06:43.96,Default,,0,0,0,,Бұл сүйкімді. Жоқ, мен сондаймын...
Dialogue: 0,0:06:43.96,0:06:45.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:50.97,0:06:52.97,Default,,0,0,0,,Бұл не? Сіз қосалқы кейіпкерсіз.
Dialogue: 0,0:06:52.97,0:06:55.96,Default,,0,0,0,,Сіз Норо-чан болсаңыз да, осылай ерекшелену дұрыс деп ойлайсыз ба?
Dialogue: 0,0:06:55.96,0:06:58.96,Default,,0,0,0,,Бұл фильмдегі кейіпкердің рөлі менікі.
Dialogue: 0,0:06:58.96,0:07:00.96,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:07:00.96,0:07:04.96,Default,,0,0,0,,Хмм, сіз қалай ойлайсыз? Қызықты F кубогы
Dialogue: 0,0:07:04.96,0:07:07.97,Default,,0,0,0,,Жоқ, менің купальник шешіліп қалды.
Dialogue: 0,0:07:07.97,0:07:09.97,Default,,0,0,0,,Әй, қойшы.
Dialogue: 0,0:07:09.97,0:07:12.97,Default,,0,0,0,,Тамақтанғыңыз келе ме?
Dialogue: 0,0:07:14.96,0:07:16.96,Default,,0,0,0,,Кімге айттыңыз?
Dialogue: 0,0:07:16.96,0:07:18.96,Default,,0,0,0,,Әй, тапа-тал түсте сұлу қызға шабуыл жасау.
Dialogue: 0,0:07:18.96,0:07:20.96,Default,,0,0,0,,Бұзық бойдақ жігіт 25 жаста
Dialogue: 0,0:07:20.96,0:07:22.97,Default,,0,0,0,,Ой... доғар, мен саған үйлене алмаймын.
Dialogue: 0,0:07:22.97,0:07:24.97,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:07:27.95,0:07:29.96,Default,,0,0,0,,Сонда да адамдар көп емес.
Dialogue: 0,0:07:29.96,0:07:31.96,Default,,0,0,0,,Өте жақсы жер болса да
Dialogue: 0,0:07:31.96,0:07:34.96,Default,,0,0,0,,Ах, көрініс те керемет.
Dialogue: 0,0:07:34.96,0:07:36.96,Default,,0,0,0,,Эй, біз бұл аралға жүзе аламыз ба?
Dialogue: 0,0:07:36.96,0:07:38.97,Default,,0,0,0,,Хиро дегеніміз не?
Dialogue: 0,0:07:38.97,0:07:40.97,Default,,0,0,0,,Сіз әлі жалаңаш қыздар туралы ойлайсыз ба?
Dialogue: 0,0:07:40.97,0:07:42.97,Default,,0,0,0,,Себебі мен қызықпын... хаха
Dialogue: 0,0:07:42.97,0:07:44.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:44.95,0:07:46.96,Default,,0,0,0,,Жаман сөз айтпа
Dialogue: 0,0:07:46.96,0:07:49.96,Default,,0,0,0,,Сіздің қауіпсіздігіңіз үшін бұл аралдан аулақ болу керек.
Dialogue: 0,0:07:49.96,0:07:51.96,Default,,0,0,0,,Не... не?
Dialogue: 0,0:07:51.96,0:07:53.96,Default,,0,0,0,,Не... неге? атасы
Dialogue: 0,0:07:53.96,0:07:55.97,Default,,0,0,0,,Өрмекші аралы – қарғыс атқан елсіз арал.
Dialogue: 0,0:07:55.97,0:07:57.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:57.97,0:08:01.97,Default,,0,0,0,,Бұл аралда теңіз өрмекшісі туралы аңыз деп аталатын қорқынышты аңыз бар.
Dialogue: 0,0:08:01.97,0:08:03.96,Default,,0,0,0,,Теңіз өрмекшісі?
Dialogue: 0,0:08:03.96,0:08:05.96,Default,,0,0,0,,Осы маңайдағы теңізде ғана тіршілік етеді
Dialogue: 0,0:08:05.96,0:08:09.96,Default,,0,0,0,,Өрмекші тәрізді өте қорқынышты тіршілік иесі.
Dialogue: 0,0:08:09.96,0:08:12.97,Default,,0,0,0,,Ал теңіз өрмекшісінің жасы 200-ден асады.
Dialogue: 0,0:08:12.97,0:08:14.97,Default,,0,0,0,,Адамдарды жеп, құбыжық бол
Dialogue: 0,0:08:14.97,0:08:17.97,Default,,0,0,0,,Үлкен апат әкелу
Dialogue: 0,0:08:17.97,0:08:20.97,Default,,0,0,0,,Ол аралдан алыс болған дұрыс.
Dialogue: 0,0:08:22.96,0:08:25.96,Default,,0,0,0,,Хехехе... Мұндай оқиға жиі болады.
Dialogue: 0,0:08:25.96,0:08:28.97,Default,,0,0,0,,Бірақ біз Нубе сыныбындамыз, мұнда тіпті жылап жатқан балалардың да үні өшеді.
Dialogue: 0,0:08:28.97,0:08:31.97,Default,,0,0,0,,Дұрыс. Мұндай нәрсе сізді қорқыта ма?
Dialogue: 0,0:08:31.97,0:08:33.97,Default,,0,0,0,,Нуэно мырза... Иә?
Dialogue: 0,0:08:33.97,0:08:36.96,Default,,0,0,0,,Жарайды, мен бар болсам.
Dialogue: 0,0:08:36.96,0:08:39.96,Default,,0,0,0,,Өтінемін, өзіңізді үлкен кемеде жүргендей етіп көрсетіңіз Ухаха...
Dialogue: 0,0:08:39.96,0:08:41.96,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:43.96,0:08:45.97,Default,,0,0,0,,Наха
Dialogue: 0,0:08:45.97,0:08:47.97,Default,,0,0,0,,Нуэно мырза? Кет
Dialogue: 0,0:08:47.97,0:08:49.97,Default,,0,0,0,,Сіз бұған сене алмайсыз.
Dialogue: 0,0:08:51.97,0:08:53.96,Default,,0,0,0,,Уау, Нуэно мырза
Dialogue: 0,0:08:53.96,0:08:56.96,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:08:56.96,0:08:58.96,Default,,0,0,0,,Юкиме-сан
Dialogue: 0,0:08:58.96,0:09:00.96,Default,,0,0,0,,Юкиме
Dialogue: 0,0:09:00.96,0:09:02.97,Default,,0,0,0,,Нуэно мырза, сіз нені айтып тұрсыз?
Dialogue: 0,0:09:02.97,0:09:04.97,Default,,0,0,0,,Мен ғана қалдым
Dialogue: 0,0:09:04.97,0:09:06.97,Default,,0,0,0,,Өйткені... Юки-онна
Dialogue: 0,0:09:06.97,0:09:08.97,Default,,0,0,0,,Теңізде жүзу мүмкін емес, сондықтан...
Dialogue: 0,0:09:08.97,0:09:10.97,Default,,0,0,0,,Үш Құдайханымды адам қолымен ластау—
Dialogue: 0,0:09:17.96,0:09:20.97,Default,,0,0,0,,Қалай? Мен шынымен жаздың қызымын
Dialogue: 0,0:09:20.97,0:09:23.97,Default,,0,0,0,,Ио, өте керемет, Юкиме-сан
Dialogue: 0,0:09:23.97,0:09:25.97,Default,,0,0,0,,Уф, бұл ерекше көрінеді Ахаха
Dialogue: 0,0:09:25.97,0:09:28.96,Default,,0,0,0,,Хмм, абай болыңыз.
Dialogue: 0,0:09:28.96,0:09:30.96,Default,,0,0,0,,Қара күннің жылуын сіңіреді.
Dialogue: 0,0:09:32.96,0:09:34.96,Default,,0,0,0,,Иә? Уау
Dialogue: 0,0:09:34.96,0:09:36.97,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:09:36.97,0:09:38.97,Default,,0,0,0,,Әй, кеудем тегіс.
Dialogue: 0,0:09:38.97,0:09:40.97,Default,,0,0,0,,Менің денем Гоко сияқты болды.
Dialogue: 0,0:09:40.97,0:09:42.97,Default,,0,0,0,,Көмегің үшін рахмет!
Dialogue: 0,0:09:42.97,0:09:45.96,Default,,0,0,0,,Хехе... Солай болды.
Dialogue: 0,0:09:45.96,0:09:47.96,Default,,0,0,0,,Қараңызшы, кеудеге көбірек құмды
Dialogue: 0,0:09:47.96,0:09:49.96,Default,,0,0,0,,Хмм, бұл неткен бос әрекет.
Dialogue: 0,0:09:58.97,0:10:01.98,Default,,0,0,0,,Ах
Dialogue: 0,0:10:01.98,0:10:03.96,Default,,0,0,0,,Бұл кім? Жергілікті қыз ба?
Dialogue: 0,0:10:03.96,0:10:05.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.96,0:10:09.97,Default,,0,0,0,,Иә? Бұл бала кез келген жағдайда
Dialogue: 0,0:10:09.97,0:10:11.97,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:10:11.97,0:10:13.97,Default,,0,0,0,,Эй, мұнда кел.
Dialogue: 0,0:10:13.97,0:10:15.97,Default,,0,0,0,,Иә? Хмм... иә
Dialogue: 0,0:10:22.96,0:10:24.96,Default,,0,0,0,,Уау
Dialogue: 0,0:10:29.97,0:10:31.97,Default,,0,0,0,,Біз не істеуіміз керек? Күйеу
Dialogue: 0,0:10:31.97,0:10:34.97,Default,,0,0,0,,Бұл әрқашан манга, бұл дұрыс, президент
Dialogue: 0,0:10:34.97,0:10:36.98,Default,,0,0,0,,Мынау мынау мынау
Dialogue: 0,0:10:36.98,0:10:39.96,Default,,0,0,0,,Уау... не күтеміз?
Dialogue: 0,0:10:39.96,0:10:42.97,Default,,0,0,0,,Сіз! Сенімен бәрі жақсы ма?
Dialogue: 0,0:10:42.97,0:10:47.97,Default,,0,0,0,,Ахаха, жарайды, жарайды, мен әлі үйренбегенмін.
Dialogue: 0,0:10:47.97,0:10:50.97,Default,,0,0,0,,Ей, бірге ойнайық.
Dialogue: 0,0:10:50.97,0:10:52.98,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:10:52.98,0:10:55.96,Default,,0,0,0,,Танысқаныма қуаныштымын, Нағиса
Dialogue: 0,0:10:55.96,0:10:57.96,Default,,0,0,0,,Мен кеңейтіп жатырмын. Сізбен танысқаныма қуаныштымын. Мен Катсуя Кимурамын.
Dialogue: 0,0:10:57.96,0:10:59.96,Default,,0,0,0,,Менің сүйікті спорт түрім футбол... Домори бастауыш мектебінің 5/3 сыныбы...
Dialogue: 0,0:11:01.97,0:11:03.97,Default,,0,0,0,,Мен, Макото Курита, былай көрінсе де
Dialogue: 0,0:11:03.97,0:11:05.97,Default,,0,0,0,,Мен де басқалар сияқты 5-сынып оқушысымын.
Dialogue: 0,0:11:05.97,0:11:07.97,Default,,0,0,0,,Макото, сен қашан
Dialogue: 0,0:11:07.97,0:11:10.98,Default,,0,0,0,,Бәріміз төбелеспейік, бірге көңіл көтермейік
Dialogue: 0,0:11:10.98,0:11:12.96,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:11:12.96,0:11:14.96,Default,,0,0,0,,Ахаха
Dialogue: 0,0:11:14.96,0:11:16.97,Default,,0,0,0,,Күте тұрыңыз, Нагиса-чан
Dialogue: 0,0:11:16.97,0:11:18.97,Default,,0,0,0,,Хмм, біртүрлі тақта
Dialogue: 0,0:11:18.97,0:11:20.97,Default,,0,0,0,,Қалай ойнау керек? Бұл
Dialogue: 0,0:11:20.97,0:11:22.97,Default,,0,0,0,,Ой, бұл серфинг тақтасы ғой, білмейсің бе?
Dialogue: 0,0:11:22.97,0:11:24.97,Default,,0,0,0,,Бұл қатал әзіл хахаха...
Dialogue: 0,0:11:27.98,0:11:30.96,Default,,0,0,0,,Уау, сен осылай ойнайсың
Dialogue: 0,0:11:30.96,0:11:33.97,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:11:33.97,0:11:35.97,Default,,0,0,0,,Кя, доғаршы хахаха...
Dialogue: 0,0:11:35.97,0:11:38.97,Default,,0,0,0,,Кішкентай бәліш болса да, ол балаға не болды?
Dialogue: 0,0:11:38.97,0:11:40.97,Default,,0,0,0,,Міне, ұл балалар
Dialogue: 0,0:11:40.97,0:11:42.98,Default,,0,0,0,,Кең…
Dialogue: 0,0:11:42.98,0:11:44.98,Default,,0,0,0,,Ахх
Dialogue: 0,0:11:44.98,0:11:47.96,Default,,0,0,0,,Иә? Нагиса-чан
Dialogue: 0,0:11:47.96,0:11:49.96,Default,,0,0,0,,Сен істедің, қайтар.
Dialogue: 0,0:11:52.97,0:11:54.97,Default,,0,0,0,,Бұл, сөзсіз, қоңырау шалған жігіт сияқты. Ол «Юхамон» қолданушысы да, жау да емес.
Dialogue: 0,0:11:54.97,0:11:56.97,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:11:56.97,0:11:58.98,Default,,0,0,0,,Кел, бірге ойнайық.
Dialogue: 0,0:11:58.98,0:12:00.98,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:12:00.98,0:12:02.98,Default,,0,0,0,,Көңілді нәрсе сияқты Иә.
Dialogue: 0,0:12:02.98,0:12:04.96,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:12:04.96,0:12:06.97,Default,,0,0,0,,Иә
Dialogue: 0,0:12:06.97,0:12:08.97,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:12:08.97,0:12:12.97,Default,,0,0,0,,Мики-чанды қалдырып, өзімізді қызықтырайық.
Dialogue: 0,0:12:12.97,0:12:14.97,Default,,0,0,0,,Себебі мен сені кешіре алмаймын
Dialogue: 0,0:12:14.97,0:12:16.97,Default,,0,0,0,,Ах... Мики
Dialogue: 0,0:12:21.96,0:12:24.97,Default,,0,0,0,,Ааа хахаха...
Dialogue: 0,0:12:24.97,0:12:26.97,Default,,0,0,0,,Хиро Бұл ойын.
Dialogue: 0,0:12:26.97,0:12:29.97,Default,,0,0,0,,Мен жеңілмеймін. Аа, сенің де маған қосылғаныңды қалаймын.
Dialogue: 0,0:12:29.97,0:12:31.97,Default,,0,0,0,,Сәлем Хироши
Dialogue: 0,0:12:31.97,0:12:33.98,Default,,0,0,0,,Сіз маған жүзуді үйретемін дедіңіз.
Dialogue: 0,0:12:33.98,0:12:36.98,Default,,0,0,0,,Тым шулы болмаңыз, жалғыз жаттығу жасаңыз.
Dialogue: 0,0:12:38.97,0:12:41.97,Default,,0,0,0,,Эй Дон!
Dialogue: 0,0:12:41.97,0:12:43.97,Default,,0,0,0,,Бар, кет, Катсуя
Dialogue: 0,0:12:43.97,0:12:47.97,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Хиро-кун, берілме, барыңды істе
Dialogue: 0,0:12:53.98,0:12:55.97,Default,,0,0,0,,Егер ол әлдеқашан тараған болса ше?
Dialogue: 0,0:12:55.97,0:12:57.97,Default,,0,0,0,,Жалқау болғаным үшін өзімді ақымақ сезінемін.
Dialogue: 0,0:12:57.97,0:13:00.97,Default,,0,0,0,,Сондай-ақ, анау бала аздап сыпайы емес пе?
Dialogue: 0,0:13:02.97,0:13:05.98,Default,,0,0,0,,Барлығында бірдеңе дұрыс емес.
Dialogue: 0,0:13:05.98,0:13:07.98,Default,,0,0,0,,Иә Жоқ 1 Жоқ 2
Dialogue: 0,0:13:07.98,0:13:10.98,Default,,0,0,0,,Хиро-кунның жеңісі
Dialogue: 0,0:13:10.98,0:13:12.98,Default,,0,0,0,,Кең…
Dialogue: 0,0:13:14.97,0:13:16.97,Default,,0,0,0,,Га
Dialogue: 0,0:13:16.97,0:13:18.97,Default,,0,0,0,,Иә? Барма
Dialogue: 0,0:13:18.97,0:13:20.97,Default,,0,0,0,,Мен білмей тұрып бір-бірімізден алыс едік
Dialogue: 0,0:13:20.97,0:13:22.98,Default,,0,0,0,,Енді қайтайық
Dialogue: 0,0:13:22.98,0:13:24.98,Default,,0,0,0,,Иә? Да... кім?
Dialogue: 0,0:13:27.98,0:13:30.97,Default,,0,0,0,,Кең? Кең емес пе? Ешбір оғаш еркелік жасамаңыз.
Dialogue: 0,0:13:30.97,0:13:32.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:32.97,0:13:34.97,Default,,0,0,0,,Оған қол тигізбеңіз
Dialogue: 0,0:13:34.97,0:13:36.97,Default,,0,0,0,,Бұл қытық, солай емес пе? Келіңіздер...
Dialogue: 0,0:13:36.97,0:13:38.97,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:13:42.98,0:13:44.98,Default,,0,0,0,,Әй, міндім, міндім.
Dialogue: 0,0:13:44.98,0:13:46.98,Default,,0,0,0,,Уау... Уау
Dialogue: 0,0:13:54.97,0:13:56.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:56.98,0:13:58.98,Default,,0,0,0,,Не болды? Нагиса-чан
Dialogue: 0,0:14:01.98,0:14:03.98,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:03.98,0:14:05.97,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:05.97,0:14:07.97,Default,,0,0,0,,Нуэно мырза
Dialogue: 0,0:14:11.97,0:14:14.98,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:14:14.98,0:14:16.98,Default,,0,0,0,,Гоко
Dialogue: 0,0:14:23.97,0:14:25.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:25.97,0:14:27.97,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:14:29.98,0:14:31.98,Default,,0,0,0,,Мықты бол, Гоко.
Dialogue: 0,0:14:31.98,0:14:33.98,Default,,0,0,0,,Гоко
Dialogue: 0,0:14:33.98,0:14:35.98,Default,,0,0,0,,Гоко!
Dialogue: 0,0:14:35.98,0:14:37.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:37.98,0:14:40.98,Default,,0,0,0,,Ол сақталды ма?
Dialogue: 0,0:14:42.97,0:14:44.97,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:14:44.97,0:14:47.98,Default,,0,0,0,,Бұл адам Мисаки, теңізде өмір сүретін зұлым рух.
Dialogue: 0,0:14:47.98,0:14:49.98,Default,,0,0,0,,Адамның суретін салсаң
Dialogue: 0,0:14:49.98,0:14:52.98,Default,,0,0,0,,Сіз Буддалыққа қол жеткізе алатыныңызға сенесіз.
Dialogue: 0,0:14:52.98,0:14:56.97,Default,,0,0,0,,Nube~ Маған көмектескеніңіз үшін рахмет.
Dialogue: 0,0:14:56.97,0:14:59.97,Default,,0,0,0,,Нағисаға алғыс айтқыңыз келсе, Нағиса-күнге айтыңыз.
Dialogue: 0,0:14:59.97,0:15:02.97,Default,,0,0,0,,Ол келмегенде, мен саған көмектесе алмас едім.
Dialogue: 0,0:15:10.98,0:15:12.99,Default,,0,0,0,,Кешіріңіз, мен...
Dialogue: 0,0:15:12.99,0:15:16.97,Default,,0,0,0,,Бірге ойнайық, Гоко-чан
Dialogue: 0,0:15:16.97,0:15:18.98,Default,,0,0,0,,Иә
Dialogue: 0,0:15:18.98,0:15:21.98,Default,,0,0,0,,Хехе, сен бұл туралы қашаннан бері айтып жүрсің?
Dialogue: 0,0:15:21.98,0:15:23.98,Default,,0,0,0,,Гокоға ұқсамайды.
Dialogue: 0,0:15:25.98,0:15:28.99,Default,,0,0,0,,О... сәлем Гоко
Dialogue: 0,0:15:28.99,0:15:30.97,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:15:30.97,0:15:32.97,Default,,0,0,0,,Мұнда күт, Хироши, күт.
Dialogue: 0,0:15:32.97,0:15:34.97,Default,,0,0,0,,Жақсы, әдеттегі Гоко.
Dialogue: 0,0:15:34.97,0:15:37.98,Default,,0,0,0,,Не? Кәдімгі мен қандаймын? Хахаха...
Dialogue: 0,0:15:37.98,0:15:39.98,Default,,0,0,0,,Нагиса-чан
Dialogue: 0,0:15:39.98,0:15:41.98,Default,,0,0,0,,Міне.
Dialogue: 0,0:15:41.98,0:15:43.98,Default,,0,0,0,,Иә
Dialogue: 0,0:15:43.98,0:15:45.99,Default,,0,0,0,,Сен жақсы қызсың, Нағиса-чан.
Dialogue: 0,0:15:45.99,0:15:49.97,Default,,0,0,0,,Сүйкімді, мейірімді және сенімді
Dialogue: 0,0:15:49.97,0:15:52.98,Default,,0,0,0,,Қызық, ол Нубе класына ауыса ма?
Dialogue: 0,0:15:52.98,0:15:54.98,Default,,0,0,0,,Мен теңізге келгеніме қуаныштымын.
Dialogue: 0,0:15:54.98,0:15:56.98,Default,,0,0,0,,Бұл өте қызық
Dialogue: 0,0:15:59.98,0:16:01.98,Default,,0,0,0,,Нагиса-чанды бәрі жақсы көреді.
Dialogue: 0,0:16:01.98,0:16:03.99,Default,,0,0,0,,Сіз танымал болдыңыз.
Dialogue: 0,0:16:03.99,0:16:06.99,Default,,0,0,0,,Иә, ол сырлы сүйкімді бала.
Dialogue: 0,0:16:08.98,0:16:11.98,Default,,0,0,0,,Иә? О? иә?
Dialogue: 0,0:16:11.98,0:16:15.98,Default,,0,0,0,,Одан да бұрын Гокоға шабуыл жасаған арам рух.
Dialogue: 0,0:16:15.98,0:16:17.98,Default,,0,0,0,,Мисаки бастапқыда болды
Dialogue: 0,0:16:17.98,0:16:19.99,Default,,0,0,0,,Алғыс немесе хабаршы деген мағынаны білдіретін сөз.
Dialogue: 0,0:16:19.99,0:16:22.97,Default,,0,0,0,,Қандай да бір үлкен апат немесе оқиға алдында болады
Dialogue: 0,0:16:22.97,0:16:25.98,Default,,0,0,0,,Бұл рухани құбылыстарға да қатысты.
Dialogue: 0,0:16:25.98,0:16:27.98,Default,,0,0,0,,Содан кейін тағы бір нәрсе...
Dialogue: 0,0:16:27.98,0:16:29.98,Default,,0,0,0,,Иә
Dialogue: 0,0:16:29.98,0:16:31.98,Default,,0,0,0,,Наһаа
Dialogue: 0,0:16:33.98,0:16:35.99,Default,,0,0,0,,Міне.
Dialogue: 0,0:16:35.99,0:16:37.99,Default,,0,0,0,,Субару, бірдеңе дұрыс емес пе?
Dialogue: 0,0:16:39.97,0:16:41.97,Default,,0,0,0,,Субару, бірдеңе дұрыс емес пе?
Dialogue: 0,0:16:43.98,0:16:46.98,Default,,0,0,0,,Нагиса-чан
Dialogue: 0,0:16:46.98,0:16:48.98,Default,,0,0,0,,Нагиса-чан
Dialogue: 0,0:16:48.98,0:16:50.98,Default,,0,0,0,,Нагиса-чан, жақсысың ба? Сенімен бәрі жақсы ма?
Dialogue: 0,0:16:52.99,0:16:54.99,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:16:54.99,0:16:56.99,Default,,0,0,0,,Эй, таң қалдың ба? Сіз таң қалдыңыз ба? Эй
Dialogue: 0,0:16:56.99,0:16:58.98,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:16:58.98,0:17:00.98,Default,,0,0,0,,Өйткені ол орындаушы.
Dialogue: 0,0:17:00.98,0:17:02.98,Default,,0,0,0,,Олай болса, бұл жолы оны әрі қарай кеңейтейік.
Dialogue: 0,0:17:02.98,0:17:04.98,Default,,0,0,0,,О
Dialogue: 0,0:17:09.99,0:17:13.99,Default,,0,0,0,,Тамақ же, адамдарды же
Dialogue: 0,0:17:23.98,0:17:25.99,Default,,0,0,0,,Барлығы иә?
Dialogue: 0,0:17:25.99,0:17:28.99,Default,,0,0,0,,Эй, көңілдірек жерге барғың келе ме?
Dialogue: 0,0:17:28.99,0:17:30.99,Default,,0,0,0,,Көңілді бөлік?
Dialogue: 0,0:17:30.99,0:17:32.99,Default,,0,0,0,,Иә
Dialogue: 0,0:17:44.99,0:17:46.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:49.98,0:17:51.98,Default,,0,0,0,,Уау
Dialogue: 0,0:17:51.98,0:17:53.98,Default,,0,0,0,,Рицуко Сенсей
Dialogue: 0,0:17:53.98,0:17:56.98,Default,,0,0,0,,Бұл
Dialogue: 0,0:17:56.98,0:17:58.98,Default,,0,0,0,,Күте тұрыңыз, Рицуко-сенсэй!
Dialogue: 0,0:17:58.98,0:18:00.98,Default,,0,0,0,,Мықты бол, Рицуко-сенсэй.
Dialogue: 0,0:18:02.99,0:18:04.99,Default,,0,0,0,,Юкиме-сан…
Dialogue: 0,0:18:04.99,0:18:08.98,Default,,0,0,0,,Рицуко-сенсэй, берік бол, Рицуко-сенсэй.
Dialogue: 0,0:18:08.98,0:18:11.98,Default,,0,0,0,,Уайымдамаңыз, доктор Нуэно сізді бірден емдейді.
Dialogue: 0,0:18:14.98,0:18:16.99,Default,,0,0,0,,Мұғалім, бұл не?
Dialogue: 0,0:18:16.99,0:18:19.99,Default,,0,0,0,,О, бұл Мисаки емес.
Dialogue: 0,0:18:19.99,0:18:21.99,Default,,0,0,0,,Зұлым теңіз құбыжығы сияқты.
Dialogue: 0,0:18:21.99,0:18:24.98,Default,,0,0,0,,Юкиме-кун, Хиро мен басқаларды қонақ үйге эвакуациялаңыз.
Dialogue: 0,0:18:24.98,0:18:26.98,Default,,0,0,0,,Мен Рицуко-сенсэйді апарамын
Dialogue: 0,0:18:26.98,0:18:28.98,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.98,0:18:33.99,Default,,0,0,0,,Хирокун мұғалім және басқалары... не болды?
Dialogue: 0,0:18:33.99,0:18:35.99,Default,,0,0,0,,Қанша іздесем де, еш жерден таба алмаймын.
Dialogue: 0,0:18:35.99,0:18:37.99,Default,,0,0,0,,Не?
Dialogue: 0,0:18:37.99,0:18:39.99,Default,,0,0,0,,Кең!
Dialogue: 0,0:18:39.99,0:18:41.98,Default,,0,0,0,,Гоко! Барлығы
Dialogue: 0,0:18:41.98,0:18:43.98,Default,,0,0,0,,Олар қайда?
Dialogue: 0,0:18:43.98,0:18:45.98,Default,,0,0,0,,Өрмекші аралы
Dialogue: 0,0:18:45.98,0:18:47.98,Default,,0,0,0,,Мен Өрмекші аралына бардым.
Dialogue: 0,0:18:47.98,0:18:49.99,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:18:49.99,0:18:53.99,Default,,0,0,0,,Балалар теңіз өрмекшіге тартылды.
Dialogue: 0,0:18:53.99,0:18:56.99,Default,,0,0,0,,Сіз жем болайын деп тұрсыз.
Dialogue: 0,0:19:10.99,0:19:12.99,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:19:12.99,0:19:14.99,Default,,0,0,0,,Уау, әдемі
Dialogue: 0,0:19:14.99,0:19:16.98,Default,,0,0,0,,Балық көп
Dialogue: 0,0:19:16.98,0:19:19.98,Default,,0,0,0,,Мен осыншама тереңдікке сүңгісем де, бұл ауыртпайды.
Dialogue: 0,0:19:19.98,0:19:21.98,Default,,0,0,0,,Тыныс алу жеңіл жалғасады
Dialogue: 0,0:19:21.98,0:19:25.99,Default,,0,0,0,,Мен, балға басы, барлығымен бірге жүземін.
Dialogue: 0,0:19:25.99,0:19:28.99,Default,,0,0,0,,Мен түс көргендеймін
Dialogue: 0,0:19:28.99,0:19:30.99,Default,,0,0,0,,Сіз қалай ойлайсыз? Керемет емес пе? Барлығы
Dialogue: 0,0:19:30.99,0:19:32.98,Default,,0,0,0,,Керемет
Dialogue: 0,0:19:32.98,0:19:34.98,Default,,0,0,0,,Иә
Dialogue: 0,0:19:34.98,0:19:37.98,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:19:37.98,0:19:39.98,Default,,0,0,0,,Уау
Dialogue: 0,0:19:42.99,0:19:44.99,Default,,0,0,0,,Ахх
Dialogue: 0,0:19:44.99,0:19:46.99,Default,,0,0,0,,Уау
Dialogue: 0,0:19:52.98,0:19:54.98,Default,,0,0,0,,Hoora hora ahaha
Dialogue: 0,0:19:59.99,0:20:01.99,Default,,0,0,0,,Эй, қараңдаршы хахаха
Dialogue: 0,0:20:12.99,0:20:14.99,Default,,0,0,0,,Га
Dialogue: 0,0:20:17.99,0:20:19.99,Default,,0,0,0,,Субару, бірдеңе дұрыс емес пе?
Dialogue: 0,0:20:19.99,0:20:23.00,Default,,0,0,0,,Адамдарды жеу
Dialogue: 0,0:20:23.00,0:20:24.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:24.98,0:20:27.98,Default,,0,0,0,,Уақыт толып қалды
Dialogue: 0,0:20:27.98,0:20:30.98,Default,,0,0,0,,Толық айдың 200 жылында
Dialogue: 0,0:20:37.99,0:20:39.99,Default,,0,0,0,,Ух... ха
Dialogue: 0,0:20:45.99,0:20:47.99,Default,,0,0,0,,Істейсің бе, әлде істей алмайсың ба?
Dialogue: 0,0:20:47.99,0:20:49.99,Default,,0,0,0,,Мұндай жерге рұқсатсыз келген дұрыс емес пе?
Dialogue: 0,0:20:49.99,0:20:51.99,Default,,0,0,0,,Нубе мұғалімі
Dialogue: 0,0:20:51.99,0:20:53.99,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:20:53.99,0:20:57.00,Default,,0,0,0,,Оларға көмектесу мүмкін емес, олар жай ғана алаңдайды.
Dialogue: 0,0:20:57.00,0:20:59.00,Default,,0,0,0,,Кешіріңіз, мұғалім, иә?
Dialogue: 0,0:20:59.00,0:21:02.00,Default,,0,0,0,,Бұл менің кінәм, Нағиса-чан.
Dialogue: 0,0:21:03.99,0:21:06.99,Default,,0,0,0,,Мұғалім, бұл Нағиса-чанның кінәсі емес, біз...
Dialogue: 0,0:21:06.99,0:21:08.99,Default,,0,0,0,,Бізге ұрыссаң, ұрыс.
Dialogue: 0,0:21:08.99,0:21:10.99,Default,,0,0,0,,Бейшара Нагиса-чан
Dialogue: 0,0:21:10.99,0:21:13.00,Default,,0,0,0,,Иә, иә, сэр.
Dialogue: 0,0:21:13.00,0:21:16.00,Default,,0,0,0,,Жарайды, жарайды, барлығы осында.
Dialogue: 0,0:21:16.00,0:21:17.98,Default,,0,0,0,,Юкиме-кун, бәрінен сұра
Dialogue: 0,0:21:17.98,0:21:19.98,Default,,0,0,0,,Иә мырза
Dialogue: 0,0:21:24.99,0:21:26.99,Default,,0,0,0,,Ауырсыну
Dialogue: 0,0:21:26.99,0:21:29.99,Default,,0,0,0,,Менің денем... Нағиса-күн
Dialogue: 0,0:21:32.00,0:21:33.98,Default,,0,0,0,,Мұғалім, кешіріңіз.
Dialogue: 0,0:21:33.98,0:21:36.99,Default,,0,0,0,,Себебі мен көптен бері жалғызбын
Dialogue: 0,0:21:36.99,0:21:38.99,Default,,0,0,0,,Маған дос керек
Dialogue: 0,0:21:38.99,0:21:41.99,Default,,0,0,0,,Уайымдама, мен саған ұрысуға келген жоқпын.
Dialogue: 0,0:21:44.99,0:21:48.00,Default,,0,0,0,,Олармен дос болу жаман емес.
Dialogue: 0,0:21:48.00,0:21:50.98,Default,,0,0,0,,Алайда бұл теңіз тым қауіпті.
Dialogue: 0,0:21:50.98,0:21:53.99,Default,,0,0,0,,Мұғалім ретінде мен өз шәкірттерімді қорғауым керек...
Dialogue: 0,0:21:53.99,0:21:56.99,Default,,0,0,0,,Мұғалім, енді менің қолымнан келмейді.
Dialogue: 0,0:21:56.99,0:21:59.99,Default,,0,0,0,,Мен бәріңді жақсы көремін
Dialogue: 0,0:21:59.99,0:22:01.99,Default,,0,0,0,,Мен қоштасуды жек көремін...
Dialogue: 0,0:22:04.00,0:22:06.00,Default,,0,0,0,,Қолымнан келмейді, келесі жазда кездесеміз...
Dialogue: 0,0:22:06.00,0:22:10.99,Default,,0,0,0,,Жоқ, мен басымның ішінде бір дауысты естимін.
Dialogue: 0,0:22:10.99,0:22:14.99,Default,,0,0,0,,Сол толық ай батады және бұл соңғы рет болады.
Dialogue: 0,0:22:14.99,0:22:16.99,Default,,0,0,0,,Одан бұрын
Dialogue: 0,0:22:16.99,0:22:20.00,Default,,0,0,0,,Нагиса-кун, мен қорқамын, мұғалім.
Dialogue: 0,0:22:20.00,0:22:23.00,Default,,0,0,0,,Мен өзімді енді өзім емес сияқты сезінемін
Dialogue: 0,0:22:23.00,0:22:25.99,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:25.99,0:22:27.99,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:22:27.99,0:22:30.99,Default,,0,0,0,,Бұл қорқынышты аура
Dialogue: 0,0:22:30.99,0:22:34.99,Default,,0,0,0,,Саған сенбеймін...
Dialogue: 0,0:22:34.99,0:22:37.99,Default,,0,0,0,,Күте тұрыңыз, Нагиса-кун.
Dialogue: 0,0:22:40.00,0:22:42.00,Default,,0,0,0,,Бұл не, балалар?
Dialogue: 0,0:22:45.99,0:22:47.99,Default,,0,0,0,,Уау
Dialogue: 0,0:22:55.00,0:22:57.00,Default,,0,0,0,,Нубе! Нагиса-чан!
Dialogue: 0,0:22:57.00,0:22:59.99,Default,,0,0,0,,Нуэно Нубе Нубе мырза
Dialogue: 0,0:22:59.99,0:23:01.99,Default,,0,0,0,,А, мүмкін сонда.
Dialogue: 0,0:23:01.99,0:23:03.99,Default,,0,0,0,,Кеттік
Dialogue: 0,0:23:07.99,0:23:12.00,Default,,0,0,0,,Ах... бұл Нагиса-чан.
Dialogue: 0,0:23:12.00,0:23:14.00,Default,,0,0,0,,Рас, бұл Нағиса-чан.
Dialogue: 0,0:23:14.00,0:23:16.99,Default,,0,0,0,,Эй Нагиса-чан, не болды? Осындай жерде
Dialogue: 0,0:23:16.99,0:23:18.99,Default,,0,0,0,,Келме!
Dialogue: 0,0:23:18.99,0:23:20.99,Default,,0,0,0,,Не? Бірдеңе болды ма?
Dialogue: 0,0:23:22.99,0:23:24.99,Default,,0,0,0,,Нагиса-чан
Dialogue: 0,0:23:24.99,0:23:27.00,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:23:27.00,0:23:29.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:23:34.00,0:23:36.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:41.99,0:23:43.99,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:23:49.00,0:23:51.00,Default,,0,0,0,,Сол кезде мен Кирамен есептесемін.
Dialogue: 0,0:23:58.99,0:24:01.99,Default,,0,0,0,,Уау
Dialogue: 0,0:24:05.00,0:24:07.00,Default,,0,0,0,,Не... бұл балалар қандай?
Dialogue: 0,0:24:07.00,0:24:09.00,Default,,0,0,0,,Теңіз құбыжықтары
Dialogue: 0,0:24:11.99,0:24:13.99,Default,,0,0,0,,Уау
Dialogue: 0,0:24:13.99,0:24:15.99,Default,,0,0,0,,Сіз не істеп жатырсыз? Тоқта.
Dialogue: 0,0:24:18.00,0:24:21.00,Default,,0,0,0,,үлкен жалын ыстық
Dialogue: 0,0:24:25.00,0:24:27.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:24:30.99,0:24:32.99,Default,,0,0,0,,Хаха...
Dialogue: 0,0:24:43.01,0:24:46.99,Default,,0,0,0,,Жоқ, барлығына! барма
Dialogue: 0,0:24:46.99,0:24:48.99,Default,,0,0,0,,Тоқта, жібер
Dialogue: 0,0:24:55.00,0:24:58.00,Default,,0,0,0,,Жоқ! бәрі оянсын
Dialogue: 0,0:25:04.99,0:25:07.00,Default,,0,0,0,,Тоқта, Нағиса-күн.
Dialogue: 0,0:25:07.00,0:25:09.00,Default,,0,0,0,,Не?
Dialogue: 0,0:25:09.00,0:25:11.00,Default,,0,0,0,,Нуэно мырза
Dialogue: 0,0:25:13.00,0:25:15.00,Default,,0,0,0,,Nube Nube Nube
Dialogue: 0,0:25:15.00,0:25:17.01,Default,,0,0,0,,Сіз! Тірі болу қандай болды?
Dialogue: 0,0:25:17.01,0:25:20.01,Default,,0,0,0,,Ғарыштық аспан мен жер, йога күші, тапсыру тобы жын, сәлемдесу таңы...
Dialogue: 0,0:25:23.00,0:25:25.00,Default,,0,0,0,,(Слақ еткен дыбыс)
Dialogue: 0,0:25:27.00,0:25:29.00,Default,,0,0,0,,Ух... аааа
Dialogue: 0,0:25:31.00,0:25:34.01,Default,,0,0,0,,Нагиса-кун, тоқтат.
Dialogue: 0,0:25:34.01,0:25:35.99,Default,,0,0,0,,Сіз әлі толық құбыжық болған жоқсыз.
Dialogue: 0,0:25:35.99,0:25:38.99,Default,,0,0,0,,Әлі де адам жүрегі қалуы керек.
Dialogue: 0,0:25:43.00,0:25:45.00,Default,,0,0,0,,Нагиса-кун
Dialogue: 0,0:25:47.00,0:25:49.00,Default,,0,0,0,,Нубе
Dialogue: 0,0:25:49.00,0:25:52.01,Default,,0,0,0,,Нуэно-сенсэй Юкиме-кун, бұл жерде қауіпті.
Dialogue: 0,0:25:52.01,0:25:54.99,Default,,0,0,0,,Барлығын алып, дәл қазір осы аралдан қашыңыз.
Dialogue: 0,0:25:54.99,0:25:57.00,Default,,0,0,0,,Ал мұғалім ше?
Dialogue: 0,0:25:57.00,0:25:59.00,Default,,0,0,0,,Мен үшін уайымдаудың қажеті жоқ
Dialogue: 0,0:25:59.00,0:26:01.00,Default,,0,0,0,,Мен сенің қарсыласыңмын, жүр!
Dialogue: 0,0:26:01.00,0:26:03.00,Default,,0,0,0,,Мен барлығын сұрадым.
Dialogue: 0,0:26:03.00,0:26:05.00,Default,,0,0,0,,Иә
Dialogue: 0,0:26:05.00,0:26:07.00,Default,,0,0,0,,Жүріңдер, бәрі асығыңдар.
Dialogue: 0,0:26:15.00,0:26:18.00,Default,,0,0,0,,Амансың ба? Нубе~
Dialogue: 0,0:26:20.00,0:26:23.00,Default,,0,0,0,,Құрметті мырза.
Dialogue: 0,0:26:25.01,0:26:27.99,Default,,0,0,0,,Денені тексеру? Неге ондай істегіңіз келеді?
Dialogue: 0,0:26:27.99,0:26:31.99,Default,,0,0,0,,Мисаки және басқалары, сіз бізге қашып кетуге мүмкіндік бермейсіз.
Dialogue: 0,0:26:35.00,0:26:37.00,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:26:44.01,0:26:46.01,Default,,0,0,0,,Ахх
Dialogue: 0,0:26:53.00,0:26:55.00,Default,,0,0,0,,Қарғыс атсын, т.б.
Dialogue: 0,0:26:55.00,0:26:57.00,Default,,0,0,0,,Сізді алаңдатуға қарсы ма?
Dialogue: 0,0:26:59.01,0:27:01.99,Default,,0,0,0,,Біз бұл уақытта көптен бері өмір сүрдік.
Dialogue: 0,0:27:01.99,0:27:05.00,Default,,0,0,0,,Мен оны көптен күттім.
Dialogue: 0,0:27:05.00,0:27:07.00,Default,,0,0,0,,Осы уақытта?
Dialogue: 0,0:27:09.00,0:27:11.00,Default,,0,0,0,,Хаха...
Dialogue: 0,0:27:13.01,0:27:15.01,Default,,0,0,0,,Ах
Dialogue: 0,0:27:17.01,0:27:19.01,Default,,0,0,0,,Уау
Dialogue: 0,0:27:25.00,0:27:28.00,Default,,0,0,0,,Мұғалім Нубе, балалар
Dialogue: 0,0:27:28.00,0:27:30.01,Default,,0,0,0,,Бұл мүмкін емес. Бұл аралдан қашып құтыла алмайсың.
Dialogue: 0,0:27:30.01,0:27:32.01,Default,,0,0,0,,Мисаки және басқалары теңізден бірінен соң бірі келеді...
Dialogue: 0,0:27:32.01,0:27:35.01,Default,,0,0,0,,Не? Уау, өлгім келмейді.
Dialogue: 0,0:27:35.01,0:27:37.00,Default,,0,0,0,,Мен қорқамын Уау.
Dialogue: 0,0:27:37.00,0:27:39.00,Default,,0,0,0,,Мұндай арал келмеуі керек еді.
Dialogue: 0,0:27:50.01,0:27:53.01,Default,,0,0,0,,Жоқ... Нуэно мырзаны ұрлап кетті...
Dialogue: 0,0:27:53.01,0:27:56.00,Default,,0,0,0,,Набе! мұғалім!
Dialogue: 0,0:27:56.00,0:27:58.00,Default,,0,0,0,,Хехе...
Dialogue: 0,0:27:58.00,0:28:00.00,Default,,0,0,0,,Жек көрсе жақсы, жек көрсе жақсы.
Dialogue: 0,0:28:00.00,0:28:03.01,Default,,0,0,0,,Ол сенің жаның
Dialogue: 0,0:28:03.01,0:28:06.01,Default,,0,0,0,,Бұл теңіз паукасын күштірек және үлкенірек ететін күш болады.
Dialogue: 0,0:28:06.01,0:28:08.01,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:28:08.01,0:28:11.00,Default,,0,0,0,,Сен де құбыжық болсаң, түсіну керек.
Dialogue: 0,0:28:11.00,0:28:14.00,Default,,0,0,0,,Сіздердің бәрінің иығында тағдыры бар.
Dialogue: 0,0:28:14.00,0:28:16.00,Default,,0,0,0,,Тағдыр...
Dialogue: 0,0:28:16.00,0:28:19.00,Default,,0,0,0,,200 жылдағы толық айдың түні
Dialogue: 0,0:28:19.00,0:28:23.01,Default,,0,0,0,,Теңіз өрмекшісі толық құбыжыққа айналған соңғы түн
Dialogue: 0,0:28:23.01,0:28:26.01,Default,,0,0,0,,Егер бұл орындалмаса
Dialogue: 0,0:28:26.01,0:28:29.00,Default,,0,0,0,,Теңіз өрмекшісінің өмірін өз қолымызбен аяқтауымыз керек.
Dialogue: 0,0:28:29.00,0:28:33.00,Default,,0,0,0,,Теңізде өмір сүретін құбыжықтардың тағдыры осындай.
Dialogue: 0,0:28:33.00,0:28:35.00,Default,,0,0,0,,Өмір? Бұлай етпе
Dialogue: 0,0:28:35.00,0:28:37.01,Default,,0,0,0,,Ол Нагиса-чанды өлтірмекші.
Dialogue: 0,0:28:37.01,0:28:40.01,Default,,0,0,0,,Хехехе, уайымдайтын ештеңе жоқ.
Dialogue: 0,0:28:40.01,0:28:44.01,Default,,0,0,0,,Тыныш болыңыз және теңіз өрмекшілеріне жем болады.
Dialogue: 0,0:28:44.01,0:28:48.00,Default,,0,0,0,,Ал теңіз өрмекшісі толық құбыжық болып оянады.
Dialogue: 0,0:28:48.00,0:28:50.00,Default,,0,0,0,,Хехе...
Dialogue: 0,0:28:50.00,0:28:52.00,Default,,0,0,0,,Мен мұны кешірмеймін.
Dialogue: 0,0:28:52.00,0:28:54.01,Default,,0,0,0,,Қазір ғана Какёин менің кім екенімді анықтай бастағанда мен дүрлігіп кеттім
Dialogue: 0,0:28:54.01,0:28:57.01,Default,,0,0,0,,Ғарыштық аспан мен жер, йога күші, топтың демоны, қош келдіңіз таңы...
Dialogue: 0,0:28:57.01,0:29:00.01,Default,,0,0,0,,Ей, сол қолыма мөрленген жын
Dialogue: 0,0:29:00.01,0:29:03.01,Default,,0,0,0,,Қазір күшіңізді көрсетіңіз!
Dialogue: 0,0:29:06.00,0:29:08.00,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:29:13.01,0:29:16.01,Default,,0,0,0,,Ия, бұл Нубехадан кейін керемет
Dialogue: 0,0:29:16.01,0:29:19.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:19.01,0:29:21.00,Default,,0,0,0,,Мұғалім, тамаша!
Dialogue: 0,0:29:21.00,0:29:23.00,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:29:23.00,0:29:25.00,Default,,0,0,0,,Бізді жеңсең де
Dialogue: 0,0:29:25.00,0:29:28.01,Default,,0,0,0,,Теңіз өрмекшісінің тағдырынан қашып құтылу мүмкін емес.
Dialogue: 0,0:29:28.01,0:29:30.01,Default,,0,0,0,,Не? сендер білмейсіңдер
Dialogue: 0,0:29:30.01,0:29:33.01,Default,,0,0,0,,Теңіз өрмекшілерінің нағыз сұмдығы
Dialogue: 0,0:29:33.01,0:29:35.01,Default,,0,0,0,,Қорқыныш?
Dialogue: 0,0:29:35.01,0:29:39.00,Default,,0,0,0,,Койойды өткізіп алса, теңіз өрмекшісі толық юкай болмайды.
Dialogue: 0,0:29:39.00,0:29:43.00,Default,,0,0,0,,Адам кейпінде қалу мүмкін емес.
Dialogue: 0,0:29:43.00,0:29:47.01,Default,,0,0,0,,Десе де мен бұл дүниеге деген тәуелділігімнен арыла алуым керек.
Dialogue: 0,0:29:47.01,0:29:52.01,Default,,0,0,0,,Теңіз өрмекшісі ұсқынсыз, ұтымды құбыжыққа айналады.
Dialogue: 0,0:29:52.01,0:29:55.00,Default,,0,0,0,,Теңізді көтеріп, адамдарға шабуыл жасаңыз
Dialogue: 0,0:29:55.00,0:29:58.00,Default,,0,0,0,,Барлығын жоюға тырысады
Dialogue: 0,0:29:58.00,0:30:01.01,Default,,0,0,0,,Сондықтан біз
Dialogue: 0,0:30:01.01,0:30:04.01,Default,,0,0,0,,Балалар...
Dialogue: 0,0:30:04.01,0:30:07.01,Default,,0,0,0,,Теңіз өрмекшісі толық құбыжық болып,
Dialogue: 0,0:30:07.01,0:30:10.02,Default,,0,0,0,,Бұл теңізде бейбітшілік сақталады.
Dialogue: 0,0:30:10.02,0:30:14.02,Default,,0,0,0,,Бұл теңіз өрмекшілері мен теңіз құбыжықтарының өзгермейтін тағдыры.
Dialogue: 0,0:30:16.00,0:30:18.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:30:18.01,0:30:21.01,Default,,0,0,0,,Бұл дұрыс емес... Сенсей
Dialogue: 0,0:30:34.01,0:30:37.01,Default,,0,0,0,,Тамақ же, адамдарды же
Dialogue: 0,0:30:37.01,0:30:40.01,Default,,0,0,0,,Және адам ойларын кесіп тастаңыз
Dialogue: 0,0:30:40.01,0:30:42.01,Default,,0,0,0,,Толық теңіз өрмекші бол
Dialogue: 0,0:30:46.02,0:30:48.02,Default,,0,0,0,,Нубе
Dialogue: 0,0:30:50.01,0:30:52.01,Default,,0,0,0,,Юкиме-сан, Нубеге қауіп төніп тұр
Dialogue: 0,0:30:52.01,0:30:55.01,Default,,0,0,0,,Жоқ, ол бала әлі...
Dialogue: 0,0:30:55.01,0:30:57.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:01.02,0:31:04.02,Default,,0,0,0,,Мені тыңда, Нағиса-күн.
Dialogue: 0,0:31:06.00,0:31:10.01,Default,,0,0,0,,Йокайды адам санасы жасайды.
Dialogue: 0,0:31:10.01,0:31:12.01,Default,,0,0,0,,Адамның өшпенділігі мен өшпенділігі
Dialogue: 0,0:31:12.01,0:31:16.01,Default,,0,0,0,,Қорқыныш сияқты күшті эмоциялар құбыжықтарды тудырады.
Dialogue: 0,0:31:16.01,0:31:18.02,Default,,0,0,0,,Және солай
Dialogue: 0,0:31:18.02,0:31:22.00,Default,,0,0,0,,Күлкілі, көбінесе адамға зиянды
Dialogue: 0,0:31:22.00,0:31:24.00,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:31:26.01,0:31:28.01,Default,,0,0,0,,Адамдарды өлтірмеу
Dialogue: 0,0:31:28.01,0:31:32.01,Default,,0,0,0,,Әр адамның жүрегін баурап алатын жұмбақ сүйкімділігің
Dialogue: 0,0:31:32.01,0:31:35.02,Default,,0,0,0,,Бұл теңіз өрмекшісінің сиқырлы күші болды ма?
Dialogue: 0,0:31:35.02,0:31:38.00,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:31:38.00,0:31:40.00,Default,,0,0,0,,Мен басқаша сенемін.
Dialogue: 0,0:31:57.01,0:31:59.01,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:32:02.01,0:32:04.01,Default,,0,0,0,,Рахмет
Dialogue: 0,0:32:04.01,0:32:06.01,Default,,0,0,0,,Мені тоқтатқаныңыз үшін рахмет.
Dialogue: 0,0:32:06.01,0:32:09.02,Default,,0,0,0,,Мен адамдарды жеймін
Dialogue: 0,0:32:09.02,0:32:13.00,Default,,0,0,0,,Мен толық құбыжық болу тағдырымен тудым.
Dialogue: 0,0:32:13.00,0:32:15.00,Default,,0,0,0,,Бірақ... бірақ
Dialogue: 0,0:32:17.01,0:32:19.01,Default,,0,0,0,,Мен мұны істей алмаймын
Dialogue: 0,0:32:19.01,0:32:22.01,Default,,0,0,0,,Достарыңды жеп, өлтіріңдер
Dialogue: 0,0:32:22.01,0:32:26.01,Default,,0,0,0,,Мен бұл дүниеде олай істегім келмейді.
Dialogue: 0,0:32:31.01,0:32:34.01,Default,,0,0,0,,Барлығы, бұл аз ғана уақыт болды, бірақ
Dialogue: 0,0:32:34.01,0:32:37.01,Default,,0,0,0,,Достық үшін рахмет.
Dialogue: 0,0:32:37.01,0:32:39.01,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,0:32:39.01,0:32:41.02,Default,,0,0,0,,Нагиса-чан
Dialogue: 0,0:32:41.02,0:32:45.02,Default,,0,0,0,,Мен енді ешкімге қиындық тудырғым келмейді.
Dialogue: 0,0:32:45.02,0:32:48.01,Default,,0,0,0,,Ол қашан қайтадан сол пішінге оралады және бәрін тастап кетеді ...
Dialogue: 0,0:32:48.01,0:32:50.01,Default,,0,0,0,,Мұғалім, өтінемін
Dialogue: 0,0:32:50.01,0:32:53.01,Default,,0,0,0,,Маған қолыңызды беріңізші...
Dialogue: 0,0:32:53.01,0:32:55.01,Default,,0,0,0,,Нагиса-кун
Dialogue: 0,0:33:04.02,0:33:06.01,Default,,0,0,0,,Жынның қолы
Dialogue: 0,0:33:06.01,0:33:08.01,Default,,0,0,0,,Осы баланың жаны жаннатта болсын...
Dialogue: 0,0:33:08.01,0:33:10.01,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:33:10.01,0:33:14.02,Default,,0,0,0,,Тіпті құбыжықтар Тіпті құбыжықтар
Dialogue: 0,0:33:14.02,0:33:17.02,Default,,0,0,0,,Адамдар сияқты мен де сүйген адамыммен бірге болғым келеді.
Dialogue: 0,0:33:17.02,0:33:19.02,Default,,0,0,0,,Юкиме-кун
Dialogue: 0,0:33:19.02,0:33:21.02,Default,,0,0,0,,Сәлем, мұғалім
Dialogue: 0,0:33:21.02,0:33:24.01,Default,,0,0,0,,Сіз бақытты бола алмайсыз ба?
Dialogue: 0,0:33:24.01,0:33:26.01,Default,,0,0,0,,Қалай болғанда да?
Dialogue: 0,0:33:26.01,0:33:29.01,Default,,0,0,0,,Нубе~ Нагиса-чан өлмесін
Dialogue: 0,0:33:29.01,0:33:31.02,Default,,0,0,0,,Нагиса-чанның да бақытты болуға құқығы бар.
Dialogue: 0,0:33:31.02,0:33:34.02,Default,,0,0,0,,Дұрыс, Нубе~
Dialogue: 0,0:33:34.02,0:33:37.02,Default,,0,0,0,,Мен сіздің сезіміңізді толық түсінемін.
Dialogue: 0,0:33:37.02,0:33:40.01,Default,,0,0,0,,Алайда Нағиса-кунның зұлым тағдырын тоқтату үшін...
Dialogue: 0,0:33:40.01,0:33:43.01,Default,,0,0,0,,Нагиса-чан Нагиса-чан
Dialogue: 0,0:33:43.01,0:33:45.01,Default,,0,0,0,,Менімен бәрі жақсы ма?
Dialogue: 0,0:33:45.01,0:33:48.02,Default,,0,0,0,,Барлығымен дос бола білдім.
Dialogue: 0,0:33:48.02,0:33:50.02,Default,,0,0,0,,Менің сиқырлы күшімнің арқасында
Dialogue: 0,0:33:50.02,0:33:52.02,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:33:52.02,0:33:55.02,Default,,0,0,0,,Бізді Нағиса-чанға тартты.
Dialogue: 0,0:33:55.02,0:33:58.01,Default,,0,0,0,,Өйткені Нағиса-чанның жүрегі таза, әдемі болған.
Dialogue: 0,0:33:58.01,0:34:01.01,Default,,0,0,0,,Аа, сондықтан біз бірден дос болып кеттік.
Dialogue: 0,0:34:01.01,0:34:03.01,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:34:03.01,0:34:06.02,Default,,0,0,0,,Біз әрқашан дос боламыз.
Dialogue: 0,0:34:06.02,0:34:08.02,Default,,0,0,0,,Бұдан былай және мәңгілікке
Dialogue: 0,0:34:08.02,0:34:10.02,Default,,0,0,0,,Нагиса-чан
Dialogue: 0,0:34:10.02,0:34:12.02,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:34:17.01,0:34:19.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:35:12.02,0:35:14.02,Default,,0,0,0,,Нуэно мырза
Dialogue: 0,0:35:14.02,0:35:16.02,Default,,0,0,0,,Кеше Өрмекші аралында не болды?
Dialogue: 0,0:35:16.02,0:35:18.02,Default,,0,0,0,,Не? Иә... жақсы
Dialogue: 0,0:35:22.03,0:35:24.01,Default,,0,0,0,,Нагиса-чан
Dialogue: 0,0:35:24.01,0:35:27.02,Default,,0,0,0,,Мен сені ешқашан ұмытпаймын
Dialogue: 0,0:35:27.02,0:35:29.02,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:35:32.02,0:35:34.02,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:35:34.02,0:35:36.02,Default,,0,0,0,,Иә? Қайда... қайда?
Dialogue: 0,0:35:36.02,0:35:38.03,Default,,0,0,0,,Қараңдаршы, мына жартаста бірдеңе бар...
Dialogue: 0,0:35:38.03,0:35:40.01,Default,,0,0,0,,Су перісі?
Dialogue: 0,0:35:40.01,0:35:42.01,Default,,0,0,0,,Бірақ бұл алыс, мен шынымен түсінбеймін.
Dialogue: 0,0:35:42.01,0:35:44.02,Default,,0,0,0,,Ұқсас нәрсе
Dialogue: 0,0:35:44.02,0:35:46.02,Default,,0,0,0,,Маған солай көрінеді
Dialogue: 0,0:35:46.02,0:35:49.02,Default,,0,0,0,,Нагиса-чан, сенің әлі тірі екеніңе сене алар емеспін.
Dialogue: 0,0:35:51.02,0:35:53.02,Default,,0,0,0,,Мен Нағиса-чанды дәл қазір көрдім.
Dialogue: 0,0:35:53.02,0:35:55.03,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:35:55.03,0:35:59.01,Default,,0,0,0,,Адамдардың ұсқынсыз жүректері мен қорқыныштары құбыжықтарды тудырады
Dialogue: 0,0:35:59.01,0:36:02.02,Default,,0,0,0,,Бірақ керісінше де дұрыс.
Dialogue: 0,0:36:02.02,0:36:04.02,Default,,0,0,0,,Сол балалардың жылы жүректері
Dialogue: 0,0:36:04.02,0:36:09.02,Default,,0,0,0,,Нағисаның тағдырын кесіп, құбыжықты сұлу су перісіне айналдырдым.
Dialogue: 0,0:36:09.02,0:36:12.03,Default,,0,0,0,,Мұндай жағдайдың болғаны жақсы ма, білмеймін.
Dialogue: 0,0:36:12.03,0:36:14.03,Default,,0,0,0,,Бұл Нагиса-кун.
Dialogue: 0,0:36:14.03,0:36:17.03,Default,,0,0,0,,Ең болмағанда сол балалар үшін
Dialogue: 0,0:36:23.02,0:36:26.02,Default,,0,0,0,,Сау бол, Нағиса-чан.
Dialogue: 0,0:36:26.02,0:36:28.03,Default,,0,0,0,,Мен тағы да келетініме сенімдімін
Dialogue: 0,0:36:28.03,0:36:31.03,Default,,0,0,0,,Қайтадан бірге ойнайық
Dialogue: 0,0:36:33.01,0:36:37.01,Default,,0,0,0,,Қош сау бол
Dialogue: 0,0:36:41.92,0:36:43.92,Default,,0,0,0,,Нагиса-чан, сау бол
Dialogue: 0,0:40:52.14,0:40:57.11,Default,,0,0,0,,♬～«Бірінші – махаббат»
Dialogue: 0,0:40:58.61,0:41:04.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory