Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.83,0:00:06.67,Default,,0,0,0,,Мен жеңіске жеттім.
Dialogue: 0,0:00:06.79,0:00:09.17,Default,,0,0,0,,Яр Торға рахмет
Dialogue: 0,0:00:09.30,0:00:11.88,Default,,0,0,0,,Менің болашақ күйеуім күткендей.
Dialogue: 0,0:00:12.01,0:00:13.97,Default,,0,0,0,,Хмф, бұл анық.
Dialogue: 0,0:00:14.09,0:00:15.59,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:00:16.01,0:00:18.35,Default,,0,0,0,,Қайда бара жатырсың? (Барлығы) Ха!
Dialogue: 0,0:00:19.10,0:00:22.02,Default,,0,0,0,,Әлі ештеңе бітпесе де
Dialogue: 0,0:00:25.94,0:00:28.31,Default,,0,0,0,,О, қымбаттым!
Dialogue: 0,0:00:28.65,0:00:29.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:30.53,0:00:31.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:32.49,0:00:33.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:36.61,0:00:39.28,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:00:42.08,0:00:46.50,Default,,0,0,0,,Blaze - бұл қару, бірақ оның ең әлсіз тұсы
Dialogue: 0,0:00:51.80,0:00:53.59,Default,,0,0,0,,Ай! (Кугисаки) Бұл не өзі?
Dialogue: 0,0:00:54.05,0:00:56.18,Default,,0,0,0,,Уф... аа... у...
Dialogue: 0,0:00:58.85,0:01:00.81,Default,,0,0,0,,Лилит! Жолбарыс!
Dialogue: 0,0:01:01.60,0:01:03.93,Default,,0,0,0,,Тіпті ол Exception шақырды...
Dialogue: 0,0:01:04.10,0:01:05.60,Default,,0,0,0,,Осыншама...
Dialogue: 0,0:01:08.35,0:01:11.11,Default,,0,0,0,,Өйткені, Артық жау емес.
Dialogue: 0,0:01:15.32,0:01:17.20,Default,,0,0,0,,Осы қираудың алдында!
Dialogue: 0,0:01:21.41,0:01:22.37,Default,,0,0,0,,Уф
Dialogue: 0,0:01:23.45,0:01:24.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:29.67,0:01:31.42,Default,,0,0,0,,Мен ойланбастан басар едім
Dialogue: 0,0:01:37.30,0:01:38.30,Default,,0,0,0,,Уф
Dialogue: 0,0:01:38.55,0:01:39.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:39.51,0:01:40.35,Default,,0,0,0,,Юрий!
Dialogue: 0,0:01:40.64,0:01:41.47,Default,,0,0,0,,Бұл сызат.
Dialogue: 0,0:01:44.56,0:01:45.73,Default,,0,0,0,,Ах
Dialogue: 0,0:01:46.73,0:01:48.52,Default,,0,0,0,,Уф... Тор!?
Dialogue: 0,0:01:49.06,0:01:50.27,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:50.65,0:01:53.53,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:01:58.49,0:02:00.78,Default,,0,0,0,,Мистер Йошитоки
Dialogue: 0,0:02:01.28,0:02:02.12,Default,,0,0,0,,Уф
Dialogue: 0,0:02:02.83,0:02:05.37,Default,,0,0,0,,Сіз мүгедек болсаңыз да жеңемін деп ойлайсыз ба?
Dialogue: 0,0:02:06.00,0:02:08.37,Default,,0,0,0,,Юрий менің дуэтім...
Dialogue: 0,0:02:09.00,0:02:10.79,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:02:10.92,0:02:15.13,Default,,0,0,0,,Неліктен бізге күштірек болу үшін басқалар керек?
Dialogue: 0,0:02:16.42,0:02:17.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:20.01,0:02:23.47,Default,,0,0,0,,Сіз ерік күші күшке айналады деп жалған мәлімдеме жасайсыз ба?
Dialogue: 0,0:02:23.64,0:02:24.47,Default,,0,0,0,,Құт
Dialogue: 0,0:02:25.06,0:02:26.06,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:26.18,0:02:27.02,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:02:28.10,0:02:28.94,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:31.56,0:02:32.90,Default,,0,0,0,,А... (мөлдір) Иа...
Dialogue: 0,0:02:33.52,0:02:35.65,Default,,0,0,0,,Сондықтан ол нәзік және әлсіз
Dialogue: 0,0:02:35.90,0:02:37.57,Default,,0,0,0,,Уф уау
Dialogue: 0,0:02:37.69,0:02:39.61,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:39.74,0:02:40.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:44.33,0:02:47.41,Default,,0,0,0,,Өзіңіздің дәрменсіздігіңізді мойындаңыз.
Dialogue: 0,0:02:55.46,0:02:57.13,Default,,0,0,0,,Сіз мұны ұмыттыңыз ба?
Dialogue: 0,0:03:00.26,0:03:04.30,Default,,0,0,0,,Корё Гакуэн... Бұл тамаша жер.
Dialogue: 0,0:03:04.43,0:03:05.22,Default,,0,0,0,,Ха...
Dialogue: 0,0:03:05.72,0:03:10.44,Default,,0,0,0,,Бірге үйрен, бірге жарыс, бірге күл
Dialogue: 0,0:03:11.19,0:03:15.52,Default,,0,0,0,,Бұл уақытыңызды жарқыратып өткізуге тамаша орын.
Dialogue: 0,0:03:16.40,0:03:17.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:20.65,0:03:22.66,Default,,0,0,0,,Өте керемет-
Dialogue: 0,0:03:23.24,0:03:24.20,Default,,0,0,0,,У… Қозғалма! Атып жіберемін!
Dialogue: 0,0:03:31.71,0:03:33.17,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:35.34,0:03:36.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:37.21,0:03:38.92,Default,,0,0,0,,Неге сонша...
Dialogue: 0,0:03:39.05,0:03:42.09,Default,,0,0,0,,Қорғағың келетін досың жоқ па?
Dialogue: 0,0:03:42.68,0:03:44.97,Default,,0,0,0,,Қорғағысы келетін сезім!
Dialogue: 0,0:03:46.30,0:03:47.93,Default,,0,0,0,,Осындай нәрсе-
Dialogue: 0,0:03:48.68,0:03:51.14,Default,,0,0,0,,Бұл у да, дәрі де емес.
Dialogue: 0,0:03:51.27,0:03:52.14,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:03:52.48,0:03:57.44,Default,,0,0,0,,Мен үшін күш - бәрі!
Dialogue: 0,0:04:04.16,0:04:06.99,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:09.33,0:04:11.16,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:04:11.70,0:04:15.96,Default,,0,0,0,,Жасайық! Қарғыс атсын!
Dialogue: 0,0:04:21.09,0:04:21.92,Default,,0,0,0,,Ха...
Dialogue: 0,0:04:24.55,0:04:28.43,Default,,0,0,0,,Хмм... у... хмм...
Dialogue: 0,0:04:28.60,0:04:30.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:30.14,0:04:33.18,Default,,0,0,0,,Ик! (Адамдар айқайлап жатыр)
Dialogue: 0,0:04:36.35,0:04:39.19,Default,,0,0,0,,Уф... Хаа Хаа...
Dialogue: 0,0:04:39.82,0:04:44.20,Default,,0,0,0,,Мен мұнымен айналысамын, сондықтан мені өлтір!
Dialogue: 0,0:04:45.41,0:04:47.07,Default,,0,0,0,,Айды көру…
Dialogue: 0,0:04:47.24,0:04:48.37,Default,,0,0,0,,Иә
Dialogue: 0,0:04:51.04,0:04:52.29,Default,,0,0,0,,Гааах!
Dialogue: 0,0:04:52.41,0:04:55.21,Default,,0,0,0,,Мен қалаған кезде ұйықтай алмаймын.
Dialogue: 0,0:04:59.00,0:04:59.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:01.17,0:05:04.34,Default,,0,0,0,,Мен мұғалім болмауым керек еді...
Dialogue: 0,0:05:11.35,0:05:14.64,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:14.77,0:05:17.69,Default,,0,0,0,,Жарайды, мен көмектесе алмаймын.
Dialogue: 0,0:05:21.36,0:05:22.90,Default,,0,0,0,,Пайдасыз заттар
Dialogue: 0,0:05:26.32,0:05:28.78,Default,,0,0,0,,Сіздің ойыңызша, мұндай нәрсе бірдеңе жасайды ма?
Dialogue: 0,0:05:28.91,0:05:31.37,Default,,0,0,0,,Жоқ, бірақ менің соқыр жерім бар.
Dialogue: 0,0:05:31.49,0:05:32.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:33.16,0:05:34.16,Default,,0,0,0,,Эй!
Dialogue: 0,0:05:37.42,0:05:39.21,Default,,0,0,0,,Бұл өкінішті болды.
Dialogue: 0,0:05:39.75,0:05:40.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:41.75,0:05:44.38,Default,,0,0,0,,Егер бұл қашықтық болса, мен оны жіберіп алмаймын.
Dialogue: 0,0:05:45.55,0:05:46.38,Default,,0,0,0,,Хмм (К) Ах.
Dialogue: 0,0:05:54.52,0:05:55.89,Default,,0,0,0,,Сіздің жараңыз жақсы ма?
Dialogue: 0,0:05:56.02,0:05:58.48,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:05:59.15,0:06:01.98,Default,,0,0,0,,Менің сәл тыныш болғанымды қалайсыз ба?
Dialogue: 0,0:06:04.40,0:06:06.07,Default,,0,0,0,,Ха (мөлдір) Юрий!
Dialogue: 0,0:06:10.91,0:06:11.74,Default,,0,0,0,,Тор!
Dialogue: 0,0:06:13.37,0:06:14.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:19.42,0:06:20.83,Default,,0,0,0,,Қандай батыл бала.
Dialogue: 0,0:06:22.59,0:06:23.46,Default,,0,0,0,,Тор!
Dialogue: 0,0:06:37.93,0:06:38.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:39.06,0:06:42.15,Default,,0,0,0,,Қарашы, сен оны қорғауың керек емес пе еді?
Dialogue: 0,0:06:42.52,0:06:46.65,Default,,0,0,0,,Хахахахаха достарыңның алдында аянышты болып өл
Dialogue: 0,0:06:47.32,0:06:48.57,Default,,0,0,0,,Сіздің өліміңіз...
Dialogue: 0,0:06:48.69,0:06:52.28,Default,,0,0,0,,Оның жүрегін мәңгілікке жейтін тыртық болады.
Dialogue: 0,0:06:59.75,0:07:00.92,Default,,0,0,0,,Тор…
Dialogue: 0,0:07:01.75,0:07:04.00,Default,,0,0,0,,Тор Тор…
Dialogue: 0,0:07:05.21,0:07:07.67,Default,,0,0,0,,Тор… Тор…
Dialogue: 0,0:07:08.21,0:07:10.05,Default,,0,0,0,,Тор! Тор!
Dialogue: 0,0:07:10.47,0:07:13.05,Default,,0,0,0,,Маңызды дуэт Торды шақырып жатыр!
Dialogue: 0,0:07:13.18,0:07:14.89,Default,,0,0,0,,Эй, тұр, Тор!
Dialogue: 0,0:07:15.01,0:07:17.39,Default,,0,0,0,,Тор Тор! (Қ) Жалынды сөндір.
Dialogue: 0,0:07:17.52,0:07:20.73,Default,,0,0,0,,Сен мені қорғайсың ба? Коконо ағыны!
Dialogue: 0,0:07:20.85,0:07:26.32,Default,,0,0,0,,(Қ-ның күлуі)
Dialogue: 0,0:07:26.44,0:07:30.49,Default,,0,0,0,,Мен рұқсат бермеймін... мүлде...
Dialogue: 0,0:07:31.07,0:07:35.20,Default,,0,0,0,,Мен ешқашан... Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:07:35.66,0:07:40.71,Default,,0,0,0,,Мен саған бір кездері мені жаралаған қара күшті көрсеттім.
Dialogue: 0,0:07:41.25,0:07:44.21,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:07:44.33,0:07:47.71,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:07:48.42,0:07:50.76,Default,,0,0,0,,Хамф (К) Жақсы...
Dialogue: 0,0:07:53.51,0:07:54.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:54.47,0:07:57.10,Default,,0,0,0,,Иә, иә, иә.
Dialogue: 0,0:07:57.22,0:08:00.48,Default,,0,0,0,,Хамф! (К) Уф!
Dialogue: 0,0:08:00.60,0:08:04.65,Default,,0,0,0,,Хамф!
Dialogue: 0,0:08:09.32,0:08:10.15,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:12.32,0:08:14.53,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:08:19.41,0:08:21.41,Default,,0,0,0,,Мұндай... мұндай күш...
Dialogue: 0,0:08:22.16,0:08:24.96,Default,,0,0,0,,Осы жойылудан асатын қуат...
Dialogue: 0,0:08:25.37,0:08:27.38,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:08:28.63,0:08:32.05,Default,,0,0,0,,Сіз мұны мойындайсыз ба?
Dialogue: 0,0:08:38.43,0:08:39.76,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:43.73,0:08:46.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:47.10,0:08:48.56,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:52.82,0:08:54.61,Default,,0,0,0,,Арғ... Арғ...
Dialogue: 0,0:09:01.24,0:09:03.37,Default,,0,0,0,,Уф! Юрий…
Dialogue: 0,0:09:03.66,0:09:06.62,Default,,0,0,0,,Ха...
Dialogue: 0,0:09:07.79,0:09:10.13,Default,,0,0,0,,Жоқ... Юрий...
Dialogue: 0,0:09:11.17,0:09:12.51,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:09:17.09,0:09:20.39,Default,,0,0,0,,Ух... хе... уф...
Dialogue: 0,0:09:20.89,0:09:23.39,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:09:23.52,0:09:25.64,Default,,0,0,0,,Хаа... хаа... (К) Ух... уф... уф...
Dialogue: 0,0:09:25.77,0:09:28.73,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:09:28.85,0:09:31.07,Default,,0,0,0,,Юрий! Жоқ! Хаа...
Dialogue: 0,0:09:31.19,0:09:32.19,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:39.20,0:09:41.41,Default,,0,0,0,,Коконое... Торую!
Dialogue: 0,0:09:42.66,0:09:44.41,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:09:49.21,0:09:53.67,Default,,0,0,0,,Юрийдің тістерін кесіңіз! Эйгис Қалауы!
Dialogue: 0,0:09:56.17,0:09:58.88,Default,,0,0,0,,'Бұл не?'
Dialogue: 0,0:10:00.05,0:10:03.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:03.64,0:10:07.48,Default,,0,0,0,,Юрий, мен сенің сезіміңді түсінемін.
Dialogue: 0,0:10:08.02,0:10:13.44,Default,,0,0,0,,Мен үшін маңызды адам өлтірілгеннен кейін, мен жауымның кек алу үшін күш іздедім ...
Dialogue: 0,0:10:14.32,0:10:17.90,Default,,0,0,0,,Өйткені сен екеуміз бір Кек алушымыз.
Dialogue: 0,0:10:19.03,0:10:22.45,Default,,0,0,0,,Бірақ күш алған сайын түсінбедім.
Dialogue: 0,0:10:22.83,0:10:26.29,Default,,0,0,0,,Билік... Кек алу дұрыс па...
Dialogue: 0,0:10:26.75,0:10:30.92,Default,,0,0,0,,Бұл күш пен оның күшінің айырмашылығы неде...
Dialogue: 0,0:10:44.35,0:10:47.89,Default,,0,0,0,,Юрий, мұның бәрі сенің арқаң.
Dialogue: 0,0:10:47.98,0:10:48.52,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:10:48.52,0:10:49.31,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:10:48.52,0:10:49.31,Default,,0,0,0,,Сенімен өткізген уақыт мені түсінді
Dialogue: 0,0:10:49.31,0:10:52.44,Default,,0,0,0,,Сенімен өткізген уақыт мені түсінді
Dialogue: 0,0:10:54.19,0:10:56.36,Default,,0,0,0,,Мен қорғағым келді
Dialogue: 0,0:10:56.94,0:11:01.45,Default,,0,0,0,,Сонымен менің жаным... Жалын қару емес...
Dialogue: 0,0:11:01.57,0:11:02.87,Default,,0,0,0,,Бұл қалқан
Dialogue: 0,0:11:03.16,0:11:05.45,Default,,0,0,0,,Билік сол үшін болды.
Dialogue: 0,0:11:09.66,0:11:11.17,Default,,0,0,0,,Сонымен Юрий
Dialogue: 0,0:11:12.12,0:11:13.67,Default,,0,0,0,,Мен сені қорғаймын!
Dialogue: 0,0:11:16.80,0:11:18.09,Default,,0,0,0,,Уф
Dialogue: 0,0:11:18.21,0:11:20.30,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:11:22.01,0:11:24.39,Default,,0,0,0,,(Экхарт) Кторигалга басып кірген бейбітшілікке қарсы күштер—
Dialogue: 0,0:11:24.85,0:11:28.81,Default,,0,0,0,,Ха! Хаа... уф...
Dialogue: 0,0:11:29.31,0:11:31.89,Default,,0,0,0,,Юрий Жетеді... Ух... Хаа... Уф...
Dialogue: 0,0:11:32.02,0:11:34.31,Default,,0,0,0,,Мен өлген жоқпын хаха...
Dialogue: 0,0:11:34.44,0:11:36.02,Default,,0,0,0,,Өйткені мен тірімін... Ха...
Dialogue: 0,0:11:36.15,0:11:38.57,Default,,0,0,0,,Ик! (Адамдар айқайлап жатыр)
Dialogue: 0,0:11:38.98,0:11:42.78,Default,,0,0,0,,Қайтып келші, Юрий!
Dialogue: 0,0:11:43.36,0:11:44.53,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:11:52.29,0:11:54.13,Default,,0,0,0,,Tor... le?
Dialogue: 0,0:11:54.25,0:11:56.63,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:11:57.55,0:12:02.09,Default,,0,0,0,,Ха, Тор, Тор, мен... мен...
Dialogue: 0,0:12:02.22,0:12:05.18,Default,,0,0,0,,Мен сені міндетті түрде қорғаймын дедің.
Dialogue: 0,0:12:10.18,0:12:11.43,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:13.02,0:12:15.73,Default,,0,0,0,,Менің ағам сені міндетті түрде қорғайды.
Dialogue: 0,0:12:18.48,0:12:20.69,Default,,0,0,0,,Ерік күші және т.б.
Dialogue: 0,0:12:21.36,0:12:23.53,Default,,0,0,0,,Осындай нәрсе бар ма?
Dialogue: 0,0:12:23.65,0:12:24.49,Default,,0,0,0,,Га
Dialogue: 0,0:12:25.20,0:12:27.49,Default,,0,0,0,,Кууууууууу…
Dialogue: 0,0:12:27.91,0:12:30.74,Default,,0,0,0,,Жетер, енді мағынасыз.
Dialogue: 0,0:12:31.08,0:12:35.00,Default,,0,0,0,,Иә, ұтылып қалсақ бәрінің мәні жоқ.
Dialogue: 0,0:12:35.54,0:12:37.75,Default,,0,0,0,,Сондықтан мен сені өлтіремін!
Dialogue: 0,0:12:38.50,0:12:42.30,Default,,0,0,0,,Менде күш қана қалды.
Dialogue: 0,0:12:43.51,0:12:46.22,Default,,0,0,0,,Олай болса мен оны соңына дейін қорғаймын.
Dialogue: 0,0:12:46.89,0:12:48.76,Default,,0,0,0,,А... Юрий?
Dialogue: 0,0:12:49.72,0:12:51.14,Default,,0,0,0,,Мен де
Dialogue: 0,0:12:51.72,0:12:54.23,Default,,0,0,0,,Себебі мен Тордың дуэтімін
Dialogue: 0,0:12:55.10,0:12:56.15,Default,,0,0,0,,О
Dialogue: 0,0:12:59.57,0:13:02.15,Default,,0,0,0,,Эгис Қалауы!
Dialogue: 0,0:13:02.86,0:13:06.91,Default,,0,0,0,,Өл, Коконое Торю! Юрий Сигтуна!
Dialogue: 0,0:13:15.79,0:13:17.42,Default,,0,0,0,,Бітті
Dialogue: 0,0:13:18.08,0:13:18.92,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:20.00,0:13:22.17,Default,,0,0,0,,Неліктен? Неге!
Dialogue: 0,0:13:29.14,0:13:30.51,Default,,0,0,0,,Юрий мен...
Dialogue: 0,0:13:30.89,0:13:32.52,Default,,0,0,0,,Тор - мен...
Dialogue: 0,0:13:33.68,0:13:35.10,Default,,0,0,0,,Қорғаңыз!
Dialogue: 0,0:13:47.78,0:13:51.28,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:13:51.70,0:13:55.29,Default,,0,0,0,,Ақымақ... Неге оның мұндай күші бар...
Dialogue: 0,0:13:56.12,0:13:59.63,Default,,0,0,0,,Мен сені жалғыз жеңе алмаймын
Dialogue: 0,0:14:00.38,0:14:03.71,Default,,0,0,0,,Бірақ менде Юрий бар.
Dialogue: 0,0:14:04.88,0:14:07.38,Default,,0,0,0,,Байланысқан достар бар.
Dialogue: 0,0:14:07.76,0:14:09.05,Default,,0,0,0,,Бұл Duo
Dialogue: 0,0:14:09.55,0:14:11.26,Default,,0,0,0,,Бұл қолайлы ма?
Dialogue: 0,0:14:12.18,0:14:15.27,Default,,0,0,0,,Бұл қолайлы ма?
Dialogue: 0,0:14:15.39,0:14:16.23,Default,,0,0,0,,Уф
Dialogue: 0,0:14:17.39,0:14:18.48,Default,,0,0,0,,Га
Dialogue: 0,0:14:19.10,0:14:20.73,Default,,0,0,0,,Ах! (Мөлдір) Юрий!
Dialogue: 0,0:14:21.36,0:14:25.90,Default,,0,0,0,,Тор... жаным сенімен...
Dialogue: 0,0:14:27.82,0:14:29.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:30.07,0:14:32.49,Default,,0,0,0,,Арх!
Dialogue: 0,0:14:32.74,0:14:35.12,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:14:35.24,0:14:37.75,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:14:38.96,0:14:42.13,Default,,0,0,0,,Уау! (К) Әй!
Dialogue: 0,0:14:45.80,0:14:46.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:49.59,0:14:51.72,Default,,0,0,0,,Аға... мырза...
Dialogue: 0,0:14:55.18,0:14:58.23,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:14:58.35,0:15:02.31,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:15:02.94,0:15:04.61,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:15:08.49,0:15:09.70,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:15:11.32,0:15:13.32,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:15:22.96,0:15:23.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:24.29,0:15:25.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:25.54,0:15:29.09,Default,,0,0,0,,Менің кесірімнен мен бәріне қиындық тудырдым...
Dialogue: 0,0:15:29.30,0:15:30.76,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:15:31.38,0:15:32.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:34.05,0:15:35.10,Default,,0,0,0,,Эй
Dialogue: 0,0:15:35.51,0:15:37.60,Default,,0,0,0,,Біз күшейе аламыз.
Dialogue: 0,0:15:37.72,0:15:38.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:40.27,0:15:41.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:41.27,0:15:44.90,Default,,0,0,0,,Әрине менде Мияби бар.
Dialogue: 0,0:15:45.02,0:15:49.23,Default,,0,0,0,,Ух... иә, менде Томе-чан бар.
Dialogue: 0,0:15:50.90,0:15:55.49,Default,,0,0,0,,Мияби Тачибана Тора Тацу Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:15:55.95,0:15:57.12,Default,,0,0,0,,(Барлығының жауабы)
Dialogue: 0,0:15:57.37,0:16:00.20,Default,,0,0,0,,Мені қума, тітіркендіреді!
Dialogue: 0,0:16:00.33,0:16:01.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:01.41,0:16:04.67,Default,,0,0,0,,Хмм (оқушылар) Күте тұрыңыз, Куруса мырза.
Dialogue: 0,0:16:04.96,0:16:06.67,Default,,0,0,0,,Дааа! Мен сонша шаршадым!
Dialogue: 0,0:16:06.88,0:16:08.92,Default,,0,0,0,,Менің артымнан жүр! (Мөлдір) Бұл не?
Dialogue: 0,0:16:09.05,0:16:12.97,Default,,0,0,0,,Хмф, әлгі әйел студенттік жатақхананы қорғады, хмф!
Dialogue: 0,0:16:13.38,0:16:14.84,Default,,0,0,0,,А...
Dialogue: 0,0:16:15.80,0:16:17.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:29.86,0:16:32.40,Default,,0,0,0,,Иә, Торю, ауруханадан шыққаның құтты болсын.
Dialogue: 0,0:16:33.57,0:16:35.24,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:16:35.78,0:16:37.49,Default,,0,0,0,,Кевин Уэйфэйр
Dialogue: 0,0:16:38.16,0:16:41.41,Default,,0,0,0,,Қ.(Торю) атты бала туралы материалдар А?
Dialogue: 0,0:16:42.04,0:16:45.17,Default,,0,0,0,,Оның жақсы ағасы болған.
Dialogue: 0,0:16:45.46,0:16:48.17,Default,,0,0,0,,Алайда К кенет ағасынан айырылды.
Dialogue: 0,0:16:48.54,0:16:49.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:50.13,0:16:54.38,Default,,0,0,0,,Оның отбасы жойылып, өзі қараңғы әлемде.
Dialogue: 0,0:16:54.51,0:16:57.22,Default,,0,0,0,,Сол қарияның ұйымына сатылды
Dialogue: 0,0:16:58.14,0:16:59.14,Default,,0,0,0,,Хаа…
Dialogue: 0,0:16:59.60,0:17:02.60,Default,,0,0,0,,Отбасымнан айырылдым, атымнан айырылдым...
Dialogue: 0,0:17:02.73,0:17:06.10,Default,,0,0,0,,Мен тек билік пен нәтижені қалайтын жауынгер болып өстім.
Dialogue: 0,0:17:06.98,0:17:09.61,Default,,0,0,0,,Мұның бәрі ол туралы.
Dialogue: 0,0:17:10.77,0:17:12.90,Default,,0,0,0,,Маған неге бұлай істедің?
Dialogue: 0,0:17:13.15,0:17:15.11,Default,,0,0,0,,Мен сізге көңіл бөледі деп ойладым
Dialogue: 0,0:17:16.61,0:17:18.12,Default,,0,0,0,,Лилитке рахмет
Dialogue: 0,0:17:18.53,0:17:20.99,Default,,0,0,0,,Бұл болашақ жардың міндеті.
Dialogue: 0,0:17:21.58,0:17:22.49,Default,,0,0,0,,Фу…
Dialogue: 0,0:17:22.75,0:17:24.96,Default,,0,0,0,,Иә, алаңдайтын тағы бір нәрсе.
Dialogue: 0,0:17:25.08,0:17:25.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:26.04,0:17:28.33,Default,,0,0,0,,Бала бүгін ауруханадан шыққан сияқты.
Dialogue: 0,0:17:28.50,0:17:29.79,Default,,0,0,0,,Бұл рас па!?
Dialogue: 0,0:17:30.84,0:17:34.01,Default,,0,0,0,,Бұл реакция маған біртүрлі.
Dialogue: 0,0:17:34.38,0:17:35.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:35.76,0:17:37.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:37.72,0:17:39.85,Default,,0,0,0,,Хехе, жарайды.
Dialogue: 0,0:17:39.97,0:17:43.89,Default,,0,0,0,,Бір-бірімізді көптен бері көрмедік, солай ма? Мен сені бүгін үшін кешіремін
Dialogue: 0,0:17:44.22,0:17:45.77,Default,,0,0,0,,Toruyu-ға қош келдіңіз
Dialogue: 0,0:17:47.35,0:17:49.02,Default,,0,0,0,,Лилитке рахмет
Dialogue: 0,0:17:54.65,0:17:57.32,Default,,0,0,0,,К-ның материалдарын көрсетсем болады ма?
Dialogue: 0,0:17:57.45,0:17:59.03,Default,,0,0,0,,Сакуя да Торюға мейірімді.
Dialogue: 0,0:18:00.37,0:18:04.37,Default,,0,0,0,,Оның жан дүниесінде одан әрі өсуге үміт бар.
Dialogue: 0,0:18:04.91,0:18:07.54,Default,,0,0,0,,Маған жау болғандардың ойы да азық болар деп сенемін.
Dialogue: 0,0:18:08.37,0:18:10.54,Default,,0,0,0,,Сіз өзгерген жоқсыз, солай ма?
Dialogue: 0,0:18:11.46,0:18:14.55,Default,,0,0,0,,Иә, бәрі менің жолым...
Dialogue: 0,0:18:14.67,0:18:18.55,Default,,0,0,0,,Себебі мен абсолютті дуэтке жете алмаймын...
Dialogue: 0,0:18:18.97,0:18:21.18,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:18:25.27,0:18:30.23,Default,,0,0,0,,(тоқтың жылдам тынысы)
Dialogue: 0,0:18:30.35,0:18:32.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:32.98,0:18:33.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:33.94,0:18:35.94,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:18:36.07,0:18:37.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:38.03,0:18:43.28,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:18:47.91,0:18:51.25,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:18:55.59,0:18:57.46,Default,,0,0,0,,Гимлиді көрдіңіз бе?
Dialogue: 0,0:18:57.59,0:19:00.13,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:19:02.09,0:19:03.76,Default,,0,0,0,,Тор (мөлдір)?
Dialogue: 0,0:19:05.18,0:19:07.27,Default,,0,0,0,,Мен артық емеспін
Dialogue: 0,0:19:07.64,0:19:08.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:09.27,0:19:11.48,Default,,0,0,0,,Әкем өлтірілген күні
Dialogue: 0,0:19:11.81,0:19:15.57,Default,,0,0,0,,Билік тіледім
Dialogue: 0,0:19:15.69,0:19:16.65,Default,,0,0,0,,Және-
Dialogue: 0,0:19:17.94,0:19:21.61,Default,,0,0,0,,Мен кек азуын алдым.
Dialogue: 0,0:19:24.83,0:19:29.79,Default,,0,0,0,,Ел ояну, адамдарда жасырылған құдіретті оятатын
Dialogue: 0,0:19:30.16,0:19:31.79,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:19:32.25,0:19:34.29,Default,,0,0,0,,Elle... Оянды ма?
Dialogue: 0,0:19:34.79,0:19:39.26,Default,,0,0,0,,Адам жанының тереңінде жасырын бір күш бар.
Dialogue: 0,0:19:39.38,0:19:43.39,Default,,0,0,0,,Құдіреті оянып, жанды қару ретінде пайдаланатын болмыс.
Dialogue: 0,0:19:43.59,0:19:45.51,Default,,0,0,0,,Бұл El Awake
Dialogue: 0,0:19:45.64,0:19:48.68,Default,,0,0,0,,Бұл Exceed сияқты емес пе?
Dialogue: 0,0:19:50.31,0:19:51.44,Default,,0,0,0,,Асты-
Dialogue: 0,0:19:51.56,0:19:56.86,Default,,0,0,0,,Жан қуатын жасанды түрде оятқан Ел Оян деп естідім.
Dialogue: 0,0:19:58.03,0:20:01.61,Default,,0,0,0,,Мен бұл күшті басқара алмадым.
Dialogue: 0,0:20:01.99,0:20:05.62,Default,,0,0,0,,Таң ұйымы мені құтқарды.
Dialogue: 0,0:20:06.07,0:20:07.87,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:20:09.37,0:20:12.12,Default,,0,0,0,,Мен өтірік айттым
Dialogue: 0,0:20:12.87,0:20:14.54,Default,,0,0,0,,Мен қорықтым.
Dialogue: 0,0:20:14.92,0:20:17.50,Default,,0,0,0,,Егер мен артық болмасам...
Dialogue: 0,0:20:17.84,0:20:20.84,Default,,0,0,0,,Оның Торға ұқсамайтыны белгілі...
Dialogue: 0,0:20:21.22,0:20:24.72,Default,,0,0,0,,Мен бәрін білетін Тор кетіп қалады деп қорқамын...
Dialogue: 0,0:20:25.55,0:20:30.14,Default,,0,0,0,,Бәрінен де бұл күш бір күні Торға зиян тигізеді...
Dialogue: 0,0:20:30.27,0:20:32.68,Default,,0,0,0,,Бұл менің өмірімді алады деп қорқамын...
Dialogue: 0,0:20:33.39,0:20:34.69,Default,,0,0,0,,Юрий…
Dialogue: 0,0:20:34.90,0:20:37.73,Default,,0,0,0,,Бірақ... Бірақ-
Dialogue: 0,0:20:39.65,0:20:43.45,Default,,0,0,0,,Сонда да мен Тормен бірге болғым келеді.
Dialogue: 0,0:20:43.90,0:20:46.16,Default,,0,0,0,,Мен Тор дуэті болғым келеді
Dialogue: 0,0:20:49.33,0:20:51.75,Default,,0,0,0,,Мен де Юрийден кешірім сұрауым керек.
Dialogue: 0,0:20:52.08,0:20:53.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:53.16,0:20:57.46,Default,,0,0,0,,Мен Юрийдің шынайы күшін алғаш көргенде солай ойладым.
Dialogue: 0,0:20:57.83,0:21:00.05,Default,,0,0,0,,Оны қайта пайдалануға рұқсат етпеңіз
Dialogue: 0,0:21:00.30,0:21:03.51,Default,,0,0,0,,Менің Юрийді ренжітуге мүмкіндігім жоқ.
Dialogue: 0,0:21:05.05,0:21:10.26,Default,,0,0,0,,Бірақ мен оған оны қайтадан пайдалануға рұқсат еттім, мен Юрийді тағы да ренжіттім.
Dialogue: 0,0:21:10.47,0:21:12.77,Default,,0,0,0,,Бұл... (мөлдір) Жақсы.
Dialogue: 0,0:21:13.10,0:21:14.98,Default,,0,0,0,,Мен күшейемін
Dialogue: 0,0:21:15.14,0:21:18.02,Default,,0,0,0,,Юрийді шынымен қорғай алатындай күшті...
Dialogue: 0,0:21:19.23,0:21:20.57,Default,,0,0,0,,Сонымен Юрий
Dialogue: 0,0:21:21.40,0:21:24.78,Default,,0,0,0,,Мен сенің менің дуэтім болғаныңды қалаймын.
Dialogue: 0,0:21:34.37,0:21:35.66,Default,,0,0,0,,Жалын
Dialogue: 0,0:21:36.58,0:21:41.88,Default,,0,0,0,,Байланғандар мүмкіндігінше бірге көп уақыт өткізуі керек.
Dialogue: 0,0:21:42.55,0:21:47.88,Default,,0,0,0,,Қуанғанда да, мұңда да, сау болса да.
Dialogue: 0,0:21:48.59,0:21:52.06,Default,,0,0,0,,Өлім бізді ажыратқанша...
Dialogue: 0,0:21:53.35,0:21:58.35,Default,,0,0,0,,♪～
Dialogue: 0,0:23:17.56,0:23:22.56,Default,,0,0,0,,～♪
