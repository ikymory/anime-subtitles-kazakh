Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:26.77,0:00:29.86,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:00:30.86,0:00:35.36,Default,,0,0,0,,(Арктикалық әмбебап дүкенінің дүкендегі BGM)
Dialogue: 0,0:00:35.45,0:00:36.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:40.91,0:00:47.54,Default,,0,0,0,,(Дүкенде BGM арттыру)
Dialogue: 0,0:00:51.42,0:00:52.84,Default,,0,0,0,,Уау...
Dialogue: 0,0:00:55.01,0:01:02.02,Default,,0,0,0,,♪ Солтүстік полюс әмбебап дүкені, онда сіз бәрін таба аласыз
Dialogue: 0,0:01:02.52,0:01:09.31,Default,,0,0,0,,♪ Сатып алу үшін Арктика әмбебап дүкеніне барыңыз
Dialogue: 0,0:01:09.40,0:01:12.69,Default,,0,0,0,,Фуфуфу... хаха!
Dialogue: 0,0:01:15.15,0:01:15.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:26.25,0:01:27.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:29.88,0:01:30.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:31.29,0:01:32.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:32.17,0:01:34.55,Default,,0,0,0,,Ууууууууууууу~
Dialogue: 0,0:01:35.72,0:01:38.80,Default,,0,0,0,,Ваа, уа... Кешіріңіз!
Dialogue: 0,0:01:42.39,0:01:43.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:50.73,0:01:51.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:54.36,0:01:55.49,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:56.74,0:01:59.91,Default,,0,0,0,,Мен сізге көмектесе алатын бір нәрсе бар ма?
Dialogue: 0,0:02:02.53,0:02:05.29,Default,,0,0,0,,Сіздің әпкеңіз кім?
Dialogue: 0,0:02:05.91,0:02:07.04,Default,,0,0,0,,Мен...
Dialogue: 0,0:02:07.87,0:02:09.17,Default,,0,0,0,,Консьерж
Dialogue: 0,0:02:11.67,0:02:14.50,Default,,0,0,0,,Солтүстік полюс әмбебап дүкеніне қош келдіңіз
Dialogue: 0,0:02:16.84,0:02:18.84,Default,,0,0,0,,♪～
Dialogue: 0,0:03:00.26,0:03:04.55,Default,,0,0,0,,Мен, Акино, бүгіннен бастап осы әмбебап дүкенде жұмыс істеймін.
Dialogue: 0,0:03:07.27,0:03:10.39,Default,,0,0,0,,Бізде жануарлардың барлық түрлерін сатып алушылар бар.
Dialogue: 0,0:03:14.44,0:03:16.52,Default,,0,0,0,,Қанаттары бар жолаушылар
Dialogue: 0,0:03:17.03,0:03:18.82,Default,,0,0,0,,Тұяқты жолаушылар
Dialogue: 0,0:03:19.53,0:03:23.20,Default,,0,0,0,,Шағын тұтынушы Үлкен тұтынушы
Dialogue: 0,0:03:23.28,0:03:27.58,Default,,0,0,0,,Кейбір тұтынушылар сізге бейтаныс болуы мүмкін.
Dialogue: 0,0:03:27.66,0:03:28.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:29.33,0:03:30.46,Default,,0,0,0,,Көзге тию…
Dialogue: 0,0:03:33.71,0:03:35.71,Default,,0,0,0,,～♪
Dialogue: 0,0:03:42.47,0:03:44.14,Default,,0,0,0,,- (Акино) Қош келдіңіз! -(Қабан қыз) Иә?
Dialogue: 0,0:03:44.93,0:03:47.64,Default,,0,0,0,,Мен сізге көмектесетін бір нәрсе бар ма?
Dialogue: 0,0:03:48.68,0:03:49.68,Default,,0,0,0,,Қарап тұр
Dialogue: 0,0:03:50.93,0:03:52.44,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:03:53.02,0:03:53.85,Default,,0,0,0,,Бұл ыңғайсыздық
Dialogue: 0,0:03:53.94,0:03:56.11,Default,,0,0,0,,Суда шын мәнінде өз мүмкіндігін көрсететін техникалар бар!
Dialogue: 0,0:03:56.69,0:03:57.44,Default,,0,0,0,,арқылы!
Dialogue: 0,0:03:57.52,0:03:58.86,Default,,0,0,0,,- (Акино) Кешіріңіз... - Жолдан кетіңіз!
Dialogue: 0,0:03:58.94,0:04:00.44,Default,,0,0,0,,- (Акино) Кешіріңіз... - (Нутриа) Кетіңіз!
Dialogue: 0,0:04:01.36,0:04:02.24,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:04:02.99,0:04:03.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:03.91,0:04:07.16,Default,,0,0,0,,Сондай-ақ... Кешіріңіз! Пингвин тұтынушылары
Dialogue: 0,0:04:07.74,0:04:09.66,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:04:09.74,0:04:12.16,Default,,0,0,0,,Не... не істеуім керек... тыныс алу?
Dialogue: 0,0:04:12.25,0:04:14.29,Default,,0,0,0,,Қазір дәрігерге қаралыңыз!
Dialogue: 0,0:04:14.37,0:04:15.71,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:04:17.13,0:04:20.05,Default,,0,0,0,,Сондай-ақ… Кешіріңіз.
Dialogue: 0,0:04:20.67,0:04:23.30,Default,,0,0,0,,Сенің күлкіңді керемет тоқтатқаныңа сене алар емеспін
Dialogue: 0,0:04:23.38,0:04:23.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:25.76,0:04:26.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:28.14,0:04:29.76,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:04:29.85,0:04:35.02,Default,,0,0,0,,Күлкіні жер бетіндегі ең азап шеккен жануар ойлап тапқан.
Dialogue: 0,0:04:35.52,0:04:36.65,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:36.73,0:04:38.02,Default,,0,0,0,,Келіңіз, жас ханым.
Dialogue: 0,0:04:38.11,0:04:41.23,Default,,0,0,0,,Менің бөксемді екі қолыңызбен мықтап баса аласыз ба?
Dialogue: 0,0:04:41.32,0:04:43.36,Default,,0,0,0,,Не... сенің бөксең?
Dialogue: 0,0:04:43.44,0:04:44.61,Default,,0,0,0,,Иә
Dialogue: 0,0:04:45.11,0:04:47.16,Default,,0,0,0,,Бөксені ақырын қысыңыз
Dialogue: 0,0:04:47.74,0:04:49.62,Default,,0,0,0,,Бөртпе? Gulp?
Dialogue: 0,0:04:50.20,0:04:52.08,Default,,0,0,0,,Келіңіздер! Жақсы!
Dialogue: 0,0:04:52.16,0:04:54.08,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:04:59.25,0:05:00.46,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:05:01.96,0:05:03.97,Default,,0,0,0,,Менің атым Акино.
Dialogue: 0,0:05:04.05,0:05:06.30,Default,,0,0,0,,Бүгінгі көмектеріңіз үшін рахмет!
Dialogue: 0,0:05:06.80,0:05:08.97,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:05:09.05,0:05:10.85,Default,,0,0,0,,Консьерж Мори
Dialogue: 0,0:05:10.93,0:05:12.27,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:12.77,0:05:15.56,Default,,0,0,0,,Солтүстік полюс әмбебап дүкеніне қош келдіңіз
Dialogue: 0,0:05:17.02,0:05:17.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:19.56,0:05:22.82,Default,,0,0,0,,Ха! Өтінемін!
Dialogue: 0,0:05:22.90,0:05:24.49,Default,,0,0,0,,- (Гепард) Кешіріңіз - (Акино) Иә?
Dialogue: 0,0:05:24.57,0:05:27.74,Default,,0,0,0,,Поштаға қалай жетуге болады?
Dialogue: 0,0:05:27.82,0:05:28.87,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:05:28.95,0:05:32.24,Default,,0,0,0,,Поштаға баратын жол тік еңіс.
Dialogue: 0,0:05:32.74,0:05:34.79,Default,,0,0,0,,Сәл күте аласыз ба?
Dialogue: 0,0:05:34.87,0:05:36.71,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:05:37.21,0:05:38.79,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:40.46,0:05:43.25,Default,,0,0,0,,Қандай серпімді дене қозғалысы...
Dialogue: 0,0:05:44.21,0:05:45.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:45.26,0:05:46.51,Default,,0,0,0,,Күлімсіреу Күлімсіре!
Dialogue: 0,0:05:47.63,0:05:51.47,Default,,0,0,0,,Дәл қазір көңіл-күйің жоқ сияқты айнала жүрдің.
Dialogue: 0,0:05:51.55,0:05:52.76,Default,,0,0,0,,Барма!
Dialogue: 0,0:05:52.85,0:05:54.47,Default,,0,0,0,,Бұл сату аймағы.
Dialogue: 0,0:05:54.56,0:05:56.43,Default,,0,0,0,,Сіз көрдіңіз бе...
Dialogue: 0,0:05:57.19,0:06:00.06,Default,,0,0,0,,Мен Тодо-санның саған қайдан қарайтынын білмеймін.
Dialogue: 0,0:06:00.15,0:06:01.27,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:06:01.36,0:06:04.07,Default,,0,0,0,,Сынақ кезеңінде жұмыстан шығарғыңыз келмейді, солай ма?
Dialogue: 0,0:06:04.82,0:06:06.86,Default,,0,0,0,,Менің атым Ивасе. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:06:06.94,0:06:09.24,Default,,0,0,0,,бұл... Иә! Қолдауыңызға рахмет...
Dialogue: 0,0:06:09.32,0:06:13.24,Default,,0,0,0,,Тұтынушылар: Біз сіздің багажыңызды шкафта сақтаймыз.
Dialogue: 0,0:06:13.33,0:06:15.12,Default,,0,0,0,,О, мен сенен бір жақсылық сұрасам болады ма?
Dialogue: 0,0:06:15.20,0:06:16.66,Default,,0,0,0,,Бұл пайдалы~
Dialogue: 0,0:06:16.75,0:06:18.79,Default,,0,0,0,,Гепардтардың бүкіл денесінде остеопороз бар...
Dialogue: 0,0:06:18.87,0:06:19.83,Default,,0,0,0,,Мен де!
Dialogue: 0,0:06:22.92,0:06:24.55,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:06:24.63,0:06:27.13,Default,,0,0,0,,- (Акино) Тұтынушы? -иә?
Dialogue: 0,0:06:27.22,0:06:30.38,Default,,0,0,0,,Менің жүгіңді сақтауымды қалайсың ба?
Dialogue: 0,0:06:31.05,0:06:32.18,Default,,0,0,0,,багаж?
Dialogue: 0,0:06:32.26,0:06:33.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:33.47,0:06:36.93,Default,,0,0,0,,Сіздің арқаңыздағы багаж шкафта сақталады.
Dialogue: 0,0:06:37.56,0:06:40.06,Default,,0,0,0,,Бұл сіздің багажыңыз ба?
Dialogue: 0,0:06:40.90,0:06:41.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:41.98,0:06:42.81,Default,,0,0,0,,Шықыр!
Dialogue: 0,0:06:42.90,0:06:45.48,Default,,0,0,0,,Мына балаларды шкафқа лақтырасың ба?
Dialogue: 0,0:06:45.57,0:06:47.24,Default,,0,0,0,,...
Dialogue: 0,0:06:47.32,0:06:51.74,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз! opossum тұтынушысы
Dialogue: 0,0:06:55.74,0:06:58.62,Default,,0,0,0,,Ха... Көрмедім...
Dialogue: 0,0:06:58.70,0:06:59.87,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:06:59.96,0:07:01.96,Default,,0,0,0,,Уф! Ал... Тодо-сан?
Dialogue: 0,0:07:02.04,0:07:03.42,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:07:03.50,0:07:06.09,Default,,0,0,0,,Еден менеджері ретінде жаңа консьерж
Dialogue: 0,0:07:06.17,0:07:08.59,Default,,0,0,0,,Клиенттерге дөрекілік көрсетпеңіз
Dialogue: 0,0:07:08.67,0:07:10.30,Default,,0,0,0,,Маған қызық.
Dialogue: 0,0:07:10.80,0:07:12.76,Default,,0,0,0,,Сізге қиналып жатқан сияқтысыз, солай емес пе?
Dialogue: 0,0:07:14.22,0:07:16.14,Default,,0,0,0,,Бұл Тодо-сан...
Dialogue: 0,0:07:16.81,0:07:19.64,Default,,0,0,0,,Көмек сұрау қиын.
Dialogue: 0,0:07:19.73,0:07:23.06,Default,,0,0,0,,Егер тұтынушыға бұл қажет болмаса...
Dialogue: 0,0:07:23.65,0:07:26.07,Default,,0,0,0,,Менің ағаларыма қатты ұқсайды...
Dialogue: 0,0:07:27.23,0:07:29.57,Default,,0,0,0,,Көзіңізге қарап соншалықты көп нәрсені айта аласыз!
Dialogue: 0,0:07:29.65,0:07:32.41,Default,,0,0,0,,Ха... көзіме қарашы...
Dialogue: 0,0:07:32.49,0:07:33.03,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:07:33.11,0:07:34.62,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:07:34.70,0:07:38.58,Default,,0,0,0,,Тодо мырза? Тодо-сан, сен қайдасың?
Dialogue: 0,0:07:38.66,0:07:40.45,Default,,0,0,0,,Хехе...
Dialogue: 0,0:07:41.12,0:07:44.71,Default,,0,0,0,,Бұл сізге кеңес беру үшін Тодо-сан түрі.
Dialogue: 0,0:07:45.21,0:07:46.75,Default,,0,0,0,,Элле мырза
Dialogue: 0,0:07:49.80,0:07:55.18,Default,,0,0,0,,Менің көзіме қарап, көп нәрсені айта аласыз...
Dialogue: 0,0:07:55.76,0:07:58.72,Default,,0,0,0,,- (Түлкі ана) Қараңдаршы! Мен түсіп жатырмын - (Түлкі бала) Итте~
Dialogue: 0,0:07:59.22,0:07:59.89,Default,,0,0,0,,Ммм
Dialogue: 0,0:07:59.97,0:08:03.73,Default,,0,0,0,,Мен қандай тұтынушылардың проблемалары бар екенін айта алмаймын!
Dialogue: 0,0:08:03.81,0:08:05.69,Default,,0,0,0,,Мына жаққа қара.
Dialogue: 0,0:08:06.73,0:08:09.90,Default,,0,0,0,,Анашым, зәр!
Dialogue: 0,0:08:09.98,0:08:11.82,Default,,0,0,0,,Егер сіз көзіңізге қарасаңыз?
Dialogue: 0,0:08:14.36,0:08:15.36,Default,,0,0,0,,Көзге қараңыз
Dialogue: 0,0:08:16.41,0:08:18.37,Default,,0,0,0,,Көзге қараңыз
Dialogue: 0,0:08:19.33,0:08:20.37,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:21.62,0:08:23.37,Default,,0,0,0,,Тұтынушының көзқарасы!
Dialogue: 0,0:08:28.79,0:08:30.80,Default,,0,0,0,,- (Акино) Қош келдіңіз -?
Dialogue: 0,0:08:30.88,0:08:33.76,Default,,0,0,0,,Мен сізге көмектесу үшін бірдеңе істей аламын ба?
Dialogue: 0,0:08:33.84,0:08:35.34,Default,,0,0,0,,Феррет тұтынушылары
Dialogue: 0,0:08:35.43,0:08:38.22,Default,,0,0,0,,Сіз... консьержсіз...
Dialogue: 0,0:08:38.30,0:08:39.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:39.51,0:08:42.23,Default,,0,0,0,,Консьерж...?
Dialogue: 0,0:08:43.43,0:08:44.23,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:45.23,0:08:48.15,Default,,0,0,0,,Маған даналығыңызды беріңізші!
Dialogue: 0,0:08:50.32,0:08:53.82,Default,,0,0,0,,Мына жерде кәрі жұп сұр үкі бар, солай ма?
Dialogue: 0,0:08:53.90,0:08:54.61,Default,,0,0,0,,Иә
Dialogue: 0,0:08:55.45,0:08:58.78,Default,,0,0,0,,Қария менің іскер серіктесімнің президенті.
Dialogue: 0,0:08:58.87,0:09:01.62,Default,,0,0,0,,Мен сені бүгін осында көңіл көтеру үшін әкелдім.
Dialogue: 0,0:09:02.12,0:09:03.87,Default,,0,0,0,,Kyohohohoho…
Dialogue: 0,0:09:03.96,0:09:07.42,Default,,0,0,0,,Сізге ұнағанын көргеніме қуаныштымын.
Dialogue: 0,0:09:07.50,0:09:09.54,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:09:09.63,0:09:11.63,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:09:11.71,0:09:14.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:15.30,0:09:16.38,Default,,0,0,0,,Президент!
Dialogue: 0,0:09:16.47,0:09:17.68,Default,,0,0,0,,Сіздің заттарыңыз
Dialogue: 0,0:09:17.76,0:09:20.85,Default,,0,0,0,,Бұл бізден келген сыйлық.
Dialogue: 0,0:09:20.93,0:09:23.47,Default,,0,0,0,,Жоқ, жоқ, ол оған жақындамайды.
Dialogue: 0,0:09:23.56,0:09:25.35,Default,,0,0,0,,Мұны ораңыз.
Dialogue: 0,0:09:25.43,0:09:27.60,Default,,0,0,0,,- (Сатушы) Рахмет - Ах...
Dialogue: 0,0:09:28.19,0:09:29.11,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:09:29.19,0:09:30.61,Default,,0,0,0,,Ал, сізге рахмет
Dialogue: 0,0:09:30.69,0:09:32.53,Default,,0,0,0,,Менде жақсы сатып алу тәжірибесі болды.
Dialogue: 0,0:09:32.61,0:09:33.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:33.78,0:09:36.20,Default,,0,0,0,,Kyohohohohoho!
Dialogue: 0,0:09:37.32,0:09:38.36,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:39.03,0:09:42.03,Default,,0,0,0,,Өйткені президентті өзі сатып алады
Dialogue: 0,0:09:42.12,0:09:44.33,Default,,0,0,0,,Егер ойын-сауық орнатылмаса...
Dialogue: 0,0:09:45.41,0:09:49.08,Default,,0,0,0,,Байлардың көңілін көтеру шынымен қиын.
Dialogue: 0,0:09:49.17,0:09:52.13,Default,,0,0,0,,Консьерж мырза, сізде жақсы даналық бар ма...
Dialogue: 0,0:09:52.63,0:09:53.80,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:54.67,0:09:57.59,Default,,0,0,0,,Тұтынушының толық қанағаттанғанына қарамастан
Dialogue: 0,0:09:57.68,0:09:59.26,Default,,0,0,0,,Тағы қалай...
Dialogue: 0,0:10:00.60,0:10:03.81,Default,,0,0,0,,Көзіңізге қарап соншалықты көп нәрсені айта аласыз!
Dialogue: 0,0:10:04.81,0:10:06.27,Default,,0,0,0,,Тұтынушының көзқарасы!
Dialogue: 0,0:10:06.85,0:10:08.64,Default,,0,0,0,,Тек бақылау!
Dialogue: 0,0:10:08.73,0:10:12.02,Default,,0,0,0,,Жақсы! Бұл әмиян да жақсы
Dialogue: 0,0:10:12.11,0:10:13.86,Default,,0,0,0,,Екеуін де сатып алыңыз.
Dialogue: 0,0:10:13.94,0:10:17.03,Default,,0,0,0,,Е, жоқ, жоқ, бұл екеуі.
Dialogue: 0,0:10:17.11,0:10:18.61,Default,,0,0,0,,Президент! Бізге...
Dialogue: 0,0:10:18.70,0:10:22.62,Default,,0,0,0,,Феррет тұтынушысы компания президентін қуантқысы келеді.
Dialogue: 0,0:10:23.20,0:10:26.12,Default,,0,0,0,,Білесің бе, мен бүгін әйелімді бақытты еткім келеді.
Dialogue: 0,0:10:27.25,0:10:30.08,Default,,0,0,0,,Президент әйелін қуантқысы келеді
Dialogue: 0,0:10:31.00,0:10:33.29,Default,,0,0,0,,Ал сіздің әйеліңіз...
Dialogue: 0,0:10:34.75,0:10:37.26,Default,,0,0,0,,Мен абдырап қалдым. Екеуі де керемет.
Dialogue: 0,0:10:38.47,0:10:40.76,Default,,0,0,0,,Екеуі де керемет...
Dialogue: 0,0:10:41.64,0:10:43.51,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:44.18,0:10:46.52,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:46.60,0:10:47.73,Default,,0,0,0,,Бір минут күтіңіз...
Dialogue: 0,0:10:47.81,0:10:49.02,Default,,0,0,0,,Жабу, жабу, жабу!
Dialogue: 0,0:10:49.10,0:10:51.85,Default,,0,0,0,,Чочочочо... Жабу, жабу, жабу!
Dialogue: 0,0:10:51.94,0:10:53.56,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:10:53.65,0:10:54.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:55.15,0:10:57.49,Default,,0,0,0,,Ши... Кешірім сұраймын!
Dialogue: 0,0:10:58.07,0:11:00.24,Default,,0,0,0,,Ол көңілді кішкентай қыз.
Dialogue: 0,0:11:00.74,0:11:02.78,Default,,0,0,0,,Мен мұны шештім! кеттік
Dialogue: 0,0:11:03.62,0:11:04.87,Default,,0,0,0,,Сәлем, хатшы!
Dialogue: 0,0:11:04.95,0:11:07.91,Default,,0,0,0,,Мен мұны аламын. Kyohohoho!
Dialogue: 0,0:11:12.63,0:11:13.21,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:14.04,0:11:15.29,Default,,0,0,0,,Акино-кун!
Dialogue: 0,0:11:15.38,0:11:17.21,Default,,0,0,0,,Ал... Тодо мырза
Dialogue: 0,0:11:17.30,0:11:19.34,Default,,0,0,0,,Сен не істеп жатырсың?
Dialogue: 0,0:11:19.92,0:11:21.97,Default,,0,0,0,,Сіз «V(V).I.A(A)» тұтынушысысыз!
Dialogue: 0,0:11:22.05,0:11:24.30,Default,,0,0,0,,Әдепті болыңыз.
Dialogue: 0,0:11:24.39,0:11:25.26,Default,,0,0,0,,Ｖ.Ｉ.Ａ？
Dialogue: 0,0:11:25.35,0:11:30.56,Default,,0,0,0,,Өте маңызды жануар! Жойылып бара жатқан түрдің тұтынушысы!
Dialogue: 0,0:11:32.77,0:11:36.27,Default,,0,0,0,,Нуууу... Тұтынушыларға қызмет көрсету қандай қауіпті!
Dialogue: 0,0:11:36.36,0:11:38.44,Default,,0,0,0,,Ал, Тодо-сан.
Dialogue: 0,0:11:39.44,0:11:43.61,Default,,0,0,0,,Мен де алғашқы соққыдан біраз шошып кеттім.
Dialogue: 0,0:11:43.70,0:11:47.28,Default,,0,0,0,,Мен Элле-санның арқасын басып қана қойған жоқпын,
Dialogue: 0,0:11:47.37,0:11:49.58,Default,,0,0,0,,Пингвин сияқты қарады!
Dialogue: 0,0:11:49.66,0:11:51.79,Default,,0,0,0,,Аникараня В.И.А...
Dialogue: 0,0:11:58.46,0:12:00.17,Default,,0,0,0,,Тодо мырза
Dialogue: 0,0:12:00.26,0:12:04.43,Default,,0,0,0,,Жаңадан келген Акино-сан, маған қатты ұнады.
Dialogue: 0,0:12:05.97,0:12:09.47,Default,,0,0,0,,Қараңызшы, тұтынушы үмітін тапқан сияқты.
Dialogue: 0,0:12:11.14,0:12:12.48,Default,,0,0,0,,Хехе...
Dialogue: 0,0:12:13.35,0:12:14.48,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:12:15.98,0:12:17.11,Default,,0,0,0,,Акино-чан
Dialogue: 0,0:12:17.61,0:12:21.19,Default,,0,0,0,,Күндіз келген тұтынушы сізді қайта көргісі келеді.
Dialogue: 0,0:12:21.99,0:12:24.70,Default,,0,0,0,,Ал, күзенді тұтынушылар!
Dialogue: 0,0:12:24.78,0:12:28.33,Default,,0,0,0,,Мен жаңа ғана әуежайда бір жұпты түсіріп алдым.
Dialogue: 0,0:12:28.41,0:12:29.62,Default,,0,0,0,,және оны осы кезеңде бізге қалдыру қисынсыз болар еді, иә?
Dialogue: 0,0:12:29.70,0:12:32.08,Default,,0,0,0,,Консьерждің кеңесі бойынша...
Dialogue: 0,0:12:33.08,0:12:36.88,Default,,0,0,0,,Ол кезде әйелі екіленіп, сатып алмаған затын таңдады.
Dialogue: 0,0:12:36.96,0:12:39.71,Default,,0,0,0,,Мен оларды көптеп сыйға бердім.
Dialogue: 0,0:12:41.38,0:12:42.88,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:12:43.38,0:12:46.34,Default,,0,0,0,,Kyohohohoho!
Dialogue: 0,0:12:46.43,0:12:49.14,Default,,0,0,0,,Бұл үлкен қуаныш сияқты.
Dialogue: 0,0:12:49.22,0:12:52.22,Default,,0,0,0,,Әйелін осылай көріп, президент те жеңілдеп қалды.
Dialogue: 0,0:12:53.23,0:12:56.60,Default,,0,0,0,,Біз сіздің келесі тапсырмаңызды қабылдауға қуаныштымыз!
Dialogue: 0,0:12:56.69,0:12:58.56,Default,,0,0,0,,Бұл керемет болды!
Dialogue: 0,0:12:58.65,0:13:00.36,Default,,0,0,0,,Консьержге рахмет.
Dialogue: 0,0:13:00.44,0:13:02.40,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:02.49,0:13:05.78,Default,,0,0,0,,Сатып алғаннан кейін де әйел тұтынушылар жиі
Dialogue: 0,0:13:05.86,0:13:08.62,Default,,0,0,0,,Сіз ойланбастан сатып алмаған зат үшін
Dialogue: 0,0:13:08.70,0:13:11.24,Default,,0,0,0,,Себебі сізді ұстап отыр.
Dialogue: 0,0:13:11.95,0:13:13.25,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:13:14.41,0:13:18.46,Default,,0,0,0,,Мен енді Арктика әмбебап дүкенін пайдалануды жалғастырамын.
Dialogue: 0,0:13:18.54,0:13:21.13,Default,,0,0,0,,Иә! рақмет сізге!
Dialogue: 0,0:13:22.96,0:13:25.47,Default,,0,0,0,,Рахмет, консьерж.
Dialogue: 0,0:13:26.55,0:13:29.68,Default,,0,0,0,,Біз сізді тағы да күтеміз.
Dialogue: 0,0:13:33.22,0:13:36.14,Default,,0,0,0,,Бірінші күн жақсы бастама емес.
Dialogue: 0,0:13:36.23,0:13:39.06,Default,,0,0,0,,Менде көптеген жағымсыз оқиғалар болды...
Dialogue: 0,0:13:39.15,0:13:42.78,Default,,0,0,0,,Тұтынушы Сізді бақытты көру өте қуанышты.
Dialogue: 0,0:13:42.86,0:13:43.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:43.78,0:13:44.36,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:44.44,0:13:46.28,Default,,0,0,0,,Алаңдамаңыз!
Dialogue: 0,0:13:46.36,0:13:48.53,Default,,0,0,0,,Сіз өте қауіптісіз!
Dialogue: 0,0:13:49.66,0:13:51.58,Default,,0,0,0,,- (Мори) Уухо - (Ивасэ) Сау болу керек.
Dialogue: 0,0:13:51.66,0:13:53.54,Default,,0,0,0,,Өйткені оны Тодо мырза көреді.
Dialogue: 0,0:13:54.41,0:13:55.87,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:13:57.04,0:13:58.42,Default,,0,0,0,,Консьерж мырза
Dialogue: 0,0:14:03.00,0:14:04.88,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:06.84,0:14:09.55,Default,,0,0,0,,«Рахмет, консьерж...»
Dialogue: 0,0:14:09.64,0:14:10.80,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:14:15.93,0:14:17.73,Default,,0,0,0,,Мына азуды қарашы.
Dialogue: 0,0:14:20.77,0:14:24.19,Default,,0,0,0,,Ата-бабаларымыз ерлікпен қанатын кеңге жайған.
Dialogue: 0,0:14:24.28,0:14:27.11,Default,,0,0,0,,Мен он мыңдаған жылдар бойы сол желдеткішке іліндім.
Dialogue: 0,0:14:27.19,0:14:31.57,Default,,0,0,0,,Осындай ерекшеленетін қауырсындарымен, Мен нысанаға алатыныма сенімдімін.
Dialogue: 0,0:14:31.66,0:14:34.24,Default,,0,0,0,,Әдемі қауырсындарымды жасырайын ба?
Dialogue: 0,0:14:36.75,0:14:39.00,Default,,0,0,0,,Одан гөрі сені жасырғаным артық.
Dialogue: 0,0:14:39.08,0:14:40.54,Default,,0,0,0,,Хааа~
Dialogue: 0,0:14:47.76,0:14:49.38,Default,,0,0,0,,Тұтынушы!
Dialogue: 0,0:14:49.88,0:14:54.35,Default,,0,0,0,,Жарайды... дүкен ішіндегі қыз алысу мінез-құлқы өте тітіркендіреді.
Dialogue: 0,0:14:54.43,0:14:55.85,Default,,0,0,0,,Тоқтаңыз.
Dialogue: 0,0:14:55.93,0:14:56.97,Default,,0,0,0,,Тітіркендіргіш пе?
Dialogue: 0,0:14:57.81,0:15:00.48,Default,,0,0,0,,Не? Ах... мм...
Dialogue: 0,0:15:00.56,0:15:02.27,Default,,0,0,0,,Құрметті тұтынушы!
Dialogue: 0,0:15:02.35,0:15:04.32,Default,,0,0,0,,Сен өте әдемісің.
Dialogue: 0,0:15:04.40,0:15:07.19,Default,,0,0,0,,Кейбір адамдар түнде өмір сүреді, көздері нашар көреді.
Dialogue: 0,0:15:07.28,0:15:10.49,Default,,0,0,0,,Тым ашық құйрық қауырсындарын алып тастаңыз.
Dialogue: 0,0:15:10.57,0:15:11.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:12.41,0:15:13.20,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:15.03,0:15:17.87,Default,,0,0,0,,-(Павлин қыз) Бұл біртүрлі әмбебап дүкен. -Мүлдем...
Dialogue: 0,0:15:18.54,0:15:20.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:21.37,0:15:23.63,Default,,0,0,0,,Сөйлегенде абай бол!
Dialogue: 0,0:15:23.71,0:15:28.05,Default,,0,0,0,,Өзін қорланған тұтынушылар дүкеніңізге енді келмейді.
Dialogue: 0,0:15:28.13,0:15:29.42,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:15:29.51,0:15:31.43,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:15:31.51,0:15:33.55,Default,,0,0,0,,Әкемді көрмегелі бірнеше жыл болды.
Dialogue: 0,0:15:33.64,0:15:36.35,Default,,0,0,0,,Мен бұл сыйлық болар деп ойладым.
Dialogue: 0,0:15:36.43,0:15:37.97,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:15:38.06,0:15:39.35,Default,,0,0,0,,Әкең туралы
Dialogue: 0,0:15:40.14,0:15:43.02,Default,,0,0,0,,Толығырақ айтып бере аласыз ба?
Dialogue: 0,0:15:44.15,0:15:45.48,Default,,0,0,0,,Жетті…
Dialogue: 0,0:15:46.07,0:15:48.65,Default,,0,0,0,,Ол да көне нәрселерді ұнатады.
Dialogue: 0,0:15:48.73,0:15:50.44,Default,,0,0,0,,Субұрқақ сияқты нәрсе туралы не айтасыз?
Dialogue: 0,0:15:51.07,0:15:54.99,Default,,0,0,0,,Мұны ұмытып қалуыңыз мүмкін нәрселерді жазу үшін пайдаланыңыз.
Dialogue: 0,0:15:55.07,0:15:57.91,Default,,0,0,0,,Хехе, жақсы.
Dialogue: 0,0:15:58.41,0:15:59.24,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:59.33,0:16:00.83,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:16:00.91,0:16:05.13,Default,,0,0,0,,20 жас шамасындағы әйел... Ол әдемі ұзын шашымен мақтанады.
Dialogue: 0,0:16:05.63,0:16:07.34,Default,,0,0,0,,Мм... Ах!
Dialogue: 0,0:16:07.42,0:16:09.30,Default,,0,0,0,,Қылқалам сияқты нәрсе туралы не айтасыз?
Dialogue: 0,0:16:09.38,0:16:11.72,Default,,0,0,0,,Хохо щеткасы
Dialogue: 0,0:16:11.80,0:16:14.39,Default,,0,0,0,,Жылтыр шаш беретін нәрселер бар.
Dialogue: 0,0:16:14.47,0:16:16.76,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:16:16.85,0:16:18.76,Default,,0,0,0,,Жаднама…
Dialogue: 0,0:16:18.85,0:16:21.31,Default,,0,0,0,,Сіз жақсы фонтанды қалам қолданасыз.
Dialogue: 0,0:16:21.39,0:16:24.35,Default,,0,0,0,,Мен әрқашан ұмытшақ болдым.
Dialogue: 0,0:16:24.44,0:16:28.86,Default,,0,0,0,,Соңғы кездері осы дәптерге жазып алуға тырысып жүрмін.
Dialogue: 0,0:16:28.94,0:16:29.98,Default,,0,0,0,,О...
Dialogue: 0,0:16:30.07,0:16:34.07,Default,,0,0,0,,Әй, сағатым шашқа көміліп қалды...
Dialogue: 0,0:16:34.15,0:16:35.66,Default,,0,0,0,,Қазір сағат 17.00.
Dialogue: 0,0:16:35.74,0:16:37.37,Default,,0,0,0,,О, кешіріңіз.
Dialogue: 0,0:16:38.12,0:16:40.54,Default,,0,0,0,,Қызыммен танысқаныма көп болды.
Dialogue: 0,0:16:40.62,0:16:43.66,Default,,0,0,0,,Жақын жерде орналасқан мейрамханаға тапсырыс беріңіз.
Dialogue: 0,0:16:43.75,0:16:46.08,Default,,0,0,0,,Актриса болып жұмыс істейтін бала
Dialogue: 0,0:16:46.17,0:16:48.96,Default,,0,0,0,,Жақсы! Сіз актрисасыз ба?
Dialogue: 0,0:16:49.04,0:16:50.92,Default,,0,0,0,,Хохо... Көргің келе ме?
Dialogue: 0,0:16:51.00,0:16:52.09,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:16:52.17,0:16:54.80,Default,,0,0,0,,Бұл біраз бұрынғы фотосурет.
Dialogue: 0,0:16:54.88,0:16:56.14,Default,,0,0,0,,Саңылау
Dialogue: 0,0:16:56.22,0:16:59.14,Default,,0,0,0,,Жақсы! Сондай әдемі...
Dialogue: 0,0:16:59.22,0:17:00.43,Default,,0,0,0,,Хехе...
Dialogue: 0,0:17:00.51,0:17:01.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:01.35,0:17:03.93,Default,,0,0,0,,Эй... бір сәт кешіріңіз.
Dialogue: 0,0:17:05.44,0:17:06.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:07.77,0:17:08.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:09.98,0:17:12.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:12.65,0:17:14.99,Default,,0,0,0,,Біз мұны сізге береміз
Dialogue: 0,0:17:15.65,0:17:16.49,Default,,0,0,0,,Иә
Dialogue: 0,0:17:16.57,0:17:17.91,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:17:17.99,0:17:21.29,Default,,0,0,0,,Таспаның үш түсі бар.
Dialogue: 0,0:17:21.37,0:17:23.25,Default,,0,0,0,,- (Теңіз күзен қызы) Дұрыс... - (Акино) Тұтынушы!
Dialogue: 0,0:17:26.17,0:17:28.92,Default,,0,0,0,,Тұтынушы фонтаннан жақсы деп қорқамын.
Dialogue: 0,0:17:29.88,0:17:32.38,Default,,0,0,0,,Қалта сағаты ше?
Dialogue: 0,0:17:32.46,0:17:33.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:34.47,0:17:38.05,Default,,0,0,0,,Әкең ескілікті ұнататынын айтты.
Dialogue: 0,0:17:38.14,0:17:41.60,Default,,0,0,0,,Әрине, фонтанды қаламдар да ұсынылады.
Dialogue: 0,0:17:41.68,0:17:43.06,Default,,0,0,0,,Мына қалта сағаты!
Dialogue: 0,0:17:43.64,0:17:48.56,Default,,0,0,0,,Әрбір бұйым шебердің қолынан шыққан және біздің әмбебап дүкеннің мақтанышы.
Dialogue: 0,0:17:48.65,0:17:51.52,Default,,0,0,0,,Дизайнды жапон киімін кигендер де пайдалана алады.
Dialogue: 0,0:17:51.61,0:17:52.90,Default,,0,0,0,,Мен сенің әкеңе сенімдімін.
Dialogue: 0,0:17:52.98,0:17:56.20,Default,,0,0,0,,«Хохо~ қалта сағаты!» және т.б.!
Dialogue: 0,0:17:56.28,0:17:59.03,Default,,0,0,0,,Мүмкін сізге ұнайтын шығар?
Dialogue: 0,0:17:59.53,0:18:02.49,Default,,0,0,0,,Ко... Консьерж сонша айтса...
Dialogue: 0,0:18:02.58,0:18:04.95,Default,,0,0,0,,Ах... Рахмет!
Dialogue: 0,0:18:06.75,0:18:09.96,Default,,0,0,0,,Ху~ О, бұл жақсы.
Dialogue: 0,0:18:10.04,0:18:14.00,Default,,0,0,0,,Мм... шашыңыз қысқа болды ма?
Dialogue: 0,0:18:14.09,0:18:17.13,Default,,0,0,0,,Иә, менің келесі фильмдегі рөлім үшін.
Dialogue: 0,0:18:17.22,0:18:18.93,Default,,0,0,0,,Сіз мені танисыз ба?
Dialogue: 0,0:18:19.01,0:18:21.22,Default,,0,0,0,,Мм... актрисаныкі
Dialogue: 0,0:18:21.30,0:18:24.93,Default,,0,0,0,,Дұрыс, ол туралы ақпарат әлі шығарылмаған фильм.
Dialogue: 0,0:18:25.02,0:18:25.93,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:26.98,0:18:28.27,Default,,0,0,0,,Оны құпия сақтаңыз.
Dialogue: 0,0:18:28.77,0:18:29.77,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:29.85,0:18:33.07,Default,,0,0,0,,Ха... Мен өте кешірім сұраймын!
Dialogue: 0,0:18:33.15,0:18:36.82,Default,,0,0,0,,Жаңа ғана естігеніңізді жария етпеңіз!
Dialogue: 0,0:18:37.90,0:18:39.82,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:45.08,0:18:47.87,Default,,0,0,0,,Біз мұны сізге береміз
Dialogue: 0,0:18:48.79,0:18:49.41,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:49.50,0:18:52.54,Default,,0,0,0,,Таспаның үш түсі бар.
Dialogue: 0,0:18:52.63,0:18:54.84,Default,,0,0,0,,- (Теңіз күзенінің әкесі) Хооооо - (Акино) Тапсырыс беруші!
Dialogue: 0,0:18:55.96,0:18:59.59,Default,,0,0,0,,Қылқаламның орнына ұрланғанды ​​ше?
Dialogue: 0,0:18:59.68,0:19:03.05,Default,,0,0,0,,Жазда да кондиционер сізді салқындатады және күннен көлеңке береді.
Dialogue: 0,0:19:03.14,0:19:06.60,Default,,0,0,0,,Оны орау тәсіліне қарай сән ауқымы кеңейеді.
Dialogue: 0,0:19:06.68,0:19:10.02,Default,,0,0,0,,Мынадай... былай... былай!
Dialogue: 0,0:19:10.64,0:19:12.15,Default,,0,0,0,,Мен тұтынушыға сенімдімін...
Dialogue: 0,0:19:12.23,0:19:13.52,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:19:19.44,0:19:22.45,Default,,0,0,0,,Хаа~ Жақсы~
Dialogue: 0,0:19:22.53,0:19:25.24,Default,,0,0,0,,- (Тодо) Акино-кун - (Акино) Ха! Тодо мырза?
Dialogue: 0,0:19:25.33,0:19:25.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:26.58,0:19:29.83,Default,,0,0,0,,Ағымдағы тұтынушыларға қызмет көрсету Мәселе неде екенін білесіз бе?
Dialogue: 0,0:19:29.91,0:19:31.62,Default,,0,0,0,,Мәселе?
Dialogue: 0,0:19:31.71,0:19:33.67,Default,,0,0,0,,Клиенттер арасындағы сыйлықтар
Dialogue: 0,0:19:33.75,0:19:36.63,Default,,0,0,0,,Ешқайсымыз қаламаған нәрсеге айналу қаупі бар еді...
Dialogue: 0,0:19:36.71,0:19:39.05,Default,,0,0,0,,Бұл емес. Бұл естелік!
Dialogue: 0,0:19:39.13,0:19:40.22,Default,,0,0,0,,Жаднама?
Dialogue: 0,0:19:40.30,0:19:43.01,Default,,0,0,0,,А... Бұл ма?
Dialogue: 0,0:19:43.89,0:19:46.51,Default,,0,0,0,,Теңіз күзенінің жүні қымбат бағамен сатылады.
Dialogue: 0,0:19:46.60,0:19:50.23,Default,,0,0,0,,Мүмкін біреу шашын ақшаға сатқысы келетін шығар.
Dialogue: 0,0:19:50.31,0:19:51.44,Default,,0,0,0,,Бұл жай ғана ақ қағаз парағы ғой, досым.
Dialogue: 0,0:19:52.94,0:19:56.90,Default,,0,0,0,,Клиенттерден олардың жеке жағдайларын бекер сұрамаңыз!
Dialogue: 0,0:19:56.98,0:19:59.07,Default,,0,0,0,,Иә, кешіріңіз!
Dialogue: 0,0:19:59.15,0:20:01.53,Default,,0,0,0,,Қалғандары негізінен жақсы болды.
Dialogue: 0,0:20:01.61,0:20:02.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:05.16,0:20:06.58,Default,,0,0,0,,Сізді мақтады ма?
Dialogue: 0,0:20:07.08,0:20:08.33,Default,,0,0,0,,- (Тодо) Бао! -(Акино) Гяа!
Dialogue: 0,0:20:08.91,0:20:12.58,Default,,0,0,0,,Ал... Тодо-сан, өтінемін, таңданба.
Dialogue: 0,0:20:13.12,0:20:13.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:21.30,0:20:21.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:26.47,0:20:27.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:28.97,0:20:29.77,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:20:34.77,0:20:36.73,Default,,0,0,0,,Ой... кешіріңіз!
Dialogue: 0,0:20:37.81,0:20:39.73,Default,,0,0,0,,Егер біз қазір кездессек...
Dialogue: 0,0:20:40.44,0:20:42.40,Default,,0,0,0,,Ерекше тосынсый!
Dialogue: 0,0:20:45.20,0:20:48.08,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:20:50.16,0:20:51.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:53.33,0:20:55.75,Default,,0,0,0,,Жоқ, біз уақытында үлгермейміз!
Dialogue: 0,0:20:56.50,0:20:57.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:58.46,0:21:01.21,Default,,0,0,0,,Әдемі қауырсындарымды жасырайын ба?
Dialogue: 0,0:21:01.30,0:21:02.71,Default,,0,0,0,,Мен сені жасырғым келеді
Dialogue: 0,0:21:02.80,0:21:04.63,Default,,0,0,0,,- (Акино) Павлин тұтынушысы! -иә?
Dialogue: 0,0:21:04.72,0:21:07.05,Default,,0,0,0,,Дүкенде танысу тәртібі
Dialogue: 0,0:21:07.14,0:21:09.93,Default,,0,0,0,,Қолайсыздықтар үшін кешірім сұраймыз!
Dialogue: 0,0:21:10.89,0:21:13.98,Default,,0,0,0,,Тітіркендіргіш... себебі?
Dialogue: 0,0:21:20.94,0:21:23.78,Default,,0,0,0,,- (Акино) Тұтынушы! - Консьерж
Dialogue: 0,0:21:23.86,0:21:26.61,Default,,0,0,0,,Махаббаттың уақытқа немесе орынға қатысы жоқ.
Dialogue: 0,0:21:26.70,0:21:27.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:27.95,0:21:30.83,Default,,0,0,0,,Бұл тамаша уақыт!
Dialogue: 0,0:21:30.91,0:21:34.45,Default,,0,0,0,,Бірақ олар түнде тіршілік етеді, кейбір адамдардың көру қабілеті нашар.
Dialogue: 0,0:21:34.54,0:21:38.08,Default,,0,0,0,,Тым ашық құйрық қауырсындарынан бас тартыңыз.
Dialogue: 0,0:21:38.67,0:21:40.92,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:21:43.76,0:21:45.30,Default,,0,0,0,,Yabona әмбебап дүкені.
Dialogue: 0,0:21:45.38,0:21:47.05,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:21:47.13,0:21:47.93,Default,,0,0,0,,Қорқыныш...
Dialogue: 0,0:21:48.01,0:21:51.89,Default,,0,0,0,,Хахахаха... Мен кіріп жатырмын.
Dialogue: 0,0:21:51.97,0:21:53.81,Default,,0,0,0,,Консьерж мырза
Dialogue: 0,0:21:55.02,0:21:57.23,Default,,0,0,0,,Мен бұл сыйлықты шештім.
Dialogue: 0,0:21:57.31,0:21:59.65,Default,,0,0,0,,Жақсы! Бұл өте керемет!
Dialogue: 0,0:22:00.98,0:22:03.61,Default,,0,0,0,,Әке, сізге ұнай ма?
Dialogue: 0,0:22:04.19,0:22:05.99,Default,,0,0,0,,Иә, сөзсіз!
Dialogue: 0,0:22:13.95,0:22:14.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:14.70,0:22:16.08,Default,,0,0,0,,О...
Dialogue: 0,0:22:16.66,0:22:17.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:22.75,0:22:23.92,Default,,0,0,0,,Хох
Dialogue: 0,0:22:24.00,0:22:27.55,Default,,0,0,0,,сәйкес тұтынушыны көз байлау ретінде пайдалану нені білдіреді?
Dialogue: 0,0:22:27.63,0:22:30.01,Default,,0,0,0,,Қабат менеджері Тодо-саннан сұраңыз
Dialogue: 0,0:22:30.72,0:22:35.22,Default,,0,0,0,,Кім аман қалады деп ойлайсың, күшті ме, әлде ақылды ма?
Dialogue: 0,0:22:35.81,0:22:37.73,Default,,0,0,0,,Кім аман қалады...
Dialogue: 0,0:22:38.27,0:22:43.57,Default,,0,0,0,,Олар қоршаған ортаға бейімделу арқылы өзін өзгертетін адамдар болса керек.
Dialogue: 0,0:22:43.65,0:22:44.86,Default,,0,0,0,,Танымал жауаптар
Dialogue: 0,0:22:44.94,0:22:45.98,Default,,0,0,0,,Хмф!
Dialogue: 0,0:22:46.57,0:22:48.90,Default,,0,0,0,,- Бірақ ~ - (Тодо) Бірақ?
Dialogue: 0,0:22:48.99,0:22:50.66,Default,,0,0,0,,Ең мықтының аман қалуында
Dialogue: 0,0:22:51.74,0:22:54.33,Default,,0,0,0,,Өмір сүруге тиімсіз эволюцияны түсіндіре алмайды
Dialogue: 0,0:22:55.24,0:23:00.75,Default,,0,0,0,,Мысалы, шетелдік жыртқыштар жиі нысанаға алатын тауыс құстарының әдемі қауырсындары.
Dialogue: 0,0:23:02.00,0:23:03.79,Default,,0,0,0,,Эволюция терең.
Dialogue: 0,0:23:03.88,0:23:06.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:23:06.09,0:23:08.01,Default,,0,0,0,,Сіз қалай ойлайсыз? Акино мырза
Dialogue: 0,0:23:08.09,0:23:11.76,Default,,0,0,0,,Жұмыс орнына тезірек бейімделу
Dialogue: 0,0:23:11.84,0:23:14.64,Default,,0,0,0,,Мен сенің аман қалғаныңды қалаймын.
Dialogue: 0,0:23:14.72,0:23:17.43,Default,,0,0,0,,Бейімделу… немесе…
Dialogue: 0,0:23:18.73,0:23:20.14,Default,,0,0,0,,Немесе?
Dialogue: 0,0:23:20.23,0:23:21.73,Default,,0,0,0,,Хехе...
Dialogue: 0,0:23:26.40,0:23:30.53,Default,,0,0,0,,(мейрамханадағы BGM)
Dialogue: 0,0:23:40.71,0:23:42.54,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:23:42.62,0:23:46.63,Default,,0,0,0,,Шафран мен теңіз балдыры майы қосылған рисоттоға жасалған Кошихикари күріші
Dialogue: 0,0:23:46.71,0:23:49.38,Default,,0,0,0,,Гүлді көкөніс кускусы мен пиментос себіңіз...
Dialogue: 0,0:23:52.59,0:23:54.14,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:23:54.22,0:23:55.30,Default,,0,0,0,,Пиментос және ноқат...
Dialogue: 0,0:23:55.39,0:23:56.26,Default,,0,0,0,,Zu!
Dialogue: 0,0:23:56.35,0:23:57.97,Default,,0,0,0,,Z…
Dialogue: 0,0:23:58.06,0:24:01.06,Default,,0,0,0,,«Пименто және ноқат шырыны бар»
Dialogue: 0,0:24:01.14,0:24:02.23,Default,,0,0,0,,...
Dialogue: 0,0:24:03.56,0:24:06.27,Default,,0,0,0,,Кешіріңіз, даяшы.
Dialogue: 0,0:24:06.36,0:24:09.28,Default,,0,0,0,,Мәзір шайнамай-ақ әдемі шығады.
Dialogue: 0,0:24:09.36,0:24:10.24,Default,,0,0,0,,Иә...
Dialogue: 0,0:24:10.32,0:24:12.65,Default,,0,0,0,,Сіз қалай ойлайсыз? Менің негізгі асханам
Dialogue: 0,0:24:13.36,0:24:16.53,Default,,0,0,0,,Даяшылардың мұқият қызметін көру
Dialogue: 0,0:24:16.62,0:24:18.12,Default,,0,0,0,,Мойнымды түзеткім келеді.
Dialogue: 0,0:24:18.91,0:24:22.08,Default,,0,0,0,,Маған консьерж жұмысыма аз да болса көмектессеңіз
Dialogue: 0,0:24:22.75,0:24:25.13,Default,,0,0,0,,Мейрамханадағы тренинг осы үшін, солай ма?
Dialogue: 0,0:24:25.21,0:24:27.92,Default,,0,0,0,,Аа, мен бір нәрсені ойладым.
Dialogue: 0,0:24:28.00,0:24:31.30,Default,,0,0,0,,Әрбір үстелге қоңырау шалу қоңырауын орнатсаңыз
Dialogue: 0,0:24:31.38,0:24:34.34,Default,,0,0,0,,Клиенттерге де ыңғайлы емес пе?
Dialogue: 0,0:24:34.43,0:24:35.39,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:24:35.47,0:24:37.76,Default,,0,0,0,,Консьерж үстелі сияқты...
Dialogue: 0,0:24:37.85,0:24:38.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:44.90,0:24:47.73,Default,,0,0,0,,Тек негізгі тағамды жасау
Dialogue: 0,0:24:48.40,0:24:51.65,Default,,0,0,0,,Соя етін гриль жасайтын адам Тұздық дайындаған адам
Dialogue: 0,0:24:51.74,0:24:54.61,Default,,0,0,0,,Көкөністерді гарнир үшін қуыратын адам
Dialogue: 0,0:24:54.70,0:24:59.37,Default,,0,0,0,,Ал барлығын тексеретін адам сол жақтағы бас аспаз.
Dialogue: 0,0:24:59.45,0:25:00.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:00.20,0:25:04.04,Default,,0,0,0,,Сәлем! Бас даяшы жалығып кеткендей қаңғып жүр!
Dialogue: 0,0:25:05.00,0:25:10.05,Default,,0,0,0,,Соя еті, көкөністер, соустар, әрқайсысының әрлеу мерзімі
Dialogue: 0,0:25:12.67,0:25:15.18,Default,,0,0,0,,Тұтынушыларға қызмет көрсету уақыты
Dialogue: 0,0:25:15.80,0:25:20.51,Default,,0,0,0,,Бәріміз бірге жұмыс жасап, ең жақсы тағамнан дәм татайық.
Dialogue: 0,0:25:24.39,0:25:27.77,Default,,0,0,0,,Мейрамханада барлығы командалық ойынға байланысты.
Dialogue: 0,0:25:32.57,0:25:34.61,Default,,0,0,0,,Топтық ойын…
Dialogue: 0,0:25:34.69,0:25:35.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:40.66,0:25:42.49,Default,,0,0,0,,- (Акино) Өте жақсы істеп жатырсың - Уау!
Dialogue: 0,0:25:42.58,0:25:45.71,Default,,0,0,0,,Мен... Кешіріңіз, мұндай жерде.
Dialogue: 0,0:25:45.79,0:25:47.17,Default,,0,0,0,,Сіз мені мазалайды, солай емес пе?
Dialogue: 0,0:25:47.25,0:25:50.50,Default,,0,0,0,,Жоқ, жоқ, мені алаңдатуға болмайды.
Dialogue: 0,0:25:50.59,0:25:51.71,Default,,0,0,0,,Сіз суретшісіз бе?
Dialogue: 0,0:25:51.80,0:25:55.05,Default,,0,0,0,,Міне! Мен жай ғана кондитер аспазшысымын...
Dialogue: 0,0:25:55.13,0:25:57.59,Default,,0,0,0,,А... қарсы болмасаң.
Dialogue: 0,0:25:58.09,0:25:59.39,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:25:59.47,0:26:00.97,Default,,0,0,0,,Бұл сүйкімді!
Dialogue: 0,0:26:01.05,0:26:02.06,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:26:02.14,0:26:04.81,Default,,0,0,0,,-Иә - (Акино) Рахмет
Dialogue: 0,0:26:04.89,0:26:08.02,Default,,0,0,0,,Мен Вуллидің жанкүйерімін.
Dialogue: 0,0:26:08.10,0:26:10.52,Default,,0,0,0,,Сіз Кімді Мистер Вулли деп атайсыз?
Dialogue: 0,0:26:10.61,0:26:11.44,Default,,0,0,0,,Не!
Dialogue: 0,0:26:11.52,0:26:15.28,Default,,0,0,0,,Бұл данышпан мүсінші Вулли Мамонт.
Dialogue: 0,0:26:15.36,0:26:18.57,Default,,0,0,0,,Бұл мүсін Мистер Вуллидің жұмысы емес пе?
Dialogue: 0,0:26:18.66,0:26:22.74,Default,,0,0,0,,Мен... Мен бұл туралы білмедім, сондықтан қатты өкінемін.
Dialogue: 0,0:26:22.83,0:26:26.45,Default,,0,0,0,,Мына қисық сызықтың сұлулығына қараңдар
Dialogue: 0,0:26:26.54,0:26:29.42,Default,,0,0,0,,Бұл, әрине, жақсы мүсін...
Dialogue: 0,0:26:29.50,0:26:30.42,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:26:31.08,0:26:31.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:32.00,0:26:34.84,Default,,0,0,0,,Сондай-ақ… Кешіріңіз! Пингвин тұтынушылары
Dialogue: 0,0:26:34.92,0:26:37.51,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:26:38.17,0:26:41.97,Default,,0,0,0,,Клиенттер айтып жатқан сияқты, бірақ әлі алыс.
Dialogue: 0,0:26:42.05,0:26:42.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:43.76,0:26:45.68,Default,,0,0,0,,Сіз оны көре аласыз ба?
Dialogue: 0,0:26:45.77,0:26:48.60,Default,,0,0,0,,Дүниенің соңында екі жануар ғана қалды
Dialogue: 0,0:26:48.69,0:26:52.77,Default,,0,0,0,,Жалғыз махаббатты растайтын мұң мен сұлулық...
Dialogue: 0,0:26:53.27,0:26:55.07,Default,,0,0,0,,Penguin тұтынушылары
Dialogue: 0,0:26:55.15,0:26:57.65,Default,,0,0,0,,Поэзияға шеберсің, солай емес пе?
Dialogue: 0,0:26:58.15,0:27:00.53,Default,,0,0,0,,Сіз мені романтик деп атай аласыз ба?
Dialogue: 0,0:27:00.61,0:27:01.82,Default,,0,0,0,,Тыныш тақырып
Dialogue: 0,0:27:02.53,0:27:03.83,Default,,0,0,0,,Бөкселеріңізге қамқорлық жасаңыз
Dialogue: 0,0:27:03.91,0:27:06.33,Default,,0,0,0,,Не? Бұл тамақ ше?
Dialogue: 0,0:27:06.41,0:27:07.70,Default,,0,0,0,,Жүр, жұлқын!
Dialogue: 0,0:27:11.79,0:27:14.29,Default,,0,0,0,,Сіз мұнда не үшін келдіңіз...
Dialogue: 0,0:27:15.59,0:27:16.30,Default,,0,0,0,,Акино-чан
Dialogue: 0,0:27:16.96,0:27:19.76,Default,,0,0,0,,15-кестедегі жапон қасқырының тұтынушысы
Dialogue: 0,0:27:20.51,0:27:21.68,Default,,0,0,0,,Ол неге ұқсайды?
Dialogue: 0,0:27:23.18,0:27:27.35,Default,,0,0,0,,Мм... Сөзбен айтып жеткізу мүмкін емес қобалжу
Dialogue: 0,0:27:27.85,0:27:31.19,Default,,0,0,0,,Ах, «Пісіру баяу!» Мен күтуден шаршадым!
Dialogue: 0,0:27:31.27,0:27:32.23,Default,,0,0,0,,Неннон
Dialogue: 0,0:27:32.31,0:27:34.86,Default,,0,0,0,,Екі қолыңда не ұстап тұрсың?
Dialogue: 0,0:27:34.94,0:27:37.69,Default,,0,0,0,,- (Акино) Әй, сақина қап! -(Бас даяшы) Иә.
Dialogue: 0,0:27:37.78,0:27:41.28,Default,,0,0,0,,Басқаша айтқанда, сіздің сүйіктіңіз сізді бәсекелес күні тастап кетті.
Dialogue: 0,0:27:41.36,0:27:43.16,Default,,0,0,0,,қайғыру
Dialogue: 0,0:27:43.24,0:27:44.45,Default,,0,0,0,,… дұрыс
Dialogue: 0,0:27:44.53,0:27:46.20,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:27:46.28,0:27:47.33,Default,,0,0,0,,Сіз дәл қазір
Dialogue: 0,0:27:47.41,0:27:50.21,Default,,0,0,0,,Қоңырау соғуы ыңғайлы болады дедім.
Dialogue: 0,0:27:50.29,0:27:52.92,Default,,0,0,0,,Сонда даяшыға қоңырау соғылғанда ғана қызмет көрсетіледі.
Dialogue: 0,0:27:53.00,0:27:55.92,Default,,0,0,0,,Сіз тұтынушыларға көбірек көңіл бөле бастайсыз.
Dialogue: 0,0:27:58.51,0:28:01.01,Default,,0,0,0,,Бір стақан шараппен шамамен 30 минут
Dialogue: 0,0:28:01.09,0:28:04.59,Default,,0,0,0,,Ине мырзаға айқайлаңыз, Акино-чан
Dialogue: 0,0:28:04.68,0:28:05.30,Default,,0,0,0,,Не!
Dialogue: 0,0:28:05.89,0:28:09.47,Default,,0,0,0,,Қоқыс тастағанның мұңын сезініп, барынша мейірімді болыңыз.
Dialogue: 0,0:28:09.56,0:28:12.81,Default,,0,0,0,,Басқа тұтынушылардың назарына түспеуі үшін
Dialogue: 0,0:28:12.89,0:28:14.77,Default,,0,0,0,,Мен?
Dialogue: 0,0:28:15.61,0:28:19.19,Default,,0,0,0,,Өткізіп алған балықтар үлкенірек көрінеді.
Dialogue: 0,0:28:20.32,0:28:21.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:21.49,0:28:23.95,Default,,0,0,0,,Ертең жел соғады
Dialogue: 0,0:28:24.03,0:28:26.07,Default,,0,0,0,,Жаңбыр ешқашан тоқтамайды
Dialogue: 0,0:28:26.57,0:28:28.79,Default,,0,0,0,,Бітпейтін түн жоқ
Dialogue: 0,0:28:28.87,0:28:31.83,Default,,0,0,0,,Мм... не айтып тұрсың?
Dialogue: 0,0:28:33.87,0:28:36.25,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз!
Dialogue: 0,0:28:36.96,0:28:40.71,Default,,0,0,0,,Түсіндім... Мені қабылдамады, тастады.
Dialogue: 0,0:28:40.80,0:28:42.72,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:28:42.80,0:28:44.93,Default,,0,0,0,,Жоқ, түсінемін...
Dialogue: 0,0:28:45.72,0:28:49.22,Default,,0,0,0,,Бірақ сіз қателеспеуіңіз мүмкін.
Dialogue: 0,0:28:49.31,0:28:49.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:50.85,0:28:53.60,Default,,0,0,0,,Негізі келесі аптада мен оны осы дүкенде кездестіремін.
Dialogue: 0,0:28:53.69,0:28:56.15,Default,,0,0,0,,Саған неке жүзігін сыйласам ба деп ойладым.
Dialogue: 0,0:28:56.23,0:28:58.86,Default,,0,0,0,,Мен оны бүгін қарауға келдім...
Dialogue: 0,0:28:58.94,0:29:01.40,Default,,0,0,0,,Солай ма? Бұл тамаша!
Dialogue: 0,0:29:01.48,0:29:02.61,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:29:03.19,0:29:05.57,Default,,0,0,0,,Менің қолым үнемі қозғалуды тоқтатады.
Dialogue: 0,0:29:06.61,0:29:09.74,Default,,0,0,0,,Ол мен үшін тым жақсы биік тау гүлі
Dialogue: 0,0:29:10.24,0:29:13.87,Default,,0,0,0,,Айналада басқа жапон қасқырлары болмағандықтан, менің амалым жоқ...
Dialogue: 0,0:29:13.96,0:29:16.37,Default,,0,0,0,,Мен сені менімен кездесіп жүр деп ойладым.
Dialogue: 0,0:29:16.46,0:29:17.54,Default,,0,0,0,,Бұл...
Dialogue: 0,0:29:18.04,0:29:22.84,Default,,0,0,0,,Мен кеңістіктің күшін пайдаланып, осы мейрамханада ұсыныс жасай аламын деп ойладым.
Dialogue: 0,0:29:23.42,0:29:26.22,Default,,0,0,0,,Алаяқ болып есептелу...
Dialogue: 0,0:29:28.47,0:29:30.76,Default,,0,0,0,,Бұл жолы қайта жұмыс істемеуі мүмкін.
Dialogue: 0,0:29:32.60,0:29:33.73,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:29:35.94,0:29:37.23,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:29:37.31,0:29:38.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:38.52,0:29:41.82,Default,,0,0,0,,Сол күні сақинаны бере аламын деп үміттенемін.
Dialogue: 0,0:29:43.32,0:29:45.74,Default,,0,0,0,,Біз уәде береміз!
Dialogue: 0,0:29:46.45,0:29:47.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:48.70,0:29:49.57,Default,,0,0,0,,Хаа~
Dialogue: 0,0:29:49.66,0:29:51.45,Default,,0,0,0,,Иә?қалай?
Dialogue: 0,0:29:51.53,0:29:54.04,Default,,0,0,0,,Мейрамханадағы тренинг кезінде бірдеңе болды ма?
Dialogue: 0,0:29:54.12,0:29:55.54,Default,,0,0,0,,Абайсызда уәде берді...
Dialogue: 0,0:29:56.29,0:29:58.79,Default,,0,0,0,,Мен «міндетті түрде» деп айтпауым керек
Dialogue: 0,0:29:58.88,0:30:00.59,Default,,0,0,0,,Рұқсатсыз ауызша
Dialogue: 0,0:30:00.67,0:30:03.96,Default,,0,0,0,,Менен ұсыныс жасауға көмектесуімді сұрамаңыз...
Dialogue: 0,0:30:04.05,0:30:04.92,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:30:05.01,0:30:08.01,Default,,0,0,0,,Консьерж сөздігінде «ЖОҚ» сөзі жоқ!
Dialogue: 0,0:30:08.51,0:30:12.39,Default,,0,0,0,,Мен алмаймын, білмеймін, білмеймін, бұл тыйым сөз болуы керек!
Dialogue: 0,0:30:12.97,0:30:17.27,Default,,0,0,0,,Біз ешқашан тұтынушыларымыздың үмітін ақтамауымыз керек!
Dialogue: 0,0:30:19.10,0:30:19.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:20.94,0:30:22.23,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:30:22.32,0:30:24.61,Default,,0,0,0,,Маруки-сан, біраз уақыт өтті!
Dialogue: 0,0:30:24.69,0:30:27.07,Default,,0,0,0,,Зейнеткерлікке шыққаннан кейін не істедіңіз?
Dialogue: 0,0:30:27.15,0:30:30.57,Default,,0,0,0,,Соңғы кездері мен үйдегі үлкен көлемдегі қоқыстарды пайдаланамын.
Dialogue: 0,0:30:30.66,0:30:33.16,Default,,0,0,0,,Мори мырза, ол адам ше?
Dialogue: 0,0:30:33.79,0:30:35.79,Default,,0,0,0,,Ардагер консьерж Маруки-сан
Dialogue: 0,0:30:35.87,0:30:37.91,Default,,0,0,0,,Мен зейнеткермін.
Dialogue: 0,0:30:38.00,0:30:40.92,Default,,0,0,0,,Бізге жұмыс күші жетпей жатқанда қолдау көрсетуге келесің.
Dialogue: 0,0:30:41.00,0:30:42.88,Default,,0,0,0,,Жақсы кафелер бар ма?
Dialogue: 0,0:30:42.96,0:30:44.25,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:30:48.47,0:30:50.51,Default,,0,0,0,,Шамамен 3 үміткер бар.
Dialogue: 0,0:30:50.59,0:30:51.68,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:30:52.43,0:30:54.18,Default,,0,0,0,,Маруки мырза күткендей!
Dialogue: 0,0:30:54.26,0:30:55.89,Default,,0,0,0,,Сіз маған сене аласыз~
Dialogue: 0,0:30:55.97,0:30:58.27,Default,,0,0,0,,Иә? Үш дүкен де көшіп кетті ме?
Dialogue: 0,0:30:58.35,0:30:59.69,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:30:59.77,0:31:02.31,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:31:02.81,0:31:03.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:03.61,0:31:06.65,Default,,0,0,0,,-(Тұтынушылар) Бірақ мен сені жек көре алмаймын~ -(Тұтынушылар) Woohoohoo
Dialogue: 0,0:31:06.73,0:31:07.99,Default,,0,0,0,,Тұтынушы?
Dialogue: 0,0:31:09.90,0:31:11.82,Default,,0,0,0,,Мен осы иісті іздеп жүрмін
Dialogue: 0,0:31:13.83,0:31:17.29,Default,,0,0,0,,Хош иіс дерлік жоғалып кеткен сияқты.
Dialogue: 0,0:31:17.37,0:31:18.71,Default,,0,0,0,,Ол осы кітапқа жабысып қалды.
Dialogue: 0,0:31:19.50,0:31:21.67,Default,,0,0,0,,Екі ай бұрын мен оның иісін әлі сезетінмін.
Dialogue: 0,0:31:21.75,0:31:24.34,Default,,0,0,0,,Менің иіс сезу қабілетім айтпайды
Dialogue: 0,0:31:24.84,0:31:27.05,Default,,0,0,0,,Арыстанның тұтынушысы осылай айтса
Dialogue: 0,0:31:27.13,0:31:29.30,Default,,0,0,0,,Хош иіс әлдеқашан келген шығар.
Dialogue: 0,0:31:29.80,0:31:33.39,Default,,0,0,0,,Неліктен жадыңызға сүйене отырып, сол иісті іздеп көрмеске?
Dialogue: 0,0:31:33.89,0:31:35.14,Default,,0,0,0,,Жад?
Dialogue: 0,0:31:36.47,0:31:39.60,Default,,0,0,0,,Қайсысы жақын, анау ма әлде мынау ма?
Dialogue: 0,0:31:41.06,0:31:42.35,Default,,0,0,0,,Осылай ма?
Dialogue: 0,0:31:42.44,0:31:44.11,Default,,0,0,0,,Бұл цитрус болуы мүмкін.
Dialogue: 0,0:31:45.27,0:31:46.73,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:31:46.82,0:31:49.36,Default,,0,0,0,,Уф... бұрынғы иіс қатты шықты.
Dialogue: 0,0:31:49.44,0:31:51.61,Default,,0,0,0,,Кешіріңіз, оны қалпына келтіруге рұқсат етіңіз.
Dialogue: 0,0:31:52.20,0:31:55.24,Default,,0,0,0,,Олардың көптігі сонша, мен ажырата алмаймын.
Dialogue: 0,0:31:55.33,0:31:57.20,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:31:57.29,0:31:59.54,Default,,0,0,0,,Оң жақ танауыңыздан иіскеңіз.
Dialogue: 0,0:31:59.62,0:32:00.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:00.83,0:32:03.08,Default,,0,0,0,,Өйткені оң мұрын оң жақ мимен тікелей байланысты.
Dialogue: 0,0:32:03.17,0:32:04.96,Default,,0,0,0,,Мен иісті шынымен сеземін.
Dialogue: 0,0:32:05.04,0:32:06.21,Default,,0,0,0,,Егер бұл цитрус болса...
Dialogue: 0,0:32:10.67,0:32:14.05,Default,,0,0,0,,Бұл жерде цитрус соңғы нотада қалады.
Dialogue: 0,0:32:14.14,0:32:15.51,Default,,0,0,0,,Не болды?
Dialogue: 0,0:32:15.60,0:32:18.26,Default,,0,0,0,,Бұл бала иіссу іздеп жүр.
Dialogue: 0,0:32:18.35,0:32:19.52,Default,,0,0,0,,Оның қандай иісі бар?
Dialogue: 0,0:32:20.10,0:32:21.89,Default,,0,0,0,,Сіз бұл бетбелгіні түсінесіз бе?
Dialogue: 0,0:32:21.98,0:32:23.85,Default,,0,0,0,,Маған да иіскеп көрейін
Dialogue: 0,0:32:23.94,0:32:25.15,Default,,0,0,0,,-(Тапсырыс беруші) Мен де -(Тапсырыс беруші) Ммм.
Dialogue: 0,0:32:25.23,0:32:26.81,Default,,0,0,0,,Мен де оның иісін сеземін
Dialogue: 0,0:32:26.90,0:32:28.23,Default,,0,0,0,,Ханымдар мен мырзалар...
Dialogue: 0,0:32:28.32,0:32:31.19,Default,,0,0,0,,Иә? Мен оның иісін әлі сеземін.
Dialogue: 0,0:32:32.07,0:32:35.57,Default,,0,0,0,,Аюдың әйелі күткендей, оның иіс сезімі өте күшті!
Dialogue: 0,0:32:35.66,0:32:37.20,Default,,0,0,0,,Иә? бұл!
Dialogue: 0,0:32:37.28,0:32:39.08,Default,,0,0,0,,Күмән жоқ.
Dialogue: 0,0:32:39.16,0:32:41.66,Default,,0,0,0,,Маркулдың абайлығы!
Dialogue: 0,0:32:41.75,0:32:45.00,Default,,0,0,0,,- (Тапсырыс беруші) Жарайды, есімде! -(Тапсырыс беруші) жасады.
Dialogue: 0,0:32:47.38,0:32:49.38,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:32:50.42,0:32:53.34,Default,,0,0,0,,Бірнеше жыл бұрын, Аду Пруденс
Dialogue: 0,0:32:53.42,0:32:55.80,Default,,0,0,0,,Өндіріс тоқтатылды
Dialogue: 0,0:32:58.10,0:33:00.52,Default,,0,0,0,,Анаңызға:
Dialogue: 0,0:33:00.60,0:33:03.73,Default,,0,0,0,,Басқа сыйлықтар туралы ойлайсыз ба?
Dialogue: 0,0:33:03.81,0:33:04.60,Default,,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,0:33:04.69,0:33:05.98,Default,,0,0,0,,Басқа ештеңе істемейді
Dialogue: 0,0:33:06.06,0:33:06.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:08.86,0:33:10.86,Default,,0,0,0,,Мен үйлене алмаймын...
Dialogue: 0,0:33:10.94,0:33:11.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:11.78,0:33:13.57,Default,,0,0,0,,Мен...
Dialogue: 0,0:33:13.65,0:33:16.66,Default,,0,0,0,,Мен ол иіссусыз тұрмысқа шыға алмаймын!
Dialogue: 0,0:33:17.82,0:33:18.99,Default,,0,0,0,,Неке?
Dialogue: 0,0:33:19.99,0:33:23.20,Default,,0,0,0,,Теза – мектептегі ең танымал арыстан.
Dialogue: 0,0:33:23.29,0:33:24.41,Default,,0,0,0,,Шарттар берілді.
Dialogue: 0,0:33:25.87,0:33:28.84,Default,,0,0,0,,Маған осы бетбелгідегі иісті әкелсеңіз.
Dialogue: 0,0:33:29.34,0:33:30.96,Default,,0,0,0,,Мен саған үйленемін
Dialogue: 0,0:33:31.92,0:33:32.84,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:33:35.43,0:33:37.59,Default,,0,0,0,,Егер сіз оны ала алмасаңыз...
Dialogue: 0,0:33:37.68,0:33:40.26,Default,,0,0,0,,Ооооо~ Тұтынушы!
Dialogue: 0,0:33:40.35,0:33:42.77,Default,,0,0,0,,Маған біраз уақыт беріңізші.
Dialogue: 0,0:33:43.27,0:33:47.15,Default,,0,0,0,,Парфюмерия Мен оны саған тауып беремін!
Dialogue: 0,0:33:47.23,0:33:48.77,Default,,0,0,0,,Майюри сол жарыққа тартылып бара жатқандай болды
Dialogue: 0,0:33:54.44,0:33:57.24,Default,,0,0,0,,Мен мұны қайталадым...
Dialogue: 0,0:33:57.32,0:33:58.74,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:33:58.82,0:34:00.24,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:34:00.32,0:34:03.79,Default,,0,0,0,,Консьерж сөздігінде «ЖОҚ» сөзі жоқ!
Dialogue: 0,0:34:03.87,0:34:07.17,Default,,0,0,0,,Консьерж сөздігінде «ЖОҚ» сөзі жоқ!
Dialogue: 0,0:34:07.25,0:34:08.17,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:34:09.33,0:34:11.17,Default,,0,0,0,,Бұл былай деді...
Dialogue: 0,0:34:11.25,0:34:12.63,Default,,0,0,0,,Хмм.
Dialogue: 0,0:34:13.34,0:34:18.18,Default,,0,0,0,,Хмм... Ммм...
Dialogue: 0,0:34:18.26,0:34:20.55,Default,,0,0,0,,Иә? Біраз кеш пе?
Dialogue: 0,0:34:20.64,0:34:23.10,Default,,0,0,0,,- (Жүнді) Әр жолы осылай болады - (Акино) А?
Dialogue: 0,0:34:23.85,0:34:25.60,Default,,0,0,0,,Мен мінгенде
Dialogue: 0,0:34:29.44,0:34:33.52,Default,,0,0,0,,Бірақ бәрібір, бір күні жетеміз
Dialogue: 0,0:34:33.61,0:34:38.74,Default,,0,0,0,,Сіз мүсінші Вулли мамонтсыз ба?
Dialogue: 0,0:34:39.74,0:34:40.82,Default,,0,0,0,,Иә
Dialogue: 0,0:34:40.91,0:34:44.87,Default,,0,0,0,,Бұл Рождество. Мен көрмені талқылауға келдім.
Dialogue: 0,0:34:44.95,0:34:47.21,Default,,0,0,0,,Мейрамхананың кіре берісіндегі мүсін
Dialogue: 0,0:34:47.29,0:34:48.75,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:34:48.83,0:34:51.79,Default,,0,0,0,,Дүниенің соңында екі жануар ғана қалды
Dialogue: 0,0:34:51.88,0:34:55.80,Default,,0,0,0,,Жалғыз махаббатты растайтын мұң мен сұлулық...
Dialogue: 0,0:34:56.30,0:35:00.09,Default,,0,0,0,,Рахмет. Сізде алаңдаушылық бар ма?
Dialogue: 0,0:35:00.18,0:35:00.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:01.47,0:35:05.85,Default,,0,0,0,,«Ммм, аа» деп ыңырсып жатты.
Dialogue: 0,0:35:05.93,0:35:07.68,Default,,0,0,0,,А... бұл
Dialogue: 0,0:35:07.77,0:35:11.31,Default,,0,0,0,,Мен тұтынушы туралы аздап алаңдаймын.
Dialogue: 0,0:35:11.90,0:35:13.19,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:35:16.23,0:35:18.78,Default,,0,0,0,,Бұл қандай тұтынушы?
Dialogue: 0,0:35:19.28,0:35:21.70,Default,,0,0,0,,Мм... екеуің де.
Dialogue: 0,0:35:21.78,0:35:24.24,Default,,0,0,0,,Мен сүйген әйеліме ұсыныс жасағым келеді.
Dialogue: 0,0:35:24.33,0:35:26.24,Default,,0,0,0,,Сенімсіз сияқтысыз.
Dialogue: 0,0:35:26.33,0:35:28.70,Default,,0,0,0,,Мен сізге көмектескім келеді...
Dialogue: 0,0:35:29.62,0:35:33.13,Default,,0,0,0,,Әр адамның өзіне деген сенімі жоқ.
Dialogue: 0,0:35:34.13,0:35:37.17,Default,,0,0,0,,Мен де сөзге жарамаймын.
Dialogue: 0,0:35:37.26,0:35:39.05,Default,,0,0,0,,Сонымен менің әйелім...
Dialogue: 0,0:35:57.19,0:35:59.53,Default,,0,0,0,,Мұздан жасалған мүсіннің ішінде...
Dialogue: 0,0:35:59.61,0:36:01.86,Default,,0,0,0,,Қандай романтикалық ұсыныс
Dialogue: 0,0:36:02.61,0:36:04.62,Default,,0,0,0,,Бұл баяғыда болды
Dialogue: 0,0:36:04.70,0:36:06.24,Default,,0,0,0,,Керемет! Ах...
Dialogue: 0,0:36:06.33,0:36:07.62,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:36:07.70,0:36:09.08,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:36:09.16,0:36:11.87,Default,,0,0,0,,Рақмет, Вули мырза.
Dialogue: 0,0:36:18.59,0:36:19.76,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:36:19.84,0:36:22.47,Default,,0,0,0,,Мен сіздің командалық ойыныңызға сенемін.
Dialogue: 0,0:36:22.55,0:36:25.05,Default,,0,0,0,,Ынтымақтастық жасаңыз!
Dialogue: 0,0:36:25.55,0:36:28.18,Default,,0,0,0,,Сіз уәде еткен нәрсеге ештеңе істей алмайсыз.
Dialogue: 0,0:36:29.22,0:36:31.85,Default,,0,0,0,,Барлығымыз ынтымақтасайық!
Dialogue: 0,0:36:32.35,0:36:34.65,Default,,0,0,0,,Бұл ең алдымен сен кінәлі шығарсың!
Dialogue: 0,0:36:34.73,0:36:38.48,Default,,0,0,0,,-(Сатушы) Рұқсатсыз жасайсың ба... -(Сатушы) Қызық, жауапкершілікті кім алады?
Dialogue: 0,0:36:38.57,0:36:40.61,Default,,0,0,0,,Стратегия дегеніміз не?
Dialogue: 0,0:36:42.70,0:36:44.41,Default,,0,0,0,,аспаз!
Dialogue: 0,0:36:44.49,0:36:46.57,Default,,0,0,0,,V.I.A тұтынушылары үшін
Dialogue: 0,0:36:46.66,0:36:48.24,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз
Dialogue: 0,0:36:49.12,0:36:51.58,Default,,0,0,0,,Иә! Бұл мұз!
Dialogue: 0,0:36:56.08,0:36:57.50,Default,,0,0,0,,Әдемі дүкен
Dialogue: 0,0:36:57.59,0:36:59.00,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:37:00.55,0:37:02.72,Default,,0,0,0,,Ғажайып мұз оюы.
Dialogue: 0,0:37:03.34,0:37:05.51,Default,,0,0,0,,Бұл Вулли мырзаның мүсініне ұқсамайды.
Dialogue: 0,0:37:05.59,0:37:07.09,Default,,0,0,0,,Бұл өте бір нәрсе болуы керек.
Dialogue: 0,0:37:07.60,0:37:09.51,Default,,0,0,0,,Сіз күткендей, бас аспаз!
Dialogue: 0,0:37:10.01,0:37:13.85,Default,,0,0,0,,Сонымен не болды? Әңгімелейтін маңызды нәрсе бар.
Dialogue: 0,0:37:13.94,0:37:17.56,Default,,0,0,0,,А-а... Бұл туралы кейінірек айтамын.
Dialogue: 0,0:37:17.65,0:37:20.19,Default,,0,0,0,,Әзірше тамақ ішіп алайық.
Dialogue: 0,0:37:20.27,0:37:21.36,Default,,0,0,0,,Дүкенге кірді!
Dialogue: 0,0:37:21.44,0:37:23.95,Default,,0,0,0,,Уақытында келдіңіз, бас даяшы.
Dialogue: 0,0:37:24.45,0:37:26.82,Default,,0,0,0,,Жарайды, операцияны бастаңыз.
Dialogue: 0,0:37:26.91,0:37:28.74,Default,,0,0,0,,Түскі ас уақыты!
Dialogue: 0,0:37:37.83,0:37:39.67,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:37:39.75,0:37:43.84,Default,,0,0,0,,Шафран мен теңіз балдыры майы қосылған рисоттоға жасалған Кошихикари күріші
Dialogue: 0,0:37:43.92,0:37:46.22,Default,,0,0,0,,Гүлді көкөніс кускусын себіңіз
Dialogue: 0,0:37:46.30,0:37:50.26,Default,,0,0,0,,Пиментос және ноқат шырыны қосылған.
Dialogue: 0,0:37:50.81,0:37:52.47,Default,,0,0,0,,Ал оның Регалияларының көбі шын мәнінде Нора болып шықты.
Dialogue: 0,0:37:52.56,0:37:53.98,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:37:54.06,0:37:55.39,Default,,0,0,0,,Мен айта аламын!
Dialogue: 0,0:37:57.56,0:37:59.56,Default,,0,0,0,,Пиментос және ноқат шырыны
Dialogue: 0,0:37:59.65,0:38:01.15,Default,,0,0,0,,Дәмі жақсырақ болды.
Dialogue: 0,0:38:03.15,0:38:05.07,Default,,0,0,0,,А-а, мен саусақтың тостағанын іштім!
Dialogue: 0,0:38:05.90,0:38:06.99,Default,,0,0,0,,Бұл жаман...
Dialogue: 0,0:38:07.07,0:38:09.03,Default,,0,0,0,,-Пухх~ -(Тұтынушылар) Хэхехе
Dialogue: 0,0:38:09.12,0:38:12.58,Default,,0,0,0,,Бұл судың әлсіз лимон дәмі бар.
Dialogue: 0,0:38:18.00,0:38:18.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:20.17,0:38:22.63,Default,,0,0,0,,Ху~ Бұл рас.
Dialogue: 0,0:38:23.71,0:38:25.05,Default,,0,0,0,,Хмм!
Dialogue: 0,0:38:25.13,0:38:26.88,Default,,0,0,0,,Ол жақсы дос қыз емес пе?
Dialogue: 0,0:38:42.77,0:38:46.24,Default,,0,0,0,,Жарайды, мен десертті жедім.
Dialogue: 0,0:38:46.99,0:38:47.99,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:38:51.49,0:38:52.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:38:54.33,0:38:56.16,Default,,0,0,0,,Сабақ қалай өтті?
Dialogue: 0,0:38:56.25,0:38:57.96,Default,,0,0,0,,Өте дәмді болды.
Dialogue: 0,0:38:58.04,0:39:00.67,Default,,0,0,0,,Бұл жақсы, егер қарсы болмасаңыз...
Dialogue: 0,0:39:02.00,0:39:03.25,Default,,0,0,0,,Шай ішесіз бе?
Dialogue: 0,0:39:03.34,0:39:07.21,Default,,0,0,0,,Жақсы, иісі жақсы... жасмин.
Dialogue: 0,0:39:10.76,0:39:12.26,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:39:18.43,0:39:19.77,Default,,0,0,0,,Хмм
Dialogue: 0,0:39:23.73,0:39:25.52,Default,,0,0,0,,- (Жапондық қасқыр қыз) Сағыныш - иә?
Dialogue: 0,0:39:26.23,0:39:27.99,Default,,0,0,0,,Мен сені кездестірген кезде
Dialogue: 0,0:39:28.07,0:39:31.36,Default,,0,0,0,,Сүйкімді ақ жасмин гүлдері жайқалып тұрды.
Dialogue: 0,0:39:32.24,0:39:33.78,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:39:33.87,0:39:34.91,Default,,0,0,0,,Әрине
Dialogue: 0,0:39:36.54,0:39:39.16,Default,,0,0,0,,Жыл сайын осы маусым деп ойлаймын.
Dialogue: 0,0:39:40.00,0:39:42.33,Default,,0,0,0,,Мен танысқанымызға өте қуаныштымын.
Dialogue: 0,0:39:42.42,0:39:43.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:39:44.84,0:39:46.00,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:39:54.72,0:39:56.60,Default,,0,0,0,,(сақина құлаған дыбыс)
Dialogue: 0,0:40:05.56,0:40:06.77,Default,,0,0,0,,Менімен бірге!
Dialogue: 0,0:40:09.11,0:40:12.15,Default,,0,0,0,,Мұз еріп, сақина құлағанша кететін уақыт
Dialogue: 0,0:40:12.24,0:40:15.91,Default,,0,0,0,,Тұтынушылардың тамақтану жылдамдығына сәйкес пісіру және қызмет көрсету
Dialogue: 0,0:40:16.70,0:40:18.91,Default,,0,0,0,,Бұл тамаша кооперативтік ойын болды.
Dialogue: 0,0:40:20.41,0:40:21.79,Default,,0,0,0,,Қазір...
Dialogue: 0,0:40:22.87,0:40:25.75,Default,,0,0,0,,Басқа уәде туралы не айтасыз?
Dialogue: 0,0:40:27.34,0:40:31.01,Default,,0,0,0,,Құрметті тұтынушы, өте өкінішті.
Dialogue: 0,0:40:31.09,0:40:31.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:32.22,0:40:36.01,Default,,0,0,0,,Уәде етілген әтір табылмады.
Dialogue: 0,0:40:36.68,0:40:40.47,Default,,0,0,0,,Сіздің үмітіңізді ақтамағанымыз үшін өте өкінішті.
Dialogue: 0,0:40:42.48,0:40:44.15,Default,,0,0,0,,алмастыратын сыйлық ретінде
Dialogue: 0,0:40:44.23,0:40:47.31,Default,,0,0,0,,Менің ұсынғым келетін бір нәрсе бар.
Dialogue: 0,0:40:47.40,0:40:48.61,Default,,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:40:49.11,0:40:51.40,Default,,0,0,0,,Осындай орынсыз өтініш жасағаным үшін кешірім сұраймын.
Dialogue: 0,0:40:55.20,0:40:56.53,Default,,0,0,0,,Тұтынушы!
Dialogue: 0,0:40:57.07,0:40:58.33,Default,,0,0,0,,Тарари~н
Dialogue: 0,0:40:59.45,0:41:02.71,Default,,0,0,0,,Мен тез арада бір тиынды шығардым.
Dialogue: 0,0:41:02.79,0:41:03.91,Default,,0,0,0,,Қатты соққы!
Dialogue: 0,0:41:04.75,0:41:05.88,Default,,0,0,0,,Маруки мырза?
Dialogue: 0,0:41:06.46,0:41:08.29,Default,,0,0,0,,О? Тұтынушы
Dialogue: 0,0:41:08.38,0:41:10.75,Default,,0,0,0,,Сіздің иығыңызда бірдеңе бар...
Dialogue: 0,0:41:11.38,0:41:11.92,Default,,0,0,0,,Хой
Dialogue: 0,0:41:12.01,0:41:15.01,Default,,0,0,0,,А... анау бөтелке!
Dialogue: 0,0:41:16.05,0:41:17.93,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,0:41:21.60,0:41:23.56,Default,,0,0,0,,Әтірдің иісі!
Dialogue: 0,0:41:24.06,0:41:28.36,Default,,0,0,0,,Консьерж сиқыры!
Dialogue: 0,0:41:29.02,0:41:32.11,Default,,0,0,0,,Осы дүниенің бір жерінде киім-кешек үстелінің ішінде терең ұйықтау
Dialogue: 0,0:41:32.19,0:41:34.07,Default,,0,0,0,,Брендті табыңыз
Dialogue: 0,0:41:34.15,0:41:38.78,Default,,0,0,0,,Сиқырды жасырған таңғажайып тосын қойылым!
Dialogue: 0,0:41:38.87,0:41:41.49,Default,,0,0,0,,Көп жылдар бойы әйелдермен қарым-қатынас орнады
Dialogue: 0,0:41:41.58,0:41:44.21,Default,,0,0,0,,Бұл сенім сыйы!
Dialogue: 0,0:41:44.79,0:41:47.37,Default,,0,0,0,,Оны абайлап ұстаңыз.
Dialogue: 0,0:41:47.46,0:41:49.46,Default,,0,0,0,,Бұл соңғы болуы мүмкін
Dialogue: 0,0:41:50.29,0:41:52.05,Default,,0,0,0,,Егер ол шынымен жоғалып кетсе...
Dialogue: 0,0:41:52.76,0:41:55.72,Default,,0,0,0,,Оны сиқырмен де шығара алмайсың.
Dialogue: 0,0:41:56.88,0:41:57.97,Default,,0,0,0,,Рахмет
Dialogue: 0,0:42:00.22,0:42:01.56,Default,,0,0,0,,Консьерж мырза...
Dialogue: 0,0:42:04.85,0:42:06.02,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:42:07.85,0:42:10.77,Default,,0,0,0,,Қос ұсыныс стратегиясы сәтті болды.
Dialogue: 0,0:42:10.86,0:42:16.57,Default,,0,0,0,,Бұл жаңадан келген ойыншының шектен шыққан уәдесін бәрінің жоюының нәтижесі болды.
Dialogue: 0,0:42:16.65,0:42:18.07,Default,,0,0,0,,Хехехе
Dialogue: 0,0:42:18.74,0:42:23.20,Default,,0,0,0,,Акино мырза қозғалғандықтан, біз тұтынушының өтінішін байқадық.
Dialogue: 0,0:42:23.79,0:42:26.00,Default,,0,0,0,,Екеуі де тамаша команда ойыншылары.
Dialogue: 0,0:42:27.21,0:42:31.34,Default,,0,0,0,,Мен тоқтасам да жойылып кеткен түрдің махаббат жолына араласу
Dialogue: 0,0:42:31.42,0:42:35.46,Default,,0,0,0,,Жасанды өсіру тек қулық па?
Dialogue: 0,0:42:35.97,0:42:37.34,Default,,0,0,0,,Токива-кун…
Dialogue: 0,0:42:38.26,0:42:42.97,Default,,0,0,0,,Мен сол консьержді оқуға ресми түрде алғым келеді.
Dialogue: 0,0:42:43.51,0:42:46.10,Default,,0,0,0,,Менің көп күмәнім бар.
Dialogue: 0,0:42:48.64,0:42:51.94,Default,,0,0,0,,- (Акино) Қайта құрылымдаушы орындаушы...? - (Мен) Иә.
Dialogue: 0,0:42:52.61,0:42:55.15,Default,,0,0,0,,Қызметкерлер арасындағы бәсекелестікті ынталандыру
Dialogue: 0,0:42:55.23,0:42:57.95,Default,,0,0,0,,Бұл жасырын түрде енгізілген жүйе болды.
Dialogue: 0,0:42:58.03,0:42:59.45,Default,,0,0,0,,Дүкендерді аралау
Dialogue: 0,0:42:59.53,0:43:03.37,Default,,0,0,0,,Тиімсіз жұмыс істейтін адамды тапқанда...
Dialogue: 0,0:43:04.08,0:43:07.04,Default,,0,0,0,,Мүмкін сізді жұмыстан шығарған шығар...?
Dialogue: 0,0:43:07.12,0:43:10.58,Default,,0,0,0,,Акино-чан, ол әлі қабылданған жоқ.
Dialogue: 0,0:43:10.67,0:43:12.13,Default,,0,0,0,,Солай~
Dialogue: 0,0:43:12.21,0:43:14.88,Default,,0,0,0,,Хаха, әзіл, әзіл!
Dialogue: 0,0:43:17.21,0:43:19.59,Default,,0,0,0,,Маған не істей аласыз, консьерж мырза!
Dialogue: 0,0:43:19.68,0:43:21.51,Default,,0,0,0,,Мен бірінші кезекте тұрдым.
Dialogue: 0,0:43:21.59,0:43:23.51,Default,,0,0,0,,Сонда да мен лифттен түскенде
Dialogue: 0,0:43:23.60,0:43:25.93,Default,,0,0,0,,Бұл соңғы!
Dialogue: 0,0:43:26.02,0:43:27.77,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:43:27.85,0:43:29.48,Default,,0,0,0,,Күту кезегін бағыттау кезінде
Dialogue: 0,0:43:29.56,0:43:32.94,Default,,0,0,0,,Бұл біздің дүкеннің назар аудармауына байланысты.
Dialogue: 0,0:43:33.02,0:43:35.90,Default,,0,0,0,,Сол жартастың ойығындағы.
Dialogue: 0,0:43:35.98,0:43:38.28,Default,,0,0,0,,Маған сол су өсімдігі керек.
Dialogue: 0,0:43:38.36,0:43:40.86,Default,,0,0,0,,Құрметті тұтынушы, келтірілген қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:43:40.95,0:43:43.91,Default,,0,0,0,,Бұл аквариум голографиялық сурет...
Dialogue: 0,0:43:45.12,0:43:45.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:46.58,0:43:48.41,Default,,0,0,0,,Бұл бейнеде не көрсетілген?
Dialogue: 0,0:43:48.50,0:43:51.29,Default,,0,0,0,,Оның бір жерде болуы мүмкіндігі бар.
Dialogue: 0,0:43:51.37,0:43:53.96,Default,,0,0,0,,Біз сізге мүмкіндігінше тезірек хабарласамыз.
Dialogue: 0,0:43:54.04,0:43:56.50,Default,,0,0,0,,Акино-кун өсіп келеді.
Dialogue: 0,0:43:56.59,0:43:59.26,Default,,0,0,0,,Сәтсіздікке жету оңай ма?
Dialogue: 0,0:43:59.34,0:44:03.22,Default,,0,0,0,,Тодо-сан, сен Акино-санға қатты ұнап қалдың.
Dialogue: 0,0:44:03.30,0:44:04.68,Default,,0,0,0,,Не!
Dialogue: 0,0:44:04.76,0:44:07.18,Default,,0,0,0,,Мен жай ғана қабат меңгерушісімін
Dialogue: 0,0:44:07.26,0:44:08.27,Default,,0,0,0,,Жаңа консьерж...
Dialogue: 0,0:44:09.02,0:44:09.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:12.90,0:44:15.19,Default,,0,0,0,,Сәлем консьерж-сан
Dialogue: 0,0:44:15.27,0:44:17.98,Default,,0,0,0,,Мен мерекелік көйлек алғым келеді.
Dialogue: 0,0:44:18.07,0:44:21.49,Default,,0,0,0,,Әйелдер киімі бөлімдері 3 және 4 қабаттарда орналасқан.
Dialogue: 0,0:44:21.57,0:44:24.16,Default,,0,0,0,,Осы жерден тура жалғастырыңыз.
Dialogue: 0,0:44:24.24,0:44:27.66,Default,,0,0,0,,Мына жерде лифт бар...
Dialogue: 0,0:44:29.29,0:44:31.08,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:44:31.16,0:44:33.25,Default,,0,0,0,,Жетті…
Dialogue: 0,0:44:33.33,0:44:36.04,Default,,0,0,0,,Мені осында әкелгеніңіз үшін рахмет.
Dialogue: 0,0:44:36.13,0:44:38.84,Default,,0,0,0,,Сатып алудан рахат алыңыз!
Dialogue: 0,0:44:41.34,0:44:43.18,Default,,0,0,0,,Консьерж мырза
Dialogue: 0,0:44:45.39,0:44:47.85,Default,,0,0,0,,Үйлестіруді қарастыра аласыз ба?
Dialogue: 0,0:44:51.18,0:44:52.14,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:44:53.35,0:44:54.35,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:44:55.40,0:44:57.31,Default,,0,0,0,,Бұл сізге өте жарасады!
Dialogue: 0,0:44:58.65,0:45:00.15,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:45:00.23,0:45:02.61,Default,,0,0,0,,Және... бұл шектен шыққан.
Dialogue: 0,0:45:02.69,0:45:05.36,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:45:05.45,0:45:09.03,Default,,0,0,0,,Дүкен сатушысының алдында ойымды айта алмаймын.
Dialogue: 0,0:45:09.12,0:45:12.71,Default,,0,0,0,,Сіздің осында болуыңыз маған шынымен көмектеседі.
Dialogue: 0,0:45:14.42,0:45:16.04,Default,,0,0,0,,Бұл сізге сәйкес келеді.
Dialogue: 0,0:45:16.13,0:45:19.25,Default,,0,0,0,,Иә? Жарайды, мен мұны аламын.
Dialogue: 0,0:45:19.96,0:45:21.42,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:45:21.51,0:45:24.72,Default,,0,0,0,,Кешіріңіз, бірақ мен мұның барлығынан бас тартамын.
Dialogue: 0,0:45:24.80,0:45:25.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:26.01,0:45:28.35,Default,,0,0,0,,Осы алқаны таңдағанда
Dialogue: 0,0:45:28.43,0:45:31.47,Default,,0,0,0,,Бұл ақ көйлек жалғыз нұсқа.
Dialogue: 0,0:45:31.56,0:45:32.64,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:45:32.73,0:45:34.06,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:45:34.64,0:45:37.02,Default,,0,0,0,,Бұдан бір өлшем үлкенірек болғанын қалайсыз ба?
Dialogue: 0,0:45:37.10,0:45:39.02,Default,,0,0,0,,Сондай-ақ... Кешіріңіз.
Dialogue: 0,0:45:39.61,0:45:41.15,Default,,0,0,0,,Бұл көйлек
Dialogue: 0,0:45:41.23,0:45:44.28,Default,,0,0,0,,Бізде тек қазір дүкендерде бар заттар бар.
Dialogue: 0,0:45:44.36,0:45:45.65,Default,,0,0,0,,Консьерж мырза
Dialogue: 0,0:45:45.74,0:45:46.95,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:45:47.70,0:45:50.78,Default,,0,0,0,,«Солтүстік полюстегі әмбебап дүкен, онда сіз бәрін таба аласыз, солай ма?
Dialogue: 0,0:45:50.87,0:45:53.70,Default,,0,0,0,,Иә, мүмкіндігінше тезірек тапсырыс береміз.
Dialogue: 0,0:45:53.79,0:45:56.33,Default,,0,0,0,,Мен мұны қазір қалаймын!
Dialogue: 0,0:45:56.42,0:45:57.92,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:45:58.50,0:46:01.55,Default,,0,0,0,,Біз оны мүмкіндігінше тезірек сізге жеткізу үшін бар күшімізді саламыз.
Dialogue: 0,0:46:01.63,0:46:04.59,Default,,0,0,0,,Сіз мейірімді консьержсіз.
Dialogue: 0,0:46:04.67,0:46:08.14,Default,,0,0,0,,Шын жүректен өкінетін адам
Dialogue: 0,0:46:08.64,0:46:11.89,Default,,0,0,0,,Иә, мен терең кешірім сұраймын.
Dialogue: 0,0:46:12.39,0:46:14.93,Default,,0,0,0,,«Қызмет» нені білдіретінін білесіз бе?
Dialogue: 0,0:46:15.02,0:46:15.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:17.48,0:46:20.65,Default,,0,0,0,,«Қызметші» Қызметші
Dialogue: 0,0:46:21.44,0:46:24.61,Default,,0,0,0,,Қожайынның үмітіне опасыздық жасағанда
Dialogue: 0,0:46:24.69,0:46:28.24,Default,,0,0,0,,Осындай мінсіздікпен күн көретін қызметші
Dialogue: 0,0:46:28.32,0:46:30.03,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:46:30.12,0:46:31.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:46:31.49,0:46:35.29,Default,,0,0,0,,Кешірім сұрасам да, кешірім сұрауға мәжбүрлегім келмейді.
Dialogue: 0,0:46:35.37,0:46:37.25,Default,,0,0,0,,Догеза?
Dialogue: 0,0:46:37.33,0:46:38.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:39.92,0:46:42.21,Default,,0,0,0,,«Тұтынушы – Құдай»
Dialogue: 0,0:46:42.29,0:46:43.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:46:44.21,0:46:46.17,Default,,0,0,0,,Сені солай үйретті, солай ма?
Dialogue: 0,0:46:46.67,0:46:50.51,Default,,0,0,0,,Консьерж сөздігінде «ЖОҚ» жоқ!
Dialogue: 0,0:46:50.59,0:46:55.56,Default,,0,0,0,,Біз ешқашан тұтынушыларымыздың үміттерін ақтамауымыз керек!
Dialogue: 0,0:46:57.73,0:46:58.52,Default,,0,0,0,,Иә...
Dialogue: 0,0:47:06.15,0:47:08.78,Default,,0,0,0,,Бұл жолы... өте қиын...
Dialogue: 0,0:47:09.53,0:47:11.16,Default,,0,0,0,,Кешірім сұраймыз...
Dialogue: 0,0:47:11.70,0:47:12.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:13.03,0:47:15.58,Default,,0,0,0,,Акино-чан, артта қал.
Dialogue: 0,0:47:17.33,0:47:21.71,Default,,0,0,0,,Келтірілген қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:47:21.79,0:47:25.75,Default,,0,0,0,,Қоймадағы шығарылымға түсіністікпен қарағаныңыз үшін рахмет.
Dialogue: 0,0:47:25.84,0:47:28.84,Default,,0,0,0,,Бүгін оны алыңыз.
Dialogue: 0,0:47:28.92,0:47:30.55,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:47:31.26,0:47:33.89,Default,,0,0,0,,Иә? Ала кету?
Dialogue: 0,0:47:33.97,0:47:35.64,Default,,0,0,0,,Бәрін тек қана жап-жасырып қойдың ба?
Dialogue: 0,0:47:35.72,0:47:39.39,Default,,0,0,0,,Бұл сіздің кінәңіз болса да, неге тұтынушыға шағымданушы ретінде қарайсыз?
Dialogue: 0,0:47:39.48,0:47:41.81,Default,,0,0,0,,Дөрекілігіңнің шегі бар!
Dialogue: 0,0:47:41.90,0:47:42.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:44.02,0:47:47.19,Default,,0,0,0,,Тұтынушы Құдаймын десе
Dialogue: 0,0:47:47.28,0:47:50.78,Default,,0,0,0,,Дүкен ішінде қатты дыбыс шығармаңыз.
Dialogue: 0,0:47:51.82,0:47:54.83,Default,,0,0,0,,Бұл басқа құдайларға қиындық тудырады.
Dialogue: 0,0:48:02.67,0:48:03.88,Default,,0,0,0,,Ууууууу…
Dialogue: 0,0:48:03.96,0:48:05.54,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:48:06.04,0:48:12.68,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:48:12.76,0:48:19.02,Default,,0,0,0,,Ууууууу~!
Dialogue: 0,0:48:21.06,0:48:23.94,Default,,0,0,0,,Мен енді ешқашан келмеймін! Осындай дүкен!
Dialogue: 0,0:48:24.02,0:48:25.69,Default,,0,0,0,,О... тұтынушы!
Dialogue: 0,0:48:27.57,0:48:29.57,Default,,0,0,0,,Мен сені шығарып саламын.
Dialogue: 0,0:48:29.65,0:48:30.61,Default,,0,0,0,,Мен де!
Dialogue: 0,0:48:31.19,0:48:33.82,Default,,0,0,0,,Акино-чан бірінші болып қайтты.
Dialogue: 0,0:48:44.12,0:48:48.05,Default,,0,0,0,,Кариб теңізінің монах итбалығы Кариб теңізінде тіршілік етеді
Dialogue: 0,0:48:48.67,0:48:50.51,Default,,0,0,0,,Қырағы болмағандықтан
Dialogue: 0,0:48:50.59,0:48:54.18,Default,,0,0,0,,Аңшылар майдың машина майы ретінде пайдалы екенін байқады.
Dialogue: 0,0:48:54.26,0:48:56.01,Default,,0,0,0,,Жақындау оңай болды
Dialogue: 0,0:48:56.76,0:48:59.97,Default,,0,0,0,,1952 ж. Жою
Dialogue: 0,0:49:01.18,0:49:02.94,Default,,0,0,0,,Мм... сен ше?
Dialogue: 0,0:49:03.44,0:49:07.19,Default,,0,0,0,,Шектен өткен мейірімділік тек өзін-өзі жоюға әкеледі.
Dialogue: 0,0:49:07.69,0:49:09.65,Default,,0,0,0,,Осы тұтынушыны қызықтырыңыз
Dialogue: 0,0:49:09.73,0:49:12.44,Default,,0,0,0,,Мені арыздандырған сенсің.
Dialogue: 0,0:49:14.07,0:49:18.91,Default,,0,0,0,,Ең бастысы, біз басқа тұтынушылардың сауда уақытын қызықты өткізетініне көз жеткізгіміз келеді.
Dialogue: 0,0:49:18.99,0:49:22.66,Default,,0,0,0,,Оны қирату үлкен қылмыс деп ойламайсың ба?
Dialogue: 0,0:49:23.41,0:49:25.33,Default,,0,0,0,,Консьерж ретінде
Dialogue: 0,0:49:26.75,0:49:29.46,Default,,0,0,0,,Алдындағыны ғана көре алатындар
Dialogue: 0,0:49:29.54,0:49:31.59,Default,,0,0,0,,Консьерж жұмысына жарамсыз
Dialogue: 0,0:49:32.59,0:49:35.47,Default,,0,0,0,,Сіз бұл әмбебап дүкенге қажет емессіз.
Dialogue: 0,0:49:42.85,0:49:45.64,Default,,0,0,0,,-Бұл біздің компанияның жарнамасы. -Иә.
Dialogue: 0,0:49:45.73,0:49:49.02,Default,,0,0,0,,Бұл биді менің атам бастаған.
Dialogue: 0,0:49:49.11,0:49:53.11,Default,,0,0,0,,Мен оны уақытпен сәйкестендіру үшін жаңартуды ойлаймын.
Dialogue: 0,0:49:53.90,0:49:57.86,Default,,0,0,0,,Статус-квоны сақтау үшінші ұрпақ үшін маңызды рөл емес пе?
Dialogue: 0,0:50:00.99,0:50:03.00,Default,,0,0,0,,Бұл әсерлі кітаптар жинағы.
Dialogue: 0,0:50:03.08,0:50:04.58,Default,,0,0,0,,Бұл менің атамдікі.
Dialogue: 0,0:50:04.66,0:50:06.50,Default,,0,0,0,,Тірі заттардың тарихы
Dialogue: 0,0:50:06.58,0:50:10.50,Default,,0,0,0,,Бұл дүниеде жоқ жойылып кеткен жануарлардың жазбалары
Dialogue: 0,0:50:12.84,0:50:14.38,Default,,0,0,0,,Қара үкі
Dialogue: 0,0:50:14.46,0:50:17.01,Default,,0,0,0,,Күлкі тәрізді айқаймен сипатталады
Dialogue: 0,0:50:17.51,0:50:19.18,Default,,0,0,0,,1914 ж
Dialogue: 0,0:50:19.26,0:50:23.22,Default,,0,0,0,,Оңтүстік Кентербериде соңғы рет көргеннен кейін жойылды
Dialogue: 0,0:50:24.31,0:50:25.52,Default,,0,0,0,,Теңіз күзені
Dialogue: 0,0:50:26.02,0:50:30.19,Default,,0,0,0,,Оның жүні ең жақсы материал болып саналады және адамдар үшін нысана болып табылады.
Dialogue: 0,0:50:30.69,0:50:33.61,Default,,0,0,0,,1880 жылға қарай жоғалып кетті
Dialogue: 0,0:50:35.53,0:50:38.61,Default,,0,0,0,,Жапон қасқыры Жапонияда тұрады
Dialogue: 0,0:50:39.32,0:50:43.87,Default,,0,0,0,,1905 жылы жойылды, егжей-тегжейлі экология негізінен белгісіз
Dialogue: 0,0:50:45.79,0:50:47.16,Default,,0,0,0,,Үлкен аук
Dialogue: 0,0:50:47.25,0:50:50.21,Default,,0,0,0,,Азық-түлік пен май іздеген
Dialogue: 0,0:50:50.29,0:50:56.05,Default,,0,0,0,,Шамамен 1830 жылы 50 құстың ғана тірі қалғаны хабарланды.
Dialogue: 0,0:50:56.72,0:51:00.80,Default,,0,0,0,,Кейінірек оны үлгі іздеген адамдар аулады.
Dialogue: 0,0:51:00.89,0:51:03.76,Default,,0,0,0,,1844 жылы жойылды
Dialogue: 0,0:51:07.18,0:51:10.19,Default,,0,0,0,,Бір мезгілде дерлік ұлы ауктың жойылуымен
Dialogue: 0,0:51:10.27,0:51:13.11,Default,,0,0,0,,Дүние жүзіндегі бірінші әмбебап дүкен дүниеге келді.
Dialogue: 0,0:51:13.86,0:51:16.23,Default,,0,0,0,,Міндетті түрде емес
Dialogue: 0,0:51:16.32,0:51:19.74,Default,,0,0,0,,Адамдардың өз қалауы бойынша заттарды сатып алатын кезі.
Dialogue: 0,0:51:21.28,0:51:23.99,Default,,0,0,0,,V.I.A. адамдар жойып жіберген
Dialogue: 0,0:51:24.08,0:51:28.29,Default,,0,0,0,,Бұл әмбебап қонақжайлылықты адами әдеппен қамтамасыз ету үшін құрылған.
Dialogue: 0,0:51:28.96,0:51:32.42,Default,,0,0,0,,Қайғы-қасірет тарихын келешек ұрпаққа сақтау
Dialogue: 0,0:51:32.50,0:51:36.42,Default,,0,0,0,,Адамдарды кем дегенде күнәларын өтеу.
Dialogue: 0,0:51:37.01,0:51:41.84,Default,,0,0,0,,Міне, V.I.A. жаппай тұтынудан толық ләззат алу.
Dialogue: 0,0:51:41.93,0:51:43.97,Default,,0,0,0,,Бұл армандаған саябақ па?
Dialogue: 0,0:51:44.97,0:51:47.89,Default,,0,0,0,,Ал қазір ойланып отырмын
Dialogue: 0,0:51:47.97,0:51:50.94,Default,,0,0,0,,Болашақтың Солтүстік полюс әмбебап дүкені
Dialogue: 0,0:51:51.56,0:51:54.15,Default,,0,0,0,,Болашақ?
Dialogue: 0,0:51:55.02,0:51:57.15,Default,,0,0,0,,Мен әлі де сенімді емеспін
Dialogue: 0,0:51:58.99,0:52:01.57,Default,,0,0,0,,Мен оның бағасын сақтаймын.
Dialogue: 0,0:52:08.62,0:52:10.91,Default,,0,0,0,,Бүгін Солтүстік полюс әмбебап дүкенінде
Dialogue: 0,0:52:11.00,0:52:14.46,Default,,0,0,0,,Бізге келгеніңіз үшін рахмет.
Dialogue: 0,0:52:15.75,0:52:19.34,Default,,0,0,0,,Оқиға туралы ақпарат дүкенге келген тұтынушыларға беріледі.
Dialogue: 0,0:52:22.05,0:52:23.39,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:52:23.47,0:52:26.26,Default,,0,0,0,,Бүгін келгендеріңізге рахмет.
Dialogue: 0,0:52:26.35,0:52:27.97,Default,,0,0,0,,Консьерж мырза!
Dialogue: 0,0:52:28.06,0:52:30.23,Default,,0,0,0,,Иә? Қош келдіңіз
Dialogue: 0,0:52:31.35,0:52:32.73,Default,,0,0,0,,Дегенмен, бетіңіз көрсетілгеніне қарамастан, осындай бағдарламаға шығу үлкен батылдықты талап етеді деп ойлаймын.
Dialogue: 0,0:52:32.81,0:52:33.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:52:33.65,0:52:36.69,Default,,0,0,0,,Мен Вули мырзаның арнайы көрмесін тамашалауға келдім.
Dialogue: 0,0:52:37.40,0:52:40.90,Default,,0,0,0,,Сіз тіпті шедевр делінетін Смилодонды көре аласыз!
Dialogue: 0,0:52:40.99,0:52:43.82,Default,,0,0,0,,Шара үлкен залда өтуде.
Dialogue: 0,0:52:43.91,0:52:45.37,Default,,0,0,0,,Рахмет
Dialogue: 0,0:52:45.45,0:52:46.66,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:52:47.16,0:52:48.62,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:52:54.88,0:52:57.75,Default,,0,0,0,,Сіз бұл әмбебап дүкенге қажет емессіз.
Dialogue: 0,0:52:58.67,0:53:00.17,Default,,0,0,0,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,0:53:00.76,0:53:04.72,Default,,0,0,0,,Мен қызыма жаңа жылдық сыйлық алғым келеді.
Dialogue: 0,0:53:04.80,0:53:07.76,Default,,0,0,0,,бұл... Иә, маған көмектесуге рұқсат етіңіз.
Dialogue: 0,0:53:07.85,0:53:09.26,Default,,0,0,0,,Жақсы
Dialogue: 0,0:53:09.35,0:53:11.85,Default,,0,0,0,,Бірақ бюджет шектеулі...
Dialogue: 0,0:53:13.31,0:53:16.31,Default,,0,0,0,,Осыны қарап шыға аласыз ба?
Dialogue: 0,0:53:17.40,0:53:20.28,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:53:21.32,0:53:23.15,Default,,0,0,0,,Бір тиынға сатып алуға болатын сыйлықтар
Dialogue: 0,0:53:24.24,0:53:26.82,Default,,0,0,0,,Менің қызым Джонси жиі ауырады.
Dialogue: 0,0:53:26.91,0:53:30.08,Default,,0,0,0,,Менің балам көптен бері ауруханада болды.
Dialogue: 0,0:53:31.29,0:53:33.66,Default,,0,0,0,,Бүгін де шығуға рұқсат алған жоқпын.
Dialogue: 0,0:53:34.75,0:53:38.00,Default,,0,0,0,,Егер мен Рождествода Солтүстік полюс әмбебап дүкенін аралай алсам
Dialogue: 0,0:53:38.08,0:53:42.01,Default,,0,0,0,,Осының өзі ең жақсы сыйлық болар еді...
Dialogue: 0,0:53:43.47,0:53:48.09,Default,,0,0,0,,Бір монета жағдайында таңдауға болатын өнімдер өте шектеулі.
Dialogue: 0,0:53:50.43,0:53:54.48,Default,,0,0,0,,Солтүстік полюс әмбебап дүкені, сайып келгенде, жоғары деңгейдегі әмбебап дүкен.
Dialogue: 0,0:53:55.44,0:53:59.52,Default,,0,0,0,,Мен Солтүстік полюс әмбебап дүкенінде консьерж болуым керек пе?
Dialogue: 0,0:54:03.07,0:54:03.82,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:54:05.36,0:54:07.11,Default,,0,0,0,,Консьерж мырза!
Dialogue: 0,0:54:08.11,0:54:10.24,Default,,0,0,0,,Barbary Lion тұтынушылары!
Dialogue: 0,0:54:10.33,0:54:12.87,Default,,0,0,0,,Мүмкін сіздің жаныңыздағы адам...
Dialogue: 0,0:54:13.37,0:54:14.87,Default,,0,0,0,,Оның тасері
Dialogue: 0,0:54:14.96,0:54:16.08,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:54:16.58,0:54:18.75,Default,,0,0,0,,Бұл бөлім үшін рахмет.
Dialogue: 0,0:54:18.83,0:54:23.17,Default,,0,0,0,,Тезамен сөйлескенімде ол менімен Солтүстік полюс әмбебап дүкеніне барғысы келетінін айтты.
Dialogue: 0,0:54:23.67,0:54:27.68,Default,,0,0,0,,Баршаңызға қайтаратын бірдеңе болса екен деймін.
Dialogue: 0,0:54:28.18,0:54:28.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:30.01,0:54:32.51,Default,,0,0,0,,Менің өтінішім бар...
Dialogue: 0,0:54:34.31,0:54:35.77,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:54:35.85,0:54:39.23,Default,,0,0,0,,Барлық жануарлар мүсіндерінің биіктігі бірдей.
Dialogue: 0,0:54:39.31,0:54:41.98,Default,,0,0,0,,Мистер Вуллидің әйеліне деген сезіміне байланысты.
Dialogue: 0,0:54:42.48,0:54:48.49,Default,,0,0,0,,Менің әйелім кішкентай жануарлардың қысқа өмір сүруіне үнемі қынжылады.
Dialogue: 0,0:54:48.99,0:54:54.58,Default,,0,0,0,,Барлық жануарлардың арасында ешқандай айырмашылық болмаса және олардың өлшемдері бірдей болса ше?
Dialogue: 0,0:54:55.08,0:54:58.79,Default,,0,0,0,,Әйеліме деген сүйіспеншіліктен туындаған утопия
Dialogue: 0,0:54:58.87,0:55:00.04,Default,,0,0,0,,Тіпті осы көрмеде...
Dialogue: 0,0:55:03.00,0:55:04.25,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:55:05.26,0:55:08.76,Default,,0,0,0,,Бұл үлкен жетістік сияқты.
Dialogue: 0,0:55:08.84,0:55:10.93,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:55:11.01,0:55:12.55,Default,,0,0,0,,Мистер Вули
Dialogue: 0,0:55:13.47,0:55:14.39,Default,,0,0,0,,Сәлем
Dialogue: 0,0:55:14.47,0:55:16.77,Default,,0,0,0,,Өткен күн үшін рахмет.
Dialogue: 0,0:55:16.85,0:55:18.10,Default,,0,0,0,,Шай ішесіз бе?
Dialogue: 0,0:55:20.19,0:55:21.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:55:22.98,0:55:24.73,Default,,0,0,0,,- (Жүнді) Көрдің бе? -(Акино) Иә.
Dialogue: 0,0:55:25.32,0:55:28.70,Default,,0,0,0,,Маған Смилодонның жұмысы ерекше ұнады.
Dialogue: 0,0:55:29.45,0:55:30.66,Default,,0,0,0,,Менің әйелім де...
Dialogue: 0,0:55:30.74,0:55:34.62,Default,,0,0,0,,«Смилодонның шеберлігі әсіресе жақсы», - деді ол.
Dialogue: 0,0:55:35.66,0:55:38.08,Default,,0,0,0,,- (Тұтынушы) Itte! Сақ болыңыз! - Ой, кешір!
Dialogue: 0,0:55:38.16,0:55:39.71,Default,,0,0,0,,- (Мирқат) Көрдің бе? -Не!
Dialogue: 0,0:55:39.79,0:55:41.17,Default,,0,0,0,,Уа уа...
Dialogue: 0,0:55:41.25,0:55:42.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:42.25,0:55:43.50,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:55:43.59,0:55:45.92,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:55:50.55,0:55:52.43,Default,,0,0,0,,Мен үшін не істейсің!
Dialogue: 0,0:55:52.51,0:55:55.01,Default,,0,0,0,,Смилодон мүсінін Вулли мырза жасаған.
Dialogue: 0,0:55:55.10,0:55:59.14,Default,,0,0,0,,Суретші ретіндегі беделімді арттырған таптырмас өнер туындысы!
Dialogue: 0,0:55:59.23,0:56:02.19,Default,,0,0,0,,Мәңгілік тоң ательесі ери бастағаннан кейін де
Dialogue: 0,0:56:02.27,0:56:05.82,Default,,0,0,0,,Бұл менің сақтаған жалғыз және ең маңызды жұмысым!
Dialogue: 0,0:56:05.90,0:56:07.57,Default,,0,0,0,,Вулли мырзаның еңбегінің құндылығы қандай?
Dialogue: 0,0:56:07.65,0:56:09.19,Default,,0,0,0,,Біз бұл туралы өте жақсы білеміз.
Dialogue: 0,0:56:09.28,0:56:12.95,Default,,0,0,0,,Біздің дүкен өтемақыға жауапты...
Dialogue: 0,0:56:13.03,0:56:15.74,Default,,0,0,0,,Бұл өтемақы төлеу арқылы шешілетін мәселе емес!
Dialogue: 0,0:56:15.83,0:56:19.00,Default,,0,0,0,,Балалар, Смилодонның қадірін түсінесіңдер ме?
Dialogue: 0,0:56:19.08,0:56:20.08,Default,,0,0,0,,Ум...
Dialogue: 0,0:56:21.41,0:56:24.04,Default,,0,0,0,,Оның консьержге еш қатысы жоқ!
Dialogue: 0,0:56:24.13,0:56:26.67,Default,,0,0,0,,Акино-кун, түс.
Dialogue: 0,0:56:27.67,0:56:28.84,Default,,0,0,0,,қалады
Dialogue: 0,0:56:29.34,0:56:32.26,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:56:32.76,0:56:35.47,Default,,0,0,0,,Мен білмеймін... бірақ
Dialogue: 0,0:56:36.68,0:56:37.85,Default,,0,0,0,,Бұл қалады...
Dialogue: 0,0:56:38.89,0:56:41.18,Default,,0,0,0,,Бұл Мистер Вулли
Dialogue: 0,0:56:41.94,0:56:43.56,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:56:44.06,0:56:47.52,Default,,0,0,0,,Әйеліңізден де кешірім сұрауға рұқсат етіңіз!
Dialogue: 0,0:56:48.19,0:56:49.40,Default,,0,0,0,,Акино-кун
Dialogue: 0,0:56:50.78,0:56:54.78,Default,,0,0,0,,Вулли мырзаның әйелі қазірдің өзінде қайтыс болды.
Dialogue: 0,0:56:55.37,0:56:56.37,Default,,0,0,0,,А...
Dialogue: 0,0:56:56.45,0:56:58.28,Default,,0,0,0,,Бұл оқиға осы жерде аяқталады.
Dialogue: 0,0:57:00.95,0:57:05.00,Default,,0,0,0,,Пішіні бар нәрсе бір күні бұзылады
Dialogue: 0,0:57:05.08,0:57:10.38,Default,,0,0,0,,(Аспапты баптау дыбысы)
Dialogue: 0,0:57:13.22,0:57:20.22,Default,,0,0,0,,(«Моробито Козорите» оркестрінің орындауы)
Dialogue: 0,0:57:25.81,0:57:27.48,Default,,0,0,0,,Концерт басталды!
Dialogue: 0,0:57:27.56,0:57:29.73,Default,,0,0,0,,Кеттік! Жүр, асығыңыз!
Dialogue: 0,0:57:38.37,0:57:39.37,Default,,0,0,0,,Вулли мырза!
Dialogue: 0,0:57:41.79,0:57:45.37,Default,,0,0,0,,Мм... шынымен де бұл жолы...
Dialogue: 0,0:57:47.38,0:57:49.79,Default,,0,0,0,,- (Жүнді) Мен өзімді жақсы сезінбеймін - (Акино) А?
Dialogue: 0,0:57:49.88,0:57:55.05,Default,,0,0,0,,Сіз бүгін соншалықты летаргиялық көрінесіз.
Dialogue: 0,0:57:55.80,0:57:57.59,Default,,0,0,0,,Рождество мерекесі болса да
Dialogue: 0,0:58:03.43,0:58:07.44,Default,,0,0,0,,Тұтынушы шынымен бақытты болды ма?
Dialogue: 0,0:58:08.02,0:58:10.15,Default,,0,0,0,,Мен әрқашан сенімсізмін
Dialogue: 0,0:58:10.65,0:58:15.53,Default,,0,0,0,,Қызық, маған консьерж болып жұмыс істегенім дұрыс па?
Dialogue: 0,0:58:16.61,0:58:18.95,Default,,0,0,0,,Мен үшін де солай
Dialogue: 0,0:58:19.45,0:58:23.12,Default,,0,0,0,,Қызық, мен жасап жатқан нәрсенің мағынасы бар ма?
Dialogue: 0,0:58:23.20,0:58:24.91,Default,,0,0,0,,Кейде ойлаймын
Dialogue: 0,0:58:25.46,0:58:26.71,Default,,0,0,0,,Бұл...
Dialogue: 0,0:58:27.54,0:58:28.88,Default,,0,0,0,,Э? Не болып жатыр? Неге!?
Dialogue: 0,0:58:28.96,0:58:31.67,Default,,0,0,0,,Консьерж мырза, орындалды.
Dialogue: 0,0:58:31.75,0:58:33.84,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:58:34.59,0:58:36.80,Default,,0,0,0,,- (Барбар арыстаны) Иә - (Акино) Рахмет
Dialogue: 0,0:58:37.43,0:58:39.26,Default,,0,0,0,,Қараңдар, қараңдар!
Dialogue: 0,0:58:41.43,0:58:43.72,Default,,0,0,0,,Джонси, танысқаныма қуаныштымын!
Dialogue: 0,0:58:43.81,0:58:45.39,Default,,0,0,0,,Мен Тасермін
Dialogue: 0,0:58:45.48,0:58:48.69,Default,,0,0,0,,Бүгін мен Солтүстік полюс әмбебап дүкеніне алғаш рет келдім.
Dialogue: 0,0:58:48.77,0:58:51.77,Default,,0,0,0,,Рождестволық дүкеннің іші өте әдемі!
Dialogue: 0,0:58:51.86,0:58:54.61,Default,,0,0,0,,Менімен Солтүстік полюс әмбебап дүкеніндегі Рождество
Dialogue: 0,0:58:54.69,0:58:56.19,Default,,0,0,0,,Айналаға көз жүгіртейік
Dialogue: 0,0:58:57.15,0:59:00.66,Default,,0,0,0,,Бұл жаңа ғимараттағы косметикалық бренд бұрышы.
Dialogue: 0,0:59:01.62,0:59:04.24,Default,,0,0,0,,Қараңдар! Бұл түрлі-түсті косметика!
Dialogue: 0,0:59:04.33,0:59:06.62,Default,,0,0,0,,Джонси қандай түсті ұнатады?
Dialogue: 0,0:59:07.37,0:59:10.21,Default,,0,0,0,,Ал бұл парфюмерия бөлімі
Dialogue: 0,0:59:10.71,0:59:12.09,Default,,0,0,0,,Консьерждер
Dialogue: 0,0:59:12.17,0:59:15.38,Default,,0,0,0,,Ол менің асыл әтірімді тапты.
Dialogue: 0,0:59:15.88,0:59:18.97,Default,,0,0,0,,Бұл менің марқұм әжемнің сүйікті иісі.
Dialogue: 0,0:59:19.05,0:59:19.84,Default,,0,0,0,,Хехе
Dialogue: 0,0:59:20.68,0:59:24.14,Default,,0,0,0,,Бұл ұрланған затты әкем маған сатып алған жері.
Dialogue: 0,0:59:24.22,0:59:27.02,Default,,0,0,0,,Әкем үшін қалта сағаты жақсы емес пе?
Dialogue: 0,0:59:27.60,0:59:30.73,Default,,0,0,0,,Екеуміз бір әмбебап дүкенге бірдеңе сатып аламыз деп ойламаппын.
Dialogue: 0,0:59:30.81,0:59:33.86,Default,,0,0,0,,Мен консьержді дүрбелеңге салған сияқтымын.
Dialogue: 0,0:59:33.94,0:59:35.69,Default,,0,0,0,,Хахаха
Dialogue: 0,0:59:35.78,0:59:38.07,Default,,0,0,0,,Мен бүгін сенімен бірге дүкен аралауға келдім.
Dialogue: 0,0:59:38.15,0:59:40.82,Default,,0,0,0,,Кейде мен ата-анаммен, балаларыммен осылай уақыт өткізгім келеді.
Dialogue: 0,0:59:42.20,0:59:43.53,Default,,0,0,0,,Керемет көйлек...
Dialogue: 0,0:59:45.29,0:59:47.08,Default,,0,0,0,,Мен уәде бердім
Dialogue: 0,0:59:47.16,0:59:49.00,Default,,0,0,0,,Жыл сайын үйлену тойының мерейтойы
Dialogue: 0,0:59:49.08,0:59:51.50,Default,,0,0,0,,Осы мейрамханада тамақтанайық.
Dialogue: 0,0:59:52.46,0:59:54.50,Default,,0,0,0,,Бұл қандай әмбебап дүкен?
Dialogue: 0,0:59:54.59,0:59:57.55,Default,,0,0,0,,Мен үшін...
Dialogue: 0,0:59:58.30,1:00:01.38,Default,,0,0,0,,Менің ойымша, бұл жерде сізді ақырын артқа итеріп жіберетін адамдар бар.
Dialogue: 0,1:00:01.88,1:00:02.43,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:03.68,1:00:05.64,Default,,0,0,0,,- (Барбар арыстаны) Тори-сан! -иә?
Dialogue: 0,1:00:06.72,1:00:09.10,Default,,0,0,0,,Менің сізге өтінішім бар.
Dialogue: 0,1:00:09.18,1:00:10.31,Default,,0,0,0,,Өтінемін?
Dialogue: 0,1:00:10.39,1:00:12.10,Default,,0,0,0,,Біз мұны істей алмаймыз.
Dialogue: 0,1:00:13.23,1:00:14.23,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,1:00:14.31,1:00:15.52,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,1:00:15.61,1:00:17.44,Default,,0,0,0,,Сондықтан да талай рет айттым.
Dialogue: 0,1:00:17.53,1:00:19.61,Default,,0,0,0,,Ұлы аулар ұша алмайды!
Dialogue: 0,1:00:20.11,1:00:22.24,Default,,0,0,0,,Бұл консьерждің өтініші.
Dialogue: 0,1:00:22.32,1:00:23.03,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:23.11,1:00:25.83,Default,,0,0,0,,Солтүстік полюс әмбебап дүкені туралы керемет нәрселер
Dialogue: 0,1:00:25.91,1:00:29.83,Default,,0,0,0,,Мен оны бүгін осында бола алмайтын науқас тұтынушыға көрсеткім келді.
Dialogue: 0,1:00:34.33,1:00:37.42,Default,,0,0,0,,«Солтүстік полюс әмбебап дүкені не жақсы?»
Dialogue: 0,1:00:40.59,1:00:41.76,Default,,0,0,0,,Болашақ...
Dialogue: 0,1:00:55.36,1:00:56.23,Default,,0,0,0,,Не!
Dialogue: 0,1:01:01.57,1:01:02.11,Default,,0,0,0,,Ммм...
Dialogue: 0,1:01:24.93,1:01:25.76,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:01:33.56,1:01:37.98,Default,,0,0,0,,Әйеліме Солтүстік полюс әмбебап дүкені ұнады.
Dialogue: 0,1:01:38.82,1:01:40.98,Default,,0,0,0,,Бірақ сізге не ұнайды?
Dialogue: 0,1:01:41.07,1:01:43.99,Default,,0,0,0,,Қанша сұрасам да күліп:
Dialogue: 0,1:01:45.15,1:01:46.78,Default,,0,0,0,,«Барған кезде түсінесіз»
Dialogue: 0,1:01:48.66,1:01:52.58,Default,,0,0,0,,Солтүстік полюс әмбебап дүкені сізге не ұнайды?
Dialogue: 0,1:01:54.29,1:01:55.42,Default,,0,0,0,,Мен...
Dialogue: 0,1:01:56.92,1:02:01.38,Default,,0,0,0,,Біз дүкенге келген әрбір тұтынушыға күлкі сыйлағымыз келеді.
Dialogue: 0,1:02:03.34,1:02:05.80,Default,,0,0,0,,Кейбір тұтынушылар депрессияға ұшырады
Dialogue: 0,1:02:06.38,1:02:09.35,Default,,0,0,0,,Соңында сіз күлімсіреп үйге бара аласыз.
Dialogue: 0,1:02:10.39,1:02:13.85,Default,,0,0,0,,Маған арктикалық әмбебап дүкен ұнайды.
Dialogue: 0,1:02:15.73,1:02:16.35,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:02:17.48,1:02:18.60,Default,,0,0,0,,Мен осында болғым келеді
Dialogue: 0,1:02:19.81,1:02:22.94,Default,,0,0,0,,Мұнда тұтынушыға
Dialogue: 0,1:02:23.03,1:02:25.95,Default,,0,0,0,,Мен сізге ең жақсы қонақжайлылық көрсеткім келеді!
Dialogue: 0,1:02:27.24,1:02:30.24,Default,,0,0,0,,Түсінемін, бұл жақсы.
Dialogue: 0,1:02:30.32,1:02:31.41,Default,,0,0,0,,Хехе
Dialogue: 0,1:02:31.49,1:02:33.91,Default,,0,0,0,,Бұл Мистер Вулли!
Dialogue: 0,1:02:35.41,1:02:37.29,Default,,0,0,0,,Мен шынымен кешірім сұраймын
Dialogue: 0,1:02:41.75,1:02:42.59,Default,,0,0,0,,Бұл!
Dialogue: 0,1:02:43.59,1:02:48.30,Default,,0,0,0,,Мм... Мен Вулли мырзаның жанкүйерімін.
Dialogue: 0,1:02:48.38,1:02:51.05,Default,,0,0,0,,Кондитер аспазының шәкірті ретінде...
Dialogue: 0,1:02:51.64,1:02:53.76,Default,,0,0,0,,Маған консьерж айтты
Dialogue: 0,1:02:53.85,1:02:56.73,Default,,0,0,0,,Маған мейрамханадағылар көмектесті.
Dialogue: 0,1:02:57.81,1:02:58.73,Default,,0,0,0,,Ум...
Dialogue: 0,1:03:00.23,1:03:01.86,Default,,0,0,0,,Маған көрсете аласыз ба?
Dialogue: 0,1:03:12.83,1:03:13.53,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,1:03:14.91,1:03:16.20,Default,,0,0,0,,Әйеліммен...
Dialogue: 0,1:03:18.25,1:03:19.58,Default,,0,0,0,,Бұл менмін
Dialogue: 0,1:03:26.67,1:03:28.05,Default,,0,0,0,,Рахмет
Dialogue: 0,1:03:35.06,1:03:36.64,Default,,0,0,0,,Қандай тамаша көрініс.
Dialogue: 0,1:03:37.60,1:03:41.94,Default,,0,0,0,,Көптеген тұтынушылар біреуге сыйлық іздейді.
Dialogue: 0,1:03:42.44,1:03:46.40,Default,,0,0,0,,Бірақ бұл сізді шынымен бақытты ете ме, білмеймін.
Dialogue: 0,1:03:46.48,1:03:48.53,Default,,0,0,0,,Ешкім білмейді...
Dialogue: 0,1:03:49.57,1:03:51.24,Default,,0,0,0,,Бірақ менің ойымша
Dialogue: 0,1:03:51.74,1:03:55.28,Default,,0,0,0,,Өзі танымайтын адамға әрқашан қамқорлық жасайтын тұтынушыларға
Dialogue: 0,1:03:55.37,1:03:58.87,Default,,0,0,0,,Мен консьерждің қасыңызда мәңгі болғанын қалаймын.
Dialogue: 0,1:04:00.54,1:04:02.46,Default,,0,0,0,,Мен оған қарап тұрмын деп ойлаймын
Dialogue: 0,1:04:03.29,1:04:05.92,Default,,0,0,0,,«Мен біреудің бақытты болғанына қуаныштымын».
Dialogue: 0,1:04:06.67,1:04:10.34,Default,,0,0,0,,Кез келген адам осындай консьерж рухына ие болуы мүмкін.
Dialogue: 0,1:04:12.59,1:04:16.06,Default,,0,0,0,,Қалаудың ар жағындағы әмбебап дүкеннің арманы
Dialogue: 0,1:04:16.97,1:04:19.23,Default,,0,0,0,,Өзіңізді әдемі сезінетін не?
Dialogue: 0,1:04:19.73,1:04:22.98,Default,,0,0,0,,Мүмкін бұл менің тым адам болғанымнан шығар?
Dialogue: 0,1:04:23.86,1:04:30.74,Default,,0,0,0,,Оны осы әлемге байлап қою үшін—
Dialogue: 0,1:04:46.54,1:04:52.43,Default,,0,0,0,,(қатты шапалақтау)
Dialogue: 0,1:04:54.97,1:04:59.14,Default,,0,0,0,,Бізге келгеніңіз үшін рахмет.
Dialogue: 0,1:05:09.57,1:05:13.45,Default,,0,0,0,,Э-эй…
Dialogue: 0,1:05:26.25,1:05:28.71,Default,,0,0,0,,Мен, Акино, жұмыс...
Dialogue: 0,1:05:28.79,1:05:30.38,Default,,0,0,0,,Бұл әмбебап дүкенде бар
Dialogue: 0,1:05:34.26,1:05:35.80,Default,,0,0,0,,Кез келген жануар тұтынушы
Dialogue: 0,1:05:35.89,1:05:37.22,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:05:40.31,1:05:42.31,Default,,0,0,0,,Қанаттары бар жолаушылар
Dialogue: 0,1:05:42.39,1:05:44.69,Default,,0,0,0,,Тұяқты жолаушылар
Dialogue: 0,1:05:46.10,1:05:47.77,Default,,0,0,0,,Шағын тұтынушылар
Dialogue: 0,1:05:48.27,1:05:49.82,Default,,0,0,0,,Ірі тұтынушылар
Dialogue: 0,1:05:50.32,1:05:51.90,Default,,0,0,0,,Олардың кейбіреулері—
Dialogue: 0,1:05:51.98,1:05:54.78,Default,,0,0,0,,Тіпті сіз көрмеген тұтынушылар да сізді көруге келеді.
Dialogue: 0,1:05:55.49,1:05:58.41,Default,,0,0,0,,Ваа, уа... Кешіріңіз!
Dialogue: 0,1:05:59.66,1:06:00.70,Default,,0,0,0,,Уф...
Dialogue: 0,1:06:00.79,1:06:01.95,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:05.75,1:06:07.50,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:06:09.17,1:06:12.55,Default,,0,0,0,,Мен сізге көмектесе алатын нәрсе бар ма?
Dialogue: 0,1:06:13.92,1:06:16.34,Default,,0,0,0,,Сіздің әпкеңіз кім?
Dialogue: 0,1:06:17.55,1:06:18.93,Default,,0,0,0,,Мен...
Dialogue: 0,1:06:22.72,1:06:24.73,Default,,0,0,0,,♪～
