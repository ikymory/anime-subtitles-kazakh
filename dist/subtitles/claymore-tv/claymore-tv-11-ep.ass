Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.71,0:00:01.51,Default - Copy,Miria,0,0,0,,Кеттік
Dialogue: 0,0:00:02.05,0:00:03.21,Default - Copy,Miria,0,0,0,,Кешіктірмеңіз
Dialogue: 0,0:00:03.68,0:00:05.02,Default - Copy,Clare,0,0,0,,Бұл да.
Dialogue: 0,0:00:12.66,0:00:13.59,Default - Copy,yoma,0,0,0,,Ақымақ
Dialogue: 0,0:00:14.63,0:00:16.53,Default - Copy,yoma,0,0,0,,Мына жігіттерге
Dialogue: 0,0:00:17.03,0:00:19.80,Default - Copy,yoma,0,0,0,,Шит соусы
Dialogue: 0,0:00:24.04,0:00:25.44,Default - Copy,Helen,0,0,0,,Мен мұны істедім
Dialogue: 0,0:00:25.44,0:00:26.57,Default - Copy,Helen,0,0,0,,Мен мұны істедім
Dialogue: 0,0:00:38.15,0:00:39.22,Default - Copy,Miria,0,0,0,,Мүлдем
Dialogue: 0,0:00:39.95,0:00:41.79,Default - Copy,Miria,0,0,0,,Оның бүкіл денесінде жарақаттар бар.
Dialogue: 0,0:02:08.98,0:02:10.75,Default - Copy,Galatea,0,0,0,,Оянған адам қайтыс болды
Dialogue: 0,0:02:10.75,0:02:12.12,Default - Copy,Ermita,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:02:12.59,0:02:13.49,Default - Copy,Galatea,0,0,0,,Иә
Dialogue: 0,0:02:15.69,0:02:17.33,Default - Copy,Galatea,0,0,0,,Сіз қанағаттанбаған сияқтысыз.
Dialogue: 0,0:02:17.33,0:02:18.73,Default - Copy,Ermita,0,0,0,,Мүмкін емес
Dialogue: 0,0:02:19.16,0:02:20.76,Default - Copy,Ermita,0,0,0,,Бұл таң қалдырады
Dialogue: 0,0:02:21.33,0:02:23.93,Default - Copy,Ermita,0,0,0,,Сол оянған адам ерекше.
Dialogue: 0,0:02:24.47,0:02:27.34,Default - Copy,Ermita,0,0,0,,Мен оның бұлай тез ыдырайтынын күтпедім.
Dialogue: 0,0:02:27.74,0:02:30.17,Default - Copy,Galatea,0,0,0,,Бұл миссияның аяқталғанын білдіреді.
Dialogue: 0,0:02:30.81,0:02:33.18,Default - Copy,Ermita,0,0,0,,Олардың барлығы тірі ме?
Dialogue: 0,0:02:39.08,0:02:40.21,Default - Copy,Galatea,0,0,0,,Үш адам.
Dialogue: 0,0:02:41.12,0:02:45.06,Default - Copy,Galatea,0,0,0,,Егер басқа адам әлі тірі болса, ол өте әлсіз.
Dialogue: 0,0:02:45.06,0:02:48.42,Default - Copy,Ermita,0,0,0,,Жалғыз аман қалсаң ғажап болар еді.
Dialogue: 0,0:02:48.76,0:02:51.06,Default - Copy,Ermita,0,0,0,,Толығырақ қарастырайық.
Dialogue: 0,0:02:51.56,0:02:56.03,Default - Copy,Galatea,0,0,0,,Оянған аңшының серіктерінің өмірі мен өлімі соншалықты маңызды ма?
Dialogue: 0,0:02:56.60,0:02:59.57,Default - Copy,Ermita,0,0,0,,Ата-ананың баласына қамқор болғаны сияқты.
Dialogue: 0,0:03:00.40,0:03:01.60,Default - Copy,Galatea,0,0,0,,Мен көремін.
Dialogue: 0,0:03:09.28,0:03:10.08,Default - Copy,Helen,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:03:11.78,0:03:13.05,Default - Copy,Miria,0,0,0,,Бұл қиын.
Dialogue: 0,0:03:13.65,0:03:16.28,Default - Copy,Miria,0,0,0,,Қолымды қалпына келтіру үшін бар күшімді жұмсадым.
Dialogue: 0,0:03:16.65,0:03:18.92,Default - Copy,Miria,0,0,0,,Іштің регенерациясы жақсы жүрмейді
Dialogue: 0,0:03:20.09,0:03:22.39,Default - Copy,Miria,0,0,0,,Қалғаны адамның ерік-жігеріне байланысты.
Dialogue: 0,0:03:24.46,0:03:26.29,Default - Copy,Helen,0,0,0,,Сізде қиындықтар бар ма?
Dialogue: 0,0:03:26.96,0:03:28.80,Default - Copy,Helen,0,0,0,,Ең көп жеген болуы керек.
Dialogue: 0,0:03:28.80,0:03:33.03,Default - Copy,Miria,0,0,0,,Бірақ барлық маңызды бөліктерден аулақ болды.
Dialogue: 0,0:03:34.27,0:03:37.77,Default - Copy,Miria,0,0,0,,Бұлардың барлығы уақыт берілсе тез жазылатын жаралар.
Dialogue: 0,0:03:38.27,0:03:39.21,Default - Copy,Helen,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:42.54,0:03:44.68,Default - Copy,Helen,0,0,0,,Мұндай жағдай сол жағдайда болды.
Dialogue: 0,0:03:48.82,0:03:51.35,Default - Copy,Miria,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:03:51.35,0:03:52.55,Default - Copy,Helen,0,0,0,,Бұл не?
Dialogue: 0,0:03:55.02,0:04:00.09,Default - Copy,Miria,0,0,0,,Араларыңызда оятуға тырысқандар
Dialogue: 0,0:04:03.56,0:04:05.90,Default - Copy,Miria,0,0,0,,Бұл біз үшін маңызды
Dialogue: 0,0:04:06.43,0:04:09.10,Default - Copy,Miria,0,0,0,,Мүмкін болса, шынайы жауап беруіңізді қалаймын.
Dialogue: 0,0:04:11.07,0:04:12.31,Default - Copy,Clare,0,0,0,,Мен
Dialogue: 0,0:04:14.34,0:04:18.58,Default - Copy,Clare,0,0,0,,Өйткені мен жараланған денеммен сиқырлы күшімді негізсіз босатып жібердім.
Dialogue: 0,0:04:18.58,0:04:20.35,Default - Copy,Clare,0,0,0,,Шектерді қате бағалады
Dialogue: 0,0:04:24.39,0:04:26.39,Default - Copy,Miria,0,0,0,,Ояну жай ғана ауырсыну емес
Dialogue: 0,0:04:26.39,0:04:28.49,Default - Copy,Miria,0,0,0,,Ол көңіл күйде болса керек.
Dialogue: 0,0:04:28.92,0:04:31.79,Default - Copy,Miria,0,0,0,,Көптеген жауынгерлер оған қарсы тұра алмайды.
Dialogue: 0,0:04:31.79,0:04:35.53,Default - Copy,Clare,0,0,0,,Әй, қайтып оралғаным ғажап.
Dialogue: 0,0:04:37.33,0:04:38.63,Default - Copy,Helen,0,0,0,,Менде де бар.
Dialogue: 0,0:04:39.70,0:04:42.04,Default - Copy,Helen,0,0,0,,Көңіл-күйім түсіп, шектен шығып кеттім.
Dialogue: 0,0:04:42.47,0:04:43.91,Default - Copy,Helen,0,0,0,,Ер адамдармен бірдей
Dialogue: 0,0:04:44.31,0:04:46.74,Default - Copy,Helen,0,0,0,,Мен бұл құштарлыққа қарсы тұра алмадым.
Dialogue: 0,0:04:46.74,0:04:48.71,Default - Copy,Miria,0,0,0,,Бірақ мен қайтып келдім
Dialogue: 0,0:04:48.71,0:04:51.18,Default - Copy,Helen,0,0,0,,Қандай да бір жолмен өзіңізді қайтарыңыз
Dialogue: 0,0:04:52.05,0:04:53.85,Default - Copy,Helen,0,0,0,,Денев те болуы керек.
Dialogue: 0,0:04:54.62,0:04:58.59,Default - Copy,Helen,0,0,0,,Оның жағдайында ол өз шегін білгісі келген сияқты.
Dialogue: 0,0:04:59.29,0:05:01.32,Default - Copy,Miria,0,0,0,,Денев қартайды ма?
Dialogue: 0,0:05:01.32,0:05:03.59,Default - Copy,Helen,0,0,0,,Ах, бұл синхронды.
Dialogue: 0,0:05:05.03,0:05:06.26,Default - Copy,Miria,0,0,0,,Мен сізден сұрайын
Dialogue: 0,0:05:06.59,0:05:11.70,Default - Copy,Miria,0,0,0,,Екеуіңізде клиенттермен немесе қарапайым адамдармен қиындықтар болды ма?
Dialogue: 0,0:05:13.50,0:05:16.94,Default - Copy,Helen,0,0,0,,Маа, менде осындай мінез бар.
Dialogue: 0,0:05:16.94,0:05:18.21,Default - Copy,Helen,0,0,0,,Кейде
Dialogue: 0,0:05:19.51,0:05:20.34,Default - Copy,Miria,0,0,0,,Денев
Dialogue: 0,0:05:21.21,0:05:24.91,Default - Copy,Helen,0,0,0,,Бұл жігіт өзіне және басқаларға қатысты перфекционист.
Dialogue: 0,0:05:24.91,0:05:27.45,Default - Copy,Helen,0,0,0,,Қарапайым адамдарға қарағанда дос сияқты
Dialogue: 0,0:05:27.92,0:05:28.98,Default - Copy,Miria,0,0,0,,Мен көремін.
Dialogue: 0,0:05:29.42,0:05:31.99,Default - Copy,Miria,0,0,0,,Ал екіншісі нұсқауларды орындамады
Dialogue: 0,0:05:31.99,0:05:34.62,Default - Copy,Miria,0,0,0,,Бұл бақылаудан шығатын ең төменгі сан ба?
Dialogue: 0,0:05:35.59,0:05:39.03,Default - Copy,Miria,0,0,0,,Олардың барлығы оянған проблемалы балалар.
Dialogue: 0,0:05:40.46,0:05:42.03,Default - Copy,Helen,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:05:42.40,0:05:45.27,Default - Copy,Miria,0,0,0,,Кездейсоқ проблемалық балалар жинағы
Dialogue: 0,0:05:45.27,0:05:47.17,Default - Copy,Miria,0,0,0,,Кездейсоқ ақпарат қатесі
Dialogue: 0,0:05:47.17,0:05:51.04,Default - Copy,Miria,0,0,0,,Мен кездейсоқ оянған адаммен төбелесіп қалдым.
Dialogue: 0,0:05:52.01,0:05:53.78,Default - Copy,Helen,0,0,0,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:05:53.78,0:05:56.04,Default - Copy,Helen,0,0,0,,Бұл ұйым сияқты
Dialogue: 0,0:05:56.04,0:05:57.81,Default - Copy,Miria,0,0,0,,Бұл жай ғана гипотеза.
Dialogue: 0,0:05:58.28,0:06:00.35,Default - Copy,Clare,0,0,0,,Мирия, сен ше?
Dialogue: 0,0:06:00.85,0:06:03.62,Default - Copy,Clare,0,0,0,,Оянғанды ​​былай қойғанда, ол проблемалық балаға ұқсамайды.
Dialogue: 0,0:06:05.09,0:06:08.86,Default - Copy,Miria,0,0,0,,Ол шартқа менен артық ешкім сәйкес келмейді.
Dialogue: 0,0:06:14.86,0:06:17.60,Default - Copy,Miria,0,0,0,,Мен де оятуды орнаттым.
Dialogue: 0,0:06:18.10,0:06:19.60,Default - Copy,Helen,0,0,0,,Сіз
Dialogue: 0,0:06:20.27,0:06:22.87,Default - Copy,Miria,0,0,0,,Оянғандарды үшінші рет аулайтын кез келді.
Dialogue: 0,0:06:23.60,0:06:27.44,Default - Copy,Miria,0,0,0,,Шайқас біткеннен кейін мен оның ескі досым екенін түсіндім.
Dialogue: 0,0:06:48.70,0:06:50.73,Default - Copy,Miria,0,0,0,,Хилда болмайды
Dialogue: 0,0:06:56.57,0:06:59.04,Default - Copy,clay1,0,0,0,,Ол сіздің әріптесіңіз болғанына сенімдімін.
Dialogue: 0,0:06:59.44,0:07:02.54,Default - Copy,clay1,0,0,0,,Ұйымнан ештеңе естіген жоқсыз ба?
Dialogue: 0,0:07:08.18,0:07:09.05,Default - Copy,Miria,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:07:10.95,0:07:11.85,Default - Copy,Miria,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:07:12.45,0:07:14.49,Default - Copy,Miria,0,0,0,,Неге менің атымды атамадың?
Dialogue: 0,0:07:15.02,0:07:18.63,Default - Copy,Miria,0,0,0,,Неге, неге маған сен екеніңді айтпадың?
Dialogue: 0,0:07:18.53,0:07:19.69,Default - Copy,Miria,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:07:19.69,0:07:21.03,Default - Copy,Miria,0,0,0,,Неліктен Хилда?
Dialogue: 0,0:07:21.53,0:07:22.60,Default - Copy,Miria,0,0,0,,Хилда
Dialogue: 0,0:07:26.10,0:07:27.47,Default - Copy,clay2,0,0,0,,Көп ойланбаңыз
Dialogue: 0,0:07:27.94,0:07:30.37,Default - Copy,clay2,0,0,0,,Оның адам санасы болған жоқ.
Dialogue: 0,0:07:30.91,0:07:32.71,Default - Copy,clay2,0,0,0,,Бұл құбыжық.
Dialogue: 0,0:07:51.13,0:07:53.19,Default - Copy,clay2,0,0,0,,Жаман рухтар ұшады
Dialogue: 0,0:07:53.19,0:07:54.20,Default - Copy,clay2,0,0,0,,Милия
Dialogue: 0,0:07:55.16,0:07:56.30,Default - Copy,Ophelia,0,0,0,,Елес Мирияның қалай оянғаны қызық.
Dialogue: 0,0:07:56.30,0:07:59.80,Default - Copy,Ophelia,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:07:59.80,0:08:00.57,Default - Copy,clay2,0,0,0,,Егер бұл командалық күрес болса
Dialogue: 0,0:08:01.34,0:08:05.84,Default - Copy,Ophelia,0,0,0,,Оның саны 1 немесе одан жоғары деп айтылады.
Dialogue: 0,0:08:05.84,0:08:07.94,Default - Copy,Ophelia,0,0,0,,Мен міндетті түрде төбелескім келеді.
Dialogue: 0,0:08:08.34,0:08:09.68,Default - Copy,clay1,0,0,0,,Не
Dialogue: 0,0:08:15.68,0:08:17.42,Default - Copy,Ophelia,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:17.99,0:08:20.69,Default - Copy,Ophelia,0,0,0,,Тез оян!
Dialogue: 0,0:08:32.97,0:08:36.27,Default - Copy,Helen,0,0,0,,. . Ол кезде мен оянудың қажеті жоқ еді.
Dialogue: 0,0:08:37.17,0:08:39.91,Default - Copy,Miria,0,0,0,,Мен өз шегімнен асып кеткенімді білдім, бірақ
Dialogue: 0,0:08:39.91,0:08:41.44,Default - Copy,Miria,0,0,0,,Қатты басылған
Dialogue: 0,0:08:42.18,0:08:45.95,Default - Copy,Miria,0,0,0,,Мүмкін оның арандатуын пайдаланбауға ерік-жігері болған шығар.
Dialogue: 0,0:08:46.41,0:08:47.45,Default - Copy,Clare,0,0,0,,Үлкен ағам сені қорғап қалар еді,
Dialogue: 0,0:08:49.15,0:08:50.89,Default - Copy,Miria,0,0,0,,Жоқ, мен бұл туралы айтып отырмын.
Dialogue: 0,0:08:51.79,0:08:56.69,Default - Copy,Miria,0,0,0,,Әйтеуір, сол сәтте ұйымнан кек алуға бел байладым.
Dialogue: 0,0:08:58.29,0:08:59.96,Default - Copy,Miria,0,0,0,,Осындай денемен
Dialogue: 0,0:09:00.33,0:09:03.70,Default - Copy,Miria,0,0,0,,Соңында, кейбір ұйымдар оны бір рет қолданылатын сияқты кәдеге жаратады.
Dialogue: 0,0:09:03.70,0:09:05.17,Default - Copy,Miria,0,0,0,,Кешіре алмадым
Dialogue: 0,0:09:05.17,0:09:08.04,Default - Copy,Helen,0,0,0,,Бірақ кек алу туралы не деуге болады?
Dialogue: 0,0:09:08.80,0:09:12.27,Default - Copy,Miria,0,0,0,,Ұйымға мойынсұнғыш болып көріну
Dialogue: 0,0:09:12.27,0:09:14.21,Default - Copy,Miria,0,0,0,,Мен әртүрлі нәрселерді зерттеймін.
Dialogue: 0,0:09:14.54,0:09:16.41,Default - Copy,Helen,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:09:17.35,0:09:19.35,Default - Copy,Miria,0,0,0,,Әлі жоқ
Dialogue: 0,0:09:19.35,0:09:21.82,Default - Copy,Miria,0,0,0,,Ұйым үшін шулы болуы мүмкін.
Dialogue: 0,0:09:22.58,0:09:26.72,Default - Copy,Clare,0,0,0,,Бұл оның жазаға тартылғанын білдіре ме?
Dialogue: 0,0:09:27.76,0:09:29.49,Default - Copy,Miria,0,0,0,,Жоғарыда айтқанымдай
Dialogue: 0,0:09:29.49,0:09:31.83,Default - Copy,Miria,0,0,0,,Бұл жай ғана гипотеза.
Dialogue: 0,0:09:37.50,0:09:39.17,Default - Copy,Clare,0,0,0,,Сол бетті таққандықтан бәрін жеп қойды.
Dialogue: 0,0:09:39.67,0:09:44.57,Default - Copy,Clare,0,0,0,,Бізді ояту арқылы біз бірдеңені өзгерттік пе?
Dialogue: 0,0:09:46.37,0:09:48.38,Default - Copy,Miria,0,0,0,,Мұны сұрау нені білдіреді?
Dialogue: 0,0:09:48.71,0:09:50.65,Default - Copy,Miria,0,0,0,,Сіз бірдеңені сезіп тұрған шығарсыз.
Dialogue: 0,0:09:52.51,0:09:55.22,Default - Copy,Miria,0,0,0,,Оянуға дейін және кейін
Dialogue: 0,0:09:55.22,0:09:58.12,Default - Copy,Miria,0,0,0,,Жындық табиғаты басқаша екені анық.
Dialogue: 0,0:09:58.95,0:10:01.89,Default - Copy,Miria,0,0,0,,Бұрынғыдан айырмашылығы анық емес шекті нүкте
Dialogue: 0,0:10:01.89,0:10:06.89,Default - Copy,Miria,0,0,0,,Анда-санда пайда болатын күшті аштық сезімі, солай емес пе?
Dialogue: 0,0:10:09.26,0:10:11.13,Default - Copy,Miria,0,0,0,,Бізде бар
Dialogue: 0,0:10:12.13,0:10:14.00,Default - Copy,Miria,0,0,0,,Мен ояумын.
Dialogue: 0,0:10:15.90,0:10:17.07,Default - Copy,Clare,0,0,0,,Біз
Dialogue: 0,0:10:17.77,0:10:19.01,Default - Copy,Clare,0,0,0,,Оянды
Dialogue: 0,0:10:27.05,0:10:28.32,Default - Copy,Ermita,0,0,0,,Не болды?
Dialogue: 0,0:10:28.32,0:10:30.12,Default - Copy,Galatea,0,0,0,,Рух бұзылады
Dialogue: 0,0:10:30.12,0:10:34.56,Default - Copy,Galatea,0,0,0,,Ол мені қатты мистикалық рухпен ренжітетін бірдеңе айтқан сияқты.
Dialogue: 0,0:10:34.99,0:10:39.23,Default - Copy,Galatea,0,0,0,,Орташа жұмбақ адам жоғары эмоциямен наразылық білдіреді.
Dialogue: 0,0:10:39.23,0:10:42.06,Default - Copy,Galatea,0,0,0,,Кішкентай құбыжықтар салыстырмалы түрде тыныш.
Dialogue: 0,0:10:42.46,0:10:43.03,Default - Copy,Galatea,0,0,0,,Жоқ
Dialogue: 0,0:10:44.77,0:10:46.87,Default - Copy,Galatea,0,0,0,,Мен қатты ренжідім.
Dialogue: 0,0:10:47.54,0:10:49.57,Default - Copy,Galatea,0,0,0,,Оны көрсетпеу
Dialogue: 0,0:10:49.90,0:10:51.57,Default - Copy,Galatea,0,0,0,,Өткенде не болды?
Dialogue: 0,0:10:51.57,0:10:54.24,Default - Copy,Galatea,0,0,0,,Жүрегіңізді сыртқы әлемге жауып жатырсыз ба?
Dialogue: 0,0:10:55.81,0:10:57.91,Default - Copy,Ermita,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:10:58.38,0:11:01.85,Default - Copy,Ermita,0,0,0,,Сіз соншалықты алыс жерден айта аласыз ба?
Dialogue: 0,0:11:03.99,0:11:05.42,Default - Copy,Helen,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:11:05.42,0:11:07.46,Default - Copy,Helen,0,0,0,,Ондай құбыжықпен өмір сүрме.
Dialogue: 0,0:11:07.92,0:11:10.36,Default - Copy,Helen,0,0,0,,Мен ол құбыжық болған жоқпын.
Dialogue: 0,0:11:10.36,0:11:12.56,Default - Copy,Helen,0,0,0,,Адамдар кетпейді деп ойлаймын.
Dialogue: 0,0:11:12.89,0:11:15.33,Default - Copy,Helen,0,0,0,,Мен ешқашан оянбаймын
Dialogue: 0,0:11:15.33,0:11:17.23,Default - Copy,Miria,0,0,0,,Бұл жаман сөз болды.
Dialogue: 0,0:11:17.57,0:11:20.54,Default - Copy,Miria,0,0,0,,Ояну толық ояну емес.
Dialogue: 0,0:11:21.00,0:11:23.34,Default - Copy,Miria,0,0,0,,Бұл жартылай ояу күй сияқты.
Dialogue: 0,0:11:23.34,0:11:25.57,Default - Copy,Helen,0,0,0,,Жартылай ояу
Dialogue: 0,0:11:25.91,0:11:28.54,Default - Copy,Miria,0,0,0,,Әдетте мен бірден оянатынмын.
Dialogue: 0,0:11:28.54,0:11:30.61,Default - Copy,Miria,0,0,0,,Орта жолда тоқтатылған күй
Dialogue: 0,0:11:31.05,0:11:34.58,Default - Copy,Miria,0,0,0,,Немесе оянуды баяу жалғастыру күйі.
Dialogue: 0,0:11:34.58,0:11:36.82,Default - Copy,Helen,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:11:37.15,0:11:39.39,Default - Copy,Miria,0,0,0,,Қолдың созылуы және жиырылуы
Dialogue: 0,0:11:39.39,0:11:42.12,Default - Copy,Miria,0,0,0,,Мен оны шайқаста еш қиындықсыз пайдалана алдым.
Dialogue: 0,0:11:42.12,0:11:44.83,Default - Copy,Miria,0,0,0,,Оянғаннан кейін емес пе?
Dialogue: 0,0:11:46.39,0:11:49.03,Default - Copy,Miria,0,0,0,,Деневтің регенерация қабілетіне де қатысты.
Dialogue: 0,0:11:49.03,0:11:51.27,Default - Copy,Miria,0,0,0,,Егер шын болса, бұл тек шекті.
Dialogue: 0,0:11:51.27,0:11:53.17,Default - Copy,Miria,0,0,0,,Бұл қайта-қайта жасай алатын нәрсе емес.
Dialogue: 0,0:11:54.27,0:11:57.34,Default - Copy,Miria,0,0,0,,Шектен асқаннан кейін бастапқы күйге оралу мүмкін емес.
Dialogue: 0,0:11:57.94,0:11:59.84,Default - Copy,Miria,0,0,0,,Шындығында бұл мүмкін емес.
Dialogue: 0,0:12:02.24,0:12:03.34,Default - Copy,Deneve,0,0,0,,Мен көремін.
Dialogue: 0,0:12:04.21,0:12:06.85,Default - Copy,Deneve,0,0,0,,Мұның бәрі менің есімде.
Dialogue: 0,0:12:07.55,0:12:08.58,Default - Copy,Helen,0,0,0,,Денев
Dialogue: 0,0:12:08.58,0:12:12.59,Default - Copy,Deneve,0,0,0,,Иә. . Сонда мен жартылай ояу күйде екенімді түсіндім.
Dialogue: 0,0:12:13.12,0:12:15.52,Default - Copy,Deneve,0,0,0,,Бұдан кейін бізге не болады?
Dialogue: 0,0:12:16.02,0:12:20.60,Default - Copy,Deneve,0,0,0,,Саусағыңызды аузыңызға алып, оның толық оянғанын күтесіз бе?
Dialogue: 0,0:12:23.50,0:12:26.90,Default - Copy,Miria,0,0,0,,Кешіріңіз, мен одан артық ештеңе білмеймін.
Dialogue: 0,0:12:27.47,0:12:28.90,Default - Copy,Miria,0,0,0,,Мен айта аламын
Dialogue: 0,0:12:28.90,0:12:34.54,Default - Copy,Miria,0,0,0,,Біз қандай жағдайда оянатынымызды білмейміз. Бұл қауіпті жағдай екенін ғана айта аламыз.
Dialogue: 0,0:12:38.95,0:12:40.31,Default - Copy,Deneve,0,0,0,,Жарайды.
Dialogue: 0,0:12:40.31,0:12:41.72,Default - Copy,Deneve,0,0,0,,Өтіп бара жатыр, өтіп бара жатыр
Dialogue: 0,0:12:41.72,0:12:42.68,Default - Copy,Deneve,0,0,0,,Бұл эксперимент.
Dialogue: 0,0:12:47.96,0:12:49.02,Default - Copy,Helen,0,0,0,,Денев
Dialogue: 0,0:12:51.96,0:12:53.29,Default - Copy,Miria,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:12:53.29,0:12:54.53,Default - Copy,Miria,0,0,0,,Тоқта, Денев.
Dialogue: 0,0:12:54.96,0:12:56.86,Default - Copy,Deneve,0,0,0,,Жарайды, үніңді жап, қарап тұр.
Dialogue: 0,0:12:57.93,0:13:01.94,Default - Copy,Deneve,0,0,0,,Егер сіз шекті сақтай отырып, регенерацияны жалғастырсаңыз да, сіз тек өлесіз.
Dialogue: 0,0:13:02.04,0:13:05.44,Default - Copy,Deneve,0,0,0,,Олай болса сиқырлы күштеріңізді барынша пайдаланыңыз
Dialogue: 0,0:13:05.44,0:13:07.11,Default - Copy,Deneve,0,0,0,,Лезде ойнаңыз
Dialogue: 0,0:13:09.04,0:13:10.25,Default - Copy,Helen,0,0,0,,Бұл ақылға қонымсыз
Dialogue: 0,0:13:10.14,0:13:12.01,Default - Copy,Helen,0,0,0,,Егер сіздің денеңіз өз шегінен асып кетсе
Dialogue: 0,0:13:12.01,0:13:14.35,Default - Copy,Deneve,0,0,0,,Егер Мирия дұрыс айтса
Dialogue: 0,0:13:14.35,0:13:17.59,Default - Copy,Deneve,0,0,0,,Біз шектен асып кеттік.
Dialogue: 0,0:13:17.59,0:13:20.05,Default - Copy,Deneve,0,0,0,,Бұл жағдайда, сиқырлы күшті бірден қолдансаңыз да,
Dialogue: 0,0:13:20.05,0:13:23.09,Default - Copy,Deneve,0,0,0,,Оянбай қайту мүмкіндігі болуы керек.
Dialogue: 0,0:13:23.86,0:13:28.63,Default - Copy,Deneve,0,0,0,,Бірақ толық ояу болсаңыз
Dialogue: 0,0:13:28.96,0:13:31.87,Default - Copy,Deneve,0,0,0,,Мені өлтіруден тартынба
Dialogue: 0,0:13:32.30,0:13:33.23,Default - Copy,Miria,0,0,0,,Не
Dialogue: 0,0:13:34.90,0:13:36.10,Default - Copy,Helen,0,0,0,,Денев
Dialogue: 0,0:13:38.97,0:13:40.54,Default - Copy,Miria,0,0,0,,Хелен Клэр
Dialogue: 0,0:13:41.41,0:13:43.21,Default - Copy,Helen,0,0,0,,Синхронизацияның артықшылықтары
Dialogue: 0,0:13:43.71,0:13:45.48,Default - Copy,Helen,0,0,0,,Мен сені қиналмай өлуге рұқсат етемін.
Dialogue: 0,0:13:45.98,0:13:46.98,Default - Copy,Clare,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:13:47.48,0:13:49.25,Default - Copy,Clare,0,0,0,,Ешқандай қателік жібермеймін.
Dialogue: 0,0:14:11.74,0:14:13.34,Default - Copy,Galatea,0,0,0,,Жалғыз оянған
Dialogue: 0,0:14:13.98,0:14:14.78,Default - Copy,Ermita,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:14:15.31,0:14:18.31,Default - Copy,Galatea,0,0,0,,Мен өз еркіммен оянғандай сезінемін.
Dialogue: 0,0:14:18.31,0:14:19.61,Default - Copy,Galatea,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:14:20.28,0:14:23.99,Default - Copy,Ermita,0,0,0,,Менің ойымша, сіз шайқастағы зақымға байланысты шекті дұрыс бағалағансыз.
Dialogue: 0,0:14:23.99,0:14:25.79,Default - Copy,Ermita,0,0,0,,Бұл өкінішті.
Dialogue: 0,0:14:26.72,0:14:27.96,Default - Copy,Galatea,0,0,0,,Жақсы ма?
Dialogue: 0,0:14:27.96,0:14:30.76,Default - Copy,Galatea,0,0,0,,Оны өз балаңдай ойламайсың ба?
Dialogue: 0,0:14:31.63,0:14:35.26,Default - Copy,Ermita,0,0,0,,Менің баламды құбыжық еткенім есімде жоқ.
Dialogue: 0,0:14:46.21,0:14:49.04,Default - Copy,Deneve,0,0,0,,Сіз қайтып келген сияқтысыз.
Dialogue: 0,0:14:49.41,0:14:50.31,Default - Copy,Helen,0,0,0,,Денев
Dialogue: 0,0:14:57.42,0:14:58.55,Default - Copy,Miria,0,0,0,,Мүлдем
Dialogue: 0,0:14:58.55,0:14:59.92,Default - Copy,Miria,0,0,0,,абайсызда әрекет ету
Dialogue: 0,0:14:59.92,0:15:00.82,Default - Copy,Helen,0,0,0,,Іші
Dialogue: 0,0:15:00.82,0:15:02.06,Default - Copy,Helen,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:15:02.99,0:15:06.33,Default - Copy,Deneve,0,0,0,,Әй, әйтеуір бұғатталып қалды.
Dialogue: 0,0:15:07.26,0:15:09.53,Default - Copy,Miria,0,0,0,,Келесі жолы қайтуыңызға кепілдік жоқ.
Dialogue: 0,0:15:09.53,0:15:11.83,Default - Copy,Miria,0,0,0,,Адам санасын сақтағың келсе
Dialogue: 0,0:15:11.83,0:15:14.24,Default - Copy,Miria,0,0,0,,Тым абай болмаңыз.
Dialogue: 0,0:15:14.24,0:15:15.87,Default - Copy,Deneve,0,0,0,,Түсінгенше көрсетемін
Dialogue: 0,0:15:16.27,0:15:19.47,Default - Copy,Deneve,0,0,0,,Менің де бұлай қайта жіппен жүргім келмейді.
Dialogue: 0,0:15:25.35,0:15:26.18,Default - Copy,Miria,0,0,0,,Не болды?
Dialogue: 0,0:15:26.91,0:15:28.98,Default - Copy,Clare,0,0,0,,Мені біреу бақылап тұрғандай сезіндім.
Dialogue: 0,0:15:29.95,0:15:31.75,Default - Copy,Miria,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:15:31.75,0:15:33.96,Default - Copy,Miria,0,0,0,,Мен де айналаны зерттедім.
Dialogue: 0,0:15:33.96,0:15:36.96,Default - Copy,Miria,0,0,0,,Менің серіктерімнен бір тау болса да белгі жоқ.
Dialogue: 0,0:15:37.43,0:15:39.49,Default - Copy,Miria,0,0,0,,Егер сіз осы нүктеден тыс болсаңыз да
Dialogue: 0,0:15:39.49,0:15:42.96,Default - Copy,Miria,0,0,0,,Біздің бар екенімізді әрең байқау сізге байланысты.
Dialogue: 0,0:15:45.03,0:15:46.97,Default - Copy,Clare,0,0,0,,Бұл менің қиялым ғана ма?
Dialogue: 0,0:15:50.27,0:15:53.27,Default - Copy,Galatea,0,0,0,,Осы қашықтықта мені біреу байқайды ма?
Dialogue: 0,0:15:56.58,0:15:59.08,Default - Copy,Galatea,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:15:59.55,0:16:02.92,Default - Copy,Galatea,0,0,0,,Оянғандай көрінген адамның жындық қуаты тұрақтанды.
Dialogue: 0,0:16:03.58,0:16:05.79,Default - Copy,Ermita,0,0,0,,Ей, не болып жатыр?
Dialogue: 0,0:16:05.79,0:16:07.62,Default - Copy,Ermita,0,0,0,,Әлі бірдеңе болды ма?
Dialogue: 0,0:16:07.62,0:16:11.16,Default - Copy,Galatea,0,0,0,,Жоқ, ояну менің тарапымнан түсінбеушілік сияқты.
Dialogue: 0,0:16:11.56,0:16:13.06,Default - Copy,Galatea,0,0,0,,Төртеуі де қауіпсіз.
Dialogue: 0,0:16:13.43,0:16:15.06,Default - Copy,Ermita,0,0,0,,Түсінбеу
Dialogue: 0,0:16:15.06,0:16:17.20,Default - Copy,Ermita,0,0,0,,Бұл сіз үшін әдеттен тыс.
Dialogue: 0,0:16:17.53,0:16:21.94,Default - Copy,Galatea,0,0,0,,Мен тіпті бұл қашықтықтан нақты ақпарат ала алмаймын.
Dialogue: 0,0:16:22.50,0:16:26.71,Default - Copy,Galatea,0,0,0,,Баласын алыстан бақылайтын ата-ана қалыпты болды.
Dialogue: 0,0:16:27.81,0:16:28.91,Default - Copy,Ermita,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:16:28.91,0:16:31.41,Default - Copy,Ermita,0,0,0,,Төрт жынды есіңе түсір
Dialogue: 0,0:16:31.41,0:16:35.68,Default - Copy,Ermita,0,0,0,,Бір күні біздің жолдарымыз қиылысуы мүмкін.
Dialogue: 0,0:16:36.55,0:16:37.82,Default - Copy,Galatea,0,0,0,,Ата-ана ата-ана
Dialogue: 0,0:16:37.82,0:16:39.92,Default - Copy,Galatea,0,0,0,,Қабан әке дейсіз бе?
Dialogue: 0,0:16:41.96,0:16:44.03,Default - Copy,Miria,0,0,0,,Біз осында тараймыз.
Dialogue: 0,0:16:44.03,0:16:45.99,Default - Copy,Miria,0,0,0,,Тиісті тапсырмаларға оралыңыз.
Dialogue: 0,0:16:46.49,0:16:49.23,Default - Copy,Miria,0,0,0,,Біз берілген тапсырманы орындадық.
Dialogue: 0,0:16:49.63,0:16:51.53,Default - Copy,Miria,0,0,0,,Басқа ештеңе болған жоқ
Dialogue: 0,0:16:52.00,0:16:53.00,Default - Copy,Miria,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:16:53.50,0:16:58.25,Default - Copy,Deneve,0,0,0,,Біз ұйымның сұрақтарымыз барын білгенін қаламаймыз.
Dialogue: 0,0:16:58.25,0:17:03.48,Default - Copy,Miria,0,0,0,,Дұрыс. Бұдан былай ұйымға күдіктенбейтін дәрежеде мойынсұныңыз.
Dialogue: 0,0:17:03.48,0:17:06.01,Default - Copy,Miria,0,0,0,,Проблемалық бала бейнесінен арылыңыз
Dialogue: 0,0:17:06.45,0:17:08.22,Default - Copy,Helen,0,0,0,,Қандай азап
Dialogue: 0,0:17:08.22,0:17:11.49,Default - Copy,Miria,0,0,0,,Әр нәрседе сақ болу қажеттілігі
Dialogue: 0,0:17:11.92,0:17:14.96,Default - Copy,Miria,0,0,0,,Егер сіз мұны істесеңіз, біраз уақытқа жетуге болады.
Dialogue: 0,0:17:15.36,0:17:16.92,Default - Copy,Helen,0,0,0,,Біраз уақытқа
Dialogue: 0,0:17:17.73,0:17:19.09,Default - Copy,Miria,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:17:19.63,0:17:23.20,Default - Copy,Miria,0,0,0,,Ояну арқылы қабілеттерің артты.
Dialogue: 0,0:17:23.60,0:17:27.17,Default - Copy,Miria,0,0,0,,Әрбір сан бір таңбалы санға эквивалент деп айтуға болады.
Dialogue: 0,0:17:27.97,0:17:29.04,Default - Copy,Deneve,0,0,0,,Мен көремін.
Dialogue: 0,0:17:29.67,0:17:30.91,Default - Copy,Helen,0,0,0,,Мен оны шынымен сезіне алмаймын.
Dialogue: 0,0:17:31.27,0:17:33.11,Default - Copy,Miria,0,0,0,,Мен кепілдік беремін
Dialogue: 0,0:17:33.11,0:17:35.64,Default - Copy,Miria,0,0,0,,Достарыммен төбелесу керек болса да
Dialogue: 0,0:17:35.64,0:17:37.95,Default - Copy,Miria,0,0,0,,Мен соншалықты артта қалмауым керек еді.
Dialogue: 0,0:17:38.51,0:17:41.65,Default - Copy,Miria,0,0,0,,Алайда 5 және одан жоғары сандар әртүрлі.
Dialogue: 0,0:17:42.22,0:17:46.39,Default - Copy,Miria,0,0,0,,Егер сіз бұл жігіттерді кездестірсеңіз, алдымен төбелесу мүмкіндігін тастаңыз.
Dialogue: 0,0:17:47.09,0:17:49.16,Default - Copy,Helen,0,0,0,,5-тен көп емес
Dialogue: 0,0:17:49.16,0:17:51.63,Default - Copy,Helen,0,0,0,,Бұл Мириядан жақсы екенін білдіреді.
Dialogue: 0,0:17:51.63,0:17:53.36,Default - Copy,Miria,0,0,0,,Ең жақсы емес
Dialogue: 0,0:17:53.70,0:17:59.90,Default - Copy,Miria,0,0,0,,Шынымды айтсам, 5 саны мен 6 санының арасында үлкен қабырға бар деп ойлағаныңызды қалаймын.
Dialogue: 0,0:18:00.37,0:18:01.50,Default - Copy,Helen,0,0,0,,Бұл рас па?
Dialogue: 0,0:18:13.98,0:18:15.78,Default - Copy,Miria,0,0,0,,Бұл ең үздік бес адамның белгісі.
Dialogue: 0,0:18:16.18,0:18:17.52,Default - Copy,Miria,0,0,0,,Есте сақта
Dialogue: 0,0:18:18.49,0:18:19.62,Default - Copy,Miria,0,0,0,,Оң жақтан
Dialogue: 0,0:18:19.62,0:18:21.72,Default - Copy,Miria,0,0,0,,№1 Алисия
Dialogue: 0,0:18:22.32,0:18:24.09,Default - Copy,Miria,0,0,0,,№2 Бет
Dialogue: 0,0:18:24.76,0:18:27.03,Default - Copy,Miria,0,0,0,,№3 Галатея
Dialogue: 0,0:18:27.80,0:18:29.26,Default - Copy,Miria,0,0,0,,№ 4
Dialogue: 0,0:18:31.67,0:18:34.00,Default - Copy,Clare,0,0,0,,Санға не болды?
Dialogue: 0,0:18:35.04,0:18:38.77,Default - Copy,Miria,0,0,0,,Ол достарының немесе басқа адамдардың өмірін ойламайды.
Dialogue: 0,0:18:39.34,0:18:43.01,Default - Copy,Miria,0,0,0,,Әсіресе оянған адамдарды аң аулауға құмар.
Dialogue: 0,0:18:43.01,0:18:44.18,Default - Copy,Deneve,0,0,0,,Мен көремін.
Dialogue: 0,0:18:44.61,0:18:47.52,Default - Copy,Deneve,0,0,0,,Олай болса біз алыс болуымыз керек.
Dialogue: 0,0:18:47.85,0:18:48.38,Default - Copy,Miria,0,0,0,,А
Dialogue: 0,0:18:48.75,0:18:51.15,Default - Copy,Miria,0,0,0,,Табиғи емес болса да, жанасудан аулақ болыңыз.
Dialogue: 0,0:18:51.75,0:18:55.76,Default - Copy,Miria,0,0,0,,Ұрысқанды, қан төгуді бәрінен де жақсы көретін әйел.
Dialogue: 0,0:18:55.76,0:18:56.89,Default - Copy,Miria,0,0,0,,Офелия
Dialogue: 0,0:18:57.36,0:18:58.76,Default - Copy,Miria,0,0,0,,Бұл белгі
Dialogue: 0,0:19:01.40,0:19:04.27,Default - Copy,Miria,0,0,0,,және 5 саны Лафира
Dialogue: 0,0:19:12.67,0:19:14.94,Default - Copy,Clare,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:19:15.28,0:19:18.58,Default - Copy,Miria,0,0,0,,Ұйымды зерттеуді жалғастырамын.
Dialogue: 0,0:19:19.18,0:19:23.05,Default - Copy,Miria,0,0,0,,Әсіресе оятуға қатысты, егер мен бірдеңе білсем, мен сізге бірден хабарлаймын.
Dialogue: 0,0:19:23.65,0:19:25.79,Default - Copy,Helen,0,0,0,,Сіз мұны жалғыз жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:19:26.29,0:19:29.36,Default - Copy,Miria,0,0,0,,Бізге бірігу қауіптірек.
Dialogue: 0,0:19:29.36,0:19:35.03,Default - Copy,Miria,0,0,0,,Ал бұл ұйымның бізден құтылуға тырысатыны жай ғана гипотеза.
Dialogue: 0,0:19:35.56,0:19:37.70,Default - Copy,Miria,0,0,0,,Ешқандай дәлел жоқ
Dialogue: 0,0:19:37.70,0:19:40.50,Default - Copy,Miria,0,0,0,,Достарыңызбен орынсыз қарсыласудың қажеті жоқ.
Dialogue: 0,0:19:41.04,0:19:42.67,Default - Copy,Miria,0,0,0,,Бірақ сақтықты төмендетпеңіз
Dialogue: 0,0:19:42.67,0:19:45.74,Default - Copy,Miria,0,0,0,,Барлығына айтарым, сақтықты түсірмеңдер.
Dialogue: 0,0:20:04.63,0:20:06.23,Default - Copy,Miria,0,0,0,,Тағы да бәрі
Dialogue: 0,0:20:06.63,0:20:08.06,Default - Copy,Miria,0,0,0,,Тірі кездесейік
Dialogue: 0,0:20:17.47,0:20:20.88,Default - Copy,Galatea,0,0,0,,Бір күні жолымыз қиылысатын шығар?
Dialogue: 0,0:20:22.08,0:20:26.48,Default - Copy,Galatea,0,0,0,,Маған жету үшін қанша адам аман қалады?
Dialogue: 0,0:20:27.38,0:20:30.25,Default - Copy,Galatea,0,0,0,,Бұл шынында да тікенді жол.
Dialogue: 0,0:20:43.93,0:20:45.93,Default - Copy,owner,0,0,0,,Бала, берілме
Dialogue: 0,0:20:45.93,0:20:49.47,Default - Copy,owner,0,0,0,,Сол тауға кіріп, қайтып келген балшық емделмейді.
Dialogue: 0,0:20:49.87,0:20:50.97,Default - Copy,Raki,0,0,0,,Мен қайтамын
Dialogue: 0,0:20:51.47,0:20:53.21,Default - Copy,Raki,0,0,0,,Клэр уәдесінде тұр
Dialogue: 0,0:20:56.91,0:20:57.91,Default - Copy,Raki,0,0,0,,Қайтып кел
Dialogue: 0,0:21:08.96,0:21:10.09,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:21:16.43,0:21:17.93,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:21:19.33,0:21:20.30,Default - Copy,Clare,0,0,0,,Аман бол
Dialogue: 0,0:21:20.77,0:21:21.94,Default - Copy,Clare,0,0,0,,Міндетті түрде.
Dialogue: 0,0:21:22.27,0:21:23.27,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:22:40.40,0:22:42.30,Default - Copy,,0,0,0,,Қанды жол
Dialogue: 0,0:22:42.30,0:22:43.84,Default - Copy,,0,0,0,,Қанды жауынгер
Dialogue: 0,0:22:43.94,0:22:46.54,Default - Copy,,0,0,0,,Уәде етілген уақыт
Dialogue: 0,0:22:48.04,0:22:54.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory