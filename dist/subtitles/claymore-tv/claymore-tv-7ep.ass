Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.19,0:00:15.56,Default - Copy,Teresa,0,0,0,,Шаршадың ба, Клэр?
Dialogue: 0,0:00:16.06,0:00:19.10,Default - Copy,Clare,0,0,0,,Жоқ, мен жақсымын, Тереза.
Dialogue: 0,0:00:20.23,0:00:22.47,Default - Copy,Teresa,0,0,0,,Мен ертең келесі қалаға жетемін.
Dialogue: 0,0:00:23.40,0:00:25.70,Default - Copy,Teresa,0,0,0,,Сонда мен біраз уақыттан кейін бірінші рет демаламын
Dialogue: 0,0:00:26.44,0:00:27.04,Default - Copy,Clare,0,0,0,,Иә
Dialogue: 0,0:01:42.04,0:01:45.35,Default - Copy,Noel,0,0,0,,Сонымен бұл қала дегеніміз не?
Dialogue: 0,0:01:45.35,0:01:48.75,Default - Copy,Sophia,0,0,0,,Жарайды, бұл құбыжықтың ұясы шығар.
Dialogue: 0,0:01:49.35,0:01:53.25,Default - Copy,Sophia,0,0,0,,Қарапайым қалаға жындар шабуыл жасап, қиратылады.
Dialogue: 0,0:01:53.69,0:01:55.86,Default - Copy,Sophia,0,0,0,,Адам болып көріну
Dialogue: 0,0:01:55.86,0:02:00.63,Default - Copy,Sophia,0,0,0,,Олар бірінен соң бірі келген адамдарды тамақтандырады.
Dialogue: 0,0:02:00.63,0:02:04.29,Default - Copy,Noel,0,0,0,,Софья, сан қанша?
Dialogue: 0,0:02:05.16,0:02:06.50,Default - Copy,Sophia,0,0,0,,Иә.
Dialogue: 0,0:02:06.50,0:02:10.24,Default - Copy,Sophia,0,0,0,,Менің ойымша, бұл жетінші, Ноэль-сан.
Dialogue: 0,0:02:10.24,0:02:12.67,Default - Copy,Noel,0,0,0,,Ха, өтірік айтпа.
Dialogue: 0,0:02:12.67,0:02:14.41,Default - Copy,Noel,0,0,0,,Мәйіттердің саны - он үш.
Dialogue: 0,0:02:14.41,0:02:17.24,Default - Copy,Noel,0,0,0,,Сізде алты, менде қанша?
Dialogue: 0,0:02:17.24,0:02:20.65,Default - Copy,Sophia,0,0,0,,Ой, сен қате есептедің.
Dialogue: 0,0:02:20.65,0:02:22.78,Default - Copy,Sophia,0,0,0,,Әу бастан дұрыс есептелген заттар
Dialogue: 0,0:02:23.26,0:02:29.65,Default - Copy,Sophia,0,0,0,,Ноэль тіпті өте жақсы есептеулер жасай алмайды, сондықтан ол әрқашан 4-ші нөмірде болады.
Dialogue: 0,0:02:30.82,0:02:33.09,Default - Copy,Noel,0,0,0,,Мені елеме, құрбым.
Dialogue: 0,0:02:33.09,0:02:36.66,Default - Copy,Noel,0,0,0,,4 саны мен болуы керек. Мен №3.
Dialogue: 0,0:03:04.99,0:03:07.99,Default - Copy,Noel,0,0,0,,Сіздің ақымақтығыңыз әлі де горилламен тең.
Dialogue: 0,0:03:07.99,0:03:11.57,Default - Copy,Sophia,0,0,0,,О, сенің акробатикаң бұрынғыдай болды.
Dialogue: 0,0:03:11.57,0:03:13.80,Default - Copy,Noel,0,0,0,,Ой, мотивацияңыз бар ма?
Dialogue: 0,0:03:14.27,0:03:17.04,Default - Copy,Sophia,0,0,0,,Маған бірінші шашқан сен болдың ғой?
Dialogue: 0,0:03:17.04,0:03:19.31,Default - Copy,Noel,0,0,0,,Бұл артық емес пе?
Dialogue: 0,0:03:19.31,0:03:22.84,Default - Copy,Noel,0,0,0,,Мұнда кімнің 3 саны екенін анықтайық.
Dialogue: 0,0:03:23.68,0:03:25.38,Default - Copy,Sophia,0,0,0,,Қалауыңызша.
Dialogue: 0,0:03:25.38,0:03:26.48,Default - Copy,Irene,0,0,0,,Оны тоқтатыңыз
Dialogue: 0,0:03:45.03,0:03:47.27,Default - Copy,Irene,0,0,0,,Достарыңмен төбелесудің не қажеті бар?
Dialogue: 0,0:03:48.00,0:03:50.61,Default - Copy,Irene,0,0,0,,Бұйрық - бұл қаладағы жындарды жою.
Dialogue: 0,0:03:51.20,0:03:52.11,Default - Copy,Irene,0,0,0,,Бірақ мен осы тасбақамен денемізді алмастырдым
Dialogue: 0,0:03:52.94,0:03:55.21,Default - Copy,Sophia,0,0,0,,Көп болды, Айрин-сан.
Dialogue: 0,0:03:56.11,0:03:59.35,Default - Copy,Noel,0,0,0,,Жылдам семсер Айриннің есімі тек көңіл көтеру үшін ғана емес.
Dialogue: 0,0:03:59.71,0:04:01.58,Default - Copy,Noel,0,0,0,,Жалаңаш денені де көре алмадым
Dialogue: 0,0:04:02.85,0:04:07.79,Default - Copy,Sophia,0,0,0,,Маған жақын жерде қан шашылмағаны жақсы.
Dialogue: 0,0:04:07.79,0:04:09.26,Default - Copy,Sophia,0,0,0,,Бұл мен үшін таңқаларлық
Dialogue: 0,0:04:10.06,0:04:12.87,Default - Copy,Sophia,0,0,0,,2 санының орны мызғымас.
Dialogue: 0,0:04:12.87,0:04:14.09,Default - Copy,Noel,0,0,0,,Сонымен
Dialogue: 0,0:04:14.09,0:04:20.60,Default - Copy,Noel,0,0,0,,Бұл 2-ден 4-ке дейінгі сандарды жинау және осы қаладағы жындарды жою ғана емес.
Dialogue: 0,0:04:21.20,0:04:22.10,Default - Copy,Sophia,0,0,0,,Иә.
Dialogue: 0,0:04:22.60,0:04:26.27,Default - Copy,Sophia,0,0,0,,Мұндай қалада біздің біреуіміз жеткілікті.
Dialogue: 0,0:04:27.04,0:04:30.41,Default - Copy,Sophia,0,0,0,,Менің ойымша, біз осы үш адамды жинағандықтан, бірдеңе болуы керек.
Dialogue: 0,0:04:33.91,0:04:35.92,Default - Copy,Irene,0,0,0,,Ұйымдағы №1
Dialogue: 0,0:04:35.92,0:04:38.15,Default - Copy,Irene,0,0,0,,Терезаны бағындыру туралы бұйрық берілді.
Dialogue: 0,0:04:39.02,0:04:40.05,Default - Copy,Noel,0,0,0,,Тереза
Dialogue: 0,0:04:40.99,0:04:43.02,Default - Copy,Noel,0,0,0,,Бұл күлімсіреген Тереза ма?
Dialogue: 0,0:04:43.56,0:04:44.62,Default - Copy,Sophia,0,0,0,,Неліктен тағы?
Dialogue: 0,0:04:45.39,0:04:46.76,Default - Copy,Irene,0,0,0,,Біреуді өлтірді
Dialogue: 0,0:04:47.23,0:04:49.03,Default - Copy,Irene,0,0,0,,Барлық қарақшыларды өлтіріңіз
Dialogue: 0,0:04:49.66,0:04:51.56,Default - Copy,Irene,0,0,0,,Және тазалау кезінде
Dialogue: 0,0:04:51.56,0:04:54.53,Default - Copy,Irene,0,0,0,,Ұйымнан дос пен кемшілікті қысқарту
Dialogue: 0,0:04:54.53,0:04:56.57,Default - Copy,Noel,0,0,0,,Сонымен, шынымен бе?
Dialogue: 0,0:04:56.57,0:04:59.67,Default - Copy,Noel,0,0,0,,Ең күшті ауытқу тіпті әзіл де емес.
Dialogue: 0,0:04:59.67,0:05:02.11,Default - Copy,Noel,0,0,0,,Шынымды айтсам қысқартқым келеді.
Dialogue: 0,0:05:02.11,0:05:07.05,Default - Copy,Irene,0,0,0,,Сондықтан ұйымның 2-ден 5-ке дейінгі сандары шақырылды.
Dialogue: 0,0:05:07.58,0:05:12.05,Default - Copy,Irene,0,0,0,,Ұйымның ережесіне сәйкес Терезаның басын алуға бар күшімізді саламыз.
Dialogue: 0,0:05:12.69,0:05:17.49,Default - Copy,Noel,0,0,0,,Бұл 1 саны мен 2-ден 5-ке дейінгі сандар арасындағы жан-жақты шайқасты білдіре ме?
Dialogue: 0,0:05:18.83,0:05:20.40,Default - Copy,Noel,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:05:20.96,0:05:23.83,Default - Copy,Noel,0,0,0,,Сонымен 5 саны кім?
Dialogue: 0,0:05:25.10,0:05:26.93,Default - Copy,Sophia,0,0,0,,Сен шынымен ақымақсың.
Dialogue: 0,0:05:27.90,0:05:29.10,Default - Copy,Sophia,0,0,0,,Эльда
Dialogue: 0,0:05:29.10,0:05:30.27,Default - Copy,Irene,0,0,0,,Эльда емес
Dialogue: 0,0:05:32.11,0:05:34.04,Default - Copy,Irene,0,0,0,,Басқа адам 2-саны.
Dialogue: 0,0:05:36.28,0:05:38.78,Default - Copy,Irene,0,0,0,,Мен жақында 3 саны болдым.
Dialogue: 0,0:05:39.75,0:05:43.68,Default - Copy,Irene,0,0,0,,Сіздердің әрқайсысыңыз 4 саны мен 5 саны болдыңыз.
Dialogue: 0,0:05:43.68,0:05:45.89,Default - Copy,Noel,0,0,0,,Бұл не?
Dialogue: 0,0:05:45.89,0:05:47.25,Default - Copy,Sophia,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:05:47.25,0:05:50.39,Default - Copy,Irene,0,0,0,,2 саны сәйкестік, себебі ол жақында белгіленді.
Dialogue: 0,0:05:50.89,0:05:53.39,Default - Copy,Irene,0,0,0,,Соңғы бірнеше айда ол тез өсті.
Dialogue: 0,0:05:53.39,0:05:55.09,Default - Copy,Noel,0,0,0,,Егер сіз пайда тапсаңыз
Dialogue: 0,0:05:55.09,0:05:58.46,Default - Copy,Noel,0,0,0,,Неліктен бұл жігіт кенеттен 2-ші болып қалды?
Dialogue: 0,0:05:58.46,0:05:59.80,Default - Copy,Noel,0,0,0,,Мені күлдірмеңіз
Dialogue: 0,0:05:59.80,0:06:01.43,Default - Copy,Irene,0,0,0,,Егер көңіліңізден шықпаса
Dialogue: 0,0:06:01.43,0:06:02.93,Default - Copy,Irene,0,0,0,,Оны қолдарыңызбен алыңыз
Dialogue: 0,0:06:03.47,0:06:06.87,Default - Copy,Irene,0,0,0,,Бір қарағанда көзім жетті.
Dialogue: 0,0:06:10.04,0:06:12.18,Default - Copy,Priscilla,0,0,0,,...
Dialogue: 0,0:06:14.98,0:06:16.32,Default - Copy,Noel,0,0,0,,Бұл не?
Dialogue: 0,0:06:16.32,0:06:18.02,Default - Copy,Noel,0,0,0,,Ол ақымақ адам.
Dialogue: 0,0:06:18.52,0:06:19.52,Default - Copy,Irene,0,0,0,,Жігіт
Dialogue: 0,0:06:20.49,0:06:24.02,Default - Copy,Irene,0,0,0,,Жақында ол мөр алған жаңа №2
Dialogue: 0,0:06:25.22,0:06:26.23,Default - Copy,Irene,0,0,0,,Бұл Присцилла.
Dialogue: 0,0:06:27.76,0:06:29.26,Default - Copy,Noel,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:06:29.26,0:06:31.03,Default - Copy,Noel,0,0,0,,Ол жай ғана бала ғой, солай емес пе?
Dialogue: 0,0:06:31.03,0:06:33.43,Default - Copy,Noel,0,0,0,,Сізге және сіздің ұйымыңызға не болды?
Dialogue: 0,0:06:33.43,0:06:35.07,Default - Copy,Irene,0,0,0,,Сондықтан айтып отырмын
Dialogue: 0,0:06:35.07,0:06:38.54,Default - Copy,Irene,0,0,0,,Сенбесеңіз, өзіңіз көріңіз.
Dialogue: 0,0:06:38.54,0:06:40.74,Default - Copy,Noel,0,0,0,,Бұл артық емес пе?
Dialogue: 0,0:06:40.74,0:06:44.61,Default - Copy,Noel,0,0,0,,Мен саған 2 нөмірін күшпен аламын.
Dialogue: 0,0:06:47.35,0:06:48.85,Default - Copy,Noel,0,0,0,,Тұр
Dialogue: 0,0:06:48.85,0:06:50.55,Default - Copy,Noel,0,0,0,,Мен мұны дәл осы жерде шешемін.
Dialogue: 0,0:06:50.88,0:06:51.48,Default - Copy,Priscilla,0,0,0,,Енді сен агент емессің.
Dialogue: 0,0:06:53.05,0:06:54.82,Default - Copy,Priscilla,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:06:54.82,0:06:57.06,Default - Copy,Priscilla,0,0,0,,Шақыруға кешіккенім үшін кешірім сұраймын.
Dialogue: 0,0:06:57.06,0:06:59.33,Default - Copy,Priscilla,0,0,0,,Жындарды жоюға көп уақыт қажет болды.
Dialogue: 0,0:06:59.33,0:07:00.09,Default - Copy,Priscilla,0,0,0,,Мен
Dialogue: 0,0:07:00.09,0:07:01.53,Default - Copy,Noel,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:07:01.53,0:07:03.70,Default - Copy,Noel,0,0,0,,Мен шайқас дедім.
Dialogue: 0,0:07:03.70,0:07:06.27,Default - Copy,Noel,0,0,0,,Жалпы айтқанда, бірнеше жындармен күресу үшін көп уақыт қажет.
Dialogue: 0,0:07:19.35,0:07:21.21,Default - Copy,Noel,0,0,0,,Бұл не?
Dialogue: 0,0:07:21.21,0:07:22.35,Default - Copy,Sophia,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:07:22.35,0:07:25.92,Default - Copy,Sophia,0,0,0,,Осылай жақын болу, тіпті ұрысатындай сезінбестен.
Dialogue: 0,0:07:26.59,0:07:30.36,Default - Copy,Irene,0,0,0,,Қарсылас кім болса да, қанша болса да
Dialogue: 0,0:07:30.36,0:07:33.06,Default - Copy,Irene,0,0,0,,Қарсыластың сиқырлы күшін жібермей жою
Dialogue: 0,0:07:33.89,0:07:36.59,Default - Copy,Irene,0,0,0,,Тереза жымиғандай.
Dialogue: 0,0:07:37.16,0:07:40.43,Default - Copy,Irene,0,0,0,,Ең бастысы, менің жындарға деген өшпенділігім бәрінен де күшті.
Dialogue: 0,0:07:40.83,0:07:46.60,Default - Copy,Irene,0,0,0,,Шынымды айтсам, қанша достарым болса да, күліп тұрған Терезамен төбелескім келмеді.
Dialogue: 0,0:07:47.34,0:07:51.08,Default - Copy,Irene,0,0,0,,Бірақ мен бұл жігіттің жындармен соғысып жатқанын көргенде, ойымнан қайттым.
Dialogue: 0,0:07:51.93,0:07:55.18,Default - Copy,Irene,0,0,0,,Бұл жігіт ақырында Терезадан асып түседі.
Dialogue: 0,0:08:03.76,0:08:07.83,Default - Copy,Teresa,0,0,0,,Егер сіздің шынайы тұлғаңыз белгілі болса, сіз бұл қалада өзіңізді еркін сезіне алмайсыз.
Dialogue: 0,0:08:09.83,0:08:14.17,Default - Copy,Teresa,0,0,0,,Ашық ауада ұйықтамай, жұмсақ төсекте ұйықтай алатын шығармын.
Dialogue: 0,0:08:14.63,0:08:15.87,Default - Copy,Teresa,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:08:19.77,0:08:20.84,Default - Copy,Teresa,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:08:23.81,0:08:24.88,Default - Copy,man,0,0,0,,Клеймор
Dialogue: 0,0:08:24.88,0:08:26.98,Default - Copy,man,0,0,0,,Неліктен Клеймор бұл қалада?
Dialogue: 0,0:08:26.98,0:08:28.28,Default - Copy,Teresa,0,0,0,,Мүлдем
Dialogue: 0,0:08:28.78,0:08:31.82,Default - Copy,Teresa,0,0,0,,Мен осы қалада тұруды ойладым.
Dialogue: 0,0:08:32.15,0:08:34.19,Default - Copy,Teresa,0,0,0,,Сенің кесіріңнен бәрі бұзылды.
Dialogue: 0,0:08:37.02,0:08:39.79,Default - Copy,woman,0,0,0,,Құдайым, ол баланы құтқара көр.
Dialogue: 0,0:08:39.79,0:08:42.70,Default - Copy,Teresa,0,0,0,,Олар шынымен тітіркендіргіш.
Dialogue: 0,0:08:54.31,0:08:56.64,Default - Copy,Teresa,0,0,0,,Сіз осы қалада тұруға дайынсыз ба?
Dialogue: 0,0:08:57.28,0:08:59.51,Default - Copy,Teresa,0,0,0,,Қ-қандай?
Dialogue: 0,0:09:02.22,0:09:04.15,Default - Copy,man,0,0,0,,Рахмет
Dialogue: 0,0:09:05.32,0:09:08.29,Default - Copy,man,0,0,0,,Сен біздің құтқарушымызсың
Dialogue: 0,0:09:08.29,0:09:10.96,Default - Copy,man,0,0,0,,Сізге алғыс айтуыма рұқсат етіңіз.
Dialogue: 0,0:09:12.29,0:09:13.76,Default - Copy,Teresa,0,0,0,,Әдептілік талап етілмейді
Dialogue: 0,0:09:13.76,0:09:16.03,Default - Copy,Teresa,0,0,0,,Кейінірек қара киінген
Dialogue: 0,0:09:16.03,0:09:17.03,Default - Copy,Teresa,0,0,0,,Жоқ
Dialogue: 0,0:09:17.03,0:09:17.66,Default - Copy,man,0,0,0,,Иә
Dialogue: 0,0:09:18.16,0:09:19.30,Default - Copy,Teresa,0,0,0,,Ештеңе
Dialogue: 0,0:09:19.30,0:09:20.27,Default - Copy,man2,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:09:20.27,0:09:22.47,Default - Copy,man2,0,0,0,,Қараңызшы, қазір бәрі жақсы.
Dialogue: 0,0:09:22.47,0:09:24.17,Default - Copy,kid,0,0,0,,Әке
Dialogue: 0,0:09:26.31,0:09:28.81,Default - Copy,Teresa,0,0,0,,Мен оны өтіп бара жатып жасадым.
Dialogue: 0,0:09:28.81,0:09:30.21,Default - Copy,Teresa,0,0,0,,Маған алғыс айтудың қажеті жоқ
Dialogue: 0,0:09:30.21,0:09:32.68,Default - Copy,man,0,0,0,,Бірақ бұл тым көп
Dialogue: 0,0:09:32.11,0:09:32.98,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:09:34.55,0:09:37.98,Default - Copy,Teresa,0,0,0,,Иә, бұл жағдайда маған баспана ұйымдастыра аласыз ба?
Dialogue: 0,0:09:38.45,0:09:39.85,Default - Copy,Teresa,0,0,0,,Осы баламен екіге
Dialogue: 0,0:09:40.39,0:09:42.02,Default - Copy,Teresa,0,0,0,,Мен алыс сапарда демалғым келеді.
Dialogue: 0,0:09:51.36,0:09:53.90,Default - Copy,Teresa,0,0,0,,Сен қашанға дейін күліп жүресің, Клэр?
Dialogue: 0,0:09:53.90,0:09:57.87,Default - Copy,Clare,0,0,0,,Өйткені Терезаның мұндай түрін бірінші рет көріп тұрмын.
Dialogue: 0,0:09:58.40,0:10:01.64,Default - Copy,Clare,0,0,0,,Адамдардың бақытты болғанына таң қалдым.
Dialogue: 0,0:10:02.14,0:10:05.08,Default - Copy,Teresa,0,0,0,,Бұл, әрине, бірінші рет болды.
Dialogue: 0,0:10:05.08,0:10:08.01,Default - Copy,Teresa,0,0,0,,Сенің осылай шынымен риза болғаныңа сене алар емеспін.
Dialogue: 0,0:10:09.02,0:10:10.72,Default - Copy,Teresa,0,0,0,,Мен бұл өте жақсы деп ойладым.
Dialogue: 0,0:10:11.22,0:10:16.26,Default - Copy,Teresa,0,0,0,,Сауапқа қарамастан адамдарды жын-шайтандардан құтқару деген жоқ.
Dialogue: 0,0:10:19.96,0:10:23.26,Default - Copy,Clare,0,0,0,,Тереза, сен менімен ұйықтай аласың.
Dialogue: 0,0:10:24.90,0:10:27.03,Default - Copy,Teresa,0,0,0,,Екі кереует бар.
Dialogue: 0,0:10:27.03,0:10:28.77,Default - Copy,Teresa,0,0,0,,Тар жерде
Dialogue: 0,0:10:29.54,0:10:30.28,Default - Copy,Teresa,0,0,0,,Эй
Dialogue: 0,0:10:34.01,0:10:37.61,Default - Copy,Teresa,0,0,0,,Жұмсақ төсекке жатқан бойда қатты ұйықтап кеттім.
Dialogue: 0,0:10:39.51,0:10:40.71,Default - Copy,Teresa,0,0,0,,Жақсылап демалыңыз
Dialogue: 0,0:10:41.75,0:10:43.88,Default - Copy,Teresa,0,0,0,,Мен осы қалада біраз уақыт тұрамын.
Dialogue: 0,0:10:58.50,0:11:02.14,Default - Copy,Teresa,0,0,0,,Бұл қалаға үш оғаш рух кірді.
Dialogue: 0,0:11:17.65,0:11:22.66,Default - Copy,Teresa,0,0,0,,Бұл мен ұйымнан шыққаннан кейін маған жіберілген ережелерді орындаушылар ма?
Dialogue: 0,0:11:23.96,0:11:25.46,Default - Copy,Teresa,0,0,0,,Жындарыңызды басу
Dialogue: 0,0:11:25.46,0:11:26.53,Default - Copy,Teresa,0,0,0,,Төтенше
Dialogue: 0,0:11:26.96,0:11:28.99,Default - Copy,Teresa,0,0,0,,Оларға хабар бермеңіз
Dialogue: 0,0:11:29.96,0:11:33.80,Default - Copy,Teresa,0,0,0,,Егер біз олардан ашылмай-ақ өте алсақ.
Dialogue: 0,0:11:36.60,0:11:40.51,Default - Copy,Teresa,0,0,0,,Олар қабылданатын адамдар емес.
Dialogue: 0,0:11:40.51,0:11:41.47,Default - Copy,Teresa,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:11:41.87,0:11:43.01,Default - Copy,Sophia,0,0,0,,осында
Dialogue: 0,0:11:43.01,0:11:43.98,Default - Copy,Irene,0,0,0,,That's right.
Dialogue: 0,0:11:45.71,0:11:48.15,Default - Copy,Noel,0,0,0,,Сіз сәнді жерде тұрасыз ба?
Dialogue: 0,0:11:48.61,0:11:49.38,Default - Copy,Irene,0,0,0,,Кеттік
Dialogue: 0,0:11:57.39,0:11:58.39,Default - Copy,man,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:12:03.29,0:12:05.20,Default - Copy,man,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:05.20,0:12:06.03,Default - Copy,Sophia,0,0,0,,Жарайды.
Dialogue: 0,0:12:06.03,0:12:08.77,Default - Copy,Sophia,0,0,0,,Егер сіз оны бүкіл қонақүйдің бағасы деп ойласаңыз.
Dialogue: 0,0:12:13.44,0:12:14.17,Default - Copy,Teresa,0,0,0,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:12:14.97,0:12:16.92,Default - Copy,Teresa,0,0,0,,Біраз уақыт болды, Айрин.
Dialogue: 0,0:12:17.74,0:12:19.55,Default - Copy,Teresa,0,0,0,,Сіздің сау көрінгеніңізге қуаныштымын.
Dialogue: 0,0:12:21.85,0:12:24.92,Default - Copy,Irene,0,0,0,,Мен сенің басыңды алуға келдім, Тереза.
Dialogue: 0,0:12:24.92,0:12:27.92,Default - Copy,Teresa,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:12:32.89,0:12:34.96,Default - Copy,Teresa,0,0,0,,Такато қылыш жақсы, бірақ
Dialogue: 0,0:12:34.96,0:12:37.49,Default - Copy,Teresa,0,0,0,,Баланың ол жерде ұйықтауына жол бермеңіз.
Dialogue: 0,0:12:37.93,0:12:39.67,Default - Copy,Irene,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:12:39.67,0:12:41.73,Default - Copy,Irene,0,0,0,,Сіз оянғанша бәрі бітеді
Dialogue: 0,0:12:46.84,0:12:47.64,Default - Copy,Teresa,0,0,0,,Не болды?
Dialogue: 0,0:12:48.34,0:12:50.87,Default - Copy,Teresa,0,0,0,,Такато қылыш тоқтамауы керек.
Dialogue: 0,0:12:54.95,0:12:57.81,Default - Copy,Teresa,0,0,0,,Жарайды, бұрынғыдан да жақсы.
Dialogue: 0,0:12:57.81,0:12:59.65,Default - Copy,Teresa,0,0,0,,Әлі әлі алда көп жол бар
Dialogue: 0,0:13:05.25,0:13:06.63,Default - Copy,Sophia,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:13:08.19,0:13:10.24,Default - Copy,man,0,0,0,,Не?
Dialogue: 0,0:13:10.24,0:13:12.49,Default - Copy,Sophia,0,0,0,,Мен бұл жерде бір жерде ме деп ойлаймын.
Dialogue: 0,0:13:15.13,0:13:16.07,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:13:16.07,0:13:16.87,Default - Copy,Teresa,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:13:16.87,0:13:17.74,Default - Copy,Teresa,0,0,0,,Тыныш отырыңыз
Dialogue: 0,0:13:27.55,0:13:31.55,Default - Copy,Teresa,0,0,0,,Мен үш шынымен шулы адамды жібердім.
Dialogue: 0,0:13:33.05,0:13:35.05,Default - Copy,Teresa,0,0,0,,Тағы бір адам болды.
Dialogue: 0,0:13:35.05,0:13:38.06,Default - Copy,Teresa,0,0,0,,Идиот, мен мүлде қатысуды сезбедім.
Dialogue: 0,0:13:39.26,0:13:41.36,Default - Copy,Priscilla,0,0,0,,Сізді бірінші рет кездестіруім
Dialogue: 0,0:13:41.36,0:13:46.50,Default - Copy,Priscilla,0,0,0,,Менің атым Присцилла, мен жақында 2 нөмірлі мөрді алдым.
Dialogue: 0,0:13:46.50,0:13:48.07,Default - Copy,Teresa,0,0,0,,№ 2
Dialogue: 0,0:13:48.47,0:13:50.90,Default - Copy,Priscilla,0,0,0,,Дөрекі болғаным үшін кешіріңіз.
Dialogue: 0,0:13:50.90,0:13:53.07,Default - Copy,Priscilla,0,0,0,,Мен Терезаның басын аламын.
Dialogue: 0,0:13:53.84,0:13:55.07,Default - Copy,Noel,0,0,0,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,0:13:55.07,0:13:56.81,Default - Copy,Sophia,0,0,0,,О, құдай!
Dialogue: 0,0:13:56.81,0:14:00.68,Default - Copy,Sophia,0,0,0,,Жоспар жанып жатқан жерін арт жағынан кесу болды.
Dialogue: 0,0:14:01.48,0:14:03.95,Default - Copy,Sophia,0,0,0,,Сіз маған тура қарап тұрсыз, солай емес пе?
Dialogue: 0,0:14:04.98,0:14:09.46,Default - Copy,Sophia,0,0,0,,Күлімсіреген Терезаға қарсы тұру арқылы жеңе аламын деп ойлайсыз ба?
Dialogue: 0,0:14:12.19,0:14:13.99,Default - Copy,Teresa,0,0,0,,Алыс жүр, Клэр.
Dialogue: 0,0:14:13.99,0:14:15.46,Default - Copy,Clare,0,0,0,,E бірақ
Dialogue: 0,0:14:15.96,0:14:18.70,Default - Copy,Teresa,0,0,0,,Жарайды, уайымдама.
Dialogue: 0,0:14:19.40,0:14:21.33,Default - Copy,Teresa,0,0,0,,Менің айтқаныма сеніңіз
Dialogue: 0,0:14:21.77,0:14:23.00,Default - Copy,Teresa,0,0,0,,Мен мұны бұрын да айтқанмын.
Dialogue: 0,0:14:28.01,0:14:29.21,Default - Copy,Teresa,0,0,0,,Сіз Присцилла дедіңіз.
Dialogue: 0,0:14:30.04,0:14:33.31,Default - Copy,Teresa,0,0,0,,Мен секірген кезде мүмкіндігім болуы керек еді.
Dialogue: 0,0:14:33.31,0:14:35.21,Default - Copy,Teresa,0,0,0,,Неліктен олар шабуыл жасамады?
Dialogue: 0,0:14:35.75,0:14:38.45,Default - Copy,Priscilla,0,0,0,,Бұл қорқақтық емес пе?
Dialogue: 0,0:14:40.22,0:14:43.69,Default - Copy,Priscilla,0,0,0,,Мен сізден тағы бір нәрсе сұрағым келеді.
Dialogue: 0,0:14:44.49,0:14:48.83,Default - Copy,Priscilla,0,0,0,,Неліктен Тереза ​​тазарту кезінде басы алынбады?
Dialogue: 0,0:14:49.56,0:14:52.06,Default - Copy,Priscilla,0,0,0,,Ұйымның ережелері абсолютті болуы керек.
Dialogue: 0,0:14:52.77,0:14:57.54,Default - Copy,Priscilla,0,0,0,,Біздің міндетіміз – адамдардың тыныштығы үшін жындарды жою.
Dialogue: 0,0:14:58.37,0:15:01.67,Default - Copy,Priscilla,0,0,0,,Ол үшін біз күресу үшін өмірімізді құрбан етеміз.
Dialogue: 0,0:15:02.07,0:15:05.21,Default - Copy,Priscilla,0,0,0,,Біз адамдарды өлтіре аламыз ба?
Dialogue: 0,0:15:06.08,0:15:11.92,Default - Copy,Priscilla,0,0,0,,Ұйым осы уақытқа дейін құрған адамдардың сенімін жоғалтады.
Dialogue: 0,0:15:12.58,0:15:14.65,Default - Copy,Priscilla,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:15.52,0:15:17.39,Default - Copy,Priscilla,0,0,0,,Ұйым ережесіне сәйкес
Dialogue: 0,0:15:17.39,0:15:20.56,Default - Copy,Priscilla,0,0,0,,Мен Терезаның басын аулаймын.
Dialogue: 0,0:15:22.03,0:15:27.37,Default - Copy,Teresa,0,0,0,,Ең жақсы жағдайда ұйымның ыңғайлы логикасы оларға басылды.
Dialogue: 0,0:15:28.53,0:15:31.70,Default - Copy,Teresa,0,0,0,,Олай дейтін болсам,
Dialogue: 0,0:15:33.14,0:15:37.71,Default - Copy,Teresa,0,0,0,,Дүние әрқашан идеалға сай бола бермейді, кішкентай қыз.
Dialogue: 0,0:15:45.89,0:15:46.62,Default - Copy,Teresa,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:16:18.02,0:16:19.79,Default - Copy,Noel,0,0,0,,Ол мұны істейді, солай ма?
Dialogue: 0,0:16:19.79,0:16:22.12,Default - Copy,Noel,0,0,0,,Тереза қарсыласын итеру
Dialogue: 0,0:16:23.16,0:16:26.59,Default - Copy,Irene,0,0,0,,Сіз оны неліктен Күлімсіреген Тереза деп атағанын білесіз бе?
Dialogue: 0,0:16:26.59,0:16:27.49,Default - Copy,Noel,0,0,0,,болып табылады
Dialogue: 0,0:16:27.49,0:16:31.50,Default - Copy,Noel,0,0,0,,Ол құбыжықтарды өлтіргенде үнемі күліп жүретіндіктен болса керек.
Dialogue: 0,0:16:31.50,0:16:33.73,Default - Copy,Irene,0,0,0,,Софья екеуіңе бірдей.
Dialogue: 0,0:16:34.17,0:16:36.57,Default - Copy,Irene,0,0,0,,Бірақ тек Тереза ​​осылай аталады.
Dialogue: 0,0:16:36.57,0:16:38.30,Default - Copy,Noel,0,0,0,,Иә, бұл дұрыс.
Dialogue: 0,0:16:38.30,0:16:39.10,Default - Copy,Noel,0,0,0,,Неліктен?
Dialogue: 0,0:16:40.04,0:16:41.44,Default - Copy,Irene,0,0,0,,Сіздің ептілігіңіз
Dialogue: 0,0:16:41.44,0:16:42.91,Default - Copy,Irene,0,0,0,,Софияның күші
Dialogue: 0,0:16:42.91,0:16:44.38,Default - Copy,Irene,0,0,0,,Менің Такато қылышым
Dialogue: 0,0:16:44.81,0:16:49.11,Default - Copy,Irene,0,0,0,,Салыстыратын болсақ, Терезада күлімсіреуден басқа ештеңе байқалмайды.
Dialogue: 0,0:16:49.11,0:16:53.12,Default - Copy,Noel,0,0,0,,Себебі Тереза ​​барлық жағынан ерекшеленеді.
Dialogue: 0,0:16:53.12,0:16:54.99,Default - Copy,Irene,0,0,0,,Сәл басқаша
Dialogue: 0,0:16:54.99,0:17:01.83,Default - Copy,Irene,0,0,0,,Қозғалыс жағынан сен жақсысың, София күш жағынан жақсырақ, мен қылыштың жылдамдығы жағынан Терезадан жақсымын.
Dialogue: 0,0:17:01.83,0:17:02.86,Default - Copy,Noel,0,0,0,,болып табылады
Dialogue: 0,0:17:06.90,0:17:12.27,Default - Copy,Irene,0,0,0,,Терезаның ең күшті болуының себебі - оның елес энергияны сезіну қабілеті.
Dialogue: 0,0:17:15.21,0:17:18.14,Default - Copy,Irene,0,0,0,,Жынның қайда екенін білу жеткіліксіз.
Dialogue: 0,0:17:18.71,0:17:22.45,Default - Copy,Irene,0,0,0,,Нәзік рухтың денеңмен ағып жатқанын сезінесің.
Dialogue: 0,0:17:22.45,0:17:23.28,Default - Copy,Noel,0,0,0,,болып табылады
Dialogue: 0,0:17:23.98,0:17:28.52,Default - Copy,Irene,0,0,0,,Сиқырлы күшпен күрескендердің денелерінің қозғалатын бөліктеріне ағып жатқан сиқырлы энергиясы бар.
Dialogue: 0,0:17:29.62,0:17:31.79,Default - Copy,Irene,0,0,0,,Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:17:33.43,0:17:38.03,Default - Copy,Irene,0,0,0,,Сондықтан Присцилла өзінің жындарын барынша басу арқылы күресе алады.
Dialogue: 0,0:17:38.03,0:17:40.27,Default - Copy,Irene,0,0,0,,Ол әлдеқайда қиын қарсылас.
Dialogue: 0,0:17:43.10,0:17:44.23,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:17:54.61,0:17:55.61,Default - Copy,Sophia,0,0,0,,Таку
Dialogue: 0,0:17:57.05,0:17:59.25,Default - Copy,Sophia,0,0,0,,Екеуің керемет екенсіңдер.
Dialogue: 0,0:18:00.82,0:18:02.32,Default - Copy,Noel,0,0,0,,Керемет Керемет
Dialogue: 0,0:18:02.32,0:18:05.45,Default - Copy,Noel,0,0,0,,Қылыш желінің дыбысы мен соққы толқыны арқылы бірдеңе жасауға болатын сияқты.
Dialogue: 0,0:18:06.19,0:18:08.89,Default - Copy,Noel,0,0,0,,Ол үлкен іс, анау бала.
Dialogue: 0,0:18:08.89,0:18:12.89,Default - Copy,Noel,0,0,0,,Өйткені олар Терезамен тең түсті.
Dialogue: 0,0:18:12.89,0:18:14.63,Default - Copy,Noel,0,0,0,,Бұл біркелкі.
Dialogue: 0,0:18:19.51,0:18:20.77,Default - Copy,Irene,0,0,0,,Уақыт келді
Dialogue: 0,0:18:21.41,0:18:22.64,Default - Copy,Irene,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:18:23.08,0:18:25.88,Default - Copy,Irene,0,0,0,,Іс осылай жалғаса берсе, Прискиланың басы ұшып кетеді.
Dialogue: 0,0:18:25.88,0:18:27.98,Default - Copy,Noel,0,0,0,,Аа, сен не дедің?
Dialogue: 0,0:18:27.98,0:18:30.78,Default - Copy,Noel,0,0,0,,Менің ойымша, Присцилла Тереза ​​үшін жақсырақ.
Dialogue: 0,0:18:30.78,0:18:31.98,Default - Copy,Noel,0,0,0,,О, бұл
Dialogue: 0,0:18:31.98,0:18:33.72,Default - Copy,Irene,0,0,0,,Бұл жай ғана көз байлау
Dialogue: 0,0:18:34.82,0:18:36.56,Default - Copy,Irene,0,0,0,,Тереза сиқырлы күштерге сенбейді
Dialogue: 0,0:18:36.56,0:18:38.29,Default - Copy,Irene,0,0,0,,Қалыпты шайқас.
Dialogue: 0,0:18:39.23,0:18:41.82,Default - Copy,Irene,0,0,0,,Топырақтың бастапқы беріктігі әртүрлі.
Dialogue: 0,0:18:42.49,0:18:43.76,Default - Copy,Priscilla,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:18:43.76,0:18:45.80,Default - Copy,Priscilla,0,0,0,,Менің қозғалыстарым кенет баяулады.
Dialogue: 0,0:18:45.80,0:18:46.83,Default - Copy,Priscilla,0,0,0,,Жоқ
Dialogue: 0,0:18:46.83,0:18:48.33,Default - Copy,Priscilla,0,0,0,,Бұл адам
Dialogue: 0,0:18:48.33,0:18:50.33,Default - Copy,Priscilla,0,0,0,,Бұл адам ерте келеді.
Dialogue: 0,0:18:52.23,0:18:53.31,Default - Copy,Priscilla,0,0,0,,Неліктен?
Dialogue: 0,0:18:53.71,0:18:55.11,Default - Copy,Priscilla,0,0,0,,Шыгандшинаға баратын жолды іздеуге аттанған Зерттеу корпусы,
Dialogue: 0,0:18:55.11,0:18:57.84,Default - Copy,Priscilla,0,0,0,,Мен әрқашан адамдар үшін күрестім.
Dialogue: 0,0:18:58.57,0:19:00.78,Default - Copy,Priscilla,0,0,0,,Кінәлі – біреуді өлтірген осы адам.
Dialogue: 0,0:19:01.38,0:19:02.65,Default - Copy,Priscilla,0,0,0,,Және де
Dialogue: 0,0:19:02.65,0:19:04.25,Default - Copy,Priscilla,0,0,0,,Және де
Dialogue: 0,0:19:04.25,0:19:07.15,Default - Copy,Priscilla,0,0,0,,Мен неге жеңе алмаймын?
Dialogue: 0,0:19:10.69,0:19:13.26,Default - Copy,Teresa,0,0,0,,Бұл жігіттің мүмкіндігі құбыжық.
Dialogue: 0,0:19:13.86,0:19:16.30,Default - Copy,Teresa,0,0,0,,Мен қазірден бастап керемет күшті боламын.
Dialogue: 0,0:19:17.33,0:19:19.80,Default - Copy,Teresa,0,0,0,,Осы уақытты қысқартсам да,
Dialogue: 0,0:19:19.80,0:19:21.67,Default - Copy,Teresa,0,0,0,,Келесі жолы не болатынын білмеймін.
Dialogue: 0,0:19:24.77,0:19:28.84,Default - Copy,Teresa,0,0,0,,Кешіріңіз, бірақ мен әлі өле алмаймын.
Dialogue: 0,0:20:04.28,0:20:06.18,Default - Copy,Noel,0,0,0,,Хмм.
Dialogue: 0,0:20:06.18,0:20:07.25,Default - Copy,Noel,0,0,0,,Мені кесіп тастады.
Dialogue: 0,0:20:07.25,0:20:11.35,Default - Copy,Sophia,0,0,0,,Әй, тепкілеп, ұшырып жібергеннен жақсы.
Dialogue: 0,0:20:12.85,0:20:14.82,Default - Copy,Priscilla,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:20:14.82,0:20:17.22,Default - Copy,Priscilla,0,0,0,,Заңды қанша бұзса да,
Dialogue: 0,0:20:17.22,0:20:19.33,Default - Copy,Priscilla,0,0,0,,Көп адамы бар бір адам?
Dialogue: 0,0:20:19.33,0:20:20.86,Default - Copy,Priscilla,0,0,0,,Мен мұнда жалғызбын
Dialogue: 0,0:20:20.86,0:20:21.89,Default - Copy,Irene,0,0,0,,Көңілсіз болмаңыз
Dialogue: 0,0:20:22.70,0:20:26.60,Default - Copy,Irene,0,0,0,,Артыңнан ермегенімізде, басың түсіп қалар еді.
Dialogue: 0,0:20:27.20,0:20:30.70,Default - Copy,Irene,0,0,0,,Оны төбелесіп жатқандар жақсы түсінуі керек.
Dialogue: 0,0:20:31.57,0:20:34.21,Default - Copy,Irene,0,0,0,,Біз жеке дағдыларды сынамаймыз.
Dialogue: 0,0:20:34.87,0:20:38.21,Default - Copy,Irene,0,0,0,,Ұйым тәртібін бұзғандарға жазаны орындау
Dialogue: 0,0:20:38.75,0:20:41.11,Default - Copy,Irene,0,0,0,,Барлығы қарсыласыңызды қалай аяқтау керектігі туралы.
Dialogue: 0,0:20:42.35,0:20:44.15,Default - Copy,Irene,0,0,0,,Біз бақылаймыз.
Dialogue: 0,0:20:44.58,0:20:46.82,Default - Copy,Irene,0,0,0,,Бар күшіңізбен
Dialogue: 0,0:20:46.82,0:20:49.12,Default - Copy,Irene,0,0,0,,Терезаны өлтіру туралы ойланыңыз.
Dialogue: 0,0:21:02.17,0:21:03.30,Default - Copy,Priscilla,0,0,0,,Түсінікті
Dialogue: 0,0:21:03.74,0:21:04.77,Default - Copy,Priscilla,0,0,0,,Жеңіліс
Dialogue: 0,0:21:05.41,0:21:08.64,Default - Copy,Priscilla,0,0,0,,Біз ұйымымызды бұзатын кез келген адамға шыдай алмаймыз.
Dialogue: 0,0:21:09.54,0:21:11.18,Default - Copy,Priscilla,0,0,0,,Кешіріңіз, Тереза.
Dialogue: 0,0:21:11.81,0:21:14.45,Default - Copy,Priscilla,0,0,0,,Мүмкін болса, мен жеке-жеке күрескенді қалар едім.
Dialogue: 0,0:21:14.88,0:21:17.85,Default - Copy,Priscilla,0,0,0,,Бірақ бәріне сен кінәлісің.
Dialogue: 0,0:22:40.40,0:22:43.51,Default - Copy,,0,0,0,,Қорқыныш туады
Dialogue: 0,0:22:43.51,0:22:46.54,Default - Copy,,0,0,0,,Қорқыныш трагедия шымылдығын көтереді
Dialogue: 0,0:22:48.04,0:22:54.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory