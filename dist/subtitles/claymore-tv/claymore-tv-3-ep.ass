Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.06,0:00:23.16,Default - Copy,priestA,0,0,0,,Білемін, білемін!
Dialogue: 0,0:00:23.59,0:00:25.96,Default - Copy,priestA,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:00:25.96,0:00:27.46,Default - Copy,priestB,0,0,0,,Неліктен бұл ұнайды?
Dialogue: 0,0:00:28.73,0:00:29.98,Default - Copy,priestA,0,0,0,,епископ Винсент
Dialogue: 0,0:00:30.33,0:00:33.47,Default - Copy,Vincent,0,0,0,,Менің ойымша, мен оларға қоңырау шалуым керек.
Dialogue: 0,0:00:33.87,0:00:34.94,Default - Copy,priestA,0,0,0,,Шақыру деген нені білдіреді?
Dialogue: 0,0:00:35.37,0:00:36.54,Default - Copy,priestA,0,0,0,,Мүмкін емес
Dialogue: 0,0:00:36.54,0:00:37.34,Default - Copy,Vincent,0,0,0,,Иә.
Dialogue: 0,0:00:37.71,0:00:38.97,Default - Copy,priestA,0,0,0,,Дегенмен
Dialogue: 0,0:00:38.97,0:00:40.51,Default - Copy,priestA,0,0,0,,Қалалық жазбалар
Dialogue: 0,0:00:40.51,0:00:43.22,Default - Copy,Vincent,0,0,0,,Бұл ереже сияқты нәрселерді айтатын уақыт емес.
Dialogue: 0,0:00:43.22,0:00:46.28,Default - Copy,Vincent,0,0,0,,Әйтпесе, біз
Dialogue: 0,0:00:47.58,0:00:49.03,Default - Copy,Vincent,0,0,0,,Соңы
Dialogue: 0,0:01:59.70,0:02:00.60,Default - Copy,Clare,0,0,0,,Рабона
Dialogue: 0,0:02:01.26,0:02:03.54,Default - Copy,Clare,0,0,0,,Қасиетті қала деп аталған қала?
Dialogue: 0,0:02:05.16,0:02:07.20,Default - Copy,Clare,0,0,0,,Бірақ Рабона сенімді
Dialogue: 0,0:02:07.53,0:02:08.63,Default - Copy,Rubel,0,0,0,,Иә.
Dialogue: 0,0:02:09.03,0:02:14.55,Default - Copy,Rubel,0,0,0,,Қасиетті Лабона қаласына ешбір күдікті заттарды кіргізуге болмайды.
Dialogue: 0,0:02:15.00,0:02:18.88,Default - Copy,Rubel,0,0,0,,Әрине, бұл саз балшық деп аталатын бізге де қатысты.
Dialogue: 0,0:02:19.51,0:02:22.29,Default - Copy,Clare,0,0,0,,Сонда бізге көрінетін перде, т.б.
Dialogue: 0,0:02:22.71,0:02:24.95,Default - Copy,Rubel,0,0,0,,Жағдайлар маңызды емес
Dialogue: 0,0:02:25.25,0:02:30.15,Default - Copy,Rubel,0,0,0,,Бұл жолы біздің қатысуымыз белгісіз қалаға кіріп кеттік.
Dialogue: 0,0:02:30.49,0:02:33.82,Default - Copy,Rubel,0,0,0,,Жынды тез тауып өлтіріңіз
Dialogue: 0,0:02:34.82,0:02:37.36,Default - Copy,Rubel,0,0,0,,Бұл жұмыстың мазмұны.
Dialogue: 0,0:02:37.76,0:02:40.31,Default - Copy,Clare,0,0,0,,Бұл жасырын операция ма?
Dialogue: 0,0:02:40.60,0:02:42.78,Default - Copy,Rubel,0,0,0,,Егер сіз бұл дәріні қабылдасаңыз
Dialogue: 0,0:02:42.78,0:02:45.37,Default - Copy,Rubel,0,0,0,,Сиқырлы күшіңізді аздап басыңыз
Dialogue: 0,0:02:45.37,0:02:47.70,Default - Copy,Rubel,0,0,0,,Оның көздері де қалыпты түсіне оралады.
Dialogue: 0,0:02:48.54,0:02:52.79,Default - Copy,Rubel,0,0,0,,Алайда жындар арқылы көру қабілеті жойылады.
Dialogue: 0,0:02:53.44,0:02:55.71,Default - Copy,Rubel,0,0,0,,Яғни, қалашыққа енгеннен кейін.
Dialogue: 0,0:02:56.05,0:03:01.53,Default - Copy,Rubel,0,0,0,,Бұл жай ғана серуендеп, жындарды іздеу керек дегенді білдіреді.
Dialogue: 0,0:03:02.12,0:03:06.69,Default - Copy,Rubel,0,0,0,,Егер мен ол баланы інім десем,
Dialogue: 0,0:03:06.69,0:03:11.54,Default - Copy,Rubel,0,0,0,,Бұл қалаға күдік туғызбай кіруге болатынын білдіреді.
Dialogue: 0,0:03:22.74,0:03:24.42,Default - Copy,owner,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:03:24.42,0:03:27.64,Default - Copy,owner,0,0,0,,Бір адам ғана түне алады ма?
Dialogue: 0,0:03:27.64,0:03:28.75,Default - Copy,Raki,0,0,0,,Жоқ
Dialogue: 0,0:03:31.58,0:03:32.85,Default - Copy,Clare,0,0,0,,Екі адам.
Dialogue: 0,0:03:32.85,0:03:34.43,Default - Copy,Clare,0,0,0,,Бауырларыммен саяхаттау
Dialogue: 0,0:03:35.32,0:03:38.15,Default - Copy,Clare,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:03:41.17,0:03:44.03,Default - Copy,Raki,0,0,0,,Уау, бұл өте жақсы бөлме.
Dialogue: 0,0:03:45.53,0:03:48.30,Default - Copy,Clare,0,0,0,,Әулие қала деген қала ғой.
Dialogue: 0,0:03:49.13,0:03:51.60,Default - Copy,Clare,0,0,0,,Тиісті қондырғылар бар.
Dialogue: 0,0:03:53.87,0:03:55.27,Default - Copy,Raki,0,0,0,,Мен шаршадым, Клэр.
Dialogue: 0,0:03:55.67,0:03:56.84,Default - Copy,Clare,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:03:56.84,0:03:58.01,Default - Copy,Clare,0,0,0,,Бұл дәрінің арқасында.
Dialogue: 0,0:03:58.67,0:04:00.49,Default - Copy,Raki,0,0,0,,Сәл демалу керек
Dialogue: 0,0:04:00.49,0:04:01.54,Default - Copy,Clare,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:04:02.48,0:04:03.68,Default - Copy,Clare,0,0,0,,Өзіңе сенесің бе?
Dialogue: 0,0:04:03.68,0:04:04.58,Default - Copy,Clare,0,0,0,,Мен шығамын
Dialogue: 0,0:04:05.78,0:04:07.76,Default - Copy,owner,0,0,0,,Эй, сыртқа шығайық.
Dialogue: 0,0:04:07.76,0:04:11.12,Default - Copy,Clare,0,0,0,,Иә, мен қаланы аралап көрейін.
Dialogue: 0,0:04:11.12,0:04:13.40,Default - Copy,owner,0,0,0,,Иә, қош келдіңіз.
Dialogue: 0,0:04:18.86,0:04:19.64,Default - Copy,Clare,0,0,0,,Не болды?
Dialogue: 0,0:04:20.16,0:04:23.13,Default - Copy,Raki,0,0,0,,Аа, ол үнемі өзгеріп отырады.
Dialogue: 0,0:04:23.13,0:04:25.14,Default - Copy,Raki,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:04:25.14,0:04:27.47,Default - Copy,Clare,0,0,0,,Мен біраз дайындықтан өттім.
Dialogue: 0,0:04:27.47,0:04:29.27,Default - Copy,Clare,0,0,0,,Асылдың қызының қылығынан
Dialogue: 0,0:04:29.27,0:04:31.65,Default - Copy,Clare,0,0,0,,Сіз тіпті жезөкшенің бейнесін жасай аласыз.
Dialogue: 0,0:04:31.65,0:04:33.11,Default - Copy,Raki,0,0,0,,жезөкше
Dialogue: 0,0:04:33.71,0:04:35.11,Default - Copy,Clare,0,0,0,,көрсетейін бе?
Dialogue: 0,0:04:35.11,0:04:37.16,Default - Copy,Raki,0,0,0,,Жоқ, жарайды, жарайды.
Dialogue: 0,0:04:57.23,0:04:59.17,Default - Copy,soldier,0,0,0,,Алда шомылдыру рәсімінен өтетін бөлме.
Dialogue: 0,0:04:59.17,0:05:02.08,Default - Copy,soldier,0,0,0,,Көпшіліктің кіруіне рұқсат бермеңіз.
Dialogue: 0,0:05:02.08,0:05:02.97,Default - Copy,Clare,0,0,0,,Иә
Dialogue: 0,0:05:02.97,0:05:06.59,Default - Copy,Clare,0,0,0,,Бүгін мен шомылдыру рәсімінен өтуге келдім.
Dialogue: 0,0:05:07.01,0:05:08.34,Default - Copy,soldier,0,0,0,,Дәлел бар ма?
Dialogue: 0,0:05:08.34,0:05:08.98,Default - Copy,Clare,0,0,0,,Иә
Dialogue: 0,0:05:12.15,0:05:14.09,Default - Copy,soldier,0,0,0,,Жарайды, кіріңіз.
Dialogue: 0,0:05:27.13,0:05:29.60,Default - Copy,Raki,0,0,0,,Уау, бұл жиіркенішті
Dialogue: 0,0:05:29.60,0:05:32.18,Default - Copy,Raki,0,0,0,,Бұрынғы ұлы тұлғаға тиесілі нәрсе ме?
Dialogue: 0,0:05:40.78,0:05:44.88,Default - Copy,Clare,0,0,0,,Қайда барсам да, жынның азғантай белгісін сезбеймін.
Dialogue: 0,0:05:47.72,0:05:48.89,Default - Copy,Vincent,0,0,0,,Олар
Dialogue: 0,0:05:48.89,0:05:51.20,Default - Copy,Vincent,0,0,0,,Егер сіз шомылдыру рәсімінен өткіңіз келсе, осы жерді басыңыз
Dialogue: 0,0:05:51.92,0:05:53.82,Default - Copy,Clare,0,0,0,,Сіз епископ Винсентсіз бе?
Dialogue: 0,0:05:54.26,0:05:54.86,Default - Copy,Vincent,0,0,0,,Иә
Dialogue: 0,0:05:55.79,0:05:57.90,Default - Copy,Clare,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:05:59.43,0:06:03.91,Default - Copy,Vincent,0,0,0,,Біз сені Құдайдың атымен шомылдыру рәсімінен өткіземіз.
Dialogue: 0,0:06:04.73,0:06:06.75,Default - Copy,Vincent,0,0,0,,Сіздің құдайыңыздың аты кім?
Dialogue: 0,0:06:07.70,0:06:09.98,Default - Copy,Clare,0,0,0,,Менің құдайымның аты – Лимут
Dialogue: 0,0:06:11.61,0:06:14.22,Default - Copy,Clare,0,0,0,,Бұл Каночи қызметкерлерінен.
Dialogue: 0,0:06:15.41,0:06:17.08,Default - Copy,Vincent,0,0,0,,Содан кейін сіз
Dialogue: 0,0:06:17.08,0:06:19.62,Default - Copy,Clare,0,0,0,,Тыныш, діни қызметкер.
Dialogue: 0,0:06:21.02,0:06:25.46,Default - Copy,Vincent,0,0,0,,Бүгін түнде собордың ең биік қоңырау мұнарасында.
Dialogue: 0,0:06:25.99,0:06:28.79,Default - Copy,Vincent,0,0,0,,Әскери жағдай түнде орындалады.
Dialogue: 0,0:06:29.19,0:06:30.60,Default - Copy,Vincent,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:31.09,0:06:33.63,Default - Copy,Clare,0,0,0,,Сіз айтқандай, діни қызметкер.
Dialogue: 0,0:06:42.37,0:06:43.81,Default - Copy,owner,0,0,0,,Антиквариат
Dialogue: 0,0:06:43.81,0:06:44.57,Default - Copy,Clare,0,0,0,,Иә
Dialogue: 0,0:06:44.97,0:06:49.12,Default - Copy,Clare,0,0,0,,Мен әкемнің көзі тірісінде жинаған заттарын сату арқылы күн көремін.
Dialogue: 0,0:06:49.81,0:06:52.45,Default - Copy,Clare,0,0,0,,Бұл соңғы өнім.
Dialogue: 0,0:06:52.92,0:06:55.52,Default - Copy,owner,0,0,0,,Хмм, қанша тұрады?
Dialogue: 0,0:06:55.52,0:06:57.97,Default - Copy,Clare,0,0,0,,Иә, он миллион белла.
Dialogue: 0,0:06:57.97,0:06:59.52,Default - Copy,owner,0,0,0,,Бір мың ай
Dialogue: 0,0:06:59.52,0:07:01.50,Default - Copy,owner,0,0,0,,Жоқ, ол сатылмайды.
Dialogue: 0,0:07:01.82,0:07:04.49,Default - Copy,Clare,0,0,0,,Иә, мен де солай ойлаймын.
Dialogue: 0,0:07:05.06,0:07:11.01,Default - Copy,Clare,0,0,0,,Алайда ағам екеуміз оны әкем күткен бағаға сатуды ұйғардық.
Dialogue: 0,0:07:11.01,0:07:12.94,Default - Copy,owner,0,0,0,,Ал, қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:07:14.44,0:07:16.81,Default - Copy,owner,0,0,0,,Амансың ба, аға?
Dialogue: 0,0:07:16.81,0:07:21.02,Default - Copy,Clare,0,0,0,,Күйеуіңіздің тамағы дәмді болды, аздап жеп қойған сияқты.
Dialogue: 0,0:07:21.02,0:07:23.35,Default - Copy,owner,0,0,0,,Мен оны үлкен порция жасадым.
Dialogue: 0,0:07:23.35,0:07:28.33,Default - Copy,owner,0,0,0,,Әй, бұл қала түнде соғыс жағдайында, сондықтан сыртта...
Dialogue: 0,0:07:28.82,0:07:30.86,Default - Copy,Clare,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:07:30.86,0:07:32.09,Default - Copy,owner,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:07:32.09,0:07:33.62,Default - Copy,owner,0,0,0,,Уақытыңызды алыңыз
Dialogue: 0,0:07:38.09,0:07:39.36,Default - Copy,Clare,0,0,0,,Ято-сама!
Dialogue: 0,0:07:39.36,0:07:41.80,Default - Copy,Clare,0,0,0,,Мен екі адамды тамақтандырдым.
Dialogue: 0,0:07:41.80,0:07:43.10,Default - Copy,Raki,0,0,0,,Хмм, жарайды.
Dialogue: 0,0:07:43.43,0:07:45.88,Default - Copy,Raki,0,0,0,,Клэр көп тамақ жемейді.
Dialogue: 0,0:07:46.40,0:07:49.44,Default - Copy,Raki,0,0,0,,Оның үстіне мен аспаз болып келдім.
Dialogue: 0,0:07:49.44,0:07:51.19,Default - Copy,Raki,0,0,0,,Бұл табиғи жұмыс.
Dialogue: 0,0:07:51.19,0:07:53.89,Default - Copy,Raki,0,0,0,,Менің ойымша, оның мағынасы басқаша.
Dialogue: 0,0:08:02.45,0:08:03.86,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:08:06.52,0:08:08.26,Default - Copy,Raki,0,0,0,,Абайлаңыз
Dialogue: 0,0:08:10.19,0:08:11.36,Default - Copy,Clare,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:08:11.36,0:08:12.60,Default - Copy,Clare,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:08:43.53,0:08:45.76,Default - Copy,Clare,0,0,0,,Чоримуттан бұйрықтар алынды
Dialogue: 0,0:08:45.76,0:08:49.00,Default - Copy,Clare,0,0,0,,Штаб еліндегі ұйымнан саусақ келді.
Dialogue: 0,0:08:50.01,0:08:52.28,Default - Copy,Clare,0,0,0,,Осы Лабон жерінен жұмыс сұрау
Dialogue: 0,0:08:54.00,0:08:55.78,Default - Copy,Clare,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:09:00.14,0:09:03.59,Default - Copy,Vincent,0,0,0,,Бірінші болып священник Ван өлді.
Dialogue: 0,0:09:04.38,0:09:09.92,Default - Copy,Vincent,0,0,0,,Содан кейін бірінен соң бірі менің әріптестерім Тара құрбандыққа шалынды.
Dialogue: 0,0:09:11.32,0:09:13.99,Default - Copy,Vincent,0,0,0,,Барлығы осы собордың ішінде
Dialogue: 0,0:09:15.22,0:09:19.83,Default - Copy,Vincent,0,0,0,,Құдайға қызмет ететін біз қалайша дәрменсіз өлтірілуі мүмкін?
Dialogue: 0,0:09:20.74,0:09:21.93,Default - Copy,Vincent,0,0,0,,Мені кешіру керек пе?
Dialogue: 0,0:09:22.63,0:09:24.17,Default - Copy,Clare,0,0,0,,Жындар тең
Dialogue: 0,0:09:25.80,0:09:28.57,Default - Copy,Clare,0,0,0,,Сіз дін қызметкерісіз бе, әлде атеистсіз бе
Dialogue: 0,0:09:28.91,0:09:31.17,Default - Copy,Clare,0,0,0,,Ер адамсың ба, әйелсің бе
Dialogue: 0,0:09:31.17,0:09:32.94,Default - Copy,Clare,0,0,0,,Мүлдем байланысты емес
Dialogue: 0,0:09:32.94,0:09:34.22,Default - Copy,Vincent,0,0,0,,Дегенмен
Dialogue: 0,0:09:34.22,0:09:36.55,Default - Copy,Clare,0,0,0,,Ішкі мүшелер бітелгенше
Dialogue: 0,0:09:36.55,0:09:38.22,Default - Copy,Clare,0,0,0,,Біз бәріміз бірдейміз
Dialogue: 0,0:09:38.71,0:09:39.58,Default - Copy,Vincent,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:09:39.58,0:09:41.05,Default - Copy,Vincent,0,0,0,,Жоқ, жасама!
Dialogue: 0,0:09:41.05,0:09:42.82,Default - Copy,Vincent,0,0,0,,Мен саған кез келген соманы беремін
Dialogue: 0,0:09:42.82,0:09:43.92,Default - Copy,Clare,0,0,0,,Маған ақша керек емес
Dialogue: 0,0:09:45.29,0:09:46.42,Default - Copy,Clare,0,0,0,,Жұмысты орындағаннан кейін
Dialogue: 0,0:09:46.42,0:09:49.43,Default - Copy,Clare,0,0,0,,Оны жинау үшін біреу келуі керек.
Dialogue: 0,0:09:49.76,0:09:51.43,Default - Copy,Clare,0,0,0,,Тек сол уақытта тапсырыңыз.
Dialogue: 0,0:09:51.93,0:09:54.71,Default - Copy,Clare,0,0,0,,Егер мен сәтсіздікке ұшырап, оған дейін өлсем
Dialogue: 0,0:09:54.71,0:09:56.93,Default - Copy,Clare,0,0,0,,Төлеудің қажеті жоқ.
Dialogue: 0,0:09:58.53,0:10:01.71,Default - Copy,Clare,0,0,0,,Шынымды айтсам, бұл жолы мен кінәлі болуым мүмкін.
Dialogue: 0,0:10:05.27,0:10:08.78,Default - Copy,Clare,0,0,0,,Құдайға қызмет ететін діни қызметкерден бір өтінішім бар.
Dialogue: 0,0:10:09.08,0:10:10.19,Default - Copy,Vincent,0,0,0,,Сұраныс
Dialogue: 0,0:10:10.71,0:10:13.15,Default - Copy,Clare,0,0,0,,Егер мен өлетін болсам
Dialogue: 0,0:10:13.62,0:10:17.00,Default - Copy,Clare,0,0,0,,Менімен бірге алып келе жатқан балаға қамқорлық жасай аласыз ба?
Dialogue: 0,0:10:18.22,0:10:19.36,Default - Copy,Clare,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:10:19.66,0:10:21.50,Default - Copy,Clare,0,0,0,,Қарапайым бала
Dialogue: 0,0:10:21.79,0:10:25.13,Default - Copy,Clare,0,0,0,,Алайда менің отбасымды жындар өлтірді, менің туыстарым жоқ.
Dialogue: 0,0:10:26.40,0:10:28.46,Default - Copy,Clare,0,0,0,,Тіпті діни қызметкердің қамқоршысы
Dialogue: 0,0:10:28.46,0:10:30.37,Default - Copy,Clare,0,0,0,,Тіпті собор тазалаушылары да
Dialogue: 0,0:10:30.37,0:10:31.51,Default - Copy,Clare,0,0,0,,Жақында «Сакура Саку» орындалды деген хабар келеді.
Dialogue: 0,0:10:32.87,0:10:33.97,Default - Copy,Vincent,0,0,0,,Түсінікті
Dialogue: 0,0:10:33.97,0:10:35.51,Default - Copy,Vincent,0,0,0,,Сіздің өтінішіңізді қабылдаймыз.
Dialogue: 0,0:10:35.91,0:10:42.04,Default - Copy,Vincent,0,0,0,,Мен Құдайға қызмет ететін діни қызметкер болсам да, мен өз өмірім туралы ғана ойлаймын.
Dialogue: 0,0:10:42.75,0:10:50.00,Default - Copy,Vincent,0,0,0,,Жиренішті жартылай адам, жартылай жын өлтіруші ретінде
Dialogue: 0,0:10:50.55,0:10:54.89,Default - Copy,Vincent,0,0,0,,Сіз өз өміріңізден гөрі өзіңізбен бірге алып келген балаға көбірек көңіл бөлесіз.
Dialogue: 0,0:10:56.39,0:10:57.33,Default - Copy,Clare,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:10:57.76,0:10:58.76,Default - Copy,Clare,0,0,0,,Алғыс айту
Dialogue: 0,0:11:16.48,0:11:19.15,Default - Copy,Galk,0,0,0,,Түнгі коменданттық сағат туралы білесіз бе?
Dialogue: 0,0:11:19.92,0:11:24.42,Default - Copy,Galk,0,0,0,,Егер сіз оны елемесеңіз
Dialogue: 0,0:11:24.82,0:11:28.02,Default - Copy,Sid,0,0,0,,88га Сіз мұны істейсіз, солай ма?
Dialogue: 0,0:11:28.32,0:11:30.59,Default - Copy,Sid,0,0,0,,Мен сенің соққыңнан құтылдым.
Dialogue: 0,0:11:31.56,0:11:35.11,Default - Copy,Sid,0,0,0,,Менің пышағым кептеліп қалған болуы керек.
Dialogue: 0,0:11:41.04,0:11:42.55,Default - Copy,Galk,0,0,0,,Бұл
Dialogue: 0,0:11:46.71,0:11:47.59,Default - Copy,Sid,0,0,0,,Менің пышағым
Dialogue: 0,0:11:49.61,0:11:51.26,Default - Copy,Sid,0,0,0,,Бұл
Dialogue: 0,0:11:54.95,0:11:55.60,Default - Copy,Sid,0,0,0,,Әйел
Dialogue: 0,0:12:00.67,0:12:02.33,Default - Copy,Sid,0,0,0,,«Біз оның әйелі мен балаларын қауіпсіз жерге жеткіздік»
Dialogue: 0,0:12:02.33,0:12:03.26,Default - Copy,Galk,0,0,0,,Сен жай ғана... отты қайта тұтаттың, иә?
Dialogue: 0,0:12:03.26,0:12:04.16,Default - Copy,Galk,0,0,0,,Енді кеш қалды.
Dialogue: 0,0:12:04.66,0:12:06.96,Default - Copy,Sid,0,0,0,,Менің пышағым оған қадалып қалды
Dialogue: 0,0:12:07.36,0:12:09.14,Default - Copy,Sid,0,0,0,,Егер біз мұны қазір жасасақ, біз артықшылыққа ие боламыз.
Dialogue: 0,0:12:09.77,0:12:11.97,Default - Copy,Galk,0,0,0,,Міне, ол маған кері лақтырған пышақ.
Dialogue: 0,0:12:12.37,0:12:14.72,Default - Copy,Galk,0,0,0,,Қанның ізі де, иісі де жоқ.
Dialogue: 0,0:12:14.72,0:12:16.48,Default - Copy,Sid,0,0,0,,Не?
Dialogue: 0,0:12:17.44,0:12:19.24,Default - Copy,Sid,0,0,0,,Бұл – ең құнды ойыншы, иә?
Dialogue: 0,0:12:33.82,0:12:34.62,Default - Copy,soldierA,0,0,0,,Не болды?
Dialogue: 0,0:12:35.26,0:12:36.93,Default - Copy,soldierB,0,0,0,,Мен шу естідім
Dialogue: 0,0:12:51.27,0:12:52.34,Default - Copy,soldierA,0,0,0,,Неліктен?
Dialogue: 0,0:12:53.51,0:12:57.48,Default - Copy,soldierA,0,0,0,,Бұл собордың іші мұқият тексерілді.
Dialogue: 0,0:12:57.48,0:12:58.85,Default - Copy,soldierA,0,0,0,,Бұл дәл Сталкер мырзаның бетіне ұқсайды.
Dialogue: 0,0:13:10.24,0:13:11.99,Default - Copy,Raki,0,0,0,,Иә, Клэр
Dialogue: 0,0:13:14.23,0:13:15.57,Default - Copy,Clare,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:13:17.43,0:13:18.30,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:13:18.30,0:13:19.31,Default - Copy,Raki,0,0,0,,Көздер
Dialogue: 0,0:13:20.47,0:13:21.27,Default - Copy,Clare,0,0,0,,А
Dialogue: 0,0:13:21.70,0:13:24.64,Default - Copy,Clare,0,0,0,,Бұл дәрі жарты күнге ғана жетеді.
Dialogue: 0,0:13:25.01,0:13:28.95,Default - Copy,Clare,0,0,0,,Сондықтан әсер сөнген сайын оны қайта қабылдауға тура келеді.
Dialogue: 0,0:13:30.32,0:13:32.45,Default - Copy,Raki,0,0,0,,А, су кіріп келеді.
Dialogue: 0,0:13:33.32,0:13:36.33,Default - Copy,Clare,0,0,0,,Соборда біраз қозғалыс бар сияқты.
Dialogue: 0,0:13:42.39,0:13:43.53,Default - Copy,Sid,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:13:43.53,0:13:44.69,Default - Copy,Sid,0,0,0,,Бұл жынның өзгеруі.
Dialogue: 0,0:13:44.69,0:13:46.57,Default - Copy,Raki,0,0,0,,Не?
Dialogue: 0,0:13:47.06,0:13:52.80,Default - Copy,Galk,0,0,0,,Кеше собордан ішкі мүшелерін жындар жеп кеткен сарбаздың мүрдесі табылды.
Dialogue: 0,0:13:53.37,0:13:55.08,Default - Copy,Galk,0,0,0,,Ынтымақтастықты сұраңыз
Dialogue: 0,0:13:55.08,0:13:56.24,Default - Copy,Sid,0,0,0,,Оған не болды?
Dialogue: 0,0:13:56.24,0:13:59.51,Default - Copy,Sid,0,0,0,,Ол осылай киінген.
Dialogue: 0,0:13:59.88,0:14:04.09,Default - Copy,Sid,0,0,0,,Кеше шатырда жүгіріп жүрген күдікті әйел
Dialogue: 0,0:14:04.81,0:14:08.03,Default - Copy,Sid,0,0,0,,Сен кеше қалаға келдің, солай ма?
Dialogue: 0,0:14:08.48,0:14:09.95,Default - Copy,Raki,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:14:13.19,0:14:17.59,Default - Copy,Sid,0,0,0,,Мен кешегі әйелді жын болды деп ешқашан айтқан емеспін.
Dialogue: 0,0:14:17.89,0:14:22.33,Default - Copy,Sid,0,0,0,,Бірақ қарапайым жігіт ондай нәрсені істей алмайды.
Dialogue: 0,0:14:22.33,0:14:24.77,Default - Copy,Sid,0,0,0,,Бұл күміс көзді сиқыршы сияқты жақсы емес пе?
Dialogue: 0,0:14:28.84,0:14:31.02,Default - Copy,Sid,0,0,0,,Ол өте жақсы әйел, солай емес пе?
Dialogue: 0,0:14:31.02,0:14:32.31,Default - Copy,Raki,0,0,0,,Жақсы
Dialogue: 0,0:14:32.31,0:14:34.18,Default - Copy,Raki,0,0,0,,Дәріні ішуге уақытында жеттім.
Dialogue: 0,0:14:35.52,0:14:40.65,Default - Copy,Sid,0,0,0,,Бірақ екінші адам өз денесін жынға сатқан жартылай адам, жартылай жын бақсы.
Dialogue: 0,0:14:41.25,0:14:46.20,Default - Copy,Sid,0,0,0,,Көздің түсін өзгертуге болатыны қызық емес пе?
Dialogue: 0,0:14:48.29,0:14:50.36,Default - Copy,Sid,0,0,0,,Не істеп жатырсың, балақай?
Dialogue: 0,0:14:50.36,0:14:51.66,Default - Copy,Raki,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:14:51.66,0:14:54.40,Default - Copy,Raki,0,0,0,,Менің апама қандай өзімшіл сөздер айттыңыз?
Dialogue: 0,0:14:54.40,0:14:59.05,Default - Copy,Raki,0,0,0,,Менің әпкем басқалардан мейірімді, жүрегі әдемі.
Dialogue: 0,0:14:59.05,0:15:02.38,Default - Copy,Raki,0,0,0,,Ештеңені білмесең де, білетіндей әрекет жасама.
Dialogue: 0,0:15:02.84,0:15:04.12,Default - Copy,Sid,0,0,0,,Гаки
Dialogue: 0,0:15:04.47,0:15:05.54,Default - Copy,Sid,0,0,0,,Гарк
Dialogue: 0,0:15:05.54,0:15:06.71,Default - Copy,Galk,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:15:06.71,0:15:07.94,Default - Copy,Galk,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:15:10.75,0:15:11.85,Default - Copy,Raki,0,0,0,,Абай бол, Твайлайт.
Dialogue: 0,0:15:11.85,0:15:13.45,Default - Copy,Raki,0,0,0,,Ой, кесіп таста!
Dialogue: 0,0:15:15.69,0:15:18.40,Default - Copy,Clare,0,0,0,,Бұлай айтудың өзі ақымақтық.
Dialogue: 0,0:15:18.99,0:15:20.02,Default - Copy,Raki,0,0,0,,Жоқ
Dialogue: 0,0:15:20.49,0:15:22.69,Default - Copy,Raki,0,0,0,,Бірақ ол менің әпкем екені өтірік.
Dialogue: 0,0:15:22.69,0:15:27.91,Default - Copy,Raki,0,0,0,,Мен сенің мейірімді, жүрегің сұлу екеніңізге шын сенемін.
Dialogue: 0,0:15:29.70,0:15:30.53,Default - Copy,Raki,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:15:30.90,0:15:35.78,Default - Copy,Clare,0,0,0,,Мен ол жігіттің сені ұруын тоқтатпаған болар едім.
Dialogue: 0,0:15:37.87,0:15:41.04,Default - Copy,Clare,0,0,0,,Менен жақсылық қаласаң, жасама.
Dialogue: 0,0:15:41.04,0:15:44.26,Default - Copy,Clare,0,0,0,,Бәлкім, бір күні мені сатып жіберіп, ренжітіп алармын.
Dialogue: 0,0:15:47.95,0:15:48.92,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:15:53.02,0:15:56.53,Default - Copy,Clare,0,0,0,,Екі сарбаздың да ішкі мүшелерін жеп қойған.
Dialogue: 0,0:15:56.53,0:15:57.16,Default - Copy,Vincent,0,0,0,,Иә
Dialogue: 0,0:15:58.19,0:16:01.74,Default - Copy,Clare,0,0,0,,Басқа адамның тәбеті қалыпты емес сияқты.
Dialogue: 0,0:16:02.13,0:16:04.31,Default - Copy,Vincent,0,0,0,,Тәбеті бұзылған адам
Dialogue: 0,0:16:04.67,0:16:07.57,Default - Copy,Clare,0,0,0,,Ұзақ өмір сүретін жындардың тәбеті артады.
Dialogue: 0,0:16:07.57,0:16:09.14,Default - Copy,Clare,0,0,0,,Айлакер болу
Dialogue: 0,0:16:09.14,0:16:10.32,Default - Copy,Clare,0,0,0,,Бұл қиын болуы мүмкін
Dialogue: 0,0:16:10.97,0:16:15.15,Default - Copy,Clare,0,0,0,,Тәбеті бұзылған адамды біз осылай атаймыз.
Dialogue: 0,0:16:17.35,0:16:20.68,Default - Copy,Clare,0,0,0,,Мүмкін осы соборда жасырынып жүрген шығар
Dialogue: 0,0:16:20.68,0:16:23.06,Default - Copy,Clare,0,0,0,,Табиғи жауымыз, көзіміз жақсы
Dialogue: 0,0:16:23.69,0:16:27.12,Default - Copy,Clare,0,0,0,,Жын-шайтандарды табу қабілетіне мөр басатын шығар.
Dialogue: 0,0:16:27.89,0:16:30.80,Default - Copy,Vincent,0,0,0,,Бізде бәрі жақсы ма?
Dialogue: 0,0:16:30.80,0:16:32.63,Default - Copy,Clare,0,0,0,,Мен ақпарат алғым келеді
Dialogue: 0,0:16:33.30,0:16:36.50,Default - Copy,Clare,0,0,0,,Кеше түнде соборға кірген адамдар
Dialogue: 0,0:16:37.03,0:16:41.48,Default - Copy,Clare,0,0,0,,Тіпті түнде собордың ішінде қала алатын адам.
Dialogue: 0,0:16:41.84,0:16:44.52,Default - Copy,Vincent,0,0,0,,Түн ортасында кіруге болмайды.
Dialogue: 0,0:16:44.52,0:16:50.41,Default - Copy,Vincent,0,0,0,,Кейбір діни қызметкерлер мен монахтар
Dialogue: 0,0:16:57.62,0:17:01.97,Default - Copy,Clare,0,0,0,,Ішінде деп ойлаған дұрыс сияқты.
Dialogue: 0,0:17:02.46,0:17:07.26,Default - Copy,Clare,0,0,0,,Бірақ мен әлі собордың ішінде екенімді білмеймін.
Dialogue: 0,0:17:07.96,0:17:10.03,Default - Copy,Clare,0,0,0,,Неліктен тар кеңістікті қалайсыз?
Dialogue: 0,0:17:11.98,0:17:12.94,Default - Copy,Clare,0,0,0,,бір нәрсеге бірдеңе ілініп қалды
Dialogue: 0,0:17:13.54,0:17:15.94,Default - Copy,Clare,0,0,0,,Мен маңызды нәрсені ұмытып бара жатқандай сезінемін.
Dialogue: 0,0:17:19.64,0:17:20.68,Default - Copy,Galk,0,0,0,,Ол қозғалды.
Dialogue: 0,0:17:20.68,0:17:22.69,Default - Copy,Sid,0,0,0,,Сол әйел ме?
Dialogue: 0,0:17:34.27,0:17:37.59,Default - Copy,Sid,0,0,0,,Жарайды, мен бұдан былай сылтауларды тыңдамаймын.
Dialogue: 0,0:17:37.59,0:17:40.36,Default - Copy,Sid,0,0,0,,Інінің қамын ойлаған мейірімді апа.
Dialogue: 0,0:17:42.34,0:17:43.83,Default - Copy,Sid,0,0,0,,Күміс көздер
Dialogue: 0,0:17:44.43,0:17:47.15,Default - Copy,Sid,0,0,0,,Бүгін түнде тіпті жүзіңіз басқаша.
Dialogue: 0,0:17:47.74,0:17:50.21,Default - Copy,Clare,0,0,0,,Кешіріңіз, бірақ уақытым таусылып жатыр.
Dialogue: 0,0:17:50.87,0:17:53.01,Default - Copy,Clare,0,0,0,,Егер сіз кедергі келтіретін болсаңыз, мен сізге оңай жол бермеймін.
Dialogue: 0,0:17:54.31,0:17:57.12,Default - Copy,Clare,0,0,0,,Егер олар сізді шақырса, дайын болыңыз.
Dialogue: 0,0:17:58.51,0:17:59.59,Default - Copy,Sid,0,0,0,,...
Dialogue: 0,0:18:18.31,0:18:20.47,Default - Copy,Sid,0,0,0,,Бұл екі қылыш қиын.
Dialogue: 0,0:18:20.47,0:18:21.57,Default - Copy,Sid,0,0,0,,Бірдеңе жасауға болады
Dialogue: 0,0:18:21.57,0:18:22.78,Default - Copy,Galk,0,0,0,,Байқап көріңіз
Dialogue: 0,0:18:28.56,0:18:30.06,Default - Copy,Galk,0,0,0,,Әлі де
Dialogue: 0,0:18:42.86,0:18:43.86,Default - Copy,Sid,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:18:44.16,0:18:46.40,Default - Copy,Sid,0,0,0,,Күміс көзді сиқыршы Клеймор?
Dialogue: 0,0:18:48.23,0:18:49.17,Default - Copy,Galk,0,0,0,,Собор
Dialogue: 0,0:18:50.97,0:18:52.44,Default - Copy,Sid,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:18:52.44,0:18:53.41,Default - Copy,Sid,0,0,0,,Мен сені қуамын
Dialogue: 0,0:18:54.07,0:18:55.74,Default - Copy,soldierA,0,0,0,,Бұл не деген айқай?
Dialogue: 0,0:18:59.54,0:19:01.39,Default - Copy,soldierB,0,0,0,,Қазір кім?
Dialogue: 0,0:19:06.48,0:19:07.28,Default - Copy,Clare,0,0,0,,Иә
Dialogue: 0,0:19:07.75,0:19:09.12,Default - Copy,Clare,0,0,0,,Бұл күшті рух.
Dialogue: 0,0:19:10.45,0:19:12.02,Default - Copy,Clare,0,0,0,,Бұл препараттың жанама әсері ме?
Dialogue: 0,0:19:12.56,0:19:15.49,Default - Copy,Clare,0,0,0,,Мен әлі де жынның тұрған жерін анықтай алмаймын.
Dialogue: 0,0:19:21.66,0:19:22.67,Default - Copy,Clare,0,0,0,,Күзетші?
Dialogue: 0,0:19:24.53,0:19:26.31,Default - Copy,Clare,0,0,0,,Тамақтанатын ішкі мүшелер
Dialogue: 0,0:19:26.64,0:19:28.97,Default - Copy,Clare,0,0,0,,Тағы да тәбеті бұзылған адам
Dialogue: 0,0:19:37.48,0:19:40.06,Default - Copy,Clare,0,0,0,,Мен мұнда мұнша көп жын-перілер жасырынып жүр деп күтпедім.
Dialogue: 0,0:19:43.09,0:19:44.89,Default - Copy,Sid,0,0,0,,Бұл не?
Dialogue: 0,0:19:44.89,0:19:46.36,Default - Copy,Galk,0,0,0,,Бұл жын
Dialogue: 0,0:19:46.36,0:19:47.29,Default - Copy,Clare,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:20:05.45,0:20:08.24,Default - Copy,Sid,0,0,0,,Не? Бұл не?
Dialogue: 0,0:20:08.24,0:20:10.46,Default - Copy,Galk,0,0,0,,Мына жігіт қайда?
Dialogue: 0,0:20:18.59,0:20:19.23,Default - Copy,Galk,0,0,0,,Кел
Dialogue: 0,0:20:36.21,0:20:37.22,Default - Copy,Sid,0,0,0,,Оқ жаудырыңдар! Бүйіріне нысана ал!
Dialogue: 0,0:20:40.51,0:20:42.19,Default - Copy,Sid,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:47.73,0:20:49.10,Default - Copy,Galk,0,0,0,,Бұл
Dialogue: 0,0:20:49.49,0:20:50.30,Default - Copy,Clare,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:20:52.70,0:20:54.67,Default - Copy,Clare,0,0,0,,Балалар, сендер менімен тең емессіңдер.
Dialogue: 0,0:21:00.93,0:21:01.76,Default - Copy,Clare,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:21:01.76,0:21:02.84,Default - Copy,Clare,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:22:41.27,0:22:43.77,Default - Copy,,0,0,0,,Жаныңды бер, жаныңды сақта
Dialogue: 0,0:22:45.27,0:22:51.27,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory