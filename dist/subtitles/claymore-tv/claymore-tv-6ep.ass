Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.32,0:00:03.95,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:00:04.52,0:00:06.25,Default - Copy,Teresa,0,0,0,,Клэр ше?
Dialogue: 0,0:00:06.95,0:00:11.42,Default - Copy,Teresa,0,0,0,,Сұлу, таза, махаббатқа толы егіз құдайлардың аты.
Dialogue: 0,0:00:12.49,0:00:16.20,Default - Copy,Teresa,0,0,0,,Қайтыс болған ата-анаңның сезімдері сенің атыңда мәңгі сақталады.
Dialogue: 0,0:00:17.26,0:00:18.16,Default - Copy,Teresa,0,0,0,,Олай болса кеттік.
Dialogue: 0,0:01:35.24,0:01:36.21,Default - Copy,Teresa,0,0,0,,Сәлем Клэр
Dialogue: 0,0:01:36.74,0:01:37.68,Default - Copy,Teresa,0,0,0,,Келіңіз және көріңіз
Dialogue: 0,0:01:42.15,0:01:43.75,Default - Copy,Teresa,0,0,0,,Бұл Рокуто қаласы.
Dialogue: 0,0:01:44.25,0:01:46.05,Default - Copy,Teresa,0,0,0,,Мен ертең кешке келемін.
Dialogue: 0,0:01:46.79,0:01:48.75,Default - Copy,Teresa,0,0,0,,Бұл менің сенімен қоштасуым.
Dialogue: 0,0:01:50.42,0:01:51.89,Default - Copy,Teresa,0,0,0,,Бұл бетті жасамаңыз
Dialogue: 0,0:01:52.32,0:01:55.26,Default - Copy,Teresa,0,0,0,,Сіз менімен әлдеқайда бақытты боласыз.
Dialogue: 0,0:01:58.20,0:01:59.60,Default - Copy,Teresa,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:02:00.00,0:02:04.04,Default - Copy,Teresa,0,0,0,,Мен сені қалаға жеткенің үшін бірден қуып жібермеймін.
Dialogue: 0,0:02:04.67,0:02:06.51,Default - Copy,Teresa,0,0,0,,Мен қамқор болатын адам табамын.
Dialogue: 0,0:02:07.14,0:02:08.11,Default - Copy,Teresa,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:02:19.35,0:02:21.45,Default - Copy,Teresa,0,0,0,,Ұйықтаймын деп жылап алдың ба?
Dialogue: 0,0:02:22.52,0:02:24.02,Default - Copy,Teresa,0,0,0,,Қызықты жігіт
Dialogue: 0,0:02:24.59,0:02:29.09,Default - Copy,Teresa,0,0,0,,Менен осылай бөлініп кеткеніңе ұзақ жыладың.
Dialogue: 0,0:02:30.40,0:02:34.20,Default - Copy,Teresa,0,0,0,,Мен Рокуто қаласында қандай адам болсам да.
Dialogue: 0,0:02:34.97,0:02:37.14,Default - Copy,Teresa,0,0,0,,Бұл менімен болғаннан әлдеқайда жақсы.
Dialogue: 0,0:02:38.00,0:02:42.01,Default - Copy,Teresa,0,0,0,,Ең болмаса адам болып өмір сүре аласың.
Dialogue: 0,0:02:44.34,0:02:45.21,Default - Copy,Teresa,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:02:57.66,0:02:58.59,Default - Copy,Teresa,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:02:58.59,0:03:00.06,Default - Copy,Teresa,0,0,0,,Бұл бір нәрсе үшін бе?
Dialogue: 0,0:03:01.76,0:03:03.03,Default - Copy,Rig,0,0,0,,Э? Қайда?
Dialogue: 0,0:03:03.63,0:03:05.00,Default - Copy,Rig,0,0,0,,Э? Қайда?
Dialogue: 0,0:03:05.36,0:03:06.70,Default - Copy,Rig,0,0,0,,Мен бұны шатастырып жатырмын
Dialogue: 0,0:03:07.33,0:03:09.37,Default - Copy,Teresa,0,0,0,,Мен сенің артымнан келе жатқаныңды білдім.
Dialogue: 0,0:03:10.00,0:03:12.77,Default - Copy,Teresa,0,0,0,,Өзіңізге дұрыс күтім жасап, қамқорлық жасасаңыз,
Dialogue: 0,0:03:12.77,0:03:16.18,Default - Copy,Teresa,0,0,0,,Бактериялар жара арқылы енген жоқ.
Dialogue: 0,0:03:18.68,0:03:22.71,Default - Copy,Teresa,0,0,0,,Кек алу үшін менің өмірімді алмақ болсаң, олай етпе.
Dialogue: 0,0:03:23.32,0:03:28.69,Default - Copy,Teresa,0,0,0,,Ережелер қаншалықты қатал болса да, егер сіздің өміріңізге қауіп төнсе, сіз табиғи түрде күресесіз.
Dialogue: 0,0:03:30.26,0:03:32.26,Default - Copy,Rig,0,0,0,,Мен мұны білемін
Dialogue: 0,0:03:32.76,0:03:34.69,Default - Copy,Rig,0,0,0,,Өмірді мақсат етпе
Dialogue: 0,0:03:35.19,0:03:36.30,Default - Copy,Rig,0,0,0,,Өмір
Dialogue: 0,0:03:36.30,0:03:37.33,Default - Copy,Teresa,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:03:38.43,0:03:40.33,Default - Copy,Rig,0,0,0,,Мен оны шатастырып аламын.
Dialogue: 0,0:03:40.33,0:03:43.20,Default - Copy,Rig,0,0,0,,Өзіңіздің мақтанышыңыз бен құрметіңізді мұқият сақтаңыз.
Dialogue: 0,0:03:44.04,0:03:45.37,Default - Copy,Teresa,0,0,0,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:03:45.80,0:03:46.94,Default - Copy,Teresa,0,0,0,,Менің денем
Dialogue: 0,0:03:46.94,0:03:48.91,Default - Copy,Rig,0,0,0,,Қарсысыз ба?
Dialogue: 0,0:03:48.91,0:03:51.94,Default - Copy,Rig,0,0,0,,Мен сені ұятқа қалдыруым керек.
Dialogue: 0,0:03:52.31,0:03:56.68,Default - Copy,Rig,0,0,0,,Мен мұңайғаным сонша, енді шыдай алмаймын.
Dialogue: 0,0:03:58.12,0:03:59.55,Default - Copy,Teresa,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:04:00.59,0:04:02.22,Default - Copy,Teresa,0,0,0,,Міне, сондықтан да адамдар
Dialogue: 0,0:04:03.99,0:04:08.29,Default - Copy,Teresa,0,0,0,,Біз кім үшін күресеміз?
Dialogue: 0,0:04:09.06,0:04:12.13,Default - Copy,Rig,0,0,0,,Маған ол жүзі басынан ұнамады.
Dialogue: 0,0:04:12.13,0:04:15.53,Default - Copy,Rig,0,0,0,,Сол кісіге менсінбей қараған түрі есімде.
Dialogue: 0,0:04:16.37,0:04:21.04,Default - Copy,Rig,0,0,0,,Мен сіздің қуыршақтай бетіңізді ренжітіп, бұрмалаймын.
Dialogue: 0,0:04:29.01,0:04:30.58,Default - Copy,Rig,0,0,0,,Бұл бала
Dialogue: 0,0:04:30.58,0:04:32.38,Default - Copy,Rig,0,0,0,,Әзіл!
Dialogue: 0,0:04:34.65,0:04:36.72,Default - Copy,Rig,0,0,0,,Менімен араласпа, қарғыс атқыр бала.
Dialogue: 0,0:04:36.72,0:04:37.82,Default - Copy,Rig,0,0,0,,Ақымақ болма.
Dialogue: 0,0:04:39.19,0:04:40.99,Default - Copy,Rig,0,0,0,,Мен сені өлтірейін бе?
Dialogue: 0,0:04:46.77,0:04:48.93,Default - Copy,Rig,0,0,0,,Менің қанжарымды не істейсің?
Dialogue: 0,0:04:50.04,0:04:53.77,Default - Copy,Rig,0,0,0,,Мені өлтірсең, олар сенің басыңды нысанаға алатын шығар.
Dialogue: 0,0:04:53.77,0:04:56.07,Default - Copy,Rig,0,0,0,,Бұл темір заң, солай ма?
Dialogue: 0,0:04:56.07,0:04:57.81,Default - Copy,Rig,0,0,0,,Жақсысың ба?
Dialogue: 0,0:04:57.81,0:05:00.61,Default - Copy,Teresa,0,0,0,,Сіз дұрыс түсінбеген сияқтысыз, сондықтан айтайын.
Dialogue: 0,0:05:01.31,0:05:03.25,Default - Copy,Teresa,0,0,0,,Ереже жай ғана ереже
Dialogue: 0,0:05:03.25,0:05:06.12,Default - Copy,Teresa,0,0,0,,Қорғау немесе қорғамау әр адамның өз еркінде.
Dialogue: 0,0:05:06.12,0:05:07.85,Default - Copy,Teresa,0,0,0,,Өсиеттерді орында
Dialogue: 0,0:05:08.22,0:05:11.12,Default - Copy,Teresa,0,0,0,,Ережені бұзып, достарың өлтіру
Dialogue: 0,0:05:12.29,0:05:14.23,Default - Copy,Teresa,0,0,0,,Бұл біздің еркіндігіміз
Dialogue: 0,0:05:17.70,0:05:18.40,Default - Copy,Teresa,0,0,0,,«Бұрын ол жетімдер үйін басқарған».
Dialogue: 0,0:05:18.96,0:05:21.47,Default - Copy,Teresa,0,0,0,,Мен сені өлтіруімді қаламасаң.
Dialogue: 0,0:05:26.64,0:05:27.94,Default - Copy,Teresa,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:05:31.64,0:05:33.45,Default - Copy,Teresa,0,0,0,,Сен тұра аласың ба, Клэр?
Dialogue: 0,0:05:40.02,0:05:41.39,Default - Copy,Teresa,0,0,0,,Ой
Dialogue: 0,0:05:45.89,0:05:46.89,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:05:47.93,0:05:52.70,Default - Copy,Clare,0,0,0,,Көп нәрсе
Dialogue: 0,0:05:54.27,0:05:56.64,Default - Copy,Teresa,0,0,0,,Сіз сөйлей аласыз ба?
Dialogue: 0,0:05:57.87,0:06:00.64,Default - Copy,Clare,0,0,0,,Бұл әрқашан ауыр болды.
Dialogue: 0,0:06:02.87,0:06:05.61,Default - Copy,Teresa,0,0,0,,Түсіндім, сіз бұл туралы айтып отырсыз ба?
Dialogue: 0,0:06:06.18,0:06:07.35,Default - Copy,Teresa,0,0,0,,Ал Кира
Dialogue: 0,0:06:07.78,0:06:10.22,Default - Copy,Teresa,0,0,0,,Бұл қорқынышты көрінеді, бірақ ол ауырмайды.
Dialogue: 0,0:06:10.65,0:06:12.15,Default - Copy,Teresa,0,0,0,,Бұл жай ғана осылай көрінеді.
Dialogue: 0,0:06:12.15,0:06:16.92,Default - Copy,Clare,0,0,0,,Содан бері Терезаның көзі үнемі ауырады.
Dialogue: 0,0:06:17.32,0:06:21.16,Default - Copy,Clare,0,0,0,,Ауырды, ауырды, шыдамайтындай көрінді.
Dialogue: 0,0:06:22.43,0:06:25.56,Default - Copy,Clare,0,0,0,,Оның көзі менімен бірдей еді.
Dialogue: 0,0:06:26.10,0:06:30.87,Default - Copy,Clare,0,0,0,,Жан азапты, жалғыздықты, шыдай алмайтындай көріндің.
Dialogue: 0,0:06:31.34,0:06:33.41,Default - Copy,Clare,0,0,0,,Сондықтан
Dialogue: 0,0:06:36.41,0:06:40.45,Default - Copy,Teresa,0,0,0,,Құшақтаған мен болдым.
Dialogue: 0,0:06:41.25,0:06:43.62,Default - Copy,Teresa,0,0,0,,Қымбат бір нәрсені жын алып кетті
Dialogue: 0,0:06:43.62,0:06:45.55,Default - Copy,Teresa,0,0,0,,Сенетін адамдарыңның сатқындығы
Dialogue: 0,0:06:45.55,0:06:46.62,Default - Copy,Teresa,0,0,0,,Тастанды
Dialogue: 0,0:06:48.02,0:06:51.99,Default - Copy,Teresa,0,0,0,,Әр жерге өмір сүру мүмкіндігінен айырылғандар келді
Dialogue: 0,0:06:52.56,0:06:57.46,Default - Copy,Teresa,0,0,0,,Бір жағдайда бірге күтудің жан азабы
Dialogue: 0,0:06:58.00,0:07:01.80,Default - Copy,Teresa,0,0,0,,Сол кезде менің кішкентай денем қорқыныштан дірілдеп тұратын.
Dialogue: 0,0:07:02.20,0:07:07.27,Default - Copy,Teresa,0,0,0,,Сіз өзіңіз сияқты ренжіген адамды бар күшіңізбен құшақтап тұрмын дейсіз бе?
Dialogue: 0,0:07:08.31,0:07:15.15,Default - Copy,Teresa,0,0,0,,Міне, мен өзіме де осыны қаладым.
Dialogue: 0,0:07:19.38,0:07:22.99,Default - Copy,Teresa,0,0,0,,Денесі менің жарты өлшемімде болатын кішкентай қыз
Dialogue: 0,0:07:24.02,0:07:25.89,Default - Copy,Teresa,0,0,0,,Тіпті күміс көздерден
Dialogue: 0,0:07:26.66,0:07:28.53,Default - Copy,Teresa,0,0,0,,Көз жасын шығара білу
Dialogue: 0,0:07:29.26,0:07:31.23,Default - Copy,Teresa,0,0,0,,Мені үйретті
Dialogue: 0,0:07:40.77,0:07:42.31,Default - Copy,Teresa,0,0,0,,О, саған жарасады, солай емес пе?
Dialogue: 0,0:07:42.94,0:07:44.04,Default - Copy,Teresa,0,0,0,,Мұны істейік
Dialogue: 0,0:07:46.08,0:07:47.35,Default - Copy,Clare,0,0,0,,Бірақ бұл
Dialogue: 0,0:07:47.35,0:07:49.78,Default - Copy,Teresa,0,0,0,,Уайымдама, бізде ақша бар
Dialogue: 0,0:07:50.42,0:07:52.72,Default - Copy,Teresa,0,0,0,,Мен Roku-ны өз бетімше қолдана алар едім.
Dialogue: 0,0:07:53.29,0:07:56.79,Default - Copy,Teresa,0,0,0,,Ендеше, онымен барайық.
Dialogue: 0,0:08:06.06,0:08:07.60,Default - Copy,villager1,0,0,0,,Керемет
Dialogue: 0,0:08:07.97,0:08:09.70,Default - Copy,villager2,0,0,0,,Бір ғана соққымен
Dialogue: 0,0:08:09.70,0:08:11.87,Default - Copy,villager3,0,0,0,,А, бұл саз балшық па?
Dialogue: 0,0:08:13.14,0:08:14.61,Default - Copy,chief,0,0,0,,Рахмет
Dialogue: 0,0:08:14.61,0:08:18.88,Default - Copy,chief,0,0,0,,Мен сенен жынды тез жояды деп ойламаппын.
Dialogue: 0,0:08:18.88,0:08:19.91,Default - Copy,Teresa,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:08:20.25,0:08:21.35,Default - Copy,Teresa,0,0,0,,Бұл жай ғана миссия.
Dialogue: 0,0:08:21.35,0:08:26.32,Default - Copy,chief,0,0,0,,Өйткені, мұндай таулармен қоршалған қалада қашып құтылудың жолы жоқ.
Dialogue: 0,0:08:26.32,0:08:30.36,Default - Copy,chief,0,0,0,,О, бұл уәде етілген сый.
Dialogue: 0,0:08:31.12,0:08:34.16,Default - Copy,Teresa,0,0,0,,Оны кейінірек алуға қара киінген адам келеді.
Dialogue: 0,0:08:35.13,0:08:37.10,Default - Copy,Teresa,0,0,0,,Оған беріңіз.
Dialogue: 0,0:08:37.96,0:08:39.00,Default - Copy,chief,0,0,0,,Ах ха
Dialogue: 0,0:08:39.33,0:08:40.10,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:08:42.73,0:08:43.97,Default - Copy,Teresa,0,0,0,,Менің бір өтінішім бар.
Dialogue: 0,0:08:46.91,0:08:50.98,Default - Copy,Teresa,0,0,0,,Мына жігітті осы қалада қалдыра аласыз ба?
Dialogue: 0,0:08:52.34,0:08:54.48,Default - Copy,chief,0,0,0,,Кешіріңіз, бірақ бала
Dialogue: 0,0:08:55.05,0:08:57.22,Default - Copy,Teresa,0,0,0,,Бұл менің сапарымда көтеріп алған балам.
Dialogue: 0,0:08:57.98,0:09:00.25,Default - Copy,Teresa,0,0,0,,Менің қасымда болғаның үшін сен жын емессің.
Dialogue: 0,0:09:00.75,0:09:03.72,Default - Copy,Teresa,0,0,0,,Мен ата-анамнан айырылдым, басқа туыстарым жоқ.
Dialogue: 0,0:09:04.42,0:09:07.46,Default - Copy,Teresa,0,0,0,,Бала алғысы келетіндер де болса, риза болар едім.
Dialogue: 0,0:09:09.06,0:09:12.16,Default - Copy,chief,0,0,0,,Өйткені ол бастапқыда тауда, балалары аз қала.
Dialogue: 0,0:09:12.16,0:09:15.13,Default - Copy,chief,0,0,0,,Оны қалайтындар бар деп ойлаймын.
Dialogue: 0,0:09:15.13,0:09:16.84,Default - Copy,Teresa,0,0,0,,Бұл ыңғайлы.
Dialogue: 0,0:09:17.40,0:09:18.14,Default - Copy,Teresa,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:09:25.28,0:09:26.11,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:09:26.61,0:09:27.11,Default - Copy,Clare,0,0,0,,Қажет емес
Dialogue: 0,0:09:28.45,0:09:30.12,Default - Copy,Clare,0,0,0,,Бұл бізге керек емес.
Dialogue: 0,0:09:31.48,0:09:33.15,Default - Copy,Clare,0,0,0,,Әдемі киім
Dialogue: 0,0:09:33.15,0:09:34.62,Default - Copy,Clare,0,0,0,,Әдемі аяқ киім де
Dialogue: 0,0:09:34.62,0:09:36.12,Default - Copy,Clare,0,0,0,,Маған ештеңе керек емес
Dialogue: 0,0:09:36.49,0:09:38.46,Default - Copy,Clare,0,0,0,,Ендеше мен сенімен бірге болуға рұқсат етемін
Dialogue: 0,0:09:39.09,0:09:42.13,Default - Copy,Clare,0,0,0,,Мен Терезамен мәңгі бірге болғым келеді.
Dialogue: 0,0:09:42.76,0:09:44.83,Default - Copy,Clare,0,0,0,,Өйткені маған басқа ештеңе керек емес
Dialogue: 0,0:09:46.63,0:09:47.70,Default - Copy,Clare,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:09:47.70,0:09:49.40,Default - Copy,Clare,0,0,0,,Терезаны өтінемін
Dialogue: 0,0:09:49.40,0:09:50.20,Default - Copy,Clare,0,0,0,,Мен
Dialogue: 0,0:09:52.67,0:09:53.44,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:09:54.07,0:09:57.34,Default - Copy,Teresa,0,0,0,,Көріп отырғаныңыздай, менің жұмысым жындарды өлтіру.
Dialogue: 0,0:09:57.81,0:10:01.18,Default - Copy,Teresa,0,0,0,,Басқа істеуге ештеңе жоқ, бар болу үшін ешқандай себеп жоқ.
Dialogue: 0,0:10:02.11,0:10:02.78,Default - Copy,Clare,0,0,0,,Бірақ
Dialogue: 0,0:10:03.45,0:10:07.82,Default - Copy,Teresa,0,0,0,,Ақырында, мен сені жұмысқа қосып, қауіп төндіремін.
Dialogue: 0,0:10:08.69,0:10:12.76,Default - Copy,Teresa,0,0,0,,Өйткені, сіз бен біз әртүрлі әлемде өмір сүреміз.
Dialogue: 0,0:10:16.53,0:10:18.63,Default - Copy,Teresa,0,0,0,,Басқалар арасында адам сияқты өмір сүр
Dialogue: 0,0:10:20.43,0:10:21.73,Default - Copy,Teresa,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:10:22.13,0:10:24.00,Default - Copy,Teresa,0,0,0,,Мен сені ұмытпаймын
Dialogue: 0,0:10:26.10,0:10:27.31,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:10:27.31,0:10:29.47,Default - Copy,Clare,0,0,0,,I I
Dialogue: 0,0:10:30.74,0:10:34.11,Default - Copy,Teresa,0,0,0,,Клэр сияқты бақытты бол
Dialogue: 0,0:10:39.85,0:10:41.39,Default - Copy,woman,0,0,0,,Қара, қара!
Dialogue: 0,0:10:41.39,0:10:45.79,Default - Copy,woman,0,0,0,,Қыздар көпшілік алдында жалаңаш жүрмеуі керек.
Dialogue: 0,0:10:45.79,0:10:47.86,Default - Copy,woman,0,0,0,,Қараңдаршы, мына киімдер сүйкімді емес пе?
Dialogue: 0,0:10:53.47,0:10:55.50,Default - Copy,Teresa,0,0,0,,Олай болса, өтінемін
Dialogue: 0,0:10:56.03,0:10:57.27,Default - Copy,man,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:10:57.60,0:11:00.51,Default - Copy,man,0,0,0,,Мен бұл баланың бақытсыздыққа ұшырауына ешқашан жол бермеймін.
Dialogue: 0,0:11:06.98,0:11:08.01,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:11:08.95,0:11:11.25,Default - Copy,Teresa,0,0,0,,Басқалар арасында тұлға ретінде өмір сүріңіз
Dialogue: 0,0:11:12.35,0:11:16.76,Default - Copy,Teresa,0,0,0,,Мен қалаған дүние бар, мен саған ешқашан бере алмаймын.
Dialogue: 0,0:11:17.49,0:11:22.76,Default - Copy,Teresa,0,0,0,,Онда адам болып өмір сүр, адам болып өмір сүр, адам болып өл.
Dialogue: 0,0:11:24.06,0:11:29.33,Default - Copy,Teresa,0,0,0,,Адам үшін ең бақыттысы да осы болса керек.
Dialogue: 0,0:11:31.74,0:11:33.77,Default - Copy,Teresa,0,0,0,,Қоштасу Клэр
Dialogue: 0,0:11:55.76,0:11:56.86,Default - Copy,Teresa,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:12:03.47,0:12:04.40,Default - Copy,Teresa,0,0,0,,Бұл абайсызда болды.
Dialogue: 0,0:12:04.87,0:12:07.94,Default - Copy,Teresa,0,0,0,,Таудың тереңінде ұрыны кездестіру біртүрлі деп ойладым.
Dialogue: 0,0:12:08.54,0:12:10.94,Default - Copy,Teresa,0,0,0,,Олар әу бастан артымызда болды.
Dialogue: 0,0:12:12.04,0:12:14.38,Default - Copy,Teresa,0,0,0,,Таудың тереңінде, Ешкім бармайды
Dialogue: 0,0:12:14.38,0:12:16.38,Default - Copy,Teresa,0,0,0,,Қашып құтыла алмайтын қала
Dialogue: 0,0:12:16.38,0:12:19.75,Default - Copy,Teresa,0,0,0,,Алайда мен қалада жын бар екенін білдім.
Dialogue: 0,0:12:19.75,0:12:20.99,Default - Copy,Teresa,0,0,0,,Мен оған көмектесе алмадым
Dialogue: 0,0:12:21.82,0:12:25.02,Default - Copy,Teresa,0,0,0,,Осылайша, жындар - бұл қаланың тосқауылдары.
Dialogue: 0,0:12:25.22,0:12:27.33,Default - Copy,Teresa,0,0,0,,Мен оны жойдым
Dialogue: 0,0:12:35.67,0:12:37.20,Default - Copy,screams,0,0,0,,Жоқ, жасама!
Dialogue: 0,0:12:46.51,0:12:47.35,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:12:48.25,0:12:49.25,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:12:49.48,0:12:50.85,Default - Copy,leader,0,0,0,,Ер адамды өлтіріңіз
Dialogue: 0,0:12:50.85,0:12:52.48,Default - Copy,leader,0,0,0,,Әйелді ұрлау
Dialogue: 0,0:12:52.48,0:12:55.09,Default - Copy,leader,0,0,0,,Барлығын алып кетіңіз
Dialogue: 0,0:12:56.12,0:13:00.23,Default - Copy,leader,0,0,0,,Күміс көзді бақсының арқасында мен алаңсыз жұмыс істей аламын.
Dialogue: 0,0:13:00.76,0:13:04.46,Default - Copy,leader,0,0,0,,Біз үшін ол бақсыдан гөрі әулие.
Dialogue: 0,0:13:12.70,0:13:15.61,Default - Copy,man,0,0,0,,Оған сол қашықтықтан қалай жетуге болады?
Dialogue: 0,0:13:16.74,0:13:21.98,Default - Copy,leader,0,0,0,,Менің сұңқар қылышым жеңілмейді.
Dialogue: 0,0:13:31.92,0:13:33.96,Default - Copy,Rig,0,0,0,,Табылды
Dialogue: 0,0:13:37.43,0:13:39.03,Default - Copy,Rig,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:13:40.83,0:13:42.27,Default - Copy,leader,0,0,0,,Оя
Dialogue: 0,0:13:42.27,0:13:47.21,Default - Copy,leader,0,0,0,,Сізді осындай жерде кездестіргенім қандай кездейсоқтық.
Dialogue: 0,0:13:48.07,0:13:51.44,Default - Copy,leader,0,0,0,,Бұл қалада енді жындар болмауы керек.
Dialogue: 0,0:13:51.88,0:13:57.98,Default - Copy,leader,0,0,0,,Бұл қалада қанша адамды өлтірсек те, қанша тонасақ та,
Dialogue: 0,0:13:57.98,0:14:00.45,Default - Copy,leader,0,0,0,,Бұл жай ғана адамдар арасындағы оқиға.
Dialogue: 0,0:14:00.89,0:14:03.46,Default - Copy,leader,0,0,0,,Оның сендерге еш қатысы болмауы керек.
Dialogue: 0,0:14:03.82,0:14:07.96,Default - Copy,leader,0,0,0,,Әлде бізді тоқтату үшін бір минуттан астам уақыт келді ме?
Dialogue: 0,0:14:08.49,0:14:11.20,Default - Copy,leader,0,0,0,,Өзгелерді өлтіре алмайтын денемен
Dialogue: 0,0:14:15.60,0:14:16.50,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:14:19.00,0:14:20.04,Default - Copy,Rig,0,0,0,,Йо
Dialogue: 0,0:14:20.04,0:14:21.31,Default - Copy,Rig,0,0,0,,Бұл сен кімсің?
Dialogue: 0,0:14:21.94,0:14:24.14,Default - Copy,Rig,0,0,0,,Сіз бір нәрсені ұмыттыңыз ба?
Dialogue: 0,0:14:25.31,0:14:29.38,Default - Copy,Rig,0,0,0,,Уайымдама, мен бұл жігітке қамқор боламын.
Dialogue: 0,0:14:29.38,0:14:33.62,Default - Copy,Rig,0,0,0,,Уайымдама, мен саған көп қамқорлық жасаймын.
Dialogue: 0,0:14:36.09,0:14:39.32,Default - Copy,Rig,0,0,0,,Оның жылап тұрғанын көру сүйкімді болды.
Dialogue: 0,0:14:39.76,0:14:43.03,Default - Copy,Rig,0,0,0,,Тереза ​​Тереза ​​дегеніміз не?
Dialogue: 0,0:14:54.74,0:14:55.21,Default - Copy,Rig,0,0,0,,Бұл
Dialogue: 0,0:14:58.81,0:14:59.74,Default - Copy,Rig,0,0,0,,Бұл не?
Dialogue: 0,0:15:00.18,0:15:03.48,Default - Copy,Rig,0,0,0,,Ей, мынау менің қалған асыл қолым.
Dialogue: 0,0:15:04.45,0:15:05.78,Default - Copy,Rig,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:15:11.39,0:15:13.19,Default - Copy,Teresa,0,0,0,,Дайын болыңдар, балалар.
Dialogue: 0,0:15:16.03,0:15:19.56,Default - Copy,Teresa,0,0,0,,Жыннан да жаман деп өзіңді қарға.
Dialogue: 0,0:15:20.17,0:15:24.50,Default - Copy,Teresa,0,0,0,,Мен бәріңді өлтіремін.
Dialogue: 0,0:15:29.64,0:15:31.44,Default - Copy,leader,0,0,0,,Мен мұны жасадым
Dialogue: 0,0:15:31.74,0:15:35.48,Default - Copy,leader,0,0,0,,Клэймор ақыры біреуді өлтірді
Dialogue: 0,0:15:36.88,0:15:38.55,Default - Copy,leader,0,0,0,,Егер сіз бәрін өлтірсеңіз
Dialogue: 0,0:15:38.55,0:15:40.05,Default - Copy,leader,0,0,0,,Мені төмендетпе
Dialogue: 0,0:15:40.05,0:15:45.49,Default - Copy,leader,0,0,0,,Мен жын бар қалаға қол тигізе алмадым, бірақ оның нақты кім екенін білмедім.
Dialogue: 0,0:15:46.62,0:15:51.83,Default - Copy,leader,0,0,0,,Кімге қарсы күресіп жатқаныңызды көріп тұрсаңыз, ол жын ба, саз ба, бәрібір.
Dialogue: 0,0:15:51.83,0:15:54.23,Default - Copy,leader,0,0,0,,Мен сені ұрамын.
Dialogue: 0,0:16:03.61,0:16:05.61,Default - Copy,leader,0,0,0,,Жасайық
Dialogue: 0,0:16:05.91,0:16:10.88,Default - Copy,leader,0,0,0,,Менің алғашқы соққымнан бірінші болып жалтардың.
Dialogue: 0,0:16:19.66,0:16:21.86,Default - Copy,leader,0,0,0,,Оны қалай көресіз?
Dialogue: 0,0:16:22.23,0:16:25.16,Default - Copy,leader,0,0,0,,Сұңқар қылыштың шынайы табиғаты осы.
Dialogue: 0,0:16:25.16,0:16:30.87,Default - Copy,leader,0,0,0,,Қамшы тәрізді толқындар, қысқа қашықтықтан ұзақ қашықтыққа шабуыл жасауға мүмкіндік береді.
Dialogue: 0,0:16:31.27,0:16:33.87,Default - Copy,leader,0,0,0,,Адамның көзімен ұстау мүмкін емес
Dialogue: 0,0:16:34.34,0:16:37.14,Default - Copy,leader,0,0,0,,Менің қылышымды ешкім айналып өте алмайды
Dialogue: 0,0:16:37.14,0:16:40.11,Default - Copy,leader,0,0,0,,Бір уақытта маған тиісе де алмайсың.
Dialogue: 0,0:16:40.55,0:16:41.88,Default - Copy,leader,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:16:41.88,0:16:44.15,Default - Copy,leader,0,0,0,,Бұл менің қалтамда да жоқ.
Dialogue: 0,0:16:48.65,0:16:50.96,Default - Copy,leader,0,0,0,,О, бұл
Dialogue: 0,0:16:55.59,0:16:57.60,Default - Copy,bandit1,0,0,0,,Қуат басы
Dialogue: 0,0:17:07.61,0:17:10.24,Default - Copy,bandit2,0,0,0,,Джо. . . Бұл әзіл емес
Dialogue: 0,0:17:10.24,0:17:14.48,Default - Copy,bandit2,0,0,0,,Мұндай құбыжықпен күресу әу бастан дұрыс емес еді.
Dialogue: 0,0:17:14.98,0:17:16.08,Default - Copy,bandit2,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:17:16.08,0:17:17.32,Default - Copy,bandit2,0,0,0,,Бұл құбыжық.
Dialogue: 0,0:17:17.32,0:17:18.28,Default - Copy,bandit2,0,0,0,,жүрегі жұмсақ жандар әлі де басқаларға көмектеседі ғой, иә?
Dialogue: 0,0:17:18.28,0:17:19.05,Default - Copy,bandit2,0,0,0,,Гунта-сан
Dialogue: 0,0:17:34.77,0:17:36.80,Default - Copy,Teresa,0,0,0,,Сіз ояусыз ба, Клэр?
Dialogue: 0,0:17:38.50,0:17:39.64,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:17:47.01,0:17:49.45,Default - Copy,Orsay,0,0,0,,Сіз мұны ақырында орындадыңыз ба?
Dialogue: 0,0:17:51.08,0:17:53.99,Default - Copy,Orsay,0,0,0,,Мен бір күні осылай болатынын сезіндім.
Dialogue: 0,0:17:54.49,0:17:56.89,Default - Copy,Orsay,0,0,0,,Ережеде ерекшеліктер жоқ.
Dialogue: 0,0:17:57.92,0:18:02.76,Default - Copy,Orsay,0,0,0,,Кез келген адам немесе кез келген себеппен
Dialogue: 0,0:18:03.36,0:18:07.30,Default - Copy,Orsay,0,0,0,,Бұл ұят, жымиып Тереза.
Dialogue: 0,0:18:23.28,0:18:26.78,Default - Copy,Orsay,0,0,0,,Бұл болғаны үшін кешірім сұраймын, Тереза.
Dialogue: 0,0:18:27.45,0:18:29.72,Default - Copy,Teresa,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:18:29.72,0:18:32.49,Default - Copy,Clare,0,0,0,,Тереза Тереза
Dialogue: 0,0:18:32.49,0:18:34.19,Default - Copy,Teresa,0,0,0,,Шынымды айтсам, бұл таң қалдырды.
Dialogue: 0,0:18:35.43,0:18:37.73,Default - Copy,Teresa,0,0,0,,Мен бұлай болады деп ешқашан ойламадым.
Dialogue: 0,0:18:38.30,0:18:41.07,Default - Copy,Teresa,0,0,0,,Мен әрқашан сабырлы бола алатыныма сенімді болдым.
Dialogue: 0,0:18:42.07,0:18:43.47,Default - Copy,Teresa,0,0,0,,Мені ұмыт
Dialogue: 0,0:18:44.74,0:18:47.41,Default - Copy,Teresa,0,0,0,,Мен білмей тұрып, бәрі бітті.
Dialogue: 0,0:18:47.87,0:18:49.11,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:18:49.57,0:18:51.08,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:18:51.94,0:18:54.45,Default - Copy,Teresa,0,0,0,,Сізден соңғы бір нәрсе сұрасам болады ма?
Dialogue: 0,0:18:55.15,0:18:58.82,Default - Copy,Teresa,0,0,0,,Клэр, баламен не істеуді жоспарлап отырсың?
Dialogue: 0,0:18:59.28,0:19:01.09,Default - Copy,Orsay,0,0,0,,Білудің қажеті жоқ
Dialogue: 0,0:19:01.42,0:19:04.62,Default - Copy,Orsay,0,0,0,,Бұл енді сізді алаңдатпайды.
Dialogue: 0,0:19:05.46,0:19:06.59,Default - Copy,Teresa,0,0,0,,Мен көремін.
Dialogue: 0,0:19:07.09,0:19:08.13,Default - Copy,Teresa,0,0,0,,That's right.
Dialogue: 0,0:19:08.13,0:19:09.36,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:19:09.36,0:19:10.50,Default - Copy,Clare,0,0,0,,Мынаны ал, «Aerosmith»!
Dialogue: 0,0:19:10.50,0:19:11.83,Default - Copy,Clare,0,0,0,,Менің өлгім келмейді
Dialogue: 0,0:19:12.10,0:19:13.53,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:19:15.23,0:19:16.93,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:19:17.44,0:19:18.57,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:19:18.57,0:19:20.91,Default - Copy,Teresa,0,0,0,,Қоштасу Клэр
Dialogue: 0,0:19:20.91,0:19:23.14,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:19:51.90,0:19:53.44,Default - Copy,Teresa,0,0,0,,Жара терең емес
Dialogue: 0,0:19:54.31,0:19:57.68,Default - Copy,Teresa,0,0,0,,Егер сіз сиқырлы күш шығару арқылы жараны түзете алсаңыз.
Dialogue: 0,0:19:57.68,0:19:59.14,Default - Copy,Teresa,0,0,0,,Өте пайдалы
Dialogue: 0,0:20:00.38,0:20:00.85,Default - Copy,Teresa,0,0,0,,Нашар
Dialogue: 0,0:20:01.88,0:20:03.88,Default - Copy,Teresa,0,0,0,,Өйткені, мен әлі өле алмаймын.
Dialogue: 0,0:20:06.18,0:20:06.85,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:20:08.39,0:20:09.52,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:20:11.36,0:20:12.42,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:20:12.86,0:20:15.09,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:20:15.73,0:20:16.89,Default - Copy,Teresa,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:20:17.23,0:20:18.83,Default - Copy,Teresa,0,0,0,,Ол көп жылайды.
Dialogue: 0,0:20:19.56,0:20:22.07,Default - Copy,Orsay,0,0,0,,Сіз нені айтып тұрсыз, Тереза?
Dialogue: 0,0:20:22.83,0:20:25.17,Default - Copy,Teresa,0,0,0,,Мұның астарында терең мағына жоқ.
Dialogue: 0,0:20:25.17,0:20:28.57,Default - Copy,Teresa,0,0,0,,Бұл өте қарапайым және түсінуге оңай себеп.
Dialogue: 0,0:20:30.27,0:20:32.54,Default - Copy,Teresa,0,0,0,,Өмірдің мәнін таптым
Dialogue: 0,0:20:33.11,0:20:36.61,Default - Copy,Teresa,0,0,0,,Бұдан былай мен бұл жігіт үшін өмір сүруге тырысамын.
Dialogue: 0,0:20:45.42,0:20:47.53,Default - Copy,Orsay,0,0,0,,Сіз өкінесіз
Dialogue: 0,0:20:48.03,0:20:49.49,Default - Copy,Teresa,0,0,0,,Мен алмаймын.
Dialogue: 0,0:20:54.00,0:20:55.60,Default - Copy,Teresa,0,0,0,,Амал жоқ
Dialogue: 0,0:21:06.68,0:21:08.71,Default - Copy,???,0,0,0,,Бұл мәселеге айналды.
Dialogue: 0,0:21:09.45,0:21:14.49,Default - Copy,???,0,0,0,,Ұйымда ең мықты деп айтылатын күлімсіреген Терезаның сатқындығы қандай?
Dialogue: 0,0:21:16.02,0:21:18.62,Default - Copy,Orsay,0,0,0,,Бұл ерекше ештеңе емес.
Dialogue: 0,0:21:20.19,0:21:24.00,Default - Copy,Orsay,0,0,0,,2-ден 5-ке дейінгі сандарды шақыру.
Dialogue: 0,0:21:24.90,0:21:27.50,Default - Copy,Orsay,0,0,0,,Терезаны бағындыруға жіберу
Dialogue: 0,0:22:40.40,0:22:42.30,Default - Copy,,0,0,0,,Сатқындықтың себебі
Dialogue: 0,0:22:42.30,0:22:43.91,Default - Copy,,0,0,0,,Сатқындықтың бағасы
Dialogue: 0,0:22:43.91,0:22:47.01,Default - Copy,,0,0,0,,Ажырамайтын өсиет
Dialogue: 0,0:22:48.51,0:22:54.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory