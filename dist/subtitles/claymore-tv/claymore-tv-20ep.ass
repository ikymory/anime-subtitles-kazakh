Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.97,0:00:11.60,Default - Copy,dood,0,0,0,,Мен ат алдым
Dialogue: 0,0:00:13.97,0:00:14.61,Default - Copy,dood,0,0,0,,Келіңіздер
Dialogue: 0,0:00:16.81,0:00:20.68,Default - Copy,dood,0,0,0,,Егер сіз бізбен бірге барсаңыз, бұл шынымен көмектесер еді.
Dialogue: 0,0:00:20.68,0:00:22.98,Default - Copy,dood,0,0,0,,Бұл қыздың есімі Присцилла.
Dialogue: 0,0:00:22.98,0:00:26.07,Default - Copy,dood,0,0,0,,Адамдарға мұншалықты байланып қалуым жиі емес.
Dialogue: 0,0:00:26.42,0:00:30.59,Default - Copy,dood,0,0,0,,Сіздің оңтүстік иісіңіз менің отбасымды еске түсіре ме деп ойлаймын.
Dialogue: 0,0:00:31.72,0:00:32.58,Default - Copy,kid,0,0,0,,Отбасы
Dialogue: 0,0:00:32.99,0:00:33.89,Default - Copy,dood,0,0,0,,О
Dialogue: 0,0:00:33.89,0:00:36.08,Default - Copy,dood,0,0,0,,Оны жын жеп қойған көрінеді.
Dialogue: 0,0:00:41.20,0:00:42.13,Default - Copy,kid,0,0,0,,Бұл бала да
Dialogue: 0,0:00:45.24,0:00:46.26,Default - Copy,guy,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:00:47.91,0:00:50.23,Default - Copy,guy,0,0,0,,Жылқыда бірдеңе бар ма?
Dialogue: 0,0:00:50.23,0:00:52.73,Default - Copy,dood,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:00:52.73,0:00:54.45,Default - Copy,guy,0,0,0,,жақсы болар еді.
Dialogue: 0,0:00:54.45,0:00:56.78,Default - Copy,guy,0,0,0,,Егер сіз осыдан асып кетуді жоспарласаңыз.
Dialogue: 0,0:00:56.78,0:00:59.15,Default - Copy,guy,0,0,0,,Пьетадан алыс болғаныңыз жөн.
Dialogue: 0,0:00:59.62,0:01:03.61,Default - Copy,guy,0,0,0,,Шамасы, бұл жерде саз балшықтары көп жиналды.
Dialogue: 0,0:01:05.22,0:01:08.13,Default - Copy,guy,0,0,0,,Балшық бар жерде жын бар.
Dialogue: 0,0:01:08.13,0:01:09.79,Default - Copy,guy,0,0,0,,Қатыспағаның дұрыс.
Dialogue: 0,0:01:10.62,0:01:11.86,Default - Copy,guy,0,0,0,,Олай болса
Dialogue: 0,0:01:14.03,0:01:15.73,Default - Copy,kid,0,0,0,,Клеймор Пиетаға айналады
Dialogue: 0,0:01:20.61,0:01:23.60,Default - Copy,kid,0,0,0,,Кешіріңіз, мен сізбен бірге бара алмаймын.
Dialogue: 0,0:01:24.14,0:01:25.74,Default - Copy,kid,0,0,0,,Мен Пиетаға баруым керек
Dialogue: 0,0:01:25.74,0:01:26.60,Default - Copy,kid,0,0,0,,Олай болса
Dialogue: 0,0:01:26.60,0:01:28.05,Default - Copy,dood,0,0,0,,Күтіңіз
Dialogue: 0,0:01:28.45,0:01:31.25,Default - Copy,dood,0,0,0,,Біздің де саяхатты тоқтату ниетіміз жоқ.
Dialogue: 0,0:01:31.68,0:01:36.89,Default - Copy,dood,0,0,0,,Егер бұл Пьета болса, біз бір бағытта келе жатырмыз, сондықтан Прискила үшін, менімен бірге бара аласыз ба?
Dialogue: 0,0:01:38.76,0:01:39.71,Default - Copy,kid,0,0,0,,Бірақ мен
Dialogue: 0,0:01:40.16,0:01:42.69,Default - Copy,dood,0,0,0,,Пьетаға дейін әлі көп жол бар.
Dialogue: 0,0:01:42.69,0:01:44.86,Default - Copy,dood,0,0,0,,Меніңше, асыққанның қажеті жоқ.
Dialogue: 0,0:02:55.03,0:02:59.14,Default - Copy,dood,0,0,0,,Менімен бірге келгеніңіз үшін мен өзімді толығымен жеңілдеттім.
Dialogue: 0,0:03:00.94,0:03:04.64,Default - Copy,dood,0,0,0,,"Клейморды" бұрын естігенде жүзіңіз өзгерді.
Dialogue: 0,0:03:05.24,0:03:08.35,Default - Copy,dood,0,0,0,,Сіз іздеп жүрген адам балшық па?
Dialogue: 0,0:03:08.85,0:03:09.58,Default - Copy,kid,0,0,0,,Иә
Dialogue: 0,0:03:10.85,0:03:12.82,Default - Copy,dood,0,0,0,,Неліктен лаймор?
Dialogue: 0,0:03:13.38,0:03:19.09,Default - Copy,dood,0,0,0,,Ол бұрынғыдай жігіт емес, бірақ ол біреумен араласа алмайтын адам емес пе?
Dialogue: 0,0:03:19.56,0:03:21.33,Default - Copy,kid,0,0,0,,Мен үшін емес
Dialogue: 0,0:03:23.09,0:03:25.12,Default - Copy,kid,0,0,0,,Мен үшін Клэр
Dialogue: 0,0:03:25.12,0:03:27.36,Default - Copy,dood,0,0,0,,Клэр?
Dialogue: 0,0:03:31.87,0:03:32.94,Default - Copy,kid,0,0,0,,Клэр
Dialogue: 0,0:03:41.37,0:03:45.48,Default - Copy,kid,0,0,0,,Егер Клэр болмаса, мен қазір бұл жерде болмас едім.
Dialogue: 0,0:03:47.01,0:03:49.29,Default - Copy,kid,0,0,0,,Клэр үнемі маған қарайды
Dialogue: 0,0:03:51.08,0:03:53.79,Default - Copy,kid,0,0,0,,Сонымен, бұл жолы мен
Dialogue: 0,0:03:55.93,0:03:59.03,Default - Copy,kid,0,0,0,,Мен Клэрді қорғауды шештім.
Dialogue: 0,0:04:00.13,0:04:01.23,Default - Copy,dood,0,0,0,,Мен көремін.
Dialogue: 0,0:04:01.73,0:04:05.10,Default - Copy,dood,0,0,0,,Бұл аздап қайғылы адамдық шешім.
Dialogue: 0,0:04:06.50,0:04:08.61,Default - Copy,dood,0,0,0,,Жасалғаннан гөрі айту оңай
Dialogue: 0,0:04:08.61,0:04:11.21,Default - Copy,dood,0,0,0,,Бірақ сізде ондай күш бар ма?
Dialogue: 0,0:04:31.10,0:04:33.23,Default - Copy,kid,0,0,0,,Аспанда не болып жатыр?
Dialogue: 0,0:04:37.37,0:04:40.64,Default - Copy,dood,0,0,0,,Әлсіздер әрқашан сөзге жабысады
Dialogue: 0,0:04:41.17,0:04:45.64,Default - Copy,dood,0,0,0,,Ал күштілер әлсіздер үшін өледі.
Dialogue: 0,0:04:46.58,0:04:48.47,Default - Copy,dood,0,0,0,,Ортақ әңгіме
Dialogue: 0,0:04:51.48,0:04:52.72,Default - Copy,dood,0,0,0,,Тыңдаңыз
Dialogue: 0,0:04:52.72,0:04:54.25,Default - Copy,dood,0,0,0,,Күшсіздік - күнә
Dialogue: 0,0:04:54.68,0:04:56.99,Default - Copy,kid,0,0,0,,Күшсіздік - күнә
Dialogue: 0,0:05:00.83,0:05:01.93,Default - Copy,kid,0,0,0,,Өтінемін
Dialogue: 0,0:05:02.33,0:05:04.40,Default - Copy,kid,0,0,0,,Маған қылышты үйрете аласыз ба?
Dialogue: 0,0:05:05.13,0:05:05.96,Default - Copy,dood,0,0,0,,Қылыш
Dialogue: 0,0:05:06.63,0:05:08.90,Default - Copy,kid,0,0,0,,Сенің қылышың ғажап екенін көріп тұрмын.
Dialogue: 0,0:05:09.33,0:05:12.10,Default - Copy,kid,0,0,0,,Қылыш ағыны әдемі, босқа қимыл жоқ.
Dialogue: 0,0:05:12.10,0:05:14.20,Default - Copy,kid,0,0,0,,Толық деп айтасыз ба?
Dialogue: 0,0:05:14.57,0:05:15.41,Default - Copy,dood,0,0,0,,өтіңіз
Dialogue: 0,0:05:16.44,0:05:18.61,Default - Copy,dood,0,0,0,,Мен мұны аздап жасайтынмын.
Dialogue: 0,0:05:19.31,0:05:20.57,Default - Copy,dood,0,0,0,,Аз
Dialogue: 0,0:05:21.01,0:05:22.18,Default - Copy,kid,0,0,0,,Гвуу…
Dialogue: 0,0:05:22.58,0:05:28.05,Default - Copy,kid,0,0,0,,Мен Пиетаға бармас бұрын барынша күшті болғым келеді. өтінемін
Dialogue: 0,0:05:31.92,0:05:33.93,Default - Copy,dood,0,0,0,,Сенің көздерің жақсы.
Dialogue: 0,0:05:33.93,0:05:36.03,Default - Copy,dood,0,0,0,,Мүмкін сіз күшейерсіз
Dialogue: 0,0:05:39.76,0:05:43.10,Default - Copy,dood,0,0,0,,Жақсы, мен саған үйрете аламын.
Dialogue: 0,0:05:44.04,0:05:45.44,Default - Copy,kid,0,0,0,,Рахмет
Dialogue: 0,0:05:51.98,0:05:53.71,Default - Copy,dood,0,0,0,,ұшы бекітілмеген.
Dialogue: 0,0:05:54.28,0:05:56.47,Default - Copy,dood,0,0,0,,Қолыңызбен емес, денеңізбен тербеліңіз
Dialogue: 0,0:05:56.47,0:05:57.45,Default - Copy,kid,0,0,0,,Иә
Dialogue: 0,0:06:00.59,0:06:03.48,Default - Copy,kid,0,0,0,,Клэр Мен сені жақын арада көретінімізге сенімдімін.
Dialogue: 0,0:06:04.56,0:06:07.23,Default - Copy,kid,0,0,0,,Мен сені бұл жолы міндетті түрде қорғаймын
Dialogue: 0,0:06:15.67,0:06:18.50,Default - Copy,Clare,0,0,0,,Раки, аман болыңыз.
Dialogue: 0,0:06:30.62,0:06:36.12,Default - Copy,clay1,0,0,0,,Мен дайындалдым деп ойладым, бірақ Оянғандармен шайқас мұндай ауыр болады деп ешқашан ойламадым.
Dialogue: 0,0:06:36.45,0:06:39.79,Default - Copy,clay2,0,0,0,,Біздің аман қалғанымыз ғажайып дерлік.
Dialogue: 0,0:06:39.79,0:06:41.39,Default - Copy,clay2,0,0,0,,Ары қарай не боларын білмеймін
Dialogue: 0,0:06:41.76,0:06:45.63,Default - Copy,clay1,0,0,0,,Бірақ ең қорқыныштысы өлу емес.
Dialogue: 0,0:06:45.63,0:06:49.00,Default - Copy,clay1,0,0,0,,Бұл сіздің шекараңыздың шетінде тұрған шайқаста ояну туралы.
Dialogue: 0,0:06:49.50,0:06:51.50,Default - Copy,clay3,0,0,0,,Сіз немен айналысып жатырсыз?
Dialogue: 0,0:06:53.34,0:06:56.07,Default - Copy,clay3,0,0,0,,Осындай ұрыс сізді оята ма?
Dialogue: 0,0:06:56.07,0:06:57.48,Default - Copy,clay3,0,0,0,,Қорықпа
Dialogue: 0,0:06:57.77,0:06:59.31,Default - Copy,clay3,0,0,0,,Таку
Dialogue: 0,0:06:59.31,0:07:01.88,Default - Copy,clay3,0,0,0,,Мен мұндай ащы жерде ұйықтай алмаймын.
Dialogue: 0,0:07:03.61,0:07:05.08,Default - Copy,clay4,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:07:05.08,0:07:07.25,Default - Copy,clay4,0,0,0,,Капитан жай ғана қобалжыды.
Dialogue: 0,0:07:08.09,0:07:11.49,Default - Copy,clay4,0,0,0,,Егер дұрыс есімде болсам, ауыстырылатын жабдық келуі керек еді.
Dialogue: 0,0:07:12.02,0:07:15.13,Default - Copy,clay2,0,0,0,,Ах, шығыс қонақ үйдегі қойма.
Dialogue: 0,0:07:24.14,0:07:25.50,Default - Copy,clay4,0,0,0,,Мен көремін.
Dialogue: 0,0:07:25.50,0:07:28.74,Default - Copy,clay4,0,0,0,,Жабдықпен толық қамтылғаныңызға сенімдісіз бе?
Dialogue: 0,0:07:29.04,0:07:29.84,Default - Copy,clay3,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:07:31.34,0:07:32.54,Default - Copy,clay4,0,0,0,,Капитан?
Dialogue: 0,0:07:32.54,0:07:33.54,Default - Copy,clay4,0,0,0,,Бұл Денев.
Dialogue: 0,0:07:34.01,0:07:36.25,Default - Copy,clay4,0,0,0,,Мен бүлінген жабдықты ауыстыруға келдім.
Dialogue: 0,0:07:36.98,0:07:38.94,Default - Copy,clay3,0,0,0,,Мен қазір өзгеріп жатырмын.
Dialogue: 0,0:07:39.05,0:07:40.08,Default - Copy,clay3,0,0,0,,Ұялшақ бол
Dialogue: 0,0:07:41.05,0:07:43.86,Default - Copy,clay4,0,0,0,,Достар бір-біріне оғаш сөздер айтады.
Dialogue: 0,0:07:43.86,0:07:45.06,Default - Copy,clay3,0,0,0,,Жарайды, шық.
Dialogue: 0,0:07:48.69,0:07:50.26,Default - Copy,clay4,0,0,0,,Мен сізден бірнәрсе сұрайын деп едім.
Dialogue: 0,0:07:51.13,0:07:53.63,Default - Copy,clay4,0,0,0,,Мына басқа қылышқа не болды?
Dialogue: 0,0:07:53.97,0:07:56.20,Default - Copy,clay4,0,0,0,,Белгілер басқаша сияқты.
Dialogue: 0,0:07:56.20,0:07:57.20,Default - Copy,clay3,0,0,0,,Нормадан тыс Титан.
Dialogue: 0,0:07:57.20,0:08:00.24,Default - Copy,clay3,0,0,0,,Мен оны өлтірген жігіттен алдым. Шағымдарыңыз бар ма?
Dialogue: 0,0:08:00.77,0:08:04.44,Default - Copy,clay4,0,0,0,,Жауынгер өлсе, қылышымыз құлпытасқа айналады.
Dialogue: 0,0:08:05.14,0:08:07.28,Default - Copy,clay4,0,0,0,,Сіз мұны білмейтін сияқтысыз.
Dialogue: 0,0:08:08.74,0:08:10.65,Default - Copy,clay3,0,0,0,,Өлген адамға керегі жоқ шығар.
Dialogue: 0,0:08:11.12,0:08:14.15,Default - Copy,clay3,0,0,0,,Бұл бәрібір ешкім білмейтін төмен дәрежелі жауынгердің қылышы.
Dialogue: 0,0:08:16.22,0:08:23.06,Default - Copy,clay4,0,0,0,,Оны басым қолымен мықтап ұстаған сияқты, мен оны қуып жіберсем де жібермеді.
Dialogue: 0,0:08:23.96,0:08:24.86,Default - Copy,clay3,0,0,0,,На
Dialogue: 0,0:08:24.86,0:08:26.69,Default - Copy,clay3,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:08:27.07,0:08:31.67,Default - Copy,clay4,0,0,0,,Сіздің мінез-құлқыңыз бір қарағанда жабайы адамға ұқсайды.
Dialogue: 0,0:08:32.07,0:08:35.03,Default - Copy,clay4,0,0,0,,Мұның бәрі достарымның игілігі үшін деп ойламаймын.
Dialogue: 0,0:08:36.34,0:08:37.68,Default - Copy,clay3,0,0,0,,Келме.
Dialogue: 0,0:08:37.68,0:08:40.58,Default - Copy,clay3,0,0,0,,Әй, капитанның айтқанын тыңдай алмайсың ба?
Dialogue: 0,0:08:40.58,0:08:41.85,Default - Copy,clay3,0,0,0,,Келме
Dialogue: 0,0:08:46.52,0:08:48.08,Default - Copy,clay4,0,0,0,,Мен көремін.
Dialogue: 0,0:08:48.08,0:08:51.72,Default - Copy,clay4,0,0,0,,Бұл сіздің шынайы формаңыз ба?
Dialogue: 0,0:09:03.67,0:09:07.40,Default - Copy,clay5,0,0,0,,Мен сенімен біраз уақыт араласқым келеді.
Dialogue: 0,0:09:08.61,0:09:10.40,Default - Copy,Clare,0,0,0,,Капитан Флора
Dialogue: 0,0:09:16.95,0:09:18.38,Default - Copy,clay3,0,0,0,,Ки-сама
Dialogue: 0,0:09:19.22,0:09:20.15,Default - Copy,clay4,0,0,0,,Не болды?
Dialogue: 0,0:09:20.75,0:09:24.15,Default - Copy,clay4,0,0,0,,Сіздің шектен шығып кете жаздағаныңыз қорқынышты болды ма?
Dialogue: 0,0:09:28.69,0:09:29.59,Default - Copy,clay3,0,0,0,,Кім
Dialogue: 0,0:09:29.59,0:09:31.26,Default - Copy,clay4,0,0,0,,Ұят болма
Dialogue: 0,0:09:31.26,0:09:32.63,Default - Copy,clay4,0,0,0,,Мұны кез келген адам жасай алады.
Dialogue: 0,0:09:33.03,0:09:34.80,Default - Copy,clay4,0,0,0,,Билікке ұмтылу
Dialogue: 0,0:09:34.80,0:09:36.83,Default - Copy,clay4,0,0,0,,Қан мен ет құмарлығы
Dialogue: 0,0:09:36.83,0:09:39.90,Default - Copy,clay4,0,0,0,,Ішімдегі шіркін қара кесек
Dialogue: 0,0:09:40.51,0:09:43.44,Default - Copy,clay4,0,0,0,,Оны анық сезінген сәт.
Dialogue: 0,0:09:44.71,0:09:49.65,Default - Copy,clay3,0,0,0,,Сіз тереңірек нәрсені басынан өткергендейсіз.
Dialogue: 0,0:09:49.65,0:09:51.42,Default - Copy,clay4,0,0,0,,Жалпылау.
Dialogue: 0,0:09:51.42,0:09:52.42,Default - Copy,clay4,0,0,0,,Екінші болжам жасамаңыз
Dialogue: 0,0:09:53.48,0:09:59.82,Default - Copy,clay4,0,0,0,,Қалай болғанда да, бұл әлсіз және ұялшақ жауынгер үшін ауыр тәжірибе болса керек.
Dialogue: 0,0:09:59.82,0:10:00.93,Default - Copy,clay3,0,0,0,,Вамуу сияқты біреу үшін де —
Dialogue: 0,0:10:00.93,0:10:02.56,Default - Copy,clay3,0,0,0,,Сіз не туралы айтып тұрсыз?
Dialogue: 0,0:10:03.52,0:10:09.87,Default - Copy,clay4,0,0,0,,Бастапқыда ол ең жақын одақтастарына жабысып аман қала алған әлсіз жауынгер болған, бірақ
Dialogue: 0,0:10:09.87,0:10:13.50,Default - Copy,clay4,0,0,0,,Жақын жауынгер шайқаста өледі.
Dialogue: 0,0:10:14.44,0:10:17.18,Default - Copy,clay4,0,0,0,,Бұл да менің күшім болмағандықтан.
Dialogue: 0,0:10:19.11,0:10:22.88,Default - Copy,clay4,0,0,0,,Қалған жауынгер семсерін ұстап, шешеді.
Dialogue: 0,0:10:24.02,0:10:26.28,Default - Copy,clay4,0,0,0,,Сіз басқалардан күшті болған кезде
Dialogue: 0,0:10:27.85,0:10:31.76,Default - Copy,clay4,0,0,0,,Ол әрқашан өзінің сиқырлы күштерін босатып, өзін бұлшықетті етіп көрсетті.
Dialogue: 0,0:10:31.76,0:10:34.83,Default - Copy,clay4,0,0,0,,Бұл ұйымды қосарлы пайдалануға рұқсат ету үшін ме?
Dialogue: 0,0:10:35.26,0:10:37.62,Default - Copy,clay3,0,0,0,,Неліктен?
Dialogue: 0,0:10:38.13,0:10:40.13,Default - Copy,clay4,0,0,0,,Мен ештеңе білмедім.
Dialogue: 0,0:10:40.83,0:10:45.17,Default - Copy,clay4,0,0,0,,Бұл біздің әлемде сирек емес, бұл қарапайым оқиға.
Dialogue: 0,0:10:45.17,0:10:45.96,Default - Copy,clay3,0,0,0,,Карс Супер Ажаны іздеді —
Dialogue: 0,0:10:46.04,0:10:48.27,Default - Copy,clay6,0,0,0,,О, міне, мынау.
Dialogue: 0,0:10:48.61,0:10:50.98,Default - Copy,clay6,0,0,0,,Ия, сіз өте таңдаулысыз.
Dialogue: 0,0:10:50.98,0:10:52.11,Default - Copy,clay3,0,0,0,,Ақымақ
Dialogue: 0,0:10:52.11,0:10:53.27,Default - Copy,clay3,0,0,0,,Ақымақ
Dialogue: 0,0:10:54.48,0:10:56.27,Default - Copy,clay6,0,0,0,,Артқы жағында кім бар?
Dialogue: 0,0:10:56.78,0:10:57.72,Default - Copy,clay6,0,0,0,,Мен ондай адамды білмеймін.
Dialogue: 0,0:10:58.28,0:11:00.45,Default - Copy,clay6,0,0,0,,Бұл не, Денев?
Dialogue: 0,0:11:00.45,0:11:01.75,Default - Copy,clay6,0,0,0,,Сен де келдің бе?
Dialogue: 0,0:11:01.75,0:11:02.39,Default - Copy,clay4,0,0,0,,О
Dialogue: 0,0:11:02.82,0:11:04.59,Default - Copy,clay6,0,0,0,,Ішінде не бар?
Dialogue: 0,0:11:04.59,0:11:07.29,Default - Copy,clay4,0,0,0,,Жоқ, тек мал материалдары болды.
Dialogue: 0,0:11:09.53,0:11:11.03,Default - Copy,clay6,0,0,0,,Не?
Dialogue: 0,0:11:11.03,0:11:12.22,Default - Copy,clay6,0,0,0,,Сонда мен киімімді ауыстырайын ба?
Dialogue: 0,0:11:14.23,0:11:19.26,Default - Copy,clay6,0,0,0,,Киімімді ауыстырсам да, бәрібір тез арада ыдырайтынына сенімдімін.
Dialogue: 0,0:11:20.10,0:11:22.27,Default - Copy,clay6,0,0,0,,Бұл жақсы, міне, солай
Dialogue: 0,0:11:23.61,0:11:25.11,Default - Copy,clay6,0,0,0,,Жана Денев
Dialogue: 0,0:11:25.11,0:11:26.71,Default - Copy,clay6,0,0,0,,Жақсы ұйықтайық
Dialogue: 0,0:11:26.71,0:11:27.65,Default - Copy,clay4,0,0,0,,(Шукуна) Бұл жалықтырады. Егер менің орнымды алмақ болсаң, іске кіріс.
Dialogue: 0,0:11:28.58,0:11:29.58,Default - Copy,clay6,0,0,0,,Қайырлы түн
Dialogue: 0,0:11:37.36,0:11:39.15,Default - Copy,clay3,0,0,0,,Сіз маған жақсылық жасағыңыз келе ме?
Dialogue: 0,0:11:39.15,0:11:41.03,Default - Copy,clay4,0,0,0,,Бұл менің ниетім емес.
Dialogue: 0,0:11:41.63,0:11:44.26,Default - Copy,clay4,0,0,0,,Хелен жақсы адам, бірақ жұмсақ сөйлейді.
Dialogue: 0,0:11:44.76,0:11:50.54,Default - Copy,clay4,0,0,0,,Егер сіздің командаңыздағы адамдар сіз туралы қазір білсе, олар ұрысудан көбірек қорқуы мүмкін.
Dialogue: 0,0:11:50.54,0:11:53.37,Default - Copy,clay3,0,0,0,,Мен одан артық ештеңе білмеймін.
Dialogue: 0,0:11:53.37,0:11:57.44,Default - Copy,clay4,0,0,0,,Тағы бір оқиғаны айтып берейін.
Dialogue: 0,0:11:59.38,0:12:02.48,Default - Copy,clay4,0,0,0,,Бір қыздың өзінен үлкен әпкесі бар еді.
Dialogue: 0,0:12:02.95,0:12:05.38,Default - Copy,clay4,0,0,0,,Үйге жындар шабуыл жасағанда
Dialogue: 0,0:12:05.38,0:12:08.29,Default - Copy,clay4,0,0,0,,Үлкен апа сіңлісін кереует астына лақтырып жіберді.
Dialogue: 0,0:12:09.42,0:12:12.46,Default - Copy,clay4,0,0,0,,Қыздың қолынан келгені қарау ғана болды.
Dialogue: 0,0:12:13.09,0:12:19.40,Default - Copy,clay4,0,0,0,,Менің қолымнан келгені – әпкемді жындар бөліп-жарып жатқанын көру.
Dialogue: 0,0:12:21.10,0:12:24.84,Default - Copy,clay4,0,0,0,,Қыз ақыры жартылай адам, жартылай жын жауынгерге айналады.
Dialogue: 0,0:12:24.84,0:12:27.97,Default - Copy,clay4,0,0,0,,Әпкемнің өлімі үшін кек алғысы келсе де
Dialogue: 0,0:12:27.97,0:12:30.27,Default - Copy,clay4,0,0,0,,Қорғаныс жауынгері болды
Dialogue: 0,0:12:31.10,0:12:35.05,Default - Copy,clay4,0,0,0,,Жүрегімде өлгім келмеді.
Dialogue: 0,0:12:35.45,0:12:40.32,Default - Copy,clay4,0,0,0,,Сол төсек астында да, апамды құрбандыққа шалғанда да.
Dialogue: 0,0:12:40.32,0:12:41.89,Default - Copy,clay4,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:12:43.89,0:12:51.06,Default - Copy,clay4,0,0,0,,Өз-өзінен үмітін үзіп, шарасыз шайқасқа түскен адамға ашуланған жауынгер осылай деді.
Dialogue: 0,0:12:51.06,0:12:55.97,Default - Copy,clay6,0,0,0,,Ей, не болса да өмір сүргісі келетіні табиғи нәрсе.
Dialogue: 0,0:12:55.97,0:12:57.80,Default - Copy,clay6,0,0,0,,Біз адамбыз.
Dialogue: 0,0:13:00.14,0:13:05.94,Default - Copy,clay4,0,0,0,,Бәрі де желдей ұшып кеткен жоқ, бірақ соның арқасында жауынгер әлі тірі сияқты.
Dialogue: 0,0:13:10.04,0:13:12.42,Default - Copy,clay4,0,0,0,,Мұнда біздің достарымыз бар.
Dialogue: 0,0:13:12.42,0:13:16.05,Default - Copy,clay4,0,0,0,,Егер сіз мұны жалғыз жасай алмасаңыз, біз сізді қолдаймыз.
Dialogue: 0,0:13:16.05,0:13:21.49,Default - Copy,clay4,0,0,0,,Сондықтан өзіңізді көп уайымдамаңыз, капитан Ундин.
Dialogue: 0,0:13:25.00,0:13:28.80,Default - Copy,Clare,0,0,0,,Сізді бұл жерге әкелудегі мақсат не?
Dialogue: 0,0:13:29.80,0:13:32.47,Default - Copy,flora,0,0,0,,Мен әрқашан өзімді жайсыз сезінетінмін.
Dialogue: 0,0:13:32.47,0:13:34.37,Default - Copy,flora,0,0,0,,Сіздің оң қолыңыз
Dialogue: 0,0:13:34.71,0:13:36.77,Default - Copy,flora,0,0,0,,Бұл менікі емес.
Dialogue: 0,0:13:40.48,0:13:41.58,Default - Copy,flora,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:13:43.08,0:13:45.08,Default - Copy,flora,0,0,0,,Мен мұны бұрын естігенмін
Dialogue: 0,0:13:45.58,0:13:49.22,Default - Copy,flora,0,0,0,,Сіздікіндей қылышты қолданатын жауынгер туралы әңгіме.
Dialogue: 0,0:13:49.79,0:13:53.22,Default - Copy,flora,0,0,0,,Бұрынғы №2 жоғары жылдамдықты қылыш Айрин
Dialogue: 0,0:13:54.43,0:13:57.93,Default - Copy,flora,0,0,0,,Сол кездегі Терезаны бағындыратын бірінші топтың бірі
Dialogue: 0,0:13:58.46,0:14:02.13,Default - Copy,flora,0,0,0,,Содан бері оның қайда кеткенін ешкім білмейді.
Dialogue: 0,0:14:02.13,0:14:06.97,Default - Copy,flora,0,0,0,,2-ші нөмірге жеткен адам оңай өлмейді деп ойлаймын.
Dialogue: 0,0:14:08.64,0:14:10.64,Default - Copy,flora,0,0,0,,Қолыңызды қайда қойдыңыз?
Dialogue: 0,0:14:12.11,0:14:14.14,Default - Copy,flora,0,0,0,,Жауап беріңізші
Dialogue: 0,0:14:17.45,0:14:21.65,Default - Copy,flora,0,0,0,,Жауап бере алмайтындай етіп қойдым деп ойлағаным дұрыс шығар.
Dialogue: 0,0:14:24.32,0:14:27.09,Default - Copy,flora,0,0,0,,Мен оны кем дегенде бір рет сынап көргім келді.
Dialogue: 0,0:14:27.39,0:14:33.13,Default - Copy,flora,0,0,0,,Менің жел сызығым бұрынғы №2 жылдам семсерге жақындай алады ма?
Dialogue: 0,0:14:37.80,0:14:38.56,Default - Copy,clay7,0,0,0,,Қ-Қандай?
Dialogue: 0,0:14:42.57,0:14:43.84,Default - Copy,flora,0,0,0,,Джин мырза
Dialogue: 0,0:14:44.24,0:14:46.64,Default - Copy,flora,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,0:14:46.64,0:14:49.07,Default - Copy,flora,0,0,0,,Маған кедергі жасамаңыз
Dialogue: 0,0:14:49.31,0:14:51.42,Default - Copy,jean,0,0,0,,Мен Клэрге қарыздармын.
Dialogue: 0,0:14:51.88,0:14:54.05,Default - Copy,jean,0,0,0,,Мен сені үнсіз өлтіруге рұқсат ете алмаймын
Dialogue: 0,0:14:54.72,0:14:57.79,Default - Copy,flora,0,0,0,,Тіпті оны өлтіруге себеп болса да
Dialogue: 0,0:14:58.09,0:14:59.09,Default - Copy,jean,0,0,0,,Сәйкес емес
Dialogue: 0,0:14:59.46,0:15:04.53,Default - Copy,jean,0,0,0,,Егер біреу Клэрге қылыш сілтесе, бұл менің қылышты суыруға жеткілікті себеп.
Dialogue: 0,0:15:04.53,0:15:05.79,Default - Copy,Clare,0,0,0,,Ген, тоқтат.
Dialogue: 0,0:15:08.03,0:15:09.33,Default - Copy,flora,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:15:09.33,0:15:16.80,Default - Copy,flora,0,0,0,,Қалай болғанда да, мен келесі шабуылдың қашан болатынын білмегендіктен, бір-бірімді қатты ұрып-соғу ниетім болмады.
Dialogue: 0,0:15:17.38,0:15:21.45,Default - Copy,flora,0,0,0,,Бірақ мен сенімен күресе алмаймын, өйткені мен саған сенбеймін.
Dialogue: 0,0:15:22.41,0:15:24.75,Default - Copy,flora,0,0,0,,Сізді бағынышты командадан шығару үшін
Dialogue: 0,0:15:24.75,0:15:28.25,Default - Copy,Clare,0,0,0,,Бұл қол Айриннен алынған.
Dialogue: 0,0:15:30.29,0:15:32.86,Default - Copy,Clare,0,0,0,,Ол ұйымнан жасырынып жүр.
Dialogue: 0,0:15:32.86,0:15:34.96,Default - Copy,Clare,0,0,0,,Мен бұл туралы мүмкіндігінше айтқым келмеді.
Dialogue: 0,0:15:35.33,0:15:40.33,Default - Copy,Clare,0,0,0,,Мен шайқаста басым қолымды жоғалтқаннан кейін Айрин мені құтқарды.
Dialogue: 0,0:15:40.33,0:15:41.20,Default - Copy,Clare,0,0,0,,Содан кейін
Dialogue: 0,0:15:43.53,0:15:47.57,Default - Copy,Clare,0,0,0,,Және мен ешқашан жоғалтқым келмейтін нәрсе үшін
Dialogue: 0,0:15:59.05,0:16:01.45,Default - Copy,Clare,0,0,0,,Әдетте мен оны алмас едім.
Dialogue: 0,0:16:01.79,0:16:05.06,Default - Copy,Clare,0,0,0,,Бірақ мен күресуді жалғастыруым керек еді
Dialogue: 0,0:16:05.79,0:16:06.76,Default - Copy,Clare,0,0,0,,Қалай болғанда да
Dialogue: 0,0:16:07.33,0:16:08.09,Default - Copy,flora,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:16:09.99,0:16:13.03,Default - Copy,Clare,0,0,0,,Сол кезде жоғалтқаным үшін
Dialogue: 0,0:16:15.33,0:16:20.91,Default - Copy,Clare,0,0,0,,Мен соғысып, аман қалып, Оянған Присцилланың басын кесемін.
Dialogue: 0,0:16:21.31,0:16:23.43,Default - Copy,flora,0,0,0,,Оянған Прискила
Dialogue: 0,0:16:25.04,0:16:30.38,Default - Copy,flora,0,0,0,,Сен қазір қайда екенін де білмейтін Прискиланы жеңесің бе?
Dialogue: 0,0:16:31.32,0:16:34.62,Default - Copy,Clare,0,0,0,,Сол себепті мен жауынгер атандым.
Dialogue: 0,0:16:37.79,0:16:42.42,Default - Copy,Clare,0,0,0,,Менің ішімдегі Терезаның қаны мен еті
Dialogue: 0,0:16:48.80,0:16:52.33,Default - Copy,flora,0,0,0,,Әркімнің төбелесудің өзіндік себептері бар.
Dialogue: 0,0:16:55.47,0:16:59.57,Default - Copy,flora,0,0,0,,Бұл шайқастан бірге аман өтейік.
Dialogue: 0,0:17:00.45,0:17:01.64,Default - Copy,Clare,0,0,0,,Флора
Dialogue: 0,0:17:11.22,0:17:14.43,Default - Copy,clay1,0,0,0,,Капитан, бұрын шағымданғаныма мен кінәлімін.
Dialogue: 0,0:17:14.79,0:17:16.25,Default - Copy,clay1,0,0,0,,Мен ешқашан қорықпадым.
Dialogue: 0,0:17:16.25,0:17:17.30,Default - Copy,clay3,0,0,0,,О
Dialogue: 0,0:17:17.30,0:17:18.76,Default - Copy,clay3,0,0,0,,есімде жоқ.
Dialogue: 0,0:17:19.90,0:17:22.60,Default - Copy,clay3,0,0,0,,Жара одан да тез жазылсын.
Dialogue: 0,0:17:22.60,0:17:27.00,Default - Copy,clay3,0,0,0,,Мен бұл отрядтан бір адамның да өлуіне жол бермеймін.
Dialogue: 0,0:17:27.91,0:17:29.37,Default - Copy,clay3,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:17:29.37,0:17:30.71,Default - Copy,clay1,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:17:51.40,0:17:55.79,Default - Copy,clay6,0,0,0,,Тамақ ішпей жақсы болу мен тамақтан рахат алудың айырмашылығы бар.
Dialogue: 0,0:17:56.50,0:17:59.64,Default - Copy,clay6,0,0,0,,Мен тамақ ішкенде басқа ештеңені ойлаудың қажеті жоқ.
Dialogue: 0,0:18:00.51,0:18:06.44,Default - Copy,clay6,0,0,0,,Бұл шайқас аяқталғанда, мен бүкіл команданы өзім сақтаған нәрсемен сыйлаймын.
Dialogue: 0,0:18:08.68,0:18:11.41,Default - Copy,clay6,0,0,0,,Сіз оны жемейінше өлмейтін сияқтысыз.
Dialogue: 0,0:18:13.35,0:18:14.25,Default - Copy,clay7,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:14.92,0:18:17.42,Default - Copy,clay7,0,0,0,,Шамасы оны қорқақтық жел соқты.
Dialogue: 0,0:18:17.42,0:18:18.66,Default - Copy,clay6,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:18:18.99,0:18:21.03,Default - Copy,clay6,0,0,0,,Өйткені, біз адамбыз.
Dialogue: 0,0:18:22.93,0:18:24.06,Default - Copy,clay7,0,0,0,,Айтамын ғой, қой!
Dialogue: 0,0:18:24.06,0:18:24.60,Default - Copy,clay6,0,0,0,,О
Dialogue: 0,0:18:26.30,0:18:27.50,Default - Copy,clay7,0,0,0,,That's right.
Dialogue: 0,0:18:35.67,0:18:41.01,Default - Copy,clay8,0,0,0,,Мүмкін болса, осында жиналған барлық жауынгерлер аман қалады.
Dialogue: 0,0:18:42.68,0:18:45.14,Default - Copy,Clare,0,0,0,,Мирия, сен осында болдың ба?
Dialogue: 0,0:18:45.14,0:18:48.35,Default - Copy,clay8,0,0,0,,Жоқ, менде де бір ақау бар.
Dialogue: 0,0:18:48.35,0:18:51.15,Default - Copy,clay8,0,0,0,,Сиынатын құдай жоқ.
Dialogue: 0,0:18:53.73,0:18:55.96,Default - Copy,clay8,0,0,0,,Бұл тағы да ұрыс алаңы болады
Dialogue: 0,0:18:55.96,0:18:56.69,Default - Copy,Clare,0,0,0,,О
Dialogue: 0,0:18:57.46,0:19:01.50,Default - Copy,clay8,0,0,0,,Бүгінгі жекпе-жек тек андеркард шығар.
Dialogue: 0,0:19:02.03,0:19:06.00,Default - Copy,clay8,0,0,0,,Бір рет тұңғиықтан бірдеңені кездестірсеңіз, түсінесіз.
Dialogue: 0,0:19:08.67,0:19:10.24,Default - Copy,clay8,0,0,0,,Бұлай емес
Dialogue: 0,0:19:10.68,0:19:15.18,Default - Copy,clay8,0,0,0,,Сол тұңғиықтағы нәрсе, егер Солтүстік Исли байыпты болса.
Dialogue: 0,0:19:30.36,0:19:31.93,Default - Copy,dood,0,0,0,,Маған ұйықтауға рұқсат етіңіз
Dialogue: 0,0:19:32.30,0:19:35.77,Default - Copy,dood,0,0,0,,Мен бар күшімді соңына дейін жұмсаған сияқтымын.
Dialogue: 0,0:19:38.40,0:19:40.93,Default - Copy,dood,0,0,0,,Адамдар біртүрлі нәрсе ғой, солай емес пе?
Dialogue: 0,0:19:41.48,0:19:46.41,Default - Copy,dood,0,0,0,,Сіз қаншалықты шектен шықпасаңыз да, сіз алатын қуат күлкілі аз.
Dialogue: 0,0:19:48.94,0:19:50.15,Default - Copy,dood,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:19:50.48,0:19:55.95,Default - Copy,dood,0,0,0,,Прискила ұнаса, мен саған қанша қаласаң, сонша қылыш үйретемін.
Dialogue: 0,0:20:00.83,0:20:05.03,Default - Copy,dood,0,0,0,,Прискила, үндемеші, сен қонақ сияқтысың.
Dialogue: 0,0:20:18.78,0:20:19.54,Default - Copy,dood,0,0,0,,Ригалдо
Dialogue: 0,0:20:23.65,0:20:27.22,Default - Copy,kid2,0,0,0,,Сіз сияқты біреудің мұндай жерде лагерьде тұруы нені білдіреді?
Dialogue: 0,0:20:28.69,0:20:30.82,Default - Copy,dood,0,0,0,,Жақсы, кейде
Dialogue: 0,0:20:31.19,0:20:32.46,Default - Copy,dood,0,0,0,,Менің көңіл-күйім өзгереді
Dialogue: 0,0:20:33.29,0:20:33.89,Default - Copy,dood,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:20:34.26,0:20:35.62,Default - Copy,dood,0,0,0,,Пьетаның күйі қандай?
Dialogue: 0,0:20:36.23,0:20:36.79,Default - Copy,kid2,0,0,0,,Иә
Dialogue: 0,0:20:45.60,0:20:46.54,Default - Copy,dood,0,0,0,,Мен көремін.
Dialogue: 0,0:20:48.82,0:20:50.41,Default - Copy,dood,0,0,0,,Әскерді жинаңыз
Dialogue: 0,0:20:53.11,0:21:00.64,Default - Copy,dood,0,0,0,,Солтүстік армия, барлығы 27, Альфонс бастаған қала Пиетаны жойды.
Dialogue: 0,0:21:00.64,0:21:05.88,Default - Copy,kid2,0,0,0,,Бұл өмір жоқ қала болар.
Dialogue: 0,0:21:05.88,0:21:08.62,Default - Copy,dood,0,0,0,,Менің Эйсли есімімен
Dialogue: 0,0:21:08.62,0:21:13.56,Default - Copy,dood,0,0,0,,Тіпті бір тышқанның немесе жәндіктің өмірін жою.
Dialogue: 0,0:21:23.41,0:21:24.01,Default - Copy,Clare,0,0,0,,Келіңіздер
Dialogue: 0,0:22:40.40,0:22:42.30,Default - Copy,,0,0,0,,Мейірімсіз патша
Dialogue: 0,0:22:42.30,0:22:43.84,Default - Copy,,0,0,0,,Мейірімсіз тәртіп
Dialogue: 0,0:22:43.94,0:22:46.54,Default - Copy,,0,0,0,,Кісі өлтіру түні
Dialogue: 0,0:22:48.04,0:22:54.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory