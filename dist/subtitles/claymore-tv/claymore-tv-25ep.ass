Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.50,0:00:20.87,Default - Copy,Priscilla,0,0,0,,Қандай да бір себепті,
Dialogue: 0,0:00:21.30,0:00:24.57,Default - Copy,Priscilla,0,0,0,,Неге менің басым анық?
Dialogue: 0,0:00:25.14,0:00:27.11,Default - Copy,Priscilla,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:00:58.97,0:01:00.84,Default - Copy,Clare,0,0,0,,Тек сен
Dialogue: 0,0:01:01.17,0:01:03.71,Default - Copy,Clare,0,0,0,,Тек сен
Dialogue: 0,0:01:11.25,0:01:14.02,Default - Copy,Priscilla,0,0,0,,Ол кездегіден басқаша.
Dialogue: 0,0:01:14.59,0:01:15.79,Default - Copy,Priscilla,0,0,0,,Мен
Dialogue: 0,0:01:19.62,0:01:22.43,Default - Copy,Priscilla,0,0,0,,Мен сенен қорықпаймын
Dialogue: 0,0:01:23.76,0:01:26.03,Default - Copy,Priscilla,0,0,0,,Сіз
Dialogue: 0,0:01:30.37,0:01:32.07,Default - Copy,Priscilla,0,0,0,,Сіз
Dialogue: 0,0:02:47.81,0:02:49.75,Default - Copy,Priscilla,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:02:50.18,0:02:51.85,Default - Copy,Priscilla,0,0,0,,Әке немесе ана
Dialogue: 0,0:02:51.85,0:02:53.22,Default - Copy,Priscilla,0,0,0,,Барлығы
Dialogue: 0,0:02:53.72,0:02:55.39,Default - Copy,Priscilla,0,0,0,,Сол сияқты
Dialogue: 0,0:03:07.77,0:03:12.30,Default - Copy,Priscilla,0,0,0,,Сатқынды өлтірме
Dialogue: 0,0:03:12.84,0:03:13.81,Default - Copy,Priscilla,0,0,0,,Жындар
Dialogue: 0,0:03:20.11,0:03:23.95,Default - Copy,Easley,0,0,0,,Сіз біз кездескен кездегі Присциллаға қайта оралған сияқтысыз.
Dialogue: 0,0:03:26.05,0:03:29.72,Default - Copy,Easley,0,0,0,,Бірақ оянғалы тұрған балшық
Dialogue: 0,0:03:30.39,0:03:33.16,Default - Copy,Easley,0,0,0,,Бұл біртүрлі күш тепе-теңдігі, бірақ
Dialogue: 0,0:03:42.27,0:03:43.44,Default - Copy,Easley,0,0,0,,Мен көремін.
Dialogue: 0,0:03:44.10,0:03:46.67,Default - Copy,Easley,0,0,0,,Ұйымдар да әртүрлі істермен айналысады.
Dialogue: 0,0:03:47.41,0:03:48.51,Default - Copy,Easley,0,0,0,,Қызықты
Dialogue: 0,0:03:49.14,0:03:51.68,Default - Copy,Easley,0,0,0,,Маған жақынырақ қарап көрейін.
Dialogue: 0,0:03:53.88,0:03:55.31,Default - Copy,Clare,0,0,0,,Прискила
Dialogue: 0,0:03:56.01,0:03:57.48,Default - Copy,Clare,0,0,0,,Тек сен
Dialogue: 0,0:04:05.22,0:04:06.43,Default - Copy,Helen,0,0,0,,Ақымақ
Dialogue: 0,0:04:06.43,0:04:08.76,Default - Copy,Helen,0,0,0,,Клэрдің күші қайтадан өсті.
Dialogue: 0,0:04:10.16,0:04:11.40,Default - Copy,Helen,0,0,0,,Прискила?
Dialogue: 0,0:04:11.80,0:04:14.33,Default - Copy,Helen,0,0,0,,Мен бұл туралы естігенмін, бірақ қазір оны көруге шыдамаймын.
Dialogue: 0,0:04:14.63,0:04:16.97,Default - Copy,Deneve,0,0,0,,«Күліп тұрған Терезаны» өлтірген ол.
Dialogue: 0,0:04:17.40,0:04:19.47,Default - Copy,Deneve,0,0,0,,Оның тірі болуы ғажап емес.
Dialogue: 0,0:04:19.47,0:04:20.64,Default - Copy,Deneve,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:04:20.64,0:04:24.21,Default - Copy,Deneve,0,0,0,,Клэр Присциллаға неге сонша құмар?
Dialogue: 0,0:04:25.01,0:04:27.55,Default - Copy,Deneve,0,0,0,,Клэр оянып кеткен болатын.
Dialogue: 0,0:04:27.95,0:04:31.32,Default - Copy,Deneve,0,0,0,,Төңкеру көп нәрсені білдіреді
Dialogue: 0,0:04:33.45,0:04:35.35,Default - Copy,Deneve,0,0,0,,Біз не білеміз?
Dialogue: 0,0:04:38.16,0:04:39.49,Default - Copy,Helen,0,0,0,,Мирия-нисан
Dialogue: 0,0:04:41.69,0:04:44.46,Default - Copy,Miria,0,0,0,,Ұйымды зерттеу кезінде
Dialogue: 0,0:04:44.46,0:04:46.10,Default - Copy,Miria,0,0,0,,Мен мұны кездейсоқ білдім.
Dialogue: 0,0:04:48.13,0:04:53.31,Default - Copy,Miria,0,0,0,,Балалар, сендер Клэрдің саны 47, ең әлсіз дәрежесіңдер.
Dialogue: 0,0:04:53.31,0:04:57.61,Default - Copy,Miria,0,0,0,,Уақытты көрсететін күш тепе-теңдігі біртүрлі деп ойладыңыз ба?
Dialogue: 0,0:04:58.81,0:04:59.95,Default - Copy,Helen,0,0,0,,Жақсы
Dialogue: 0,0:04:59.95,0:05:02.11,Default - Copy,Deneve,0,0,0,,Мен оны тұрақсыз деп ойладым.
Dialogue: 0,0:05:02.71,0:05:04.62,Default - Copy,Miria,0,0,0,,Оның себебі бар еді.
Dialogue: 0,0:05:05.12,0:05:08.12,Default - Copy,Miria,0,0,0,,Клэр біз сияқты жартылай адам және жартылай жын емес.
Dialogue: 0,0:05:08.89,0:05:13.39,Default - Copy,Miria,0,0,0,,Ол денеге сіңген нәрсе жынның еті мен қаны емес еді.
Dialogue: 0,0:05:13.39,0:05:14.79,Default - Copy,Miria,0,0,0,,Жауынгер.
Dialogue: 0,0:05:19.67,0:05:21.37,Default - Copy,Miria,0,0,0,,Жауынгердің аты кім?
Dialogue: 0,0:05:30.04,0:05:31.51,Default - Copy,Miria,0,0,0,,«Күліп тұрған Тереза»
Dialogue: 0,0:05:36.58,0:05:37.92,Default - Copy,Helen,0,0,0,,Бір айдан кейін
Dialogue: 0,0:05:37.92,0:05:39.28,Default - Copy,Deneve,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:05:40.15,0:05:42.55,Default - Copy,Miria,0,0,0,,Клэр мұны өзі қаласа керек.
Dialogue: 0,0:05:44.62,0:05:48.89,Default - Copy,Miria,0,0,0,,Терезамен байланысы болған шығар.
Dialogue: 0,0:05:50.60,0:05:53.80,Default - Copy,Miria,0,0,0,,Әрине, ұйымдар жанашырлықпен әрекет ете алмайды.
Dialogue: 0,0:05:54.47,0:05:56.37,Default - Copy,Miria,0,0,0,,Бұл жаңа эксперимент болды.
Dialogue: 0,0:05:57.14,0:06:00.77,Default - Copy,Miria,0,0,0,,Жындардың орнына жауынгерлерден жауынгер жасай аламыз ба?
Dialogue: 0,0:06:03.31,0:06:05.01,Default - Copy,Helen,0,0,0,,Қарғыс атсын
Dialogue: 0,0:06:05.01,0:06:07.15,Default - Copy,Helen,0,0,0,,Ұйым осылай істейтін еді.
Dialogue: 0,0:06:07.68,0:06:08.88,Default - Copy,Deneve,0,0,0,,Мен көремін.
Dialogue: 0,0:06:09.51,0:06:13.32,Default - Copy,Deneve,0,0,0,,Клэр Присцилланы кек алу ретінде көздеп отыр ма?
Dialogue: 0,0:06:13.32,0:06:15.05,Default - Copy,Miria,0,0,0,,(Изуку) Урарака ханым. (Урарака) Иә!
Dialogue: 0,0:06:15.62,0:06:18.96,Default - Copy,Miria,0,0,0,,Бірақ Клэрдің қазіргі күйінде
Dialogue: 0,0:06:19.39,0:06:22.79,Default - Copy,Miria,0,0,0,,Шайқас аяқталмай тұрып, толық ояныңыз
Dialogue: 0,0:06:24.26,0:06:26.67,Default - Copy,Miria,0,0,0,,Тіпті оянсаңыз да
Dialogue: 0,0:06:26.67,0:06:28.57,Default - Copy,Miria,0,0,0,,Сіз Присцилланы жеңе аласыз ба?
Dialogue: 0,0:06:30.94,0:06:32.04,Default - Copy,Miria,0,0,0,,Асығыңыз!
Dialogue: 0,0:06:35.84,0:06:37.38,Default - Copy,Helen,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:06:37.91,0:06:41.41,Default - Copy,Helen,0,0,0,,Сенің адам болып өлуіңе келіскен мен едім.
Dialogue: 0,0:06:41.81,0:06:43.88,Default - Copy,Helen,0,0,0,,Оянғандарды бірдеңе жасауға мәжбүрлеуім керек пе?
Dialogue: 0,0:06:44.55,0:06:47.52,Default - Copy,Helen,0,0,0,,Бұл болмайды, Клэр.
Dialogue: 0,0:07:14.88,0:07:15.78,Default - Copy,Raki,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:07:21.39,0:07:25.56,Default - Copy,Jeane,0,0,0,,Мирия мен басқалары бізге баратын жерді тастап кеткен сияқты.
Dialogue: 0,0:07:42.14,0:07:44.31,Default - Copy,Raki,0,0,0,,Сұрауға бола ма?
Dialogue: 0,0:07:48.05,0:07:50.65,Default - Copy,Raki,0,0,0,,Неліктен сен Клэрді сонша уайымдайсың?
Dialogue: 0,0:07:52.12,0:07:54.19,Default - Copy,Jeane,0,0,0,,Өйткені бұл өмірді сақтап қалды.
Dialogue: 0,0:07:57.26,0:08:00.33,Default - Copy,Jeane,0,0,0,,Мен адам емес, басқа нәрсе болуға тырыстым.
Dialogue: 0,0:08:01.09,0:08:03.30,Default - Copy,Jeane,0,0,0,,Клэр мені құтқарды
Dialogue: 0,0:08:05.70,0:08:09.67,Default - Copy,Jeane,0,0,0,,Клэрге ол сақтап қалған өмірін қайтарыңыз.
Dialogue: 0,0:08:10.24,0:08:11.40,Default - Copy,Jeane,0,0,0,,Осымен
Dialogue: 0,0:08:13.94,0:08:14.91,Default - Copy,Raki,0,0,0,,Жоспар
Dialogue: 0,0:08:15.61,0:08:17.78,Default - Copy,Raki,0,0,0,,Клэр мені де құтқарды.
Dialogue: 0,0:08:18.84,0:08:22.91,Default - Copy,Raki,0,0,0,,Сондықтан мен Клэрге көмектескім келді.
Dialogue: 0,0:08:24.32,0:08:25.42,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:08:32.42,0:08:33.83,Default - Copy,Jeane,0,0,0,,бір нәрсе үшін
Dialogue: 0,0:08:34.16,0:08:36.36,Default - Copy,Jeane,0,0,0,,Кім біреу үшін күресіп жатыр?
Dialogue: 0,0:08:36.76,0:08:38.20,Default - Copy,Jeane,0,0,0,,Клэр де менімен бірге.
Dialogue: 0,0:08:41.47,0:08:44.70,Default - Copy,Jeane,0,0,0,,Клэр қазір күресіп жатқан Оянған
Dialogue: 0,0:08:44.70,0:08:47.61,Default - Copy,Jeane,0,0,0,,Ол Клэрден маңызды нәрсені ұрлады.
Dialogue: 0,0:08:48.37,0:08:52.68,Default - Copy,Jeane,0,0,0,,Бірақ Клэрді тірі қалдырған адамдар бар.
Dialogue: 0,0:08:54.91,0:08:55.91,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:08:56.85,0:08:59.32,Default - Copy,Jeane,0,0,0,,Мен жоғалтқаным үшін
Dialogue: 0,0:08:59.72,0:09:03.46,Default - Copy,Jeane,0,0,0,,Және жоғалтқыңыз келмейтін нәрсе үшін күресіңіз
Dialogue: 0,0:09:04.29,0:09:06.39,Default - Copy,Jeane,0,0,0,,Бұл Клэрдің айтқан сөздері.
Dialogue: 0,0:09:08.16,0:09:11.03,Default - Copy,Jeane,0,0,0,,Мүмкін бәрі осылай өмір сүретін шығар.
Dialogue: 0,0:09:13.27,0:09:17.10,Default - Copy,Raki,0,0,0,,Клэр жынға айналмайды.
Dialogue: 0,0:09:19.14,0:09:19.87,Default - Copy,Jeane,0,0,0,,О
Dialogue: 0,0:09:33.95,0:09:34.95,Default - Copy,Priscilla,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:09:36.35,0:09:38.82,Default - Copy,Priscilla,0,0,0,,Бұл әлсіз болды ма?
Dialogue: 0,0:09:41.66,0:09:45.20,Default - Copy,Priscilla,0,0,0,,Шынында не болды?
Dialogue: 0,0:09:46.50,0:09:47.77,Default - Copy,Priscilla,0,0,0,,Тереза
Dialogue: 0,0:09:48.83,0:09:50.70,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:10:01.45,0:10:02.21,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:10:05.08,0:10:05.72,Default - Copy,Priscilla,0,0,0,,О.
Dialogue: 0,0:10:06.55,0:10:09.69,Default - Copy,Clare,0,0,0,,Бұл есімді айтпайсыз ба
Dialogue: 0,0:10:10.99,0:10:13.19,Default - Copy,Priscilla,0,0,0,,Бұл сен кінәлі, солай емес пе?
Dialogue: 0,0:10:13.69,0:10:18.36,Default - Copy,Priscilla,0,0,0,,Әкем, анам, ағаларым және Айрин
Dialogue: 0,0:10:19.33,0:10:22.27,Default - Copy,Priscilla,0,0,0,,Барлығына осындай қорқынышты істер жасау
Dialogue: 0,0:10:25.37,0:10:28.17,Default - Copy,Priscilla,0,0,0,,Бұл Терезаның кінәсі.
Dialogue: 0,0:10:28.17,0:10:31.78,Default - Copy,Clare,0,0,0,,Айтпа деп тұрмын.
Dialogue: 0,0:11:10.92,0:11:13.99,Default - Copy,Priscilla,0,0,0,,Енді осымен аяқтаймыз.
Dialogue: 0,0:11:16.02,0:11:19.12,Default - Copy,Clare,0,0,0,,сіз
Dialogue: 0,0:11:24.46,0:11:29.47,Default - Copy,Priscilla,0,0,0,,Мен сізді неге қорқынышты деп ойладым деп ойлаймын.
Dialogue: 0,0:11:32.30,0:11:35.44,Default - Copy,Priscilla,0,0,0,,Сіз мені оңай өлтіре аласыз
Dialogue: 0,0:11:40.85,0:11:43.95,Default - Copy,Priscilla,0,0,0,,Қош бол Тереза
Dialogue: 0,0:11:52.86,0:11:54.53,Default - Copy,Priscilla,0,0,0,,Бұл ауырмайды.
Dialogue: 0,0:12:11.78,0:12:13.11,Default - Copy,Helen,0,0,0,,Клэр
Dialogue: 0,0:12:13.11,0:12:14.91,Default - Copy,Helen,0,0,0,,Сіз өзіңіз сияқтысыз.
Dialogue: 0,0:12:15.45,0:12:17.78,Default - Copy,Helen,0,0,0,,Сен кетсең, мен түсінбеймін.
Dialogue: 0,0:12:19.99,0:12:20.79,Default - Copy,Clare,0,0,0,,Хелен
Dialogue: 0,0:12:21.62,0:12:22.59,Default - Copy,Clare,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:12:30.56,0:12:31.63,Default - Copy,Deneve,0,0,0,,Мен көремін.
Dialogue: 0,0:12:31.63,0:12:33.03,Default - Copy,Deneve,0,0,0,,Бұл Присцилла ма?
Dialogue: 0,0:12:33.87,0:12:36.03,Default - Copy,Miria,0,0,0,,Бұндай ештеңе жоқ
Dialogue: 0,0:12:36.37,0:12:37.37,Default - Copy,Priscilla,0,0,0,,О.
Dialogue: 0,0:12:37.37,0:12:39.30,Default - Copy,Priscilla,0,0,0,,Баршаңызға сәттілік.
Dialogue: 0,0:12:39.80,0:12:42.27,Default - Copy,Priscilla,0,0,0,,Ол білмейтін сияқты.
Dialogue: 0,0:12:42.27,0:12:46.04,Default - Copy,Priscilla,0,0,0,,Сіз жаңа жауынгерсіз бе?
Dialogue: 0,0:12:47.11,0:12:50.55,Default - Copy,Priscilla,0,0,0,,Мен №2 Присцилламын.
Dialogue: 0,0:12:50.88,0:12:51.72,Default - Copy,Helen,0,0,0,,Не?
Dialogue: 0,0:12:52.42,0:12:53.92,Default - Copy,Helen,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:12:54.55,0:12:57.79,Default - Copy,Miria,0,0,0,,Жад ояту алдында тоқтайды
Dialogue: 0,0:12:58.56,0:13:01.73,Default - Copy,Miria,0,0,0,,Жоқ, сіз абдырап қалдым дедіңіз.
Dialogue: 0,0:13:02.79,0:13:05.80,Default - Copy,Miria,0,0,0,,Хелен Денев Оңға және солға бұрылыңыз.
Dialogue: 0,0:13:06.33,0:13:08.30,Default - Copy,Miria,0,0,0,,Мен майданнан барамын
Dialogue: 0,0:13:08.30,0:13:09.23,Default - Copy,Helen,0,0,0,,Түсінікті
Dialogue: 0,0:13:09.70,0:13:10.87,Default - Copy,Clare,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:13:11.47,0:13:12.20,Default - Copy,Clare,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:20.45,0:13:25.72,Default - Copy,Priscilla,0,0,0,,Балалар, сендер де мені өлтірмексіңдер ме?
Dialogue: 0,0:13:25.72,0:13:26.69,Default - Copy,Miria,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:13:27.29,0:13:31.46,Default - Copy,Priscilla,0,0,0,,Барлығы, жындарды осылай көресіңдер.
Dialogue: 0,0:13:31.46,0:13:34.03,Default - Copy,Helen,0,0,0,,Юма - құбыжық
Dialogue: 0,0:13:34.03,0:13:36.26,Default - Copy,Priscilla,0,0,0,,Жын кім?
Dialogue: 0,0:13:47.27,0:13:48.27,Default - Copy,Miria,0,0,0,,Ақымақ
Dialogue: 0,0:13:54.58,0:13:56.68,Default - Copy,Deneve,0,0,0,,Мен бұл жағдайда одан аулақ болдым.
Dialogue: 0,0:13:57.12,0:13:59.35,Default - Copy,Helen,0,0,0,,Құбыжық күткендей.
Dialogue: 0,0:14:00.15,0:14:01.85,Default - Copy,Miria,0,0,0,,Сақтығыңызды түсірмеңіз
Dialogue: 0,0:14:02.75,0:14:06.29,Default - Copy,Priscilla,0,0,0,,Сіз құбыжықтар емессіз бе?
Dialogue: 0,0:14:07.09,0:14:09.33,Default - Copy,Priscilla,0,0,0,,Осындай сұмдық әрекет жаса
Dialogue: 0,0:14:09.99,0:14:13.30,Default - Copy,Priscilla,0,0,0,,Ана мен әкені және барлығын өлтіріңіз.
Dialogue: 0,0:14:14.87,0:14:18.54,Default - Copy,Priscilla,0,0,0,,Мен жаңа ғана ішімдік жедім.
Dialogue: 0,0:14:19.47,0:14:21.61,Default - Copy,Priscilla,0,0,0,,Бұл құбыжық емес
Dialogue: 0,0:14:24.38,0:14:27.88,Default - Copy,Priscilla,0,0,0,,Сондықтан да бұл жын.
Dialogue: 0,0:14:28.31,0:14:29.38,Default - Copy,Priscilla,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:14:30.72,0:14:37.76,Default - Copy,Priscilla,0,0,0,,Мен бәрін өлтіремін.
Dialogue: 0,0:14:41.36,0:14:43.76,Default - Copy,Miria,0,0,0,,Бұл не?
Dialogue: 0,0:15:01.31,0:15:02.65,Default - Copy,Jeane,0,0,0,,Бұл күш
Dialogue: 0,0:15:06.65,0:15:07.59,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:15:08.42,0:15:09.65,Default - Copy,Jeane,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:15:10.56,0:15:12.92,Default - Copy,Raki,0,0,0,,Егер сіз мұны істесеңіз, сіз әлі де зардап шегесіз.
Dialogue: 0,0:15:12.92,0:15:13.93,Default - Copy,Jeane,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:15:14.93,0:15:18.20,Default - Copy,Jeane,0,0,0,,Мен басынан-ақ аз-аздап қалпына келе бастадым.
Dialogue: 0,0:15:20.73,0:15:22.93,Default - Copy,Jeane,0,0,0,,Ол Клэрге көмектесуі керек емес пе еді?
Dialogue: 0,0:15:32.54,0:15:35.31,Default - Copy,Jeane,0,0,0,,Клэрге жету керек
Dialogue: 0,0:15:35.68,0:15:36.98,Default - Copy,Jeane,0,0,0,,Оған дейін күтіңіз.
Dialogue: 0,0:15:44.02,0:15:44.86,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:16:00.74,0:16:01.71,Default - Copy,Miria,0,0,0,,Мүмкін емес
Dialogue: 0,0:16:03.31,0:16:04.28,Default - Copy,Helen,0,0,0,,Бір айдан кейін
Dialogue: 0,0:16:05.58,0:16:08.81,Default - Copy,Deneve,0,0,0,,Бұл әлі де мінсіз емес пе еді?
Dialogue: 0,0:16:12.82,0:16:17.62,Default - Copy,Easley,0,0,0,,Сен бәрінен де жақсысың, Присцилла.
Dialogue: 0,0:16:18.16,0:16:19.62,Default - Copy,Easley,0,0,0,,Wonderful
Dialogue: 0,0:16:39.51,0:16:42.08,Default - Copy,Priscilla,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:16:42.08,0:16:44.02,Default - Copy,Priscilla,0,0,0,,Барлығы
Dialogue: 0,0:17:11.84,0:17:13.68,Default - Copy,Priscilla,0,0,0,,Иллюзия
Dialogue: 0,0:17:16.05,0:17:19.68,Default - Copy,Priscilla,0,0,0,,Мен бір ақымақ нәрсені білемін.
Dialogue: 0,0:17:28.69,0:17:30.96,Default - Copy,Priscilla,0,0,0,,Сағыныш қылыш
Dialogue: 0,0:17:34.43,0:17:35.30,Default - Copy,Deneve,0,0,0,,Хелен
Dialogue: 0,0:17:44.24,0:17:45.38,Default - Copy,Miria,0,0,0,,Денев
Dialogue: 0,0:17:46.38,0:17:47.25,Default - Copy,Miria,0,0,0,,Абайлаңыз
Dialogue: 0,0:17:52.62,0:17:53.85,Default - Copy,Helen,0,0,0,,Ақымақ
Dialogue: 0,0:18:02.43,0:18:03.29,Default - Copy,Miria,0,0,0,,Хелен
Dialogue: 0,0:18:11.47,0:18:15.41,Default - Copy,Miria,0,0,0,,Бұл Тереза Смайлзды жеңді.
Dialogue: 0,0:18:15.94,0:18:17.78,Default - Copy,Miria,0,0,0,,Оянғандардың күші
Dialogue: 0,0:18:28.95,0:18:34.43,Default - Copy,Easley,0,0,0,,Менің ойымша, Ригалдоны жеңген Клейморлар аяқталды.
Dialogue: 0,0:18:50.68,0:18:53.01,Default - Copy,Clare,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:18:54.51,0:18:55.95,Default - Copy,Clare,0,0,0,,Осындай жерде
Dialogue: 0,0:19:02.95,0:19:05.26,Default - Copy,Clare,0,0,0,,Менің достарым да көмектесе алмайды
Dialogue: 0,0:19:20.41,0:19:21.64,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:19:24.24,0:19:26.41,Default - Copy,Clare,0,0,0,,Мен не үшінмін?
Dialogue: 0,0:19:30.31,0:19:31.32,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:19:31.85,0:19:33.55,Default - Copy,Teresa,0,0,0,,Клэр ше?
Dialogue: 0,0:19:46.93,0:19:47.93,Default - Copy,Clare,0,0,0,,Прискила
Dialogue: 0,0:19:51.74,0:19:52.87,Default - Copy,Clare,0,0,0,,өлтіру
Dialogue: 0,0:19:53.84,0:19:54.94,Default - Copy,Clare,0,0,0,,Прискила
Dialogue: 0,0:19:57.48,0:20:00.11,Default - Copy,Clare,0,0,0,,Сол себепті мен жауынгер атандым
Dialogue: 0,0:20:03.41,0:20:05.72,Default - Copy,Clare,0,0,0,,Прискиланы өлтіре алмасаң
