Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:39.53,0:01:40.80,Default - Copy,Ophelia,0,0,0,,Кеш болды
Dialogue: 0,0:01:41.50,0:01:44.01,Default - Copy,Ophelia,0,0,0,,Сіз тым кеш қалдыңыз.
Dialogue: 0,0:01:44.91,0:01:48.28,Default - Copy,Ophelia,0,0,0,,Қалдық өте көп.
Dialogue: 0,0:01:48.28,0:01:50.81,Default - Copy,Ophelia,0,0,0,,Сіздің қалай күресетініңіз де солай.
Dialogue: 0,0:01:50.81,0:01:53.52,Default - Copy,Ophelia,0,0,0,,Оның біршама күші бар.
Dialogue: 0,0:01:53.52,0:01:56.18,Default - Copy,Ophelia,0,0,0,,тиімдірек пайдалану керек
Dialogue: 0,0:02:01.79,0:02:03.29,Default - Copy,Ophelia,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:03.59,0:02:06.83,Default - Copy,Ophelia,0,0,0,,Өте күшті қарсыласпен күрескеннен кейін
Dialogue: 0,0:02:06.83,0:02:08.80,Default - Copy,Ophelia,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:02:11.77,0:02:13.17,Default - Copy,Ophelia,0,0,0,,Оянғандар
Dialogue: 0,0:02:13.60,0:02:16.94,Default - Copy,Ophelia,0,0,0,,Мен олардың әрқайсысын жұлып аламын.
Dialogue: 0,0:02:24.88,0:02:26.68,Default - Copy,Ophelia,0,0,0,,Сіз неге еліктейсіз?
Dialogue: 0,0:02:27.28,0:02:29.35,Default - Copy,Ophelia,0,0,0,,Жындарыңызды өзіңіз басу
Dialogue: 0,0:02:29.78,0:02:31.65,Default - Copy,Ophelia,0,0,0,,Сіз бас тарттыңыз
Dialogue: 0,0:02:35.99,0:02:38.69,Default - Copy,Ophelia,0,0,0,,Сіз қызықсыз
Dialogue: 0,0:02:55.18,0:02:57.18,Default - Copy,Ophelia,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:02:57.58,0:03:00.55,Default - Copy,Ophelia,0,0,0,,Мүмкін мен жындардың қимылын болжап отырған шығармын.
Dialogue: 0,0:03:01.15,0:03:02.88,Default - Copy,Ophelia,0,0,0,,Сіз мұны жасамайсыз
Dialogue: 0,0:03:02.88,0:03:04.55,Default - Copy,Ophelia,0,0,0,,Айтыңызшы.
Dialogue: 0,0:03:04.55,0:03:07.32,Default - Copy,Ophelia,0,0,0,,Бұрын қызықсыз деп айтқаным үшін кешіріңіз.
Dialogue: 0,0:03:16.20,0:03:19.80,Default - Copy,Ophelia,0,0,0,,О, өте жақсы сезіледі.
Dialogue: 0,0:03:20.47,0:03:24.04,Default - Copy,Ophelia,0,0,0,,Мен мұны істеудің уақыты келді деп ойладым.
Dialogue: 0,0:03:24.84,0:03:28.04,Default - Copy,Clare,0,0,0,,Дәл қазір бұл қандай оғаш сезім?
Dialogue: 0,0:03:30.85,0:03:32.41,Default - Copy,Ophelia,0,0,0,,Өтінемін
Dialogue: 0,0:03:32.41,0:03:34.98,Default - Copy,Ophelia,0,0,0,,Бірінші атылғанда өлме.
Dialogue: 0,0:03:38.29,0:03:39.15,Default - Copy,Clare,0,0,0,,Келіңіздер
Dialogue: 0,0:03:39.15,0:03:40.36,Default - Copy,Clare,0,0,0,,Аяқтан оң иыққа дейін
Dialogue: 0,0:03:48.36,0:03:49.80,Default - Copy,Clare,0,0,0,,Жоғарғы қатардан сол иыққа
Dialogue: 0,0:03:54.24,0:03:55.27,Default - Copy,Clare,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:03:55.27,0:03:56.87,Default - Copy,Clare,0,0,0,,Мен қылыштың траекториясын оқыдым.
Dialogue: 0,0:03:56.87,0:03:58.37,Default - Copy,Clare,0,0,0,,Неліктен оның алдын алуға болмайды?
Dialogue: 0,0:04:03.31,0:04:04.35,Default - Copy,Clare,0,0,0,,Ақымақ
Dialogue: 0,0:04:04.95,0:04:07.48,Default - Copy,Clare,0,0,0,,Қылыш жылан сияқты
Dialogue: 0,0:04:10.82,0:04:12.42,Default - Copy,Ophelia,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:04:14.56,0:04:19.99,Default - Copy,Ophelia,0,0,0,,Егер мен сіздің қарсыласыңыз болмасам, сіз өте жақсы жерде болар едіңіз деп ойлаймын.
Dialogue: 0,0:04:22.00,0:04:23.47,Default - Copy,Ophelia,0,0,0,,Мен кіммін?
Dialogue: 0,0:04:24.03,0:04:27.57,Default - Copy,Ophelia,0,0,0,,Оның басқалар сияқты лақап аты жоқ.
Dialogue: 0,0:04:27.89,0:04:29.61,Default - Copy,Ophelia,0,0,0,,Мирия фантом
Dialogue: 0,0:04:29.61,0:04:31.51,Default - Copy,Ophelia,0,0,0,,Флора жел кескіш
Dialogue: 0,0:04:31.51,0:04:32.74,Default - Copy,Ophelia,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:04:33.34,0:04:36.14,Default - Copy,Ophelia,0,0,0,,Сондықтан ерекше қимылдарды жасау үшін көп жұмыс жасадым.
Dialogue: 0,0:04:36.14,0:04:37.85,Default - Copy,Ophelia,0,0,0,,Мен оған ат қойдым.
Dialogue: 0,0:04:42.82,0:04:45.35,Default - Copy,Ophelia,0,0,0,,Бұл толқынды қылыш деп аталады.
Dialogue: 0,0:04:46.35,0:04:47.36,Default - Copy,Clare,0,0,0,,Қылыш
Dialogue: 0,0:04:47.89,0:04:49.49,Default - Copy,Clare,0,0,0,,Жоқ, бұл иллюзия.
Dialogue: 0,0:04:49.89,0:04:51.93,Default - Copy,Clare,0,0,0,,Мүмкін емес қол қозғалысымен
Dialogue: 0,0:04:51.93,0:04:54.20,Default - Copy,Clare,0,0,0,,Жылан тәрізді қозғалысты жасау
Dialogue: 0,0:04:55.00,0:04:56.87,Default - Copy,Ophelia,0,0,0,,Өте жақсы.
Dialogue: 0,0:04:57.33,0:05:02.00,Default - Copy,Ophelia,0,0,0,,Менің ойымша, Ripples of Ophelia тамаша емес.
Dialogue: 0,0:05:04.27,0:05:07.51,Default - Copy,Ophelia,0,0,0,,Бірақ ол кеңейіп жатқан жоқ.
Dialogue: 0,0:05:08.04,0:05:12.51,Default - Copy,Ophelia,0,0,0,,Мұны көрген адамдардың көпшілігі өледі.
Dialogue: 0,0:05:14.72,0:05:15.52,Default - Copy,Clare,0,0,0,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:05:16.38,0:05:19.29,Default - Copy,Clare,0,0,0,,Бұл менің алдыма қарайтын әдіс емес.
Dialogue: 0,0:05:23.69,0:05:26.80,Default - Copy,Ophelia,0,0,0,,О, сіз әлі де мотивациясыз.
Dialogue: 0,0:05:27.16,0:05:29.80,Default - Copy,Ophelia,0,0,0,,Сізде жеңу мүмкіндігі бар ма деп ойлаймын.
Dialogue: 0,0:05:32.23,0:05:33.47,Default - Copy,Clare,0,0,0,,Жеңіске жету мүмкіндігі бар ма?
Dialogue: 0,0:05:34.10,0:05:37.27,Default - Copy,Clare,0,0,0,,Мұндай нәрсе басынан бері бола алмайды.
Dialogue: 0,0:05:40.44,0:05:41.24,Default - Copy,Ophelia,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:05:41.24,0:05:43.18,Default - Copy,Ophelia,0,0,0,,Фронтальды шабуыл
Dialogue: 0,0:05:47.62,0:05:49.65,Default - Copy,Ophelia,0,0,0,,Қандай көңілсіздік.
Dialogue: 0,0:05:59.43,0:06:01.13,Default - Copy,Ophelia,0,0,0,,Бұл шынымен қызықсыз
Dialogue: 0,0:06:01.13,0:06:02.23,Default - Copy,Ophelia,0,0,0,,Өлген
Dialogue: 0,0:06:21.98,0:06:24.15,Default - Copy,Ophelia,0,0,0,,Пердені жабуда қателессеңіз
Dialogue: 0,0:06:24.49,0:06:26.12,Default - Copy,Ophelia,0,0,0,,Бұл жай ғана шіркін
Dialogue: 0,0:06:48.48,0:06:49.48,Default - Copy,Clare,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:06:49.48,0:06:51.25,Default - Copy,Clare,0,0,0,,Кесілген жер тым терең болды ма?
Dialogue: 0,0:06:52.31,0:06:56.48,Default - Copy,Clare,0,0,0,,Жоқ, бірақ одан таязырақ болса, кесу сезімі жеткіліксіз болады.
Dialogue: 0,0:06:57.69,0:06:59.59,Default - Copy,Clare,0,0,0,,Тірі болған жақсы ма?
Dialogue: 0,0:07:02.82,0:07:04.39,Default - Copy,Clare,0,0,0,,Демалуға уақыт жоқ
Dialogue: 0,0:07:04.79,0:07:05.99,Default - Copy,Clare,0,0,0,,Тез қарулану
Dialogue: 0,0:07:05.99,0:07:07.76,Default - Copy,Ophelia,0,0,0,,​​Сіз мұны жасайсыз.
Dialogue: 0,0:07:10.87,0:07:13.50,Default - Copy,Ophelia,0,0,0,,Мен алданып қала жаздадым.
Dialogue: 0,0:07:14.57,0:07:17.64,Default - Copy,Ophelia,0,0,0,,Әсіресе оң қолды кесіп алған жақсы.
Dialogue: 0,0:07:18.21,0:07:21.14,Default - Copy,Ophelia,0,0,0,,Орнындалғандай көрінетін нәрсе.
Dialogue: 0,0:07:21.81,0:07:25.51,Default - Copy,Ophelia,0,0,0,,Бұл орынды таңдау осыны ескере отырып жасалды.
Dialogue: 0,0:07:26.31,0:07:31.25,Default - Copy,Ophelia,0,0,0,,Мен сенің алақаныңда әу бастан билеп келемін.
Dialogue: 0,0:07:32.19,0:07:36.12,Default - Copy,Ophelia,0,0,0,,Бірақ содан кейін сол оң қолымнан бас тартуым керек еді.
Dialogue: 0,0:07:37.23,0:07:41.76,Default - Copy,Ophelia,0,0,0,,Менің назарымды аударғаны – аяғына дейін оң қолым үшін уайымдадым.
Dialogue: 0,0:07:43.30,0:07:44.77,Default - Copy,Ophelia,0,0,0,,Иә, білемін.
Dialogue: 0,0:07:44.77,0:07:48.57,Default - Copy,Ophelia,0,0,0,,Біз сияқты шабуылға шебер жауынгерлердің де түрлері бар.
Dialogue: 0,0:07:48.57,0:07:51.04,Default - Copy,Ophelia,0,0,0,,Қорғанысы тамаша түрі бар.
Dialogue: 0,0:07:51.47,0:07:53.54,Default - Copy,Ophelia,0,0,0,,Сіз агрессивті типсіз
Dialogue: 0,0:07:54.14,0:07:58.11,Default - Copy,Ophelia,0,0,0,,Шабуылшылар өз денелерін қалпына келтіруге шебер емес, солай ма?
Dialogue: 0,0:07:58.11,0:08:01.22,Default - Copy,Ophelia,0,0,0,,Кесілген денелерді қосу мүмкін болғанымен
Dialogue: 0,0:08:01.22,0:08:04.05,Default - Copy,Ophelia,0,0,0,,Жоғалғанды қайта қалпына келтіру мүмкін емес.
Dialogue: 0,0:08:05.05,0:08:07.26,Default - Copy,Ophelia,0,0,0,,Жарты адам, жартылай жын болған кезде
Dialogue: 0,0:08:07.26,0:08:11.03,Default - Copy,Ophelia,0,0,0,,Сіз аман қалу үшін өзіңізді қорғау туралы ойладыңыз ба?
Dialogue: 0,0:08:11.49,0:08:14.96,Default - Copy,Ophelia,0,0,0,,Сіз басқа адамды өлтіру туралы ойладыңыз ба?
Dialogue: 0,0:08:14.96,0:08:17.17,Default - Copy,Ophelia,0,0,0,,Бұл жолдың бұрылысы.
Dialogue: 0,0:08:23.34,0:08:27.21,Default - Copy,Ophelia,0,0,0,,арқылы не айтқым келеді
Dialogue: 0,0:08:27.58,0:08:31.71,Default - Copy,Ophelia,0,0,0,,Менің ойымша, мен сол оң қолдың бекітілуін күтіп отырмын.
Dialogue: 0,0:08:39.19,0:08:40.52,Default - Copy,Ophelia,0,0,0,,Өте жаман
Dialogue: 0,0:08:40.52,0:08:43.66,Default - Copy,Ophelia,0,0,0,,Оның басым қолын кесіп алуы қате болды.
Dialogue: 0,0:09:08.75,0:09:10.42,Default - Copy,Ophelia,0,0,0,,Күресудің қажеті жоқ
Dialogue: 0,0:09:10.42,0:09:13.02,Default - Copy,Ophelia,0,0,0,,Тіпті сіз оны әрең білмейсіз.
Dialogue: 0,0:09:23.30,0:09:26.10,Default - Copy,Ophelia,0,0,0,,Иә. . Сіз сонша тырысып жатқаныңызға сене алар емеспін
Dialogue: 0,0:09:26.10,0:09:28.44,Default - Copy,Ophelia,0,0,0,,Сол балаға уәде бер
Dialogue: 0,0:09:28.44,0:09:32.51,Default - Copy,Ophelia,0,0,0,,Немесе сізде кек алу керек шығар.
Dialogue: 0,0:09:41.62,0:09:42.45,Default - Copy,Ophelia,0,0,0,,Иә
Dialogue: 0,0:09:42.45,0:09:44.49,Default - Copy,Ophelia,0,0,0,,Енді мен қылышты да ұстай алмаймын.
Dialogue: 0,0:09:48.36,0:09:50.43,Default - Copy,Ophelia,0,0,0,,Өйткені қорғайтын нәрсе бар
Dialogue: 0,0:09:51.06,0:09:55.00,Default - Copy,Ophelia,0,0,0,,Сіз өмір сүре аласыз, өйткені сізде өлмеуге себеп бар.
Dialogue: 0,0:09:55.46,0:09:57.20,Default - Copy,Ophelia,0,0,0,,Бұл әлсіздердің ақымақ адасуы.
Dialogue: 0,0:09:59.90,0:10:01.54,Default - Copy,Ophelia,0,0,0,,Бұл өте қызық болды.
Dialogue: 0,0:10:08.94,0:10:12.21,Default - Copy,Irene,0,0,0,,Мені сағыныш сезімі шақырып, осында келдім.
Dialogue: 0,0:10:13.08,0:10:14.88,Default - Copy,Irene,0,0,0,,Екі беті де белгісіз.
Dialogue: 0,0:10:17.35,0:10:19.12,Default - Copy,Ophelia,0,0,0,,Не?
Dialogue: 0,0:10:19.12,0:10:21.12,Default - Copy,Ophelia,0,0,0,,Мен ешқандай елес энергияны сезбеймін.
Dialogue: 0,0:10:21.56,0:10:26.63,Default - Copy,Ophelia,0,0,0,,Мені ең қатты ренжітетіні – көңілді жүргенімде, мені бөгетпейді.
Dialogue: 0,0:10:28.16,0:10:29.00,Default - Copy,Clare,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:10:29.00,0:10:30.50,Default - Copy,Clare,0,0,0,,Бұл қауіпті
Dialogue: 0,0:10:30.50,0:10:31.67,Default - Copy,Clare,0,0,0,,Мен оны қажетсіз өлуіне жол бермеймін!
Dialogue: 0,0:10:33.34,0:10:34.30,Default - Copy,Irene,0,0,0,,Мен көремін.
Dialogue: 0,0:10:34.30,0:10:35.47,Default - Copy,Irene,0,0,0,,Шығатын жол жоқ сияқты
Dialogue: 0,0:10:41.74,0:10:44.15,Default - Copy,Ophelia,0,0,0,,Эй, сен не істедің?
Dialogue: 0,0:10:44.81,0:10:48.82,Default - Copy,Irene,0,0,0,,Қазіргі жауынгерлер тіпті қарапайым адамдарға қылышты бере ме?
Dialogue: 0,0:10:56.19,0:10:57.26,Default - Copy,Ophelia,0,0,0,,Не?
Dialogue: 0,0:10:57.26,0:10:58.63,Default - Copy,Ophelia,0,0,0,,Титан туралы сөйлесіп отырдық, иә?
Dialogue: 0,0:11:02.13,0:11:03.13,Default - Copy,Clare,0,0,0,,Абайлаңыз
Dialogue: 0,0:11:03.13,0:11:03.70,Default - Copy,Clare,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:11:06.84,0:11:08.70,Default - Copy,Irene,0,0,0,,Бұл біртүрлі қылыш.
Dialogue: 0,0:11:09.37,0:11:12.11,Default - Copy,Irene,0,0,0,,Оның белгілі бір саны бар шығар.
Dialogue: 0,0:11:14.04,0:11:14.84,Default - Copy,Irene,0,0,0,,Бірақ
Dialogue: 0,0:11:14.84,0:11:16.85,Default - Copy,Irene,0,0,0,,Бұл қылыштың алдында мағынасыз
Dialogue: 0,0:11:20.18,0:11:22.28,Default - Copy,Ophelia,0,0,0,,Қ-қандай?
Dialogue: 0,0:11:22.28,0:11:23.62,Default - Copy,Ophelia,0,0,0,,Бұл көзге көрінбейтін қылыш
Dialogue: 0,0:11:30.13,0:11:31.06,Default - Copy,Clare,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:31.69,0:11:32.76,Default - Copy,Clare,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:11:35.66,0:11:37.63,Default - Copy,Clare,0,0,0,,Терезаның бағынышты тобының бірі
Dialogue: 0,0:11:38.17,0:11:39.50,Default - Copy,Clare,0,0,0,,Бұрынғы №2
Dialogue: 0,0:11:40.94,0:11:43.20,Default - Copy,Clare,0,0,0,,Жылдам қылыш Ирин
Dialogue: 0,0:11:50.81,0:11:52.81,Default - Copy,Ophelia,0,0,0,,Өйткені қорғайтын нәрсе бар
Dialogue: 0,0:11:53.21,0:11:56.65,Default - Copy,Ophelia,0,0,0,,Сіз өмір сүре аласыз, өйткені сізде өлмеуге себеп бар.
Dialogue: 0,0:11:57.05,0:11:59.39,Default - Copy,Ophelia,0,0,0,,Бұл әлсіздердің ақымақ адасуы.
Dialogue: 0,0:12:09.10,0:12:10.23,Default - Copy,Clare,0,0,0,,Бұл
Dialogue: 0,0:12:24.51,0:12:25.55,Default - Copy,Clare,0,0,0,,Сол қол
Dialogue: 0,0:12:28.58,0:12:32.82,Default - Copy,Irene,0,0,0,,Сол қолымды байлағаннан кейін ес-түссіз қалдым.
Dialogue: 0,0:12:33.56,0:12:37.43,Default - Copy,Irene,0,0,0,,Бүлінгеніне қарамастан жақсы жасалған.
Dialogue: 0,0:12:38.03,0:12:38.93,Default - Copy,Clare,0,0,0,,Айрин
Dialogue: 0,0:12:40.93,0:12:42.66,Default - Copy,Clare,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:12:42.66,0:12:43.93,Default - Copy,Clare,0,0,0,,Содан бері неше күн өтті?
Dialogue: 0,0:12:44.40,0:12:45.67,Default - Copy,Clare,0,0,0,,Неге сен?
Dialogue: 0,0:12:47.04,0:12:49.20,Default - Copy,Irene,0,0,0,,Тек аузыңызға салыңыз.
Dialogue: 0,0:12:49.70,0:12:53.61,Default - Copy,Irene,0,0,0,,Бір апта бойы ішіп-жемей қоятын кез келді.
Dialogue: 0,0:12:54.08,0:12:55.11,Default - Copy,Clare,0,0,0,,Бір апта бойы
Dialogue: 0,0:12:57.28,0:12:58.71,Default - Copy,Clare,0,0,0,,Менің қылышым қайда?
Dialogue: 0,0:12:59.18,0:12:59.85,Default - Copy,Irene,0,0,0,,Эй
Dialogue: 0,0:12:59.85,0:13:01.18,Default - Copy,Clare,0,0,0,,Егер тезірек оралмасақ
Dialogue: 0,0:13:02.88,0:13:04.89,Default - Copy,Irene,0,0,0,,Өмір соншалықты қажет болмаса
Dialogue: 0,0:13:04.89,0:13:07.92,Default - Copy,Irene,0,0,0,,Мен оны дәл осы жерден кесіп аламын.
Dialogue: 0,0:13:08.32,0:13:12.19,Default - Copy,Irene,0,0,0,,Тыңдашы, сені қуған әйел әлі тірі.
Dialogue: 0,0:13:12.83,0:13:14.93,Default - Copy,Irene,0,0,0,,Мен саған қарағанда көбірек зиян келтірдім.
Dialogue: 0,0:13:15.33,0:13:16.50,Default - Copy,Irene,0,0,0,,Өлмеген
Dialogue: 0,0:13:18.43,0:13:19.37,Default - Copy,Irene,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:13:19.83,0:13:24.74,Default - Copy,Irene,0,0,0,,Сіз басым қолыңыздан айырылдыңыз, енді бір қолыңызбен күресуден басқа амалыңыз жоқ.
Dialogue: 0,0:13:25.47,0:13:28.48,Default - Copy,Irene,0,0,0,,Дәл қазір бір кішкентай шабақтарды жеңе алмау керек.
Dialogue: 0,0:13:34.58,0:13:37.15,Default - Copy,Irene,0,0,0,,Менің ойымша, сіз өзіңізді аздап түсіндіре аласыз.
Dialogue: 0,0:13:39.35,0:13:40.42,Default - Copy,Clare,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:13:46.16,0:13:47.00,Default - Copy,Clare,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:13:47.66,0:13:48.56,Default - Copy,Clare,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:14:22.06,0:14:23.67,Default - Copy,Irene,0,0,0,,Сол қыз
Dialogue: 0,0:14:39.88,0:14:41.55,Default - Copy,Irene,0,0,0,,Тамағыңызды бітірдіңіз бе?
Dialogue: 0,0:14:41.88,0:14:42.65,Default - Copy,Clare,0,0,0,,Ах
Dialogue: 0,0:14:43.08,0:14:47.32,Default - Copy,Clare,0,0,0,,Мен тістеп алған сәтте-ақ қарнымның ашқанын түсіндім.
Dialogue: 0,0:14:47.92,0:14:48.86,Default - Copy,Clare,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:14:49.86,0:14:51.89,Default - Copy,Irene,0,0,0,,Сіз менің атымды білдіңіз
Dialogue: 0,0:14:51.89,0:14:52.99,Default - Copy,Irene,0,0,0,,Сіз зерттедіңіз бе?
Dialogue: 0,0:14:53.50,0:14:54.53,Default - Copy,Clare,0,0,0,,At that time
Dialogue: 0,0:14:55.30,0:14:57.83,Default - Copy,Clare,0,0,0,,Терезаға қатысты барлығы
Dialogue: 0,0:14:58.23,0:15:00.84,Default - Copy,Irene,0,0,0,,Әрине, Прискила туралы да.
Dialogue: 0,0:15:01.14,0:15:01.87,Default - Copy,Clare,0,0,0,,Ах
Dialogue: 0,0:15:04.31,0:15:07.78,Default - Copy,Clare,0,0,0,,Присцилла, ол сол кезде 2-ші нөмір болуы керек еді
Dialogue: 0,0:15:10.81,0:15:12.71,Default - Copy,Clare,0,0,0,,Алайда ол миссия кезінде оянды.
Dialogue: 0,0:15:13.52,0:15:16.42,Default - Copy,Clare,0,0,0,,Терезаны және оның бағынышты тобын өлтіріп, жоғалып кетті.
Dialogue: 0,0:15:19.42,0:15:21.89,Default - Copy,Clare,0,0,0,,Мен сені тірі деп ойламадым.
Dialogue: 0,0:15:22.82,0:15:24.66,Default - Copy,Irene,0,0,0,,Мен де таң қалдым.
Dialogue: 0,0:15:25.49,0:15:28.76,Default - Copy,Irene,0,0,0,,Мен ол кездегі бала жауынгер болып шығады деп ойламаппын.
Dialogue: 0,0:15:30.70,0:15:34.04,Default - Copy,Irene,0,0,0,,Тереза ​​сіздің ішіңізде ме?
Dialogue: 0,0:15:37.07,0:15:39.37,Default - Copy,Irene,0,0,0,,Өмірді алу бақыты болса
Dialogue: 0,0:15:39.37,0:15:43.14,Default - Copy,Irene,0,0,0,,Бәрін ұмытып, адам болып өмір сүрсем ғой.
Dialogue: 0,0:15:43.75,0:15:45.91,Default - Copy,Irene,0,0,0,,Прискиланың басын алуды жоспарлап отырсыз ба?
Dialogue: 0,0:15:46.48,0:15:47.85,Default - Copy,Clare,0,0,0,,Thank you for your help
Dialogue: 0,0:15:48.48,0:15:50.02,Default - Copy,Clare,0,0,0,,Менің қылышым қайда?
Dialogue: 0,0:15:50.59,0:15:51.65,Default - Copy,Irene,0,0,0,,Тоқта.
Dialogue: 0,0:15:52.09,0:15:54.26,Default - Copy,Irene,0,0,0,,Прискиланың күші басым
Dialogue: 0,0:15:54.86,0:15:58.93,Default - Copy,Irene,0,0,0,,Қазіргі жауынгерлердің ешқайсысы оны тоқтата алмайды.
Dialogue: 0,0:15:59.73,0:16:02.60,Default - Copy,Irene,0,0,0,,Әсіресе сіз Терезаның еті мен қанын алғаннан бері.
Dialogue: 0,0:16:02.60,0:16:04.50,Default - Copy,Irene,0,0,0,,Жарты адам, жартылай жын да емес
Dialogue: 0,0:16:04.50,0:16:05.53,Default - Copy,Irene,0,0,0,,Тоқсан
Dialogue: 0,0:16:06.17,0:16:08.44,Default - Copy,Irene,0,0,0,,Бәрінен де төмен
Dialogue: 0,0:16:09.50,0:16:11.37,Default - Copy,Clare,0,0,0,,Маған қылышымды бер
Dialogue: 0,0:16:12.67,0:16:13.44,Default - Copy,Irene,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:16:15.61,0:16:20.45,Default - Copy,Irene,0,0,0,,Қылышыма бір рет тигенде сол қолымнан айырылдым.
Dialogue: 0,0:16:20.88,0:16:26.99,Default - Copy,Irene,0,0,0,,Қанша тырысқанымызбен, олардан жеңу мүмкін емес екенін сол кезде түсіндім.
Dialogue: 0,0:16:29.59,0:16:32.13,Default - Copy,Irene,0,0,0,,Ал мен өзімді өліп қалдым
Dialogue: 0,0:16:32.53,0:16:35.00,Default - Copy,Irene,0,0,0,,Ұйымның иісі жоқ жерді таңдаңыз.
Dialogue: 0,0:16:35.40,0:16:37.90,Default - Copy,Irene,0,0,0,,Мен жындарымды басып өмір сүрдім.
Dialogue: 0,0:16:40.07,0:16:42.20,Default - Copy,Irene,0,0,0,,Көп жылдар бойы басылған жындық қуат
Dialogue: 0,0:16:42.20,0:16:44.77,Default - Copy,Irene,0,0,0,,Менің достарым да енді байқамайды
Dialogue: 0,0:16:45.37,0:16:46.98,Default - Copy,Clare,0,0,0,,Сіз ұрысты тоқтаттыңыз ба?
Dialogue: 0,0:16:47.64,0:16:48.91,Default - Copy,Clare,0,0,0,,Оның бір ғана қолы болса да
Dialogue: 0,0:16:49.24,0:16:51.08,Default - Copy,Clare,0,0,0,,Мен осылай қылышты қолдансам да.
Dialogue: 0,0:16:52.55,0:16:54.78,Default - Copy,Irene,0,0,0,,Мен қорқамын.
Dialogue: 0,0:16:55.85,0:16:58.65,Default - Copy,Irene,0,0,0,,Сол кездегі қорқыныш санамда қалып қойды, жібермейді.
Dialogue: 0,0:16:59.49,0:17:01.02,Default - Copy,Irene,0,0,0,,Сіз де көрген боларсыз.
Dialogue: 0,0:17:14.40,0:17:15.57,Default - Copy,Clare,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,0:17:16.24,0:17:17.17,Default - Copy,Clare,0,0,0,,Ол сондай адам.
Dialogue: 0,0:17:21.44,0:17:22.18,Default - Copy,Irene,0,0,0,,Қ-Қандай?
Dialogue: 0,0:17:23.71,0:17:25.35,Default - Copy,Irene,0,0,0,,Неге сонша?
Dialogue: 0,0:17:26.85,0:17:28.22,Default - Copy,Clare,0,0,0,,Мен үшін
Dialogue: 0,0:17:29.28,0:17:31.09,Default - Copy,Clare,0,0,0,,Тереза бәрі болды
Dialogue: 0,0:17:32.95,0:17:35.49,Default - Copy,Clare,0,0,0,,Бір кезде жоғалған өмір мен сөздер
Dialogue: 0,0:17:36.02,0:17:37.59,Default - Copy,Clare,0,0,0,,Тіпті өмір сүрудің қуанышы
Dialogue: 0,0:17:38.19,0:17:39.99,Default - Copy,Clare,0,0,0,,Тереза оны қайтарып алды
Dialogue: 0,0:17:41.23,0:17:44.87,Default - Copy,Clare,0,0,0,,Тереза маған бәрін берді
Dialogue: 0,0:17:45.43,0:17:49.87,Default - Copy,Clare,0,0,0,,Сондықтан алға ұмтылудан басқа амалым қалмады.
Dialogue: 0,0:17:51.84,0:17:53.54,Default - Copy,Clare,0,0,0,,Сол кез туралы
Dialogue: 0,0:17:53.54,0:17:58.21,Default - Copy,Clare,0,0,0,,Бәрін ұмытып, адам болып өмір сүруге күшім жетпеді.
Dialogue: 0,0:18:02.35,0:18:03.55,Default - Copy,Irene,0,0,0,,Мен көремін.
Dialogue: 0,0:18:04.49,0:18:05.89,Default - Copy,Irene,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:18:10.19,0:18:12.63,Default - Copy,Irene,0,0,0,,Мен де дәл сол кезде көрдім.
Dialogue: 0,0:18:12.63,0:18:15.06,Default - Copy,Irene,0,0,0,,Алға немесе артқа жылжу ма?
Dialogue: 0,0:18:16.03,0:18:21.94,Default - Copy,Irene,0,0,0,,Бұл сіздің жекпе-жекке жарамдылығыңыз немесе жоқтығыңыздың бетбұрыс нүктесі болса керек.
Dialogue: 0,0:18:33.88,0:18:36.89,Default - Copy,Irene,0,0,0,,Мен сенің атыңды әлі естіген жоқпын.
Dialogue: 0,0:18:37.99,0:18:39.02,Default - Copy,Clare,0,0,0,,Бұл Клэр.
Dialogue: 0,0:18:43.12,0:18:44.53,Default - Copy,Irene,0,0,0,,Жарайды, Клэр.
Dialogue: 0,0:18:46.93,0:18:49.60,Default - Copy,Irene,0,0,0,,Мен саған жылдам семсерді үйретемін.
Dialogue: 0,0:18:58.01,0:18:58.87,Default - Copy,Ophelia,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:18:59.54,0:19:00.64,Default - Copy,Ophelia,0,0,0,,Ауырды
Dialogue: 0,0:19:01.61,0:19:05.71,Default - Copy,Ophelia,0,0,0,,Ауырды, ағайын.
Dialogue: 0,0:19:09.35,0:19:12.42,Default - Copy,Ophelia,0,0,0,,Маған көмектесші, ағайын.
Dialogue: 0,0:19:13.22,0:19:17.03,Default - Copy,Ophelia,0,0,0,,Сен мені әрқашан қорғадың.
Dialogue: 0,0:19:18.39,0:19:19.49,Default - Copy,Ophelia,0,0,0,,Шыгандшинаға баратын жолды іздеуге аттанған Зерттеу корпусы,
Dialogue: 0,0:19:19.93,0:19:23.30,Default - Copy,Ophelia,0,0,0,,Сен неге оңай өлесің?
Dialogue: 0,0:19:24.17,0:19:27.54,Default - Copy,Ophelia,0,0,0,,Сіз мені қорғауыңыз керек еді, солай ма?
Dialogue: 0,0:19:30.44,0:19:32.18,Default - Copy,Ophelia,0,0,0,,Әлгі қарғыс атқан әйел
Dialogue: 0,0:19:32.71,0:19:34.48,Default - Copy,Ophelia,0,0,0,,Бұл тегін емес.
Dialogue: 0,0:19:34.94,0:19:36.54,Default - Copy,Ophelia,0,0,0,,Бұл менің ағам.
Dialogue: 0,0:19:36.54,0:19:37.75,Default - Copy,Ophelia,0,0,0,,Бұл кім?
Dialogue: 0,0:19:38.25,0:19:40.15,Default - Copy,Ophelia,0,0,0,,Осындай бір мүйізді құбыжықтың жеуі
Dialogue: 0,0:19:40.15,0:19:43.05,Default - Copy,Ophelia,0,0,0,,Мен ыңғайлы көрінетін ешкімді білмеймін.
Dialogue: 0,0:19:43.05,0:19:45.12,Default - Copy,Ophelia,0,0,0,,Ақымақ болма, бейбақ.
Dialogue: 0,0:19:45.12,0:19:46.39,Default - Copy,Ophelia,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:19:46.39,0:19:47.82,Default - Copy,Ophelia,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:19:47.82,0:19:49.06,Default - Copy,Ophelia,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:19:49.49,0:19:51.39,Default - Copy,Ophelia,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:20:06.64,0:20:07.54,Default - Copy,Irene,0,0,0,,Осымен
Dialogue: 0,0:20:07.54,0:20:08.44,Default - Copy,Irene,0,0,0,,Оларды мына жерге ыстық шоколадпен қойып кетейін, жарай ма?
Dialogue: 0,0:20:14.02,0:20:15.88,Default - Copy,Irene,0,0,0,,Жылдам семсердің шын мәні неде?
Dialogue: 0,0:20:15.88,0:20:18.42,Default - Copy,Irene,0,0,0,,Бір ғана қолдың сиқырлы күшін толық босату
Dialogue: 0,0:20:18.95,0:20:22.46,Default - Copy,Irene,0,0,0,,Басқаша айтқанда, бір қолы ғана ояу сияқты.
Dialogue: 0,0:20:23.36,0:20:27.16,Default - Copy,Irene,0,0,0,,Ол үшін күшті ерік күші қажет.
Dialogue: 0,0:20:27.76,0:20:31.53,Default - Copy,Irene,0,0,0,,Бұл оның бір қолын ұстайтын күшті психикалық күш.
Dialogue: 0,0:20:32.23,0:20:36.44,Default - Copy,Clare,0,0,0,,Сонда сіз өңіңізді мүлде өзгертпей осылай жасадыңыз ба?
Dialogue: 0,0:20:37.14,0:20:38.07,Default - Copy,Irene,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:20:38.44,0:20:39.57,Default - Copy,Irene,0,0,0,,Мен бас тартуым керек пе?
Dialogue: 0,0:20:41.68,0:20:42.84,Default - Copy,Clare,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:20:44.11,0:20:46.92,Default - Copy,Clare,0,0,0,,Бұл мен үшін өте қолайлы.
Dialogue: 0,0:20:47.95,0:20:49.18,Default - Copy,Irene,0,0,0,,Жарайды, келіңіз.
Dialogue: 0,0:20:49.18,0:20:53.96,Default - Copy,Irene,0,0,0,,Бір қолдың толық сиқырлы күшінің шегін өзіңіздікіне айналдырыңыз.
Dialogue: 0,0:21:01.30,0:21:02.66,Default - Copy,Ophelia,0,0,0,,Бірдеңе
Dialogue: 0,0:21:03.73,0:21:06.27,Default - Copy,Ophelia,0,0,0,,Мен өзімді жақсы сезінемін.
Dialogue: 0,0:21:07.60,0:21:10.64,Default - Copy,Ophelia,0,0,0,,Денемдегі кешегі ауырсыну өтірік сияқты
Dialogue: 0,0:21:11.77,0:21:13.04,Default - Copy,Ophelia,0,0,0,,Неліктен?
Dialogue: 0,0:21:13.74,0:21:15.21,Default - Copy,Ophelia,0,0,0,,Мен мұнда жүктеме болғым келмейді.
Dialogue: 0,0:21:16.54,0:21:18.85,Default - Copy,Ophelia,0,0,0,,Бірақ менің қарным аздап ашты.
Dialogue: 0,0:21:19.31,0:21:20.35,Default - Copy,Ophelia,0,0,0,,Мм.
Dialogue: 0,0:21:20.88,0:21:23.42,Default - Copy,Ophelia,0,0,0,,Мен қатты аштық сезінемін.
Dialogue: 0,0:21:23.85,0:21:24.95,Default - Copy,Ophelia,0,0,0,,Қызық екен
Dialogue: 0,0:21:26.12,0:21:27.09,Default - Copy,Ophelia,0,0,0,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:21:27.72,0:21:29.26,Default - Copy,Ophelia,0,0,0,,Мен ішкі ағзаларды жегім келеді
Dialogue: 0,0:22:40.40,0:22:42.30,Default - Copy,,0,0,0,,Өмір сүруді растау
Dialogue: 0,0:22:42.30,0:22:43.84,Default - Copy,,0,0,0,,Тірі екендігін дәлелдеу
Dialogue: 0,0:22:43.94,0:22:46.54,Default - Copy,,0,0,0,,Бар екендігін дәлелдеу
Dialogue: 0,0:22:48.04,0:22:54.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory