Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.54,0:00:06.71,Default,,0,0,0,,Менің ойымша, бұл осы жерде.
Dialogue: 0,0:00:06.79,0:00:09.67,Default,,0,0,0,,Өте стильді дүкенде
Dialogue: 0,0:00:09.76,0:00:12.22,Default,,0,0,0,,Бұл маңдайшасы жоқ жасырын жолақ.
Dialogue: 0,0:00:12.30,0:00:13.72,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:00:14.51,0:00:17.72,Default,,0,0,0,,Барған сайын күдікті болып барады...
Dialogue: 0,0:00:17.81,0:00:21.60,Default,,0,0,0,,Жарайды, тек пікірлерді оқыңыз...
Dialogue: 0,0:00:21.68,0:00:24.10,Default,,0,0,0,,А, сол жерде шығар.
Dialogue: 0,0:00:24.19,0:00:27.61,Default,,0,0,0,,табу қиын жерлердегі дүкендер жақсырақ.
Dialogue: 0,0:00:27.69,0:00:29.61,Default,,0,0,0,,Бұл жақсы бар.
Dialogue: 0,0:00:29.69,0:00:31.69,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:00:31.78,0:00:34.36,Default,,0,0,0,,Бүгін мен саған бірдеңе сатып аламын.
Dialogue: 0,0:00:34.45,0:00:38.99,Default,,0,0,0,,(Дүкендегі BGM)
Dialogue: 0,0:00:48.63,0:00:50.38,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:00:50.46,0:00:53.67,Default,,0,0,0,,Бұл Бар Грейс...
Dialogue: 0,0:00:53.76,0:00:54.76,Default,,0,0,0,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:00:54.84,0:00:55.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:55.76,0:00:56.64,Default,,0,0,0,,Таку
Dialogue: 0,0:00:56.72,0:01:01.02,Default,,0,0,0,,Бұл ғимаратта да орынсыз дүкен бар.
Dialogue: 0,0:01:01.10,0:01:04.14,Default,,0,0,0,,Балаңыз қыдырып жүрсе, уайымдамаңыз.
Dialogue: 0,0:01:04.23,0:01:06.77,Default,,0,0,0,,Сыртқа шығатын кез келген сияқты.
Dialogue: 0,0:01:06.85,0:01:08.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:09.23,0:01:10.86,Default,,0,0,0,,Эй...
Dialogue: 0,0:01:18.66,0:01:21.41,Default,,0,0,0,,Көп болды, Китаката-сан.
Dialogue: 0,0:01:22.95,0:01:24.91,Default,,0,0,0,,А...
Dialogue: 0,0:01:25.00,0:01:29.96,Default,,0,0,0,,♪～
Dialogue: 0,0:02:49.96,0:02:54.96,Default,,0,0,0,,～♪
Dialogue: 0,0:03:00.13,0:03:01.72,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:03:01.80,0:03:04.47,Default,,0,0,0,,Детективтермен бірдей зейін
Dialogue: 0,0:03:04.56,0:03:07.47,Default,,0,0,0,,Міне, сондықтан бармен
Dialogue: 0,0:03:07.56,0:03:08.73,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,0:03:08.81,0:03:11.85,Default,,0,0,0,,Кешіріңіз, алдымен үйге бара аласыз ба?
Dialogue: 0,0:03:11.94,0:03:13.73,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:03:13.81,0:03:15.57,Default,,0,0,0,,8 жыл болды.
Dialogue: 0,0:03:15.65,0:03:16.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:16.57,0:03:21.61,Default,,0,0,0,,Өкінішке орай, бұл ескі ертегілерге сәйкес келетін дүкен емес.
Dialogue: 0,0:03:21.70,0:03:24.62,Default,,0,0,0,,Бұл туралы айтқыңыз келсе, басқа жерге барыңыз.
Dialogue: 0,0:03:24.70,0:03:26.12,Default,,0,0,0,,Тапсырыс беруші
Dialogue: 0,0:03:27.75,0:03:28.75,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:28.83,0:03:32.58,Default,,0,0,0,,Маған бір ғана сусын бере аласыз ба?
Dialogue: 0,0:03:32.67,0:03:34.54,Default,,0,0,0,,Мына жас ханым ше?
Dialogue: 0,0:03:34.63,0:03:37.88,Default,,0,0,0,,Мазасыз коктейльдерге жол бермейміз.
Dialogue: 0,0:03:37.96,0:03:40.26,Default,,0,0,0,,Мен де сені мазақ етуден бас тартамын.
Dialogue: 0,0:03:41.18,0:03:43.01,Default,,0,0,0,,Мен де, өтінемін.
Dialogue: 0,0:03:46.72,0:03:49.02,Default,,0,0,0,,Сонымен реттілік қандай?
Dialogue: 0,0:03:49.10,0:03:51.02,Default,,0,0,0,,Қанды Мэри
Dialogue: 0,0:03:56.27,0:03:58.48,Default,,0,0,0,,Қанды Мэри
Dialogue: 0,0:03:59.36,0:04:02.03,Default,,0,0,0,,(мұздың жарылған дыбысы)
Dialogue: 0,0:04:06.78,0:04:09.75,Default,,0,0,0,,Ей, 8 жыл болды...
Dialogue: 0,0:04:09.83,0:04:12.54,Default,,0,0,0,,Иә, мен сенің ағаңмын.
Dialogue: 0,0:04:13.21,0:04:15.88,Default,,0,0,0,,Бір дүкенде жұмыс істеген
Dialogue: 0,0:04:15.96,0:04:17.54,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:04:18.21,0:04:20.80,Default,,0,0,0,,Сасакура мырзаның өткені ше?
Dialogue: 0,0:04:20.88,0:04:23.76,Default,,0,0,0,,Мен бұл туралы ешқашан естімегендей сезінемін.
Dialogue: 0,0:04:23.84,0:04:25.05,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:26.05,0:04:27.55,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:04:27.64,0:04:29.31,Default,,0,0,0,,О
Dialogue: 0,0:04:29.39,0:04:31.23,Default,,0,0,0,,Китаката-сан, кәдімгі
Dialogue: 0,0:04:31.31,0:04:32.31,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:34.10,0:04:36.98,Default,,0,0,0,,Соңғы сусынды шынымен ішсеңіз
Dialogue: 0,0:04:37.06,0:04:39.23,Default,,0,0,0,,Осыдан кейін менімен бірге боласыз деп ойлаймын.
Dialogue: 0,0:04:39.32,0:04:40.94,Default,,0,0,0,,Әрине.
Dialogue: 0,0:04:41.03,0:04:44.70,Default,,0,0,0,,Мұндағы Қанды Мэри әлемдегі ең жақсысы.
Dialogue: 0,0:04:53.96,0:04:54.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:55.75,0:04:58.54,Default,,0,0,0,,Сіз алдымен арақты шайқайсыз ба?
Dialogue: 0,0:04:59.80,0:05:00.80,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:04.38,0:05:07.80,Default,,0,0,0,,Тұтынушының қанды Мэри туралы айтуы
Dialogue: 0,0:05:07.89,0:05:10.31,Default,,0,0,0,,Атақты тиранның лақап аты
Dialogue: 0,0:05:10.39,0:05:13.64,Default,,0,0,0,,Менің дайындайтын нәрсем сәл басқаша.
Dialogue: 0,0:05:14.44,0:05:15.94,Default,,0,0,0,,Қанды Цезарь
Dialogue: 0,0:05:16.02,0:05:17.86,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:05:17.94,0:05:21.19,Default,,0,0,0,,Мен үгіндісі бар қызанақ шырынын қолданамын.
Dialogue: 0,0:05:22.03,0:05:23.78,Default,,0,0,0,,Ұнтақ дегеніміз не?
Dialogue: 0,0:05:23.86,0:05:25.78,Default,,0,0,0,,Бұл бальзамдар туралы.
Dialogue: 0,0:05:25.86,0:05:29.66,Default,,0,0,0,,Дәмді күрделірек ететін ұлулардың сығындысы бар.
Dialogue: 0,0:05:29.74,0:05:32.20,Default,,0,0,0,,Балалар сендерге де солай болмай ма?
Dialogue: 0,0:05:34.29,0:05:35.50,Default,,0,0,0,,Я~
Dialogue: 0,0:05:36.50,0:05:40.17,Default,,0,0,0,,Бұл қанды Мэриге ұқсайды.
Dialogue: 0,0:05:40.25,0:05:42.34,Default,,0,0,0,,(ішіп отырған адамның дыбысы)
Dialogue: 0,0:05:42.42,0:05:43.26,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:43.34,0:05:45.51,Default,,0,0,0,,Жүр, мен оны іштім.
Dialogue: 0,0:05:45.59,0:05:47.68,Default,,0,0,0,,Бүгін... аа!
Dialogue: 0,0:05:47.76,0:05:48.76,Default,,0,0,0,,Ой
Dialogue: 0,0:05:48.84,0:05:52.31,Default,,0,0,0,,Не? Мен ондай нәрседен мас болу мүмкін емес.
Dialogue: 0,0:05:52.39,0:05:56.23,Default,,0,0,0,,Өкінішке орай, бүгін үйге барудан басқа амалым жоқ.
Dialogue: 0,0:05:56.31,0:05:57.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:57.60,0:05:58.73,Default,,0,0,0,,Ах~
Dialogue: 0,0:05:58.81,0:06:00.02,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:06:00.11,0:06:02.36,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:06:02.44,0:06:03.78,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:06:03.86,0:06:06.99,Default,,0,0,0,,А, сен сонша көп іштің бе?
Dialogue: 0,0:06:07.07,0:06:08.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:09.41,0:06:11.33,Default,,0,0,0,,Бұл қанды Цезарь
Dialogue: 0,0:06:11.41,0:06:14.04,Default,,0,0,0,,Өте күшті арақ қолданылады
Dialogue: 0,0:06:15.00,0:06:17.66,Default,,0,0,0,,Алкоголь мөлшері 88%
Dialogue: 0,0:06:17.75,0:06:19.75,Default,,0,0,0,,А... соншама?
Dialogue: 0,0:06:19.83,0:06:21.04,Default,,0,0,0,,Сол арақ
Dialogue: 0,0:06:21.13,0:06:24.05,Default,,0,0,0,,Ауаның көп болуы үшін алдымен шайқаңыз.
Dialogue: 0,0:06:24.13,0:06:27.55,Default,,0,0,0,,Жиілікті сезінбеу үшін бейімделген.
Dialogue: 0,0:06:29.51,0:06:30.68,Default,,0,0,0,,Китаката мырза
Dialogue: 0,0:06:31.43,0:06:34.52,Default,,0,0,0,,Бар – жаралы жандарға арналған аурухана.
Dialogue: 0,0:06:34.60,0:06:38.06,Default,,0,0,0,,Бармен – тұтынушылардың жанын күтетін дәрігер.
Dialogue: 0,0:06:38.14,0:06:39.69,Default,,0,0,0,,Ол маған осылай деді...
Dialogue: 0,0:06:40.56,0:06:42.40,Default,,0,0,0,,Бұл сіз болуыңыз керек еді.
Dialogue: 0,0:06:43.52,0:06:47.82,Default,,0,0,0,,Ішімдіктің екі беті бар: у және дәрі.
Dialogue: 0,0:06:48.40,0:06:52.70,Default,,0,0,0,,Мас ету үшін қолданылатын алкоголь де адамға зиян келтіретін у болуы мүмкін.
Dialogue: 0,0:06:52.78,0:06:57.20,Default,,0,0,0,,Оны тұтынушыларға жеткізу барменнің міндеті емес.
Dialogue: 0,0:07:04.25,0:07:06.46,Default,,0,0,0,,Кокохананы бағындырыңыз
Dialogue: 0,0:07:06.55,0:07:08.38,Default,,0,0,0,,Гинза сияқты
Dialogue: 0,0:07:08.47,0:07:12.72,Default,,0,0,0,,Бұл ішімдік ішіп тұрғандай кейіп танытатын жер емес.
Dialogue: 0,0:07:12.80,0:07:14.35,Default,,0,0,0,,Бұрынғы үй иесі...
Dialogue: 0,0:07:15.18,0:07:17.02,Default,,0,0,0,,16-да бала туды
Dialogue: 0,0:07:17.10,0:07:19.81,Default,,0,0,0,,19 Қарызға байланысты сатылды
Dialogue: 0,0:07:19.89,0:07:22.35,Default,,0,0,0,,25-те өз-өзіне қол жұмсау әрекеті
Dialogue: 0,0:07:22.44,0:07:24.65,Default,,0,0,0,,Жабысқақ, ауыр макияж
Dialogue: 0,0:07:24.73,0:07:27.23,Default,,0,0,0,,Азғын қартқа қызыққан кейіп таныту
Dialogue: 0,0:07:27.32,0:07:28.86,Default,,0,0,0,,Мен ақша тартып отырдым.
Dialogue: 0,0:07:29.61,0:07:32.53,Default,,0,0,0,,Барлар шынымен де жанға арналған ауруханалар.
Dialogue: 0,0:07:32.61,0:07:35.24,Default,,0,0,0,,Бірақ аурухана әлі де аурухана.
Dialogue: 0,0:07:35.33,0:07:38.50,Default,,0,0,0,,Бұл далалық аурухана.
Dialogue: 0,0:07:39.66,0:07:41.25,Default,,0,0,0,,Қанға боялған тұтынушы
Dialogue: 0,0:07:41.33,0:07:46.46,Default,,0,0,0,,Әйтеуір, бүгін аман қалу үшін бір сусын ішіп отырмын.
Dialogue: 0,0:07:46.55,0:07:49.01,Default,,0,0,0,,Маған бұл улы ма, әлде басқасы ма бәрібір.
Dialogue: 0,0:07:49.09,0:07:55.01,Default,,0,0,0,,Жоқ, кейбір тұтынушыларға бұл улы болғандықтан қажет.
Dialogue: 0,0:07:55.10,0:07:58.47,Default,,0,0,0,,Бірақ егер сен менің қожайыным болсаң...
Dialogue: 0,0:07:58.56,0:08:01.39,Default,,0,0,0,,Касэ-сан мұндайға жол бермес еді.
Dialogue: 0,0:08:02.39,0:08:05.86,Default,,0,0,0,,Неге қасыңдағы қызды да мас қыламын деп қиналдың?
Dialogue: 0,0:08:05.94,0:08:08.15,Default,,0,0,0,,Мен сені баурап алуды жеңілдетдім.
Dialogue: 0,0:08:09.23,0:08:10.24,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:08:10.32,0:08:12.07,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:08:22.25,0:08:23.79,Default,,0,0,0,,Бүгінгі күн үшін кешіріңіз.
Dialogue: 0,0:08:23.87,0:08:26.34,Default,,0,0,0,,Мені шақыруға қиналсаң да.
Dialogue: 0,0:08:26.42,0:08:30.76,Default,,0,0,0,,Жоқ, Эден Холлда кездескенше.
Dialogue: 0,0:08:30.84,0:08:32.26,Default,,0,0,0,,Секір!!
Dialogue: 0,0:08:39.43,0:08:40.85,Default,,0,0,0,,Я...
Dialogue: 0,0:08:43.19,0:08:44.81,Default,,0,0,0,,Қария
Dialogue: 0,0:08:47.06,0:08:48.07,Default,,0,0,0,,Угааах~!
Dialogue: 0,0:08:48.15,0:08:52.49,Default,,0,0,0,,Тэм Франциядан оралды.
Dialogue: 0,0:08:53.28,0:08:55.49,Default,,0,0,0,,Мен дірілдеп отырып, шейкерді шайқадым.
Dialogue: 0,0:08:55.57,0:08:56.82,Default,,0,0,0,,Сол шәкірт...
Dialogue: 0,0:08:57.53,0:09:00.08,Default,,0,0,0,,Ол маған дәріс оқыды.
Dialogue: 0,0:09:08.67,0:09:10.80,Default,,0,0,0,,Кешегі адам...
Dialogue: 0,0:09:12.01,0:09:15.59,Default,,0,0,0,,Онда бұл Сасакура мырзаның қожайыны.
Dialogue: 0,0:09:15.68,0:09:17.72,Default,,0,0,0,,Аға
Dialogue: 0,0:09:17.80,0:09:21.27,Default,,0,0,0,,О, бұл жаңа жолақ па?
Dialogue: 0,0:09:21.35,0:09:25.35,Default,,0,0,0,,Жоқ, бұл бұрынғы Сасакура мырза болған дүкен.
Dialogue: 0,0:09:25.44,0:09:28.31,Default,,0,0,0,,Сәлем! Мен барғым келеді
Dialogue: 0,0:09:28.40,0:09:30.98,Default,,0,0,0,,Сасакура мырзадан бізді таныстыруын сұрайық.
Dialogue: 0,0:09:31.07,0:09:32.82,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:09:32.90,0:09:36.49,Default,,0,0,0,,Өткенді айтқысы келмейтін сияқты.
Dialogue: 0,0:09:36.57,0:09:38.82,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:38.91,0:09:41.95,Default,,0,0,0,,Сен ағаң Сасакура-санмен жақсы доссың, солай ма?
Dialogue: 0,0:09:42.04,0:09:44.62,Default,,0,0,0,,Осылай шабуыл жасай берейік.
Dialogue: 0,0:09:44.71,0:09:46.58,Default,,0,0,0,,Уф-у-у-у!
Dialogue: 0,0:09:48.38,0:09:52.50,Default,,0,0,0,,Иә, Китаката мырза менің Бар Казедегі аға курсым.
Dialogue: 0,0:09:53.26,0:09:55.67,Default,,0,0,0,,Әрине коктейльдерді қалай жасауға болады
Dialogue: 0,0:09:55.76,0:10:00.51,Default,,0,0,0,,Дәретхананы тазалаудан бастап, мас тұтынушыларды қалай ұстауға дейін
Dialogue: 0,0:10:00.60,0:10:02.76,Default,,0,0,0,,Мен көп нәрсені білдім
Dialogue: 0,0:10:03.43,0:10:05.85,Default,,0,0,0,,Ол жақсы аға болды.
Dialogue: 0,0:10:05.93,0:10:06.77,Default,,0,0,0,,Иә
Dialogue: 0,0:10:06.85,0:10:10.15,Default,,0,0,0,,Дәл сіз айтқандай, мен онша дос емеспін.
Dialogue: 0,0:10:10.23,0:10:11.82,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:10:15.32,0:10:16.90,Default,,0,0,0,,Сіз бірдеңе жасағыңыз келе ме?
Dialogue: 0,0:10:16.99,0:10:19.49,Default,,0,0,0,,А, онда...
Dialogue: 0,0:10:19.57,0:10:21.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:21.16,0:10:22.16,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:10:25.75,0:10:27.58,Default,,0,0,0,,Екі адам.
Dialogue: 0,0:10:38.84,0:10:40.55,Default,,0,0,0,,Сәлем Китаката-сан
Dialogue: 0,0:10:40.64,0:10:43.39,Default,,0,0,0,,Мен келдім, өйткені сіз бұл сыйлық деп айттыңыз.
Dialogue: 0,0:10:43.47,0:10:46.60,Default,,0,0,0,,Мен қарапайым пабқа барғанды ​​жөн көремін.
Dialogue: 0,0:10:46.68,0:10:48.85,Default,,0,0,0,,Онда менің кіші қызым жұмыс істейді.
Dialogue: 0,0:10:48.94,0:10:51.98,Default,,0,0,0,,Тым болмаса бір рет жүзіңді көрсету парызың.
Dialogue: 0,0:10:52.06,0:10:55.94,Default,,0,0,0,,Сондай-ақ, мен оның қандай алкогольдік ішімдік беретініне таң қалдым.
Dialogue: 0,0:10:56.99,0:10:59.57,Default,,0,0,0,,Тапсырысты қалай беруге болады?
Dialogue: 0,0:10:59.65,0:11:00.57,Default,,0,0,0,,А...
Dialogue: 0,0:11:00.66,0:11:02.95,Default,,0,0,0,,Олар не айтса да
Dialogue: 0,0:11:03.03,0:11:06.33,Default,,0,0,0,,Мен әдетте сыра мен шочу ғана ішемін.
Dialogue: 0,0:11:06.41,0:11:11.08,Default,,0,0,0,,Бұл мәселе. Бұл дүкенде шочу жоқ сияқты.
Dialogue: 0,0:11:11.17,0:11:13.71,Default,,0,0,0,,Менің орным жоқ сияқты.
Dialogue: 0,0:11:14.34,0:11:17.21,Default,,0,0,0,,Бірде-бір тұтынушы барда орынсыз емес.
Dialogue: 0,0:11:17.30,0:11:22.80,Default,,0,0,0,,Өзіңізді жайсыз сезінсеңіз, бұл барменнің міндеті.
Dialogue: 0,0:11:22.89,0:11:23.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:23.80,0:11:29.73,Default,,0,0,0,,Шочу ұнаса, маған қалдырыңыз.
Dialogue: 0,0:11:29.81,0:11:31.44,Default,,0,0,0,,Мен бұндай нәрсені алғаш рет көріп тұрмын
Dialogue: 0,0:11:31.52,0:11:33.11,Default,,0,0,0,,Мен үшін де солай
Dialogue: 0,0:11:33.19,0:11:35.40,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:11:35.48,0:11:38.03,Default,,0,0,0,,(пышақ кесу дыбысы)
Dialogue: 0,0:11:38.11,0:11:43.37,Default,,0,0,0,,Алдымен қабығынан бастап әктің 1/2 бөлігін кесіңіз.
Dialogue: 0,0:11:43.45,0:11:45.62,Default,,0,0,0,,Мұны стақанға салыңыз
Dialogue: 0,0:11:45.70,0:11:48.12,Default,,0,0,0,,Қантты қосқаннан кейін
Dialogue: 0,0:11:48.20,0:11:50.25,Default,,0,0,0,,Осыны пайдалану
Dialogue: 0,0:11:50.33,0:11:54.25,Default,,0,0,0,,Әкті ұсақтап, қантпен араластырыңыз.
Dialogue: 0,0:11:54.33,0:11:56.88,Default,,0,0,0,,Бұл өте өрескел.
Dialogue: 0,0:11:56.96,0:11:59.88,Default,,0,0,0,,Мен олар оны жақсырақ етеді деп ойладым.
Dialogue: 0,0:11:59.97,0:12:02.34,Default,,0,0,0,,Барлық жерде бармендер
Dialogue: 0,0:12:02.43,0:12:05.51,Default,,0,0,0,,Мен жай ғана әдемі көрінуге тырыспаймын.
Dialogue: 0,0:12:06.22,0:12:09.06,Default,,0,0,0,,Ал мұнда cachaça
Dialogue: 0,0:12:09.14,0:12:12.02,Default,,0,0,0,,Бразилияның ұлттық рухымен сусындаған
Dialogue: 0,0:12:12.10,0:12:16.69,Default,,0,0,0,,Қант шырыны ашытылады және тазартылады.
Dialogue: 0,0:12:16.77,0:12:19.28,Default,,0,0,0,,Шочу сияқты жасалған.
Dialogue: 0,0:12:19.36,0:12:20.40,Default,,0,0,0,,А...
Dialogue: 0,0:12:20.49,0:12:23.61,Default,,0,0,0,,Өтінемін, бұл Кайпиринья.
Dialogue: 0,0:12:24.49,0:12:27.12,Default,,0,0,0,,Кай... Пиринья?
Dialogue: 0,0:12:27.20,0:12:30.79,Default,,0,0,0,,Иә, португал тіліндегі «ауыл қызы».
Dialogue: 0,0:12:31.46,0:12:34.42,Default,,0,0,0,,Қарапайым сұлу емес пе?
Dialogue: 0,0:12:34.50,0:12:36.29,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:36.88,0:12:39.63,Default,,0,0,0,,А, бұл дәмді.
Dialogue: 0,0:12:39.71,0:12:43.55,Default,,0,0,0,,Бұл сергітеді, бірақ аздап тәтті және бай.
Dialogue: 0,0:12:43.63,0:12:45.18,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:12:45.26,0:12:47.05,Default,,0,0,0,,Бразилияда үкімет
Dialogue: 0,0:12:47.14,0:12:50.06,Default,,0,0,0,,Оларда Кайпириньяның рецепті бар сияқты.
Dialogue: 0,0:12:50.64,0:12:52.81,Default,,0,0,0,,Бұл асыра сілтеу.
Dialogue: 0,0:12:52.89,0:12:56.06,Default,,0,0,0,,Міне, халық оны бағалайды.
Dialogue: 0,0:12:56.15,0:12:59.57,Default,,0,0,0,,Бұл ішімдікке деген сүйіспеншіліктің көрінісі болуы мүмкін.
Dialogue: 0,0:13:02.69,0:13:03.90,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:13:12.41,0:13:15.08,Default,,0,0,0,,Сіздің дағдыларыңыз біршама жақсарған сияқты.
Dialogue: 0,0:13:16.42,0:13:18.34,Default,,0,0,0,,Сәлем Китаката-сан
Dialogue: 0,0:13:18.42,0:13:22.46,Default,,0,0,0,,Дәмі шочу сияқты коктейльдер бар.
Dialogue: 0,0:13:22.55,0:13:24.13,Default,,0,0,0,,Осыны да ішіп көріңіз.
Dialogue: 0,0:13:24.22,0:13:25.72,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:13:26.97,0:13:29.72,Default,,0,0,0,,Дәл сол Кайпиринья, солай ма?
Dialogue: 0,0:13:30.89,0:13:31.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.81,0:13:33.81,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:13:33.89,0:13:37.60,Default,,0,0,0,,Бұл бұрынғыға қарағанда қызық емес, таза және жеңіл.
Dialogue: 0,0:13:37.69,0:13:39.61,Default,,0,0,0,,Айырмашылық оның жасалу жолында.
Dialogue: 0,0:13:39.69,0:13:44.15,Default,,0,0,0,,Біреуін терімен ұнтақтап, жабайы дәмді шығарады.
Dialogue: 0,0:13:44.24,0:13:47.16,Default,,0,0,0,,Екінші жағынан, әктің тұтқыр дәмін болдырмау үшін.
Dialogue: 0,0:13:47.24,0:13:48.87,Default,,0,0,0,,Жеңіл қысыңыз
Dialogue: 0,0:13:48.95,0:13:54.29,Default,,0,0,0,,Ал бірі - шочуды еске түсіретін байлық беретін қоңыр қант.
Dialogue: 0,0:13:54.37,0:13:58.38,Default,,0,0,0,,Екінші жағынан, дәмін азайту үшін түйіршіктелген қантты қолданыңыз.
Dialogue: 0,0:13:58.96,0:14:02.63,Default,,0,0,0,,Тәртіп бірдей болса да, неге әуре?
Dialogue: 0,0:14:02.71,0:14:05.05,Default,,0,0,0,,Бұл жолы тұтынушы
Dialogue: 0,0:14:05.13,0:14:08.13,Default,,0,0,0,,Сіз әдетте коктейль ішпеймін дедіңіз.
Dialogue: 0,0:14:09.09,0:14:11.26,Default,,0,0,0,,Бұл күндері сирек кездеседі.
Dialogue: 0,0:14:11.35,0:14:14.77,Default,,0,0,0,,Осыншама ойды қызметке салатын бизнес.
Dialogue: 0,0:14:14.85,0:14:18.02,Default,,0,0,0,,Бармендік кәсіп емес.
Dialogue: 0,0:14:18.10,0:14:19.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.44,0:14:23.28,Default,,0,0,0,,Китагата-сан екеуміздің жақсы көретін сөзім бар.
Dialogue: 0,0:14:23.36,0:14:27.15,Default,,0,0,0,,Талай рет естігенім сонша, жек көрдім.
Dialogue: 0,0:14:27.24,0:14:32.24,Default,,0,0,0,,Адамдар бармендік кәсіппен айналыспауы керек.
Dialogue: 0,0:14:32.33,0:14:36.16,Default,,0,0,0,,Бармен өмірді таңда.
Dialogue: 0,0:14:36.25,0:14:41.17,Default,,0,0,0,,Денесі ауыр, жалақысы жақсы емес.
Dialogue: 0,0:14:41.25,0:14:43.55,Default,,0,0,0,,Әлі де I
Dialogue: 0,0:14:43.63,0:14:46.51,Default,,0,0,0,,Бармен мамандығын ашу
Dialogue: 0,0:14:46.59,0:14:48.17,Default,,0,0,0,,Менің ойымша, бұл жақсы болды.
Dialogue: 0,0:14:48.26,0:14:51.68,Default,,0,0,0,,Маған осыны үйреткен магистрлер мен үлкендер
Dialogue: 0,0:14:51.76,0:14:54.68,Default,,0,0,0,,Сонымен қатар біз өз тұтынушыларымызға алғыс айтамыз.
Dialogue: 0,0:14:56.27,0:14:58.52,Default,,0,0,0,,Бармендік кәсіп емес
Dialogue: 0,0:14:58.60,0:14:59.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:59.77,0:15:03.69,Default,,0,0,0,,Бұл сөздің мағынасын білесіз бе?
Dialogue: 0,0:15:05.78,0:15:10.11,Default,,0,0,0,,Соны айта беретін қария қазір не істеп жатыр?
Dialogue: 0,0:15:10.66,0:15:12.20,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:15:13.20,0:15:14.20,Default,,0,0,0,,Касе мырза
Dialogue: 0,0:15:14.28,0:15:17.87,Default,,0,0,0,,Сіз қазір қайда екеніңізді білесіз бе?
Dialogue: 0,0:15:24.54,0:15:28.97,Default,,0,0,0,,Касэ-сан Токиодан кетіп қалды, солай ма?
Dialogue: 0,0:15:29.05,0:15:32.22,Default,,0,0,0,,Дүкеніңізді неге көшірдіңіз?
Dialogue: 0,0:15:33.89,0:15:35.47,Default,,0,0,0,,Түсінуге оңай
Dialogue: 0,0:15:42.56,0:15:45.86,Default,,0,0,0,,Неліктен мұндай төбеде?
Dialogue: 0,0:15:50.11,0:15:51.11,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:15:52.41,0:15:53.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:55.12,0:15:56.12,Default,,0,0,0,,Госпитализация?
Dialogue: 0,0:15:56.20,0:15:58.41,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:15:58.50,0:16:01.12,Default,,0,0,0,,Мен жеті жыл бұрын дүкенде құлап қалдым.
Dialogue: 0,0:16:01.21,0:16:04.33,Default,,0,0,0,,Содан бері денсаулығым қалпына келмеді.
Dialogue: 0,0:16:04.42,0:16:06.63,Default,,0,0,0,,Мен дүкенді жауып тастадым.
Dialogue: 0,0:16:06.71,0:16:10.84,Default,,0,0,0,,Әуелде ақсақ болып, сөйлей алмай қалды.
Dialogue: 0,0:16:10.92,0:16:13.55,Default,,0,0,0,,Соңғы кездері мен өзімді біршама жақсы сезіне бастадым.
Dialogue: 0,0:16:13.64,0:16:15.68,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:18.72,0:16:19.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:19.97,0:16:22.27,Default,,0,0,0,,Касэ-сан, бұл Таме.
Dialogue: 0,0:16:22.35,0:16:24.10,Default,,0,0,0,,Бұл Тэм Сасакура.
Dialogue: 0,0:16:26.02,0:16:26.90,Default,,0,0,0,,Үйрену
Dialogue: 0,0:16:26.98,0:16:28.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:38.41,0:16:40.16,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:40.25,0:16:42.41,Default,,0,0,0,,Гинзада дүкен ашыңыз
Dialogue: 0,0:16:42.50,0:16:44.67,Default,,0,0,0,,Иә, мен жұмысқа тұрамын.
Dialogue: 0,0:16:44.75,0:16:47.42,Default,,0,0,0,,Бұл керемет болды.
Dialogue: 0,0:16:49.50,0:16:51.17,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:16:53.26,0:16:55.55,Default,,0,0,0,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:16:55.64,0:16:59.56,Default,,0,0,0,,Мен мұның бәрін жей алмаймын.
Dialogue: 0,0:17:03.02,0:17:04.81,Default,,0,0,0,,Қарт әрқашан болды
Dialogue: 0,0:17:04.89,0:17:07.65,Default,,0,0,0,,Қонақтар кез келген уақытта келе алады
Dialogue: 0,0:17:07.73,0:17:11.28,Default,,0,0,0,,Ол демалыссыз дүкенді ашық ұстады.
Dialogue: 0,0:17:11.78,0:17:14.53,Default,,0,0,0,,Бармен болу – өмір салты
Dialogue: 0,0:17:14.61,0:17:18.99,Default,,0,0,0,,Соны айта бер және бәрін осы жұмысқа арна
Dialogue: 0,0:17:19.08,0:17:21.12,Default,,0,0,0,,Міне осылай болады.
Dialogue: 0,0:17:22.04,0:17:24.21,Default,,0,0,0,,Сіз әлі жассыз
Dialogue: 0,0:17:24.29,0:17:29.00,Default,,0,0,0,,Бармен болуды тастап, бизнеске қайта оралуым керек пе?
Dialogue: 0,0:17:30.55,0:17:33.88,Default,,0,0,0,,Айтпайтын нәрсені айтпа
Dialogue: 0,0:17:33.97,0:17:35.84,Default,,0,0,0,,Егер сіз шынымен солай ойласаңыз
Dialogue: 0,0:17:35.93,0:17:39.47,Default,,0,0,0,,Дүкен неліктен «Солтүстік жел» деп аталады?
Dialogue: 0,0:17:39.55,0:17:41.97,Default,,0,0,0,,Китаката-санның «Кита» және
Dialogue: 0,0:17:42.06,0:17:45.56,Default,,0,0,0,,Сіз оны Касе мырзаның «бар-казэ» деп атағансыз, солай ма?
Dialogue: 0,0:17:48.44,0:17:52.48,Default,,0,0,0,,Китаката мырза 7 жыл бұрын Касе мырзамен бірге болды ма?
Dialogue: 0,0:17:52.57,0:17:55.86,Default,,0,0,0,,Қарияның туысы жоқ.
Dialogue: 0,0:17:55.95,0:17:59.87,Default,,0,0,0,,Дүкеніңізді тек тұтынушыларыңыз үшін ғана ашық ұстасаңыз да.
Dialogue: 0,0:17:59.95,0:18:02.37,Default,,0,0,0,,Мені қазір ешкім ойламайды
Dialogue: 0,0:18:02.45,0:18:04.70,Default,,0,0,0,,Бұл жүрексіз.
Dialogue: 0,0:18:05.33,0:18:07.12,Default,,0,0,0,,Бірақ білесің бе—
Dialogue: 0,0:18:07.21,0:18:11.92,Default,,0,0,0,,Мен де мені тыныштандырған тостағанды ​​ешқашан ұмытпаймын.
Dialogue: 0,0:18:12.00,0:18:15.42,Default,,0,0,0,,Қарт екеуміз жақсы деп ойлаймыз.
Dialogue: 0,0:18:15.51,0:18:17.51,Default,,0,0,0,,Мен еш өкінбеймін
Dialogue: 0,0:18:17.59,0:18:22.14,Default,,0,0,0,,Бұл да бармендердің өмір салты.
Dialogue: 0,0:18:22.22,0:18:23.77,Default,,0,0,0,,Өмір жолы…
Dialogue: 0,0:18:25.35,0:18:29.02,Default,,0,0,0,,Сізде әлі де Құдайдың шыны бар...
Dialogue: 0,0:18:29.10,0:18:30.98,Default,,0,0,0,,Тұтынушының жанын емдеу—
Dialogue: 0,0:18:31.06,0:18:34.36,Default,,0,0,0,,Сіз соңғы сусынды мақсат етіп отырсыз ба?
Dialogue: 0,0:18:34.44,0:18:35.78,Default,,0,0,0,,Иә
Dialogue: 0,0:18:35.86,0:18:38.11,Default,,0,0,0,,Өзгеріс жоқ.
Dialogue: 0,0:18:38.20,0:18:40.24,Default,,0,0,0,,Мен жаңа ғана дүкенге келдім...
Dialogue: 0,0:18:40.32,0:18:44.45,Default,,0,0,0,,Кішкентай кезімнен якудзаны қашып кететін көздерім болды.
Dialogue: 0,0:18:48.00,0:18:51.25,Default,,0,0,0,,Бүгінгі брондау тұтынушыларын тексеріңіз
Dialogue: 0,0:18:51.33,0:18:52.92,Default,,0,0,0,,Ең алдымен сағат 17:00-ден...
Dialogue: 0,0:18:53.00,0:18:55.42,Default,,0,0,0,,Лоунж-барда қызметкерлердің болмауы
Dialogue: 0,0:18:55.51,0:18:57.72,Default,,0,0,0,,Өте жақсы естіледі.
Dialogue: 0,0:18:57.80,0:18:59.93,Default,,0,0,0,,Қалғаны сол...
Dialogue: 0,0:19:00.01,0:19:02.76,Default,,0,0,0,,Ашылмайтын есік... солай ма?
Dialogue: 0,0:19:02.85,0:19:04.93,Default,,0,0,0,,Жағымсыз лақап аттарды қолдануды тоқтатыңыз.
Dialogue: 0,0:19:05.01,0:19:06.93,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:19:07.02,0:19:09.02,Default,,0,0,0,,Бармен не болып жатыр?
Dialogue: 0,0:19:09.10,0:19:09.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:10.02,0:19:13.57,Default,,0,0,0,,Дұрыс, Сенпай, менімен тез сөйлесші.
Dialogue: 0,0:19:13.65,0:19:15.53,Default,,0,0,0,,Сен де, Хигучи!
Dialogue: 0,0:19:15.61,0:19:16.44,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:19:31.08,0:19:34.75,Default,,0,0,0,,Сіздің жалғыз қалуыңыз ерекше.
Dialogue: 0,0:19:36.96,0:19:38.72,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:19:39.47,0:19:41.59,Default,,0,0,0,,Немерең жиі келе ме?
Dialogue: 0,0:19:41.68,0:19:44.51,Default,,0,0,0,,Иә, қамқорлығыңыз үшін рахмет.
Dialogue: 0,0:19:44.60,0:19:48.10,Default,,0,0,0,,Сіз мұны көп рет естігеніңізге сенімдімін.
Dialogue: 0,0:19:48.18,0:19:51.60,Default,,0,0,0,,Сіз бұл мәселе бойынша шешім қабылдадыңыз ба?
Dialogue: 0,0:19:52.73,0:19:53.86,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:53.94,0:19:57.11,Default,,0,0,0,,Кешіріңіз, бірақ сұрауыңызды қабылдай алмаймыз.
Dialogue: 0,0:19:57.19,0:19:59.86,Default,,0,0,0,,Егер сіз осы дүкенге көңіл бөлсеңіз
Dialogue: 0,0:19:59.94,0:20:02.53,Default,,0,0,0,,Мен Макимен сөйлесіп қойғанмын.
Dialogue: 0,0:20:02.61,0:20:04.45,Default,,0,0,0,,Жақсы... бірақ
Dialogue: 0,0:20:04.53,0:20:05.99,Default,,0,0,0,,Вашихана
Dialogue: 0,0:20:06.08,0:20:09.75,Default,,0,0,0,,Өзіңіз шешкен нәрсені міндетті түрде орындаңыз
Dialogue: 0,0:20:09.83,0:20:12.83,Default,,0,0,0,,Кардинал қонақ үйінің қарсы барында
Dialogue: 0,0:20:12.92,0:20:16.25,Default,,0,0,0,,Мен сені тұрғызамын.
Dialogue: 0,0:20:31.35,0:20:32.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:39.69,0:20:43.15,Default,,0,0,0,,Оны қонақ үй барына апарыңыз.
Dialogue: 0,0:20:43.24,0:20:46.87,Default,,0,0,0,,Қонақ үй үшін тамаша қарсы барды жасау
Dialogue: 0,0:20:46.95,0:20:49.91,Default,,0,0,0,,Ата... Бұл атамның арманы.
Dialogue: 0,0:20:50.62,0:20:54.04,Default,,0,0,0,,Егер мен идеалды жолақ жасасам,
Dialogue: 0,0:20:54.12,0:20:56.92,Default,,0,0,0,,Сасакура-сан - ең жақсы бармен.
Dialogue: 0,0:20:57.00,0:21:00.17,Default,,0,0,0,,Мен басқа ештеңе ойлай алмаймын деп ойладым.
Dialogue: 0,0:21:00.88,0:21:04.93,Default,,0,0,0,,Бірақ Эден Холлға барған кезде,
Dialogue: 0,0:21:05.01,0:21:06.93,Default,,0,0,0,,Клиенттерге арналған есептегіште.
Dialogue: 0,0:21:07.01,0:21:10.43,Default,,0,0,0,,Сасакура мырза туралы қызметті жалғастырыңыз
Dialogue: 0,0:21:10.52,0:21:13.94,Default,,0,0,0,,Мен кедергі болғым келмеді деп ойлай бастадым...
Dialogue: 0,0:21:14.02,0:21:15.77,Default,,0,0,0,,Tame дегеніміз не?
Dialogue: 0,0:21:15.85,0:21:17.52,Default,,0,0,0,,Бас тартылды
Dialogue: 0,0:21:17.61,0:21:20.82,Default,,0,0,0,,Себебін сұрасам да қашады.
Dialogue: 0,0:21:20.90,0:21:22.07,Default,,0,0,0,,А...
Dialogue: 0,0:21:22.15,0:21:25.78,Default,,0,0,0,,Мен атамның арманын орындағым келеді, бірақ...
Dialogue: 0,0:21:26.41,0:21:30.03,Default,,0,0,0,,Сасакура мырзаны сендіре алмайтын сияқтымын.
Dialogue: 0,0:21:30.70,0:21:34.46,Default,,0,0,0,,Менің ойымша, сіз бұдан артық жақындай алмайсыз.
Dialogue: 0,0:21:34.54,0:21:39.29,Default,,0,0,0,,Себеп болса, маған айта аласыз...
Dialogue: 0,0:21:42.51,0:21:45.09,Default,,0,0,0,,Кішкентай қыз, ерінбейсің бе?
Dialogue: 0,0:21:45.17,0:21:46.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:46.43,0:21:49.93,Default,,0,0,0,,Еуропалық коктейльдер байқауының жеңімпазы
Dialogue: 0,0:21:50.01,0:21:52.77,Default,,0,0,0,,Париждегі беделді қонақүйде жұмыс істеу
Dialogue: 0,0:21:52.85,0:21:56.27,Default,,0,0,0,,Бармен үшін бұл үлкен мансап.
Dialogue: 0,0:21:56.35,0:21:59.61,Default,,0,0,0,,Бірақ ол Жапонияға қайтып келді.
Dialogue: 0,0:21:59.69,0:22:01.32,Default,,0,0,0,,Жеңіске жетіп, сол адамдардың өмірімен сол жараларды жазайық
Dialogue: 0,0:22:03.19,0:22:06.86,Default,,0,0,0,,Сол жігіттің кесірінен бір тұтынушы қайтыс болды.
Dialogue: 0,0:22:06.95,0:22:07.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:08.03,0:22:09.87,Default,,0,0,0,,Сасакураны бағындыру...
Dialogue: 0,0:22:09.95,0:22:13.04,Default,,0,0,0,,Мен бұған сенемін.
Dialogue: 0,0:22:15.08,0:22:20.08,Default,,0,0,0,,♪～
Dialogue: 0,0:23:40.00,0:23:45.00,Default,,0,0,0,,～♪
