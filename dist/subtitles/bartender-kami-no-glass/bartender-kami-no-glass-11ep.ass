Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.88,0:00:12.30,Default,,0,0,0,,Вашихана
Dialogue: 0,0:00:12.38,0:00:15.18,Default,,0,0,0,,Өзіңіз қабылдаған шешімді міндетті түрде орындаңыз
Dialogue: 0,0:00:16.30,0:00:19.89,Default,,0,0,0,,Эден Холл жабылады.
Dialogue: 0,0:00:23.35,0:00:24.44,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:25.10,0:00:26.31,Default,,0,0,0,,Үйрету
Dialogue: 0,0:00:27.27,0:00:30.78,Default,,0,0,0,,Не болды? Китаката мырза
Dialogue: 0,0:00:30.86,0:00:33.74,Default,,0,0,0,,Кейс мырзаны ауруханадан уақытша шығару кестесі
Dialogue: 0,0:00:33.82,0:00:34.82,Default,,0,0,0,,Шешілді.
Dialogue: 0,0:00:34.91,0:00:35.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:35.99,0:00:40.12,Default,,0,0,0,,Бұл маған соңғы рет шығуға рұқсат беретін шығар.
Dialogue: 0,0:00:42.04,0:00:47.00,Default,,0,0,0,,♪～
Dialogue: 0,0:02:06.91,0:02:11.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:13.63,0:02:14.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:15.05,0:02:17.22,Default,,0,0,0,,Менің де артымнан жүріңіз
Dialogue: 0,0:02:17.30,0:02:20.01,Default,,0,0,0,,Я, мен сенімен танысқым келеді.
Dialogue: 0,0:02:20.09,0:02:22.51,Default,,0,0,0,,Ол Таменің шебері.
Dialogue: 0,0:02:23.97,0:02:26.81,Default,,0,0,0,,Егер сізге ұнамаса, сіз бас тарттыңыз.
Dialogue: 0,0:02:26.89,0:02:28.27,Default,,0,0,0,,Иә
Dialogue: 0,0:02:43.74,0:02:45.37,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:45.45,0:02:46.87,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:02:46.95,0:02:50.96,Default,,0,0,0,,Толық емес жұмысқа қабылдауды қараңыз...
Dialogue: 0,0:02:53.13,0:02:54.13,Default,,0,0,0,,бірақ енді Эсидиси жеңілгендіктен—
Dialogue: 0,0:02:55.63,0:02:57.63,Default,,0,0,0,,Мен студент бола аламын ба?
Dialogue: 0,0:02:57.72,0:02:59.13,Default,,0,0,0,,Хмм…
Dialogue: 0,0:02:59.22,0:03:01.01,Default,,0,0,0,,Бармен ше?
Dialogue: 0,0:03:01.09,0:03:04.39,Default,,0,0,0,,Жалақы аз, жұмыс уақыты ұзақ
Dialogue: 0,0:03:04.47,0:03:07.68,Default,,0,0,0,,Танымал болу – бұл түсінбеушілік.
Dialogue: 0,0:03:07.77,0:03:09.73,Default,,0,0,0,,Мен байсалдымын
Dialogue: 0,0:03:09.81,0:03:10.64,Default,,0,0,0,,Тек...
Dialogue: 0,0:03:10.73,0:03:14.27,Default,,0,0,0,,Егер шаш үлгісі бармен болу шарты болса.
Dialogue: 0,0:03:14.36,0:03:15.36,Default,,0,0,0,,Мен бас тартамын, бірақ
Dialogue: 0,0:03:15.44,0:03:16.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:16.36,0:03:19.28,Default,,0,0,0,,Хехе, бұл солтүстіктің жоғалуы.
Dialogue: 0,0:03:19.36,0:03:21.70,Default,,0,0,0,,Мен Горо Касемін
Dialogue: 0,0:03:21.78,0:03:26.54,Default,,0,0,0,,Бұл оңай емес, бірақ жұмыс істегіңіз келе ме, бала?
Dialogue: 0,0:03:26.62,0:03:28.91,Default,,0,0,0,,Бұл Тэм Сасакура.
Dialogue: 0,0:03:33.17,0:03:34.54,Default,,0,0,0,,Касе мырза
Dialogue: 0,0:03:34.63,0:03:37.05,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:03:37.13,0:03:41.05,Default,,0,0,0,,Сіз өз бетіңізбен жүре аласыз ба?
Dialogue: 0,0:03:42.59,0:03:45.93,Default,,0,0,0,,Маған қарт адамдай қарама.
Dialogue: 0,0:03:46.85,0:03:48.64,Default,,0,0,0,,үшінн ескерсек, біз үшеу болып өмір сүруге үйрене бастадық.
Dialogue: 0,0:03:48.72,0:03:50.27,Default,,0,0,0,,Ал жас ханым ше?
Dialogue: 0,0:03:50.35,0:03:51.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:51.27,0:03:55.02,Default,,0,0,0,,Мен Тэмді қонақүйдің барына апарып жатырмын...
Dialogue: 0,0:03:56.27,0:03:59.69,Default,,0,0,0,,Мен Мива Курушимамын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:03:59.78,0:04:01.90,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:01.99,0:04:04.32,Default,,0,0,0,,Қолдауыңызға рахмет.
Dialogue: 0,0:04:04.41,0:04:08.08,Default,,0,0,0,,А, жоқ, мен әлі шешкен жоқпын.
Dialogue: 0,0:04:08.16,0:04:09.58,Default,,0,0,0,,Сасакура мырзаға
Dialogue: 0,0:04:09.66,0:04:13.67,Default,,0,0,0,,Менің барымда сізде құдайлық бокал болатынына сенімдімін.
Dialogue: 0,0:04:15.29,0:04:19.71,Default,,0,0,0,,Неліктен бармен болуды шештіңіз?
Dialogue: 0,0:04:19.80,0:04:22.93,Default,,0,0,0,,Толық емес жұмыс уақыты көп.
Dialogue: 0,0:04:23.01,0:04:24.05,Default,,0,0,0,,Құдайдың шыны
Dialogue: 0,0:04:24.13,0:04:24.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:26.22,0:04:28.35,Default,,0,0,0,,Мен әкемнен сұрадым
Dialogue: 0,0:04:28.43,0:04:32.81,Default,,0,0,0,,Бұл дүниеде жаныңды құтқаратын соңғы сусын бар.
Dialogue: 0,0:04:36.48,0:04:38.65,Default,,0,0,0,,Мен Казэ барына тағы барғым келеді
Dialogue: 0,0:04:38.73,0:04:41.36,Default,,0,0,0,,Әлі де көптеген посттар бар.
Dialogue: 0,0:04:41.44,0:04:44.11,Default,,0,0,0,,Сіздің жанкүйерлеріңіз көп, солай ма?
Dialogue: 0,0:04:44.20,0:04:49.99,Default,,0,0,0,,Қазіргі уақытта біздің тұтынушыларымыздың көпшілігі қайтыс болды.
Dialogue: 0,0:04:50.08,0:04:52.37,Default,,0,0,0,,Енді менің кезегім
Dialogue: 0,0:04:53.21,0:04:57.63,Default,,0,0,0,,Мен соңғы рет үстел басында тұрғым келді.
Dialogue: 0,0:04:57.71,0:05:01.05,Default,,0,0,0,,Ондай жағдайда дүкенді бір жерден жалға ал...
Dialogue: 0,0:05:01.13,0:05:02.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:02.21,0:05:06.14,Default,,0,0,0,,Бүгін біздің дүкен уақытша жабылады.
Dialogue: 0,0:05:06.22,0:05:08.51,Default,,0,0,0,,Қайтадан үстелге тұрыңыз.
Dialogue: 0,0:05:10.14,0:05:11.27,Default,,0,0,0,,Касе мырза
Dialogue: 0,0:05:12.52,0:05:15.02,Default,,0,0,0,,Өзіңізді жақсы сезінсеңіз, бәрі жақсы.
Dialogue: 0,0:05:15.10,0:05:17.48,Default,,0,0,0,,Ал, бүгінге ғана.
Dialogue: 0,0:05:17.56,0:05:19.94,Default,,0,0,0,,Бар Казе қайтып келді.
Dialogue: 0,0:05:21.86,0:05:24.53,Default,,0,0,0,,Сол конструкциядағы ішімдік шкафына қарасаңыз
Dialogue: 0,0:05:25.15,0:05:27.99,Default,,0,0,0,,Бар Казеге қайта оралған сияқтысыз.
Dialogue: 0,0:05:29.58,0:05:31.16,Default,,0,0,0,,Құралдар да осындай.
Dialogue: 0,0:05:31.24,0:05:34.16,Default,,0,0,0,,Бұрынғыдай сақталған.
Dialogue: 0,0:05:35.62,0:05:39.46,Default,,0,0,0,,Ал, енді берейік.
Dialogue: 0,0:05:40.00,0:05:42.88,Default,,0,0,0,,Оны өзіңізбен бірге сақтаңыз.
Dialogue: 0,0:05:44.26,0:05:46.84,Default,,0,0,0,,Егер сізге тағы бір нәрсе керек болса...
Dialogue: 0,0:05:46.93,0:05:48.18,Default,,0,0,0,,Қария
Dialogue: 0,0:05:48.26,0:05:51.31,Default,,0,0,0,,Қарт осыны сақтау керек.
Dialogue: 0,0:05:51.39,0:05:53.93,Default,,0,0,0,,Бұл сол кездегі дүкеннен.
Dialogue: 0,0:05:54.52,0:05:55.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:57.94,0:05:59.52,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:02.32,0:06:04.57,Default,,0,0,0,,Мен қайдамын
Dialogue: 0,0:06:08.49,0:06:09.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:09.87,0:06:11.58,Default,,0,0,0,,Бұл қорқынышты, Касе-сан.
Dialogue: 0,0:06:11.66,0:06:15.33,Default,,0,0,0,,Бар Казе кенеттен бір күнге ашылды.
Dialogue: 0,0:06:15.41,0:06:18.50,Default,,0,0,0,,Кешіріңіз, өтуге рұқсат етіңіз.
Dialogue: 0,0:06:18.58,0:06:20.33,Default,,0,0,0,,Неге...
Dialogue: 0,0:06:20.42,0:06:21.92,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:22.00,0:06:24.59,Default,,0,0,0,,Бұл туралы үлкен ағаң айтпады ма?
Dialogue: 0,0:06:24.67,0:06:27.76,Default,,0,0,0,,Менеджер, мен оны келуге көндірдім.
Dialogue: 0,0:06:27.84,0:06:31.68,Default,,0,0,0,,Кешіріңіз, бұл үлкен мәселе болып шықты.
Dialogue: 0,0:06:31.76,0:06:35.22,Default,,0,0,0,,Енді үстелдің жанындағы орындықтарды босатыңыз.
Dialogue: 0,0:06:35.31,0:06:37.31,Default,,0,0,0,,үшінңыз кіріңіздер.
Dialogue: 0,0:06:37.39,0:06:38.98,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:06:39.65,0:06:43.48,Default,,0,0,0,,100 немесе 200 коктейль Ештеңе емес.
Dialogue: 0,0:06:45.11,0:06:46.99,Default,,0,0,0,,Қазір дайындалыңыз
Dialogue: 0,0:06:49.57,0:06:53.24,Default,,0,0,0,,Киіміңізді ауыстыруға біраз уақыт бөліңіз.
Dialogue: 0,0:06:53.33,0:06:54.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:55.08,0:06:58.25,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:07:00.83,0:07:05.00,Default,,0,0,0,,Енді, бәріңіз, тапсырысыңызды еркін қалдырыңыз.
Dialogue: 0,0:07:05.09,0:07:07.05,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:07:07.13,0:07:10.01,Default,,0,0,0,,Мен тапсырыс берген бірінші сусынды ішу керек пе...
Dialogue: 0,0:07:10.09,0:07:11.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:11.51,0:07:13.85,Default,,0,0,0,,Мен шеше алмаймын.
Dialogue: 0,0:07:13.93,0:07:17.52,Default,,0,0,0,,Бұл менің соңғы сусыным шығар деп ойладым.
Dialogue: 0,0:07:17.60,0:07:20.27,Default,,0,0,0,,Иә, тапсырыс беруге болады ма?
Dialogue: 0,0:07:20.89,0:07:21.90,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:22.60,0:07:25.27,Default,,0,0,0,,Маған Бонд Мартини керек, өтінемін.
Dialogue: 0,0:07:25.36,0:07:29.28,Default,,0,0,0,,Мартини арағы, бірақ шайқалған, араластырылмаған
Dialogue: 0,0:07:29.36,0:07:32.41,Default,,0,0,0,,...Мен оны бір рет көргім келеді.
Dialogue: 0,0:07:32.49,0:07:34.41,Default,,0,0,0,,Бұл жұлдыз емес пе?
Dialogue: 0,0:07:34.49,0:07:36.20,Default,,0,0,0,,Мен қарапайым емеспін.
Dialogue: 0,0:07:36.29,0:07:38.04,Default,,0,0,0,,Менің кіші балам кешірім сұрайды.
Dialogue: 0,0:07:38.12,0:07:39.91,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:07:40.00,0:07:41.29,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:41.37,0:07:45.13,Default,,0,0,0,,Фильмдерден жасалған көптеген коктейльдер бар.
Dialogue: 0,0:07:45.67,0:07:46.67,Default,,0,0,0,,Солтүстік
Dialogue: 0,0:07:47.67,0:07:48.88,Default,,0,0,0,,Иә
Dialogue: 0,0:08:00.39,0:08:04.31,Default,,0,0,0,,(Шейкер дірілдеген дыбыс)
Dialogue: 0,0:08:16.28,0:08:20.45,Default,,0,0,0,,Өтінемін, бұл Bond Martini.
Dialogue: 0,0:08:20.54,0:08:22.96,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:08:25.33,0:08:27.79,Default,,0,0,0,,Хмм, дәмді!
Dialogue: 0,0:08:27.88,0:08:29.46,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:08:29.55,0:08:32.22,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:32.72,0:08:35.47,Default,,0,0,0,,Келесіде не істегіңіз келеді?
Dialogue: 0,0:08:35.55,0:08:37.39,Default,,0,0,0,,Касе-сан, мен...
Dialogue: 0,0:08:37.47,0:08:40.31,Default,,0,0,0,,(Тапсырыс берген тұтынушылардың дауыстары)
Dialogue: 0,0:08:40.39,0:08:42.48,Default,,0,0,0,,Мен сізден ретімен сұраймын.
Dialogue: 0,0:08:53.20,0:08:56.87,Default,,0,0,0,,Bar Kaze Бұл жақсы дүкен.
Dialogue: 0,0:08:56.95,0:08:58.24,Default,,0,0,0,,Иә
Dialogue: 0,0:09:02.00,0:09:05.00,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:09:06.42,0:09:08.50,Default,,0,0,0,,Шындығында, басқа да нәрселер бар ...
Dialogue: 0,0:09:09.59,0:09:12.51,Default,,0,0,0,,Мен бірге ішкім келетін бір тұтынушы бар.
Dialogue: 0,0:09:18.39,0:09:20.51,Default,,0,0,0,,Шамдарды өшіріңіз
Dialogue: 0,0:09:29.82,0:09:31.02,Default,,0,0,0,,Широяма мырза
Dialogue: 0,0:09:31.11,0:09:34.28,Default,,0,0,0,,Сіз тек 3 сусын айттыңыз.
Dialogue: 0,0:09:34.36,0:09:37.99,Default,,0,0,0,,Ол үнемі бес-алты коктейль ішетін.
Dialogue: 0,0:09:38.07,0:09:39.66,Default,,0,0,0,,Сіз тым көп ішкенсіз.
Dialogue: 0,0:09:41.87,0:09:43.91,Default,,0,0,0,,Гурман Кимото мырза
Dialogue: 0,0:09:44.00,0:09:45.41,Default,,0,0,0,,Сізге уыт ұнады.
Dialogue: 0,0:09:46.37,0:09:49.50,Default,,0,0,0,,Арықтау керек деп көп айтсам да.
Dialogue: 0,0:09:50.00,0:09:52.09,Default,,0,0,0,,Өлім жалыны
Dialogue: 0,0:09:52.17,0:09:56.17,Default,,0,0,0,,Қайтыс болған жолдастарға арналған жеңіл аза
Dialogue: 0,0:09:57.01,0:10:01.93,Default,,0,0,0,,Бармендер үшін тұтынушылар қарулас жолдастар болып табылады.
Dialogue: 0,0:10:21.99,0:10:23.20,Default,,0,0,0,,(әйнек сынған дыбыс)
Dialogue: 0,0:10:23.83,0:10:25.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:25.29,0:10:29.33,Default,,0,0,0,,Бұл Касе-сан бағалаған стақан, солай ма?
Dialogue: 0,0:10:29.42,0:10:33.34,Default,,0,0,0,,Бұл маңызды стақан, сондықтан оны абайлап ұстаңыз.
Dialogue: 0,0:10:33.42,0:10:35.55,Default,,0,0,0,,Сондықтан бұл жақсы тәжірибе.
Dialogue: 0,0:10:35.63,0:10:38.34,Default,,0,0,0,,Егер ол бұзылса, мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:10:38.43,0:10:41.47,Default,,0,0,0,,Аа... Ертең сол затты іздеп, сатып аламын.
Dialogue: 0,0:10:41.55,0:10:43.47,Default,,0,0,0,,Мамандардың еңбегін бағаламаңыз!
Dialogue: 0,0:10:43.56,0:10:46.48,Default,,0,0,0,,Ол стақан менің қайтыс болған әйелімдікі еді.
Dialogue: 0,0:10:46.56,0:10:49.48,Default,,0,0,0,,Аз ақшамен жасалған ондық
Dialogue: 0,0:10:49.56,0:10:52.02,Default,,0,0,0,,Бұл соңғы монопод қалды.
Dialogue: 0,0:10:58.57,0:11:02.24,Default,,0,0,0,,Жұмыста ешқашан қателеспейтін адамдар бар.
Dialogue: 0,0:11:02.32,0:11:04.83,Default,,0,0,0,,Оның қандай адам екенін білесің бе?
Dialogue: 0,0:11:04.91,0:11:05.74,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:05.83,0:11:10.00,Default,,0,0,0,,Жауап: Жұмыс істемейтін адамдар
Dialogue: 0,0:11:10.08,0:11:12.50,Default,,0,0,0,,Қателер адамның тірі екенін дәлелдейді.
Dialogue: 0,0:11:12.58,0:11:14.75,Default,,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,0:11:14.84,0:11:17.84,Default,,0,0,0,,Қатты және шарасыз тырысу
Dialogue: 0,0:11:17.92,0:11:21.64,Default,,0,0,0,,Нәтижесінде сіз жіберген қателіктерден көбірек сабақ ала аласыз.
Dialogue: 0,0:11:22.72,0:11:26.06,Default,,0,0,0,,Мен қазір жасап жатқан коктейль
Dialogue: 0,0:11:26.14,0:11:28.14,Default,,0,0,0,,Сіз оның не екенін білесіз бе?
Dialogue: 0,0:11:30.27,0:11:32.15,Default,,0,0,0,,Ескі сән
Dialogue: 0,0:11:32.23,0:11:33.77,Default,,0,0,0,,Иә
Dialogue: 0,0:11:33.86,0:11:38.28,Default,,0,0,0,,Сіз бұл дүкенге бір ай бұрын келдіңіз және оны білмедіңіз де.
Dialogue: 0,0:11:39.69,0:11:41.11,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:11:43.16,0:11:44.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:44.24,0:11:48.25,Default,,0,0,0,,Егер сіз кассада бір ай болса да тырыссаңыз,
Dialogue: 0,0:11:48.33,0:11:51.42,Default,,0,0,0,,Тіпті бір коктейльдің дәмі әртүрлі.
Dialogue: 0,0:11:51.50,0:11:55.42,Default,,0,0,0,,Бұл сіздің өткен айдағы өсім.
Dialogue: 0,0:11:57.34,0:11:58.80,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:58.88,0:12:02.43,Default,,0,0,0,,Мен Касе-сан сияқты бармен бола аламын ба?
Dialogue: 0,0:12:02.51,0:12:04.30,Default,,0,0,0,,Сасакура-кун
Dialogue: 0,0:12:05.68,0:12:09.35,Default,,0,0,0,,Адамдар бармен болып жұмыс істемейді.
Dialogue: 0,0:12:09.85,0:12:12.94,Default,,0,0,0,,Мен бармен болып өмір сүруді таңдаймын.
Dialogue: 0,0:12:13.02,0:12:14.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:16.36,0:12:21.03,Default,,0,0,0,,Осы сәтте Қасе-сан менің қожайыным болды.
Dialogue: 0,0:12:27.95,0:12:31.79,Default,,0,0,0,,Барменнің өмірі
Dialogue: 0,0:12:36.50,0:12:38.75,Default,,0,0,0,,Жақында Кардинал қонақ үйі
Dialogue: 0,0:12:38.84,0:12:41.01,Default,,0,0,0,,Ашылғанымызға 1 жыл толуын тойлап жатырмыз.
Dialogue: 0,0:12:41.09,0:12:45.26,Default,,0,0,0,,Төраға Курушима қонақ үй индустриясына қалай келді
Dialogue: 0,0:12:45.34,0:12:47.26,Default,,0,0,0,,Сізден бірдеңе сұрасам болады ма?
Dialogue: 0,0:12:47.35,0:12:51.52,Default,,0,0,0,,Біз бастапқыда Йокосукада жапон стиліндегі қонақ үйді басқардық.
Dialogue: 0,0:12:51.60,0:12:54.64,Default,,0,0,0,,Мен төртінші ұрпақпын.
Dialogue: 0,0:12:54.73,0:12:59.77,Default,,0,0,0,,Бүгіннен бастап біз өмірімізді қонақүй дәуіріне өзгерттік.
Dialogue: 0,0:12:59.86,0:13:01.40,Default,,0,0,0,,Қонақ үйлер мен қонақүйлерде
Dialogue: 0,0:13:01.49,0:13:04.24,Default,,0,0,0,,Менің ойымша, қызметтер әртүрлі.
Dialogue: 0,0:13:04.32,0:13:07.78,Default,,0,0,0,,Қонақ үйлер мен қонақ үйлер үшін негіз бірдей.
Dialogue: 0,0:13:07.87,0:13:11.24,Default,,0,0,0,,Бұл жай ғана тұру мен тамақ сататын қызмет емес.
Dialogue: 0,0:13:11.33,0:13:12.41,Default,,0,0,0,,дейсіз бе?
Dialogue: 0,0:13:13.21,0:13:17.42,Default,,0,0,0,,Бала кезімдегі мектеп саяхатынан естелік.
Dialogue: 0,0:13:17.50,0:13:22.92,Default,,0,0,0,,100 оқушы жаңбырдан өтіп, қонақ үйге келді.
Dialogue: 0,0:13:23.01,0:13:26.43,Default,,0,0,0,,Жаңбырдан аяқ киімім лай болды.
Dialogue: 0,0:13:26.51,0:13:28.43,Default,,0,0,0,,Алайда келесі күні таңертең
Dialogue: 0,0:13:28.51,0:13:32.47,Default,,0,0,0,,Аяқ киімдер сөреде тізілген, жылтыр.
Dialogue: 0,0:13:32.56,0:13:34.68,Default,,0,0,0,,100 жұп аяқ киім.
Dialogue: 0,0:13:34.77,0:13:38.69,Default,,0,0,0,,Накай-сан түнде қазанды жылтыратты.
Dialogue: 0,0:13:38.77,0:13:40.94,Default,,0,0,0,,Бұл ыңғайсыз болар еді...
Dialogue: 0,0:13:41.02,0:13:47.24,Default,,0,0,0,,Тұтынушының жан дүниесінде ұмытылмас және әсерлі естелік қалдыру
Dialogue: 0,0:13:47.32,0:13:51.37,Default,,0,0,0,,Бұл, менің ойымша, қызметтің бастауы.
Dialogue: 0,0:13:52.49,0:13:54.08,Default,,0,0,0,,Сіздің болашақ арманыңыз қандай?
Dialogue: 0,0:13:54.16,0:13:57.83,Default,,0,0,0,,Кардинал қонақүйін әлемдік деңгейдегі қонақүйге айналдыру
Dialogue: 0,0:13:57.92,0:14:03.96,Default,,0,0,0,,Апаттан қайтыс болған баламның арманы да осы ма...?
Dialogue: 0,0:14:04.05,0:14:05.47,Default,,0,0,0,,Иә
Dialogue: 0,0:14:07.80,0:14:11.72,Default,,0,0,0,,Шындығында, мен сіздердің талқылағандарыңызды қалаймын.
Dialogue: 0,0:14:11.81,0:14:16.10,Default,,0,0,0,,Бұл Кардинал туралы емес, бұл жеке.
Dialogue: 0,0:14:16.18,0:14:17.23,Default,,0,0,0,,дегенді қалай түсінесіңдер?
Dialogue: 0,0:14:17.31,0:14:21.40,Default,,0,0,0,,Ішімдік тауып беруіңізді қалаймын.
Dialogue: 0,0:14:21.48,0:14:26.82,Default,,0,0,0,,25 жыл бұрын мен өзімнің кесірімнен ішімдік іше алмадым.
Dialogue: 0,0:14:29.95,0:14:31.24,Default,,0,0,0,,Сіз ұрысып қалдыңыз ба?
Dialogue: 0,0:14:31.32,0:14:33.49,Default,,0,0,0,,Әкең мен атаң ше?
Dialogue: 0,0:14:33.58,0:14:35.50,Default,,0,0,0,,Иә
Dialogue: 0,0:14:35.58,0:14:39.29,Default,,0,0,0,,Әкем қазірден бастап қонақүйлердің дәуірі келе жатқанын айтты.
Dialogue: 0,0:14:39.37,0:14:41.88,Default,,0,0,0,,Атам үзілді-кесілді қарсы
Dialogue: 0,0:14:41.96,0:14:44.92,Default,,0,0,0,,Өйткені, ол сондай қыңыр.
Dialogue: 0,0:14:45.01,0:14:48.38,Default,,0,0,0,,Сол кезде халық әлі де Батысты жек көретін сияқты.
Dialogue: 0,0:14:48.47,0:14:51.64,Default,,0,0,0,,Ойлап қарасам, жапон киімін киемін.
Dialogue: 0,0:14:52.55,0:14:56.02,Default,,0,0,0,,Ата-ана мен баланың бақталастық салдарынан ажырасуы...
Dialogue: 0,0:14:57.60,0:14:59.39,Default,,0,0,0,,Бұл қарапайым әңгіме.
Dialogue: 0,0:14:59.48,0:15:03.48,Default,,0,0,0,,Алкогольдің қандай түріне назар аударуым керек?
Dialogue: 0,0:15:03.57,0:15:08.61,Default,,0,0,0,,Бір күні әкем атамызды үйге шақырды.
Dialogue: 0,0:15:08.70,0:15:11.32,Default,,0,0,0,,Жасау ниетімен
Dialogue: 0,0:15:11.41,0:15:12.70,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:12.78,0:15:15.29,Default,,0,0,0,,Арнайы сусын дайындадың.
Dialogue: 0,0:15:15.37,0:15:16.83,Default,,0,0,0,,Иә
Dialogue: 0,0:15:16.91,0:15:20.79,Default,,0,0,0,,Бірақ әкем бір бөтелке спирт дайындады.
Dialogue: 0,0:15:20.87,0:15:24.17,Default,,0,0,0,,Кішкентай кезімде құлатып, сындырдым...
Dialogue: 0,0:15:24.75,0:15:27.01,Default,,0,0,0,,Екеуінің қарым-қатынасы дәл осы
Dialogue: 0,0:15:27.09,0:15:30.55,Default,,0,0,0,,Алты айдан кейін әкем жол апатынан қайтыс болды...
Dialogue: 0,0:15:31.34,0:15:34.60,Default,,0,0,0,,Егер мен оны сол кезде бұзбаған болсам
Dialogue: 0,0:15:34.68,0:15:38.14,Default,,0,0,0,,Олардың да қарым-қатынасы басқаша болды ма деп ойлаймын.
Dialogue: 0,0:15:38.64,0:15:41.73,Default,,0,0,0,,Атам әкем туралы айтқан сайын
Dialogue: 0,0:15:41.81,0:15:44.31,Default,,0,0,0,,Мен бұл туралы ойланбай тұра алмаймын ...
Dialogue: 0,0:15:44.40,0:15:48.78,Default,,0,0,0,,Маған ұрысқан жоқ. Мен кінәлі емеспін.
Dialogue: 0,0:15:48.86,0:15:52.07,Default,,0,0,0,,Бірақ мен атам мен әкемнен кешірім сұрағым келеді.
Dialogue: 0,0:15:53.24,0:15:57.08,Default,,0,0,0,,Жарайды, сол спиртті іздеп көрейік.
Dialogue: 0,0:15:58.16,0:16:01.29,Default,,0,0,0,,Әкеңіз туралы есте қалған нәрсе бар ма?
Dialogue: 0,0:16:01.37,0:16:03.63,Default,,0,0,0,,Тамақты ұнатады және ұнатпайды
Dialogue: 0,0:16:03.71,0:16:06.42,Default,,0,0,0,,Темекі және кофе сияқты сәнді заттар
Dialogue: 0,0:16:07.42,0:16:11.13,Default,,0,0,0,,Мен білмеймін. Менің есімде қалғаны...
Dialogue: 0,0:16:11.22,0:16:15.47,Default,,0,0,0,,Жалғыз нәрсе болды, алкоголь бөтелкесі жарқырап тұрды.
Dialogue: 0,0:16:15.55,0:16:17.47,Default,,0,0,0,,Жарқыраған?
Dialogue: 0,0:16:17.56,0:16:19.64,Default,,0,0,0,,Бұл хрусталь бөтелке емес пе?
Dialogue: 0,0:16:19.72,0:16:22.85,Default,,0,0,0,,Бұл шынымен коньяк па?
Dialogue: 0,0:16:22.94,0:16:27.19,Default,,0,0,0,,Иә, сіз мұндай маңызды уақытта арзан бөтелкені ашпас едіңіз.
Dialogue: 0,0:16:27.86,0:16:32.70,Default,,0,0,0,,Реми - 13-ші, Хеннесси - Ричард
Dialogue: 0,0:16:32.78,0:16:35.57,Default,,0,0,0,,Бірінші қону да түзету үшін тамаша болуы мүмкін.
Dialogue: 0,0:16:35.66,0:16:37.99,Default,,0,0,0,,О, қону ма?
Dialogue: 0,0:16:38.08,0:16:41.66,Default,,0,0,0,,Жоқ, мұнда жақсырақ нәрсе болуы керек.
Dialogue: 0,0:16:41.75,0:16:44.21,Default,,0,0,0,,Шешімділік жетіспейтіндей сезінемін.
Dialogue: 0,0:16:44.29,0:16:46.25,Default,,0,0,0,,Мм... (Таме) А, кешіріңіз.
Dialogue: 0,0:16:46.33,0:16:48.46,Default,,0,0,0,,Сізбен рұқсатсыз сөйлесу
Dialogue: 0,0:16:48.55,0:16:50.84,Default,,0,0,0,,Енді маған қайталап айтыңыз
Dialogue: 0,0:16:50.92,0:16:52.38,Default,,0,0,0,,үшін, мен оны сатып аламын.
Dialogue: 0,0:16:52.47,0:16:54.88,Default,,0,0,0,,Ешқайсысы арзан емес, солай ма?
Dialogue: 0,0:16:54.97,0:16:57.39,Default,,0,0,0,,Бұл тіпті қымбат емес.
Dialogue: 0,0:16:57.47,0:17:01.68,Default,,0,0,0,,Жарайды, 25 жылдан бері бірінші рет күнәларымды өтеуім.
Dialogue: 0,0:17:03.02,0:17:07.27,Default,,0,0,0,,Ах~ Бұл өте жақсы үй.
Dialogue: 0,0:17:08.86,0:17:11.28,Default,,0,0,0,,Бұл кеме бөтелкесі, солай ма?
Dialogue: 0,0:17:11.36,0:17:12.74,Default,,0,0,0,,Иә
Dialogue: 0,0:17:12.82,0:17:15.36,Default,,0,0,0,,Кеме бөтелкесі де кристалды бөтелке.
Dialogue: 0,0:17:15.45,0:17:19.16,Default,,0,0,0,,Атам өскен Йокосуканың атымен аталған.
Dialogue: 0,0:17:19.78,0:17:22.91,Default,,0,0,0,,Сіз қалай ойлайсыз? Осының біреуі таныс сияқты ма?
Dialogue: 0,0:17:23.00,0:17:24.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:24.66,0:17:26.42,Default,,0,0,0,,Бәрі де әдемі
Dialogue: 0,0:17:26.50,0:17:30.92,Default,,0,0,0,,Бәрі жарқырап тұрғандай болды...
Dialogue: 0,0:17:31.00,0:17:33.21,Default,,0,0,0,,Оны міндетті түрде дәл тиетініңе толық сенімді болмасаң, оқ атпа.
Dialogue: 0,0:17:33.30,0:17:37.55,Default,,0,0,0,,Алкогольді беруге арналған графин туралы не деуге болады?
Dialogue: 0,0:17:37.64,0:17:39.93,Default,,0,0,0,,Әртүрлі пішіндер бар.
Dialogue: 0,0:17:40.01,0:17:41.93,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:42.02,0:17:45.94,Default,,0,0,0,,Менің ойымша, бұл шын мәнінде алкоголь бөтелкесінің өзі болды.
Dialogue: 0,0:17:46.02,0:17:47.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:47.73,0:17:50.44,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:17:50.52,0:17:54.94,Default,,0,0,0,,Егер бұл кеме бөтелкесі немесе графинге арналған стақан болмаса
Dialogue: 0,0:17:55.03,0:17:56.45,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:17:56.53,0:17:57.91,Default,,0,0,0,,Бірінші кезекте...
Dialogue: 0,0:17:57.99,0:17:58.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:58.91,0:18:02.54,Default,,0,0,0,,Жоқ, қария Батысты жек көретін, солай ма?
Dialogue: 0,0:18:03.08,0:18:06.83,Default,,0,0,0,,Сіз бояну үшін батыстық ішімдікке қызмет ету үшін барын саласыз ба?
Dialogue: 0,0:18:06.92,0:18:09.46,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:18:09.54,0:18:12.30,Default,,0,0,0,,Бұл міндетті түрде импорттық өнім емес пе?
Dialogue: 0,0:18:16.42,0:18:19.80,Default,,0,0,0,,Мен Миуадан сұрадым, сен қиындық тудырдың.
Dialogue: 0,0:18:19.89,0:18:20.72,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:21.47,0:18:26.02,Default,,0,0,0,,Өзімді әкемнің орнына қойып, тағы да ойландым.
Dialogue: 0,0:18:26.10,0:18:29.65,Default,,0,0,0,,Мен болсам, мен мұны міндетті түрде берер едім.
Dialogue: 0,0:18:31.31,0:18:32.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:32.90,0:18:34.15,Default,,0,0,0,,Бұл…
Dialogue: 0,0:18:35.86,0:18:38.15,Default,,0,0,0,,Какубин... иә?
Dialogue: 0,0:18:38.24,0:18:42.16,Default,,0,0,0,,Бұл бөтелкені жапон адам жасаған.
Dialogue: 0,0:18:42.24,0:18:45.16,Default,,0,0,0,,Сіз бұл дизайнды танисыз ба?
Dialogue: 0,0:18:45.25,0:18:47.25,Default,,0,0,0,,Бұл тасбақа қабықшасының үлгісі.
Dialogue: 0,0:18:47.33,0:18:48.41,Default,,0,0,0,,Иә
Dialogue: 0,0:18:48.50,0:18:53.17,Default,,0,0,0,,Ал мен Сацума Кирико техникасын кесу үшін анықтамалық ретінде қолдандым.
Dialogue: 0,0:18:53.25,0:18:57.05,Default,,0,0,0,,Сондықтан ол жарқырағандай көрінді.
Dialogue: 0,0:18:57.13,0:19:00.55,Default,,0,0,0,,Бұл бөтелкеде виски болса да,
Dialogue: 0,0:19:01.93,0:19:05.06,Default,,0,0,0,,Жапондықтарға ғана тән мамандықтармен толтырылған.
Dialogue: 0,0:19:05.14,0:19:09.69,Default,,0,0,0,,Қонақ үй қонақ үйге айналса да, балам қуанатын шығар.
Dialogue: 0,0:19:09.77,0:19:14.23,Default,,0,0,0,,Мен жапон қызметтерін ұсына алатынымды айтқым келді.
Dialogue: 0,0:19:15.28,0:19:19.53,Default,,0,0,0,,Сізбен бірге осы кесені ішіп отырғанда
Dialogue: 0,0:19:21.99,0:19:26.04,Default,,0,0,0,,Оның бұл туралы ойы...
Dialogue: 0,0:19:28.25,0:19:31.96,Default,,0,0,0,,Дәмі қазіргіден бөлек сияқты.
Dialogue: 0,0:19:32.04,0:19:34.17,Default,,0,0,0,,Арнайы баға көрсеткіші
Dialogue: 0,0:19:34.25,0:19:38.59,Default,,0,0,0,,Мен 1989 жылға дейінгілерді таптым.
Dialogue: 0,0:19:38.67,0:19:41.72,Default,,0,0,0,,Дәмі қартайған сайын өзгере ме?
Dialogue: 0,0:19:41.80,0:19:44.89,Default,,0,0,0,,Бөтелкедегі ингредиенттер өзгереді
Dialogue: 0,0:19:44.97,0:19:49.10,Default,,0,0,0,,Немесе материалдар мен өндіріс көлеміне байланысты айырмашылықтар
Dialogue: 0,0:19:49.18,0:19:51.23,Default,,0,0,0,,Әртүрлі теориялар бар
Dialogue: 0,0:19:51.31,0:19:54.27,Default,,0,0,0,,Ескі бөтелкелердің дәмі неден дәмді болады?
Dialogue: 0,0:19:54.36,0:19:57.86,Default,,0,0,0,,Қайта оралмайтын естеліктер бар
Dialogue: 0,0:19:58.65,0:20:03.36,Default,,0,0,0,,Біздің жүрегімізде ғана сақталатын естеліктер болғандықтан емес пе?
Dialogue: 0,0:20:03.45,0:20:04.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:05.87,0:20:08.66,Default,,0,0,0,,Еңбек ете отырып, қыран
Dialogue: 0,0:20:08.75,0:20:14.13,Default,,0,0,0,,Мүмкін ол тіпті 25 жыл бұрын болған апатты ұмытуға тырысатын шығар.
Dialogue: 0,0:20:15.59,0:20:19.13,Default,,0,0,0,,Мен сені жаман сезіндім.
Dialogue: 0,0:20:19.21,0:20:21.13,Default,,0,0,0,,Ата
Dialogue: 0,0:20:21.22,0:20:26.18,Default,,0,0,0,,Бірақ бүгін маған бұл жігітпен оңаша қалуыма рұқсат ете аласыз ба?
Dialogue: 0,0:20:26.26,0:20:31.64,Default,,0,0,0,,Мен бұл жігіттің 25 жылдан кейін не айтатынын естігім келеді.
Dialogue: 0,0:20:45.66,0:20:46.78,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:46.87,0:20:50.79,Default,,0,0,0,,Мен оның орнына атамды ренжіткен шығармын.
Dialogue: 0,0:20:53.37,0:20:54.83,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:20:54.92,0:20:57.96,Default,,0,0,0,,Менің қарным ашты, ендеше бүгінгі мейрамым.
Dialogue: 0,0:20:58.04,0:21:00.34,Default,,0,0,0,,Бәрі жақсы, тартынба.
Dialogue: 0,0:21:01.05,0:21:02.55,Default,,0,0,0,,Сонымен, тәртіп...
Dialogue: 0,0:21:03.63,0:21:05.68,Default,,0,0,0,,Бұрышқа жоғары доп соғу
Dialogue: 0,0:21:08.97,0:21:10.60,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:21:12.02,0:21:17.02,Default,,0,0,0,,♪～
Dialogue: 0,0:22:36.98,0:22:41.98,Default,,0,0,0,,～♪
Dialogue: 0,0:22:43.65,0:22:47.36,Default,,0,0,0,,Өткен күн әлдеқайда нашар болды.
Dialogue: 0,0:22:47.45,0:22:48.28,Default,,0,0,0,,Жоқ
Dialogue: 0,0:22:49.16,0:22:50.87,Default,,0,0,0,,Ұлым қайтыс болғаннан кейін
Dialogue: 0,0:22:50.95,0:22:55.29,Default,,0,0,0,,Әлемдік деңгейдегі қонақүй салу оның арманы еді.
Dialogue: 0,0:22:55.37,0:22:58.37,Default,,0,0,0,,Мен күнәларымды өтедім.
Dialogue: 0,0:22:58.46,0:23:02.04,Default,,0,0,0,,Бұл кезде мен жалғыз қалдым.
Dialogue: 0,0:23:02.13,0:23:04.92,Default,,0,0,0,,Мені емдеген адам болды
Dialogue: 0,0:23:05.00,0:23:08.42,Default,,0,0,0,,Бұл марқұм Лапин иесінен алынған кесе.
Dialogue: 0,0:23:09.34,0:23:12.64,Default,,0,0,0,,Адамның жаны ақша да, зат та емес.
Dialogue: 0,0:23:12.72,0:23:15.68,Default,,0,0,0,,Сайып келгенде, сізді тек адамдар ғана емдей алады
Dialogue: 0,0:23:15.77,0:23:19.52,Default,,0,0,0,,Өйткені, адамдар бармен.
Dialogue: 0,0:23:19.60,0:23:22.06,Default,,0,0,0,,Жолақ осы үшін
Dialogue: 0,0:23:22.90,0:23:25.69,Default,,0,0,0,,Құдайдың әйнегі Бұл...
Dialogue: 0,0:23:27.28,0:23:29.03,Default,,0,0,0,,Жалғыздықтан ренжіді
Dialogue: 0,0:23:29.11,0:23:33.20,Default,,0,0,0,,Барар жері жоқ жанды құтқару үшін соңғы сусын
Dialogue: 0,0:23:33.28,0:23:35.58,Default,,0,0,0,,Сіз жасай аласыз
Dialogue: 0,0:23:35.66,0:23:39.21,Default,,0,0,0,,Жоқ, мен сенің үлгергеніңді қалаймын.
Dialogue: 0,0:23:40.71,0:23:46.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
