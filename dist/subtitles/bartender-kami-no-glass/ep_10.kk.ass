Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.71,0:00:05.17,Default,,0,0,0,,Сол жігіттің кесірінен бір тұтынушы қайтыс болды.
Dialogue: 0,0:00:05.25,0:00:06.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:06.67,0:00:11.17,Default,,0,0,0,,Таме Сасакура осылай ойлайды.
Dialogue: 0,0:00:13.01,0:00:17.97,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.93,0:01:42.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:47.23,0:01:49.65,Default,,0,0,0,,Америка барларында
Dialogue: 0,0:01:49.73,0:01:52.78,Default,,0,0,0,,Осындай ескі аңыз бар.
Dialogue: 0,0:01:52.86,0:01:55.78,Default,,0,0,0,,Өз-өзіне қол жұмсауды ойлаған адам
Dialogue: 0,0:01:55.86,0:01:59.41,Default,,0,0,0,,Соңында сөйлесу үшін таңдауға болатын екі адам бар.
Dialogue: 0,0:01:59.49,0:02:01.37,Default,,0,0,0,,Біреуі пастор
Dialogue: 0,0:02:01.45,0:02:02.79,Default,,0,0,0,,Басқа адам...
Dialogue: 0,0:02:03.91,0:02:05.29,Default,,0,0,0,,Бармен
Dialogue: 0,0:02:05.37,0:02:07.58,Default,,0,0,0,,«Мен өлгім келетін сияқты».
Dialogue: 0,0:02:07.67,0:02:12.13,Default,,0,0,0,,Біздің дүкенге осындай сөздерді айтатын көптеген тұтынушылар келеді.
Dialogue: 0,0:02:12.21,0:02:15.84,Default,,0,0,0,,Әдетте мен жай ғана күліп, оны елемей, онымен айналыспаймын.
Dialogue: 0,0:02:15.92,0:02:20.68,Default,,0,0,0,,Әйтсе де, қолға ұстар алдында отырған тұтынушы байсалды болды.
Dialogue: 0,0:02:20.76,0:02:25.06,Default,,0,0,0,,Сасакура мырза, сіз сол кезде не әкелдіңіз?
Dialogue: 0,0:02:25.14,0:02:26.60,Default,,0,0,0,,Саана
Dialogue: 0,0:02:26.68,0:02:29.14,Default,,0,0,0,,Мүмкін мен коктейль сайысында жеңіп алған шығармын.
Dialogue: 0,0:02:29.23,0:02:31.31,Default,,0,0,0,,Бұл түпнұсқа ма, әлде бір нәрсе ме?
Dialogue: 0,0:02:32.27,0:02:35.44,Default,,0,0,0,,Соңында клиент келесі күні оралды.
Dialogue: 0,0:02:35.53,0:02:38.90,Default,,0,0,0,,Ол ғимараттың төбесінен аспанға қарай жүре бастады.
Dialogue: 0,0:02:38.99,0:02:42.07,Default,,0,0,0,,Бұл Сасакура-санның жауапкершілігі емес.
Dialogue: 0,0:02:45.62,0:02:48.33,Default,,0,0,0,,Мен мұны өз басымда түсінемін, бірақ
Dialogue: 0,0:02:48.41,0:02:52.71,Default,,0,0,0,,Егер мен сол уақытта дұрыс емес кесе берген болсам ше?
Dialogue: 0,0:02:52.79,0:02:55.38,Default,,0,0,0,,Менің ойымша, бұл.
Dialogue: 0,0:02:56.30,0:02:59.22,Default,,0,0,0,,Сенпай, бұл туралы не ойлайсың?
Dialogue: 0,0:03:02.51,0:03:05.10,Default,,0,0,0,,Бұл не? Қашан...
Dialogue: 0,0:03:05.18,0:03:07.18,Default,,0,0,0,,Бұл Төрағаның идеясы.
Dialogue: 0,0:03:07.27,0:03:10.23,Default,,0,0,0,,Тақырып: Сасакура Таменің сыртқы орын толтырыңыз.
Dialogue: 0,0:03:10.31,0:03:13.19,Default,,0,0,0,,Төраға да байсалды.
Dialogue: 0,0:03:13.27,0:03:15.57,Default,,0,0,0,,Хигучи Мұны қайта жасаңыз
Dialogue: 0,0:03:15.65,0:03:16.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:16.69,0:03:18.07,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:03:18.15,0:03:20.11,Default,,0,0,0,,Жоқ! (Юкари) Иә...
Dialogue: 0,0:03:24.58,0:03:27.75,Default,,0,0,0,,Сіз бүгін ерте келдіңіз.
Dialogue: 0,0:03:27.83,0:03:29.08,Default,,0,0,0,,Меншік иесі
Dialogue: 0,0:03:29.16,0:03:31.50,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:03:33.33,0:03:36.25,Default,,0,0,0,,Кардиналға баруға шешім қабылдадыңыз ба?
Dialogue: 0,0:03:36.88,0:03:38.76,Default,,0,0,0,,Төраға Курушима.
Dialogue: 0,0:03:38.84,0:03:42.93,Default,,0,0,0,,Әй, шынында да, маған біраздан бері мұны істеуді сұрады.
Dialogue: 0,0:03:43.80,0:03:45.01,Default,,0,0,0,,Маки-кун
Dialogue: 0,0:03:45.10,0:03:48.27,Default,,0,0,0,,Бизнес сіз үшін нені білдіреді?
Dialogue: 0,0:03:48.35,0:03:50.02,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:03:50.10,0:03:54.02,Default,,0,0,0,,500 миллион немесе 1 миллиард долларды ашкөздік арқылы табуға болады.
Dialogue: 0,0:03:54.10,0:03:57.69,Default,,0,0,0,,5 миллиардтан 10 миллиардқа дейін менің арманым
Dialogue: 0,0:03:57.78,0:04:00.07,Default,,0,0,0,,Бірақ одан кейін ше?
Dialogue: 0,0:04:00.65,0:04:02.03,Default,,0,0,0,,Маки-кун
Dialogue: 0,0:04:02.11,0:04:05.99,Default,,0,0,0,,Ең маңызды кәсіп – адамды дамыту.
Dialogue: 0,0:04:06.08,0:04:09.50,Default,,0,0,0,,Өсуге тырысатын жастардың кедергілерін жою
Dialogue: 0,0:04:09.58,0:04:12.04,Default,,0,0,0,,Бұл жол көрсету туралы.
Dialogue: 0,0:04:12.12,0:04:15.25,Default,,0,0,0,,Дамушы адамдар…
Dialogue: 0,0:04:15.33,0:04:16.84,Default,,0,0,0,,Төраға Курушима
Dialogue: 0,0:04:16.92,0:04:19.55,Default,,0,0,0,,Кардинал қонақ үйінің негізгі қызметкерлері
Dialogue: 0,0:04:19.63,0:04:22.55,Default,,0,0,0,,Оның барлығын өзі асырап алған көрінеді.
Dialogue: 0,0:04:22.63,0:04:26.97,Default,,0,0,0,,Мен сіздің Париждегі өміріңізді біраз уақыттан бері зерттеп жүрмін.
Dialogue: 0,0:04:27.64,0:04:29.68,Default,,0,0,0,,Бұл адам жай ғана күшті болды.
Dialogue: 0,0:04:29.77,0:04:32.81,Default,,0,0,0,,Мен сенен қонақүйге келуіңді сұрамаймын.
Dialogue: 0,0:04:32.89,0:04:35.56,Default,,0,0,0,,Менің ойымша, бұл сізге арналған.
Dialogue: 0,0:04:35.65,0:04:39.57,Default,,0,0,0,,Бірақ Эденхолл не болады?
Dialogue: 0,0:04:40.36,0:04:43.07,Default,,0,0,0,,Мен кептеліп қалғанда мені көтеріп алдың.
Dialogue: 0,0:04:43.15,0:04:45.16,Default,,0,0,0,,Мен жақсылығымды әлі қайтарған жоқпын...
Dialogue: 0,0:04:45.24,0:04:48.78,Default,,0,0,0,,Эден Холл жабылады.
Dialogue: 0,0:04:55.92,0:04:58.46,Default,,0,0,0,,Мен ұзақ уақыт тығылып қалдым
Dialogue: 0,0:04:58.54,0:05:01.71,Default,,0,0,0,,Неліктен одан қашып жүрсіз?
Dialogue: 0,0:05:01.80,0:05:05.22,Default,,0,0,0,,Өткенді еске алғанды ​​ұнатпайтыныңызға сенімдімін.
Dialogue: 0,0:05:09.47,0:05:10.47,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:11.22,0:05:12.93,Default,,0,0,0,,Ол A1 деп аталады.
Dialogue: 0,0:05:13.56,0:05:17.94,Default,,0,0,0,,Ең жақсы люкс круиздік кемелерде қызмет көрсету үшін жасалған.
Dialogue: 0,0:05:18.02,0:05:19.73,Default,,0,0,0,,Кез келген коктейль кітабы
Dialogue: 0,0:05:19.82,0:05:22.48,Default,,0,0,0,,Бұл енгізілген бірінші коктейль.
Dialogue: 0,0:05:22.57,0:05:25.49,Default,,0,0,0,,Бұл ең жоғарғы коктейль ме?
Dialogue: 0,0:05:25.57,0:05:29.24,Default,,0,0,0,,Сізді жоғарылатуыңызбен құттықтаймыз.
Dialogue: 0,0:05:29.95,0:05:31.29,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:31.83,0:05:34.25,Default,,0,0,0,,Мен Солтүстік Америка филиалының менеджері болып тағайындалдым.
Dialogue: 0,0:05:36.79,0:05:38.29,Default,,0,0,0,,Өте дәмді
Dialogue: 0,0:05:38.38,0:05:41.25,Default,,0,0,0,,Таза және өткір, бірақ жемісті.
Dialogue: 0,0:05:42.34,0:05:45.76,Default,,0,0,0,,Америкаға барсам, сенің арақыңды іше алмаймын ба?
Dialogue: 0,0:05:45.84,0:05:47.55,Default,,0,0,0,,Мен өзімді жалғыз сезінемін.
Dialogue: 0,0:05:48.26,0:05:51.01,Default,,0,0,0,,Мен бұл дүкенде талай рет болдым.
Dialogue: 0,0:05:51.10,0:05:55.31,Default,,0,0,0,,Көп шіркін көргендей болдым.
Dialogue: 0,0:06:01.23,0:06:02.78,Default,,0,0,0,,Сасакура-кун
Dialogue: 0,0:06:03.28,0:06:06.03,Default,,0,0,0,,Сіз кеңсе қызметкерлері неліктен жоғарылағысы келетінін білесіз бе?
Dialogue: 0,0:06:06.65,0:06:10.95,Default,,0,0,0,,Жауапкершілік пен марапаттау, барабар өтемақы және бағалау
Dialogue: 0,0:06:11.03,0:06:13.29,Default,,0,0,0,,...Бұл тым анық, солай емес пе?
Dialogue: 0,0:06:13.37,0:06:15.29,Default,,0,0,0,,Бұл құрбандық.
Dialogue: 0,0:06:16.87,0:06:18.54,Default,,0,0,0,,Мен де дәл солай тапсырыс бергім келеді.
Dialogue: 0,0:06:19.17,0:06:21.17,Default,,0,0,0,,Тағы екі сусын
Dialogue: 0,0:06:21.25,0:06:24.63,Default,,0,0,0,,(Шейкер дірілдеген дыбыс)
Dialogue: 0,0:06:24.71,0:06:28.80,Default,,0,0,0,,Бірдеңені құрбан етпей, жоғары сатыдан өткен адам жоқ.
Dialogue: 0,0:06:28.88,0:06:33.31,Default,,0,0,0,,Жұмыста басқаларға қарағанда көбірек уақыт бөлетініңіз табиғи нәрсе.
Dialogue: 0,0:06:33.39,0:06:37.31,Default,,0,0,0,,Кейде ішкің келмейтін адаммен ащы ішімдік ішесің.
Dialogue: 0,0:06:37.39,0:06:41.44,Default,,0,0,0,,Өзімнің алдауымның кесірінен мен кейде өзімді-өзім жек көремін.
Dialogue: 0,0:06:42.19,0:06:43.44,Default,,0,0,0,,Осылай алысқа барсаң да
Dialogue: 0,0:06:44.32,0:06:46.40,Default,,0,0,0,,Кейбір адамдар денесін сындырған.
Dialogue: 0,0:06:46.49,0:06:48.99,Default,,0,0,0,,Кейбір адамдар ішкі жанжалдарға қатысады.
Dialogue: 0,0:06:49.07,0:06:51.45,Default,,0,0,0,,Жартылай кету
Dialogue: 0,0:06:52.20,0:06:53.45,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:54.28,0:06:58.46,Default,,0,0,0,,Хаясе мырза нені құрбан етті?
Dialogue: 0,0:06:58.54,0:07:00.21,Default,,0,0,0,,Отбасы
Dialogue: 0,0:07:00.29,0:07:04.25,Default,,0,0,0,,Менің марқұм әйелімнің жүрегі әлсіз еді.
Dialogue: 0,0:07:04.34,0:07:06.21,Default,,0,0,0,,Мен шетелде іссапармен жүрген кезімде
Dialogue: 0,0:07:06.30,0:07:09.26,Default,,0,0,0,,Мен үйде кенеттен өзімді нашар сезіндім.
Dialogue: 0,0:07:09.34,0:07:12.22,Default,,0,0,0,,Қалай ойлайсың, мен ол кезде не істеп жүрмін?
Dialogue: 0,0:07:12.89,0:07:15.97,Default,,0,0,0,,Мен әмбебап дүкенде туған күніне сыйлық таңдап жүрдім.
Dialogue: 0,0:07:16.06,0:07:19.23,Default,,0,0,0,,Іскер серіктестің әйелі үшін
Dialogue: 0,0:07:20.94,0:07:23.23,Default,,0,0,0,,Неліктен адамдар жоғары көтерілгісі келеді?
Dialogue: 0,0:07:23.31,0:07:25.36,Default,,0,0,0,,Егер біз жеңе алмасақ
Dialogue: 0,0:07:25.44,0:07:28.74,Default,,0,0,0,,Өзін құрбан еткендер ысырап болады.
Dialogue: 0,0:07:28.82,0:07:30.86,Default,,0,0,0,,Менің әйелім ғана емес
Dialogue: 0,0:07:30.95,0:07:33.87,Default,,0,0,0,,Менен әлдеқайда жақсы болған аға
Dialogue: 0,0:07:33.95,0:07:35.87,Default,,0,0,0,,Адал әріптес
Dialogue: 0,0:07:35.95,0:07:38.25,Default,,0,0,0,,Олардың ренішіне
Dialogue: 0,0:07:38.33,0:07:40.71,Default,,0,0,0,,Біз жеңісті жалғастыруымыз керек.
Dialogue: 0,0:07:42.71,0:07:46.46,Default,,0,0,0,,Кимико Бұл ең жоғарғы коктейль.
Dialogue: 0,0:07:47.34,0:07:49.63,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:07:52.63,0:07:55.60,Default,,0,0,0,,Кешіріңіз, мен өте жайбарақат сөйледім.
Dialogue: 0,0:07:55.68,0:07:56.85,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:56.93,0:07:58.72,Default,,0,0,0,,Бірақ бұл біртүрлі.
Dialogue: 0,0:07:58.81,0:08:01.39,Default,,0,0,0,,Мен мұны бұрын ешкімге айтқан емеспін.
Dialogue: 0,0:08:01.48,0:08:04.90,Default,,0,0,0,,Бармен ретінде бұл үлкен құрмет.
Dialogue: 0,0:08:05.52,0:08:08.86,Default,,0,0,0,,Түбінде адамдар жинаған өкініштерін жеңеді.
Dialogue: 0,0:08:08.94,0:08:12.07,Default,,0,0,0,,Бәлкім, қашып құтыла алмайтын тағдыр шығар.
Dialogue: 0,0:08:12.15,0:08:15.16,Default,,0,0,0,,Жүрегіме қадалған кішкентай тікендей
Dialogue: 0,0:08:16.41,0:08:17.91,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:18.54,0:08:21.50,Default,,0,0,0,,Ал, үйге кететін уақыт келді деп ойлаймын.
Dialogue: 0,0:08:21.58,0:08:22.92,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:08:23.83,0:08:25.67,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:25.75,0:08:27.04,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:08:27.13,0:08:29.05,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:08:29.13,0:08:30.46,Default,,0,0,0,,Иә
Dialogue: 0,0:08:30.55,0:08:31.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:36.14,0:08:38.26,Default,,0,0,0,,Кимишима мырза
Dialogue: 0,0:08:38.35,0:08:40.56,Default,,0,0,0,,Менің ойымша, ол жергілікті ауруханаға барды...
Dialogue: 0,0:08:42.14,0:08:44.23,Default,,0,0,0,,Мен қайтып келдім.
Dialogue: 0,0:08:44.31,0:08:46.31,Default,,0,0,0,,Мен ата-анаммен біраз уақыт кездестім.
Dialogue: 0,0:08:46.98,0:08:48.52,Default,,0,0,0,,Өткен күні...
Dialogue: 0,0:08:48.61,0:08:52.82,Default,,0,0,0,,Сізді шақырғаным үшін кешіріңіз.
Dialogue: 0,0:08:55.45,0:08:59.58,Default,,0,0,0,,Ол кезде менің шұғыл жұмысым бар еді.
Dialogue: 0,0:09:02.50,0:09:04.08,Default,,0,0,0,,Саған бәрібір
Dialogue: 0,0:09:04.16,0:09:07.58,Default,,0,0,0,,Сол уақыт үшін кешірім сұрауыма рұқсат ете аласыз ба?
Dialogue: 0,0:09:09.88,0:09:11.59,Default,,0,0,0,,Әрине, ықыласпен
Dialogue: 0,0:09:13.67,0:09:18.26,Default,,0,0,0,,Бірақ келесі жолы қашсаң, мен сені ұрып жіберемін.
Dialogue: 0,0:09:18.35,0:09:20.35,Default,,0,0,0,,Ә, қысқа үзіліс жасайық па?
Dialogue: 0,0:09:48.83,0:09:50.42,Default,,0,0,0,,Не, Америка?
Dialogue: 0,0:09:50.50,0:09:51.59,Default,,0,0,0,,О
Dialogue: 0,0:09:51.67,0:09:54.21,Default,,0,0,0,,Менің ойымша, мен ол жерге бес жылдай баратын шығармын.
Dialogue: 0,0:09:54.30,0:09:57.09,Default,,0,0,0,,Маған неге айтпадың?
Dialogue: 0,0:09:57.18,0:09:59.72,Default,,0,0,0,,Мен оны жасырғандай емес едім...
Dialogue: 0,0:10:02.81,0:10:07.14,Default,,0,0,0,,Енді осылай тағы бірге ішуге болады.
Dialogue: 0,0:10:09.35,0:10:13.23,Default,,0,0,0,,Хаясе-сан, менімен неге кездесіп тұрсың?
Dialogue: 0,0:10:20.99,0:10:22.91,Default,,0,0,0,,Сасакура-кун деген кім?
Dialogue: 0,0:10:23.99,0:10:25.00,Default,,0,0,0,,Сіздің сүйіктіңіз бар ма?
Dialogue: 0,0:10:25.08,0:10:28.75,Default,,0,0,0,,ше? Ғашық...?
Dialogue: 0,0:10:28.83,0:10:30.75,Default,,0,0,0,,(Әскерші) Саған айтамын, полковник ешкімді қабылдамайды.
Dialogue: 0,0:10:30.83,0:10:33.50,Default,,0,0,0,,Мұндай жеке мәселені сұрауға қалай дәтің барды?
Dialogue: 0,0:10:33.59,0:10:39.01,Default,,0,0,0,,Өкінішке орай, қазіргі уақытта жұмыс менің махаббатым.
Dialogue: 0,0:10:39.09,0:10:40.93,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:10:42.72,0:10:46.18,Default,,0,0,0,,Иә? Жабу уақыты жақындады ма?
Dialogue: 0,0:10:46.27,0:10:48.39,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз
Dialogue: 0,0:10:54.90,0:10:55.90,Default,,0,0,0,,Ах
Dialogue: 0,0:10:55.98,0:10:58.74,Default,,0,0,0,,Хаясе мырза, не болды?
Dialogue: 0,0:10:58.82,0:11:02.74,Default,,0,0,0,,Қарсы болмасаң, менімен бір жерде араласа аласың ба?
Dialogue: 0,0:11:06.75,0:11:08.91,Default,,0,0,0,,Бұл менің ағаларымның дүкені.
Dialogue: 0,0:11:09.00,0:11:12.17,Default,,0,0,0,,Түпнұсқа жолақтан сәл өзгеше.
Dialogue: 0,0:11:14.88,0:11:16.51,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:11:18.84,0:11:20.80,Default,,0,0,0,,Ертеңнен бастап Америкада.
Dialogue: 0,0:11:20.88,0:11:23.64,Default,,0,0,0,,О, жақсы ма?
Dialogue: 0,0:11:23.72,0:11:25.89,Default,,0,0,0,,Осы сағатқа дейін ішіңіз
Dialogue: 0,0:11:25.97,0:11:28.06,Default,,0,0,0,,Сондықтан сіз ішуді қалауыңыз мүмкін.
Dialogue: 0,0:11:28.85,0:11:30.81,Default,,0,0,0,,Менде бір нәрсе бар.
Dialogue: 0,0:11:32.90,0:11:36.48,Default,,0,0,0,,Мені несие беруші қуып бара жатқандай сезінбеймін...
Dialogue: 0,0:11:36.57,0:11:38.57,Default,,0,0,0,,Бұл бет әйелдікі.
Dialogue: 0,0:11:40.65,0:11:44.03,Default,,0,0,0,,Бұл дүкенде өз тұтынушылары туралы ескертулер жоқ.
Dialogue: 0,0:11:44.12,0:11:46.45,Default,,0,0,0,,Далалық ауруханаға ұқсайтын барда.
Dialogue: 0,0:11:46.54,0:11:49.00,Default,,0,0,0,,Әйел...?
Dialogue: 0,0:11:49.08,0:11:50.96,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:52.50,0:11:54.71,Default,,0,0,0,,Мен қызғанамын.
Dialogue: 0,0:11:54.79,0:11:59.17,Default,,0,0,0,,Қонағым амалсыз қашпақшы, Артынан қуып бармақшы.
Dialogue: 0,0:11:59.26,0:12:02.43,Default,,0,0,0,,Менде адасып кету сәні жоқ.
Dialogue: 0,0:12:03.09,0:12:04.22,Default,,0,0,0,,Өзің бар
Dialogue: 0,0:12:04.30,0:12:06.97,Default,,0,0,0,,Осы жігітпен шешім қабылдағыңыз келе ме?
Dialogue: 0,0:12:07.06,0:12:11.98,Default,,0,0,0,,Бір кездері сүйек бармендер үшін міндетті пән болған сияқты.
Dialogue: 0,0:12:12.06,0:12:16.86,Default,,0,0,0,,Осылайша, күшті реттеп, білекті жұмсақ жылжыту арқылы,
Dialogue: 0,0:12:16.94,0:12:18.98,Default,,0,0,0,,Шейкерді шайқауға жаттығу
Dialogue: 0,0:12:19.61,0:12:23.49,Default,,0,0,0,,Ал кесе ішіндегі сүйектердің қозғалысын елестетіңіз.
Dialogue: 0,0:12:24.24,0:12:27.66,Default,,0,0,0,,Шейкерде мұз осылай айналады.
Dialogue: 0,0:12:27.74,0:12:30.00,Default,,0,0,0,,Ойлауға жетелейді
Dialogue: 0,0:12:34.83,0:12:36.59,Default,,0,0,0,,Көшелерді жинау
Dialogue: 0,0:12:36.67,0:12:41.63,Default,,0,0,0,,Бесеуін алу ықтималдығы...жақсы, 30-да 1.
Dialogue: 0,0:12:41.72,0:12:45.89,Default,,0,0,0,,Бұл техникадан гөрі кездейсоқтық сияқты.
Dialogue: 0,0:12:45.97,0:12:49.56,Default,,0,0,0,,Әрине, бірақ, тұтынушы.
Dialogue: 0,0:12:49.64,0:12:53.60,Default,,0,0,0,,Ұзын атуға құмар ойнау – ор қазу, бірақ
Dialogue: 0,0:12:53.69,0:12:57.27,Default,,0,0,0,,Алыс атуды көздесеңіз, өмір сәл қызық болады.
Dialogue: 0,0:12:57.36,0:12:59.77,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:12:59.86,0:13:02.78,Default,,0,0,0,,Сүйіктісін сағынып, өкінгеннен гөрі
Dialogue: 0,0:13:02.86,0:13:06.28,Default,,0,0,0,,Егер мен үлкен саңылауды тастасам, өзімді қанағаттанарлық сезінемін.
Dialogue: 0,0:13:07.03,0:13:10.54,Default,,0,0,0,,Түсіндім, қайта шайқаңыз.
Dialogue: 0,0:13:10.62,0:13:12.70,Default,,0,0,0,,Қуанышпен
Dialogue: 0,0:13:14.37,0:13:17.33,Default,,0,0,0,,Егер сүйектер лақтырылмаса 5
Dialogue: 0,0:13:17.42,0:13:19.54,Default,,0,0,0,,Мен оны енді көрмеймін
Dialogue: 0,0:13:19.63,0:13:22.30,Default,,0,0,0,,Бірақ сүйектер лақтырылса...
Dialogue: 0,0:13:23.13,0:13:26.68,Default,,0,0,0,,Егер мұндай керемет орын алса, мен оны көруге барамын.
Dialogue: 0,0:13:26.76,0:13:30.68,Default,,0,0,0,,Сонымен, бұл жарнама бұдан былай қолжетімді болмаса да,
Dialogue: 0,0:13:38.40,0:13:42.07,Default,,0,0,0,,Адамдар кейде адасқандай кейіп танытады.
Dialogue: 0,0:13:42.15,0:13:44.19,Default,,0,0,0,,Тұтынушы сияқты.
Dialogue: 0,0:13:44.28,0:13:45.82,Default,,0,0,0,,Адасып қалған кейіп таныту?
Dialogue: 0,0:13:45.90,0:13:49.78,Default,,0,0,0,,Ең бастысы - кішкене батылдық.
Dialogue: 0,0:13:49.87,0:13:52.83,Default,,0,0,0,,Мен шын айта алмаймын, өйткені менде ерік-жігер жоқ.
Dialogue: 0,0:13:52.91,0:13:55.08,Default,,0,0,0,,Құдайға арқа сүйеуге тырысу
Dialogue: 0,0:13:56.12,0:13:57.96,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:13:58.04,0:14:02.59,Default,,0,0,0,,Енді Құдайдың таңдауы қайсысы?
Dialogue: 0,0:14:02.67,0:14:04.34,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:14:04.42,0:14:05.80,Default,,0,0,0,,Бұл қандай жаман иіс?
Dialogue: 0,0:14:05.88,0:14:09.22,Default,,0,0,0,,Мен бұрыннан көргім келген коктейль бар.
Dialogue: 0,0:14:10.22,0:14:12.35,Default,,0,0,0,,Мен Сасакура-кунның мейрамханасында іше алмаймын.
Dialogue: 0,0:14:12.43,0:14:13.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:13.52,0:14:16.85,Default,,0,0,0,,Бұл далалық аурухана. Айтыңызшы.
Dialogue: 0,0:14:17.89,0:14:19.60,Default,,0,0,0,,Қазандық
Dialogue: 0,0:14:21.23,0:14:23.65,Default,,0,0,0,,(стаканға құйылған дыбыс)
Dialogue: 0,0:14:24.32,0:14:26.49,Default,,0,0,0,,Сыра және Бурбон
Dialogue: 0,0:14:26.57,0:14:28.78,Default,,0,0,0,,Қалғанын өзіңіз жасайсыз, солай ма?
Dialogue: 0,0:14:28.86,0:14:30.24,Default,,0,0,0,,Иә
Dialogue: 0,0:14:36.29,0:14:39.08,Default,,0,0,0,,Маңыздысы - кішкене батылдық
Dialogue: 0,0:14:47.38,0:14:48.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:49.22,0:14:50.59,Default,,0,0,0,,Виски жақсырақ
Dialogue: 0,0:14:50.68,0:14:53.97,Default,,0,0,0,,Алкоголь мөлшері жоғары және ол қалқып кетуге бейім.
Dialogue: 0,0:14:54.06,0:14:57.27,Default,,0,0,0,,Сыраның көбігі бірден жоғары көтерілді.
Dialogue: 0,0:14:57.35,0:15:01.90,Default,,0,0,0,,...Жақсы бармен былай түсіндірер еді.
Dialogue: 0,0:15:01.98,0:15:06.07,Default,,0,0,0,,Оны ішсең, қазандай қайнайды.
Dialogue: 0,0:15:06.15,0:15:07.94,Default,,0,0,0,,Біраз батылдық
Dialogue: 0,0:15:08.03,0:15:10.41,Default,,0,0,0,,Сондықтан бұл қазандық.
Dialogue: 0,0:15:17.66,0:15:19.21,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:15:19.29,0:15:21.17,Default,,0,0,0,,Бұл міндетті түрде қазандық.
Dialogue: 0,0:15:23.13,0:15:25.55,Default,,0,0,0,,Мен оны бір рет көргім келді.
Dialogue: 0,0:15:26.21,0:15:27.05,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:15:28.88,0:15:32.80,Default,,0,0,0,,Ас үшін рахмет, Жүрегімдегі тікен шыққандай.
Dialogue: 0,0:15:32.89,0:15:36.72,Default,,0,0,0,,Иә, егер тікен қадалып қалса, оны сол уақытта алып тастаңыз.
Dialogue: 0,0:15:36.81,0:15:38.56,Default,,0,0,0,,Жолақ осы үшін
Dialogue: 0,0:15:38.64,0:15:40.89,Default,,0,0,0,,Егер мен мұны бұрыннан білсем
Dialogue: 0,0:15:40.98,0:15:43.94,Default,,0,0,0,,Мүмкін мен жеңілірек өмір сүрер едім.
Dialogue: 0,0:15:44.02,0:15:45.07,Default,,0,0,0,,Сасакура-кун
Dialogue: 0,0:15:45.15,0:15:46.90,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:46.98,0:15:49.19,Default,,0,0,0,,Мен мұны көруім керек пе?
Dialogue: 0,0:15:49.28,0:15:52.70,Default,,0,0,0,,А, мен сенің сезіміңді түсінемін.
Dialogue: 0,0:15:53.45,0:15:57.33,Default,,0,0,0,,Жоқ, мүмкін олар оны басынан-ақ білген шығар.
Dialogue: 0,0:15:59.54,0:16:01.58,Default,,0,0,0,,Жүрегімде тікен...
Dialogue: 0,0:16:02.29,0:16:06.21,Default,,0,0,0,,Бәс тігуді қалайсыз ба? Сіз бір нәрседен шатасасыз ба?
Dialogue: 0,0:16:06.29,0:16:09.21,Default,,0,0,0,,Мен олай ойламаймын, Китаката мырза.
Dialogue: 0,0:16:09.84,0:16:12.72,Default,,0,0,0,,Уақыты келгенде өзім шешем.
Dialogue: 0,0:16:17.01,0:16:20.23,Default,,0,0,0,,Маған Құдайдың даусы керек емес...
Dialogue: 0,0:16:34.86,0:16:37.49,Default,,0,0,0,,Өтінемін, бұл «басынан соққан жел».
Dialogue: 0,0:16:37.58,0:16:41.75,Default,,0,0,0,,Рахмет, мен мұны көргім келді.
Dialogue: 0,0:16:44.17,0:16:45.71,Default,,0,0,0,,Дәмді
Dialogue: 0,0:16:45.79,0:16:50.09,Default,,0,0,0,,Дәмділіктен кейін тәттілік келеді, соған тәуелді болып қалатын шығарсың.
Dialogue: 0,0:16:50.17,0:16:52.01,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:52.09,0:16:55.68,Default,,0,0,0,,Есептегіш жолақ та шешілген сияқты.
Dialogue: 0,0:16:55.76,0:16:58.01,Default,,0,0,0,,Бұл әлі шешілген жоқ.
Dialogue: 0,0:16:58.10,0:17:00.10,Default,,0,0,0,,Не? Бірақ флайер...
Dialogue: 0,0:17:00.18,0:17:03.89,Default,,0,0,0,,Сасакура мырзадан жақсы жауап алған жоқпын.
Dialogue: 0,0:17:03.98,0:17:05.90,Default,,0,0,0,,Иә? Ұшу?
Dialogue: 0,0:17:05.98,0:17:07.23,Default,,0,0,0,,Каваками мырза
Dialogue: 0,0:17:07.31,0:17:09.90,Default,,0,0,0,,Ах... кешіріңіз.
Dialogue: 0,0:17:09.98,0:17:11.99,Default,,0,0,0,,Сасакура мырза үшін
Dialogue: 0,0:17:12.07,0:17:15.24,Default,,0,0,0,,Мен не істеу керек екенін білмеймін ...
Dialogue: 0,0:17:15.32,0:17:17.53,Default,,0,0,0,,Басынан соққан жел... иә?
Dialogue: 0,0:17:17.62,0:17:18.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:18.74,0:17:21.91,Default,,0,0,0,,Миваға қарсы жел
Dialogue: 0,0:17:22.00,0:17:25.87,Default,,0,0,0,,Мен оның өтуін күтуім керек пе, әлде онымен бетпе-бет келу керек пе?
Dialogue: 0,0:17:25.96,0:17:29.42,Default,,0,0,0,,Не, сен қазір Сасакура-санға ұқсадың ба?
Dialogue: 0,0:17:39.14,0:17:41.26,Default,,0,0,0,,Ескі апатқа байланысты сіз
Dialogue: 0,0:17:41.35,0:17:44.18,Default,,0,0,0,,Қонақ үй барларына барғанды ұнатпайсыз ба?
Dialogue: 0,0:17:44.27,0:17:47.44,Default,,0,0,0,,Бірақ бұл сіздің жауапкершілігіңіз емес.
Dialogue: 0,0:17:48.65,0:17:50.94,Default,,0,0,0,,Мен асығыс айтамын.
Dialogue: 0,0:18:00.53,0:18:02.12,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:18:02.20,0:18:03.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:09.08,0:18:10.96,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:18:11.71,0:18:13.67,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:18:13.76,0:18:15.92,Default,,0,0,0,,Мен сені соңғы уақытта көрмедім.
Dialogue: 0,0:18:16.01,0:18:18.38,Default,,0,0,0,,Не істеп жатырсың деп қызық болдым.
Dialogue: 0,0:18:20.22,0:18:21.72,Default,,0,0,0,,Тапсырысыңыз ше?
Dialogue: 0,0:18:22.93,0:18:24.89,Default,,0,0,0,,Біздің тұтынушы бар.
Dialogue: 0,0:18:24.97,0:18:25.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:26.73,0:18:29.31,Default,,0,0,0,,Мен өте уайымдаған тұтынушымын.
Dialogue: 0,0:18:30.52,0:18:32.98,Default,,0,0,0,,Мен өз-өзіме қол жұмсағым келеді
Dialogue: 0,0:18:33.65,0:18:35.24,Default,,0,0,0,,Мұндай тұтынушылар үшін
Dialogue: 0,0:18:36.03,0:18:41.37,Default,,0,0,0,,Бармен, сіз қандай сусын берер едіңіз?
Dialogue: 0,0:18:43.12,0:18:45.37,Default,,0,0,0,,Сіз Китаката мырзадан сұрадыңыз.
Dialogue: 0,0:18:47.16,0:18:48.37,Default,,0,0,0,,Иә
Dialogue: 0,0:18:49.54,0:18:51.88,Default,,0,0,0,,Тұтынушы болсаңыз не істер едіңіз?
Dialogue: 0,0:18:51.96,0:18:54.17,Default,,0,0,0,,Егер мен...
Dialogue: 0,0:18:54.25,0:18:57.88,Default,,0,0,0,,Мен сені жұдырықтаймын, жайбарақат болма.
Dialogue: 0,0:18:57.97,0:19:00.64,Default,,0,0,0,,А... қорқынышты
Dialogue: 0,0:19:01.39,0:19:04.89,Default,,0,0,0,,Өйткені ол әрі қарай созылады, солай емес пе?
Dialogue: 0,0:19:06.98,0:19:11.44,Default,,0,0,0,,Сізге жақын адам өлсе және сіз жалғыз аман қалған болсаңыз,
Dialogue: 0,0:19:11.52,0:19:13.65,Default,,0,0,0,,Өзіңізді кінәлай беріңіз
Dialogue: 0,0:19:16.99,0:19:20.66,Default,,0,0,0,,Мен де жазатайым жағдайда ата-анамнан айырылдым.
Dialogue: 0,0:19:20.74,0:19:23.78,Default,,0,0,0,,Неліктен жалғыз мен ғана аман қалдым?
Dialogue: 0,0:19:23.87,0:19:26.66,Default,,0,0,0,,Мен үшін өмір сүруге тұрарлық па?
Dialogue: 0,0:19:27.29,0:19:30.21,Default,,0,0,0,,Сасакура мырзада солай емес пе?
Dialogue: 0,0:19:30.29,0:19:34.54,Default,,0,0,0,,Жауап таба алмағандықтан болашақ туралы ойлай алмаймын.
Dialogue: 0,0:19:34.63,0:19:36.42,Default,,0,0,0,,Менің үйіме келу туралы...
Dialogue: 0,0:19:37.42,0:19:38.42,Default,,0,0,0,,Үш ойыншы оны құлатып тастады
Dialogue: 0,0:19:39.34,0:19:42.76,Default,,0,0,0,,Тұтынушы өзін-өзі өлтіргісі келетіндей уайымдаса ше?
Dialogue: 0,0:19:44.51,0:19:47.27,Default,,0,0,0,,Бұл мен сізге бере алатын жауап.
Dialogue: 0,0:19:49.31,0:19:51.19,Default,,0,0,0,,Менің атым Том және Джерри.
Dialogue: 0,0:19:51.27,0:19:53.56,Default,,0,0,0,,Мына мысық пен тышқан?
Dialogue: 0,0:19:53.65,0:19:56.57,Default,,0,0,0,,Мен иә деп айтқым келеді.
Dialogue: 0,0:19:56.65,0:19:58.99,Default,,0,0,0,,19 ғасырда белсенділік танытқан бармен
Dialogue: 0,0:19:59.07,0:20:01.70,Default,,0,0,0,,Оны Джерри Томас жасаған дейді.
Dialogue: 0,0:20:05.87,0:20:10.20,Default,,0,0,0,,Аздап тәтті, мусс тәрізді және жылы
Dialogue: 0,0:20:10.83,0:20:13.37,Default,,0,0,0,,Бармен не істей алады
Dialogue: 0,0:20:13.46,0:20:17.71,Default,,0,0,0,,Сіздің алдыңызда тұтынушыға ең жақсы тостағанды беру
Dialogue: 0,0:20:17.80,0:20:20.67,Default,,0,0,0,,Алкоголь тым күшті ме?
Dialogue: 0,0:20:20.76,0:20:24.14,Default,,0,0,0,,Тым тәтті ме? Тым ащы ма?
Dialogue: 0,0:20:24.22,0:20:27.47,Default,,0,0,0,,Ыстық емес пе? Суық емес пе?
Dialogue: 0,0:20:28.10,0:20:30.22,Default,,0,0,0,,Сонымен, бұл...
Dialogue: 0,0:20:30.31,0:20:32.64,Default,,0,0,0,,Және тағы бір нәрсе
Dialogue: 0,0:20:32.73,0:20:36.40,Default,,0,0,0,,Өмір мен өлім мәселесін пасторға қалдырыңыз.
Dialogue: 0,0:20:36.48,0:20:38.69,Default,,0,0,0,,Шебердің сөзі шығар?
Dialogue: 0,0:20:38.78,0:20:39.98,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:20:41.32,0:20:43.24,Default,,0,0,0,,Сасакура мырза
Dialogue: 0,0:20:43.32,0:20:46.99,Default,,0,0,0,,Сен енді өткенге мән бермейсің, солай ма?
Dialogue: 0,0:20:50.16,0:20:51.79,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:51.87,0:20:55.50,Default,,0,0,0,,Маған ауысу қиын болды...
Dialogue: 0,0:20:57.84,0:20:59.50,Default,,0,0,0,,(қолшатырды ашу дыбысы)
Dialogue: 0,0:20:59.59,0:21:02.34,Default,,0,0,0,,Оны қолданыңыз.
Dialogue: 0,0:21:02.42,0:21:03.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:04.76,0:21:06.76,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:21:08.85,0:21:10.64,Default,,0,0,0,,Сақ бол
Dialogue: 0,0:21:11.85,0:21:15.14,Default,,0,0,0,,Касе мырза, сіз сол кезде хатта осылай айтқансыз.
Dialogue: 0,0:21:16.10,0:21:18.98,Default,,0,0,0,,Бармен қанша қиын болса да
Dialogue: 0,0:21:19.07,0:21:21.90,Default,,0,0,0,,Тұтынушыларға бетіңізді көрсетпеңіз
Dialogue: 0,0:21:22.74,0:21:26.11,Default,,0,0,0,,Жолақ дегеніміз не? Клиенттер жаңбырдан пана алатын орын.
Dialogue: 0,0:21:26.20,0:21:28.62,Default,,0,0,0,,Бармен сізге қолшатыр беруі керек.
Dialogue: 0,0:21:28.70,0:21:31.91,Default,,0,0,0,,Қыңылдағанда не істейсің?
Dialogue: 0,0:21:33.04,0:21:34.66,Default,,0,0,0,,Өз сезімдерін жүйелеу
Dialogue: 0,0:21:34.75,0:21:37.00,Default,,0,0,0,,Мен қазірдің өзінде бармын деп ойладым.
Dialogue: 0,0:21:37.08,0:21:37.92,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:38.92,0:21:42.92,Default,,0,0,0,,Тұтынушы бізге басқаша айтты.
Dialogue: 0,0:21:44.55,0:21:47.84,Default,,0,0,0,,Мен әлі тәжірибесіз барменмін.
Dialogue: 0,0:21:47.93,0:21:48.93,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:21:49.80,0:21:51.35,Default,,0,0,0,,Оның жетілмегендігі
Dialogue: 0,0:21:51.43,0:21:55.44,Default,,0,0,0,,Өзіне көбірек алаңдайтын тұтынушылар бар.
Dialogue: 0,0:21:56.27,0:21:58.40,Default,,0,0,0,,Мен қазір істей алатын нәрсе
Dialogue: 0,0:21:58.48,0:22:01.44,Default,,0,0,0,,Мен шын жүректен айта алатыным осы.
Dialogue: 0,0:22:06.82,0:22:08.74,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:22:08.82,0:22:12.04,Default,,0,0,0,,Бүгінгі күн үшін рахмет.
Dialogue: 0,0:22:15.00,0:22:20.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.91,0:23:44.92,Default,,0,0,0,,～♪
