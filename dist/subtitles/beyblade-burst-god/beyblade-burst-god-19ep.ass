Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.29,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.09,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.48,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.19,0:00:29.48,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:31.65,0:00:35.28,Default,,0,0,0,,Біз Жылан шұңқырында Қара шығанақпен күресіп жатырмыз.
Dialogue: 0,0:00:35.36,0:00:37.82,Default,,0,0,0,,Екінші кезең – Дина және Қара көз
Dialogue: 0,0:00:37.91,0:00:39.08,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:00:42.91,0:00:46.04,Default,,0,0,0,,Қарауға болатын екінші шайқас - Deathsizer...
Dialogue: 0,0:00:46.12,0:00:49.09,Default,,0,0,0,,Flying Double Strike - бұл үлкен жеңіс!
Dialogue: 0,0:00:50.46,0:00:53.67,Default,,0,0,0,,Мен болашақты көре білуім керек еді
Dialogue: 0,0:00:53.80,0:00:55.97,Default,,0,0,0,,Болашақ көретін нәрсе емес
Dialogue: 0,0:00:56.80,0:00:58.51,Default,,0,0,0,,Оны өзіңіз жасаңыз
Dialogue: 0,0:00:58.60,0:01:00.01,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:01:00.60,0:01:02.77,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:02.85,0:01:06.48,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:01:06.56,0:01:08.90,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:01:10.07,0:01:11.61,Default,,0,0,0,,Үшінші кезең –
Dialogue: 0,0:01:11.69,0:01:14.86,Default,,0,0,0,,Куза Сұр көзді бір соққымен нокаутқа түсірді.
Dialogue: 0,0:01:16.07,0:01:19.87,Default,,0,0,0,,Нанчичи ату Gravity Shot!
Dialogue: 0,0:01:20.37,0:01:23.83,Default,,0,0,0,,Орекки – тартылыс күшіне бой алдырған адам.
Dialogue: 0,0:01:24.33,0:01:26.87,Default,,0,0,0,,Жоқ, мен сенен жеңілдім.
Dialogue: 0,0:01:26.96,0:01:29.04,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:01:30.75,0:01:34.76,Default,,0,0,0,,Төртінші кезең - мен Зулу Көзбен кездесу.
Dialogue: 0,0:01:34.84,0:01:37.34,Default,,0,0,0,,Azure Eye-ді алдамаңыз!
Dialogue: 0,0:01:42.26,0:01:45.27,Default,,0,0,0,,Қараның траекториясы жылдамырақ!
Dialogue: 0,0:01:45.35,0:01:46.98,Default,,0,0,0,,Қозғалысы да бірқалыпты.
Dialogue: 0,0:01:50.40,0:01:52.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:52.11,0:01:55.28,Default,,0,0,0,,Azure Eye үшін 1 ұпайды асыра аяқтаңыз
Dialogue: 0,0:01:55.36,0:01:56.90,Default,,0,0,0,,Балто-чан әлі де осында.
Dialogue: 0,0:01:56.99,0:02:00.62,Default,,0,0,0,,Сіз Валькирияның білігінің ұшын мүлде меңгермеген сияқтысыз.
Dialogue: 0,0:02:02.08,0:02:04.99,Default,,0,0,0,,Біліктің ұшы... осыны айтып тұрсың ба?
Dialogue: 0,0:02:05.66,0:02:09.75,Default,,0,0,0,,Сіз осындай нәрсені жасай алдыңыз. Мен мұны түсінбегеніме өкінемін.
Dialogue: 0,0:02:10.38,0:02:11.84,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:02:12.38,0:02:13.84,Default,,0,0,0,,Түсіндім, досым.
Dialogue: 0,0:02:13.92,0:02:16.88,Default,,0,0,0,,Мен сізге қалай жүгіргіңіз келсе, солай жүгіруге рұқсат етемін.
Dialogue: 0,0:02:17.38,0:02:20.22,Default,,0,0,0,,♪~
Dialogue: 0,0:02:20.30,0:02:22.68,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:22.76,0:02:25.22,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:25.31,0:02:27.73,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:27.81,0:02:30.23,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:30.31,0:02:31.86,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:02:31.94,0:02:36.15,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:37.07,0:02:41.82,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:41.91,0:02:46.37,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:46.91,0:02:51.67,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:51.75,0:02:56.67,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:56.75,0:03:01.63,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:03:01.72,0:03:06.76,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:03:06.85,0:03:10.10,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:03:10.19,0:03:11.81,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:11.90,0:03:14.31,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:03:14.40,0:03:16.65,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:03:16.73,0:03:18.82,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:03:18.90,0:03:20.32,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:03:20.40,0:03:21.91,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:03:21.99,0:03:24.24,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:03:24.32,0:03:30.46,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:03:30.54,0:03:35.13,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:35.21,0:03:37.80,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:37.88,0:03:40.09,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:40.17,0:03:42.72,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:42.80,0:03:46.30,Default,,0,0,0,,BURST BURST 3, 2, 1, АТТЫРУ (Бейблейд)! )
Dialogue: 0,0:03:42.80,0:03:46.30,Default,,0,0,0,,~♪
Dialogue: 0,0:03:46.30,0:03:46.93,Default,,0,0,0,,~♪
Dialogue: 0,0:03:48.39,0:03:50.81,Default,,0,0,0,,Енджин! Қызыл көз!
Dialogue: 0,0:03:52.02,0:03:53.94,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:03:54.02,0:03:57.40,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:03:57.48,0:03:59.86,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:04.03,0:04:07.28,Default,,0,0,0,,(Үдемелі айналу дыбысы)
Dialogue: 0,0:04:07.37,0:04:08.91,Default,,0,0,0,,Жарайды, міне осы!
Dialogue: 0,0:04:08.99,0:04:11.62,Default,,0,0,0,,Қайта жүктеу драйверінің білігінің ұшы шығып тұр
Dialogue: 0,0:04:11.70,0:04:12.79,Default,,0,0,0,,Иә, орбита.
Dialogue: 0,0:04:16.13,0:04:18.54,Default,,0,0,0,,Azur Eye ең жоғары ату қуатына ие
Dialogue: 0,0:04:18.63,0:04:20.59,Default,,0,0,0,,Шешіңіз, Азур!
Dialogue: 0,0:04:25.39,0:04:28.05,Default,,0,0,0,,Валькириге шабуыл!
Dialogue: 0,0:04:32.18,0:04:33.64,Default,,0,0,0,,Балтық басылды
Dialogue: 0,0:04:33.73,0:04:35.44,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:04:36.40,0:04:38.82,Default,,0,0,0,,Біліктің ұшы ақыры шыққан сияқты.
Dialogue: 0,0:04:38.90,0:04:40.82,Default,,0,0,0,,Егер бұл сізге қажет болса, онда мен жақсымын.
Dialogue: 0,0:04:40.90,0:04:45.20,Default,,0,0,0,,Қара Валькирия Мен Валькири-чанды ойнадым.
Dialogue: 0,0:04:47.87,0:04:49.33,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:04:49.53,0:04:50.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:50.62,0:04:52.79,Default,,0,0,0,,Сіз жеңдіңіз, Көк Көз.
Dialogue: 0,0:04:53.37,0:04:54.54,Default,,0,0,0,,Қызық!
Dialogue: 0,0:04:54.62,0:04:57.38,Default,,0,0,0,,Біз бұл жерде ұтыла алмаймыз!
Dialogue: 0,0:05:00.00,0:05:01.88,Default,,0,0,0,,Алға!
Dialogue: 0,0:05:02.76,0:05:04.59,Default,,0,0,0,,(Білік ұшынан шыққан дыбыс)
Dialogue: 0,0:05:04.67,0:05:06.30,Default,,0,0,0,,(Үдемелі айналу дыбысы)
Dialogue: 0,0:05:06.38,0:05:08.05,Default,,0,0,0,,Не? не? не?
Dialogue: 0,0:05:09.64,0:05:10.60,Default,,0,0,0,,Ах
Dialogue: 0,0:05:10.68,0:05:12.14,Default,,0,0,0,,Бұл қандай қозғалыс?
Dialogue: 0,0:05:12.22,0:05:14.23,Default,,0,0,0,,Жылдамдық кенет өсті!
Dialogue: 0,0:05:17.40,0:05:18.81,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:05:19.06,0:05:22.32,Default,,0,0,0,,Мен бұған сенбеймін, мен бұған сенбеймін.
Dialogue: 0,0:05:22.40,0:05:23.82,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:05:27.41,0:05:28.74,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:05:31.33,0:05:33.83,Default,,0,0,0,,Құдай Валькири, жарылған финиш-
Dialogue: 0,0:05:33.91,0:05:35.46,Default,,0,0,0,,Аои Балттың жеңісі
Dialogue: 0,0:05:35.96,0:05:37.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:37.67,0:05:39.42,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:05:39.50,0:05:41.04,Default,,0,0,0,,Бұл таңғажайып техника болды
Dialogue: 0,0:05:42.75,0:05:46.09,Default,,0,0,0,,Сол бас айналу күйінен кенет қалай айығып кеттің?
Dialogue: 0,0:05:46.17,0:05:47.68,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:05:48.09,0:05:49.59,Default,,0,0,0,,Мен ештеңе істеген жоқпын
Dialogue: 0,0:05:49.89,0:05:52.89,Default,,0,0,0,,Ештеңе жасамай-ақ мұндай қимылды орындау мүмкін емес.
Dialogue: 0,0:05:53.22,0:05:56.23,Default,,0,0,0,,Мен тек серігіме сеніп, бар күшіммен атып жібердім.
Dialogue: 0,0:05:56.31,0:05:58.10,Default,,0,0,0,,Толық түсіру?
Dialogue: 0,0:05:58.19,0:06:00.36,Default,,0,0,0,,Мен қолымнан келгеннің бәрін істеп жатсам да...
Dialogue: 0,0:06:00.73,0:06:03.44,Default,,0,0,0,,А, ашпа. Әй, сәл күте тұрыңыз, ашпаңыз!
Dialogue: 0,0:06:03.52,0:06:05.86,Default,,0,0,0,,Әй, бәрібір! Мүмкін емес!
Dialogue: 0,0:06:05.94,0:06:08.86,Default,,0,0,0,,(Қасқырдың ұлыуы)
Dialogue: 0,0:06:08.95,0:06:11.62,Default,,0,0,0,,Валькирияның қимылдары керемет болды
Dialogue: 0,0:06:11.91,0:06:13.83,Default,,0,0,0,,Сіз бұл техниканы жасырдыңыз ба?
Dialogue: 0,0:06:13.91,0:06:15.91,Default,,0,0,0,,Оны жасырмаңыз.
Dialogue: 0,0:06:16.00,0:06:17.71,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:06:18.00,0:06:20.25,Default,,0,0,0,,Жаңа ерекше қозғалыстың тууы
Dialogue: 0,0:06:20.33,0:06:21.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:21.17,0:06:22.88,Default,,0,0,0,,«Қуат азайса да» деп атаңыз.
Dialogue: 0,0:06:22.96,0:06:26.05,Default,,0,0,0,,«Соңғы минутта жылдамдықты арттырыңыз және қарсы шабуыл жасаңыз!»
Dialogue: 0,0:06:26.13,0:06:28.88,Default,,0,0,0,,Мұның бәрі осы емес пе?
Dialogue: 0,0:06:28.97,0:06:32.01,Default,,0,0,0,,Бұрышқа итерілгеннен кейін, кері соққы беру уақыты келді.
Dialogue: 0,0:06:32.10,0:06:34.14,Default,,0,0,0,,«Дотамба кері түсіру» дегеніміз не?
Dialogue: 0,0:06:34.22,0:06:35.89,Default,,0,0,0,,Слапстикпен гаг ату
Dialogue: 0,0:06:35.97,0:06:38.56,Default,,0,0,0,,Келіңіздер! Дотамбаға кері түсіру!
Dialogue: 0,0:06:38.64,0:06:39.73,Default,,0,0,0,,Қабылданбады!
Dialogue: 0,0:06:42.36,0:06:43.48,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:06:44.02,0:06:45.19,Default,,0,0,0,,Қайта жүктеу керек пе?
Dialogue: 0,0:06:45.82,0:06:47.53,Default,,0,0,0,,Құдай қайта жүктей ме?
Dialogue: 0,0:06:47.61,0:06:49.53,Default,,0,0,0,,Валькири осылай айтып тұр ма?
Dialogue: 0,0:06:49.61,0:06:51.74,Default,,0,0,0,,О, құдай қайта жүкте!
Dialogue: 0,0:06:51.86,0:06:53.37,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:06:53.45,0:06:54.41,Default,,0,0,0,,О!
Dialogue: 0,0:06:55.08,0:06:58.54,Default,,0,0,0,,Snake Pit Blader үш рет қатарынан жеңілді...
Dialogue: 0,0:06:59.25,0:07:01.75,Default,,0,0,0,,Мен барып, оларды басып алайын.
Dialogue: 0,0:07:01.83,0:07:03.00,Default,,0,0,0,,Мен де барамын.
Dialogue: 0,0:07:03.08,0:07:04.00,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:07:04.09,0:07:05.55,Default,,0,0,0,,Тіліңді ұстама!
Dialogue: 0,0:07:06.05,0:07:07.09,Default,,0,0,0,,Ашрам -
Dialogue: 0,0:07:07.17,0:07:11.76,Default,,0,0,0,,I promised whoever won against Black Bay to fight me.
Dialogue: 0,0:07:12.34,0:07:14.93,Default,,0,0,0,,Дұрыс, Қызыл көз.
Dialogue: 0,0:07:17.56,0:07:18.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:19.23,0:07:21.94,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:07:23.44,0:07:25.40,Default,,0,0,0,,Біз осы жерде соғыса аламыз ба?
Dialogue: 0,0:07:25.65,0:07:27.61,Default,,0,0,0,,Иә... меніңше.
Dialogue: 0,0:07:27.69,0:07:30.07,Default,,0,0,0,,Ендігі кезек Вакия Омеде.
Dialogue: 0,0:07:31.90,0:07:33.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:33.11,0:07:35.49,Default,,0,0,0,,Бұл жер нашар! Мен үшін бұл мүмкін емес
Dialogue: 0,0:07:35.58,0:07:37.20,Default,,0,0,0,,Мен сені солай айтты деп ойладым.
Dialogue: 0,0:07:37.54,0:07:39.70,Default,,0,0,0,,Егер сіз жоғары нәтижеге қол жеткізсеңіз, бұл жақсы емес.
Dialogue: 0,0:07:39.79,0:07:40.71,Default,,0,0,0,,Идиот!
Dialogue: 0,0:07:40.79,0:07:43.42,Default,,0,0,0,,There's something wrong with you guys who are okay with heights!
Dialogue: 0,0:07:43.54,0:07:44.92,Default,,0,0,0,,Мен де жақсымын.
Dialogue: 0,0:07:45.00,0:07:46.46,Default,,0,0,0,,Сәлем, балақай!
Dialogue: 0,0:07:48.96,0:07:50.84,Default,,0,0,0,,Тоқта, ақымақ!
Dialogue: 0,0:07:50.92,0:07:52.13,Default,,0,0,0,,Сіз оны қай жерде ұстап тұрсыз?
Dialogue: 0,0:07:52.22,0:07:54.39,Default,,0,0,0,,Комурасаки Вакия, тез кел!
Dialogue: 0,0:07:56.68,0:07:59.81,Default,,0,0,0,,Кисаманың қарсыласы мына Күлгін Көз!
Dialogue: 0,0:08:01.43,0:08:04.35,Default,,0,0,0,,Бұл Виверннің көшірме алаңында
Dialogue: 0,0:08:04.44,0:08:06.15,Default,,0,0,0,,Вакия барайын ба?
Dialogue: 0,0:08:06.44,0:08:09.61,Default,,0,0,0,,Немене, мен оның қарсыласымын!
Dialogue: 0,0:08:11.07,0:08:12.78,Default,,0,0,0,,Олай болса, тезірек барайық!
Dialogue: 0,0:08:12.86,0:08:13.86,Default,,0,0,0,,Iko!
Dialogue: 0,0:08:13.95,0:08:15.74,Default,,0,0,0,,Уау! Сен не істеп жатырсың?
Dialogue: 0,0:08:15.82,0:08:18.53,Default,,0,0,0,,Қолдап тұрғаның үшін рахмет.
Dialogue: 0,0:08:20.91,0:08:22.29,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:08:22.37,0:08:23.50,Default,,0,0,0,,Ганбатта
Dialogue: 0,0:08:23.92,0:08:24.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:25.75,0:08:27.29,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:08:28.04,0:08:29.67,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:08:31.92,0:08:33.88,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:08:33.97,0:08:37.01,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:37.55,0:08:38.97,Default,,0,0,0,,Бару…
Dialogue: 0,0:08:41.14,0:08:42.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:42.23,0:08:44.23,Default,,0,0,0,,Бұл ойын емес
Dialogue: 0,0:08:44.31,0:08:46.98,Default,,0,0,0,,Эй... Мен жай ғана өзімді жақсы сезінбеймін.
Dialogue: 0,0:08:47.06,0:08:49.15,Default,,0,0,0,,Бірден... Мен ашуландым...
Dialogue: 0,0:08:49.65,0:08:50.94,Default,,0,0,0,,Вакия
Dialogue: 0,0:08:51.03,0:08:53.07,Default,,0,0,0,,Бұл жігіт өте жаман!
Dialogue: 0,0:08:53.36,0:08:56.70,Default,,0,0,0,,Бұл стадион ол үшін ең нашар.
Dialogue: 0,0:08:56.78,0:08:59.37,Default,,0,0,0,,Бұл мен үшін өте жақсы.
Dialogue: 0,0:08:59.45,0:09:00.79,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:09:00.87,0:09:03.79,Default,,0,0,0,,Бұл Tornado Wyvern иесі.
Dialogue: 0,0:09:04.04,0:09:07.00,Default,,0,0,0,,I know that I'm not good at being expensive.
Dialogue: 0,0:09:07.08,0:09:09.13,Default,,0,0,0,,Менің ойымша, біз осында соғысуды шештік...
Dialogue: 0,0:09:09.59,0:09:10.80,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:09:10.88,0:09:15.55,Default,,0,0,0,,Exploiting your opponent's weaknesses is a surefire way to win, hehe!
Dialogue: 0,0:09:15.63,0:09:17.59,Default,,0,0,0,,Вакия Бұл туралы уайымдамаңыз!
Dialogue: 0,0:09:17.68,0:09:18.84,Default,,0,0,0,,Көздеріңді жабыңдар!
Dialogue: 0,0:09:18.93,0:09:22.31,Default,,0,0,0,,Мынау Шудың қараңғы атуы. Сіз жасай аласыз!
Dialogue: 0,0:09:22.39,0:09:23.98,Default,,0,0,0,,Иә, мүмкін!
Dialogue: 0,0:09:24.18,0:09:26.10,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:09:26.31,0:09:27.94,Default,,0,0,0,,Қараңғы кадрлар...
Dialogue: 0,0:09:28.94,0:09:30.98,Default,,0,0,0,,Жоқ! Мен оны істедім!
Dialogue: 0,0:09:31.19,0:09:34.32,Default,,0,0,0,,Менде бәрі жақсы, мұнда қымбат емес.
Dialogue: 0,0:09:34.40,0:09:37.15,Default,,0,0,0,,Бұл бірінші қабат.
Dialogue: 0,0:09:37.24,0:09:40.20,Default,,0,0,0,,Менің қолымнан келеді, менің қолымнан келеді!
Dialogue: 0,0:09:40.83,0:09:42.74,Default,,0,0,0,,Жарайды, жүр!
Dialogue: 0,0:09:42.87,0:09:45.12,Default,,0,0,0,,Әй, эй, сен қай жаққа қарайсың?
Dialogue: 0,0:09:45.54,0:09:46.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.12,0:09:49.75,Default,,0,0,0,,Ооо!
Dialogue: 0,0:09:50.17,0:09:52.04,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:52.13,0:09:54.21,Default,,0,0,0,,Комурасаки сияқты ештеңе жоқ.
Dialogue: 0,0:09:54.30,0:09:56.01,Default,,0,0,0,,Ухахахаха
Dialogue: 0,0:09:56.09,0:09:57.93,Default,,0,0,0,,Сіз соншалықты алысқа барып, жеңгіңіз келе ме?
Dialogue: 0,0:09:58.05,0:09:58.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:03.14,0:10:04.47,Default,,0,0,0,,Қызыл көз
Dialogue: 0,0:10:04.56,0:10:07.27,Default,,0,0,0,,Ах! Міне, Қызыл көз келді!
Dialogue: 0,0:10:07.52,0:10:10.06,Default,,0,0,0,,Менің шайқасыма араласпа
Dialogue: 0,0:10:10.15,0:10:12.82,Default,,0,0,0,,Ондай қарсыласты жеңудің мәні жоқ.
Dialogue: 0,0:10:13.19,0:10:14.19,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:10:14.40,0:10:19.24,Default,,0,0,0,,Күш-қуаттағы қарсыласты жеңгенде ғана бар болудың мәні бар.
Dialogue: 0,0:10:19.45,0:10:21.32,Default,,0,0,0,,Олай дейтін болсам, бұл қате сияқты.
Dialogue: 0,0:10:21.41,0:10:25.20,Default,,0,0,0,,Қызыл көз, менімен күрес, мен сенен жеңілмеймін!
Dialogue: 0,0:10:27.00,0:10:29.83,Default,,0,0,0,,Балалар, сендер не туралы айтып тұрсыңдар?
Dialogue: 0,0:10:29.92,0:10:33.25,Default,,0,0,0,,Менің шайқасымды ұрлауға жол бермеймін!
Dialogue: 0,0:10:33.50,0:10:36.67,Default,,0,0,0,,Қызыл көз! Мен сенімен ұрысқым келмейді!
Dialogue: 0,0:10:36.92,0:10:39.38,Default,,0,0,0,,Енді мен туралы жаман сөз айтпа!
Dialogue: 0,0:10:39.47,0:10:43.47,Default,,0,0,0,,Денсаулығым әрқашан жақсы, денсаулығымда еш қиындық жоқ!
Dialogue: 0,0:10:43.72,0:10:45.68,Default,,0,0,0,,Мен әдеттегі жұмысыма қайта оралдым!
Dialogue: 0,0:10:45.77,0:10:48.52,Default,,0,0,0,,Дәл қазір Уакия тек Қызыл көзді көреді.
Dialogue: 0,0:10:49.02,0:10:50.94,Default,,0,0,0,,Бұл ұрыс, Қызыл көз!
Dialogue: 0,0:10:51.02,0:10:52.31,Default,,0,0,0,,Мен біріншімін!
Dialogue: 0,0:10:52.40,0:10:53.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:56.65,0:10:57.94,Default,,0,0,0,,Бірге келіңдер.
Dialogue: 0,0:10:58.03,0:11:00.49,Default,,0,0,0,,Не? Ақымақ болма
Dialogue: 0,0:11:00.57,0:11:01.95,Default,,0,0,0,,Мені мазақ етпе!
Dialogue: 0,0:11:02.74,0:11:04.20,Default,,0,0,0,,Бастайық
Dialogue: 0,0:11:04.53,0:11:06.41,Default,,0,0,0,,Жарайды ма? Ашрам-сама
Dialogue: 0,0:11:06.49,0:11:07.66,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:11:07.75,0:11:08.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:09.08,0:11:10.54,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:11:10.62,0:11:11.75,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:11.83,0:11:13.25,Default,,0,0,0,,Ягару!
Dialogue: 0,0:11:13.33,0:11:14.13,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:11:14.21,0:11:16.17,Default,,0,0,0,,О, үш адам шайқасады!
Dialogue: 0,0:11:16.25,0:11:18.59,Default,,0,0,0,,Battle Royale қызықты.
Dialogue: 0,0:11:18.67,0:11:20.17,Default,,0,0,0,,Мұны да жасаңыз!
Dialogue: 0,0:11:20.80,0:11:21.93,Default,,0,0,0,,Қазірдің өзінде кеш!
Dialogue: 0,0:11:22.01,0:11:23.84,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:11:24.01,0:11:27.52,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:27.64,0:11:29.81,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:33.98,0:11:36.44,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:39.49,0:11:41.57,Default,,0,0,0,,Спригган сағат тілімен айналады.
Dialogue: 0,0:11:41.70,0:11:43.99,Default,,0,0,0,,Торнадо қалқаны!
Dialogue: 0,0:11:46.28,0:11:48.41,Default,,0,0,0,,Бұл шабуыл жұмыс істемейді!
Dialogue: 0,0:11:48.74,0:11:50.62,Default,,0,0,0,,Мұнда да солай!
Dialogue: 0,0:11:50.79,0:11:54.25,Default,,0,0,0,,Екеуі де Инаши қабатымен қарсыластың күшін жояды.
Dialogue: 0,0:11:59.46,0:12:01.05,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:12:03.05,0:12:04.43,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:12:04.51,0:12:05.68,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:05.76,0:12:06.93,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:12:07.43,0:12:09.35,Default,,0,0,0,,Бірден екі шығанақ...
Dialogue: 0,0:12:09.43,0:12:11.18,Default,,0,0,0,,Сіз оны жарып жібердіңіз!
Dialogue: 0,0:12:11.73,0:12:14.19,Default,,0,0,0,,Аңыздық Спригган
Dialogue: 0,0:12:14.27,0:12:15.65,Default,,0,0,0,,Қызыл көздің жеңісі!
Dialogue: 0,0:12:17.73,0:12:20.78,Default,,0,0,0,,Увааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:12:20.90,0:12:22.65,Default,,0,0,0,,Вакия!
Dialogue: 0,0:12:27.12,0:12:29.91,Default,,0,0,0,,Қызыл көз, сен...
Dialogue: 0,0:12:30.37,0:12:32.54,Default,,0,0,0,,Жеңімпаздар ғана аман қалады
Dialogue: 0,0:12:32.96,0:12:34.79,Default,,0,0,0,,Бұл жерде заң солай.
Dialogue: 0,0:12:34.87,0:12:36.25,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:12:36.79,0:12:39.17,Default,,0,0,0,,Сонымен сприган осында.
Dialogue: 0,0:12:39.25,0:12:41.05,Default,,0,0,0,,Мынау Шудың шығанағы.
Dialogue: 0,0:12:42.05,0:12:44.84,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:12:44.93,0:12:45.97,Default,,0,0,0,,Балто!
Dialogue: 0,0:12:46.22,0:12:48.43,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:12:51.52,0:12:53.43,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:12:53.52,0:12:54.56,Default,,0,0,0,,Балто!
Dialogue: 0,0:12:57.02,0:12:58.44,Default,,0,0,0,,Тым ыңғайсыз!
Dialogue: 0,0:12:58.52,0:12:59.86,Default,,0,0,0,,Мен қазір саған көмектесемін.
Dialogue: 0,0:13:00.07,0:13:01.03,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:02.65,0:13:04.28,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:13:13.95,0:13:17.04,Default,,0,0,0,,Қара Бэйді кім жеңсе, мен соқтығысамын.
Dialogue: 0,0:13:17.88,0:13:20.63,Default,,0,0,0,,Қызыл көз қуат бойынша бірнеше саты жоғары.
Dialogue: 0,0:13:20.96,0:13:22.80,Default,,0,0,0,,Нәтиже анықталады.
Dialogue: 0,0:13:23.13,0:13:25.34,Default,,0,0,0,,Қуат айырмашылығын көрсету арқылы
Dialogue: 0,0:13:25.42,0:13:28.55,Default,,0,0,0,,Мен олардың жүректеріне нүкте қоямын.
Dialogue: 0,0:13:28.64,0:13:30.26,Default,,0,0,0,,Ол қатал адам.
Dialogue: 0,0:13:30.81,0:13:33.77,Default,,0,0,0,,Боа, оның қаталдығын біл.
Dialogue: 0,0:13:33.85,0:13:34.64,Default,,0,0,0,,Иә
Dialogue: 0,0:13:36.60,0:13:40.11,Default,,0,0,0,,Қара көз және сұр көзді жеңдік.
Dialogue: 0,0:13:40.44,0:13:41.94,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:13:42.57,0:13:44.36,Default,,0,0,0,,Сіз оны 3-тен 1-ге дейін ойнауды жоспарлап отырсыз ба?
Dialogue: 0,0:13:44.44,0:13:46.03,Default,,0,0,0,,Жасайық
Dialogue: 0,0:13:46.36,0:13:48.32,Default,,0,0,0,,Маған оның қандай шайқас екені маңызды емес.
Dialogue: 0,0:13:48.82,0:13:50.78,Default,,0,0,0,,Біз жеңіп, Спригганды қайтарамыз.
Dialogue: 0,0:13:52.54,0:13:54.37,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:13:56.83,0:13:58.75,Default,,0,0,0,,Іске қосу құралын сырғытыңыз
Dialogue: 0,0:13:59.38,0:14:01.25,Default,,0,0,0,,Келесі жолы мен солға бұрыламын.
Dialogue: 0,0:14:01.42,0:14:02.92,Default,,0,0,0,,Солға бұрылыңыз…
Dialogue: 0,0:14:06.84,0:14:08.88,Default,,0,0,0,,Күте тұрыңыз, Валькири
Dialogue: 0,0:14:13.68,0:14:17.27,Default,,0,0,0,,Кеш келді, қатты жылдамдықпен келе жатты.
Dialogue: 0,0:14:17.35,0:14:20.60,Default,,0,0,0,,Battle Royale ойынында команда болып күресе алатындарымыздың артықшылығы бар.
Dialogue: 0,0:14:20.69,0:14:21.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:21.98,0:14:23.27,Default,,0,0,0,,Команда болып күресу
Dialogue: 0,0:14:23.52,0:14:24.44,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:24.53,0:14:28.03,Default,,0,0,0,,Мен қазір жоспар жасаймын, сондықтан сәл күте тұр, Қызыл көз.
Dialogue: 0,0:14:32.70,0:14:34.74,Default,,0,0,0,,Сіз қандай стратегияны қолдануды жоспарлап отырсыз?
Dialogue: 0,0:14:34.83,0:14:36.33,Default,,0,0,0,,Сіз нені айтасыз...
Dialogue: 0,0:14:36.41,0:14:37.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:37.58,0:14:39.29,Default,,0,0,0,,3-тен 1-ге тең.
Dialogue: 0,0:14:39.37,0:14:41.58,Default,,0,0,0,,Біз бәріміз барға және бумға бардық!
Dialogue: 0,0:14:41.67,0:14:43.79,Default,,0,0,0,,Мұны стратегия деп атамаңыз.
Dialogue: 0,0:14:44.00,0:14:46.59,Default,,0,0,0,,Менің өлім сенерім және Балттың Валькириясы...
Dialogue: 0,0:14:46.67,0:14:48.09,Default,,0,0,0,,Шабуыл түрі
Dialogue: 0,0:14:48.17,0:14:50.84,Default,,0,0,0,,Kuza's Kronos өте төзімділік режиміне ие және...
Dialogue: 0,0:14:50.93,0:14:53.18,Default,,0,0,0,,Сіз супер шабуыл режимдерін таңдай аласыз
Dialogue: 0,0:14:53.39,0:14:55.43,Default,,0,0,0,,Қай жолмен жүруім керек?
Dialogue: 0,0:14:55.60,0:14:58.48,Default,,0,0,0,,Егер ол солға бұрылумен шабуыл жасаса...
Dialogue: 0,0:14:58.56,0:15:02.10,Default,,0,0,0,,Шабуыл түрімен соқтығысу арқылы сіз көп төзімділікті жоғалтуыңыз керек.
Dialogue: 0,0:15:02.19,0:15:04.90,Default,,0,0,0,,Түсінемін, егер оны төзімділік сайысына айналдырсақ...
Dialogue: 0,0:15:04.98,0:15:07.36,Default,,0,0,0,,Бұл біздің ақыр соңында артықшылыққа ие боламыз дегенді білдіре ме?
Dialogue: 0,0:15:07.44,0:15:08.40,Default,,0,0,0,,О
Dialogue: 0,0:15:08.49,0:15:09.11,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:09.19,0:15:12.32,Default,,0,0,0,,Куза, орталықты супер шыдамдылық режимінде алыңыз.
Dialogue: 0,0:15:12.70,0:15:16.49,Default,,0,0,0,,Мен және Дина асығыс шабуыл жасап, оның төзімділігіне зиян келтіреміз.
Dialogue: 0,0:15:16.83,0:15:17.83,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:18.50,0:15:19.54,Default,,0,0,0,,(Қабаттардың ауысу дыбысы)
Dialogue: 0,0:15:19.62,0:15:23.38,Default,,0,0,0,,Егер сіз асығыс шабуыл жасағыңыз келсе, мен де осымен барамын.
Dialogue: 0,0:15:23.50,0:15:25.09,Default,,0,0,0,,(Жақтауды алу дыбысы)
Dialogue: 0,0:15:25.38,0:15:27.80,Default,,0,0,0,,Оны жеңілдетіп, жылдамдықты арттырыңыз.
Dialogue: 0,0:15:27.88,0:15:28.71,Default,,0,0,0,,О
Dialogue: 0,0:15:31.72,0:15:33.22,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:15:33.30,0:15:34.85,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:15:38.18,0:15:41.69,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:41.81,0:15:45.69,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:50.99,0:15:54.24,Default,,0,0,0,,Керемет, Chronos орталығын тамашалайық!
Dialogue: 0,0:15:54.32,0:15:56.28,Default,,0,0,0,,Жүр! Байланысты шабуыл!
Dialogue: 0,0:15:56.37,0:15:58.58,Default,,0,0,0,,Қос соққы!
Dialogue: 0,0:15:59.50,0:16:00.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:00.58,0:16:02.04,Default,,0,0,0,,Ол одан жалтарды.
Dialogue: 0,0:16:02.12,0:16:05.38,Default,,0,0,0,,Мен сіздің стратегияңыздың барлығын көремін.
Dialogue: 0,0:16:11.26,0:16:12.63,Default,,0,0,0,,Есептегіш үзіліс
Dialogue: 0,0:16:12.88,0:16:14.09,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:16:14.22,0:16:15.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:19.47,0:16:21.06,Default,,0,0,0,,Траектория өзгерді!
Dialogue: 0,0:16:21.14,0:16:24.02,Default,,0,0,0,,Маңызды емес! Мені жарып жібер, Валькири!
Dialogue: 0,0:16:27.19,0:16:28.23,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:16:32.15,0:16:33.70,Default,,0,0,0,,Жүр!
Dialogue: 0,0:16:36.78,0:16:38.12,Default,,0,0,0,,Жоғарғы түсіру
Dialogue: 0,0:16:41.04,0:16:42.41,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:47.33,0:16:48.92,Default,,0,0,0,,Жалғыз сен қалдың
Dialogue: 0,0:16:49.75,0:16:50.96,Default,,0,0,0,,Оқ жаудыр!
Dialogue: 0,0:16:51.17,0:16:53.05,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:16:53.47,0:16:57.18,Default,,0,0,0,,Бар, Валькири! Бұл асығыс соққы
Dialogue: 0,0:17:00.10,0:17:02.35,Default,,0,0,0,,Валькири осындай ма?
Dialogue: 0,0:17:02.73,0:17:04.52,Default,,0,0,0,,Көбірек шабуыл жасаңыз, Валькири!
Dialogue: 0,0:17:11.11,0:17:13.36,Default,,0,0,0,,Валькирияның шыдамы жетпейді.
Dialogue: 0,0:17:13.49,0:17:16.28,Default,,0,0,0,,Жоқ, Валькири әлі де осында.
Dialogue: 0,0:17:16.36,0:17:18.20,Default,,0,0,0,,Құдайдың қайта жүктеуі бар!
Dialogue: 0,0:17:18.53,0:17:22.54,Default,,0,0,0,,Иә, Valkyrie God Reboot!
Dialogue: 0,0:17:24.54,0:17:26.92,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:31.00,0:17:32.80,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:17:33.09,0:17:34.92,Default,,0,0,0,,Спригган!
Dialogue: 0,0:17:45.89,0:17:47.98,Default,,0,0,0,,Балта ату
Dialogue: 0,0:17:54.99,0:17:57.53,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:17:58.16,0:17:59.20,Default,,0,0,0,,Не!
Dialogue: 0,0:18:00.41,0:18:03.62,Default,,0,0,0,,Қызыл көз жарқыраған мәремен жеңеді!
Dialogue: 0,0:18:05.12,0:18:08.50,Default,,0,0,0,,Аңыз Спригган менің қолымда одан да күшті болады.
Dialogue: 0,0:18:10.00,0:18:11.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:11.38,0:18:16.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:19.01,0:18:20.80,Default,,0,0,0,,Қызыл көз күткендей
Dialogue: 0,0:18:21.76,0:18:25.18,Default,,0,0,0,,Қарсыластағы әрбір қозғалысты басқарды
Dialogue: 0,0:18:25.60,0:18:29.06,Default,,0,0,0,,Сондықтан бұл жылан шұңқырындағы ең күшті жүзік.
Dialogue: 0,0:18:29.39,0:18:31.73,Default,,0,0,0,,Мен оларды енді ешқашан көрмеймін.
Dialogue: 0,0:18:31.98,0:18:35.73,Default,,0,0,0,,Мен сіздің мақсатыңызды білемін.
Dialogue: 0,0:18:35.82,0:18:38.28,Default,,0,0,0,,Хэхехехе...
Dialogue: 0,0:18:42.62,0:18:43.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:45.29,0:18:46.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:49.79,0:18:51.71,Default,,0,0,0,,Сіз оянған сияқтысыз
Dialogue: 0,0:18:52.88,0:18:54.75,Default,,0,0,0,,Вакия! Бұл қайда?
Dialogue: 0,0:18:54.84,0:18:57.80,Default,,0,0,0,,Оны көргенде білесің. Джунглиде.
Dialogue: 0,0:18:57.88,0:18:59.68,Default,,0,0,0,,Басқа ешкім жоқ
Dialogue: 0,0:19:00.09,0:19:01.80,Default,,0,0,0,,Жылан шұңқыры ше?
Dialogue: 0,0:19:03.76,0:19:05.64,Default,,0,0,0,,Пирамида жоғалып кетті.
Dialogue: 0,0:19:05.72,0:19:08.98,Default,,0,0,0,,Үңгірге құлаған жерім есімде жоқ.
Dialogue: 0,0:19:09.64,0:19:11.19,Default,,0,0,0,,Мен мұны білмей тұрып, осында болдым.
Dialogue: 0,0:19:11.60,0:19:13.06,Default,,0,0,0,,«Жеңілгендер кетеді»
Dialogue: 0,0:19:13.15,0:19:15.77,Default,,0,0,0,,Бұл жылан шұңқырының заңы.
Dialogue: 0,0:19:16.48,0:19:17.94,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:19:18.03,0:19:21.99,Default,,0,0,0,,Қызыл көз! Менімен қайтадан шайқас!
Dialogue: 0,0:19:24.62,0:19:26.29,Default,,0,0,0,,Айқайлаудан пайда жоқ
Dialogue: 0,0:19:26.37,0:19:30.25,Default,,0,0,0,,Бірақ қазір Шудың тірі екені белгілі болды.
Dialogue: 0,0:19:30.33,0:19:31.92,Default,,0,0,0,,Неге, Кумичо
Dialogue: 0,0:19:32.58,0:19:35.88,Default,,0,0,0,,Біз тіріміз, бұл дәлел емес пе?
Dialogue: 0,0:19:35.96,0:19:37.05,Default,,0,0,0,,Сейана
Dialogue: 0,0:19:37.13,0:19:38.59,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:19:38.67,0:19:40.55,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:19:40.63,0:19:42.09,Default,,0,0,0,,Мен сенімдімін Шу...
Dialogue: 0,0:19:42.18,0:19:44.68,Default,,0,0,0,,Ол да біз сияқты Қызыл көзден жеңіліп қалды.
Dialogue: 0,0:19:44.76,0:19:46.01,Default,,0,0,0,,Және жақсы!
Dialogue: 0,0:19:46.10,0:19:48.39,Default,,0,0,0,,Мені жылан шұңқырынан лақтырды.
Dialogue: 0,0:19:49.06,0:19:50.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:50.43,0:19:52.35,Default,,0,0,0,,Шу тірі!
Dialogue: 0,0:19:52.64,0:19:54.15,Default,,0,0,0,,Бұл мүмкін.
Dialogue: 0,0:19:54.44,0:19:57.23,Default,,0,0,0,,Шу жеңілгеннен кейін шегінетін адам емес.
Dialogue: 0,0:19:57.65,0:20:00.24,Default,,0,0,0,,Ол бір жерде арнайы дайындықтан өтіп жатқан болуы керек!
Dialogue: 0,0:20:00.69,0:20:01.90,Default,,0,0,0,,Оған күмән жоқ
Dialogue: 0,0:20:01.99,0:20:04.91,Default,,0,0,0,,Ол міндетті түрде күштірек болады.
Dialogue: 0,0:20:04.99,0:20:07.70,Default,,0,0,0,,Жаңа ерекше қозғалысты үйреніңіз
Dialogue: 0,0:20:07.78,0:20:09.37,Default,,0,0,0,,Бұл Шу, солай ма?
Dialogue: 0,0:20:09.45,0:20:12.29,Default,,0,0,0,,Әй, Шу міндетті түрде солай істейтін еді.
Dialogue: 0,0:20:12.54,0:20:15.50,Default,,0,0,0,,Мен мұндай жерде уақытты босқа өткізе алмаймын.
Dialogue: 0,0:20:15.58,0:20:17.63,Default,,0,0,0,,Арнайы дайындық үшін командаға оралу.
Dialogue: 0,0:20:18.55,0:20:20.59,Default,,0,0,0,,Сіз жолды білесіз бе?
Dialogue: 0,0:20:21.63,0:20:24.64,Default,,0,0,0,,Сіз түсіне алмайсыз (Рантаро) Зуко!
Dialogue: 0,0:20:24.80,0:20:26.14,Default,,0,0,0,,Мен сізге бағыт-бағдар беремін
Dialogue: 0,0:20:29.18,0:20:30.27,Default,,0,0,0,,Сіз...
Dialogue: 0,0:20:30.81,0:20:32.02,Default,,0,0,0,,Мен жалықтымын
Dialogue: 0,0:20:32.48,0:20:35.98,Default,,0,0,0,,Маған бәріңізді Джунглидің шығатын жеріне апаруымды өтінді.
Dialogue: 0,0:20:38.61,0:20:41.36,Default,,0,0,0,,Қызыл көзге қарсы шыққандардың бәріне қызғанышпен қараймын.
Dialogue: 0,0:20:41.44,0:20:43.74,Default,,0,0,0,,Мен жеңілгеніме өкінемін.
Dialogue: 0,0:20:44.24,0:20:46.24,Default,,0,0,0,,Мен одан да жаманмын
Dialogue: 0,0:20:46.45,0:20:48.58,Default,,0,0,0,,Жаман нәрселердің бәрі бірдей.
Dialogue: 0,0:20:48.66,0:20:51.20,Default,,0,0,0,,Біз өте қызық болдық.
Dialogue: 0,0:20:51.29,0:20:52.58,Default,,0,0,0,,Куттанар
Dialogue: 0,0:20:52.66,0:20:56.04,Default,,0,0,0,,Сен жеңдің, сұр көз.
Dialogue: 0,0:20:56.12,0:20:58.13,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:21:01.42,0:21:02.88,Default,,0,0,0,,Бұл шығу
Dialogue: 0,0:21:03.22,0:21:05.59,Default,,0,0,0,,Боа, басшылық үшін рахмет!
Dialogue: 0,0:21:06.01,0:21:09.35,Default,,0,0,0,,Мен де қызыл көз сияқты күшейемін.
Dialogue: 0,0:21:18.56,0:21:20.15,Default,,0,0,0,,Қызыл көз…
Dialogue: 0,0:21:27.57,0:21:31.29,Default,,0,0,0,,Қызыл Ай! Сен мені ести аласың ба?
Dialogue: 0,0:21:31.54,0:21:32.95,Default,,0,0,0,,Шулы!
Dialogue: 0,0:21:33.04,0:21:34.54,Default,,0,0,0,,Мені естуге мүмкіндік жоқ!
Dialogue: 0,0:21:34.75,0:21:36.87,Default,,0,0,0,,Бұл терезе ашылмайды!
Dialogue: 0,0:21:36.96,0:21:39.25,Default,,0,0,0,,Ол ашылмауға арналған.
Dialogue: 0,0:21:39.33,0:21:41.30,Default,,0,0,0,,Неліктен терезені осылай жасайсың?
Dialogue: 0,0:21:41.46,0:21:43.01,Default,,0,0,0,,Эй, мынау ашылатын сияқты.
Dialogue: 0,0:21:43.09,0:21:45.38,Default,,0,0,0,,Уау! Оны ашпа!
Dialogue: 0,0:21:46.97,0:21:48.43,Default,,0,0,0,,Қызыл көз
Dialogue: 0,0:21:48.51,0:21:52.85,Default,,0,0,0,,Мен сені бұл жолы міндетті түрде жеңемін!
Dialogue: 0,0:21:55.89,0:21:58.48,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.56,0:22:01.86,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.94,0:22:04.78,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.86,0:22:07.03,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.11,0:22:10.62,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.70,0:22:14.29,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.37,0:22:16.16,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.25,0:22:17.96,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.04,0:22:19.79,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.88,0:22:21.54,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.63,0:22:23.59,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.67,0:22:26.05,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.13,0:22:29.05,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.13,0:22:32.76,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.85,0:22:36.52,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.60,0:22:38.31,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.39,0:22:41.56,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.65,0:22:43.98,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.07,0:22:47.49,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.57,0:22:51.03,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.11,0:22:53.16,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.24,0:22:54.95,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.04,0:22:58.46,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.54,0:23:00.46,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.54,0:23:03.54,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.63,0:23:05.84,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.92,0:23:09.84,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.93,0:23:13.51,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.60,0:23:17.06,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.14,0:23:20.48,Default,,0,0,0,,Үш екі бір ату!
