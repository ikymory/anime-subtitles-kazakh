Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.08,0:00:07.17,Default,,0,0,0,,wbba.Әлемдік лига!
Dialogue: 0,0:00:07.67,0:00:13.01,Default,,0,0,0,,Әр лигада жеңіске жеткен клубтар әлемнің шыңына шығу үшін күреседі.
Dialogue: 0,0:00:13.09,0:00:16.51,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз!
Dialogue: 0,0:00:17.05,0:00:20.31,Default,,0,0,0,,Жауынгерлеріңді өртеп, шектен шығып кет!
Dialogue: 0,0:00:21.06,0:00:25.02,Default,,0,0,0,,Жандардың қызу шайқасы әлемді толғандырады
Dialogue: 0,0:00:25.77,0:00:29.36,Default,,0,0,0,,Даңқты алатын сенсің!
Dialogue: 0,0:00:32.15,0:00:35.16,Default,,0,0,0,,Шака Бразилия Риосына қосылады
Dialogue: 0,0:00:35.24,0:00:37.41,Default,,0,0,0,,Біз 100 адамдық шайқас өткізуді шештік.
Dialogue: 0,0:00:38.41,0:00:40.20,Default,,0,0,0,,100 адам шайқасы?
Dialogue: 0,0:00:40.41,0:00:43.25,Default,,0,0,0,,Қосылу тестінде? Бұл өтірік емес пе?
Dialogue: 0,0:00:43.62,0:00:47.42,Default,,0,0,0,,Бұған дейін жеткен жалғыз адам – Лувей.
Dialogue: 0,0:00:47.67,0:00:50.34,Default,,0,0,0,,100 адам... дұрыс
Dialogue: 0,0:00:50.42,0:00:52.88,Default,,0,0,0,,Мен оны сынап көргім келді.
Dialogue: 0,0:00:54.67,0:00:59.64,Default,,0,0,0,,Мен осы Зиг Экскалибурға жанымды салдым!
Dialogue: 0,0:01:00.68,0:01:02.97,Default,,0,0,0,,Келесі - соңғы шайқас.
Dialogue: 0,0:01:03.64,0:01:07.52,Default,,0,0,0,,Ақтық ойында осы үш адамға қарсы күресу керек.
Dialogue: 0,0:01:10.15,0:01:13.44,Default,,0,0,0,,Digital Sword Launcher Маған ұнайды!
Dialogue: 0,0:01:25.37,0:01:29.79,Default,,0,0,0,,Үш есе әсер ету!
Dialogue: 0,0:01:34.55,0:01:37.47,Default,,0,0,0,,Sieg Excalibur Burst Finish
Dialogue: 0,0:01:38.18,0:01:41.97,Default,,0,0,0,,Жанып тұрған Кайза храмындағы 100 адамдық шайқасты жеңіңіз!
Dialogue: 0,0:01:43.10,0:01:46.10,Default,,0,0,0,,Ал Шака қосылған Бразилия Риосы...
Dialogue: 0,0:01:46.56,0:01:49.90,Default,,0,0,0,,Дүниежүзілік лиганың екінші кезеңінен тура ойындарда өтті!
Dialogue: 0,0:01:51.15,0:01:52.36,Default,,0,0,0,,Өте керемет~
Dialogue: 0,0:01:52.61,0:01:55.24,Default,,0,0,0,,А... анау ұшырғыш
Dialogue: 0,0:01:56.03,0:01:57.95,Default,,0,0,0,,Мынау... сол жігіт пе?
Dialogue: 0,0:01:58.45,0:02:01.07,Default,,0,0,0,,♪~
Dialogue: 0,0:02:01.16,0:02:03.66,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:03.74,0:02:06.25,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:06.33,0:02:08.67,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:08.75,0:02:11.25,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:11.33,0:02:12.84,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:02:12.92,0:02:17.13,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:18.09,0:02:22.85,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:22.93,0:02:27.89,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:28.02,0:02:32.69,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:32.77,0:02:37.69,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:37.78,0:02:42.66,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:42.74,0:02:47.62,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:47.70,0:02:51.08,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:51.17,0:02:52.71,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:52.79,0:02:55.17,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:55.25,0:02:57.67,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:57.76,0:03:00.01,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:03:00.09,0:03:01.26,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:03:01.34,0:03:02.76,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:03:02.84,0:03:05.31,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:03:05.39,0:03:11.44,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:03:11.52,0:03:15.90,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:15.98,0:03:18.82,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:18.90,0:03:21.07,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:21.15,0:03:23.24,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:23.24,0:03:23.70,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:23.24,0:03:23.70,Default,,0,0,0,,~♪
Dialogue: 0,0:03:23.70,0:03:23.78,Default,,0,0,0,,~♪
Dialogue: 0,0:03:23.78,0:03:27.37,Default,,0,0,0,,~♪
Dialogue: 0,0:03:23.78,0:03:27.37,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:27.37,0:03:27.91,Default,,0,0,0,,~♪
Dialogue: 0,0:03:29.25,0:03:31.79,Default,,0,0,0,,Жарылыс! Құдай қайта жүкте!
Dialogue: 0,0:03:33.67,0:03:36.38,Default,,0,0,0,,Екінші раундтағы қарсылас –
Dialogue: 0,0:03:36.46,0:03:38.84,Default,,0,0,0,,Ғазем Мадармен бірге корольдіктер
Dialogue: 0,0:03:38.92,0:03:42.51,Default,,0,0,0,,Жаңа жаттықтырушылардың келуімен деңгей айтарлықтай жақсарған сияқты.
Dialogue: 0,0:03:42.97,0:03:45.26,Default,,0,0,0,,Жаңа жаттықтырушы...
Dialogue: 0,0:03:45.35,0:03:49.39,Default,,0,0,0,,Жарайды, біз де бүгін Муген Бэй стадионында арнайы жаттығудан өтеміз!
Dialogue: 0,0:03:54.44,0:03:55.65,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:03:55.81,0:03:58.40,Default,,0,0,0,,Ах! Эй Зоро!
Dialogue: 0,0:03:58.48,0:04:01.99,Default,,0,0,0,,Параметр деңгейі тым жоғары емес пе? Мен бас тартпаймын.
Dialogue: 0,0:04:02.24,0:04:05.20,Default,,0,0,0,,Менің ату қабілетім жақсарған жоқ.
Dialogue: 0,0:04:05.28,0:04:06.16,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:06.70,0:04:09.70,Default,,0,0,0,,Дұрыс, ату қабілетін жақсарту керек.
Dialogue: 0,0:04:09.79,0:04:13.50,Default,,0,0,0,,Осы деңгейдегі орталықты бір соққымен басып алу үшін арнайы дайындық!
Dialogue: 0,0:04:14.25,0:04:17.71,Default,,0,0,0,,Оши! Мен шыдамдылығымды шегіне дейін итеремін!
Dialogue: 0,0:04:20.59,0:04:21.76,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:04:21.88,0:04:22.80,Default,,0,0,0,,А...
Dialogue: 0,0:04:24.05,0:04:27.18,Default,,0,0,0,,Шаса Сіз бірден орталыққа ұмтылмайсыз.
Dialogue: 0,0:04:27.26,0:04:29.51,Default,,0,0,0,,Диагональ бойынша түсіріп көріңіз
Dialogue: 0,0:04:29.68,0:04:30.81,Default,,0,0,0,,Диагональды соғу арқылы?
Dialogue: 0,0:04:31.27,0:04:33.14,Default,,0,0,0,,Шексіз шығанақты соғудан аулақ болыңыз
Dialogue: 0,0:04:33.23,0:04:36.35,Default,,0,0,0,,Оны айналдырып жаттығу жасайық.
Dialogue: 0,0:04:37.06,0:04:39.90,Default,,0,0,0,,Мен оны төзімділік шайқасына қалай жеткізе аламын?
Dialogue: 0,0:04:39.98,0:04:42.78,Default,,0,0,0,,Бұл келесі матчтың қиындығы!
Dialogue: 0,0:04:42.90,0:04:44.99,Default,,0,0,0,,Иә! …сурет?
Dialogue: 0,0:04:45.41,0:04:50.49,Default,,0,0,0,,Не? Сіз келесі Royals ойынының мүшесісіз бе?
Dialogue: 0,0:04:50.58,0:04:52.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:52.54,0:04:54.25,Default,,0,0,0,,Ата, мен ше?
Dialogue: 0,0:04:55.00,0:04:56.25,Default,,0,0,0,,Ах Балто
Dialogue: 0,0:04:56.33,0:05:00.30,Default,,0,0,0,,Сіз жоғарыдағы жаттығу полигонында арнайы ату жаттығуларын жасап жатырсыз.
Dialogue: 0,0:05:00.38,0:05:02.88,Default,,0,0,0,,Иә? Бәрі осы ма?
Dialogue: 0,0:05:02.96,0:05:05.43,Default,,0,0,0,,Басқалар сияқты егжей-тегжейлі болыңыз.
Dialogue: 0,0:05:05.80,0:05:08.89,Default,,0,0,0,,Құдайды қайта жүктеуді қалауыңыз бойынша қолжетімді етейік.
Dialogue: 0,0:05:09.39,0:05:10.81,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:05:19.52,0:05:22.40,Default,,0,0,0,,Ах! Мен ұрып-соқтым
Dialogue: 0,0:05:22.78,0:05:24.94,Default,,0,0,0,,Жарайды, Риксон, тағы бір рет!
Dialogue: 0,0:05:25.28,0:05:27.74,Default,,0,0,0,,Куу! жарып кете алмады
Dialogue: 0,0:05:28.11,0:05:29.53,Default,,0,0,0,,Фофофу
Dialogue: 0,0:05:29.62,0:05:30.70,Default,,0,0,0,,(ату дыбысы)
Dialogue: 0,0:05:32.95,0:05:35.20,Default,,0,0,0,,Жүр! Құдай қайта жүкте!
Dialogue: 0,0:05:35.91,0:05:38.17,Default,,0,0,0,,(Үдемелі айналу дыбысы)
Dialogue: 0,0:05:45.38,0:05:48.30,Default,,0,0,0,,Иә? Жарайды, тағы бір рет!
Dialogue: 0,0:05:49.05,0:05:50.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:50.09,0:05:52.35,Default,,0,0,0,,Уау! (басылған дыбыс)
Dialogue: 0,0:05:53.14,0:05:57.02,Default,,0,0,0,,Құдайды қайта жүктеуді меңгере алмайтын сияқтысыз.
Dialogue: 0,0:05:57.39,0:05:58.85,Default,,0,0,0,,Мен жасап көремін.
Dialogue: 0,0:05:59.31,0:06:00.61,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:06:00.69,0:06:02.32,Default,,0,0,0,,Сәлем Риксон.
Dialogue: 0,0:06:02.77,0:06:03.73,Default,,0,0,0,,Иә
Dialogue: 0,0:06:05.90,0:06:09.99,Default,,0,0,0,,Балто допты соққаннан кейін, атпас бұрын 10-ға дейін сана.
Dialogue: 0,0:06:10.28,0:06:11.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:11.74,0:06:13.79,Default,,0,0,0,,10 секундтан кейін?
Dialogue: 0,0:06:14.20,0:06:15.95,Default,,0,0,0,,Иә?Не айтқың келеді?
Dialogue: 0,0:06:16.33,0:06:20.42,Default,,0,0,0,,Foofowfoof Алдымен жасап көрейік.
Dialogue: 0,0:06:21.17,0:06:22.96,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:06:23.46,0:06:26.26,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:26.96,0:06:28.93,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:37.14,0:06:39.06,Default,,0,0,0,,Жарайды, енді Хиксон!
Dialogue: 0,0:06:39.39,0:06:41.52,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:48.44,0:06:51.32,Default,,0,0,0,,Ах! Мен жеңілдім!
Dialogue: 0,0:06:51.41,0:06:55.24,Default,,0,0,0,,Әрине, өте кеш түсірді!
Dialogue: 0,0:06:57.37,0:07:00.54,Default,,0,0,0,,Риксон Қайтадан жасайық, келесі жолы жеңеміз!
Dialogue: 0,0:07:00.62,0:07:01.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:03.13,0:07:06.63,Default,,0,0,0,,Зоро, сіз шынымен қызықты нәрселер туралы ойлайсыз.
Dialogue: 0,0:07:07.21,0:07:09.01,Default,,0,0,0,,Фофофу
Dialogue: 0,0:07:11.59,0:07:16.51,Default,,0,0,0,,Маған қаттырақ ату керек. Жарайды, тағы бір рет!
Dialogue: 0,0:07:16.64,0:07:17.68,Default,,0,0,0,,Чи…
Dialogue: 0,0:07:18.22,0:07:21.64,Default,,0,0,0,,Жеңіске жетсем де, аздап ауырған сияқты, солай емес пе?
Dialogue: 0,0:07:21.73,0:07:22.94,Default,,0,0,0,,Ах... хмм...
Dialogue: 0,0:07:23.40,0:07:27.07,Default,,0,0,0,,Егер сіздің ойыңызда бір нәрсе болса, оны дауыстап және өз көзқарасыңызбен айтыңыз.
Dialogue: 0,0:07:27.15,0:07:29.44,Default,,0,0,0,,Байға сезімімді жеткізе алмаймын.
Dialogue: 0,0:07:29.69,0:07:30.78,Default,,0,0,0,,Ах
Dialogue: 0,0:07:30.95,0:07:34.57,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:07:34.95,0:07:38.37,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:07:39.29,0:07:40.50,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,0:07:40.71,0:07:42.17,Default,,0,0,0,,Хиксон стенді
Dialogue: 0,0:07:43.58,0:07:47.09,Default,,0,0,0,,Осындай масқара жеңілістен кейін ештеңе сезінбейсіз бе?
Dialogue: 0,0:07:48.38,0:07:49.34,Default,,0,0,0,,А...
Dialogue: 0,0:07:50.05,0:07:51.09,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:07:51.92,0:07:53.97,Default,,0,0,0,,Енді ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:07:54.76,0:07:55.85,Default,,0,0,0,,Қарт…
Dialogue: 0,0:07:57.18,0:07:58.56,Default,,0,0,0,,Қазіргідей...
Dialogue: 0,0:07:58.64,0:08:01.56,Default,,0,0,0,,Мен Крэй кланының басшылығын мұра ете алмаймын.
Dialogue: 0,0:08:02.73,0:08:04.69,Default,,0,0,0,,Бұл қосқышты ешқашан көтермеңіз.
Dialogue: 0,0:08:05.19,0:08:06.65,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:08:07.19,0:08:09.69,Default,,0,0,0,,Аа уф... уф...
Dialogue: 0,0:08:11.19,0:08:12.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:14.61,0:08:17.62,Default,,0,0,0,,Бұл дәл сол кездегідей!
Dialogue: 0,0:08:17.99,0:08:20.16,Default,,0,0,0,,Жарайды, Риксон, тағы бір рет.
Dialogue: 0,0:08:22.16,0:08:23.21,Default,,0,0,0,,Хмм!
Dialogue: 0,0:08:25.50,0:08:28.29,Default,,0,0,0,,Бұл дайын жиынтық!
Dialogue: 0,0:08:28.59,0:08:31.63,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:32.51,0:08:34.72,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:35.68,0:08:36.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:38.80,0:08:40.47,Default,,0,0,0,,Олар бір уақытта соқты!
Dialogue: 0,0:08:40.89,0:08:42.68,Default,,0,0,0,,Жарайды, Валькириді жең!
Dialogue: 0,0:08:47.31,0:08:49.94,Default,,0,0,0,,Фуфу~ Мен мұны істеймін
Dialogue: 0,0:08:50.44,0:08:52.44,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:08:56.32,0:08:57.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:01.70,0:09:04.46,Default,,0,0,0,,Хиксон Әдеттегіден өзгеше
Dialogue: 0,0:09:04.54,0:09:06.58,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:09:06.67,0:09:07.96,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:09:08.58,0:09:10.00,Default,,0,0,0,,Бұл қазір керемет!
Dialogue: 0,0:09:11.42,0:09:13.67,Default,,0,0,0,,Балто Тағы бір рет!
Dialogue: 0,0:09:14.30,0:09:17.22,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:17.39,0:09:19.64,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:21.85,0:09:24.56,Default,,0,0,0,,Шық! Құдай қайта жүкте!
Dialogue: 0,0:09:24.64,0:09:26.60,Default,,0,0,0,,(Үдемелі айналу дыбысы)
Dialogue: 0,0:09:27.60,0:09:29.11,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:09:29.77,0:09:32.90,Default,,0,0,0,,Иә! Құдай қайта жүкте!
Dialogue: 0,0:09:33.07,0:09:36.45,Default,,0,0,0,,Қарғыс атсын... Тағы да, Балто!
Dialogue: 0,0:09:38.16,0:09:41.91,Default,,0,0,0,,Екі күрескерді шығарып, бірге өссін.
Dialogue: 0,0:09:41.99,0:09:43.45,Default,,0,0,0,,Күтілгендей, Зоро
Dialogue: 0,0:09:43.54,0:09:46.83,Default,,0,0,0,,Фуфу, жасайық, мен
Dialogue: 0,0:09:48.25,0:09:51.09,Default,,0,0,0,,(Бір-бірімен ұрысқан дауыстар)
Dialogue: 0,0:09:51.59,0:09:53.67,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:09:53.75,0:09:57.43,Default,,0,0,0,,Иә, жақсы жұмыс, иә, жақсы жұмыс.
Dialogue: 0,0:09:58.13,0:10:00.18,Default,,0,0,0,,Иә, жақсы жұмыс.
Dialogue: 0,0:10:00.51,0:10:04.14,Default,,0,0,0,,Иван, сенен күтетінім осы
Dialogue: 0,0:10:04.22,0:10:07.02,Default,,0,0,0,,Ол менеджер емес, жаттықтырушы.
Dialogue: 0,0:10:07.10,0:10:09.23,Default,,0,0,0,,А... Иә, сонда.
Dialogue: 0,0:10:10.35,0:10:11.31,Default,,0,0,0,,Ах
Dialogue: 0,0:10:16.82,0:10:18.78,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:22.37,0:10:25.54,Default,,0,0,0,,Менің Ғазем туралы түсінік бар.
Dialogue: 0,0:10:26.00,0:10:27.16,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:27.25,0:10:29.54,Default,,0,0,0,,Ғазем! Бір сәт осында кел
Dialogue: 0,0:10:34.59,0:10:37.09,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:10:40.59,0:10:43.68,Default,,0,0,0,,Уау, бұл керемет Кумичо
Dialogue: 0,0:10:44.01,0:10:46.14,Default,,0,0,0,,Уау, күшті көрінеді.
Dialogue: 0,0:10:46.72,0:10:48.98,Default,,0,0,0,,Әй, бұл қорқынышты.
Dialogue: 0,0:10:51.90,0:10:53.15,Default,,0,0,0,,Не?
Dialogue: 0,0:10:53.44,0:10:55.36,Default,,0,0,0,,Баа!
Dialogue: 0,0:10:55.44,0:10:57.61,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,0:10:57.69,0:11:01.32,Default,,0,0,0,,Ахахахха, керемет емес пе?
Dialogue: 0,0:11:01.70,0:11:03.91,Default,,0,0,0,,Бұл не, Куза?
Dialogue: 0,0:11:03.99,0:11:06.16,Default,,0,0,0,,Ммм, дәміңіз нашар!
Dialogue: 0,0:11:07.04,0:11:10.00,Default,,0,0,0,,Біреудің бақшасына келіп, шу етесің.
Dialogue: 0,0:11:12.67,0:11:13.79,Default,,0,0,0,,Газем…
Dialogue: 0,0:11:14.34,0:11:15.46,Default,,0,0,0,,Cisco!
Dialogue: 0,0:11:20.38,0:11:21.72,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:11:21.80,0:11:24.30,Default,,0,0,0,,Сіз әлі де қатал емессіз бе? Бұл тамаша.
Dialogue: 0,0:11:24.72,0:11:26.31,Default,,0,0,0,,Мен оны сізге қайтарамын.
Dialogue: 0,0:11:26.68,0:11:28.18,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:11:29.35,0:11:32.06,Default,,0,0,0,,Бұл оңай болмайды деп ойлаймын.
Dialogue: 0,0:11:33.98,0:11:35.31,Default,,0,0,0,,Әй, Иван!
Dialogue: 0,0:11:35.40,0:11:36.61,Default,,0,0,0,,Бұл Иван!
Dialogue: 0,0:11:36.98,0:11:37.98,Default,,0,0,0,,Иван!
Dialogue: 0,0:11:38.23,0:11:40.36,Default,,0,0,0,,Иван, қалайсың?
Dialogue: 0,0:11:40.44,0:11:42.95,Default,,0,0,0,,Иә, бәрі жақсы сияқты.
Dialogue: 0,0:11:43.36,0:11:47.16,Default,,0,0,0,,Бұл тосынсый болды ма? Жаңа жаттықтырушы
Dialogue: 0,0:11:47.24,0:11:51.25,Default,,0,0,0,,Хехе, Б.С.Солмен болатын шайқасты асыға күттім.
Dialogue: 0,0:11:51.54,0:11:55.29,Default,,0,0,0,,Ха! Мен Blader-ден бас тарттым және жаттықтырушы болдым, жеңіліске ұшырадым.
Dialogue: 0,0:11:55.38,0:11:57.13,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:11:57.38,0:12:01.38,Default,,0,0,0,,Бұл ит сізді тістеп алса, өте ауыр болар еді, Cisco.
Dialogue: 0,0:12:01.47,0:12:03.93,Default,,0,0,0,,Бүгінгі шайқаста біз жеңеміз
Dialogue: 0,0:12:04.01,0:12:04.89,Default,,0,0,0,,Тс!
Dialogue: 0,0:12:07.35,0:12:09.68,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:12:09.77,0:12:14.94,Default,,0,0,0,,Әлемдік Лига финалдық турнирінің екінші кезеңі басталады!
Dialogue: 0,0:12:15.02,0:12:16.36,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:16.81,0:12:21.03,Default,,0,0,0,,BC Sol бірінші ойынынан Cisco Carlyle!
Dialogue: 0,0:12:21.11,0:12:23.86,Default,,0,0,0,,Ал корольдерден: Ғазем Мадар!
Dialogue: 0,0:12:24.36,0:12:28.16,Default,,0,0,0,,Еуропа лигасында екеуі 1 жеңіс пен 1 ​​жеңіліске ие болды.
Dialogue: 0,0:12:28.66,0:12:29.83,Default,,0,0,0,,Ғазем!
Dialogue: 0,0:12:33.25,0:12:36.71,Default,,0,0,0,,Орындық мүшенің жақтауын жаттықтырушы ретінде пайдалану
Dialogue: 0,0:12:37.54,0:12:39.96,Default,,0,0,0,,Құлақшы ретінде де танылды.
Dialogue: 0,0:12:40.05,0:12:42.76,Default,,0,0,0,,Бірінші ойын Бірінші шайқас
Dialogue: 0,0:12:43.09,0:12:47.26,Default,,0,0,0,,Үлкендігімен ғана мақтанатын шығанақта, тағы да қатты алайық.
Dialogue: 0,0:12:47.68,0:12:49.72,Default,,0,0,0,,Мен оны күшпен тойтарамын.
Dialogue: 0,0:12:51.35,0:12:53.23,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:12:53.73,0:12:56.56,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:56.94,0:12:59.15,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:59.61,0:13:00.69,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:13:00.78,0:13:04.78,Default,,0,0,0,,Ой! Гаруда ән айтты!
Dialogue: 0,0:13:04.86,0:13:07.11,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:13:07.49,0:13:10.87,Default,,0,0,0,,Иә? Гаруда әдеттегіден ерекше емес пе?
Dialogue: 0,0:13:10.95,0:13:14.83,Default,,0,0,0,,Бұл кадр. Гаруда жақтауды алып жатыр.
Dialogue: 0,0:13:21.21,0:13:23.34,Default,,0,0,0,,Ой, бұл сирек.
Dialogue: 0,0:13:23.42,0:13:26.22,Default,,0,0,0,,Гаруда жақтауды алып жатыр.
Dialogue: 0,0:13:29.97,0:13:33.18,Default,,0,0,0,,Цк, бұл оғаш қимылдың несі?
Dialogue: 0,0:13:33.47,0:13:36.89,Default,,0,0,0,,Гаруда! Шайтанға шабуыл жасап, оны тастаңыз
Dialogue: 0,0:13:36.98,0:13:39.44,Default,,0,0,0,,Бұл беру мен алудың қайталануы!
Dialogue: 0,0:13:39.90,0:13:43.15,Default,,0,0,0,,Сәлем! Сондықтан мені жеңе аламын деп ойлайсың ба?
Dialogue: 0,0:13:45.28,0:13:47.03,Default,,0,0,0,,Бұл жігіт дәмді екен.
Dialogue: 0,0:13:47.11,0:13:48.82,Default,,0,0,0,,Сіз алаңсыз бірдеңе айтып тұрсыз ба?
Dialogue: 0,0:13:49.20,0:13:52.74,Default,,0,0,0,,О! Әдеттегідей қатты кел!
Dialogue: 0,0:13:53.58,0:13:55.54,Default,,0,0,0,,Әй, бірдеңе айт!
Dialogue: 0,0:13:56.46,0:13:57.46,Default,,0,0,0,,Tsk
Dialogue: 0,0:13:57.92,0:13:59.83,Default,,0,0,0,,Сонда бұл циклондық цикл!
Dialogue: 0,0:14:02.00,0:14:03.38,Default,,0,0,0,,(роликтің жерге тиген дыбысы)
Dialogue: 0,0:14:04.76,0:14:08.93,Default,,0,0,0,,Эй, сенің күшің көп, солай ма? Кәне!
Dialogue: 0,0:14:09.34,0:14:11.60,Default,,0,0,0,,Жарайды, жарайды, Ғазем.
Dialogue: 0,0:14:13.56,0:14:15.64,Default,,0,0,0,,Егер екінші тарап Cisco болса...
Dialogue: 0,0:14:16.18,0:14:18.89,Default,,0,0,0,,Неліктен жақтауды шешіп, түсірмеске?
Dialogue: 0,0:14:19.52,0:14:20.86,Default,,0,0,0,,Қуат жоқ
Dialogue: 0,0:14:21.52,0:14:24.73,Default,,0,0,0,,Гаруданың күші жай ғана күш емес, солай ма?
Dialogue: 0,0:14:25.32,0:14:28.57,Default,,0,0,0,,Өйткені оның керемет қанаттары бар.
Dialogue: 0,0:14:31.57,0:14:35.45,Default,,0,0,0,,Уау! Шайтанның айналуы әлсіреді.
Dialogue: 0,0:14:35.54,0:14:37.08,Default,,0,0,0,,Э? Ой, тұра тұр—ол не?
Dialogue: 0,0:14:37.16,0:14:38.71,Default,,0,0,0,,Шайтан тоқтағалы тұр
Dialogue: 0,0:14:38.79,0:14:39.96,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:14:46.55,0:14:48.26,Default,,0,0,0,,Жүр!
Dialogue: 0,0:14:49.26,0:14:50.93,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:14:52.14,0:14:53.22,Default,,0,0,0,,Сатып алуға алданған адам – нағыз ақымақ
Dialogue: 0,0:14:53.68,0:14:56.35,Default,,0,0,0,,Максималды Garuda Burst Finish
Dialogue: 0,0:14:56.89,0:15:01.10,Default,,0,0,0,,Корольдік клуб бірінші ойында 2-0 есебімен жеңіске жетті.
Dialogue: 0,0:15:01.19,0:15:03.61,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:04.61,0:15:05.98,Default,,0,0,0,,Газем
Dialogue: 0,0:15:08.94,0:15:11.95,Default,,0,0,0,,Сен... сен сондай қызықсыз, сен ол жігіт пе едің?
Dialogue: 0,0:15:14.66,0:15:17.41,Default,,0,0,0,,Уу-о-о-о-о-о-о-о-о-о-о-о-о-о-о-о-о-о-о-о
Dialogue: 0,0:15:18.00,0:15:20.16,Default,,0,0,0,,Иван, сіздің стратегияңыз жеңді.
Dialogue: 0,0:15:20.37,0:15:21.96,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:15:22.46,0:15:25.25,Default,,0,0,0,,Я, бұл қызық шайқас емес.
Dialogue: 0,0:15:25.34,0:15:27.00,Default,,0,0,0,,Мен өзімді мүлде жоғалтқандай сезінбеймін.
Dialogue: 0,0:15:27.09,0:15:28.71,Default,,0,0,0,,Мен дұрыс ұтылдым.
Dialogue: 0,0:15:28.80,0:15:29.92,Default,,0,0,0,,Шулы!
Dialogue: 0,0:15:30.42,0:15:32.01,Default,,0,0,0,,Екінші ойын
Dialogue: 0,0:15:32.09,0:15:35.55,Default,,0,0,0,,Корольдіктер капитан Артур Лоуренсті таныстырады
Dialogue: 0,0:15:36.14,0:15:39.73,Default,,0,0,0,,BC Сольге қарсы Куза Акерман!
Dialogue: 0,0:15:40.27,0:15:42.48,Default,,0,0,0,,Екінші ойын Бірінші шайқас
Dialogue: 0,0:15:42.98,0:15:43.90,Default,,0,0,0,,Куза
Dialogue: 0,0:15:43.98,0:15:47.19,Default,,0,0,0,,Мен сіздің супер шабуыл режимінде келе жатқаныңызды болжаймын.
Dialogue: 0,0:15:47.40,0:15:49.23,Default,,0,0,0,,Иә? (Артур) Иә.
Dialogue: 0,0:15:49.74,0:15:51.24,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:15:51.70,0:15:54.53,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:54.62,0:15:57.12,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:59.66,0:16:03.04,Default,,0,0,0,,Chronos супер шабуыл режимі!
Dialogue: 0,0:16:05.00,0:16:07.80,Default,,0,0,0,,Уау! Кронос үлкен дуалмен тойтарыс берді.
Dialogue: 0,0:16:08.05,0:16:09.05,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:16:09.13,0:16:11.59,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:16:11.92,0:16:13.84,Default,,0,0,0,,Тар арқанмен сүңгу
Dialogue: 0,0:16:16.22,0:16:17.81,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:16:17.89,0:16:18.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:19.35,0:16:22.06,Default,,0,0,0,,Alter Chronos Burst Finish
Dialogue: 0,0:16:22.14,0:16:26.11,Default,,0,0,0,,ВС Сол екінші ойында 2-0 есебімен жеңіске жетті.
Dialogue: 0,0:16:27.11,0:16:28.98,Default,,0,0,0,,Бұл бір жеңіс пен бір жеңіліс.
Dialogue: 0,0:16:29.19,0:16:30.61,Default,,0,0,0,,Келесі - Шаса.
Dialogue: 0,0:16:30.99,0:16:31.86,Default,,0,0,0,,Иә
Dialogue: 0,0:16:32.32,0:16:35.07,Default,,0,0,0,,Енді шайқас аяқталды, үшінші ойын
Dialogue: 0,0:16:35.16,0:16:38.08,Default,,0,0,0,,BC Сольден, Шаса Гуттен!
Dialogue: 0,0:16:38.16,0:16:41.08,Default,,0,0,0,,Корольдіктерге қарсы: Джефф Петерсон
Dialogue: 0,0:16:41.50,0:16:44.71,Default,,0,0,0,,Бұл бірінші рет келгендердің екеуінің кездесуі.
Dialogue: 0,0:16:44.79,0:16:46.83,Default,,0,0,0,,Мм, жаңа!
Dialogue: 0,0:16:47.58,0:16:50.38,Default,,0,0,0,,Мен бұл мүмкіндікті барынша пайдалануым керек.
Dialogue: 0,0:16:51.71,0:16:53.51,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:16:54.01,0:16:55.38,Default,,0,0,0,,А...
Dialogue: 0,0:16:55.47,0:16:59.51,Default,,0,0,0,,Шаса! Эй, қобалжыма!
Dialogue: 0,0:16:59.60,0:17:02.52,Default,,0,0,0,,Айтпа! Неліктен?
Dialogue: 0,0:17:02.60,0:17:04.35,Default,,0,0,0,,Сіз үнемі қобалжисыз, солай емес пе?
Dialogue: 0,0:17:05.27,0:17:07.02,Default,,0,0,0,,Рахмет Балто
Dialogue: 0,0:17:07.86,0:17:10.19,Default,,0,0,0,,Үшінші ойын Бірінші шайқас
Dialogue: 0,0:17:10.57,0:17:12.15,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:12.65,0:17:15.40,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:15.74,0:17:17.95,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:19.70,0:17:21.62,Default,,0,0,0,,Шаса Гуттен
Dialogue: 0,0:17:21.70,0:17:24.79,Default,,0,0,0,,Таза шұңқырмен периметр бойынша айнала бастады
Dialogue: 0,0:17:24.87,0:17:27.62,Default,,0,0,0,,Джефф Петерсон шабуыл жасайды...
Dialogue: 0,0:17:27.71,0:17:29.38,Default,,0,0,0,,Сізді айналып өтіп жатырсыз!
Dialogue: 0,0:17:29.50,0:17:30.92,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:31.30,0:17:32.96,Default,,0,0,0,,Өтінемін, осылай қал!
Dialogue: 0,0:17:33.30,0:17:35.34,Default,,0,0,0,,Барыңыз, әпке!
Dialogue: 0,0:17:35.92,0:17:39.68,Default,,0,0,0,,Мен шыдамды түрі Шасаның орталықты алуға келмейтініне сене алмаймын.
Dialogue: 0,0:17:39.76,0:17:41.18,Default,,0,0,0,,Фофофу
Dialogue: 0,0:17:41.26,0:17:43.89,Default,,0,0,0,,Бұл жолы біздің стратегия жеңіске жетеді.
Dialogue: 0,0:17:44.02,0:17:47.77,Default,,0,0,0,,Мен де беделді BC Sol компаниясының пышақшысымын!
Dialogue: 0,0:17:48.23,0:17:49.73,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:17:49.86,0:17:50.69,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:17:51.11,0:17:52.90,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:17:52.98,0:17:56.07,Default,,0,0,0,,Шаса Гуттен Сіз жеңдіңіз!
Dialogue: 0,0:17:56.49,0:17:58.49,Default,,0,0,0,,Үлкен апа күшті!
Dialogue: 0,0:17:58.82,0:18:03.37,Default,,0,0,0,,Енді ойын саны 2-ден 1-ге дейін. BC Sol бір қадам алда!
Dialogue: 0,0:18:03.79,0:18:05.75,Default,,0,0,0,,Ғазем мен оны сұрадым.
Dialogue: 0,0:18:06.96,0:18:07.96,Default,,0,0,0,,Иван
Dialogue: 0,0:18:08.04,0:18:09.37,Default,,0,0,0,,Оны ұмытып қалдың ба?
Dialogue: 0,0:18:09.63,0:18:12.88,Default,,0,0,0,,Келесі шайқас Мен өз жолыммен күрескім келеді
Dialogue: 0,0:18:15.46,0:18:17.09,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:18:18.43,0:18:20.89,Default,,0,0,0,,Енді төртінші ойыннан бастап...
Dialogue: 0,0:18:20.97,0:18:24.35,Default,,0,0,0,,Кез келген тіркелген blader қатыса алады!
Dialogue: 0,0:18:24.85,0:18:27.85,Default,,0,0,0,,Корольдіктер әрине Газем Мадар!
Dialogue: 0,0:18:28.19,0:18:30.06,Default,,0,0,0,,BC сол үшін
Dialogue: 0,0:18:30.19,0:18:33.44,Default,,0,0,0,,Капитан Балт Аои пайда болады.
Dialogue: 0,0:18:34.11,0:18:37.32,Default,,0,0,0,,Ғазем Мен шынымен күшті болдым.
Dialogue: 0,0:18:37.78,0:18:40.82,Default,,0,0,0,,Қанша талпынсам да, бәрібір.
Dialogue: 0,0:18:43.74,0:18:47.04,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:18:47.12,0:18:49.71,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:18:49.79,0:18:51.92,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:18:52.00,0:18:53.04,Default,,0,0,0,,Не?
Dialogue: 0,0:18:53.63,0:18:55.34,Default,,0,0,0,,God Reboot – бұл-
Dialogue: 0,0:18:55.42,0:18:58.47,Default,,0,0,0,,Мен ешқашан жеңілмеймін деп қатты ойланып отырып
Dialogue: 0,0:18:58.55,0:19:00.34,Default,,0,0,0,,Атпасаң, шығара алмайсың.
Dialogue: 0,0:19:00.80,0:19:02.55,Default,,0,0,0,,«Мен міндетті түрде жеңілмеймін»?
Dialogue: 0,0:19:02.93,0:19:03.80,Default,,0,0,0,,О
Dialogue: 0,0:19:03.89,0:19:07.56,Default,,0,0,0,,Риксонның шын жұдырықпен ұрғанын қараңыз.
Dialogue: 0,0:19:11.77,0:19:13.44,Default,,0,0,0,,Балто!
Dialogue: 0,0:19:20.32,0:19:23.99,Default,,0,0,0,,Жеңіс! !
Dialogue: 0,0:19:24.95,0:19:26.29,Default,,0,0,0,,Хиксон…
Dialogue: 0,0:19:28.91,0:19:31.29,Default,,0,0,0,,А, мен жеңемін.
Dialogue: 0,0:19:32.08,0:19:34.67,Default,,0,0,0,,Төртінші ойын Бірінші шайқас
Dialogue: 0,0:19:35.75,0:19:37.38,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:37.84,0:19:40.51,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:41.05,0:19:43.43,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:45.93,0:19:49.77,Default,,0,0,0,,Ой, Гаруда, бұл жолы кадрды алып тастамадым.
Dialogue: 0,0:19:50.10,0:19:51.19,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:19:51.48,0:19:53.60,Default,,0,0,0,,Екеуі де! қатты соқты
Dialogue: 0,0:19:53.90,0:19:56.11,Default,,0,0,0,,Valkyrie Rush атыс!
Dialogue: 0,0:19:56.61,0:19:59.15,Default,,0,0,0,,Валькири де үздіксіз шабуыл жасайды
Dialogue: 0,0:19:59.23,0:20:01.36,Default,,0,0,0,,Гаруда да оны қолға алып жатыр.
Dialogue: 0,0:20:01.45,0:20:02.86,Default,,0,0,0,,Міне!
Dialogue: 0,0:20:05.70,0:20:07.83,Default,,0,0,0,,Байланысты реактивті ату!
Dialogue: 0,0:20:09.91,0:20:12.16,Default,,0,0,0,,Бұл сізді шынымен қызықтырады ма?
Dialogue: 0,0:20:13.21,0:20:14.71,Default,,0,0,0,,Уууу!
Dialogue: 0,0:20:15.17,0:20:16.71,Default,,0,0,0,,(көтерілген жалын дыбысы)
Dialogue: 0,0:20:17.75,0:20:19.50,Default,,0,0,0,,(Қасиетті құстың сайрауы)
Dialogue: 0,0:20:22.17,0:20:24.76,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:20:29.14,0:20:31.02,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:20:31.27,0:20:32.64,Default,,0,0,0,,Арх!
Dialogue: 0,0:20:32.73,0:20:35.19,Default,,0,0,0,,Валькирия! Құдай қайта жүкте!
Dialogue: 0,0:20:37.19,0:20:38.57,Default,,0,0,0,,(Үдемелі айналу дыбысы)
Dialogue: 0,0:20:42.74,0:20:43.90,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:20:43.99,0:20:46.66,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:20:46.95,0:20:49.16,Default,,0,0,0,,Тек жеңіңіз!
Dialogue: 0,0:20:51.45,0:20:53.12,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:54.25,0:20:55.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:56.25,0:20:58.54,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:58.88,0:21:00.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:00.46,0:21:02.26,Default,,0,0,0,,Жеңіс жеңді!
Dialogue: 0,0:21:02.34,0:21:03.55,Default,,0,0,0,,Ой...
Dialogue: 0,0:21:04.59,0:21:05.55,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:21:05.72,0:21:08.14,Default,,0,0,0,,Ооооооо!
Dialogue: 0,0:21:08.55,0:21:09.60,Default,,0,0,0,,Хиксон!
Dialogue: 0,0:21:09.68,0:21:13.77,Default,,0,0,0,,God Reboot тамаша шықты! Рақмет сізге!
Dialogue: 0,0:21:14.69,0:21:17.77,Default,,0,0,0,,Балто Келесі менің кезегім!
Dialogue: 0,0:21:18.31,0:21:21.23,Default,,0,0,0,,Міне! Мен BC Солды осылай көргім келді!
Dialogue: 0,0:21:21.69,0:21:23.53,Default,,0,0,0,,Фофофу
Dialogue: 0,0:21:23.61,0:21:25.11,Default,,0,0,0,,♬~
Dialogue: 0,0:21:25.20,0:21:26.24,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:21:28.53,0:21:30.16,Default,,0,0,0,,Мен мұны қайтадан жасағым келеді
Dialogue: 0,0:21:30.83,0:21:31.70,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:21:34.16,0:21:35.46,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:21:36.42,0:21:37.50,Default,,0,0,0,,Мен де!
Dialogue: 0,0:21:37.83,0:21:39.96,Default,,0,0,0,,...ttotototo!
Dialogue: 0,0:21:40.59,0:21:41.71,Default,,0,0,0,,Қарсылас – Sparking Killing Boy!
Dialogue: 0,0:21:41.80,0:21:42.88,Default,,0,0,0,,Ахар
Dialogue: 0,0:21:43.13,0:21:45.38,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:21:46.34,0:21:47.80,Default,,0,0,0,,Смоуки, кет мұнан!
Dialogue: 0,0:21:47.88,0:21:50.85,Default,,0,0,0,,Біз Б.С.Сол екінші айналымнан өттік.
Dialogue: 0,0:21:51.22,0:21:53.97,Default,,0,0,0,,Енді жартылай финал.
Dialogue: 0,0:21:55.85,0:21:58.31,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.40,0:22:01.82,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.90,0:22:04.65,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.74,0:22:06.95,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.03,0:22:10.57,Default,,0,0,0,,Токио шайқасы! Реал Риоға қарсы!
Dialogue: 0,0:22:10.66,0:22:14.29,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.37,0:22:16.12,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.20,0:22:17.96,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.04,0:22:19.79,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.88,0:22:21.46,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.54,0:22:23.55,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.63,0:22:26.01,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.09,0:22:29.01,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.09,0:22:32.76,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.85,0:22:36.48,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.56,0:22:38.27,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.35,0:22:41.52,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.61,0:22:43.90,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:43.98,0:22:47.53,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.61,0:22:50.99,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.07,0:22:53.16,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.24,0:22:54.91,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:54.99,0:22:58.41,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.50,0:23:00.42,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.50,0:23:03.50,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.59,0:23:05.80,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.88,0:23:09.80,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.88,0:23:13.47,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.55,0:23:17.06,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.14,0:23:20.48,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.56,0:23:22.10,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:20.56,0:23:22.10,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.10,0:23:22.19,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.19,0:23:24.94,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.19,0:23:24.94,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:24.94,0:23:25.44,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.36,0:23:30.86,Default,,0,0,0,,Ана Токонацу Ника! Мен жақында үйде боламын!
Dialogue: 0,0:23:31.57,0:23:34.32,Default,,0,0,0,,Вакия мен Шака Токиода шайқасады!
Dialogue: 0,0:23:34.57,0:23:38.12,Default,,0,0,0,,Джанго мен Стэн де соқтығысады. Сіз мұны жіберіп алмайсыз.
Dialogue: 0,0:23:38.20,0:23:41.29,Default,,0,0,0,,Инсуке, мен де сенімен танысқым келеді.
Dialogue: 0,0:23:41.46,0:23:43.75,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.83,0:23:46.75,Default,,0,0,0,,Токио шайқасы! Реал Риоға қарсы!
Dialogue: 0,0:23:46.84,0:23:50.17,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.67,0:23:57.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory