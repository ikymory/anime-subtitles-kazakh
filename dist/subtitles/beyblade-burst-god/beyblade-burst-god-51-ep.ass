Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:05.29,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.09,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.43,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.22,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.72,0:00:23.85,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.60,0:00:27.90,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.98,0:00:29.94,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:33.45,0:00:38.12,Default,,0,0,0,,God Bladers Cup финалы Мен Шумен күресіп жатырмын
Dialogue: 0,0:00:39.03,0:00:41.37,Default,,0,0,0,,Слеш реквиемі!
Dialogue: 0,0:00:42.12,0:00:43.91,Default,,0,0,0,,Құдай жарсын!
Dialogue: 0,0:00:46.04,0:00:47.88,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:00:53.09,0:00:54.47,Default,,0,0,0,,(Шығанақтың соғу дыбысы)
Dialogue: 0,0:00:54.55,0:00:55.51,Default,,0,0,0,,Ах
Dialogue: 0,0:00:58.64,0:00:59.68,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:01:00.01,0:01:03.18,Default,,0,0,0,,Спригган реквиемінің жарқырауы
Dialogue: 0,0:01:03.27,0:01:04.85,Default,,0,0,0,,2-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:01:08.52,0:01:09.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:13.44,0:01:16.07,Default,,0,0,0,,Жоғал, Барто Аои!
Dialogue: 0,0:01:19.45,0:01:22.12,Default,,0,0,0,,♪~
Dialogue: 0,0:01:22.20,0:01:24.70,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:24.79,0:01:26.96,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:27.04,0:01:29.08,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:29.79,0:01:31.75,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:32.21,0:01:33.88,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:33.96,0:01:38.13,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:39.05,0:01:43.81,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:43.89,0:01:48.77,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:48.85,0:01:53.65,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:53.73,0:01:58.53,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:01:58.70,0:02:03.62,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:03.70,0:02:08.83,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:08.92,0:02:12.04,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:12.13,0:02:13.50,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:13.59,0:02:16.17,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:16.26,0:02:18.51,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:18.59,0:02:20.68,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:20.76,0:02:22.10,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:22.18,0:02:23.64,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:23.72,0:02:26.18,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:26.27,0:02:32.48,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:32.56,0:02:36.69,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:36.78,0:02:39.57,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:39.65,0:02:41.61,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:42.28,0:02:44.12,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:44.70,0:02:48.00,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:50.46,0:02:52.92,Default,,0,0,0,,Балт Шуға қарсы!
Dialogue: 0,0:02:55.04,0:02:58.30,Default,,0,0,0,,Құдай Валькиридің жойылуынан аулақ болды!
Dialogue: 0,0:02:58.38,0:03:01.01,Default,,0,0,0,,Бірақ енді істейтін ештеңе қалмады.
Dialogue: 0,0:03:01.55,0:03:03.85,Default,,0,0,0,,Жоғал, Барто Аои!
Dialogue: 0,0:03:04.26,0:03:08.10,Default,,0,0,0,,Хмф, ол жоғалып кетпейді, ешқашан!
Dialogue: 0,0:03:08.60,0:03:10.06,Default,,0,0,0,,Нана дос
Dialogue: 0,0:03:10.39,0:03:11.85,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:03:12.77,0:03:14.23,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:03:14.31,0:03:15.82,Default,,0,0,0,,Күлімсіреу
Dialogue: 0,0:03:16.86,0:03:17.82,Default,,0,0,0,,Шу
Dialogue: 0,0:03:18.23,0:03:20.82,Default,,0,0,0,,Сіз кереметсіз.
Dialogue: 0,0:03:23.41,0:03:25.83,Default,,0,0,0,,Жарайсыңдар! Мен қайтадан жеңемін
Dialogue: 0,0:03:25.91,0:03:30.21,Default,,0,0,0,,Қарғыс атқыр... Менің жіберген қателігім менің іске қосқышымның қозғалуы болды.
Dialogue: 0,0:03:30.54,0:03:32.46,Default,,0,0,0,,Тағы бір рет, тағы бір шайқас.
Dialogue: 0,0:03:32.79,0:03:34.83,Default,,0,0,0,,Жарайды, жарайды, жасайық.
Dialogue: 0,0:03:35.42,0:03:37.17,Default,,0,0,0,,Барт
Dialogue: 0,0:03:38.00,0:03:40.84,Default,,0,0,0,,Бейблейд шынымен қызықты
Dialogue: 0,0:03:42.59,0:03:46.51,Default,,0,0,0,,Сондықтан мен сенен ешқашан жеңілмеймін!
Dialogue: 0,0:03:47.43,0:03:48.77,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:03:51.14,0:03:52.31,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:03:54.60,0:03:56.73,Default,,0,0,0,,Ең жақсы кадрды алыңыз
Dialogue: 0,0:04:08.66,0:04:11.25,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:04:11.33,0:04:13.87,Default,,0,0,0,,Спригган! Қарғыс атсын!
Dialogue: 0,0:04:14.12,0:04:15.88,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:04:17.00,0:04:20.38,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:20.46,0:04:22.59,Default,,0,0,0,,Тобе Балто!
Dialogue: 0,0:04:22.67,0:04:25.01,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:25.26,0:04:26.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:27.68,0:04:30.85,Default,,0,0,0,,Валькири орнынан секірді!
Dialogue: 0,0:04:32.89,0:04:34.14,Default,,0,0,0,,Сырттап өтіңіз!
Dialogue: 0,0:04:35.77,0:04:39.15,Default,,0,0,0,,Мен бұны шпригган қабатының резеңкесімен ұстадым.
Dialogue: 0,0:04:39.23,0:04:42.53,Default,,0,0,0,,Керісінше, ол қуатты жұтып, жылдамдығын арттырады!
Dialogue: 0,0:04:42.61,0:04:45.15,Default,,0,0,0,,Балто ұшады деп болжадың ба?
Dialogue: 0,0:04:45.24,0:04:46.70,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:04:48.49,0:04:50.03,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:04:50.12,0:04:54.50,Default,,0,0,0,,Valkyrie Ultimate God қайта жүктеледі!
Dialogue: 0,0:04:54.58,0:04:57.00,Default,,0,0,0,,Уау! Сенгісіз
Dialogue: 0,0:04:57.42,0:05:00.25,Default,,0,0,0,,Валькири кенеттен жылдамдады!
Dialogue: 0,0:05:03.51,0:05:05.30,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:05:05.51,0:05:06.93,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:05:07.01,0:05:09.30,Default,,0,0,0,,Спригган есептегіш Valkyrie шымшым!
Dialogue: 0,0:05:09.39,0:05:10.85,Default,,0,0,0,,Мен әлемге сенің келгеніңді білгім келеді
Dialogue: 0,0:05:11.43,0:05:13.10,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:05:13.18,0:05:15.14,Default,,0,0,0,,Валькири Спригганнан қашып кетті!
Dialogue: 0,0:05:15.23,0:05:16.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:16.48,0:05:19.94,Default,,0,0,0,,Бара бер, Құдай Слэш!
Dialogue: 0,0:05:23.61,0:05:24.65,Default,,0,0,0,,Ха...
Dialogue: 0,0:05:25.82,0:05:27.32,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:05:29.24,0:05:32.20,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:05:32.54,0:05:34.04,Default,,0,0,0,,2-2 тармақтар
Dialogue: 0,0:05:34.79,0:05:39.04,Default,,0,0,0,,God Slash Барто Аоиды қуып жетті!
Dialogue: 0,0:05:39.13,0:05:42.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:42.92,0:05:44.26,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:44.34,0:05:48.13,Default,,0,0,0,,God Reboot басынан бері бірінші рет шабуыл жасады.
Dialogue: 0,0:05:48.59,0:05:50.30,Default,,0,0,0,,Жүргізушінің білігінің ұшы
Dialogue: 0,0:05:50.39,0:05:53.35,Default,,0,0,0,,Құлаудың әсері мені шегінуге мәжбүр етті.
Dialogue: 0,0:05:53.72,0:05:56.10,Default,,0,0,0,,Сіз өзіңіздің ерекше қозғалысыңызды осылай жасадыңыз ба?
Dialogue: 0,0:05:56.18,0:05:58.60,Default,,0,0,0,,Қабілетті сұңқар тырнағын жасырады
Dialogue: 0,0:05:58.94,0:06:03.07,Default,,0,0,0,,Жоқ, Балто өзінің техникасын жасыратын адам емес.
Dialogue: 0,0:06:03.44,0:06:06.65,Default,,0,0,0,,Жарайды, ол ештеңені ойламайды.
Dialogue: 0,0:06:06.74,0:06:08.20,Default,,0,0,0,,Мен оны бірден шығардым.
Dialogue: 0,0:06:08.57,0:06:10.82,Default,,0,0,0,,Хехе, бұл оған ұқсайды.
Dialogue: 0,0:06:11.70,0:06:12.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:13.08,0:06:18.00,Default,,0,0,0,,Қазір бүкіл әлемде God Bladers кубогының финалдық ойындары назар аударуда.
Dialogue: 0,0:06:18.08,0:06:20.21,Default,,0,0,0,,2-2 ұпай тең
Dialogue: 0,0:06:20.29,0:06:22.92,Default,,0,0,0,,Енді ойын түсініксіз бола бастады.
Dialogue: 0,0:06:23.00,0:06:27.42,Default,,0,0,0,,Ғажайып бала Балт Аои немесе жойқын жын Қызыл көз?
Dialogue: 0,0:06:27.51,0:06:30.01,Default,,0,0,0,,Кім жеңеді? ?
Dialogue: 0,0:06:32.89,0:06:36.52,Default,,0,0,0,,Ең күшті би жеңілмейтін болуы керек
Dialogue: 0,0:06:36.60,0:06:37.85,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:06:39.52,0:06:42.27,Default,,0,0,0,,Мен дауысты естідім (жарық дыбысы)
Dialogue: 0,0:06:42.73,0:06:43.52,Default,,0,0,0,,Иә
Dialogue: 0,0:06:44.61,0:06:48.36,Default,,0,0,0,,Шу мен оны ертерек көрдім.
Dialogue: 0,0:06:48.99,0:06:50.24,Default,,0,0,0,,Спригган!
Dialogue: 0,0:06:50.86,0:06:52.82,Default,,0,0,0,,Бенишу қайтыс болды
Dialogue: 0,0:06:52.91,0:06:53.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:54.03,0:06:54.95,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:06:55.58,0:06:57.95,Default,,0,0,0,,Мен бұл жігіттің күшін шығарамын.
Dialogue: 0,0:07:00.67,0:07:02.67,Default,,0,0,0,,(Маска сынған дыбыс)
Dialogue: 0,0:07:07.38,0:07:09.01,Default,,0,0,0,,Тоқта, Шу.
Dialogue: 0,0:07:09.34,0:07:10.47,Default,,0,0,0,,Шу!
Dialogue: 0,0:07:12.55,0:07:13.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:14.05,0:07:16.26,Default,,0,0,0,,Шу Шу
Dialogue: 0,0:07:16.64,0:07:17.64,Default,,0,0,0,,Шу!
Dialogue: 0,0:07:18.47,0:07:19.56,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:07:20.18,0:07:21.89,Default,,0,0,0,,Менің көз алдымнан кет!
Dialogue: 0,0:07:24.52,0:07:26.48,Default,,0,0,0,,Куришу қайтыс болды
Dialogue: 0,0:07:26.73,0:07:29.19,Default,,0,0,0,,Спригган ғана қалды ма?
Dialogue: 0,0:07:30.28,0:07:32.11,Default,,0,0,0,,Мен мұны қабылдамаймын.
Dialogue: 0,0:07:32.91,0:07:34.95,Default,,0,0,0,,Мен мұны ешқашан мойындамаймын!
Dialogue: 0,0:07:36.41,0:07:38.58,Default,,0,0,0,,Мен Спригганмын!
Dialogue: 0,0:07:39.29,0:07:41.50,Default,,0,0,0,,Мен сені құртамын!
Dialogue: 0,0:07:42.46,0:07:44.92,Default,,0,0,0,,Шу – Шу!
Dialogue: 0,0:07:47.84,0:07:49.17,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:07:55.85,0:07:58.10,Default,,0,0,0,,Мен сенімен финалда жұдырықтасқым келеді.
Dialogue: 0,0:07:59.89,0:08:01.31,Default,,0,0,0,,Финалға келіңіз
Dialogue: 0,0:08:03.56,0:08:04.48,Default,,0,0,0,,Шу
Dialogue: 0,0:08:05.19,0:08:07.69,Default,,0,0,0,,Осы уақытқа дейін сенің арқаңда келдім.
Dialogue: 0,0:08:08.61,0:08:10.36,Default,,0,0,0,,Өйткені сіз сонда болдыңыз!
Dialogue: 0,0:08:12.82,0:08:14.45,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:08:14.95,0:08:17.83,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:17.91,0:08:21.12,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:21.20,0:08:22.29,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:08:30.71,0:08:32.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:32.38,0:08:35.18,Default,,0,0,0,,Спригган реквиемі және құдай Валькири
Dialogue: 0,0:08:35.26,0:08:38.05,Default,,0,0,0,,Ауадағы қақтығыс!
Dialogue: 0,0:08:38.14,0:08:39.56,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:08:39.89,0:08:41.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:44.14,0:08:46.31,Default,,0,0,0,,Бір уақыттағы ұтыс ойыны!
Dialogue: 0,0:08:46.44,0:08:48.65,Default,,0,0,0,,Ұпайлар 2-2-
Dialogue: 0,0:08:49.44,0:08:51.78,Default,,0,0,0,,Күшті шайқастың уақыты келді!
Dialogue: 0,0:08:52.24,0:08:53.19,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:08:53.28,0:08:55.20,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:08:57.32,0:08:59.74,Default,,0,0,0,,Burst Burst Burst!
Dialogue: 0,0:08:59.83,0:09:03.00,Default,,0,0,0,,Бір мезгілде тағы бір жарылыс!
Dialogue: 0,0:09:03.08,0:09:05.83,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,0:09:06.87,0:09:09.04,Default,,0,0,0,,Бір мезетте жарылыс салу
Dialogue: 0,0:09:09.13,0:09:13.63,Default,,0,0,0,,Енді бір мезгілде 15 ретті жарылыс
Dialogue: 0,0:09:14.05,0:09:16.34,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:09:17.13,0:09:19.97,Default,,0,0,0,,Шуу, өйткені сен осындасың...
Dialogue: 0,0:09:20.72,0:09:22.10,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:09:23.77,0:09:24.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:27.14,0:09:29.69,Default,,0,0,0,,Мен республикалық турнирге барғым келеді
Dialogue: 0,0:09:29.77,0:09:32.40,Default,,0,0,0,,Шуды жеңіп, чемпион боламын.
Dialogue: 0,0:09:32.94,0:09:34.82,Default,,0,0,0,,Жаңадан бастағандар үшін бұл мүмкін емес.
Dialogue: 0,0:09:34.90,0:09:35.95,Default,,0,0,0,,Уау
Dialogue: 0,0:09:36.03,0:09:39.03,Default,,0,0,0,,Бэй ойынын сенен ерте бастадым.
Dialogue: 0,0:09:39.12,0:09:41.12,Default,,0,0,0,,Ерте болғаның маңызды емес
Dialogue: 0,0:09:44.91,0:09:46.29,Default,,0,0,0,,Мен сені финалда көргім келеді.
Dialogue: 0,0:09:47.04,0:09:49.42,Default,,0,0,0,,Иә, финалда кездескенше!
Dialogue: 0,0:09:49.54,0:09:50.50,Default,,0,0,0,,Хи хи
Dialogue: 0,0:09:51.04,0:09:54.76,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:09:54.84,0:09:58.47,Default,,0,0,0,,Ой? Қызыл көз біртүрлі әрекет етеді.
Dialogue: 0,0:09:59.01,0:10:00.97,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:02.05,0:10:03.89,Default,,0,0,0,,Сіз шектеулеріңізден асып кеттіңіз.
Dialogue: 0,0:10:04.14,0:10:05.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:05.43,0:10:07.10,Default,,0,0,0,,Бұл сізді ренжіткен сияқты.
Dialogue: 0,0:10:07.52,0:10:08.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:10.19,0:10:11.36,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:10:11.44,0:10:14.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:14.36,0:10:15.78,Default,,0,0,0,,Балто!
Dialogue: 0,0:10:17.15,0:10:18.24,Default,,0,0,0,,Шу!
Dialogue: 0,0:10:18.40,0:10:20.91,Default,,0,0,0,,Сен... менің ең жақын досымсың!
Dialogue: 0,0:10:21.28,0:10:23.78,Default,,0,0,0,,Сондықтан... Сондықтан да!
Dialogue: 0,0:10:24.24,0:10:28.08,Default,,0,0,0,,Өлсем де сенен ұтыла алмаймын.
Dialogue: 0,0:10:28.75,0:10:31.04,Default,,0,0,0,,Мен жеңілуге ​​шыдай алмаймын!
Dialogue: 0,0:10:31.88,0:10:33.17,Default,,0,0,0,,Мен де!
Dialogue: 0,0:10:33.50,0:10:35.34,Default,,0,0,0,,Кеттік, Шу!
Dialogue: 0,0:10:35.71,0:10:37.55,Default,,0,0,0,,Он сегізінші шайқас
Dialogue: 0,0:10:38.42,0:10:39.72,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:10:43.05,0:10:46.43,Default,,0,0,0,,Барлығын осы түсірілімге салыңыз!
Dialogue: 0,0:11:04.78,0:11:07.54,Default,,0,0,0,,(Спригган айқайлау)
Dialogue: 0,0:11:07.62,0:11:11.50,Default,,0,0,0,,Шу... Өйткені сен Шу...
Dialogue: 0,0:11:11.75,0:11:14.42,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:11:15.59,0:11:18.46,Default,,0,0,0,,Мен саған сенемін, Балто!
Dialogue: 0,0:11:18.71,0:11:21.47,Default,,0,0,0,,Мен саған сенемін, досым!
Dialogue: 0,0:11:22.01,0:11:24.47,Default,,0,0,0,,Енді бұл он сегізінші шайқас.
Dialogue: 0,0:11:24.55,0:11:26.47,Default,,0,0,0,,Бұл әңгіменің соңы ма?
Dialogue: 0,0:11:26.72,0:11:28.27,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:29.56,0:11:31.98,Default,,0,0,0,,Үш… Екі…
Dialogue: 0,0:11:33.10,0:11:34.11,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:11:34.44,0:11:37.19,Default,,0,0,0,,Барто Аои Тонда!
Dialogue: 0,0:11:37.44,0:11:39.94,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:40.65,0:11:41.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:41.70,0:11:43.20,Default,,0,0,0,,А...
Dialogue: 0,0:11:43.32,0:11:45.49,Default,,0,0,0,,Енді шайқас басталсын!
Dialogue: 0,0:11:45.57,0:11:46.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:48.33,0:11:51.62,Default,,0,0,0,,Спригган реквиемі – сағат тіліне қарсы айналу төзімділік режимі.
Dialogue: 0,0:11:51.71,0:11:54.38,Default,,0,0,0,,Валькиридің Додж Спригганға шабуылы
Dialogue: 0,0:11:54.46,0:11:57.55,Default,,0,0,0,,Спригган реквиемі Мен орталықты алдым!
Dialogue: 0,0:11:59.76,0:12:02.51,Default,,0,0,0,,Valkyrie Rush атыс!
Dialogue: 0,0:12:03.88,0:12:06.22,Default,,0,0,0,,Қатты шабуыл!
Dialogue: 0,0:12:06.80,0:12:08.72,Default,,0,0,0,,Спригган мұнымен айналысады!
Dialogue: 0,0:12:08.81,0:12:10.47,Default,,0,0,0,,Мен мұны істеп жатырмын
Dialogue: 0,0:12:10.56,0:12:12.44,Default,,0,0,0,,Кесіңіз!
Dialogue: 0,0:12:28.87,0:12:29.74,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:12:29.83,0:12:30.95,Default,,0,0,0,,Жүр!
Dialogue: 0,0:12:34.17,0:12:37.21,Default,,0,0,0,,Spriggan Requiem Oshikonde Iku!
Dialogue: 0,0:12:37.33,0:12:41.42,Default,,0,0,0,,Валькири бірінші соққыға шыдамдылығын жұмсады ма?
Dialogue: 0,0:12:42.76,0:12:44.68,Default,,0,0,0,,Бұл мен үшін бәрі!
Dialogue: 0,0:12:45.55,0:12:48.39,Default,,0,0,0,,Слеш реквиемі!
Dialogue: 0,0:12:49.81,0:12:53.64,Default,,0,0,0,,Спригганның реквиемі мінсіз болды
Dialogue: 0,0:12:53.73,0:12:55.39,Default,,0,0,0,,Барто!
Dialogue: 0,0:12:55.48,0:12:56.94,Default,,0,0,0,,Аники! Бал-ни! Бауырым!
Dialogue: 0,0:12:58.48,0:13:01.19,Default,,0,0,0,,Ууу Таэро!
Dialogue: 0,0:13:01.90,0:13:04.82,Default,,0,0,0,,Түпкілікті Құдай қайта жүктеу!
Dialogue: 0,0:13:06.03,0:13:06.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:07.03,0:13:09.45,Default,,0,0,0,,О! Бұл не!
Dialogue: 0,0:13:09.53,0:13:12.91,Default,,0,0,0,,Кел, Валькири!
Dialogue: 0,0:13:15.37,0:13:17.33,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:13:17.42,0:13:20.38,Default,,0,0,0,,Ең керемет флэш түсіру!
Dialogue: 0,0:13:21.63,0:13:25.55,Default,,0,0,0,,Бұл менің толық күшім!
Dialogue: 0,0:13:26.34,0:13:28.59,Default,,0,0,0,,Құдай жарсын!
Dialogue: 0,0:13:29.01,0:13:30.68,Default,,0,0,0,,Спригган! Уау...
Dialogue: 0,0:13:30.76,0:13:32.43,Default,,0,0,0,,Уууу!
Dialogue: 0,0:13:34.68,0:13:35.94,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:36.44,0:13:37.85,Default,,0,0,0,,Уууу!
Dialogue: 0,0:13:38.02,0:13:40.23,Default,,0,0,0,,Ахх!
Dialogue: 0,0:13:43.86,0:13:46.70,Default,,0,0,0,,Шууууу!
Dialogue: 0,0:13:46.78,0:13:48.20,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:13:49.16,0:13:50.45,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:13:53.12,0:13:55.50,Default,,0,0,0,,Бартоо!
Dialogue: 0,0:13:55.58,0:13:56.83,Default,,0,0,0,,Ахх!
Dialogue: 0,0:14:02.13,0:14:03.63,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:14:04.96,0:14:06.17,Default,,0,0,0,,(құлап түскен дыбыс)
Dialogue: 0,0:14:07.17,0:14:10.59,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:14:10.68,0:14:12.56,Default,,0,0,0,,4-2 тармақтар
Dialogue: 0,0:14:13.60,0:14:17.31,Default,,0,0,0,,God Bladers кубогының жеңімпазы - Балт Аои!
Dialogue: 0,0:14:17.39,0:14:19.81,Default,,0,0,0,,(Конфетти ату дыбысы)
Dialogue: 0,0:14:20.10,0:14:22.98,Default,,0,0,0,,Жеңімпаз анықталды!
Dialogue: 0,0:14:23.07,0:14:27.53,Default,,0,0,0,,Жеңімпаз - Барто Аои! Барто Аои!
Dialogue: 0,0:14:27.82,0:14:30.16,Default,,0,0,0,,Аники жеңді!
Dialogue: 0,0:14:30.78,0:14:35.62,Default,,0,0,0,,Әлемнің шыңында тұрған сол BC Барту Аои болды!
Dialogue: 0,0:14:35.70,0:14:38.16,Default,,0,0,0,,Бару-нии Яй!
Dialogue: 0,0:14:38.41,0:14:39.79,Default,,0,0,0,,Сіз жеңдіңіз.
Dialogue: 0,0:14:39.87,0:14:41.13,Default,,0,0,0,,Иә
Dialogue: 0,0:14:41.71,0:14:44.09,Default,,0,0,0,,Бар... Барт...
Dialogue: 0,0:14:44.50,0:14:47.17,Default,,0,0,0,,Ugh… Kuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu...
Dialogue: 0,0:14:48.05,0:14:49.17,Default,,0,0,0,,Ааах!
Dialogue: 0,0:14:49.43,0:14:53.14,Default,,0,0,0,,(Кайзердің шапалақтауы)
Dialogue: 0,0:14:53.22,0:14:54.93,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:14:55.01,0:14:58.52,Default,,0,0,0,,Бізге керемет шайқас көрсеткен Аой Балт пен Қызыл Көзге.
Dialogue: 0,0:14:58.60,0:15:02.69,Default,,0,0,0,,Залдағылардың барлығы қол соғып жатыр!
Dialogue: 0,0:15:02.94,0:15:05.65,Default,,0,0,0,,Дүние жүзіндегі жүзгіштер
Dialogue: 0,0:15:05.73,0:15:08.61,Default,,0,0,0,,Және және Бейблейд әуесқойлары
Dialogue: 0,0:15:08.69,0:15:12.45,Default,,0,0,0,,Олар маған шапалақтап жатыр! Ууу... уф...
Dialogue: 0,0:15:12.53,0:15:14.37,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:15:18.70,0:15:23.25,Default,,0,0,0,,Ой? Екеуміз де ұрыс сахнасында жатырмыз.
Dialogue: 0,0:15:25.29,0:15:26.42,Default,,0,0,0,,Шу…
Dialogue: 0,0:15:27.46,0:15:28.59,Default,,0,0,0,,Барт…
Dialogue: 0,0:15:30.13,0:15:31.63,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:15:32.80,0:15:33.97,Default,,0,0,0,,О
Dialogue: 0,0:15:37.26,0:15:38.93,Default,,0,0,0,,Тұр. Шу
Dialogue: 0,0:15:41.81,0:15:44.73,Default,,0,0,0,,Шу! Тұру!
Dialogue: 0,0:15:45.69,0:15:48.90,Default,,0,0,0,,Шу тұр!
Dialogue: 0,0:15:51.32,0:15:52.40,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:15:56.99,0:16:00.16,Default,,0,0,0,,Мен, көбірек істе!
Dialogue: 0,0:16:01.96,0:16:02.96,Default,,0,0,0,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:16:06.75,0:16:09.34,Default,,0,0,0,,Бұл екеуі шайқасқа жақын.
Dialogue: 0,0:16:09.42,0:16:10.55,Default,,0,0,0,,Шител!
Dialogue: 0,0:16:10.80,0:16:13.18,Default,,0,0,0,,Иә? Бітсе де...
Dialogue: 0,0:16:13.55,0:16:15.55,Default,,0,0,0,,Бұл жігіт не ойлады?
Dialogue: 0,0:16:16.01,0:16:17.39,Default,,0,0,0,,Бұл Балто.
Dialogue: 0,0:16:17.97,0:16:19.89,Default,,0,0,0,,Фофофу
Dialogue: 0,0:16:20.43,0:16:22.27,Default,,0,0,0,,Кеттік, Шу!
Dialogue: 0,0:16:22.81,0:16:23.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:24.06,0:16:27.19,Default,,0,0,0,,Жарайды, жиынтық дайын!
Dialogue: 0,0:16:27.69,0:16:30.61,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:31.15,0:16:33.28,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:40.49,0:16:41.50,Default,,0,0,0,,Гилтен
Dialogue: 0,0:16:41.87,0:16:44.83,Default,,0,0,0,,Сен сияқты өзімшіл үлкендердің кесірінен.
Dialogue: 0,0:16:44.92,0:16:47.96,Default,,0,0,0,,Мен ол балалардың жарақат алуына ешқашан жол бермеймін.
Dialogue: 0,0:16:48.67,0:16:50.50,Default,,0,0,0,,Бей әлемінен жоғалып кетті
Dialogue: 0,0:16:51.05,0:16:53.13,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:16:53.63,0:16:55.55,Default,,0,0,0,,Менің қолымнан келмесе де...
Dialogue: 0,0:16:55.84,0:16:57.68,Default,,0,0,0,,Бұл балалардың қолынан келеді.
Dialogue: 0,0:16:59.76,0:17:01.93,Default,,0,0,0,,Уф... мен жеңілдім.
Dialogue: 0,0:17:02.52,0:17:06.02,Default,,0,0,0,,Сіз және Балто есімді бала
Dialogue: 0,0:17:16.24,0:17:18.20,Default,,0,0,0,,Уде Бұл ауырады ма?
Dialogue: 0,0:17:19.37,0:17:20.53,Default,,0,0,0,,Аз
Dialogue: 0,0:17:22.08,0:17:24.08,Default,,0,0,0,,Жеңісіңізбен құттықтаймыз
Dialogue: 0,0:17:24.75,0:17:25.71,Default,,0,0,0,,О
Dialogue: 0,0:17:27.25,0:17:28.42,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,0:17:29.71,0:17:30.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:31.50,0:17:33.63,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:17:34.09,0:17:36.72,Default,,0,0,0,,Мен де уайымдадым.
Dialogue: 0,0:17:36.97,0:17:38.18,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:17:38.30,0:17:40.05,Default,,0,0,0,,Мен сенің қателескеніңді қаламаймын.
Dialogue: 0,0:17:40.30,0:17:42.47,Default,,0,0,0,,«Ол қазірдің өзінде қайтып келуі керек».
Dialogue: 0,0:17:42.56,0:17:44.06,Default,,0,0,0,,Сіз мұны айтқан болсаңыз да
Dialogue: 0,0:17:44.14,0:17:45.23,Default,,0,0,0,,Шулы!
Dialogue: 0,0:17:45.31,0:17:47.23,Default,,0,0,0,,Не?
Dialogue: 0,0:17:47.31,0:17:49.10,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:17:51.94,0:17:52.94,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:17:53.48,0:17:54.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:55.36,0:17:56.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:59.36,0:18:00.70,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:18:00.78,0:18:01.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:04.37,0:18:07.33,Default,,0,0,0,,Неаполитан Сіз жеткенше.
Dialogue: 0,0:18:07.41,0:18:08.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:08.71,0:18:09.88,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:18:09.96,0:18:12.63,Default,,0,0,0,,Ницца Шудың неаполитаны
Dialogue: 0,0:18:12.71,0:18:14.25,Default,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:18:14.34,0:18:15.55,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:15.63,0:18:17.63,Default,,0,0,0,,Макарон!
Dialogue: 0,0:18:18.09,0:18:19.80,Default,,0,0,0,,Бұл өте дәмді!
Dialogue: 0,0:18:21.47,0:18:23.89,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:23.97,0:18:25.89,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:18:26.85,0:18:28.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:28.98,0:18:31.40,Default,,0,0,0,,Уау~ Бұл не?
Dialogue: 0,0:18:31.73,0:18:35.15,Default,,0,0,0,,Мынау... бұл... бұл дәмді ме?
Dialogue: 0,0:18:35.23,0:18:36.78,Default,,0,0,0,,Өте жаман!
Dialogue: 0,0:18:36.86,0:18:39.49,Default,,0,0,0,,Мынау Шу неаполитандық па?
Dialogue: 0,0:18:39.57,0:18:41.99,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:18:42.07,0:18:43.66,Default,,0,0,0,,Өте нашар!
Dialogue: 0,0:18:44.16,0:18:45.45,Default,,0,0,0,,Не?
Dialogue: 0,0:18:45.54,0:18:46.70,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:18:46.79,0:18:49.04,Default,,0,0,0,,Мен қорқатын нәрсе болды.
Dialogue: 0,0:18:49.12,0:18:52.42,Default,,0,0,0,,Мен жасаған неаполитан дәмді!
Dialogue: 0,0:18:52.50,0:18:54.25,Default,,0,0,0,,Не! ?
Dialogue: 0,0:18:54.38,0:18:56.84,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:18:57.26,0:19:01.76,Default,,0,0,0,,Мен оны жасауға бар күшімді салдым...
Dialogue: 0,0:19:01.84,0:19:02.80,Default,,0,0,0,,Әй
Dialogue: 0,0:19:06.64,0:19:10.14,Default,,0,0,0,,Барлығы, мен ең жақсы паэля жасадым.
Dialogue: 0,0:19:10.23,0:19:14.15,Default,,0,0,0,,Бейблейд наны да көп, сондықтан жеп қойыңыз!
Dialogue: 0,0:19:14.48,0:19:16.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:16.44,0:19:19.74,Default,,0,0,0,,Аналар - ең жақсы!
Dialogue: 0,0:19:25.20,0:19:28.95,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:19:31.96,0:19:33.96,Default,,0,0,0,,Хмм... ха ха ха
Dialogue: 0,0:19:34.04,0:19:35.63,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:19:36.71,0:19:39.59,Default,,0,0,0,,(Ойын ойнаған балалардың дыбыстары)
Dialogue: 0,0:19:39.67,0:19:43.34,Default,,0,0,0,,Ха ха ха ха ха ха
Dialogue: 0,0:19:43.43,0:19:47.35,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:19:47.43,0:19:51.35,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:19:52.64,0:19:55.56,Default,,0,0,0,,Раш Раш (Рантаро) Жоқ, бұл керемет.
Dialogue: 0,0:19:55.65,0:19:56.82,Default,,0,0,0,,Кумичо
Dialogue: 0,0:19:56.90,0:19:58.53,Default,,0,0,0,,Иә! (Рантаро) Ах!
Dialogue: 0,0:20:06.78,0:20:08.24,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:20:08.45,0:20:10.95,Default,,0,0,0,,Бұл Куришу, солай ма?
Dialogue: 0,0:20:12.33,0:20:14.08,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:20:14.46,0:20:16.34,Default,,0,0,0,,Сонымен сіз Жапонияға қайтып келдіңіз бе?
Dialogue: 0,0:20:16.67,0:20:17.59,Default,,0,0,0,,О
Dialogue: 0,0:20:17.92,0:20:19.21,Default,,0,0,0,,Менің өтінішім бар.
Dialogue: 0,0:20:19.67,0:20:20.63,Default,,0,0,0,,Не?
Dialogue: 0,0:20:21.30,0:20:23.13,Default,,0,0,0,,Өтінемін, менімен шайқас
Dialogue: 0,0:20:25.01,0:20:26.89,Default,,0,0,0,,Хе... Жарайды.
Dialogue: 0,0:20:26.97,0:20:29.43,Default,,0,0,0,,А, мен жасадым!
Dialogue: 0,0:20:30.72,0:20:33.14,Default,,0,0,0,,Олай болса, бұл бірінші шайқас.
Dialogue: 0,0:20:33.27,0:20:34.48,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:20:36.36,0:20:39.07,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:20:39.15,0:20:42.36,Default,,0,0,0,,God Bladers кубогын жеңіп алғаннан кейін, ақырында...
Dialogue: 0,0:20:42.44,0:20:47.07,Default,,0,0,0,,Бірінші WBBA ресми әлем чемпионы атанған адам
Dialogue: 0,0:20:47.16,0:20:51.04,Default,,0,0,0,,Бұл Эль Сантода!
Dialogue: 0,0:20:51.37,0:20:54.33,Default,,0,0,0,,Мен сені енді ғажайып бала деп атауға рұқсат бермеймін!
Dialogue: 0,0:20:54.41,0:20:57.54,Default,,0,0,0,,Ақыры мен әлем чемпионы атандым.
Dialogue: 0,0:20:57.63,0:20:59.59,Default,,0,0,0,,Қуықтың аты...
Dialogue: 0,0:21:00.63,0:21:02.63,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:21:02.71,0:21:04.01,Default,,0,0,0,,Ой, жоқ...
Dialogue: 0,0:21:04.09,0:21:06.39,Default,,0,0,0,,Бұл басқаша, біз...
Dialogue: 0,0:21:06.47,0:21:09.26,Default,,0,0,0,,Аники тез
Dialogue: 0,0:21:09.35,0:21:12.72,Default,,0,0,0,,Warii Warii Менің қобалжығаным сонша, мен кенет ваннаға бардым...
Dialogue: 0,0:21:13.02,0:21:14.98,Default,,0,0,0,,Ах... Уау... Уау.
Dialogue: 0,0:21:15.06,0:21:16.14,Default,,0,0,0,,Уау уау уау
Dialogue: 0,0:21:16.23,0:21:19.65,Default,,0,0,0,,Мм... Бұл қуықтың аты кім?
Dialogue: 0,0:21:19.73,0:21:22.90,Default,,0,0,0,,Әлем чемпионы Барто Аои!
Dialogue: 0,0:21:22.99,0:21:24.44,Default,,0,0,0,,Мұндағы Штрохейм — сен бетпе-бет келетін соңғы қарсыласың.
Dialogue: 0,0:21:24.99,0:21:27.41,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:27.49,0:21:30.45,Default,,0,0,0,,Таку... Жақсы, Балто!
Dialogue: 0,0:21:30.53,0:21:31.79,Default,,0,0,0,,Көңіл-күйлеріңіз көтеріңкі болсын!
Dialogue: 0,0:21:32.12,0:21:35.08,Default,,0,0,0,,Келесі жолы мен сені шақырамын.
Dialogue: 0,0:21:35.37,0:21:36.83,Default,,0,0,0,,Мен ешқашан жеңілмеймін
Dialogue: 0,0:21:36.92,0:21:39.33,Default,,0,0,0,,Келесі сайыскер менмін.
Dialogue: 0,0:21:39.42,0:21:40.38,Default,,0,0,0,,О, ау!
Dialogue: 0,0:21:40.46,0:21:41.55,Default,,0,0,0,,Ойрада!
Dialogue: 0,0:21:41.63,0:21:43.84,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:44.13,0:21:45.13,Default,,0,0,0,,Хен
Dialogue: 0,0:21:45.22,0:21:48.68,Default,,0,0,0,,Қарсыласым кім болса да, мен міндетті түрде жеңемін!
Dialogue: 0,0:21:48.76,0:21:52.10,Default,,0,0,0,,Кәне, Бейбатл жасайық!
Dialogue: 0,0:21:52.18,0:21:53.72,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:21:55.10,0:21:56.06,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.06,0:21:59.60,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.06,0:21:59.60,Default,,0,0,0,,Жарайсыңдар Ұлдар мен Қыздар Сіз бұлшық еттеріңізді шынықтырасыз ба?
Dialogue: 0,0:21:59.69,0:22:02.61,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:02.69,0:22:06.53,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:06.61,0:22:10.24,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.32,0:22:13.91,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдығыңызды арттырыңыз!
Dialogue: 0,0:22:13.99,0:22:17.58,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:17.66,0:22:21.04,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.13,0:22:24.42,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.50,0:22:28.43,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді арттырамын.
Dialogue: 0,0:22:28.51,0:22:32.35,Default,,0,0,0,,GO Shoot GO Shoot Bay Muscle Train Моримори
Dialogue: 0,0:22:32.43,0:22:36.02,Default,,0,0,0,,АЛУ АТТЫ БАР АТТЫ Менің атыс – құдайдың атысы
Dialogue: 0,0:22:36.10,0:22:39.77,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:39.85,0:22:43.44,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:43.52,0:22:47.07,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.15,0:22:50.99,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.07,0:22:54.87,Default,,0,0,0,,Күн сайын барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:54.95,0:22:58.08,Default,,0,0,0,,GO түсіру жыл бойы, көктемде, жазда, күзде және қыста
Dialogue: 0,0:22:58.16,0:22:59.58,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:22:59.66,0:23:02.29,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.38,0:23:05.50,Default,,0,0,0,,Сол шиеленіспен біз шарықтау шегіне жетеміз!
Dialogue: 0,0:23:05.59,0:23:09.30,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіріліміне кірісіңіз!
Dialogue: 0,0:23:09.38,0:23:12.80,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:12.89,0:23:16.68,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:16.77,0:23:19.56,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.56,0:23:21.56,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.56,0:23:21.56,Default,,0,0,0,,~♪
Dialogue: 0,0:23:21.56,0:23:21.65,Default,,0,0,0,,~♪
Dialogue: 0,0:23:21.65,0:23:24.69,Default,,0,0,0,,~♪
Dialogue: 0,0:23:21.65,0:23:24.69,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:24.69,0:23:25.11,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.61,0:23:32.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory