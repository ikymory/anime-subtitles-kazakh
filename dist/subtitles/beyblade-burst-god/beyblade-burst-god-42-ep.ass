Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:05.58,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.25,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.63,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.47,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.56,0:00:24.19,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.56,0:00:27.90,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.98,0:00:30.15,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:31.36,0:00:34.28,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.82,0:00:36.20,Default,,0,0,0,,Бару…
Dialogue: 0,0:00:37.70,0:00:38.83,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:00:39.53,0:00:42.66,Default,,0,0,0,,God Bladers Cup A тобының 2-ші матчы
Dialogue: 0,0:00:43.08,0:00:46.21,Default,,0,0,0,,Шу — Бей Спригганның жаңа реквиемі
Dialogue: 0,0:00:46.29,0:00:49.34,Default,,0,0,0,,Жылан шұңқырынан шыққан Боаны жеңді.
Dialogue: 0,0:00:51.67,0:00:54.84,Default,,0,0,0,,Ал үшінші матч - Куза Норманға қарсы
Dialogue: 0,0:00:55.22,0:00:57.89,Default,,0,0,0,,Немесистің ерекше қозғалысы: Smash Hammer
Dialogue: 0,0:00:57.97,0:01:00.56,Default,,0,0,0,,Кронос жарылды
Dialogue: 0,0:01:02.31,0:01:04.02,Default,,0,0,0,,Оу? Оооох!
Dialogue: 0,0:01:04.73,0:01:07.52,Default,,0,0,0,,Менің ойымша, бұл Голдиге де ұнайды.
Dialogue: 0,0:01:07.98,0:01:09.06,Default,,0,0,0,,Осы үнде...
Dialogue: 0,0:01:09.15,0:01:12.40,Default,,0,0,0,,Спригган реквиемімен күрес.
Dialogue: 0,0:01:16.03,0:01:17.28,Default,,0,0,0,,Куза!
Dialogue: 0,0:01:19.45,0:01:21.03,Default,,0,0,0,,Май ақсақ болды
Dialogue: 0,0:01:21.12,0:01:25.12,Default,,0,0,0,,Егіз жауды жеңдім деп ойладым... Кешіріңіз!
Dialogue: 0,0:01:26.16,0:01:29.46,Default,,0,0,0,,Қарғыс атқыр, біз бұл жаман үрдісті тоқтатуымыз керек.
Dialogue: 0,0:01:30.04,0:01:32.09,Default,,0,0,0,,Мен мұны сен үшін жасаймын
Dialogue: 0,0:01:32.55,0:01:33.46,Default,,0,0,0,,Cisco?
Dialogue: 0,0:01:34.17,0:01:37.05,Default,,0,0,0,,Мен бұл қараңғы атмосфераны өзгертемін.
Dialogue: 0,0:01:37.76,0:01:39.97,Default,,0,0,0,,Бұл айқай Шайтан
Dialogue: 0,0:01:40.39,0:01:43.22,Default,,0,0,0,,♪~
Dialogue: 0,0:01:43.31,0:01:45.60,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:45.68,0:01:48.23,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:48.31,0:01:50.69,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:50.77,0:01:53.19,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:53.27,0:01:54.82,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:54.90,0:01:59.16,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:00.07,0:02:04.83,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:04.91,0:02:09.87,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:09.96,0:02:14.67,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:14.75,0:02:19.76,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:19.84,0:02:24.60,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:24.68,0:02:29.85,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:29.94,0:02:33.06,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:33.15,0:02:34.77,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:34.86,0:02:37.19,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:37.28,0:02:39.78,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:39.86,0:02:41.78,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:41.87,0:02:43.16,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:43.24,0:02:44.78,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:44.87,0:02:47.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:47.37,0:02:53.38,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:53.46,0:02:57.80,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:57.92,0:03:00.68,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:00.76,0:03:03.26,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:03.34,0:03:05.72,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:05.81,0:03:09.81,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:11.19,0:03:14.11,Default,,0,0,0,,Қаһарлы! BC Соль шайқасы!
Dialogue: 0,0:03:18.15,0:03:23.03,Default,,0,0,0,,А тобының көңіл-күйі суыта бергенде, кезек В тобына!
Dialogue: 0,0:03:23.11,0:03:24.28,Default,,0,0,0,,Бірінші ойын
Dialogue: 0,0:03:24.37,0:03:27.08,Default,,0,0,0,,Тегін De La Hoya vs Song Luwei!
Dialogue: 0,0:03:27.62,0:03:30.37,Default,,0,0,0,,Матч Фри Де Ла Хойяның айқын жеңісі
Dialogue: 0,0:03:30.66,0:03:35.63,Default,,0,0,0,,Drain Fafnir Shelter Regulus-ты сәтті жеңді.
Dialogue: 0,0:03:36.09,0:03:37.63,Default,,0,0,0,,Содан кейін екінші сәйкестік
Dialogue: 0,0:03:37.71,0:03:40.38,Default,,0,0,0,,Руи Ширасаги және Джошуа Бун
Dialogue: 0,0:03:40.47,0:03:43.18,Default,,0,0,0,,Жеңімпаз Ширасадиджо Луи болды!
Dialogue: 0,0:03:43.43,0:03:46.18,Default,,0,0,0,,Қошмар Лонгинус Бластогиниусты алып кетеді...
Dialogue: 0,0:03:46.43,0:03:48.89,Default,,0,0,0,,Жарылу арқылы жеңіс!
Dialogue: 0,0:03:52.06,0:03:54.02,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,0:03:54.56,0:03:56.61,Default,,0,0,0,,Бұл өте күшті.
Dialogue: 0,0:03:56.69,0:04:01.74,Default,,0,0,0,,Ширасадиджо Луи берген рухтың күші Бэйге ие болып көрінді.
Dialogue: 0,0:04:02.11,0:04:03.78,Default,,0,0,0,,Шынымды айтсам, мен оны көрмедім.
Dialogue: 0,0:04:04.32,0:04:06.91,Default,,0,0,0,,Бұл ұрыс соңы емес.
Dialogue: 0,0:04:07.45,0:04:08.95,Default,,0,0,0,,Ұпайларды келесіде алуға болады
Dialogue: 0,0:04:09.74,0:04:13.46,Default,,0,0,0,,Trad Мен әрқашан мінсіз болғым келеді.
Dialogue: 0,0:04:13.83,0:04:15.42,Default,,0,0,0,,Жоғалту енді қабылданбайды
Dialogue: 0,0:04:16.08,0:04:17.92,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:04:18.00,0:04:19.92,Default,,0,0,0,,Келесі - Cisco.
Dialogue: 0,0:04:20.00,0:04:22.67,Default,,0,0,0,,Балт пен Куза жеңілді.
Dialogue: 0,0:04:22.76,0:04:24.76,Default,,0,0,0,,Бұлай айтпа
Dialogue: 0,0:04:25.09,0:04:27.01,Default,,0,0,0,,Өйткені бұл жиіркенішті.
Dialogue: 0,0:04:27.51,0:04:29.31,Default,,0,0,0,,Көңіл-күйімді көтеремін.
Dialogue: 0,0:04:29.76,0:04:32.73,Default,,0,0,0,,В блогының үшінші ойыны басталады!
Dialogue: 0,0:04:32.81,0:04:36.06,Default,,0,0,0,,Күшті қылыштың жарқырауы, Қайза жанып тұрған храм, қарсы...
Dialogue: 0,0:04:36.60,0:04:39.86,Default,,0,0,0,,Үнсіз жануар Cisco Carlyle
Dialogue: 0,0:04:39.94,0:04:42.57,Default,,0,0,0,,Екі оғаш аң соқтығысты!
Dialogue: 0,0:04:43.15,0:04:46.82,Default,,0,0,0,,Қайтадан сайысқа түскеніме қуаныштымын, Шәкеңжи Шақа!
Dialogue: 0,0:04:47.37,0:04:48.53,Default,,0,0,0,,Бұл Кайса.
Dialogue: 0,0:04:49.03,0:04:52.12,Default,,0,0,0,,Мен сенің мақтаншақ қылышыңды сындырамын.
Dialogue: 0,0:04:52.20,0:04:55.54,Default,,0,0,0,,Гахахахаха бәрі солай айтады.
Dialogue: 0,0:04:56.29,0:04:58.17,Default,,0,0,0,,Бірақ мен алмаймын
Dialogue: 0,0:04:58.42,0:05:00.13,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:05:03.05,0:05:05.59,Default,,0,0,0,,Иә, бұл тітіркендіргіш, Cisco.
Dialogue: 0,0:05:07.80,0:05:10.05,Default,,0,0,0,,Сәттілік, Cisco.
Dialogue: 0,0:05:12.14,0:05:13.39,Default,,0,0,0,,Сәлем, Cisco!
Dialogue: 0,0:05:13.47,0:05:14.48,Default,,0,0,0,,Менімен бірге жаттығу...
Dialogue: 0,0:05:14.56,0:05:15.98,Default,,0,0,0,,Бар, Вайверн
Dialogue: 0,0:05:16.06,0:05:19.02,Default,,0,0,0,,Супер торнадо шабуылы!
Dialogue: 0,0:05:23.61,0:05:24.90,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:05:24.99,0:05:26.82,Default,,0,0,0,,Сіз ұстап тұрсыз ба?
Dialogue: 0,0:05:26.90,0:05:28.03,Default,,0,0,0,,Не, балалар?
Dialogue: 0,0:05:28.45,0:05:30.78,Default,,0,0,0,,«Сен кімсің?» бұл сызық.
Dialogue: 0,0:05:31.20,0:05:34.25,Default,,0,0,0,,Вайхана, бұл жігіттің эксклюзивті жаттықтырушысы.
Dialogue: 0,0:05:34.62,0:05:36.21,Default,,0,0,0,,Жаттықтырушы?
Dialogue: 0,0:05:36.83,0:05:41.13,Default,,0,0,0,,Реалдың табалдырығын аттаған соң, бұл жігітті жалғыз қалдыра алмайсың.
Dialogue: 0,0:05:41.42,0:05:42.96,Default,,0,0,0,,Бұрынғы жолдас ретінде
Dialogue: 0,0:05:43.05,0:05:46.13,Default,,0,0,0,,Шақаны қалай құлату керектігі туралы кеңес беруге келдім.
Dialogue: 0,0:05:46.51,0:05:49.01,Default,,0,0,0,,Керемет! Қандай да бір стратегия бар ма?
Dialogue: 0,0:05:49.09,0:05:51.97,Default,,0,0,0,,Иә! Жаттықтырушыға қалдырсаңыз жақсы.
Dialogue: 0,0:05:52.06,0:05:54.22,Default,,0,0,0,,Кім сұрады? Не!
Dialogue: 0,0:05:54.35,0:05:56.64,Default,,0,0,0,,...Маған солай айтылған, солай ма?
Dialogue: 0,0:05:56.81,0:05:58.48,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:05:58.60,0:06:01.65,Default,,0,0,0,,Иә, менің өте дәл жаттықтыруыммен.
Dialogue: 0,0:06:01.73,0:06:04.48,Default,,0,0,0,,Cisco жеңіске жетуді жалғастыратын ойыншы ретінде қайта туады.
Dialogue: 0,0:06:04.90,0:06:08.32,Default,,0,0,0,,Басқаша айтқанда, таңғаларлық нәрсе ол бұл жігітті жеңіліссіз рекордқа жетеледі.
Dialogue: 0,0:06:08.40,0:06:09.95,Default,,0,0,0,,Вайчу Кочча!
Dialogue: 0,0:06:10.37,0:06:12.28,Default,,0,0,0,,Керемет Вакия!
Dialogue: 0,0:06:12.62,0:06:15.62,Default,,0,0,0,,Менің ойымша, бұл жай ғана Теме ерекшеленді.
Dialogue: 0,0:06:16.08,0:06:18.71,Default,,0,0,0,,Кәне, жалғастырайық, Cisco!
Dialogue: 0,0:06:18.79,0:06:21.38,Default,,0,0,0,,-де? Жаттықтырушы, стратегияңызды айтыңыз!
Dialogue: 0,0:06:21.46,0:06:23.13,Default,,0,0,0,,Жарайды, мен саған үйретемін.
Dialogue: 0,0:06:23.21,0:06:25.63,Default,,0,0,0,,Ей, ақымақ болма! Оны ойлаған мен болдым!
Dialogue: 0,0:06:25.76,0:06:26.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.38,0:06:30.51,Default,,0,0,0,,Қайза жанып тұрған ғибадатхана Мен сені талқандаймын
Dialogue: 0,0:06:30.97,0:06:32.05,Default,,0,0,0,,Ниет
Dialogue: 0,0:06:32.14,0:06:35.52,Default,,0,0,0,,Шақаның мыңғырғанын жеңсек, тағы да солай боламыз.
Dialogue: 0,0:06:36.10,0:06:38.64,Default,,0,0,0,,Бұрынғыдан екі есе көп болса, мені тыңдап, орындауға болады.
Dialogue: 0,0:06:38.73,0:06:40.77,Default,,0,0,0,,Міну уақыты келді!
Dialogue: 0,0:06:44.02,0:06:46.98,Default,,0,0,0,,Міне, бұл тамаша! Cisco операциясы!
Dialogue: 0,0:06:47.07,0:06:48.95,Default,,0,0,0,,Cisco-ға өтіңіз!
Dialogue: 0,0:06:49.28,0:06:51.41,Default,,0,0,0,,Оны маған беріңіз, Cisco!
Dialogue: 0,0:06:53.62,0:06:56.74,Default,,0,0,0,,Мен сені сүйемін, қарашы, үлкен ауыз
Dialogue: 0,0:06:57.25,0:06:58.54,Default,,0,0,0,,Мен де сені жақсы көремін
Dialogue: 0,0:06:58.62,0:07:01.79,Default,,0,0,0,,Сіздің жүзіңізде сенімді көзқарас бар!
Dialogue: 0,0:07:02.25,0:07:04.09,Default,,0,0,0,,Сіз маған айтасыз.
Dialogue: 0,0:07:04.75,0:07:06.25,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:07:11.47,0:07:13.26,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:07:13.47,0:07:16.39,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:16.93,0:07:19.77,Default,,0,0,0,,Барыңыз... Атыңыз!
Dialogue: 0,0:07:24.19,0:07:26.48,Default,,0,0,0,,Жақсы, соққы дәл мен көздегендей болды.
Dialogue: 0,0:07:26.86,0:07:28.99,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:07:29.07,0:07:32.99,Default,,0,0,0,,Уау! Crys Satan өте жылдамдықпен айналады!
Dialogue: 0,0:07:33.32,0:07:35.32,Default,,0,0,0,,Сіз ату күшіңізді арттырдыңыз ба?
Dialogue: 0,0:07:36.12,0:07:38.49,Default,,0,0,0,,Бірақ не істесең де, ол маған әсер етпейді!
Dialogue: 0,0:07:38.58,0:07:41.58,Default,,0,0,0,,Экскалибур! Жаса!
Dialogue: 0,0:07:44.13,0:07:46.59,Default,,0,0,0,,Мені өлтір, Шайтан!
Dialogue: 0,0:07:46.67,0:07:48.50,Default,,0,0,0,,Циклондық цикл!
Dialogue: 0,0:07:50.01,0:07:50.92,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:07:51.01,0:07:54.43,Default,,0,0,0,,Уау! Шайтанның күшті соққысы!
Dialogue: 0,0:07:54.80,0:07:55.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:55.80,0:07:58.10,Default,,0,0,0,,Әлгі Шақа итеріп жатқан жоқ па?
Dialogue: 0,0:07:58.64,0:08:01.52,Default,,0,0,0,,Хохо, бұл өте күшті.
Dialogue: 0,0:08:02.02,0:08:04.15,Default,,0,0,0,,Коучингке рахмет
Dialogue: 0,0:08:04.23,0:08:06.98,Default,,0,0,0,,Иә, бұл бір кадр мен Шақа үшін жұмыс істеді.
Dialogue: 0,0:08:09.44,0:08:10.94,Default,,0,0,0,,Қаш, Шайтан!
Dialogue: 0,0:08:11.24,0:08:14.82,Default,,0,0,0,,Қаһарлы шайқас жалғасуда.
Dialogue: 0,0:08:17.78,0:08:21.33,Default,,0,0,0,,Үш есе әсер ету!
Dialogue: 0,0:08:24.00,0:08:25.37,Default,,0,0,0,,(сыртқы дыбыс)
Dialogue: 0,0:08:32.26,0:08:34.84,Default,,0,0,0,,Зиг Экскалибур аяқталды
Dialogue: 0,0:08:34.93,0:08:37.60,Default,,0,0,0,,Жанып тұрған ғибадатхана Кайзаға 1 ұпай
Dialogue: 0,0:08:38.01,0:08:40.60,Default,,0,0,0,,Менің ойымша, бұл оңай емес.
Dialogue: 0,0:08:40.68,0:08:42.06,Default,,0,0,0,,Ах~
Dialogue: 0,0:08:42.60,0:08:43.77,Default,,0,0,0,,(Тодороки) Камино… (Камино) Жарайды, алдым.
Dialogue: 0,0:08:43.85,0:08:46.10,Default,,0,0,0,,Мен сені оңай жеңе алмаймын.
Dialogue: 0,0:08:46.19,0:08:48.31,Default,,0,0,0,,Мен бұл тамаша болады деп ойладым
Dialogue: 0,0:08:48.65,0:08:51.82,Default,,0,0,0,,Сіз не істеп жатырсыз, Cisco?
Dialogue: 0,0:08:52.28,0:08:54.78,Default,,0,0,0,,(Cisco терең тыныс алады)
Dialogue: 0,0:08:55.91,0:08:58.53,Default,,0,0,0,,Кеттік, Крис Сатан
Dialogue: 0,0:08:59.45,0:09:00.62,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:09:01.12,0:09:02.95,Default,,0,0,0,,Мен сені келесі жолы өлтіремін!
Dialogue: 0,0:09:03.50,0:09:05.87,Default,,0,0,0,,Асықпа, мен жеңемін
Dialogue: 0,0:09:06.25,0:09:07.96,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:09:08.29,0:09:11.05,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:11.42,0:09:13.92,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:14.01,0:09:14.97,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:09:15.09,0:09:16.84,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:09:16.93,0:09:20.93,Default,,0,0,0,,Қайзаны кесіп тастайды ма? Қайза қуып жете ала ма? Cisco Carlyle қуып жете ме?
Dialogue: 0,0:09:23.02,0:09:28.40,Default,,0,0,0,,Мен орасан зор күшті, қайталанатын күшті шабуылдарды сезінемін.
Dialogue: 0,0:09:31.73,0:09:33.07,Default,,0,0,0,,Оны алыңыз.
Dialogue: 0,0:09:33.15,0:09:36.95,Default,,0,0,0,,Бұл жылтыратылған теңдесі жоқ қылыш.
Dialogue: 0,0:09:37.03,0:09:41.66,Default,,0,0,0,,Зиг Экскалибур!
Dialogue: 0,0:09:50.25,0:09:51.21,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:09:52.63,0:09:54.84,Default,,0,0,0,,Таенуке Шайтанды жылат!
Dialogue: 0,0:10:01.80,0:10:03.18,Default,,0,0,0,,(үру)
Dialogue: 0,0:10:05.31,0:10:06.56,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:10:07.44,0:10:08.98,Default,,0,0,0,,Ах... ну!
Dialogue: 0,0:10:11.65,0:10:13.27,Default,,0,0,0,,(Маниш Бой) Сен, жексұрын! Менің тамағымды жеуге батылың жетпесін!
Dialogue: 0,0:10:14.28,0:10:16.69,Default,,0,0,0,,Crys Satan Burst Finish
Dialogue: 0,0:10:16.78,0:10:18.82,Default,,0,0,0,,Жеңімпаз Cisco Carlyle
Dialogue: 0,0:10:18.90,0:10:21.12,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:10:21.20,0:10:25.33,Default,,0,0,0,,Crys Satan Джейк Экскалибурды сәтті жеңді!
Dialogue: 0,0:10:25.41,0:10:27.58,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:10:30.00,0:10:33.04,Default,,0,0,0,,Мұның бәрі Cisco арқасында.
Dialogue: 0,0:10:33.42,0:10:35.17,Default,,0,0,0,,Cisco жеңді!
Dialogue: 0,0:10:35.25,0:10:37.84,Default,,0,0,0,,Керемет, ол өте керемет!
Dialogue: 0,0:10:37.92,0:10:39.55,Default,,0,0,0,,Кимета!
Dialogue: 0,0:10:39.63,0:10:42.09,Default,,0,0,0,,Cisco Бұл тамаша!
Dialogue: 0,0:10:42.18,0:10:43.85,Default,,0,0,0,,Мен өзімді сондай сергек сезіндім!
Dialogue: 0,0:10:44.22,0:10:47.64,Default,,0,0,0,,Бұл Балто мен Кузаға біраз серпін береді.
Dialogue: 0,0:10:47.73,0:10:50.10,Default,,0,0,0,,Сіз қызықты нәрсе ойлап тапқан болуыңыз керек.
Dialogue: 0,0:10:50.73,0:10:51.98,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:52.52,0:10:56.90,Default,,0,0,0,,Шака үш есе соққымен итеру мүмкіндігіне ие.
Dialogue: 0,0:10:57.36,0:11:01.16,Default,,0,0,0,,Оның құдіреті мен рухына кез келген адам тәнті болар еді.
Dialogue: 0,0:11:01.53,0:11:02.74,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:11:03.20,0:11:07.41,Default,,0,0,0,,Дегенмен, Cisco оған тура жүгірді.
Dialogue: 0,0:11:07.87,0:11:11.37,Default,,0,0,0,,Triple Impact қарсыласқа үлкен зиян келтіреді, бірақ
Dialogue: 0,0:11:11.50,0:11:16.21,Default,,0,0,0,,Екінші жағынан, егер қарсылас бәрін қабылдаса, сіз реакцияны аласыз.
Dialogue: 0,0:11:16.71,0:11:18.71,Default,,0,0,0,,Cisco осы мақсатты көздеді.
Dialogue: 0,0:11:18.80,0:11:23.72,Default,,0,0,0,,Сонымен қатар, Шайтан қабырғаға соғылған кезде, ол зақымдануды азайту үшін роликті пайдаланады...
Dialogue: 0,0:11:24.18,0:11:26.97,Default,,0,0,0,,Бұл ылғалдың алдын алады дегенді білдірмейді.
Dialogue: 0,0:11:27.35,0:11:30.23,Default,,0,0,0,,Тек етін кесіп, сүйекті кесіңіз.
Dialogue: 0,0:11:30.69,0:11:33.19,Default,,0,0,0,,Хмм, бұл бір жеңіс өте үлкен.
Dialogue: 0,0:11:33.69,0:11:35.86,Default,,0,0,0,,Cisco сенімділікке ие болуы керек.
Dialogue: 0,0:11:36.23,0:11:37.61,Default,,0,0,0,,көремін.
Dialogue: 0,0:11:37.69,0:11:39.07,Default,,0,0,0,,Cisco Awesome!
Dialogue: 0,0:11:39.19,0:11:41.15,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:41.36,0:11:43.32,Default,,0,0,0,,Cisco!
Dialogue: 0,0:11:43.91,0:11:46.03,Default,,0,0,0,,Эй, мен соққыға жығылдым.
Dialogue: 0,0:11:46.58,0:11:49.04,Default,,0,0,0,,Мен айттым ба? қылышты сындыру
Dialogue: 0,0:11:49.37,0:11:51.87,Default,,0,0,0,,Бұл менің де бағындыратын жолым бар екенін білдіреді.
Dialogue: 0,0:11:51.96,0:11:54.29,Default,,0,0,0,,Гаххахаха
Dialogue: 0,0:11:58.80,0:12:00.05,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:12:00.13,0:12:03.22,Default,,0,0,0,,Мен не айтып тұрғаныңызды білемін, бірақ мен оны бақылап отырдым.
Dialogue: 0,0:12:03.88,0:12:06.18,Default,,0,0,0,,Үлкен 5-ті жеңген ат
Dialogue: 0,0:12:06.26,0:12:09.27,Default,,0,0,0,,Сіз оны нағыз самбатта шайқай аласыз ба?
Dialogue: 0,0:12:09.52,0:12:10.77,Default,,0,0,0,,№
Dialogue: 0,0:12:10.85,0:12:12.10,Default,,0,0,0,,Не!
Dialogue: 0,0:12:12.48,0:12:13.89,Default,,0,0,0,,BC Сол жақсы
Dialogue: 0,0:12:14.73,0:12:15.90,Default,,0,0,0,,Қазір не болып жатыр?
Dialogue: 0,0:12:19.07,0:12:22.32,Default,,0,0,0,,Сіздің кеңесіңіз пайдалы болды.
Dialogue: 0,0:12:23.03,0:12:25.99,Default,,0,0,0,,Не, сіз қазірдің өзінде жақсы болуға тырысып жатырсыз ба?
Dialogue: 0,0:12:29.54,0:12:32.08,Default,,0,0,0,,Бұл өте қызу шайқас болды.
Dialogue: 0,0:12:32.37,0:12:33.79,Default,,0,0,0,,«Өте»?
Dialogue: 0,0:12:34.12,0:12:36.04,Default,,0,0,0,,Сіз не қарап тұрдыңыз?
Dialogue: 0,0:12:36.33,0:12:37.71,Default,,0,0,0,,Cisco Carlyle...
Dialogue: 0,0:12:37.79,0:12:40.34,Default,,0,0,0,,Мен мұндай алысқа барамын деп ешқашан ойламадым.
Dialogue: 0,0:12:40.46,0:12:42.84,Default,,0,0,0,,Мен оған жеңілген жоқпын.
Dialogue: 0,0:12:43.30,0:12:45.80,Default,,0,0,0,,Бұл менмін! Мен өз бетімше сүріндім
Dialogue: 0,0:12:46.64,0:12:47.80,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:48.35,0:12:50.18,Default,,0,0,0,,Мен тіпті таң қалдым...
Dialogue: 0,0:12:50.43,0:12:54.19,Default,,0,0,0,,Алдымдағы жігітке қарағанда мен Куришуға тым санамда болдым.
Dialogue: 0,0:12:54.52,0:12:55.90,Default,,0,0,0,,Сіз Қызыл көз туралы айтып отырсыз ба?
Dialogue: 0,0:12:56.02,0:12:57.73,Default,,0,0,0,,Мен де, менде әлі алда көп.
Dialogue: 0,0:12:58.23,0:13:01.53,Default,,0,0,0,,Мүмкін оның жеңісі басынан шешілген шығар.
Dialogue: 0,0:13:02.36,0:13:06.49,Default,,0,0,0,,Бірақ мен енді бұлай жеңілмеймін.
Dialogue: 0,0:13:07.36,0:13:12.37,Default,,0,0,0,,Сонымен, God Bladers кубогының бірінші раунды бағдарламасы аяқталды!
Dialogue: 0,0:13:12.91,0:13:15.21,Default,,0,0,0,,Топтық ұпай жинайтын саптама – бұл-
Dialogue: 0,0:13:15.29,0:13:18.54,Default,,0,0,0,,Курц Баратиер Қызыл көз Норман Тарвер
Dialogue: 0,0:13:19.79,0:13:22.21,Default,,0,0,0,,В тобында ұпай жинаған пышақшылар:
Dialogue: 0,0:13:22.30,0:13:26.76,Default,,0,0,0,,Тегін De La Hoya Shirasagi Castle Louis Cisco Carlayle
Dialogue: 0,0:13:27.22,0:13:31.39,Default,,0,0,0,,Өкінішке орай, мен бүгін ұпайсыз қалдым.
Dialogue: 0,0:13:32.01,0:13:34.27,Default,,0,0,0,,Ертең екінші раундта мені өлтіріңіз.
Dialogue: 0,0:13:34.56,0:13:37.39,Default,,0,0,0,,Міне, ертеңгі жауынгерлік карта!
Dialogue: 0,0:13:40.23,0:13:41.94,Default,,0,0,0,,Ой, балалар.
Dialogue: 0,0:13:42.61,0:13:44.86,Default,,0,0,0,,О, жанып тұр!
Dialogue: 0,0:13:44.94,0:13:46.61,Default,,0,0,0,,Аники Кузаға қарсы ма?
Dialogue: 0,0:13:47.45,0:13:50.16,Default,,0,0,0,,Командаластар арасындағы текетірес дегеніміз не?
Dialogue: 0,0:13:50.62,0:13:52.20,Default,,0,0,0,,Балтық Куза
Dialogue: 0,0:13:52.28,0:13:54.45,Default,,0,0,0,,Мен сенің ертеңгі күніңнің бәрін жасағаныңды қалаймын.
Dialogue: 0,0:13:55.16,0:13:57.16,Default,,0,0,0,,Менің айта алатыным осы ғана.
Dialogue: 0,0:13:57.79,0:13:59.96,Default,,0,0,0,,Білемін, бар күшімді саламын!
Dialogue: 0,0:14:00.04,0:14:03.63,Default,,0,0,0,,О! Өйткені сендер жаусыңдар.
Dialogue: 0,0:14:04.59,0:14:05.97,Default,,0,0,0,,Бладер және-
Dialogue: 0,0:14:06.05,0:14:09.05,Default,,0,0,0,,Турнирді қызықты еткен көрермендерге!
Dialogue: 0,0:14:09.13,0:14:11.89,Default,,0,0,0,,Ертең де өте ыстық болады, қызық болайық.
Dialogue: 0,0:14:11.97,0:14:14.27,Default,,0,0,0,,Келесі кездескенше!
Dialogue: 0,0:14:20.31,0:14:22.36,Default,,0,0,0,,Аники, сен жақсы жейсің.
Dialogue: 0,0:14:22.44,0:14:24.53,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:14:24.61,0:14:26.94,Default,,0,0,0,,Бұл жеуге болатын нәрсе, сондықтан...
Dialogue: 0,0:14:27.03,0:14:29.74,Default,,0,0,0,,Жемесем ысырап болар еді.
Dialogue: 0,0:14:30.28,0:14:33.03,Default,,0,0,0,,Қарап-ақ тойып бара жатқандай боламын
Dialogue: 0,0:14:33.62,0:14:34.99,Default,,0,0,0,,Сіз қанша уақыт тамақ ішіп жүрсіз?
Dialogue: 0,0:14:35.33,0:14:36.50,Default,,0,0,0,,Тағы біраз
Dialogue: 0,0:14:36.58,0:14:39.16,Default,,0,0,0,,Тамақты ішіп болған соң жаттығамыз деп айтпадым ба?
Dialogue: 0,0:14:39.29,0:14:42.33,Default,,0,0,0,,Ах~ менің стейк~
Dialogue: 0,0:14:42.42,0:14:44.50,Default,,0,0,0,,Жарайды, мен де қосыламын.
Dialogue: 0,0:14:45.09,0:14:48.51,Default,,0,0,0,,Йою Cisco Shaka-ны жеңген сияқты.
Dialogue: 0,0:14:48.97,0:14:52.85,Default,,0,0,0,,Мен әрқашан сенімді адам едім, бірақ қазір мен бір сатыға көтерілдім.
Dialogue: 0,0:14:52.93,0:14:54.31,Default,,0,0,0,,Мен солай сезінемін.
Dialogue: 0,0:14:55.93,0:14:56.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:59.48,0:15:00.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:04.52,0:15:05.82,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:15:06.36,0:15:07.82,Default,,0,0,0,,Осы турнир туралы
Dialogue: 0,0:15:08.28,0:15:09.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:09.32,0:15:11.16,Default,,0,0,0,,Сіз бұл балық деп ойламайсыз ба?
Dialogue: 0,0:15:11.66,0:15:13.49,Default,,0,0,0,,Жылан шұңқыры туралы.
Dialogue: 0,0:15:13.78,0:15:18.41,Default,,0,0,0,,Ресми матчтарда рекорды жоқ екі адам, Боа және Норман бар.
Dialogue: 0,0:15:18.50,0:15:21.08,Default,,0,0,0,,Кірген жексұрын оқиға.
Dialogue: 0,0:15:21.21,0:15:22.21,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:15:22.63,0:15:25.00,Default,,0,0,0,,Сіз де ашрамда кездесіп жатырсыз, солай ма?
Dialogue: 0,0:15:25.17,0:15:28.34,Default,,0,0,0,,Әй, бетперде киген қария солай жасады.
Dialogue: 0,0:15:28.80,0:15:30.80,Default,,0,0,0,,Бұл турнир-
Dialogue: 0,0:15:30.88,0:15:33.68,Default,,0,0,0,,Оның тынысы менде деп анық ойлаймын.
Dialogue: 0,0:15:34.80,0:15:37.43,Default,,0,0,0,,Бір-бірімізге абай болайық.
Dialogue: 0,0:15:42.10,0:15:45.23,Default,,0,0,0,,Досым, жаттығуды бастайық.
Dialogue: 0,0:15:46.07,0:15:47.61,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:48.23,0:15:50.07,Default,,0,0,0,,Мен бұл туралы қазір ойлап отырмын.
Dialogue: 0,0:15:50.61,0:15:51.82,Default,,0,0,0,,Не?
Dialogue: 0,0:15:52.28,0:15:54.66,Default,,0,0,0,,Балто барған сайын күшейіп келеді.
Dialogue: 0,0:15:54.74,0:15:57.08,Default,,0,0,0,,Осындай үлкен жерде Балтомен күресу...
Dialogue: 0,0:15:57.16,0:15:59.79,Default,,0,0,0,,Мен толқып тұрмын, бірақ мен қобалжыдым.
Dialogue: 0,0:16:00.12,0:16:02.92,Default,,0,0,0,,Бұл Хум сияқты емес пе?
Dialogue: 0,0:16:03.37,0:16:06.46,Default,,0,0,0,,Бірақ бұл турнирде Балт та, Cisco да жау.
Dialogue: 0,0:16:06.75,0:16:10.55,Default,,0,0,0,,Жауды ойласам, ішім астынан оқ атылады.
Dialogue: 0,0:16:10.80,0:16:14.47,Default,,0,0,0,,"Мен жеңіле алмаймын. Мен бұл жігітті міндетті түрде жеңемін".
Dialogue: 0,0:16:15.09,0:16:17.30,Default,,0,0,0,,«Мен міндетті түрде жеңемін» деген жақсы сөз.
Dialogue: 0,0:16:17.85,0:16:21.06,Default,,0,0,0,,Олай болса, досым, ертең үшін күресейік.
Dialogue: 0,0:16:21.60,0:16:23.06,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:16:23.31,0:16:25.02,Default,,0,0,0,,Yall Yall
Dialogue: 0,0:16:31.69,0:16:34.70,Default,,0,0,0,,Блейдерлер мен көрермендер!
Dialogue: 0,0:16:34.78,0:16:38.49,Default,,0,0,0,,Менің ойымша, сіз кеше қатты толқып, ұйықтай алмай қалдыңыз ба?
Dialogue: 0,0:16:38.58,0:16:40.24,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:16:40.41,0:16:42.79,Default,,0,0,0,,Жарайды, көзіңді аш.
Dialogue: 0,0:16:42.87,0:16:46.21,Default,,0,0,0,,Бүгін де Бейбатл жақсы өтеді деп үміттенемін.
Dialogue: 0,0:16:46.83,0:16:50.05,Default,,0,0,0,,God Bladers Cup 2-ші күн 2-ші кезең
Dialogue: 0,0:16:50.13,0:16:52.30,Default,,0,0,0,,Бүгін қайтадан жанады
Dialogue: 0,0:16:52.38,0:16:57.26,Default,,0,0,0,,Енді, барлық таңдаған пышақшылар, маған ең жақсы шайқасты көрсетіңіздер!
Dialogue: 0,0:17:05.60,0:17:08.11,Default,,0,0,0,,Қатысушыларды өтінемін
Dialogue: 0,0:17:08.61,0:17:09.65,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:17:09.73,0:17:11.07,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:17:11.98,0:17:14.86,Default,,0,0,0,,Топтық екінші турдың бірінші ойыны
Dialogue: 0,0:17:15.24,0:17:18.62,Default,,0,0,0,,Blue Flame Challenger Aoi Balt!
Dialogue: 0,0:17:18.70,0:17:23.12,Default,,0,0,0,,Үнемі өзгеретін Blader Куза Акерманға қарсы!
Dialogue: 0,0:17:23.62,0:17:25.25,Default,,0,0,0,,Екеуіне де сәттілік!
Dialogue: 0,0:17:25.41,0:17:28.33,Default,,0,0,0,,Барто Куза Сәттілік!
Dialogue: 0,0:17:28.96,0:17:31.96,Default,,0,0,0,,Бұл екеуі де BC Sol мүшелері.
Dialogue: 0,0:17:32.05,0:17:34.88,Default,,0,0,0,,Бір-бірінің сырын білетін жүздер
Dialogue: 0,0:17:34.97,0:17:39.51,Default,,0,0,0,,Қандай шайқас болады? Бұл көптің назарын аударатын шайқас!
Dialogue: 0,0:17:40.43,0:17:42.68,Default,,0,0,0,,Барымызды салайық, Куза.
Dialogue: 0,0:17:43.68,0:17:47.14,Default,,0,0,0,,Егер Балт ең жақсы жағдайда болса, онда бұл оның ең жақсысы.
Dialogue: 0,0:17:47.85,0:17:50.77,Default,,0,0,0,,Егер солай болса, бұл Чо Чо Чо Чо
Dialogue: 0,0:17:51.48,0:17:54.19,Default,,0,0,0,,Бұл не? Міне, чо-чо-чо-чо...
Dialogue: 0,0:17:54.28,0:17:56.78,Default,,0,0,0,,Балалар... Осы жеткілікті ме?
Dialogue: 0,0:17:57.28,0:18:01.37,Default,,0,0,0,,Бұл шайқас алдында да ыстық ұшқын болды деп айтуға бола ма?
Dialogue: 0,0:18:01.45,0:18:03.91,Default,,0,0,0,,Әйтеуір, екі күрескер қақтығысады!
Dialogue: 0,0:18:03.99,0:18:06.71,Default,,0,0,0,,Бұл шайқас керемет болады!
Dialogue: 0,0:18:07.50,0:18:09.42,Default,,0,0,0,,Олар не істеп жатыр...
Dialogue: 0,0:18:10.08,0:18:12.50,Default,,0,0,0,,Бірақ бұл екеуі сияқты.
Dialogue: 0,0:18:19.30,0:18:21.47,Default,,0,0,0,,Қандай сәйкестік!
Dialogue: 0,0:18:21.55,0:18:25.27,Default,,0,0,0,,Burst Burst Burst!
Dialogue: 0,0:18:25.39,0:18:27.10,Default,,0,0,0,,Бір уақыттағы жарылыстар тоқтамайды!
Dialogue: 0,0:18:27.39,0:18:30.48,Default,,0,0,0,,Тағы да! Бұл керемет фестиваль, Куза!
Dialogue: 0,0:18:30.90,0:18:32.94,Default,,0,0,0,,Бұл жанып тұр, Балто!
Dialogue: 0,0:18:33.48,0:18:35.53,Default,,0,0,0,,Екеуің көңілді жүрген сияқтысыңдар.
Dialogue: 0,0:18:35.82,0:18:39.24,Default,,0,0,0,,Егер сіз осыншама жарылыс жасасаңыз, бұл қызықты болады!
Dialogue: 0,0:18:39.61,0:18:40.78,Default,,0,0,0,,Бесінші шайқас
Dialogue: 0,0:18:41.99,0:18:43.62,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:44.03,0:18:46.62,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:47.37,0:18:49.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:51.42,0:18:55.05,Default,,0,0,0,,Енді бесінші шайқас. Бұл жерде шайқас шешіледі ме? ?
Dialogue: 0,0:18:55.13,0:18:57.34,Default,,0,0,0,,5 рет Екеуі де жарылды! ?
Dialogue: 0,0:19:00.47,0:19:01.43,Default,,0,0,0,,О
Dialogue: 0,0:19:04.35,0:19:05.81,Default,,0,0,0,,А... тез!
Dialogue: 0,0:19:05.89,0:19:07.77,Default,,0,0,0,,А, жарайды!
Dialogue: 0,0:19:10.77,0:19:11.77,Default,,0,0,0,,Не?
Dialogue: 0,0:19:12.19,0:19:13.98,Default,,0,0,0,,Қозғалыс өзгерді, солай ма?
Dialogue: 0,0:19:21.57,0:19:24.07,Default,,0,0,0,,Ах... Сәттілік Кронос!
Dialogue: 0,0:19:24.20,0:19:27.58,Default,,0,0,0,,Валькириге ұшатын реактивті ату!
Dialogue: 0,0:19:29.08,0:19:30.91,Default,,0,0,0,,Бұл не деген сұмдық! ?
Dialogue: 0,0:19:31.00,0:19:34.88,Default,,0,0,0,,Валькири бұрынғыдан да қатыгез~
Dialogue: 0,0:19:35.79,0:19:38.46,Default,,0,0,0,,Уау, бұл неткен өрескел!
Dialogue: 0,0:19:41.05,0:19:44.39,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:19:47.18,0:19:48.85,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:52.69,0:19:54.61,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:58.19,0:20:01.11,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:20:01.24,0:20:03.07,Default,,0,0,0,,Жеңімпаз Барто Аои!
Dialogue: 0,0:20:03.95,0:20:06.74,Default,,0,0,0,,Уау, мен жасадым!
Dialogue: 0,0:20:07.12,0:20:08.54,Default,,0,0,0,,Аники!
Dialogue: 0,0:20:08.66,0:20:10.37,Default,,0,0,0,,Екеуі де керемет!
Dialogue: 0,0:20:10.70,0:20:13.92,Default,,0,0,0,,Куза да тамаша жұмыс жасады!
Dialogue: 0,0:20:14.37,0:20:16.50,Default,,0,0,0,,Бұл шайқас қызықты болды!
Dialogue: 0,0:20:17.13,0:20:19.71,Default,,0,0,0,,Мен иесі болдым
Dialogue: 0,0:20:19.80,0:20:22.84,Default,,0,0,0,,Осындай қызу шайқас көргім келгендіктен болар.
Dialogue: 0,0:20:25.72,0:20:28.14,Default,,0,0,0,,Кронос, сен қолыңнан келгеннің бәрін жасадың.
Dialogue: 0,0:20:28.43,0:20:30.14,Default,,0,0,0,,О, мен сондай бақыттымын.
Dialogue: 0,0:20:30.72,0:20:33.81,Default,,0,0,0,,Айбо, финалдық шайқас керемет болды.
Dialogue: 0,0:20:34.02,0:20:35.56,Default,,0,0,0,,Есеп айырысу~!
Dialogue: 0,0:20:35.65,0:20:40.03,Default,,0,0,0,,Бесінші шайқаста қиян-кескі шайқаста жеңіске жеткен – Балто Аои!
Dialogue: 0,0:20:40.11,0:20:44.03,Default,,0,0,0,,Осы қызу шайқасқа көрсеткендері үшін осы екеуіне алғыс айтамыз!
Dialogue: 0,0:20:44.11,0:20:46.32,Default,,0,0,0,,(шығанақтың бұрылу дыбысы)
Dialogue: 0,0:20:57.25,0:20:59.13,Default,,0,0,0,,Рахмет сізге Валькири
Dialogue: 0,0:20:59.50,0:21:01.96,Default,,0,0,0,,Соңғы Валькирия керемет болды
Dialogue: 0,0:21:02.05,0:21:04.47,Default,,0,0,0,,Бұл жеделдету бірден қолданылғандай болды.
Dialogue: 0,0:21:04.84,0:21:06.84,Default,,0,0,0,,А... иә?
Dialogue: 0,0:21:09.60,0:21:12.85,Default,,0,0,0,,Ах! Байланысты қабат өте ашық!
Dialogue: 0,0:21:12.93,0:21:15.10,Default,,0,0,0,,Қара, Куза, қара!
Dialogue: 0,0:21:15.69,0:21:17.23,Default,,0,0,0,,Уау, бұл рас!
Dialogue: 0,0:21:18.44,0:21:19.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:20.27,0:21:23.11,Default,,0,0,0,,Қазір қызық болып барады.
Dialogue: 0,0:21:23.86,0:21:25.70,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:25.78,0:21:27.07,Default,,0,0,0,,Фофофу
Dialogue: 0,0:21:27.16,0:21:29.32,Default,,0,0,0,,Бұл Валькирияның байланысқан қабаты.
Dialogue: 0,0:21:29.95,0:21:33.20,Default,,0,0,0,,Кузамен шайқаста ол барынша ашылады -
Dialogue: 0,0:21:33.29,0:21:36.87,Default,,0,0,0,,Енді көбірек динамикалық қозғалыстар мүмкін.
Dialogue: 0,0:21:37.33,0:21:39.21,Default,,0,0,0,,Үздіксіз жарылыс болғандықтан ба?
Dialogue: 0,0:21:39.54,0:21:43.88,Default,,0,0,0,,Бұл Геки Құдай Чиптің кезегі.
Dialogue: 0,0:21:44.13,0:21:45.42,Default,,0,0,0,,Эх!
Dialogue: 0,0:21:47.43,0:21:48.76,Default,,0,0,0,,Не? Ол ашық, солай ма?
Dialogue: 0,0:21:48.84,0:21:50.35,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:21:50.89,0:21:53.18,Default,,0,0,0,,Мм... ой, балалар.
Dialogue: 0,0:21:55.48,0:21:56.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.44,0:21:59.98,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.44,0:21:59.98,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, бұлшық еттеріңді жаттығып жатырсыңдар ма?
Dialogue: 0,0:22:00.06,0:22:02.98,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.07,0:22:06.95,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:07.03,0:22:10.62,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.70,0:22:14.37,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдату!
Dialogue: 0,0:22:14.45,0:22:17.96,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.04,0:22:21.42,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.50,0:22:24.84,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.92,0:22:28.84,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді күшейтемін.
Dialogue: 0,0:22:28.93,0:22:32.76,Default,,0,0,0,,GO ату GO ату Бей бұлшық ет поезы Моримори
Dialogue: 0,0:22:32.85,0:22:36.35,Default,,0,0,0,,GO АТТЫ БАР АТТЫ Менің атысым - құдайдың атысы
Dialogue: 0,0:22:36.43,0:22:40.10,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.19,0:22:43.86,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:43.94,0:22:47.44,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.53,0:22:51.28,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.37,0:22:54.99,Default,,0,0,0,,Күн сайын барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:55.08,0:22:58.46,Default,,0,0,0,,Жыл бойы көктемде, жазда, күзде және қыста GO түсіреді
Dialogue: 0,0:22:58.54,0:23:00.04,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.12,0:23:02.67,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.75,0:23:05.88,Default,,0,0,0,,Сол шиеленіспен шарықтау шегіне жетейік!
Dialogue: 0,0:23:05.96,0:23:09.72,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Келіңіздер!
Dialogue: 0,0:23:09.80,0:23:13.18,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.26,0:23:17.02,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.10,0:23:19.94,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.94,0:23:21.94,Default,,0,0,0,,Үш екі бір GO Shoot Burst Finish!
Dialogue: 0,0:23:19.94,0:23:21.94,Default,,0,0,0,,~♪
Dialogue: 0,0:23:21.94,0:23:22.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:25.07,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:25.07,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.07,0:23:25.44,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.48,0:23:29.03,Default,,0,0,0,,Бұл таңғажайып шайқас жалғасуда.
Dialogue: 0,0:23:29.11,0:23:32.91,Default,,0,0,0,,Алдымен Шака Лувейге қарсы, содан кейін Курц Редейге қарсы
Dialogue: 0,0:23:32.99,0:23:35.95,Default,,0,0,0,,Әрі қарай Джошуа Еркін Норман Боаға қарсы
Dialogue: 0,0:23:36.03,0:23:38.16,Default,,0,0,0,,Бұл Cisco және Луис!
Dialogue: 0,0:23:38.25,0:23:41.50,Default,,0,0,0,,Финалдық турнирге кім барады?
Dialogue: 0,0:23:41.87,0:23:43.79,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:44.13,0:23:46.17,Default,,0,0,0,,Қыздыру! Керемет бәсекелестік!
Dialogue: 0,0:23:46.59,0:23:49.76,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.26,0:23:57.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory