Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.54,0:00:07.17,Default,,0,0,0,,wbba әлемдік лигасы
Dialogue: 0,0:00:07.71,0:00:09.88,Default,,0,0,0,,Әр лигада жеңіске жеткен клубтар...
Dialogue: 0,0:00:10.17,0:00:12.84,Default,,0,0,0,,Әлемнің шыңына қарай шайқас
Dialogue: 0,0:00:13.09,0:00:14.55,Default,,0,0,0,,Чемпион болуды мақсат етіңіз
Dialogue: 0,0:00:14.84,0:00:16.51,Default,,0,0,0,,Қолға алу үшін бірінші нөмір
Dialogue: 0,0:00:16.97,0:00:18.51,Default,,0,0,0,,Жауынгерлік рухыңызды өртеп жіберіңіз
Dialogue: 0,0:00:18.60,0:00:20.27,Default,,0,0,0,,Және шектен шығу
Dialogue: 0,0:00:20.97,0:00:22.43,Default,,0,0,0,,Жалынды жандардың шайқасы
Dialogue: 0,0:00:22.81,0:00:24.98,Default,,0,0,0,,Дүниені отқа сал
Dialogue: 0,0:00:25.81,0:00:27.27,Default,,0,0,0,,Даңққа кім ие болады?
Dialogue: 0,0:00:27.94,0:00:29.19,Default,,0,0,0,,Бұл – тура қызыл карта. (Бакуго) Тс.
Dialogue: 0,0:00:31.03,0:00:32.82,Default,,0,0,0,,Әлемдік лиганың жартылай финалы
Dialogue: 0,0:00:33.15,0:00:35.45,Default,,0,0,0,,BC Sol және Бразилия Риосы
Dialogue: 0,0:00:35.70,0:00:38.45,Default,,0,0,0,,Бірінші ойын - Cisco мен Shaka арасындағы қақтығыс!
Dialogue: 0,0:00:38.53,0:00:40.70,Default,,0,0,0,,Сәлем! Оны аяқтаңыз
Dialogue: 0,0:00:40.83,0:00:42.20,Default,,0,0,0,,Шайтанды жылат!
Dialogue: 0,0:00:45.21,0:00:47.38,Default,,0,0,0,,Ал, баста!
Dialogue: 0,0:00:47.46,0:00:49.13,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:00:49.34,0:00:50.09,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:00:51.71,0:00:52.59,Default,,0,0,0,,(рок дыбысы)
Dialogue: 0,0:00:52.76,0:00:55.97,Default,,0,0,0,,Циклондық цикл!
Dialogue: 0,0:00:58.05,0:00:59.14,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:59.89,0:01:02.31,Default,,0,0,0,,Cisco, сіз жақсы нүктеге жеттіңіз.
Dialogue: 0,0:01:02.52,0:01:03.68,Default,,0,0,0,,Шақа мықты болды
Dialogue: 0,0:01:04.43,0:01:06.52,Default,,0,0,0,,Бірінші ойында Шака жеңеді.
Dialogue: 0,0:01:06.81,0:01:09.31,Default,,0,0,0,,Ал екінші ойын – Хиксон мен Стэн.
Dialogue: 0,0:01:09.40,0:01:11.40,Default,,0,0,0,,(Соқтығыс/шығу дыбысы)
Dialogue: 0,0:01:11.78,0:01:13.19,Default,,0,0,0,,Не?
Dialogue: 0,0:01:13.36,0:01:15.36,Default,,0,0,0,,Бұл жолы Хиксон жеңеді!
Dialogue: 0,0:01:15.74,0:01:18.03,Default,,0,0,0,,Ойын саны енді 1:1.
Dialogue: 0,0:01:18.70,0:01:20.20,Default,,0,0,0,,Ал Нью-Йоркте
Dialogue: 0,0:01:20.53,0:01:22.70,Default,,0,0,0,,Bulls vs Paris Bladers -
Dialogue: 0,0:01:22.79,0:01:24.41,Default,,0,0,0,,Жартылай финал басталды.
Dialogue: 0,0:01:25.16,0:01:26.58,Default,,0,0,0,,Джошуа мен Клио жеңді-
Dialogue: 0,0:01:26.66,0:01:29.50,Default,,0,0,0,,Ойын саны да 1:1.
Dialogue: 0,0:01:29.88,0:01:31.71,Default,,0,0,0,,Мен өз алғысымды білдіремін.
Dialogue: 0,0:01:32.75,0:01:34.30,Default,,0,0,0,,Үшінші тұлғамыз – Куза
Dialogue: 0,0:01:34.55,0:01:37.72,Default,,0,0,0,,Ойнайық... Жеңіп, келесісіне қосыл!
Dialogue: 0,0:01:37.80,0:01:38.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:40.05,0:01:42.68,Default,,0,0,0,,Ха! Сіз бе?
Dialogue: 0,0:01:43.22,0:01:44.43,Default,,0,0,0,,Оила қашықтығы-
Dialogue: 0,0:01:44.56,0:01:46.02,Default,,0,0,0,,Мен сенен құтылуға жол бермеймін.
Dialogue: 0,0:02:02.45,0:02:06.12,Default,,0,0,0,,Тіпті таңертеңгі жарқылмен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:07.08,0:02:09.42,Default,,0,0,0,,Бір жерден естіген дыбыс
Dialogue: 0,0:02:09.50,0:02:11.84,Default,,0,0,0,,Бұл шығанақтың соқтығысуы.
Dialogue: 0,0:02:11.92,0:02:16.26,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:16.92,0:02:21.68,Default,,0,0,0,,Жалынды жүрек ұйықтамайды, Майданға құмар.
Dialogue: 0,0:02:21.76,0:02:26.68,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:26.77,0:02:31.65,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:31.73,0:02:36.78,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:36.86,0:02:40.07,Default,,0,0,0,,Қазір ат!
Dialogue: 0,0:02:40.16,0:02:42.20,Default,,0,0,0,,(Үш екі бір ату!)
Dialogue: 0,0:02:42.28,0:02:44.20,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:44.28,0:02:46.45,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:46.54,0:02:51.46,Default,,0,0,0,,Маған бұрын ешқашан көрмеген шайқасты көрсетіңіз
Dialogue: 0,0:02:51.54,0:02:54.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:54.38,0:03:00.30,Default,,0,0,0,,Әріптесіңізбен үнемі дамып келе жатқан байланыспен және жүрек соғуымен
Dialogue: 0,0:03:00.38,0:03:04.89,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз.
Dialogue: 0,0:03:04.97,0:03:06.97,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:17.36,0:03:21.49,Default,,0,0,0,,Үзіліс! Үлкен 5 қабырға! !
Dialogue: 0,0:03:22.36,0:03:25.99,Default,,0,0,0,,Жартылай финал! Бразилия Риос пен BC Sol
Dialogue: 0,0:03:26.08,0:03:27.29,Default,,0,0,0,,Үшінші ойын!
Dialogue: 0,0:03:27.37,0:03:30.79,Default,,0,0,0,,Ruway! Ruway!
Dialogue: 0,0:03:30.87,0:03:33.79,Default,,0,0,0,,Ruway! Ruway!
Dialogue: 0,0:03:35.46,0:03:36.38,Default,,0,0,0,,(айдаһар дыбысы)
Dialogue: 0,0:03:38.30,0:03:39.42,Default,,0,0,0,,Үшінші ойын
Dialogue: 0,0:03:39.92,0:03:41.17,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:03:47.64,0:03:49.52,Default,,0,0,0,,Эй, әлгі жігіт...
Dialogue: 0,0:03:49.60,0:03:51.43,Default,,0,0,0,,Карнавалға кедергі болған адам.
Dialogue: 0,0:03:51.52,0:03:54.44,Default,,0,0,0,,(буу)
Dialogue: 0,0:03:54.81,0:03:57.19,Default,,0,0,0,,Сіз бәрібір жақын арада өлтіресіз.
Dialogue: 0,0:03:58.61,0:04:00.61,Default,,0,0,0,,Өткендегідей болмайды.
Dialogue: 0,0:04:01.07,0:04:03.15,Default,,0,0,0,,Менің қалағаным осы.
Dialogue: 0,0:04:03.57,0:04:06.20,Default,,0,0,0,,Шынымды айтсам, ол кезде менде онша жауап болмады.
Dialogue: 0,0:04:09.49,0:04:11.37,Default,,0,0,0,,Кузадан рахат алыңыз
Dialogue: 0,0:04:12.08,0:04:12.75,Default,,0,0,0,,...
Dialogue: 0,0:04:13.96,0:04:15.96,Default,,0,0,0,,Менің уайымым басылды...
Dialogue: 0,0:04:20.09,0:04:22.72,Default,,0,0,0,,Ал ұшырғыштың еңіс бұрышы -
Dialogue: 0,0:04:23.13,0:04:25.34,Default,,0,0,0,,шығанақ қай жерде... осында
Dialogue: 0,0:04:25.68,0:04:26.43,Default,,0,0,0,,онда...
Dialogue: 0,0:04:26.64,0:04:28.72,Default,,0,0,0,,Бұрылу траекториясы...
Dialogue: 0,0:04:29.81,0:04:31.52,Default,,0,0,0,,Супер шабуыл режимі!
Dialogue: 0,0:04:32.31,0:04:33.23,Default,,0,0,0,,(реттеу дыбысы)
Dialogue: 0,0:04:33.89,0:04:35.65,Default,,0,0,0,,Қазір қозғалды ма?
Dialogue: 0,0:04:35.77,0:04:37.94,Default,,0,0,0,,А, мен оны жөндедім.
Dialogue: 0,0:04:38.27,0:04:40.02,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:04:40.11,0:04:41.19,Default,,0,0,0,,Үш
Dialogue: 0,0:04:41.28,0:04:42.40,Default,,0,0,0,,Екі
Dialogue: 0,0:04:42.49,0:04:43.61,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:04:43.70,0:04:46.24,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:46.36,0:04:47.03,Default,,0,0,0,,Тай!
Dialogue: 0,0:04:47.66,0:04:49.16,Default,,0,0,0,,Ой!
Dialogue: 0,0:04:52.29,0:04:53.58,Default,,0,0,0,,Енді азу тістерге қарсы тұрыңыз!
Dialogue: 0,0:04:53.66,0:04:55.33,Default,,0,0,0,,Слайд қабаты!
Dialogue: 0,0:04:57.33,0:04:59.59,Default,,0,0,0,,Жүр! Альтер Кронос
Dialogue: 0,0:04:59.71,0:05:03.05,Default,,0,0,0,,Ауырлық центрінің тепе-теңдігі үлкен тербеліспен алға жылжиды.
Dialogue: 0,0:05:03.63,0:05:05.80,Default,,0,0,0,,Тағы да супер шабуыл режимі
Dialogue: 0,0:05:08.47,0:05:11.31,Default,,0,0,0,,Екеуі де теңдестірілген шайқас.
Dialogue: 0,0:05:11.43,0:05:15.85,Default,,0,0,0,,Регулдың бірінші жартысындағы шабуыл күші және екінші жартысындағы қорғаныс күші.
Dialogue: 0,0:05:15.94,0:05:18.40,Default,,0,0,0,,Кронос оны қалай жояды?
Dialogue: 0,0:05:20.27,0:05:21.11,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:05:21.90,0:05:24.78,Default,,0,0,0,,Уау! Жарылған нәрсе ...
Dialogue: 0,0:05:24.86,0:05:26.32,Default,,0,0,0,,Бұл Альтер Кронос!
Dialogue: 0,0:05:26.70,0:05:29.03,Default,,0,0,0,,Кронос! Оны жарып жіберіңіз
Dialogue: 0,0:05:31.87,0:05:34.95,Default,,0,0,0,,Shelter Regulus қорғаныс күші артқанға дейін――
Dialogue: 0,0:05:35.04,0:05:36.04,Default,,0,0,0,,Өлтіру керек
Dialogue: 0,0:05:38.00,0:05:40.13,Default,,0,0,0,,Нью-Йорк Буллз қарсы
Dialogue: 0,0:05:40.21,0:05:43.05,Default,,0,0,0,,Paris Blades 3-ойын
Dialogue: 0,0:05:43.42,0:05:44.80,Default,,0,0,0,,Нью-Йорк Буллз -
Dialogue: 0,0:05:45.21,0:05:46.84,Default,,0,0,0,,Де Ла Хойя тегін!
Dialogue: 0,0:05:47.38,0:05:49.80,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:49.89,0:05:52.47,Default,,0,0,0,,Париж жүздері капитандар.
Dialogue: 0,0:05:52.56,0:05:53.56,Default,,0,0,0,,Қара құдай динасы
Dialogue: 0,0:05:54.06,0:05:57.52,Default,,0,0,0,,Ace of the Bulls және әлемдік рейтингтің басында.
Dialogue: 0,0:05:57.60,0:05:59.56,Default,,0,0,0,,Challenge Free De La Hoya
Dialogue: 0,0:06:00.02,0:06:02.32,Default,,0,0,0,,Үшінші ойын Бірінші шайқас
Dialogue: 0,0:06:02.86,0:06:05.82,Default,,0,0,0,,Әрбір Блейдер мұны кем дегенде бір рет ойлаған...
Dialogue: 0,0:06:06.61,0:06:09.53,Default,,0,0,0,,Жекпе-жекке шығу құрметі, Еркін Де Ла Хойя.
Dialogue: 0,0:06:09.86,0:06:12.41,Default,,0,0,0,,Мен сенімен күресуді асыға күтемін.
Dialogue: 0,0:06:12.83,0:06:14.16,Default,,0,0,0,,Қара құдай динасы
Dialogue: 0,0:06:14.49,0:06:17.58,Default,,0,0,0,,Сіз Барто Аоимен бір командада болдыңыз, солай ма?
Dialogue: 0,0:06:17.96,0:06:19.50,Default,,0,0,0,,Иә
Dialogue: 0,0:06:20.12,0:06:21.83,Default,,0,0,0,,Олай болса орындайық
Dialogue: 0,0:06:24.05,0:06:25.84,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:06:25.92,0:06:29.34,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:29.43,0:06:30.59,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:06:30.68,0:06:31.89,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:06:31.97,0:06:32.97,Default,,0,0,0,,Дея!
Dialogue: 0,0:06:37.43,0:06:39.73,Default,,0,0,0,,Жарайды! Мен шешемін, Deathsizer.
Dialogue: 0,0:06:41.23,0:06:41.98,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:06:44.69,0:06:49.03,Default,,0,0,0,,Кронос пен Регулдың екеуі бір-біріне шабуыл жасайды.
Dialogue: 0,0:06:49.11,0:06:51.53,Default,,0,0,0,,Осылай жалғаса берсе жаман.
Dialogue: 0,0:06:51.95,0:06:53.78,Default,,0,0,0,,Регул шайқастың екінші жартысында
Dialogue: 0,0:06:53.99,0:06:56.45,Default,,0,0,0,,Білік ұшы ұзарады және қорғаныс күші артады.
Dialogue: 0,0:06:56.66,0:06:58.79,Default,,0,0,0,,Ол неғұрлым ұзақ болса, соғұрлым нашар болады.
Dialogue: 0,0:07:01.21,0:07:02.67,Default,,0,0,0,,Жоғалтпа, Куза
Dialogue: 0,0:07:02.75,0:07:04.88,Default,,0,0,0,,Бірден жарылды!
Dialogue: 0,0:07:06.17,0:07:07.05,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:07:14.68,0:07:16.56,Default,,0,0,0,,Тар арқанмен секіру!
Dialogue: 0,0:07:17.93,0:07:19.06,Default,,0,0,0,,Кронос!
Dialogue: 0,0:07:21.10,0:07:21.94,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:07:30.24,0:07:31.70,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:07:32.53,0:07:33.87,Default,,0,0,0,,Регул!
Dialogue: 0,0:07:35.20,0:07:36.03,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:07:38.41,0:07:39.29,Default,,0,0,0,,(үру)
Dialogue: 0,0:07:40.33,0:07:42.08,Default,,0,0,0,,Баспананы қорғау!
Dialogue: 0,0:07:45.54,0:07:46.46,Default,,0,0,0,,(біліктің созылу дыбысы)
Dialogue: 0,0:07:47.92,0:07:48.80,Default,,0,0,0,,(үру)
Dialogue: 0,0:07:49.51,0:07:50.26,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:07:50.76,0:07:51.76,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:07:53.38,0:07:54.84,Default,,0,0,0,,Жоқ! Ах...
Dialogue: 0,0:07:55.64,0:07:58.72,Default,,0,0,0,,Shelter Regulus Burst Finish
Dialogue: 0,0:07:58.85,0:08:02.02,Default,,0,0,0,,Бразилия Риос 2-0 ұпаймен жеңді!
Dialogue: 0,0:08:02.35,0:08:04.31,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:08:04.40,0:08:05.61,Default,,0,0,0,,Үшінші ойын-
Dialogue: 0,0:08:05.69,0:08:06.81,Default,,0,0,0,,Ақыры шешілді!
Dialogue: 0,0:08:06.90,0:08:08.86,Default,,0,0,0,,Енді ойын саны 2-ден 1-ге дейін
Dialogue: 0,0:08:08.94,0:08:10.99,Default,,0,0,0,,Бразилия Риос алға шықты!
Dialogue: 0,0:08:11.49,0:08:13.07,Default,,0,0,0,,Қарғыс атсын! Бұл өтірік...
Dialogue: 0,0:08:13.61,0:08:15.74,Default,,0,0,0,,Мен оны көрдім
Dialogue: 0,0:08:16.49,0:08:18.08,Default,,0,0,0,,Менімен сенің аралығым
Dialogue: 0,0:08:18.78,0:08:19.70,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:20.33,0:08:22.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:22.83,0:08:26.75,Default,,0,0,0,,(байланыс дыбысы)
Dialogue: 0,0:08:27.50,0:08:28.09,Default,,0,0,0,,Tsk
Dialogue: 0,0:08:29.46,0:08:31.51,Default,,0,0,0,,бітуге жақын.
Dialogue: 0,0:08:35.55,0:08:36.39,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:08:39.43,0:08:40.10,Default,,0,0,0,,Сіз ұтыласыз ба?
Dialogue: 0,0:08:40.18,0:08:42.02,Default,,0,0,0,,Қос соққы!
Dialogue: 0,0:08:53.69,0:08:54.53,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:08:55.20,0:08:56.61,Default,,0,0,0,,Айналдыруды төгіңіз!
Dialogue: 0,0:09:00.03,0:09:00.79,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:09:00.99,0:09:01.99,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:09:03.29,0:09:05.16,Default,,0,0,0,,Фафнирді төгу
Dialogue: 0,0:09:05.25,0:09:06.33,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:09:06.42,0:09:09.25,Default,,0,0,0,,Нью-Йорк Буллз 2-0 есебімен жеңіске жетті!
Dialogue: 0,0:09:09.34,0:09:10.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:11.05,0:09:14.22,Default,,0,0,0,,Чемпион Фри Де Ла Хойяның қадір-қасиетін көрсету
Dialogue: 0,0:09:14.72,0:09:17.05,Default,,0,0,0,,Енді ойын саны 2:1
Dialogue: 0,0:09:17.22,0:09:19.47,Default,,0,0,0,,Нью-Йорк Буллз бір қадам алға!
Dialogue: 0,0:09:22.01,0:09:24.77,Default,,0,0,0,,Бұл өте күшті Free is
Dialogue: 0,0:09:25.06,0:09:25.73,Default,,0,0,0,,Өмірімді қатерге тігіп, барымды салдым.
Dialogue: 0,0:09:26.19,0:09:27.81,Default,,0,0,0,,Не?
Dialogue: 0,0:09:28.77,0:09:31.11,Default,,0,0,0,,Менің б.э.д. Сол кездегі кезеңмен салыстырғанда...
Dialogue: 0,0:09:31.44,0:09:33.44,Default,,0,0,0,,Бұл жайсыз сияқты.
Dialogue: 0,0:09:34.28,0:09:36.86,Default,,0,0,0,,Әй, саған солай көрінеді ме?
Dialogue: 0,0:09:37.07,0:09:37.74,Default,,0,0,0,,Иә
Dialogue: 0,0:09:38.57,0:09:41.66,Default,,0,0,0,,Ол әдетте үмітсіз бала, бірақ...
Dialogue: 0,0:09:41.87,0:09:44.66,Default,,0,0,0,,Жеңіс мен үшін маңызды
Dialogue: 0,0:09:45.00,0:09:47.58,Default,,0,0,0,,Және ол жеңе береді
Dialogue: 0,0:09:48.50,0:09:51.13,Default,,0,0,0,,онда бұл жеткілікті
Dialogue: 0,0:09:54.55,0:09:56.09,Default,,0,0,0,,Барлығы... Кешіріңіз.
Dialogue: 0,0:09:56.51,0:10:00.22,Default,,0,0,0,,Оның әрбір тамшы қанын ағызамын.
Dialogue: 0,0:10:00.43,0:10:03.39,Default,,0,0,0,,Әлде қарғыс атқан қараңғылық мені тұтқындай ма?
Dialogue: 0,0:10:05.89,0:10:08.48,Default,,0,0,0,,Досым, ары қарай жасайық.
Dialogue: 0,0:10:09.48,0:10:10.31,Default,,0,0,0,,Неге соншалықты алысқа бару керек…
Dialogue: 0,0:10:10.94,0:10:13.02,Default,,0,0,0,,Маған тағы бір мүмкіндік беріңіз
Dialogue: 0,0:10:13.65,0:10:15.61,Default,,0,0,0,,Бұл жақсы, бірақ...
Dialogue: 0,0:10:16.11,0:10:18.36,Default,,0,0,0,,Мен барлығын финалға шығарғым келеді.
Dialogue: 0,0:10:18.82,0:10:20.11,Default,,0,0,0,,Капитан ретінде -
Dialogue: 0,0:10:20.20,0:10:22.78,Default,,0,0,0,,Себепсіз жеңіліп қалсаңыз, бітпейді!
Dialogue: 0,0:10:22.87,0:10:25.75,Default,,0,0,0,,Ешкім сені бақытсыз деп ойламайды!
Dialogue: 0,0:10:25.83,0:10:28.54,Default,,0,0,0,,Менің қарсыласым әлемдік рейтингте көш бастап тұр.
Dialogue: 0,0:10:28.91,0:10:31.50,Default,,0,0,0,,Сонда сіз ұтылудың қажеті жоқ дейсіз бе?
Dialogue: 0,0:10:31.79,0:10:32.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:33.84,0:10:35.09,Default,,0,0,0,,Келесі Егер сіз жоғалтсаңыз...
Dialogue: 0,0:10:35.46,0:10:37.88,Default,,0,0,0,,Біздің финалға жолымыз жоғалады.
Dialogue: 0,0:10:38.67,0:10:40.05,Default,,0,0,0,,Егер, гипотетикалық тұрғыдан, адамдарды тек бет-әлпеті мен атын танып-білу арқылы өлтіретін күшім болса,
Dialogue: 0,0:10:40.34,0:10:41.55,Default,,0,0,0,,Сіз міндетті түрде жеңесіз!
Dialogue: 0,0:10:43.93,0:10:47.10,Default,,0,0,0,,Мен досымның бұл сезімін қабылдадым.
Dialogue: 0,0:10:47.93,0:10:49.35,Default,,0,0,0,,Сөзсіз жеңіңіз
Dialogue: 0,0:10:49.56,0:10:52.36,Default,,0,0,0,,Мен қазір Бразилияда финал үшін күресіп жатырмын.
Dialogue: 0,0:10:52.44,0:10:53.69,Default,,0,0,0,,Менің достарыма да
Dialogue: 0,0:10:54.11,0:10:55.11,Default,,0,0,0,,Иә
Dialogue: 0,0:10:59.11,0:11:00.40,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:00.49,0:11:03.28,Default,,0,0,0,,Міне, Нью-Йорктен соңғы ақпарат!
Dialogue: 0,0:11:03.91,0:11:07.04,Default,,0,0,0,,Жартылай финал Нью-Йорк Буллс пен Париж Блэдерс
Dialogue: 0,0:11:07.33,0:11:10.79,Default,,0,0,0,,Нью-Йорк Буллз 2-1 есебімен алға шықты.
Dialogue: 0,0:11:11.54,0:11:14.92,Default,,0,0,0,,Екеуі де төртінші ойынға кірмекші!
Dialogue: 0,0:11:15.54,0:11:16.50,Default,,0,0,0,,Дина…
Dialogue: 0,0:11:17.38,0:11:20.01,Default,,0,0,0,,Жоқ, мен жеңілдім!
Dialogue: 0,0:11:20.13,0:11:21.13,Default,,0,0,0,,Cuza…
Dialogue: 0,0:11:21.68,0:11:23.14,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:11:23.89,0:11:26.47,Default,,0,0,0,,Бұл күшті~ Рувей
Dialogue: 0,0:11:26.56,0:11:29.93,Default,,0,0,0,,Мұның несі күшті?
Dialogue: 0,0:11:30.23,0:11:30.94,Default,,0,0,0,,Уууу… Уф!
Dialogue: 0,0:11:31.56,0:11:32.90,Default,,0,0,0,,Істейтін ештеңе қалмады.
Dialogue: 0,0:11:33.06,0:11:35.65,Default,,0,0,0,,Келесі Егер сіз ұтпасаңыз, жеңе алмайсыз!
Dialogue: 0,0:11:35.73,0:11:37.02,Default,,0,0,0,,Түсінесіз бе! ?
Dialogue: 0,0:11:37.11,0:11:38.15,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:11:38.23,0:11:38.86,Default,,0,0,0,,О...
Dialogue: 0,0:11:39.40,0:11:41.82,Default,,0,0,0,,Бұл өте көңілсіз, солай емес пе?
Dialogue: 0,0:11:41.99,0:11:42.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:43.49,0:11:44.87,Default,,0,0,0,,Сіздің көзқарасыңыз қандай?
Dialogue: 0,0:11:44.95,0:11:46.66,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:11:47.41,0:11:48.58,Default,,0,0,0,,(құйылып жатқан судың дыбысы)
Dialogue: 0,0:11:50.29,0:11:53.33,Default,,0,0,0,,Оны тезірек шешуге болар еді.
Dialogue: 0,0:11:54.08,0:11:56.17,Default,,0,0,0,,Ағыс осылай кері бұрылды, солай ма?
Dialogue: 0,0:11:56.38,0:11:57.04,Default,,0,0,0,,О
Dialogue: 0,0:11:58.09,0:12:01.38,Default,,0,0,0,,Мен саған берген уәдемді бұздым ба?
Dialogue: 0,0:12:02.17,0:12:02.84,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:03.84,0:12:05.85,Default,,0,0,0,,Олай болса, Шақа
Dialogue: 0,0:12:05.93,0:12:06.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:07.97,0:12:09.35,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:12:13.52,0:12:14.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:22.24,0:12:23.32,Default,,0,0,0,,Ruway…
Dialogue: 0,0:12:28.41,0:12:31.04,Default,,0,0,0,,Не, Шәкеңді жалғыз тастап барасың ба?
Dialogue: 0,0:12:31.25,0:12:32.62,Default,,0,0,0,,Бірақ егер Барт...
Dialogue: 0,0:12:32.71,0:12:35.37,Default,,0,0,0,,Рувейдің есептеулерін желге ұшыруға болмас па еді?
Dialogue: 0,0:12:35.83,0:12:39.38,Default,,0,0,0,,Ол ақымақтың істегенін ешкім оқи алмайды.
Dialogue: 0,0:12:39.67,0:12:42.13,Default,,0,0,0,,Аники~ Жеңіске жетуіңізді өтінемін!
Dialogue: 0,0:12:42.21,0:12:44.22,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:12:44.30,0:12:45.93,Default,,0,0,0,,Сіз кеше сондай абайсыз болдыңыз...
Dialogue: 0,0:12:46.01,0:12:47.47,Default,,0,0,0,,Fah fah fah
Dialogue: 0,0:12:47.60,0:12:50.60,Default,,0,0,0,,Абайсыз болу да Барттың жақсы жағы.
Dialogue: 0,0:12:50.97,0:12:53.43,Default,,0,0,0,,Мені және осы Blader-дің иесі-
Dialogue: 0,0:12:53.52,0:12:55.19,Default,,0,0,0,,Мазасыздық сезінсеңіз не істеу керек?
Dialogue: 0,0:12:56.19,0:12:58.19,Default,,0,0,0,,Бартқа сену
Dialogue: 0,0:12:58.69,0:13:00.40,Default,,0,0,0,,Бұл Балто еді.
Dialogue: 0,0:13:00.98,0:13:03.15,Default,,0,0,0,,Ру Вэй оқығандай болды.
Dialogue: 0,0:13:06.32,0:13:08.32,Default,,0,0,0,,Мен сенімен ұрысқым келді
Dialogue: 0,0:13:08.95,0:13:11.91,Default,,0,0,0,,Хехе, мен оны Лувей деп ойламадым.
Dialogue: 0,0:13:12.04,0:13:15.25,Default,,0,0,0,,Шака сізді неге сонша жоғары бағалайды?
Dialogue: 0,0:13:15.33,0:13:16.54,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:13:16.92,0:13:17.67,Default,,0,0,0,,Саған қонақүй тауып беремін.
Dialogue: 0,0:13:18.08,0:13:20.80,Default,,0,0,0,,Мен тіпті 100 адамдық шайқасты аяқтай алмаймын, сен...
Dialogue: 0,0:13:20.88,0:13:22.42,Default,,0,0,0,,Шака мойындайды
Dialogue: 0,0:13:23.09,0:13:25.42,Default,,0,0,0,,Мен бұл шайқаста себебін білгім келеді.
Dialogue: 0,0:13:25.51,0:13:26.26,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:13:26.34,0:13:28.93,Default,,0,0,0,,Шақа екеуміз әрқашан солай болдық!
Dialogue: 0,0:13:29.26,0:13:30.93,Default,,0,0,0,,Кәне, жасайық!
Dialogue: 0,0:13:31.18,0:13:33.02,Default,,0,0,0,,Шақамен төбелесуге жол берме
Dialogue: 0,0:13:33.47,0:13:35.68,Default,,0,0,0,,BC Соль осымен аяқталады!
Dialogue: 0,0:13:35.89,0:13:38.31,Default,,0,0,0,,Мен саған айттым, мен сені жеңемін.
Dialogue: 0,0:13:38.44,0:13:40.52,Default,,0,0,0,,Мен Шақамен күресемін!
Dialogue: 0,0:13:41.77,0:13:43.23,Default,,0,0,0,,4 ойын
Dialogue: 0,0:13:43.78,0:13:44.94,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:13:45.49,0:13:47.03,Default,,0,0,0,,Кеттік, Валькири.
Dialogue: 0,0:13:47.66,0:13:49.82,Default,,0,0,0,,Құдайдың қайта жүктеуін шешіңіз!
Dialogue: 0,0:13:55.08,0:13:57.54,Default,,0,0,0,,Бұрынғыдан да шатасып кетті.
Dialogue: 0,0:13:57.62,0:13:59.00,Default,,0,0,0,,Шиеленіс жоғары болды...
Dialogue: 0,0:13:59.08,0:14:01.09,Default,,0,0,0,,Әлі түсірілім түрінде
Dialogue: 0,0:14:01.46,0:14:02.50,Default,,0,0,0,,Шака!
Dialogue: 0,0:14:02.75,0:14:05.59,Default,,0,0,0,,Осы уақытқа дейін бұл жігіт туралы не бағаладыңыз?
Dialogue: 0,0:14:06.09,0:14:08.80,Default,,0,0,0,,Бұл шайқастың бірінші жартысындағы жағдайды түсіндіреді.
Dialogue: 0,0:14:09.59,0:14:10.43,Default,,0,0,0,,Ал одан да маңыздысы —
Dialogue: 0,0:14:10.68,0:14:13.10,Default,,0,0,0,,Бұл жігітте тек ерекше қозғалыс бар.
Dialogue: 0,0:14:13.68,0:14:15.10,Default,,0,0,0,,Тым қарапайым...
Dialogue: 0,0:14:16.52,0:14:18.52,Default,,0,0,0,,Нью-Йорк Буллз қарсы
Dialogue: 0,0:14:18.60,0:14:20.86,Default,,0,0,0,,«Париж пышақтары» ойыны 4
Dialogue: 0,0:14:21.11,0:14:23.11,Default,,0,0,0,,Париж Блейдерлері - бұл...
Dialogue: 0,0:14:23.19,0:14:25.53,Default,,0,0,0,,Дина Курогами қатарынан матчтарға шығады.
Dialogue: 0,0:14:25.99,0:14:28.03,Default,,0,0,0,,Ұялшақ!
Dialogue: 0,0:14:28.11,0:14:30.20,Default,,0,0,0,,Ал Нью-Йорк Буллз...
Dialogue: 0,0:14:30.28,0:14:32.53,Default,,0,0,0,,Джошуа Бунмен таныстыру!
Dialogue: 0,0:14:32.99,0:14:34.41,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:14:34.49,0:14:36.79,Default,,0,0,0,,Уақытыңызды тамаша өткізіп жатырсыз ба?
Dialogue: 0,0:14:36.87,0:14:38.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:38.87,0:14:40.50,Default,,0,0,0,,Жариялаймыз
Dialogue: 0,0:14:40.58,0:14:43.04,Default,,0,0,0,,Бұл ойынның басты кейіпкері Джошуа.
Dialogue: 0,0:14:43.13,0:14:45.30,Default,,0,0,0,,Шарла!
Dialogue: 0,0:14:46.21,0:14:47.42,Default,,0,0,0,,Сізге ұнай ма?
Dialogue: 0,0:14:48.09,0:14:50.72,Default,,0,0,0,,Көрермендердің көңілін көтеру керек, эй.
Dialogue: 0,0:14:51.05,0:14:53.47,Default,,0,0,0,,Қойылымдарға қатысу Менің хоббиім жоқ.
Dialogue: 0,0:14:54.39,0:14:54.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:55.43,0:14:58.39,Default,,0,0,0,,Енді төртінші ойын басталды.
Dialogue: 0,0:14:58.48,0:14:59.98,Default,,0,0,0,,Бұл ойын туралы не деуге болады?
Dialogue: 0,0:15:00.06,0:15:01.81,Default,,0,0,0,,Бұл реттеледі ме?
Dialogue: 0,0:15:01.90,0:15:04.73,Default,,0,0,0,,Әлде 5-ші ойынға ауыстырылады ма?
Dialogue: 0,0:15:04.82,0:15:07.32,Default,,0,0,0,,Сіз мұны жіберіп алмайсыз!
Dialogue: 0,0:15:07.40,0:15:09.32,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:15:09.40,0:15:10.53,Default,,0,0,0,,Үш
Dialogue: 0,0:15:10.61,0:15:11.74,Default,,0,0,0,,Екі
Dialogue: 0,0:15:11.82,0:15:12.95,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:15:13.03,0:15:15.45,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:15.53,0:15:17.95,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:26.42,0:15:29.17,Default,,0,0,0,,Келіңіздер! 4 ойын басталды
Dialogue: 0,0:15:29.26,0:15:31.01,Default,,0,0,0,,Үйде жеңіске жету үшін -
Dialogue: 0,0:15:31.09,0:15:33.34,Default,,0,0,0,,Жолда алға ұмтыламыз ба? Бразилия Риосы!
Dialogue: 0,0:15:33.43,0:15:35.01,Default,,0,0,0,,Қуып жетіп, чемпионатты ұтып алыңыз.
Dialogue: 0,0:15:35.10,0:15:37.01,Default,,0,0,0,,Жолдарды қосамыз ба? BC Sol!
Dialogue: 0,0:15:37.10,0:15:39.85,Default,,0,0,0,,4-ойын Бірінші шайқаста кім жеңеді?
Dialogue: 0,0:15:39.93,0:15:42.65,Default,,0,0,0,,Бұл Нью-Йорк Буллз ба? Немесе-
Dialogue: 0,0:15:42.73,0:15:44.73,Default,,0,0,0,,Бұл Paris Blades па?
Dialogue: 0,0:15:45.44,0:15:47.40,Default,,0,0,0,,Жүр! валкири
Dialogue: 0,0:15:48.28,0:15:51.28,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:15:51.78,0:15:55.41,Default,,0,0,0,,Болжағандай, бұл әлі де ерекше қозғалыс.
Dialogue: 0,0:15:55.57,0:15:58.04,Default,,0,0,0,,Олай болса, мен оған дейін мәселені шешемін!
Dialogue: 0,0:15:58.41,0:16:01.41,Default,,0,0,0,,Баспана Regulus God Valkyrie
Dialogue: 0,0:16:01.50,0:16:03.71,Default,,0,0,0,,Ешқайсымыз да артқа қадам жасамаймыз!
Dialogue: 0,0:16:04.63,0:16:05.92,Default,,0,0,0,,Азу тістерінің шабуылы!
Dialogue: 0,0:16:08.46,0:16:09.80,Default,,0,0,0,,(Соқтығыс/сыртқы дыбыс)
Dialogue: 0,0:16:10.55,0:16:11.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:11.63,0:16:12.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:12.88,0:16:15.05,Default,,0,0,0,,Келіңіздер! Бұл бітті...
Dialogue: 0,0:16:15.14,0:16:17.51,Default,,0,0,0,,Ах! Дегенмен, ол тұрды!
Dialogue: 0,0:16:17.60,0:16:20.47,Default,,0,0,0,,Валькири әрең жетті!
Dialogue: 0,0:16:20.77,0:16:22.52,Default,,0,0,0,,Ал, баста!
Dialogue: 0,0:16:27.56,0:16:30.03,Default,,0,0,0,,Менің ойымша, бұл орбита-
Dialogue: 0,0:16:30.11,0:16:31.99,Default,,0,0,0,,Ақыр соңында, бұл ерекше қозғалыс?
Dialogue: 0,0:16:32.07,0:16:35.49,Default,,0,0,0,,Valkyrie кенеттен жеделдету Құдайдың қайта жүктелуі мүмкін сияқты!
Dialogue: 0,0:16:35.70,0:16:38.37,Default,,0,0,0,,Мені ұр! құдай қайта жүкте
Dialogue: 0,0:16:38.70,0:16:41.87,Default,,0,0,0,,Бұл техника баспананы қорғаудан бас тартты!
Dialogue: 0,0:16:48.63,0:16:49.46,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:16:49.84,0:16:50.67,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:16:51.01,0:16:52.72,Default,,0,0,0,,Қандай ерекше қозғалыс болса да...
Dialogue: 0,0:16:52.80,0:16:55.26,Default,,0,0,0,,Shelter Defence алдында бұл мағынасыз!
Dialogue: 0,0:16:55.59,0:16:56.51,Default,,0,0,0,,Е!
Dialogue: 0,0:16:56.59,0:16:58.14,Default,,0,0,0,,Осы уақытта?
Dialogue: 0,0:16:58.64,0:16:59.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:00.14,0:17:02.22,Default,,0,0,0,,Валькири қайтадан шабуыл жасайды
Dialogue: 0,0:17:02.31,0:17:03.23,Default,,0,0,0,,қайтарылды!
Dialogue: 0,0:17:09.48,0:17:10.86,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:17:11.65,0:17:13.99,Default,,0,0,0,,Керемет! Валькирияға барыңыз!
Dialogue: 0,0:17:14.40,0:17:15.15,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:17:15.90,0:17:17.24,Default,,0,0,0,,(Тоқтау дыбысы)
Dialogue: 0,0:17:17.32,0:17:17.99,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:18.66,0:17:20.49,Default,,0,0,0,,Бұл жылдамдық қандай?
Dialogue: 0,0:17:23.75,0:17:25.21,Default,,0,0,0,,Ал, баста!
Dialogue: 0,0:17:28.67,0:17:29.75,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:17:31.34,0:17:32.25,Default,,0,0,0,,Идиот!
Dialogue: 0,0:17:32.76,0:17:34.05,Default,,0,0,0,,Хааа~
Dialogue: 0,0:17:37.68,0:17:38.55,Default,,0,0,0,,Бұл жігіт-
Dialogue: 0,0:17:39.47,0:17:41.01,Default,,0,0,0,,Қозғалыс жылдамырақ, солай ма?
Dialogue: 0,0:17:41.10,0:17:42.72,Default,,0,0,0,,Иә, ол күшті!
Dialogue: 0,0:17:42.93,0:17:44.43,Default,,0,0,0,,Fah fah fah
Dialogue: 0,0:17:44.77,0:17:47.10,Default,,0,0,0,,Құдай қайта жүктейді...
Dialogue: 0,0:17:47.19,0:17:49.73,Default,,0,0,0,,Валькирия қайтадан дамиды.
Dialogue: 0,0:17:50.06,0:17:50.90,Default,,0,0,0,,Эволюция?
Dialogue: 0,0:17:51.19,0:17:53.19,Default,,0,0,0,,Бұл әлі де бар ма?
Dialogue: 0,0:17:53.28,0:17:53.98,Default,,0,0,0,,Иә
Dialogue: 0,0:17:54.19,0:17:57.32,Default,,0,0,0,,Байланысты қабатты қолдану арқылы...
Dialogue: 0,0:17:57.40,0:18:00.53,Default,,0,0,0,,Сіз кеңірек қозғала аласыз.
Dialogue: 0,0:18:00.82,0:18:02.79,Default,,0,0,0,,Сіз неғұрлым көп қозғалсаңыз, соншалықты ...
Dialogue: 0,0:18:02.87,0:18:05.04,Default,,0,0,0,,Секірген кезде күшті арттырады
Dialogue: 0,0:18:05.12,0:18:07.83,Default,,0,0,0,,Шабуыл күші сәйкесінше артады.
Dialogue: 0,0:18:09.58,0:18:10.42,Default,,0,0,0,,Куку!
Dialogue: 0,0:18:12.25,0:18:14.09,Default,,0,0,0,,Мен білемін, Джошуа.
Dialogue: 0,0:18:14.51,0:18:15.84,Default,,0,0,0,,Мұны қалай жасайсыз?
Dialogue: 0,0:18:16.72,0:18:18.13,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:18:19.13,0:18:19.89,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:18:20.55,0:18:22.97,Default,,0,0,0,,Қарсылас бірінші шайқасқа шығады
Dialogue: 0,0:18:23.60,0:18:25.72,Default,,0,0,0,,Үлкен 5-тен 1 ұпай алыңыз
Dialogue: 0,0:18:25.81,0:18:26.81,Default,,0,0,0,,Көңілім толқыған жер...
Dialogue: 0,0:18:27.14,0:18:29.48,Default,,0,0,0,,Екінші шайқаста жарылды
Dialogue: 0,0:18:30.10,0:18:33.82,Default,,0,0,0,,Жұлдыз – дағдарыс пен жеңістің уәдесі.
Dialogue: 0,0:18:34.19,0:18:37.07,Default,,0,0,0,,Сондықтан мен бұл бірінші шайқаста...
Dialogue: 0,0:18:37.15,0:18:39.78,Default,,0,0,0,,Burst Blast Genius!
Dialogue: 0,0:18:42.49,0:18:44.24,Default,,0,0,0,,Қос соққы беріңіз!
Dialogue: 0,0:18:45.12,0:18:46.12,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:18:48.62,0:18:49.37,Default,,0,0,0,,Не...
Dialogue: 0,0:18:50.00,0:18:50.83,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:18:52.54,0:18:55.42,Default,,0,0,0,,Өлтіруші өлім өлшемі аяқталды\NParis Blades үшін
Dialogue: 0,0:18:55.59,0:18:57.55,Default,,0,0,0,,1 ұпай
Dialogue: 0,0:18:57.63,0:18:59.68,Default,,0,0,0,,Біріншіден, бірінші шайқас...
Dialogue: 0,0:18:59.76,0:19:01.55,Default,,0,0,0,,Париж жүздері оны алды!
Dialogue: 0,0:19:01.64,0:19:03.68,Default,,0,0,0,,Хмм, бұл ұят болды.
Dialogue: 0,0:19:03.93,0:19:07.06,Default,,0,0,0,,Уәде орындалатындықтан уәде деп аталады.
Dialogue: 0,0:19:07.52,0:19:09.56,Default,,0,0,0,,Мен де екінші шайқасқа қатысамын.
Dialogue: 0,0:19:09.85,0:19:12.31,Default,,0,0,0,,Мен сіздің жеңіс үлгісін бұзамын
Dialogue: 0,0:19:12.98,0:19:15.73,Default,,0,0,0,,Аңызға шақыру, солай ма?
Dialogue: 0,0:19:15.82,0:19:17.57,Default,,0,0,0,,Шынымен керемет
Dialogue: 0,0:19:17.65,0:19:19.32,Default,,0,0,0,,Керемет емес!
Dialogue: 0,0:19:19.57,0:19:22.53,Default,,0,0,0,,Менің досым! Басқа адамның қараңғылығына жұтылып кетпеңіз
Dialogue: 0,0:19:22.61,0:19:25.78,Default,,0,0,0,,Мен сені қараңғылығыңа сүйреймін!
Dialogue: 0,0:19:28.54,0:19:29.71,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:19:29.79,0:19:33.38,Default,,0,0,0,,Regulus баспанасы қайтадан ұшып кетті!
Dialogue: 0,0:19:33.54,0:19:35.88,Default,,0,0,0,,Иә! Уа!
Dialogue: 0,0:19:41.84,0:19:42.84,Default,,0,0,0,,(үру)
Dialogue: 0,0:19:43.72,0:19:45.14,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:19:46.10,0:19:47.51,Default,,0,0,0,,Шақамен күрес!
Dialogue: 0,0:19:51.19,0:19:53.27,Default,,0,0,0,,(жіңішке дауыс)
Dialogue: 0,0:19:53.48,0:19:55.77,Default,,0,0,0,,Алға, Валькири!
Dialogue: 0,0:19:56.48,0:19:59.03,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:19:59.19,0:19:59.94,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:20:02.03,0:20:02.91,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:20:04.20,0:20:05.20,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:06.33,0:20:08.41,Default,,0,0,0,,А... а
Dialogue: 0,0:20:09.33,0:20:12.00,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:20:12.33,0:20:15.38,Default,,0,0,0,,BC Sol 2-0 ұпаймен жеңеді!
Dialogue: 0,0:20:15.67,0:20:18.13,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:20:18.30,0:20:19.92,Default,,0,0,0,,Жарайсың Аники!
Dialogue: 0,0:20:20.01,0:20:22.88,Default,,0,0,0,,Керемет! Біз үлкен 5-ті жеңдік!
Dialogue: 0,0:20:23.13,0:20:24.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:24.22,0:20:27.14,Default,,0,0,0,,Валькирия дами береді.
Dialogue: 0,0:20:27.80,0:20:30.22,Default,,0,0,0,,Оны асыға күт, Балто.
Dialogue: 0,0:20:30.47,0:20:32.81,Default,,0,0,0,,Ойындар саны 2-ден 2-ге дейін
Dialogue: 0,0:20:32.89,0:20:36.15,Default,,0,0,0,,Жарыс 5-ші ойынға ауыстырылды!
Dialogue: 0,0:20:36.56,0:20:37.73,Default,,0,0,0,,(сығу дыбысы)
Dialogue: 0,0:20:38.82,0:20:41.03,Default,,0,0,0,,Бұл Барто Аои ма?
Dialogue: 0,0:20:41.86,0:20:42.61,Default,,0,0,0,,Хмф!
Dialogue: 0,0:20:44.11,0:20:47.37,Default,,0,0,0,,Мен ешқашан ойламадым... Лу Вэй жеңіледі.
Dialogue: 0,0:20:47.57,0:20:50.37,Default,,0,0,0,,Сене алар емеспін... Бұл үлкен ренжітті.
Dialogue: 0,0:20:50.45,0:20:51.79,Default,,0,0,0,,Үлкен 5, солай ма?
Dialogue: 0,0:20:51.87,0:20:54.50,Default,,0,0,0,,Бұл жапон адамы керемет жұмыс істейді!
Dialogue: 0,0:20:54.79,0:20:57.25,Default,,0,0,0,,Барто Аои... қандай жігіт!
Dialogue: 0,0:20:57.38,0:20:59.17,Default,,0,0,0,,Бұл жігіт керемет!
Dialogue: 0,0:20:59.59,0:21:03.51,Default,,0,0,0,,(Мақтау дауысы)
Dialogue: 0,0:21:03.67,0:21:05.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:05.18,0:21:07.26,Default,,0,0,0,,Іс өте үлкен болып келеді!
Dialogue: 0,0:21:07.68,0:21:09.18,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:21:09.26,0:21:09.76,Default,,0,0,0,,​​О?
Dialogue: 0,0:21:10.72,0:21:11.93,Default,,0,0,0,,Мен дәл қазір Реиичи-куннан
Dialogue: 0,0:21:12.81,0:21:13.64,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:21:13.93,0:21:15.89,Default,,0,0,0,,Валькири Керемет, солай ма?
Dialogue: 0,0:21:16.56,0:21:18.56,Default,,0,0,0,,Шайқаста даму―
Dialogue: 0,0:21:18.81,0:21:21.19,Default,,0,0,0,,Бұл менің есептеулерімнен әлдеқайда асып түсті.
Dialogue: 0,0:21:21.28,0:21:23.90,Default,,0,0,0,,Бұл ренжітті, бірақ мен мұндай шайқаста бірінші рет болып тұрмын.
Dialogue: 0,0:21:24.57,0:21:25.40,Default,,0,0,0,,Хи хи!
Dialogue: 0,0:21:25.90,0:21:29.16,Default,,0,0,0,,Мен сенімен бір күні тағы шайқасқым келеді.
Dialogue: 0,0:21:29.41,0:21:31.41,Default,,0,0,0,,А, мен саған қарсылас боламын!
Dialogue: 0,0:21:32.12,0:21:33.54,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,0:21:34.16,0:21:35.75,Default,,0,0,0,,Шака!
Dialogue: 0,0:21:35.83,0:21:36.58,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:21:37.04,0:21:39.17,Default,,0,0,0,,Шық! Мен сенімен біргемін -
Dialogue: 0,0:21:39.25,0:21:40.75,Default,,0,0,0,,Шайқасайық!
Dialogue: 0,0:21:41.04,0:21:42.92,Default,,0,0,0,,Хью
Dialogue: 0,0:21:43.38,0:21:44.26,Default,,0,0,0,,Әу
Dialogue: 0,0:21:45.38,0:21:46.43,Default,,0,0,0,,Сәлем Шака!
Dialogue: 0,0:21:47.55,0:21:50.39,Default,,0,0,0,,Міне, мен болғым келеді! Балто!
Dialogue: 0,0:21:55.98,0:21:57.77,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:21:58.19,0:22:00.02,Default,,0,0,0,,Негіздерге дайынсыз ба?
Dialogue: 0,0:22:00.11,0:22:02.86,Default,,0,0,0,,Енді күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:02.94,0:22:04.82,Default,,0,0,0,,Қозғалыс 1 нұсқаға қарағанда жылдамырақ.
Dialogue: 0,0:22:04.90,0:22:06.99,Default,,0,0,0,,Алдымен, Showtime бағдарламасының алдыңғы бөліміне шолу жасаңыз
Dialogue: 0,0:22:07.07,0:22:10.62,Default,,0,0,0,,Бар! Шүкір! үлкен
Dialogue: 0,0:22:10.70,0:22:13.45,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:13.54,0:22:14.37,Default,,0,0,0,,Жылдамдату
Dialogue: 0,0:22:14.45,0:22:16.20,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:16.29,0:22:18.04,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:18.12,0:22:19.88,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:19.96,0:22:21.46,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:21.54,0:22:23.17,Default,,0,0,0,,Хахаха, бұл жақсы емес пе?
Dialogue: 0,0:22:23.25,0:22:24.84,Default,,0,0,0,,Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.92,0:22:26.67,Default,,0,0,0,,Бұл жерден нашарлай түседі.
Dialogue: 0,0:22:26.76,0:22:28.84,Default,,0,0,0,,Кернеуді көтерейік!
Dialogue: 0,0:22:28.93,0:22:30.89,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:30.97,0:22:32.85,Default,,0,0,0,,Моримори күшейіп келеді
Dialogue: 0,0:22:32.93,0:22:34.68,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:34.77,0:22:36.52,Default,,0,0,0,,Менің атқаным – құдайдың атысы
Dialogue: 0,0:22:36.60,0:22:40.15,Default,,0,0,0,,Оң аяқ киім Сол аяқ киім Оң жақтағы аяқ киім
Dialogue: 0,0:22:40.23,0:22:43.82,Default,,0,0,0,,Сол аяқ киім Оң аяқ киім Сол жақтағы аяқ киім
Dialogue: 0,0:22:43.90,0:22:45.73,Default,,0,0,0,,Өткен апта Осы аптада
Dialogue: 0,0:22:45.82,0:22:47.61,Default,,0,0,0,,Біз түсірілім жасап жатырмыз.
Dialogue: 0,0:22:47.69,0:22:49.40,Default,,0,0,0,,Осы апта Келесі аптада
Dialogue: 0,0:22:49.49,0:22:51.45,Default,,0,0,0,,Ол сондай-ақ Go Shoot ойнайды
Dialogue: 0,0:22:51.53,0:22:53.12,Default,,0,0,0,,Күн сайын жаттығу
Dialogue: 0,0:22:53.20,0:22:55.04,Default,,0,0,0,,Барлығы істеп жатқан түсірілімге барыңыз
Dialogue: 0,0:22:55.12,0:22:56.83,Default,,0,0,0,,Көктем/жаз күз/қыс
Dialogue: 0,0:22:56.91,0:22:58.50,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:22:58.58,0:23:00.00,Default,,0,0,0,,Хмм жарайды!
Dialogue: 0,0:23:00.08,0:23:02.71,Default,,0,0,0,,Негізгі бұлшықеттерді дамыту үшін күнделікті жаттығулар қажет.
Dialogue: 0,0:23:02.79,0:23:05.92,Default,,0,0,0,,Осы шиеленіспен біз шарықтау шегіне жетеміз.
Dialogue: 0,0:23:06.00,0:23:08.97,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:09.05,0:23:09.72,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:23:09.80,0:23:12.43,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:12.51,0:23:13.22,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:23:13.30,0:23:17.10,Default,,0,0,0,,1 2 3 4 Бар! кеттік
Dialogue: 0,0:23:17.18,0:23:17.77,Default,,0,0,0,,Үш
Dialogue: 0,0:23:18.02,0:23:18.64,Default,,0,0,0,,Екі
Dialogue: 0,0:23:18.85,0:23:20.64,Default,,0,0,0,,One Go аяқ киім!
Dialogue: 0,0:23:20.73,0:23:21.98,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.06,0:23:25.15,Default,,0,0,0,,Керемет түсіріңіз! Керемет негіз!
Dialogue: 0,0:23:25.57,0:23:28.53,Default,,0,0,0,,Дина Джошуаны бұрып келе жатыр
Dialogue: 0,0:23:29.15,0:23:30.78,Default,,0,0,0,,Мен де ұтыла алмаймын!
Dialogue: 0,0:23:31.20,0:23:34.49,Default,,0,0,0,,5-ойын...Шака Риодан шығуы керек.
Dialogue: 0,0:23:34.78,0:23:36.28,Default,,0,0,0,,Мұны мен үшін жасаңыз!
Dialogue: 0,0:23:36.41,0:23:40.16,Default,,0,0,0,,Қатты шайқаста Бразилияны өртеп жіберейік!
Dialogue: 0,0:23:40.91,0:23:43.21,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.42,0:23:45.79,Default,,0,0,0,,Теңдесі жоқ! Үш есе әсер! !
Dialogue: 0,0:23:46.29,0:23:49.92,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.42,0:23:57.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory