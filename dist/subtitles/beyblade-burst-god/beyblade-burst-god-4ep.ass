Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.21,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.48,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.10,0:00:29.90,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:32.28,0:00:34.99,Default,,0,0,0,,Беделді испандық BC Sol командасымен
Dialogue: 0,0:00:35.07,0:00:38.53,Default,,0,0,0,,Жаңа күш-қуат Реал Самбат арасындағы жолдастық кездесу
Dialogue: 0,0:00:38.91,0:00:41.70,Default,,0,0,0,,Ұрыс әр командада 3 адамнан басталады!
Dialogue: 0,0:00:42.16,0:00:43.54,Default,,0,0,0,,Бұл жолғы ережелер:
Dialogue: 0,0:00:43.62,0:00:47.13,Default,,0,0,0,,Команда капитаны ойынға ойыншыларды ұсынады
Dialogue: 0,0:00:47.21,0:00:49.38,Default,,0,0,0,,Алдымен 2 ұпаймен жеңіңіз
Dialogue: 0,0:00:49.71,0:00:52.80,Default,,0,0,0,,Командаңыз үш жеңіске жеткенше мұны жалғастырыңыз.
Dialogue: 0,0:00:53.38,0:00:55.80,Default,,0,0,0,,Кумичо бірінші ойында пайда болады.
Dialogue: 0,0:00:56.09,0:00:58.09,Default,,0,0,0,,Жеңіс! Кумичо
Dialogue: 0,0:00:58.39,0:01:02.10,Default,,0,0,0,,Вакияға қараңыз, жаңа Рагнарук күші!
Dialogue: 0,0:01:02.56,0:01:04.98,Default,,0,0,0,,Өзгерген жалғыз адам болма
Dialogue: 0,0:01:05.39,0:01:08.19,Default,,0,0,0,,Ал, шығанақты тексерейік!
Dialogue: 0,0:01:08.27,0:01:10.98,Default,,0,0,0,,Бір-біріңіздің бұғаздарын емдеңіздер.
Dialogue: 0,0:01:11.86,0:01:14.28,Default,,0,0,0,,Бұл жаңа Вайверн бе?
Dialogue: 0,0:01:14.57,0:01:17.07,Default,,0,0,0,,Менің вивернім де қайта туды.
Dialogue: 0,0:01:17.99,0:01:19.82,Default,,0,0,0,,Торнадо Вайверн!
Dialogue: 0,0:01:20.53,0:01:22.41,Default,,0,0,0,,Торнадо Вайверн?
Dialogue: 0,0:01:23.66,0:01:25.41,Default,,0,0,0,,Бұл қандай қабат?
Dialogue: 0,0:01:26.58,0:01:29.75,Default,,0,0,0,,Жылжы! Оның қандай күші бар?
Dialogue: 0,0:01:30.46,0:01:33.17,Default,,0,0,0,,♪~
Dialogue: 0,0:01:33.25,0:01:35.67,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:35.76,0:01:38.26,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:38.34,0:01:40.64,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:40.72,0:01:43.22,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:43.31,0:01:44.85,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:44.93,0:01:49.10,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:50.06,0:01:54.82,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:54.90,0:01:59.41,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:59.91,0:02:04.66,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:04.74,0:02:09.67,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:09.75,0:02:14.63,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:14.71,0:02:19.68,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:19.76,0:02:23.05,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:23.14,0:02:24.72,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:24.81,0:02:27.31,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:27.39,0:02:29.60,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:29.69,0:02:31.86,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:31.94,0:02:33.19,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:33.27,0:02:34.73,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:34.82,0:02:37.19,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:37.28,0:02:43.58,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:43.66,0:02:47.83,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:47.91,0:02:50.12,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:50.79,0:02:53.17,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:53.25,0:02:55.67,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:55.75,0:02:57.76,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:57.76,0:02:59.76,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:57.76,0:02:59.76,Default,,0,0,0,,~♪
Dialogue: 0,0:03:01.26,0:03:04.22,Default,,0,0,0,,Құйын! Торнадо Вайверн!
Dialogue: 0,0:03:15.11,0:03:17.11,Default,,0,0,0,,Торнадо Вайверн...
Dialogue: 0,0:03:17.98,0:03:20.90,Default,,0,0,0,,Сіз оны қанша уақыт көресіз? Қайдан көрдің?
Dialogue: 0,0:03:20.99,0:03:23.70,Default,,0,0,0,,Бейдің қаншалықты ғажайып екенін түсірмейінше түсіне алмайсың.
Dialogue: 0,0:03:24.07,0:03:25.28,Default,,0,0,0,,Ура!
Dialogue: 0,0:03:25.37,0:03:28.54,Default,,0,0,0,,Тіпті Рагнаруктың өзі сіз түсінбейтін нәрселерге толы.
Dialogue: 0,0:03:28.62,0:03:30.96,Default,,0,0,0,,Маңызды емес, жеңгім келмейді.
Dialogue: 0,0:03:31.29,0:03:33.54,Default,,0,0,0,,Енді үлкен мәлімдеме жасайтын кез келді.
Dialogue: 0,0:03:33.63,0:03:37.42,Default,,0,0,0,,Жарайды! Байқау аяқталды, екеуі де стадионда!
Dialogue: 0,0:03:37.71,0:03:41.05,Default,,0,0,0,,Торнадо Вайверн Қалай екеніңізді көрейік!
Dialogue: 0,0:03:43.22,0:03:44.59,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:44.84,0:03:45.64,Default,,0,0,0,,О!
Dialogue: 0,0:03:45.89,0:03:49.35,Default,,0,0,0,,Қазір нағыз самбат соңғы кездері қарқын алып келеді.
Dialogue: 0,0:03:49.43,0:03:52.48,Default,,0,0,0,,Жаудың BC Соль аумағындағы жолдастық кездесу!
Dialogue: 0,0:03:52.64,0:03:55.98,Default,,0,0,0,,Рантаро Кияма Вакия Комурасакиге қарсы!
Dialogue: 0,0:03:56.61,0:03:59.44,Default,,0,0,0,,Бірінші ойын Бірінші шайқас
Dialogue: 0,0:04:00.94,0:04:02.65,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:04:02.90,0:04:06.16,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:06.49,0:04:09.12,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:14.79,0:04:18.09,Default,,0,0,0,,Жарайды, төзімділік қанаты ашылады.
Dialogue: 0,0:04:18.38,0:04:20.63,Default,,0,0,0,,Кетейік, Уайверн!
Dialogue: 0,0:04:21.01,0:04:22.42,Default,,0,0,0,,Бұл басталды!
Dialogue: 0,0:04:22.51,0:04:25.30,Default,,0,0,0,,Торнадо Вайверн және Блэйз Рагнарук
Dialogue: 0,0:04:25.39,0:04:27.72,Default,,0,0,0,,Мен орталыққа қарай жүгіре бастадым!
Dialogue: 0,0:04:29.31,0:04:30.60,Default,,0,0,0,,Рагнарук не болды?
Dialogue: 0,0:04:32.39,0:04:33.94,Default,,0,0,0,,Бар, Кумичо!
Dialogue: 0,0:04:37.56,0:04:38.65,Default,,0,0,0,,Не?
Dialogue: 0,0:04:39.02,0:04:41.65,Default,,0,0,0,,Келіспе, Вайверн
Dialogue: 0,0:04:41.73,0:04:43.78,Default,,0,0,0,,Мен көбірек қорқамын.
Dialogue: 0,0:04:44.07,0:04:46.28,Default,,0,0,0,,Келесі виверн керемет.
Dialogue: 0,0:04:49.66,0:04:52.66,Default,,0,0,0,,Себебі сіз Инаши қабатымен қарсыластың шабуылын аласыз.
Dialogue: 0,0:04:52.75,0:04:54.96,Default,,0,0,0,,Зақым негізгі блокқа берілмейді.
Dialogue: 0,0:04:55.37,0:04:56.21,Default,,0,0,0,,Не...
Dialogue: 0,0:04:56.58,0:04:59.96,Default,,0,0,0,,Не керек, жүргізуші де құпия сақталады.
Dialogue: 0,0:05:00.21,0:05:03.13,Default,,0,0,0,,Таң қалдыңыз ба? Сіз оны жасадыңыз ба?
Dialogue: 0,0:05:03.21,0:05:04.17,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:05:04.26,0:05:07.22,Default,,0,0,0,,Бұрын-соңды болмаған қорғанысы бар қорғаныс түрі
Dialogue: 0,0:05:07.89,0:05:11.18,Default,,0,0,0,,Бұл Торнадо Вайверннің артында тұрған дизайн философиясы.
Dialogue: 0,0:05:11.85,0:05:16.44,Default,,0,0,0,,Алдымен еркін айналатын үлкен шарды пайдаланып қорғаныс күшін арттырдық.
Dialogue: 0,0:05:16.52,0:05:20.06,Default,,0,0,0,,Ал айналадағы сақиналар да өз бетінше айналады...
Dialogue: 0,0:05:20.15,0:05:24.32,Default,,0,0,0,,Қарсыласыңыздан шабуыл алсаңыз да, ринг алға еңкею арқылы сізге қолдау көрсетеді.
Dialogue: 0,0:05:24.40,0:05:27.57,Default,,0,0,0,,Нәтижесінде, уиверн зақымданбаған.
Dialogue: 0,0:05:27.86,0:05:29.70,Default,,0,0,0,,Сен мықтысың, солай ма?
Dialogue: 0,0:05:29.78,0:05:30.74,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:05:31.12,0:05:32.74,Default,,0,0,0,,Содан кейін «күшті» деңіз
Dialogue: 0,0:05:33.20,0:05:34.79,Default,,0,0,0,,Мен сондай күштімін
Dialogue: 0,0:05:34.87,0:05:37.62,Default,,0,0,0,,Біз көптеген нұсқалар бар деп есептейміз.
Dialogue: 0,0:05:37.75,0:05:40.92,Default,,0,0,0,,шығанақ түріне қосымша, әрбір шығанақ
Dialogue: 0,0:05:41.00,0:05:45.09,Default,,0,0,0,,Әртүрлі функциялар және оларды пайдаланатын пышақтардың сипаттамалары...
Dialogue: 0,0:05:46.51,0:05:48.72,Default,,0,0,0,,Қандай қиын нәрсе.
Dialogue: 0,0:05:49.76,0:05:50.97,Default,,0,0,0,,Ой… ой, жоқ
Dialogue: 0,0:05:51.64,0:05:54.72,Default,,0,0,0,,Ой, Рагнарук, тоқтайтын сияқты.
Dialogue: 0,0:05:55.06,0:05:57.35,Default,,0,0,0,,Рагнарук Жабысқақ!
Dialogue: 0,0:05:58.94,0:06:00.61,Default,,0,0,0,,Әй, кез келген сәтте... кез келген сәтте...
Dialogue: 0,0:06:00.69,0:06:02.23,Default,,0,0,0,,О, тоқтады!
Dialogue: 0,0:06:02.57,0:06:03.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:04.36,0:06:06.90,Default,,0,0,0,,Торнадо Виверн Айналдыру
Dialogue: 0,0:06:06.99,0:06:08.99,Default,,0,0,0,,Нағыз Самбат үшін 1 ұпай
Dialogue: 0,0:06:09.07,0:06:11.49,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:11.78,0:06:12.74,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:06:13.03,0:06:15.58,Default,,0,0,0,,Дүниеге жететін құдірет осы!
Dialogue: 0,0:06:15.95,0:06:18.12,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:19.12,0:06:22.67,Default,,0,0,0,,Бірінші ұпайды Нағыз Самбат алды!
Dialogue: 0,0:06:22.75,0:06:26.46,Default,,0,0,0,,Торнадо Вайверн Сіз бізге қорқынышты күшіңізді көрсеттіңіз.
Dialogue: 0,0:06:26.71,0:06:28.38,Default,,0,0,0,,Кумичо, мықты бол!
Dialogue: 0,0:06:28.47,0:06:29.93,Default,,0,0,0,,Сәттілік Кумичо!
Dialogue: 0,0:06:30.01,0:06:34.26,Default,,0,0,0,,Қане, тек басында ғана жақсы ма? Жапон...
Dialogue: 0,0:06:34.35,0:06:37.18,Default,,0,0,0,,Джанго-кун, ұзақ көзқарасты алайық.
Dialogue: 0,0:06:37.27,0:06:40.35,Default,,0,0,0,,Қожайын неге ол жігітті таңдады деп ойлаймын.
Dialogue: 0,0:06:40.44,0:06:44.48,Default,,0,0,0,,Әлі 1 ұпай «Қарт — ат» деген теңеу де бар.
Dialogue: 0,0:06:44.57,0:06:47.82,Default,,0,0,0,,Риксонның айтқаны Бұл әрқашан жұмбақ
Dialogue: 0,0:06:50.49,0:06:51.86,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:54.91,0:06:59.21,Default,,0,0,0,,Бар, Кумичо, келесі жолы біз бәрін бұрқыратамыз!
Dialogue: 0,0:07:01.83,0:07:02.63,Default,,0,0,0,,Қалай
Dialogue: 0,0:07:02.71,0:07:05.88,Default,,0,0,0,,Рагнарук өте керемет көрінеді.
Dialogue: 0,0:07:06.38,0:07:09.09,Default,,0,0,0,,Менің Wyvern әлдеқайда жақсы!
Dialogue: 0,0:07:09.30,0:07:10.72,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:07:10.80,0:07:13.85,Default,,0,0,0,,Кешіріңіз, қайта туылған Блэйз Рагнарук.
Dialogue: 0,0:07:14.47,0:07:17.39,Default,,0,0,0,,Мен сізге шыдамдылық түрін көрсетемін!
Dialogue: 0,0:07:17.47,0:07:19.39,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:07:19.98,0:07:21.64,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:07:22.06,0:07:25.11,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:25.31,0:07:27.65,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:29.36,0:07:32.07,Default,,0,0,0,,Енді екінші шайқас басталсын!
Dialogue: 0,0:07:32.24,0:07:35.07,Default,,0,0,0,,Реал Самбат тағы бір ұпаймен жеңе ме?
Dialogue: 0,0:07:35.16,0:07:38.04,Default,,0,0,0,,BC Sol жеңіп, қуа ала ма?
Dialogue: 0,0:07:38.33,0:07:42.46,Default,,0,0,0,,Инаши қабаты дегеніміз не?
Dialogue: 0,0:07:43.04,0:07:46.21,Default,,0,0,0,,Бұл дүниеде тек жүрекпен орындалмайтын нәрселер көп.
Dialogue: 0,0:07:46.29,0:07:47.50,Default,,0,0,0,,Менің үйренгім келеді!
Dialogue: 0,0:07:47.80,0:07:49.34,Default,,0,0,0,,Шулы!
Dialogue: 0,0:07:49.71,0:07:52.38,Default,,0,0,0,,Рагнарук! Мен қайтадан Уайвернаға қарай бет алып барамын.
Dialogue: 0,0:07:52.47,0:07:53.89,Default,,0,0,0,,Уайверн қайтарылды!
Dialogue: 0,0:07:54.22,0:07:57.14,Default,,0,0,0,,Мына жерге түс, мен сені талқандаймын!
Dialogue: 0,0:07:59.02,0:08:00.02,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:08:00.10,0:08:01.14,Default,,0,0,0,,Ой!
Dialogue: 0,0:08:01.31,0:08:03.64,Default,,0,0,0,,Вайверн Біртіндеп жылдамдайды.
Dialogue: 0,0:08:03.98,0:08:06.02,Default,,0,0,0,,Қалқан апаты!
Dialogue: 0,0:08:06.27,0:08:07.82,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:08:08.48,0:08:10.11,Default,,0,0,0,,Ахх!
Dialogue: 0,0:08:10.61,0:08:12.61,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:08:13.40,0:08:14.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:15.24,0:08:17.58,Default,,0,0,0,,Торнадо Уайверннің жарылуы
Dialogue: 0,0:08:17.87,0:08:21.62,Default,,0,0,0,,«Реал Самбат» бірінші ойында 3:0 есебімен жеңіске жетті!
Dialogue: 0,0:08:21.70,0:08:25.12,Default,,0,0,0,,Бірінші ойын шешілді!
Dialogue: 0,0:08:25.21,0:08:28.29,Default,,0,0,0,,Жетекші болған адам Нағыз Самбаттың иесі және пышақ болды.
Dialogue: 0,0:08:28.38,0:08:31.05,Default,,0,0,0,,Комурасаки Вакия! Браво!
Dialogue: 0,0:08:31.13,0:08:32.17,Default,,0,0,0,,Қалай!
Dialogue: 0,0:08:32.80,0:08:35.43,Default,,0,0,0,,Рантаро Кияма мен Барто Аоидың қатысуы
Dialogue: 0,0:08:35.51,0:08:37.76,Default,,0,0,0,,Бұл иесінің өтініші, солай ма?
Dialogue: 0,0:08:37.85,0:08:38.64,Default,,0,0,0,,Иә
Dialogue: 0,0:08:39.18,0:08:43.60,Default,,0,0,0,,Олар таныс сияқты, сондықтан жеңіске жету туралы өтініш болған шығар.
Dialogue: 0,0:08:44.39,0:08:46.40,Default,,0,0,0,,Мен шешім қабылдадым
Dialogue: 0,0:08:46.60,0:08:47.61,Default,,0,0,0,,Әрине
Dialogue: 0,0:08:47.69,0:08:50.07,Default,,0,0,0,,Бірақ егер олар жеңілсе...
Dialogue: 0,0:08:50.23,0:08:52.40,Default,,0,0,0,,Неліктен жеңілу туралы ойлайсыз?
Dialogue: 0,0:08:52.49,0:08:54.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:55.07,0:08:57.62,Default,,0,0,0,,Мен тек жеңіс туралы ойлаймын.
Dialogue: 0,0:08:59.24,0:09:00.37,Default,,0,0,0,,Кумичо
Dialogue: 0,0:09:00.79,0:09:04.37,Default,,0,0,0,,Кешіріңіз, Барто, менің айтар жақсы сөзім болған жоқ.
Dialogue: 0,0:09:06.08,0:09:08.17,Default,,0,0,0,,Уайверн керемет дамыды.
Dialogue: 0,0:09:09.17,0:09:10.09,Default,,0,0,0,,О
Dialogue: 0,0:09:10.17,0:09:11.63,Default,,0,0,0,,Сіз
Dialogue: 0,0:09:12.05,0:09:14.05,Default,,0,0,0,,Бұл төзімділік түрі.
Dialogue: 0,0:09:14.13,0:09:17.89,Default,,0,0,0,,Қанатқа да төзімділік жібере алатындай атыңыз.
Dialogue: 0,0:09:18.22,0:09:19.01,Default,,0,0,0,,Не?
Dialogue: 0,0:09:19.10,0:09:19.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:19.97,0:09:24.56,Default,,0,0,0,,Рагнаруктың қанаттары қарсыласпен соқтығысқанда қайтып оралады, солай ма?
Dialogue: 0,0:09:24.68,0:09:27.19,Default,,0,0,0,,Әрқашан сыртта болу тиімдірек.
Dialogue: 0,0:09:27.27,0:09:30.06,Default,,0,0,0,,Центрден тепкіш күш Айналу күшін арттыру-
Dialogue: 0,0:09:30.15,0:09:33.40,Default,,0,0,0,,Қанаттарым сыртқа шығып тұруы үшін маған төзімділік қажет.
Dialogue: 0,0:09:33.82,0:09:37.70,Default,,0,0,0,,Эй, сен сол айналымға қалай оралу керектігін білесің бе?
Dialogue: 0,0:09:37.82,0:09:39.16,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:39.24,0:09:40.62,Default,,0,0,0,,Керемет
Dialogue: 0,0:09:41.28,0:09:43.29,Default,,0,0,0,,Жарайды, мен істеймін.
Dialogue: 0,0:09:43.37,0:09:44.87,Default,,0,0,0,,Оны атаңыз және шыдамдылығыңызды көрсетіңіз!
Dialogue: 0,0:09:44.95,0:09:46.29,Default,,0,0,0,,Атын айтуға асығыңыз!
Dialogue: 0,0:09:46.96,0:09:48.87,Default,,0,0,0,,Мен мақсатты шештім.
Dialogue: 0,0:09:49.17,0:09:51.92,Default,,0,0,0,,Біз бұл жігіттің жақсы жақтарын барынша пайдалануымыз керек.
Dialogue: 0,0:09:52.38,0:09:54.71,Default,,0,0,0,,Маған оны дүние жүзінде қабылдамайтынын айтты.
Dialogue: 0,0:09:55.30,0:09:56.42,Default,,0,0,0,,Жетеді ме?
Dialogue: 0,0:09:56.51,0:09:57.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:57.63,0:09:59.18,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:09:59.76,0:10:01.01,Default,,0,0,0,,А...
Dialogue: 0,0:10:04.93,0:10:07.94,Default,,0,0,0,,Әй, бәрінің көңіл-күйін көтеріңіз...
Dialogue: 0,0:10:08.02,0:10:09.60,Default,,0,0,0,,Енді мен саған барамын.
Dialogue: 0,0:10:10.40,0:10:11.27,Default,,0,0,0,,Мен?
Dialogue: 0,0:10:11.90,0:10:13.19,Default,,0,0,0,,Жарайсыңдар! тозақ!
Dialogue: 0,0:10:13.27,0:10:14.23,Default,,0,0,0,,...бұл қателік пе!
Dialogue: 0,0:10:14.73,0:10:17.24,Default,,0,0,0,,Мен Кумичо Вакияны жеңемін!
Dialogue: 0,0:10:19.07,0:10:21.49,Default,,0,0,0,,Ах, ләззат алыңыз, Балто!
Dialogue: 0,0:10:21.74,0:10:22.53,Default,,0,0,0,,О
Dialogue: 0,0:10:25.04,0:10:26.41,Default,,0,0,0,,Жасайық Валькирия
Dialogue: 0,0:10:28.25,0:10:30.08,Default,,0,0,0,,Келдің бе? Барто
Dialogue: 0,0:10:32.04,0:10:33.46,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:33.54,0:10:35.38,Default,,0,0,0,,Неге мұнда қайтып келмейсің?
Dialogue: 0,0:10:35.46,0:10:37.17,Default,,0,0,0,,Ол одан әрі көрінетін сияқты.
Dialogue: 0,0:10:37.26,0:10:38.67,Default,,0,0,0,,Отбасымнан алыста~!
Dialogue: 0,0:10:38.88,0:10:40.84,Default,,0,0,0,,Бұл біздің кезегіміз емес дегенді білдіре ме?
Dialogue: 0,0:10:40.93,0:10:42.22,Default,,0,0,0,,Мен артынан келіп, оның көзі мен аузын жауып, «Сізді екінші Кира болуы мүмкін деген күдікпен қамауға аламыз» дедім.
Dialogue: 0,0:10:42.51,0:10:46.60,Default,,0,0,0,,Бұрынғы жолдастарыңызбен жекпе-жектен рахаттанып жатқан сияқтысыз.
Dialogue: 0,0:10:46.85,0:10:49.14,Default,,0,0,0,,Мұны Жапонияда ғана жасаңыз.
Dialogue: 0,0:10:50.81,0:10:52.81,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:55.52,0:10:57.28,Default,,0,0,0,,Александр Гилтен
Dialogue: 0,0:10:57.57,0:10:58.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:59.86,0:11:02.74,Default,,0,0,0,,Сәлеметсіз бе, Крис ханым
Dialogue: 0,0:11:02.82,0:11:04.95,Default,,0,0,0,,Кенеттен келген сапарыңыздан ләззат алыңыз.
Dialogue: 0,0:11:05.74,0:11:07.16,Default,,0,0,0,,Сәлем Гилтен
Dialogue: 0,0:11:07.87,0:11:11.83,Default,,0,0,0,,Сенің келетініңді білсем, сәлем беруге жіберер едім.
Dialogue: 0,0:11:12.50,0:11:15.92,Default,,0,0,0,,Бірінші ойында жеңіліп қалдым, бұл өте қиын болды.
Dialogue: 0,0:11:16.84,0:11:18.30,Default,,0,0,0,,Бір ғана ойын қалды
Dialogue: 0,0:11:18.80,0:11:20.42,Default,,0,0,0,,Тұру маңызды
Dialogue: 0,0:11:20.72,0:11:23.59,Default,,0,0,0,,Әлсіз команданың қазіргі жағдайы BC Sol
Dialogue: 0,0:11:23.68,0:11:27.72,Default,,0,0,0,,Орамда жүрген Нағыз Самбаттың қазіргі жағдайына қарап тұрсыз ба?
Dialogue: 0,0:11:28.18,0:11:30.35,Default,,0,0,0,,BC Соль әлсіз емес
Dialogue: 0,0:11:30.85,0:11:32.23,Default,,0,0,0,,Бұл дәл өткен жолымен бірдей, кішкентай сорлы!
Dialogue: 0,0:11:32.60,0:11:34.86,Default,,0,0,0,,Бір кездері беделді клуб болғандықтан
Dialogue: 0,0:11:34.94,0:11:37.48,Default,,0,0,0,,Бұл топтың нашар дамуының нәтижесі ме?
Dialogue: 0,0:11:39.40,0:11:40.49,Default,,0,0,0,,Сол жерде екеуің қақтығысқанда не болды?
Dialogue: 0,0:11:41.03,0:11:44.12,Default,,0,0,0,,Еркін Де Ла Хойя осында жанып тұр.
Dialogue: 0,0:11:44.53,0:11:47.49,Default,,0,0,0,,Америкада демалу оңай емес пе?
Dialogue: 0,0:11:48.12,0:11:51.00,Default,,0,0,0,,Менің командам, Нью-Йорк Буллз, мұны істеп үлгерді.
Dialogue: 0,0:11:51.08,0:11:52.71,Default,,0,0,0,,Жапон өрушісі
Dialogue: 0,0:11:52.87,0:11:56.67,Default,,0,0,0,,Америка шығанағы әлемді жаулап алуда.
Dialogue: 0,0:11:57.80,0:12:00.88,Default,,0,0,0,,Фри-кун міндетті түрде жұлдызға айналады.
Dialogue: 0,0:12:01.26,0:12:03.47,Default,,0,0,0,,Егер солай болса, мен оны талай рет айттым...
Dialogue: 0,0:12:04.26,0:12:06.55,Default,,0,0,0,,Егер сіз аударуға келісесіз...
Dialogue: 0,0:12:06.64,0:12:09.60,Default,,0,0,0,,Мен сізге жақсырақ шарттарды ұсынғым келеді.
Dialogue: 0,0:12:09.93,0:12:11.31,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:12:17.90,0:12:19.82,Default,,0,0,0,,Аники, мұны істе
Dialogue: 0,0:12:20.15,0:12:21.82,Default,,0,0,0,,Дайындықты тексеру
Dialogue: 0,0:12:21.90,0:12:24.86,Default,,0,0,0,,Иесінің итеру мүмкіндігі бар ма...
Dialogue: 0,0:12:25.11,0:12:27.58,Default,,0,0,0,,Мен шайқасты әлі көрген жоқпын.
Dialogue: 0,0:12:28.16,0:12:30.62,Default,,0,0,0,,Рантаро қорқынышты нәтижелерге қол жеткізді.
Dialogue: 0,0:12:30.79,0:12:33.66,Default,,0,0,0,,Бартқа қызығушылық таныту табиғи емес пе?
Dialogue: 0,0:12:34.29,0:12:36.29,Default,,0,0,0,,Джанго дұрыс айтады.
Dialogue: 0,0:12:37.46,0:12:40.84,Default,,0,0,0,,Екінші ойын - BC Sol Aoi Balt vs.
Dialogue: 0,0:12:40.92,0:12:43.92,Default,,0,0,0,,Нағыз Самбат Комурасаки Вакия болып қала береді.
Dialogue: 0,0:12:44.34,0:12:46.18,Default,,0,0,0,,Екінші ойын да оған тұрарлық па?
Dialogue: 0,0:12:46.47,0:12:48.80,Default,,0,0,0,,Меншік құқығы, солай ма?
Dialogue: 0,0:12:49.18,0:12:52.43,Default,,0,0,0,,Меншік иесі болу керемет сезім.
Dialogue: 0,0:12:52.98,0:12:56.48,Default,,0,0,0,,Вакия екеніне қуаныштымын, бұл Кумичоның үйі
Dialogue: 0,0:12:56.81,0:12:58.19,Default,,0,0,0,,Мен сені талқандаймын
Dialogue: 0,0:12:58.56,0:13:00.61,Default,,0,0,0,,Валькири кеттік!
Dialogue: 0,0:13:00.86,0:13:03.44,Default,,0,0,0,,Екінші ойын Бірінші шайқас
Dialogue: 0,0:13:04.90,0:13:06.61,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:13:07.57,0:13:10.33,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:10.70,0:13:13.20,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:14.58,0:13:16.29,Default,,0,0,0,,Екінші ойын басталды!
Dialogue: 0,0:13:16.37,0:13:18.92,Default,,0,0,0,,Торнадо Уайверн Орталыққа қарай жылдам
Dialogue: 0,0:13:19.00,0:13:20.17,Default,,0,0,0,,Валькирия
Dialogue: 0,0:13:20.25,0:13:23.17,Default,,0,0,0,,Байланысты қабаттың қуатын көрсетіңіз
Dialogue: 0,0:13:28.18,0:13:31.72,Default,,0,0,0,,Секіру немен байланысты? Осылайша, бұл инаши қабаты.
Dialogue: 0,0:13:31.81,0:13:34.27,Default,,0,0,0,,Ешқандай шабуыл болмағандай кейіп танытамын.
Dialogue: 0,0:13:34.64,0:13:36.94,Default,,0,0,0,,Амал жоқ, көбірек шабуыл жасаңыз.
Dialogue: 0,0:13:37.19,0:13:39.48,Default,,0,0,0,,Валькири табанды түрде шабуыл жасайды, бірақ
Dialogue: 0,0:13:39.56,0:13:41.02,Default,,0,0,0,,Уиверн еріксіз
Dialogue: 0,0:13:41.32,0:13:43.36,Default,,0,0,0,,Сәттілік Валькири!
Dialogue: 0,0:13:46.49,0:13:47.74,Default,,0,0,0,,Жарайсың Аники
Dialogue: 0,0:13:47.82,0:13:48.66,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:13:49.11,0:13:52.70,Default,,0,0,0,,Жоқ, Вакия мырза бұл әдісті қайта қолдануды жоспарлап отыр.
Dialogue: 0,0:13:54.79,0:13:58.21,Default,,0,0,0,,Міне, біз тағы да барамыз, Shield Crash!
Dialogue: 0,0:14:04.30,0:14:06.76,Default,,0,0,0,,Торнадо Виверн
Dialogue: 0,0:14:06.84,0:14:09.01,Default,,0,0,0,,Нағыз Самбат үшін 1 ұпай
Dialogue: 0,0:14:09.13,0:14:11.30,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:11.76,0:14:14.35,Default,,0,0,0,,Нағыз Самбат қайтадан алға шығады
Dialogue: 0,0:14:14.72,0:14:17.85,Default,,0,0,0,,Торнадо Вайверннің импульсі тоқтаусыз!
Dialogue: 0,0:14:18.19,0:14:20.06,Default,,0,0,0,,Әй, Барто...
Dialogue: 0,0:14:22.40,0:14:23.69,Default,,0,0,0,,Аники
Dialogue: 0,0:14:23.77,0:14:25.82,Default,,0,0,0,,Мен тағы да алдын ала болдым.
Dialogue: 0,0:14:25.90,0:14:27.07,Default,,0,0,0,,Бұл жерде жақсы ештеңе жоқ.
Dialogue: 0,0:14:28.78,0:14:30.78,Default,,0,0,0,,Мен өзімді жақсы сезінемін.
Dialogue: 0,0:14:31.12,0:14:33.53,Default,,0,0,0,,Менің кезегім, көмектесу мүмкін емес сияқты.
Dialogue: 0,0:14:33.78,0:14:36.37,Default,,0,0,0,,Мүмкін, егер сіз Вакия болсаңыз!
Dialogue: 0,0:14:36.50,0:14:37.20,Default,,0,0,0,,Tsk
Dialogue: 0,0:14:37.83,0:14:39.12,Default,,0,0,0,,Валькирия
Dialogue: 0,0:14:39.42,0:14:42.13,Default,,0,0,0,,Сенің күшің ондай емес.
Dialogue: 0,0:14:42.42,0:14:45.05,Default,,0,0,0,,Бұлай болмаса, қандай болар еді?
Dialogue: 0,0:14:45.38,0:14:48.38,Default,,0,0,0,,Ешбір шабуыл менің вивернама қарсы жұмыс істемейді.
Dialogue: 0,0:14:48.84,0:14:52.01,Default,,0,0,0,,Өйткені, оны менің данышпаным жасады.
Dialogue: 0,0:14:52.55,0:14:54.05,Default,,0,0,0,,Бұл құрмет, Вакия мырза.
Dialogue: 0,0:14:54.14,0:14:54.81,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:14:55.22,0:14:57.77,Default,,0,0,0,,Екінші шайқас Мен оны қайтарамын!
Dialogue: 0,0:14:57.85,0:14:59.10,Default,,0,0,0,,Балто!
Dialogue: 0,0:14:59.81,0:15:00.85,Default,,0,0,0,,Бір сәт осында кел.
Dialogue: 0,0:15:01.10,0:15:02.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:02.10,0:15:03.90,Default,,0,0,0,,Не, стратегиялық кездесу?
Dialogue: 0,0:15:04.44,0:15:06.65,Default,,0,0,0,,Иә, иә, барыңыз.
Dialogue: 0,0:15:08.32,0:15:09.86,Default,,0,0,0,,Бұл не, Кумичо?
Dialogue: 0,0:15:09.95,0:15:12.07,Default,,0,0,0,,Мен емес, мына жігіт
Dialogue: 0,0:15:14.03,0:15:15.24,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:15:15.91,0:15:17.12,Default,,0,0,0,,Бұл баяғыда болды!
Dialogue: 0,0:15:17.83,0:15:19.20,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:15:20.04,0:15:21.12,Default,,0,0,0,,Рамка
Dialogue: 0,0:15:22.00,0:15:22.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:23.79,0:15:25.13,Default,,0,0,0,,Ол шығады.
Dialogue: 0,0:15:27.25,0:15:28.51,Default,,0,0,0,,Кадр?
Dialogue: 0,0:15:29.34,0:15:30.63,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:15:31.47,0:15:33.80,Default,,0,0,0,,Сіз білмейсіз бе? Бұл менің шығанағым
Dialogue: 0,0:15:34.05,0:15:34.97,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:15:35.60,0:15:38.10,Default,,0,0,0,,Қараңызшы, дискінің айналасындағы қызыл нәрсе.
Dialogue: 0,0:15:40.02,0:15:42.10,Default,,0,0,0,,Эй, оны шешіп алсаң болады.
Dialogue: 0,0:15:42.73,0:15:44.44,Default,,0,0,0,,Мен оны алып тастасам ше?
Dialogue: 0,0:15:47.73,0:15:48.86,Default,,0,0,0,,...Мен айтпаймын!
Dialogue: 0,0:15:50.90,0:15:52.66,Default,,0,0,0,,Әй, шықты!
Dialogue: 0,0:15:53.36,0:15:54.91,Default,,0,0,0,,Шынымды айтсам, мен оны сағындым.
Dialogue: 0,0:15:58.12,0:16:00.37,Default,,0,0,0,,Қазір басқа шығанақ сияқты.
Dialogue: 0,0:16:01.08,0:16:03.46,Default,,0,0,0,,Әй, сезім өзгерді.
Dialogue: 0,0:16:04.04,0:16:05.79,Default,,0,0,0,,Бұл нені өзгертеді?
Dialogue: 0,0:16:08.75,0:16:09.84,Default,,0,0,0,,...Мен айтпаймын!
Dialogue: 0,0:16:10.38,0:16:12.22,Default,,0,0,0,,Аники не істеп жатырсың?
Dialogue: 0,0:16:12.34,0:16:13.38,Default,,0,0,0,,Басқаша айтқанда… бұл…➡
Dialogue: 0,0:16:15.59,0:16:17.72,Default,,0,0,0,,Қызық, бұл нені білдіреді?
Dialogue: 0,0:16:18.18,0:16:21.23,Default,,0,0,0,,Эй, не? Хара ауырады ма?
Dialogue: 0,0:16:22.73,0:16:24.19,Default,,0,0,0,,Неге оны өзіңіз тексермеске?
Dialogue: 0,0:16:24.27,0:16:25.02,Default,,0,0,0,,Тегін
Dialogue: 0,0:16:26.27,0:16:28.52,Default,,0,0,0,,Мен оны шынымен түсінбеймін, бірақ жасап көремін!
Dialogue: 0,0:16:30.48,0:16:34.03,Default,,0,0,0,,Ал, BC Sol, операция уақыты аяқталған сияқты.
Dialogue: 0,0:16:34.45,0:16:36.82,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, Вакия.
Dialogue: 0,0:16:39.37,0:16:41.00,Default,,0,0,0,,А... мына Валкири
Dialogue: 0,0:16:41.50,0:16:43.62,Default,,0,0,0,,Әй, бұл аздап мазасызданады.
Dialogue: 0,0:16:44.33,0:16:45.92,Default,,0,0,0,,Кадрға не болды?
Dialogue: 0,0:16:46.42,0:16:48.88,Default,,0,0,0,,Хехе, мен не болатынын асыға күтемін.
Dialogue: 0,0:16:50.30,0:16:53.38,Default,,0,0,0,,Қандай айла қолдандың? Сіз Вивернге тең келе алмайсыз!
Dialogue: 0,0:16:54.17,0:16:55.59,Default,,0,0,0,,Екінші шайқас!
Dialogue: 0,0:16:55.93,0:16:57.97,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:16:58.30,0:17:01.35,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:02.06,0:17:04.31,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:05.60,0:17:07.10,Default,,0,0,0,,Сәтті соққы!
Dialogue: 0,0:17:07.19,0:17:09.57,Default,,0,0,0,,Сен осы жерден кетесің бе, Нағыз Самбат!
Dialogue: 0,0:17:09.65,0:17:12.53,Default,,0,0,0,,Әлде ұпайларды ұрлаймын ба? BC Sol!
Dialogue: 0,0:17:12.90,0:17:15.78,Default,,0,0,0,,Еркін Мен саған сенемін
Dialogue: 0,0:17:17.87,0:17:20.58,Default,,0,0,0,,Мен қайтадан орталықты алайын.
Dialogue: 0,0:17:20.91,0:17:23.87,Default,,0,0,0,,Сіздің шығанақ жылдамырақ келе жатқан сияқты.
Dialogue: 0,0:17:24.29,0:17:26.12,Default,,0,0,0,,Иә? Алақай!
Dialogue: 0,0:17:35.42,0:17:36.30,Default,,0,0,0,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,0:17:36.88,0:17:38.30,Default,,0,0,0,,Жасайық
Dialogue: 0,0:17:38.39,0:17:40.43,Default,,0,0,0,,Жақтауды тігу сізді жеңіл сезінді ме?
Dialogue: 0,0:17:40.51,0:17:43.35,Default,,0,0,0,,Ешқандай зиян келтірмеуін талап еткен уиверн.
Dialogue: 0,0:17:43.43,0:17:45.89,Default,,0,0,0,,Мені оңды-солды лақтырып жатыр!
Dialogue: 0,0:17:45.98,0:17:47.06,Default,,0,0,0,,Не!
Dialogue: 0,0:17:47.52,0:17:49.52,Default,,0,0,0,,Бұл жақтауды алып тастаудың әсері ме?
Dialogue: 0,0:17:49.90,0:17:51.98,Default,,0,0,0,,Аники, бұл жақсы сезінеді.
Dialogue: 0,0:17:52.07,0:17:53.78,Default,,0,0,0,,Балтоға сәттілік!
Dialogue: 0,0:17:53.86,0:17:55.32,Default,,0,0,0,,Кеттік, Валькири!
Dialogue: 0,0:17:57.24,0:17:58.95,Default,,0,0,0,,Жақтауды алу арқылы жеңілдеу
Dialogue: 0,0:17:59.49,0:18:02.33,Default,,0,0,0,,Қабырғалардан секіру кезіндегі үдеу ұлғайтылды.
Dialogue: 0,0:18:02.99,0:18:05.62,Default,,0,0,0,,Байланысқан қабаттың әсері күшейді.
Dialogue: 0,0:18:05.83,0:18:08.58,Default,,0,0,0,,Оның мұндай даналығы бар екеніне сене алар емеспін.
Dialogue: 0,0:18:09.96,0:18:11.21,Default,,0,0,0,,Бұл тегін.
Dialogue: 0,0:18:14.42,0:18:15.71,Default,,0,0,0,,Сол мыңжапырақ
Dialogue: 0,0:18:17.72,0:18:19.38,Default,,0,0,0,,Жарайды, мен кете аламын!
Dialogue: 0,0:18:28.31,0:18:30.40,Default,,0,0,0,,Жүр! Вайверн!
Dialogue: 0,0:18:33.90,0:18:36.40,Default,,0,0,0,,(Айдаһар айқайлайды)
Dialogue: 0,0:18:38.03,0:18:39.36,Default,,0,0,0,,Осы жылдамдықта
Dialogue: 0,0:18:39.45,0:18:41.49,Default,,0,0,0,,Мен қорғанысты үрлеймін!
Dialogue: 0,0:18:41.70,0:18:44.41,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:18:48.00,0:18:49.75,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:18:50.17,0:18:52.33,Default,,0,0,0,,Бар!
Dialogue: 0,0:18:55.25,0:18:59.17,Default,,0,0,0,,Қарғыс атсын! гипер қалқанның бұзылуы
Dialogue: 0,0:19:05.47,0:19:06.60,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:07.93,0:19:09.81,Default,,0,0,0,,Не... болды!
Dialogue: 0,0:19:10.48,0:19:12.60,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:19:13.36,0:19:16.86,Default,,0,0,0,,BC Сол екінші ойында 2-1 есебімен жеңіске жетті!
Dialogue: 0,0:19:17.07,0:19:18.90,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:19:19.49,0:19:20.36,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:19:21.07,0:19:22.45,Default,,0,0,0,,Мен оны келесі түрде қостым.
Dialogue: 0,0:19:22.53,0:19:23.41,Default,,0,0,0,,Иә
Dialogue: 0,0:19:23.78,0:19:25.28,Default,,0,0,0,,Аникиден күткендей
Dialogue: 0,0:19:25.37,0:19:26.62,Default,,0,0,0,,Керемет
Dialogue: 0,0:19:26.70,0:19:27.49,Default,,0,0,0,,О!
Dialogue: 0,0:19:27.66,0:19:29.96,Default,,0,0,0,,Дұрыс түсіндің, Балто.
Dialogue: 0,0:19:30.25,0:19:32.25,Default,,0,0,0,,Бәрі жақсы, оның соңы жақсы
Dialogue: 0,0:19:32.37,0:19:34.67,Default,,0,0,0,,Сіз оны қайта қарастырғыңыз келуі мүмкін.
Dialogue: 0,0:19:35.04,0:19:36.63,Default,,0,0,0,,Сіз ағынды өзгерттіңіз бе?
Dialogue: 0,0:19:36.71,0:19:40.05,Default,,0,0,0,,О, Джангоның біреуді мақтауы өте сирек.
Dialogue: 0,0:19:40.42,0:19:42.47,Default,,0,0,0,,Мені мақтап жатқанда ұсталма.
Dialogue: 0,0:19:42.72,0:19:44.47,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:19:44.93,0:19:46.47,Default,,0,0,0,,Хе хе хе
Dialogue: 0,0:19:47.85,0:19:50.02,Default,,0,0,0,,Бұл тегін жоспар ма?
Dialogue: 0,0:19:50.27,0:19:53.02,Default,,0,0,0,,Мен сені одан сайын қалаймын
Dialogue: 0,0:19:53.77,0:19:55.27,Default,,0,0,0,,Жарайсың Балто
Dialogue: 0,0:19:55.40,0:19:58.07,Default,,0,0,0,,Ах, Катаки ва Утазе Кумичо
Dialogue: 0,0:19:58.28,0:20:01.07,Default,,0,0,0,,Содан кейін Ангатона Тегін
Dialogue: 0,0:20:01.15,0:20:03.16,Default,,0,0,0,,Мұның бәрі сіздің арқаңызда.
Dialogue: 0,0:20:03.28,0:20:04.36,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:05.32,0:20:07.28,Default,,0,0,0,,Бұл өзгермейді, Балто.
Dialogue: 0,0:20:08.33,0:20:10.75,Default,,0,0,0,,Қуатты қосқыңыз келсе...
Dialogue: 0,0:20:10.83,0:20:13.25,Default,,0,0,0,,Бұл жерде де одан сайын өртенеді.
Dialogue: 0,0:20:13.62,0:20:16.50,Default,,0,0,0,,Мен Real Sambat сатып алуда қателік жібердім.
Dialogue: 0,0:20:17.17,0:20:20.34,Default,,0,0,0,,Сіз де солай ойлайсыз, солай ма? Шуу…
Dialogue: 0,0:20:25.05,0:20:26.26,Default,,0,0,0,,Сіз қашуға тырысып жатырсыз ба?
Dialogue: 0,0:20:26.85,0:20:28.18,Default,,0,0,0,,Сіз нені білдіреді?
Dialogue: 0,0:20:28.31,0:20:30.47,Default,,0,0,0,,Сіздің шетелге кетіп бара жатқаныңызды естідім.
Dialogue: 0,0:20:30.56,0:20:33.10,Default,,0,0,0,,Сіз Нью-Йорктегі командаға қосылмақшысыз ба?
Dialogue: 0,0:20:33.19,0:20:34.02,Default,,0,0,0,,О
Dialogue: 0,0:20:34.48,0:20:36.48,Default,,0,0,0,,Ха! Қызық емес пе?
Dialogue: 0,0:20:37.06,0:20:39.94,Default,,0,0,0,,Егер сізде солай болса, Балто да сізді қуып шығатынына сенімдімін.
Dialogue: 0,0:20:42.36,0:20:43.40,Default,,0,0,0,,Шешім
Dialogue: 0,0:20:44.20,0:20:46.74,Default,,0,0,0,,Егер бұл орын алса, мен әлемге кеңейемін.
Dialogue: 0,0:20:47.28,0:20:48.53,Default,,0,0,0,,өз жолым бойынша -
Dialogue: 0,0:20:48.62,0:20:51.54,Default,,0,0,0,,Мен сені әлемдегі ең үлкен сахнада жеңдім.
Dialogue: 0,0:20:52.12,0:20:52.96,Default,,0,0,0,,О
Dialogue: 0,0:20:54.87,0:20:56.29,Default,,0,0,0,,Нигасахенде!
Dialogue: 0,0:21:02.55,0:21:03.47,Default,,0,0,0,,Cisco
Dialogue: 0,0:21:04.26,0:21:06.59,Default,,0,0,0,,Сіздің кезегіңіз, солай ма? менікі
Dialogue: 0,0:21:07.59,0:21:08.68,Default,,0,0,0,,Керемет
Dialogue: 0,0:21:08.80,0:21:11.56,Default,,0,0,0,,Жақтауды алып тастағанда қандай айырмашылық бар!
Dialogue: 0,0:21:11.72,0:21:12.56,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:12.93,0:21:13.85,Default,,0,0,0,,О
Dialogue: 0,0:21:13.93,0:21:16.02,Default,,0,0,0,,Жылдамдық өзгерді.
Dialogue: 0,0:21:16.31,0:21:17.35,Default,,0,0,0,,Гааах!
Dialogue: 0,0:21:17.65,0:21:20.44,Default,,0,0,0,,Мен сені кездестіргенімде неге айтпадың?
Dialogue: 0,0:21:21.11,0:21:23.61,Default,,0,0,0,,Егер мен де жақтауды алып тастасам, мен ұтып алар едім, солай ма?
Dialogue: 0,0:21:23.69,0:21:24.61,Default,,0,0,0,,Сіз
Dialogue: 0,0:21:26.03,0:21:26.78,Default,,0,0,0,,Мен?
Dialogue: 0,0:21:27.57,0:21:28.66,Default,,0,0,0,,Иә, сіз
Dialogue: 0,0:21:29.32,0:21:30.45,Default,,0,0,0,,Келесі жолы жақсы.
Dialogue: 0,0:21:31.20,0:21:32.83,Default,,0,0,0,,Мен емес пе?
Dialogue: 0,0:21:32.95,0:21:35.16,Default,,0,0,0,,«Жақтауды алып тастау стратегиясы» Маған қолданып көруге рұқсат етіңіз.
Dialogue: 0,0:21:35.25,0:21:37.42,Default,,0,0,0,,Хехе, бұл өте жаман, Кумичо.
Dialogue: 0,0:21:37.54,0:21:39.88,Default,,0,0,0,,Валькири жақтауды алып тастағаннан кейін жеңілмейді.
Dialogue: 0,0:21:39.96,0:21:41.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:44.30,0:21:45.34,Default,,0,0,0,,Cisco
Dialogue: 0,0:21:45.42,0:21:46.97,Default,,0,0,0,,Келесі кім?
Dialogue: 0,0:21:47.05,0:21:48.43,Default,,0,0,0,,Сол қылмыскер... қайтыс болды ма?
Dialogue: 0,0:21:48.76,0:21:49.89,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:21:50.51,0:21:51.93,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:21:55.89,0:21:57.81,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.48,0:22:01.94,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:02.02,0:22:04.86,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.94,0:22:06.95,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.03,0:22:10.62,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.70,0:22:14.29,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.37,0:22:16.16,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.25,0:22:17.96,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.04,0:22:19.88,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.96,0:22:21.50,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.59,0:22:23.67,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.75,0:22:26.05,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.13,0:22:29.05,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.13,0:22:32.76,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.85,0:22:36.52,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.60,0:22:38.31,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.39,0:22:41.61,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.69,0:22:43.94,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.02,0:22:47.57,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.65,0:22:51.07,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.16,0:22:53.20,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.28,0:22:54.83,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:54.91,0:22:58.46,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.54,0:23:00.29,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.37,0:23:03.54,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.63,0:23:05.84,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.92,0:23:09.84,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.93,0:23:13.51,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.60,0:23:17.10,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.18,0:23:20.52,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.60,0:23:22.15,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.23,0:23:23.11,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:23.11,0:23:25.11,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:23.11,0:23:25.11,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.98,0:23:29.49,Default,,0,0,0,,Келесі қарсылас - бұл Cisco.
Dialogue: 0,0:23:30.03,0:23:32.74,Default,,0,0,0,,Не! Осы уақытқа дейін байсалды емес пе едің?
Dialogue: 0,0:23:33.03,0:23:35.41,Default,,0,0,0,,Онда мен Хонкидің шығуына рұқсат етемін.
Dialogue: 0,0:23:35.83,0:23:38.04,Default,,0,0,0,,Сонымен, кезек Еркінге келді.
Dialogue: 0,0:23:38.12,0:23:40.12,Default,,0,0,0,,Қанша істесем деймін.
Dialogue: 0,0:23:40.54,0:23:42.75,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:42.83,0:23:44.96,Default,,0,0,0,,Сиқырлы шабуыл! Шайтан жыла!
Dialogue: 0,0:23:45.34,0:23:48.55,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.05,0:23:56.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory