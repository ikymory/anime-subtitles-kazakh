Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.21,0:00:05.54,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.17,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.68,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.22,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.77,0:00:24.06,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.56,0:00:27.73,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.94,0:00:30.07,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:31.28,0:00:34.32,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.78,0:00:36.36,Default,,0,0,0,,Бару…
Dialogue: 0,0:00:37.41,0:00:38.58,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:00:42.54,0:00:44.66,Default,,0,0,0,,Керемет қызу шайқаста...
Dialogue: 0,0:00:44.75,0:00:46.88,Default,,0,0,0,,God Bladers Cup үшінші раунды да...
Dialogue: 0,0:00:46.96,0:00:48.63,Default,,0,0,0,,Бұл өте қызықты болды
Dialogue: 0,0:00:51.17,0:00:54.26,Default,,0,0,0,,Сәлем Корра! Мәңгілікке қашпа!
Dialogue: 0,0:00:54.55,0:00:56.26,Default,,0,0,0,,Онда барамыз ба?
Dialogue: 0,0:00:56.68,0:00:57.72,Default,,0,0,0,,Не?
Dialogue: 0,0:00:59.60,0:01:00.72,Default,,0,0,0,,
Dialogue: 0,0:01:07.81,0:01:09.44,Default,,0,0,0,,О... Эй, күте тұрыңыз.
Dialogue: 0,0:01:09.52,0:01:10.77,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:01:11.36,0:01:12.57,Default,,0,0,0,,Мен оны аяқтадым.
Dialogue: 0,0:01:13.07,0:01:14.24,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:01:15.57,0:01:19.12,Default,,0,0,0,,Менің серіктесім керемет дамыды.
Dialogue: 0,0:01:20.08,0:01:22.66,Default,,0,0,0,,Құдай Валькирия дүниеге келді!
Dialogue: 0,0:01:23.62,0:01:25.12,Default,,0,0,0,,Менің үшінші раундтағы қарсыласым
Dialogue: 0,0:01:25.21,0:01:27.75,Default,,0,0,0,,Бұл жылан шұңқырынан шыққан Норман Тарвер.
Dialogue: 0,0:01:28.92,0:01:31.59,Default,,0,0,0,,Немесисті аяқтаңыз!
Dialogue: 0,0:01:33.96,0:01:36.59,Default,,0,0,0,,Құдай қайта жүктесін!
Dialogue: 0,0:01:38.64,0:01:41.10,Default,,0,0,0,,Бұл соққы сізді өлтіреді.
Dialogue: 0,0:01:41.51,0:01:44.18,Default,,0,0,0,,Құдай жарсын!
Dialogue: 0,0:01:44.27,0:01:46.06,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:01:46.14,0:01:47.73,Default,,0,0,0,,Не... сонда...
Dialogue: 0,0:01:48.27,0:01:52.73,Default,,0,0,0,,Менің жолдасыммен бірге төртінші айналым тамаша өтеді.
Dialogue: 0,0:01:54.40,0:01:57.15,Default,,0,0,0,,♪~
Dialogue: 0,0:01:57.24,0:01:59.70,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:59.78,0:02:02.24,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:02.33,0:02:04.70,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:04.79,0:02:06.79,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:07.29,0:02:08.87,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:02:08.96,0:02:13.17,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:14.09,0:02:18.84,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:18.93,0:02:23.60,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:24.14,0:02:28.64,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:28.77,0:02:33.69,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:33.77,0:02:38.61,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:38.70,0:02:43.62,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:43.95,0:02:47.08,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:47.16,0:02:48.62,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:48.71,0:02:51.12,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:51.21,0:02:53.79,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:53.88,0:02:55.88,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:55.96,0:02:57.21,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:57.30,0:02:58.76,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:58.84,0:03:01.22,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:03:01.30,0:03:07.47,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:03:07.56,0:03:11.94,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:12.02,0:03:14.65,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:14.73,0:03:16.73,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:17.28,0:03:19.19,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:19.69,0:03:23.36,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:25.28,0:03:27.41,Default,,0,0,0,,Жою құдайы Спригган!
Dialogue: 0,0:03:29.91,0:03:33.04,Default,,0,0,0,,Жарайды, мен күтемін.
Dialogue: 0,0:03:33.12,0:03:37.13,Default,,0,0,0,,Төртінші раундтың матч картасын жариялаймыз!
Dialogue: 0,0:03:39.55,0:03:42.26,Default,,0,0,0,,Мен мұнда біраз қобалжыдым.
Dialogue: 0,0:03:42.34,0:03:43.80,Default,,0,0,0,,Мүмкін Аники де шығар?
Dialogue: 0,0:03:43.89,0:03:46.55,Default,,0,0,0,,Әй, жоқ... кім қобалжиды?
Dialogue: 0,0:03:46.64,0:03:48.60,Default,,0,0,0,,Сіз шынымен қобалжыған болуыңыз керек.
Dialogue: 0,0:03:48.68,0:03:49.64,Default,,0,0,0,,мен мұндай Риппл қолданушыны еркін жібере алмаймын.
Dialogue: 0,0:03:50.10,0:03:54.44,Default,,0,0,0,,Алдымен матчы жаңа ғана аяқталған В тобынан хабарландыру жасайық.
Dialogue: 0,0:03:55.15,0:03:58.86,Default,,0,0,0,,Тегін Де Ла Хойя және Кайза Кагакуенджи
Dialogue: 0,0:03:58.94,0:04:00.86,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:09.45,0:04:13.67,Default,,0,0,0,,Ширасаги Castle Rui vs Song Ruwei және соңында...
Dialogue: 0,0:04:14.08,0:04:18.00,Default,,0,0,0,,Сиско Карлайл Джошуа Бунға қарсы!
Dialogue: 0,0:04:18.50,0:04:21.26,Default,,0,0,0,,Я, мен де сол жұлдыз сияқтымын.
Dialogue: 0,0:04:21.34,0:04:24.30,Default,,0,0,0,,Бұл «еркін» емес, Джошуа - нағыз мәміле.
Dialogue: 0,0:04:24.38,0:04:25.59,Default,,0,0,0,,Джош Ван
Dialogue: 0,0:04:25.68,0:04:28.26,Default,,0,0,0,,Теме, мұны істеңіз!
Dialogue: 0,0:04:28.60,0:04:31.72,Default,,0,0,0,,Ал А тобының таныстырылымы басталады.
Dialogue: 0,0:04:32.81,0:04:36.73,Default,,0,0,0,,Біріншіден, Куза Аккерман Боа Алькасерге қарсы
Dialogue: 0,0:04:38.02,0:04:40.07,Default,,0,0,0,,Ей, сен жеңдің!
Dialogue: 0,0:04:40.15,0:04:41.40,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:04:46.24,0:04:47.87,Default,,0,0,0,,Келесі жолы...
Dialogue: 0,0:04:49.87,0:04:54.21,Default,,0,0,0,,Содан кейін Норман Тарвер Курц Баратиерге қарсы
Dialogue: 0,0:04:54.62,0:04:56.04,Default,,0,0,0,,Курц Баратье
Dialogue: 0,0:04:56.54,0:04:58.67,Default,,0,0,0,,Бұл өте ықтимал.
Dialogue: 0,0:04:58.79,0:05:00.30,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:05:00.38,0:05:03.76,Default,,0,0,0,,Егер сіз Курц болсаңыз, сіз толық таңдау болар едіңіз.
Dialogue: 0,0:05:04.05,0:05:07.22,Default,,0,0,0,,Сізге айтудың қажеті жоқ
Dialogue: 0,0:05:07.30,0:05:11.22,Default,,0,0,0,,Бір минут күте тұрыңыз, Балто, бұл комбинация...
Dialogue: 0,0:05:11.31,0:05:15.39,Default,,0,0,0,,Е... не? Кім маған қарсылас болуды шешті?
Dialogue: 0,0:05:15.69,0:05:17.69,Default,,0,0,0,,Не істеп жатырсың сонша ақымақ?
Dialogue: 0,0:05:18.10,0:05:20.36,Default,,0,0,0,,Кімнің қалғаны туралы ойланыңыз.
Dialogue: 0,0:05:20.44,0:05:25.36,Default,,0,0,0,,Міне, төртінші турдың соңғы тобының хабарландыруы.
Dialogue: 0,0:05:26.32,0:05:28.20,Default,,0,0,0,,Уу~ Иә!
Dialogue: 0,0:05:28.28,0:05:31.12,Default,,0,0,0,,Балт Аои қызыл көзге қарсы!
Dialogue: 0,0:05:31.20,0:05:33.41,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:05:36.66,0:05:38.25,Default,,0,0,0,,Жарайсың Балто
Dialogue: 0,0:05:38.33,0:05:41.54,Default,,0,0,0,,Мен Шумен шайқас күттім.
Dialogue: 0,0:05:42.09,0:05:45.84,Default,,0,0,0,,Қазір бар күшіңізбен күресіңіз.
Dialogue: 0,0:05:45.92,0:05:47.38,Default,,0,0,0,,Мен сенің жеңетініңе сенімдімін
Dialogue: 0,0:05:49.05,0:05:50.35,Default,,0,0,0,,Фуфу~
Dialogue: 0,0:05:50.43,0:05:54.93,Default,,0,0,0,,Мен төртінші раундта да қызу және салқын шайқас күтемін.
Dialogue: 0,0:05:55.18,0:05:57.27,Default,,0,0,0,,Қайта кездескенше!
Dialogue: 0,0:06:08.86,0:06:09.99,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:06:10.07,0:06:12.24,Default,,0,0,0,,(Маска сынған дыбыс)
Dialogue: 0,0:06:16.83,0:06:18.33,Default,,0,0,0,,Эй Шуу
Dialogue: 0,0:06:18.66,0:06:21.13,Default,,0,0,0,,Маған шын мәнінде не болғанын айтыңыз.
Dialogue: 0,0:06:21.96,0:06:25.34,Default,,0,0,0,,«Күреңайшуу өлді» деп айтуым керек еді.
Dialogue: 0,0:06:26.63,0:06:28.38,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:06:29.63,0:06:30.72,Default,,0,0,0,,Шу
Dialogue: 0,0:06:31.34,0:06:33.93,Default,,0,0,0,,Сіз шынымен өзгердіңіз бе?
Dialogue: 0,0:06:34.89,0:06:36.14,Default,,0,0,0,,Бұл басқаша, солай емес пе?
Dialogue: 0,0:06:37.02,0:06:38.35,Default,,0,0,0,,Бұл басқаша, солай емес пе?
Dialogue: 0,0:06:43.23,0:06:45.07,Default,,0,0,0,,А... сен...
Dialogue: 0,0:06:45.32,0:06:47.86,Default,,0,0,0,,Боа, маған бір нәрсе айтқым келеді.
Dialogue: 0,0:06:47.94,0:06:48.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:48.99,0:06:52.70,Default,,0,0,0,,Ей, сен жылан шұңқырында Шумен бірге болдың.
Dialogue: 0,0:06:54.16,0:06:56.74,Default,,0,0,0,,Мен білмейтін Шуды білесің ғой, солай ма?
Dialogue: 0,0:06:57.29,0:06:59.41,Default,,0,0,0,,Шуға нақты не болды?
Dialogue: 0,0:07:00.25,0:07:01.42,Default,,0,0,0,,Ал, мен...
Dialogue: 0,0:07:01.79,0:07:03.88,Default,,0,0,0,,Егер сіз бірдеңе білсеңіз, маған хабарлаңыз!
Dialogue: 0,0:07:04.34,0:07:06.13,Default,,0,0,0,,Неліктен көп білгің келеді?
Dialogue: 0,0:07:06.21,0:07:10.43,Default,,0,0,0,,Сен уайымдағандықтан шешілген болуы керек, Шуу сенің досың.
Dialogue: 0,0:07:11.09,0:07:12.55,Default,,0,0,0,,Маған әлі де ұнамайды
Dialogue: 0,0:07:12.64,0:07:13.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:13.89,0:07:17.52,Default,,0,0,0,,Мен сені бірінші кездескеннен бері қатты жақсы көремін.
Dialogue: 0,0:07:18.72,0:07:19.89,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:07:20.10,0:07:21.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:22.40,0:07:23.65,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:07:25.94,0:07:29.15,Default,,0,0,0,,Мен достарыма немесе бір нәрсеге ренжідім.
Dialogue: 0,0:07:29.86,0:07:32.49,Default,,0,0,0,,Қызыл көз сені ойламайды.
Dialogue: 0,0:07:32.70,0:07:34.16,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:34.24,0:07:37.12,Default,,0,0,0,,Шу... Шу менің ең жақын досым.
Dialogue: 0,0:07:37.58,0:07:39.62,Default,,0,0,0,,Осылай ойлаңыз.
Dialogue: 0,0:07:50.30,0:07:51.59,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:53.09,0:07:54.47,Default,,0,0,0,,Сәлем, Балто!
Dialogue: 0,0:07:54.55,0:07:57.47,Default,,0,0,0,,Қызыл көз енді біз білетін Шу емес.
Dialogue: 0,0:07:57.64,0:07:58.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:58.97,0:08:01.06,Default,,0,0,0,,Бұл керемет қатты қуық.
Dialogue: 0,0:08:01.39,0:08:05.44,Default,,0,0,0,,Егер біз шынымен қалағанымыздан артық күш қолданбасақ, соққыға ұшыраймыз.
Dialogue: 0,0:08:06.02,0:08:08.02,Default,,0,0,0,,Мен мұны істеуім керек екенін білемін.
Dialogue: 0,0:08:08.11,0:08:09.03,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:08:09.11,0:08:10.28,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:08:10.49,0:08:11.90,Default,,0,0,0,,Не болғанына қарамастан
Dialogue: 0,0:08:11.99,0:08:15.41,Default,,0,0,0,,Шудың Шу болудан бас тартуы мүмкін емес!
Dialogue: 0,0:08:15.49,0:08:19.12,Default,,0,0,0,,Сәлем Балто! Неліктен бос емессің?
Dialogue: 0,0:08:19.24,0:08:20.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:20.79,0:08:23.58,Default,,0,0,0,,Қолыңдағының бәрін маған лақтыр.
Dialogue: 0,0:08:25.25,0:08:26.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:27.92,0:08:29.46,Default,,0,0,0,,Ораора, не болды!
Dialogue: 0,0:08:29.67,0:08:31.71,Default,,0,0,0,,Жарайды, жүр.
Dialogue: 0,0:08:31.80,0:08:33.34,Default,,0,0,0,,God Slash
Dialogue: 0,0:08:35.89,0:08:37.09,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:08:37.55,0:08:39.10,Default,,0,0,0,,О! Күткендей -
Dialogue: 0,0:08:39.18,0:08:41.93,Default,,0,0,0,,Құдай Валькиридің шабуылы керемет!
Dialogue: 0,0:08:42.02,0:08:43.18,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:08:43.27,0:08:45.56,Default,,0,0,0,,Бір рет жеңдім деп қуанба.
Dialogue: 0,0:08:45.85,0:08:46.85,Default,,0,0,0,,О
Dialogue: 0,0:08:55.15,0:08:57.62,Default,,0,0,0,,Міне. Бұл қозғалыспен...
Dialogue: 0,0:09:01.45,0:09:03.87,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:10.59,0:09:11.96,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:09:12.05,0:09:13.34,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:09:17.51,0:09:18.89,Default,,0,0,0,,(үру)
Dialogue: 0,0:09:18.97,0:09:23.39,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:09:23.47,0:09:28.02,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:09:31.86,0:09:35.90,Default,,0,0,0,,Жарайсыңдар, В тобы, 4-тур басталады!
Dialogue: 0,0:09:36.49,0:09:39.45,Default,,0,0,0,,Бірінші, Сиско Карлайл және Джошуа Бун
Dialogue: 0,0:09:39.74,0:09:42.16,Default,,0,0,0,,Дүниежүзілік лигада чемпиондық үшін таласқа түскен екі адам...
Dialogue: 0,0:09:42.24,0:09:44.91,Default,,0,0,0,,Қайта кездескенше!
Dialogue: 0,0:09:45.37,0:09:48.71,Default,,0,0,0,,Жасырын, мен саған бұрынғыдай қараймын.
Dialogue: 0,0:09:49.04,0:09:52.25,Default,,0,0,0,,Иә! Оны жасыратын да сол.
Dialogue: 0,0:09:52.34,0:09:56.17,Default,,0,0,0,,Енді фантастикалық жұмыс жасау кезегі Джошуаға келді
Dialogue: 0,0:09:56.59,0:09:58.84,Default,,0,0,0,,Бұл тағдырдың айтысы.
Dialogue: 0,0:09:59.22,0:10:01.72,Default,,0,0,0,,Cisco-ның рухы күшті емес еді.
Dialogue: 0,0:10:02.01,0:10:03.93,Default,,0,0,0,,Cisco Win!
Dialogue: 0,0:10:04.72,0:10:06.02,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:10:07.52,0:10:12.65,Default,,0,0,0,,Хмф, сен менің өмірімдегі қосымша адамсың.
Dialogue: 0,0:10:13.07,0:10:15.94,Default,,0,0,0,,Бұл Джошуа қосымша ма?
Dialogue: 0,0:10:16.28,0:10:17.95,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:10:19.74,0:10:22.74,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:23.37,0:10:25.45,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:25.83,0:10:26.95,Default,,0,0,0,,Керемет!
Dialogue: 0,0:10:32.54,0:10:34.21,Default,,0,0,0,,Циклон қабырғасы!
Dialogue: 0,0:10:37.17,0:10:38.67,Default,,0,0,0,,Роликтердің дрейфі
Dialogue: 0,0:10:41.59,0:10:42.93,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:10:43.55,0:10:46.72,Default,,0,0,0,,Джошуа жеңістің назарында болады.
Dialogue: 0,0:10:50.31,0:10:52.36,Default,,0,0,0,,Көтеруге әлі ерте
Dialogue: 0,0:10:52.44,0:10:54.32,Default,,0,0,0,,Циклондық есептегіш!
Dialogue: 0,0:10:54.40,0:10:55.23,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:11:00.61,0:11:04.83,Default,,0,0,0,,Жылау Шайтан бұл деңгейде жарылып кету үшін қауіпті емес.
Dialogue: 0,0:11:09.58,0:11:11.08,Default,,0,0,0,,Циклондық цикл!
Dialogue: 0,0:11:16.09,0:11:18.96,Default,,0,0,0,,О, бітті, Шайтан!
Dialogue: 0,0:11:32.10,0:11:33.27,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:11:33.35,0:11:34.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:35.31,0:11:37.36,Default,,0,0,0,,Crys Satan Burst Finish
Dialogue: 0,0:11:37.86,0:11:39.90,Default,,0,0,0,,Жеңімпаз Cisco Carlyle
Dialogue: 0,0:11:39.99,0:11:41.78,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:41.86,0:11:44.41,Default,,0,0,0,,Бірінші шайқаста мен мұны істедім!
Dialogue: 0,0:11:44.74,0:11:46.41,Default,,0,0,0,,Жарайсың Cisco
Dialogue: 0,0:11:46.99,0:11:48.37,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:11:48.74,0:11:51.96,Default,,0,0,0,,Басты кейіпкер Джошуа қайтадан жарылып кетеді...
Dialogue: 0,0:11:52.04,0:11:53.37,Default,,0,0,0,,NG алыңыз!
Dialogue: 0,0:11:53.58,0:11:54.54,Default,,0,0,0,,Иә
Dialogue: 0,0:11:55.13,0:11:57.09,Default,,0,0,0,,Бұл шайқаста басты кейіпкер – мен.
Dialogue: 0,0:11:58.25,0:12:03.26,Default,,0,0,0,,Иә? Әзірге Фри мен Луи үш жарыста да жеңіске жетті.
Dialogue: 0,0:12:03.72,0:12:07.10,Default,,0,0,0,,Cisco-да екі жеңіс және екі жеңіліс бар...
Dialogue: 0,0:12:07.56,0:12:10.22,Default,,0,0,0,,Келесі шайқаста Фри немесе Луи жеңілсе...
Dialogue: 0,0:12:10.31,0:12:13.39,Default,,0,0,0,,Cisco-ның да финалға өту мүмкіндігі бар.
Dialogue: 0,0:12:13.73,0:12:14.77,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:12:14.85,0:12:16.81,Default,,0,0,0,,Сіздің еркін қарсыласыңыз Шака ма?
Dialogue: 0,0:12:16.90,0:12:19.36,Default,,0,0,0,,Мүмкін ол мұны істей алады.
Dialogue: 0,0:12:19.44,0:12:21.19,Default,,0,0,0,,Бұл басқалардың өтініші.
Dialogue: 0,0:12:21.28,0:12:22.57,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:12:22.65,0:12:23.78,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:12:24.28,0:12:27.95,Default,,0,0,0,,Зиг Экскалибур жарылды!
Dialogue: 0,0:12:28.03,0:12:31.08,Default,,0,0,0,,Уау, Фри Де Ла Хойя тым күшті
Dialogue: 0,0:12:31.16,0:12:32.79,Default,,0,0,0,,Енді сіз төрт жарыста да жеңіске жеттіңіз.
Dialogue: 0,0:12:32.87,0:12:37.13,Default,,0,0,0,,Біз бесінші ойынды күтпей-ақ финалдық турнирге өтуді шештік!
Dialogue: 0,0:12:37.63,0:12:39.75,Default,,0,0,0,,Тегін - бұл таңқаларлық
Dialogue: 0,0:12:40.09,0:12:43.01,Default,,0,0,0,,А, Шака да жабысқақ еді.
Dialogue: 0,0:12:43.34,0:12:46.39,Default,,0,0,0,,Cisco Келесі матчты асыға күтейік.
Dialogue: 0,0:12:46.68,0:12:49.60,Default,,0,0,0,,Цк, мен өзімді аяймын.
Dialogue: 0,0:12:49.97,0:12:52.35,Default,,0,0,0,,Неліктен Ширасаги қамалының жеңілуін күту керек?
Dialogue: 0,0:12:53.10,0:12:55.85,Default,,0,0,0,,Иә! Лонгинус түні
Dialogue: 0,0:12:55.94,0:12:57.90,Default,,0,0,0,,Мен бәрін толтырамын!
Dialogue: 0,0:12:58.65,0:13:00.11,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:13:00.61,0:13:03.57,Default,,0,0,0,,Регулус баспанасы қорқынышты түсте тұтқынға алынды!
Dialogue: 0,0:13:04.24,0:13:06.03,Default,,0,0,0,,Ширасаги сарайы Луис күткендей
Dialogue: 0,0:13:06.11,0:13:10.08,Default,,0,0,0,,Еркін сырғанаудан кейін біз финалдық турнирге өтеміз!
Dialogue: 0,0:13:11.41,0:13:12.54,Default,,0,0,0,,Cisco
Dialogue: 0,0:13:13.29,0:13:15.75,Default,,0,0,0,,Ха, бәрібір жұмыс істемеді.
Dialogue: 0,0:13:16.33,0:13:18.58,Default,,0,0,0,,Келесі жолы жаттығу оңай.
Dialogue: 0,0:13:18.67,0:13:20.21,Default,,0,0,0,,Мен сенімен бірге барамын.
Dialogue: 0,0:13:20.71,0:13:22.55,Default,,0,0,0,,Сіз маған тең келерсіз.
Dialogue: 0,0:13:22.63,0:13:24.76,Default,,0,0,0,,Әй, кейде осындай...
Dialogue: 0,0:13:24.84,0:13:25.88,Default,,0,0,0,,Хуаншан
Dialogue: 0,0:13:26.84,0:13:28.76,Default,,0,0,0,,Сіз Балтоның қасында болуыңыз керек.
Dialogue: 0,0:13:29.72,0:13:31.01,Default,,0,0,0,,Cisco…
Dialogue: 0,0:13:41.27,0:13:42.40,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:13:42.48,0:13:43.86,Default,,0,0,0,,О, ау!
Dialogue: 0,0:13:44.44,0:13:47.11,Default,,0,0,0,,Боқ, боқ, боқ!
Dialogue: 0,0:13:47.20,0:13:48.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:50.91,0:13:51.95,Default,,0,0,0,,...Жо
Dialogue: 0,0:13:52.45,0:13:53.79,Default,,0,0,0,,Бұл жақсы сәйкестік болды.
Dialogue: 0,0:13:54.41,0:13:56.08,Default,,0,0,0,,Иә? Бұл қайда?
Dialogue: 0,0:13:56.54,0:13:58.17,Default,,0,0,0,,Мен жеңе алмадым.
Dialogue: 0,0:13:58.25,0:14:01.17,Default,,0,0,0,,Бұл өте жақсы сәйкестік болды.
Dialogue: 0,0:14:01.25,0:14:02.42,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:14:03.34,0:14:04.30,Default,,0,0,0,,Хун
Dialogue: 0,0:14:05.26,0:14:07.42,Default,,0,0,0,,Бұдан былай көбірек
Dialogue: 0,0:14:07.51,0:14:10.22,Default,,0,0,0,,Б.С.Сол есімін жаңғыртам.
Dialogue: 0,0:14:10.55,0:14:12.89,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:14:20.44,0:14:22.94,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:23.02,0:14:23.90,Default,,0,0,0,,Ах
Dialogue: 0,0:14:27.24,0:14:29.20,Default,,0,0,0,,А... Мен сәтсіздікке ұшырадым.
Dialogue: 0,0:14:29.57,0:14:31.66,Default,,0,0,0,,Шиппайка Шиппайка
Dialogue: 0,0:14:32.03,0:14:32.99,Default,,0,0,0,,Шулы!
Dialogue: 0,0:14:33.08,0:14:34.99,Default,,0,0,0,,Ммм... Ннн...
Dialogue: 0,0:14:35.08,0:14:37.50,Default,,0,0,0,,Ах... Кешіріңіз, Карл.
Dialogue: 0,0:14:41.79,0:14:46.96,Default,,0,0,0,,Мен Қызыл көзді басып озып қана қойған жоқпын, бірақ мен әлі жеңе алмаймын...
Dialogue: 0,0:14:50.55,0:14:53.01,Default,,0,0,0,,Менің қабілетім ондай емес.
Dialogue: 0,0:14:53.97,0:14:58.85,Default,,0,0,0,,Жарайды, осы жерден А тобының төртінші туры, бірінші матч.
Dialogue: 0,0:14:59.23,0:15:02.73,Default,,0,0,0,,Куза Аккерман Боа Алькасерге қарсы
Dialogue: 0,0:15:03.11,0:15:07.90,Default,,0,0,0,,Екі команданың да жеңіске жету мүмкіндігі жоқ, сондықтан олар қаласа да ұтыла алмайды.
Dialogue: 0,0:15:08.61,0:15:09.99,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:15:13.70,0:15:15.37,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:22.29,0:15:23.92,Default,,0,0,0,,Куза шайқасы аяқталды.
Dialogue: 0,0:15:24.29,0:15:25.25,Default,,0,0,0,,Нәтижелері қандай?
Dialogue: 0,0:15:25.34,0:15:27.30,Default,,0,0,0,,Әрине Куза жеңді, солай ма?
Dialogue: 0,0:15:27.67,0:15:28.88,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:15:29.47,0:15:30.93,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:15:31.59,0:15:32.55,Default,,0,0,0,,Міне!
Dialogue: 0,0:15:32.80,0:15:33.80,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:33.89,0:15:36.89,Default,,0,0,0,,Уф... Мен жеңіліп қалдым деп ойлаймын.
Dialogue: 0,0:15:36.97,0:15:38.10,Default,,0,0,0,,Куза
Dialogue: 0,0:15:39.31,0:15:41.14,Default,,0,0,0,,Енді екінші матч
Dialogue: 0,0:15:41.23,0:15:43.60,Default,,0,0,0,,Курц Баратиер Норман Тарверге қарсы
Dialogue: 0,0:15:44.02,0:15:47.57,Default,,0,0,0,,Шабуыл түрлері арасындағы кескілескен шайқас
Dialogue: 0,0:15:50.15,0:15:51.28,Default,,0,0,0,,Уау
Dialogue: 0,0:15:51.36,0:15:54.32,Default,,0,0,0,,Қызылша кукулканының қабаты өзгерді!
Dialogue: 0,0:15:54.41,0:15:57.41,Default,,0,0,0,,Сосын мен Кимеге бардым!
Dialogue: 0,0:15:57.79,0:16:01.00,Default,,0,0,0,,Жоғарғы апат
Dialogue: 0,0:16:05.83,0:16:07.00,Default,,0,0,0,,Бітті!
Dialogue: 0,0:16:07.46,0:16:09.63,Default,,0,0,0,,Соңы - Кисама!
Dialogue: 0,0:16:09.71,0:16:12.34,Default,,0,0,0,,Шабуыл жасау!
Dialogue: 0,0:16:12.42,0:16:13.47,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:16:13.55,0:16:14.68,Default,,0,0,0,,Ах
Dialogue: 0,0:16:15.14,0:16:18.01,Default,,0,0,0,,Курц Баратье өзінің үшінші жеңісіне қол жеткізді!
Dialogue: 0,0:16:18.26,0:16:21.18,Default,,0,0,0,,Біз финалдық турнирге бір қадам жақындадық!
Dialogue: 0,0:16:21.27,0:16:23.10,Default,,0,0,0,,Ендігі кезек Аникиге келді.
Dialogue: 0,0:16:23.19,0:16:25.69,Default,,0,0,0,,Кел, бар күшіңмен мені ұр
Dialogue: 0,0:16:26.27,0:16:28.36,Default,,0,0,0,,О
Dialogue: 0,0:16:28.98,0:16:29.94,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:32.32,0:16:35.11,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:16:35.20,0:16:40.62,Default,,0,0,0,,Күткеніңізге рахмет. Бүгінгі күннің соңғы ойыны басталады.
Dialogue: 0,0:16:41.50,0:16:45.25,Default,,0,0,0,,Көк бұрыш Жалынға оранған қызыл жын
Dialogue: 0,0:16:45.33,0:16:47.25,Default,,0,0,0,,Қызыл көз!
Dialogue: 0,0:16:47.71,0:16:50.55,Default,,0,0,0,,Қызыл бұрыш Көңілді Ғажайып бала
Dialogue: 0,0:16:50.63,0:16:52.17,Default,,0,0,0,,Барто Аои!
Dialogue: 0,0:16:55.26,0:17:00.60,Default,,0,0,0,,Екі бала кездегі дос осы жерде және қазір соқтығысады!
Dialogue: 0,0:17:01.02,0:17:05.14,Default,,0,0,0,,Ендеше араларыңыздағы нағыз шайқасты тамашалайық!
Dialogue: 0,0:17:07.52,0:17:10.02,Default,,0,0,0,,Шу Біз шайқаса аламыз.
Dialogue: 0,0:17:12.28,0:17:14.36,Default,,0,0,0,,Мен осы сәтті күттім
Dialogue: 0,0:17:16.82,0:17:18.62,Default,,0,0,0,,Көңілді жекпе-жек өткізейік
Dialogue: 0,0:17:20.03,0:17:21.91,Default,,0,0,0,,Көңілді шайқастар жоқ
Dialogue: 0,0:17:21.99,0:17:23.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:28.00,0:17:29.84,Default,,0,0,0,,Жеңіс - бәрі
Dialogue: 0,0:17:30.54,0:17:31.92,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:32.25,0:17:34.26,Default,,0,0,0,,Өзіңіз туралы бәрін жойыңыз
Dialogue: 0,0:17:34.63,0:17:36.80,Default,,0,0,0,,Мен де, серігім де сынбаймыз!
Dialogue: 0,0:17:37.05,0:17:38.76,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:39.09,0:17:42.10,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:42.72,0:17:44.93,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:52.19,0:17:53.65,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:17:54.28,0:17:57.03,Default,,0,0,0,,Валькири асығыс шабуыл жасайды!
Dialogue: 0,0:17:57.32,0:17:58.91,Default,,0,0,0,,Валькирияға барыңыз
Dialogue: 0,0:17:59.24,0:18:01.49,Default,,0,0,0,,Құдай жарсын!
Dialogue: 0,0:18:05.12,0:18:07.83,Default,,0,0,0,,Аяқтаған кезде Құдай Валькириге шабуыл жасаңыз
Dialogue: 0,0:18:07.92,0:18:09.08,Default,,0,0,0,,1 ұпай
Dialogue: 0,0:18:09.63,0:18:10.79,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:13.21,0:18:14.88,Default,,0,0,0,,Жарайсың Аники!
Dialogue: 0,0:18:14.96,0:18:17.55,Default,,0,0,0,,Екінші шайқасқа да алаңдамаңыз!
Dialogue: 0,0:18:17.97,0:18:22.55,Default,,0,0,0,,Аои Барто балалық шақтағы достық кездесуде жетекші орынға шықты!
Dialogue: 0,0:18:22.64,0:18:25.56,Default,,0,0,0,,Қызыл көз Қарсы шабуылға қалай шығасыз?
Dialogue: 0,0:18:26.27,0:18:27.60,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:18:29.48,0:18:31.61,Default,,0,0,0,,Өйткені, шайқастар қызық.
Dialogue: 0,0:18:33.77,0:18:35.57,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:35.65,0:18:38.99,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:39.28,0:18:40.86,Default,,0,0,0,,Бару…
Dialogue: 0,0:18:42.16,0:18:43.28,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:18:44.79,0:18:46.50,Default,,0,0,0,,Спригган реквиемі
Dialogue: 0,0:18:46.58,0:18:49.62,Default,,0,0,0,,Сағат тіліне қарсы шабуыл режиміне ауыстырылды!
Dialogue: 0,0:18:49.71,0:18:51.63,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:18:51.71,0:18:53.25,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:53.34,0:18:56.13,Default,,0,0,0,,Құдай Валькири және Спригган реквиемі
Dialogue: 0,0:18:56.21,0:18:59.34,Default,,0,0,0,,Бұл бір-біріне үлкен шабуыл.
Dialogue: 0,0:19:03.60,0:19:04.51,Default,,0,0,0,,Құт
Dialogue: 0,0:19:07.56,0:19:11.77,Default,,0,0,0,,Ой... уау! Валькиридің жылдамдығы артты
Dialogue: 0,0:19:11.98,0:19:12.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:13.44,0:19:14.57,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:14.65,0:19:16.40,Default,,0,0,0,,Бұл сол кездегі оқиға!
Dialogue: 0,0:19:20.65,0:19:21.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:23.37,0:19:26.45,Default,,0,0,0,,Цк, сен Валькириді жабайы қылғың келе ме?
Dialogue: 0,0:19:28.83,0:19:30.50,Default,,0,0,0,,(Қабырғаға соғылған дыбыс)
Dialogue: 0,0:19:31.87,0:19:35.00,Default,,0,0,0,,Сен шынымен менімен ойнап жүрсің бе?
Dialogue: 0,0:19:39.46,0:19:40.97,Default,,0,0,0,,Жоғал!
Dialogue: 0,0:19:41.05,0:19:42.76,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:19:47.18,0:19:49.73,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:19:50.10,0:19:53.52,Default,,0,0,0,,Жоғалтпа, Валькири!
Dialogue: 0,0:19:55.94,0:19:57.86,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:20:02.24,0:20:04.36,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:04.49,0:20:05.74,Default,,0,0,0,,Уууу!
Dialogue: 0,0:20:07.20,0:20:09.45,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:20:12.29,0:20:13.71,Default,,0,0,0,,Слеш реквиемі
Dialogue: 0,0:20:14.88,0:20:16.96,Default,,0,0,0,,(Жарық дыбысы)
Dialogue: 0,0:20:17.09,0:20:18.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:19.30,0:20:21.47,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:20:21.84,0:20:24.09,Default,,0,0,0,,Қый!
Dialogue: 0,0:20:25.01,0:20:27.30,Default,,0,0,0,,Спригган реквиемінің жарқырауы
Dialogue: 0,0:20:27.85,0:20:29.26,Default,,0,0,0,,Жеңімпаз қызыл көз!
Dialogue: 0,0:20:29.81,0:20:31.77,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:32.18,0:20:35.77,Default,,0,0,0,,Құдай Валькиридің жүргізушісі жойылды.
Dialogue: 0,0:20:36.06,0:20:37.94,Default,,0,0,0,,Қорқынышты қызыл көз
Dialogue: 0,0:20:38.02,0:20:41.65,Default,,0,0,0,,Қорқынышты Спригган реквиемі
Dialogue: 0,0:20:42.78,0:20:43.99,Default,,0,0,0,,Валькирия…
Dialogue: 0,0:20:45.32,0:20:48.58,Default,,0,0,0,,Ең жақсы достар арасындағы текетірес қатыгездікпен аяқталды.
Dialogue: 0,0:20:49.03,0:20:54.04,Default,,0,0,0,,Қызыл көз енді финалдық турнирге шығады!
Dialogue: 0,0:20:57.63,0:20:59.42,Default,,0,0,0,,Бұл сіз үшін аяқталды.
Dialogue: 0,0:21:04.59,0:21:07.01,Default,,0,0,0,,Мен оны қатты қиратамын деп ешқашан ойламадым...
Dialogue: 0,0:21:07.09,0:21:09.10,Default,,0,0,0,,Бұл Шу емес қой.
Dialogue: 0,0:21:09.39,0:21:11.60,Default,,0,0,0,,Барто Аоидың бұрағышы сынған
Dialogue: 0,0:21:11.85,0:21:14.35,Default,,0,0,0,,Менің бесінші раундтық шайқаста қалыс қалудан басқа амалым жоқ па?
Dialogue: 0,0:21:14.89,0:21:18.15,Default,,0,0,0,,Финалға А тобынан тағы бір адам ғана өте алады!
Dialogue: 0,0:21:18.56,0:21:24.11,Default,,0,0,0,,Финалдық билетті кім алады? ?
Dialogue: 0,0:21:26.20,0:21:27.36,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:27.45,0:21:28.99,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:29.12,0:21:30.41,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:21:43.42,0:21:44.55,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:21:45.84,0:21:46.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:49.68,0:21:50.76,Default,,0,0,0,,Тегін
Dialogue: 0,0:21:55.43,0:21:56.35,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.35,0:21:59.94,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.35,0:21:59.94,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, бұлшық еттеріңді жаттығып жатырсыңдар ма?
Dialogue: 0,0:22:00.02,0:22:02.98,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.07,0:22:06.95,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:07.03,0:22:10.53,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.62,0:22:14.33,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдату!
Dialogue: 0,0:22:14.41,0:22:17.96,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.04,0:22:21.38,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.46,0:22:24.80,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.88,0:22:28.76,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді күшейтемін.
Dialogue: 0,0:22:28.97,0:22:32.68,Default,,0,0,0,,GO ату GO ату Бей бұлшық еттерінің жаттықтырушысы Моримори
Dialogue: 0,0:22:32.76,0:22:36.39,Default,,0,0,0,,АЛДЫМ АТТЫ БАР АТТЫ Менің атысым – құдайдың атысы
Dialogue: 0,0:22:36.48,0:22:40.06,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.15,0:22:43.73,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:43.82,0:22:47.44,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.53,0:22:51.41,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.49,0:22:54.91,Default,,0,0,0,,Күнделікті барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:54.99,0:22:58.41,Default,,0,0,0,,Көктем/жаз/күз/қыс GO түсіру жыл бойы
Dialogue: 0,0:22:58.50,0:22:59.96,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.04,0:23:02.63,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.71,0:23:05.84,Default,,0,0,0,,Сол шиеленіспен шарықтау шегіне жетейік!
Dialogue: 0,0:23:05.92,0:23:09.63,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіріліміне кірісіңіз!
Dialogue: 0,0:23:09.72,0:23:13.14,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.22,0:23:17.10,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.18,0:23:19.89,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.89,0:23:21.94,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.89,0:23:21.94,Default,,0,0,0,,~♪
Dialogue: 0,0:23:21.94,0:23:22.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:24.90,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:24.90,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:24.90,0:23:25.44,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.44,0:23:28.15,Default,,0,0,0,,Бұл жиіркенішті!
Dialogue: 0,0:23:28.32,0:23:31.15,Default,,0,0,0,,«Жеңіске жету міндетті»? «Менің жолым»?
Dialogue: 0,0:23:31.53,0:23:34.49,Default,,0,0,0,,Бұл не? Мен түсінбедім!
Dialogue: 0,0:23:35.33,0:23:39.79,Default,,0,0,0,,Эй, эй, Еркін, сен не істеп жатырсың? Бұлай істеу дұрыс па?
Dialogue: 0,0:23:40.71,0:23:42.92,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.00,0:23:45.54,Default,,0,0,0,,Супер шектеу! тегін және Луис
Dialogue: 0,0:23:46.29,0:23:49.59,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.09,0:23:57.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory