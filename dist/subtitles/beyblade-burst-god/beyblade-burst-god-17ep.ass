Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.25,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.43,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.56,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.02,0:00:29.90,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:33.40,0:00:37.41,Default,,0,0,0,,Жарық мәре Күткендей, Куришуу мықты!
Dialogue: 0,0:00:39.45,0:00:42.75,Default,,0,0,0,,Бұл Шудың жоғалар алдындағы соңғы шайқасы.
Dialogue: 0,0:00:44.33,0:00:46.12,Default,,0,0,0,,Шу кетті
Dialogue: 0,0:00:46.42,0:00:49.25,Default,,0,0,0,,Шуды іздеп Мексикаға бардық.
Dialogue: 0,0:00:49.50,0:00:50.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:53.17,0:00:55.84,Default,,0,0,0,,Неге екені белгісіз, Кузамен қайта қауыштық...
Dialogue: 0,0:00:55.93,0:00:57.43,Default,,0,0,0,,Джунглидің тереңдігінде
Dialogue: 0,0:00:57.51,0:01:00.22,Default,,0,0,0,,Жылан шұңқыры деген жұмбақ жерге келдік.
Dialogue: 0,0:01:00.85,0:01:04.39,Default,,0,0,0,,Сол жерде мен жұмбақ Қызыл көзді кездестірдім.
Dialogue: 0,0:01:04.48,0:01:06.44,Default,,0,0,0,,Бенишу қайтыс болды
Dialogue: 0,0:01:08.31,0:01:10.52,Default,,0,0,0,,Қызыл көз адам сенбейтін нәрсе айтады.
Dialogue: 0,0:01:11.11,0:01:13.90,Default,,0,0,0,,Неге екені белгісіз, менде Шудың аңызға айналған Спригганы болды.
Dialogue: 0,0:01:14.40,0:01:19.74,Default,,0,0,0,,Сонымен қатар, бұрын оңға айналатын сприган енді солға да айнала алады.
Dialogue: 0,0:01:19.95,0:01:21.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:22.79,0:01:23.66,Default,,0,0,0,,Мүмкін ірімшік жетпеді ме?
Dialogue: 0,0:01:26.87,0:01:29.38,Default,,0,0,0,,Спригганды Шуға қайтарыңыз!
Dialogue: 0,0:01:30.67,0:01:33.71,Default,,0,0,0,,(дыбыс дыбысы)
Dialogue: 0,0:01:38.43,0:01:41.14,Default,,0,0,0,,♪~
Dialogue: 0,0:01:41.22,0:01:43.64,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:43.72,0:01:46.14,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:46.23,0:01:48.65,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:48.73,0:01:51.19,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:51.27,0:01:52.82,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:52.90,0:01:57.15,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:58.07,0:02:02.83,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:02.91,0:02:07.41,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:07.91,0:02:12.67,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:12.75,0:02:17.67,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:17.76,0:02:22.64,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:22.72,0:02:27.56,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:27.64,0:02:31.10,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:31.19,0:02:32.65,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:32.73,0:02:35.07,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:35.15,0:02:37.57,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:37.65,0:02:39.74,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:39.82,0:02:41.11,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:41.20,0:02:42.70,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:42.78,0:02:45.24,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:45.33,0:02:51.42,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:51.50,0:02:55.84,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:55.92,0:02:58.76,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:58.84,0:03:01.01,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:01.09,0:03:03.64,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:03.72,0:03:07.02,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:03.72,0:03:07.02,Default,,0,0,0,,~♪
Dialogue: 0,0:03:07.02,0:03:07.89,Default,,0,0,0,,~♪
Dialogue: 0,0:03:09.27,0:03:11.90,Default,,0,0,0,,Тозақ! Жылан шұңқыры!
Dialogue: 0,0:03:17.57,0:03:19.65,Default,,0,0,0,,Мынаны сал деп жатырсыз ба?
Dialogue: 0,0:03:23.82,0:03:27.54,Default,,0,0,0,,Керемет! Сізден сұрадым, маған жауап беріңізші.
Dialogue: 0,0:03:27.62,0:03:28.62,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:03:28.87,0:03:30.29,Default,,0,0,0,,Мен барамын!
Dialogue: 0,0:03:30.96,0:03:34.54,Default,,0,0,0,,Барамын дедің... Балто О, жоқ!
Dialogue: 0,0:03:35.13,0:03:36.88,Default,,0,0,0,,Мұнда Шу келді.
Dialogue: 0,0:03:36.96,0:03:40.22,Default,,0,0,0,,Әйтпесе, Қызыл көздің спригган болуы мүмкін емес.
Dialogue: 0,0:03:40.72,0:03:43.55,Default,,0,0,0,,Мүмкін Шу әлі осында шығар.
Dialogue: 0,0:03:43.93,0:03:47.43,Default,,0,0,0,,Мен Қызыл Көзді жеңіп, Спригганды қайтарамын.
Dialogue: 0,0:03:47.51,0:03:49.02,Default,,0,0,0,,Мен оны Шуға қайтаруым керек.
Dialogue: 0,0:03:49.35,0:03:51.56,Default,,0,0,0,,«Шу өлді» деді.
Dialogue: 0,0:03:52.02,0:03:53.85,Default,,0,0,0,,Мен бұған сенбеймін!
Dialogue: 0,0:03:54.73,0:03:57.73,Default,,0,0,0,,Жарайсыңдар балалар, келдіңдер.
Dialogue: 0,0:03:58.15,0:04:00.15,Default,,0,0,0,,Мен оны сол жақтан естідім.
Dialogue: 0,0:04:01.15,0:04:01.99,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:04:02.07,0:04:03.91,Default,,0,0,0,,Қайдасың? Шығу!
Dialogue: 0,0:04:04.28,0:04:08.08,Default,,0,0,0,,Мен Ашрам жылан шұңқырына жауапты адаммын.
Dialogue: 0,0:04:08.53,0:04:11.75,Default,,0,0,0,,Бұл тамаша болжам, дұрыс жауап
Dialogue: 0,0:04:12.29,0:04:16.13,Default,,0,0,0,,Сіз ашрам дедіңіз. Шу келді, солай ма?
Dialogue: 0,0:04:16.21,0:04:18.84,Default,,0,0,0,,Не болды? Маған Шумен танысуға рұқсат етіңіз!
Dialogue: 0,0:04:19.55,0:04:21.17,Default,,0,0,0,,О, әлсіз
Dialogue: 0,0:04:21.26,0:04:25.80,Default,,0,0,0,,Жылан шұңқырында қалағаныңды алғың келсе, мықты бол!
Dialogue: 0,0:04:26.30,0:04:27.47,Default,,0,0,0,,Не?
Dialogue: 0,0:04:27.97,0:04:30.89,Default,,0,0,0,,Бұл ойында жеңгенімше сабақ бермеймін деген сөз емес пе?
Dialogue: 0,0:04:30.97,0:04:35.19,Default,,0,0,0,,Жарайды, ұрыста жеңсең, Шу туралы айтасың.
Dialogue: 0,0:04:35.73,0:04:39.11,Default,,0,0,0,,Біз сенімен төбелескіміз келеді.
Dialogue: 0,0:04:39.57,0:04:43.19,Default,,0,0,0,,Жүр, жылан шұңқырына барайық!
Dialogue: 0,0:04:44.57,0:04:45.74,Default,,0,0,0,,Жарысайық!
Dialogue: 0,0:04:46.16,0:04:47.53,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:04:47.62,0:04:49.53,Default,,0,0,0,,Қазір қызық болып барады.
Dialogue: 0,0:04:49.62,0:04:50.58,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:04:50.70,0:04:53.04,Default,,0,0,0,,Жекпе-жек деген – бей, солай ма?
Dialogue: 0,0:04:53.41,0:04:55.08,Default,,0,0,0,,Сіз тағы не істеп жатырсыз?
Dialogue: 0,0:04:55.16,0:04:56.37,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:05:08.09,0:05:09.68,Default,,0,0,0,,Мені неге шақырдың?
Dialogue: 0,0:05:10.18,0:05:11.43,Default,,0,0,0,,Қанағаттанбады ма?
Dialogue: 0,0:05:11.51,0:05:14.56,Default,,0,0,0,,Бұл адамдар бұл жерге керек емес.
Dialogue: 0,0:05:15.23,0:05:16.19,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:18.10,0:05:19.94,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:05:20.61,0:05:21.77,Default,,0,0,0,,Тұтқынға түсті!
Dialogue: 0,0:05:21.86,0:05:23.90,Default,,0,0,0,,Не, қорқып тұрсың ба?
Dialogue: 0,0:05:23.99,0:05:26.57,Default,,0,0,0,,Дәл қазір кім қорықты?
Dialogue: 0,0:05:26.65,0:05:28.91,Default,,0,0,0,,Өткенді ұмыту қағидасы!
Dialogue: 0,0:05:28.99,0:05:31.37,Default,,0,0,0,,Мен мұны бірінші рет естіп тұрмын.
Dialogue: 0,0:05:31.45,0:05:32.87,Default,,0,0,0,,Бұл жай ғана болды.
Dialogue: 0,0:05:32.95,0:05:34.33,Default,,0,0,0,,Ngh!
Dialogue: 0,0:05:34.41,0:05:36.08,Default,,0,0,0,,Екеуің де тоқтаңдар.
Dialogue: 0,0:05:36.16,0:05:38.62,Default,,0,0,0,,Егер сіз осы уақытқа дейін келген болсаңыз, сізде алға жылжудан басқа амал жоқ.
Dialogue: 0,0:05:44.30,0:05:46.30,Default,,0,0,0,,Бұл өте төмен.
Dialogue: 0,0:05:46.59,0:05:47.76,Default,,0,0,0,,О
Dialogue: 0,0:05:48.89,0:05:50.64,Default,,0,0,0,,(лифт тоқтаған дыбыс)
Dialogue: 0,0:05:51.47,0:05:53.31,Default,,0,0,0,,(металлдың соғылған дыбысы)
Dialogue: 0,0:05:53.81,0:05:55.48,Default,,0,0,0,,Мен бірдеңе естимін
Dialogue: 0,0:05:55.77,0:05:57.02,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:57.27,0:05:58.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:07.03,0:06:08.40,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:06:09.86,0:06:11.87,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:06:15.62,0:06:19.04,Default,,0,0,0,,…
Dialogue: 0,0:06:28.17,0:06:30.64,Default,,0,0,0,,Бұл не... ғажап
Dialogue: 0,0:06:30.72,0:06:32.85,Default,,0,0,0,,Бұл құпия база...
Dialogue: 0,0:06:34.10,0:06:35.93,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:06:36.81,0:06:37.98,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:39.48,0:06:40.48,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:40.90,0:06:42.69,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:06:42.77,0:06:43.94,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:44.02,0:06:46.07,Default,,0,0,0,,Қызыл көзден жеңілсем де
Dialogue: 0,0:06:50.66,0:06:51.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:51.78,0:06:55.54,Default,,0,0,0,,А...осылай бейқам болма, шегіне жеттің.
Dialogue: 0,0:06:55.79,0:06:56.95,Default,,0,0,0,,Біреу...
Dialogue: 0,0:06:57.04,0:06:58.54,Default,,0,0,0,,Ұстамаңыз
Dialogue: 0,0:06:59.04,0:06:59.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:03.75,0:07:06.46,Default,,0,0,0,,Тұра алмасаң, кет!
Dialogue: 0,0:07:14.30,0:07:15.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:16.26,0:07:17.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:18.22,0:07:19.56,Default,,0,0,0,,Маған тиіспе!
Dialogue: 0,0:07:19.64,0:07:20.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:20.98,0:07:22.44,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:07:27.36,0:07:29.15,Default,,0,0,0,,Балалар, менің артымнан келіңдер
Dialogue: 0,0:07:29.49,0:07:31.82,Default,,0,0,0,,Жарайды, мына жігіт шаршады.
Dialogue: 0,0:07:31.90,0:07:34.16,Default,,0,0,0,,Ах, шектен асып кетті.
Dialogue: 0,0:07:34.74,0:07:36.12,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:07:37.91,0:07:40.62,Default,,0,0,0,,Жылан шұңқыры индульгенцияны күнә деп санайды.
Dialogue: 0,0:07:40.71,0:07:43.08,Default,,0,0,0,,Өлген соң не істейсің?
Dialogue: 0,0:07:43.75,0:07:46.38,Default,,0,0,0,,Әй... Өлсең ұтыласың.
Dialogue: 0,0:07:46.59,0:07:48.42,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,0:07:49.42,0:07:51.13,Default,,0,0,0,,Сабыр ет, Балто.
Dialogue: 0,0:07:51.59,0:07:53.89,Default,,0,0,0,,Жылан шұңқыры дегеніміз не?
Dialogue: 0,0:07:54.72,0:07:55.64,Default,,0,0,0,,Е!
Dialogue: 0,0:07:55.72,0:07:57.43,Default,,0,0,0,,…
Dialogue: 0,0:07:57.93,0:08:00.18,Default,,0,0,0,,Осы жерде де Шу жұмыс істеп жүр ме екен...
Dialogue: 0,0:08:00.73,0:08:04.48,Default,,0,0,0,,Бұл жаттығудың арқасында, солай ма?
Dialogue: 0,0:08:04.56,0:08:05.40,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:08:06.11,0:08:09.73,Default,,0,0,0,,Ашрам сізді күтуде. Жүгіңді тастап, тез кел!
Dialogue: 0,0:08:16.20,0:08:18.70,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:21.37,0:08:24.25,Default,,0,0,0,,Сіз қалай ойлайсыз? менің жылан шұңқырым
Dialogue: 0,0:08:25.37,0:08:26.96,Default,,0,0,0,,Сіз ашрамсыз ба?
Dialogue: 0,0:08:29.13,0:08:31.84,Default,,0,0,0,,After all, I am the ashram.
Dialogue: 0,0:08:32.26,0:08:33.80,Default,,0,0,0,,Тағы бір маска...
Dialogue: 0,0:08:33.88,0:08:34.88,Default,,0,0,0,,Каменка
Dialogue: 0,0:08:35.68,0:08:38.85,Default,,0,0,0,,Бұл жерде есімдер мен беттердің мағынасы жоқ.
Dialogue: 0,0:08:38.93,0:08:41.89,Default,,0,0,0,,Күшті немесе әлсіз? Бар болғаны.
Dialogue: 0,0:08:42.31,0:08:44.02,Default,,0,0,0,,Бұл жылан шұңқыры
Dialogue: 0,0:08:44.10,0:08:47.73,Default,,0,0,0,,It is a sacred place where the strongest Bladers are created.
Dialogue: 0,0:08:48.40,0:08:52.78,Default,,0,0,0,,They are trying to level up in this training room.
Dialogue: 0,0:08:53.03,0:08:54.49,Default,,0,0,0,,Деңгейді көтеру...
Dialogue: 0,0:08:54.57,0:08:56.11,Default,,0,0,0,,Шектен асып кетті.
Dialogue: 0,0:08:56.20,0:08:58.28,Default,,0,0,0,,Жоқ, бұл жаттығу емес.
Dialogue: 0,0:08:58.78,0:09:00.37,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:09:01.04,0:09:04.37,Default,,0,0,0,,Мұндағы әркім өз қалағанын істеп жатыр.
Dialogue: 0,0:09:04.46,0:09:05.67,Default,,0,0,0,,Не, ақымақ?
Dialogue: 0,0:09:06.29,0:09:09.50,Default,,0,0,0,,Бәріңіз де күшті болғыңыз келетініне сенімдімін.
Dialogue: 0,0:09:09.96,0:09:11.38,Default,,0,0,0,,Олар да солай.
Dialogue: 0,0:09:12.34,0:09:16.26,Default,,0,0,0,,Shu too... Did you come here with that in mind?
Dialogue: 0,0:09:16.68,0:09:18.76,Default,,0,0,0,,Hey, tell me about Shu.
Dialogue: 0,0:09:19.22,0:09:20.43,Default,,0,0,0,,Шу қай жерде?
Dialogue: 0,0:09:20.51,0:09:21.76,Default,,0,0,0,,Шу?
Dialogue: 0,0:09:21.85,0:09:23.35,Default,,0,0,0,,Бұл Куришуу.
Dialogue: 0,0:09:23.43,0:09:27.19,Default,,0,0,0,,Қызылкөз деген мыңжапырақта Шудың шыбығы бар екен.
Dialogue: 0,0:09:27.27,0:09:29.40,Default,,0,0,0,,Не керек, өлдім деп айтпа.
Dialogue: 0,0:09:29.86,0:09:32.32,Default,,0,0,0,,А, сол кездегі бала ма?
Dialogue: 0,0:09:32.98,0:09:34.78,Default,,0,0,0,,Қызыл көз айтқандай.
Dialogue: 0,0:09:35.24,0:09:37.32,Default,,0,0,0,,Ол соңғы соққыны жасады.
Dialogue: 0,0:09:39.66,0:09:41.03,Default,,0,0,0,,Қызыл көз…
Dialogue: 0,0:09:41.99,0:09:46.29,Default,,0,0,0,,Those who gathered here came seeking strength.
Dialogue: 0,0:09:46.71,0:09:50.29,Default,,0,0,0,,Competitions are held every day and rankings change.
Dialogue: 0,0:09:50.96,0:09:53.09,Default,,0,0,0,,Өз дәрежесін көтеру
Dialogue: 0,0:09:53.25,0:09:58.26,Default,,0,0,0,,Subject yourself to rigorous training, and if you can't, then go for it.
Dialogue: 0,0:09:59.51,0:10:03.43,Default,,0,0,0,,Қарапайым ережелер, солай ма? Әлсіздер өмір сүре алмайды
Dialogue: 0,0:10:03.85,0:10:07.69,Default,,0,0,0,,Kurishuu also didn't have the strength to survive.
Dialogue: 0,0:10:07.77,0:10:09.65,Default,,0,0,0,,Шу әлсіз емес!
Dialogue: 0,0:10:09.73,0:10:12.69,Default,,0,0,0,,Сіз Шу туралы ештеңе білмейсіз.
Dialogue: 0,0:10:13.07,0:10:14.32,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:10:15.23,0:10:17.95,Default,,0,0,0,,Ол басқалардан көп еңбек етті.
Dialogue: 0,0:10:18.03,0:10:20.95,Default,,0,0,0,,Мен көп жаттығып, жарақаттармен күрестім.
Dialogue: 0,0:10:21.03,0:10:26.45,Default,,0,0,0,,Мен шынымен күшті ерекше қозғалыс жасау үшін көп жұмыс жасадым.
Dialogue: 0,0:10:27.04,0:10:29.79,Default,,0,0,0,,Сондықтан ол төрт орамның патшасы, сондықтан ол күшті.
Dialogue: 0,0:10:30.33,0:10:33.21,Default,,0,0,0,,Шудың сендерден ұтылуы мүмкін емес!
Dialogue: 0,0:10:34.00,0:10:37.59,Default,,0,0,0,,Куришуға қайда қарадың?
Dialogue: 0,0:10:38.97,0:10:43.30,Default,,0,0,0,,Балалар сендер қарап отырған куришуу оның бір жағы ғана.
Dialogue: 0,0:10:44.14,0:10:47.48,Default,,0,0,0,,Ол тіпті өз шығанағын да білмеді.
Dialogue: 0,0:10:47.56,0:10:49.77,Default,,0,0,0,,Сондықтан мен Бузамадан жеңіліп қалдым.
Dialogue: 0,0:10:50.52,0:10:52.86,Default,,0,0,0,,Бұл өтірік... Бұл өтірік!
Dialogue: 0,0:10:53.36,0:10:55.98,Default,,0,0,0,,Аңыз Спригган - керемет шығанақ.
Dialogue: 0,0:10:56.36,0:10:58.82,Default,,0,0,0,,Not suitable for Benishuu.
Dialogue: 0,0:10:59.36,0:11:02.70,Default,,0,0,0,,Қызыл көз бұл рөлге жауапты.
Dialogue: 0,0:11:03.24,0:11:04.70,Default,,0,0,0,,I can't forgive...
Dialogue: 0,0:11:05.33,0:11:10.67,Default,,0,0,0,,Вббаның жылы суына шомылған сен сияқты жүзділер...
Dialogue: 0,0:11:10.79,0:11:12.79,Default,,0,0,0,,Шулы! ! !
Dialogue: 0,0:11:13.00,0:11:16.75,Default,,0,0,0,,Спригган Шудың серіктесі. Өзімшіл ештеңе жасамаңыз!
Dialogue: 0,0:11:17.21,0:11:18.88,Default,,0,0,0,,Спригганды қайтарыңыз!
Dialogue: 0,0:11:19.55,0:11:22.47,Default,,0,0,0,,«Мықты бол» дедім.
Dialogue: 0,0:11:24.18,0:11:27.72,Default,,0,0,0,,Бұл жылан шұңқырында күштілер «абсолютті»
Dialogue: 0,0:11:28.06,0:11:32.35,Default,,0,0,0,,Қызыл көзді кездестіргіңіз келсе, құқық үшін күресіңіз.
Dialogue: 0,0:11:32.90,0:11:35.11,Default,,0,0,0,,А, мен ұрысамын.
Dialogue: 0,0:11:35.40,0:11:36.77,Default,,0,0,0,,Жасайық
Dialogue: 0,0:11:36.86,0:11:39.40,Default,,0,0,0,,Әй, сен қариямен төбелеспексің бе?
Dialogue: 0,0:11:39.69,0:11:42.11,Default,,0,0,0,,Жоқ, бұл мен емес.
Dialogue: 0,0:11:42.28,0:11:43.91,Default,,0,0,0,,Сонымен, балалар?
Dialogue: 0,0:11:44.28,0:11:46.12,Default,,0,0,0,,Әй, мақтанба.
Dialogue: 0,0:11:46.24,0:11:49.54,Default,,0,0,0,,Will people like you be our opponents?
Dialogue: 0,0:11:49.83,0:11:52.04,Default,,0,0,0,,Нандато Коньяро
Dialogue: 0,0:11:52.33,0:11:55.00,Default,,0,0,0,,Сізді шақыруымның себебі бар.
Dialogue: 0,0:11:55.46,0:11:59.88,Default,,0,0,0,,Біз үшін бұл өмірде бір рет болатын мүмкіндік.
Dialogue: 0,0:11:59.96,0:12:01.13,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:09.18,0:12:10.89,Default,,0,0,0,,It's a mask again...
Dialogue: 0,0:12:10.98,0:12:12.31,Default,,0,0,0,,Кайо Кайо
Dialogue: 0,0:12:12.60,0:12:14.60,Default,,0,0,0,,They serve as the other party.
Dialogue: 0,0:12:14.98,0:12:16.40,Default,,0,0,0,,Неге бұл жігіттермен?
Dialogue: 0,0:12:16.65,0:12:17.73,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:12:20.99,0:12:22.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:22.11,0:12:26.41,Default,,0,0,0,,(ретімен жыпылықтайтын шығанақтардың дыбысы)
Dialogue: 0,0:12:26.91,0:12:30.83,Default,,0,0,0,,(шығырдың жыпылықтау дыбысы)
Dialogue: 0,0:12:32.00,0:12:33.83,Default,,0,0,0,,Эй, мына шығанақ...
Dialogue: 0,0:12:33.91,0:12:36.08,Default,,0,0,0,,That's a surprise.
Dialogue: 0,0:12:36.17,0:12:38.34,Default,,0,0,0,,Мен бұрын көрген нәрсеге ұқсайды
Dialogue: 0,0:12:38.75,0:12:40.67,Default,,0,0,0,,Тек түстері әртүрлі...
Dialogue: 0,0:12:40.76,0:12:42.05,Default,,0,0,0,,Сол шығанақ?
Dialogue: 0,0:12:42.42,0:12:47.09,Default,,0,0,0,,Қара көз Пайдаланылатын шығанақ Black Death Sizeer болып табылады
Dialogue: 0,0:12:47.43,0:12:48.76,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:12:49.18,0:12:52.85,Default,,0,0,0,,Күлгін Көз Бей – Қара Вайверн
Dialogue: 0,0:12:53.06,0:12:55.35,Default,,0,0,0,,Не? Не? Сіз оны плагиат жасадыңыз ба?
Dialogue: 0,0:12:55.60,0:12:59.19,Default,,0,0,0,,Сұр көз Бей - Қара хронос
Dialogue: 0,0:12:59.44,0:13:00.98,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:13:01.44,0:13:04.82,Default,,0,0,0,,Сарыкөз бей - Қара Рагнарук
Dialogue: 0,0:13:05.32,0:13:07.49,Default,,0,0,0,,Неліктен түн қараңғы?
Dialogue: 0,0:13:07.78,0:13:11.54,Default,,0,0,0,,Лазур Көз Бей - Қара Валькирия
Dialogue: 0,0:13:12.04,0:13:13.37,Default,,0,0,0,,Валькирия?
Dialogue: 0,0:13:13.79,0:13:15.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:15.29,0:13:18.42,Default,,0,0,0,,Неліктен бұл жігіт менің барлық жамандықты алып жатыр?
Dialogue: 0,0:13:19.25,0:13:21.30,Default,,0,0,0,,Міне, Жылан шұңқырында
Dialogue: 0,0:13:21.38,0:13:25.26,Default,,0,0,0,,Мақсаты - ең берік қалпақшалар мен шығанақтарды жасау.
Dialogue: 0,0:13:25.76,0:13:29.55,Default,,0,0,0,,Түпнұсқаға ие болсаңыз, осы көшірмемен күресіңіз.
Dialogue: 0,0:13:29.64,0:13:33.27,Default,,0,0,0,,Түпкілікті шығанақ құрудың үлкен пайдасы
Dialogue: 0,0:13:33.85,0:13:35.73,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:13:36.02,0:13:37.98,Default,,0,0,0,,Көшірумен қатар, қолданып көргіңіз келе ме?
Dialogue: 0,0:13:38.19,0:13:39.69,Default,,0,0,0,,Қызыл көзге не болды?
Dialogue: 0,0:13:39.98,0:13:42.36,Default,,0,0,0,,Менің күрескім келетін жалғыз адам - ​​Қызыл Көз!
Dialogue: 0,0:13:42.98,0:13:44.86,Default,,0,0,0,,Олай болса оларға қарсы күрес.
Dialogue: 0,0:13:45.28,0:13:46.53,Default,,0,0,0,,Қызыл...
Dialogue: 0,0:13:46.61,0:13:48.32,Default,,0,0,0,,Менімен ұрысқың келсе-
Dialogue: 0,0:13:48.91,0:13:51.12,Default,,0,0,0,,Осы шығанақтарды жеңгеннен кейін
Dialogue: 0,0:13:51.20,0:13:52.58,Default,,0,0,0,,Қызыл көз!
Dialogue: 0,0:13:52.66,0:13:53.99,Default,,0,0,0,,Тс!
Dialogue: 0,0:13:54.12,0:13:55.54,Default,,0,0,0,,Жақсы ұсыныс.
Dialogue: 0,0:13:56.08,0:13:57.75,Default,,0,0,0,,Сәйкестік 5-ке қарсы
Dialogue: 0,0:13:57.83,0:14:01.29,Default,,0,0,0,,Тек Реплика шығанағымен күресіп, аман қалғандар ғана...
Dialogue: 0,0:14:01.59,0:14:04.09,Default,,0,0,0,,Қызыл көзбен күресті қабылдаңыз
Dialogue: 0,0:14:04.17,0:14:06.47,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:14:06.55,0:14:08.30,Default,,0,0,0,,Мен мұны істеймін, тек жеңіңіз.
Dialogue: 0,0:14:08.84,0:14:12.05,Default,,0,0,0,,Жақсы, иә, маған тек жеңу керек.
Dialogue: 0,0:14:12.56,0:14:16.52,Default,,0,0,0,,Қызыл көз! Мен сенімен міндетті түрде ұрысамын
Dialogue: 0,0:14:16.60,0:14:19.85,Default,,0,0,0,,Жеңіп, Спригганды қайтарыңыз. Күте тұрыңыз!
Dialogue: 0,0:14:26.82,0:14:29.86,Default,,0,0,0,,Мен жеңемін, міндетті түрде жеңемін!
Dialogue: 0,0:14:30.32,0:14:32.66,Default,,0,0,0,,Ұрыс алаңына барыңыз!
Dialogue: 0,0:14:36.83,0:14:39.92,Default,,0,0,0,,Енді сендер де ұрыс сахнасына аттаныңдар.
Dialogue: 0,0:14:40.00,0:14:42.38,Default,,0,0,0,,(баспалдақтың қозғалу дыбысы)
Dialogue: 0,0:14:42.46,0:14:43.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:47.42,0:14:49.55,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:14:50.93,0:14:52.93,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:14:55.60,0:14:57.22,Default,,0,0,0,,Келесі жаттығуға көшу
Dialogue: 0,0:14:57.98,0:15:00.69,Default,,0,0,0,,Шынымды айтсам, мен ұялып тұрмын.
Dialogue: 0,0:15:01.85,0:15:05.40,Default,,0,0,0,,Қызыл көзге қарсы күресуге әлі күшім жетпейді.
Dialogue: 0,0:15:05.98,0:15:07.53,Default,,0,0,0,,Мен оларға қызғанышпен қараймын
Dialogue: 0,0:15:07.61,0:15:09.57,Default,,0,0,0,,Алдымен бұл идеяны тастаңыз.
Dialogue: 0,0:15:11.16,0:15:13.07,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:15:15.91,0:15:17.20,Default,,0,0,0,,(Таңқаларлық дауыс)
Dialogue: 0,0:15:17.29,0:15:18.91,Default,,0,0,0,,Мына жерде!
Dialogue: 0,0:15:19.96,0:15:22.25,Default,,0,0,0,,Бұл жылу дегеніміз не?
Dialogue: 0,0:15:22.33,0:15:24.17,Default,,0,0,0,,Сауна сияқты емес пе?
Dialogue: 0,0:15:30.84,0:15:33.55,Default,,0,0,0,,Мұндай маска киген ыстық емес пе?
Dialogue: 0,0:15:33.64,0:15:38.47,Default,,0,0,0,,Хехехе ыстық, өте ыстық
Dialogue: 0,0:15:38.56,0:15:39.77,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:15:40.27,0:15:41.94,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:15:43.40,0:15:46.69,Default,,0,0,0,,Енді менімен кім шайқасады?
Dialogue: 0,0:15:47.23,0:15:49.19,Default,,0,0,0,,Бұл Кумичо-сама!
Dialogue: 0,0:15:49.57,0:15:51.70,Default,,0,0,0,,Рагнарук үшін Рагнарук
Dialogue: 0,0:15:52.32,0:15:54.28,Default,,0,0,0,,Ластанған жерді тез тазалаңыз
Dialogue: 0,0:15:54.37,0:15:57.45,Default,,0,0,0,,Мен Қызыл көзге қарсы бірінші болып жарысамын.
Dialogue: 0,0:15:57.74,0:15:59.54,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:15:59.62,0:16:01.71,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:16:02.00,0:16:03.92,Default,,0,0,0,,Егер сіз Ragnaruk пайдаланушысы болсаңыз
Dialogue: 0,0:16:04.00,0:16:06.63,Default,,0,0,0,,Соңында мені күткен боларсың.
Dialogue: 0,0:16:07.00,0:16:10.34,Default,,0,0,0,,Күш рейтингі бесеуміз үшін маңызды емес.
Dialogue: 0,0:16:10.42,0:16:14.09,Default,,0,0,0,,Жалғыз мақсат – шыңда тұрған Қызыл көзді жеңу.
Dialogue: 0,0:16:14.55,0:16:16.64,Default,,0,0,0,,Енді бастайық!
Dialogue: 0,0:16:16.72,0:16:18.81,Default,,0,0,0,,Сіз тіпті ұстағышқа еліктейсіз бе?
Dialogue: 0,0:16:18.89,0:16:21.06,Default,,0,0,0,,Ол сенікінен ауыр.
Dialogue: 0,0:16:21.14,0:16:23.48,Default,,0,0,0,,Бұл өте жағымсыз нәрсе.
Dialogue: 0,0:16:23.64,0:16:28.65,Default,,0,0,0,,Бұдан былай шайқас Қара Рагнарук пен Блэйз Рагнарук арасында болады.
Dialogue: 0,0:16:28.94,0:16:30.32,Default,,0,0,0,,Сізді бақылап жатыр.
Dialogue: 0,0:16:30.40,0:16:31.65,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:16:32.24,0:16:35.91,Default,,0,0,0,,Әлемдік рейтингшілердің шайқасын көру
Dialogue: 0,0:16:36.24,0:16:38.66,Default,,0,0,0,,Бірегей үлгі
Dialogue: 0,0:16:39.33,0:16:42.62,Default,,0,0,0,,Ереже: кім бірінші 2 ұпай жинаса, сол жеңеді.
Dialogue: 0,0:16:43.41,0:16:44.79,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:16:45.33,0:16:48.50,Default,,0,0,0,,Мен сені жеңіп, түпнұсқа боламын.
Dialogue: 0,0:16:48.79,0:16:50.38,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:16:50.46,0:16:53.05,Default,,0,0,0,,Нағыз нәрсе жалған нәрседен ұтылмайды!
Dialogue: 0,0:16:53.59,0:16:58.60,Default,,0,0,0,,Бірінші ойында жеңіске жетіп, жігіттерге серпін берейік.
Dialogue: 0,0:16:58.89,0:17:01.47,Default,,0,0,0,,О, Кумичо, жең!
Dialogue: 0,0:17:01.56,0:17:04.60,Default,,0,0,0,,Жеңілсең, мен енді мұны істей алмаймын.
Dialogue: 0,0:17:04.69,0:17:05.89,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:17:06.19,0:17:08.02,Default,,0,0,0,,Шатаспаңыз
Dialogue: 0,0:17:08.44,0:17:09.61,Default,,0,0,0,,Дегенмен, ешкім де сол кісі өлтірулерді байқамаған
Dialogue: 0,0:17:09.94,0:17:11.65,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:11.73,0:17:15.28,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:15.45,0:17:17.28,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:20.08,0:17:21.79,Default,,0,0,0,,Төзімділік пен төзімділік?
Dialogue: 0,0:17:21.87,0:17:23.75,Default,,0,0,0,,Көшірмелерді жоғалтпаңыз!
Dialogue: 0,0:17:24.04,0:17:25.25,Default,,0,0,0,,Бетперделі мыңжапырақ
Dialogue: 0,0:17:25.33,0:17:28.25,Default,,0,0,0,,Рагнарукты қанша оқысам да
Dialogue: 0,0:17:28.33,0:17:31.21,Default,,0,0,0,,Бұл жерде төзімділік деп аталатын нәрсе бар.
Dialogue: 0,0:17:31.71,0:17:35.01,Default,,0,0,0,,Бұл да мизумизу, Рантаро Кияма.
Dialogue: 0,0:17:35.09,0:17:36.05,Default,,0,0,0,,Не?
Dialogue: 0,0:17:36.55,0:17:39.51,Default,,0,0,0,,Бей спецификациялары және пышақ дағдылары
Dialogue: 0,0:17:39.60,0:17:41.68,Default,,0,0,0,,Күшті болу үшін...
Dialogue: 0,0:17:43.22,0:17:47.14,Default,,0,0,0,,Екеуін ең жақсы жағдайда біріктіру керек.
Dialogue: 0,0:17:49.73,0:17:51.90,Default,,0,0,0,,Жүр! Рагнарук!
Dialogue: 0,0:17:51.98,0:17:54.86,Default,,0,0,0,,Блэйз Рагнаруктың кілті - қабатты қанат.
Dialogue: 0,0:17:55.11,0:17:57.15,Default,,0,0,0,,Егер сіз шыдамдылықпен өте алсаңыз...
Dialogue: 0,0:18:01.37,0:18:04.58,Default,,0,0,0,,Жарайсыңдар! Бұл төзімділік шайқасы
Dialogue: 0,0:18:10.71,0:18:12.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:14.17,0:18:16.59,Default,,0,0,0,,Не болды, Рагнарук?
Dialogue: 0,0:18:26.77,0:18:27.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:28.23,0:18:31.40,Default,,0,0,0,,Айналдыру Аяқтау Сары көздің жеңісі
Dialogue: 0,0:18:31.52,0:18:32.86,Default,,0,0,0,,1 ұпай бірінші
Dialogue: 0,0:18:33.15,0:18:34.44,Default,,0,0,0,,Кумичо…
Dialogue: 0,0:18:36.24,0:18:37.57,Default,,0,0,0,,Ngaa Achii
Dialogue: 0,0:18:37.69,0:18:39.20,Default,,0,0,0,,Бұл Ачи!
Dialogue: 0,0:18:39.36,0:18:41.66,Default,,0,0,0,,Ыстық, өйткені ыстық деп ойлайсың.
Dialogue: 0,0:18:41.74,0:18:42.87,Default,,0,0,0,,Шулы!
Dialogue: 0,0:18:42.95,0:18:44.49,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:18:44.95,0:18:49.41,Default,,0,0,0,,Оның жарылуы мүмкін еместігі зерттеулердің жеткіліксіздігінен болған сияқты.
Dialogue: 0,0:18:49.54,0:18:52.00,Default,,0,0,0,,Бар болғаны 1 ұпай алынды.
Dialogue: 0,0:18:52.50,0:18:54.38,Default,,0,0,0,,Бұл Кумичо-саманың эволюциясы
Dialogue: 0,0:18:54.46,0:18:57.38,Default,,0,0,0,,Бір ұпай алынғанда басталады.
Dialogue: 0,0:18:57.71,0:18:59.97,Default,,0,0,0,,Әрі қарай аяқтаймыз.
Dialogue: 0,0:19:00.05,0:19:01.09,Default,,0,0,0,,Мен!
Dialogue: 0,0:19:06.10,0:19:07.35,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:19:07.60,0:19:10.44,Default,,0,0,0,,Жарайды, мен сені бір оқпен өлтіремін.
Dialogue: 0,0:19:11.23,0:19:12.23,Default,,0,0,0,,Хехе...
Dialogue: 0,0:19:12.52,0:19:14.27,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:14.36,0:19:17.90,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:18.40,0:19:20.57,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:24.53,0:19:26.12,Default,,0,0,0,,Бұзыңыз, Рагнарук!
Dialogue: 0,0:19:26.20,0:19:27.95,Default,,0,0,0,,Бір ұпайға ұмтылыңыз!
Dialogue: 0,0:19:28.04,0:19:30.41,Default,,0,0,0,,Бұл сіздің жолыңызда бола ма?
Dialogue: 0,0:19:38.88,0:19:40.17,Default,,0,0,0,,Көлеңке сияқты
Dialogue: 0,0:19:40.84,0:19:42.59,Default,,0,0,0,,А... көлеңке?
Dialogue: 0,0:19:42.68,0:19:45.01,Default,,0,0,0,,Әйтеуір Кумичоның Рагнарукы
Dialogue: 0,0:19:45.10,0:19:47.72,Default,,0,0,0,,Сіз өз көлеңкеңізбен күресіп жатқан сияқтысыз ба?
Dialogue: 0,0:19:49.31,0:19:52.48,Default,,0,0,0,,Көлеңкеден жеңілсем, ол мені басып ала ма...
Dialogue: 0,0:19:52.64,0:19:55.48,Default,,0,0,0,,Бұл шынымен жағымсыз сезім.
Dialogue: 0,0:19:59.53,0:20:02.11,Default,,0,0,0,,Бұзыңыз, Рагнарук!
Dialogue: 0,0:20:03.41,0:20:04.91,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:05.20,0:20:06.66,Default,,0,0,0,,Сатып алуға алданған адам – нағыз ақымақ
Dialogue: 0,0:20:06.95,0:20:08.66,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:20:09.29,0:20:11.54,Default,,0,0,0,,2 ұпай
Dialogue: 0,0:20:11.83,0:20:14.12,Default,,0,0,0,,Сары көз 3-0 есебімен жеңді
Dialogue: 0,0:20:14.92,0:20:15.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:17.63,0:20:19.59,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:20:19.67,0:20:20.71,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,0:20:20.80,0:20:21.88,Default,,0,0,0,,Кумичо!
Dialogue: 0,0:20:28.47,0:20:29.64,Default,,0,0,0,,Барлығы ұстап алсын!
Dialogue: 0,0:20:32.06,0:20:33.44,Default,,0,0,0,,Уф... уау!
Dialogue: 0,0:20:33.94,0:20:35.15,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:20:39.65,0:20:41.32,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:20:41.57,0:20:43.95,Default,,0,0,0,,Күрсіну... Бұл көмектесті.
Dialogue: 0,0:20:45.11,0:20:47.28,Default,,0,0,0,,Рахмет сізге Куза
Dialogue: 0,0:20:47.95,0:20:49.62,Default,,0,0,0,,Мен саған қамқор боламын
Dialogue: 0,0:20:50.04,0:20:52.37,Default,,0,0,0,,Ереже - құлау және жоғалу.
Dialogue: 0,0:20:52.91,0:20:55.00,Default,,0,0,0,,Бұл қолайлы ма?
Dialogue: 0,0:20:55.54,0:20:58.67,Default,,0,0,0,,Мен өзімнің шіркіннің бетін ашқым келеді.
Dialogue: 0,0:20:59.25,0:21:00.67,Default,,0,0,0,,Мен мойындаймын.
Dialogue: 0,0:21:01.13,0:21:02.92,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:21:04.63,0:21:07.05,Default,,0,0,0,,Енді келесі кезеңге көшейік.
Dialogue: 0,0:21:24.65,0:21:25.78,Default,,0,0,0,,Сіз...
Dialogue: 0,0:21:25.86,0:21:29.57,Default,,0,0,0,,Есімде дұрыс болса, Қара көз деп аталады. Death Sizeer пайдаланады.
Dialogue: 0,0:21:30.28,0:21:33.29,Default,,0,0,0,,Бұл тамаша шығанақ, Deathsizer.
Dialogue: 0,0:21:33.37,0:21:34.96,Default,,0,0,0,,Менің қолыма сәйкес келеді
Dialogue: 0,0:21:35.16,0:21:37.96,Default,,0,0,0,,Рұқсатсыз көшіріп ал Мен жиі айтамын.
Dialogue: 0,0:21:38.46,0:21:41.71,Default,,0,0,0,,Сонда менімен кім күреседі?
Dialogue: 0,0:21:42.00,0:21:44.17,Default,,0,0,0,,Сіз бұл менмін деп шештіңіз.
Dialogue: 0,0:21:45.01,0:21:46.80,Default,,0,0,0,,Көлеңкелер көлеңке болып қалады
Dialogue: 0,0:21:47.38,0:21:49.68,Default,,0,0,0,,Өлім мөлшерлеушісі және өлім өлшемі?
Dialogue: 0,0:21:55.81,0:21:58.31,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.40,0:22:01.73,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.82,0:22:04.44,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.53,0:22:06.82,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:06.90,0:22:10.45,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.53,0:22:14.16,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.24,0:22:16.00,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.08,0:22:17.79,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:17.87,0:22:19.67,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.75,0:22:21.38,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.46,0:22:23.46,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.55,0:22:25.92,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.01,0:22:28.93,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.01,0:22:32.64,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.72,0:22:36.39,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.48,0:22:38.14,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.23,0:22:41.40,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.48,0:22:43.82,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:43.90,0:22:47.36,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.44,0:22:50.95,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.03,0:22:52.99,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.08,0:22:54.83,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:54.91,0:22:58.33,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.41,0:23:00.46,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.54,0:23:03.42,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.50,0:23:05.71,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.80,0:23:09.72,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.80,0:23:13.39,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.47,0:23:17.02,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.10,0:23:20.27,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.35,0:23:21.98,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.06,0:23:24.90,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.06,0:23:24.90,Default,,0,0,0,,~♪
Dialogue: 0,0:23:24.90,0:23:25.36,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.94,0:23:29.90,Default,,0,0,0,,Жылан шұңқырындағы шайқас жалғасуда.
Dialogue: 0,0:23:30.20,0:23:33.28,Default,,0,0,0,,Динаға да, Кузаға да керемет қарсылас шығады.
Dialogue: 0,0:23:33.74,0:23:37.29,Default,,0,0,0,,Өз биіңіздің көшірмесімен күресу өте қиын.
Dialogue: 0,0:23:37.62,0:23:39.87,Default,,0,0,0,,Мен өзіммен күресіп жатқан сияқтымын.
Dialogue: 0,0:23:40.62,0:23:43.04,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.13,0:23:45.25,Default,,0,0,0,,Лабиринт! Қара зындан!
Dialogue: 0,0:23:45.63,0:23:49.59,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.09,0:23:57.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory