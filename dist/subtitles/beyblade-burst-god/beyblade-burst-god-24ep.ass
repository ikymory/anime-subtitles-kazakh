Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.08,0:00:07.17,Default,,0,0,0,,wbba.Әлемдік лига!
Dialogue: 0,0:00:07.71,0:00:13.01,Default,,0,0,0,,Clubs that win each league will battle their way to the top of the world.
Dialogue: 0,0:00:13.09,0:00:16.55,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз!
Dialogue: 0,0:00:17.05,0:00:20.31,Default,,0,0,0,,Burn your warriors and go beyond your limits!
Dialogue: 0,0:00:21.06,0:00:25.19,Default,,0,0,0,,Жандардың қызу шайқасы әлемді толғандырады
Dialogue: 0,0:00:25.85,0:00:29.36,Default,,0,0,0,,Даңқты алатын сенсің!
Dialogue: 0,0:00:36.53,0:00:38.87,Default,,0,0,0,,Мен оны таба алмаймын...
Dialogue: 0,0:00:39.03,0:00:39.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:45.58,0:00:49.63,Default,,0,0,0,,Зоро бізге BC Солдың жаттықтырушысы ретінде қосылды!
Dialogue: 0,0:00:50.92,0:00:52.51,Default,,0,0,0,,(есіктің сықырлаған дыбысы)
Dialogue: 0,0:00:53.84,0:00:56.47,Default,,0,0,0,,Не? жер асты?
Dialogue: 0,0:00:59.85,0:01:01.39,Default,,0,0,0,,Джажан~н
Dialogue: 0,0:01:02.31,0:01:03.35,Default,,0,0,0,,Стадион?
Dialogue: 0,0:01:03.48,0:01:05.69,Default,,0,0,0,,Ал ата бізге
Dialogue: 0,0:01:05.77,0:01:08.35,Default,,0,0,0,,Ол Infinite Bay стадионын салды.
Dialogue: 0,0:01:09.61,0:01:10.48,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:01:12.36,0:01:14.32,Default,,0,0,0,,Айналды! (Барлығы) О!
Dialogue: 0,0:01:26.71,0:01:28.54,Default,,0,0,0,,Мен қозғала алмаймын...
Dialogue: 0,0:01:32.42,0:01:34.34,Default,,0,0,0,,Бұл жігітті жеңе алмасаң
Dialogue: 0,0:01:34.42,0:01:37.68,Default,,0,0,0,,Дүниежүзілік лигада жеңіске жету қиын.
Dialogue: 0,0:01:37.76,0:01:39.09,Default,,0,0,0,,(Түкіру дыбысы)
Dialogue: 0,0:01:39.26,0:01:40.51,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:01:40.60,0:01:42.93,Default,,0,0,0,,Мен бұл жігітті жеңе аламын деп үміттенемін!
Dialogue: 0,0:01:43.35,0:01:44.85,Default,,0,0,0,,Керемет!
Dialogue: 0,0:01:44.93,0:01:46.85,Default,,0,0,0,,Иә, бұл қызықты көрінеді!
Dialogue: 0,0:01:46.94,0:01:48.44,Default,,0,0,0,,Жарайсың, ата.
Dialogue: 0,0:01:48.98,0:01:52.27,Default,,0,0,0,,You can do a lot of special training with this guy!
Dialogue: 0,0:01:53.44,0:01:56.19,Default,,0,0,0,,♪~
Dialogue: 0,0:01:56.28,0:01:58.70,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:58.78,0:02:01.24,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:01.32,0:02:03.66,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:03.74,0:02:06.25,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:06.33,0:02:07.83,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:02:07.91,0:02:12.17,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:13.09,0:02:17.84,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:17.92,0:02:22.30,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:22.93,0:02:27.68,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:27.77,0:02:32.69,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:32.77,0:02:37.65,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:37.74,0:02:42.70,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:42.78,0:02:46.08,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:46.16,0:02:47.66,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:47.75,0:02:50.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:50.37,0:02:52.71,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:52.79,0:02:54.67,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:54.75,0:02:56.09,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:56.17,0:02:57.76,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:57.84,0:03:00.34,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:03:00.43,0:03:06.47,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:03:06.56,0:03:10.94,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:11.02,0:03:13.69,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:13.77,0:03:16.07,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:16.15,0:03:18.69,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:18.78,0:03:22.36,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:24.37,0:03:26.91,Default,,0,0,0,,Төңкеріс! Әлемдік лига!
Dialogue: 0,0:03:27.99,0:03:30.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:30.08,0:03:32.92,Default,,0,0,0,,Джошуаның шайқасынан ләззат алыңыз!
Dialogue: 0,0:03:33.63,0:03:35.42,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:03:37.34,0:03:40.30,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:03:40.76,0:03:43.26,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:47.26,0:03:50.52,Default,,0,0,0,,Кәне, бастайық!
Dialogue: 0,0:03:50.60,0:03:53.48,Default,,0,0,0,,Кенет капитан болып қалсаңыз, ақымақ болмаңыз!
Dialogue: 0,0:03:53.56,0:03:56.98,Default,,0,0,0,,We'll show you the power of the Bulls' top team!
Dialogue: 0,0:03:57.11,0:03:59.94,Default,,0,0,0,,Циклон қабырғасы
Dialogue: 0,0:04:02.40,0:04:04.61,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:04:07.87,0:04:10.83,Default,,0,0,0,,Сіз Диланмын дедіңіз бе?
Dialogue: 0,0:04:11.25,0:04:13.83,Default,,0,0,0,,Капитан сізге беріп жатыр.
Dialogue: 0,0:04:13.92,0:04:15.75,Default,,0,0,0,,Сізге көбірек тырысу керек.
Dialogue: 0,0:04:15.83,0:04:17.50,Default,,0,0,0,,Куу…
Dialogue: 0,0:04:17.79,0:04:18.88,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:19.67,0:04:22.05,Default,,0,0,0,,Джошуа, міне Кимезериф.
Dialogue: 0,0:04:22.92,0:04:26.01,Default,,0,0,0,,Мен Бун Джошуа Бунмын!
Dialogue: 0,0:04:26.68,0:04:29.43,Default,,0,0,0,,Бейбаттпен өзіңізді қорғаңыз!
Dialogue: 0,0:04:30.06,0:04:33.77,Default,,0,0,0,,Тред мырза, Джошуаның көңіл-күйі жақсы ма?
Dialogue: 0,0:04:34.27,0:04:36.52,Default,,0,0,0,,Түсіру жылдамдығы мен қуаты ретінде де белгілі.
Dialogue: 0,0:04:36.60,0:04:39.07,Default,,0,0,0,,Деректер ең жоғары деңгейде
Dialogue: 0,0:04:39.15,0:04:41.48,Default,,0,0,0,,Үлкен 5-тен күткендей.
Dialogue: 0,0:04:41.57,0:04:44.03,Default,,0,0,0,,Алтын балық саңырауқұлағындай әрқашан бар.
Dialogue: 0,0:04:44.11,0:04:46.11,Default,,0,0,0,,Терри Транк - бұл қолайсыздық
Dialogue: 0,0:04:46.49,0:04:50.54,Default,,0,0,0,,Киноөндіріс онымен келісімшартқа отыру шарты болып табылады.
Dialogue: 0,0:04:51.29,0:04:52.70,Default,,0,0,0,,Сабырлы болыңыз.
Dialogue: 0,0:04:53.04,0:04:55.71,Default,,0,0,0,,Циклондық есептегіш!
Dialogue: 0,0:04:57.42,0:04:59.75,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:05:00.04,0:05:01.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:01.46,0:05:04.38,Default,,0,0,0,,Камераны тоқтатыңыз!
Dialogue: 0,0:05:05.34,0:05:09.39,Default,,0,0,0,,Мынаны мінгім келмейді... қарсыласым тым әлсіз
Dialogue: 0,0:05:09.47,0:05:12.22,Default,,0,0,0,,Мен сендерге сценарийді ертерек дұрыс айттым.
Dialogue: 0,0:05:12.31,0:05:14.93,Default,,0,0,0,,Бірінші шайқас сіз үшін.
Dialogue: 0,0:05:15.02,0:05:17.81,Default,,0,0,0,,Мен де көп ұпай жинаймын.
Dialogue: 0,0:05:18.10,0:05:21.57,Default,,0,0,0,,Сізге көбірек Гамба керек! Жақсы?
Dialogue: 0,0:05:21.98,0:05:23.23,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:05:25.86,0:05:29.37,Default,,0,0,0,,Гилтен мырза, Еркін қашан келеді?
Dialogue: 0,0:05:29.45,0:05:33.62,Default,,0,0,0,,Фриланс соңғы кездері жалғыз жаттығатын сияқты.
Dialogue: 0,0:05:33.75,0:05:37.96,Default,,0,0,0,,Бірақ ол Дүниежүзілік лига басталмай тұрып пайда болады.
Dialogue: 0,0:05:38.04,0:05:40.50,Default,,0,0,0,,Уайымдамаңыз, капитан.
Dialogue: 0,0:05:41.04,0:05:42.96,Default,,0,0,0,,Еркін келіңдер
Dialogue: 0,0:05:46.05,0:05:49.51,Default,,0,0,0,,Сіз болдыңыз ба? сен қайдасың?
Dialogue: 0,0:05:49.59,0:05:52.51,Default,,0,0,0,,Джошуа менімен кездескісі келсе де.
Dialogue: 0,0:05:52.60,0:05:54.77,Default,,0,0,0,,Еркін жұмысты ұнатасыз ба?
Dialogue: 0,0:05:54.85,0:05:57.23,Default,,0,0,0,,Ватт! ? (Карина) Ия!
Dialogue: 0,0:05:57.31,0:05:58.44,Default,,0,0,0,,Тағы бір рет, өтінемін!
Dialogue: 0,0:05:59.15,0:06:01.19,Default,,0,0,0,,Бөлмеге рұқсатсыз кіруге болмайды.
Dialogue: 0,0:06:01.40,0:06:03.82,Default,,0,0,0,,Голливуд жұлдызы Джошуа Бун
Dialogue: 0,0:06:03.90,0:06:06.94,Default,,0,0,0,,Негізі мен Free De La Hoya-ның жанкүйерімін.
Dialogue: 0,0:06:07.03,0:06:09.36,Default,,0,0,0,,Бөлменің әр жерінде сыланған плакаттар бар.
Dialogue: 0,0:06:09.45,0:06:12.66,Default,,0,0,0,,Мен бүкіл әлем бойынша Джошуаның жанкүйерлеріне айтқым келеді.
Dialogue: 0,0:06:12.74,0:06:16.29,Default,,0,0,0,,Бұлай айтпау керек!
Dialogue: 0,0:06:16.37,0:06:18.41,Default,,0,0,0,,Джошуа Блейдер ретінде
Dialogue: 0,0:06:18.50,0:06:23.17,Default,,0,0,0,,Мен әрқашан бірінші болып қалатын Еркінді құрметтеймін.
Dialogue: 0,0:06:23.46,0:06:26.92,Default,,0,0,0,,Білемін, ағайын.
Dialogue: 0,0:06:27.01,0:06:29.13,Default,,0,0,0,,Мені мәңгілік баладай көрме.
Dialogue: 0,0:06:29.34,0:06:31.09,Default,,0,0,0,,Қанша жұлдыз болсаң да
Dialogue: 0,0:06:31.18,0:06:33.35,Default,,0,0,0,,Сен менің сүйкімді ағамсың
Dialogue: 0,0:06:33.43,0:06:34.64,Default,,0,0,0,,Джошуа-чан
Dialogue: 0,0:06:34.72,0:06:35.68,Default,,0,0,0,,Міне, Абдул мырза дәл осылай дейді
Dialogue: 0,0:06:35.77,0:06:38.43,Default,,0,0,0,,Мен бос орын тауып бердім.
Dialogue: 0,0:06:38.52,0:06:39.39,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:39.73,0:06:44.40,Default,,0,0,0,,Детектив Карина Бун Сәлем! Хехе
Dialogue: 0,0:06:45.36,0:06:48.36,Default,,0,0,0,,Ватт? Хайуанаттар бағында неге тегін?
Dialogue: 0,0:06:48.69,0:06:50.61,Default,,0,0,0,,Мен онша көп білмеймін.
Dialogue: 0,0:06:50.70,0:06:52.78,Default,,0,0,0,,Сіз детективсіз бе? Әпке
Dialogue: 0,0:06:52.87,0:06:54.83,Default,,0,0,0,,Әзілді байыппен қабылдамаңыз
Dialogue: 0,0:06:54.91,0:06:55.74,Default,,0,0,0,,Сол сияқты, бір күні, бір жерде кездесесіздер.
Dialogue: 0,0:06:57.87,0:06:59.54,Default,,0,0,0,,Сіз не істеп жатырсыз? Тегін
Dialogue: 0,0:06:59.75,0:07:02.04,Default,,0,0,0,,Өтінемін, маған тезірек барыңыз.
Dialogue: 0,0:07:02.67,0:07:06.88,Default,,0,0,0,,Джошуаның Фримен кездесуі, ол ақырында оның шынайы досына айналады.
Dialogue: 0,0:07:06.96,0:07:09.97,Default,,0,0,0,,Тағдыр! тағдырлы болуы керек
Dialogue: 0,0:07:10.05,0:07:11.34,Default,,0,0,0,,Фильм ұнай ма?
Dialogue: 0,0:07:11.43,0:07:15.18,Default,,0,0,0,,Иә, осы фильмнің тамаша сценарийін жасау үшін.
Dialogue: 0,0:07:15.26,0:07:17.27,Default,,0,0,0,,Маған зерттеу керек
Dialogue: 0,0:07:17.89,0:07:18.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:19.60,0:07:22.56,Default,,0,0,0,,Жарайды Джошуа, біз түсіруді бастадық.
Dialogue: 0,0:07:22.65,0:07:25.44,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:07:26.02,0:07:29.78,Default,,0,0,0,,(Үру)
Dialogue: 0,0:07:36.24,0:07:37.99,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:07:39.75,0:07:44.00,Default,,0,0,0,,Бұл байланыстырылған реактивті ату. Бұл жолы сен мені өлтіресің, Валькири.
Dialogue: 0,0:07:46.59,0:07:48.55,Default,,0,0,0,,(Үру)
Dialogue: 0,0:07:56.26,0:08:00.85,Default,,0,0,0,,Еркін жолбарыспен жекпе-жек өткізу арқылы өз энергиясын шыңдауы мүмкін.
Dialogue: 0,0:08:00.93,0:08:02.10,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:02.19,0:08:04.40,Default,,0,0,0,,Мүмкін маған жолбарыстар ұнайтын шығар?
Dialogue: 0,0:08:04.48,0:08:06.65,Default,,0,0,0,,№.
Dialogue: 0,0:08:06.73,0:08:07.90,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:08:08.11,0:08:09.78,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:08:09.86,0:08:11.15,Default,,0,0,0,,Тегін…
Dialogue: 0,0:08:11.24,0:08:12.53,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:08:12.61,0:08:13.91,Default,,0,0,0,,Бум...бум
Dialogue: 0,0:08:14.45,0:08:16.16,Default,,0,0,0,,Джошуа Бун…
Dialogue: 0,0:08:16.78,0:08:18.78,Default,,0,0,0,,Карина, Джошуаның әпкесі.
Dialogue: 0,0:08:18.87,0:08:19.87,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:19.95,0:08:22.33,Default,,0,0,0,,Джошуаны танымайтыныңызға сенімдісіз бе?
Dialogue: 0,0:08:22.46,0:08:24.92,Default,,0,0,0,,Біз бірінші рет кездессек те, мен сені білуге ​​мүмкіндік жоқ.
Dialogue: 0,0:08:25.21,0:08:26.50,Default,,0,0,0,,Мех~
Dialogue: 0,0:08:26.58,0:08:28.59,Default,,0,0,0,,Сіз шынымен білмейтін сияқтысыз.
Dialogue: 0,0:08:29.63,0:08:31.13,Default,,0,0,0,,Әлі түсінбедіңіз бе?
Dialogue: 0,0:08:32.34,0:08:35.93,Default,,0,0,0,,Нағыз супержұлдыз, Джошуа Бун.
Dialogue: 0,0:08:37.01,0:08:38.14,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:38.51,0:08:39.68,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:08:39.76,0:08:41.22,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:08:41.39,0:08:42.60,Default,,0,0,0,,Джошуа осында!
Dialogue: 0,0:08:42.68,0:08:45.10,Default,,0,0,0,,Жоқ, бұл тамаша!
Dialogue: 0,0:08:45.31,0:08:47.52,Default,,0,0,0,,Жоқ, жанкүйерлер мені байқады.
Dialogue: 0,0:08:47.61,0:08:48.61,Default,,0,0,0,,Олай болса
Dialogue: 0,0:08:48.69,0:08:51.82,Default,,0,0,0,,А... Джошуаның әңгімесі әлі біткен жоқ.
Dialogue: 0,0:08:54.57,0:08:57.95,Default,,0,0,0,,Еркін мен Джошуаның кездесуі тағдырлы болған болуы керек!
Dialogue: 0,0:08:58.03,0:09:01.04,Default,,0,0,0,,Жарайды, олай болса тағдыр!
Dialogue: 0,0:09:03.70,0:09:05.08,Default,,0,0,0,,Тегін!
Dialogue: 0,0:09:08.71,0:09:09.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:09.92,0:09:12.92,Default,,0,0,0,,Мен бүгін сендермен жұмыс істей алмаймын.
Dialogue: 0,0:09:21.56,0:09:24.14,Default,,0,0,0,,Ешуа? Мен тегін қуып келемін
Dialogue: 0,0:09:24.23,0:09:26.19,Default,,0,0,0,,Рахмет сізге Карина
Dialogue: 0,0:09:27.48,0:09:29.36,Default,,0,0,0,,(Тормоз дыбысы)
Dialogue: 0,0:09:30.23,0:09:32.11,Default,,0,0,0,,Джошуа, асығыңыз!
Dialogue: 0,0:09:38.74,0:09:41.12,Default,,0,0,0,,Қазіргі көрініс тамаша түсірілді.
Dialogue: 0,0:09:41.41,0:09:44.04,Default,,0,0,0,,Тағдырлы кездесулер оңайлықпен бола бермейді.
Dialogue: 0,0:09:44.12,0:09:45.37,Default,,0,0,0,,Жан-Пьер Польнарефф
Dialogue: 0,0:09:47.79,0:09:52.00,Default,,0,0,0,,Бірінші нөмір күткендей, сізде жақсы атмосфера бар~
Dialogue: 0,0:09:52.09,0:09:54.96,Default,,0,0,0,,Джошуамен бірге ойнаған тамаша рөл!
Dialogue: 0,0:09:57.05,0:09:59.22,Default,,0,0,0,,)
Dialogue: 0,0:09:59.64,0:10:02.76,Default,,0,0,0,,Бастайық! Сацуэ қайта басталды!
Dialogue: 0,0:10:03.51,0:10:04.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:05.31,0:10:07.69,Default,,0,0,0,,Джошуа мен Фридің тағдырлы кездесуі...
Dialogue: 0,0:10:07.77,0:10:11.44,Default,,0,0,0,,Маған енді сценарий керек емес, мен импровизация жасаймын.
Dialogue: 0,0:10:15.82,0:10:19.36,Default,,0,0,0,,Мен алмаймын... Мен тым жылдам қозғаламын!
Dialogue: 0,0:10:20.03,0:10:21.95,Default,,0,0,0,,Рахмет сізге Карина!
Dialogue: 0,0:10:22.91,0:10:24.95,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:10:26.08,0:10:27.20,Default,,0,0,0,,Тегін!
Dialogue: 0,0:10:28.29,0:10:30.42,Default,,0,0,0,,Бун Бұл Джошуа Бун!
Dialogue: 0,0:10:30.96,0:10:31.96,Default,,0,0,0,,О!
Dialogue: 0,0:10:34.17,0:10:37.09,Default,,0,0,0,,Ешуа екеуің кездесуге дайын едіңдер.
Dialogue: 0,0:10:37.17,0:10:38.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:39.55,0:10:41.68,Default,,0,0,0,,Тегін!
Dialogue: 0,0:10:42.64,0:10:45.35,Default,,0,0,0,,Тағдыр!
Dialogue: 0,0:10:47.18,0:10:50.14,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:50.85,0:10:52.98,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:11:06.91,0:11:09.54,Default,,0,0,0,,Б.С.Солды жек көріп кеттіңіз бе?
Dialogue: 0,0:11:09.91,0:11:11.50,Default,,0,0,0,,Жоқ, мен оны жақсы көремін.
Dialogue: 0,0:11:12.29,0:11:14.13,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:11:14.59,0:11:16.59,Default,,0,0,0,,Онда неге аударып жатырсың?
Dialogue: 0,0:11:17.38,0:11:19.47,Default,,0,0,0,,Маған бұл туралы айтудың қажеті жоқ
Dialogue: 0,0:11:19.88,0:11:22.68,Default,,0,0,0,,Неліктен? Біз дос емеспіз бе?
Dialogue: 0,0:11:23.01,0:11:24.76,Default,,0,0,0,,Бұл қызық екен, сен.
Dialogue: 0,0:11:25.30,0:11:26.47,Default,,0,0,0,,О, қазірдің өзінде!
Dialogue: 0,0:11:27.64,0:11:29.64,Default,,0,0,0,,Маған Фри айтты
Dialogue: 0,0:11:30.02,0:11:33.52,Default,,0,0,0,,«Мен BC Солды қатты жақсы көремін, бұл тітіркендіргіш.»
Dialogue: 0,0:11:43.70,0:11:46.37,Default,,0,0,0,,Сіз оны осында пайдалана аласыз.
Dialogue: 0,0:11:49.62,0:11:50.79,Default,,0,0,0,,Иә, Терренс Т. Дерби.
Dialogue: 0,0:11:50.87,0:11:54.08,Default,,0,0,0,,Неліктен өзің жақсы көретін ұжымнан кетесің?
Dialogue: 0,0:11:54.17,0:11:56.17,Default,,0,0,0,,Мен мүлде түсінбедім
Dialogue: 0,0:11:56.25,0:11:58.17,Default,,0,0,0,,Біз бірдейміз
Dialogue: 0,0:11:58.55,0:12:02.76,Default,,0,0,0,,Мен бұл адамның сезімін түсіну мүмкін емес.
Dialogue: 0,0:12:03.01,0:12:08.06,Default,,0,0,0,,Бірақ мен неге бос болғанымды енді түсіндім деп ойлаймын.
Dialogue: 0,0:12:08.14,0:12:09.72,Default,,0,0,0,,Барт?
Dialogue: 0,0:12:12.10,0:12:15.35,Default,,0,0,0,,Мен мұнда тегін жаттықтым.
Dialogue: 0,0:12:15.69,0:12:20.69,Default,,0,0,0,,Кішкентай кезімнен мен күнде жалғызбын.
Dialogue: 0,0:12:21.32,0:12:22.45,Default,,0,0,0,,Барт…
Dialogue: 0,0:12:22.53,0:12:23.53,Default,,0,0,0,,Аники
Dialogue: 0,0:12:23.90,0:12:27.32,Default,,0,0,0,,Оның тері осы стадионға сіңеді.
Dialogue: 0,0:12:27.41,0:12:28.87,Default,,0,0,0,,Оның да ойлары
Dialogue: 0,0:12:30.33,0:12:31.75,Default,,0,0,0,,Мен оның тегін екеніне сенімдімін
Dialogue: 0,0:12:32.37,0:12:35.46,Default,,0,0,0,,БК Солды өзгертесің деп ойладым.
Dialogue: 0,0:12:35.54,0:12:36.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:36.92,0:12:39.55,Default,,0,0,0,,Мұны фрилансер жасады ма?
Dialogue: 0,0:12:40.21,0:12:43.09,Default,,0,0,0,,BC Соль шын мәнінде қайта туды.
Dialogue: 0,0:12:43.67,0:12:45.22,Default,,0,0,0,,Балто мен оның достары келді
Dialogue: 0,0:12:45.30,0:12:49.26,Default,,0,0,0,,Шаса, Риксон және басқалары да күшейуге тырысуда.
Dialogue: 0,0:12:50.06,0:12:52.98,Default,,0,0,0,,Куза мен Зоро бізге қосылып,
Dialogue: 0,0:12:53.06,0:12:54.98,Default,,0,0,0,,Енді бәрі қайтадан өзгереді.
Dialogue: 0,0:12:55.39,0:12:58.15,Default,,0,0,0,,Жаңа дәстүр туғалы тұр.
Dialogue: 0,0:12:58.23,0:12:59.61,Default,,0,0,0,,Мен сезінемін
Dialogue: 0,0:12:59.77,0:13:02.23,Default,,0,0,0,,Иә, ол үнемі өзгеріп отырады.
Dialogue: 0,0:13:02.36,0:13:04.90,Default,,0,0,0,,Сенің мұнда келгеніңе қуаныштымын, Балто.
Dialogue: 0,0:13:05.11,0:13:06.66,Default,,0,0,0,,Бұл өте қызық!
Dialogue: 0,0:13:06.74,0:13:08.07,Default,,0,0,0,,Куза
Dialogue: 0,0:13:08.16,0:13:11.29,Default,,0,0,0,,Уау, мен бұл жігітпен ойнауды тоқтата алмаймын!
Dialogue: 0,0:13:11.62,0:13:13.45,Default,,0,0,0,,Cisco О!
Dialogue: 0,0:13:14.08,0:13:18.29,Default,,0,0,0,,Мен әлі де осындамын, сондықтан мен ең мықты боламын!
Dialogue: 0,0:13:18.58,0:13:21.55,Default,,0,0,0,,Жарайды, мен де одан да күшті боламын!
Dialogue: 0,0:13:22.09,0:13:23.05,Default,,0,0,0,,Мен де!
Dialogue: 0,0:13:23.30,0:13:24.34,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:24.80,0:13:26.13,Default,,0,0,0,,Мен де!
Dialogue: 0,0:13:26.47,0:13:27.93,Default,,0,0,0,,Жанып тұрған жауынгерлік рух!
Dialogue: 0,0:13:28.01,0:13:32.10,Default,,0,0,0,,Олай болса, менің Infinite Bay стадионымда жаттығу жасайық!
Dialogue: 0,0:13:32.39,0:13:33.89,Default,,0,0,0,,Арнайы дайындық!
Dialogue: 0,0:13:33.97,0:13:35.23,Default,,0,0,0,,О!
Dialogue: 0,0:13:37.94,0:13:39.10,Default,,0,0,0,,Тегін
Dialogue: 0,0:13:39.48,0:13:42.44,Default,,0,0,0,,Бұл сіз көргіңіз келген BC Соль, солай ма?
Dialogue: 0,0:13:53.41,0:13:55.54,Default,,0,0,0,,Хаха...
Dialogue: 0,0:13:55.62,0:13:57.58,Default,,0,0,0,,Тегін Де Ла Хойя
Dialogue: 0,0:13:57.67,0:13:59.96,Default,,0,0,0,,Қандай керемет жаттығу.
Dialogue: 0,0:14:00.54,0:14:01.96,Default,,0,0,0,,Керемет!
Dialogue: 0,0:14:02.92,0:14:06.47,Default,,0,0,0,,Мен Джошуаның байсалды түрін бірінші рет көруім.
Dialogue: 0,0:14:06.55,0:14:08.30,Default,,0,0,0,,Бірақ Джошуа Фри Кимидің жанкүйері.
Dialogue: 0,0:14:11.39,0:14:12.76,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:14.60,0:14:16.81,Default,,0,0,0,,Мен сені есіме түсірдім.
Dialogue: 0,0:14:18.31,0:14:21.02,Default,,0,0,0,,Сіз өткен әлем чемпионатында 3-ші орын алдыңыз.
Dialogue: 0,0:14:21.65,0:14:23.36,Default,,0,0,0,,Бұл маған тиген жоқ.
Dialogue: 0,0:14:23.65,0:14:25.36,Default,,0,0,0,,Келесі нөмірде бірінші болыңыз
Dialogue: 0,0:14:25.73,0:14:27.53,Default,,0,0,0,,Менен жеңгіңіз келеді, солай ма?
Dialogue: 0,0:14:27.61,0:14:28.57,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:14:29.11,0:14:30.11,Default,,0,0,0,,Иә
Dialogue: 0,0:14:30.49,0:14:33.58,Default,,0,0,0,,Джошуа Нью-Йорк Буллз командасының капитаны болды.
Dialogue: 0,0:14:34.29,0:14:35.24,Default,,0,0,0,,Иә
Dialogue: 0,0:14:36.00,0:14:38.00,Default,,0,0,0,,Голливуд жұлдызы Джошуа бар
Dialogue: 0,0:14:38.08,0:14:40.17,Default,,0,0,0,,Бізде бүкіл әлемде көптеген жанкүйерлер бар.
Dialogue: 0,0:14:40.88,0:14:44.59,Default,,0,0,0,,Бірақ Джошуа сенің еркін жанкүйерің.
Dialogue: 0,0:14:47.01,0:14:49.01,Default,,0,0,0,,Сіздің артыңыздан Ешуа келді
Dialogue: 0,0:14:49.38,0:14:50.59,Default,,0,0,0,,Сізді қуып жетіңіз
Dialogue: 0,0:14:50.68,0:14:52.97,Default,,0,0,0,,Және Джошуаның арманына жету үшін
Dialogue: 0,0:14:53.72,0:14:56.68,Default,,0,0,0,,Барлығы солай дейді, бірақ мен айта алмаймын.
Dialogue: 0,0:14:57.39,0:15:00.35,Default,,0,0,0,,Егер сіз Bulls-қа келсеңіз, тегін ойындарды жақыннан көре аласыз.
Dialogue: 0,0:15:01.10,0:15:02.98,Default,,0,0,0,,Тегін туралы көбірек біліңіз
Dialogue: 0,0:15:03.31,0:15:05.65,Default,,0,0,0,,Осылайша Джошуа Нью-Йоркке келді
Dialogue: 0,0:15:06.32,0:15:08.49,Default,,0,0,0,,Бұдан былай біз бір командадамыз.
Dialogue: 0,0:15:08.78,0:15:11.41,Default,,0,0,0,,Еркін Джошуамен дос болыңыз.
Dialogue: 0,0:15:11.70,0:15:13.95,Default,,0,0,0,,Баланың бұлай айтқанына сене алар емеспін.
Dialogue: 0,0:15:14.70,0:15:15.95,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:15:16.29,0:15:17.54,Default,,0,0,0,,Э~?
Dialogue: 0,0:15:17.62,0:15:22.00,Default,,0,0,0,,Мұндағы ағым «болу» және қолды қатты қысу.
Dialogue: 0,0:15:27.13,0:15:28.51,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:15:32.09,0:15:34.76,Default,,0,0,0,,Менің артымнан жүре алсаңыз, мен сізге көмектесе аламын.
Dialogue: 0,0:15:34.85,0:15:35.80,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:15:39.10,0:15:40.89,Default,,0,0,0,,Жарайды, келіңдер!
Dialogue: 0,0:15:41.44,0:15:44.86,Default,,0,0,0,,Мәселе жоқ! бұл фильмдерде бірнеше рет жасалды.
Dialogue: 0,0:15:45.23,0:15:47.86,Default,,0,0,0,,Допты жұлып алған адам — біздің Хью Хадсон мектебінің мақтанышы —
Dialogue: 0,0:15:52.70,0:15:53.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:53.78,0:15:56.20,Default,,0,0,0,,Джошуа мен Фри енді дос!
Dialogue: 0,0:15:58.58,0:16:00.00,Default,,0,0,0,,Ахаха
Dialogue: 0,0:16:00.08,0:16:02.21,Default,,0,0,0,,Керемет!
Dialogue: 0,0:16:03.04,0:16:06.88,Default,,0,0,0,,Біз енді Джошуа мен Фри арасындағы текетірес сахнасын шығаруды бастаймыз.
Dialogue: 0,0:16:09.67,0:16:13.22,Default,,0,0,0,,Тегін Мен өсек тыңдаймын. Маған қолмен иілген соққыны көрсетіңіз.
Dialogue: 0,0:16:13.68,0:16:14.68,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:15.18,0:16:17.47,Default,,0,0,0,,Джошуа фрилансерлерге нұсқаулар беріп жатыр ма?
Dialogue: 0,0:16:17.55,0:16:20.85,Default,,0,0,0,,Не болғанын білмеймін, бірақ бұл жақсы үрдіс сияқты.
Dialogue: 0,0:16:21.35,0:16:24.35,Default,,0,0,0,,Иә! Камераның күту режимі жақсы ма?
Dialogue: 0,0:16:24.69,0:16:25.85,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:16:26.19,0:16:28.32,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:16:28.77,0:16:30.86,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:16:34.70,0:16:38.03,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:38.24,0:16:40.87,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:41.62,0:16:43.21,Default,,0,0,0,,(Тыныш қону дыбысы)
Dialogue: 0,0:16:49.09,0:16:50.80,Default,,0,0,0,,Алып өтіңіз, данышпан!
Dialogue: 0,0:17:02.31,0:17:04.31,Default,,0,0,0,,Бұл Fafnir төгу
Dialogue: 0,0:17:04.89,0:17:06.35,Default,,0,0,0,,Резеңке қабаты
Dialogue: 0,0:17:06.44,0:17:09.31,Default,,0,0,0,,Ол сөзсіз Генийдің күшін бойына сіңірді.
Dialogue: 0,0:17:09.40,0:17:10.57,Default,,0,0,0,,Керемет
Dialogue: 0,0:17:15.11,0:17:17.20,Default,,0,0,0,,Циклон қабырғасы
Dialogue: 0,0:17:17.66,0:17:19.95,Default,,0,0,0,,Кел, данышпан! (Саусақтарды сермеу дыбысы)
Dialogue: 0,0:17:21.20,0:17:23.83,Default,,0,0,0,,(түтіннің үрлеу дыбысы)
Dialogue: 0,0:17:33.63,0:17:35.30,Default,,0,0,0,,Сен жындысың, Фафнир
Dialogue: 0,0:17:35.92,0:17:38.05,Default,,0,0,0,,(көтерілген жалын дыбысы)
Dialogue: 0,0:17:40.05,0:17:41.97,Default,,0,0,0,,(үру)
Dialogue: 0,0:17:56.07,0:17:59.36,Default,,0,0,0,,Циклонның қабырғасы толығымен жойылды!
Dialogue: 0,0:18:00.20,0:18:03.45,Default,,0,0,0,,Мен құптайтын еркін адам күткендей!
Dialogue: 0,0:18:03.79,0:18:06.41,Default,,0,0,0,,Джошуа ең жақсы!
Dialogue: 0,0:18:06.83,0:18:09.96,Default,,0,0,0,,Батыр бір рет жеңіледі, бірақ әрқашан орнынан тұрады.
Dialogue: 0,0:18:10.21,0:18:12.50,Default,,0,0,0,,Джошуа Бун ешқашан берілмейді
Dialogue: 0,0:18:12.75,0:18:14.88,Default,,0,0,0,,Сізге ең жақсы қарсылас!
Dialogue: 0,0:18:14.96,0:18:17.38,Default,,0,0,0,,Джошуа сені жеңеді!
Dialogue: 0,0:18:17.51,0:18:20.22,Default,,0,0,0,,Қарсыласыңызға біріншісін алуға рұқсат бересіз бе?
Dialogue: 0,0:18:20.30,0:18:21.93,Default,,0,0,0,,А... Түсіндің бе?
Dialogue: 0,0:18:22.39,0:18:24.22,Default,,0,0,0,,Бұл қызық, сен.
Dialogue: 0,0:18:25.02,0:18:26.27,Default,,0,0,0,,Онда, мені басып өтіп, алға жүріңіз.
Dialogue: 0,0:18:29.65,0:18:32.61,Default,,0,0,0,,Курт! Сацуэй бүгін бітті!
Dialogue: 0,0:18:33.02,0:18:36.94,Default,,0,0,0,,Тегін күтіңіз, түскі асты бірге ішейік.
Dialogue: 0,0:18:37.95,0:18:39.57,Default,,0,0,0,,Хмм, бұл менің таңдауым.
Dialogue: 0,0:18:39.66,0:18:41.78,Default,,0,0,0,,Түскі асымызды да ішейік.
Dialogue: 0,0:18:41.87,0:18:43.45,Default,,0,0,0,,А...
Dialogue: 0,0:18:47.04,0:18:50.21,Default,,0,0,0,,Не болды? Маған жауап бер, Боа.
Dialogue: 0,0:18:50.29,0:18:52.46,Default,,0,0,0,,Қызыл көз жоқ кезде
Dialogue: 0,0:18:52.54,0:18:57.21,Default,,0,0,0,,Шака мен Рувей атты екі жүзік келді...
Dialogue: 0,0:18:57.80,0:18:59.34,Default,,0,0,0,,Сіз жеңілдім дейсіз бе?
Dialogue: 0,0:19:01.39,0:19:02.59,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:02.68,0:19:03.93,Default,,0,0,0,,Шака -
Dialogue: 0,0:19:04.01,0:19:08.06,Default,,0,0,0,,Мен Зиг Экскалибур деп аталатын күлкілі шығанақты қолдандым.
Dialogue: 0,0:19:08.14,0:19:10.60,Default,,0,0,0,,Қызыл көз болса, ұтылмас едік...
Dialogue: 0,0:19:10.77,0:19:12.02,Default,,0,0,0,,Қызыл көз?
Dialogue: 0,0:19:12.15,0:19:15.40,Default,,0,0,0,,Мақсатымды орындауға барамын
Dialogue: 0,0:19:15.48,0:19:17.07,Default,,0,0,0,,Мұны ашрамға айт.
Dialogue: 0,0:19:17.15,0:19:18.24,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:18.82,0:19:20.32,Default,,0,0,0,,Біз тағы кездесеміз, солай ма?
Dialogue: 0,0:19:22.91,0:19:25.24,Default,,0,0,0,,Қызыл Ай! !
Dialogue: 0,0:19:27.70,0:19:30.08,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:19:30.16,0:19:33.63,Default,,0,0,0,,Дүниежүзілік лига ақыры басталады!
Dialogue: 0,0:19:33.71,0:19:37.55,Default,,0,0,0,,Осы жерден Нью-Йорк Бэй Аренасында сенор Аннами...
Dialogue: 0,0:19:37.63,0:19:40.59,Default,,0,0,0,,Дүние жүзіндегі Beiblade жанкүйерлеріне жіберілді
Dialogue: 0,0:19:40.72,0:19:43.51,Default,,0,0,0,,Ашылу туралы мәлімдемені Нью-Йорк Буллс клубының иесі жасады.
Dialogue: 0,0:19:43.59,0:19:46.89,Default,,0,0,0,,Бұл Александр Гилтен!
Dialogue: 0,0:19:47.47,0:19:50.23,Default,,0,0,0,,Бейблейдті жақсы көретін дүние жүзіндегі барлық адамдар
Dialogue: 0,0:19:50.31,0:19:55.65,Default,,0,0,0,,Осы арқылы біз wbba.Beyblade Дүниежүзілік лигасының ашылғанын жариялаймыз.
Dialogue: 0,0:19:56.40,0:19:58.61,Default,,0,0,0,,(Конфетти түсіру дыбысы)
Dialogue: 0,0:20:00.49,0:20:03.82,Default,,0,0,0,,Енді, Нью-Йорк Буллз осында!
Dialogue: 0,0:20:04.24,0:20:08.37,Default,,0,0,0,,Дүниежүзілік рейтингте сөзсіз бірінші нөмірлі Фри Де Ла Хойя -
Dialogue: 0,0:20:08.45,0:20:12.87,Default,,0,0,0,,Голливуд жұлдызы және үлкен бестіктің бірі Джошуа Бун қосылды.
Dialogue: 0,0:20:12.96,0:20:16.38,Default,,0,0,0,,Бұқалар әлемдегі ең күштілер ретінде тез өсті.
Dialogue: 0,0:20:16.46,0:20:20.92,Default,,0,0,0,,Оны соққан сойыл шығады ма? Қарсы...
Dialogue: 0,0:20:21.01,0:20:25.72,Default,,0,0,0,,Airox Австралиядан келді!
Dialogue: 0,0:20:30.52,0:20:32.94,Default,,0,0,0,,Бұл жұмыс істеді! Секундтарда өлтіріңіз!
Dialogue: 0,0:20:33.02,0:20:35.90,Default,,0,0,0,,Blast Genius Burst Finish!
Dialogue: 0,0:20:36.27,0:20:38.65,Default,,0,0,0,,Джошуа Бұл керемет!
Dialogue: 0,0:20:38.73,0:20:40.61,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:40.69,0:20:44.57,Default,,0,0,0,,Тегін Де Ла Хойя да көрінбей-ақ, 3:0 есебімен керемет жеңіс!
Dialogue: 0,0:20:44.66,0:20:46.95,Default,,0,0,0,,Bulls бірінші раундтан өтті!
Dialogue: 0,0:20:47.32,0:20:49.66,Default,,0,0,0,,Мен Check Free көргім келді.
Dialogue: 0,0:20:52.08,0:20:56.88,Default,,0,0,0,,Тегін Біз міндетті түрде жеңіп, сенің орныңа барамыз.
Dialogue: 0,0:20:57.46,0:20:58.96,Default,,0,0,0,,Фофофу
Dialogue: 0,0:20:59.71,0:21:01.51,Default,,0,0,0,,Уақыт келді.
Dialogue: 0,0:21:01.76,0:21:03.80,Default,,0,0,0,,Жарайды! Бірінші айналым -
Dialogue: 0,0:21:03.88,0:21:07.55,Default,,0,0,0,,Бұл бүкіл әлем бойынша стадиондарда бір уақытта болып жатыр!
Dialogue: 0,0:21:07.64,0:21:09.89,Default,,0,0,0,,Ал Эль-Сантода —
Dialogue: 0,0:21:09.97,0:21:15.19,Default,,0,0,0,,BC Соль Испаниядан және Аргентинадан Tangorhythms!
Dialogue: 0,0:21:15.27,0:21:17.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:18.11,0:21:21.98,Default,,0,0,0,,Енді бірінші жүзік BC Sol Balt Aoi.
Dialogue: 0,0:21:22.07,0:21:25.20,Default,,0,0,0,,Tangorhythms тобынан Лионель Меча!
Dialogue: 0,0:21:25.61,0:21:27.36,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:21:28.53,0:21:32.08,Default,,0,0,0,,Дүние жүзіндегі ұлдар мен қыздар назар аударады
Dialogue: 0,0:21:32.16,0:21:34.79,Default,,0,0,0,,Клуб командасы келесі деңгейге өтеді! ?
Dialogue: 0,0:21:34.87,0:21:39.21,Default,,0,0,0,,Ал әлемнің мықтысы атағын кім алады?
Dialogue: 0,0:21:39.29,0:21:44.01,Default,,0,0,0,,Келіңіздер, бәріңіз! Бірге кері санақ жасайық!
Dialogue: 0,0:21:44.42,0:21:46.97,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:21:47.26,0:21:49.80,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:21:51.01,0:21:53.39,Default,,0,0,0,,Жүр!
Dialogue: 0,0:21:55.98,0:21:58.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.52,0:22:01.94,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:02.02,0:22:04.82,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.90,0:22:07.03,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.11,0:22:10.70,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.78,0:22:14.41,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.49,0:22:16.16,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.25,0:22:18.04,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.12,0:22:19.92,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:20.00,0:22:21.54,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.63,0:22:23.59,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.67,0:22:26.13,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.21,0:22:29.09,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.18,0:22:32.80,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.89,0:22:36.60,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.68,0:22:38.31,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.39,0:22:41.52,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.61,0:22:44.02,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.11,0:22:47.53,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.61,0:22:51.07,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.16,0:22:53.20,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.28,0:22:54.99,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.08,0:22:58.50,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.58,0:23:00.42,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.50,0:23:03.63,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.71,0:23:05.92,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:06.00,0:23:09.88,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.97,0:23:13.55,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.64,0:23:17.10,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.18,0:23:20.52,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.60,0:23:22.23,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:20.60,0:23:22.23,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.23,0:23:22.31,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.31,0:23:25.19,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.31,0:23:25.19,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.19,0:23:25.57,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.53,0:23:29.40,Default,,0,0,0,,Маған Бразилиядағы Шакадан хат келді.
Dialogue: 0,0:23:29.49,0:23:31.86,Default,,0,0,0,,Смартфоныңыз жоқ сияқты.
Dialogue: 0,0:23:32.32,0:23:35.78,Default,,0,0,0,,Үлкен 5-тен Лувеймен кездесіп, 100 адамдық шайқас өткізіңіз! ?
Dialogue: 0,0:23:35.95,0:23:37.91,Default,,0,0,0,,Бұл керемет болады!
Dialogue: 0,0:23:37.99,0:23:40.96,Default,,0,0,0,,Шака, сенімен шайқас.
Dialogue: 0,0:23:41.16,0:23:43.63,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.71,0:23:46.38,Default,,0,0,0,,Соғыс қылыш! Сиг Экскалибур!
Dialogue: 0,0:23:46.46,0:23:50.17,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.67,0:23:57.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory