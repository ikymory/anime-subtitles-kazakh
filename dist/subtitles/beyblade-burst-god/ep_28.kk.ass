Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.54,0:00:07.17,Default,,0,0,0,,wbba әлемдік лигасы
Dialogue: 0,0:00:07.71,0:00:09.88,Default,,0,0,0,,Әр лигада жеңіске жеткен клубтар...
Dialogue: 0,0:00:10.17,0:00:12.84,Default,,0,0,0,,Әлемнің шыңына қарай шайқас
Dialogue: 0,0:00:13.09,0:00:14.55,Default,,0,0,0,,Чемпион болуды мақсат етіңіз
Dialogue: 0,0:00:14.84,0:00:16.51,Default,,0,0,0,,Қолға алу үшін бірінші нөмір
Dialogue: 0,0:00:16.97,0:00:18.51,Default,,0,0,0,,Жауынгерлік рухыңызды өртеп жіберіңіз
Dialogue: 0,0:00:18.60,0:00:20.27,Default,,0,0,0,,Және шектен шығу
Dialogue: 0,0:00:20.97,0:00:22.43,Default,,0,0,0,,Жалынды жандардың шайқасы
Dialogue: 0,0:00:22.81,0:00:24.98,Default,,0,0,0,,Дүниені отқа сал
Dialogue: 0,0:00:25.81,0:00:27.27,Default,,0,0,0,,Даңққа кім ие болады?
Dialogue: 0,0:00:27.94,0:00:29.19,Default,,0,0,0,,Бұл – тура қызыл карта. (Бакуго) Тс.
Dialogue: 0,0:00:41.95,0:00:43.83,Default,,0,0,0,,Жасайық, Куза...
Dialogue: 0,0:00:44.12,0:00:46.54,Default,,0,0,0,,Сіз қабірлерден қорқасыз ба? Балтық
Dialogue: 0,0:00:46.67,0:00:48.50,Default,,0,0,0,,Сіз таңқаларлық қорқыныштысыз.
Dialogue: 0,0:00:48.59,0:00:49.59,Default,,0,0,0,,Нандана
Dialogue: 0,0:00:49.92,0:00:51.34,Default,,0,0,0,,Эй, мен қорықпаймын!
Dialogue: 0,0:00:51.63,0:00:52.34,Default,,0,0,0,,О!
Dialogue: 0,0:00:52.59,0:00:53.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:54.72,0:00:55.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:55.51,0:00:57.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:57.39,0:00:59.51,Default,,0,0,0,,Құза да қорқынышты емес пе?
Dialogue: 0,0:00:59.60,0:01:00.26,Default,,0,0,0,,Балто!
Dialogue: 0,0:01:00.81,0:01:01.93,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:01:02.35,0:01:03.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:06.06,0:01:06.81,Default,,0,0,0,,(айқай)
Dialogue: 0,0:01:07.77,0:01:08.56,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:01:09.73,0:01:10.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:14.57,0:01:15.24,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:01:15.95,0:01:17.24,Default,,0,0,0,,иә
Dialogue: 0,0:01:17.32,0:01:18.82,Default,,0,0,0,,Мен қараңғылық періштемін
Dialogue: 0,0:01:19.57,0:01:20.83,Default,,0,0,0,,Сіздің қаныңыз
Dialogue: 0,0:01:21.87,0:01:23.75,Default,,0,0,0,,Мен итадаки жеуге келдім.
Dialogue: 0,0:01:25.29,0:01:27.29,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:01:28.67,0:01:29.83,Default,,0,0,0,,(Ағаш айқайы)
Dialogue: 0,0:01:31.96,0:01:33.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:34.67,0:01:36.67,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:36.93,0:01:38.84,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:01:40.51,0:01:42.43,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:01:43.01,0:01:45.77,Default,,0,0,0,,Балт пен Куза жартылай ұйықтап жатыр.
Dialogue: 0,0:01:46.18,0:01:47.44,Default,,0,0,0,,Бұл тітіркендіргіш
Dialogue: 0,0:01:47.94,0:01:49.60,Default,,0,0,0,,(Екі ыңылдаған дауыс)
Dialogue: 0,0:01:49.77,0:01:52.98,Default,,0,0,0,,Жапониядағы «Реал» мен «Риос» кездесуін тамашаладық.
Dialogue: 0,0:01:53.27,0:01:55.53,Default,,0,0,0,,Вакияның ұшағымен Парижге ұшты.
Dialogue: 0,0:01:55.99,0:01:57.99,Default,,0,0,0,,Келесіде Динаның матчы!
Dialogue: 0,0:02:14.46,0:02:18.13,Default,,0,0,0,,Тіпті таңертеңгі жарқылмен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:19.09,0:02:21.43,Default,,0,0,0,,Бір жерден естіген дыбыс
Dialogue: 0,0:02:21.51,0:02:23.85,Default,,0,0,0,,Бұл шығанақтың соқтығысуы.
Dialogue: 0,0:02:23.93,0:02:28.27,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:28.94,0:02:33.69,Default,,0,0,0,,Жалынды жүрек ұйықтамайды, Майданға құмар.
Dialogue: 0,0:02:33.77,0:02:38.70,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:38.78,0:02:43.66,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:43.74,0:02:48.79,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:48.87,0:02:52.08,Default,,0,0,0,,Қазір ат!
Dialogue: 0,0:02:52.17,0:02:54.21,Default,,0,0,0,,(Үш екі бір ату!)
Dialogue: 0,0:02:54.29,0:02:56.21,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:56.30,0:02:58.46,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:58.55,0:03:03.47,Default,,0,0,0,,Маған бұрын ешқашан көрмеген шайқасты көрсетіңіз
Dialogue: 0,0:03:03.55,0:03:06.31,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:03:06.39,0:03:12.31,Default,,0,0,0,,Әріптесіңізбен үнемі дамып келе жатқан байланыс және дірілдеген жүрек соғысы
Dialogue: 0,0:03:12.40,0:03:16.90,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз.
Dialogue: 0,0:03:16.98,0:03:18.99,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:30.33,0:03:32.33,Default,,0,0,0,,Вампир! Терең хаос! !
Dialogue: 0,0:03:37.34,0:03:40.05,Default,,0,0,0,,Балалар сендер қорқынышты көрінесіңдер.
Dialogue: 0,0:03:40.13,0:03:42.13,Default,,0,0,0,,Мен қорқамын...
Dialogue: 0,0:03:42.43,0:03:44.59,Default,,0,0,0,,Мен қорқынышты түс көрдім...
Dialogue: 0,0:03:44.68,0:03:45.55,Default,,0,0,0,,Дар
Dialogue: 0,0:03:45.64,0:03:47.26,Default,,0,0,0,,Не, бұл арман?
Dialogue: 0,0:03:47.35,0:03:49.02,Default,,0,0,0,,Мен ақымақпын.
Dialogue: 0,0:03:49.56,0:03:50.77,Default,,0,0,0,,Өйткені, өйткені
Dialogue: 0,0:03:50.85,0:03:54.69,Default,,0,0,0,,Менің қанымды осындай жүзді вампир сорды
Dialogue: 0,0:03:54.77,0:03:58.27,Default,,0,0,0,,Мені кепкен мумияға айналдырды.
Dialogue: 0,0:03:58.57,0:04:00.53,Default,,0,0,0,,Мен қатты қорықтым...
Dialogue: 0,0:04:00.61,0:04:02.61,Default,,0,0,0,,Куза, менің қанымды сорып жатыр.
Dialogue: 0,0:04:02.70,0:04:04.24,Default,,0,0,0,,Мен оған қарап тұрдым.
Dialogue: 0,0:04:04.41,0:04:04.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:05.16,0:04:05.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:05.82,0:04:07.66,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:04:07.83,0:04:08.99,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:04:09.08,0:04:10.25,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:10.79,0:04:12.00,Default,,0,0,0,,Біз-
Dialogue: 0,0:04:12.08,0:04:14.50,Default,,0,0,0,,Біздің арманымыз бір болған!
Dialogue: 0,0:04:14.96,0:04:18.13,Default,,0,0,0,,Ей, сирек кездесетін нәрселер бар.
Dialogue: 0,0:04:18.38,0:04:20.84,Default,,0,0,0,,Мен де сол арманымды көргім келді~
Dialogue: 0,0:04:20.92,0:04:23.34,Default,,0,0,0,,Мен қорқынышты фильмдерді жақсы көремін.
Dialogue: 0,0:04:23.80,0:04:26.09,Default,,0,0,0,,Мен қатты қорықтым.
Dialogue: 0,0:04:26.22,0:04:28.60,Default,,0,0,0,,Мен ең көп кездескім келетін адам пайда болды.
Dialogue: 0,0:04:28.68,0:04:29.72,Default,,0,0,0,,Киташи!
Dialogue: 0,0:04:30.27,0:04:32.77,Default,,0,0,0,,Сәлем! Бұл вампир болсын, зомби болсын...
Dialogue: 0,0:04:32.85,0:04:35.14,Default,,0,0,0,,Кумичо-сама сені ұшырып жібереді!
Dialogue: 0,0:04:36.10,0:04:37.81,Default,,0,0,0,,Бұл бәрібір арман ғой, солай ма? Бұл қоқыс
Dialogue: 0,0:04:37.90,0:04:38.65,Default,,0,0,0,,Ки!
Dialogue: 0,0:04:38.90,0:04:42.15,Default,,0,0,0,,Cisco, сізде марон жоқ.
Dialogue: 0,0:04:42.24,0:04:44.95,Default,,0,0,0,,Жоқ, жоқ, марон жоқ.
Dialogue: 0,0:04:45.03,0:04:47.03,Default,,0,0,0,,Егер сіз оны осылай атағыңыз келсе, бұл романтикалық.
Dialogue: 0,0:04:47.57,0:04:48.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:48.24,0:04:50.08,Default,,0,0,0,,Марон - каштан
Dialogue: 0,0:04:50.62,0:04:52.45,Default,,0,0,0,,Әй, маррон же!
Dialogue: 0,0:04:52.54,0:04:53.58,Default,,0,0,0,,Мен де~
Dialogue: 0,0:04:55.75,0:04:57.17,Default,,0,0,0,,Сіз Париждесіз бе?
Dialogue: 0,0:04:57.75,0:04:59.63,Default,,0,0,0,,Балто мен оның достарына
Dialogue: 0,0:04:59.71,0:05:01.80,Default,,0,0,0,,Сен маған Париждегі матчты көрсеттің деп ойладым.
Dialogue: 0,0:05:02.17,0:05:03.09,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:05:03.38,0:05:06.59,Default,,0,0,0,,Сен Париждесің ғой, солай ма?
Dialogue: 0,0:05:06.80,0:05:07.72,Default,,0,0,0,,Балалар
Dialogue: 0,0:05:07.97,0:05:09.85,Default,,0,0,0,,Қазір Париж Блэдерс-
Dialogue: 0,0:05:09.93,0:05:11.47,Default,,0,0,0,,Матч өтетін жерге барыңыз
Dialogue: 0,0:05:11.56,0:05:13.22,Default,,0,0,0,,Жарайсың ба? Крис~
Dialogue: 0,0:05:13.31,0:05:13.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:14.27,0:05:17.06,Default,,0,0,0,,Мен Paris Blades ойынын тікелей эфирде көргім келеді.
Dialogue: 0,0:05:18.15,0:05:21.52,Default,,0,0,0,,Сіз Дина Курокамиді қолдағыңыз келеді, солай ма?
Dialogue: 0,0:05:21.82,0:05:23.32,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:05:23.53,0:05:25.11,Default,,0,0,0,,Білдің бе?
Dialogue: 0,0:05:25.32,0:05:26.57,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:05:26.86,0:05:28.32,Default,,0,0,0,,Жарайды, келіңіз.
Dialogue: 0,0:05:29.95,0:05:32.83,Default,,0,0,0,,Париждің қарсыласы Португалияның BC Галлеон командасы
Dialogue: 0,0:05:34.45,0:05:37.00,Default,,0,0,0,,Балалар сендер бұған дейін тура ойындарда жеңіліп қалған мықтыларсыңдар.
Dialogue: 0,0:05:39.42,0:05:42.88,Default,,0,0,0,,Парижде жаңа Blader бар сияқты.
Dialogue: 0,0:05:42.96,0:05:44.84,Default,,0,0,0,,Мен сізге деректерді жіберемін.
Dialogue: 0,0:05:45.26,0:05:47.93,Default,,0,0,0,,Терең хаос шығанақтарды пайдаланады.
Dialogue: 0,0:05:48.59,0:05:49.64,Default,,0,0,0,,Маған Риппл тиді, Жура!
Dialogue: 0,0:05:49.84,0:05:51.10,Default,,0,0,0,,Терең хаос…
Dialogue: 0,0:05:51.76,0:05:53.77,Default,,0,0,0,,Азу тістері өсіп келе жатқан сияқты.
Dialogue: 0,0:05:53.89,0:05:55.31,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:05:55.39,0:05:58.60,Default,,0,0,0,,Бұл төзімділік түрі және көтергіш қабаты бар.
Dialogue: 0,0:05:59.06,0:06:00.52,Default,,0,0,0,,Қабатты көтеру керек пе?
Dialogue: 0,0:06:00.61,0:06:03.61,Default,,0,0,0,,Бүкіл сыртқы жүзді жоғары және төмен жылжыту арқылы...
Dialogue: 0,0:06:04.32,0:06:07.07,Default,,0,0,0,,Қарсыластың шыдамдылығын бірте-бірте төмендетеді.
Dialogue: 0,0:06:07.40,0:06:10.57,Default,,0,0,0,,Азу тістері қайта өсіп, вампирге ұқсайды.
Dialogue: 0,0:06:10.99,0:06:12.53,Default,,0,0,0,,Вампир…
Dialogue: 0,0:06:12.62,0:06:15.04,Default,,0,0,0,,Қосымша осы подшипниктің драйвері
Dialogue: 0,0:06:15.41,0:06:17.87,Default,,0,0,0,,Білік ұшының барлығы еркін айналады.
Dialogue: 0,0:06:17.96,0:06:20.83,Default,,0,0,0,,Подшипник – шарикті подшипник.
Dialogue: 0,0:06:20.92,0:06:24.09,Default,,0,0,0,,Бұл кедергісі () минимумға дейін төмендеген драйвер.
Dialogue: 0,0:06:24.71,0:06:28.34,Default,,0,0,0,,Қарсыласыңызды әлсіретіп, аман қаласыз ба?
Dialogue: 0,0:06:28.80,0:06:29.84,Default,,0,0,0,,Және бұл
Dialogue: 0,0:06:29.93,0:06:31.72,Default,,0,0,0,,Терең хаосты пайдаланатын Blader
Dialogue: 0,0:06:32.26,0:06:34.06,Default,,0,0,0,,Clio Doron және
Dialogue: 0,0:06:34.56,0:06:35.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:36.14,0:06:38.81,Default,,0,0,0,,Менің түсімдегі вампирге ұқсайды
Dialogue: 0,0:06:38.89,0:06:39.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:40.02,0:06:40.85,Default,,0,0,0,,Clio…
Dialogue: 0,0:06:42.15,0:06:44.15,Default,,0,0,0,,Мен түсемін. Мен түсемін!
Dialogue: 0,0:06:45.65,0:06:47.57,Default,,0,0,0,,Эй, мен бармаймын!
Dialogue: 0,0:06:47.65,0:06:48.78,Default,,0,0,0,,Синара~
Dialogue: 0,0:06:48.86,0:06:49.49,Default,,0,0,0,,Сәлем Куза
Dialogue: 0,0:06:50.32,0:06:51.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:51.61,0:06:53.62,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:06:53.74,0:06:55.16,Default,,0,0,0,,Сіз қорқып кеттіңіз...
Dialogue: 0,0:06:55.33,0:06:58.62,Default,,0,0,0,,Матч өтетін орын осында қалды, сонда не болып жатыр?
Dialogue: 0,0:06:59.12,0:07:00.67,Default,,0,0,0,,Ол жігітті жайына қалдырыңыз.
Dialogue: 0,0:07:01.25,0:07:03.29,Default,,0,0,0,,Мен Кузаны әкелемін.
Dialogue: 0,0:07:04.46,0:07:06.09,Default,,0,0,0,,Хмм...иә
Dialogue: 0,0:07:07.05,0:07:07.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:11.34,0:07:13.68,Default,,0,0,0,,Неліктен Clio Парижде?
Dialogue: 0,0:07:14.68,0:07:16.81,Default,,0,0,0,,А... Мен тоңып тұрмын.
Dialogue: 0,0:07:17.52,0:07:19.06,Default,,0,0,0,,(бастағы дыбыс)
Dialogue: 0,0:07:19.18,0:07:20.48,Default,,0,0,0,,Ой~!
Dialogue: 0,0:07:20.56,0:07:21.77,Default,,0,0,0,,Балалар, жоғалып кетіңдер!
Dialogue: 0,0:07:22.19,0:07:22.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:23.44,0:07:25.44,Default,,0,0,0,,Куза
Dialogue: 0,0:07:26.27,0:07:27.19,Default,,0,0,0,,Куза!
Dialogue: 0,0:07:27.53,0:07:28.32,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:07:28.40,0:07:29.32,Default,,0,0,0,,Ах~
Dialogue: 0,0:07:29.40,0:07:30.57,Default,,0,0,0,,(бұталарға құлаған дыбыс)
Dialogue: 0,0:07:33.74,0:07:36.20,Default,,0,0,0,,Сенің келе жатқаныңды сездім.
Dialogue: 0,0:07:37.03,0:07:39.95,Default,,0,0,0,,Менімен соғысу үшін келдің бе?
Dialogue: 0,0:07:40.54,0:07:41.71,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:07:42.29,0:07:46.00,Default,,0,0,0,,Күресейік, тағдырлас досым!
Dialogue: 0,0:07:46.88,0:07:47.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:53.80,0:07:55.05,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,0:07:56.26,0:08:01.23,Default,,0,0,0,,Сені қайта көргенде жүрегім дірілдейді!
Dialogue: 0,0:08:02.52,0:08:04.94,Default,,0,0,0,,Енді шығанақта күресетін кез келді!
Dialogue: 0,0:08:05.40,0:08:07.11,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:08:07.44,0:08:08.02,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:08:09.32,0:08:10.49,Default,,0,0,0,,Дене-
Dialogue: 0,0:08:11.53,0:08:12.70,Default,,0,0,0,,Өздігінен қозғалады!
Dialogue: 0,0:08:13.28,0:08:14.82,Default,,0,0,0,,Хехе...
Dialogue: 0,0:08:15.32,0:08:16.99,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:08:17.33,0:08:18.33,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:08:18.83,0:08:19.83,Default,,0,0,0,,Соңғы кездері осы қонақүйдің сапасы сәл төмендеген сияқты…
Dialogue: 0,0:08:19.91,0:08:21.70,Default,,0,0,0,,Бұл Клио Дорон емес пе?
Dialogue: 0,0:08:21.95,0:08:24.83,Default,,0,0,0,,Сен мені тағы да қарғадың ба?
Dialogue: 0,0:08:25.54,0:08:26.54,Default,,0,0,0,,Қарғыс?
Dialogue: 0,0:08:27.42,0:08:29.42,Default,,0,0,0,,Бұл Clio емес пе?
Dialogue: 0,0:08:29.71,0:08:30.96,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:08:31.55,0:08:33.84,Default,,0,0,0,,Хехехе...қарғыс емес
Dialogue: 0,0:08:34.05,0:08:36.30,Default,,0,0,0,,Сіздің қуық инстинкті...
Dialogue: 0,0:08:36.39,0:08:38.14,Default,,0,0,0,,Сіз денеңізді қозғалтасыз.
Dialogue: 0,0:08:38.89,0:08:40.43,Default,,0,0,0,,Енді бастайық
Dialogue: 0,0:08:41.52,0:08:43.43,Default,,0,0,0,,Қарғыс атсын... Мен мұны істеуім керек.
Dialogue: 0,0:08:44.39,0:08:46.65,Default,,0,0,0,,Содан кейін... режимді өзгерту.
Dialogue: 0,0:08:47.10,0:08:50.40,Default,,0,0,0,,Өте төзімділік режимінде серпілу!
Dialogue: 0,0:08:51.40,0:08:54.95,Default,,0,0,0,,Еш ойланбастан Кроностың қанын сорайын.
Dialogue: 0,0:08:55.78,0:08:56.70,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:08:56.95,0:09:00.45,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:00.74,0:09:02.04,Default,,0,0,0,,Бару…
Dialogue: 0,0:09:02.12,0:09:03.00,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:09:03.54,0:09:04.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:07.71,0:09:09.42,Default,,0,0,0,,Атысты көтеріңіз!
Dialogue: 0,0:09:13.92,0:09:16.30,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:09:17.55,0:09:19.22,Default,,0,0,0,,Вампир азулары...
Dialogue: 0,0:09:19.35,0:09:20.30,Default,,0,0,0,,Жеді!
Dialogue: 0,0:09:21.47,0:09:22.81,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:09:23.39,0:09:25.06,Default,,0,0,0,,Сорыңыз, терең хаос!
Dialogue: 0,0:09:25.14,0:09:28.40,Default,,0,0,0,,(Соқтығыс дыбыстар тізбегі)
Dialogue: 0,0:09:32.40,0:09:33.53,Default,,0,0,0,,(Зеницу) Незуко-чан, Танжиро~ (Танжиро) Тоқтат! Зенцу!
Dialogue: 0,0:09:34.19,0:09:36.70,Default,,0,0,0,,Тамақ бергеніңізге рахмет, хехехе...
Dialogue: 0,0:09:37.32,0:09:38.82,Default,,0,0,0,,Куза жоғалды...
Dialogue: 0,0:09:38.91,0:09:40.99,Default,,0,0,0,,Ол қорқынышты жігіт, Клио.
Dialogue: 0,0:09:41.08,0:09:42.45,Default,,0,0,0,,Мынау
Dialogue: 0,0:09:42.79,0:09:44.66,Default,,0,0,0,,Кузаның достары?
Dialogue: 0,0:09:45.20,0:09:46.00,Default,,0,0,0,,Жаман адамдар жоқ, және бұл оның басқа ерліктерімен салыстырғанда біршама қарапайым—
Dialogue: 0,0:09:46.08,0:09:49.13,Default,,0,0,0,,Мен Динчоға сәлем беруім керек, бірақ...
Dialogue: 0,0:09:49.63,0:09:53.55,Default,,0,0,0,,Менің шұғыл жұмысым бар, кешіріңіз.
Dialogue: 0,0:09:53.88,0:09:55.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:55.67,0:09:57.05,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:09:59.01,0:09:59.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:00.01,0:10:01.30,Default,,0,0,0,,Жоғалып кетті
Dialogue: 0,0:10:02.35,0:10:04.27,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:04.60,0:10:06.39,Default,,0,0,0,,Ол шынымен вампир...
Dialogue: 0,0:10:06.48,0:10:08.10,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:10:08.19,0:10:09.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:09.10,0:10:09.73,Default,,0,0,0,,Куза!
Dialogue: 0,0:10:10.86,0:10:11.69,Default,,0,0,0,,Қарғыс атқан
Dialogue: 0,0:10:11.77,0:10:12.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:14.90,0:10:16.07,Default,,0,0,0,,Қарғыс!
Dialogue: 0,0:10:17.57,0:10:18.61,Default,,0,0,0,,Noroider!
Dialogue: 0,0:10:21.53,0:10:22.53,Default,,0,0,0,,Эйлер
Dialogue: 0,0:10:23.20,0:10:25.04,Default,,0,0,0,,Мен Clio-ны көптен бері білемін.
Dialogue: 0,0:10:26.41,0:10:28.83,Default,,0,0,0,,Сиқырды қолдана алады.
Dialogue: 0,0:10:32.38,0:10:35.05,Default,,0,0,0,,Куза, ішке кір.
Dialogue: 0,0:10:35.21,0:10:37.34,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:10:37.80,0:10:39.13,Default,,0,0,0,,Мен кірдім бе?
Dialogue: 0,0:10:39.43,0:10:40.97,Default,,0,0,0,,Сіз не істемексіз? Ах!
Dialogue: 0,0:10:41.05,0:10:43.64,Default,,0,0,0,,А... не? Мені шығарыңыз!
Dialogue: 0,0:10:43.97,0:10:44.68,Default,,0,0,0,,(жарық дыбысы)
Dialogue: 0,0:10:44.76,0:10:46.14,Default,,0,0,0,,Бұдан былай сізге.
Dialogue: 0,0:10:46.22,0:10:48.39,Default,,0,0,0,,Адамның дене жарақатын алудың сиқыры.
Dialogue: 0,0:10:48.89,0:10:50.39,Default,,0,0,0,,Көріп көрейік!
Dialogue: 0,0:10:50.48,0:10:51.94,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:10:52.02,0:10:55.69,Default,,0,0,0,,Мен саған мәңгілік өмір сыйлаймын
Dialogue: 0,0:10:55.78,0:10:58.78,Default,,0,0,0,,Үш бөлікке бөлсеңіз де...
Dialogue: 0,0:10:59.24,0:11:00.78,Default,,0,0,0,,Тірі болыңыз
Dialogue: 0,0:11:01.28,0:11:02.66,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,0:11:03.16,0:11:05.49,Default,,0,0,0,,Мұны істеудің қажеті жоқ!
Dialogue: 0,0:11:06.70,0:11:09.46,Default,,0,0,0,,Кесу аяқталды!
Dialogue: 0,0:11:10.00,0:11:13.17,Default,,0,0,0,,Иә? О, жоқ! Хахаха
Dialogue: 0,0:11:14.25,0:11:16.17,Default,,0,0,0,,(Клионың қатты күлуі)
Dialogue: 0,0:11:16.25,0:11:19.05,Default,,0,0,0,,Ол сені бөліп тастады.
Dialogue: 0,0:11:19.13,0:11:20.68,Default,,0,0,0,,Құлау қорқынышты!
Dialogue: 0,0:11:20.88,0:11:22.72,Default,,0,0,0,,Бірге болғанымызға қуаныштымын!
Dialogue: 0,0:11:23.01,0:11:25.10,Default,,0,0,0,,Барса Бұл жай ғана сиқыр.
Dialogue: 0,0:11:25.51,0:11:27.93,Default,,0,0,0,,Деректер бойынша, Клионың ата-анасы...
Dialogue: 0,0:11:28.02,0:11:29.68,Default,,0,0,0,,Ол атақты сиқыршы.
Dialogue: 0,0:11:29.98,0:11:30.81,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:11:31.23,0:11:35.06,Default,,0,0,0,,Не деген ақымақ, мен саған бір сәт сене жаздадым.
Dialogue: 0,0:11:35.27,0:11:38.61,Default,,0,0,0,,Бірақ мен сол кездегі жарақаттың әлі де сақталғанына сенімдімін.
Dialogue: 0,0:11:40.03,0:11:42.61,Default,,0,0,0,,Ол нағыз вампир...
Dialogue: 0,0:11:44.66,0:11:47.08,Default,,0,0,0,,Олар сізді қайтадан нысанаға алды.
Dialogue: 0,0:11:51.96,0:11:53.37,Default,,0,0,0,,Эй, барма!
Dialogue: 0,0:11:53.79,0:11:54.92,Default,,0,0,0,,Иканей!
Dialogue: 0,0:11:55.79,0:11:56.96,Default,,0,0,0,,Мен жол бойы келдім.
Dialogue: 0,0:11:57.04,0:11:59.05,Default,,0,0,0,,Динаның шайқасын көрейік.
Dialogue: 0,0:11:59.13,0:12:00.13,Default,,0,0,0,,Барма!
Dialogue: 0,0:12:00.21,0:12:01.67,Default,,0,0,0,,Барма! Барма!
Dialogue: 0,0:12:01.76,0:12:02.88,Default,,0,0,0,,Иканей!
Dialogue: 0,0:12:02.97,0:12:05.39,Default,,0,0,0,,Кеттік! кеттік
Dialogue: 0,0:12:05.72,0:12:08.14,Default,,0,0,0,,Хмф, ол жігітті жайына қалдырыңыз!
Dialogue: 0,0:12:08.22,0:12:11.52,Default,,0,0,0,,Бұл шынымен жақсы ма? Сіз балалық шақтағы достарсыз ба?
Dialogue: 0,0:12:12.06,0:12:13.89,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,0:12:17.11,0:12:18.02,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:18.11,0:12:21.03,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:12:21.11,0:12:23.03,Default,,0,0,0,,Әлемдік лиганың 2-ші туры
Dialogue: 0,0:12:23.53,0:12:25.95,Default,,0,0,0,,Франция Paris Blades қарсы.
Dialogue: 0,0:12:26.03,0:12:28.20,Default,,0,0,0,,Португалия BC Галлеон матчы
Dialogue: 0,0:12:28.28,0:12:30.29,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:12:30.45,0:12:31.91,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:32.00,0:12:33.29,Default,,0,0,0,,Галлеон б.з.б.
Dialogue: 0,0:12:33.37,0:12:36.46,Default,,0,0,0,,Біз Еуропа Лигасын жоғары деңгейде жеңіп алған тұрақты жеңімпаз командамыз.
Dialogue: 0,0:12:36.54,0:12:37.54,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:12:37.63,0:12:38.46,Default,,0,0,0,,Керісінше
Dialogue: 0,0:12:38.54,0:12:41.55,Default,,0,0,0,,Париж жүздері кометаға ұқсайды.
Dialogue: 0,0:12:41.63,0:12:44.55,Default,,0,0,0,,Кенеттен пайда болған жаңа күш: Фантастикалық!
Dialogue: 0,0:12:44.63,0:12:45.97,Default,,0,0,0,,Бұл топты кім басқарады?
Dialogue: 0,0:12:46.05,0:12:48.51,Default,,0,0,0,,Бұл адам «Қасқыр» деп аталады
Dialogue: 0,0:12:48.60,0:12:50.47,Default,,0,0,0,,Қара Құдай Дина!
Dialogue: 0,0:12:50.64,0:12:53.89,Default,,0,0,0,,Дина мен сені қолдауға келдім! Жеңілмейтін -
Dialogue: 0,0:12:53.98,0:12:55.48,Default,,0,0,0,,Сәуле!
Dialogue: 0,0:12:55.94,0:12:57.98,Default,,0,0,0,,Тұр, жеңілмейтін сәуле!
Dialogue: 0,0:12:58.52,0:13:00.52,Default,,0,0,0,,Барлығы... сендер келдіңдер.
Dialogue: 0,0:13:01.11,0:13:04.24,Default,,0,0,0,,Ол кісілер Динаның таныстары ма?
Dialogue: 0,0:13:04.74,0:13:06.32,Default,,0,0,0,,Сіз Балтомен және басқалармен кездестіңіз бе?
Dialogue: 0,0:13:06.91,0:13:09.12,Default,,0,0,0,,Аа, мен сәлем бердім.
Dialogue: 0,0:13:10.03,0:13:11.20,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:13:11.45,0:13:14.16,Default,,0,0,0,,Сіз шынымен біртүрлі жігітсіз.
Dialogue: 0,0:13:14.46,0:13:16.12,Default,,0,0,0,,Мені жұмбақ деп атаңыз
Dialogue: 0,0:13:16.21,0:13:16.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:21.80,0:13:23.34,Default,,0,0,0,,Ол тағы да қашып кетті...
Dialogue: 0,0:13:28.55,0:13:29.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:29.55,0:13:32.97,Default,,0,0,0,,(қуаныш пен қоңырау)
Dialogue: 0,0:13:33.47,0:13:36.19,Default,,0,0,0,,Енді көруге болатын бірінші ойын
Dialogue: 0,0:13:36.39,0:13:40.40,Default,,0,0,0,,Париж Блэдерс - капитан Куроками Дина!
Dialogue: 0,0:13:40.48,0:13:43.73,Default,,0,0,0,,Галлеон - Торрес Спарк!
Dialogue: 0,0:13:44.24,0:13:46.74,Default,,0,0,0,,1-ойын Бірінші шайқас
Dialogue: 0,0:13:48.07,0:13:49.99,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:13:50.07,0:13:51.20,Default,,0,0,0,,Үш
Dialogue: 0,0:13:51.28,0:13:52.41,Default,,0,0,0,,Екі
Dialogue: 0,0:13:52.49,0:13:53.49,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:13:53.62,0:13:56.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:56.25,0:13:57.04,Default,,0,0,0,,Иә
Dialogue: 0,0:13:58.25,0:13:58.79,Default,,0,0,0,,О...
Dialogue: 0,0:14:00.00,0:14:02.92,Default,,0,0,0,,(іштен дауыс)
Dialogue: 0,0:14:03.00,0:14:05.51,Default,,0,0,0,,Өлтіруші өлімді кесіңіз!
Dialogue: 0,0:14:05.80,0:14:07.09,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:14:07.17,0:14:08.26,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:14:08.97,0:14:12.64,Default,,0,0,0,,Өлім Сізердің қос соққысы шешілді.
Dialogue: 0,0:14:12.72,0:14:16.39,Default,,0,0,0,,Қара құдай Дина қарсыласын басым күшпен бағындырды!
Dialogue: 0,0:14:16.89,0:14:17.64,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:18.19,0:14:19.27,Default,,0,0,0,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,0:14:19.35,0:14:20.60,Default,,0,0,0,,Керемет, Дина!
Dialogue: 0,0:14:20.94,0:14:22.27,Default,,0,0,0,,Ол жау.
Dialogue: 0,0:14:22.98,0:14:24.98,Default,,0,0,0,,Сондықтан мен сені қолдаймын
Dialogue: 0,0:14:25.11,0:14:27.11,Default,,0,0,0,,Онымен күрескен жөн.
Dialogue: 0,0:14:27.24,0:14:27.74,Default,,0,0,0,,Хун
Dialogue: 0,0:14:27.86,0:14:29.95,Default,,0,0,0,,Бұрылған құбыжықтар түсінбейді.
Dialogue: 0,0:14:30.03,0:14:31.45,Default,,0,0,0,,Ер адамның достығы
Dialogue: 0,0:14:32.20,0:14:34.33,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:14:34.41,0:14:35.62,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:14:35.70,0:14:37.00,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:37.79,0:14:39.58,Default,,0,0,0,,Енді маған рюкзак әкел.
Dialogue: 0,0:14:39.67,0:14:41.50,Default,,0,0,0,,Мен шешемін
Dialogue: 0,0:14:41.83,0:14:44.50,Default,,0,0,0,,Paris Blades екінші ойынынан -
Dialogue: 0,0:14:44.59,0:14:45.67,Default,,0,0,0,,Люк Мар!
Dialogue: 0,0:14:46.71,0:14:48.26,Default,,0,0,0,,Галлеоннан б.з.д.
Dialogue: 0,0:14:48.34,0:14:49.38,Default,,0,0,0,,Сара Санчес!
Dialogue: 0,0:14:49.47,0:14:52.39,Default,,0,0,0,,Бұл екінші ойын матчтың өту барысын анықтайды.
Dialogue: 0,0:14:52.47,0:14:54.51,Default,,0,0,0,,Енді ол қандай шайқас болады?
Dialogue: 0,0:14:54.60,0:14:55.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:55.22,0:14:56.31,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:14:57.56,0:14:58.43,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:59.31,0:15:02.15,Default,,0,0,0,,Эй, Барто, сен бе?
Dialogue: 0,0:15:02.23,0:15:03.69,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:15:03.77,0:15:04.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:04.90,0:15:07.65,Default,,0,0,0,,Клио менің бала кездегі досым Куза...
Dialogue: 0,0:15:08.07,0:15:10.86,Default,,0,0,0,,Менің ойымша, ол жай ғана Бейбатл өткізгісі келді.
Dialogue: 0,0:15:11.57,0:15:12.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:12.74,0:15:15.24,Default,,0,0,0,,Сондықтан мен сені алып кетуге жол бойы келдім.
Dialogue: 0,0:15:15.83,0:15:16.45,Default,,0,0,0,,А...
Dialogue: 0,0:15:18.50,0:15:23.54,Default,,0,0,0,,Сені қайта көргенде жүрегім дірілдейді!
Dialogue: 0,0:15:24.84,0:15:27.38,Default,,0,0,0,,Енді шығанақта шайқасайық!
Dialogue: 0,0:15:27.71,0:15:29.84,Default,,0,0,0,,Мен де, Шу немесе Шақа болсам
Dialogue: 0,0:15:29.92,0:15:32.01,Default,,0,0,0,,Егер менің ойынымды көруге келетініңді білсем...
Dialogue: 0,0:15:32.09,0:15:33.59,Default,,0,0,0,,Мен сені міндетті түрде алып кетемін!
Dialogue: 0,0:15:35.35,0:15:37.72,Default,,0,0,0,,Клионың ойынын тамашалайық.
Dialogue: 0,0:15:39.64,0:15:40.60,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:44.61,0:15:46.57,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:15:46.65,0:15:47.57,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:15:47.65,0:15:50.61,Default,,0,0,0,,Люк Марр Керемет жарылыс!
Dialogue: 0,0:15:50.69,0:15:53.36,Default,,0,0,0,,Екінші ойынды да «Париж Блейдтері» жеңді!
Dialogue: 0,0:15:53.45,0:15:54.37,Default,,0,0,0,,Жартылай финалға дейін -
Dialogue: 0,0:15:54.45,0:15:56.37,Default,,0,0,0,,Бір ғана ойын қалды
Dialogue: 0,0:15:56.45,0:15:58.33,Default,,0,0,0,,Шаса да осылай деді.
Dialogue: 0,0:15:58.41,0:15:59.79,Default,,0,0,0,,Тіпті зебралар
Dialogue: 0,0:16:00.29,0:16:01.66,Default,,0,0,0,,Жарақат, солай ма?
Dialogue: 0,0:16:02.54,0:16:03.62,Default,,0,0,0,,Жеңіске жетейік!
Dialogue: 0,0:16:03.71,0:16:05.04,Default,,0,0,0,,Жолбарыстарға да, жылқыларға да!
Dialogue: 0,0:16:05.46,0:16:06.59,Default,,0,0,0,,Е...эй!
Dialogue: 0,0:16:06.92,0:16:08.34,Default,,0,0,0,,Үшінші ойын
Dialogue: 0,0:16:08.42,0:16:11.80,Default,,0,0,0,,Париж Бладерстің жаңа қорқынышты пышақ
Dialogue: 0,0:16:11.88,0:16:14.30,Default,,0,0,0,,Clio Doron осында! (қуаныш)
Dialogue: 0,0:16:14.39,0:16:15.59,Default,,0,0,0,,Дүниежүзілік лиганың алдында -
Dialogue: 0,0:16:15.68,0:16:18.68,Default,,0,0,0,,Париж жүздеріне қосылған жұмбақ бала.
Dialogue: 0,0:16:18.89,0:16:20.85,Default,,0,0,0,,Галлеонға қарсы...
Dialogue: 0,0:16:20.93,0:16:23.77,Default,,0,0,0,,Капитан Ксавье Коппер!
Dialogue: 0,0:16:23.85,0:16:25.56,Default,,0,0,0,,Ол қуатты әлемдік рейтингші.
Dialogue: 0,0:16:26.06,0:16:27.73,Default,,0,0,0,,Кенет пайда болған жігітке...
Dialogue: 0,0:16:27.82,0:16:30.94,Default,,0,0,0,,Қорлауға шыдай алмасаң, мен сені күшпен үрлеймін!
Dialogue: 0,0:16:32.03,0:16:33.11,Default,,0,0,0,,Егер қаласаңыз, мен оны сіздің атыңыздан жеткізе аламын.
Dialogue: 0,0:16:33.40,0:16:34.95,Default,,0,0,0,,Clio ақыры осында
Dialogue: 0,0:16:35.53,0:16:36.49,Default,,0,0,0,,Clio…
Dialogue: 0,0:16:37.91,0:16:39.58,Default,,0,0,0,,Құрметті досым,
Dialogue: 0,0:16:41.04,0:16:43.83,Default,,0,0,0,,Менің құдіретіме мұқият қара.
Dialogue: 0,0:16:44.29,0:16:45.71,Default,,0,0,0,,Хехе...
Dialogue: 0,0:16:46.21,0:16:47.88,Default,,0,0,0,,Қараңдаршы, мен күліп тұрмын.
Dialogue: 0,0:16:47.96,0:16:49.04,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:16:49.46,0:16:51.42,Default,,0,0,0,,Бұл бір ғанибет.
Dialogue: 0,0:16:56.93,0:16:57.64,Default,,0,0,0,,(жабу дыбысы)
Dialogue: 0,0:17:00.43,0:17:02.35,Default,,0,0,0,,Куза Қайтадан ойнайық
Dialogue: 0,0:17:03.10,0:17:04.14,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:17:04.31,0:17:05.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:08.65,0:17:10.65,Default,,0,0,0,,Мен ол жігітті жек көремін...
Dialogue: 0,0:17:15.28,0:17:17.45,Default,,0,0,0,,3-ойын Бірінші шайқас
Dialogue: 0,0:17:18.12,0:17:20.62,Default,,0,0,0,,Менің терең хаос атыммен-
Dialogue: 0,0:17:21.04,0:17:23.50,Default,,0,0,0,,Мен саған мәңгілік ұйқы беремін
Dialogue: 0,0:17:23.95,0:17:24.46,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:17:24.91,0:17:26.83,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:17:26.92,0:17:30.21,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:30.29,0:17:32.96,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:33.26,0:17:34.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:34.63,0:17:37.05,Default,,0,0,0,,Төзімділік түрі Deep Chaos
Dialogue: 0,0:17:37.13,0:17:38.76,Default,,0,0,0,,Орталыққа барыңыз
Dialogue: 0,0:17:38.84,0:17:42.85,Default,,0,0,0,,Жауап ретінде Ксавье шабуыл жасайды.
Dialogue: 0,0:17:43.06,0:17:44.31,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:17:44.39,0:17:46.02,Default,,0,0,0,,Бұл хаостан да жаман...
Dialogue: 0,0:17:46.10,0:17:49.81,Default,,0,0,0,,Қарсыластың шабуылына тойтарыс беру үшін жоғары және төмен қозғалу
Dialogue: 0,0:17:50.65,0:17:52.65,Default,,0,0,0,,Шыдамдылықты біртіндеп төмендету...
Dialogue: 0,0:17:53.23,0:17:55.15,Default,,0,0,0,,Дәл вампир сияқты
Dialogue: 0,0:17:55.69,0:17:58.03,Default,,0,0,0,,Керемет...қабатты көтеру
Dialogue: 0,0:17:59.07,0:18:00.16,Default,,0,0,0,,Әлгі жігіт-
Dialogue: 0,0:18:00.37,0:18:02.66,Default,,0,0,0,,Сіз шынымен менімен кездескіңіз келді ме?
Dialogue: 0,0:18:03.87,0:18:06.96,Default,,0,0,0,,Жаңадан шыққан адамнан жеңілуге ​​шыдай алмаймын!
Dialogue: 0,0:18:07.87,0:18:09.67,Default,,0,0,0,,Ой!
Dialogue: 0,0:18:09.75,0:18:12.96,Default,,0,0,0,,Терең хаос орталығы Юдзу Юдзу...
Dialogue: 0,0:18:13.05,0:18:14.17,Default,,0,0,0,,Берілме!
Dialogue: 0,0:18:14.51,0:18:16.67,Default,,0,0,0,,Бұл подшипниктің драйвері ме?
Dialogue: 0,0:18:17.05,0:18:17.55,Default,,0,0,0,,Иә
Dialogue: 0,0:18:18.47,0:18:20.97,Default,,0,0,0,,Менің хаосымның қарғысын ал!
Dialogue: 0,0:18:22.76,0:18:23.89,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:18:29.77,0:18:31.23,Default,,0,0,0,,Сіз ұтыласыз ба?
Dialogue: 0,0:18:32.94,0:18:34.48,Default,,0,0,0,,Терең хаос
Dialogue: 0,0:18:34.57,0:18:36.74,Default,,0,0,0,,Қарсыластың төзімділігі -
Dialogue: 0,0:18:36.82,0:18:39.99,Default,,0,0,0,,Мен оны қайрап жатырмын!
Dialogue: 0,0:18:47.00,0:18:49.25,Default,,0,0,0,,Терең хаос айналу финиш
Dialogue: 0,0:18:49.33,0:18:51.04,Default,,0,0,0,,1-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:18:51.13,0:18:53.13,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:54.67,0:18:56.92,Default,,0,0,0,,Уау... анау мыңжапырақ
Dialogue: 0,0:18:57.71,0:19:00.51,Default,,0,0,0,,Сол көтергіш шұңқырды қалай сындырамыз?
Dialogue: 0,0:19:01.05,0:19:03.18,Default,,0,0,0,,Егер сізде супер шабуыл болса...
Dialogue: 0,0:19:03.85,0:19:06.27,Default,,0,0,0,,Егер бұл менің шабуылым болса...
Dialogue: 0,0:19:06.93,0:19:07.93,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:19:08.43,0:19:09.43,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:19:09.94,0:19:10.94,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:19:12.86,0:19:16.02,Default,,0,0,0,,Ой, айналдыру аяқталды!
Dialogue: 0,0:19:16.11,0:19:19.78,Default,,0,0,0,,Клио екінші шайқаста Ксавьерді де жеңді!
Dialogue: 0,0:19:20.82,0:19:22.87,Default,,0,0,0,,Ойын саны 3-0-
Dialogue: 0,0:19:22.95,0:19:24.53,Default,,0,0,0,,Париж пышақтарының жеңісі!
Dialogue: 0,0:19:24.62,0:19:26.62,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:28.08,0:19:32.29,Default,,0,0,0,,Жаңа жолыңыздағы бар жақсылықты тілеймін.
Dialogue: 0,0:19:33.50,0:19:36.50,Default,,0,0,0,,Хаостың қарғысымен...хехе
Dialogue: 0,0:19:36.63,0:19:37.63,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:38.55,0:19:41.43,Default,,0,0,0,,Досым, менімен тағы ұрыс!
Dialogue: 0,0:19:41.97,0:19:44.26,Default,,0,0,0,,Мен саған енді Кроностың қанын ішуге рұқсат бермеймін.
Dialogue: 0,0:19:45.01,0:19:46.81,Default,,0,0,0,,Мен мұны кез келген уақытта жасаймын!
Dialogue: 0,0:19:47.64,0:19:48.56,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:49.64,0:19:52.35,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:52.73,0:19:53.56,Default,,0,0,0,,Барт
Dialogue: 0,0:19:53.65,0:19:56.52,Default,,0,0,0,,Маған осы матчты көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:19:56.77,0:19:58.78,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:19:58.90,0:20:00.07,Default,,0,0,0,,Барт
Dialogue: 0,0:20:00.15,0:20:00.65,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:00.74,0:20:01.86,Default,,0,0,0,,Дина!
Dialogue: 0,0:20:02.45,0:20:04.07,Default,,0,0,0,,Финалда кездескенше
Dialogue: 0,0:20:04.57,0:20:05.24,Default,,0,0,0,,О!
Dialogue: 0,0:20:05.45,0:20:07.03,Default,,0,0,0,,Күте тұрыңыз, Дина.
Dialogue: 0,0:20:07.12,0:20:09.95,Default,,0,0,0,,Екеуміз де жеңілдік!
Dialogue: 0,0:20:10.08,0:20:12.21,Default,,0,0,0,,Бізді қолдаңыз!
Dialogue: 0,0:20:12.41,0:20:12.96,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:13.50,0:20:14.96,Default,,0,0,0,,Мен екеуін де істеймін.
Dialogue: 0,0:20:15.71,0:20:18.88,Default,,0,0,0,,Міне, Нью-Йорктен соңғы жаңалықтар.
Dialogue: 0,0:20:18.96,0:20:20.42,Default,,0,0,0,,Нью-Йорк Буллз және
Dialogue: 0,0:20:20.51,0:20:22.63,Default,,0,0,0,,Оңтүстік Кореяның Fire Seoul матчы-
Dialogue: 0,0:20:22.72,0:20:27.18,Default,,0,0,0,,Бұқалар басым күшпен жартылай финалға шықты.
Dialogue: 0,0:20:27.80,0:20:29.31,Default,,0,0,0,,Бұқалар?
Dialogue: 0,0:20:29.51,0:20:30.22,Default,,0,0,0,,О
Dialogue: 0,0:20:30.47,0:20:33.02,Default,,0,0,0,,Париж Блэйдстің жартылай финалдағы қарсыласы -
Dialogue: 0,0:20:33.10,0:20:38.48,Default,,0,0,0,,Әлемнің ең мықты чемпионы Коухо - Нью-Йорк Буллз.
Dialogue: 0,0:20:38.57,0:20:40.40,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:40.48,0:20:41.69,Default,,0,0,0,,мен зұлымдарды әділ сотқа тартуға тырысар ма едім?
Dialogue: 0,0:20:46.07,0:20:46.82,Default,,0,0,0,,(иненің дыбысы)
Dialogue: 0,0:20:47.32,0:20:49.33,Default,,0,0,0,,(беріліс дыбысы)
Dialogue: 0,0:20:51.83,0:20:53.83,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:21:02.97,0:21:05.26,Default,,0,0,0,,Мені шақырған Кисама ма?
Dialogue: 0,0:21:05.34,0:21:06.09,Default,,0,0,0,,Қызыл көз
Dialogue: 0,0:21:09.01,0:21:10.01,Default,,0,0,0,,Мен аламын!
Dialogue: 0,0:21:15.10,0:21:16.52,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:21:16.60,0:21:18.36,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:21.82,0:21:22.36,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:24.28,0:21:25.49,Default,,0,0,0,,Гаруда...
Dialogue: 0,0:21:26.28,0:21:27.20,Default,,0,0,0,,Тағы да
Dialogue: 0,0:21:27.66,0:21:29.66,Default,,0,0,0,,Менімен тағы шайқас!
Dialogue: 0,0:21:31.49,0:21:33.16,Default,,0,0,0,,шығанақ өлді
Dialogue: 0,0:21:34.62,0:21:35.62,Default,,0,0,0,,(жаншылған дыбыс)
Dialogue: 0,0:21:36.21,0:21:36.75,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:39.33,0:21:40.29,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:43.17,0:21:44.97,Default,,0,0,0,,Барлық шығанақтар -
Dialogue: 0,0:21:45.22,0:21:47.05,Default,,0,0,0,,Мен оны қиратамын!
Dialogue: 0,0:21:50.18,0:21:52.18,Default,,0,0,0,,
Dialogue: 0,0:21:55.89,0:21:57.69,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:21:58.10,0:21:59.94,Default,,0,0,0,,Негіздерге дайынсыз ба?
Dialogue: 0,0:22:00.02,0:22:02.77,Default,,0,0,0,,Енді күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:02.86,0:22:04.74,Default,,0,0,0,,Қозғалыс 1 нұсқаға қарағанда жылдамырақ.
Dialogue: 0,0:22:04.82,0:22:06.90,Default,,0,0,0,,Алдымен, Showtime бағдарламасының алдыңғы бөлімін қараңыз
Dialogue: 0,0:22:06.99,0:22:10.53,Default,,0,0,0,,Бар! Шүкір! үлкен
Dialogue: 0,0:22:10.62,0:22:13.37,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:13.45,0:22:14.29,Default,,0,0,0,,Жылдамдату
Dialogue: 0,0:22:14.37,0:22:16.12,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:16.20,0:22:17.96,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:18.04,0:22:19.79,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:19.88,0:22:21.38,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:21.46,0:22:23.09,Default,,0,0,0,,Хахаха, жақсы емес пе?
Dialogue: 0,0:22:23.17,0:22:24.76,Default,,0,0,0,,Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.84,0:22:26.59,Default,,0,0,0,,Бұл одан да нашарлайды.
Dialogue: 0,0:22:26.67,0:22:28.76,Default,,0,0,0,,Шиеленісті көтерейік!
Dialogue: 0,0:22:28.84,0:22:30.80,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:30.89,0:22:32.76,Default,,0,0,0,,Ақылыңды жетілдір, Моримори
Dialogue: 0,0:22:32.85,0:22:34.60,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:34.68,0:22:36.43,Default,,0,0,0,,Менің атуым – құдайдың атысы
Dialogue: 0,0:22:36.52,0:22:40.06,Default,,0,0,0,,Оң аяқ киім Сол аяқ киім Оң жақтағы аяқ киім
Dialogue: 0,0:22:40.15,0:22:43.73,Default,,0,0,0,,Сол аяқ киім Оң аяқ киім Сол жақтағы аяқ киім
Dialogue: 0,0:22:43.82,0:22:45.65,Default,,0,0,0,,Өткен апта Осы аптада
Dialogue: 0,0:22:45.73,0:22:47.53,Default,,0,0,0,,Барып, түсіріп жатырмыз
Dialogue: 0,0:22:47.61,0:22:49.32,Default,,0,0,0,,Осы апта Келесі аптада
Dialogue: 0,0:22:49.40,0:22:51.37,Default,,0,0,0,,Ол сонымен бірге Go Shoot ойнайды
Dialogue: 0,0:22:51.45,0:22:53.03,Default,,0,0,0,,Күнделікті жаттығу
Dialogue: 0,0:22:53.12,0:22:54.95,Default,,0,0,0,,Барып, бәрі істеп жатқан түсіру
Dialogue: 0,0:22:55.04,0:22:56.75,Default,,0,0,0,,Көктем/жаз күз/қыс
Dialogue: 0,0:22:56.83,0:22:58.41,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:22:58.50,0:22:59.92,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:23:00.00,0:23:02.63,Default,,0,0,0,,Негізгі бұлшықеттерді жақсарту үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.71,0:23:05.84,Default,,0,0,0,,Сол шиеленіспен біз шарықтау шегіне жетеміз.
Dialogue: 0,0:23:05.92,0:23:08.88,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:08.97,0:23:09.63,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:23:09.72,0:23:12.34,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:12.43,0:23:13.14,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:23:13.22,0:23:17.02,Default,,0,0,0,,1 2 3 4 Бар! кеттік
Dialogue: 0,0:23:17.10,0:23:17.68,Default,,0,0,0,,Үш
Dialogue: 0,0:23:17.93,0:23:18.56,Default,,0,0,0,,Екі
Dialogue: 0,0:23:18.77,0:23:20.56,Default,,0,0,0,,One Go аяқ киім!
Dialogue: 0,0:23:20.64,0:23:21.90,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:21.98,0:23:25.07,Default,,0,0,0,,Керемет түсіріңіз! Керемет негіз!
Dialogue: 0,0:23:26.27,0:23:27.65,Default,,0,0,0,,Уау~ Амиго!
Dialogue: 0,0:23:27.73,0:23:29.07,Default,,0,0,0,,Вива Замба!
Dialogue: 0,0:23:29.65,0:23:32.49,Default,,0,0,0,,Біз Риос Бразилияның жылжымайтын мүлкіне міндік.
Dialogue: 0,0:23:32.57,0:23:33.28,Default,,0,0,0,,Бұл фестиваль!
Dialogue: 0,0:23:33.70,0:23:36.83,Default,,0,0,0,,Лу Вэй 3-он-1 Мен аламын!
Dialogue: 0,0:23:37.08,0:23:39.41,Default,,0,0,0,,Е! Шака ашулы ма?
Dialogue: 0,0:23:39.58,0:23:41.96,Default,,0,0,0,,Неліктен? Мен жаман нәрсе жасадым ба?
Dialogue: 0,0:23:42.17,0:23:44.63,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:44.75,0:23:46.59,Default,,0,0,0,,Бекініс! Regulus баспанасы! !
Dialogue: 0,0:23:46.80,0:23:49.88,Default,,0,0,0,,Үш екі бір ату!
