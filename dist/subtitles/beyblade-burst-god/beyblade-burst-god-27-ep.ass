Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.17,Default,,0,0,0,,wbba әлемдік лигасы
Dialogue: 0,0:00:07.92,0:00:10.01,Default,,0,0,0,,Әр лигада жеңіске жеткен клубтар
Dialogue: 0,0:00:10.09,0:00:12.72,Default,,0,0,0,,Әлемнің шыңына қарай шайқас
Dialogue: 0,0:00:13.22,0:00:14.76,Default,,0,0,0,,Чемпион болуды мақсат етіңіз
Dialogue: 0,0:00:14.84,0:00:16.51,Default,,0,0,0,,Қолға алу үшін бірінші нөмір
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Жауынгерлік рухыңызды өртеп жіберіңіз
Dialogue: 0,0:00:18.64,0:00:20.27,Default,,0,0,0,,Және шектен шығу
Dialogue: 0,0:00:21.02,0:00:22.43,Default,,0,0,0,,Жалынды жандардың шайқасы...
Dialogue: 0,0:00:22.93,0:00:24.94,Default,,0,0,0,,Дүниені отқа сал
Dialogue: 0,0:00:25.85,0:00:27.94,Default,,0,0,0,,Даңққа кім ие болады?
Dialogue: 0,0:00:28.02,0:00:28.94,Default,,0,0,0,,Бұл – тура қызыл карта. (Бакуго) Тс.
Dialogue: 0,0:00:31.65,0:00:34.49,Default,,0,0,0,,Жақсы, үлкен жаңалық!
Dialogue: 0,0:00:34.57,0:00:36.95,Default,,0,0,0,,WBBA Әлемдік лигасының 2-ші туры
Dialogue: 0,0:00:37.37,0:00:40.41,Default,,0,0,0,,Реал Самбат пен Бразилия Риос шайқасы
Dialogue: 0,0:00:40.49,0:00:42.79,Default,,0,0,0,,Ол Токиода өтеді!
Dialogue: 0,0:00:43.66,0:00:46.12,Default,,0,0,0,,Жапониядағы барлық адамдар күте тұрыңыз.
Dialogue: 0,0:00:46.21,0:00:49.46,Default,,0,0,0,,Жақында барлығына жеңіс сыйлаймын!
Dialogue: 0,0:00:49.54,0:00:50.75,Default,,0,0,0,,Бала!
Dialogue: 0,0:00:50.84,0:00:52.67,Default,,0,0,0,,Вакия-кун мен Шака-чан да
Dialogue: 0,0:00:52.76,0:00:53.97,Default,,0,0,0,,Барлығы керемет
Dialogue: 0,0:00:54.05,0:00:56.43,Default,,0,0,0,,Бару-нии де солай емес пе?
Dialogue: 0,0:00:56.51,0:00:57.84,Default,,0,0,0,,Жеңімпазмен-
Dialogue: 0,0:00:57.93,0:00:59.85,Default,,0,0,0,,Бал-нидің ВС Соль жеңеді.
Dialogue: 0,0:00:59.93,0:01:01.81,Default,,0,0,0,,Қызықты!
Dialogue: 0,0:01:02.81,0:01:03.68,Default,,0,0,0,,Міне!
Dialogue: 0,0:01:03.77,0:01:04.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:04.39,0:01:06.52,Default,,0,0,0,,Міне, баланың ұшағы.
Dialogue: 0,0:01:11.82,0:01:14.44,Default,,0,0,0,,Ақырында Уакия мен Шаканың клубы
Dialogue: 0,0:01:14.53,0:01:16.86,Default,,0,0,0,,Біз Токиода бір-бірімізге соқтығыстық.
Dialogue: 0,0:01:17.66,0:01:18.57,Default,,0,0,0,,Барлық ел бойынша!
Dialogue: 0,0:01:18.66,0:01:19.24,Default,,0,0,0,,(Баспа дыбысы)
Dialogue: 0,0:01:19.32,0:01:20.41,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:01:20.49,0:01:21.41,Default,,0,0,0,,Жапония!
Dialogue: 0,0:01:21.74,0:01:22.95,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:01:23.04,0:01:25.37,Default,,0,0,0,,Токонацу! Ника! Анашым!
Dialogue: 0,0:01:25.87,0:01:28.12,Default,,0,0,0,,Мен қайтып келдім!
Dialogue: 0,0:01:44.43,0:01:48.10,Default,,0,0,0,,Тіпті таңғы нұрмен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:49.06,0:01:51.31,Default,,0,0,0,,Бір жерден естіген дыбыс
Dialogue: 0,0:01:51.40,0:01:53.82,Default,,0,0,0,,Шығанақтардың соқтығысуы таң қалдырады!
Dialogue: 0,0:01:53.90,0:01:58.24,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:58.95,0:02:00.74,Default,,0,0,0,,Құмарлы жүрек ұйықтамайды
Dialogue: 0,0:02:00.82,0:02:03.66,Default,,0,0,0,,Мен шайқасқа асығамын.
Dialogue: 0,0:02:03.74,0:02:08.67,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:08.75,0:02:13.63,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:13.71,0:02:18.68,Default,,0,0,0,,Ең жақсы сахнада шыңды көздеу
Dialogue: 0,0:02:18.76,0:02:22.05,Default,,0,0,0,,Қазір ат!
Dialogue: 0,0:02:22.14,0:02:24.18,Default,,0,0,0,,(Үш екі бір ату!)
Dialogue: 0,0:02:24.26,0:02:26.27,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:26.35,0:02:28.43,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:28.52,0:02:31.98,Default,,0,0,0,,Бізге бұрын көрмеген шайқасты көрсет!
Dialogue: 0,0:02:32.06,0:02:34.11,Default,,0,0,0,,(Үш екі бір ату!)
Dialogue: 0,0:02:34.19,0:02:36.19,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:36.28,0:02:38.61,Default,,0,0,0,,Үнемі дамып келе жатқан серіктеспен
Dialogue: 0,0:02:38.70,0:02:42.41,Default,,0,0,0,,Байланыстармен және жүрек соғуымен
Dialogue: 0,0:02:42.49,0:02:46.24,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:46.33,0:02:49.08,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:00.18,0:03:03.55,Default,,0,0,0,,Токио шайқасы! Реал Риоға қарсы! !
Dialogue: 0,0:03:04.80,0:03:05.72,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:03:06.01,0:03:08.02,Default,,0,0,0,,Уау! (құлап түскен дыбыс)
Dialogue: 0,0:03:08.22,0:03:09.85,Default,,0,0,0,,Жағдайың жақсы сияқты, Балто.
Dialogue: 0,0:03:11.19,0:03:13.73,Default,,0,0,0,,Мен әрқашан сондай жігерлімін!
Dialogue: 0,0:03:14.11,0:03:16.73,Default,,0,0,0,,Отбасының кездесуі... Иә, декорация...
Dialogue: 0,0:03:16.82,0:03:18.11,Default,,0,0,0,,Какка какка
Dialogue: 0,0:03:18.57,0:03:20.15,Default,,0,0,0,,Рахмет сізге Вакия-кун
Dialogue: 0,0:03:20.36,0:03:23.11,Default,,0,0,0,,Eete Eete Oya арзан!
Dialogue: 0,0:03:23.32,0:03:24.66,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:03:24.74,0:03:27.62,Default,,0,0,0,,Бүкіл BC Sol топ командасы осында!
Dialogue: 0,0:03:27.95,0:03:29.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:29.20,0:03:32.00,Default,,0,0,0,,Біз Токонацу мен Никамыз ба?
Dialogue: 0,0:03:32.08,0:03:33.08,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:03:33.17,0:03:34.38,Default,,0,0,0,,Кавайина
Dialogue: 0,0:03:34.88,0:03:35.92,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:37.30,0:03:39.30,Default,,0,0,0,,Мына балалар Куза мен Шаса
Dialogue: 0,0:03:39.38,0:03:40.05,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:03:40.38,0:03:42.93,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Шаса Гуттен.
Dialogue: 0,0:03:43.22,0:03:44.14,Default,,0,0,0,,Бұл Чихару.
Dialogue: 0,0:03:44.55,0:03:47.56,Default,,0,0,0,,Сондай-ақ BC Sol-да аналық қуықтар бар.
Dialogue: 0,0:03:47.89,0:03:49.64,Default,,0,0,0,,Шаса күшті
Dialogue: 0,0:03:49.81,0:03:50.64,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:03:51.18,0:03:54.23,Default,,0,0,0,,Керемет! Мен де BC Sol тобына қосылғым келеді!
Dialogue: 0,0:03:54.85,0:03:56.02,Default,,0,0,0,,Ол Cisco
Dialogue: 0,0:03:56.11,0:03:57.19,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:03:57.32,0:03:59.15,Default,,0,0,0,,Cisco да керемет!
Dialogue: 0,0:03:59.48,0:04:01.53,Default,,0,0,0,,Эх... хехе...
Dialogue: 0,0:04:02.28,0:04:03.99,Default,,0,0,0,,Барлығы менің үйімде тұрады.
Dialogue: 0,0:04:04.07,0:04:07.87,Default,,0,0,0,,Келіңіздер! Менде дәмді нан көп.
Dialogue: 0,0:04:07.95,0:04:09.58,Default,,0,0,0,,Жарайсың, анашым!
Dialogue: 0,0:04:10.54,0:04:12.58,Default,,0,0,0,,Жапонияға қош келдіңіз!
Dialogue: 0,0:04:13.04,0:04:14.04,Default,,0,0,0,,Хаха!
Dialogue: 0,0:04:14.21,0:04:16.54,Default,,0,0,0,,Барт, үйге қош келдіңіз
Dialogue: 0,0:04:16.96,0:04:19.59,Default,,0,0,0,,Мен сіздің әрекеттеріңізді үнемі бақылап отырамын.
Dialogue: 0,0:04:20.09,0:04:22.34,Default,,0,0,0,,Хоудзи маған хабарласты.
Dialogue: 0,0:04:22.63,0:04:24.09,Default,,0,0,0,,Инуске!
Dialogue: 0,0:04:24.18,0:04:24.80,Default,,0,0,0,,Хаха
Dialogue: 0,0:04:25.30,0:04:26.97,Default,,0,0,0,,Мен сені сағындым!
Dialogue: 0,0:04:27.55,0:04:30.01,Default,,0,0,0,,Bay Club кездесуі кейінге қалдырылады.
Dialogue: 0,0:04:30.52,0:04:32.48,Default,,0,0,0,,Баспасөз конференциясы басталғалы жатыр!
Dialogue: 0,0:04:33.06,0:04:33.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.98,0:04:35.14,Default,,0,0,0,,Баспасөз конференциясы?
Dialogue: 0,0:04:36.06,0:04:37.02,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:04:37.11,0:04:39.90,Default,,0,0,0,,Реал Самбат пен Бразилия Риосы дәл қазір
Dialogue: 0,0:04:39.98,0:04:42.69,Default,,0,0,0,,Біз Жапонияға келдік! Куу!
Dialogue: 0,0:04:42.78,0:04:44.86,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:04:45.61,0:04:46.91,Default,,0,0,0,,Нағыз самбат
Dialogue: 0,0:04:46.99,0:04:49.87,Default,,0,0,0,,Иесі және пышақшысы Комурасаки Вакия
Dialogue: 0,0:04:49.95,0:04:52.87,Default,,0,0,0,,Атару Окинака, жаттықтырушы және қуықшы
Dialogue: 0,0:04:52.95,0:04:56.04,Default,,0,0,0,,Гай Спир Дуст Лукан және-
Dialogue: 0,0:04:56.12,0:04:58.08,Default,,0,0,0,,Джанго Матадор
Dialogue: 0,0:04:58.38,0:05:01.34,Default,,0,0,0,,Риос Бразилиядағы Кайза жанып тұрған жалын ғибадатханасы
Dialogue: 0,0:05:01.42,0:05:04.34,Default,,0,0,0,,Ән Лувей Карлос Сандер
Dialogue: 0,0:05:04.42,0:05:06.05,Default,,0,0,0,,Жалғыз қызыл Анна Марк
Dialogue: 0,0:05:06.13,0:05:08.72,Default,,0,0,0,,Табылды... Стэн Гамбург!
Dialogue: 0,0:05:09.64,0:05:10.56,Default,,0,0,0,,(Қол алысу дыбысы)
Dialogue: 0,0:05:10.93,0:05:13.56,Default,,0,0,0,,Дәл қазір Вакия Комурасаки мен Кайза Кагакуэнджи...
Dialogue: 0,0:05:13.64,0:05:15.39,Default,,0,0,0,,Қатты қол алысу!
Dialogue: 0,0:05:16.64,0:05:17.27,Default,,0,0,0,,Вакия!
Dialogue: 0,0:05:17.85,0:05:20.19,Default,,0,0,0,,Мен сенімен Жапонияда жекпе-жек өткізгеніме қуаныштымын.
Dialogue: 0,0:05:20.57,0:05:21.44,Default,,0,0,0,,Ваймоя
Dialogue: 0,0:05:21.61,0:05:23.61,Default,,0,0,0,,Маған дәл жеңіске жетуге рұқсат етіңіз
Dialogue: 0,0:05:23.78,0:05:25.95,Default,,0,0,0,,Мен сен үшін жылаймын...
Dialogue: 0,0:05:26.03,0:05:27.82,Default,,0,0,0,,Мен саған сыйлық әкелдім.
Dialogue: 0,0:05:28.66,0:05:29.57,Default,,0,0,0,,Сыйлық па?
Dialogue: 0,0:05:30.24,0:05:31.78,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,0:05:34.33,0:05:35.41,Default,,0,0,0,,Ой!
Dialogue: 0,0:05:35.50,0:05:38.54,Default,,0,0,0,,Комурасаки Вакия не әкелді?
Dialogue: 0,0:05:38.62,0:05:39.75,Default,,0,0,0,,Бұл BC Sol!
Dialogue: 0,0:05:41.09,0:05:43.00,Default,,0,0,0,,Вакия Йонекома академиясынан Барто Аоимен бірге.
Dialogue: 0,0:05:43.09,0:05:45.55,Default,,0,0,0,,б.з.д. Соль, оған Рантаро Кояма жатады...
Dialogue: 0,0:05:45.63,0:05:47.63,Default,,0,0,0,,Ол мені Жапонияға әкелді!
Dialogue: 0,0:05:47.72,0:05:50.55,Default,,0,0,0,,Ол мені басын көтеріп күтіп тұрды.
Dialogue: 0,0:05:50.64,0:05:53.26,Default,,0,0,0,,Жапондық Beyblade жанкүйерлеріне тамаша қызмет!
Dialogue: 0,0:05:53.60,0:05:55.22,Default,,0,0,0,,Жақсы, Вакия!
Dialogue: 0,0:05:55.31,0:05:56.64,Default,,0,0,0,,Жас бала күткендей!
Dialogue: 0,0:05:57.19,0:05:59.23,Default,,0,0,0,,Балто! Мен сені сағындым
Dialogue: 0,0:05:59.31,0:06:02.02,Default,,0,0,0,,Шака! Өткен күнгі хатыңызға рахмет.
Dialogue: 0,0:06:02.69,0:06:04.61,Default,,0,0,0,,Менің ойымша, сіз күшейіп жатырсыз ба?
Dialogue: 0,0:06:05.99,0:06:07.15,Default,,0,0,0,,Әрине.
Dialogue: 0,0:06:07.65,0:06:10.78,Default,,0,0,0,,Реалды жеңгеннен кейін келесі орында BC Sol.
Dialogue: 0,0:06:11.28,0:06:11.99,Default,,0,0,0,,О!
Dialogue: 0,0:06:12.41,0:06:13.87,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:06:14.24,0:06:15.66,Default,,0,0,0,,Жеңіске жетуге болады!
Dialogue: 0,0:06:15.75,0:06:16.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:17.12,0:06:19.00,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:06:19.58,0:06:22.92,Default,,0,0,0,,Дүниеге секірген балалық шақтағы достары мен жақын достары...
Dialogue: 0,0:06:23.00,0:06:25.25,Default,,0,0,0,,Біз Жапонияда тағы кездестік...
Dialogue: 0,0:06:25.34,0:06:27.01,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:06:27.59,0:06:29.80,Default,,0,0,0,,Риостың Стэн Гамбургімен...
Dialogue: 0,0:06:29.88,0:06:31.64,Default,,0,0,0,,«Реалдың» Джанго Матадоры да...
Dialogue: 0,0:06:31.72,0:06:33.93,Default,,0,0,0,,Бұрын Б.С. Сольге тиесілі жақын достар
Dialogue: 0,0:06:34.35,0:06:36.39,Default,,0,0,0,,Бұл ең жақсы дос кездесуі де маңызды оқиға!
Dialogue: 0,0:06:36.60,0:06:37.77,Default,,0,0,0,,Нағыз адамдар
Dialogue: 0,0:06:37.85,0:06:40.31,Default,,0,0,0,,Менің Джангом маған қамқорлық жасайды.
Dialogue: 0,0:06:40.65,0:06:42.81,Default,,0,0,0,,Стэн Бразилия ше?
Dialogue: 0,0:06:43.02,0:06:44.44,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:06:44.98,0:06:48.49,Default,,0,0,0,,Бізде үлкен бестік, Шака және Лувей бар.
Dialogue: 0,0:06:48.57,0:06:50.91,Default,,0,0,0,,Осы екеуі мені күшейтті
Dialogue: 0,0:06:51.28,0:06:54.49,Default,,0,0,0,,Қамқор болдың, Енді жау болдық.
Dialogue: 0,0:06:54.58,0:06:56.79,Default,,0,0,0,,Мен сені әділ және шаршы түрде жеңемін.
Dialogue: 0,0:06:57.50,0:06:59.54,Default,,0,0,0,,Кім жеңіледі?
Dialogue: 0,0:06:59.62,0:07:01.50,Default,,0,0,0,,Джанго! Стэн!
Dialogue: 0,0:07:01.96,0:07:03.00,Default,,0,0,0,,Н Барт...
Dialogue: 0,0:07:03.63,0:07:04.54,Default,,0,0,0,,Жарық жасыл, Ято-сан.
Dialogue: 0,0:07:05.09,0:07:06.13,Default,,0,0,0,,Жарық жасыл, Ято-сан.
Dialogue: 0,0:07:06.71,0:07:07.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:07.92,0:07:10.17,Default,,0,0,0,,Мен сізді қайтадан көргеніме өте қуаныштымын!
Dialogue: 0,0:07:10.26,0:07:10.97,Default,,0,0,0,,Мен де!
Dialogue: 0,0:07:12.26,0:07:13.26,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:07:17.22,0:07:17.81,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:18.22,0:07:20.18,Default,,0,0,0,,Балалар, не істеп жатырсыңдар...
Dialogue: 0,0:07:21.39,0:07:22.69,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:07:22.77,0:07:25.19,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:07:25.98,0:07:29.03,Default,,0,0,0,,Y-дан әлі де көптеген тамаша қызметтер бар.
Dialogue: 0,0:07:29.19,0:07:31.03,Default,,0,0,0,,Көрме матчы!
Dialogue: 0,0:07:31.36,0:07:33.78,Default,,0,0,0,,Әй, эй... ау, ау!
Dialogue: 0,0:07:33.87,0:07:35.24,Default,,0,0,0,,Комурасаки Вакия -
Dialogue: 0,0:07:35.32,0:07:37.62,Default,,0,0,0,,Арнайы стадион дайындалды!
Dialogue: 0,0:07:38.54,0:07:40.91,Default,,0,0,0,,Бұл Муген Бей стадионы...
Dialogue: 0,0:07:41.21,0:07:42.92,Default,,0,0,0,,Дәл солай емес пе!
Dialogue: 0,0:07:43.00,0:07:45.38,Default,,0,0,0,,Нақты орындауға дейін нақты таймерді жасау мүмкін емес.
Dialogue: 0,0:07:45.84,0:07:48.05,Default,,0,0,0,,Мен мұны саған дайындадым!
Dialogue: 0,0:07:48.84,0:07:50.59,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:07:51.05,0:07:53.59,Default,,0,0,0,,Әй, мен мұны Шақаға қалдырамын.
Dialogue: 0,0:07:54.09,0:07:57.56,Default,,0,0,0,,Хмф, мен Уакияның ойындарымен бірге жүрмеймін.
Dialogue: 0,0:07:57.89,0:07:59.22,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:07:59.31,0:08:00.18,Default,,0,0,0,,Мен де!
Dialogue: 0,0:08:00.64,0:08:03.31,Default,,0,0,0,,Инуске! Сіз судьясыз!
Dialogue: 0,0:08:03.48,0:08:05.31,Default,,0,0,0,,А...мен?
Dialogue: 0,0:08:05.56,0:08:07.69,Default,,0,0,0,,Жүр, Комурасаки Вакия дайындады...
Dialogue: 0,0:08:07.77,0:08:09.73,Default,,0,0,0,,Infinite Bay стадионының орталығында...
Dialogue: 0,0:08:09.82,0:08:11.82,Default,,0,0,0,,Қуатты шексіз шығанақ айнала бастады!
Dialogue: 0,0:08:11.90,0:08:15.20,Default,,0,0,0,,Төрт пышақ бірден атады!
Dialogue: 0,0:08:15.28,0:08:16.95,Default,,0,0,0,,Бұл корольдік ойын!
Dialogue: 0,0:08:17.41,0:08:19.41,Default,,0,0,0,,Тірі қалған би жеңеді.
Dialogue: 0,0:08:19.58,0:08:20.45,Default,,0,0,0,,Жақсы естіледі ме?
Dialogue: 0,0:08:20.83,0:08:23.25,Default,,0,0,0,,I, осы шексіз шығанақ стадионындағы шайқас -
Dialogue: 0,0:08:23.33,0:08:25.88,Default,,0,0,0,,Мен үйреніп қалдым, сондықтан бұл өте жақсы!
Dialogue: 0,0:08:25.96,0:08:27.17,Default,,0,0,0,,Дұрыс сияқты!
Dialogue: 0,0:08:27.71,0:08:30.17,Default,,0,0,0,,Оның қандай стадион екені маңызды емес!
Dialogue: 0,0:08:30.25,0:08:32.38,Default,,0,0,0,,Үш есе соққымен ұшыңыз!
Dialogue: 0,0:08:32.47,0:08:33.38,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:33.47,0:08:35.59,Default,,0,0,0,,Әдеттегідей, сізде бұлшықетті ми бар.
Dialogue: 0,0:08:36.14,0:08:38.05,Default,,0,0,0,,Атарудың стратегиясы бойынша.
Dialogue: 0,0:08:38.14,0:08:38.64,Default,,0,0,0,,Иә
Dialogue: 0,0:08:39.72,0:08:41.93,Default,,0,0,0,,Шаканың үш еселік әсері...
Dialogue: 0,0:08:42.02,0:08:43.60,Default,,0,0,0,,Мен оны көргім келді.
Dialogue: 0,0:08:43.89,0:08:46.69,Default,,0,0,0,,Жақсы жар таптың, балам.
Dialogue: 0,0:08:46.98,0:08:49.40,Default,,0,0,0,,Атару Окинака - өте стратег.
Dialogue: 0,0:08:49.69,0:08:51.40,Default,,0,0,0,,Бұл стратегия ма?
Dialogue: 0,0:08:51.98,0:08:53.78,Default,,0,0,0,,Бұл шайқаста...
Dialogue: 0,0:08:53.86,0:08:56.03,Default,,0,0,0,,Мен Шақаны толығымен жалаңаштандыруды жоспарлап отырмын.
Dialogue: 0,0:08:56.16,0:08:57.74,Default,,0,0,0,,Жалаңаш? Жоқ!
Dialogue: 0,0:08:57.82,0:08:59.62,Default,,0,0,0,,Бұл сіз айтып тұрған жоқсыз.
Dialogue: 0,0:08:59.91,0:09:01.70,Default,,0,0,0,,Сіз де шайқасыңыз!
Dialogue: 0,0:09:02.20,0:09:03.20,Default,,0,0,0,,Ярите!
Dialogue: 0,0:09:03.29,0:09:05.21,Default,,0,0,0,,Бүгін шыдамды болыңыз!
Dialogue: 0,0:09:05.41,0:09:07.38,Default,,0,0,0,,Матч алдында үш еселік соққы
Dialogue: 0,0:09:07.46,0:09:09.17,Default,,0,0,0,,Мен оны басқа адамға көрсете аламын ба?
Dialogue: 0,0:09:09.50,0:09:11.42,Default,,0,0,0,,Шақа өзіне сенімді
Dialogue: 0,0:09:11.50,0:09:13.46,Default,,0,0,0,,Оны сізге көрсетудің қажеті жоқ.
Dialogue: 0,0:09:14.01,0:09:16.18,Default,,0,0,0,,Матч бір ғана ойын, кеттік!
Dialogue: 0,0:09:16.59,0:09:17.55,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:18.01,0:09:19.26,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:09:19.68,0:09:20.97,Default,,0,0,0,,Біз жеңеміз!
Dialogue: 0,0:09:21.85,0:09:23.43,Default,,0,0,0,,Мен мұны бір соққымен жасаймын!
Dialogue: 0,0:09:23.77,0:09:25.43,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:09:25.52,0:09:28.44,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:28.94,0:09:31.19,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:31.27,0:09:34.19,Default,,0,0,0,,Төрт шығанақ бірден босатылды.
Dialogue: 0,0:09:34.61,0:09:35.90,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:09:38.45,0:09:39.37,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:09:39.45,0:09:41.28,Default,,0,0,0,,Валькири қайтарылды
Dialogue: 0,0:09:41.49,0:09:42.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:42.54,0:09:43.83,Default,,0,0,0,,Қос әсер!
Dialogue: 0,0:09:45.37,0:09:46.46,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:09:46.62,0:09:47.62,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:09:47.71,0:09:50.63,Default,,0,0,0,,Экскалибур да тойтарылады
Dialogue: 0,0:09:50.92,0:09:51.59,Default,,0,0,0,,Эх!
Dialogue: 0,0:09:54.88,0:09:56.55,Default,,0,0,0,,Рагнарук аймағы!
Dialogue: 0,0:09:57.09,0:09:58.76,Default,,0,0,0,,Торнадо қалқаны!
Dialogue: 0,0:09:59.43,0:10:01.43,Default,,0,0,0,,Рагнарук пен Вайверн!
Dialogue: 0,0:10:01.51,0:10:04.35,Default,,0,0,0,,Бұл ретте мен ерекше қимылды қолдандым. Бұл күшті қадам.
Dialogue: 0,0:10:09.02,0:10:11.44,Default,,0,0,0,,Бар, байланған шабуыл!
Dialogue: 0,0:10:15.94,0:10:17.78,Default,,0,0,0,,Үш есе әсер ету!
Dialogue: 0,0:10:18.49,0:10:19.70,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:10:22.49,0:10:24.74,Default,,0,0,0,,Infinite Bay Burst!
Dialogue: 0,0:10:24.83,0:10:26.83,Default,,0,0,0,,Соққыдан төрт шығанақ ұшып кетті.
Dialogue: 0,0:10:27.37,0:10:28.33,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:10:28.46,0:10:29.29,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:10:29.75,0:10:30.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:32.59,0:10:34.00,Default,,0,0,0,,(төмен қарай домалап бара жатқан дыбыс)
Dialogue: 0,0:10:34.63,0:10:36.71,Default,,0,0,0,,Стадионда не қалды
Dialogue: 0,0:10:36.96,0:10:38.84,Default,,0,0,0,,Бұл Валькири!
Dialogue: 0,0:10:39.43,0:10:40.89,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:10:41.09,0:10:42.80,Default,,0,0,0,,Балто жеңді.
Dialogue: 0,0:10:43.22,0:10:44.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:45.06,0:10:46.60,Default,,0,0,0,,Бар-нии жеңді!
Dialogue: 0,0:10:46.68,0:10:48.23,Default,,0,0,0,,Жақсы, Балто
Dialogue: 0,0:10:48.56,0:10:51.31,Default,,0,0,0,,Маған Кумичоның Рагнарук көмектесті.
Dialogue: 0,0:10:51.40,0:10:52.73,Default,,0,0,0,,Критана!
Dialogue: 0,0:10:52.90,0:10:54.73,Default,,0,0,0,,Бұл топтық жұмыс
Dialogue: 0,0:10:55.07,0:10:56.61,Default,,0,0,0,,Бұл жай ғана кездейсоқтық.
Dialogue: 0,0:10:57.28,0:11:00.61,Default,,0,0,0,,Рагнарук қалса, мен жеңер едім.
Dialogue: 0,0:11:00.70,0:11:01.41,Default,,0,0,0,,Коу!
Dialogue: 0,0:11:01.78,0:11:03.57,Default,,0,0,0,,Рахмет, Кумичо!
Dialogue: 0,0:11:03.78,0:11:04.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:04.70,0:11:06.91,Default,,0,0,0,,Топтық жұмыс Топтық жұмыс
Dialogue: 0,0:11:07.24,0:11:09.33,Default,,0,0,0,,Ах... дәл мен есептегендей!
Dialogue: 0,0:11:10.87,0:11:11.87,Default,,0,0,0,,(жұдырықтың соқтығысқан дыбысы)
Dialogue: 0,0:11:12.92,0:11:14.38,Default,,0,0,0,,Ммм
Dialogue: 0,0:11:14.75,0:11:18.01,Default,,0,0,0,,Жарылысқа себеп болған менің Excalibur болды!
Dialogue: 0,0:11:18.42,0:11:19.76,Default,,0,0,0,,Бұл Валькири!
Dialogue: 0,0:11:20.30,0:11:22.97,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл шайқау!
Dialogue: 0,0:11:23.26,0:11:24.97,Default,,0,0,0,,Бұл менің Рагнарукым!
Dialogue: 0,0:11:25.18,0:11:26.81,Default,,0,0,0,,(Төрт адам ұрысады)
Dialogue: 0,0:11:26.89,0:11:27.97,Default,,0,0,0,,Біртүрлі, ол...
Dialogue: 0,0:11:28.39,0:11:30.35,Default,,0,0,0,,Келесі жолы оны матчта көріңіз.
Dialogue: 0,0:11:30.48,0:11:33.44,Default,,0,0,0,,Вакия Шака Мен жақсы матч күтемін.
Dialogue: 0,0:11:34.06,0:11:34.94,Default,,0,0,0,,О!
Dialogue: 0,0:11:35.73,0:11:38.57,Default,,0,0,0,,Балт Хуанцзан, Балалар, бұған еш қатысың жоқ!
Dialogue: 0,0:11:39.07,0:11:40.44,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:11:40.65,0:11:41.28,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:41.65,0:11:44.95,Default,,0,0,0,,Га ха ха ха
Dialogue: 0,0:11:45.78,0:11:47.70,Default,,0,0,0,,Эмилияны құтқарғың келеді деп айтқан жоқсың.
Dialogue: 0,0:11:48.16,0:11:49.54,Default,,0,0,0,,(Нан шайнау дыбысы)
Dialogue: 0,0:11:50.25,0:11:51.66,Default,,0,0,0,,Unme~
Dialogue: 0,0:11:51.75,0:11:53.75,Default,,0,0,0,,Анамның наны ең жақсы!
Dialogue: 0,0:11:54.13,0:11:56.29,Default,,0,0,0,,Дәмі Андждың наны сияқты.
Dialogue: 0,0:11:56.38,0:11:57.38,Default,,0,0,0,,Sur!
Dialogue: 0,0:11:57.63,0:11:59.63,Default,,0,0,0,,Бұл хонке хонмото.
Dialogue: 0,0:12:00.01,0:12:02.47,Default,,0,0,0,,Менің анам және испан анам
Dialogue: 0,0:12:02.55,0:12:03.84,Default,,0,0,0,,Қайсысы сүйкімді?
Dialogue: 0,0:12:03.93,0:12:05.55,Default,,0,0,0,,Ал, шешілді, солай ма?
Dialogue: 0,0:12:06.14,0:12:06.97,Default,,0,0,0,,Мына жерде!
Dialogue: 0,0:12:07.56,0:12:08.72,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:12:09.52,0:12:10.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:10.98,0:12:13.35,Default,,0,0,0,,Қайсысы сүйкімді екенін айта алмаймын...
Dialogue: 0,0:12:13.44,0:12:14.94,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:12:15.86,0:12:17.86,Default,,0,0,0,,Жүр! Міне!
Dialogue: 0,0:12:18.44,0:12:20.94,Default,,0,0,0,,Мұндай шабуыл жұмыс істемейді.
Dialogue: 0,0:12:21.61,0:12:23.61,Default,,0,0,0,,Бұл өте кеш, бірақ
Dialogue: 0,0:12:23.70,0:12:25.70,Default,,0,0,0,,Дүниежүзілік лигаға қатысуыңызбен құттықтаймыз
Dialogue: 0,0:12:25.91,0:12:26.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:26.99,0:12:28.58,Default,,0,0,0,,Мен де бақыттымын.
Dialogue: 0,0:12:29.49,0:12:31.41,Default,,0,0,0,,Инсуке Сен де...
Dialogue: 0,0:12:31.70,0:12:34.58,Default,,0,0,0,,Мен де Балтпен күрескім келді.
Dialogue: 0,0:12:35.08,0:12:35.71,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:12:35.96,0:12:39.04,Default,,0,0,0,,Бір күні тағы да бірге күресетінімізге сенімдімін.
Dialogue: 0,0:12:39.84,0:12:40.92,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:12:41.46,0:12:44.30,Default,,0,0,0,,Сондықтан оған дейін ешқашан жеңілмеу керек.
Dialogue: 0,0:12:47.09,0:12:47.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:49.10,0:12:52.39,Default,,0,0,0,,Вакияның үйінде керемет мүмкіндіктер бар.
Dialogue: 0,0:12:52.73,0:12:54.06,Default,,0,0,0,,Қарапайым немесе қарапайым
Dialogue: 0,0:12:54.14,0:12:56.35,Default,,0,0,0,,Барлық жапон үйлері осындай.
Dialogue: 0,0:12:56.52,0:12:57.35,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:57.44,0:13:00.15,Default,,0,0,0,,Жоқ, бұл жер ерекше.
Dialogue: 0,0:13:00.40,0:13:02.40,Default,,0,0,0,,Маған үй шаруасы жоқ.
Dialogue: 0,0:13:02.82,0:13:05.15,Default,,0,0,0,,Шака қарсы шаралар және тәжірибе!
Dialogue: 0,0:13:05.61,0:13:07.03,Default,,0,0,0,,Бұл бұрынғы бейне
Dialogue: 0,0:13:08.12,0:13:09.78,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:13:09.87,0:13:11.54,Default,,0,0,0,,Үш есе әсер ету!
Dialogue: 0,0:13:14.29,0:13:15.87,Default,,0,0,0,,(бір-біріне үйкелу дыбысы)
Dialogue: 0,0:13:16.92,0:13:19.21,Default,,0,0,0,,Мұны бірінші рет Экскалибур жасады ма?
Dialogue: 0,0:13:19.79,0:13:21.84,Default,,0,0,0,,Үш есе әсер ету күші арқасында
Dialogue: 0,0:13:22.21,0:13:23.71,Default,,0,0,0,,Өлшеу мүмкін
Dialogue: 0,0:13:24.63,0:13:26.68,Default,,0,0,0,,Infinite Bay стадионының күші
Dialogue: 0,0:13:26.76,0:13:29.80,Default,,0,0,0,,Оны Triple Impact қуатымен бірдей етіп орнатыңыз.
Dialogue: 0,0:13:29.89,0:13:30.68,Default,,0,0,0,,Иә
Dialogue: 0,0:13:31.43,0:13:33.85,Default,,0,0,0,,(Айналмалы шығанақ дыбысы)
Dialogue: 0,0:13:34.43,0:13:36.23,Default,,0,0,0,,Мына жігітті ұшырып жіберсең
Dialogue: 0,0:13:36.31,0:13:38.60,Default,,0,0,0,,Бұл Excalibur-ді жеңе алатыныңызды білдіре ме?
Dialogue: 0,0:13:38.81,0:13:40.56,Default,,0,0,0,,Жарайды, мен істеймін!
Dialogue: 0,0:13:40.86,0:13:42.23,Default,,0,0,0,,Алдымен Вай
Dialogue: 0,0:13:42.48,0:13:43.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:43.48,0:13:46.78,Default,,0,0,0,,Вакия мырза, жаңа арнайы қозғалысты қолданып көріңіз.
Dialogue: 0,0:13:47.53,0:13:49.28,Default,,0,0,0,,Жаңа ерекше қозғалыс! ?
Dialogue: 0,0:13:49.74,0:13:51.24,Default,,0,0,0,,Қараңыз.
Dialogue: 0,0:13:51.33,0:13:52.99,Default,,0,0,0,,Ходжи Шиндо Сасаки
Dialogue: 0,0:13:53.12,0:13:55.41,Default,,0,0,0,,Мен шынымен күштімін!
Dialogue: 0,0:13:55.50,0:13:56.16,Default,,0,0,0,,Ботчан
Dialogue: 0,0:13:57.29,0:13:58.71,Default,,0,0,0,,Жүр, кеттік!
Dialogue: 0,0:13:59.54,0:14:00.71,Default,,0,0,0,,(Айналмалы шығанақ дыбысы)
Dialogue: 0,0:14:00.79,0:14:02.38,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:14:02.92,0:14:04.63,Default,,0,0,0,,Бір соққымен жарылды...
Dialogue: 0,0:14:05.26,0:14:08.34,Default,,0,0,0,,Бала! Бұл техника... сіз жеңе аласыз!
Dialogue: 0,0:14:08.43,0:14:11.64,Default,,0,0,0,,Қарапайым, кәдімгі нәрсе, тіпті күле алмаймын.
Dialogue: 0,0:14:12.05,0:14:13.43,Default,,0,0,0,,Эх-хэ-хэ
Dialogue: 0,0:14:13.51,0:14:15.43,Default,,0,0,0,,Күлемін, бірақ... Ах!
Dialogue: 0,0:14:15.72,0:14:18.23,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:14:24.48,0:14:26.65,Default,,0,0,0,,Менің аяғым жансызданып қалды
Dialogue: 0,0:14:26.74,0:14:27.90,Default,,0,0,0,,Мен енді мұны істей алмаймын.
Dialogue: 0,0:14:28.49,0:14:31.87,Default,,0,0,0,,Зазен кезінде дыбысты көтеру сізде жаттығудың жеткіліксіздігін білдіреді.
Dialogue: 0,0:14:32.16,0:14:34.58,Default,,0,0,0,,Жақсы! Келесі кезекте ату жаттығуы
Dialogue: 0,0:14:34.99,0:14:38.00,Default,,0,0,0,,Мен сені соңғы рет кездестіргеніме көп уақыт болды. Юго, ал.
Dialogue: 0,0:14:38.08,0:14:39.96,Default,,0,0,0,,Иә (Фубуки Укио) Иә
Dialogue: 0,0:14:40.46,0:14:41.42,Default,,0,0,0,,Комурасаки
Dialogue: 0,0:14:41.67,0:14:44.21,Default,,0,0,0,,Мен міндетті түрде үштік әсерге қарсы шара қолданамын.
Dialogue: 0,0:14:44.67,0:14:47.97,Default,,0,0,0,,Экскалибур қарсы шараларды қажет ететін шығанақ емес.
Dialogue: 0,0:14:48.26,0:14:49.68,Default,,0,0,0,,Гах ха ха
Dialogue: 0,0:14:50.18,0:14:51.97,Default,,0,0,0,,...
Dialogue: 0,0:14:52.14,0:14:52.64,Default,,0,0,0,,Иә
Dialogue: 0,0:14:52.76,0:14:55.68,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:14:55.76,0:14:59.60,Default,,0,0,0,,Әлемдік лиганың финалдық турнирі!
Dialogue: 0,0:14:59.69,0:15:04.06,Default,,0,0,0,,Реал Самбат пен Бразилия Риос кездесуі.
Dialogue: 0,0:15:04.90,0:15:07.69,Default,,0,0,0,,Бүгін біз Жапония турниріне тікелей эфирде арнайы түсініктеме жасадық.
Dialogue: 0,0:15:07.78,0:15:10.78,Default,,0,0,0,,Мен Анами дикторымен тікелей түсініктеме жасаймын.
Dialogue: 0,0:15:10.86,0:15:11.49,Default,,0,0,0,,Бұл Анами.
Dialogue: 0,0:15:12.82,0:15:13.57,Default,,0,0,0,,Бұл құрмет!
Dialogue: 0,0:15:13.78,0:15:15.87,Default,,0,0,0,,Енді бірінші ойын...
Dialogue: 0,0:15:15.95,0:15:19.33,Default,,0,0,0,,Реалдан Джанго Матадор!
Dialogue: 0,0:15:19.75,0:15:20.71,Default,,0,0,0,,Риос-
Dialogue: 0,0:15:20.79,0:15:22.17,Default,,0,0,0,,Стэн Гамбург!
Dialogue: 0,0:15:22.37,0:15:23.96,Default,,0,0,0,,Енді ең жақсы достардың кездесуінің уақыты келді.
Dialogue: 0,0:15:24.63,0:15:26.96,Default,,0,0,0,,Уақыт келді, Стэн.
Dialogue: 0,0:15:27.42,0:15:30.05,Default,,0,0,0,,Джанго, сені жеңе алатын жалғыз адам -
Dialogue: 0,0:15:30.30,0:15:31.93,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:15:32.89,0:15:33.80,Default,,0,0,0,,Жоғарыдағылар не ойлап отыр екен? Трост ауданына кіру – тек бекер өлімге апарады.
Dialogue: 0,0:15:34.51,0:15:37.81,Default,,0,0,0,,Джанго Стэн екеуі де жеңді~
Dialogue: 0,0:15:37.89,0:15:40.43,Default,,0,0,0,,Бар-нии, екеуміз де жеңе алмаймыз.
Dialogue: 0,0:15:40.77,0:15:42.23,Default,,0,0,0,,Сіз қай жағын қолдайсыз?
Dialogue: 0,0:15:42.60,0:15:44.19,Default,,0,0,0,,Бүгін екеуі де.
Dialogue: 0,0:15:44.31,0:15:45.81,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:15:45.94,0:15:46.94,Default,,0,0,0,,Сен кімсің? Және неге Буггаратиды білесің?
Dialogue: 0,0:15:47.19,0:15:49.07,Default,,0,0,0,,Екеуі де жеңеді~
Dialogue: 0,0:15:50.03,0:15:50.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:50.99,0:15:53.91,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:15:54.37,0:15:55.24,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:55.53,0:15:57.24,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:15:57.37,0:15:58.49,Default,,0,0,0,,Үш
Dialogue: 0,0:15:58.58,0:15:59.70,Default,,0,0,0,,Екі
Dialogue: 0,0:15:59.79,0:16:00.91,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:16:01.00,0:16:02.08,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:16:02.21,0:16:02.96,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:16:03.54,0:16:06.17,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:06.25,0:16:07.25,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:16:09.46,0:16:10.67,Default,,0,0,0,,Жабысқақ!
Dialogue: 0,0:16:10.97,0:16:12.30,Default,,0,0,0,,Онда!
Dialogue: 0,0:16:12.38,0:16:13.38,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:16:14.39,0:16:16.39,Default,,0,0,0,,Бірінші ойында кім жеңді?
Dialogue: 0,0:16:16.47,0:16:18.26,Default,,0,0,0,,Стэн Гамбург!
Dialogue: 0,0:16:18.35,0:16:21.02,Default,,0,0,0,,Кууу! Қабілеттері дерлік бірдей болды.
Dialogue: 0,0:16:21.10,0:16:23.23,Default,,0,0,0,,Иә! Бірақ ойын аяусыз
Dialogue: 0,0:16:23.31,0:16:25.27,Default,,0,0,0,,Біреу жеңеді, біреу жеңіледі!
Dialogue: 0,0:16:28.27,0:16:29.36,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:16:30.36,0:16:31.82,Default,,0,0,0,,Екінші ойын –
Dialogue: 0,0:16:31.90,0:16:34.36,Default,,0,0,0,,Жанып тұрған ғибадатхананың Кайзасы Атару Окинаканы басып алды!
Dialogue: 0,0:16:34.61,0:16:36.78,Default,,0,0,0,,Бұл керемет күш тактикасы.
Dialogue: 0,0:16:36.87,0:16:38.41,Default,,0,0,0,,Үш есе әсер ету!
Dialogue: 0,0:16:38.49,0:16:42.16,Default,,0,0,0,,Бұл тым күшті. Үлкен бестіктен күткендей!
Dialogue: 0,0:16:47.50,0:16:49.92,Default,,0,0,0,,Алайда үшінші ойында Комурасаки Вакия...
Dialogue: 0,0:16:50.63,0:16:52.92,Default,,0,0,0,,Өтпейтін қорғаныспен қалпына келтірілді
Dialogue: 0,0:16:53.01,0:16:55.93,Default,,0,0,0,,Керемет! Ойын саны енді 1-ден 2-ге дейін.
Dialogue: 0,0:16:56.89,0:16:59.01,Default,,0,0,0,,Көңіліңізді түсірмеңіз. Тағы екі ойын қалды.
Dialogue: 0,0:16:59.10,0:17:00.68,Default,,0,0,0,,Мен жеңемін!
Dialogue: 0,0:17:02.02,0:17:03.18,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:17:06.10,0:17:07.40,Default,,0,0,0,,Уакия қайтадан
Dialogue: 0,0:17:10.11,0:17:11.40,Default,,0,0,0,,Бұл Шака!
Dialogue: 0,0:17:11.90,0:17:13.07,Default,,0,0,0,,Лувей ше?
Dialogue: 0,0:17:13.53,0:17:15.03,Default,,0,0,0,,Ол неге шықпайды?
Dialogue: 0,0:17:15.49,0:17:17.57,Default,,0,0,0,,Шака мұны Уакиямен жасағысы келеді.
Dialogue: 0,0:17:17.91,0:17:20.24,Default,,0,0,0,,Эй, мен сенің сезіміңді білемін.
Dialogue: 0,0:17:20.41,0:17:21.99,Default,,0,0,0,,Шака сияқты естіледі.
Dialogue: 0,0:17:22.66,0:17:25.29,Default,,0,0,0,,Шака, қолыңнан келгенін істе! Вакия, қолыңнан келгенін істе!
Dialogue: 0,0:17:25.79,0:17:27.29,Default,,0,0,0,,Екеуі де жеңе алады!
Dialogue: 0,0:17:28.67,0:17:30.67,Default,,0,0,0,,Бұл жапондық кезең-
Dialogue: 0,0:17:30.75,0:17:33.67,Default,,0,0,0,,Мен шыңға жүгіретін трамплин
Dialogue: 0,0:17:34.17,0:17:36.51,Default,,0,0,0,,Шақа, мен сені алысқа апармаймын.
Dialogue: 0,0:17:36.76,0:17:38.64,Default,,0,0,0,,Маған бас!
Dialogue: 0,0:17:40.14,0:17:43.77,Default,,0,0,0,,Мені таптасаң ше?
Dialogue: 0,0:17:46.52,0:17:49.69,Default,,0,0,0,,4-ойын Бірінші шайқас
Dialogue: 0,0:17:51.82,0:17:53.57,Default,,0,0,0,,Үш еселік әсерге қарсы шаралар –
Dialogue: 0,0:17:53.90,0:17:54.99,Default,,0,0,0,,Декитонная!
Dialogue: 0,0:17:55.99,0:17:57.61,Default,,0,0,0,,Вакияны жеңіңіз
Dialogue: 0,0:17:57.86,0:17:59.95,Default,,0,0,0,,Менің стратегиям тамаша
Dialogue: 0,0:18:00.24,0:18:02.03,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:18:02.12,0:18:03.24,Default,,0,0,0,,Үш
Dialogue: 0,0:18:03.33,0:18:04.45,Default,,0,0,0,,Екі
Dialogue: 0,0:18:04.54,0:18:05.66,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:18:06.08,0:18:07.29,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:18:07.37,0:18:08.12,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:18:08.21,0:18:09.12,Default,,0,0,0,,Міне, сол жаққа қара, Хагакуре-сан!
Dialogue: 0,0:18:09.21,0:18:11.63,Default,,0,0,0,,Бір-бірімізді күшпен атамыз.
Dialogue: 0,0:18:11.92,0:18:13.50,Default,,0,0,0,,Бар, Вайверн!
Dialogue: 0,0:18:13.59,0:18:16.47,Default,,0,0,0,,Wyvern орталығын алмау
Dialogue: 0,0:18:16.55,0:18:18.51,Default,,0,0,0,,Экскалибур мақсатына жетпей қалды
Dialogue: 0,0:18:19.09,0:18:20.59,Default,,0,0,0,,Алға, жаңа техника!
Dialogue: 0,0:18:22.22,0:18:24.06,Default,,0,0,0,,(Шығу дыбысы)
Dialogue: 0,0:18:27.39,0:18:28.60,Default,,0,0,0,,Инаши қабаты
Dialogue: 0,0:18:28.69,0:18:30.52,Default,,0,0,0,,Стадион қабырғасына соғу арқылы
Dialogue: 0,0:18:30.60,0:18:32.61,Default,,0,0,0,,Центрден тепкіш күшті қолдану және...
Dialogue: 0,0:18:33.32,0:18:35.78,Default,,0,0,0,,Қалай! Уайверн...
Dialogue: 0,0:18:35.86,0:18:38.78,Default,,0,0,0,,Чу Ауада қалқып тұр!
Dialogue: 0,0:18:40.99,0:18:41.66,Default,,0,0,0,,Ах… Эх…
Dialogue: 0,0:18:42.32,0:18:44.49,Default,,0,0,0,,Супер торнадо
Dialogue: 0,0:18:44.70,0:18:45.62,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:18:51.17,0:18:52.25,Default,,0,0,0,,Шешім қабылданды!
Dialogue: 0,0:18:53.71,0:18:54.88,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:19:00.84,0:19:01.84,Default,,0,0,0,,Таэро!
Dialogue: 0,0:19:05.35,0:19:05.89,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:19:06.14,0:19:07.89,Default,,0,0,0,,Енді менің кезегім
Dialogue: 0,0:19:28.37,0:19:30.54,Default,,0,0,0,,Келіңіздер! жарылсын
Dialogue: 0,0:19:31.33,0:19:32.25,Default,,0,0,0,,(толқынды дыбыс)
Dialogue: 0,0:19:32.75,0:19:34.25,Default,,0,0,0,,Яаа!
Dialogue: 0,0:19:39.67,0:19:40.80,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:42.55,0:19:43.34,Default,,0,0,0,,Ха...
Dialogue: 0,0:19:43.93,0:19:45.93,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:19:46.56,0:19:49.43,Default,,0,0,0,,Sieg Excalibur Burst Finish
Dialogue: 0,0:19:49.56,0:19:51.52,Default,,0,0,0,,Кайза Шәкенджінің жеңісі!
Dialogue: 0,0:19:51.60,0:19:54.35,Default,,0,0,0,,Жеңімпаз Бразилия Риосы!
Dialogue: 0,0:19:54.44,0:19:55.98,Default,,0,0,0,,Ойын саны 3-тен 1-ге дейін
Dialogue: 0,0:19:56.06,0:19:58.57,Default,,0,0,0,,Біз жартылай финалға өттік!
Dialogue: 0,0:19:58.73,0:19:59.90,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:01.03,0:20:01.95,Default,,0,0,0,,Бала...
Dialogue: 0,0:20:05.91,0:20:06.83,Default,,0,0,0,,Куу...
Dialogue: 0,0:20:09.70,0:20:12.12,Default,,0,0,0,,Нағыз самбат Бетіңізді көтеріңіз!
Dialogue: 0,0:20:14.63,0:20:15.29,Default,,0,0,0,,Шака
Dialogue: 0,0:20:15.71,0:20:17.79,Default,,0,0,0,,Келесі жолы мен міндетті түрде жеңемін!
Dialogue: 0,0:20:18.84,0:20:19.38,Default,,0,0,0,,Хмф!
Dialogue: 0,0:20:20.46,0:20:22.67,Default,,0,0,0,,Сондықтан мен ұлмын.
Dialogue: 0,0:20:23.05,0:20:25.43,Default,,0,0,0,,Мен...шынымен күйіп тұрмын.
Dialogue: 0,0:20:25.55,0:20:26.68,Default,,0,0,0,,Мен де!
Dialogue: 0,0:20:27.01,0:20:29.14,Default,,0,0,0,,Ей, қазір шайқасайық.
Dialogue: 0,0:20:29.26,0:20:30.27,Default,,0,0,0,,Шитеее!
Dialogue: 0,0:20:30.60,0:20:34.27,Default,,0,0,0,,Triple Impact шынымен менің көзімді өртеп жіберді.
Dialogue: 0,0:20:36.06,0:20:38.36,Default,,0,0,0,,Балто! Сіз келесідесіз
Dialogue: 0,0:20:40.03,0:20:42.57,Default,,0,0,0,,Қалай болғанда да, Валькири жеңеді!
Dialogue: 0,0:20:42.95,0:20:44.24,Default,,0,0,0,,Маған жауап бер!
Dialogue: 0,0:20:52.58,0:20:54.67,Default,,0,0,0,,(тас есіктің ашылған дыбысы)
Dialogue: 0,0:20:58.50,0:21:01.00,Default,,0,0,0,,Мен аман қалдым
Dialogue: 0,0:21:01.59,0:21:04.72,Default,,0,0,0,,Жылан шұңқырындағы пышақтарды жеңу
Dialogue: 0,0:21:04.84,0:21:07.09,Default,,0,0,0,,Жарайсың, осы уақытқа дейін келдің, Боа.
Dialogue: 0,0:21:07.55,0:21:09.55,Default,,0,0,0,,Бірақ әлі біткен жоқ
Dialogue: 0,0:21:14.14,0:21:14.64,Default,,0,0,0,,Уф
Dialogue: 0,0:21:15.02,0:21:17.15,Default,,0,0,0,,(үру)
Dialogue: 0,0:21:20.52,0:21:22.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:23.19,0:21:23.94,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:27.28,0:21:28.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:29.53,0:21:31.95,Default,,0,0,0,,Арқа Бахамут менікі!
Dialogue: 0,0:21:34.79,0:21:38.00,Default,,0,0,0,,Қызыл көз - пышақтарды аулайды.
Dialogue: 0,0:21:38.79,0:21:41.42,Default,,0,0,0,,Боа, қызыл көзді қу
Dialogue: 0,0:21:42.09,0:21:44.09,Default,,0,0,0,,Және одан асып түс.
Dialogue: 0,0:21:44.42,0:21:47.80,Default,,0,0,0,,Сіз ең күшті Blader боласыз!
Dialogue: 0,0:21:49.34,0:21:50.30,Default,,0,0,0,,Нуо!
Dialogue: 0,0:21:55.85,0:21:57.77,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:21:58.23,0:22:00.02,Default,,0,0,0,,Негіздерге дайынсыз ба?
Dialogue: 0,0:22:00.11,0:22:02.94,Default,,0,0,0,,Енді күте тұрыңыз, Baysasize 2 уақыты келді.
Dialogue: 0,0:22:03.19,0:22:05.03,Default,,0,0,0,,Қозғалыс 1 нұсқаға қарағанда жылдамырақ.
Dialogue: 0,0:22:05.11,0:22:06.99,Default,,0,0,0,,Алдымен алдыңғы эпизодты қарастырайық. Көрсетілім уақыты!
Dialogue: 0,0:22:07.07,0:22:08.41,Default,,0,0,0,,Бар!
Dialogue: 0,0:22:08.49,0:22:10.66,Default,,0,0,0,,Бар! үлкен
Dialogue: 0,0:22:10.74,0:22:12.49,Default,,0,0,0,,Бар!
Dialogue: 0,0:22:12.62,0:22:14.37,Default,,0,0,0,,Бар! жылдамдату
Dialogue: 0,0:22:14.45,0:22:16.20,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:16.29,0:22:18.08,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:18.17,0:22:19.71,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:19.79,0:22:21.46,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:21.54,0:22:23.21,Default,,0,0,0,,Ха, ха, ха, жақсы емес пе?
Dialogue: 0,0:22:23.30,0:22:24.84,Default,,0,0,0,,Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.92,0:22:26.67,Default,,0,0,0,,Бұл жерден нашарлай түседі.
Dialogue: 0,0:22:26.76,0:22:28.84,Default,,0,0,0,,Бірақ мен шиеленісті көтеремін.
Dialogue: 0,0:22:28.93,0:22:30.89,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:30.97,0:22:32.85,Default,,0,0,0,,Моримори шығанақ сызығын дамытты
Dialogue: 0,0:22:32.93,0:22:34.68,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:34.77,0:22:36.48,Default,,0,0,0,,Менің атқаным – құдайдың атысы
Dialogue: 0,0:22:36.56,0:22:38.39,Default,,0,0,0,,Оң аяқ киім! Сол аяқ киім!
Dialogue: 0,0:22:38.48,0:22:40.23,Default,,0,0,0,,Оң жақта уф! Уф!
Dialogue: 0,0:22:40.31,0:22:42.31,Default,,0,0,0,,Сол аяқ киім! Дұрыс аяқ киім!
Dialogue: 0,0:22:42.40,0:22:43.86,Default,,0,0,0,,Сол жақта жабыңыз! Уф!
Dialogue: 0,0:22:43.94,0:22:45.78,Default,,0,0,0,,Өткен аптада! осы аптада!
Dialogue: 0,0:22:45.86,0:22:47.61,Default,,0,0,0,,Біз істеп жатырмыз Түсіріңіз!
Dialogue: 0,0:22:47.69,0:22:49.40,Default,,0,0,0,,Осы аптада! келесі апта!
Dialogue: 0,0:22:49.53,0:22:51.32,Default,,0,0,0,,Оның да істеп жүргені сол, Бар ат!
Dialogue: 0,0:22:51.41,0:22:53.16,Default,,0,0,0,,Күн сайын! жаттығу!
Dialogue: 0,0:22:53.24,0:22:55.20,Default,,0,0,0,,Барлығы істеп жатыр Go Shoot!
Dialogue: 0,0:22:55.29,0:22:56.83,Default,,0,0,0,,Көктем/жаз! Күз/қыс!
Dialogue: 0,0:22:56.91,0:22:58.50,Default,,0,0,0,,Түсіріңіз!
Dialogue: 0,0:22:58.58,0:23:00.08,Default,,0,0,0,,Хмм жарайды!
Dialogue: 0,0:23:00.17,0:23:02.71,Default,,0,0,0,,Негізгі бұлшықеттерді дамыту үшін күнделікті жаттығулар қажет.
Dialogue: 0,0:23:02.79,0:23:05.92,Default,,0,0,0,,Осы шиеленіспен біз шарықтау шегіне жетеміз.
Dialogue: 0,0:23:06.00,0:23:08.97,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:09.05,0:23:09.72,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:23:09.80,0:23:12.51,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:12.59,0:23:13.22,Default,,0,0,0,,Кеттік
Dialogue: 0,0:23:13.30,0:23:17.14,Default,,0,0,0,,1 2 3 4 Бар! Барайық!
Dialogue: 0,0:23:17.22,0:23:17.72,Default,,0,0,0,,Үш
Dialogue: 0,0:23:18.10,0:23:18.60,Default,,0,0,0,,Екі
Dialogue: 0,0:23:18.81,0:23:19.89,Default,,0,0,0,,One Go аяқ киім!
Dialogue: 0,0:23:20.52,0:23:21.98,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.06,0:23:25.15,Default,,0,0,0,,Керемет түсіріңіз! Керемет негіз!
Dialogue: 0,0:23:25.65,0:23:28.78,Default,,0,0,0,,Тоқта! Қан сормаңыз!
Dialogue: 0,0:23:29.24,0:23:31.32,Default,,0,0,0,,Вампирлер түсінде де қорқынышты!
Dialogue: 0,0:23:31.57,0:23:35.03,Default,,0,0,0,,Бірақ Куузаның танысуы шын болған сияқты.
Dialogue: 0,0:23:35.33,0:23:37.87,Default,,0,0,0,,Оның үстіне ол Динаның командасына қосылды.
Dialogue: 0,0:23:38.08,0:23:41.50,Default,,0,0,0,,Шинигами мен вампирдің үйлесімі өте қауіпті!
Dialogue: 0,0:23:41.87,0:23:43.92,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:44.17,0:23:46.25,Default,,0,0,0,,Вампир! Терең хаос! !
Dialogue: 0,0:23:46.42,0:23:49.92,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.42,0:23:57.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory