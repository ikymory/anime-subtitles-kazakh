Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.21,0:00:05.21,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.00,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.68,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.22,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.68,0:00:24.06,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.52,0:00:27.81,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.90,0:00:30.36,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:32.28,0:00:34.99,Default,,0,0,0,,Біз үшін Құдайдың жүздері кубогы өтеді.
Dialogue: 0,0:00:35.07,0:00:37.62,Default,,0,0,0,,Америкаға кел! Сондықтан мен...
Dialogue: 0,0:00:37.74,0:00:39.78,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:39.87,0:00:43.04,Default,,0,0,0,,Жер асты әлемінің императоры ретінде белгілі бұрынғы әлем чемпионы
Dialogue: 0,0:00:43.12,0:00:45.37,Default,,0,0,0,,Мен Курц Баратьемен таныстым.
Dialogue: 0,0:00:45.46,0:00:47.46,Default,,0,0,0,,Мен әлем чемпионымын
Dialogue: 0,0:00:47.75,0:00:50.50,Default,,0,0,0,,Менен күшті ешкім жоқ.
Dialogue: 0,0:00:50.75,0:00:52.92,Default,,0,0,0,,Бұл көп уақыт бұрын
Dialogue: 0,0:00:53.42,0:00:56.13,Default,,0,0,0,,Әй, хабардар болыңыз.
Dialogue: 0,0:00:58.05,0:00:59.26,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:01:00.06,0:01:04.35,Default,,0,0,0,,Сонымен, Құдайдың жүздері кубогы басталады.
Dialogue: 0,0:01:06.94,0:01:10.61,Default,,0,0,0,,Соңғысы - Арнайы пышақ...
Dialogue: 0,0:01:10.69,0:01:17.07,Default,,0,0,0,,Аты аңызға айналған әлем чемпионы Курц Баратье!
Dialogue: 0,0:01:17.20,0:01:18.41,Default,,0,0,0,,Курц!
Dialogue: 0,0:01:18.87,0:01:19.91,Default,,0,0,0,,Иә
Dialogue: 0,0:01:24.45,0:01:27.12,Default,,0,0,0,,♪~
Dialogue: 0,0:01:27.21,0:01:29.46,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:29.54,0:01:32.13,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:32.21,0:01:34.59,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:34.67,0:01:37.13,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:37.22,0:01:38.89,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:38.97,0:01:43.10,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:44.06,0:01:48.81,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:48.90,0:01:53.65,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:53.94,0:01:58.66,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:58.74,0:02:03.70,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:03.79,0:02:08.58,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:08.67,0:02:13.84,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:13.92,0:02:17.05,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:17.13,0:02:18.68,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:18.76,0:02:21.14,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:21.22,0:02:23.51,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:23.60,0:02:25.72,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:25.81,0:02:27.06,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:27.14,0:02:28.73,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:28.81,0:02:31.19,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:31.27,0:02:37.44,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:37.53,0:02:41.70,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:41.78,0:02:44.70,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:44.78,0:02:47.08,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:47.16,0:02:49.71,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:49.79,0:02:53.46,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:55.09,0:02:57.59,Default,,0,0,0,,Тиран! Кукулканды жеңіңіз!
Dialogue: 0,0:02:59.80,0:03:02.55,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:03:02.97,0:03:06.47,Default,,0,0,0,,God Bladers Cup A топтық матч картасы-
Dialogue: 0,0:03:06.56,0:03:07.77,Default,,0,0,0,,Хабарландыру!
Dialogue: 0,0:03:07.85,0:03:09.43,Default,,0,0,0,,Бірінші ойын –
Dialogue: 0,0:03:10.64,0:03:13.81,Default,,0,0,0,,Курц Баратье және Барт Аои!
Dialogue: 0,0:03:13.90,0:03:15.23,Default,,0,0,0,,Курц!
Dialogue: 0,0:03:18.36,0:03:21.07,Default,,0,0,0,,Жеңілген қарсыластың шығанағын ұрлайтын шайқас.
Dialogue: 0,0:03:21.15,0:03:23.49,Default,,0,0,0,,Мен... мен сені ешқашан кешірмеймін.
Dialogue: 0,0:03:23.99,0:03:25.99,Default,,0,0,0,,Аники, жақсысың ба?
Dialogue: 0,0:03:26.08,0:03:28.91,Default,,0,0,0,,Ах! Мен кім болса да жеңемін
Dialogue: 0,0:03:29.00,0:03:30.91,Default,,0,0,0,,Содан кейін екінші сәйкестік
Dialogue: 0,0:03:31.37,0:03:34.67,Default,,0,0,0,,Қызыл көз Боа Алькасерге қарсы
Dialogue: 0,0:03:35.50,0:03:36.46,Default,,0,0,0,,Шу…
Dialogue: 0,0:03:37.92,0:03:40.17,Default,,0,0,0,,Әрі қарай! Үшінші ойын -
Dialogue: 0,0:03:40.26,0:03:44.43,Default,,0,0,0,,Куза Акерман Норман Тарверге қарсы
Dialogue: 0,0:03:44.51,0:03:47.06,Default,,0,0,0,,Менің қарсыласым Норман Тарвер ме?
Dialogue: 0,0:03:47.14,0:03:48.56,Default,,0,0,0,,Тарбака!
Dialogue: 0,0:03:48.64,0:03:50.52,Default,,0,0,0,,Қандай адам...?
Dialogue: 0,0:03:50.60,0:03:53.90,Default,,0,0,0,,А тобы Мен сенен бір секунд болса да көзімді ала алмаймын
Dialogue: 0,0:03:53.98,0:03:56.40,Default,,0,0,0,,Бұл ең жақсы сәйкестік картасы!
Dialogue: 0,0:03:56.48,0:03:59.32,Default,,0,0,0,,Таң атқан таңы!
Dialogue: 0,0:04:00.03,0:04:01.11,Default,,0,0,0,,(Чат)
Dialogue: 0,0:04:01.19,0:04:02.86,Default,,0,0,0,,Не болды? Не болды?
Dialogue: 0,0:04:03.03,0:04:07.08,Default,,0,0,0,,Император Курц келе жатыр.
Dialogue: 0,0:04:15.54,0:04:17.38,Default,,0,0,0,,Их хи хи хи
Dialogue: 0,0:04:18.96,0:04:21.46,Default,,0,0,0,,Юкай Юкай! …иә?
Dialogue: 0,0:04:24.30,0:04:26.34,Default,,0,0,0,,Эй (мүше) О!
Dialogue: 0,0:04:30.27,0:04:32.81,Default,,0,0,0,,(дөрекі күлкі)
Dialogue: 0,0:04:35.90,0:04:39.27,Default,,0,0,0,,Қызыл көз, мен сені кездестірдім.
Dialogue: 0,0:04:40.07,0:04:43.24,Default,,0,0,0,,Менің ойын алаңымды бұзғаныңызды естідім.
Dialogue: 0,0:04:55.62,0:04:57.54,Default,,0,0,0,,Бәрі бітті ме?
Dialogue: 0,0:04:57.96,0:05:01.09,Default,,0,0,0,,Мен рахмет айту үшін жол бойы келдім.
Dialogue: 0,0:05:02.51,0:05:05.34,Default,,0,0,0,,Сәлем! Шикато, мұнда келме!
Dialogue: 0,0:05:06.80,0:05:08.55,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:05:08.89,0:05:11.01,Default,,0,0,0,,Бұл қиын, Балто!
Dialogue: 0,0:05:11.10,0:05:12.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:15.52,0:05:16.77,Default,,0,0,0,,Қызыл көз
Dialogue: 0,0:05:17.52,0:05:19.23,Default,,0,0,0,,Сенің көздерің
Dialogue: 0,0:05:20.57,0:05:23.28,Default,,0,0,0,,Қараңғылықты көрген көздер
Dialogue: 0,0:05:23.86,0:05:26.78,Default,,0,0,0,,Мен сені жек көрмеймін, бірақ...
Dialogue: 0,0:05:26.86,0:05:28.74,Default,,0,0,0,,Шу! иә?
Dialogue: 0,0:05:28.82,0:05:30.41,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:05:30.66,0:05:31.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:31.74,0:05:33.16,Default,,0,0,0,,(Сора) Сол жақтағы қарт кітапханада мені бақылап тұрды—
Dialogue: 0,0:05:33.24,0:05:34.45,Default,,0,0,0,,Шумен не істеп жүрсің?
Dialogue: 0,0:05:34.95,0:05:36.00,Default,,0,0,0,,Tsk
Dialogue: 0,0:05:39.21,0:05:40.21,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:05:40.92,0:05:42.67,Default,,0,0,0,,Әңгіме әлі біткен жоқ.
Dialogue: 0,0:05:42.92,0:05:43.88,Default,,0,0,0,,Tsk
Dialogue: 0,0:05:44.13,0:05:45.76,Default,,0,0,0,,Шуды босат!
Dialogue: 0,0:05:45.84,0:05:46.84,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:46.92,0:05:48.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:48.47,0:05:49.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:50.22,0:05:51.43,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:05:52.10,0:05:53.77,Default,,0,0,0,,Күте тұрыңыз... Осымен.
Dialogue: 0,0:05:54.06,0:05:55.10,Default,,0,0,0,,Керемет, Карл.
Dialogue: 0,0:05:55.18,0:05:56.39,Default,,0,0,0,,Жаса!
Dialogue: 0,0:05:56.81,0:05:57.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:58.02,0:06:00.77,Default,,0,0,0,,(қол ысқырығы)
Dialogue: 0,0:06:02.19,0:06:03.40,Default,,0,0,0,,Қазір!
Dialogue: 0,0:06:04.28,0:06:06.44,Default,,0,0,0,,Теме және т.б. Мен сені тірі қалдыра алмаймын.
Dialogue: 0,0:06:06.53,0:06:08.99,Default,,0,0,0,,Сәлем! Сіз не сезінесіз?
Dialogue: 0,0:06:10.37,0:06:11.53,Default,,0,0,0,,Шу!
Dialogue: 0,0:06:12.41,0:06:14.04,Default,,0,0,0,,Сіз комбинацияны көрдіңіз бе?
Dialogue: 0,0:06:14.99,0:06:16.87,Default,,0,0,0,,Біз бір А тобында болдық.
Dialogue: 0,0:06:18.62,0:06:19.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:20.29,0:06:22.96,Default,,0,0,0,,Мен туралы не ойласаң да
Dialogue: 0,0:06:23.04,0:06:25.17,Default,,0,0,0,,Мен күресуді асыға күтемін!
Dialogue: 0,0:06:25.55,0:06:28.22,Default,,0,0,0,,Қызыл көзді жеңетін менмін.
Dialogue: 0,0:06:31.34,0:06:34.18,Default,,0,0,0,,Ах! Оиланың қарсыласы!
Dialogue: 0,0:06:34.26,0:06:35.85,Default,,0,0,0,,Мен сенімдімін Норман...
Dialogue: 0,0:06:36.14,0:06:37.98,Default,,0,0,0,,Норман Тарвер.
Dialogue: 0,0:06:38.48,0:06:42.11,Default,,0,0,0,,Ғұн Жылан шұңқырында оны Алтын көз деп атаған.
Dialogue: 0,0:06:43.65,0:06:44.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:44.86,0:06:46.28,Default,,0,0,0,,Бұл жарқыраған маска!
Dialogue: 0,0:06:49.61,0:06:50.86,Default,,0,0,0,,Әй Шу!
Dialogue: 0,0:06:57.04,0:06:59.96,Default,,0,0,0,,Қызыл көз менің олжам, есіңде болсын.
Dialogue: 0,0:07:00.87,0:07:05.50,Default,,0,0,0,,Сонымен бұл турнирге Жылан шұңқырынан үш адам қатысып жатыр ма?
Dialogue: 0,0:07:06.55,0:07:09.01,Default,,0,0,0,,Мен жеңілмеймін, Норман Тарвер
Dialogue: 0,0:07:10.55,0:07:12.51,Default,,0,0,0,,А тобы да, В тобы да
Dialogue: 0,0:07:13.26,0:07:16.72,Default,,0,0,0,,Финалдық турнирге тек үздік екеуі ғана қатыса алады, солай ма?
Dialogue: 0,0:07:17.31,0:07:20.14,Default,,0,0,0,,Кімнің жеңетіні маңызды емес.
Dialogue: 0,0:07:20.23,0:07:23.52,Default,,0,0,0,,Өйткені Блейдерлер дарынды адамдарға толы.
Dialogue: 0,0:07:24.40,0:07:27.78,Default,,0,0,0,,Осы балалардың бәрі қалатын болса, мен бақытты болар едім...
Dialogue: 0,0:07:28.69,0:07:31.20,Default,,0,0,0,,Сіз оларға сенбейсіз бе?
Dialogue: 0,0:07:31.57,0:07:34.87,Default,,0,0,0,,Көп нәрсе болды, солай ма? Балтық…
Dialogue: 0,0:07:34.95,0:07:36.41,Default,,0,0,0,,Фофофу
Dialogue: 0,0:07:36.49,0:07:38.29,Default,,0,0,0,,Бұл күлкі емес.
Dialogue: 0,0:07:38.37,0:07:40.20,Default,,0,0,0,,Бұл Балто болса жақсы.
Dialogue: 0,0:07:40.46,0:07:41.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:41.50,0:07:45.75,Default,,0,0,0,,Біздің жұмысымыз – «біз сенетін нәрсені істеу».
Dialogue: 0,0:07:46.67,0:07:49.76,Default,,0,0,0,,«Алтын көз» «Қызыл көз».
Dialogue: 0,0:07:50.55,0:07:51.72,Default,,0,0,0,,Сен бұны істей аласың ба?
Dialogue: 0,0:07:52.22,0:07:53.47,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:07:53.55,0:07:55.01,Default,,0,0,0,,Мен сенемін.
Dialogue: 0,0:07:55.68,0:07:59.77,Default,,0,0,0,,Сіз оны жылан шұңқырының басына қайта аласыз.
Dialogue: 0,0:08:01.35,0:08:05.23,Default,,0,0,0,,Жылан шұңқырында кім мықты екенін дәлелдеймін.
Dialogue: 0,0:08:05.90,0:08:08.11,Default,,0,0,0,,Ааа, мен оны асыға күтемін.
Dialogue: 0,0:08:09.53,0:08:11.44,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:11.69,0:08:15.95,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:08:21.25,0:08:24.12,Default,,0,0,0,,Жарайсыңдар! Риксон, қатты кел!
Dialogue: 0,0:08:24.46,0:08:26.38,Default,,0,0,0,,Мен ұруға қарсы емеспін, бірақ...
Dialogue: 0,0:08:26.46,0:08:29.96,Default,,0,0,0,,Бит Кукулканға қарсы қандай шаралар қолдануды жоспарлап отырсыз?
Dialogue: 0,0:08:30.05,0:08:32.42,Default,,0,0,0,,Жарайды, тез орындайық!
Dialogue: 0,0:08:32.84,0:08:36.14,Default,,0,0,0,,Baltic Beat Kukulkan - шабуыл түрі.
Dialogue: 0,0:08:36.39,0:08:39.85,Default,,0,0,0,,Сонымен қатар, ол жоғары жылдамдықты шабуылдарға маманданған.
Dialogue: 0,0:08:39.93,0:08:43.94,Default,,0,0,0,,Бұл жылдам шабуыл болсын, жоқ па, мен міндетті түрде жеңемін!
Dialogue: 0,0:08:44.81,0:08:45.94,Default,,0,0,0,,Сол Балто...
Dialogue: 0,0:08:46.19,0:08:49.23,Default,,0,0,0,,Хмм, қазірдің өзінде! Сіз жеңемін деп жатырсыз ба?
Dialogue: 0,0:08:49.61,0:08:52.82,Default,,0,0,0,,Мен сенің сол бейбақты кешіре алмағаныңа қалай қарайтыныңды білемін.
Dialogue: 0,0:08:52.90,0:08:54.90,Default,,0,0,0,,Сәл тынышталыңыз.
Dialogue: 0,0:08:54.99,0:08:56.20,Default,,0,0,0,,Мен тынышпын!
Dialogue: 0,0:08:56.57,0:08:59.45,Default,,0,0,0,,Бұлай айту сабырлы және жас көрінбейді.
Dialogue: 0,0:08:59.66,0:09:01.45,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:09:01.87,0:09:03.70,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:09.96,0:09:11.88,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:13.97,0:09:16.09,Default,,0,0,0,,Сіз қайтадан күшейіп кеткен сияқтысыз.
Dialogue: 0,0:09:16.38,0:09:19.35,Default,,0,0,0,,Бірақ менің қабілетім жақсырақ.
Dialogue: 0,0:09:22.56,0:09:23.60,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:09:28.06,0:09:29.65,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:32.11,0:09:33.99,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,0:09:36.03,0:09:37.32,Default,,0,0,0,,Алтын көз
Dialogue: 0,0:09:38.07,0:09:41.08,Default,,0,0,0,,Ашрамның құралы болдыңыз ба?
Dialogue: 0,0:09:41.62,0:09:42.74,Default,,0,0,0,,Не?
Dialogue: 0,0:09:45.04,0:09:46.33,Default,,0,0,0,,Боа
Dialogue: 0,0:09:46.91,0:09:48.92,Default,,0,0,0,,Қызыл көзді сындырыңыз
Dialogue: 0,0:09:49.88,0:09:52.38,Default,,0,0,0,,Қызыл көзді жеңе аласыз
Dialogue: 0,0:09:53.05,0:09:54.30,Default,,0,0,0,,Ашрам-сама
Dialogue: 0,0:09:54.38,0:09:55.42,Default,,0,0,0,,Не?
Dialogue: 0,0:09:56.47,0:10:00.64,Default,,0,0,0,,Мен де мықты бекті алу құралымын ба?
Dialogue: 0,0:10:01.55,0:10:03.10,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:10:05.39,0:10:07.18,Default,,0,0,0,,Мен оны сұрадым, Боа.
Dialogue: 0,0:10:08.31,0:10:10.81,Default,,0,0,0,,Менің көңілімді қалдырмаңыз
Dialogue: 0,0:10:14.23,0:10:16.03,Default,,0,0,0,,Мен құрал ретінде пайдаланылмайды.
Dialogue: 0,0:10:16.61,0:10:19.53,Default,,0,0,0,,Ху, мен де солаймын, Боа.
Dialogue: 0,0:10:19.82,0:10:20.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.07,0:10:24.29,Default,,0,0,0,,Мен ашрам жобаларына қызықпаймын.
Dialogue: 0,0:10:25.33,0:10:27.75,Default,,0,0,0,,Тек Қызыл көзді қызықтырады
Dialogue: 0,0:10:29.04,0:10:30.04,Default,,0,0,0,,Иә
Dialogue: 0,0:10:30.83,0:10:31.79,Default,,0,0,0,,Не?
Dialogue: 0,0:10:32.42,0:10:34.25,Default,,0,0,0,,Қызыл көзді жеңу үшін...
Dialogue: 0,0:10:34.34,0:10:36.21,Default,,0,0,0,,Бұл менмін. (Норман) Бұл менмін.
Dialogue: 0,0:10:37.13,0:10:38.55,Default,,0,0,0,,Мен де сенен жеңілмеймін
Dialogue: 0,0:10:38.92,0:10:41.30,Default,,0,0,0,,Иә, бұл сызық.
Dialogue: 0,0:10:45.06,0:10:48.18,Default,,0,0,0,,Ах... тағы бір рет, тағы бір рет!
Dialogue: 0,0:10:48.48,0:10:50.73,Default,,0,0,0,,Әй, басыңды суыт.
Dialogue: 0,0:10:50.81,0:10:52.10,Default,,0,0,0,,Жүрек соғу
Dialogue: 0,0:10:52.19,0:10:53.73,Default,,0,0,0,,Сондықтан мен оны түсінбеймін!
Dialogue: 0,0:10:54.19,0:10:56.44,Default,,0,0,0,,Келесі жолы қатты барайық!
Dialogue: 0,0:10:57.36,0:10:59.61,Default,,0,0,0,,Менің мотивациям таусылуда.
Dialogue: 0,0:10:59.70,0:11:02.57,Default,,0,0,0,,Егер солай болса, сіз жеңуге болатын шайқаста да жеңе алмайсыз.
Dialogue: 0,0:11:05.66,0:11:08.00,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:11:08.83,0:11:10.96,Default,,0,0,0,,Мына жігіт Балтоның қарсыласы ма?
Dialogue: 0,0:11:11.12,0:11:14.63,Default,,0,0,0,,...Мен үшін кім уайымдап жүр деп ойлаймын...
Dialogue: 0,0:11:16.34,0:11:18.09,Default,,0,0,0,,Жанып жатқан ғибадатхана Кайза...
Dialogue: 0,0:11:22.05,0:11:23.47,Default,,0,0,0,,Не... сонда?
Dialogue: 0,0:11:27.06,0:11:28.27,Default,,0,0,0,,О
Dialogue: 0,0:11:29.64,0:11:32.35,Default,,0,0,0,,Мен сізді сонша қызықтырған нәрсеге таң қалдым.
Dialogue: 0,0:11:32.90,0:11:35.86,Default,,0,0,0,,Бетіне жараспаса да, зерттеуге құмар.
Dialogue: 0,0:11:36.44,0:11:37.61,Default,,0,0,0,,Тақырып...
Dialogue: 0,0:11:38.28,0:11:39.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.40,0:11:43.49,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:11:43.57,0:11:46.99,Default,,0,0,0,,Сіздің әлі достарыңыз жоқ.
Dialogue: 0,0:11:47.08,0:11:48.04,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:11:48.37,0:11:50.62,Default,,0,0,0,,Сіздің қарсыласыңыз Шака ма?
Dialogue: 0,0:11:50.71,0:11:54.00,Default,,0,0,0,,Онымен төбелесіп жатқанда бір нәрсені байқадым.
Dialogue: 0,0:11:54.54,0:11:56.50,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:11:57.21,0:11:58.46,Default,,0,0,0,,Сояна~
Dialogue: 0,0:11:58.55,0:12:01.63,Default,,0,0,0,,Зиг Экскалибурмен қалай күресуге болатынын айтсам болады ма?
Dialogue: 0,0:12:02.13,0:12:03.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:06.93,0:12:11.35,Default,,0,0,0,,Айтқым келсе, тыңдай аласың.
Dialogue: 0,0:12:11.68,0:12:12.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:12.89,0:12:16.11,Default,,0,0,0,,Оны естігіңіз келеді, солай ма? Сіз адал емессіз
Dialogue: 0,0:12:16.56,0:12:20.03,Default,,0,0,0,,Ха, қайсысы? Мен сізге айтқым келеді.
Dialogue: 0,0:12:21.11,0:12:23.24,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:29.08,0:12:30.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:30.16,0:12:31.37,Default,,0,0,0,,...Тоттотто
Dialogue: 0,0:12:31.45,0:12:32.58,Default,,0,0,0,,Цезарь Цеппели
Dialogue: 0,0:12:32.66,0:12:34.96,Default,,0,0,0,,А, мен шаршадым.
Dialogue: 0,0:12:35.04,0:12:37.38,Default,,0,0,0,,Тағы біреуі Тағы біреуін жасайық
Dialogue: 0,0:12:37.92,0:12:39.84,Default,,0,0,0,,Маған біраз демалуға рұқсат етіңіз.
Dialogue: 0,0:12:41.30,0:12:44.72,Default,,0,0,0,,А, менің қарсыласым - Жылан шұңқырының жарқыраған маскасы.
Dialogue: 0,0:12:44.80,0:12:46.34,Default,,0,0,0,,Демалуға уақыт жоқ...
Dialogue: 0,0:12:46.43,0:12:47.76,Default,,0,0,0,,Незо Низо
Dialogue: 0,0:12:47.93,0:12:50.43,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:12:50.72,0:12:53.27,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:12:53.68,0:12:57.35,Default,,0,0,0,,Қарашы, мен саған өтірік айтпаймын. Сізге де біраз демалу керек.
Dialogue: 0,0:12:57.77,0:12:58.86,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:12:59.15,0:13:02.32,Default,,0,0,0,,Қалай болғанда да, Норман қандай шығанақ пайдаланады?
Dialogue: 0,0:13:02.94,0:13:07.03,Default,,0,0,0,,Иә... Оны білмесек, шара қолдана алмаймыз.
Dialogue: 0,0:13:09.33,0:13:10.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:11.54,0:13:12.83,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:13:18.17,0:13:19.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:20.13,0:13:21.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:21.42,0:13:23.92,Default,,0,0,0,,О, менің қымбатты досым!
Dialogue: 0,0:13:24.30,0:13:26.43,Default,,0,0,0,,Уа! Clio…
Dialogue: 0,0:13:27.05,0:13:29.39,Default,,0,0,0,,Түсіндім! вампир?
Dialogue: 0,0:13:29.68,0:13:31.60,Default,,0,0,0,,Не... мұнда не үшін келдің?
Dialogue: 0,0:13:32.43,0:13:34.81,Default,,0,0,0,,Сізге күш беру үшін...
Dialogue: 0,0:13:34.89,0:13:38.77,Default,,0,0,0,,Ұйқыдан оянып, осы елге түстім.
Dialogue: 0,0:13:38.85,0:13:41.19,Default,,0,0,0,,Көмек бере аласыз ба? Маған?
Dialogue: 0,0:13:41.27,0:13:45.78,Default,,0,0,0,,Менің тағдырлас досыма «чемпионаттың» шыңына жетуге көмектесу
Dialogue: 0,0:13:45.86,0:13:46.99,Default,,0,0,0,,Енді күресейік
Dialogue: 0,0:13:47.74,0:13:49.45,Default,,0,0,0,,Ойрамен соғысу?
Dialogue: 0,0:13:49.53,0:13:51.33,Default,,0,0,0,,Мені жеңбесең
Dialogue: 0,0:13:51.41,0:13:55.25,Default,,0,0,0,,Финалдық турнирде жеңіске жету - орындалатын арман
Dialogue: 0,0:13:55.75,0:13:57.04,Default,,0,0,0,,Жасай бер, Куза.
Dialogue: 0,0:13:57.37,0:13:59.96,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:14:00.25,0:14:01.46,Default,,0,0,0,,Ешкім нәтижелерге сәйкес келмейді.
Dialogue: 0,0:14:01.75,0:14:03.67,Default,,0,0,0,,Мотивация қосқышы қосылды!
Dialogue: 0,0:14:05.13,0:14:06.88,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:07.05,0:14:09.84,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:10.05,0:14:13.51,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:16.27,0:14:18.31,Default,,0,0,0,,Слайд арқылы түсіру
Dialogue: 0,0:14:22.36,0:14:23.36,Default,,0,0,0,,Иә
Dialogue: 0,0:14:28.15,0:14:29.49,Default,,0,0,0,,...
Dialogue: 0,0:14:34.29,0:14:35.29,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:14:35.49,0:14:36.62,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:14:39.16,0:14:40.08,Default,,0,0,0,,Ах
Dialogue: 0,0:14:44.88,0:14:46.96,Default,,0,0,0,,Тар арқанмен секіру!
Dialogue: 0,0:14:55.60,0:14:57.22,Default,,0,0,0,,Мен саған бұның физика шекарасынан тыс екенін айттым ғой?
Dialogue: 0,0:15:14.24,0:15:16.58,Default,,0,0,0,,Кяха Жарайды!
Dialogue: 0,0:15:17.33,0:15:18.41,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:15:18.50,0:15:21.42,Default,,0,0,0,,Жасадың, Куза (Куза)!
Dialogue: 0,0:15:21.92,0:15:24.17,Default,,0,0,0,,Сіздің арқаңызда сенімім артты.
Dialogue: 0,0:15:24.25,0:15:25.84,Default,,0,0,0,,Clio Рахмет
Dialogue: 0,0:15:26.25,0:15:30.17,Default,,0,0,0,,Достың қуанышы, яғни менің қуанышым қандай?
Dialogue: 0,0:15:30.26,0:15:32.89,Default,,0,0,0,,Дегенмен, біз жеңіліп қалсақ, кері шегіне алмаймыз!
Dialogue: 0,0:15:33.26,0:15:35.10,Default,,0,0,0,,Енді жарысатын кез келді!
Dialogue: 0,0:15:35.18,0:15:36.76,Default,,0,0,0,,О! Клио жасайық
Dialogue: 0,0:15:36.85,0:15:37.89,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:46.90,0:15:48.65,Default,,0,0,0,,Жеңіске жетейік, досым!
Dialogue: 0,0:16:04.33,0:16:06.46,Default,,0,0,0,,Мен бәрін құртамын
Dialogue: 0,0:16:11.34,0:16:13.76,Default,,0,0,0,,Уууу!
Dialogue: 0,0:16:13.93,0:16:15.72,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:16:26.11,0:16:28.82,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:16:28.90,0:16:31.03,Default,,0,0,0,,Соңында, Құдай Блейдерс кубогы-
Dialogue: 0,0:16:31.11,0:16:33.53,Default,,0,0,0,,Бірінші тағдырлы матч басталады!
Dialogue: 0,0:16:33.61,0:16:36.07,Default,,0,0,0,,Алдымен А тобындағы бірінші ойын
Dialogue: 0,0:16:36.16,0:16:39.33,Default,,0,0,0,,Барт Аои және Курц Баратье
Dialogue: 0,0:16:39.58,0:16:41.79,Default,,0,0,0,,Барто, қолыңнан келгеннің бәрін істе!
Dialogue: 0,0:16:41.87,0:16:44.71,Default,,0,0,0,,Балто Тым қызып кетпеңіз.
Dialogue: 0,0:16:47.08,0:16:48.34,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:16:48.42,0:16:52.30,Default,,0,0,0,,Көңілді Ғажайып бала Үнемі өсіп келе жатқан Ғажайып бала
Dialogue: 0,0:16:52.38,0:16:53.76,Default,,0,0,0,,Барто Аои!
Dialogue: 0,0:16:53.84,0:16:56.05,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:16:56.47,0:16:57.72,Default,,0,0,0,,Көк бұрыш
Dialogue: 0,0:16:57.80,0:17:02.89,Default,,0,0,0,,Аты аңызға айналған пышақ осында түседі, император Курц Баратье!
Dialogue: 0,0:17:02.98,0:17:05.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:05.81,0:17:07.15,Default,,0,0,0,,Енді осы сәт
Dialogue: 0,0:17:07.23,0:17:11.40,Default,,0,0,0,,Император Курцтың ұрыс стиліне куә боламыз!
Dialogue: 0,0:17:11.73,0:17:15.86,Default,,0,0,0,,Балт Аои оған қарсы қандай күрес стилін көрсетеді?
Dialogue: 0,0:17:15.95,0:17:18.32,Default,,0,0,0,,Таң сағындым!
Dialogue: 0,0:17:19.20,0:17:21.45,Default,,0,0,0,,Кәне, ойнайық
Dialogue: 0,0:17:21.54,0:17:22.87,Default,,0,0,0,,Ойын туралы не айтасыз?
Dialogue: 0,0:17:23.29,0:17:27.50,Default,,0,0,0,,Уайымдама, мен сенің әлсіз билеріңе қызықпаймын.
Dialogue: 0,0:17:27.88,0:17:29.92,Default,,0,0,0,,Валькириді мазақ етпе!
Dialogue: 0,0:17:30.29,0:17:34.67,Default,,0,0,0,,Уау! Аои Балттың жауынгері жанып жатыр!
Dialogue: 0,0:17:35.05,0:17:38.72,Default,,0,0,0,,Оның басына қан бар емес пе?
Dialogue: 0,0:17:38.80,0:17:40.76,Default,,0,0,0,,Зәкірді өз жауың деп ойла.
Dialogue: 0,0:17:41.14,0:17:43.06,Default,,0,0,0,,Цк, бір ұяшық!
Dialogue: 0,0:17:43.14,0:17:46.77,Default,,0,0,0,,Бала тез жеңіліп қалады~
Dialogue: 0,0:17:48.44,0:17:50.06,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:50.73,0:17:52.52,Default,,0,0,0,,Мен сені бір оқпен өлтіремін
Dialogue: 0,0:17:52.86,0:17:54.53,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:17:55.32,0:17:57.03,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:57.11,0:18:00.95,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:01.03,0:18:03.24,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:03.33,0:18:04.37,Default,,0,0,0,,Тея!
Dialogue: 0,0:18:04.83,0:18:06.75,Default,,0,0,0,,Зәулім ғимараттың түсірілімі!
Dialogue: 0,0:18:07.12,0:18:09.96,Default,,0,0,0,,Уау! Жоғары позициядан ату
Dialogue: 0,0:18:10.04,0:18:13.17,Default,,0,0,0,,Құдай Валькиридің жоғары жылдамдықтағы шабуылынан құтылды!
Dialogue: 0,0:18:14.63,0:18:16.09,Default,,0,0,0,,Валькирияға қатты барыңыз
Dialogue: 0,0:18:18.43,0:18:20.05,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:18:23.51,0:18:24.39,Default,,0,0,0,,Хун
Dialogue: 0,0:18:24.68,0:18:27.27,Default,,0,0,0,,Бар, бар, бар, көп!
Dialogue: 0,0:18:29.48,0:18:31.40,Default,,0,0,0,,Ғұн әлі де әлсіз
Dialogue: 0,0:18:31.48,0:18:32.48,Default,,0,0,0,,На
Dialogue: 0,0:18:32.56,0:18:35.40,Default,,0,0,0,,Аспан асты елінде сіз дұрыс айттыңыз.
Dialogue: 0,0:18:35.86,0:18:38.32,Default,,0,0,0,,Менен қазір қашуға болады.
Dialogue: 0,0:18:38.57,0:18:39.82,Default,,0,0,0,,Нигерумонка!
Dialogue: 0,0:18:44.79,0:18:46.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:46.29,0:18:48.83,Default,,0,0,0,,Әй, бірдеңе өзгерді!
Dialogue: 0,0:18:48.91,0:18:52.17,Default,,0,0,0,,Мм... қарсыластың шабуылын алғаннан кейін...
Dialogue: 0,0:18:52.54,0:18:56.67,Default,,0,0,0,,Құлып екі рет ілгерілегенде, әсер ету пышағы өткір болады.
Dialogue: 0,0:18:56.76,0:18:59.68,Default,,0,0,0,,Енді ол сізге күшті шабуылдар береді.
Dialogue: 0,0:19:00.09,0:19:02.18,Default,,0,0,0,,Абайлаңыз, Балто!
Dialogue: 0,0:19:12.73,0:19:14.44,Default,,0,0,0,,Бар, бар
Dialogue: 0,0:19:14.61,0:19:17.11,Default,,0,0,0,,Ұшақпен ату!
Dialogue: 0,0:19:19.32,0:19:21.11,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:24.28,0:19:26.74,Default,,0,0,0,,Кукулканды ұру (саусақтарды сермеу)
Dialogue: 0,0:19:33.50,0:19:35.00,Default,,0,0,0,,(айқай)
Dialogue: 0,0:19:36.50,0:19:39.01,Default,,0,0,0,,Шабуыл жасау!
Dialogue: 0,0:19:39.97,0:19:41.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:41.72,0:19:42.72,Default,,0,0,0,,Бітті
Dialogue: 0,0:19:53.73,0:19:54.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:57.77,0:20:00.49,Default,,0,0,0,,Қызылша Кукульканның жарылуы
Dialogue: 0,0:20:00.57,0:20:02.70,Default,,0,0,0,,Жеңімпаз Курц Баратиер
Dialogue: 0,0:20:03.78,0:20:07.58,Default,,0,0,0,,Күшті Күшті Тым күшті Кукулканды ұрды
Dialogue: 0,0:20:07.66,0:20:10.08,Default,,0,0,0,,Керемет күш!
Dialogue: 0,0:20:10.16,0:20:12.58,Default,,0,0,0,,Иә! Курц мырза!
Dialogue: 0,0:20:14.58,0:20:16.17,Default,,0,0,0,,Балто жеңілді.
Dialogue: 0,0:20:17.54,0:20:18.55,Default,,0,0,0,,Барт…
Dialogue: 0,0:20:21.01,0:20:21.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:22.63,0:20:24.01,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:28.56,0:20:29.56,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:20:29.64,0:20:30.68,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:20:31.35,0:20:34.73,Default,,0,0,0,,Хмф, мен оны қоқыс деп ойладым.
Dialogue: 0,0:20:35.69,0:20:40.07,Default,,0,0,0,,Егер маған ұнаса, уақытты өлтіру үшін мен сенімен қайтадан ойнаймын. Хехе
Dialogue: 0,0:20:47.03,0:20:49.62,Default,,0,0,0,,Балто! Ойыңызды өзгертіңіз!
Dialogue: 0,0:20:49.74,0:20:52.33,Default,,0,0,0,,Финалға өтуге әлі де мүмкіндік бар!
Dialogue: 0,0:20:52.66,0:20:55.58,Default,,0,0,0,,Барт: Сіз әлі бас тартқан жоқсыз, солай ма?
Dialogue: 0,0:20:55.92,0:20:57.08,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:20:57.71,0:20:59.38,Default,,0,0,0,,Мен енді жеңілмеймін
Dialogue: 0,0:20:59.63,0:21:02.71,Default,,0,0,0,,Бұдан былай біз барлық жеңістермен финалға шығамыз!
Dialogue: 0,0:21:02.80,0:21:05.63,Default,,0,0,0,,(Найзағай бұлттарының дыбысы)
Dialogue: 0,0:21:06.51,0:21:11.22,Default,,0,0,0,,Бұрын New York Bulls командасының мүшесі, қазір Snake Pit мүшесі.
Dialogue: 0,0:21:11.31,0:21:13.98,Default,,0,0,0,,Қызыл көз, сондай-ақ Куришуу ретінде белгілі!
Dialogue: 0,0:21:14.39,0:21:17.90,Default,,0,0,0,,Екінші жағынан, ол жылан шұңқырынан шыққан құйрықты жұлдыздай көрінді.
Dialogue: 0,0:21:17.98,0:21:19.48,Default,,0,0,0,,Боа Алькасер!
Dialogue: 0,0:21:19.56,0:21:23.49,Default,,0,0,0,,«А» тобындағы екінші матч – бір дәрежедегі жарыс!
Dialogue: 0,0:21:26.95,0:21:31.45,Default,,0,0,0,,Мен сізге шайқасыңызды көрсетейін.
Dialogue: 0,0:21:32.20,0:21:36.79,Default,,0,0,0,,Мен сенен артықпын, қазір дәлелдеймін.
Dialogue: 0,0:21:37.33,0:21:39.96,Default,,0,0,0,,Қызыл көз Мен сені жеңемін!
Dialogue: 0,0:21:47.13,0:21:49.26,Default,,0,0,0,,(күн күркірінің дыбысы)
Dialogue: 0,0:21:49.97,0:21:52.64,Default,,0,0,0,,Боа мен сені құртамын!
Dialogue: 0,0:21:56.10,0:21:57.19,Default,,0,0,0,,♪~
Dialogue: 0,0:21:57.19,0:22:00.77,Default,,0,0,0,,♪~
Dialogue: 0,0:21:57.19,0:22:00.77,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар бұлшық еттеріңізді жаттықтырасыз ба?
Dialogue: 0,0:22:00.86,0:22:03.69,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.78,0:22:07.74,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:07.82,0:22:11.41,Default,,0,0,0,,GO Shoot GO Shoot GO Үлкен ату!
Dialogue: 0,0:22:11.49,0:22:15.12,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдату!
Dialogue: 0,0:22:15.20,0:22:18.75,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.83,0:22:22.21,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:22.29,0:22:25.59,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:25.67,0:22:29.59,Default,,0,0,0,,Бірақ бұл жерден одан да күшті болады. Мен қолдарымды және кернеуімді арттырамын.
Dialogue: 0,0:22:29.68,0:22:33.56,Default,,0,0,0,,GO ату GO ату Бастаушы бұлшықет жаттығулары Моримори
Dialogue: 0,0:22:33.64,0:22:37.23,Default,,0,0,0,,АЛТ АТ АЛТ АТ Менің атым – құдайдың атысы
Dialogue: 0,0:22:37.31,0:22:40.90,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.98,0:22:44.57,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:44.65,0:22:48.20,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:48.28,0:22:52.07,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:52.16,0:22:55.74,Default,,0,0,0,,Күн сайын барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:55.83,0:22:59.25,Default,,0,0,0,,Жыл бойы көктемде, жазда, күзде және қыста GO түсіреді
Dialogue: 0,0:22:59.33,0:23:00.83,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.92,0:23:03.46,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:03.54,0:23:06.67,Default,,0,0,0,,Сол шиеленіспен шарықтау шегіне жетейік!
Dialogue: 0,0:23:06.76,0:23:10.47,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіріліміне кірісіңіз!
Dialogue: 0,0:23:10.55,0:23:13.97,Default,,0,0,0,,Ичи Ни Сан Ши GO Түсіріңіз, кеттік!
Dialogue: 0,0:23:14.05,0:23:17.81,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.89,0:23:20.73,Default,,0,0,0,,«Үш екі бір GO» ату сериясы аяқталды!
Dialogue: 0,0:23:20.73,0:23:22.73,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:20.73,0:23:22.73,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.73,0:23:22.81,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.81,0:23:26.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.81,0:23:26.02,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:26.02,0:23:26.27,Default,,0,0,0,,~♪
Dialogue: 0,0:23:27.69,0:23:29.69,Default,,0,0,0,,Боаның табандылығы Керемет!
Dialogue: 0,0:23:29.78,0:23:31.99,Default,,0,0,0,,Ах! Спригганның қарсы шабуылы!
Dialogue: 0,0:23:32.16,0:23:34.66,Default,,0,0,0,,Ал Куза Норманға барады.
Dialogue: 0,0:23:34.74,0:23:38.70,Default,,0,0,0,,Қорқыныш балғасы сізге келеді, сондықтан оны артқа итеріңіз!
Dialogue: 0,0:23:39.08,0:23:41.67,Default,,0,0,0,,Жылан шұңқырлары қорқынышты емес!
Dialogue: 0,0:23:42.00,0:23:44.17,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:44.25,0:23:46.55,Default,,0,0,0,,Балға! Егіз жау!
Dialogue: 0,0:23:46.63,0:23:50.59,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:52.09,0:23:58.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory