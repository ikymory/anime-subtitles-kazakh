Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.87,0:00:07.21,Default,,0,0,0,,wbba.Әлемдік лига!
Dialogue: 0,0:00:07.71,0:00:13.01,Default,,0,0,0,,Әр лигада жеңіске жеткен клубтар әлемнің шыңына шығу үшін күреседі.
Dialogue: 0,0:00:13.09,0:00:16.51,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз!
Dialogue: 0,0:00:17.05,0:00:20.27,Default,,0,0,0,,Жауынгерлеріңді өртеп, шектен шығып кет!
Dialogue: 0,0:00:21.10,0:00:25.19,Default,,0,0,0,,Жандардың қызу шайқасы әлемді толғандырады
Dialogue: 0,0:00:25.90,0:00:29.36,Default,,0,0,0,,Даңқты алатын сенсің!
Dialogue: 0,0:00:37.03,0:00:38.37,Default,,0,0,0,,Иә
Dialogue: 0,0:00:43.37,0:00:44.96,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:00:45.71,0:00:47.54,Default,,0,0,0,,Дыбыс)
Dialogue: 0,0:00:48.54,0:00:50.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:51.05,0:00:53.92,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:59.26,0:01:03.60,Default,,0,0,0,,Мен Nightmare Longinus-тың бәрін жоямын
Dialogue: 0,0:01:04.27,0:01:05.77,Default,,0,0,0,,(үру)
Dialogue: 0,0:01:06.23,0:01:07.44,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:07.52,0:01:09.90,Default,,0,0,0,,(қозғау дауысы)
Dialogue: 0,0:01:14.11,0:01:17.70,Default,,0,0,0,,Хахахаха хахахаха
Dialogue: 0,0:01:17.78,0:01:20.37,Default,,0,0,0,,Тс. Олардың қаншасы бар?
Dialogue: 0,0:01:21.45,0:01:24.16,Default,,0,0,0,,♪~
Dialogue: 0,0:01:24.25,0:01:26.75,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:26.83,0:01:29.25,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:29.33,0:01:31.54,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:31.63,0:01:34.26,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:34.34,0:01:35.80,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:35.88,0:01:40.10,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:41.05,0:01:45.81,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:45.89,0:01:50.23,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:50.94,0:01:55.65,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:55.74,0:02:00.66,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:00.74,0:02:05.66,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:05.75,0:02:10.67,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:10.75,0:02:14.05,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:14.13,0:02:15.55,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:15.63,0:02:18.17,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:18.26,0:02:20.80,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:20.89,0:02:22.80,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:22.89,0:02:24.22,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:24.31,0:02:25.72,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:25.81,0:02:28.18,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:28.27,0:02:34.40,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:34.48,0:02:38.86,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:38.95,0:02:41.45,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:41.53,0:02:43.91,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:43.99,0:02:46.62,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:46.70,0:02:50.46,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:51.92,0:02:55.96,Default,,0,0,0,,Финал! BC Sol VS NY Bulls!
Dialogue: 0,0:02:56.05,0:02:57.76,Default,,0,0,0,,Не!
Dialogue: 0,0:03:01.30,0:03:03.39,Default,,0,0,0,,Куууууу...
Dialogue: 0,0:03:04.55,0:03:07.64,Default,,0,0,0,,Бір ғана соққы... аа...
Dialogue: 0,0:03:07.77,0:03:10.64,Default,,0,0,0,,(қозғау дауысы)
Dialogue: 0,0:03:16.77,0:03:18.82,Default,,0,0,0,,Күте тұрыңыз, Қызыл көз!
Dialogue: 0,0:03:19.99,0:03:22.95,Default,,0,0,0,,Мен бұл қарызды міндетті түрде өтеймін!
Dialogue: 0,0:03:43.51,0:03:48.18,Default,,0,0,0,,Сіз бе? Құстарды аулайтын қызыл көз
Dialogue: 0,0:03:59.07,0:04:01.61,Default,,0,0,0,,Сонда келесі нысана мен?
Dialogue: 0,0:04:01.99,0:04:03.91,Default,,0,0,0,,Жарайды, күте тұрыңыз!
Dialogue: 0,0:04:03.99,0:04:06.41,Default,,0,0,0,,Мен бұл олжаны аламын.
Dialogue: 0,0:04:06.78,0:04:08.08,Default,,0,0,0,,Бұрау
Dialogue: 0,0:04:08.49,0:04:13.16,Default,,0,0,0,,Song Luwei Осы арка Бахамутқа қарсы күрес.
Dialogue: 0,0:04:14.33,0:04:17.88,Default,,0,0,0,,Бейді бірінші рет көріп тұрмын. Бұл Арч Бахамут па?
Dialogue: 0,0:04:18.38,0:04:19.71,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:26.76,0:04:30.56,Default,,0,0,0,,Арч Бахамут атомдық драйвері...
Dialogue: 0,0:04:30.72,0:04:32.52,Default,,0,0,0,,Тыңдау кезінде қалдырылды
Dialogue: 0,0:04:35.19,0:04:36.85,Default,,0,0,0,,Барлығын бірден тоқтатыңыз!
Dialogue: 0,0:04:38.31,0:04:41.28,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:41.65,0:04:43.74,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:47.32,0:04:48.24,Default,,0,0,0,,Не?!
Dialogue: 0,0:04:51.12,0:04:52.66,Default,,0,0,0,,Солға айналдыру?
Dialogue: 0,0:04:53.08,0:04:55.00,Default,,0,0,0,,Қызық
Dialogue: 0,0:05:03.30,0:05:05.97,Default,,0,0,0,,Мен саған Бахамуттың күшін көрсетемін!
Dialogue: 0,0:05:11.22,0:05:13.68,Default,,0,0,0,,Қабат пішіні шеңберге өзгертілді
Dialogue: 0,0:05:16.23,0:05:19.15,Default,,0,0,0,,Осындай нәрсе! азу шабуылы
Dialogue: 0,0:05:25.24,0:05:26.70,Default,,0,0,0,,(үру)
Dialogue: 0,0:05:30.41,0:05:32.12,Default,,0,0,0,,Арка Бахамут!
Dialogue: 0,0:05:35.46,0:05:37.50,Default,,0,0,0,,(үру)
Dialogue: 0,0:05:42.13,0:05:44.09,Default,,0,0,0,,Соңғы күзет
Dialogue: 0,0:05:47.13,0:05:48.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:48.13,0:05:50.35,Default,,0,0,0,,Соқыңыз!
Dialogue: 0,0:05:51.97,0:05:54.02,Default,,0,0,0,,(үру)
Dialogue: 0,0:05:57.06,0:05:58.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:00.98,0:06:02.90,Default,,0,0,0,,Солға айналдыру және-
Dialogue: 0,0:06:02.98,0:06:06.28,Default,,0,0,0,,Мен қабаттың шеңберге айналуының айырмашылығын елемедім.
Dialogue: 0,0:06:07.65,0:06:09.74,Default,,0,0,0,,Бұл Арк Бахамут
Dialogue: 0,0:06:10.03,0:06:12.53,Default,,0,0,0,,Сіз күш жинап жатырсыз, Боа.
Dialogue: 0,0:06:12.87,0:06:16.00,Default,,0,0,0,,Ақырында сен де Қызыл көзге айналасың!
Dialogue: 0,0:06:22.29,0:06:24.80,Default,,0,0,0,,Міне, Балт, шабуыл!
Dialogue: 0,0:06:26.84,0:06:28.42,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:06:31.47,0:06:32.89,Default,,0,0,0,,Ахх
Dialogue: 0,0:06:33.43,0:06:34.72,Default,,0,0,0,,А...
Dialogue: 0,0:06:34.81,0:06:37.64,Default,,0,0,0,,Қуат әлі де жеткіліксіз
Dialogue: 0,0:06:38.31,0:06:40.23,Default,,0,0,0,,Менің орнымда
Dialogue: 0,0:06:40.31,0:06:41.98,Default,,0,0,0,,Маған қайталауға рұқсат етіңіз!
Dialogue: 0,0:06:42.06,0:06:43.23,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:06:43.31,0:06:47.11,Default,,0,0,0,,Ата, бір «Мүген шығанағы» стадионы жеткіліксіз болды.
Dialogue: 0,0:06:47.19,0:06:48.95,Default,,0,0,0,,Фофофу
Dialogue: 0,0:06:49.15,0:06:53.66,Default,,0,0,0,,Барлығы, бәрі жаттығу үшін. Біраз демалып, ертеңгі күнге дайындал.
Dialogue: 0,0:06:54.12,0:06:57.62,Default,,0,0,0,,Олай болса, демалу жаттығудың бір бөлігі.
Dialogue: 0,0:06:57.87,0:06:59.83,Default,,0,0,0,,Бүгінгі күнге жетеді
Dialogue: 0,0:07:00.29,0:07:02.00,Default,,0,0,0,,Ах... түсіндім.
Dialogue: 0,0:07:02.58,0:07:04.71,Default,,0,0,0,,Жарайды, тамақ, тамақ.
Dialogue: 0,0:07:04.79,0:07:06.34,Default,,0,0,0,,Күріш күріш
Dialogue: 0,0:07:07.63,0:07:09.84,Default,,0,0,0,,Менің әлі тәжірибем жеткіліксіз.
Dialogue: 0,0:07:14.26,0:07:15.10,Default,,0,0,0,,Дос
Dialogue: 0,0:07:15.97,0:07:19.06,Default,,0,0,0,,Мен бірдеңені ала жаздағандай сезінемін.
Dialogue: 0,0:07:19.85,0:07:21.56,Default,,0,0,0,,Арнайы тренинг өткізейік
Dialogue: 0,0:07:22.06,0:07:23.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:30.07,0:07:32.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:35.16,0:07:38.58,Default,,0,0,0,,Тегін! мұнда не істеп жүрсің
Dialogue: 0,0:07:38.66,0:07:40.96,Default,,0,0,0,,Әсіресе бөлек...
Dialogue: 0,0:07:43.33,0:07:45.17,Default,,0,0,0,,Сен де істейсің бе?
Dialogue: 0,0:07:46.67,0:07:47.71,Default,,0,0,0,,О!
Dialogue: 0,0:07:48.96,0:07:51.51,Default,,0,0,0,,Тағы бір рет Тағы бір рет!
Dialogue: 0,0:07:52.51,0:07:53.97,Default,,0,0,0,,Барт?
Dialogue: 0,0:07:54.68,0:07:57.51,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:57.60,0:08:00.18,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:08:01.35,0:08:04.15,Default,,0,0,0,,А... Тегін!
Dialogue: 0,0:08:06.19,0:08:09.82,Default,,0,0,0,,Бар, ұшақпен ату!
Dialogue: 0,0:08:13.86,0:08:14.82,Default,,0,0,0,,Га
Dialogue: 0,0:08:16.91,0:08:18.41,Default,,0,0,0,,Суды төгу
Dialogue: 0,0:08:26.96,0:08:28.79,Default,,0,0,0,,Уф, тағы да...
Dialogue: 0,0:08:30.46,0:08:31.80,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:08:32.26,0:08:34.13,Default,,0,0,0,,Әлі тегін емес
Dialogue: 0,0:08:34.72,0:08:37.51,Default,,0,0,0,,Әлі жоқ... Тағы бір рет...
Dialogue: 0,0:08:39.47,0:08:41.56,Default,,0,0,0,,Менде бәрі жақсы, бірақ...
Dialogue: 0,0:08:41.64,0:08:44.31,Default,,0,0,0,,Әлі жоқ...
Dialogue: 0,0:08:44.81,0:08:46.31,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:08:47.36,0:08:51.28,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:08:52.24,0:08:53.19,Default,,0,0,0,,Иә
Dialogue: 0,0:08:57.28,0:08:58.49,Default,,0,0,0,,Тегін
Dialogue: 0,0:09:00.08,0:09:03.08,Default,,0,0,0,,BC Sol Біз жақсы команда жасадық, солай емес пе?
Dialogue: 0,0:09:03.25,0:09:05.29,Default,,0,0,0,,Мен матчты асыға күтемін.
Dialogue: 0,0:09:05.37,0:09:06.50,Default,,0,0,0,,Мен де
Dialogue: 0,0:09:06.58,0:09:07.88,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:09:18.93,0:09:21.68,Default,,0,0,0,,Тағы бір рет...
Dialogue: 0,0:09:22.64,0:09:24.06,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:29.56,0:09:31.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:32.69,0:09:34.40,Default,,0,0,0,,Крис?
Dialogue: 0,0:09:34.49,0:09:36.32,Default,,0,0,0,,Бұл өте ерте.
Dialogue: 0,0:09:36.40,0:09:37.41,Default,,0,0,0,,Сіз де
Dialogue: 0,0:09:37.95,0:09:38.95,Default,,0,0,0,,Адалдық
Dialogue: 0,0:09:39.03,0:09:42.29,Default,,0,0,0,,Мен BC Сол финалға шығады деп ойламадым.
Dialogue: 0,0:09:42.37,0:09:44.04,Default,,0,0,0,,Сол балаларға рахмет
Dialogue: 0,0:09:45.37,0:09:46.46,Default,,0,0,0,,Енді...
Dialogue: 0,0:09:46.62,0:09:49.63,Default,,0,0,0,,Мен сіздің не істегіңіз келгенін түсіндім деп ойлаймын.
Dialogue: 0,0:09:50.25,0:09:51.59,Default,,0,0,0,,Сауда...
Dialogue: 0,0:09:52.21,0:09:55.97,Default,,0,0,0,,Мүмкін мен сені түсінуге тырыспаған шығармын.
Dialogue: 0,0:09:59.43,0:10:01.72,Default,,0,0,0,,BC Соль жеңеді.
Dialogue: 0,0:10:02.31,0:10:05.52,Default,,0,0,0,,Сіз қалай ойлайсыз? Нью-Йорк Буллс мықты
Dialogue: 0,0:10:06.43,0:10:09.15,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:10:09.23,0:10:12.32,Default,,0,0,0,,Бұл жолы дәстүрлі Эль Санто стадионы
Dialogue: 0,0:10:12.40,0:10:15.86,Default,,0,0,0,,Дүниежүзілік лиганың финалдық ойындары өтетін орын ретінде таңдалды!
Dialogue: 0,0:10:15.94,0:10:18.70,Default,,0,0,0,,Өте қызықты!
Dialogue: 0,0:10:19.53,0:10:22.58,Default,,0,0,0,,Финал үйде! Өрт!
Dialogue: 0,0:10:22.66,0:10:24.24,Default,,0,0,0,,Бұл арман сияқты
Dialogue: 0,0:10:24.33,0:10:27.62,Default,,0,0,0,,Бәріңе қолдау көрсете алатыныма қуаныштымын Эй Крис!
Dialogue: 0,0:10:27.71,0:10:30.79,Default,,0,0,0,,Иә, барлығымыз, қолымыздан келгенше қолдау көрсетейік.
Dialogue: 0,0:10:31.17,0:10:34.17,Default,,0,0,0,,Кәне, көк топтан бастайық.
Dialogue: 0,0:10:34.25,0:10:36.59,Default,,0,0,0,,Нью-Йорк Буллз чемпионы
Dialogue: 0,0:10:36.67,0:10:41.22,Default,,0,0,0,,Капитан - Голливуд жұлдызы Джошуа Бун!
Dialogue: 0,0:10:41.30,0:10:44.10,Default,,0,0,0,,Иә! Керемет!
Dialogue: 0,0:10:44.18,0:10:46.81,Default,,0,0,0,,Әлемдік рейтингте 1 орын
Dialogue: 0,0:10:46.89,0:10:51.60,Default,,0,0,0,,Жеңілмейтін миф осы Фри Де Ла Хойя үшін бар.
Dialogue: 0,0:10:52.19,0:10:54.02,Default,,0,0,0,,Әлемдік ұпайлардың жылдам өсуі
Dialogue: 0,0:10:54.11,0:10:57.61,Default,,0,0,0,,Дилан Саммерс және Блюз коды
Dialogue: 0,0:10:58.24,0:11:01.07,Default,,0,0,0,,Ал соңғысы - Бұқалардың құпия қаруы
Dialogue: 0,0:11:01.16,0:11:04.24,Default,,0,0,0,,Жұмбақ жүзші Ричард Иеро
Dialogue: 0,0:11:04.62,0:11:06.62,Default,,0,0,0,,Енді қызыл бұрышқа өтіңіз
Dialogue: 0,0:11:06.70,0:11:09.21,Default,,0,0,0,,Үйде дәстүрдің жаңғыруы бола ма?
Dialogue: 0,0:11:09.29,0:11:11.92,Default,,0,0,0,,Беделді BC Sol кіреберісі.
Dialogue: 0,0:11:12.21,0:11:15.21,Default,,0,0,0,,Капитан Уондер Бала
Dialogue: 0,0:11:15.29,0:11:16.96,Default,,0,0,0,,Барто Аои!
Dialogue: 0,0:11:17.30,0:11:21.47,Default,,0,0,0,,Ыстық адам Рантаро Кияманы алдап жатыр
Dialogue: 0,0:11:21.84,0:11:26.43,Default,,0,0,0,,Куса Акерман стадионында алтын құс билейді
Dialogue: 0,0:11:26.81,0:11:30.77,Default,,0,0,0,,Аралық нүктелерді алушы Cisco Carlyle
Dialogue: 0,0:11:30.85,0:11:34.44,Default,,0,0,0,,Риксон Клэйдің жігерлі соққысы!
Dialogue: 0,0:11:34.52,0:11:35.48,Default,,0,0,0,,Сейя!
Dialogue: 0,0:11:35.56,0:11:37.61,Default,,0,0,0,,Бұл қандай шайқас болады?
Dialogue: 0,0:11:37.69,0:11:42.95,Default,,0,0,0,,Сеньор Аннамидің де қуанғаны сонша, ол жарылып кету алдында тұр!
Dialogue: 0,0:11:43.86,0:11:47.03,Default,,0,0,0,,Матчтар әр ойында 2 ұпайлық жүйе бойынша ойналады.
Dialogue: 0,0:11:47.12,0:11:51.00,Default,,0,0,0,,3 ойында бірінші болып жеңіске жеткен команда Дүниежүзілік лиганы жеңеді.
Dialogue: 0,0:11:51.83,0:11:55.71,Default,,0,0,0,,Қатысу реті Кумичо, Куза және Cisco болады.
Dialogue: 0,0:11:56.04,0:11:57.88,Default,,0,0,0,,Не? Сіз байсалдысыз ба, Балто?
Dialogue: 0,0:11:57.96,0:11:59.55,Default,,0,0,0,,Балто көрінбейді ме?
Dialogue: 0,0:11:59.63,0:12:03.43,Default,,0,0,0,,Мен төртінші, ал Риксон бесінші.
Dialogue: 0,0:12:03.51,0:12:04.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:04.76,0:12:06.93,Default,,0,0,0,,О... Мен соңғысымын ба?
Dialogue: 0,0:12:07.51,0:12:10.98,Default,,0,0,0,,«Егер біз жеңетін болсақ, бәріміз бірге жасайық» деп ойладым.
Dialogue: 0,0:12:11.52,0:12:14.85,Default,,0,0,0,,Біз Нью-Йорк Буллзды барлығының күшімен жеңеміз.
Dialogue: 0,0:12:14.94,0:12:16.73,Default,,0,0,0,,Сондықтан мен мұнымен барамын.
Dialogue: 0,0:12:20.07,0:12:24.57,Default,,0,0,0,,Хехе, біріншісі, Кумичо-саманың қолы шырылдап тұр.
Dialogue: 0,0:12:24.66,0:12:27.70,Default,,0,0,0,,Жарайды, менің мотивация қосқышы қосылды.
Dialogue: 0,0:12:27.78,0:12:28.70,Default,,0,0,0,,Сейя!
Dialogue: 0,0:12:28.78,0:12:31.08,Default,,0,0,0,,Аа, түсіндің бе?
Dialogue: 0,0:12:31.16,0:12:33.96,Default,,0,0,0,,Жеңіске жетсек, сіздің кезегіңіз.
Dialogue: 0,0:12:34.33,0:12:36.67,Default,,0,0,0,,Не? Ахх!
Dialogue: 0,0:12:37.29,0:12:39.80,Default,,0,0,0,,Ең бірінші қарау керек
Dialogue: 0,0:12:39.88,0:12:41.96,Default,,0,0,0,,б.з.д. Сол Рантаро Кияма
Dialogue: 0,0:12:42.30,0:12:44.88,Default,,0,0,0,,Нью-Йорк Буллс Ричард Иерро
Dialogue: 0,0:12:45.18,0:12:46.93,Default,,0,0,0,,Бұл құпия қару ма?
Dialogue: 0,0:12:47.26,0:12:49.31,Default,,0,0,0,,Бұл матчқа бірінші рет қатысуым.
Dialogue: 0,0:12:49.39,0:12:50.39,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:50.72,0:12:54.60,Default,,0,0,0,,Мен кеткенше барлық ойындар аяқталды.
Dialogue: 0,0:12:54.98,0:12:58.27,Default,,0,0,0,,Эй, Балто, сен мынау бұлдыр нәрсені қайдан көрдің?
Dialogue: 0,0:12:58.40,0:13:00.27,Default,,0,0,0,,Сіз оны көрдіңіз бе? қашан?
Dialogue: 0,0:13:00.36,0:13:03.44,Default,,0,0,0,,Сонымен! Сіз мұны тыңдап жатырсыз ба?
Dialogue: 0,0:13:03.90,0:13:06.91,Default,,0,0,0,,Біраз уақыт болды, Рантаро Кияма.
Dialogue: 0,0:13:07.32,0:13:09.12,Default,,0,0,0,,Мен сен туралы ештеңе білмеймін.
Dialogue: 0,0:13:09.28,0:13:10.99,Default,,0,0,0,,Әй, суық.
Dialogue: 0,0:13:11.08,0:13:14.41,Default,,0,0,0,,Біздің біржақты жеңгенімізді ұмыттыңыз ба?
Dialogue: 0,0:13:14.50,0:13:16.67,Default,,0,0,0,,Иә? Ой, не айтып тұрсың...
Dialogue: 0,0:13:16.75,0:13:20.17,Default,,0,0,0,,Бірақ мен бұл шығанақты ұмыттым деуге жол бермеймін.
Dialogue: 0,0:13:20.25,0:13:21.59,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:13:22.05,0:13:23.17,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:13:23.26,0:13:24.42,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:13:33.35,0:13:34.56,Default,,0,0,0,,Сары көз!
Dialogue: 0,0:13:35.43,0:13:39.44,Default,,0,0,0,,Маған мүмкіндік бергеніңіз үшін көп рахмет.
Dialogue: 0,0:13:44.86,0:13:46.53,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:13:46.99,0:13:48.91,Default,,0,0,0,,Уау! Сенгісіз!
Dialogue: 0,0:13:48.99,0:13:53.16,Default,,0,0,0,,Йеро пайдаланатын шығанақ - Қара Рагнарук.
Dialogue: 0,0:13:53.24,0:13:56.29,Default,,0,0,0,,Екі шығанақ арасындағы кездесу бұрын-соңды болмаған!
Dialogue: 0,0:13:56.66,0:13:58.79,Default,,0,0,0,,Мен оны қайта көргім келеді.
Dialogue: 0,0:13:58.87,0:14:01.59,Default,,0,0,0,,Сізді жынды еткен ызылдаған көрініс
Dialogue: 0,0:14:01.92,0:14:05.51,Default,,0,0,0,,Хехехе, мына жерден ор қазбаймыз?
Dialogue: 0,0:14:06.09,0:14:08.72,Default,,0,0,0,,Ей, мен қазір отыра алмаймын.
Dialogue: 0,0:14:08.80,0:14:11.10,Default,,0,0,0,,Теме - отаку болып табылатын адам.
Dialogue: 0,0:14:11.30,0:14:14.18,Default,,0,0,0,,Бұл жылан шұңқырындағы Сары көз.
Dialogue: 0,0:14:14.27,0:14:15.39,Default,,0,0,0,,Не?
Dialogue: 0,0:14:15.47,0:14:18.14,Default,,0,0,0,,Неліктен бұл жігіт Нью-Йорк Буллзда?
Dialogue: 0,0:14:18.23,0:14:22.61,Default,,0,0,0,,Маған сол клубтың керемет жігіті қоңырау шалды.
Dialogue: 0,0:14:22.94,0:14:25.94,Default,,0,0,0,,Менің қалағаным - ең күшті шығанақ
Dialogue: 0,0:14:26.03,0:14:28.20,Default,,0,0,0,,Және ең күшті клуб
Dialogue: 0,0:14:28.70,0:14:30.74,Default,,0,0,0,,Толық жеңіске жетуді мақсат ету
Dialogue: 0,0:14:31.24,0:14:33.24,Default,,0,0,0,,Шығарма функциялары бірдей болса да
Dialogue: 0,0:14:33.33,0:14:36.91,Default,,0,0,0,,Бұл жерде жүзгіш ретіндегі барлық қабілеттер жақсырақ.
Dialogue: 0,0:14:37.00,0:14:40.21,Default,,0,0,0,,Мені күлдірмеңіз! Кумичо мырза баяғыда...
Dialogue: 0,0:14:40.29,0:14:42.92,Default,,0,0,0,,Мен сіздің деңгейіңізді жоғарылатып жатырмын.
Dialogue: 0,0:14:43.46,0:14:45.75,Default,,0,0,0,,Кумичо! жыртылған бөліктер
Dialogue: 0,0:14:45.84,0:14:47.46,Default,,0,0,0,,Оны бөлшектеңіз!
Dialogue: 0,0:14:47.80,0:14:48.97,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:14:49.30,0:14:50.30,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:14:50.38,0:14:53.64,Default,,0,0,0,,Кумичоның қандай айлакер екенін көрсетейін.
Dialogue: 0,0:14:54.10,0:14:56.47,Default,,0,0,0,,Бірінші ойын Бірінші шайқас
Dialogue: 0,0:14:56.77,0:14:58.43,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:58.52,0:15:02.06,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:02.15,0:15:04.48,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:06.98,0:15:08.61,Default,,0,0,0,,Шыдамдылықты жеңіңіз!
Dialogue: 0,0:15:08.90,0:15:12.45,Default,,0,0,0,,Екеуі де дәл бір траектория бойынша орталыққа қарай жылжиды
Dialogue: 0,0:15:12.53,0:15:15.78,Default,,0,0,0,,Бірінші келген Блэйз Рагнарук!
Dialogue: 0,0:15:15.87,0:15:18.04,Default,,0,0,0,,Келіңдер, келіңдер!
Dialogue: 0,0:15:22.33,0:15:25.75,Default,,0,0,0,,Ааа, мен аздап жауап ала бастадым.
Dialogue: 0,0:15:26.05,0:15:29.30,Default,,0,0,0,,Маған көрсетші, ер мінезді Блейз Рагнарук
Dialogue: 0,0:15:32.76,0:15:34.64,Default,,0,0,0,,(үру)
Dialogue: 0,0:15:35.72,0:15:39.39,Default,,0,0,0,,Құлап жатыр, құлап жатыр, құлап жатыр
Dialogue: 0,0:15:39.93,0:15:43.15,Default,,0,0,0,,Мен оны жұлып аламын. Мен оны ұсақ-түйекке дейін жыртамын.
Dialogue: 0,0:15:45.73,0:15:47.69,Default,,0,0,0,,Ууууу (кәмпит сынған дыбыс)
Dialogue: 0,0:15:47.78,0:15:51.57,Default,,0,0,0,,Егер сынуы мүмкін болса, оны сындырып, қараңыз.
Dialogue: 0,0:15:52.82,0:15:54.32,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:15:54.82,0:15:57.45,Default,,0,0,0,,Blaze Ragnaruk Burst Finish!
Dialogue: 0,0:15:58.08,0:16:02.21,Default,,0,0,0,,BC Сол бірінші ойында 2:0 есебімен жеңіске жетті.
Dialogue: 0,0:16:02.29,0:16:03.92,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:16:04.33,0:16:05.83,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:16:06.09,0:16:08.25,Default,,0,0,0,,Екі… күшті
Dialogue: 0,0:16:08.38,0:16:10.01,Default,,0,0,0,,Кумичо мұны жасайды
Dialogue: 0,0:16:10.09,0:16:11.22,Default,,0,0,0,,Жаржан
Dialogue: 0,0:16:11.47,0:16:14.22,Default,,0,0,0,,Иә? Ах
Dialogue: 0,0:16:18.22,0:16:19.47,Default,,0,0,0,,Тора-сан
Dialogue: 0,0:16:19.72,0:16:22.98,Default,,0,0,0,,Кнуклді ұстау өте жақсы.
Dialogue: 0,0:16:23.06,0:16:24.23,Default,,0,0,0,,Ангатона!
Dialogue: 0,0:16:24.69,0:16:27.69,Default,,0,0,0,,Ақырында, сіз оны меңгердіңіз бе?
Dialogue: 0,0:16:27.77,0:16:29.94,Default,,0,0,0,,Бұл қалай? Балалар, көрдіңдер ме?
Dialogue: 0,0:16:30.03,0:16:31.19,Default,,0,0,0,,Ара аралау
Dialogue: 0,0:16:31.28,0:16:32.49,Default,,0,0,0,,Мен көрдім!
Dialogue: 0,0:16:32.57,0:16:33.86,Default,,0,0,0,,Жарайсың Кумичо
Dialogue: 0,0:16:34.07,0:16:35.70,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:36.24,0:16:38.66,Default,,0,0,0,,Бірінші нүкте Жақсы бастама
Dialogue: 0,0:16:38.74,0:16:40.45,Default,,0,0,0,,Келесі жолы қабылдау керек
Dialogue: 0,0:16:41.12,0:16:43.08,Default,,0,0,0,,Жарайды, мен жеңемін.
Dialogue: 0,0:16:43.16,0:16:44.37,Default,,0,0,0,,Катсуйо
Dialogue: 0,0:16:44.46,0:16:45.75,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:16:47.00,0:16:48.04,Default,,0,0,0,,Барт
Dialogue: 0,0:16:48.13,0:16:49.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:49.09,0:16:51.88,Default,,0,0,0,,Эй, мен BC Sol тобына қосылдым және бұл дұрыс жауап болды.
Dialogue: 0,0:16:51.96,0:16:52.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:53.13,0:16:57.14,Default,,0,0,0,,Мұндай қызықты клуб жоқ! Ахаха
Dialogue: 0,0:16:57.47,0:17:00.39,Default,,0,0,0,,Түсіндім, кеттік, Кумичо.
Dialogue: 0,0:17:00.47,0:17:03.06,Default,,0,0,0,,Жеңілмейтін сәуле!
Dialogue: 0,0:17:03.85,0:17:07.90,Default,,0,0,0,,Жарайды, мен мотивация қосқышын екінші рет қостым!
Dialogue: 0,0:17:07.98,0:17:09.44,Default,,0,0,0,,Хейтер!
Dialogue: 0,0:17:09.52,0:17:13.90,Default,,0,0,0,,Енді, Б.С. Соль, екінші жүзі - Куза Акерман!
Dialogue: 0,0:17:16.03,0:17:17.53,Default,,0,0,0,,Я~
Dialogue: 0,0:17:18.07,0:17:19.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:19.20,0:17:21.87,Default,,0,0,0,,(барабан орамы)
Dialogue: 0,0:17:21.95,0:17:23.12,Default,,0,0,0,,
Dialogue: 0,0:17:23.50,0:17:27.12,Default,,0,0,0,,Иә! Бұл шоу уақыты!
Dialogue: 0,0:17:30.46,0:17:31.38,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:17:31.88,0:17:34.38,Default,,0,0,0,,Ұшу керемет!
Dialogue: 0,0:17:34.72,0:17:35.92,Default,,0,0,0,,Тондаа~
Dialogue: 0,0:17:36.01,0:17:38.89,Default,,0,0,0,,NY Bulls Екінші Блейдер Джошуа Бун
Dialogue: 0,0:17:38.97,0:17:42.43,Default,,0,0,0,,Ол ауада қалқып тұр! Бұл Flying Fabulous
Dialogue: 0,0:17:42.77,0:17:46.60,Default,,0,0,0,,Иә! Бұл сәт те бір тағдыр
Dialogue: 0,0:17:46.69,0:17:50.98,Default,,0,0,0,,Барлығына! Ешуаның бейнесі санамда өртеніп кетті.
Dialogue: 0,0:17:53.57,0:17:55.61,Default,,0,0,0,,Рахмет Яй!
Dialogue: 0,0:17:55.69,0:17:58.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:59.11,0:18:01.58,Default,,0,0,0,,Екінші ойын Бірінші шайқас
Dialogue: 0,0:18:01.99,0:18:05.66,Default,,0,0,0,,Джошуаның жігіті Сіз оған қайтадан бірінші алуға рұқсат бергіңіз келе ме?
Dialogue: 0,0:18:08.62,0:18:09.96,Default,,0,0,0,,Мидория, рингтен шық.
Dialogue: 0,0:18:10.04,0:18:14.34,Default,,0,0,0,,Мен мұны Пёнпёнмару-кунның көзінен көргенде...
Dialogue: 0,0:18:14.42,0:18:16.92,Default,,0,0,0,,Жүрегің өртеніп кетеді, солай ма?
Dialogue: 0,0:18:18.38,0:18:22.35,Default,,0,0,0,,О, жоқ, Джошуа байсалды.
Dialogue: 0,0:18:22.72,0:18:25.81,Default,,0,0,0,,Жарайды, бастайық
Dialogue: 0,0:18:26.35,0:18:28.60,Default,,0,0,0,,Ол бірдей жұмыс істемейді.
Dialogue: 0,0:18:28.69,0:18:31.61,Default,,0,0,0,,Жарайды, супер шабуыл режимі.
Dialogue: 0,0:18:33.90,0:18:35.90,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:37.44,0:18:40.61,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:40.70,0:18:43.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:46.04,0:18:47.62,Default,,0,0,0,,Сырғымалы шұңқыр
Dialogue: 0,0:18:49.46,0:18:50.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:50.54,0:18:54.25,Default,,0,0,0,,Ой, Альтер Кронос орбитадан лақтырылды!
Dialogue: 0,0:18:54.55,0:18:58.22,Default,,0,0,0,,Ол оқылды, бірақ әлі де стратегия бар.
Dialogue: 0,0:18:58.63,0:19:00.22,Default,,0,0,0,,Go Kronos
Dialogue: 0,0:19:01.84,0:19:05.06,Default,,0,0,0,,Циклон қабырғасы
Dialogue: 0,0:19:09.73,0:19:12.31,Default,,0,0,0,,Уау! Гений қайтарылды!
Dialogue: 0,0:19:12.40,0:19:13.44,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:19:13.52,0:19:14.86,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:19:22.66,0:19:26.58,Default,,0,0,0,,Мен сенің уақытыңды арқанмен сүңгумен тоқтатамын!
Dialogue: 0,0:19:28.79,0:19:31.96,Default,,0,0,0,,Иә! Драма осы жерден басталады
Dialogue: 0,0:19:32.04,0:19:34.96,Default,,0,0,0,,Бірден шарықтау шегіне жетейік!
Dialogue: 0,0:19:35.13,0:19:37.67,Default,,0,0,0,,Бластогендік!
Dialogue: 0,0:19:44.64,0:19:46.60,Default,,0,0,0,,Кроносты өзгертіңіз!
Dialogue: 0,0:19:52.14,0:19:54.81,Default,,0,0,0,,Кимеро! Кааааа!
Dialogue: 0,0:19:54.90,0:19:56.52,Default,,0,0,0,,Жеңіңіз!
Dialogue: 0,0:19:56.98,0:20:01.78,Default,,0,0,0,,Циклондық есептегіш
Dialogue: 0,0:20:03.16,0:20:04.62,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:20:04.70,0:20:05.70,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:05.78,0:20:08.58,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:20:10.87,0:20:13.29,Default,,0,0,0,,Blast Genius Burst Finish
Dialogue: 0,0:20:13.79,0:20:18.05,Default,,0,0,0,,Екінші ойында NY Bulls 2-0 есебімен жеңіске жетті.
Dialogue: 0,0:20:18.55,0:20:19.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:20.21,0:20:22.42,Default,,0,0,0,,Батырлар әрқашан жеңеді!
Dialogue: 0,0:20:22.51,0:20:25.84,Default,,0,0,0,,Сіздің уақытыңыз тоқтады. Алақай!
Dialogue: 0,0:20:28.89,0:20:29.93,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:30.02,0:20:31.10,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:31.48,0:20:33.56,Default,,0,0,0,,Ешуаның жүрегін отқа сал
Dialogue: 0,0:20:34.14,0:20:37.56,Default,,0,0,0,,Сіз де Куза Акерман өте жақсы болдыңыз
Dialogue: 0,0:20:38.27,0:20:39.69,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:20:41.74,0:20:43.65,Default,,0,0,0,,Рахмет Яй!
Dialogue: 0,0:20:43.74,0:20:46.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:46.37,0:20:48.33,Default,,0,0,0,,Барлығына сыйлық
Dialogue: 0,0:20:49.33,0:20:50.49,Default,,0,0,0,,Cuza…
Dialogue: 0,0:20:50.70,0:20:53.00,Default,,0,0,0,,Балто Кумичо
Dialogue: 0,0:20:53.33,0:20:55.46,Default,,0,0,0,,О, бұл жиіркенішті!
Dialogue: 0,0:20:55.79,0:20:58.84,Default,,0,0,0,,Мені де тітіркендіреді!
Dialogue: 0,0:20:58.92,0:21:01.13,Default,,0,0,0,,Мен бұл өте керемет деп ойладым.
Dialogue: 0,0:21:01.42,0:21:02.80,Default,,0,0,0,,Шулы
Dialogue: 0,0:21:02.88,0:21:05.22,Default,,0,0,0,,Шағымданудан гөрі, басынан жеңілмегенім артық.
Dialogue: 0,0:21:05.51,0:21:06.55,Default,,0,0,0,,Cisco!
Dialogue: 0,0:21:06.64,0:21:08.30,Default,,0,0,0,,Жеңіске жет, Cisco!
Dialogue: 0,0:21:08.39,0:21:09.51,Default,,0,0,0,,Алыңыз!
Dialogue: 0,0:21:09.60,0:21:12.89,Default,,0,0,0,,Әй, айтпасаң да түсінемін!
Dialogue: 0,0:21:15.02,0:21:17.19,Default,,0,0,0,,Жүр, бос.
Dialogue: 0,0:21:17.52,0:21:19.90,Default,,0,0,0,,Үшінші ойын тең аяқталды
Dialogue: 0,0:21:19.98,0:21:25.03,Default,,0,0,0,,Қарауға болатын үшінші блендер - BC Sol Cisco Carlyle!
Dialogue: 0,0:21:25.36,0:21:27.53,Default,,0,0,0,,Жүр! Cisco!
Dialogue: 0,0:21:27.82,0:21:33.29,Default,,0,0,0,,Ал NY Bulls - чемпион!
Dialogue: 0,0:21:33.37,0:21:36.79,Default,,0,0,0,,Бұл жігіттен әлі ешкім ұпай ұрлаған жоқ!
Dialogue: 0,0:21:36.87,0:21:41.04,Default,,0,0,0,,Блейдерлердің патшасы Де Ла Хойяны босатты!
Dialogue: 0,0:21:43.05,0:21:45.84,Default,,0,0,0,,Соңғы шайқас, жеңіске ұмтылу
Dialogue: 0,0:21:46.38,0:21:48.97,Default,,0,0,0,,Мен қарызымды өтейтін боламын.
Dialogue: 0,0:21:49.39,0:21:52.47,Default,,0,0,0,,Мен мұндай нәрсені жек көрмеймін.
Dialogue: 0,0:21:55.60,0:21:56.56,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.56,0:22:00.11,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.56,0:22:00.11,Default,,0,0,0,,Жарайсыңдар Ұлдар мен Қыздар Сіз бұлшық еттеріңізді шынықтырасыз ба?
Dialogue: 0,0:22:00.19,0:22:03.11,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.19,0:22:07.07,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:07.15,0:22:10.70,Default,,0,0,0,,GO Shoot GO Shoot Big Shoot!
Dialogue: 0,0:22:10.78,0:22:14.41,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдату!
Dialogue: 0,0:22:14.49,0:22:18.08,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.17,0:22:21.54,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.63,0:22:24.92,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:25.01,0:22:28.93,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді күшейтемін.
Dialogue: 0,0:22:29.01,0:22:32.93,Default,,0,0,0,,GO Shoot GO Shoot Bay Muscle Train Моримори
Dialogue: 0,0:22:33.01,0:22:36.56,Default,,0,0,0,,GO АТТЫ БАР АТТЫ Менің атысым – құдайдың атысы
Dialogue: 0,0:22:36.64,0:22:40.23,Default,,0,0,0,,Оң жақ ату Сол жақ ату Оңға ату
Dialogue: 0,0:22:40.31,0:22:43.98,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:44.07,0:22:47.69,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.78,0:22:51.32,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасап жатыр
Dialogue: 0,0:22:51.41,0:22:55.12,Default,,0,0,0,,Күн сайын барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:55.20,0:22:58.58,Default,,0,0,0,,Көктем/жаз/күз/қыс GO түсіру жыл бойы
Dialogue: 0,0:22:58.66,0:23:00.25,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.33,0:23:02.79,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.88,0:23:06.00,Default,,0,0,0,,Сол шиеленіспен шарықтау шегіне жетейік!
Dialogue: 0,0:23:06.09,0:23:09.80,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіру Келіңіздер!
Dialogue: 0,0:23:09.88,0:23:13.30,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.39,0:23:17.18,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.27,0:23:22.06,Default,,0,0,0,,Үш екі бір GO Shoot Burst Finish!
Dialogue: 0,0:23:22.27,0:23:25.19,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:26.82,0:23:30.74,Default,,0,0,0,,Баяу жарылыс? Бұл не? Ондай нәрсе бар ма?
Dialogue: 0,0:23:30.82,0:23:32.95,Default,,0,0,0,,Біз үлкен шымшудамыз!
Dialogue: 0,0:23:33.07,0:23:35.74,Default,,0,0,0,,Дәл осы кезде Луи кездесу орнында пайда болды.
Dialogue: 0,0:23:36.12,0:23:38.29,Default,,0,0,0,,Не? Көңілді болайық?
Dialogue: 0,0:23:38.37,0:23:40.66,Default,,0,0,0,,Менің сені уайымдайтын уақытым жоқ!
Dialogue: 0,0:23:41.42,0:23:43.58,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.67,0:23:45.54,Default,,0,0,0,,Толық қуат! Байланысты шабуыл!
Dialogue: 0,0:23:46.21,0:23:49.88,Default,,0,0,0,,Үш екі бір ату!
