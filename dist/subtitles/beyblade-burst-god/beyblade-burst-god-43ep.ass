Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:05.38,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.13,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.59,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.22,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.64,0:00:24.10,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.60,0:00:27.90,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:28.02,0:00:30.03,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:31.82,0:00:34.36,Default,,0,0,0,,God Bladers кубогының екінші кезеңі
Dialogue: 0,0:00:34.45,0:00:37.37,Default,,0,0,0,,Мен ең жақын досым Кузамен соғыстым.
Dialogue: 0,0:00:37.91,0:00:40.12,Default,,0,0,0,,Бар күшімізді салайық, Куза.
Dialogue: 0,0:00:40.66,0:00:44.62,Default,,0,0,0,,Егер Балт ең жақсы жағдайда болса, онда бұл оның ең жақсысы!
Dialogue: 0,0:00:50.09,0:00:53.34,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:00:58.34,0:01:01.18,Default,,0,0,0,,Уау, мен жасадым!
Dialogue: 0,0:01:01.81,0:01:04.39,Default,,0,0,0,,Достық шайқасы бар күшімізбен шайқасты
Dialogue: 0,0:01:04.85,0:01:06.98,Default,,0,0,0,,Мен Кузаны жеңдім.
Dialogue: 0,0:01:08.44,0:01:11.02,Default,,0,0,0,,♪~
Dialogue: 0,0:01:11.11,0:01:13.53,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:13.61,0:01:16.15,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:16.24,0:01:18.62,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:18.70,0:01:21.16,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:21.24,0:01:22.83,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:22.91,0:01:27.08,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:28.04,0:01:32.80,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:32.88,0:01:37.88,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:37.97,0:01:42.64,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:42.72,0:01:47.64,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:01:47.73,0:01:52.57,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:01:52.65,0:01:57.82,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:01:57.90,0:02:01.03,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:01.12,0:02:02.58,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:02.66,0:02:05.25,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:05.33,0:02:07.71,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:07.79,0:02:09.71,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:09.79,0:02:11.00,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:11.08,0:02:12.71,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:12.79,0:02:15.13,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:15.21,0:02:21.43,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:21.51,0:02:25.68,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:25.77,0:02:28.73,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:28.81,0:02:31.15,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:31.23,0:02:33.19,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:33.19,0:02:33.61,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:33.19,0:02:33.61,Default,,0,0,0,,~♪
Dialogue: 0,0:02:33.61,0:02:33.69,Default,,0,0,0,,~♪
Dialogue: 0,0:02:33.69,0:02:37.40,Default,,0,0,0,,~♪
Dialogue: 0,0:02:33.69,0:02:37.40,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:37.40,0:02:37.99,Default,,0,0,0,,~♪
Dialogue: 0,0:02:39.24,0:02:42.03,Default,,0,0,0,,Қыздыру! Керемет бәсекелестік!
Dialogue: 0,0:02:44.58,0:02:46.95,Default,,0,0,0,,Жанып тұрған жалын ғибадатханасы Кайза және Сонг Лувей
Dialogue: 0,0:02:47.04,0:02:51.29,Default,,0,0,0,,Жетінші шайқаста командаластардың кездесуі аяқталды!
Dialogue: 0,0:02:52.38,0:02:54.34,Default,,0,0,0,,Уау
Dialogue: 0,0:02:57.42,0:03:02.89,Default,,0,0,0,,Үш есе әсер етіңіз!
Dialogue: 0,0:03:05.56,0:03:08.64,Default,,0,0,0,,Келіңіздер, қорғаныңыз
Dialogue: 0,0:03:22.28,0:03:23.32,Default,,0,0,0,,На
Dialogue: 0,0:03:25.74,0:03:28.62,Default,,0,0,0,,Зиг Экскалибур аяқталды
Dialogue: 0,0:03:29.87,0:03:32.17,Default,,0,0,0,,Жеңімпаз Кайза жанып тұрған храм
Dialogue: 0,0:03:32.87,0:03:34.83,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:03:34.92,0:03:36.34,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:36.42,0:03:39.09,Default,,0,0,0,,Бразилия Риостың командаластарының қарсыласы -
Dialogue: 0,0:03:39.17,0:03:42.30,Default,,0,0,0,,Жанып тұрған ғибадатхананың Кайзасы жеңді!
Dialogue: 0,0:03:43.09,0:03:45.55,Default,,0,0,0,,Келіңіздер, келіңіздер, келесі шайқасты тамашалаңыздар
Dialogue: 0,0:03:45.64,0:03:49.35,Default,,0,0,0,,Аты аңызға айналған әлем чемпионы Император Курц Баратьемен...
Dialogue: 0,0:03:49.43,0:03:50.98,Default,,0,0,0,,Бұл қызыл көздің сәйкестігі!
Dialogue: 0,0:03:54.31,0:03:55.27,Default,,0,0,0,,Шу…
Dialogue: 0,0:03:55.94,0:03:57.48,Default,,0,0,0,,
Dialogue: 0,0:04:08.83,0:04:11.08,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:04:11.75,0:04:15.08,Default,,0,0,0,,Жең, жең...
Dialogue: 0,0:04:15.54,0:04:19.34,Default,,0,0,0,,Курц мырза! Бұл біздің жер асты әлемі
Dialogue: 0,0:04:19.42,0:04:21.42,Default,,0,0,0,,Мен оны шатастырдым.
Dialogue: 0,0:04:21.51,0:04:24.18,Default,,0,0,0,,Бұны соққымен орындаңыз.
Dialogue: 0,0:04:24.51,0:04:27.64,Default,,0,0,0,,Бұл жігіттер шынымен жаман екен.
Dialogue: 0,0:04:27.76,0:04:30.72,Default,,0,0,0,,Бірақ Курцтың қабілеті шынайы.
Dialogue: 0,0:04:30.81,0:04:33.10,Default,,0,0,0,,Иә, Аники де.
Dialogue: 0,0:04:33.18,0:04:36.23,Default,,0,0,0,,Мен жеңілуге ​​бір-ақ қадам қалдым.
Dialogue: 0,0:04:37.61,0:04:41.32,Default,,0,0,0,,Кумичо бір сәтте жеңіліп қалды.
Dialogue: 0,0:04:41.40,0:04:44.11,Default,,0,0,0,,Да... Урухе! Хмм...
Dialogue: 0,0:04:44.82,0:04:47.95,Default,,0,0,0,,Курц Баратье, бір кездері әлемде бірінші орында тұрған...
Dialogue: 0,0:04:48.03,0:04:51.20,Default,,0,0,0,,Оның ешқашан жеңілмейтін жеңілмейтін мифі бар.
Dialogue: 0,0:04:51.29,0:04:53.58,Default,,0,0,0,,Бладер туралы аңыз
Dialogue: 0,0:04:53.66,0:04:57.71,Default,,0,0,0,,Екінші жағынан, жын Қызыл көз жұмбақ пердеге оранған.
Dialogue: 0,0:04:57.96,0:05:02.46,Default,,0,0,0,,Енді, оның кескілескен ұрыс болатынына еш күмән жоқ!
Dialogue: 0,0:05:03.84,0:05:08.85,Default,,0,0,0,,Сіз бұл көзбен не жоспарлап отырсыз? мақсатың не?
Dialogue: 0,0:05:08.93,0:05:11.76,Default,,0,0,0,,Барлық шығанақтарды жойыңыз
Dialogue: 0,0:05:12.52,0:05:13.77,Default,,0,0,0,,Сіздің шығанақ
Dialogue: 0,0:05:14.27,0:05:15.85,Default,,0,0,0,,Солардың бірі ғана
Dialogue: 0,0:05:16.27,0:05:19.36,Default,,0,0,0,,Мен сені жақын арада өкіндіремін
Dialogue: 0,0:05:20.15,0:05:22.36,Default,,0,0,0,,Маған не істедің
Dialogue: 0,0:05:22.86,0:05:24.40,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:05:27.99,0:05:29.70,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:05:30.20,0:05:32.91,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:33.95,0:05:35.91,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:37.58,0:05:39.08,Default,,0,0,0,,Зәулім ғимараттың түсірілімі
Dialogue: 0,0:05:41.88,0:05:46.63,Default,,0,0,0,,Уау, Спригган сағат тіліне қарсы қорғаныс режимінде келді!
Dialogue: 0,0:05:46.72,0:05:51.85,Default,,0,0,0,,Ол қарсыласына байланысты ұрыс стилін өзгертетін нағыз протеин Бей!
Dialogue: 0,0:05:57.02,0:06:00.77,Default,,0,0,0,,Таңғажайып, таңғажайып, Кукулканның жылдам шабуылы!
Dialogue: 0,0:06:01.15,0:06:04.90,Default,,0,0,0,,Спригган Сізде сонша күш бар ма?
Dialogue: 0,0:06:08.86,0:06:11.57,Default,,0,0,0,,Шабуыл жасау!
Dialogue: 0,0:06:18.29,0:06:21.08,Default,,0,0,0,,Кукулканды аяқтаңыз
Dialogue: 0,0:06:21.17,0:06:23.13,Default,,0,0,0,,1 ұпай Курц Баратье үшін
Dialogue: 0,0:06:24.09,0:06:27.01,Default,,0,0,0,,Кукулкан өте күшті!
Dialogue: 0,0:06:27.09,0:06:31.97,Default,,0,0,0,,Бұл бұрынғы әлем чемпионы шығанағының күші!
Dialogue: 0,0:06:32.68,0:06:35.93,Default,,0,0,0,,Біз мұны істедік, Курц-сама~
Dialogue: 0,0:06:36.02,0:06:38.10,Default,,0,0,0,,Жеңіс Жеңіс
Dialogue: 0,0:06:38.39,0:06:39.44,Default,,0,0,0,,Шу…
Dialogue: 0,0:06:39.52,0:06:42.23,Default,,0,0,0,,Курц, бұл өте керемет.
Dialogue: 0,0:06:42.90,0:06:46.07,Default,,0,0,0,,Менің ойымша, ешкім Курцты күшпен жеңе алмайды.
Dialogue: 0,0:06:46.69,0:06:49.45,Default,,0,0,0,,Бұл Курц ең күшті дегенді білдіре ме?
Dialogue: 0,0:06:49.99,0:06:52.87,Default,,0,0,0,,Бидің күші жай ғана билік емес.
Dialogue: 0,0:06:53.16,0:06:54.53,Default,,0,0,0,,Фофофу~
Dialogue: 0,0:06:55.12,0:06:56.70,Default,,0,0,0,,Ай-ай-ай!
Dialogue: 0,0:06:57.20,0:07:00.42,Default,,0,0,0,,Мені ренжіткеніңізге өкінесіз деп үміттенемін.
Dialogue: 0,0:07:01.42,0:07:02.92,Default,,0,0,0,,Менің де айтуым керек еді.
Dialogue: 0,0:07:03.33,0:07:04.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:05.92,0:07:09.72,Default,,0,0,0,,Мен сіздің шығанақты міндетті түрде жойамын
Dialogue: 0,0:07:10.43,0:07:12.14,Default,,0,0,0,,Сөзсіз!
Dialogue: 0,0:07:13.34,0:07:16.18,Default,,0,0,0,,Әй, сен сондай надансың.
Dialogue: 0,0:07:16.76,0:07:18.39,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:07:20.10,0:07:21.81,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:07:22.23,0:07:25.52,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:25.98,0:07:29.11,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:30.82,0:07:34.57,Default,,0,0,0,,Wow Spriggan Енді сағат тіліне қарсы айналдыру арқылы шабуыл режимі
Dialogue: 0,0:07:35.20,0:07:38.16,Default,,0,0,0,,Хмф, сен менімен жарыспақсың ба?
Dialogue: 0,0:07:38.29,0:07:39.54,Default,,0,0,0,,Кукулкан!
Dialogue: 0,0:07:43.25,0:07:44.79,Default,,0,0,0,,(айқай)
Dialogue: 0,0:07:45.25,0:07:47.21,Default,,0,0,0,,Найзағай шабуылы!
Dialogue: 0,0:07:50.63,0:07:51.84,Default,,0,0,0,,Спригган
Dialogue: 0,0:07:56.64,0:07:58.85,Default,,0,0,0,,(Айналмалы дыбыс)
Dialogue: 0,0:08:00.93,0:08:02.39,Default,,0,0,0,,Уау Кукульжан
Dialogue: 0,0:08:02.77,0:08:04.90,Default,,0,0,0,,Мен Спригганның күшін ұрлап жатырмын!
Dialogue: 0,0:08:05.23,0:08:09.28,Default,,0,0,0,,Я, менімен бәсекелесу кері әсер етті.
Dialogue: 0,0:08:10.11,0:08:12.53,Default,,0,0,0,,Иә? қызылша кукулкан
Dialogue: 0,0:08:12.61,0:08:15.16,Default,,0,0,0,,Соқтығыс болған сайын жылдамдық артады.
Dialogue: 0,0:08:16.49,0:08:18.58,Default,,0,0,0,,О, Құқұлқан құдай
Dialogue: 0,0:08:18.66,0:08:23.50,Default,,0,0,0,,Сіз бақылаусыз қалдыңыз ба? Бұл бақыланбайтын шабуыл.
Dialogue: 0,0:08:26.79,0:08:28.25,Default,,0,0,0,,Құқұлқан не болды?
Dialogue: 0,0:08:28.67,0:08:30.84,Default,,0,0,0,,Слеш реквиемі
Dialogue: 0,0:08:31.51,0:08:33.76,Default,,0,0,0,,(Айналмалы дыбыс)
Dialogue: 0,0:08:38.05,0:08:39.47,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:08:39.56,0:08:40.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:41.31,0:08:42.73,Default,,0,0,0,,Әй, ә
Dialogue: 0,0:08:43.52,0:08:46.48,Default,,0,0,0,,Спригган реквиемінің жарқырауы
Dialogue: 0,0:08:46.60,0:08:48.36,Default,,0,0,0,,Жеңімпаз қызыл көз!
Dialogue: 0,0:08:48.90,0:08:49.86,Default,,0,0,0,,Иә
Dialogue: 0,0:08:50.40,0:08:53.07,Default,,0,0,0,,Күшті! Сен мықтысың, Қызыл көз!
Dialogue: 0,0:08:53.15,0:08:56.32,Default,,0,0,0,,Аты аңызға айналған әлем чемпионы Император Курц Баратье
Dialogue: 0,0:08:56.41,0:08:59.37,Default,,0,0,0,,Бұл менің бірінші жеңілісім!
Dialogue: 0,0:08:59.45,0:09:01.24,Default,,0,0,0,,Керемет... Курц мырза...
Dialogue: 0,0:09:03.12,0:09:04.58,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:09:05.00,0:09:07.08,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:09:09.09,0:09:12.09,Default,,0,0,0,,Сіз оны қазір жойдым деп ойлайсыз ба?
Dialogue: 0,0:09:12.17,0:09:14.09,Default,,0,0,0,,(айқай)
Dialogue: 0,0:09:14.76,0:09:18.80,Default,,0,0,0,,Сен Кукулканды қатты ашуландырдың.
Dialogue: 0,0:09:19.64,0:09:21.51,Default,,0,0,0,,Мен сіздің өкінетініңізге көз жеткіземін
Dialogue: 0,0:09:22.22,0:09:24.06,Default,,0,0,0,,Оны асыға күтіңіз
Dialogue: 0,0:09:25.98,0:09:28.06,Default,,0,0,0,,Не болды, Зоро?
Dialogue: 0,0:09:28.52,0:09:31.23,Default,,0,0,0,,Кукулкан дымқыл...
Dialogue: 0,0:09:31.32,0:09:32.82,Default,,0,0,0,,Ылғалдылық?
Dialogue: 0,0:09:33.90,0:09:36.61,Default,,0,0,0,,Кукулкан шабуыл жасағанда
Dialogue: 0,0:09:36.86,0:09:40.28,Default,,0,0,0,,Спригганның айналу жылдамдығы жоғары болды.
Dialogue: 0,0:09:41.03,0:09:45.96,Default,,0,0,0,,Кукулканды көбірек айналдыру үшін резеңке қабатын пайдаланыңыз.
Dialogue: 0,0:09:46.04,0:09:47.71,Default,,0,0,0,,Сіз оны бақылаудан шығардыңыз.
Dialogue: 0,0:09:48.46,0:09:51.09,Default,,0,0,0,,Сондықтан сіз бақылауды жоғалттыңыз.
Dialogue: 0,0:09:51.79,0:09:54.59,Default,,0,0,0,,Бұл Қызыл көздің соншалықты есептегенін білдіре ме?
Dialogue: 0,0:09:55.26,0:09:56.59,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:56.67,0:09:59.51,Default,,0,0,0,,Қорқынышты күшті болып кеткен жоқ па?
Dialogue: 0,0:10:04.47,0:10:06.56,Default,,0,0,0,,Джошуа, уақыт келді.
Dialogue: 0,0:10:07.06,0:10:10.02,Default,,0,0,0,,Бұл сіз Free бағдарламасымен күткен матч.
Dialogue: 0,0:10:11.52,0:10:15.36,Default,,0,0,0,,Trad Мен қалай ұтып аламын?
Dialogue: 0,0:10:17.86,0:10:20.82,Default,,0,0,0,,Мен өте тегін ұтқым келеді!
Dialogue: 0,0:10:21.45,0:10:22.66,Default,,0,0,0,,Ешуа…
Dialogue: 0,0:10:23.20,0:10:25.75,Default,,0,0,0,,Free - қазірдің өзінде командада...
Dialogue: 0,0:10:26.54,0:10:28.37,Default,,0,0,0,,Таңданатын нәрсе емес
Dialogue: 0,0:10:29.08,0:10:30.67,Default,,0,0,0,,Бір қарсылас
Dialogue: 0,0:10:30.79,0:10:31.75,Default,,0,0,0,,Ах
Dialogue: 0,0:10:32.88,0:10:33.92,Default,,0,0,0,,Ешуа
Dialogue: 0,0:10:34.25,0:10:37.13,Default,,0,0,0,,Қаласаңыз, тегін ұта аласыз.
Dialogue: 0,0:10:39.97,0:10:41.84,Default,,0,0,0,,Менің жоспарымды орындаңыз.
Dialogue: 0,0:10:42.55,0:10:43.76,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:10:44.47,0:10:45.77,Default,,0,0,0,,Okay!
Dialogue: 0,0:10:45.85,0:10:49.10,Default,,0,0,0,,Арманға ұқсас жауынгерлік карталар келе береді
Dialogue: 0,0:10:49.48,0:10:52.48,Default,,0,0,0,,Содан кейін екеуі Нью-Йорк Буллзда командалас болды.
Dialogue: 0,0:10:52.56,0:10:55.52,Default,,0,0,0,,Де Ла Хойя мен Джошуа Бун тегін!
Dialogue: 0,0:10:55.61,0:10:57.11,Default,,0,0,0,,Бұл біздің бірінші қақтығысымыз!
Dialogue: 0,0:10:57.19,0:11:00.11,Default,,0,0,0,,Құрметті Джошуа
Dialogue: 0,0:11:00.20,0:11:01.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:02.07,0:11:03.20,Default,,0,0,0,,Иә
Dialogue: 0,0:11:04.33,0:11:06.58,Default,,0,0,0,,Тегін ұтыс!
Dialogue: 0,0:11:06.66,0:11:08.16,Default,,0,0,0,,Джошуа сияқты нәрсе...
Dialogue: 0,0:11:08.25,0:11:10.75,Default,,0,0,0,,Джош Уан
Dialogue: 0,0:11:10.83,0:11:13.17,Default,,0,0,0,,Мен сенімен біргемін~
Dialogue: 0,0:11:13.25,0:11:14.84,Default,,0,0,0,,Ай!
Dialogue: 0,0:11:17.21,0:11:20.68,Default,,0,0,0,,Иә? Джошуа өте тыныш.
Dialogue: 0,0:11:20.76,0:11:23.68,Default,,0,0,0,,Сіз ұялшақсыз, сүйкімді екеніңізге сенімдімін!
Dialogue: 0,0:11:23.76,0:11:25.30,Default,,0,0,0,,Бұл доп емес, солай ма?
Dialogue: 0,0:11:29.68,0:11:32.81,Default,,0,0,0,,Көңіл көтеруші Джошуа...
Dialogue: 0,0:11:32.90,0:11:35.11,Default,,0,0,0,,Мен ешқандай спектакль көрсетпеймін.
Dialogue: 0,0:11:35.19,0:11:37.53,Default,,0,0,0,,Жанкүйерлердің қошеметіне жауап бермейді
Dialogue: 0,0:11:37.61,0:11:40.53,Default,,0,0,0,,Не болды!
Dialogue: 0,0:11:40.61,0:11:42.03,Default,,0,0,0,,Бүгін той күні болады.
Dialogue: 0,0:11:42.66,0:11:44.07,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:11:45.87,0:11:47.66,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:49.79,0:11:52.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:53.37,0:11:55.42,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:57.50,0:12:00.63,Default,,0,0,0,,Біріншіден, бұл орталық үшін шайқас.
Dialogue: 0,0:12:03.18,0:12:06.80,Default,,0,0,0,,Оны алған адам резеңке сіңіретін Фафнир еді.
Dialogue: 0,0:12:06.89,0:12:10.06,Default,,0,0,0,,Генийдің күшін сарқуды жоспарлап отырсыз ба?
Dialogue: 0,0:12:10.81,0:12:13.60,Default,,0,0,0,,Циклон қабырғасы!
Dialogue: 0,0:12:18.98,0:12:21.32,Default,,0,0,0,,Сәттілік гений!
Dialogue: 0,0:12:22.07,0:12:24.16,Default,,0,0,0,,Ең алдымен, Циклон қабырғасы?
Dialogue: 0,0:12:24.61,0:12:27.37,Default,,0,0,0,,Сіз бұл жерден не істеуді жоспарлап отырсыз?
Dialogue: 0,0:12:30.62,0:12:33.41,Default,,0,0,0,,Циклон қабырғасы! Циклон қабырғасы Циклон қабырғасы!
Dialogue: 0,0:12:33.50,0:12:36.29,Default,,0,0,0,,Циклон қабырғасы қайталанады.
Dialogue: 0,0:12:36.83,0:12:39.34,Default,,0,0,0,,Данышпан, қарсы шықпайсың ба?
Dialogue: 0,0:12:39.88,0:12:41.96,Default,,0,0,0,,Не істеп жатырсың, данышпан?
Dialogue: 0,0:12:42.63,0:12:46.18,Default,,0,0,0,,Оған үнемі шабуыл жасалуда. Ол тіпті маған көмектесуге тырыспайды.
Dialogue: 0,0:12:46.68,0:12:48.05,Default,,0,0,0,,А... мүмкін емес!
Dialogue: 0,0:12:48.64,0:12:50.35,Default,,0,0,0,,Бұл Джошуаның жоспары ма?
Dialogue: 0,0:12:50.43,0:12:51.39,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:51.93,0:12:54.27,Default,,0,0,0,,Сахрон қабырғасын қайталау арқылы
Dialogue: 0,0:12:54.56,0:12:58.11,Default,,0,0,0,,Фафнирдің ағызу спині жойылды.
Dialogue: 0,0:12:58.90,0:13:00.86,Default,,0,0,0,,Джошуа өзінен артық
Dialogue: 0,0:13:00.94,0:13:03.69,Default,,0,0,0,,Менің ойымша, сіз жеңіске басымдық беруге тырысып жатырсыз.
Dialogue: 0,0:13:08.82,0:13:11.04,Default,,0,0,0,,Жарайды, дерлік бар.
Dialogue: 0,0:13:11.45,0:13:12.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:12.70,0:13:14.37,Default,,0,0,0,,Фафнир тоқтайды.
Dialogue: 0,0:13:14.62,0:13:16.04,Default,,0,0,0,,Ах! Фафнир
Dialogue: 0,0:13:16.12,0:13:19.29,Default,,0,0,0,,Қуатты сіңіре алмағандықтан шыдамыңыз таусылып жатыр ма? ?
Dialogue: 0,0:13:21.30,0:13:23.67,Default,,0,0,0,,Blast Genius Spin Finish
Dialogue: 0,0:13:24.51,0:13:26.26,Default,,0,0,0,,Джошуа Бунға 1 ұпай
Dialogue: 0,0:13:27.30,0:13:28.39,Default,,0,0,0,,Фафнир...
Dialogue: 0,0:13:28.47,0:13:29.93,Default,,0,0,0,,Тоқтатылды...
Dialogue: 0,0:13:30.10,0:13:32.43,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:33.10,0:13:34.27,Default,,0,0,0,,Тегін…
Dialogue: 0,0:13:40.06,0:13:43.94,Default,,0,0,0,,Міне, күтпеген жағдай болды.
Dialogue: 0,0:13:44.03,0:13:46.70,Default,,0,0,0,,Фафнирді айналдырыңыз!
Dialogue: 0,0:13:46.78,0:13:50.70,Default,,0,0,0,,Қорқынышты Гений Қорқынышты Джошуа Бун!
Dialogue: 0,0:13:50.91,0:13:51.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:54.33,0:13:55.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:58.00,0:14:01.17,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:14:02.55,0:14:05.38,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:14:05.67,0:14:08.51,Default,,0,0,0,,Иә, жақсы, Джошуа!
Dialogue: 0,0:14:09.76,0:14:14.06,Default,,0,0,0,,Тегін ойындарды ұтқыңыз келсе, жұлдыз болуды ұмытыңыз.
Dialogue: 0,0:14:14.60,0:14:17.56,Default,,0,0,0,,«Жұлдыз болуды ұмыт»?
Dialogue: 0,0:14:18.23,0:14:20.65,Default,,0,0,0,,Бұл жай немесе салқын ма маңызды емес.
Dialogue: 0,0:14:20.86,0:14:23.02,Default,,0,0,0,,Лас шайқас
Dialogue: 0,0:14:24.32,0:14:26.40,Default,,0,0,0,,Джошуа, сен жеңе аласың!
Dialogue: 0,0:14:26.82,0:14:30.20,Default,,0,0,0,,Бұл Ешуа Фафнирді тоқтатты.
Dialogue: 0,0:14:30.78,0:14:33.12,Default,,0,0,0,,Мен еркін ойыннан 1 ұпай алдым
Dialogue: 0,0:14:33.37,0:14:34.83,Default,,0,0,0,,Ешуа~
Dialogue: 0,0:14:34.91,0:14:36.91,Default,,0,0,0,,Керемет тамаша керемет~
Dialogue: 0,0:14:37.00,0:14:39.33,Default,,0,0,0,,Ешуа~
Dialogue: 0,0:14:39.42,0:14:41.71,Default,,0,0,0,,Ешуа~
Dialogue: 0,0:14:42.33,0:14:43.84,Default,,0,0,0,,Қый!
Dialogue: 0,0:14:43.96,0:14:49.26,Default,,0,0,0,,Джошуа Джошуа Джошуа…
Dialogue: 0,0:14:50.05,0:14:54.39,Default,,0,0,0,,Fo~! Сәлем ұшыңыз!
Dialogue: 0,0:15:00.31,0:15:02.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:03.23,0:15:04.40,Default,,0,0,0,,О!
Dialogue: 0,0:15:05.07,0:15:07.57,Default,,0,0,0,,Мені күттірме, балақай!
Dialogue: 0,0:15:07.82,0:15:11.66,Default,,0,0,0,,Бұл шоу уақытының басы!
Dialogue: 0,0:15:11.78,0:15:14.16,Default,,0,0,0,,Иә
Dialogue: 0,0:15:14.45,0:15:17.37,Default,,0,0,0,,А, Джошуа, жоқ!
Dialogue: 0,0:15:17.45,0:15:21.75,Default,,0,0,0,,Мен Хадеге еркін шарықтауға рұқсат беремін.
Dialogue: 0,0:15:22.29,0:15:24.38,Default,,0,0,0,,Мен де оны асыға күтемін.
Dialogue: 0,0:15:24.46,0:15:27.71,Default,,0,0,0,,Маған көрсету уақытын көрсетіңіз
Dialogue: 0,0:15:27.84,0:15:30.09,Default,,0,0,0,,Жарайды тегін
Dialogue: 0,0:15:30.22,0:15:32.80,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:15:35.47,0:15:36.81,Default,,0,0,0,,(Бұзылған дыбыс)
Dialogue: 0,0:15:39.98,0:15:43.15,Default,,0,0,0,,Like Fabulous!
Dialogue: 0,0:15:45.81,0:15:47.73,Default,,0,0,0,,Циклон қабырғасы
Dialogue: 0,0:15:48.98,0:15:50.49,Default,,0,0,0,,Көтеріңкі көңіл-күйдегі данышпан
Dialogue: 0,0:15:50.57,0:15:52.99,Default,,0,0,0,,Сіз қайтадан айналдыруды мақсат етіп жатырсыз ба?
Dialogue: 0,0:15:53.45,0:15:57.37,Default,,0,0,0,,Жақсы, Rolling Blast Genius!
Dialogue: 0,0:15:59.08,0:16:03.67,Default,,0,0,0,,Джошуа Бунның Фриді жеңетін уақыты келді.
Dialogue: 0,0:16:04.21,0:16:05.63,Default,,0,0,0,,Сәлем Джошуа!
Dialogue: 0,0:16:05.71,0:16:07.67,Default,,0,0,0,,Гений!
Dialogue: 0,0:16:17.10,0:16:20.81,Default,,0,0,0,,Қазір! циклондық есептегіш
Dialogue: 0,0:16:21.10,0:16:22.77,Default,,0,0,0,,Циклон қабырғасы!
Dialogue: 0,0:16:22.85,0:16:25.15,Default,,0,0,0,,(түтіннің шығуы)
Dialogue: 0,0:16:27.82,0:16:30.32,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:16:30.78,0:16:33.53,Default,,0,0,0,,Иә! Берри керемет
Dialogue: 0,0:16:33.65,0:16:34.82,Default,,0,0,0,,...Не!
Dialogue: 0,0:16:36.62,0:16:37.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:38.62,0:16:41.04,Default,,0,0,0,,Ағызу Fafnir Burst Finish
Dialogue: 0,0:16:41.83,0:16:44.04,Default,,0,0,0,,Жеңімпаз тегін Де Ла Хойя
Dialogue: 0,0:16:44.67,0:16:50.05,Default,,0,0,0,,Не... не... не! Жарылып кеткен данышпан болды.
Dialogue: 0,0:16:50.71,0:16:52.51,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:16:53.38,0:16:54.68,Default,,0,0,0,,Құдай-ай.
Dialogue: 0,0:16:55.47,0:16:56.84,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:16:59.47,0:17:01.43,Default,,0,0,0,,Ия, бұл тегін!
Dialogue: 0,0:17:01.52,0:17:02.68,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:17:03.31,0:17:05.23,Default,,0,0,0,,Бұл тамаша мүмкіндік болды.
Dialogue: 0,0:17:06.06,0:17:07.44,Default,,0,0,0,,Ақымақ нәрсе жасаңыз...
Dialogue: 0,0:17:07.77,0:17:09.69,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:10.23,0:17:12.11,Default,,0,0,0,,Ешуа неге жеңілді?
Dialogue: 0,0:17:12.65,0:17:15.61,Default,,0,0,0,,Джошуа – туған жұлдыз.
Dialogue: 0,0:17:16.11,0:17:18.53,Default,,0,0,0,,Бұл менің өмірім үшін қымбат болды.
Dialogue: 0,0:17:18.62,0:17:19.83,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:20.37,0:17:24.75,Default,,0,0,0,,Айналуы әлсіреген Фафнирге шабуыл жасау арқылы...
Dialogue: 0,0:17:24.87,0:17:27.33,Default,,0,0,0,,Баяу жарылысты тудырды
Dialogue: 0,0:17:27.83,0:17:31.63,Default,,0,0,0,,Бұл циклон қабырғасын жасай берсем...
Dialogue: 0,0:17:31.80,0:17:35.17,Default,,0,0,0,,Джошуаның жеңіске жету мүмкіндігі болуы мүмкін.
Dialogue: 0,0:17:35.26,0:17:36.63,Default,,0,0,0,,Фуфу~
Dialogue: 0,0:17:37.76,0:17:41.31,Default,,0,0,0,,Келесі шайқас Nightmare Longinus пайдаланушысына қарсы болады.
Dialogue: 0,0:17:41.39,0:17:43.81,Default,,0,0,0,,Ширасаги сарайы Луис қарсы
Dialogue: 0,0:17:43.89,0:17:49.31,Default,,0,0,0,,Бұл турнирде назар аударатын қара жылқы Сиско Карлайл арасындағы матч.
Dialogue: 0,0:17:50.44,0:17:51.86,Default,,0,0,0,,Cisco!
Dialogue: 0,0:17:51.94,0:17:53.73,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:17:55.74,0:17:59.74,Default,,0,0,0,,Хехехе, ең жақсы формадағы бақытты бала пайда болды ма?
Dialogue: 0,0:17:59.82,0:18:01.83,Default,,0,0,0,,Бақытты бала?
Dialogue: 0,0:18:01.91,0:18:05.50,Default,,0,0,0,,Сіз Әлемдік лиганың финалында Джошуаны жеңдіңіз...
Dialogue: 0,0:18:05.58,0:18:09.21,Default,,0,0,0,,Бұл жолы да үлкен бестіктің бірі Шаканы жеңдім.
Dialogue: 0,0:18:10.04,0:18:12.50,Default,,0,0,0,,Сіз менің жолым болды дейсіз бе?
Dialogue: 0,0:18:13.17,0:18:16.01,Default,,0,0,0,,Жеңіске жетудің басқа себебі бар деп айтасыз ба?
Dialogue: 0,0:18:16.34,0:18:20.14,Default,,0,0,0,,Я, мен саған өзімнің қаншалықты күшті екенімді бірден көрсетемін.
Dialogue: 0,0:18:20.76,0:18:25.02,Default,,0,0,0,,Түнгі түн Лонгинус Теме – қорқынышты түс көретін адам.
Dialogue: 0,0:18:25.64,0:18:27.43,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:18:27.89,0:18:30.23,Default,,0,0,0,,Сіз қызықты нәрселерді айтасыз.
Dialogue: 0,0:18:30.35,0:18:34.82,Default,,0,0,0,,Қаншалықты күшті екеніңді білмеймін, бірақ мені жерге қаратпа.
Dialogue: 0,0:18:35.90,0:18:37.03,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:18:38.99,0:18:40.66,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:41.16,0:18:43.87,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:44.58,0:18:47.25,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:47.33,0:18:48.46,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:18:53.84,0:18:57.38,Default,,0,0,0,,Китар! Crys Шайтанның роликті қорғанысы!
Dialogue: 0,0:18:57.67,0:18:59.88,Default,,0,0,0,,Бұл бекер, Лонгинус!
Dialogue: 0,0:19:09.35,0:19:11.56,Default,,0,0,0,,Қолыңнан келсе, істе!
Dialogue: 0,0:19:18.90,0:19:20.24,Default,,0,0,0,,(үру)
Dialogue: 0,0:19:22.57,0:19:24.78,Default,,0,0,0,,Мен сені нағыз қорқынышты түс көремін
Dialogue: 0,0:19:25.45,0:19:27.54,Default,,0,0,0,,Металл айдаһардың қақтығысы!
Dialogue: 0,0:19:28.20,0:19:30.79,Default,,0,0,0,,Циклондық цикл!
Dialogue: 0,0:19:39.88,0:19:42.38,Default,,0,0,0,,Жарылу және шашырау!
Dialogue: 0,0:19:42.72,0:19:43.97,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:44.51,0:19:45.47,Default,,0,0,0,,Не!
Dialogue: 0,0:19:47.06,0:19:49.93,Default,,0,0,0,,Nightmare Longinus Burst Finish
Dialogue: 0,0:19:50.35,0:19:52.60,Default,,0,0,0,,Жеңімпаз Ширасадиджо Луи!
Dialogue: 0,0:19:53.35,0:19:54.98,Default,,0,0,0,,Fuhahahahahaha
Dialogue: 0,0:19:55.06,0:19:58.36,Default,,0,0,0,,Оның әлсіздігі сонша, күлкілі Crys Satan
Dialogue: 0,0:19:58.78,0:20:01.24,Default,,0,0,0,,Енді менің алдымда көрінбе!
Dialogue: 0,0:20:01.70,0:20:04.95,Default,,0,0,0,,Бұл керемет жойқын күш, Лонгинус.
Dialogue: 0,0:20:05.24,0:20:06.12,Default,,0,0,0,,Луис…
Dialogue: 0,0:20:06.95,0:20:08.99,Default,,0,0,0,,Норман Боаға қарсы!
Dialogue: 0,0:20:09.08,0:20:12.50,Default,,0,0,0,,Жылан шұңқырларының арасындағы тартыс басталды!
Dialogue: 0,0:20:23.18,0:20:25.68,Default,,0,0,0,,Бахамут өзгерді!
Dialogue: 0,0:20:26.01,0:20:27.30,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:20:35.69,0:20:36.90,Default,,0,0,0,,Бахамут!
Dialogue: 0,0:20:40.94,0:20:42.11,Default,,0,0,0,,(үру)
Dialogue: 0,0:20:47.87,0:20:50.91,Default,,0,0,0,,Соңғы апат!
Dialogue: 0,0:20:54.00,0:20:56.04,Default,,0,0,0,,Балға ұрыңыз!
Dialogue: 0,0:21:05.09,0:21:06.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:06.84,0:21:09.51,Default,,0,0,0,,Егіз жаудың жарылуы
Dialogue: 0,0:21:09.89,0:21:12.06,Default,,0,0,0,,Жеңімпаз Норман Тарвер
Dialogue: 0,0:21:13.52,0:21:19.40,Default,,0,0,0,,Норман Тарвер Бұл оның Куоза матчынан кейінгі екінші жеңісі!
Dialogue: 0,0:21:19.86,0:21:20.82,Default,,0,0,0,,Иә
Dialogue: 0,0:21:22.11,0:21:23.28,Default,,0,0,0,,Сәлем Зоро
Dialogue: 0,0:21:24.24,0:21:26.91,Default,,0,0,0,,Ашрам туралы естіген жоқсыз ба?
Dialogue: 0,0:21:27.53,0:21:30.53,Default,,0,0,0,,Жылан шұңқырының бастығы туралы айтасыз ба?
Dialogue: 0,0:21:30.66,0:21:31.62,Default,,0,0,0,,Иә
Dialogue: 0,0:21:31.87,0:21:36.50,Default,,0,0,0,,Мен бұл турнирге сахнаның артында әсер етіп жатыр деген қауесетті естідім.
Dialogue: 0,0:21:37.12,0:21:39.21,Default,,0,0,0,,Бұл дұрыс болуы мүмкін.
Dialogue: 0,0:21:39.58,0:21:40.67,Default,,0,0,0,,Зоро?
Dialogue: 0,0:21:40.75,0:21:46.47,Default,,0,0,0,,Олай болса, не жоспарлап отырсыз? Бұл жұмбақ.
Dialogue: 0,0:21:55.56,0:21:56.52,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.52,0:22:00.06,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.52,0:22:00.06,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, бұлшық еттеріңді жаттығып жатырсыңдар ма?
Dialogue: 0,0:22:00.15,0:22:00.98,Default,,0,0,0,,Енді күте тұрыңыз.
Dialogue: 0,0:22:01.06,0:22:03.07,Default,,0,0,0,,Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.15,0:22:04.82,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқынды.
Dialogue: 0,0:22:04.90,0:22:07.03,Default,,0,0,0,,Алдымен алдыңғы эпизодты, сосын көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:07.11,0:22:10.70,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.78,0:22:14.41,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдату!
Dialogue: 0,0:22:14.49,0:22:18.04,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.12,0:22:21.50,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.59,0:22:24.88,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.96,0:22:28.88,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді күшейтемін.
Dialogue: 0,0:22:28.97,0:22:32.76,Default,,0,0,0,,GO ату GO ату Бей бұлшық еттерінің жаттықтырушысы Моримори
Dialogue: 0,0:22:32.85,0:22:36.43,Default,,0,0,0,,АЛДЫМ АТТЫ БАР АТТЫ Менің атысым – құдайдың атысы
Dialogue: 0,0:22:36.52,0:22:40.23,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.31,0:22:43.86,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:43.94,0:22:47.57,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.65,0:22:51.37,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.45,0:22:55.04,Default,,0,0,0,,Күнделікті барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:55.12,0:22:58.54,Default,,0,0,0,,Көктем/жаз/күз/қыс GO түсіру жыл бойы
Dialogue: 0,0:22:58.62,0:23:00.12,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.21,0:23:02.75,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.83,0:23:05.96,Default,,0,0,0,,Сол шиеленіспен шарықтау шегіне жетейік!
Dialogue: 0,0:23:06.05,0:23:09.76,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіріліміне кірісіңіз!
Dialogue: 0,0:23:09.84,0:23:13.26,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.35,0:23:17.06,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.14,0:23:20.02,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:20.02,0:23:22.02,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:20.02,0:23:22.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:22.10,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.10,0:23:25.11,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.10,0:23:25.11,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.11,0:23:25.57,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.78,0:23:29.11,Default,,0,0,0,,Келесі шайқас Куза Қызыл көзбен болады.
Dialogue: 0,0:23:29.19,0:23:32.45,Default,,0,0,0,,Мен Норманмын және Cisco тегін.
Dialogue: 0,0:23:32.53,0:23:34.03,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,0:23:34.45,0:23:37.37,Default,,0,0,0,,Strike God Chip бар дамып келе жатқан Валькирия
Dialogue: 0,0:23:37.49,0:23:40.71,Default,,0,0,0,,Мен сізге жаңа арнайы қозғалысты қалай орындау керектігін көрсетемін!
Dialogue: 0,0:23:41.21,0:23:43.33,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.50,0:23:46.29,Default,,0,0,0,,Супер эволюция! Құдай Валькириге шабуыл жасаңыз!
Dialogue: 0,0:23:46.67,0:23:50.09,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.59,0:23:57.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory