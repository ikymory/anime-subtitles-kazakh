Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.25,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.43,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.69,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.15,0:00:29.82,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:33.57,0:00:35.49,Default,,0,0,0,,Таос Фафнир
Dialogue: 0,0:00:36.28,0:00:37.66,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:37.91,0:00:39.78,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:40.24,0:00:41.83,Default,,0,0,0,,Еуропа лигасының бірінші матчы!
Dialogue: 0,0:00:41.91,0:00:44.25,Default,,0,0,0,,Менің атым Куза, мен ғажайып қуықпын...
Dialogue: 0,0:00:44.33,0:00:45.96,Default,,0,0,0,,Бесінші ойында соқтығысты
Dialogue: 0,0:00:46.04,0:00:48.38,Default,,0,0,0,,Куза қолданған Альтер Кронос күшті.
Dialogue: 0,0:00:48.54,0:00:50.75,Default,,0,0,0,,Бірақ менің Валькириім де жеңілмейді.
Dialogue: 0,0:00:51.09,0:00:53.21,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:00:53.30,0:00:55.84,Default,,0,0,0,,Кронос! Оны артқа аударыңыз!
Dialogue: 0,0:01:00.35,0:01:02.02,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:02.64,0:01:05.02,Default,,0,0,0,,Еуропа лигасы енді ғана басталды!
Dialogue: 0,0:01:05.31,0:01:07.48,Default,,0,0,0,,BC Sol! Барайық!
Dialogue: 0,0:01:08.35,0:01:12.32,Default,,0,0,0,,Менің сізге айтарым өте маңызды.
Dialogue: 0,0:01:13.74,0:01:15.24,Default,,0,0,0,,Мм! Аузың қызық болса да—
Dialogue: 0,0:01:23.41,0:01:26.16,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.25,0:01:28.67,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:28.75,0:01:31.13,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:31.21,0:01:33.67,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:33.76,0:01:35.97,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:36.05,0:01:37.80,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:37.88,0:01:42.14,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:43.06,0:01:47.81,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:47.89,0:01:52.44,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:52.90,0:01:57.65,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:57.74,0:02:02.66,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:02.74,0:02:07.62,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:07.71,0:02:12.67,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:12.75,0:02:16.05,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:16.13,0:02:17.67,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:17.76,0:02:20.30,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:20.39,0:02:22.51,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:22.60,0:02:24.64,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:24.72,0:02:26.10,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:26.18,0:02:27.85,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:27.93,0:02:30.10,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:30.19,0:02:36.36,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:36.44,0:02:40.82,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:40.91,0:02:43.70,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:43.78,0:02:46.12,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:46.20,0:02:48.71,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:48.79,0:02:52.29,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:48.79,0:02:52.29,Default,,0,0,0,,~♪
Dialogue: 0,0:02:52.29,0:02:52.96,Default,,0,0,0,,~♪
Dialogue: 0,0:02:54.54,0:02:56.30,Default,,0,0,0,,Барт және Фри
Dialogue: 0,0:03:00.05,0:03:03.09,Default,,0,0,0,,Бүгін барлығы жақсы күресті.
Dialogue: 0,0:03:03.51,0:03:05.76,Default,,0,0,0,,Еуропа лигасы енді ғана басталды
Dialogue: 0,0:03:05.85,0:03:08.68,Default,,0,0,0,,Бүгінгі жеңісті келесі кездесуге байланыстырайық
Dialogue: 0,0:03:08.81,0:03:10.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:10.19,0:03:13.27,Default,,0,0,0,,Біз ертең сағат 9-да жаттығу полигонында кездесеміз.
Dialogue: 0,0:03:13.44,0:03:14.65,Default,,0,0,0,,Олай болса тара!
Dialogue: 0,0:03:14.77,0:03:16.77,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:03:17.48,0:03:19.28,Default,,0,0,0,,Ұйықтар алдында ойын ойнайық
Dialogue: 0,0:03:19.36,0:03:20.07,Default,,0,0,0,,Иә
Dialogue: 0,0:03:20.15,0:03:21.82,Default,,0,0,0,,Аники: Мен де жақсымын, солай ма?
Dialogue: 0,0:03:21.91,0:03:22.57,Default,,0,0,0,,О!
Dialogue: 0,0:03:23.36,0:03:24.53,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:03:29.66,0:03:30.96,Default,,0,0,0,,Меншік иесі
Dialogue: 0,0:03:33.29,0:03:35.75,Default,,0,0,0,,Неліктен мені бұл командаға қостың?
Dialogue: 0,0:03:36.75,0:03:41.09,Default,,0,0,0,,Крис бұл топты жақсартуға болады деп шешті.
Dialogue: 0,0:03:41.42,0:03:44.34,Default,,0,0,0,,Олай болса, неге мені бүгінгі матчта қолданбайсың?
Dialogue: 0,0:03:44.84,0:03:46.39,Default,,0,0,0,,Мен сенбеймін!
Dialogue: 0,0:03:46.60,0:03:49.47,Default,,0,0,0,,Балто шығып, мен алмастырамын дейді!
Dialogue: 0,0:03:50.14,0:03:51.06,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:03:51.14,0:03:52.73,Default,,0,0,0,,Сіз таңқаларлық бала екенсіз.
Dialogue: 0,0:03:53.19,0:03:54.23,Default,,0,0,0,,Не болды, Польнарефф?
Dialogue: 0,0:03:54.77,0:03:58.73,Default,,0,0,0,,Сыйлықтың қатысушы blader болмауының нәтижесі екенін түсініңіз!
Dialogue: 0,0:04:00.78,0:04:02.20,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:02.74,0:04:05.78,Default,,0,0,0,,BC Сольдің қарсы шабуылы басталып та кетті.
Dialogue: 0,0:04:06.32,0:04:08.79,Default,,0,0,0,,Бүгінгі матч мені сендірді
Dialogue: 0,0:04:09.87,0:04:11.04,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:04:13.00,0:04:15.29,Default,,0,0,0,,Крис сені көп сатып жатыр.
Dialogue: 0,0:04:15.58,0:04:17.21,Default,,0,0,0,,Күтуді ақтау
Dialogue: 0,0:04:19.84,0:04:21.84,Default,,0,0,0,,Қарғыс атсын... олай етпе!
Dialogue: 0,0:04:29.76,0:04:30.93,Default,,0,0,0,,Тегін?
Dialogue: 0,0:04:53.33,0:04:54.71,Default,,0,0,0,,(Шөптің сыбдыры)
Dialogue: 0,0:05:11.93,0:05:14.77,Default,,0,0,0,,Неліктен мен оны жасыруым керек?
Dialogue: 0,0:05:19.15,0:05:20.57,Default,,0,0,0,,Не!
Dialogue: 0,0:05:24.19,0:05:25.70,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:05:32.33,0:05:34.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:36.71,0:05:38.21,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:39.04,0:05:40.21,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:05:41.63,0:05:42.80,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:05:51.14,0:05:54.64,Default,,0,0,0,,Уайымдама, іздеуді доғар. Сіз біліктен айырыласыз!
Dialogue: 0,0:05:54.72,0:05:56.18,Default,,0,0,0,,Не? Шынымен бе?
Dialogue: 0,0:05:56.52,0:05:58.69,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:58.77,0:06:01.61,Default,,0,0,0,,Мешин кезінде Валькириді алып тастау керек.
Dialogue: 0,0:06:02.40,0:06:04.32,Default,,0,0,0,,Себебі мен қызықпын.
Dialogue: 0,0:06:05.07,0:06:07.49,Default,,0,0,0,,Мен кеше жеңіске жеттім.
Dialogue: 0,0:06:07.86,0:06:10.78,Default,,0,0,0,,Валькири үшін қандай жекпе-жек стилі жақсы?
Dialogue: 0,0:06:10.87,0:06:12.66,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:06:13.03,0:06:15.16,Default,,0,0,0,,Жаттығу кезінде бұл туралы ойланыңыз
Dialogue: 0,0:06:15.24,0:06:17.87,Default,,0,0,0,,Ойланып қарасаң, бірден басыңнан айырылатын шығарсың.
Dialogue: 0,0:06:18.12,0:06:19.58,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:06:19.87,0:06:21.38,Default,,0,0,0,,Сіз тамақ ішіп жатырсыз ба?
Dialogue: 0,0:06:22.13,0:06:25.38,Default,,0,0,0,,Тамақ жеу, жеу Бұл жігіт тамақ ішпейді.
Dialogue: 0,0:06:25.46,0:06:27.01,Default,,0,0,0,,Мен тамақтанып жатырмын
Dialogue: 0,0:06:29.84,0:06:31.01,Default,,0,0,0,,Аники!
Dialogue: 0,0:06:31.18,0:06:33.01,Default,,0,0,0,,Сен қайда болдың, Кит?
Dialogue: 0,0:06:33.10,0:06:36.22,Default,,0,0,0,,Мынаны қараңыз! Бұл әлемдік рейтинг.
Dialogue: 0,0:06:36.43,0:06:38.85,Default,,0,0,0,,BC Сольдің рейтингі жоғарылады!
Dialogue: 0,0:06:39.02,0:06:40.10,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:06:40.19,0:06:42.73,Default,,0,0,0,,Жарайсыңдар! Жарайсың BC Sol!
Dialogue: 0,0:06:42.81,0:06:44.65,Default,,0,0,0,,Мұның бәрі кешегі ойынның арқасында!
Dialogue: 0,0:06:44.73,0:06:46.32,Default,,0,0,0,,Біз қолдан келгеннің бәрін жасадық!
Dialogue: 0,0:06:46.65,0:06:48.11,Default,,0,0,0,,Жинақ Келесі Келесі!
Dialogue: 0,0:06:48.19,0:06:49.32,Default,,0,0,0,,және бүгінге осы жетсін
Dialogue: 0,0:06:49.40,0:06:52.12,Default,,0,0,0,,Таңдану әлі ондай емес.
Dialogue: 0,0:06:52.57,0:06:53.45,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:06:53.53,0:06:54.53,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:54.62,0:06:56.04,Default,,0,0,0,,Жеке рейтинг!
Dialogue: 0,0:06:56.16,0:06:57.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:57.25,0:06:58.58,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:06:58.66,0:07:00.12,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:07:00.21,0:07:01.33,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:01.42,0:07:02.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:02.92,0:07:04.54,Default,,0,0,0,,Сіз өте бақыттысыз, солай емес пе?
Dialogue: 0,0:07:04.63,0:07:06.38,Default,,0,0,0,,Олардың жүздері қызық!
Dialogue: 0,0:07:06.75,0:07:09.84,Default,,0,0,0,,Кумичо Біз кереметпіз!
Dialogue: 0,0:07:10.13,0:07:13.80,Default,,0,0,0,,Ах! Ол әлемдік рейтингте!
Dialogue: 0,0:07:14.18,0:07:16.35,Default,,0,0,0,,Жарайсың, Валькири!
Dialogue: 0,0:07:16.43,0:07:18.31,Default,,0,0,0,,Құттықтаймыз Аники Кумичо
Dialogue: 0,0:07:18.39,0:07:19.35,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:07:19.64,0:07:20.98,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:07:21.06,0:07:22.85,Default,,0,0,0,,Жеке рейтингіңізді жақсартсаңыз
Dialogue: 0,0:07:22.94,0:07:25.86,Default,,0,0,0,,Дүниежүзілік лиганың жеке матчтарына қатыса аласыз.
Dialogue: 0,0:07:26.27,0:07:28.40,Default,,0,0,0,,О! Қанекей мынаны істейік!
Dialogue: 0,0:07:28.48,0:07:31.36,Default,,0,0,0,,Тоқта, дүние, біз кетеміз!
Dialogue: 0,0:07:31.45,0:07:36.08,Default,,0,0,0,,Сіз Джанго екеумізден әлдеқайда төмен болсаңыз да.
Dialogue: 0,0:07:36.16,0:07:40.25,Default,,0,0,0,,Стэн, неге Джанго туралы уайымдамайсың?
Dialogue: 0,0:07:40.33,0:07:42.79,Default,,0,0,0,,Сондай-ақ «суды жауып, науаға оралмау» ұқсастығы бар.
Dialogue: 0,0:07:42.87,0:07:43.75,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:44.25,0:07:47.00,Default,,0,0,0,,Ал, сіз бұл адамды танисыз ба?
Dialogue: 0,0:07:47.09,0:07:49.84,Default,,0,0,0,,Американың «Нью-Йорк Буллз» командасы.
Dialogue: 0,0:07:49.92,0:07:51.76,Default,,0,0,0,,Назар аударатын жапондықтар
Dialogue: 0,0:07:54.55,0:07:56.05,Default,,0,0,0,,Шу!
Dialogue: 0,0:07:56.14,0:07:57.51,Default,,0,0,0,,Мен ештеңе білмеймін
Dialogue: 0,0:07:58.14,0:08:00.81,Default,,0,0,0,,Ең күшті және ең жақсы дос!
Dialogue: 0,0:08:03.52,0:08:06.36,Default,,0,0,0,,Шу дүниеге барамын деп бастады.
Dialogue: 0,0:08:06.65,0:08:08.98,Default,,0,0,0,,Біз де бір орында тұруымыз керек.
Dialogue: 0,0:08:09.36,0:08:10.32,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:08:10.65,0:08:13.40,Default,,0,0,0,,Сонымен Аники мен Кумичо қарсылас.
Dialogue: 0,0:08:13.49,0:08:14.36,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:14.74,0:08:17.07,Default,,0,0,0,,Айтпақшы, мен сізге өткен күні электрондық хат жібердім.
Dialogue: 0,0:08:17.16,0:08:19.74,Default,,0,0,0,,Сіз мүлдем жауап бермедіңіз. Сен ше?
Dialogue: 0,0:08:20.12,0:08:22.04,Default,,0,0,0,,Мен де...
Dialogue: 0,0:08:22.29,0:08:23.58,Default,,0,0,0,,Бұл Ренраку емес пе?
Dialogue: 0,0:08:23.66,0:08:24.29,Default,,0,0,0,,О
Dialogue: 0,0:08:24.37,0:08:27.54,Default,,0,0,0,,Мен сенің қатты тырысып жатқаныңды білемін.
Dialogue: 0,0:08:28.42,0:08:31.30,Default,,0,0,0,,Мен оның қазір кім екенін осылай білдім...
Dialogue: 0,0:08:31.38,0:08:33.13,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:08:34.05,0:08:35.51,Default,,0,0,0,,Уау, керемет!
Dialogue: 0,0:08:35.64,0:08:37.60,Default,,0,0,0,,Иә, оның аурасы бар.
Dialogue: 0,0:08:37.89,0:08:41.14,Default,,0,0,0,,Жапонияда оны төрт бұралғыштардың патшаларының бірі дейді.
Dialogue: 0,0:08:41.27,0:08:42.68,Default,,0,0,0,,Төрттік патша?
Dialogue: 0,0:08:42.77,0:08:46.56,Default,,0,0,0,,О, сен сондай күшті екенсің. Төртеуіңді осылай атасам...
Dialogue: 0,0:08:46.65,0:08:50.27,Default,,0,0,0,,Барлығы оларды жеңу мақсатымен аянбай еңбек етті.
Dialogue: 0,0:08:50.36,0:08:51.69,Default,,0,0,0,,Эй
Dialogue: 0,0:08:52.24,0:08:54.99,Default,,0,0,0,,Шумен шайқас
Dialogue: 0,0:08:55.20,0:08:58.49,Default,,0,0,0,,Эй Аники, қалған төрт айналым патшалары қалай?
Dialogue: 0,0:08:58.57,0:09:00.58,Default,,0,0,0,,Барлығыңыз әлемге назар аударасыз ба?
Dialogue: 0,0:09:00.66,0:09:03.08,Default,,0,0,0,,Мүмкін солай шығар! Маған аздап қарыз беріңізші
Dialogue: 0,0:09:03.25,0:09:06.00,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:09:06.08,0:09:07.67,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:09:07.75,0:09:09.42,Default,,0,0,0,,Шынымды айтсам, бұл Шака!
Dialogue: 0,0:09:09.67,0:09:10.75,Default,,0,0,0,,Шака?
Dialogue: 0,0:09:10.84,0:09:12.42,Default,,0,0,0,,Бұл Қайза жанып тұрған храм.
Dialogue: 0,0:09:12.76,0:09:15.51,Default,,0,0,0,,Ол Оңтүстік Америка лигасына барды ма?
Dialogue: 0,0:09:15.68,0:09:17.47,Default,,0,0,0,,Қызық болып барады!
Dialogue: 0,0:09:17.76,0:09:18.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:18.84,0:09:21.76,Default,,0,0,0,,Жапонияда бізбен соғысқан жігіттер
Dialogue: 0,0:09:21.85,0:09:23.35,Default,,0,0,0,,Дүниеде ашуланған
Dialogue: 0,0:09:23.68,0:09:25.64,Default,,0,0,0,,Мен жеңіле алмаймын, Кумичо.
Dialogue: 0,0:09:26.23,0:09:30.57,Default,,0,0,0,,Шу мен Шақаны жеңіп, шыңға шығайық.
Dialogue: 0,0:09:30.65,0:09:31.48,Default,,0,0,0,,О!
Dialogue: 0,0:09:35.11,0:09:35.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:37.78,0:09:39.41,Default,,0,0,0,,Тегін!
Dialogue: 0,0:09:40.99,0:09:41.87,Default,,0,0,0,,Не?
Dialogue: 0,0:09:42.12,0:09:43.79,Default,,0,0,0,,Кешегі күн үшін рахмет!
Dialogue: 0,0:09:44.29,0:09:45.41,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:45.75,0:09:48.92,Default,,0,0,0,,Сен маған сеніп, соңғы ойынды ойнадың.
Dialogue: 0,0:09:49.63,0:09:51.13,Default,,0,0,0,,Жеңіске жету қызық болды ма?
Dialogue: 0,0:09:51.59,0:09:53.88,Default,,0,0,0,,О, өте қызық!
Dialogue: 0,0:09:54.51,0:09:56.80,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:09:58.88,0:09:59.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:01.51,0:10:03.72,Default,,0,0,0,,Ол жаттығу жасамайды ма?
Dialogue: 0,0:10:04.10,0:10:08.10,Default,,0,0,0,,Бұл мен... Мен барған сайын тегін нәрселерді ұната бастадым!
Dialogue: 0,0:10:08.19,0:10:10.77,Default,,0,0,0,,Бұл кенеттен жиіркенішті!
Dialogue: 0,0:10:11.06,0:10:14.19,Default,,0,0,0,,Ол рейтингте бірінші орында, солай ма?
Dialogue: 0,0:10:14.40,0:10:16.36,Default,,0,0,0,,Мен сені қуып жетемін
Dialogue: 0,0:10:17.57,0:10:21.20,Default,,0,0,0,,Топ Вантпен шайқас үлкен әсер етті.
Dialogue: 0,0:10:21.53,0:10:25.62,Default,,0,0,0,,Иә, Стэн мен басқалары да жігерленеді деп үміттенемін.
Dialogue: 0,0:10:26.25,0:10:30.00,Default,,0,0,0,,Жүзіңіз мұңды. Бірдеңе болды ма?
Dialogue: 0,0:10:30.50,0:10:31.83,Default,,0,0,0,,Гилтен
Dialogue: 0,0:10:31.92,0:10:33.63,Default,,0,0,0,,Әй, Америка...
Dialogue: 0,0:10:34.17,0:10:36.30,Default,,0,0,0,,Мен бос мәнді қайтадан көтердім.
Dialogue: 0,0:10:36.63,0:10:37.72,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:40.76,0:10:41.72,Default,,0,0,0,,Тегін?
Dialogue: 0,0:10:43.18,0:10:45.22,Default,,0,0,0,,Менің бір оқиғам бар.
Dialogue: 0,0:10:45.89,0:10:47.48,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:49.60,0:10:51.40,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:58.53,0:11:00.95,Default,,0,0,0,,Ах! Cisco!
Dialogue: 0,0:11:02.07,0:11:04.08,Default,,0,0,0,,Жаттығу Бірге орындаймыз!
Dialogue: 0,0:11:04.37,0:11:06.08,Default,,0,0,0,,Мұны Хуаншаньмен жасаған жақсы болар еді.
Dialogue: 0,0:11:06.41,0:11:08.83,Default,,0,0,0,,Кумичо дегеніміз не? Өйткені мен мұны үнемі жасаймын.
Dialogue: 0,0:11:08.91,0:11:10.62,Default,,0,0,0,,Егер сіз күшті жүзікпен күрессеңіз
Dialogue: 0,0:11:10.71,0:11:13.71,Default,,0,0,0,,Менің ойымша, Валькиридің бақылауы жақсарады...
Dialogue: 0,0:11:13.79,0:11:15.25,Default,,0,0,0,,Қалағаныңды істе! !
Dialogue: 0,0:11:15.63,0:11:16.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:20.01,0:11:23.47,Default,,0,0,0,,Мен мұнда сені күшті ету үшін келген жоқпын.
Dialogue: 0,0:11:24.14,0:11:25.72,Default,,0,0,0,,Жаттығуды қаласаңыз, жалғыз жасаңыз!
Dialogue: 0,0:11:26.85,0:11:28.43,Default,,0,0,0,,соғұрлым олардың күші мен жылдамдығы артады
Dialogue: 0,0:11:31.23,0:11:32.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:33.65,0:11:36.44,Default,,0,0,0,,Кеса үшін бәрі қобалжыды.
Dialogue: 0,0:11:37.02,0:11:37.98,Default,,0,0,0,,Кеса?
Dialogue: 0,0:11:38.19,0:11:39.61,Default,,0,0,0,,Жеке рейтинг
Dialogue: 0,0:11:39.78,0:11:40.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:41.28,0:11:42.66,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:11:42.74,0:11:45.53,Default,,0,0,0,,Кеше дейін әрекет ету аймағынан тыс болған белгісіз жапондық...
Dialogue: 0,0:11:45.62,0:11:49.41,Default,,0,0,0,,Кенеттен екі адам шықты. Мен тыныш отыра алмаймын.
Dialogue: 0,0:11:51.29,0:11:53.33,Default,,0,0,0,,Түсіндім, мен де таң қалдым.
Dialogue: 0,0:11:53.42,0:11:54.88,Default,,0,0,0,,Тәжірибе үшін-
Dialogue: 0,0:11:55.42,0:11:57.59,Default,,0,0,0,,Бірге шықсақ болады ма?
Dialogue: 0,0:11:58.05,0:11:59.34,Default,,0,0,0,,Шынымен бе? Стэн!
Dialogue: 0,0:12:00.55,0:12:02.30,Default,,0,0,0,,Рейтинг бойынша Балто
Dialogue: 0,0:12:02.68,0:12:05.76,Default,,0,0,0,,Сіз менің арқамнан бекітіліп қойғансыз.
Dialogue: 0,0:12:06.39,0:12:10.39,Default,,0,0,0,,Егер біз сені жеңбесек, жоғары топты қорғай алмаймыз.
Dialogue: 0,0:12:10.47,0:12:11.43,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:12:12.23,0:12:13.89,Default,,0,0,0,,Балалар, сендер де солай істеулерің керек!
Dialogue: 0,0:12:14.10,0:12:15.15,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:15.44,0:12:16.98,Default,,0,0,0,,«Шығып тұрған қазық құлатылады».
Dialogue: 0,0:12:17.19,0:12:18.23,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:18.86,0:12:19.98,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:12:20.07,0:12:23.32,Default,,0,0,0,,Мен сені тоқтатпаймын. Осындай кездерде...
Dialogue: 0,0:12:23.40,0:12:26.49,Default,,0,0,0,,Бетпе-бет соқтығысқан дұрыс!
Dialogue: 0,0:12:26.57,0:12:27.87,Default,,0,0,0,,Шаса да солай жасайды, солай ма?
Dialogue: 0,0:12:28.37,0:12:29.70,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:12:32.37,0:12:34.04,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:12:34.62,0:12:37.00,Default,,0,0,0,,Рантаро қыдырып жүр!
Dialogue: 0,0:12:37.33,0:12:40.88,Default,,0,0,0,,Барто Аои мен Рантаро Кияма рейтингке кіргеннен кейін...
Dialogue: 0,0:12:41.21,0:12:44.76,Default,,0,0,0,,Блейдерлердің ойы анық өзгерді.
Dialogue: 0,0:12:44.84,0:12:47.34,Default,,0,0,0,,Жанданған команда болғаны жақсы.
Dialogue: 0,0:12:48.10,0:12:50.35,Default,,0,0,0,,Бірақ тегін...
Dialogue: 0,0:12:58.65,0:12:59.65,Default,,0,0,0,,Шық!
Dialogue: 0,0:13:03.78,0:13:05.40,Default,,0,0,0,,Менен бірдеңе керек пе?
Dialogue: 0,0:13:05.99,0:13:06.91,Default,,0,0,0,,Бөлек
Dialogue: 0,0:13:07.49,0:13:09.62,Default,,0,0,0,,Сіз кеше және алдыңғы күні болдыңыз.
Dialogue: 0,0:13:10.87,0:13:12.83,Default,,0,0,0,,Сіз адамсыз ба?
Dialogue: 0,0:13:14.04,0:13:17.33,Default,,0,0,0,,Адам болмасаң қандай болар едің?
Dialogue: 0,0:13:17.71,0:13:21.42,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:13:23.55,0:13:26.05,Default,,0,0,0,,Бүгінгі таңда жануарлар жоқ.
Dialogue: 0,0:13:26.55,0:13:28.14,Default,,0,0,0,,Өйткені менде сен бар
Dialogue: 0,0:13:28.80,0:13:30.89,Default,,0,0,0,,А, керек болса, сол жерде болды.
Dialogue: 0,0:13:32.60,0:13:33.97,Default,,0,0,0,,Менімен жарысыңыз
Dialogue: 0,0:13:36.23,0:13:37.94,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:13:38.77,0:13:39.73,Default,,0,0,0,,Кук
Dialogue: 0,0:13:40.11,0:13:42.44,Default,,0,0,0,,Мен үшін ең тітіркендіретін нәрсе жеңілу!
Dialogue: 0,0:13:42.78,0:13:44.99,Default,,0,0,0,,Сенен әлі жеңілгенім ренжіді!
Dialogue: 0,0:13:45.57,0:13:48.36,Default,,0,0,0,,Мен мұны да жек көрмеймін.
Dialogue: 0,0:13:48.78,0:13:50.95,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:14:07.26,0:14:08.47,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:11.39,0:14:12.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:18.31,0:14:19.90,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:20.23,0:14:23.36,Default,,0,0,0,,Та... Бұл өте қиын!
Dialogue: 0,0:14:23.44,0:14:24.73,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:25.07,0:14:25.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:26.40,0:14:30.57,Default,,0,0,0,,Тапсырыс беруші жаңа ғана иесінің орнына келді...
Dialogue: 0,0:14:30.66,0:14:32.28,Default,,0,0,0,,Хахаха
Dialogue: 0,0:14:32.37,0:14:33.41,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:33.49,0:14:35.12,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:14:35.20,0:14:36.91,Default,,0,0,0,,Сізді не бақытты етеді?
Dialogue: 0,0:14:38.25,0:14:40.33,Default,,0,0,0,,Не болды? Жаттығуды жалғастырыңыз.
Dialogue: 0,0:14:40.92,0:14:42.79,Default,,0,0,0,,Мен оны көрдім!
Dialogue: 0,0:14:44.55,0:14:46.92,Default,,0,0,0,,Сіздің айтқаныңыз дұрыс па?
Dialogue: 0,0:14:47.21,0:14:49.01,Default,,0,0,0,,Иван Сіз нені айтып тұрсыз?
Dialogue: 0,0:14:49.59,0:14:51.97,Default,,0,0,0,,Free Америкаға көшіп барады.
Dialogue: 0,0:14:52.09,0:14:52.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.01,0:14:53.85,Default,,0,0,0,,Эх!
Dialogue: 0,0:14:53.97,0:14:54.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:55.14,0:14:57.22,Default,,0,0,0,,Сіздің жұмысыңыздың шегі бар.
Dialogue: 0,0:14:58.06,0:14:59.39,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:15:00.06,0:15:01.19,Default,,0,0,0,,Иванның көргені...
Dialogue: 0,0:15:02.06,0:15:05.57,Default,,0,0,0,,Мен келісім-шартқа қол қоюға келген хабаршымын.
Dialogue: 0,0:15:05.69,0:15:08.40,Default,,0,0,0,,Жоқ, жоқ, бұл мүмкін емес.
Dialogue: 0,0:15:08.65,0:15:11.86,Default,,0,0,0,,Фридің Б.С.Солға деген сүйіспеншілігі басқалардан күштірек.
Dialogue: 0,0:15:11.99,0:15:13.99,Default,,0,0,0,,Мұны бәрі біледі.
Dialogue: 0,0:15:14.83,0:15:17.70,Default,,0,0,0,,Сіз сенбейсіз, бірақ бұл шындық.
Dialogue: 0,0:15:17.79,0:15:20.75,Default,,0,0,0,,Тегін Де Ла Хойя Нью-Йорк Буллзға ауыстырылды.
Dialogue: 0,0:15:21.46,0:15:22.25,Default,,0,0,0,,Бұқалар?
Dialogue: 0,0:15:24.13,0:15:27.84,Default,,0,0,0,,Ей, Бұқалар Шудың командасы ғой, солай емес пе?
Dialogue: 0,0:15:28.01,0:15:29.42,Default,,0,0,0,,Мен сенбеймін!
Dialogue: 0,0:15:31.88,0:15:34.14,Default,,0,0,0,,Оның арқасында Уакияны жеңдім.
Dialogue: 0,0:15:34.55,0:15:36.47,Default,,0,0,0,,Ол маған кадр туралы айтып берді.
Dialogue: 0,0:15:36.81,0:15:40.35,Default,,0,0,0,,Мен Топ Вантпен жұдырықтассам да, ол маған кезегімді берді!
Dialogue: 0,0:15:40.52,0:15:43.77,Default,,0,0,0,,Ол үнемі ұжымды ойлайтын!
Dialogue: 0,0:15:44.27,0:15:45.65,Default,,0,0,0,,Балто!
Dialogue: 0,0:15:49.07,0:15:50.19,Default,,0,0,0,,Бұл Декү.
Dialogue: 0,0:15:50.95,0:15:52.36,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:15:53.07,0:15:54.41,Default,,0,0,0,,Бұл тегін.
Dialogue: 0,0:15:56.45,0:15:58.12,Default,,0,0,0,,Мен сенің Америкаға барасың деп естідім.
Dialogue: 0,0:15:58.87,0:15:59.79,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:16:00.00,0:16:02.79,Default,,0,0,0,,Неліктен? BC Sol-пен не істеуім керек?
Dialogue: 0,0:16:03.08,0:16:05.54,Default,,0,0,0,,Оған BC Sol ұнайды, солай ма?
Dialogue: 0,0:16:06.21,0:16:09.05,Default,,0,0,0,,Бірақ бұл Фридің өзі шешім қабылдады.
Dialogue: 0,0:16:09.30,0:16:10.80,Default,,0,0,0,,Неге оны тоқтатпадың?
Dialogue: 0,0:16:11.30,0:16:15.05,Default,,0,0,0,,Қажет емес, мен оны жақсы білемін.
Dialogue: 0,0:16:16.26,0:16:17.30,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:16:17.39,0:16:19.31,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:16:21.10,0:16:22.60,Default,,0,0,0,,Сіз тегін кездескіңіз келе ме?
Dialogue: 0,0:16:27.40,0:16:29.40,Default,,0,0,0,,Сол жігіт… Көзіне латкі таққан Какужа ма?
Dialogue: 0,0:16:31.69,0:16:32.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:37.24,0:16:38.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:04.64,0:17:05.44,Default,,0,0,0,,Тегін!
Dialogue: 0,0:17:07.44,0:17:08.31,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:08.65,0:17:10.11,Default,,0,0,0,,Америкаға барма!
Dialogue: 0,0:17:12.11,0:17:14.86,Default,,0,0,0,,Тегін Сізге BC Sol ұнайды, солай ма?
Dialogue: 0,0:17:15.20,0:17:16.99,Default,,0,0,0,,Мен ауыстыру себебін түсінбеймін.
Dialogue: 0,0:17:17.16,0:17:18.82,Default,,0,0,0,,Тасымалдау – бұл аудару.
Dialogue: 0,0:17:18.91,0:17:21.70,Default,,0,0,0,,Б.С.Солды жек көріп кеттіңіз бе?
Dialogue: 0,0:17:22.08,0:17:23.66,Default,,0,0,0,,Жоқ, мен оны жақсы көремін.
Dialogue: 0,0:17:24.58,0:17:26.37,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:17:26.79,0:17:28.88,Default,,0,0,0,,Олай болса неге аудару керек?
Dialogue: 0,0:17:29.46,0:17:31.71,Default,,0,0,0,,Маған бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:17:32.30,0:17:35.01,Default,,0,0,0,,Неліктен? Біз дос емеспіз бе?
Dialogue: 0,0:17:35.34,0:17:37.13,Default,,0,0,0,,Бұл қызық екен, сен.
Dialogue: 0,0:17:37.72,0:17:40.51,Default,,0,0,0,,Жоқ! Бұл ойын, ол тегін!
Dialogue: 0,0:17:42.89,0:17:44.31,Default,,0,0,0,,Барлығы осылай дейді.
Dialogue: 0,0:17:45.56,0:17:46.98,Default,,0,0,0,,Неліктен ұрыс?
Dialogue: 0,0:17:47.06,0:17:48.27,Default,,0,0,0,,Анықталған
Dialogue: 0,0:17:48.35,0:17:50.69,Default,,0,0,0,,Егер мен сені жеңсем, командада қал.
Dialogue: 0,0:17:51.19,0:17:53.73,Default,,0,0,0,,Барлығы сенің кетуіңе қарсы.
Dialogue: 0,0:17:53.98,0:17:56.86,Default,,0,0,0,,Тіпті Кристің өзі сені қалайды!
Dialogue: 0,0:17:57.24,0:17:59.53,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,0:17:59.74,0:18:01.66,Default,,0,0,0,,Өйткені біз бір командамыз!
Dialogue: 0,0:18:04.79,0:18:06.79,Default,,0,0,0,,Күте тұрыңыз, тегін ойын дегеніміз не?
Dialogue: 0,0:18:07.62,0:18:09.33,Default,,0,0,0,,Мен бұл жерде істей алмаймын.
Dialogue: 0,0:18:21.76,0:18:23.39,Default,,0,0,0,,Сіз осында жаттығасыз ба?
Dialogue: 0,0:18:23.64,0:18:26.06,Default,,0,0,0,,Сіз тек бір рет ұтасыз
Dialogue: 0,0:18:26.68,0:18:29.60,Default,,0,0,0,,Біреуіміз ұпай алсақ, бітті.
Dialogue: 0,0:18:29.94,0:18:31.11,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:18:35.98,0:18:37.53,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:18:38.28,0:18:40.99,Default,,0,0,0,,(Қорқытатын монтаж дыбысы)
Dialogue: 0,0:18:42.87,0:18:44.41,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:44.66,0:18:46.04,Default,,0,0,0,,Жасайық
Dialogue: 0,0:18:46.25,0:18:48.71,Default,,0,0,0,,О... ой! Барайық!
Dialogue: 0,0:18:50.04,0:18:52.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:53.04,0:18:55.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:59.47,0:19:01.80,Default,,0,0,0,,(Үдемелі айналу дыбысы)
Dialogue: 0,0:19:01.89,0:19:03.97,Default,,0,0,0,,(Тыныш қону дыбысы)
Dialogue: 0,0:19:07.18,0:19:09.27,Default,,0,0,0,,Бұл тегін түсірілім!
Dialogue: 0,0:19:14.73,0:19:16.65,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:19:20.28,0:19:21.45,Default,,0,0,0,,Бұл жұмыс істемейтін сияқты.
Dialogue: 0,0:19:23.41,0:19:25.37,Default,,0,0,0,,Бұл байланыстырылған шабуыл. Соқ!
Dialogue: 0,0:19:25.78,0:19:27.12,Default,,0,0,0,,Мен мұның не екенін білмеймін.
Dialogue: 0,0:19:31.50,0:19:33.17,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:35.25,0:19:36.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:40.38,0:19:41.80,Default,,0,0,0,,Ұтыс ойыны дегеніміз не?
Dialogue: 0,0:19:43.64,0:19:45.43,Default,,0,0,0,,Бұл әлі де жасай алатыныңызды білдіреді.
Dialogue: 0,0:19:45.72,0:19:48.93,Default,,0,0,0,,Мен әрқашан толық қуатпен тегін түсірілім жасағым келді!
Dialogue: 0,0:19:50.68,0:19:52.19,Default,,0,0,0,,Келесі орындаймыз ба?
Dialogue: 0,0:19:52.48,0:19:54.10,Default,,0,0,0,,Жарайды онда...
Dialogue: 0,0:19:54.31,0:19:56.65,Default,,0,0,0,,Жылдамдық – төзімділіктің кілті
Dialogue: 0,0:19:57.52,0:19:59.07,Default,,0,0,0,,Сізге ұқсайды ма?
Dialogue: 0,0:19:59.57,0:20:00.69,Default,,0,0,0,,Бұл жолы!
Dialogue: 0,0:20:02.36,0:20:05.28,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:20:05.70,0:20:07.74,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:20.46,0:20:21.59,Default,,0,0,0,,Бар, жүр!
Dialogue: 0,0:20:22.72,0:20:24.30,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:20:27.51,0:20:29.22,Default,,0,0,0,,Байланысты реактивті ату
Dialogue: 0,0:20:29.31,0:20:31.10,Default,,0,0,0,,Сен мені бұл жолы өлтіресің, Валькири
Dialogue: 0,0:20:33.98,0:20:36.36,Default,,0,0,0,,Жақсы! Бар! Бар! Бар!
Dialogue: 0,0:20:44.15,0:20:44.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:47.82,0:20:49.83,Default,,0,0,0,,Берілме, Валькири!
Dialogue: 0,0:20:50.58,0:20:53.04,Default,,0,0,0,,Барто Аои.
Dialogue: 0,0:20:53.12,0:20:55.54,Default,,0,0,0,,(көтерілген жалын дыбысы)
Dialogue: 0,0:20:57.54,0:20:59.71,Default,,0,0,0,,(үру)
Dialogue: 0,0:21:05.76,0:21:07.43,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:21:11.27,0:21:13.48,Default,,0,0,0,,Ку…ку…
Dialogue: 0,0:21:20.65,0:21:22.44,Default,,0,0,0,,Бір ғана сәйкестік бар
Dialogue: 0,0:21:22.61,0:21:23.90,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:21:25.15,0:21:25.86,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:21:36.33,0:21:37.17,Default,,0,0,0,,Әй
Dialogue: 0,0:21:40.38,0:21:43.13,Default,,0,0,0,,Сіз оны осында пайдалана аласыз.
Dialogue: 0,0:21:43.21,0:21:44.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:55.89,0:21:58.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.52,0:22:01.90,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.98,0:22:04.74,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.82,0:22:07.03,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.11,0:22:10.66,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.74,0:22:14.29,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.37,0:22:16.16,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.25,0:22:18.08,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.17,0:22:19.83,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.92,0:22:21.54,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.63,0:22:23.55,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.63,0:22:26.09,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.17,0:22:29.09,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.18,0:22:32.80,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.89,0:22:36.56,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.64,0:22:38.27,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.35,0:22:41.61,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.69,0:22:43.98,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.07,0:22:47.57,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.65,0:22:50.99,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.07,0:22:53.16,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.24,0:22:55.04,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.12,0:22:58.50,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.58,0:23:00.54,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.62,0:23:03.59,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.67,0:23:05.88,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.96,0:23:09.93,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:10.01,0:23:13.55,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.64,0:23:17.10,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.18,0:23:20.44,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.52,0:23:22.65,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:20.52,0:23:22.65,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.65,0:23:22.73,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.73,0:23:25.11,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.73,0:23:25.11,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.11,0:23:25.57,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.61,0:23:29.07,Default,,0,0,0,,BC Соль тозған күйге түсті.
Dialogue: 0,0:23:29.49,0:23:32.07,Default,,0,0,0,,Мен бірдеңе істеуім керек деп ойлаймын, бірақ ол жұмыс істемейтін сияқты.
Dialogue: 0,0:23:32.74,0:23:35.62,Default,,0,0,0,,Бізсіз тегін, біз ештеңе істей алмаймыз ба?
Dialogue: 0,0:23:35.87,0:23:38.79,Default,,0,0,0,,Сәлем, Cisco Иван.
Dialogue: 0,0:23:38.87,0:23:40.04,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:23:40.29,0:23:42.96,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.04,0:23:45.38,Default,,0,0,0,,Жығылу! BC Sol!
Dialogue: 0,0:23:45.59,0:23:49.55,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.05,0:23:57.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory