Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.25,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.31,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.10,0:00:29.65,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:36.57,0:00:38.49,Default,,0,0,0,,Бітті.
Dialogue: 0,0:00:38.58,0:00:41.62,Default,,0,0,0,,BC Sol және Real Sambat арасындағы жолдастық кездесу
Dialogue: 0,0:00:41.87,0:00:44.04,Default,,0,0,0,,Мен тегін Катсуякуды қуып жеттім!
Dialogue: 0,0:00:45.62,0:00:47.46,Default,,0,0,0,,Келесі ойын оны шешеді!
Dialogue: 0,0:00:47.54,0:00:51.25,Default,,0,0,0,,Бірақ Фриланс Кумичоны ұсынды және оған күлкілі шарттарды қойды.
Dialogue: 0,0:00:51.34,0:00:52.46,Default,,0,0,0,,Сіз
Dialogue: 0,0:00:52.55,0:00:53.51,Default,,0,0,0,,Мен?
Dialogue: 0,0:00:53.63,0:00:56.05,Default,,0,0,0,,Сен ол жігіттен бұрын жеңіліп қалдың ғой, солай ма?
Dialogue: 0,0:00:58.01,0:01:01.77,Default,,0,0,0,,Мен ол жігіттен тағы жеңілсем, БК Сол шығады.
Dialogue: 0,0:01:02.77,0:01:07.27,Default,,0,0,0,,Еркін Мен айтып отырған сөз осы шығар деп ойладым, сен екеуміздің арамыздағы жарыс.
Dialogue: 0,0:01:09.44,0:01:11.15,Default,,0,0,0,,Кеттік, Балто.
Dialogue: 0,0:01:15.99,0:01:17.57,Default,,0,0,0,,Кумичо, жең!
Dialogue: 0,0:01:18.41,0:01:21.08,Default,,0,0,0,,♪~
Dialogue: 0,0:01:21.16,0:01:23.70,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:23.79,0:01:26.25,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:26.33,0:01:28.75,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:28.83,0:01:31.17,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:31.25,0:01:32.75,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:32.84,0:01:37.09,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:38.05,0:01:42.81,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:42.89,0:01:47.39,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:47.89,0:01:52.65,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:52.73,0:01:57.65,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:01:57.74,0:02:02.62,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:02.70,0:02:07.66,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:07.75,0:02:11.04,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:11.13,0:02:12.63,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:12.71,0:02:15.30,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:15.38,0:02:17.59,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:17.67,0:02:19.93,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:20.01,0:02:21.18,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:21.26,0:02:22.85,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:22.93,0:02:25.27,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:25.35,0:02:31.44,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:31.52,0:02:36.11,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:36.19,0:02:38.65,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:38.74,0:02:41.24,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:41.32,0:02:43.62,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:43.70,0:02:45.74,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:45.74,0:02:47.75,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:45.74,0:02:47.75,Default,,0,0,0,,~♪
Dialogue: 0,0:02:49.33,0:02:51.71,Default,,0,0,0,,Қатты жер сілкінісі! BC Sol!
Dialogue: 0,0:02:54.38,0:02:56.09,Default,,0,0,0,,Вакия! Тез дайындал!
Dialogue: 0,0:02:56.17,0:02:58.42,Default,,0,0,0,,Біраз уақыт қалды.
Dialogue: 0,0:02:58.76,0:03:01.51,Default,,0,0,0,,Эй, сен менімен жарысқалы тұрсың ба?
Dialogue: 0,0:03:01.72,0:03:03.09,Default,,0,0,0,,Идиот
Dialogue: 0,0:03:03.18,0:03:05.39,Default,,0,0,0,,Неге сонша қорқасың?
Dialogue: 0,0:03:05.47,0:03:06.56,Default,,0,0,0,,Кері немесе кері!
Dialogue: 0,0:03:06.64,0:03:07.52,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:07.81,0:03:09.77,Default,,0,0,0,,Эй, Еркін, шықшы.
Dialogue: 0,0:03:10.14,0:03:13.19,Default,,0,0,0,,Мен сендермен жарысуға келдім.
Dialogue: 0,0:03:13.27,0:03:16.19,Default,,0,0,0,,Шығып, Хуанзанды ауыстырыңыз!
Dialogue: 0,0:03:16.40,0:03:20.57,Default,,0,0,0,,Ой, бұл ойнаудан бас тарту!
Dialogue: 0,0:03:20.65,0:03:23.57,Default,,0,0,0,,Ал BC Sol орындығында Еркінге қарай.
Dialogue: 0,0:03:23.66,0:03:25.95,Default,,0,0,0,,Ол сенен онымен соғысуыңды талап етеді!
Dialogue: 0,0:03:26.33,0:03:28.87,Default,,0,0,0,,Иесі қанша болса да, тым өзімшіл.
Dialogue: 0,0:03:28.95,0:03:30.54,Default,,0,0,0,,Бұл қалыпты емес.
Dialogue: 0,0:03:30.62,0:03:32.58,Default,,0,0,0,,Бұл оның әдеттегі тәртібі, солай ма?
Dialogue: 0,0:03:32.67,0:03:34.38,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:03:34.46,0:03:37.59,Default,,0,0,0,,Менің ойымша, сіз мұны ресми матчта жеңіске жеткенге дейін жасағыңыз келеді.
Dialogue: 0,0:03:37.67,0:03:39.76,Default,,0,0,0,,«Құлап кетпес үшін таяқ»?
Dialogue: 0,0:03:39.84,0:03:42.34,Default,,0,0,0,,Сіз БК Сольді қорлайсыз ба?
Dialogue: 0,0:03:42.43,0:03:45.76,Default,,0,0,0,,Ақымақ болма! Мен сенің қарсыласыңмын!
Dialogue: 0,0:03:45.85,0:03:48.06,Default,,0,0,0,,Саған ертерек жеңілгенім рас.
Dialogue: 0,0:03:48.14,0:03:50.35,Default,,0,0,0,,Бірақ бұл жолы мен міндетті түрде жеңемін!
Dialogue: 0,0:03:51.10,0:03:53.77,Default,,0,0,0,,Мен енді сенен жеңілгім келмейді.
Dialogue: 0,0:03:53.90,0:03:55.02,Default,,0,0,0,,Сатып алуға алданған адам – нағыз ақымақ
Dialogue: 0,0:03:55.73,0:03:58.86,Default,,0,0,0,,Жеңетініңді білетін жекпе-жек қызық емес.
Dialogue: 0,0:04:01.15,0:04:03.91,Default,,0,0,0,,Мен ең күшті Еркінге қарсы күрескім келеді.
Dialogue: 0,0:04:03.99,0:04:06.70,Default,,0,0,0,,Вакия дәл қазір жеңіліп қалған жоқ па?
Dialogue: 0,0:04:06.95,0:04:07.91,Default,,0,0,0,,Мен үшін!
Dialogue: 0,0:04:08.41,0:04:10.58,Default,,0,0,0,,Келесі жолы тырысамын, мен міндетті түрде жеңемін!
Dialogue: 0,0:04:10.66,0:04:13.21,Default,,0,0,0,,Кумичо да солай сезінеді.
Dialogue: 0,0:04:13.29,0:04:15.33,Default,,0,0,0,,О, мен міндетті түрде жеңемін!
Dialogue: 0,0:04:17.17,0:04:20.38,Default,,0,0,0,,Оның үстіне мен де еркін күрескім келеді!
Dialogue: 0,0:04:20.46,0:04:21.42,Default,,0,0,0,,Иә! сурет?
Dialogue: 0,0:04:21.84,0:04:24.68,Default,,0,0,0,,Не, сен бір командадасың ба?
Dialogue: 0,0:04:25.05,0:04:27.80,Default,,0,0,0,,Оның менің күресуге деген ынтасыма еш қатысы жоқ.
Dialogue: 0,0:04:28.68,0:04:31.60,Default,,0,0,0,,Тегін! Мен сенімен ұрысамын
Dialogue: 0,0:04:31.89,0:04:32.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.23,0:04:36.19,Default,,0,0,0,,Ой, ол қайтадан бұзылды!
Dialogue: 0,0:04:36.27,0:04:40.32,Default,,0,0,0,,Бір қызығы, Барто Аои да тегін шақыру жасады.
Dialogue: 0,0:04:40.40,0:04:43.15,Default,,0,0,0,,...Мұның командалық шайқастарға еш қатысы жоқ!
Dialogue: 0,0:04:43.24,0:04:46.24,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:04:46.66,0:04:49.24,Default,,0,0,0,,Аники Ойын жүріп жатыр.
Dialogue: 0,0:04:49.37,0:04:51.37,Default,,0,0,0,,Егер бұл бала әлдеқашан болса
Dialogue: 0,0:04:51.45,0:04:53.54,Default,,0,0,0,,Қалай ойлайсыңдар, ойын қандай?
Dialogue: 0,0:04:53.62,0:04:56.83,Default,,0,0,0,,Бұл қызықты аттракцион.
Dialogue: 0,0:04:57.00,0:04:59.88,Default,,0,0,0,,Қолдауларыңыз үшін барлығыңызға рахмет.
Dialogue: 0,0:04:59.96,0:05:02.96,Default,,0,0,0,,Ашуланба, таң қалдың!
Dialogue: 0,0:05:03.05,0:05:04.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:05.55,0:05:08.30,Default,,0,0,0,,Қарсыластың өзгеруіне жол берілмейді
Dialogue: 0,0:05:09.22,0:05:12.27,Default,,0,0,0,,Менің қолымнан келмейді, мен оны жеңемін.
Dialogue: 0,0:05:12.35,0:05:13.27,Default,,0,0,0,,Тақырып...
Dialogue: 0,0:05:14.06,0:05:17.77,Default,,0,0,0,,Бос, мен сенімен лига матчына дейін күресемін.
Dialogue: 0,0:05:18.15,0:05:21.61,Default,,0,0,0,,Бүгінгі жеңіс мен үшін жеңіс, мен оны салқын түрде жасаймын!
Dialogue: 0,0:05:21.86,0:05:23.19,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:05:23.28,0:05:26.40,Default,,0,0,0,,Мен сенің ұзын мұрныңды үземін.
Dialogue: 0,0:05:27.03,0:05:29.91,Default,,0,0,0,,Бұл мен жеңе алмайтын жалғыз шайқас.
Dialogue: 0,0:05:30.74,0:05:34.29,Default,,0,0,0,,Мен ол жігіттен тағы жеңілсем, ВС Сол шығады.
Dialogue: 0,0:05:37.83,0:05:42.55,Default,,0,0,0,,Балт сияқты, жақтауды алып тастасаңыз, шығанақ жеңілірек болады.
Dialogue: 0,0:05:42.63,0:05:43.55,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:45.55,0:05:48.30,Default,,0,0,0,,Мен әлемде соғысамын!
Dialogue: 0,0:05:48.93,0:05:51.76,Default,,0,0,0,,Бесінші ойын Бірінші шайқас!
Dialogue: 0,0:05:53.35,0:05:55.06,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:05:55.48,0:05:58.56,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:58.64,0:06:00.98,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:02.48,0:06:04.78,Default,,0,0,0,,Кел, Рагнарук!
Dialogue: 0,0:06:04.98,0:06:07.03,Default,,0,0,0,,Бірінші байланыс! ?
Dialogue: 0,0:06:08.24,0:06:09.16,Default,,0,0,0,,Жалтардым!
Dialogue: 0,0:06:09.24,0:06:10.11,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:10.49,0:06:12.12,Default,,0,0,0,,Рагнарук Бұл жылдам!
Dialogue: 0,0:06:12.20,0:06:15.24,Default,,0,0,0,,О? Жақтау жойылды!
Dialogue: 0,0:06:16.16,0:06:17.16,Default,,0,0,0,,Қашан?
Dialogue: 0,0:06:17.54,0:06:19.92,Default,,0,0,0,,Бұл жеңілірек және жылдамырақ.
Dialogue: 0,0:06:20.00,0:06:21.08,Default,,0,0,0,,Жасайық
Dialogue: 0,0:06:21.42,0:06:24.13,Default,,0,0,0,,Рагнарук орталығына барыңыз!
Dialogue: 0,0:06:24.55,0:06:27.34,Default,,0,0,0,,Жылдамдық өскен сайын центрден тепкіш күш те өседі!
Dialogue: 0,0:06:27.55,0:06:30.39,Default,,0,0,0,,Төзімділік қанаттары ашық қалады!
Dialogue: 0,0:06:31.05,0:06:33.72,Default,,0,0,0,,Ал флугель жүргізушісінің қанаты...
Dialogue: 0,0:06:33.85,0:06:35.81,Default,,0,0,0,,Жоғарғы күшті тудырады
Dialogue: 0,0:06:38.81,0:06:43.27,Default,,0,0,0,,Бұл Кумичо-саманың жаңа Рагнарук аймағы!
Dialogue: 0,0:06:43.40,0:06:45.65,Default,,0,0,0,,(Жанған жалынның дыбысы)
Dialogue: 0,0:06:45.73,0:06:48.11,Default,,0,0,0,,(Адам дыбысы)
Dialogue: 0,0:06:49.36,0:06:50.99,Default,,0,0,0,,(Шайтанның айқайы)
Dialogue: 0,0:06:53.74,0:06:54.95,Default,,0,0,0,,Не!
Dialogue: 0,0:06:55.03,0:06:56.54,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:06:56.62,0:06:59.08,Default,,0,0,0,,Блэйз Рагнарук жасаған ауа ағыны...
Dialogue: 0,0:06:59.16,0:07:02.08,Default,,0,0,0,,Жолыма темір тұлпар боп тұрып
Dialogue: 0,0:07:02.46,0:07:05.04,Default,,0,0,0,,Керемет! Уайверлерді аулақ ұстайды!
Dialogue: 0,0:07:05.34,0:07:07.80,Default,,0,0,0,,Wyvern шабуылы... Шабуыл!
Dialogue: 0,0:07:07.88,0:07:10.63,Default,,0,0,0,,Вакия мырза, бұл Рагнарук қалай пайда болады?
Dialogue: 0,0:07:10.72,0:07:12.55,Default,,0,0,0,,Мен мұны мүлде күткен жоқпын.
Dialogue: 0,0:07:12.64,0:07:15.76,Default,,0,0,0,,Ха! Сіз қарсыласыңызды тым жеңіл қабылдайсыз.
Dialogue: 0,0:07:15.85,0:07:18.89,Default,,0,0,0,,Қорғаныс түріндегі виверлерге қорғануға жол бермеңіз
Dialogue: 0,0:07:18.98,0:07:20.64,Default,,0,0,0,,Бұл жақсы стратегия.
Dialogue: 0,0:07:21.02,0:07:23.44,Default,,0,0,0,,Бұл төзімділік шайқасы.
Dialogue: 0,0:07:23.52,0:07:25.77,Default,,0,0,0,,«Сүйіспеншілік - сізді бір нәрседе жақсы ететін нәрсе»
Dialogue: 0,0:07:25.86,0:07:29.24,Default,,0,0,0,,Рагнарук пен Вайверн әлі де бір-бірін қорғайды.
Dialogue: 0,0:07:29.32,0:07:31.45,Default,,0,0,0,,Қайсысының төзімділігі қалды?
Dialogue: 0,0:07:31.53,0:07:33.70,Default,,0,0,0,,Уайверн Өз жігеріңді көрсет!
Dialogue: 0,0:07:33.78,0:07:35.83,Default,,0,0,0,,Кимеро Рагнарук!
Dialogue: 0,0:07:37.58,0:07:38.91,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:07:39.58,0:07:42.21,Default,,0,0,0,,Blaze Ragnaruk Burst Finish
Dialogue: 0,0:07:42.29,0:07:45.79,Default,,0,0,0,,Бесінші ойын BC Сол үшін 2:0 есебімен жеңіске жетті.
Dialogue: 0,0:07:46.29,0:07:48.46,Default,,0,0,0,,Ойын саны 3-тен 2-ге дейін
Dialogue: 0,0:07:48.55,0:07:52.63,Default,,0,0,0,,Бүгінгі жолдастық кездесу BC Sol және Real Sambat
Dialogue: 0,0:07:53.38,0:07:55.09,Default,,0,0,0,,б.з.б. Жеңіс!
Dialogue: 0,0:07:55.72,0:07:57.35,Default,,0,0,0,,Жарайсың, Кумичо!
Dialogue: 0,0:07:57.72,0:07:58.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:59.39,0:08:03.94,Default,,0,0,0,,б.з.б. Соль BC Соль BC Sol…
Dialogue: 0,0:08:04.06,0:08:05.56,Default,,0,0,0,,А... бұл!
Dialogue: 0,0:08:06.40,0:08:07.61,Default,,0,0,0,,Керемет
Dialogue: 0,0:08:07.69,0:08:09.48,Default,,0,0,0,,Сіз бізге айтып жатырсыз ба?
Dialogue: 0,0:08:09.57,0:08:11.32,Default,,0,0,0,,Кумичоға!
Dialogue: 0,0:08:11.40,0:08:12.82,Default,,0,0,0,,«Бізге»
Dialogue: 0,0:08:13.49,0:08:14.41,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:08:14.49,0:08:16.20,Default,,0,0,0,,Бос, мұнда кел.
Dialogue: 0,0:08:16.28,0:08:18.95,Default,,0,0,0,,б.з.д. Соль BC Соль б.з. Сол…
Dialogue: 0,0:08:19.79,0:08:23.71,Default,,0,0,0,,Тегін Тегін Тегін…
Dialogue: 0,0:08:23.79,0:08:25.75,Default,,0,0,0,,Тегін тамаша
Dialogue: 0,0:08:25.83,0:08:27.63,Default,,0,0,0,,А... тегін?
Dialogue: 0,0:08:27.88,0:08:30.38,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:08:30.46,0:08:33.88,Default,,0,0,0,,Мен командада қаламын. Қараңызшы!
Dialogue: 0,0:08:33.97,0:08:35.22,Default,,0,0,0,,... Эй!
Dialogue: 0,0:08:35.30,0:08:37.76,Default,,0,0,0,,Қарғыс атсын, бейбақ!
Dialogue: 0,0:08:38.05,0:08:40.14,Default,,0,0,0,,Мен сені бір күні міндетті түрде айналдырамын
Dialogue: 0,0:08:40.22,0:08:41.47,Default,,0,0,0,,Мен де!
Dialogue: 0,0:08:41.56,0:08:43.02,Default,,0,0,0,,Бұл солтүстік-батырдағы қала ма?
Dialogue: 0,0:08:43.10,0:08:45.02,Default,,0,0,0,,Сіз тым алданып бара жатырсыз!
Dialogue: 0,0:08:45.10,0:08:47.10,Default,,0,0,0,,Келесі жолы мен міндетті түрде жеңемін.
Dialogue: 0,0:08:47.19,0:08:50.07,Default,,0,0,0,,Жеңілгеннің айқайы көріксіз
Dialogue: 0,0:08:50.15,0:08:50.73,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:50.82,0:08:53.40,Default,,0,0,0,,Cisco, сіз бірдеңе дедіңіз бе?
Dialogue: 0,0:08:53.78,0:08:56.99,Default,,0,0,0,,Сіз және осы команда жеңіліске ұшырады.
Dialogue: 0,0:08:57.07,0:08:59.74,Default,,0,0,0,,Cisco, сіз жұмыстан босатылдыңыз!
Dialogue: 0,0:08:59.99,0:09:02.33,Default,,0,0,0,,Эй, мен осы жерден тоқтайын.
Dialogue: 0,0:09:04.66,0:09:07.38,Default,,0,0,0,,Маған қарашы, өзімшіл кішкентай бала.
Dialogue: 0,0:09:07.46,0:09:09.13,Default,,0,0,0,,Бэйді бірге ойнай аламыз ба?
Dialogue: 0,0:09:09.38,0:09:11.00,Default,,0,0,0,,Бұл менің жолым.
Dialogue: 0,0:09:11.09,0:09:12.13,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:09:12.21,0:09:13.71,Default,,0,0,0,,А?
Dialogue: 0,0:09:13.80,0:09:15.72,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:09:15.80,0:09:18.64,Default,,0,0,0,,Балт Рахмет сізге «Грасия»!
Dialogue: 0,0:09:18.72,0:09:20.47,Default,,0,0,0,,О, Греция!
Dialogue: 0,0:09:20.56,0:09:21.72,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:09:21.81,0:09:26.06,Default,,0,0,0,,Жолдастық кездесуде жеңіске жеткеніңізге қуанышты сияқтысыз.
Dialogue: 0,0:09:26.44,0:09:28.81,Default,,0,0,0,,Біз оңайырақ жеңер едік.
Dialogue: 0,0:09:28.90,0:09:32.90,Default,,0,0,0,,Біз жоғары команда болғандықтан, сақтықты төмендетсек, бізді басып кетуі мүмкін.
Dialogue: 0,0:09:33.03,0:09:35.11,Default,,0,0,0,,Бұл тым көп жұмыс Шаса
Dialogue: 0,0:09:37.78,0:09:39.62,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:09:40.49,0:09:42.12,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:09:42.74,0:09:46.04,Default,,0,0,0,,Тегіннен басқа сізге ұнайтын пышақ бар ма?
Dialogue: 0,0:09:46.87,0:09:48.29,Default,,0,0,0,,Өкінішке орай...
Dialogue: 0,0:09:48.79,0:09:51.84,Default,,0,0,0,,Біз БС Солды Әлемдік лигада күтеміз.
Dialogue: 0,0:09:52.34,0:09:56.26,Default,,0,0,0,,Мен қатыса алсам, хахахаха
Dialogue: 0,0:09:57.59,0:10:00.47,Default,,0,0,0,,Дүниежүзілік лигаға қатысуға міндетті болыңыз
Dialogue: 0,0:10:00.72,0:10:01.72,Default,,0,0,0,,Әрине
Dialogue: 0,0:10:02.10,0:10:05.89,Default,,0,0,0,,Мен Еуропа Лигасы басталғанша бұдан да көп жаттығуды жалғастырамын.
Dialogue: 0,0:10:05.98,0:10:07.73,Default,,0,0,0,,Trad-тен ләззат алайық
Dialogue: 0,0:10:11.40,0:10:13.57,Default,,0,0,0,,Жасырыңдар, балалар.
Dialogue: 0,0:10:14.28,0:10:17.24,Default,,0,0,0,,Мен бұны киемін… жетімдер үйінде өткізген күндерімді ұмытпау үшін.
Dialogue: 0,0:10:17.61,0:10:19.70,Default,,0,0,0,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:10:19.78,0:10:22.24,Default,,0,0,0,,Тұр! Менің демалуға уақытым жоқ
Dialogue: 0,0:10:22.37,0:10:26.45,Default,,0,0,0,,Тамырыңызды осылай ұстасаңыз, Дүниежүзілік лигаға қатыса алмайсыз.
Dialogue: 0,0:10:26.83,0:10:28.12,Default,,0,0,0,,34-кітап!
Dialogue: 0,0:10:29.29,0:10:31.79,Default,,0,0,0,,Сіз қанша жүгіруге барасыз?
Dialogue: 0,0:10:31.88,0:10:33.17,Default,,0,0,0,,Сіз тоқтай аласыз.
Dialogue: 0,0:10:33.25,0:10:34.67,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:10:34.75,0:10:36.01,Default,,0,0,0,,Сіз әлі де жалғастыра аласыз.
Dialogue: 0,0:10:36.09,0:10:37.38,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:10:37.47,0:10:41.01,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:41.09,0:10:43.51,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:54.36,0:10:55.78,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:10:56.15,0:10:57.74,Default,,0,0,0,,100 сызықша соңы
Dialogue: 0,0:11:00.03,0:11:03.16,Default,,0,0,0,,It's finally over
Dialogue: 0,0:11:03.62,0:11:06.20,Default,,0,0,0,,Күтілгендей, Тегін жақсы көрінеді.
Dialogue: 0,0:11:06.29,0:11:07.54,Default,,0,0,0,,That's amazing.
Dialogue: 0,0:11:07.95,0:11:10.46,Default,,0,0,0,,1 сағаттан кейін жаттығу алаңында кездесу.
Dialogue: 0,0:11:12.08,0:11:15.42,Default,,0,0,0,,Мен азырақ ренжідім~
Dialogue: 0,0:11:15.50,0:11:16.55,Default,,0,0,0,,Мен де
Dialogue: 0,0:11:16.63,0:11:17.67,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:11:17.76,0:11:19.92,Default,,0,0,0,,Егер сіз күш-қуатыңызды толықтырғыңыз келсе, дәл қазір.
Dialogue: 0,0:11:21.34,0:11:23.76,Default,,0,0,0,,Андж сізге бірдеңе дайындаған болуы керек еді.
Dialogue: 0,0:11:24.05,0:11:26.64,Default,,0,0,0,,Түсіндім! Біз жасадық, ана.
Dialogue: 0,0:11:26.72,0:11:27.60,Default,,0,0,0,,Мен де!
Dialogue: 0,0:11:29.93,0:11:31.81,Default,,0,0,0,,Күннің ең жақсы сызықшасы.
Dialogue: 0,0:11:31.89,0:11:33.81,Default,,0,0,0,,Мен бұны киемін… жетімдер үйінде өткізген күндерімді ұмытпау үшін.
Dialogue: 0,0:11:36.40,0:11:40.53,Default,,0,0,0,,Жүр, көп тамақтан. Тамақ - бұл кілт.
Dialogue: 0,0:11:40.61,0:11:42.07,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:11:44.57,0:11:46.53,Default,,0,0,0,,Уау, мынау чирролар!
Dialogue: 0,0:11:46.66,0:11:47.87,Default,,0,0,0,,Оны да ішіңіз.
Dialogue: 0,0:11:47.95,0:11:50.37,Default,,0,0,0,,Кальций мен белокты толықтыру
Dialogue: 0,0:11:52.79,0:11:54.88,Default,,0,0,0,,Дәмді! Қайта толтырыңыз!
Dialogue: 0,0:11:54.96,0:11:56.71,Default,,0,0,0,,Тез тамақтаныңыз!
Dialogue: 0,0:11:57.13,0:11:58.71,Default,,0,0,0,,Бұл тегін бе?
Dialogue: 0,0:11:58.80,0:12:00.46,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:12:00.76,0:12:03.76,Default,,0,0,0,,Үзіліс кезінде мен бір жаққа өзім барамын.
Dialogue: 0,0:12:04.22,0:12:05.72,Default,,0,0,0,,Сіз не істеп жатырсыз деп ойлаймын
Dialogue: 0,0:12:05.80,0:12:08.97,Default,,0,0,0,,Мен күшімді қалпына келтіру үшін бір жерге төсекке жаттым.
Dialogue: 0,0:12:09.06,0:12:10.47,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:10.93,0:12:12.94,Default,,0,0,0,,Ұйықтаудың да мағынасы бар шығар
Dialogue: 0,0:12:13.48,0:12:16.52,Default,,0,0,0,,Эй, Балто, мен сені келеді деп күтпедім...
Dialogue: 0,0:12:16.61,0:12:17.86,Default,,0,0,0,,Мен де ұйықтаймын!
Dialogue: 0,0:12:19.44,0:12:21.11,Default,,0,0,0,,Менің ойымша, бұл келе жатыр!
Dialogue: 0,0:12:21.19,0:12:23.03,Default,,0,0,0,,Жарайды, мен де ұйықтаймын!
Dialogue: 0,0:12:25.16,0:12:26.57,Default,,0,0,0,,Эбисудың хаос тудыратын сиқыршы екенін ойласаң...
Dialogue: 0,0:12:26.66,0:12:28.24,Default,,0,0,0,,Тіпті бос ақша
Dialogue: 0,0:12:28.33,0:12:31.29,Default,,0,0,0,,Еліктеу арқылы күшейе алсаңыз, сізде қиындық болмайды
Dialogue: 0,0:12:50.06,0:12:51.43,Default,,0,0,0,,Физикалық тәрбие сабағы басталып кетті.
Dialogue: 0,0:12:52.60,0:12:53.64,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:12:56.81,0:12:58.48,Default,,0,0,0,,Бұл скучно емес пе?
Dialogue: 0,0:13:00.98,0:13:04.28,Default,,0,0,0,,Бұдан былай біз еркін конькишілерден басқа үздік командалармен жұмыс істейтін боламыз.
Dialogue: 0,0:13:04.36,0:13:07.41,Default,,0,0,0,,Екінші топты айналмалы жүйемен жарыстырыңыз
Dialogue: 0,0:13:07.91,0:13:10.91,Default,,0,0,0,,Крис екеуміз оған қарап, таңдау жасаймыз.
Dialogue: 0,0:13:11.24,0:13:13.33,Default,,0,0,0,,Таңдау? Бұл не?
Dialogue: 0,0:13:13.41,0:13:14.25,Default,,0,0,0,,Енді?
Dialogue: 0,0:13:14.33,0:13:15.37,Default,,0,0,0,,Бұл сынақ.
Dialogue: 0,0:13:16.37,0:13:19.21,Default,,0,0,0,,Топтың үздік мүшелерін анықтау үшін анықтама ретінде пайдаланылады
Dialogue: 0,0:13:19.88,0:13:21.80,Default,,0,0,0,,Тағы бір сынақ...
Dialogue: 0,0:13:21.88,0:13:24.01,Default,,0,0,0,,Егер сізге ұнамаса, кез келген уақытта кете аласыз.
Dialogue: 0,0:13:24.22,0:13:25.38,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:13:25.47,0:13:26.22,Default,,0,0,0,,Мен де!
Dialogue: 0,0:13:26.72,0:13:30.26,Default,,0,0,0,,Мен оларды міндетті түрде қуамын.
Dialogue: 0,0:13:33.06,0:13:34.06,Default,,0,0,0,,Тегін?
Dialogue: 0,0:13:35.77,0:13:37.81,Default,,0,0,0,,Маған бұл жерде болуым керек емес.
Dialogue: 0,0:13:38.23,0:13:40.69,Default,,0,0,0,,Сіз топ басшысысыз. Толығырақ...
Dialogue: 0,0:13:40.77,0:13:42.07,Default,,0,0,0,,Себебі мен жеңемін
Dialogue: 0,0:13:42.15,0:13:43.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:43.65,0:13:45.78,Default,,0,0,0,,Бұл көшбасшы, солай ма?
Dialogue: 0,0:13:46.53,0:13:47.78,Default,,0,0,0,,Баруға болады.
Dialogue: 0,0:13:49.24,0:13:51.99,Default,,0,0,0,,Мен тест нәтижелерін асыға күтемін.
Dialogue: 0,0:13:52.62,0:13:53.74,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:13:54.54,0:13:57.08,Default,,0,0,0,,Тегін тіпті сенімен айналыспайды.
Dialogue: 0,0:13:57.62,0:13:58.71,Default,,0,0,0,,Бұл жиіркенішті, солай емес пе?
Dialogue: 0,0:13:58.79,0:14:00.21,Default,,0,0,0,,(Жіреніш дауысы)
Dialogue: 0,0:14:00.29,0:14:01.75,Default,,0,0,0,,Олай болса жеңіңіз!
Dialogue: 0,0:14:01.96,0:14:03.00,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:14:03.09,0:14:04.21,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:14:04.80,0:14:06.38,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:14:06.63,0:14:07.80,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:14:08.05,0:14:11.26,Default,,0,0,0,,♪~
Dialogue: 0,0:14:34.12,0:14:36.04,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:14:36.12,0:14:38.79,Default,,0,0,0,,Мен саған жоғары топтың күшін көрсетемін
Dialogue: 0,0:14:38.87,0:14:42.29,Default,,0,0,0,,Бәріміз бірдей шабуыл түрімен шығайық!
Dialogue: 0,0:14:42.38,0:14:44.34,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:44.84,0:14:47.88,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:48.22,0:14:50.93,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:53.30,0:14:55.39,Default,,0,0,0,,Иә! Бұл бақылаудан шықты!
Dialogue: 0,0:14:55.51,0:14:58.27,Default,,0,0,0,,Иә! Мен бұл матчты жеңдім!
Dialogue: 0,0:15:00.90,0:15:03.36,Default,,0,0,0,,Бұл соңы! Бітір!
Dialogue: 0,0:15:06.86,0:15:08.44,Default,,0,0,0,,Көтеріп кеткен сияқты! ?
Dialogue: 0,0:15:08.74,0:15:12.20,Default,,0,0,0,,Жүр! ұшатын соққы
Dialogue: 0,0:15:12.78,0:15:14.41,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:15:14.95,0:15:16.24,Default,,0,0,0,,Не!
Dialogue: 0,0:15:17.24,0:15:18.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:19.54,0:15:20.58,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:22.17,0:15:23.67,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:15:25.21,0:15:26.25,Default,,0,0,0,,Тс!
Dialogue: 0,0:15:27.00,0:15:28.30,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:15:28.55,0:15:30.88,Default,,0,0,0,,Міне! Шайқас осы жерде аяқталады.
Dialogue: 0,0:15:31.34,0:15:34.22,Default,,0,0,0,,Бұдан былай бұл жаңа мүшелер үшін қабылдау сынағы болады.
Dialogue: 0,0:15:34.51,0:15:35.55,Default,,0,0,0,,Жаңадан келген адам?
Dialogue: 0,0:15:35.64,0:15:36.97,Default,,0,0,0,,Мен бұл туралы естіген жоқпын...
Dialogue: 0,0:15:42.52,0:15:43.35,Default,,0,0,0,,Ақша, мәртебе және әдемі әйел.
Dialogue: 0,0:15:43.77,0:15:44.69,Default,,0,0,0,,Cisco!
Dialogue: 0,0:15:45.06,0:15:46.52,Default,,0,0,0,,Неге ол жігіт?
Dialogue: 0,0:15:46.61,0:15:48.48,Default,,0,0,0,,Нағыз Самбат, солай ма?
Dialogue: 0,0:15:48.57,0:15:50.32,Default,,0,0,0,,Бұл бізге ауысатыныңызды білдіре ме?
Dialogue: 0,0:15:50.74,0:15:51.90,Default,,0,0,0,,Аударым емес
Dialogue: 0,0:15:52.24,0:15:55.74,Default,,0,0,0,,Енді Cisco Carlyle ешқайда жатпайды.
Dialogue: 0,0:15:55.95,0:15:57.79,Default,,0,0,0,,Мен Реалдан бас тарттым.
Dialogue: 0,0:15:58.04,0:16:00.16,Default,,0,0,0,,Бірақ неге Б.С. Соль?
Dialogue: 0,0:16:00.75,0:16:03.54,Default,,0,0,0,,Кез келген командамен ойнау – менің еркіндігім.
Dialogue: 0,0:16:03.67,0:16:07.54,Default,,0,0,0,,Ал егер бұл BC Sol болса, мен бірден жоғары командада боламын.
Dialogue: 0,0:16:08.21,0:16:09.63,Default,,0,0,0,,BC Sol жалама
Dialogue: 0,0:16:09.71,0:16:11.59,Default,,0,0,0,,Ауыз – бәленің көзі
Dialogue: 0,0:16:11.84,0:16:13.59,Default,,0,0,0,,Мен оның не істей алатынын білемін.
Dialogue: 0,0:16:14.22,0:16:16.93,Default,,0,0,0,,Мен топқа сөзсіз қосылуға рұқсат алғым келеді, бірақ...
Dialogue: 0,0:16:17.26,0:16:18.97,Default,,0,0,0,,Ол оңай кірді.
Dialogue: 0,0:16:19.06,0:16:21.93,Default,,0,0,0,,Балалар, сіз көп шағымданатын боласыз деп ойлаңыз.
Dialogue: 0,0:16:22.06,0:16:26.19,Default,,0,0,0,,Хуанзан қалай болғанда да, менің қосылу сынағым Омимен өтті.
Dialogue: 0,0:16:26.44,0:16:27.73,Default,,0,0,0,,Бұл Рантаро!
Dialogue: 0,0:16:27.82,0:16:29.07,Default,,0,0,0,,Бір сәт!
Dialogue: 0,0:16:29.53,0:16:31.44,Default,,0,0,0,,Мен сенің қарсыласың боламын.
Dialogue: 0,0:16:32.11,0:16:33.24,Default,,0,0,0,,Джанго
Dialogue: 0,0:16:33.90,0:16:37.53,Default,,0,0,0,,Рантаро Кияма команданың үздік ойыншысы емес.
Dialogue: 0,0:16:37.62,0:16:42.00,Default,,0,0,0,,Егер сіз BC Sol-ға қосылғыңыз келсе, мені жоғары командадан жеңіп көріңіз.
Dialogue: 0,0:16:42.25,0:16:43.29,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:43.66,0:16:47.17,Default,,0,0,0,,Маған жоғары команданың қандай екенін көрсетейін.
Dialogue: 0,0:16:47.42,0:16:50.17,Default,,0,0,0,,Хуаншань, сен мына жігіттің қасындасың.
Dialogue: 0,0:16:54.30,0:16:57.55,Default,,0,0,0,,Мен команданың үздік ойыншысы ретінде де мақтанамын.
Dialogue: 0,0:16:57.89,0:17:00.35,Default,,0,0,0,,Сол мақтанышыңызды осы матчқа салыңыз!
Dialogue: 0,0:17:00.93,0:17:03.85,Default,,0,0,0,,Сіздің мақтанышыңыздың маған қатысы жоқ.
Dialogue: 0,0:17:04.18,0:17:05.06,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:05.60,0:17:07.31,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:07.73,0:17:10.98,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:11.19,0:17:13.40,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:13.49,0:17:14.57,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:17:17.61,0:17:19.24,Default,,0,0,0,,Бар!
Dialogue: 0,0:17:23.58,0:17:25.33,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:17:25.91,0:17:26.79,Default,,0,0,0,,Не!
Dialogue: 0,0:17:28.33,0:17:30.38,Default,,0,0,0,,Бұл нәзік мақтаныш болды.
Dialogue: 0,0:17:30.46,0:17:32.88,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:17:32.96,0:17:34.80,Default,,0,0,0,,Джанго соққы береді...
Dialogue: 0,0:17:34.88,0:17:35.88,Default,,0,0,0,,Күшті!
Dialogue: 0,0:17:37.09,0:17:37.97,Default,,0,0,0,,Куу…
Dialogue: 0,0:17:38.34,0:17:41.10,Default,,0,0,0,,Жүр, Хуаншан, келесің сенсің.
Dialogue: 0,0:17:41.64,0:17:43.10,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:44.39,0:17:46.23,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:17:46.94,0:17:49.69,Default,,0,0,0,,Неліктен Cisco Кумичомен ойнағысы келеді?
Dialogue: 0,0:17:49.90,0:17:52.19,Default,,0,0,0,,Кумичо Вакияны жеңді, солай ма?
Dialogue: 0,0:17:52.27,0:17:53.44,Default,,0,0,0,,Сондықтан да...
Dialogue: 0,0:17:53.98,0:17:58.24,Default,,0,0,0,,Эй, матчтан бір күн бұрын Балтоға қарсы ойнап, жеңілгеніңді естідім.
Dialogue: 0,0:17:58.57,0:18:01.66,Default,,0,0,0,,Сол кезде мен оң қолмен ұрып, жеңіл жүрдім.
Dialogue: 0,0:18:01.95,0:18:04.12,Default,,0,0,0,,Бүгін мен сізге қаншалықты байсалды екенімді көрсетемін
Dialogue: 0,0:18:04.83,0:18:07.00,Default,,0,0,0,,Crys Satan - қорғаныс түрі.
Dialogue: 0,0:18:07.62,0:18:09.42,Default,,0,0,0,,Сонда стратегия –
Dialogue: 0,0:18:10.04,0:18:12.00,Default,,0,0,0,,Жұмыста болған кездегідей!
Dialogue: 0,0:18:12.38,0:18:13.46,Default,,0,0,0,,Хуаншан
Dialogue: 0,0:18:13.80,0:18:16.63,Default,,0,0,0,,Мен сіз ойлағанның бәрін оқи аламын.
Dialogue: 0,0:18:18.01,0:18:19.43,Default,,0,0,0,,(дыбысты жою)
Dialogue: 0,0:18:19.55,0:18:20.68,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:18:21.14,0:18:22.93,Default,,0,0,0,,Жақтауды алып тастадыңыз ба?
Dialogue: 0,0:18:24.18,0:18:25.89,Default,,0,0,0,,Cisco, сіз күлесіз.
Dialogue: 0,0:18:25.97,0:18:27.48,Default,,0,0,0,,Мен жай ғана қалжыңдап тұрмын.
Dialogue: 0,0:18:27.94,0:18:30.85,Default,,0,0,0,,Kumicho Cisco бір нәрсеге ұмтылуда!
Dialogue: 0,0:18:31.40,0:18:32.56,Default,,0,0,0,,Цубаки горилла емес—
Dialogue: 0,0:18:33.82,0:18:35.61,Default,,0,0,0,,Тіпті мен жылдам шабуылды көздедім!
Dialogue: 0,0:18:37.24,0:18:39.20,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:39.45,0:18:42.74,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:44.12,0:18:46.45,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:50.00,0:18:51.58,Default,,0,0,0,,(Қанат дыбысы)
Dialogue: 0,0:18:54.75,0:18:57.51,Default,,0,0,0,,Жақсы! Жылдам шабуылмен орталықты алыңыз!
Dialogue: 0,0:18:57.84,0:19:00.13,Default,,0,0,0,,Мен саған нағыз асықты көрсетемін.
Dialogue: 0,0:19:00.22,0:19:02.64,Default,,0,0,0,,Жүр! Шайтан жыла!
Dialogue: 0,0:19:06.22,0:19:08.14,Default,,0,0,0,,Иә! Сіз таңдандырмайсыз ба?
Dialogue: 0,0:19:08.43,0:19:09.89,Default,,0,0,0,,Бұл сәтсіз ату болды ма?
Dialogue: 0,0:19:10.14,0:19:11.98,Default,,0,0,0,,Жоқ, бұл әдейі.
Dialogue: 0,0:19:12.06,0:19:15.52,Default,,0,0,0,,Аа, мен Рагнарукты тексеріп жатқан сияқтымын.
Dialogue: 0,0:19:16.53,0:19:18.57,Default,,0,0,0,,Мен мұны істей алатыныма сенбеймін...
Dialogue: 0,0:19:19.11,0:19:20.86,Default,,0,0,0,,Роликтер де қызып кетті.
Dialogue: 0,0:19:20.95,0:19:22.07,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:19:22.49,0:19:24.37,Default,,0,0,0,,Аяқтау уақыты келді!
Dialogue: 0,0:19:24.58,0:19:27.62,Default,,0,0,0,,Бұлай етпе, Айқай Шайтан!
Dialogue: 0,0:19:32.08,0:19:33.67,Default,,0,0,0,,(Шайтанның айқайы)
Dialogue: 0,0:19:33.75,0:19:36.09,Default,,0,0,0,,Циклондық цикл
Dialogue: 0,0:19:40.09,0:19:42.38,Default,,0,0,0,,(Қатты соқтығыстың дыбысы)
Dialogue: 0,0:19:43.01,0:19:44.18,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:44.26,0:19:45.43,Default,,0,0,0,,Не!
Dialogue: 0,0:19:49.18,0:19:52.06,Default,,0,0,0,,Дағдарыс Шайтан жарылып аяқталды!
Dialogue: 0,0:19:52.39,0:19:54.81,Default,,0,0,0,,Бұл менің жылдам шабуылым.
Dialogue: 0,0:19:56.23,0:19:57.86,Default,,0,0,0,,Cisco Carlyle
Dialogue: 0,0:19:58.28,0:19:59.99,Default,,0,0,0,,BC Sol-қа қош келдіңіз!
Dialogue: 0,0:20:01.24,0:20:02.36,Default,,0,0,0,,Тегін
Dialogue: 0,0:20:02.45,0:20:06.12,Default,,0,0,0,,Мен бұл топқа сен туралы бәрін білу үшін келдім.
Dialogue: 0,0:20:06.20,0:20:08.91,Default,,0,0,0,,Және сені жеңу үшін!
Dialogue: 0,0:20:10.58,0:20:11.75,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:31.35,0:20:32.35,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:20:32.68,0:20:36.23,Default,,0,0,0,,Cisco's Yarrow осындай жылдам шабуылға ие!
Dialogue: 0,0:20:36.36,0:20:37.48,Default,,0,0,0,,Кумичо
Dialogue: 0,0:20:37.56,0:20:39.86,Default,,0,0,0,,Бірақ циклондық цикл керемет болды.
Dialogue: 0,0:20:39.94,0:20:41.36,Default,,0,0,0,,Бұл кездейсоқтық! Бұл кездейсоқтық!
Dialogue: 0,0:20:41.82,0:20:43.11,Default,,0,0,0,,Келесі жолы мен міндетті түрде жеңемін!
Dialogue: 0,0:20:43.82,0:20:45.11,Default,,0,0,0,,Өте қиын!
Dialogue: 0,0:20:45.36,0:20:46.74,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:47.03,0:20:47.95,Default,,0,0,0,,Джанго...
Dialogue: 0,0:20:54.29,0:20:55.50,Default,,0,0,0,,Джанго!
Dialogue: 0,0:20:56.25,0:20:58.29,Default,,0,0,0,,BC Sol Сіз жұмыстан шығасыз ба?
Dialogue: 0,0:20:58.42,0:20:59.92,Default,,0,0,0,,Тоқтатпа, Джанго.
Dialogue: 0,0:21:00.75,0:21:04.59,Default,,0,0,0,,Мен жай ғана екінші командаға төмендедім.
Dialogue: 0,0:21:04.68,0:21:05.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:06.09,0:21:08.05,Default,,0,0,0,,Төменгі қабатта мұны істеуге шыдай алмаймын.
Dialogue: 0,0:21:08.72,0:21:11.64,Default,,0,0,0,,Сондықтан мен бұл топтан кетуді шештім.
Dialogue: 0,0:21:12.14,0:21:13.68,Default,,0,0,0,,Бірақ Джанго...
Dialogue: 0,0:21:14.14,0:21:15.64,Default,,0,0,0,,Маған ешқандай жайлылық керек емес
Dialogue: 0,0:21:15.94,0:21:18.81,Default,,0,0,0,,Мен керек жерге барамын
Dialogue: 0,0:21:19.11,0:21:20.11,Default,,0,0,0,,Осымен
Dialogue: 0,0:21:20.86,0:21:22.99,Default,,0,0,0,,Басқа командаға ауысып жатырсыз ба?
Dialogue: 0,0:21:23.19,0:21:25.57,Default,,0,0,0,,Тағы да мақтанышыңды қайтар
Dialogue: 0,0:21:26.07,0:21:27.07,Default,,0,0,0,,Джанго…
Dialogue: 0,0:21:27.99,0:21:30.58,Default,,0,0,0,,Стэн, бір жерде тағы кездесейік.
Dialogue: 0,0:21:36.71,0:21:38.21,Default,,0,0,0,,Бұл сіздердің арқаларыңызда!
Dialogue: 0,0:21:40.21,0:21:42.13,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:21:42.80,0:21:44.51,Default,,0,0,0,,Бұл біздің кінәміз емес
Dialogue: 0,0:21:44.59,0:21:46.09,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:21:49.14,0:21:52.81,Default,,0,0,0,,Джанго! Тағы да шайқасайық!
Dialogue: 0,0:21:55.98,0:21:58.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.52,0:22:02.02,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:02.11,0:22:04.94,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:05.03,0:22:07.11,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.20,0:22:10.74,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.82,0:22:14.37,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.45,0:22:16.16,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.25,0:22:18.04,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.12,0:22:19.92,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:20.00,0:22:21.59,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.67,0:22:23.59,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.67,0:22:26.13,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.21,0:22:29.13,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.22,0:22:32.85,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.93,0:22:36.60,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.68,0:22:38.31,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.39,0:22:41.73,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.81,0:22:44.02,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.11,0:22:47.61,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.69,0:22:51.24,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.32,0:22:53.20,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.28,0:22:55.04,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.12,0:22:58.54,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.62,0:23:00.83,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.92,0:23:03.63,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.71,0:23:05.92,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:06.00,0:23:09.93,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:10.01,0:23:13.60,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.68,0:23:17.18,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.27,0:23:20.56,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.64,0:23:22.27,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.35,0:23:25.40,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.35,0:23:25.40,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.19,0:23:28.82,Default,,0,0,0,,Ұжымдағы жағымсыз атмосфера
Dialogue: 0,0:23:28.90,0:23:31.49,Default,,0,0,0,,Валькири мен қалағандай қозғалмайды.
Dialogue: 0,0:23:31.57,0:23:33.62,Default,,0,0,0,,Бәріне мен кінәлімін бе?
Dialogue: 0,0:23:33.70,0:23:37.24,Default,,0,0,0,,Мен қатты уайымдағанда күлме, Кумичо!
Dialogue: 0,0:23:37.33,0:23:40.50,Default,,0,0,0,,Ой, бұл не! Маған да көрсет!
Dialogue: 0,0:23:41.00,0:23:43.33,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.42,0:23:45.17,Default,,0,0,0,,Ұстаңыз! Үздік команда!
Dialogue: 0,0:23:45.63,0:23:49.17,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.67,0:23:56.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory