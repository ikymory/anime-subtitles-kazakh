Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.21,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.01,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.43,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.73,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.06,0:00:29.65,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:31.03,0:00:33.53,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:33.78,0:00:34.53,Default,,0,0,0,,Мен сені күттім, Батыр. ➡
Dialogue: 0,0:00:34.86,0:00:36.20,Default,,0,0,0,,Бұл басталды!
Dialogue: 0,0:00:36.28,0:00:40.04,Default,,0,0,0,,BC Sol және Real Sambat арасындағы жолдастық кездесудің бірінші ойыны
Dialogue: 0,0:00:40.95,0:00:44.66,Default,,0,0,0,,Вакияның Торнадо Вайверні керемет дамыды!
Dialogue: 0,0:00:47.04,0:00:49.17,Default,,0,0,0,,Қалқан апаты!
Dialogue: 0,0:00:51.63,0:00:53.05,Default,,0,0,0,,Ахх!
Dialogue: 0,0:00:53.80,0:00:55.80,Default,,0,0,0,,Екінші ойын – мен және Вакия
Dialogue: 0,0:00:56.18,0:00:58.80,Default,,0,0,0,,Мен бірінші шайқаста жеңілдім, бірақ...
Dialogue: 0,0:00:59.18,0:01:01.14,Default,,0,0,0,,Бұл жиіркенішті ме?
Dialogue: 0,0:01:01.22,0:01:02.43,Default,,0,0,0,,Әрине бар.
Dialogue: 0,0:01:03.27,0:01:04.48,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:01:05.35,0:01:06.39,Default,,0,0,0,,Кадр!
Dialogue: 0,0:01:08.52,0:01:10.15,Default,,0,0,0,,Ах! Ол шықты!
Dialogue: 0,0:01:12.44,0:01:14.36,Default,,0,0,0,,Ха... ха!
Dialogue: 0,0:01:19.49,0:01:21.20,Default,,0,0,0,,Жүр!
Dialogue: 0,0:01:29.17,0:01:30.92,Default,,0,0,0,,Бұл бір-бірден
Dialogue: 0,0:01:31.00,0:01:34.05,Default,,0,0,0,,Үшінші ойын Менің келесі қарсыласым...
Dialogue: 0,0:01:34.42,0:01:35.38,Default,,0,0,0,,Cisco
Dialogue: 0,0:01:36.13,0:01:38.47,Default,,0,0,0,,Сіздің кезегіңіз, солай ма? менікі
Dialogue: 0,0:01:39.47,0:01:42.22,Default,,0,0,0,,♪~
Dialogue: 0,0:01:42.31,0:01:44.77,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:44.85,0:01:47.31,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:47.39,0:01:49.73,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:49.81,0:01:52.15,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:52.23,0:01:53.78,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:53.86,0:01:58.11,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:59.07,0:02:03.83,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:03.91,0:02:08.41,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:08.92,0:02:13.67,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:13.75,0:02:18.68,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:18.76,0:02:23.64,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:23.72,0:02:28.64,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:28.73,0:02:32.06,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:32.15,0:02:33.73,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:33.82,0:02:36.32,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:36.40,0:02:38.57,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:38.65,0:02:40.86,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:40.99,0:02:42.24,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:42.32,0:02:43.87,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:43.95,0:02:46.37,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:46.45,0:02:52.50,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:52.58,0:02:57.13,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:57.21,0:02:59.72,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:59.80,0:03:02.30,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:02.39,0:03:04.72,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:04.80,0:03:06.76,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:06.76,0:03:08.64,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:06.76,0:03:08.64,Default,,0,0,0,,~♪
Dialogue: 0,0:03:10.35,0:03:12.85,Default,,0,0,0,,Сиқырлы шабуыл! Шайтан жыла!
Dialogue: 0,0:03:16.44,0:03:19.86,Default,,0,0,0,,Жарайды! Blader үшінші ойынға қатысады
Dialogue: 0,0:03:19.94,0:03:23.41,Default,,0,0,0,,BC Сол Барто Аои екінші рет пайда болды!
Dialogue: 0,0:03:23.49,0:03:25.95,Default,,0,0,0,,Нағыз Самбат — Cisco Carlyle
Dialogue: 0,0:03:26.03,0:03:28.83,Default,,0,0,0,,Иесі Комурасаки Вакияның орнында пайда болуы
Dialogue: 0,0:03:29.08,0:03:32.37,Default,,0,0,0,,Әр ойында қарсыласыңыздан 2 ұпай алу арқылы жеңіңіз.
Dialogue: 0,0:03:32.58,0:03:35.50,Default,,0,0,0,,Алдымен 3 ойында ұтсаңыз, ойын жинағын ұтасыз.
Dialogue: 0,0:03:35.79,0:03:38.88,Default,,0,0,0,,Осы үшінші ойында кім бірінші жеңіске жетеді?
Dialogue: 0,0:03:38.96,0:03:40.51,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:03:41.13,0:03:43.05,Default,,0,0,0,,Сәттілік Балто
Dialogue: 0,0:03:43.84,0:03:46.51,Default,,0,0,0,,Қызықсыз, тегін емес пе?
Dialogue: 0,0:03:46.89,0:03:48.26,Default,,0,0,0,,Сіз мұны бұрын көрдіңіз бе?
Dialogue: 0,0:03:48.35,0:03:50.89,Default,,0,0,0,,Валькирияның құдіреті тоқтаусыз!
Dialogue: 0,0:03:51.23,0:03:53.02,Default,,0,0,0,,Иә! Айтпайсың ба?
Dialogue: 0,0:03:53.94,0:03:56.65,Default,,0,0,0,,Мен сізге кешегі қарызымды қайтарамын.
Dialogue: 0,0:03:57.15,0:03:58.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:58.11,0:04:02.61,Default,,0,0,0,,Осы екеуінің арасындағы шайқасқа дейін де ыстық және күшті ұшқындар ұшқан.
Dialogue: 0,0:04:02.70,0:04:04.57,Default,,0,0,0,,Мен қарсыластың иісін сезіп тұрмын.
Dialogue: 0,0:04:05.16,0:04:08.70,Default,,0,0,0,,Эй, Cisco шығанағы Crys Satan деп аталады.
Dialogue: 0,0:04:08.83,0:04:10.75,Default,,0,0,0,,Иә, бұл қорғаныс түрі.
Dialogue: 0,0:04:10.83,0:04:13.21,Default,,0,0,0,,Мүмкіндік - роликтер арқылы қорғаныс.
Dialogue: 0,0:04:13.54,0:04:15.96,Default,,0,0,0,,Қарсыластың шабуылын тойтарыңыз, солай ма?
Dialogue: 0,0:04:16.04,0:04:17.25,Default,,0,0,0,,Қатты көрінеді
Dialogue: 0,0:04:17.34,0:04:19.59,Default,,0,0,0,,Аники Cisco-ны бір рет жеңді.
Dialogue: 0,0:04:19.67,0:04:21.63,Default,,0,0,0,,Мен Cry Шайтанның не істей алатынын білемін.
Dialogue: 0,0:04:21.71,0:04:23.72,Default,,0,0,0,,Басқа адамға да солай, солай ма?
Dialogue: 0,0:04:24.01,0:04:25.97,Default,,0,0,0,,Жоқ, жоқ, Шаса-кун
Dialogue: 0,0:04:26.05,0:04:28.68,Default,,0,0,0,,Валькири кадрды алып тастаған сияқты.
Dialogue: 0,0:04:28.76,0:04:32.43,Default,,0,0,0,,Бұл қалай жұмыс істейтіні Cisco үшін бірінші болып табылады.
Dialogue: 0,0:04:32.81,0:04:36.15,Default,,0,0,0,,Менің ойымша, ол да бұл шайқасты оқи алмайды.
Dialogue: 0,0:04:37.31,0:04:39.07,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:04:39.15,0:04:41.94,Default,,0,0,0,,Менің Джанго әрқашан менімен араласады...
Dialogue: 0,0:04:42.28,0:04:43.61,Default,,0,0,0,,Мен оны жарып жіберемін
Dialogue: 0,0:04:45.57,0:04:48.12,Default,,0,0,0,,Үшінші ойын Бірінші шайқас
Dialogue: 0,0:04:48.53,0:04:50.16,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:04:50.54,0:04:53.58,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:53.83,0:04:56.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:56.17,0:04:57.17,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:04:59.79,0:05:01.88,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:05:07.89,0:05:11.31,Default,,0,0,0,,Роллер қорғанысы Сіз Валкириді жаулап жатырсыз.
Dialogue: 0,0:05:11.47,0:05:13.60,Default,,0,0,0,,Мәселе осы жерден басталады.
Dialogue: 0,0:05:13.68,0:05:16.23,Default,,0,0,0,,Валькирияның байланған қабаты - әдет
Dialogue: 0,0:05:16.48,0:05:19.61,Default,,0,0,0,,Мен бара аламын! Оны жай ғана ұшырып жіберіңіз!
Dialogue: 0,0:05:25.99,0:05:27.74,Default,,0,0,0,,Жақсы! Міне!
Dialogue: 0,0:05:28.24,0:05:31.33,Default,,0,0,0,,Құдай Валькирия Қатты шабуыл!
Dialogue: 0,0:05:31.99,0:05:35.04,Default,,0,0,0,,Қарасам, қимылы өткен жолғыдан өзгеше.
Dialogue: 0,0:05:35.12,0:05:37.33,Default,,0,0,0,,Бұл жақтауды алып тастаудың әсері ме?
Dialogue: 0,0:05:41.34,0:05:43.59,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:05:48.55,0:05:50.76,Default,,0,0,0,,Құдай Валькири аяқталды
Dialogue: 0,0:05:51.05,0:05:52.89,Default,,0,0,0,,BC Sol үшін 1 ұпай
Dialogue: 0,0:05:52.97,0:05:54.89,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:05:55.35,0:05:56.14,Default,,0,0,0,,Тс!
Dialogue: 0,0:05:56.23,0:05:58.27,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:58.60,0:06:01.77,Default,,0,0,0,,BC Соль бірінші шайқаста жеңіске жетті!
Dialogue: 0,0:06:01.86,0:06:03.27,Default,,0,0,0,,Балт Аоидың сәтті алға жылжуы!
Dialogue: 0,0:06:03.65,0:06:07.24,Default,,0,0,0,,Жарайсың Балто, жақтауды алып тастағанда керемет!
Dialogue: 0,0:06:08.36,0:06:11.12,Default,,0,0,0,,Әй, сәл бақыттырақ көрін.
Dialogue: 0,0:06:11.37,0:06:12.99,Default,,0,0,0,,Жеңіс қызық, солай ма?
Dialogue: 0,0:06:13.16,0:06:15.75,Default,,0,0,0,,Мен оған қызық деп үміттенемін
Dialogue: 0,0:06:18.04,0:06:21.58,Default,,0,0,0,,Жарайсың Валькирия, мен екінші шайқасты асыға күтемін.
Dialogue: 0,0:06:22.09,0:06:23.46,Default,,0,0,0,,Аники керемет
Dialogue: 0,0:06:23.54,0:06:25.42,Default,,0,0,0,,Бұлай артқа тартпа!
Dialogue: 0,0:06:26.01,0:06:28.38,Default,,0,0,0,,Бұл бізде де маңызды.
Dialogue: 0,0:06:28.93,0:06:31.68,Default,,0,0,0,,Жаңадан келгендерге олардың қаншалықты жақсы екенін көрсете алмаймын.
Dialogue: 0,0:06:31.97,0:06:32.93,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:06:33.35,0:06:36.10,Default,,0,0,0,,Менің ойымша, бұл Cisco-ның соңы емес...
Dialogue: 0,0:06:36.60,0:06:39.69,Default,,0,0,0,,Әйтпесе, бұл иесі де оны барламас еді.
Dialogue: 0,0:06:40.35,0:06:42.06,Default,,0,0,0,,Cisco деп аталатын Blader
Dialogue: 0,0:06:42.27,0:06:44.82,Default,,0,0,0,,Сіз әлі байыпты болмаған сияқтысыз...
Dialogue: 0,0:06:44.98,0:06:46.65,Default,,0,0,0,,CRT шеберханасының жартылай жұмысшысы…
Dialogue: 0,0:06:47.28,0:06:49.90,Default,,0,0,0,,Менің ойымша, сіз Аои Бартоны сынап жатырсыз.
Dialogue: 0,0:06:50.74,0:06:51.78,Default,,0,0,0,,Cisco
Dialogue: 0,0:06:55.33,0:06:56.33,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:06:56.41,0:06:57.83,Default,,0,0,0,,Бұл қандай көздер?
Dialogue: 0,0:06:57.95,0:07:00.12,Default,,0,0,0,,Бірақ сіз әйтеуір күліп тұрған жоқсыз ба?
Dialogue: 0,0:07:00.21,0:07:01.04,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:07:05.25,0:07:06.38,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:07:08.84,0:07:11.34,Default,,0,0,0,,Мен қазір өзімді жақсы сезінемін.
Dialogue: 0,0:07:12.89,0:07:17.06,Default,,0,0,0,,Бірте-бірте Балто Аои деген кісіні жаншып алғым келді.
Dialogue: 0,0:07:17.64,0:07:19.02,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:19.27,0:07:21.27,Default,,0,0,0,,Мен байқап көрейін деп жатырмын.
Dialogue: 0,0:07:21.89,0:07:23.44,Default,,0,0,0,,Шұңқыр ретінде
Dialogue: 0,0:07:23.81,0:07:25.27,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:07:25.36,0:07:28.15,Default,,0,0,0,,Бұл осы уақытқа дейін жарыс болмағанын білдіре ме?
Dialogue: 0,0:07:31.49,0:07:33.07,Default,,0,0,0,,Сіз тұтқаны алып тастадыңыз ба?
Dialogue: 0,0:07:36.08,0:07:36.99,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:07:39.45,0:07:41.96,Default,,0,0,0,,Мен іске қосқышты сол жаққа ауыстырдым.
Dialogue: 0,0:07:42.25,0:07:43.33,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:07:43.71,0:07:45.79,Default,,0,0,0,,Тіпті сол жақпен де соға аласыз ба?
Dialogue: 0,0:07:46.38,0:07:49.63,Default,,0,0,0,,Осы уақытқа дейін шпательмен тексеру мәселесі болды.
Dialogue: 0,0:07:49.84,0:07:51.26,Default,,0,0,0,,Мия мама!
Dialogue: 0,0:07:51.34,0:07:53.93,Default,,0,0,0,,Cisco екінші шайқасты сол қолымен ойнайды!
Dialogue: 0,0:07:54.01,0:07:57.81,Default,,0,0,0,,Оның оң қолмен соғудан айырмашылығы неде? Мұны ешкім күтпеген!
Dialogue: 0,0:07:58.22,0:08:00.39,Default,,0,0,0,,Ақыры шынымды айттым.
Dialogue: 0,0:08:00.48,0:08:04.40,Default,,0,0,0,,Бұл сіз Барто Аоиды шындап айтатын адам ретінде қабылдайтыныңызды білдіре ме?
Dialogue: 0,0:08:04.56,0:08:06.19,Default,,0,0,0,,Мойындамаңыз
Dialogue: 0,0:08:06.27,0:08:10.03,Default,,0,0,0,,Ол сені енді ешқашан Бейде ойнағың келмейтіндей етуді қалайды.
Dialogue: 0,0:08:10.49,0:08:12.03,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:08:12.53,0:08:13.36,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:13.57,0:08:14.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:15.45,0:08:16.78,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:08:16.87,0:08:19.16,Default,,0,0,0,,Сіз шынымен солақайсыз, солай емес пе, Cisco?
Dialogue: 0,0:08:19.24,0:08:21.91,Default,,0,0,0,,Мен нағыз сенімен күресе аламын!
Dialogue: 0,0:08:22.37,0:08:24.33,Default,,0,0,0,,Шынымен, шынымен шулы.
Dialogue: 0,0:08:24.71,0:08:26.33,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:08:26.71,0:08:29.88,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:30.09,0:08:32.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:33.88,0:08:36.34,Default,,0,0,0,,Енді назар аударарлық екінші шайқас
Dialogue: 0,0:08:36.43,0:08:40.47,Default,,0,0,0,,Ұпайларды кім алады: BC Sol немесе Real Sambat?
Dialogue: 0,0:08:43.73,0:08:47.44,Default,,0,0,0,,Өйткені сол жақпен соққанда қуат айырмашылығы бар.
Dialogue: 0,0:08:47.73,0:08:50.69,Default,,0,0,0,,Бұл сіздің қорғаныс күшіңізді арттырады.
Dialogue: 0,0:08:50.82,0:08:54.28,Default,,0,0,0,,Crys Satan-да ең жақсысын шығара аласыз деп үміттенемін.
Dialogue: 0,0:08:58.62,0:09:01.54,Default,,0,0,0,,Жақсы! Жабайы жүр, жабайы жүр, Валькири!
Dialogue: 0,0:09:05.41,0:09:08.96,Default,,0,0,0,,Каа! Шайтан айқайлады!
Dialogue: 0,0:09:09.04,0:09:12.63,Default,,0,0,0,,Үздіксіз шабуылдар кезінде де орталықты қорғауды жалғастырады!
Dialogue: 0,0:09:17.68,0:09:20.35,Default,,0,0,0,,Уау! Екеуміз тепе-теңдікті жоғалттық!
Dialogue: 0,0:09:20.64,0:09:21.89,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:09:21.97,0:09:24.14,Default,,0,0,0,,Құдай Валькири құламайды.
Dialogue: 0,0:09:24.23,0:09:25.02,Default,,0,0,0,,Ose!
Dialogue: 0,0:09:29.31,0:09:30.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:31.11,0:09:31.86,Default,,0,0,0,,Хе
Dialogue: 0,0:09:32.19,0:09:34.44,Default,,0,0,0,,Шайтанды бітіріп жібер!
Dialogue: 0,0:09:34.57,0:09:36.57,Default,,0,0,0,,Нағыз Самбатқа 1 ұпай
Dialogue: 0,0:09:36.95,0:09:40.07,Default,,0,0,0,,Екінші шайқаста нағыз самбат жеңді!
Dialogue: 0,0:09:40.37,0:09:43.87,Default,,0,0,0,,Үшінші ойын 1-ге 1! Есеп тең!
Dialogue: 0,0:09:44.37,0:09:45.45,Default,,0,0,0,,Барт…
Dialogue: 0,0:09:45.96,0:09:47.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:47.29,0:09:48.67,Default,,0,0,0,,Аники~
Dialogue: 0,0:09:48.75,0:09:50.88,Default,,0,0,0,,Бұл жақсы жекпе-жек болды.
Dialogue: 0,0:09:51.46,0:09:53.46,Default,,0,0,0,,Міне, мынандай нәрсе.
Dialogue: 0,0:09:53.63,0:09:55.80,Default,,0,0,0,,Енді не болады? Cisco
Dialogue: 0,0:09:56.13,0:09:56.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:57.34,0:09:59.80,Default,,0,0,0,,Барлық импульс қайда кетті?
Dialogue: 0,0:10:01.01,0:10:03.47,Default,,0,0,0,,Неліктен? жылдамдығы арта түсті
Dialogue: 0,0:10:03.85,0:10:06.31,Default,,0,0,0,,Тіпті байланған шабуыл да тамаша болды.
Dialogue: 0,0:10:07.64,0:10:08.64,Default,,0,0,0,,Үшінші шайқас!
Dialogue: 0,0:10:09.98,0:10:11.15,Default,,0,0,0,,Дайын бол
Dialogue: 0,0:10:15.32,0:10:18.28,Default,,0,0,0,,Балто Келесі шайқастың уақыты келді! Түсіндің бе!
Dialogue: 0,0:10:18.90,0:10:21.20,Default,,0,0,0,,Келесі жолы міндетті түрде жеңілмеймін
Dialogue: 0,0:10:21.41,0:10:24.62,Default,,0,0,0,,Рамканы алу жылдамдығына ғана сенбеңіз.
Dialogue: 0,0:10:25.24,0:10:27.25,Default,,0,0,0,,Мен өзімді... Қолдарымды ойлауым керек.
Dialogue: 0,0:10:29.54,0:10:32.88,Default,,0,0,0,,Дұрыс, Cry Satan қорғаныс түрі.
Dialogue: 0,0:10:33.29,0:10:37.55,Default,,0,0,0,,Егер Crys Satan ортаға бірінші кірсе, ол бұрынғыдай болады.
Dialogue: 0,0:10:37.97,0:10:41.93,Default,,0,0,0,,Ондай жағдайда Валькири бірінші болып ортаға отырады.
Dialogue: 0,0:10:45.39,0:10:47.02,Default,,0,0,0,,Сіз бұрын пайда болдыңыз.
Dialogue: 0,0:10:47.10,0:10:48.48,Default,,0,0,0,,Сізде идея болды ма?
Dialogue: 0,0:10:48.89,0:10:50.44,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:10:50.77,0:10:53.90,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:56.07,0:10:59.20,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:59.99,0:11:03.45,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:05.49,0:11:07.24,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:10.71,0:11:11.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:12.08,0:11:14.04,Default,,0,0,0,,Үшінші шайқас басталады!
Dialogue: 0,0:11:14.13,0:11:16.34,Default,,0,0,0,,Валькири оқ атты, бірақ...
Dialogue: 0,0:11:16.42,0:11:19.09,Default,,0,0,0,,Сыртқа қара, Шайтанды ұрма!
Dialogue: 0,0:11:19.51,0:11:20.88,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:21.22,0:11:22.84,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:11:22.93,0:11:25.76,Default,,0,0,0,,Бұл жаман болып шықты.
Dialogue: 0,0:11:25.85,0:11:29.10,Default,,0,0,0,,Бұл ашылып, ашылатын қазына сандығы сияқты нәрсе ме?
Dialogue: 0,0:11:29.52,0:11:30.98,Default,,0,0,0,,Не, Балто?
Dialogue: 0,0:11:31.06,0:11:33.85,Default,,0,0,0,,Мен басыңды қолданасың деп ойладым, бұл сирек.
Dialogue: 0,0:11:33.98,0:11:35.73,Default,,0,0,0,,Бұл әдеттегіден еш айырмашылығы жоқ.
Dialogue: 0,0:11:40.15,0:11:42.57,Default,,0,0,0,,Бірінші хабарласыңыз!
Dialogue: 0,0:11:42.66,0:11:45.57,Default,,0,0,0,,Crys Шайтан орталық Құдай Валькириге барады...
Dialogue: 0,0:11:45.66,0:11:49.62,Default,,0,0,0,,Не? Апыр-ай! Қабырғаға соғылып жатқанда айнала айналады.
Dialogue: 0,0:11:49.70,0:11:51.54,Default,,0,0,0,,Не болды, Валькири?
Dialogue: 0,0:11:51.62,0:11:53.62,Default,,0,0,0,,Ештеңе істей алмаймыз.
Dialogue: 0,0:11:54.29,0:11:57.34,Default,,0,0,0,,Теме Теменің биін түсінгендей болды...
Dialogue: 0,0:11:57.42,0:11:58.25,Default,,0,0,0,,Осымен
Dialogue: 0,0:11:58.59,0:11:59.88,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:11:59.96,0:12:02.17,Default,,0,0,0,,Валькириге қарсы шабуыл
Dialogue: 0,0:12:02.47,0:12:03.76,Default,,0,0,0,,Жүр!
Dialogue: 0,0:12:16.73,0:12:19.23,Default,,0,0,0,,Валькиридің қуаты таусылды...
Dialogue: 0,0:12:19.32,0:12:22.65,Default,,0,0,0,,Ортадағы Crys Satan-ның жауы болма!
Dialogue: 0,0:12:23.32,0:12:25.53,Default,,0,0,0,,Жоғалтпа, Валькири!
Dialogue: 0,0:12:29.45,0:12:31.29,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:12:31.45,0:12:34.37,Default,,0,0,0,,Сәлем! Шайтанды құрт!
Dialogue: 0,0:12:40.88,0:12:42.51,Default,,0,0,0,,(Шайтанның айқайы)
Dialogue: 0,0:12:50.56,0:12:51.56,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:12:52.02,0:12:54.44,Default,,0,0,0,,Crys Satan Burst Finish
Dialogue: 0,0:12:54.64,0:12:58.36,Default,,0,0,0,,Реал Самбат үшінші ойында 3-1 есебімен жеңіске жетті!
Dialogue: 0,0:12:58.98,0:13:01.82,Default,,0,0,0,,Енді ағымдағы ойын саны-
Dialogue: 0,0:13:02.03,0:13:06.11,Default,,0,0,0,,BC Sol 1 ойын Реал Самбат 2 ойын
Dialogue: 0,0:13:06.20,0:13:09.62,Default,,0,0,0,,Енді Реал Самбат келесі ойынды шешсе жеңеді.
Dialogue: 0,0:13:10.16,0:13:11.62,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:13:11.70,0:13:14.21,Default,,0,0,0,,Қарасам, жаншылды.
Dialogue: 0,0:13:16.46,0:13:18.46,Default,,0,0,0,,Аники жеңілді
Dialogue: 0,0:13:18.67,0:13:20.84,Default,,0,0,0,,А, бұл жиіркенішті!
Dialogue: 0,0:13:21.21,0:13:22.59,Default,,0,0,0,,Тыныс жоқ.
Dialogue: 0,0:13:22.88,0:13:25.13,Default,,0,0,0,,Меншік иелері де жауапты, солай ма?
Dialogue: 0,0:13:25.30,0:13:28.14,Default,,0,0,0,,Аздап жеңіліп, дөрекілік танытқан дұрыс.
Dialogue: 0,0:13:28.72,0:13:31.35,Default,,0,0,0,,Кумичо Тегін Кешіріңіз
Dialogue: 0,0:13:32.14,0:13:33.22,Default,,0,0,0,,Барт…
Dialogue: 0,0:13:33.31,0:13:34.77,Default,,0,0,0,,Жеңілсең де қызық па?
Dialogue: 0,0:13:35.14,0:13:37.14,Default,,0,0,0,,Бұл қызық болуы мүмкін емес!
Dialogue: 0,0:13:37.23,0:13:38.15,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:13:38.23,0:13:41.61,Default,,0,0,0,,Ей, сен Уакия болғаныңда жақтауды алып тастау арқылы жеңетін едің ғой?
Dialogue: 0,0:13:41.82,0:13:43.61,Default,,0,0,0,,Неліктен бұл жолы жұмыс істемеді?
Dialogue: 0,0:13:44.07,0:13:46.07,Default,,0,0,0,,Ол атап өткендей.
Dialogue: 0,0:13:46.57,0:13:49.24,Default,,0,0,0,,Жақтауды алу «жарықтандыру» дегенді білдіреді
Dialogue: 0,0:13:49.91,0:13:53.08,Default,,0,0,0,,Жылдамдық артады, бірақ шабуыл күші сәйкесінше төмендейді.
Dialogue: 0,0:13:53.87,0:13:56.33,Default,,0,0,0,,Себебі ол солақай соққыға ұқсайды...
Dialogue: 0,0:13:56.46,0:13:59.46,Default,,0,0,0,,Көбірек күш бар, өйткені сіз басым қолыңызбен соғыңыз.
Dialogue: 0,0:14:00.04,0:14:02.80,Default,,0,0,0,,Мүмкін бұл Valkyrie шабуылының түрі болуы мүмкін.
Dialogue: 0,0:14:02.88,0:14:05.26,Default,,0,0,0,,Сіз басынан бастап орталықты алуға тырыстыңыз ба?
Dialogue: 0,0:14:05.34,0:14:08.76,Default,,0,0,0,,Сіз Валькиридің күшті жақтарын пайдалана алмайсыз деп ойламайсыз ба?
Dialogue: 0,0:14:09.72,0:14:13.14,Default,,0,0,0,,Мен бұл жігіт туралы әлі ештеңе білмеймін.
Dialogue: 0,0:14:13.39,0:14:15.52,Default,,0,0,0,,Маған жақсырақ бақылау керек
Dialogue: 0,0:14:15.60,0:14:17.39,Default,,0,0,0,,Мен Cisco-ны да, сізді де жеңе алмаймын.
Dialogue: 0,0:14:18.60,0:14:20.90,Default,,0,0,0,,Жақтауды алу қаупі бар.
Dialogue: 0,0:14:21.11,0:14:22.90,Default,,0,0,0,,Тактика кеңейіп жатыр, бірақ
Dialogue: 0,0:14:22.98,0:14:25.48,Default,,0,0,0,,Бұдан былай қарсыласыңызға мұқият қарап, шешім қабылдаңыз.
Dialogue: 0,0:14:27.11,0:14:28.24,Default,,0,0,0,,​​Қайда бара жатырсың?
Dialogue: 0,0:14:28.32,0:14:29.24,Default,,0,0,0,,Шайқас
Dialogue: 0,0:14:29.32,0:14:30.66,Default,,0,0,0,,Тегін сыйлықтар болады ма?
Dialogue: 0,0:14:30.74,0:14:32.12,Default,,0,0,0,,Ол шығады, бірақ не?
Dialogue: 0,0:14:32.53,0:14:34.45,Default,,0,0,0,,Жоқ. Сәттілік.
Dialogue: 0,0:14:34.54,0:14:35.95,Default,,0,0,0,,Келесі Егер сізді алып кетсе...
Dialogue: 0,0:14:36.50,0:14:37.58,Default,,0,0,0,,алынды?
Dialogue: 0,0:14:39.62,0:14:42.92,Default,,0,0,0,,Мен түсінбеймін. Неге олай ойлайсың?
Dialogue: 0,0:14:45.63,0:14:46.80,Default,,0,0,0,,Ол шықты ма?
Dialogue: 0,0:14:46.88,0:14:48.51,Default,,0,0,0,,Шинучи пайда болады
Dialogue: 0,0:14:48.59,0:14:49.80,Default,,0,0,0,,Ол алады.
Dialogue: 0,0:14:50.01,0:14:52.01,Default,,0,0,0,,Өйткені мен бұл уәдені бердім.
Dialogue: 0,0:14:52.18,0:14:53.72,Default,,0,0,0,,Хона, мен саған қалдырамын.
Dialogue: 0,0:14:54.43,0:14:55.76,Default,,0,0,0,,Енді төртінші ойын
Dialogue: 0,0:14:55.85,0:14:58.89,Default,,0,0,0,,BC Соль – капитан Фри Де Ла Хойя
Dialogue: 0,0:14:59.02,0:15:02.19,Default,,0,0,0,,Cisco Real Sambat бағдарламасында үздіксіз пайда болатын сияқты.
Dialogue: 0,0:15:02.52,0:15:04.52,Default,,0,0,0,,Мен сенімен күресе аламын.
Dialogue: 0,0:15:05.19,0:15:07.61,Default,,0,0,0,,Иә... Сізге ұнайды деп үміттенемін.
Dialogue: 0,0:15:07.94,0:15:09.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:09.11,0:15:12.70,Default,,0,0,0,,Бұл әлемдегі ең күшті сияқты, бірақ мен сізге көрсетейін.
Dialogue: 0,0:15:15.74,0:15:18.20,Default,,0,0,0,,Эй, асығыңыз және оны іске қосу құрылғысына орнатыңыз.
Dialogue: 0,0:15:19.12,0:15:20.46,Default,,0,0,0,,Польнарефф, мен сені жеңе алмаймын.
Dialogue: 0,0:15:20.79,0:15:22.96,Default,,0,0,0,,Не... қолмен айналдырғың келеді?
Dialogue: 0,0:15:23.42,0:15:24.50,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:24.88,0:15:27.55,Default,,0,0,0,,Тегін Де Ла Хойя
Dialogue: 0,0:15:27.63,0:15:29.72,Default,,0,0,0,,Шығанақты қолыңызбен айналдыруды мәлімдеңіз!
Dialogue: 0,0:15:29.80,0:15:31.80,Default,,0,0,0,,Бұған тіпті Cisco таң қалды...
Dialogue: 0,0:15:32.18,0:15:33.26,Default,,0,0,0,,Ол тағы!
Dialogue: 0,0:15:33.39,0:15:35.55,Default,,0,0,0,,Осындай кезде де қолмен айналдырасың ба?
Dialogue: 0,0:15:35.89,0:15:39.39,Default,,0,0,0,,Оның Cisco-ны қалай көретінін көріп тұрсыз, солай ма?
Dialogue: 0,0:15:39.48,0:15:40.31,Default,,0,0,0,,Иә
Dialogue: 0,0:15:40.60,0:15:42.94,Default,,0,0,0,,Мен бұл біраз уақыттан кейін бірінші рет шықты деп ойладым
Dialogue: 0,0:15:43.23,0:15:45.27,Default,,0,0,0,,Ей, нағыз адамдар.
Dialogue: 0,0:15:45.36,0:15:47.19,Default,,0,0,0,,Кешіріңіз, менің бос...
Dialogue: 0,0:15:47.57,0:15:49.94,Default,,0,0,0,,Оны іске қосу құрылғысына орнатыңыз.
Dialogue: 0,0:15:50.44,0:15:51.61,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:15:51.70,0:15:53.95,Default,,0,0,0,,Жолдастық кездесулер және ерекше оқиғалар
Dialogue: 0,0:15:54.53,0:15:55.37,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:15:55.45,0:15:57.03,Default,,0,0,0,,Рахмет, иесі
Dialogue: 0,0:15:57.66,0:16:01.29,Default,,0,0,0,,Мен мұндай шайқаста бірінші рет болып тұрмын. Мен сізге көрсетейін.
Dialogue: 0,0:16:02.25,0:16:03.25,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:03.62,0:16:06.09,Default,,0,0,0,,Төртінші ойын Бірінші шайқас
Dialogue: 0,0:16:06.67,0:16:08.34,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:16:08.71,0:16:11.80,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:11.97,0:16:14.30,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:17.97,0:16:20.35,Default,,0,0,0,,Түсіндім, солға айналдыру?
Dialogue: 0,0:16:20.56,0:16:23.56,Default,,0,0,0,,Төртінші ойын таңғаларлық серпіліспен басталды
Dialogue: 0,0:16:23.64,0:16:27.02,Default,,0,0,0,,Фри Де Ла Хойя пайдаланатын су төгетін фафнир дегеніміз не?
Dialogue: 0,0:16:27.11,0:16:28.61,Default,,0,0,0,,Бұл сағат тіліне қарсы айналатын шығанақ!
Dialogue: 0,0:16:29.36,0:16:31.99,Default,,0,0,0,,Сіз үлкен мәміле жасауға жалқау емессіз бе?
Dialogue: 0,0:16:32.82,0:16:34.53,Default,,0,0,0,,Барлығы осылай дейді.
Dialogue: 0,0:16:34.91,0:16:36.53,Default,,0,0,0,,Жаса, Шайтан жыла!
Dialogue: 0,0:16:40.62,0:16:41.95,Default,,0,0,0,,Бұл басталды.
Dialogue: 0,0:16:42.04,0:16:43.83,Default,,0,0,0,,Тегін көп орын бар!
Dialogue: 0,0:16:47.04,0:16:48.50,Default,,0,0,0,,Нанана!
Dialogue: 0,0:16:48.59,0:16:51.55,Default,,0,0,0,,Дренаж Фафнир өте тұрақсыз болды.
Dialogue: 0,0:16:51.76,0:16:54.93,Default,,0,0,0,,Crys Satan-мен соқтығысқан сайын айналу күші артады!
Dialogue: 0,0:16:55.01,0:16:58.55,Default,,0,0,0,,Ал Крисатанның күші анық төмендеді.
Dialogue: 0,0:16:58.93,0:17:01.10,Default,,0,0,0,,Ақымақ... Бұл не?
Dialogue: 0,0:17:03.06,0:17:04.73,Default,,0,0,0,,Бар, Фафнир!
Dialogue: 0,0:17:04.89,0:17:06.06,Default,,0,0,0,,Шешілді.
Dialogue: 0,0:17:08.36,0:17:10.11,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:17:10.44,0:17:11.32,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:17:11.40,0:17:15.11,Default,,0,0,0,,Қараңызшы, Фафнир барған сайын күшке ие болып келеді.
Dialogue: 0,0:17:15.61,0:17:18.49,Default,,0,0,0,,Мынадай шығанақ... Мен күте алмаймын!
Dialogue: 0,0:17:19.37,0:17:21.54,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:17:23.79,0:17:25.62,Default,,0,0,0,,Сорлайық! Шайтан!
Dialogue: 0,0:17:32.17,0:17:33.51,Default,,0,0,0,,(Шайтанның айқайы)
Dialogue: 0,0:17:33.96,0:17:35.26,Default,,0,0,0,,Бітті.
Dialogue: 0,0:17:40.43,0:17:41.97,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:17:43.81,0:17:44.89,Default,,0,0,0,,(Шығанақтың соғу дыбысы)
Dialogue: 0,0:17:49.31,0:17:51.23,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:17:58.70,0:18:01.20,Default,,0,0,0,,Ағызу Fafnir Burst Finish
Dialogue: 0,0:18:01.45,0:18:04.75,Default,,0,0,0,,Төртінші ойын BC Сол үшін 2:0 есебімен жеңіске жетті.
Dialogue: 0,0:18:05.25,0:18:07.04,Default,,0,0,0,,BC Соль қудалау
Dialogue: 0,0:18:07.16,0:18:09.83,Default,,0,0,0,,Төртінші ойын BC Sol~
Dialogue: 0,0:18:09.92,0:18:12.13,Default,,0,0,0,,Енді ойын саны 2-ден 2-ге дейін.
Dialogue: 0,0:18:12.21,0:18:15.55,Default,,0,0,0,,Келесі бесінші ойынға қорытынды шығарылды.
Dialogue: 0,0:18:15.88,0:18:17.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:17.63,0:18:19.72,Default,,0,0,0,,Ия, бұл тегін.
Dialogue: 0,0:18:20.01,0:18:21.55,Default,,0,0,0,,Канрокудана
Dialogue: 0,0:18:21.68,0:18:23.22,Default,,0,0,0,,Мен галстукқа дейін жеттім.
Dialogue: 0,0:18:23.56,0:18:25.97,Default,,0,0,0,,Керемет! Мен жарылуды шештім
Dialogue: 0,0:18:26.06,0:18:28.64,Default,,0,0,0,,Бұл өте баяу атумен шектен тыс.
Dialogue: 0,0:18:28.73,0:18:30.19,Default,,0,0,0,,Еркін және Фафнир
Dialogue: 0,0:18:30.69,0:18:32.56,Default,,0,0,0,,Бұл қызық болды
Dialogue: 0,0:18:32.82,0:18:33.98,Default,,0,0,0,,Не!
Dialogue: 0,0:18:34.32,0:18:36.99,Default,,0,0,0,,Сіз де, солай ма? Жеңіске жету жақсы
Dialogue: 0,0:18:37.24,0:18:39.99,Default,,0,0,0,,Аои Балтты жеңгенде солай болды ғой, солай ма?
Dialogue: 0,0:18:40.20,0:18:41.49,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:18:42.12,0:18:44.41,Default,,0,0,0,,Мен де қазір жеңіске жетуді ұнатамын.
Dialogue: 0,0:18:45.45,0:18:46.50,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:18:53.54,0:18:54.63,Default,,0,0,0,,Сол мыңжапырақ
Dialogue: 0,0:18:54.71,0:18:55.80,Default,,0,0,0,,Cisco
Dialogue: 0,0:18:56.80,0:18:58.51,Default,,0,0,0,,Қазіргі шайқас қандай?
Dialogue: 0,0:18:58.97,0:18:59.76,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:00.09,0:19:01.84,Default,,0,0,0,,Мен өз үмітімде қателестім.
Dialogue: 0,0:19:01.93,0:19:05.68,Default,,0,0,0,,Хна шоколадты бидің оны қолдарымен айналдырып жатқаны мені қатты ренжітті.
Dialogue: 0,0:19:05.76,0:19:08.23,Default,,0,0,0,,Сізге барлаудың қажеті жоқ!
Dialogue: 0,0:19:08.85,0:19:10.06,Default,,0,0,0,,Не...
Dialogue: 0,0:19:10.14,0:19:12.06,Default,,0,0,0,,Бұлай айту тым көп, Уакия мырза.
Dialogue: 0,0:19:12.44,0:19:13.98,Default,,0,0,0,,Саған тисе, саған тиеді
Dialogue: 0,0:19:14.69,0:19:17.48,Default,,0,0,0,,Мен бұл команданың әлемдегі ең үздік команда болғанын қалаймын.
Dialogue: 0,0:19:17.73,0:19:19.19,Default,,0,0,0,,Мен сені Сеядан сатып алдым.
Dialogue: 0,0:19:19.65,0:19:22.87,Default,,0,0,0,,Өйткені мен күшті қарым-қатынасқа күмән жоқ деп ойладым.
Dialogue: 0,0:19:22.95,0:19:26.45,Default,,0,0,0,,Ей, келесі жолы жеңілмеймін, әлгі бек.
Dialogue: 0,0:19:26.62,0:19:28.04,Default,,0,0,0,,Келесі жолы кеш болады.
Dialogue: 0,0:19:28.29,0:19:29.96,Default,,0,0,0,,Сіздің міндетіңіз – жеңіске жету.
Dialogue: 0,0:19:30.16,0:19:32.88,Default,,0,0,0,,Мен командамда жеңілген адамның болғанын қаламаймын.
Dialogue: 0,0:19:32.96,0:19:35.29,Default,,0,0,0,,Ондай біреу жеңіліп жатыр.
Dialogue: 0,0:19:35.38,0:19:38.13,Default,,0,0,0,,Мұны қамту үшін төменгі деңгейдің рөлі.
Dialogue: 0,0:19:38.38,0:19:40.01,Default,,0,0,0,,Өзімшіл нәрсе жасаңыз...
Dialogue: 0,0:19:41.97,0:19:43.09,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:19:43.22,0:19:44.60,Default,,0,0,0,,Мен жеңілмеймін
Dialogue: 0,0:19:45.64,0:19:49.52,Default,,0,0,0,,Cisco-ны көргенде, оның артынан тазалауға тура келеді.
Dialogue: 0,0:19:49.77,0:19:52.23,Default,,0,0,0,,BC Sol келесі жолы міндетті түрде бос болады.
Dialogue: 0,0:19:52.31,0:19:54.10,Default,,0,0,0,,Бәс жоғары.
Dialogue: 0,0:19:54.23,0:19:55.73,Default,,0,0,0,,Ол мені жеңді!
Dialogue: 0,0:19:56.98,0:19:59.11,Default,,0,0,0,,Қараңдар, мен жақтауды орнына қойдым.
Dialogue: 0,0:19:59.86,0:20:02.15,Default,,0,0,0,,Валькирияның күші енді аяқталды.
Dialogue: 0,0:20:02.32,0:20:05.66,Default,,0,0,0,,Сонымен, Барто, келесі жолы көрінгіңіз келе ме?
Dialogue: 0,0:20:05.91,0:20:07.08,Default,,0,0,0,,Тарималар
Dialogue: 0,0:20:07.16,0:20:08.49,Default,,0,0,0,,Бұл менің жұмысым емес.
Dialogue: 0,0:20:08.58,0:20:11.54,Default,,0,0,0,,Мен осылай жеңілуді аяқтай аламын ба?
Dialogue: 0,0:20:12.33,0:20:13.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:15.63,0:20:16.96,Default,,0,0,0,,Айтайын дегенім, бұл тегін.
Dialogue: 0,0:20:17.34,0:20:19.50,Default,,0,0,0,,Эй, тағы барасың ба?
Dialogue: 0,0:20:19.63,0:20:22.30,Default,,0,0,0,,Түсіндім, келесі жолы шешілетініне сенімдімін.
Dialogue: 0,0:20:22.42,0:20:23.51,Default,,0,0,0,,Бұл маңызды ойын
Dialogue: 0,0:20:24.30,0:20:25.26,Default,,0,0,0,,Сіз
Dialogue: 0,0:20:26.05,0:20:27.05,Default,,0,0,0,,Мен?
Dialogue: 0,0:20:27.39,0:20:29.14,Default,,0,0,0,,Не? Кумичо?
Dialogue: 0,0:20:29.39,0:20:31.77,Default,,0,0,0,,Мен жасадым, рахмет, Тегін
Dialogue: 0,0:20:31.85,0:20:33.73,Default,,0,0,0,,Бұл өте жаман, Балто.
Dialogue: 0,0:20:33.81,0:20:35.40,Default,,0,0,0,,Не? Мен де...
Dialogue: 0,0:20:35.65,0:20:37.98,Default,,0,0,0,,Сен сол жігіттен жеңіліп қалдың ғой, солай ма?
Dialogue: 0,0:20:40.90,0:20:41.82,Default,,0,0,0,,О
Dialogue: 0,0:20:42.78,0:20:46.07,Default,,0,0,0,,Сол жігіттен тағы жеңілсең, Б.С.Соль, шық.
Dialogue: 0,0:20:47.07,0:20:48.37,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,0:20:50.45,0:20:53.16,Default,,0,0,0,,Бұл тым өзімшіл, мен тіпті иесі емеспін.
Dialogue: 0,0:20:53.66,0:20:54.92,Default,,0,0,0,,Жоқ, маған бәрібір.
Dialogue: 0,0:20:55.21,0:20:56.25,Default,,0,0,0,,Кумичо
Dialogue: 0,0:20:56.63,0:20:57.46,Default,,0,0,0,,Тегін
Dialogue: 0,0:20:57.71,0:21:01.26,Default,,0,0,0,,Жаңа ғана айтқанымды сен екеуміздің арамыздағы жарыс деп ойладым.
Dialogue: 0,0:21:02.46,0:21:03.67,Default,,0,0,0,,Жарыс?
Dialogue: 0,0:21:04.47,0:21:06.47,Default,,0,0,0,,Кеттік, Балто.
Dialogue: 0,0:21:10.97,0:21:12.85,Default,,0,0,0,,Кумичо, жең.
Dialogue: 0,0:21:13.48,0:21:17.27,Default,,0,0,0,,Енді бесінші ойын, BC Sol – Рантаро Кияма.
Dialogue: 0,0:21:17.35,0:21:20.65,Default,,0,0,0,,Нағыз Самбат Вакия Комурасакиге тиесілі!
Dialogue: 0,0:21:20.73,0:21:24.11,Default,,0,0,0,,Ол шешіледі ме? Тағдыр осы екеуіне байланысты!
Dialogue: 0,0:21:24.57,0:21:26.45,Default,,0,0,0,,Неліктен тегін нұсқасы жоқ?
Dialogue: 0,0:21:26.53,0:21:29.74,Default,,0,0,0,,Менің ойымша, бұл «Реалдың» жігіттері үшін жалықтырды.
Dialogue: 0,0:21:30.24,0:21:32.12,Default,,0,0,0,,Вакия Бұл ойын!
Dialogue: 0,0:21:32.49,0:21:35.08,Default,,0,0,0,,Сен неге бос емессің?
Dialogue: 0,0:21:35.54,0:21:37.87,Default,,0,0,0,,Хе! Мен сенің трамплинмін.
Dialogue: 0,0:21:38.25,0:21:41.55,Default,,0,0,0,,Сен ақымақсың ба? Сіз бірінші ойында жеңілдіңіз.
Dialogue: 0,0:21:41.92,0:21:44.46,Default,,0,0,0,,Б.С.Сол бүгінгі матчты лақтырып жіберді ме?
Dialogue: 0,0:21:45.13,0:21:48.34,Default,,0,0,0,,Нәтижеге қарап, лақтырып тастадың ба, жоқ па, айтайын ба?
Dialogue: 0,0:21:48.93,0:21:50.93,Default,,0,0,0,,Мен бұл матчты аламын!
Dialogue: 0,0:21:55.98,0:21:58.40,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.48,0:22:01.98,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:02.07,0:22:04.82,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.90,0:22:06.99,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.07,0:22:10.57,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.66,0:22:14.33,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.41,0:22:16.12,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.20,0:22:17.96,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.04,0:22:19.92,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:20.00,0:22:21.50,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.59,0:22:23.59,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.67,0:22:26.05,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.13,0:22:29.05,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.13,0:22:32.76,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.85,0:22:36.52,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.60,0:22:38.31,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.39,0:22:41.56,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.65,0:22:43.94,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.02,0:22:47.57,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.65,0:22:51.16,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.24,0:22:53.41,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.49,0:22:54.95,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.04,0:22:58.46,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.54,0:23:00.50,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.58,0:23:03.54,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.63,0:23:05.84,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.92,0:23:09.84,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.93,0:23:13.51,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.60,0:23:17.10,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.18,0:23:20.56,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.64,0:23:22.19,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.27,0:23:22.69,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.69,0:23:25.07,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.69,0:23:25.07,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.44,0:23:28.24,Default,,0,0,0,,Дүниемен соғыспас бұрын
Dialogue: 0,0:23:28.32,0:23:31.78,Default,,0,0,0,,Біріншіден, мен өз командамдағы шайқаста жеңіске жетуім керек.
Dialogue: 0,0:23:31.86,0:23:33.70,Default,,0,0,0,,Жоғары топты мақсат етіңіз
Dialogue: 0,0:23:33.78,0:23:36.95,Default,,0,0,0,,Дәл осы кезде алдымызда тағы да Cisco пайда болады!
Dialogue: 0,0:23:37.49,0:23:40.29,Default,,0,0,0,,Бұл менің жұмысым емес. Не айтқың келеді?
Dialogue: 0,0:23:40.50,0:23:42.87,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.00,0:23:45.04,Default,,0,0,0,,Қатты жер сілкінісі! BC Sol!
Dialogue: 0,0:23:45.13,0:23:48.88,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.38,0:23:56.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory