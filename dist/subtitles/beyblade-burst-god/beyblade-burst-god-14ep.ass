Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.25,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.27,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.15,0:00:29.61,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:31.15,0:00:33.61,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:34.53,0:00:37.37,Default,,0,0,0,,Paris Blades-ке қарсы бірінші ойын
Dialogue: 0,0:00:37.74,0:00:41.58,Default,,0,0,0,,Мен Өлтіруші Өлім Сизердің қос соққысынан жеңілдім.
Dialogue: 0,0:00:42.83,0:00:45.50,Default,,0,0,0,,Бірақ Стэн мен Сиско жеңді.
Dialogue: 0,0:00:46.12,0:00:49.04,Default,,0,0,0,,Төртінші ойында мен Динамен тағы да күрестім.
Dialogue: 0,0:00:49.71,0:00:52.13,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:00:55.72,0:00:56.89,Default,,0,0,0,,Ах
Dialogue: 0,0:00:57.55,0:00:58.68,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:59.01,0:01:00.72,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:01:00.81,0:01:02.31,Default,,0,0,0,,(қуаныш дауысы)
Dialogue: 0,0:01:02.39,0:01:05.10,Default,,0,0,0,,Иә! Аники жеңді
Dialogue: 0,0:01:07.19,0:01:08.48,Default,,0,0,0,,(Қорқытатын дыбыс)
Dialogue: 0,0:01:08.56,0:01:10.90,Default,,0,0,0,,А, міне, тағы барамыз!
Dialogue: 0,0:01:12.07,0:01:14.44,Default,,0,0,0,,Маған біреу қарап тұр
Dialogue: 0,0:01:16.86,0:01:18.03,Default,,0,0,0,,Бұл көздер.
Dialogue: 0,0:01:24.79,0:01:29.13,Default,,0,0,0,,Cisco Carlyle Мен сені ешқашан кешірмеймін
Dialogue: 0,0:01:30.42,0:01:33.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:33.09,0:01:35.51,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:35.59,0:01:38.22,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:38.30,0:01:40.35,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:40.43,0:01:43.18,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:43.26,0:01:44.81,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:44.89,0:01:49.10,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:50.06,0:01:54.82,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:54.90,0:01:59.32,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:59.91,0:02:04.49,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:04.74,0:02:09.58,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:09.75,0:02:14.63,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:14.71,0:02:19.55,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:19.63,0:02:23.10,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:23.18,0:02:24.72,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:24.81,0:02:27.06,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:27.14,0:02:29.35,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:29.44,0:02:31.69,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:31.77,0:02:33.15,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:33.23,0:02:34.73,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:34.82,0:02:37.11,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:37.19,0:02:43.45,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:43.53,0:02:47.87,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:47.95,0:02:50.12,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:50.62,0:02:53.00,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:53.08,0:02:55.63,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:55.71,0:02:59.13,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:55.71,0:02:59.13,Default,,0,0,0,,~♪
Dialogue: 0,0:02:59.13,0:03:00.01,Default,,0,0,0,,~♪
Dialogue: 0,0:03:00.97,0:03:04.18,Default,,0,0,0,,Соқ! Максимум Гаруда!
Dialogue: 0,0:03:05.01,0:03:07.60,Default,,0,0,0,,Ihi he he he he he he he he he he ол
Dialogue: 0,0:03:08.18,0:03:11.31,Default,,0,0,0,,Бұл не? Бұл жүз жиіркенішті.
Dialogue: 0,0:03:11.39,0:03:14.27,Default,,0,0,0,,Динаны жеңгеніңізге соншалықты қуаныштысыз ба?
Dialogue: 0,0:03:14.36,0:03:18.69,Default,,0,0,0,,Себебі менің қарсыласым Дина болды, мен Динаны жеңдім.
Dialogue: 0,0:03:19.28,0:03:20.65,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:03:20.74,0:03:23.36,Default,,0,0,0,,Дүниежүзілік лигаға барайық.
Dialogue: 0,0:03:23.45,0:03:26.70,Default,,0,0,0,,Мен Динамен тағы да жарысамын!
Dialogue: 0,0:03:26.78,0:03:28.16,Default,,0,0,0,,Ей, артық етпе.
Dialogue: 0,0:03:28.62,0:03:31.04,Default,,0,0,0,,Біз жеңеміз!
Dialogue: 0,0:03:31.12,0:03:32.92,Default,,0,0,0,,Дәлірек айтсам, дәл біздің астымыздағы теңіз портында…
Dialogue: 0,0:03:33.92,0:03:35.38,Default,,0,0,0,,А... а...
Dialogue: 0,0:03:35.46,0:03:37.21,Default,,0,0,0,,Сенің құлағың сынған жоқ па?
Dialogue: 0,0:03:37.63,0:03:40.05,Default,,0,0,0,,Шынайы ма? Не істеуім керек?
Dialogue: 0,0:03:40.13,0:03:41.80,Default,,0,0,0,,Cisco?
Dialogue: 0,0:03:43.01,0:03:45.39,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:03:46.35,0:03:49.64,Default,,0,0,0,,Бұл көздерді бір жерден көргенім есімде...
Dialogue: 0,0:03:50.77,0:03:53.90,Default,,0,0,0,,Не болды? Осындай салмақты жүзбен
Dialogue: 0,0:03:53.98,0:03:55.23,Default,,0,0,0,,Жаттығу
Dialogue: 0,0:03:55.31,0:03:56.61,Default,,0,0,0,,Шулы, жайына қалдыр
Dialogue: 0,0:03:57.82,0:03:59.69,Default,,0,0,0,,Аники
Dialogue: 0,0:04:00.49,0:04:02.20,Default,,0,0,0,,Аники Міне, осы.
Dialogue: 0,0:04:02.32,0:04:04.99,Default,,0,0,0,,Алдағы Корольдіктердің құпия қаруы
Dialogue: 0,0:04:05.07,0:04:06.62,Default,,0,0,0,,Ғазем Мадар
Dialogue: 0,0:04:07.03,0:04:09.62,Default,,0,0,0,,Қарау… Мада…
Dialogue: 0,0:04:09.70,0:04:11.08,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:11.16,0:04:12.91,Default,,0,0,0,,Ола, көрсетші.
Dialogue: 0,0:04:16.88,0:04:17.92,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:04:18.42,0:04:19.96,Default,,0,0,0,,Ол маған қарап тұр!
Dialogue: 0,0:04:24.01,0:04:26.47,Default,,0,0,0,,Антокидің көзі...?
Dialogue: 0,0:04:26.59,0:04:28.51,Default,,0,0,0,,Не болды, Cisco?
Dialogue: 0,0:04:28.60,0:04:31.10,Default,,0,0,0,,Эй, сен бұл жігіт туралы білесің бе?
Dialogue: 0,0:04:31.18,0:04:32.39,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:04:35.14,0:04:38.19,Default,,0,0,0,,Ах! Мен бұл жігіт туралы өсек естідім.
Dialogue: 0,0:04:38.77,0:04:40.82,Default,,0,0,0,,Мен оның муай-тай боксшысы екеніне сенімдімін.
Dialogue: 0,0:04:41.94,0:04:43.07,Default,,0,0,0,,Муай Тай?
Dialogue: 0,0:04:43.49,0:04:44.53,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,0:04:44.95,0:04:46.49,Default,,0,0,0,,Тай боксы
Dialogue: 0,0:04:46.78,0:04:49.24,Default,,0,0,0,,Бұл жер бетіндегі ең күшті жекпе-жек өнері деп айтылады.
Dialogue: 0,0:04:49.33,0:04:50.58,Default,,0,0,0,,Тея!
Dialogue: 0,0:04:50.66,0:04:53.20,Default,,0,0,0,,Ол матч ойнаған сайын қарсыласын төбелеске жіберетін сияқты.
Dialogue: 0,0:04:53.58,0:04:55.25,Default,,0,0,0,,Джигокуни...?
Dialogue: 0,0:04:55.33,0:04:57.04,Default,,0,0,0,,Мен ол туралы естідім.
Dialogue: 0,0:04:57.13,0:05:00.17,Default,,0,0,0,,Оны джунглидегі аңдар өсірді.
Dialogue: 0,0:05:00.25,0:05:01.92,Default,,0,0,0,,Жүнді ме?
Dialogue: 0,0:05:02.51,0:05:03.92,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:04.47,0:05:05.68,Default,,0,0,0,,Бұл жай ғана өсек.
Dialogue: 0,0:05:05.93,0:05:07.05,Default,,0,0,0,,(дем алу)
Dialogue: 0,0:05:07.68,0:05:10.68,Default,,0,0,0,,Бірақ отсыз түтін болмайды
Dialogue: 0,0:05:11.06,0:05:13.81,Default,,0,0,0,,Сізді не қызықтырады? Мен жаттығып жатырмын.
Dialogue: 0,0:05:14.35,0:05:17.19,Default,,0,0,0,,Біз ертең Дүниежүзілік лигаға өте аламыз ба?
Dialogue: 0,0:05:17.27,0:05:19.69,Default,,0,0,0,,Бұл қауіп төнетін маңызды ойын.
Dialogue: 0,0:05:19.77,0:05:20.82,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:05:21.11,0:05:23.07,Default,,0,0,0,,Не? Бұл дұрыс
Dialogue: 0,0:05:23.15,0:05:24.78,Default,,0,0,0,,Түсінбедің бе?
Dialogue: 0,0:05:25.53,0:05:29.03,Default,,0,0,0,,Барто Аои Сіз ертеңгі капитан боласыз
Dialogue: 0,0:05:29.12,0:05:30.99,Default,,0,0,0,,Не, мен?
Dialogue: 0,0:05:31.20,0:05:32.58,Default,,0,0,0,,Крис ұсынған.
Dialogue: 0,0:05:32.66,0:05:33.54,Default,,0,0,0,,Крис?
Dialogue: 0,0:05:34.33,0:05:35.91,Default,,0,0,0,,Қалың бірақ
Dialogue: 0,0:05:36.00,0:05:39.54,Default,,0,0,0,,Еуропа лигасының соңғы ойыны.
Dialogue: 0,0:05:39.79,0:05:41.71,Default,,0,0,0,,Мен капитанмын ба?
Dialogue: 0,0:05:41.79,0:05:44.05,Default,,0,0,0,,Сен істедің, Балто!
Dialogue: 0,0:05:44.26,0:05:45.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:45.26,0:05:48.18,Default,,0,0,0,,Бұл жігіт капитан ретінде жеңе алады деп ойлайсыз ба?
Dialogue: 0,0:05:48.26,0:05:51.10,Default,,0,0,0,,Мен қалай ойласам да, бұл иесінің шешімі.
Dialogue: 0,0:05:51.64,0:05:53.14,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:05:53.22,0:05:57.02,Default,,0,0,0,,Сізде мүлде деректері жоқ бір адам бар.
Dialogue: 0,0:05:57.31,0:05:58.85,Default,,0,0,0,,Ғазем туралы айтып тұрсың ба?
Dialogue: 0,0:05:59.19,0:06:02.36,Default,,0,0,0,,Мүмкін Cisco компаниясы Газем туралы білетін шығар?
Dialogue: 0,0:06:02.86,0:06:03.86,Default,,0,0,0,,Хун
Dialogue: 0,0:06:04.15,0:06:05.65,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:06:06.78,0:06:08.65,Default,,0,0,0,,Эй, бірдеңе айт.
Dialogue: 0,0:06:08.86,0:06:10.87,Default,,0,0,0,,Өте шулы
Dialogue: 0,0:06:10.95,0:06:13.66,Default,,0,0,0,,Менің айтайын дегенім, егер сіз Дүниежүзілік лигаға барғыңыз келсе...
Dialogue: 0,0:06:13.74,0:06:15.87,Default,,0,0,0,,Маған қалаған нәрсені істеуге рұқсат етіңіз.
Dialogue: 0,0:06:16.50,0:06:18.66,Default,,0,0,0,,Мен капитан болсам дұрыс па?
Dialogue: 0,0:06:19.29,0:06:21.38,Default,,0,0,0,,Қарсыласыңыздың сынына ұшырай бересіз, солай емес пе?
Dialogue: 0,0:06:23.13,0:06:26.01,Default,,0,0,0,,Егер мен, эйс, барлық ойындарды жеңсем...
Dialogue: 0,0:06:26.09,0:06:29.59,Default,,0,0,0,,Капитанның қандай ақымақ екені маңызды емес.
Dialogue: 0,0:06:29.68,0:06:31.89,Default,,0,0,0,,Кууууууууу!
Dialogue: 0,0:06:31.97,0:06:35.56,Default,,0,0,0,,Күте тұрыңыз, Cisco! Мен ебедейсіз капитан емеспін
Dialogue: 0,0:06:35.64,0:06:37.02,Default,,0,0,0,,Балто!
Dialogue: 0,0:06:37.10,0:06:39.19,Default,,0,0,0,,Бұл екеуіне көмектесуге болмайды.
Dialogue: 0,0:06:39.98,0:06:43.27,Default,,0,0,0,,Дәстүрлі BC Соль осындай адамдармен қоршалған...
Dialogue: 0,0:06:43.82,0:06:44.98,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:06:49.49,0:06:50.70,Default,,0,0,0,,Cisco?
Dialogue: 0,0:06:50.99,0:06:54.99,Default,,0,0,0,,Иә, оның бұл Блейдермен қандай да бір байланысы бар сияқты.
Dialogue: 0,0:06:56.37,0:06:58.12,Default,,0,0,0,,Ғазем Мадар
Dialogue: 0,0:06:58.20,0:07:00.46,Default,,0,0,0,,Бұл корольдіктердің құпия қаруы деп айтылады.
Dialogue: 0,0:07:00.96,0:07:04.42,Default,,0,0,0,,Ол әлі матчқа қатыспағандықтан, оның мансабы да, шайқас тарихы да белгісіз.
Dialogue: 0,0:07:05.00,0:07:06.63,Default,,0,0,0,,Мен тіпті ойын мәнерін де білмеймін.
Dialogue: 0,0:07:07.26,0:07:08.17,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:08.55,0:07:11.22,Default,,0,0,0,,Өйткені, капитандық қызметті Cisco-ға берген дұрыс болар еді.
Dialogue: 0,0:07:12.09,0:07:15.51,Default,,0,0,0,,Жоқ. Егер солай болса, мен Балтонды көбірек көргім келеді.
Dialogue: 0,0:07:15.60,0:07:16.68,Default,,0,0,0,,Крис!
Dialogue: 0,0:07:17.01,0:07:18.93,Default,,0,0,0,,Ертеңгі басты адам - ​​Балто.
Dialogue: 0,0:07:19.39,0:07:21.69,Default,,0,0,0,,Балто сізді ыстық етіп көрсететіні сөзсіз.
Dialogue: 0,0:07:22.02,0:07:23.40,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:07:23.65,0:07:25.11,Default,,0,0,0,,Бұл қауіпті шелпек.
Dialogue: 0,0:07:25.40,0:07:28.86,Default,,0,0,0,,Жарайды! Торт деген осы емес пе?
Dialogue: 0,0:07:30.78,0:07:32.03,Default,,0,0,0,,(Тред күрсініс)
Dialogue: 0,0:07:39.16,0:07:40.83,Default,,0,0,0,,Газем...
Dialogue: 0,0:07:43.83,0:07:45.63,Default,,0,0,0,,Маған неге қарадың?
Dialogue: 0,0:07:46.75,0:07:47.75,Default,,0,0,0,,Иә
Dialogue: 0,0:07:51.51,0:07:54.34,Default,,0,0,0,,Бұл қайда кетті?
Dialogue: 0,0:07:55.14,0:07:56.60,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:07:56.68,0:07:59.72,Default,,0,0,0,,О, Cisco!
Dialogue: 0,0:07:59.81,0:08:00.85,Default,,0,0,0,,Тыныш бол!
Dialogue: 0,0:08:00.93,0:08:01.98,Default,,0,0,0,,Қатынасты үзу ме? Қатынасты үзу... Хе-хе-хе-хе.
Dialogue: 0,0:08:08.77,0:08:10.44,Default,,0,0,0,,А... анау жігіт!
Dialogue: 0,0:08:11.69,0:08:13.99,Default,,0,0,0,,Ол Ғазем, солай ма?
Dialogue: 0,0:08:34.05,0:08:35.38,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:08:36.47,0:08:37.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:38.14,0:08:39.10,Default,,0,0,0,,Иә
Dialogue: 0,0:08:40.93,0:08:44.31,Default,,0,0,0,,Маған секірген сенсің.
Dialogue: 0,0:08:45.31,0:08:46.73,Default,,0,0,0,,Маған неге қарадың?
Dialogue: 0,0:08:46.81,0:08:49.23,Default,,0,0,0,,Сен мені ұмыттың ба?
Dialogue: 0,0:08:49.61,0:08:51.78,Default,,0,0,0,,Ой, есімде жоқ.
Dialogue: 0,0:08:52.03,0:08:54.03,Default,,0,0,0,,Таиландтағы Санктуар клубы
Dialogue: 0,0:08:54.82,0:08:57.28,Default,,0,0,0,,Сондықтан мен саған есіңе түсірме дедім.
Dialogue: 0,0:08:57.57,0:09:00.70,Default,,0,0,0,,Мен әлемнің түкпір-түкпірінен келген пышақтармен айналыстым.
Dialogue: 0,0:09:00.79,0:09:02.87,Default,,0,0,0,,Қанша жұлдыз болса, сонша жұлдыз бар.
Dialogue: 0,0:09:03.29,0:09:05.79,Default,,0,0,0,,Жұлдыз тозаңындай шашылды бәрі
Dialogue: 0,0:09:06.37,0:09:09.75,Default,,0,0,0,,Ааа, сен де солардың бірі сияқтысың.
Dialogue: 0,0:09:10.75,0:09:11.84,Default,,0,0,0,,Тея!
Dialogue: 0,0:09:15.59,0:09:17.13,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:09:23.77,0:09:25.06,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:09:25.52,0:09:28.15,Default,,0,0,0,,Иә, сол кездегі шығанақ?
Dialogue: 0,0:09:28.23,0:09:30.27,Default,,0,0,0,,Барған сайын көгеріп барады.
Dialogue: 0,0:09:30.90,0:09:31.90,Default,,0,0,0,,Газем
Dialogue: 0,0:09:34.49,0:09:38.57,Default,,0,0,0,,Кездесу уақыты келді. Жаттығуларыңызды соған қалдырайық.
Dialogue: 0,0:09:39.37,0:09:42.37,Default,,0,0,0,,Корольдік ойыншы Артур Лоуренс?
Dialogue: 0,0:09:43.08,0:09:44.79,Default,,0,0,0,,Cisco Carlyle.
Dialogue: 0,0:09:45.50,0:09:49.54,Default,,0,0,0,,Сен де... Бір клубта екенімізге сенімдімін...
Dialogue: 0,0:09:49.75,0:09:52.42,Default,,0,0,0,,Бұл Барто Аои. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:09:52.96,0:09:55.17,Default,,0,0,0,,BC Sol нені белгілеу керек
Dialogue: 0,0:09:55.26,0:09:56.80,Default,,0,0,0,,Тек Cisco
Dialogue: 0,0:09:57.09,0:09:59.09,Default,,0,0,0,,Ал, мен оны есімде сақтаймын.
Dialogue: 0,0:09:59.18,0:10:00.26,Default,,0,0,0,,Ng!
Dialogue: 0,0:10:00.47,0:10:03.31,Default,,0,0,0,,Ал, менің кездесуім бар, кешіріңіз.
Dialogue: 0,0:10:04.18,0:10:05.27,Default,,0,0,0,,Кеттік, Ғазем
Dialogue: 0,0:10:05.47,0:10:06.31,Default,,0,0,0,,Құт
Dialogue: 0,0:10:11.65,0:10:14.07,Default,,0,0,0,,Ол Ғаземді білетін шығар.
Dialogue: 0,0:10:14.61,0:10:17.99,Default,,0,0,0,,Бұл дұрыс емес, олар мұны өз бетінше есте сақтайды.
Dialogue: 0,0:10:18.07,0:10:20.24,Default,,0,0,0,,Бірақ бұл сынған шығанақ
Dialogue: 0,0:10:20.49,0:10:22.37,Default,,0,0,0,,Оның Cisco-ға қатысы бар ма?
Dialogue: 0,0:10:22.95,0:10:25.95,Default,,0,0,0,,Дұрыс па? Эй, не болды!
Dialogue: 0,0:10:26.16,0:10:28.46,Default,,0,0,0,,Tsk, бұл тітіркендіргіш.
Dialogue: 0,0:10:33.09,0:10:35.46,Default,,0,0,0,,Доджоны бұзып жатқан кезім
Dialogue: 0,0:10:36.17,0:10:37.80,Default,,0,0,0,,Доджоны бұзу?
Dialogue: 0,0:10:38.92,0:10:41.84,Default,,0,0,0,,Солардың бірі сол жігіт болатын.
Dialogue: 0,0:10:44.72,0:10:45.85,Default,,0,0,0,,(Шығанақтың соғу дыбысы)
Dialogue: 0,0:10:45.93,0:10:47.64,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:10:50.60,0:10:53.61,Default,,0,0,0,,Хе! Олар жай ғана әлсіз жігіттер.
Dialogue: 0,0:11:00.11,0:11:01.70,Default,,0,0,0,,Ах! Ах
Dialogue: 0,0:11:02.07,0:11:05.58,Default,,0,0,0,,Қандай жігіт, тіпті капитан жеңе алмайды?
Dialogue: 0,0:11:06.12,0:11:08.25,Default,,0,0,0,,Қандай сұмдық команда.
Dialogue: 0,0:11:08.45,0:11:10.67,Default,,0,0,0,,Ей, бұл босқа уақыт болды.
Dialogue: 0,0:11:10.96,0:11:12.29,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:13.46,0:11:14.75,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:11:15.09,0:11:16.09,Default,,0,0,0,,Иә
Dialogue: 0,0:11:32.73,0:11:33.94,Default,,0,0,0,,Ғазем
Dialogue: 0,0:11:34.02,0:11:36.02,Default,,0,0,0,,Бұл сіз жеңе алатын адам емес.
Dialogue: 0,0:11:36.11,0:11:38.32,Default,,0,0,0,,Сіз Bay ойынын енді бастадыңыз!
Dialogue: 0,0:11:38.90,0:11:40.19,Default,,0,0,0,,Газем…
Dialogue: 0,0:11:41.03,0:11:42.36,Default,,0,0,0,,Мына жігітпен күрес
Dialogue: 0,0:11:43.53,0:11:45.70,Default,,0,0,0,,Не? Сол ескі шығанақ
Dialogue: 0,0:11:46.08,0:11:48.20,Default,,0,0,0,,Не! Арх!
Dialogue: 0,0:11:48.49,0:11:52.79,Default,,0,0,0,,Жарайды, менімен бірге істеуге батылдық жетсе, жарайды.
Dialogue: 0,0:11:55.33,0:11:58.13,Default,,0,0,0,,Сонда? Сонымен не болды?
Dialogue: 0,0:11:58.96,0:11:59.88,Default,,0,0,0,,Иә
Dialogue: 0,0:12:02.72,0:12:06.39,Default,,0,0,0,,Бұлай мазасызданба, дайындал.
Dialogue: 0,0:12:06.47,0:12:08.35,Default,,0,0,0,,Ку…ку…
Dialogue: 0,0:12:08.43,0:12:10.52,Default,,0,0,0,,Сен оны осылай соғасың ба?
Dialogue: 0,0:12:10.60,0:12:12.60,Default,,0,0,0,,Ей, бұл мені күлдіреді.
Dialogue: 0,0:12:13.98,0:12:15.69,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:12:15.77,0:12:19.36,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:19.44,0:12:21.90,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:27.49,0:12:28.66,Default,,0,0,0,,Ах, фуу!
Dialogue: 0,0:12:29.29,0:12:31.08,Default,,0,0,0,,Тек құдіреті таң қалдырды.
Dialogue: 0,0:12:31.37,0:12:32.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:32.83,0:12:34.67,Default,,0,0,0,,Қазірге дейін бұл жаттығу 10 қатысушымен өтті, бірақ—
Dialogue: 0,0:12:46.39,0:12:48.85,Default,,0,0,0,,Ей, көгерген шығанақта.
Dialogue: 0,0:12:48.93,0:12:51.93,Default,,0,0,0,,Менің Айқайлаған Шайтанымды жеңемін деп ойладың ба?
Dialogue: 0,0:12:52.35,0:12:53.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:54.19,0:12:55.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:59.73,0:13:00.57,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:13:03.82,0:13:06.28,Default,,0,0,0,,Сол көздер ғана мені біраз мазалаған.
Dialogue: 0,0:13:08.24,0:13:11.12,Default,,0,0,0,,Мен ол туралы ұмытып кетіппін.
Dialogue: 0,0:13:11.20,0:13:15.33,Default,,0,0,0,,Білесің бе, Ғазем ол кезде шынымен де мұңды еді.
Dialogue: 0,0:13:15.66,0:13:16.62,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:13:17.08,0:13:20.34,Default,,0,0,0,,Енді мылтықты неге маған таққаныңызды білемін.
Dialogue: 0,0:13:20.42,0:13:21.50,Default,,0,0,0,,Мен өзімді сергек сезіндім.
Dialogue: 0,0:13:22.25,0:13:25.55,Default,,0,0,0,,Иә! Мен сені бұл жолы тағы ұрамын.
Dialogue: 0,0:13:25.63,0:13:27.47,Default,,0,0,0,,​​Бұл нені білдіреді?
Dialogue: 0,0:13:28.76,0:13:29.89,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:13:30.22,0:13:32.97,Default,,0,0,0,,Сіз Ғазем туралы білетін шығарсыз.
Dialogue: 0,0:13:33.06,0:13:35.48,Default,,0,0,0,,Ондай жағдайда маған хабарлап жіберсеңіз жақсы болар еді.
Dialogue: 0,0:13:35.56,0:13:37.02,Default,,0,0,0,,Деректер болмағандықтан
Dialogue: 0,0:13:37.31,0:13:40.23,Default,,0,0,0,,He's not worth marking like that.
Dialogue: 0,0:13:40.86,0:13:42.90,Default,,0,0,0,,Мен оны бірден аяқтаймын.
Dialogue: 0,0:13:43.15,0:13:47.36,Default,,0,0,0,,But if Gazem were against Cisco, he would attack with all his might.
Dialogue: 0,0:13:47.45,0:13:51.08,Default,,0,0,0,,Бұл құпия қару ма? Бұл қандай шайқас болады деп ойлаймын.
Dialogue: 0,0:13:51.49,0:13:54.70,Default,,0,0,0,,Think about yourself winning rather than anything like that.
Dialogue: 0,0:13:56.41,0:13:59.67,Default,,0,0,0,,Check, I guess I like him.
Dialogue: 0,0:14:11.97,0:14:13.56,Default,,0,0,0,,Сізде әлі бар ма?
Dialogue: 0,0:14:14.27,0:14:16.10,Default,,0,0,0,,Бұл менің қазынам.
Dialogue: 0,0:14:16.18,0:14:19.23,Default,,0,0,0,,Мен туылғанда әкем берген.
Dialogue: 0,0:14:19.31,0:14:22.86,Default,,0,0,0,,Сіз әкеңізді муай-тайдан чемпион деп айттыңыз.
Dialogue: 0,0:14:23.44,0:14:26.82,Default,,0,0,0,,Oh, my dad wants me to be Bey's champion.
Dialogue: 0,0:14:26.90,0:14:28.07,Default,,0,0,0,,Мен оны асыға күттім.
Dialogue: 0,0:14:37.96,0:14:40.46,Default,,0,0,0,,Gazem It's your turn now.
Dialogue: 0,0:14:40.71,0:14:43.17,Default,,0,0,0,,О, әке!
Dialogue: 0,0:14:43.54,0:14:46.01,Default,,0,0,0,,Дүниеге ұш, Ғазем!
Dialogue: 0,0:14:49.43,0:14:53.85,Default,,0,0,0,,Well, I'm sure you're happy about Gazem being in the World League.
Dialogue: 0,0:14:55.60,0:14:56.89,Default,,0,0,0,,Өлген
Dialogue: 0,0:14:57.35,0:14:59.27,Default,,0,0,0,,Матч кезінде алған жарақатына байланысты
Dialogue: 0,0:15:00.06,0:15:01.60,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:15:01.69,0:15:05.23,Default,,0,0,0,,Бірақ әкем мені әлі бақылап отыр.
Dialogue: 0,0:15:06.98,0:15:09.32,Default,,0,0,0,,Не? Сол ескі шығанақ
Dialogue: 0,0:15:10.74,0:15:14.87,Default,,0,0,0,,I will never forgive anyone who laughed at this bay!
Dialogue: 0,0:15:19.46,0:15:21.42,Default,,0,0,0,,Trad Baltic білмейсіз бе?
Dialogue: 0,0:15:21.96,0:15:24.34,Default,,0,0,0,,Жоқ. Балтоға не болды?
Dialogue: 0,0:15:24.84,0:15:26.30,Default,,0,0,0,,Андж туралы айту
Dialogue: 0,0:15:26.38,0:15:29.17,Default,,0,0,0,,Looks like he went somewhere without eating.
Dialogue: 0,0:15:29.26,0:15:32.22,Default,,0,0,0,,He's totally... incapable of following discipline.
Dialogue: 0,0:15:32.93,0:15:36.31,Default,,0,0,0,,I wonder what's wrong with Balto not eating?
Dialogue: 0,0:15:37.06,0:15:39.18,Default,,0,0,0,,Ол мүмкін емес
Dialogue: 0,0:15:40.94,0:15:45.19,Default,,0,0,0,,Nokiashi, Sashiashi, Shinobiashi
Dialogue: 0,0:15:45.48,0:15:48.82,Default,,0,0,0,,Кит, мен саған артымнан қалма дедім ғой, солай ма?
Dialogue: 0,0:15:48.90,0:15:51.11,Default,,0,0,0,,I'm worried about Aniki alone...
Dialogue: 0,0:15:51.49,0:15:54.62,Default,,0,0,0,,It's okay, just say something to Gazem.
Dialogue: 0,0:16:01.12,0:16:03.29,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:16:03.37,0:16:05.08,Default,,0,0,0,,Ғазем қайда орналасқан?
Dialogue: 0,0:16:05.71,0:16:07.75,Default,,0,0,0,,Тәжірибе аяқталды деп ойлаймын.
Dialogue: 0,0:16:07.84,0:16:09.34,Default,,0,0,0,,Мен біраз зерттеу жүргіземін.
Dialogue: 0,0:16:09.42,0:16:11.17,Default,,0,0,0,,Уау, уау...
Dialogue: 0,0:16:11.26,0:16:14.05,Default,,0,0,0,,Ах, уау!
Dialogue: 0,0:16:15.84,0:16:17.89,Default,,0,0,0,,Әй, бұл тағы да сенсің
Dialogue: 0,0:16:17.97,0:16:18.72,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:19.14,0:16:21.27,Default,,0,0,0,,Қызық, сіз бұл жолы суреттерді жасыру үшін келдіңіз бе?
Dialogue: 0,0:16:21.73,0:16:22.81,Default,,0,0,0,,Вуайеризм?
Dialogue: 0,0:16:23.39,0:16:25.60,Default,,0,0,0,,Сіз мұнда менің ақпаратымды ұрлау үшін келдіңіз, солай ма?
Dialogue: 0,0:16:25.81,0:16:27.77,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:16:28.15,0:16:29.82,Default,,0,0,0,,Олай болса, бұл не?
Dialogue: 0,0:16:30.15,0:16:31.78,Default,,0,0,0,,Иә? а!
Dialogue: 0,0:16:32.74,0:16:34.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:35.57,0:16:37.37,Default,,0,0,0,,Хойотто!
Dialogue: 0,0:16:38.08,0:16:39.24,Default,,0,0,0,,Аники!
Dialogue: 0,0:16:39.41,0:16:40.79,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:16:41.62,0:16:43.50,Default,,0,0,0,,Уваттотото
Dialogue: 0,0:16:43.58,0:16:45.67,Default,,0,0,0,,Аники? Күтіңіз Газем
Dialogue: 0,0:16:45.75,0:16:47.58,Default,,0,0,0,,Мен мұнда айтқым келген нәрсемен келдім.
Dialogue: 0,0:16:49.55,0:16:51.67,Default,,0,0,0,,Cisco-ны мәңгілікке қызғанбаңыз
Dialogue: 0,0:16:51.76,0:16:54.68,Default,,0,0,0,,Ертең шығанақта әділ, шаршы алаңға тартайық.
Dialogue: 0,0:16:54.76,0:16:57.01,Default,,0,0,0,,Ақыр аяғында біз пышақпыз.
Dialogue: 0,0:16:57.26,0:16:58.89,Default,,0,0,0,,Не білесің!
Dialogue: 0,0:16:59.01,0:16:59.93,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:17:00.01,0:17:01.10,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:17:02.47,0:17:03.56,Default,,0,0,0,,Cisco
Dialogue: 0,0:17:03.64,0:17:05.56,Default,,0,0,0,,Шамадан тыс еліктеушілік
Dialogue: 0,0:17:11.11,0:17:12.94,Default,,0,0,0,,Сіз мұны істегіңіз келе ме? мұнда
Dialogue: 0,0:17:13.03,0:17:15.20,Default,,0,0,0,,Жасағым келсе, мен саған жасаймын.
Dialogue: 0,0:17:16.28,0:17:17.70,Default,,0,0,0,,Міне, Ғазем.
Dialogue: 0,0:17:18.12,0:17:21.41,Default,,0,0,0,,Жарыс ертең Эль Сантода шешіледі.
Dialogue: 0,0:17:23.16,0:17:26.29,Default,,0,0,0,,Ертеңгі матч, бірінші жүзуші Ғазем
Dialogue: 0,0:17:27.88,0:17:30.34,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:17:30.84,0:17:36.09,Default,,0,0,0,,Ғазем әділ және шаршы алаңда күреседі және әрқашан жеңеді.
Dialogue: 0,0:17:37.30,0:17:39.09,Default,,0,0,0,,Ғазем бірінші ме?
Dialogue: 0,0:17:39.85,0:17:42.06,Default,,0,0,0,,Қызық екен.
Dialogue: 0,0:17:42.14,0:17:45.14,Default,,0,0,0,,Мен осында барамын, жарай ма? капитан
Dialogue: 0,0:17:45.23,0:17:46.35,Default,,0,0,0,,О... ой
Dialogue: 0,0:17:46.94,0:17:50.73,Default,,0,0,0,,Жарайды, ертең бізде әділ жекпе-жек болады!
Dialogue: 0,0:17:53.65,0:17:56.36,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:17:56.45,0:17:59.82,Default,,0,0,0,,Еуропа Лигасының финалдық ойыны аяқталды!
Dialogue: 0,0:17:59.91,0:18:03.83,Default,,0,0,0,,Испанияның беделді BC Sol командасы Дүниежүзілік лигаға қатысу үшін жарысуда.
Dialogue: 0,0:18:03.91,0:18:07.71,Default,,0,0,0,,Британдық күшті Корольдік клубқа қарсы қандай шайқас боламыз?
Dialogue: 0,0:18:07.79,0:18:10.04,Default,,0,0,0,,Барлығының назарына!
Dialogue: 0,0:18:10.79,0:18:14.46,Default,,0,0,0,,Енді екі команданың да пышақтары пайда болады!
Dialogue: 0,0:18:14.55,0:18:15.88,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:18:16.01,0:18:20.93,Default,,0,0,0,,BC Sol өз үйі ретінде Эль Сантомен қайта оралуда!
Dialogue: 0,0:18:21.01,0:18:23.39,Default,,0,0,0,,Капитан Балт Аоиға назар аудару
Dialogue: 0,0:18:23.47,0:18:26.89,Default,,0,0,0,,Рантаро Кияма және Сиско Карлайл!
Dialogue: 0,0:18:27.14,0:18:28.39,Default,,0,0,0,,Аники!
Dialogue: 0,0:18:28.48,0:18:29.60,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:18:30.44,0:18:31.73,Default,,0,0,0,,Көк бұрыш
Dialogue: 0,0:18:31.98,0:18:35.11,Default,,0,0,0,,Корольдік клубтар Әлемдік лигаға қатысуға шешім қабылдады
Dialogue: 0,0:18:35.36,0:18:37.61,Default,,0,0,0,,Капитан Артур Лоуренс
Dialogue: 0,0:18:37.69,0:18:39.11,Default,,0,0,0,,Джордж Старр
Dialogue: 0,0:18:39.20,0:18:42.20,Default,,0,0,0,,Және бұл Корольдіктердің құпия қаруы деп айтылады.
Dialogue: 0,0:18:42.28,0:18:44.66,Default,,0,0,0,,Ғазем Мадар!
Dialogue: 0,0:18:45.37,0:18:46.83,Default,,0,0,0,,Бұл Ғазем бе?
Dialogue: 0,0:18:46.91,0:18:50.71,Default,,0,0,0,,Иә, ол қауесеттерден де қорқынышты.
Dialogue: 0,0:18:52.88,0:18:55.75,Default,,0,0,0,,Кумичо Арғы жағындағы бірінші адам - ​​Газем.
Dialogue: 0,0:18:55.96,0:18:57.55,Default,,0,0,0,,Мен Cisco-мен барамын.
Dialogue: 0,0:18:57.92,0:18:59.30,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:18:59.38,0:19:02.76,Default,,0,0,0,,Маған алдын ала ескерту жасамаңыз.
Dialogue: 0,0:19:03.39,0:19:04.89,Default,,0,0,0,,Сол мыңжапырақ
Dialogue: 0,0:19:05.35,0:19:08.02,Default,,0,0,0,,Мен сенің маған тағы да мылтық тақпауыңды қадағалаймын.
Dialogue: 0,0:19:09.43,0:19:11.85,Default,,0,0,0,,Енді бірінші ойынға арналған пышақ
Dialogue: 0,0:19:11.94,0:19:16.23,Default,,0,0,0,,Ой, корольдіктер кенеттен құпия қаруға ие болды! Өлім қаруы!
Dialogue: 0,0:19:16.32,0:19:17.90,Default,,0,0,0,,Бұл Ғазем Мадар!
Dialogue: 0,0:19:17.99,0:19:21.16,Default,,0,0,0,,Екінші жағынан, Б.С. Сол бүлікші заңсыз.
Dialogue: 0,0:19:21.24,0:19:23.28,Default,,0,0,0,,Cisco Carlisle!
Dialogue: 0,0:19:28.04,0:19:31.83,Default,,0,0,0,,Бұл менің жаңа Бей Максимум Гарудам!
Dialogue: 0,0:19:34.17,0:19:35.59,Default,,0,0,0,,Үлкен
Dialogue: 0,0:19:35.92,0:19:36.88,Default,,0,0,0,,О
Dialogue: 0,0:19:37.38,0:19:39.34,Default,,0,0,0,,Иә, бұл жолы солай ма?
Dialogue: 0,0:19:39.63,0:19:41.88,Default,,0,0,0,,Қиындық
Dialogue: 0,0:19:42.38,0:19:44.85,Default,,0,0,0,,Максимум Гаруда - төзімділік түрі.
Dialogue: 0,0:19:45.47,0:19:46.89,Default,,0,0,0,,Үлкен диаметр
Dialogue: 0,0:19:46.97,0:19:50.10,Default,,0,0,0,,Бүкіл қабат винт тәрізді.
Dialogue: 0,0:19:50.48,0:19:52.48,Default,,0,0,0,,Шамасы, жоғарғы күш туады.
Dialogue: 0,0:19:53.52,0:19:55.98,Default,,0,0,0,,Қызық, винт қандай?
Dialogue: 0,0:19:56.65,0:19:59.19,Default,,0,0,0,,Бірінші ойын Бірінші шайқас
Dialogue: 0,0:20:02.28,0:20:04.07,Default,,0,0,0,,Ах! Аяқ киіміңді шеш!
Dialogue: 0,0:20:04.32,0:20:06.41,Default,,0,0,0,,Бұл муай-тай сақинасы емес!
Dialogue: 0,0:20:06.83,0:20:10.12,Default,,0,0,0,,Сіз мені осымен жеңе аласыз деп ойлайсыз ба?
Dialogue: 0,0:20:10.50,0:20:12.12,Default,,0,0,0,,Төменге дейін құлаңыз
Dialogue: 0,0:20:13.83,0:20:15.50,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:20:15.96,0:20:19.09,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:19.59,0:20:21.84,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:23.01,0:20:26.64,Default,,0,0,0,,Ой, Крис Сатан, сәл кешігіп қалдың ба?
Dialogue: 0,0:20:29.47,0:20:30.81,Default,,0,0,0,,(роликтің жерге тиген дыбысы)
Dialogue: 0,0:20:32.06,0:20:33.56,Default,,0,0,0,,Айқай, Шайтан!
Dialogue: 0,0:20:35.90,0:20:38.02,Default,,0,0,0,,Шайтанның шабуылы деп жыла!
Dialogue: 0,0:20:38.23,0:20:42.15,Default,,0,0,0,,Бұл сәтті бола ма? Максимум Гаруда!
Dialogue: 0,0:20:43.61,0:20:44.53,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:20:44.95,0:20:48.03,Default,,0,0,0,,Ах! Максимум желге ұшып кетті... Ах!
Dialogue: 0,0:20:48.12,0:20:49.41,Default,,0,0,0,,Шығанақ ән айтты ма?
Dialogue: 0,0:20:49.91,0:20:50.58,Default,,0,0,0,,На
Dialogue: 0,0:20:51.16,0:20:53.12,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:20:53.21,0:20:54.67,Default,,0,0,0,,(көтерілген жалын дыбысы)
Dialogue: 0,0:21:00.42,0:21:02.80,Default,,0,0,0,,Шайтанды жең!
Dialogue: 0,0:21:09.10,0:21:10.51,Default,,0,0,0,,(үру)
Dialogue: 0,0:21:10.76,0:21:14.23,Default,,0,0,0,,Куаааааааааа
Dialogue: 0,0:21:15.14,0:21:16.69,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:21:16.98,0:21:17.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:18.36,0:21:19.23,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:21:20.27,0:21:22.94,Default,,0,0,0,,Максималды Garuda Burst Finish
Dialogue: 0,0:21:23.28,0:21:26.28,Default,,0,0,0,,Корольдік клуб бірінші ойында жеңіске жетті!
Dialogue: 0,0:21:26.61,0:21:28.37,Default,,0,0,0,,Уаааааааааа!
Dialogue: 0,0:21:28.62,0:21:31.70,Default,,0,0,0,,Уау! Бұл керемет күш!
Dialogue: 0,0:21:31.79,0:21:34.96,Default,,0,0,0,,Қорқынышты Максимум Гаруда!
Dialogue: 0,0:21:45.13,0:21:48.01,Default,,0,0,0,,Cisco... шабуылға ұшырады ма?
Dialogue: 0,0:21:49.76,0:21:52.51,Default,,0,0,0,,Уаааааааааа!
Dialogue: 0,0:21:55.93,0:21:58.35,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.44,0:22:01.86,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.94,0:22:04.69,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.78,0:22:06.95,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.03,0:22:10.57,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.66,0:22:14.29,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.37,0:22:16.16,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.25,0:22:18.04,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.12,0:22:19.83,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.92,0:22:21.50,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.59,0:22:23.50,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.59,0:22:26.05,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.13,0:22:29.05,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.13,0:22:32.76,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.85,0:22:36.52,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.60,0:22:38.27,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.35,0:22:41.52,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.61,0:22:43.94,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.02,0:22:47.49,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.57,0:22:51.03,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.11,0:22:53.12,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.20,0:22:54.95,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.04,0:22:58.46,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.54,0:23:00.46,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.54,0:23:03.54,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.63,0:23:05.84,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.92,0:23:09.84,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.93,0:23:13.51,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.60,0:23:17.10,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.18,0:23:20.44,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.52,0:23:22.19,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.27,0:23:25.07,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.27,0:23:25.07,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.07,0:23:25.48,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.27,0:23:29.03,Default,,0,0,0,,Біздің алдымызда Ғазем тұр
Dialogue: 0,0:23:29.19,0:23:32.91,Default,,0,0,0,,Егер біз бұл жігітті жеңбесек, Дүниежүзілік лигаға шығуға жол жоқ.
Dialogue: 0,0:23:32.99,0:23:36.87,Default,,0,0,0,,Мен әлі Валькирияның шынайы күшін көрсете алмадым.
Dialogue: 0,0:23:37.41,0:23:40.96,Default,,0,0,0,,Бірақ біз мұны істеуіміз керек. Бір команда болып күресейік!
Dialogue: 0,0:23:41.25,0:23:43.46,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.54,0:23:45.04,Default,,0,0,0,,Құс құдай жауынгері (Чоужин Блэдер) Газем!
Dialogue: 0,0:23:45.54,0:23:49.21,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.71,0:23:56.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory