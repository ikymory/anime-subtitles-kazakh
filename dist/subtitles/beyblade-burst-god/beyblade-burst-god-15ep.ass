Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.21,0:00:06.96,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:09.80,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.43,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.48,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.10,0:00:29.65,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:38.45,0:00:41.87,Default,,0,0,0,,Маған қиналған сен едің.
Dialogue: 0,0:00:42.87,0:00:44.25,Default,,0,0,0,,Маған неге қарадың?
Dialogue: 0,0:00:44.33,0:00:46.75,Default,,0,0,0,,Мен туралы ұмыттыңыз ба?
Dialogue: 0,0:00:50.96,0:00:54.92,Default,,0,0,0,,Британдық корольдік отбасының құпия қаруы Газем Мадар...
Dialogue: 0,0:00:55.01,0:00:57.72,Default,,0,0,0,,Баяғыда Cisco менің шығанағымды бұзды.
Dialogue: 0,0:00:59.01,0:01:00.89,Default,,0,0,0,,Еуропа лигасының финалдық ойыны
Dialogue: 0,0:01:00.97,0:01:04.06,Default,,0,0,0,,Әлемдік лига Қатысу үшін шайқастың бірінші ойыны
Dialogue: 0,0:01:04.14,0:01:08.27,Default,,0,0,0,,Gazem Cisco-ны Максимум Гарудамен кездесуге шақырды.
Dialogue: 0,0:01:12.69,0:01:15.40,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:01:17.11,0:01:18.41,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:19.87,0:01:24.29,Default,,0,0,0,,Уаааааааааааа!
Dialogue: 0,0:01:24.37,0:01:25.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:27.50,0:01:30.67,Default,,0,0,0,,Cisco... жеңілді.
Dialogue: 0,0:01:31.46,0:01:34.13,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.21,0:01:36.55,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:36.63,0:01:38.89,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:38.97,0:01:41.60,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:41.68,0:01:44.06,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:44.14,0:01:45.81,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:45.89,0:01:50.11,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:51.06,0:01:55.82,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:55.90,0:02:00.41,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:00.91,0:02:05.66,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:05.75,0:02:10.67,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:10.75,0:02:15.63,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:15.71,0:02:20.68,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:20.76,0:02:24.06,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:24.14,0:02:25.68,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:25.77,0:02:28.31,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:28.39,0:02:30.56,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:30.65,0:02:32.94,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:33.02,0:02:34.15,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:34.23,0:02:35.73,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:35.82,0:02:38.03,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:38.11,0:02:44.41,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:44.49,0:02:48.79,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:48.87,0:02:51.62,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:51.71,0:02:54.17,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:54.25,0:02:56.63,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:56.71,0:03:00.05,Default,,0,0,0,,~♪
Dialogue: 0,0:02:56.71,0:03:00.05,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:00.05,0:03:00.97,Default,,0,0,0,,~♪
Dialogue: 0,0:03:02.26,0:03:04.47,Default,,0,0,0,,Құс құдай жауынгері (Чоужин Блейдер) Газем!
Dialogue: 0,0:03:06.01,0:03:07.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:07.56,0:03:10.44,Default,,0,0,0,,BC Sol Әлемдік лигаға жолдама алды!
Dialogue: 0,0:03:10.52,0:03:13.44,Default,,0,0,0,,Мен бірінші ойында жеңілдім!
Dialogue: 0,0:03:13.52,0:03:14.73,Default,,0,0,0,,Бұл әлсіз
Dialogue: 0,0:03:19.03,0:03:20.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:22.07,0:03:25.24,Default,,0,0,0,,Төзімді адам болса да, ол осылай шабуыл жасай алады...
Dialogue: 0,0:03:25.33,0:03:26.91,Default,,0,0,0,,Шынымен құпия қару
Dialogue: 0,0:03:27.41,0:03:30.00,Default,,0,0,0,,Бұл кадр керемет болды
Dialogue: 0,0:03:30.08,0:03:31.33,Default,,0,0,0,,Сәлем, Cisco...
Dialogue: 0,0:03:35.08,0:03:37.75,Default,,0,0,0,,Жарайсың, Балто! Біз оны қайтарамыз!
Dialogue: 0,0:03:38.09,0:03:40.13,Default,,0,0,0,,О, мен келемін!
Dialogue: 0,0:03:40.22,0:03:41.59,Default,,0,0,0,,Енді ұрыспауға тырысайық.
Dialogue: 0,0:03:41.76,0:03:43.34,Default,,0,0,0,,Бұл менің кезегім!
Dialogue: 0,0:03:43.43,0:03:44.89,Default,,0,0,0,,Жоқ, мен барамын!
Dialogue: 0,0:03:44.97,0:03:47.10,Default,,0,0,0,,Ғазем сияқты атылады.
Dialogue: 0,0:03:47.18,0:03:49.06,Default,,0,0,0,,Жоқ, мен барамын!
Dialogue: 0,0:03:49.14,0:03:51.52,Default,,0,0,0,,Шулы! Тас, қағаз, қайшы ойнаймыз!
Dialogue: 0,0:03:51.60,0:03:53.31,Default,,0,0,0,,Тас, қағаз, қайшы ма?
Dialogue: 0,0:03:53.73,0:03:55.19,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:03:55.27,0:03:58.23,Default,,0,0,0,,Алдымен шыға! тас, қағаз, қайшы гу
Dialogue: 0,0:03:58.61,0:04:01.03,Default,,0,0,0,,Айко де Чоки Айко де абз
Dialogue: 0,0:04:01.65,0:04:03.82,Default,,0,0,0,,Tsk! Мен күзетімді түсірдім.
Dialogue: 0,0:04:04.03,0:04:06.53,Default,,0,0,0,,Айко де пар Айко де гу
Dialogue: 0,0:04:06.62,0:04:07.83,Default,,0,0,0,,Жанкенпон
Dialogue: 0,0:04:08.08,0:04:10.08,Default,,0,0,0,,Кенет күшейе түседі
Dialogue: 0,0:04:10.16,0:04:13.33,Default,,0,0,0,,Ол шығанақ та керемет... хмм...
Dialogue: 0,0:04:13.71,0:04:16.79,Default,,0,0,0,,Өте жақсы, балалар, сендер қаншалықты жақынсыңдар?
Dialogue: 0,0:04:16.88,0:04:18.17,Default,,0,0,0,,Айко де абз
Dialogue: 0,0:04:18.25,0:04:19.46,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:04:19.55,0:04:20.76,Default,,0,0,0,,Не? а!
Dialogue: 0,0:04:21.01,0:04:23.30,Default,,0,0,0,,Иә! Мен жеңемін!
Dialogue: 0,0:04:23.38,0:04:24.43,Default,,0,0,0,,Че!
Dialogue: 0,0:04:24.84,0:04:26.97,Default,,0,0,0,,Мен келесіге барамын
Dialogue: 0,0:04:27.76,0:04:28.93,Default,,0,0,0,,(Ұрыс тіркеу дыбысы)
Dialogue: 0,0:04:29.01,0:04:31.18,Default,,0,0,0,,Артур, мен оны асыға күтемін.
Dialogue: 0,0:04:31.27,0:04:33.39,Default,,0,0,0,,Менің жеңілуім мүмкін емес.
Dialogue: 0,0:04:34.10,0:04:37.86,Default,,0,0,0,,Ғазем, сен күткен шайқас ақыры болды.
Dialogue: 0,0:04:39.90,0:04:43.07,Default,,0,0,0,,Мен сіздің дебюттік матчыңыздың жақсы ұйымдастырылғанына көз жеткіземін.
Dialogue: 0,0:04:43.90,0:04:48.07,Default,,0,0,0,,Артур, бүгінгі күннің бар болғаны сенің арқаң.
Dialogue: 0,0:04:48.45,0:04:49.62,Default,,0,0,0,,№.
Dialogue: 0,0:04:49.91,0:04:53.54,Default,,0,0,0,,Өйткені алты ай бұрын сіз алға жылжу туралы шешім қабылдадыңыз.
Dialogue: 0,0:04:56.83,0:04:58.38,Default,,0,0,0,,Аа, ыстық.
Dialogue: 0,0:04:58.46,0:05:01.63,Default,,0,0,0,,Бұл тағы да Ғазем (2-бала) Асығыңыз, асығыңыз!
Dialogue: 0,0:05:04.51,0:05:05.55,Default,,0,0,0,,Енді сен агент емессің.
Dialogue: 0,0:05:07.39,0:05:08.64,Default,,0,0,0,,(Гонг дыбысы)
Dialogue: 0,0:05:08.72,0:05:10.89,Default,,0,0,0,,Ғазем Мадардың жеңісі!
Dialogue: 0,0:05:18.10,0:05:19.02,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:19.11,0:05:21.32,Default,,0,0,0,,Өйткені, бұл менің істегім келмейді.
Dialogue: 0,0:05:26.65,0:05:28.07,Default,,0,0,0,,Ол дәрігер атағын биліктегілердің көңілін табу үшін пайдаланып жүр
Dialogue: 0,0:05:29.91,0:05:31.91,Default,,0,0,0,,Бұл... Бей.
Dialogue: 0,0:05:38.46,0:05:39.92,Default,,0,0,0,,Сіз де қуықшысыз ба?
Dialogue: 0,0:05:41.96,0:05:43.17,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:05:43.50,0:05:45.51,Default,,0,0,0,,Мен Артур Лоуренспін
Dialogue: 0,0:05:46.01,0:05:48.72,Default,,0,0,0,,Мен осында өтіп жатқан турнирге қатысып жатырмын.
Dialogue: 0,0:05:49.59,0:05:50.89,Default,,0,0,0,,Келмейсің бе?
Dialogue: 0,0:05:51.43,0:05:54.47,Default,,0,0,0,,Мен енді мұны істей алмаймын. Ол сынған.
Dialogue: 0,0:05:54.93,0:05:56.02,Default,,0,0,0,,Сынған ба?
Dialogue: 0,0:05:56.85,0:05:59.06,Default,,0,0,0,,Сиско есімді жігіт мені сындырды.
Dialogue: 0,0:05:59.15,0:06:02.02,Default,,0,0,0,,Cisco... Cisco Carlisle?
Dialogue: 0,0:06:04.73,0:06:07.57,Default,,0,0,0,,Сонымен, оны сол күйінде қалдыру дұрыс па?
Dialogue: 0,0:06:09.03,0:06:12.37,Default,,0,0,0,,Таңдасаң мен саған күшімді берем.
Dialogue: 0,0:06:12.91,0:06:13.91,Default,,0,0,0,,Таңдау дегенді қалай түсінесіңдер?
Dialogue: 0,0:06:14.41,0:06:17.50,Default,,0,0,0,,Бейблейд ойнағыңыз келе ме? Солай емес пе?
Dialogue: 0,0:06:18.83,0:06:20.08,Default,,0,0,0,,Мен мұны істегім келеді
Dialogue: 0,0:06:20.92,0:06:23.25,Default,,0,0,0,,Мен Cisco-ны ешқашан кешірмеймін.
Dialogue: 0,0:06:23.34,0:06:26.05,Default,,0,0,0,,Және оның шығанағын сындырыңыз
Dialogue: 0,0:06:28.88,0:06:29.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:30.43,0:06:32.64,Default,,0,0,0,,Ол Максимум Гаруда деп аталады.
Dialogue: 0,0:06:33.30,0:06:36.22,Default,,0,0,0,,Бұл шығанақ сізге жарасады деп ойлаймын.
Dialogue: 0,0:06:37.27,0:06:38.52,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:06:54.41,0:06:56.74,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:06:56.83,0:06:59.04,Default,,0,0,0,,Енді екінші ойын басталады!
Dialogue: 0,0:06:59.12,0:07:02.79,Default,,0,0,0,,Корольдіктер үшін капитан Артур Лоуренс шығады.
Dialogue: 0,0:07:02.88,0:07:06.80,Default,,0,0,0,,Екінші жағынан, BC Солдан, бұл рухты Вальт Аои!
Dialogue: 0,0:07:06.88,0:07:09.55,Default,,0,0,0,,Балто Артурға қалай қарсы шығады?
Dialogue: 0,0:07:09.63,0:07:11.93,Default,,0,0,0,,Көз алмайсың шайқас!
Dialogue: 0,0:07:13.59,0:07:15.60,Default,,0,0,0,,Ху Аои Барто
Dialogue: 0,0:07:16.51,0:07:19.23,Default,,0,0,0,,Сіздің серіктес болу мен үшін мәртебе...
Dialogue: 0,0:07:19.56,0:07:21.64,Default,,0,0,0,,Ах! Хаха!
Dialogue: 0,0:07:22.27,0:07:25.82,Default,,0,0,0,,Ғазем! Бұрынғы түсірілім керемет болды!
Dialogue: 0,0:07:25.90,0:07:28.57,Default,,0,0,0,,Қалайша жақсы атуға болады?
Dialogue: 0,0:07:28.65,0:07:30.74,Default,,0,0,0,,Нууу... Ааа!
Dialogue: 0,0:07:30.95,0:07:31.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:36.33,0:07:39.75,Default,,0,0,0,,Түсіндім! Жалаң аяқ! Жалаң аяқ?
Dialogue: 0,0:07:39.83,0:07:42.42,Default,,0,0,0,,Сәлем, тезірек оралыңыз.
Dialogue: 0,0:07:42.50,0:07:43.21,Default,,0,0,0,,Уа!
Dialogue: 0,0:07:47.30,0:07:49.34,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:50.13,0:07:51.47,Default,,0,0,0,,Бұл жігіт тағы кім өзі?
Dialogue: 0,0:07:51.84,0:07:53.18,Default,,0,0,0,,Йо хо хо
Dialogue: 0,0:07:53.63,0:07:55.89,Default,,0,0,0,,Ой! Бұл жақсы болуы мүмкін!
Dialogue: 0,0:07:55.97,0:07:57.56,Default,,0,0,0,,Сіз байсалдысыз ба, Балто?
Dialogue: 0,0:07:57.64,0:07:59.77,Default,,0,0,0,,Ах! Бұл жақсы және суық сезінеді!
Dialogue: 0,0:07:59.85,0:08:00.93,Default,,0,0,0,,Онда...
Dialogue: 0,0:08:01.52,0:08:04.77,Default,,0,0,0,,Иә, менің аяғымда күш бар сияқты.
Dialogue: 0,0:08:05.44,0:08:07.06,Default,,0,0,0,,Жалаң аяқ жасағың келе ме?
Dialogue: 0,0:08:07.61,0:08:09.28,Default,,0,0,0,,Сіз мені қорлап жатырсыз, солай емес пе?
Dialogue: 0,0:08:10.11,0:08:12.95,Default,,0,0,0,,Мен саған әлемдік ранжердің күшін көрсетемін.
Dialogue: 0,0:08:13.99,0:08:16.70,Default,,0,0,0,,Екінші ойын Бірінші шайқас
Dialogue: 0,0:08:18.08,0:08:19.99,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:08:20.08,0:08:23.37,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:23.46,0:08:25.67,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:33.51,0:08:37.05,Default,,0,0,0,,Қараңдаршы, Аникидің Валькириясы, ол әдеттегіден жылдам емес пе?
Dialogue: 0,0:08:37.14,0:08:38.43,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:08:41.18,0:08:44.14,Default,,0,0,0,,Менің түсірген кадрым жақсы болуы мүмкін!
Dialogue: 0,0:08:44.23,0:08:45.98,Default,,0,0,0,,Балто Бұл керемет!
Dialogue: 0,0:08:46.06,0:08:47.73,Default,,0,0,0,,Бұл өте жақсы қадам.
Dialogue: 0,0:08:47.81,0:08:49.44,Default,,0,0,0,,Қызық, айырмашылығы неде?
Dialogue: 0,0:08:50.02,0:08:53.03,Default,,0,0,0,,Ату күші белгілі бір деңгейден асқанда
Dialogue: 0,0:08:53.11,0:08:56.66,Default,,0,0,0,,Механизм жүргізушіден жұқа білік шығатындай сияқты.
Dialogue: 0,0:08:56.74,0:09:00.70,Default,,0,0,0,,Барт байқамаған сияқты, бірақ бұл керемет.
Dialogue: 0,0:09:00.79,0:09:02.20,Default,,0,0,0,,Бұл шығанақ кімге тиесілі?
Dialogue: 0,0:09:03.50,0:09:04.79,Default,,0,0,0,,Валькирия
Dialogue: 0,0:09:04.87,0:09:07.67,Default,,0,0,0,,Таза жерде стадионды айналып жүгіру
Dialogue: 0,0:09:08.13,0:09:10.17,Default,,0,0,0,,Оффф!
Dialogue: 0,0:09:10.25,0:09:11.88,Default,,0,0,0,,Жасайық
Dialogue: 0,0:09:12.46,0:09:14.92,Default,,0,0,0,,Хмм, салқын бұрылыс.
Dialogue: 0,0:09:15.38,0:09:19.10,Default,,0,0,0,,Валькири кеттік! Бұл апатты түсірілім!
Dialogue: 0,0:09:19.93,0:09:20.68,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:09:22.89,0:09:23.72,Default,,0,0,0,,Күтпеген
Dialogue: 0,0:09:27.56,0:09:30.77,Default,,0,0,0,,Валькириге ұшатын реактивті ату!
Dialogue: 0,0:09:33.48,0:09:34.69,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:09:36.36,0:09:39.03,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:09:39.12,0:09:43.29,Default,,0,0,0,,BC Сол екінші ойында 2-0 есебімен жеңіске жетті!
Dialogue: 0,0:09:43.37,0:09:45.62,Default,,0,0,0,,BC Соль соңы жоқ
Dialogue: 0,0:09:45.71,0:09:48.29,Default,,0,0,0,,Біз мұнда 1-1 есебімен тең түстік.
Dialogue: 0,0:09:48.87,0:09:50.54,Default,,0,0,0,,Біз мұны істедік, Валькири!
Dialogue: 0,0:09:51.25,0:09:54.05,Default,,0,0,0,,Мен жеңілетініме сене алар емеспін
Dialogue: 0,0:09:55.01,0:09:56.01,Default,,0,0,0,,Артур…
Dialogue: 0,0:09:56.67,0:09:57.80,Default,,0,0,0,,Ғазем!
Dialogue: 0,0:09:58.22,0:10:02.22,Default,,0,0,0,,Жалаң аяқ барғанда қатты күш алған сияқтымын.
Dialogue: 0,0:10:02.43,0:10:04.06,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:10:04.14,0:10:05.81,Default,,0,0,0,,Мен ештеңе айтқан жоқпын!
Dialogue: 0,0:10:06.89,0:10:10.31,Default,,0,0,0,,Сіз осы уақытқа дейін жеттіңіз... Жага!
Dialogue: 0,0:10:10.90,0:10:15.28,Default,,0,0,0,,Мен Құдай Валькиридің барлық күшін шығара алмадым.
Dialogue: 0,0:10:15.99,0:10:17.82,Default,,0,0,0,,Фофофу
Dialogue: 0,0:10:17.90,0:10:18.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:19.24,0:10:20.57,Default,,0,0,0,,Жарайсың Балто
Dialogue: 0,0:10:20.66,0:10:21.41,Default,,0,0,0,,О
Dialogue: 0,0:10:21.49,0:10:23.53,Default,,0,0,0,,Бұл керемет кадр болды, солай емес пе?
Dialogue: 0,0:10:23.62,0:10:26.12,Default,,0,0,0,,Иә? Их хи хи хи
Dialogue: 0,0:10:26.20,0:10:27.58,Default,,0,0,0,,Менің көңіл-күйім жақсы емес.
Dialogue: 0,0:10:28.50,0:10:30.08,Default,,0,0,0,,Сәлем, Cisco!
Dialogue: 0,0:10:30.58,0:10:33.34,Default,,0,0,0,,Жарайды, мен ойын нүктесін алдым.
Dialogue: 0,0:10:33.42,0:10:34.59,Default,,0,0,0,,Тек бақытты бол!
Dialogue: 0,0:10:34.67,0:10:37.05,Default,,0,0,0,,Хе! сол күшті соққы
Dialogue: 0,0:10:37.13,0:10:39.72,Default,,0,0,0,,Сіз оны не үшін соққаныңызды білесіз бе?
Dialogue: 0,0:10:39.80,0:10:44.43,Default,,0,0,0,,Не? Хмм... аяқ киімді сүртіңіз бе?
Dialogue: 0,0:10:44.76,0:10:46.27,Default,,0,0,0,,Ей, сен данышпансың!
Dialogue: 0,0:10:46.52,0:10:50.10,Default,,0,0,0,,Сен ақымақсың ба? There's no way you'll change just by sewing shoes.
Dialogue: 0,0:10:50.39,0:10:52.81,Default,,0,0,0,,Сонымен Cisco біледі ме?
Dialogue: 0,0:10:52.90,0:10:54.69,Default,,0,0,0,,Аяқ саусақтарының күші
Dialogue: 0,0:10:55.32,0:11:00.24,Default,,0,0,0,,Because I was barefoot, I unknowingly flopped on my toes.
Dialogue: 0,0:11:00.32,0:11:01.78,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:11:01.86,0:11:05.53,Default,,0,0,0,,If you don't understand that, don't fight.
Dialogue: 0,0:11:05.62,0:11:08.54,Default,,0,0,0,,Осыны меңзедіңіз бе? Жақсы!
Dialogue: 0,0:11:09.00,0:11:10.16,Default,,0,0,0,,Бакайару
Dialogue: 0,0:11:10.62,0:11:13.83,Default,,0,0,0,,Сіз аяқ киім киіп жүрсеңіз де, саусақтарыңызды сезетін шығарсыз.
Dialogue: 0,0:11:14.13,0:11:15.04,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:11:16.21,0:11:17.46,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:11:17.55,0:11:21.51,Default,,0,0,0,,Келесі жолы мен керемет соққы жасап, жеңіске жетемін!
Dialogue: 0,0:11:21.59,0:11:23.14,Default,,0,0,0,,Кумичо, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:11:23.80,0:11:24.85,Default,,0,0,0,,О!
Dialogue: 0,0:11:25.26,0:11:29.48,Default,,0,0,0,,Енді үшінші ойын 1:1.
Dialogue: 0,0:11:29.56,0:11:32.56,Default,,0,0,0,,BC Солдан шыққан жапондық самурай!
Dialogue: 0,0:11:32.65,0:11:34.02,Default,,0,0,0,,Рантаро Кияма!
Dialogue: 0,0:11:34.11,0:11:37.02,Default,,0,0,0,,Корольдіктерге қарсы Джордж Старр пайда болды!
Dialogue: 0,0:11:37.57,0:11:40.95,Default,,0,0,0,,Біртүрлі сыртқы түрі бар тағы бір қуық келді.
Dialogue: 0,0:11:41.32,0:11:44.66,Default,,0,0,0,,Жарайсың ба? Бұл жапондық стиль
Dialogue: 0,0:11:44.74,0:11:49.62,Default,,0,0,0,,Кумичо-саманың күші керемет!
Dialogue: 0,0:11:49.95,0:11:53.12,Default,,0,0,0,,Иә! Бұл тамаша, Кумичо. Ол еркек!
Dialogue: 0,0:11:53.21,0:11:54.63,Default,,0,0,0,,Ол адам!
Dialogue: 0,0:11:54.71,0:11:56.17,Default,,0,0,0,,Дасак
Dialogue: 0,0:11:56.54,0:11:59.42,Default,,0,0,0,,Үшінші ойын Бірінші шайқас
Dialogue: 0,0:12:01.09,0:12:02.80,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:12:02.88,0:12:06.18,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:06.26,0:12:08.68,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:10.35,0:12:13.60,Default,,0,0,0,,Рантаро Кияма төзімділікті жақсы пайдаланады!
Dialogue: 0,0:12:14.06,0:12:18.52,Default,,0,0,0,,Жаса, Рагнарук! Бұл жаңа Рагнарук аймағы!
Dialogue: 0,0:12:18.61,0:12:20.19,Default,,0,0,0,,(көтерілген жалын дыбысы)
Dialogue: 0,0:12:20.28,0:12:22.70,Default,,0,0,0,,(шығылғанның дыбысы)
Dialogue: 0,0:12:23.32,0:12:24.78,Default,,0,0,0,,Шабуылдар жұмыс істемейді!
Dialogue: 0,0:12:25.07,0:12:27.03,Default,,0,0,0,,Дұрыс айтасыз!
Dialogue: 0,0:12:27.12,0:12:31.66,Default,,0,0,0,,Блэйз Рагнаруктың құдіретін қараңыз!
Dialogue: 0,0:12:33.37,0:12:34.87,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:12:35.58,0:12:37.92,Default,,0,0,0,,Blaze Ragnaruk Burst Finish!
Dialogue: 0,0:12:38.46,0:12:41.21,Default,,0,0,0,,BC Sol үшінші ойында жеңіске жетті!
Dialogue: 0,0:12:41.55,0:12:43.34,Default,,0,0,0,,Ойын саны 1-ден 2-ге дейін
Dialogue: 0,0:12:43.92,0:12:47.55,Default,,0,0,0,,Rantaro Kiyama A stunning victory! Көрініңіз!
Dialogue: 0,0:12:47.64,0:12:50.43,Default,,0,0,0,,BC Sol Матч тағы бір жеңіспен шешіледі!
Dialogue: 0,0:12:50.68,0:12:52.10,Default,,0,0,0,,Қалайсың, Балто?
Dialogue: 0,0:12:52.60,0:12:56.44,Default,,0,0,0,,О! Керемет! Мен Кумичо жасадым
Dialogue: 0,0:12:57.98,0:13:00.19,Default,,0,0,0,,Tsk, did he win too?
Dialogue: 0,0:13:02.15,0:13:03.65,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:13:04.49,0:13:06.11,Default,,0,0,0,,Barto Aoi, come out!
Dialogue: 0,0:13:06.78,0:13:10.24,Default,,0,0,0,,First, I'll beat you, Arthur!
Dialogue: 0,0:13:10.33,0:13:11.99,Default,,0,0,0,,Не? Мен?
Dialogue: 0,0:13:13.87,0:13:15.25,Default,,0,0,0,,Ол...
Dialogue: 0,0:13:15.75,0:13:18.08,Default,,0,0,0,,Cisco! Келесіде Кисама
Dialogue: 0,0:13:18.63,0:13:21.17,Default,,0,0,0,,Next time, I'll destroy Kisama's bey.
Dialogue: 0,0:13:21.80,0:13:23.80,Default,,0,0,0,,Don't mess with me, Gazem
Dialogue: 0,0:13:23.88,0:13:25.67,Default,,0,0,0,,Балт, бара бер.
Dialogue: 0,0:13:26.22,0:13:29.18,Default,,0,0,0,,Жарайды! Мен жеңемін және оны аяқтаймын!
Dialogue: 0,0:13:30.30,0:13:31.81,Default,,0,0,0,,You can't win with Balto.
Dialogue: 0,0:13:32.39,0:13:35.10,Default,,0,0,0,,Ақыры мен оның шығанағын құртамын!
Dialogue: 0,0:13:35.98,0:13:37.98,Default,,0,0,0,,Now, the fourth game
Dialogue: 0,0:13:38.06,0:13:41.69,Default,,0,0,0,,Корольдіктердің құпия қаруы Газем Мадар осында!
Dialogue: 0,0:13:41.98,0:13:44.65,Default,,0,0,0,,BC Sol, керісінше, Барто Аои.
Dialogue: 0,0:13:44.74,0:13:45.86,Default,,0,0,0,,Ah... that's right!
Dialogue: 0,0:13:47.61,0:13:50.16,Default,,0,0,0,,Ол... ол мені тыңдамайды.
Dialogue: 0,0:13:53.12,0:13:55.91,Default,,0,0,0,,Be conscious of your toes...
Dialogue: 0,0:13:56.00,0:13:57.29,Default,,0,0,0,,Жарайды, тамаша.
Dialogue: 0,0:13:59.38,0:14:02.21,Default,,0,0,0,,Төртінші ойын Бірінші шайқас
Dialogue: 0,0:14:02.29,0:14:04.13,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:04.76,0:14:07.88,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:07.97,0:14:10.39,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:11.97,0:14:13.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:13.10,0:14:16.31,Default,,0,0,0,,Барто Аои ыстық бөртпеден тайып кетті ме?
Dialogue: 0,0:14:16.64,0:14:18.44,Default,,0,0,0,,Сәлем Балто!
Dialogue: 0,0:14:18.52,0:14:20.40,Default,,0,0,0,,Өйткені ол жаман істер жасайды.
Dialogue: 0,0:14:20.48,0:14:21.81,Default,,0,0,0,,Үлкен аға Геко!
Dialogue: 0,0:14:21.90,0:14:22.73,Default,,0,0,0,,Е...
Dialogue: 0,0:14:22.82,0:14:24.44,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:24.78,0:14:25.65,Default,,0,0,0,,Барт…
Dialogue: 0,0:14:25.90,0:14:27.65,Default,,0,0,0,,Білік ұшы шықпаған сияқты.
Dialogue: 0,0:14:33.53,0:14:34.70,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:14:38.62,0:14:41.08,Default,,0,0,0,,Хахахахаха Бұл не!
Dialogue: 0,0:14:44.67,0:14:47.84,Default,,0,0,0,,Жоқ, бұл осы жерден. Қолыңнан келгеннің бәрін жаса, Валькири!
Dialogue: 0,0:14:47.92,0:14:50.63,Default,,0,0,0,,Гоооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооуу!
Dialogue: 0,0:14:52.05,0:14:55.64,Default,,0,0,0,,Немене, ол қабырғаға дейін соғылады!
Dialogue: 0,0:14:55.72,0:14:56.93,Default,,0,0,0,,Тағы да футто!
Dialogue: 0,0:14:57.27,0:14:59.44,Default,,0,0,0,,Иә! Жақсы, Валькири!
Dialogue: 0,0:14:59.52,0:15:01.19,Default,,0,0,0,,Керемет!
Dialogue: 0,0:15:02.56,0:15:05.27,Default,,0,0,0,,Tonda Tonda Garuda Flyaway!
Dialogue: 0,0:15:05.36,0:15:06.86,Default,,0,0,0,,Керемет!
Dialogue: 0,0:15:09.86,0:15:11.11,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:15:11.66,0:15:12.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:13.37,0:15:14.37,Default,,0,0,0,,Ах
Dialogue: 0,0:15:14.78,0:15:17.33,Default,,0,0,0,,Бұл ертерек соққыға жығылған.
Dialogue: 0,0:15:18.04,0:15:20.83,Default,,0,0,0,,Түсіндім... Түсіндім.
Dialogue: 0,0:15:21.83,0:15:23.08,Default,,0,0,0,,Мен тырысуым керек пе?
Dialogue: 0,0:15:23.92,0:15:26.67,Default,,0,0,0,,Максималды Garuda Burst Finish
Dialogue: 0,0:15:27.05,0:15:29.51,Default,,0,0,0,,4-ойын Корольдіктер жеңді!
Dialogue: 0,0:15:30.30,0:15:31.59,Default,,0,0,0,,Жақсы, Ғазем.
Dialogue: 0,0:15:34.55,0:15:35.60,Default,,0,0,0,,Валькирия…
Dialogue: 0,0:15:36.97,0:15:37.97,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:15:39.06,0:15:40.77,Default,,0,0,0,,Сіздің кезегіңіз аяқталды.
Dialogue: 0,0:15:41.85,0:15:44.44,Default,,0,0,0,,Кел, Cisco, шық!
Dialogue: 0,0:15:47.36,0:15:49.65,Default,,0,0,0,,Өте жақсы, күтіңіз!
Dialogue: 0,0:15:49.74,0:15:53.95,Default,,0,0,0,,BC Sol тағы да Cisco Carlyle-ді көрсетеді
Dialogue: 0,0:15:54.45,0:15:57.49,Default,,0,0,0,,Ғазем өз күшін тағы бір рет көрсете ме?
Dialogue: 0,0:15:57.58,0:15:59.41,Default,,0,0,0,,Cisco кек алады ма?
Dialogue: 0,0:15:59.83,0:16:01.71,Default,,0,0,0,,Ойындар саны 2-ден 2-ге дейін
Dialogue: 0,0:16:01.96,0:16:06.92,Default,,0,0,0,,Жеңіс құдайы қай командаға күледі?
Dialogue: 0,0:16:07.46,0:16:10.09,Default,,0,0,0,,Бесінші ойын Бірінші шайқас
Dialogue: 0,0:16:10.71,0:16:11.88,Default,,0,0,0,,Букковасу
Dialogue: 0,0:16:12.34,0:16:13.59,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:16:13.68,0:16:15.64,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:16:15.72,0:16:19.39,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:19.47,0:16:21.93,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:23.73,0:16:26.94,Default,,0,0,0,,Crys Шайтан орталықты алды!
Dialogue: 0,0:16:27.02,0:16:30.65,Default,,0,0,0,,Сізге үлкен Гаруда соғылады.
Dialogue: 0,0:16:30.73,0:16:32.11,Default,,0,0,0,,Ах! Кёрецу!
Dialogue: 0,0:16:32.19,0:16:36.16,Default,,0,0,0,,Бірақ бұл жолы Шайтан Гаруданың қиян-кескі шабуылынан сәтті құтылды.
Dialogue: 0,0:16:36.62,0:16:37.91,Default,,0,0,0,,Жақсы, Cisco.
Dialogue: 0,0:16:37.99,0:16:39.54,Default,,0,0,0,,Баруға болатын сияқты!
Dialogue: 0,0:16:39.83,0:16:43.54,Default,,0,0,0,,Келіңіздер, немен айналыссаңыздар, көріңіздер.
Dialogue: 0,0:16:43.91,0:16:45.46,Default,,0,0,0,,Керемет!
Dialogue: 0,0:16:49.50,0:16:51.59,Default,,0,0,0,,Ораораора, не болды!
Dialogue: 0,0:16:53.26,0:16:54.51,Default,,0,0,0,,А... бұл!
Dialogue: 0,0:16:54.80,0:16:56.76,Default,,0,0,0,,Жігіттердің жеңілген үлгісі осы.
Dialogue: 0,0:17:01.18,0:17:03.14,Default,,0,0,0,,Арх!
Dialogue: 0,0:17:03.23,0:17:04.77,Default,,0,0,0,,(көтерілген жалын дыбысы)
Dialogue: 0,0:17:10.61,0:17:11.78,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:18.03,0:17:19.41,Default,,0,0,0,,(үру)
Dialogue: 0,0:17:19.49,0:17:20.99,Default,,0,0,0,,Арх!
Dialogue: 0,0:17:22.41,0:17:26.04,Default,,0,0,0,,Сіз бір шабуыл маған екі рет әсер етеді деп ойладыңыз ба?
Dialogue: 0,0:17:26.46,0:17:28.04,Default,,0,0,0,,Роликтен қорғаныс!
Dialogue: 0,0:17:35.59,0:17:36.68,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:17:37.76,0:17:39.18,Default,,0,0,0,,(роликтің жерге тиген дыбысы)
Dialogue: 0,0:17:40.30,0:17:42.43,Default,,0,0,0,,Ораораораораора!
Dialogue: 0,0:17:48.02,0:17:51.57,Default,,0,0,0,,Бұлай етпе, Шайтан, бұл циклондық цикл!
Dialogue: 0,0:17:54.82,0:17:56.07,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:17:56.57,0:17:57.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:01.33,0:18:03.54,Default,,0,0,0,,Crys Satan Burst Finish
Dialogue: 0,0:18:03.95,0:18:07.16,Default,,0,0,0,,Cisco Carlyle 2-0 ұпаймен жеңеді
Dialogue: 0,0:18:07.54,0:18:11.63,Default,,0,0,0,,Ал 3-тен 2-ге дейінгі ойын санымен BC Сол жеңіске жетті!
Dialogue: 0,0:18:12.25,0:18:15.96,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:18:18.72,0:18:22.47,Default,,0,0,0,,Егер ол орталыққа көбірек тисе, Шайтан ашулануы мүмкін еді.
Dialogue: 0,0:18:23.31,0:18:24.77,Default,,0,0,0,,Бұл жақын қоңырау болды.
Dialogue: 0,0:18:25.64,0:18:26.64,Default,,0,0,0,,Сәлем сен!
Dialogue: 0,0:18:27.77,0:18:29.23,Default,,0,0,0,,Оның аты Ғазем болатын.
Dialogue: 0,0:18:29.65,0:18:32.19,Default,,0,0,0,,Келесі жолы есіміңді есіме аламын.
Dialogue: 0,0:18:32.44,0:18:35.44,Default,,0,0,0,,Қайта кел, келесі жолы сені сиқылаймын.
Dialogue: 0,0:18:41.28,0:18:43.16,Default,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:18:44.20,0:18:50.46,Default,,0,0,0,,Уаааааааааа!
Dialogue: 0,0:18:50.79,0:18:54.13,Default,,0,0,0,,Уау! (Артур) Газем...
Dialogue: 0,0:18:55.71,0:18:59.17,Default,,0,0,0,,Әрі қарай, Гаруда сіздің Шайтаныңызды жояды!
Dialogue: 0,0:19:00.55,0:19:01.34,Default,,0,0,0,,Иә
Dialogue: 0,0:19:10.64,0:19:16.28,Default,,0,0,0,,Біраз уақыт бұрын WBBA-дан Дүниежүзілік лиганың финалына қатысты шағым түсті.
Dialogue: 0,0:19:16.98,0:19:18.36,Default,,0,0,0,,Қалай болды деп таң қалдым...
Dialogue: 0,0:19:18.44,0:19:21.91,Default,,0,0,0,,Мен соңғы ойында жеңдім, жақсы...
Dialogue: 0,0:19:21.99,0:19:23.95,Default,,0,0,0,,Бірақ сұрауға қорқамын
Dialogue: 0,0:19:24.87,0:19:26.45,Default,,0,0,0,,BC Sol - бұл...
Dialogue: 0,0:19:27.58,0:19:28.87,Default,,0,0,0,,Бұл таңдаудың соңғы орны.
Dialogue: 0,0:19:30.79,0:19:32.08,Default,,0,0,0,,А...
Dialogue: 0,0:19:32.42,0:19:33.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:34.00,0:19:35.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:39.46,0:19:42.97,Default,,0,0,0,,Жарайсың Cisco! Біз Әлемдік Лигаға қатысамыз!
Dialogue: 0,0:19:43.05,0:19:45.64,Default,,0,0,0,,Мен түсіндім. Мен түсінемін, сондықтан жіберіңіз!
Dialogue: 0,0:19:45.72,0:19:46.72,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:19:47.60,0:19:50.02,Default,,0,0,0,,Қатысып үлгерсеңіз, көңіліңіз қалмаңыз!
Dialogue: 0,0:19:50.52,0:19:53.23,Default,,0,0,0,,Trad Бүгінгідей жақсы емес пе?
Dialogue: 0,0:19:54.06,0:19:55.90,Default,,0,0,0,,Жарайсыңдар бәріңе
Dialogue: 0,0:19:55.98,0:19:58.73,Default,,0,0,0,,(Барлығының қуаныш дауысы)
Dialogue: 0,0:19:58.82,0:19:59.99,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:20:01.03,0:20:05.70,Default,,0,0,0,,Ал, бәріміз, шайқастан кейін көңілді тамақ ішетін кез келді!
Dialogue: 0,0:20:11.12,0:20:12.16,Default,,0,0,0,,Хмм!
Dialogue: 0,0:20:13.67,0:20:15.71,Default,,0,0,0,,Бұл пицца керемет.
Dialogue: 0,0:20:16.63,0:20:19.71,Default,,0,0,0,,Жеңістен кейінгі мереке ерекше.
Dialogue: 0,0:20:20.21,0:20:23.93,Default,,0,0,0,,Балалар, сендер талғампазырақ тамақтана алмайсыңдар ма?
Dialogue: 0,0:20:24.34,0:20:28.26,Default,,0,0,0,,Ахаха Стэн гамбургер жеп отыр!
Dialogue: 0,0:20:28.60,0:20:31.39,Default,,0,0,0,,Бұл Стэн Гамбург!
Dialogue: 0,0:20:31.81,0:20:34.52,Default,,0,0,0,,Түсіндім! Гамбург!
Dialogue: 0,0:20:34.60,0:20:37.19,Default,,0,0,0,,Бұл рас, Стэн Гамбург!
Dialogue: 0,0:20:38.02,0:20:39.65,Default,,0,0,0,,Шулы!
Dialogue: 0,0:20:40.07,0:20:41.11,Default,,0,0,0,,Барт
Dialogue: 0,0:20:41.19,0:20:42.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.49,0:20:44.11,Default,,0,0,0,,Мен сізге қоңырау шалып тұрмын.
Dialogue: 0,0:20:45.49,0:20:46.82,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:20:46.91,0:20:48.99,Default,,0,0,0,,Мүмкін бұл Шу шығар.
Dialogue: 0,0:20:49.08,0:20:51.08,Default,,0,0,0,,Эх! Шуу?
Dialogue: 0,0:20:51.33,0:20:54.04,Default,,0,0,0,,Сәлем Шуу? Қалайсың?
Dialogue: 0,0:20:54.46,0:20:55.92,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:20:56.29,0:20:59.88,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:59.96,0:21:01.46,Default,,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:21:02.34,0:21:03.30,Default,,0,0,0,,Вакия?
Dialogue: 0,0:21:03.38,0:21:06.76,Default,,0,0,0,,Дүниежүзілік лигада сізге қарсы ойнауды асыға күтемін!
Dialogue: 0,0:21:06.84,0:21:09.76,Default,,0,0,0,,О, мен міндетті түрде жеңілмеймін!
Dialogue: 0,0:21:09.85,0:21:12.10,Default,,0,0,0,,Мен сені шақырдым.
Dialogue: 0,0:21:12.72,0:21:15.14,Default,,0,0,0,,Бұл не? Ол не үшін?
Dialogue: 0,0:21:15.73,0:21:17.60,Default,,0,0,0,,Жоқ... Шұғана...
Dialogue: 0,0:21:18.11,0:21:21.19,Default,,0,0,0,,Не? Сіз Шуды кездестірдіңіз бе? Қалайсың?
Dialogue: 0,0:21:21.28,0:21:23.61,Default,,0,0,0,,Шынымен, Шумен танысыңыз!
Dialogue: 0,0:21:24.28,0:21:27.07,Default,,0,0,0,,Жоқ, ол жоғалды.
Dialogue: 0,0:21:27.66,0:21:29.07,Default,,0,0,0,,Иә? не?
Dialogue: 0,0:21:29.16,0:21:30.78,Default,,0,0,0,,Оран... Иә?
Dialogue: 0,0:21:30.87,0:21:32.37,Default,,0,0,0,,Шу нені білдіреді?
Dialogue: 0,0:21:32.45,0:21:34.62,Default,,0,0,0,,Өйткені, Шу ғайып болды.
Dialogue: 0,0:21:35.12,0:21:39.17,Default,,0,0,0,,Ол Нью-Йорк Буллздан жоғалып кетті, мен оның болашағын не күтіп тұрғанын білмеймін.
Dialogue: 0,0:21:39.50,0:21:42.09,Default,,0,0,0,,Не? (Рантаро) Иә? Неліктен?
Dialogue: 0,0:21:43.38,0:21:46.47,Default,,0,0,0,,Шу кетті ме?
Dialogue: 0,0:21:55.89,0:21:58.35,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.44,0:22:01.77,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.86,0:22:04.74,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.82,0:22:06.82,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:06.90,0:22:10.62,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.70,0:22:14.24,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.33,0:22:16.08,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.16,0:22:17.96,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.04,0:22:19.79,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.88,0:22:21.50,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.75,0:22:23.55,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.63,0:22:26.01,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.09,0:22:29.01,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.09,0:22:32.72,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.80,0:22:36.43,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.56,0:22:38.27,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.35,0:22:41.44,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.52,0:22:43.90,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:43.98,0:22:47.57,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.65,0:22:51.07,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.16,0:22:53.03,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.12,0:22:54.87,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:54.95,0:22:58.46,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.54,0:23:00.33,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.42,0:23:03.54,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.63,0:23:05.80,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.88,0:23:09.80,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.88,0:23:13.47,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.55,0:23:17.02,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.10,0:23:20.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.48,0:23:22.19,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.27,0:23:25.15,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.27,0:23:25.15,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.15,0:23:25.48,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.53,0:23:29.03,Default,,0,0,0,,Мексикада Кузаны кездестіреміз
Dialogue: 0,0:23:29.11,0:23:32.57,Default,,0,0,0,,Уакия мен Динамен бірге жылан шұңқырын көздеп алайық!
Dialogue: 0,0:23:32.66,0:23:35.95,Default,,0,0,0,,Біздің алдымызда бетперде киген адам шығады.
Dialogue: 0,0:23:36.03,0:23:38.62,Default,,0,0,0,,Не? Шу өлді ме?
Dialogue: 0,0:23:38.70,0:23:41.62,Default,,0,0,0,,Жақсы да, жаман да бар, Қызыл көз!
Dialogue: 0,0:23:42.08,0:23:44.21,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:44.29,0:23:45.79,Default,,0,0,0,,Шуды тап
Dialogue: 0,0:23:45.88,0:23:49.88,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.38,0:23:57.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory