Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.25,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.09,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:19.97,0:00:24.35,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:24.94,0:00:29.52,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:31.40,0:00:34.57,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.82,0:00:36.95,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:38.37,0:00:40.41,Default,,0,0,0,,Еуропа лигасының финалдық ойыны!
Dialogue: 0,0:00:40.49,0:00:43.37,Default,,0,0,0,,Біздің қарсылас – Британдық Корольдік клуб!
Dialogue: 0,0:00:43.66,0:00:46.88,Default,,0,0,0,,Бізді муай-тай шебері Газем қинады.
Dialogue: 0,0:00:46.96,0:00:48.59,Default,,0,0,0,,Әйтеуір жеңдік!
Dialogue: 0,0:00:48.67,0:00:51.96,Default,,0,0,0,,Сізге рахмет, BC Sol Әлемдік лигаға қатысуға шешім қабылдады.
Dialogue: 0,0:00:52.26,0:00:53.51,Default,,0,0,0,,Ятта!
Dialogue: 0,0:00:54.13,0:00:58.72,Default,,0,0,0,,Бірақ қатты толқыған бізді керемет оқиға күтіп тұрды.
Dialogue: 0,0:00:58.93,0:01:01.10,Default,,0,0,0,,Шу Саядан жоғалып кетті.
Dialogue: 0,0:01:01.51,0:01:05.44,Default,,0,0,0,,Ол Нью-Йорк Буллздан жоғалып кетті, мен оның болашағын не күтіп тұрғанын білмеймін.
Dialogue: 0,0:01:05.85,0:01:08.44,Default,,0,0,0,,Не? (Рантаро) Иә? Неліктен?
Dialogue: 0,0:01:09.65,0:01:12.94,Default,,0,0,0,,Шу... кетті ме?
Dialogue: 0,0:01:13.36,0:01:16.11,Default,,0,0,0,,♪~
Dialogue: 0,0:01:16.20,0:01:18.66,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:18.74,0:01:21.12,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:21.20,0:01:23.58,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:23.66,0:01:26.00,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:26.08,0:01:27.83,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:27.92,0:01:32.13,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:33.05,0:01:37.80,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:37.88,0:01:42.39,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:42.89,0:01:47.64,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:47.73,0:01:52.65,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:01:52.73,0:01:57.61,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:01:57.70,0:02:02.58,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:02.66,0:02:06.04,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:06.12,0:02:07.58,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:07.66,0:02:10.25,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:10.33,0:02:12.54,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:12.63,0:02:14.63,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:14.71,0:02:16.17,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:16.26,0:02:17.63,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:17.72,0:02:20.05,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:20.14,0:02:26.39,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:26.47,0:02:30.73,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:30.81,0:02:33.65,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:33.73,0:02:35.98,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:36.07,0:02:38.65,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:38.74,0:02:42.16,Default,,0,0,0,,~♪
Dialogue: 0,0:02:38.74,0:02:42.16,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:42.16,0:02:42.95,Default,,0,0,0,,~♪
Dialogue: 0,0:02:44.58,0:02:46.08,Default,,0,0,0,,Шуды тап
Dialogue: 0,0:02:48.91,0:02:50.33,Default,,0,0,0,,Америка лигасы
Dialogue: 0,0:02:50.42,0:02:53.71,Default,,0,0,0,,«Нью-Йорк Буллз» осы маусымда бірінші орында...
Dialogue: 0,0:02:53.79,0:02:56.21,Default,,0,0,0,,Куришумен таныстыру!
Dialogue: 0,0:02:56.30,0:02:58.46,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:58.55,0:03:02.39,Default,,0,0,0,,Қатарынан жеңіспен қарқын алып келе жатқан Мексикаға қарсы
Dialogue: 0,0:03:02.47,0:03:05.22,Default,,0,0,0,,BC Олмек Хосе!
Dialogue: 0,0:03:05.68,0:03:08.73,Default,,0,0,0,,Команданың жеңуі немесе жеңілуі маңызды емес.
Dialogue: 0,0:03:08.81,0:03:11.14,Default,,0,0,0,,Мен сені ұруға келдім.
Dialogue: 0,0:03:11.60,0:03:12.90,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:03:12.98,0:03:14.77,Default,,0,0,0,,Айтқыңыз келгені осы ғана ма?
Dialogue: 0,0:03:15.32,0:03:17.78,Default,,0,0,0,,Бірінші ойын Бірінші шайқас
Dialogue: 0,0:03:18.86,0:03:20.70,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:03:20.78,0:03:23.99,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:03:24.12,0:03:26.53,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:28.04,0:03:29.54,Default,,0,0,0,,Сәтті соққы!
Dialogue: 0,0:03:29.62,0:03:32.04,Default,,0,0,0,,Спригган Шынымен тегіс үдеу.
Dialogue: 0,0:03:33.67,0:03:34.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:39.38,0:03:42.93,Default,,0,0,0,,Күшті финиш Күтілгендей, Куришу күшті!
Dialogue: 0,0:03:46.47,0:03:49.52,Default,,0,0,0,,Бұл Шудың жоғалар алдындағы соңғы шайқасы.
Dialogue: 0,0:03:50.06,0:03:52.44,Default,,0,0,0,,Шудың күші басым.
Dialogue: 0,0:03:52.85,0:03:55.27,Default,,0,0,0,,Мықты болсаң неге жоғалдың?
Dialogue: 0,0:03:56.61,0:04:00.24,Default,,0,0,0,,Әдеттегіден басқаша, Шуу.
Dialogue: 0,0:04:01.44,0:04:03.40,Default,,0,0,0,,Көп ойланбаңыз
Dialogue: 0,0:04:03.49,0:04:06.57,Default,,0,0,0,,Жақында Шумен кездесеміз, солай ма? Уакия
Dialogue: 0,0:04:07.12,0:04:08.83,Default,,0,0,0,,О, мұны сізге қалдыратын кез келді!
Dialogue: 0,0:04:09.04,0:04:10.83,Default,,0,0,0,,Мен қазір...
Dialogue: 0,0:04:10.91,0:04:12.33,Default,,0,0,0,,(Ұшақ дыбысы)
Dialogue: 0,0:04:12.41,0:04:13.58,Default,,0,0,0,,Мексика!
Dialogue: 0,0:04:14.79,0:04:16.38,Default,,0,0,0,,Мексика?
Dialogue: 0,0:04:17.54,0:04:20.55,Default,,0,0,0,,Біздің Комурасаки тобы бүкіл әлемге таралуда.
Dialogue: 0,0:04:20.63,0:04:25.01,Default,,0,0,0,,Іздеу нәтижесінде шын мәнінде 300% ықтималдық бар
Dialogue: 0,0:04:25.09,0:04:27.89,Default,,0,0,0,,Шу Гаорун Мексикада болуы керек!
Dialogue: 0,0:04:28.89,0:04:30.60,Default,,0,0,0,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:04:30.68,0:04:32.02,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:32.10,0:04:35.06,Default,,0,0,0,,Жарайды, мен сізден сұрайын, неге Мексика?
Dialogue: 0,0:04:35.31,0:04:37.61,Default,,0,0,0,,Шындығында, бірнеше жыл бұрын.
Dialogue: 0,0:04:37.69,0:04:40.78,Default,,0,0,0,,Бұл дүние жүзіндегі пышақшылар арасында қауесетке айналды.
Dialogue: 0,0:04:40.86,0:04:43.36,Default,,0,0,0,,Жұмбақ құпия жаттығу алаңы бар.
Dialogue: 0,0:04:43.74,0:04:46.28,Default,,0,0,0,,Бұл Мексикада үнемі болып тұрады.
Dialogue: 0,0:04:46.70,0:04:47.70,Default,,0,0,0,,Сыбыс?
Dialogue: 0,0:04:47.91,0:04:48.99,Default,,0,0,0,,Жұмбақ?
Dialogue: 0,0:04:49.45,0:04:50.33,Default,,0,0,0,,Құпия?
Dialogue: 0,0:04:50.79,0:04:52.62,Default,,0,0,0,,Бұл өтірік~
Dialogue: 0,0:04:52.70,0:04:54.58,Default,,0,0,0,,Жігіттер, шағымданыңдар!
Dialogue: 0,0:04:55.04,0:04:59.88,Default,,0,0,0,,Бірақ егер бұл қауесет, жұмбақ немесе құпия болса, ықтималдық 1000% емес.
Dialogue: 0,0:04:59.96,0:05:02.67,Default,,0,0,0,,Рұқсатсыз 300 немесе 300 қоспаңыз!
Dialogue: 0,0:05:02.76,0:05:05.59,Default,,0,0,0,,Эй, Вакия құпия жаттығу алаңы дегеніміз не?
Dialogue: 0,0:05:06.43,0:05:08.68,Default,,0,0,0,,Жасырын жаттығу алаңы дегеніміз не?
Dialogue: 0,0:05:09.93,0:05:12.14,Default,,0,0,0,,Әдетте «жылан шұңқыры» деп аталады.
Dialogue: 0,0:05:12.60,0:05:14.39,Default,,0,0,0,,Жылан шұңқыры?
Dialogue: 0,0:05:15.27,0:05:18.48,Default,,0,0,0,,Жапон тіліне аударғанда «жылан тесігі» дегенді білдіреді.
Dialogue: 0,0:05:19.15,0:05:20.06,Default,,0,0,0,,Жылан?
Dialogue: 0,0:05:20.94,0:05:22.48,Default,,0,0,0,,Жылан шұңқыры Хана
Dialogue: 0,0:05:22.57,0:05:25.61,Default,,0,0,0,,Ең жоғарғы шұңқырды жасау
Dialogue: 0,0:05:25.95,0:05:28.45,Default,,0,0,0,,Тарихтағы ең қатыгез Бейблейд
Dialogue: 0,0:05:28.53,0:05:31.41,Default,,0,0,0,,Қараңғы және жұмбақ жаттығу алаңы туралы әңгімелеу.
Dialogue: 0,0:05:31.99,0:05:35.75,Default,,0,0,0,,Тіпті өз алдына жер асты турнирі бар ма?
Dialogue: 0,0:05:40.92,0:05:43.13,Default,,0,0,0,,Ең жақсы қуық?
Dialogue: 0,0:05:43.46,0:05:48.13,Default,,0,0,0,,Өз күшін меңгергісі келетін адам ол жаққа барғысы келетініне сенімдімін.
Dialogue: 0,0:05:48.68,0:05:50.93,Default,,0,0,0,,Сонда Шу дейсіз бе?
Dialogue: 0,0:05:51.30,0:05:52.31,Default,,0,0,0,,Тек
Dialogue: 0,0:05:52.39,0:05:53.31,Default,,0,0,0,,Сіз оны қалай тапқаныңызды білсем бола ма?
Dialogue: 0,0:05:53.39,0:05:54.89,Default,,0,0,0,,Мен жай ғана қызықпын.
Dialogue: 0,0:05:55.27,0:05:58.69,Default,,0,0,0,,Мен сонда барамын дегенімде ішке кіріп ғайып болдым.
Dialogue: 0,0:05:58.77,0:06:01.86,Default,,0,0,0,,Бірде-бір дүйсенбі оралмаған дейді.
Dialogue: 0,0:06:02.07,0:06:03.23,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:06:03.32,0:06:04.40,Default,,0,0,0,,Сәлем Уакия
Dialogue: 0,0:06:04.61,0:06:07.24,Default,,0,0,0,,Шудың барғанына дәлел бар ма?
Dialogue: 0,0:06:07.32,0:06:09.20,Default,,0,0,0,,Иә, қандай дәлелдер бар?
Dialogue: 0,0:06:09.45,0:06:10.62,Default,,0,0,0,,Дәлелдер...
Dialogue: 0,0:06:11.62,0:06:13.20,Default,,0,0,0,,Дәлел дегеніміз не?
Dialogue: 0,0:06:14.66,0:06:15.66,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:06:15.75,0:06:16.75,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:17.46,0:06:21.67,Default,,0,0,0,,Балалар, менің айтқанымды естісеңдер, Шу мұны істеген болар деп ойлайсыңдар, солай ма?
Dialogue: 0,0:06:22.04,0:06:26.13,Default,,0,0,0,,Иә, Шу күшейе түсуге ерекше көңіл бөлді.
Dialogue: 0,0:06:26.96,0:06:29.18,Default,,0,0,0,,Көру – сену
Dialogue: 0,0:06:29.38,0:06:32.64,Default,,0,0,0,,Мен Мексика аспанына дейін ұшып бара жатырмын!
Dialogue: 0,0:06:43.36,0:06:45.78,Default,,0,0,0,,Құштарлық елі Мексикадан күткендей.
Dialogue: 0,0:06:46.44,0:06:47.90,Default,,0,0,0,,Күн жарқырап тұр!
Dialogue: 0,0:06:48.44,0:06:49.82,Default,,0,0,0,,Аджи
Dialogue: 0,0:06:50.03,0:06:53.03,Default,,0,0,0,,Тыныш отырсаң да тітіркеніп кетесің.
Dialogue: 0,0:06:53.12,0:06:55.79,Default,,0,0,0,,Ыстық Жапониядан өзгеше.
Dialogue: 0,0:06:55.99,0:06:58.96,Default,,0,0,0,,А, балмұздақ же.
Dialogue: 0,0:06:59.16,0:07:01.04,Default,,0,0,0,,Алдымен Шуды табыңыз!
Dialogue: 0,0:07:01.37,0:07:03.17,Default,,0,0,0,,Балалар, асығыңыздар!
Dialogue: 0,0:07:03.58,0:07:06.00,Default,,0,0,0,,Жарайды, қонақ үйге барайық, жарай ма?
Dialogue: 0,0:07:06.09,0:07:07.30,Default,,0,0,0,,Ертең асығыңыз!
Dialogue: 0,0:07:12.59,0:07:13.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:15.01,0:07:15.81,Default,,0,0,0,,Ha
Dialogue: 0,0:07:17.14,0:07:18.72,Default,,0,0,0,,Пю~
Dialogue: 0,0:07:19.14,0:07:20.35,Default,,0,0,0,,Хаха
Dialogue: 0,0:07:20.44,0:07:21.73,Default,,0,0,0,,Ах! Әлгі жігіт!
Dialogue: 0,0:07:21.81,0:07:23.27,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:07:24.11,0:07:25.31,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:07:25.40,0:07:28.36,Default,,0,0,0,,Енді, Кузаның алғашқы пайда болуы осында!
Dialogue: 0,0:07:28.44,0:07:30.57,Default,,0,0,0,,Ең соңында керемет мәре!
Dialogue: 0,0:07:30.65,0:07:32.28,Default,,0,0,0,,Аяқтау!
Dialogue: 0,0:07:32.36,0:07:35.03,Default,,0,0,0,,Оны Адам Бейблейді деп атаңыз
Dialogue: 0,0:07:35.16,0:07:36.33,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:38.45,0:07:40.79,Default,,0,0,0,,(Таңдану дауысы)
Dialogue: 0,0:07:42.75,0:07:43.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:43.92,0:07:45.42,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:07:45.54,0:07:47.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:47.17,0:07:48.50,Default,,0,0,0,,Теңгерілген типтен күткендей
Dialogue: 0,0:07:48.80,0:07:50.67,Default,,0,0,0,,Бұл Куза болды Рахмет
Dialogue: 0,0:07:50.76,0:07:52.01,Default,,0,0,0,,Аригато Аригато
Dialogue: 0,0:07:52.13,0:07:54.05,Default,,0,0,0,,Сәлем, сәлем!
Dialogue: 0,0:07:55.34,0:07:57.43,Default,,0,0,0,,Оның Германиядан екеніне сенімдісіз бе?
Dialogue: 0,0:07:57.64,0:07:59.43,Default,,0,0,0,,Бұл Топванттан келген Куза.
Dialogue: 0,0:07:59.52,0:08:02.31,Default,,0,0,0,,Кері түсірілімді көруге тұрарлық.
Dialogue: 0,0:08:02.39,0:08:04.23,Default,,0,0,0,,Сәлем! Куза!
Dialogue: 0,0:08:04.69,0:08:05.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:05.81,0:08:07.98,Default,,0,0,0,,О, Балто! О, менің!
Dialogue: 0,0:08:08.07,0:08:09.53,Default,,0,0,0,,Балто Балто
Dialogue: 0,0:08:11.40,0:08:13.95,Default,,0,0,0,,Достар табу үшін Мексикаға келіңіз.
Dialogue: 0,0:08:14.32,0:08:16.70,Default,,0,0,0,,Сүйікті болма, Куришу!
Dialogue: 0,0:08:17.33,0:08:19.37,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:08:19.66,0:08:22.29,Default,,0,0,0,,Сіз әлемді аралап, өнер көрсетесіз бе?
Dialogue: 0,0:08:22.75,0:08:25.54,Default,,0,0,0,,Жартысы дұрыс жартысы қате
Dialogue: 0,0:08:25.92,0:08:26.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:26.88,0:08:28.25,Default,,0,0,0,,Муша жаттығуы
Dialogue: 0,0:08:28.34,0:08:32.80,Default,,0,0,0,,Әртүрлі елдерде әртүрлі трюктар көрсетсек, біз де көңілді боламыз, бәрі де көңілді болады.
Dialogue: 0,0:08:33.17,0:08:36.76,Default,,0,0,0,,Жылан шұңқырында жауынгер ретінде жаттығатыныңыз рас па?
Dialogue: 0,0:08:37.35,0:08:38.93,Default,,0,0,0,,Жылан шұңқыры?
Dialogue: 0,0:08:39.26,0:08:40.81,Default,,0,0,0,,Бұл Бейдің командасы ма?
Dialogue: 0,0:08:41.06,0:08:42.27,Default,,0,0,0,,Чау Чау
Dialogue: 0,0:08:42.56,0:08:45.39,Default,,0,0,0,,Сіз бұл есімді бір жерден естідіңіз бе?
Dialogue: 0,0:08:45.77,0:08:47.15,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:08:47.48,0:08:48.98,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:49.07,0:08:51.44,Default,,0,0,0,,-да? Жылан шұңқыры дегеніміз не?
Dialogue: 0,0:08:51.53,0:08:52.78,Default,,0,0,0,,Қызық көрінеді!
Dialogue: 0,0:08:52.86,0:08:55.45,Default,,0,0,0,,Мұның сізге еш қатысы жоқ.
Dialogue: 0,0:09:00.08,0:09:01.20,Default,,0,0,0,,(компьютер дыбысы)
Dialogue: 0,0:09:01.66,0:09:04.16,Default,,0,0,0,,Ой, қарашы, дұрыс айтасың!
Dialogue: 0,0:09:04.62,0:09:06.25,Default,,0,0,0,,О? көрейік?
Dialogue: 0,0:09:06.67,0:09:07.63,Default,,0,0,0,,О!
Dialogue: 0,0:09:08.25,0:09:09.25,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:09:09.38,0:09:10.71,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:10.80,0:09:14.01,Default,,0,0,0,,Әуежайға түсер алдында джунглиді кесіп өттіңіз бе?
Dialogue: 0,0:09:14.30,0:09:15.63,Default,,0,0,0,,Мен бұл суретті сол кезде түсіргенмін.
Dialogue: 0,0:09:16.01,0:09:17.93,Default,,0,0,0,,Біртүрлі үлгі бар.
Dialogue: 0,0:09:18.39,0:09:19.85,Default,,0,0,0,,Бұл жылан!
Dialogue: 0,0:09:20.93,0:09:22.22,Default,,0,0,0,,Бұл күдікті емес пе?
Dialogue: 0,0:09:22.31,0:09:24.73,Default,,0,0,0,,Мен ертең таңертең осында барамын.
Dialogue: 0,0:09:30.23,0:09:33.69,Default,,0,0,0,,Кеттік! Жындар немесе жыландар бола ма?
Dialogue: 0,0:09:33.78,0:09:36.24,Default,,0,0,0,,Әрине бұл жылан, жай жыланның шұңқыры.
Dialogue: 0,0:09:36.32,0:09:38.11,Default,,0,0,0,,Әй, ондай сөздерді айтпа
Dialogue: 0,0:09:38.36,0:09:39.32,Default,,0,0,0,,(Шукуна) Бұл жалықтырады. Егер менің орнымды алмақ болсаң, іске кіріс.
Dialogue: 0,0:09:39.53,0:09:40.66,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:09:41.95,0:09:43.41,Default,,0,0,0,,Жүрейік.
Dialogue: 0,0:09:43.87,0:09:45.16,Default,,0,0,0,,Куза!
Dialogue: 0,0:09:45.79,0:09:47.92,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:09:48.04,0:09:51.63,Default,,0,0,0,,Хахахаха Қызық көрінеді Жылан шұңқыры
Dialogue: 0,0:09:52.09,0:09:53.59,Default,,0,0,0,,Мені де өзіңмен бірге ала кет.
Dialogue: 0,0:09:53.84,0:09:55.05,Default,,0,0,0,,Ақан Ақан
Dialogue: 0,0:09:55.13,0:09:59.05,Default,,0,0,0,,Ешбір жылқының жілігін білмейтін сен сияқты адамды аламын ба?
Dialogue: 0,0:09:59.30,0:10:02.89,Default,,0,0,0,,Сараң болма, бір шымшым керек болады.
Dialogue: 0,0:10:03.51,0:10:05.10,Default,,0,0,0,,Тацузэ Тацузэ
Dialogue: 0,0:10:06.77,0:10:08.48,Default,,0,0,0,,Жарайсың ба? Уакия
Dialogue: 0,0:10:08.56,0:10:11.61,Default,,0,0,0,,Дәл қазір мүмкіндігінше көп достар болғаны дұрыс емес пе?
Dialogue: 0,0:10:12.40,0:10:15.40,Default,,0,0,0,,Менің қолымнан келмейді, Хона, мен сені осында алып келдім.
Dialogue: 0,0:10:16.24,0:10:18.32,Default,,0,0,0,,Ұшақта сабырлы болыңыз.
Dialogue: 0,0:10:18.40,0:10:21.16,Default,,0,0,0,,Бұл құс саңғырығы. Айналаңа жайсаң, бәрі шығады.
Dialogue: 0,0:10:21.24,0:10:23.62,Default,,0,0,0,,Хаха~ Мен білемін.
Dialogue: 0,0:10:24.83,0:10:27.96,Default,,0,0,0,,(Ұшақ дыбысы)
Dialogue: 0,0:10:28.04,0:10:31.08,Default,,0,0,0,,Енді түсуге дайындалайық.
Dialogue: 0,0:10:31.50,0:10:34.17,Default,,0,0,0,,Не? Сіз осылай түсесіз бе?
Dialogue: 0,0:10:34.25,0:10:37.17,Default,,0,0,0,,Көздеген жерден түсер жер жоқ.
Dialogue: 0,0:10:43.05,0:10:44.81,Default,,0,0,0,,Осы жерден жүріңіз.
Dialogue: 0,0:10:44.89,0:10:48.52,Default,,0,0,0,,Аа, сен осы жерде жүрсің бе?
Dialogue: 0,0:10:48.60,0:10:50.77,Default,,0,0,0,,Жақсы! Бұл ақымақ!
Dialogue: 0,0:10:51.10,0:10:54.44,Default,,0,0,0,,Карл осында болғанша, оны майшыларға қалдырыңыз!
Dialogue: 0,0:10:57.19,0:10:58.32,Default,,0,0,0,,О
Dialogue: 0,0:10:58.40,0:11:01.36,Default,,0,0,0,,Ол жігіт маған үнемі бағыт-бағдар береді.
Dialogue: 0,0:11:01.45,0:11:04.12,Default,,0,0,0,,Болды, кеттік.
Dialogue: 0,0:11:16.71,0:11:17.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:19.84,0:11:21.13,Default,,0,0,0,,Мен адасып қалдым.
Dialogue: 0,0:11:21.22,0:11:22.64,Default,,0,0,0,,Е...
Dialogue: 0,0:11:22.93,0:11:24.89,Default,,0,0,0,,Чаттана Чаттана
Dialogue: 0,0:11:24.97,0:11:27.64,Default,,0,0,0,,Чаттана емес, ақымақ құс!
Dialogue: 0,0:11:28.14,0:11:31.27,Default,,0,0,0,,Уайымдамаңыз, мұндай нәрсе болуы мүмкін.
Dialogue: 0,0:11:31.35,0:11:34.86,Default,,0,0,0,,Әуежайға оралу үшін нанды жыртып тастадым.
Dialogue: 0,0:11:34.98,0:11:36.94,Default,,0,0,0,,О! Шынымен бе?
Dialogue: 0,0:11:38.11,0:11:39.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.32,0:11:41.86,Default,,0,0,0,,Эй, еш жерде.
Dialogue: 0,0:11:41.95,0:11:43.32,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:11:43.41,0:11:45.03,Default,,0,0,0,,(Түкірген жұтынған дауыс)
Dialogue: 0,0:11:45.53,0:11:47.79,Default,,0,0,0,,Кешіріңіз, Карл оны жеп отырды.
Dialogue: 0,0:11:47.87,0:11:49.50,Default,,0,0,0,,Не?!
Dialogue: 0,0:11:50.00,0:11:53.17,Default,,0,0,0,,Не, балалар, мүлдем пайдасызсыңдар ма?
Dialogue: 0,0:11:53.50,0:11:55.58,Default,,0,0,0,,Біз адасып қалдық па?
Dialogue: 0,0:11:55.67,0:11:57.50,Default,,0,0,0,,Осындай джунглиде...
Dialogue: 0,0:11:58.75,0:12:00.05,Default,,0,0,0,,Ауыр! ! ! !
Dialogue: 0,0:12:03.05,0:12:04.97,Default,,0,0,0,,Ей, жылан жақсы!
Dialogue: 0,0:12:05.05,0:12:06.89,Default,,0,0,0,,Хайки Хайки
Dialogue: 0,0:12:07.30,0:12:11.10,Default,,0,0,0,,Балалар, бұл пайдалы ма, жоқ па білмеймін.
Dialogue: 0,0:12:13.06,0:12:16.56,Default,,0,0,0,,Бұлай болса, мен ол жыланның орнын міндетті түрде табамын!
Dialogue: 0,0:12:17.48,0:12:20.78,Default,,0,0,0,,Шу міндетті түрде сонда!
Dialogue: 0,0:12:22.95,0:12:23.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:25.78,0:12:27.03,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:12:28.78,0:12:30.24,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:12:39.13,0:12:41.80,Default,,0,0,0,,Бұл біз басқа жаққа өте аламыз дегенді білдіреді.
Dialogue: 0,0:12:41.88,0:12:42.88,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:12:43.30,0:12:44.68,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:12:44.84,0:12:47.14,Default,,0,0,0,,Мұны мен үшін жасаңыз! Мен ең жақсымын!
Dialogue: 0,0:12:47.47,0:12:49.85,Default,,0,0,0,,Сен ақымақсың ба? It's time to stop doing that!
Dialogue: 0,0:12:50.22,0:12:51.22,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:51.31,0:12:52.85,Default,,0,0,0,,Уайымдамаңыз! Уайымдама!
Dialogue: 0,0:12:52.93,0:12:53.77,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:12:54.10,0:12:56.23,Default,,0,0,0,,Уау! Мен Хонмаға бардым
Dialogue: 0,0:12:56.48,0:13:00.07,Default,,0,0,0,,Уау! Yahoo! ! !
Dialogue: 0,0:13:00.15,0:13:02.82,Default,,0,0,0,,Уау хахахаха!
Dialogue: 0,0:13:04.24,0:13:05.36,Default,,0,0,0,,Йотто!
Dialogue: 0,0:13:06.74,0:13:10.20,Default,,0,0,0,,Бұл қызықты. Барлығы, тез келіңдер!
Dialogue: 0,0:13:10.49,0:13:12.54,Default,,0,0,0,,Кеттік, Карл! Міне, барасың
Dialogue: 0,0:13:13.41,0:13:14.50,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:13:15.41,0:13:17.75,Default,,0,0,0,,Маған сәби қанаттары керек
Dialogue: 0,0:13:18.42,0:13:19.75,Default,,0,0,0,,Уау
Dialogue: 0,0:13:20.13,0:13:22.25,Default,,0,0,0,,Бұл жақсы!
Dialogue: 0,0:13:28.64,0:13:29.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:30.26,0:13:31.85,Default,,0,0,0,,Амал жоқ, амал жоқ, амал жоқ!
Dialogue: 0,0:13:32.47,0:13:34.27,Default,,0,0,0,,Сәлем Уакия!
Dialogue: 0,0:13:34.60,0:13:37.14,Default,,0,0,0,,Шығарыңыз!
Dialogue: 0,0:13:37.52,0:13:38.69,Default,,0,0,0,,Don't make it easy!
Dialogue: 0,0:13:38.77,0:13:41.27,Default,,0,0,0,,Егер мен мұны істей алсам, мен мұны бұрыннан жасаған болар едім!
Dialogue: 0,0:13:41.52,0:13:43.40,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:13:43.61,0:13:46.15,Default,,0,0,0,,Уакия биіктіктен қорқады.
Dialogue: 0,0:13:46.24,0:13:48.74,Default,,0,0,0,,Вакия Мен оны қалдырамын.
Dialogue: 0,0:13:49.03,0:13:50.74,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:50.83,0:13:52.54,Default,,0,0,0,,Сәттілік Вакия!
Dialogue: 0,0:13:52.87,0:13:56.37,Default,,0,0,0,,Қолынан келгенін істей алатындар бар, істей алмайтындар бар.
Dialogue: 0,0:13:57.12,0:13:59.42,Default,,0,0,0,,Хмм, мен көмектесе алмаймын.
Dialogue: 0,0:13:59.50,0:14:02.00,Default,,0,0,0,,Ууууууууууууууууу?
Dialogue: 0,0:14:02.13,0:14:03.42,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:14:03.96,0:14:06.17,Default,,0,0,0,,Сіз қашан...
Dialogue: 0,0:14:06.26,0:14:07.93,Default,,0,0,0,,Ой!
Dialogue: 0,0:14:11.18,0:14:13.93,Default,,0,0,0,,Тоқта! Егер сіз сонда жүрсеңіз, көңіліңіз қалады.
Dialogue: 0,0:14:14.01,0:14:16.02,Default,,0,0,0,,Арқан дірілдеп тұр!
Dialogue: 0,0:14:16.10,0:14:19.06,Default,,0,0,0,,Тоқта, тоқта, тоқта!
Dialogue: 0,0:14:19.35,0:14:22.57,Default,,0,0,0,,Анашым!
Dialogue: 0,0:14:23.57,0:14:26.78,Default,,0,0,0,,Хмм... Ақан Ммм... Бұл шек.
Dialogue: 0,0:14:27.19,0:14:28.78,Default,,0,0,0,,Мен қазір үйге бара жатырмын
Dialogue: 0,0:14:28.86,0:14:31.37,Default,,0,0,0,,Егер сіз осы уақытқа дейін жеткен болсаңыз, мақсатқа жетуіңіз керек.
Dialogue: 0,0:14:31.66,0:14:34.16,Default,,0,0,0,,Дұрыс, сені Шу күтіп тұр.
Dialogue: 0,0:14:34.41,0:14:36.08,Default,,0,0,0,,Жүріңдер, тұрыңдар.
Dialogue: 0,0:14:37.58,0:14:39.33,Default,,0,0,0,,Маған басқа күні қиналуға рұқсат етіңіз
Dialogue: 0,0:14:39.75,0:14:43.42,Default,,0,0,0,,Жеңілсең Шуу... Мен сені кешіремін.
Dialogue: 0,0:14:46.96,0:14:49.97,Default,,0,0,0,,Балалар, сендердің араларыңда куришуу қандай?
Dialogue: 0,0:14:50.05,0:14:51.84,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:14:51.93,0:14:53.39,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:53.72,0:14:58.56,Default,,0,0,0,,Жарайды, ол бәрінің қарсыласы, сонымен қатар ол ең күшті қарсылас.
Dialogue: 0,0:14:59.23,0:15:00.48,Default,,0,0,0,,Қарсылас?
Dialogue: 0,0:15:00.56,0:15:02.19,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,0:15:02.86,0:15:06.82,Default,,0,0,0,,Шу екеуміз бала кезден доспыз, талай рет ұрысқанбыз.
Dialogue: 0,0:15:07.07,0:15:09.40,Default,,0,0,0,,Шу шынымен күшті.
Dialogue: 0,0:15:09.74,0:15:14.37,Default,,0,0,0,,Ол Спригган деген биді пайдаланады, ал Жапонияда оны төрт-он патша деп атайды.
Dialogue: 0,0:15:15.20,0:15:18.75,Default,,0,0,0,,Шуудың тағы бір кереметі бар!
Dialogue: 0,0:15:19.04,0:15:20.54,Default,,0,0,0,,Эй, не?
Dialogue: 0,0:15:20.62,0:15:21.71,Default,,0,0,0,,Неаполитан!
Dialogue: 0,0:15:21.79,0:15:22.58,Default,,0,0,0,,Зуко!
Dialogue: 0,0:15:22.67,0:15:23.92,Default,,0,0,0,,Неаполитан?
Dialogue: 0,0:15:24.00,0:15:26.21,Default,,0,0,0,,А, бұл өте жақсы!
Dialogue: 0,0:15:26.30,0:15:28.59,Default,,0,0,0,,Шумен кездессем, мен оны маған жасап беремін.
Dialogue: 0,0:15:28.84,0:15:30.55,Default,,0,0,0,,Бұл тамақ па?
Dialogue: 0,0:15:30.67,0:15:31.63,Default,,0,0,0,,О
Dialogue: 0,0:15:31.72,0:15:34.60,Default,,0,0,0,,Неаполитан Мен оны көргім келеді
Dialogue: 0,0:15:35.05,0:15:38.77,Default,,0,0,0,,Бұл тамаша. Балалық шақтағы дос және қарсылас, неаполитан.
Dialogue: 0,0:15:39.39,0:15:42.06,Default,,0,0,0,,Мен тез арада Куришюмен кездескім келеді.
Dialogue: 0,0:15:42.14,0:15:43.56,Default,,0,0,0,,Ах Ах
Dialogue: 0,0:15:46.73,0:15:48.53,Default,,0,0,0,,Карл бірдеңе тапқан сияқты.
Dialogue: 0,0:15:49.28,0:15:50.49,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:15:55.07,0:15:55.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:02.54,0:16:03.75,Default,,0,0,0,,шықты
Dialogue: 0,0:16:04.67,0:16:06.25,Default,,0,0,0,,Керемет жаңалық!
Dialogue: 0,0:16:06.34,0:16:08.88,Default,,0,0,0,,Бұл жыланның шұңқыры ма?
Dialogue: 0,0:16:09.17,0:16:10.88,Default,,0,0,0,,Бұл жерде күмән жоқ.
Dialogue: 0,0:16:11.01,0:16:12.01,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:16:12.55,0:16:15.72,Default,,0,0,0,,Айналадағы ағаштар бұл ғимаратты жасырады.
Dialogue: 0,0:16:16.10,0:16:17.68,Default,,0,0,0,,Біз ішке кіре аламыз ба?
Dialogue: 0,0:16:17.93,0:16:19.01,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:16:19.31,0:16:20.77,Default,,0,0,0,,Уайымдамаңыз! Уайымдама!
Dialogue: 0,0:16:20.85,0:16:22.52,Default,,0,0,0,,Кірмеңіз!
Dialogue: 0,0:16:32.90,0:16:36.03,Default,,0,0,0,,Сәлем! Бұл жыланның шұңқыры ма?
Dialogue: 0,0:16:36.53,0:16:39.20,Default,,0,0,0,,Ей, оған дейін кірісейік, солай ма?
Dialogue: 0,0:16:39.54,0:16:42.04,Default,,0,0,0,,Эй, сен неге бетперде киіп жүрсің?
Dialogue: 0,0:16:42.12,0:16:43.33,Default,,0,0,0,,Цукетенно?
Dialogue: 0,0:16:45.87,0:16:47.79,Default,,0,0,0,,Ештеңе айтпа!
Dialogue: 0,0:16:48.04,0:16:50.92,Default,,0,0,0,,Сәлем! Мына жерде Шу деген жігіт бар, солай ма?
Dialogue: 0,0:16:51.21,0:16:53.05,Default,,0,0,0,,Мен Шумен танысқым келеді.
Dialogue: 0,0:16:53.51,0:16:54.55,Default,,0,0,0,,Мавару үшін!
Dialogue: 0,0:16:55.05,0:16:55.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:55.93,0:16:57.05,Default,,0,0,0,,(Жер дыбысы)
Dialogue: 0,0:17:00.35,0:17:01.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:01.77,0:17:02.77,Default,,0,0,0,,Не!
Dialogue: 0,0:17:02.85,0:17:04.48,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:17:10.32,0:17:11.98,Default,,0,0,0,,Шығанақ стадионы
Dialogue: 0,0:17:12.28,0:17:15.28,Default,,0,0,0,,Демек, бұл жыланның шұңқыры.
Dialogue: 0,0:17:15.61,0:17:18.03,Default,,0,0,0,,Егер сіз шайқаста жеңсеңіз, жауап беруді қалайсыз ба?
Dialogue: 0,0:17:20.91,0:17:24.71,Default,,0,0,0,,Жарайды, мен істеймін. Егер мен жеңсем, мен сізге жауап беремін.
Dialogue: 0,0:17:27.25,0:17:31.00,Default,,0,0,0,,Мен Балто Аоимын, ал Бей - Құдай Валькири.
Dialogue: 0,0:17:32.71,0:17:34.01,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:17:35.22,0:17:36.22,Default,,0,0,0,,Қызыл көз
Dialogue: 0,0:17:37.05,0:17:38.43,Default,,0,0,0,,Қызыл көз?
Dialogue: 0,0:17:38.72,0:17:41.72,Default,,0,0,0,,Менің бейім - аңызға айналған Спригган
Dialogue: 0,0:17:41.97,0:17:42.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:43.06,0:17:44.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:44.35,0:17:45.52,Default,,0,0,0,,Не болды!
Dialogue: 0,0:17:46.35,0:17:47.69,Default,,0,0,0,,Спригган?
Dialogue: 0,0:17:48.35,0:17:51.02,Default,,0,0,0,,Неліктен сізде Шудың Сприганы бар?
Dialogue: 0,0:17:51.61,0:17:53.11,Default,,0,0,0,,Куришуу өлді!
Dialogue: 0,0:17:54.15,0:17:55.07,Default,,0,0,0,,Ггаааах!
Dialogue: 0,0:17:55.40,0:17:56.32,Default,,0,0,0,,Не!
Dialogue: 0,0:17:56.40,0:17:57.57,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:17:58.11,0:17:59.20,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:18:00.41,0:18:01.62,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:18:02.03,0:18:03.70,Default,,0,0,0,,Ол әлсіз болды
Dialogue: 0,0:18:03.79,0:18:05.79,Default,,0,0,0,,Бұл Spriggan үшін жарамсыз
Dialogue: 0,0:18:06.71,0:18:08.87,Default,,0,0,0,,Сондықтан мен оны қолданамын
Dialogue: 0,0:18:10.21,0:18:12.59,Default,,0,0,0,,Мен бұл жігіттің күшін шығарамын.
Dialogue: 0,0:18:12.92,0:18:15.38,Default,,0,0,0,,Өйткені, ол осында келді.
Dialogue: 0,0:18:16.80,0:18:18.01,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:18:19.80,0:18:21.01,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:18:22.22,0:18:23.31,Default,,0,0,0,,Шу?
Dialogue: 0,0:18:24.22,0:18:25.93,Default,,0,0,0,,Мен сенбеймін!
Dialogue: 0,0:18:26.60,0:18:28.23,Default,,0,0,0,,Өлгені өтірік
Dialogue: 0,0:18:29.19,0:18:30.73,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:18:32.19,0:18:33.27,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:18:33.36,0:18:35.69,Default,,0,0,0,,Егер мен жеңсем, мен өзімнің Спригганымды қайтарамын.
Dialogue: 0,0:18:38.28,0:18:39.36,Default,,0,0,0,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,0:18:41.07,0:18:44.08,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:44.74,0:18:48.16,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:53.75,0:18:54.55,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:18:54.88,0:18:55.96,Default,,0,0,0,,Сол түсірілім...
Dialogue: 0,0:18:56.05,0:18:56.96,Default,,0,0,0,,О
Dialogue: 0,0:18:57.05,0:18:58.22,Default,,0,0,0,,Жерді соғу
Dialogue: 0,0:18:58.30,0:19:02.72,Default,,0,0,0,,Бұл күшті атыс қаруына беру және ұшыру құралын одан әрі итеру арқылы,
Dialogue: 0,0:19:02.80,0:19:05.35,Default,,0,0,0,,Ол шығанаққа орасан зор айналу күшін берді.
Dialogue: 0,0:19:13.40,0:19:16.15,Default,,0,0,0,,Жүр! Валькириге шабуыл!
Dialogue: 0,0:19:29.75,0:19:31.25,Default,,0,0,0,,Ол ұшып кетті ме?
Dialogue: 0,0:19:33.33,0:19:34.46,Default,,0,0,0,,Тағы бір рет
Dialogue: 0,0:19:35.38,0:19:36.30,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:40.22,0:19:41.05,Default,,0,0,0,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,0:19:43.05,0:19:45.89,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:46.56,0:19:48.64,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:52.56,0:19:53.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:56.44,0:19:57.77,Default,,0,0,0,,Солға бұрылыңыз!
Dialogue: 0,0:19:57.86,0:19:59.57,Default,,0,0,0,,Жаңа ғана оңға бұрылды.
Dialogue: 0,0:19:59.65,0:20:02.95,Default,,0,0,0,,Эй, эй, оңға да, солға да айнала ма?
Dialogue: 0,0:20:04.62,0:20:06.58,Default,,0,0,0,,Бұл қалай мүмкін?
Dialogue: 0,0:20:07.20,0:20:10.54,Default,,0,0,0,,Мен соққанға дейін бірдеңе істеп жүр едім, мүмкін осыған байланысты ма?
Dialogue: 0,0:20:16.42,0:20:18.71,Default,,0,0,0,,Валькириге қарағанда қатыгез
Dialogue: 0,0:20:18.80,0:20:20.55,Default,,0,0,0,,Ол керемет қатыгез ат.
Dialogue: 0,0:20:27.39,0:20:29.06,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:20:36.61,0:20:38.52,Default,,0,0,0,,Күте тұрыңыз, Валькири!
Dialogue: 0,0:20:40.65,0:20:41.90,Default,,0,0,0,,Спригган
Dialogue: 0,0:20:43.53,0:20:44.74,Default,,0,0,0,,(жалынның дыбысы)
Dialogue: 0,0:20:55.12,0:20:56.38,Default,,0,0,0,,Балта ату
Dialogue: 0,0:21:11.31,0:21:13.73,Default,,0,0,0,,Цу... күшті...
Dialogue: 0,0:21:16.19,0:21:17.23,Default,,0,0,0,,Шығу
Dialogue: 0,0:21:20.77,0:21:21.94,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:21:23.78,0:21:24.99,Default,,0,0,0,,Күте алсаңыз!
Dialogue: 0,0:21:25.57,0:21:27.07,Default,,0,0,0,,Жеңілгендердің құндылығы жоқ
Dialogue: 0,0:21:28.03,0:21:30.08,Default,,0,0,0,,Шуға да солай айттыңыз ба?
Dialogue: 0,0:21:32.24,0:21:34.96,Default,,0,0,0,,Шуу қайда? Айтыңызшы!
Dialogue: 0,0:21:41.30,0:21:43.88,Default,,0,0,0,,Спригганды Шуға қайтарыңыз!
Dialogue: 0,0:21:45.51,0:21:48.84,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:55.89,0:21:58.35,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.44,0:22:01.90,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.98,0:22:04.78,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.86,0:22:06.95,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.03,0:22:10.53,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.62,0:22:14.24,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.33,0:22:16.12,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.20,0:22:17.91,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.00,0:22:19.88,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.96,0:22:21.54,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.79,0:22:23.55,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.63,0:22:26.01,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.13,0:22:29.05,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.13,0:22:32.72,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.85,0:22:36.52,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.60,0:22:38.27,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.35,0:22:41.52,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.61,0:22:43.94,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.02,0:22:47.49,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.57,0:22:51.11,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.20,0:22:53.12,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.20,0:22:54.91,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:54.99,0:22:58.46,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.54,0:23:00.42,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.50,0:23:03.54,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.63,0:23:05.84,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.92,0:23:09.84,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.93,0:23:13.51,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.60,0:23:17.02,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.10,0:23:20.48,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.56,0:23:22.23,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.31,0:23:25.15,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.31,0:23:25.15,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.15,0:23:25.52,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.82,0:23:29.78,Default,,0,0,0,,Қызыл көзді қуып келе жатқанда бізді не күтіп тұрды?
Dialogue: 0,0:23:29.86,0:23:31.70,Default,,0,0,0,,Бұл бетперде киген жұмбақ әскер болды.
Dialogue: 0,0:23:32.49,0:23:35.66,Default,,0,0,0,,Бізге тура бізге ұқсайтын Қара шығанақ келе жатыр.
Dialogue: 0,0:23:36.58,0:23:39.66,Default,,0,0,0,,Бұл жігіттерді жеңіп, алға ұмтылудан басқа амалымыз жоқ!
Dialogue: 0,0:23:40.29,0:23:42.58,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:42.83,0:23:45.17,Default,,0,0,0,,Тозақ! Жылан шұңқыры!
Dialogue: 0,0:23:45.38,0:23:49.34,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.84,0:23:56.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory