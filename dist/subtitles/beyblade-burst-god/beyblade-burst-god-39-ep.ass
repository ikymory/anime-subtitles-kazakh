Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:05.04,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:07.00,0:00:09.25,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.34,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:16.59,Default,,0,0,0,,Бұрылыс
Dialogue: 0,0:00:16.72,0:00:17.72,Default,,0,0,0,,Поп
Dialogue: 0,0:00:17.85,0:00:18.85,Default,,0,0,0,,Ұшу
Dialogue: 0,0:00:18.97,0:00:20.43,Default,,0,0,0,,Жарылыс
Dialogue: 0,0:00:20.72,0:00:24.06,Default,,0,0,0,,Даңқты жеңіске қол жеткіз
Dialogue: 0,0:00:24.64,0:00:27.86,Default,,0,0,0,,Шайқастың сыртында сіз оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.94,0:00:29.94,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:31.53,0:00:33.53,Default,,0,0,0,,BC Sol-қа еркін қайтару
Dialogue: 0,0:00:34.15,0:00:37.49,Default,,0,0,0,,Көп нәрсе болды, бірақ фрилансер әлі де біздің досымыз.
Dialogue: 0,0:00:38.03,0:00:40.58,Default,,0,0,0,,Қайтып келгеніңізге өте қуаныштымын!
Dialogue: 0,0:00:42.04,0:00:43.16,Default,,0,0,0,,Соңында
Dialogue: 0,0:00:43.25,0:00:45.96,Default,,0,0,0,,Әлем чемпионын Құдай Блейдерс кубогы анықтайды.
Dialogue: 0,0:00:46.08,0:00:47.54,Default,,0,0,0,,Жақындап барады
Dialogue: 0,0:00:48.04,0:00:50.46,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:00:53.13,0:00:54.34,Default,,0,0,0,,О~
Dialogue: 0,0:00:55.01,0:00:56.55,Default,,0,0,0,,Ол аяқталды.
Dialogue: 0,0:01:01.14,0:01:02.35,Default,,0,0,0,,Луис…
Dialogue: 0,0:01:02.43,0:01:06.19,Default,,0,0,0,,Nightmare Longinus шабуыл түрі солға айналдыру болып табылады.
Dialogue: 0,0:01:07.02,0:01:08.35,Default,,0,0,0,,Қалай күресу керек?
Dialogue: 0,0:01:08.61,0:01:09.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:26.66,0:01:28.25,Default,,0,0,0,,Солға және оңға айналу ғана емес
Dialogue: 0,0:01:28.33,0:01:30.88,Default,,0,0,0,,Шабуыл, төзімділік және қорғаныс ауысуы
Dialogue: 0,0:01:30.96,0:01:32.30,Default,,0,0,0,,Барлығы тамаша
Dialogue: 0,0:01:32.84,0:01:35.38,Default,,0,0,0,,Аяқтау деңгейі күтілгеннен де жақсы, Ашрам мырза.
Dialogue: 0,0:01:36.34,0:01:40.30,Default,,0,0,0,,Спригган-Реквиемді әлемдегі ең күшті шығанаққа айналдыру
Dialogue: 0,0:01:40.39,0:01:43.56,Default,,0,0,0,,Енді мен оған соңғы нүктені қоямын.
Dialogue: 0,0:01:44.52,0:01:50.52,Default,,0,0,0,,♪~
Dialogue: 0,0:01:58.95,0:02:03.08,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:04.08,0:02:08.79,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:08.92,0:02:13.71,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:13.92,0:02:18.63,Default,,0,0,0,,Жалынды жүрек ұйықтамайды, Майданға құмар.
Dialogue: 0,0:02:18.76,0:02:23.72,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:23.81,0:02:28.56,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:28.69,0:02:33.73,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:33.94,0:02:38.70,Default,,0,0,0,,Қазір ат!
Dialogue: 0,0:02:38.78,0:02:41.20,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:41.28,0:02:43.45,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:43.83,0:02:48.62,Default,,0,0,0,,Бізге бұрын көрмеген шайқасты көрсет!
Dialogue: 0,0:02:48.91,0:02:51.08,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:51.17,0:02:57.42,Default,,0,0,0,,Әріптесіңізбен үнемі дамып келе жатқан қарым-қатынас пен жүрек соғуымен
Dialogue: 0,0:02:57.51,0:03:01.84,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:01.93,0:03:03.93,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:07.85,0:03:13.86,Default,,0,0,0,,~♪
Dialogue: 0,0:03:24.20,0:03:27.41,Default,,0,0,0,,Уау! Бұл керемет~
Dialogue: 0,0:03:28.16,0:03:29.29,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:03:29.37,0:03:31.79,Default,,0,0,0,,God Bladers кубогы өтеді ме?
Dialogue: 0,0:03:32.75,0:03:36.21,Default,,0,0,0,,Матч өтетін жер бұдан да керемет сияқты.
Dialogue: 0,0:03:36.29,0:03:39.34,Default,,0,0,0,,Мен осы жерден қонақүйге автобуспен барамын.
Dialogue: 0,0:03:39.42,0:03:42.93,Default,,0,0,0,,Барлығының қарны аш болу керек, түскі асты осы жерден ішейік.
Dialogue: 0,0:03:43.80,0:03:45.68,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:03:46.26,0:03:48.39,Default,,0,0,0,,Мен саған ұнаған нәрсені жеуге қарсы емеспін.
Dialogue: 0,0:03:48.47,0:03:50.56,Default,,0,0,0,,Жоғалмаңыз.
Dialogue: 0,0:03:50.81,0:03:53.27,Default,,0,0,0,,Балто, не жегің келеді?
Dialogue: 0,0:03:53.56,0:03:54.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:55.31,0:03:57.32,Default,,0,0,0,,Мен қазір осындамын
Dialogue: 0,0:03:59.73,0:04:00.99,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:04:01.07,0:04:04.24,Default,,0,0,0,,Шынайы гамбургерлер басқа ғой, Аники.
Dialogue: 0,0:04:04.57,0:04:05.32,Default,,0,0,0,,О
Dialogue: 0,0:04:05.41,0:04:07.62,Default,,0,0,0,,Анамның гамбургері де дәмді.
Dialogue: 0,0:04:07.70,0:04:09.87,Default,,0,0,0,,Бұл жігіт өте дәмді!
Dialogue: 0,0:04:09.95,0:04:13.37,Default,,0,0,0,,Американың бірінші балмұздақ дүкені осы жерде.
Dialogue: 0,0:04:13.75,0:04:14.83,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:04:15.38,0:04:17.50,Default,,0,0,0,,Асықпасаң, оның бәрін жей алмайсың.
Dialogue: 0,0:04:19.09,0:04:20.13,Default,,0,0,0,,Иә
Dialogue: 0,0:04:22.97,0:04:23.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:28.47,0:04:31.10,Default,,0,0,0,,Иә? Әлбетте осы жерден
Dialogue: 0,0:04:31.98,0:04:36.48,Default,,0,0,0,,Сіз не істеп жатырсыз? Аники, балмұздақ дүкені ана жақта.
Dialogue: 0,0:04:36.60,0:04:38.98,Default,,0,0,0,,Сіз бұл дыбысты естімейсіз бе?
Dialogue: 0,0:04:39.44,0:04:40.53,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:04:41.19,0:04:42.07,Default,,0,0,0,,Ах
Dialogue: 0,0:04:46.24,0:04:47.70,Default,,0,0,0,,(шұңқырлар соқтығысқан дыбыс)
Dialogue: 0,0:04:47.78,0:04:49.45,Default,,0,0,0,,Бұл Байдың үні ғой.
Dialogue: 0,0:04:49.70,0:04:51.49,Default,,0,0,0,,Біз мұнда шайқасып жатырмыз.
Dialogue: 0,0:04:52.50,0:04:53.62,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:53.71,0:04:56.83,Default,,0,0,0,,Хмф! Оны көтеруге тырыспаңыз
Dialogue: 0,0:04:56.92,0:04:59.29,Default,,0,0,0,,Аники: Бұл мүмкін емес... Уф.
Dialogue: 0,0:04:59.42,0:05:00.63,Default,,0,0,0,,Уау жинақ!
Dialogue: 0,0:05:00.75,0:05:03.13,Default,,0,0,0,,(айқай)
Dialogue: 0,0:05:06.18,0:05:07.51,Default,,0,0,0,,Иә
Dialogue: 0,0:05:07.59,0:05:08.97,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:05:09.35,0:05:11.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:11.39,0:05:13.10,Default,,0,0,0,,Ах, жақсысың ба, Кит?
Dialogue: 0,0:05:13.18,0:05:14.27,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:05:14.77,0:05:15.85,Default,,0,0,0,,​​О?
Dialogue: 0,0:05:15.98,0:05:18.86,Default,,0,0,0,,(сыбырлаған дауыс)
Dialogue: 0,0:05:19.44,0:05:22.48,Default,,0,0,0,,Не? Біртүрлі стадион
Dialogue: 0,0:05:22.73,0:05:25.49,Default,,0,0,0,,Ал бұл жер не деген жер...
Dialogue: 0,0:05:25.61,0:05:27.99,Default,,0,0,0,,(сыбырлаған дауыс)
Dialogue: 0,0:05:34.58,0:05:38.08,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:38.33,0:05:40.71,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:50.09,0:05:52.51,Default,,0,0,0,,Әй, шайқас жалғасуда.
Dialogue: 0,0:05:52.60,0:05:55.31,Default,,0,0,0,,Біз бір уақытта жоғарыда да, төменнен де күресеміз.
Dialogue: 0,0:06:08.24,0:06:09.86,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:10.16,0:06:12.83,Default,,0,0,0,,Мен мұндай шайқасты бірінші рет көріп тұрмын.
Dialogue: 0,0:06:14.04,0:06:14.87,Default,,0,0,0,,Ах
Dialogue: 0,0:06:17.96,0:06:20.67,Default,,0,0,0,,Сабырсыздар ма, қызметшілер?
Dialogue: 0,0:06:21.25,0:06:25.42,Default,,0,0,0,,Біздің император Курц Баратье келді.
Dialogue: 0,0:06:25.55,0:06:27.92,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:28.42,0:06:30.43,Default,,0,0,0,,Курц Баратье?
Dialogue: 0,0:06:34.76,0:06:36.43,Default,,0,0,0,,Декеде!
Dialogue: 0,0:06:38.52,0:06:42.44,Default,,0,0,0,,Ойын уақыты аяқталды, өлім матчы басталды.
Dialogue: 0,0:06:42.56,0:06:44.94,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:45.32,0:06:47.61,Default,,0,0,0,,Біздің император Курц
Dialogue: 0,0:06:47.69,0:06:51.03,Default,,0,0,0,,Қызылша Құқұлқан айуан азу тістерін жалаңаштады.
Dialogue: 0,0:06:51.11,0:06:56.45,Default,,0,0,0,,Мен мына жер асты әлемінде аяусыз дауыл соғамын!
Dialogue: 0,0:06:57.58,0:06:59.96,Default,,0,0,0,,Бұл шығанақ өте керемет
Dialogue: 0,0:07:09.01,0:07:09.92,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:07:10.38,0:07:13.55,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:14.22,0:07:16.22,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:16.85,0:07:18.60,Default,,0,0,0,,Зәулім ғимараттың түсірілімі
Dialogue: 0,0:07:20.64,0:07:21.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:21.98,0:07:22.90,Default,,0,0,0,,Уф (ер) Уау
Dialogue: 0,0:07:25.15,0:07:27.32,Default,,0,0,0,,Ой, бірден бес пе?
Dialogue: 0,0:07:27.40,0:07:28.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:34.45,0:07:35.37,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:07:39.91,0:07:40.83,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:07:41.87,0:07:43.62,Default,,0,0,0,,Біз ертең бастаймыз.
Dialogue: 0,0:07:43.71,0:07:44.38,Default,,0,0,0,,Хажимару
Dialogue: 0,0:07:44.46,0:07:49.05,Default,,0,0,0,,Мен Құдай Бладерс кубогына қатысатын блейдермін!
Dialogue: 0,0:07:49.13,0:07:50.97,Default,,0,0,0,,Пышақтың өлімі!
Dialogue: 0,0:07:55.51,0:07:56.35,Default,,0,0,0,,Ахаха
Dialogue: 0,0:07:57.35,0:07:58.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:58.10,0:07:59.43,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:07:59.68,0:08:02.98,Default,,0,0,0,,Мен Куза Акерманмын, маған қолдау көрсетіңіз.
Dialogue: 0,0:08:03.06,0:08:05.44,Default,,0,0,0,,Йорошику! Йорошику!
Dialogue: 0,0:08:05.86,0:08:08.40,Default,,0,0,0,,Куза Мен қазір кетемін.
Dialogue: 0,0:08:08.48,0:08:09.73,Default,,0,0,0,,Автобусқа ерте мін
Dialogue: 0,0:08:09.82,0:08:10.82,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:08:15.32,0:08:16.78,Default,,0,0,0,,Бұл жай ғана өсек
Dialogue: 0,0:08:16.87,0:08:17.74,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:17.99,0:08:21.33,Default,,0,0,0,,«Құдай Бладерс» кубогына қатысатын жүзушілер арасында
Dialogue: 0,0:08:21.41,0:08:25.00,Default,,0,0,0,,Күтпеген жерден тосын сый шақырылған сияқты.
Dialogue: 0,0:08:25.17,0:08:27.08,Default,,0,0,0,,Бұл күтпеген жерден үлкен ме?
Dialogue: 0,0:08:27.38,0:08:29.55,Default,,0,0,0,,Бұл мен болуым мүмкін бе?
Dialogue: 0,0:08:29.88,0:08:32.63,Default,,0,0,0,,Дұрыс, үлкен балыққа келетін болсақ, бұл Кумичо.
Dialogue: 0,0:08:32.72,0:08:34.05,Default,,0,0,0,,амал жоқ
Dialogue: 0,0:08:34.51,0:08:36.18,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:08:36.26,0:08:37.97,Default,,0,0,0,,…бізге қатты қажетті жігерлі сөздер айтады
Dialogue: 0,0:08:38.05,0:08:41.14,Default,,0,0,0,,Аты аңызға айналған әлем чемпионы туралы да әңгіме бар.
Dialogue: 0,0:08:41.22,0:08:44.31,Default,,0,0,0,,Бұл жай ғана қауесет. Бұл бәрібір өтірік болатыны сөзсіз.
Dialogue: 0,0:08:44.85,0:08:46.56,Default,,0,0,0,,Өсек деген не?
Dialogue: 0,0:08:46.65,0:08:47.56,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:08:48.02,0:08:49.82,Default,,0,0,0,,Балто мен Китті көрмедің бе?
Dialogue: 0,0:08:50.11,0:08:50.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:51.07,0:08:53.32,Default,,0,0,0,,Олар әлі оралмады ма?
Dialogue: 0,0:08:53.95,0:08:55.45,Default,,0,0,0,,Мен қазірдің өзінде қиындыққа тап болдым.
Dialogue: 0,0:08:55.53,0:08:56.32,Default,,0,0,0,,Хаха
Dialogue: 0,0:08:56.61,0:09:00.83,Default,,0,0,0,,Екеуі бейтаныс жерлерге барған жоқ деп үміттенемін.
Dialogue: 0,0:09:01.04,0:09:02.70,Default,,0,0,0,,Біртүрлі нәрсе бар ма?
Dialogue: 0,0:09:02.79,0:09:06.83,Default,,0,0,0,,Жер асты шайқастары болатын жер асты әлемі деген жерде.
Dialogue: 0,0:09:07.38,0:09:09.34,Default,,0,0,0,,Жер асты әлемі?
Dialogue: 0,0:09:09.63,0:09:14.72,Default,,0,0,0,,Егер олар ол жаққа барса, тірі оралмауы мүмкін.
Dialogue: 0,0:09:14.80,0:09:16.72,Default,,0,0,0,,Мені қорқытпа, Зоро.
Dialogue: 0,0:09:16.80,0:09:17.97,Default,,0,0,0,,Хаха
Dialogue: 0,0:09:21.39,0:09:22.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:22.60,0:09:25.69,Default,,0,0,0,,Жеңілгендер, сахнадан жоғалып кетіңдер!
Dialogue: 0,0:09:26.35,0:09:29.69,Default,,0,0,0,,Мен Курц мырзаға қарсы ойнай алғаныма ризамын.
Dialogue: 0,0:09:30.19,0:09:34.19,Default,,0,0,0,,Мен сенің барлық қоқысыңды осында көмемін.
Dialogue: 0,0:09:34.69,0:09:36.86,Default,,0,0,0,,Бей тәркіленді
Dialogue: 0,0:09:37.07,0:09:39.62,Default,,0,0,0,,Жеңілген адам шығанағынан айырылады.
Dialogue: 0,0:09:39.70,0:09:40.87,Default,,0,0,0,,Ku~!
Dialogue: 0,0:09:40.95,0:09:43.83,Default,,0,0,0,,Менің де онымен соғысқым келеді.
Dialogue: 0,0:09:43.91,0:09:45.91,Default,,0,0,0,,Әй, менің айтқанымды естідің бе?
Dialogue: 0,0:09:46.00,0:09:47.96,Default,,0,0,0,,Ал бізде енді уақыт жоқ.
Dialogue: 0,0:09:48.25,0:09:49.46,Default,,0,0,0,,Иә~
Dialogue: 0,0:09:49.88,0:09:52.75,Default,,0,0,0,,Тезірек оралмасаң, Крис саған ашуланады.
Dialogue: 0,0:09:52.84,0:09:53.71,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:09:54.71,0:09:55.55,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:55.67,0:09:57.72,Default,,0,0,0,,Киееееееееееееееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:09:57.80,0:09:59.26,Default,,0,0,0,,Нигеро!
Dialogue: 0,0:09:59.34,0:10:00.47,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:03.35,0:10:05.73,Default,,0,0,0,,Олар қайда кетті?
Dialogue: 0,0:10:05.81,0:10:07.27,Default,,0,0,0,,Ммм (2 адам) Ах.
Dialogue: 0,0:10:07.39,0:10:09.77,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:10.48,0:10:12.36,Default,,0,0,0,,Әлі де кеш емес, екеуің де.
Dialogue: 0,0:10:12.44,0:10:13.77,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:10:14.53,0:10:16.86,Default,,0,0,0,,А... бұл қайда? Ах...
Dialogue: 0,0:10:16.94,0:10:18.86,Default,,0,0,0,,Мен аздап адасып қалдым.
Dialogue: 0,0:10:18.95,0:10:19.78,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:10:20.24,0:10:22.78,Default,,0,0,0,,Тезірек пойызға отырыңыз!
Dialogue: 0,0:10:28.62,0:10:32.13,Default,,0,0,0,,Балт Қараңызшы, бұл керемет көрініс!
Dialogue: 0,0:10:32.75,0:10:34.09,Default,,0,0,0,,Не болды, досым?
Dialogue: 0,0:10:34.17,0:10:36.05,Default,,0,0,0,,Не? А, ештеңе.
Dialogue: 0,0:10:36.96,0:10:40.38,Default,,0,0,0,,Сіз қазір қобалжыған боларсыз, солай ма?
Dialogue: 0,0:10:40.47,0:10:42.43,Default,,0,0,0,,Қобалжымаңыз
Dialogue: 0,0:10:45.35,0:10:47.02,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:51.44,0:10:52.31,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:11:08.50,0:11:12.50,Default,,0,0,0,,Не істеп жатырсың, Балто?
Dialogue: 0,0:11:14.29,0:11:16.00,Default,,0,0,0,,Оны таптыңыз ба?
Dialogue: 0,0:11:16.09,0:11:17.51,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:11:18.05,0:11:19.51,Default,,0,0,0,,Курц Баратье
Dialogue: 0,0:11:20.30,0:11:23.26,Default,,0,0,0,,«Бұрынғы әлемдегі №1 рейтингті қуықшы»
Dialogue: 0,0:11:23.39,0:11:27.39,Default,,0,0,0,,«Ол ешқашан ешкімнен жеңілмеген жеңілмейтін әлем чемпионы болды».
Dialogue: 0,0:11:27.47,0:11:31.27,Default,,0,0,0,,«Бір күні ол кенеттен көпшіліктің көзінен ғайып болады».
Dialogue: 0,0:11:31.64,0:11:33.31,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:11:33.40,0:11:36.57,Default,,0,0,0,,Сондықтан оны «Аңызға айналған әлем чемпионы» деп атайды ма?
Dialogue: 0,0:11:36.65,0:11:39.86,Default,,0,0,0,,Ku~! Аты аңызға айналған әлем чемпионы?
Dialogue: 0,0:11:39.94,0:11:41.45,Default,,0,0,0,,Ол жанып тұр
Dialogue: 0,0:11:41.53,0:11:42.91,Default,,0,0,0,,Мен енді шыдай алмаймын!
Dialogue: 0,0:11:42.99,0:11:43.57,Default,,0,0,0,,Ах
Dialogue: 0,0:11:46.70,0:11:49.16,Default,,0,0,0,,Аники Жоқ!
Dialogue: 0,0:11:49.45,0:11:50.25,Default,,0,0,0,,Хаа~
Dialogue: 0,0:11:50.33,0:11:51.62,Default,,0,0,0,,Сәлем Кит!
Dialogue: 0,0:11:51.71,0:11:52.29,Default,,0,0,0,,Біз оны «арнау» жылдамдығын арттыру туралы айтып жатқанбыз, иә?
Dialogue: 0,0:11:55.21,0:11:57.59,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:12:09.89,0:12:11.98,Default,,0,0,0,,Жоқ! Уау
Dialogue: 0,0:12:12.18,0:12:13.94,Default,,0,0,0,,О...
Dialogue: 0,0:12:14.02,0:12:15.19,Default,,0,0,0,,Қалыңыз~
Dialogue: 0,0:12:15.73,0:12:16.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:22.86,0:12:26.07,Default,,0,0,0,,Мен бұл біртүрлі деп ойладым, бірақ тышқан болып шықты.
Dialogue: 0,0:12:26.49,0:12:29.66,Default,,0,0,0,,Сіз егеуқұйрық емессіз. Мен Балт Аоимын.
Dialogue: 0,0:12:29.74,0:12:31.33,Default,,0,0,0,,BC мүшесі Сол
Dialogue: 0,0:12:31.41,0:12:35.04,Default,,0,0,0,,Мен бұл қалаға Құдай Блейдерс кубогына қатысу үшін келдім.
Dialogue: 0,0:12:35.17,0:12:35.83,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:12:35.92,0:12:37.79,Default,,0,0,0,,Құдай Блейдерс кубогы
Dialogue: 0,0:12:38.38,0:12:39.84,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:39.92,0:12:41.80,Default,,0,0,0,,Бұл жер асты әлемі
Dialogue: 0,0:12:41.88,0:12:44.38,Default,,0,0,0,,Бұл сен сияқты бәйбішелерге орын емес.
Dialogue: 0,0:12:44.72,0:12:47.01,Default,,0,0,0,,Мен сенімен күресе аламын
Dialogue: 0,0:12:47.68,0:12:49.51,Default,,0,0,0,,Менің Валькириіммен жарысыңыз
Dialogue: 0,0:12:50.10,0:12:51.02,Default,,0,0,0,,Эй, кел!
Dialogue: 0,0:12:51.10,0:12:54.35,Default,,0,0,0,,Курц мырзаға не айтып тұрсыз?
Dialogue: 0,0:12:54.44,0:12:56.77,Default,,0,0,0,,Биске, сіз алыс болуыңыз керек.
Dialogue: 0,0:12:56.85,0:12:58.86,Default,,0,0,0,,Не... А, иә.
Dialogue: 0,0:12:59.69,0:13:01.03,Default,,0,0,0,,Сіз Барт сияқты бірдеңе айттыңыз.
Dialogue: 0,0:13:01.40,0:13:02.15,Default,,0,0,0,,О
Dialogue: 0,0:13:02.74,0:13:05.40,Default,,0,0,0,,Жақсы, мен сенімен жарысамын.
Dialogue: 0,0:13:05.91,0:13:06.91,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:13:07.24,0:13:11.16,Default,,0,0,0,,Бірақ жер асты әлемінің ережелерін сақта.
Dialogue: 0,0:13:11.91,0:13:13.91,Default,,0,0,0,,Жер асты әлемінің ережелері?
Dialogue: 0,0:13:14.16,0:13:16.29,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:16.37,0:13:18.17,Default,,0,0,0,,Бір минут күтіңіз! (Барлығы) иә?
Dialogue: 0,0:13:19.04,0:13:21.17,Default,,0,0,0,,Кумичо жинағы
Dialogue: 0,0:13:21.25,0:13:22.30,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:13:22.38,0:13:25.38,Default,,0,0,0,,Қазір мұндай жерге келетін уақыт емес.
Dialogue: 0,0:13:25.80,0:13:26.72,Default,,0,0,0,,Кумичо
Dialogue: 0,0:13:26.80,0:13:30.43,Default,,0,0,0,,Бұл жігіт Курц есімді аты аңызға айналған әлем чемпионы...
Dialogue: 0,0:13:30.51,0:13:32.60,Default,,0,0,0,,Ах, мен Киттен естіп жатырмын.
Dialogue: 0,0:13:32.81,0:13:35.89,Default,,0,0,0,,Бұл жерде нағыз шайқас болып жатыр.
Dialogue: 0,0:13:36.39,0:13:38.23,Default,,0,0,0,,Матч - өлім матчы.
Dialogue: 0,0:13:38.31,0:13:41.73,Default,,0,0,0,,Егер жеңілсең, мен сенің шығаныңды аламын. Бұл ереже.
Dialogue: 0,0:13:41.82,0:13:42.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:42.90,0:13:45.19,Default,,0,0,0,,Мен мұндай ережені естіген емеспін.
Dialogue: 0,0:13:46.28,0:13:48.45,Default,,0,0,0,,Басқа адамнан кешірім сұрамаңыз. Мен үйге барамын.
Dialogue: 0,0:13:49.41,0:13:50.16,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:13:52.08,0:13:54.25,Default,,0,0,0,,Мен осылай тырыстым.
Dialogue: 0,0:13:54.45,0:13:56.71,Default,,0,0,0,,Үйге осылай бара аламын деп ойлайсың ба?
Dialogue: 0,0:13:57.00,0:14:00.04,Default,,0,0,0,,Бұл жағдайда мен сенің қарсыласыңмын, Курц.
Dialogue: 0,0:14:00.13,0:14:02.46,Default,,0,0,0,,Мен бұл өлім матчын немесе басқасын шешемін.
Dialogue: 0,0:14:03.05,0:14:04.17,Default,,0,0,0,,Кумичо
Dialogue: 0,0:14:04.59,0:14:08.68,Default,,0,0,0,,Барт, сені ертең маңызды турнир күтіп тұр.
Dialogue: 0,0:14:08.76,0:14:11.64,Default,,0,0,0,,Мен жеңіліп, Валькириді алып кетсе ше?
Dialogue: 0,0:14:11.97,0:14:13.89,Default,,0,0,0,,Бірақ Кумичо жеңіліп қалды...
Dialogue: 0,0:14:13.97,0:14:17.06,Default,,0,0,0,,Жарайды, аузыңды жап, мұны маған қалдыр.
Dialogue: 0,0:14:17.14,0:14:19.35,Default,,0,0,0,,Басқа адам кім болса да, бәрі бірдей.
Dialogue: 0,0:14:19.48,0:14:22.02,Default,,0,0,0,,Хмм, солай ма?
Dialogue: 0,0:14:25.03,0:14:26.49,Default,,0,0,0,,Кумичо
Dialogue: 0,0:14:30.82,0:14:31.62,Default,,0,0,0,,Хун
Dialogue: 0,0:14:32.16,0:14:35.24,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:35.66,0:14:37.87,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:14:38.00,0:14:38.96,Default,,0,0,0,,Уф
Dialogue: 0,0:14:43.25,0:14:45.09,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:14:47.51,0:14:49.47,Default,,0,0,0,,Найзағай шабуылы!
Dialogue: 0,0:14:58.02,0:14:59.10,Default,,0,0,0,,Кумичо!
Dialogue: 0,0:15:02.81,0:15:04.32,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:15:04.40,0:15:05.98,Default,,0,0,0,,Мен сіздің шығанақты алдым.
Dialogue: 0,0:15:06.07,0:15:06.98,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:07.57,0:15:09.15,Default,,0,0,0,,Тәтті~
Dialogue: 0,0:15:09.24,0:15:10.74,Default,,0,0,0,,Мен мұндай шайқастарды құптамаймын.
Dialogue: 0,0:15:11.78,0:15:12.57,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:15:13.03,0:15:14.99,Default,,0,0,0,,Жеңілген адаммын деме.
Dialogue: 0,0:15:15.95,0:15:17.04,Default,,0,0,0,,Зари
Dialogue: 0,0:15:20.33,0:15:21.08,Default,,0,0,0,,Уф
Dialogue: 0,0:15:29.88,0:15:30.97,Default,,0,0,0,,Кумичо!
Dialogue: 0,0:15:31.05,0:15:31.93,Default,,0,0,0,,О
Dialogue: 0,0:15:32.34,0:15:35.10,Default,,0,0,0,,Мені күт!
Dialogue: 0,0:15:46.94,0:15:48.94,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:15:49.90,0:15:50.90,Default,,0,0,0,,Ах
Dialogue: 0,0:15:52.36,0:15:54.78,Default,,0,0,0,,Аники, енді жоқ
Dialogue: 0,0:15:54.87,0:15:56.74,Default,,0,0,0,,Енді қаша алмайсың.
Dialogue: 0,0:15:57.20,0:15:58.37,Default,,0,0,0,,Балалар
Dialogue: 0,0:15:58.45,0:16:02.00,Default,,0,0,0,,Сіз мұндай нәрсені тегін жасай алмайсыз деп ойлайсыз.
Dialogue: 0,0:16:02.62,0:16:06.13,Default,,0,0,0,,Мен сенің қарсыласыңмын, бұл екеуімен араласпа.
Dialogue: 0,0:16:06.21,0:16:07.38,Default,,0,0,0,,Кумичо
Dialogue: 0,0:16:08.05,0:16:09.21,Default,,0,0,0,,Жаса!
Dialogue: 0,0:16:09.71,0:16:10.34,Default,,0,0,0,,Уау
Dialogue: 0,0:16:10.46,0:16:12.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:12.97,0:16:14.43,Default,,0,0,0,,Және...
Dialogue: 0,0:16:15.26,0:16:16.60,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:17.05,0:16:18.18,Default,,0,0,0,,Барт
Dialogue: 0,0:16:18.56,0:16:19.72,Default,,0,0,0,,Шака!
Dialogue: 0,0:16:20.35,0:16:22.98,Default,,0,0,0,,Әдеттегідей сергіту
Dialogue: 0,0:16:23.10,0:16:24.52,Default,,0,0,0,,Ах (Рантаро) Рувей
Dialogue: 0,0:16:25.02,0:16:28.40,Default,,0,0,0,,Қайда барсаң да, ештеңе істеме.
Dialogue: 0,0:16:28.73,0:16:31.78,Default,,0,0,0,,Жолыма бөгет болсаң, мен аямаймын!
Dialogue: 0,0:16:32.99,0:16:35.28,Default,,0,0,0,,Мына жігіттер бірдеңе айтып тұр.
Dialogue: 0,0:16:35.91,0:16:37.78,Default,,0,0,0,,Ача~! Кел
Dialogue: 0,0:16:39.62,0:16:40.70,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:40.79,0:16:42.79,Default,,0,0,0,,Хмф, қайдан келгеніңіз маңызды емес.
Dialogue: 0,0:16:43.16,0:16:44.25,Default,,0,0,0,,Уф
Dialogue: 0,0:16:44.92,0:16:45.87,Default,,0,0,0,,Жаса!
Dialogue: 0,0:16:45.96,0:16:47.17,Default,,0,0,0,,Жарайды (3 адам) Уф.
Dialogue: 0,0:16:47.42,0:16:48.42,Default,,0,0,0,,Ах
Dialogue: 0,0:16:48.79,0:16:51.84,Default,,0,0,0,,Баланы жайына қалдыр, енді онымен араласпа.
Dialogue: 0,0:16:51.92,0:16:53.05,Default,,0,0,0,,Га
Dialogue: 0,0:16:53.63,0:16:54.93,Default,,0,0,0,,Күте тұрыңыз, Курц.
Dialogue: 0,0:16:57.43,0:16:59.60,Default,,0,0,0,,Мен мұндай шайқасқа шыдамаймын.
Dialogue: 0,0:16:59.89,0:17:00.97,Default,,0,0,0,,Курц?
Dialogue: 0,0:17:01.06,0:17:04.31,Default,,0,0,0,,Бұл шынымен Курц Баратье ме?
Dialogue: 0,0:17:04.89,0:17:07.69,Default,,0,0,0,,Бала сияқты ойнаудан шаршадым.
Dialogue: 0,0:17:08.15,0:17:08.90,Default,,0,0,0,,Не?
Dialogue: 0,0:17:08.98,0:17:10.69,Default,,0,0,0,,Бұл жай ғана балалардың ойыны ма?
Dialogue: 0,0:17:11.03,0:17:12.48,Default,,0,0,0,,Мен әлем чемпионымын
Dialogue: 0,0:17:12.57,0:17:15.45,Default,,0,0,0,,Менен күшті ешкім жоқ.
Dialogue: 0,0:17:16.16,0:17:18.16,Default,,0,0,0,,Бұл көп уақыт бұрын.
Dialogue: 0,0:17:18.70,0:17:19.70,Default,,0,0,0,,Не?
Dialogue: 0,0:17:20.74,0:17:23.87,Default,,0,0,0,,Сізден күшті адамдар көп.
Dialogue: 0,0:17:23.95,0:17:27.33,Default,,0,0,0,,Шақа дұрыс айтады, енді сенің уақытың емес.
Dialogue: 0,0:17:28.96,0:17:30.34,Default,,0,0,0,,Сабыр етіңіз
Dialogue: 0,0:17:32.80,0:17:33.80,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:36.05,0:17:38.14,Default,,0,0,0,,(шұңқырлар соқтығысқан дыбыс)
Dialogue: 0,0:17:40.76,0:17:41.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:42.64,0:17:43.72,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:17:44.18,0:17:45.68,Default,,0,0,0,,Мен қызыл көзмін
Dialogue: 0,0:17:46.10,0:17:48.73,Default,,0,0,0,,Менің Спригган реквиемімен жарысыңыз.
Dialogue: 0,0:17:49.06,0:17:49.77,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:49.86,0:17:51.57,Default,,0,0,0,,Бұл жер қай жерде деп ойлайсыңдар?
Dialogue: 0,0:17:51.65,0:17:53.07,Default,,0,0,0,,Мақтаншақ болма.
Dialogue: 0,0:17:53.53,0:17:56.57,Default,,0,0,0,,Мен сенімен бірден айналысамын. Келіңіздер.
Dialogue: 0,0:17:56.78,0:17:58.24,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,0:17:58.32,0:18:00.16,Default,,0,0,0,,Бұл бала жақсы болуға тырысады.
Dialogue: 0,0:18:00.24,0:18:01.87,Default,,0,0,0,,Мен сенен кек аламын
Dialogue: 0,0:18:05.83,0:18:09.33,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:10.04,0:18:13.30,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:18.05,0:18:19.22,Default,,0,0,0,,Солға айналдыру?
Dialogue: 0,0:18:21.93,0:18:22.81,Default,,0,0,0,,Уау
Dialogue: 0,0:18:29.14,0:18:30.27,Default,,0,0,0,,Қазір барыңыз!
Dialogue: 0,0:18:36.07,0:18:37.19,Default,,0,0,0,,Гах...
Dialogue: 0,0:18:37.28,0:18:38.36,Default,,0,0,0,,Уф~
Dialogue: 0,0:18:41.24,0:18:42.87,Default,,0,0,0,,Бұл қандай күш?
Dialogue: 0,0:18:42.95,0:18:44.54,Default,,0,0,0,,Мен мәселені төменде шешемін.
Dialogue: 0,0:18:47.45,0:18:48.29,Default,,0,0,0,,Хун
Dialogue: 0,0:18:57.34,0:18:58.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:01.51,0:19:02.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:07.43,0:19:08.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:08.48,0:19:09.98,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:19:20.15,0:19:21.99,Default,,0,0,0,,Бітті ме?
Dialogue: 0,0:19:28.16,0:19:28.75,Default,,0,0,0,,Уау
Dialogue: 0,0:19:31.54,0:19:33.04,Default,,0,0,0,,Ку... Курц мырза
Dialogue: 0,0:19:33.13,0:19:34.67,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:19:37.67,0:19:39.67,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:19:41.13,0:19:43.68,Default,,0,0,0,,Эй, мұны кім істеді?
Dialogue: 0,0:19:43.76,0:19:45.39,Default,,0,0,0,,Қызыл көз
Dialogue: 0,0:19:45.89,0:19:47.35,Default,,0,0,0,,Қызыл көз?
Dialogue: 0,0:19:49.43,0:19:52.39,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:19:55.02,0:19:56.02,Default,,0,0,0,,Уф
Dialogue: 0,0:20:03.03,0:20:04.82,Default,,0,0,0,,Okay!
Dialogue: 0,0:20:04.91,0:20:08.45,Default,,0,0,0,,Енді, ең соңында бірінші саңылауды шешейік.
Dialogue: 0,0:20:08.54,0:20:12.62,Default,,0,0,0,,God Bladers кубогы басталғалы тұр!
Dialogue: 0,0:20:12.75,0:20:15.88,Default,,0,0,0,,Чемпион ретінде кім жарқырайды?
Dialogue: 0,0:20:15.96,0:20:20.55,Default,,0,0,0,,Бүкіл әлем назарын аударып отырған ғасырдың ең үлкен үлкен оқиғасы
Dialogue: 0,0:20:20.63,0:20:23.88,Default,,0,0,0,,Біріншіден, ұйымдастырушылар атынан Нью-Йорк Буллз клубының иесі.
Dialogue: 0,0:20:23.97,0:20:27.93,Default,,0,0,0,,Александр Гилтеннің ашылу декларациясы!
Dialogue: 0,0:20:30.89,0:20:34.06,Default,,0,0,0,,Осы тарихи оқиғаны өткізу мүмкіндігімен құттықтаймыз.
Dialogue: 0,0:20:34.14,0:20:35.90,Default,,0,0,0,,Аллаға шүкір
Dialogue: 0,0:20:36.23,0:20:39.15,Default,,0,0,0,,Міне Бейблейд бойынша әлем чемпионы
Dialogue: 0,0:20:39.23,0:20:42.28,Default,,0,0,0,,Ең күшті шығанақты анықтаңыз -
Dialogue: 0,0:20:42.36,0:20:46.16,Default,,0,0,0,,Құдай Блейдерс кубогының ашылуын жариялаңыз
Dialogue: 0,0:20:51.75,0:20:52.87,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:52.96,0:20:57.67,Default,,0,0,0,,Әлемнің түкпір-түкпірінен іріктеліп алынған 12 ең жақсы пышақпен таныстыру.
Dialogue: 0,0:20:59.59,0:21:01.67,Default,,0,0,0,,Тегін Де Ла Хойя
Dialogue: 0,0:21:02.34,0:21:04.17,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:21:04.80,0:21:06.68,Default,,0,0,0,,Cisco Carlyle
Dialogue: 0,0:21:07.18,0:21:09.43,Default,,0,0,0,,Куса Акерман
Dialogue: 0,0:21:10.14,0:21:12.77,Default,,0,0,0,,Келесі, Ширасаги сарайы Луис
Dialogue: 0,0:21:12.85,0:21:14.73,Default,,0,0,0,,Жанып тұрған ғибадатхана Кайза
Dialogue: 0,0:21:14.81,0:21:16.56,Default,,0,0,0,,Лувэй әні
Dialogue: 0,0:21:16.98,0:21:19.11,Default,,0,0,0,,Қосымша Джошуа Бун
Dialogue: 0,0:21:19.19,0:21:21.07,Default,,0,0,0,,Боа Алькасер
Dialogue: 0,0:21:21.15,0:21:22.73,Default,,0,0,0,,Қызыл көз
Dialogue: 0,0:21:22.82,0:21:24.32,Default,,0,0,0,,Норман Тарвер
Dialogue: 0,0:21:26.91,0:21:27.91,Default,,0,0,0,,Хун
Dialogue: 0,0:21:28.74,0:21:29.62,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:21:29.70,0:21:33.87,Default,,0,0,0,,Ең соңғы кіретін адам - арнайы пышақ.
Dialogue: 0,0:21:34.33,0:21:36.08,Default,,0,0,0,,Аты аңызға айналған әлем чемпионы
Dialogue: 0,0:21:36.16,0:21:40.71,Default,,0,0,0,,Курц Баратье~!
Dialogue: 0,0:21:41.25,0:21:42.09,Default,,0,0,0,,Курц!
Dialogue: 0,0:21:42.30,0:21:44.09,Default,,0,0,0,,Иә! Өтірік!
Dialogue: 0,0:21:47.97,0:21:49.09,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:21:55.52,0:21:56.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.52,0:21:59.98,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, дайынсыңдар ма?
Dialogue: 0,0:22:00.11,0:22:02.82,Default,,0,0,0,,Енді күте тұрыңыз, Baysasize 2 уақыты келді.
Dialogue: 0,0:22:02.90,0:22:04.90,Default,,0,0,0,,Қозғалыс 1 нұсқаға қарағанда қарқынды
Dialogue: 0,0:22:04.99,0:22:06.90,Default,,0,0,0,,Showtime бағдарламасының алдыңғы бөліміне шолу жасаудан бастайық!
Dialogue: 0,0:22:06.99,0:22:08.57,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:08.66,0:22:10.57,Default,,0,0,0,,Атуға бар! үлкен
Dialogue: 0,0:22:10.66,0:22:12.28,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:12.37,0:22:14.29,Default,,0,0,0,,Атуға бар! жылдамдату
Dialogue: 0,0:22:14.37,0:22:18.00,Default,,0,0,0,,Атуға бар! Атуға бар! Атуға бар! Атуға бар!
Dialogue: 0,0:22:18.08,0:22:21.42,Default,,0,0,0,,Атуға бар! Атуға бар! Атуға бар! Атуға бар!
Dialogue: 0,0:22:21.54,0:22:22.38,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:22:22.46,0:22:24.80,Default,,0,0,0,,Жақсы, негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.92,0:22:26.63,Default,,0,0,0,,Бірақ бұл одан да күшейе түседі.
Dialogue: 0,0:22:26.76,0:22:29.01,Default,,0,0,0,,Қолдарыңызды көтеріп, кернеңіз.
Dialogue: 0,0:22:29.09,0:22:32.76,Default,,0,0,0,,Атуға бар! Атуға бар! Бей, мен қатты толқып тұрмын
Dialogue: 0,0:22:32.85,0:22:36.39,Default,,0,0,0,,АТЫС! Атуға бар! Менің атуым - құдайдың атысы
Dialogue: 0,0:22:36.48,0:22:40.15,Default,,0,0,0,,Оң жақ ату! Сол жақ ату! Оң жақта ату!
Dialogue: 0,0:22:40.23,0:22:43.77,Default,,0,0,0,,Сол жақ ату! Дұрыс ату! Сол жақпен атыңыз!
Dialogue: 0,0:22:43.86,0:22:47.53,Default,,0,0,0,,Өткен апта Осы аптада біз GO Shoot жасаймыз!
Dialogue: 0,0:22:47.61,0:22:51.07,Default,,0,0,0,,Осы аптада Келесі аптада ол GO Shoot ойнайды!
Dialogue: 0,0:22:51.16,0:22:54.95,Default,,0,0,0,,Күн сайын GO Shoot жаттығуын жасаңыз!
Dialogue: 0,0:22:55.04,0:22:58.46,Default,,0,0,0,,Жыл бойы, көктемде, жазда, күзде және қыста түсіріңіз!
Dialogue: 0,0:22:58.91,0:23:00.04,Default,,0,0,0,,Okay!
Dialogue: 0,0:23:00.12,0:23:02.67,Default,,0,0,0,,Негізгі бұлшықеттерді дамыту үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.79,0:23:05.88,Default,,0,0,0,,Сол шиеленіспен біз шарықтау шегіне жетеміз.
Dialogue: 0,0:23:06.00,0:23:08.92,Default,,0,0,0,,1 2 3 4 АЛТ!
Dialogue: 0,0:23:09.05,0:23:09.67,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:23:09.80,0:23:12.47,Default,,0,0,0,,1 2 3 4 АТТЫ АЛ!
Dialogue: 0,0:23:12.59,0:23:13.18,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:23:13.30,0:23:17.10,Default,,0,0,0,,1 2 3 4 АЛТ! Барайық!
Dialogue: 0,0:23:17.18,0:23:20.56,Default,,0,0,0,,Үш екі, бір ату!
Dialogue: 0,0:23:20.64,0:23:22.23,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.31,0:23:23.31,Default,,0,0,0,,Керемет GO түсірілімі
Dialogue: 0,0:23:23.40,0:23:25.40,Default,,0,0,0,,Керемет Baysasize!
Dialogue: 0,0:23:26.57,0:23:28.32,Default,,0,0,0,,God Bladers кубогы басталады
Dialogue: 0,0:23:29.03,0:23:30.40,Default,,0,0,0,,Cisco-да бар
Dialogue: 0,0:23:30.49,0:23:33.62,Default,,0,0,0,,Вампир Клио сізді қолдау үшін Кусаға келеді.
Dialogue: 0,0:23:33.74,0:23:34.66,Default,,0,0,0,,Достық!
Dialogue: 0,0:23:34.74,0:23:36.41,Default,,0,0,0,,Ал мен үшін...
Dialogue: 0,0:23:36.66,0:23:39.91,Default,,0,0,0,,Е, Кумичо, мен жеңілемін деп айтпа.
Dialogue: 0,0:23:41.16,0:23:43.29,Default,,0,0,0,,Келесі жолы «Beyblade Burst God»
Dialogue: 0,0:23:43.38,0:23:45.67,Default,,0,0,0,,«Тиран! Кукулканды ұр!»
Dialogue: 0,0:23:45.75,0:23:49.30,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.80,0:23:56.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory