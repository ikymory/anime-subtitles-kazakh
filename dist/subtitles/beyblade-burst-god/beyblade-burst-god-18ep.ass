Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.29,0:00:07.00,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.43,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.06,0:00:24.35,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.06,0:00:29.94,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:32.61,0:00:33.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:34.49,0:00:36.57,Default,,0,0,0,,Жұмбақ жылан шұңқыры
Dialogue: 0,0:00:36.87,0:00:40.12,Default,,0,0,0,,Мұнда көптеген жүзгіштер ең күшті болады...
Dialogue: 0,0:00:40.20,0:00:43.08,Default,,0,0,0,,Мен өз шегімнен тыс жаттығып жатырмын.
Dialogue: 0,0:00:43.20,0:00:44.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:44.83,0:00:45.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:46.25,0:00:47.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:48.84,0:00:51.88,Default,,0,0,0,,Аңыз Спригган - керемет шығанақ.
Dialogue: 0,0:00:51.96,0:00:54.42,Default,,0,0,0,,Benishuu үшін жарамсыз.
Dialogue: 0,0:00:54.88,0:00:58.26,Default,,0,0,0,,Қызыл көз бұл рөлге жауапты.
Dialogue: 0,0:00:58.47,0:01:02.60,Default,,0,0,0,,Спригган Шудың серіктесі. Өзімшіл ештеңе жасамаңыз!
Dialogue: 0,0:01:02.72,0:01:04.27,Default,,0,0,0,,Спригганды қайтарыңыз!
Dialogue: 0,0:01:04.68,0:01:08.98,Default,,0,0,0,,Қызыл көзді кездестіргіңіз келсе, құқық үшін күресіңіз.
Dialogue: 0,0:01:10.69,0:01:13.53,Default,,0,0,0,,Және дәл біздің Бей сияқты
Dialogue: 0,0:01:13.61,0:01:16.40,Default,,0,0,0,,Black Bay пайдаланатын Blader пайда болады.
Dialogue: 0,0:01:17.07,0:01:20.74,Default,,0,0,0,,Бірінші кезеңде бізді Сары көз күтіп тұрды.
Dialogue: 0,0:01:21.37,0:01:24.79,Default,,0,0,0,,Бірақ Кумичо бұл шайқаста жеңіліп қалды.
Dialogue: 0,0:01:29.13,0:01:31.04,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:01:31.17,0:01:32.34,Default,,0,0,0,,Ой... уау!
Dialogue: 0,0:01:32.42,0:01:33.51,Default,,0,0,0,,Кумичо!
Dialogue: 0,0:01:38.26,0:01:41.35,Default,,0,0,0,,Мен өзімнің ұсқынсыз жағымды әшкерелей бергім келеді.
Dialogue: 0,0:01:41.76,0:01:43.31,Default,,0,0,0,,Мен мойындаймын.
Dialogue: 0,0:01:43.64,0:01:45.39,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:01:49.90,0:01:51.02,Default,,0,0,0,,Сен!
Dialogue: 0,0:01:51.11,0:01:54.78,Default,,0,0,0,,Есімде дұрыс болса, Қара көз деп аталады. Deathscyzer пайдаланады.
Dialogue: 0,0:01:55.11,0:01:58.28,Default,,0,0,0,,Сонымен? Менімен кім күреседі?
Dialogue: 0,0:01:58.66,0:02:00.95,Default,,0,0,0,,Сіз бұл менмін деп шештіңіз.
Dialogue: 0,0:02:01.24,0:02:03.58,Default,,0,0,0,,Көлеңкелер көлеңке болып қалады!
Dialogue: 0,0:02:04.45,0:02:07.12,Default,,0,0,0,,♪~
Dialogue: 0,0:02:07.21,0:02:09.71,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:09.79,0:02:12.25,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:12.34,0:02:14.75,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:14.84,0:02:17.22,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:17.30,0:02:18.80,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:02:18.88,0:02:23.10,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:24.06,0:02:28.81,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:28.89,0:02:33.36,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:33.90,0:02:38.65,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:38.74,0:02:43.66,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:43.74,0:02:48.62,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:48.71,0:02:53.79,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:53.88,0:02:57.01,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:57.13,0:02:58.72,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:58.80,0:03:01.30,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:03:01.38,0:03:03.60,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:03:03.68,0:03:05.64,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:03:05.72,0:03:07.18,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:03:07.27,0:03:08.68,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:03:08.77,0:03:11.14,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:03:11.23,0:03:17.40,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:03:17.48,0:03:21.78,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:21.86,0:03:24.70,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:24.78,0:03:27.29,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:27.37,0:03:29.62,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:29.70,0:03:33.25,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:29.70,0:03:33.25,Default,,0,0,0,,~♪
Dialogue: 0,0:03:33.25,0:03:33.96,Default,,0,0,0,,~♪
Dialogue: 0,0:03:35.38,0:03:37.92,Default,,0,0,0,,Лабиринт! Қара зындан!
Dialogue: 0,0:03:39.38,0:03:43.64,Default,,0,0,0,,Қара құдай Дина Сіз пайғамбарлықтарға сенесіз бе?
Dialogue: 0,0:03:44.01,0:03:45.72,Default,,0,0,0,,Мен пайғамбарлыққа сенбеймін.
Dialogue: 0,0:03:46.10,0:03:47.89,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:03:48.14,0:03:50.52,Default,,0,0,0,,Бірақ менімен біраз уақыт бірге болыңыз.
Dialogue: 0,0:03:53.44,0:03:56.36,Default,,0,0,0,,Менде болашақты көре алатын күш бар.
Dialogue: 0,0:03:56.90,0:03:58.27,Default,,0,0,0,,Болашақты көресіз бе?
Dialogue: 0,0:03:58.36,0:04:00.15,Default,,0,0,0,,Не айтып тұрсың, мына жігіт!
Dialogue: 0,0:04:00.44,0:04:02.32,Default,,0,0,0,,Табиғаттан тыс күштер дегенді қалай түсінесіңдер?
Dialogue: 0,0:04:02.40,0:04:03.99,Default,,0,0,0,,Ондай нәрсе болуы мүмкін емес.
Dialogue: 0,0:04:05.20,0:04:08.37,Default,,0,0,0,,Сенің болашағыңды көрейік
Dialogue: 0,0:04:08.45,0:04:10.50,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:04:17.38,0:04:20.80,Default,,0,0,0,,Болашақтың бірінші шайқасы шықты...
Dialogue: 0,0:04:20.88,0:04:23.72,Default,,0,0,0,,Артық мәре мен жеңемін!
Dialogue: 0,0:04:25.93,0:04:29.22,Default,,0,0,0,,Қара көздің барлық болжамдары осы уақытқа дейін орындалды.
Dialogue: 0,0:04:29.76,0:04:32.52,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:04:34.77,0:04:36.94,Default,,0,0,0,,Мен осында экскурсия жасаймын.
Dialogue: 0,0:04:37.90,0:04:42.69,Default,,0,0,0,,Боа, мұнда көрген нәрсені жасау немесе бұзу сізге байланысты.
Dialogue: 0,0:04:42.90,0:04:43.95,Default,,0,0,0,,Иә
Dialogue: 0,0:04:44.86,0:04:48.20,Default,,0,0,0,,Мен үшін жеңетінін білетін шайқаспен күресу
Dialogue: 0,0:04:48.28,0:04:50.29,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:04:50.37,0:04:51.58,Default,,0,0,0,,
Dialogue: 0,0:04:51.66,0:04:54.21,Default,,0,0,0,,Сіз маған психологиялық соғыс жүргізгіңіз келетін шығар.
Dialogue: 0,0:04:54.29,0:04:56.08,Default,,0,0,0,,Мен мұндай жағдайға түспеймін.
Dialogue: 0,0:04:56.75,0:05:01.05,Default,,0,0,0,,Психологиялық соғыс бір кездері сіз жақсы болған ұрыс стилі болды.
Dialogue: 0,0:05:01.13,0:05:05.30,Default,,0,0,0,,Бейді көшіріп қоймай, бізді де зерттеген сияқтысыз.
Dialogue: 0,0:05:05.63,0:05:07.14,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:05:07.97,0:05:11.93,Default,,0,0,0,,Жеңіске жету үшін заңсыз әдістерді қолданатын сияқтысыз.
Dialogue: 0,0:05:12.85,0:05:17.31,Default,,0,0,0,,Мұндай адам Killer Death Sizer қолданбасын пайдалануға жарамды ма?
Dialogue: 0,0:05:17.40,0:05:18.19,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:18.60,0:05:22.19,Default,,0,0,0,,Мен Deathsizer-ге енді ешқашан бұзақылық жасамаймын деп ант еттім.
Dialogue: 0,0:05:22.65,0:05:24.57,Default,,0,0,0,,Мен енді сол кездегі адам емеспін.
Dialogue: 0,0:05:26.07,0:05:26.99,Default,,0,0,0,,Дина…
Dialogue: 0,0:05:27.16,0:05:28.32,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:29.32,0:05:30.62,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:05:30.70,0:05:35.20,Default,,0,0,0,,Біз болашақты көре аламыз, тек соған ұмтылу керек.
Dialogue: 0,0:05:35.58,0:05:38.50,Default,,0,0,0,,Оның сөздері сізді шатастырмасын!
Dialogue: 0,0:05:39.88,0:05:41.75,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:05:42.38,0:05:45.42,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:45.72,0:05:48.01,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:01.40,0:06:02.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:03.11,0:06:04.11,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:04.19,0:06:05.69,Default,,0,0,0,,Аяқталды!
Dialogue: 0,0:06:05.99,0:06:07.40,Default,,0,0,0,,Болжағандай.
Dialogue: 0,0:06:07.49,0:06:09.11,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:06:09.66,0:06:12.78,Default,,0,0,0,,Кернеу салдарынан кадр аздап бұлдырады.
Dialogue: 0,0:06:12.87,0:06:14.08,Default,,0,0,0,,Бұл менің қателігім болды.
Dialogue: 0,0:06:14.66,0:06:16.37,Default,,0,0,0,,Болашақ жоқ!
Dialogue: 0,0:06:16.79,0:06:17.62,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:06:17.71,0:06:22.38,Default,,0,0,0,,Келесі - мен болашақты көремін
Dialogue: 0,0:06:22.71,0:06:24.09,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:24.71,0:06:26.38,Default,,0,0,0,,Уайымдама, Дина!
Dialogue: 0,0:06:26.80,0:06:28.59,Default,,0,0,0,,Болашақты көру мүмкін емес!
Dialogue: 0,0:06:28.67,0:06:29.72,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:06:29.80,0:06:31.59,Default,,0,0,0,,Барыңыз, Дина!
Dialogue: 0,0:06:32.35,0:06:35.22,Default,,0,0,0,,Менің артымда сендер тұрсыңдар.
Dialogue: 0,0:06:35.31,0:06:37.35,Default,,0,0,0,,Мен бұлай сезінгеніме біраз болды!
Dialogue: 0,0:06:38.48,0:06:39.35,Default,,0,0,0,,Иә
Dialogue: 0,0:06:39.77,0:06:41.35,Default,,0,0,0,,Менде қазір бәрі жақсы
Dialogue: 0,0:06:41.81,0:06:44.02,Default,,0,0,0,,Келесі шайқас: міндетті түрде жеңіңіз!
Dialogue: 0,0:06:45.86,0:06:48.36,Default,,0,0,0,,Мен өз көлеңкемнен жеңілмеймін
Dialogue: 0,0:06:48.95,0:06:51.70,Default,,0,0,0,,Мен сені көлеңке деуге жол бермеймін.
Dialogue: 0,0:06:52.78,0:06:54.16,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:06:54.78,0:06:56.49,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:06:57.75,0:06:59.25,Default,,0,0,0,,Мен енді алданбаймын
Dialogue: 0,0:06:59.33,0:07:02.83,Default,,0,0,0,,Мен өзімнің Deathsizer-ге сенуім керек!
Dialogue: 0,0:07:02.92,0:07:04.50,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:07:05.00,0:07:08.13,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:08.21,0:07:10.59,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:14.14,0:07:15.68,Default,,0,0,0,,Аң аулау!
Dialogue: 0,0:07:24.98,0:07:26.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:26.11,0:07:28.15,Default,,0,0,0,,Өлтіруші Өлім Сизердің траекториясы үлкен
Dialogue: 0,0:07:28.23,0:07:29.86,Default,,0,0,0,,Сіз қабырғаға соғыласыз!
Dialogue: 0,0:07:30.15,0:07:31.15,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:07:35.28,0:07:36.37,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:07:36.74,0:07:38.95,Default,,0,0,0,,Кирисаке Өлім Сізер!
Dialogue: 0,0:07:41.25,0:07:42.75,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:07:45.13,0:07:47.00,Default,,0,0,0,,Бұл қандай техника?
Dialogue: 0,0:07:47.55,0:07:48.71,Default,,0,0,0,,О
Dialogue: 0,0:07:48.80,0:07:51.84,Default,,0,0,0,,Жарылыс аяқталуы бар өлтіруші өлім өлшемі
Dialogue: 0,0:07:51.92,0:07:53.51,Default,,0,0,0,,Қара құдай әулетінің жеңісі
Dialogue: 0,0:07:53.76,0:07:55.85,Default,,0,0,0,,Керемет, Керемет, Дина!
Dialogue: 0,0:07:55.93,0:07:56.97,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:07:57.31,0:08:00.43,Default,,0,0,0,,Оны Flying Double Strike деп атаңыз!
Dialogue: 0,0:08:00.52,0:08:02.31,Default,,0,0,0,,Мен оны ерікті түрде атай аламын ба?
Dialogue: 0,0:08:02.39,0:08:03.48,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:03.73,0:08:05.19,Default,,0,0,0,,А... бұл өтірік...
Dialogue: 0,0:08:06.15,0:08:08.98,Default,,0,0,0,,Мен болашақты көре білуім керек еді
Dialogue: 0,0:08:09.57,0:08:11.40,Default,,0,0,0,,Болашақ көретін нәрсе емес
Dialogue: 0,0:08:12.65,0:08:14.36,Default,,0,0,0,,Бұл сіз өзіңіз жасайтын нәрсе.
Dialogue: 0,0:08:15.20,0:08:16.32,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:16.95,0:08:19.33,Default,,0,0,0,,Қара көз Кешіріңіз.
Dialogue: 0,0:08:19.54,0:08:22.00,Default,,0,0,0,,Болашағың кеткен сияқты.
Dialogue: 0,0:08:22.08,0:08:24.58,Default,,0,0,0,,Күте тұрыңыз, Ашрам-сама!
Dialogue: 0,0:08:24.67,0:08:26.13,Default,,0,0,0,,Жеңілген адам кетеді
Dialogue: 0,0:08:26.96,0:08:29.00,Default,,0,0,0,,Уау
Dialogue: 0,0:08:30.13,0:08:31.88,Default,,0,0,0,,Ей!
Dialogue: 0,0:08:31.96,0:08:32.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:33.05,0:08:35.64,Default,,0,0,0,,Иә! (Куза) Шығуға қарай жүгір!
Dialogue: 0,0:08:35.89,0:08:37.26,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:08:37.39,0:08:38.97,Default,,0,0,0,,Не болды!
Dialogue: 0,0:08:39.81,0:08:41.64,Default,,0,0,0,,Барлығыңыз, асығыңыздар!
Dialogue: 0,0:08:41.72,0:08:43.89,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:08:43.98,0:08:46.65,Default,,0,0,0,,Әлемдік рейтингті бірден көтеру...
Dialogue: 0,0:08:46.73,0:08:48.77,Default,,0,0,0,,Сіздің мүмкіндігіңіз бар сияқты.
Dialogue: 0,0:08:49.36,0:08:53.53,Default,,0,0,0,,Сіз сол Куришудың досы екеніңізге сенімдісіз бе?
Dialogue: 0,0:08:54.28,0:08:58.41,Default,,0,0,0,,Қалай ойлайсың, Қызыл көз? Сізге келе ме?
Dialogue: 0,0:08:58.74,0:09:00.95,Default,,0,0,0,,Мен пайғамбар емеспін
Dialogue: 0,0:09:01.49,0:09:03.25,Default,,0,0,0,,Хехехехе...
Dialogue: 0,0:09:07.63,0:09:09.75,Default,,0,0,0,,Бұл жерде де керемет көрінеді.
Dialogue: 0,0:09:10.29,0:09:14.13,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:09:15.38,0:09:17.18,Default,,0,0,0,,...Бұл не?
Dialogue: 0,0:09:17.26,0:09:18.34,Default,,0,0,0,,Инелер үйінді!
Dialogue: 0,0:09:18.80,0:09:20.14,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:09:20.22,0:09:21.89,Default,,0,0,0,,Егер сізде жеткілікті болса, бұл!
Dialogue: 0,0:09:22.31,0:09:24.31,Default,,0,0,0,,Мен толқу үстіндемін.
Dialogue: 0,0:09:24.39,0:09:25.73,Default,,0,0,0,,Шитекитар
Dialogue: 0,0:09:26.10,0:09:29.27,Default,,0,0,0,,Сәлем! Бұл стадионда тіреуіш жоқ!
Dialogue: 0,0:09:29.86,0:09:31.65,Default,,0,0,0,,Сіз қалай атасыз?
Dialogue: 0,0:09:31.73,0:09:34.65,Default,,0,0,0,,Оңай голландиялық секіру
Dialogue: 0,0:09:40.74,0:09:42.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:43.24,0:09:44.83,Default,,0,0,0,,Бұл тым үлкен.
Dialogue: 0,0:09:44.91,0:09:47.29,Default,,0,0,0,,Бұл тау! Бұл адам Фудзи тауы!
Dialogue: 0,0:09:47.37,0:09:48.58,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:49.33,0:09:50.92,Default,,0,0,0,,Орекки - сұр көз
Dialogue: 0,0:09:51.34,0:09:53.71,Default,,0,0,0,,Куза, менімен соғыс!
Dialogue: 0,0:09:53.96,0:09:58.38,Default,,0,0,0,,А, Альтер Кронос та күресуге құмар.
Dialogue: 0,0:09:58.47,0:09:59.93,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:10:00.43,0:10:03.60,Default,,0,0,0,,Сіздің қарсыласыңыз - бұл Қара хронос!
Dialogue: 0,0:10:03.97,0:10:05.06,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:10:05.14,0:10:07.94,Default,,0,0,0,,Өйткені, бұл Кроносқа ұқсайды.
Dialogue: 0,0:10:08.60,0:10:11.44,Default,,0,0,0,,Жылан шұңқыры – әлсіздердің олжасы.
Dialogue: 0,0:10:11.73,0:10:14.36,Default,,0,0,0,,Балалар мен сендерді жеймін.
Dialogue: 0,0:10:14.44,0:10:15.99,Default,,0,0,0,,Сенің жегің келе ме?
Dialogue: 0,0:10:16.19,0:10:18.03,Default,,0,0,0,,(терең тыныс алу)
Dialogue: 0,0:10:18.11,0:10:22.45,Default,,0,0,0,,Хмф! иә! Ну! иә!
Dialogue: 0,0:10:22.95,0:10:26.20,Default,,0,0,0,,Мен үлкенмін және күштімін!
Dialogue: 0,0:10:26.75,0:10:29.71,Default,,0,0,0,,Үлкен болу арқылы шайқаста жеңіске жету оңай болар еді.
Dialogue: 0,0:10:29.79,0:10:30.96,Default,,0,0,0,,Дайоне!
Dialogue: 0,0:10:31.75,0:10:32.63,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,0:10:38.38,0:10:41.80,Default,,0,0,0,,Кішкентай болсам да, сенен күштімін.
Dialogue: 0,0:10:42.14,0:10:45.01,Default,,0,0,0,,Мен оны одан сайын езгім келді.
Dialogue: 0,0:10:45.39,0:10:48.60,Default,,0,0,0,,Егер біз оны басып алсақ, жасайық, Үлкен Грей!
Dialogue: 0,0:10:48.93,0:10:51.06,Default,,0,0,0,,Мен сұр көзмін!
Dialogue: 0,0:10:51.15,0:10:54.77,Default,,0,0,0,,Оның үстіне мен жай ғана билікке ие адам емеспін.
Dialogue: 0,0:10:55.78,0:10:59.15,Default,,0,0,0,,Сіз бұл стадионды тек күшпен жеңе алмайсыз.
Dialogue: 0,0:10:59.28,0:11:02.41,Default,,0,0,0,,Қуат пен тепе-теңдік қажет
Dialogue: 0,0:11:04.41,0:11:07.33,Default,,0,0,0,,Оны баспаңыз. Оны мүлдем баспаңыз.
Dialogue: 0,0:11:07.41,0:11:09.04,Default,,0,0,0,,Түсіндім, ақымақ.
Dialogue: 0,0:11:09.12,0:11:11.33,Default,,0,0,0,,Ха ха... Хакушон!
Dialogue: 0,0:11:11.42,0:11:12.88,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,0:11:15.29,0:11:16.67,Default,,0,0,0,,Бұл стадион
Dialogue: 0,0:11:17.00,0:11:21.22,Default,,0,0,0,,Ату үшін орманнан орманға секіру керек пе?
Dialogue: 0,0:11:22.55,0:11:25.64,Default,,0,0,0,,Сен осындай табаннан күшті соққы жасай аласың ба?
Dialogue: 0,0:11:25.93,0:11:27.64,Default,,0,0,0,,Соға алмасаң, ұтыласың.
Dialogue: 0,0:11:28.31,0:11:29.89,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:29.98,0:11:33.98,Default,,0,0,0,,Енді мен не істеуім керек?
Dialogue: 0,0:11:38.36,0:11:40.28,Default,,0,0,0,,Куза қатып қалды
Dialogue: 0,0:11:40.57,0:11:41.99,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:11:42.28,0:11:44.24,Default,,0,0,0,,Бұл туралы ойлама, Куза!
Dialogue: 0,0:11:44.32,0:11:46.87,Default,,0,0,0,,Басыңды жоғалтасың!
Dialogue: 0,0:11:46.95,0:11:48.58,Default,,0,0,0,,Бұл сен емессің!
Dialogue: 0,0:11:48.66,0:11:51.12,Default,,0,0,0,,Кроностың екі режимі бар.
Dialogue: 0,0:11:51.21,0:11:53.67,Default,,0,0,0,,Менің ойымша, сіз қай жолмен жүру керектігін ойлап отырсыз.
Dialogue: 0,0:11:54.25,0:11:58.50,Default,,0,0,0,,Жұмсақ орбитасы және тұрақты ауырлық орталығы бар супер төзімділік режимімен салыстырғанда.
Dialogue: 0,0:11:58.59,0:12:04.18,Default,,0,0,0,,Ауырлық орталығы қатты тұрақсыз супер шабуыл режимі қауіпті
Dialogue: 0,0:12:04.43,0:12:08.64,Default,,0,0,0,,Куза! Супер шабуыл режимі қымбат деп айтылады!
Dialogue: 0,0:12:08.72,0:12:09.77,Default,,0,0,0,,Бұл тәуекел.
Dialogue: 0,0:12:09.85,0:12:11.31,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:12:11.68,0:12:13.48,Default,,0,0,0,,О, бұл қауіпті!
Dialogue: 0,0:12:13.56,0:12:15.60,Default,,0,0,0,,Менің де білетінім осы ғана.
Dialogue: 0,0:12:16.36,0:12:19.73,Default,,0,0,0,,Бірақ толқу одан да қаттырақ, солай емес пе?
Dialogue: 0,0:12:20.23,0:12:22.90,Default,,0,0,0,,Мен супер шабуыл режиміне өтуді жоспарлап отырмын.
Dialogue: 0,0:12:22.99,0:12:24.36,Default,,0,0,0,,Препарат қымбат!
Dialogue: 0,0:12:24.45,0:12:25.41,Default,,0,0,0,,Тәуекел
Dialogue: 0,0:12:25.78,0:12:27.78,Default,,0,0,0,,Сондықтан бұл Куса!
Dialogue: 0,0:12:27.87,0:12:30.87,Default,,0,0,0,,Шабуыл, Куза, Шабуыл! Шабуыл!
Dialogue: 0,0:12:31.29,0:12:35.08,Default,,0,0,0,,Балалар, сендер өз стратегияларыңды қарсыласыңа айта алмайсыңдар!
Dialogue: 0,0:12:35.17,0:12:36.92,Default,,0,0,0,,Эхехе... Кешіріңіз...
Dialogue: 0,0:12:37.33,0:12:40.34,Default,,0,0,0,,Стратегия, т.б. маған қатысы жоқ.
Dialogue: 0,0:12:40.42,0:12:42.17,Default,,0,0,0,,Мен сені үрлеймін!
Dialogue: 0,0:12:42.80,0:12:44.55,Default,,0,0,0,,Егер сіз оны ұшырып жіберсеңіз.
Dialogue: 0,0:12:44.63,0:12:47.14,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:12:48.68,0:12:51.89,Default,,0,0,0,,Жарайды, қауіпті нәрсе жасап көрейік!
Dialogue: 0,0:12:52.39,0:12:53.48,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:54.19,0:12:56.69,Default,,0,0,0,,Міне! не!
Dialogue: 0,0:12:57.15,0:12:58.02,Default,,0,0,0,,Йотто!
Dialogue: 0,0:13:00.27,0:13:01.53,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:13:01.61,0:13:03.07,Default,,0,0,0,,Сіз тым жеңілсіз.
Dialogue: 0,0:13:03.15,0:13:04.32,Default,,0,0,0,,Керемет!
Dialogue: 0,0:13:04.65,0:13:06.20,Default,,0,0,0,,Эй, үлкен сұр!
Dialogue: 0,0:13:06.28,0:13:08.91,Default,,0,0,0,,Эй, мен осы жерден атсам болады ма?
Dialogue: 0,0:13:09.37,0:13:13.16,Default,,0,0,0,,Қай жерде түсірсең де, маған бәрібір.
Dialogue: 0,0:13:13.50,0:13:15.58,Default,,0,0,0,,Жақсы емес пе? рақмет сізге!
Dialogue: 0,0:13:16.25,0:13:19.54,Default,,0,0,0,,Ондай жерден... дымқыл!
Dialogue: 0,0:13:20.17,0:13:22.96,Default,,0,0,0,,ұшыруға дайындық Жарайды!
Dialogue: 0,0:13:23.30,0:13:24.80,Default,,0,0,0,,ұшыруға дайындалып жатырсыз ба?
Dialogue: 0,0:13:25.17,0:13:26.93,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:13:27.01,0:13:30.64,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:13:31.06,0:13:33.02,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:43.82,0:13:46.32,Default,,0,0,0,,Бұл жігіт керемет соққы жасады!
Dialogue: 0,0:13:46.40,0:13:48.57,Default,,0,0,0,,Екеуі де супер шабуыл режимінде!
Dialogue: 0,0:13:48.95,0:13:51.37,Default,,0,0,0,,Кронос!
Dialogue: 0,0:13:52.99,0:13:54.58,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:13:54.70,0:13:55.79,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:13:56.16,0:13:57.54,Default,,0,0,0,,Альтер Кронос
Dialogue: 0,0:13:57.62,0:14:00.63,Default,,0,0,0,,Куса Акерманн мәреге жетіп жеңіске жетті
Dialogue: 0,0:14:00.71,0:14:02.13,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:14:02.88,0:14:06.17,Default,,0,0,0,,Орекчи билікке байланысты қалай жоғалуы мүмкін?
Dialogue: 0,0:14:06.26,0:14:07.93,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:14:08.13,0:14:11.43,Default,,0,0,0,,Менің атуым жердің тартылыс күшін алды.
Dialogue: 0,0:14:11.85,0:14:13.89,Default,,0,0,0,,Жердің тартылыс күші?
Dialogue: 0,0:14:14.35,0:14:18.02,Default,,0,0,0,,Төбені соғу күші құлау жылдамдығына қосылады.
Dialogue: 0,0:14:18.10,0:14:20.02,Default,,0,0,0,,Ату күші артты
Dialogue: 0,0:14:20.44,0:14:23.98,Default,,0,0,0,,Аты-жөні Gravity Shot Нанчичи
Dialogue: 0,0:14:24.44,0:14:27.95,Default,,0,0,0,,Орекки - тартылыс күшіне бой алдырған адам.
Dialogue: 0,0:14:28.57,0:14:30.99,Default,,0,0,0,,Жоқ, мен сенен жеңілдім.
Dialogue: 0,0:14:31.53,0:14:33.03,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:14:34.12,0:14:35.74,Default,,0,0,0,,(Жер дыбысы)
Dialogue: 0,0:14:38.54,0:14:39.50,Default,,0,0,0,,Ей!
Dialogue: 0,0:14:39.92,0:14:41.29,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:14:41.38,0:14:42.92,Default,,0,0,0,,Бұл шынымен рас па?
Dialogue: 0,0:14:43.04,0:14:46.01,Default,,0,0,0,,Уиверн мен Валькири ғана қалды.
Dialogue: 0,0:14:46.09,0:14:48.63,Default,,0,0,0,,Бұл мен күткеннен де көп, бірақ...
Dialogue: 0,0:14:49.26,0:14:51.80,Default,,0,0,0,,Кішкене көңілді алайық
Dialogue: 0,0:14:51.93,0:14:53.10,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:53.39,0:14:56.39,Default,,0,0,0,,Куза, сенің түсірген кадрың керемет болды.
Dialogue: 0,0:14:56.47,0:14:57.47,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:14:58.60,0:15:01.35,Default,,0,0,0,,Келесі - Балто немесе Вакия!
Dialogue: 0,0:15:01.60,0:15:04.02,Default,,0,0,0,,Енді менің кезегім! Амал жоқ
Dialogue: 0,0:15:04.69,0:15:08.28,Default,,0,0,0,,Осы уақытқа дейін біз жеңдік, балалар, ешқашан жеңілмеңдер!
Dialogue: 0,0:15:08.36,0:15:09.32,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:15:09.40,0:15:11.57,Default,,0,0,0,,Сарыдан жеңіліп қалдың ғой, солай ма?
Dialogue: 0,0:15:11.66,0:15:12.66,Default,,0,0,0,,Бұл тым көп қиындық!
Dialogue: 0,0:15:12.99,0:15:16.45,Default,,0,0,0,,Балалар, мұнда келу мақсатыңды ұмыттыңдар ма?
Dialogue: 0,0:15:16.95,0:15:18.54,Default,,0,0,0,,Ұмытпа!
Dialogue: 0,0:15:18.62,0:15:21.46,Default,,0,0,0,,Бірақ мен шайқасты бақылап отырып, кенеттен мынадай бір нәрсені сезіндім...
Dialogue: 0,0:15:21.54,0:15:23.13,Default,,0,0,0,,Ол машинаға айналады.
Dialogue: 0,0:15:23.21,0:15:25.54,Default,,0,0,0,,Иә, сізге ұқсайды.
Dialogue: 0,0:15:26.30,0:15:29.67,Default,,0,0,0,,Келесі жолы міндетті түрде жеңіске жетіңіз, тіпті Red Eye-ді жеңіңіз!
Dialogue: 0,0:15:29.76,0:15:31.34,Default,,0,0,0,,Бүгін той күні болады.
Dialogue: 0,0:15:31.43,0:15:33.14,Default,,0,0,0,,Эй, бұл ненің дыбысы?
Dialogue: 0,0:15:33.26,0:15:34.80,Default,,0,0,0,,(қабырғаның қозғалу дыбысы)
Dialogue: 0,0:15:35.55,0:15:36.89,Default,,0,0,0,,Қабырға...
Dialogue: 0,0:15:36.97,0:15:37.93,Default,,0,0,0,,Жақындап қалды
Dialogue: 0,0:15:38.02,0:15:40.68,Default,,0,0,0,,Ой... уау!
Dialogue: 0,0:15:41.06,0:15:42.98,Default,,0,0,0,,Неліктен мұндай механизм бар?
Dialogue: 0,0:15:43.06,0:15:44.86,Default,,0,0,0,,Сіз білесіз бе! Бұл есік!
Dialogue: 0,0:15:45.23,0:15:47.32,Default,,0,0,0,,Не? Мұз есік?
Dialogue: 0,0:15:47.40,0:15:49.69,Default,,0,0,0,,Жарайды, соғып алайық!
Dialogue: 0,0:15:49.78,0:15:50.69,Default,,0,0,0,,О!
Dialogue: 0,0:16:01.79,0:16:03.04,Default,,0,0,0,,Не?
Dialogue: 0,0:16:03.12,0:16:05.04,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:16:05.13,0:16:06.54,Default,,0,0,0,,Сабу!
Dialogue: 0,0:16:06.63,0:16:09.38,Default,,0,0,0,,Бұл тым көп! Кондиционер тым тиімді!
Dialogue: 0,0:16:10.84,0:16:12.38,Default,,0,0,0,,(Мұздың жарылған дыбысы)
Dialogue: 0,0:16:12.47,0:16:13.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:15.47,0:16:17.76,Default,,0,0,0,,(Қасқырдың ұлыуы)
Dialogue: 0,0:16:22.73,0:16:24.35,Default,,0,0,0,,Әрине суық
Dialogue: 0,0:16:24.94,0:16:28.65,Default,,0,0,0,,Бұл Солтүстік полюс сияқты жағдайларды жасаған кезең.
Dialogue: 0,0:16:29.02,0:16:31.15,Default,,0,0,0,,Бірақ мен суық емеспін!
Dialogue: 0,0:16:31.69,0:16:34.11,Default,,0,0,0,,Тағы бір оғаш адам пайда болды.
Dialogue: 0,0:16:34.74,0:16:36.41,Default,,0,0,0,,Ол «көңілді жігіт» емес!
Dialogue: 0,0:16:36.82,0:16:38.95,Default,,0,0,0,,Мен Көк Көз
Dialogue: 0,0:16:39.54,0:16:42.33,Default,,0,0,0,,Мен Балто-чанмен айналысамын.
Dialogue: 0,0:16:42.75,0:16:45.96,Default,,0,0,0,,Жарайсыңдар! Мен сені күттім, Зузузуруай!
Dialogue: 0,0:16:46.13,0:16:48.88,Default,,0,0,0,,Azure Eye-ді алдамаңыз!
Dialogue: 0,0:16:49.46,0:16:52.46,Default,,0,0,0,,Лазурь көк дегенді білдіреді, солай ма?
Dialogue: 0,0:16:52.55,0:16:54.88,Default,,0,0,0,,Сол көкпен күресейік
Dialogue: 0,0:16:55.55,0:16:57.76,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:16:58.30,0:17:00.72,Default,,0,0,0,,Бұл қызықты шайқас болар еді деп ойлаймын.
Dialogue: 0,0:17:00.81,0:17:04.98,Default,,0,0,0,,Мен барған сайын гипертониялық болып барамын.
Dialogue: 0,0:17:05.27,0:17:09.86,Default,,0,0,0,,Уау~ Мен де бұл сезімді толық түсінемін!
Dialogue: 0,0:17:09.94,0:17:11.90,Default,,0,0,0,,Сіз тым толқып тұрсыз.
Dialogue: 0,0:17:12.11,0:17:15.24,Default,,0,0,0,,Кел, Балт-чан! Мұнда келме!
Dialogue: 0,0:17:18.87,0:17:20.20,Default,,0,0,0,,Ооо!
Dialogue: 0,0:17:20.74,0:17:22.66,Default,,0,0,0,,Сіз бұл үшін шайқасасыз ба?
Dialogue: 0,0:17:22.75,0:17:24.08,Default,,0,0,0,,Мен қайықты тексеріп бітірдім.
Dialogue: 0,0:17:24.58,0:17:26.71,Default,,0,0,0,,Тербелген мұздың үстінде тұру
Dialogue: 0,0:17:26.79,0:17:30.04,Default,,0,0,0,,Күшті төменгі денені және тепе-теңдік сезімін қажет етеді
Dialogue: 0,0:17:30.50,0:17:33.38,Default,,0,0,0,,Егер сізде екеуі де болмаса
Dialogue: 0,0:17:33.46,0:17:35.55,Default,,0,0,0,,Сіз дәл түсіре алмайсыз.
Dialogue: 0,0:17:38.14,0:17:39.89,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:17:39.97,0:17:41.01,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:17:42.60,0:17:44.48,Default,,0,0,0,,Судың температурасы да күлкілі төмен.
Dialogue: 0,0:17:44.56,0:17:46.85,Default,,0,0,0,,Осындай жерге құлап қалсаңыз...
Dialogue: 0,0:17:47.19,0:17:48.48,Default,,0,0,0,,Мен суық тигіземін
Dialogue: 0,0:17:48.56,0:17:51.23,Default,,0,0,0,,Суық болғаны үшін кешіріңіз, шынымен суық!
Dialogue: 0,0:17:51.32,0:17:53.78,Default,,0,0,0,,Эй, Балт, құлама.
Dialogue: 0,0:17:53.86,0:17:57.74,Default,,0,0,0,,Білемін, мен ешқашан құламаймын!
Dialogue: 0,0:17:58.49,0:18:00.78,Default,,0,0,0,,Тоу... Тоу!
Dialogue: 0,0:18:01.74,0:18:02.99,Default,,0,0,0,,О!
Dialogue: 0,0:18:03.62,0:18:04.62,Default,,0,0,0,,Балто!
Dialogue: 0,0:18:05.58,0:18:07.04,Default,,0,0,0,,Уттотото
Dialogue: 0,0:18:07.37,0:18:09.46,Default,,0,0,0,,Балто Позаңызды түзетіңіз
Dialogue: 0,0:18:09.75,0:18:12.00,Default,,0,0,0,,Позаңызды түзетіңіз бе?
Dialogue: 0,0:18:12.25,0:18:13.96,Default,,0,0,0,,Доппен жүру сияқты
Dialogue: 0,0:18:14.05,0:18:15.01,Default,,0,0,0,,Онажида!
Dialogue: 0,0:18:15.46,0:18:17.22,Default,,0,0,0,,Доп тебу арқылы?
Dialogue: 0,0:18:18.13,0:18:19.43,Default,,0,0,0,,Уф… Ой, жоқ!
Dialogue: 0,0:18:19.76,0:18:22.64,Default,,0,0,0,,Жоғарғы денеңізді теңестіріңіз және кеудеңізді жоғары ұстаңыз!
Dialogue: 0,0:18:22.72,0:18:25.14,Default,,0,0,0,,Жоғарғы денемен...
Dialogue: 0,0:18:25.60,0:18:27.14,Default,,0,0,0,,Менің жүрегім толды!
Dialogue: 0,0:18:27.81,0:18:30.19,Default,,0,0,0,,Жарайды, отырдым. Мен отырдым!
Dialogue: 0,0:18:30.27,0:18:31.73,Default,,0,0,0,,Уау
Dialogue: 0,0:18:31.81,0:18:32.94,Default,,0,0,0,,Дәмді Дәмді!
Dialogue: 0,0:18:33.23,0:18:35.53,Default,,0,0,0,,Әкем әдеттегідей драмалық болып жатыр—
Dialogue: 0,0:18:36.24,0:18:37.24,Default,,0,0,0,,Бой!
Dialogue: 0,0:18:37.95,0:18:39.11,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:39.49,0:18:42.95,Default,,0,0,0,,Егер ол ұзаққа созылса, суық дене температурасын бірте-бірте жейді.
Dialogue: 0,0:18:43.03,0:18:44.87,Default,,0,0,0,,Мен күресіп жатырмын
Dialogue: 0,0:18:45.24,0:18:47.87,Default,,0,0,0,,Балто Мені бір оқпен өлтір!
Dialogue: 0,0:18:47.96,0:18:50.29,Default,,0,0,0,,Олай болмаса, біз де тоқтаймыз!
Dialogue: 0,0:18:50.37,0:18:53.29,Default,,0,0,0,,Суық болсаң, тоңа алмайсың!
Dialogue: 0,0:18:54.71,0:18:56.38,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:18:56.46,0:18:58.67,Default,,0,0,0,,«Кору» мен «Коряны» қостың ба?
Dialogue: 0,0:18:58.76,0:19:02.18,Default,,0,0,0,,Бұл керемет, бұл өте жақсы сөз тіркесі.
Dialogue: 0,0:19:02.26,0:19:03.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:03.68,0:19:06.22,Default,,0,0,0,,Жарайды, бұл сөз тіркесі.
Dialogue: 0,0:19:06.81,0:19:10.02,Default,,0,0,0,,Суық мұз суық!
Dialogue: 0,0:19:10.10,0:19:12.56,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:19:14.52,0:19:17.73,Default,,0,0,0,,Бұл күлкілі емес! Тым суық
Dialogue: 0,0:19:17.82,0:19:20.03,Default,,0,0,0,,Менің сөздеріме күлме
Dialogue: 0,0:19:20.11,0:19:22.57,Default,,0,0,0,,Қаламдас сөзге күлсең, сөз тіркесі ме?
Dialogue: 0,0:19:22.66,0:19:24.78,Default,,0,0,0,,Қалжыңдауды доғарыңдар, балалар, сөз тіркестері!
Dialogue: 0,0:19:24.91,0:19:25.91,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:25.99,0:19:29.62,Default,,0,0,0,,Azure Eye сөз тіркесімен қарқынды баяулатады... Лауре!
Dialogue: 0,0:19:29.71,0:19:30.79,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:30.87,0:19:33.83,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:19:36.17,0:19:40.09,Default,,0,0,0,,Валькири және бұл пішін бүгіннен бастап маған тиесілі болады.
Dialogue: 0,0:19:40.59,0:19:43.84,Default,,0,0,0,,Мен Валькирияның шынайы серіктесі боламын.
Dialogue: 0,0:19:44.68,0:19:46.51,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:19:46.60,0:19:50.18,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:50.27,0:19:52.44,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:59.15,0:20:01.65,Default,,0,0,0,,Қараның траекториясы неғұрлым өткір!
Dialogue: 0,0:20:01.74,0:20:03.41,Default,,0,0,0,,Қозғалысы бірқалыпты
Dialogue: 0,0:20:06.58,0:20:07.37,Default,,0,0,0,,Әй
Dialogue: 0,0:20:07.91,0:20:11.25,Default,,0,0,0,,Балто-чан әлі де осылай ғана қозғала алады.
Dialogue: 0,0:20:11.33,0:20:12.41,Default,,0,0,0,,Не?
Dialogue: 0,0:20:12.50,0:20:14.88,Default,,0,0,0,,Валькири жылап жатыр
Dialogue: 0,0:20:16.42,0:20:19.00,Default,,0,0,0,,Бұл Қара Валькирия!
Dialogue: 0,0:20:20.26,0:20:22.09,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:20:22.55,0:20:24.68,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:20:24.76,0:20:26.51,Default,,0,0,0,,1 ұпай
Dialogue: 0,0:20:26.80,0:20:28.10,Default,,0,0,0,,Балто-чан әлі де осында.
Dialogue: 0,0:20:28.18,0:20:31.85,Default,,0,0,0,,Сіз Валькиридің білігінің ұшын мүлде меңгермеген сияқтысыз.
Dialogue: 0,0:20:32.31,0:20:33.69,Default,,0,0,0,,Ось ұшы?
Dialogue: 0,0:20:34.23,0:20:37.23,Default,,0,0,0,,Сіз соншалықты маңызды нәрсені байқамағаныңызға сене алар емеспін.
Dialogue: 0,0:20:37.44,0:20:41.94,Default,,0,0,0,,Өйткені, Балто-чанның Valkyrie-ді пайдалану біліктілігі жоқ.
Dialogue: 0,0:20:44.49,0:20:45.20,Default,,0,0,0,,Ах
Dialogue: 0,0:20:45.86,0:20:47.87,Default,,0,0,0,,(Үдеттеуші айналу дыбысы)
Dialogue: 0,0:20:52.00,0:20:53.58,Default,,0,0,0,,Сол кездегі қозғалыс?
Dialogue: 0,0:20:53.96,0:20:56.83,Default,,0,0,0,,Оқпанның ұшы... осыны айтып тұрсың ба?
Dialogue: 0,0:20:57.25,0:21:00.30,Default,,0,0,0,,Осы уақытқа дейін Валькирияның қимылдары тұрақты болған жоқ.
Dialogue: 0,0:21:00.38,0:21:03.42,Default,,0,0,0,,Бұл білік ұшын дұрыс шығара алмағандықтан ба?
Dialogue: 0,0:21:03.51,0:21:06.80,Default,,0,0,0,,Мен өз көлеңкем маған бірдеңе үйретеді деп ешқашан күтпедім.
Dialogue: 0,0:21:07.34,0:21:09.97,Default,,0,0,0,,Сіз мұны істей алдыңыз.
Dialogue: 0,0:21:10.06,0:21:11.60,Default,,0,0,0,,Байқамағаным үшін кешіріңіз
Dialogue: 0,0:21:12.14,0:21:13.64,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:21:14.18,0:21:15.60,Default,,0,0,0,,Түсіндім, досым.
Dialogue: 0,0:21:15.69,0:21:18.40,Default,,0,0,0,,Мен сізге қалай жүгіргіңіз келсе, солай жүгіруге рұқсат етемін!
Dialogue: 0,0:21:18.56,0:21:21.11,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:21:27.86,0:21:32.29,Default,,0,0,0,,Егер ол сонша тербелсе, сіз ешқашан біліктің ұшын шығара алмайсыз.
Dialogue: 0,0:21:32.91,0:21:36.21,Default,,0,0,0,,Валькири өзінің шынайы күшін ашу үшін
Dialogue: 0,0:21:36.29,0:21:39.88,Default,,0,0,0,,Бар күшіңізді салыңыз...бар күшіңізбен атыңыз!
Dialogue: 0,0:21:41.92,0:21:43.55,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:21:43.63,0:21:46.97,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:21:47.09,0:21:49.51,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:21:55.93,0:21:58.40,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.48,0:22:01.90,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.98,0:22:04.69,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.78,0:22:06.99,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.07,0:22:10.66,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.74,0:22:14.45,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.54,0:22:16.20,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.29,0:22:17.87,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:17.96,0:22:19.88,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.96,0:22:21.50,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.59,0:22:23.63,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.71,0:22:26.05,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.13,0:22:29.05,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.13,0:22:32.76,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.85,0:22:36.52,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.60,0:22:38.23,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.31,0:22:41.69,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.77,0:22:43.94,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.02,0:22:47.53,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.61,0:22:51.11,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.20,0:22:53.41,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.49,0:22:54.99,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.08,0:22:58.50,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.58,0:23:00.46,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.54,0:23:03.54,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.63,0:23:05.84,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.92,0:23:09.84,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.93,0:23:13.51,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.60,0:23:17.10,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.18,0:23:20.48,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.56,0:23:22.60,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:20.56,0:23:22.60,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.60,0:23:22.69,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.69,0:23:25.15,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.69,0:23:25.15,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.15,0:23:25.48,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.65,0:23:30.40,Default,,0,0,0,,Валькири маған жаңа ерекше қозғалысты көрсетеді
Dialogue: 0,0:23:30.61,0:23:33.62,Default,,0,0,0,,Мен оны қалай пайдалану керектігін көрсетемін!
Dialogue: 0,0:23:33.95,0:23:37.20,Default,,0,0,0,,Ақыры Қызыл көз пайда болды.
Dialogue: 0,0:23:37.29,0:23:40.79,Default,,0,0,0,,Жылан шұңқырындағы соңғы шайқас басталады.
Dialogue: 0,0:23:41.33,0:23:43.46,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.54,0:23:45.75,Default,,0,0,0,,Енжин! Қызыл көз!
Dialogue: 0,0:23:45.92,0:23:49.84,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.34,0:23:57.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory