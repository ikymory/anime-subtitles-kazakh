Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.25,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:09.92,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.35,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:19.97,0:00:24.39,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.06,0:00:29.69,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:32.78,0:00:34.36,Default,,0,0,0,,Керемет! Валькирия!
Dialogue: 0,0:00:37.78,0:00:38.83,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:00:39.03,0:00:41.12,Default,,0,0,0,,Алға!
Dialogue: 0,0:00:41.20,0:00:42.70,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:43.08,0:00:44.29,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:00:44.37,0:00:45.79,Default,,0,0,0,,Мен, Кумичо және Еркін
Dialogue: 0,0:00:45.87,0:00:49.25,Default,,0,0,0,,Мен Еуропа лигасының қатысушысы ретінде таңдалдым.
Dialogue: 0,0:00:49.34,0:00:51.13,Default,,0,0,0,,Кеттік! Еуропа лигасы!
Dialogue: 0,0:00:51.55,0:00:54.92,Default,,0,0,0,,Біздің бірінші қарсыласымыз – Германияның Топванд!
Dialogue: 0,0:00:58.51,0:01:01.18,Default,,0,0,0,,♪~
Dialogue: 0,0:01:01.26,0:01:03.68,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:03.77,0:01:06.23,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:06.31,0:01:08.77,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:08.86,0:01:11.15,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:11.23,0:01:12.94,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:13.03,0:01:17.16,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:18.11,0:01:22.87,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:22.95,0:01:27.46,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:27.96,0:01:32.71,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:32.80,0:01:37.72,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:01:37.80,0:01:42.68,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:01:42.76,0:01:47.73,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:01:47.81,0:01:51.11,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:01:51.19,0:01:52.77,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:01:52.86,0:01:55.36,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:01:55.44,0:01:57.70,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:01:57.78,0:02:00.12,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:00.20,0:02:01.24,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:01.32,0:02:02.78,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:02.87,0:02:05.25,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:05.33,0:02:11.46,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:11.54,0:02:16.17,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:16.26,0:02:18.76,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:18.84,0:02:21.22,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:21.30,0:02:23.76,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:23.85,0:02:25.81,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:25.81,0:02:26.93,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:25.81,0:02:26.93,Default,,0,0,0,,~♪
Dialogue: 0,0:02:26.93,0:02:27.98,Default,,0,0,0,,~♪
Dialogue: 0,0:02:29.27,0:02:32.06,Default,,0,0,0,,Ашылу! Еуропа лигасы!
Dialogue: 0,0:02:33.19,0:02:35.78,Default,,0,0,0,,Жеңіске жетіңіз!
Dialogue: 0,0:02:36.57,0:02:38.70,Default,,0,0,0,,Бұл сіздің жалғыз миссияңыз.
Dialogue: 0,0:02:38.99,0:02:40.11,Default,,0,0,0,,Оу!
Dialogue: 0,0:02:40.32,0:02:42.32,Default,,0,0,0,,Әрине, біз міндетті түрде жеңеміз!
Dialogue: 0,0:02:42.41,0:02:44.20,Default,,0,0,0,,Жасайық
Dialogue: 0,0:02:44.95,0:02:47.33,Default,,0,0,0,,Топвантты қазір талдауды бастаңыз
Dialogue: 0,0:02:51.08,0:02:54.34,Default,,0,0,0,,Бұл команданың ең күшті ойыншысы Куза Акерман.
Dialogue: 0,0:02:54.42,0:02:56.88,Default,,0,0,0,,Баланс түрі Alter Chronos.
Dialogue: 0,0:02:57.34,0:02:59.88,Default,,0,0,0,,Осыны мұқият белгілеу керек
Dialogue: 0,0:03:00.26,0:03:01.93,Default,,0,0,0,,Альтер Кронос?
Dialogue: 0,0:03:02.01,0:03:03.05,Default,,0,0,0,,Бұл күшті ме?
Dialogue: 0,0:03:03.68,0:03:06.01,Default,,0,0,0,,Бұл шығанақ өзінің екіжақтылығымен ерекшеленеді.
Dialogue: 0,0:03:06.35,0:03:09.06,Default,,0,0,0,,Қабаттар мен драйверлерді ауыстыру арқылы
Dialogue: 0,0:03:09.14,0:03:12.40,Default,,0,0,0,,Супер төзімділік режимі және супер шабуыл режимі
Dialogue: 0,0:03:12.73,0:03:14.48,Default,,0,0,0,,Мүлде басқа жолмен қозғалыңыз
Dialogue: 0,0:03:14.86,0:03:16.98,Default,,0,0,0,,Сіз екі жүзіңіз бар деп айта аласыз.
Dialogue: 0,0:03:17.11,0:03:19.78,Default,,0,0,0,,Өте төзімділікпен теңдестірілген тип?
Dialogue: 0,0:03:19.86,0:03:21.45,Default,,0,0,0,,Ал супер шабуыл?
Dialogue: 0,0:03:21.82,0:03:23.82,Default,,0,0,0,,Екеуі де күшті.
Dialogue: 0,0:03:24.12,0:03:27.45,Default,,0,0,0,,Менің Рагнарукта өте төзімділік бар!
Dialogue: 0,0:03:27.54,0:03:30.75,Default,,0,0,0,,Менің Валькирімнің супер, супер, супер шабуылы бар!
Dialogue: 0,0:03:30.83,0:03:33.37,Default,,0,0,0,,Рагнарук супер, супер, супер, супер төзімділікке ие.
Dialogue: 0,0:03:33.50,0:03:34.50,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:03:34.79,0:03:36.04,Default,,0,0,0,,Ng…
Dialogue: 0,0:03:36.42,0:03:38.80,Default,,0,0,0,,Альтер Кроностың проблемасы
Dialogue: 0,0:03:38.88,0:03:43.13,Default,,0,0,0,,Атқанға дейін оның қай жолмен келетінін білмейсің.
Dialogue: 0,0:03:43.51,0:03:44.89,Default,,0,0,0,,Мен жеңемін
Dialogue: 0,0:03:50.10,0:03:51.52,Default,,0,0,0,,Сәлем, Куза!
Dialogue: 0,0:03:56.19,0:03:59.40,Default,,0,0,0,,Кәне, қала тұрғындары, бүгін ерекше қызмет!
Dialogue: 0,0:03:59.90,0:04:03.40,Default,,0,0,0,,Біздің байланыстарымыз барлығына ұнайды деп үміттенемін.
Dialogue: 0,0:04:03.49,0:04:06.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:10.37,0:04:11.87,Default,,0,0,0,,Куза салқын
Dialogue: 0,0:04:12.33,0:04:15.12,Default,,0,0,0,,Бұл менің досым Карл.
Dialogue: 0,0:04:15.38,0:04:16.17,Default,,0,0,0,,Әлемдік бейбітшілік
Dialogue: 0,0:04:16.25,0:04:17.46,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:04:17.79,0:04:20.80,Default,,0,0,0,,Бұйра сүйкімді Бұйра сүйкімді
Dialogue: 0,0:04:21.01,0:04:21.88,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:04:22.17,0:04:23.22,Default,,0,0,0,,Икузо
Dialogue: 0,0:04:24.18,0:04:26.30,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:28.47,0:04:30.18,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:04:30.47,0:04:32.14,Default,,0,0,0,,Са~ра~ни~
Dialogue: 0,0:04:34.44,0:04:35.60,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:04:39.98,0:04:43.61,Default,,0,0,0,,Иә! Бұл менің шығанақ, Альтер Кронос!
Dialogue: 0,0:04:43.70,0:04:44.61,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:04:45.24,0:04:46.45,Default,,0,0,0,,Керемет, солай ма?
Dialogue: 0,0:04:46.57,0:04:48.45,Default,,0,0,0,,Құдайға шүкір, Эмма енді жақсы.
Dialogue: 0,0:04:48.53,0:04:51.70,Default,,0,0,0,,Генрих: Бұл сәл артық емес пе?
Dialogue: 0,0:04:51.95,0:04:54.87,Default,,0,0,0,,Жақсы, қала тұрғындары риза.
Dialogue: 0,0:04:55.42,0:04:58.42,Default,,0,0,0,,Куза көрермендерді толығымен өз жағына тартты.
Dialogue: 0,0:04:58.67,0:04:59.71,Default,,0,0,0,,Әрине
Dialogue: 0,0:04:59.79,0:05:02.63,Default,,0,0,0,,Нфуфуфу
Dialogue: 0,0:05:02.92,0:05:06.01,Default,,0,0,0,,Ван Ван Ван Ван Сәлем, бұл ит.
Dialogue: 0,0:05:06.59,0:05:07.68,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:08.01,0:05:10.81,Default,,0,0,0,,Бей ойынына келесің бе?
Dialogue: 0,0:05:10.89,0:05:13.98,Default,,0,0,0,,Икутомо! Мен ағаларыма қамқор боламын
Dialogue: 0,0:05:14.10,0:05:15.35,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:05:15.44,0:05:17.65,Default,,0,0,0,,Роммель, мұны бірден істе.
Dialogue: 0,0:05:17.73,0:05:19.65,Default,,0,0,0,,Мочи Роммель
Dialogue: 0,0:05:20.06,0:05:23.65,Default,,0,0,0,,Баршаңызға, Топ Вант қош келдіңіз.
Dialogue: 0,0:05:24.19,0:05:26.86,Default,,0,0,0,,Иә
Dialogue: 0,0:05:29.95,0:05:32.08,Default,,0,0,0,,Біз осындамыз! Жау аумағында!
Dialogue: 0,0:05:32.37,0:05:33.62,Default,,0,0,0,,Текитини
Dialogue: 0,0:05:39.33,0:05:41.00,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:42.59,0:05:43.67,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:05:45.67,0:05:48.18,Default,,0,0,0,,Басқа, мүлде басқа
Dialogue: 0,0:05:49.01,0:05:52.06,Default,,0,0,0,,Мен сол кездегі қозғалысты көрсеткім келеді.
Dialogue: 0,0:05:53.22,0:05:54.35,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:54.43,0:05:56.18,Default,,0,0,0,,Есіңде бірдеңе жоқ па?
Dialogue: 0,0:05:56.27,0:05:58.44,Default,,0,0,0,,Іс жақсы болған кезде қандай сезімде болады
Dialogue: 0,0:05:58.94,0:06:01.52,Default,,0,0,0,,«Жан» десең, «Хамф» дейсің.
Dialogue: 0,0:06:01.94,0:06:04.94,Default,,0,0,0,,Бұл бум, солай ма?
Dialogue: 0,0:06:05.03,0:06:06.82,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:06.94,0:06:08.53,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:06:08.91,0:06:11.45,Default,,0,0,0,,Біреу ақымақ көрінеді.
Dialogue: 0,0:06:11.70,0:06:13.12,Default,,0,0,0,,Қай жерде тегін?
Dialogue: 0,0:06:13.62,0:06:15.41,Default,,0,0,0,,Тегін Ha Dokoda?
Dialogue: 0,0:06:17.54,0:06:18.58,Default,,0,0,0,,Шудың бірі
Dialogue: 0,0:06:18.66,0:06:22.21,Default,,0,0,0,,Олар біздің ойынға қатысқанымызды білсе, таң қалады!
Dialogue: 0,0:06:26.80,0:06:29.68,Default,,0,0,0,,Шудан әлі хабар алған жоқсың ба?
Dialogue: 0,0:06:30.68,0:06:31.59,Default,,0,0,0,,О
Dialogue: 0,0:06:31.97,0:06:33.68,Default,,0,0,0,,Әлі жоқ...
Dialogue: 0,0:06:35.31,0:06:37.39,Default,,0,0,0,,Шу Америкаға барасың ба?
Dialogue: 0,0:06:37.48,0:06:38.73,Default,,0,0,0,,О
Dialogue: 0,0:06:38.85,0:06:40.94,Default,,0,0,0,,Сізге шынымен бару керек пе?
Dialogue: 0,0:06:41.98,0:06:46.03,Default,,0,0,0,,Мен Луиден жеңіліп, Балтоға берген уәдемде тұра алмадым.
Dialogue: 0,0:06:46.44,0:06:47.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:47.94,0:06:49.86,Default,,0,0,0,,Мен күштірек болғым келеді
Dialogue: 0,0:06:50.20,0:06:53.24,Default,,0,0,0,,Ол үшін өзіңді өзгерту керек.
Dialogue: 0,0:06:53.45,0:06:54.53,Default,,0,0,0,,Сондықтан мен барамын
Dialogue: 0,0:06:56.74,0:06:58.45,Default,,0,0,0,,Түсіндім, Шу.
Dialogue: 0,0:06:58.54,0:06:59.50,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:06:59.91,0:07:02.21,Default,,0,0,0,,Мен де одан да күшті боламын.
Dialogue: 0,0:07:02.54,0:07:04.54,Default,,0,0,0,,О, уәде!
Dialogue: 0,0:07:07.80,0:07:10.01,Default,,0,0,0,,Шу... Қызық, не болып жатыр?
Dialogue: 0,0:07:10.47,0:07:12.43,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:07:12.89,0:07:14.72,Default,,0,0,0,,Бұл олай емес сияқты, Балто.
Dialogue: 0,0:07:15.05,0:07:16.31,Default,,0,0,0,,Кумичо
Dialogue: 0,0:07:17.64,0:07:19.89,Default,,0,0,0,,Біз оны үлкен және жылдам жасаймыз.
Dialogue: 0,0:07:20.14,0:07:21.73,Default,,0,0,0,,Сосын Шудыкі
Dialogue: 0,0:07:21.81,0:07:24.48,Default,,0,0,0,,Америкада көргенде қатты қорықтым!
Dialogue: 0,0:07:25.61,0:07:26.73,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:27.19,0:07:29.36,Default,,0,0,0,,Маған ұнамаса да, Ренракуға келемін.
Dialogue: 0,0:07:29.61,0:07:30.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:30.57,0:07:33.66,Default,,0,0,0,,Жарайсыңдар! Мен толқып тұрмын!
Dialogue: 0,0:07:33.74,0:07:34.70,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:07:35.07,0:07:35.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:36.08,0:07:38.33,Default,,0,0,0,,Джаруки детекторы
Dialogue: 0,0:07:38.58,0:07:39.70,Default,,0,0,0,,Карл!
Dialogue: 0,0:07:43.42,0:07:44.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:44.63,0:07:45.84,Default,,0,0,0,,Не?
Dialogue: 0,0:07:45.92,0:07:46.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:46.67,0:07:47.84,Default,,0,0,0,,Ах! ! !
Dialogue: 0,0:07:50.05,0:07:51.34,Default,,0,0,0,,Сәлем! ! !
Dialogue: 0,0:07:56.47,0:07:58.06,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:07:58.14,0:08:00.06,Default,,0,0,0,,Тоқта, күт, күт!
Dialogue: 0,0:08:00.14,0:08:02.31,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:08:02.39,0:08:03.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:03.77,0:08:06.06,Default,,0,0,0,,Біреу мені ұстап алсын!
Dialogue: 0,0:08:06.15,0:08:07.32,Default,,0,0,0,,Шулы!
Dialogue: 0,0:08:07.40,0:08:08.32,Default,,0,0,0,,Кім шалбарын шылаған, сен, қанды шошқа!
Dialogue: 0,0:08:08.94,0:08:10.15,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:08:10.23,0:08:11.65,Default,,0,0,0,,Каэз!
Dialogue: 0,0:08:11.74,0:08:13.45,Default,,0,0,0,,Тотықұс?
Dialogue: 0,0:08:13.53,0:08:15.20,Default,,0,0,0,,Қайдан келдің?
Dialogue: 0,0:08:15.28,0:08:17.62,Default,,0,0,0,,Тұрған құс шығанағын жібермеу
Dialogue: 0,0:08:17.70,0:08:19.49,Default,,0,0,0,,Тым жұмбақ...
Dialogue: 0,0:08:20.24,0:08:23.12,Default,,0,0,0,,А, бұл қауіпті.
Dialogue: 0,0:08:23.21,0:08:24.33,Default,,0,0,0,,(қол ысқырығы)
Dialogue: 0,0:08:25.08,0:08:26.21,Default,,0,0,0,,Кел, Карл!
Dialogue: 0,0:08:26.29,0:08:27.29,Default,,0,0,0,,А
Dialogue: 0,0:08:29.38,0:08:32.59,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:36.09,0:08:41.06,Default,,0,0,0,,Мен оны Карл Омеге байланысты тегін көре алмадым.
Dialogue: 0,0:08:41.18,0:08:42.43,Default,,0,0,0,,Не!
Dialogue: 0,0:08:43.89,0:08:45.77,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:08:45.85,0:08:47.90,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:08:49.82,0:08:51.40,Default,,0,0,0,,Ооооооо
Dialogue: 0,0:08:51.48,0:08:52.78,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:08:54.24,0:08:56.61,Default,,0,0,0,,Менің Валькириям
Dialogue: 0,0:08:57.07,0:09:00.03,Default,,0,0,0,,Бух... Бвахахахаха
Dialogue: 0,0:09:00.12,0:09:01.91,Default,,0,0,0,,Өте күлкілі жүз!
Dialogue: 0,0:09:01.99,0:09:04.75,Default,,0,0,0,,Қайтарыңыз! ! !
Dialogue: 0,0:09:05.08,0:09:06.04,Default,,0,0,0,,Не?
Dialogue: 0,0:09:08.88,0:09:09.96,Default,,0,0,0,,Қайда бардың!
Dialogue: 0,0:09:10.67,0:09:11.59,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:09:11.96,0:09:13.38,Default,,0,0,0,,Гррр... Ах!
Dialogue: 0,0:09:14.01,0:09:15.09,Default,,0,0,0,,Сен!
Dialogue: 0,0:09:18.34,0:09:19.35,Default,,0,0,0,,Куза!
Dialogue: 0,0:09:20.01,0:09:21.01,Default,,0,0,0,,Пинг-понг
Dialogue: 0,0:09:21.97,0:09:23.10,Default,,0,0,0,,Бірақ соғыс жыртқыштары сиқыр қолдана алмайды ғой, иә?
Dialogue: 0,0:09:23.60,0:09:25.43,Default,,0,0,0,,Карл, оны қайтар.
Dialogue: 0,0:09:25.89,0:09:27.35,Default,,0,0,0,,Каешитеяре
Dialogue: 0,0:09:27.44,0:09:29.61,Default,,0,0,0,,Валькири
Dialogue: 0,0:09:29.69,0:09:31.65,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:09:31.98,0:09:34.57,Default,,0,0,0,,Карл салқын шығанақтарды жақсы көреді.
Dialogue: 0,0:09:34.78,0:09:37.61,Default,,0,0,0,,Хехе, менің серіктесім жақсы ма?
Dialogue: 0,0:09:37.86,0:09:39.12,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:39.20,0:09:41.53,Default,,0,0,0,,Мені кешіріңіз, мен ешқандай жамандық айтқым келмейді.
Dialogue: 0,0:09:41.83,0:09:43.37,Default,,0,0,0,,Мен түсіндім...
Dialogue: 0,0:09:43.79,0:09:45.96,Default,,0,0,0,,Куза неге мұнда?
Dialogue: 0,0:09:46.08,0:09:49.21,Default,,0,0,0,,Жарайды... сәлемдесу сияқты болса керек.
Dialogue: 0,0:09:50.00,0:09:51.09,Default,,0,0,0,,Бұл біраз кінәлі сезім емес пе?
Dialogue: 0,0:09:53.46,0:09:55.05,Default,,0,0,0,,Қараңыз, дұрыс! дұрыс!
Dialogue: 0,0:09:55.88,0:09:57.84,Default,,0,0,0,,А-а-а! Атто
Dialogue: 0,0:09:59.68,0:10:01.97,Default,,0,0,0,,Джунглидегі қиын жаттығу залы
Dialogue: 0,0:10:02.05,0:10:03.35,Default,,0,0,0,,«Жонглерлік»
Dialogue: 0,0:10:03.76,0:10:05.85,Default,,0,0,0,,Сонымен, сіз осындай нәрсені жасай аласыз ба?
Dialogue: 0,0:10:06.14,0:10:08.56,Default,,0,0,0,,Міне! Алақай!
Dialogue: 0,0:10:08.89,0:10:10.86,Default,,0,0,0,,Керемет Куза
Dialogue: 0,0:10:11.15,0:10:13.36,Default,,0,0,0,,Бұл оңай!
Dialogue: 0,0:10:14.48,0:10:16.15,Default,,0,0,0,,Мен де! Мен де солай жасағым келеді
Dialogue: 0,0:10:16.69,0:10:18.11,Default,,0,0,0,,Арнайы тренинг өткізгіңіз келе ме?
Dialogue: 0,0:10:18.20,0:10:19.28,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:10:20.45,0:10:23.37,Default,,0,0,0,,♪~
Dialogue: 0,0:10:36.80,0:10:38.22,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:10:38.30,0:10:40.13,Default,,0,0,0,,О... және!
Dialogue: 0,0:10:41.26,0:10:42.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:42.89,0:10:44.76,Default,,0,0,0,,Керемет жұмыс, Балто
Dialogue: 0,0:10:46.10,0:10:48.23,Default,,0,0,0,,Куза Қайтадан ойнайық!
Dialogue: 0,0:10:48.81,0:10:50.81,Default,,0,0,0,,Келесі кездескенімізде бұл Эль Санто болады!
Dialogue: 0,0:10:51.35,0:10:54.15,Default,,0,0,0,,Мен сенімен күресуді асыға күтемін!
Dialogue: 0,0:10:55.07,0:10:57.90,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:10:57.99,0:11:01.07,Default,,0,0,0,,Эль Сантоға қош келдіңіз!
Dialogue: 0,0:11:01.16,0:11:03.03,Default,,0,0,0,,Қасиетті шығанақ мекеніне қош келдіңіздер!
Dialogue: 0,0:11:04.45,0:11:06.74,Default,,0,0,0,,Сіз осында шайқаса аласыз!
Dialogue: 0,0:11:07.50,0:11:09.75,Default,,0,0,0,,Хмм, жанып барады.
Dialogue: 0,0:11:10.41,0:11:13.50,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:11:13.58,0:11:17.67,Default,,0,0,0,,wbba. Бұл Еуропа лигасының басталуы.
Dialogue: 0,0:11:18.30,0:11:21.59,Default,,0,0,0,,Бұл турнир Еуропаның әрбір ірі қаласында өтеді...
Dialogue: 0,0:11:21.68,0:11:25.22,Default,,0,0,0,,Бүкіл әлем бойынша бір уақытта тікелей эфир, әрине
Dialogue: 0,0:11:25.30,0:11:28.81,Default,,0,0,0,,Міне, Эль-Сантода, алаң иелері BC Sol командасымен...
Dialogue: 0,0:11:28.89,0:11:31.73,Default,,0,0,0,,Ол Германияның ең үздік вандалары арасындағы жекпе-жектен басталады.
Dialogue: 0,0:11:32.02,0:11:35.48,Default,,0,0,0,,Ей, мені шығармағаның үшін мен сені кінәлаймын.
Dialogue: 0,0:11:36.07,0:11:37.78,Default,,0,0,0,,(жарықтың жану дыбысы)
Dialogue: 0,0:11:38.57,0:11:40.74,Default,,0,0,0,,Енді үй иелерінің атынан.
Dialogue: 0,0:11:40.82,0:11:43.66,Default,,0,0,0,,Кристина Клодаг, BC Sol иесі
Dialogue: 0,0:11:43.74,0:11:45.32,Default,,0,0,0,,Сәлемдесу!
Dialogue: 0,0:11:46.87,0:11:50.62,Default,,0,0,0,,Біз Эль Сантода ашылу жарысын өткіземіз деп үміттенемін.
Dialogue: 0,0:11:50.71,0:11:52.12,Default,,0,0,0,,Шаңды ойлаймын
Dialogue: 0,0:11:52.54,0:11:57.04,Default,,0,0,0,,Барлығымыз, жеңіс үшін әділ, шаршы алаңға тартайық.
Dialogue: 0,0:11:57.46,0:12:00.63,Default,,0,0,0,,Еуропа лигасы осы жерден басталады
Dialogue: 0,0:12:02.38,0:12:05.14,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:05.39,0:12:07.43,Default,,0,0,0,,Рахмет Кристина
Dialogue: 0,0:12:07.51,0:12:10.89,Default,,0,0,0,,Олай болса, Blader пайда болатын кез келді.
Dialogue: 0,0:12:11.02,0:12:14.40,Default,,0,0,0,,Көк бұрыш Әлемдік рейтинг тренді
Dialogue: 0,0:12:15.02,0:12:18.65,Default,,0,0,0,,Германияның жетекші шығанақ клубы Топвандын қабылдауы!
Dialogue: 0,0:12:18.94,0:12:24.36,Default,,0,0,0,,Баурап алатын пышақ Генрих шығанақты өз қалауы бойынша басқарады!
Dialogue: 0,0:12:24.45,0:12:27.16,Default,,0,0,0,,Нәзік шайқастар - Роммельдің ерекшелігі!
Dialogue: 0,0:12:27.24,0:12:29.79,Default,,0,0,0,,Ал қайтымды шайқастарға назар аударыңыз.
Dialogue: 0,0:12:29.87,0:12:32.46,Default,,0,0,0,,Acrobatic Blader Kuza!
Dialogue: 0,0:12:33.00,0:12:34.42,Default,,0,0,0,,Бұл Куза!
Dialogue: 0,0:12:34.83,0:12:35.83,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:12:35.92,0:12:37.79,Default,,0,0,0,,О, біз доспыз.
Dialogue: 0,0:12:38.04,0:12:39.21,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:12:39.46,0:12:42.21,Default,,0,0,0,,Сіз шынымен достасуда данышпансыз.
Dialogue: 0,0:12:42.51,0:12:43.47,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:45.59,0:12:49.64,Default,,0,0,0,,Менің командамның әлемдік рейтингі жылдан жылға төмендеп келеді.
Dialogue: 0,0:12:49.81,0:12:52.35,Default,,0,0,0,,Мен мұнда бірден ұпай алуым керек.
Dialogue: 0,0:12:52.43,0:12:54.56,Default,,0,0,0,,Сіз алаңдаушысыз, Трад.
Dialogue: 0,0:12:55.06,0:12:58.02,Default,,0,0,0,,Дүниежүзілік лигаға қатысу құқығынан айырылсаңыз не істейсіз?
Dialogue: 0,0:12:58.27,0:13:01.03,Default,,0,0,0,,Бізде абсолютті эйс бар, Тегін.
Dialogue: 0,0:13:03.24,0:13:04.95,Default,,0,0,0,,BC Соль жеңеді
Dialogue: 0,0:13:05.74,0:13:10.66,Default,,0,0,0,,Coosa Coosa Coosa…
Dialogue: 0,0:13:10.74,0:13:13.70,Default,,0,0,0,,Куза өте танымал.
Dialogue: 0,0:13:13.91,0:13:14.79,Default,,0,0,0,,Кім?
Dialogue: 0,0:13:15.00,0:13:16.08,Default,,0,0,0,,Бұл дөрекі
Dialogue: 0,0:13:16.29,0:13:20.96,Default,,0,0,0,,Мен Александр Гилтенмін, Нью-Йорк Буллз клубының иесімін.
Dialogue: 0,0:13:22.00,0:13:23.05,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:23.84,0:13:27.59,Default,,0,0,0,,BC Sol Free De La Hoya-ға сүйенеді
Dialogue: 0,0:13:29.43,0:13:32.64,Default,,0,0,0,,Егер сіз кетсеңіз, сіз жай ғана әлсіз командасыз.
Dialogue: 0,0:13:33.89,0:13:38.48,Default,,0,0,0,,Біз бұрын жақсы команда едік, бірақ қазір мүлде құрдымға кеттік.
Dialogue: 0,0:13:40.27,0:13:42.23,Default,,0,0,0,,Тым күшті болу да күнә
Dialogue: 0,0:13:42.82,0:13:44.99,Default,,0,0,0,,Бұл топты не құртып жатыр?
Dialogue: 0,0:13:45.44,0:13:48.11,Default,,0,0,0,,Мүмкін сіз өзіңіз шығарсыз.
Dialogue: 0,0:13:51.37,0:13:52.91,Default,,0,0,0,,Жақсы жауап.
Dialogue: 0,0:13:54.12,0:13:57.29,Default,,0,0,0,,Әй, саған жақында қоңырау соғады.
Dialogue: 0,0:13:57.37,0:13:59.42,Default,,0,0,0,,Қай жерде тегін?
Dialogue: 0,0:13:59.50,0:14:00.58,Default,,0,0,0,,Дәл осы жерде
Dialogue: 0,0:14:01.75,0:14:04.34,Default,,0,0,0,,О, бірдеңе істеу керек!
Dialogue: 0,0:14:04.42,0:14:05.17,Default,,0,0,0,,Қый!
Dialogue: 0,0:14:05.26,0:14:07.09,Default,,0,0,0,,Жүрегіңе жаман!
Dialogue: 0,0:14:07.17,0:14:08.22,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:14:08.30,0:14:09.76,Default,,0,0,0,,Nga~
Dialogue: 0,0:14:10.85,0:14:11.93,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:14:12.01,0:14:14.22,Default,,0,0,0,,Уа, күте тұрыңыз!
Dialogue: 0,0:14:18.02,0:14:22.61,Default,,0,0,0,,Қызыл бұрыш BC Sol's Blader кіреді!
Dialogue: 0,0:14:22.69,0:14:24.19,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:24.28,0:14:28.32,Default,,0,0,0,,Абсолютті Эйс, Жеңілмейтін Әлемдегі №1 Бладер
Dialogue: 0,0:14:28.40,0:14:30.32,Default,,0,0,0,,Де Ла Хойя тегін!
Dialogue: 0,0:14:30.66,0:14:34.95,Default,,0,0,0,,Айнымас өжеттік пен рыцарьлық бұл кісінің қасиеті!
Dialogue: 0,0:14:35.04,0:14:36.25,Default,,0,0,0,,Рантаро Кияма!
Dialogue: 0,0:14:36.79,0:14:38.66,Default,,0,0,0,,Энергия мен жарықтық жоғары класс
Dialogue: 0,0:14:38.75,0:14:41.46,Default,,0,0,0,,Мен жүгіре бастағаннан кейін тоқтай алмаймын
Dialogue: 0,0:14:41.54,0:14:43.38,Default,,0,0,0,,Барто Аои!
Dialogue: 0,0:14:43.46,0:14:44.63,Default,,0,0,0,,(дем алу)
Dialogue: 0,0:14:45.05,0:14:46.63,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:14:46.71,0:14:49.13,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:14:49.22,0:14:53.05,Default,,0,0,0,,BC Sol BC Sol…
Dialogue: 0,0:14:53.14,0:14:57.31,Default,,0,0,0,,б.з.б. Соль BC Соль б.з. Сол…
Dialogue: 0,0:14:57.39,0:14:58.48,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:14:58.77,0:15:00.48,Default,,0,0,0,,Маған қатты әсер етті...
Dialogue: 0,0:15:00.56,0:15:02.10,Default,,0,0,0,,Аха!
Dialogue: 0,0:15:08.03,0:15:09.70,Default,,0,0,0,,Екі топ та кешірім сұрайды
Dialogue: 0,0:15:11.49,0:15:12.53,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:15:12.78,0:15:14.99,Default,,0,0,0,,Шайқас Көңілді болайық! Куса
Dialogue: 0,0:15:16.62,0:15:17.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:20.58,0:15:21.96,Default,,0,0,0,,Не...
Dialogue: 0,0:15:22.58,0:15:25.71,Default,,0,0,0,,Матчтар әр ойында 2 ұпайлық жүйе бойынша ойналады.
Dialogue: 0,0:15:26.05,0:15:28.42,Default,,0,0,0,,3 ойында бірінші жеңіске жеткен команда жеңеді.
Dialogue: 0,0:15:29.01,0:15:31.34,Default,,0,0,0,,Мен бұл матчта болғым келді...
Dialogue: 0,0:15:31.63,0:15:33.55,Default,,0,0,0,,Мен қосалқымын ба?
Dialogue: 0,0:15:33.89,0:15:36.35,Default,,0,0,0,,Балт та, Хуаншан да жеңілуі керек.
Dialogue: 0,0:15:36.68,0:15:38.97,Default,,0,0,0,,Қызық, Кузадағыға не болды?
Dialogue: 0,0:15:39.35,0:15:41.19,Default,,0,0,0,,Ей, біз доспыз, солай ма?
Dialogue: 0,0:15:41.44,0:15:45.23,Default,,0,0,0,,Кешегіден мүлде басқаша. Бұлай сезілген жоқ.
Dialogue: 0,0:15:45.77,0:15:46.52,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:49.23,0:15:50.44,Default,,0,0,0,,(Ұрыс тіркеу дыбысы)
Dialogue: 0,0:15:50.65,0:15:51.57,Default,,0,0,0,,... Эй!
Dialogue: 0,0:15:51.78,0:15:53.41,Default,,0,0,0,,Бұл тегін бола ма?
Dialogue: 0,0:15:53.70,0:15:56.87,Default,,0,0,0,,Егер сіз капитан болсаңыз, барар алдында мен бірдеңе айтқым келеді...
Dialogue: 0,0:15:57.45,0:15:58.66,Default,,0,0,0,,Бірдеңе айт!
Dialogue: 0,0:16:00.29,0:16:01.08,Default,,0,0,0,,Мен кетемін
Dialogue: 0,0:16:01.50,0:16:02.50,Default,,0,0,0,,Уф
Dialogue: 0,0:16:03.04,0:16:07.25,Default,,0,0,0,,BC Сольдің бірінші орыны кенеттен әлемдік рейтингте бірінші орынға шықты
Dialogue: 0,0:16:07.34,0:16:09.51,Default,,0,0,0,,Капитан Еркін Де Ла Хойя!
Dialogue: 0,0:16:09.59,0:16:11.55,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:16:11.80,0:16:14.51,Default,,0,0,0,,Күтілгендей, ол керемет танымал.
Dialogue: 0,0:16:14.59,0:16:15.72,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:16:15.80,0:16:17.76,Default,,0,0,0,,Тегін Сәттілік
Dialogue: 0,0:16:18.18,0:16:20.77,Default,,0,0,0,,Міне, капитан да пайда болады
Dialogue: 0,0:16:21.18,0:16:25.60,Default,,0,0,0,,Генрих, Топванттың миы және басқару мұнарасы!
Dialogue: 0,0:16:26.56,0:16:30.03,Default,,0,0,0,,Бірінші нөмірлі пышақпен есте қалатын бірінші ойын
Dialogue: 0,0:16:30.11,0:16:31.19,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:16:31.53,0:16:32.28,Default,,0,0,0,,Иә
Dialogue: 0,0:16:32.61,0:16:35.70,Default,,0,0,0,,Мен сені жеңсем, мен бірінші боламын.
Dialogue: 0,0:16:36.87,0:16:38.03,Default,,0,0,0,,Мен жеңе алсам ғой.
Dialogue: 0,0:16:38.78,0:16:42.96,Default,,0,0,0,,Міне, Еуропа лигасының ашылу матчы басталды!
Dialogue: 0,0:16:43.04,0:16:45.54,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:16:46.67,0:16:48.34,Default,,0,0,0,,(іске қосу құрылғысының дыбысы)
Dialogue: 0,0:16:48.63,0:16:51.17,Default,,0,0,0,,Free-де іске қосу құралы бар
Dialogue: 0,0:16:51.38,0:16:54.05,Default,,0,0,0,,Бұл ресми матч, солай ма?
Dialogue: 0,0:16:54.84,0:16:57.51,Default,,0,0,0,,Бірінші ойын Бірінші шайқас
Dialogue: 0,0:16:58.97,0:16:59.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:02.52,0:17:04.23,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:04.64,0:17:07.90,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:08.11,0:17:10.40,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:10.48,0:17:11.48,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:11.90,0:17:16.99,Default,,0,0,0,,(Тыныш қону дыбысы)
Dialogue: 0,0:17:20.66,0:17:22.54,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:17:28.58,0:17:31.05,Default,,0,0,0,,Ағызу Fafnir Burst Finish
Dialogue: 0,0:17:31.34,0:17:35.09,Default,,0,0,0,,BC Сол бірінші ойында 2:0 есебімен жеңіске жетті!
Dialogue: 0,0:17:35.80,0:17:37.30,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:37.80,0:17:39.34,Default,,0,0,0,,Бұл тегін...
Dialogue: 0,0:17:39.43,0:17:41.18,Default,,0,0,0,,Құдіреті де керемет
Dialogue: 0,0:17:42.85,0:17:44.52,Default,,0,0,0,,Тегін Де Ла Хойя
Dialogue: 0,0:17:44.81,0:17:47.06,Default,,0,0,0,,Бұл BC Sol үшін ысырап
Dialogue: 0,0:17:47.14,0:17:48.56,Default,,0,0,0,,Мен оны өз үйімде қалаймын
Dialogue: 0,0:17:50.36,0:17:53.32,Default,,0,0,0,,Тегін! Бұл дәл қазір керемет болды
Dialogue: 0,0:17:53.40,0:17:57.49,Default,,0,0,0,,О! Өйткені, сен шынымен мықтысың...
Dialogue: 0,0:17:57.99,0:17:59.45,Default,,0,0,0,,Біз Мисаны екінші Кира болуы мүмкін деген күдікпен қамауға алдық
Dialogue: 0,0:17:59.74,0:18:02.03,Default,,0,0,0,,Келесі мен! Маған жаса!
Dialogue: 0,0:18:02.12,0:18:03.58,Default,,0,0,0,,Бұл менмін! Мен!
Dialogue: 0,0:18:03.99,0:18:04.95,Default,,0,0,0,,Сіз
Dialogue: 0,0:18:05.04,0:18:06.46,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:18:07.50,0:18:08.71,Default,,0,0,0,,(Ұрыс тіркеу дыбысы)
Dialogue: 0,0:18:09.04,0:18:10.71,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:18:10.79,0:18:12.67,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Балто!
Dialogue: 0,0:18:13.30,0:18:16.47,Default,,0,0,0,,Екінші ойын - BC Sol Balt Aoi!
Dialogue: 0,0:18:16.55,0:18:19.22,Default,,0,0,0,,Топ Вант - Куса Акерман!
Dialogue: 0,0:18:19.55,0:18:21.72,Default,,0,0,0,,Қайсысы нағыз Куза?
Dialogue: 0,0:18:22.05,0:18:24.06,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,0:18:24.52,0:18:26.60,Default,,0,0,0,,Біз бірге ойнамадық па?
Dialogue: 0,0:18:26.77,0:18:28.52,Default,,0,0,0,,Біз қазір доспыз, солай ма?
Dialogue: 0,0:18:28.73,0:18:30.06,Default,,0,0,0,,Енді біз жаумыз
Dialogue: 0,0:18:30.44,0:18:32.61,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:18:32.98,0:18:34.65,Default,,0,0,0,,Сабыр ет, Балто!
Dialogue: 0,0:18:34.73,0:18:37.44,Default,,0,0,0,,Тыныштық Тыныштық!
Dialogue: 0,0:18:39.82,0:18:42.49,Default,,0,0,0,,Супер шабуыл режимі және супер төзімділік режимі
Dialogue: 0,0:18:43.12,0:18:44.24,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:18:44.58,0:18:46.58,Default,,0,0,0,,Валькири – шабуыл түрі
Dialogue: 0,0:18:47.04,0:18:48.75,Default,,0,0,0,,Агрессивті тұлға
Dialogue: 0,0:18:49.12,0:18:52.25,Default,,0,0,0,,Төзімділік шайқастары үшін супер төзімділік режимін пайдалану тиімді.
Dialogue: 0,0:18:52.33,0:18:53.29,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:18:53.79,0:18:56.51,Default,,0,0,0,,Екінші ойын Бірінші шайқас
Dialogue: 0,0:18:58.05,0:18:59.76,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:00.13,0:19:02.93,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:03.47,0:19:05.89,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:08.18,0:19:11.56,Default,,0,0,0,,Бұл шықты! Кусаның кері соққысы!
Dialogue: 0,0:19:13.81,0:19:16.36,Default,,0,0,0,,Валькири қатты шабуыл жасайды!
Dialogue: 0,0:19:16.44,0:19:18.94,Default,,0,0,0,,Алға, байланған шабуыл!
Dialogue: 0,0:19:20.61,0:19:22.70,Default,,0,0,0,,Ой! Мен есінен танып қалдым!
Dialogue: 0,0:19:22.78,0:19:24.66,Default,,0,0,0,,Валькири көбірек шабуыл жасайды
Dialogue: 0,0:19:24.99,0:19:27.04,Default,,0,0,0,,Сыртқы түрі Валькири
Dialogue: 0,0:19:27.12,0:19:30.58,Default,,0,0,0,,Кронос шебер қашады
Dialogue: 0,0:19:30.66,0:19:32.83,Default,,0,0,0,,Валькири Сіздің импульсіңіз төмендеп жатыр ма?
Dialogue: 0,0:19:32.92,0:19:33.88,Default,,0,0,0,,Куу~
Dialogue: 0,0:19:34.04,0:19:37.34,Default,,0,0,0,,Егер бұл төзімділік сайысы болса, мен Кроносты жеңе алмаймын.
Dialogue: 0,0:19:37.59,0:19:39.88,Default,,0,0,0,,Super Stamina режимі күшті!
Dialogue: 0,0:19:40.13,0:19:41.59,Default,,0,0,0,,Сіз өлтіресіз.
Dialogue: 0,0:19:41.88,0:19:43.26,Default,,0,0,0,,Жоғалтпа
Dialogue: 0,0:19:43.51,0:19:45.01,Default,,0,0,0,,Ол әлі де осында!
Dialogue: 0,0:19:45.10,0:19:47.47,Default,,0,0,0,,Жүр, Валькири!
Dialogue: 0,0:19:48.60,0:19:49.47,Default,,0,0,0,,Не?
Dialogue: 0,0:19:53.69,0:19:56.77,Default,,0,0,0,,Екеуі де бір уақытта айналдырумен сурет салады
Dialogue: 0,0:19:59.28,0:20:01.78,Default,,0,0,0,,Дөңмай Донмай Келесі барайық!
Dialogue: 0,0:20:02.24,0:20:04.36,Default,,0,0,0,,Жарайды, тағы бір рет!
Dialogue: 0,0:20:05.62,0:20:06.78,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:20:07.62,0:20:10.95,Default,,0,0,0,,Сальто жасауды тез меңгергеніңізге сенімдімін.
Dialogue: 0,0:20:12.00,0:20:14.33,Default,,0,0,0,,Бұл мен ойлағаннан да қауіпті болуы мүмкін.
Dialogue: 0,0:20:14.58,0:20:17.25,Default,,0,0,0,,Олай болса, осында өлтірейік!
Dialogue: 0,0:20:17.34,0:20:19.05,Default,,0,0,0,,(бұрылу қабаттарының дыбысы)
Dialogue: 0,0:20:19.13,0:20:20.38,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:20:21.97,0:20:23.72,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:20:24.26,0:20:26.89,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:27.51,0:20:29.64,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:33.06,0:20:34.23,Default,,0,0,0,,Тоқтату!
Dialogue: 0,0:20:34.31,0:20:36.69,Default,,0,0,0,,Kronos басқа бетті өзгертіңіз
Dialogue: 0,0:20:36.77,0:20:39.23,Default,,0,0,0,,Супер шабуыл режимі!
Dialogue: 0,0:20:39.32,0:20:42.28,Default,,0,0,0,,(Үдемелі айналу дыбысы)
Dialogue: 0,0:20:42.36,0:20:43.65,Default,,0,0,0,,Міне! Міне осы!
Dialogue: 0,0:20:43.74,0:20:45.99,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:20:48.87,0:20:52.75,Default,,0,0,0,,Альтер Кронос? Бұл жолы жолымды таба алмай жүрмін
Dialogue: 0,0:20:52.96,0:20:54.62,Default,,0,0,0,,Бұл шынымен де бірдей шығанақ па?
Dialogue: 0,0:20:54.71,0:20:57.83,Default,,0,0,0,,Қабаттың ішінара салмағы бар.
Dialogue: 0,0:20:58.04,0:21:02.01,Default,,0,0,0,,Сол бағытты реттеу арқылы сіз мүлде басқа қозғалысқа ие боласыз.
Dialogue: 0,0:21:02.17,0:21:05.55,Default,,0,0,0,,Бұл шайқаста кім жеңеді?
Dialogue: 0,0:21:05.63,0:21:07.59,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:21:12.22,0:21:13.68,Default,,0,0,0,,Не? (Рантаро) Не!
Dialogue: 0,0:21:15.60,0:21:16.44,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:21:21.07,0:21:23.15,Default,,0,0,0,,Енді, келіңдер! Кронос!
Dialogue: 0,0:21:31.37,0:21:33.08,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:21:33.45,0:21:35.79,Default,,0,0,0,,Alter Chronos Burst Finish
Dialogue: 0,0:21:36.16,0:21:39.79,Default,,0,0,0,,Топ Вант екінші ойында 2-0 есебімен жеңіске жетті!
Dialogue: 0,0:21:40.13,0:21:41.71,Default,,0,0,0,,Қый!
Dialogue: 0,0:21:42.30,0:21:43.76,Default,,0,0,0,,BC Sol қазір
Dialogue: 0,0:21:43.96,0:21:46.68,Default,,0,0,0,,Тегін Де Ла Хойяға байланысты
Dialogue: 0,0:21:46.76,0:21:50.35,Default,,0,0,0,,Қазір кетсеңіз, сіз жай ғана әлсіз командасыз.
Dialogue: 0,0:21:56.06,0:21:58.52,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.60,0:22:01.94,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:02.02,0:22:04.90,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.99,0:22:07.11,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.20,0:22:10.70,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.78,0:22:14.37,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.45,0:22:16.20,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.29,0:22:18.04,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.12,0:22:19.92,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:20.00,0:22:21.59,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.67,0:22:23.55,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.63,0:22:26.13,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.21,0:22:29.13,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.22,0:22:32.85,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.93,0:22:36.60,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.68,0:22:38.39,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.48,0:22:41.65,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.73,0:22:44.02,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.11,0:22:47.61,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.69,0:22:51.20,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.28,0:22:53.24,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.33,0:22:55.04,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.12,0:22:58.54,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.62,0:23:00.67,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.75,0:23:03.63,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.71,0:23:05.92,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:06.00,0:23:09.93,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:10.01,0:23:13.60,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.68,0:23:17.18,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.27,0:23:20.52,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.60,0:23:22.27,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.35,0:23:22.77,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.77,0:23:25.19,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.77,0:23:25.19,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.19,0:23:25.57,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.15,0:23:28.49,Default,,0,0,0,,Мен Кузамен соқтығысамын
Dialogue: 0,0:23:28.57,0:23:30.20,Default,,0,0,0,,Куза шынымен мықты екен
Dialogue: 0,0:23:30.45,0:23:32.74,Default,,0,0,0,,Мен Кроносты жеңгім келеді!
Dialogue: 0,0:23:32.82,0:23:36.87,Default,,0,0,0,,Бірақ қосалқы мүше Cisco маған мұны істеуге рұқсат беруімді айтты.
Dialogue: 0,0:23:36.95,0:23:39.00,Default,,0,0,0,,Тегін Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:23:39.70,0:23:42.08,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:42.21,0:23:44.21,Default,,0,0,0,,Уақыт Құдай! Кроносты өзгертіңіз!
Dialogue: 0,0:23:44.63,0:23:48.30,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:49.80,0:23:55.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory