Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.54,0:00:07.17,Default,,0,0,0,,wbba әлемдік лигасы
Dialogue: 0,0:00:07.71,0:00:09.88,Default,,0,0,0,,Әр лигада жеңіске жеткен клубтар...
Dialogue: 0,0:00:10.17,0:00:12.84,Default,,0,0,0,,Әлемнің шыңына қарай шайқас
Dialogue: 0,0:00:13.09,0:00:14.55,Default,,0,0,0,,Чемпион болуды мақсат етіңіз
Dialogue: 0,0:00:14.84,0:00:16.51,Default,,0,0,0,,Қолға алу үшін бірінші нөмір
Dialogue: 0,0:00:16.97,0:00:18.51,Default,,0,0,0,,Жауынгерлік рухыңызды өртеп жіберіңіз
Dialogue: 0,0:00:18.60,0:00:20.27,Default,,0,0,0,,Және шектен шығу
Dialogue: 0,0:00:20.97,0:00:22.43,Default,,0,0,0,,Жалынды жандардың шайқасы
Dialogue: 0,0:00:22.81,0:00:24.98,Default,,0,0,0,,Дүниені отқа сал
Dialogue: 0,0:00:25.81,0:00:27.27,Default,,0,0,0,,Даңққа кім ие болады?
Dialogue: 0,0:00:27.94,0:00:29.19,Default,,0,0,0,,Бұл – тура қызыл карта. (Бакуго) Тс.
Dialogue: 0,0:00:31.03,0:00:33.36,Default,,0,0,0,,Біз Бразилиядамыз...
Dialogue: 0,0:00:33.45,0:00:36.70,Default,,0,0,0,,Мен Рувеймен 3-тен 1-ге жекпе-жек өткіздім.
Dialogue: 0,0:00:38.78,0:00:41.41,Default,,0,0,0,,Regulus слайд қабаты!
Dialogue: 0,0:00:42.62,0:00:44.46,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:00:44.54,0:00:45.54,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:46.54,0:00:48.29,Default,,0,0,0,,Барлық нәтижелер...
Dialogue: 0,0:00:48.84,0:00:50.05,Default,,0,0,0,,Бұл өте көңілсіз болды.
Dialogue: 0,0:00:50.80,0:00:52.92,Default,,0,0,0,,Баккааро!
Dialogue: 0,0:00:55.68,0:00:58.30,Default,,0,0,0,,Жүз адам шайқасы Маған да рұқсат етіңіз!
Dialogue: 0,0:00:58.80,0:01:01.47,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:01.56,0:01:02.72,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:05.23,0:01:07.48,Default,,0,0,0,,Шака! Бұл менікі -
Dialogue: 0,0:01:07.65,0:01:10.02,Default,,0,0,0,,Менің барлық күшім!
Dialogue: 0,0:01:12.53,0:01:14.65,Default,,0,0,0,,Сіз Шакамен шайқаса аласыз
Dialogue: 0,0:01:15.15,0:01:17.41,Default,,0,0,0,,Бразилия Риосына қарсы жартылай финал!
Dialogue: 0,0:01:17.91,0:01:19.53,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:01:19.70,0:01:22.41,Default,,0,0,0,,Уау, бүкіл денем ауырады.
Dialogue: 0,0:01:22.49,0:01:24.70,Default,,0,0,0,,Мен бірінші барамын!
Dialogue: 0,0:01:26.75,0:01:30.04,Default,,0,0,0,,Сол пайдасыз денеге бірдеңе жасаңыз!
Dialogue: 0,0:01:30.29,0:01:31.13,Default,,0,0,0,,О...
Dialogue: 0,0:01:31.21,0:01:33.13,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:01:33.21,0:01:34.34,Default,,0,0,0,,Үш
Dialogue: 0,0:01:34.42,0:01:35.55,Default,,0,0,0,,Екі
Dialogue: 0,0:01:35.63,0:01:36.76,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:01:36.84,0:01:38.18,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:01:38.26,0:01:39.43,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:01:39.51,0:01:41.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:57.45,0:02:01.12,Default,,0,0,0,,Тіпті таңғы нұрмен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:02.08,0:02:04.41,Default,,0,0,0,,Бір жерден естілген дыбыс
Dialogue: 0,0:02:04.49,0:02:06.83,Default,,0,0,0,,Бұл шығанақтың соқтығысуы.
Dialogue: 0,0:02:06.91,0:02:11.25,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:11.92,0:02:16.67,Default,,0,0,0,,Жалынды жүрек ұйықтамайды, Майданға құмар.
Dialogue: 0,0:02:16.76,0:02:21.68,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:21.76,0:02:26.64,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:26.72,0:02:31.77,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:31.86,0:02:35.07,Default,,0,0,0,,Қазір ат!
Dialogue: 0,0:02:35.15,0:02:37.19,Default,,0,0,0,,(Үш екі бір ату!)
Dialogue: 0,0:02:37.28,0:02:39.20,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:39.28,0:02:41.45,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:41.53,0:02:46.45,Default,,0,0,0,,Маған бұрын ешқашан көрмеген шайқасты көрсетіңіз
Dialogue: 0,0:02:46.54,0:02:49.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:49.37,0:02:55.30,Default,,0,0,0,,Әріптесіңізбен үнемі дамып келе жатқан қарым-қатынас пен жүрек соғуымен
Dialogue: 0,0:02:55.38,0:02:59.88,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз.
Dialogue: 0,0:02:59.97,0:03:01.97,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:13.27,0:03:16.36,Default,,0,0,0,,Қақтығыс! Финалға ат салыңыз! !
Dialogue: 0,0:03:17.03,0:03:18.86,Default,,0,0,0,,Okay!
Dialogue: 0,0:03:18.94,0:03:21.49,Default,,0,0,0,,Бразилия Риос пен BC Сол -
Dialogue: 0,0:03:22.03,0:03:25.16,Default,,0,0,0,,Жартылай финалдың бірінші ойыны басталды!
Dialogue: 0,0:03:25.49,0:03:28.16,Default,,0,0,0,,Жанып тұрған ғибадатханадағы Кайзаға қарсы шығатын үлкен бестіктің бірі...
Dialogue: 0,0:03:28.24,0:03:30.41,Default,,0,0,0,,Cisco Carlisle!
Dialogue: 0,0:03:30.50,0:03:32.37,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:03:32.71,0:03:33.29,Default,,0,0,0,,Эйя…
Dialogue: 0,0:03:33.54,0:03:34.21,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:34.29,0:03:36.09,Default,,0,0,0,,Бірінші шабуыл!
Dialogue: 0,0:03:36.17,0:03:37.34,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:03:37.42,0:03:40.47,Default,,0,0,0,,Эй, Экскалибурдың шабуылы.
Dialogue: 0,0:03:40.55,0:03:41.97,Default,,0,0,0,,Мен бұйраны қайтардым
Dialogue: 0,0:03:42.76,0:03:45.43,Default,,0,0,0,,Excalibur қабырғаға соғылады!
Dialogue: 0,0:03:46.10,0:03:47.51,Default,,0,0,0,,Керемет, Cisco!
Dialogue: 0,0:03:47.60,0:03:49.31,Default,,0,0,0,,Мен бара аламын! Мен бара аламын!
Dialogue: 0,0:03:49.39,0:03:50.14,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:03:51.77,0:03:53.23,Default,,0,0,0,,(сықырлау дыбысы)
Dialogue: 0,0:03:53.90,0:03:55.73,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:03:56.11,0:03:56.69,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:04:00.57,0:04:02.78,Default,,0,0,0,,Енді не істейміз Шақа?
Dialogue: 0,0:04:03.07,0:04:06.16,Default,,0,0,0,,Қандай таң қалдыратын оқиға!
Dialogue: 0,0:04:06.24,0:04:08.33,Default,,0,0,0,,Зиг Экскалибурдың шабуылы...
Dialogue: 0,0:04:08.41,0:04:10.20,Default,,0,0,0,,Мен мүлде тыңдамаймын!
Dialogue: 0,0:04:10.29,0:04:10.83,Default,,0,0,0,,
Dialogue: 0,0:04:11.62,0:04:12.91,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:13.71,0:04:16.42,Default,,0,0,0,,Cisco! Іске сәт!
Dialogue: 0,0:04:16.50,0:04:17.25,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:04:17.38,0:04:18.42,Default,,0,0,0,,(Тоқтау дыбысы)
Dialogue: 0,0:04:19.05,0:04:20.55,Default,,0,0,0,,Шыда, Шайтан!
Dialogue: 0,0:04:20.80,0:04:22.17,Default,,0,0,0,,Cisco!
Dialogue: 0,0:04:22.26,0:04:24.09,Default,,0,0,0,,Бар, жүр, жүр!
Dialogue: 0,0:04:24.18,0:04:24.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:24.76,0:04:26.80,Default,,0,0,0,,Ағай! Ах...
Dialogue: 0,0:04:26.89,0:04:29.01,Default,,0,0,0,,Сәлем Балто!
Dialogue: 0,0:04:29.10,0:04:30.22,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:04:30.47,0:04:32.31,Default,,0,0,0,,Бұлшықет ауруы.
Dialogue: 0,0:04:32.39,0:04:34.81,Default,,0,0,0,,Экскалибурдың үздіксіз шабуылдары...
Dialogue: 0,0:04:34.89,0:04:36.69,Default,,0,0,0,,Айқай Шайтан шыдайды
Dialogue: 0,0:04:36.77,0:04:39.15,Default,,0,0,0,,Бұл төзімділік шайқасы бола ма? ?
Dialogue: 0,0:04:39.23,0:04:41.15,Default,,0,0,0,,Ой-оу-ай!
Dialogue: 0,0:04:41.23,0:04:43.15,Default,,0,0,0,,Екі айналым да әлсіреді!
Dialogue: 0,0:04:43.24,0:04:43.99,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:04:44.07,0:04:45.49,Default,,0,0,0,,Алдымен не тоқтайды?
Dialogue: 0,0:04:45.61,0:04:49.78,Default,,0,0,0,,Қайсысы! ?
Dialogue: 0,0:04:51.58,0:04:54.46,Default,,0,0,0,,Crys Satan Spin Finish
Dialogue: 0,0:04:54.58,0:04:56.37,Default,,0,0,0,,BC Sol үшін 1 ұпай
Dialogue: 0,0:04:56.58,0:04:58.13,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:04:58.21,0:05:00.13,Default,,0,0,0,,Алдын алу нүктесі BC Sol!
Dialogue: 0,0:05:00.75,0:05:01.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:02.84,0:05:04.26,Default,,0,0,0,,Nu~!
Dialogue: 0,0:05:04.51,0:05:07.01,Default,,0,0,0,,Біріншіден, 1 ұпай преептив! (Сары тау) Жарайды.
Dialogue: 0,0:05:07.09,0:05:08.26,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:05:08.34,0:05:10.64,Default,,0,0,0,,Cisco, сіз мұны істей аласыз!
Dialogue: 0,0:05:11.39,0:05:16.10,Default,,0,0,0,,Хига~! Риксон не істеп жатырсың?
Dialogue: 0,0:05:16.77,0:05:17.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:17.69,0:05:18.98,Default,,0,0,0,,Спорттық массаж
Dialogue: 0,0:05:19.36,0:05:22.61,Default,,0,0,0,,Бұлшық еттері ауырып бар күшіңмен атуға болмайды!
Dialogue: 0,0:05:23.44,0:05:24.24,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:05:24.32,0:05:25.45,Default,,0,0,0,,Уф
Dialogue: 0,0:05:25.53,0:05:26.20,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:05:26.36,0:05:28.91,Default,,0,0,0,,Свуш свуш свуш
Dialogue: 0,0:05:29.66,0:05:32.33,Default,,0,0,0,,Эй, сен мұны істей аласың ба?
Dialogue: 0,0:05:32.66,0:05:34.66,Default,,0,0,0,,Хехе, мен оны қариямнан үйрендім.
Dialogue: 0,0:05:34.79,0:05:37.79,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:05:38.50,0:05:39.79,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:05:39.88,0:05:42.25,Default,,0,0,0,,Шака! Шака!
Dialogue: 0,0:05:43.55,0:05:46.67,Default,,0,0,0,,Уау! Шака осында шақыр
Dialogue: 0,0:05:46.76,0:05:48.63,Default,,0,0,0,,Риос стадионына ғана тән
Dialogue: 0,0:05:48.72,0:05:49.72,Default,,0,0,0,,Ыстық қоңырау!
Dialogue: 0,0:05:49.80,0:05:53.14,Default,,0,0,0,,Бұл BC Sol пышақтары үшін қиын!
Dialogue: 0,0:05:53.56,0:05:54.60,Default,,0,0,0,,Енді бұл – қабілетке қарсы қабілет, техникаға қарсы техника, рухқа қарсы рух!
Dialogue: 0,0:05:54.77,0:05:56.68,Default,,0,0,0,,Cisco! Ілгері жүру!
Dialogue: 0,0:05:57.06,0:05:58.60,Default,,0,0,0,,Cisco!
Dialogue: 0,0:05:58.69,0:05:59.19,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:59.27,0:06:00.86,Default,,0,0,0,,Cisco! Cisco!
Dialogue: 0,0:06:00.94,0:06:03.07,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:06:03.44,0:06:05.36,Default,,0,0,0,,Ха! Балтоға ұқсайды
Dialogue: 0,0:06:06.19,0:06:08.03,Default,,0,0,0,,Оны да жасайық
Dialogue: 0,0:06:08.49,0:06:09.16,Default,,0,0,0,,О!
Dialogue: 0,0:06:09.24,0:06:09.91,Default,,0,0,0,,О!
Dialogue: 0,0:06:09.99,0:06:10.91,Default,,0,0,0,,О!
Dialogue: 0,0:06:11.24,0:06:15.66,Default,,0,0,0,,Cisco! Cisco!
Dialogue: 0,0:06:15.75,0:06:20.67,Default,,0,0,0,,Шака! Шака! (4 адам) Cisco! Cisco!
Dialogue: 0,0:06:20.75,0:06:23.67,Default,,0,0,0,,Қараңдар! Сен де дауыстап сөйле.
Dialogue: 0,0:06:23.75,0:06:26.05,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:06:26.13,0:06:28.55,Default,,0,0,0,,Шулы емес пе? Балт
Dialogue: 0,0:06:28.72,0:06:29.55,Default,,0,0,0,,Жақсы
Dialogue: 0,0:06:29.97,0:06:32.97,Default,,0,0,0,,Бірақ сен осылай алыста жүргенде...
Dialogue: 0,0:06:33.14,0:06:35.56,Default,,0,0,0,,Оның даусы да жаман емес.
Dialogue: 0,0:06:37.39,0:06:39.94,Default,,0,0,0,,Енді екінші шайқас!
Dialogue: 0,0:06:40.35,0:06:42.19,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:06:42.27,0:06:43.40,Default,,0,0,0,,Үш
Dialogue: 0,0:06:43.48,0:06:44.61,Default,,0,0,0,,Екі
Dialogue: 0,0:06:44.69,0:06:45.82,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:06:45.90,0:06:48.32,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:48.40,0:06:49.40,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:06:49.49,0:06:53.07,Default,,0,0,0,,Yao! Excalibur үлкен күшке ие
Dialogue: 0,0:06:53.28,0:06:54.87,Default,,0,0,0,,Хан! Тек серпін...
Dialogue: 0,0:06:54.95,0:06:56.74,Default,,0,0,0,,Бұл Crys Satan-да жұмыс істемейді!
Dialogue: 0,0:06:56.83,0:06:57.58,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:06:58.58,0:06:59.25,Default,,0,0,0,,Ой!
Dialogue: 0,0:06:59.33,0:07:02.50,Default,,0,0,0,,Ах! Экскалибур қатты соққыға жығылды
Dialogue: 0,0:07:02.58,0:07:05.00,Default,,0,0,0,,Бұл аяқталды ма?
Dialogue: 0,0:07:05.09,0:07:06.50,Default,,0,0,0,,О!
Dialogue: 0,0:07:06.59,0:07:09.05,Default,,0,0,0,,Маған ұнамады.
Dialogue: 0,0:07:09.17,0:07:12.01,Default,,0,0,0,,Жооо! Ілгері жүру!
Dialogue: 0,0:07:12.68,0:07:13.43,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:07:13.51,0:07:16.76,Default,,0,0,0,,Қақтығыс? Жоқ, Crys Satan оны қайтадан қайтарады.
Dialogue: 0,0:07:17.64,0:07:19.35,Default,,0,0,0,,Fah fah fah
Dialogue: 0,0:07:19.43,0:07:20.52,Default,,0,0,0,,Сол әмияны—
Dialogue: 0,0:07:20.60,0:07:22.60,Default,,0,0,0,,Бұл ақымақ тактика...
Dialogue: 0,0:07:22.81,0:07:24.23,Default,,0,0,0,,Бұл сөзсіз жұмыс істейді!
Dialogue: 0,0:07:26.65,0:07:29.90,Default,,0,0,0,,Ғаземнен жеңілгенімде маған солай айттың ба?
Dialogue: 0,0:07:30.32,0:07:33.24,Default,,0,0,0,,Фа-фа-фа-фа Ошиино
Dialogue: 0,0:07:33.74,0:07:34.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:35.32,0:07:36.24,Default,,0,0,0,,Хамф
Dialogue: 0,0:07:37.24,0:07:41.66,Default,,0,0,0,,Менің ойымша, Гаруданың тактикасы өте қызықты.
Dialogue: 0,0:07:42.46,0:07:45.92,Default,,0,0,0,,Сол қызықты тактикадан жеңіліп қалдық!
Dialogue: 0,0:07:46.71,0:07:50.26,Default,,0,0,0,,Жеңілсең, сен де жалықтырасың.
Dialogue: 0,0:07:50.42,0:07:52.09,Default,,0,0,0,,Шайтанның айқайы
Dialogue: 0,0:07:52.26,0:07:54.14,Default,,0,0,0,,Қарсыластың шыдамдылығын қалай жоюға болады
Dialogue: 0,0:07:54.22,0:07:57.60,Default,,0,0,0,,Бұл өте қолайлы шығанақ.
Dialogue: 0,0:07:59.02,0:08:00.31,Default,,0,0,0,,Шұғыл хабар, шұғыл хабар!
Dialogue: 0,0:08:00.52,0:08:02.69,Default,,0,0,0,,Атқанда аздап ақымақтық...
Dialogue: 0,0:08:02.77,0:08:06.73,Default,,0,0,0,,Менің ойымша, іске қосқышты еңкейтсеңіз жақсы болар еді.
Dialogue: 0,0:08:07.36,0:08:08.94,Default,,0,0,0,,Шайтанды жылат
Dialogue: 0,0:08:09.03,0:08:11.86,Default,,0,0,0,,Мен Сиг Экскалибурды үйреніп жатырмын.
Dialogue: 0,0:08:11.94,0:08:16.28,Default,,0,0,0,,Экскалибурдың күші мүлдем жұмыс істемейді.
Dialogue: 0,0:08:17.12,0:08:20.20,Default,,0,0,0,,Енді сіз Экскалибурдың ерекше қозғалысын меңгердіңіз!
Dialogue: 0,0:08:21.20,0:08:21.95,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:08:22.04,0:08:24.79,Default,,0,0,0,,Excalibur үш есе әсер ету үшін...
Dialogue: 0,0:08:24.87,0:08:27.46,Default,,0,0,0,,Дискіні құлыптау жұмыс істеуі керек, солай ма?
Dialogue: 0,0:08:27.54,0:08:28.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:30.46,0:08:30.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:31.55,0:08:32.34,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:08:32.63,0:08:34.51,Default,,0,0,0,,Сәлем! Оны аяқтаңыз
Dialogue: 0,0:08:34.59,0:08:36.09,Default,,0,0,0,,Шайтанды жылат!
Dialogue: 0,0:08:42.85,0:08:43.68,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:08:47.19,0:08:49.23,Default,,0,0,0,,Ал, баста!
Dialogue: 0,0:08:49.32,0:08:50.98,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:51.23,0:08:51.98,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:08:53.65,0:08:54.53,Default,,0,0,0,,(рок дыбысы)
Dialogue: 0,0:08:54.82,0:09:00.08,Default,,0,0,0,,Теңдесі жоқ қылыш Сиг Экскалибур!
Dialogue: 0,0:09:03.87,0:09:04.62,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:09:04.71,0:09:06.33,Default,,0,0,0,,Барлығын жойыңыз
Dialogue: 0,0:09:06.42,0:09:09.34,Default,,0,0,0,,Үш есе әсер ету!
Dialogue: 0,0:09:09.42,0:09:12.92,Default,,0,0,0,,Циклондық цикл!
Dialogue: 0,0:09:16.68,0:09:17.68,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:09:18.59,0:09:20.35,Default,,0,0,0,,Не...!
Dialogue: 0,0:09:20.64,0:09:21.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:21.51,0:09:24.18,Default,,0,0,0,,Sieg Excalibur Burst Finish
Dialogue: 0,0:09:24.73,0:09:26.02,Default,,0,0,0,,2-1 пункттер -
Dialogue: 0,0:09:26.10,0:09:29.02,Default,,0,0,0,,Бірінші ойын Бразилия Риосының жеңісі болды!
Dialogue: 0,0:09:29.27,0:09:29.98,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:30.06,0:09:33.03,Default,,0,0,0,,Нант! Қатты шайқастан кейін...
Dialogue: 0,0:09:33.11,0:09:35.95,Default,,0,0,0,,Жарылған адам - Crys Satan!
Dialogue: 0,0:09:36.03,0:09:37.74,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:37.82,0:09:41.83,Default,,0,0,0,,Өзін осылай қорғады. Ол әдетте жеңеді!
Dialogue: 0,0:09:42.12,0:09:44.87,Default,,0,0,0,,Бұл ұят болды... Cisco
Dialogue: 0,0:09:44.95,0:09:45.45,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:45.62,0:09:48.83,Default,,0,0,0,,Әй, бұл дерлік болды.
Dialogue: 0,0:09:49.21,0:09:50.67,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:09:50.88,0:09:54.59,Default,,0,0,0,,Шақа және басқалары үздік болды.
Dialogue: 0,0:09:54.67,0:09:56.05,Default,,0,0,0,,Tah!
Dialogue: 0,0:09:56.13,0:09:58.93,Default,,0,0,0,,Шака! Шака!
Dialogue: 0,0:09:59.01,0:10:02.68,Default,,0,0,0,,Шака! Шака!
Dialogue: 0,0:10:03.18,0:10:03.68,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:10:04.31,0:10:06.68,Default,,0,0,0,,Үш еселік әсерді қалай алдың?
Dialogue: 0,0:10:07.23,0:10:09.94,Default,,0,0,0,,Айналдыру аяқталғаннан кейін мен түсінемін.
Dialogue: 0,0:10:10.35,0:10:13.32,Default,,0,0,0,,Бей ғана басқалармен қақтығысатын адам емес.
Dialogue: 0,0:10:13.52,0:10:14.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:14.40,0:10:15.15,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:10:16.69,0:10:17.57,Default,,0,0,0,,(рок дыбысы)
Dialogue: 0,0:10:18.03,0:10:20.95,Default,,0,0,0,,Екінші шайқас қабырғаға қасақана соғу болды...
Dialogue: 0,0:10:21.78,0:10:23.20,Default,,0,0,0,,Мен ату күшімді арттырдым.
Dialogue: 0,0:10:23.95,0:10:26.08,Default,,0,0,0,,Құлыпты алға жылжыту үшін!
Dialogue: 0,0:10:26.50,0:10:27.04,Default,,0,0,0,,Пә!
Dialogue: 0,0:10:27.91,0:10:29.62,Default,,0,0,0,,Бұл жай ғана ақымақ күш емес пе?
Dialogue: 0,0:10:30.63,0:10:31.21,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:10:32.04,0:10:35.71,Default,,0,0,0,,Керемет! Тезірек Шақамен шайқасыңыз!
Dialogue: 0,0:10:35.96,0:10:36.96,Default,,0,0,0,,Тыныш отырыңыз
Dialogue: 0,0:10:37.30,0:10:39.13,Default,,0,0,0,,Массаж әлі аяқталған жоқ!
Dialogue: 0,0:10:39.26,0:10:41.43,Default,,0,0,0,,Уау
Dialogue: 0,0:10:41.51,0:10:42.14,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:42.22,0:10:43.93,Default,,0,0,0,,Соқ!
Dialogue: 0,0:10:44.93,0:10:46.93,Default,,0,0,0,,Әлемдік лиганың жартылай финалы
Dialogue: 0,0:10:47.02,0:10:49.31,Default,,0,0,0,,Нью-Йорк Буллз және Париж Блэйдс
Dialogue: 0,0:10:49.39,0:10:50.19,Default,,0,0,0,,Бірінші ойын –
Dialogue: 0,0:10:50.56,0:10:52.69,Default,,0,0,0,,Blast Genius Burst Finish
Dialogue: 0,0:10:52.77,0:10:55.36,Default,,0,0,0,,Джошуа Бун жеңді!
Dialogue: 0,0:10:55.61,0:10:57.82,Default,,0,0,0,,Біріншіден, Нью-Йорк Буллз көш бастады.
Dialogue: 0,0:10:58.07,0:10:59.90,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:10:59.99,0:11:02.66,Default,,0,0,0,,Барлығы күткендей, Джошуа Бунмен
Dialogue: 0,0:11:02.74,0:11:04.74,Default,,0,0,0,,Бұл Бластоген...
Dialogue: 0,0:11:04.83,0:11:06.83,Default,,0,0,0,,Ертегінің жеңісі!
Dialogue: 0,0:11:07.37,0:11:08.87,Default,,0,0,0,,Ша~о!
Dialogue: 0,0:11:09.21,0:11:11.08,Default,,0,0,0,,(жанкүйерлер қолдайды)
Dialogue: 0,0:11:11.62,0:11:15.21,Default,,0,0,0,,Аты бүкіл әлемге тараған Үлкен 5-тің бірі.
Dialogue: 0,0:11:15.29,0:11:16.42,Default,,0,0,0,,Джошуа Бун!
Dialogue: 0,0:11:16.75,0:11:20.26,Default,,0,0,0,,Бұл жұлдыздың күші көп болатын жарылған мәре болды.
Dialogue: 0,0:11:24.26,0:11:26.56,Default,,0,0,0,,Мен сенің сөмкеңді келесі жолы қайтарамын.
Dialogue: 0,0:11:26.68,0:11:28.72,Default,,0,0,0,,Екінші тарап нашар болды.
Dialogue: 0,0:11:28.81,0:11:31.31,Default,,0,0,0,,Бұл жақсы, жайлылық.
Dialogue: 0,0:11:31.44,0:11:32.65,Default,,0,0,0,,(орган музыкасы)
Dialogue: 0,0:11:33.15,0:11:33.73,Default,,0,0,0,,Ha
Dialogue: 0,0:11:34.36,0:11:36.90,Default,,0,0,0,,Әй, көңіліңді түсірме, Рикку.
Dialogue: 0,0:11:37.32,0:11:40.24,Default,,0,0,0,,Сол Блейдерге жеңілістің қорлығын беру...
Dialogue: 0,0:11:40.40,0:11:41.86,Default,,0,0,0,,Бұл Clio Doron
Dialogue: 0,0:11:42.07,0:11:44.07,Default,,0,0,0,,Сіз қорқынышты түске бататыныңыз анық...
Dialogue: 0,0:11:44.95,0:11:47.58,Default,,0,0,0,,Ол енді ешқашан көтерілмейді
Dialogue: 0,0:11:48.66,0:11:49.41,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:11:50.50,0:11:52.87,Default,,0,0,0,,Әдеттегідей «Мен жеңдім» деп айтыңыз.
Dialogue: 0,0:11:52.96,0:11:53.62,Default,,0,0,0,,(сорғыш дыбыс)
Dialogue: 0,0:11:53.75,0:11:54.25,Default,,0,0,0,,Ha
Dialogue: 0,0:11:54.92,0:11:56.09,Default,,0,0,0,,Келіңіздер, капитан.
Dialogue: 0,0:11:56.34,0:11:59.13,Default,,0,0,0,,Екінші ойында менің атымды айт
Dialogue: 0,0:11:59.67,0:12:01.13,Default,,0,0,0,,Түсіндім, түсіндім.
Dialogue: 0,0:12:01.59,0:12:03.13,Default,,0,0,0,,Clio, өтінемін.
Dialogue: 0,0:12:03.72,0:12:04.55,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:04.89,0:12:07.85,Default,,0,0,0,,Менің жеңісімнің куәсі бол!
Dialogue: 0,0:12:08.31,0:12:10.60,Default,,0,0,0,,Мен түсіндім, сондықтан қазір тіркеліңіз.
Dialogue: 0,0:12:14.90,0:12:16.65,Default,,0,0,0,,Келіңіздер! 2-ойын
Dialogue: 0,0:12:17.27,0:12:19.73,Default,,0,0,0,,Бразилия Риосы – Стэн Гамбург!
Dialogue: 0,0:12:19.82,0:12:22.70,Default,,0,0,0,,BC Солға қарсы Риксон Клэй!
Dialogue: 0,0:12:23.74,0:12:25.70,Default,,0,0,0,,Қария, бұл шайқас-
Dialogue: 0,0:12:26.32,0:12:27.91,Default,,0,0,0,,Мұқият қараңыз!
Dialogue: 0,0:12:28.28,0:12:30.24,Default,,0,0,0,,Сәлем бәріңе!
Dialogue: 0,0:12:30.33,0:12:33.08,Default,,0,0,0,,Стэн бұрын б.з.д Сольде тұрған.
Dialogue: 0,0:12:33.16,0:12:35.96,Default,,0,0,0,,Бұрынғы әріптестер арасындағы тартыс!
Dialogue: 0,0:12:36.25,0:12:38.42,Default,,0,0,0,,Біз жаумыз
Dialogue: 0,0:12:38.54,0:12:39.92,Default,,0,0,0,,О
Dialogue: 0,0:12:40.00,0:12:42.13,Default,,0,0,0,,Сіз ең жоғарғы командаға жеттіңіз.
Dialogue: 0,0:12:42.55,0:12:43.55,Default,,0,0,0,,Тым кеш
Dialogue: 0,0:12:43.92,0:12:45.89,Default,,0,0,0,,Таста үш жыл!
Dialogue: 0,0:12:45.97,0:12:46.72,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:12:47.18,0:12:48.93,Default,,0,0,0,,Бірақ мен жеңемін!
Dialogue: 0,0:12:49.01,0:12:49.72,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:12:50.06,0:12:51.18,Default,,0,0,0,,Екінші ойын
Dialogue: 0,0:12:51.47,0:12:52.48,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:12:54.14,0:12:55.85,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:12:55.94,0:12:57.06,Default,,0,0,0,,Үш
Dialogue: 0,0:12:57.15,0:12:58.23,Default,,0,0,0,,Екі
Dialogue: 0,0:12:58.31,0:12:59.48,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:12:59.69,0:13:00.65,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:13:00.73,0:13:01.94,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:13:02.03,0:13:02.99,Default,,0,0,0,,Ди!
Dialogue: 0,0:13:03.07,0:13:07.03,Default,,0,0,0,,Енді, Бей жеңілді!
Dialogue: 0,0:13:07.57,0:13:09.03,Default,,0,0,0,,Жақсы, Хиксон.
Dialogue: 0,0:13:09.37,0:13:11.04,Default,,0,0,0,,Мен қатты күйіп қалдым!
Dialogue: 0,0:13:11.99,0:13:13.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:13.75,0:13:14.50,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:13:16.42,0:13:18.54,Default,,0,0,0,,Нью-Йорк Буллз қарсы
Dialogue: 0,0:13:18.63,0:13:20.80,Default,,0,0,0,,Бұл Париж Блэдерстің екінші ойыны.
Dialogue: 0,0:13:21.05,0:13:23.55,Default,,0,0,0,,(сорғыш дыбыс)
Dialogue: 0,0:13:23.63,0:13:24.17,Default,,0,0,0,,Хааа
Dialogue: 0,0:13:24.76,0:13:28.18,Default,,0,0,0,,Енді құрбандық шалушы кім?
Dialogue: 0,0:13:28.51,0:13:29.68,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:13:30.18,0:13:31.85,Default,,0,0,0,,Қарсылас – Нью-Йорк Буллз.
Dialogue: 0,0:13:32.10,0:13:33.81,Default,,0,0,0,,Кім шықса да, қатал болады.
Dialogue: 0,0:13:34.10,0:13:35.73,Default,,0,0,0,,О, досым
Dialogue: 0,0:13:36.14,0:13:38.44,Default,,0,0,0,,Көңілді сөздеріңіз үшін рахмет
Dialogue: 0,0:13:38.85,0:13:40.48,Default,,0,0,0,,Жадтан тыс
Dialogue: 0,0:13:40.86,0:13:44.07,Default,,0,0,0,,Сенімен алғаш ұрысқан кезім есімде.
Dialogue: 0,0:13:44.57,0:13:45.44,Default,,0,0,0,,Іс жүзінде-
Dialogue: 0,0:13:46.03,0:13:48.78,Default,,0,0,0,,Бұл нағыз тәтті кездесу болды.
Dialogue: 0,0:13:49.49,0:13:52.16,Default,,0,0,0,,Кеттік, дайын жиынтық
Dialogue: 0,0:13:52.45,0:13:54.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:55.16,0:13:55.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:56.08,0:13:58.00,Default,,0,0,0,,(орган музыкасы)
Dialogue: 0,0:13:58.29,0:13:59.04,Default,,0,0,0,,Who?
Dialogue: 0,0:13:59.17,0:14:01.00,Default,,0,0,0,,Бұл бір нәрсе үшін бе?
Dialogue: 0,0:14:05.92,0:14:08.59,Default,,0,0,0,,Сәлеметсіздер ме, мырзалар
Dialogue: 0,0:14:08.76,0:14:10.34,Default,,0,0,0,,(шатастырылған дауыс)
Dialogue: 0,0:14:10.68,0:14:11.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:11.68,0:14:14.60,Default,,0,0,0,,Мен сізге қосылуды сұрайтын құжаттарды жіберуім керек еді, бірақ...
Dialogue: 0,0:14:14.89,0:14:16.43,Default,,0,0,0,,Не? Blader?
Dialogue: 0,0:14:16.56,0:14:19.35,Default,,0,0,0,,Иә, құжаттар қабылданып қойған.
Dialogue: 0,0:14:19.69,0:14:21.73,Default,,0,0,0,,Сонымен... бұл жаңа мүше ме?
Dialogue: 0,0:14:22.02,0:14:24.98,Default,,0,0,0,,Иә, Клио... болды ма?
Dialogue: 0,0:14:25.57,0:14:28.74,Default,,0,0,0,,Қош бол, менің атым Клио Дорон.
Dialogue: 0,0:14:29.11,0:14:32.74,Default,,0,0,0,,Трансильваниядан келген қара қылшық
Dialogue: 0,0:14:32.83,0:14:35.54,Default,,0,0,0,,Не айтып тұрғаныңызды білмеймін, бірақ...
Dialogue: 0,0:14:35.62,0:14:38.75,Default,,0,0,0,,Жоқ, күте тұрыңыз, Трансильвания...
Dialogue: 0,0:14:38.83,0:14:39.87,Default,,0,0,0,,Румыния! ?
Dialogue: 0,0:14:40.37,0:14:41.50,Default,,0,0,0,,Румыния?
Dialogue: 0,0:14:41.71,0:14:43.38,Default,,0,0,0,,Егер сіз...
Dialogue: 0,0:14:43.46,0:14:45.13,Default,,0,0,0,,Вампир~!
Dialogue: 0,0:14:45.34,0:14:46.21,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:14:47.17,0:14:48.63,Default,,0,0,0,,Онда Ки… Киба…
Dialogue: 0,0:14:50.34,0:14:52.01,Default,,0,0,0,,(дыбысты дауыс)
Dialogue: 0,0:14:52.30,0:14:54.31,Default,,0,0,0,,Ашық қызыл сусын.
Dialogue: 0,0:14:54.60,0:14:55.76,Default,,0,0,0,,Жоқ... қан?
Dialogue: 0,0:14:57.02,0:14:59.27,Default,,0,0,0,,Томат шырыны, солай ма? Қараңыз
Dialogue: 0,0:14:59.81,0:15:01.27,Default,,0,0,0,,(сорғыш дыбыс)
Dialogue: 0,0:15:01.35,0:15:03.77,Default,,0,0,0,,Мені шошытпа~
Dialogue: 0,0:15:04.36,0:15:05.23,Default,,0,0,0,,Жоғалтпа!
Dialogue: 0,0:15:05.69,0:15:08.65,Default,,0,0,0,,Валахия герцогы Влад III шежіресі туралы.
Dialogue: 0,0:15:08.90,0:15:12.16,Default,,0,0,0,,Менің атым Клио Дорон екенін білуіңіз керек.
Dialogue: 0,0:15:12.87,0:15:15.16,Default,,0,0,0,,Қараңғылық пен хаостың баласы.
Dialogue: 0,0:15:15.24,0:15:18.29,Default,,0,0,0,,Қорқыныштың хабаршысы болып, қорқ!
Dialogue: 0,0:15:18.50,0:15:20.62,Default,,0,0,0,,Хаха қызық!
Dialogue: 0,0:15:20.79,0:15:23.04,Default,,0,0,0,,Вампирлер Париж жүздеріне қосыла ма?
Dialogue: 0,0:15:23.96,0:15:26.09,Default,,0,0,0,,Қосылу үшін сынақ бар деп естідім.
Dialogue: 0,0:15:26.34,0:15:29.51,Default,,0,0,0,,Менімен күш біріктіретін пышақ кім?
Dialogue: 0,0:15:30.09,0:15:30.97,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:15:31.22,0:15:32.43,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:32.84,0:15:34.01,Default,,0,0,0,,Silvepre
Dialogue: 0,0:15:34.14,0:15:35.43,Default,,0,0,0,,Ең күшті
Dialogue: 0,0:15:35.89,0:15:37.14,Default,,0,0,0,,Мен бе...
Dialogue: 0,0:15:37.26,0:15:39.27,Default,,0,0,0,,О, бұл капитан.
Dialogue: 0,0:15:39.43,0:15:40.89,Default,,0,0,0,,Дина қолайлы.
Dialogue: 0,0:15:46.11,0:15:48.48,Default,,0,0,0,,О~ Қара шығанақ...
Dialogue: 0,0:15:48.57,0:15:50.36,Default,,0,0,0,,Шынымен алдамшы
Dialogue: 0,0:15:50.90,0:15:52.45,Default,,0,0,0,,Өлтіруші Өлім Сізер
Dialogue: 0,0:15:52.86,0:15:54.62,Default,,0,0,0,,Сондай-ақ «Қасқыр» деп те аталады
Dialogue: 0,0:15:55.07,0:15:56.99,Default,,0,0,0,,Хехе, өлім құдайы...
Dialogue: 0,0:15:57.74,0:16:00.37,Default,,0,0,0,,Вампирдің досы болуға лайық
Dialogue: 0,0:16:00.96,0:16:01.62,Default,,0,0,0,,О, айдаһар арбасы
Dialogue: 0,0:16:02.21,0:16:03.12,Default,,0,0,0,,Келуге болмайды!
Dialogue: 0,0:16:03.21,0:16:06.09,Default,,0,0,0,,Терең қараңғылықтан кел, Хаос патшасы
Dialogue: 0,0:16:06.17,0:16:06.96,Default,,0,0,0,,(Overhaul) Енді All for One жоғалып кеткен соң, бұл біздің мүмкіндігіміз
Dialogue: 0,0:16:07.63,0:16:08.84,Default,,0,0,0,,Терең хаос!
Dialogue: 0,0:16:08.96,0:16:09.92,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:16:10.38,0:16:13.68,Default,,0,0,0,,Өлім Құдайы, оны жүрегіңе ойып ал.
Dialogue: 0,0:16:14.26,0:16:16.47,Default,,0,0,0,,Менің хаосымды жеңетін адам -
Dialogue: 0,0:16:16.76,0:16:19.22,Default,,0,0,0,,Сіз қанды қарғысқа ұшырайсыз.
Dialogue: 0,0:16:19.85,0:16:21.23,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:16:21.56,0:16:23.23,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:16:23.35,0:16:24.27,Default,,0,0,0,,Эден мектебінің сұхбатына барамын
Dialogue: 0,0:16:25.40,0:16:27.15,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:16:27.23,0:16:28.36,Default,,0,0,0,,Үш
Dialogue: 0,0:16:28.44,0:16:29.57,Default,,0,0,0,,Екі
Dialogue: 0,0:16:29.65,0:16:30.78,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:16:30.86,0:16:32.11,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:16:32.19,0:16:33.28,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:16:33.36,0:16:34.53,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:37.32,0:16:39.33,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:16:42.08,0:16:46.04,Default,,0,0,0,,Grim Reaper, менің Riftlayer-мен кесіп тастаңыз!
Dialogue: 0,0:16:46.25,0:16:49.55,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:16:49.80,0:16:51.51,Default,,0,0,0,,Өлім Сізердің қаны
Dialogue: 0,0:16:51.59,0:16:53.42,Default,,0,0,0,,Менің хаосым бәрін сорып жатыр!
Dialogue: 0,0:16:53.63,0:16:56.68,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:16:57.34,0:16:57.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:58.51,0:16:59.26,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:17:00.51,0:17:02.68,Default,,0,0,0,,Ой... айналдырумен
Dialogue: 0,0:17:02.77,0:17:03.93,Default,,0,0,0,,Терең хаос
Dialogue: 0,0:17:04.27,0:17:05.94,Default,,0,0,0,,(Таңқаларлық дауыс)
Dialogue: 0,0:17:07.40,0:17:09.27,Default,,0,0,0,,Жасайық, Терең хаос
Dialogue: 0,0:17:09.61,0:17:12.03,Default,,0,0,0,,Маған қосылуға рұқсат бересіз бе?
Dialogue: 0,0:17:12.44,0:17:14.28,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:17:14.90,0:17:15.90,Default,,0,0,0,,Қылмыскер...
Dialogue: 0,0:17:16.20,0:17:17.53,Default,,0,0,0,,Бірге күресейік
Dialogue: 0,0:17:21.87,0:17:25.25,Default,,0,0,0,,Міне, қараңғылық әскері құрылды!
Dialogue: 0,0:17:25.71,0:17:27.37,Default,,0,0,0,,Clio қолданбасын пайдаланыңыз
Dialogue: 0,0:17:27.71,0:17:28.88,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:17:30.59,0:17:32.25,Default,,0,0,0,,Екінші ойын –
Dialogue: 0,0:17:32.34,0:17:34.21,Default,,0,0,0,,Клио Дорон, Париж Блэдерс
Dialogue: 0,0:17:34.38,0:17:36.88,Default,,0,0,0,,Нью-Йорк Буллс командасынан, бұл Бобби Дилан.
Dialogue: 0,0:17:39.80,0:17:41.31,Default,,0,0,0,,Шайқас алдында бір нәрсе -
Dialogue: 0,0:17:41.60,0:17:43.93,Default,,0,0,0,,Мен сізге айтуым керек.
Dialogue: 0,0:17:44.02,0:17:45.02,Default,,0,0,0,,Не?
Dialogue: 0,0:17:45.35,0:17:48.77,Default,,0,0,0,,Менің Бейім Терең хаосты жеңген кезде...
Dialogue: 0,0:17:49.23,0:17:51.15,Default,,0,0,0,,Сіз терең қараңғыдасыз -
Dialogue: 0,0:17:51.23,0:17:53.65,Default,,0,0,0,,Шатасып қарғысқа ұшырайды
Dialogue: 0,0:17:53.73,0:17:56.15,Default,,0,0,0,,Жоқ! қарғыс? Қош бол
Dialogue: 0,0:17:56.40,0:17:59.91,Default,,0,0,0,,Ол қарғыс жаныңды қараңғылыққа апарады...
Dialogue: 0,0:18:00.45,0:18:03.04,Default,,0,0,0,,Мәңгілік азап әкеледі
Dialogue: 0,0:18:03.29,0:18:04.41,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:18:04.62,0:18:07.75,Default,,0,0,0,,Қара раушан төсегінде жатқан дірілдей...
Dialogue: 0,0:18:07.96,0:18:10.96,Default,,0,0,0,,Тәтті тікенектер сені құшақтайды
Dialogue: 0,0:18:11.13,0:18:13.50,Default,,0,0,0,,Сіз... қазір бастай аламыз ба?
Dialogue: 0,0:18:15.13,0:18:16.30,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:18:18.09,0:18:19.05,Default,,0,0,0,,Хаос
Dialogue: 0,0:18:19.51,0:18:21.47,Default,,0,0,0,,Қолымнан босатылған кезде...
Dialogue: 0,0:18:21.89,0:18:24.26,Default,,0,0,0,,Қараңғылық қанат кигенсің.
Dialogue: 0,0:18:24.72,0:18:26.48,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:18:26.56,0:18:30.15,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:30.48,0:18:33.19,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:33.27,0:18:34.36,Default,,0,0,0,,Тея!
Dialogue: 0,0:18:35.07,0:18:37.86,Default,,0,0,0,,Екінші ойын: Бірінші шайқас басталады
Dialogue: 0,0:18:37.95,0:18:40.99,Default,,0,0,0,,Қане, қараңғылық қанаттарын жай!
Dialogue: 0,0:18:44.58,0:18:45.33,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:18:46.08,0:18:46.83,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:18:47.70,0:18:49.62,Default,,0,0,0,,Үшінші шайқасқа кірді
Dialogue: 0,0:18:49.71,0:18:52.25,Default,,0,0,0,,Риксон Клэй Стэн Гамбургке қарсы!
Dialogue: 0,0:18:52.42,0:18:54.46,Default,,0,0,0,,Кім жеңеді? ?
Dialogue: 0,0:18:54.55,0:18:55.30,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:18:55.88,0:18:57.17,Default,,0,0,0,,Не?
Dialogue: 0,0:18:57.46,0:18:58.34,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:18:59.09,0:19:00.38,Default,,0,0,0,,Соя!
Dialogue: 0,0:19:00.80,0:19:03.64,Default,,0,0,0,,Екінші ойын Риксон Клэйдің 2-1 жеңісімен аяқталды!
Dialogue: 0,0:19:04.51,0:19:07.39,Default,,0,0,0,,Енді ойын саны 1:1~ тең
Dialogue: 0,0:19:07.93,0:19:09.27,Default,,0,0,0,,Соя!
Dialogue: 0,0:19:09.56,0:19:11.65,Default,,0,0,0,,Риксон Цю!
Dialogue: 0,0:19:11.73,0:19:14.69,Default,,0,0,0,,Бірақ Стэн де айтарлықтай деңгейге көтерілді.
Dialogue: 0,0:19:15.32,0:19:17.65,Default,,0,0,0,,Бұл өте жақсы шайқас болды.
Dialogue: 0,0:19:18.15,0:19:20.74,Default,,0,0,0,,Зороның кеңесі орындалды
Dialogue: 0,0:19:21.07,0:19:23.57,Default,,0,0,0,,Fah fah fah na~ni
Dialogue: 0,0:19:23.66,0:19:25.87,Default,,0,0,0,,Мен сізге аз ғана кеңес бердім.
Dialogue: 0,0:19:25.95,0:19:29.20,Default,,0,0,0,,Сол мақал-мәтелге ұқсап барын салу ғана қалды.
Dialogue: 0,0:19:30.08,0:19:31.62,Default,,0,0,0,,Сіз күштірек болдыңыз.
Dialogue: 0,0:19:31.79,0:19:32.88,Default,,0,0,0,,Тіпті сен де
Dialogue: 0,0:19:33.08,0:19:35.17,Default,,0,0,0,,Бірінші шайқаста жеңілген кезде-
Dialogue: 0,0:19:35.25,0:19:37.25,Default,,0,0,0,,Мен сені мықты деп ойладым.
Dialogue: 0,0:19:37.42,0:19:38.55,Default,,0,0,0,,Риос –
Dialogue: 0,0:19:39.01,0:19:40.88,Default,,0,0,0,,Шака мен Рувейге тоқталу
Dialogue: 0,0:19:40.97,0:19:42.80,Default,,0,0,0,,Қалың өру қабаты
Dialogue: 0,0:19:43.26,0:19:45.18,Default,,0,0,0,,Мен оларды қуып жеткім келеді...
Dialogue: 0,0:19:45.35,0:19:47.64,Default,,0,0,0,,Мен де осы деңгейге дейін жеттім.
Dialogue: 0,0:19:48.35,0:19:50.56,Default,,0,0,0,,Бірақ бұл әлі алыс еді.
Dialogue: 0,0:19:50.93,0:19:53.52,Default,,0,0,0,,Психокинез тау жыныстары арқылы өте алады
Dialogue: 0,0:19:54.23,0:19:56.82,Default,,0,0,0,,Мен де осы жеңістен бастадым.
Dialogue: 0,0:20:02.24,0:20:04.74,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:20:04.91,0:20:06.07,Default,,0,0,0,,Ка~
Dialogue: 0,0:20:06.66,0:20:08.08,Default,,0,0,0,,Қараңғылық пен шатасудан шық
Dialogue: 0,0:20:08.16,0:20:09.83,Default,,0,0,0,,Терең хаос!
Dialogue: 0,0:20:12.58,0:20:13.33,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:20:18.96,0:20:21.84,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:20:25.64,0:20:27.60,Default,,0,0,0,,Нью-Йорк бұқаларының қаны -
Dialogue: 0,0:20:27.68,0:20:29.85,Default,,0,0,0,,Менің терең хаосым оны сіңіреді!
Dialogue: 0,0:20:30.02,0:20:30.85,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:20:33.35,0:20:35.56,Default,,0,0,0,,Терең хаос айналу финиш
Dialogue: 0,0:20:35.69,0:20:37.90,Default,,0,0,0,,Клио Дорон жеңеді
Dialogue: 0,0:20:38.32,0:20:41.11,Default,,0,0,0,,«Париж Блэйдс» екінші ойында жеңіске жетті
Dialogue: 0,0:20:41.49,0:20:43.03,Default,,0,0,0,,Жеңіс құдайы.
Dialogue: 0,0:20:43.57,0:20:45.70,Default,,0,0,0,,Біз алғысымызды білдіреміз.
Dialogue: 0,0:20:48.53,0:20:51.33,Default,,0,0,0,,Мен сіздің шығыныңызды өтеймін.
Dialogue: 0,0:20:51.87,0:20:52.75,Default,,0,0,0,,Ruway…
Dialogue: 0,0:20:53.29,0:20:55.46,Default,,0,0,0,,Мен жасаған ағынды қайтарыңыз.
Dialogue: 0,0:20:55.96,0:20:57.54,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:20:58.00,0:21:00.25,Default,,0,0,0,,Мұны біреу білетіндіктен айтып отырмын.
Dialogue: 0,0:21:01.00,0:21:01.51,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:21:02.51,0:21:04.80,Default,,0,0,0,,Енді сіздің кезегіңіз.
Dialogue: 0,0:21:04.88,0:21:06.01,Default,,0,0,0,,Деванда!
Dialogue: 0,0:21:06.43,0:21:08.85,Default,,0,0,0,,Таномус Куза! Жеңіске жетейік
Dialogue: 0,0:21:08.97,0:21:10.85,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:21:11.06,0:21:14.10,Default,,0,0,0,,Балт Келесі 4-ойын міндетті түрде...
Dialogue: 0,0:21:14.18,0:21:15.14,Default,,0,0,0,,Шака келе жатыр
Dialogue: 0,0:21:15.31,0:21:16.77,Default,,0,0,0,,Соңында шешіңіз!
Dialogue: 0,0:21:17.48,0:21:18.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:18.86,0:21:19.36,Default,,0,0,0,,Ni!
Dialogue: 0,0:21:20.27,0:21:21.86,Default,,0,0,0,,Үшінші ойын
Dialogue: 0,0:21:22.23,0:21:24.53,Default,,0,0,0,,Бразилия Риосы - Сонг Лувей!
Dialogue: 0,0:21:24.61,0:21:27.61,Default,,0,0,0,,Ал BC Сол - Куза Акерман!
Dialogue: 0,0:21:27.95,0:21:28.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:31.91,0:21:32.58,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:33.91,0:21:34.66,Default,,0,0,0,,(толқынды дыбыс)
Dialogue: 0,0:21:35.29,0:21:36.16,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:21:36.71,0:21:37.96,Default,,0,0,0,,Ойра қашықтығы-
Dialogue: 0,0:21:38.08,0:21:39.67,Default,,0,0,0,,Мен сенен құтылуға жол бермеймін.
Dialogue: 0,0:21:40.34,0:21:42.71,Default,,0,0,0,,Келіңіздер! Ойын саны 1-ден 1-ге дейін
Dialogue: 0,0:21:42.80,0:21:45.67,Default,,0,0,0,,Сонг Лувей және Куза Акерман!
Dialogue: 0,0:21:45.76,0:21:49.43,Default,,0,0,0,,Үшінші ойында кім жеңеді? ?
Dialogue: 0,0:21:49.51,0:21:50.43,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:21:56.02,0:21:57.81,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:21:58.23,0:22:00.06,Default,,0,0,0,,Негіздерге дайынсыз ба?
Dialogue: 0,0:22:00.15,0:22:02.90,Default,,0,0,0,,Енді күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:02.98,0:22:04.86,Default,,0,0,0,,Қозғалыс 1 нұсқаға қарағанда жылдамырақ.
Dialogue: 0,0:22:04.94,0:22:07.03,Default,,0,0,0,,Алдымен, Showtime бағдарламасының алдыңғы бөліміне шолу жасаңыз
Dialogue: 0,0:22:07.11,0:22:10.66,Default,,0,0,0,,Бар! Шүкір! үлкен
Dialogue: 0,0:22:10.74,0:22:13.49,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:13.58,0:22:14.41,Default,,0,0,0,,Жылдамдату
Dialogue: 0,0:22:14.49,0:22:16.25,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:16.33,0:22:18.08,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:18.17,0:22:19.92,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:20.00,0:22:21.50,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:21.59,0:22:23.21,Default,,0,0,0,,Хахаха, бұл жақсы емес пе?
Dialogue: 0,0:22:23.30,0:22:24.88,Default,,0,0,0,,Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.96,0:22:26.72,Default,,0,0,0,,Бұл жерден одан да нашар болады.
Dialogue: 0,0:22:26.80,0:22:28.88,Default,,0,0,0,,Шиеленісті көтерейік!
Dialogue: 0,0:22:28.97,0:22:30.93,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:31.01,0:22:32.89,Default,,0,0,0,,Мори Мори Моримори
Dialogue: 0,0:22:32.97,0:22:34.72,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:34.81,0:22:36.56,Default,,0,0,0,,Менің атқаным – құдайдың атысы
Dialogue: 0,0:22:36.64,0:22:40.19,Default,,0,0,0,,Оң аяқ киім Сол аяқ киім Оң жақтағы аяқ киім
Dialogue: 0,0:22:40.27,0:22:43.86,Default,,0,0,0,,Сол аяқ киім Оң аяқ киім Сол жақтағы аяқ киім
Dialogue: 0,0:22:43.94,0:22:45.78,Default,,0,0,0,,Өткен апта Осы аптада
Dialogue: 0,0:22:45.86,0:22:47.65,Default,,0,0,0,,Біз түсірілім жасап жатырмыз.
Dialogue: 0,0:22:47.74,0:22:49.45,Default,,0,0,0,,Осы апта Келесі аптада
Dialogue: 0,0:22:49.53,0:22:51.49,Default,,0,0,0,,Ол сонымен бірге Go Shoot ойнайды
Dialogue: 0,0:22:51.57,0:22:53.16,Default,,0,0,0,,Күнделікті жаттығу
Dialogue: 0,0:22:53.24,0:22:55.08,Default,,0,0,0,,Барып, бәрі істеп жатқан түсіру
Dialogue: 0,0:22:55.16,0:22:56.87,Default,,0,0,0,,Көктем/жаз күз/қыс
Dialogue: 0,0:22:56.95,0:22:58.54,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:22:58.62,0:23:00.04,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:23:00.12,0:23:02.75,Default,,0,0,0,,Негізгі бұлшықеттерді дамыту үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.83,0:23:05.96,Default,,0,0,0,,Осы шиеленіспен біз шарықтау шегіне жетеміз.
Dialogue: 0,0:23:06.05,0:23:09.01,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:09.09,0:23:09.76,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:23:09.84,0:23:12.47,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:12.55,0:23:13.26,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:23:13.35,0:23:17.14,Default,,0,0,0,,1 2 3 4 Бар! кеттік
Dialogue: 0,0:23:17.22,0:23:17.81,Default,,0,0,0,,Үш
Dialogue: 0,0:23:18.06,0:23:18.68,Default,,0,0,0,,Екі
Dialogue: 0,0:23:18.89,0:23:20.69,Default,,0,0,0,,One Go аяқ киім!
Dialogue: 0,0:23:20.77,0:23:22.02,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.10,0:23:25.19,Default,,0,0,0,,Керемет түсіріңіз! Керемет негіз!
Dialogue: 0,0:23:27.07,0:23:29.57,Default,,0,0,0,,Финалға қай команда шығады?
Dialogue: 0,0:23:30.28,0:23:33.45,Default,,0,0,0,,Біздің сезімдеріміз бетпе-бет соқтығысады
Dialogue: 0,0:23:34.12,0:23:36.54,Default,,0,0,0,,Жеңіске деген құштарлығыммен ешкімге жеңіле алмаймын
Dialogue: 0,0:23:36.95,0:23:40.04,Default,,0,0,0,,Валькири одан да дамиды!
Dialogue: 0,0:23:40.75,0:23:42.79,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.25,0:23:45.42,Default,,0,0,0,,Үзіліс! Үлкен 5 қабырға! !
Dialogue: 0,0:23:46.09,0:23:49.67,Default,,0,0,0,,Үш екі бір ату!
