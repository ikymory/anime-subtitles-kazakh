Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.68,0:00:07.68,Default,,0,0,0,,Өзіңіз қалаған адам бола алатын орын
Dialogue: 0,0:00:07.68,0:00:09.98,Default,,0,0,0,,『Икатсу планетасы! ” басталады
Dialogue: 0,0:00:17.18,0:00:19.48,Default,,0,0,0,,Бұл сүйкімді
Dialogue: 0,0:00:22.73,0:00:24.73,Default,,0,0,0,,Бұл да тым сүйкімді
Dialogue: 0,0:00:27.17,0:00:30.35,Default,,0,0,0,,Майзакураға барайық. Шиори
Dialogue: 0,0:00:30.35,0:00:32.32,Default,,0,0,0,,Сіз әлі де алаңдайсыз ба?
Dialogue: 0,0:00:32.32,0:00:34.32,Default,,0,0,0,,Қайсысы жақсы екенін білмеймін.
Dialogue: 0,0:00:36.34,0:00:38.35,Default,,0,0,0,,Соңында мен оны сатып ала алмадым
Dialogue: 0,0:00:38.35,0:00:41.33,Default,,0,0,0,,Екеуі де сүйкімді болды. Иә.
Dialogue: 0,0:00:41.33,0:00:54.33,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:00:54.33,0:00:58.83,Default,,0,0,0,,«Келіңіздер! Сахнаға шығайық».
Dialogue: 0,0:00:58.83,0:01:03.86,Default,,0,0,0,,«Жеткізу жарқыраған әуен, ырғаққа жет!»
Dialogue: 0,0:01:03.86,0:01:06.66,Default,,0,0,0,,«Идол әрекеттері»
Dialogue: 0,0:01:06.66,0:01:08.68,Default,,0,0,0,,«Күлкі ханым»
Dialogue: 0,0:01:08.68,0:01:14.08,Default,,0,0,0,,«Білесің бе, үміт қандай болса да дос».
Dialogue: 0,0:01:14.08,0:01:19.34,Default,,0,0,0,,«Мықты ұстаңыз және бақытты болыңыз! Иә!»
Dialogue: 0,0:01:19.34,0:01:22.54,Default,,0,0,0,,Уау, сондай сүйкімді
Dialogue: 0,0:01:25.78,0:01:29.05,Default,,0,0,0,,Міне…. Кальмар планетасының Хана
Dialogue: 0,0:01:29.05,0:01:34.75,Default,,0,0,0,,Бұл Хана, ең жақсы кумир, солай ма? Иә
Dialogue: 0,0:01:36.85,0:01:41.23,Default,,0,0,0,,Енді мына сұрақ: Хананы кім жасап жатыр?
Dialogue: 0,0:01:41.23,0:01:45.31,Default,,0,0,0,,Мм...｡ Жауап – Йомейсаки
Dialogue: 0,0:01:45.31,0:01:47.22,Default,,0,0,0,,Акисаки де танымал.
Dialogue: 0,0:01:47.22,0:01:49.37,Default,,0,0,0,,Ол тіпті журналда көрсетілді.
Dialogue: 0,0:01:49.37,0:01:53.57,Default,,0,0,0,,~ Бұл таңқаларлық, солай емес пе?
Dialogue: 0,0:01:58.54,0:02:01.20,Default,,0,0,0,,А, енді барайық.
Dialogue: 0,0:02:01.20,0:02:03.20,Default,,0,0,0,,барлығын бірге орналастырыңыз.
Dialogue: 0,0:02:06.70,0:02:08.70,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:02:20.26,0:02:22.26,Default,,0,0,0,,Бұл…
Dialogue: 0,0:02:29.36,0:02:31.36,Default,,0,0,0,,ｻﾝｷｭ
Dialogue: 0,0:02:43.05,0:02:46.05,Default,,0,0,0,,<Мен оны әлі түсінбедім>
Dialogue: 0,0:02:51.85,0:02:56.03,Default,,0,0,0,,< Қазірдің өзінде
Dialogue: 0,0:02:56.03,0:03:00.42,Default,,0,0,0,,Менің тағдырым үнсіз
Dialogue: 0,0:03:00.42,0:03:04.82,Default,,0,0,0,,Ол күшті қозғала бастады＞
Dialogue: 0,0:04:23.69,0:04:25.67,Default,,0,0,0,,(ﾁｬｲﾑ)
Dialogue: 0,0:04:25.67,0:04:28.53,Default,,0,0,0,,Ей, бүгін де барып көрейік.
Dialogue: 0,0:04:28.53,0:04:31.70,Default,,0,0,0,,Енді сұрақ бүгін қай күн?
Dialogue: 0,0:04:31.70,0:04:33.86,Default,,0,0,0,,Аа, Майзакура сонда болды. Асығыңыз, асығыңыз.
Dialogue: 0,0:04:33.86,0:04:36.35,Default,,0,0,0,,Май Сакура-чан! Майзакура-чан өтінемін
Dialogue: 0,0:04:36.35,0:04:39.35,Default,,0,0,0,,Маған биді айт. Би?
Dialogue: 0,0:04:39.35,0:04:42.36,Default,,0,0,0,,Мектептегі мерекелік биде мен жақсы билей алмаймын.
Dialogue: 0,0:04:42.36,0:04:44.36,Default,,0,0,0,,Майо Сіз балетпен айналыстыңыз, солай ма?
Dialogue: 0,0:04:44.36,0:04:47.53,Default,,0,0,0,,Мен әрқашан спортшы болдым және кез келген нәрсені билей аламын.
Dialogue: 0,0:04:47.53,0:04:49.51,Default,,0,0,0,,Жоқ, бірақ мен оны ешқашан ешкімге үйреткен емеспін.
Dialogue: 0,0:04:49.51,0:04:53.52,Default,,0,0,0,,Дұрыс, Майоны ұятқа қалдырмаңыз.
Dialogue: 0,0:04:53.52,0:04:55.54,Default,,0,0,0,,Бірақ, әйтеуір, мен оны Фужинума мырзаға айтпаймын, білесің бе.
Dialogue: 0,0:04:55.54,0:04:57.57,Default,,0,0,0,,Мәліметтерге алаңдамаңыз
Dialogue: 0,0:04:57.57,0:04:59.62,Default,,0,0,0,,Оқытуда жақсы болмасаң, жарайды!
Dialogue: 0,0:04:59.62,0:05:04.21,Default,,0,0,0,,Құдай, Будда, Майсакура Отова, өтінемін, өтінемін.
Dialogue: 0,0:05:04.21,0:05:06.51,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:05:09.23,0:05:12.52,Default,,0,0,0,,Егер сіз оны ешқашан қолданып көрмеген болсаңыз, қолданып көру керек пе?
Dialogue: 0,0:05:12.52,0:05:14.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:14.52,0:05:17.53,Default,,0,0,0,,Жарайды, жасап көрейік!
Dialogue: 0,0:05:17.53,0:05:21.18,Default,,0,0,0,,Жарайсыңдар! Жақсы~
Dialogue: 0,0:05:21.18,0:05:23.20,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:23.20,0:05:26.85,Default,,0,0,0,,ｽﾘｰ ﾌｫｰ ﾌｧｲﾌﾞ ｼｯｸｽ ｾﾌﾞﾝ ｴｲﾄ
Dialogue: 0,0:05:26.85,0:05:31.52,Default,,0,0,0,,ﾄｩｰ ﾄｩｰ ｽﾘｰ ﾌｫｰ ﾌｧｲﾌﾞ ｼｯｸｽ ｾﾌﾞﾝ ｴｲﾄ
Dialogue: 0,0:05:31.52,0:05:36.18,Default,,0,0,0,,Ғажайып, балет және хип-хоп мүлдем басқа.
Dialogue: 0,0:05:36.18,0:05:38.35,Default,,0,0,0,,Майзакура күткендей!
Dialogue: 0,0:05:38.35,0:05:43.22,Default,,0,0,0,,ｽﾘｰ ﾌｫｰ ﾌｧｲﾌﾞ ｼｯｸｽ ｾﾌﾞﾝ ｴｲﾄ
Dialogue: 0,0:05:43.22,0:05:45.24,Default,,0,0,0,,Майзакура жақсы.
Dialogue: 0,0:05:45.24,0:05:48.32,Default,,0,0,0,,Неге... неге сонша жақсы?
Dialogue: 0,0:05:48.32,0:05:51.01,Default,,0,0,0,,Ырғақ жаман емес, келесіде үлкен қимылдар жасап көрейік.
Dialogue: 0,0:05:51.01,0:05:54.68,Default,,0,0,0,,Жарайды, мен тағы бір рет барамын.
Dialogue: 0,0:05:54.68,0:05:59.35,Default,,0,0,0,,Бір, екі, үш, төрт, бес алты...
Dialogue: 0,0:05:59.35,0:06:02.52,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Изуми-чан!
Dialogue: 0,0:06:02.52,0:06:06.41,Default,,0,0,0,,Сәлем, менеджер Изуми Ватануки
Dialogue: 0,0:06:06.41,0:06:08.91,Default,,0,0,0,,Аа, кешіріңіз, еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:08.91,0:06:11.70,Default,,0,0,0,,Рури Бұл сән оқиғасының келесі материалы
Dialogue: 0,0:06:11.70,0:06:15.18,Default,,0,0,0,,Уау~ Рахмет Ах, дұрыс.
Dialogue: 0,0:06:15.18,0:06:17.20,Default,,0,0,0,,Қай көйлек жақсы?
Dialogue: 0,0:06:17.20,0:06:21.87,Default,,0,0,0,,Қазіргі уақытта үміткерлер мынау және мынау.
Dialogue: 0,0:06:21.87,0:06:23.86,Default,,0,0,0,,Рубин жақсы емес пе?
Dialogue: 0,0:06:23.86,0:06:26.86,Default,,0,0,0,,Иә, иә, бәрі жақсы.
Dialogue: 0,0:06:31.35,0:06:33.35,Default,,0,0,0,,Бұл балаға не болды?
Dialogue: 0,0:06:33.35,0:06:36.69,Default,,0,0,0,,Бұл ескі Акисакиге ұқсайды.
Dialogue: 0,0:06:36.69,0:06:39.71,Default,,0,0,0,,Акисаки-чан? Акисаки Хананы істеп жатыр
Dialogue: 0,0:06:39.71,0:06:44.35,Default,,0,0,0,,Хмм? Мен бір сахнада қайта-қайта тұрамын
Dialogue: 0,0:06:44.35,0:06:46.86,Default,,0,0,0,,Осылай болды ма?
Dialogue: 0,0:06:46.86,0:06:51.52,Default,,0,0,0,,Сол баланы қоршап тұрған аура, серпімді, бірақ күшті жағы.
Dialogue: 0,0:06:51.52,0:06:55.54,Default,,0,0,0,,Біз де сол нәрсені сезінеміз. Ха~
Dialogue: 0,0:07:00.21,0:07:03.10,Default,,0,0,0,,Сәлеметсіз бе. (Сегава) Ябайссу
Dialogue: 0,0:07:03.10,0:07:08.04,Default,,0,0,0,,Не? Бұл оқиға!
Dialogue: 0,0:07:08.04,0:07:11.02,Default,,0,0,0,,Изуми мырза! Сегава: Не болды?
Dialogue: 0,0:07:11.02,0:07:14.02,Default,,0,0,0,,Бұл маған Акесаки-чан жоғалып кеткеннен кейін жіберілді.
Dialogue: 0,0:07:23.18,0:07:25.20,Default,,0,0,0,,ｳｿ…
Dialogue: 0,0:07:25.20,0:07:28.71,Default,,0,0,0,,Бұл менің кумир болудан бас тартатынымды білдіре ме?
Dialogue: 0,0:07:28.71,0:07:32.16,Default,,0,0,0,,Неге кенеттен... Изуми мырза, бірдеңе естідіңіз бе?
Dialogue: 0,0:07:32.16,0:07:34.96,Default,,0,0,0,,Кестеде не болып жатыр? Ах...
Dialogue: 0,0:07:37.00,0:07:41.52,Default,,0,0,0,,Журналдарға түсіру және сұхбат алу және тұрақты бағдарламаларды тарату
Dialogue: 0,0:07:41.52,0:07:45.52,Default,,0,0,0,,Менің бас тартудан басқа амалым жоқ
Dialogue: 0,0:07:45.52,0:07:50.86,Default,,0,0,0,,Кубидпен шайқас кезеңі туралы не деуге болады? Билеттер сатылып кетті
Dialogue: 0,0:07:50.86,0:07:53.53,Default,,0,0,0,,Барлық жанкүйерлер де оны асыға күтеді.
Dialogue: 0,0:07:53.53,0:07:59.19,Default,,0,0,0,,Ха~! Біреу маған мұны істей ала ма?
Dialogue: 0,0:07:59.19,0:08:02.21,Default,,0,0,0,,Рури-чан ше?
Dialogue: 0,0:08:02.21,0:08:04.56,Default,,0,0,0,,Рури - басқа тип.
Dialogue: 0,0:08:04.56,0:08:07.56,Default,,0,0,0,,Хананы Акесакидің орнына кім жасай алады...
Dialogue: 0,0:08:14.20,0:08:17.02,Default,,0,0,0,,Шынымды айтсам, Майзакура-сама - Будда.
Dialogue: 0,0:08:17.02,0:08:20.04,Default,,0,0,0,,Олай емес, бәрі жақсарды.
Dialogue: 0,0:08:20.04,0:08:23.19,Default,,0,0,0,,Майзакура билегенде бәрінен де көңілді болатын сияқты.
Dialogue: 0,0:08:23.19,0:08:25.53,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:08:25.53,0:08:27.53,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:30.60,0:08:33.40,Default,,0,0,0,,Сізбен бір сәт сөйлесе аламын ба?
Dialogue: 0,0:08:36.52,0:08:38.53,Default,,0,0,0,,Эх!
Dialogue: 0,0:08:38.53,0:08:40.54,Default,,0,0,0,,Майзакура Ханаға?
Dialogue: 0,0:08:40.54,0:08:43.74,Default,,0,0,0,,Мен ең жақсы кумир боламын ба? Қараңыз!
Dialogue: 0,0:08:49.57,0:08:53.84,Default,,0,0,0,,Акесаки осы демалыс күндері кенеттен шайқас сахнасына шыға алмайды.
Dialogue: 0,0:08:53.84,0:08:57.21,Default,,0,0,0,,Мен Майо-саннан мені ауыстыруын өтінгім келеді.
Dialogue: 0,0:08:57.21,0:09:00.30,Default,,0,0,0,,«Кәне, сахнаға шығайық».
Dialogue: 0,0:09:00.30,0:09:03.18,Default,,0,0,0,,«Жарқыраған әуенді жеткізу»
Dialogue: 0,0:09:03.18,0:09:06.19,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:09:06.19,0:09:12.09,Default,,0,0,0,,Себебі... Мен Акисаки екеуіңе бірдей сезімде болдым.
Dialogue: 0,0:09:12.09,0:09:14.09,Default,,0,0,0,,Дәл солай ма?
Dialogue: 0,0:09:16.20,0:09:18.35,Default,,0,0,0,,Мен Акисаки биін бірінші рет көрдім
Dialogue: 0,0:09:18.35,0:09:22.84,Default,,0,0,0,,Тыныс алуды ұмытып, соған қарадым.
Dialogue: 0,0:09:22.84,0:09:27.24,Default,,0,0,0,,Уақыт тоқтағандай, Мен ол жерден қозғала алмаймын.
Dialogue: 0,0:09:29.18,0:09:34.33,Default,,0,0,0,,Бүгін Майо-санның биін көргенде мен де сондай сезімде болдым.
Dialogue: 0,0:09:34.33,0:09:37.33,Default,,0,0,0,,Сонымен...｡ Жоқ, бірақ...
Dialogue: 0,0:09:37.33,0:09:39.83,Default,,0,0,0,,Тіпті сізге кенеттен...
Dialogue: 0,0:09:43.22,0:09:47.34,Default,,0,0,0,,Кумир болу дұрыс па? иә?
Dialogue: 0,0:09:47.34,0:09:52.18,Default,,0,0,0,,Олар ынталы, үнемі еңбектенеді.
Dialogue: 0,0:09:52.18,0:09:54.52,Default,,0,0,0,,Мен өзімнің ыстық сезімімді жеткізуге тырысамын
Dialogue: 0,0:09:54.52,0:09:57.07,Default,,0,0,0,,Олардың бірбеткейлігіне қарап.
Dialogue: 0,0:09:57.07,0:09:59.99,Default,,0,0,0,,Мен де көп тырысуым керек деп ойлаймын.
Dialogue: 0,0:09:59.99,0:10:06.16,Default,,0,0,0,,Пұттар адамдарға позитивті және батылдық бере алады.
Dialogue: 0,0:10:06.16,0:10:09.17,Default,,0,0,0,,Сізге пұттарды ұнатасыз, солай ма?
Dialogue: 0,0:10:09.17,0:10:11.47,Default,,0,0,0,,Иә, өте
Dialogue: 0,0:10:13.85,0:10:17.83,Default,,0,0,0,,Бірақ мен мұны істей аламын ба?
Dialogue: 0,0:10:17.83,0:10:22.26,Default,,0,0,0,,Сіз мұны істей аласыз. Мен Майо-санның қолынан келетініне сенімдімін.
Dialogue: 0,0:10:22.26,0:10:24.85,Default,,0,0,0,,Мен адамдарға деген көзқарасыма сенімдімін.
Dialogue: 0,0:10:24.85,0:10:31.35,Default,,0,0,0,,Өтінемін, дәл осы демалыс күндері.
Dialogue: 0,0:10:42.37,0:10:44.33,Default,,0,0,0,,Жарайды, мен жасап көремін!
Dialogue: 0,0:10:44.33,0:10:46.84,Default,,0,0,0,,Май Сакура шынымен бе?
Dialogue: 0,0:10:46.84,0:10:51.84,Default,,0,0,0,,Иә, үздік идол болу тәжірибесі оңай қол жеткізе алмайтын нәрсе емес.
Dialogue: 0,0:10:51.84,0:10:56.35,Default,,0,0,0,,Мен жасап көремін. Иә, мен де сені қолдаймын.
Dialogue: 0,0:10:56.35,0:10:59.17,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:10:59.17,0:11:01.84,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:01.84,0:11:05.69,Default,,0,0,0,,Олай болса, кәдімгі балық ойынын бастайық. Балық балық?
Dialogue: 0,0:11:05.69,0:11:09.76,Default,,0,0,0,,Айкату планетасында пұт болу деген осы.
Dialogue: 0,0:11:09.76,0:11:12.01,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:11:12.01,0:11:14.01,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:16.00,0:11:19.94,Default,,0,0,0,,ｱｲｶﾂ ｱｲｶﾂ…
Dialogue: 0,0:11:19.94,0:11:28.83,Default,,0,0,0,,～
Dialogue: 0,0:11:28.83,0:11:32.68,Default,,0,0,0,,ｱｲｶﾂ ｱｲｶﾂ…
Dialogue: 0,0:11:32.68,0:11:56.69,Default,,0,0,0,,～
Dialogue: 0,0:11:56.69,0:12:00.29,Default,,0,0,0,,Майо Бұл жақсы уақыт болды. О?
Dialogue: 0,0:12:05.40,0:12:07.72,Default,,0,0,0,,Ақырында ертең ме?
Dialogue: 0,0:12:07.72,0:12:11.32,Default,,0,0,0,,Хехе, асыға күтемін~
Dialogue: 0,0:13:55.66,0:13:58.66,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:58.66,0:14:02.17,Default,,0,0,0,,Уау, жақсы
Dialogue: 0,0:14:02.17,0:14:04.17,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:14:04.17,0:14:07.00,Default,,0,0,0,,Сіздерді таныстыруға рұқсат етіңіздер. Бұл менің көмекшім...
Dialogue: 0,0:14:07.00,0:14:09.01,Default,,0,0,0,,Танысқаныма қуаныштымын, Сегава
Dialogue: 0,0:14:09.01,0:14:11.88,Default,,0,0,0,,Бұл Май Сакура Отова. Бұл Шиори Мотоя.
Dialogue: 0,0:14:11.88,0:14:14.41,Default,,0,0,0,,Олай болса, бірден Хана болайық.
Dialogue: 0,0:14:14.41,0:14:16.81,Default,,0,0,0,,Айкату планетасына барайық. Иә!
Dialogue: 0,0:14:18.67,0:14:20.67,Default,,0,0,0,,Бірақ қалай…
Dialogue: 0,0:14:22.84,0:14:25.36,Default,,0,0,0,,Иә
Dialogue: 0,0:14:25.36,0:14:29.23,Default,,0,0,0,,Hana's idol лицензиясын және осы смартфонды қалай пайдалануға болады
Dialogue: 0,0:14:29.23,0:14:31.23,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:33.35,0:14:36.85,Default,,0,0,0,,Мұнда idol лицензиясын орнатып көріңіз. Иә.
Dialogue: 0,0:14:42.02,0:14:44.49,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:44.49,0:14:47.49,Default,,0,0,0,,iPhone телефонын алдыңызда ұстаңыз
Dialogue: 0,0:15:00.34,0:15:03.51,Default,,0,0,0,,Ой... Бұл не? Керемет
Dialogue: 0,0:15:03.51,0:15:05.70,Default,,0,0,0,,Қолды біріктіру
Dialogue: 0,0:15:05.70,0:15:27.18,Default,,0,0,0,,～
Dialogue: 0,0:15:27.18,0:15:29.19,Default,,0,0,0,,Ах
Dialogue: 0,0:15:29.19,0:15:48.79,Default,,0,0,0,,～
Dialogue: 0,0:15:53.66,0:15:56.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:56.66,0:16:00.05,Default,,0,0,0,,Бұл балдыркөк планетасы, өте сүйкімді
Dialogue: 0,0:16:00.05,0:16:04.67,Default,,0,0,0,,А, мен шынымен мүйізденіп бара жатырмын ба?
Dialogue: 0,0:16:04.67,0:16:08.27,Default,,0,0,0,,Таңғажайып, түс сияқты, хехе
Dialogue: 0,0:16:13.73,0:16:16.73,Default,,0,0,0,,Сұрақ: Біз кімбіз?
Dialogue: 0,0:16:18.67,0:16:21.86,Default,,0,0,0,,Изуми мен Шиори. Пинг-понг!
Dialogue: 0,0:16:21.86,0:16:27.51,Default,,0,0,0,,Енді біз сахнаға соңғы дайындықты жасауымыз керек. Иә.
Dialogue: 0,0:16:27.51,0:16:30.18,Default,,0,0,0,,Бұл менің бүгін киетін көйлек.
Dialogue: 0,0:16:30.18,0:16:32.83,Default,,0,0,0,,Уау. Бірақ...
Dialogue: 0,0:16:32.83,0:16:35.84,Default,,0,0,0,,Ол көйлек әлі толық емес.
Dialogue: 0,0:16:35.84,0:16:38.22,Default,,0,0,0,,Артқы жағына қараңыз
Dialogue: 0,0:16:38.22,0:16:41.84,Default,,0,0,0,,Ол жерде Дорешияның күшін енгізу арқылы аяқталады.
Dialogue: 0,0:16:41.84,0:16:46.01,Default,,0,0,0,,Дорешия? Дорешиа сахнада жеңіс пен жеңілістің кілтін ұстайды.
Dialogue: 0,0:16:46.01,0:16:48.52,Default,,0,0,0,,Маңызды бар болу
Dialogue: 0,0:16:48.52,0:16:52.85,Default,,0,0,0,,Мен осылай деп ойлап, Дрессианың көмегін алып, көйлекті аяқтадым.
Dialogue: 0,0:16:52.85,0:16:56.67,Default,,0,0,0,,десең де, шкаф деген не?
Dialogue: 0,0:16:56.67,0:16:59.03,Default,,0,0,0,,Қуатты қалай алуға болады?
Dialogue: 0,0:16:59.03,0:17:02.36,Default,,0,0,0,,Осындай кездерде менде сүйенетін бетбелгі болса...
Dialogue: 0,0:17:02.36,0:17:05.43,Default,,0,0,0,,Бұдан былай тек пұттар ғана кіре алады.
Dialogue: 0,0:17:05.43,0:17:07.67,Default,,0,0,0,,Эх!
Dialogue: 0,0:17:07.67,0:17:11.67,Default,,0,0,0,,Сәлем Дорешия
Dialogue: 0,0:17:14.32,0:17:16.34,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:16.34,0:17:21.83,Default,,0,0,0,,О, бұл Дорешия ма? Ертегідей сүйкімді
Dialogue: 0,0:17:21.83,0:17:24.28,Default,,0,0,0,,О!
Dialogue: 0,0:17:24.28,0:17:27.28,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:29.36,0:17:33.03,Default,,0,0,0,,Уау, бұл шкаф та сүйкімді екен
Dialogue: 0,0:17:33.03,0:17:36.81,Default,,0,0,0,,Бірақ көйлектің бейнесі басқаша.
Dialogue: 0,0:17:36.81,0:17:40.31,Default,,0,0,0,,Мен оны таппай тұрған сияқтымын.
Dialogue: 0,0:18:00.67,0:18:02.67,Default,,0,0,0,,Сәлем
Dialogue: 0,0:18:02.67,0:18:05.66,Default,,0,0,0,,Сіз ше? Мен Сакура Отова
Dialogue: 0,0:18:05.66,0:18:10.35,Default,,0,0,0,,Хана емес Иә, бұл Хана.
Dialogue: 0,0:18:10.35,0:18:12.68,Default,,0,0,0,,Хана Танысқаныма қуаныштымын
Dialogue: 0,0:18:12.68,0:18:15.52,Default,,0,0,0,,Маған күшіңізді бере аласыз ба?
Dialogue: 0,0:18:15.52,0:18:18.02,Default,,0,0,0,,Мен сенің көйлегіңді кигім келеді.
Dialogue: 0,0:18:25.51,0:18:29.33,Default,,0,0,0,,Қандай кездейсоқтық, мен де солай ойладым.
Dialogue: 0,0:18:29.33,0:18:33.23,Default,,0,0,0,,Мен сенің көйлегің болғым келеді. Жақсы!
Dialogue: 0,0:18:40.68,0:18:45.35,Default,,0,0,0,,Уау... иә
Dialogue: 0,0:18:45.35,0:18:49.59,Default,,0,0,0,,Енді ұрыс кезеңі басталғалы тұр.
Dialogue: 0,0:18:49.59,0:18:52.67,Default,,0,0,0,,Бүгін қызу шайқас болады.
Dialogue: 0,0:18:52.67,0:18:56.53,Default,,0,0,0,,Хана Айкату рейтингінде 1-ші орында, ал Купит 2-ші орында!
Dialogue: 0,0:18:56.53,0:19:01.10,Default,,0,0,0,,Үздік екеуі арасындағы қызу әрі маңызды шайқасты жіберіп алмаңыз!
Dialogue: 0,0:19:01.10,0:19:03.00,Default,,0,0,0,,Бүгін де Хана жеңе ме?
Dialogue: 0,0:19:03.00,0:19:07.32,Default,,0,0,0,,Жарайды, Купиид оңай жеңілмейді.
Dialogue: 0,0:19:07.32,0:19:11.01,Default,,0,0,0,,Мен Ханамын, ең жақсы айдолмын
Dialogue: 0,0:19:11.01,0:19:14.16,Default,,0,0,0,,Жарайды, мен қолымнан келгенін жасадым.
Dialogue: 0,0:19:14.16,0:19:16.18,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:19:16.18,0:19:18.68,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:18.68,0:19:22.69,Default,,0,0,0,,Менің ойымша, егер мен бүгін жеңетін болсам, мұны сіз білесіз
Dialogue: 0,0:19:22.69,0:19:26.51,Default,,0,0,0,,Рейтинг өзгеріп, мен жоғарыда боламын.
Dialogue: 0,0:19:26.51,0:19:30.99,Default,,0,0,0,,Себебі менің жеңілемін деген ниетім жоқ.
Dialogue: 0,0:19:30.99,0:19:33.40,Default,,0,0,0,,ﾊﾅ
Dialogue: 0,0:19:33.40,0:19:35.60,Default,,0,0,0,,Күту режимі
Dialogue: 0,0:19:40.85,0:19:45.01,Default,,0,0,0,,Купида - айбатты жау. Оның орындауы дәл және ешқандай мүмкіндік жоқ.
Dialogue: 0,0:19:45.01,0:19:48.66,Default,,0,0,0,,Бірақ сіз өзіңіз болып, одан ләззат ала аласыз.
Dialogue: 0,0:19:48.66,0:19:50.66,Default,,0,0,0,,Мен сенің жаныңда болып, сені қолдаймын.
Dialogue: 0,0:19:50.66,0:19:54.03,Default,,0,0,0,,Иә, мен Хананың басты кумирімін.
Dialogue: 0,0:19:54.03,0:19:58.73,Default,,0,0,0,,Өмірде бір рет болатын осы ерекше кезеңнен толық рахат алыңыз
Dialogue: 0,0:20:06.73,0:20:09.83,Default,,0,0,0,,ｵｰﾛﾗﾍﾟｶﾞｻｽ
Dialogue: 0,0:20:09.83,0:20:15.17,Default,,0,0,0,,Аврора жарығымен бояйық Сіздермен бірге біз көрмеген әлемге
Dialogue: 0,0:20:15.17,0:20:39.66,Default,,0,0,0,,～
Dialogue: 0,0:20:39.66,0:20:50.61,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:20:50.61,0:20:52.84,Default,,0,0,0,,«Кеттік, жүрек соқсын».
Dialogue: 0,0:20:52.84,0:20:55.70,Default,,0,0,0,,«Көрінбейтін» әлемге»
Dialogue: 0,0:20:55.70,0:21:03.52,Default,,0,0,0,,«Қанатыңды жайсаң БАҚЫТТЫ∞Икатсу! иә! »
Dialogue: 0,0:21:03.52,0:21:13.00,Default,,0,0,0,,～
Dialogue: 0,0:21:13.00,0:21:18.35,Default,,0,0,0,,«Мен өзім қалаған кез келген нәрсеге айнала алатынымды сезінемін».
Dialogue: 0,0:21:18.35,0:21:22.84,Default,,0,0,0,,«Бұл шексіз мүмкіндіктер планетасы».
Dialogue: 0,0:21:22.84,0:21:24.84,Default,,0,0,0,,«Мен қуаныштымын»
Dialogue: 0,0:21:24.84,0:21:26.83,Default,,0,0,0,,«Шынымды айтсам, қараңыз».
Dialogue: 0,0:21:26.83,0:21:28.88,Default,,0,0,0,,«Сыртқа секірейік».
Dialogue: 0,0:21:28.88,0:21:30.91,Default,,0,0,0,,«Батылдық киімі»
Dialogue: 0,0:21:30.91,0:21:33.18,Default,,0,0,0,,«Оны сүйкімді киімге киіңіз».
Dialogue: 0,0:21:33.18,0:21:35.69,Default,,0,0,0,,«Бұл арман сияқты».
Dialogue: 0,0:21:35.69,0:21:38.36,Default,,0,0,0,,«Бұл арман емес».
Dialogue: 0,0:21:38.36,0:21:40.36,Default,,0,0,0,,«Орын бар»
Dialogue: 0,0:21:40.36,0:21:44.26,Default,,0,0,0,,«Келіңіздер! Сахнаға».
Dialogue: 0,0:21:44.26,0:21:46.25,Default,,0,0,0,,«Жеткізу»
Dialogue: 0,0:21:46.25,0:21:49.85,Default,,0,0,0,,«Жарқыраған әуен ырғағына жет! »
Dialogue: 0,0:21:49.85,0:21:52.20,Default,,0,0,0,,«Идол әрекеттері»
Dialogue: 0,0:21:52.20,0:21:54.85,Default,,0,0,0,,«Күлкі ханым»
Dialogue: 0,0:21:54.85,0:22:00.01,Default,,0,0,0,,«Білесің бе, үміт қандай болса да дос».
Dialogue: 0,0:22:00.01,0:22:03.01,Default,,0,0,0,,«Оны мықтап ұстаңыз».
Dialogue: 0,0:22:03.01,0:22:06.67,Default,,0,0,0,,｢БАҚЫТТЫ∞ｱｲｶﾂ Иә！｣
Dialogue: 0,0:22:06.67,0:22:14.67,Default,,0,0,0,,｢Барайық, кеттік! ｱ･ｲ･ｶ･ﾂ！｣
Dialogue: 0,0:22:14.67,0:22:19.85,Default,,0,0,0,,«Біз қосылатынымызға сенімдімін, әлем».
Dialogue: 0,0:22:19.85,0:22:23.50,Default,,0,0,0,,«Бұл сіздің алдыңызда тұрған жалғыз нәрсе емес».
Dialogue: 0,0:22:23.50,0:22:25.52,Default,,0,0,0,,«Кеттік!»
Dialogue: 0,0:22:25.52,0:22:29.91,Default,,0,0,0,,«Жүрегің соқсын, әлі көрмеген әлемге».
Dialogue: 0,0:22:29.91,0:22:31.83,Default,,0,0,0,,«Бірдеңе басталады»
Dialogue: 0,0:22:31.83,0:22:34.33,Default,,0,0,0,,«Алдын ала ескерту»
Dialogue: 0,0:22:34.33,0:22:36.76,Default,,0,0,0,,«Бірге барайық, Кими».
Dialogue: 0,0:22:36.76,0:22:39.68,Default,,0,0,0,,«Жарқын болашаққа»
Dialogue: 0,0:22:39.68,0:22:46.61,Default,,0,0,0,,"Қанатыңызды жайыңыз HAPPY∞Ikatsu! Иә!"
Dialogue: 0,0:22:46.61,0:22:53.91,Default,,0,0,0,,｢Барайық, кеттік! ｱ･ｲ･ｶ･ﾂ！｣
Dialogue: 0,0:22:56.83,0:22:59.35,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:22:59.35,0:23:02.01,Default,,0,0,0,,Нәтижелер жарияланды!
Dialogue: 0,0:23:02.01,0:23:06.48,Default,,0,0,0,,Айкату рейтингі 2-ші шайқас кезеңі
Dialogue: 0,0:23:06.48,0:23:09.00,Default,,0,0,0,,Сахнадағы орындау нүктелері
Dialogue: 0,0:23:09.00,0:23:12.03,Default,,0,0,0,,Дрешия Дрешияның өтінішіне назар аударады
Dialogue: 0,0:23:12.03,0:23:14.03,Default,,0,0,0,,Өткізілетін орынның толқуына байланысты
Dialogue: 0,0:23:14.03,0:23:16.55,Default,,0,0,0,,Кернеу нүктелері Барлық нүктелер
Dialogue: 0,0:23:16.55,0:23:19.86,Default,,0,0,0,,Ең жоғары жиынтық...
Dialogue: 0,0:23:19.86,0:23:22.83,Default,,0,0,0,,Хана! Жеңімпаз - Хана!
Dialogue: 0,0:23:22.83,0:23:25.51,Default,,0,0,0,,Мен?
Dialogue: 0,0:23:25.51,0:23:28.52,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:23:28.52,0:23:30.67,Default,,0,0,0,,Ия, тамаша
Dialogue: 0,0:23:30.67,0:23:34.85,Default,,0,0,0,,Аврора Пегасустың інжу-маржаны таң қалдырды!
Dialogue: 0,0:23:34.85,0:23:40.74,Default,,0,0,0,,Асыл Леоның көйлегі әдемі болды, бірақ Аврора Пегаспен бәсекелесе алмайды.
Dialogue: 0,0:23:40.74,0:23:43.51,Default,,0,0,0,,Құттықтаймыз Хана
Dialogue: 0,0:23:43.51,0:23:46.51,Default,,0,0,0,,Рахмет, Купиид
Dialogue: 0,0:23:51.15,0:23:54.86,Default,,0,0,0,,Сахна Өте жақсы болды! рахмет
Dialogue: 0,0:23:54.86,0:23:58.51,Default,,0,0,0,,А, мен қатты ренжідім.
Dialogue: 0,0:23:58.51,0:24:01.01,Default,,0,0,0,,Бұл біртүрлі деп ойламайсың ба? иә?
Dialogue: 0,0:24:01.01,0:24:05.02,Default,,0,0,0,,Хана үнемі гүлді көйлек киеді
Dialogue: 0,0:24:05.02,0:24:09.02,Default,,0,0,0,,Сондықтан мен гүл түріне қарсы күшті кеуек аймағын кидім.
Dialogue: 0,0:24:23.00,0:24:25.00,Default,,0,0,0,,Майзакура! бетбелгі!
Dialogue: 0,0:24:27.01,0:24:29.91,Default,,0,0,0,,Күрсін, бұл түс көргендей болды.
Dialogue: 0,0:24:29.91,0:24:34.00,Default,,0,0,0,,Жарқыраған прожекторлар мен музыка, көрермендердің лебіздері жаңғырық
Dialogue: 0,0:24:34.00,0:24:36.17,Default,,0,0,0,,Толқып, жүрегім лүпілдеп тұр!
Dialogue: 0,0:24:36.17,0:24:38.33,Default,,0,0,0,,Қабылдағаныңызға қуаныштымын.
Dialogue: 0,0:24:38.33,0:24:42.19,Default,,0,0,0,,Иә, бұл менің өмір бойы ұмытылмас естелік болды.
Dialogue: 0,0:24:42.19,0:24:47.84,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:24:47.84,0:24:50.34,Default,,0,0,0,,Күткендей, Хана сүйкімді. Мен оған тәнтімін.
Dialogue: 0,0:24:54.00,0:24:57.52,Default,,0,0,0,,Сұрақ Хана кім жасады? Бұл құпия
Dialogue: 0,0:24:57.52,0:25:07.32,Default,,0,0,0,,～
Dialogue: 0,0:27:39.70,0:27:42.84,Default,,0,0,0,,Бұл Аврора Пегас. Бұл Майоның бірінші киім киімі.
Dialogue: 0,0:27:42.84,0:27:46.04,Default,,0,0,0,,Үлкен қанаттар өте керемет!
Dialogue: 0,0:27:46.04,0:27:49.88,Default,,0,0,0,,Жоқ, жоқ, мынау, мынау!
Dialogue: 0,0:27:49.88,0:27:52.78,Default,,0,0,0,,Мирайн бәріміз бірге!
Dialogue: 0,0:27:54.28,0:28:00.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
