Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.37,0:00:02.62,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:00:02.62,0:00:04.08,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:00:02.62,0:00:04.08,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:00:04.08,0:00:06.09,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:00:06.17,0:00:08.09,Default,,0,0,0,,Хмм, тамаша!
Dialogue: 0,0:00:09.67,0:00:11.01,Default,,0,0,0,,Тағы бір нәрсе!
Dialogue: 0,0:00:11.67,0:00:13.22,Default,,0,0,0,,Эмоциялық!
Dialogue: 0,0:00:14.26,0:00:15.26,Default,,0,0,0,,Соңғы!
Dialogue: 0,0:00:20.35,0:00:23.98,Default,,0,0,0,,Иә Жарайды! Моцарт жақсы жұмыс
Dialogue: 0,0:00:24.06,0:00:25.40,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:00:25.48,0:00:27.52,Default,,0,0,0,,Бүгінгі күн де эмоционалды болды
Dialogue: 0,0:00:27.61,0:00:29.15,Default,,0,0,0,,Мәреге жетуді асыға күту
Dialogue: 0,0:00:29.23,0:00:30.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:31.74,0:00:33.45,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:00:34.99,0:00:37.45,Default,,0,0,0,,Хаа (Мибараки) Еңбегіңіз үшін рахмет.
Dialogue: 0,0:00:37.53,0:00:38.45,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:00:38.53,0:00:41.45,Default,,0,0,0,,Модельдеу әрекеттеріңіз жақсы жүріп жатқан сияқты.
Dialogue: 0,0:00:41.54,0:00:42.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:42.71,0:00:45.37,Default,,0,0,0,,Иә, өте көп
Dialogue: 0,0:00:45.46,0:00:48.59,Default,,0,0,0,,Негізі маған осындай хабарлама келді.
Dialogue: 0,0:00:48.67,0:00:49.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:49.59,0:00:52.55,Default,,0,0,0,,Мұздағы князь Миша Калтин
Dialogue: 0,0:00:52.63,0:00:54.97,Default,,0,0,0,,Мен сенің әніңді іздеп жүрмін
Dialogue: 0,0:00:56.34,0:00:57.64,Default,,0,0,0,,Ол...
Dialogue: 0,0:01:09.98,0:01:13.82,Default,,0,0,0,,Толқу, қуаныш, шаттық...
Dialogue: 0,0:01:14.45,0:01:17.36,Default,,0,0,0,,Әртүрлі жағымды эмоциялар талданады.
Dialogue: 0,0:01:17.99,0:01:20.12,Default,,0,0,0,,Әлем деректерге негізделген
Dialogue: 0,0:01:21.04,0:01:26.04,Default,,0,0,0,,Музыка, өнер, спорт және т.б. сияқты барлық салаларда.
Dialogue: 0,0:01:26.12,0:01:29.63,Default,,0,0,0,,Адамдардың анықталған құмарлығы арнайы құрылғымен бейнеленеді.
Dialogue: 0,0:01:30.88,0:01:32.21,Default,,0,0,0,,Эмоция…
Dialogue: 0,0:01:32.30,0:01:34.38,Default,,0,0,0,,эмоционалды көру деп аталады
Dialogue: 0,0:01:36.68,0:01:39.18,Default,,0,0,0,,Күшті және эмоционалдырақ
Dialogue: 0,0:01:40.39,0:01:43.43,Default,,0,0,0,,Әлемнің ережелері Күштілердің анықтамасы өзгерді
Dialogue: 0,0:01:43.52,0:01:45.89,Default,,0,0,0,,Ұлттар арасындағы бәсекелестік те
Dialogue: 0,0:01:45.98,0:01:49.44,Default,,0,0,0,,Мәдени және бейбіт шешімдерге ауысу
Dialogue: 0,0:01:51.57,0:01:53.82,Default,,0,0,0,,Эмоциялық мәдениеттің қайнар көзі ретінде
Dialogue: 0,0:01:53.90,0:01:58.91,Default,,0,0,0,,Хараджуку, Жапония үкіметі жаңадан ашқан академиялық қала
Dialogue: 0,0:02:00.07,0:02:04.12,Default,,0,0,0,,Орталықта жеке Глория академиясы орналасқан.
Dialogue: 0,0:02:06.00,0:02:09.96,Default,,0,0,0,,♪～
Dialogue: 0,0:03:31.92,0:03:35.92,Default,,0,0,0,,～♪
Dialogue: 0,0:03:36.50,0:03:40.93,Default,,0,0,0,,(Үрмелі аспаптардың дыбыстары)
Dialogue: 0,0:03:44.01,0:03:45.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:45.97,0:03:49.31,Default,,0,0,0,,Таңертеңнен бері шу болды...
Dialogue: 0,0:03:49.39,0:03:52.39,Default,,0,0,0,,Қайырлы таң, Бетховен.
Dialogue: 0,0:03:53.65,0:03:55.40,Default,,0,0,0,,Қайырлы таң, мұғалім
Dialogue: 0,0:03:55.48,0:03:57.57,Default,,0,0,0,,Бірақ бұл менің атым...
Dialogue: 0,0:03:57.65,0:03:58.94,Default,,0,0,0,,Бұл көрініс...
Dialogue: 0,0:03:59.57,0:04:01.45,Default,,0,0,0,,Су перісі ханшайымының косплейі?
Dialogue: 0,0:04:01.53,0:04:02.91,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:04.49,0:04:06.08,Default,,0,0,0,,Мен қайда ұйықтарымды білмеймін
Dialogue: 0,0:04:06.16,0:04:07.45,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:04:07.53,0:04:09.62,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:04:09.70,0:04:10.66,Default,,0,0,0,,Бірақ мұнда
Dialogue: 0,0:04:10.75,0:04:13.12,Default,,0,0,0,,Бұл сіздің бөлмеңіз орналасқан жатақхана.
Dialogue: 0,0:04:13.21,0:04:14.29,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:04:14.38,0:04:18.46,Default,,0,0,0,,О, мен мұны айтуды ұмытып кетіппін.
Dialogue: 0,0:04:18.55,0:04:21.05,Default,,0,0,0,,Өтінемін, сэр.
Dialogue: 0,0:04:21.13,0:04:22.47,Default,,0,0,0,,Иә
Dialogue: 0,0:04:27.39,0:04:30.89,Default,,0,0,0,,Келу Бұл сіздің бөлмеңіз.
Dialogue: 0,0:04:30.98,0:04:33.44,Default,,0,0,0,,Балалар?
Dialogue: 0,0:04:34.14,0:04:37.82,Default,,0,0,0,,Қайырлы таң, бұл Мибараки.
Dialogue: 0,0:04:37.90,0:04:40.40,Default,,0,0,0,,Әй, мұғалім, «тачи» дегенді қалай түсінесіңдер?
Dialogue: 0,0:04:40.48,0:04:42.95,Default,,0,0,0,,Иә? Бұл біртүрлі
Dialogue: 0,0:04:43.03,0:04:45.95,Default,,0,0,0,,Демек, сіз кетіп қалдыңыз...
Dialogue: 0,0:04:46.82,0:04:48.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:50.29,0:04:52.20,Default,,0,0,0,,Мен қазір душ қабылдап жатырмын.
Dialogue: 0,0:04:52.29,0:04:53.96,Default,,0,0,0,,Не... (Моцарт) А...
Dialogue: 0,0:04:54.04,0:04:56.67,Default,,0,0,0,,Бұл жігіт неге мұнда?
Dialogue: 0,0:04:56.75,0:04:59.50,Default,,0,0,0,,Себебі олар бір бөлмеде.
Dialogue: 0,0:04:59.59,0:05:00.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.51,0:05:05.72,Default,,0,0,0,,Екі адамдық бөлмеде мәңгі жалғыз қалуға болмайды.
Dialogue: 0,0:05:05.80,0:05:07.51,Default,,0,0,0,,Бұл... хмм?
Dialogue: 0,0:05:10.76,0:05:13.35,Default,,0,0,0,,Пут (Бетховен)...
Dialogue: 0,0:05:20.57,0:05:21.40,Default,,0,0,0,,О!
Dialogue: 0,0:05:23.53,0:05:26.86,Default,,0,0,0,,Моцарт, сен сондай ынталысың.
Dialogue: 0,0:05:26.95,0:05:29.99,Default,,0,0,0,,Иә, мен келісім-шартты қабылдағаннан бері.
Dialogue: 0,0:05:32.08,0:05:34.91,Default,,0,0,0,,Оның? Бұл маған мүлдем сәйкес келмейді, бірақ ...
Dialogue: 0,0:05:35.00,0:05:36.54,Default,,0,0,0,,Егер бұл Бірінші нөмірлі Батырға жақындауға көмектессе, мен бәрін жасауға дайынмын
Dialogue: 0,0:05:37.58,0:05:39.79,Default,,0,0,0,,Бұл не? Бұтадан таяқшаға дейін
Dialogue: 0,0:05:41.00,0:05:42.92,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:43.01,0:05:44.30,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:45.01,0:05:47.72,Default,,0,0,0,,Өтінемін, екеуміз жақсы араласамыз.
Dialogue: 0,0:05:47.80,0:05:51.85,Default,,0,0,0,,Сайысқа бірге қатысатын достармыз ғой.
Dialogue: 0,0:05:51.93,0:05:54.85,Default,,0,0,0,,Сонымен бұл қандай сайыс?
Dialogue: 0,0:05:54.93,0:05:58.06,Default,,0,0,0,,Мұғалім, бұл жігіт мұны тіпті білмейді...
Dialogue: 0,0:05:58.15,0:06:01.11,Default,,0,0,0,,Білу керек нәрселер көп.
Dialogue: 0,0:06:01.19,0:06:04.53,Default,,0,0,0,,Бір-бірлеп түсіндірейік. Бірінші...
Dialogue: 0,0:06:04.53,0:06:05.07,Default,,0,0,0,,Бір-бірлеп түсіндірейік. Бірінші...
Dialogue: 0,0:06:04.53,0:06:05.07,Default,,0,0,0,,(Ұялы телефон қоңырау үні)
Dialogue: 0,0:06:05.07,0:06:05.57,Default,,0,0,0,,(Ұялы телефон қоңырау үні)
Dialogue: 0,0:06:05.57,0:06:06.57,Default,,0,0,0,,(Ұялы телефон қоңырау үні)
Dialogue: 0,0:06:05.57,0:06:06.57,Default,,0,0,0,,Ооо...
Dialogue: 0,0:06:06.57,0:06:07.65,Default,,0,0,0,,(Ұялы телефон қоңырау үні)
Dialogue: 0,0:06:07.65,0:06:08.32,Default,,0,0,0,,(Ұялы телефон қоңырау үні)
Dialogue: 0,0:06:07.65,0:06:08.32,Default,,0,0,0,,Хмм, иә Сәлем
Dialogue: 0,0:06:08.32,0:06:10.62,Default,,0,0,0,,Хмм, иә Сәлем
Dialogue: 0,0:06:10.70,0:06:15.91,Default,,0,0,0,,Қызметкерлер жиналысы? Аа, дұрыс. А, мен бірден кетемін.
Dialogue: 0,0:06:16.00,0:06:17.79,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:06:17.87,0:06:19.29,Default,,0,0,0,,Моцарт мырза
Dialogue: 0,0:06:19.37,0:06:21.71,Default,,0,0,0,,Оған көп нәрсені айтыңызшы.
Dialogue: 0,0:06:21.79,0:06:23.67,Default,,0,0,0,,Қалғанын сұрадым.
Dialogue: 0,0:06:23.75,0:06:25.80,Default,,0,0,0,,Әй, ұстаз!
Dialogue: 0,0:06:26.84,0:06:29.01,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:06:29.09,0:06:31.18,Default,,0,0,0,,Кешегі Лист пен Шопен
Dialogue: 0,0:06:31.26,0:06:35.18,Default,,0,0,0,,Сондай-ақ, сіз бен біз төрт адам болып кіреміз.
Dialogue: 0,0:06:35.27,0:06:36.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:36.81,0:06:41.65,Default,,0,0,0,,Ән айту мен би билеу арқылы ең жақсы эмоционалды орындауды анықтау сайысы
Dialogue: 0,0:06:41.73,0:06:43.07,Default,,0,0,0,,Бұл сайыс
Dialogue: 0,0:06:43.15,0:06:44.23,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:06:44.32,0:06:48.49,Default,,0,0,0,,Сіз Бетховен болғандықтан, оған қатысуыңыз керек...
Dialogue: 0,0:06:48.57,0:06:51.49,Default,,0,0,0,,Тоқта, күт, күт, кім шығады? Міне бітті.
Dialogue: 0,0:06:51.57,0:06:53.24,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:53.33,0:06:56.16,Default,,0,0,0,,Көзімді емдеп, боксқа қайтамын.
Dialogue: 0,0:06:56.25,0:06:58.75,Default,,0,0,0,,Сіз бұл мектепке ән айту үшін келген жоқсыз!
Dialogue: 0,0:06:59.37,0:07:00.37,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:00.46,0:07:03.00,Default,,0,0,0,,Әнге тіл тигізбе!
Dialogue: 0,0:07:03.88,0:07:06.76,Default,,0,0,0,,Бетіңізге жараспайды, бетіңізде қан көп.
Dialogue: 0,0:07:06.84,0:07:08.09,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:14.22,0:07:16.89,Default,,0,0,0,,Сіз Бетховенсіз бе?
Dialogue: 0,0:07:18.98,0:07:20.39,Default,,0,0,0,,Себебі бар!
Dialogue: 0,0:07:18.98,0:07:20.39,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:07:20.39,0:07:22.44,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:07:25.32,0:07:26.69,Default,,0,0,0,,Әй, дұрыс...
Dialogue: 0,0:07:34.66,0:07:36.79,Default,,0,0,0,,Бұл да кеше болды.
Dialogue: 0,0:07:37.37,0:07:39.20,Default,,0,0,0,,Бұл күлкілі ме?
Dialogue: 0,0:07:39.29,0:07:41.71,Default,,0,0,0,,Жаңа айтқаныңызды түзетіңіз.
Dialogue: 0,0:07:41.79,0:07:44.84,Default,,0,0,0,,Музыка да мәдениет, ол мен үшін бәрі
Dialogue: 0,0:07:44.92,0:07:46.75,Default,,0,0,0,,Бұл «бірдеңе» емес!
Dialogue: 0,0:07:47.59,0:07:50.84,Default,,0,0,0,,Ол ән айтуға шындап қарайды ма?
Dialogue: 0,0:07:51.68,0:07:52.68,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:56.35,0:07:59.52,Default,,0,0,0,,Хм, мен не істеймін деп ойлаймын...
Dialogue: 0,0:08:01.14,0:08:01.69,Default,,0,0,0,,Иә? Не!
Dialogue: 0,0:08:01.69,0:08:02.52,Default,,0,0,0,,Иә? Не!
Dialogue: 0,0:08:01.69,0:08:02.52,Default,,0,0,0,,(Билет сататын автомат жұмысының дыбысы)
Dialogue: 0,0:08:03.48,0:08:04.98,Default,,0,0,0,,Әй, бұл кеше.
Dialogue: 0,0:08:05.06,0:08:06.57,Default,,0,0,0,,О, сен...
Dialogue: 0,0:08:06.65,0:08:07.86,Default,,0,0,0,,Бұл тізім.
Dialogue: 0,0:08:07.94,0:08:10.90,Default,,0,0,0,,Сіз Бетховенді әлі таныстырған жоқсыз
Dialogue: 0,0:08:10.99,0:08:13.41,Default,,0,0,0,,Сен мені осылай шақырдың...
Dialogue: 0,0:08:13.49,0:08:16.33,Default,,0,0,0,,Күмәнданған кезде: B тағамды дайындаңыз
Dialogue: 0,0:08:16.41,0:08:19.75,Default,,0,0,0,,Түскі ас кезінде бәрі аш болады және бәрі өлтіреді.
Dialogue: 0,0:08:21.83,0:08:24.00,Default,,0,0,0,,О, о...\NОл
Dialogue: 0,0:08:25.58,0:08:28.00,Default,,0,0,0,,(Метроном дыбысы)
Dialogue: 0,0:08:28.09,0:08:30.92,Default,,0,0,0,,Мен Бетховенмен бір бөлмедемін.
Dialogue: 0,0:08:31.01,0:08:32.42,Default,,0,0,0,,Бұл күлкі емес
Dialogue: 0,0:08:32.51,0:08:35.89,Default,,0,0,0,,Бұл әзіл. Бұл әзіл.
Dialogue: 0,0:08:37.89,0:08:40.72,Default,,0,0,0,,Егер біз бір-бірімізді тәулік бойы көретін болсақ.
Dialogue: 0,0:08:40.81,0:08:43.48,Default,,0,0,0,,Уақыт өте келе сезім пайда болуы мүмкін
Dialogue: 0,0:08:43.56,0:08:46.10,Default,,0,0,0,,Профессор Михараги осылай ойлайтын еді.
Dialogue: 0,0:08:46.19,0:08:48.82,Default,,0,0,0,,Менің атқа мінуге ниетім жоқ.
Dialogue: 0,0:08:48.90,0:08:51.49,Default,,0,0,0,,Бірақ байқаудағы жазбалар
Dialogue: 0,0:08:51.57,0:08:53.28,Default,,0,0,0,,Біз төртеуміз.
Dialogue: 0,0:08:53.36,0:08:55.61,Default,,0,0,0,,Қаласақ та, қаламасақ та бірге жұмыс істеуден басқа амалымыз жоқ.
Dialogue: 0,0:08:55.70,0:08:58.45,Default,,0,0,0,,Бұл адам жай ғана сандарды ажыратушы.
Dialogue: 0,0:08:58.53,0:09:01.12,Default,,0,0,0,,Мен де ол сияқты эмоционалды бола аламын.
Dialogue: 0,0:09:01.20,0:09:04.00,Default,,0,0,0,,Сіз оған өте теріс қарайсыз.
Dialogue: 0,0:09:04.08,0:09:05.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:05.37,0:09:07.88,Default,,0,0,0,,Маған мұндай қорқынышты көзбен қарамаңызшы.
Dialogue: 0,0:09:07.96,0:09:09.46,Default,,0,0,0,,Сіз де көрдіңіз, солай ма?
Dialogue: 0,0:09:11.80,0:09:16.26,Default,,0,0,0,,Сонша сезім... Оның мүмкіндігі бар сияқты.
Dialogue: 0,0:09:17.26,0:09:19.26,Default,,0,0,0,,Бірақ... иә?
Dialogue: 0,0:09:20.06,0:09:22.43,Default,,0,0,0,,Ол музыкаға қызықпайды.
Dialogue: 0,0:09:22.52,0:09:25.39,Default,,0,0,0,,Сыйлыққа сенудің күші - пышақ.
Dialogue: 0,0:09:25.48,0:09:28.65,Default,,0,0,0,,Ал, сыйлық болса, сыйлық, солай ма?
Dialogue: 0,0:09:28.73,0:09:31.02,Default,,0,0,0,,Өйткені біз бәріміз бірдейміз.
Dialogue: 0,0:09:31.11,0:09:33.65,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:09:37.49,0:09:39.32,Default,,0,0,0,,Яғни, біз
Dialogue: 0,0:09:39.41,0:09:43.58,Default,,0,0,0,,Сонымен оларға өткеннің ұлы музыканттарының факторлары трансплантацияланды.
Dialogue: 0,0:09:43.66,0:09:46.16,Default,,0,0,0,,Менің ішімде шынымен де осындай нәрсе бар ма?
Dialogue: 0,0:09:46.25,0:09:48.79,Default,,0,0,0,,Сізді Бетховен деп атайды
Dialogue: 0,0:09:48.88,0:09:50.42,Default,,0,0,0,,Дәлелдер
Dialogue: 0,0:09:50.50,0:09:53.30,Default,,0,0,0,,Есіңде бірдеңе жоқ па?
Dialogue: 0,0:09:54.84,0:09:57.55,Default,,0,0,0,,Айтпақшы, көзге ота жасатқанда...
Dialogue: 0,0:09:58.14,0:10:00.22,Default,,0,0,0,,Қолдау орнына
Dialogue: 0,0:10:00.30,0:10:04.47,Default,,0,0,0,,Келісім беру формасы бар сияқты, бірақ менің ойымша...
Dialogue: 0,0:10:04.56,0:10:06.27,Default,,0,0,0,,Міне, мен сенімдімін
Dialogue: 0,0:10:06.35,0:10:08.48,Default,,0,0,0,,Сіз оны оқымай қол қойдыңыз ба?
Dialogue: 0,0:10:08.56,0:10:10.36,Default,,0,0,0,,Бірақ бұл маңызды емес.
Dialogue: 0,0:10:10.44,0:10:10.98,Default,,0,0,0,,Хааа~
Dialogue: 0,0:10:10.98,0:10:13.48,Default,,0,0,0,,Хааа~
Dialogue: 0,0:10:10.98,0:10:13.48,Default,,0,0,0,,Көзімді түзегенше кез келген нәрсені қабылдаймын.
Dialogue: 0,0:10:13.57,0:10:17.15,Default,,0,0,0,,Егер мен бокспен қайта айналысатын болсам...
Dialogue: 0,0:10:17.24,0:10:18.66,Default,,0,0,0,,Өйткені мен ойладым
Dialogue: 0,0:10:20.41,0:10:22.87,Default,,0,0,0,,Иә... түсіндім.
Dialogue: 0,0:10:22.95,0:10:27.46,Default,,0,0,0,,Эй, бұл конкурсқа қатысуың керек пе?
Dialogue: 0,0:10:27.54,0:10:28.87,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:29.62,0:10:35.38,Default,,0,0,0,,Негізі, жеңе алмасақ жаман болар еді... Менің ойымша
Dialogue: 0,0:10:37.92,0:10:41.01,Default,,0,0,0,,Біз жеңіп, дәлелдеуіміз керек.
Dialogue: 0,0:10:41.09,0:10:42.14,Default,,0,0,0,,Сыйлық…
Dialogue: 0,0:10:42.22,0:10:46.39,Default,,0,0,0,,Мен жай ғана қайғылы теңіз шошқасымын.
Dialogue: 0,0:10:46.48,0:10:47.64,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:10:47.73,0:10:52.06,Default,,0,0,0,,Маған берілгендіктен, мен оны ең жақсы жағдайда қолданамын.
Dialogue: 0,0:10:52.15,0:10:54.15,Default,,0,0,0,,Мен онсыз істей алмаймын
Dialogue: 0,0:10:56.23,0:10:58.74,Default,,0,0,0,,Мүмкін мен конкурстан жеңіліп қалсам
Dialogue: 0,0:10:58.82,0:11:01.41,Default,,0,0,0,,Біздің дағдыларымыз алынады
Dialogue: 0,0:11:01.49,0:11:04.87,Default,,0,0,0,,Сен түкке тұрғысыз және түкке тұрғысызсың.
Dialogue: 0,0:11:06.70,0:11:09.16,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:11:09.25,0:11:11.63,Default,,0,0,0,,Мүмкін сіз үшін солай шығар.
Dialogue: 0,0:11:11.71,0:11:16.30,Default,,0,0,0,,Бірақ егер музыка... байыпты ән айтатын адам...
Dialogue: 0,0:11:16.38,0:11:19.88,Default,,0,0,0,,Егер сіздің армандарыңызды жүзеге асыратын күш жойылса...
Dialogue: 0,0:11:19.97,0:11:23.39,Default,,0,0,0,,Салиқалы ән айт...
Dialogue: 0,0:11:24.47,0:11:27.31,Default,,0,0,0,,Сіз бокс кешінде болдыңыз.
Dialogue: 0,0:11:27.39,0:11:31.85,Default,,0,0,0,,Жеңіске жетпесем, зейнеткерлікке шығамын, өйткені жекпе-жек жұдырығымды тартып алады.
Dialogue: 0,0:11:31.94,0:11:34.27,Default,,0,0,0,,Сіз әлі де жеңілген дұрыс деп ойлайсыз ба?
Dialogue: 0,0:11:36.69,0:11:39.90,Default,,0,0,0,,Кешіріңіз, бұл дөрекі сұрақ болды.
Dialogue: 0,0:11:40.70,0:11:42.91,Default,,0,0,0,,Сыйлық – сыйлық
Dialogue: 0,0:11:42.99,0:11:47.41,Default,,0,0,0,,Менің тілегім орындалуы үшін мен де оны көрсетуім керек.
Dialogue: 0,0:11:48.37,0:11:50.41,Default,,0,0,0,,Сайыста жеңіске жету
Dialogue: 0,0:11:50.50,0:11:51.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:53.00,0:11:55.04,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:11:53.00,0:11:55.04,Default,,0,0,0,,Тергеуіміз қажет нәрселер бар… біртіндеп шешеміз
Dialogue: 0,0:11:55.04,0:11:58.30,Default,,0,0,0,,Тергеуіміз қажет нәрселер бар… біртіндеп шешеміз
Dialogue: 0,0:11:58.92,0:11:59.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:00.05,0:12:01.88,Default,,0,0,0,,Ах, Ри... Лист мырза!
Dialogue: 0,0:12:01.97,0:12:04.55,Default,,0,0,0,,А, анау теледидар...
Dialogue: 0,0:12:04.64,0:12:05.68,Default,,0,0,0,,Ах… Оу
Dialogue: 0,0:12:05.76,0:12:08.68,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:12:11.10,0:12:11.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:15.98,0:12:17.94,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:12:23.86,0:12:26.41,Default,,0,0,0,,Миша Калтин?
Dialogue: 0,0:12:37.96,0:12:38.96,Default,,0,0,0,,Иә
Dialogue: 0,0:12:39.05,0:12:40.05,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:12:39.05,0:12:40.05,Default,,0,0,0,,Бөлмеме кіру үшін неге қобалжуым керек?
Dialogue: 0,0:12:40.05,0:12:43.55,Default,,0,0,0,,Неліктен мен өз бөлмеме кіру үшін қобалжуым керек?
Dialogue: 0,0:12:43.63,0:12:44.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:45.09,0:12:45.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:46.01,0:12:48.43,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:48.51,0:12:49.81,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:49.89,0:12:52.48,Default,,0,0,0,,Әй... Ой, қош келдіңіз.
Dialogue: 0,0:12:55.52,0:12:56.77,Default,,0,0,0,,(динамиктерден музыка ойнайды)
Dialogue: 0,0:12:56.77,0:12:58.57,Default,,0,0,0,,(динамиктерден музыка ойнайды)
Dialogue: 0,0:12:56.77,0:12:58.57,Default,,0,0,0,,Эй, сен мені елемейсің бе?
Dialogue: 0,0:12:58.57,0:12:58.65,Default,,0,0,0,,(динамиктерден музыка ойнайды)
Dialogue: 0,0:12:58.65,0:13:00.48,Default,,0,0,0,,(динамиктерден музыка ойнайды)
Dialogue: 0,0:12:58.65,0:13:00.48,Default,,0,0,0,,Бұл бөлме екі бөлікке бөлінді.
Dialogue: 0,0:13:00.57,0:13:02.74,Default,,0,0,0,,Ол дәл екі тең бөлікке бөлінген.
Dialogue: 0,0:13:02.82,0:13:06.74,Default,,0,0,0,,Мен сізді алдауға және сіздікі кеңірек деп айтуға болмайды деп ойлаймын.
Dialogue: 0,0:13:06.82,0:13:08.74,Default,,0,0,0,,Не болып жатыр? Неге Бугаттидің қолы мұнша суық?
Dialogue: 0,0:13:08.83,0:13:10.87,Default,,0,0,0,,Покеттино да
Dialogue: 0,0:13:10.95,0:13:12.58,Default,,0,0,0,,Не? Poke?
Dialogue: 0,0:13:12.66,0:13:14.62,Default,,0,0,0,,Бұл сызықты кесіп өтпеңіз
Dialogue: 0,0:13:15.12,0:13:17.75,Default,,0,0,0,,Бұл біраз уақыттан бері шығып тұрған дыбыс жақсы ма?
Dialogue: 0,0:13:17.83,0:13:20.67,Default,,0,0,0,,Сіз сызықтан өтіп жатырсыз!
Dialogue: 0,0:13:20.75,0:13:21.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:22.55,0:13:24.63,Default,,0,0,0,,Бұл ережеге қайшы екені сөзсіз.
Dialogue: 0,0:13:28.47,0:13:31.85,Default,,0,0,0,,Қарғыс атсын... Міне, осыны білдіреді...
Dialogue: 0,0:13:31.93,0:13:35.64,Default,,0,0,0,,О, аа... уф...
Dialogue: 0,0:13:39.65,0:13:40.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:40.73,0:13:42.69,Default,,0,0,0,,Сіз тағы да кемпингке барасыз ба?
Dialogue: 0,0:13:42.78,0:13:46.99,Default,,0,0,0,,Жоқ, бөлме ауыр сияқты.
Dialogue: 0,0:13:47.49,0:13:52.41,Default,,0,0,0,,Қайтып келгеннен бері ол үнсіз бірдеңе істеп жүр.
Dialogue: 0,0:13:52.49,0:13:54.83,Default,,0,0,0,,Тыныс алуыңыз қиындаса, уайымдамаңыз.
Dialogue: 0,0:13:54.91,0:13:59.04,Default,,0,0,0,,А, Миша Калтин ақыры Жапонияға келді.
Dialogue: 0,0:13:59.13,0:14:00.92,Default,,0,0,0,,Менің ойымша, сізде рух бар.
Dialogue: 0,0:14:01.92,0:14:06.42,Default,,0,0,0,,Мұздағы дворян... дұрыс па?
Dialogue: 0,0:14:06.51,0:14:08.34,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:14:08.43,0:14:11.22,Default,,0,0,0,,Миша келесі турнирде қандай әнді қолданады?
Dialogue: 0,0:14:11.30,0:14:13.97,Default,,0,0,0,,Сіз Моцарттан сұраған сияқтысыз.
Dialogue: 0,0:14:14.06,0:14:15.23,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:15.31,0:14:17.81,Default,,0,0,0,,Біраз қызығушылық танытыңыз.
Dialogue: 0,0:14:17.89,0:14:21.82,Default,,0,0,0,,Біз бір сайысқа қатысатын достармыз.
Dialogue: 0,0:14:22.32,0:14:23.98,Default,,0,0,0,,Сол мұғалім
Dialogue: 0,0:14:24.07,0:14:28.41,Default,,0,0,0,,Кешіріңіз, бірақ менде бұл байқауға ешқандай мотивация жоқ.
Dialogue: 0,0:14:28.49,0:14:31.32,Default,,0,0,0,,Шынымды айтсам, қазір ән айтатын уақыт емес.
Dialogue: 0,0:14:31.41,0:14:33.12,Default,,0,0,0,,Бірақ Бетховен...
Dialogue: 0,0:14:33.20,0:14:35.91,Default,,0,0,0,,Мен бұл есімді менікі деп санай да алмаймын.
Dialogue: 0,0:14:36.00,0:14:37.54,Default,,0,0,0,,Мен сәйкес келгім келмейді.
Dialogue: 0,0:14:37.62,0:14:39.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:39.96,0:14:41.46,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:41.54,0:14:45.96,Default,,0,0,0,,Осылай десеңіз, ертең міндетті түрде осында келіңіз.
Dialogue: 0,0:14:46.05,0:14:47.42,Default,,0,0,0,,Қосымша мәліметтер алу үшін осы жерді басыңыз
Dialogue: 0,0:14:47.42,0:14:48.63,Default,,0,0,0,,Қосымша мәліметтер алу үшін мына жерді басыңыз
Dialogue: 0,0:14:47.42,0:14:48.63,Default,,0,0,0,,(Қағаздың жыртылған дыбысы)
Dialogue: 0,0:14:48.72,0:14:49.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:49.93,0:14:51.14,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:14:51.22,0:14:52.60,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:14:55.60,0:14:58.39,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:14:58.89,0:15:01.23,Default,,0,0,0,,Маған тек жұдырық керек
Dialogue: 0,0:15:01.94,0:15:03.23,Default,,0,0,0,,Ән емес
Dialogue: 0,0:15:09.82,0:15:11.99,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:12.07,0:15:13.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:16.66,0:15:19.04,Default,,0,0,0,,Сәлем, бәрі осында.
Dialogue: 0,0:15:19.12,0:15:21.29,Default,,0,0,0,,Мұғалім! Бұл жігіттер неге мұнда?
Dialogue: 0,0:15:21.37,0:15:23.04,Default,,0,0,0,,Бұл менің жолым.
Dialogue: 0,0:15:23.13,0:15:26.13,Default,,0,0,0,,Ал, егжей-тегжейлер ше... А?
Dialogue: 0,0:15:26.21,0:15:28.17,Default,,0,0,0,,Достарыңыздың еңбектеніп жатқанын көргенде
Dialogue: 0,0:15:28.26,0:15:31.13,Default,,0,0,0,,Менің ойлау тәсілім өзгеретін шығар деп ойладым.
Dialogue: 0,0:15:31.22,0:15:32.34,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:32.43,0:15:34.14,Default,,0,0,0,,Тағы да алдадың, солай емес пе?
Dialogue: 0,0:15:34.22,0:15:36.14,Default,,0,0,0,,Қандай жаман ересек адам.
Dialogue: 0,0:15:38.22,0:15:39.93,Default,,0,0,0,,Не?
Dialogue: 0,0:15:40.48,0:15:45.73,Default,,0,0,0,,Бетпе-бет кездесуге бөтен адамдар өте көп.
Dialogue: 0,0:15:46.23,0:15:49.07,Default,,0,0,0,,Қош келдіңіз Култин мырза
Dialogue: 0,0:15:49.15,0:15:52.95,Default,,0,0,0,,Осындай кішкентай аралдық мемлекетке не себеп болды...
Dialogue: 0,0:15:53.03,0:15:55.91,Default,,0,0,0,,Бұл демеушілер үшін де мәселе.
Dialogue: 0,0:15:55.99,0:15:57.45,Default,,0,0,0,,Олар міндетті
Dialogue: 0,0:15:57.54,0:16:01.12,Default,,0,0,0,,Ол дворянның мұзда сырғанауын көргісі келетінін айтты...
Dialogue: 0,0:16:01.21,0:16:02.04,Default,,0,0,0,,Мұны ешкім жасамас еді...
Dialogue: 0,0:16:02.12,0:16:03.00,Default,,0,0,0,,Хмф! (Бетховен) Ах!
Dialogue: 0,0:16:03.08,0:16:04.58,Default,,0,0,0,,Grrgh...
Dialogue: 0,0:16:04.67,0:16:07.80,Default,,0,0,0,,-де? Қайсысы Моцарт?
Dialogue: 0,0:16:07.88,0:16:09.67,Default,,0,0,0,,Бұл менмін (Миша) А...
Dialogue: 0,0:16:09.76,0:16:11.13,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:11.22,0:16:14.01,Default,,0,0,0,,Сіздің жүзіңіз өте әдемі, солай емес пе?
Dialogue: 0,0:16:14.76,0:16:17.64,Default,,0,0,0,,Жақсы әндер жазатыныңызға сенімдімін.
Dialogue: 0,0:16:19.06,0:16:21.56,Default,,0,0,0,,Алдымен қарап шығыңыз.
Dialogue: 0,0:16:21.64,0:16:23.40,Default,,0,0,0,,Қазірдің өзінде солай ма?
Dialogue: 0,0:16:23.48,0:16:27.32,Default,,0,0,0,,Әдеттегідей, тыныс алғандай өлең жазамын.
Dialogue: 0,0:16:27.40,0:16:28.40,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:30.03,0:16:33.91,Default,,0,0,0,,Бұл соншалықты жаман емес сияқты, иә...
Dialogue: 0,0:16:35.74,0:16:36.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:37.49,0:16:39.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:43.00,0:16:45.42,Default,,0,0,0,,Ах… Ммм…
Dialogue: 0,0:16:45.50,0:16:50.17,Default,,0,0,0,,Бірақ сіз оны шынымен тыңдамайынша білмейсіз.
Dialogue: 0,0:16:50.26,0:16:52.67,Default,,0,0,0,,Оны ертеңге дейін дайындаңыз.
Dialogue: 0,0:16:52.76,0:16:55.55,Default,,0,0,0,,Бұл оқиға
Dialogue: 0,0:16:55.64,0:16:57.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:57.64,0:17:01.22,Default,,0,0,0,,Не болса да, ертең...
Dialogue: 0,0:17:01.31,0:17:04.31,Default,,0,0,0,,Әйтпесе, бұл әңгіме ештеңе емес.
Dialogue: 0,0:17:04.39,0:17:06.56,Default,,0,0,0,,Егер сіз еңбекқор жапон адамы болсаңыз
Dialogue: 0,0:17:06.65,0:17:09.61,Default,,0,0,0,,Сіз түні бойы ұйықтасаңыз да бітіре аласыз, солай ма?
Dialogue: 0,0:17:11.23,0:17:12.90,Default,,0,0,0,,Орындалды...
Dialogue: 0,0:17:12.99,0:17:14.32,Default,,0,0,0,,Не?
Dialogue: 0,0:17:15.36,0:17:17.07,Default,,0,0,0,,Барлығы болжанады
Dialogue: 0,0:17:19.70,0:17:22.62,Default,,0,0,0,,Мен ән жазылып қойғанын айттым.
Dialogue: 0,0:17:23.16,0:17:25.54,Default,,0,0,0,,Қарғыс атсын... Жарайды.
Dialogue: 0,0:17:25.62,0:17:28.33,Default,,0,0,0,,Әніңді тыңдайын!
Dialogue: 0,0:17:46.60,0:17:50.61,Default,,0,0,0,,♪～
Dialogue: 0,0:17:54.15,0:17:58.07,Default,,0,0,0,,♪ музыкалық қағазда жүзу
Dialogue: 0,0:17:58.16,0:18:01.45,Default,,0,0,0,,♪ Туған әуен
Dialogue: 0,0:18:01.53,0:18:05.33,Default,,0,0,0,,♪ Тыныштық тұңғиығынан
Dialogue: 0,0:18:05.41,0:18:08.83,Default,,0,0,0,,♪ Құштарлық аспанына
Dialogue: 0,0:18:08.92,0:18:17.59,Default,,0,0,0,,♪ Өлеңге толы
Dialogue: 0,0:18:27.56,0:18:29.23,Default,,0,0,0,,♪ Тіпті Анданте де емес
Dialogue: 0,0:18:29.31,0:18:31.23,Default,,0,0,0,,♪ Тіпті модератор да емес
Dialogue: 0,0:18:31.31,0:18:34.61,Default,,0,0,0,,♪ Өз өмірімнен адасып кеттім
Dialogue: 0,0:18:34.69,0:18:38.11,Default,,0,0,0,,♪ Әуен құрғап, жылап тұр
Dialogue: 0,0:18:38.20,0:18:41.87,Default,,0,0,0,,♪ Мен мұны кешіре алмаймын
Dialogue: 0,0:18:41.95,0:18:43.70,Default,,0,0,0,,♪ Келіңіздер...
Dialogue: 0,0:18:43.79,0:18:49.00,Default,,0,0,0,,♪ Періштенің қанатындай жіптер
Dialogue: 0,0:18:49.08,0:18:50.75,Default,,0,0,0,,♪ Келіңіздер...
Dialogue: 0,0:18:50.83,0:18:55.51,Default,,0,0,0,,♪ Адамдар жасаған ең жоғары фортепиано
Dialogue: 0,0:18:55.59,0:18:57.30,Default,,0,0,0,,♪ Тыңдау...
Dialogue: 0,0:18:57.38,0:18:58.88,Default,,0,0,0,,♪ барабан соғу
Dialogue: 0,0:18:58.97,0:19:02.26,Default,,0,0,0,,♪ Әлемдегі барлық нәрсе
Dialogue: 0,0:19:02.35,0:19:06.18,Default,,0,0,0,,♪ Қосылған және қабаттасатын
Dialogue: 0,0:19:06.27,0:19:08.64,Default,,0,0,0,,♪ Бар екенін біл
Dialogue: 0,0:19:08.73,0:19:12.15,Default,,0,0,0,,♪ Әлемнің орталығы
Dialogue: 0,0:19:12.23,0:19:15.44,Default,,0,0,0,,♪ Музыкаға толы
Dialogue: 0,0:19:15.53,0:19:18.65,Default,,0,0,0,,♪ Құдай сүйіспеншілікпен
Dialogue: 0,0:19:18.74,0:19:22.78,Default,,0,0,0,,♪ Бұл шашылған ғажайып
Dialogue: 0,0:19:22.87,0:19:26.41,Default,,0,0,0,,♪ Жою да, жарату да
Dialogue: 0,0:19:26.49,0:19:29.79,Default,,0,0,0,,♪ Шіркін де, сұлу да
Dialogue: 0,0:19:29.87,0:19:34.04,Default,,0,0,0,,♪ Барлық осы Nachtmusik
Dialogue: 0,0:19:34.13,0:19:36.42,Default,,0,0,0,,♪ Қанаттарға ауысу
Dialogue: 0,0:19:36.50,0:19:39.80,Default,,0,0,0,,♪ Сезім...
Dialogue: 0,0:19:39.88,0:19:43.43,Default,,0,0,0,,♪ Жылу...
Dialogue: 0,0:19:43.51,0:19:45.31,Default,,0,0,0,,♪ Сүйісуден
Dialogue: 0,0:19:45.39,0:19:50.64,Default,,0,0,0,,♪ Жұмсақ махаббаттың соңы (Жақсы)
Dialogue: 0,0:19:50.64,0:19:51.98,Default,,0,0,0,,♪ Жұмсақ махаббаттың соңы (Жақсы)
Dialogue: 0,0:19:50.64,0:19:51.98,Default,,0,0,0,,Мынау... Сол...
Dialogue: 0,0:19:51.98,0:19:52.81,Default,,0,0,0,,Мынадай... Сол...
Dialogue: 0,0:19:52.90,0:19:55.98,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:19:59.53,0:20:00.99,Default,,0,0,0,,Делизиосо
Dialogue: 0,0:20:06.91,0:20:11.04,Default,,0,0,0,,Пингвиндер бар Антарктидада ақ аюлар болмауы керек!
Dialogue: 0,0:20:11.12,0:20:12.33,Default,,0,0,0,,Ашу
Dialogue: 0,0:20:12.42,0:20:15.42,Default,,0,0,0,,Әндерін пайдалана алмайтын Мишаға
Dialogue: 0,0:20:15.50,0:20:18.34,Default,,0,0,0,,Моцарттың ішкі аңы ашылды
Dialogue: 0,0:20:19.05,0:20:21.80,Default,,0,0,0,,Бұл оның ашуы еді...
Dialogue: 0,0:20:28.43,0:20:31.10,Default,,0,0,0,,Тәтті және көңілді...
Dialogue: 0,0:20:41.03,0:20:44.11,Default,,0,0,0,,Тасымалдаушы өзгерсе, эмоция да өзгереді.
Dialogue: 0,0:20:44.82,0:20:48.12,Default,,0,0,0,,Миша бұрыштарды кесіп жатқан жоқ.
Dialogue: 0,0:20:48.20,0:20:51.37,Default,,0,0,0,,Әлгі жігіт оңай от алады.
Dialogue: 0,0:20:51.45,0:20:53.87,Default,,0,0,0,,Оның әндері мені жылатты.
Dialogue: 0,0:20:56.88,0:20:58.46,Default,,0,0,0,,Алдымен кешіріңіз (Бетховен) А...
Dialogue: 0,0:21:02.67,0:21:04.13,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:21:04.93,0:21:06.34,Default,,0,0,0,,Бокс үшін
Dialogue: 0,0:21:06.43,0:21:09.14,Default,,0,0,0,,Қарсыласын шыңдалған жұдырықпен ұру
Dialogue: 0,0:21:10.10,0:21:13.73,Default,,0,0,0,,Бірақ ол мені музыкамен ұрды.
Dialogue: 0,0:21:15.69,0:21:20.07,Default,,0,0,0,,Уау~ Дұрыс! Мен сені тіпті әнмен де соға аламын.
Dialogue: 0,0:21:20.15,0:21:23.78,Default,,0,0,0,,Бұл боксқа ұқсайды... Жоқ, бұл шын мәнінде бірдей!
Dialogue: 0,0:21:23.86,0:21:27.37,Default,,0,0,0,,Енді, сайысқа бірге барымызды салайық... Иә?
Dialogue: 0,0:21:27.45,0:21:29.53,Default,,0,0,0,,А... А?
Dialogue: 0,0:21:30.49,0:21:31.95,Default,,0,0,0,,Жоқ, ол шықпайды.
Dialogue: 0,0:21:32.04,0:21:36.46,Default,,0,0,0,,Иә~ Бұл сіздің ойыңызды өзгертетін сәт, солай ма?
Dialogue: 0,0:21:36.54,0:21:38.63,Default,,0,0,0,,Мм, мұғалім, сол себепті...
Dialogue: 0,0:21:38.71,0:21:41.17,Default,,0,0,0,,Бұл үнемді ойлау тәсілі.
Dialogue: 0,0:21:41.25,0:21:43.34,Default,,0,0,0,,Жоқ, жоқ, Шопен мырза, сондықтан маған қатты әсер етті...
Dialogue: 0,0:21:43.42,0:21:45.93,Default,,0,0,0,,А... Шопен, тыңдап тұрсың ба? Сіз ше, Бетховен?
Dialogue: 0,0:21:46.01,0:21:47.18,Default,,0,0,0,,Хух~ (Михараги) А, жоқ...
Dialogue: 0,0:21:47.26,0:21:48.51,Default,,0,0,0,,Қышқылдап тұр...
Dialogue: 0,0:21:48.59,0:21:50.56,Default,,0,0,0,,Егер бұл орын алса, мен Моцартқа қоңырау шаламын.
Dialogue: 0,0:21:50.64,0:21:53.77,Default,,0,0,0,,Моцарт мырза~!
Dialogue: 0,0:21:54.98,0:21:58.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:19.98,0:23:24.90,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.95,0:23:39.25,Default,,0,0,0,,Келесі жолы «Объектив арқылы нақты»
Dialogue: 0,0:23:40.75,0:23:46.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory