Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.45,0:00:04.46,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:00:06.00,0:00:08.09,Default,,0,0,0,,Бұл қоқыс
Dialogue: 0,0:00:14.01,0:00:15.76,Default,,0,0,0,,Қызық
Dialogue: 0,0:00:20.14,0:00:22.14,Default,,0,0,0,,Үмітсіздіктен басқа ештеңе емес
Dialogue: 0,0:00:26.40,0:00:27.82,Default,,0,0,0,,Иә! (Бетховен) Бау!
Dialogue: 0,0:01:02.10,0:01:02.98,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:01:09.23,0:01:10.69,Default,,0,0,0,,♪ Әлемді ашайық...
Dialogue: 0,0:01:10.69,0:01:16.53,Default,,0,0,0,,♪ Әлемді ашайық...
Dialogue: 0,0:01:10.69,0:01:16.53,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:01:16.61,0:01:19.53,Default,,0,0,0,,♪ «Тағдыр» деп нені атайды?
Dialogue: 0,0:01:19.62,0:01:22.54,Default,,0,0,0,,♪ Оны толығымен жоққа шығару мүмкін емес
Dialogue: 0,0:01:22.62,0:01:33.17,Default,,0,0,0,,♪ Өзіңнің жанды жарығың бол
Dialogue: 0,0:01:33.26,0:01:38.34,Default,,0,0,0,,♪ Өртенген кек әні -REVENJIC-
Dialogue: 0,0:01:42.14,0:01:44.14,Default,,0,0,0,,♪ Біреу айтты...
Dialogue: 0,0:01:44.23,0:01:45.81,Default,,0,0,0,,♪ Болашақ белгіленбеген.
Dialogue: 0,0:01:45.89,0:01:48.10,Default,,0,0,0,,♪ Нәзік сүйіспеншілік сияқты
Dialogue: 0,0:01:48.19,0:01:49.81,Default,,0,0,0,,♪ Жүрегімді ақырын ұстадым
Dialogue: 0,0:01:49.90,0:01:53.82,Default,,0,0,0,,♪ Үміт пен қадір-қасиетті де алып тастады
Dialogue: 0,0:01:53.90,0:01:55.40,Default,,0,0,0,,♪ Алға жылжу
Dialogue: 0,0:01:55.49,0:01:57.45,Default,,0,0,0,,♪ Мен оның күшті болатынын білдім
Dialogue: 0,0:01:57.53,0:02:01.20,Default,,0,0,0,,♪ Сатқындықтың пышағы кеудені кеседі
Dialogue: 0,0:02:01.28,0:02:04.95,Default,,0,0,0,,♪ Болашақ ашық қызылға боялған
Dialogue: 0,0:02:05.04,0:02:08.71,Default,,0,0,0,,♪ Бірақ бұл қанның ыстығына жылы
Dialogue: 0,0:02:08.79,0:02:12.21,Default,,0,0,0,,♪ «Өмір – ертең –» осында тұрады
Dialogue: 0,0:02:12.29,0:02:14.17,Default,,0,0,0,,♪ Ант етемін (Әнші 2) ♪ Мен сенемін
Dialogue: 0,0:02:14.26,0:02:17.59,Default,,0,0,0,,♪ ТАҒДЫР ЖОҚ
Dialogue: 0,0:02:17.68,0:02:21.60,Default,,0,0,0,,♪ Орныңыздан тұрып, армандаңыз
Dialogue: 0,0:02:21.68,0:02:25.35,Default,,0,0,0,,♪ Ақымақ ӨЛДІК-ті шайқаңыз
Dialogue: 0,0:02:25.43,0:02:29.35,Default,,0,0,0,,♪ Сені ренжіткендерге жыла
Dialogue: 0,0:02:29.44,0:02:33.11,Default,,0,0,0,,♪ Ашу мен мұңды ұстаңыз
Dialogue: 0,0:02:33.19,0:02:36.86,Default,,0,0,0,,♪ Әлемді ашайық...
Dialogue: 0,0:02:36.94,0:02:38.90,Default,,0,0,0,,♪ Жүрек – жан
Dialogue: 0,0:02:38.99,0:02:44.24,Default,,0,0,0,,♪ Кучизуке тарихқа
Dialogue: 0,0:02:44.33,0:02:49.25,Default,,0,0,0,,♪ Жеңіс
Dialogue: 0,0:02:49.33,0:02:51.38,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:02:51.38,0:02:53.79,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:02:51.38,0:02:53.79,Default,,0,0,0,,Көз алдымда тас қараңғы
Dialogue: 0,0:02:54.59,0:02:56.38,Default,,0,0,0,,Сақина шамынан да жарық
Dialogue: 0,0:02:58.13,0:03:01.01,Default,,0,0,0,,Мен жылтырларын көрдім
Dialogue: 0,0:03:15.98,0:03:19.99,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:03:36.17,0:03:39.59,Default,,0,0,0,,Қайырлы таң... Қашан келесіз?
Dialogue: 0,0:03:41.01,0:03:41.84,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:03:42.43,0:03:45.05,Default,,0,0,0,,Күту менің стилім емес.
Dialogue: 0,0:03:53.69,0:03:56.61,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:57.57,0:03:59.99,Default,,0,0,0,,...
Dialogue: 0,0:04:01.24,0:04:04.91,Default,,0,0,0,,Сіз бұл жерге үйрендіңіз бе? мен
Dialogue: 0,0:04:08.58,0:04:11.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:22.05,0:04:23.05,Default,,0,0,0,,(Оқушылардың таңданған дауыстары)
Dialogue: 0,0:04:23.13,0:04:24.34,Default,,0,0,0,,Мұнда да жоқ.
Dialogue: 0,0:04:24.43,0:04:25.93,Default,,0,0,0,,(Оқушылардың таңданған дауыстары)
Dialogue: 0,0:04:26.01,0:04:27.47,Default,,0,0,0,,Бұл жерде де жоқ.
Dialogue: 0,0:04:27.55,0:04:29.97,Default,,0,0,0,,Ха, қайсысы?
Dialogue: 0,0:04:30.06,0:04:31.73,Default,,0,0,0,,Мына адам!
Dialogue: 0,0:04:31.81,0:04:33.31,Default,,0,0,0,,Жалтар, қаш, сонда қал!
Dialogue: 0,0:04:33.39,0:04:35.19,Default,,0,0,0,,А? Ха ха...
Dialogue: 0,0:04:35.27,0:04:36.44,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:37.02,0:04:38.61,Default,,0,0,0,,Хехе... (Бетховен) Әй!
Dialogue: 0,0:04:38.69,0:04:39.44,Default,,0,0,0,,Талатта ратта таң…
Dialogue: 0,0:04:39.44,0:04:40.90,Default,,0,0,0,,Талатта ратта тан…
Dialogue: 0,0:04:39.44,0:04:40.90,Default,,0,0,0,,Кя!
Dialogue: 0,0:04:40.90,0:04:40.99,Default,,0,0,0,,Кя!
Dialogue: 0,0:04:40.99,0:04:42.19,Default,,0,0,0,,Кя!
Dialogue: 0,0:04:40.99,0:04:42.19,Default,,0,0,0,,Е...
Dialogue: 0,0:04:42.28,0:04:43.82,Default,,0,0,0,,Бұрыл (Бетховен) Эх! Ах...
Dialogue: 0,0:04:43.90,0:04:45.28,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:04:43.90,0:04:45.28,Default,,0,0,0,,(Оқушылар айқайлайды)
Dialogue: 0,0:04:45.36,0:04:48.12,Default,,0,0,0,,Кешіріңіздер, менің бүгінгі жоспарым бар.
Dialogue: 0,0:04:48.20,0:04:50.54,Default,,0,0,0,,Ертең тағы сөйлесейік?
Dialogue: 0,0:04:52.37,0:04:53.71,Default,,0,0,0,,Қазір не...
Dialogue: 0,0:04:53.79,0:04:54.96,Default,,0,0,0,,А, мен барамын...
Dialogue: 0,0:04:55.04,0:04:57.00,Default,,0,0,0,,Бұл қазірдің өзінде ыңғайсыздық! Бұл не үлкен?
Dialogue: 0,0:04:57.08,0:04:58.04,Default,,0,0,0,,Ах (оқушылар) Ах...
Dialogue: 0,0:04:58.13,0:05:00.38,Default,,0,0,0,,Эй, эй (студент)...
Dialogue: 0,0:05:00.46,0:05:02.88,Default,,0,0,0,,Спорт бөлімі не екенін білмейсіз бе?
Dialogue: 0,0:05:04.38,0:05:08.01,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:05:12.73,0:05:15.39,Default,,0,0,0,,Мен әлі түсінбеймін
Dialogue: 0,0:05:16.65,0:05:18.65,Default,,0,0,0,,А... аа, сәл күте тұрыңыз.
Dialogue: 0,0:05:19.31,0:05:22.03,Default,,0,0,0,,Бір минут! Мен сенен сұрағым келеді
Dialogue: 0,0:05:22.78,0:05:23.94,Default,,0,0,0,,Сіз?
Dialogue: 0,0:05:24.03,0:05:26.16,Default,,0,0,0,,Білесіз бе, спорт бөліміне арналған мектеп ғимараты...
Dialogue: 0,0:05:26.24,0:05:28.16,Default,,0,0,0,,Ең алдымен
Dialogue: 0,0:05:28.24,0:05:30.95,Default,,0,0,0,,Әй... Ой-ау.
Dialogue: 0,0:05:31.04,0:05:34.08,Default,,0,0,0,,«Сіз» менің атым емес.
Dialogue: 0,0:05:34.16,0:05:38.17,Default,,0,0,0,,Алғаш кездесіп отырған адамға дөрекі және дөрекі емес пе?
Dialogue: 0,0:05:38.25,0:05:41.50,Default,,0,0,0,,Ақыл мен абыройдың ізі жоқ.
Dialogue: 0,0:05:41.59,0:05:44.97,Default,,0,0,0,,Дөрекі және қатыгез, оны сырт келбеті мен киімі арқылы білуге ​​болады.
Dialogue: 0,0:05:41.59,0:05:44.97,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:05:45.05,0:05:48.76,Default,,0,0,0,,Сыпайы болудың ең төменгі бөлігін де жасай алмау.
Dialogue: 0,0:05:48.84,0:05:51.22,Default,,0,0,0,,Басқа амалым жоқ шығар
Dialogue: 0,0:05:52.06,0:05:54.81,Default,,0,0,0,,Ал... бұл жаман болды.
Dialogue: 0,0:05:54.89,0:05:57.85,Default,,0,0,0,,Мен сенен тағы сұрайын деп едім, а...
Dialogue: 0,0:05:57.94,0:05:59.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:00.44,0:06:03.86,Default,,0,0,0,,Сіздің көру қабілетіңіз адамдікіндей жақсы ма?
Dialogue: 0,0:06:03.94,0:06:06.86,Default,,0,0,0,,Бұрылып, осы жерден алыңыз.
Dialogue: 0,0:06:07.78,0:06:08.61,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:08.70,0:06:12.41,Default,,0,0,0,,Сіз күткендей, бұл сіз бірінші рет кездесіп отырған адамға құрметсіздік!
Dialogue: 0,0:06:12.49,0:06:14.87,Default,,0,0,0,,Айналыңыз. (Бетховен) О?
Dialogue: 0,0:06:14.95,0:06:17.16,Default,,0,0,0,,Біраз кіші, сүйкімдірек біреу жоқ па?
Dialogue: 0,0:06:18.58,0:06:19.96,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:06:20.88,0:06:23.25,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:06:26.22,0:06:28.13,Default,,0,0,0,,Спорт ғимараты
Dialogue: 0,0:06:28.68,0:06:31.60,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:06:36.31,0:06:39.23,Default,,0,0,0,,Спорт бөлімі осында.
Dialogue: 0,0:06:42.27,0:06:43.23,Default,,0,0,0,,Хмм!
Dialogue: 0,0:06:43.32,0:06:44.82,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:06:44.90,0:06:48.11,Default,,0,0,0,,Он сан әлі күнге дейін жүрегімде жазылмаған!
Dialogue: 0,0:06:48.74,0:06:52.74,Default,,0,0,0,,Менің осы мектепте қайталап көруге мүмкіндігім бар...
Dialogue: 0,0:06:52.83,0:06:54.49,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:06:54.58,0:06:58.04,Default,,0,0,0,,Бүгіннен бастап ауысатын студент келеді деп естідім.
Dialogue: 0,0:06:58.12,0:06:59.41,Default,,0,0,0,,Мен бұл туралы естіген жоқпын...
Dialogue: 0,0:06:59.50,0:07:00.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:03.13,0:07:05.63,Default,,0,0,0,,Алданып қалдыңыз ба?
Dialogue: 0,0:07:06.21,0:07:07.84,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:07:07.92,0:07:13.14,Default,,0,0,0,,Оқу ақысы тегін, ота ақысы алынып тасталады және тұру ақысы толығымен төленеді...
Dialogue: 0,0:07:14.10,0:07:16.47,Default,,0,0,0,,Сондай жақсы әңгіме бар...
Dialogue: 0,0:07:16.97,0:07:18.52,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:07:20.39,0:07:21.27,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:21.35,0:07:22.73,Default,,0,0,0,,Уау! (Михараки) Уау!
Dialogue: 0,0:07:23.73,0:07:24.11,Default,,0,0,0,,Өте…
Dialogue: 0,0:07:24.11,0:07:25.32,Default,,0,0,0,,Өте…
Dialogue: 0,0:07:24.11,0:07:25.32,Default,,0,0,0,,Білмеймін, бірақ оның жағдайы өте ауыр сияқты
Dialogue: 0,0:07:25.32,0:07:25.94,Default,,0,0,0,,Білмеймін, бірақ оның жағдайы өте ауыр сияқты
Dialogue: 0,0:07:26.57,0:07:28.65,Default,,0,0,0,,Иә, жарайды, жарайды.
Dialogue: 0,0:07:28.74,0:07:30.61,Default,,0,0,0,,Кешіріңіз~ Хаха
Dialogue: 0,0:07:30.70,0:07:31.99,Default,,0,0,0,,олардың әрекеттерін күшейту қаупі бар.
Dialogue: 0,0:07:32.07,0:07:34.07,Default,,0,0,0,,Кенет менің жанымда болдың
Dialogue: 0,0:07:34.16,0:07:36.91,Default,,0,0,0,,Сіз назар аудармайтын сияқтысыз немесе жоқ сияқтысыз...
Dialogue: 0,0:07:36.99,0:07:40.16,Default,,0,0,0,,Аха~ Бұл жиі айтылады.
Dialogue: 0,0:07:40.25,0:07:44.33,Default,,0,0,0,,О, боксшыдан күткендей кесек және бұлшықетті қолдар.
Dialogue: 0,0:07:44.42,0:07:46.25,Default,,0,0,0,,Сіз мені танисыз ба?
Dialogue: 0,0:07:46.34,0:07:48.13,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:07:48.21,0:07:51.55,Default,,0,0,0,,Мен көптен бері бас қақпаның алдында күттім, бірақ сен келмедің.
Dialogue: 0,0:07:51.63,0:07:54.47,Default,,0,0,0,,Мен күтсем де... мүмкін сен шығарсың.
Dialogue: 0,0:07:54.55,0:07:56.22,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:07:56.31,0:08:00.48,Default,,0,0,0,,Мен сенің ұстазыңмын, Мибараки, мен сенің жолбасшың болуды сеніп тапсырдым. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:08:00.56,0:08:03.48,Default,,0,0,0,,Ах хахаха... (Мибараки) Хэхе~ Хэхе...
Dialogue: 0,0:08:04.06,0:08:06.11,Default,,0,0,0,,Бұл жеке Глория академиясы
Dialogue: 0,0:08:06.19,0:08:09.78,Default,,0,0,0,,Ойын-сауық, спорт және басқа ойын-сауық алаңдары
Dialogue: 0,0:08:09.86,0:08:16.62,Default,,0,0,0,,Бұл белсенділік танытатын кейінгі ұрпақ үшін құрылған ерекше және ерекше мектеп.
Dialogue: 0,0:08:18.49,0:08:19.75,Default,,0,0,0,,Сол мұғалім
Dialogue: 0,0:08:19.83,0:08:23.12,Default,,0,0,0,,Мені жаңа ғана қызметкерлер бөлмесінде бұрып жіберді...
Dialogue: 0,0:08:23.21,0:08:25.04,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:08:25.13,0:08:28.13,Default,,0,0,0,,«Дұрыс»... Бұл мәселе!
Dialogue: 0,0:08:28.75,0:08:30.55,Default,,0,0,0,,Менің көзімді емде
Dialogue: 0,0:08:30.63,0:08:33.63,Default,,0,0,0,,Мен боксқа қайта ораламын деп ойладым...
Dialogue: 0,0:08:39.97,0:08:42.89,Default,,0,0,0,,Осы мектепке келгенім...
Dialogue: 0,0:08:42.98,0:08:45.06,Default,,0,0,0,,Иә, келдік.
Dialogue: 0,0:08:45.15,0:08:46.77,Default,,0,0,0,,бұл бұлыңғыр кадрлардан оны анықтау қиын болар еді.
Dialogue: 0,0:08:46.86,0:08:49.27,Default,,0,0,0,,Иә? Қайда... иә?
Dialogue: 0,0:08:49.36,0:08:50.82,Default,,0,0,0,,Я~
Dialogue: 0,0:08:50.90,0:08:53.32,Default,,0,0,0,,Бұл сіз бүгіннен бастап баратын мектеп ғимараты.
Dialogue: 0,0:08:53.40,0:08:56.53,Default,,0,0,0,,Жеке Глория Академиясының музыкалық бөлімі!
Dialogue: 0,0:08:57.16,0:08:59.79,Default,,0,0,0,,Музыка бөлімі? (Михараки) Иә, иә
Dialogue: 0,0:09:00.62,0:09:01.91,Default,,0,0,0,,Кейбір түсінбеушілік...
Dialogue: 0,0:09:02.00,0:09:03.33,Default,,0,0,0,,Түсіндіру жеткіліксіз болды
Dialogue: 0,0:09:03.41,0:09:04.79,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:04.87,0:09:08.79,Default,,0,0,0,,Толық мәліметтер кейінірек айтылады, сондықтан әзірге
Dialogue: 0,0:09:08.88,0:09:12.26,Default,,0,0,0,,Мен сенен бір нәрсе істегеніңді қалаймын.
Dialogue: 0,0:09:15.34,0:09:17.18,Default,,0,0,0,,Студенттік кеңес бөлмесі…
Dialogue: 0,0:09:17.76,0:09:18.85,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:21.64,0:09:23.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:33.53,0:09:35.86,Default,,0,0,0,,А, Моцарт-кун (Бетховен)?
Dialogue: 0,0:09:35.95,0:09:38.57,Default,,0,0,0,,Мектептен шығатын уақыт әлі емес.
Dialogue: 0,0:09:39.99,0:09:40.99,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:41.54,0:09:43.91,Default,,0,0,0,,Моцарт?
Dialogue: 0,0:09:44.00,0:09:44.58,Default,,0,0,0,,Төтенше шақыру болса да.
Dialogue: 0,0:09:44.58,0:09:45.71,Default,,0,0,0,,Төтенше шақыру болса да.
Dialogue: 0,0:09:44.58,0:09:45.71,Default,,0,0,0,,Ах
Dialogue: 0,0:09:45.79,0:09:47.25,Default,,0,0,0,,Неліктен көп күтуге тура келді?
Dialogue: 0,0:09:47.33,0:09:50.34,Default,,0,0,0,,Мен сияқты шыдамды адам да үйіне қайтқысы келеді.
Dialogue: 0,0:09:50.42,0:09:51.80,Default,,0,0,0,,Коммуникациялардың бірі туралы
Dialogue: 0,0:09:51.88,0:09:53.71,Default,,0,0,0,,алмадыңыз ба?
Dialogue: 0,0:09:53.80,0:09:56.34,Default,,0,0,0,,Мәселе мынада, Михараги мырза.
Dialogue: 0,0:09:57.01,0:09:58.59,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:09:58.68,0:10:01.10,Default,,0,0,0,,Сен ол балаларға жамандық жасадың.
Dialogue: 0,0:10:01.18,0:10:03.27,Default,,0,0,0,,Пайдасы төмен және сату көлемі жоғары қарым-қатынастар
Dialogue: 0,0:10:03.35,0:10:06.69,Default,,0,0,0,,Сақ болмасаңыз, қиындыққа тап боласыз Тізім
Dialogue: 0,0:10:06.77,0:10:08.15,Default,,0,0,0,,Шопен туралы сөз болғанда
Dialogue: 0,0:10:08.23,0:10:11.61,Default,,0,0,0,,Мен олай айтпаймын.
Dialogue: 0,0:10:11.69,0:10:14.48,Default,,0,0,0,,А... сендер бұрынғы жігіттер!
Dialogue: 0,0:10:14.57,0:10:18.28,Default,,0,0,0,,А, дәліздегі бұрынғы адам? Сәлем
Dialogue: 0,0:10:18.36,0:10:20.49,Default,,0,0,0,,Сіз маған осы жолы қоңырау шалып тұрсыз ба?
Dialogue: 0,0:10:21.12,0:10:25.41,Default,,0,0,0,,Бұл дөрекі емес пе? Үйренбейтін құстар ма?
Dialogue: 0,0:10:25.50,0:10:28.62,Default,,0,0,0,,Немесе сіздің басыңызға краб мисо жабысып қалды ма?
Dialogue: 0,0:10:28.71,0:10:31.04,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:10:31.13,0:10:34.13,Default,,0,0,0,,Иә, иә, барлығыңыз тыныш болыңыздар.
Dialogue: 0,0:10:34.21,0:10:36.88,Default,,0,0,0,,Сізге жаңа доспен таныстыруға рұқсат етіңіз.
Dialogue: 0,0:10:38.18,0:10:39.63,Default,,0,0,0,,(Шинобу) Мұнда тірі қалғандар жоқ сияқты.
Dialogue: 0,0:10:39.72,0:10:41.18,Default,,0,0,0,,Охон…
Dialogue: 0,0:10:41.26,0:10:44.14,Default,,0,0,0,,Бүгіннен бастап ол Бетховен!
Dialogue: 0,0:10:45.72,0:10:47.39,Default,,0,0,0,,(Моцарттың таңданған дауыстары)
Dialogue: 0,0:10:47.98,0:10:49.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:50.02,0:10:53.98,Default,,0,0,0,,♪～
Dialogue: 0,0:12:15.90,0:12:19.90,Default,,0,0,0,,～♪
Dialogue: 0,0:12:21.74,0:12:25.95,Default,,0,0,0,,Музыка бөлімінің студенттік кеңесі ерекше.
Dialogue: 0,0:12:26.58,0:12:29.41,Default,,0,0,0,,Белгілі бір талантты осы мүше ашты.
Dialogue: 0,0:12:29.49,0:12:32.37,Default,,0,0,0,,Олардан топ құруды сұраңыз...
Dialogue: 0,0:12:32.46,0:12:35.83,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:35.92,0:12:37.63,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:12:37.71,0:12:41.76,Default,,0,0,0,,Осы жеке Глория академиясының білім беру философиясына сәйкес келетін жанды қойылымдар
Dialogue: 0,0:12:41.84,0:12:45.26,Default,,0,0,0,,Қойылым болады деген ереже бар.
Dialogue: 0,0:12:45.34,0:12:46.60,Default,,0,0,0,,Меніңше...
Dialogue: 0,0:12:46.68,0:12:51.60,Default,,0,0,0,,Бізде барлық мүшелер болмағандықтан, мен қазір тек жеке әрекеттермен айналысамын.
Dialogue: 0,0:12:51.68,0:12:53.81,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:12:53.89,0:12:56.48,Default,,0,0,0,,Негізі бос орын бар.
Dialogue: 0,0:12:56.56,0:12:57.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:58.06,0:13:01.44,Default,,0,0,0,,кездейсоқ кездейсоқ
Dialogue: 0,0:13:01.53,0:13:04.61,Default,,0,0,0,,Біз сізді сәйкес сыйлықпен таптық.
Dialogue: 0,0:13:04.70,0:13:06.62,Default,,0,0,0,,Мен оның келуін сұрадым...
Dialogue: 0,0:13:06.70,0:13:09.74,Default,,0,0,0,,Не? Сол сыйлық...
Dialogue: 0,0:13:09.83,0:13:12.62,Default,,0,0,0,,Сіз ештеңе естімегеніңізге сенімдісіз бе?
Dialogue: 0,0:13:14.21,0:13:16.12,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:13:16.21,0:13:18.59,Default,,0,0,0,,А...
Dialogue: 0,0:13:18.67,0:13:20.50,Default,,0,0,0,,Ah қату
Dialogue: 0,0:13:20.59,0:13:22.96,Default,,0,0,0,,Нашар қадағалау.
Dialogue: 0,0:13:23.05,0:13:26.13,Default,,0,0,0,,Басшылықтың жауапкершілігіне күмән келтірілмей ме? Бұл
Dialogue: 0,0:13:26.22,0:13:27.30,Default,,0,0,0,,А...
Dialogue: 0,0:13:27.39,0:13:30.81,Default,,0,0,0,,Иә~ Бұл... Мен қиыншылыққа ұшырадым.
Dialogue: 0,0:13:30.89,0:13:34.02,Default,,0,0,0,,Бұл жазғы бонустық бағалау...
Dialogue: 0,0:13:34.10,0:13:37.31,Default,,0,0,0,,Эй, сен неге бұл мектептесің?
Dialogue: 0,0:13:37.40,0:13:39.77,Default,,0,0,0,,Неге... Не?
Dialogue: 0,0:13:39.86,0:13:43.19,Default,,0,0,0,,Мұнда келуге қандай да бір жағдай болды ма?
Dialogue: 0,0:13:43.28,0:13:45.65,Default,,0,0,0,,...Енді сұрақ осы.
Dialogue: 0,0:13:50.91,0:13:52.04,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:13:52.54,0:13:53.54,Default,,0,0,0,,Жарақат
Dialogue: 0,0:13:55.37,0:13:58.17,Default,,0,0,0,,Мен матчта жарақат алдым.
Dialogue: 0,0:13:59.29,0:14:01.21,Default,,0,0,0,,Бұл бокс кеші.
Dialogue: 0,0:14:02.63,0:14:03.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:07.09,0:14:10.01,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:12.47,0:14:14.72,Default,,0,0,0,,Бұл жақсы идея емес
Dialogue: 0,0:14:15.23,0:14:17.39,Default,,0,0,0,,Соқыр бола жаздады
Dialogue: 0,0:14:18.27,0:14:22.40,Default,,0,0,0,,Ең бастысы, мен енді ешқашан рингке шықпауым мүмкін...
Dialogue: 0,0:14:23.82,0:14:27.15,Default,,0,0,0,,Мұндай жағдайда осы мектепке қатысты тұлға
Dialogue: 0,0:14:27.24,0:14:28.70,Default,,0,0,0,,Менің алдымда пайда болды
Dialogue: 0,0:14:28.78,0:14:30.32,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:31.41,0:14:35.12,Default,,0,0,0,,Құттықтаймыз, ота сәтті өтті.
Dialogue: 0,0:14:35.20,0:14:39.17,Default,,0,0,0,,Қаласаң, мен саған мүмкіндік беремін.
Dialogue: 0,0:14:39.25,0:14:41.21,Default,,0,0,0,,Жеке Глория академиясында
Dialogue: 0,0:14:41.29,0:14:45.80,Default,,0,0,0,,Егер сіз біздің оқу жоспарымызды орындай алсаңыз...
Dialogue: 0,0:14:47.72,0:14:49.09,Default,,0,0,0,,Қайтару мүмкіндігі
Dialogue: 0,0:14:49.18,0:14:50.93,Default,,0,0,0,,Бірден секірді
Dialogue: 0,0:14:51.01,0:14:53.22,Default,,0,0,0,,Болашақ туралы ойлама
Dialogue: 0,0:14:53.81,0:14:56.73,Default,,0,0,0,,Күту менің стилім емес.
Dialogue: 0,0:14:56.81,0:14:58.39,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:14:58.48,0:15:01.48,Default,,0,0,0,,Мектеп сәбізді де жем ретінде берді, оны түсінуге оңай.
Dialogue: 0,0:15:01.56,0:15:03.48,Default,,0,0,0,,Бұл ілулі зат.
Dialogue: 0,0:15:03.57,0:15:05.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:05.11,0:15:07.74,Default,,0,0,0,,Біз бұл туралы әлі шешкен жоқпыз.
Dialogue: 0,0:15:07.82,0:15:10.99,Default,,0,0,0,,Бұл не? Сіздердің жүздеріңізде білгір көзқарас бар.
Dialogue: 0,0:15:11.07,0:15:14.99,Default,,0,0,0,,Олай болса, күрделі оқиғаны былай қояйық.
Dialogue: 0,0:15:15.08,0:15:16.95,Default,,0,0,0,,Енді бұдан былай бірге еңбектенейік.
Dialogue: 0,0:15:17.04,0:15:18.37,Default,,0,0,0,,Бетховен мырза!
Dialogue: 0,0:15:18.46,0:15:21.83,Default,,0,0,0,,Дұрыс, болды, болды!
Dialogue: 0,0:15:21.92,0:15:24.84,Default,,0,0,0,,Иә? Не болды? Бетховен
Dialogue: 0,0:15:24.92,0:15:28.34,Default,,0,0,0,,Сонымен бұл қалай аталады?
Dialogue: 0,0:15:29.17,0:15:31.59,Default,,0,0,0,,Тізім? Иә
Dialogue: 0,0:15:31.68,0:15:33.14,Default,,0,0,0,,Шопен?
Dialogue: 0,0:15:33.22,0:15:35.14,Default,,0,0,0,,Бұл не? Бұталардан таяқтарға дейін
Dialogue: 0,0:15:35.22,0:15:37.27,Default,,0,0,0,,Адамдарды көрсетпеңіз
Dialogue: 0,0:15:37.35,0:15:38.35,Default,,0,0,0,,Вульгар
Dialogue: 0,0:15:38.98,0:15:40.56,Default,,0,0,0,,Ал Моцарт?
Dialogue: 0,0:15:42.65,0:15:44.73,Default,,0,0,0,,Бұл лақап ат қандай?
Dialogue: 0,0:15:44.81,0:15:48.19,Default,,0,0,0,,Егер сіз музыкант ойнағыңыз келсе, менсіз де жасай аласыз. Бұл күлкілі.
Dialogue: 0,0:15:48.94,0:15:50.70,Default,,0,0,0,,Бұл күлкілі ме?
Dialogue: 0,0:15:50.78,0:15:53.78,Default,,0,0,0,,Жаңа айтқаныңызды түзетіңіз.
Dialogue: 0,0:15:53.87,0:15:54.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:56.79,0:15:58.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:59.16,0:16:02.08,Default,,0,0,0,,Ми... барлығыңыз жақсы араласыңыз.
Dialogue: 0,0:16:02.17,0:16:05.34,Default,,0,0,0,,Бұл төртеуі сайысқа қатысады, солай ма?
Dialogue: 0,0:16:05.42,0:16:07.46,Default,,0,0,0,,Ах... (Шопен тізімі) Иә?
Dialogue: 0,0:16:07.55,0:16:09.34,Default,,0,0,0,,Конкурс?
Dialogue: 0,0:16:09.42,0:16:11.68,Default,,0,0,0,,Сіз нені айтасыз, сэр?
Dialogue: 0,0:16:11.76,0:16:14.64,Default,,0,0,0,,Иә? Мұны да айтпадың ба?
Dialogue: 0,0:16:14.72,0:16:16.47,Default,,0,0,0,,Бұл біртүрлі~
Dialogue: 0,0:16:17.10,0:16:18.97,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:16:20.31,0:16:22.69,Default,,0,0,0,,Жоқ, сондықтан мен «Иә, түсінемін» дедім.
Dialogue: 0,0:16:22.77,0:16:24.65,Default,,0,0,0,,Сіз бұлай айта алмайсыз, солай ма?
Dialogue: 0,0:16:24.73,0:16:28.86,Default,,0,0,0,,Өйткені сөйлеген сөзіне қарағанда, оның ән айту тәжірибесі жоқ деп ойлаймын.
Dialogue: 0,0:16:28.94,0:16:31.90,Default,,0,0,0,,Ал, неге жай ғана байқап көрмеске?
Dialogue: 0,0:16:31.99,0:16:33.66,Default,,0,0,0,,Егер сіз мұны жай ғана жасасаңыз, бұл тегін.
Dialogue: 0,0:16:33.74,0:16:34.86,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:16:34.95,0:16:36.83,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:16:36.91,0:16:40.75,Default,,0,0,0,,Сыйлықтар орынды ғой, солай ма?
Dialogue: 0,0:16:42.04,0:16:43.50,Default,,0,0,0,,№
Dialogue: 0,0:16:43.58,0:16:45.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:45.25,0:16:46.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:47.29,0:16:49.84,Default,,0,0,0,,Менде тек бокс бар
Dialogue: 0,0:16:49.92,0:16:52.76,Default,,0,0,0,,Мен мұнда ән айту үшін келген жоқпын.
Dialogue: 0,0:16:53.59,0:16:56.26,Default,,0,0,0,,Ән... бірдеңе?
Dialogue: 0,0:16:57.51,0:16:59.51,Default,,0,0,0,,«Бірдеңе»?
Dialogue: 0,0:16:59.60,0:17:03.44,Default,,0,0,0,,Ұрыс болғыңыз келсе, дереу осы жерден кетіңіз.
Dialogue: 0,0:17:03.52,0:17:07.36,Default,,0,0,0,,Біраздан бері әбігерге түсіп, төбелесіп жүрсіз...
Dialogue: 0,0:17:07.44,0:17:11.69,Default,,0,0,0,,Тыңда, бокс – спорт, бұл менің жаным!
Dialogue: 0,0:17:11.78,0:17:13.70,Default,,0,0,0,,Бұл жай ғана жұдырықтасу емес!
Dialogue: 0,0:17:13.78,0:17:16.82,Default,,0,0,0,,Музыка да мәдениет. Бұл мен үшін бәрі.
Dialogue: 0,0:17:16.91,0:17:18.41,Default,,0,0,0,,Бұл «бірдеңе» емес!
Dialogue: 0,0:17:18.49,0:17:20.54,Default,,0,0,0,,Куу…
Dialogue: 0,0:17:21.16,0:17:23.54,Default,,0,0,0,,Түсіндің бе, төбелескен ақымақ?
Dialogue: 0,0:17:23.62,0:17:24.79,Default,,0,0,0,,Не!
Dialogue: 0,0:17:24.87,0:17:28.63,Default,,0,0,0,,Жеңіл серме, бұл пианиссимо жұдырығы.
Dialogue: 0,0:17:28.71,0:17:30.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:30.96,0:17:32.88,Default,,0,0,0,,Ей, екеуің де...
Dialogue: 0,0:17:32.96,0:17:34.88,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:17:34.97,0:17:35.88,Default,,0,0,0,,Фу…
Dialogue: 0,0:17:35.97,0:17:38.89,Default,,0,0,0,,Онда мен сол жекпе-жекті сатып аламын.
Dialogue: 0,0:17:43.02,0:17:46.02,Default,,0,0,0,,Сақинаңмен жасайық
Dialogue: 0,0:18:02.87,0:18:04.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:05.29,0:18:07.29,Default,,0,0,0,,Эмоциялар жүйесі!
Dialogue: 0,0:18:07.37,0:18:09.38,Default,,0,0,0,,Ән мен би қойылымдары…
Dialogue: 0,0:18:09.46,0:18:11.75,Default,,0,0,0,,Одан туындайтын адам сезімдері
Dialogue: 0,0:18:11.84,0:18:14.55,Default,,0,0,0,,Псевдовизуализацияға қабілетті құрылғылар
Dialogue: 0,0:18:14.63,0:18:16.97,Default,,0,0,0,,Елде санаулы ғана.
Dialogue: 0,0:18:17.05,0:18:22.31,Default,,0,0,0,,Бізде Gloria Private Academy-де солардың бірі бар!
Dialogue: 0,0:18:25.39,0:18:28.31,Default,,0,0,0,,Өзіңнің сүйікті әніңді айт
Dialogue: 0,0:18:28.39,0:18:31.11,Default,,0,0,0,,Сүйікті ән...
Dialogue: 0,0:18:35.78,0:18:36.99,Default,,0,0,0,,Сосососо…
Dialogue: 0,0:18:37.07,0:18:39.45,Default,,0,0,0,,Қолыңыздағыны осында қойыңыз.
Dialogue: 0,0:19:10.44,0:19:16.48,Default,,0,0,0,,♪ Біз не үшін өмір сүруіміз керек?
Dialogue: 0,0:19:16.57,0:19:21.28,Default,,0,0,0,,♪ Мына кеудеде
Dialogue: 0,0:19:21.36,0:19:26.58,Default,,0,0,0,,♪ Маған жауап беріңіз
Dialogue: 0,0:19:26.58,0:19:27.75,Default,,0,0,0,,♪ Маған жауап беріңіз
Dialogue: 0,0:19:26.58,0:19:27.75,Default,,0,0,0,,А...
Dialogue: 0,0:19:39.34,0:19:40.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:40.84,0:19:44.39,Default,,0,0,0,,♪ Абыржыған тұман көтерілмейді
Dialogue: 0,0:19:44.47,0:19:49.77,Default,,0,0,0,,♪ Қатыгездік күтпейді
Dialogue: 0,0:19:49.85,0:19:53.52,Default,,0,0,0,,♪ Шындыққа ұрынған
Dialogue: 0,0:19:53.61,0:19:58.03,Default,,0,0,0,,♪ Бір ғана таңдау бар
Dialogue: 0,0:19:58.11,0:20:02.78,Default,,0,0,0,,♪ Арқамды соққан үмітсіздік
Dialogue: 0,0:20:02.86,0:20:06.08,Default,,0,0,0,,♪ Қандай керемет
Dialogue: 0,0:20:06.16,0:20:07.79,Default,,0,0,0,,♪ Сіз әлі де амансыз ба?
Dialogue: 0,0:20:08.41,0:20:08.83,Default,,0,0,0,,♪ Менде бір ғана жол бар...
Dialogue: 0,0:20:08.83,0:20:11.29,Default,,0,0,0,,♪ Менде бір ғана жол бар...
Dialogue: 0,0:20:08.83,0:20:11.29,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:20:11.29,0:20:12.00,Default,,0,0,0,,♪ Менде бір ғана жол бар...
Dialogue: 0,0:20:12.08,0:20:13.79,Default,,0,0,0,,♪ Шаракусей
Dialogue: 0,0:20:14.46,0:20:16.88,Default,,0,0,0,,♪ Мен өзімнен туғанмын
Dialogue: 0,0:20:16.96,0:20:17.80,Default,,0,0,0,,Не!
Dialogue: 0,0:20:16.96,0:20:17.80,Default,,0,0,0,,♪ Мен сияқты өмір сүр
Dialogue: 0,0:20:17.80,0:20:19.51,Default,,0,0,0,,♪ Мен сияқты өмір сүр
Dialogue: 0,0:20:19.59,0:20:20.88,Default,,0,0,0,,♪ Мен Кемелдік үшін күресемін
Dialogue: 0,0:20:20.88,0:20:21.51,Default,,0,0,0,,♪ Мен Кемелдік үшін күресемін
Dialogue: 0,0:20:20.88,0:20:21.51,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:20:21.51,0:20:21.59,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:20:21.59,0:20:23.38,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:20:21.59,0:20:23.38,Default,,0,0,0,,♪ Жалын сияқты
Dialogue: 0,0:20:23.38,0:20:23.80,Default,,0,0,0,,♪ Жалын сияқты
Dialogue: 0,0:20:23.89,0:20:24.64,Default,,0,0,0,,♪ Кез келген уақытта
Dialogue: 0,0:20:24.64,0:20:26.10,Default,,0,0,0,,♪ Кез келген уақытта
Dialogue: 0,0:20:24.64,0:20:26.10,Default,,0,0,0,,Не? Уау...
Dialogue: 0,0:20:26.10,0:20:26.18,Default,,0,0,0,,Не? Уау...
Dialogue: 0,0:20:26.18,0:20:27.31,Default,,0,0,0,,Не? Уау...
Dialogue: 0,0:20:26.18,0:20:27.31,Default,,0,0,0,,♪ Бір қадам жасаңыз
Dialogue: 0,0:20:27.31,0:20:28.81,Default,,0,0,0,,♪ Қадам жасаңыз
Dialogue: 0,0:20:28.89,0:20:29.81,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:20:28.89,0:20:29.81,Default,,0,0,0,,♪ Егер құлап қалсаңыз, тұрыңыз.
Dialogue: 0,0:20:29.81,0:20:32.06,Default,,0,0,0,,♪ Егер құлап қалсаңыз, тұрыңыз.
Dialogue: 0,0:20:32.06,0:20:33.10,Default,,0,0,0,,♪ Егер құлап қалсаңыз, тұрыңыз.
Dialogue: 0,0:20:32.06,0:20:33.10,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:20:33.10,0:20:33.19,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:20:33.19,0:20:33.65,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:20:33.19,0:20:33.65,Default,,0,0,0,,♪ Ешкім үшін емес
Dialogue: 0,0:20:33.65,0:20:34.44,Default,,0,0,0,,♪ Ешкім үшін емес
Dialogue: 0,0:20:34.44,0:20:35.44,Default,,0,0,0,,♪ Ешкім үшін емес
Dialogue: 0,0:20:34.44,0:20:35.44,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:35.44,0:20:37.57,Default,,0,0,0,,♪ Ешкім үшін емес
Dialogue: 0,0:20:37.65,0:20:47.58,Default,,0,0,0,,♪ Жаным үшін
Dialogue: 0,0:20:47.66,0:20:54.37,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,0:21:02.42,0:21:05.01,Default,,0,0,0,,Эмоциялар соншалықты айқын...
Dialogue: 0,0:21:05.09,0:21:07.97,Default,,0,0,0,,Бұл таңқаларлық. Қолымды да, аяғымды да шығара алмадым.
Dialogue: 0,0:21:08.72,0:21:10.60,Default,,0,0,0,,Оның қасиеттері
Dialogue: 0,0:21:10.68,0:21:13.60,Default,,0,0,0,,Оны әуесқой деп тануға әлі ерте ме?
Dialogue: 0,0:21:21.61,0:21:23.49,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:21:24.86,0:21:25.99,Default,,0,0,0,,Қайтару
Dialogue: 0,0:21:26.66,0:21:27.99,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:28.57,0:21:31.70,Default,,0,0,0,,Мен мұнда ән айту үшін келген жоқпын
Dialogue: 0,0:21:31.79,0:21:33.75,Default,,0,0,0,,Күте тұрыңыз, Бетхове... Ах!
Dialogue: 0,0:21:34.50,0:21:36.62,Default,,0,0,0,,Бұл менің атым емес!
Dialogue: 0,0:21:36.71,0:21:39.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:45.43,0:21:48.39,Default,,0,0,0,,Менің қалағаным ән емес...
Dialogue: 0,0:21:54.98,0:21:58.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:19.98,0:23:24.90,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.28,0:23:39.12,Default,,0,0,0,,Келесі жолы «Нахтмусик қанатқа айналады»
Dialogue: 0,0:23:40.62,0:23:46.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory