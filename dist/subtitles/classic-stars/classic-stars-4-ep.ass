Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.71,0:00:04.71,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:00:23.85,0:00:26.77,Default,,0,0,0,,Толқып, толқу
Dialogue: 0,0:00:27.61,0:00:30.82,Default,,0,0,0,,Мен бұл сезімді көремін
Dialogue: 0,0:00:31.65,0:00:34.03,Default,,0,0,0,,Қиял сияқты әсер ететін эмоция
Dialogue: 0,0:00:35.28,0:00:38.49,Default,,0,0,0,,Ғылыми прогрес шынымен таң қалдырады, солай емес пе?
Dialogue: 0,0:00:45.62,0:00:49.13,Default,,0,0,0,,Әдемірек, эмоционалдырақ
Dialogue: 0,0:00:49.21,0:00:53.13,Default,,0,0,0,,Түсінуге оңай монтаж - сізді эмоционалды ететін адам жеңеді.
Dialogue: 0,0:00:53.22,0:00:55.43,Default,,0,0,0,,Бұл елдер арасында өзгермейді.
Dialogue: 0,0:00:56.43,0:01:01.43,Default,,0,0,0,,Соғыстардың күшпен шешілгеніне баяғыда...?
Dialogue: 0,0:01:03.02,0:01:08.61,Default,,0,0,0,,Біздің ел Жапония да Хараджукуды эмо мәдениетінің орталығына қойды.
Dialogue: 0,0:01:10.44,0:01:15.70,Default,,0,0,0,,Біз қатысатын жеке Глория академиясы да сонда.
Dialogue: 0,0:01:20.99,0:01:24.96,Default,,0,0,0,,♪～
Dialogue: 0,0:02:46.95,0:02:50.96,Default,,0,0,0,,～♪
Dialogue: 0,0:02:52.00,0:02:56.01,Default,,0,0,0,,(Бетховеннің жүгірген тынысы)
Dialogue: 0,0:02:58.67,0:03:00.80,Default,,0,0,0,,Мен үшін мұны айту өте қиын, бірақ
Dialogue: 0,0:03:00.89,0:03:03.43,Default,,0,0,0,,Ағымдағы жағдай Бұдан әрі қалпына келтіру мүмкін емес...
Dialogue: 0,0:03:03.51,0:03:06.56,Default,,0,0,0,,Күнделікті өмірде проблема жоқ
Dialogue: 0,0:03:06.64,0:03:08.35,Default,,0,0,0,,Күшті спорт...
Dialogue: 0,0:03:08.85,0:03:12.44,Default,,0,0,0,,Дәрігер ретінде бас тартыңыз.
Dialogue: 0,0:03:13.23,0:03:16.61,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,0:03:16.69,0:03:20.49,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:20.57,0:03:22.82,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:03:22.91,0:03:26.87,Default,,0,0,0,,Мені бокстан басқа толғандыратын ештеңе жоқ...
Dialogue: 0,0:03:29.79,0:03:30.62,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:32.37,0:03:33.21,Default,,0,0,0,,Я...
Dialogue: 0,0:03:33.29,0:03:34.88,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:03:37.71,0:03:40.22,Default,,0,0,0,,Үлкен үй...
Dialogue: 0,0:03:40.30,0:03:42.13,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:03:46.93,0:03:48.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:48.14,0:03:49.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:49.22,0:03:52.39,Default,,0,0,0,,Эй, мен мұнда жаңа ғана көшіп келдім.
Dialogue: 0,0:03:52.48,0:03:54.81,Default,,0,0,0,,Мен бұл жерде жолды білмеймін...
Dialogue: 0,0:03:54.90,0:03:57.90,Default,,0,0,0,,Бұл мәселе болуы керек. Қай жолмен?
Dialogue: 0,0:03:57.98,0:03:59.90,Default,,0,0,0,,Глория академиясы
Dialogue: 0,0:03:59.99,0:04:00.90,Default,,0,0,0,,Хмм…
Dialogue: 0,0:04:00.99,0:04:05.53,Default,,0,0,0,,Содан кейін келесі екі бұрыштан солға бұрылыңыз.
Dialogue: 0,0:04:05.62,0:04:07.99,Default,,0,0,0,,Сәл жүрсең, көресің.
Dialogue: 0,0:04:08.08,0:04:09.79,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:04:13.12,0:04:16.54,Default,,0,0,0,,Мырза, таңғы ас дайын.
Dialogue: 0,0:04:16.63,0:04:18.05,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:20.63,0:04:23.05,Default,,0,0,0,,Қарғыс атсын, кешігіп қалдың!
Dialogue: 0,0:04:23.13,0:04:26.30,Default,,0,0,0,,Таңғы ас уақыты аяқталды!
Dialogue: 0,0:04:29.14,0:04:32.31,Default,,0,0,0,,Таңғы ас Таңғы ас... Таңғы ас!
Dialogue: 0,0:04:33.85,0:04:37.52,Default,,0,0,0,,А... Таңғы ас~!
Dialogue: 0,0:04:39.61,0:04:42.70,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:04:42.78,0:04:45.11,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:04:45.95,0:04:47.95,Default,,0,0,0,,Ішіңдегі қате ән айтып жатыр.
Dialogue: 0,0:04:48.03,0:04:49.37,Default,,0,0,0,,Керемет үйлесімділік.
Dialogue: 0,0:04:49.45,0:04:51.58,Default,,0,0,0,,Мен таңғы асты өткізіп жібердім.
Dialogue: 0,0:04:51.66,0:04:55.54,Default,,0,0,0,,Солай ма? Олай болса, студенттер кеңесінің бөлмесіне келіңіз.
Dialogue: 0,0:04:55.62,0:04:57.21,Default,,0,0,0,,Студенттік кеңес бөлмесі?
Dialogue: 0,0:04:57.29,0:05:00.00,Default,,0,0,0,,Сіз бірдеңе ойлап жатқан шығарсыз, солай ма?
Dialogue: 0,0:05:00.09,0:05:01.09,Default,,0,0,0,,Кеше болған жайтқа әлі де алаңдайсың ба?
Dialogue: 0,0:05:01.67,0:05:04.17,Default,,0,0,0,,Бүгінгі түскі ас қорапшасы артық.
Dialogue: 0,0:05:04.26,0:05:06.47,Default,,0,0,0,,Мен тойып жей алмаймын, маған көмектесе аласыз ба?
Dialogue: 0,0:05:06.55,0:05:07.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:08.68,0:05:10.97,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:05:11.06,0:05:13.56,Default,,0,0,0,,Бұны жеген дұрыс па?
Dialogue: 0,0:05:13.64,0:05:14.60,Default,,0,0,0,,Иә
Dialogue: 0,0:05:14.69,0:05:17.10,Default,,0,0,0,,Әже кейде бәрімізді бірге келуді сұрайды.
Dialogue: 0,0:05:17.19,0:05:18.56,Default,,0,0,0,,Маған бірдеңе беріңіз.
Dialogue: 0,0:05:18.65,0:05:19.82,Default,,0,0,0,,Баая?
Dialogue: 0,0:05:19.90,0:05:23.57,Default,,0,0,0,,Жарайды, жоқ, мен аламын!
Dialogue: 0,0:05:24.40,0:05:26.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.16,0:05:29.28,Default,,0,0,0,,Уми! барлық бес мүше мен мүшені қамтиды
Dialogue: 0,0:05:29.37,0:05:31.66,Default,,0,0,0,,Керемет, ішкі ағзалары көп
Dialogue: 0,0:05:31.74,0:05:34.08,Default,,0,0,0,,Сиыр сияқты, иә...
Dialogue: 0,0:05:34.75,0:05:36.12,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:05:36.21,0:05:38.25,Default,,0,0,0,,Хачиносу мен сенмайды жай ғана жеуге болмайды
Dialogue: 0,0:05:38.33,0:05:40.00,Default,,0,0,0,,Гиара да тамақтанады
Dialogue: 0,0:05:38.33,0:05:40.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:40.00,0:05:40.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:41.17,0:05:43.21,Default,,0,0,0,,Соңғы уақытта үйде болдыңыз ба?
Dialogue: 0,0:05:43.30,0:05:44.21,Default,,0,0,0,,Кейде
Dialogue: 0,0:05:44.30,0:05:46.30,Default,,0,0,0,,Тек жаттығу кезінде
Dialogue: 0,0:05:46.97,0:05:48.55,Default,,0,0,0,,Хмм...уф!
Dialogue: 0,0:05:48.64,0:05:51.56,Default,,0,0,0,,Қараңдар, мен оны асығыс жеймін.
Dialogue: 0,0:05:48.64,0:05:51.56,Default,,0,0,0,,(Бетховеннің жөтелі)
Dialogue: 0,0:05:53.10,0:05:54.06,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:05:54.14,0:05:58.02,Default,,0,0,0,,Бетховен мырза, сіз өз шешіміңізді қабылдадыңыз ба?
Dialogue: 0,0:05:58.10,0:05:59.31,Default,,0,0,0,,Не?
Dialogue: 0,0:05:59.40,0:06:02.27,Default,,0,0,0,,Біз бір ыдысты емес, бірдей түскі ас қорабын жейміз.
Dialogue: 0,0:06:02.36,0:06:06.15,Default,,0,0,0,,Бұл сайыстың қуанышы мен қайғысын бөлісу үшін бірліктің жиыны.
Dialogue: 0,0:06:06.24,0:06:07.61,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:06:07.70,0:06:08.82,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:06:08.91,0:06:13.33,Default,,0,0,0,,Бірақ мұнда бірдеңе айтып келгеніңіз рас.
Dialogue: 0,0:06:13.41,0:06:15.87,Default,,0,0,0,,Бұл менің ниетім емес.
Dialogue: 0,0:06:15.95,0:06:17.46,Default,,0,0,0,,Онда не үшін келдің?
Dialogue: 0,0:06:17.54,0:06:18.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:18.46,0:06:20.96,Default,,0,0,0,,Егер бұл байланыссыз болса, келме.
Dialogue: 0,0:06:21.04,0:06:22.25,Default,,0,0,0,,Мен…
Dialogue: 0,0:06:22.34,0:06:23.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:23.50,0:06:26.01,Default,,0,0,0,,Мен сені бүгін шақырдым.
Dialogue: 0,0:06:26.09,0:06:27.59,Default,,0,0,0,,(орыннан шыққан дыбыс)
Dialogue: 0,0:06:26.09,0:06:27.59,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:06:27.59,0:06:28.01,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:06:28.09,0:06:29.64,Default,,0,0,0,,Енді келме
Dialogue: 0,0:06:31.26,0:06:33.43,Default,,0,0,0,,Мен бір жамандық жасадым ба деп ойлаймын...
Dialogue: 0,0:06:33.51,0:06:35.27,Default,,0,0,0,,Ол кінәлі.
Dialogue: 0,0:06:35.35,0:06:39.31,Default,,0,0,0,,Жартылай істеуге тырыссаң да, ұзаққа бармайды.
Dialogue: 0,0:06:39.39,0:06:42.52,Default,,0,0,0,,Ол үшін де, бізге де проблема.
Dialogue: 0,0:06:42.61,0:06:45.53,Default,,0,0,0,,Асқазаныңызды алған соң, тағы бір итеріңіз...
Dialogue: 0,0:06:45.61,0:06:47.49,Default,,0,0,0,,Мазасыз жігітке мұңды күйде
Dialogue: 0,0:06:47.57,0:06:50.11,Default,,0,0,0,,Маған серенадаңызды тыңдауға рұқсат етіңіз!
Dialogue: 0,0:06:50.20,0:06:52.03,Default,,0,0,0,,А, мммммм...
Dialogue: 0,0:06:52.12,0:06:52.99,Default,,0,0,0,,Оны аузыңа сал
Dialogue: 0,0:06:52.12,0:06:52.99,Default,,0,0,0,,Енді ойлап қарасам, кеше түскі ас ішкенмін... Иә.
Dialogue: 0,0:06:52.99,0:06:53.08,Default,,0,0,0,,Енді ойлап қарасам, кеше түскі ас ішкенмін... Иә.
Dialogue: 0,0:06:53.08,0:06:54.74,Default,,0,0,0,,Енді ойлап қарасам, кеше түскі ас ішкенмін... Иә.
Dialogue: 0,0:06:53.08,0:06:54.74,Default,,0,0,0,,Сөйлеме!
Dialogue: 0,0:06:57.33,0:06:58.08,Default,,0,0,0,,Ватару!
Dialogue: 0,0:06:58.08,0:06:59.83,Default,,0,0,0,,Ватару!
Dialogue: 0,0:06:58.08,0:06:59.83,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:59.83,0:07:02.29,Default,,0,0,0,,Ватару!
Dialogue: 0,0:07:02.38,0:07:03.38,Default,,0,0,0,,А...
Dialogue: 0,0:07:04.09,0:07:06.13,Default,,0,0,0,,Ол енді келмеуі керек емес пе еді?
Dialogue: 0,0:07:06.21,0:07:10.05,Default,,0,0,0,,Бенто үшін рахмет айтуды ұмытып кетіппін.
Dialogue: 0,0:07:10.13,0:07:12.76,Default,,0,0,0,,Сырт келбетіңізге қарамастан, сізде әдептілік бар.
Dialogue: 0,0:07:14.39,0:07:16.47,Default,,0,0,0,,Тізім болса, ата-анамның үйіне барар едім.
Dialogue: 0,0:07:16.56,0:07:18.64,Default,,0,0,0,,Мен бүгін келмеймін.
Dialogue: 0,0:07:18.73,0:07:21.52,Default,,0,0,0,,Көремін... сонда ертең болар.
Dialogue: 0,0:07:21.60,0:07:23.52,Default,,0,0,0,,Менің баруым керек сияқты.
Dialogue: 0,0:07:26.53,0:07:28.03,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:07:28.11,0:07:29.95,Default,,0,0,0,,Шай кептелісі
Dialogue: 0,0:07:30.03,0:07:33.16,Default,,0,0,0,,Біз де алғысымызды дайындадық.
Dialogue: 0,0:07:33.24,0:07:33.70,Default,,0,0,0,,О, аа...
Dialogue: 0,0:07:33.70,0:07:34.58,Default,,0,0,0,,О, аа...
Dialogue: 0,0:07:33.70,0:07:34.58,Default,,0,0,0,,Оны бір уақытта жеткізіңіз.
Dialogue: 0,0:07:34.58,0:07:35.24,Default,,0,0,0,,Маған бір уақытта жіберіңізші.
Dialogue: 0,0:07:35.33,0:07:36.16,Default,,0,0,0,,Мен?
Dialogue: 0,0:07:36.24,0:07:40.21,Default,,0,0,0,,Мен сіздің ыдыстарыңызды жинадым ба?
Dialogue: 0,0:07:40.29,0:07:42.79,Default,,0,0,0,,Ух... Уау, солай болды.
Dialogue: 0,0:07:43.58,0:07:45.25,Default,,0,0,0,,Бірақ ол туралы не деуге болады?
Dialogue: 0,0:07:45.34,0:07:47.38,Default,,0,0,0,,Сіз бірден түсінесіз.
Dialogue: 0,0:07:47.46,0:07:49.42,Default,,0,0,0,,Бұл үлкен үй.
Dialogue: 0,0:07:50.13,0:07:54.55,Default,,0,0,0,,Мен оның осы жерде екенін ешқашан ойламаппын...
Dialogue: 0,0:07:54.64,0:07:58.81,Default,,0,0,0,,Бірақ мұндай жігіт неге жатақханада тұрады?
Dialogue: 0,0:07:58.89,0:08:01.77,Default,,0,0,0,,Бұл туралы сыпайы болыңыз.
Dialogue: 0,0:08:01.85,0:08:04.44,Default,,0,0,0,,Жоқ, бұл өте дәмді болды.
Dialogue: 0,0:08:04.52,0:08:05.77,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:08:05.86,0:08:08.32,Default,,0,0,0,,Қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:08:08.40,0:08:11.24,Default,,0,0,0,,Ботчаманы ішке күтіңіз.
Dialogue: 0,0:08:11.32,0:08:12.45,Default,,0,0,0,,О, мен...
Dialogue: 0,0:08:13.03,0:08:14.99,Default,,0,0,0,,Бочаманың досы?
Dialogue: 0,0:08:15.07,0:08:17.03,Default,,0,0,0,,А... жақсы.
Dialogue: 0,0:08:17.12,0:08:18.95,Default,,0,0,0,,Мүмкін әже?
Dialogue: 0,0:08:19.04,0:08:21.37,Default,,0,0,0,,Менің атым Отоза.
Dialogue: 0,0:08:21.46,0:08:23.71,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:08:34.80,0:08:37.10,Default,,0,0,0,,Әр саусақты бүгусіз түзу ұстаңыз
Dialogue: 0,0:08:41.93,0:08:45.10,Default,,0,0,0,,Қанша Қорақуен залы бар?
Dialogue: 0,0:08:48.19,0:08:49.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:50.82,0:08:52.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:55.82,0:08:57.12,Default,,0,0,0,,Уау...
Dialogue: 0,0:08:59.03,0:09:00.24,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:00.87,0:09:03.00,Default,,0,0,0,,Иә? Сәлем!
Dialogue: 0,0:09:04.37,0:09:06.04,Default,,0,0,0,,Марлей әскері емес.
Dialogue: 0,0:09:07.17,0:09:08.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:08.09,0:09:10.34,Default,,0,0,0,,Ооо... әйел?
Dialogue: 0,0:09:10.42,0:09:12.01,Default,,0,0,0,,Бұл әйел формасы.
Dialogue: 0,0:09:12.09,0:09:13.97,Default,,0,0,0,,Әйел формасы?
Dialogue: 0,0:09:14.05,0:09:16.13,Default,,0,0,0,,Шәкірттеріңіздің сұрауы бойынша.
Dialogue: 0,0:09:16.22,0:09:18.60,Default,,0,0,0,,Кейде мен сабақ беремін.
Dialogue: 0,0:09:19.47,0:09:23.48,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:09:37.99,0:09:39.91,Default,,0,0,0,,О...
Dialogue: 0,0:09:41.45,0:09:42.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:42.37,0:09:44.29,Default,,0,0,0,,Я...
Dialogue: 0,0:09:46.50,0:09:48.54,Default,,0,0,0,,Мен екіленуді көріп тұрмын...
Dialogue: 0,0:09:48.63,0:09:49.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:54.13,0:09:56.22,Default,,0,0,0,,Иә? Бүгін таңертең...
Dialogue: 0,0:09:56.30,0:09:57.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:57.88,0:10:00.30,Default,,0,0,0,,Менің көзім мені алдамайды
Dialogue: 0,0:10:00.39,0:10:03.56,Default,,0,0,0,,Сахнаны кешіріңіз. Сахнадан түс.
Dialogue: 0,0:10:04.56,0:10:08.52,Default,,0,0,0,,Ұстаз, сізден жаттығуды сұраған біз едік...
Dialogue: 0,0:10:08.60,0:10:12.23,Default,,0,0,0,,Оны өзіңіз де білетін шығарсыз.
Dialogue: 0,0:10:13.23,0:10:15.07,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:10:15.15,0:10:18.82,Default,,0,0,0,,Неге! Мен бұл керемет деп ойладым.
Dialogue: 0,0:10:18.91,0:10:19.87,Default,,0,0,0,,Сен…
Dialogue: 0,0:10:20.53,0:10:23.45,Default,,0,0,0,,Кешіріңіз... Әке.
Dialogue: 0,0:10:24.12,0:10:28.79,Default,,0,0,0,,Жолыңды меңгермейінше менің алдымда шықпа.
Dialogue: 0,0:10:30.54,0:10:33.00,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:36.05,0:10:39.26,Default,,0,0,0,,Әй, бұл сенің әкең бе?
Dialogue: 0,0:10:39.34,0:10:40.97,Default,,0,0,0,,Неліктен бұл...
Dialogue: 0,0:10:42.05,0:10:43.51,Default,,0,0,0,,Әй, балам, қай жаққа бара жатырсың?
Dialogue: 0,0:10:43.60,0:10:44.97,Default,,0,0,0,,Кешіріңіз, Отоза (Бетховен) А...
Dialogue: 0,0:10:45.89,0:10:47.60,Default,,0,0,0,,Эй, кел!
Dialogue: 0,0:10:58.57,0:11:00.20,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:11:00.28,0:11:01.70,Default,,0,0,0,,Бұл ыстық кофе.
Dialogue: 0,0:11:05.41,0:11:08.21,Default,,0,0,0,,Сізге біртүрлі нәрсе көрсеткенім үшін кешіріңіз.
Dialogue: 0,0:11:08.29,0:11:10.54,Default,,0,0,0,,Қандай суық әке.
Dialogue: 0,0:11:10.62,0:11:13.34,Default,,0,0,0,,Мен сахна өнеріне әрқашан қатал болдым.
Dialogue: 0,0:11:13.42,0:11:16.34,Default,,0,0,0,,Өйткені ол Кабуки театрының басшысы.
Dialogue: 0,0:11:16.42,0:11:19.09,Default,,0,0,0,,Дәстүрлі орындаушылық өнердің жетекшісі?
Dialogue: 0,0:11:19.17,0:11:21.93,Default,,0,0,0,,Қандай тамаша бала еді.
Dialogue: 0,0:11:22.01,0:11:24.26,Default,,0,0,0,,Оқуды бітіргеннен кейін үйді мұраға аласың ба?
Dialogue: 0,0:11:24.35,0:11:28.06,Default,,0,0,0,,Жоқ, мұрагер шешілді.
Dialogue: 0,0:11:29.10,0:11:31.31,Default,,0,0,0,,Мен қалаусыз баламын
Dialogue: 0,0:11:34.90,0:11:38.78,Default,,0,0,0,,Ей, бір күні сахнада бірге тұрайық.
Dialogue: 0,0:11:39.65,0:11:42.32,Default,,0,0,0,,Бұл мүмкін емес, өйткені...
Dialogue: 0,0:11:42.41,0:11:45.08,Default,,0,0,0,,Сіз келінсіз бе?
Dialogue: 0,0:11:46.20,0:11:47.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:50.58,0:11:51.71,Default,,0,0,0,,Мекаке…
Dialogue: 0,0:11:52.33,0:11:54.38,Default,,0,0,0,,Мен туылғаннан кейін бірден
Dialogue: 0,0:11:55.00,0:11:57.88,Default,,0,0,0,,Мені анаммен бірге сол үйге кіргізді.
Dialogue: 0,0:11:57.96,0:12:01.63,Default,,0,0,0,,Маған мейірімді болған жалғыз әжем.
Dialogue: 0,0:12:02.38,0:12:03.93,Default,,0,0,0,,1994 жылдың наурызы
Dialogue: 0,0:12:04.01,0:12:06.64,Default,,0,0,0,,Мен көптен бері ауырып жүрмін.
Dialogue: 0,0:12:08.81,0:12:09.64,Default,,0,0,0,,Анам
Dialogue: 0,0:12:11.44,0:12:13.60,Default,,0,0,0,,Мен әрқашан саған қараймын
Dialogue: 0,0:12:13.69,0:12:14.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:15.48,0:12:16.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:17.40,0:12:18.40,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:21.49,0:12:24.66,Default,,0,0,0,,«Жақсы актер болыңыз.»
Dialogue: 0,0:12:25.57,0:12:28.79,Default,,0,0,0,,Осы соңғы сөздер ғана есімде.
Dialogue: 0,0:12:29.41,0:12:31.16,Default,,0,0,0,,Мен оны ұмыта алмаймын
Dialogue: 0,0:12:32.04,0:12:33.46,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:34.29,0:12:35.17,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:35.25,0:12:39.92,Default,,0,0,0,,Қазір мен сол мектепте музыка ойнап көңілді жүрмін.
Dialogue: 0,0:12:40.01,0:12:41.72,Default,,0,0,0,,Бірақ бұл қиын болды.
Dialogue: 0,0:12:41.80,0:12:42.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:43.38,0:12:45.64,Default,,0,0,0,,Мен осылай билегенше...
Dialogue: 0,0:12:45.72,0:12:50.35,Default,,0,0,0,,Кішкентай кезіңізден актер болу үшін көп еңбектендіңіз, солай емес пе?
Dialogue: 0,0:12:50.43,0:12:53.39,Default,,0,0,0,,Бұл жолды өзгерту тамаша шешім болды.
Dialogue: 0,0:12:53.48,0:12:55.48,Default,,0,0,0,,Бұл қиын емес пе?
Dialogue: 0,0:12:55.98,0:12:58.61,Default,,0,0,0,,Бірақ мен сыйлық ретінде таңдалдым
Dialogue: 0,0:12:58.69,0:13:01.03,Default,,0,0,0,,Музыка әлемінің қалауы
Dialogue: 0,0:13:01.61,0:13:04.40,Default,,0,0,0,,Қалау деген ғажап, солай емес пе?
Dialogue: 0,0:13:04.49,0:13:06.32,Default,,0,0,0,,Тіпті сен де
Dialogue: 0,0:13:07.95,0:13:12.41,Default,,0,0,0,,Бірақ біз сізге музыка жасауға кірісіңіз деп айта алмаймыз.
Dialogue: 0,0:13:14.71,0:13:17.92,Default,,0,0,0,,Өйткені сіздің жолыңызды шешуші сол
Dialogue: 0,0:13:19.04,0:13:20.38,Default,,0,0,0,,Тек сен
Dialogue: 0,0:13:23.42,0:13:26.43,Default,,0,0,0,,Тәкаппарлап айтып жатырсың.
Dialogue: 0,0:13:27.01,0:13:31.22,Default,,0,0,0,,Мен де актер болғаныма біраз өкіндім.
Dialogue: 0,0:13:31.72,0:13:34.06,Default,,0,0,0,,Мен оны жаруым керек
Dialogue: 0,0:13:34.77,0:13:38.15,Default,,0,0,0,,Иә, бұл әңгіменің соңы!
Dialogue: 0,0:13:38.23,0:13:40.40,Default,,0,0,0,,Күлімсіреп қолымыздан келгенін жасайық
Dialogue: 0,0:13:40.48,0:13:42.48,Default,,0,0,0,,Сізді таң қалдырады
Dialogue: 0,0:13:42.57,0:13:45.32,Default,,0,0,0,,Мен қиын өмір кешсем де.
Dialogue: 0,0:13:45.40,0:13:48.99,Default,,0,0,0,,Мен болсам, мені қорлаған жігітті жұдырықпен ұрып жіберуім мүмкін еді.
Dialogue: 0,0:13:49.07,0:13:52.45,Default,,0,0,0,,Мен ешкімді жек көрмеймін.
Dialogue: 0,0:13:52.54,0:13:55.41,Default,,0,0,0,,Өйткені адамдардың басқа адамдарды жек көруі ауыр.
Dialogue: 0,0:13:58.58,0:13:59.67,Default,,0,0,0,,Бұл тәтті емес пе?
Dialogue: 0,0:13:59.75,0:14:01.63,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:14:01.71,0:14:05.05,Default,,0,0,0,,Мен бәріңді шынымен жақсы көремін
Dialogue: 0,0:14:05.13,0:14:07.13,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:14:07.22,0:14:08.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:10.60,0:14:11.76,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:14:11.85,0:14:12.68,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:14:13.39,0:14:16.48,Default,,0,0,0,,Айтпақшы, ол үйге не үшін келдің?
Dialogue: 0,0:14:16.56,0:14:18.19,Default,,0,0,0,,Иә
Dialogue: 0,0:14:18.27,0:14:20.61,Default,,0,0,0,,Бенто дәмді болды.
Dialogue: 0,0:14:20.69,0:14:21.94,Default,,0,0,0,,Гочисусан
Dialogue: 0,0:14:22.02,0:14:23.69,Default,,0,0,0,,Мұны айту керек пе?
Dialogue: 0,0:14:23.78,0:14:24.73,Default,,0,0,0,,О
Dialogue: 0,0:14:24.82,0:14:28.28,Default,,0,0,0,,Рахмет десем де, көп нәрсе істемейді.
Dialogue: 0,0:14:28.36,0:14:30.95,Default,,0,0,0,,Егер менің қолымнан келетін нәрсе болса, маған хабарлаңыз.
Dialogue: 0,0:14:31.03,0:14:32.28,Default,,0,0,0,,Бұл сізге көмектеседі
Dialogue: 0,0:14:32.37,0:14:33.83,Default,,0,0,0,,Қуат?
Dialogue: 0,0:14:34.87,0:14:37.66,Default,,0,0,0,,Жарайды, мен сенен бір жақсылық сұрайын деп тұрмын.
Dialogue: 0,0:14:38.42,0:14:41.21,Default,,0,0,0,,(Қызметкерлер сөйлеседі)
Dialogue: 0,0:14:41.29,0:14:44.13,Default,,0,0,0,,Бен, мына жабдықты маған әкел.
Dialogue: 0,0:14:44.21,0:14:45.71,Default,,0,0,0,,Түсінді
Dialogue: 0,0:14:45.80,0:14:49.97,Default,,0,0,0,,Бұл пайдалы. Бізде жастар жетіспейді.
Dialogue: 0,0:14:50.05,0:14:52.47,Default,,0,0,0,,Ауыр жүкті маған қалдырыңыз.
Dialogue: 0,0:14:52.55,0:14:55.43,Default,,0,0,0,,Бен мырза? Сізде осындай бала болды ма?
Dialogue: 0,0:14:55.52,0:14:57.85,Default,,0,0,0,,Бұл сіздің достық пен ынтымақтастық, Лист мырза.
Dialogue: 0,0:14:58.60,0:15:01.35,Default,,0,0,0,,Мм... Уау.
Dialogue: 0,0:15:01.94,0:15:04.27,Default,,0,0,0,,Оның кезеңі...
Dialogue: 0,0:15:04.36,0:15:06.61,Default,,0,0,0,,Қызық, бұл қандай?
Dialogue: 0,0:15:06.69,0:15:08.86,Default,,0,0,0,,Не? Жоқ? (Бетховен) Иә?
Dialogue: 0,0:15:08.95,0:15:12.37,Default,,0,0,0,,Бұл желдеткіш болмаса, өндірісті өзгерту керек еді.
Dialogue: 0,0:15:12.45,0:15:14.66,Default,,0,0,0,,Бірақ уақыт...
Dialogue: 0,0:15:15.20,0:15:17.37,Default,,0,0,0,,Эй Бетховен (Бетховен)?
Dialogue: 0,0:15:18.54,0:15:22.79,Default,,0,0,0,,Кешіріңіз, сіз менің үйіме барып, маған желдеткіш ала аласыз ба?
Dialogue: 0,0:15:22.88,0:15:25.38,Default,,0,0,0,,Ол кезде желдеткіш қандай болды?
Dialogue: 0,0:15:25.46,0:15:27.88,Default,,0,0,0,,Иә, мен оны артқа тастадым.
Dialogue: 0,0:15:28.55,0:15:30.51,Default,,0,0,0,,Барсам екен...
Dialogue: 0,0:15:30.59,0:15:31.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:31.59,0:15:34.22,Default,,0,0,0,,Жарайды, мен бірден келемін.
Dialogue: 0,0:15:34.30,0:15:35.26,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:35.35,0:15:36.77,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,0:15:37.77,0:15:40.02,Default,,0,0,0,,Ал... Мен келдім.
Dialogue: 0,0:15:40.10,0:15:42.27,Default,,0,0,0,,Қызық, мені кіргізесіз бе?
Dialogue: 0,0:15:43.94,0:15:44.98,Default,,0,0,0,,Сіз тағы да?
Dialogue: 0,0:15:45.07,0:15:46.02,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:47.86,0:15:49.57,Default,,0,0,0,,Келесі күні
Dialogue: 0,0:15:49.65,0:15:53.03,Default,,0,0,0,,Сізге осындай нәрсені көрсеткенім үшін кешіріңіз.
Dialogue: 0,0:15:53.11,0:15:55.28,Default,,0,0,0,,Ах... (Ичиемон) Иә?
Dialogue: 0,0:15:55.37,0:16:00.04,Default,,0,0,0,,Ол да мен сияқты айтады, сондықтан әке мен баламыз деп ойлаймын...
Dialogue: 0,0:16:00.12,0:16:03.00,Default,,0,0,0,,Сіз менің әкем суық деп ойладыңыз, солай ма?
Dialogue: 0,0:16:03.08,0:16:03.96,Default,,0,0,0,,Иә
Dialogue: 0,0:16:04.04,0:16:06.54,Default,,0,0,0,,А, бұл... Кешіріңіз!
Dialogue: 0,0:16:06.63,0:16:10.63,Default,,0,0,0,,Мен араласу емес екенін білемін, бірақ
Dialogue: 0,0:16:10.72,0:16:13.05,Default,,0,0,0,,Менің ойымша, бұл тым қатал.
Dialogue: 0,0:16:13.13,0:16:15.43,Default,,0,0,0,,Басқа таңдау жоқ.
Dialogue: 0,0:16:15.51,0:16:19.68,Default,,0,0,0,,Мен сондай әлемде туылғандықтан,
Dialogue: 0,0:16:20.60,0:16:21.85,Default,,0,0,0,,Бірақ бұл басқаша.
Dialogue: 0,0:16:21.94,0:16:23.44,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:16:24.23,0:16:27.86,Default,,0,0,0,,Маған басқа мүмкіндік бар сияқты.
Dialogue: 0,0:16:27.94,0:16:31.44,Default,,0,0,0,,Мұнда емес. Басқа жолы бар.
Dialogue: 0,0:16:32.28,0:16:34.61,Default,,0,0,0,,Музыка сыйы...
Dialogue: 0,0:16:35.28,0:16:38.99,Default,,0,0,0,,Олай болса, біз бұл мүмкіндікті зерттеуіміз керек.
Dialogue: 0,0:16:39.08,0:16:41.20,Default,,0,0,0,,Үйге немесе өткенге кедергісіз
Dialogue: 0,0:16:41.96,0:16:44.46,Default,,0,0,0,,Ол жүруі керек жол
Dialogue: 0,0:16:46.29,0:16:50.76,Default,,0,0,0,,Содан кейін мен оған жолды зерттеуді айттым ...
Dialogue: 0,0:16:50.84,0:16:52.34,Default,,0,0,0,,Қазір барыңыз
Dialogue: 0,0:16:52.42,0:16:54.13,Default,,0,0,0,,Шоу басталатын уақыт болуы керек.
Dialogue: 0,0:16:54.22,0:16:55.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:58.76,0:16:59.60,Default,,0,0,0,,Ағай!
Dialogue: 0,0:17:00.93,0:17:04.85,Default,,0,0,0,,Ол сені де, өзгені де жек көрмейді.
Dialogue: 0,0:17:06.44,0:17:09.07,Default,,0,0,0,,Әлгі жігіт сондай мейірімді.
Dialogue: 0,0:17:09.15,0:17:11.57,Default,,0,0,0,,Оның үстіне мен қолымнан келгеннің бәрін жасап жатырмын!
Dialogue: 0,0:17:15.16,0:17:17.24,Default,,0,0,0,,Сен жақсы доссың.
Dialogue: 0,0:17:21.20,0:17:22.33,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:17:22.83,0:17:26.25,Default,,0,0,0,,Не... Бұл қандай сезім?
Dialogue: 0,0:17:26.33,0:17:29.50,Default,,0,0,0,,Қарт екеуі өз жолымен келе жатты.
Dialogue: 0,0:17:29.59,0:17:31.34,Default,,0,0,0,,Керемет емес пе!
Dialogue: 0,0:17:32.09,0:17:33.34,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:17:33.97,0:17:35.34,Default,,0,0,0,,Мен ЖоЖомен шайқасуға оралдым!
Dialogue: 0,0:17:40.47,0:17:45.10,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:17:52.07,0:17:56.11,Default,,0,0,0,,♪ Жыныстың эфемерлі иісіне
Dialogue: 0,0:17:56.20,0:18:04.50,Default,,0,0,0,,♪ Бүгін түнде армандармен ойнайық
Dialogue: 0,0:18:20.09,0:18:24.02,Default,,0,0,0,,♪ Толқып билеу
Dialogue: 0,0:18:24.10,0:18:27.14,Default,,0,0,0,,♪ Агеха биі сияқты
Dialogue: 0,0:18:27.23,0:18:30.90,Default,,0,0,0,,♪ Қанаттың тәтті үнінен мазасызданған...
Dialogue: 0,0:18:30.98,0:18:34.90,Default,,0,0,0,,♪ Ай сәулесінде сайрап
Dialogue: 0,0:18:34.98,0:18:38.40,Default,,0,0,0,,♪ Күміс өзенде қайық жүзу
Dialogue: 0,0:18:38.49,0:18:42.03,Default,,0,0,0,,♪ Жұлдыздармен ойнау
Dialogue: 0,0:18:42.12,0:18:46.04,Default,,0,0,0,,♪ Саусақтарыңызда қалған жарықты сұраңыз
Dialogue: 0,0:18:46.12,0:18:49.79,Default,,0,0,0,,♪ Ертең қайда
Dialogue: 0,0:18:49.87,0:18:54.00,Default,,0,0,0,,♪ Жауап алыс және ауыр
Dialogue: 0,0:18:54.09,0:18:57.80,Default,,0,0,0,,♪ Көбіктенген түнгі аспанға
Dialogue: 0,0:18:57.88,0:18:59.34,Default,,0,0,0,,♪ Жылау...
Dialogue: 0,0:18:59.43,0:19:03.14,Default,,0,0,0,,♪ Жоғалу...
Dialogue: 0,0:19:03.22,0:19:06.68,Default,,0,0,0,,♪ Ғашық болып қыдырайық
Dialogue: 0,0:19:06.77,0:19:10.48,Default,,0,0,0,,♪ Өтінемін, ұмыту шегінен асып кетіңіз
Dialogue: 0,0:19:10.56,0:19:14.44,Default,,0,0,0,,♪ Шие гүліндей шашылып
Dialogue: 0,0:19:14.52,0:19:18.11,Default,,0,0,0,,♪ Әнге
Dialogue: 0,0:19:18.19,0:19:22.57,Default,,0,0,0,,♪ Мені аяғына дейін құшақтап ал
Dialogue: 0,0:19:22.66,0:19:27.70,Default,,0,0,0,,♪ Қанаттың тәтті үнінен мазасызданған...
Dialogue: 0,0:19:27.79,0:19:37.84,Default,,0,0,0,,♪ Әй, жүрексіз күй
Dialogue: 0,0:19:40.59,0:19:44.47,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:19:46.56,0:19:50.48,Default,,0,0,0,,Қалаулы бол, талантыңды көрсет және мақтан...
Dialogue: 0,0:19:51.69,0:19:55.48,Default,,0,0,0,,Ешкімді жолатпайтын өз гүл жолыммен келе жатырмын.
Dialogue: 0,0:19:56.52,0:19:58.48,Default,,0,0,0,,Менің де сонда барғым келеді
Dialogue: 0,0:19:58.57,0:20:02.28,Default,,0,0,0,,Көрермендерді менің құмарлығыммен эмоционалды етіңіз
Dialogue: 0,0:20:02.36,0:20:04.49,Default,,0,0,0,,Мен... Менмін!
Dialogue: 0,0:20:06.45,0:20:08.70,Default,,0,0,0,,Ах… Хмпф
Dialogue: 0,0:20:09.70,0:20:11.62,Default,,0,0,0,,Менің де ән айтқым келеді (Бетховен) Ах...
Dialogue: 0,0:20:13.00,0:20:14.38,Default,,0,0,0,,Сіздің керемет көздеріңіз бар ма?
Dialogue: 0,0:20:19.42,0:20:20.76,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:20:27.35,0:20:31.52,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:20:31.60,0:20:34.52,Default,,0,0,0,,Ән айтқым келеді... Мен де солай ойладым.
Dialogue: 0,0:20:35.19,0:20:37.52,Default,,0,0,0,,Сахнаға шығып ән айтқым келеді
Dialogue: 0,0:20:38.23,0:20:39.53,Default,,0,0,0,,Бірақ бұл сезім
Dialogue: 0,0:20:40.49,0:20:42.53,Default,,0,0,0,,Бұл сыйлық сияқты ма?
Dialogue: 0,0:20:43.49,0:20:44.74,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:45.62,0:20:48.53,Default,,0,0,0,,Мен мұны істеуім керек деп ойладым.
Dialogue: 0,0:20:49.29,0:20:51.04,Default,,0,0,0,,Дәл солар сияқты
Dialogue: 0,0:20:51.70,0:20:54.54,Default,,0,0,0,,Мен де солар сияқтымын
Dialogue: 0,0:20:57.46,0:20:59.05,Default,,0,0,0,,Сол жерде!
Dialogue: 0,0:21:05.39,0:21:08.10,Default,,0,0,0,,Матч алдында бірдей сезім
Dialogue: 0,0:21:08.18,0:21:13.31,Default,,0,0,0,,Мен қызуымды сезінуден бас тартпақшы болдым...
Dialogue: 0,0:21:13.39,0:21:15.60,Default,,0,0,0,,Хаха...
Dialogue: 0,0:21:16.52,0:21:17.65,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:21:21.86,0:21:23.44,Default,,0,0,0,,Бүгін де солай.
Dialogue: 0,0:21:23.53,0:21:27.03,Default,,0,0,0,,Біз Бетховенді шақыру миссиясын бастаймыз.
Dialogue: 0,0:21:27.12,0:21:28.91,Default,,0,0,0,,Оны өзі шешеді.
Dialogue: 0,0:21:28.99,0:21:32.12,Default,,0,0,0,,Менің ойымша, қолмен тоқылған жемпір стратегиясы да мүмкін.
Dialogue: 0,0:21:32.20,0:21:34.96,Default,,0,0,0,,Әрбір тігіс, оған деген сезіміммен
Dialogue: 0,0:21:35.04,0:21:36.75,Default,,0,0,0,,ауыр ауыр ауыр
Dialogue: 0,0:21:36.83,0:21:38.29,Default,,0,0,0,,Ол ешқашан келмейді
Dialogue: 0,0:21:39.67,0:21:40.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:40.75,0:21:42.67,Default,,0,0,0,,Не болды... А?
Dialogue: 0,0:21:42.76,0:21:43.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:48.09,0:21:49.47,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:21:49.55,0:21:50.97,Default,,0,0,0,,Биыл ғана дебют жасаған –
Dialogue: 0,0:21:52.68,0:21:54.23,Default,,0,0,0,,Мен де ән айтамын!
Dialogue: 0,0:21:55.02,0:21:59.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:20.02,0:23:24.94,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.99,0:23:39.62,Default,,0,0,0,,Келесі жолы «Қор, ән айт және жаса»
Dialogue: 0,0:23:41.12,0:23:47.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory