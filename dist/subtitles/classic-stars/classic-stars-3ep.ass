Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.45,0:00:04.46,Default,,0,0,0,,Ватару!
Dialogue: 0,0:00:26.40,0:00:27.65,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:00:27.73,0:00:30.03,Default,,0,0,0,,Шаршадыңыз ба? Сіз бін нәрсе ішкіңіз келеді ме?
Dialogue: 0,0:00:30.11,0:00:32.49,Default,,0,0,0,,Кешіріңіз, мен ройбо шайын ішейін.
Dialogue: 0,0:00:32.57,0:00:34.32,Default,,0,0,0,,Қара кофе
Dialogue: 0,0:00:35.28,0:00:36.12,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:00:36.20,0:00:38.33,Default,,0,0,0,,Тигуаньин шайы! Апыр-ай!
Dialogue: 0,0:00:40.24,0:00:41.62,Default,,0,0,0,,Бүгін де сізге Бетховен.
Dialogue: 0,0:00:41.70,0:00:43.33,Default,,0,0,0,,Ол қашып кетті.
Dialogue: 0,0:00:43.41,0:00:46.54,Default,,0,0,0,,Мен күткенмін, бірақ бұл қиын.
Dialogue: 0,0:00:46.63,0:00:49.75,Default,,0,0,0,,Егер адам мұны істегісі келмесе, оған көмектесу мүмкін емес.
Dialogue: 0,0:00:49.84,0:00:51.88,Default,,0,0,0,,Мен біліктілігім бар деп ойладым.
Dialogue: 0,0:00:51.96,0:00:53.22,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:00:53.92,0:00:57.30,Default,,0,0,0,,Сәйкес келетіндер оны міндетті түрде пайдалана алмады.\NБұл
Dialogue: 0,0:00:57.39,0:00:59.39,Default,,0,0,0,,жағдай.
Dialogue: 0,0:00:59.47,0:01:00.85,Default,,0,0,0,,Бұл дәл өткен жолымен бірдей, кішкентай сорлы!
Dialogue: 0,0:01:00.93,0:01:03.35,Default,,0,0,0,,Мектеп таңдау қатесі
Dialogue: 0,0:01:03.43,0:01:07.10,Default,,0,0,0,,Мен осындай қарама-қайшы адаммен жұптассам да, нәтижесін көремін.
Dialogue: 0,0:01:07.19,0:01:10.61,Default,,0,0,0,,Бұл мүлдем мағынасыз, мағынасыз және абайсыз болды.
Dialogue: 0,0:01:10.69,0:01:12.49,Default,,0,0,0,,Бұл дәл өткен жолымен бірдей, кішкентай сорлы!
Dialogue: 0,0:01:12.57,0:01:13.69,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:01:13.69,0:01:14.45,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:01:13.69,0:01:14.45,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:14.45,0:01:14.53,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:14.53,0:01:15.57,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:14.53,0:01:15.57,Default,,0,0,0,,Я...
Dialogue: 0,0:01:20.45,0:01:22.20,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:01:33.51,0:01:37.30,Default,,0,0,0,,Толқу, қуаныш, шаттық...
Dialogue: 0,0:01:37.93,0:01:40.30,Default,,0,0,0,,Әртүрлі жағымды эмоциялар талданады
Dialogue: 0,0:01:40.39,0:01:42.72,Default,,0,0,0,,Дүние деректерге айналды
Dialogue: 0,0:01:43.56,0:01:47.10,Default,,0,0,0,,Музыка, өнер, спорт және т.б. Барлық салада
Dialogue: 0,0:01:47.19,0:01:50.65,Default,,0,0,0,,Өрнек күші арнайы құрылғы арқылы жүзеге асты.
Dialogue: 0,0:01:50.73,0:01:52.61,Default,,0,0,0,,Бұл эмоция…
Dialogue: 0,0:01:52.69,0:01:56.82,Default,,0,0,0,,Бұл эмоционалды көрініс деп аталады және ол адамдарды толғандырады.
Dialogue: 0,0:01:59.49,0:02:02.70,Default,,0,0,0,,Күшті және эмоционалдырақ
Dialogue: 0,0:02:02.79,0:02:06.46,Default,,0,0,0,,Дүние ережелері Күштілердің анықтамасы өзгерді
Dialogue: 0,0:02:06.54,0:02:09.46,Default,,0,0,0,,Ұлттар арасындағы күрестің кері және ақымақтық тәсілдері
Dialogue: 0,0:02:09.54,0:02:13.50,Default,,0,0,0,,Өркениетті және бейбіт шешімдерге көшу
Dialogue: 0,0:02:15.30,0:02:17.26,Default,,0,0,0,,Эмоциялық мәдениеттің қайнар көзі ретінде
Dialogue: 0,0:02:17.34,0:02:21.51,Default,,0,0,0,,Хараджуку, Жапония үкіметі жаңадан ашқан академиялық қала
Dialogue: 0,0:02:22.30,0:02:26.39,Default,,0,0,0,,Орталықта жеке Глория академиясы орналасқан.
Dialogue: 0,0:02:29.02,0:02:32.98,Default,,0,0,0,,♪～
Dialogue: 0,0:03:54.94,0:03:58.94,Default,,0,0,0,,～♪
Dialogue: 0,0:04:03.82,0:04:05.12,Default,,0,0,0,,Иә
Dialogue: 0,0:04:05.20,0:04:07.08,Default,,0,0,0,,Ол таңнан бері ренжіді.
Dialogue: 0,0:04:07.16,0:04:08.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:09.04,0:04:10.91,Default,,0,0,0,,Бұл не, балалар?
Dialogue: 0,0:04:11.00,0:04:12.41,Default,,0,0,0,,Таң~
Dialogue: 0,0:04:12.50,0:04:15.46,Default,,0,0,0,,Не болды? Менің жүрегім бұл жерде жоқ сияқты
Dialogue: 0,0:04:15.54,0:04:17.46,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:04:17.54,0:04:20.92,Default,,0,0,0,,Иә, маңызды емес.
Dialogue: 0,0:04:21.01,0:04:23.26,Default,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:04:23.34,0:04:25.05,Default,,0,0,0,,Барымызды бірге жасайық~
Dialogue: 0,0:04:28.14,0:04:31.31,Default,,0,0,0,,Сіз барынша тырысасыз ба? Бұл бірінші кезеңдегі PE ма?
Dialogue: 0,0:04:31.39,0:04:33.48,Default,,0,0,0,,А... Әй, жақсы екеніңізге сенімдісіз бе?
Dialogue: 0,0:04:33.56,0:04:36.77,Default,,0,0,0,,Не? Бүгін мектепте тестілеу бар.
Dialogue: 0,0:04:36.86,0:04:37.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:37.82,0:04:39.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:39.82,0:04:42.24,Default,,0,0,0,,Ах... (Моцарт) Иә
Dialogue: 0,0:04:42.32,0:04:44.49,Default,,0,0,0,,О, ау!
Dialogue: 0,0:04:44.57,0:04:47.66,Default,,0,0,0,,Тест бүгін басталатынын неге айтпадың?
Dialogue: 0,0:04:47.74,0:04:49.62,Default,,0,0,0,,Олар маған бір бөлмеде екендерін айтты...
Dialogue: 0,0:04:49.70,0:04:52.16,Default,,0,0,0,,Қалтаңда жүрген сен едің.
Dialogue: 0,0:04:52.25,0:04:54.46,Default,,0,0,0,,Жауапкершілікті өз мойнына алу тітіркендіргіш.
Dialogue: 0,0:04:54.54,0:04:56.46,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:57.92,0:04:59.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:57.92,0:04:59.09,Default,,0,0,0,,Бұл қиын болды, Бетховен.
Dialogue: 0,0:04:59.09,0:05:00.09,Default,,0,0,0,,Бұл қиын болды, Бетховен.
Dialogue: 0,0:05:00.17,0:05:02.55,Default,,0,0,0,,Ми... Михараки мырза
Dialogue: 0,0:05:02.63,0:05:05.05,Default,,0,0,0,,Әй, қалай болды?
Dialogue: 0,0:05:05.13,0:05:07.34,Default,,0,0,0,,Бірақ білесің бе, өздері қиын жағдайда болса да—
Dialogue: 0,0:05:07.43,0:05:09.18,Default,,0,0,0,,Мен қолымнан келгенін жасадым, бірақ
Dialogue: 0,0:05:09.26,0:05:13.52,Default,,0,0,0,,Жаңа піскен шыбықтың нәтижесін жасырып айтайын ба?
Dialogue: 0,0:05:13.60,0:05:14.89,Default,,0,0,0,,О, жақсы ма?
Dialogue: 0,0:05:14.98,0:05:16.85,Default,,0,0,0,,Сондай-ақ, бұл мұғалім...
Dialogue: 0,0:05:16.94,0:05:21.57,Default,,0,0,0,,Мен классика, жапон тарихы, математика және биология пәндерінен 80 ұпай алдым.
Dialogue: 0,0:05:21.65,0:05:23.28,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:05:23.36,0:05:24.53,Default,,0,0,0,,4 пән біріктірілген
Dialogue: 0,0:05:24.61,0:05:26.45,Default,,0,0,0,,Гах! О...
Dialogue: 0,0:05:26.53,0:05:27.61,Default,,0,0,0,,Бұл шіркін
Dialogue: 0,0:05:27.70,0:05:29.49,Default,,0,0,0,,Қарғыс атсын... Қолымнан келмейді.
Dialogue: 0,0:05:29.58,0:05:30.83,Default,,0,0,0,,Көп нәрсе болып жатыр.
Dialogue: 0,0:05:30.91,0:05:32.87,Default,,0,0,0,,Сондықтан қызыл нүкте...
Dialogue: 0,0:05:32.95,0:05:35.12,Default,,0,0,0,,Музыка бөлімінде ерекше тәртіп бар.
Dialogue: 0,0:05:35.21,0:05:38.58,Default,,0,0,0,,Мектептегі ең төменгі тапсырманы орындамасаңыз, оқудан шығарыласыз, солай ма?
Dialogue: 0,0:05:38.67,0:05:40.59,Default,,0,0,0,,Мен жаңа ғана келдім.
Dialogue: 0,0:05:40.67,0:05:44.76,Default,,0,0,0,,Осы кезде біреуден үйреніп, бар күшіңізді салудан басқа амалыңыз жоқ.
Dialogue: 0,0:05:44.84,0:05:46.84,Default,,0,0,0,,Кім десең де...
Dialogue: 0,0:05:46.93,0:05:48.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:48.97,0:05:49.80,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:49.89,0:05:51.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:51.43,0:05:53.81,Default,,0,0,0,,Иә! Шопен маған ұнайсың
Dialogue: 0,0:05:53.89,0:05:54.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:54.68,0:05:55.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:54.68,0:05:55.23,Default,,0,0,0,,Чочо Чочо!
Dialogue: 0,0:05:55.23,0:05:55.60,Default,,0,0,0,,Чочо Чочо!
Dialogue: 0,0:05:55.68,0:05:57.14,Default,,0,0,0,,Бұл жігіт бірінші курс студенті!
Dialogue: 0,0:05:57.23,0:05:58.48,Default,,0,0,0,,Сен болсаң, баяғыда болар еді.
Dialogue: 0,0:05:58.56,0:06:00.86,Default,,0,0,0,,Сіз 2-сынып оқулығын оқып бітірдіңіз, солай ма?
Dialogue: 0,0:06:00.94,0:06:02.69,Default,,0,0,0,,Лауазымы бойынша мұғалім сабақ берсе
Dialogue: 0,0:06:02.78,0:06:05.19,Default,,0,0,0,,Мен оны басқа оқушыларға көрсете алмаймын.
Dialogue: 0,0:06:05.28,0:06:06.90,Default,,0,0,0,,Сәлем! Сол себепті...
Dialogue: 0,0:06:06.99,0:06:09.53,Default,,0,0,0,,Дәл солай, мұғалім, мен жерге тізерлеп отырамын.
Dialogue: 0,0:06:09.62,0:06:12.70,Default,,0,0,0,,А, сеппуку жақсы ма? Бұл ауыр көрінеді, бірақ мен бар күшімді саламын.
Dialogue: 0,0:06:12.79,0:06:14.16,Default,,0,0,0,,Адамдардың айтқанын тыңда!
Dialogue: 0,0:06:14.24,0:06:16.71,Default,,0,0,0,,Мен оны кесіп тастаймын. Мен оны шынымен кесіп тастаймын.
Dialogue: 0,0:06:16.79,0:06:19.12,Default,,0,0,0,,Қара жағыңды көрсетсең де
Dialogue: 0,0:06:20.58,0:06:22.38,Default,,0,0,0,,Менің уақытымды пайдаланғыңыз келсе
Dialogue: 0,0:06:22.46,0:06:24.76,Default,,0,0,0,,Сіз белгілі бір мөлшерде өтемақы аласыз, солай ма?
Dialogue: 0,0:06:24.84,0:06:27.17,Default,,0,0,0,,А... бағасы қанша?
Dialogue: 0,0:06:27.26,0:06:28.84,Default,,0,0,0,,Әрине төлеймін.
Dialogue: 0,0:06:28.93,0:06:31.22,Default,,0,0,0,,Оны пайдаланудан тартынбаңыз.
Dialogue: 0,0:06:31.30,0:06:32.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:32.35,0:06:35.14,Default,,0,0,0,,Мен алданып қалдым
Dialogue: 0,0:06:37.60,0:06:39.19,Default,,0,0,0,,Сайыстың алдын ала кезеңі аяқталды.
Dialogue: 0,0:06:39.27,0:06:42.82,Default,,0,0,0,,бастайық. Шопен қандай шыңды көздеп отыр?
Dialogue: 0,0:06:42.90,0:06:44.19,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:44.27,0:06:48.20,Default,,0,0,0,,Біреуді тыңдайтын немесе шабыттандыратын адамға көмектесу
Dialogue: 0,0:06:48.28,0:06:49.61,Default,,0,0,0,,Мен де солай ән айта алғым келеді
Dialogue: 0,0:06:49.61,0:06:50.78,Default,,0,0,0,,Мен де солай ән айта алғым келеді.
Dialogue: 0,0:06:49.61,0:06:50.78,Default,,0,0,0,,(Бетховеннің есінеу)
Dialogue: 0,0:06:50.78,0:06:52.07,Default,,0,0,0,,(Бетховеннің есінеу)
Dialogue: 0,0:06:53.78,0:06:55.41,Default,,0,0,0,,Мен шөлдеп тұрмын
Dialogue: 0,0:06:55.49,0:06:57.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:57.08,0:06:59.87,Default,,0,0,0,,Тұруды тоқтатып, маған сусын сатып ал.
Dialogue: 0,0:06:59.96,0:07:01.54,Default,,0,0,0,,Үзілістер қысқа.
Dialogue: 0,0:07:01.63,0:07:03.50,Default,,0,0,0,,Ааа
Dialogue: 0,0:07:04.96,0:07:06.38,Default,,0,0,0,,Мен оны сатып алдым!
Dialogue: 0,0:07:06.46,0:07:07.88,Default,,0,0,0,,Хаха...
Dialogue: 0,0:07:07.97,0:07:10.55,Default,,0,0,0,,Жасмин шайын ішкім келді.
Dialogue: 0,0:07:10.63,0:07:11.84,Default,,0,0,0,,Алдымен айтыңыз!
Dialogue: 0,0:07:11.93,0:07:13.89,Default,,0,0,0,,Жарайды, мен оны ұстап тұрып ішемін.
Dialogue: 0,0:07:13.97,0:07:15.89,Default,,0,0,0,,Мен оны Dash-тен сатып аламын, күте тұрыңыз!
Dialogue: 0,0:07:17.47,0:07:18.60,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:07:18.68,0:07:20.89,Default,,0,0,0,,Жақсы, егер шынымен қаласаңыз
Dialogue: 0,0:07:20.98,0:07:23.77,Default,,0,0,0,,Біреу маған шайдың көңілін көтермейді десе
Dialogue: 0,0:07:23.86,0:07:25.48,Default,,0,0,0,,Мен шыдай алмаймын!
Dialogue: 0,0:07:26.82,0:07:28.86,Default,,0,0,0,,Бұл, әрине, қолөнер шайы.
Dialogue: 0,0:07:28.94,0:07:30.20,Default,,0,0,0,,Өзімшіл!
Dialogue: 0,0:07:30.28,0:07:32.41,Default,,0,0,0,,Хааа~
Dialogue: 0,0:07:32.49,0:07:35.83,Default,,0,0,0,,Қош келдіңіз, біз сізді күттік.
Dialogue: 0,0:07:35.91,0:07:37.29,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:37.37,0:07:39.33,Default,,0,0,0,,Менің сұрағанымды орындай аласың ба?
Dialogue: 0,0:07:39.41,0:07:41.04,Default,,0,0,0,,Мен таққа таласудан шығып қалдым. Енді бәрі бітті.
Dialogue: 0,0:07:41.12,0:07:43.42,Default,,0,0,0,,Оны айна алдында көргіңіз келе ме?
Dialogue: 0,0:07:43.50,0:07:47.55,Default,,0,0,0,,Жоқ, мен сенің қолың үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:07:47.63,0:07:49.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:50.51,0:07:52.30,Default,,0,0,0,,Бұл жаңа жұмыс па?
Dialogue: 0,0:07:52.38,0:07:54.68,Default,,0,0,0,,Иә, ол жаңа ғана келді.
Dialogue: 0,0:07:55.47,0:07:56.85,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:07:56.93,0:07:59.31,Default,,0,0,0,,Мен барлық түстерді ала аламын ба?
Dialogue: 0,0:07:59.39,0:08:00.85,Default,,0,0,0,,Иә? Мұның бәрі?
Dialogue: 0,0:08:00.93,0:08:04.73,Default,,0,0,0,,А, у... бұл біраз жүк.
Dialogue: 0,0:08:05.31,0:08:07.07,Default,,0,0,0,,(Браффорд) Лорд Дио маған өмір сыйлады—
Dialogue: 0,0:08:07.15,0:08:07.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:12.32,0:08:14.74,Default,,0,0,0,,А...
Dialogue: 0,0:08:15.32,0:08:17.12,Default,,0,0,0,,Иә
Dialogue: 0,0:08:18.33,0:08:20.91,Default,,0,0,0,,Келесі - жаңалықтар.
Dialogue: 0,0:08:21.00,0:08:22.41,Default,,0,0,0,,Ол әлі де бар ма?
Dialogue: 0,0:08:22.50,0:08:23.75,Default,,0,0,0,,Аа, дұрыс (Бетховен) Уау...
Dialogue: 0,0:08:24.46,0:08:27.88,Default,,0,0,0,,Студенттік кеңес бөлмесінде менің диванымды алғыңыз келді, солай ма?
Dialogue: 0,0:08:27.96,0:08:29.46,Default,,0,0,0,,Тек дұрыс мүмкіндік
Dialogue: 0,0:08:29.55,0:08:31.76,Default,,0,0,0,,Сұхбат аяқталмай тұрып іздеңіз.
Dialogue: 0,0:08:31.84,0:08:33.01,Default,,0,0,0,,Нану?
Dialogue: 0,0:08:33.63,0:08:34.72,Default,,0,0,0,,Мен де істеймін
Dialogue: 0,0:08:34.80,0:08:37.89,Default,,0,0,0,,Сабырлы оқуды үйреткім келеді.
Dialogue: 0,0:08:37.97,0:08:40.77,Default,,0,0,0,,Ал... Меніңше, олай емес.
Dialogue: 0,0:08:41.35,0:08:44.90,Default,,0,0,0,,Маған арқалығы ұзын, қолтығы жоқ адам ұнайды.
Dialogue: 0,0:08:44.98,0:08:46.27,Default,,0,0,0,,Өзімшіл!
Dialogue: 0,0:08:47.73,0:08:49.40,Default,,0,0,0,,Жеке Глория академиясы
Dialogue: 0,0:08:49.48,0:08:53.03,Default,,0,0,0,,Көңіл көтеруге жауап беретін келесі ұрпақты оқыту жүйесі бар.
Dialogue: 0,0:08:53.11,0:08:57.07,Default,,0,0,0,,Көңіл көтеруде, спортта және өнерде ерекшеленетіндерді таңдаңыз.
Dialogue: 0,0:08:57.16,0:08:58.49,Default,,0,0,0,,Сабақтан босату және т.б.
Dialogue: 0,0:08:58.58,0:09:00.79,Default,,0,0,0,,Үздік университеттер мен компанияларға ұсыныстар...
Dialogue: 0,0:09:02.87,0:09:05.29,Default,,0,0,0,,Ах~
Dialogue: 0,0:09:05.37,0:09:09.00,Default,,0,0,0,,Бүгінгі мен аяқталды...
Dialogue: 0,0:09:09.09,0:09:10.80,Default,,0,0,0,,Бастайық.
Dialogue: 0,0:09:10.88,0:09:13.05,Default,,0,0,0,,Сен қаталсың.
Dialogue: 0,0:09:13.92,0:09:15.80,Default,,0,0,0,,Сіз оқудан шығарылғыңыз келмейді, солай ма?
Dialogue: 0,0:09:15.88,0:09:17.14,Default,,0,0,0,,О
Dialogue: 0,0:09:17.22,0:09:19.22,Default,,0,0,0,,Сіз бағаны төледіңіз
Dialogue: 0,0:09:19.30,0:09:20.97,Default,,0,0,0,,Мен сізге бұл үшін өтеуім керек.
Dialogue: 0,0:09:21.06,0:09:22.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:22.93,0:09:24.27,Default,,0,0,0,,Қалған үш пән
Dialogue: 0,0:09:24.35,0:09:26.90,Default,,0,0,0,,Мен сенің көп еңбек еткеніңді қалаймын, сондықтан менің ниетім осы.
Dialogue: 0,0:09:26.98,0:09:27.81,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:28.44,0:09:31.32,Default,,0,0,0,,Сізді оқудан шығарғыңыз келмейді, солай ма?
Dialogue: 0,0:09:31.40,0:09:33.61,Default,,0,0,0,,Эй, эй, мен білемін.
Dialogue: 0,0:09:33.69,0:09:35.78,Default,,0,0,0,,Оқытудың көзқарасы солай ма?
Dialogue: 0,0:09:35.86,0:09:38.12,Default,,0,0,0,,Мұғалім, өтінемін.
Dialogue: 0,0:09:38.20,0:09:39.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:52.05,0:09:55.97,Default,,0,0,0,,Ол бір қызбен бірге еді.
Dialogue: 0,0:10:06.56,0:10:08.73,Default,,0,0,0,,Сізде басқа жаққа қарауға көп мүмкіндік бар.
Dialogue: 0,0:10:08.81,0:10:10.65,Default,,0,0,0,,Мен... бұл жаман.
Dialogue: 0,0:10:11.32,0:10:14.15,Default,,0,0,0,,«Тірі заттардың эволюциясы мен тегі»
Dialogue: 0,0:10:14.23,0:10:17.32,Default,,0,0,0,,«Палеозой дәуірінің басым түрлері қандай?»
Dialogue: 0,0:10:17.40,0:10:21.49,Default,,0,0,0,,Омыртқасыздар мен балықтар...
Dialogue: 0,0:10:21.58,0:10:25.08,Default,,0,0,0,,Бұл мәселе бастауыш сыныптың суретті кітаптарында да кездеседі.
Dialogue: 0,0:10:25.16,0:10:27.00,Default,,0,0,0,,Шулы! Хмм...
Dialogue: 0,0:10:27.08,0:10:29.58,Default,,0,0,0,,Сіз суретті кітапқа қарап тұрсыз ба?
Dialogue: 0,0:10:29.67,0:10:33.00,Default,,0,0,0,,Дарвиннің эволюциялық ілімінен тек табиғи сұрыптауды жақтайды.
Dialogue: 0,0:10:33.09,0:10:35.30,Default,,0,0,0,,Тұқым қуалаушылыққа қатысты мутация теориясын қайта қарап, алынған белгілердің тұқым қуалауын жоққа шығарды.
Dialogue: 0,0:10:35.30,0:10:36.34,Default,,0,0,0,,Тұқым қуалаудың мутациялық теориясын қайта қарап, жүре пайда болған белгілердің тұқым қуалауын жоққа шығарды.
Dialogue: 0,0:10:35.30,0:10:36.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:36.34,0:10:37.34,Default,,0,0,0,,Тұқым қуалаушылыққа қатысты мутация теориясын өзгертті және алынған белгілердің тұқым қуалауын жоққа шығарды.
Dialogue: 0,0:10:37.42,0:10:38.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:37.42,0:10:38.63,Default,,0,0,0,,Неміс зоологтарының неодарвинизмі туралы
Dialogue: 0,0:10:38.63,0:10:39.30,Default,,0,0,0,,Неміс зоологтарының неодарвинизмі туралы
Dialogue: 0,0:10:39.30,0:10:40.72,Default,,0,0,0,,Неміс зоологтарының неодарвинизмі туралы
Dialogue: 0,0:10:39.30,0:10:40.72,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:40.72,0:10:41.35,Default,,0,0,0,,Неміс зоологтарының неодарвинизмі туралы
Dialogue: 0,0:10:41.43,0:10:43.10,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:10:43.18,0:10:44.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:46.39,0:10:48.23,Default,,0,0,0,,Ертең менің тікелей эфирім бар.
Dialogue: 0,0:10:48.31,0:10:50.02,Default,,0,0,0,,Бар күшіңізді салуды жалғастырыңыз.
Dialogue: 0,0:10:50.10,0:10:51.61,Default,,0,0,0,,Ертең?
Dialogue: 0,0:10:51.69,0:10:53.48,Default,,0,0,0,,О, мм...
Dialogue: 0,0:10:53.57,0:10:55.44,Default,,0,0,0,,Сізге қажет нәрсе бар ма?
Dialogue: 0,0:10:55.53,0:10:57.82,Default,,0,0,0,,Біраз кешке
Dialogue: 0,0:10:57.90,0:11:00.45,Default,,0,0,0,,Жанды орындау түнде басталады, сондықтан бұл проблема емес.
Dialogue: 0,0:11:00.53,0:11:04.33,Default,,0,0,0,,Мм... Түсінікті.
Dialogue: 0,0:11:04.41,0:11:06.12,Default,,0,0,0,,Ол бір қызбен бірге еді.
Dialogue: 0,0:11:06.20,0:11:07.33,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:11:15.17,0:11:18.17,Default,,0,0,0,,Дәл қазір маған қызғанышпен қарадың.
Dialogue: 0,0:11:18.67,0:11:24.81,Default,,0,0,0,,Әй, денеңді барынша қимылдатып, терле... Жақсы.
Dialogue: 0,0:11:24.89,0:11:28.06,Default,,0,0,0,,Ха, мен оны түсіну қиынға соғады.
Dialogue: 0,0:11:28.14,0:11:29.85,Default,,0,0,0,,Сізге және олар үшін
Dialogue: 0,0:11:29.94,0:11:31.35,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:31.44,0:11:33.94,Default,,0,0,0,,Сіз де, олар да музыка мамандығы бойынша болса да.
Dialogue: 0,0:11:34.02,0:11:36.53,Default,,0,0,0,,Бұл энергияны мағынасыз пайдалану.
Dialogue: 0,0:11:36.61,0:11:38.24,Default,,0,0,0,,Сіз осылай айтасыз...
Dialogue: 0,0:11:38.32,0:11:41.36,Default,,0,0,0,,Сіз жай ғана денеңізді қозғалтып, көңіл көтеруді ұнатасыз, солай ма?
Dialogue: 0,0:11:41.45,0:11:43.41,Default,,0,0,0,,Мен айттым ғой, солай ма?
Dialogue: 0,0:11:43.49,0:11:47.58,Default,,0,0,0,,Бұл ойын-сауықтың келесі ұрпағын тәрбиелеу мектебі.
Dialogue: 0,0:11:47.66,0:11:50.87,Default,,0,0,0,,Маған спортшы болу сыйы берілген жоқ.
Dialogue: 0,0:11:50.96,0:11:52.75,Default,,0,0,0,,Мүлдем мағынасыз
Dialogue: 0,0:11:52.83,0:11:54.92,Default,,0,0,0,,Эволюцияның қазынасы, асыл сыйы.
Dialogue: 0,0:11:55.00,0:11:56.71,Default,,0,0,0,,Берілгенімен
Dialogue: 0,0:11:56.80,0:12:00.51,Default,,0,0,0,,Менің көретінім, уақытымды босқа өткізіп жатқаным.
Dialogue: 0,0:12:00.59,0:12:01.72,Default,,0,0,0,,Босқа кетті ме?
Dialogue: 0,0:12:01.80,0:12:04.51,Default,,0,0,0,,Сыйлыққа лайық музыка жолымен жүру
Dialogue: 0,0:12:04.59,0:12:07.10,Default,,0,0,0,,Бұл біздің парызымыз бен парызымыз.
Dialogue: 0,0:12:07.18,0:12:08.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:08.14,0:12:11.14,Default,,0,0,0,,Басы қатып қалған намысты студент қандай болады!
Dialogue: 0,0:12:11.73,0:12:14.15,Default,,0,0,0,,А... тоқта, не істеп жатырсың!
Dialogue: 0,0:12:14.23,0:12:15.31,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:15.40,0:12:16.90,Default,,0,0,0,,Қараңыз, хахаха!
Dialogue: 0,0:12:15.40,0:12:16.90,Default,,0,0,0,,Қайтарыңыз! Ха!
Dialogue: 0,0:12:16.90,0:12:16.98,Default,,0,0,0,,Қайтарыңыз! Ха!
Dialogue: 0,0:12:16.98,0:12:17.57,Default,,0,0,0,,Қайтарыңыз! Ха!
Dialogue: 0,0:12:16.98,0:12:17.57,Default,,0,0,0,,Қараңдар, мына жақта, мына жақта!
Dialogue: 0,0:12:17.57,0:12:18.32,Default,,0,0,0,,Қараңызшы, дәл осылай!
Dialogue: 0,0:12:18.32,0:12:18.65,Default,,0,0,0,,Қараңызшы, дәл осылай!
Dialogue: 0,0:12:18.32,0:12:18.65,Default,,0,0,0,,Күте тұрыңыз! Хмм...
Dialogue: 0,0:12:18.65,0:12:18.73,Default,,0,0,0,,Күте тұрыңыз! Хмм...
Dialogue: 0,0:12:18.73,0:12:19.78,Default,,0,0,0,,Күте тұрыңыз! Хмм...
Dialogue: 0,0:12:18.73,0:12:19.78,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:12:19.86,0:12:21.78,Default,,0,0,0,,(Каэбуки) Күтпегендей, дайындықты ескерсек, аса әсерлі болған жоқ.
Dialogue: 0,0:12:21.86,0:12:22.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:24.36,0:12:25.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:25.78,0:12:27.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:36.46,0:12:38.30,Default,,0,0,0,,Мен... бұл жаман.
Dialogue: 0,0:12:39.59,0:12:42.55,Default,,0,0,0,,Ертең кешіксең, қабылдамаймын.
Dialogue: 0,0:12:52.06,0:12:54.31,Default,,0,0,0,,Мен сені қатты мазақ еттім бе?
Dialogue: 0,0:12:56.65,0:12:59.86,Default,,0,0,0,,Өйткені ол уақытты босқа өткізгенін айта береді...
Dialogue: 0,0:13:11.91,0:13:14.87,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:13:14.96,0:13:16.83,Default,,0,0,0,,Фааа...
Dialogue: 0,0:13:18.59,0:13:19.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:20.92,0:13:22.84,Default,,0,0,0,,(құбырды соғу дыбысы)
Dialogue: 0,0:13:25.13,0:13:26.30,Default,,0,0,0,,Я...
Dialogue: 0,0:13:32.31,0:13:35.85,Default,,0,0,0,,(Қызметкерлер сөйлеседі)
Dialogue: 0,0:13:37.40,0:13:39.02,Default,,0,0,0,,Иә, сынақ жақсы!
Dialogue: 0,0:13:39.11,0:13:41.23,Default,,0,0,0,,Бүгінгі кешке көмек көрсеткеніңіз үшін көп рахмет, Шопен мырза!
Dialogue: 0,0:13:43.07,0:13:44.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:44.19,0:13:45.53,Default,,0,0,0,,Сіз біреуді іздеп жүрсіз бе?
Dialogue: 0,0:13:45.61,0:13:48.78,Default,,0,0,0,,Жоқ, мен шөлдеп тұрмын.
Dialogue: 0,0:13:48.87,0:13:50.49,Default,,0,0,0,,Мен саған бірдеңе сатып аламын.
Dialogue: 0,0:13:50.58,0:13:51.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:52.08,0:13:56.50,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:14:00.92,0:14:03.21,Default,,0,0,0,,Мен үшін мұны айту өте қиын, бірақ
Dialogue: 0,0:14:03.30,0:14:05.88,Default,,0,0,0,,Ағымдағы жағдай Бұдан әрі қалпына келтіру мүмкін емес...
Dialogue: 0,0:14:12.72,0:14:13.72,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:19.60,0:14:23.61,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,0:14:28.32,0:14:29.61,Default,,0,0,0,,Бұл баяу
Dialogue: 0,0:14:29.70,0:14:30.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:33.37,0:14:36.71,Default,,0,0,0,,Нашар Жақын жерде дүкен жоқ.
Dialogue: 0,0:14:38.62,0:14:40.46,Default,,0,0,0,,Өте қатты ашуландырады—
Dialogue: 0,0:14:42.71,0:14:44.17,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:14:46.92,0:14:47.76,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:14:47.84,0:14:49.68,Default,,0,0,0,,Мен кеше онша жетілген жоқпын.
Dialogue: 0,0:14:49.76,0:14:52.22,Default,,0,0,0,,Хмм... Сондықтан жаман дедім.
Dialogue: 0,0:14:52.30,0:14:53.64,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,0:14:54.72,0:14:59.44,Default,,0,0,0,,Басқа адамдардың хоббиі туралы шағымданудың қажеті немесе құқығы жоқ, солай ма?
Dialogue: 0,0:14:59.52,0:15:02.48,Default,,0,0,0,,Мен уақытымды пайдаланып, арамшөптерден арылсам да,
Dialogue: 0,0:15:02.56,0:15:04.86,Default,,0,0,0,,Бұл мен білетін нәрсе емес.
Dialogue: 0,0:15:04.94,0:15:06.57,Default,,0,0,0,,Сіз...
Dialogue: 0,0:15:06.65,0:15:10.53,Default,,0,0,0,,Мүлдем... Армандарыңа жете алғаныңа мен сені қызғанамын.
Dialogue: 0,0:15:10.61,0:15:12.49,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:15:12.57,0:15:15.74,Default,,0,0,0,,Ха, сен әлі де сондай тәтті болуың керек.
Dialogue: 0,0:15:15.83,0:15:17.33,Default,,0,0,0,,Тыңда, біз...
Dialogue: 0,0:15:17.41,0:15:18.71,Default,,0,0,0,,Берілген сыйлыққа
Dialogue: 0,0:15:18.79,0:15:22.54,Default,,0,0,0,,Дұрыс жолмен жүру – парызымыз.
Dialogue: 0,0:15:22.63,0:15:24.25,Default,,0,0,0,,Білсеңіз жақсы.
Dialogue: 0,0:15:24.34,0:15:25.17,Default,,0,0,0,,Бірақ
Dialogue: 0,0:15:25.92,0:15:28.59,Default,,0,0,0,,Сіздің және басқа студенттер кеңесінің жолы болды.
Dialogue: 0,0:15:28.67,0:15:32.47,Default,,0,0,0,,Себебі менің істеп жатқаным мен сыйлық бір-біріне өте сәйкес келеді.
Dialogue: 0,0:15:34.60,0:15:36.64,Default,,0,0,0,,Мен де, бәрібір ала алсам.
Dialogue: 0,0:15:36.72,0:15:39.52,Default,,0,0,0,,Мен әлем чемпионына сыйлық алғым келді.
Dialogue: 0,0:15:39.60,0:15:41.73,Default,,0,0,0,,Жынның алтын таяқшасы бар.
Dialogue: 0,0:15:42.23,0:15:43.98,Default,,0,0,0,,Бұл шынымен тәтті, солай емес пе?
Dialogue: 0,0:15:44.06,0:15:45.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:45.69,0:15:46.69,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:15:48.65,0:15:51.70,Default,,0,0,0,,Қалай ойлайсыңдар, біз қуаныштан қолымызды жоғары лақтырып жатырмыз ба?
Dialogue: 0,0:15:51.78,0:15:54.82,Default,,0,0,0,,Эволюцияның қазынасы – екі жүзді қылыш.
Dialogue: 0,0:15:54.91,0:15:56.87,Default,,0,0,0,,Әсіресе бізге берілген
Dialogue: 0,0:15:56.95,0:15:59.79,Default,,0,0,0,,Бұл музыка құдайы деп аталатын сыйлық, солай ма?
Dialogue: 0,0:15:59.87,0:16:01.54,Default,,0,0,0,,Біз әлі қартайған жоқпыз
Dialogue: 0,0:16:01.62,0:16:04.46,Default,,0,0,0,,Басқару оңай деп ойлайсыз ба?
Dialogue: 0,0:16:05.46,0:16:08.80,Default,,0,0,0,,Ән айтып тұрған нәрсе – жобаланатын нәрсе
Dialogue: 0,0:16:08.88,0:16:10.97,Default,,0,0,0,,Аудитория нені күтеді
Dialogue: 0,0:16:11.88,0:16:13.34,Default,,0,0,0,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,0:16:14.64,0:16:15.43,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:15.43,0:16:16.14,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:15.43,0:16:16.14,Default,,0,0,0,,Ах, бұл (Бетховен) А...
Dialogue: 0,0:16:16.14,0:16:17.47,Default,,0,0,0,,Аа, бұл (Бетховен) Ах...
Dialogue: 0,0:16:17.56,0:16:19.77,Default,,0,0,0,,Шопен мырза, сіз не істеп жатырсыз?
Dialogue: 0,0:16:19.85,0:16:22.23,Default,,0,0,0,,Клиент бар, асығыңыз.
Dialogue: 0,0:16:30.24,0:16:32.24,Default,,0,0,0,,Теңізден басталды.
Dialogue: 0,0:16:32.82,0:16:34.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:34.86,0:16:38.37,Default,,0,0,0,,Теңіздегі органикалық заттардан пайда болған атомдық биологиялық заттар.
Dialogue: 0,0:16:38.45,0:16:40.37,Default,,0,0,0,,Бұл көп уақытты алды
Dialogue: 0,0:16:40.45,0:16:42.83,Default,,0,0,0,,Қайталанатын таңдау және эволюция үшін іріктеу
Dialogue: 0,0:16:42.91,0:16:46.13,Default,,0,0,0,,Қазір біз жерде тұрмыз
Dialogue: 0,0:16:47.71,0:16:49.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:49.80,0:16:52.42,Default,,0,0,0,,Мен сыйлық ретінде таңдалғанымды қабылдаймын.
Dialogue: 0,0:16:52.51,0:16:57.05,Default,,0,0,0,,Менің ойымша, біз эволюцияның ортасындамыз.
Dialogue: 0,0:16:58.68,0:17:00.06,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:17:04.02,0:17:07.31,Default,,0,0,0,,Мәңгі сол қалпында қала бересің бе?
Dialogue: 0,0:17:14.11,0:17:15.45,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:20.66,0:17:25.46,Default,,0,0,0,,(динамиктерден ойналатын бас ырғақты музыка)
Dialogue: 0,0:17:20.66,0:17:25.46,Default,,0,0,0,,(аудитория дауыстары)
Dialogue: 0,0:17:25.54,0:17:28.08,Default,,0,0,0,,Әй, бұл танымал.
Dialogue: 0,0:17:37.68,0:17:41.68,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:17:42.68,0:17:43.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:46.44,0:17:51.44,Default,,0,0,0,,♪ «Эволюция этюды»
Dialogue: 0,0:18:01.33,0:18:04.25,Default,,0,0,0,,Ах... ха!
Dialogue: 0,0:18:12.46,0:18:14.26,Default,,0,0,0,,♪ Стереотиптерді ұмытыңыз
Dialogue: 0,0:18:14.34,0:18:16.26,Default,,0,0,0,,♪ Кемелдігімді аяқтадым
Dialogue: 0,0:18:16.34,0:18:18.26,Default,,0,0,0,,♪ Классикалық және хип-хоп
Dialogue: 0,0:18:18.34,0:18:20.26,Default,,0,0,0,,♪ Мен үшін әк үлгісі
Dialogue: 0,0:18:20.35,0:18:22.26,Default,,0,0,0,,♪ Шуға толы жалған ×3
Dialogue: 0,0:18:22.35,0:18:24.27,Default,,0,0,0,,♪ Манеке толы, ауру×3
Dialogue: 0,0:18:24.35,0:18:26.18,Default,,0,0,0,,♪ Шын жүректі қаласаң
Dialogue: 0,0:18:26.27,0:18:27.23,Default,,0,0,0,,♪ Соғумен сіз ешқашан жалықпайсыз
Dialogue: 0,0:18:27.31,0:18:28.27,Default,,0,0,0,,♪ Қолдарыңызды жоғары қойыңыз.
Dialogue: 0,0:18:30.36,0:18:32.27,Default,,0,0,0,,♪ Сүзілген
Dialogue: 0,0:18:32.36,0:18:34.28,Default,,0,0,0,,♪ Объектив арқылы шындық
Dialogue: 0,0:18:34.36,0:18:38.28,Default,,0,0,0,,♪ Қолыңды созғанда кім бар?
Dialogue: 0,0:18:38.36,0:18:40.28,Default,,0,0,0,,♪ Мағынасыз шатасу
Dialogue: 0,0:18:40.37,0:18:42.28,Default,,0,0,0,,♪ Құнсыз адасу
Dialogue: 0,0:18:42.37,0:18:46.29,Default,,0,0,0,,♪ Айнаны тесіп
Dialogue: 0,0:18:46.37,0:18:48.12,Default,,0,0,0,,♪ Жауап үшін
Dialogue: 0,0:18:48.21,0:18:50.29,Default,,0,0,0,,♪ Аспанға қарадым
Dialogue: 0,0:18:50.38,0:18:52.50,Default,,0,0,0,,♪ Болашаққа
Dialogue: 0,0:18:52.59,0:18:58.17,Default,,0,0,0,,♪ Біз таңдаған бұл жол қандай?
Dialogue: 0,0:18:58.26,0:19:02.01,Default,,0,0,0,,♪ Трансцендентті шеберліктің саусақтарымен түртеді
Dialogue: 0,0:19:02.10,0:19:06.18,Default,,0,0,0,,♪ Көне дыбыстарға саяхат
Dialogue: 0,0:19:06.27,0:19:10.02,Default,,0,0,0,,♪ Тоғысудың жаңа дәуірі
Dialogue: 0,0:19:10.10,0:19:13.19,Default,,0,0,0,,♪ Таң атқанша қасымда бол
Dialogue: 0,0:19:13.27,0:19:17.99,Default,,0,0,0,,♪ Ақ және қара пернелерде
Dialogue: 0,0:19:18.07,0:19:21.91,Default,,0,0,0,,♪ Біз оны әлі көрмеген болармыз
Dialogue: 0,0:19:21.99,0:19:26.20,Default,,0,0,0,,♪ Эволюцияның тәттілігін іздеп көрейік
Dialogue: 0,0:19:26.29,0:19:31.71,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:19:31.79,0:19:34.84,Default,,0,0,0,,～♪
Dialogue: 0,0:19:34.84,0:19:36.84,Default,,0,0,0,,～♪
Dialogue: 0,0:19:34.84,0:19:36.84,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:19:36.84,0:19:38.21,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:19:40.51,0:19:42.05,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:42.14,0:19:45.22,Default,,0,0,0,,Сыйлықты қабылдаған кезең
Dialogue: 0,0:19:45.31,0:19:50.23,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:51.44,0:19:52.77,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:58.74,0:20:01.65,Default,,0,0,0,,Олай болса, тірі заттардың эволюциясы мен тегі
Dialogue: 0,0:20:01.74,0:20:03.66,Default,,0,0,0,,Ежелгі организмдердің басым түрлерін атаңыз?
Dialogue: 0,0:20:03.74,0:20:07.87,Default,,0,0,0,,Омыртқасыздар Балықтар мен...
Dialogue: 0,0:20:07.95,0:20:10.62,Default,,0,0,0,,Әй, қосмекенділер! Қосмекенділер!
Dialogue: 0,0:20:10.71,0:20:12.62,Default,,0,0,0,,Бұл қосымша емтиханға өте ыңғайлы.
Dialogue: 0,0:20:12.71,0:20:15.13,Default,,0,0,0,,Нұсқаулық жақсы болса, оны қысып алуға болады.
Dialogue: 0,0:20:15.21,0:20:16.75,Default,,0,0,0,,Тіпті тауықтың басы
Dialogue: 0,0:20:16.84,0:20:18.25,Default,,0,0,0,,Құс басы кім?
Dialogue: 0,0:20:18.34,0:20:20.76,Default,,0,0,0,,Кешіріңіз, динозаврдың басын пайдаланыңыз.
Dialogue: 0,0:20:20.84,0:20:24.05,Default,,0,0,0,,Ой... Әй, сен сондай күшті және салқын көрінесің!
Dialogue: 0,0:20:24.14,0:20:27.01,Default,,0,0,0,,Олар құстардан бауырымен жорғалаушыларға дейін азғындаған.
Dialogue: 0,0:20:27.10,0:20:28.43,Default,,0,0,0,,А? Жоқ
Dialogue: 0,0:20:28.51,0:20:31.68,Default,,0,0,0,,Эволюцияның қазынасы сіз үшін жоғалған қазына.
Dialogue: 0,0:20:31.77,0:20:32.64,Default,,0,0,0,,Хи хи
Dialogue: 0,0:20:34.06,0:20:35.15,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:38.23,0:20:42.24,Default,,0,0,0,,Ватару!
Dialogue: 0,0:20:49.16,0:20:50.50,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:20:50.50,0:20:52.08,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:20:50.50,0:20:52.08,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:20:52.16,0:20:53.71,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,0:20:53.79,0:20:55.17,Default,,0,0,0,,Қосымша емтихан жойылды
Dialogue: 0,0:20:55.25,0:20:57.21,Default,,0,0,0,,Сонымен... сіз қанша ұпай алдыңыз?
Dialogue: 0,0:20:57.29,0:20:58.50,Default,,0,0,0,,әрқайсысы 50 ұпай!
Dialogue: 0,0:20:58.59,0:21:03.34,Default,,0,0,0,,Төмен! Мен саған үйретсем де, ол әлі күнге дейін жетуі мүмкін!
Dialogue: 0,0:21:03.42,0:21:07.18,Default,,0,0,0,,Бұл динозаврдың басы емес, бактериялардың басы еді...
Dialogue: 0,0:21:07.26,0:21:08.43,Default,,0,0,0,,Бұл бактерия ма?
Dialogue: 0,0:21:09.01,0:21:10.81,Default,,0,0,0,,Бірақ сен маған көмектестің, Сенсей!
Dialogue: 0,0:21:10.89,0:21:12.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:12.39,0:21:15.52,Default,,0,0,0,,Мен сенің оқуыңды міндетті түрде көремін!
Dialogue: 0,0:21:15.60,0:21:18.73,Default,,0,0,0,,Ал, тағы да рахмет, Шопен мырза.
Dialogue: 0,0:21:18.82,0:21:22.03,Default,,0,0,0,,Әй, қымбат уақытымды босқа кетірдім.
Dialogue: 0,0:21:22.11,0:21:23.40,Default,,0,0,0,,Біз дос болдық
Dialogue: 0,0:21:23.49,0:21:25.45,Default,,0,0,0,,Бұл бактерия қай жерде?
Dialogue: 0,0:21:25.53,0:21:26.70,Default,,0,0,0,,Біраз ашытуды орындаңыз.
Dialogue: 0,0:21:26.78,0:21:27.70,Default,,0,0,0,,Не!
Dialogue: 0,0:21:27.78,0:21:29.70,Default,,0,0,0,,Біз де жақсы доспыз ба? (Бетховен) Эй!
Dialogue: 0,0:21:29.78,0:21:33.45,Default,,0,0,0,,Енді сіз алаңдамай музыкаға назар аудара аласыз!
Dialogue: 0,0:21:35.33,0:21:37.92,Default,,0,0,0,,Жоқ, мен сізге рахмет айту үшін келдім...
Dialogue: 0,0:21:38.00,0:21:41.05,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін, Бетховен.
Dialogue: 0,0:21:41.13,0:21:42.01,Default,,0,0,0,,Демек, мен Бетховен емеспін!
Dialogue: 0,0:21:42.01,0:21:44.55,Default,,0,0,0,,Демек, мен Бетховен емеспін!
Dialogue: 0,0:21:42.01,0:21:44.55,Default,,0,0,0,,Ооо? иә?
Dialogue: 0,0:21:44.55,0:21:44.63,Default,,0,0,0,,Демек, мен Бетховен емеспін!
Dialogue: 0,0:21:44.63,0:21:46.80,Default,,0,0,0,,Демек, мен Бетховен емеспін!
Dialogue: 0,0:21:44.63,0:21:46.80,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:46.88,0:21:50.56,Default,,0,0,0,,Жарайды, тым болмаса берілмей, бар күшіңді сал.
Dialogue: 0,0:21:51.22,0:21:54.06,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:21:55.02,0:21:59.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:20.02,0:23:24.94,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.45,0:23:39.62,Default,,0,0,0,,Келесі жолы «Бүгін түнде армандармен ойнайық»
Dialogue: 0,0:23:41.12,0:23:47.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory