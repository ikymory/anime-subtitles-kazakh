Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.33,0:00:02.75,Default,,0,0,0,,Яджу!
Dialogue: 0,0:00:03.71,0:00:07.59,Default,,0,0,0,,Сіз шынымен де жалғыз қалуға болмайды!
Dialogue: 0,0:00:08.09,0:00:09.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:14.97,0:00:16.72,Default,,0,0,0,,Мисс Миоко сонда болды ма?
Dialogue: 0,0:00:16.80,0:00:18.72,Default,,0,0,0,,Жоқ, мен оны таба алмаймын.
Dialogue: 0,0:00:18.81,0:00:21.10,Default,,0,0,0,,Ол енді бұл жерде болмауы мүмкін.
Dialogue: 0,0:00:21.18,0:00:22.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:22.64,0:00:24.65,Default,,0,0,0,,Басқаларды ізде (Қара киім) Иә.
Dialogue: 0,0:00:40.54,0:00:43.33,Default,,0,0,0,,Әзірге жоқ сияқты.
Dialogue: 0,0:00:44.04,0:00:48.59,Default,,0,0,0,,♪～
Dialogue: 0,0:02:09.63,0:02:13.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:16.72,0:02:17.72,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:02:17.80,0:02:19.93,Default,,0,0,0,,Олар өте табанды.
Dialogue: 0,0:02:20.01,0:02:22.68,Default,,0,0,0,,Сізді қатысқаным үшін кешіріңіз.
Dialogue: 0,0:02:22.76,0:02:24.22,Default,,0,0,0,,Жақсы, бұл туралы уайымдама.
Dialogue: 0,0:02:26.02,0:02:28.81,Default,,0,0,0,,Соған қарамастан, олар қорқынышты адамдар.
Dialogue: 0,0:02:29.69,0:02:31.94,Default,,0,0,0,,Жоғалған баласың ба, қашқынсың ба
Dialogue: 0,0:02:32.02,0:02:35.48,Default,,0,0,0,,Жоғалған жанұяңызға бірінші айтар сөзіңіз
Dialogue: 0,0:02:35.57,0:02:38.86,Default,,0,0,0,,«Олардың аман-есен табылғанына қуаныштымын».
Dialogue: 0,0:02:41.45,0:02:45.16,Default,,0,0,0,,Одан кейін мен қатты ашуландым.
Dialogue: 0,0:02:45.24,0:02:48.66,Default,,0,0,0,,Майхиру-сан, егер мені ашуландырсаң, мен қатты қорқамын...
Dialogue: 0,0:02:50.71,0:02:53.50,Default,,0,0,0,,Ха! Кез келген кездейсоқ... кез келген кездейсоқ
Dialogue: 0,0:02:53.59,0:02:58.26,Default,,0,0,0,,Маған қазір адасқан бала сияқты қарайтын шығар...
Dialogue: 0,0:02:58.84,0:03:01.97,Default,,0,0,0,,Қарғыс атсын! Мен Майхирумен тез байланысуым керек.
Dialogue: 0,0:03:02.05,0:03:02.89,Default,,0,0,0,,Қоғамдық телефон!
Dialogue: 0,0:03:02.97,0:03:04.51,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:04.60,0:03:05.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:05.72,0:03:10.64,Default,,0,0,0,,Хехехехехе...
Dialogue: 0,0:03:10.73,0:03:12.81,Default,,0,0,0,,Бұл не? Күлкілі емес пе?
Dialogue: 0,0:03:12.90,0:03:15.65,Default,,0,0,0,,Ой, ау... Күлмеймін.
Dialogue: 0,0:03:15.73,0:03:16.94,Default,,0,0,0,,Жоқ, сен күлдің.
Dialogue: 0,0:03:17.03,0:03:19.28,Default,,0,0,0,,Күлмейді
Dialogue: 0,0:03:23.28,0:03:27.08,Default,,0,0,0,,Күлсең ұрысады.
Dialogue: 0,0:03:28.91,0:03:32.12,Default,,0,0,0,,Бұл қиын үй.
Dialogue: 0,0:03:32.21,0:03:34.00,Default,,0,0,0,,Сол себепті үйден қашып кеттің бе?
Dialogue: 0,0:03:40.38,0:03:43.55,Default,,0,0,0,,Жарайды, мен жақсы нәрсе ойладым.
Dialogue: 0,0:03:45.05,0:03:48.31,Default,,0,0,0,,Енді мен сені ерекше жерге апарамын.
Dialogue: 0,0:03:52.77,0:03:54.65,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:03:55.69,0:03:57.94,Default,,0,0,0,,Келген соң қызық.
Dialogue: 0,0:04:03.66,0:04:05.24,Default,,0,0,0,,Біз келдік
Dialogue: 0,0:04:08.20,0:04:09.50,Default,,0,0,0,,Уау...!
Dialogue: 0,0:04:11.08,0:04:13.83,Default,,0,0,0,,Өте әдемі!
Dialogue: 0,0:04:14.79,0:04:16.00,Default,,0,0,0,,О
Dialogue: 0,0:04:16.09,0:04:20.97,Default,,0,0,0,,Оның үстіне, мен бұл жерде қатты айқайласам да, мені ешкім естімейді.
Dialogue: 0,0:04:21.59,0:04:25.34,Default,,0,0,0,,Сіз ешқашан күлген жоқсыз және ештеңе айтқан жоқсыз.
Dialogue: 0,0:04:25.43,0:04:27.89,Default,,0,0,0,,Мен мұны осында ғана құпия ұстаймын.
Dialogue: 0,0:04:27.97,0:04:30.89,Default,,0,0,0,,Ендеше уайымдамай не қаласаңыз, соны айта аласыз.
Dialogue: 0,0:04:36.73,0:04:39.15,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:04:39.23,0:04:42.65,Default,,0,0,0,,Блять сені, қарғыс атқыр қарғыс!
Dialogue: 0,0:04:42.74,0:04:44.66,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:44.74,0:04:48.33,Default,,0,0,0,,Кейбір сабақтар таңертеңнен кешке дейін созылады.
Dialogue: 0,0:04:48.41,0:04:51.08,Default,,0,0,0,,Тіпті танымайтын адаммен некеге тұру
Dialogue: 0,0:04:51.16,0:04:53.83,Default,,0,0,0,,Кейбір қызметшілер тек сіздің түріңізге қарайды.
Dialogue: 0,0:04:53.91,0:04:56.29,Default,,0,0,0,,Мен одан шаршадым!
Dialogue: 0,0:04:56.38,0:04:59.88,Default,,0,0,0,,Мен көшеге көбірек шыққым келеді! Мен көбірек ойнағым келеді!
Dialogue: 0,0:04:59.96,0:05:02.01,Default,,0,0,0,,Мен сүйкімді киім кигім келеді!
Dialogue: 0,0:05:02.09,0:05:05.13,Default,,0,0,0,,Мен бұрын жеп көрмеген көп нәрсені жегім келеді!
Dialogue: 0,0:05:05.22,0:05:09.81,Default,,0,0,0,,Достар, болашақ армандар және жұбайлар
Dialogue: 0,0:05:09.89,0:05:13.02,Default,,0,0,0,,Мен бәрін өзім шешкім келеді!
Dialogue: 0,0:05:14.56,0:05:18.69,Default,,0,0,0,,Мен көбірек еркін болғым келеді!
Dialogue: 0,0:05:24.40,0:05:25.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:26.03,0:05:30.41,Default,,0,0,0,,Бостандық Ясуши үшін арман болды.
Dialogue: 0,0:05:30.49,0:05:33.33,Default,,0,0,0,,Алайда мен бостандыққа шыққанда
Dialogue: 0,0:05:33.41,0:05:38.17,Default,,0,0,0,,Мен не істерімді білмей, адасып кетем.
Dialogue: 0,0:05:38.25,0:05:42.17,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:05:45.42,0:05:47.30,Default,,0,0,0,,Өзіңізді сергек сезінесіз бе?
Dialogue: 0,0:05:47.38,0:05:49.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:49.85,0:05:51.89,Default,,0,0,0,,Ал, енді үйге қайтайық.
Dialogue: 0,0:05:53.60,0:05:54.43,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:06:00.52,0:06:02.15,Default,,0,0,0,,Амон, ол жігіт қауіпті.
Dialogue: 0,0:06:05.94,0:06:08.45,Default,,0,0,0,,Ол бетті жасамасаң жақсы.
Dialogue: 0,0:06:08.53,0:06:11.49,Default,,0,0,0,,Бұдан былай бос боласыз.
Dialogue: 0,0:06:11.58,0:06:12.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:12.66,0:06:17.08,Default,,0,0,0,,Ал бұдан былай қанша рет адасып қалсаң да,
Dialogue: 0,0:06:18.00,0:06:21.09,Default,,0,0,0,,Мен сені міндетті түрде табамын
Dialogue: 0,0:06:21.92,0:06:25.92,Default,,0,0,0,,Мен сенің күшің боламын соңына дейін.
Dialogue: 0,0:06:32.26,0:06:34.01,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:44.23,0:06:45.44,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:06:46.19,0:06:48.03,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:06:48.61,0:06:52.99,Default,,0,0,0,,Мен сені іздегенде көп нәрсе есіме түсті.
Dialogue: 0,0:06:53.91,0:06:57.25,Default,,0,0,0,,Өйткені, мен сол кезде кездестірген адам Миоко Ичидодзи болатын
Dialogue: 0,0:06:57.33,0:06:58.96,Default,,0,0,0,,Бұл сен едің.
Dialogue: 0,0:06:59.87,0:07:03.84,Default,,0,0,0,,Аман-есен табылғаныңызға қуаныштымын.
Dialogue: 0,0:07:13.22,0:07:15.76,Default,,0,0,0,,(Түрлі дауыс)
Dialogue: 0,0:07:15.85,0:07:18.81,Default,,0,0,0,,Бұл... бұлай қалса жақсы болмайды.
Dialogue: 0,0:07:18.89,0:07:22.44,Default,,0,0,0,,Мен оянсам, Яшиге ұяла алмаймын...
Dialogue: 0,0:07:22.52,0:07:24.52,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:07:26.11,0:07:28.40,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:07:28.49,0:07:30.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:30.99,0:07:35.16,Default,,0,0,0,,Ум... Урю-кун?
Dialogue: 0,0:07:35.24,0:07:37.70,Default,,0,0,0,,Жоқ... бұл түсінбеушілік!
Dialogue: 0,0:07:37.79,0:07:40.21,Default,,0,0,0,,Мен жай ғана түймені жабуға тырыстым!
Dialogue: 0,0:07:40.29,0:07:43.92,Default,,0,0,0,,Ши... сеніңізші!
Dialogue: 0,0:07:55.89,0:07:58.06,Default,,0,0,0,,Я...
Dialogue: 0,0:07:59.47,0:08:01.06,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:08:01.14,0:08:03.60,Default,,0,0,0,,Бір кезде мен не болар екен деп ойладым.
Dialogue: 0,0:08:03.69,0:08:07.27,Default,,0,0,0,,Эххе, уайымдағаныңыз үшін кешіріңіз.
Dialogue: 0,0:08:07.36,0:08:09.94,Default,,0,0,0,,Сізге көп рахмет, Урю-кун.
Dialogue: 0,0:08:10.65,0:08:13.95,Default,,0,0,0,,Сіз маған тағы да көмектестіңіз.
Dialogue: 0,0:08:19.24,0:08:22.46,Default,,0,0,0,,Сіз сөйлесетін маңызды нәрсе бар дедіңіз.
Dialogue: 0,0:08:24.29,0:08:26.50,Default,,0,0,0,,Бұл туралы осы жерде сөйлесейік.
Dialogue: 0,0:08:33.05,0:08:35.09,Default,,0,0,0,,Сөйлескен дұрыс.
Dialogue: 0,0:08:35.18,0:08:36.18,Default,,0,0,0,,Иә
Dialogue: 0,0:08:38.68,0:08:41.89,Default,,0,0,0,,Бүгін сыраханадан оралған соң
Dialogue: 0,0:08:41.98,0:08:44.27,Default,,0,0,0,,Мен сіздің әмияныңызды алдым
Dialogue: 0,0:08:44.85,0:08:46.73,Default,,0,0,0,,Сол кезде мен жүргізуші куәлігін көрдім.
Dialogue: 0,0:08:47.90,0:08:50.19,Default,,0,0,0,,Рұқсатсыз қарағаным менің кінәм болды.
Dialogue: 0,0:08:50.28,0:08:53.74,Default,,0,0,0,,-де «Яшиге Кангами» жоқ.
Dialogue: 0,0:08:53.82,0:08:56.20,Default,,0,0,0,,«Миоко Ичидодзи» деп жазылған
Dialogue: 0,0:08:57.49,0:08:58.83,Default,,0,0,0,,Иә
Dialogue: 0,0:08:58.91,0:09:01.70,Default,,0,0,0,,Бірақ мен кішкентай кезімде
Dialogue: 0,0:09:02.45,0:09:04.67,Default,,0,0,0,,Миоко Ичидодзи есімді қызға
Dialogue: 0,0:09:04.75,0:09:06.83,Default,,0,0,0,,Танысқанымыз есіме түсті.
Dialogue: 0,0:09:08.79,0:09:10.00,Default,,0,0,0,,Иә
Dialogue: 0,0:09:11.63,0:09:14.76,Default,,0,0,0,,Сол кезде мен Миоко Ичидодзиді кездестірдім.
Dialogue: 0,0:09:14.84,0:09:17.47,Default,,0,0,0,,Йошиге: Бұл сен едің ғой, солай ма?
Dialogue: 0,0:09:18.55,0:09:21.52,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:26.06,0:09:28.98,Default,,0,0,0,,Тағы бір нәрсе есіме түсті.
Dialogue: 0,0:09:29.06,0:09:30.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:30.98,0:09:35.86,Default,,0,0,0,,Иә, бұл Миоко Ичидоджимен кездескенше біраз уақыт болды...
Dialogue: 0,0:09:35.95,0:09:38.87,Default,,0,0,0,,На на на...
Dialogue: 0,0:09:42.95,0:09:44.91,Default,,0,0,0,,Мен… қатты қорқып, Арбаларды шақыруды мүлде ұмытып кеттім
Dialogue: 0,0:09:45.00,0:09:48.38,Default,,0,0,0,,Енді мен бастауыш сынып оқушысы болсам, не істеуім керек?
Dialogue: 0,0:09:48.46,0:09:51.38,Default,,0,0,0,,Бұл ұят жайтты бәрі білсе ше...
Dialogue: 0,0:09:52.59,0:09:55.88,Default,,0,0,0,,Әй, саған әлі де жөргек керек пе?
Dialogue: 0,0:09:55.97,0:09:59.26,Default,,0,0,0,,Шалбарыңды сулау~ Шалбарыңды сулау~
Dialogue: 0,0:10:15.61,0:10:18.49,Default,,0,0,0,,Мүмкін болса, есіме түсіргім келмеді
Dialogue: 0,0:10:18.57,0:10:20.49,Default,,0,0,0,,Бұл менің қараңғы тарихым.
Dialogue: 0,0:10:30.54,0:10:32.67,Default,,0,0,0,,Міне! Менің әңгімем аяқталды!
Dialogue: 0,0:10:32.75,0:10:34.42,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,0:10:34.50,0:10:36.42,Default,,0,0,0,,Мен… осындай күйде телефон шала алмаймын.
Dialogue: 0,0:10:36.51,0:10:38.59,Default,,0,0,0,,Дәл қазір қандай оқиға болды?
Dialogue: 0,0:10:38.68,0:10:42.55,Default,,0,0,0,,Есте сақтағың келмесе, айтудың қажеті жоқ...
Dialogue: 0,0:10:42.64,0:10:45.06,Default,,0,0,0,,Сенің сырыңды мен ғана біледі
Dialogue: 0,0:10:45.14,0:10:47.02,Default,,0,0,0,,Мен бұл әділ емес деп ойладым.
Dialogue: 0,0:10:47.10,0:10:48.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:48.23,0:10:52.31,Default,,0,0,0,,Өзіңді басқа атпен атағаныңа таң қалдым...
Dialogue: 0,0:10:53.36,0:10:57.78,Default,,0,0,0,,Сіз өзіңізді өзгерткіңіз келді, солай ма?
Dialogue: 0,0:10:57.86,0:10:59.70,Default,,0,0,0,,Урю-кун…
Dialogue: 0,0:11:00.99,0:11:04.20,Default,,0,0,0,,Сол кезде қиналған мен едім.
Dialogue: 0,0:11:04.28,0:11:07.70,Default,,0,0,0,,Қазір жақсы екеніңізді білу
Dialogue: 0,0:11:07.79,0:11:09.41,Default,,0,0,0,,(Каттлея) Мажорға осы туралы айттың ба?
Dialogue: 0,0:11:09.50,0:11:11.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:17.55,0:11:22.05,Default,,0,0,0,,Сен енді менің балам емессің
Dialogue: 0,0:11:22.14,0:11:24.68,Default,,0,0,0,,Егер мені тыңдамасаң
Dialogue: 0,0:11:24.76,0:11:27.47,Default,,0,0,0,,Қазір бұл үйден кет.
Dialogue: 0,0:11:28.31,0:11:32.81,Default,,0,0,0,,Мен Ичидодзи отбасының атына бұдан былай дақ түсіруге жол бермеймін.
Dialogue: 0,0:11:46.54,0:11:47.95,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:51.87,0:11:54.04,Default,,0,0,0,,«Амагами Яджу»
Dialogue: 0,0:11:54.13,0:11:56.50,Default,,0,0,0,,Сіздің жаңа атыңыз
Dialogue: 0,0:12:05.18,0:12:06.81,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:12:07.56,0:12:10.10,Default,,0,0,0,,Жүрегіңді тыңда
Dialogue: 0,0:12:10.18,0:12:13.10,Default,,0,0,0,,Қайда барғыңыз келсе, сонда барыңыз.
Dialogue: 0,0:12:14.15,0:12:18.86,Default,,0,0,0,,Сіздің бақытыңыз сізді одан әрі күтіп тұрғаны сөзсіз.
Dialogue: 0,0:12:35.83,0:12:38.13,Default,,0,0,0,,«Ёшиге» өзгергеннен кейін
Dialogue: 0,0:12:38.21,0:12:43.47,Default,,0,0,0,,Менің атыммен қайта дүниеге келдім.
Dialogue: 0,0:12:43.97,0:12:45.64,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:12:46.43,0:12:49.76,Default,,0,0,0,,Мен өзгерте алатын нәрсе
Dialogue: 0,0:12:49.85,0:12:51.89,Default,,0,0,0,,Мен қазір қандаймын...
Dialogue: 0,0:12:54.56,0:12:56.98,Default,,0,0,0,,Мұның бәрі сіздің арқаңыз
Dialogue: 0,0:12:59.07,0:13:00.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:03.07,0:13:05.41,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:13:05.49,0:13:08.70,Default,,0,0,0,,Ясуши Аман-есен болғаныңызға қуаныштымын!
Dialogue: 0,0:13:08.78,0:13:10.66,Default,,0,0,0,,Уау, Йоджу-ни!
Dialogue: 0,0:13:10.74,0:13:15.17,Default,,0,0,0,,Екеуіңізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:13:15.25,0:13:19.09,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:13:20.92,0:13:23.55,Default,,0,0,0,,Мико Ичидодзи жоқ деген нені білдіреді?
Dialogue: 0,0:13:23.63,0:13:27.18,Default,,0,0,0,,Бұл Йошигенің қайта туылғанын білдіреді.
Dialogue: 0,0:13:28.43,0:13:30.31,Default,,0,0,0,,Сіз Йосигемен сөйлестіңіз, солай ма?
Dialogue: 0,0:13:31.14,0:13:33.48,Default,,0,0,0,,Мен оны сонша шегелеп алсам да.
Dialogue: 0,0:13:33.56,0:13:35.56,Default,,0,0,0,,Мен Йоджу құпиясына аралассам ше?
Dialogue: 0,0:13:35.64,0:13:39.52,Default,,0,0,0,,Менің армандарым орындалмайды... солай ма?
Dialogue: 0,0:13:40.77,0:13:43.32,Default,,0,0,0,,Әрине, мен сенің маған бұл туралы үзіліс беруіңді қалаймын, бірақ...
Dialogue: 0,0:13:43.40,0:13:48.03,Default,,0,0,0,,Йошуға бірдеңе болса, мен тартынбаймын.
Dialogue: 0,0:13:55.41,0:13:58.04,Default,,0,0,0,,Сол жігіт жағы ренжітеді ғой.
Dialogue: 0,0:13:58.12,0:13:58.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:00.25,0:14:02.59,Default,,0,0,0,,Шие… Бұл Хассаикай ма еді?
Dialogue: 0,0:14:02.67,0:14:08.22,Default,,0,0,0,,Мүмкін сіз шынымен Ясушидің тағдырын өзгерте аласыз.
Dialogue: 0,0:14:25.44,0:14:26.49,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:26.57,0:14:29.82,Default,,0,0,0,,Кейде кеш тұру жақсы.
Dialogue: 0,0:14:29.91,0:14:32.45,Default,,0,0,0,,Бірақ ертең менің сабағым бар.
Dialogue: 0,0:14:32.53,0:14:34.62,Default,,0,0,0,,Маған қазір шынымен ұйықтау керек.
Dialogue: 0,0:14:34.70,0:14:38.25,Default,,0,0,0,,Мүлдем. Бұл шынымен ұзақ түн болды.
Dialogue: 0,0:14:38.33,0:14:41.00,Default,,0,0,0,,Иә? Ал Йоджу-Ни ше?
Dialogue: 0,0:14:41.08,0:14:44.00,Default,,0,0,0,,Бөлмеңізге тез оралған сияқтысыз.
Dialogue: 0,0:14:44.09,0:14:48.38,Default,,0,0,0,,Ол... ол адамдарды көп итермеледі.
Dialogue: 0,0:14:51.89,0:14:54.26,Default,,0,0,0,,Ол шынымен де еркін жігіт.
Dialogue: 0,0:15:05.40,0:15:10.20,Default,,0,0,0,,Ммм!
Dialogue: 0,0:15:18.08,0:15:19.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:21.75,0:15:27.13,Default,,0,0,0,,Мен Урю-кунға ғашық болдым.
Dialogue: 0,0:15:36.18,0:15:37.18,Default,,0,0,0,,(сүю дыбысы)
Dialogue: 0,0:15:37.81,0:15:39.68,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:39.77,0:15:42.69,Default,,0,0,0,,Мен қайтадан ұйықтай алмаймын.
Dialogue: 0,0:15:53.16,0:15:55.12,Default,,0,0,0,,Ыстық...
Dialogue: 0,0:15:55.20,0:15:57.95,Default,,0,0,0,,Ыстық әрі ылғалды.
Dialogue: 0,0:15:58.04,0:16:00.37,Default,,0,0,0,,Бұл жеңіл сауна сияқты.
Dialogue: 0,0:16:00.46,0:16:04.25,Default,,0,0,0,,Бұл бөлмеде кондиционер жоқ екені рас.
Dialogue: 0,0:16:04.33,0:16:07.50,Default,,0,0,0,,Мен сізге кейінірек жанкүйер әкелемін.
Dialogue: 0,0:16:07.59,0:16:10.38,Default,,0,0,0,,О, бұл көмектеседі...
Dialogue: 0,0:16:12.09,0:16:15.93,Default,,0,0,0,,! Неге біреудің бөлмесінде демалып жатырсың?
Dialogue: 0,0:16:16.01,0:16:18.56,Default,,0,0,0,,А, өтінемін, уайымдама.
Dialogue: 0,0:16:18.64,0:16:21.98,Default,,0,0,0,,Мен сенің оқуыңа кедергі болмайтынына көз жеткіземін.
Dialogue: 0,0:16:22.06,0:16:25.11,Default,,0,0,0,,Олай болса, бұл бөлмеде болу қиынға соғудың қажеті жоқ.
Dialogue: 0,0:16:25.19,0:16:26.48,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:16:26.56,0:16:29.61,Default,,0,0,0,,Ағайындылар арасындағы тері
Dialogue: 0,0:16:31.32,0:16:33.32,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:16:34.82,0:16:37.74,Default,,0,0,0,,Урю-кун сенің үлкен апаң.
Dialogue: 0,0:16:37.83,0:16:40.37,Default,,0,0,0,,Маған біртүрлі қарайсың ба?
Dialogue: 0,0:16:46.33,0:16:48.21,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:16:48.29,0:16:50.09,Default,,0,0,0,,Ойлануды доғар!
Dialogue: 0,0:16:50.71,0:16:52.55,Default,,0,0,0,,Ммм~
Dialogue: 0,0:16:53.13,0:16:53.97,Default,,0,0,0,,Ах
Dialogue: 0,0:16:54.05,0:16:58.51,Default,,0,0,0,,Дұрыс, мен Урю-кунды өзіме үлгі етуді сұраймын деп ойлаймын.
Dialogue: 0,0:16:58.60,0:17:02.43,Default,,0,0,0,,Мен университетке тапсырма үшін адамның эскизін салуым керек.
Dialogue: 0,0:17:02.52,0:17:05.52,Default,,0,0,0,,Қарсы емеспін, бірақ қатты шулама, жарай ма?
Dialogue: 0,0:17:05.60,0:17:06.35,Default,,0,0,0,,Иә
Dialogue: 0,0:17:06.35,0:17:07.02,Default,,0,0,0,,Иә
Dialogue: 0,0:17:06.35,0:17:07.02,Default,,0,0,0,,(Жылжымалы есіктің ашылып-жабылу дыбысы)
Dialogue: 0,0:17:07.02,0:17:07.11,Default,,0,0,0,,(Жылжымалы есіктің ашылып-жабылу дыбысы)
Dialogue: 0,0:17:07.11,0:17:10.11,Default,,0,0,0,,(Жылжымалы есіктің ашылып-жабылу дыбысы)
Dialogue: 0,0:17:07.11,0:17:10.11,Default,,0,0,0,,Мен де желдеткішті әкелемін.
Dialogue: 0,0:17:15.53,0:17:17.62,Default,,0,0,0,,(Яшигенің гуілдеуі)
Dialogue: 0,0:17:19.24,0:17:20.62,Default,,0,0,0,,Ж-жарайды… Сатып алғаныңызға рахмет.
Dialogue: 0,0:17:21.37,0:17:23.75,Default,,0,0,0,,Сол түні мен кеш ұйықтағанымнан бері бірдеңе.
Dialogue: 0,0:17:23.83,0:17:27.75,Default,,0,0,0,,Түннің салмағы маған жабыса бастағандай...
Dialogue: 0,0:17:28.54,0:17:31.50,Default,,0,0,0,,Мен де бірдеңе сатып алайын.
Dialogue: 0,0:17:31.59,0:17:33.80,Default,,0,0,0,,Бүгінгі ас қандай?
Dialogue: 0,0:17:34.51,0:17:35.76,Default,,0,0,0,,Жоқ, ол жігіт!
Dialogue: 0,0:17:36.43,0:17:38.80,Default,,0,0,0,,Сен мені сүйесің...
Dialogue: 0,0:17:43.18,0:17:46.44,Default,,0,0,0,,Бұл жол бұрын да болған.
Dialogue: 0,0:17:46.52,0:17:49.31,Default,,0,0,0,,Урю-сан туралы не ойлайсың?
Dialogue: 0,0:17:49.40,0:17:51.65,Default,,0,0,0,,Менің ойымша, ол жақсы адам.
Dialogue: 0,0:17:53.74,0:17:55.82,Default,,0,0,0,,Тым көп ойламаңыз
Dialogue: 0,0:17:55.90,0:17:57.49,Default,,0,0,0,,Йошиге - отбасы
Dialogue: 0,0:17:57.57,0:18:00.12,Default,,0,0,0,,Ол дұрыс, мұның бәрі.
Dialogue: 0,0:18:00.20,0:18:02.87,Default,,0,0,0,,Бұл ағайындылар арасындағы тері асты, солай ма?
Dialogue: 0,0:18:26.43,0:18:28.06,Default,,0,0,0,,Эххе
Dialogue: 0,0:18:29.60,0:18:31.65,Default,,0,0,0,,Оны таптым! (Йосиге) Иә?
Dialogue: 0,0:18:31.73,0:18:35.11,Default,,0,0,0,,Осы бөлмеден таза емес жыныстық қатынастың иісі шығады!
Dialogue: 0,0:18:35.19,0:18:37.49,Default,,0,0,0,,Мен оны жоқ деп ойлағанымда, міне, ол!
Dialogue: 0,0:18:37.57,0:18:41.24,Default,,0,0,0,,Мүлдем! Әйел қарама-қарсы жыныстағы бөлмеде қалай тұра алады?
Dialogue: 0,0:18:41.32,0:18:43.37,Default,,0,0,0,,Нашар Бұл өте таза емес!
Dialogue: 0,0:18:43.45,0:18:45.83,Default,,0,0,0,,Сіз дұрыс деп ойлаймын...
Dialogue: 0,0:18:45.91,0:18:47.87,Default,,0,0,0,,Сен солай айтып тұрсың ба, Асахиме?
Dialogue: 0,0:18:47.96,0:18:49.75,Default,,0,0,0,,Тыныш
Dialogue: 0,0:19:02.68,0:19:05.52,Default,,0,0,0,,Егер солай болса, жақсы...
Dialogue: 0,0:19:05.60,0:19:08.31,Default,,0,0,0,,Тым ұзақ қалмаңыз.
Dialogue: 0,0:19:08.39,0:19:10.02,Default,,0,0,0,,Асахиме барайық
Dialogue: 0,0:19:11.31,0:19:12.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:19.24,0:19:20.66,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:19:25.24,0:19:28.37,Default,,0,0,0,,(Яшигенің гуілдеуі)
Dialogue: 0,0:19:40.38,0:19:43.39,Default,,0,0,0,,Сол түнгі үкіден бері
Dialogue: 0,0:19:43.47,0:19:46.76,Default,,0,0,0,,Асахиме мен Яшиге біртүрлі әрекет етеді...
Dialogue: 0,0:19:46.85,0:19:48.14,Default,,0,0,0,,Әсіресе Йошиге
Dialogue: 0,0:19:48.22,0:19:51.52,Default,,0,0,0,,Соңғы кездері мен оған жақындай бастадым.
Dialogue: 0,0:19:51.60,0:19:54.02,Default,,0,0,0,,Сол кезде бірдеңе болған болуы керек...
Dialogue: 0,0:19:56.94,0:19:57.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:01.74,0:20:04.16,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:20:09.33,0:20:10.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:48.49,0:20:49.91,Default,,0,0,0,,Я...
Dialogue: 0,0:20:51.00,0:20:51.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:10.60,0:21:11.85,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:35.08,0:21:37.58,Default,,0,0,0,,Балалар мұнда не істеп жүрсіңдер?
Dialogue: 0,0:21:37.67,0:21:38.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:38.75,0:21:40.25,Default,,0,0,0,,Эххе~
Dialogue: 0,0:21:40.34,0:21:41.92,Default,,0,0,0,,Жоқ... бұл ештеңе емес!
Dialogue: 0,0:21:42.01,0:21:44.47,Default,,0,0,0,,Мен жаңа ғана қыздар түнін өткізіп жатыр едім!
Dialogue: 0,0:21:44.55,0:21:48.09,Default,,0,0,0,,Рахмет, Урю-кун, қайырлы түн~
Dialogue: 0,0:21:48.18,0:21:51.01,Default,,0,0,0,,(Жылжымалы есіктің ашылып-жабылу дыбысы)
Dialogue: 0,0:21:52.27,0:21:53.93,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:21:54.02,0:21:56.98,Default,,0,0,0,,Апалы-сіңлілі үшеу бұрынғыдай шулы.
Dialogue: 0,0:21:59.98,0:22:04.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:24.90,0:23:29.90,Default,,0,0,0,,～♪
