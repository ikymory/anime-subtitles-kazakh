Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.79,0:00:02.92,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:00:03.00,0:00:06.79,Default,,0,0,0,,Басқаша айтқанда, Урю Камишу мырза және Хакуджи Цуруяма мырза
Dialogue: 0,0:00:06.88,0:00:11.13,Default,,0,0,0,,Сонда сен басқа әлемнен келдің бе?
Dialogue: 0,0:00:11.22,0:00:14.51,Default,,0,0,0,,А... сен маған оңай сенесің.
Dialogue: 0,0:00:14.59,0:00:18.76,Default,,0,0,0,,Құдайдың басшылығы кейде адам түсінігінен оңай асып түседі.
Dialogue: 0,0:00:18.85,0:00:20.85,Default,,0,0,0,,Бұл солай болуы мүмкін.
Dialogue: 0,0:00:20.93,0:00:21.77,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:00:21.85,0:00:24.77,Default,,0,0,0,,Шеберден күткендей! Жылдам сөйлесу пайдалы
Dialogue: 0,0:00:24.85,0:00:27.40,Default,,0,0,0,,Мастер сүйкімді емес, сондықтан тоқтаңыз.
Dialogue: 0,0:00:27.48,0:00:30.44,Default,,0,0,0,,Ол керемет аурасы бар адамға ұқсайды.
Dialogue: 0,0:00:30.53,0:00:31.69,Default,,0,0,0,,О
Dialogue: 0,0:00:31.78,0:00:34.57,Default,,0,0,0,,Бұл адам оғаш құбылыстармен таныс болса да,
Dialogue: 0,0:00:34.66,0:00:36.41,Default,,0,0,0,,Мұнда таңқаларлық ештеңе жоқ.
Dialogue: 0,0:00:36.49,0:00:38.87,Default,,0,0,0,,Сен маған сене аласың, Йойфука-сан.
Dialogue: 0,0:00:38.95,0:00:40.24,Default,,0,0,0,,Айтпақшы, Хакуджи мырза
Dialogue: 0,0:00:40.33,0:00:41.79,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:00:42.00,0:00:44.29,Default,,0,0,0,,Менің ғибадатханада әулие қыз болғың келе ме?
Dialogue: 0,0:00:44.37,0:00:45.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:45.29,0:00:47.25,Default,,0,0,0,,Сүйкімді болсаң, мен оны алатыныма сенімдімін...
Dialogue: 0,0:00:47.33,0:00:51.17,Default,,0,0,0,,О, көптеген тұтынушылар риза болады.
Dialogue: 0,0:00:51.26,0:00:53.67,Default,,0,0,0,,Өйткені, бұл адам қай әлемде жүрсе де ешқашан өзгермейді!
Dialogue: 0,0:00:53.76,0:00:54.97,Default,,0,0,0,,(Йофуканың жөтелі)
Dialogue: 0,0:00:55.05,0:00:58.72,Default,,0,0,0,,Қалжыңы былай тұрсын, жағдайды түсінемін.
Dialogue: 0,0:00:58.80,0:01:01.18,Default,,0,0,0,,Бұл шешім емес, бірақ...
Dialogue: 0,0:01:01.85,0:01:05.94,Default,,0,0,0,,Білгенімді айтайын.
Dialogue: 0,0:01:06.02,0:01:07.44,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:01:07.52,0:01:09.02,Default,,0,0,0,,Сіз күткендей, ұстаз!
Dialogue: 0,0:01:09.11,0:01:11.44,Default,,0,0,0,,Сондықтан, ұстаз, тоқтаңыз.
Dialogue: 0,0:01:11.53,0:01:14.95,Default,,0,0,0,,Мен Йойфука-санмен кеңескеніме қуаныштымын.
Dialogue: 0,0:01:15.03,0:01:19.33,Default,,0,0,0,,Шынымды айтсам, бұл ғылыми фантастикалық оқиға сияқты, бірақ мен бізбен не болып жатқанын білмеймін ...
Dialogue: 0,0:01:19.41,0:01:21.20,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:01:21.29,0:01:22.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:22.20,0:01:24.79,Default,,0,0,0,,Бұл өзін ғибадатханаға қойған әрбір адамға арналған.
Dialogue: 0,0:01:24.87,0:01:27.29,Default,,0,0,0,,Бұл өте таныс нәрсе.
Dialogue: 0,0:01:27.37,0:01:28.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:30.13,0:01:34.34,Default,,0,0,0,,Дәл қазір Урю мырза мен оның әріптестері дәл осындай құбылысты басынан өткеріп жатыр.
Dialogue: 0,0:01:34.42,0:01:37.93,Default,,0,0,0,,Мұны бәріңіз білесіздер.
Dialogue: 0,0:01:38.43,0:01:40.72,Default,,0,0,0,,«Неке»
Dialogue: 0,0:01:43.06,0:01:45.68,Default,,0,0,0,,Шет... түйін?
Dialogue: 0,0:01:45.77,0:01:47.48,Default,,0,0,0,,Енді бәрі.
Dialogue: 0,0:01:47.56,0:01:50.27,Default,,0,0,0,,Құдай бізді қалай байланыстырады?
Dialogue: 0,0:01:50.36,0:01:51.44,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:01:52.73,0:01:54.32,Default,,0,0,0,,Хехехе
Dialogue: 0,0:01:54.94,0:01:56.70,Default,,0,0,0,,«Сәйкестік» дегеніміз не?
Dialogue: 0,0:01:56.78,0:01:59.82,Default,,0,0,0,,«Осы дүние» мен «басқа әлемді» байланыстырады дейді.
Dialogue: 0,0:01:59.91,0:02:01.95,Default,,0,0,0,,Бұл Құдайдың ісі
Dialogue: 0,0:02:02.03,0:02:04.08,Default,,0,0,0,,Вакатсуйо?
Dialogue: 0,0:02:04.16,0:02:06.58,Default,,0,0,0,,«Басқа әлем» деп жазылған «Басқа әлем»
Dialogue: 0,0:02:06.66,0:02:10.84,Default,,0,0,0,,Сөзбе-сөз «осы жерден басқа әлем» дегенді білдіреді.
Dialogue: 0,0:02:11.71,0:02:15.01,Default,,0,0,0,,Біз бұл әлемді «осы әлем» деп атаймыз.
Dialogue: 0,0:02:15.09,0:02:18.47,Default,,0,0,0,,Басқа әлемдер «басқа әлемдер» деп аталады.
Dialogue: 0,0:02:18.55,0:02:20.22,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:02:20.30,0:02:24.10,Default,,0,0,0,,Бұл дүние мен үшін «басқа әлем» бола ма?
Dialogue: 0,0:02:24.18,0:02:28.27,Default,,0,0,0,,Бірақ бұл «басқа өмірдің» матчқа қандай қатысы бар?
Dialogue: 0,0:02:28.35,0:02:30.10,Default,,0,0,0,,Жақсы сұрақ.
Dialogue: 0,0:02:30.19,0:02:32.11,Default,,0,0,0,,-да біз сәйкестік жүйесін түсіндіреміз.
Dialogue: 0,0:02:32.19,0:02:34.73,Default,,0,0,0,,Түсінікті түрде түсіндірейік
Dialogue: 0,0:02:34.82,0:02:38.28,Default,,0,0,0,,Ең алдымен, «қарым-қатынас» адамдар арасындағы байланыстар.
Dialogue: 0,0:02:38.36,0:02:40.70,Default,,0,0,0,,Туғаннан бастап анықталады.
Dialogue: 0,0:02:40.78,0:02:42.74,Default,,0,0,0,,Бұл тағдыр сияқты
Dialogue: 0,0:02:43.45,0:02:44.49,Default,,0,0,0,,Бұл дүниеде
Dialogue: 0,0:02:44.58,0:02:47.87,Default,,0,0,0,,Балапан мен түлкі қосылатын дүние делік.
Dialogue: 0,0:02:47.96,0:02:49.37,Default,,0,0,0,,Сіздің таңдауыңыз қандай?
Dialogue: 0,0:02:50.46,0:02:51.92,Default,,0,0,0,,Дегенмен, бұл шет
Dialogue: 0,0:02:52.00,0:02:53.75,Default,,0,0,0,,Шексіз тармақталу
Dialogue: 0,0:02:53.84,0:02:55.42,Default,,0,0,0,,Қанша мүмкіндік болса, сонша мүмкіндік
Dialogue: 0,0:02:55.50,0:02:57.76,Default,,0,0,0,,«Басқа әлем» бар.
Dialogue: 0,0:02:57.84,0:03:01.18,Default,,0,0,0,,Сүйген адамыңа қосылатын дүние бар.
Dialogue: 0,0:03:01.26,0:03:03.89,Default,,0,0,0,,Әрине, бұл мүмкін емес дүниелер де бар.
Dialogue: 0,0:03:03.97,0:03:07.47,Default,,0,0,0,,Құдай мұның бәрін түсінді.
Dialogue: 0,0:03:07.56,0:03:09.14,Default,,0,0,0,,Керемет Құдай!
Dialogue: 0,0:03:09.23,0:03:12.02,Default,,0,0,0,,Құдайдың құдіретімен
Dialogue: 0,0:03:12.10,0:03:14.48,Default,,0,0,0,,Жіп байлау сияқты
Dialogue: 0,0:03:14.57,0:03:16.82,Default,,0,0,0,,Мен сүйген адаммен байланысым жоқ «Бұл әлем».
Dialogue: 0,0:03:16.90,0:03:20.24,Default,,0,0,0,,«Бөлек өмірді» жалғаулармен байланыстыруға болады.
Dialogue: 0,0:03:21.20,0:03:24.53,Default,,0,0,0,,Бұл Құдайдың жасаған «сәйкестігі».
Dialogue: 0,0:03:26.33,0:03:28.29,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:03:28.37,0:03:31.54,Default,,0,0,0,,Шынымды айтсам, мен әлі түсінбеймін...
Dialogue: 0,0:03:31.62,0:03:33.54,Default,,0,0,0,,Сәлем, балалар...
Dialogue: 0,0:03:33.88,0:03:36.17,Default,,0,0,0,,Хаха, бұл керемет! (Асахиме) Ахх...
Dialogue: 0,0:03:36.25,0:03:39.34,Default,,0,0,0,,Параллель дүниелер байланысты ма?
Dialogue: 0,0:03:39.42,0:03:42.93,Default,,0,0,0,,Менің ойымша, оны қайтару үшін бұл қосылымды жою керек пе?
Dialogue: 0,0:03:43.01,0:03:45.43,Default,,0,0,0,,Таң қаларлықтай тыныш! Күтілгендей, A рейтингі
Dialogue: 0,0:03:45.51,0:03:47.85,Default,,0,0,0,,Біз де жақсы түсіндік, солай ма?
Dialogue: 0,0:03:47.93,0:03:49.85,Default,,0,0,0,,«Шингюарити», солай ма?
Dialogue: 0,0:03:49.93,0:03:52.02,Default,,0,0,0,,Түсінбегендей кейіп танытпа!
Dialogue: 0,0:03:52.10,0:03:54.77,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:03:54.86,0:03:55.86,Default,,0,0,0,,Оян!
Dialogue: 0,0:03:55.94,0:03:59.57,Default,,0,0,0,,Түсіндім! Басқаша айтқанда, әлемдегі параллель фильмдер мен драмалар
Dialogue: 0,0:03:59.65,0:04:01.65,Default,,0,0,0,,Мұның бәрі шындық болды!
Dialogue: 0,0:04:01.74,0:04:02.70,Default,,0,0,0,,Қарапайым ақымақ!
Dialogue: 0,0:04:02.78,0:04:05.91,Default,,0,0,0,,Хмм, бәрі өте сүйкімді, сондықтан барлығына бір жастық!
Dialogue: 0,0:04:05.99,0:04:06.83,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:07.83,0:04:10.16,Default,,0,0,0,,Бұл ұзақ, бірақ қорытындылау үшін...
Dialogue: 0,0:04:10.79,0:04:13.12,Default,,0,0,0,,Егер сіз өзіңіздің бастапқы әлеміңізге оралғыңыз келсе
Dialogue: 0,0:04:13.21,0:04:15.92,Default,,0,0,0,,Өйткені, мен тілегімді орындаған Аллаға барамын.
Dialogue: 0,0:04:16.00,0:04:18.21,Default,,0,0,0,,Менің барудан басқа амалым жоқ сияқты.
Dialogue: 0,0:04:18.88,0:04:20.92,Default,,0,0,0,,Қараңғы Құдай...
Dialogue: 0,0:04:21.55,0:04:24.22,Default,,0,0,0,,Мен сізге көмектесе алатыным осы ғана.
Dialogue: 0,0:04:24.30,0:04:26.14,Default,,0,0,0,,Сізге сәттілік тілеймін.
Dialogue: 0,0:04:26.22,0:04:28.56,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:04:28.64,0:04:31.02,Default,,0,0,0,,Біз де көп нәрсені үйрендік, ұстаз!
Dialogue: 0,0:04:31.10,0:04:33.31,Default,,0,0,0,,Сондықтан менің қожайыным...мех!
Dialogue: 0,0:04:34.98,0:04:35.81,Default,,0,0,0,,Йойфука-сан
Dialogue: 0,0:04:36.86,0:04:39.02,Default,,0,0,0,,Соңында мен сізге сұрақ қоя аламын ба?
Dialogue: 0,0:04:39.11,0:04:40.57,Default,,0,0,0,,(Танжиро) Толық шоғырланған тыныс алуды сақтай отырып жаттығу енді екінші табиғатқа айнала бастады.
Dialogue: 0,0:04:40.65,0:04:43.40,Default,,0,0,0,,Мен бұл туралы көптен бері ойлап жүрдім.
Dialogue: 0,0:04:43.49,0:04:46.99,Default,,0,0,0,,Күн жарық болса да, мен бұл дүниені өзгерткім келді...
Dialogue: 0,0:04:47.66,0:04:51.29,Default,,0,0,0,,Неліктен менің естеліктерім қалады?
Dialogue: 0,0:04:51.79,0:04:53.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:53.41,0:04:55.33,Default,,0,0,0,,Мен бұрын естіген теория болса
Dialogue: 0,0:04:55.42,0:04:58.71,Default,,0,0,0,,Менде бұл дүние туралы естеліктердің жоқтығы біртүрлі емес пе?
Dialogue: 0,0:05:00.71,0:05:03.01,Default,,0,0,0,,Жақсы сұрақ.
Dialogue: 0,0:05:03.59,0:05:05.01,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:06.14,0:05:09.89,Default,,0,0,0,,Мұны білуге ​​әлі ерте.
Dialogue: 0,0:05:10.56,0:05:11.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:11.93,0:05:13.81,Default,,0,0,0,,Онда мен мұны істеймін.
Dialogue: 0,0:05:13.89,0:05:15.56,Default,,0,0,0,,Эй... күт!
Dialogue: 0,0:05:15.64,0:05:17.40,Default,,0,0,0,,Өйткені, Йойфука-сан да
Dialogue: 0,0:05:17.48,0:05:20.44,Default,,0,0,0,,Сенің бастапқы әлеміңде мен туралы естеліктер жоқ па?
Dialogue: 0,0:05:21.07,0:05:23.11,Default,,0,0,0,,Жек көру? мен және сен
Dialogue: 0,0:05:23.19,0:05:25.45,Default,,0,0,0,,Біз алғаш рет кездестік.
Dialogue: 0,0:05:25.53,0:05:27.32,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,0:05:27.41,0:05:31.33,Default,,0,0,0,,Бұл жолы ғана емес, тіпті Танабата кезінде де шығар...
Dialogue: 0,0:05:32.91,0:05:35.04,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:05:35.12,0:05:37.58,Default,,0,0,0,,Мен... сәл қобалжып тұрмын.
Dialogue: 0,0:05:37.67,0:05:41.00,Default,,0,0,0,,Йойфука-сан біз жақта, солай ма?
Dialogue: 0,0:05:43.01,0:05:44.42,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:45.92,0:05:49.09,Default,,0,0,0,,Мен Құдай жағындамын
Dialogue: 0,0:05:49.68,0:05:50.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:52.06,0:05:54.10,Default,,0,0,0,,Сіз сенімдісіз бе? Урю мырза
Dialogue: 0,0:05:54.18,0:05:58.35,Default,,0,0,0,,Сіздің шешіміңіз қаншалықты қатыгез?
Dialogue: 0,0:05:58.44,0:06:03.36,Default,,0,0,0,,Бүгінгі әңгімені мұқият еске түсіріп, дайындалыңыз.
Dialogue: 0,0:06:11.20,0:06:13.87,Default,,0,0,0,,Йойфука-сан, бұл аздап қорқынышты болды.
Dialogue: 0,0:06:13.95,0:06:15.12,Default,,0,0,0,,Иә
Dialogue: 0,0:06:15.75,0:06:18.92,Default,,0,0,0,,«Неке» «Басқа өмір»
Dialogue: 0,0:06:20.21,0:06:22.34,Default,,0,0,0,,Түсіндім, түсінбедім! Мен ойлауды тоқтаттым
Dialogue: 0,0:06:22.42,0:06:23.25,Default,,0,0,0,,Не!
Dialogue: 0,0:06:23.34,0:06:25.05,Default,,0,0,0,,Мен кенеттен ақымақ болып кеттім.
Dialogue: 0,0:06:25.13,0:06:27.01,Default,,0,0,0,,Маған айтқаныңды қаламаймын
Dialogue: 0,0:06:27.63,0:06:29.18,Default,,0,0,0,,Мұндай қиял
Dialogue: 0,0:06:29.26,0:06:32.01,Default,,0,0,0,,Мен бұл туралы ойлаудың қажеті жоқ деп ойладым.
Dialogue: 0,0:06:32.64,0:06:35.81,Default,,0,0,0,,Әзірге алдымызда не істеу керек болса соны істейік.
Dialogue: 0,0:06:35.89,0:06:37.52,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:06:37.60,0:06:42.65,Default,,0,0,0,,Олай болса, ертең Қараңғы Құдайдың мекеніне барайық!
Dialogue: 0,0:06:42.73,0:06:44.57,Default,,0,0,0,,Оу!
Dialogue: 0,0:06:47.32,0:06:48.74,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:50.03,0:06:52.32,Default,,0,0,0,,Бұл өте ауыр болды.
Dialogue: 0,0:06:52.41,0:06:56.79,Default,,0,0,0,,Жарайды, қалағаныңызша алдауға болады.
Dialogue: 0,0:06:57.83,0:07:00.79,Default,,0,0,0,,Оның үстіне бұл жақсы мүмкіндік.
Dialogue: 0,0:07:01.63,0:07:07.05,Default,,0,0,0,,Бұл «сәйкестік» олардың өмірінің негізгі тасына айналады.
Dialogue: 0,0:07:08.38,0:07:11.34,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:07:11.43,0:07:17.10,Default,,0,0,0,,Мен... Қараңғы Құдай ғибадатханасы таулардың тереңінде екенін ұмытып кеттім.
Dialogue: 0,0:07:17.18,0:07:20.10,Default,,0,0,0,,Шаршадыңыз ба? Сен сондай жалқаусың.
Dialogue: 0,0:07:20.19,0:07:21.44,Default,,0,0,0,,Ахаха
Dialogue: 0,0:07:21.52,0:07:24.48,Default,,0,0,0,,Бұл қара құдайдың сиқыры ма?
Dialogue: 0,0:07:24.57,0:07:26.48,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:07:26.57,0:07:28.44,Default,,0,0,0,,Қаласақ
Dialogue: 0,0:07:28.53,0:07:31.11,Default,,0,0,0,,Бон Кют Бон! болғым келеді
Dialogue: 0,0:07:31.20,0:07:35.33,Default,,0,0,0,,Мен котят үйіндісіне көмілгім келеді!
Dialogue: 0,0:07:35.83,0:07:40.37,Default,,0,0,0,,Аспанда ұшқым келеді! Мен аспанда ұшқым келеді!
Dialogue: 0,0:07:40.46,0:07:44.17,Default,,0,0,0,,Мен үшін дұға еткен Құдайдың таңырқаған жүзін көріп тұрмын...
Dialogue: 0,0:07:44.25,0:07:46.42,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:07:46.50,0:07:49.38,Default,,0,0,0,,Қаласаңыз, бұл тегін.
Dialogue: 0,0:07:49.46,0:07:50.67,Default,,0,0,0,,Және...
Dialogue: 0,0:07:50.76,0:07:54.76,Default,,0,0,0,,Тілектерді орындайтын Құдай да, басқа ешкім де емес.
Dialogue: 0,0:07:54.85,0:07:56.35,Default,,0,0,0,,Өзі
Dialogue: 0,0:07:56.43,0:07:57.81,Default,,0,0,0,,Дұрыс? (Асахиме/Яшиге) Дұрыс па?
Dialogue: 0,0:07:58.68,0:08:01.85,Default,,0,0,0,,Иә? Бірақ неге олай ойладың?
Dialogue: 0,0:08:01.94,0:08:05.94,Default,,0,0,0,,Енді мен Камишу-кун осылай айтатын сияқтымын.
Dialogue: 0,0:08:06.02,0:08:08.86,Default,,0,0,0,,Мен де солай ойладым~
Dialogue: 0,0:08:13.03,0:08:16.28,Default,,0,0,0,,Сізді осы жерден шығарып салайық па?
Dialogue: 0,0:08:16.37,0:08:19.16,Default,,0,0,0,,Бірақ ол әлі де жұмыс істей ме деп ойлаймын...
Dialogue: 0,0:08:19.24,0:08:21.16,Default,,0,0,0,,Жақсы болатынына сенімдімін.
Dialogue: 0,0:08:21.25,0:08:25.04,Default,,0,0,0,,Оның үстіне бұл қоштасу емес.
Dialogue: 0,0:08:25.13,0:08:29.05,Default,,0,0,0,,Дүние қандай болмасын, бәріміз бір-бірімен байланыстымыз.
Dialogue: 0,0:08:30.51,0:08:32.30,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:08:33.47,0:08:35.68,Default,,0,0,0,,Ах, тағы кездескенше
Dialogue: 0,0:08:39.68,0:08:41.43,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:08:41.52,0:08:43.81,Default,,0,0,0,,Әрине, қалаусыз
Dialogue: 0,0:08:43.89,0:08:45.81,Default,,0,0,0,,Біздің қарым-қатынасымыз...
Dialogue: 0,0:08:46.40,0:08:48.82,Default,,0,0,0,,Оны өзіміз байлап аламыз.
Dialogue: 0,0:09:00.08,0:09:03.71,Default,,0,0,0,,Қайтып оралғанда ғибадатханада тағы бір оқу сабағын өткізе аламыз ба?
Dialogue: 0,0:09:03.79,0:09:05.37,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:05.46,0:09:07.08,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:09:07.17,0:09:09.09,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:09:09.17,0:09:10.55,Default,,0,0,0,,Адамдар арасындағы қарым-қатынас қандай?
Dialogue: 0,0:09:10.63,0:09:11.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:15.05,0:09:16.76,Default,,0,0,0,,Қараңғы Құдай мырза?
Dialogue: 0,0:09:16.84,0:09:17.84,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:20.51,0:09:22.60,Default,,0,0,0,,Түлкінің маскасына ұқсайды, бірақ...
Dialogue: 0,0:09:22.68,0:09:24.85,Default,,0,0,0,,Бұл бұғы маскасына ұқсайды.
Dialogue: 0,0:09:27.65,0:09:28.98,Default,,0,0,0,,(Кашива қолы)
Dialogue: 0,0:09:29.61,0:09:31.98,Default,,0,0,0,,Қараңғы Құдай-сан Қараңғы Құдай-сан
Dialogue: 0,0:09:32.07,0:09:35.61,Default,,0,0,0,,Менің тілегімді тағы бір рет тыңдаңыз.
Dialogue: 0,0:09:36.24,0:09:39.87,Default,,0,0,0,,Бұл дүниені өзіңіз үшін қаласаңыз да, қазір бұлай айту қиын.
Dialogue: 0,0:09:39.95,0:09:42.79,Default,,0,0,0,,Бұл менмендік болып көрінуі мүмкін
Dialogue: 0,0:09:43.58,0:09:45.91,Default,,0,0,0,,Мен кез келген жазаны алуға дайынмын.
Dialogue: 0,0:09:46.00,0:09:48.08,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:09:48.83,0:09:52.63,Default,,0,0,0,,Мені және Урюды біздің бастапқы әлемімізге қайтаруыңызды өтінемін!
Dialogue: 0,0:09:59.30,0:10:00.97,Default,,0,0,0,,Сіз шынымен үйге барғыңыз келе ме?
Dialogue: 0,0:10:01.05,0:10:02.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:02.89,0:10:05.73,Default,,0,0,0,,Өкінбейтініңізге сенімдісіз бе?
Dialogue: 0,0:10:07.06,0:10:08.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:09.23,0:10:12.90,Default,,0,0,0,,Жарайды, мен сенің тілегіңді тыңдаймын.
Dialogue: 0,0:10:12.98,0:10:15.65,Default,,0,0,0,,Ах... Рахмет!
Dialogue: 0,0:10:25.33,0:10:26.41,Default,,0,0,0,,Урю?
Dialogue: 0,0:10:26.50,0:10:28.71,Default,,0,0,0,,Шындық болу үшін тым жақсы естіледі ме?
Dialogue: 0,0:10:28.79,0:10:29.79,Default,,0,0,0,,Жалпы неге
Dialogue: 0,0:10:29.88,0:10:33.42,Default,,0,0,0,,Алла тағала адамдардың тілегін осылай оңай бере ала ма?
Dialogue: 0,0:10:34.71,0:10:36.72,Default,,0,0,0,,Оның қандай да бір мақсаты бар ма?
Dialogue: 0,0:10:36.80,0:10:38.55,Default,,0,0,0,,Тапа күндіз шынымен жақсы бола ма?
Dialogue: 0,0:10:38.63,0:10:40.93,Default,,0,0,0,,Одан құтылудың жолы жоқ, солай ма?
Dialogue: 0,0:10:41.01,0:10:41.85,Default,,0,0,0,,А...
Dialogue: 0,0:10:41.93,0:10:47.06,Default,,0,0,0,,Бұл ол «сәйкестік» арқылы сізбен байланысатын әлем.
Dialogue: 0,0:10:47.14,0:10:51.52,Default,,0,0,0,,Егер сіз бұл дүниені қайтарғыңыз келсе, оның құнын төлеуіңіз керек.
Dialogue: 0,0:10:51.61,0:10:53.02,Default,,0,0,0,,Өтемақы?
Dialogue: 0,0:10:53.98,0:10:56.49,Default,,0,0,0,,«Байланысты үзу» деген нені білдіреді
Dialogue: 0,0:10:56.57,0:10:59.95,Default,,0,0,0,,Түпнұсқа әлемде ол және сіз біртұтас боласыз.
Dialogue: 0,0:11:00.03,0:11:01.62,Default,,0,0,0,,Ешқашан мүмкін емес
Dialogue: 0,0:11:01.70,0:11:05.41,Default,,0,0,0,,Ол дүниенің тағдырымен анықталады
Dialogue: 0,0:11:05.49,0:11:10.37,Default,,0,0,0,,Оның бәрі жақсы болады деп ойлайсың ба?
Dialogue: 0,0:11:10.46,0:11:13.13,Default,,0,0,0,,Онымен жақсы қарым-қатынасымды үзсем де
Dialogue: 0,0:11:13.21,0:11:16.96,Default,,0,0,0,,Сіздің бастапқы әлеміңізге оралғыңыз келетін себептер бар ма?
Dialogue: 0,0:11:17.51,0:11:18.92,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:11:20.01,0:11:22.18,Default,,0,0,0,,Уау! (Урю) Жоқ... Бұл қай жер?
Dialogue: 0,0:11:24.35,0:11:26.35,Default,,0,0,0,,«Жолдарды бөлу»
Dialogue: 0,0:11:28.77,0:11:32.44,Default,,0,0,0,,Осы жолмен жүрсең, бастапқы әлемге қайтасың.
Dialogue: 0,0:11:32.52,0:11:35.86,Default,,0,0,0,,Ол жаққа барсаң, қазіргі әлемге жетесің.
Dialogue: 0,0:11:36.40,0:11:38.40,Default,,0,0,0,,Мен сізден тағы сұраймын.
Dialogue: 0,0:11:38.90,0:11:42.91,Default,,0,0,0,,Сіз өзіңіздің бастапқы әлеміңізге шынымен оралғыңыз келе ме?
Dialogue: 0,0:11:43.78,0:11:47.95,Default,,0,0,0,,Сіздің шешіміңіз қаншалықты қатыгез?
Dialogue: 0,0:11:48.04,0:11:52.96,Default,,0,0,0,,Бүгінгі әңгімені мұқият еске түсіріп, дайындал.
Dialogue: 0,0:11:54.96,0:11:57.00,Default,,0,0,0,,Жауабын тыңдайын ба?
Dialogue: 0,0:11:58.51,0:12:00.88,Default,,0,0,0,,О... мен...
Dialogue: 0,0:12:00.97,0:12:02.38,Default,,0,0,0,,Урю
Dialogue: 0,0:12:07.72,0:12:08.85,Default,,0,0,0,,Урю
Dialogue: 0,0:12:08.93,0:12:09.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:12.10,0:12:13.27,Default,,0,0,0,,Маған ұнады!
Dialogue: 0,0:12:13.35,0:12:17.57,Default,,0,0,0,,Урю туралы Мен оны көптен бері жақсы көремін!
Dialogue: 0,0:12:17.65,0:12:21.57,Default,,0,0,0,,Ол дос емес, нарциссист және қыңыр.
Dialogue: 0,0:12:21.65,0:12:23.61,Default,,0,0,0,,Байыпты, еңбекқор және салқын.
Dialogue: 0,0:12:23.70,0:12:25.12,Default,,0,0,0,,Аңғал және тұнық
Dialogue: 0,0:12:25.20,0:12:28.83,Default,,0,0,0,,Бұл аздап өңдеуді қажет етеді, бірақ төтенше жағдайда оған сенуге болады.
Dialogue: 0,0:12:28.91,0:12:32.04,Default,,0,0,0,,Маған мұның бәрі ұнайды...
Dialogue: 0,0:12:32.12,0:12:35.25,Default,,0,0,0,,Өйткені, мен Урюдің қасында болғым келеді!
Dialogue: 0,0:12:35.33,0:12:38.04,Default,,0,0,0,,Мен Урюмен бақытты болғым келеді!
Dialogue: 0,0:12:39.09,0:12:40.71,Default,,0,0,0,,Күндізгі жарық...
Dialogue: 0,0:12:42.17,0:12:45.34,Default,,0,0,0,,Кешіріңіз, егер мен мұны басынан бастап істесем
Dialogue: 0,0:12:45.43,0:12:48.18,Default,,0,0,0,,Бұл болмауы керек еді...
Dialogue: 0,0:12:49.60,0:12:53.14,Default,,0,0,0,,Бірақ мен оны ұзақ айтуға қорықтым.
Dialogue: 0,0:12:54.19,0:12:55.56,Default,,0,0,0,,Сөзбен жеткізу...
Dialogue: 0,0:12:57.06,0:12:59.57,Default,,0,0,0,,Бұл соншалықты батылдықты қажет етеді.
Dialogue: 0,0:13:02.07,0:13:04.70,Default,,0,0,0,,Мұны айту қиын болуы мүмкін, бірақ
Dialogue: 0,0:13:04.78,0:13:07.66,Default,,0,0,0,,Мен Урюдың сезімін сөзбен де білдіргенін қалаймын.
Dialogue: 0,0:13:09.99,0:13:12.45,Default,,0,0,0,,Өтінемін, тыңдауға рұқсат етіңізші?
Dialogue: 0,0:13:14.62,0:13:18.17,Default,,0,0,0,,Менің... сезімдерім
Dialogue: 0,0:13:27.30,0:13:28.72,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:32.85,0:13:37.19,Default,,0,0,0,,Рахмет, Хакухи, мені ойлағаның үшін.
Dialogue: 0,0:13:37.81,0:13:40.36,Default,,0,0,0,,Мен сіздің сезімдеріңізге өте қуаныштымын.
Dialogue: 0,0:13:40.44,0:13:41.53,Default,,0,0,0,,Иә
Dialogue: 0,0:13:41.65,0:13:44.69,Default,,0,0,0,,Менің ойымша, сіз өте жақсы әйелсіз.
Dialogue: 0,0:13:44.78,0:13:49.07,Default,,0,0,0,,Мен жақсы оқи аламын...және әрине сүйкімді көрінемін.
Dialogue: 0,0:13:49.74,0:13:50.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:50.66,0:13:52.87,Default,,0,0,0,,Мен үшін бұл шынымен босқа кетті!
Dialogue: 0,0:13:52.95,0:13:55.58,Default,,0,0,0,,Мен қаншалықты бақыттымын деп ойлаймын!
Dialogue: 0,0:13:55.66,0:13:57.67,Default,,0,0,0,,бірақ тіпті ең кішкентай үміт сызығын беретін іздерді зерттеп көруім керек шығар.
Dialogue: 0,0:13:57.75,0:13:59.42,Default,,0,0,0,,Басқа! (Урю) А?
Dialogue: 0,0:13:59.50,0:14:02.25,Default,,0,0,0,,Неге сен бірінші мені жұбатпақсың?
Dialogue: 0,0:14:02.34,0:14:03.84,Default,,0,0,0,,Жоқ, бірақ... (тапа-тал түсте) Бұл не?
Dialogue: 0,0:14:03.92,0:14:06.01,Default,,0,0,0,,Егер сіз «Басқа адамға зиян тигізбестен қалай бас тартуға болады» деп іздесеңіз
Dialogue: 0,0:14:06.09,0:14:08.26,Default,,0,0,0,,Жақында пайда болатын сияқты көрінбейтін шаблонды сөйлем!
Dialogue: 0,0:14:08.34,0:14:09.64,Default,,0,0,0,,Бұл мүлдем резонанс тудырмайды!
Dialogue: 0,0:14:09.72,0:14:10.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:10.64,0:14:12.43,Default,,0,0,0,,Мен сенімен жақсымын
Dialogue: 0,0:14:12.51,0:14:16.27,Default,,0,0,0,,Әдемі ойнама, Урю қалай сезінетініңді айт!
Dialogue: 0,0:14:19.06,0:14:20.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:20.90,0:14:23.07,Default,,0,0,0,,Мен оларды бақытты еткім келеді!
Dialogue: 0,0:14:26.65,0:14:31.24,Default,,0,0,0,,Шынымды айтсам, менің оларға деген сезімім қандай?
Dialogue: 0,0:14:31.32,0:14:33.91,Default,,0,0,0,,Мен мұны өзім түсінбеймін.
Dialogue: 0,0:14:33.99,0:14:38.58,Default,,0,0,0,,Отбасы ретінде маңызды ма, әлде романтикалық сезімдер ме?
Dialogue: 0,0:14:39.58,0:14:44.09,Default,,0,0,0,,Бірақ дүние өзгеріп, мен ғибадатханамен байланысымды жоғалтқан кезде.
Dialogue: 0,0:14:44.17,0:14:47.34,Default,,0,0,0,,Мен олармен кездескім келді.
Dialogue: 0,0:14:47.42,0:14:51.09,Default,,0,0,0,,Мен сені енді тастағым келмейді, мен сенімен мәңгі бірге болғым келеді
Dialogue: 0,0:14:51.18,0:14:54.85,Default,,0,0,0,,Өмірімде бірінші рет осылай ойлауым.
Dialogue: 0,0:14:54.93,0:14:59.94,Default,,0,0,0,,Сол себепті мен матч жүйесін тыңдап, осы қоштасу жолында тұрдым.
Dialogue: 0,0:15:00.02,0:15:02.86,Default,,0,0,0,,Мен бұлай жүре алмаймын деп ойладым.
Dialogue: 0,0:15:02.94,0:15:04.98,Default,,0,0,0,,Басқа біреу емес
Dialogue: 0,0:15:05.07,0:15:09.11,Default,,0,0,0,,Мен оларды өз қолыммен қуантқым келеді.
Dialogue: 0,0:15:10.24,0:15:13.49,Default,,0,0,0,,Бұл әлемде күндізгі жарықпен байланысты,
Dialogue: 0,0:15:13.58,0:15:15.54,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:15:19.62,0:15:22.25,Default,,0,0,0,,Мен өзімнің бастапқы әлеміме оралғым келеді.
Dialogue: 0,0:15:23.25,0:15:24.75,Default,,0,0,0,,Асахимен бірге
Dialogue: 0,0:15:25.38,0:15:26.88,Default,,0,0,0,,Юнамен
Dialogue: 0,0:15:27.51,0:15:29.01,Default,,0,0,0,,Йошигемен бірге
Dialogue: 0,0:15:30.26,0:15:33.22,Default,,0,0,0,,Мен Кангами мырзамен қосылғым келеді!
Dialogue: 0,0:15:36.06,0:15:39.52,Default,,0,0,0,,Сонымен, күндізгі жарық... Кешіріңіз.
Dialogue: 0,0:15:40.69,0:15:44.06,Default,,0,0,0,,Хмм, сәттілік.
Dialogue: 0,0:15:45.98,0:15:47.36,Default,,0,0,0,,Ах! Бірақ... Бірақ сол себепті
Dialogue: 0,0:15:47.44,0:15:49.49,Default,,0,0,0,,Бұл тапа-тал түсте сүйкімділік жоқ дегенді білдірмейді!
Dialogue: 0,0:15:49.57,0:15:51.40,Default,,0,0,0,,Өйткені, мен сені өте жақсы әйел деп ойлаймын...
Dialogue: 0,0:15:51.49,0:15:53.11,Default,,0,0,0,,Дакара!
Dialogue: 0,0:15:53.20,0:15:55.66,Default,,0,0,0,,Мені жұбатуға тырыспа, айт!
Dialogue: 0,0:15:56.99,0:15:59.41,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:15:59.50,0:16:03.42,Default,,0,0,0,,Иә, рахмет, Қараңғы Құдай.
Dialogue: 0,0:16:03.50,0:16:05.42,Default,,0,0,0,,Тілегімді орындағаны үшін
Dialogue: 0,0:16:06.59,0:16:10.63,Default,,0,0,0,,Жоқ, тілегіңіз орындалмады.
Dialogue: 0,0:16:10.72,0:16:15.18,Default,,0,0,0,,Ал егер сіз байланыстарды үзсеңіз, ол енді ешқашан орындалмайды.
Dialogue: 0,0:16:15.26,0:16:19.22,Default,,0,0,0,,Жарайды. Тіпті байланысымыз үзілсе де...
Dialogue: 0,0:16:19.31,0:16:23.02,Default,,0,0,0,,Өйткені, мен Урюмен байланысымды жалғастырамын.
Dialogue: 0,0:16:23.10,0:16:26.23,Default,,0,0,0,,Дәл осы дүниеде Урюдің істегені сияқты
Dialogue: 0,0:16:27.27,0:16:28.90,Default,,0,0,0,,Күндізгі жарық...
Dialogue: 0,0:17:04.52,0:17:07.86,Default,,0,0,0,,А... Қанша жол жүрдің?
Dialogue: 0,0:17:08.57,0:17:11.78,Default,,0,0,0,,Бірақ бұл қара құдай қандай болды?
Dialogue: 0,0:17:14.28,0:17:15.53,Default,,0,0,0,,Ах
Dialogue: 0,0:17:15.61,0:17:18.99,Default,,0,0,0,,Бірақ менің айналамда бірдеңе дірілдей бастады.
Dialogue: 0,0:17:19.08,0:17:21.41,Default,,0,0,0,,Бұл рас, бірдеңе дұрыс емес!
Dialogue: 0,0:17:21.49,0:17:25.92,Default,,0,0,0,,Уф... Енді бұл дүниемен қоштаса аламыз.
Dialogue: 0,0:17:28.46,0:17:30.92,Default,,0,0,0,,Тапшық күнде кездескенше.
Dialogue: 0,0:17:48.86,0:17:53.19,Default,,0,0,0,,Иә, көріскенше, Урю.
Dialogue: 0,0:17:58.28,0:17:59.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:01.66,0:18:04.70,Default,,0,0,0,,Иә? Мұнда...
Dialogue: 0,0:18:06.46,0:18:08.96,Default,,0,0,0,,Сіз өзіңіздің бастапқы әлеміңізге оралдыңыз ба?
Dialogue: 0,0:18:09.04,0:18:11.84,Default,,0,0,0,,Ха! Сол жігіттер?
Dialogue: 0,0:18:11.92,0:18:14.09,Default,,0,0,0,,Асахиме!
Dialogue: 0,0:18:14.17,0:18:15.92,Default,,0,0,0,,Юна!
Dialogue: 0,0:18:16.42,0:18:18.59,Default,,0,0,0,,Яджу!
Dialogue: 0,0:18:18.68,0:18:20.85,Default,,0,0,0,,Хаха...
Dialogue: 0,0:18:20.93,0:18:24.60,Default,,0,0,0,,Неге... қайтып келмедің?
Dialogue: 0,0:18:24.68,0:18:28.19,Default,,0,0,0,,Біреу жоқ па?!
Dialogue: 0,0:18:28.27,0:18:29.85,Default,,0,0,0,,Біреу~!
Dialogue: 0,0:18:42.58,0:18:43.87,Default,,0,0,0,,А... Урю мырза?
Dialogue: 0,0:18:43.95,0:18:46.37,Default,,0,0,0,,Қашаннан бері осындай батыл адам болдыңыз?
Dialogue: 0,0:18:46.45,0:18:49.87,Default,,0,0,0,,Сен азғын, кәдімгі қылмыскерсің!
Dialogue: 0,0:18:49.96,0:18:53.63,Default,,0,0,0,,Хехе, Урю-кун да бала~
Dialogue: 0,0:18:53.71,0:18:55.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:55.21,0:18:57.42,Default,,0,0,0,,Мұрным қанып жылап тұрмын!
Dialogue: 0,0:18:57.51,0:19:01.01,Default,,0,0,0,,Бізді іш киімімізбен көріп қуандыңыз ба?
Dialogue: 0,0:19:01.09,0:19:03.39,Default,,0,0,0,,Мен мұны енді істей алмаймын. Бұл өте қауіпті!
Dialogue: 0,0:19:03.47,0:19:07.48,Default,,0,0,0,,Асахиме~Юна~Ёшиге~!
Dialogue: 0,0:19:07.56,0:19:09.89,Default,,0,0,0,,(Үш апаның айқайы)
Dialogue: 0,0:19:09.98,0:19:14.98,Default,,0,0,0,,♪～
Dialogue: 0,0:20:34.90,0:20:39.90,Default,,0,0,0,,～♪
Dialogue: 0,0:20:43.07,0:20:45.78,Default,,0,0,0,,Қаншама қиындықты бастан өткерсем де, ақыры қайтып оралдым...
Dialogue: 0,0:20:45.87,0:20:48.62,Default,,0,0,0,,...
Dialogue: 0,0:20:48.70,0:20:50.75,Default,,0,0,0,,Әй, ерінбе, күйесің!
Dialogue: 0,0:20:50.83,0:20:53.41,Default,,0,0,0,,...
Dialogue: 0,0:20:53.50,0:20:54.79,Default,,0,0,0,,...
Dialogue: 0,0:20:54.87,0:20:58.13,Default,,0,0,0,,...
Dialogue: 0,0:20:58.21,0:20:59.88,Default,,0,0,0,,...
Dialogue: 0,0:20:59.96,0:21:00.80,Default,,0,0,0,,Иә
Dialogue: 0,0:21:00.88,0:21:03.38,Default,,0,0,0,,...
Dialogue: 0,0:21:03.47,0:21:04.30,Default,,0,0,0,,Аһ!
Dialogue: 0,0:21:04.38,0:21:06.43,Default,,0,0,0,,...
Dialogue: 0,0:21:06.51,0:21:08.60,Default,,0,0,0,,...
Dialogue: 0,0:21:08.68,0:21:09.68,Default,,0,0,0,,...
Dialogue: 0,0:21:10.01,0:21:12.18,Default,,0,0,0,,（）～
Dialogue: 0,0:21:12.27,0:21:13.73,Default,,0,0,0,,...
Dialogue: 0,0:21:13.81,0:21:16.19,Default,,0,0,0,,...
Dialogue: 0,0:21:16.27,0:21:17.81,Default,,0,0,0,,Мені олай атама.
Dialogue: 0,0:21:17.90,0:21:19.57,Default,,0,0,0,,...
Dialogue: 0,0:21:19.65,0:21:21.36,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:21:21.44,0:21:23.07,Default,,0,0,0,,Мұны да пісіріңіз.
Dialogue: 0,0:21:23.15,0:21:24.61,Default,,0,0,0,,Данго?
Dialogue: 0,0:21:24.70,0:21:27.07,Default,,0,0,0,,...
Dialogue: 0,0:21:27.16,0:21:30.74,Default,,0,0,0,,...
Dialogue: 0,0:21:30.83,0:21:32.58,Default,,0,0,0,,...
Dialogue: 0,0:21:32.66,0:21:35.04,Default,,0,0,0,,...
Dialogue: 0,0:21:35.12,0:21:35.96,Default,,0,0,0,,Хмм!
Dialogue: 0,0:21:36.04,0:21:38.71,Default,,0,0,0,,...
Dialogue: 0,0:21:38.79,0:21:40.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:40.80,0:21:44.22,Default,,0,0,0,,...
Dialogue: 0,0:21:44.30,0:21:48.30,Default,,0,0,0,,２～
Dialogue: 0,0:21:48.39,0:21:49.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:50.51,0:21:54.31,Default,,0,0,0,,Бұл сіздің мәртебеңіз.
Dialogue: 0,0:21:55.31,0:21:56.31,Default,,0,0,0,,Не!
Dialogue: 0,0:21:56.39,0:21:58.69,Default,,0,0,0,,...
Dialogue: 0,0:21:58.77,0:22:01.90,Default,,0,0,0,,...
Dialogue: 0,0:22:01.98,0:22:03.44,Default,,0,0,0,,...
Dialogue: 0,0:22:03.53,0:22:04.82,Default,,0,0,0,,...
Dialogue: 0,0:22:04.90,0:22:08.57,Default,,0,0,0,,...
Dialogue: 0,0:22:11.78,0:22:14.20,Default,,0,0,0,,«Ми-кун» таң қалдырады.
Dialogue: 0,0:22:14.29,0:22:15.91,Default,,0,0,0,,...
Dialogue: 0,0:22:16.00,0:22:16.83,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:17.04,0:22:19.79,Default,,0,0,0,,...
Dialogue: 0,0:22:19.88,0:22:21.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:21.38,0:22:23.55,Default,,0,0,0,,Аха…
Dialogue: 0,0:22:23.63,0:22:24.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:24.55,0:22:26.17,Default,,0,0,0,,Хехе...
Dialogue: 0,0:22:26.97,0:22:28.51,Default,,0,0,0,,Урю-сан!
Dialogue: 0,0:22:28.59,0:22:29.55,Default,,0,0,0,,О?
Dialogue: 0,0:22:29.64,0:22:31.39,Default,,0,0,0,,Тамақ жетпейді!
Dialogue: 0,0:22:31.47,0:22:33.35,Default,,0,0,0,,...
Dialogue: 0,0:22:33.47,0:22:35.98,Default,,0,0,0,,Басқа дәмге тапсырыс беру уақыты келді!
Dialogue: 0,0:22:36.06,0:22:37.06,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:37.14,0:22:38.60,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:22:38.69,0:22:39.69,Default,,0,0,0,,...
Dialogue: 0,0:22:39.77,0:22:41.15,Default,,0,0,0,,Урю Ерекше Якисоба да
Dialogue: 0,0:22:41.23,0:22:42.19,Default,,0,0,0,,Мен саған той беремін!
Dialogue: 0,0:22:42.27,0:22:44.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:52.78,0:22:54.24,Default,,0,0,0,,Мияу (Урю) А...
Dialogue: 0,0:22:54.33,0:22:57.75,Default,,0,0,0,,Хохохо Бұл жақсы және жанды.
Dialogue: 0,0:22:57.83,0:23:00.71,Default,,0,0,0,,Сондықтан олар көп жұмысты қажет етеді.
Dialogue: 0,0:23:01.50,0:23:03.71,Default,,0,0,0,,Менде ешқандай эмоция немесе ештеңе жоқ...
Dialogue: 0,0:23:06.42,0:23:07.80,Default,,0,0,0,,Урю-сан!
Dialogue: 0,0:23:07.88,0:23:09.59,Default,,0,0,0,,Етіміз таусылады ма?
Dialogue: 0,0:23:09.68,0:23:12.22,Default,,0,0,0,,Мен де барлық тұшпараны жеймін!
Dialogue: 0,0:23:16.81,0:23:19.73,Default,,0,0,0,,О, енді кеттік!
Dialogue: 0,0:23:21.23,0:23:27.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
