Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.21,0:00:04.13,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:00:04.21,0:00:07.17,Default,,0,0,0,,Менің жігітім еш қиындық тудырмаса.
Dialogue: 0,0:00:07.25,0:00:09.55,Default,,0,0,0,,Хехе, ол үшін уайымдама
Dialogue: 0,0:00:09.63,0:00:12.13,Default,,0,0,0,,Мен де ата-анамнан рұқсат алдым.
Dialogue: 0,0:00:12.22,0:00:14.97,Default,,0,0,0,,Қиындыққа тап болған кезде бір-бірімізбен біргеміз.
Dialogue: 0,0:00:15.05,0:00:16.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:16.26,0:00:20.18,Default,,0,0,0,,Саса, суық тиіп қалмас бұрын жылыныңыз.
Dialogue: 0,0:00:20.27,0:00:21.81,Default,,0,0,0,,(ванна бөлмесінің есігі жабылған дыбыс)
Dialogue: 0,0:00:23.64,0:00:24.81,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:00:26.90,0:00:28.52,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:00:28.61,0:00:29.98,Default,,0,0,0,,анық
Dialogue: 0,0:00:30.07,0:00:32.49,Default,,0,0,0,,Маған түсіндіре аласыз.
Dialogue: 0,0:00:35.03,0:00:40.04,Default,,0,0,0,,♪～
Dialogue: 0,0:01:59.91,0:02:04.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:07.54,0:02:09.21,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:09.29,0:02:12.17,Default,,0,0,0,,Камизу мырза бізге көмектескісі келетінін айтты.
Dialogue: 0,0:02:12.25,0:02:13.59,Default,,0,0,0,,Бұл дүниеде ақылмен
Dialogue: 0,0:02:13.67,0:02:16.38,Default,,0,0,0,,Сіз онымен жақсы қарым-қатынастасыз ба?
Dialogue: 0,0:02:16.47,0:02:17.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:17.38,0:02:19.43,Default,,0,0,0,,Бұл қызу тақырып.
Dialogue: 0,0:02:19.51,0:02:22.72,Default,,0,0,0,,Камизу-кун, сенің мұндай намыссыз адам болғаныңа сене алар емеспін.
Dialogue: 0,0:02:22.81,0:02:24.68,Default,,0,0,0,,«Мен сені сүйемін!» деген не?
Dialogue: 0,0:02:24.77,0:02:27.81,Default,,0,0,0,,Бұл бұзылған араласушы нарциссист, басқа әлем, әйелдік
Dialogue: 0,0:02:28.89,0:02:31.56,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:02:32.48,0:02:34.82,Default,,0,0,0,,Мен бұл дүниеге келгенде
Dialogue: 0,0:02:34.90,0:02:37.61,Default,,0,0,0,,Қандай да бір себептермен мен онымен кездесіп жүргенмін.
Dialogue: 0,0:02:37.70,0:02:39.95,Default,,0,0,0,,Менде ешқашан арам сезім болған емес...
Dialogue: 0,0:02:40.03,0:02:41.24,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:41.32,0:02:44.54,Default,,0,0,0,,Жеңілдететін жағдайларға орын бар сияқты.
Dialogue: 0,0:02:44.62,0:02:47.12,Default,,0,0,0,,Егер сізге ұнамаса, жоқ деп айтыңыз.
Dialogue: 0,0:02:47.20,0:02:49.42,Default,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:02:50.12,0:02:54.25,Default,,0,0,0,,Хакухи мен туралы жақсы ойлайды.
Dialogue: 0,0:02:54.34,0:02:57.21,Default,,0,0,0,,Біз бір мекемеде бірге өстік.
Dialogue: 0,0:02:57.30,0:03:00.18,Default,,0,0,0,,Мүмкін болса, мен оны ренжіткім келмейді.
Dialogue: 0,0:03:00.80,0:03:04.93,Default,,0,0,0,,Түсіндім, сіз өзіңіздің жеке көзқарасыңызды білдіресіз бе?
Dialogue: 0,0:03:05.01,0:03:09.44,Default,,0,0,0,,Бірақ бұл мейірімділік оған шынымен пайдалы бола ма?
Dialogue: 0,0:03:09.52,0:03:11.94,Default,,0,0,0,,Бұл туралы мұқият ойластырған дұрыс емес пе?
Dialogue: 0,0:03:14.23,0:03:16.07,Default,,0,0,0,,Күндізгі жарық үшін...
Dialogue: 0,0:03:20.15,0:03:23.78,Default,,0,0,0,,Ерлі-зайыпты болсаңыз да, бөлек бөлмелерде жатуға тура келеді.
Dialogue: 0,0:03:23.87,0:03:25.99,Default,,0,0,0,,Қасиетті орындардағы әдепсіз әрекет – мәселе.
Dialogue: 0,0:03:26.08,0:03:27.87,Default,,0,0,0,,Сіз мұндай нәрсені жасай алмайсыз.
Dialogue: 0,0:03:27.95,0:03:30.54,Default,,0,0,0,,Ахаха Көріскенше
Dialogue: 0,0:03:30.62,0:03:32.67,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:34.96,0:03:36.42,Default,,0,0,0,,Бұл бөлме…
Dialogue: 0,0:03:40.72,0:03:42.38,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:42.47,0:03:44.18,Default,,0,0,0,,Жоқ, бәрібір...
Dialogue: 0,0:03:44.26,0:03:47.10,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:03:47.18,0:03:47.60,Default,,0,0,0,,Қалай болғанда да, мен жақында 15-ке толамын.
Dialogue: 0,0:03:47.60,0:03:49.18,Default,,0,0,0,,Қалай болғанда да, мен жақында 15-ке толамын.
Dialogue: 0,0:03:47.60,0:03:49.18,Default,,0,0,0,,(жылжымалы есіктің жабылу дыбысы)
Dialogue: 0,0:03:51.98,0:03:53.19,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:03:53.27,0:03:55.81,Default,,0,0,0,,Бұл менің бөлмем!
Dialogue: 0,0:03:55.90,0:03:58.44,Default,,0,0,0,,Өте тыныштандыратын! ностальгиялық!
Dialogue: 0,0:03:58.53,0:04:00.19,Default,,0,0,0,,Жоқ, мен жылайын деп тұрмын.
Dialogue: 0,0:04:00.28,0:04:01.70,Default,,0,0,0,,...
Dialogue: 0,0:04:01.78,0:04:03.95,Default,,0,0,0,,Бұл қызықпайтын уақыт емес.
Dialogue: 0,0:04:04.03,0:04:07.20,Default,,0,0,0,,Егер сізге ұнамаса, жоқ деп айтыңыз.
Dialogue: 0,0:04:07.28,0:04:08.87,Default,,0,0,0,,Сол күннен бастап
Dialogue: 0,0:04:08.95,0:04:13.04,Default,,0,0,0,,Мен сені қуып, күні бойы тынымсыз еңбек еттім.
Dialogue: 0,0:04:13.12,0:04:16.34,Default,,0,0,0,,Мәңгілік, Урю, қасыңда болу үшін
Dialogue: 0,0:04:17.42,0:04:19.30,Default,,0,0,0,,Мен бұл туралы дұрыс ойлауым керек.
Dialogue: 0,0:04:21.17,0:04:24.01,Default,,0,0,0,,Урю Сіз әлі ояусыз ба?
Dialogue: 0,0:04:24.09,0:04:25.09,Default,,0,0,0,,Күндізгі жарық?
Dialogue: 0,0:04:25.84,0:04:28.35,Default,,0,0,0,,Жалғыз қалғанда өзімді еркін сезінбеймін.
Dialogue: 0,0:04:28.43,0:04:30.85,Default,,0,0,0,,Ұйқың келгенше мен сенімен бірге бола аламын ба?
Dialogue: 0,0:04:30.93,0:04:32.35,Default,,0,0,0,,О
Dialogue: 0,0:04:32.43,0:04:34.98,Default,,0,0,0,,Мен де сенімен сөйлескім келді.
Dialogue: 0,0:04:35.06,0:04:37.73,Default,,0,0,0,,Өте жақсы...
Dialogue: 0,0:04:40.15,0:04:41.78,Default,,0,0,0,,Біз мұны істейміз бе?
Dialogue: 0,0:04:42.57,0:04:43.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:44.07,0:04:47.07,Default,,0,0,0,,Нана... Не ойладың, күндіз?
Dialogue: 0,0:04:47.16,0:04:48.49,Default,,0,0,0,,Мұнда адамдар жоқ!
Dialogue: 0,0:04:48.58,0:04:50.74,Default,,0,0,0,,Орналасқан жер маңызды емес
Dialogue: 0,0:04:50.83,0:04:52.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:52.08,0:04:56.46,Default,,0,0,0,,Өйткені мен және Урю...
Dialogue: 0,0:04:59.46,0:05:01.09,Default,,0,0,0,,Сіз тест тапсырушысыз!
Dialogue: 0,0:05:01.17,0:05:03.26,Default,,0,0,0,,Оқығың келсе, айт!
Dialogue: 0,0:05:03.34,0:05:06.59,Default,,0,0,0,,Хмм? Мен нені дұрыс түсінбедім?
Dialogue: 0,0:05:06.68,0:05:08.35,Default,,0,0,0,,Сіз қате айтасыз!
Dialogue: 0,0:05:08.43,0:05:09.51,Default,,0,0,0,,Бұл менің кінәм емес!
Dialogue: 0,0:05:09.60,0:05:13.02,Default,,0,0,0,,Мен шынымен суланамын деп ойладым.
Dialogue: 0,0:05:13.10,0:05:16.10,Default,,0,0,0,,Сіздің қарым-қатынасыңыз қалыпты болған сияқты.
Dialogue: 0,0:05:16.19,0:05:18.52,Default,,0,0,0,,Бірақ мен біраз қобалжыдым.
Dialogue: 0,0:05:18.61,0:05:20.40,Default,,0,0,0,,Жарайды, мен ауысамын.
Dialogue: 0,0:05:20.48,0:05:21.90,Default,,0,0,0,,Иә
Dialogue: 0,0:05:26.16,0:05:28.99,Default,,0,0,0,,Эй, Хакуджи, саған бірдеңе айтайын...
Dialogue: 0,0:05:29.07,0:05:29.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:31.49,0:05:33.83,Default,,0,0,0,,Оған баға қойылып қойған.
Dialogue: 0,0:05:34.33,0:05:36.79,Default,,0,0,0,,Иә? Ол аяқталды ма?
Dialogue: 0,0:05:38.58,0:05:41.05,Default,,0,0,0,,Кешіріңіз, бұл біраз уақыт алатын сияқты.
Dialogue: 0,0:05:41.13,0:05:46.01,Default,,0,0,0,,Әрекеттеріңді жина, бұл біздің армандарымыз үшін.
Dialogue: 0,0:05:46.09,0:05:47.18,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:05:47.26,0:05:50.89,Default,,0,0,0,,Неліктен Урю дәрігер болуға тырысады?
Dialogue: 0,0:05:50.97,0:05:54.93,Default,,0,0,0,,Біз сияқты ата-анасымен уақыт өткізе алмайтын балаларға.
Dialogue: 0,0:05:55.02,0:05:57.48,Default,,0,0,0,,Себебі сіз отбасыңызға көмектескіңіз келеді, солай емес пе?
Dialogue: 0,0:05:57.56,0:05:59.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:59.15,0:06:01.90,Default,,0,0,0,,Бір күні аурухана салайық.
Dialogue: 0,0:06:01.98,0:06:04.74,Default,,0,0,0,,Нысанды үлкейтіңіз...
Dialogue: 0,0:06:04.82,0:06:07.86,Default,,0,0,0,,Балаларымыздың үмітіне айналамыз
Dialogue: 0,0:06:08.66,0:06:12.33,Default,,0,0,0,,Бірге дүкен аралау, ойын-сауық саябағына бару, т.б.
Dialogue: 0,0:06:12.41,0:06:15.70,Default,,0,0,0,,Негізі мен ғашықтар сияқты көп нәрсені жасағым келеді.
Dialogue: 0,0:06:15.79,0:06:17.62,Default,,0,0,0,,Мен әзірге шыдамды болуым керек.
Dialogue: 0,0:06:17.71,0:06:19.21,Default,,0,0,0,,Күндізгі жарық...
Dialogue: 0,0:06:19.29,0:06:22.09,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:23.38,0:06:25.34,Default,,0,0,0,,Бірінші рет
Dialogue: 0,0:06:25.42,0:06:28.84,Default,,0,0,0,,Емтихан біткенше мен оны саған қалдырамын... солай ма?
Dialogue: 0,0:06:33.81,0:06:37.48,Default,,0,0,0,,Мияу
Dialogue: 0,0:06:37.56,0:06:39.77,Default,,0,0,0,,Айтпақшы, «алғашқы рет» дегенді білдіреді
Dialogue: 0,0:06:39.85,0:06:41.65,Default,,0,0,0,,Ойын-сауық саябағына бару
Dialogue: 0,0:06:41.73,0:06:44.15,Default,,0,0,0,,Мұрыннан қан кеткенде нені елестеттің?
Dialogue: 0,0:06:44.23,0:06:45.61,Default,,0,0,0,,Сонымен, оны қалай айту керек!
Dialogue: 0,0:06:48.45,0:06:51.37,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:06:54.66,0:06:56.29,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:06:57.62,0:06:59.12,Default,,0,0,0,,Әй, күн
Dialogue: 0,0:06:59.21,0:07:01.63,Default,,0,0,0,,Ұйқың келсе, басқа бөлмеде ұйықта...
Dialogue: 0,0:07:01.71,0:07:03.42,Default,,0,0,0,,Хмм... Урю...
Dialogue: 0,0:07:03.50,0:07:04.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:05.55,0:07:07.38,Default,,0,0,0,,Эй… Өзіңді қолыңнан келсін!!
Dialogue: 0,0:07:07.92,0:07:09.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:18.68,0:07:21.56,Default,,0,0,0,,А... таң атқан жоқ па?
Dialogue: 0,0:07:21.65,0:07:23.90,Default,,0,0,0,,Эй, сен ояусың ба?
Dialogue: 0,0:07:26.02,0:07:27.44,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:27.53,0:07:28.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:29.19,0:07:31.53,Default,,0,0,0,,Урю Бұл тамаша аю.
Dialogue: 0,0:07:31.61,0:07:32.91,Default,,0,0,0,,Сіз ұйықтамайсыз ба?
Dialogue: 0,0:07:33.91,0:07:36.12,Default,,0,0,0,,Бір нәрсе туралы ойлау.
Dialogue: 0,0:07:36.20,0:07:37.91,Default,,0,0,0,,Ойлар?
Dialogue: 0,0:07:38.54,0:07:40.66,Default,,0,0,0,,Мен ұзақ уақыт бойы алаңдадым.
Dialogue: 0,0:07:40.75,0:07:43.92,Default,,0,0,0,,Әңгімелеспес бұрын мен нақтылап алғым келеді.
Dialogue: 0,0:07:45.04,0:07:46.42,Default,,0,0,0,,Қый!
Dialogue: 0,0:07:47.71,0:07:51.63,Default,,0,0,0,,Күндізгі жарық Сіз бұл әлемді өзгерттіңіз бе?
Dialogue: 0,0:08:08.07,0:08:10.69,Default,,0,0,0,,«Қара Құдайдың сиқыры»
Dialogue: 0,0:08:10.78,0:08:11.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.99,0:08:14.91,Default,,0,0,0,,Мен Қара Құдай мырзаға өтініш жасадым.
Dialogue: 0,0:08:14.99,0:08:19.79,Default,,0,0,0,,«Мен Урюды ғибадатхана алып кетпей, менімен біріктіреді деп үміттенемін».
Dialogue: 0,0:08:22.00,0:08:24.88,Default,,0,0,0,,Мен мұның бір күні болатынын білдім.
Dialogue: 0,0:08:25.42,0:08:27.04,Default,,0,0,0,,Күн деп атаймыз
Dialogue: 0,0:08:27.92,0:08:31.13,Default,,0,0,0,,Менің шіркін дүнием мен Урюге деген сезімім...
Dialogue: 0,0:08:31.22,0:08:34.22,Default,,0,0,0,,Жаман, орташа сұрау тәсілі.
Dialogue: 0,0:08:34.30,0:08:35.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:35.26,0:08:38.93,Default,,0,0,0,,Осыны ертерек байқап, айтқанымда...
Dialogue: 0,0:08:39.72,0:08:41.31,Default,,0,0,0,,(Шиозаки) «Кісі өлтіруші» дегенің не?
Dialogue: 0,0:08:41.39,0:08:42.81,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:44.94,0:08:48.19,Default,,0,0,0,,Урю неге кешірім сұрайды?
Dialogue: 0,0:08:48.27,0:08:50.07,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:08:50.73,0:08:52.57,Default,,0,0,0,,Жоқ, Урю!
Dialogue: 0,0:08:52.65,0:08:55.66,Default,,0,0,0,,Урюдің менің сезімімді байқамауының себебі
Dialogue: 0,0:08:55.74,0:08:57.32,Default,,0,0,0,,Бұл менің кінәм!
Dialogue: 0,0:08:57.95,0:08:59.33,Default,,0,0,0,,Күндізгі жарық...
Dialogue: 0,0:09:00.16,0:09:02.00,Default,,0,0,0,,Мен қорықтым.
Dialogue: 0,0:09:02.08,0:09:05.75,Default,,0,0,0,,Маған шынайы сезімдеріңіз бен ойларыңызды бірден айтыңыз.
Dialogue: 0,0:09:05.83,0:09:08.34,Default,,0,0,0,,Іс жақсы болмаса ше...
Dialogue: 0,0:09:09.04,0:09:13.13,Default,,0,0,0,,Сондықтан назар аудару үшін еркелік ойнаған дұрыс.
Dialogue: 0,0:09:13.22,0:09:15.59,Default,,0,0,0,,Бұл ең ыңғайлы болды.
Dialogue: 0,0:09:16.30,0:09:20.43,Default,,0,0,0,,Негізі мүмкіндіктер көп болды.
Dialogue: 0,0:09:20.51,0:09:21.35,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:22.39,0:09:23.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:23.31,0:09:25.31,Default,,0,0,0,,Урю қазір осында ма?
Dialogue: 0,0:09:25.39,0:09:28.19,Default,,0,0,0,,Неліктен біз кейбір нәрселер туралы айтпаймыз?
Dialogue: 0,0:09:28.27,0:09:31.07,Default,,0,0,0,,Мен сені мектеп бітіргеннен бері көрмедім, солай ма?
Dialogue: 0,0:09:33.44,0:09:35.70,Default,,0,0,0,,Жоқ, бәрібір жақсы.
Dialogue: 0,0:09:35.78,0:09:37.82,Default,,0,0,0,,Мен Урюдің сабағына кедергі келтіргім келмейді...
Dialogue: 0,0:09:39.91,0:09:43.12,Default,,0,0,0,,Оның үстіне екеуміз де Киото университетіне түсуді мақсат еттік.
Dialogue: 0,0:09:43.20,0:09:45.21,Default,,0,0,0,,Бір күні біз тағы кездесеміз
Dialogue: 0,0:09:45.83,0:09:47.71,Default,,0,0,0,,Мен қашып бара жаттым
Dialogue: 0,0:09:48.21,0:09:51.63,Default,,0,0,0,,Кездесіп қалсақ, мен сені ойлаудан бас тарта алмаймын
Dialogue: 0,0:09:51.71,0:09:53.34,Default,,0,0,0,,Мен білетін шығармын
Dialogue: 0,0:09:58.43,0:10:00.22,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:00.30,0:10:03.35,Default,,0,0,0,,Мен Урюдің сол балалармен жақсы араласатынын көрдім...
Dialogue: 0,0:10:03.43,0:10:05.10,Default,,0,0,0,,Оригами краны?
Dialogue: 0,0:10:05.18,0:10:07.60,Default,,0,0,0,,Бұл мың тырна (Урю) Ах.
Dialogue: 0,0:10:09.81,0:10:11.52,Default,,0,0,0,,Бұрын Урю болған
Dialogue: 0,0:10:11.61,0:10:14.94,Default,,0,0,0,,...
Dialogue: 0,0:10:15.03,0:10:17.11,Default,,0,0,0,,Ешкімге сенген жоқ
Dialogue: 0,0:10:17.82,0:10:21.28,Default,,0,0,0,,Тілектерді орындайтын Құдай да, басқа ешкім де емес.
Dialogue: 0,0:10:21.37,0:10:23.29,Default,,0,0,0,,Өзім
Dialogue: 0,0:10:23.37,0:10:26.62,Default,,0,0,0,,Осыны айтып, тіпті Құдайға арқа сүйеуден де қаштым.
Dialogue: 0,0:10:27.25,0:10:31.08,Default,,0,0,0,,...
Dialogue: 0,0:10:31.17,0:10:34.88,Default,,0,0,0,,Мен білетін Урю өзгерді ме деп ойлаймын.
Dialogue: 0,0:10:34.96,0:10:36.63,Default,,0,0,0,,Мен қатты қобалжыдым.
Dialogue: 0,0:10:38.05,0:10:42.26,Default,,0,0,0,,Сонда да мен қатты күлдім...
Dialogue: 0,0:10:42.35,0:10:44.47,Default,,0,0,0,,Мен оны көрмеймін деп жүре бердім.
Dialogue: 0,0:10:56.74,0:11:01.37,Default,,0,0,0,,...
Dialogue: 0,0:11:01.45,0:11:04.66,Default,,0,0,0,,Менің сезімім үшін және Урю үшін
Dialogue: 0,0:11:04.74,0:11:08.62,Default,,0,0,0,,Бірақ мен қараңғы құдайдан дүниені бұруды сұрадым.
Dialogue: 0,0:11:08.71,0:11:13.71,Default,,0,0,0,,Урю абдырап тұрса да, өтірік айтып, алдадым...
Dialogue: 0,0:11:13.79,0:11:15.05,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:16.05,0:11:18.09,Default,,0,0,0,,Сонда да мен...
Dialogue: 0,0:11:18.97,0:11:22.30,Default,,0,0,0,,Урюдың қасында болғым келмеді.
Dialogue: 0,0:11:24.76,0:11:26.18,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:11:27.06,0:11:28.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:30.64,0:11:31.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:32.90,0:11:35.73,Default,,0,0,0,,Маған айтқаныңызға рахмет!
Dialogue: 0,0:11:35.82,0:11:36.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:36.98,0:11:40.24,Default,,0,0,0,,Шындықты айту өте қорқынышты болды деп ойлаймын.
Dialogue: 0,0:11:40.32,0:11:42.16,Default,,0,0,0,,Бірақ мен бақытты болдым.
Dialogue: 0,0:11:44.32,0:11:45.74,Default,,0,0,0,,Нашар
Dialogue: 0,0:11:45.83,0:11:49.20,Default,,0,0,0,,...
Dialogue: 0,0:11:49.29,0:11:50.71,Default,,0,0,0,,Урю…
Dialogue: 0,0:11:52.37,0:11:54.67,Default,,0,0,0,,Ал... әзірге
Dialogue: 0,0:11:54.75,0:11:56.88,Default,,0,0,0,,Кеудемде жылайсың ба?
Dialogue: 0,0:11:58.26,0:12:00.42,Default,,0,0,0,,Бұл тым иіс емес пе?
Dialogue: 0,0:12:00.51,0:12:03.68,Default,,0,0,0,,Иә? Мен таңқаларлық жақсы болуым мүмкін
Dialogue: 0,0:12:03.76,0:12:06.18,Default,,0,0,0,,Солай болса да, бұл тым стандартты.
Dialogue: 0,0:12:06.26,0:12:09.77,Default,,0,0,0,,Қалағаныңды істе, анау тотемдік полюсті соттауды доғар!
Dialogue: 0,0:12:10.43,0:12:11.98,Default,,0,0,0,,Таку
Dialogue: 0,0:12:12.06,0:12:14.60,Default,,0,0,0,,Олай болса, үйге кететін уақытымыз болды.
Dialogue: 0,0:12:14.69,0:12:17.69,Default,,0,0,0,,Маған бір түнде қамқорлық жасағаныңыз үшін рахмет.
Dialogue: 0,0:12:20.24,0:12:22.03,Default,,0,0,0,,Әй, күн
Dialogue: 0,0:12:22.11,0:12:25.24,Default,,0,0,0,,Үйге барар алдында барғым келетін жерім бар. Бұл жақсы ма?
Dialogue: 0,0:12:25.32,0:12:27.28,Default,,0,0,0,,Аа, қайда бара жатырсың?
Dialogue: 0,0:12:29.74,0:12:31.79,Default,,0,0,0,,Аллаға сәлем
Dialogue: 0,0:12:36.50,0:12:39.05,Default,,0,0,0,,Омар алуым керек пе?
Dialogue: 0,0:12:39.67,0:12:41.21,Default,,0,0,0,,Күндізгі жарықтың қандай пайдасы бар?
Dialogue: 0,0:12:41.30,0:12:43.05,Default,,0,0,0,,Табысқа жету үшін дұға ету?
Dialogue: 0,0:12:44.72,0:12:47.60,Default,,0,0,0,,Маған мейірімділік танытуға мәжбүрлемесең де, жарайды.
Dialogue: 0,0:12:47.68,0:12:48.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:48.64,0:12:52.77,Default,,0,0,0,,Мен Урюдың өмірін шатастырып жібердім.
Dialogue: 0,0:12:52.85,0:12:53.85,Default,,0,0,0,,Неге...
Dialogue: 0,0:12:53.94,0:12:55.31,Default,,0,0,0,,(Кашива қолы)
Dialogue: 0,0:12:56.06,0:12:59.57,Default,,0,0,0,,Інім дүниеге келсе де, жақсы көретініне сенемін!
Dialogue: 0,0:12:59.65,0:13:00.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:00.57,0:13:03.11,Default,,0,0,0,,Жоқ... жоқ, Урюдың алдында Құдайға жалбарыну?
Dialogue: 0,0:13:03.20,0:13:05.53,Default,,0,0,0,,Ал, ойланбаған тілек!
Dialogue: 0,0:13:06.03,0:13:07.82,Default,,0,0,0,,Ахаха
Dialogue: 0,0:13:08.53,0:13:10.70,Default,,0,0,0,,Бұл өзімшіл өтініш.
Dialogue: 0,0:13:10.79,0:13:12.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:18.04,0:13:21.05,Default,,0,0,0,,(Кашива қолы)
Dialogue: 0,0:13:25.88,0:13:29.39,Default,,0,0,0,,Мен, анам қайтыс болғанға дейін
Dialogue: 0,0:13:29.47,0:13:32.97,Default,,0,0,0,,Ғибадатханаға барып, күнде дұға оқыдым.
Dialogue: 0,0:13:33.06,0:13:35.73,Default,,0,0,0,,Шынымды айтсам, үмітсіз дұға еттім.
Dialogue: 0,0:13:35.81,0:13:37.69,Default,,0,0,0,,Бірақ... (тапа күндіз) Иә.
Dialogue: 0,0:13:37.77,0:13:40.19,Default,,0,0,0,,Сонымен анам қайтыс болған кезде
Dialogue: 0,0:13:40.27,0:13:41.61,Default,,0,0,0,,Құдайға сенбе
Dialogue: 0,0:13:41.69,0:13:44.95,Default,,0,0,0,,Мен өз күшіммен бірдеңе істеуім керек деп ойладым.
Dialogue: 0,0:13:45.53,0:13:46.95,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:13:48.16,0:13:53.33,Default,,0,0,0,,Құдайға жалбарынған адамдардың сезімін жоққа шығарғым келмейді.
Dialogue: 0,0:13:53.41,0:13:56.54,Default,,0,0,0,,Өткен мен қазіргі күннің жарығы
Dialogue: 0,0:13:56.62,0:14:00.38,Default,,0,0,0,,Құдайға арқа сүйеу керек болса да орындағым келетін шынайы тілегім бар еді.
Dialogue: 0,0:14:00.46,0:14:02.34,Default,,0,0,0,,Ешқандай айырмашылық жоқ
Dialogue: 0,0:14:02.42,0:14:06.51,Default,,0,0,0,,Себебі сол адамның шынайы сезімі
Dialogue: 0,0:14:06.59,0:14:08.84,Default,,0,0,0,,Маған жақсы қарауларыңды қалаймын.
Dialogue: 0,0:14:09.72,0:14:13.97,Default,,0,0,0,,Осы ғибадатхана мен сол жігіттер маған соны аңғартты.
Dialogue: 0,0:14:16.27,0:14:18.48,Default,,0,0,0,,Менің тілегім әлі сол қалпында.
Dialogue: 0,0:14:19.10,0:14:22.02,Default,,0,0,0,,Дәрігер бол және адамдардың өмірін сақта
Dialogue: 0,0:14:22.11,0:14:24.69,Default,,0,0,0,,Бірақ бұл жай ғана емес, ұлғайған.
Dialogue: 0,0:14:25.74,0:14:30.32,Default,,0,0,0,,Құдайға жалбарынған адамдарды құтқару менің арманыма айналды.
Dialogue: 0,0:14:30.41,0:14:32.12,Default,,0,0,0,,Урю…
Dialogue: 0,0:14:32.78,0:14:37.33,Default,,0,0,0,,Солардың арқасында мен өзіме қайта қарадым.
Dialogue: 0,0:14:37.41,0:14:39.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:39.67,0:14:41.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:43.34,0:14:45.34,Default,,0,0,0,,Бірдеңе маңызды болып көрінеді.
Dialogue: 0,0:14:45.42,0:14:46.88,Default,,0,0,0,,Іс жүзінде бүгін
Dialogue: 0,0:14:46.97,0:14:50.18,Default,,0,0,0,,Сырттан келген киелі қыз келе алмайды.
Dialogue: 0,0:14:50.26,0:14:52.85,Default,,0,0,0,,Жұмыс күшінің тапшылығы зор.
Dialogue: 0,0:14:52.93,0:14:55.10,Default,,0,0,0,,Егер солай болса, маған қалдырыңыз.
Dialogue: 0,0:14:55.18,0:14:56.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:56.10,0:14:59.89,Default,,0,0,0,,Мен əйел болып киінемін, сенің орныңды толық емес жұмысшы ретінде аламын!
Dialogue: 0,0:15:01.61,0:15:03.52,Default,,0,0,0,,Бір сәт!
Dialogue: 0,0:15:03.61,0:15:06.15,Default,,0,0,0,,Қарғыс атсын! Мен бұл жақсы идея деп ойладым
Dialogue: 0,0:15:06.99,0:15:08.65,Default,,0,0,0,,А... білесің.
Dialogue: 0,0:15:08.74,0:15:10.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:10.24,0:15:14.12,Default,,0,0,0,,Қарсы болмасаңыз, мен сізге көмектесе аламын ба?
Dialogue: 0,0:15:15.45,0:15:18.00,Default,,0,0,0,,О~ Мынау!
Dialogue: 0,0:15:18.08,0:15:19.33,Default,,0,0,0,,Керемет
Dialogue: 0,0:15:19.41,0:15:21.63,Default,,0,0,0,,Саған жарасады, Хакуджи-кун.
Dialogue: 0,0:15:24.54,0:15:27.09,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:15:32.80,0:15:34.85,Default,,0,0,0,,Мынау әулие қыз ба...
Dialogue: 0,0:15:34.93,0:15:36.51,Default,,0,0,0,,Мен... Кешіріңіз!
Dialogue: 0,0:15:36.60,0:15:37.60,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:15:37.68,0:15:40.98,Default,,0,0,0,,Қайта... Махаббатта табысқа жету үшін маған сүйкімділік беріңізші!
Dialogue: 0,0:15:43.81,0:15:45.73,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:15:46.36,0:15:48.61,Default,,0,0,0,,Алла разы болсын.
Dialogue: 0,0:15:49.36,0:15:51.61,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:15:54.16,0:15:55.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:56.24,0:16:00.50,Default,,0,0,0,,Құдайға жалбарынған адамдарды құтқару менің арманыма айналды.
Dialogue: 0,0:16:01.50,0:16:05.71,Default,,0,0,0,,Урю осылай айтып тұрды.
Dialogue: 0,0:16:06.59,0:16:09.80,Default,,0,0,0,,Эй Хакуджи-сан, сен менің үйімде ресми түрде жұмыс істегің келе ме?
Dialogue: 0,0:16:09.88,0:16:11.05,Default,,0,0,0,,Мен де келісемін!
Dialogue: 0,0:16:11.13,0:16:14.39,Default,,0,0,0,,Өзімшіл ештеңе айтпа! Бірақ бұл жақсы идея
Dialogue: 0,0:16:14.47,0:16:17.39,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:16:18.14,0:16:21.60,Default,,0,0,0,,Мүмкін мұндай дүние онша жаман емес шығар.
Dialogue: 0,0:16:25.77,0:16:28.44,Default,,0,0,0,,Урю және барлығы
Dialogue: 0,0:16:28.53,0:16:30.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:30.74,0:16:32.82,Default,,0,0,0,,Тек өз қалауым үшін
Dialogue: 0,0:16:32.90,0:16:35.91,Default,,0,0,0,,Мен әркімнің дүниесін құрттым
Dialogue: 0,0:16:35.99,0:16:38.45,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:16:39.12,0:16:41.75,Default,,0,0,0,,Бұл жағдайға мен де себепкермін.
Dialogue: 0,0:16:41.83,0:16:43.79,Default,,0,0,0,,Сондықтан Хакуичиді көп кінәламаңыз...
Dialogue: 0,0:16:43.87,0:16:46.25,Default,,0,0,0,,Күн сәулесі! (Асахиме) Бұл күн!
Dialogue: 0,0:16:43.87,0:16:46.25,Default,,0,0,0,,Күндізгі жарық~!
Dialogue: 0,0:16:46.33,0:16:48.17,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:16:48.25,0:16:50.96,Default,,0,0,0,,Менде осындай ауыр сезім болғанына сене алар емеспін...
Dialogue: 0,0:16:51.05,0:16:54.34,Default,,0,0,0,,Егер мен де дәл осындай жағдайда болсам...
Dialogue: 0,0:16:54.43,0:16:55.80,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:16:56.68,0:16:58.22,Default,,0,0,0,,Жарайды, күндізгі жарық
Dialogue: 0,0:16:58.30,0:16:59.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:59.22,0:17:01.60,Default,,0,0,0,,Өз сезімдеріңізді біліңіз
Dialogue: 0,0:17:01.68,0:17:05.15,Default,,0,0,0,,Шынымды айтсам, мен бұл дүние де соншалықты жаман емес деп ойладым.
Dialogue: 0,0:17:05.65,0:17:08.90,Default,,0,0,0,,Сондықтан мен бұл дүниеге келгеніме қуаныштымын.
Dialogue: 0,0:17:09.86,0:17:12.03,Default,,0,0,0,,Мен де білгеніме қуаныштымын.
Dialogue: 0,0:17:12.11,0:17:14.82,Default,,0,0,0,,Урюдың зиярат туралы ойлары
Dialogue: 0,0:17:14.90,0:17:18.78,Default,,0,0,0,,Урю әрқашан мен білетін Урю болды.
Dialogue: 0,0:17:19.95,0:17:23.08,Default,,0,0,0,,Тапа күннің өзінде мен әлі де...
Dialogue: 0,0:17:23.16,0:17:25.04,Default,,0,0,0,,​​Иә, мен білемін.
Dialogue: 0,0:17:27.67,0:17:29.42,Default,,0,0,0,,Бастапқы әлемге оралайық
Dialogue: 0,0:17:30.04,0:17:32.42,Default,,0,0,0,,Үйге қалай жетуге болатынын білесіз бе?
Dialogue: 0,0:17:32.51,0:17:33.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:33.59,0:17:38.14,Default,,0,0,0,,Менің ойымша, егер сіз Қараңғы Құдай ғибадатханасына барсаңыз, мүмкін болуы мүмкін ...
Dialogue: 0,0:17:38.22,0:17:39.51,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:39.60,0:17:41.64,Default,,0,0,0,,Кешіріңіз, менде ешқандай дәлел жоқ.
Dialogue: 0,0:17:41.72,0:17:45.44,Default,,0,0,0,,Бірақ, әйтеуір, мен үйге жетудің жолын міндетті түрде табамын.
Dialogue: 0,0:17:46.35,0:17:51.19,Default,,0,0,0,,Мен енді Урюдың армандарын бұзғым келмейді.
Dialogue: 0,0:17:52.48,0:17:54.11,Default,,0,0,0,,Күндізгі жарық...
Dialogue: 0,0:17:55.49,0:17:57.74,Default,,0,0,0,,Егер солай болса, мен ынтымақтасамын.
Dialogue: 0,0:17:57.82,0:17:58.91,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:58.99,0:18:01.41,Default,,0,0,0,,Үйлеріне аман-есен оралулары үшін оларды шығарып салайық.
Dialogue: 0,0:18:01.49,0:18:04.41,Default,,0,0,0,,Мен мұндай құбылыспен таныс біреуді білемін.
Dialogue: 0,0:18:04.50,0:18:06.16,Default,,0,0,0,,Мен сенімен ақылдасамын.
Dialogue: 0,0:18:06.79,0:18:08.54,Default,,0,0,0,,(Үшеуі) Қане, бастаймыз~! (Танжиро) Уа!
Dialogue: 0,0:18:08.63,0:18:10.54,Default,,0,0,0,,(Әпке-сіңлілердің күлкісі)
Dialogue: 0,0:18:10.63,0:18:12.55,Default,,0,0,0,,Олай болса, сізге уақыт келді.
Dialogue: 0,0:18:12.63,0:18:16.42,Default,,0,0,0,,Үйге бармас бұрын, осы дүниеден біраз естеліктер жасайық.
Dialogue: 0,0:18:22.85,0:18:25.68,Default,,0,0,0,,Уау, керемет адам
Dialogue: 0,0:18:26.35,0:18:28.56,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:18:28.65,0:18:30.61,Default,,0,0,0,,Қайырлы таң Асахиме-чан
Dialogue: 0,0:18:30.69,0:18:32.57,Default,,0,0,0,,Фестиваль өте сәтті өтті.
Dialogue: 0,0:18:32.65,0:18:33.98,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:34.07,0:18:38.07,Default,,0,0,0,,Бұл сұлу қыз промоушен менеджерінің тағы бір жетістігі... Уау!
Dialogue: 0,0:18:39.28,0:18:40.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:40.62,0:18:42.16,Default,,0,0,0,,Сәлем
Dialogue: 0,0:18:43.83,0:18:47.33,Default,,0,0,0,,Сіз шынымен ебедейсіз, сондықтан сақ болыңыз.
Dialogue: 0,0:18:48.00,0:18:50.08,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:18:50.92,0:18:52.71,Default,,0,0,0,,Екеуіңізге қош келдіңіздер.
Dialogue: 0,0:18:52.79,0:18:56.21,Default,,0,0,0,,Шектеулі шығарылымы да бар, сондықтан қараңыз.
Dialogue: 0,0:18:56.30,0:18:58.72,Default,,0,0,0,,Уау, сондай сүйкімді!
Dialogue: 0,0:18:58.80,0:19:01.22,Default,,0,0,0,,Хе, рахмет
Dialogue: 0,0:19:01.85,0:19:04.85,Default,,0,0,0,,Бірақ қазір қоштасайық па?
Dialogue: 0,0:19:04.93,0:19:08.85,Default,,0,0,0,,Қайта кездессек те, өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:19:11.56,0:19:13.86,Default,,0,0,0,,Рахмет, Йошиге
Dialogue: 0,0:19:14.52,0:19:18.11,Default,,0,0,0,,Сізбен болған естеліктерімнің арқасында мен құтқарылдым.
Dialogue: 0,0:19:18.19,0:19:22.37,Default,,0,0,0,,Мен бұл естеліктерді өмір бойы сақтаймын.
Dialogue: 0,0:19:23.58,0:19:24.62,Default,,0,0,0,,Иә
Dialogue: 0,0:19:32.46,0:19:35.50,Default,,0,0,0,,Хмм... Сіз де Одангоны іздеп жүрсіз бе?
Dialogue: 0,0:19:35.59,0:19:36.88,Default,,0,0,0,,Сіз қанша жейсіз?
Dialogue: 0,0:19:36.96,0:19:40.22,Default,,0,0,0,,Түстен кейін би тартуы болады.
Dialogue: 0,0:19:40.30,0:19:43.09,Default,,0,0,0,,Біз энергиямызды қоректендіру үшін көп жеуіміз керек.
Dialogue: 0,0:19:43.18,0:19:45.39,Default,,0,0,0,,Осы жерде мен оны анық айтамын...
Dialogue: 0,0:19:46.01,0:19:46.97,Default,,0,0,0,,Сіз салмақ қосасыз.
Dialogue: 0,0:19:47.06,0:19:47.89,Default,,0,0,0,,Аһ!
Dialogue: 0,0:19:47.97,0:19:51.52,Default,,0,0,0,,Үйге барар алдында тамақтану әдеттерін түзету керек.
Dialogue: 0,0:19:51.60,0:19:54.27,Default,,0,0,0,,Нәзіктіктің жоқтығын өзгерту керек!
Dialogue: 0,0:19:54.36,0:19:56.90,Default,,0,0,0,,Урусее, бұл мен үшін үлкен көмек.
Dialogue: 0,0:19:56.98,0:20:00.61,Default,,0,0,0,,Сіз араласушы, сезімсіз, нарциссист, басқа дүниелік адамсыз!
Dialogue: 0,0:20:06.62,0:20:09.20,Default,,0,0,0,,Барлығының биін асыға күтемін.
Dialogue: 0,0:20:09.29,0:20:13.33,Default,,0,0,0,,Бұл мен оны кездейсоқ тұтынушы ретінде бірінші рет көріп тұрмын.
Dialogue: 0,0:20:13.42,0:20:16.42,Default,,0,0,0,,Урю үшеуің туралы не ойлайды?
Dialogue: 0,0:20:16.50,0:20:17.96,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:18.59,0:20:20.67,Default,,0,0,0,,Бұл кенеттен не болды?
Dialogue: 0,0:20:22.22,0:20:24.80,Default,,0,0,0,,Жақсы, әзірше ол туралы айтпа.
Dialogue: 0,0:20:29.14,0:20:31.68,Default,,0,0,0,,Өтінемін, тыңдауға рұқсат етіңізші?
Dialogue: 0,0:20:34.73,0:20:36.48,Default,,0,0,0,,Сондықтан өзіңді де кінәлама
Dialogue: 0,0:20:40.03,0:20:43.45,Default,,0,0,0,,Кешіріңіз, сөзбен айтып жеткізу мүмкін емес.
Dialogue: 0,0:20:47.95,0:20:49.45,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:49.54,0:20:54.54,Default,,0,0,0,,(Кагура музыкасы)
Dialogue: 0,0:21:12.10,0:21:15.85,Default,,0,0,0,,Бұл таңқаларлық. Үшеуі де әдемі, әдемі...
Dialogue: 0,0:21:15.94,0:21:16.77,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:25.03,0:21:27.24,Default,,0,0,0,,Бұл сөзсіз дұрыс.
Dialogue: 0,0:21:27.87,0:21:32.45,Default,,0,0,0,,Сөзбен айтып жеткізе алмасам да түсінемін... Урю
Dialogue: 0,0:21:34.75,0:21:38.08,Default,,0,0,0,,Фестивальге келгендеріңіз үшін екеуіне де рахмет.
Dialogue: 0,0:21:38.17,0:21:40.29,Default,,0,0,0,,Келгеніме қуаныштымын.
Dialogue: 0,0:21:40.38,0:21:42.21,Default,,0,0,0,,Үйге бару ғана қалды.
Dialogue: 0,0:21:42.30,0:21:43.30,Default,,0,0,0,,О
Dialogue: 0,0:21:43.38,0:21:46.93,Default,,0,0,0,,Мен сені таныстырғым келетін біреу бар.
Dialogue: 0,0:21:47.01,0:21:49.18,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:49.26,0:21:53.77,Default,,0,0,0,,Биылғы күз мерекесі жастық иіс береді.
Dialogue: 0,0:21:53.85,0:21:54.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.77,0:21:55.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:58.65,0:21:59.94,Default,,0,0,0,,Йойфука-сан!
Dialogue: 0,0:22:00.65,0:22:03.74,Default,,0,0,0,,Сіз қайсысысыз?
Dialogue: 0,0:22:04.94,0:22:10.20,Default,,0,0,0,,♪～
Dialogue: 0,0:23:30.91,0:23:34.87,Default,,0,0,0,,～♪
