Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.17,0:00:06.17,Default,,0,0,0,,Уау! Иә
Dialogue: 0,0:00:06.25,0:00:08.25,Default,,0,0,0,,Сіз кімсіз...
Dialogue: 0,0:00:08.34,0:00:09.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:09.26,0:00:11.55,Default,,0,0,0,,Хуалиен-чан?
Dialogue: 0,0:00:11.63,0:00:13.68,Default,,0,0,0,,Мен сені мазалаймын.
Dialogue: 0,0:00:14.30,0:00:17.64,Default,,0,0,0,,Хмф! Бұл Commoners сияқты сезінетін бөлме.
Dialogue: 0,0:00:17.72,0:00:20.52,Default,,0,0,0,,Менің бөлмем маған сәйкес келмейді деп ойлаймын.
Dialogue: 0,0:00:20.60,0:00:22.81,Default,,0,0,0,,Сізге кедергі жасау дөрекі...
Dialogue: 0,0:00:22.89,0:00:27.27,Default,,0,0,0,,Сонда да Хуалиен-чанның маған қонаққа келгені таң қалдырады~
Dialogue: 0,0:00:27.36,0:00:30.19,Default,,0,0,0,,Мен үшін қатты уайымдадың ба?
Dialogue: 0,0:00:31.69,0:00:33.45,Default,,0,0,0,,Бірақ осылай
Dialogue: 0,0:00:33.53,0:00:37.32,Default,,0,0,0,,Уайымдама, бізде бәрі жақсы.
Dialogue: 0,0:00:38.08,0:00:40.83,Default,,0,0,0,,Иә, онда ұстап тұрудың қажеті жоқ.
Dialogue: 0,0:00:41.75,0:00:42.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:42.66,0:00:43.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:47.17,0:00:49.09,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:00:50.05,0:00:52.47,Default,,0,0,0,,Күте тұрыңыз... Бір минут күтіңіз!
Dialogue: 0,0:00:52.55,0:00:54.34,Default,,0,0,0,,Кез келген жағдайда, Хуалиен-чан, бізбен бірге ме?
Dialogue: 0,0:00:54.43,0:00:56.97,Default,,0,0,0,,Сіз нені түсінбедіңіз?
Dialogue: 0,0:00:57.05,0:01:00.39,Default,,0,0,0,,Жарайды, жаттығуға болатын киімдерді тез ауыстыр.
Dialogue: 0,0:01:00.47,0:01:01.93,Default,,0,0,0,,Не, жаттығу?
Dialogue: 0,0:01:02.02,0:01:02.85,Default,,0,0,0,,Уф
Dialogue: 0,0:01:02.93,0:01:07.61,Default,,0,0,0,,Енді менімен, Асахиме Амагамимен байсалды ұрыс!
Dialogue: 0,0:01:08.81,0:01:11.61,Default,,0,0,0,,Маңызды... ойыны
Dialogue: 0,0:01:11.61,0:01:12.61,Default,,0,0,0,,Байыпты... ойыны
Dialogue: 0,0:01:11.61,0:01:12.61,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:01:12.69,0:01:15.40,Default,,0,0,0,,Не болды, Асахиме! Сенімен бәрі жақсы ма?
Dialogue: 0,0:01:16.20,0:01:17.62,Default,,0,0,0,,Не!
Dialogue: 0,0:01:17.70,0:01:18.70,Default,,0,0,0,,Не!
Dialogue: 0,0:01:19.99,0:01:25.00,Default,,0,0,0,,♪～
Dialogue: 0,0:02:44.95,0:02:49.96,Default,,0,0,0,,～♪
Dialogue: 0,0:02:59.09,0:03:00.34,Default,,0,0,0,,Сенің ағаң екеніне сене алар емеспін.
Dialogue: 0,0:03:00.43,0:03:03.55,Default,,0,0,0,,Ол бұрмаланған Cisco жын-пері болды.
Dialogue: 0,0:03:03.64,0:03:06.93,Default,,0,0,0,,Дұрыс. Тек көз тігулер бір блок қашықтықта...
Dialogue: 0,0:03:07.02,0:03:09.35,Default,,0,0,0,,Боқ... Уайымдап ақша жоғалттым.
Dialogue: 0,0:03:09.44,0:03:12.19,Default,,0,0,0,,Неліктен менімен кездесіп жүрсің?
Dialogue: 0,0:03:12.27,0:03:14.61,Default,,0,0,0,,Қыз бөлмесіне қарағаны үшін жаза
Dialogue: 0,0:03:14.69,0:03:17.11,Default,,0,0,0,,Сіз таймкиперсіз
Dialogue: 0,0:03:17.78,0:03:19.86,Default,,0,0,0,,Ережені түсіндірейін.
Dialogue: 0,0:03:20.53,0:03:23.49,Default,,0,0,0,,Турнир ережелеріндегідей 10 км марафонды болжасақ.
Dialogue: 0,0:03:23.57,0:03:27.16,Default,,0,0,0,,2 км жолдың 5 айналымын бірінші орындаған адам жеңеді.
Dialogue: 0,0:03:27.24,0:03:28.50,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:28.58,0:03:30.33,Default,,0,0,0,,Сондай-ақ жеңілген адам жазаланады
Dialogue: 0,0:03:30.41,0:03:33.63,Default,,0,0,0,,Жеңімпаздың айтқанын тыңдау керек.
Dialogue: 0,0:03:33.71,0:03:34.88,Default,,0,0,0,,Иә! Бірдеңе?
Dialogue: 0,0:03:34.96,0:03:36.71,Default,,0,0,0,,Қандай өзімшіл ереже
Dialogue: 0,0:03:36.80,0:03:38.71,Default,,0,0,0,,Охохохохо!
Dialogue: 0,0:03:40.67,0:03:42.22,Default,,0,0,0,,Егер мен жеңсем...
Dialogue: 0,0:03:42.84,0:03:46.43,Default,,0,0,0,,Жүгіруді тоқтат, Асахиме Амагами.
Dialogue: 0,0:03:46.93,0:03:48.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:48.18,0:03:50.43,Default,,0,0,0,,Кәне, бастайық, Cisco ағасы.
Dialogue: 0,0:03:50.52,0:03:52.60,Default,,0,0,0,,А-а... Түсіндім.
Dialogue: 0,0:03:54.06,0:03:55.90,Default,,0,0,0,,Орналасуға қатысты…
Dialogue: 0,0:03:56.57,0:03:58.48,Default,,0,0,0,,Дайындау…
Dialogue: 0,0:03:58.57,0:03:59.78,Default,,0,0,0,,Дон!
Dialogue: 0,0:04:04.53,0:04:07.70,Default,,0,0,0,,Хуалиен-чан, бұрын не айтып тұрсың?
Dialogue: 0,0:04:08.79,0:04:12.75,Default,,0,0,0,,Осы көктемнен бері жеке ең жақсыны жаңарта алмадыңыз.
Dialogue: 0,0:04:12.83,0:04:15.00,Default,,0,0,0,,Ха... бұл...
Dialogue: 0,0:04:15.08,0:04:17.59,Default,,0,0,0,,Салақтық та жақсы.
Dialogue: 0,0:04:17.67,0:04:19.42,Default,,0,0,0,,Сіз қамтылған кезде
Dialogue: 0,0:04:19.51,0:04:23.01,Default,,0,0,0,,Мен сіздің жеке жақсылығыңызға бір қадам қалдым.
Dialogue: 0,0:04:24.59,0:04:27.60,Default,,0,0,0,,Бұл өте маңызды.
Dialogue: 0,0:04:27.68,0:04:30.68,Default,,0,0,0,,Жартылай шешілсе де, көздің жауын алады.
Dialogue: 0,0:04:30.77,0:04:33.64,Default,,0,0,0,,Марафон қазір сізге жарамайды.
Dialogue: 0,0:04:33.73,0:04:36.15,Default,,0,0,0,,Мен енді сенің артыңа ермеймін!
Dialogue: 0,0:04:36.23,0:04:37.40,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:38.40,0:04:41.15,Default,,0,0,0,,Амаками Асахиме храм қыз ретінде
Dialogue: 0,0:04:41.24,0:04:44.15,Default,,0,0,0,,Мұны фестивальдерде де жасағаныңыз сізге жарасады!
Dialogue: 0,0:04:45.45,0:04:46.78,Default,,0,0,0,,Хуалиен-чан…
Dialogue: 0,0:04:50.37,0:04:52.71,Default,,0,0,0,,Асахиме Амагамимен кездескеннен кейін
Dialogue: 0,0:04:52.79,0:04:55.71,Default,,0,0,0,,Жеңіске жету мақсатымен жүгіруді жалғастырыңыз
Dialogue: 0,0:04:55.79,0:04:58.59,Default,,0,0,0,,Бұл мен үшін ерекше болды.
Dialogue: 0,0:04:59.67,0:05:04.05,Default,,0,0,0,,Бірақ мен марафондар Асахиме Амаками үшін ерекше емес екеніне сенімдімін.
Dialogue: 0,0:05:04.80,0:05:07.80,Default,,0,0,0,,Олай болса, мен мұнда жеңемін.
Dialogue: 0,0:05:08.76,0:05:10.68,Default,,0,0,0,,Бұл қатынас...
Dialogue: 0,0:05:10.76,0:05:12.68,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:05:20.15,0:05:23.57,Default,,0,0,0,,(Асахиманың ауыр тыныс алуы)
Dialogue: 0,0:05:24.19,0:05:25.57,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:25.65,0:05:30.08,Default,,0,0,0,,осылайша өлу – табиғи нәрсе шығар, деп ойлаймын.
Dialogue: 0,0:05:30.16,0:05:33.45,Default,,0,0,0,,Асахиме... жоғалды ма?
Dialogue: 0,0:05:35.21,0:05:36.62,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:37.92,0:05:41.09,Default,,0,0,0,,Иә! Мен Асахиме Амагамиді жеңдім!
Dialogue: 0,0:05:41.17,0:05:43.88,Default,,0,0,0,,Сонымен қатар, ол Асахиме Амакамидің жеке үздік көрсеткішінен асып түсті!
Dialogue: 0,0:05:43.96,0:05:46.84,Default,,0,0,0,,Бұл менің жеңісім!
Dialogue: 0,0:05:46.93,0:05:49.14,Default,,0,0,0,,(Асахименің ауыр тыныс алуы)
Dialogue: 0,0:05:49.22,0:05:53.35,Default,,0,0,0,,Енді мен саған жабысып біттім.
Dialogue: 0,0:05:53.43,0:05:54.60,Default,,0,0,0,,А...
Dialogue: 0,0:05:54.68,0:05:55.85,Default,,0,0,0,,Уәде етілгендей
Dialogue: 0,0:05:56.52,0:06:00.23,Default,,0,0,0,,Марафондарды жүгіруді тоқтатыңыз, Асахиме Амагами
Dialogue: 0,0:06:03.53,0:06:05.03,Default,,0,0,0,,...Бұл Кан.
Dialogue: 0,0:06:05.11,0:06:06.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:06.61,0:06:09.87,Default,,0,0,0,,Болмайды, мүмкін емес, есептелмейді!
Dialogue: 0,0:06:09.95,0:06:11.66,Default,,0,0,0,,Еее!
Dialogue: 0,0:06:11.74,0:06:14.04,Default,,0,0,0,,Ей, жеңілуге ​​құлықсыз болу шіркін!
Dialogue: 0,0:06:14.12,0:06:17.66,Default,,0,0,0,,Матч кезінде біреудің қарсыласын ренжітетін бірдеңе айтқанын көрдім!
Dialogue: 0,0:06:17.75,0:06:19.29,Default,,0,0,0,,Алаяқтыққа шағымданады!
Dialogue: 0,0:06:19.37,0:06:22.80,Default,,0,0,0,,Жарайды... бұл дегеніңіз, сіз мәңгілік кезбесіз...
Dialogue: 0,0:06:26.22,0:06:28.26,Default,,0,0,0,,Хуалиен-чан ештеңе түсінбейді!
Dialogue: 0,0:06:28.34,0:06:29.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:29.26,0:06:33.85,Default,,0,0,0,,Қасиетті мереке мен марафон жарысын таразылағанда
Dialogue: 0,0:06:33.93,0:06:37.48,Default,,0,0,0,,Шынымды айтсам, мен марафоннан бас тартамын деп ойладым.
Dialogue: 0,0:06:37.56,0:06:41.19,Default,,0,0,0,,Бастапқыда мен өз-өзіме ыңғайлы жүгіріп қуанатынмын.
Dialogue: 0,0:06:41.27,0:06:44.23,Default,,0,0,0,,Бірақ олай болмады.
Dialogue: 0,0:06:44.32,0:06:47.95,Default,,0,0,0,,Ақырында, қай нұсқаны таңдасам да, мен абдырап қалдым.
Dialogue: 0,0:06:48.61,0:06:51.66,Default,,0,0,0,,Неге екенін түсінбедім.
Dialogue: 0,0:06:52.87,0:06:57.04,Default,,0,0,0,,Бірақ бүгін Хуалиен-чан маған марафонды доғаруды айтты.
Dialogue: 0,0:06:57.12,0:07:00.00,Default,,0,0,0,,Хуалиен-чанның мәре сызығын бірінші кесіп өткенін көру
Dialogue: 0,0:07:00.08,0:07:01.92,Default,,0,0,0,,Мен байқадым
Dialogue: 0,0:07:02.00,0:07:07.05,Default,,0,0,0,,Біреудің мақсаты болып қуандық.
Dialogue: 0,0:07:07.84,0:07:13.35,Default,,0,0,0,,Біз әрқашан басқалар таңданатын ересек адам болып өскіміз келді.
Dialogue: 0,0:07:13.43,0:07:16.43,Default,,0,0,0,,Өйткені Хуалиен-чан бізді өзінің нысанасына айналдырды.
Dialogue: 0,0:07:16.52,0:07:19.85,Default,,0,0,0,,Мен арманыма қарай жүгіруді жалғастырдым.
Dialogue: 0,0:07:19.94,0:07:22.06,Default,,0,0,0,,Біз үшін де солай.
Dialogue: 0,0:07:22.15,0:07:26.07,Default,,0,0,0,,Бұл киелі үйдегі қызмет сияқты ерекше!
Dialogue: 0,0:07:29.44,0:07:33.74,Default,,0,0,0,,Жекпе-жек 7 шілдеде өтетін турнирде шешіледі.
Dialogue: 0,0:07:35.66,0:07:37.83,Default,,0,0,0,,Енді ойлануға болмайды
Dialogue: 0,0:07:38.54,0:07:41.58,Default,,0,0,0,,Бізді басқалар таң қалдырсын
Dialogue: 0,0:07:41.67,0:07:43.50,Default,,0,0,0,,Бар күшіңізбен жүгіріңіз!
Dialogue: 0,0:07:45.92,0:07:48.09,Default,,0,0,0,,Асахиме Амагами...
Dialogue: 0,0:07:50.17,0:07:53.51,Default,,0,0,0,,7 шілде Бұл маңызды ойын, Хуалиен-чан!
Dialogue: 0,0:07:53.59,0:07:55.55,Default,,0,0,0,,Хмф, не қаласаңыз!
Dialogue: 0,0:07:55.64,0:07:59.35,Default,,0,0,0,,Ресми жерде бұл жолы мен жеңгенімді көрсетемін!
Dialogue: 0,0:07:59.43,0:08:01.19,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:08:01.27,0:08:03.65,Default,,0,0,0,,Олай болса, мен сізге қайта барып қолдау көрсететін шығармын.
Dialogue: 0,0:08:03.73,0:08:04.73,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:08:04.81,0:08:06.61,Default,,0,0,0,,Урю-сан келмесе, жарайды.
Dialogue: 0,0:08:06.69,0:08:07.98,Default,,0,0,0,,Не? (Хуалиен) Хэхе
Dialogue: 0,0:08:08.07,0:08:12.36,Default,,0,0,0,,Кешіріңіз, бірақ бұл жолы мен Хуалиен-чанмен кездесуге назар аударғым келеді.
Dialogue: 0,0:08:12.45,0:08:15.24,Default,,0,0,0,,Ал мен жүгіріп келе жатқанда
Dialogue: 0,0:08:15.32,0:08:18.87,Default,,0,0,0,,Мен үйге жеңісті салқын түрде әкелетін ересек адаммын.
Dialogue: 0,0:08:18.95,0:08:22.29,Default,,0,0,0,,Ал... Түсіндім, қолыңнан келгенін істе.
Dialogue: 0,0:08:22.37,0:08:25.67,Default,,0,0,0,,Ақырында мен Асахимге ештеңе істей алмаймын...
Dialogue: 0,0:08:25.75,0:08:28.80,Default,,0,0,0,,Мен әпкем қабылдамаған соң күйзелдім.
Dialogue: 0,0:08:28.88,0:08:30.38,Default,,0,0,0,,Cisco-дан күткендей
Dialogue: 0,0:08:31.72,0:08:33.88,Default,,0,0,0,,Бірақ рахмет
Dialogue: 0,0:08:33.97,0:08:35.47,Default,,0,0,0,,Урю мырза
Dialogue: 0,0:08:36.22,0:08:39.39,Default,,0,0,0,,Сіз әрқашан біз үшін не ойладыңыз
Dialogue: 0,0:08:39.47,0:08:41.85,Default,,0,0,0,,Сіз шынымен бақытты болдыңыз ба?
Dialogue: 0,0:08:41.93,0:08:43.48,Default,,0,0,0,,Сондықтан көңіліңізді түсірмеңіз
Dialogue: 0,0:08:46.61,0:08:49.90,Default,,0,0,0,,Үйде мен бұзылған қарындас боламын.
Dialogue: 0,0:08:49.98,0:08:54.49,Default,,0,0,0,,Маған үлкен махаббат сыйлашы, Cisco жігіті.
Dialogue: 0,0:08:56.03,0:08:59.87,Default,,0,0,0,,Сіз шынымен де әдемі әпке емессіз.
Dialogue: 0,0:08:59.95,0:09:01.62,Default,,0,0,0,,Нишиши
Dialogue: 0,0:09:02.25,0:09:05.08,Default,,0,0,0,,Бірдеңе таза емес жыныстық қатынастың иісі бар.
Dialogue: 0,0:09:05.17,0:09:06.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:06.08,0:09:09.04,Default,,0,0,0,,Аға мен әпке арасындағы шекарадан өтіп жатқанымызға сене алар емеспін...
Dialogue: 0,0:09:09.13,0:09:11.17,Default,,0,0,0,,Хехе, ол туралы не айтасыз?
Dialogue: 0,0:09:11.26,0:09:12.84,Default,,0,0,0,,Ей, дұрыстап теріске шығар!
Dialogue: 0,0:09:12.92,0:09:14.76,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:09:27.40,0:09:29.77,Default,,0,0,0,,Бұл 8 шілде.
Dialogue: 0,0:09:29.86,0:09:33.28,Default,,0,0,0,,Бұл... арман емес, солай ма?
Dialogue: 0,0:09:34.49,0:09:36.82,Default,,0,0,0,,Циклдан шығыңыз!
Dialogue: 0,0:09:36.91,0:09:38.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:39.07,0:09:41.49,Default,,0,0,0,,Біраз уақыт не болар екен деп ойладым.
Dialogue: 0,0:09:41.58,0:09:44.20,Default,,0,0,0,,Енді мен ақыры тыныш оқи аламын.
Dialogue: 0,0:09:44.29,0:09:45.91,Default,,0,0,0,,Урю мырза
Dialogue: 0,0:09:46.00,0:09:48.79,Default,,0,0,0,,«Қанша қайталасаң да, мен әрқашан сенің жаныңда боламын».
Dialogue: 0,0:09:48.88,0:09:52.30,Default,,0,0,0,,Айтсаңыз да, тез бітті.
Dialogue: 0,0:09:52.38,0:09:54.30,Default,,0,0,0,,Оны қыздыруды тоқтатыңыз!
Dialogue: 0,0:09:54.92,0:09:56.22,Default,,0,0,0,,Бұл сіздікі
Dialogue: 0,0:09:56.30,0:10:00.18,Default,,0,0,0,,Әй... менімен бірге бола алмағаныңа көңілің қалмады ма?
Dialogue: 0,0:10:00.93,0:10:02.93,Default,,0,0,0,,Мен өкінбеймін.
Dialogue: 0,0:10:04.68,0:10:09.15,Default,,0,0,0,,Енді мен Урю-санмен болашақты көргім келеді.
Dialogue: 0,0:10:10.02,0:10:11.77,Default,,0,0,0,,Болашақ?
Dialogue: 0,0:10:11.86,0:10:13.32,Default,,0,0,0,,Кола Екеуің де!
Dialogue: 0,0:10:13.40,0:10:16.28,Default,,0,0,0,,Бүгін таңертең неге сонша шу шығарып тұрсың? Көршілерді мазалайсыз, солай емес пе?
Dialogue: 0,0:10:16.36,0:10:18.86,Default,,0,0,0,,Уф... (Асахиме) Ахах кешірші.
Dialogue: 0,0:10:18.95,0:10:21.95,Default,,0,0,0,,Жеңіске жеткеннен кейін қатты толқудың қалай болатынын толық түсінемін.
Dialogue: 0,0:10:22.03,0:10:23.95,Default,,0,0,0,,Бұл көңіл көтерудің уақыты емес.
Dialogue: 0,0:10:24.04,0:10:26.87,Default,,0,0,0,,Бұдан былай тағы бір Танабата фестивалі болады.
Dialogue: 0,0:10:26.96,0:10:28.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:28.96,0:10:32.34,Default,,0,0,0,,Иә? Не, сен әлі Асахиме айтқан жоқсың ба?
Dialogue: 0,0:10:32.42,0:10:33.50,Default,,0,0,0,,(Урюдің алдамшы күлкісі)
Dialogue: 0,0:10:33.59,0:10:37.38,Default,,0,0,0,,Бұл... Танабаттан кейінгі мереке ме?
Dialogue: 0,0:10:37.47,0:10:40.55,Default,,0,0,0,,Иә, осы жылдан бастап Асахиме храмында.
Dialogue: 0,0:10:40.64,0:10:43.76,Default,,0,0,0,,7 шілде «Танабата мацуриге дейінгі» деп белгіленген
Dialogue: 0,0:10:43.85,0:10:49.73,Default,,0,0,0,,«Танабата постфестивалін» ай күнтізбесі бойынша 7 тамызда өткізуді ұйғардық.
Dialogue: 0,0:10:50.23,0:10:55.03,Default,,0,0,0,,Мен Йойфука-саннан бұл іс бойынша да ұсыныс алдым.
Dialogue: 0,0:10:55.11,0:10:57.36,Default,,0,0,0,,Йойфука-сан...
Dialogue: 0,0:10:57.86,0:11:00.74,Default,,0,0,0,,Асахиме-сан Танабата Фестивальден кейінгі
Dialogue: 0,0:11:00.82,0:11:05.66,Default,,0,0,0,,Жарнама менеджері ретінде қызықты жобаларды ойлап табыңыз.
Dialogue: 0,0:11:05.74,0:11:08.41,Default,,0,0,0,,Иә! Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:11:16.25,0:11:20.97,Default,,0,0,0,,Канжин храмы Танабата постфестивалі жалғасуда!
Dialogue: 0,0:11:21.05,0:11:25.18,Default,,0,0,0,,Қаласаңыз, осы қағазға өз тілегіңізді жазыңыз!
Dialogue: 0,0:11:25.26,0:11:28.98,Default,,0,0,0,,Уау, Орихименің костюмін қарашы, қандай сүйкімді!
Dialogue: 0,0:11:29.06,0:11:31.19,Default,,0,0,0,,Мен суретке түсіре аламын ба?
Dialogue: 0,0:11:31.27,0:11:33.98,Default,,0,0,0,,О, мен мұндай көп адам жиналады деп күтпеп едім.
Dialogue: 0,0:11:34.06,0:11:37.57,Default,,0,0,0,,Аса Чан күткендей, бұл жақсы идея~
Dialogue: 0,0:11:38.24,0:11:42.82,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл костюм сізге жараса ма? Хикобоши мырза
Dialogue: 0,0:11:42.91,0:11:46.20,Default,,0,0,0,,Саған жарасады деп ойлаймын, бірақ... мен неге Хикобошимін?
Dialogue: 0,0:11:46.28,0:11:47.83,Default,,0,0,0,,Эххе~
Dialogue: 0,0:11:47.91,0:11:52.54,Default,,0,0,0,,Бірақ ғибадатхана қызының ғибадатханада косплей жасауы дұрыс па?
Dialogue: 0,0:11:52.62,0:11:54.33,Default,,0,0,0,,Юна мені жиі кешіретін.
Dialogue: 0,0:11:54.42,0:11:59.88,Default,,0,0,0,,Ал... жарайды, егер ол торий қақпасының сыртында болса, құдайға құрметсіздік болмайды.
Dialogue: 0,0:11:59.97,0:12:03.89,Default,,0,0,0,,Мен оны киіп алсам, онша әсер етпейді деп ойлаймын.
Dialogue: 0,0:12:03.97,0:12:06.81,Default,,0,0,0,,Апалы-сіңлілі үшеуінің костюмдері сәйкес келе алмаса.
Dialogue: 0,0:12:06.89,0:12:08.72,Default,,0,0,0,,Табиғи емес көрінеді...
Dialogue: 0,0:12:08.81,0:12:10.85,Default,,0,0,0,,Сондықтан сіз оны киіп көргіңіз келді.
Dialogue: 0,0:12:13.94,0:12:17.57,Default,,0,0,0,,Менің көзімнен ештеңе болмаған сияқты.
Dialogue: 0,0:12:17.65,0:12:20.86,Default,,0,0,0,,Жазғы демалыспен қоса, жарнамалық әсер керемет!
Dialogue: 0,0:12:20.94,0:12:23.70,Default,,0,0,0,,Мұның бәрі жарнама менеджерінің арқасында.
Dialogue: 0,0:12:23.78,0:12:27.37,Default,,0,0,0,,Өйткені, мерекелер тек Аса-чанмен ғана мүмкін.
Dialogue: 0,0:12:27.45,0:12:29.41,Default,,0,0,0,,үшінна бірге болған жақсы!
Dialogue: 0,0:12:29.49,0:12:30.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:31.37,0:12:33.25,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:33.96,0:12:37.50,Default,,0,0,0,,Эххе, бірдеңе дұрыс емес.
Dialogue: 0,0:12:39.46,0:12:42.51,Default,,0,0,0,,Аса-чан, соңғы кездері бірдеңе өзгерді.
Dialogue: 0,0:12:42.59,0:12:45.22,Default,,0,0,0,,Не? Ол қай бөлігі?
Dialogue: 0,0:12:45.30,0:12:47.76,Default,,0,0,0,,Хмм, мен білмеймін...
Dialogue: 0,0:12:47.97,0:12:51.06,Default,,0,0,0,,«Әпке» сияқты сезінеді
Dialogue: 0,0:12:51.14,0:12:52.27,Default,,0,0,0,,Сіздер жазды қалай өткізіп жатырсыздар?
Dialogue: 0,0:12:52.35,0:12:54.77,Default,,0,0,0,,Бұл табиғи нәрсе, ол менің әпкем.
Dialogue: 0,0:12:54.85,0:12:57.52,Default,,0,0,0,,Ахаха дұрыс.
Dialogue: 0,0:12:58.15,0:13:02.07,Default,,0,0,0,,Бірақ бірдеңе дұрыс болмады...
Dialogue: 0,0:13:02.15,0:13:03.15,Default,,0,0,0,,Хехехе
Dialogue: 0,0:13:03.90,0:13:07.32,Default,,0,0,0,,Жалқау және күшті Аса Чан да сүйкімді.
Dialogue: 0,0:13:07.41,0:13:11.70,Default,,0,0,0,,Адал болғаннан кейін өзіңізді бұрынғыдан да сүйкімді болып кеткендей сезінесіз бе?
Dialogue: 0,0:13:14.66,0:13:16.17,Default,,0,0,0,,(Джунпей) Бірақ ол мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:13:17.46,0:13:19.04,Default,,0,0,0,,Біздегі сүйкімді нәрсе
Dialogue: 0,0:13:19.75,0:13:23.67,Default,,0,0,0,,Мұның бәрі маған қамқорлық жасаған үлкен апаларымның арқасы.
Dialogue: 0,0:13:23.76,0:13:28.35,Default,,0,0,0,,Мен сенің қарындасың болғаныма өте қуаныштымын.
Dialogue: 0,0:13:28.43,0:13:30.85,Default,,0,0,0,,Не, кенет ұялып қалдың ба?
Dialogue: 0,0:13:30.93,0:13:34.89,Default,,0,0,0,,Эххе, апа, мен бақыттымын.
Dialogue: 0,0:13:40.27,0:13:43.65,Default,,0,0,0,,Танабатадан кейінгі фестиваль өте сәтті өткен сияқты.
Dialogue: 0,0:13:43.74,0:13:45.53,Default,,0,0,0,,Йойфука-сан!
Dialogue: 0,0:13:45.61,0:13:47.86,Default,,0,0,0,,Келдің!
Dialogue: 0,0:13:47.95,0:13:51.54,Default,,0,0,0,,Йойфука-санның ұсынысының арқасында Танабата көңілді болды.
Dialogue: 0,0:13:51.62,0:13:54.04,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:13:54.12,0:13:57.00,Default,,0,0,0,,О, бұл мен емеспін.
Dialogue: 0,0:13:57.08,0:13:58.79,Default,,0,0,0,,Иә? Бірақ...
Dialogue: 0,0:13:58.88,0:14:00.71,Default,,0,0,0,,Ах! Ол кетті!
Dialogue: 0,0:14:00.79,0:14:03.51,Default,,0,0,0,,Маған бұл туралы ешкімге айтпа деген!
Dialogue: 0,0:14:03.59,0:14:05.80,Default,,0,0,0,,Мен сондай бейқаммын!
Dialogue: 0,0:14:05.88,0:14:07.05,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:08.22,0:14:09.80,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз
Dialogue: 0,0:14:09.89,0:14:12.14,Default,,0,0,0,,Осы уақыт ішінде Цукигами храмында
Dialogue: 0,0:14:12.22,0:14:16.48,Default,,0,0,0,,Танабата мейрамы ай күнтізбесі бойынша тамыз айында өтеді деп айтпадың ба?
Dialogue: 0,0:14:16.56,0:14:20.77,Default,,0,0,0,,Мен Урю мырзамен бұл туралы сөйлестім бе?
Dialogue: 0,0:14:20.86,0:14:23.28,Default,,0,0,0,,А, мен түсіндім, циклде!
Dialogue: 0,0:14:23.36,0:14:25.36,Default,,0,0,0,,А, жоқ, уһ, бәрібір...
Dialogue: 0,0:14:25.44,0:14:27.70,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:14:28.66,0:14:30.45,Default,,0,0,0,,Бұдан былай, менің ғибадатханада.
Dialogue: 0,0:14:30.53,0:14:33.83,Default,,0,0,0,,Ай күнтізбесі бойынша Танабата мерекесін өткізе аламыз ба?
Dialogue: 0,0:14:35.00,0:14:36.71,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:36.79,0:14:41.46,Default,,0,0,0,,Жаңа фестивальді асығыс орнатуға келгенде, бұл жай ғана ғибадатхана емес.
Dialogue: 0,0:14:41.54,0:14:44.67,Default,,0,0,0,,Демеуші, көршілес бірлестігі, сауда ауданы, т.б.
Dialogue: 0,0:14:44.75,0:14:47.97,Default,,0,0,0,,Бұл көптеген жолдармен қиындық тудырады.
Dialogue: 0,0:14:48.05,0:14:53.47,Default,,0,0,0,,Сол адамдарды көндірмесек, шараны өткізе алмаймыз.
Dialogue: 0,0:14:53.56,0:14:56.73,Default,,0,0,0,,Сіз соншалықты алысқа барып, іс-шараны өткізгіңіз келе ме?
Dialogue: 0,0:14:57.39,0:15:01.48,Default,,0,0,0,,Иә, мен оны қатты ұстағым келеді!
Dialogue: 0,0:15:02.61,0:15:06.32,Default,,0,0,0,,Сенің ынта-жігеріңе себеп болған сияқты.
Dialogue: 0,0:15:06.40,0:15:09.61,Default,,0,0,0,,Бұл біз үшін...
Dialogue: 0,0:15:09.70,0:15:11.24,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:15:12.03,0:15:16.58,Default,,0,0,0,,Жоқ... ештеңе... ештеңе...
Dialogue: 0,0:15:17.33,0:15:20.25,Default,,0,0,0,,Ухуху, солай ма?
Dialogue: 0,0:15:20.33,0:15:22.71,Default,,0,0,0,,Аа, мен не дедім.
Dialogue: 0,0:15:22.79,0:15:25.55,Default,,0,0,0,,Өтінемін, Урю-саннан құпия сақтаңыз.
Dialogue: 0,0:15:25.63,0:15:27.38,Default,,0,0,0,,Маған не болды?
Dialogue: 0,0:15:30.97,0:15:34.22,Default,,0,0,0,,Сондықтан бұл ештеңе емес!
Dialogue: 0,0:15:34.30,0:15:36.51,Default,,0,0,0,,Неге сонша ашуланасың? Сіз бүлікшіл кезеңдесіз бе?
Dialogue: 0,0:15:36.60,0:15:39.64,Default,,0,0,0,,Қазірдің өзінде! Урю-сан - ақымақ!
Dialogue: 0,0:15:40.35,0:15:41.77,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:41.85,0:15:45.27,Default,,0,0,0,,Уфуфу, бұл жас.
Dialogue: 0,0:15:45.36,0:15:46.27,Default,,0,0,0,,(сыбдырлаған дыбыс)
Dialogue: 0,0:15:46.36,0:15:47.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:49.11,0:15:51.53,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:52.16,0:15:54.53,Default,,0,0,0,,Егер Йойфуканың кеңесі болмаса
Dialogue: 0,0:15:54.62,0:15:57.54,Default,,0,0,0,,Оның тілегі орындалмады.
Dialogue: 0,0:15:58.83,0:16:01.41,Default,,0,0,0,,Мен ештеңе істеген жоқпын
Dialogue: 0,0:16:01.50,0:16:04.75,Default,,0,0,0,,Бұл қиындықты ешкім жеңе алмады.
Dialogue: 0,0:16:04.83,0:16:07.00,Default,,0,0,0,,Сіз емессіз бе?
Dialogue: 0,0:16:07.50,0:16:11.68,Default,,0,0,0,,Мм... Мен біртүрлі нәрсе естіп тұрмын, Йойфука-сан.
Dialogue: 0,0:16:12.68,0:16:15.55,Default,,0,0,0,,Бұл қанша Танабата мерекесі?
Dialogue: 0,0:16:16.76,0:16:20.64,Default,,0,0,0,,...
Dialogue: 0,0:16:27.77,0:16:29.19,Default,,0,0,0,,(Хонцубо қоңырауының дыбысы)
Dialogue: 0,0:16:29.28,0:16:30.82,Default,,0,0,0,,(Кашива қолы)
Dialogue: 0,0:16:30.90,0:16:35.95,Default,,0,0,0,,Сіз әлі де еркелік ойнағанды ұнататын сияқтысыз.
Dialogue: 0,0:16:46.88,0:16:48.29,Default,,0,0,0,,Енді Танабата фестивалі
Dialogue: 0,0:16:48.38,0:16:50.92,Default,,0,0,0,,Мұның бәрі жақсы аяқталды.
Dialogue: 0,0:16:51.55,0:16:55.18,Default,,0,0,0,,Таң атты! Отшашу басталғалы жатыр!
Dialogue: 0,0:16:55.26,0:16:57.93,Default,,0,0,0,,Иә, мен бірден барамын!
Dialogue: 0,0:16:58.01,0:17:01.93,Default,,0,0,0,,О, жоқ... Менің шашымды байлауға уақытым жоқ деп ойлаймын.
Dialogue: 0,0:17:02.02,0:17:04.48,Default,,0,0,0,,О, маған қарашы. (Ер) Әй, қош келдіңіз.
Dialogue: 0,0:17:04.56,0:17:06.69,Default,,0,0,0,,О, сен керемет адамсың.
Dialogue: 0,0:17:06.77,0:17:09.73,Default,,0,0,0,,Азық-түлік сататын дүңгіршектер көп, бұл қызық~
Dialogue: 0,0:17:10.53,0:17:12.61,Default,,0,0,0,,Сәлем! (Еркек) А?
Dialogue: 0,0:17:12.69,0:17:16.74,Default,,0,0,0,,Ябба, сен сондай сүйкімдісің. Ванчан, сенімен сөйлесуім керек пе?
Dialogue: 0,0:17:16.82,0:17:20.24,Default,,0,0,0,,Жоқ, кедергілер тым жоғары.
Dialogue: 0,0:17:22.33,0:17:25.58,Default,,0,0,0,,Шынында да, әлемдегі ер адамдар тұрғысынан
Dialogue: 0,0:17:25.67,0:17:27.75,Default,,0,0,0,,Бұл Такаминнің гүлі, солай емес пе?
Dialogue: 0,0:17:27.83,0:17:31.46,Default,,0,0,0,,Екеуі де сексуалды және өте әдемі.
Dialogue: 0,0:17:32.46,0:17:35.88,Default,,0,0,0,,Мен дұрыс киінгенімді қалаймын.
Dialogue: 0,0:17:35.97,0:17:39.64,Default,,0,0,0,,Жалғыз мен ғана балаға ұқсайтыным ұят...
Dialogue: 0,0:17:40.18,0:17:41.01,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:41.10,0:17:44.89,Default,,0,0,0,,Бұл сенің әпкеңмен кімнің көп жеңетінін білу үшін жарыс!
Dialogue: 0,0:17:44.98,0:17:48.15,Default,,0,0,0,,Маған қарап тұра бер. Сізге осындай мақта кәмпит керек пе?
Dialogue: 0,0:17:48.23,0:17:50.36,Default,,0,0,0,,Кешіріңіз! Бұл менің ниетім емес...
Dialogue: 0,0:17:50.44,0:17:52.40,Default,,0,0,0,,Қарап тұру жеткілікті.
Dialogue: 0,0:17:53.32,0:17:56.74,Default,,0,0,0,,Әпкем де балаша, ұятсыз ғой.
Dialogue: 0,0:17:58.36,0:18:02.16,Default,,0,0,0,,Екеуің де тым қатты толқыған жоқсыңдар ма?
Dialogue: 0,0:18:02.24,0:18:06.71,Default,,0,0,0,,Бұл туралы мәңгілік уайымдама, мен отшашу үшін орын алайын.
Dialogue: 0,0:18:08.08,0:18:10.17,Default,,0,0,0,,Сіз де тыңдайсыз ба?
Dialogue: 0,0:18:12.50,0:18:15.92,Default,,0,0,0,,Ах... Кешіріңіз!
Dialogue: 0,0:18:18.01,0:18:19.89,Default,,0,0,0,,Мен сені әпкең деп қателестім бе?
Dialogue: 0,0:18:19.97,0:18:22.43,Default,,0,0,0,,Ахаха сондай сүйкімді~
Dialogue: 0,0:18:23.39,0:18:26.14,Default,,0,0,0,,Таку! Жалғыз не істеп жатырсың?
Dialogue: 0,0:18:26.23,0:18:27.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:27.14,0:18:28.44,Default,,0,0,0,,Ух... Урю-сан
Dialogue: 0,0:18:28.52,0:18:30.44,Default,,0,0,0,,Сіз олардан бөлініп шықтыңыз ба?
Dialogue: 0,0:18:30.52,0:18:32.07,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:18:33.65,0:18:34.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:35.07,0:18:35.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:53.59,0:18:56.17,Default,,0,0,0,,Оларды осы жерде күтеміз бе?
Dialogue: 0,0:18:56.67,0:18:58.09,Default,,0,0,0,,Иә
Dialogue: 0,0:19:03.68,0:19:07.18,Default,,0,0,0,,Бұл өте жаман болды, сіз барлық араласатын нәрселерді айттыңыз.
Dialogue: 0,0:19:07.27,0:19:08.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:08.18,0:19:10.81,Default,,0,0,0,,Мен мұны осы циклде қатты сезіндім.
Dialogue: 0,0:19:10.90,0:19:13.19,Default,,0,0,0,,Түптеп келгенде, мен өзімнің қанағаттанамын.
Dialogue: 0,0:19:13.27,0:19:15.98,Default,,0,0,0,,Мен жай ғана итермеледім.
Dialogue: 0,0:19:16.07,0:19:19.61,Default,,0,0,0,,Шындығында, сіз оны өзіңіз жеңуіңіз керек еді.
Dialogue: 0,0:19:21.07,0:19:24.24,Default,,0,0,0,,Урю-санның әдеттегіден көбірек айналдырғанына сенімдімін.
Dialogue: 0,0:19:24.33,0:19:26.66,Default,,0,0,0,,Онымен айналысу керек еді, солай емес пе?
Dialogue: 0,0:19:26.74,0:19:28.58,Default,,0,0,0,,Мен ештеңе айта алмаймын...
Dialogue: 0,0:19:29.62,0:19:32.50,Default,,0,0,0,,Бірақ ол басшылық қызметін атқарды.
Dialogue: 0,0:19:33.21,0:19:37.88,Default,,0,0,0,,Мен өзімді үнемі кезіп жүргендей сезінемін, өйткені мен жалғыз қалғанда жолды да көрмедім.
Dialogue: 0,0:19:37.96,0:19:41.26,Default,,0,0,0,,Өйткені Урю мырза маған неше түрлі жолдарды көрсетті.
Dialogue: 0,0:19:41.34,0:19:44.01,Default,,0,0,0,,Бізде таңдау болды.
Dialogue: 0,0:19:44.10,0:19:47.64,Default,,0,0,0,,Біз оны бірге еңсердік.
Dialogue: 0,0:19:48.85,0:19:50.73,Default,,0,0,0,,Жоқ, бұл туралы уайымдаудың қажеті жоқ!
Dialogue: 0,0:19:50.81,0:19:52.56,Default,,0,0,0,,Менімен көбірек ойнай аласыз деп үміттенемін!
Dialogue: 0,0:19:52.65,0:19:55.27,Default,,0,0,0,,Сіз мазохистке ұқсамайсыз ба?
Dialogue: 0,0:19:57.61,0:20:00.24,Default,,0,0,0,,Ой, отшашу басталды.
Dialogue: 0,0:20:02.20,0:20:05.87,Default,,0,0,0,,Жоқ, отшашуды тамашалайтын жас шамасындағы екі еркек пен әйел.
Dialogue: 0,0:20:05.95,0:20:08.20,Default,,0,0,0,,Бұл қызықты жағдай.
Dialogue: 0,0:20:08.29,0:20:12.29,Default,,0,0,0,,Бұл Урю-сан, ол маған байқаусызда ғашық болып қалды.
Dialogue: 0,0:20:12.92,0:20:15.67,Default,,0,0,0,,Шынымен, сен мені мазақтап тұрсың.
Dialogue: 0,0:20:15.75,0:20:18.88,Default,,0,0,0,,Маған қазір сен де, мені де қызықтырмайды.
Dialogue: 0,0:20:18.96,0:20:22.30,Default,,0,0,0,,Тағы да~ Мен ұялдым~
Dialogue: 0,0:20:23.59,0:20:27.06,Default,,0,0,0,,Мен білемін, бұл туралы.
Dialogue: 0,0:20:27.14,0:20:29.31,Default,,0,0,0,,Қолымды ұстаған адам
Dialogue: 0,0:20:29.39,0:20:32.89,Default,,0,0,0,,Сен де менің тілегімді орындауға тырыстың.
Dialogue: 0,0:20:32.98,0:20:36.31,Default,,0,0,0,,Өйткені біз «кіші апалармыз», солай ма?
Dialogue: 0,0:20:36.40,0:20:39.40,Default,,0,0,0,,Маған қарындасыңдай қарасаң да
Dialogue: 0,0:20:39.48,0:20:42.32,Default,,0,0,0,,Үйдегі үлкен апалар сияқты екенімізге сенімдімін.
Dialogue: 0,0:20:42.40,0:20:45.57,Default,,0,0,0,,Мен Урю-санның жүрегін дүрсілдете алмаймын.
Dialogue: 0,0:20:46.20,0:20:47.83,Default,,0,0,0,,Бұдан былай ше?
Dialogue: 0,0:20:47.91,0:20:52.41,Default,,0,0,0,,Біреу Урю мырзаны күйеу баласындай қарсы алатын күн келсе де.
Dialogue: 0,0:20:52.50,0:20:55.83,Default,,0,0,0,,Менің ойымша, біз басқа тарап болмаймыз.
Dialogue: 0,0:21:24.03,0:21:27.37,Default,,0,0,0,,Ах... Асахиме
Dialogue: 0,0:21:27.45,0:21:28.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:29.95,0:21:33.91,Default,,0,0,0,,Мен Урюді жақсы көремін!
Dialogue: 0,0:21:37.58,0:21:42.01,Default,,0,0,0,,Бірақ біз әлі жеңілген жоқпыз.
Dialogue: 0,0:21:43.97,0:21:48.01,Default,,0,0,0,,Бұл жарыста да жеңіске жетуді мақсат етіп отырмыз.
Dialogue: 0,0:21:49.10,0:21:53.14,Default,,0,0,0,,Эй, Аса-чан, Урю-кун!
Dialogue: 0,0:21:53.22,0:21:56.64,Default,,0,0,0,,Мо... Му! Екеуің кешігіп қалдыңдар
Dialogue: 0,0:21:59.31,0:22:01.98,Default,,0,0,0,,Шынымен... иә...
Dialogue: 0,0:22:04.99,0:22:10.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:30.95,0:23:34.91,Default,,0,0,0,,～♪
