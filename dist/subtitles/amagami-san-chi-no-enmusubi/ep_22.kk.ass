Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.21,0:00:03.67,Default,,0,0,0,,Менің атым Камишу Урю
Dialogue: 0,0:00:03.75,0:00:06.38,Default,,0,0,0,,Мені киелі жердің мұрагері етіп қабылдады.
Dialogue: 0,0:00:06.46,0:00:08.67,Default,,0,0,0,,Қасиетті әпкелердің бірімен
Dialogue: 0,0:00:08.75,0:00:11.42,Default,,0,0,0,,Мен үйленемін!
Dialogue: 0,0:00:11.51,0:00:14.14,Default,,0,0,0,,Мен білмеймін. Сен кімсің? (Урю) А?
Dialogue: 0,0:00:14.22,0:00:16.68,Default,,0,0,0,,Бұл жиіркенішті (Урю) Иә!
Dialogue: 0,0:00:16.76,0:00:19.56,Default,,0,0,0,,Қойылым отаку қиялына ұқсайды.
Dialogue: 0,0:00:19.64,0:00:21.06,Default,,0,0,0,,кускусы
Dialogue: 0,0:00:21.14,0:00:22.94,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,0:00:23.02,0:00:24.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:24.15,0:00:26.94,Default,,0,0,0,,О... сәл күте тұрыңыз!
Dialogue: 0,0:00:27.02,0:00:31.19,Default,,0,0,0,,Неге мені ешкім есіне түсірмейді?
Dialogue: 0,0:00:31.28,0:00:34.86,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:00:34.95,0:00:35.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:35.87,0:00:37.20,Default,,0,0,0,,Ах~
Dialogue: 0,0:00:37.28,0:00:39.79,Default,,0,0,0,,Ақыры мен ояндым
Dialogue: 0,0:00:39.87,0:00:41.58,Default,,0,0,0,,Күндізгі жарық...
Dialogue: 0,0:00:41.66,0:00:43.71,Default,,0,0,0,,Мен таңғы ас әзірледім.
Dialogue: 0,0:00:43.79,0:00:46.04,Default,,0,0,0,,Тезірек бетіңді жу.
Dialogue: 0,0:00:46.13,0:00:49.34,Default,,0,0,0,,Ах... (есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:00:53.80,0:00:55.97,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:00:57.01,0:01:00.10,Default,,0,0,0,,Ғибадатханада өткізілген күнделікті өмір жоғалып кеткеннен кейін —
Dialogue: 0,0:01:01.56,0:01:03.48,Default,,0,0,0,,Үш күн болды
Dialogue: 0,0:01:04.98,0:01:09.98,Default,,0,0,0,,♪～
Dialogue: 0,0:02:29.94,0:02:34.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:38.20,0:02:39.41,Default,,0,0,0,,Урю Осойо~
Dialogue: 0,0:02:39.49,0:02:40.91,Default,,0,0,0,,Суйо~
Dialogue: 0,0:02:40.99,0:02:42.83,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:42.91,0:02:45.54,Default,,0,0,0,,Бір нәрсеге ренжідіңіз бе?
Dialogue: 0,0:02:45.62,0:02:47.83,Default,,0,0,0,,Тағы бір қорқынышты түс көрдіңіз бе?
Dialogue: 0,0:02:49.62,0:02:53.04,Default,,0,0,0,,Осыдан бірнеше күн бұрын оны зияратханаға апарған деген.
Dialogue: 0,0:02:53.13,0:02:55.09,Default,,0,0,0,,Сіз мүмкін емес нәрсені айттыңыз, солай ма?
Dialogue: 0,0:02:55.17,0:02:57.67,Default,,0,0,0,,Мен қатты таң қалдым.
Dialogue: 0,0:02:57.76,0:02:59.30,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:02:59.38,0:03:01.59,Default,,0,0,0,,Сіз оқуға тым көп көңіл бөлесіз бе?
Dialogue: 0,0:03:01.68,0:03:03.51,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:03:03.60,0:03:05.01,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:03:05.10,0:03:07.93,Default,,0,0,0,,Әзірше оқу бітіргенше осында қалуға болады.
Dialogue: 0,0:03:08.02,0:03:09.10,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:03:10.69,0:03:12.44,Default,,0,0,0,,Ештеңеге алаңдамаңыз
Dialogue: 0,0:03:12.52,0:03:15.65,Default,,0,0,0,,Өзіңізді тым қатты итермеңіз және емтиханға назарыңызды аударыңыз.
Dialogue: 0,0:03:16.36,0:03:17.78,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:03:18.65,0:03:20.11,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:20.20,0:03:23.49,Default,,0,0,0,,Менің басымнан өткен оғаш оқиғаның шын мәні осы.
Dialogue: 0,0:03:24.20,0:03:27.04,Default,,0,0,0,,Шамасы мен және Хакуджи
Dialogue: 0,0:03:27.12,0:03:30.96,Default,,0,0,0,,Кисекиеннен кетпеген сияқты.
Dialogue: 0,0:03:37.30,0:03:39.42,Default,,0,0,0,,Мен мекемеден шықпадым
Dialogue: 0,0:03:39.51,0:03:43.43,Default,,0,0,0,,Мен Хакухимен бірге осы мектепте болуым керек.
Dialogue: 0,0:03:43.51,0:03:44.72,Default,,0,0,0,,Жоғарғы ұшы
Dialogue: 0,0:03:44.80,0:03:47.10,Default,,0,0,0,,Сондай-ақ, 100 ұпай керемет.
Dialogue: 0,0:03:47.18,0:03:49.89,Default,,0,0,0,,Бұл жолы да бар күшіңді салдың.
Dialogue: 0,0:03:49.98,0:03:52.65,Default,,0,0,0,,үшін бірдей үлгі алуы керек.
Dialogue: 0,0:03:52.73,0:03:53.56,Default,,0,0,0,,Иә
Dialogue: 0,0:03:53.65,0:03:56.73,Default,,0,0,0,,Мені Канжин храмы асырап алған жоқ.
Dialogue: 0,0:03:56.82,0:04:00.03,Default,,0,0,0,,Басқаша айтқанда, олар да мені ұмытқан жоқ.
Dialogue: 0,0:04:00.11,0:04:02.49,Default,,0,0,0,,Бұл сіз алдымен білмегеніңізді білдіреді.
Dialogue: 0,0:04:02.57,0:04:04.82,Default,,0,0,0,,Яруян, күткендей, сыныпта 1 орын
Dialogue: 0,0:04:04.91,0:04:06.49,Default,,0,0,0,,Бұл жай ғана кездейсоқтық.
Dialogue: 0,0:04:06.58,0:04:08.08,Default,,0,0,0,,Кішіпейілділік
Dialogue: 0,0:04:08.16,0:04:10.58,Default,,0,0,0,,Сізге Киото университетінен ұсыныс түсуі мүмкін бе?
Dialogue: 0,0:04:10.66,0:04:12.71,Default,,0,0,0,,Хонма, бұл керемет.
Dialogue: 0,0:04:13.37,0:04:14.92,Default,,0,0,0,,Маған бұл дүниеде
Dialogue: 0,0:04:15.00,0:04:18.84,Default,,0,0,0,,Киото университетінің Медицина мектебінде ұсыныс ұясы туралы әңгіме бар сияқты.
Dialogue: 0,0:04:19.46,0:04:22.42,Default,,0,0,0,,Бастапқы әлемде мұндай нәрсе болмаған.
Dialogue: 0,0:04:23.72,0:04:26.97,Default,,0,0,0,,Ал мені қызықтыратын нәрсе туралы айтсам...
Dialogue: 0,0:04:29.18,0:04:30.47,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:30.56,0:04:31.81,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:39.53,0:04:41.69,Default,,0,0,0,,Урю Иә
Dialogue: 0,0:04:41.78,0:04:43.07,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:04:43.15,0:04:45.57,Default,,0,0,0,,Жоқ... Ештеңе жоқ, өзім жеймін.
Dialogue: 0,0:04:46.66,0:04:49.45,Default,,0,0,0,,Бұл дүниеде мен және күн сәулесі
Dialogue: 0,0:04:49.54,0:04:52.45,Default,,0,0,0,,Олар кездесіп жүрген сияқты.
Dialogue: 0,0:04:52.54,0:04:54.87,Default,,0,0,0,,Ей жігітім, салқындаған жоқсың ба?
Dialogue: 0,0:04:54.96,0:04:57.46,Default,,0,0,0,,Не? (Оқушы) Хакуджи мен оны аяймын.
Dialogue: 0,0:04:57.54,0:04:59.59,Default,,0,0,0,,Жақсы, бұл туралы уайымдама.
Dialogue: 0,0:05:02.34,0:05:03.76,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:07.18,0:05:10.93,Default,,0,0,0,,Маған Урюдің намысқойлығы да ұнайды.
Dialogue: 0,0:05:11.64,0:05:12.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:13.98,0:05:15.27,Default,,0,0,0,,Хех!
Dialogue: 0,0:05:15.35,0:05:17.73,Default,,0,0,0,,Эй, эй, біз қызық болып жатырмыз
Dialogue: 0,0:05:17.81,0:05:19.82,Default,,0,0,0,,Шулы, мені қалдыр!
Dialogue: 0,0:05:19.90,0:05:20.77,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:31.12,0:05:34.50,Default,,0,0,0,,Хмм, не болды? Маған солай қарашы
Dialogue: 0,0:05:34.58,0:05:36.29,Default,,0,0,0,,Жоқ... бұл ештеңе емес!
Dialogue: 0,0:05:37.00,0:05:41.21,Default,,0,0,0,,Мен... енді өзімнің бастапқы әлеміме оралудың жолын ойлауым керек.
Dialogue: 0,0:05:41.30,0:05:44.51,Default,,0,0,0,,Біз бұлай өмір сүре алмаймыз.
Dialogue: 0,0:05:47.55,0:05:49.43,Default,,0,0,0,,Әй, күн!
Dialogue: 0,0:05:49.51,0:05:52.72,Default,,0,0,0,,Сіз бұл үш апа туралы білмейтініңізге сенімдісіз бе?
Dialogue: 0,0:05:52.81,0:05:55.85,Default,,0,0,0,,Тағы да? Егер сіз білмесеңіз
Dialogue: 0,0:05:55.93,0:05:58.98,Default,,0,0,0,,Айтайын дегенім, мен ондай құбыжықтарды білмеймін.
Dialogue: 0,0:05:59.06,0:06:01.23,Default,,0,0,0,,Сіз әлі де сурет салуда нашарсыз.
Dialogue: 0,0:06:01.32,0:06:02.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:02.65,0:06:05.53,Default,,0,0,0,,Урю-сан, сен соңғы кездері біртүрлі болып жүрсің.
Dialogue: 0,0:06:05.61,0:06:08.49,Default,,0,0,0,,Менің ойымша, сіз Майхиру-санды тексеру үшін көруіңіз керек...
Dialogue: 0,0:06:08.99,0:06:11.99,Default,,0,0,0,,Мен біртүрлі нәрсе айтып тұрғанымды білемін.
Dialogue: 0,0:06:12.08,0:06:15.29,Default,,0,0,0,,Бірақ нағыз мені ғибадатхана қабылдады.
Dialogue: 0,0:06:15.37,0:06:17.75,Default,,0,0,0,,Мен жаңа отбасымен тұрамын!
Dialogue: 0,0:06:18.71,0:06:23.00,Default,,0,0,0,,Міне, сен екеуміз...бірақ кездеспейміз.
Dialogue: 0,0:06:23.09,0:06:25.38,Default,,0,0,0,,Екеуміз де Киото университетіне түсу үшін көп жұмыс істеп жатырмыз.
Dialogue: 0,0:06:25.46,0:06:27.55,Default,,0,0,0,,Мен сол дүниеге оралғым келеді!
Dialogue: 0,0:06:31.39,0:06:35.02,Default,,0,0,0,,Кешіріңіз, мен шынымен түсінбеймін...
Dialogue: 0,0:06:37.06,0:06:39.77,Default,,0,0,0,,Бұл менімен айналмалы түрде ажырасқың келетінін білдіре ме?
Dialogue: 0,0:06:39.85,0:06:41.44,Default,,0,0,0,,Не? О, жоқ...
Dialogue: 0,0:06:41.52,0:06:43.07,Default,,0,0,0,,Мәселе бұл емес...
Dialogue: 0,0:06:43.15,0:06:44.19,Default,,0,0,0,,Айт!
Dialogue: 0,0:06:44.27,0:06:46.11,Default,,0,0,0,,Урюдің ақымақ! Тас бас!
Dialogue: 0,0:06:46.19,0:06:47.19,Default,,0,0,0,,Қыңыр және қыңыр!
Dialogue: 0,0:06:47.28,0:06:48.20,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:48.28,0:06:51.07,Default,,0,0,0,,Ал... күте тұрыңыз! Әңгімені тыңдаңыз...
Dialogue: 0,0:06:51.16,0:06:52.70,Default,,0,0,0,,Бұл жайбарақат~
Dialogue: 0,0:06:52.78,0:06:54.45,Default,,0,0,0,,Майхиру-сан
Dialogue: 0,0:06:54.54,0:06:57.20,Default,,0,0,0,,Сіз әлі де қарым-қатынаста нашарсыз.
Dialogue: 0,0:06:57.29,0:06:58.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:58.21,0:07:01.21,Default,,0,0,0,,Неліктен сіз өзіңіздің сезімдеріңізді күндізгі уақытта көбірек ойламайсыз?
Dialogue: 0,0:07:01.29,0:07:02.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:02.96,0:07:04.21,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:07:04.29,0:07:08.22,Default,,0,0,0,,Бала жаңа ғана мекемеге келгенде...
Dialogue: 0,0:07:09.34,0:07:11.47,Default,,0,0,0,,Менің отбасым апаттан қайтыс болғаннан бері
Dialogue: 0,0:07:11.55,0:07:15.10,Default,,0,0,0,,Күн ортасында жалғыз қалдым
Dialogue: 0,0:07:15.18,0:07:18.31,Default,,0,0,0,,Ол қызға не дедіңіз?
Dialogue: 0,0:07:19.73,0:07:21.90,Default,,0,0,0,,Тіпті сізге кенеттен...
Dialogue: 0,0:07:23.52,0:07:27.86,Default,,0,0,0,,«Кешіріңіз, бірақ мен бос емеспін және сіз туралы алаңдауға уақытым жоқ».
Dialogue: 0,0:07:27.94,0:07:32.74,Default,,0,0,0,,«Мен сенің жаныңда сабақ оқып жатырмын, сондықтан жалығығанша жылай аласың».
Dialogue: 0,0:07:32.82,0:07:34.62,Default,,0,0,0,,...Не дедіңіз?
Dialogue: 0,0:07:40.04,0:07:44.42,Default,,0,0,0,,Расымен де, көңілі күйген қызға осылай айтуға болады.
Dialogue: 0,0:07:44.50,0:07:46.17,Default,,0,0,0,,Күндізгі жарық та нашар
Dialogue: 0,0:07:46.25,0:07:48.13,Default,,0,0,0,,(Жан) Эй, Джотаро, сол Какёин жігіт туралы не ойлайсың?
Dialogue: 0,0:07:48.88,0:07:53.22,Default,,0,0,0,,Бірақ менің ойымша, Хакухи сенің сол жағыңды қызықтырды.
Dialogue: 0,0:07:53.30,0:07:54.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:54.93,0:07:57.01,Default,,0,0,0,,Ешкімге сенбей
Dialogue: 0,0:07:57.10,0:08:00.64,Default,,0,0,0,,Бір нәрсені өз бетімен орындауға талпыну көзқарасы.
Dialogue: 0,0:08:01.35,0:08:02.64,Default,,0,0,0,,Сол күннен бастап
Dialogue: 0,0:08:02.73,0:08:06.73,Default,,0,0,0,,Мен сені қуып, күні бойы тынымсыз еңбек еттім.
Dialogue: 0,0:08:07.23,0:08:10.65,Default,,0,0,0,,Мәңгі, Урю, қасыңда болу үшін
Dialogue: 0,0:08:12.24,0:08:14.03,Default,,0,0,0,,Күндізгі жарық...
Dialogue: 0,0:08:19.24,0:08:22.41,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:22.50,0:08:23.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:32.38,0:08:34.05,Default,,0,0,0,,Урю…
Dialogue: 0,0:08:36.93,0:08:38.56,Default,,0,0,0,,Ертерек үшін кешіріңіз.
Dialogue: 0,0:08:39.93,0:08:43.06,Default,,0,0,0,,Мен сенің жаныңда оқи аламын ба?
Dialogue: 0,0:08:44.56,0:08:45.98,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:50.61,0:08:52.90,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:05.96,0:09:08.17,Default,,0,0,0,,Ештеңеге алаңдамаңыз
Dialogue: 0,0:09:08.25,0:09:10.88,Default,,0,0,0,,Өзіңізді тым қатты итермеңіз және емтиханға назарыңызды аударыңыз.
Dialogue: 0,0:09:10.96,0:09:13.67,Default,,0,0,0,,Киото университетінен ұсыныс алуыңыз мүмкін бе?
Dialogue: 0,0:09:13.76,0:09:15.26,Default,,0,0,0,,Хонма, бұл керемет.
Dialogue: 0,0:09:15.34,0:09:16.72,Default,,0,0,0,,Ей!
Dialogue: 0,0:09:16.80,0:09:19.26,Default,,0,0,0,,Эй, эй, біз қызық болып жатырмыз.
Dialogue: 0,0:09:20.51,0:09:23.73,Default,,0,0,0,,Бұл дүниеде ештеңеге алаңдамау керек.
Dialogue: 0,0:09:24.52,0:09:27.48,Default,,0,0,0,,Мен қалаған ештеңе жоқ...
Dialogue: 0,0:09:36.49,0:09:37.82,Default,,0,0,0,,Урю!
Dialogue: 0,0:09:37.91,0:09:38.99,Default,,0,0,0,,Қарсы боласыз ба?
Dialogue: 0,0:09:39.07,0:09:40.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:41.54,0:09:42.79,Default,,0,0,0,,Бір нәрсе үшін бе?
Dialogue: 0,0:09:42.87,0:09:44.58,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:09:44.66,0:09:46.75,Default,,0,0,0,,Менің сусабынмен жуатын қалпағымды алып кете аласыз ба?
Dialogue: 0,0:09:46.83,0:09:48.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.88,0:09:50.92,Default,,0,0,0,,О, рахмет
Dialogue: 0,0:09:51.00,0:09:53.01,Default,,0,0,0,,Урю бізге қосыла ма?
Dialogue: 0,0:09:53.09,0:09:54.38,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:58.01,0:09:59.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:01.18,0:10:02.64,Default,,0,0,0,,Рахмет саған Урю
Dialogue: 0,0:10:03.64,0:10:06.64,Default,,0,0,0,,О, мынау сияқты жақсы.
Dialogue: 0,0:10:06.73,0:10:09.52,Default,,0,0,0,,Сізді көп қиындыққа душар еткенім үшін кешіріңіз?
Dialogue: 0,0:10:17.53,0:10:20.91,Default,,0,0,0,,Анашым, бүгін кешкі асқа не бар?
Dialogue: 0,0:10:20.99,0:10:23.20,Default,,0,0,0,,Үйге келген соң оны асыға күтіңіз.
Dialogue: 0,0:10:25.95,0:10:28.92,Default,,0,0,0,,Олар дұрыс тамақтанып жатыр ма деп ойлаймын...
Dialogue: 0,0:10:29.92,0:10:33.84,Default,,0,0,0,,Ақырында мен үйге қайту үшін ешқандай анықтама таба алмадым ...
Dialogue: 0,0:10:34.55,0:10:37.80,Default,,0,0,0,,Бәлкім осылай қалар...
Dialogue: 0,0:10:39.51,0:10:40.93,Default,,0,0,0,,Ой! (Асахиме) Уау! Уф...
Dialogue: 0,0:10:41.01,0:10:42.43,Default,,0,0,0,,үшінн ескерсек, біз үшеу болып өмір сүруге үйрене бастадық.
Dialogue: 0,0:10:43.72,0:10:44.93,Default,,0,0,0,,Цукуёми-кун мен Каэрубүки-санға қандай сынақтар қойылған?
Dialogue: 0,0:10:46.14,0:10:47.31,Default,,0,0,0,,Асахиме!
Dialogue: 0,0:10:47.39,0:10:49.69,Default,,0,0,0,,Мынау... бұл күндері біртүрлі адам!
Dialogue: 0,0:10:49.77,0:10:52.36,Default,,0,0,0,,Ах... Асахиме
Dialogue: 0,0:10:52.44,0:10:54.82,Default,,0,0,0,,Сәлем! Әй... аңдаушы шығар?
Dialogue: 0,0:10:54.90,0:10:57.57,Default,,0,0,0,,Сіздің аяқтарыңыз ше? Аяқтарың жақсы ма?
Dialogue: 0,0:10:57.65,0:10:58.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:58.90,0:11:01.74,Default,,0,0,0,,Марафоншыларға кешірім сұраймын...
Dialogue: 0,0:11:01.82,0:11:03.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:04.03,0:11:05.45,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:11:08.62,0:11:09.46,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:09.54,0:11:13.09,Default,,0,0,0,,Жоқ... Марафонға қатысатынымызды қайдан білесің?
Dialogue: 0,0:11:13.17,0:11:15.21,Default,,0,0,0,,А, жоқ, мм...
Dialogue: 0,0:11:15.30,0:11:18.22,Default,,0,0,0,,А... менің аяғым жақсы!
Dialogue: 0,0:11:24.51,0:11:28.14,Default,,0,0,0,,Сіз мені есіңе түсірмеген шығарсыз...
Dialogue: 0,0:11:28.64,0:11:29.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:30.10,0:11:32.98,Default,,0,0,0,,Бұл оның...
Dialogue: 0,0:11:37.15,0:11:38.82,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:11:39.44,0:11:43.37,Default,,0,0,0,,Ол бізді қатты уайымдады.
Dialogue: 0,0:11:43.45,0:11:47.58,Default,,0,0,0,,Мен өзімді жаман сезінемін, бірақ мен жаман адам емес шығармын...
Dialogue: 0,0:11:47.66,0:11:50.46,Default,,0,0,0,,Асахиме... Асахиме~!
Dialogue: 0,0:11:50.54,0:11:51.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:51.46,0:11:54.38,Default,,0,0,0,,«Бұл мүлдем керісінше! Менің жайымды қарашы!»
Dialogue: 0,0:11:54.46,0:11:55.54,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:55.63,0:11:57.38,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:11:57.46,0:11:58.88,Default,,0,0,0,,Алдыңғы мәлімдеме кері қайтарылды!
Dialogue: 0,0:11:58.96,0:12:02.51,Default,,0,0,0,,Өйткені, бұл адам жиіркенішті, жаман аңдыушы!
Dialogue: 0,0:12:02.59,0:12:04.97,Default,,0,0,0,,Маған ермеңіз!
Dialogue: 0,0:12:05.05,0:12:09.52,Default,,0,0,0,,Қарғыс атсын... «Ымырт жүгіретін ханшайым» күткендей.
Dialogue: 0,0:12:10.43,0:12:14.15,Default,,0,0,0,,Уау! Йоджу-ни Юна-ни!
Dialogue: 0,0:12:14.23,0:12:15.77,Default,,0,0,0,,Айқай? (Юна) Хмм?
Dialogue: 0,0:12:15.86,0:12:18.15,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,0:12:18.23,0:12:20.65,Default,,0,0,0,,Өтінемін! Әңгімеле... сөйлес...!
Dialogue: 0,0:12:20.74,0:12:23.16,Default,,0,0,0,,Өткен күні әлгі жігіт!
Dialogue: 0,0:12:23.24,0:12:24.53,Default,,0,0,0,,Йоджу? (Йосиге) Иә!
Dialogue: 0,0:12:24.61,0:12:25.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:32.96,0:12:36.42,Default,,0,0,0,,Жоқ, қызды қорқытпа.
Dialogue: 0,0:12:36.50,0:12:38.21,Default,,0,0,0,,Жарайсың, Йошиге!
Dialogue: 0,0:12:38.30,0:12:40.30,Default,,0,0,0,,Мен тым алыс кеттім деп ойлаймын...
Dialogue: 0,0:12:40.38,0:12:41.67,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:12:41.76,0:12:44.68,Default,,0,0,0,,Мен сені дәл қазір тұздап, полицияға беремін.
Dialogue: 0,0:12:44.76,0:12:47.14,Default,,0,0,0,,Әзірше, тұз! Тұз!
Dialogue: 0,0:12:47.64,0:12:49.76,Default,,0,0,0,,Аа, сәл күте тұрыңыз, Ю Чан.
Dialogue: 0,0:12:49.85,0:12:50.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:52.39,0:12:53.98,Default,,0,0,0,,Бұл жол...
Dialogue: 0,0:12:54.06,0:12:54.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:54.98,0:12:56.81,Default,,0,0,0,,А, бұл менікі!
Dialogue: 0,0:12:56.90,0:13:00.65,Default,,0,0,0,,Мына жігіт алып кетті ме?
Dialogue: 0,0:13:00.73,0:13:02.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:02.44,0:13:04.40,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:13:04.49,0:13:07.87,Default,,0,0,0,,Мен сізді қорқынышты аңдыушы деп ойладым...
Dialogue: 0,0:13:07.95,0:13:10.66,Default,,0,0,0,,Жоқ... жоқ, бәрі жақсы.
Dialogue: 0,0:13:10.74,0:13:12.29,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:12.37,0:13:16.21,Default,,0,0,0,,Оны маған жеткізгеніңіз үшін рахмет.
Dialogue: 0,0:13:21.25,0:13:22.67,Default,,0,0,0,,Секір!!
Dialogue: 0,0:13:24.09,0:13:26.05,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:13:26.13,0:13:27.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:27.80,0:13:28.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:36.85,0:13:38.69,Default,,0,0,0,,Ол әлі де қолданыста ма?
Dialogue: 0,0:13:39.31,0:13:42.53,Default,,0,0,0,,Өткенде не болды және бұл жолы не болды
Dialogue: 0,0:13:42.61,0:13:44.95,Default,,0,0,0,,Сізді қорқытқаным үшін кешіріңіз.
Dialogue: 0,0:13:47.95,0:13:51.03,Default,,0,0,0,,Неліктен ол бізді сонша мазалайды?
Dialogue: 0,0:13:51.12,0:13:52.95,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:13:54.45,0:13:57.62,Default,,0,0,0,,Сенбейтін шығарсың, бірақ
Dialogue: 0,0:13:57.71,0:14:00.25,Default,,0,0,0,,Мен Амагами храмындамын, ол мұндағыдан басқаша.
Dialogue: 0,0:14:00.34,0:14:02.38,Default,,0,0,0,,Мен сендермен бірге тұрдым.
Dialogue: 0,0:14:02.46,0:14:03.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:03.96,0:14:07.09,Default,,0,0,0,,Бұл жер мені отбасы ретінде қарсы алды.
Dialogue: 0,0:14:07.18,0:14:08.84,Default,,0,0,0,,Бұл маңызды орын
Dialogue: 0,0:14:08.93,0:14:10.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.72,0:14:15.14,Default,,0,0,0,,Егер сізде қандай да бір қиындық болса, маған да көмектесуге рұқсат етіңіз.
Dialogue: 0,0:14:15.23,0:14:18.90,Default,,0,0,0,,Мен де тамақ жасаймын, жинаймын, кір жуамын.
Dialogue: 0,0:14:18.98,0:14:21.82,Default,,0,0,0,,Ғибадатханада адам күші жетпесе, мен де көмектесемін!
Dialogue: 0,0:14:21.90,0:14:23.15,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:23.23,0:14:27.24,Default,,0,0,0,,Егер адасып қалсаң, мен сені міндетті түрде табамын!
Dialogue: 0,0:14:27.86,0:14:32.08,Default,,0,0,0,,Бір нәрсеге алаңдасаңыз, мен сізді әрқашан қолдаймын!
Dialogue: 0,0:14:32.91,0:14:37.12,Default,,0,0,0,,Не істегіңіз келетінін жасырмаңыз, маған айтыңыз!
Dialogue: 0,0:14:37.87,0:14:41.46,Default,,0,0,0,,Мен ешқашан бұрынғы әлеміме қайта орала алмасам да
Dialogue: 0,0:14:41.54,0:14:45.92,Default,,0,0,0,,Мен... Мен бұл байланысты үзгім келмейді.
Dialogue: 0,0:14:46.01,0:14:48.68,Default,,0,0,0,,Балалар мен сендерге көмектескім келеді!
Dialogue: 0,0:14:53.89,0:14:56.31,Default,,0,0,0,,Жоғалған бала…
Dialogue: 0,0:14:57.06,0:15:01.02,Default,,0,0,0,,Жоқ... мен жай ғана әңгіме тыңдасам, не істеуім керек...
Dialogue: 0,0:15:01.10,0:15:02.94,Default,,0,0,0,,Мм, әрине.
Dialogue: 0,0:15:03.02,0:15:05.69,Default,,0,0,0,,Бұл ғибадатханаға бірдеңе байланған сияқты.
Dialogue: 0,0:15:05.78,0:15:07.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:07.99,0:15:08.82,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:09.61,0:15:12.16,Default,,0,0,0,,Біз отбасы емеспіз
Dialogue: 0,0:15:12.91,0:15:15.58,Default,,0,0,0,,Мен сіздің сезімдеріңізді бағалаймын, бірақ
Dialogue: 0,0:15:15.66,0:15:18.33,Default,,0,0,0,,Басқалардың көмегі қажет емес
Dialogue: 0,0:15:21.58,0:15:25.55,Default,,0,0,0,,Үйге қайтқанда абай болыңыз.
Dialogue: 0,0:15:37.06,0:15:40.85,Default,,0,0,0,,Бұл ... соңы ма?
Dialogue: 0,0:15:42.19,0:15:43.81,Default,,0,0,0,,Біз...
Dialogue: 0,0:15:45.48,0:15:47.65,Default,,0,0,0,,Не байланыстырады...
Dialogue: 0,0:15:48.28,0:15:50.53,Default,,0,0,0,,Тағы да қалды...
Dialogue: 0,0:15:50.61,0:15:52.57,Default,,0,0,0,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,0:15:52.66,0:15:53.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:57.62,0:16:00.91,Default,,0,0,0,,Мен сені бір рет кездестірдім, солай ма?
Dialogue: 0,0:16:01.62,0:16:02.79,Default,,0,0,0,,Йожу...
Dialogue: 0,0:16:04.75,0:16:08.38,Default,,0,0,0,,Мені есіңізде ме?
Dialogue: 0,0:16:11.59,0:16:14.76,Default,,0,0,0,,О, әрине!
Dialogue: 0,0:16:15.26,0:16:16.93,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:16:17.68,0:16:19.89,Default,,0,0,0,,Урю, кеш болды.
Dialogue: 0,0:16:19.97,0:16:22.94,Default,,0,0,0,,Бір нәрсені сатып алуға қанша уақыт кетеді?
Dialogue: 0,0:16:24.77,0:16:26.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:26.52,0:16:29.15,Default,,0,0,0,,Мен сені іздеймін.
Dialogue: 0,0:16:30.40,0:16:32.53,Default,,0,0,0,,Себебі менде бір идея бар
Dialogue: 0,0:16:37.95,0:16:39.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:39.79,0:16:43.29,Default,,0,0,0,,Жас кезіңізде Йошиге көмектестіңіз...
Dialogue: 0,0:16:43.37,0:16:44.92,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:16:45.00,0:16:46.71,Default,,0,0,0,,Камишу-кунға рахмет
Dialogue: 0,0:16:46.79,0:16:50.09,Default,,0,0,0,,Мен осы киелі мекенге келе алдым.
Dialogue: 0,0:16:50.17,0:16:52.30,Default,,0,0,0,,Дұрыс па? Камишу-кун
Dialogue: 0,0:16:52.38,0:16:54.47,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:16:54.55,0:16:57.14,Default,,0,0,0,,Қашықтық тым қысқа емес пе?
Dialogue: 0,0:16:57.22,0:16:59.72,Default,,0,0,0,,Ол кісі дәл қазір допты арқасына лақтырған жоқ па?
Dialogue: 0,0:16:59.81,0:17:02.98,Default,,0,0,0,,Эхехе~ Солай ма?
Dialogue: 0,0:17:03.06,0:17:06.44,Default,,0,0,0,,Бірақ Йосудың өткенінде осындай нәрсе болды...
Dialogue: 0,0:17:06.52,0:17:08.73,Default,,0,0,0,,Сендер де, солай ма? (Юна/Асахиме) Иә?
Dialogue: 0,0:17:08.82,0:17:11.32,Default,,0,0,0,,Үшеуі де қандас туыс емес.
Dialogue: 0,0:17:11.40,0:17:14.82,Default,,0,0,0,,Кейбір жағдайларға байланысты мені осы киелі орынға қабылдады.
Dialogue: 0,0:17:14.90,0:17:15.99,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:17:16.07,0:17:19.12,Default,,0,0,0,,Сіз аңдыу үшін тым көп нәрсені білесіз.
Dialogue: 0,0:17:19.20,0:17:21.37,Default,,0,0,0,,Олай болса, Камишу мырза шынымен
Dialogue: 0,0:17:21.45,0:17:25.50,Default,,0,0,0,,Сонда сіз бізбен басқа әлемде өмір сүрдіңіз бе?
Dialogue: 0,0:17:25.58,0:17:27.92,Default,,0,0,0,,Қасиетті қыз күткендей.
Dialogue: 0,0:17:28.00,0:17:29.88,Default,,0,0,0,,Тез жұтыну көмектеседі
Dialogue: 0,0:17:30.59,0:17:32.63,Default,,0,0,0,,Мен жағдайды түсінемін, бірақ
Dialogue: 0,0:17:32.71,0:17:34.84,Default,,0,0,0,,Енді не істеуді жоспарлап отырсыз?
Dialogue: 0,0:17:34.92,0:17:35.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:35.84,0:17:39.76,Default,,0,0,0,,Бұрын мен «Мен сенің маған сенгеніңді қалаймын!» деген сияқты сөздерді айттым.
Dialogue: 0,0:17:39.85,0:17:42.27,Default,,0,0,0,,Сіз нарциссисттік бірдеңе айттыңыз...
Dialogue: 0,0:17:42.35,0:17:47.60,Default,,0,0,0,,Біз тамақ пісіруге, тазалауға және кір жууға өте қабілеттіміз.
Dialogue: 0,0:17:47.69,0:17:51.11,Default,,0,0,0,,Шынымды айтсам, сенің көрінуіңе ешқандай мүмкіндік жоқ деп ойлаймын.
Dialogue: 0,0:17:51.19,0:17:52.73,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:55.32,0:17:58.49,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл тамаша шалғам тазартқыш
Dialogue: 0,0:17:58.57,0:18:00.49,Default,,0,0,0,,Бұл 30 минутқа созылды!
Dialogue: 0,0:18:00.58,0:18:03.70,Default,,0,0,0,,Маған пышақ беріңізші.
Dialogue: 0,0:18:03.79,0:18:05.87,Default,,0,0,0,,Маған сенің көмегің керек болмаса да...
Dialogue: 0,0:18:05.96,0:18:08.12,Default,,0,0,0,,Сіз тым көп жүкті өзіңіз көтеріп жүрсіз.
Dialogue: 0,0:18:08.21,0:18:11.88,Default,,0,0,0,,Мен өзімшіл болып, басқаларға арқа сүйеген дұрыс деп ойлаймын.
Dialogue: 0,0:18:19.47,0:18:20.30,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:20.39,0:18:23.31,Default,,0,0,0,,Құпия техника! Бейнеден көрген бүктеу техникасы Иә!
Dialogue: 0,0:18:23.39,0:18:25.02,Default,,0,0,0,,А? Оны мүлде бүгу мүмкін емес!
Dialogue: 0,0:18:25.10,0:18:26.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:26.27,0:18:28.60,Default,,0,0,0,,Сіз шынымен ебедейсіз.
Dialogue: 0,0:18:28.69,0:18:30.61,Default,,0,0,0,,Бойың осылай өседі
Dialogue: 0,0:18:30.69,0:18:32.15,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:18:33.15,0:18:34.90,Default,,0,0,0,,Баяу қабылдауға болмайды
Dialogue: 0,0:18:34.98,0:18:37.40,Default,,0,0,0,,Егер сіз мұны өз қарқыныңызбен жасасаңыз, сіз оны міндетті түрде жасай аласыз.
Dialogue: 0,0:18:38.74,0:18:40.11,Default,,0,0,0,,Иә
Dialogue: 0,0:18:41.78,0:18:43.62,Default,,0,0,0,,Бұл жерде бәрібір...
Dialogue: 0,0:18:43.70,0:18:47.29,Default,,0,0,0,,Иә? Қазір өте әдемі
Dialogue: 0,0:18:47.37,0:18:49.62,Default,,0,0,0,,Сіздің стандарттарыңыз қандай?
Dialogue: 0,0:18:50.29,0:18:52.92,Default,,0,0,0,,Мұқият тазаласаң, жақсылықтар болады.
Dialogue: 0,0:18:53.00,0:18:55.51,Default,,0,0,0,,Иә? Бұл рас па?
Dialogue: 0,0:18:56.05,0:18:56.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:56.97,0:19:00.26,Default,,0,0,0,,Мен мұны жоғалтып алдым деп ойладым!
Dialogue: 0,0:19:00.34,0:19:02.64,Default,,0,0,0,,Оны тапқаныңызға қуаныштымын.
Dialogue: 0,0:19:04.22,0:19:05.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:06.22,0:19:08.56,Default,,0,0,0,,Сондықтан тазалауды асықпаңыз.
Dialogue: 0,0:19:08.64,0:19:09.98,Default,,0,0,0,,Иә
Dialogue: 0,0:19:14.61,0:19:16.44,Default,,0,0,0,,Қалай... қалай?
Dialogue: 0,0:19:16.53,0:19:19.07,Default,,0,0,0,,Енді менің жай сөйлеп тұрғанымды түсіндіңіз бе?
Dialogue: 0,0:19:19.15,0:19:19.99,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:20.78,0:19:25.66,Default,,0,0,0,,Менің ойымша, бұл қасиетті орын үшін пайдалы.
Dialogue: 0,0:19:25.74,0:19:28.50,Default,,0,0,0,,Сондықтан мен қасиетті орындарға баруды жалғастырамын ...
Dialogue: 0,0:19:28.58,0:19:30.42,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:30.50,0:19:34.34,Default,,0,0,0,,Камишу-кун осында болса, мен аман қалуым мүмкін екені рас.
Dialogue: 0,0:19:34.42,0:19:37.21,Default,,0,0,0,,Ол маған соншалықты құмарлықпен қарайды.
Dialogue: 0,0:19:37.30,0:19:39.67,Default,,0,0,0,,Шынында да, сіздің шынайылығыңыз айтылды.
Dialogue: 0,0:19:39.76,0:19:40.59,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:19:40.68,0:19:42.01,Default,,0,0,0,,Бірақ (Урю) А...
Dialogue: 0,0:19:42.64,0:19:47.31,Default,,0,0,0,,Өйткені, бұл сіз үшін жақсы жер емес.
Dialogue: 0,0:19:50.06,0:19:52.27,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:19:54.86,0:19:56.52,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:56.61,0:20:01.53,Default,,0,0,0,,Сіз өзіңіздің бастапқы әлеміңізге оралуыңыз үшін ынтымақтасайық.
Dialogue: 0,0:20:01.61,0:20:03.91,Default,,0,0,0,,Не, бастапқы дүние?
Dialogue: 0,0:20:04.87,0:20:07.12,Default,,0,0,0,,Сіз көмектесуіңіз керек
Dialogue: 0,0:20:07.20,0:20:09.87,Default,,0,0,0,,Бұл сіздің әлеміңізде бізбіз.
Dialogue: 0,0:20:11.71,0:20:16.25,Default,,0,0,0,,Менің ойымша, бұл сен үшін ең жақсысы, Камизу.
Dialogue: 0,0:20:16.34,0:20:18.25,Default,,0,0,0,,Бағалы жіп үшін алғыс ретінде
Dialogue: 0,0:20:18.34,0:20:21.51,Default,,0,0,0,,Біз сізге де көмектесеміз.
Dialogue: 0,0:20:22.26,0:20:25.26,Default,,0,0,0,,Бірақ үйге қалай жетуге болады?
Dialogue: 0,0:20:25.35,0:20:27.60,Default,,0,0,0,,Атамен сөйлескіңіз келе ме?
Dialogue: 0,0:20:27.68,0:20:31.31,Default,,0,0,0,,Егер сізді жүк көлігі қағып кетсе, мүмкін басқа әлемге кете аласыз ба?
Dialogue: 0,0:20:31.39,0:20:33.39,Default,,0,0,0,,Бұл аспанға бармайды ма?
Dialogue: 0,0:20:33.48,0:20:36.27,Default,,0,0,0,,Ал, онда мен не істеуім керек?
Dialogue: 0,0:20:36.36,0:20:39.32,Default,,0,0,0,,Жүк көлігі қағып кетуден басқа...
Dialogue: 0,0:20:39.40,0:20:41.28,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,0:20:42.32,0:20:46.03,Default,,0,0,0,,Шынымен, мен үшеуіңді де жақсы көремін!
Dialogue: 0,0:20:46.12,0:20:48.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:48.12,0:20:49.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:49.62,0:20:51.04,Default,,0,0,0,,На на на...
Dialogue: 0,0:20:51.12,0:20:52.54,Default,,0,0,0,,А, а... махаббат?
Dialogue: 0,0:20:52.62,0:20:55.50,Default,,0,0,0,,Кішкене мейірбан екенсің деп алданып қалма!
Dialogue: 0,0:20:55.58,0:20:58.09,Default,,0,0,0,,Сіз басқа әлемнен келген, араласатын нарциссистсіз!
Dialogue: 0,0:20:58.17,0:21:01.55,Default,,0,0,0,,Өте жаман... Тұз қолданбаңыз! Тұз!
Dialogue: 0,0:21:01.63,0:21:03.30,Default,,0,0,0,,А, өте тұзды!
Dialogue: 0,0:21:06.22,0:21:08.93,Default,,0,0,0,,Балалар бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:21:09.01,0:21:12.18,Default,,0,0,0,,Егер мен жалғыз болсам, мен әлі де ештеңе істей алмайтын болар едім.
Dialogue: 0,0:21:12.27,0:21:15.81,Default,,0,0,0,,Уайымдамаңыз, бұл сіз мінген қайық.
Dialogue: 0,0:21:15.90,0:21:17.19,Default,,0,0,0,,Мен сенімен соңына дейін боламын
Dialogue: 0,0:21:17.27,0:21:19.94,Default,,0,0,0,,Кез келген уақытта қайта қош келдіңіз.
Dialogue: 0,0:21:20.02,0:21:22.82,Default,,0,0,0,,Иә, келіңіз.
Dialogue: 0,0:21:23.82,0:21:25.32,Default,,0,0,0,,Секір!!
Dialogue: 0,0:21:31.16,0:21:32.54,Default,,0,0,0,,Ши... күн!
Dialogue: 0,0:21:32.62,0:21:36.29,Default,,0,0,0,,Қалай... неге! Оның үстіне дымқыл болып жатыр, солай емес пе?
Dialogue: 0,0:21:36.37,0:21:38.42,Default,,0,0,0,,Жоқ... қайсысы?
Dialogue: 0,0:21:38.50,0:21:40.42,Default,,0,0,0,,Сіз Камизуды білесіз бе?
Dialogue: 0,0:21:40.50,0:21:42.17,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:21:46.93,0:21:49.18,Default,,0,0,0,,Ши... күндізгі жарық?
Dialogue: 0,0:21:54.68,0:21:57.44,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:21:58.73,0:22:02.82,Default,,0,0,0,,Менің жігітім мені мазалады.
Dialogue: 0,0:22:04.03,0:22:09.28,Default,,0,0,0,,♪～
Dialogue: 0,0:23:29.99,0:23:33.95,Default,,0,0,0,,～♪
