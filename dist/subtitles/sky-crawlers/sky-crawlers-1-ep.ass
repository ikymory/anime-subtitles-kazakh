Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:52.63,0:00:58.30,Default,,0,0,0,,(ұшқыштың ауыр тыныс алуы)
Dialogue: 0,0:01:05.73,0:01:09.56,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:01:16.78,0:01:19.07,Default,,0,0,0,,(қозғалтқыштың ату дыбысы)
Dialogue: 0,0:01:42.43,0:01:45.06,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:01:59.32,0:02:01.95,Default,,0,0,0,,(Ұшқыштың айқайы)
Dialogue: 0,0:02:06.62,0:02:08.46,Default,,0,0,0,,(Тоқсыған дыбыс)
Dialogue: 0,0:02:39.53,0:02:43.53,Default,,0,0,0,,♪~
Dialogue: 0,0:04:41.57,0:04:46.11,Default,,0,0,0,,(Ұшақтың ұшу дыбысы)
Dialogue: 0,0:05:00.55,0:05:04.59,Default,,0,0,0,,~♪
Dialogue: 0,0:05:04.72,0:05:08.47,Default,,0,0,0,,(Иттің тынысы)
Dialogue: 0,0:05:11.68,0:05:14.68,Default,,0,0,0,,(Соғыс ұшағы қозғалтқышының дыбысы)
Dialogue: 0,0:05:19.27,0:05:21.98,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:05:26.24,0:05:27.78,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:05:44.30,0:05:45.84,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:46.47,0:05:47.88,Default,,0,0,0,,) Ал сіз ше?
Dialogue: 0,0:05:47.97,0:05:49.97,Default,,0,0,0,,Сасакура, мұндағы механик
Dialogue: 0,0:05:50.55,0:05:53.35,Default,,0,0,0,,Менің атым Юичи Каннами. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:05:56.27,0:05:58.64,Default,,0,0,0,,Механизатор әйелмен бірінші рет кездесіп тұрсыз ба?
Dialogue: 0,0:05:59.10,0:06:02.11,Default,,0,0,0,,Жоқ, бұрын бір жерде.
Dialogue: 0,0:06:02.82,0:06:04.61,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:06:07.99,0:06:10.32,Default,,0,0,0,,Міне, сізді тасымалдайтын ұшақ.
Dialogue: 0,0:06:13.28,0:06:14.70,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:06:14.91,0:06:17.50,Default,,0,0,0,,Ұшақты жинауға мердігер келеді.
Dialogue: 0,0:06:17.91,0:06:21.00,Default,,0,0,0,,Дәл солай емес пе? Мүмкін болса өзгерткім келмейді.
Dialogue: 0,0:06:21.21,0:06:23.13,Default,,0,0,0,,Сіз оны мінгеннен кейін түсінесіз
Dialogue: 0,0:06:23.38,0:06:25.92,Default,,0,0,0,,Ал бұл жерде бастықтың бұйрығы.
Dialogue: 0,0:06:26.17,0:06:28.13,Default,,0,0,0,,Бұл ұшақтың ізашары кім болды?
Dialogue: 0,0:06:28.26,0:06:29.43,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:29.76,0:06:32.43,Default,,0,0,0,,Беру сияқты көп нәрсе бар.
Dialogue: 0,0:06:33.64,0:06:35.89,Default,,0,0,0,,Содан кейін бастығыңыздан сұраңыз.
Dialogue: 0,0:06:51.53,0:06:52.74,Default,,0,0,0,,(сіріңкені соққан дыбыс)
Dialogue: 0,0:06:53.91,0:06:54.87,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:54.99,0:06:56.12,Default,,0,0,0,,(сіріңкені бұзу дыбысы)
Dialogue: 0,0:07:00.33,0:07:01.67,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:07:02.29,0:07:05.55,Default,,0,0,0,,(терезені тырнау дыбысы)
Dialogue: 0,0:07:32.11,0:07:33.41,Default,,0,0,0,,Уф, ыстық қой! Демім тарылып барады!
Dialogue: 0,0:07:33.70,0:07:34.62,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:34.70,0:07:37.70,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:07:41.96,0:07:43.21,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:07:47.17,0:07:50.17,Default,,0,0,0,,Менің атым Юичи Каннами, мен бүгін тағайындалдым.
Dialogue: 0,0:07:50.30,0:07:51.88,Default,,0,0,0,,Бұл сутегі Құсанаги.
Dialogue: 0,0:07:52.01,0:07:55.26,Default,,0,0,0,,Ерте болды, кеш болды деп ойладым.
Dialogue: 0,0:07:57.76,0:08:00.48,Default,,0,0,0,,Өйткені күн тым ашық болды
Dialogue: 0,0:08:00.60,0:08:02.77,Default,,0,0,0,,А... Камю?
Dialogue: 0,0:08:03.94,0:08:08.27,Default,,0,0,0,,204 бөлмеде Токино деген адам бар.
Dialogue: 0,0:08:08.40,0:08:10.82,Default,,0,0,0,,Мен онымен ертең түстен кейін ұшамын.
Dialogue: 0,0:08:10.94,0:08:13.20,Default,,0,0,0,,Мм... (телефон қоңырауы)
Dialogue: 0,0:08:13.32,0:08:14.53,Default,,0,0,0,,Нашар
Dialogue: 0,0:08:16.24,0:08:17.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:22.21,0:08:26.63,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:09:13.63,0:09:17.26,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:09:18.01,0:09:22.52,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:09:28.85,0:09:33.11,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:09:57.38,0:09:59.39,Default,,0,0,0,,(Қағаздың үйкелу дыбысы)
Dialogue: 0,0:09:59.55,0:10:02.43,Default,,0,0,0,,(Юичидің ізі)
Dialogue: 0,0:10:53.15,0:10:55.36,Default,,0,0,0,,Бұл бүгін тағайындалған Каннами.
Dialogue: 0,0:10:55.69,0:10:57.65,Default,,0,0,0,,Мен Ютагавамын
Dialogue: 0,0:10:58.49,0:11:01.28,Default,,0,0,0,,Бұл жігіт Косецу Шинода
Dialogue: 0,0:11:03.12,0:11:05.33,Default,,0,0,0,,Мұнда қанша ұшқыш бар?
Dialogue: 0,0:11:05.45,0:11:08.37,Default,,0,0,0,,Бұл күнде үш адам бар шығар.
Dialogue: 0,0:11:08.50,0:11:10.46,Default,,0,0,0,,Бұған сіз және ол кіреді ме?
Dialogue: 0,0:11:10.58,0:11:13.33,Default,,0,0,0,,Бүгіннен бастап отакуды қосқанда төртеуі боламыз.
Dialogue: 0,0:11:13.46,0:11:14.50,Default,,0,0,0,,Тек 4 адам?
Dialogue: 0,0:11:14.63,0:11:16.13,Default,,0,0,0,,Иә, тек
Dialogue: 0,0:11:16.25,0:11:20.30,Default,,0,0,0,,Құсанағы сұлу мырзаны қосқанда 5 адам ұша алады.
Dialogue: 0,0:11:20.38,0:11:23.43,Default,,0,0,0,,Ол да ұшады ма? (терезені қағу дыбысы)
Dialogue: 0,0:11:23.55,0:11:25.43,Default,,0,0,0,,Таңертең үйге қайта барасың ба?
Dialogue: 0,0:11:36.02,0:11:37.40,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:37.61,0:11:40.40,Default,,0,0,0,,Каннами маған бүгін тағайындалды.
Dialogue: 0,0:11:40.78,0:11:44.62,Default,,0,0,0,,А... бұл сенсің, иә?
Dialogue: 0,0:11:47.28,0:11:48.99,Default,,0,0,0,,Токино бір бөлмеде
Dialogue: 0,0:11:49.12,0:11:51.71,Default,,0,0,0,,Мен білемін, бөлмені көрдім.
Dialogue: 0,0:11:51.83,0:11:54.38,Default,,0,0,0,,Ертең бірге ұшсақ ше?
Dialogue: 0,0:11:54.50,0:11:55.67,Default,,0,0,0,,Бұл да
Dialogue: 0,0:11:56.88,0:11:58.71,Default,,0,0,0,,Олай болса, танысқаныма қуаныштымын.
Dialogue: 0,0:12:03.22,0:12:06.14,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:12:10.06,0:12:12.06,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:12:54.81,0:12:56.31,Default,,0,0,0,,(судың шашырауы)
Dialogue: 0,0:12:56.52,0:12:57.35,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:13.00,0:13:14.29,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:14:09.64,0:14:11.26,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:14:20.48,0:14:24.36,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:14:54.35,0:14:56.02,Default,,0,0,0,,(суға құлау дыбысы)
Dialogue: 0,0:14:58.06,0:15:01.23,Default,,0,0,0,,(судағы дыбыс)
Dialogue: 0,0:15:43.27,0:15:46.36,Default,,0,0,0,,Хаха-оу!
Dialogue: 0,0:15:58.79,0:16:01.79,Default,,0,0,0,,(Ұшақтың ұшу дыбысы)
Dialogue: 0,0:16:04.42,0:16:06.46,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:16:51.92,0:16:53.01,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:16:53.17,0:16:54.30,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:16:55.34,0:16:58.80,Default,,0,0,0,,Сәлем! Хахаха...
Dialogue: 0,0:17:00.14,0:17:01.56,Default,,0,0,0,,Мұндағы зиян ше?
Dialogue: 0,0:17:01.68,0:17:02.68,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:17:03.18,0:17:05.19,Default,,0,0,0,,Лотерннің сынақ сызығы дегеніміз не?
Dialogue: 0,0:17:05.48,0:17:07.65,Default,,0,0,0,,Тоқтаған және қозғалыссыз
Dialogue: 0,0:17:08.19,0:17:10.19,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:17:10.32,0:17:11.36,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:13.99,0:17:16.57,Default,,0,0,0,,Мм... саған бір сұрақ қойсам болады ма?
Dialogue: 0,0:17:18.62,0:17:21.66,Default,,0,0,0,,Мен сол ұшақта менен бұрын болған адам туралы айтып отырмын.
Dialogue: 0,0:17:26.37,0:17:30.42,Default,,0,0,0,,Джиро Курита Мен осында жеті ай бұрын тағайындалдым.
Dialogue: 0,0:17:30.79,0:17:34.88,Default,,0,0,0,,63 сұрыптау, өте жақсы шеберлік
Dialogue: 0,0:17:35.30,0:17:36.80,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:17:37.38,0:17:39.51,Default,,0,0,0,,Мен бұл сұраққа жауап бере алмаймын.
Dialogue: 0,0:17:39.80,0:17:41.43,Default,,0,0,0,,Неліктен көшіп кеттің?
Dialogue: 0,0:17:41.81,0:17:43.27,Default,,0,0,0,,(Фушигиро) Түпкі Дала жабылды! Арнайы сынып жойылды.
Dialogue: 0,0:17:43.39,0:17:44.56,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:17:44.85,0:17:48.23,Default,,0,0,0,,Олай болса да, бұл сіздің жағдайыңызға ешқандай әсер етпейді.
Dialogue: 0,0:17:48.48,0:17:52.98,Default,,0,0,0,,Болмыстың немесе болмыстың екі ғана күйі бар.
Dialogue: 0,0:17:53.15,0:17:54.82,Default,,0,0,0,,Ұшақты қабылдау кезінде
Dialogue: 0,0:17:54.90,0:17:57.99,Default,,0,0,0,,Әдетте сіз бұрынғы басқарушыға хабарласатын едіңіз, солай ма?
Dialogue: 0,0:17:58.24,0:18:01.49,Default,,0,0,0,,Әрине, егер сенің алдындағы адамың тірі болса ғана.
Dialogue: 0,0:18:01.91,0:18:03.91,Default,,0,0,0,,Бұл ұшақ әлі жаңа.
Dialogue: 0,0:18:04.16,0:18:06.50,Default,,0,0,0,,Мен мұны қажет емес деп шештім.
Dialogue: 0,0:18:06.66,0:18:08.08,Default,,0,0,0,,Шағымдар бар ма?
Dialogue: 0,0:18:08.25,0:18:10.33,Default,,0,0,0,,Жоқ, бұл ең жақсы ұшақ болды.
Dialogue: 0,0:18:10.46,0:18:11.75,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:18:12.84,0:18:15.21,Default,,0,0,0,,Сіз Кильдресіз бе?
Dialogue: 0,0:18:17.13,0:18:19.13,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:18:23.97,0:18:25.39,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:18:26.14,0:18:27.39,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:18:27.94,0:18:29.98,Default,,0,0,0,,Сіз де темекі шегесіз, солай ма?
Dialogue: 0,0:18:31.77,0:18:34.94,Default,,0,0,0,,Мен темекі шекпейтін бастығыма сенбеуді таңдаймын.
Dialogue: 0,0:18:36.82,0:18:38.61,Default,,0,0,0,,Ненің негізінде?
Dialogue: 0,0:18:38.74,0:18:41.53,Default,,0,0,0,,Әйтеуір осы уақытқа дейінгі тәжірибемнің негізінде
Dialogue: 0,0:18:42.12,0:18:44.16,Default,,0,0,0,,Тәжірибе? Ха...
Dialogue: 0,0:18:44.49,0:18:45.79,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:18:45.91,0:18:47.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:50.50,0:18:54.50,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:19:10.94,0:19:14.15,Default,,0,0,0,,Қысқа уақыт ішінде екі ұшақты қалай құлаттың?
Dialogue: 0,0:19:15.36,0:19:16.36,Default,,0,0,0,,Жағымпаздық?
Dialogue: 0,0:19:16.48,0:19:18.53,Default,,0,0,0,,Ха, мен ондай нәрсеге жақсы емеспін.
Dialogue: 0,0:19:18.65,0:19:20.99,Default,,0,0,0,,Жаңа ғана басқа адам бастаушы болды.
Dialogue: 0,0:19:21.24,0:19:22.28,Default,,0,0,0,,Кішіпейілділік?
Dialogue: 0,0:19:22.41,0:19:23.49,Default,,0,0,0,,Иә
Dialogue: 0,0:19:23.62,0:19:25.41,Default,,0,0,0,,Бұрын қайда болдың?
Dialogue: 0,0:19:25.74,0:19:28.29,Default,,0,0,0,,Енді мен ұмытып қалдым.
Dialogue: 0,0:19:31.00,0:19:32.67,Default,,0,0,0,,Бүгін кешке шыққыңыз келе ме?
Dialogue: 0,0:19:32.79,0:19:33.63,Default,,0,0,0,,Қайда?
Dialogue: 0,0:19:33.75,0:19:36.04,Default,,0,0,0,,Сізге айналаңызды көрсету үшін...
Dialogue: 0,0:19:37.42,0:19:38.80,Default,,0,0,0,,Ах~
Dialogue: 0,0:19:38.92,0:19:41.63,Default,,0,0,0,,Басқаша айтқанда, бұл менің рөлім.
Dialogue: 0,0:19:44.68,0:19:47.10,Default,,0,0,0,,(Мотоциклдің жүгіру дыбысы)
Dialogue: 0,0:20:00.90,0:20:01.99,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:20:02.45,0:20:04.24,Default,,0,0,0,,Еттен жасалған бәліш дәмді.
Dialogue: 0,0:20:06.16,0:20:07.95,Default,,0,0,0,,Сіздің қарныңыз ашты, солай ма?
Dialogue: 0,0:20:25.18,0:20:28.18,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:20:28.31,0:20:32.10,Default,,0,0,0,,♪~ (бейбіт фортепиано пьесасы)
Dialogue: 0,0:21:02.26,0:21:05.22,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:07.93,0:21:10.26,Default,,0,0,0,,Бұл күндері біз бір жақтамыз.
Dialogue: 0,0:21:10.39,0:21:13.27,Default,,0,0,0,,Мүмкін Лотерн жақын арада қайта оралады.
Dialogue: 0,0:21:13.48,0:21:15.81,Default,,0,0,0,,Бұл жаңалық сендер туралы, солай ма?
Dialogue: 0,0:21:15.94,0:21:16.90,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:21:19.77,0:21:22.90,Default,,0,0,0,,О, менде сыра бар, мына жігітке ет пирогы...
Dialogue: 0,0:21:23.03,0:21:24.19,Default,,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:21:25.20,0:21:26.86,Default,,0,0,0,,Бұл мен сізге апаратын дүкен ме?
Dialogue: 0,0:21:26.99,0:21:28.99,Default,,0,0,0,,Бұл 1-тармақ.
Dialogue: 0,0:21:29.12,0:21:32.33,Default,,0,0,0,,Заттардың реті бар... Ах (есіктің ашылып жабылған дыбысы)
Dialogue: 0,0:21:42.67,0:21:44.46,Default,,0,0,0,,Ах~ хаха
Dialogue: 0,0:21:44.59,0:21:47.09,Default,,0,0,0,,Мен сіздерге өзімнің алдыңғы ағам туралы айтайын деп ойладым.
Dialogue: 0,0:21:54.43,0:21:57.77,Default,,0,0,0,,А... Анам маған жалт қарады.
Dialogue: 0,0:21:58.19,0:21:59.44,Default,,0,0,0,,Ана?
Dialogue: 0,0:22:00.81,0:22:03.44,Default,,0,0,0,,Ол біздің ұшаққа қамқорлық жасайды.
Dialogue: 0,0:22:03.57,0:22:05.28,Default,,0,0,0,,Сондықтан ана
Dialogue: 0,0:22:06.53,0:22:08.20,Default,,0,0,0,,2-тармақ келді.
Dialogue: 0,0:22:08.32,0:22:10.70,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:22:13.08,0:22:14.91,Default,,0,0,0,,Сәлем Наофуми
Dialogue: 0,0:22:15.25,0:22:17.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:22:21.00,0:22:24.50,Default,,0,0,0,,Бұл жаңа жігіт Юити Каннами.
Dialogue: 0,0:22:24.63,0:22:26.97,Default,,0,0,0,,Мен Кусумимін, танысқаныма қуаныштымын.
Dialogue: 0,0:22:29.80,0:22:31.05,Default,,0,0,0,,Фуко
Dialogue: 0,0:22:36.39,0:22:37.64,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:22:49.15,0:22:50.36,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:22:50.49,0:22:51.45,Default,,0,0,0,,Не?
Dialogue: 0,0:22:51.57,0:22:52.74,Default,,0,0,0,,Еттен жасалған бәліш
Dialogue: 0,0:22:52.87,0:22:54.12,Default,,0,0,0,,Шайқас басталды. Енді екеумізге де кері жол жоқ.
Dialogue: 0,0:22:54.41,0:22:56.79,Default,,0,0,0,,Дәмі бұрын жеп қойғандай болды.
Dialogue: 0,0:22:56.91,0:23:00.54,Default,,0,0,0,,(Кусуми мен Токиноның күлкісі)
Dialogue: 0,0:23:34.87,0:23:38.37,Default,,0,0,0,,Ендеше бәрі жақсы хехехе...
Dialogue: 0,0:23:45.71,0:23:47.46,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:23:53.43,0:23:56.30,Default,,0,0,0,,Сіз мұнда баяғыда келдіңіз, солай емес пе?
Dialogue: 0,0:23:56.60,0:23:57.85,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:23:57.97,0:23:59.85,Default,,0,0,0,,Бай Юйчи
Dialogue: 0,0:23:59.98,0:24:01.35,Default,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:24:01.48,0:24:03.40,Default,,0,0,0,,Сутегі мырза ше?
Dialogue: 0,0:24:04.02,0:24:06.86,Default,,0,0,0,,Бұл қорқынышты жас ханым қалай?
Dialogue: 0,0:24:07.40,0:24:11.32,Default,,0,0,0,,(Әйелдердің күлкісі)
Dialogue: 0,0:24:11.86,0:24:12.78,Default,,0,0,0,,Кеттік
Dialogue: 0,0:24:12.90,0:24:15.03,Default,,0,0,0,,Танысқаныма қуаныштымын (әйел) Сау болыңыз
Dialogue: 0,0:24:40.60,0:24:41.93,Default,,0,0,0,,(сіріңкені соққан дыбыс)
Dialogue: 0,0:24:42.06,0:24:43.14,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:24:43.94,0:24:49.02,Default,,0,0,0,,Сенің келгенің Джироның өлгенін білдіреді.
Dialogue: 0,0:24:49.19,0:24:53.53,Default,,0,0,0,,Енді... Джинроның кім екенін білмеймін.
Dialogue: 0,0:24:55.24,0:24:56.70,Default,,0,0,0,,Бірдеңе ішуді қалайсыз ба?
Dialogue: 0,0:24:57.32,0:24:59.28,Default,,0,0,0,,Мүмкін болса, мен кофе алғым келеді.
Dialogue: 0,0:25:01.24,0:25:05.12,Default,,0,0,0,,Ол қандай адам болды? Ол Джиро есімді адам
Dialogue: 0,0:25:06.37,0:25:07.92,Default,,0,0,0,,Сіз мейірімді едіңіз.
Dialogue: 0,0:25:08.04,0:25:11.67,Default,,0,0,0,,Тәтті жүзбен, өзіңдікіндей жұмсақ күлкімен
Dialogue: 0,0:25:12.76,0:25:16.09,Default,,0,0,0,,Бірақ мен өзімді бір нәрсеге кептеліп қалғандай сезінемін...
Dialogue: 0,0:25:17.01,0:25:19.18,Default,,0,0,0,,Мен оны көргенде қобалжыдым.
Dialogue: 0,0:25:20.64,0:25:22.27,Default,,0,0,0,,Сіз бұл туралы естідіңіз бе?
Dialogue: 0,0:25:22.64,0:25:26.31,Default,,0,0,0,,«Сіз әрқашан жүрегіңізді қайда қалдырасыз?»
Dialogue: 0,0:25:27.77,0:25:29.61,Default,,0,0,0,,Ол қандай?
Dialogue: 0,0:25:29.77,0:25:31.32,Default,,0,0,0,,Жауап бермеді
Dialogue: 0,0:25:31.65,0:25:34.49,Default,,0,0,0,,Бірақ мен бос қалдым ба деп ойлаймын
Dialogue: 0,0:25:34.99,0:25:38.74,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:25:40.41,0:25:42.74,Default,,0,0,0,,Сіз мұнда қанша уақыт болдыңыз?
Dialogue: 0,0:25:42.87,0:25:46.04,Default,,0,0,0,,«Сіз» мені білдіреді ме?
Dialogue: 0,0:25:46.16,0:25:48.17,Default,,0,0,0,,Хехе, бұл біртүрлі.
Dialogue: 0,0:25:49.00,0:25:51.29,Default,,0,0,0,,Мұнда тек сен екеуміз ғана бармыз
Dialogue: 0,0:25:51.42,0:25:54.09,Default,,0,0,0,,«Мен» де бала сияқтымын
Dialogue: 0,0:25:56.30,0:25:58.22,Default,,0,0,0,,Мен баламын
Dialogue: 0,0:26:04.02,0:26:06.60,Default,,0,0,0,,Эй, саған ұшу ұнай ма?
Dialogue: 0,0:26:06.73,0:26:08.60,Default,,0,0,0,,Иә, маған ұнайды.
Dialogue: 0,0:26:08.73,0:26:10.02,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:26:14.15,0:26:15.53,Default,,0,0,0,,Тағы келесің бе?
Dialogue: 0,0:26:15.65,0:26:16.49,Default,,0,0,0,,Иә
Dialogue: 0,0:26:19.99,0:26:21.37,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:26:22.58,0:26:24.70,Default,,0,0,0,,(Скутердің жүгіру дыбысы)
Dialogue: 0,0:27:07.50,0:27:08.91,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:27:09.54,0:27:10.87,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:27:12.08,0:27:14.54,Default,,0,0,0,,Әйтеуір денемді жақсы сезінеді
Dialogue: 0,0:27:15.05,0:27:16.63,Default,,0,0,0,,Мен ешқандай ыңғайсыздықты сезінбеймін.
Dialogue: 0,0:27:19.17,0:27:22.68,Default,,0,0,0,,Дұрыс, менің қолым мінсіз.
Dialogue: 0,0:27:24.22,0:27:27.77,Default,,0,0,0,,Бұған дейін мінген адамның аты Джиро болатын, солай ма?
Dialogue: 0,0:27:27.97,0:27:29.14,Default,,0,0,0,,Қалай өлдің?
Dialogue: 0,0:27:30.98,0:27:34.77,Default,,0,0,0,,Егер ұшақ әлі де болса, бұл оның атып түсірілгенін білдірмейді ме?
Dialogue: 0,0:27:35.44,0:27:38.40,Default,,0,0,0,,(иттің қорылдауы)
Dialogue: 0,0:27:40.49,0:27:42.11,Default,,0,0,0,,Қайтып ертерек ұйықтаңыз.
Dialogue: 0,0:28:47.93,0:28:54.06,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:29:07.16,0:29:11.83,Default,,0,0,0,,(Ұшақтың ұшу дыбысы)
Dialogue: 0,0:29:24.80,0:29:26.13,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:29:29.30,0:29:31.43,Default,,0,0,0,,(Пропеллердің айналу дыбысы)
Dialogue: 0,0:29:47.86,0:29:50.28,Default,,0,0,0,,Не болды? (Юичи) Мұнай ағып жатқан сияқты.
Dialogue: 0,0:29:52.54,0:29:53.45,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:29:53.79,0:29:55.46,Default,,0,0,0,,Май ағып жатқан сияқты
Dialogue: 0,0:29:55.58,0:29:56.66,Default,,0,0,0,,Токино ше?
Dialogue: 0,0:29:57.29,0:29:58.92,Default,,0,0,0,,Мен жақында ораламын деп ойлаймын.
Dialogue: 0,0:30:03.17,0:30:06.01,Default,,0,0,0,,Себебін анықтап, есеп беру
Dialogue: 0,0:30:30.16,0:30:31.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:41.58,0:30:44.50,Default,,0,0,0,,Сіз кімсіз? Бұл мен көрмеген бет
Dialogue: 0,0:30:44.63,0:30:47.05,Default,,0,0,0,,Каннами ұшқышы осында
Dialogue: 0,0:30:47.17,0:30:49.13,Default,,0,0,0,,Каннами... Сіз нені айтып тұрсыз?
Dialogue: 0,0:30:49.38,0:30:50.34,Default,,0,0,0,,Юичи
Dialogue: 0,0:30:51.14,0:30:53.39,Default,,0,0,0,,Менің атым Мизуки Кусанаги.
Dialogue: 0,0:30:54.14,0:30:54.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:56.72,0:31:00.73,Default,,0,0,0,,Кусанаги Гидрогеннің сіңлісі, танысқаныма қуаныштымын, Юичи-кун
Dialogue: 0,0:31:00.85,0:31:02.52,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:31:02.65,0:31:04.32,Default,,0,0,0,,Сіз нені қалайсыз?
Dialogue: 0,0:31:04.82,0:31:06.73,Default,,0,0,0,,Хе, сен бірінші айттың.
Dialogue: 0,0:31:06.86,0:31:08.28,Default,,0,0,0,,Менің “өтінемін”
Dialogue: 0,0:31:08.40,0:31:11.70,Default,,0,0,0,,Дос болып, әңгімелесу дегенді білдіреді.
Dialogue: 0,0:31:11.82,0:31:14.99,Default,,0,0,0,,Мен де солай істеймін. Сіз бірдеңе ішкіңіз келе ме?
Dialogue: 0,0:31:15.12,0:31:15.95,Default,,0,0,0,,Иә
Dialogue: 0,0:31:16.66,0:31:18.29,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:31:19.41,0:31:22.38,Default,,0,0,0,,Мектеп жабық, ендеше көңіл көтерейік
Dialogue: 0,0:31:23.21,0:31:26.46,Default,,0,0,0,,Әпкем жоқ деді, бірақ мен келдім.
Dialogue: 0,0:31:26.88,0:31:29.76,Default,,0,0,0,,Сондықтан әзірге апамның жұмысына араласқым келмейді.
Dialogue: 0,0:31:29.88,0:31:32.01,Default,,0,0,0,,Жалғыз зерттеу
Dialogue: 0,0:31:32.14,0:31:33.34,Default,,0,0,0,,Хмм.
Dialogue: 0,0:31:33.72,0:31:35.56,Default,,0,0,0,,Сіз көңілді бірдеңе жасағыңыз келе ме?
Dialogue: 0,0:31:35.68,0:31:36.72,Default,,0,0,0,,Мысалы?
Dialogue: 0,0:31:36.85,0:31:40.60,Default,,0,0,0,,Хмм... Қызық, сіз әдетте не істейсіз?
Dialogue: 0,0:31:40.73,0:31:44.52,Default,,0,0,0,,Мен сізді мақтан ететіндей ештеңе істеген жоқпын.
Dialogue: 0,0:31:44.65,0:31:46.61,Default,,0,0,0,,Ойындар мен сол сияқты нәрселер туралы не деуге болады?
Dialogue: 0,0:31:46.73,0:31:47.69,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:31:47.82,0:31:49.24,Default,,0,0,0,,Бала болсаң да?
Dialogue: 0,0:31:49.36,0:31:50.36,Default,,0,0,0,,Иә
Dialogue: 0,0:31:50.49,0:31:51.32,Default,,0,0,0,,Я...
Dialogue: 0,0:31:59.20,0:32:01.41,Default,,0,0,0,,Юичи-кун Килледре ме?
Dialogue: 0,0:32:01.54,0:32:02.46,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:32:02.58,0:32:05.46,Default,,0,0,0,,Балалар, сендер өсе алмайсыңдар, солай ма?
Dialogue: 0,0:32:05.59,0:32:06.42,Default,,0,0,0,,Иә
Dialogue: 0,0:32:06.54,0:32:08.34,Default,,0,0,0,,Неліктен өсе алмайсың?
Dialogue: 0,0:32:10.05,0:32:12.97,Default,,0,0,0,,Бұл мүмкін емес деген емес, бұл сізге керек
Dialogue: 0,0:32:13.30,0:32:15.43,Default,,0,0,0,,Сіз өскіңіз келе ме?
Dialogue: 0,0:32:16.05,0:32:19.39,Default,,0,0,0,,Хмм... Мен таң қалдым
Dialogue: 0,0:32:20.64,0:32:21.77,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:32:21.89,0:32:23.81,Default,,0,0,0,,(Ұшақтың ұшу дыбысы)
Dialogue: 0,0:32:23.94,0:32:27.11,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:32:47.84,0:32:51.46,Default,,0,0,0,,(иттің ырылдаған дыбысы)
Dialogue: 0,0:32:52.72,0:32:53.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:53.84,0:32:55.84,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:33:04.31,0:33:05.65,Default,,0,0,0,,Фу…
Dialogue: 0,0:33:09.11,0:33:13.07,Default,,0,0,0,,(ұшқындардың дыбысы)
Dialogue: 0,0:33:13.70,0:33:15.20,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:33:15.32,0:33:17.49,Default,,0,0,0,,Әй, қарама, көзің ауырады.
Dialogue: 0,0:33:17.62,0:33:18.62,Default,,0,0,0,,Енді қорлау болмайды!
Dialogue: 0,0:33:18.83,0:33:19.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:33:19.95,0:33:22.20,Default,,0,0,0,,Маған дәнекерлеу көзілдірігін бере аласыз ба?
Dialogue: 0,0:33:22.70,0:33:24.87,Default,,0,0,0,,Оның қай жерде жарқырағанын көрсетсеңші.
Dialogue: 0,0:33:27.71,0:33:29.00,Default,,0,0,0,,Я...
Dialogue: 0,0:33:29.75,0:33:32.01,Default,,0,0,0,,Ники Сәлем
Dialogue: 0,0:33:35.13,0:33:36.55,Default,,0,0,0,,Рахмет
Dialogue: 0,0:33:37.43,0:33:40.18,Default,,0,0,0,,Уау, мен ештеңе көрмеймін. Ах...
Dialogue: 0,0:33:40.60,0:33:41.43,Default,,0,0,0,,Баа!
Dialogue: 0,0:33:41.56,0:33:43.85,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:33:44.02,0:33:47.81,Default,,0,0,0,,Бұл қауіпті, сондықтан жақындамаңыз. Түсінді ме?
Dialogue: 0,0:33:47.98,0:33:49.27,Default,,0,0,0,,Иә
Dialogue: 0,0:33:57.16,0:33:58.66,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:33:58.91,0:34:00.20,Default,,0,0,0,,Кеш болды ма?
Dialogue: 0,0:34:00.45,0:34:05.04,Default,,0,0,0,,Әй, сен жоғарыға келген соң, кішкене барлау жасайық.
Dialogue: 0,0:34:16.63,0:34:17.97,Default,,0,0,0,,Фу…
Dialogue: 0,0:34:20.01,0:34:22.10,Default,,0,0,0,,Иә, ол менің әпкем емес.
Dialogue: 0,0:34:25.39,0:34:26.60,Default,,0,0,0,,Кездесу аяқталғаннан кейін де, үйге келген соң қылмыскерлерді үкім шығарумен қайта айналысамын.
Dialogue: 0,0:34:26.73,0:34:28.52,Default,,0,0,0,,Қыз деген мағынаны білдіреді.
Dialogue: 0,0:34:36.07,0:34:37.20,Default,,0,0,0,,Мен оралдым
Dialogue: 0,0:34:37.32,0:34:38.49,Default,,0,0,0,,Кейінірек есеп беру.
Dialogue: 0,0:34:38.61,0:34:39.78,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:34:40.16,0:34:41.03,Default,,0,0,0,,Нашар
Dialogue: 0,0:34:41.16,0:34:42.16,Default,,0,0,0,,Жоқ
Dialogue: 0,0:34:47.16,0:34:49.21,Default,,0,0,0,,(Мидзукидің күлкісі)
Dialogue: 0,0:34:49.33,0:34:52.63,Default,,0,0,0,,Сол қызға қарасам кейде өз-өзімнен жиіркенемін.
Dialogue: 0,0:34:57.51,0:34:58.76,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:34:58.88,0:35:01.89,Default,,0,0,0,,Жақында ол қыз мені қуып жетеді.
Dialogue: 0,0:35:02.39,0:35:04.31,Default,,0,0,0,,Сонда не істейміз?
Dialogue: 0,0:35:08.10,0:35:09.60,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:35:09.89,0:35:13.40,Default,,0,0,0,,Қонақ келе жатыр. Онымен кездессем жақсы ма?
Dialogue: 0,0:35:13.73,0:35:14.98,Default,,0,0,0,,Маған жақсы ма?
Dialogue: 0,0:35:15.53,0:35:17.69,Default,,0,0,0,,Мен ол баланы үйге апарамын.
Dialogue: 0,0:35:18.36,0:35:19.53,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:35:25.28,0:35:26.45,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:35:26.58,0:35:28.08,Default,,0,0,0,,Е...
Dialogue: 0,0:35:57.53,0:36:02.24,Default,,0,0,0,,Келуші ме? Мен мұнда бұрын бір рет болғанмын.
Dialogue: 0,0:36:02.36,0:36:05.07,Default,,0,0,0,,Менің компаниямның демеушілік қатынасы және т.б.
Dialogue: 0,0:36:05.41,0:36:08.83,Default,,0,0,0,,Біздің компанияны қолдаймыз деген бір топ жігіттер.
Dialogue: 0,0:36:09.08,0:36:11.54,Default,,0,0,0,,Бұл туралы не ойлайсыз?
Dialogue: 0,0:36:11.66,0:36:13.12,Default,,0,0,0,,«Осындай нәрсе»?
Dialogue: 0,0:36:13.25,0:36:16.00,Default,,0,0,0,,Бару идеясының өзі
Dialogue: 0,0:36:16.63,0:36:18.05,Default,,0,0,0,,Ерекше ештеңе жоқ
Dialogue: 0,0:36:18.55,0:36:20.88,Default,,0,0,0,,Мені өлтіргіңіз келетініне сенімдімін.
Dialogue: 0,0:36:23.22,0:36:25.85,Default,,0,0,0,,Мен ол әйелді баяғыда атып едім.
Dialogue: 0,0:36:25.97,0:36:27.14,Default,,0,0,0,,«Бұл әйел» кім?
Dialogue: 0,0:36:27.26,0:36:28.89,Default,,0,0,0,,Екінші қабаттағы қыз
Dialogue: 0,0:36:29.27,0:36:30.35,Default,,0,0,0,,Құсанағы мырза?
Dialogue: 0,0:36:30.47,0:36:31.52,Default,,0,0,0,,О
Dialogue: 0,0:36:31.64,0:36:32.77,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:36:32.89,0:36:34.90,Default,,0,0,0,,Мен үнемі мылтық ұстаймын.
Dialogue: 0,0:36:57.46,0:37:00.46,Default,,0,0,0,,Джиро Курита туралы естідіңіз бе?
Dialogue: 0,0:37:00.88,0:37:02.22,Default,,0,0,0,,Қандай әңгіме?
Dialogue: 0,0:37:02.42,0:37:04.43,Default,,0,0,0,,Әлгі әйел мені атып тастады.
Dialogue: 0,0:37:05.01,0:37:06.01,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:37:06.14,0:37:10.60,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:37:10.72,0:37:12.98,Default,,0,0,0,,Сора келіп орындады.
Dialogue: 0,0:37:17.86,0:37:21.32,Default,,0,0,0,,(Шулы әңгіме)
Dialogue: 0,0:37:28.03,0:37:31.04,Default,,0,0,0,,(Шулы әңгіме)
Dialogue: 0,0:37:33.58,0:37:36.46,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:38:21.29,0:38:24.13,Default,,0,0,0,,(Эндевор) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:38:24.26,0:38:26.80,Default,,0,0,0,,
Dialogue: 0,0:38:31.14,0:38:32.14,Default,,0,0,0,,Ах
Dialogue: 0,0:38:39.23,0:38:40.23,Default,,0,0,0,,Құлап қалма
Dialogue: 0,0:38:40.35,0:38:44.23,Default,,0,0,0,,
Dialogue: 0,0:38:44.36,0:38:46.69,Default,,0,0,0,,(Келушілер айқайлайды)
Dialogue: 0,0:39:04.09,0:39:06.51,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:39:21.69,0:39:23.27,Default,,0,0,0,,Біздің компанияның ұшқышы?
Dialogue: 0,0:39:23.61,0:39:25.44,Default,,0,0,0,,Бұл бірдей үлгі...
Dialogue: 0,0:39:25.57,0:39:28.40,Default,,0,0,0,,Көрші театрдан біреу келген шығар.
Dialogue: 0,0:39:40.92,0:39:44.50,Default,,0,0,0,,(Жылаған әйел)
Dialogue: 0,0:39:52.01,0:39:53.47,Default,,0,0,0,,Мен аянышты емеспін.
Dialogue: 0,0:39:55.18,0:39:57.06,Default,,0,0,0,,Мені аяма!
Dialogue: 0,0:39:57.97,0:40:00.43,Default,,0,0,0,,Оны аяп қорлама!
Dialogue: 0,0:40:04.11,0:40:05.23,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:40:05.36,0:40:06.36,Default,,0,0,0,,Әй!
Dialogue: 0,0:40:08.19,0:40:09.49,Default,,0,0,0,,Ха... (Токино) Ах.
Dialogue: 0,0:40:53.11,0:40:54.41,Default,,0,0,0,,Фу…
Dialogue: 0,0:41:03.58,0:41:05.79,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:41:53.84,0:41:55.30,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:41:57.13,0:42:01.39,Default,,0,0,0,,(ағылшын тілінде сөйлейтін дауыс)
Dialogue: 0,0:42:34.38,0:42:35.84,Default,,0,0,0,,Сізге қоңырау шалғанымды қалайсыз ба?
Dialogue: 0,0:42:35.97,0:42:36.88,Default,,0,0,0,,Кім?
Dialogue: 0,0:42:37.01,0:42:39.01,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:42:39.13,0:42:42.93,Default,,0,0,0,,Жоқ, мен мұны жегеннен кейін қайтамын.
Dialogue: 0,0:42:43.06,0:42:47.02,Default,,0,0,0,,(Шабуылдық ұшақтың ұшу дыбысы)
Dialogue: 0,0:42:55.36,0:42:56.40,Default,,0,0,0,,Ха…
Dialogue: 0,0:43:22.55,0:43:24.89,Default,,0,0,0,,(тиын салу дыбысы)
Dialogue: 0,0:43:34.73,0:43:35.73,Default,,0,0,0,,Бұл каннами
Dialogue: 0,0:43:35.86,0:43:36.69,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:43:36.82,0:43:37.90,Default,,0,0,0,,Көлікпен кіру
Dialogue: 0,0:43:38.03,0:43:40.49,Default,,0,0,0,,А... бұл өте жаман. Мен оны кесіп тастаймын.
Dialogue: 0,0:43:40.61,0:43:43.07,Default,,0,0,0,,Осы бағытта үш бақыт бар.
Dialogue: 0,0:43:43.20,0:43:44.03,Default,,0,0,0,,Екі ұшақ.
Dialogue: 0,0:43:44.16,0:43:45.12,Default,,0,0,0,,Жоқ, үшеуі бар.
Dialogue: 0,0:43:45.24,0:43:45.99,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:43:46.12,0:43:46.87,Default,,0,0,0,,Иә
Dialogue: 0,0:43:46.99,0:43:48.37,Default,,0,0,0,,Бұл жерден қанша қашықтықта?
Dialogue: 0,0:43:48.50,0:43:50.50,Default,,0,0,0,,Оған 5 минуттан артық уақыт кетпеуі мүмкін.
Dialogue: 0,0:43:50.62,0:43:53.88,Default,,0,0,0,,Бұл жағдайда мен демалуға болады. Мен Каннамиге қайтып бара алмаймын.
Dialogue: 0,0:43:54.17,0:43:55.29,Default,,0,0,0,,Менің ұшағым ше?
Dialogue: 0,0:43:55.42,0:43:56.30,Default,,0,0,0,,Мен мінемін
Dialogue: 0,0:43:56.42,0:43:57.71,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:44:00.84,0:44:02.22,Default,,0,0,0,,Сіз қайтып барасыз ба?
Dialogue: 0,0:44:02.51,0:44:05.05,Default,,0,0,0,,Қазір қайтып барсам да, ұшақ қалмайды.
Dialogue: 0,0:44:05.35,0:44:06.85,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:44:08.93,0:44:10.02,Default,,0,0,0,,Менде қандай да бір дарын бар адам сияқты көрінемін бе?
Dialogue: 0,0:44:14.48,0:44:16.61,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:44:16.90,0:44:18.57,Default,,0,0,0,,Юичи!
Dialogue: 0,0:44:22.49,0:44:24.28,Default,,0,0,0,,Юичи!
Dialogue: 0,0:44:24.41,0:44:25.87,Default,,0,0,0,,Юичи!
Dialogue: 0,0:44:27.16,0:44:30.50,Default,,0,0,0,,Амансың ба? Үлкен бір нәрсе ұшып бара жатты.
Dialogue: 0,0:44:30.62,0:44:32.21,Default,,0,0,0,,Бұл ұзақ уақыт бойы жасалды
Dialogue: 0,0:44:32.33,0:44:33.37,Default,,0,0,0,,Наофуми туралы не деуге болады?
Dialogue: 0,0:44:33.50,0:44:34.33,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:44:34.46,0:44:36.54,Default,,0,0,0,,Әй, сен неге осы жолмен жүрмейсің?
Dialogue: 0,0:44:36.79,0:44:38.55,Default,,0,0,0,,Мен мұны артта қалдыра алмаймын.
Dialogue: 0,0:44:38.67,0:44:39.84,Default,,0,0,0,,Өйткені ол қарызға алынған
Dialogue: 0,0:44:39.96,0:44:41.67,Default,,0,0,0,,Олай болса мен алға барамын.
Dialogue: 0,0:44:41.80,0:44:42.80,Default,,0,0,0,,О
Dialogue: 0,0:44:50.56,0:44:54.73,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:45:00.07,0:45:03.36,Default,,0,0,0,,(Скутердің жүгіру дыбысы)
Dialogue: 0,0:45:06.70,0:45:08.28,Default,,0,0,0,,Барлығы қауіпсіз ұшты ма?
Dialogue: 0,0:45:08.41,0:45:13.21,Default,,0,0,0,,Каннамидің ұшағы ең қиын болды, қазір ол спиннерсіз ұшады.
Dialogue: 0,0:45:13.33,0:45:17.29,Default,,0,0,0,,Жанармай құйып үлгермей, жанармай таусылатын болды.
Dialogue: 0,0:45:17.42,0:45:18.79,Default,,0,0,0,,Құсанаги мырза бортта бар ма?
Dialogue: 0,0:45:18.92,0:45:19.75,Default,,0,0,0,,Иә
Dialogue: 0,0:45:23.72,0:45:27.64,Default,,0,0,0,,Бұл Наофуми! Наофуми!
Dialogue: 0,0:45:28.10,0:45:32.14,Default,,0,0,0,,Ол ханымдарды қазір босату керек.
Dialogue: 0,0:45:32.43,0:45:35.31,Default,,0,0,0,,Құсанағы мырза қайтып келсе, мені айғайлайды.
Dialogue: 0,0:45:35.77,0:45:37.31,Default,,0,0,0,,Саған кім айғайлап жатыр?
Dialogue: 0,0:45:37.98,0:45:40.40,Default,,0,0,0,,Юичиден рұқсат алғаныңызды айттыңыз.
Dialogue: 0,0:45:40.52,0:45:42.11,Default,,0,0,0,,Юичи!
Dialogue: 0,0:45:42.65,0:45:45.90,Default,,0,0,0,,Енді мен сенің аман екеніңді білдім, мен үйге бара жатырмын.
Dialogue: 0,0:45:46.03,0:45:48.87,Default,,0,0,0,,Қош бол Юичи
Dialogue: 0,0:46:23.40,0:46:25.19,Default,,0,0,0,,Қажетсіз істермен айналыспаңыз
Dialogue: 0,0:46:32.74,0:46:33.99,Default,,0,0,0,,Токино, бұл баяу.
Dialogue: 0,0:46:34.12,0:46:35.66,Default,,0,0,0,,Сіздің қауіпсіз екеніңізге сенімдімін.
Dialogue: 0,0:46:35.91,0:46:38.58,Default,,0,0,0,,Мен мұның үстінде бұрын айналдырдым.
Dialogue: 0,0:46:38.92,0:46:41.17,Default,,0,0,0,,Ол бір жерге қонып жатыр.
Dialogue: 0,0:46:43.71,0:46:46.26,Default,,0,0,0,,Бұл менмін, театрдың бас кеңсесі.
Dialogue: 0,0:46:47.01,0:46:49.13,Default,,0,0,0,,Нашар Сізде темекі жоқ па?
Dialogue: 0,0:46:55.27,0:46:56.27,Default,,0,0,0,,(сіріңкені соққан дыбыс)
Dialogue: 0,0:47:02.56,0:47:05.19,Default,,0,0,0,,Бұл Құсанағы. Мені менеджерге қосыңыз.
Dialogue: 0,0:47:06.69,0:47:08.53,Default,,0,0,0,,Жарайды, менеджерді жіберіңіз.
Dialogue: 0,0:47:10.49,0:47:14.37,Default,,0,0,0,,Иә, ғажайып түрде үлкен шығын болған жоқ.
Dialogue: 0,0:47:14.49,0:47:17.00,Default,,0,0,0,,Тек басқа адам қателесті.
Dialogue: 0,0:47:17.12,0:47:19.21,Default,,0,0,0,,Неліктен сізбен байланысу кешіктірілді?
Dialogue: 0,0:47:20.33,0:47:23.00,Default,,0,0,0,,Бұл жақсы себеп емес. Мен қазір барамын.
Dialogue: 0,0:47:23.13,0:47:24.96,Default,,0,0,0,,Ютагва өзені
Dialogue: 0,0:47:25.42,0:47:27.92,Default,,0,0,0,,Мен қайтып келгенше сіз жоғарғы қабаттағы партада тұра аласыз ба?
Dialogue: 0,0:47:28.17,0:47:30.55,Default,,0,0,0,,Төтенше қоңырау болуы мүмкін.
Dialogue: 0,0:47:30.93,0:47:34.35,Default,,0,0,0,,Жақсы, ішіп-жегенше (Құсанағы) Әрине.
Dialogue: 0,0:47:35.14,0:47:37.02,Default,,0,0,0,,Каннами, менімен бірге жүр.
Dialogue: 0,0:47:46.90,0:47:48.32,Default,,0,0,0,,Бұл тым көп емес пе?
Dialogue: 0,0:47:48.44,0:47:50.70,Default,,0,0,0,,Кешіріңіз, мен осылай сезінемін.
Dialogue: 0,0:47:55.28,0:47:56.41,Default,,0,0,0,,Бұл Токино.
Dialogue: 0,0:47:56.62,0:47:58.66,Default,,0,0,0,,Ақыр соңында мен қыдырып жүрген шығармын.
Dialogue: 0,0:47:59.45,0:48:04.29,Default,,0,0,0,,Кіретін жолдың алдындағы түзу жол апатты жағдайда қону үшін қолжетімді.
Dialogue: 0,0:48:05.42,0:48:07.25,Default,,0,0,0,,Кофе ішуге арналған.
Dialogue: 0,0:48:48.05,0:48:51.09,Default,,0,0,0,,Маған қиналмай қарсы алғаныңызға рахмет.
Dialogue: 0,0:48:51.30,0:48:53.01,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:48:53.34,0:48:56.26,Default,,0,0,0,,Демек, сіз ішке кіруді жоспарламайсыз.
Dialogue: 0,0:48:57.68,0:48:58.89,Default,,0,0,0,,Ағаларыңа құрмет көрсет!
Dialogue: 0,0:48:59.01,0:49:02.77,Default,,0,0,0,,Менің байқағаным бойынша, олар тайфуннан зардап шекпеген сияқты.
Dialogue: 0,0:49:02.89,0:49:03.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:05.94,0:49:07.61,Default,,0,0,0,,Ол менің бағыныштым.
Dialogue: 0,0:49:07.73,0:49:10.61,Default,,0,0,0,,Өйткені бұл менің физикалық күшімді сарп етуі мүмкін деп ойладым.
Dialogue: 0,0:49:11.03,0:49:13.70,Default,,0,0,0,,Сонда мен сенен мені айдауыңды өтінемін деп ойладым.
Dialogue: 0,0:49:13.82,0:49:16.70,Default,,0,0,0,,Түсіндім, сіз үлгі екенсіз...
Dialogue: 0,0:49:16.91,0:49:20.37,Default,,0,0,0,,А... менеджер қала сыртында.
Dialogue: 0,0:49:20.49,0:49:21.95,Default,,0,0,0,,Егер сіз менеджердің бөлмесіне барсаңыз
Dialogue: 0,0:49:22.08,0:49:25.29,Default,,0,0,0,,Мен сіздің сыртта екеніңізді немесе жоқ екеніңізді айта аламын.
Dialogue: 0,0:49:25.42,0:49:27.50,Default,,0,0,0,,Ей, сен осы уақытқа дейін келдің,
Dialogue: 0,0:49:27.63,0:49:30.80,Default,,0,0,0,,Мен жағдайдың маңыздылығын толық түсіндім.
Dialogue: 0,0:49:30.92,0:49:33.47,Default,,0,0,0,,Басқаша айтқанда, менің сезімім жеткізілді деп ойлаймын.
Dialogue: 0,0:49:33.88,0:49:35.47,Default,,0,0,0,,Мені қате түсінбеңіз
Dialogue: 0,0:49:35.59,0:49:39.01,Default,,0,0,0,,Мені өлтірмек болған жігіттің түрін көргім келеді.
Dialogue: 0,0:49:39.39,0:49:40.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:42.89,0:49:45.19,Default,,0,0,0,,Мүлдем жетілмеген
Dialogue: 0,0:49:45.31,0:49:47.44,Default,,0,0,0,,Осының кесірінен балалар қиналады.
Dialogue: 0,0:49:48.06,0:49:49.94,Default,,0,0,0,,А... жоқ, кешіріңіз.
Dialogue: 0,0:49:50.07,0:49:51.90,Default,,0,0,0,,Жоқ, дұрыс.
Dialogue: 0,0:49:52.94,0:49:55.65,Default,,0,0,0,,Бірақ ертең өлетін адам
Dialogue: 0,0:49:55.78,0:49:58.37,Default,,0,0,0,,Ересек болу қажет пе?
Dialogue: 0,0:50:14.13,0:50:16.17,Default,,0,0,0,,Одан әрі оңға бұрылыңыз
Dialogue: 0,0:50:16.30,0:50:17.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:18.01,0:50:19.59,Default,,0,0,0,,Мен бір сәтке тоқтағаныңызды қалаймын.
Dialogue: 0,0:50:20.80,0:50:22.81,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:50:29.06,0:50:32.90,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:51:04.39,0:51:05.47,Default,,0,0,0,,Сізбен қалай байланысуға болады?
Dialogue: 0,0:51:06.73,0:51:09.44,Default,,0,0,0,,Иә... Иә, жетеді. Үзіліс жасаңыз.
Dialogue: 0,0:51:09.81,0:51:10.81,Default,,0,0,0,,Рахмет
Dialogue: 0,0:51:24.70,0:51:25.91,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:51:26.66,0:51:28.66,Default,,0,0,0,,Қонақ бөлмесі сияқты нәрсе
Dialogue: 0,0:51:30.46,0:51:32.33,Default,,0,0,0,,Қызметкерлер пайдалану құқығына ие
Dialogue: 0,0:51:32.46,0:51:34.84,Default,,0,0,0,,Оны анда-санда пайдалану керек.
Dialogue: 0,0:51:34.96,0:51:36.84,Default,,0,0,0,,Ешкім екі рет келмейді
Dialogue: 0,0:51:38.88,0:51:43.22,Default,,0,0,0,,Сонда барлығы бір рет болса да келді ме? Құсанаги-санмен
Dialogue: 0,0:51:43.35,0:51:46.56,Default,,0,0,0,,Екі адамның жалғыз келуі сирек.
Dialogue: 0,0:51:46.68,0:51:47.81,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:51:49.18,0:51:50.64,Default,,0,0,0,,Сіз аштыңыз ба?
Dialogue: 0,0:51:51.06,0:51:53.98,Default,,0,0,0,,Жалғыз нұсқа - мұздату, бірақ мен бірдеңе жасаймын.
Dialogue: 0,0:52:15.75,0:52:17.46,Default,,0,0,0,,Сіз жақсы тамақтанасыз.
Dialogue: 0,0:52:18.46,0:52:19.38,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:52:19.51,0:52:21.55,Default,,0,0,0,,Бұл өте нашар.
Dialogue: 0,0:52:21.68,0:52:24.76,Default,,0,0,0,,Бірақ ол жеуге болатын ингредиенттерден жасалған, солай ма? Бұл
Dialogue: 0,0:52:31.27,0:52:32.52,Default,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,0:52:36.02,0:52:37.90,Default,,0,0,0,,Сіз түнеуге болады.
Dialogue: 0,0:52:57.04,0:53:00.63,Default,,0,0,0,,Джинро, сен осында қалдың ба?
Dialogue: 0,0:53:01.63,0:53:02.63,Default,,0,0,0,,Иә
Dialogue: 0,0:53:04.30,0:53:05.39,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:53:07.60,0:53:10.06,Default,,0,0,0,,Ютагва мырза біртүрлі нәрсе айтты.
Dialogue: 0,0:53:11.98,0:53:14.69,Default,,0,0,0,,Сен Джинроны өлтірдің.
Dialogue: 0,0:53:23.74,0:53:25.20,Default,,0,0,0,,Мүмкін-
Dialogue: 0,0:53:27.62,0:53:29.91,Default,,0,0,0,,Менің де сені өлтіргенімді қалайсың ба?
Dialogue: 0,0:53:34.71,0:53:36.71,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:54:54.16,0:54:55.41,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:54:56.66,0:54:58.75,Default,,0,0,0,,Қаш, Юичи!
Dialogue: 0,0:55:05.63,0:55:06.97,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:55:32.07,0:55:35.62,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:55:46.76,0:55:49.17,Default,,0,0,0,,(Юичидің ауыр тыныс алуы)
Dialogue: 0,0:56:10.82,0:56:13.16,Default,,0,0,0,,Ютагва – «мұғалім»?
Dialogue: 0,0:56:13.62,0:56:14.62,Default,,0,0,0,,Иә
Dialogue: 0,0:56:21.75,0:56:22.96,Default,,0,0,0,,Жетеді
Dialogue: 0,0:56:31.26,0:56:35.35,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:57:04.04,0:57:05.25,Default,,0,0,0,,Ах~
Dialogue: 0,0:57:06.54,0:57:10.00,Default,,0,0,0,,Теңізде болды, әп-сәтте батып кетті.
Dialogue: 0,0:57:10.13,0:57:11.30,Default,,0,0,0,,О, Зұлымдар одағының шабуылынан травма алдың ба? (Деку) Жоқ
Dialogue: 0,0:57:15.22,0:57:19.10,Default,,0,0,0,,Скайли бұрын-соңды бұл ұрыс даласында ұшпаған.
Dialogue: 0,0:57:21.06,0:57:22.77,Default,,0,0,0,,Юичи көрген ұшақ
Dialogue: 0,0:57:22.89,0:57:25.27,Default,,0,0,0,,Менің ойымша, олар мұғалім екенін көргісі келді.
Dialogue: 0,0:57:25.40,0:57:26.81,Default,,0,0,0,,Мұғалім дегеніміз не?
Dialogue: 0,0:57:27.06,0:57:29.32,Default,,0,0,0,,Аспанда кездессең
Dialogue: 0,0:57:29.44,0:57:30.61,Default,,0,0,0,,Тірі қайтып оралу мүмкін емес
Dialogue: 0,0:57:31.94,0:57:35.49,Default,,0,0,0,,Лотерннің ұшқышы... шамасы.
Dialogue: 0,0:57:35.70,0:57:38.37,Default,,0,0,0,,Ұпай біраз уақыттан бері біржақты болды.
Dialogue: 0,0:57:38.49,0:57:41.58,Default,,0,0,0,,Басқа соғыс театрынан ауыстырылған болуы мүмкін.
Dialogue: 0,0:57:42.25,0:57:44.00,Default,,0,0,0,,Мүмкін сияқты.
Dialogue: 0,0:57:44.54,0:57:45.54,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:57:51.96,0:57:53.30,Default,,0,0,0,,Мұғалім…
Dialogue: 0,0:57:58.55,0:58:02.77,Default,,0,0,0,,Бұл жай ғана қауесет, бірақ ол бізден бөлек.
Dialogue: 0,0:58:02.97,0:58:04.60,Default,,0,0,0,,Ол ересек адам сияқты.
Dialogue: 0,0:58:04.85,0:58:06.98,Default,,0,0,0,,Сіз истребитель ұшқышы болсаңыз да?
Dialogue: 0,0:58:07.56,0:58:08.61,Default,,0,0,0,,О
Dialogue: 0,0:58:09.44,0:58:11.98,Default,,0,0,0,,Ол ересек адам.
Dialogue: 0,0:58:13.57,0:58:15.86,Default,,0,0,0,,Ересек адам
Dialogue: 0,0:58:18.36,0:58:23.37,Default,,0,0,0,,♪~ (музыкалық қорап әні)
Dialogue: 0,0:58:39.22,0:58:41.18,Default,,0,0,0,,~♪
Dialogue: 0,0:58:41.26,0:58:43.26,Default,,0,0,0,,(кіші негізгі ән)
Dialogue: 0,1:00:42.47,1:00:45.89,Default,,0,0,0,,~♪
Dialogue: 0,1:01:13.87,1:01:16.63,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,1:01:16.71,1:01:18.34,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,1:01:30.06,1:01:31.93,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:01:35.65,1:01:36.73,Default,,0,0,0,,Сізбен қалай байланысуға болады?
Dialogue: 0,1:01:36.85,1:01:38.40,Default,,0,0,0,,Ештеңе
Dialogue: 0,1:01:41.44,1:01:44.28,Default,,0,0,0,,«Қайтайық» дедім.
Dialogue: 0,1:01:44.40,1:01:47.07,Default,,0,0,0,,Бұлттар күмәнді, отын нашар болды.
Dialogue: 0,1:01:47.20,1:01:48.99,Default,,0,0,0,,Ол да бұған келісті.
Dialogue: 0,1:01:49.12,1:01:50.37,Default,,0,0,0,,Сонда неге?
Dialogue: 0,1:01:51.83,1:01:55.25,Default,,0,0,0,,Жау ұшағын алыстан көріп, құрамадан шықты.
Dialogue: 0,1:01:55.46,1:01:57.71,Default,,0,0,0,,Оның әлі оралмағанын көріп...
Dialogue: 0,1:01:57.83,1:01:59.29,Default,,0,0,0,,Сыра ішпеңіз
Dialogue: 0,1:01:59.42,1:02:02.17,Default,,0,0,0,,Ауа-райы жақсарған кезде мен іздеуге ұшып кетуім мүмкін.
Dialogue: 0,1:02:02.30,1:02:04.63,Default,,0,0,0,,Иә! Мен мұғалім болдым
Dialogue: 0,1:02:05.17,1:02:06.59,Default,,0,0,0,,Қара пантераның белгісі дегеніміз не?
Dialogue: 0,1:02:06.72,1:02:10.43,Default,,0,0,0,,Егер мен оны көре алатындай алыс болсам, мен де қалар едім.
Dialogue: 0,1:02:10.85,1:02:13.39,Default,,0,0,0,,Неліктен ол Мұғалімге ерекше көңіл бөледі?
Dialogue: 0,1:02:13.73,1:02:16.10,Default,,0,0,0,,Қайтып келгенде сұраңыз.
Dialogue: 0,1:02:16.56,1:02:18.90,Default,,0,0,0,,Егер мен қайта оралсам...
Dialogue: 0,1:02:24.82,1:02:27.82,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:02:58.94,1:03:01.27,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,1:03:14.54,1:03:18.29,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,1:03:29.47,1:03:30.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:31.43,1:03:32.55,Default,,0,0,0,,Әй!
Dialogue: 0,1:03:32.76,1:03:33.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:37.39,1:03:38.94,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,1:03:39.98,1:03:40.98,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:41.90,1:03:43.52,Default,,0,0,0,,Бұл дәрігер! Бұл жедел жәрдем!
Dialogue: 0,1:03:43.65,1:03:45.36,Default,,0,0,0,,Көрпе әкел!
Dialogue: 0,1:03:45.57,1:03:46.86,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:03:48.69,1:03:51.24,Default,,0,0,0,,Менің үйімнің жанына апатты түрде қонған сияқты.
Dialogue: 0,1:03:51.45,1:03:52.49,Default,,0,0,0,,Рахмет
Dialogue: 0,1:03:53.78,1:03:57.58,Default,,0,0,0,,Мен оның мұндай түрін бұрын бір рет көргенмін.
Dialogue: 0,1:03:57.70,1:03:58.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:00.92,1:04:05.29,Default,,0,0,0,,Ол түзу және осында соғып тұрғандай.
Dialogue: 0,1:04:07.34,1:04:11.88,Default,,0,0,0,,Ол кісі менің үйіме баяғыда келген.
Dialogue: 0,1:04:12.22,1:04:13.76,Default,,0,0,0,,Қонағымды қарсы алу үшін
Dialogue: 0,1:04:17.85,1:04:21.69,Default,,0,0,0,,Сен мені қуып жібердің, мен сағаттап шықпадым.
Dialogue: 0,1:04:41.29,1:04:44.04,Default,,0,0,0,,Бұл адам қауіпті.
Dialogue: 0,1:04:49.13,1:04:50.67,Default,,0,0,0,,Сіз не қарап тұрсыз? (Токино/Шинода) Уау!
Dialogue: 0,1:04:50.80,1:04:52.80,Default,,0,0,0,,Сыртта болыңыз (Токино) Иә!
Dialogue: 0,1:04:54.93,1:04:58.35,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:05:01.27,1:05:02.94,Default,,0,0,0,,Сізде темекі бар ма?
Dialogue: 0,1:05:11.07,1:05:13.32,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,1:05:13.45,1:05:15.91,Default,,0,0,0,,Мұны бәріне айтыңыз.
Dialogue: 0,1:05:18.49,1:05:20.24,Default,,0,0,0,,Жаңа ғана есінен танып қалды
Dialogue: 0,1:05:20.37,1:05:23.00,Default,,0,0,0,,Менің байқағаным, сүйектері мен ішкі мүшелері жақсы көрінеді.
Dialogue: 0,1:05:23.12,1:05:25.83,Default,,0,0,0,,Дәрігер келгенше ұйықтатқан дұрыс.
Dialogue: 0,1:05:26.50,1:05:28.84,Default,,0,0,0,,Шамасы, ауқымды жоба бар.
Dialogue: 0,1:05:29.21,1:05:32.26,Default,,0,0,0,,Мүмкін біздің эскадрилья да қозғалуы керек шығар.
Dialogue: 0,1:05:32.38,1:05:33.47,Default,,0,0,0,,Жылжыту?
Dialogue: 0,1:05:33.88,1:05:36.05,Default,,0,0,0,,Бұл уақытша шығар.
Dialogue: 0,1:05:36.18,1:05:38.26,Default,,0,0,0,,Осы театрдан кетер алдында
Dialogue: 0,1:05:38.39,1:05:40.81,Default,,0,0,0,,Менің ойымша, олар мәселені шешкісі келді.
Dialogue: 0,1:05:45.77,1:05:49.02,Default,,0,0,0,,Сасакура мырза, сіз Кусанаги мырзамен көптен бері біргесіз, солай емес пе?
Dialogue: 0,1:05:49.27,1:05:50.40,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,1:05:50.73,1:05:52.32,Default,,0,0,0,,Мизуки - қыз
Dialogue: 0,1:05:52.44,1:05:55.95,Default,,0,0,0,,Құсанағы мырзаның қызының әкесі...
Dialogue: 0,1:05:58.99,1:06:03.08,Default,,0,0,0,,Дәрігер келгенше мен сенімен бірге боламын. Енді демалыңыз.
Dialogue: 0,1:06:17.26,1:06:20.05,Default,,0,0,0,,♪~
Dialogue: 0,1:07:25.16,1:07:27.96,Default,,0,0,0,,~♪
Dialogue: 0,1:08:15.04,1:08:16.21,Default,,0,0,0,,Қайда барсаңыз да
Dialogue: 0,1:08:16.34,1:08:19.38,Default,,0,0,0,,Мен сияқты адамдар ғана бар.
Dialogue: 0,1:08:19.97,1:08:23.30,Default,,0,0,0,,«Мен мұндайды бірінші рет көріп тұрмын» дейтіндерге.
Dialogue: 0,1:08:23.43,1:08:26.10,Default,,0,0,0,,Мен сені бұл күндері сирек көремін.
Dialogue: 0,1:08:26.22,1:08:28.81,Default,,0,0,0,,Қос ұшқыштар сирек емес пе?
Dialogue: 0,1:08:29.68,1:08:31.60,Default,,0,0,0,,Бұрын біраз адамдар болған.
Dialogue: 0,1:08:31.73,1:08:34.11,Default,,0,0,0,,Біреуі ғана қайтып келмесе, бұл нені білдіреді?
Dialogue: 0,1:08:34.23,1:08:35.73,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:08:43.66,1:08:45.99,Default,,0,0,0,,Сіз не істеп жатырсыз? Балалар сендер
Dialogue: 0,1:08:47.08,1:08:49.25,Default,,0,0,0,,Бұл балаларға мінуге арналған.
Dialogue: 0,1:08:49.37,1:08:51.33,Default,,0,0,0,,Мен де баламын, солай ма?
Dialogue: 0,1:08:54.38,1:08:55.54,Default,,0,0,0,,Хмм…
Dialogue: 0,1:08:57.42,1:09:00.51,Default,,0,0,0,,Каннами есімді адам әлі де кездесу орнында ма?
Dialogue: 0,1:09:01.47,1:09:02.97,Default,,0,0,0,,Менің ойымша, ол енді кеткен жоқ.
Dialogue: 0,1:09:03.09,1:09:04.43,Default,,0,0,0,,Сонымен, бөлме?
Dialogue: 0,1:09:04.55,1:09:05.76,Default,,0,0,0,,Мен әлі олай ойламаймын.
Dialogue: 0,1:09:09.68,1:09:11.68,Default,,0,0,0,,Мүмкін сіз?
Dialogue: 0,1:09:11.81,1:09:12.94,Default,,0,0,0,,Жақсы.
Dialogue: 0,1:09:13.06,1:09:15.19,Default,,0,0,0,,Неге маған басынан айтпадың?
Dialogue: 0,1:09:15.44,1:09:17.02,Default,,0,0,0,,Себебі мені сұраған жоқ.
Dialogue: 0,1:09:22.36,1:09:25.91,Default,,0,0,0,,Бұл мүлде емес.Мен елестеткеннен басқаша болды.
Dialogue: 0,1:09:26.12,1:09:29.24,Default,,0,0,0,,Мен Токиномын, бірақ мен ойлағаннан басқаша болды ма?
Dialogue: 0,1:09:29.66,1:09:31.91,Default,,0,0,0,,Менің атым Мицуя. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,1:09:32.04,1:09:33.21,Default,,0,0,0,,Танысқаныма қуаныштымын~
Dialogue: 0,1:09:34.83,1:09:36.58,Default,,0,0,0,,Мен ертеңді асыға күтемін.
Dialogue: 0,1:09:48.80,1:09:50.81,Default,,0,0,0,,Ол қандай әйел?
Dialogue: 0,1:10:00.27,1:10:02.32,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:10:02.57,1:10:04.57,Default,,0,0,0,,(Токинаның есінеу)
Dialogue: 0,1:10:08.74,1:10:11.16,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,1:10:11.29,1:10:13.95,Default,,0,0,0,,Не? (Токино) Кешегі әйел
Dialogue: 0,1:10:14.16,1:10:15.16,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:15.29,1:10:17.83,Default,,0,0,0,,Ол эйс. (Юичи) Иә?
Dialogue: 0,1:10:18.29,1:10:21.59,Default,,0,0,0,,Әйел эйсті елемеуге болмайды.
Dialogue: 0,1:10:21.92,1:10:24.67,Default,,0,0,0,,Менің ойымша, еркек эйс болған дұрыс емес.
Dialogue: 0,1:10:26.30,1:10:27.55,Default,,0,0,0,,(Түкіру дыбысы)
Dialogue: 0,1:10:27.68,1:10:30.01,Default,,0,0,0,,(ағын судың дыбысы)
Dialogue: 0,1:10:27.68,1:10:30.01,Default,,0,0,0,,Маған ер адамдар бәрібір.
Dialogue: 0,1:10:30.01,1:10:30.14,Default,,0,0,0,,(ағын судың дыбысы)
Dialogue: 0,1:10:30.14,1:10:32.06,Default,,0,0,0,,(ағын судың дыбысы)
Dialogue: 0,1:10:30.14,1:10:32.06,Default,,0,0,0,,Сен де біздің эйссің ғой, солай ма?
Dialogue: 0,1:10:32.85,1:10:35.14,Default,,0,0,0,,Құсанағы мырза да ғажап болған көрінеді.
Dialogue: 0,1:10:36.39,1:10:38.94,Default,,0,0,0,,Ха...Мен бұл туралы бірдеңе істегеніңізді қалаймын.
Dialogue: 0,1:10:39.06,1:10:42.19,Default,,0,0,0,,Ендеше, өз бетінше боссың.
Dialogue: 0,1:10:42.98,1:10:44.07,Default,,0,0,0,,Не?
Dialogue: 0,1:10:45.07,1:10:47.53,Default,,0,0,0,,Бұл сіз қалаған нәрсені жасай аласыз дегенді білдіреді.
Dialogue: 0,1:10:51.20,1:10:53.58,Default,,0,0,0,,Балалар, бүгін түстен кейін
Dialogue: 0,1:10:53.70,1:10:57.67,Default,,0,0,0,,Сіз ең үлкен жобаға қатысасыз.
Dialogue: 0,1:10:58.75,1:11:03.63,Default,,0,0,0,,Мақсат - орталық театрдағы Лотерннің ең үлкен базасы.
Dialogue: 0,1:11:04.42,1:11:08.84,Default,,0,0,0,,Алдымен осы базадан сегіз жойғыш ұшағы ұшып шығады.
Dialogue: 0,1:11:08.97,1:11:12.68,Default,,0,0,0,,Әр базаның жауынгерлері біртіндеп жинала бастады.
Dialogue: 0,1:11:12.81,1:11:15.27,Default,,0,0,0,,Соңғы нүктеде 80 ұшақ болады.
Dialogue: 0,1:11:15.39,1:11:19.81,Default,,0,0,0,,Сонымен қатар, 30 орташа бомба, 20 ауыр бомба жоғары биіктікте
Dialogue: 0,1:11:19.94,1:11:21.40,Default,,0,0,0,,Бұл В тобы.
Dialogue: 0,1:11:21.52,1:11:26.57,Default,,0,0,0,,А командасы 40 жойғыш ұшақ пен 50 жерүсті шабуылдау ұшақтарынан тұрады.
Dialogue: 0,1:11:26.69,1:11:28.32,Default,,0,0,0,,Балалар сендерге қарағанда жылдамырақ
Dialogue: 0,1:11:28.45,1:11:32.03,Default,,0,0,0,,Алдыңыздағы екі фронттық базаны соғыңыз.
Dialogue: 0,1:11:32.70,1:11:34.24,Default,,0,0,0,,Сұрақтарыңыз бар ма?
Dialogue: 0,1:11:36.16,1:11:39.37,Default,,0,0,0,,Менің ұрысқа қатысы жоқ сұрағым бар, бірақ бұл дұрыс па?
Dialogue: 0,1:11:39.50,1:11:40.58,Default,,0,0,0,,Маңызды емес
Dialogue: 0,1:11:40.71,1:11:42.75,Default,,0,0,0,,Бүгін кешке кеш тоқтатыла ма?
Dialogue: 0,1:11:43.00,1:11:44.55,Default,,0,0,0,,Сіз мұны қайталайсыз ба?
Dialogue: 0,1:11:44.67,1:11:48.84,Default,,0,0,0,,Бұл жақтың балалары екі айда бір келеді.
Dialogue: 0,1:11:48.97,1:11:50.13,Default,,0,0,0,,Бүгін түн
Dialogue: 0,1:11:50.26,1:11:53.35,Default,,0,0,0,,Ха, кешіріңіз, мен мұны білмедім.
Dialogue: 0,1:11:53.85,1:11:57.10,Default,,0,0,0,,Біз операцияны тоқтатқан жоқпыз. Операция өте құпия.
Dialogue: 0,1:11:57.22,1:12:00.39,Default,,0,0,0,,Біз қазір бас тартуды жариялай алмаймыз.
Dialogue: 0,1:12:02.06,1:12:04.86,Default,,0,0,0,,Құсанаги мырза, сізде қосымша ақпарат бар ма?
Dialogue: 0,1:12:05.77,1:12:08.49,Default,,0,0,0,,Теңізде шығар
Dialogue: 0,1:12:09.40,1:12:13.95,Default,,0,0,0,,Біздің майдандық базамызға шабуыл жасалса, қарсы тарап міндетті түрде әрекет етеді.
Dialogue: 0,1:12:14.45,1:12:16.87,Default,,0,0,0,,Бәлкім, сізді достық жойғыш ұшағы айдап әкеткен шығар?
Dialogue: 0,1:12:16.99,1:12:19.12,Default,,0,0,0,,зениттік оқпен жоғары көздеуге болмайды
Dialogue: 0,1:12:19.25,1:12:20.91,Default,,0,0,0,,Өзімді күштеп алсам да сені итеремін.
Dialogue: 0,1:12:21.42,1:12:25.38,Default,,0,0,0,,Бұл жауынгерлік эскадрилья үшін әдеттен тыс ұзақ қашықтыққа шабуыл жасау миссиясы.
Dialogue: 0,1:12:26.00,1:12:29.55,Default,,0,0,0,,Қысқа аяқты Санка тобы әуеден жанармай алады.
Dialogue: 0,1:12:29.97,1:12:32.43,Default,,0,0,0,,Қосымша резервуарларды соңғы минутқа дейін лақтырмаңыз.
Dialogue: 0,1:12:32.93,1:12:33.97,Default,,0,0,0,,Бар болғаны
Dialogue: 0,1:12:36.60,1:12:38.97,Default,,0,0,0,,Сонымен 20 минуттан кейін ұшу-қону жолағында
Dialogue: 0,1:13:17.64,1:13:20.02,Default,,0,0,0,,(сигнал дыбысы)
Dialogue: 0,1:14:36.01,1:14:39.01,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:16:48.93,1:16:50.93,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,1:17:05.24,1:17:06.66,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:17:14.12,1:17:17.00,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:17:39.44,1:17:41.44,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,1:17:45.66,1:17:47.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:20:16.47,1:20:19.48,Default,,0,0,0,,Ұстаз, қайдасыз?
Dialogue: 0,1:20:19.73,1:20:20.98,Default,,0,0,0,,Ол кішкентайынан бері Бүкіл Құдірет-ты еліктеп,
Dialogue: 0,1:20:38.45,1:20:40.71,Default,,0,0,0,,Ондағылар да азайды.
Dialogue: 0,1:20:41.79,1:20:43.83,Default,,0,0,0,,Сіз оның құлағанын көрдіңіз бе?
Dialogue: 0,1:20:44.79,1:20:46.00,Default,,0,0,0,,Қайсы?
Dialogue: 0,1:20:56.26,1:20:58.97,Default,,0,0,0,,Кишинума машинасының астынан Скайли шығады.
Dialogue: 0,1:20:59.10,1:21:01.98,Default,,0,0,0,,Кишинума машинасының артына қалдық...
Dialogue: 0,1:21:02.10,1:21:04.56,Default,,0,0,0,,кезінде мен кенеттен жарты орам жасадым.
Dialogue: 0,1:21:04.90,1:21:07.98,Default,,0,0,0,,Жоғары қарап, дүңгіршекті айналдыр.
Dialogue: 0,1:21:08.11,1:21:11.40,Default,,0,0,0,,Мен артымнан қолдау көрсетуге тырысқан Куматаке машинасының жанынан өткенде,
Dialogue: 0,1:21:11.53,1:21:15.53,Default,,0,0,0,,Сырттай алға қарай домалап, оны диагональ бойынша жабыңыз...
Dialogue: 0,1:21:16.12,1:21:17.53,Default,,0,0,0,,Бұл жақын қашықтықта болды.
Dialogue: 0,1:21:17.99,1:21:20.95,Default,,0,0,0,,Мүмкін, Санканың Шинода машинасы дәл осындай әдісті қолданады...
Dialogue: 0,1:21:21.79,1:21:24.62,Default,,0,0,0,,Бұл үлгіде қара пантера белгісі бар еді.
Dialogue: 0,1:21:29.96,1:21:32.97,Default,,0,0,0,,Жұмысымыз біткен соң, біз білмейтін қалаға барайық.
Dialogue: 0,1:21:38.68,1:21:41.18,Default,,0,0,0,,(трамвай қоңырауы)
Dialogue: 0,1:21:48.06,1:21:50.32,Default,,0,0,0,,Дүкен немесе бір нәрсе бар ма?
Dialogue: 0,1:21:52.44,1:21:54.49,Default,,0,0,0,,Келесі аялдамада түсуім керек пе?
Dialogue: 0,1:21:59.70,1:22:02.70,Default,,0,0,0,,♪～ (фортепиано оркестрінің музыкасы)
Dialogue: 0,1:23:04.14,1:23:07.14,Default,,0,0,0,,Әлі осыншама ұзақ болса да, ерте
Dialogue: 0,1:23:07.77,1:23:09.94,Default,,0,0,0,,Әдепті қала ғой, солай емес пе?
Dialogue: 0,1:23:11.15,1:23:13.48,Default,,0,0,0,,Бұл неге ұқсайды?
Dialogue: 0,1:23:24.45,1:23:26.58,Default,,0,0,0,,Бұл тағы бір сәйкестік.
Dialogue: 0,1:23:27.83,1:23:29.12,Default,,0,0,0,,Боулинг?
Dialogue: 0,1:23:29.37,1:23:32.21,Default,,0,0,0,,Мен сыра ішермін деп ойладым.
Dialogue: 0,1:23:35.01,1:23:39.18,Default,,0,0,0,,Қандай ұят! Бос орынға ұмтылайық!
Dialogue: 0,1:24:13.84,1:24:16.38,Default,,0,0,0,,Сіз нені айтасыз? Бұл
Dialogue: 0,1:24:16.76,1:24:18.13,Default,,0,0,0,,Токино
Dialogue: 0,1:24:23.34,1:24:26.51,Default,,0,0,0,,Хмм... Иә!
Dialogue: 0,1:24:32.65,1:24:33.52,Default,,0,0,0,,♬~
Dialogue: 0,1:24:35.40,1:24:37.36,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:24:38.07,1:24:39.07,Default,,0,0,0,,Әй?
Dialogue: 0,1:24:44.82,1:24:46.24,Default,,0,0,0,,Фу…
Dialogue: 0,1:24:49.29,1:24:51.25,Default,,0,0,0,,(ауызекі поляк)
Dialogue: 0,1:24:51.37,1:24:52.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:53.17,1:24:55.42,Default,,0,0,0,,(ауызекі поляк)
Dialogue: 0,1:24:57.67,1:24:59.26,Default,,0,0,0,,Каннамидің кезегі
Dialogue: 0,1:25:22.24,1:25:24.66,Default,,0,0,0,,(Әйелдердің күлкісі)
Dialogue: 0,1:25:25.03,1:25:26.83,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,1:25:27.12,1:25:28.54,Default,,0,0,0,,Алда~
Dialogue: 0,1:25:32.54,1:25:37.34,Default,,0,0,0,,Әйелдерді осылай сапқа тұрғызып, қолымнан келгенше допты лақтырғым келеді.
Dialogue: 0,1:25:39.00,1:25:40.38,Default,,0,0,0,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,1:25:41.38,1:25:45.18,Default,,0,0,0,,Қызметкерлерден жақсы мейрамхана туралы сұраңыз және тағы біраз сусындар ішейік.
Dialogue: 0,1:25:50.01,1:25:52.23,Default,,0,0,0,,♪~ (бейбіт фортепиано пьесасы)
Dialogue: 0,1:26:01.28,1:26:03.49,Default,,0,0,0,,Мен енді іше алмаймын
Dialogue: 0,1:26:06.20,1:26:07.78,Default,,0,0,0,,Өйткені мен оны ішемін
Dialogue: 0,1:26:19.00,1:26:21.96,Default,,0,0,0,,Өткен күні неге соншалықты шектен шыққан нәрсе істедің?
Dialogue: 0,1:26:23.84,1:26:26.18,Default,,0,0,0,,Үлгіде қара пантера белгісі болғандықтан ба?
Dialogue: 0,1:26:27.72,1:26:31.01,Default,,0,0,0,,Ол біздің компанияда жұмыс істеген.
Dialogue: 0,1:26:31.14,1:26:32.22,Default,,0,0,0,,(Джунпей) Тағы айтамын: шегін, сиқыршы.
Dialogue: 0,1:26:33.02,1:26:35.06,Default,,0,0,0,,Бұл өте сыпайы түрде айтылады.
Dialogue: 0,1:26:35.94,1:26:37.40,Default,,0,0,0,,Өйткені ол менің бастығым болды
Dialogue: 0,1:26:38.15,1:26:41.44,Default,,0,0,0,,Ол ұшқыш ретінде ерекше.
Dialogue: 0,1:26:41.94,1:26:45.86,Default,,0,0,0,,Ол кәдімгі ересек адам, есейген адам.
Dialogue: 0,1:26:47.20,1:26:48.87,Default,,0,0,0,,Неліктен бұл компанияны таңдадыңыз?
Dialogue: 0,1:26:50.28,1:26:54.45,Default,,0,0,0,,Мен әртүрлі себептерге байланысты компаниямды тастадым.
Dialogue: 0,1:26:54.95,1:26:57.83,Default,,0,0,0,,Мұғалімді атып түсірсем, бірдеңе өзгере ме?
Dialogue: 0,1:26:57.96,1:26:59.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:59.21,1:27:03.30,Default,,0,0,0,,Тағдыр мен шек сияқты нәрселер бар.
Dialogue: 0,1:27:04.55,1:27:05.97,Default,,0,0,0,,Иә.
Dialogue: 0,1:27:07.18,1:27:09.47,Default,,0,0,0,,Бірақ ол ешкімнің көңілін қалдырмайды
Dialogue: 0,1:27:09.59,1:27:10.60,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,1:27:13.01,1:27:16.60,Default,,0,0,0,,Біз кіммен және қайда соғысып жатырмыз деп ойлайсыңдар?
Dialogue: 0,1:27:16.85,1:27:19.19,Default,,0,0,0,,Енді мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,1:27:19.31,1:27:21.23,Default,,0,0,0,,Бірін-бірі өлтіріп жатса да?
Dialogue: 0,1:27:21.36,1:27:22.65,Default,,0,0,0,,Бұл жұмыс.
Dialogue: 0,1:27:23.32,1:27:25.69,Default,,0,0,0,,Бұл кез келген кәсіппен бірдей.
Dialogue: 0,1:27:26.07,1:27:29.20,Default,,0,0,0,,Қарсыласын итеріп, пайда тапқан адам жеңеді.
Dialogue: 0,1:27:30.20,1:27:33.58,Default,,0,0,0,,Қарапайым компаниялармен салыстырғанда біз не істейміз
Dialogue: 0,1:27:33.70,1:27:36.25,Default,,0,0,0,,Бұл тиімсіз және жай ғана ностальгиялық ойын.
Dialogue: 0,1:27:36.37,1:27:37.37,Default,,0,0,0,,Иә
Dialogue: 0,1:27:37.50,1:27:41.88,Default,,0,0,0,,Бұл ойын, сондықтан заңды түрде өлтіруге және өлтіруге болады.
Dialogue: 0,1:27:42.38,1:27:43.88,Default,,0,0,0,,Бұл қызықты идея.
Dialogue: 0,1:27:44.00,1:27:45.42,Default,,0,0,0,,«Қызықты»?
Dialogue: 0,1:27:47.05,1:27:51.59,Default,,0,0,0,,Соғыс ешбір дәуірде толығымен жойылған емес.
Dialogue: 0,1:27:51.72,1:27:56.06,Default,,0,0,0,,Өйткені шындық әрқашан адамдар үшін маңызды болды.
Dialogue: 0,1:27:56.43,1:28:01.35,Default,,0,0,0,,Әлі де сол дәуірде әлдекім бір жерде төбелесіп жүрген шындық сезімі бар.
Dialogue: 0,1:28:01.48,1:28:05.23,Default,,0,0,0,,Өйткені ол адам қоғамы жүйесінің маңызды элементі болып табылады
Dialogue: 0,1:28:05.36,1:28:08.57,Default,,0,0,0,,Бұл өтіріктен құралуы мүмкін емес.
Dialogue: 0,1:28:08.99,1:28:11.03,Default,,0,0,0,,Соғыс қандай?
Dialogue: 0,1:28:11.16,1:28:15.45,Default,,0,0,0,,Тарих оқулықтарындағы халық ертегілері жеткіліксіз.
Dialogue: 0,1:28:15.99,1:28:20.21,Default,,0,0,0,,Шынымен өліп жатқан адамдар бар және бұл туралы хабарлануда.
Dialogue: 0,1:28:20.33,1:28:24.67,Default,,0,0,0,,Қайшылықты көрсетпесек, тыныштықты сақтай алмаймыз.
Dialogue: 0,1:28:25.09,1:28:27.67,Default,,0,0,0,,Бейбітшіліктің мәнін де тани алмайсың.
Dialogue: 0,1:28:28.01,1:28:30.63,Default,,0,0,0,,Аспанда бір-бірімізді өлтірмесек
Dialogue: 0,1:28:30.76,1:28:34.22,Default,,0,0,0,,Біз сияқты сен де тірі сезіне алмайсың.
Dialogue: 0,1:28:35.47,1:28:38.06,Default,,0,0,0,,Ал біздің соғыс
Dialogue: 0,1:28:38.18,1:28:41.14,Default,,0,0,0,,Бұл ешқашан аяқталмауы керек ойын
Dialogue: 0,1:28:41.27,1:28:43.65,Default,,0,0,0,,Ол үшін ережелер қажет
Dialogue: 0,1:28:44.31,1:28:48.48,Default,,0,0,0,,Мысалы, ешқашан жеңбейтін жаудың болуы.
Dialogue: 0,1:28:49.90,1:28:52.28,Default,,0,0,0,,Бұл мұғалім ме?
Dialogue: 0,1:28:56.49,1:28:57.49,Default,,0,0,0,,(бөтелкені қою дыбысы)
Dialogue: 0,1:29:22.19,1:29:23.56,Default,,0,0,0,,Сіз тым көп ішесіз бе?
Dialogue: 0,1:29:25.56,1:29:27.65,Default,,0,0,0,,(Ағып жатқан судың дыбысы)
Dialogue: 0,1:29:32.90,1:29:35.91,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:30:03.39,1:30:05.94,Default,,0,0,0,,(шинаның сықырлаған дыбысы)
Dialogue: 0,1:30:10.40,1:30:12.53,Default,,0,0,0,,(Ерлердің мазақ еткен дауыстары)
Dialogue: 0,1:30:23.33,1:30:24.91,Default,,0,0,0,,Сені өлтіргенімді қалайсың ба?
Dialogue: 0,1:30:25.12,1:30:26.42,Default,,0,0,0,,(Балға ату дыбысы)
Dialogue: 0,1:30:28.84,1:30:31.88,Default,,0,0,0,,Әлде мені өлтіресің бе?
Dialogue: 0,1:30:33.34,1:30:37.22,Default,,0,0,0,,Әйтпесе біз мәңгі осылай қаламыз.
Dialogue: 0,1:31:21.18,1:31:24.22,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,1:31:51.92,1:31:55.63,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,1:32:03.14,1:32:05.01,Default,,0,0,0,,Екі ұшақ қайтып келді?
Dialogue: 0,1:32:05.81,1:32:09.06,Default,,0,0,0,,Бүгіннен бастап ол Сомеакамен аралас эскадрон болады ма?
Dialogue: 0,1:32:09.23,1:32:11.27,Default,,0,0,0,,Бұл қозғалтқыштың бір ерекшелігі бар.
Dialogue: 0,1:32:11.40,1:32:15.36,Default,,0,0,0,,Мен қос қозғалтқыштармен тәжірибесі бар Локта Хага мен Никиді қостым.
Dialogue: 0,1:32:35.50,1:32:37.51,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,1:32:51.10,1:32:53.31,Default,,0,0,0,,Эй, жігітім (Токино)?
Dialogue: 0,1:32:56.36,1:32:57.73,Default,,0,0,0,,Андайо
Dialogue: 0,1:32:58.28,1:33:00.15,Default,,0,0,0,,Бұл қандай бала?
Dialogue: 0,1:33:00.36,1:33:02.45,Default,,0,0,0,,Құсанағы руының қызы.
Dialogue: 0,1:33:02.70,1:33:06.28,Default,,0,0,0,,Қызым? Менің қызым кімнің баласы?
Dialogue: 0,1:33:06.53,1:33:08.45,Default,,0,0,0,,Өсек-аяң көп, солай ма?
Dialogue: 0,1:33:42.49,1:33:43.49,Default,,0,0,0,,Кім?
Dialogue: 0,1:33:44.53,1:33:46.95,Default,,0,0,0,,Мен мұнда тағайындалған ұшқышпын.
Dialogue: 0,1:33:47.37,1:33:48.70,Default,,0,0,0,,Мен Каннамимін
Dialogue: 0,1:33:48.83,1:33:51.79,Default,,0,0,0,,Бұл Айхара. Мұнда қанша ұшқыш бар?
Dialogue: 0,1:33:52.08,1:33:54.79,Default,,0,0,0,,Сізді және бастықты қосқанда 7 адам болуы мүмкін.
Dialogue: 0,1:33:54.92,1:33:55.75,Default,,0,0,0,,Иә
Dialogue: 0,1:34:16.52,1:34:17.61,Default,,0,0,0,,Не?
Dialogue: 0,1:34:17.73,1:34:21.86,Default,,0,0,0,,Жоқ, мен газеттерді осылай бүктеген біреу бар деп ойладым.
Dialogue: 0,1:34:21.98,1:34:23.03,Default,,0,0,0,,Иә
Dialogue: 0,1:34:27.32,1:34:29.74,Default,,0,0,0,,(орындықтан тұру дыбысы)
Dialogue: 0,1:34:30.08,1:34:33.00,Default,,0,0,0,,(Айхараның ізі)
Dialogue: 0,1:34:34.50,1:34:36.00,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:34:45.26,1:34:50.26,Default,,0,0,0,,♪～ (музыкалық қорап әні)
Dialogue: 0,1:36:10.01,1:36:13.80,Default,,0,0,0,,~♪
Dialogue: 0,1:36:30.24,1:36:31.49,Default,,0,0,0,,Фу…
Dialogue: 0,1:36:32.70,1:36:33.74,Default,,0,0,0,,Сасакура мырза
Dialogue: 0,1:36:33.87,1:36:34.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:34.83,1:36:36.91,Default,,0,0,0,,Құсанағы мырзамен қашаннан бері таныссыз?
Dialogue: 0,1:36:37.04,1:36:40.33,Default,,0,0,0,,Міне, 8 жыл өтті.
Dialogue: 0,1:36:40.46,1:36:43.75,Default,,0,0,0,,Сонда мен оны эйс кезінде білетінмін.
Dialogue: 0,1:36:44.00,1:36:45.00,Default,,0,0,0,,Жақсы.
Dialogue: 0,1:36:45.29,1:36:48.01,Default,,0,0,0,,Енді жақсы ма?
Dialogue: 0,1:36:49.38,1:36:51.59,Default,,0,0,0,,«Бұл» деген не?
Dialogue: 0,1:36:53.84,1:36:55.60,Default,,0,0,0,,Бұл адам банкрот.
Dialogue: 0,1:36:55.72,1:36:59.93,Default,,0,0,0,,Менің ойымша, ол өз жұмысын қалыпты атқарып жатқан сияқты.
Dialogue: 0,1:37:00.06,1:37:02.14,Default,,0,0,0,,Сол адам дүниеге бала әкелді.
Dialogue: 0,1:37:02.73,1:37:03.56,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:37:03.69,1:37:05.48,Default,,0,0,0,,Бала туды.
Dialogue: 0,1:37:05.61,1:37:06.44,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:37:06.57,1:37:07.44,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,1:37:07.57,1:37:08.40,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:37:08.53,1:37:11.11,Default,,0,0,0,,Барлығы түсінбегендей кейіп танытады.
Dialogue: 0,1:37:11.24,1:37:12.61,Default,,0,0,0,,Білмейтіндей кейіп таныту
Dialogue: 0,1:37:12.74,1:37:16.16,Default,,0,0,0,,Бала туралы компанияның өзі білуі керек.
Dialogue: 0,1:37:16.33,1:37:17.79,Default,,0,0,0,,Құсанаги Хане!
Dialogue: 0,1:37:21.87,1:37:23.92,Default,,0,0,0,,Өйткені ол ерекше эйс болды
Dialogue: 0,1:37:24.04,1:37:27.96,Default,,0,0,0,,Достарыңыздан сәл ұзақ өмір сүріңіз және өмір сүріңіз
Dialogue: 0,1:37:28.50,1:37:31.88,Default,,0,0,0,,Мүмкіндігінше қараңыз және ойлаңыз
Dialogue: 0,1:37:32.34,1:37:36.35,Default,,0,0,0,,Өзімнің де, өзгенің де тағдырына араласуды үйрендім.
Dialogue: 0,1:37:36.76,1:37:40.18,Default,,0,0,0,,Сіз жақсы көретін адамды өлтіре аласыз ба? Бұл да кедергі ме?
Dialogue: 0,1:37:40.47,1:37:41.81,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,1:37:42.10,1:37:43.14,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,1:38:05.29,1:38:06.96,Default,,0,0,0,,Каннамиге шығайық~
Dialogue: 0,1:38:07.08,1:38:08.38,Default,,0,0,0,,Кусумидің орны?
Dialogue: 0,1:38:08.50,1:38:09.50,Default,,0,0,0,,О
Dialogue: 0,1:38:09.75,1:38:11.59,Default,,0,0,0,,Фукоға сәлем айтыңыз.
Dialogue: 0,1:38:14.76,1:38:16.18,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:38:17.80,1:38:18.93,Default,,0,0,0,,Я...
Dialogue: 0,1:38:21.06,1:38:22.18,Default,,0,0,0,,Хмм...
Dialogue: 0,1:38:24.02,1:38:25.19,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:38:25.60,1:38:26.60,Default,,0,0,0,,Не?
Dialogue: 0,1:38:26.73,1:38:30.32,Default,,0,0,0,,Каннами-кунмен бүгінгі кешке кездесуді жасаған адам
Dialogue: 0,1:38:32.07,1:38:34.70,Default,,0,0,0,,Құсанағы мырза болса, тоқтау керек.
Dialogue: 0,1:38:36.16,1:38:39.07,Default,,0,0,0,,Бұл Мицуя мырза болуы мүмкін емес, солай ма?
Dialogue: 0,1:38:39.20,1:38:42.45,Default,,0,0,0,,Тағы да ойлан, жаман сөз айтпаймын.
Dialogue: 0,1:38:42.58,1:38:45.33,Default,,0,0,0,,Қызық, бұл екеуінің несі қауіпті?
Dialogue: 0,1:38:45.46,1:38:48.25,Default,,0,0,0,,Бұл анық. Құсанаги мырзамен ұйықтап көріңіз.
Dialogue: 0,1:38:48.38,1:38:52.63,Default,,0,0,0,,Міне, басыңа оқ тиіп, қош болдың.
Dialogue: 0,1:38:52.76,1:38:53.92,Default,,0,0,0,,Мицуя мырза ше?
Dialogue: 0,1:38:54.38,1:38:57.55,Default,,0,0,0,,Құмырсқа тозағы сияқты, құтыла алмайсың.
Dialogue: 0,1:38:58.05,1:38:59.55,Default,,0,0,0,,Тағы не айта аламын?
Dialogue: 0,1:39:02.81,1:39:05.48,Default,,0,0,0,,Саған бас иемін деген ойым жоқ, бірақ
Dialogue: 0,1:39:05.60,1:39:08.60,Default,,0,0,0,,Дос ретінде бұл мен бере алатын ең жақсы кеңес.
Dialogue: 0,1:39:08.73,1:39:11.15,Default,,0,0,0,,Аа, бүгін түнде абай болыңыз.
Dialogue: 0,1:39:11.27,1:39:12.44,Default,,0,0,0,,Рахмет
Dialogue: 0,1:39:12.73,1:39:17.11,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:39:26.12,1:39:27.25,Default,,0,0,0,,
Dialogue: 0,1:39:27.37,1:39:28.46,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:39:28.83,1:39:31.34,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,1:39:32.75,1:39:34.09,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:39:36.26,1:39:37.80,Default,,0,0,0,,Менде тек кофе бар
Dialogue: 0,1:39:37.93,1:39:40.09,Default,,0,0,0,,Қаласаңыз, үстел үстіндегі қазанда.
Dialogue: 0,1:39:46.56,1:39:48.56,Default,,0,0,0,,(Кофені құю дыбысы)
Dialogue: 0,1:40:02.28,1:40:05.33,Default,,0,0,0,,Жақсы, мен сені сыртқа шықтым деп ойладым.
Dialogue: 0,1:40:05.54,1:40:07.20,Default,,0,0,0,,Токино сыртқа шықты
Dialogue: 0,1:40:07.41,1:40:09.16,Default,,0,0,0,,Ересек әйелмен ойнау?
Dialogue: 0,1:40:09.29,1:40:10.29,Default,,0,0,0,,Иә
Dialogue: 0,1:40:10.83,1:40:12.33,Default,,0,0,0,,Неге қалдың?
Dialogue: 0,1:40:12.63,1:40:14.04,Default,,0,0,0,,Менің бір болжамым бар еді.
Dialogue: 0,1:40:14.84,1:40:16.96,Default,,0,0,0,,Мен саған қонаққа келемін деген ойың бар ма?
Dialogue: 0,1:40:17.21,1:40:19.38,Default,,0,0,0,,Мен онша мақтаншақ емеспін.
Dialogue: 0,1:40:19.84,1:40:22.26,Default,,0,0,0,,Мен бүгін кешке өз бөлмемде қалуым керек сияқты.
Dialogue: 0,1:40:22.68,1:40:24.05,Default,,0,0,0,,Бұл өте дәл.
Dialogue: 0,1:40:24.18,1:40:25.72,Default,,0,0,0,,Каннами осында келді...
Dialogue: 0,1:40:25.85,1:40:28.52,Default,,0,0,0,,Сіз бұл базаға қанша уақыттан бері тағайындалдыңыз?
Dialogue: 0,1:40:28.77,1:40:31.56,Default,,0,0,0,,Жаздың аяғына таман болса керек.
Dialogue: 0,1:40:31.69,1:40:34.57,Default,,0,0,0,,Бұған дейін? Ұшу қанша уақытты алады?
Dialogue: 0,1:40:34.69,1:40:37.40,Default,,0,0,0,,Қанша жыл истребитель ұшқышы болдыңыз?
Dialogue: 0,1:40:37.94,1:40:39.99,Default,,0,0,0,,Сіз бұл туралы сөйлесуге келдіңіз бе?
Dialogue: 0,1:40:40.99,1:40:43.16,Default,,0,0,0,,Сіз бұл негізде ең сенімді адамсыз.
Dialogue: 0,1:40:43.28,1:40:44.66,Default,,0,0,0,,Сондықтан сұрағым келеді
Dialogue: 0,1:40:44.78,1:40:48.25,Default,,0,0,0,,Өз сезімдеріңізді қалай ұйымдастырасыз?
Dialogue: 0,1:40:48.37,1:40:51.29,Default,,0,0,0,,Қазіргі және өткеннің бірдей естеліктерін қайталау...
Dialogue: 0,1:40:51.42,1:40:53.75,Default,,0,0,0,,Олар қалай байланысқан?
Dialogue: 0,1:40:54.92,1:40:57.88,Default,,0,0,0,,Мен оны елестетіп жатырмын, бірақ мен өте ұмытшақ болып кеткен шығармын.
Dialogue: 0,1:40:58.01,1:40:59.42,Default,,0,0,0,,Армандау сияқты
Dialogue: 0,1:40:59.55,1:41:02.38,Default,,0,0,0,,Бұлыңғыр эмоциялар рухты қорғауы керек.
Dialogue: 0,1:41:02.51,1:41:07.31,Default,,0,0,0,,Кешегі, өткен ай және өткен жылдың айырмашылығы жоқ.
Dialogue: 0,1:41:07.43,1:41:10.18,Default,,0,0,0,,Дәл солай сияқты, басқаша ма деп ойлаймын
Dialogue: 0,1:41:10.48,1:41:13.19,Default,,0,0,0,,Мен туралы болса, бұл дұрыс.
Dialogue: 0,1:41:13.65,1:41:16.57,Default,,0,0,0,,Кішкентай кезімнен солай.
Dialogue: 0,1:41:16.69,1:41:20.07,Default,,0,0,0,,Мен ес-түссіз қалдым, не ояу, не ұйықтап жатқанымды білмеймін.
Dialogue: 0,1:41:20.19,1:41:21.49,Default,,0,0,0,,Жақсы айтылған
Dialogue: 0,1:41:21.61,1:41:23.78,Default,,0,0,0,,Өзіңізге сенімді емессіз бе?
Dialogue: 0,1:41:25.45,1:41:29.58,Default,,0,0,0,,Сіз Kildre біздің компанияның өнім атауы екенін білесіз бе?
Dialogue: 0,1:41:29.70,1:41:34.08,Default,,0,0,0,,Сіз кенеттен генді бақылау агентін жасаудың ортасында дүниеге келдіңіз.
Dialogue: 0,1:41:34.21,1:41:36.75,Default,,0,0,0,,Жаңа дәріге берілуі тиіс атау болды
Dialogue: 0,1:41:36.88,1:41:38.96,Default,,0,0,0,,сізді көрсетуге келді
Dialogue: 0,1:41:39.09,1:41:41.01,Default,,0,0,0,,Сіз басқаша айтасыз.
Dialogue: 0,1:41:41.22,1:41:43.51,Default,,0,0,0,,Балалар сендер қартаймайсыңдар.
Dialogue: 0,1:41:43.63,1:41:45.30,Default,,0,0,0,,Мәңгілік өмір сүр
Dialogue: 0,1:41:45.59,1:41:49.56,Default,,0,0,0,,Бұл туралы алғашында ешкім білмеді; білсе де, сенбеді.
Dialogue: 0,1:41:49.68,1:41:52.18,Default,,0,0,0,,Бірақ бірте-бірте қауесет тарады
Dialogue: 0,1:41:52.31,1:41:55.15,Default,,0,0,0,,Ұрыста өлмесе өлмейтін адамдар бар дейді!
Dialogue: 0,1:41:57.06,1:41:58.52,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:41:58.82,1:42:00.78,Default,,0,0,0,,Қызық, мен де Килдремін бе?
Dialogue: 0,1:42:00.90,1:42:03.36,Default,,0,0,0,,Менің айтқанымды қайдан естідің?
Dialogue: 0,1:42:03.49,1:42:06.03,Default,,0,0,0,,Мұны не үшін оқыдың? Бұл рас па?
Dialogue: 0,1:42:06.16,1:42:09.95,Default,,0,0,0,,Бәрі қалай болса да бөлшектеніп кеткендей.
Dialogue: 0,1:42:10.20,1:42:13.37,Default,,0,0,0,,Мен өз басымнан өткен нәрсе екеніне сенімді емеспін.
Dialogue: 0,1:42:13.50,1:42:15.62,Default,,0,0,0,,Ешқандай жауап жоқ
Dialogue: 0,1:42:17.13,1:42:19.34,Default,,0,0,0,,Мен жалғыз Килледр емеспін
Dialogue: 0,1:42:19.46,1:42:22.17,Default,,0,0,0,,Бұл ыңғайлы оқиға емес.
Dialogue: 0,1:42:22.42,1:42:24.76,Default,,0,0,0,,Мен қашаннан бері ұшақта болдым?
Dialogue: 0,1:42:25.26,1:42:27.34,Default,,0,0,0,,Сіз қашаннан бастап адамдарды өлтіре бастадыңыз?
Dialogue: 0,1:42:27.55,1:42:30.97,Default,,0,0,0,,Бұл неліктен, қашан және қайда болды?
Dialogue: 0,1:42:31.10,1:42:32.85,Default,,0,0,0,,Мен бұл туралы күнде түнде ойлаймын
Dialogue: 0,1:42:34.23,1:42:35.69,Default,,0,0,0,,Э?
Dialogue: 0,1:42:36.23,1:42:37.90,Default,,0,0,0,,Э?
Dialogue: 0,1:42:38.31,1:42:41.82,Default,,0,0,0,,Қанша ойласам да, бала кезімде...
Dialogue: 0,1:42:41.94,1:42:44.99,Default,,0,0,0,,Кейбір көріністерден басқа ештеңе есімде жоқ.
Dialogue: 0,1:42:45.74,1:42:49.37,Default,,0,0,0,,(Мицуяның айқайы)
Dialogue: 0,1:42:59.54,1:43:02.55,Default,,0,0,0,,Балалармен ойнағанды ұнататын сияқтысыз ба?
Dialogue: 0,1:43:04.63,1:43:07.76,Default,,0,0,0,,Мен бұрынғы базамда еріктімен кездестім.
Dialogue: 0,1:43:07.89,1:43:10.93,Default,,0,0,0,,Сізге орын беріп, бізге көмектескеніңіз үшін рахмет.
Dialogue: 0,1:43:12.01,1:43:13.93,Default,,0,0,0,,Мен балаларды көргенді ұнатамын.
Dialogue: 0,1:43:14.06,1:43:17.10,Default,,0,0,0,,Менің де балалық шағым болғанын қалаймын.
Dialogue: 0,1:43:17.56,1:43:19.06,Default,,0,0,0,,Мүмкін
Dialogue: 0,1:43:19.19,1:43:22.07,Default,,0,0,0,,Мүмкін мен осылай туған шығармын, солай ма?
Dialogue: 0,1:43:22.19,1:43:25.03,Default,,0,0,0,,Мен өспеген шығармын деп ойлаймын.
Dialogue: 0,1:43:25.15,1:43:28.74,Default,,0,0,0,,Менің аяғым енді жерге тимейтіндей... сен солай ойлайсың ба?
Dialogue: 0,1:43:28.86,1:43:31.53,Default,,0,0,0,,Сіз алаңдайсыз ба?
Dialogue: 0,1:43:33.20,1:43:36.96,Default,,0,0,0,,Құсанаги мырза Джиро деген адамды атып тастаған шығар.
Dialogue: 0,1:43:37.08,1:43:40.79,Default,,0,0,0,,Менің ойымша, сіз оны аяқтауға тырыстыңыз.
Dialogue: 0,1:43:42.75,1:43:45.01,Default,,0,0,0,,Бірақ ол өлген жоқ
Dialogue: 0,1:43:45.13,1:43:46.47,Default,,0,0,0,,Өлген жоқсың ба?
Dialogue: 0,1:43:46.80,1:43:48.34,Default,,0,0,0,,Себебі мен саған айналдым
Dialogue: 0,1:43:48.93,1:43:51.60,Default,,0,0,0,,Басқа адам ретінде қайта жаңғыр
Dialogue: 0,1:43:51.72,1:43:55.31,Default,,0,0,0,,Сіз жаңа естеліктерді есте сақтау үшін жаратылғансыз.
Dialogue: 0,1:43:55.68,1:43:57.81,Default,,0,0,0,,Сіз Джинроның реинкарнациясысыз
Dialogue: 0,1:43:57.94,1:43:58.94,Default,,0,0,0,,Егер сіз
Dialogue: 0,1:43:59.06,1:44:02.65,Default,,0,0,0,,Оның ұшқыш ретіндегі ноу-хауы жоғалады.
Dialogue: 0,1:44:02.90,1:44:05.61,Default,,0,0,0,,Өйткені қару ретінде орындау жоғалады.
Dialogue: 0,1:44:06.61,1:44:09.20,Default,,0,0,0,,Мұны неге бәрі байқамайды?
Dialogue: 0,1:44:09.57,1:44:11.70,Default,,0,0,0,,Байқамағандай кейіппен
Dialogue: 0,1:44:12.07,1:44:15.37,Default,,0,0,0,,Сіз байқамайынша мен білмеймін деп жүрмін
Dialogue: 0,1:44:16.04,1:44:17.70,Default,,0,0,0,,Бұл қызық идея.
Dialogue: 0,1:44:18.37,1:44:19.79,Default,,0,0,0,,Кофе ше?
Dialogue: 0,1:44:22.96,1:44:25.67,Default,,0,0,0,,Дәмді болды, рахмет
Dialogue: 0,1:44:25.80,1:44:26.88,Default,,0,0,0,,Мен де
Dialogue: 0,1:44:27.09,1:44:29.97,Default,,0,0,0,,Бұл қызықты оқиға болды, рахмет
Dialogue: 0,1:44:31.97,1:44:35.97,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:44:50.28,1:44:52.11,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:44:57.16,1:44:59.16,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:45:03.63,1:45:04.88,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:45:08.42,1:45:10.34,Default,,0,0,0,,Мылтықты тастағаныңыз жөн.
Dialogue: 0,1:45:12.22,1:45:15.51,Default,,0,0,0,,Әлде сен маған мылтық бересің бе?
Dialogue: 0,1:45:16.01,1:45:17.89,Default,,0,0,0,,Бұл менің мылтығым
Dialogue: 0,1:45:19.18,1:45:20.52,Default,,0,0,0,,Олай болса маған қарызға бер.
Dialogue: 0,1:45:20.98,1:45:22.10,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,1:45:24.10,1:45:27.94,Default,,0,0,0,,Мен сенің орныңа Құсанағы мырзаны атып тастаймын.
Dialogue: 0,1:45:29.65,1:45:30.90,Default,,0,0,0,,Жақсы идея
Dialogue: 0,1:45:31.86,1:45:33.86,Default,,0,0,0,,А... а...
Dialogue: 0,1:46:00.60,1:46:03.19,Default,,0,0,0,,Шық, Мицуя.
Dialogue: 0,1:46:05.73,1:46:07.94,Default,,0,0,0,,Мен өлгім келсе, өлуім керек пе?
Dialogue: 0,1:46:09.94,1:46:11.44,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:46:16.03,1:46:17.12,Default,,0,0,0,,Фу…
Dialogue: 0,1:46:27.67,1:46:29.84,Default,,0,0,0,,Темекі шегуге бола ма?
Dialogue: 0,1:46:30.67,1:46:33.51,Default,,0,0,0,,Өтінемін, бұл сіздің бөлмеңіз.
Dialogue: 0,1:46:36.59,1:46:38.35,Default,,0,0,0,,Джиро Куританы өлтірдің бе?
Dialogue: 0,1:46:39.47,1:46:40.47,Default,,0,0,0,,Иә
Dialogue: 0,1:46:43.68,1:46:45.35,Default,,0,0,0,,Ол менің оны өлтіргенімді қалады ма?
Dialogue: 0,1:46:45.48,1:46:46.48,Default,,0,0,0,,Иә
Dialogue: 0,1:46:47.35,1:46:48.86,Default,,0,0,0,,Сен оны жақсы көрдің бе?
Dialogue: 0,1:46:49.19,1:46:50.44,Default,,0,0,0,,Фу…
Dialogue: 0,1:46:51.73,1:46:52.73,Default,,0,0,0,,Иә
Dialogue: 0,1:46:54.57,1:46:55.70,Default,,0,0,0,,Каннами
Dialogue: 0,1:46:58.62,1:47:00.74,Default,,0,0,0,,Сол мылтықпен мені атып таста
Dialogue: 0,1:47:01.20,1:47:02.70,Default,,0,0,0,,Мен, сен?
Dialogue: 0,1:47:02.99,1:47:06.96,Default,,0,0,0,,Иә, енді сен мені өлтірдің.
Dialogue: 0,1:47:08.63,1:47:09.79,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,1:47:19.55,1:47:21.05,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:47:27.64,1:47:31.40,Default,,0,0,0,,Бір нәрсені өзгерте алғанша өмір сүр.
Dialogue: 0,1:47:33.57,1:47:34.82,Default,,0,0,0,,(мылтық құлаған дыбыс)
Dialogue: 0,1:47:54.84,1:47:59.05,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:48:24.41,1:48:28.04,Default,,0,0,0,,♪~ (қатты барабан сезімі бар ән)
Dialogue: 0,1:49:01.99,1:49:04.82,Default,,0,0,0,,♪～ (фортепиано оркестрінің музыкасы)
Dialogue: 0,1:50:27.03,1:50:31.24,Default,,0,0,0,,Әрдайым жүретін бір жолда да, жаяу жүргенде әр түрлі жерлерді басуға болады.
Dialogue: 0,1:50:32.79,1:50:36.67,Default,,0,0,0,,Сіз әрқашан жүретін жол болғандықтан, табиғат көрінісі бірдей емес
Dialogue: 0,1:50:38.59,1:50:40.59,Default,,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,1:50:42.46,1:50:44.26,Default,,0,0,0,,Мұның бәрі бар ...
Dialogue: 0,1:50:45.68,1:50:47.01,Default,,0,0,0,,Дұрыс емес пе?
Dialogue: 0,1:50:51.68,1:50:53.89,Default,,0,0,0,,~♪
Dialogue: 0,1:51:17.79,1:51:22.67,Default,,0,0,0,,Сіз әрқашан жүретін жол болғандықтан, пейзаж бірдей емес
Dialogue: 0,1:51:23.51,1:51:26.63,Default,,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,1:51:46.49,1:51:48.15,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,1:52:39.91,1:52:46.84,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:52:51.38,1:52:52.93,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,1:53:51.44,1:53:53.45,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,1:54:18.14,1:54:19.26,Default,,0,0,0,,Хмм...
Dialogue: 0,1:55:38.93,1:55:41.26,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,1:56:05.87,1:56:09.87,Default,,0,0,0,,♪~
Dialogue: 0,2:00:09.95,2:00:14.45,Default,,0,0,0,,~♪
Dialogue: 0,2:00:16.16,2:00:19.00,Default,,0,0,0,,(Ұшақтың ұшу дыбысы)
Dialogue: 0,2:00:20.63,2:00:24.00,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,2:01:04.38,2:01:05.59,Default,,0,0,0,,(сіріңкені соққан дыбыс)
Dialogue: 0,2:01:06.92,2:01:08.13,Default,,0,0,0,,(сіріңкені бұзу дыбысы)
Dialogue: 0,2:01:18.60,2:01:20.48,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,2:01:20.60,2:01:21.73,Default,,0,0,0,,Уф, ыстық қой! Демім тарылып барады!
Dialogue: 0,2:01:21.85,2:01:23.77,Default,,0,0,0,,Өтінемін (есіктің ашылған дыбысы)
Dialogue: 0,2:01:25.56,2:01:26.77,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,2:01:31.95,2:01:35.32,Default,,0,0,0,,Менің атым Хираги Исаму, мен бүгін тағайындалдым.
Dialogue: 0,2:01:39.37,2:01:41.00,Default,,0,0,0,,Бұл сутегі Құсанаги.
Dialogue: 0,2:01:41.75,2:01:43.46,Default,,0,0,0,,Мен сені күттім
Dialogue: 0,2:01:44.96,2:01:50.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
