Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.63,0:00:16.63,Default,,0,0,0,,Алхимияның мәнін жинақтау арқылы пысықталады
Dialogue: 0,0:00:17.00,0:00:19.60,Default,,0,0,0,,Табиғаттан тыс қорытпалы негізгі темір
Dialogue: 0,0:00:20.80,0:00:23.83,Default,,0,0,0,,Ол адамның жауынгерлік инстинкті арқылы белсендіріледі.
Dialogue: 0,0:00:24.20,0:00:27.10,Default,,0,0,0,,Оған ие болған адам оның жасырын күшін формаға айналдырады.
Dialogue: 0,0:00:27.66,0:00:30.00,Default,,0,0,0,,Бірегей қару жасаңыз
Dialogue: 0,0:00:31.36,0:00:34.36,Default,,0,0,0,,Бұл Бусу Рекин.
Dialogue: 0,0:00:37.43,0:00:42.20,Default,,0,0,0,,Oh…Oh…Da…
Dialogue: 0,0:00:42.63,0:00:48.83,Default,,0,0,0,,О... О... Да... сенімен
Dialogue: 0,0:00:49.26,0:00:58.26,Default,,0,0,0,,Тоқтауға уақытым жоқ, Ойлануға уақытым жоқ.
Dialogue: 0,0:00:59.76,0:01:09.06,Default,,0,0,0,,Жүрегімде бар сезіммен, Қайнаған шайқасқа аттанамын
Dialogue: 0,0:01:11.20,0:01:15.70,Default,,0,0,0,,Биліктің тым үлкен қабырғасы, дүниенің қараңғылығы
Dialogue: 0,0:01:16.33,0:01:21.36,Default,,0,0,0,,Мен міндетті түрде жеңілемін, шектен тыс
Dialogue: 0,0:01:22.03,0:01:26.66,Default,,0,0,0,,Дәл қазір түсінбейтін нәрселерім көп.
Dialogue: 0,0:01:27.10,0:01:31.93,Default,,0,0,0,,Өзіңіз сенетін осы жолмен жүріңіз
Dialogue: 0,0:01:32.40,0:01:37.50,Default,,0,0,0,,Қандай жау, қандай одақтас болғаның маңызды емес.
Dialogue: 0,0:01:37.76,0:01:44.03,Default,,0,0,0,,Қолымды жібересің бе? Қып-қызыл ант
Dialogue: 0,0:01:46.13,0:01:50.83,Default,,0,0,0,,Мен сені мәңгілікке қуамын
Dialogue: 0,0:01:51.36,0:01:56.23,Default,,0,0,0,,Бүкіл жол, барлық жол, Ертеңгі күнге батылдық
Dialogue: 0,0:01:56.56,0:02:02.63,Default,,0,0,0,,Мәңгілік өзіңмен бірге оттайтын жүрегім
Dialogue: 0,0:02:11.13,0:02:13.43,Default,,0,0,0,,Викторға жаппай шабуыл басталды.
Dialogue: 0,0:02:14.06,0:02:17.73,Default,,0,0,0,,Алхимик жауынгерлер өздерінің қарулы алхимиясын толық пайдаланады.
Dialogue: 0,0:02:18.16,0:02:19.70,Default,,0,0,0,,Викторды іздеңіз
Dialogue: 0,0:02:21.70,0:02:24.90,Default,,0,0,0,,Бірақ Виктор үшінші кезеңге өтті.
Dialogue: 0,0:02:25.26,0:02:27.16,Default,,0,0,0,,Оның шын күшін көрсету
Dialogue: 0,0:02:31.70,0:02:35.40,Default,,0,0,0,,Осы кезде Казуки мен оның достары Ньютон Apple қыздар орта мектебіне келеді.
Dialogue: 0,0:02:35.86,0:02:41.96,Default,,0,0,0,,Олар Викторға айналған Казукиді қайтадан адамға айналдырған ақ ядролық темірге келді.
Dialogue: 0,0:02:43.90,0:02:44.56,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:02:52.30,0:02:56.36,Default,,0,0,0,,Ақ ядролық темірді аяқтау үшін бірнеше күн қажет.
Dialogue: 0,0:02:59.86,0:03:02.40,Default,,0,0,0,,Шешім қабылдамас бұрын мұқият ойланыңыз.
Dialogue: 0,0:03:05.70,0:03:07.63,Default,,0,0,0,,Бір қорқынышты нәрсе болды.
Dialogue: 0,0:03:08.03,0:03:11.66,Default,,0,0,0,,Бірақ сізде опциялар болғанша, сіз әлі де бақыттысыз.
Dialogue: 0,0:03:39.53,0:03:42.03,Default,,0,0,0,,Әй, оқу күні сондай әбігер.
Dialogue: 0,0:03:42.40,0:03:44.43,Default,,0,0,0,,Жазғы демалыс болса да
Dialogue: 0,0:03:45.06,0:03:45.70,Default,,0,0,0,,Үлпілдек
Dialogue: 0,0:03:46.30,0:03:46.73,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:47.46,0:03:48.86,Default,,0,0,0,,О, ақыры келді.
Dialogue: 0,0:03:49.23,0:03:51.80,Default,,0,0,0,,Ескерту қоңырауы соғылып тұрса да, асығуға тырыспайсыз ба?
Dialogue: 0,0:03:52.53,0:03:53.96,Default,,0,0,0,,Әй, біраз уақыт болды.
Dialogue: 0,0:03:54.96,0:03:55.70,Default,,0,0,0,,Таку
Dialogue: 0,0:03:56.13,0:03:58.00,Default,,0,0,0,,-Казуки Токико-сан -Казуки Токико-сан
Dialogue: 0,0:03:58.36,0:03:59.43,Default,,0,0,0,,Мияу
Dialogue: 0,0:03:59.50,0:04:01.86,Default,,0,0,0,,Асықпасаң, үйге кешігіп қаласың.
Dialogue: 0,0:04:03.33,0:04:04.73,Default,,0,0,0,,Сонда қалай болды?
Dialogue: 0,0:04:04.93,0:04:05.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:06.03,0:04:08.33,Default,,0,0,0,,Екеуінің қарым-қатынасы ілгерілей ме?
Dialogue: 0,0:04:08.66,0:04:10.40,Default,,0,0,0,,А? Не болып жатыр?
Dialogue: 0,0:04:10.76,0:04:13.13,Default,,0,0,0,,Бұл туралы анық айтқаныңыз жөн, Токико мырза.
Dialogue: 0,0:04:13.20,0:04:13.73,Default,,0,0,0,,Эй
Dialogue: 0,0:04:14.40,0:04:14.96,Default,,0,0,0,,Дио бар Каирға дейін шамамен 800 шақырым
Dialogue: 0,0:04:15.60,0:04:16.80,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,0:04:16.86,0:04:18.76,Default,,0,0,0,,Уау ахаха
Dialogue: 0,0:04:18.83,0:04:20.33,Default,,0,0,0,,Хмм, мен сені үрлеймін.
Dialogue: 0,0:04:20.60,0:04:22.33,Default,,0,0,0,,-Ахахаха Ахахха -Ой, мен сені үрлеймін!
Dialogue: 0,0:04:25.63,0:04:26.43,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:04:26.80,0:04:27.86,Default,,0,0,0,,Генки Джогоку
Dialogue: 0,0:04:28.30,0:04:30.46,Default,,0,0,0,,Менде уайым жоқ сияқты
Dialogue: 0,0:04:31.13,0:04:33.23,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:04:33.43,0:04:38.20,Default,,0,0,0,,Казукин ешнәрсе істеген жоқ. Ол тек абыроймен адам болып оралуы керек.
Dialogue: 0,0:04:38.50,0:04:39.36,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:04:39.76,0:04:44.06,Default,,0,0,0,,Жаман емес, ол осы мектеп пен қаланы қайта-қайта қорғады.
Dialogue: 0,0:04:44.33,0:04:44.86,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:46.33,0:04:47.10,Default,,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,0:04:48.03,0:04:49.76,Default,,0,0,0,,Өйткені ол сондай бала
Dialogue: 0,0:04:50.40,0:04:53.40,Default,,0,0,0,,Казуки Викторды жалғыз қалдыра алмайды.
Dialogue: 0,0:04:54.20,0:04:56.80,Default,,0,0,0,,Ол өте күшті бала.
Dialogue: 0,0:04:57.10,0:04:57.66,Default,,0,0,0,,О
Dialogue: 0,0:04:58.43,0:05:01.30,Default,,0,0,0,,Ол шынымен де жауынгер болып туылған сияқты.
Dialogue: 0,0:05:01.90,0:05:04.70,Default,,0,0,0,,Бұдан былай ақыл да, тән де күшейеді.
Dialogue: 0,0:05:05.03,0:05:05.46,Default,,0,0,0,,Ах ха
Dialogue: 0,0:05:06.93,0:05:07.40,Default,,0,0,0,,Бірақ
Dialogue: 0,0:05:10.86,0:05:14.76,Default,,0,0,0,,Сонда да мен 17 жастағы мектеп оқушысымын.
Dialogue: 0,0:05:23.36,0:05:25.26,Default,,0,0,0,,-Рас, мен қайттым -Уау
Dialogue: 0,0:05:25.33,0:05:26.16,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:05:26.23,0:05:27.66,Default,,0,0,0,,О, Махиро, мен үйдемін.
Dialogue: 0,0:05:27.83,0:05:29.26,Default,,0,0,0,,- Токико-сан - Уау
Dialogue: 0,0:05:29.73,0:05:31.63,Default,,0,0,0,,Әй, үлкен аға да үйде.
Dialogue: 0,0:05:32.03,0:05:32.76,Default,,0,0,0,,О
Dialogue: 0,0:05:34.16,0:05:34.86,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:05:35.00,0:05:37.60,Default,,0,0,0,,Көріп тұрсам да, үнемі уайымдайтынмын.
Dialogue: 0,0:05:37.90,0:05:38.33,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:05:38.90,0:05:43.00,Default,,0,0,0,,Сіз аман-есен оралғандықтан, тапсырма сәтті аяқталды.
Dialogue: 0,0:05:43.23,0:05:43.66,Default,,0,0,0,,О
Dialogue: 0,0:05:46.53,0:05:49.60,Default,,0,0,0,,Міне, бүгін таңертең мектеп бітеді.
Dialogue: 0,0:05:49.93,0:05:51.60,Default,,0,0,0,,Осыдан кейін бәріміз сыртқа шығайық.
Dialogue: 0,0:05:52.13,0:05:53.50,Default,,0,0,0,,Жақсы идея
Dialogue: 0,0:05:53.76,0:05:56.03,Default,,0,0,0,,Токико екеуің де келе аласыңдар, солай ма?
Dialogue: 0,0:05:56.36,0:05:56.90,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:57.26,0:05:58.50,Default,,0,0,0,,Сонда қайда бара жатырсың?
Dialogue: 0,0:05:58.73,0:06:00.43,Default,,0,0,0,,Мен ойын-сауық саябағына барғым келеді
Dialogue: 0,0:06:00.73,0:06:02.36,Default,,0,0,0,,Жақсы ойын-сауық саябағы
Dialogue: 0,0:06:02.70,0:06:03.53,Default,,0,0,0,,Бассейн туралы не деуге болады?
Dialogue: 0,0:06:03.90,0:06:04.70,Default,,0,0,0,,Жақсы болуы мүмкін
Dialogue: 0,0:06:04.96,0:06:05.50,Default,,0,0,0,,О
Dialogue: 0,0:06:06.10,0:06:08.40,Default,,0,0,0,,Бірақ қала бассейнінде мектеп бассейні жоқ, солай ма?
Dialogue: 0,0:06:08.56,0:06:09.70,Default,,0,0,0,,Кадзуки-кун?
Dialogue: 0,0:06:10.30,0:06:12.06,Default,,0,0,0,,Боулинг те жақсы болуы мүмкін.
Dialogue: 0,0:06:12.30,0:06:13.40,Default,,0,0,0,,Өткізілетін орын т.б.
Dialogue: 0,0:06:13.66,0:06:15.90,Default,,0,0,0,,Мм, бұл ойын-сауық саябағы ғой.
Dialogue: 0,0:06:16.23,0:06:18.90,Default,,0,0,0,,Ааа, саған ойын-сауық саябақтары қатты ұнайды.
Dialogue: 0,0:06:19.06,0:06:21.13,Default,,0,0,0,,Нені жасыруым керек? Мен де сені жақсы көремін.
Dialogue: 0,0:06:21.20,0:06:22.46,Default,,0,0,0,,Ахаха ахаха
Dialogue: 0,0:06:29.46,0:06:30.36,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:30.63,0:06:32.10,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:06:32.63,0:06:35.06,Default,,0,0,0,,Егер біз қазір соғысып жатқан Викторды жеңсек.
Dialogue: 0,0:06:35.36,0:06:37.90,Default,,0,0,0,,Келесіде Кадзуки Мутоның қайта өлтірілуі күтіп тұр.
Dialogue: 0,0:06:38.36,0:06:39.53,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:06:39.76,0:06:40.33,Default,,0,0,0,,Уф
Dialogue: 0,0:06:40.40,0:06:40.83,Default,,0,0,0,,Уф
Dialogue: 0,0:06:41.36,0:06:42.83,Default,,0,0,0,,Эй, жібер.
Dialogue: 0,0:06:43.20,0:06:43.63,Default,,0,0,0,,Уф
Dialogue: 0,0:06:45.66,0:06:46.90,Default,,0,0,0,,Хиватари жауынгерінің басшысы
Dialogue: 0,0:06:47.53,0:06:48.00,Default,,0,0,0,,Не?
Dialogue: 0,0:06:48.70,0:06:51.60,Default,,0,0,0,,7-ші бөлім мен 8-ші бөлімше дерлік жойылды.
Dialogue: 0,0:06:52.23,0:06:54.26,Default,,0,0,0,,Екінші дәрежелі жауынгерлік орналастыруды шығару
Dialogue: 0,0:06:54.56,0:06:56.30,Default,,0,0,0,,Бірден толқын шабуылымен
Dialogue: 0,0:06:56.53,0:06:59.43,Default,,0,0,0,,Бастер Баронды қолдауға оралу туралы бұйрықтар шығарылды.
Dialogue: 0,0:07:00.73,0:07:02.86,Default,,0,0,0,,О, сенің кезегің.
Dialogue: 0,0:07:03.00,0:07:04.03,Default,,0,0,0,,Орналастыруға қоса беріледі
Dialogue: 0,0:07:04.60,0:07:06.93,Default,,0,0,0,,Бусудзима, штаб-пәтерге бір рет оралыңыз.
Dialogue: 0,0:07:07.03,0:07:07.56,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:07:07.80,0:07:08.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:09.06,0:07:11.90,Default,,0,0,0,,Викторды жеңу үшін Мутоны пайдалану кезінде
Dialogue: 0,0:07:12.06,0:07:13.83,Default,,0,0,0,,Мен онымен біткенімде, мені қайтадан өлтіресің бе?
Dialogue: 0,0:07:15.00,0:07:16.86,Default,,0,0,0,,Сонда не істеу керек?
Dialogue: 0,0:07:17.23,0:07:17.80,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:07:18.23,0:07:20.56,Default,,0,0,0,,Төртінші және бесінші сөздер айтылған жерден бір нәрсе басталады ма?
Dialogue: 0,0:07:21.23,0:07:24.83,Default,,0,0,0,,Дәл қазір біздің жалғыз шындығымыз – алдымызда тұрған жауды өлтіру.
Dialogue: 0,0:07:26.23,0:07:27.16,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:07:30.73,0:07:33.93,Default,,0,0,0,,Ақыр соңында қайсысын бірінші орындағаныңыз маңызды емес.
Dialogue: 0,0:07:34.80,0:07:37.30,Default,,0,0,0,,Мен сол қарғыс атқан баланы дәл сол кезде өлтірсем ғой.
Dialogue: 0,0:07:37.60,0:07:39.60,Default,,0,0,0,,Бұл соншалықты күрделі болмауы керек.
Dialogue: 0,0:07:39.80,0:07:40.56,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:07:41.33,0:07:42.43,Default,,0,0,0,,Бұл абсурд.
Dialogue: 0,0:07:42.96,0:07:44.60,Default,,0,0,0,,Біз өмір сүріп жатқан әлем қандай?
Dialogue: 0,0:07:45.56,0:07:46.30,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:46.76,0:07:49.00,Default,,0,0,0,,Мен де қазір алдымдағы жауға шоғырланып отырмын.
Dialogue: 0,0:07:49.76,0:07:53.13,Default,,0,0,0,,Дегенмен, одан кейін не болатынын ойланамын.
Dialogue: 0,0:07:53.60,0:07:55.36,Default,,0,0,0,,Бұл сындарлы түсініктеме.
Dialogue: 0,0:07:55.96,0:07:56.46,Default,,0,0,0,,Сәлем
Dialogue: 0,0:08:01.60,0:08:02.30,Default,,0,0,0,,Муто
Dialogue: 0,0:08:02.83,0:08:04.20,Default,,0,0,0,,Мен ешқашан берілмеймін
Dialogue: 0,0:08:15.06,0:08:15.86,Default,,0,0,0,,Токико-сан
Dialogue: 0,0:08:16.30,0:08:19.56,Default,,0,0,0,,Алдымен біз кетеміз, сондықтан Казукиді күте аласыз ба?
Dialogue: 0,0:08:19.90,0:08:21.73,Default,,0,0,0,,Хехе, мен вокзалда күтемін.
Dialogue: 0,0:08:22.06,0:08:22.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:22.93,0:08:25.76,Default,,0,0,0,,Жақсы, бірақ бәрі бірге барса жақсы емес пе?
Dialogue: 0,0:08:26.23,0:08:28.03,Default,,0,0,0,,Жарайды, мен сұрадым.
Dialogue: 0,0:08:28.23,0:08:29.30,Default,,0,0,0,,Кейін кездескенше.
Dialogue: 0,0:08:29.36,0:08:31.33,Default,,0,0,0,,Не істеп жатырсың, Миста?
Dialogue: 0,0:08:32.40,0:08:32.83,Default,,0,0,0,,Иә
Dialogue: 0,0:08:42.76,0:08:46.80,Default,,0,0,0,,Сіз аман-есен оралғандықтан, тапсырма сәтті аяқталды.
Dialogue: 0,0:08:47.00,0:08:47.53,Default,,0,0,0,,О
Dialogue: 0,0:08:50.36,0:08:52.53,Default,,0,0,0,,Мен өтірік айттым.
Dialogue: 0,0:08:53.30,0:08:54.46,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:08:54.53,0:08:54.96,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:55.36,0:08:57.13,Default,,0,0,0,,Қажетсіз алаңдаушылық тудырудың орнына
Dialogue: 0,0:08:57.63,0:08:58.16,Default,,0,0,0,,Гота
Dialogue: 0,0:08:58.60,0:09:02.46,Default,,0,0,0,,Мені үлкен сыныпта оқитын бала мектептен қалды ма деп уайымдадым.
Dialogue: 0,0:09:02.93,0:09:05.73,Default,,0,0,0,,Әпкең мен достарың жақсы адамдар.
Dialogue: 0,0:09:11.40,0:09:13.40,Default,,0,0,0,,Қандай таңдау жасасаңыз да
Dialogue: 0,0:09:14.23,0:09:17.26,Default,,0,0,0,,Егер сіз ағаңызды ешқашан ренжітпеуге уәде берсеңіз
Dialogue: 0,0:09:18.06,0:09:20.06,Default,,0,0,0,,Мен саған қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:09:20.66,0:09:21.10,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:09:22.93,0:09:26.60,Default,,0,0,0,,Қорғауымыз бірдей болса, біз қаруласпыз.
Dialogue: 0,0:09:27.03,0:09:27.60,Default,,0,0,0,,Гота
Dialogue: 0,0:09:29.53,0:09:30.60,Default,,0,0,0,,Қол алыспаңыз
Dialogue: 0,0:09:31.50,0:09:34.40,Default,,0,0,0,,Қарсылас болсақ та, Махаббатта бақталаспыз.
Dialogue: 0,0:09:36.63,0:09:37.06,Default,,0,0,0,,Әй
Dialogue: 0,0:09:43.10,0:09:45.10,Default,,0,0,0,,Бұл әйелде не жақсы?
Dialogue: 0,0:09:45.16,0:09:45.60,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:09:46.03,0:09:46.46,Default,,0,0,0,,Ах
Dialogue: 0,0:09:46.53,0:09:48.83,Default,,0,0,0,,Бұл қазірдің өзінде біраз қиял.
Dialogue: 0,0:09:49.60,0:09:50.23,Default,,0,0,0,,Чоно
Dialogue: 0,0:09:50.46,0:09:51.13,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:51.40,0:09:52.23,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:09:52.73,0:09:55.36,Default,,0,0,0,,Мен сені содан бері келмеген шығар деп ойладым.
Dialogue: 0,0:09:56.16,0:09:58.13,Default,,0,0,0,,Осы уақытқа дейін қайда және не істедің?
Dialogue: 0,0:09:58.60,0:10:02.46,Default,,0,0,0,,Әрине, құпия зертханада ақ ядролық темірді зерттеу.
Dialogue: 0,0:10:02.73,0:10:05.50,Default,,0,0,0,,Сіз тағы бір ақ ядролық темір жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:10:05.90,0:10:07.26,Default,,0,0,0,,Менің мақсатым
Dialogue: 0,0:10:07.83,0:10:11.06,Default,,0,0,0,,Ең жақсы мен, көбелек адам Кадзуки Мутоны жеңеді.
Dialogue: 0,0:10:11.80,0:10:14.76,Default,,0,0,0,,Ол үшін ақ ядролық темір өте қажет.
Dialogue: 0,0:10:15.06,0:10:17.03,Default,,0,0,0,,Бірақ, Александрия-сан.
Dialogue: 0,0:10:17.63,0:10:21.66,Default,,0,0,0,,Қара ядролық темірді тазартып, нөлден бастаңыз.
Dialogue: 0,0:10:21.96,0:10:24.36,Default,,0,0,0,,Басқасын жасауға қанша уақыт кетеді?
Dialogue: 0,0:10:25.60,0:10:27.63,Default,,0,0,0,,Қара ядролық темірді алу әдісі
Dialogue: 0,0:10:27.90,0:10:30.00,Default,,0,0,0,,Ол жүз жыл бұрын жоғалған.
Dialogue: 0,0:10:30.76,0:10:33.63,Default,,0,0,0,,Осы ескі мидан 100% көбею
Dialogue: 0,0:10:34.36,0:10:36.93,Default,,0,0,0,,Өкінішке орай, бұл мүмкін емес.
Dialogue: 0,0:10:38.43,0:10:40.63,Default,,0,0,0,,Мм, адам болған кезім.
Dialogue: 0,0:10:41.23,0:10:44.43,Default,,0,0,0,,Кездескен әрбір дәрігер маған қанша өмір сүруім керектігін айтып берді.
Dialogue: 0,0:10:44.93,0:10:47.26,Default,,0,0,0,,Бірақ қазір осылай.
Dialogue: 0,0:10:47.80,0:10:52.80,Default,,0,0,0,,Таңдауды бізге басқалар бермейді, өзіміз жасайды.
Dialogue: 0,0:10:53.23,0:10:55.86,Default,,0,0,0,,Муто Сіз қалай шешсеңіз де
Dialogue: 0,0:10:56.33,0:10:59.00,Default,,0,0,0,,Мен сізбен мәселені шешуден бас тартпаймын.
Dialogue: 0,0:10:59.56,0:11:01.23,Default,,0,0,0,,Бұл қару.
Dialogue: 0,0:11:05.36,0:11:06.30,Default,,0,0,0,,Токико-сан
Dialogue: 0,0:11:07.10,0:11:08.20,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:11:09.33,0:11:10.23,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:11:10.73,0:11:11.33,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:11.70,0:11:13.30,Default,,0,0,0,,Иә? А, бұл ештеңе емес
Dialogue: 0,0:11:13.83,0:11:14.90,Default,,0,0,0,,Барлығы ше?
Dialogue: 0,0:11:15.33,0:11:18.20,Default,,0,0,0,,Мен алға шықтым. Асықсам, тез жетемін.
Dialogue: 0,0:11:18.73,0:11:20.53,Default,,0,0,0,,Түсіндім, онда барайық.
Dialogue: 0,0:11:26.26,0:11:27.23,Default,,0,0,0,,Күн ыстық.
Dialogue: 0,0:11:27.90,0:11:30.30,Default,,0,0,0,,Иә? Ааа
Dialogue: 0,0:11:31.70,0:11:32.36,Default,,0,0,0,,Казуки
Dialogue: 0,0:11:33.03,0:11:35.86,Default,,0,0,0,,Осындай уақытта жақсысың ба?
Dialogue: 0,0:11:36.43,0:11:36.93,Default,,0,0,0,,Сіз
Dialogue: 0,0:11:37.80,0:11:38.36,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:39.36,0:11:41.76,Default,,0,0,0,,Жарайды, егер солай десеңіз.
Dialogue: 0,0:11:42.30,0:11:43.80,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:11:45.50,0:11:45.93,Default,,0,0,0,,Кеттік
Dialogue: 0,0:11:46.00,0:11:46.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:57.50,0:11:58.96,Default,,0,0,0,,Аспан көгілдір.
Dialogue: 0,0:11:59.96,0:12:02.56,Default,,0,0,0,,Иә, биыл мезгілсіз ыстық.
Dialogue: 0,0:12:12.03,0:12:12.70,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:12.83,0:12:13.46,Default,,0,0,0,,Хум хехе
Dialogue: 0,0:12:13.56,0:12:14.93,Default,,0,0,0,,Иә, сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:12:15.16,0:12:15.60,Default,,0,0,0,,Иә
Dialogue: 0,0:12:17.13,0:12:18.53,Default,,0,0,0,,Иә, Токико-сан.
Dialogue: 0,0:12:19.16,0:12:20.86,Default,,0,0,0,,О, мен оны аяқтай алмаймын.
Dialogue: 0,0:12:22.26,0:12:22.73,Default,,0,0,0,,Әй
Dialogue: 0,0:12:26.83,0:12:27.66,Default,,0,0,0,,Мм.
Dialogue: 0,0:12:27.73,0:12:28.60,Default,,0,0,0,,Хехехе
Dialogue: 0,0:12:29.23,0:12:29.80,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:30.30,0:12:34.93,Default,,0,0,0,,Бұрын Махиро екеуміз жазда қырылған мұз жейтінбіз.
Dialogue: 0,0:12:36.53,0:12:37.96,Default,,0,0,0,,Қауын, өйткені мен адаммын
Dialogue: 0,0:12:38.40,0:12:39.93,Default,,0,0,0,,Махиро Ичиго деген қыз
Dialogue: 0,0:12:40.76,0:12:43.16,Default,,0,0,0,,Бірақ Махиро оның да қауын жегісі келетінін айтты.
Dialogue: 0,0:12:43.46,0:12:46.83,Default,,0,0,0,,Мен оны тамақтандыруым керек еді, бірақ ол Ван Пис-ге төгілді.
Dialogue: 0,0:12:48.23,0:12:51.86,Default,,0,0,0,,Сосын Махиро жылай бастады, мен оны тыныштандыруға тырыстым.
Dialogue: 0,0:12:52.53,0:12:55.80,Default,,0,0,0,,Сіз жылауды тоқтатқанша қырылған мұздың екеуі де еріп кетеді.
Dialogue: 0,0:12:58.30,0:13:01.10,Default,,0,0,0,,Біз әрқашан жақын ағайынды болдық.
Dialogue: 0,0:13:01.56,0:13:02.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:03.70,0:13:04.40,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:13:08.20,0:13:10.93,Default,,0,0,0,,Мен Казукидің өткені туралы бірінші рет естіп тұрмын.
Dialogue: 0,0:13:11.43,0:13:12.86,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:13:13.40,0:13:16.83,Default,,0,0,0,,Адамдардың бұлай айтқанын тыңдау қандай да бір сергітеді.
Dialogue: 0,0:13:17.66,0:13:19.63,Default,,0,0,0,,Менде бар нәрсе қазір
Dialogue: 0,0:13:20.10,0:13:20.90,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:22.00,0:13:23.50,Default,,0,0,0,,Менің өткенім жоқ
Dialogue: 0,0:13:24.23,0:13:28.13,Default,,0,0,0,,Дәрігер бұл шок салдарынан ішінара есте сақтау қабілетінің жоғалуы сияқты екенін айтады.
Dialogue: 0,0:13:28.83,0:13:31.86,Default,,0,0,0,,Сондықтан болар, өткен естеліктерім бұлыңғыр.
Dialogue: 0,0:13:32.86,0:13:34.26,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:34.63,0:13:36.46,Default,,0,0,0,,Менің әңгімем қазір жақсы.
Dialogue: 0,0:13:37.06,0:13:38.43,Default,,0,0,0,,Әйтеуір айтып тұрғаным осы.
Dialogue: 0,0:13:39.13,0:13:41.70,Default,,0,0,0,,Менің ойымша, қазір ғана емес.
Dialogue: 0,0:13:42.33,0:13:43.53,Default,,0,0,0,,Мен өткенді жасай алмаймын, бірақ
Dialogue: 0,0:13:44.46,0:13:47.00,Default,,0,0,0,,Мен болашақты Токико-санмен көргім келеді.
Dialogue: 0,0:13:47.36,0:13:49.53,Default,,0,0,0,,...
Dialogue: 0,0:13:50.13,0:13:54.06,Default,,0,0,0,,Дұрыс, мен де сенімен бірге болашақты көргім келеді.
Dialogue: 0,0:13:55.53,0:13:56.03,Default,,0,0,0,,Сіз ұялшақсыз ба?
Dialogue: 0,0:13:56.36,0:13:59.23,Default,,0,0,0,,Шулы, олай айтпа.
Dialogue: 0,0:13:59.30,0:14:01.30,Default,,0,0,0,,-     -
Dialogue: 0,0:14:01.76,0:14:02.70,Default,,0,0,0,,Иә
Dialogue: 0,0:14:03.10,0:14:05.30,Default,,0,0,0,,Ауырды.
Dialogue: 0,0:14:05.36,0:14:07.33,Default,,0,0,0,,Аа, мен осындай жерде болдым.
Dialogue: 0,0:14:07.60,0:14:08.03,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:14:08.60,0:14:10.70,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:14:11.20,0:14:13.23,Default,,0,0,0,,Екеуің бірге күліп жатырсыңдар деп ойладым.
Dialogue: 0,0:14:13.56,0:14:15.03,Default,,0,0,0,,«Делон» сөзі қай мезгіл?
Dialogue: 0,0:14:15.36,0:14:17.96,Default,,0,0,0,,Кешіріңіз, кешіріңіз, мен жаңа ғана шөп жедім.
Dialogue: 0,0:14:18.26,0:14:20.63,Default,,0,0,0,,Бірақ бұл жақсы қырылған мұз
Dialogue: 0,0:14:21.13,0:14:22.06,Default,,0,0,0,,Тамақ ішейік
Dialogue: 0,0:14:22.26,0:14:24.50,Default,,0,0,0,,Жоқ, бұл ертедегі ойын-сауық саябағы.
Dialogue: 0,0:14:24.90,0:14:26.73,Default,,0,0,0,,Сізге ойын-сауық саябақтары ұнай ма?
Dialogue: 0,0:14:27.30,0:14:29.23,Default,,0,0,0,,Мен жай ғана баламын
Dialogue: 0,0:14:29.40,0:14:32.76,Default,,0,0,0,,-Ахахаха Ахахха -Бала, бала
Dialogue: 0,0:14:33.30,0:14:35.73,Default,,0,0,0,,Кя
Dialogue: 0,0:14:43.40,0:14:46.96,Default,,0,0,0,,Әй, анашым
Dialogue: 0,0:14:47.80,0:14:49.30,Default,,0,0,0,,Ду ахахха
Dialogue: 0,0:14:49.76,0:14:51.03,Default,,0,0,0,,Уфуфуфуфу
Dialogue: 0,0:14:51.33,0:14:52.30,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:14:52.80,0:14:53.96,Default,,0,0,0,,Айналыңыз
Dialogue: 0,0:14:59.20,0:15:01.16,Default,,0,0,0,,Кяаааааааааааааааааааааа
Dialogue: 0,0:15:01.23,0:15:02.20,Default,,0,0,0,,Иә? Ой уау
Dialogue: 0,0:15:02.50,0:15:03.96,Default,,0,0,0,,Ахахахахаха
Dialogue: 0,0:15:05.46,0:15:06.33,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:15:06.60,0:15:08.66,Default,,0,0,0,,Ахахахахахха
Dialogue: 0,0:15:09.53,0:15:11.13,Default,,0,0,0,,Kya au
Dialogue: 0,0:15:11.43,0:15:12.40,Default,,0,0,0,,Окакура-кун?
Dialogue: 0,0:15:13.16,0:15:17.56,Default,,0,0,0,,Кя фу
Dialogue: 0,0:15:22.30,0:15:24.23,Default,,0,0,0,,Амансың ба? Окакура-кун
Dialogue: 0,0:15:24.50,0:15:27.43,Default,,0,0,0,,Ойын-сауық саябақтарын ұнату әдеті таңқаларлық нәзік.
Dialogue: 0,0:15:28.03,0:15:29.63,Default,,0,0,0,,Келесі жолы мен оны мінемін.
Dialogue: 0,0:15:30.20,0:15:31.93,Default,,0,0,0,,Кя
Dialogue: 0,0:15:32.70,0:15:33.66,Default,,0,0,0,,Кеттік, Токико-сан
Dialogue: 0,0:15:34.06,0:15:35.76,Default,,0,0,0,,Жоқ, менде бәрі жақсы.
Dialogue: 0,0:15:36.13,0:15:37.03,Default,,0,0,0,,Біраз уақыт демалыңыз
Dialogue: 0,0:15:37.63,0:15:39.83,Default,,0,0,0,,Иә? Окакура, кеттік.
Dialogue: 0,0:15:40.16,0:15:41.60,Default,,0,0,0,,Рокумасу Охама
Dialogue: 0,0:15:41.96,0:15:42.66,Default,,0,0,0,,О
Dialogue: 0,0:15:43.93,0:15:44.96,Default,,0,0,0,,Хмм хм/сағ
Dialogue: 0,0:15:45.76,0:15:49.56,Default,,0,0,0,,Ноаааааааааааааааааааааа
Dialogue: 0,0:15:49.76,0:15:51.53,Default,,0,0,0,,О, Окакура-кун?
Dialogue: 0,0:16:17.46,0:16:20.30,Default,,0,0,0,,Жарайды, келесі ұшатын кілемге барайық.
Dialogue: 0,0:16:21.40,0:16:23.93,Default,,0,0,0,,Иә
Dialogue: 0,0:16:24.66,0:16:27.23,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:16:27.60,0:16:28.70,Default,,0,0,0,,Сіз әлі барасыз ба?
Dialogue: 0,0:16:28.80,0:16:30.06,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:16:30.13,0:16:31.76,Default,,0,0,0,,Қараңдар, Токико-сан да барады.
Dialogue: 0,0:16:32.96,0:16:33.40,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:16:34.36,0:16:35.00,Default,,0,0,0,,О
Dialogue: 0,0:16:58.80,0:17:00.20,Default,,0,0,0,,Әй, келді, келді.
Dialogue: 0,0:17:00.83,0:17:02.90,Default,,0,0,0,,Мен оны аяқтай алмаймын. Сосын мен үйге барамын.
Dialogue: 0,0:17:03.10,0:17:04.93,Default,,0,0,0,,Мм, кештен кейін.
Dialogue: 0,0:17:05.00,0:17:06.00,Default,,0,0,0,,Караокеге барайық
Dialogue: 0,0:17:06.40,0:17:07.26,Default,,0,0,0,,Караоке?
Dialogue: 0,0:17:07.36,0:17:12.10,Default,,0,0,0,,Дұрыс, мен Токико-санға менің ыстық рок-н-роллымды тыңдауға рұқсат етемін.
Dialogue: 0,0:17:12.53,0:17:14.06,Default,,0,0,0,,Менде құлаққап бар.
Dialogue: 0,0:17:14.16,0:17:14.76,Default,,0,0,0,,Howaaaaaaaaaaaaaaaaaa
Dialogue: 0,0:17:14.83,0:17:16.30,Default,,0,0,0,,Неліктен сізде бұл бар?
Dialogue: 0,0:17:16.43,0:17:18.76,Default,,0,0,0,,Дәлірек айтсақ, сен неге құлаққап тағып жүрсің?
Dialogue: 0,0:17:18.93,0:17:21.23,Default,,0,0,0,,Ахахахаха аха
Dialogue: 0,0:17:21.83,0:17:24.53,Default,,0,0,0,,Кешіріңіз, мен үйге ертерек келемін.
Dialogue: 0,0:17:24.96,0:17:25.70,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:17:26.23,0:17:28.23,Default,,0,0,0,,Шаршадыңыз ба? Сенімен бәрі жақсы ма?
Dialogue: 0,0:17:28.50,0:17:28.93,Default,,0,0,0,,Иә
Dialogue: 0,0:17:29.93,0:17:31.63,Default,,0,0,0,,Бұл ақылдырақ болар еді.
Dialogue: 0,0:17:32.03,0:17:33.30,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:33.96,0:17:34.66,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:17:35.00,0:17:37.16,Default,,0,0,0,,-Ах -Фуу Әрине Токико барады.
Dialogue: 0,0:17:37.36,0:17:38.76,Default,,0,0,0,,Үйге бара алмайсың.
Dialogue: 0,0:17:38.93,0:17:39.46,Default,,0,0,0,,Иә
Dialogue: 0,0:17:39.66,0:17:41.46,Default,,0,0,0,,-хехехехе ахаха -а
Dialogue: 0,0:17:42.06,0:17:43.50,Default,,0,0,0,,Көріскенше, аға.
Dialogue: 0,0:17:43.80,0:17:44.63,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:17:45.06,0:17:46.06,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:17:46.43,0:17:47.50,Default,,0,0,0,,Суық тигізбе
Dialogue: 0,0:17:48.73,0:17:49.33,Default,,0,0,0,,О
Dialogue: 0,0:17:51.23,0:17:51.83,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:17:52.33,0:17:57.33,Default,,0,0,0,,-Ооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо
Dialogue: 0,0:17:57.50,0:17:58.70,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:18:20.13,0:18:22.20,Default,,0,0,0,,Мұны қалай шешуге болады
Dialogue: 0,0:18:22.93,0:18:25.26,Default,,0,0,0,,Казуки-кун, сен шешесің.
Dialogue: 0,0:18:25.86,0:18:28.03,Default,,0,0,0,,Қандай таңдау жасасаңыз да
Dialogue: 0,0:18:28.36,0:18:31.30,Default,,0,0,0,,Егер сіз ағаңызды ешқашан ренжітпеуге уәде берсеңіз
Dialogue: 0,0:18:32.03,0:18:34.13,Default,,0,0,0,,Мен саған қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:18:35.03,0:18:38.00,Default,,0,0,0,,Муто Сіз қалай шешсеңіз де
Dialogue: 0,0:18:38.36,0:18:40.83,Default,,0,0,0,,Мен сізбен мәселені шешуден бас тартпаймын.
Dialogue: 0,0:18:42.10,0:18:43.63,Default,,0,0,0,,Шындық әлдеқашан шешілді.
Dialogue: 0,0:18:44.90,0:18:46.26,Default,,0,0,0,,Мен мұны өз басымнан білемін
Dialogue: 0,0:18:55.90,0:18:56.33,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:18:57.53,0:18:58.63,Default,,0,0,0,,Әлде…
Dialogue: 0,0:19:02.16,0:19:04.13,Default,,0,0,0,,Мен барлығын қорғаймын
Dialogue: 0,0:19:05.36,0:19:06.73,Default,,0,0,0,,Біреу мені қорғасын
Dialogue: 0,0:19:07.83,0:19:08.70,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:19:09.10,0:19:09.56,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:12.73,0:19:13.63,Default,,0,0,0,,Токико-сан
Dialogue: 0,0:19:14.13,0:19:15.13,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:19:15.80,0:19:17.73,Default,,0,0,0,,Бұл менің ерекше орным.
Dialogue: 0,0:19:19.40,0:19:20.36,Default,,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,0:19:21.56,0:19:24.13,Default,,0,0,0,,Кадзуки үйге бірінші баратын сияқты емес.
Dialogue: 0,0:19:24.86,0:19:26.20,Default,,0,0,0,,Барлығы уайымдады.
Dialogue: 0,0:19:26.50,0:19:27.73,Default,,0,0,0,,Иә
Dialogue: 0,0:19:33.23,0:19:35.40,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:36.06,0:19:36.60,Default,,0,0,0,,Казуки
Dialogue: 0,0:19:36.66,0:19:37.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:37.36,0:19:38.56,Default,,0,0,0,,Мына жерге қара.
Dialogue: 0,0:19:44.20,0:19:46.80,Default,,0,0,0,,Артқы таудағы елес зауыт?
Dialogue: 0,0:19:47.83,0:19:50.80,Default,,0,0,0,,Сол кезде мені қорғауға тырыстың.
Dialogue: 0,0:19:52.06,0:19:52.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:53.33,0:19:53.76,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:55.16,0:19:57.33,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:19:59.56,0:20:03.06,Default,,0,0,0,,Сол кезде мен ойланбастан секірдім.
Dialogue: 0,0:20:04.13,0:20:07.23,Default,,0,0,0,,Мен тек алдымдағы қызды қорғауға тырыстым.
Dialogue: 0,0:20:11.23,0:20:13.96,Default,,0,0,0,,Сол кездегі сезімдерім әлі өзгерген жоқ.
Dialogue: 0,0:20:15.93,0:20:17.76,Default,,0,0,0,,әлдеқайда күшті
Dialogue: 0,0:20:20.80,0:20:21.70,Default,,0,0,0,,Мен қорғағым келеді
Dialogue: 0,0:20:22.60,0:20:23.03,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:20:25.46,0:20:26.96,Default,,0,0,0,,Шешілді, Токико-сан.
Dialogue: 0,0:20:29.73,0:20:33.76,Default,,0,0,0,,Бірақ маған әлі батылдық жетпейді.
Dialogue: 0,0:20:37.06,0:20:37.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:38.36,0:20:41.60,Default,,0,0,0,,Олай болса, мендегі жетіспейтін нәрсені толтыра аласыз.
Dialogue: 0,0:20:42.06,0:20:42.50,Default,,0,0,0,,Иә
Dialogue: 0,0:20:45.10,0:20:46.90,Default,,0,0,0,,Бір түнде айтқанымдай
Dialogue: 0,0:20:47.53,0:20:50.30,Default,,0,0,0,,Сен өлгенде, мен өлгенде
Dialogue: 0,0:20:51.70,0:20:55.86,Default,,0,0,0,,Сен екеуміз бірміз.
Dialogue: 0,0:21:53.70,0:21:57.40,Default,,0,0,0,,Ууууууууууу
Dialogue: 0,0:21:59.70,0:22:00.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:22:18.03,0:22:22.76,Default,,0,0,0,,Тереңдеген, тәтті әлемге
Dialogue: 0,0:22:22.96,0:22:29.50,Default,,0,0,0,,Енді ұшып ұшайық, қанатымызды жайып
Dialogue: 0,0:22:40.26,0:22:49.43,Default,,0,0,0,,Күміс ай қара аспанды тесіп өтті
Dialogue: 0,0:22:50.80,0:23:00.30,Default,,0,0,0,,Үздіктердің назарында
Dialogue: 0,0:23:00.96,0:23:09.13,Default,,0,0,0,,Дыбыссыз жорғалайтын сол түн
Dialogue: 0,0:23:09.30,0:23:17.13,Default,,0,0,0,,Маскамен жасырылған
Dialogue: 0,0:23:18.00,0:23:22.73,Default,,0,0,0,,Қалағаныңызша жоғары ұшыңыз
Dialogue: 0,0:23:22.96,0:23:28.30,Default,,0,0,0,,Осы әдемі қауырсындарым болса
Dialogue: 0,0:23:28.63,0:23:33.43,Default,,0,0,0,,Жарқыраған, жарқыраған дүние
Dialogue: 0,0:23:33.56,0:23:38.50,Default,,0,0,0,,Барлығы менің қолымда
Dialogue: 0,0:23:48.26,0:23:52.20,Default,,0,0,0,,Мен соңғы үмітімді бір ақ ядролық темірге сенемін.
Dialogue: 0,0:23:52.66,0:23:54.60,Default,,0,0,0,,Сіз Викторға қарсы тұрасыз.
Dialogue: 0,0:23:55.10,0:23:55.86,Default,,0,0,0,,Бірақ Казуки
Dialogue: 0,0:23:56.60,0:23:58.23,Default,,0,0,0,,Мен сені жалғыз жібермеймін
Dialogue: 0,0:23:58.96,0:24:01.96,Default,,0,0,0,,Келесі жолы «Сен өлгенде мен өлемін»
Dialogue: 0,0:24:03.46,0:24:09.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory