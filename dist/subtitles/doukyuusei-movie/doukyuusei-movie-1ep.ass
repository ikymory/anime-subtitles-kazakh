Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.76,0:00:07.48,Default,,0,0,0,,Ұлдар мектебінде хор фестивалі бола ма?
Dialogue: 0,0:00:07.48,0:00:09.94,Default,,0,0,0,,Мен оны түсінбеймін.
Dialogue: 0,0:00:09.94,0:00:16.11,Default,,0,0,0,,Дұрыс, көріп тұрсыңдар, қыздар және ұлдар бөлімі бар.
Dialogue: 0,0:00:16.11,0:00:18.11,Default,,0,0,0,,Сопрано және альт
Dialogue: 0,0:00:18.11,0:00:20.45,Default,,0,0,0,,Мен қыздармен бірге жаттығу жасағым келеді.
Dialogue: 0,0:00:20.45,0:00:22.62,Default,,0,0,0,,Эй, бұл тітіркендіргіш.
Dialogue: 0,0:00:24.33,0:00:25.46,Default,,0,0,0,,Шулы. Өзіңізді осындай еркек дауысын жасайтын адамның орнына қойыңыз.
Dialogue: 0,0:00:25.46,0:00:28.08,Default,,0,0,0,,Харасен, мотивацияны жоғалтпа, Харасен.
Dialogue: 0,0:00:28.08,0:00:31.46,Default,,0,0,0,,Жарайды, тым болмаса дәмді дауысыңмен мені жылат.
Dialogue: 0,0:00:31.46,0:00:34.18,Default,,0,0,0,,Харасенді жылатудың мәні неде? өрескел.
Dialogue: 0,0:00:34.18,0:00:38.80,Default,,0,0,0,,Жарайды, мен мұны бірте-бірте жасап жатырмын. тұру.
Dialogue: 0,0:00:45.77,0:00:50.40,Default,,0,0,0,,Менің артымнан жүр. Тек дауыстап айтыңыз.
Dialogue: 0,0:00:51.24,0:00:53.24,Default,,0,0,0,,Артқа қарау
Dialogue: 0,0:00:55.70,0:01:00.20,Default,,0,0,0,,Айналмалы көздер
Dialogue: 0,0:01:00.20,0:01:05.08,Default,,0,0,0,,Жас жапырақтарға
Dialogue: 0,0:01:05.08,0:01:09.59,Default,,0,0,0,,Көктем самалы Әй, ән салма, жігітім
Dialogue: 0,0:01:10.08,0:01:12.76,Default,,0,0,0,,Тосито Саджо
Dialogue: 0,0:01:12.76,0:01:14.80,Default,,0,0,0,,Ол ақылды және атақты.
Dialogue: 0,0:01:18.15,0:01:22.05,Default,,0,0,0,,Мен ешқандай ән айтып жатқан жоқпын деп ойлаймын.
Dialogue: 0,0:01:26.85,0:01:31.27,Default,,0,0,0,,өлер алдында бірнеше апта бойы басқару компаниясына дәл осы жайтқа шағымданып келген
Dialogue: 0,0:01:31.27,0:01:33.99,Default,,0,0,0,,Жаз
Dialogue: 0,0:01:34.31,0:01:36.85,Default,,0,0,0,,Әй, қорап бүгін сағат 6-да.
Dialogue: 0,0:01:36.85,0:01:39.70,Default,,0,0,0,,Барабанға келгенде Сакаки-кун маған барабанды күйге келтіруге көмектеседі.
Dialogue: 0,0:01:40.15,0:01:41.82,Default,,0,0,0,,Ген-чанға есегін беріңіз.
Dialogue: 0,0:01:41.82,0:01:42.57,Default,,0,0,0,,Ах.
Dialogue: 0,0:01:42.57,0:01:45.12,Default,,0,0,0,,Жоқ. Мен сыныпта бір нәрсені ұмытып қалдым.
Dialogue: 0,0:01:45.71,0:01:48.26,Default,,0,0,0,,Жарайды. Мен сенен алдамын.
Dialogue: 0,0:01:48.26,0:01:49.71,Default,,0,0,0,,Жақсы, көріскенше.
Dialogue: 0,0:01:49.98,0:01:51.51,Default,,0,0,0,,Ах.
Dialogue: 0,0:01:52.46,0:01:55.42,Default,,0,0,0,,Бенто қорабы, бенто қорабы.
Dialogue: 0,0:01:57.38,0:02:00.47,Default,,0,0,0,,Күріш жабысқақ болады
Dialogue: 0,0:02:07.02,0:02:11.47,Default,,0,0,0,,Айналатын көзде
Dialogue: 0,0:02:11.47,0:02:12.44,Default,,0,0,0,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:02:15.40,0:02:18.78,Default,,0,0,0,,...
Dialogue: 0,0:02:18.78,0:02:21.20,Default,,0,0,0,,Вакабайо
Dialogue: 0,0:02:28.22,0:02:29.49,Default,,0,0,0,,K-
Dialogue: 0,0:02:30.00,0:02:31.50,Default,,0,0,0,,Құсақабе
Dialogue: 0,0:02:31.50,0:02:33.25,Default,,0,0,0,,О, ой
Dialogue: 0,0:02:33.88,0:02:35.86,Default,,0,0,0,,Бір нәрсені жоғалтты
Dialogue: 0,0:02:37.97,0:02:40.93,Default,,0,0,0,,Жасырын ән?
Dialogue: 0,0:02:40.93,0:02:42.39,Default,,0,0,0,,Сажоса.
Dialogue: 0,0:02:42.39,0:02:43.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:43.14,0:02:45.47,Default,,0,0,0,,Сіздің айтқаныңыз сәл қате болды.
Dialogue: 0,0:02:45.47,0:02:49.27,Default,,0,0,0,,“Мойуру Вакаба йо” орнына
Dialogue: 0,0:02:49.28,0:02:52.77,Default,,0,0,0,,«Мойуру Вакаба».
Dialogue: 0,0:02:53.36,0:02:56.61,Default,,0,0,0,,Моюру Вакаба
Dialogue: 0,0:02:56.61,0:02:59.45,Default,,0,0,0,,Ал, қараңдаршы, бұл демалыс.
Dialogue: 0,0:02:59.45,0:03:00.32,Default,,0,0,0,,Моюру
Dialogue: 0,0:03:00.32,0:03:03.78,Default,,0,0,0,,Вакаба.
Dialogue: 0,0:03:03.78,0:03:07.41,Default,,0,0,0,,Уайымдама, жас жапырақтар.
Dialogue: 0,0:03:07.41,0:03:08.37,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:03:08.96,0:03:12.92,Default,,0,0,0,,Мен сенімен бір күні келемін
Dialogue: 0,0:03:12.92,0:03:17.04,Default,,0,0,0,,Кішкене есейген күнім
Dialogue: 0,0:03:17.04,0:03:21.01,Default,,0,0,0,,Содан кейін қайтадан сіздің
Dialogue: 0,0:03:21.01,0:03:27.18,Default,,0,0,0,,Мен Моюру Вакабаның қозғалатын көздерін көргім келеді
Dialogue: 0,0:03:27.18,0:03:29.89,Default,,0,0,0,,Мен соншалықты алысқа барған жоқпын.
Dialogue: 0,0:03:29.89,0:03:30.77,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:30.77,0:03:32.69,Default,,0,0,0,,Ал, ұпайға қарасаңыз
Dialogue: 0,0:03:32.69,0:03:36.23,Default,,0,0,0,,А, менің ойымша, олар топта немесе бірдеңеде. Сәлем
Dialogue: 0,0:03:37.83,0:03:39.36,Default,,0,0,0,,Маған хабарлағаныңызға рахмет.
Dialogue: 0,0:03:42.51,0:03:44.57,Default,,0,0,0,,Мен сізді мотивациясыз деп ойладым.
Dialogue: 0,0:03:45.62,0:03:48.70,Default,,0,0,0,,Мотивация?
Dialogue: 0,0:03:49.27,0:03:52.17,Default,,0,0,0,,Ән айту қызықсыз деп ойладың ба деп ойладым.
Dialogue: 0,0:03:52.80,0:03:56.12,Default,,0,0,0,,Сен ән айтпадың, сабақта болдың.
Dialogue: 0,0:03:56.12,0:04:02.34,Default,,0,0,0,,Мен тақтадағы жазбаларды жақсы көре алмаймын, себебі көзілдірігім жеткіліксіз.
Dialogue: 0,0:04:02.34,0:04:04.80,Default,,0,0,0,,Сен Хараға неге айтпайсың және оны алдыңа отырғызбайсың?
Dialogue: 0,0:04:04.80,0:04:06.01,Default,,0,0,0,,Олай емес
Dialogue: 0,0:04:06.31,0:04:08.31,Default,,0,0,0,,Мұғалімді алаңдататын ештеңе жасамаңыз.
Dialogue: 0,0:04:10.27,0:04:12.28,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:12.28,0:04:14.23,Default,,0,0,0,,Сонда бұл құпия ма?
Dialogue: 0,0:04:14.23,0:04:19.86,Default,,0,0,0,,Дәлірек айтсақ, Хара-сен сізді мазалап, қамқорлық жасайтын жігіт.
Dialogue: 0,0:04:22.72,0:04:23.70,Default,,0,0,0,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:23.96,0:04:25.68,Default,,0,0,0,,Қарап көрейік пе?
Dialogue: 0,0:04:25.68,0:04:26.95,Default,,0,0,0,,Енді ән
Dialogue: 0,0:04:28.28,0:04:30.22,Default,,0,0,0,,Хор мерекесіне дейін
Dialogue: 0,0:04:33.77,0:04:35.37,Default,,0,0,0,,Ах
Dialogue: 0,0:04:39.88,0:04:40.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:40.80,0:04:41.84,Default,,0,0,0,,бет бұрды.
Dialogue: 0,0:04:47.72,0:04:51.22,Default,,0,0,0,,Сосын басын изеді.
Dialogue: 0,0:04:51.79,0:04:55.10,Default,,0,0,0,,«Жарайды, онда», - деді ол.
Dialogue: 0,0:04:57.06,0:05:02.99,Default,,0,0,0,,Шынымды айтсам, мұндай ұсыныс жасағаныма таң қалдым.
Dialogue: 0,0:05:04.42,0:05:05.66,Default,,0,0,0,,...
Dialogue: 0,0:05:06.10,0:05:07.95,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:05:12.78,0:05:14.87,Default,,0,0,0,,Ол жақта дыбыс басқаша.
Dialogue: 0,0:05:14.87,0:05:18.29,Default,,0,0,0,,Қараңызшы, бұл табиғи, сондықтан жарты тонды қайтарыңыз.
Dialogue: 0,0:05:18.29,0:05:19.66,Default,,0,0,0,,Демек, бұл қалыпты Mi.
Dialogue: 0,0:05:19.66,0:05:20.63,Default,,0,0,0,,Mi?
Dialogue: 0,0:05:20.63,0:05:21.92,Default,,0,0,0,,Ми қайда?
Dialogue: 0,0:05:21.92,0:05:23.38,Default,,0,0,0,,Бұл G дыбысы.
Dialogue: 0,0:05:23.98,0:05:25.84,Default,,0,0,0,,G ескертпесі
Dialogue: 0,0:05:25.84,0:05:27.26,Default,,0,0,0,,Саджо дегеніміз не?
Dialogue: 0,0:05:27.26,0:05:30.47,Default,,0,0,0,,Тақтаны көрмеу емес, музыканы оқу мүмкін емес.
Dialogue: 0,0:05:30.47,0:05:31.39,Default,,0,0,0,,Мен оны оқи аламын.
Dialogue: 0,0:05:31.77,0:05:33.33,Default,,0,0,0,,Бұл C, солай ма?
Dialogue: 0,0:05:33.33,0:05:34.85,Default,,0,0,0,,Досилазо
Dialogue: 0,0:05:34.85,0:05:37.81,Default,,0,0,0,,Оларды бір-бірлеп санайсың ба?
Dialogue: 0,0:05:37.81,0:05:39.52,Default,,0,0,0,,Торокусей
Dialogue: 0,0:05:41.65,0:05:44.09,Default,,0,0,0,,Ах, мен жиіркенішті сезінемін.
Dialogue: 0,0:05:44.09,0:05:45.11,Default,,0,0,0,,Қызықты.
Dialogue: 0,0:05:46.06,0:05:49.54,Default,,0,0,0,,Саджо мырза, ноталарды оқуды тоқтату керек пе?
Dialogue: 0,0:05:49.54,0:05:51.83,Default,,0,0,0,,Артымнан еріп, ән айт.
Dialogue: 0,0:05:55.04,0:05:58.42,Default,,0,0,0,,Екінші бөлім бірінші және екінші бөлімдерге бөлінеді.
Dialogue: 0,0:05:59.72,0:06:01.79,Default,,0,0,0,,Құсақабе тенор, солай ма?
Dialogue: 0,0:06:02.09,0:06:04.98,Default,,0,0,0,,Ах, бірақ мен Альтонды да түсінемін.
Dialogue: 0,0:06:04.98,0:06:10.01,Default,,0,0,0,,Сонымен қатар, үйлестіру кезінде жаттығу жасасаңыз, түсіну оңайырақ.
Dialogue: 0,0:06:10.01,0:06:10.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:11.20,0:06:13.14,Default,,0,0,0,,«Құсақабе керемет».
Dialogue: 0,0:06:13.14,0:06:15.20,Default,,0,0,0,,Сіз солай ойладыңыз, солай ма? қазір.
Dialogue: 0,0:06:15.20,0:06:16.56,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:06:17.14,0:06:19.68,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:06:19.68,0:06:21.52,Default,,0,0,0,,«Ма» деген не?
Dialogue: 0,0:06:23.82,0:06:25.35,Default,,0,0,0,,Ей, кешігіп қалдың, кешігіп қалдың.
Dialogue: 0,0:06:25.35,0:06:26.23,Default,,0,0,0,,Рамен
Dialogue: 0,0:06:26.23,0:06:27.19,Default,,0,0,0,,Mac жүйесінде кешіріңіз
Dialogue: 0,0:06:31.12,0:06:32.53,Default,,0,0,0,,Рамен, рамен!
Dialogue: 0,0:06:32.54,0:06:34.83,Default,,0,0,0,,Үлкен Мак полициясы қайда кетті?
Dialogue: 0,0:06:48.20,0:06:50.83,Default,,0,0,0,,Ой, балалар не істеп жатырсыңдар?
Dialogue: 0,0:06:50.83,0:06:54.47,Default,,0,0,0,,Егер сіз тырыссаңыз, мұны істей аласыз! Бір сәт өзімді сондай дымқыл сезіндім.
Dialogue: 0,0:06:54.48,0:06:56.81,Default,,0,0,0,,Бұл не? Хара-сен, жылама.
Dialogue: 0,0:06:56.81,0:06:57.56,Default,,0,0,0,,Міне, дәл солай.
Dialogue: 0,0:06:57.60,0:07:03.15,Default,,0,0,0,,Иә, мен А сыныбы өте нашар деп ойладым.
Dialogue: 0,0:07:03.15,0:07:05.98,Default,,0,0,0,,Хе, мен оны дәл уақытында жасағаныма қуаныштымын.
Dialogue: 0,0:07:05.98,0:07:07.61,Default,,0,0,0,,Харасен тым ашық айтты.
Dialogue: 0,0:07:08.06,0:07:09.86,Default,,0,0,0,,Ах, бірақ солай.
Dialogue: 0,0:07:09.86,0:07:13.24,Default,,0,0,0,,Бәріңіз, Харасенді жылату үшін көп еңбектендіңіздер.
Dialogue: 0,0:07:13.24,0:07:13.82,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:14.36,0:07:16.99,Default,,0,0,0,,Әй, онда оны шын жылатайық.
Dialogue: 0,0:07:17.32,0:07:18.79,Default,,0,0,0,,Мен майлықтарды аламын.
Dialogue: 0,0:07:18.79,0:07:20.50,Default,,0,0,0,,Айтпа, адам, жыла.
Dialogue: 0,0:07:20.89,0:07:24.00,Default,,0,0,0,,Жарайды, байсалды болып, соңғы бөлімді қарастырайық.
Dialogue: 0,0:07:24.01,0:07:27.59,Default,,0,0,0,,Не? Менің ойымша, бұл соңғы рет емес еді.
Dialogue: 0,0:07:27.59,0:07:32.43,Default,,0,0,0,,Мен Цурумеге сәйкес болғым келеді
Dialogue: 0,0:07:34.40,0:07:35.81,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:53.68,0:07:54.78,Default,,0,0,0,,Емдеу.
Dialogue: 0,0:07:54.78,0:07:56.33,Default,,0,0,0,,О, рахмет.
Dialogue: 0,0:07:56.33,0:07:58.70,Default,,0,0,0,,Жоқ, бұл жеткіліксіз,
Dialogue: 0,0:07:58.70,0:07:59.66,Default,,0,0,0,,Бұл соңғысы.
Dialogue: 0,0:08:00.10,0:08:02.50,Default,,0,0,0,,Бұл маған осы уақытқа дейін көмектесті. рақмет сізге.
Dialogue: 0,0:08:23.38,0:08:24.81,Default,,0,0,0,,Осымен
Dialogue: 0,0:08:25.82,0:08:29.55,Default,,0,0,0,,Сіз бұл әнді Сен Хараға арнап айту үшін бар күшіңізді салдыңыз ба?
Dialogue: 0,0:08:36.84,0:08:38.44,Default,,0,0,0,,А, лала.
Dialogue: 0,0:08:38.44,0:08:42.20,Default,,0,0,0,,Ах, жақсы, жақсы. Оны өзіңіз алыңыз.
Dialogue: 0,0:09:07.80,0:09:09.94,Default,,0,0,0,,О, жоқ, кешіріңіз.
Dialogue: 0,0:09:13.00,0:09:15.91,Default,,0,0,0,,Міне, бұл
Dialogue: 0,0:09:16.24,0:09:18.16,Default,,0,0,0,,Уау
Dialogue: 0,0:09:18.16,0:09:20.49,Default,,0,0,0,,Әй, Қу, Құсақабе!
Dialogue: 0,0:09:25.38,0:09:26.92,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:09:26.92,0:09:29.17,Default,,0,0,0,,Бұл жаман, солай емес пе?
Dialogue: 0,0:09:30.46,0:09:31.55,Default,,0,0,0,,Шырылдау
Dialogue: 0,0:09:31.55,0:09:34.08,Default,,0,0,0,,Көмір қышқылының жарылуы
Dialogue: 0,0:09:34.08,0:09:37.26,Default,,0,0,0,,Саджоның даусы қатты және қарлығады.
Dialogue: 0,0:09:38.03,0:09:41.95,Default,,0,0,0,,Бірақ мұның бәрі оның арқасы
Dialogue: 0,0:09:42.85,0:09:48.81,Default,,0,0,0,,Ах! ең нашар! өл! Мен өлгім келеді!
Dialogue: 0,0:10:05.36,0:10:11.79,Default,,0,0,0,,Ал, келесі бағдарлама №7, 2 курс А сыныбы «Мойуру Вакаба»
Dialogue: 0,0:10:29.84,0:10:34.32,Default,,0,0,0,,Айналатын көзде
Dialogue: 0,0:10:34.32,0:10:38.78,Default,,0,0,0,,Моюру Вакаба
Dialogue: 0,0:10:38.78,0:10:43.44,Default,,0,0,0,,Көктемгі самалда тербелу
Dialogue: 0,0:10:43.44,0:10:48.00,Default,,0,0,0,,Көк жер
Dialogue: 0,0:10:48.00,0:10:52.36,Default,,0,0,0,,Бір күні сенімен бірге
Dialogue: 0,0:10:52.36,0:10:57.13,Default,,0,0,0,,Кішкене есейген күнім
Dialogue: 0,0:10:57.13,0:11:04.05,Default,,0,0,0,,Сіз дұрыс ән айтып жатырсыз.
Dialogue: 0,0:11:04.05,0:11:09.27,Default,,0,0,0,,Жақсы, онда
Dialogue: 0,0:11:18.30,0:11:19.90,Default,,0,0,0,,Ах
Dialogue: 0,0:11:19.90,0:11:22.32,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын
Dialogue: 0,0:11:22.32,0:11:25.33,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын!
Dialogue: 0,0:11:27.36,0:11:29.20,Default,,0,0,0,,Қарғыс атсын, Құсақабе!
Dialogue: 0,0:11:29.20,0:11:30.33,Default,,0,0,0,,Не? Саджо?
Dialogue: 0,0:11:33.33,0:11:35.34,Default,,0,0,0,,Эй, сен! Эй!
Dialogue: 0,0:11:35.34,0:11:36.96,Default,,0,0,0,,Не, кетті.
Dialogue: 0,0:11:36.96,0:11:39.80,Default,,0,0,0,,Нақты орындау кезінде. Драманы қараңыз.
Dialogue: 0,0:11:43.08,0:11:44.55,Default,,0,0,0,,Эй, күте тұр!
Dialogue: 0,0:11:44.55,0:11:46.68,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:11:47.07,0:11:50.70,Default,,0,0,0,,Тез оралыңыз! Сен Хара уайымдап тұр!
Dialogue: 0,0:11:50.70,0:11:53.31,Default,,0,0,0,,Неліктен Хара мырза пайда болды?
Dialogue: 0,0:11:59.04,0:12:00.19,Default,,0,0,0,,Иә, өйткені мен
Dialogue: 0,0:12:00.19,0:12:04.49,Default,,0,0,0,,Мен саған ғашық болып қалған сияқтымын!
Dialogue: 0,0:12:09.91,0:12:15.36,Default,,0,0,0,,Бірақ сіз, солай емес пе? Мен Сен Хара үшін бар күшімді салдым.
Dialogue: 0,0:12:15.36,0:12:17.75,Default,,0,0,0,,Жауға тұз жібергендей!
Dialogue: 0,0:12:17.75,0:12:18.38,Default,,0,0,0,,Құсақабе?
Dialogue: 0,0:12:18.38,0:12:20.82,Default,,0,0,0,,Сіз өте ақымақ көрінесіз! Дәлірек айтқанда,
Dialogue: 0,0:12:20.82,0:12:27.01,Default,,0,0,0,,А, жеткілікті. Бұл енді ештеңе емес. Қазірдің өзінде, а.
Dialogue: 0,0:12:27.01,0:12:27.80,Default,,0,0,0,,Құсақабе
Dialogue: 0,0:12:27.80,0:12:29.93,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:12:29.93,0:12:31.88,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:12:31.88,0:12:32.89,Default,,0,0,0,,Құсақабе
Dialogue: 0,0:12:33.56,0:12:35.16,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:12:35.16,0:12:41.19,Default,,0,0,0,,Ешкім Хара-сенсей үшін көп жұмыс істеді деп айтқан жоқ.
Dialogue: 0,0:12:45.86,0:12:49.16,Default,,0,0,0,,Жоқ, сондықтан мұғалімге арналған.
Dialogue: 0,0:12:49.76,0:12:54.12,Default,,0,0,0,,Сізбен бірге ән айтудың орнына.
Dialogue: 0,0:12:56.70,0:12:58.09,Default,,0,0,0,,...
Dialogue: 0,0:13:00.55,0:13:01.84,Default,,0,0,0,,...
Dialogue: 0,0:13:01.86,0:13:03.50,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:13:03.50,0:13:06.96,Default,,0,0,0,,Иә? Маңыздысы осы емес пе?
Dialogue: 0,0:13:06.96,0:13:08.46,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:13:08.46,0:13:10.86,Default,,0,0,0,,Құсақабе! Sajo!
Dialogue: 0,0:13:10.86,0:13:12.13,Default,,0,0,0,,Эй, шықшы.
Dialogue: 0,0:13:12.13,0:13:14.89,Default,,0,0,0,,Асығыңыз, асығыңыз! Sajo!
Dialogue: 0,0:13:15.57,0:13:18.73,Default,,0,0,0,,Иә? Мен бұл адам келді деп ойладым.
Dialogue: 0,0:13:19.30,0:13:21.64,Default,,0,0,0,,Хашимото мырза, сол жаққа қараңызшы.
Dialogue: 0,0:13:21.64,0:13:22.35,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:13:22.35,0:13:23.78,Default,,0,0,0,,Мен осылаймын.
Dialogue: 0,0:13:23.78,0:13:27.49,Default,,0,0,0,,Неге екенін білмеймін, бірақ сіз бірдеңе жасадыңыз.
Dialogue: 0,0:13:28.24,0:13:30.64,Default,,0,0,0,,Қайту уақыты келді
Dialogue: 0,0:13:30.64,0:13:33.28,Default,,0,0,0,,Саджо, жалғастырыңыз.
Dialogue: 0,0:13:33.28,0:13:36.46,Default,,0,0,0,,Бұл жақсы. Бұл туралы бұдан былай сөз жоқ.
Dialogue: 0,0:13:36.93,0:13:40.92,Default,,0,0,0,,Ей, өткен күні күтпеген жағдай болды,
Dialogue: 0,0:13:40.92,0:13:43.51,Default,,0,0,0,,Көзілдірік шайнауға кедергі келтіреді деп ойлайсыз ба?
Dialogue: 0,0:13:47.80,0:13:50.59,Default,,0,0,0,,Әйтеуір, Құсақабе шетке.
Dialogue: 0,0:13:50.59,0:13:54.68,Default,,0,0,0,,Саджо да сонда болса, қандай комбинация болар еді?
Dialogue: 0,0:13:59.10,0:14:00.56,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:14:10.96,0:14:12.62,Default,,0,0,0,,Басылым таратылды ма?
Dialogue: 0,0:14:13.56,0:14:15.87,Default,,0,0,0,,Мен өзіме ұнайтын баланы таптым
Dialogue: 0,0:14:17.28,0:14:20.79,Default,,0,0,0,,Бірдей форма, сол аяқ киім.
Dialogue: 0,0:14:22.18,0:14:25.95,Default,,0,0,0,,Бір сынып, сол жылы
Dialogue: 0,0:14:31.68,0:14:36.18,Default,,0,0,0,,Күз
Dialogue: 0,0:14:36.97,0:14:39.02,Default,,0,0,0,,Саджо екеуіңнің араларыңда бірдеңе болды ма?
Dialogue: 0,0:14:40.46,0:14:41.98,Default,,0,0,0,,Не?
Dialogue: 0,0:14:41.98,0:14:45.00,Default,,0,0,0,,Жоқ, осындай нәрсе.
Dialogue: 0,0:14:45.00,0:14:49.95,Default,,0,0,0,,Бұрын классиканы ойнап жүргенде, екеуміз бір-бірімізге осылай қарап тұрмыз деп ойладым.
Dialogue: 0,0:14:50.35,0:14:53.28,Default,,0,0,0,,Сонымен қатар, соңғы кездері біз үйге жиі бірге баратын болдық.
Dialogue: 0,0:14:53.28,0:14:54.70,Default,,0,0,0,,Ах.
Dialogue: 0,0:14:55.05,0:15:00.00,Default,,0,0,0,,Маған бәрібір, бірақ не айтарымды білмеймін.
Dialogue: 0,0:15:00.57,0:15:04.80,Default,,0,0,0,,Саджо екеуміз басқа жанрдамыз.
Dialogue: 0,0:15:04.80,0:15:06.58,Default,,0,0,0,,Жанр?
Dialogue: 0,0:15:06.58,0:15:09.22,Default,,0,0,0,,Екеуіңнің бірге болғандарың қызық.
Dialogue: 0,0:15:09.22,0:15:10.46,Default,,0,0,0,,Біртүрлі ме?
Dialogue: 0,0:15:10.46,0:15:13.45,Default,,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 0,0:15:13.45,0:15:14.26,Default,,0,0,0,,Уау.
Dialogue: 0,0:15:14.62,0:15:17.72,Default,,0,0,0,,Бұл «хаха» емес. Бұл не? Мен: «Хаха» деп қалдым.
Dialogue: 0,0:15:18.44,0:15:20.42,Default,,0,0,0,,Осындай қауесеттер бар.
Dialogue: 0,0:15:20.42,0:15:21.97,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:21.97,0:15:26.19,Default,,0,0,0,,Сондықтан ол тек ер балаларға арналған мектепке ғана тән.
Dialogue: 0,0:15:30.26,0:15:32.90,Default,,0,0,0,,Бұл жерде ештеңе жоқ, Құсақабе.
Dialogue: 0,0:15:32.90,0:15:34.75,Default,,0,0,0,,Тағы да.
Dialogue: 0,0:15:34.75,0:15:38.09,Default,,0,0,0,,Мен бұл бұрышқа бұрыла салысымен, мен мектепке барамын.
Dialogue: 0,0:15:38.09,0:15:39.83,Default,,0,0,0,,Енді, бұрышқа.
Dialogue: 0,0:15:51.94,0:15:52.72,Default,,0,0,0,,Мынау, иық
Dialogue: 0,0:15:53.00,0:15:54.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:54.01,0:15:56.50,Default,,0,0,0,,Құсақабе, қолшатырыңды сәл жақындат.
Dialogue: 0,0:15:56.50,0:15:59.84,Default,,0,0,0,,Оң жағы дымқыл емес пе?
Dialogue: 0,0:15:59.84,0:16:03.73,Default,,0,0,0,,А, мәселе жоқ. Мен жалғыз қалғанда қолшатыр ұстамаймын.
Dialogue: 0,0:16:06.01,0:16:09.49,Default,,0,0,0,,Баяғыда, мен бастауыш мектепте оқып жүрген кезімде,
Dialogue: 0,0:16:09.49,0:16:12.60,Default,,0,0,0,,Қышқыл жаңбыр таз тудырады деп естідім.
Dialogue: 0,0:16:12.60,0:16:17.91,Default,,0,0,0,,Соңғы кездері көп сөйлемеймін. Қазір жаңбыр қаттырақ жауатын шығар.
Dialogue: 0,0:16:18.37,0:16:22.71,Default,,0,0,0,,Ха, солай шығар.
Dialogue: 0,0:16:35.32,0:16:37.35,Default,,0,0,0,,Шайнауға бола ма?
Dialogue: 0,0:16:37.35,0:16:38.95,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:16:58.24,0:17:01.70,Default,,0,0,0,,Жоқ, кеттік!
Dialogue: 0,0:17:01.70,0:17:05.39,Default,,0,0,0,,Иә? Неге жоқ?
Dialogue: 0,0:17:05.39,0:17:07.17,Default,,0,0,0,,Біз кездесіп жатырмыз.
Dialogue: 0,0:17:07.50,0:17:09.15,Default,,0,0,0,,Біз кездесіп жатқан жоқпыз.
Dialogue: 0,0:17:09.15,0:17:11.51,Default,,0,0,0,,Сіз шайнап жатырсыз ба?
Dialogue: 0,0:17:11.94,0:17:16.93,Default,,0,0,0,,Сіз кездеспейтін адаммен кездесіп жүрсіз бе, Саджо-кун?
Dialogue: 0,0:17:16.94,0:17:19.26,Default,,0,0,0,,Жарайды, мен енді мұны істемеймін.
Dialogue: 0,0:17:19.26,0:17:20.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:25.66,0:17:26.98,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:33.62,0:17:40.08,Default,,0,0,0,,Әңгімені ол жаққа бұрғым келмеді.
Dialogue: 0,0:17:40.08,0:17:44.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:44.41,0:17:47.13,Default,,0,0,0,,«Наа» деп айтпа.
Dialogue: 0,0:17:47.13,0:17:50.82,Default,,0,0,0,,Сіз Бонкура университеті немесе Афоафо маманы болсаңыз да маңызды емес.
Dialogue: 0,0:17:50.82,0:17:52.59,Default,,0,0,0,,Тек оны табыңыз.
Dialogue: 0,0:17:53.27,0:17:55.98,Default,,0,0,0,,Аузыңды ашсаң,
Dialogue: 0,0:17:55.98,0:17:59.68,Default,,0,0,0,,Махаббат, секс, рок-н-ролл,
Dialogue: 0,0:18:00.07,0:18:02.46,Default,,0,0,0,,20 жыл алға жылжу.
Dialogue: 0,0:18:02.46,0:18:05.60,Default,,0,0,0,,Бұл мансап жолын таңдағаннан кейін істеу керек нәрсе.
Dialogue: 0,0:18:06.36,0:18:09.06,Default,,0,0,0,,Таза қағаз шығаруға 50 жыл ерте.
Dialogue: 0,0:18:09.06,0:18:10.06,Default,,0,0,0,,Күзгі күріш алқабы
Dialogue: 0,0:18:11.58,0:18:16.49,Default,,0,0,0,,Акинодадағы Карихо-но-Эрмитаж... Бұл не?
Dialogue: 0,0:18:16.49,0:18:17.60,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:17.60,0:18:19.87,Default,,0,0,0,,Мен өткен күні сабақта болдым...
Dialogue: 0,0:18:19.87,0:18:23.62,Default,,0,0,0,,Ал, Акиноданың...
Dialogue: 0,0:18:23.62,0:18:28.37,Default,,0,0,0,,Соңғы кездері Саджо екеуің жақсы араласып кеттіңдер, солай ма?
Dialogue: 0,0:18:28.37,0:18:32.83,Default,,0,0,0,,Аа, айтайын дегенім, біз біраз бұрын дос болдық, солай ма?
Dialogue: 0,0:18:32.83,0:18:35.21,Default,,0,0,0,,Соңғы уақытта балалар...
Dialogue: 0,0:18:35.21,0:18:38.43,Default,,0,0,0,,Солай ма? Соған ұқсайды ма? Бұл маңызды емес, солай ма?
Dialogue: 0,0:18:41.30,0:18:44.35,Default,,0,0,0,,да жоқ.
Dialogue: 0,0:18:47.48,0:18:51.56,Default,,0,0,0,,Мен оны бірінші сыныптан бері білемін.
Dialogue: 0,0:18:52.48,0:18:57.77,Default,,0,0,0,,Міне, ол ақылды болғандықтан ұстаздарының арасында атақты болды.
Dialogue: 0,0:18:58.86,0:19:03.40,Default,,0,0,0,,Міне, түскі үзіліс аяқталды.
Dialogue: 0,0:19:03.40,0:19:05.74,Default,,0,0,0,,Құсақабе, сыныпқа қайтып келгенде, келесі жолы...
Dialogue: 0,0:19:05.74,0:19:08.87,Default,,0,0,0,,Саджоға айт, мен саған мектептен кейін кәсіптік бағдар беремін.
Dialogue: 0,0:19:20.64,0:19:24.42,Default,,0,0,0,,Күзгі егістіктердегі Карихо-но-эрмитаж
Dialogue: 0,0:19:24.42,0:19:27.97,Default,,0,0,0,,Мен оны бірінші сыныптан бері білемін.
Dialogue: 0,0:19:28.78,0:19:33.10,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:19:33.10,0:19:36.15,Default,,0,0,0,,Тома Карихо Эрмитажы
Dialogue: 0,0:19:39.61,0:19:42.28,Default,,0,0,0,,Ах, Саджо
Dialogue: 0,0:19:45.02,0:19:47.04,Default,,0,0,0,,Ештеңе жоқ
Dialogue: 0,0:19:48.50,0:19:51.54,Default,,0,0,0,,Біраз өз-өзіңе сенбейсің бе?
Dialogue: 0,0:19:52.79,0:19:57.29,Default,,0,0,0,,Не? Не, не? Бұл ұрыс па? әдіс. Не болды, балақай?
Dialogue: 0,0:19:58.21,0:20:03.93,Default,,0,0,0,,-ға келетін болсақ, келесі мансаптық бағдар беретін Сен Хара болады. мектептен кейін.
Dialogue: 0,0:20:04.90,0:20:07.14,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:17.58,0:20:20.07,Default,,0,0,0,,О, балақай. Үйге ерте қайтайық.
Dialogue: 0,0:20:20.67,0:20:25.23,Default,,0,0,0,,Неліктен бұл орын алады?
Dialogue: 0,0:20:26.53,0:20:32.13,Default,,0,0,0,,Жоқ, бірақ алдымен өлтірілген Саджо кінәлі емес пе?
Dialogue: 0,0:20:36.08,0:20:38.13,Default,,0,0,0,,Сіз ашулы болдыңыз.
Dialogue: 0,0:20:39.05,0:20:41.80,Default,,0,0,0,,Сіз ашулы деп айттыңыз ба?
Dialogue: 0,0:20:47.01,0:20:48.51,Default,,0,0,0,,Күзгі күріш алқабы
Dialogue: 0,0:20:49.42,0:20:53.22,Default,,0,0,0,,Тек Карихо но Иоридің Томаосы...
Dialogue: 0,0:20:53.22,0:20:56.07,Default,,0,0,0,,Жоқ, бұрын Құсақабе болған.
Dialogue: 0,0:20:56.07,0:20:58.15,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:59.70,0:21:03.95,Default,,0,0,0,,Менің сізге нақты нұсқауларым жоқ.
Dialogue: 0,0:21:03.95,0:21:08.16,Default,,0,0,0,,Егер менің бағаларым сол күйінде қалса, мен тапсырып жатқан мектепте ешқандай проблема болмайды деп ойлаймын.
Dialogue: 0,0:21:08.16,0:21:10.83,Default,,0,0,0,,Қалғаны денсаулық сақтау...
Dialogue: 0,0:21:13.92,0:21:15.67,Default,,0,0,0,,Сізді тастап кетті ме?
Dialogue: 0,0:21:18.20,0:21:20.81,Default,,0,0,0,,Не?
Dialogue: 0,0:21:21.32,0:21:24.09,Default,,0,0,0,,Өйткені ол көңілсіз.
Dialogue: 0,0:21:25.94,0:21:28.72,Default,,0,0,0,,Сіз Құсақабемен кездесіп жүрдіңіз ғой, солай ма?
Dialogue: 0,0:21:29.07,0:21:30.42,Default,,0,0,0,,Екеуміз де еркекпіз.
Dialogue: 0,0:21:30.42,0:21:34.30,Default,,0,0,0,,Әлде олар әлі бірге деген осы шақ па?
Dialogue: 0,0:21:34.30,0:21:37.19,Default,,0,0,0,,және Саджо. Шамдарыңыз жоқ па?
Dialogue: 0,0:21:37.20,0:21:38.98,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:21:43.92,0:21:46.70,Default,,0,0,0,,Ерлердің бір-бірімен танысуы
Dialogue: 0,0:21:47.25,0:21:50.20,Default,,0,0,0,,Менің не айтқым келгенін білесің бе?
Dialogue: 0,0:21:53.66,0:21:56.74,Default,,0,0,0,,Оқуды бітіріп, еркін болыңыз
Dialogue: 0,0:21:56.74,0:21:59.29,Default,,0,0,0,,Айналасында әйелдер болған кезде
Dialogue: 0,0:21:59.30,0:22:04.05,Default,,0,0,0,,Әйтпесе, әп-сәтте әйелдердің бөксесін қуасың.
Dialogue: 0,0:22:04.05,0:22:04.96,Default,,0,0,0,,Мен мұндай боларын ойламаппын.
Dialogue: 0,0:22:04.96,0:22:05.92,Default,,0,0,0,,Сажо
Dialogue: 0,0:22:06.36,0:22:09.93,Default,,0,0,0,,Құсақабе ондай емес.
Dialogue: 0,0:22:11.01,0:22:14.52,Default,,0,0,0,,Саджо бізден басқа жанрда.
Dialogue: 0,0:22:22.76,0:22:28.45,Default,,0,0,0,,көремін. Бәлкім, бәрі де солай шығар.
Dialogue: 0,0:22:31.63,0:22:34.48,Default,,0,0,0,,Жаңбыр қатты жауып тұр.
Dialogue: 0,0:22:34.48,0:22:36.58,Default,,0,0,0,,Мен үйге бара жатырмын.
Dialogue: 0,0:22:36.58,0:22:41.04,Default,,0,0,0,,А? Үйге барамын десем, дәл қазір үйге келе жатырмын. не? қайда?
Dialogue: 0,0:22:41.06,0:22:41.79,Default,,0,0,0,,Мектеп.
Dialogue: 0,0:22:41.79,0:22:45.47,Default,,0,0,0,,Иә? не? жоғалған зат?
Dialogue: 0,0:22:46.26,0:22:52.15,Default,,0,0,0,,Күзгі егістіктердегі Карихо-но-эрмитаж томасы
Dialogue: 0,0:22:53.93,0:22:56.09,Default,,0,0,0,,Тому мен Арами
Dialogue: 0,0:23:00.72,0:23:04.23,Default,,0,0,0,,Сіз ашулы деп айттыңыз ба?
Dialogue: 0,0:23:04.23,0:23:07.44,Default,,0,0,0,,Ол жылайтын сияқты
Dialogue: 0,0:23:24.78,0:23:27.21,Default,,0,0,0,,Ку, Құсақа...
Dialogue: 0,0:23:53.90,0:23:57.09,Default,,0,0,0,,Ей, Құсақабе, ауырып тұр.
Dialogue: 0,0:23:59.14,0:24:01.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:24:06.34,0:24:08.88,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:24:09.20,0:24:11.84,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:24:17.58,0:24:21.81,Default,,0,0,0,,Тому мен Арами
Dialogue: 0,0:24:22.43,0:24:24.77,Default,,0,0,0,,Күзгі егістіктердегі Карихо-но-эрмитаж
Dialogue: 0,0:24:25.35,0:24:27.73,Default,,0,0,0,,Менің киімдерім
Dialogue: 0,0:24:30.69,0:24:34.85,Default,,0,0,0,,Қолдарым шықпен суланған
Dialogue: 0,0:24:37.52,0:24:43.32,Default,,0,0,0,,Ах! Міне бітті! О, сондай сергітеді!
Dialogue: 0,0:24:43.32,0:24:45.63,Default,,0,0,0,,Төмендегі тармақ әйгілі ән болса да.
Dialogue: 0,0:24:48.12,0:24:50.42,Default,,0,0,0,,Біртүрлі жігіт
Dialogue: 0,0:24:54.32,0:24:56.16,Default,,0,0,0,,Сажоса
Dialogue: 0,0:24:56.16,0:25:00.59,Default,,0,0,0,,Айтпақшы, бұл
Dialogue: 0,0:25:00.59,0:25:04.09,Default,,0,0,0,,Білесің бе, менімен бірге.
Dialogue: 0,0:25:05.30,0:25:07.44,Default,,0,0,0,,Менімен бірге келіңізші
Dialogue: 0,0:25:14.08,0:25:19.20,Default,,0,0,0,,Екі жігітпен кездесудің не екенін білесіз бе?
Dialogue: 0,0:25:20.20,0:25:22.30,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:25:22.30,0:25:23.71,Default,,0,0,0,,Жоқ, жоқ па?
Dialogue: 0,0:25:23.71,0:25:25.87,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:25:29.74,0:25:32.51,Default,,0,0,0,,Тер...тамшылары...
Dialogue: 0,0:25:34.78,0:25:38.97,Default,,0,0,0,,Күз егісіндегі Карихо-но-эрмитаждағы Томоо
Dialogue: 0,0:25:39.61,0:25:43.49,Default,,0,0,0,,Қолдарым шықпен суланған
Dialogue: 0,0:25:50.98,0:25:52.40,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:25:52.73,0:25:54.86,Default,,0,0,0,,Оның қолында бірдеңе болды.
Dialogue: 0,0:25:54.86,0:25:56.74,Default,,0,0,0,,Хара мырза, не болды?
Dialogue: 0,0:25:56.74,0:26:01.37,Default,,0,0,0,,О, жоқ, жақсысың ба?
Dialogue: 0,0:26:07.12,0:26:09.88,Default,,0,0,0,,Артық болды ма деп ойлаймын.
Dialogue: 0,0:26:10.36,0:26:12.34,Default,,0,0,0,,Бұл тіпті бір адамның жұмысы емес.
Dialogue: 0,0:26:12.34,0:26:15.87,Default,,0,0,0,,Олай болса, екі жыл болды.
Dialogue: 0,0:26:15.87,0:26:18.18,Default,,0,0,0,,Жанкүйер сияқты адамдар да бар.
Dialogue: 0,0:26:18.48,0:26:19.34,Default,,0,0,0,,Желдеткіш?
Dialogue: 0,0:26:19.34,0:26:23.41,Default,,0,0,0,,Соңғы сөз деп айту керек деп ойлаймын.
Dialogue: 0,0:26:23.41,0:26:26.29,Default,,0,0,0,,Соңғы...
Dialogue: 0,0:26:27.48,0:26:31.11,Default,,0,0,0,,Олай болса бұл сенікі. Флайер, мен бірінші барамын.
Dialogue: 0,0:26:36.60,0:26:39.07,Default,,0,0,0,,Не жасырып тұрсың?
Dialogue: 0,0:26:39.07,0:26:42.74,Default,,0,0,0,,Саджо менің достарымды ұнатпайды.
Dialogue: 0,0:26:43.42,0:26:45.03,Default,,0,0,0,,Бұл жасырын емес.
Dialogue: 0,0:26:45.03,0:26:46.70,Default,,0,0,0,,А, иә.
Dialogue: 0,0:26:47.17,0:26:58.17,Default,,0,0,0,,Мен үшінші курс студенті атандым. Үшінші курста сынып екіге бөлінді.
Dialogue: 0,0:26:58.59,0:26:59.55,Default,,0,0,0,,Еріту?
Dialogue: 0,0:26:59.55,0:27:03.38,Default,,0,0,0,,Хмм, бұл соншалықты асыра сілтеу емес.
Dialogue: 0,0:27:03.38,0:27:04.47,Default,,0,0,0,,Бұл емтихан болғандықтан ба?
Dialogue: 0,0:27:04.47,0:27:07.08,Default,,0,0,0,,Хмм, менің ойымша, бұл мағынаны білдіреді.
Dialogue: 0,0:27:07.08,0:27:10.06,Default,,0,0,0,,Вокалист басқа мектептен.
Dialogue: 0,0:27:10.48,0:27:12.86,Default,,0,0,0,,Біз орта мектептен дос болдық.
Dialogue: 0,0:27:12.86,0:27:17.40,Default,,0,0,0,,Міне, қабылдау емтиханы ғой, ол алыстағы университетке түсу емтиханын тапсыратын сияқты.
Dialogue: 0,0:27:17.95,0:27:21.99,Default,,0,0,0,,Сонымен, бұл менің Зукок ретіндегі соңғысым деп ойлаймын.
Dialogue: 0,0:27:22.52,0:27:25.32,Default,,0,0,0,,Білесің бе, шөп қабырға – жол.
Dialogue: 0,0:27:25.32,0:27:26.95,Default,,0,0,0,,Иә, сіз оны көруге келесіз бе?
Dialogue: 0,0:27:29.51,0:27:32.58,Default,,0,0,0,,Дұрысы, мен оны ешқашан дұрыстап шақырған емеспін.
Dialogue: 0,0:27:32.58,0:27:34.92,Default,,0,0,0,,Қараңыз. Бұл соңғысы.
Dialogue: 0,0:27:35.77,0:27:39.14,Default,,0,0,0,,Бұл мүмкін емес. Бүгін жұма, солай ма? Дайындық мектебі бар.
Dialogue: 0,0:27:39.14,0:27:40.43,Default,,0,0,0,,Жоқ, бәрі осы.
Dialogue: 0,0:27:40.43,0:27:41.84,Default,,0,0,0,,Барлығы?
Dialogue: 0,0:27:41.84,0:27:46.08,Default,,0,0,0,,Түні бойы. Мен таңғы 5-ке дейін жұмыс істеймін.
Dialogue: 0,0:27:46.08,0:27:49.73,Default,,0,0,0,,Зукокку сағат 1-де, сондықтан мектеп біткеннен кейін де.
Dialogue: 0,0:27:50.24,0:27:52.20,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:27:52.20,0:27:54.19,Default,,0,0,0,,Кичидодзи
Dialogue: 0,0:28:07.98,0:28:09.78,Default,,0,0,0,,Кичидодзи?
Dialogue: 0,0:28:09.78,0:28:11.67,Default,,0,0,0,,Иә, Кичидодзи.
Dialogue: 0,0:28:11.67,0:28:13.29,Default,,0,0,0,,Барсам. бару?
Dialogue: 0,0:28:13.72,0:28:15.13,Default,,0,0,0,,Иә, мен барамын.
Dialogue: 0,0:28:15.78,0:28:17.59,Default,,0,0,0,,Кейін кездескенше.
Dialogue: 0,0:28:19.64,0:28:23.05,Default,,0,0,0,,Сонда кездескенше. Сонда кездескенше.
Dialogue: 0,0:28:23.63,0:28:28.26,Default,,0,0,0,,Соны айтсам да, үйге тағы қанша рет бірге барамыз деп ойлаймын.
Dialogue: 0,0:28:28.26,0:28:31.96,Default,,0,0,0,,Үшінші курс студенттері, болашақ студенттер және түлектер.
Dialogue: 0,0:28:31.96,0:28:34.98,Default,,0,0,0,,Қарғыс атсын, мен саналы адаммын.
Dialogue: 0,0:28:35.83,0:28:38.27,Default,,0,0,0,,Саджо-кун?
Dialogue: 0,0:28:38.27,0:28:40.88,Default,,0,0,0,,тым кеш, бірақ
Dialogue: 0,0:28:40.88,0:28:44.38,Default,,0,0,0,,Сіздің ата-анаңыз қалаған мектеп туралы біледі ме?
Dialogue: 0,0:28:44.38,0:28:46.40,Default,,0,0,0,,А, иә. мм,
Dialogue: 0,0:28:46.40,0:28:49.24,Default,,0,0,0,,Менің әкем де, атам да сол университетте оқыған.
Dialogue: 0,0:28:49.24,0:28:52.21,Default,,0,0,0,,Аа, дұрыс. Бұл жақсы болар еді.
Dialogue: 0,0:28:52.21,0:28:55.79,Default,,0,0,0,,Көрдіңіз бе, мұндай нәрсе ата-ананың ыңғайлылығына да байланысты.
Dialogue: 0,0:28:55.79,0:28:58.67,Default,,0,0,0,,Маған пансионат немесе жалғыз тұратын жер керек.
Dialogue: 0,0:29:03.52,0:29:05.22,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:29:21.86,0:29:24.15,Default,,0,0,0,,Аа, осында тіркеліңіз.
Dialogue: 0,0:29:24.15,0:29:26.44,Default,,0,0,0,,Қайырлы кеш. Ал, қайда баруымыз керек?
Dialogue: 0,0:29:26.44,0:29:29.74,Default,,0,0,0,,Ах, ум, зу, зукок.
Dialogue: 0,0:29:29.74,0:29:33.45,Default,,0,0,0,,Иә, Зукок мырза. Жақсы, 2500 иен.
Dialogue: 0,0:29:33.45,0:29:36.11,Default,,0,0,0,,Мөр мөр басылады, сондықтан сіз өз қалауыңыз бойынша келіп-кете аласыз. Бұл,
Dialogue: 0,0:29:36.11,0:29:37.63,Default,,0,0,0,,Бір сусын билеті.
Dialogue: 0,0:29:48.32,0:29:50.43,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:29:56.12,0:29:56.69,Default,,0,0,0,,Сыра
Dialogue: 0,0:29:57.06,0:29:57.65,Default,,0,0,0,,Сыра.
Dialogue: 0,0:30:00.60,0:30:02.30,Default,,0,0,0,,Жарайды, ары қарай не болады?
Dialogue: 0,0:30:02.30,0:30:03.57,Default,,0,0,0,,Сондықтан оны сыра деп атайды.
Dialogue: 0,0:30:05.78,0:30:07.11,Default,,0,0,0,,ащы
Dialogue: 0,0:30:07.11,0:30:09.60,Default,,0,0,0,,Зукок, бүгін соңғы күн.
Dialogue: 0,0:30:09.60,0:30:10.98,Default,,0,0,0,,Рас па? Әйтеуір вокал жетіспейді.
Dialogue: 0,0:30:10.98,0:30:14.70,Default,,0,0,0,,Музыкалық тұрғыдан келіспеушілік? Бірақ бұл вокал туралы емес.
Dialogue: 0,0:30:14.70,0:30:17.00,Default,,0,0,0,,Иә, бұл гитара.
Dialogue: 0,0:30:17.00,0:30:20.96,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:30:22.39,0:30:24.27,Default,,0,0,0,,Солай ма! Онда саған ұнайды екен!
Dialogue: 0,0:30:24.27,0:30:25.09,Default,,0,0,0,,Хикару.
Dialogue: 0,0:30:27.32,0:30:29.57,Default,,0,0,0,,Хикару Кусакабе!
Dialogue: 0,0:31:00.76,0:31:04.00,Default,,0,0,0,,Әй, Микипон, жігеріңді көрсет.
Dialogue: 0,0:31:04.60,0:31:06.50,Default,,0,0,0,,Бұл соңғысы.
Dialogue: 0,0:31:06.50,0:31:11.84,Default,,0,0,0,,Бірақ, біз бұрын-соңды сөйлеспеген болсақ та, кенеттен...
Dialogue: 0,0:31:11.84,0:31:15.98,Default,,0,0,0,,Білесің бе, мен сені енді сахнада көре алмаймын, Хикару-сан.
Dialogue: 0,0:31:15.98,0:31:21.06,Default,,0,0,0,,Мен мұны ескерту деп атамас едім. Кейбір естеліктер, иә?
Dialogue: 0,0:31:21.56,0:31:25.40,Default,,0,0,0,,Уау, бар! Сіз кімге костюм киіп жүрсіз?
Dialogue: 0,0:31:25.89,0:31:26.86,Default,,0,0,0,,Мен!
Dialogue: 0,0:31:27.16,0:31:29.50,Default,,0,0,0,,Жоқ, көңіл-күй шынымен керемет болды.
Dialogue: 0,0:31:29.50,0:31:31.12,Default,,0,0,0,,Бұл ең жақсы емес пе?
Dialogue: 0,0:31:31.12,0:31:33.83,Default,,0,0,0,,Бұл соңы деу босқа кетеді.
Dialogue: 0,0:31:33.83,0:31:36.40,Default,,0,0,0,,Жоқ, мен бармаймын.
Dialogue: 0,0:31:36.40,0:31:37.83,Default,,0,0,0,,Бұл келді, сіздікі.
Dialogue: 0,0:31:38.22,0:31:40.55,Default,,0,0,0,,Менікі? не? ата-ана?
Dialogue: 0,0:31:40.55,0:31:43.13,Default,,0,0,0,,Жоқ, ақымақ. Саджо-кун.
Dialogue: 0,0:31:43.45,0:31:43.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:43.96,0:31:47.42,Default,,0,0,0,,Хикару-сан, кешіріңіз. Әй, мына бала. Сәлем, Микипон.
Dialogue: 0,0:31:47.42,0:31:51.40,Default,,0,0,0,,Ах, мм, мен әрқашан солай болдым...
Dialogue: 0,0:31:51.40,0:31:54.65,Default,,0,0,0,,Зукокке қараңыз. Сонымен, мм...
Dialogue: 0,0:31:54.65,0:31:56.89,Default,,0,0,0,,Жасыратын ештеңе жоқ.
Dialogue: 0,0:31:56.89,0:32:00.18,Default,,0,0,0,,Хикару-санның қызы бар ма?
Dialogue: 0,0:32:00.83,0:32:01.86,Default,,0,0,0,,Ол?
Dialogue: 0,0:32:01.86,0:32:05.12,Default,,0,0,0,,О, жоқ, бұл жақсы.
Dialogue: 0,0:32:05.12,0:32:10.44,Default,,0,0,0,,Сізбен электрондық пошта мекенжайымды алмастырсам болады ма?
Dialogue: 0,0:32:11.62,0:32:12.45,Default,,0,0,0,,жақында жолымыз қиылысар.
Dialogue: 0,0:32:14.30,0:32:22.25,Default,,0,0,0,,Не... бұл не? Тоқта, тоқта. Өтінемін тоқта. Қазірдің өзінде...
Dialogue: 0,0:32:23.52,0:32:24.79,Default,,0,0,0,,Ауырсыну
Dialogue: 0,0:32:24.79,0:32:25.21,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:32:26.06,0:32:27.38,Default,,0,0,0,,О, шынымен бе?
Dialogue: 0,0:32:27.38,0:32:31.52,Default,,0,0,0,,Сен істедің, Микипон. Мен жыламасам да.
Dialogue: 0,0:32:31.52,0:32:33.22,Default,,0,0,0,,Сіздің ұялы телефоныңыз қайда?
Dialogue: 0,0:32:33.22,0:32:35.31,Default,,0,0,0,,А, мм.
Dialogue: 0,0:32:38.51,0:32:41.27,Default,,0,0,0,,Әйелдерді жылатып тұрған бұл не, танымал еркек?
Dialogue: 0,0:32:41.60,0:32:43.58,Default,,0,0,0,,Бұл аздап пайда болады.
Dialogue: 0,0:32:43.58,0:32:44.48,Default,,0,0,0,,Саджо-кун?
Dialogue: 0,0:32:44.48,0:32:45.27,Default,,0,0,0,,Бұл қылыш не өзі?!➡
Dialogue: 0,0:32:45.85,0:32:50.03,Default,,0,0,0,,Эй, сен және Саджо-кун.
Dialogue: 0,0:32:56.42,0:32:58.24,Default,,0,0,0,,А, Саджо?
Dialogue: 0,0:33:02.50,0:33:03.96,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:33:05.48,0:33:06.42,Default,,0,0,0,,Ауырсыну
Dialogue: 0,0:33:08.88,0:33:10.13,Default,,0,0,0,,Ауырсыну
Dialogue: 0,0:33:10.15,0:33:12.38,Default,,0,0,0,,Тоқтатайық Тоқтатайық
Dialogue: 0,0:33:12.38,0:33:14.34,Default,,0,0,0,,Сіз қазір тоқтай аласыз.
Dialogue: 0,0:33:14.93,0:33:16.81,Default,,0,0,0,,Ұмытылды
Dialogue: 0,0:33:18.56,0:33:20.77,Default,,0,0,0,,Ештеңе болмағандай кейіптеуге болады
Dialogue: 0,0:33:33.52,0:33:34.24,Default,,0,0,0,,Егер
Dialogue: 0,0:33:34.26,0:33:34.99,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:33:35.55,0:33:38.79,Default,,0,0,0,,Парк құмсалғышының бір түрі
Dialogue: 0,0:33:52.94,0:33:54.51,Default,,0,0,0,,Жібер
Dialogue: 0,0:33:55.38,0:33:56.47,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:33:56.47,0:33:58.43,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:34:07.88,0:34:09.28,Default,,0,0,0,,Мен жақсы болдым ба?
Dialogue: 0,0:34:09.28,0:34:10.11,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:34:10.64,0:34:12.66,Default,,0,0,0,,Сіз танымал емессіз бе, Құсақабе мырза?
Dialogue: 0,0:34:12.66,0:34:14.50,Default,,0,0,0,,Не? мен? Ах,
Dialogue: 0,0:34:14.50,0:34:16.07,Default,,0,0,0,,Іштің бе?
Dialogue: 0,0:34:16.07,0:34:16.95,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:34:18.50,0:34:20.24,Default,,0,0,0,,Мен жақсы болдым ба?
Dialogue: 0,0:34:20.24,0:34:22.41,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:34:22.41,0:34:25.20,Default,,0,0,0,,Менімен болған ұнай ма?
Dialogue: 0,0:34:25.48,0:34:27.36,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:34:27.36,0:34:32.60,Default,,0,0,0,,Қара, арық, көзілдірік таққан, өзі де ер адам, осылай көріну үшін барын салады...
Dialogue: 0,0:34:32.60,0:34:33.55,Default,,0,0,0,,Сажо.
Dialogue: 0,0:34:33.85,0:34:36.05,Default,,0,0,0,,Мен ашуландым.
Dialogue: 0,0:34:36.05,0:34:40.93,Default,,0,0,0,,Жоқ, бұл өтірік. Ашуланба, ашуланба. Мен ашулы емеспін, бірақ...
Dialogue: 0,0:34:40.93,0:34:43.22,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:34:43.86,0:34:45.16,Default,,0,0,0,,Құсақабе?
Dialogue: 0,0:34:45.16,0:34:50.23,Default,,0,0,0,,Амал жоқ, енді жоқ...
Dialogue: 0,0:34:50.23,0:34:51.65,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:34:51.66,0:34:55.94,Default,,0,0,0,,Мен оны енді түсінбеймін! Түрлі оғаш сөздерді айтсаң да, сен ақымақсың!
Dialogue: 0,0:34:55.94,0:35:00.30,Default,,0,0,0,,Сіз өте көп оқисыз, мүлдем! Мен қазірдің өзінде қатты уайымдадым. Мен бұл жақсы емес деп ойладым.
Dialogue: 0,0:35:00.30,0:35:01.12,Default,,0,0,0,,Енді сен ақымақсың!
Dialogue: 0,0:35:01.14,0:35:03.78,Default,,0,0,0,,Не керек, жан-жағынан өтіп, ойланып қаламын ба деп!
Dialogue: 0,0:35:03.78,0:35:06.46,Default,,0,0,0,,Мен өзім неге теріс ойлармен қобалжамын деп ойлаймын.
Dialogue: 0,0:35:06.46,0:35:08.52,Default,,0,0,0,,Мүлдем! Қиындыққа тап болдың, ақымақсың!
Dialogue: 0,0:35:08.52,0:35:12.30,Default,,0,0,0,,Жүрегіңе жаман! Менің телефон қоңырауларым қабылданбады, мен өлемін деп ойладым!
Dialogue: 0,0:35:12.30,0:35:14.55,Default,,0,0,0,,Бұл әрекетті доғарыңыз!
Dialogue: 0,0:35:14.55,0:35:16.13,Default,,0,0,0,,Идиот!
Dialogue: 0,0:35:16.98,0:35:18.48,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:35:18.48,0:35:20.45,Default,,0,0,0,,Бұл №1.
Dialogue: 0,0:35:25.16,0:35:27.73,Default,,0,0,0,,Саджо ең жақсысы
Dialogue: 0,0:35:32.64,0:35:35.07,Default,,0,0,0,,Сіз байсалдысыз ба, бұл танымал жігіт?
Dialogue: 0,0:35:38.68,0:35:43.35,Default,,0,0,0,,Артымда бір қол қозғалып тұр.
Dialogue: 0,0:35:43.35,0:35:45.88,Default,,0,0,0,,Жоқ, не? аздап жаза
Dialogue: 0,0:35:46.46,0:35:49.08,Default,,0,0,0,,Тек арқа, тек арқа
Dialogue: 0,0:35:49.08,0:35:53.04,Default,,0,0,0,,О, керемет. Менің омыртқам туралы бірдеңе
Dialogue: 0,0:35:53.42,0:35:56.63,Default,,0,0,0,,Әрқайсысы ұқыпты түрде ерекшеленеді.
Dialogue: 0,0:35:56.63,0:35:59.94,Default,,0,0,0,,1, 2, 3
Dialogue: 0,0:35:59.94,0:36:00.97,Default,,0,0,0,,Иық сүйегі
Dialogue: 0,0:36:01.99,0:36:04.60,Default,,0,0,0,,Иық жүзі – қанаттың ізі
Dialogue: 0,0:36:04.62,0:36:04.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:05.32,0:36:06.70,Default,,0,0,0,,деген роман бар.
Dialogue: 0,0:36:06.70,0:36:09.13,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:36:10.20,0:36:11.89,Default,,0,0,0,,Құсақабе...күлкі
Dialogue: 0,0:36:11.89,0:36:13.79,Default,,0,0,0,,Қықылдау?
Dialogue: 0,0:36:13.79,0:36:17.85,Default,,0,0,0,,Мен солай ойлаймын. Қытық па деп ойлаймын.
Dialogue: 0,0:36:18.37,0:36:21.57,Default,,0,0,0,,Бұл жай ғана қытықтау шығар.
Dialogue: 0,0:36:21.57,0:36:22.53,Default,,0,0,0,,Ах
Dialogue: 0,0:36:24.45,0:36:26.83,Default,,0,0,0,,Жоқ, жоқ, жоқ! Қазіргі...
Dialogue: 0,0:36:26.84,0:36:27.83,Default,,0,0,0,,Жазылған.
Dialogue: 0,0:36:27.84,0:36:28.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:28.33,0:36:29.90,Default,,0,0,0,,Менің санамда жазылған.
Dialogue: 0,0:36:29.90,0:36:31.58,Default,,0,0,0,,Кез келген уақытта ойнауға болады.
Dialogue: 0,0:36:31.58,0:36:32.21,Default,,0,0,0,,Идиот!
Dialogue: 0,0:36:32.53,0:36:34.68,Default,,0,0,0,,Әй, бүгін жақсы нәрсе болды.
Dialogue: 0,0:36:34.68,0:36:35.28,Default,,0,0,0,,Үлкен ақымақ!
Dialogue: 0,0:36:35.28,0:36:37.22,Default,,0,0,0,,Жоқ, бұл біздің ажырасуымызды жақсы еске алу болды.
Dialogue: 0,0:36:37.22,0:36:40.77,Default,,0,0,0,,№ 1. Саджо - бірінші нөмір.
Dialogue: 0,0:36:42.86,0:36:45.41,Default,,0,0,0,,Әрқашан және мәңгі
Dialogue: 0,0:36:45.41,0:36:46.80,Default,,0,0,0,,Қалағаныңызша айта аласыз
Dialogue: 0,0:36:46.80,0:36:48.02,Default,,0,0,0,,Мен бұл жай ғана арқам дедім.
Dialogue: 0,0:36:48.02,0:36:50.91,Default,,0,0,0,,Иә, менің қолым тайып кетті.
Dialogue: 0,0:36:58.50,0:37:00.99,Default,,0,0,0,,Саджо, жазғы демалыс қалай?
Dialogue: 0,0:37:00.99,0:37:01.74,Default,,0,0,0,,Жазғы курстар.
Dialogue: 0,0:37:02.08,0:37:04.60,Default,,0,0,0,,Обон ше? Сіз үзіліс жасамайсыз ба?
Dialogue: 0,0:37:04.60,0:37:08.20,Default,,0,0,0,,Мен жыл сайын әкемнің ата-анасының үйіне баруым керек.
Dialogue: 0,0:37:08.80,0:37:11.41,Default,,0,0,0,,Одан да Құсақабе сығымдағы мектеп...
Dialogue: 0,0:37:11.42,0:37:14.00,Default,,0,0,0,,Жалғыз емессің бе?
Dialogue: 0,0:37:14.90,0:37:17.46,Default,,0,0,0,,Сіз мені көргіңіз келеді.
Dialogue: 0,0:37:21.84,0:37:25.13,Default,,0,0,0,,Жақсы, жақсы.
Dialogue: 0,0:37:34.10,0:37:38.02,Default,,0,0,0,,Екінші жаз
Dialogue: 0,0:37:42.16,0:37:43.72,Default,,0,0,0,,Жақында
Dialogue: 0,0:37:43.72,0:37:47.16,Default,,0,0,0,,Ақыры мен саған тентек сүйіспеншілік бере алдым.
Dialogue: 0,0:37:47.48,0:37:49.19,Default,,0,0,0,,Бірінші
Dialogue: 0,0:37:49.19,0:37:51.62,Default,,0,0,0,,Саджо қобалжиды және қатты болады.
Dialogue: 0,0:37:52.76,0:37:53.58,Default,,0,0,0,,Бірақ
Dialogue: 0,0:37:54.05,0:37:55.60,Default,,0,0,0,,Біртіндеп босайды
Dialogue: 0,0:37:55.60,0:37:58.26,Default,,0,0,0,,Балқу
Dialogue: 0,0:37:58.26,0:38:00.54,Default,,0,0,0,,Цука
Dialogue: 0,0:38:00.54,0:38:02.63,Default,,0,0,0,,қызба
Dialogue: 0,0:38:06.18,0:38:08.43,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:38:09.52,0:38:11.74,Default,,0,0,0,,Жаз мезгілі
Dialogue: 0,0:38:11.74,0:38:16.45,Default,,0,0,0,,Ыстыққа қалдырып, есейген мезгіл емес пе?
Dialogue: 0,0:38:16.45,0:38:21.82,Default,,0,0,0,,Екеуміздің кездесіп жүргенімізге бір жыл болды, әлі тіл табыса алмадық.
Dialogue: 0,0:38:23.18,0:38:26.90,Default,,0,0,0,,Жарайды, Саджо, мен сенің мотивацияң болғанын қалаймын.
Dialogue: 0,0:38:26.90,0:38:29.49,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:38:29.78,0:38:31.45,Default,,0,0,0,,Хара мырза!
Dialogue: 0,0:38:33.91,0:38:35.87,Default,,0,0,0,,Не?
Dialogue: 0,0:38:36.34,0:38:38.94,Default,,0,0,0,,Бұл жиіркенішті. Мені мұғалім десең ренжіп қаламын.
Dialogue: 0,0:38:38.94,0:38:41.40,Default,,0,0,0,,Жоқ, менің сұрағым бар.
Dialogue: 0,0:38:41.40,0:38:43.08,Default,,0,0,0,,Шашыңыз түсіп қалды.
Dialogue: 0,0:38:43.08,0:38:45.84,Default,,0,0,0,,Ем, ер адамдар мұны бірге жасайды ше?
Dialogue: 0,0:38:47.50,0:38:51.13,Default,,0,0,0,,Ыстық, ыстық. Менің миым, солай.
Dialogue: 0,0:38:51.13,0:38:54.77,Default,,0,0,0,,Кет, кет. Жаз келді! Хахахаха!
Dialogue: 0,0:38:55.64,0:38:57.18,Default,,0,0,0,,Одан басқа.
Dialogue: 0,0:38:57.18,0:39:00.79,Default,,0,0,0,,Орта мектептің үшінші курсының жазы - студенттердің қабылдау емтихандарын тапсыру уақыты.
Dialogue: 0,0:39:00.79,0:39:02.99,Default,,0,0,0,,Қазір түс.
Dialogue: 0,0:39:02.99,0:39:06.15,Default,,0,0,0,,Жоқ, сен осы жолдансың,
Dialogue: 0,0:39:06.15,0:39:09.71,Default,,0,0,0,,Сен маған көп нәрсені үйрете аласың ба деп ойладым.
Dialogue: 0,0:39:09.71,0:39:13.75,Default,,0,0,0,,Мен де заттар туралы кітаптарды қарадым. Менің әпкемдікі
Dialogue: 0,0:39:13.75,0:39:18.78,Default,,0,0,0,,Манга немесе басқа нәрсе, мен оған оңай кіре алатынымды білмеймін.
Dialogue: 0,0:39:18.78,0:39:21.47,Default,,0,0,0,,Қынаптың кеңею кезеңі де жазылған,
Dialogue: 0,0:39:21.47,0:39:25.25,Default,,0,0,0,,Мұны оқығаныңды әпкем білсе, сені тепкілеп өлтіреді.
Dialogue: 0,0:39:25.69,0:39:29.17,Default,,0,0,0,,Менің айтайын дегенім Саджо пәк, солай ма?
Dialogue: 0,0:39:29.17,0:39:30.86,Default,,0,0,0,,А, не?
Dialogue: 0,0:39:30.86,0:39:34.64,Default,,0,0,0,,Жарайды, өз бетіңізше ыстыққа түсуіңіз өзімшілдік.
Dialogue: 0,0:39:35.14,0:39:39.98,Default,,0,0,0,,Дәл осындай уақыт, сондықтан оның денесін және басқа да барлық түрлерін күту керек.
Dialogue: 0,0:39:39.98,0:39:43.14,Default,,0,0,0,,Ах, Саджо сондай нәзік. Осындай бірдеңе, өзімді күштеп көрейін.
Dialogue: 0,0:39:43.14,0:39:47.56,Default,,0,0,0,,Дене жағдайы, белі т.б?
Dialogue: 0,0:39:47.56,0:39:50.07,Default,,0,0,0,,Сен ақымақсың ба? Жасөспірімдік шақ.
Dialogue: 0,0:39:50.64,0:39:53.83,Default,,0,0,0,,Ол Киото университетіне құжат тапсырғысы келеді.
Dialogue: 0,0:39:58.72,0:40:00.04,Default,,0,0,0,,Киото университеті?
Dialogue: 0,0:40:00.77,0:40:03.98,Default,,0,0,0,,Киото университеті дегеніміз не? Киото университеті?
Dialogue: 0,0:40:03.98,0:40:05.58,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:40:05.58,0:40:11.72,Default,,0,0,0,,Уау, мен айттым. Мен мұны бірден айтқым келеді.
Dialogue: 0,0:40:15.93,0:40:16.89,Default,,0,0,0,,Киото?
Dialogue: 0,0:40:16.90,0:40:18.70,Default,,0,0,0,,Кешіріңіз, аузым сырғып кетті.
Dialogue: 0,0:40:18.70,0:40:20.82,Default,,0,0,0,,Киото университеті Киотода орналасқан ба?
Dialogue: 0,0:40:20.82,0:40:22.90,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:40:22.90,0:40:24.31,Default,,0,0,0,,Мен тыңдамаймын!
Dialogue: 0,0:40:24.31,0:40:26.86,Default,,0,0,0,,А, иә.
Dialogue: 0,0:40:36.51,0:40:37.99,Default,,0,0,0,,Йо.
Dialogue: 0,0:40:50.20,0:40:53.93,Default,,0,0,0,,О, бұл лимон дәмімен шықты.
Dialogue: 0,0:41:07.94,0:41:11.90,Default,,0,0,0,,Сіз Киотода университетке түсу емтиханын тапсырасыз ба?
Dialogue: 0,0:41:11.90,0:41:13.03,Default,,0,0,0,,Қайда?
Dialogue: 0,0:41:13.03,0:41:17.76,Default,,0,0,0,,Міне, солай. Дегенмен Харасеннен. Жоқ, жақсы,
Dialogue: 0,0:41:17.76,0:41:20.37,Default,,0,0,0,,Бұл заттың импульсі туралы.
Dialogue: 0,0:41:20.66,0:41:22.41,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:41:24.97,0:41:30.05,Default,,0,0,0,,Мен көремін. Көремін, көремін, көремін!
Dialogue: 0,0:41:32.24,0:41:34.22,Default,,0,0,0,,Сіз қашан шешім қабылдадыңыз?
Dialogue: 0,0:41:34.68,0:41:36.84,Default,,0,0,0,,Қашан?
Dialogue: 0,0:41:36.84,0:41:37.68,Default,,0,0,0,,№.
Dialogue: 0,0:41:38.10,0:41:41.78,Default,,0,0,0,,Менің әкем де, атам да сол университетте оқыған.
Dialogue: 0,0:41:41.78,0:41:47.10,Default,,0,0,0,,Әйтеуір соны мақсат еткендей болдым. Бұрыннан бері.
Dialogue: 0,0:41:47.11,0:41:51.18,Default,,0,0,0,,Бұл менің басымнан өткенде бұл туралы мүлде ойламадың ба?
Dialogue: 0,0:41:51.18,0:41:52.65,Default,,0,0,0,,Қашықтық, уақыт және т.б.
Dialogue: 0,0:41:53.26,0:41:59.12,Default,,0,0,0,,Жақсы, жақсы. Бұл жақсы. Жақсы емес, бірақ жақсы.
Dialogue: 0,0:41:59.12,0:42:01.12,Default,,0,0,0,,Бірақ, сіз не айтасыз?
Dialogue: 0,0:42:01.76,0:42:03.53,Default,,0,0,0,,Мен мұны не үшін істеп жатырмын?
Dialogue: 0,0:42:03.53,0:42:07.58,Default,,0,0,0,,Сен Хараның аузынан естуіміз керек пе?
Dialogue: 0,0:42:09.14,0:42:11.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:42:11.90,0:42:14.42,Default,,0,0,0,,Неге маған тікелей айтпайсың? маған
Dialogue: 0,0:42:15.82,0:42:20.01,Default,,0,0,0,,Егер мұндай бұзушылықтар болмаса, мен бұл туралы ешқашан білмес едім,
Dialogue: 0,0:42:20.01,0:42:20.88,Default,,0,0,0,,Тек кетіңіз
Dialogue: 0,0:42:20.88,0:42:21.76,Default,,0,0,0,,Олай емес!
Dialogue: 0,0:42:21.76,0:42:25.14,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:42:25.44,0:42:29.23,Default,,0,0,0,,Мен мұны бір күні айтқым келді, бірақ...
Dialogue: 0,0:42:29.23,0:42:34.19,Default,,0,0,0,,Уақыт
Dialogue: 0,0:42:34.19,0:42:39.24,Default,,0,0,0,,Бұл жай ғана, сіз мәселені кейінге қалдырасыз.
Dialogue: 0,0:42:39.72,0:42:44.10,Default,,0,0,0,,Сайып келгенде, Саджо бұрыннан шешілген нәрсені өзгертуге ниеті жоқ.
Dialogue: 0,0:42:44.10,0:42:47.41,Default,,0,0,0,,Менің де, Ерлердің де осындай тәрбие бергенін қаламадың, солай ма?
Dialogue: 0,0:42:47.92,0:42:51.50,Default,,0,0,0,,Содан кейін кездейсоқ өшеді,
Dialogue: 0,0:42:51.50,0:42:54.13,Default,,0,0,0,,Мендегі заттар да табиғи түрде жоғалып кетті.
Dialogue: 0,0:43:04.40,0:43:08.28,Default,,0,0,0,,Тіпті маған ештеңе демейсің.
Dialogue: 0,0:43:08.28,0:43:18.15,Default,,0,0,0,,Мен қандай мансап жолын таңдауым керек? Болашақта не істеуім керек?
Dialogue: 0,0:43:18.47,0:43:21.45,Default,,0,0,0,,Мен сізді мүлдем танымаймын.
Dialogue: 0,0:43:30.48,0:43:32.63,Default,,0,0,0,,That's right.
Dialogue: 0,0:43:32.63,0:43:36.92,Default,,0,0,0,,Біз бір-бірімізді мүлде танымаймыз
Dialogue: 0,0:43:45.72,0:43:48.81,Default,,0,0,0,,Бір-бірімізді біраз уақыт көретін сияқтымыз.
Dialogue: 0,0:43:56.70,0:43:59.24,Default,,0,0,0,,Демон Каджу жарылып шығады
Dialogue: 0,0:44:15.63,0:44:17.32,Default,,0,0,0,,Анашым, балмұздақ.
Dialogue: 0,0:44:17.32,0:44:19.45,Default,,0,0,0,,Менің анам кім?
Dialogue: 0,0:44:24.50,0:44:26.61,Default,,0,0,0,,Мен жалықтым.
Dialogue: 0,0:44:26.61,0:44:31.52,Default,,0,0,0,,Жазғы емтихан кезінде бәрі бос емес.
Dialogue: 0,0:44:31.52,0:44:33.27,Default,,0,0,0,,Ал, біз не істеуіміз керек?
Dialogue: 0,0:44:33.27,0:44:34.14,Default,,0,0,0,,Не?
Dialogue: 0,0:44:34.14,0:44:35.81,Default,,0,0,0,,Ум, мансап жолы?
Dialogue: 0,0:44:35.81,0:44:39.58,Default,,0,0,0,,Мен сарапшымын. Өтініш бланкісінде бәрі жақсы сияқты.
Dialogue: 0,0:44:39.58,0:44:40.88,Default,,0,0,0,,Уф…
Dialogue: 0,0:44:40.88,0:44:41.87,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:44:41.87,0:44:45.24,Default,,0,0,0,,Хмм, әртүрлі заттар.
Dialogue: 0,0:44:45.24,0:44:47.12,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:44:48.60,0:44:52.00,Default,,0,0,0,,Енді ойлап қарасам, олай емес, бірақ...
Dialogue: 0,0:44:52.00,0:44:55.67,Default,,0,0,0,,Сіз бір жерге барасыз ба?
Dialogue: 0,0:44:57.82,0:45:00.58,Default,,0,0,0,,Жазғы естелік сияқты
Dialogue: 0,0:45:00.58,0:45:07.18,Default,,0,0,0,,Жоқ. жоқ! Жоқ!
Dialogue: 0,0:45:07.18,0:45:09.85,Default,,0,0,0,,Мен Акитаға барамын
Dialogue: 0,0:45:11.26,0:45:13.13,Default,,0,0,0,,Акита?
Dialogue: 0,0:45:14.74,0:45:20.03,Default,,0,0,0,,Міне, тамыз айында ұлттық сынақ емтиханын тапсыру кезінде мыналарды ескеру қажет.
Dialogue: 0,0:45:20.03,0:45:24.78,Default,,0,0,0,,Аа, форма киген жөн деп жазылған, бірақ оны киюге еркінсің.
Dialogue: 0,0:45:24.80,0:45:28.16,Default,,0,0,0,,Басталу уақыты - дәл 10 сағат.
Dialogue: 0,0:45:28.16,0:45:32.87,Default,,0,0,0,,Кешігіп қалсаңыз, сізді кіргізбейді. Тек сақ болыңыз.
Dialogue: 0,0:45:36.93,0:45:40.92,Default,,0,0,0,,2-платформа Пойыз келе жатыр. Сары жолдың ішінде тұрып, күтіңіз.
Dialogue: 0,0:45:41.60,0:45:45.48,Default,,0,0,0,,Біз бір-бірімізді мүлде танымаймыз.
Dialogue: 0,0:45:45.48,0:45:48.60,Default,,0,0,0,,Не айтып тұрсың, Құсақабе?
Dialogue: 0,0:45:48.60,0:45:50.89,Default,,0,0,0,,Біраз кездесейік, жарай ма?
Dialogue: 0,0:46:18.22,0:46:23.63,Default,,0,0,0,,Осылай айту. Бұл не, ақымақ?
Dialogue: 0,0:46:34.90,0:46:39.56,Default,,0,0,0,,Ұзақ, ұзақ жазғы демалыс.
Dialogue: 0,0:46:43.53,0:46:44.57,Default,,0,0,0,,Ау, ауырып тұр.
Dialogue: 0,0:46:44.57,0:46:45.22,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:45.22,0:46:48.32,Default,,0,0,0,,Жоқ, ол бүгін бұзылды. Ол аурады!
Dialogue: 0,0:46:48.32,0:46:49.28,Default,,0,0,0,,Дезинфекция, дезинфекция.
Dialogue: 0,0:46:52.24,0:46:54.55,Default,,0,0,0,,Аа, бұл жақсы сезінеді.
Dialogue: 0,0:46:54.55,0:46:57.47,Default,,0,0,0,,Бұл баға таңқаларлық, оның ішінде бір түн және екі мезгіл тамақ.
Dialogue: 0,0:46:57.47,0:46:59.76,Default,,0,0,0,,Оның үстіне ыстық су көздеріне қалағаныңызша кіруге болады.
Dialogue: 0,0:46:59.76,0:47:01.63,Default,,0,0,0,,Үйге келгенше әдемі адам боласың.
Dialogue: 0,0:47:02.52,0:47:06.04,Default,,0,0,0,,Мен Саджомен бірге келгім келеді.
Dialogue: 0,0:47:06.04,0:47:09.84,Default,,0,0,0,,Аа, мен тек эротикалық нәрселер туралы ойлаймын.
Dialogue: 0,0:47:11.98,0:47:14.81,Default,,0,0,0,,Сен және анау, Саджо-кун.
Dialogue: 0,0:47:15.45,0:47:19.45,Default,,0,0,0,,Ум, сіз кездесіп жүрсіз бе?
Dialogue: 0,0:47:19.45,0:47:21.21,Default,,0,0,0,,Біз кездесіп жатырмыз.
Dialogue: 0,0:47:22.65,0:47:23.65,Default,,0,0,0,,Тарту?
Dialogue: 0,0:47:23.65,0:47:29.74,Default,,0,0,0,,Жоқ, жоқ, ой, дұрыс. Жоқ, дұрыс. Мен қарсы емеспін, бірақ
Dialogue: 0,0:47:29.74,0:47:31.33,Default,,0,0,0,,Мен қорықтым.
Dialogue: 0,0:47:32.66,0:47:35.62,Default,,0,0,0,,Жоқ, бірақ бұл мағынасы бар деп ойлаймын.
Dialogue: 0,0:47:37.29,0:47:38.54,Default,,0,0,0,,Келісесіз бе?
Dialogue: 0,0:47:38.56,0:47:40.67,Default,,0,0,0,,А, сен...
Dialogue: 0,0:47:40.67,0:47:44.05,Default,,0,0,0,,Қыздар туралы мұндай әңгіме ойлап таппайды.
Dialogue: 0,0:47:44.05,0:47:46.44,Default,,0,0,0,,Мен танысу немесе сол сияқты нәрселер туралы білмеймін.
Dialogue: 0,0:47:46.44,0:47:50.52,Default,,0,0,0,,Келгенді жоққа шығармай, кеткенді қумаймын деген сияқты.
Dialogue: 0,0:47:50.52,0:47:52.26,Default,,0,0,0,,Сонымен, мен өзімді...
Dialogue: 0,0:47:53.06,0:47:57.03,Default,,0,0,0,,Мен сені ғашық бола алмайтын адам деп ойладым.
Dialogue: 0,0:47:57.03,0:47:59.56,Default,,0,0,0,,Сонымен, бұл шынымен жақсырақ болды, солай емес пе?
Dialogue: 0,0:47:59.56,0:48:02.86,Default,,0,0,0,,Сізді уайымдағаны осы ма еді?
Dialogue: 0,0:48:02.86,0:48:06.99,Default,,0,0,0,,Дәлірек айтқанда, бұл солай емес пе? Алғашқы махаббат сияқты.
Dialogue: 0,0:48:15.37,0:48:20.87,Default,,0,0,0,,Уау! Уау, мен мұны тарта аламын, мен оны тарта аламын!
Dialogue: 0,0:48:20.87,0:48:23.74,Default,,0,0,0,,Әй, біртүрлі айтқаның үшін ғой, ақымақ!
Dialogue: 0,0:48:23.74,0:48:28.12,Default,,0,0,0,,Әй, бұл қызықты 100% лимон шырыны! Ұят!
Dialogue: 0,0:48:28.12,0:48:29.96,Default,,0,0,0,,Ащы мен тәттінің дәмін тат!
Dialogue: 0,0:48:29.96,0:48:31.34,Default,,0,0,0,,Не!
Dialogue: 0,0:48:31.35,0:48:35.27,Default,,0,0,0,,Алғашқы махаббат. Алғашқы махаббат?
Dialogue: 0,0:48:40.41,0:48:44.16,Default,,0,0,0,,Тосито, емтихан билетіңіз болды ма? Жазу құралдары туралы не деуге болады?
Dialogue: 0,0:48:44.16,0:48:46.11,Default,,0,0,0,,Бұл сынақ емтихан, мама.
Dialogue: 0,0:48:46.54,0:48:49.88,Default,,0,0,0,,Әй, анаңды үйге көлікпен апаруым керек пе?
Dialogue: 0,0:48:49.88,0:48:55.20,Default,,0,0,0,,Сіздің жұмысыңыз бар, солай ма? Жарайды жалғыз өзім жақсымын.
Dialogue: 0,0:49:03.52,0:49:08.16,Default,,0,0,0,,Бұл менің басымнан өткенде бір сәт ойланбадың ба?
Dialogue: 0,0:49:08.16,0:49:09.59,Default,,0,0,0,,Қашықтық және уақыт
Dialogue: 0,0:49:10.10,0:49:11.78,Default,,0,0,0,,Мен бұл туралы ойладым
Dialogue: 0,0:49:11.78,0:49:14.26,Default,,0,0,0,,Неге маған тікелей айтпайсың? маған
Dialogue: 0,0:49:14.26,0:49:19.89,Default,,0,0,0,,Өйткені, оны қалай айтуым керек?
Dialogue: 0,0:49:21.64,0:49:25.53,Default,,0,0,0,,Егер мұндай бұзушылықтар болмаса, мен бұл туралы ешқашан білмес едім,
Dialogue: 0,0:49:25.53,0:49:26.74,Default,,0,0,0,,Тек кет...
Dialogue: 0,0:49:26.74,0:49:29.51,Default,,0,0,0,,Олай емес. Демек, бұл жай ғана, солай емес пе?
Dialogue: 0,0:49:29.51,0:49:31.82,Default,,0,0,0,,Сіз мәселені кейінге қалдырып жатырсыз.
Dialogue: 0,0:49:31.82,0:49:33.85,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:49:34.71,0:49:36.41,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:49:47.85,0:49:51.82,Default,,0,0,0,,Сайып келгенде, Саджо бұрыннан шешілген нәрсені өзгертуге ниеті жоқ.
Dialogue: 0,0:49:51.82,0:49:53.21,Default,,0,0,0,,Сіз бұлай айтқан жоқсыз!
Dialogue: 0,0:49:53.21,0:49:55.50,Default,,0,0,0,,Тіпті мен не істерімді білмеймін...
Dialogue: 0,0:49:55.50,0:49:58.90,Default,,0,0,0,,Сіз бұл туралы айтып, менімен қиындыққа тап болғыңыз келмеді, солай ма?
Dialogue: 0,0:49:58.90,0:50:00.39,Default,,0,0,0,,Жоқ, Құсақабе!
Dialogue: 0,0:50:02.91,0:50:07.54,Default,,0,0,0,,Мендегі заттар да табиғи түрде жоғалып кетті.
Dialogue: 0,0:50:07.54,0:50:10.82,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:50:10.82,0:50:12.32,Default,,0,0,0,,Жалғыз емессің бе?
Dialogue: 0,0:50:13.47,0:50:17.11,Default,,0,0,0,,Сіз мені көргіңіз келеді.
Dialogue: 0,0:50:18.20,0:50:19.24,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:50:25.90,0:50:31.71,Default,,0,0,0,,Аа, қосылды, қосылды. Қазір қайдасың? Ум, сыртта ма?
Dialogue: 0,0:50:31.71,0:50:33.17,Default,,0,0,0,,, пойыздар.
Dialogue: 0,0:50:33.17,0:50:35.68,Default,,0,0,0,,О, не болды?
Dialogue: 0,0:50:35.68,0:50:40.72,Default,,0,0,0,,Мас болып, сосын түс. кана.
Dialogue: 0,0:50:40.72,0:50:41.40,Default,,0,0,0,,Қайда?
Dialogue: 0,0:50:41.40,0:50:42.93,Default,,0,0,0,,Са, Сажо...
Dialogue: 0,0:50:50.18,0:50:52.20,Default,,0,0,0,,Маған бұл түс ұнайды
Dialogue: 0,0:50:52.20,0:50:53.44,Default,,0,0,0,,Лимон сары?
Dialogue: 0,0:50:53.46,0:50:56.12,Default,,0,0,0,,Иә, бұл жақсы. Жаз сияқты сезіледі.
Dialogue: 0,0:50:56.12,0:50:58.20,Default,,0,0,0,,That's right.
Dialogue: 0,0:50:58.20,0:51:02.02,Default,,0,0,0,,Саджо Саджо-кун Саджо-кун Саджо
Dialogue: 0,0:51:02.02,0:51:02.84,Default,,0,0,0,,Мені шақырған жоқ.
Dialogue: 0,0:51:02.84,0:51:05.16,Default,,0,0,0,,Ах, бірақ
Dialogue: 0,0:51:06.90,0:51:08.28,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:51:08.28,0:51:09.38,Default,,0,0,0,,О, өйткені
Dialogue: 0,0:51:09.38,0:51:10.94,Default,,0,0,0,,Сізге ұнамады ма?
Dialogue: 0,0:51:10.94,0:51:12.25,Default,,0,0,0,,Оны қайтадан байлаңыз.
Dialogue: 0,0:51:12.26,0:51:17.05,Default,,0,0,0,,Бірақ, бірақ, ол бұрынғыдай болмайды.
Dialogue: 0,0:51:18.40,0:51:25.00,Default,,0,0,0,,Бірдей болмаса да, жақсы. Басқаша байланған болса да қызық.
Dialogue: 0,0:51:25.00,0:51:28.18,Default,,0,0,0,,Сонымен қатар, түс өзгермейді.
Dialogue: 0,0:51:28.18,0:51:32.35,Default,,0,0,0,,Саджо...Саджо-кун...Саджо...Саджо!
Dialogue: 0,0:51:32.35,0:51:34.44,Default,,0,0,0,,Сажо!
Dialogue: 0,0:51:37.12,0:51:40.32,Default,,0,0,0,,А, жақсы. Мен қатты қорықтым. Мені қорқытпа, әр жолы.
Dialogue: 0,0:51:40.32,0:51:42.32,Default,,0,0,0,,Немесе, форма ма? Қайда бара жатырсың?
Dialogue: 0,0:51:42.32,0:51:45.16,Default,,0,0,0,,Иә? Ал таспа ше?
Dialogue: 0,0:51:49.50,0:51:51.57,Default,,0,0,0,,9:30...
Dialogue: 0,0:51:55.16,0:52:03.05,Default,,0,0,0,,Жоқ. Ұлттық сынақ емтиханы таңғы сағат 10-да басталса, бұл жақсы емес. Қайта түседі.
Dialogue: 0,0:52:03.05,0:52:04.30,Default,,0,0,0,,Бұл сынақ сынақ, солай ма?
Dialogue: 0,0:52:04.30,0:52:05.89,Default,,0,0,0,,Қабылдау емтихандарына да солай!
Dialogue: 0,0:52:07.24,0:52:14.28,Default,,0,0,0,,Бәрі құлады. Орта мектепке түсу емтихандары, барлық қалаған мектептер. Мен пойызға бара алмаймын. Ол аяқтады.
Dialogue: 0,0:52:14.28,0:52:16.27,Default,,0,0,0,,Дәл солай. Ол аяқтады.
Dialogue: 0,0:52:16.27,0:52:17.80,Default,,0,0,0,,Құлап қалсаң да болады.
Dialogue: 0,0:52:17.80,0:52:18.90,Default,,0,0,0,,Сен менің абыройымды осы лайға батырдың!
Dialogue: 0,0:52:18.90,0:52:25.58,Default,,0,0,0,,Жоқ, өйткені. Саджоның ақылды болғаны сонша, ол орта мектепке қабылданды.
Dialogue: 0,0:52:26.02,0:52:30.50,Default,,0,0,0,,Біз сыныптас болып кеттік.
Dialogue: 0,0:52:31.85,0:52:35.96,Default,,0,0,0,,Ал, көңіл күйлерің қалай? Сіз оны тұрғызғыңыз келе ме?
Dialogue: 0,0:52:37.42,0:52:39.38,Default,,0,0,0,,Бәлкім, сіз оны уақытында ұшырып жіберсеңіз
Dialogue: 0,0:52:41.84,0:52:45.90,Default,,0,0,0,,Мен лицензиямды Акита қаласында алдым. Оқу-жаттығу жиынында.
Dialogue: 0,0:52:45.90,0:52:46.94,Default,,0,0,0,,Акита?
Dialogue: 0,0:52:46.94,0:52:52.12,Default,,0,0,0,,Бір жақсысы, ыстық бұлақ бар. Иә, қонақүйдегі қабылдау нашар.
Dialogue: 0,0:52:52.12,0:52:54.23,Default,,0,0,0,,Мен телефон соғу мүмкін емес.
Dialogue: 0,0:52:54.56,0:52:56.70,Default,,0,0,0,,Мен біраз қорықтым.
Dialogue: 0,0:52:56.70,0:53:00.77,Default,,0,0,0,,Ендеше, бірге ыстық бұлаққа барайық.
Dialogue: 0,0:53:00.77,0:53:02.11,Default,,0,0,0,,Әй, жүр.
Dialogue: 0,0:53:06.55,0:53:08.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:53:08.08,0:53:08.94,Default,,0,0,0,,Не?
Dialogue: 0,0:53:08.94,0:53:13.06,Default,,0,0,0,,Жоқ, Саджо түсу емтихандары мен басқа нәрселермен қатты жұмыс істейді.
Dialogue: 0,0:53:13.06,0:53:16.33,Default,,0,0,0,,Мен өзімді жалғыз қалғандай сезіндім.
Dialogue: 0,0:53:16.33,0:53:19.46,Default,,0,0,0,,Көңілсіз және бағынышты болу
Dialogue: 0,0:53:19.46,0:53:22.90,Default,,0,0,0,,Ештеңе істемегеніме мен кінәлімін.
Dialogue: 0,0:53:22.90,0:53:25.84,Default,,0,0,0,,Сондықтан мен де алға жылжуды жөн көрдім.
Dialogue: 0,0:53:30.30,0:53:34.78,Default,,0,0,0,,Ал мен болсам, қалай өмір сүрсем де, өкінетін кезім болады.
Dialogue: 0,0:53:34.78,0:53:39.01,Default,,0,0,0,,Керісінше, бірдеңе ұту керек деп ойлаймын. Бірақ,
Dialogue: 0,0:53:39.01,0:53:43.24,Default,,0,0,0,,Саджомен ажырасу әзірге мүмкін емес.
Dialogue: 0,0:53:50.29,0:53:53.43,Default,,0,0,0,,Мен де емеспін
Dialogue: 0,0:53:56.60,0:53:59.92,Default,,0,0,0,,Сондықтан таспаны оңай кесіп алмаңыз.
Dialogue: 0,0:53:59.92,0:54:01.84,Default,,0,0,0,,Таспа?
Dialogue: 0,0:54:03.10,0:54:04.80,Default,,0,0,0,,5 минут бұрын!
Dialogue: 0,0:54:04.80,0:54:05.30,Default,,0,0,0,,Сіз оны уақытында жасайсыз ба? Уақытында!
Dialogue: 0,0:54:05.30,0:54:06.82,Default,,0,0,0,,(Каори) Қорқатын ештеңе жоқ, бәрі жақсы болады! Ақыры біз ең мықтымыз ғой.
Dialogue: 0,0:54:06.82,0:54:08.18,Default,,0,0,0,,Демалыңыз!
Dialogue: 0,0:54:08.18,0:54:09.26,Default,,0,0,0,,Құсақабе!
Dialogue: 0,0:54:09.26,0:54:10.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:15.02,0:54:15.69,Default,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,0:54:20.15,0:54:22.61,Default,,0,0,0,,Мен күтемін! сен!
Dialogue: 0,0:54:25.34,0:54:26.74,Default,,0,0,0,,Ендеше бастайық!
Dialogue: 0,0:55:06.52,0:55:10.26,Default,,0,0,0,,Ах! Ой, ұйықтап жаттың ба? мен
Dialogue: 0,0:55:10.26,0:55:11.51,Default,,0,0,0,,Иә
Dialogue: 0,0:55:12.96,0:55:14.04,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:55:14.04,0:55:15.33,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:55:15.64,0:55:18.87,Default,,0,0,0,,да жақсы. Маған бәрі бір.
Dialogue: 0,0:55:18.87,0:55:22.87,Default,,0,0,0,,Сен менің жанымдасың, сондықтан маған керегі осы.
Dialogue: 0,0:55:27.40,0:55:28.42,Default,,0,0,0,,Менің шайнағым келеді
Dialogue: 0,0:55:28.42,0:55:31.22,Default,,0,0,0,,Жоқ, басқа біреу бар.
Dialogue: 0,0:55:31.24,0:55:33.55,Default,,0,0,0,,Бұл емес пе?
Dialogue: 0,0:55:56.76,0:55:57.50,Default,,0,0,0,,Моккай
Dialogue: 0,0:55:57.50,0:55:58.93,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:56:01.32,0:56:06.00,Default,,0,0,0,,Жақын жерде болу. Бұл жеткілікті.
Dialogue: 0,0:56:07.14,0:56:10.22,Default,,0,0,0,,Осылай деп сен мені сүйдің.
Dialogue: 0,0:56:14.22,0:56:16.69,Default,,0,0,0,,Екінші жаз келді
Dialogue: 0,0:56:23.65,0:56:28.03,Default,,0,0,0,,Сағат қажет емес
Dialogue: 0,0:56:28.74,0:56:34.02,Default,,0,0,0,,Қолшатырдың өлшеусіз серіппесі
Dialogue: 0,0:56:34.02,0:56:39.00,Default,,0,0,0,,Тұру және жүру
Dialogue: 0,0:56:39.00,0:56:43.17,Default,,0,0,0,,Екі адам арасындағы қашықтық
Dialogue: 0,0:56:43.79,0:56:49.76,Default,,0,0,0,,Бірнеше сантиметр өте алыс
Dialogue: 0,0:56:51.55,0:56:56.55,Default,,0,0,0,,Жүр, қазір ұш.
Dialogue: 0,0:56:56.55,0:56:58.75,Default,,0,0,0,,Жазғы бұлттарды ұстадым
Dialogue: 0,0:56:58.75,0:57:11.45,Default,,0,0,0,,Пішіні жоқ қытық сезім сияқты.
Dialogue: 0,0:57:11.94,0:57:18.83,Default,,0,0,0,,Жел соғып, Мазасыз болдым, кеттік
Dialogue: 0,0:57:22.12,0:57:27.13,Default,,0,0,0,,Сіз күліп тұрсыз ба?
Dialogue: 0,0:57:27.13,0:57:32.51,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:57:32.51,0:57:37.14,Default,,0,0,0,,Шешмейік
Dialogue: 0,0:57:37.14,0:57:42.02,Default,,0,0,0,,Осылай жалғастырайық
Dialogue: 0,0:57:42.77,0:57:47.69,Default,,0,0,0,,Сағат тілін ораңыз
Dialogue: 0,0:57:47.69,0:57:52.85,Default,,0,0,0,,Үшінші көрінбейтін күзде
Dialogue: 0,0:57:52.85,0:57:57.91,Default,,0,0,0,,Өзіңізді кішірейтіңіз
Dialogue: 0,0:57:57.91,0:58:02.79,Default,,0,0,0,,Жаяу жүру
Dialogue: 0,0:58:02.79,0:58:10.05,Default,,0,0,0,,Екі адам арасындағы қашықтық
Dialogue: 0,0:59:06.85,0:59:11.98,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:59:11.98,0:59:16.99,Default,,0,0,0,,Біз кездескен күн туралы
Dialogue: 0,0:59:16.99,0:59:21.95,Default,,0,0,0,,Әлі де сол
Dialogue: 0,0:59:21.95,0:59:27.36,Default,,0,0,0,,Осылай жалғасады.
Dialogue: 0,0:59:27.36,0:59:32.54,Default,,0,0,0,,Жүр, қазір ұшып кетелік.
Dialogue: 0,0:59:32.56,0:59:37.49,Default,,0,0,0,,Жыл мезгілдерінің шетінде
Dialogue: 0,0:59:37.49,0:59:42.64,Default,,0,0,0,,Мен қанша жүре аламын деп ойлаймын
Dialogue: 0,0:59:42.64,0:59:47.19,Default,,0,0,0,,Іздеу
Dialogue: 0,0:59:47.64,0:59:52.69,Default,,0,0,0,,Сіз жел соқтырады деп күтесіз бе?
Dialogue: 0,0:59:52.69,0:59:55.40,Default,,0,0,0,,Мәңгі
Dialogue: 0,0:59:56.90,1:00:02.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory