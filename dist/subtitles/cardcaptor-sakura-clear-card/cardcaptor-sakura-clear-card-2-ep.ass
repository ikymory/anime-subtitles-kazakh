Dialogue: 1,0:01:22.27,0:01:26.69,OP BLACK,,0,0,0,,Әрі қарай!
Dialogue: 0,0:22:50.68,0:22:54.93,OP BLACK,,0,0,0,,Бір күндік таңдану
Dialogue: 0,0:22:54.93,0:22:58.65,OP BLACK,,0,0,0,,Ағымдағы жады
Dialogue: 0,0:23:00.44,0:23:04.40,OP BLACK,,0,0,0,,Үміт, сапа, махаббат және арман
Dialogue: 0,0:23:04.94,0:23:08.28,OP BLACK,,0,0,0,,...
Dialogue: 0,0:23:10.16,0:23:17.91,OP BLACK,,0,0,0,,Баланың өлімін қайталау
Dialogue: 0,0:23:19.79,0:23:29.55,OP BLACK,,0,0,0,,Дегенмен, қазына әлі де жоғалып, өзгерген.
Dialogue: 0,0:23:30.72,0:23:32.55,OP BLACK,,0,0,0,,Қажет емес
Dialogue: 0,0:23:34.35,0:23:39.73,OP BLACK,,0,0,0,,Несие сомасы
Dialogue: 0,0:23:41.31,0:23:46.23,OP BLACK,,0,0,0,,Қазіргі уақытта қол жетімді
Dialogue: 0,0:23:46.23,0:23:50.86,OP BLACK,,0,0,0,,Дегенмен, мен турашыл, білімдімін.
Dialogue: 0,0:23:51.03,0:23:51.95,OP BLACK,,0,0,0,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 0,0:23:53.74,0:23:57.70,OP BLACK,,0,0,0,,Жүрегіңде қайдасың?
Dialogue: 0,0:23:58.29,0:24:01.96,OP BLACK,,0,0,0,,jewelry
Dialogue: 0,0:24:01.96,0:24:05.59,OP BLACK,,0,0,0,,Уақытқа күмәнім жоқ
Dialogue: 0,0:24:05.59,0:24:09.59,OP BLACK,,0,0,0,,Кітапты қалай оқу керек
Dialogue: 1,0:22:50.68,0:22:54.93,OP BLACK,,0,0,0,,Бір күндік таңдану
Dialogue: 1,0:22:54.93,0:22:58.65,OP BLACK,,0,0,0,,Ең жаңа жады
Dialogue: 1,0:23:00.44,0:23:04.40,OP BLACK,,0,0,0,,Үміт, сапа, махаббат және арман
Dialogue: 1,0:23:04.94,0:23:08.28,OP BLACK,,0,0,0,,...
Dialogue: 1,0:23:10.16,0:23:17.91,OP BLACK,,0,0,0,,Баланың өлімін қайталау
Dialogue: 1,0:23:19.79,0:23:29.55,OP BLACK,,0,0,0,,Дегенмен, қазына әлі де жоғалып, өзгерген.
Dialogue: 1,0:23:30.72,0:23:32.55,OP BLACK,,0,0,0,,Қажет емес
Dialogue: 1,0:23:34.35,0:23:39.73,OP BLACK,,0,0,0,,Несие сомасы
Dialogue: 1,0:23:41.31,0:23:46.23,OP BLACK,,0,0,0,,Қазіргі уақытта аздап ұятсыз дереу пайдалануға болады
Dialogue: 1,0:23:46.23,0:23:50.86,OP BLACK,,0,0,0,,Дегенмен, мен турашыл, білімдімін.
Dialogue: 1,0:23:51.03,0:23:51.95,OP BLACK,,0,0,0,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 1,0:23:53.74,0:23:57.70,OP BLACK,,0,0,0,,Жүрегіңде қайдасың?
Dialogue: 1,0:23:58.29,0:24:01.96,OP BLACK,,0,0,0,,jewelry
Dialogue: 1,0:24:01.96,0:24:05.59,OP BLACK,,0,0,0,,Уақыт туралы күмән жоқ
Dialogue: 1,0:24:05.59,0:24:09.59,OP BLACK,,0,0,0,,Кітапты қалай оқу керек
Dialogue: 0,0:01:30.51,0:01:31.39,TEXT JP,,0,0,0,,Қайырлы таң
Dialogue: 0,0:01:31.51,0:01:32.37,TEXT JP,,0,0,0,,Қайырлы таң
Dialogue: 0,0:01:32.58,0:01:34.37,TEXT JP,,0,0,0,,Эй, сен кеше драманы көрдің бе?
Dialogue: 0,0:01:40.60,0:01:42.25,TEXT JP,,0,0,0,,Жаңа карталар?
Dialogue: 0,0:01:42.69,0:01:43.31,TEXT JP,,0,0,0,,Иә...
Dialogue: 0,0:01:43.92,0:01:44.76,TEXT JP,,0,0,0,,Кейінірек
Dialogue: 0,0:01:45.59,0:01:46.40,TEXT JP,,0,0,0,,Сондай-ақ кілт
Dialogue: 0,0:01:47.68,0:01:49.55,TEXT JP,,0,0,0,,Ол мөлдір.
Dialogue: 0,0:01:50.13,0:01:50.89,TEXT JP,,0,0,0,,Бірақ
Dialogue: 0,0:01:51.28,0:01:54.42,TEXT JP,,0,0,0,,Мен мұны істесем де, екінші жағындағы үлгі көрінбейді.
Dialogue: 0,0:01:56.68,0:01:59.96,TEXT JP,,0,0,0,,Кенеттен мөлдір болып кеткен алдыңғы карталар
Dialogue: 0,0:02:00.45,0:02:03.41,TEXT JP,,0,0,0,,Мен осылайша жаңа карта алдым
Dialogue: 0,0:02:04.14,0:02:06.41,TEXT JP,,0,0,0,,Мұның бәрі біртүрлі.
Dialogue: 0,0:02:07.57,0:02:10.87,TEXT JP,,0,0,0,,Бірақ одан да маңызды нәрсе бар.
Dialogue: 0,0:02:11.34,0:02:12.24,TEXT JP,,0,0,0,,Не?
Dialogue: 0,0:02:13.33,0:02:15.83,TEXT JP,,0,0,0,,Алғашқы Sakura-chan жаңа картасын алыңыз
Dialogue: 0,0:02:15.83,0:02:18.33,TEXT JP,,0,0,0,,Мен суретке түсіре алмадым!
Dialogue: 0,0:02:18.62,0:02:19.25,TEXT JP,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:02:19.69,0:02:20.41,TEXT JP,,0,0,0,,Үлкен күшпен
Dialogue: 0,0:02:20.69,0:02:23.79,TEXT JP,,0,0,0,,Жаңа шығарманы дайындап үлгерсем де.
Dialogue: 0,0:02:24.33,0:02:25.42,TEXT JP,,0,0,0,,Уай жоқ Хаа
Dialogue: 0,0:02:25.74,0:02:26.76,TEXT JP,,0,0,0,,Мен таққа таласудан шығып қалдым. Енді бәрі бітті.
Dialogue: 0,0:02:27.37,0:02:28.40,TEXT JP,,0,0,0,,Миссия үшін,
Dialogue: 0,0:02:29.04,0:02:30.22,TEXT JP,,0,0,0,,Иә!
Dialogue: 0,0:02:30.93,0:02:32.13,TEXT JP TOP,,0,0,0,,Иә!
Dialogue: 0,0:02:33.28,0:02:34.55,TEXT JP TOP,,0,0,0,,Иә!
Dialogue: 0,0:02:35.46,0:02:36.80,TEXT JP TOP,,0,0,0,,Иә!
Dialogue: 0,0:02:38.10,0:02:39.22,TEXT JP TOP,,0,0,0,,Иә!
Dialogue: 0,0:02:31.88,0:02:34.41,TEXT JP,,0,0,0,,Daidoji-де ол шынымен де өзгерген жоқ.
Dialogue: 0,0:02:34.71,0:02:35.36,TEXT JP,,0,0,0,,Иә
Dialogue: 0,0:02:36.67,0:02:39.51,TEXT JP,,0,0,0,,Бірақ мен сенің зардап шекпегеніңе өте қуаныштымын.
Dialogue: 0,0:02:40.06,0:02:41.69,TEXT JP,,0,0,0,,Иә, рахмет
Dialogue: 0,0:02:44.78,0:02:46.21,TEXT JP,,0,0,0,,Сіз қалай ойлайсыз? Сяоран-кун
Dialogue: 0,0:02:50.18,0:02:52.12,TEXT JP,,0,0,0,,Мен Сакураның күшін ғана сезіне аламын
Dialogue: 0,0:02:53.62,0:02:54.52,TEXT JP,,0,0,0,,Мен де
Dialogue: 0,0:02:56.31,0:02:58.51,TEXT JP,,0,0,0,,Бірақ тағы да неге?
Dialogue: 0,0:02:59.41,0:03:01.83,TEXT JP,,0,0,0,,Мен Томеда Таун қаласында осындай нәрсе бола ма деп ойлаймын.
Dialogue: 0,0:03:08.96,0:03:10.93,TEXT JP,,0,0,0,,Маған тағы да сөйлесуге рұқсат етіңіз.
Dialogue: 0,0:03:11.32,0:03:11.85,TEXT JP,,0,0,0,,О
Dialogue: 0,0:03:16.00,0:03:16.76,TEXT JP,,0,0,0,,Сакура…
Dialogue: 0,0:03:26.38,0:03:27.40,TEXT JP,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:27.83,0:03:28.64,TEXT JP,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:29.34,0:03:30.62,TEXT JP,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:30.88,0:03:32.18,TEXT JP,,0,0,0,,Жақсы
Dialogue: 0,0:03:32.59,0:03:33.89,TEXT JP,,0,0,0,,Әлі жоқ, мұғалім.
Dialogue: 0,0:03:34.29,0:03:35.03,TEXT JP,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:35.40,0:03:37.13,TEXT JP,,0,0,0,,Сакура-чан Томойо-чан
Dialogue: 0,0:03:37.44,0:03:38.84,TEXT JP,,0,0,0,,Қайырлы таң, Чихару-чан
Dialogue: 0,0:03:39.15,0:03:40.38,TEXT JP,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:41.37,0:03:43.70,TEXT JP,,0,0,0,,Иә Чизкейк қалай жасалады
Dialogue: 0,0:03:44.06,0:03:44.95,TEXT JP,,0,0,0,,Уау!
Dialogue: 0,0:03:45.08,0:03:46.20,TEXT JP,,0,0,0,,Рахмет
Dialogue: 0,0:03:46.55,0:03:48.12,TEXT JP,,0,0,0,,Бұл менің өз жолым...
Dialogue: 0,0:03:48.96,0:03:50.70,TEXT JP,,0,0,0,,Чихару-чанның ірімшік торты
Dialogue: 0,0:03:50.70,0:03:53.15,TEXT JP,,0,0,0,,Мен білгім келді, өйткені ол өте дәмді болды.
Dialogue: 0,0:03:53.95,0:03:56.59,TEXT JP,,0,0,0,,Жеміс соусы да тамаша болды.
Dialogue: 0,0:03:57.24,0:04:00.63,TEXT JP,,0,0,0,,Бүгін мен оны бірден Томойо-чанмен жасауға тырысамын.
Dialogue: 0,0:04:01.01,0:04:02.59,TEXT JP,,0,0,0,,Маған ойыңызды айтыңыз.
Dialogue: 0,0:04:02.64,0:04:03.20,TEXT JP,,0,0,0,,Иә
Dialogue: 0,0:04:04.43,0:04:05.72,TEXT JP,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:06.30,0:04:08.23,TEXT JP,,0,0,0,,Орынға отырыңыз
Dialogue: 0,0:04:08.46,0:04:09.89,TEXT JP TOP,,0,0,0,,Yes
Dialogue: 0,0:04:08.96,0:04:09.98,TEXT JP,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:04:14.89,0:04:17.73,TEXT JP,,0,0,0,,Жақсылап жасай алсаң, барлығы жесін.
Dialogue: 0,0:04:18.56,0:04:19.87,TEXT JP,,0,0,0,,Сондай-ақ Сяоранға...
Dialogue: 0,0:04:22.91,0:04:23.61,TEXT JP,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:04:24.30,0:04:28.29,TEXT JP,,0,0,0,,Мен осы аптада қосылғым келетін клубқа қосылуға өтініш беруім керек.
Dialogue: 0,0:04:28.54,0:04:30.17,TEXT JP,,0,0,0,,Барлығы шешім қабылдады ма?
Dialogue: 0,0:04:31.03,0:04:32.53,TEXT JP TOP,,0,0,0,,Эй, сен әлі шештің бе?
Dialogue: 0,0:04:32.54,0:04:33.79,TEXT JP TOP,,0,0,0,,Мен қайда баруым керек?
Dialogue: 0,0:04:33.37,0:04:34.97,TEXT JP,,0,0,0,,Сакура-чан, сен шештің бе?
Dialogue: 0,0:04:35.43,0:04:37.09,TEXT JP,,0,0,0,,Иә, Томойо-чан ше?
Dialogue: 0,0:04:37.57,0:04:40.96,TEXT JP,,0,0,0,,Мен бастауыш сыныптағыдай хор үйірмесіне қатысуды ойлап жүрмін.
Dialogue: 0,0:04:41.27,0:04:43.47,TEXT JP,,0,0,0,,Мен де черлидинг клубының мүшесімін
Dialogue: 0,0:04:44.16,0:04:45.47,TEXT JP,,0,0,0,,Мүмкін Чихару-чан да шығар
Dialogue: 0,0:04:45.97,0:04:47.80,TEXT JP,,0,0,0,,Кейінірек сұрайық.
Dialogue: 0,0:04:49.05,0:04:51.63,TEXT JP,,0,0,0,,Ли қай клубта болады?
Dialogue: 0,0:04:52.00,0:04:53.10,TEXT JP,,0,0,0,,«Токио Доумдағы Джайентс матчында Шинигаминің бар-жоғын растау»
Dialogue: 0,0:04:53.78,0:04:57.16,TEXT JP,,0,0,0,,Бұрын үйірме жұмыстары болмаған.
Dialogue: 0,0:04:57.65,0:05:01.53,TEXT JP,,0,0,0,,Мектеп өмірі сабақтан кейін де сізге ұнайды деп үміттенемін.
Dialogue: 0,0:05:01.99,0:05:02.56,TEXT JP,,0,0,0,,Иә
Dialogue: 0,0:05:03.73,0:05:05.39,TEXT JP,,0,0,0,,Егер сіз спорт алаңына кірсеңіз
Dialogue: 0,0:05:05.57,0:05:07.90,TEXT JP,,0,0,0,,Чирлидинг клубы сізді қуанта алады.
Dialogue: 0,0:05:09.10,0:05:12.66,TEXT JP,,0,0,0,,Сакура-чанды осылай суретке түсіруге рұқсат етсеңіз.
Dialogue: 0,0:05:12.66,0:05:13.88,TEXT JP,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:05:16.87,0:05:18.95,TEXT JP,,0,0,0,,Мен де көңіл көтеремін
Dialogue: 0,0:05:19.61,0:05:20.85,TEXT JP,,0,0,0,,Біз қайтадан біргеміз.
Dialogue: 0,0:05:21.18,0:05:22.87,TEXT JP,,0,0,0,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:05:23.19,0:05:25.12,TEXT JP,,0,0,0,,Мен драма үйірмесіне қатыстым.
Dialogue: 0,0:05:25.29,0:05:30.10,TEXT JP,,0,0,0,,Томоеда орта мектебі де оқушылар жазған пьесаларды орындайды.
Dialogue: 0,0:05:31.06,0:05:34.61,TEXT JP,,0,0,0,,Бастауыш сыныпта оқып жүргенімде жазған сахналық сценарийім де тамаша болды.
Dialogue: 0,0:05:35.52,0:05:38.52,TEXT JP,,0,0,0,,Наоко-чанды тағы да сахнада көргім келеді.
Dialogue: 0,0:05:38.63,0:05:40.20,TEXT JP,,0,0,0,,Мен де сендерді жақсы көремін.
Dialogue: 0,0:05:40.72,0:05:41.67,TEXT JP,,0,0,0,,Рахмет
Dialogue: 0,0:05:43.19,0:05:44.43,TEXT JP,,0,0,0,,Ямадзаки мырза
Dialogue: 0,0:05:45.32,0:05:46.91,TEXT JP,,0,0,0,,Баскетбол клубынан алынған
Dialogue: 0,0:05:47.17,0:05:49.87,TEXT JP,,0,0,0,,А, сен тек ұзынсың.
Dialogue: 0,0:05:50.50,0:05:53.98,TEXT JP,,0,0,0,,Ракуго оқу тобы болса, мен оған қосылғым келетін еді.
Dialogue: 0,0:05:54.31,0:05:55.29,TEXT JP,,0,0,0,,№.
Dialogue: 0,0:05:56.55,0:05:59.42,TEXT JP,,0,0,0,,Сондықтан мен лакросс клубына барамын деп ойладым.
Dialogue: 0,0:06:00.56,0:06:02.70,TEXT JP,,0,0,0,,Бұл мүлдем маңызды емес.
Dialogue: 0,0:06:05.99,0:06:06.64,TEXT JP,,0,0,0,,Ли мырза
Dialogue: 0,0:06:07.87,0:06:09.72,TEXT JP,,0,0,0,,Мен клубтық іс-шараларға қатысуды жоспарламаймын.
Dialogue: 0,0:06:10.20,0:06:11.19,TEXT JP,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:06:12.00,0:06:13.98,TEXT JP,,0,0,0,,Мен жаңа ғана Гонконгтан келдім.
Dialogue: 0,0:06:14.99,0:06:16.84,TEXT JP,,0,0,0,,Кейде бірдеңе істеуге тура келеді
Dialogue: 0,0:06:19.79,0:06:21.89,TEXT JP,,0,0,0,,Не істеу керек?
Dialogue: 0,0:06:23.02,0:06:26.45,TEXT JP,,0,0,0,,Көптеген процедуралар мен реттелуі керек нәрселер бар.
Dialogue: 0,0:06:29.62,0:06:32.99,TEXT JP,,0,0,0,,Одан кейін үйірмеге кірген дұрыс.
Dialogue: 0,0:06:33.70,0:06:35.46,TEXT JP,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:06:37.01,0:06:38.83,TEXT JP,,0,0,0,,Менімен Вэй мырза келе ме?
Dialogue: 0,0:06:39.58,0:06:40.57,TEXT JP,,0,0,0,,Жоқ, мен жалғызбын.
Dialogue: 0,0:06:41.21,0:06:43.75,TEXT JP,,0,0,0,,Біраз уақыттан кейін мені тексеруге келетінін айтты.
Dialogue: 0,0:06:44.51,0:06:45.63,TEXT JP,,0,0,0,,Ичиго Сузу-чан
Dialogue: 0,0:06:46.24,0:06:48.35,TEXT JP,,0,0,0,,Себебі біз хабарлама арқылы жиі сөйлесеміз
Dialogue: 0,0:06:48.66,0:06:50.13,TEXT JP,,0,0,0,,Менен де жақсы білетін шығарсың.
Dialogue: 0,0:06:50.56,0:06:54.68,TEXT JP,,0,0,0,,Иә, сіз бізге әрқашан қызықты фотолар мен бейнелерді жібересіз.
Dialogue: 0,0:06:54.94,0:06:58.89,TEXT JP,,0,0,0,,Өткен күні фестивальде киген костюмің сүйкімді болды.
Dialogue: 0,0:06:59.08,0:07:01.47,TEXT JP,,0,0,0,,Иә, бұл өте сүйкімді болды.
Dialogue: 0,0:07:01.92,0:07:04.11,TEXT JP,,0,0,0,,Анықтама ретінде қолдандым.
Dialogue: 0,0:07:04.43,0:07:05.03,TEXT JP,,0,0,0,,Бұл?
Dialogue: 0,0:07:05.52,0:07:07.57,TEXT JP,,0,0,0,,Сізге сәйкес келетініне сенімдімін.
Dialogue: 0,0:07:08.49,0:07:11.53,TEXT JP,,0,0,0,,Бірақ Ли менімен бірге суретте болмады.
Dialogue: 0,0:07:12.71,0:07:16.47,TEXT JP,,0,0,0,,Әй, ол кезде менің бір шаруам бар еді.
Dialogue: 0,0:07:17.22,0:07:19.09,TEXT JP,,0,0,0,,Мен фестивальге қатысқан жоқпын.
Dialogue: 0,0:07:20.05,0:07:21.23,TEXT JP,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:21.82,0:07:24.06,TEXT JP,,0,0,0,,Мен оны міндетті түрде анықтама ретінде пайдаланғым келеді.
Dialogue: 0,0:07:24.68,0:07:25.30,TEXT JP,,0,0,0,,Не?
Dialogue: 0,0:07:25.78,0:07:28.32,TEXT JP,,0,0,0,,Мен оны сізге ыңғайлы етіп жасаймын.
Dialogue: 0,0:07:29.19,0:07:30.44,TEXT JP,,0,0,0,,Фестивальдар туралы айту
Dialogue: 0,0:07:31.19,0:07:33.63,TEXT JP,,0,0,0,,Дүние жүзінде көптеген фестивальдер бар.
Dialogue: 0,0:07:33.89,0:07:36.82,TEXT JP,,0,0,0,,Болгарияда ерекше фестиваль бар.
Dialogue: 0,0:07:37.14,0:07:39.76,TEXT JP,,0,0,0,,Сондықтан йогуртқа тұздалған балықты қосады.
Dialogue: 0,0:07:40.18,0:07:44.94,TEXT JP,,0,0,0,,Иә, тез тамақтан, түскі асқа аз ғана уақыт қалды.
Dialogue: 0,0:07:45.39,0:07:45.93,TEXT JP,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:07:46.03,0:07:48.30,TEXT JP,,0,0,0,,Соңына дейін естігім келді!
Dialogue: 0,0:07:48.69,0:07:53.23,TEXT JP,,0,0,0,,Ли мен Сакура Чан бұрынғы қалпында қалады деп үміттенемін.
Dialogue: 0,0:08:00.82,0:08:01.49,TEXT JP,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:08:02.28,0:08:03.74,TEXT JP,,0,0,0,,Күрделі
Dialogue: 0,0:08:05.37,0:08:08.09,TEXT JP,,0,0,0,,Наоко-чан тегіс болар еді.
Dialogue: 0,0:08:11.88,0:08:15.18,TEXT JP,,0,0,0,,Наоко-чан өте жақсы сурет салады.
Dialogue: 0,0:08:15.95,0:08:16.94,TEXT JP,,0,0,0,,Сіз оны қарай аласыз.
Dialogue: 0,0:08:17.67,0:08:18.90,TEXT JP,,0,0,0,,Иә
Dialogue: 0,0:08:20.99,0:08:22.77,TEXT JP,,0,0,0,,Сіз оны жақсы сала аласыз
Dialogue: 0,0:08:24.34,0:08:25.13,TEXT JP,,0,0,0,,Солай ма?
Dialogue: 0,0:08:25.72,0:08:26.95,TEXT JP,,0,0,0,,Сен жақсысың.
Dialogue: 0,0:08:27.43,0:08:30.90,TEXT JP,,0,0,0,,Маған мұны жақсы білетін Томойо-чанның айтқаны ұят.
Dialogue: 0,0:08:31.79,0:08:36.13,TEXT JP,,0,0,0,,Жоқ, Чихару-чан мен Сакура-чан екеуі де керемет суреттер.
Dialogue: 0,0:08:36.77,0:08:40.92,TEXT JP,,0,0,0,,Иә, Томойо-чанның суреттері ересектерге ұқсайды.
Dialogue: 0,0:08:41.39,0:08:45.39,TEXT JP,,0,0,0,,Рахмет, мен өзімді білмеймін.
Dialogue: 0,0:08:45.68,0:08:47.77,TEXT JP,,0,0,0,,Бұл мен бұрын көрген дизайн сызбасына ұқсайды.
Dialogue: 0,0:08:48.50,0:08:52.68,TEXT JP,,0,0,0,,Мен кейде киім тігуден бұрын дизайнды саламын.
Dialogue: 0,0:08:53.12,0:08:54.89,TEXT JP,,0,0,0,,Оны сызыңыз, содан кейін жасаңыз
Dialogue: 0,0:08:55.77,0:08:58.72,TEXT JP,,0,0,0,,Кейде бұл өрнекпен тікелей болады.
Dialogue: 0,0:08:59.14,0:09:03.32,TEXT JP,,0,0,0,,Кейде ойыма келген нәрселерді ұмытып кетпеу үшін сурет саламын.
Dialogue: 0,0:09:04.12,0:09:05.43,TEXT JP,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:09:05.58,0:09:07.44,TEXT JP,,0,0,0,,Келесі жолы үй шаруашылығы сабағында
Dialogue: 0,0:09:07.46,0:09:10.28,TEXT JP,,0,0,0,,Тігін тігудің түсінбейтінін айта аласыз ба?
Dialogue: 0,0:09:11.13,0:09:12.25,TEXT JP,,0,0,0,,Мен таққа таласудан шығып қалдым. Енді бәрі бітті.
Dialogue: 0,0:09:12.95,0:09:14.17,TEXT JP,,0,0,0,,Рахмет
Dialogue: 0,0:09:24.86,0:09:27.80,TEXT JP,,0,0,0,,Маған Лидің атлетизмі қатты ұнайды.
Dialogue: 0,0:09:28.37,0:09:30.06,TEXT JP,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:31.52,0:09:33.94,TEXT JP,,0,0,0,,Мен жақында үйірме жұмыстарын бастай аламын деп үміттенемін.
Dialogue: 0,0:09:35.50,0:09:36.48,TEXT JP,,0,0,0,,Шынымен
Dialogue: 0,0:09:39.60,0:09:40.90,TEXT JP,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:09:43.92,0:09:45.84,TEXT JP,,0,0,0,,Иә, бәрі жақсы деп ойлаймын.
Dialogue: 0,0:09:46.55,0:09:48.42,TEXT JP,,0,0,0,,Бұл да дұрыс сияқты.
Dialogue: 0,0:09:49.35,0:09:53.16,TEXT JP,,0,0,0,,Бұл туралы Чихару-чан жазғандай
Dialogue: 0,0:09:56.05,0:09:57.92,TEXT JP,,0,0,0,,Ыдысқа кілегейлі ірімшікті салыңыз
Dialogue: 0,0:09:58.06,0:10:00.26,TEXT JP,,0,0,0,,Тегіс болғанша илеңіз.
Dialogue: 0,0:10:00.67,0:10:02.35,TEXT JP,,0,0,0,,Ал... осылай...
Dialogue: 0,0:10:02.51,0:10:03.42,TEXT JP,,0,0,0,,Коуяна
Dialogue: 0,0:10:04.07,0:10:06.17,TEXT JP,,0,0,0,,Жаңа кілегейге қант қосыңыз
Dialogue: 0,0:10:06.75,0:10:08.44,TEXT JP,,0,0,0,,Бал қосқыңыз келуі мүмкін.
Dialogue: 0,0:10:09.49,0:10:13.79,TEXT JP,,0,0,0,,Кілегейлі ірімшікті сәл шыңға дейін көбіктенген қоспаға қосыңыз.
Dialogue: 0,0:10:13.79,0:10:16.15,TEXT JP,,0,0,0,,Лимон шырынын көбірек қосыңыз
Dialogue: 0,0:10:16.54,0:10:17.29,TEXT JP,,0,0,0,,Бұл ұнайды ма?
Dialogue: 0,0:10:17.51,0:10:19.17,TEXT JP,,0,0,0,,Міне, осы.
Dialogue: 0,0:10:19.40,0:10:19.98,TEXT JP,,0,0,0,,Иә
Dialogue: 0,0:10:20.59,0:10:24.34,TEXT JP,,0,0,0,,Ұнтақ желатинді ыстыққа төзімді ыдысқа салып, микротолқынды пеште қыздырыңыз.
Dialogue: 0,0:10:24.81,0:10:27.70,TEXT JP,,0,0,0,,Мацерацияны қосыңыз
Dialogue: 0,0:10:27.88,0:10:28.44,TEXT JP,,0,0,0,,Мынау да.
Dialogue: 0,0:10:28.68,0:10:31.85,TEXT JP,,0,0,0,,Тордан сүзіп, қалыптарға құйыңыз.
Dialogue: 0,0:10:32.14,0:10:32.81,TEXT JP,,0,0,0,,Мынау да.
Dialogue: 0,0:10:33.16,0:10:36.56,TEXT JP,,0,0,0,,Қатты болу үшін тоңазытқышта 2-3 сағат суытыңыз.
Dialogue: 0,0:10:36.83,0:10:37.75,TEXT JP,,0,0,0,,Мынау да.
Dialogue: 0,0:10:38.41,0:10:40.92,TEXT JP,,0,0,0,,Қалауыңызша жеміс немесе жалбыз қосыңыз
Dialogue: 0,0:10:41.09,0:10:43.38,TEXT JP,,0,0,0,,Жеміс соусымен жеп қойыңыз.
Dialogue: 0,0:10:44.17,0:10:46.03,TEXT JP,,0,0,0,,Сирек кездесетін ірімшік торт
Dialogue: 0,0:10:47.40,0:10:49.64,TEXT JP,,0,0,0,,Дайын~
Dialogue: 0,0:11:11.70,0:11:14.86,TEXT JP,,0,0,0,,Күтілгендей, Чихару-чанның рецепті ең жақсы.
Dialogue: 0,0:11:16.29,0:11:19.88,TEXT JP,,0,0,0,,Өйткені, дәмді тамақ жеу мені қуантады.
Dialogue: 0,0:11:26.66,0:11:30.23,TEXT JP,,0,0,0,,Иә, мен шынымен солай ойлаймын.
Dialogue: 0,0:11:31.98,0:11:34.50,TEXT JP,,0,0,0,,Жаңа таяқшалар мен карталар туралы.
Dialogue: 0,0:11:35.06,0:11:37.89,TEXT JP,,0,0,0,,Әлі келмеген Эриолдан жауап.
Dialogue: 0,0:11:38.32,0:11:39.43,TEXT JP,,0,0,0,,Әртүрлі заттар бар.
Dialogue: 0,0:11:40.33,0:11:42.68,TEXT JP,,0,0,0,,Әрдайым уайымдаудың пайдасы жоқ.
Dialogue: 0,0:11:43.29,0:11:47.05,TEXT JP,,0,0,0,,Күнделікті мектепте және үйде барлығын дұрыс орындаңыз.
Dialogue: 0,0:11:47.50,0:11:50.83,TEXT JP,,0,0,0,,Бірдеңе болып қалса, мен бар күшімді саламын.
Dialogue: 0,0:11:57.91,0:12:00.06,TEXT JP,,0,0,0,,Күткендей, Сакура-чан
Dialogue: 0,0:12:00.64,0:12:02.14,TEXT JP,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:12:02.72,0:12:03.89,TEXT JP,,0,0,0,,Сейана
Dialogue: 0,0:12:04.03,0:12:08.14,TEXT JP,,0,0,0,,Мен кіші мектеп оқушысы болсам да, дабылды орнатқан сайын тоқтатуым керек.
Dialogue: 0,0:12:08.14,0:12:11.16,TEXT JP,,0,0,0,,Екі рет ұйықтасаңыз, дайындалуға асығуға тура келеді.
Dialogue: 0,0:12:11.16,0:12:12.32,TEXT JP,,0,0,0,,Керо-чан!
Dialogue: 0,0:12:12.72,0:12:13.38,TEXT JP,,0,0,0,,Жақсы
Dialogue: 0,0:12:14.95,0:12:15.88,TEXT JP,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:12:17.54,0:12:18.33,TEXT JP,,0,0,0,,Үлкен аға
Dialogue: 0,0:12:18.98,0:12:19.93,TEXT JP,,0,0,0,,Қош келдің үйге.
Dialogue: 0,0:12:20.26,0:12:20.63,TEXT JP,,0,0,0,,О
Dialogue: 0,0:12:20.98,0:12:22.12,TEXT JP,,0,0,0,,Юкито-сан
Dialogue: 0,0:12:22.32,0:12:24.42,TEXT JP,,0,0,0,,Сәлем Сакура-чан Томойо-чан
Dialogue: 0,0:12:24.97,0:12:26.07,TEXT JP,,0,0,0,,Мен сені мазалап жүрмін
Dialogue: 0,0:12:37.25,0:12:39.61,TEXT JP,,0,0,0,,Томойо-чан, сен бүгін түнде боласың ба?
Dialogue: 0,0:12:40.10,0:12:42.02,TEXT JP,,0,0,0,,Иә, көмегіңіз үшін рахмет.
Dialogue: 0,0:12:42.64,0:12:43.65,TEXT JP,,0,0,0,,Мен де
Dialogue: 0,0:12:43.87,0:12:45.40,TEXT JP,,0,0,0,,Юкито-сан да?
Dialogue: 0,0:12:46.10,0:12:47.75,TEXT JP,,0,0,0,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:12:48.16,0:12:49.46,TEXT JP,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:12:49.83,0:12:51.10,TEXT JP,,0,0,0,,Бұл не?
Dialogue: 0,0:12:52.12,0:12:53.06,TEXT JP,,0,0,0,,Не?
Dialogue: 0,0:12:53.62,0:12:55.34,TEXT JP,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:12:56.52,0:12:58.66,TEXT JP,,0,0,0,,Омотенаши мон
Dialogue: 0,0:12:59.34,0:13:00.16,TEXT JP,,0,0,0,,Не?
Dialogue: 0,0:13:02.24,0:13:03.89,TEXT JP,,0,0,0,,Уақыт аса маңызды.
Dialogue: 0,0:13:05.07,0:13:08.50,TEXT JP,,0,0,0,,Сакура-чан осында болса, үлкен қонақжайлық болар еді.
Dialogue: 0,0:13:09.22,0:13:10.56,TEXT JP,,0,0,0,,Юкито-сан
Dialogue: 0,0:13:12.39,0:13:14.89,TEXT JP,,0,0,0,,Менде бейнекамера жоқ өкінішті.
Dialogue: 0,0:13:15.59,0:13:17.10,TEXT JP,,0,0,0,,Томойо күткендей
Dialogue: 0,0:13:21.43,0:13:23.53,TEXT JP,,0,0,0,,Кешкі асқа окономияки жеуге бола ма?
Dialogue: 0,0:13:25.69,0:13:27.19,TEXT JP,,0,0,0,,Мен сені қатты жақсы көремін
Dialogue: 0,0:13:27.49,0:13:28.33,TEXT JP,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:13:28.74,0:13:31.70,TEXT JP,,0,0,0,,Оларда соба кеспесі мен заманауи гриль тағамдары бар.
Dialogue: 0,0:13:32.28,0:13:34.96,TEXT JP,,0,0,0,,Қазіргі Яки!
Dialogue: 0,0:13:36.99,0:13:37.59,TEXT JP,,0,0,0,,Полиция қызметкері айтқандай—
Dialogue: 0,0:13:38.16,0:13:38.76,TEXT JP,,0,0,0,,Ke?
Dialogue: 0,0:13:39.43,0:13:43.16,TEXT JP,,0,0,0,,Ке...Денсаулық пен жақсы, солай емес пе? Заманауи гриль жасау
Dialogue: 0,0:13:43.76,0:13:45.04,TEXT JP,,0,0,0,,Денсаулық?
Dialogue: 0,0:13:45.54,0:13:48.07,TEXT JP,,0,0,0,,Кя, мен қырыққабатты көп жей аламын.
Dialogue: 0,0:14:02.59,0:14:03.69,TEXT JP,,0,0,0,,Өте орынды.
Dialogue: 0,0:14:04.16,0:14:06.74,TEXT JP,,0,0,0,,Мен тіпті ініме де жасап бердім.
Dialogue: 0,0:14:07.60,0:14:08.84,TEXT JP,,0,0,0,,Мен оны саған бермеймін!
Dialogue: 0,0:14:11.01,0:14:12.48,TEXT JP,,0,0,0,,Үлкен аға!
Dialogue: 0,0:14:14.78,0:14:15.90,TEXT JP,,0,0,0,,Біз жақсы доспыз.
Dialogue: 0,0:14:16.47,0:14:17.44,TEXT JP,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:14:14.07,0:14:16.15,TEXT JP TOP,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:14:16.15,0:14:17.51,TEXT JP TOP,,0,0,0,,Өте орынды.
Dialogue: 0,0:14:17.51,0:14:19.67,TEXT JP TOP,,0,0,0,,Мен олай демес едім.
Dialogue: 0,0:14:18.12,0:14:21.92,TEXT JP,,0,0,0,,Ей, үнемі тұлып болып көріну өте қиын!
Dialogue: 0,0:14:23.45,0:14:26.42,TEXT JP,,0,0,0,,Ол колледж студенті болса да, қазірдің өзінде үлкен аға.
Dialogue: 0,0:14:26.52,0:14:27.79,TEXT JP,,0,0,0,,Тек айтайын
Dialogue: 0,0:14:29.62,0:14:33.02,TEXT JP,,0,0,0,,Бірақ сіз осындай дәмді окономияки жасай аласыз.
Dialogue: 0,0:14:33.02,0:14:34.56,TEXT JP,,0,0,0,,Жаман адам емес
Dialogue: 0,0:14:35.31,0:14:37.77,TEXT JP,,0,0,0,,Керо-чан жай ғана сараң, солай ма?
Dialogue: 0,0:14:38.28,0:14:41.39,TEXT JP,,0,0,0,,Дәмді тағам жасай алатынның бәрі жақсы адам.
Dialogue: 0,0:14:47.12,0:14:48.66,TEXT JP,,0,0,0,,Ұзындығы да тамаша.
Dialogue: 0,0:14:51.48,0:14:53.90,TEXT JP,,0,0,0,,Мен мұндай нәрсені істегеніме біраз уақыт болды.
Dialogue: 0,0:14:55.61,0:14:57.19,TEXT JP,,0,0,0,,Бұл сізге жарасады.
Dialogue: 0,0:14:57.88,0:15:02.54,TEXT JP,,0,0,0,,Мен Томойо-чан маған арнап тіккен киімдерді кигенде, мен өзімді әлдеқайда жігерлі сезінемін.
Dialogue: 0,0:15:03.46,0:15:04.66,TEXT JP,,0,0,0,,Әрқашанғыдай рахмет.
Dialogue: 0,0:15:06.12,0:15:07.26,TEXT JP,,0,0,0,,Сакура-чан...
Dialogue: 0,0:15:09.59,0:15:13.27,TEXT JP,,0,0,0,,...
Dialogue: 0,0:15:13.84,0:15:15.76,TEXT JP,,0,0,0,,...
Dialogue: 0,0:15:15.95,0:15:17.27,TEXT JP,,0,0,0,,...
Dialogue: 0,0:15:17.48,0:15:20.03,TEXT JP,,0,0,0,,Өте сүйкімді! Өте керемет!
Dialogue: 0,0:15:21.53,0:15:22.57,TEXT JP,,0,0,0,,…
Dialogue: 0,0:15:24.18,0:15:25.20,TEXT JP,,0,0,0,,Не? Не?
Dialogue: 0,0:15:26.27,0:15:30.57,TEXT JP,,0,0,0,,Мен дәл қазір Сакура-чанның бөлмесіндемін деп ойладым...
Dialogue: 0,0:15:30.85,0:15:34.13,TEXT JP,,0,0,0,,...
Dialogue: 0,0:15:47.40,0:15:50.61,TEXT JP,,0,0,0,,?
Dialogue: 0,0:15:53.20,0:15:54.00,TEXT JP,,0,0,0,,!
Dialogue: 0,0:15:54.50,0:15:55.20,TEXT JP,,0,0,0,,Қалай
Dialogue: 0,0:15:55.20,0:15:56.74,TEXT JP,,0,0,0,,!
Dialogue: 0,0:15:56.74,0:15:57.66,TEXT JP,,0,0,0,,Ихяи
Dialogue: 0,0:15:58.83,0:15:59.81,TEXT JP,,0,0,0,,Сонымен...
Dialogue: 0,0:16:01.03,0:16:02.67,TEXT JP,,0,0,0,,...
Dialogue: 0,0:16:04.22,0:16:05.25,TEXT JP,,0,0,0,,Егер солай болса
Dialogue: 0,0:16:09.53,0:16:13.75,TEXT JP,,0,0,0,,Сондай-ақ, жаңа таяқша мен карталармен бірдеңе істеу керек пе?
Dialogue: 0,0:16:16.94,0:16:19.54,TEXT JP,,0,0,0,,...
Dialogue: 0,0:16:21.73,0:16:24.00,TEXT JP,,0,0,0,,Бұл жер қай жерде?
Dialogue: 0,0:16:27.87,0:16:30.85,TEXT JP,,0,0,0,,...
Dialogue: 0,0:16:32.40,0:16:34.34,TEXT JP,,0,0,0,,Бір жерде, есік сияқты
Dialogue: 0,0:16:36.76,0:16:38.32,TEXT JP,,0,0,0,,...
Dialogue: 0,0:16:40.29,0:16:40.79,TEXT JP,,0,0,0,,Иә
Dialogue: 0,0:16:45.20,0:16:45.77,TEXT JP,,0,0,0,,Қалай
Dialogue: 0,0:16:46.55,0:16:49.09,TEXT JP,,0,0,0,,...
Dialogue: 0,0:16:53.04,0:16:53.64,TEXT JP,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:16:54.83,0:16:55.40,TEXT JP,,0,0,0,,Не?
Dialogue: 0,0:16:56.22,0:16:57.80,TEXT JP,,0,0,0,,...
Dialogue: 0,0:16:58.29,0:16:58.74,TEXT JP,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:17:07.69,0:17:08.59,TEXT JP,,0,0,0,,Бұл не?
Dialogue: 0,0:17:10.67,0:17:12.11,TEXT JP,,0,0,0,,...
Dialogue: 0,0:17:13.15,0:17:14.67,TEXT JP,,0,0,0,,Бассам да созылады.
Dialogue: 0,0:17:25.21,0:17:26.53,TEXT JP,,0,0,0,,...
Dialogue: 0,0:17:44.91,0:17:46.59,TEXT JP,,0,0,0,,...
Dialogue: 0,0:17:47.06,0:17:48.90,TEXT JP,,0,0,0,,...
Dialogue: 0,0:17:50.84,0:17:51.36,TEXT JP,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:17:52.06,0:17:53.20,TEXT JP,,0,0,0,,Не? Не?
Dialogue: 0,0:17:57.96,0:17:58.71,TEXT JP,,0,0,0,,Томойо-чан
Dialogue: 0,0:18:02.06,0:18:02.84,TEXT JP,,0,0,0,,Сакура-чан
Dialogue: 0,0:18:03.89,0:18:05.19,TEXT JP,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:18:05.74,0:18:08.09,TEXT JP,,0,0,0,,...
Dialogue: 0,0:18:13.57,0:18:15.62,TEXT JP,,0,0,0,,Мынау, анау, анау
Dialogue: 0,0:18:15.98,0:18:18.50,TEXT JP,,0,0,0,,Онда, сонда, сонда.
Dialogue: 0,0:18:18.79,0:18:19.48,TEXT JP,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:18:19.75,0:18:21.50,TEXT JP,,0,0,0,,Мынаны істе, мынаны істе
Dialogue: 0,0:18:21.95,0:18:23.69,TEXT JP,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:18:24.36,0:18:26.88,TEXT JP,,0,0,0,,Осылай кеңейтіңіз және қысқартыңыз
Dialogue: 0,0:18:27.05,0:18:27.92,TEXT JP,,0,0,0,,Қараңыз
Dialogue: 0,0:18:28.05,0:18:28.63,TEXT JP,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:18:31.10,0:18:32.05,TEXT JP,,0,0,0,,...
Dialogue: 0,0:18:33.14,0:18:37.26,TEXT JP,,0,0,0,,Мүмкін бұл шардың іші сияқты көрінетін шығар?
Dialogue: 0,0:18:37.48,0:18:38.43,TEXT JP,,0,0,0,,(Барлығы төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:18:39.19,0:18:42.44,TEXT JP,,0,0,0,,Егер ол сынған болса, мүмкін
Dialogue: 0,0:18:43.13,0:18:44.61,TEXT JP,,0,0,0,,Бірақ қалай?
Dialogue: 0,0:18:45.77,0:18:47.98,TEXT JP,,0,0,0,,Дәл осылай ма?
Dialogue: 0,0:19:00.46,0:19:02.49,TEXT JP,,0,0,0,,Арманның күшін ұстайтын кілт
Dialogue: 0,0:19:04.34,0:19:06.72,TEXT JP,,0,0,0,,Маған шынайы түріңді көрсет
Dialogue: 0,0:19:07.55,0:19:09.22,TEXT JP,,0,0,0,,Шығару
Dialogue: 0,0:19:23.53,0:19:24.55,TEXT JP,,0,0,0,,Бұл бөлме таңғы күн сәулесі түспейтін ең қолайлы жерде болуы керек еді, бірақ...
Dialogue: 0,0:19:24.98,0:19:25.45,TEXT JP,,0,0,0,,Иә
Dialogue: 0,0:19:34.20,0:19:34.98,TEXT JP,,0,0,0,,!
Dialogue: 0,0:19:35.34,0:19:35.86,TEXT JP,,0,0,0,,Иә
Dialogue: 0,0:19:36.44,0:19:37.70,TEXT JP,,0,0,0,,...
Dialogue: 0,0:19:38.45,0:19:41.72,TEXT JP,,0,0,0,,Арман таяқтың астында менің күш-қуатым бол!
Dialogue: 0,0:19:44.39,0:19:45.48,TEXT JP,,0,0,0,,!
Dialogue: 0,0:20:06.51,0:20:09.36,TEXT JP,,0,0,0,,Қоршау...Қоршау
Dialogue: 0,0:20:16.27,0:20:17.98,TEXT JP,,0,0,0,,Ол қатты шу шығарды.
Dialogue: 0,0:20:18.60,0:20:21.99,TEXT JP,,0,0,0,,Эй, мен жай ғана шармен ойнап едім, ол ұшып кетті.
Dialogue: 0,0:20:22.79,0:20:24.07,TEXT JP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:24.86,0:20:27.97,TEXT JP,,0,0,0,,Хмм, қатты толқымаңыз.
Dialogue: 0,0:20:28.57,0:20:29.59,TEXT JP,,0,0,0,,Иә
Dialogue: 0,0:20:34.89,0:20:36.86,TEXT JP,,0,0,0,,Мен алдап үлгердім
Dialogue: 0,0:20:39.43,0:20:40.16,TEXT JP,,0,0,0,,Сакура
Dialogue: 0,0:20:41.15,0:20:44.15,TEXT JP,,0,0,0,,Сондай-ақ… жаңа карталар
Dialogue: 0,0:20:51.55,0:20:53.70,TEXT JP,,0,0,0,,Мен ұйықтап қалдым, Руби.
Dialogue: 0,0:20:55.53,0:20:58.03,TEXT JP,,0,0,0,,Сіздің бірден Жапонияға баратыныңызды естімедім.
Dialogue: 0,0:20:59.29,0:21:00.93,TEXT JP,,0,0,0,,Кахо оны тыныштандырғаннан кейін ғана...
Dialogue: 0,0:21:02.66,0:21:03.35,TEXT JP,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:05.81,0:21:08.78,TEXT JP,,0,0,0,,Жапон ханымын шақырғыңыз келе ме?
Dialogue: 0,0:21:09.98,0:21:12.91,TEXT JP,,0,0,0,,Эриолдың жауабын күтіп отырғаныңызға сенімдімін.
Dialogue: 0,0:21:14.23,0:21:15.70,TEXT JP,,0,0,0,,Әлі жоқ
Dialogue: 0,0:21:17.65,0:21:19.17,TEXT JP,,0,0,0,,Сол уақыт келгенше
Dialogue: 0,0:21:39.80,0:21:40.59,TEXT JP,,0,0,0,,Жоқ!
Dialogue: 0,0:21:41.29,0:21:43.14,TEXT JP,,0,0,0,,Жоқ! Міне бітті!
Dialogue: 0,0:21:43.52,0:21:45.49,TEXT JP,,0,0,0,,Жоқ! Барма!
Dialogue: 0,0:21:46.83,0:21:49.88,TEXT JP,,0,0,0,,Сіз кімсіз? Неге сондасың?
Dialogue: 0,0:21:50.85,0:21:53.23,TEXT JP,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:22:06.55,0:22:08.56,TEXT JP,,0,0,0,,Сонда да мөлдір
Dialogue: 0,0:22:09.14,0:22:11.56,TEXT JP,,0,0,0,,Кард-сан, жақсысың ба?
Dialogue: 0,0:22:16.14,0:22:19.21,TEXT JP,,0,0,0,,Қазіргі заман шошқалар мен кальмарлар туралы...
Dialogue: 0,0:22:23.23,0:22:24.61,TEXT JP,,0,0,0,,Қолымыздан келгенін істейік
Dialogue: 0,0:22:26.62,0:22:29.63,TEXT JP,,0,0,0,,Мен жаңа карталарды осылай таптым
Dialogue: 0,0:22:30.26,0:22:32.07,TEXT JP,,0,0,0,,Қандай да бір себеп болуы керек
Dialogue: 0,0:22:33.26,0:22:35.09,TEXT JP,,0,0,0,,Карточкаларды қайта қараңыз
Dialogue: 0,0:22:36.35,0:22:38.03,TEXT JP,,0,0,0,,Мен не істей аламын
Dialogue: 0,0:24:10.66,0:24:12.58,TEXT JP,,0,0,0,,Коньянячива
Dialogue: 0,0:24:13.12,0:24:16.50,TEXT JP,,0,0,0,,Иә, бұл эпизод басталды: Оны Керо-чан бұрышына қалдырыңыз
Dialogue: 0,0:24:16.50,0:24:18.74,TEXT JP,,0,0,0,,Бұл есте қаларлық бірінші рет!
Dialogue: 0,0:24:18.74,0:24:21.41,TEXT JP,,0,0,0,,Томоеда орта мектебінің формасы!
Dialogue: 0,0:24:21.41,0:24:21.42,TEXT JP,,0,0,0,,Қара түске негізделген сәнді дизайн
Dialogue: 0,0:24:23.63,0:24:25.43,TEXT JP,,0,0,0,,Нүктенің қызыл сызығы естіледі.
Dialogue: 0,0:24:25.59,0:24:29.20,TEXT JP,,0,0,0,,Сол жақ иықтағы мектеп эмблемасы Томоеда бастауыш мектебімен бірдей!
Dialogue: 0,0:24:29.79,0:24:31.49,TEXT JP,,0,0,0,,Айтпақшы, бұл ер балаларға қатысты.
Dialogue: 0,0:24:32.95,0:24:36.68,TEXT JP,,0,0,0,,Бұл бұрышта әр уақытта әртүрлі ақпарат беріледі.
Dialogue: 0,0:24:36.69,0:24:38.28,TEXT JP,,0,0,0,,Қандай бақылаусыздық!
Dialogue: 0,0:24:38.56,0:24:39.34,TEXT JP,,0,0,0,,Хона!
Dialogue: 0,0:24:40.48,0:24:44.54,TEXT JP,,0,0,0,,Мен черлидинг клубына қатысуға өтініш беруді асыға күтемін.
Dialogue: 0,0:24:44.70,0:24:46.64,TEXT JP,,0,0,0,,Бірақ жаңбыр тоқтаған жоқ
Dialogue: 0,0:24:46.82,0:24:48.74,TEXT JP,,0,0,0,,Бұл картаның жұмысы ма?
Dialogue: 0,0:24:49.36,0:24:51.68,TEXT JP,,0,0,0,,Келесі Сакура қатты жаңбыр туралы ескерту
Dialogue: 0,0:24:51.96,0:24:53.09,TEXT JP,,0,0,0,,Сакурамен
Dialogue: 0,0:24:53.09,0:24:54.40,TEXT JP,,0,0,0,,Шығару
Dialogue: 0,0:01:30.51,0:01:31.39,TEXT CH,,0,0,0,,Йошиёши Хаяками
Dialogue: 0,0:01:31.51,0:01:32.37,TEXT CH,,0,0,0,,Йошиёши Хаяками
Dialogue: 0,0:01:32.58,0:01:34.37,TEXT CH,,0,0,0,,Кешегі теледидардан не көрдіңіз?
Dialogue: 0,0:01:40.60,0:01:42.25,TEXT CH,,0,0,0,,Жаңа картаны алдыңыз ба?
Dialogue: 0,0:01:42.69,0:01:43.31,TEXT CH,,0,0,0,,Иә...
Dialogue: 0,0:01:43.92,0:01:44.76,TEXT CH,,0,0,0,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:01:45.59,0:01:46.40,TEXT CH,,0,0,0,,Жаңа қасық
Dialogue: 0,0:01:47.68,0:01:49.55,TEXT CH,,0,0,0,,Бұл мөлдір.
Dialogue: 0,0:01:50.13,0:01:50.89,TEXT CH,,0,0,0,,Қателік
Dialogue: 0,0:01:51.28,0:01:54.42,TEXT CH,,0,0,0,,Бірден жеткізу, сондай-ақ артта қалған жоспар
Dialogue: 0,0:01:56.68,0:01:59.96,TEXT CH,,0,0,0,,Алдыңғы карта кенеттен мөлдір болды.
Dialogue: 0,0:02:00.45,0:02:03.41,TEXT CH,,0,0,0,,Карталардың жаңа түрлері қолжетімді
Dialogue: 0,0:02:04.14,0:02:06.41,TEXT CH,,0,0,0,,Бұл ұсақ-түйек мәселе
Dialogue: 0,0:02:07.57,0:02:10.87,TEXT CH,,0,0,0,,Дегенмен, бұл сәл маңыздырақ мәселе.
Dialogue: 0,0:02:11.34,0:02:12.24,TEXT CH,,0,0,0,,Ондық?
Dialogue: 0,0:02:13.33,0:02:15.83,TEXT CH,,0,0,0,,Бірінші жаңа карта жаңа картаға басылғанда
Dialogue: 0,0:02:15.83,0:02:18.33,TEXT CH,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:02:18.62,0:02:19.25,TEXT CH,,0,0,0,,U...!
Dialogue: 0,0:02:19.69,0:02:20.41,TEXT CH,,0,0,0,,Ерекше қасиет
Dialogue: 0,0:02:20.69,0:02:23.79,TEXT CH,,0,0,0,,Жаңа киімге ерекше дайындығым
Dialogue: 0,0:02:24.33,0:02:25.42,TEXT CH,,0,0,0,,Менің күйеуім
Dialogue: 0,0:02:25.74,0:02:26.76,TEXT CH,,0,0,0,,Әрине бар
Dialogue: 0,0:02:27.37,0:02:28.40,TEXT CH,,0,0,0,,Бейненің қалыптасуы
Dialogue: 0,0:02:29.04,0:02:30.22,TEXT CH,,0,0,0,,Гай!
Dialogue: 0,0:02:30.93,0:02:32.13,TEXT CH TOP,,0,0,0,,Гай!
Dialogue: 0,0:02:33.28,0:02:34.55,TEXT CH TOP,,0,0,0,,Гай!
Dialogue: 0,0:02:35.46,0:02:36.80,TEXT CH TOP,,0,0,0,,Гай!
Dialogue: 0,0:02:38.10,0:02:39.22,TEXT CH TOP,,0,0,0,,Гай!
Dialogue: 0,0:02:31.88,0:02:34.41,TEXT CH,,0,0,0,,Дайдодзи храмы жалғыз шынайы.
Dialogue: 0,0:02:34.71,0:02:35.36,TEXT CH,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:02:36.67,0:02:39.51,TEXT CH,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:02:40.06,0:02:41.69,TEXT CH,,0,0,0,,...
Dialogue: 0,0:02:44.78,0:02:46.21,TEXT CH,,0,0,0,,Сізге ұнады ма? Сяоран
Dialogue: 0,0:02:50.18,0:02:52.12,TEXT CH,,0,0,0,,Мен тек шағын сыйымдылыққа жету мүмкіндігін сезінемін.
Dialogue: 0,0:02:53.62,0:02:54.52,TEXT CH,,0,0,0,,Мен де
Dialogue: 0,0:02:56.31,0:02:58.51,TEXT CH,,0,0,0,,Дегенмен, бұл жағдай.
Dialogue: 0,0:02:59.41,0:03:01.83,TEXT CH,,0,0,0,,Достың өмірі туралы мәліметтер
Dialogue: 0,0:03:08.96,0:03:10.93,TEXT CH,,0,0,0,,Мен сізбен коммерциялық көлемде кездесемін.
Dialogue: 0,0:03:11.32,0:03:11.85,TEXT CH,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:03:16.00,0:03:16.76,TEXT CH,,0,0,0,,Кішкентай емен…
Dialogue: 0,0:03:26.38,0:03:27.40,TEXT CH,,0,0,0,,Йошиёши Хаяками
Dialogue: 0,0:03:27.83,0:03:28.64,TEXT CH,,0,0,0,,Йошиёши Хаяками
Dialogue: 0,0:03:29.34,0:03:30.62,TEXT CH,,0,0,0,,Йошиёши Хаяками
Dialogue: 0,0:03:30.88,0:03:32.18,TEXT CH,,0,0,0,,Аняның үйіне қош келдіңіз
Dialogue: 0,0:03:32.59,0:03:33.89,TEXT CH,,0,0,0,,Қарт шебердің қайтыс болуы
Dialogue: 0,0:03:34.29,0:03:35.03,TEXT CH,,0,0,0,,Йошиёши Хаяками
Dialogue: 0,0:03:35.40,0:03:37.13,TEXT CH,,0,0,0,,Томойо Огаки
Dialogue: 0,0:03:37.44,0:03:38.84,TEXT CH,,0,0,0,,Чихару Хая
Dialogue: 0,0:03:39.15,0:03:40.38,TEXT CH,,0,0,0,,Йошиёши Хаяками
Dialogue: 0,0:03:41.37,0:03:43.70,TEXT CH,,0,0,0,,...
Dialogue: 0,0:03:44.06,0:03:44.95,TEXT CH,,0,0,0,,Гай!
Dialogue: 0,0:03:45.08,0:03:46.20,TEXT CH,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:03:46.55,0:03:48.12,TEXT CH,,0,0,0,,Өзін-өзі іздеу әдісі...
Dialogue: 0,0:03:48.96,0:03:50.70,TEXT CH,,0,0,0,,Чихарудың сүт протеинінен жасалған торт
Dialogue: 0,0:03:50.70,0:03:53.15,TEXT CH,,0,0,0,,Нағыз өте жақсы тағам Супер Согаку
Dialogue: 0,0:03:53.95,0:03:56.59,TEXT CH,,0,0,0,,Катсуя - бұл өнім
Dialogue: 0,0:03:57.24,0:04:00.63,TEXT CH,,0,0,0,,Қазіргі кезеңнің басындағы алғашқы әрекет
Dialogue: 0,0:04:01.01,0:04:02.59,TEXT CH,,0,0,0,,Мен келген кездегі әсерім
Dialogue: 0,0:04:02.64,0:04:03.20,TEXT CH,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:04.43,0:04:05.72,TEXT CH,,0,0,0,,Йошиёши Хаяками
Dialogue: 0,0:04:06.30,0:04:08.23,TEXT CH,,0,0,0,,Оятоның отыру қалпы жоғарғы
Dialogue: 0,0:04:08.46,0:04:09.89,TEXT CH TOP,,0,0,0,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:08.96,0:04:09.98,TEXT CH,,0,0,0,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:04:14.89,0:04:17.73,TEXT CH,,0,0,0,,Сәтті оқиға болуы керек.
Dialogue: 0,0:04:18.56,0:04:19.87,TEXT CH,,0,0,0,,…
Dialogue: 0,0:04:22.91,0:04:23.61,TEXT CH,,0,0,0,,Нана
Dialogue: 0,0:04:24.30,0:04:28.29,TEXT CH,,0,0,0,,Жеке тәжірибе негізінде компанияға қабылдау туралы өтініш
Dialogue: 0,0:04:28.54,0:04:30.17,TEXT CH,,0,0,0,,Үй иесі, астана, белгіленген.
Dialogue: 0,0:04:31.03,0:04:32.53,TEXT CH TOP,,0,0,0,,...
Dialogue: 0,0:04:32.54,0:04:33.79,TEXT CH TOP,,0,0,0,,Сіз біздің компанияға қосылуға дайынсыз ба?
Dialogue: 0,0:04:33.37,0:04:34.97,TEXT CH,,0,0,0,,...
Dialogue: 0,0:04:35.43,0:04:37.09,TEXT CH,,0,0,0,,...
Dialogue: 0,0:04:37.57,0:04:40.96,TEXT CH,,0,0,0,,Бастауыш мектепте хор үйірмесіне қатысқан
Dialogue: 0,0:04:41.27,0:04:43.47,TEXT CH,,0,0,0,,Топқа қосылу
Dialogue: 0,0:04:44.16,0:04:45.47,TEXT CH,,0,0,0,,Чихаруя-кайға қосылу
Dialogue: 0,0:04:45.97,0:04:47.80,TEXT CH,,0,0,0,,Жиналыстан шыққаннан кейін
Dialogue: 0,0:04:49.05,0:04:51.63,TEXT CH,,0,0,0,,Ли Тонг қоғамының мүшелігі
Dialogue: 0,0:04:52.00,0:04:53.10,TEXT CH,,0,0,0,,Таза емес
Dialogue: 0,0:04:53.78,0:04:57.16,TEXT CH,,0,0,0,,Бұрынғы басқа да қоғамдық жұмыстарға қатыспау
Dialogue: 0,0:04:57.65,0:05:01.53,TEXT CH,,0,0,0,,Басқа іс-шаралар, ойын-сауық, ойын-сауық, мектеп өмірі, мектептен кейінгі жапон өміріне үміттену.
Dialogue: 0,0:05:01.99,0:05:02.56,TEXT CH,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:05:03.73,0:05:05.39,TEXT CH,,0,0,0,,Басқа қатысушы компанияларды қараңыз.
Dialogue: 0,0:05:05.57,0:05:07.90,TEXT CH,,0,0,0,,Басқа толықтырулар
Dialogue: 0,0:05:09.10,0:05:12.66,TEXT CH,,0,0,0,,Біраз уақыттан кейін
Dialogue: 0,0:05:12.66,0:05:13.88,TEXT CH,,0,0,0,,Шута бақыты аяқталды
Dialogue: 0,0:05:16.87,0:05:18.95,TEXT CH,,0,0,0,,Бухгалтерлік есеп процесіне қатысу
Dialogue: 0,0:05:19.61,0:05:20.85,TEXT CH,,0,0,0,,Қайтадан бастауға болады.
Dialogue: 0,0:05:21.18,0:05:22.87,TEXT CH,,0,0,0,,...
Dialogue: 0,0:05:23.19,0:05:25.12,TEXT CH,,0,0,0,,Мен сценарий бөліміне қосылдым.
Dialogue: 0,0:05:25.29,0:05:30.10,TEXT CH,,0,0,0,,Зайтомо орта мектебінің оқушыларының автопортреттері сахнада орындалды
Dialogue: 0,0:05:31.06,0:05:34.61,TEXT CH,,0,0,0,,Наконың бастауыш мектеп фотокітаптары Макотоның жақсы таяқшасы
Dialogue: 0,0:05:35.52,0:05:38.52,TEXT CH,,0,0,0,,Нанаконың алғашқы әңгімесінің сахналық қойылымы
Dialogue: 0,0:05:38.63,0:05:40.20,TEXT CH,,0,0,0,,Бұл жақсы идея.
Dialogue: 0,0:05:40.72,0:05:41.67,TEXT CH,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:05:43.19,0:05:44.43,TEXT CH,,0,0,0,,Дугаку Ямадзаки
Dialogue: 0,0:05:45.32,0:05:46.91,TEXT CH,,0,0,0,,Мен доп клубына келдім.
Dialogue: 0,0:05:47.17,0:05:49.87,TEXT CH,,0,0,0,,...
Dialogue: 0,0:05:50.50,0:05:53.98,TEXT CH,,0,0,0,,Бұл Ракуго зерттеу тобының оқиғасы.
Dialogue: 0,0:05:54.31,0:05:55.29,TEXT CH,,0,0,0,,Юки Нари
Dialogue: 0,0:05:56.55,0:05:59.42,TEXT CH,,0,0,0,,Сондықтан мен клуб үйірмесіне қосылдым.
Dialogue: 0,0:06:00.56,0:06:02.70,TEXT CH,,0,0,0,,Толық жабық жүйеге дейін және кейін
Dialogue: 0,0:06:05.99,0:06:06.64,TEXT CH,,0,0,0,,Ли Тонгсюэку
Dialogue: 0,0:06:07.87,0:06:09.72,TEXT CH,,0,0,0,,Гафусакусанға қатысатын компаниялар
Dialogue: 0,0:06:10.20,0:06:11.19,TEXT CH,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:06:12.00,0:06:13.98,TEXT CH,,0,0,0,,Менің Гонконгқа оралуым
Dialogue: 0,0:06:14.99,0:06:16.84,TEXT CH,,0,0,0,,Әртүрлі жағдайлар мен талаптарға байланысты
Dialogue: 0,0:06:19.79,0:06:21.89,TEXT CH,,0,0,0,,Сұраныс негіздемесі?
Dialogue: 0,0:06:23.02,0:06:26.45,TEXT CH,,0,0,0,,Шығыс пен Батыстың сұранысын қанағаттандыру мақсатында
Dialogue: 0,0:06:29.62,0:06:32.99,TEXT CH,,0,0,0,,...
Dialogue: 0,0:06:33.70,0:06:35.46,TEXT CH,,0,0,0,,Осымен.
Dialogue: 0,0:06:37.01,0:06:38.83,TEXT CH,,0,0,0,,Сенсей Яичи келді.
Dialogue: 0,0:06:39.58,0:06:40.57,TEXT CH,,0,0,0,,Өлім Мен адаммын.
Dialogue: 0,0:06:41.21,0:06:43.75,TEXT CH,,0,0,0,,Басқа талқылаулар және уақытты сапарлар
Dialogue: 0,0:06:44.51,0:06:45.63,TEXT CH,,0,0,0,,...
Dialogue: 0,0:06:46.24,0:06:48.35,TEXT CH,,0,0,0,,Тұтынушылар арасындағы өзара алмасу туралы ақпарат
Dialogue: 0,0:06:48.66,0:06:50.13,TEXT CH,,0,0,0,,Растау коэффициенті анық.
Dialogue: 0,0:06:50.56,0:06:54.68,TEXT CH,,0,0,0,,...
Dialogue: 0,0:06:54.94,0:06:58.89,TEXT CH,,0,0,0,,Маған фестивальде киетін киімдер қатты ұнайды.
Dialogue: 0,0:06:59.08,0:07:01.47,TEXT CH,,0,0,0,,...
Dialogue: 0,0:07:01.92,0:07:04.11,TEXT CH,,0,0,0,,Мен мұнда анықтама үшін келдім.
Dialogue: 0,0:07:04.43,0:07:05.03,TEXT CH,,0,0,0,,Анықтама нөмірі?
Dialogue: 0,0:07:05.52,0:07:07.57,TEXT CH,,0,0,0,,Бекіту кездесуі
Dialogue: 0,0:07:08.49,0:07:11.53,TEXT CH,,0,0,0,,Бұл тұрарлық емес.
Dialogue: 0,0:07:12.71,0:07:16.47,TEXT CH,,0,0,0,,...
Dialogue: 0,0:07:17.22,0:07:19.09,TEXT CH,,0,0,0,,Өлгеннен кейінгі фестивальге қатысу
Dialogue: 0,0:07:20.05,0:07:21.23,TEXT CH,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:07:21.82,0:07:24.06,TEXT CH,,0,0,0,,Анықтама үшін менің белгілі бір талабым бар.
Dialogue: 0,0:07:24.68,0:07:25.30,TEXT CH,,0,0,0,,Анықтама?
Dialogue: 0,0:07:25.78,0:07:28.32,TEXT CH,,0,0,0,,Сізге сәйкес киім
Dialogue: 0,0:07:29.19,0:07:30.44,TEXT CH,,0,0,0,,Іс-шараның басталу салтанаты
Dialogue: 0,0:07:31.19,0:07:33.63,TEXT CH,,0,0,0,,Дүние жүзіндегі фестивальдердің алуан түрлері
Dialogue: 0,0:07:33.89,0:07:36.82,TEXT CH,,0,0,0,,Олардың ішінде ең көрнекі фестиваль.
Dialogue: 0,0:07:37.14,0:07:39.76,TEXT CH,,0,0,0,,Радиоактивті қышқылды ұстайтын басқа тараптар...
Dialogue: 0,0:07:40.18,0:07:44.94,TEXT CH,,0,0,0,,Иә, түскі ас уақыты жоқ.
Dialogue: 0,0:07:45.39,0:07:45.93,TEXT CH,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:07:46.03,0:07:48.30,TEXT CH,,0,0,0,,!
Dialogue: 0,0:07:48.69,0:07:53.23,TEXT CH,,0,0,0,,Лимен бірге болу жақсы емес.
Dialogue: 0,0:08:00.82,0:08:01.49,TEXT CH,,0,0,0,,Сеніңше, қалай?
Dialogue: 0,0:08:02.28,0:08:03.74,TEXT CH,,0,0,0,,Жақсы ауа-райы
Dialogue: 0,0:08:05.37,0:08:08.09,TEXT CH,,0,0,0,,...
Dialogue: 0,0:08:11.88,0:08:15.18,TEXT CH,,0,0,0,,Наоко Макотоның суреттері
Dialogue: 0,0:08:15.95,0:08:16.94,TEXT CH,,0,0,0,,Мен оны көре аламын ба?
Dialogue: 0,0:08:17.67,0:08:18.90,TEXT CH,,0,0,0,,Мүмкін...мүмкін
Dialogue: 0,0:08:20.99,0:08:22.77,TEXT CH,,0,0,0,,Жақсы сурет
Dialogue: 0,0:08:24.34,0:08:25.13,TEXT CH,,0,0,0,,Бұл... мен осындамын.
Dialogue: 0,0:08:25.72,0:08:26.95,TEXT CH,,0,0,0,,Масаёси Гатоку
Dialogue: 0,0:08:27.43,0:08:30.90,TEXT CH,,0,0,0,,Томойганың салыстыруы, жақсы және жаман ниеті
Dialogue: 0,0:08:31.79,0:08:36.13,TEXT CH,,0,0,0,,...
Dialogue: 0,0:08:36.77,0:08:40.92,TEXT CH,,0,0,0,,...
Dialogue: 0,0:08:41.39,0:08:45.39,TEXT CH,,0,0,0,,...
Dialogue: 0,0:08:45.68,0:08:47.77,TEXT CH,,0,0,0,,Мен бұрын көрген кескінге арналған дизайндар жинағы.
Dialogue: 0,0:08:48.50,0:08:52.68,TEXT CH,,0,0,0,,Мен киімнің, жалпы жиналыстың дизайны мен жобасының алдында тұрмын
Dialogue: 0,0:08:53.12,0:08:54.89,TEXT CH,,0,0,0,,Алдыңғы сурет қайтадан аяқталды.
Dialogue: 0,0:08:55.77,0:08:58.72,TEXT CH,,0,0,0,,Тікелей анықтамалық қағазды бір уақытта ашу
Dialogue: 0,0:08:59.14,0:09:03.32,TEXT CH,,0,0,0,,Қолайсыздық пен ұмытшақтық сезімін болдырмау.
Dialogue: 0,0:09:04.12,0:09:05.43,TEXT CH,,0,0,0,,Сәттілік
Dialogue: 0,0:09:05.58,0:09:07.44,TEXT CH,,0,0,0,,Төменгі және жоғарғы үйдегі оқу уақыты
Dialogue: 0,0:09:07.46,0:09:10.28,TEXT CH,,0,0,0,,Егер сіз белгілі бір аймақта болсаңыз немесе жоқ болсаңыз, бізге үйретіңіз.
Dialogue: 0,0:09:11.13,0:09:12.25,TEXT CH,,0,0,0,,Әрине
Dialogue: 0,0:09:12.95,0:09:14.17,TEXT CH,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:09:24.86,0:09:27.80,TEXT CH,,0,0,0,,Ли Тонгсюэнің жемісті мінез-құлқы
Dialogue: 0,0:09:28.37,0:09:30.06,TEXT CH,,0,0,0,,Міне.
Dialogue: 0,0:09:31.52,0:09:33.94,TEXT CH,,0,0,0,,Үміттің ерте басталуы үшін компанияның іс-шараларына қатысу
Dialogue: 0,0:09:35.50,0:09:36.48,TEXT CH,,0,0,0,,Бұл рас па?
Dialogue: 0,0:09:39.60,0:09:40.90,TEXT CH,,0,0,0,,Мен мұны істей аламын ба?
Dialogue: 0,0:09:43.92,0:09:45.84,TEXT CH,,0,0,0,,...
Dialogue: 0,0:09:46.55,0:09:48.42,TEXT CH,,0,0,0,,Айырмашылыққа көңілім толмайды.
Dialogue: 0,0:09:49.35,0:09:53.16,TEXT CH,,0,0,0,,Ух...Асахару Чихарудың менің тағам таңдауым туралы әңгімесі
Dialogue: 0,0:09:56.05,0:09:57.92,TEXT CH,,0,0,0,,Бон кезеңінде қосылған майлы сүт және сүт өнімдері
Dialogue: 0,0:09:58.06,0:10:00.26,TEXT CH,,0,0,0,,Араластыру және араластыру
Dialogue: 0,0:10:00.67,0:10:02.35,TEXT CH,,0,0,0,,Осыдан кейін...
Dialogue: 0,0:10:02.51,0:10:03.42,TEXT CH,,0,0,0,,Бұл жолмен жүру керек.
Dialogue: 0,0:10:04.07,0:10:06.17,TEXT CH,,0,0,0,,Оджо-Юуға қосылған қант
Dialogue: 0,0:10:06.75,0:10:08.44,TEXT CH,,0,0,0,,Модификацияланған балды да қолдануға болады.
Dialogue: 0,0:10:09.49,0:10:13.79,TEXT CH,,0,0,0,,Қатты көбікке араластыру, содан кейін сүтке қайтадан май қосу
Dialogue: 0,0:10:13.79,0:10:16.15,TEXT CH,,0,0,0,,...
Dialogue: 0,0:10:16.54,0:10:17.29,TEXT CH,,0,0,0,,Қайда?
Dialogue: 0,0:10:17.51,0:10:19.17,TEXT CH,,0,0,0,,Қайта оралғаннан кейін
Dialogue: 0,0:10:19.40,0:10:19.98,TEXT CH,,0,0,0,,Неаполь, таңғы 11:26
Dialogue: 0,0:10:20.59,0:10:24.34,TEXT CH,,0,0,0,,Ыстыққа төзімді ыдыстағы ұнтақ ұнтағын шығару үшін микротолқынды пеште қыздырыңыз
Dialogue: 0,0:10:24.81,0:10:27.70,TEXT CH,,0,0,0,,Қосудан және инфузиядан кейінгі қоспалар
Dialogue: 0,0:10:27.88,0:10:28.44,TEXT CH,,0,0,0,,...
Dialogue: 0,0:10:28.68,0:10:31.85,TEXT CH,,0,0,0,,Жеткізуден кейінгі контейнер
Dialogue: 0,0:10:32.14,0:10:32.81,TEXT CH,,0,0,0,,...
Dialogue: 0,0:10:33.16,0:10:36.56,TEXT CH,,0,0,0,,Инъекцияланған мұз қорапшасын бірден қату үшін 2-3 минут салқындату
Dialogue: 0,0:10:36.83,0:10:37.75,TEXT CH,,0,0,0,,Бұл орын…
Dialogue: 0,0:10:38.41,0:10:40.92,TEXT CH,,0,0,0,,Өз рахатын, су жемістерін немесе жұқа жемістерді орналастыру
Dialogue: 0,0:10:41.09,0:10:43.38,TEXT CH,,0,0,0,,...
Dialogue: 0,0:10:44.17,0:10:46.03,TEXT CH,,0,0,0,,Суық сүтті протеинді торт
Dialogue: 0,0:10:47.40,0:10:49.64,TEXT CH,,0,0,0,,Сәттілік~
Dialogue: 0,0:11:11.70,0:11:14.86,TEXT CH,,0,0,0,,Чихарудың жалғыз қалудың құпия жолы
Dialogue: 0,0:11:16.29,0:11:19.88,TEXT CH,,0,0,0,,Жақсы және дәмді тағам - бақыт.
Dialogue: 0,0:11:26.66,0:11:30.23,TEXT CH,,0,0,0,,...
Dialogue: 0,0:11:31.98,0:11:34.50,TEXT CH,,0,0,0,,Жақында жаңа сиқырлы таяқша жапон картасы пайда болды
Dialogue: 0,0:11:35.06,0:11:37.89,TEXT CH,,0,0,0,,...
Dialogue: 0,0:11:38.32,0:11:39.43,TEXT CH,,0,0,0,,Көп қиындық
Dialogue: 0,0:11:40.33,0:11:42.68,TEXT CH,,0,0,0,,Дегенмен, жарық сенімсіз.
Dialogue: 0,0:11:43.29,0:11:47.05,TEXT CH,,0,0,0,,Мен мектепте жақсымын, үйде жақсымын және бұл маған күнде ұнайды.
Dialogue: 0,0:11:47.50,0:11:50.83,TEXT CH,,0,0,0,,Мен мұны істей алатын болсам, өз күшімді пайдалануға тура келуі мүмкін.
Dialogue: 0,0:11:57.91,0:12:00.06,TEXT CH,,0,0,0,,Қайғылы емес
Dialogue: 0,0:12:00.64,0:12:02.14,TEXT CH,,0,0,0,,Сондай-ақ жоғалған
Dialogue: 0,0:12:02.72,0:12:03.89,TEXT CH,,0,0,0,,Қабылдау
Dialogue: 0,0:12:04.03,0:12:08.14,TEXT CH,,0,0,0,,Бұл кіші мектеп оқушысының өзіндік рефлексия үшін таңдауы.
Dialogue: 0,0:12:08.14,0:12:11.16,TEXT CH,,0,0,0,,...
Dialogue: 0,0:12:11.16,0:12:12.32,TEXT CH,,0,0,0,,Кішкене рұқсат етіледі!
Dialogue: 0,0:12:12.72,0:12:13.38,TEXT CH,,0,0,0,,～
Dialogue: 0,0:12:14.95,0:12:15.88,TEXT CH,,0,0,0,,Мен тағы келдім~
Dialogue: 0,0:12:17.54,0:12:18.33,TEXT CH,,0,0,0,,Гор
Dialogue: 0,0:12:18.98,0:12:19.93,TEXT CH,,0,0,0,,Корольдің сапары
Dialogue: 0,0:12:20.26,0:12:20.63,TEXT CH,,0,0,0,,...
Dialogue: 0,0:12:20.98,0:12:22.12,TEXT CH,,0,0,0,,Ақшақар
Dialogue: 0,0:12:22.32,0:12:24.42,TEXT CH,,0,0,0,,Томойо Когаки
Dialogue: 0,0:12:24.97,0:12:26.07,TEXT CH,,0,0,0,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:12:37.25,0:12:39.61,TEXT CH,,0,0,0,,?
Dialogue: 0,0:12:40.10,0:12:42.02,TEXT CH,,0,0,0,,Бұл ең жақсы әдіс.
Dialogue: 0,0:12:42.64,0:12:43.65,TEXT CH,,0,0,0,,Мен де
Dialogue: 0,0:12:43.87,0:12:45.40,TEXT CH,,0,0,0,,Юкитогея осында
Dialogue: 0,0:12:46.10,0:12:47.75,TEXT CH,,0,0,0,,...
Dialogue: 0,0:12:48.16,0:12:49.46,TEXT CH,,0,0,0,,Мен дарындымын.
Dialogue: 0,0:12:49.83,0:12:51.10,TEXT CH,,0,0,0,,...
Dialogue: 0,0:12:52.12,0:12:53.06,TEXT CH,,0,0,0,,...
Dialogue: 0,0:12:53.62,0:12:55.34,TEXT CH,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:12:56.52,0:12:58.66,TEXT CH,,0,0,0,,Жақсы шақыру
Dialogue: 0,0:12:59.34,0:13:00.16,TEXT CH,,0,0,0,,Шақыру?
Dialogue: 0,0:13:02.24,0:13:03.89,TEXT CH,,0,0,0,,Бұл... бұл адам
Dialogue: 0,0:13:05.07,0:13:08.50,TEXT CH,,0,0,0,,...
Dialogue: 0,0:13:09.22,0:13:10.56,TEXT CH,,0,0,0,,Ақшақар
Dialogue: 0,0:13:12.39,0:13:14.89,TEXT CH,,0,0,0,,Шындық - машина жоғалып кетті.
Dialogue: 0,0:13:15.59,0:13:17.10,TEXT CH,,0,0,0,,Фудо - Чио
Dialogue: 0,0:13:21.43,0:13:23.53,TEXT CH,,0,0,0,,Осакадағы кешегі кешкі ас
Dialogue: 0,0:13:25.69,0:13:27.19,TEXT CH,,0,0,0,,Мен өте бақыттымын
Dialogue: 0,0:13:27.49,0:13:28.33,TEXT CH,,0,0,0,,Мен де
Dialogue: 0,0:13:28.74,0:13:31.70,TEXT CH,,0,0,0,,На Масааки және Юаньму
Dialogue: 0,0:13:32.28,0:13:34.96,TEXT CH,,0,0,0,,Қазіргі ұрпақ!
Dialogue: 0,0:13:36.99,0:13:37.59,TEXT CH,,0,0,0,,Кішкентай!
Dialogue: 0,0:13:38.16,0:13:38.76,TEXT CH,,0,0,0,,Кіші?
Dialogue: 0,0:13:39.43,0:13:43.16,TEXT CH,,0,0,0,,Қазіргі уақытта...Қазіргі уақытта пайдалы денсаулық
Dialogue: 0,0:13:43.76,0:13:45.04,TEXT CH,,0,0,0,,Денсаулыққа пайдалы?
Dialogue: 0,0:13:45.54,0:13:48.07,TEXT CH,,0,0,0,,Көп кітап оқи алатындықтан
Dialogue: 0,0:14:02.59,0:14:03.69,TEXT CH,,0,0,0,,Жалпы ақпарат
Dialogue: 0,0:14:04.16,0:14:06.74,TEXT CH,,0,0,0,,...
Dialogue: 0,0:14:07.60,0:14:08.84,TEXT CH,,0,0,0,,Аяқталмаған!
Dialogue: 0,0:14:11.01,0:14:12.48,TEXT CH,,0,0,0,,Бар!
Dialogue: 0,0:14:14.78,0:14:15.90,TEXT CH,,0,0,0,,...
Dialogue: 0,0:14:16.47,0:14:17.44,TEXT CH,,0,0,0,,Бұл рас па?
Dialogue: 0,0:14:14.07,0:14:16.15,TEXT CH TOP,,0,0,0,,Ақиқат – ақиқат
Dialogue: 0,0:14:16.15,0:14:17.51,TEXT CH TOP,,0,0,0,,Жалпы ақпарат
Dialogue: 0,0:14:17.51,0:14:19.67,TEXT CH TOP,,0,0,0,,Жалпы бекіту
Dialogue: 0,0:14:18.12,0:14:21.92,TEXT CH,,0,0,0,,...
Dialogue: 0,0:14:23.45,0:14:26.42,TEXT CH,,0,0,0,,Шындық, мен университет студентімін.
Dialogue: 0,0:14:26.52,0:14:27.79,TEXT CH,,0,0,0,,Бұл сенің махаббатыңды алдайтын адам.
Dialogue: 0,0:14:29.62,0:14:33.02,TEXT CH,,0,0,0,,Осакадан келген талғамы жақсы адам
Dialogue: 0,0:14:33.02,0:14:34.56,TEXT CH,,0,0,0,,Кейбір мүше еместер
Dialogue: 0,0:14:35.31,0:14:37.77,TEXT CH,,0,0,0,,Оны жай ғана жеуге болады.
Dialogue: 0,0:14:38.28,0:14:41.39,TEXT CH,,0,0,0,,Талантты және талғампаз аспаз - жақсы адам.
Dialogue: 0,0:14:47.12,0:14:48.66,TEXT CH,,0,0,0,,...
Dialogue: 0,0:14:51.48,0:14:53.90,TEXT CH,,0,0,0,,Жақсы ұзаққа созылатын киім.
Dialogue: 0,0:14:55.61,0:14:57.19,TEXT CH,,0,0,0,,Төтенше жағдайдағы сәйкестік
Dialogue: 0,0:14:57.88,0:15:02.54,TEXT CH,,0,0,0,,Өмірінде бірінші рет киім
Dialogue: 0,0:15:03.46,0:15:04.66,TEXT CH,,0,0,0,,Бірінші ауысымнан бастап
Dialogue: 0,0:15:06.12,0:15:07.26,TEXT CH,,0,0,0,,Кішкентай емен…
Dialogue: 0,0:15:09.59,0:15:13.27,TEXT CH,,0,0,0,,Суретшінің шығармашылығы туралы естеліктер
Dialogue: 0,0:15:13.84,0:15:15.76,TEXT CH,,0,0,0,,Нәтиже – маңызды сурет.
Dialogue: 0,0:15:15.95,0:15:17.27,TEXT CH,,0,0,0,,Гая Канамераи
Dialogue: 0,0:15:17.48,0:15:20.03,TEXT CH,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:15:21.53,0:15:22.57,TEXT CH,,0,0,0,,…
Dialogue: 0,0:15:24.18,0:15:25.20,TEXT CH,,0,0,0,,...
Dialogue: 0,0:15:26.27,0:15:30.57,TEXT CH,,0,0,0,,Талантты адам болсаң, шағын бөлмеде...
Dialogue: 0,0:15:30.85,0:15:34.13,TEXT CH,,0,0,0,,…
Dialogue: 0,0:15:47.40,0:15:50.61,TEXT CH,,0,0,0,,Сіздің арманыңыз бар ма?
Dialogue: 0,0:15:53.20,0:15:54.00,TEXT CH,,0,0,0,,Ауырсыну сияқты
Dialogue: 0,0:15:54.50,0:15:55.20,TEXT CH,,0,0,0,,Сеніңше, қалай?
Dialogue: 0,0:15:55.20,0:15:56.74,TEXT CH,,0,0,0,,...
Dialogue: 0,0:15:56.74,0:15:57.66,TEXT CH,,0,0,0,,Ауырсыну сияқты
Dialogue: 0,0:15:58.83,0:15:59.81,TEXT CH,,0,0,0,,Сондай-ақ айтылады ...
Dialogue: 0,0:16:01.03,0:16:02.67,TEXT CH,,0,0,0,,Бұл арман емес.
Dialogue: 0,0:16:04.22,0:16:05.25,TEXT CH,,0,0,0,,Қазурай Қосака
Dialogue: 0,0:16:09.53,0:16:13.75,TEXT CH,,0,0,0,,Жаңа сиқырлы таяқша мен карта бар ма?
Dialogue: 0,0:16:16.94,0:16:19.54,TEXT CH,,0,0,0,,Осы жерде кездескенше
Dialogue: 0,0:16:21.73,0:16:24.00,TEXT CH,,0,0,0,,...
Dialogue: 0,0:16:27.87,0:16:30.85,TEXT CH,,0,0,0,,Қайтадан келеді.
Dialogue: 0,0:16:32.40,0:16:34.34,TEXT CH,,0,0,0,,Бақылау
Dialogue: 0,0:16:36.76,0:16:38.32,TEXT CH,,0,0,0,,Сақ болыңыз
Dialogue: 0,0:16:40.29,0:16:40.79,TEXT CH,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:16:45.20,0:16:45.77,TEXT CH,,0,0,0,,Сеніңше, қалай?
Dialogue: 0,0:16:46.55,0:16:49.09,TEXT CH,,0,0,0,,Мен де өлім сезімін көремін.
Dialogue: 0,0:16:53.04,0:16:53.64,TEXT CH,,0,0,0,,тақырып
Dialogue: 0,0:16:54.83,0:16:55.40,TEXT CH,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:16:56.22,0:16:57.80,TEXT CH,,0,0,0,,Үйінді қабырға жиналысы ашық
Dialogue: 0,0:16:58.29,0:16:58.74,TEXT CH,,0,0,0,,тақырып
Dialogue: 0,0:17:07.69,0:17:08.59,TEXT CH,,0,0,0,,Бұл не?
Dialogue: 0,0:17:10.67,0:17:12.11,TEXT CH,,0,0,0,,Қолжетімсіз.
Dialogue: 0,0:17:13.15,0:17:14.67,TEXT CH,,0,0,0,,Шартты ұзарту
Dialogue: 0,0:17:25.21,0:17:26.53,TEXT CH,,0,0,0,,Дарындылыққа қойылатын талап
Dialogue: 0,0:17:44.91,0:17:46.59,TEXT CH,,0,0,0,,т.б.
Dialogue: 0,0:17:47.06,0:17:48.90,TEXT CH,,0,0,0,,Бұл ғибадатхананың қабырғасы.
Dialogue: 0,0:17:50.84,0:17:51.36,TEXT CH,,0,0,0,,тақырып
Dialogue: 0,0:17:52.06,0:17:53.20,TEXT CH,,0,0,0,,...
Dialogue: 0,0:17:57.96,0:17:58.71,TEXT CH,,0,0,0,,Томойо
Dialogue: 0,0:18:02.06,0:18:02.84,TEXT CH,,0,0,0,,Кішкентай емен
Dialogue: 0,0:18:03.89,0:18:05.19,TEXT CH,,0,0,0,,Мүлдем жиіркенішті оқиға
Dialogue: 0,0:18:05.74,0:18:08.09,TEXT CH,,0,0,0,,Міне осылай.
Dialogue: 0,0:18:13.57,0:18:15.62,TEXT CH,,0,0,0,,Бұл бөлім.
Dialogue: 0,0:18:15.98,0:18:18.50,TEXT CH,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:18.79,0:18:19.48,TEXT CH,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:18:19.75,0:18:21.50,TEXT CH,,0,0,0,,...
Dialogue: 0,0:18:21.95,0:18:23.69,TEXT CH,,0,0,0,,Бір адам - бір адам.
Dialogue: 0,0:18:24.36,0:18:26.88,TEXT CH,,0,0,0,,Кескін кеңейтімі
Dialogue: 0,0:18:27.05,0:18:27.92,TEXT CH,,0,0,0,,Көру
Dialogue: 0,0:18:28.05,0:18:28.63,TEXT CH,,0,0,0,,тақырып
Dialogue: 0,0:18:31.10,0:18:32.05,TEXT CH,,0,0,0,,...
Dialogue: 0,0:18:33.14,0:18:37.26,TEXT CH,,0,0,0,,Мүсін доптың ішінде.
Dialogue: 0,0:18:37.48,0:18:38.43,TEXT CH,,0,0,0,,Мүмкін
Dialogue: 0,0:18:39.19,0:18:42.44,TEXT CH,,0,0,0,,Нәтижеде бұл оқиғаның оқиғасы.
Dialogue: 0,0:18:43.13,0:18:44.61,TEXT CH,,0,0,0,,Иә, қажет.
Dialogue: 0,0:18:45.77,0:18:47.98,TEXT CH,,0,0,0,,Міне, мен келдім
Dialogue: 0,0:19:00.46,0:19:02.49,TEXT CH,,0,0,0,,Түсінде бір қасық қуат
Dialogue: 0,0:19:04.34,0:19:06.72,TEXT CH,,0,0,0,,Мен сенің алдыңдамын
Dialogue: 0,0:19:07.55,0:19:09.22,TEXT CH,,0,0,0,,Тығыздау
Dialogue: 0,0:19:23.53,0:19:24.55,TEXT CH,,0,0,0,,...
Dialogue: 0,0:19:24.98,0:19:25.45,TEXT CH,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:19:34.20,0:19:34.98,TEXT CH,,0,0,0,,Кішкентай ағаш!
Dialogue: 0,0:19:35.34,0:19:35.86,TEXT CH,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:19:36.44,0:19:37.70,TEXT CH,,0,0,0,,Иесі жоқ мүлік
Dialogue: 0,0:19:38.45,0:19:41.72,TEXT CH,,0,0,0,,!
Dialogue: 0,0:19:44.39,0:19:45.48,TEXT CH,,0,0,0,,Жабысқақ!
Dialogue: 0,0:20:06.51,0:20:09.36,TEXT CH,,0,0,0,,SIEGE…
Dialogue: 0,0:20:16.27,0:20:17.98,TEXT CH,,0,0,0,,Талантты дауыс
Dialogue: 0,0:20:18.60,0:20:21.99,TEXT CH,,0,0,0,,Мен доппен ойнадым, ұялшақтығыммен ойнадым.
Dialogue: 0,0:20:22.79,0:20:24.07,TEXT CH,,0,0,0,,Жеткілікті құшақтау
Dialogue: 0,0:20:24.86,0:20:27.97,TEXT CH,,0,0,0,,Бұл басқа ойын.
Dialogue: 0,0:20:28.57,0:20:29.59,TEXT CH,,0,0,0,,Буккиарати тым сабырлы болып тұр.
Dialogue: 0,0:20:34.89,0:20:36.86,TEXT CH,,0,0,0,,Таңсан ер мен әйел араласады.
Dialogue: 0,0:20:39.43,0:20:40.16,TEXT CH,,0,0,0,,Кішкентай емен
Dialogue: 0,0:20:41.15,0:20:44.15,TEXT CH,,0,0,0,,Сондай-ақ... жаңа карта
Dialogue: 0,0:20:51.55,0:20:53.70,TEXT CH,,0,0,0,,Ресейде ұйықтап қалғаннан кейін
Dialogue: 0,0:20:55.53,0:20:58.03,TEXT CH,,0,0,0,,Мен Жапониядан кеткен кезде
Dialogue: 0,0:20:59.29,0:21:00.93,TEXT CH,,0,0,0,,…
Dialogue: 0,0:21:02.66,0:21:03.35,TEXT CH,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:21:05.81,0:21:08.78,TEXT CH,,0,0,0,,Жапонияда телефон нөміріңіз болмаса
Dialogue: 0,0:21:09.98,0:21:12.91,TEXT CH,,0,0,0,,Тапсырысты қайтарып алу
Dialogue: 0,0:21:14.23,0:21:15.70,TEXT CH,,0,0,0,,Қазіргі уақытта дұрыс емес әрекет
Dialogue: 0,0:21:17.65,0:21:19.17,TEXT CH,,0,0,0,,Өлім уақыты
Dialogue: 0,0:21:39.80,0:21:40.59,TEXT CH,,0,0,0,,Міндетті емес
Dialogue: 0,0:21:41.29,0:21:43.14,TEXT CH,,0,0,0,,Қажет емес...
Dialogue: 0,0:21:43.52,0:21:45.49,TEXT CH,,0,0,0,,Қажетсіз Мүмкін емес өткен
Dialogue: 0,0:21:46.83,0:21:49.88,TEXT CH,,0,0,0,,Дүкенде кімсің?
Dialogue: 0,0:21:50.85,0:21:53.23,TEXT CH,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:22:06.55,0:22:08.56,TEXT CH,,0,0,0,,Әрине, ол мөлдір
Dialogue: 0,0:22:09.14,0:22:11.56,TEXT CH,,0,0,0,,Карточка қашан өлді?
Dialogue: 0,0:22:16.14,0:22:19.21,TEXT CH,,0,0,0,,Қазіргі уақытта қабан етін қосу заңдылық.
Dialogue: 0,0:22:23.23,0:22:24.61,TEXT CH,,0,0,0,,Күшті мәселелер
Dialogue: 0,0:22:26.62,0:22:29.63,TEXT CH,,0,0,0,,Noh суретіндегі жаңа карталардың кездесуі
Dialogue: 0,0:22:30.26,0:22:32.07,TEXT CH,,0,0,0,,Бекіту - себептік
Dialogue: 0,0:22:33.26,0:22:35.09,TEXT CH,,0,0,0,,Жапон картасына шолу
Dialogue: 0,0:22:36.35,0:22:38.03,TEXT CH,,0,0,0,,Мен не істеуім керек
Dialogue: 0,0:24:10.66,0:24:12.58,TEXT CH,,0,0,0,,Үй иесі Кожи!
Dialogue: 0,0:24:13.12,0:24:16.50,TEXT CH,,0,0,0,,Такашиге ``Kokamanjitsu'' кітап жинағының басында енгізген.
Dialogue: 0,0:24:16.50,0:24:18.74,TEXT CH,,0,0,0,,Бұл мен ұтып аламын деп үміттенетін бірінші жинақтың қысқаша мазмұны!
Dialogue: 0,0:24:18.74,0:24:21.41,TEXT CH,,0,0,0,,Томоеда орта мектеп формасы
Dialogue: 0,0:24:21.41,0:24:21.42,TEXT CH,,0,0,0,,Қара түске негізделген уақыт дизайны
Dialogue: 0,0:24:23.63,0:24:25.43,TEXT CH,,0,0,0,,Жарық нүктесі – ортадағы қызыл сызық.
Dialogue: 0,0:24:25.59,0:24:29.20,TEXT CH,,0,0,0,,Сол иық мектеп белгісі Казутоме бастауыш сынып оқушысы
Dialogue: 0,0:24:29.79,0:24:31.49,TEXT CH,,0,0,0,,Мүмкіндігінше тезірек
Dialogue: 0,0:24:32.95,0:24:36.68,TEXT CH,,0,0,0,,Бұл қаланың әр жолы жария ететін сезім түрі.
Dialogue: 0,0:24:36.69,0:24:38.28,TEXT CH,,0,0,0,,...
Dialogue: 0,0:24:38.56,0:24:39.34,TEXT CH,,0,0,0,,Қайта кездескенше!
Dialogue: 0,0:24:40.48,0:24:44.54,TEXT CH,,0,0,0,,Біз сіздің командаға қосылу туралы өтінішіңізді күтеміз.
Dialogue: 0,0:24:44.70,0:24:46.64,TEXT CH,,0,0,0,,Алайда жаңбыр тоқтамайды.
Dialogue: 0,0:24:46.82,0:24:48.74,TEXT CH,,0,0,0,,Мофей картадағы жын ба?
Dialogue: 0,0:24:49.36,0:24:51.68,TEXT CH,,0,0,0,,том.
Dialogue: 0,0:24:51.96,0:24:53.09,TEXT CH,,0,0,0,,Кадзуки Вакогаки
Dialogue: 0,0:24:53.09,0:24:54.40,TEXT CH,,0,0,0,,Тығыздау
Dialogue: 0,0:13:36.99,0:13:43.16,TEXT CH,,0,0,0,,：「」「」「ke」
Dialogue: 1,0:02:24.70,0:02:26.91,TEXT CH,,0,0,0,,...
Dialogue: 0,0:02:24.70,0:02:26.91,TEXT CH,,0,0,0,,...
Dialogue: 1,0:02:24.70,0:02:26.91,TEXT CH,,0,0,0,,...
Dialogue: 0,0:02:24.70,0:02:26.91,TEXT CH,,0,0,0,,...
Dialogue: 0,0:09:54.03,0:09:54.94,TEXT CH,,0,0,0,,Суық сүтті сүт протеинін қалай жасайды
Dialogue: 0,0:12:28.60,0:12:30.68,TEXT CH,,0,0,0,,жұп
Dialogue: 0,0:12:28.72,0:12:30.68,TEXT CH,,0,0,0,,Мата
Dialogue: 0,0:12:28.85,0:12:30.68,TEXT CH,,0,0,0,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:12:28.97,0:12:30.68,TEXT CH,,0,0,0,,Өздігінен
Dialogue: 0,0:12:29.10,0:12:30.68,TEXT CH,,0,0,0,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:12:29.22,0:12:30.68,TEXT CH,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:12:29.35,0:12:30.68,TEXT CH,,0,0,0,,Достардан ғашықтарға, тіпті отбасы мүшелерінен де
Dialogue: 0,0:24:31.53,0:24:32.53,TEXT CH,,0,0,0,,Еркектік және талаптар
Dialogue: 0,0:03:18.01,0:03:24.01,Default,,0,0,0,,Шығу және шығуы бар шағын бөлме
Dialogue: 0,0:24:49.26,0:24:55.05,Default,,0,0,0,,Қатты жаңбыр туралы полиция хабарламасы
Dialogue: 0,0:24:56.55,0:25:02.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory