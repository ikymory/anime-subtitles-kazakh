Dialogue: 1,0:01:36.13,0:01:39.35,STAFF 方正正准黑_GBK,,0,0,0,,Syou／ ·domi／ sieki／ ·
Dialogue: 0,0:01:39.85,0:02:13.85,STAFF 方正正准黑_GBK,,0,0,0,Banner;7;0;60,，，，，，， sub.kamigami.org  @
Dialogue: 0,0:01:42.92,0:01:43.55,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сол жерде
Dialogue: 0,0:01:47.79,0:01:48.94,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл не?
Dialogue: 0,0:01:52.33,0:01:53.72,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жер астында не бар?
Dialogue: 0,0:01:55.42,0:01:56.12,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Яндаде
Dialogue: 0,0:02:02.32,0:02:03.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сыртқа шығу
Dialogue: 0,0:02:04.01,0:02:04.64,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тоқтау керек
Dialogue: 0,0:02:06.49,0:02:08.36,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Осындай үлкен бақшаны орап тастай аласыз ба?
Dialogue: 0,0:02:09.08,0:02:09.95,TEXT-JP A-OTF Folk Pro B,,0,0,0,,ҚОРШАУ
Dialogue: 0,0:02:16.86,0:02:19.32,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Үйдегі барлық нәрсені орап алыңыз
Dialogue: 0,0:02:31.37,0:02:33.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл не? Көмектесіңіздер!
Dialogue: 0,0:02:54.17,0:02:55.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дайын, сәлем
Dialogue: 0,0:02:59.18,0:03:00.52,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жарайды, жабық.
Dialogue: 0,0:03:05.08,0:03:05.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Не болды?
Dialogue: 0,0:03:10.22,0:03:11.60,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен қайтып келемін
Dialogue: 0,0:03:12.35,0:03:14.13,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Акан Томойо Нчига
Dialogue: 0,0:03:14.36,0:03:15.23,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Керо-чан
Dialogue: 0,0:03:15.28,0:03:16.16,TEXT-JP A-OTF Folk Pro B,,0,0,0,,О
Dialogue: 0,0:03:24.99,0:03:27.28,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Эй, бұл жақсы ма?
Dialogue: 0,0:03:28.62,0:03:29.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-чан
Dialogue: 0,0:03:34.64,0:03:37.31,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ача лабиринті тұрақсыз
Dialogue: 0,0:03:42.59,0:03:44.07,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Томойо-чан Акихо-чан
Dialogue: 0,0:03:44.19,0:03:45.07,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Асығу керек
Dialogue: 0,0:03:49.31,0:03:49.98,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура
Dialogue: 0,0:03:51.52,0:03:53.16,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен жете алмаймын.
Dialogue: 0,0:04:02.72,0:04:04.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура шықты.
Dialogue: 0,0:04:06.65,0:04:13.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тәңірсіз, арман таяқтың астында күш-қуатым бол.
Dialogue: 0,0:04:14.91,0:04:16.43,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қауіпсіз
Dialogue: 0,0:04:36.09,0:04:37.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,ӘЛЕКТЕЛУ
Dialogue: 0,0:04:39.92,0:04:42.68,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура Жарайсың
Dialogue: 0,0:04:44.99,0:04:47.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ үй мен бақша...
Dialogue: 0,0:04:47.71,0:04:51.15,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ, мен қолдан келгеннің бәрін жасадым, кейін бірге кешірім сұрадық.
Dialogue: 0,0:04:53.44,0:04:55.26,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:05:00.14,0:05:02.36,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Күтіңіз, тоқтаңыз.
Dialogue: 0,0:05:04.52,0:05:06.59,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сағынышқа бой алдырмаңыз
Dialogue: 0,0:05:08.84,0:05:09.68,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Томойо-чан
Dialogue: 0,0:05:11.18,0:05:13.96,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-чан, жараланып қалдың ба?
Dialogue: 0,0:05:14.40,0:05:16.08,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:05:16.16,0:05:17.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен оны картаға айналдырдым.
Dialogue: 0,0:05:18.08,0:05:21.02,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ бақтағы ағаш құлап қалды.
Dialogue: 0,0:05:21.88,0:05:26.01,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-чан мен Керо-чан қауіпсіз болса, бұл ең жақсысы.
Dialogue: 0,0:05:27.05,0:05:28.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Томойо-чан
Dialogue: 0,0:05:28.49,0:05:29.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Томойо
Dialogue: 0,0:05:30.14,0:05:34.81,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Керо-чан керемет кадрлар түсіргеніне сенімдімін.
Dialogue: 0,0:05:36.48,0:05:39.28,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен оны кейінірек көруді асыға күтемін.
Dialogue: 0,0:05:42.36,0:05:44.89,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жер сілкінісі мені қатты таң қалдырды.
Dialogue: 0,0:05:45.34,0:05:46.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Барлығы жақсы болды ма?
Dialogue: 0,0:05:47.18,0:05:48.38,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:05:48.88,0:05:49.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жарайды
Dialogue: 0,0:05:51.92,0:05:53.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Не болды, Акихо-чан?
Dialogue: 0,0:05:54.81,0:05:59.50,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз шақырған үйде тағы ұйықтап қалдым.
Dialogue: 0,0:06:03.29,0:06:05.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мұны істеме, бұл сиқыр.
Dialogue: 0,0:06:06.03,0:06:09.31,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен де ұйықтап қалдым, неге екені белгісіз.
Dialogue: 0,0:06:10.89,0:06:13.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұлай істеме, бұл сиқыр.
Dialogue: 0,0:06:14.64,0:06:18.03,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ мен сенің зардап шекпегеніңе қуаныштымын.
Dialogue: 0,0:06:18.36,0:06:22.20,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дұрыс, әркімнің еш жері ауырмайды, солай ма?
Dialogue: 0,0:06:22.48,0:06:23.05,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:06:23.77,0:06:25.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тағы бір шыны шай алғыңыз келе ме?
Dialogue: 0,0:06:26.14,0:06:27.24,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Itadadakimasu
Dialogue: 0,0:06:32.38,0:06:34.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің устрица жегім келеді
Dialogue: 0,0:06:37.26,0:06:39.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Барлығыңыз, сақ болыңыздар.
Dialogue: 0,0:06:40.48,0:06:42.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кез келген уақытта қайта келіңіз.
Dialogue: 0,0:06:43.77,0:06:45.20,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә, Сакура-чан
Dialogue: 0,0:06:45.60,0:06:46.16,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:06:49.32,0:06:52.49,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Осы жазда атаң не істейді?
Dialogue: 0,0:06:52.89,0:06:55.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ол маған шынымен де қамқор болды.
Dialogue: 0,0:06:57.64,0:07:00.94,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-чан, виллада тағы кездескің келе ме?
Dialogue: 0,0:07:01.26,0:07:04.22,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен әкеңмен сөйлесіп, саған қайтамын.
Dialogue: 0,0:07:07.60,0:07:10.11,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Томойоның анасы керемет еді
Dialogue: 0,0:07:10.40,0:07:12.24,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ол әдемі және жақсы аспазшы.
Dialogue: 0,0:07:12.40,0:07:16.14,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сол ұйыған кілегей өте дәмді болды.
Dialogue: 0,0:07:16.62,0:07:19.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Томойо-чан Сономи-саннан рецепт сұрады.
Dialogue: 0,0:07:20.14,0:07:20.86,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Шынымен
Dialogue: 0,0:07:21.40,0:07:25.34,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің итім үшін түскі шай...
Dialogue: 0,0:07:25.93,0:07:28.00,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Онда мен осындамын.
Dialogue: 0,0:07:28.78,0:07:30.49,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:07:30.70,0:07:32.00,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен де солай.
Dialogue: 0,0:07:32.27,0:07:34.35,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бүгін түсірген суреттерімді кейін жіберемін.
Dialogue: 0,0:07:34.59,0:07:35.05,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:07:35.64,0:07:37.60,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мектепте қайтадан Акихо-чан
Dialogue: 0,0:07:37.85,0:07:39.02,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тағы да иә
Dialogue: 0,0:07:55.88,0:07:57.04,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Көңіл-күйіңіз жақсы.
Dialogue: 0,0:07:57.98,0:07:58.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кайто мырза
Dialogue: 0,0:08:01.52,0:08:02.75,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:08:03.53,0:08:07.45,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Үйге бара жатырсың деген хабар келді, мен сені алып кетуге келдім.
Dialogue: 0,0:08:08.09,0:08:10.36,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ах... рахмет
Dialogue: 0,0:08:11.04,0:08:15.07,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Әдеттегідей, Акихо жақсы әнші.
Dialogue: 0,0:08:16.38,0:08:17.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз мені естідіңіз бе?
Dialogue: 0,0:08:18.20,0:08:19.23,TEXT-JP A-OTF Folk Pro B,,0,0,0,,берік
Dialogue: 0,0:08:22.00,0:08:26.62,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бүгін барған досым да ән айтуды жақсы біледі.
Dialogue: 0,0:08:27.90,0:08:30.28,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә Сол хор бөлімінде
Dialogue: 0,0:08:30.81,0:08:33.71,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дұрыс, бүгін Томойоның анасы
Dialogue: 0,0:08:33.95,0:08:37.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Олар түстен кейінгі өте дәмді шай дайындады.
Dialogue: 0,0:08:39.72,0:08:41.15,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сізге ұнаған сияқты.
Dialogue: 0,0:08:41.52,0:08:42.11,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:08:48.62,0:08:51.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Отбасы іздеген кітаптарды жинау
Dialogue: 0,0:08:51.95,0:08:53.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен көптеген елдерде болдым.
Dialogue: 0,0:08:54.46,0:08:57.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кітапты тапқан бойда ары қарай жылжып кеттім.
Dialogue: 0,0:08:58.28,0:09:01.58,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Маған кез келген елде дос табу қиынға соғады.
Dialogue: 0,0:09:02.68,0:09:05.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл менің кінәм болуы мүмкін.
Dialogue: 0,0:09:06.03,0:09:08.94,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Акихо-сан өте жақсы адам.
Dialogue: 0,0:09:12.57,0:09:15.64,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ мен мұнда тез достар таптым.
Dialogue: 0,0:09:16.33,0:09:17.79,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бәрің де жақсы адамдарсыңдар.
Dialogue: 0,0:09:18.27,0:09:19.15,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:09:20.00,0:09:21.58,TEXT-JP A-OTF Folk Pro B,,0,0,0,,…
Dialogue: 0,0:09:22.32,0:09:23.37,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:09:24.35,0:09:26.33,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:09:26.83,0:09:27.31,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:09:28.27,0:09:31.13,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ол өте сүйкімді және мейірімді адам.
Dialogue: 0,0:09:32.44,0:09:35.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Келесі жолы сіз маған кітапханаңызды көрсетесіз.
Dialogue: 0,0:09:36.04,0:09:37.52,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:09:38.52,0:09:41.71,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіздің әкеңіз археологияға маманданған көрінеді.
Dialogue: 0,0:09:42.28,0:09:44.36,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Онда қызықты кітаптар болуы мүмкін.
Dialogue: 0,0:09:46.06,0:09:50.15,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-санның әкесі туралы айттым ба?
Dialogue: 0,0:09:57.26,0:09:57.98,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:10:17.55,0:10:20.46,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:10:22.56,0:10:23.43,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:10:24.52,0:10:25.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:10:46.50,0:10:46.89,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл
Dialogue: 0,0:10:47.86,0:10:48.69,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Не болды?
Dialogue: 0,0:10:49.36,0:10:51.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ал олардың қол сөмкелері мен аяқ киімдері ше?
Dialogue: 0,0:10:53.00,0:10:57.01,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Келесі жолы Сакура-сан маған кітапханамды көрсетеді.
Dialogue: 0,0:10:58.48,0:11:00.02,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:11:00.90,0:11:02.32,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:11:03.40,0:11:05.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:11:05.77,0:11:09.58,TEXT-JP A-OTF Folk Pro B,,0,0,0,,О, мен сенімен бірге жетсем бола ма?
Dialogue: 0,0:11:09.98,0:11:10.81,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:11:13.10,0:11:14.16,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Рахмет
Dialogue: 0,0:11:33.34,0:11:36.06,TEXT-JP A-OTF Folk Pro B,,0,0,0,,«Мейірімділік достарды тартады» дегеннің шын мәні де осы.
Dialogue: 0,0:11:37.32,0:11:41.68,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Шиномото мырза мен Киномото мырза аты ғана емес, өте ұқсас.
Dialogue: 0,0:11:44.16,0:11:44.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:11:45.24,0:11:45.98,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Айтпады ма?
Dialogue: 0,0:11:46.36,0:11:47.09,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:11:47.36,0:11:48.04,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Күтілгендей
Dialogue: 0,0:12:00.96,0:12:03.09,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіздің айналаңызда қандай адамдар бар?
Dialogue: 0,0:12:03.58,0:12:05.41,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:12:06.13,0:12:09.50,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Айналаңыздағы адамдардың барлығы жақсы адамдар деп ойласаңыз
Dialogue: 0,0:12:10.00,0:12:11.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:12:12.70,0:12:15.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тек жаман адамдар бар деп сенсеңіз
Dialogue: 0,0:12:15.76,0:12:17.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жақсы адам келсе де, байқамайсың.
Dialogue: 0,0:12:19.37,0:12:24.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Білесің бе, кейде жақсы адамдарды көргенде өзімді жалғыз сезінемін.
Dialogue: 0,0:12:32.65,0:12:33.38,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:12:36.65,0:12:37.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кімді білесің?
Dialogue: 0,0:12:37.92,0:12:38.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ
Dialogue: 0,0:12:44.00,0:12:44.70,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:12:47.68,0:12:48.97,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл не?
Dialogue: 0,0:12:55.98,0:12:56.86,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ичиго Сузу-чан
Dialogue: 0,0:13:10.13,0:13:11.52,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:13:11.78,0:13:12.94,TEXT-JP A-OTF Folk Pro B,,0,0,0,,А...рахмет
Dialogue: 0,0:13:15.34,0:13:16.57,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:13:17.26,0:13:18.48,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:13:18.78,0:13:20.23,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ осы уақытқа дейін ештеңе...
Dialogue: 0,0:13:28.62,0:13:30.90,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз бұрынғыдай спортшысыз.
Dialogue: 0,0:13:34.89,0:13:35.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен істедім
Dialogue: 0,0:13:39.30,0:13:40.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:13:41.49,0:13:42.92,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Эй, мұнымен не істеуіміз керек?
Dialogue: 0,0:13:44.13,0:13:47.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Clow Card кезінде де осындай бала болған.
Dialogue: 0,0:13:48.14,0:13:49.72,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ол кезде біз екеуміз.
Dialogue: 0,0:13:50.02,0:13:51.66,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен Сяоранмен жалғыз соғыстым.
Dialogue: 0,0:13:52.65,0:13:54.94,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен олардың бір мезгілде егізге ұқсайтын балалары болғанына сенімдімін.
Dialogue: 0,0:13:56.88,0:13:57.26,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:14:00.57,0:14:01.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,0:14:01.56,0:14:02.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ, осылай.
Dialogue: 0,0:14:04.17,0:14:05.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ичиго Сузу-чан
Dialogue: 0,0:14:06.46,0:14:07.38,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:14:09.16,0:14:10.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл туралы не істеуім керек?
Dialogue: 0,0:14:11.81,0:14:15.20,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Егер ол "TWIN" түріне ұқсас болса, оны картаға айналдыру жолы бірдей болуы мүмкін.
Dialogue: 0,0:14:15.58,0:14:17.98,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ бір ғана бала бар.
Dialogue: 0,0:14:22.41,0:14:23.48,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иықта
Dialogue: 0,0:14:23.68,0:14:25.66,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Екі иығыңдағы тастарды бір уақытта сындырсаң...
Dialogue: 0,0:14:28.54,0:14:29.26,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Киномото мырза
Dialogue: 0,0:14:29.70,0:14:30.06,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:14:31.45,0:14:32.89,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің қозғалыстарымды бақылаңыз
Dialogue: 0,0:14:33.00,0:14:33.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:14:33.82,0:14:34.62,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:14:37.40,0:14:37.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Солға
Dialogue: 0,0:14:38.04,0:14:38.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:14:39.36,0:14:40.20,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Келесі оң жақта
Dialogue: 0,0:14:40.77,0:14:41.10,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:14:41.40,0:14:42.33,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Артқа үш
Dialogue: 0,0:14:42.52,0:14:42.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:14:42.94,0:14:43.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Секіру
Dialogue: 0,0:14:46.97,0:14:47.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Енді менің L екенім әлі ашылмағандықтан, егер Нагаре өлсе,
Dialogue: 0,0:14:47.81,0:14:48.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:15:01.08,0:15:01.72,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Енді
Dialogue: 0,0:15:04.85,0:15:06.66,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Арманның күшін ұстайтын кілт
Dialogue: 0,0:15:09.48,0:15:11.81,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің алдымда шынайы болмысыңды көрсет
Dialogue: 0,0:15:12.96,0:15:14.61,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Шығару
Dialogue: 0,0:15:35.60,0:15:40.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тәңірсіз, арман таяқтың астында менің күш-қуатым бол.
Dialogue: 0,0:15:41.33,0:15:42.14,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қауіпсіз
Dialogue: 0,0:15:57.69,0:15:59.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл шынымен картаға айналды
Dialogue: 0,0:16:00.40,0:16:01.46,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дау
Dialogue: 0,0:16:03.34,0:16:04.30,TEXT-JP A-OTF Folk Pro B,,0,0,0,,КҮРЕС
Dialogue: 0,0:16:06.40,0:16:07.61,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ичиго Сузу-чан жарақат алды ма?
Dialogue: 0,0:16:08.06,0:16:09.20,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бір жері ауырады ма?
Dialogue: 0,0:16:09.50,0:16:10.97,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің бетім қызарып кетті.
Dialogue: 0,0:16:12.86,0:16:13.96,TEXT-JP A-OTF Folk Pro B,,0,0,0,,сызат
Dialogue: 0,0:16:16.01,0:16:18.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Не, сен үйге келдің бе?
Dialogue: 0,0:16:19.34,0:16:23.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бүгін көп нәрсе болды, ендеше жуынып, ұйықтайық.
Dialogue: 0,0:16:31.12,0:16:34.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ичиго Сузу-чанның көмегімен мен оны картаға айналдырып алдым.
Dialogue: 0,0:16:35.14,0:16:36.73,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұлай күйзелме
Dialogue: 0,0:16:37.37,0:16:40.72,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Уау, сын сәтте ұйықтап қалдым.
Dialogue: 0,0:16:42.98,0:16:46.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Егер Томойо менің суретке түсе алмайтынымды білсе ше?
Dialogue: 0,0:16:48.58,0:16:49.81,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл тамаша жігіт кім?
Dialogue: 0,0:16:49.88,0:16:51.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Не болып жатыр? Қандай сұмдық...
Dialogue: 0,0:16:51.93,0:16:53.00,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Осылайша?
Dialogue: 0,0:16:54.44,0:16:55.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:16:58.48,0:16:59.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ванна Рахмет
Dialogue: 0,0:17:00.18,0:17:01.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:17:01.72,0:17:04.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жарайды, сен уайымдаушысың, шынымен.
Dialogue: 0,0:17:05.18,0:17:06.73,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Шашыңды кептірейін
Dialogue: 0,0:17:07.24,0:17:09.00,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жарайды, бірақ... шаршаған жоқсың ба?
Dialogue: 0,0:17:09.30,0:17:11.22,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Егер ол оны өзінің Қабілетімен көтерсе, бастаманы өз қолына алады
Dialogue: 0,0:17:14.45,0:17:16.29,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Алдымен кешірім сұрауым керек пе?
Dialogue: 0,0:17:16.80,0:17:21.30,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Әлде ертең кездескенде осылай айтуым керек пе?
Dialogue: 0,0:17:22.96,0:17:23.70,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:24.93,0:17:25.60,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Не
Dialogue: 0,0:17:26.69,0:17:29.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ичиго Сузу-чан, мен саған қауіп төндірдім.
Dialogue: 0,0:17:32.49,0:17:34.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ мен бақытты болдым.
Dialogue: 0,0:17:37.00,0:17:41.29,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің ойымша, Ичиго-чан екеуміз бірге ештеңе істемедік.
Dialogue: 0,0:17:42.28,0:17:45.12,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен Клоу картасымен жұмыс істегенде көп көмек алдым.
Dialogue: 0,0:17:45.61,0:17:47.37,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тек 2 болған жоқ...
Dialogue: 0,0:17:48.17,0:17:51.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірге жұмыс істеп, қолымнан келгенін жасағаныма өте қуаныштымын.
Dialogue: 0,0:17:52.48,0:17:53.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Рахмет
Dialogue: 0,0:17:59.76,0:18:00.58,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жақсы
Dialogue: 0,0:18:03.24,0:18:05.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,«Кешіріңіз» деп айта берсеңіз
Dialogue: 0,0:18:05.58,0:18:07.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен қалай ашуланамын деп ойладым.
Dialogue: 0,0:18:09.93,0:18:14.28,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен де сізбен алғаш рет карта ұстағаныма қуаныштымын.
Dialogue: 0,0:18:14.92,0:18:16.00,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ичиго Сузу-чан
Dialogue: 0,0:18:19.72,0:18:21.57,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дайдоджи храмынан қайтып келе жатқанда
Dialogue: 0,0:18:22.49,0:18:24.62,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің айтқаным есіңде ме?
Dialogue: 0,0:18:28.01,0:18:31.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,«Кейде жақсы адамдарды көргенде мен өзімді жалғыз сезінемін».
Dialogue: 0,0:18:32.21,0:18:33.24,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сізді қызықтырды ма?
Dialogue: 0,0:18:34.44,0:18:34.89,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:18:36.24,0:18:40.05,TEXT-JP A-OTF Folk Pro B,,0,0,0,,«Жақсы адамдар» десек те, «жақсы адамдардың» алуан түрі бар.
Dialogue: 0,0:18:40.98,0:18:45.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ менің айналамдағы адамдар әрқашан басқа адамдардың бақытын ойлайды.
Dialogue: 0,0:18:46.44,0:18:49.36,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен адамдарды күлдіртуді ойлайтын адаммын.
Dialogue: 0,0:18:50.85,0:18:52.74,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл өте жақсы нәрсе.
Dialogue: 0,0:18:53.42,0:18:56.13,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ мен тек басқа адамдар туралы ойласам
Dialogue: 0,0:18:56.70,0:18:59.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Өзіңді ойламайтын адам бол
Dialogue: 0,0:19:00.65,0:19:04.26,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз де, Сяоран да жақсы көретін адамдарыңыз үшін тым көп жұмыс істеп жатырсыз.
Dialogue: 0,0:19:04.54,0:19:06.64,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Өзіңізге күтім жасауды ұмыттыңыз ба?
Dialogue: 0,0:19:09.64,0:19:11.38,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл әсіресе Сяоранға қатысты.
Dialogue: 0,0:19:11.53,0:19:13.01,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің де басым қатты.
Dialogue: 0,0:19:13.73,0:19:18.14,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Алдымен өзің бақытты бол, Сяоранды оят.
Dialogue: 0,0:19:19.50,0:19:20.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:19:22.08,0:19:22.96,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Өзіңізге сенімді емессіз бе?
Dialogue: 0,0:19:25.04,0:19:29.24,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Әйтеуір...Мен көп нәрсенің басқаша болғанын сеземін.
Dialogue: 0,0:19:30.49,0:19:32.29,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жаңа карталар ғана емес
Dialogue: 0,0:19:33.25,0:19:36.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Маңызды нәрсе дұрыс емес сияқты.
Dialogue: 0,0:19:39.24,0:19:41.72,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен карталар туралы білмеймін.
Dialogue: 0,0:19:42.58,0:19:45.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ сізде ең күшті заклинание бар, солай ма?
Dialogue: 0,0:19:49.96,0:19:52.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мүлдем... жарайды.
Dialogue: 0,0:19:53.28,0:19:54.36,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:19:54.98,0:19:59.41,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ей, қазір кешірім сұрасаң, бүгін өміріңді сақтайсың.
Dialogue: 0,0:19:59.78,0:20:01.09,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қайсысы жақсы деп ойлайсыз?
Dialogue: 0,0:20:04.64,0:20:05.90,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Рахмет
Dialogue: 0,0:20:06.80,0:20:07.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:20:08.58,0:20:10.10,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Барлық көмектеріңіз үшін рахмет.
Dialogue: 0,0:20:10.85,0:20:11.41,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:20:11.66,0:20:15.37,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен көп үйде отыра алмағаныма өкінемін.
Dialogue: 0,0:20:15.88,0:20:18.10,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Өйткені Киномото мырза қолынан келгеннің бәрін жасады.
Dialogue: 0,0:20:18.45,0:20:21.58,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қытай тағамы туралы көп нәрсені білдің деп естідім.
Dialogue: 0,0:20:22.25,0:20:25.01,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен Сакура-санның орындағанын асыға күтемін.
Dialogue: 0,0:20:28.21,0:20:30.38,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Олай болса, көп рахмет.
Dialogue: 0,0:20:32.57,0:20:35.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Маған Сяоран-кунмен кездесудің қажеті жоқ.
Dialogue: 0,0:20:35.84,0:20:38.70,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә, бірдеңе болып қалса, Гонконгқа келесіз.
Dialogue: 0,0:20:39.32,0:20:42.70,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сонымен қатар, мен өз мақсатыма жеттім.
Dialogue: 0,0:20:43.22,0:20:43.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дерлік?
Dialogue: 0,0:20:44.38,0:20:45.01,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:20:45.28,0:20:46.29,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:20:47.80,0:20:51.16,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Енді мен де сені "Сакура" деп атасам бола ма?
Dialogue: 0,0:20:52.97,0:20:53.96,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Әрине
Dialogue: 0,0:20:54.98,0:20:57.34,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мақсат қазір 100% орындалды.
Dialogue: 0,0:21:13.76,0:21:15.33,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура кездескенше
Dialogue: 0,0:21:17.38,0:21:19.68,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жақында кездескенше, Ичиго Сузу-чан
Dialogue: 0,0:21:20.45,0:21:21.89,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ… Оларды Эрен өлтірді!!
Dialogue: 0,0:21:31.65,0:21:31.94,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:21:35.48,0:21:37.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз мені әуежайға апарамын дедіңіз.
Dialogue: 0,0:21:37.92,0:21:39.68,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен үйге жалғыз бара аламын.
Dialogue: 0,0:21:40.09,0:21:41.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Екеуі де қатты қобалжыды.
Dialogue: 0,0:21:42.65,0:21:43.48,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Екеуі де?
Dialogue: 0,0:21:45.76,0:21:51.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дұрыс. Бүгіннен бастап мен Киномото-санды «Сакура» деп атайтын боламын.
Dialogue: 0,0:21:52.70,0:21:53.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Неліктен кенеттен?
Dialogue: 0,0:21:54.18,0:21:56.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірге соғысқан достар
Dialogue: 0,0:21:56.38,0:21:57.38,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Біз шайқассақ та...
Dialogue: 0,0:21:57.72,0:21:59.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Эй, бірдеңе болды ма?
Dialogue: 0,0:21:59.82,0:22:03.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Енді неге Сакурадан тікелей сұрамайсың?
Dialogue: 0,0:22:03.68,0:22:04.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сәлем, Ичиго Сузу...
Dialogue: 0,0:22:16.64,0:22:21.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен Сяоранның не білгенін және Жапонияға не үшін келгенін білмеймін.
Dialogue: 0,0:22:22.97,0:22:24.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сяоранға бірдеңе болса
Dialogue: 0,0:22:25.62,0:22:27.57,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен кімнің қайғыратынын білемін.
Dialogue: 0,0:22:29.77,0:22:31.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен де Сакураның досымын.
Dialogue: 0,0:22:32.90,0:22:34.48,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мені жылатсаң, қабылдамаймын.
Dialogue: 0,0:22:37.04,0:22:37.45,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ах...
Dialogue: 0,0:24:10.17,0:24:12.13,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Коньянячиха
Dialogue: 0,0:24:13.18,0:24:14.68,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жел соққанша, ақыл-ой аттанады
Dialogue: 0,0:24:14.74,0:24:16.05,TEXT-JP A-OTF Folk Pro B,,0,0,0,,«Керо-чанға қалдыр» бұрышы
Dialogue: 0,0:24:16.13,0:24:18.89,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл жолы мен Юна Д.Кайтойяны таныстырамын.
Dialogue: 0,0:24:19.05,0:24:21.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Әрқашан күлімдеп жүретін, әсем мінезді Акихончидің күтушісі.
Dialogue: 0,0:24:21.81,0:24:24.37,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ол сондай-ақ жақсы аспаз болды, оның үй торттары өте дәмді болды.
Dialogue: 0,0:24:24.42,0:24:26.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қара шай және шөп шайы сияқты сусындардың үлкен таңдауы.
Dialogue: 0,0:24:26.92,0:24:29.36,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дәл осы күтуші Кагами сияқты.
Dialogue: 0,0:24:29.42,0:24:31.92,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Беліңізде ілулі тұрған қалта сағаты да жақсы нәрсе.
Dialogue: 0,0:24:32.00,0:24:34.62,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз, бірақ бұл кішкентай қыз күдікті сияқты.
Dialogue: 0,0:24:34.70,0:24:37.10,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің Cerberus антеннам да жылдам әрекет етеді.
Dialogue: 0,0:24:37.16,0:24:38.57,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Келесі жолы жіберіп алмаймын.
Dialogue: 0,0:24:38.64,0:24:40.05,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Хонана
Dialogue: 0,0:24:40.88,0:24:44.41,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Үй шаруашылығы бойынша аспаздық сабағымда мен торт жасауым керек болды.
Dialogue: 0,0:24:44.89,0:24:46.98,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Барлығы әрлеу жұмыстарын жасап жатқанда
Dialogue: 0,0:24:47.21,0:24:48.62,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Декорациялар қозғала бастайды
Dialogue: 0,0:24:49.18,0:24:49.72,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Келесі жолы
Dialogue: 0,0:24:49.98,0:24:51.49,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура және біртүрлі тәттілер
Dialogue: 0,0:24:52.01,0:24:53.06,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакурамен
Dialogue: 0,0:24:53.46,0:24:54.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Шығару
Dialogue: 0,0:24:56.03,0:25:02.03,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
