Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:37.80,0:01:41.12,Default,,0,0,0,,≪(Майои) Атсу... Нацу...→
Dialogue: 0,0:01:41.12,0:01:44.14,Default,,0,0,0,,Нацу… Атсу…
Dialogue: 0,0:01:44.14,0:01:46.80,Default,,0,0,0,,Міне... Нацу
Dialogue: 0,0:01:46.80,0:01:48.81,Default,,0,0,0,,Тексеру
Dialogue: 0,0:01:48.81,0:01:51.80,Default,,0,0,0,,Салқындатқыш кешке жөнделетін сияқты.
Dialogue: 0,0:01:51.80,0:01:53.82,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:01:53.82,0:01:56.17,Default,,0,0,0,,Амансың ба? Майои-сан
Dialogue: 0,0:01:56.17,0:01:58.81,Default,,0,0,0,,Артық емес
Dialogue: 0,0:01:58.81,0:02:00.81,Default,,0,0,0,,Сіз желдеткішті пайдаланасыз ба?
Dialogue: 0,0:02:00.81,0:02:03.81,Default,,0,0,0,,Пу-ки-чан
Dialogue: 0,0:02:06.85,0:02:08.87,Default,,0,0,0,,Ахххх
Dialogue: 0,0:02:08.87,0:02:16.99,Default,,0,0,0,,Ахххх
Dialogue: 0,0:02:16.99,0:02:20.55,Default,,0,0,0,,Бұл бөтен алаяқтық.
Dialogue: 0,0:02:20.55,0:02:23.55,Default,,0,0,0,,Жаңа ғана шықты, солай ма?
Dialogue: 0,0:02:25.47,0:03:52.27,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:06.48,0:05:09.30,Default,,0,0,0,,Салқындатудың қандай да бір жолы бар ма?
Dialogue: 0,0:05:09.30,0:05:12.13,Default,,0,0,0,,Мен желдеткішпен де салқын бола аламын.
Dialogue: 0,0:05:12.13,0:05:15.73,Default,,0,0,0,,Мен де жақсымын, рас па?
Dialogue: 0,0:05:16.96,0:05:19.31,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:19.31,0:05:24.65,Default,,0,0,0,,Бөлмеңізге мұзды су құйылған көп ыдысты қоюға қалай қарайсыз?
Dialogue: 0,0:05:24.65,0:05:27.47,Default,,0,0,0,,Мұз немесе мұз көп емес.
Dialogue: 0,0:05:27.47,0:05:30.64,Default,,0,0,0,,Бірақ егер сіз оны қолдансаңыз, ол салқын болуы мүмкін.
Dialogue: 0,0:05:30.64,0:05:32.62,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:32.62,0:05:36.79,Default,,0,0,0,,Содан кейін бөлмеге мұздың орнына көп құрғақ мұз қойыңыз.
Dialogue: 0,0:05:36.79,0:05:38.79,Default,,0,0,0,,Міне.
Dialogue: 0,0:05:38.79,0:05:41.89,Default,,0,0,0,,Тоқта, оттегінің жетіспеуінен қауіпті.
Dialogue: 0,0:05:46.45,0:05:50.12,Default,,0,0,0,,Мияу, дәптер саған термен жабысады.
Dialogue: 0,0:05:50.12,0:05:52.47,Default,,0,0,0,,Кітапханаға барамыз ба?
Dialogue: 0,0:05:52.47,0:05:54.98,Default,,0,0,0,,Бірақ ол бізден алыс.
Dialogue: 0,0:05:54.98,0:05:59.08,Default,,0,0,0,,Ең жақын адам – Ими-сан.
Dialogue: 0,0:06:00.13,0:06:04.80,Default,,0,0,0,,Бірақ кенеттен барсаң, әбігер болады.
Dialogue: 0,0:06:04.80,0:06:09.21,Default,,0,0,0,,Олай болса Имидің үйіне баруды доғар...
Dialogue: 0,0:06:09.21,0:06:12.14,Default,,0,0,0,,Нян Шах
Dialogue: 0,0:06:12.14,0:06:14.44,Default,,0,0,0,,Бұл қайсысы?
Dialogue: 0,0:06:20.50,0:06:22.64,Default,,0,0,0,,Атс…
Dialogue: 0,0:06:22.64,0:06:25.62,Default,,0,0,0,,Ими-кунға хабарласуым керек пе?
Dialogue: 0,0:06:25.62,0:06:31.46,Default,,0,0,0,,Бұл... кенеттен осындай жағдай болды.
Dialogue: 0,0:06:31.46,0:06:38.46,Default,,0,0,0,,Таң қалдыру жақсы...
Dialogue: 0,0:06:39.47,0:06:41.46,Default,,0,0,0,,Амал жоқ, амал жоқ.
Dialogue: 0,0:06:41.46,0:06:44.96,Default,,0,0,0,,Химе-цчи, мені суытатын бірдеңе айт.
Dialogue: 0,0:06:44.96,0:06:46.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:46.96,0:06:50.46,Default,,0,0,0,,Мм... балмұздақ
Dialogue: 0,0:06:53.07,0:06:56.79,Default,,0,0,0,,Цумики-сан, мені суытатын бірдеңе айт.
Dialogue: 0,0:06:56.79,0:07:00.19,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:07:00.19,0:07:02.23,Default,,0,0,0,,Демек, бұл… иллюзия.
Dialogue: 0,0:07:02.23,0:07:05.63,Default,,0,0,0,,Өлім! ? Хехехе, суық.
Dialogue: 0,0:07:05.63,0:07:08.13,Default,,0,0,0,,Мен оны қолдана аламын ба деп қорқамын
Dialogue: 0,0:07:08.13,0:07:10.13,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:14.04,0:07:16.14,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:16.14,0:07:20.46,Default,,0,0,0,,Менде аз ғана үй тапсырмасы қалды, бірақ оған біраз уақыт кетті.
Dialogue: 0,0:07:20.46,0:07:23.82,Default,,0,0,0,,Қазір сағат неше? (Imi) 14:00
Dialogue: 0,0:07:23.82,0:07:26.62,Default,,0,0,0,,Бір күнде осыншама ілгерілеушілікке қол жеткізе алсаңыз, табысты боласыз.
Dialogue: 0,0:07:26.62,0:07:31.47,Default,,0,0,0,,Ал, мен жолда ойын ойнап жатырмын.
Dialogue: 0,0:07:31.47,0:07:33.48,Default,,0,0,0,,Ұйықтап жатқанда ойнамаңыз
Dialogue: 0,0:07:33.48,0:07:36.55,Default,,0,0,0,,Дәлірек айтсақ, мен шынымен ұйықтап жатырмын.
Dialogue: 0,0:07:36.55,0:07:38.46,Default,,0,0,0,,Don't sleep. Сен ұйықтасаң, мен оны жайғастырамын.
Dialogue: 0,0:07:38.46,0:07:40.47,Default,,0,0,0,,Не?
Dialogue: 0,0:07:40.47,0:07:44.47,Default,,0,0,0,,Футон Егер ұйықтайтын болсаңыз, дұрыс демалыңыз.
Dialogue: 0,0:07:44.47,0:07:48.14,Default,,0,0,0,,Ұйықтар алдында сұраңыз
Dialogue: 0,0:07:48.14,0:07:50.14,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:56.80,0:07:58.80,Default,,0,0,0,,Сіз қайсысысыз?
Dialogue: 0,0:07:58.80,0:08:00.80,Default,,0,0,0,,Мен мен
Dialogue: 0,0:08:04.29,0:08:06.29,Default,,0,0,0,,Мен сізді кездестіремін
Dialogue: 0,0:08:12.15,0:08:16.45,Default,,0,0,0,,Ah, what? Бұл шақыру немесе басқа нәрсе ме?
Dialogue: 0,0:08:16.45,0:08:20.01,Default,,0,0,0,,Мен алаяқ болдым. Бұл жаман сөз.
Dialogue: 0,0:08:20.01,0:08:22.04,Default,,0,0,0,,(Кіріс ұялы қоңырау)
Dialogue: 0,0:08:22.04,0:08:24.14,Default,,0,0,0,,Ұялы телефон қосулы
Dialogue: 0,0:08:25.81,0:08:28.31,Default,,0,0,0,,From Mayoi
Dialogue: 0,0:08:28.31,0:08:31.80,Default,,0,0,0,,Сәлем, мен, мен... мияу~
Dialogue: 0,0:08:31.80,0:08:35.95,Default,,0,0,0,,Не болды? I was a fraud
Dialogue: 0,0:08:35.95,0:08:37.95,Default,,0,0,0,,Mayoi, right?
Dialogue: 0,0:08:38.97,0:08:42.13,Default,,0,0,0,,Сәлеметсіз бе, мазалағаным үшін кешіріңіз.
Dialogue: 0,0:08:42.13,0:08:46.98,Default,,0,0,0,,Кешіріңіз, менің ұйқым қанып, ес-түссіз болғаным сонша, оны алаяқтық деп түсіндім.
Dialogue: 0,0:08:46.98,0:08:50.08,Default,,0,0,0,,Мен, мен! ? Бұл тағы да алдау
Dialogue: 0,0:08:51.80,0:08:54.96,Default,,0,0,0,,Біз бөтен алаяқ едік
Dialogue: 0,0:08:54.96,0:08:57.63,Default,,0,0,0,,Шкаласы әртүрлі.
Dialogue: 0,0:08:57.63,0:09:01.13,Default,,0,0,0,,Менің ұлым НЛО-мен велосипедпен апатқа ұшырады.
Dialogue: 0,0:09:01.13,0:09:03.13,Default,,0,0,0,,Мен бұл жағдайды түсінбеймін.
Dialogue: 0,0:09:03.13,0:09:06.73,Default,,0,0,0,,Таң, сондықтан мен білмеймін.
Dialogue: 0,0:09:08.54,0:09:10.46,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:09:10.46,0:09:12.79,Default,,0,0,0,,А, Сәлем Сакаки-сан.
Dialogue: 0,0:09:12.79,0:09:14.79,Default,,0,0,0,,Meow Ah!
Dialogue: 0,0:09:15.79,0:09:18.85,Default,,0,0,0,,Жоқ, бұл жаңа кептірілген футон
Dialogue: 0,0:09:18.85,0:09:22.13,Default,,0,0,0,,Ах, мен оны жаңа ғана импорттадым.
Dialogue: 0,0:09:22.13,0:09:24.63,Default,,0,0,0,,Dive
Dialogue: 0,0:09:30.79,0:09:32.79,Default,,0,0,0,,≪(Майои) Цумики-сан
Dialogue: 0,0:09:32.79,0:09:35.46,Default,,0,0,0,,Иго-сан жастығы Поф
Dialogue: 0,0:09:35.46,0:09:37.47,Default,,0,0,0,,Сонымен бүгін не болды?
Dialogue: 0,0:09:37.47,0:09:40.80,Default,,0,0,0,,Мен мұнда суытып, көңіл көтеру үшін келдім.
Dialogue: 0,0:09:40.80,0:09:42.82,Default,,0,0,0,,Неге үй тапсырмасын орындамайсың?
Dialogue: 0,0:09:42.82,0:09:44.96,Default,,0,0,0,,Ня
Dialogue: 0,0:09:44.96,0:09:53.00,Default,,0,0,0,,Fluffy Fluffy…
Dialogue: 0,0:09:53.00,0:09:55.10,Default,,0,0,0,,Tsumiki-san?
Dialogue: 0,0:10:00.46,0:10:02.46,Default,,0,0,0,,Fluffy!
Dialogue: 0,0:10:02.46,0:10:05.76,Default,,0,0,0,,Бұл кальян емес пе? Ол пушистый ма?
Dialogue: 0,0:10:08.13,0:10:10.47,Default,,0,0,0,,Үй тапсырмасы тек Майойда қалды ма?
Dialogue: 0,0:10:10.47,0:10:12.47,Default,,0,0,0,,Бұл мен және Химе-ччи.
Dialogue: 0,0:10:12.47,0:10:15.80,Default,,0,0,0,,Ах, мен Цумики отбасында бітірдім.
Dialogue: 0,0:10:15.80,0:10:17.81,Default,,0,0,0,,Иә, мен білмей тұрып! ?
Dialogue: 0,0:10:17.81,0:10:21.79,Default,,0,0,0,,Ханшайым дұрыс жүрді, иә?
Dialogue: 0,0:10:21.79,0:10:23.79,Default,,0,0,0,,Жақсы қыз Жақсы қыз
Dialogue: 0,0:10:24.80,0:10:27.80,Default,,0,0,0,,Айтпақшы, жазғы фестиваль ертең ме?
Dialogue: 0,0:10:27.80,0:10:31.45,Default,,0,0,0,,Бәріміз барамыз ба? Хахи, бұл жақсы
Dialogue: 0,0:10:31.45,0:10:35.12,Default,,0,0,0,,Егер солай болса, екеуміз де тез бітіреміз деп ойлаймын.
Dialogue: 0,0:10:35.12,0:10:37.81,Default,,0,0,0,,Менің барғым келді
Dialogue: 0,0:10:37.81,0:10:39.81,Default,,0,0,0,,Мен ерте бердім.
Dialogue: 0,0:10:41.46,0:10:44.80,Default,,0,0,0,,Жоқ, мен бас тарта алмаймын, нян
Dialogue: 0,0:10:44.80,0:10:49.12,Default,,0,0,0,,Үй тапсырмасын тез бітіремін, ол үшін уайымдама.
Dialogue: 0,0:10:49.12,0:10:53.46,Default,,0,0,0,,Сол жерде ойын ойнауға болады.
Dialogue: 0,0:10:53.46,0:10:56.80,Default,,0,0,0,,Осыны тез аяқтап, тезірек кездесейік.
Dialogue: 0,0:10:56.80,0:10:58.80,Default,,0,0,0,,Сока
Dialogue: 0,0:11:06.71,0:11:08.62,Default,,0,0,0,,Имиге лақтыру
Dialogue: 0,0:11:08.62,0:11:11.63,Default,,0,0,0,,Ху~ мен Цумики-санды лақтырамын.
Dialogue: 0,0:11:11.63,0:11:13.63,Default,,0,0,0,,Арнайы қозғалыс Хонья~
Dialogue: 0,0:11:13.63,0:11:15.63,Default,,0,0,0,,тәтті соққы
Dialogue: 0,0:11:15.63,0:11:17.80,Default,,0,0,0,,Бұл зымыран. Бұл қауіпті.
Dialogue: 0,0:11:17.80,0:11:19.80,Default,,0,0,0,,Уну Ммуму
Dialogue: 0,0:11:19.80,0:11:21.79,Default,,0,0,0,,Жорғалау ұнамды
Dialogue: 0,0:11:21.79,0:11:24.97,Default,,0,0,0,,Қандай қарсы Мукю~
Dialogue: 0,0:11:24.97,0:11:27.48,Default,,0,0,0,,Қауіпсіз тепкілеңіз
Dialogue: 0,0:11:27.48,0:11:30.78,Default,,0,0,0,,А, бұл қауіпті.
Dialogue: 0,0:11:32.33,0:11:34.88,Default,,0,0,0,,Кенеттен не болды? ?
Dialogue: 0,0:11:34.88,0:11:36.88,Default,,0,0,0,,Ах
Dialogue: 0,0:11:39.81,0:11:44.63,Default,,0,0,0,,Ақыр соңында мен тыныш болуым керек пе? Сіз шоғырлана алмайсыз.
Dialogue: 0,0:11:44.63,0:11:47.80,Default,,0,0,0,,Жарайды, уайымдама.
Dialogue: 0,0:11:47.80,0:11:50.47,Default,,0,0,0,,Уайымдамаңыз, оны шоу уақыты деп атаңыз.
Dialogue: 0,0:11:50.47,0:11:55.14,Default,,0,0,0,,Иә, түсінемін. Менің санам ұшып бара жатқан сияқты.
Dialogue: 0,0:11:55.14,0:11:57.81,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:11:57.81,0:11:59.81,Default,,0,0,0,,Ах ха
Dialogue: 0,0:11:59.81,0:12:03.81,Default,,0,0,0,,Жарайды, тағы бір сіріңке алайық, хаха.
Dialogue: 0,0:12:06.97,0:12:08.97,Default,,0,0,0,,Ими-кун ұстап алды Уау
Dialogue: 0,0:12:08.97,0:12:11.47,Default,,0,0,0,,Ұшып кет~ Таң атып
Dialogue: 0,0:12:11.47,0:12:15.12,Default,,0,0,0,,Цумики мырза, бұл қорқынышты, хехехе
Dialogue: 0,0:12:15.12,0:12:17.72,Default,,0,0,0,,Онда бомба бар
Dialogue: 0,0:12:22.80,0:12:26.10,Default,,0,0,0,,Мен де ойнаймын, мен де ойнаймын
Dialogue: 0,0:12:27.14,0:12:30.67,Default,,0,0,0,,Мен солай болады деп ойладым хахаха
Dialogue: 0,0:12:30.67,0:12:32.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:34.46,0:12:37.80,Default,,0,0,0,,Аяқталды~ Ойнайық~
Dialogue: 0,0:12:37.80,0:12:40.85,Default,,0,0,0,,Еңбектеріңіз үшін рахмет
Dialogue: 0,0:12:40.85,0:12:44.85,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, мен жалғыз ұйықтап қалдым.
Dialogue: 0,0:12:45.80,0:12:50.29,Default,,0,0,0,,Фуфуфуфуфу менің қолымнан келмейді, сондықтан мен сіздің бетіңізге граффити саламын.
Dialogue: 0,0:12:50.29,0:12:54.46,Default,,0,0,0,,Хуэт Хуэт Хуэт Қандай нәрсе жақсы?
Dialogue: 0,0:12:54.46,0:12:57.80,Default,,0,0,0,,Маған ұйықтауға рұқсат етіңіз.
Dialogue: 0,0:12:57.80,0:13:01.47,Default,,0,0,0,,Ендеше, таң қалдырған ауыз соратын белгі ше?
Dialogue: 0,0:13:01.47,0:13:03.47,Default,,0,0,0,,Ерін немесе жылтыр
Dialogue: 0,0:13:03.47,0:13:05.46,Default,,0,0,0,,Олай болса~
Dialogue: 0,0:13:05.46,0:13:07.76,Default,,0,0,0,,Бұл қандай белгі?
Dialogue: 0,0:13:09.13,0:13:11.30,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:11.30,0:13:13.90,Default,,0,0,0,,Ерінге арналған әмиян
Dialogue: 0,0:13:17.29,0:13:21.59,Default,,0,0,0,,Поцелу... Поцелу... Марк
Dialogue: 0,0:13:49.32,0:13:52.12,Default,,0,0,0,,Эх, Эх, Цумики-сан
Dialogue: 0,0:13:52.12,0:13:54.64,Default,,0,0,0,,Ерінге тікелей емес
Dialogue: 0,0:13:54.64,0:13:58.44,Default,,0,0,0,,Егер сіз ерніңізбен сүйіспеншілік пішінін салсаңыз...
Dialogue: 0,0:13:59.49,0:14:02.49,Default,,0,0,0,,Буха, тезірек!
Dialogue: 0,0:14:03.47,0:14:06.47,Default,,0,0,0,,Содан ұятқа шыдай алмай, ұйықтап қалды.
Dialogue: 0,0:14:06.47,0:14:08.47,Default,,0,0,0,,Миу Миу…
Dialogue: 0,0:15:27.47,0:15:30.64,Default,,0,0,0,,≪(Майои) Яхо~ Джайо
Dialogue: 0,0:15:30.64,0:15:34.29,Default,,0,0,0,,Қайырлы кеш, күткеніңізге рахмет.
Dialogue: 0,0:15:34.29,0:15:38.48,Default,,0,0,0,,Жоқ, мен мұнда жаңа келдім Юката Жақсы жұмыс
Dialogue: 0,0:15:38.48,0:15:40.96,Default,,0,0,0,,Юкатада бәрі жақсы көрінеді.
Dialogue: 0,0:15:40.96,0:15:43.97,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:43.97,0:15:49.97,Default,,0,0,0,,Игоның кеудесі... Муна... Муна...
Dialogue: 0,0:15:49.97,0:15:51.96,Default,,0,0,0,,Муня
Dialogue: 0,0:15:51.96,0:15:54.63,Default,,0,0,0,,Сіз кеудені сексуалды деп айтқыңыз келе ме?
Dialogue: 0,0:15:54.63,0:15:57.43,Default,,0,0,0,,Мен олай айтқан жоқпын, жоқ.
Dialogue: 0,0:15:58.56,0:16:01.47,Default,,0,0,0,,Юката қызметі
Dialogue: 0,0:16:01.47,0:16:03.80,Default,,0,0,0,,Дәл…
Dialogue: 0,0:16:03.80,0:16:06.64,Default,,0,0,0,,Фестиваль алдында зейнеткерлікке шықсаңыз жақсы емес →
Dialogue: 0,0:16:06.64,0:16:09.14,Default,,0,0,0,,Нақты нәрсе қазір басталады
Dialogue: 0,0:16:11.13,0:16:14.15,Default,,0,0,0,,Игоның соққысы ішке кіреді
Dialogue: 0,0:16:14.15,0:16:16.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:18.47,0:16:21.64,Default,,0,0,0,,≪(Майои) Енді алдымен не істеуіміз керек?
Dialogue: 0,0:16:21.64,0:16:23.64,Default,,0,0,0,,Мен абдырап қалдым.
Dialogue: 0,0:16:24.79,0:16:27.89,Default,,0,0,0,,≪(ханшайым) Хх~ Бәрі дәмді көрінеді.
Dialogue: 0,0:16:29.46,0:16:32.96,Default,,0,0,0,,Бір такояки өтінемін ≪(Сакаки) О, жақсы→
Dialogue: 0,0:16:32.96,0:16:34.96,Default,,0,0,0,,Бір элемент
Dialogue: 0,0:16:39.14,0:16:42.81,Default,,0,0,0,,Сіз цумики жейсіз бе?
Dialogue: 0,0:16:42.81,0:16:44.81,Default,,0,0,0,,Цумики-сан Такоякиден
Dialogue: 0,0:16:44.81,0:16:47.15,Default,,0,0,0,,Ими-санның а-а-нын қалайсыз, солай емес пе?
Dialogue: 0,0:16:47.15,0:16:49.46,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:16:49.46,0:16:52.80,Default,,0,0,0,,Бұл қажет емес пе? Бұл дәмді
Dialogue: 0,0:16:52.80,0:16:58.47,Default,,0,0,0,,Мен… Мен… Мен… Онда
Dialogue: 0,0:16:58.47,0:17:01.81,Default,,0,0,0,,Жақсы жұмыс Цумики-сан
Dialogue: 0,0:17:01.81,0:17:03.81,Default,,0,0,0,,Анио
Dialogue: 0,0:17:05.80,0:17:09.18,Default,,0,0,0,,Иә Цумики Иә
Dialogue: 0,0:17:09.18,0:17:11.24,Default,,0,0,0,,Ах~
Dialogue: 0,0:17:11.24,0:17:13.24,Default,,0,0,0,,Ах
Dialogue: 0,0:17:14.12,0:17:17.31,Default,,0,0,0,,Бұл уәде ғой, бұзақы!
Dialogue: 0,0:17:17.31,0:17:20.48,Default,,0,0,0,,А, жоқ, іші ыстық.
Dialogue: 0,0:17:20.48,0:17:23.63,Default,,0,0,0,,Мен кенеттен күйіп қалуым мүмкін екенін түсіндім.
Dialogue: 0,0:17:23.63,0:17:25.63,Default,,0,0,0,,Хукер!
Dialogue: 0,0:17:27.30,0:17:31.31,Default,,0,0,0,,А, сіз бәрімен бірге Катануки ойнағыңыз келе ме?
Dialogue: 0,0:17:31.31,0:17:35.19,Default,,0,0,0,,Жарайсыңдар, байқап көрейік.
Dialogue: 0,0:17:35.19,0:17:37.48,Default,,0,0,0,,Бұл ностальгиялық, иә.
Dialogue: 0,0:17:37.48,0:17:39.45,Default,,0,0,0,,Олай болса~
Dialogue: 0,0:17:39.45,0:17:41.45,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:43.35,0:17:45.89,Default,,0,0,0,,Химечиге қайсысын таңдадыңыз?
Dialogue: 0,0:17:45.89,0:17:49.97,Default,,0,0,0,,≪(ханшайым) Менде оңай болып көрінетін 150 нүктелі беде бар.
Dialogue: 0,0:17:49.97,0:17:54.55,Default,,0,0,0,,≪(Майои) Содан кейін мен 3000 ұпай жинағанды ​​сатып аламын.
Dialogue: 0,0:17:54.55,0:17:56.46,Default,,0,0,0,,Алдама, Майой
Dialogue: 0,0:17:56.46,0:17:59.80,Default,,0,0,0,,Бұл әділ ойын
Dialogue: 0,0:17:59.80,0:18:02.40,Default,,0,0,0,,Иә? ше? Химекчи
Dialogue: 0,0:18:03.47,0:18:07.48,Default,,0,0,0,,Ей! Хмм... бұзылды.
Dialogue: 0,0:18:07.48,0:18:11.46,Default,,0,0,0,,Дөңмай Химе Доңмай
Dialogue: 0,0:18:11.46,0:18:15.13,Default,,0,0,0,,О, Ими-сан да сынақ. Хмм.
Dialogue: 0,0:18:15.13,0:18:18.64,Default,,0,0,0,,Иә, бұл Имидің бармақ.
Dialogue: 0,0:18:18.64,0:18:20.64,Default,,0,0,0,,О?
Dialogue: 0,0:18:35.95,0:18:38.14,Default,,0,0,0,,Орындалды (2 адам) Жооо! ?
Dialogue: 0,0:18:38.14,0:18:42.79,Default,,0,0,0,,Мен көремін. Сонымен, сіз ену соққысын реттеп, пішінді алып тастадыңыз ба?
Dialogue: 0,0:18:42.79,0:18:46.15,Default,,0,0,0,,Неліктен? Бұлай етпе, Иго
Dialogue: 0,0:18:46.15,0:18:48.15,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:48.15,0:18:52.47,Default,,0,0,0,,Оны матч кезінде көрсетпеуіңіз керек еді.
Dialogue: 0,0:18:52.47,0:18:58.27,Default,,0,0,0,,Маған сол техниканы қолдануға рұқсат етіңіз.
Dialogue: 0,0:19:07.64,0:19:10.81,Default,,0,0,0,,Енді алтын балық аулау жарысына
Dialogue: 0,0:19:10.81,0:19:12.81,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:19:12.81,0:19:15.41,Default,,0,0,0,,Жарайды, мен бұл жолы жеңілмеймін.
Dialogue: 0,0:19:17.66,0:19:22.47,Default,,0,0,0,,Міне, осы нәзік шеберлік туады.
Dialogue: 0,0:19:22.47,0:19:24.64,Default,,0,0,0,,Алтын балық қуырады
Dialogue: 0,0:19:24.64,0:19:26.64,Default,,0,0,0,,Өткізіп алмаңыз
Dialogue: 0,0:19:27.62,0:19:31.14,Default,,0,0,0,,Бірақ алтын балықтар да жүрексіз өмірге толы.
Dialogue: 0,0:19:31.14,0:19:33.14,Default,,0,0,0,,Ұнамаған
Dialogue: 0,0:19:34.80,0:19:38.47,Default,,0,0,0,,Алтын балықтың айналуы
Dialogue: 0,0:19:38.47,0:19:40.47,Default,,0,0,0,,Тоқта
Dialogue: 0,0:19:42.14,0:19:44.14,Default,,0,0,0,,Қалай болғанда да, мен де
Dialogue: 0,0:19:46.81,0:19:48.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:50.46,0:19:52.46,Default,,0,0,0,,Ах
Dialogue: 0,0:19:54.13,0:19:56.47,Default,,0,0,0,,Алтын балықты сүзу ұғымын жоймаңыз
Dialogue: 0,0:19:56.47,0:19:58.80,Default,,0,0,0,,Бұл менің ниетім емес еді.
Dialogue: 0,0:19:58.80,0:20:01.81,Default,,0,0,0,,Дұрысы, мен Спиннің айтқанын қаламаймын.
Dialogue: 0,0:20:01.81,0:20:03.81,Default,,0,0,0,,Сәлем, балалар!
Dialogue: 0,0:20:10.47,0:20:12.98,Default,,0,0,0,,Қарт…
Dialogue: 0,0:20:12.98,0:20:16.79,Default,,0,0,0,,Хаха, алтын балық үрейлене бастады.
Dialogue: 0,0:20:16.79,0:20:21.46,Default,,0,0,0,,Сенің түйсігің Цумикидің мысық тәрізді табиғатына жем болады деп ойладым.
Dialogue: 0,0:20:21.46,0:20:23.46,Default,,0,0,0,,Мен олай жасамас едім.
Dialogue: 0,0:20:23.46,0:20:26.56,Default,,0,0,0,,Олай болса, Цумики-сан, мияу айтшы.
Dialogue: 0,0:20:31.64,0:20:33.74,Default,,0,0,0,,Алтын балық мырза~!
Dialogue: 0,0:20:38.51,0:20:40.51,Default,,0,0,0,,Ах
Dialogue: 0,0:20:41.65,0:20:43.75,Default,,0,0,0,,Не болды? Цумики
Dialogue: 0,0:20:44.80,0:20:46.80,Default,,0,0,0,,≪(ханшайым) Бұл ату дүкені.
Dialogue: 0,0:20:46.80,0:20:50.72,Default,,0,0,0,,Түсіру? Бұл жақсы. Мен мұны істегім келеді.
Dialogue: 0,0:20:50.72,0:20:52.82,Default,,0,0,0,,Қане, бәріміз бірге орындайық.
Dialogue: 0,0:20:56.14,0:20:59.14,Default,,0,0,0,,≪(Сакаки) Әртүрлі таңдаудың көп болуы қызық.
Dialogue: 0,0:21:00.13,0:21:02.80,Default,,0,0,0,,Базука жоқ, солай ма?→
Dialogue: 0,0:21:02.80,0:21:04.80,Default,,0,0,0,,Таң
Dialogue: 0,0:21:05.80,0:21:08.14,Default,,0,0,0,,Шашырау! Не?
Dialogue: 0,0:21:08.14,0:21:10.14,Default,,0,0,0,,Бұл тығын ба, әлде азық-түлік дүкені ме?
Dialogue: 0,0:21:12.71,0:21:16.13,Default,,0,0,0,,≪(ханшайым) Менің үлкен нәрсеге қолым жетпейді →
Dialogue: 0,0:21:16.13,0:21:18.63,Default,,0,0,0,,Мұны кішірек етіп жасаңыз.
Dialogue: 0,0:21:18.63,0:21:22.80,Default,,0,0,0,,Бірақ бұл сүйкімді тұлып болса, оны ату қиын.
Dialogue: 0,0:21:22.80,0:21:24.79,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:24.79,0:21:28.46,Default,,0,0,0,,Мен сіз үшін атып аламын. Бұл жауапкершіліктің ауысуы.
Dialogue: 0,0:21:28.46,0:21:32.46,Default,,0,0,0,,Мен үшін атуға болады, бұл сергітеді.
Dialogue: 0,0:21:32.46,0:21:35.46,Default,,0,0,0,,Маған қарамастан түсіріңіз (2 адам) Сізге ұнауы мүмкін
Dialogue: 0,0:21:43.12,0:21:46.53,Default,,0,0,0,,Ха... Мен оны әлі түсіре алмаймын.
Dialogue: 0,0:21:46.53,0:21:49.56,Default,,0,0,0,,Осындай екіленетін ханшайымға кеңес
Dialogue: 0,0:21:49.56,0:21:51.97,Default,,0,0,0,,Не? кеңес?
Dialogue: 0,0:21:51.97,0:21:56.14,Default,,0,0,0,,Алдымен мылтықты сол сүйкімді тұлыпқа бағыттап, жақсылап көздеңіз.
Dialogue: 0,0:21:56.14,0:21:59.64,Default,,0,0,0,,Хахахахи, ойланбаңыз.
Dialogue: 0,0:21:59.64,0:22:03.51,Default,,0,0,0,,Қолыңыздағы мылтық триггерін тартыңыз
Dialogue: 0,0:22:03.51,0:22:06.63,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:22:06.63,0:22:09.13,Default,,0,0,0,,Тұлыпта тесік бар
Dialogue: 0,0:22:10.12,0:22:13.42,Default,,0,0,0,,Берілме! Ха!
Dialogue: 0,0:22:15.79,0:22:20.46,Default,,0,0,0,,Кел, жүрегің ыстық, ойың салқын болсын. Снайп жасайық.
Dialogue: 0,0:22:20.46,0:22:22.46,Default,,0,0,0,,Хахи
Dialogue: 0,0:22:24.47,0:22:26.77,Default,,0,0,0,,Жел тесігі... Сәлем!
Dialogue: 0,0:22:27.79,0:22:30.62,Default,,0,0,0,,Сондықтан да мен бас тартпадым.
Dialogue: 0,0:22:30.62,0:22:32.81,Default,,0,0,0,,Тығыннан жасалған мылтық оған өтпейді.
Dialogue: 0,0:22:32.81,0:22:34.79,Default,,0,0,0,,Хахи
Dialogue: 0,0:22:34.79,0:22:40.47,Default,,0,0,0,,＜Еніп кетпейді Енбейді...＞
Dialogue: 0,0:22:40.47,0:22:43.47,Default,,0,0,0,,Бұл не? Керісінше, қорқынышты.
Dialogue: 0,0:22:43.47,0:22:46.07,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:22:48.96,0:22:50.96,Default,,0,0,0,,Ооо
Dialogue: 0,0:22:51.96,0:22:53.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:55.01,0:22:58.63,Default,,0,0,0,,Мен мұны істедім. Бұл жұмыс істемеді.
Dialogue: 0,0:22:58.63,0:23:01.47,Default,,0,0,0,,Олай емес, ханшайым.
Dialogue: 0,0:23:01.47,0:23:04.47,Default,,0,0,0,,Соқты, бірақ құламады.
Dialogue: 0,0:23:04.47,0:23:07.77,Default,,0,0,0,,Жоқ, ол әлі дірілдеп тұр.
Dialogue: 0,0:23:09.86,0:23:11.90,Default,,0,0,0,,Не!
Dialogue: 0,0:23:11.90,0:23:14.80,Default,,0,0,0,,Мен түсіндім. Керемет жұмыс, ханшайым.
Dialogue: 0,0:23:14.80,0:23:17.80,Default,,0,0,0,,Тамаша, сен мені құлаттың, иә?
Dialogue: 0,0:23:21.79,0:23:24.96,Default,,0,0,0,,Хх~ Мен алсам қуанамын.
Dialogue: 0,0:23:24.96,0:23:29.13,Default,,0,0,0,,Бақытты тұлыпты ұстап алғаныңызға қуаныштымын.
Dialogue: 0,0:23:29.13,0:23:31.43,Default,,0,0,0,,<Түсіру>
Dialogue: 0,0:23:35.64,0:23:37.64,Default,,0,0,0,,<Ямею>
Dialogue: 0,0:23:39.62,0:23:41.64,Default,,0,0,0,,Ах
Dialogue: 0,0:23:41.64,0:23:44.13,Default,,0,0,0,,Юу-ау?
Dialogue: 0,0:23:44.13,0:23:46.16,Default,,0,0,0,,Мен жүлде емеспін
Dialogue: 0,0:23:46.16,0:23:48.45,Default,,0,0,0,,Цумики-сан Ими-санды тоқтатуға ниетті.
Dialogue: 0,0:23:48.45,0:23:51.30,Default,,0,0,0,,Жоқ, сіз жел үңгірін көздеп отырсыз ба?
Dialogue: 0,0:23:51.30,0:23:53.30,Default,,0,0,0,,Бір әріп басқа
Dialogue: 0,0:23:57.46,0:24:01.76,Default,,0,0,0,,Ол құламайды. Құлап кете ме деп ойлаймын.
Dialogue: 0,0:24:04.80,0:24:07.14,Default,,0,0,0,,Сакаки: Бір сәтке болады ма?
Dialogue: 0,0:24:07.14,0:24:09.47,Default,,0,0,0,,А? Сәйкестендіріңіз
Dialogue: 0,0:24:09.47,0:24:11.47,Default,,0,0,0,,Жарайды
Dialogue: 0,0:24:17.36,0:24:19.46,Default,,0,0,0,,Жер бетінде не бар?
Dialogue: 0,0:24:38.73,0:24:40.64,Default,,0,0,0,,Не?
Dialogue: 0,0:24:40.64,0:24:44.81,Default,,0,0,0,,Мұндай әрекетті ынтымақтастық арқылы жасауға болады. Рахмет, Сакаки.
Dialogue: 0,0:24:44.81,0:24:46.81,Default,,0,0,0,,О
Dialogue: 0,0:24:49.98,0:24:52.13,Default,,0,0,0,,Иә Цумики
Dialogue: 0,0:24:52.13,0:24:54.13,Default,,0,0,0,,Мукю~
Dialogue: 0,0:24:54.13,0:24:56.47,Default,,0,0,0,,Жарайды ма? О
Dialogue: 0,0:24:56.47,0:24:58.99,Default,,0,0,0,,Менің қалағаным тұлып емес еді.
Dialogue: 0,0:24:58.99,0:25:03.14,Default,,0,0,0,,Сені бақытты ететін Цумики, сондықтан бақыттысың деп үміттенемін.
Dialogue: 0,0:25:03.14,0:25:05.48,Default,,0,0,0,,≪(ханшайым/Цумики) Буха Ах!
Dialogue: 0,0:25:05.48,0:25:08.80,Default,,0,0,0,,Критикалық соққының дыбысын естідің.
Dialogue: 0,0:25:08.80,0:25:11.47,Default,,0,0,0,,Хмм, сіз сәтті түсірілдіңіз.
Dialogue: 0,0:25:11.47,0:25:13.57,Default,,0,0,0,,Химекчи соққыға жығылды.
Dialogue: 0,0:25:22.54,0:25:25.63,Default,,0,0,0,,Цумики-сан өте бақытты көрінеді.
Dialogue: 0,0:25:25.63,0:25:27.97,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:25:27.97,0:25:30.47,Default,,0,0,0,,Бірақ иә?
Dialogue: 0,0:25:30.47,0:25:34.82,Default,,0,0,0,,Бұл жанасу... Қызық, ханшайымға да ұнай ма?
Dialogue: 0,0:25:34.82,0:25:36.82,Default,,0,0,0,,Шимафу
Dialogue: 0,0:25:37.88,0:25:39.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:39.79,0:25:43.46,Default,,0,0,0,,Бұл Мофугю~
Dialogue: 0,0:25:43.46,0:25:46.06,Default,,0,0,0,,Екеуің не істеп жатырсыңдар?
Dialogue: 0,0:25:49.14,0:25:51.44,Default,,0,0,0,,≪(Цумики ханшайымы) Мофугю~
Dialogue: 0,0:25:52.47,0:26:23.47,Default,,0,0,0,,♪♪～
Dialogue: 0,0:28:57.14,0:28:59.14,Default,,0,0,0,,Мияу
Dialogue: 0,0:28:59.14,0:29:03.20,Default,,0,0,0,,Тенти Игоның басында мысық бар.
Dialogue: 0,0:29:03.20,0:29:05.13,Default,,0,0,0,,Өтінемін, бүгін мені тастап кетпе.
Dialogue: 0,0:29:05.13,0:29:07.73,Default,,0,0,0,,Нянко сүйкімді
Dialogue: 0,0:29:10.14,0:29:12.44,Default,,0,0,0,,Не болды? Цумики-чан
Dialogue: 0,0:29:13.94,0:29:19.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
