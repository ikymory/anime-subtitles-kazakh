Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.97,0:00:11.81,Default,,0,0,0,,⚟(Сакаки) Жаңа жыл құтты болсын~
Dialogue: 0,0:00:11.81,0:00:14.48,Default,,0,0,0,,Жаңа жыл құтты болсын
Dialogue: 0,0:00:14.48,0:00:17.48,Default,,0,0,0,,Жаңа жыл құтты болсын ~ Жаңа жыл құтты болсын
Dialogue: 0,0:00:17.48,0:00:19.48,Default,,0,0,0,,Ня Ими-сан ше?
Dialogue: 0,0:00:19.48,0:00:21.48,Default,,0,0,0,,Ол әлі келген жоқ.
Dialogue: 0,0:00:21.48,0:00:24.49,Default,,0,0,0,,Ими-кун, сенің кешігіп қалуың сирек.
Dialogue: 0,0:00:24.49,0:00:26.99,Default,,0,0,0,,Иә, Сакаки-сан.
Dialogue: 0,0:00:26.99,0:00:30.49,Default,,0,0,0,,Ими-санға айттың ғой, солай ма? (Сакаки) Хмм.
Dialogue: 0,0:00:31.66,0:00:34.50,Default,,0,0,0,,Маған айтпа! (Химе Майои) Ех!
Dialogue: 0,0:00:34.50,0:00:39.00,Default,,0,0,0,,Жаңа жыл кеші Ойынға батып кеттім.
Dialogue: 0,0:00:39.00,0:00:41.00,Default,,0,0,0,,Иә... кешіріңіз.
Dialogue: 0,0:00:41.00,0:00:43.01,Default,,0,0,0,,Мен бәрібір қоңырау шалып көремін.
Dialogue: 0,0:00:43.01,0:02:11.33,Default,,0,0,0,,♬～
Dialogue: 0,0:02:23.64,0:02:30.48,Default,,0,0,0,,(Қоңырау шалу)
Dialogue: 0,0:02:30.48,0:02:33.48,Default,,0,0,0,,Осындай уақытта жақсы ма?
Dialogue: 0,0:02:33.48,0:02:35.98,Default,,0,0,0,,О, Ими? Сіз ояусыз ба?
Dialogue: 0,0:02:35.98,0:02:38.99,Default,,0,0,0,,Қазір бәріміз есік алдындамыз.
Dialogue: 0,0:02:41.99,0:02:44.83,Default,,0,0,0,,Менің ұйқым келіп тұр
Dialogue: 0,0:02:44.83,0:02:46.83,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:02:46.83,0:02:49.33,Default,,0,0,0,,Жаңа жыл құтты болсын
Dialogue: 0,0:02:49.33,0:02:52.33,Default,,0,0,0,,<Бірінші рет ояну>
Dialogue: 0,0:02:52.33,0:02:54.34,Default,,0,0,0,,Ими мырза Имми мырза
Dialogue: 0,0:02:54.34,0:02:58.67,Default,,0,0,0,,Егер менімен бірге келсең, сенің бетінен тістеп алуым мүмкін.
Dialogue: 0,0:02:58.67,0:03:02.44,Default,,0,0,0,,Маған Майои-сан керек емес.
Dialogue: 0,0:03:02.44,0:03:06.55,Default,,0,0,0,,Бұл реакцияның сізге зиян тигізуіне жол бермеңіз. Саған керек емес деп ойлаймын.
Dialogue: 0,0:03:10.12,0:03:12.29,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:03:12.29,0:03:14.96,Default,,0,0,0,,Химекки, қалғанын саған қалдырдым.
Dialogue: 0,0:03:14.96,0:03:16.96,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:03:16.96,0:03:20.96,Default,,0,0,0,,Химеккидің шақыруы бойынша Игоны сыртқа шығарыңыз.
Dialogue: 0,0:03:20.96,0:03:23.47,Default,,0,0,0,,Мм...➡
Dialogue: 0,0:03:23.47,0:03:27.97,Default,,0,0,0,,Мм, жақсы... бұл жаңа жыл күні.
Dialogue: 0,0:03:37.48,0:03:40.82,Default,,0,0,0,,Жаңа жылыңызбен~ Мен киімімді ауыстырып жатырмын.
Dialogue: 0,0:03:40.82,0:03:43.99,Default,,0,0,0,,Ол есік алдында емес пе еді?
Dialogue: 0,0:03:43.99,0:03:47.49,Default,,0,0,0,,Мен бөлмеме қайта кіріп, киімімді ауыстырдым.
Dialogue: 0,0:03:47.49,0:03:51.49,Default,,0,0,0,,Мен есікке дейін ұятсыз сөздер айттым.
Dialogue: 0,0:03:53.50,0:03:56.50,Default,,0,0,0,,Суық және ұйқышыл
Dialogue: 0,0:03:56.50,0:03:59.00,Default,,0,0,0,,Ими, жақсысың ба?
Dialogue: 0,0:03:59.00,0:04:02.94,Default,,0,0,0,,Менің басым айналады. Иноми оянғанда осылай көрінеді.
Dialogue: 0,0:04:02.94,0:04:05.94,Default,,0,0,0,,Сізге ұнайды
Dialogue: 0,0:04:05.94,0:04:10.55,Default,,0,0,0,,Фумофумо Цумики оны ұстап тұр
Dialogue: 0,0:04:19.96,0:04:23.96,Default,,0,0,0,,Ими мырза, мен өзімді жартылай ұйықтап жатқандай сезінемін.
Dialogue: 0,0:04:23.96,0:04:26.96,Default,,0,0,0,,Жоқ, бәрібір әдеттегідей.
Dialogue: 0,0:04:26.96,0:04:28.96,Default,,0,0,0,,Жылулық
Dialogue: 0,0:04:31.13,0:04:34.64,Default,,0,0,0,,⚟(ханшайым) Әлі де көп адам бар.
Dialogue: 0,0:04:34.64,0:04:37.31,Default,,0,0,0,,Бұл Жаңа жыл күні ғой.
Dialogue: 0,0:04:37.31,0:04:40.48,Default,,0,0,0,,Бəрің ажыраспаңдар хахи
Dialogue: 0,0:04:40.48,0:04:44.31,Default,,0,0,0,,Екеуміз ажырассақ та жарайды, өйткені менде ұялы телефон бар.
Dialogue: 0,0:04:44.31,0:04:46.98,Default,,0,0,0,,Мен ұялы телефонымды ұмытып қалдым
Dialogue: 0,0:04:46.98,0:04:50.99,Default,,0,0,0,,Иго Ониваны өзімен бірге алып жүр, сондықтан ешқандай проблема жоқ.
Dialogue: 0,0:04:50.99,0:04:54.32,Default,,0,0,0,,Бұл тасымалдана ма?
Dialogue: 0,0:04:54.32,0:04:57.33,Default,,0,0,0,,Хмм, ояусың ба?
Dialogue: 0,0:04:59.93,0:05:03.43,Default,,0,0,0,,Мен көп адамдарды жек көремін
Dialogue: 0,0:05:07.77,0:05:10.57,Default,,0,0,0,,Екеуміз ажыраспау үшін қол ұстасуымыз керек пе?
Dialogue: 0,0:05:12.44,0:05:15.44,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:05:15.44,0:05:18.95,Default,,0,0,0,,Бұл жақсы, мен түсінемін.
Dialogue: 0,0:05:18.95,0:05:21.12,Default,,0,0,0,,Олай болса барамыз ба?
Dialogue: 0,0:05:21.12,0:05:23.52,Default,,0,0,0,,Иә
Dialogue: 0,0:05:28.29,0:05:32.59,Default,,0,0,0,,Химечидің тілегі орындалсын
Dialogue: 0,0:05:33.96,0:05:38.97,Default,,0,0,0,,Цумикидің тілегі орындалады деп сенемін.
Dialogue: 0,0:05:41.47,0:05:46.47,Default,,0,0,0,,Мен... Тілегіңіз орындалады деп сенемін.
Dialogue: 0,0:05:49.31,0:05:52.65,Default,,0,0,0,,Сақакидің тілегі орындалады
Dialogue: 0,0:05:52.65,0:05:56.65,Default,,0,0,0,,Майойдың тілегі... Енді басқаша болды ма?
Dialogue: 0,0:05:58.82,0:06:01.42,Default,,0,0,0,,⚟(ханшайым) Тұмар сатамын.
Dialogue: 0,0:06:01.42,0:06:03.43,Default,,0,0,0,,Мұнда әртүрлі нәрселер бар.
Dialogue: 0,0:06:03.43,0:06:06.76,Default,,0,0,0,,⚟(Майои) Тұмардың бірнеше түрі бар.
Dialogue: 0,0:06:06.76,0:06:09.10,Default,,0,0,0,,Біздің ұрпақ емтиханды тапсыру үшін дұға етеді.
Dialogue: 0,0:06:09.10,0:06:12.10,Default,,0,0,0,,Қызық, бұл махаббаттың орындалуы ма?
Dialogue: 0,0:06:12.10,0:06:15.60,Default,,0,0,0,,Мен кішкентай кезімде махаббат орындалды деп ойладым.
Dialogue: 0,0:06:15.60,0:06:18.27,Default,,0,0,0,,Мен сені ғашық деп ойладым.
Dialogue: 0,0:06:18.27,0:06:22.11,Default,,0,0,0,,Хохо Ғашық болған адамды баурап алған кезде
Dialogue: 0,0:06:22.11,0:06:24.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:24.11,0:06:27.62,Default,,0,0,0,,Жаман қыз болғың келген шығар, жаман қыз.
Dialogue: 0,0:06:27.62,0:06:31.95,Default,,0,0,0,,Жоқ, жоқ, бұл неге?
Dialogue: 0,0:06:31.95,0:06:35.96,Default,,0,0,0,,Бірақ бала кезіңізде сізде осындай түсінбеушілік болады.
Dialogue: 0,0:06:35.96,0:06:39.46,Default,,0,0,0,,Мүмкін солай шығар. Ими мырза да сонда ма?
Dialogue: 0,0:06:39.46,0:06:43.30,Default,,0,0,0,,Мен бұл туралы ойланбаймын, бірақ бұл мүмкін деп ойлаймын.
Dialogue: 0,0:06:43.30,0:06:48.64,Default,,0,0,0,,Бала кезімде мен де махаббатта табысқа жету идеясын дұрыс түсінбедім.
Dialogue: 0,0:06:48.64,0:06:51.04,Default,,0,0,0,,Қалай?
Dialogue: 0,0:06:52.97,0:06:54.98,Default,,0,0,0,,Инди?
Dialogue: 0,0:06:54.98,0:06:57.58,Default,,0,0,0,,Менің жасырын сезімдерім ашылғалы тұр
Dialogue: 0,0:06:59.81,0:07:02.58,Default,,0,0,0,,Хмм, сіз оны сатып алғыңыз келе ме?
Dialogue: 0,0:07:02.58,0:07:07.92,Default,,0,0,0,,О, мен сауда ауданындағы лотереяға сәттілікті толықтыруды ойладым.
Dialogue: 0,0:07:07.92,0:07:11.93,Default,,0,0,0,,Енді сіз биылғы лотереяда керемет сыйлықтар ұтып ала аласыз.
Dialogue: 0,0:07:11.93,0:07:16.43,Default,,0,0,0,,Бақыт жинаған ақшаңызды жаңа жылдың басында пайдаланбаңыз.
Dialogue: 0,0:07:16.43,0:07:19.77,Default,,0,0,0,,Менің жолым лотерея сияқты кетпейді.
Dialogue: 0,0:07:19.77,0:07:22.77,Default,,0,0,0,,Ал, ол кеткенде
Dialogue: 0,0:07:22.77,0:07:25.77,Default,,0,0,0,,Жоқ, жоқ, жоқ...
Dialogue: 0,0:07:28.44,0:07:31.45,Default,,0,0,0,,Ах, Ими-кун мен Сакаки-сан келді.
Dialogue: 0,0:07:31.45,0:07:33.95,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз, күте тұрыңыз...
Dialogue: 0,0:07:36.95,0:07:39.62,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:07:39.62,0:07:41.96,Default,,0,0,0,,Екеуің де жақсысыңдар ма?
Dialogue: 0,0:07:41.96,0:07:45.63,Default,,0,0,0,,Сіз жарақат алдыңыз ба? Ittetete…
Dialogue: 0,0:07:45.63,0:07:50.03,Default,,0,0,0,,Әйтеуір, Майой жақсы...
Dialogue: 0,0:07:54.47,0:07:57.47,Default,,0,0,0,,Жоқ, бұл шайтанға көбірек ұқсайды.
Dialogue: 0,0:07:57.47,0:08:00.91,Default,,0,0,0,,Ешбір пайда болмайды деп ойлаймын.
Dialogue: 0,0:08:00.91,0:08:03.91,Default,,0,0,0,,Барлығың не айтып тұрсыңдар? ?
Dialogue: 0,0:08:03.91,0:08:07.52,Default,,0,0,0,,Бұл не? Хахахаха
Dialogue: 0,0:08:09.75,0:08:12.42,Default,,0,0,0,,Аспан ағара бастады.
Dialogue: 0,0:08:12.42,0:08:16.42,Default,,0,0,0,,Дұрыс (Сакаки) Меніңше, күн шығуға жақын.
Dialogue: 0,0:08:16.42,0:08:18.93,Default,,0,0,0,,Аа, шықты.
Dialogue: 0,0:08:18.93,0:08:22.43,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:08:22.43,0:08:24.43,Default,,0,0,0,,Осылайша
Dialogue: 0,0:08:24.43,0:08:28.44,Default,,0,0,0,,Сіз бұл жарқырауды жақыннан көргіңіз келеді.
Dialogue: 0,0:08:28.44,0:08:30.94,Default,,0,0,0,,Шаңға айналады
Dialogue: 0,0:08:32.94,0:08:35.94,Default,,0,0,0,,Әдемі ⚟(Майои) Барлығымыз оны еске алайық➡
Dialogue: 0,0:08:35.94,0:08:39.28,Default,,0,0,0,,Фото туралы не айтасыз? ⚟(Сакаки) О, жақсы
Dialogue: 0,0:08:39.28,0:08:42.95,Default,,0,0,0,,Таймерді орнату
Dialogue: 0,0:08:42.95,0:08:47.12,Default,,0,0,0,,(таймер дыбысы)
Dialogue: 0,0:08:47.12,0:08:49.62,Default,,0,0,0,,Ах~
Dialogue: 0,0:08:50.96,0:08:55.26,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар? ⚟(ханшайым) Хаха...
Dialogue: 0,0:08:57.97,0:09:01.74,Default,,0,0,0,,⚟(Барлығы) Жаңа жыл құтты болсын
Dialogue: 0,0:09:01.74,0:09:05.24,Default,,0,0,0,,Құттықтаймыз, өтінемін
Dialogue: 0,0:09:05.24,0:09:07.58,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:09:07.58,0:09:10.91,Default,,0,0,0,,Сәлем, құттықтаймын.
Dialogue: 0,0:09:10.91,0:09:15.25,Default,,0,0,0,,Мм, бүгін бәрі фуризод киіп жүр.
Dialogue: 0,0:09:15.25,0:09:17.25,Default,,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,0:09:18.59,0:09:20.92,Default,,0,0,0,,Маған әдеттегіден өзгеше мені көрсет
Dialogue: 0,0:09:20.92,0:09:24.59,Default,,0,0,0,,Баланың айтқысы келетін сөздер бар.
Dialogue: 0,0:09:24.59,0:09:27.43,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:27.43,0:09:29.93,Default,,0,0,0,,Бетіңіз күліп тұр.
Dialogue: 0,0:09:29.93,0:09:32.60,Default,,0,0,0,,Бетіңіз күліп тұр.
Dialogue: 0,0:09:32.60,0:09:36.00,Default,,0,0,0,,Габон! Мен қалаған сөзден бір әріп басқа!
Dialogue: 0,0:09:38.44,0:09:42.44,Default,,0,0,0,,⚟Бәріңізде осы жылға арналған шешімдеріңіз бар ма?
Dialogue: 0,0:09:42.44,0:09:44.95,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:44.95,0:09:47.45,Default,,0,0,0,,Адамдарға мейірімді бол
Dialogue: 0,0:09:47.45,0:09:50.95,Default,,0,0,0,,Менің ойымша, сен Ими-санға мейірімді болма.
Dialogue: 0,0:09:50.95,0:09:53.46,Default,,0,0,0,,Бірдеңе болды ма, мұғалім?
Dialogue: 0,0:09:53.46,0:09:57.96,Default,,0,0,0,,Кику бұрын жігітті қалайтынын айтты, солай ма?
Dialogue: 0,0:09:59.13,0:10:01.96,Default,,0,0,0,,Мен олай айтқан жоқпын.
Dialogue: 0,0:10:01.96,0:10:05.80,Default,,0,0,0,,Менде қарама-қарсы жыныстағы жақын адам болса екен деп тілеймін.
Dialogue: 0,0:10:05.80,0:10:08.80,Default,,0,0,0,,Миико!
Dialogue: 0,0:10:08.80,0:10:13.01,Default,,0,0,0,,Жақын десең де...
Dialogue: 0,0:10:13.98,0:10:16.08,Default,,0,0,0,,Йоки
Dialogue: 0,0:10:18.48,0:10:22.32,Default,,0,0,0,,Цумикидің ұмтылысы бар ма? ұмтылыстар
Dialogue: 0,0:10:22.32,0:10:24.99,Default,,0,0,0,,Армандар…
Dialogue: 0,0:10:24.99,0:10:26.99,Default,,0,0,0,,<Мен ол сияқтымын...>
Dialogue: 0,0:10:30.49,0:10:33.50,Default,,0,0,0,,Бет қолында~ Әй
Dialogue: 0,0:10:33.50,0:10:36.66,Default,,0,0,0,,Сакаки-сан, арманың бар ма?
Dialogue: 0,0:10:36.66,0:10:40.50,Default,,0,0,0,,Хмм, мінекей.
Dialogue: 0,0:10:40.50,0:10:42.50,Default,,0,0,0,,Хехехе
Dialogue: 0,0:10:42.50,0:10:47.51,Default,,0,0,0,,Осы жылы Иноми сіздің желкеңізді жақсы көреді деп үміттенемін!
Dialogue: 0,0:10:47.51,0:10:50.01,Default,,0,0,0,,Мен биылғы жылды өткіземін
Dialogue: 0,0:10:50.01,0:10:52.01,Default,,0,0,0,,Нап Иә~
Dialogue: 0,0:10:52.01,0:10:54.68,Default,,0,0,0,,Неліктен желкеңе мұнша мұңаясың?
Dialogue: 0,0:10:54.68,0:10:59.02,Default,,0,0,0,,Жақсы, мысалы, дәмді тағам тапсаңыз➡
Dialogue: 0,0:10:59.02,0:11:02.96,Default,,0,0,0,,Барлығына айтып, сол бақытпен бөліскіңіз келеді➡
Dialogue: 0,0:11:02.96,0:11:07.96,Default,,0,0,0,,Сол сияқты мен де Иномидің Жапонияның сұлулығы туралы білгенін қаладым.
Dialogue: 0,0:11:07.96,0:11:10.47,Default,,0,0,0,,Бұл жақсы әңгіме.
Dialogue: 0,0:11:10.47,0:11:12.47,Default,,0,0,0,,Ханшайым...
Dialogue: 0,0:11:12.47,0:11:14.47,Default,,0,0,0,,Сакаки…
Dialogue: 0,0:11:14.47,0:11:16.97,Default,,0,0,0,,Түсіндіңіз бе, Ими➡
Dialogue: 0,0:11:16.97,0:11:19.47,Default,,0,0,0,,Мойынның желке бөлігі
Dialogue: 0,0:11:19.47,0:11:21.98,Default,,0,0,0,,О, менде ештеңе жоқ.
Dialogue: 0,0:11:21.98,0:11:24.48,Default,,0,0,0,,Мені ұнатпасаң ашуланбайсың ба, Конояро?
Dialogue: 0,0:11:24.48,0:11:26.48,Default,,0,0,0,,Бір ақымақ бар
Dialogue: 0,0:11:28.65,0:11:32.99,Default,,0,0,0,,Жаңа жылды бәріміз бірге тамашалайық.
Dialogue: 0,0:11:32.99,0:11:36.49,Default,,0,0,0,,Жақсы, сонда Карута ше?
Dialogue: 0,0:11:36.49,0:11:38.99,Default,,0,0,0,,Әй, жақсы.
Dialogue: 0,0:11:38.99,0:11:41.50,Default,,0,0,0,,Ал, дайындалайық.
Dialogue: 0,0:11:43.50,0:11:47.00,Default,,0,0,0,,Олай болса, бастайық. (Барлығы) Иә.
Dialogue: 0,0:11:49.50,0:11:51.51,Default,,0,0,0,,Иә, ә
Dialogue: 0,0:11:51.51,0:11:53.51,Default,,0,0,0,,Кешіріңіз, Ино...
Dialogue: 0,0:11:53.51,0:11:55.51,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:11:55.51,0:11:59.51,Default,,0,0,0,,Цумики-санда (екеумізде де) қорқынышты нәрсе бар. Бұл рас.
Dialogue: 0,0:11:59.51,0:12:02.95,Default,,0,0,0,,Мен ары қарай оқимын.
Dialogue: 0,0:12:02.95,0:12:05.62,Default,,0,0,0,,<Игоның қолы>
Dialogue: 0,0:12:05.62,0:12:07.62,Default,,0,0,0,,<Мен де...>
Dialogue: 0,0:12:07.62,0:12:10.63,Default,,0,0,0,,⚟Жынға... Әй, бұл дұрыс емес.
Dialogue: 0,0:12:10.63,0:12:14.33,Default,,0,0,0,,Иә? Цумики?
Dialogue: 0,0:12:20.97,0:12:24.07,Default,,0,0,0,,Гякугире? Жоқ, керісінше емес
Dialogue: 0,0:12:26.31,0:12:28.31,Default,,0,0,0,,⚟(ханшайым) Уау~
Dialogue: 0,0:12:28.31,0:12:31.48,Default,,0,0,0,,Мен жыл аяғындағы тазалау кезінде құмыра мен ерітінді таптым.
Dialogue: 0,0:12:31.48,0:12:34.98,Default,,0,0,0,,Бәріміз бірге көрейік. Мен мұны істегім келеді.
Dialogue: 0,0:12:34.98,0:12:38.49,Default,,0,0,0,,Мен бірінші жасап көрейін, жарай ма?
Dialogue: 0,0:12:38.49,0:12:42.66,Default,,0,0,0,,Онда сіздің серіктесіңіз Цумики жекпе-жегі болуы керек.
Dialogue: 0,0:12:42.66,0:12:47.66,Default,,0,0,0,,О, бұл екеуінің биылғы алғашқы ынтымақтастығы.
Dialogue: 0,0:12:47.66,0:12:50.83,Default,,0,0,0,,Бұл торт емес, бұл мочи кірісі.
Dialogue: 0,0:12:50.83,0:12:52.83,Default,,0,0,0,,Мочи ириучи?
Dialogue: 0,0:13:04.95,0:13:07.45,Default,,0,0,0,,Цумики тегістелген
Dialogue: 0,0:13:07.45,0:13:10.45,Default,,0,0,0,,Аа, бақ сондай тегіс.
Dialogue: 0,0:13:10.45,0:13:14.56,Default,,0,0,0,,Цумики жазық
Dialogue: 0,0:13:16.29,0:13:20.60,Default,,0,0,0,,Цумики-сан жазық, Онива жазық!
Dialogue: 0,0:13:26.97,0:13:29.97,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:13:34.48,0:13:39.48,Default,,0,0,0,,Барлығы, біз зони жасадық!
Dialogue: 0,0:13:39.48,0:13:41.98,Default,,0,0,0,,⚟(Барлығы) Мен оны аламын.
Dialogue: 0,0:13:44.99,0:13:48.49,Default,,0,0,0,,Сүйіспеншілікпен ұрып-соққан мочи дәмді.
Dialogue: 0,0:13:48.49,0:13:50.99,Default,,0,0,0,,Мен сені ұрған жоқпын.
Dialogue: 0,0:13:50.99,0:13:54.16,Default,,0,0,0,,⚟Уфуфуфу Бұл күріш торты барлығына арналған.
Dialogue: 0,0:13:54.16,0:13:57.67,Default,,0,0,0,,Махаббат хрусталы Махаббат хрусталы ма?
Dialogue: 0,0:13:57.67,0:13:59.67,Default,,0,0,0,,Бұл махаббат па?
Dialogue: 0,0:13:59.67,0:14:01.60,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:01.60,0:14:05.61,Default,,0,0,0,,Біз қазір махаббатқа жем болып жатырмыз.
Dialogue: 0,0:14:09.61,0:14:12.28,Default,,0,0,0,,Цумики Иә?
Dialogue: 0,0:14:12.28,0:14:14.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:14.95,0:14:16.95,Default,,0,0,0,,Мияу Мияу
Dialogue: 0,0:14:18.45,0:14:21.29,Default,,0,0,0,,Ноби~
Dialogue: 0,0:14:21.29,0:14:24.96,Default,,0,0,0,,Ими-кун, тамағыңмен ойнама.
Dialogue: 0,0:14:24.96,0:14:27.46,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:27.46,0:14:31.13,Default,,0,0,0,,Бұл аңызға айналған мокчи ойыны.
Dialogue: 0,0:14:31.13,0:14:34.80,Default,,0,0,0,,Егер сәтті болса, ол мокчи киссіне айналады➡
Dialogue: 0,0:14:34.80,0:14:36.97,Default,,0,0,0,,Мына жігіт жынды екен
Dialogue: 0,0:14:36.97,0:14:38.97,Default,,0,0,0,,А, бұл қауіпті.
Dialogue: 0,0:14:38.97,0:14:41.98,Default,,0,0,0,,Биыл да қызық жыл болатын сияқты.
Dialogue: 0,0:14:41.98,0:14:44.15,Default,,0,0,0,,Тек таңдаулы бірнешеуге ғана тән делінген күш—
Dialogue: 0,0:14:44.15,0:14:48.15,Default,,0,0,0,,ОЖ ОЖ ОЖ тартыңыз!
Dialogue: 0,0:15:03.43,0:15:05.93,Default,,0,0,0,,Қайырлы таң~ (Ими Цумики) Қайырлы таң
Dialogue: 0,0:15:05.93,0:15:07.94,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:15:07.94,0:15:11.44,Default,,0,0,0,,Бүгін таңертең мектеп жабылатын көрінеді.
Dialogue: 0,0:15:11.44,0:15:13.44,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:15:13.44,0:15:16.94,Default,,0,0,0,,Тұмау тараған.
Dialogue: 0,0:15:16.94,0:15:20.95,Default,,0,0,0,,Менің сабақтарымның да жартысынан көбі қатыспайды. ⚟(ханшайым)
Dialogue: 0,0:15:20.95,0:15:23.95,Default,,0,0,0,,Қайырлы таң (ханшайым) Қайырлы таң.
Dialogue: 0,0:15:23.95,0:15:26.45,Default,,0,0,0,,Қайырлы таң (Киотани) Усу!
Dialogue: 0,0:15:26.45,0:15:28.79,Default,,0,0,0,,Соңғы кездері қатты суық болды.
Dialogue: 0,0:15:28.79,0:15:31.46,Default,,0,0,0,,Суық деп айтсаң да, суық болуы керек.
Dialogue: 0,0:15:31.46,0:15:33.46,Default,,0,0,0,,Сіз мұны көп айтасыз.
Dialogue: 0,0:15:33.46,0:15:37.47,Default,,0,0,0,,Ыстық болғаны оның жылы екенін білдірмейді.
Dialogue: 0,0:15:37.47,0:15:40.47,Default,,0,0,0,,Жоқ, ойлансаң өзгерерсің, мен сенімдімін
Dialogue: 0,0:15:40.47,0:15:42.80,Default,,0,0,0,,Ойланып қарасам өзгере ме?
Dialogue: 0,0:15:42.80,0:15:45.14,Default,,0,0,0,,Ойланып қарасаңыз...
Dialogue: 0,0:15:45.14,0:15:47.64,Default,,0,0,0,,Сіз бұл туралы жай ғана ойлай алмайсыз, солай ма?
Dialogue: 0,0:15:47.64,0:15:50.65,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:50.65,0:15:52.98,Default,,0,0,0,,О, сүйкімді түшкіру
Dialogue: 0,0:15:52.98,0:15:55.78,Default,,0,0,0,,Хэхе... Эй, Мэйо-чан да?
Dialogue: 0,0:15:58.49,0:16:00.42,Default,,0,0,0,,Сәлем
Dialogue: 0,0:16:00.42,0:16:02.42,Default,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,0:16:02.42,0:16:04.93,Default,,0,0,0,,Себебі ол жарты жолда тоқтады.
Dialogue: 0,0:16:04.93,0:16:09.43,Default,,0,0,0,,Қандай жағдай болмасын, суық тиюден сақ болайық.
Dialogue: 0,0:16:09.43,0:16:11.43,Default,,0,0,0,,Иә
Dialogue: 0,0:16:11.43,0:16:14.44,Default,,0,0,0,,Бұл жерде барлығына бірдей.
Dialogue: 0,0:16:14.44,0:16:16.94,Default,,0,0,0,,Онива-сан суық тиіп қалса, Отонаши-кун.
Dialogue: 0,0:16:16.94,0:16:19.94,Default,,0,0,0,,«Маған суық тигізіңіз» деген сияқты естіледі.
Dialogue: 0,0:16:19.94,0:16:24.45,Default,,0,0,0,,Ими-санның жолдары мырзалық пен агрессивті болар еді.
Dialogue: 0,0:16:24.45,0:16:26.95,Default,,0,0,0,,Мен сені көруге бардым...
Dialogue: 0,0:16:30.45,0:16:32.45,Default,,0,0,0,,Цумикидің суық тиюі
Dialogue: 0,0:16:32.45,0:16:34.96,Default,,0,0,0,,Мен оны ұрлауға келдім.
Dialogue: 0,0:16:36.62,0:16:39.63,Default,,0,0,0,,немесе бір нәрсе ме? (Киотани Саки) Бұл сызық тым қарқынды
Dialogue: 0,0:16:44.47,0:16:47.64,Default,,0,0,0,,Ой, бұл маса екен.
Dialogue: 0,0:16:47.64,0:16:51.64,Default,,0,0,0,,Осы суықта әлі осындасың ба?
Dialogue: 0,0:16:51.64,0:16:55.14,Default,,0,0,0,,Сіз қысты кампуста өткізуді жоспарлап отырсыз ба?
Dialogue: 0,0:16:55.14,0:16:58.31,Default,,0,0,0,,Жазда көрген сайын панорамалаймын.
Dialogue: 0,0:16:58.31,0:17:01.32,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:04.42,0:17:09.09,Default,,0,0,0,,Бұл жазда ұйқысы бұзылғандардың барлығына, соның ішінде маған да.
Dialogue: 0,0:17:09.09,0:17:11.09,Default,,0,0,0,,Бұл мен туралы.
Dialogue: 0,0:17:11.09,0:17:15.00,Default,,0,0,0,,Ими мырза, сіз кенеттен не істеп жатырсыз?
Dialogue: 0,0:17:16.93,0:17:19.93,Default,,0,0,0,,Дүниенің қышынуын түзету
Dialogue: 0,0:17:19.93,0:17:21.94,Default,,0,0,0,,Керемет пе?
Dialogue: 0,0:17:21.94,0:17:25.44,Default,,0,0,0,,Олар менің ұйқымды қанша рет бұзды?
Dialogue: 0,0:17:25.44,0:17:29.94,Default,,0,0,0,,Жарықты сөндіргенде пайда болып, оны қосқанда қашып кетеді.
Dialogue: 0,0:17:29.94,0:17:33.45,Default,,0,0,0,,Екеуіңнің құлағың жарылып кетті.
Dialogue: 0,0:17:33.45,0:17:35.95,Default,,0,0,0,,Бірақ дәл көз алдымда оқ тиді...
Dialogue: 0,0:17:37.62,0:17:40.12,Default,,0,0,0,,Тоқта! Дәл қазір
Dialogue: 0,0:17:40.12,0:17:42.46,Default,,0,0,0,,Айтайын дегенім, қалай болжауға болады?
Dialogue: 0,0:17:42.46,0:17:45.96,Default,,0,0,0,,Хмм, бірақ мен сені осындай қиыншылықта көргенде,
Dialogue: 0,0:17:45.96,0:17:48.96,Default,,0,0,0,,Сіз қандай да бір жолмен бар күшіңізді салу керек деп ойламайсыз ба?
Dialogue: 0,0:17:48.96,0:17:52.97,Default,,0,0,0,,Осыны айтқанда, сіз онымен айналысқыңыз келуі мүмкін.
Dialogue: 0,0:17:55.97,0:17:57.97,Default,,0,0,0,,Бірге өмір сүру туралы не деуге болады?
Dialogue: 0,0:17:57.97,0:18:00.47,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:18:07.92,0:18:09.92,Default,,0,0,0,,Миниван жылы~
Dialogue: 0,0:18:09.92,0:18:12.42,Default,,0,0,0,,Жылы.
Dialogue: 0,0:18:12.42,0:18:14.76,Default,,0,0,0,,Екеуміз де жылымыз.
Dialogue: 0,0:18:14.76,0:18:17.43,Default,,0,0,0,,Сіздің де жүрегіңіз жылы болды ма?
Dialogue: 0,0:18:17.43,0:18:22.43,Default,,0,0,0,,Қолы жылы адамдардың да жүрегі жылы болатыны рас сияқты.
Dialogue: 0,0:18:22.43,0:18:25.93,Default,,0,0,0,,Сонда бәрі жылы ма?
Dialogue: 0,0:18:25.93,0:18:27.94,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:18:29.44,0:18:31.94,Default,,0,0,0,,Бұл жерде ұят нәрсе бар.
Dialogue: 0,0:18:31.94,0:18:34.44,Default,,0,0,0,,Бұл екеуі шынымен де
Dialogue: 0,0:18:36.94,0:18:40.45,Default,,0,0,0,,Түскі асты ішкеннен кейін барлығы үйлеріне қайтады ма?
Dialogue: 0,0:18:40.45,0:18:44.45,Default,,0,0,0,,Менің айтқым келгені осы еді. Менде түскі ас қорабы бар.
Dialogue: 0,0:18:44.45,0:18:46.95,Default,,0,0,0,,Әйелдердің барлығында бенто жәшіктері бар.
Dialogue: 0,0:18:46.95,0:18:50.96,Default,,0,0,0,,Ими, не істеуіміз керек? Бұл бенто емес, солай ма?
Dialogue: 0,0:18:50.96,0:18:53.96,Default,,0,0,0,,Аа, нан сатып алсақ болмас па еді?
Dialogue: 0,0:18:53.96,0:18:56.46,Default,,0,0,0,,Тұмаудың әсерінен кеуіп жатқан шығар.
Dialogue: 0,0:18:56.46,0:18:59.90,Default,,0,0,0,,А, мен кәрі құстардың сайрағанына сенімдімін.
Dialogue: 0,0:18:59.90,0:19:01.90,Default,,0,0,0,,⚟(Майой) Ккеееееее
Dialogue: 0,0:19:03.07,0:19:05.91,Default,,0,0,0,,Тұтынушы бұл...
Dialogue: 0,0:19:05.91,0:19:07.91,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:19:07.91,0:19:10.91,Default,,0,0,0,,Бұл сатып алушы ханымның зары.
Dialogue: 0,0:19:10.91,0:19:14.58,Default,,0,0,0,,Онда мен автоматтан сусын сатып аламын.
Dialogue: 0,0:19:14.58,0:19:17.59,Default,,0,0,0,,Олай болса мен гүл теруге барайын.
Dialogue: 0,0:19:17.59,0:19:19.92,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:19:19.92,0:19:22.72,Default,,0,0,0,,А, біреу сусын алғысы келеді ме?
Dialogue: 0,0:19:31.43,0:19:33.93,Default,,0,0,0,,Үш ыстық улонг шайы
Dialogue: 0,0:19:33.93,0:19:36.44,Default,,0,0,0,,Бетінде сұрақ белгісі бар бір ғана адам бар.
Dialogue: 0,0:19:37.44,0:19:40.94,Default,,0,0,0,,Жарайды, Саки-ян, сен сұрадың. ⚟(Саки) Жарайды.
Dialogue: 0,0:19:40.94,0:19:44.55,Default,,0,0,0,,Кана да келші ⚟(Кана) Айса~
Dialogue: 0,0:19:46.95,0:19:51.95,Default,,0,0,0,,⚟(Сакаки) Аа, дұрыс, Ими, кешегі әңгімемізді не істеуіміз керек?
Dialogue: 0,0:19:51.95,0:19:53.95,Default,,0,0,0,,Мен олай істемеймін.
Dialogue: 0,0:19:53.95,0:19:55.96,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:55.96,0:19:59.96,Default,,0,0,0,,Сакаки мен оның ата-анасы Токиода тұрады, солай ма?
Dialogue: 0,0:19:59.96,0:20:02.46,Default,,0,0,0,,Мен саған олай қарай алмаймын.
Dialogue: 0,0:20:02.46,0:20:05.97,Default,,0,0,0,,Маған да, Миико-неге де мән бермейді.
Dialogue: 0,0:20:05.97,0:20:08.47,Default,,0,0,0,,(Кіріс ұялы телефон қоңырауы)
Dialogue: 0,0:20:08.47,0:20:10.47,Default,,0,0,0,,Себебі Миико әпкесі
Dialogue: 0,0:20:10.47,0:20:13.47,Default,,0,0,0,,Мені тыңдап жатыр! ? Қайдан! ?
Dialogue: 0,0:20:14.48,0:20:16.48,Default,,0,0,0,,Миико-сан, мені ұятқа қалдырма.
Dialogue: 0,0:20:16.48,0:20:20.15,Default,,0,0,0,,Жоқ, біз бұл туралы ғана айттық.
Dialogue: 0,0:20:20.15,0:20:22.98,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:22.98,0:20:28.99,Default,,0,0,0,,Ата-анам бос емес, үйге біраз уақыт келе алмайтын сияқты.
Dialogue: 0,0:20:28.99,0:20:31.99,Default,,0,0,0,,Олай болса, кешкі асты бірге ішейік.
Dialogue: 0,0:20:31.99,0:20:34.83,Default,,0,0,0,,Сакаки мен Миико мені шақырды.
Dialogue: 0,0:20:34.83,0:20:37.00,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:20:37.00,0:20:41.17,Default,,0,0,0,,Мен бір жағынан қуанамын, бірақ сонымен бірге ұялдым.
Dialogue: 0,0:20:41.17,0:20:43.50,Default,,0,0,0,,Қазір біртүрлі.
Dialogue: 0,0:20:43.50,0:20:46.51,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:20:53.01,0:20:55.35,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:55.35,0:20:59.35,Default,,0,0,0,,Бірақ Сакаки мен Мииконың да сезімі
Dialogue: 0,0:20:59.35,0:21:02.06,Default,,0,0,0,,Мүмкін түсінерсіз...
Dialogue: 0,0:21:03.12,0:21:05.13,Default,,0,0,0,,Мен де
Dialogue: 0,0:21:05.13,0:21:09.33,Default,,0,0,0,,Мен мұны істегім келеді деп ойлаймын.
Dialogue: 0,0:21:23.98,0:21:27.48,Default,,0,0,0,,Сізді күтуге мәжбүрлегенім үшін кешіріңіз. Дүкенге барайық.
Dialogue: 0,0:21:27.48,0:21:29.98,Default,,0,0,0,,О
Dialogue: 0,0:21:36.49,0:21:39.99,Default,,0,0,0,,<Не...бірдеңе>
Dialogue: 0,0:21:39.99,0:21:42.00,Default,,0,0,0,,<Мен... қазір>
Dialogue: 0,0:21:42.00,0:21:44.50,Default,,0,0,0,,<Нянка Нянка...>
Dialogue: 0,0:21:44.50,0:21:47.67,Default,,0,0,0,,<Нянка Нянка...>
Dialogue: 0,0:21:47.67,0:21:52.34,Default,,0,0,0,,Біз бүгін танымал мәзір өнімдерін сатып алатын сияқтымыз. Біз не жеуіміз керек?
Dialogue: 0,0:21:52.34,0:21:54.68,Default,,0,0,0,,Аа, не болды, Ино?
Dialogue: 0,0:21:54.68,0:21:57.68,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:21:57.68,0:22:00.28,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:22:00.28,0:22:04.95,Default,,0,0,0,,Бетіңіз қызарып кеткен. Сенімен бәрі жақсы ма? Тұмау?
Dialogue: 0,0:22:04.95,0:22:06.95,Default,,0,0,0,,Бұл тест
Dialogue: 0,0:22:06.95,0:22:09.96,Default,,0,0,0,,Сөзбен айтып жеткізу мүмкін емес...
Dialogue: 0,0:22:19.97,0:23:48.49,Default,,0,0,0,,♬～
Dialogue: 0,0:23:55.33,0:23:57.67,Default,,0,0,0,,Қош бол ұстаз
Dialogue: 0,0:23:57.67,0:24:00.27,Default,,0,0,0,,Қош бол
Dialogue: 0,0:24:00.27,0:24:03.77,Default,,0,0,0,,Иә, қош бол, үйге бара жатқанда абай бол.
Dialogue: 0,0:24:04.77,0:24:07.07,Default,,0,0,0,,Ол айналып өткеннен кейін әлсіз жақтарымнан шағын соққылар береді.
Dialogue: 0,0:24:09.94,0:24:12.45,Default,,0,0,0,,Енді мен тазалауым керек...
Dialogue: 0,0:24:12.45,0:24:14.95,Default,,0,0,0,,Мияу мияу
Dialogue: 0,0:24:14.95,0:24:16.95,Default,,0,0,0,,Мияудың күшеюі
Dialogue: 0,0:24:18.45,0:24:24.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
