Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.27,0:00:24.94,Default,,0,0,0,,U әлеміне қош келдіңіз
Dialogue: 0,0:00:41.54,0:00:44.92,Default,,0,0,0,,У – осы дүниенің ақыл-ойын басқаратын бес дана адам.
Dialogue: 0,0:00:45.00,0:00:48.84,Default,,0,0,0,,«Дауыстар» жасаған соңғы виртуалды әлем
Dialogue: 0,0:00:49.92,0:00:53.59,Default,,0,0,0,,Шоттар саны 5 миллиардтан асады және кеңеюін жалғастыруда.
Dialogue: 0,0:00:53.67,0:00:56.72,Default,,0,0,0,,Тарихтағы ең үлкен интернет кеңістігі
Dialogue: 0,0:00:56.93,0:00:57.93,Default,,0,0,0,,♪ Ләләлай лалалай
Dialogue: 0,0:00:58.01,0:00:59.93,Default,,0,0,0,,♪ Есімсіз сағым туралы ешкім білмейді
Dialogue: 0,0:01:00.01,0:01:01.77,Default,,0,0,0,,♪ Қашып бара жатыр
Dialogue: 0,0:01:01.85,0:01:04.85,Default,,0,0,0,,♪ Сол жарты айға қолыңды соз
Dialogue: 0,0:01:04.94,0:01:05.94,Default,,0,0,0,,♪ Ләләлай лалалай
Dialogue: 0,0:01:06.02,0:01:07.90,Default,,0,0,0,,♪ Мен сені білгім келеді, бірақ сөзбен айтып жеткізе алмаймын
Dialogue: 0,0:01:07.98,0:01:09.82,Default,,0,0,0,,♪ Қорқақ таң
Dialogue: 0,0:01:09.90,0:01:12.82,Default,,0,0,0,,♪ Қанша кездессем де
Dialogue: 0,0:01:12.90,0:01:15.57,Default,,0,0,0,,U қосымшасын іске қосайық
Dialogue: 0,0:01:16.91,0:01:20.45,Default,,0,0,0,,U-да барлығы демалуға, жиналуға және көңіл көтеруге болады.
Dialogue: 0,0:01:20.53,0:01:24.29,Default,,0,0,0,,Денені бөлісудің соңғы технологиясын қолданады
Dialogue: 0,0:01:28.13,0:01:29.17,Default,,0,0,0,,Ахаха
Dialogue: 0,0:01:29.25,0:01:31.34,Default,,0,0,0,,♪ Кіндік бауы үзілді.
Dialogue: 0,0:01:31.42,0:01:33.38,Default,,0,0,0,,♪ Оның кесілген сәті U тіліндегі альтер эго сияқты
Dialogue: 0,0:01:33.38,0:01:36.26,Default,,0,0,0,,U тіліндегі альтер эго сияқты ♪ Дүниемен байланысым үзілген сияқты
Dialogue: 0,0:01:35.26,0:01:36.26,Default,,0,0,0,,Сканерленген...
Dialogue: 0,0:01:36.26,0:01:37.43,Default,,0,0,0,,♪ Дүниемен байланысым үзілген сияқты
Dialogue: 0,0:01:37.51,0:01:39.85,Default,,0,0,0,,Автоматты құруды орындау ♪ Көзіңе шағылысқан көрініс мұңды күлімдесе
Dialogue: 0,0:01:39.85,0:01:41.39,Default,,0,0,0,,♪ Көзіңе шағылысқан көрініс мұңды күлімдесе
Dialogue: 0,0:01:41.47,0:01:44.81,Default,,0,0,0,,♪ Көзіңізді жұмып қараудан қорықпаңыз.
Dialogue: 0,0:01:44.89,0:01:46.44,Default,,0,0,0,,♪ Келіңіздер! Барлығы осында
Dialogue: 0,0:01:46.52,0:01:48.40,Default,,0,0,0,,♪ Жүрегіңіз соққан жерге барыңыз.
Dialogue: 0,0:01:48.48,0:01:50.40,Default,,0,0,0,,♪ Келіңіздер! өкшеңізді шапалақтаңыз
Dialogue: 0,0:01:50.48,0:01:52.19,Default,,0,0,0,,♪ Жүрегі билейтіндерге
Dialogue: 0,0:01:52.27,0:01:54.44,Default,,0,0,0,,♪ Келіңіздер! миражға секіру
Dialogue: 0,0:01:54.53,0:01:56.57,Default,,0,0,0,,♪ Төңкерілген дүниені міну
Dialogue: 0,0:01:56.99,0:01:58.41,Default,,0,0,0,,♪ Ләлалай лалалай мен тоқтай алмаймын
Dialogue: 0,0:01:58.49,0:02:01.78,Default,,0,0,0,,♪ Махаббатты білгісі келетін қарғыс
Dialogue: 0,0:02:01.87,0:02:04.83,Default,,0,0,0,,♪ Уақыттан тыс, таңнан кешке дейін
Dialogue: 0,0:02:04.91,0:02:06.04,Default,,0,0,0,,♪ Лалалай лалалай мен сені білгім келеді
Dialogue: 0,0:02:06.04,0:02:06.87,Default,,0,0,0,,♪ Ләлалай лалалай мен сені білгім келеді U басқа шындық
Dialogue: 0,0:02:06.87,0:02:09.79,Default,,0,0,0,,U басқа шындық ♪ Ештеңені жіберіп алмаңыз
Dialogue: 0,0:02:08.25,0:02:10.42,Default,,0,0,0,,Басқа сіз сияқты
Dialogue: 0,0:02:09.88,0:02:13.17,Default,,0,0,0,,♪ Уақыт ешкімді күтпейді.
Dialogue: 0,0:02:11.17,0:02:13.17,Default,,0,0,0,,Шындықты қайта бастау мүмкін емес
Dialogue: 0,0:02:13.25,0:02:15.42,Default,,0,0,0,,Бірақ U қайта бастауға болады. ♪ Қатал тағдыр, қайтпас тағдыр
Dialogue: 0,0:02:15.42,0:02:17.42,Default,,0,0,0,,♪ Қатал тағдыр, қайтпас тағдыр
Dialogue: 0,0:02:17.51,0:02:21.26,Default,,0,0,0,,♪ Ойланып үлгергенше, құмды дауыл соғып кетті.
Dialogue: 0,0:02:21.35,0:02:23.31,Default,,0,0,0,,♪ Алдымнан көрінбесе де
Dialogue: 0,0:02:23.39,0:02:25.39,Default,,0,0,0,,♪ Саған сенгім келеді
Dialogue: 0,0:02:25.47,0:02:28.69,Default,,0,0,0,,♪ Қорықпай қадам бассаң
Dialogue: 0,0:02:28.77,0:02:30.40,Default,,0,0,0,,♪ Келіңіздер! Барлығы осында
Dialogue: 0,0:02:30.48,0:02:32.23,Default,,0,0,0,,♪ Жүрегіңіз соққан жерге барыңыз.
Dialogue: 0,0:02:32.31,0:02:34.44,Default,,0,0,0,,♪ Келіңіздер! өкшеңізді шапалақтаңыз
Dialogue: 0,0:02:34.53,0:02:36.86,Default,,0,0,0,,♪ Жүрегі билегендерге, келіңдер.
Dialogue: 0,0:02:36.94,0:02:38.49,Default,,0,0,0,,♪ Келіңіздер! Барлығы осында
Dialogue: 0,0:02:38.57,0:02:40.20,Default,,0,0,0,,♪ Жүрегіңіз соққан жерге барыңыз.
Dialogue: 0,0:02:40.28,0:02:42.45,Default,,0,0,0,,♪ Келіңіздер! өкшеңізді шапалақтаңыз
Dialogue: 0,0:02:42.53,0:02:44.16,Default,,0,0,0,,♪ Жүректері билегендерге барыңыз.
Dialogue: 0,0:02:44.24,0:02:46.58,Default,,0,0,0,,♪ Келіңіздер! Ұшатын китке секіру
Dialogue: 0,0:02:46.66,0:02:48.54,Default,,0,0,0,,♪ Осы төңкерілген әлемде толықтай билеңіз
Dialogue: 0,0:02:48.91,0:02:49.92,Default,,0,0,0,,♪ Ләләлай лалалай
Dialogue: 0,0:02:50.00,0:02:51.92,Default,,0,0,0,,♪ Есімсіз сағым туралы ешкім білмейді
Dialogue: 0,0:02:52.00,0:02:53.84,Default,,0,0,0,,♪ Қашып бара жатыр
Dialogue: 0,0:02:53.92,0:02:56.88,Default,,0,0,0,,♪ Сол жарты айға қолыңды соз
Dialogue: 0,0:02:56.96,0:02:57.97,Default,,0,0,0,,♪ Ләләлай лалалай
Dialogue: 0,0:02:58.05,0:03:00.30,Default,,0,0,0,,♪ Мен сені білгім келеді, естімеймін
Dialogue: 0,0:03:00.38,0:03:01.76,Default,,0,0,0,,♪ Қорқақ таң
Dialogue: 0,0:03:01.84,0:03:05.68,Default,,0,0,0,,♪ Қанша кездессем де
Dialogue: 0,0:03:07.10,0:03:08.10,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:03:08.18,0:03:10.23,Default,,0,0,0,,Сен басқаша өмір сүрейік
Dialogue: 0,0:03:08.77,0:03:10.23,Default,,0,0,0,,♪ Түс болса, оянба
Dialogue: 0,0:03:10.31,0:03:13.36,Default,,0,0,0,,♪ Шындықтың денесі де, жамылғысы да жоқ.
Dialogue: 0,0:03:10.73,0:03:13.36,Default,,0,0,0,,Кел, жаңа өмір бастайық
Dialogue: 0,0:03:13.90,0:03:16.23,Default,,0,0,0,,Әлемді өзгертейік
Dialogue: 0,0:03:17.86,0:03:21.78,Default,,0,0,0,,♪ Уақыт ешкімді күтпейді.
Dialogue: 0,0:03:22.28,0:03:26.41,Default,,0,0,0,,) Буха ха ха ха ха ха…
Dialogue: 0,0:03:26.79,0:03:28.62,Default,,0,0,0,,Қоңырау? (қоңырау) А.
Dialogue: 0,0:03:28.70,0:03:29.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:30.87,0:03:33.29,Default,,0,0,0,,Жоқ... бұл ештеңе емес.
Dialogue: 0,0:03:44.01,0:03:46.72,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:03:47.60,0:03:49.14,Default,,0,0,0,,Сузу сені сонда жіберейін бе?
Dialogue: 0,0:03:50.10,0:03:51.10,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:03:51.19,0:03:52.39,Default,,0,0,0,,Кешкі ас ше?
Dialogue: 0,0:03:53.02,0:03:54.02,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:03:56.02,0:03:59.36,Default,,0,0,0,,Түсіндім, сонда барамын.
Dialogue: 0,0:03:59.82,0:04:02.28,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:04:04.24,0:04:06.87,Default,,0,0,0,,Белле - виртуалды әлем U жасаған ең әдемі әйел.
Dialogue: 0,0:04:06.95,0:04:08.66,Default,,0,0,0,,Өте ерекше, сирек кездесетін ән
Dialogue: 0,0:04:08.74,0:04:10.83,Default,,0,0,0,,Беллдің әні сенімге толы
Dialogue: 0,0:04:10.91,0:04:14.75,Default,,0,0,0,,5 миллиард шоттың ішіндегі ең көрнектісі
Dialogue: 0,0:04:15.29,0:04:17.09,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:04:38.19,0:04:43.20,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:05:22.44,0:05:27.87,Default,,0,0,0,,(үрмелі оркестрдің орындауы)
Dialogue: 0,0:05:37.08,0:05:38.08,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:05:38.17,0:05:40.54,Default,,0,0,0,,Лука-чан – мектебіміздің ханшайымы.
Dialogue: 0,0:05:40.84,0:05:42.46,Default,,0,0,0,,Менің аяғым жіңішке, ұзын.
Dialogue: 0,0:05:42.55,0:05:44.30,Default,,0,0,0,,Форма кигенде де үлгіге ұқсайды
Dialogue: 0,0:05:44.84,0:05:46.38,Default,,0,0,0,,Эй
Dialogue: 0,0:05:46.47,0:05:49.60,Default,,0,0,0,,) Арық та, ұзын да емес балалардан қызғаныш көп сияқты.
Dialogue: 0,0:05:49.68,0:05:50.97,Default,,0,0,0,,Хиро-чан
Dialogue: 0,0:05:51.56,0:05:52.60,Default,,0,0,0,,Бұл Лука-чан.
Dialogue: 0,0:05:52.68,0:05:54.89,Default,,0,0,0,,Сіз табиғи түрде барлығына көмекші ретінде әрекет етесіз.
Dialogue: 0,0:05:55.35,0:05:57.90,Default,,0,0,0,,Себебі бәрі күн сияқты жиналады, мен сенімдімін.
Dialogue: 0,0:05:58.31,0:05:59.90,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:06:00.86,0:06:02.07,Default,,0,0,0,,Бұл тітіркендіргіш.
Dialogue: 0,0:06:02.15,0:06:04.65,Default,,0,0,0,,Себебі Сузу айдың қараңғы жағына ұқсайды.
Dialogue: 0,0:06:04.74,0:06:07.03,Default,,0,0,0,,Ешкім келмейтіні жақсы (Сузуки) Ааааааааааа...
Dialogue: 0,0:06:07.11,0:06:09.78,Default,,0,0,0,,Сәлем... Хиро-чан (Хирока)?
Dialogue: 0,0:06:09.87,0:06:13.41,Default,,0,0,0,,Улы тіл Менің ойымша, бұл сәл жұмсақ болуы мүмкін.
Dialogue: 0,0:06:13.49,0:06:15.58,Default,,0,0,0,,) Сіз каноэ клубына қосылғыңыз келе ме?
Dialogue: 0,0:06:15.66,0:06:18.21,Default,,0,0,0,,А, Сенпай, каноэ клубы не болды?
Dialogue: 0,0:06:18.29,0:06:20.46,Default,,0,0,0,,Тоқта, Камисін (сенпай), кірме.
Dialogue: 0,0:06:20.54,0:06:22.96,Default,,0,0,0,,Әй, сен неге каноэге бармайсың? Біраз
Dialogue: 0,0:06:23.96,0:06:27.47,Default,,0,0,0,,Камисин Каноэ үйірмесін өзіңіз аштыңыз, бұл керемет емес пе?
Dialogue: 0,0:06:27.80,0:06:29.55,Default,,0,0,0,,Бірақ ол жалғыз.
Dialogue: 0,0:06:29.64,0:06:31.51,Default,,0,0,0,,Неліктен? (Хирока) Неге...
Dialogue: 0,0:06:31.60,0:06:33.10,Default,,0,0,0,,Эй, каноэ
Dialogue: 0,0:06:33.18,0:06:35.18,Default,,0,0,0,,Әй, сен каноэ.
Dialogue: 0,0:06:36.35,0:06:38.94,Default,,0,0,0,,Эй, барма. Әй, бәрі, неге қашып жүрсіңдер?
Dialogue: 0,0:06:39.02,0:06:41.44,Default,,0,0,0,,Жұмсақ тілмен айтсақ, сізді жаман көреді.
Dialogue: 0,0:06:41.90,0:06:44.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:52.62,0:06:54.41,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:06:59.79,0:07:02.17,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:07:02.25,0:07:06.17,Default,,0,0,0,,Шинобу-кун, сенің бойың соншалықты ұзын болады деп ойламаппын.
Dialogue: 0,0:07:06.26,0:07:08.09,Default,,0,0,0,,Сіз бала кезден доссыз ба? (қоңырау жөтел)
Dialogue: 0,0:07:08.17,0:07:09.26,Default,,0,0,0,,Шын мәнінде, мен-
Dialogue: 0,0:07:09.34,0:07:12.39,Default,,0,0,0,,Бірде Шинобу-кун маған ұсыныс жасады.
Dialogue: 0,0:07:12.72,0:07:14.64,Default,,0,0,0,,Шынайы ма? Не?
Dialogue: 0,0:07:14.89,0:07:17.14,Default,,0,0,0,,«Сузу, мен сені қорғаймын».
Dialogue: 0,0:07:17.22,0:07:18.68,Default,,0,0,0,,Қашан?
Dialogue: 0,0:07:18.77,0:07:20.02,Default,,0,0,0,,6 жас
Dialogue: 0,0:07:21.02,0:07:24.02,Default,,0,0,0,,Хаа... Соншалықты баяғыда айтсаң да.
Dialogue: 0,0:07:24.90,0:07:28.19,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:07:34.03,0:07:35.03,Default,,0,0,0,,Иә
Dialogue: 0,0:07:36.12,0:07:38.83,Default,,0,0,0,,Ертедегі оқиға...
Dialogue: 0,0:09:09.42,0:09:11.26,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:09:11.34,0:09:13.88,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:14.80,0:09:16.09,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:09:16.64,0:09:18.43,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:09:21.01,0:09:22.72,Default,,0,0,0,,Ах (жас Сузу) барма.
Dialogue: 0,0:09:22.81,0:09:24.43,Default,,0,0,0,,Мама, өтінемін, бармаңыз.
Dialogue: 0,0:09:24.69,0:09:27.27,Default,,0,0,0,,Жоқ, мен баруым керек, бала өледі.
Dialogue: 0,0:09:27.35,0:09:28.36,Default,,0,0,0,,Ах
Dialogue: 0,0:09:29.02,0:09:33.19,Default,,0,0,0,,Ана Ана Ана Ана!
Dialogue: 0,0:09:45.96,0:09:48.67,Default,,0,0,0,,Ана Ана…
Dialogue: 0,0:09:49.63,0:09:50.67,Default,,0,0,0,,Анашым!
Dialogue: 0,0:09:50.75,0:09:56.68,Default,,0,0,0,,(Рапидтер дыбысы)
Dialogue: 0,0:10:00.18,0:10:01.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:01.97,0:10:04.81,Default,,0,0,0,,Барма, мама.
Dialogue: 0,0:10:05.60,0:10:07.14,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,0:10:17.90,0:10:21.20,Default,,0,0,0,,Жаңбырдан ісінген өзенге секіру өз-өзіне қол жұмсау болады.
Dialogue: 0,0:10:21.28,0:10:24.08,Default,,0,0,0,,Ол жүзуде сенімді болып көрінді, бірақ бассейнде бұл басқаша.
Dialogue: 0,0:10:24.16,0:10:27.08,Default,,0,0,0,,Біреудің баласын құтқарып өлу – жауапсыздық.
Dialogue: 0,0:10:27.33,0:10:30.67,Default,,0,0,0,,Қайғылы жағдай орын алса, өзенде ойнау қиындап, мазасызданады.
Dialogue: 0,0:10:30.75,0:10:33.84,Default,,0,0,0,,Жақсы адам сияқты әрекет еткендіктен, басқаларға көмектескен кезде солай болады.
Dialogue: 0,0:10:36.01,0:10:40.89,Default,,0,0,0,,♪ Мен айналма жолмен жүрдім.
Dialogue: 0,0:10:40.97,0:10:44.60,Default,,0,0,0,,♪ Бұл жай ғана өмір
Dialogue: 0,0:10:44.68,0:10:47.31,Default,,0,0,0,,♪ Тек сен...
Dialogue: 0,0:10:51.86,0:10:54.82,Default,,0,0,0,,Анам неге мені тастап өзенге кетті?
Dialogue: 0,0:10:55.44,0:10:56.57,Default,,0,0,0,,Неге менімен өмір сүргеннен гөрі?
Dialogue: 0,0:10:56.65,0:10:59.78,Default,,0,0,0,,Сіз атын да білмейтін балаға көмектесуді таңдадыңыз ба?
Dialogue: 0,0:11:00.53,0:11:02.95,Default,,0,0,0,,Мен неге жалғызбын?
Dialogue: 0,0:11:03.78,0:11:04.91,Default,,0,0,0,,Неге...
Dialogue: 0,0:11:05.87,0:11:06.87,Default,,0,0,0,,Неге...
Dialogue: 0,0:11:13.04,0:11:15.71,Default,,0,0,0,,Уф уф...
Dialogue: 0,0:11:34.11,0:11:35.77,Default,,0,0,0,,(Бейсбол клубы мүшелерінің айқайы)
Dialogue: 0,0:11:37.57,0:11:39.78,Default,,0,0,0,,Күте тұр (қыз) Тезірек
Dialogue: 0,0:11:44.62,0:11:46.87,Default,,0,0,0,,Мен, жоқ, эй... (қыз) Жарайды.
Dialogue: 0,0:11:46.95,0:11:48.91,Default,,0,0,0,,Ах, дах, а... (есік жабылған дыбыс)
Dialogue: 0,0:11:49.00,0:11:53.33,Default,,0,0,0,,(Қыздар дауысы)
Dialogue: 0,0:11:53.67,0:11:55.13,Default,,0,0,0,,Пегги Сью сүйкімді
Dialogue: 0,0:11:55.21,0:11:57.67,Default,,0,0,0,,Олар АҚШ-та осылай істейді.
Dialogue: 0,0:12:00.42,0:12:01.43,Default,,0,0,0,,Иә (Suzu) Иә?
Dialogue: 0,0:12:01.51,0:12:02.51,Default,,0,0,0,,Иә
Dialogue: 0,0:12:02.59,0:12:05.22,Default,,0,0,0,,Бәріміз бірге ән айтайық. (Қыздар) Әй, ән айт.
Dialogue: 0,0:12:05.30,0:12:06.68,Default,,0,0,0,,Ән айтпайтын жалғыз сен бе?
Dialogue: 0,0:12:06.76,0:12:08.64,Default,,0,0,0,,Ән айта алмайтының өтірік, солай ма?
Dialogue: 0,0:12:08.72,0:12:10.93,Default,,0,0,0,,Ән айт (қыз) Әй, ән айт.
Dialogue: 0,0:12:11.02,0:12:12.89,Default,,0,0,0,,Ән айт (Қыздар) Ән айт дедім.
Dialogue: 0,0:12:12.98,0:12:13.98,Default,,0,0,0,,Ән айт!
Dialogue: 0,0:12:14.06,0:12:15.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:28.95,0:12:32.79,Default,,0,0,0,,♪ Жарқырау...
Dialogue: 0,0:12:33.21,0:12:36.42,Default,,0,0,0,,♪ Жоқ...ха~на
Dialogue: 0,0:12:37.04,0:12:39.25,Default,,0,0,0,,♪ Ха~... Ах...
Dialogue: 0,0:12:39.34,0:12:40.92,Default,,0,0,0,,♪ Келіңіздер...
Dialogue: 0,0:12:41.01,0:12:42.80,Default,,0,0,0,,Ха... Уф
Dialogue: 0,0:12:43.59,0:12:45.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:45.72,0:12:48.72,Default,,0,0,0,,Уаааааааааааааааааааааааааааа...
Dialogue: 0,0:12:51.10,0:12:53.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:53.56,0:12:54.81,Default,,0,0,0,,Гррр…
Dialogue: 0,0:12:54.90,0:12:58.36,Default,,0,0,0,,(Жылау қоңырауы)
Dialogue: 0,0:12:58.61,0:13:00.23,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:13:11.45,0:13:12.54,Default,,0,0,0,,U?
Dialogue: 0,0:13:13.04,0:13:15.17,Default,,0,0,0,,U басқа шындық
Dialogue: 0,0:13:15.42,0:13:17.33,Default,,0,0,0,,Басқа сіз сияқты
Dialogue: 0,0:13:17.88,0:13:22.09,Default,,0,0,0,,Шындықты қайтару мүмкін емес, бірақ U кері қайтарылуы мүмкін.
Dialogue: 0,0:13:22.92,0:13:25.72,Default,,0,0,0,,Енді сіз басқаша өмір сүрейік
Dialogue: 0,0:13:26.09,0:13:29.10,Default,,0,0,0,,Енді жаңа өмір бастайық
Dialogue: 0,0:13:29.68,0:13:32.27,Default,,0,0,0,,Әлемді өзгертейік
Dialogue: 0,0:13:32.35,0:13:33.73,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:13:37.94,0:13:38.98,Default,,0,0,0,,Аты…
Dialogue: 0,0:13:45.15,0:13:46.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:48.57,0:13:51.74,Default,,0,0,0,,Мен Лука-чанның (қыз) жанында, Ватанабе-санның қасында отырамын
Dialogue: 0,0:13:51.83,0:13:54.16,Default,,0,0,0,,Иә, бұл алдау. (Әйел) Мен Рука-чанның қасында болғым келеді.
Dialogue: 0,0:13:54.25,0:13:56.67,Default,,0,0,0,,Ватанабе мырза, маған бұрылып, суретке түсіріңіз.
Dialogue: 0,0:13:57.37,0:13:59.13,Default,,0,0,0,,Ах Сузу-чан
Dialogue: 0,0:13:59.21,0:14:01.63,Default,,0,0,0,,Эх (Рука) Сузу-чан да кіріп келді.
Dialogue: 0,0:14:01.71,0:14:03.09,Default,,0,0,0,,Мен... Жарайды, мен.
Dialogue: 0,0:14:03.34,0:14:04.55,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:14:15.56,0:14:17.69,Default,,0,0,0,,Иә? Лука-чан?
Dialogue: 0,0:14:17.77,0:14:20.19,Default,,0,0,0,,Артқа бас тарту жоқ
Dialogue: 0,0:14:21.15,0:14:22.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:25.49,0:14:26.82,Default,,0,0,0,,Секпілдер...
Dialogue: 0,0:14:28.20,0:14:29.49,Default,,0,0,0,,Бәлкім—
Dialogue: 0,0:14:30.12,0:14:31.12,Default,,0,0,0,,Мен?
Dialogue: 0,0:14:35.33,0:14:36.33,Default,,0,0,0,,«Қоңырау»
Dialogue: 0,0:14:38.71,0:14:39.71,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:14:41.25,0:14:44.59,Default,,0,0,0,,Бас тарту немесе Жарайды?
Dialogue: 0,0:14:50.18,0:14:51.85,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:14:52.39,0:14:54.06,Default,,0,0,0,,Құрылғыңызды киіңіз
Dialogue: 0,0:14:56.73,0:14:59.48,Default,,0,0,0,,Биометриялық ақпаратты оқу
Dialogue: 0,0:14:59.89,0:15:02.90,Default,,0,0,0,,Аяқталған Негізгі бөлімді бөлісуді бастау
Dialogue: 0,0:15:03.44,0:15:06.03,Default,,0,0,0,,Көру алдымен бақылауға түседі
Dialogue: 0,0:15:07.49,0:15:08.53,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:15:12.95,0:15:14.95,Default,,0,0,0,,Басқа когнитивтік функциялар және—
Dialogue: 0,0:15:15.04,0:15:18.12,Default,,0,0,0,,Аяқ-қолдардағы терең сезімдер бақылауға түседі
Dialogue: 0,0:15:18.79,0:15:20.67,Default,,0,0,0,,Сіздің тіркелген
Dialogue: 0,0:15:20.75,0:15:23.88,Default,,0,0,0,,Дене меншігі мен денеге меншік сезімі ауысады.
Dialogue: 0,0:15:35.47,0:15:36.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:37.18,0:15:39.48,Default,,0,0,0,,U әлеміне қош келдіңіз
Dialogue: 0,0:15:50.36,0:15:52.70,Default,,0,0,0,,♪ Лалала
Dialogue: 0,0:15:54.49,0:15:58.58,Default,,0,0,0,,♪ ла ла ла ла ла
Dialogue: 0,0:16:00.79,0:16:03.08,Default,,0,0,0,,♪ Ән
Dialogue: 0,0:16:05.84,0:16:11.47,Default,,0,0,0,,♪ Маған жол көрсет!
Dialogue: 0,0:16:14.84,0:16:16.05,Default,,0,0,0,,Мен ән айта алатынмын
Dialogue: 0,0:16:17.26,0:16:20.10,Default,,0,0,0,,Ақыры... Ән айта алдым
Dialogue: 0,0:16:22.06,0:16:27.15,Default,,0,0,0,,♪ Сондай шағын әуен
Dialogue: 0,0:16:28.53,0:16:33.74,Default,,0,0,0,,♪ Еніп жатқан дүние
Dialogue: 0,0:16:34.41,0:16:36.70,Default,,0,0,0,,♪ Мен оны көргім келеді
Dialogue: 0,0:16:36.78,0:16:40.95,Default,,0,0,0,,♪ Күнде таңертең оянып, оны іздеймін.
Dialogue: 0,0:16:41.58,0:16:46.25,Default,,0,0,0,,♪ Сенсіз болашақ
Dialogue: 0,0:16:46.33,0:16:49.00,Default,,0,0,0,,♪ Мен оны елестеткім келмейді
Dialogue: 0,0:16:49.38,0:16:52.09,Default,,0,0,0,,♪ Маған ұнамайды
Dialogue: 0,0:16:52.17,0:16:53.88,Default,,0,0,0,,♪ Бірақ ол кетіп қалды
Dialogue: 0,0:16:53.97,0:16:55.84,Default,,0,0,0,,♪ Мен дұрыс жауапты білмеймін
Dialogue: 0,0:16:55.93,0:16:59.35,Default,,0,0,0,,♪ Менен басқаның бәрі жақсы жүріп жатқан сияқты.
Dialogue: 0,0:16:59.43,0:17:02.64,Default,,0,0,0,,♪ Әлі ертең
Dialogue: 0,0:17:02.73,0:17:06.44,Default,,0,0,0,,♪ Мен келе жатыр деп ойлаймын
Dialogue: 0,0:17:04.06,0:17:06.44,Default,,0,0,0,,Кім және қайда ән айтып жатыр?
Dialogue: 0,0:17:06.44,0:17:07.77,Default,,0,0,0,,♪ Мен келе жатыр деп ойлаймын
Dialogue: 0,0:17:08.15,0:17:12.28,Default,,0,0,0,,♪ Ән, мені жетеле!
Dialogue: 0,0:17:12.36,0:17:15.57,Default,,0,0,0,,♪ жиіркенішті болады
Dialogue: 0,0:17:15.66,0:17:19.03,Default,,0,0,0,,♪ Барлығы бақытты ма?
Dialogue: 0,0:17:19.37,0:17:23.96,Default,,0,0,0,,♪ Сіз жақсы көретін адам бар ма?
Dialogue: 0,0:17:22.66,0:17:23.96,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:17:23.96,0:17:26.33,Default,,0,0,0,,♪ Сіз жақсы көретін адам бар ма?
Dialogue: 0,0:17:25.29,0:17:26.79,Default,,0,0,0,,Өкінішті болмаңыз
Dialogue: 0,0:17:26.42,0:17:29.09,Default,,0,0,0,,♪ Мен осылай жалғыз қалғанда
Dialogue: 0,0:17:27.08,0:17:29.09,Default,,0,0,0,,Сыртқы түрі жаман емес, бірақ...
Dialogue: 0,0:17:29.09,0:17:32.34,Default,,0,0,0,,♪ Мен осылай жалғыз қалғанда
Dialogue: 0,0:17:31.50,0:17:32.80,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:17:32.42,0:17:34.09,Default,,0,0,0,,♪ Мен мазасызданамын
Dialogue: 0,0:17:32.88,0:17:34.09,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:34.09,0:17:34.80,Default,,0,0,0,,♪ Мен мазасызданамын
Dialogue: 0,0:17:34.88,0:17:39.30,Default,,0,0,0,,♪ Ән, мені жетеле!
Dialogue: 0,0:17:40.01,0:17:46.73,Default,,0,0,0,,♪ Не болса да жақсы! !
Dialogue: 0,0:17:48.06,0:17:49.65,Default,,0,0,0,,♪ Ән
Dialogue: 0,0:17:49.73,0:17:50.73,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:51.65,0:17:54.49,Default,,0,0,0,,♪ Менің қасымда бол
Dialogue: 0,0:17:55.53,0:17:57.49,Default,,0,0,0,,♪ Махаббат
Dialogue: 0,0:17:59.16,0:18:00.70,Default,,0,0,0,,♪ Жақын кел
Dialogue: 0,0:18:01.03,0:18:04.66,Default,,0,0,0,,Сен кереметсің Сен сұлусың
Dialogue: 0,0:18:05.58,0:18:06.75,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:07.37,0:18:08.63,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:08.71,0:18:11.96,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:18:15.17,0:18:17.34,Default,,0,0,0,,Жазушылар жоқ
Dialogue: 0,0:18:18.51,0:18:21.10,Default,,0,0,0,,Дүниеде ештеңе өзгермейді
Dialogue: 0,0:18:21.18,0:18:22.31,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:26.48,0:18:27.64,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:29.06,0:18:32.40,Default,,0,0,0,,Ақыры... Ән айта алдым
Dialogue: 0,0:19:11.60,0:19:12.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:16.57,0:19:21.28,Default,,0,0,0,,♪ Сондай шағын әуен
Dialogue: 0,0:19:24.20,0:19:28.58,Default,,0,0,0,,♪ Еніп жатқан дүние
Dialogue: 0,0:19:29.33,0:19:31.54,Default,,0,0,0,,♪ Мен оны көргім келеді
Dialogue: 0,0:19:31.62,0:19:35.88,Default,,0,0,0,,♪ Күнде таңертең оянып, оны іздеймін.
Dialogue: 0,0:19:36.46,0:19:40.97,Default,,0,0,0,,♪ Сенсіз болашақ
Dialogue: 0,0:19:41.05,0:19:43.43,Default,,0,0,0,,♪ Мен оны елестеткім келмейді
Dialogue: 0,0:19:44.05,0:19:46.51,Default,,0,0,0,,♪ Маған ұнамайды
Dialogue: 0,0:19:47.06,0:19:48.85,Default,,0,0,0,,♪ Бірақ ол кетіп қалды
Dialogue: 0,0:19:48.93,0:19:51.19,Default,,0,0,0,,♪ Мен дұрыс жауапты білмеймін
Dialogue: 0,0:19:51.52,0:19:52.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:52.65,0:19:54.48,Default,,0,0,0,,Мен оны ешқашан естіген емеспін (Ас) Ән айт, шындап.
Dialogue: 0,0:19:54.56,0:19:56.32,Default,,0,0,0,,Бірегей сұлу (А) Бұл қандай ән?
Dialogue: 0,0:19:56.40,0:19:58.19,Default,,0,0,0,,Іздесем де шықпайды.
Dialogue: 0,0:19:58.28,0:19:59.90,Default,,0,0,0,,Костюмдердің дүниетанымы өте ақылсыз.
Dialogue: 0,0:19:59.99,0:20:01.07,Default,,0,0,0,,Мен уайымдамай тұра алмаймын.
Dialogue: 0,0:20:01.15,0:20:03.11,Default,,0,0,0,,Біреу маған Белл туралы айтып береді
Dialogue: 0,0:20:04.07,0:20:05.12,Default,,0,0,0,,Қоңырау?
Dialogue: 0,0:20:05.20,0:20:06.91,Default,,0,0,0,,А, мен оны аздап тыңдадым...
Dialogue: 0,0:20:06.99,0:20:08.83,Default,,0,0,0,,Мұндай бала мүлдем маңызды емес.
Dialogue: 0,0:20:08.91,0:20:09.91,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:20:10.00,0:20:11.12,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:20:11.21,0:20:12.92,Default,,0,0,0,,Тітіркендіргіш (Ас) Тек асыра сілтеп кеткен сұлулық
Dialogue: 0,0:20:13.00,0:20:14.46,Default,,0,0,0,,Сіз сексуалды сатқыңыз келе ме? (Ас) дөрекі
Dialogue: 0,0:20:14.54,0:20:16.09,Default,,0,0,0,,Композиция әдістері туралы негізгі білімнің болмауы
Dialogue: 0,0:20:16.17,0:20:17.42,Default,,0,0,0,,100 пар орналасуының арқасында
Dialogue: 0,0:20:17.50,0:20:19.42,Default,,0,0,0,,Сіз тіпті күш салмасаңыз да, оны басқаларға қалдырасыз.
Dialogue: 0,0:20:19.51,0:20:21.67,Default,,0,0,0,,Музыканы жеңіл қабылдамаңыз
Dialogue: 0,0:20:23.30,0:20:24.59,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:24.68,0:20:27.14,Default,,0,0,0,,Неге екені белгісіз, мен бұл әнге қызығамын.
Dialogue: 0,0:20:27.22,0:20:29.64,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:29.72,0:20:31.73,Default,,0,0,0,,Маған арнап ән айтып тұрғандай сезінемін
Dialogue: 0,0:20:31.81,0:20:33.65,Default,,0,0,0,,Сіз маған тек тыңдауға рұқсат беріп жатқан сияқтысыз.
Dialogue: 0,0:20:33.73,0:20:35.15,Default,,0,0,0,,Жоқ, мен үшін
Dialogue: 0,0:20:35.23,0:20:37.32,Default,,0,0,0,,Жоқ, тек мен үшін
Dialogue: 0,0:20:37.40,0:20:40.65,Default,,0,0,0,,Неліктен? (Ас) Неге?
Dialogue: 0,0:20:44.95,0:20:46.99,Default,,0,0,0,,Сен Беллді білесің бе? (Сузу) А? иә?
Dialogue: 0,0:20:47.33,0:20:48.79,Default,,0,0,0,,Әрине (қыз) анау-мынау
Dialogue: 0,0:20:48.87,0:20:49.87,Default,,0,0,0,,U, солай ма?
Dialogue: 0,0:20:49.95,0:20:52.04,Default,,0,0,0,,Бір ғажап бала шықты емес пе?
Dialogue: 0,0:20:55.04,0:20:58.50,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:21:01.71,0:21:02.97,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:04.26,0:21:07.05,Default,,0,0,0,,Хиро-чан, қорқынышты нәрсе болды. Қоңырау...
Dialogue: 0,0:21:07.30,0:21:08.30,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:21:08.39,0:21:10.52,Default,,0,0,0,,Енді U Music ғаламдық вирустық диаграммасында.
Dialogue: 0,0:21:10.60,0:21:12.56,Default,,0,0,0,,Күтілгендей дәреже
Dialogue: 0,0:21:12.64,0:21:13.64,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:21:13.73,0:21:15.65,Default,,0,0,0,,Мен өзімді қалай ұрып-соққаныма сене алар емеспін.
Dialogue: 0,0:21:16.02,0:21:19.73,Default,,0,0,0,,Күтілгендей, жеке мүдделер жай ғана шу шығарады.
Dialogue: 0,0:21:19.82,0:21:21.99,Default,,0,0,0,,Hmph, тек аффирмацияларды алатын адам...
Dialogue: 0,0:21:22.07,0:21:23.82,Default,,0,0,0,,Тек негізгі жанкүйерлер екеніне дәлел
Dialogue: 0,0:21:23.90,0:21:25.41,Default,,0,0,0,,кішкентай кішкентай
Dialogue: 0,0:21:25.49,0:21:28.74,Default,,0,0,0,,U-да өтіріксіз жақсы және теріс жақтары шындықты күшейтеді.
Dialogue: 0,0:21:28.83,0:21:30.66,Default,,0,0,0,,... тіпті жартысы сынға ұшырады ма?
Dialogue: 0,0:21:30.74,0:21:32.37,Default,,0,0,0,,Өл, өл!
Dialogue: 0,0:21:32.45,0:21:34.62,Default,,0,0,0,,Бұл екінші жартысы бағаланатынын білдіреді.
Dialogue: 0,0:21:34.71,0:21:36.00,Default,,0,0,0,,Өзіңізге сенімді болыңыз
Dialogue: 0,0:21:36.08,0:21:37.58,Default,,0,0,0,,Қандай құпиялар бағаланды?
Dialogue: 0,0:21:37.67,0:21:39.59,Default,,0,0,0,,Лука-чанға ұқсайды
Dialogue: 0,0:21:39.67,0:21:40.67,Default,,0,0,0,,Және?
Dialogue: 0,0:21:40.75,0:21:43.26,Default,,0,0,0,,Маған қызықты деп тауып, ұйымдастырған адамдар
Dialogue: 0,0:21:43.34,0:21:44.34,Default,,0,0,0,,Сонда?
Dialogue: 0,0:21:44.42,0:21:45.72,Default,,0,0,0,,Хиро-чан шығарған
Dialogue: 0,0:21:45.80,0:21:47.93,Default,,0,0,0,,Сонымен қатар, костюмдер, би және...
Dialogue: 0,0:21:48.01,0:21:50.64,Default,,0,0,0,,Жоқ! Иә, бірақ ол басқаша
Dialogue: 0,0:21:51.01,0:21:53.47,Default,,0,0,0,,Ең үлкен құпия - бұл У.
Dialogue: 0,0:21:53.56,0:21:54.89,Default,,0,0,0,,U денені бөлісу технологиясы -
Dialogue: 0,0:21:54.98,0:21:57.77,Default,,0,0,0,,Адамның жасырын қабілеттерін күштеп шығару
Dialogue: 0,0:21:57.85,0:21:59.86,Default,,0,0,0,,Әйтпесе, ешқашан ән айта алмайсың...
Dialogue: 0,0:21:59.94,0:22:02.73,Default,,0,0,0,,Баладай қатты жылап, көміліп қалдым.
Dialogue: 0,0:22:02.82,0:22:04.65,Default,,0,0,0,,Аа, дұрыс, мынаны қарашы.
Dialogue: 0,0:22:04.74,0:22:06.65,Default,,0,0,0,,Беллдің шынайы тұлғасын іздеу...
Dialogue: 0,0:22:06.74,0:22:08.95,Default,,0,0,0,,Уау! Не, сіз шынайы тұлғаны іздеп жүрсіз бе?
Dialogue: 0,0:22:09.07,0:22:11.66,Default,,0,0,0,,Бұл жігіттердің қате пікірі мені күлдіреді.
Dialogue: 0,0:22:11.74,0:22:14.12,Default,,0,0,0,,Дүние жүзіне әйгілі адамдардың барлығы сапқа тұрды
Dialogue: 0,0:22:14.20,0:22:16.54,Default,,0,0,0,,Бұл рас болуы мүмкін емес, Фофофо.
Dialogue: 0,0:22:16.62,0:22:17.87,Default,,0,0,0,,Бұл күлкі емес!
Dialogue: 0,0:22:17.96,0:22:20.88,Default,,0,0,0,,Беллдің туған жері соншалықты шалғай ауылда...
Dialogue: 0,0:22:20.96,0:22:23.88,Default,,0,0,0,,Ешкім сені кішкентай қыз деп санамайды.
Dialogue: 0,0:22:23.96,0:22:26.30,Default,,0,0,0,,Фофофо... (қоңырау) Қорқынышты
Dialogue: 0,0:22:26.63,0:22:28.93,Default,,0,0,0,,Мұндай күлкілі ойын жоқ.
Dialogue: 0,0:22:29.01,0:22:31.72,Default,,0,0,0,,Менің алдымда сепкілі мектеп оқушысы...
Dialogue: 0,0:22:31.80,0:22:33.64,Default,,0,0,0,,Оны АҚШ-тың үлкен жұлдызына айналдырыңыз.
Dialogue: 0,0:22:33.72,0:22:35.31,Default,,0,0,0,,Fofo for…
Dialogue: 0,0:22:35.39,0:22:38.73,Default,,0,0,0,,А, бұл үлкен табыс болуы мүмкін, бірақ уайымдамаңыз.
Dialogue: 0,0:22:38.81,0:22:40.02,Default,,0,0,0,,Бір доллар да қалмады...
Dialogue: 0,0:22:40.23,0:22:42.94,Default,,0,0,0,,Мен әртүрлі қайырымдылық қорларына жасырын түрде садақа беремін.
Dialogue: 0,0:22:43.65,0:22:44.65,Default,,0,0,0,,♪ Ләләлай лалалай
Dialogue: 0,0:22:44.73,0:22:46.65,Default,,0,0,0,,♪ Есімсіз сағым туралы ешкім білмейді
Dialogue: 0,0:22:46.74,0:22:48.57,Default,,0,0,0,,♪ Қашып бара жатыр
Dialogue: 0,0:22:48.65,0:22:51.62,Default,,0,0,0,,♪ Сол жарты айға қолыңды соз
Dialogue: 0,0:22:51.70,0:22:52.70,Default,,0,0,0,,♪ Ләләлай лалалай
Dialogue: 0,0:22:52.37,0:22:54.20,Default,,0,0,0,,Belle - біздің жаңа дива
Dialogue: 0,0:22:52.78,0:22:54.87,Default,,0,0,0,,♪ Мен сені білгім келеді, естімеймін
Dialogue: 0,0:22:54.33,0:22:54.87,Default,,0,0,0,,Орфографиясы - BELLE, ол оған сәйкес келеді.
Dialogue: 0,0:22:54.87,0:22:57.66,Default,,0,0,0,,Орфографиясы - BELLE, бұл оған қолайлы.
Dialogue: 0,0:22:56.62,0:22:58.92,Default,,0,0,0,,♪ Қанша кездессем де
Dialogue: 0,0:22:57.75,0:22:58.92,Default,,0,0,0,,Бұл Белл емес пе? (С) BELLE?
Dialogue: 0,0:22:58.92,0:23:00.46,Default,,0,0,0,,♪ Қанша кездессем де
Dialogue: 0,0:23:01.04,0:23:02.88,Default,,0,0,0,,Міндетті емес.
Dialogue: 0,0:23:02.96,0:23:03.46,Default,,0,0,0,,Бұл оған өте ыңғайлы
Dialogue: 0,0:23:03.42,0:23:04.34,Default,,0,0,0,,Бұл оған өте қолайлы ♪ Түс болса, оянба
Dialogue: 0,0:23:04.34,0:23:04.88,Default,,0,0,0,,♪ Түс болса, оянба
Dialogue: 0,0:23:04.88,0:23:05.96,Default,,0,0,0,,Ең аз айту керек сөз Сөз, қарапайымдылықпен. ♪ Шындықтың денесі де, жамылғысы да жоқ.
Dialogue: 0,0:23:05.96,0:23:07.88,Default,,0,0,0,,♪ Шындықтың денесі де, жамылғысы да жоқ.
Dialogue: 0,0:23:07.97,0:23:09.01,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:23:09.09,0:23:12.05,Default,,0,0,0,,Ол қыз неге менен үлкен? Ақымақ болма!
Dialogue: 0,0:23:12.14,0:23:13.43,Default,,0,0,0,,Бұл Пегги Сью (ас) аяқталды.
Dialogue: 0,0:23:13.51,0:23:14.01,Default,,0,0,0,,Бұрынғы адам (Ас) әлі де сонда болды ма?
Dialogue: 0,0:23:13.72,0:23:14.72,Default,,0,0,0,,Бұрынғы адам (Ас) сонда болды ма? Не? Бір сәт...
Dialogue: 0,0:23:14.81,0:23:17.35,Default,,0,0,0,,Тар Тоқта!
Dialogue: 0,0:23:17.43,0:23:19.31,Default,,0,0,0,,Гяхахаха...
Dialogue: 0,0:23:19.39,0:23:22.06,Default,,0,0,0,,Қызғаншақ болыңдар, құдықтағы бақалар.
Dialogue: 0,0:23:22.15,0:23:24.77,Default,,0,0,0,,Беллдің арқасында әлем өзгерді.
Dialogue: 0,0:23:24.86,0:23:27.86,Default,,0,0,0,,Көбірек толқыңыз, көбірек
Dialogue: 0,0:23:27.94,0:23:29.78,Default,,0,0,0,,Қоңырау - ең жақсы!
Dialogue: 0,0:23:29.86,0:23:33.74,Default,,0,0,0,,Гахахахаха...
Dialogue: 0,0:23:33.83,0:23:35.12,Default,,0,0,0,,Неге күлесің, Хирока!
Dialogue: 0,0:23:35.20,0:23:36.20,Default,,0,0,0,,Ха…
Dialogue: 0,0:23:36.29,0:23:38.37,Default,,0,0,0,,Бұл орынды енді пайдалана алмайсыз.
Dialogue: 0,0:23:38.79,0:23:42.67,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:23:51.76,0:23:57.68,Default,,0,0,0,,(хормен ән айту)
Dialogue: 0,0:24:05.69,0:24:11.70,Default,,0,0,0,,♪ Халлилуя
Dialogue: 0,0:24:16.28,0:24:18.16,Default,,0,0,0,,Міне, тасталған мектептің мақсаты осылай өзгертілді.
Dialogue: 0,0:24:18.24,0:24:20.54,Default,,0,0,0,,Біз жергілікті шараларға да қатысамыз.
Dialogue: 0,0:24:20.62,0:24:23.54,Default,,0,0,0,,Міне, келесіде көресіз...
Dialogue: 0,0:24:24.33,0:24:25.75,Default,,0,0,0,,Аа...
Dialogue: 0,0:24:27.88,0:24:28.92,Default,,0,0,0,,Цикада жаңбырында―
Dialogue: 0,0:24:29.01,0:24:30.84,Default,,0,0,0,,Рождестволық концерттік жаттығулар...
Dialogue: 0,0:24:30.92,0:24:32.30,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:24:32.76,0:24:34.72,Default,,0,0,0,,Сузу, шығып ән айт.
Dialogue: 0,0:24:34.80,0:24:36.01,Default,,0,0,0,,Мүмкін емес Мүмкін емес Мүмкін емес...
Dialogue: 0,0:24:36.10,0:24:39.60,Default,,0,0,0,,Көлеңкеде сыбырласатын хор мүшелері жоқ, олар Сузумуши ме?
Dialogue: 0,0:24:39.89,0:24:41.52,Default,,0,0,0,,Мен Сузумушимен жақсымын.
Dialogue: 0,0:24:41.60,0:24:43.81,Default,,0,0,0,,Ең кішілер ән айтсын
Dialogue: 0,0:24:43.90,0:24:44.90,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:24:44.98,0:24:47.57,Default,,0,0,0,,Бұл мәселе. Қазіргі балаларда ешқандай тілек жоқ.
Dialogue: 0,0:24:47.65,0:24:49.28,Default,,0,0,0,,Бақыттан бет бұрасың ба?
Dialogue: 0,0:24:49.36,0:24:52.61,Default,,0,0,0,,Сенің бақытыңды анаң да тілейді деген сенімдемін.
Dialogue: 0,0:24:52.70,0:24:54.28,Default,,0,0,0,,Бақыттысың ба? Қалай?
Dialogue: 0,0:24:54.57,0:24:55.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:55.66,0:24:57.12,Default,,0,0,0,,Мен қалай бақытты бола аламын?
Dialogue: 0,0:24:57.20,0:24:59.37,Default,,0,0,0,,Не... не істеуім керек...
Dialogue: 0,0:24:59.45,0:25:00.87,Default,,0,0,0,,Сөйлегенде сәл салғырт естілуім мүмкін—
Dialogue: 0,0:25:00.95,0:25:02.21,Default,,0,0,0,,Бақыттысың ба?
Dialogue: 0,0:25:02.29,0:25:04.79,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:25:05.04,0:25:07.46,Default,,0,0,0,,Негізі мен осылай әже болып кетсем де...
Dialogue: 0,0:25:07.54,0:25:09.96,Default,,0,0,0,,Мен бақыт дегеннің не екенін білмеймін
Dialogue: 0,0:25:10.59,0:25:11.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:12.09,0:25:13.09,Default,,0,0,0,,Уау
Dialogue: 0,0:25:15.05,0:25:16.05,Default,,0,0,0,,Ах
Dialogue: 0,0:25:16.14,0:25:18.80,Default,,0,0,0,,Сен бізге немен қарап тұрсың?
Dialogue: 0,0:25:18.89,0:25:21.56,Default,,0,0,0,,Кім дұрыс деп ойладыңыз.
Dialogue: 0,0:25:21.64,0:25:24.14,Default,,0,0,0,,Бақыттың дұрыс жауабы бар болса...
Dialogue: 0,0:25:24.23,0:25:27.44,Default,,0,0,0,,Біз онша бос емеспіз.
Dialogue: 0,0:25:34.03,0:25:35.70,Default,,0,0,0,,) Неге жылайсың?
Dialogue: 0,0:25:35.78,0:25:37.82,Default,,0,0,0,,(Кішкентай Сузудың жылағаны)
Dialogue: 0,0:25:37.91,0:25:39.87,Default,,0,0,0,,Неге ештеңе айтпайсың?
Dialogue: 0,0:25:48.17,0:25:49.29,Default,,0,0,0,,Қоңырау
Dialogue: 0,0:25:51.13,0:25:52.46,Default,,0,0,0,,Шинобу-кун
Dialogue: 0,0:25:52.55,0:25:53.76,Default,,0,0,0,,Әке, қалыңыз қалай?
Dialogue: 0,0:25:53.84,0:25:55.97,Default,,0,0,0,,Ал... Ал, қалайсың?
Dialogue: 0,0:25:56.05,0:25:59.26,Default,,0,0,0,,Бұл не? Сузу, дұрыс тамақтанып жатырсың ба?
Dialogue: 0,0:25:59.35,0:26:00.51,Default,,0,0,0,,Мен... тамақтанып жатырмын.
Dialogue: 0,0:26:01.51,0:26:02.77,Default,,0,0,0,,А... (Шинобу) Бірдеңе болды ма?
Dialogue: 0,0:26:04.48,0:26:06.14,Default,,0,0,0,,Жоқ (Шиноби) Ол сонда болды, солай ма?
Dialogue: 0,0:26:06.44,0:26:08.35,Default,,0,0,0,,Менің бетіме қарашы.
Dialogue: 0,0:26:09.73,0:26:11.90,Default,,0,0,0,,Мен көрсете алмаймын (Шин) Жарайды.
Dialogue: 0,0:26:17.82,0:26:18.82,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:26:21.45,0:26:22.79,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:26:25.79,0:26:27.42,Default,,0,0,0,,Ха (Шин) Ах...
Dialogue: 0,0:26:28.00,0:26:29.00,Default,,0,0,0,,Қоңырау
Dialogue: 0,0:26:30.08,0:26:31.17,Default,,0,0,0,,Қоңырау!
Dialogue: 0,0:26:35.55,0:26:36.72,Default,,0,0,0,,Шинобу-кун
Dialogue: 0,0:26:36.80,0:26:40.05,Default,,0,0,0,,Мен бастауыш сыныптағы адамнан басқашамын.
Dialogue: 0,0:26:40.89,0:26:43.93,Default,,0,0,0,,Ол үнемі уайымдайтын бала емес.
Dialogue: 0,0:26:44.31,0:26:45.43,Default,,0,0,0,,…Өйткені жоқ
Dialogue: 0,0:27:15.09,0:27:18.26,Default,,0,0,0,,Келіңіздер, стандартты уақыт бойынша 20:25-ке таяп қалды.
Dialogue: 0,0:27:18.34,0:27:20.22,Default,,0,0,0,,Bell үшін ең үлкен тікелей шоу...
Dialogue: 0,0:27:20.30,0:27:23.14,Default,,0,0,0,,Бұл жерде U сфералық стадионында өтеді.
Dialogue: 0,0:27:23.22,0:27:25.35,Default,,0,0,0,,Әлемде бір уақытта қарап отырған As саны -
Dialogue: 0,0:27:25.43,0:27:28.02,Default,,0,0,0,,6 ай ішінде пайда болды, бұл жаңадан келген адам үшін әдеттен тыс.
Dialogue: 0,0:27:28.10,0:27:30.31,Default,,0,0,0,,100 миллион немесе 200 миллион... дейді.
Dialogue: 0,0:27:30.39,0:27:34.52,Default,,0,0,0,,Біз бәріміз оның басталатын сәтін тыныстап күтеміз.
Dialogue: 0,0:27:34.90,0:27:40.91,Default,,0,0,0,,(Астың қошеметі)
Dialogue: 0,0:27:41.20,0:27:47.20,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:28:52.31,0:28:53.52,Default,,0,0,0,,Рахмет
Dialogue: 0,0:29:26.93,0:29:32.98,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:29:33.23,0:29:35.02,Default,,0,0,0,,Келесі жолы барамын
Dialogue: 0,0:29:35.10,0:29:36.15,Default,,0,0,0,,Иә
Dialogue: 0,0:29:37.94,0:29:39.32,Default,,0,0,0,,Ах
Dialogue: 0,0:29:44.70,0:29:46.49,Default,,0,0,0,,Кім? Мен рұқсатсыз есікті аштым
Dialogue: 0,0:29:48.95,0:29:51.12,Default,,0,0,0,,Сыртқа шық, бейбақ. Сізді қуып жатыр ма?
Dialogue: 0,0:30:01.17,0:30:02.63,Default,,0,0,0,,Ол қазірдің өзінде кім?
Dialogue: 0,0:30:02.71,0:30:04.63,Default,,0,0,0,,Айдаһар (Ас) Бұл айдаһар.
Dialogue: 0,0:30:05.72,0:30:06.72,Default,,0,0,0,,«Айдаһар»?
Dialogue: 0,0:30:06.80,0:30:09.39,Default,,0,0,0,,Ұсқынсыз құбыжық типі АҚШ-та тұратын адам.
Dialogue: 0,0:30:13.85,0:30:14.85,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:30:14.93,0:30:18.44,Default,,0,0,0,,(Мүшелердің ыңырануы)
Dialogue: 0,0:30:19.15,0:30:20.86,Default,,0,0,0,,Ғажайып (Хирока сияқты) Сіз кімсіз?
Dialogue: 0,0:30:20.94,0:30:23.86,Default,,0,0,0,,Бірнеше ай бұрын ол кенеттен У-ның жауынгерлік өнер залында пайда болды.
Dialogue: 0,0:30:23.94,0:30:26.24,Default,,0,0,0,,бастап біз қатарынан жеңістер рекордын жаңартып келеміз.
Dialogue: 0,0:30:26.32,0:30:28.20,Default,,0,0,0,,Бірақ ұрыс стилі ең нашар
Dialogue: 0,0:30:28.28,0:30:29.28,Default,,0,0,0,,Қалай?
Dialogue: 0,0:30:31.41,0:30:34.91,Default,,0,0,0,,(Мүшелердің ыңырануы)
Dialogue: 0,0:30:35.58,0:30:36.83,Default,,0,0,0,,Жүр!
Dialogue: 0,0:30:38.46,0:30:41.88,Default,,0,0,0,,(Мүшелердің ыңырануы)
Dialogue: 0,0:30:42.25,0:30:43.55,Default,,0,0,0,,Матчты бұзу
Dialogue: 0,0:30:43.63,0:30:46.34,Default,,0,0,0,,Деректер бүлінген және жарамсыз болғанша шабуылдар
Dialogue: 0,0:30:46.42,0:30:48.34,Default,,0,0,0,,Ол басылған ашуын басуға тырысқандай.
Dialogue: 0,0:30:48.43,0:30:51.47,Default,,0,0,0,,Арқасындағы көгерген жерлерін көрсетіп тұрған тітіркендіргіш жігіт.
Dialogue: 0,0:30:51.76,0:30:55.31,Default,,0,0,0,,Сонымен... көгеріп кеткен.
Dialogue: 0,0:30:55.77,0:30:58.06,Default,,0,0,0,,Оххххх...
Dialogue: 0,0:30:58.14,0:30:59.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:00.15,0:31:01.19,Default,,0,0,0,,Уаааа
Dialogue: 0,0:31:05.28,0:31:06.61,Default,,0,0,0,,Сізді қуған адам ше?
Dialogue: 0,0:31:06.69,0:31:08.40,Default,,0,0,0,,Сот төрелігі Әділет?
Dialogue: 0,0:31:09.15,0:31:12.03,Default,,0,0,0,,У-ның әділдігі мен тәртібін қорғау туралы талаптар.
Dialogue: 0,0:31:12.12,0:31:14.58,Default,,0,0,0,,Хмм, бұл оны батырға ұқсатады.
Dialogue: 0,0:31:15.66,0:31:17.83,Default,,0,0,0,,Ах (мүшелер) Уау!
Dialogue: 0,0:31:18.21,0:31:20.71,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:31:22.71,0:31:27.97,Default,,0,0,0,,(Мүшелердің ыңырануы)
Dialogue: 0,0:31:29.01,0:31:30.43,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:31:32.80,0:31:34.35,Default,,0,0,0,,Қандай сұмдық...
Dialogue: 0,0:31:34.43,0:31:36.43,Default,,0,0,0,,Маған қатты ауырса не істеуім керек?
Dialogue: 0,0:31:36.52,0:31:38.10,Default,,0,0,0,,Мен өзіммен жақсы болғанша жақсы ма?
Dialogue: 0,0:31:38.60,0:31:39.60,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:31:39.69,0:31:41.65,Default,,0,0,0,,Беллдің жанды орындауын бұзу
Dialogue: 0,0:31:41.73,0:31:43.06,Default,,0,0,0,,Жауапкершілікті қалай аласың?
Dialogue: 0,0:31:43.15,0:31:45.11,Default,,0,0,0,,Беллден (Ас) кешірім сұра. Уақытымды қайтар.
Dialogue: 0,0:31:45.19,0:31:47.82,Default,,0,0,0,,Бұл жерден кет (Ас) бұл жерден кет.
Dialogue: 0,0:31:47.90,0:31:51.66,Default,,0,0,0,,(Қуанғандай)
Dialogue: 0,0:31:51.74,0:31:52.91,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:31:55.49,0:31:57.87,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:31:59.79,0:32:00.96,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:32:01.62,0:32:03.42,Default,,0,0,0,,Қарама, иә?
Dialogue: 0,0:32:03.96,0:32:06.50,Default,,0,0,0,,Маған қарама...
Dialogue: 0,0:32:10.26,0:32:11.30,Default,,0,0,0,,Айдаһар! Ха…
Dialogue: 0,0:32:12.38,0:32:15.55,Default,,0,0,0,,Мен сені енді кешіре алмаймын, мен сені ешқашан кешіре алмаймын
Dialogue: 0,0:32:16.10,0:32:19.31,Default,,0,0,0,,Айдаһар жеңілмейінше, U-дағы тыныштықты сақтау мүмкін емес.
Dialogue: 0,0:32:19.39,0:32:20.52,Default,,0,0,0,,Бұл көшбасшы ма?
Dialogue: 0,0:32:20.60,0:32:21.94,Default,,0,0,0,,Иә, ол Джастин.
Dialogue: 0,0:32:22.27,0:32:23.35,Default,,0,0,0,,Міне
Dialogue: 0,0:32:29.69,0:32:31.03,Default,,0,0,0,,Тааааа
Dialogue: 0,0:32:35.28,0:32:39.20,Default,,0,0,0,,Бұл У-ның әділдігі мен тәртібін қорғайтын шынайы нұр.
Dialogue: 0,0:32:39.29,0:32:43.33,Default,,0,0,0,,Біз зұлым айдаһарды міндетті түрде ашамыз.
Dialogue: 0,0:32:44.83,0:32:46.84,Default,,0,0,0,,Демеуші логотиптердің осы санын қараңыз.
Dialogue: 0,0:32:46.92,0:32:48.88,Default,,0,0,0,,Ашу? (Хироканың Асы) Ашу
Dialogue: 0,0:32:58.14,0:32:59.39,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:32:59.47,0:33:00.60,Default,,0,0,0,,Есік
Dialogue: 0,0:33:01.39,0:33:02.85,Default,,0,0,0,,Ой, не? Ах...
Dialogue: 0,0:33:08.73,0:33:10.32,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:33:14.86,0:33:16.37,Default,,0,0,0,,Сен енді қаша алмайсың, Рю.
Dialogue: 0,0:33:16.70,0:33:19.62,Default,,0,0,0,,Мен сенің ұсқынсыз шығу тегіңді дәл осы жерден ашамын.
Dialogue: 0,0:33:19.87,0:33:21.58,Default,,0,0,0,,Жақсы, келіңдер.
Dialogue: 0,0:33:23.41,0:33:26.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:26.71,0:33:32.72,Default,,0,0,0,,Джастин Джастин…
Dialogue: 0,0:33:39.14,0:33:40.14,Default,,0,0,0,,Жаса!
Dialogue: 0,0:33:40.51,0:33:41.60,Default,,0,0,0,,Уф аа
Dialogue: 0,0:33:43.52,0:33:46.19,Default,,0,0,0,,Я... (ату дыбысы)
Dialogue: 0,0:33:49.19,0:33:52.28,Default,,0,0,0,,Әлгі бейбақ, егер Белл жараланып қалса...
Dialogue: 0,0:33:59.03,0:34:03.70,Default,,0,0,0,,(Соққы дыбысы және ыңылау)
Dialogue: 0,0:34:06.96,0:34:12.96,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:34:18.34,0:34:21.68,Default,,0,0,0,,Мұндай нәрсеге жол беруге болмайды.
Dialogue: 0,0:34:28.31,0:34:30.86,Default,,0,0,0,,Оны әрқашан ашыңыз
Dialogue: 0,0:34:35.40,0:34:38.45,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:34:47.58,0:34:50.13,Default,,0,0,0,,Иә, мен барамын.
Dialogue: 0,0:34:50.71,0:34:53.09,Default,,0,0,0,,Сузу Кешкі ас ше?
Dialogue: 0,0:34:55.76,0:34:57.63,Default,,0,0,0,,Татаки жасаймыз ба?
Dialogue: 0,0:34:59.05,0:35:00.05,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:35:02.14,0:35:03.85,Default,,0,0,0,,Беллдің тікелей эфирден бас тартуы қызу тақырыпқа айналады
Dialogue: 0,0:35:04.22,0:35:06.64,Default,,0,0,0,,Ах... барлығын кешіріңіз.
Dialogue: 0,0:35:06.73,0:35:09.39,Default,,0,0,0,,А, а... а
Dialogue: 0,0:35:10.40,0:35:12.65,Default,,0,0,0,,Бұл…
Dialogue: 0,0:35:13.11,0:35:16.15,Default,,0,0,0,,Бұл Беллдің кінәсі емес. Бұл айдаһар, солай ма? Жаман
Dialogue: 0,0:35:16.24,0:35:18.20,Default,,0,0,0,,Мен олардың ашылуын қалаймын.
Dialogue: 0,0:35:18.28,0:35:20.36,Default,,0,0,0,,Неліктен адамдар сізді жек көретін нәрсені жасайсыз?
Dialogue: 0,0:35:20.45,0:35:22.03,Default,,0,0,0,,Жай ғана салқын болуға тырысамын, солай ма?
Dialogue: 0,0:35:22.12,0:35:23.70,Default,,0,0,0,,Мүмкін себебі бар шығар
Dialogue: 0,0:35:23.78,0:35:26.37,Default,,0,0,0,,Сіз бәрібір блеф жасап жатырсыз (Сузу) Менің ойымша.
Dialogue: 0,0:35:26.45,0:35:29.04,Default,,0,0,0,,Сонда бұл қандай адам? Қане жамылғыны ашайық.
Dialogue: 0,0:35:31.67,0:35:34.00,Default,,0,0,0,,Иә? Камишин рюкзактары үлкен емес пе?
Dialogue: 0,0:35:34.09,0:35:37.09,Default,,0,0,0,,Экспедиция жақында келе ме? Тағы бір рөл?
Dialogue: 0,0:35:37.17,0:35:38.88,Default,,0,0,0,,Оларды бір-біріне араластырмаңыз.
Dialogue: 0,0:35:41.13,0:35:42.64,Default,,0,0,0,,U As құрылғыны білдіреді...
Dialogue: 0,0:35:42.72,0:35:45.68,Default,,0,0,0,,Өйткені ол адамның үнемі сканерленетін биологиялық ақпаратымен байланысты.
Dialogue: 0,0:35:45.76,0:35:48.18,Default,,0,0,0,,Мысалы, сізде екі As болуы мүмкін емес деп есептеледі.
Dialogue: 0,0:35:48.27,0:35:49.27,Default,,0,0,0,,Иә
Dialogue: 0,0:35:49.60,0:35:51.69,Default,,0,0,0,,Оның үстіне мен интернеттен іздедім...
Dialogue: 0,0:35:51.77,0:35:55.07,Default,,0,0,0,,Оның жеті ай бұрын U жекпе-жек залына келгенінен басқа...
Dialogue: 0,0:35:55.15,0:35:58.40,Default,,0,0,0,,Ұлты Жасы Жынысы Басқа жазбалар жоқ
Dialogue: 0,0:35:58.49,0:35:59.95,Default,,0,0,0,,Сонда оны табудың жолы жоқ па?
Dialogue: 0,0:36:00.03,0:36:01.07,Default,,0,0,0,,Адамның өзі туралы.
Dialogue: 0,0:36:01.53,0:36:04.87,Default,,0,0,0,,Бірақ менде кімге қарсы ойнағаным туралы жазба бар.
Dialogue: 0,0:36:04.95,0:36:05.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:36:06.03,0:36:10.58,Default,,0,0,0,,Рюдің жеті айдағы рекорды – 369 жеңіс, 3 жеңіліс және 2 тең ойын.
Dialogue: 0,0:36:10.66,0:36:13.92,Default,,0,0,0,,Осы 374 қарсыластың көпшілігі...
Dialogue: 0,0:36:14.00,0:36:16.67,Default,,0,0,0,,U-ге байланысты SNS жалпыға қолжетімді
Dialogue: 0,0:36:17.09,0:36:20.30,Default,,0,0,0,,Әр адамды бір-бірден тыңдасақ, бірдеңені білуіміз мүмкін.
Dialogue: 0,0:36:23.76,0:36:26.39,Default,,0,0,0,,Пайдаланылған оқу бөлмесі
Dialogue: 0,0:36:26.85,0:36:27.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:29.35,0:36:30.52,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:36:30.60,0:36:31.60,Default,,0,0,0,,Су толқындары, олар кеткен жерге шабуыл жасаңдар
Dialogue: 0,0:36:33.23,0:36:35.81,Default,,0,0,0,,Айдаһарға қарсы ойнағандардың барлығына сұрағым бар.
Dialogue: 0,0:36:35.90,0:36:36.90,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:36:37.57,0:36:38.61,Default,,0,0,0,,Жұмбақ тіршілік
Dialogue: 0,0:36:38.69,0:36:40.15,Default,,0,0,0,,Әлбетте AI емес
Dialogue: 0,0:36:40.53,0:36:42.65,Default,,0,0,0,,Тынымсыз шабуыл жасау (As) ең нашар мінезге ие
Dialogue: 0,0:36:43.07,0:36:45.12,Default,,0,0,0,,Неге сонша... (Ас) Білмеймін
Dialogue: 0,0:36:45.20,0:36:47.37,Default,,0,0,0,,Мен сенің ең алғашқы қарсыласыңмын...
Dialogue: 0,0:36:47.45,0:36:49.41,Default,,0,0,0,,Менің денемде қазіргідей көгерген жерлер болған жоқ.
Dialogue: 0,0:36:49.75,0:36:51.62,Default,,0,0,0,,Сонымен, шайқастардың саны артты ма?
Dialogue: 0,0:36:51.71,0:36:54.42,Default,,0,0,0,,Біз бірнеше жеңімпаздарды сұраймыз
Dialogue: 0,0:36:54.50,0:36:56.88,Default,,0,0,0,,Неліктен айдаһарды жеңе алдың?
Dialogue: 0,0:36:57.38,0:36:58.63,Default,,0,0,0,,Кенет мен бірдеңе істеп жатқандай болдым.
Dialogue: 0,0:36:59.05,0:37:01.21,Default,,0,0,0,,Оның назарын басқа нәрсе аударғандай болды.
Dialogue: 0,0:37:02.80,0:37:03.80,Default,,0,0,0,,Әй, періште
Dialogue: 0,0:37:04.26,0:37:05.47,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:37:07.85,0:37:09.10,Default,,0,0,0,,Ах... (Хирока) Қазірдің өзінде
Dialogue: 0,0:37:09.39,0:37:11.10,Default,,0,0,0,,Өсек болса да, біреу біледі ме?
Dialogue: 0,0:37:11.18,0:37:12.98,Default,,0,0,0,,Келіңіз (Ас), бірақ ол жігіт те.
Dialogue: 0,0:37:13.06,0:37:14.94,Default,,0,0,0,,Сол жігіттің (Ас) туған белгісі ұқсас.
Dialogue: 0,0:37:15.02,0:37:16.06,Default,,0,0,0,,Who?
Dialogue: 0,0:37:21.74,0:37:25.32,Default,,0,0,0,,Аты-жөні - Джелинек Белгісіз заманауи суретші
Dialogue: 0,0:37:25.82,0:37:27.45,Default,,0,0,0,,Бүкіл денеде көгерген кескіндері бар татуировкалар.
Dialogue: 0,0:37:27.53,0:37:29.20,Default,,0,0,0,,Мен оны 6 ай бұрын қолдана бастадым.
Dialogue: 0,0:37:29.45,0:37:32.08,Default,,0,0,0,,Уақыт та айдаһарлардың пайда болуымен сәйкес келеді.
Dialogue: 0,0:37:32.16,0:37:35.42,Default,,0,0,0,,Содан бастап оның жұмысының бағасы кенет 20 есе өсті.
Dialogue: 0,0:37:35.83,0:37:36.88,Default,,0,0,0,,Ресми құжаттарды жариялаған екен.
Dialogue: 0,0:37:36.96,0:37:39.09,Default,,0,0,0,,Ах, менде агенттің байланыс ақпараты бар.
Dialogue: 0,0:37:39.17,0:37:40.17,Default,,0,0,0,,Ол сізге тікелей әсер етеді.
Dialogue: 0,0:37:40.25,0:37:42.01,Default,,0,0,0,,Иә? Шынайы ма? Эй, эй...
Dialogue: 0,0:37:43.97,0:37:45.18,Default,,0,0,0,,Әңгімелейтін ештеңе жоқ
Dialogue: 0,0:37:45.26,0:37:46.47,Default,,0,0,0,,Татуировкасы нені білдіреді?
Dialogue: 0,0:37:46.55,0:37:47.89,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:37:47.97,0:37:50.47,Default,,0,0,0,,Кеше түнде қайда және кіммен болдыңыз?
Dialogue: 0,0:37:50.56,0:37:52.06,Default,,0,0,0,,Қазіргі жағдайда оның барар жері жоқ.
Dialogue: 0,0:37:52.14,0:37:54.10,Default,,0,0,0,,Неге айта алмайсың? шулы!
Dialogue: 0,0:37:54.18,0:37:55.19,Default,,0,0,0,,(Байланыстың дыбысы өшіп жатыр)
Dialogue: 0,0:37:56.23,0:37:58.23,Default,,0,0,0,,Ол бірдеңені жасырып тұрғаны анық.
Dialogue: 0,0:38:01.98,0:38:04.24,Default,,0,0,0,,Сіз басқа біреуді ойлай аласыз ба? （Қандай）Келіңіз
Dialogue: 0,0:38:04.32,0:38:05.99,Default,,0,0,0,,Бірақ қасиеттері ұқсас басқалары да бар.
Dialogue: 0,0:38:06.07,0:38:07.74,Default,,0,0,0,,Сол сияқты тітіркендіргіш
Dialogue: 0,0:38:07.82,0:38:09.66,Default,,0,0,0,,Жарақат алғаныңызды бірден айтыңыз.
Dialogue: 0,0:38:09.74,0:38:11.16,Default,,0,0,0,,Бұл ол болуы мүмкін.
Dialogue: 0,0:38:11.41,0:38:12.41,Default,,0,0,0,,Әйелдер?
Dialogue: 0,0:38:12.62,0:38:14.75,Default,,0,0,0,,Сол күні туған күн кеші болды.
Dialogue: 0,0:38:14.83,0:38:17.37,Default,,0,0,0,,Туған күн кеші? Иә, бұл менің күйеуімдікі.
Dialogue: 0,0:38:17.46,0:38:18.71,Default,,0,0,0,,Дайындау қиын болды, бірақ...
Dialogue: 0,0:38:18.79,0:38:21.46,Default,,0,0,0,,Торт пісіруге қыздарым да көмектесті...
Dialogue: 0,0:38:21.55,0:38:23.59,Default,,0,0,0,,Ааа, мен қазір инстаграмды қарап отырмын.
Dialogue: 0,0:38:23.67,0:38:24.67,Default,,0,0,0,,О.
Dialogue: 0,0:38:24.76,0:38:26.43,Default,,0,0,0,,Біз жақын отбасымыз.
Dialogue: 0,0:38:26.51,0:38:27.80,Default,,0,0,0,,Бірақ бұл дұрыс па?
Dialogue: 0,0:38:27.88,0:38:31.35,Default,,0,0,0,,«Идеал үй шаруасындағы әйел» деген тақырыпта сұхбат алғаныма сене алар емеспін...
Dialogue: 0,0:38:31.43,0:38:35.02,Default,,0,0,0,,Жоқ, оқырмандар да өз қуаныштарымен бөліссе екен деймін.
Dialogue: 0,0:38:35.10,0:38:38.06,Default,,0,0,0,,Мәліметтер шешілгеннен кейін біз сізге хабарласамыз.
Dialogue: 0,0:38:38.15,0:38:40.23,Default,,0,0,0,,Ол мүлдем қауіпті адамға ұқсамайтын.
Dialogue: 0,0:38:40.48,0:38:43.57,Default,,0,0,0,,Енді оның айтқанының бәрі өтірік болды. Менің күйеуім де, қызым да жоқ.
Dialogue: 0,0:38:43.65,0:38:45.15,Default,,0,0,0,,Торт та жеткізілді (Рин) Иә.
Dialogue: 0,0:38:45.49,0:38:46.78,Default,,0,0,0,,Үйдің алдындағы жанды камера-
Dialogue: 0,0:38:46.86,0:38:49.74,Default,,0,0,0,,Мен бірнеше ай бойы Amazon мен Uber Eats-тен басқа ештеңе көрмедім.
Dialogue: 0,0:38:49.82,0:38:53.08,Default,,0,0,0,,SNS желісіндегі барлық фотосуреттер акция фотосуреттерінен сатып алынды.
Dialogue: 0,0:38:53.70,0:38:55.79,Default,,0,0,0,,Бұл да, бұл да
Dialogue: 0,0:38:55.87,0:38:58.29,Default,,0,0,0,,Бұл қауіпті. Неге бұлай істеп жатырсың?
Dialogue: 0,0:38:58.37,0:39:00.83,Default,,0,0,0,,Әліби және агрессивтілік жоқ
Dialogue: 0,0:39:00.92,0:39:04.09,Default,,0,0,0,,Егер бұл жазу сол туу белгісіне қатысты болса...
Dialogue: 0,0:39:04.88,0:39:06.84,Default,,0,0,0,,Ол айдаһар
Dialogue: 0,0:39:10.09,0:39:11.51,Default,,0,0,0,,Хмм.
Dialogue: 0,0:39:13.56,0:39:15.97,Default,,0,0,0,,Биылғы Дүниежүзілік серияға да қатысты.
Dialogue: 0,0:39:16.06,0:39:18.23,Default,,0,0,0,,MLB slugger Fox
Dialogue: 0,0:39:18.31,0:39:20.02,Default,,0,0,0,,Ол өте танымал, бірақ-
Dialogue: 0,0:39:20.10,0:39:22.81,Default,,0,0,0,,Ол шынымен қорқынышты құпияны жасырып жатыр деген қауесет бар.
Dialogue: 0,0:39:22.90,0:39:23.90,Default,,0,0,0,,Сыбыс?
Dialogue: 0,0:39:23.98,0:39:25.61,Default,,0,0,0,,Ол әрқашан джентльмен болды, бірақ...
Dialogue: 0,0:39:25.69,0:39:28.32,Default,,0,0,0,,Олар бұл масканың астында зорлықшыл адамның беті бар дейді.
Dialogue: 0,0:39:28.40,0:39:30.45,Default,,0,0,0,,Жаттығу кезінде де күртешесін ешқашан шешпейді...
Dialogue: 0,0:39:30.53,0:39:33.16,Default,,0,0,0,,Өйткені астында көптеген үлкен тыртықтар бар.
Dialogue: 0,0:39:33.53,0:39:37.16,Default,,0,0,0,,Әрбір танымал адамның артында әрқашан бір құпия бар...
Dialogue: 0,0:39:37.25,0:39:40.83,Default,,0,0,0,,Бұл бізді әр уақытта қатты көңілсіз қалдырады.
Dialogue: 0,0:39:46.51,0:39:49.13,Default,,0,0,0,,Дәл қазір балалар арасында өте танымал As бар.
Dialogue: 0,0:39:57.72,0:40:00.02,Default,,0,0,0,,Айдаһардың жасырынған жері «қамал» деп аталады.
Dialogue: 0,0:40:00.10,0:40:02.65,Default,,0,0,0,,«Қамалды» кім бірінші таба алатынын байқау
Dialogue: 0,0:40:02.73,0:40:04.15,Default,,0,0,0,,Мен оны тапқан кезде не істеуім керек?
Dialogue: 0,0:40:04.23,0:40:06.78,Default,,0,0,0,,Бірге суретке түсу (Камилл) Қол алысу
Dialogue: 0,0:40:06.86,0:40:07.98,Default,,0,0,0,,Ол жаман адам, солай ма?
Dialogue: 0,0:40:08.07,0:40:09.49,Default,,0,0,0,,Жаман адам болу керемет
Dialogue: 0,0:40:09.57,0:40:11.40,Default,,0,0,0,,Сөйлеспесем де, күштімін
Dialogue: 0,0:40:11.49,0:40:12.78,Default,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,0:40:12.86,0:40:16.70,Default,,0,0,0,,Айдаһар менің... батырым.
Dialogue: 0,0:40:17.70,0:40:19.04,Default,,0,0,0,,Батыр…
Dialogue: 0,0:40:21.41,0:40:23.96,Default,,0,0,0,,Иә, біз үш адамнан тұратын отбасымыз.
Dialogue: 0,0:40:24.04,0:40:27.21,Default,,0,0,0,,Олар өте жақын достар, анасы болмаса да энергияға толы.
Dialogue: 0,0:40:27.75,0:40:31.05,Default,,0,0,0,,Біз бір-бірімізге қолдау көрсетіп, әр күнді қызықты өткізе аламыз...
Dialogue: 0,0:40:33.93,0:40:36.01,Default,,0,0,0,,Рю екеуміз бұрыннан нашар доспыз.
Dialogue: 0,0:40:36.26,0:40:37.97,Default,,0,0,0,,Біз өте жақсы араласамыз.
Dialogue: 0,0:40:38.22,0:40:40.81,Default,,0,0,0,,Негізінде айдаһарлар өте бай.
Dialogue: 0,0:40:40.89,0:40:42.85,Default,,0,0,0,,Керемет сарай туралы білгіңіз келсе...
Dialogue: 0,0:40:42.94,0:40:44.86,Default,,0,0,0,,Қалағаныңызша көп басыңыз
Dialogue: 0,0:40:44.94,0:40:46.69,Default,,0,0,0,,Рю деген кім?
Dialogue: 0,0:40:47.27,0:40:48.40,Default,,0,0,0,,Who?
Dialogue: 0,0:40:48.94,0:40:50.36,Default,,0,0,0,,Айдаһардың шынайы тұлғасы қандай?
Dialogue: 0,0:40:50.44,0:40:51.82,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:40:57.70,0:41:00.29,Default,,0,0,0,,Цуцуйдің әжесі: Күріш және екі гарнир.
Dialogue: 0,0:41:00.62,0:41:02.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:41:02.62,0:41:05.04,Default,,0,0,0,,Бұл пиар деген негізсіз қауесет.
Dialogue: 0,0:41:05.13,0:41:09.17,Default,,0,0,0,,Жақын адамымды жазатайым оқиғадан жоғалттым және әлі де қатты қайғырамын.
Dialogue: 0,0:41:09.25,0:41:12.26,Default,,0,0,0,,Мен ғашығымның тыртығына татуировканы салдым.
Dialogue: 0,0:41:12.67,0:41:13.68,Default,,0,0,0,,Иә
Dialogue: 0,0:41:13.76,0:41:16.34,Default,,0,0,0,,Әркімнің ешкімге айта алмайтын сыры бар.
Dialogue: 0,0:41:16.43,0:41:17.51,Default,,0,0,0,,Құттықтаймыз
Dialogue: 0,0:41:17.60,0:41:20.93,Default,,0,0,0,,Бұдан да үлкен құпия бар.
Dialogue: 0,0:41:21.02,0:41:22.10,Default,,0,0,0,,күдікті
Dialogue: 0,0:41:22.18,0:41:26.06,Default,,0,0,0,,Бұл анық. Мәселе мынада, сіз шынымен нені жасырасыз?
Dialogue: 0,0:41:26.15,0:41:27.86,Default,,0,0,0,,Әр адамның сыры бар
Dialogue: 0,0:41:27.94,0:41:29.07,Default,,0,0,0,,Сузу да солай.
Dialogue: 0,0:41:29.15,0:41:30.57,Default,,0,0,0,,Тіпті Хиро-чан (Хирока) Мен бе?
Dialogue: 0,0:41:30.65,0:41:32.07,Default,,0,0,0,,Құпиялар жоқ
Dialogue: 0,0:41:32.15,0:41:34.78,Default,,0,0,0,,Өйткені Хиро-чанның смартфоны күту режимінде...
Dialogue: 0,0:41:34.86,0:41:36.66,Default,,0,0,0,,Доктор Терада Физика (Хирока) Чочочо...
Dialogue: 0,0:41:36.74,0:41:38.16,Default,,0,0,0,,Осы жерде тоқтаңыз.
Dialogue: 0,0:41:38.24,0:41:40.08,Default,,0,0,0,,Иә Күріш және гарнир
Dialogue: 0,0:41:41.04,0:41:43.21,Default,,0,0,0,,Бол... Әсіресе мұғалімнің көзқарасы бойынша...
Dialogue: 0,0:41:43.29,0:41:45.50,Default,,0,0,0,,Мен жол жиегіндегі таспын
Dialogue: 0,0:41:46.21,0:41:48.46,Default,,0,0,0,,Ешқашан анаңызға немесе әкеңізге айтпаңыз.
Dialogue: 0,0:41:48.54,0:41:51.05,Default,,0,0,0,,Себебі сен менің жақсы қыз екеніме сенесің.
Dialogue: 0,0:41:51.13,0:41:52.17,Default,,0,0,0,,Мен оны айтпаймын
Dialogue: 0,0:41:52.46,0:41:55.55,Default,,0,0,0,,Егер анам білсе, көпіршіктерге жарылып өлуі мүмкін.
Dialogue: 0,0:41:55.63,0:41:57.59,Default,,0,0,0,,Өткен күні...
Dialogue: 0,0:41:58.68,0:41:59.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:01.72,0:42:03.60,Default,,0,0,0,,Кешіріңіз (қоңырау) Мм.
Dialogue: 0,0:42:03.93,0:42:04.94,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:42:05.27,0:42:06.31,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:42:06.39,0:42:08.81,Default,,0,0,0,,Хиро-чан, әке-шешеңмен...
Dialogue: 0,0:42:08.90,0:42:11.32,Default,,0,0,0,,Мен сені айтып жатыр деп ойладым.
Dialogue: 0,0:42:11.61,0:42:12.65,Default,,0,0,0,,Кері
Dialogue: 0,0:42:12.73,0:42:14.95,Default,,0,0,0,,Анам қайтыс болса да, әкеммен жалғыз қалдым...
Dialogue: 0,0:42:15.70,0:42:17.70,Default,,0,0,0,,Мен үйде әрең сөйлесемін
Dialogue: 0,0:42:21.16,0:42:23.91,Default,,0,0,0,,Білемін, сол себепті кездесіп жүрміз.
Dialogue: 0,0:42:29.25,0:42:31.29,Default,,0,0,0,,Жүр, көңіліңді түсірме, тамақ іш.
Dialogue: 0,0:42:31.38,0:42:33.59,Default,,0,0,0,,Әже 2 кеспе қосты
Dialogue: 0,0:42:33.67,0:42:34.92,Default,,0,0,0,,Иә.
Dialogue: 0,0:42:54.94,0:42:57.11,Default,,0,0,0,,Осындай қирандыларда шынымен де «қамал» бар ма?
Dialogue: 0,0:42:57.20,0:42:58.61,Default,,0,0,0,,Бұл жолы күмән жоқ
Dialogue: 0,0:42:58.70,0:43:00.49,Default,,0,0,0,,Онда неге менімен келмейсің?
Dialogue: 0,0:43:00.57,0:43:02.20,Default,,0,0,0,,Профессор Тераданың қосымша дәрісі.
Dialogue: 0,0:43:02.28,0:43:03.74,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:43:07.83,0:43:09.42,Default,,0,0,0,,Сіз бірдеңе іздеп жүрсіз бе?
Dialogue: 0,0:43:09.50,0:43:11.54,Default,,0,0,0,,А... кім?
Dialogue: 0,0:43:11.63,0:43:14.84,Default,,0,0,0,,Мен интеллектпін, мен бәрін түсінемін
Dialogue: 0,0:43:14.92,0:43:16.17,Default,,0,0,0,,Құлып іздеп жүрсіз бе?
Dialogue: 0,0:43:16.26,0:43:17.59,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:43:17.67,0:43:18.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:21.26,0:43:23.51,Default,,0,0,0,,А... міне?
Dialogue: 0,0:43:26.85,0:43:27.85,Default,,0,0,0,,Ах
Dialogue: 0,0:43:28.06,0:43:29.64,Default,,0,0,0,,Көмек керек пе?
Dialogue: 0,0:43:29.73,0:43:31.27,Default,,0,0,0,,Қамал іздеп жүрсіз бе?
Dialogue: 0,0:43:31.35,0:43:34.94,Default,,0,0,0,,Мен солай ойладым. Мен саған ғана айтамын.
Dialogue: 0,0:43:45.79,0:43:48.04,Default,,0,0,0,,Көмек керек пе? иә?
Dialogue: 0,0:43:48.71,0:43:52.92,Default,,0,0,0,,Қамалдың орны, солай ма? Басқа ешкімге айтпа
Dialogue: 0,0:43:53.34,0:43:54.46,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:43:55.34,0:43:59.30,Default,,0,0,0,,А, қайда, мен ештеңе көрмеймін... Ах.
Dialogue: 0,0:43:59.67,0:44:01.97,Default,,0,0,0,,Сен ақымақсың. Сен мені алдадың. иә?
Dialogue: 0,0:44:02.76,0:44:05.39,Default,,0,0,0,,Сонда сіз оны ешқашан таба алмайсыз.
Dialogue: 0,0:44:05.60,0:44:07.56,Default,,0,0,0,,Оның орнына менімен ойнайық.
Dialogue: 0,0:44:07.64,0:44:10.19,Default,,0,0,0,,Жүр, менің артымнан осы жолмен жүр.
Dialogue: 0,0:44:21.95,0:44:22.95,Default,,0,0,0,,Құлып…
Dialogue: 0,0:44:28.95,0:44:30.33,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:44:30.41,0:44:31.54,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:44:34.04,0:44:35.34,Default,,0,0,0,,Неге кірдің?
Dialogue: 0,0:44:35.42,0:44:36.84,Default,,0,0,0,,Мен сенің жолыңа бөгет болдым.
Dialogue: 0,0:44:40.59,0:44:43.26,Default,,0,0,0,,Мен не істеуім керек? (Су перісі А.И.) Қожайыным маған ұрысады.
Dialogue: 0,0:44:44.76,0:44:45.85,Default,,0,0,0,,Ах
Dialogue: 0,0:44:51.06,0:44:52.06,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:44:52.14,0:44:54.73,Default,,0,0,0,,Мен өсірген құпия раушан
Dialogue: 0,0:44:55.44,0:44:56.48,Default,,0,0,0,,Құпия?
Dialogue: 0,0:44:57.57,0:44:59.90,Default,,0,0,0,,Құпия деген не?
Dialogue: 0,0:45:01.11,0:45:02.95,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:45:03.61,0:45:05.87,Default,,0,0,0,,Ах
Dialogue: 0,0:45:06.91,0:45:08.41,Default,,0,0,0,,Ах (Рю) Неге рұқсатсыз кірдің?
Dialogue: 0,0:45:08.49,0:45:10.75,Default,,0,0,0,,Ол... басшылыққа ала ма...
Dialogue: 0,0:45:10.83,0:45:12.41,Default,,0,0,0,,Шығу.
Dialogue: 0,0:45:12.50,0:45:14.87,Default,,0,0,0,,Бірақ... (Рю) Шық!
Dialogue: 0,0:45:19.00,0:45:20.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:21.01,0:45:22.01,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:45:22.17,0:45:24.97,Default,,0,0,0,,Негізі сізден сұрайын дегенім бар еді.
Dialogue: 0,0:45:25.18,0:45:26.18,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:45:27.01,0:45:28.01,Default,,0,0,0,,Эй
Dialogue: 0,0:45:28.56,0:45:29.89,Default,,0,0,0,,Әй, маған жауап бер.
Dialogue: 0,0:45:29.97,0:45:32.39,Default,,0,0,0,,Сен кетпесең... Мен сені жаншып аламын!
Dialogue: 0,0:45:34.14,0:45:35.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:40.11,0:45:43.74,Default,,0,0,0,,Кун… Кун…
Dialogue: 0,0:45:44.53,0:45:45.99,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:45:50.12,0:45:52.87,Default,,0,0,0,,Кун… Кун…
Dialogue: 0,0:45:57.25,0:45:58.25,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:45:59.54,0:46:00.67,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:46:05.51,0:46:08.26,Default,,0,0,0,,Ақаулық бар ма? Эй, қиындық па?
Dialogue: 0,0:46:08.34,0:46:09.89,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:46:10.60,0:46:12.64,Default,,0,0,0,,Қазір бәрі жақсы
Dialogue: 0,0:46:14.14,0:46:15.14,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:46:16.56,0:46:19.48,Default,,0,0,0,,Сіздің шынайы формаңыз қандай?
Dialogue: 0,0:46:26.45,0:46:27.45,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:46:29.07,0:46:30.66,Default,,0,0,0,,Күте тұрыңыз... О.
Dialogue: 0,0:46:40.88,0:46:42.21,Default,,0,0,0,,Сузу ғашық
Dialogue: 0,0:46:42.50,0:46:45.09,Default,,0,0,0,,Ах... (Накай) Бұл да жаман жігіт сияқты.
Dialogue: 0,0:46:45.51,0:46:47.34,Default,,0,0,0,,Жоқ, жоқ, неге...
Dialogue: 0,0:46:47.43,0:46:49.22,Default,,0,0,0,,Бұл сіздің бетіңізде (қоңырау) Ах!
Dialogue: 0,0:46:49.64,0:46:52.18,Default,,0,0,0,,Өйткені орта және жоғары сынып оқушылары жаман адамдарды жақсы көреді.
Dialogue: 0,0:46:52.26,0:46:54.22,Default,,0,0,0,,Ол шынымен мейірімді және жалғыз ма?
Dialogue: 0,0:46:54.31,0:46:56.43,Default,,0,0,0,,Мен ғана түсінемін.
Dialogue: 0,0:46:57.02,0:46:58.73,Default,,0,0,0,,Сондықтан басқаша (Ёшия мен оның достары күледі)
Dialogue: 0,0:46:59.02,0:47:00.69,Default,,0,0,0,,Сізге сыйлық беруім керек пе?
Dialogue: 0,0:47:00.77,0:47:01.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:02.19,0:47:05.40,Default,,0,0,0,,Мен орта мектептің үшінші курс студенті кезімде Огайо штатында шетелде оқыдым.
Dialogue: 0,0:47:05.49,0:47:07.99,Default,,0,0,0,,Әрқашан жалғыз, жалғыз көрінетін.
Dialogue: 0,0:47:08.07,0:47:10.32,Default,,0,0,0,,Өткір көзі бар бала болды.
Dialogue: 0,0:47:10.41,0:47:12.41,Default,,0,0,0,,О, жалғыз қасқыр түрі?
Dialogue: 0,0:47:12.49,0:47:14.62,Default,,0,0,0,,Мен оған біраз қызық болдым, сондықтан...
Dialogue: 0,0:47:14.70,0:47:17.25,Default,,0,0,0,,«Мен саған туған күніңе сыйлық беремін» деп айт.
Dialogue: 0,0:47:17.33,0:47:18.62,Default,,0,0,0,,Маған не бердіңіз?
Dialogue: 0,0:47:18.71,0:47:19.71,Default,,0,0,0,,Ән
Dialogue: 0,0:47:19.79,0:47:20.88,Default,,0,0,0,,Ән?
Dialogue: 0,0:47:20.96,0:47:24.34,Default,,0,0,0,,Мен оның алдында мерекелік ән жазып, орындадым.
Dialogue: 0,0:47:24.92,0:47:26.88,Default,,0,0,0,,Ғажайып (Кита) махаббат әні
Dialogue: 0,0:47:26.97,0:47:28.51,Default,,0,0,0,,Ол ешқашан күлмейді...
Dialogue: 0,0:47:28.59,0:47:30.89,Default,,0,0,0,,Сол кезде күліп, қуанып қалдың.
Dialogue: 0,0:47:30.97,0:47:32.80,Default,,0,0,0,,Сіз кездестірдіңіз бе? (Хатанака) Мүмкін емес.
Dialogue: 0,0:47:32.89,0:47:33.89,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:47:33.97,0:47:36.27,Default,,0,0,0,,Өйткені ол бала әлі орта мектептің екінші курсында оқитын.
Dialogue: 0,0:47:36.35,0:47:37.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:47:37.64,0:47:40.60,Default,,0,0,0,,Сене алар емеспін (Накай) Бұл орта мектептің 2-ші жылы.
Dialogue: 0,0:47:40.69,0:47:42.06,Default,,0,0,0,,Бірақ мен үйге оралғанда...
Dialogue: 0,0:47:42.15,0:47:45.23,Default,,0,0,0,,Әуежайда жылағаныңа қуаныштымын.
Dialogue: 0,0:47:47.65,0:47:50.20,Default,,0,0,0,,Мен ешқашан махаббат туралы ән жазған емеспін, бірақ...
Dialogue: 0,0:47:55.66,0:47:58.87,Default,,0,0,0,,♪ ла ла ла ла ла ла
Dialogue: 0,0:47:58.96,0:48:03.25,Default,,0,0,0,,♪ Ла ла ла ла ла ла ла ла ла ла
Dialogue: 0,0:48:18.98,0:48:21.10,Default,,0,0,0,,♪ Hito...
Dialogue: 0,0:48:22.52,0:48:25.52,Default,,0,0,0,,♪ Ri… ni…
Dialogue: 0,0:48:25.61,0:48:28.82,Default,,0,0,0,,♪ Мен сізге...
Dialogue: 0,0:48:30.28,0:48:32.28,Default,,0,0,0,,♪ Бұл...
Dialogue: 0,0:48:33.11,0:48:36.62,Default,,0,0,0,,♪ Сіз...
Dialogue: 0,0:48:37.49,0:48:42.17,Default,,0,0,0,,♪ Мен мойындаймын, бірақ
Dialogue: 0,0:48:43.04,0:48:47.59,Default,,0,0,0,,♪ Бұл менің кеудемде...
Dialogue: 0,0:48:49.17,0:48:53.51,Default,,0,0,0,,♪ ...шаяндағы бірдеңе
Dialogue: 0,0:48:56.89,0:49:01.73,Default,,0,0,0,,♪ Мен ешкімнің қарағанын қаламаймын...
Dialogue: 0,0:49:01.81,0:49:07.07,Default,,0,0,0,,♪ ... солай емес пе?
Dialogue: 0,0:49:12.24,0:49:13.74,Default,,0,0,0,,Жазу керек пе?
Dialogue: 0,0:49:16.62,0:49:17.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:18.12,0:49:19.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:21.16,0:49:22.75,Default,,0,0,0,,Бұл қандай сан?
Dialogue: 0,0:49:24.75,0:49:26.63,Default,,0,0,0,,Мен Шинобу деген баламен қол ұстасып отырдым.
Dialogue: 0,0:49:26.71,0:49:28.67,Default,,0,0,0,,Сіз өзіңізді көрсетіп жатырсыз ба? (Қыз) Неге ол қыз?
Dialogue: 0,0:49:28.75,0:49:29.96,Default,,0,0,0,,Бала күнгі досы
Dialogue: 0,0:49:30.05,0:49:31.71,Default,,0,0,0,,Бұл менің кез келген нәрсені істеуге рұқсатымды білдіре ме?
Dialogue: 0,0:49:31.80,0:49:33.68,Default,,0,0,0,,Ойынның шыңында тұрған әйел ретінде танылды
Dialogue: 0,0:49:33.76,0:49:35.26,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:49:37.05,0:49:38.39,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:49:38.47,0:49:39.68,Default,,0,0,0,,Сузу (Сузу) Хиро-чан
Dialogue: 0,0:49:39.76,0:49:41.81,Default,,0,0,0,,Сіз Шинобуға мойындадыңыз ба?
Dialogue: 0,0:49:41.89,0:49:43.27,Default,,0,0,0,,Мен болмады. (Хирока) Сен бе?
Dialogue: 0,0:49:43.35,0:49:45.27,Default,,0,0,0,,Бұлай болмайды (Хирока) Сонда неге...
Dialogue: 0,0:49:45.56,0:49:47.27,Default,,0,0,0,,Тек қолдарыңыз...
Dialogue: 0,0:49:47.36,0:49:48.36,Default,,0,0,0,,Сіз оны қостыңыз ба?
Dialogue: 0,0:49:48.44,0:49:50.36,Default,,0,0,0,,Қосылмады, жай ғана ұсталды
Dialogue: 0,0:49:50.44,0:49:51.48,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:49:51.57,0:49:54.49,Default,,0,0,0,,Бірақ бұл от, Шинобу-кун, ғажап.
Dialogue: 0,0:49:54.57,0:49:56.82,Default,,0,0,0,,Біздің қаншалықты саналы екеніміз дәлелденді.
Dialogue: 0,0:49:56.91,0:49:58.57,Default,,0,0,0,,Мен ештеңе істеген жоқпын
Dialogue: 0,0:49:58.66,0:50:01.24,Default,,0,0,0,,Бұл ұшқын көп жерге тарады.
Dialogue: 0,0:50:01.33,0:50:03.62,Default,,0,0,0,,Ренжіген балалар мен сыйлай алмағандықтан тітіркенген балалар.
Dialogue: 0,0:50:03.71,0:50:07.00,Default,,0,0,0,,Біз ұстап тұруға және бақылауға тырысқанның бәрі кенеттен жарылып кеткендей болды.
Dialogue: 0,0:50:07.08,0:50:09.42,Default,,0,0,0,,Бұл өте қорқынышты, қорқынышты.
Dialogue: 0,0:50:09.50,0:50:12.34,Default,,0,0,0,,Міне... бәрі жақсы араласты.
Dialogue: 0,0:50:12.42,0:50:14.09,Default,,0,0,0,,Адамдардың әр түрі бар, байыпты.
Dialogue: 0,0:50:14.17,0:50:16.09,Default,,0,0,0,,Әркім өзінің шынайы тұлғасын көрсете берсе...
Dialogue: 0,0:50:16.18,0:50:17.59,Default,,0,0,0,,Бұл жан-жақты соғыс.
Dialogue: 0,0:50:17.68,0:50:19.10,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:50:19.80,0:50:20.89,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:50:20.97,0:50:23.98,Default,,0,0,0,,Бұл – сахнаның ар жағындағы сын жолы, мен соғып, шайқаймын.
Dialogue: 0,0:50:24.06,0:50:26.64,Default,,0,0,0,,Сузу ертегіні түсінген балалардың түсінбестіктерін жояды.
Dialogue: 0,0:50:26.73,0:50:27.98,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:50:28.90,0:50:30.02,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:50:30.65,0:50:31.82,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:50:32.57,0:50:34.40,Default,,0,0,0,,Мен сияқты біреудің сенімен кездесуі мүмкін емес.
Dialogue: 0,0:50:34.49,0:50:35.49,Default,,0,0,0,,Әрине
Dialogue: 0,0:50:35.57,0:50:38.49,Default,,0,0,0,,Барлығың тынышталыңдар. (Қыздар) Тынышталыңыз.
Dialogue: 0,0:50:42.45,0:50:45.25,Default,,0,0,0,,Жуынатын бөлмеде біреу бар ма? Меніңше, ол Хаято еді.
Dialogue: 0,0:50:45.33,0:50:46.33,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:50:46.79,0:50:49.75,Default,,0,0,0,,Гувах хаа...
Dialogue: 0,0:50:49.83,0:50:51.54,Default,,0,0,0,,Жолбарыстың аузынан құтылдым.
Dialogue: 0,0:50:51.63,0:50:54.01,Default,,0,0,0,,Менің аяғым шынында «сырс» етті!—
Dialogue: 0,0:50:54.30,0:50:56.05,Default,,0,0,0,,Дүние қатал, солай емес пе?
Dialogue: 0,0:50:56.13,0:50:59.09,Default,,0,0,0,,Құпия қыз Сузу өз сезімін мойындаса, жанжал шығады...
Dialogue: 0,0:50:59.18,0:51:00.97,Default,,0,0,0,,Бұл Лука-чан болса, ештеңе болмайды...
Dialogue: 0,0:51:01.05,0:51:03.18,Default,,0,0,0,,Бейбітшілік орнайды.
Dialogue: 0,0:51:03.43,0:51:04.68,Default,,0,0,0,,(хабарламаны қабылдау дыбысы)
Dialogue: 0,0:51:04.77,0:51:06.60,Default,,0,0,0,,Аа, бұл Лука-чаннан.
Dialogue: 0,0:51:07.02,0:51:10.31,Default,,0,0,0,,«Мен кенеттен кешірім сұраймын, бірақ мен кеңес бердім және шын мәнінде ...»
Dialogue: 0,0:51:10.40,0:51:11.65,Default,,0,0,0,,Бұл уақытында.
Dialogue: 0,0:51:11.73,0:51:13.82,Default,,0,0,0,,Маған қазір осылай хаттар жіберіп жатқаныңыз біртүрлі емес пе?
Dialogue: 0,0:51:14.40,0:51:15.53,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,0:51:15.61,0:51:17.78,Default,,0,0,0,,Бәлкім, олар сахнаның артындағы жіптерді тартып жатқан шығар.
Dialogue: 0,0:51:17.86,0:51:19.28,Default,,0,0,0,,Мүлдем жоқ.
Dialogue: 0,0:51:19.70,0:51:21.62,Default,,0,0,0,,Сіз Шинобуға ұмтыласыз ба?
Dialogue: 0,0:51:21.70,0:51:24.45,Default,,0,0,0,,Неге Рука сияқты сүйкімді қыз мұндай әрекетке барады?
Dialogue: 0,0:51:24.54,0:51:26.58,Default,,0,0,0,,Бұл баланың маған ұнамайтыны.
Dialogue: 0,0:51:27.12,0:51:29.54,Default,,0,0,0,,Мен жай ғана сұрағым келді, өйткені біз бала кезден доспыз.
Dialogue: 0,0:51:29.62,0:51:32.54,Default,,0,0,0,,Мен болсам, ақыл сұрайтын жасқа жетпес едім.
Dialogue: 0,0:51:37.09,0:51:39.01,Default,,0,0,0,,А, мені бірдеңе мазалайды.
Dialogue: 0,0:51:39.09,0:51:41.55,Default,,0,0,0,,Ах
Dialogue: 0,0:51:52.06,0:51:53.69,Default,,0,0,0,,Камишин, сен көп жұмыс істеп жатырсың.
Dialogue: 0,0:51:53.77,0:51:56.03,Default,,0,0,0,,О, сіз өте жақсы орындайсыз.
Dialogue: 0,0:51:59.82,0:52:00.82,Default,,0,0,0,,Шинобу-кун
Dialogue: 0,0:52:00.91,0:52:03.32,Default,,0,0,0,,Ол мені күтті, бірақ ол ешқашан келмейді.
Dialogue: 0,0:52:07.33,0:52:09.58,Default,,0,0,0,,Сузу, бүгін бірдеңе болды ма?
Dialogue: 0,0:52:11.75,0:52:13.25,Default,,0,0,0,,Бар болса айтыңызшы.
Dialogue: 0,0:52:16.46,0:52:17.80,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:52:17.88,0:52:21.26,Default,,0,0,0,,Мен Шинобудан бір нәрсе сұрайын деп жүргенмін.
Dialogue: 0,0:52:22.13,0:52:23.26,Default,,0,0,0,,Не?
Dialogue: 0,0:52:23.47,0:52:24.55,Default,,0,0,0,,Ум...
Dialogue: 0,0:52:26.06,0:52:28.10,Default,,0,0,0,,Мм... мм...
Dialogue: 0,0:52:29.60,0:52:30.60,Default,,0,0,0,,Ум...
Dialogue: 0,0:52:30.69,0:52:32.77,Default,,0,0,0,,Сузу-чан, қазір үйге барасың ба?
Dialogue: 0,0:52:32.85,0:52:34.61,Default,,0,0,0,,Мен де жаттығуды аяқтадым.
Dialogue: 0,0:52:34.69,0:52:36.86,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:52:37.82,0:52:39.11,Default,,0,0,0,,Не болды?
Dialogue: 0,0:52:39.53,0:52:42.91,Default,,0,0,0,,Ка... Камишин Дұрыс. Экспедиция қалай өтті?
Dialogue: 0,0:52:42.99,0:52:45.07,Default,,0,0,0,,Ой... Жарайды, мен экспедицияға шықтым.
Dialogue: 0,0:52:45.16,0:52:47.12,Default,,0,0,0,,Болды, мені тыңда.
Dialogue: 0,0:52:47.45,0:52:48.74,Default,,0,0,0,,Түнгі автобуспен шайқалу
Dialogue: 0,0:52:48.83,0:52:52.37,Default,,0,0,0,,Мен барғым келетін университеттің жаттықтырушысына жақсы жақтарымды көрсету үшін бардым.
Dialogue: 0,0:52:52.46,0:52:54.21,Default,,0,0,0,,Мен бар күшімді салып бардым, солай ма?
Dialogue: 0,0:52:54.29,0:52:57.30,Default,,0,0,0,,Мен мүлдем жақсы уақыт өткізе алмаймын. Бұл ең нашар.
Dialogue: 0,0:52:57.38,0:52:58.55,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:52:59.30,0:53:00.30,Default,,0,0,0,,Эй, мынаны қарашы.
Dialogue: 0,0:53:00.88,0:53:03.59,Default,,0,0,0,,Мектептер арасындағы турнирге қатыса алмайтын балалар бар болса да...
Dialogue: 0,0:53:03.68,0:53:05.97,Default,,0,0,0,,Мен осылай шыққаныма қатты өкінемін.
Dialogue: 0,0:53:06.60,0:53:08.93,Default,,0,0,0,,Камишин Интер-Хай пайда болады ма?
Dialogue: 0,0:53:09.02,0:53:10.06,Default,,0,0,0,,Су толқындары, олар кеткен жерге шабуыл жасаңдар
Dialogue: 0,0:53:10.14,0:53:12.35,Default,,0,0,0,,Ал, хи хи (қоңырау) Шынымен бе?
Dialogue: 0,0:53:12.44,0:53:14.65,Default,,0,0,0,,Бұл таңқаларлық. Мен сені сүйем.
Dialogue: 0,0:53:15.69,0:53:16.94,Default,,0,0,0,,Қолдау?
Dialogue: 0,0:53:18.48,0:53:19.69,Default,,0,0,0,,Шинобуса (Шин) иә?
Dialogue: 0,0:53:19.78,0:53:21.65,Default,,0,0,0,,Сіз мені қолдап отырсыз деген сөз.
Dialogue: 0,0:53:21.74,0:53:23.74,Default,,0,0,0,,Иә (Синдзиро) Сузу-чан...
Dialogue: 0,0:53:25.32,0:53:27.78,Default,,0,0,0,,Бұл маған аздап ұнайды дегенді білдіре ме?
Dialogue: 0,0:53:30.37,0:53:33.79,Default,,0,0,0,,Иә? Мүмкін қате болған шығар. Мүмкін болды.
Dialogue: 0,0:53:33.87,0:53:35.46,Default,,0,0,0,,Тезірек оны тастап кет, ақымақ.
Dialogue: 0,0:53:35.75,0:53:37.79,Default,,0,0,0,,Өтірік, өтірік, қалжың.
Dialogue: 0,0:53:37.88,0:53:40.25,Default,,0,0,0,,Көріскенше, Сузу-чан, қолдау көрсеткенің үшін рахмет.
Dialogue: 0,0:53:40.63,0:53:43.05,Default,,0,0,0,,Тез жүр (Синдзиро) Түсіндім.
Dialogue: 0,0:53:52.64,0:53:56.06,Default,,0,0,0,,Білесің бе, біз бұрын не туралы айтып едік?
Dialogue: 0,0:53:56.15,0:53:57.15,Default,,0,0,0,,Жетеді
Dialogue: 0,0:53:57.81,0:53:59.52,Default,,0,0,0,,Сіз шектен шығып жатырсыз ба? (қоңырау) Менде жоқ.
Dialogue: 0,0:53:59.86,0:54:00.94,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:54:01.69,0:54:02.99,Default,,0,0,0,,Рас
Dialogue: 0,0:54:09.74,0:54:11.08,Default,,0,0,0,,Шинобу-кун
Dialogue: 0,0:54:11.87,0:54:15.25,Default,,0,0,0,,Мен үшін енді уайымдаудың қажеті жоқ.
Dialogue: 0,0:54:15.33,0:54:16.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:17.88,0:54:19.09,Default,,0,0,0,,Қоңырау
Dialogue: 0,0:54:22.88,0:54:25.01,Default,,0,0,0,,Мен не істегім келеді?
Dialogue: 0,0:54:34.14,0:54:39.77,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:54:51.95,0:54:57.96,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:55:12.14,0:55:13.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:13.22,0:55:14.43,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:55:32.53,0:55:33.74,Default,,0,0,0,,Әйелдер?
Dialogue: 0,0:55:50.51,0:55:51.64,Default,,0,0,0,,Көгерулер…
Dialogue: 0,0:55:54.93,0:55:55.93,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:55:56.27,0:55:57.39,Default,,0,0,0,,29-шы эпизод: Мақсат – Рим! Колизей
Dialogue: 0,0:55:57.48,0:55:58.93,Default,,0,0,0,,Бұл көгеру үшін кешіріңіз...
Dialogue: 0,0:55:59.02,0:56:01.27,Default,,0,0,0,,шіркінге күлуге келдің бе? Жоқ.
Dialogue: 0,0:56:01.65,0:56:03.44,Default,,0,0,0,,Бұл көгеру ауырады ма?
Dialogue: 0,0:56:03.52,0:56:05.11,Default,,0,0,0,,Ауырды, солай ма? Содан кейін...
Dialogue: 0,0:56:05.19,0:56:06.86,Default,,0,0,0,,Сіз ештеңе түсінбейсіз
Dialogue: 0,0:56:06.94,0:56:08.69,Default,,0,0,0,,Олай болса, түсінікті болу үшін маған анық тыңдауға рұқсат етіңіз.
Dialogue: 0,0:56:08.78,0:56:11.86,Default,,0,0,0,,Енді... шық!
Dialogue: 0,0:56:18.08,0:56:19.33,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:56:21.67,0:56:23.46,Default,,0,0,0,,Шық, шық, шық...
Dialogue: 0,0:56:35.14,0:56:36.31,Default,,0,0,0,,Күтіңіз хаха
Dialogue: 0,0:56:38.89,0:56:40.48,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:56:40.56,0:56:41.69,Default,,0,0,0,,Сіз біреуді көрдіңіз бе?
Dialogue: 0,0:56:42.02,0:56:44.36,Default,,0,0,0,,Бұл ұсқынсыз құбыжық па?
Dialogue: 0,0:56:46.69,0:56:49.03,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:56:51.70,0:56:54.12,Default,,0,0,0,,Сіз... Беллсіз бе?
Dialogue: 0,0:56:54.53,0:56:56.08,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:56:57.49,0:56:59.20,Default,,0,0,0,,Оны айтпайсың ба?
Dialogue: 0,0:57:00.29,0:57:01.41,Default,,0,0,0,,Ийда…
Dialogue: 0,0:57:03.67,0:57:06.59,Default,,0,0,0,,Айтпасаңыз, Origin-тен сұраңыз.
Dialogue: 0,0:57:07.00,0:57:08.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:10.97,0:57:12.13,Default,,0,0,0,,Рю Ах
Dialogue: 0,0:57:12.22,0:57:13.97,Default,,0,0,0,,Оны қу! (Эскадрон) Оны қу!
Dialogue: 0,0:57:21.52,0:57:23.10,Default,,0,0,0,,Уф... (Эскадрон)
Dialogue: 0,0:57:28.15,0:57:30.11,Default,,0,0,0,,Мен қорқамын (Эскадрон мүшесі) Бұл өте баяу.
Dialogue: 0,0:57:31.99,0:57:33.15,Default,,0,0,0,,Ах
Dialogue: 0,0:57:35.82,0:57:36.87,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:57:36.95,0:57:38.99,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:57:43.41,0:57:45.50,Default,,0,0,0,,Әй, соқтығысты!
Dialogue: 0,0:57:45.58,0:57:47.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:57:49.75,0:57:50.92,Default,,0,0,0,,Уф
Dialogue: 0,0:57:53.17,0:57:55.38,Default,,0,0,0,,Айдаһар қайда? Бұл қайда?
Dialogue: 0,0:57:55.59,0:57:57.85,Default,,0,0,0,,Қарғыс атсын... Айдаһар
Dialogue: 0,0:58:01.56,0:58:02.68,Default,,0,0,0,,Уф
Dialogue: 0,0:58:03.73,0:58:05.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:58:06.94,0:58:08.06,Default,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:58:09.02,0:58:10.65,Default,,0,0,0,,Кетіңіз
Dialogue: 0,0:58:15.40,0:58:16.49,Default,,0,0,0,,Ха…
Dialogue: 0,0:58:22.62,0:58:24.83,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:58:27.08,0:58:30.71,Default,,0,0,0,,Мен сен туралы бұрынғыдан азырақ білемін.
Dialogue: 0,0:58:32.92,0:58:36.30,Default,,0,0,0,,Бұл шынымен ауыртады ма?
Dialogue: 0,0:58:36.59,0:58:37.93,Default,,0,0,0,,А...
Dialogue: 0,0:58:38.43,0:58:41.01,Default,,0,0,0,,Меніңше, осы дүниеде соғыссыз өмір сүре алмайтын адамдар бар.
Dialogue: 0,0:58:43.47,0:58:44.48,Default,,0,0,0,,Қоңырау
Dialogue: 0,0:58:44.85,0:58:47.98,Default,,0,0,0,,Ах (Су перісі AI) Мастер
Dialogue: 0,0:58:57.49,0:59:02.62,Default,,0,0,0,,♪ жалғыз
Dialogue: 0,0:59:02.70,0:59:08.71,Default,,0,0,0,,♪ Мен сенен қалаймын
Dialogue: 0,0:59:09.63,0:59:12.42,Default,,0,0,0,,♪ Сіз
Dialogue: 0,0:59:12.84,0:59:17.30,Default,,0,0,0,,♪ Мен сені итеріп жіберемін, бірақ
Dialogue: 0,0:59:17.76,0:59:19.68,Default,,0,0,0,,♪ Шын мәнінде
Dialogue: 0,0:59:19.76,0:59:24.56,Default,,0,0,0,,♪ Менің кеудемде
Dialogue: 0,0:59:24.64,0:59:27.81,Default,,0,0,0,,♪ бірдеңе
Dialogue: 0,0:59:30.77,0:59:37.15,Default,,0,0,0,,♪ Сізге ешкімнің қарағанын қаламайсыз, солай ма?
Dialogue: 0,0:59:37.99,0:59:43.28,Default,,0,0,0,,♪ Ашу Қорқыныш Қайғыдан
Dialogue: 0,0:59:44.66,0:59:49.67,Default,,0,0,0,,♪ Мен ұстай алмайтын түн
Dialogue: 0,0:59:50.62,0:59:53.50,Default,,0,0,0,,♪ Бірақ сіздің аузыңызда
Dialogue: 0,0:59:53.59,0:59:58.84,Default,,0,0,0,,♪ Мен алмаймын
Dialogue: 0,0:59:59.63,1:00:04.93,Default,,0,0,0,,♪ Маған тыңдауға рұқсат етіңіз
Dialogue: 0,1:00:05.26,1:00:07.85,Default,,0,0,0,,♪ жасыруға тырысыңыз
Dialogue: 0,1:00:07.93,1:00:12.90,Default,,0,0,0,,♪ сіздің дауысыңыз
Dialogue: 0,1:00:12.98,1:00:18.32,Default,,0,0,0,,♪ Маған көрсет
Dialogue: 0,1:00:18.65,1:00:21.28,Default,,0,0,0,,♪ жасыру
Dialogue: 0,1:00:21.36,1:00:25.95,Default,,0,0,0,,♪ сіздің
Dialogue: 0,1:00:26.37,1:00:29.58,Default,,0,0,0,,♪ жүрек
Dialogue: 0,1:00:28.12,1:00:29.58,Default,,0,0,0,,Құпия раушан
Dialogue: 0,1:00:29.58,1:00:33.38,Default,,0,0,0,,♪ жүрек
Dialogue: 0,1:00:53.98,1:00:59.11,Default,,0,0,0,,♪ жалғыз
Dialogue: 0,1:00:59.65,1:01:05.99,Default,,0,0,0,,♪ Егер аман қала алсаңыз
Dialogue: 0,1:01:06.28,1:01:09.16,Default,,0,0,0,,♪ Сіз
Dialogue: 0,1:01:09.70,1:01:14.21,Default,,0,0,0,,♪ Мен мойындаймын, бірақ
Dialogue: 0,1:01:14.50,1:01:19.63,Default,,0,0,0,,♪ Іс жүзінде көп рет
Dialogue: 0,1:01:19.71,1:01:25.93,Default,,0,0,0,,♪ Мен өзіме талай рет айттым
Dialogue: 0,1:01:27.39,1:01:34.35,Default,,0,0,0,,♪ Түн болған болуы керек
Dialogue: 0,1:01:35.02,1:01:40.03,Default,,0,0,0,,♪ Бірақ сен, сен
Dialogue: 0,1:01:41.32,1:01:47.66,Default,,0,0,0,,♪ Кім болсаң да, мен қалаймын
Dialogue: 0,1:01:47.74,1:01:54.75,Default,,0,0,0,,♪ Мен бұл туралы үнемі ойлаймын
Dialogue: 0,1:01:59.63,1:02:05.13,Default,,0,0,0,,♪ Маған тыңдауға рұқсат етіңіз
Dialogue: 0,1:02:05.22,1:02:07.97,Default,,0,0,0,,♪ жасыруға тырысыңыз
Dialogue: 0,1:02:08.05,1:02:12.93,Default,,0,0,0,,♪ сіздің бетіңіз
Dialogue: 0,1:02:13.02,1:02:18.06,Default,,0,0,0,,♪ Маған көрсет
Dialogue: 0,1:02:18.52,1:02:21.19,Default,,0,0,0,,♪ жасыру
Dialogue: 0,1:02:21.28,1:02:26.24,Default,,0,0,0,,♪ сенің жүрегің
Dialogue: 0,1:02:26.32,1:02:31.83,Default,,0,0,0,,♪ Маған тыңдауға рұқсат етіңіз
Dialogue: 0,1:02:31.91,1:02:34.54,Default,,0,0,0,,♪ Ол кез келген нәрседен басталуы мүмкін.
Dialogue: 0,1:02:34.62,1:02:39.54,Default,,0,0,0,,♪ Соңына дейін тыңдаймын
Dialogue: 0,1:02:39.63,1:02:45.01,Default,,0,0,0,,♪ Ашық
Dialogue: 0,1:02:45.09,1:02:47.97,Default,,0,0,0,,♪ Мен сенің жаныңда болғым келеді
Dialogue: 0,1:02:48.05,1:02:52.68,Default,,0,0,0,,♪ сіздің
Dialogue: 0,1:02:51.51,1:02:52.68,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,1:02:52.97,1:02:59.94,Default,,0,0,0,,♪ жүрек
Dialogue: 0,1:03:00.27,1:03:03.48,Default,,0,0,0,,Уф уф...
Dialogue: 0,1:03:06.15,1:03:07.15,Default,,0,0,0,,Ах
Dialogue: 0,1:03:08.91,1:03:12.49,Default,,0,0,0,,Уф, уф, уф...
Dialogue: 0,1:03:16.54,1:03:19.42,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:03:20.83,1:03:22.25,Default,,0,0,0,,Жолтайым Құдай
Dialogue: 0,1:03:24.67,1:03:27.72,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:03:38.81,1:03:40.94,Default,,0,0,0,,«Белл енді концерт бермейді ме?»
Dialogue: 0,1:03:41.27,1:03:43.07,Default,,0,0,0,,«Неге ән айтпайсың?»
Dialogue: 0,1:03:43.73,1:03:45.98,Default,,0,0,0,,«Мен қайтадан мазасызданудан қорқамын».
Dialogue: 0,1:03:46.07,1:03:47.49,Default,,0,0,0,,«Бәріне айдаһар кінәлі».
Dialogue: 0,1:03:47.57,1:03:49.24,Default,,0,0,0,,«Тез ашылады»
Dialogue: 0,1:03:49.32,1:03:51.24,Default,,0,0,0,,Оны жайына қалдырайық.
Dialogue: 0,1:03:51.66,1:03:53.99,Default,,0,0,0,,Құпияларды білудің қажеті жоқ.
Dialogue: 0,1:03:54.08,1:03:55.66,Default,,0,0,0,,Тоқтасақ та мүмкін емес.
Dialogue: 0,1:03:56.04,1:03:59.41,Default,,0,0,0,,U SNS шағын сынып тобы емес.
Dialogue: 0,1:03:59.50,1:04:01.50,Default,,0,0,0,,Енді мені ешкім тоқтата алмайды
Dialogue: 0,1:04:02.17,1:04:05.00,Default,,0,0,0,,Айдаһарлар - U тәртібіне қауіп төндіретін қауіпті нысандар.
Dialogue: 0,1:04:05.34,1:04:08.05,Default,,0,0,0,,Айдаһарлар туралы жаңа мәліметтер іздеу
Dialogue: 0,1:04:08.13,1:04:10.38,Default,,0,0,0,,хэштег – «UnveilTheBeast»
Dialogue: 0,1:04:10.76,1:04:12.72,Default,,0,0,0,,Айдаһар - дәруіш сияқты қарт адам.
Dialogue: 0,1:04:12.80,1:04:15.06,Default,,0,0,0,,Рюдің шынайы тұлғасы - гений ойыншысы.
Dialogue: 0,1:04:15.14,1:04:17.93,Default,,0,0,0,,Айдаһарлардың арасында керемет эротикалық әйел бар.
Dialogue: 0,1:04:18.02,1:04:19.89,Default,,0,0,0,,Айдаһар шын мәнінде миллионер
Dialogue: 0,1:04:20.27,1:04:23.19,Default,,0,0,0,,Мен төбелестен психологиялық зардап шеккендіктен келтірілген шығынды өтедім...
Dialogue: 0,1:04:23.40,1:04:25.94,Default,,0,0,0,,Джелинек, сенің жігітің қайтыс болды, сен әлі кездесуге барасың ба?
Dialogue: 0,1:04:26.02,1:04:28.61,Default,,0,0,0,,Ол ең жақсы (бұрынғы ғашық) Тоқта, мен өлген жоқпын.
Dialogue: 0,1:04:28.69,1:04:29.78,Default,,0,0,0,,О, сен тірі ме едің?
Dialogue: 0,1:04:29.86,1:04:32.16,Default,,0,0,0,,Мен ол өлді деп ешқашан айтқан емеспін.
Dialogue: 0,1:04:32.36,1:04:35.83,Default,,0,0,0,,Көшіру – оның мамандығы. Айдаһарды көргеннен кейін татуировканы да көшіріп алған.
Dialogue: 0,1:04:36.08,1:04:37.62,Default,,0,0,0,,Ол өтірік айтады.
Dialogue: 0,1:04:37.70,1:04:38.95,Default,,0,0,0,,Ол жай ғана алаяқ
Dialogue: 0,1:04:39.04,1:04:40.33,Default,,0,0,0,,Жеңілгендер аузын жабу керек пе?
Dialogue: 0,1:04:40.41,1:04:41.42,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,1:04:41.71,1:04:43.88,Default,,0,0,0,,Плагиат? Мүлдем мүмкін емес
Dialogue: 0,1:04:44.79,1:04:47.13,Default,,0,0,0,,Терімді көпшілікке көрсетпеу арқылы...
Dialogue: 0,1:04:47.21,1:04:49.51,Default,,0,0,0,,Бір нәрсені жасырды деп күдіктенеді
Dialogue: 0,1:04:49.59,1:04:52.22,Default,,0,0,0,,Осы уақыт ішінде U-дегі айдаһардың тұлғасы...
Dialogue: 0,1:04:52.30,1:04:54.72,Default,,0,0,0,,Маған біреу айғайлап, мен бе деп сұрады.
Dialogue: 0,1:04:54.97,1:04:58.47,Default,,0,0,0,,Бірақ мен жауыз да, зорлықшыл да емеспін.
Dialogue: 0,1:04:58.56,1:04:59.93,Default,,0,0,0,,Балаларға -
Dialogue: 0,1:05:00.02,1:05:02.98,Default,,0,0,0,,Мен нағыз батыр болғым келеді.
Dialogue: 0,1:05:09.90,1:05:11.74,Default,,0,0,0,,Өтінемін, таң қалмаңыз.
Dialogue: 0,1:05:11.82,1:05:14.53,Default,,0,0,0,,Бала кезімде ауыр сырқатқа шалдықтым.
Dialogue: 0,1:05:14.62,1:05:16.87,Default,,0,0,0,,Бірнеше ауыр операцияларды жасады
Dialogue: 0,1:05:16.95,1:05:20.62,Default,,0,0,0,,Бірақ соның арқасында мен бейсбол ойнай алдым.
Dialogue: 0,1:05:20.70,1:05:22.75,Default,,0,0,0,,Осыны көріп отырған балаларға...
Dialogue: 0,1:05:22.83,1:05:24.79,Default,,0,0,0,,Армандарыңыздан бас тартпайсыз деп үміттенемін
Dialogue: 0,1:05:24.88,1:05:28.05,Default,,0,0,0,,Бұл хабарлама дұрыс қабылданды деп үміттенемін.
Dialogue: 0,1:05:28.13,1:05:29.88,Default,,0,0,0,,(Астың қошеметі)
Dialogue: 0,1:05:30.26,1:05:33.01,Default,,0,0,0,,Хм, онда айдаһар деген не...
Dialogue: 0,1:05:33.09,1:05:35.43,Default,,0,0,0,,Мен сені кешірмеймін! (Хирока сияқты) Иә?
Dialogue: 0,1:05:35.51,1:05:37.55,Default,,0,0,0,,Кеше… Ах…
Dialogue: 0,1:05:37.64,1:05:40.97,Default,,0,0,0,,Мені ренжіткендерді ешқашан кешірмеймін
Dialogue: 0,1:05:41.06,1:05:43.77,Default,,0,0,0,,Мүмкін сіз идеалды үй шаруасындағы әйелсіз бе?
Dialogue: 0,1:05:44.73,1:05:46.02,Default,,0,0,0,,Неліктен нәресте?
Dialogue: 0,1:05:46.10,1:05:49.02,Default,,0,0,0,,Нағыз мен – жүрегі таза адам.
Dialogue: 0,1:05:49.11,1:05:50.11,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,1:05:50.19,1:05:52.49,Default,,0,0,0,,Сүйкімді кейіпкер болса, қанша жаман айтсаң да...
Dialogue: 0,1:05:52.57,1:05:54.66,Default,,0,0,0,,Сіз кешіріледі деп ойлайсыз, солай ма?
Dialogue: 0,1:05:55.74,1:05:59.33,Default,,0,0,0,,Шулы жарақат!
Dialogue: 0,1:06:00.04,1:06:02.66,Default,,0,0,0,,Эй, Белл қайтадан ән салады деген рас па?
Dialogue: 0,1:06:02.75,1:06:04.08,Default,,0,0,0,,Бұл жай ғана қауесет
Dialogue: 0,1:06:04.16,1:06:05.67,Default,,0,0,0,,Бірақ олар бұл әнді тосын сый ретінде айтатындарын айтты.
Dialogue: 0,1:06:05.75,1:06:07.13,Default,,0,0,0,,Бұл жай ғана өтірік
Dialogue: 0,1:06:07.33,1:06:09.80,Default,,0,0,0,,Дегенмен, егер бұл рас болса...
Dialogue: 0,1:06:12.84,1:06:13.84,Default,,0,0,0,,Ах
Dialogue: 0,1:06:14.59,1:06:15.88,Default,,0,0,0,,Ах
Dialogue: 0,1:06:21.77,1:06:23.77,Default,,0,0,0,,Иә? Қоңырау қайда? қайда?
Dialogue: 0,1:06:24.18,1:06:25.85,Default,,0,0,0,,Қоңырау!
Dialogue: 0,1:06:27.19,1:06:30.57,Default,,0,0,0,,Неліктен бұл жарық әділдіктің күші?
Dialogue: 0,1:06:30.65,1:06:32.23,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,1:06:34.11,1:06:37.24,Default,,0,0,0,,Әдетте құрылғы оқитын биометриялық ақпарат...
Dialogue: 0,1:06:37.32,1:06:41.16,Default,,0,0,0,,Арнайы процесс арқылы тіркелген As түріне түрлендірілді
Dialogue: 0,1:06:41.24,1:06:44.91,Default,,0,0,0,,Алайда бұл жарық бұл түрлендіруді толығымен жояды.
Dialogue: 0,1:06:45.21,1:06:49.38,Default,,0,0,0,,Бастауыштың өзі тікелей U кеңістігіне сызылған
Dialogue: 0,1:06:49.46,1:06:51.63,Default,,0,0,0,,Ашу осылай жұмыс істейді
Dialogue: 0,1:06:51.71,1:06:55.47,Default,,0,0,0,,Тек Creator Voices ғана иеленетін өкілеттік...
Dialogue: 0,1:06:55.55,1:06:58.18,Default,,0,0,0,,Менде бар деп айта аласыз.
Dialogue: 0,1:06:58.97,1:07:02.39,Default,,0,0,0,,Айтпақшы, сізде осындай сезім болды ма?
Dialogue: 0,1:07:02.47,1:07:06.23,Default,,0,0,0,,«Неге интернетте полиция қызметкерлері жоқ?»
Dialogue: 0,1:07:06.31,1:07:09.06,Default,,0,0,0,,Енді сол шындық пен U жақындап келеді...
Dialogue: 0,1:07:09.15,1:07:11.94,Default,,0,0,0,,Бұл жерде U-де полиция функциясының жоқтығы таңқаларлық емес пе?
Dialogue: 0,1:07:12.02,1:07:15.99,Default,,0,0,0,,Бұл әркімде бар сұрақ, солай емес пе? Әрине.
Dialogue: 0,1:07:16.07,1:07:17.32,Default,,0,0,0,,Бірақ дауыстар...
Dialogue: 0,1:07:17.40,1:07:21.74,Default,,0,0,0,,«Әділдік үшін қажет нәрсе бұрыннан бар» деп қабылдамаңыз
Dialogue: 0,1:07:22.41,1:07:26.16,Default,,0,0,0,,Бірақ біз олай ойламаймыз. Барлық жерде жаман адамдар бар.
Dialogue: 0,1:07:26.25,1:07:28.96,Default,,0,0,0,,Басқаларға қиындық тудырып, тәртіпті бұзатын адамдар бар.
Dialogue: 0,1:07:29.04,1:07:30.04,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,1:07:30.13,1:07:32.29,Default,,0,0,0,,Дүниеге күлетін адамдар бар.
Dialogue: 0,1:07:32.38,1:07:34.96,Default,,0,0,0,,Сондықтан оған қарсы тұру үшін күш керек.
Dialogue: 0,1:07:35.05,1:07:37.47,Default,,0,0,0,,Әділдік барлық жерде қажет.
Dialogue: 0,1:07:37.55,1:07:41.55,Default,,0,0,0,,Бізге зұлымдықты жеңетін күш керек.
Dialogue: 0,1:07:43.35,1:07:45.85,Default,,0,0,0,,Айдаһар Ұсқынсыз айдаһар
Dialogue: 0,1:07:45.93,1:07:48.44,Default,,0,0,0,,Ол осы U-ны сақтайтын адам.
Dialogue: 0,1:07:48.52,1:07:50.77,Default,,0,0,0,,Бұл ашылуы керек болмыс.
Dialogue: 0,1:07:50.85,1:07:52.19,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,1:07:53.32,1:07:55.53,Default,,0,0,0,,Неге үнемі айдаһарлармен біргесің?
Dialogue: 0,1:07:56.53,1:07:57.53,Default,,0,0,0,,Неге...
Dialogue: 0,1:07:58.03,1:08:01.49,Default,,0,0,0,,Менің ойымша, сен маған айдаһардың қайда екенін айтып, аузыңды жаппа.
Dialogue: 0,1:08:01.57,1:08:04.41,Default,,0,0,0,,Қазір айт немесе...
Dialogue: 0,1:08:06.24,1:08:09.41,Default,,0,0,0,,Мен сені осы жерде және қазір ашайын ба?
Dialogue: 0,1:08:12.92,1:08:14.54,Default,,0,0,0,,Білсең де айтпа
Dialogue: 0,1:08:14.63,1:08:15.63,Default,,0,0,0,,Не?
Dialogue: 0,1:08:15.71,1:08:17.05,Default,,0,0,0,,Сіз жай емессіз
Dialogue: 0,1:08:17.55,1:08:19.55,Default,,0,0,0,,Мен жай ғана басқалардың маған бағынғанын қалаймын.
Dialogue: 0,1:08:19.63,1:08:21.43,Default,,0,0,0,,Сондықтан айтпаймын
Dialogue: 0,1:08:21.51,1:08:23.18,Default,,0,0,0,,(Тодорокидің жылауы)
Dialogue: 0,1:08:24.26,1:08:25.68,Default,,0,0,0,,Кетчуппен бүтіндей бүркелген—
Dialogue: 0,1:08:26.01,1:08:29.35,Default,,0,0,0,,Енді мені мазақ етсең, мен сені ешқашан кешірмеймін.
Dialogue: 0,1:08:29.43,1:08:32.15,Default,,0,0,0,,Сіз аша алмаймын деп ойлайсыз ба?
Dialogue: 0,1:08:32.23,1:08:34.44,Default,,0,0,0,,Жарайды, қазір жасап көрейік.
Dialogue: 0,1:08:34.52,1:08:37.07,Default,,0,0,0,,Әлемге әйгілі дива кім?
Dialogue: 0,1:08:37.15,1:08:40.45,Default,,0,0,0,,Сол әдемі терінің астында қандай жүз жасырылған?
Dialogue: 0,1:08:40.70,1:08:45.41,Default,,0,0,0,,Мен оны елестете аламын, бірақ ... хехехе
Dialogue: 0,1:08:45.74,1:08:47.37,Default,,0,0,0,,Егер шындық ашылса... Ах, а...
Dialogue: 0,1:08:47.79,1:08:52.00,Default,,0,0,0,,Сіздің әндеріңізді кім шындап тыңдайды?
Dialogue: 0,1:08:50.37,1:08:53.25,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,1:08:52.08,1:08:53.25,Default,,0,0,0,,Хехехе
Dialogue: 0,1:08:53.33,1:08:55.00,Default,,0,0,0,,Оның болғанын қаламасаңыз, айтыңыз.
Dialogue: 0,1:08:55.09,1:08:57.88,Default,,0,0,0,,Ол кім және қазір қайда?
Dialogue: 0,1:08:57.96,1:08:59.76,Default,,0,0,0,,Сіз бірдеңе іздеп жүрсіз бе? Ах
Dialogue: 0,1:09:00.13,1:09:01.68,Default,,0,0,0,,Мен сізге тек айтамын
Dialogue: 0,1:09:01.76,1:09:03.05,Default,,0,0,0,,Бұл не... а?
Dialogue: 0,1:09:03.39,1:09:05.60,Default,,0,0,0,,Басқа ешкімге айтпа.
Dialogue: 0,1:09:05.68,1:09:07.51,Default,,0,0,0,,Ухухуху...
Dialogue: 0,1:09:08.43,1:09:10.77,Default,,0,0,0,,Шулы! Ах
Dialogue: 0,1:09:17.36,1:09:19.03,Default,,0,0,0,,Гах... Қарғыс атсын.
Dialogue: 0,1:09:19.11,1:09:20.44,Default,,0,0,0,,Ах
Dialogue: 0,1:09:22.20,1:09:23.45,Default,,0,0,0,,Нуууу
Dialogue: 0,1:09:39.25,1:09:40.55,Default,,0,0,0,,Иә
Dialogue: 0,1:09:42.80,1:09:44.47,Default,,0,0,0,,Маған көмектескеніңіз үшін рахмет (Су перісі AI) Кедей...
Dialogue: 0,1:09:44.55,1:09:46.18,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,1:09:50.97,1:09:52.81,Default,,0,0,0,,Оған қауіп төніп тұр
Dialogue: 0,1:09:53.56,1:09:55.23,Default,,0,0,0,,Мен сенің одақтасың болуым керек.
Dialogue: 0,1:09:55.98,1:09:57.44,Default,,0,0,0,,Мен сені қорғауым керек.
Dialogue: 0,1:09:58.82,1:10:00.07,Default,,0,0,0,,Қоңырау
Dialogue: 0,1:10:00.15,1:10:01.78,Default,,0,0,0,,Ах... Ах.
Dialogue: 0,1:10:04.15,1:10:05.16,Default,,0,0,0,,Не?
Dialogue: 0,1:10:05.24,1:10:07.16,Default,,0,0,0,,Егер сізде қандай да бір қиындық болса...
Dialogue: 0,1:10:07.24,1:10:08.37,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,1:10:08.45,1:10:09.87,Default,,0,0,0,,Кез келген нәрсені айтыңыз
Dialogue: 0,1:10:09.95,1:10:11.49,Default,,0,0,0,,Ештеңе!
Dialogue: 0,1:10:15.33,1:10:16.67,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:10:28.01,1:10:29.35,Default,,0,0,0,,Сузу-чан
Dialogue: 0,1:10:33.31,1:10:34.48,Default,,0,0,0,,Лука-чан
Dialogue: 0,1:10:38.44,1:10:40.36,Default,,0,0,0,,Мен адасып қалдым.
Dialogue: 0,1:10:40.82,1:10:44.65,Default,,0,0,0,,Сузу-чан мені қуантқандықтан, мен батылдықпен жүзуге бел байладым...
Dialogue: 0,1:10:44.74,1:10:45.74,Default,,0,0,0,,Иә
Dialogue: 0,1:10:45.82,1:10:48.66,Default,,0,0,0,,Бірақ мен сүйген адамымның алдында тұрғанда ештеңе айта алмаймын.
Dialogue: 0,1:10:48.74,1:10:49.74,Default,,0,0,0,,Иә
Dialogue: 0,1:10:49.82,1:10:52.45,Default,,0,0,0,,Сонда әлгі адам «Бұл қандай реакция?»
Dialogue: 0,1:10:52.54,1:10:53.91,Default,,0,0,0,,«Бұл қорқынышты.»
Dialogue: 0,1:10:54.25,1:10:55.58,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,1:10:55.66,1:10:57.79,Default,,0,0,0,,Жоқ, оны айтсаң көмектеспейді.
Dialogue: 0,1:10:57.87,1:11:00.54,Default,,0,0,0,,Мүлдем өз-өзіме сенбегеніме менің кінәм...
Dialogue: 0,1:11:00.63,1:11:02.00,Default,,0,0,0,,Бұл шынымен қорқынышты...
Dialogue: 0,1:11:02.09,1:11:04.59,Default,,0,0,0,,Бұлай болуы мүмкін емес. Бұлай болуы мүмкін емес.
Dialogue: 0,1:11:04.67,1:11:06.47,Default,,0,0,0,,Шинобу-кун сұмдық.
Dialogue: 0,1:11:06.55,1:11:08.13,Default,,0,0,0,,Не? Жоқ, жоқ
Dialogue: 0,1:11:08.22,1:11:09.89,Default,,0,0,0,,Иә? Сонда...
Dialogue: 0,1:11:10.55,1:11:12.31,Default,,0,0,0,,Сензу-кун
Dialogue: 0,1:11:12.39,1:11:13.52,Default,,0,0,0,,Мың бас...
Dialogue: 0,1:11:13.60,1:11:16.10,Default,,0,0,0,,Сензу... Синдзиро
Dialogue: 0,1:11:16.31,1:11:17.64,Default,,0,0,0,,Камисин! ?
Dialogue: 0,1:11:21.15,1:11:22.57,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,1:11:22.86,1:11:25.82,Default,,0,0,0,,Хмм, сондай сүйкімді.
Dialogue: 0,1:11:30.12,1:11:32.62,Default,,0,0,0,,Сузу-чан, мен сенің кімді ұнататынын енді білемін.
Dialogue: 0,1:11:32.70,1:11:34.95,Default,,0,0,0,,Жоқ, айтпа, өлесің.
Dialogue: 0,1:11:35.04,1:11:37.16,Default,,0,0,0,,А... Бірақ қашаннан бері?
Dialogue: 0,1:11:40.67,1:11:41.92,Default,,0,0,0,,6 жаста
Dialogue: 0,1:11:42.00,1:11:44.42,Default,,0,0,0,,«Мен сені қорғаймын» деді.
Dialogue: 0,1:11:44.84,1:11:48.72,Default,,0,0,0,,Мен мұны алғаш естігенде, маған ұсыныс жасады деп ойладым.
Dialogue: 0,1:11:49.55,1:11:50.55,Default,,0,0,0,,Бірақ шынымен...
Dialogue: 0,1:11:50.64,1:11:53.68,Default,,0,0,0,,«Егер мені қорлайтын біреу болса, мен сені қорғаймын» дегенді білдіреді.
Dialogue: 0,1:11:54.18,1:11:55.93,Default,,0,0,0,,Әрине, бұл үйлену туралы ұсыныс емес еді.
Dialogue: 0,1:11:56.89,1:11:58.89,Default,,0,0,0,,Анам қайтыс болғанда, мен жай ғана жыладым ...
Dialogue: 0,1:11:58.98,1:12:02.56,Default,,0,0,0,,Сыныптағылардың бәрі қорқып, маған ешкім жақындай алмады.
Dialogue: 0,1:12:03.11,1:12:05.73,Default,,0,0,0,,Менің ойымша, сондықтан сізді қорлап жатыр деп ойладыңыз.
Dialogue: 0,1:12:06.11,1:12:07.24,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:12:12.07,1:12:13.99,Default,,0,0,0,,Мен сәл оғаш нәрсе айтып тұрмын, бірақ...
Dialogue: 0,1:12:14.08,1:12:15.54,Default,,0,0,0,,I Сол адам туралы -
Dialogue: 0,1:12:15.62,1:12:18.00,Default,,0,0,0,,Әйтеуір өзімді Сузу-чанның анасындай сезінемін...
Dialogue: 0,1:12:18.08,1:12:20.42,Default,,0,0,0,,Мен бұл туралы ойладым (Сузу) Анашым?
Dialogue: 0,1:12:20.67,1:12:22.25,Default,,0,0,0,,Өйткені ештеңе жоқ...
Dialogue: 0,1:12:22.33,1:12:25.71,Default,,0,0,0,,Сіз үнемі «Жақсысыз ба?» деген сияқты нәрселерді сұрайсыз. және «Жақсысың ба?»
Dialogue: 0,1:12:25.80,1:12:28.84,Default,,0,0,0,,Еркек екенсің, Шинобу.
Dialogue: 0,1:12:28.92,1:12:29.92,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:30.51,1:12:31.84,Default,,0,0,0,,Мен айттым
Dialogue: 0,1:12:32.51,1:12:33.85,Default,,0,0,0,,Хехехе
Dialogue: 0,1:12:33.93,1:12:35.81,Default,,0,0,0,,Ахаха өлді
Dialogue: 0,1:12:35.89,1:12:38.77,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:12:39.39,1:12:42.48,Default,,0,0,0,,Олай болса, келесі жолы мені сол естеліктерді бастауыш мектепке апар.
Dialogue: 0,1:12:42.56,1:12:44.19,Default,,0,0,0,,Иә (Рука) Мен тағы келемін.
Dialogue: 0,1:12:44.27,1:12:45.27,Default,,0,0,0,,Иә
Dialogue: 0,1:12:46.32,1:12:47.36,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:48.40,1:12:49.49,Default,,0,0,0,,Камисин
Dialogue: 0,1:12:50.45,1:12:51.65,Default,,0,0,0,,Ой
Dialogue: 0,1:12:51.86,1:12:52.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:59.00,1:13:00.71,Default,,0,0,0,,Ой! О...
Dialogue: 0,1:13:00.79,1:13:02.83,Default,,0,0,0,,Мен сені қолдаймын...
Dialogue: 0,1:13:02.92,1:13:03.92,Default,,0,0,0,,Қолдау?
Dialogue: 0,1:13:04.00,1:13:05.71,Default,,0,0,0,,Сензу-кундікі
Dialogue: 0,1:13:05.79,1:13:07.96,Default,,0,0,0,,О... қолдау?
Dialogue: 0,1:13:08.05,1:13:09.63,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:10.30,1:13:13.13,Default,,0,0,0,,Ой... бұл мені қолдап жатқаныңды білдіреді...
Dialogue: 0,1:13:13.22,1:13:14.22,Default,,0,0,0,,Ватанабе мырза
Dialogue: 0,1:13:15.39,1:13:18.18,Default,,0,0,0,,Бұл маған аздап ұнайды дегенді білдіре ме?
Dialogue: 0,1:13:18.35,1:13:19.35,Default,,0,0,0,,Ха…
Dialogue: 0,1:13:19.43,1:13:23.23,Default,,0,0,0,,Өтірік, өтірік, әзіл, әзіл.
Dialogue: 0,1:13:25.23,1:13:27.19,Default,,0,0,0,,Иә? (Сузу) Иә.
Dialogue: 0,1:13:27.27,1:13:29.48,Default,,0,0,0,,Не? (қоңырау) Иә, иә
Dialogue: 0,1:13:31.74,1:13:33.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:34.11,1:13:35.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:38.12,1:13:41.41,Default,,0,0,0,,Ой, күте тұр... неге қашып жүрсің?
Dialogue: 0,1:13:41.50,1:13:43.58,Default,,0,0,0,,Өйткені мен ешқашан әйел мені сүйетінін айтқан емес.
Dialogue: 0,1:13:43.67,1:13:45.25,Default,,0,0,0,,Жаңа ғана айтқан жоқсың ба? Мен сені сүйем
Dialogue: 0,1:13:45.33,1:13:47.25,Default,,0,0,0,,Түсіндім (Рин) Сен бақытты емессің бе?
Dialogue: 0,1:13:47.54,1:13:48.71,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,1:13:55.89,1:14:00.31,Default,,0,0,0,,Ммммммммм…
Dialogue: 0,1:14:01.02,1:14:02.02,Default,,0,0,0,,Мен...
Dialogue: 0,1:14:02.68,1:14:03.81,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,1:14:05.94,1:14:07.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:07.31,1:14:08.31,Default,,0,0,0,,Бір минут күте тұрыңыз...
Dialogue: 0,1:14:08.40,1:14:10.40,Default,,0,0,0,,Әйелдермен не туралы сөйлесерімді білмеймін.
Dialogue: 0,1:14:10.48,1:14:13.57,Default,,0,0,0,,Барлығы жақсы, мысалы, рахмет немесе мен барымды саламын.
Dialogue: 0,1:14:24.37,1:14:26.37,Default,,0,0,0,,Мен... Ватанабе мырза
Dialogue: 0,1:14:26.71,1:14:28.08,Default,,0,0,0,,Иә (Синдзиро)...
Dialogue: 0,1:14:28.59,1:14:29.96,Default,,0,0,0,,Сіз әдетте не істейсіз?
Dialogue: 0,1:14:30.04,1:14:33.42,Default,,0,0,0,,Музыка Чизу, сен қандай музыка тыңдайсың?
Dialogue: 0,1:14:33.97,1:14:35.97,Default,,0,0,0,,Be… Bell т.б.
Dialogue: 0,1:14:36.05,1:14:37.51,Default,,0,0,0,,Ех (Рука) Белл, мен оны шынымен тыңдаймын.
Dialogue: 0,1:14:37.80,1:14:39.43,Default,,0,0,0,,Шынайы ма? Біз біргеміз
Dialogue: 0,1:14:39.51,1:14:42.77,Default,,0,0,0,,Мен осылай ән айтуды армандайтынмын.
Dialogue: 0,1:14:43.14,1:14:46.48,Default,,0,0,0,,Сіз күлетін шығарсыз, бірақ адамдар бізді аздап ұқсайды дейді.
Dialogue: 0,1:14:46.56,1:14:48.52,Default,,0,0,0,,Жоқ, олар өте ұқсас.
Dialogue: 0,1:14:48.61,1:14:50.19,Default,,0,0,0,,Мен өзімді тым санаймын
Dialogue: 0,1:14:50.27,1:14:52.19,Default,,0,0,0,,Жоқ, олар шынымен де ұқсайды.
Dialogue: 0,1:14:52.28,1:14:55.36,Default,,0,0,0,,Иә? неге? Туыстар? Олар туыстар, солай ма?
Dialogue: 0,1:14:57.61,1:15:00.33,Default,,0,0,0,,Менің атам Хакодатедегі кеме жасау зауытында жұмыс істеген.
Dialogue: 0,1:15:00.41,1:15:02.49,Default,,0,0,0,,Жазда үнемі отбасыммен барамын.
Dialogue: 0,1:15:02.99,1:15:05.62,Default,,0,0,0,,Демек, бұл шынымен де жоғары...
Dialogue: 0,1:15:05.71,1:15:07.54,Default,,0,0,0,,Қолдау Мен бара аламын ба?
Dialogue: 0,1:15:07.83,1:15:09.50,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,1:15:09.67,1:15:11.67,Default,,0,0,0,,Мен сіздің қолдауыңызды бағалаймын. Келсең...
Dialogue: 0,1:15:12.55,1:15:15.13,Default,,0,0,0,,Қараңдар, мен міндетті түрде жеңемін.
Dialogue: 0,1:15:15.92,1:15:16.97,Default,,0,0,0,,Иә
Dialogue: 0,1:15:20.14,1:15:22.31,Default,,0,0,0,,А... бұл ақылсыз болды.
Dialogue: 0,1:15:22.93,1:15:24.60,Default,,0,0,0,,Бірақ жақсы болады деп үміттенемін.
Dialogue: 0,1:15:24.68,1:15:25.73,Default,,0,0,0,,Қоңырау
Dialogue: 0,1:15:25.81,1:15:26.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:27.85,1:15:28.85,Default,,0,0,0,,Камишин болды ма?
Dialogue: 0,1:15:29.19,1:15:31.48,Default,,0,0,0,,Иә... жоқ.
Dialogue: 0,1:15:31.56,1:15:33.15,Default,,0,0,0,,Қайсы? (Сузу) Иә.
Dialogue: 0,1:15:33.36,1:15:35.19,Default,,0,0,0,,Ум (Шиноби) Қайсысы?
Dialogue: 0,1:15:42.12,1:15:43.62,Default,,0,0,0,,Suzu That...
Dialogue: 0,1:15:44.12,1:15:46.20,Default,,0,0,0,,Сузуға көптен бері айта алмай жүрген бірдеңе болды.
Dialogue: 0,1:15:47.50,1:15:48.50,Default,,0,0,0,,Қоңырау
Dialogue: 0,1:15:48.87,1:15:49.96,Default,,0,0,0,,Шинобу-кун, кешіріңіз.
Dialogue: 0,1:15:50.04,1:15:53.34,Default,,0,0,0,,Мен Шинобуға осы уақытқа дейін айта алмаған бірдеңе болды...
Dialogue: 0,1:15:53.63,1:15:54.63,Default,,0,0,0,,О
Dialogue: 0,1:15:55.00,1:15:57.76,Default,,0,0,0,,Негізі... (Шинобу) Мен білемін.
Dialogue: 0,1:15:58.05,1:15:59.88,Default,,0,0,0,,Шын мәнінде...
Dialogue: 0,1:15:59.97,1:16:01.47,Default,,0,0,0,,Қоңырау бұл қоңырау.
Dialogue: 0,1:16:02.10,1:16:03.10,Default,,0,0,0,,Саған қонақүй тауып беремін.
Dialogue: 0,1:16:03.47,1:16:05.77,Default,,0,0,0,,Бұл шынымен де қоңырау ғой, солай емес пе?
Dialogue: 0,1:16:05.85,1:16:08.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:08.85,1:16:09.85,Default,,0,0,0,,Қоңырау
Dialogue: 0,1:16:10.06,1:16:11.98,Default,,0,0,0,,Tsk tsk... бұл дұрыс емес.
Dialogue: 0,1:16:12.44,1:16:14.69,Default,,0,0,0,,Suzu (Suzu) Жоқ!
Dialogue: 0,1:16:17.49,1:16:18.49,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:19.40,1:16:22.53,Default,,0,0,0,,Suzu қайда орналасқан? қоңырау
Dialogue: 0,1:16:22.87,1:16:24.99,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:25.29,1:16:27.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:27.66,1:16:29.25,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,1:16:29.33,1:16:33.08,Default,,0,0,0,,Мен әрқашан сенімен бірге боламын Шинобу...
Dialogue: 0,1:16:36.09,1:16:38.13,Default,,0,0,0,,Уф... (ұялы телефонның діріл дыбысы)
Dialogue: 0,1:16:38.76,1:16:41.59,Default,,0,0,0,,Сузу Рю үлкен қиындыққа тап болды.
Dialogue: 0,1:16:50.18,1:16:51.44,Default,,0,0,0,,Айдаһар сарайы...
Dialogue: 0,1:16:51.52,1:16:53.69,Default,,0,0,0,,Ақырында... (Ас) ашылды
Dialogue: 0,1:16:54.11,1:16:59.07,Default,,0,0,0,,(Сарбаздардың айқайы)
Dialogue: 0,1:16:59.32,1:17:01.32,Default,,0,0,0,,Біз жол бермейміз
Dialogue: 0,1:17:01.40,1:17:03.78,Default,,0,0,0,,Айдаһардың шығу тегін жарыққа шығару
Dialogue: 0,1:17:06.99,1:17:11.62,Default,,0,0,0,,Уда тұратындардың барлығының алдында күнәларыңыздың өтелуіне көз жеткізіңіз
Dialogue: 0,1:17:16.13,1:17:18.76,Default,,0,0,0,,Айдаһардың шығу тегі ақыры ашылды.
Dialogue: 0,1:17:18.84,1:17:20.01,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:17:20.09,1:17:21.30,Default,,0,0,0,,Барлығы білгісі келеді
Dialogue: 0,1:17:21.38,1:17:23.72,Default,,0,0,0,,Ол әлі ұсталмаған біртүрлі қылмыскер деген қауесет бар.
Dialogue: 0,1:17:23.80,1:17:26.47,Default,,0,0,0,,Салық төлеуден жалтару арқылы ақша жасайтын кәсіпкер.
Dialogue: 0,1:17:26.55,1:17:28.77,Default,,0,0,0,,Айдаһар, жоғал!
Dialogue: 0,1:17:28.85,1:17:30.68,Default,,0,0,0,,Айдаһарлардың құны жоқ
Dialogue: 0,1:17:30.77,1:17:33.23,Default,,0,0,0,,Айдаһарлардың өмір сүруінің мағынасы жоқ.
Dialogue: 0,1:17:39.78,1:17:41.57,Default,,0,0,0,,Сіз қарап отырсыз ба? Айдаһар
Dialogue: 0,1:17:42.07,1:17:43.99,Default,,0,0,0,,Айдаһарды ересек адам қорлап жатыр
Dialogue: 0,1:17:44.07,1:17:45.37,Default,,0,0,0,,Айдаһарды аяймын
Dialogue: 0,1:17:45.57,1:17:46.99,Default,,0,0,0,,Біреу маған көмектесуін өтінемін
Dialogue: 0,1:17:47.20,1:17:49.12,Default,,0,0,0,,Барлығымыз айдаһарларды қолдаймыз
Dialogue: 0,1:17:49.33,1:17:50.50,Default,,0,0,0,,Әлі уақыт бар
Dialogue: 0,1:17:50.95,1:17:53.46,Default,,0,0,0,,Айдаһарды қолдаймыз...
Dialogue: 0,1:17:54.25,1:17:56.42,Default,,0,0,0,,Сіз қандай қолдау көрсетесіз?
Dialogue: 0,1:17:56.50,1:17:58.71,Default,,0,0,0,,Бұл жігіттердің көру саны бір таңбалы санға жуық.
Dialogue: 0,1:17:58.92,1:18:00.71,Default,,0,0,0,,Тым аз әсер (еркек) Айдаһар жоғалады.
Dialogue: 0,1:18:00.92,1:18:02.55,Default,,0,0,0,,Бірақ тым үмітсіз (ер) Айдаһар Замаа
Dialogue: 0,1:18:02.88,1:18:04.43,Default,,0,0,0,,Ха... (Хирока) Жабық мектепте кездесейік.
Dialogue: 0,1:18:04.63,1:18:05.64,Default,,0,0,0,,Иә
Dialogue: 0,1:18:15.98,1:18:17.36,Default,,0,0,0,,Ах... ах
Dialogue: 0,1:18:21.40,1:18:22.57,Default,,0,0,0,,Ах
Dialogue: 0,1:18:27.03,1:18:28.24,Default,,0,0,0,,Неге...
Dialogue: 0,1:18:29.24,1:18:33.58,Default,,0,0,0,,Қожайыныңызды қорғаңыз...
Dialogue: 0,1:18:36.42,1:18:37.50,Default,,0,0,0,,Ха…
Dialogue: 0,1:18:39.09,1:18:42.34,Default,,0,0,0,,Мен сені айдаһарға апаруым керек дейді.
Dialogue: 0,1:18:42.71,1:18:44.63,Default,,0,0,0,,Қандай сұмдық...
Dialogue: 0,1:18:44.84,1:18:47.47,Default,,0,0,0,,Бұл туралы алаңдамаңыз, бұл бәрібір AI.
Dialogue: 0,1:18:48.47,1:18:49.47,Default,,0,0,0,,Еш жерде
Dialogue: 0,1:18:49.55,1:18:51.31,Default,,0,0,0,,Жетер, кеттік.
Dialogue: 0,1:18:51.64,1:18:52.81,Default,,0,0,0,,Мына қамалды отқа қойыңыз
Dialogue: 0,1:18:52.89,1:18:53.89,Default,,0,0,0,,Ха…
Dialogue: 0,1:18:53.98,1:18:55.27,Default,,0,0,0,,Сіз қайда жасырсаңыз да,
Dialogue: 0,1:18:55.64,1:18:58.52,Default,,0,0,0,,Ол егеуқұйрық сияқты әшкереленеді
Dialogue: 0,1:18:59.06,1:19:00.52,Default,,0,0,0,,Хехехе...
Dialogue: 0,1:19:01.19,1:19:02.82,Default,,0,0,0,,Артында... қара
Dialogue: 0,1:19:03.90,1:19:06.99,Default,,0,0,0,,Тек саған... Мен саған айтамын.
Dialogue: 0,1:19:12.70,1:19:15.87,Default,,0,0,0,,(Қоңыраудың ауыр тыныс алуы)
Dialogue: 0,1:19:21.04,1:19:22.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:23.50,1:19:24.55,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:24.76,1:19:27.26,Default,,0,0,0,,Ууууууууууууу...
Dialogue: 0,1:19:29.14,1:19:31.97,Default,,0,0,0,,Жарайды, тыныштал, уайымдама.
Dialogue: 0,1:19:32.05,1:19:34.18,Default,,0,0,0,,Бұл жерде қауіпті. Бірге қашайық.
Dialogue: 0,1:19:34.52,1:19:36.06,Default,,0,0,0,,Шыдай алсам...
Dialogue: 0,1:19:36.14,1:19:39.15,Default,,0,0,0,,Қанша шыдасаң, жақсы.
Dialogue: 0,1:19:39.23,1:19:40.31,Default,,0,0,0,,Мен?
Dialogue: 0,1:19:41.11,1:19:42.40,Default,,0,0,0,,Қоңырау…
Dialogue: 0,1:19:42.65,1:19:45.49,Default,,0,0,0,,Мен сізге шындықты айта алмаймын... Кешіріңіз
Dialogue: 0,1:19:45.57,1:19:47.24,Default,,0,0,0,,барлығын бірге орналастырыңыз.
Dialogue: 0,1:19:47.32,1:19:48.65,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:20:01.88,1:20:03.75,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,1:20:20.65,1:20:22.73,Default,,0,0,0,,О, Шинобу, мынаны қара.
Dialogue: 0,1:20:22.81,1:20:23.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:23.90,1:20:26.36,Default,,0,0,0,,Бұл U ішіндегі хаос.
Dialogue: 0,1:20:28.03,1:20:29.86,Default,,0,0,0,,Сузу (Синдзиро) Сузу-чан?
Dialogue: 0,1:20:29.95,1:20:31.66,Default,,0,0,0,,Оның қайда кеткенін білесіз бе?
Dialogue: 0,1:20:31.74,1:20:32.74,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:20:32.82,1:20:34.91,Default,,0,0,0,,Эй, мен бұрын Сузу-чанмен бірге болдым.
Dialogue: 0,1:20:34.99,1:20:37.25,Default,,0,0,0,,Мен бастауыш сыныптағы естеліктерімді айттым...
Dialogue: 0,1:20:37.50,1:20:39.66,Default,,0,0,0,,Бұл жерге жақын ба?
Dialogue: 0,1:20:42.50,1:20:43.79,Default,,0,0,0,,Сәлем Шинобу!
Dialogue: 0,1:20:44.09,1:20:46.59,Default,,0,0,0,,Иә, Лука-чан? О, қазірдің өзінде ...
Dialogue: 0,1:20:48.63,1:20:50.17,Default,,0,0,0,,Қоңырау баяу
Dialogue: 0,1:20:50.26,1:20:51.26,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:20:51.51,1:20:53.05,Default,,0,0,0,,Әзірге байланысты болып көрінетін беттер.
Dialogue: 0,1:20:53.14,1:20:54.22,Default,,0,0,0,,Автоматты іздеу іске қосылған
Dialogue: 0,1:20:54.64,1:20:57.72,Default,,0,0,0,,Джастин мен басқалар оны ұстамас бұрын оның шығу тегін табуымыз керек.
Dialogue: 0,1:20:57.81,1:20:58.81,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,1:20:58.89,1:21:00.43,Default,,0,0,0,,5 миллиард шоттан-
Dialogue: 0,1:21:00.52,1:21:02.81,Default,,0,0,0,,Бір адамды табу мүмкін емес.
Dialogue: 0,1:21:03.19,1:21:06.15,Default,,0,0,0,,Ол қайда? Эй, қайда бардың?
Dialogue: 0,1:21:07.44,1:21:08.53,Default,,0,0,0,,Қайда?
Dialogue: 0,1:21:09.61,1:21:10.74,Default,,0,0,0,,Қайда?
Dialogue: 0,1:21:11.03,1:21:12.61,Default,,0,0,0,,А, бұл Белл. (Ас) Белл?
Dialogue: 0,1:21:12.82,1:21:14.49,Default,,0,0,0,,Нақты ма? (А) Ол ақыры келді.
Dialogue: 0,1:21:14.74,1:21:16.24,Default,,0,0,0,,Өте сирек
Dialogue: 0,1:21:17.74,1:21:20.87,Default,,0,0,0,,Тоқта, мен оны табуым керек.
Dialogue: 0,1:21:20.96,1:21:22.96,Default,,0,0,0,,Сұраныс арқылы
Dialogue: 0,1:21:23.04,1:21:24.13,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:24.54,1:21:25.92,Default,,0,0,0,,Қоңырау ақыры шырқалатын сияқты.
Dialogue: 0,1:21:26.00,1:21:27.80,Default,,0,0,0,,Тосын оқиға шын болды
Dialogue: 0,1:21:27.88,1:21:29.13,Default,,0,0,0,,Мен сені күттім, Белл.
Dialogue: 0,1:21:29.21,1:21:30.51,Default,,0,0,0,,Мен Беллдің дауысын естігім келеді
Dialogue: 0,1:21:30.59,1:21:31.88,Default,,0,0,0,,Sing
Dialogue: 0,1:21:32.84,1:21:34.89,Default,,0,0,0,,Дәл қазір барлығы асығыс.
Dialogue: 0,1:21:34.97,1:21:36.35,Default,,0,0,0,,Тегін Belle
Dialogue: 0,1:21:36.72,1:21:37.72,Default,,0,0,0,,Қоршалған
Dialogue: 0,1:21:37.81,1:21:38.89,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,1:21:39.18,1:21:40.81,Default,,0,0,0,,Бірақ мен қазір Сузуға барсам...
Dialogue: 0,1:21:40.89,1:21:42.56,Default,,0,0,0,,Расында, білсең де, табылар
Dialogue: 0,1:21:42.89,1:21:44.06,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:21:44.31,1:21:45.73,Default,,0,0,0,,Кеттік
Dialogue: 0,1:21:45.98,1:21:46.98,Default,,0,0,0,,Иә
Dialogue: 0,1:21:48.32,1:21:50.86,Default,,0,0,0,,Барлығыңыз, қоңырауды соғыңыздар...
Dialogue: 0,1:21:51.49,1:21:54.24,Default,,0,0,0,,Бұл туралы тағы да ойланайық.
Dialogue: 0,1:21:54.32,1:21:55.74,Default,,0,0,0,,Оның шынайы формасы
Dialogue: 0,1:21:55.82,1:21:57.45,Default,,0,0,0,,Ауырды!
Dialogue: 0,1:21:57.99,1:22:01.87,Default,,0,0,0,,Ол сол әйел сияқты жалғыз ортада ма?
Dialogue: 0,1:22:03.16,1:22:04.42,Default,,0,0,0,,Хмм. Нацу-кун, сен жақсы көрінесің.
Dialogue: 0,1:22:05.88,1:22:09.25,Default,,0,0,0,,Мен ғашығымның тыртығына татуировканы салдым.
Dialogue: 0,1:22:10.67,1:22:13.26,Default,,0,0,0,,Ол осылай жасалмаған.
Dialogue: 0,1:22:15.13,1:22:16.34,Default,,0,0,0,,Хмм.
Dialogue: 0,1:22:16.43,1:22:18.64,Default,,0,0,0,,Бірнеше ауыр операцияларды жасады
Dialogue: 0,1:22:18.72,1:22:21.93,Default,,0,0,0,,Дегенмен, ол нағыз жарадан әйтеуір өзгеше.
Dialogue: 0,1:22:22.85,1:22:26.52,Default,,0,0,0,,Құрылғы тірі организмнен қабыну реакциясын қабылдаса...
Dialogue: 0,1:22:26.60,1:22:28.90,Default,,0,0,0,,Нақты денеде де туу белгілері бар шығар.
Dialogue: 0,1:22:29.65,1:22:30.82,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:22:32.44,1:22:35.70,Default,,0,0,0,,Сол кезде сол көгерген жер неге дірілдеп тұрды?
Dialogue: 0,1:22:36.74,1:22:39.74,Default,,0,0,0,,Сіз маған сол уақытты көрсеттіңіз...
Dialogue: 0,1:22:40.03,1:22:41.58,Default,,0,0,0,,Бала тәрізді көздер...
Dialogue: 0,1:22:42.62,1:22:44.66,Default,,0,0,0,,А... бала ма?
Dialogue: 0,1:22:44.75,1:22:47.96,Default,,0,0,0,,(Баланың шуылдауы)
Dialogue: 0,1:22:49.00,1:22:51.05,Default,,0,0,0,,Баланың дауысы (Хирока) Иә?
Dialogue: 0,1:22:51.13,1:22:54.01,Default,,0,0,0,,Бұл әнді тек ол екеуміз ғана білуіміз керек
Dialogue: 0,1:22:54.47,1:22:56.47,Default,,0,0,0,,Қайда? Қайдан естіп жатырсың?
Dialogue: 0,1:22:56.55,1:22:57.64,Default,,0,0,0,,Сузу-чан...
Dialogue: 0,1:22:58.05,1:23:00.05,Default,,0,0,0,,Қайда? Бұл қайда?
Dialogue: 0,1:23:09.52,1:23:15.07,Default,,0,0,0,,(Баланың шуылдауы)
Dialogue: 0,1:23:16.11,1:23:19.53,Default,,0,0,0,,Ха, бұл бала бір жерде...
Dialogue: 0,1:23:21.58,1:23:25.41,Default,,0,0,0,,Айдаһар менің... батырым.
Dialogue: 0,1:23:25.50,1:23:28.04,Default,,0,0,0,,Иә, біз үш адамнан тұратын отбасымыз.
Dialogue: 0,1:23:28.12,1:23:31.54,Default,,0,0,0,,Олар өте жақын достар, анасы болмаса да күш-қуатқа толы.
Dialogue: 0,1:23:31.63,1:23:32.96,Default,,0,0,0,,Бір-біріңді қолдаңдар...
Dialogue: 0,1:23:33.42,1:23:36.22,Default,,0,0,0,,Мына бала... бұл ән неге?
Dialogue: 0,1:23:36.42,1:23:37.43,Default,,0,0,0,,Үлкейту
Dialogue: 0,1:23:53.69,1:23:54.90,Default,,0,0,0,,Қоңырау...
Dialogue: 0,1:23:58.53,1:24:01.28,Default,,0,0,0,,Сонда бұл бала айдаһардың шыққан тегі?
Dialogue: 0,1:24:01.37,1:24:02.66,Default,,0,0,0,,Бірақ бірдеңе дұрыс емес.
Dialogue: 0,1:24:03.03,1:24:04.16,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,1:24:04.24,1:24:06.79,Default,,0,0,0,,Мен бұл оның екеніне сене алар емеспін.
Dialogue: 0,1:24:06.87,1:24:09.00,Default,,0,0,0,,Әрине, көгерген жерлері жоқ сияқты...
Dialogue: 0,1:24:09.21,1:24:10.54,Default,,0,0,0,,Ах
Dialogue: 0,1:24:11.04,1:24:14.71,Default,,0,0,0,,(Білімнің гуілдеуі)
Dialogue: 0,1:24:14.80,1:24:17.38,Default,,0,0,0,,Білім Бұл қандай ән?
Dialogue: 0,1:24:17.67,1:24:22.14,Default,,0,0,0,,Әкеңнің жұмыста жүргенін білмейсің бе?
Dialogue: 0,1:24:22.22,1:24:27.93,Default,,0,0,0,,(Білім шумысы)
Dialogue: 0,1:24:32.06,1:24:34.82,Default,,0,0,0,,Неге мен әкемді тыңдай алмаймын?
Dialogue: 0,1:24:34.90,1:24:37.03,Default,,0,0,0,,Бұл дүниеде ережелер бар.
Dialogue: 0,1:24:37.11,1:24:40.11,Default,,0,0,0,,Бұл үйде әке не айтса, сол ереже.
Dialogue: 0,1:24:40.36,1:24:44.66,Default,,0,0,0,,Соны орындай алмасаң, түкке тұрғысызсың
Dialogue: 0,1:24:45.37,1:24:47.83,Default,,0,0,0,,Мен сізге қайталамайынша түсінбейсіз бе?
Dialogue: 0,1:24:49.21,1:24:50.62,Default,,0,0,0,,Егер сіз білмесеңіз...
Dialogue: 0,1:24:51.67,1:24:53.00,Default,,0,0,0,,Тоқта! (Сузу) Ха...
Dialogue: 0,1:24:53.08,1:24:54.75,Default,,0,0,0,,Чи-кунды кінәламаңыз
Dialogue: 0,1:24:54.84,1:24:56.42,Default,,0,0,0,,Жолдан кет (Мегуми) Тоқта.
Dialogue: 0,1:24:56.50,1:24:57.92,Default,,0,0,0,,Не, мына көздерді алып таста!
Dialogue: 0,1:24:59.34,1:25:00.97,Default,,0,0,0,,Чи-кун, сұрама.
Dialogue: 0,1:25:01.22,1:25:03.89,Default,,0,0,0,,Сіз мұнда кім болуға міндеттісіз деп ойлайсыз?
Dialogue: 0,1:25:03.97,1:25:06.93,Default,,0,0,0,,Кінәлі Чикун емес, менмін.
Dialogue: 0,1:25:07.01,1:25:09.48,Default,,0,0,0,,Мегуми, сен қазір 14-тесің...
Dialogue: 0,1:25:09.56,1:25:11.52,Default,,0,0,0,,Сіз мұны түсінбейсіз бе?
Dialogue: 0,1:25:12.10,1:25:14.06,Default,,0,0,0,,Себебі мен кінәлімін
Dialogue: 0,1:25:14.69,1:25:17.90,Default,,0,0,0,,Жер бетінде сіз қандай құндысыз?
Dialogue: 0,1:25:17.98,1:25:20.32,Default,,0,0,0,,Барлығы, мен кінәлімін...
Dialogue: 0,1:25:20.95,1:25:23.28,Default,,0,0,0,,Сен, қазір жоғал.
Dialogue: 0,1:25:23.36,1:25:25.12,Default,,0,0,0,,Не? Жоғалып кету
Dialogue: 0,1:25:25.20,1:25:27.66,Default,,0,0,0,,Егер ол лайық болмаса, жоғалып кет!
Dialogue: 0,1:25:28.33,1:25:29.33,Default,,0,0,0,,Ха…
Dialogue: 0,1:25:30.41,1:25:32.33,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:33.00,1:25:35.88,Default,,0,0,0,,Мен шыдағанша...
Dialogue: 0,1:25:41.01,1:25:44.30,Default,,0,0,0,,Мен бұл баланы таптым...
Dialogue: 0,1:25:45.76,1:25:46.85,Default,,0,0,0,,Бұл ол.
Dialogue: 0,1:25:52.89,1:25:58.90,Default,,0,0,0,,(Апаттың алдын алу бойынша әкімшілік радио музыкасы)
Dialogue: 0,1:26:00.32,1:26:01.44,Default,,0,0,0,,Хмм.
Dialogue: 0,1:26:05.16,1:26:06.16,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:26:06.45,1:26:08.95,Default,,0,0,0,,Сіз шынымен... ата-анаңызсыз ба?
Dialogue: 0,1:26:10.33,1:26:13.16,Default,,0,0,0,,Мегуми-кун, жақсысың ба? Кей-кун
Dialogue: 0,1:26:13.50,1:26:16.08,Default,,0,0,0,,Көрдім, түсіндім деп ойлаймын.
Dialogue: 0,1:26:16.63,1:26:17.96,Default,,0,0,0,,Кей-куннан Чи-кун-
Dialogue: 0,1:26:18.04,1:26:20.00,Default,,0,0,0,,Мен саған батырды көрсетіп, жігерлендіргім келді.
Dialogue: 0,1:26:20.63,1:26:22.30,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,1:26:23.38,1:26:24.93,Default,,0,0,0,,Айдаһарлар неге сонша күшті?
Dialogue: 0,1:26:25.01,1:26:26.55,Default,,0,0,0,,U денені бөлісу технологиясы - бұл...
Dialogue: 0,1:26:26.64,1:26:29.85,Default,,0,0,0,,Егер бұл басқа жасырын өзін ашатын құрылғы болса...
Dialogue: 0,1:26:29.93,1:26:33.68,Default,,0,0,0,,Бұл езілген жағдай күшке байланысты болды.
Dialogue: 0,1:26:33.98,1:26:36.85,Default,,0,0,0,,Қоңырауға айналған қоңырау сияқты
Dialogue: 0,1:26:52.91,1:26:54.46,Default,,0,0,0,,Қоңырау түсті.
Dialogue: 0,1:26:56.87,1:26:58.96,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,1:27:00.67,1:27:02.42,Default,,0,0,0,,Сіз дауыстарды естисіз бе?
Dialogue: 0,1:27:03.88,1:27:05.76,Default,,0,0,0,,Мен бәрін бақылап отырдым.
Dialogue: 0,1:27:06.38,1:27:08.89,Default,,0,0,0,,Жарайды, енді уайымдама.
Dialogue: 0,1:27:09.60,1:27:12.85,Default,,0,0,0,,Мен... саған келгім келеді
Dialogue: 0,1:27:12.93,1:27:15.18,Default,,0,0,0,,Айтыңызшы, ол қайда?
Dialogue: 0,1:27:15.60,1:27:17.19,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:27:17.60,1:27:19.94,Default,,0,0,0,,Ха... (Хирока) Өмірде бірінші рет кездесіп тұрмыз.
Dialogue: 0,1:27:21.15,1:27:24.36,Default,,0,0,0,,Мен... мен Беллмін.
Dialogue: 0,1:27:24.44,1:27:26.74,Default,,0,0,0,,Қоңырау? (Мегуми) Бұл рас болуы мүмкін емес.
Dialogue: 0,1:27:27.15,1:27:28.66,Default,,0,0,0,,Қоңырау түсті.
Dialogue: 0,1:27:29.32,1:27:30.37,Default,,0,0,0,,Қараңызшы, бұл рас.
Dialogue: 0,1:27:30.45,1:27:33.20,Default,,0,0,0,,Жоқ! Зорлық-зомбылық болған жер (ер) Полицияға хабарлаңыз Ахаха
Dialogue: 0,1:27:33.29,1:27:35.20,Default,,0,0,0,,Полиция? Қоңырау?
Dialogue: 0,1:27:40.21,1:27:43.63,Default,,0,0,0,,Сіз басқалардың құпиясына үңіліп, күлгіңіз келетін адамсыз ба?
Dialogue: 0,1:27:43.71,1:27:45.63,Default,,0,0,0,,Жоқ (Мегуми) Қазір қалай көрінесіз?
Dialogue: 0,1:27:45.71,1:27:47.88,Default,,0,0,0,,Адамдардың қиналғанын көру сізге ұнады ма?
Dialogue: 0,1:27:47.97,1:27:51.93,Default,,0,0,0,,Жоқ, мен сенің күшің болғым келеді.
Dialogue: 0,1:27:52.18,1:27:54.39,Default,,0,0,0,,Сонымен мен қоңырау түймесін бастым.
Dialogue: 0,1:27:55.02,1:27:56.39,Default,,0,0,0,,Мен көмектескім келеді
Dialogue: 0,1:27:56.73,1:27:58.56,Default,,0,0,0,,Анықтама? Қалай?
Dialogue: 0,1:27:58.64,1:27:59.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:00.44,1:28:04.36,Default,,0,0,0,,help help help Мен мұны бұрын бірнеше рет естігенмін
Dialogue: 0,1:28:04.44,1:28:08.24,Default,,0,0,0,,«Мен әкеммен жиі сөйлесемін». «Мен әкеммен сөйлестім».
Dialogue: 0,1:28:08.32,1:28:10.86,Default,,0,0,0,,«Әкем өте жақсы түсінеді».
Dialogue: 0,1:28:10.95,1:28:12.87,Default,,0,0,0,,Бірақ ештеңе істеу мүмкін болмады
Dialogue: 0,1:28:12.95,1:28:16.08,Default,,0,0,0,,Анықтама Көмек Анықтама Эй, бірақ...
Dialogue: 0,1:28:16.70,1:28:18.08,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,1:28:19.71,1:28:23.00,Default,,0,0,0,,сіз ештеңе білмесеңіз де көмекке көмектесіңіз
Dialogue: 0,1:28:23.09,1:28:27.09,Default,,0,0,0,,Анықтама Анықтама. Егер сіз жай ғана ақша төлесеңіз, кез келген нәрсені айта аласыз.
Dialogue: 0,1:28:27.17,1:28:29.17,Default,,0,0,0,,Бірақ көмектес, көмектес, көмектес
Dialogue: 0,1:28:29.26,1:28:32.22,Default,,0,0,0,,«Мен сендерге көмектескім келеді» «Мен сендердің күштерің болғым келеді»
Dialogue: 0,1:28:32.30,1:28:35.93,Default,,0,0,0,,көмек көмек көмек аяушылықтан жылауға көмектесу аяушылықтан жылау
Dialogue: 0,1:28:36.02,1:28:37.73,Default,,0,0,0,,Бірақ соңында ештеңе өзгермейді
Dialogue: 0,1:28:40.27,1:28:43.94,Default,,0,0,0,,Анықтама Анықтама Анықтама Анықтама Анықтама Анықтама
Dialogue: 0,1:28:44.02,1:28:45.07,Default,,0,0,0,,Мен одан шаршадым!
Dialogue: 0,1:28:45.86,1:28:47.07,Default,,0,0,0,,Қазір шығыңыз!
Dialogue: 0,1:28:49.78,1:28:52.53,Default,,0,0,0,,Әй, Мегуми-кун! Эй маған жауап бер
Dialogue: 0,1:28:52.61,1:28:53.62,Default,,0,0,0,,Өшіп қалды (қоңырау) Эй
Dialogue: 0,1:28:53.87,1:28:55.28,Default,,0,0,0,,Қайдасың? маған жауап бер
Dialogue: 0,1:28:55.58,1:28:57.54,Default,,0,0,0,,Оған сенбейді.
Dialogue: 0,1:28:58.66,1:29:01.17,Default,,0,0,0,,Мен саған қайда екенімді ешқашан айтпаймын.
Dialogue: 0,1:29:03.13,1:29:04.63,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:29:21.02,1:29:23.60,Default,,0,0,0,,Шын жүзіңмен ән айт (қоңырау) ха...
Dialogue: 0,1:29:23.85,1:29:25.98,Default,,0,0,0,,Беллге орын беріңіз.
Dialogue: 0,1:29:26.07,1:29:31.99,Default,,0,0,0,,(Ас сөзі)
Dialogue: 0,1:29:37.70,1:29:41.04,Default,,0,0,0,,Мұқият қара, егер ол ән айтса, ол келеді.
Dialogue: 0,1:29:41.58,1:29:44.79,Default,,0,0,0,,Бұрын да солай болатын, ол міндетті түрде келеді.
Dialogue: 0,1:29:45.13,1:29:46.25,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,1:29:53.26,1:29:54.64,Default,,0,0,0,,Хаа…
Dialogue: 0,1:29:57.30,1:30:01.39,Default,,0,0,0,,Қоңырау емес... қоңырау болып шақыр.
Dialogue: 0,1:30:01.60,1:30:03.73,Default,,0,0,0,,Иә? Эй, сен не айтып тұрсың, Шинобу-кун?
Dialogue: 0,1:30:04.02,1:30:07.06,Default,,0,0,0,,Менің ойымша, бұл сізбен қайта байланысудың жалғыз жолы.
Dialogue: 0,1:30:07.31,1:30:10.03,Default,,0,0,0,,Эй, сен не айтып тұрсың? Бұл нені білдіретінін білесіз бе?
Dialogue: 0,1:30:10.11,1:30:12.19,Default,,0,0,0,,Осы уақытқа дейін Сузу жинаған нәрсе...
Dialogue: 0,1:30:12.28,1:30:13.82,Default,,0,0,0,,Барлығы нөлге дейін төмендейді!
Dialogue: 0,1:30:13.90,1:30:14.91,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:15.16,1:30:17.37,Default,,0,0,0,,Бірақ бұл адамдардың сізге сенуінің жалғыз жолы.
Dialogue: 0,1:30:17.74,1:30:20.83,Default,,0,0,0,,Сузу, осы уақытқа дейін не үшін келдің?
Dialogue: 0,1:30:18.16,1:30:20.83,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:30:21.37,1:30:23.54,Default,,0,0,0,,Мен бұрынғы, жақсы емес болмысыма оралуым керек пе?
Dialogue: 0,1:30:23.83,1:30:26.08,Default,,0,0,0,,Мен бұрынғы жылап тұрған күйіме орала аламын ба?
Dialogue: 0,1:30:26.33,1:30:29.55,Default,,0,0,0,,Жақсы ма? (Сузуки) Ууууууууууууууууууу...
Dialogue: 0,1:30:29.63,1:30:31.26,Default,,0,0,0,,Ааах…
Dialogue: 0,1:30:34.09,1:30:37.68,Default,,0,0,0,,Олар өздерінің шынайы болмысын тиімді ашты.
Dialogue: 0,1:30:37.76,1:30:41.22,Default,,0,0,0,,Сузу әлі бетперде киіп жүрсе, олар не істей алады?
Dialogue: 0,1:30:41.85,1:30:45.52,Default,,0,0,0,,Шын жүзіңді жасырсаң не айта аласың?
Dialogue: 0,1:30:48.27,1:30:54.28,Default,,0,0,0,,(Ас сөзі)
Dialogue: 0,1:30:56.20,1:30:58.70,Default,,0,0,0,,Иә, неге ән айтпайсың? Боқ.
Dialogue: 0,1:31:15.88,1:31:19.43,Default,,0,0,0,,Ән сал, ән сал, шіркін айдаһарды тарт
Dialogue: 0,1:31:19.72,1:31:20.80,Default,,0,0,0,,Ән айт!
Dialogue: 0,1:31:23.14,1:31:24.56,Default,,0,0,0,,Уф... не істеп жатырсың?
Dialogue: 0,1:31:24.98,1:31:26.48,Default,,0,0,0,,Жарық шашыңыз Не?
Dialogue: 0,1:31:26.81,1:31:28.69,Default,,0,0,0,,Маған нұрыңды төг!
Dialogue: 0,1:31:33.03,1:31:34.15,Default,,0,0,0,,Не?
Dialogue: 0,1:31:34.40,1:31:38.28,Default,,0,0,0,,Ешкім өзін ашатындай ақымақ емес!
Dialogue: 0,1:31:58.51,1:32:04.51,Default,,0,0,0,,(Астың айқайы)
Dialogue: 0,1:32:15.65,1:32:16.65,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:32:23.24,1:32:25.04,Default,,0,0,0,,Беллдің... Шығу тегі
Dialogue: 0,1:32:28.29,1:32:30.79,Default,,0,0,0,,Мүлдем басқа (As) Сепкілдер бірдей болғанымен...
Dialogue: 0,1:32:31.17,1:32:32.75,Default,,0,0,0,,Қоңырау ашылды
Dialogue: 0,1:32:32.83,1:32:34.59,Default,,0,0,0,,Оны кім ашты?
Dialogue: 0,1:32:34.67,1:32:36.63,Default,,0,0,0,,Жоқ, өзім.
Dialogue: 0,1:32:36.88,1:32:38.59,Default,,0,0,0,,О, құдайым...
Dialogue: 0,1:32:38.92,1:32:41.18,Default,,0,0,0,,Бірақ Белле неге ашылды?
Dialogue: 0,1:32:41.26,1:32:43.72,Default,,0,0,0,,Жоқ, сондықтан мен өзімді әшкереледім.
Dialogue: 0,1:32:43.80,1:32:45.18,Default,,0,0,0,,Мен? (Ас) Неге?
Dialogue: 0,1:32:45.26,1:32:46.39,Default,,0,0,0,,​​Не үшін?
Dialogue: 0,1:32:47.39,1:32:50.56,Default,,0,0,0,,Белле Мен оның қарапайым бала болғанына сене алар емеспін...
Dialogue: 0,1:32:54.23,1:32:57.23,Default,,0,0,0,,Менімен... сен бірдейсің.
Dialogue: 0,1:32:57.65,1:33:00.15,Default,,0,0,0,,Біз жан-жақты қорғап келе жатқан құпиямыз...
Dialogue: 0,1:33:02.99,1:33:04.95,Default,,0,0,0,,Бұл әндерді ойнататын қолданба ма?
Dialogue: 0,1:33:05.99,1:33:07.79,Default,,0,0,0,,О, тоқтат! (Шин) Сузу
Dialogue: 0,1:33:10.00,1:33:16.00,Default,,0,0,0,,(Алғы сөз)
Dialogue: 0,1:33:17.88,1:33:19.26,Default,,0,0,0,,Қоңырауды айт
Dialogue: 0,1:33:19.72,1:33:22.59,Default,,0,0,0,,Мен мұны істей алмаймын. Мен шын жүзіммен кез келген ән айта алатын бала емеспін.
Dialogue: 0,1:33:23.05,1:33:24.05,Default,,0,0,0,,Мен ән айта аламын
Dialogue: 0,1:33:24.30,1:33:25.55,Default,,0,0,0,,Мен ән айта алмаймын!
Dialogue: 0,1:33:25.80,1:33:27.35,Default,,0,0,0,,Сузу (Рука) Сузу-чан
Dialogue: 0,1:33:27.72,1:33:29.68,Default,,0,0,0,,Не істеу керек? (Ёшия) Сузу
Dialogue: 0,1:33:38.19,1:33:44.87,Default,,0,0,0,,♪ Жарқыраған гүл
Dialogue: 0,1:33:45.32,1:33:50.41,Default,,0,0,0,,♪ Армандардың зергері
Dialogue: 0,1:33:52.08,1:33:55.58,Default,,0,0,0,,♪ Дүние
Dialogue: 0,1:33:56.29,1:34:02.01,Default,,0,0,0,,♪ Әдемі
Dialogue: 0,1:34:03.01,1:34:05.80,Default,,0,0,0,,(Астың қошеметі)
Dialogue: 0,1:34:06.51,1:34:12.81,Default,,0,0,0,,♪ Қорқақтық пен алаңдаушылық
Dialogue: 0,1:34:13.35,1:34:18.82,Default,,0,0,0,,♪ Мен байлаулымын, бірақ
Dialogue: 0,1:34:19.27,1:34:24.24,Default,,0,0,0,,♪ Күшті және мейірімді
Dialogue: 0,1:34:24.49,1:34:31.24,Default,,0,0,0,,♪ Егер үйреніп алсаңыз
Dialogue: 0,1:34:35.17,1:34:38.38,Default,,0,0,0,,♪ Сол аспан
Dialogue: 0,1:34:38.71,1:34:40.05,Default,,0,0,0,,Мен қалтырап тұрмын
Dialogue: 0,1:34:40.34,1:34:42.30,Default,,0,0,0,,Ашылмаған, бейшара
Dialogue: 0,1:34:42.38,1:34:45.22,Default,,0,0,0,,Ууууууууууууууууу ♪ Артқа қайтпаймын
Dialogue: 0,1:34:45.22,1:34:47.18,Default,,0,0,0,,♪ Артқа қайтпаймын
Dialogue: 0,1:34:47.26,1:34:48.30,Default,,0,0,0,,Қоңырау
Dialogue: 0,1:34:48.76,1:34:55.02,Default,,0,0,0,,♪ Жалғыз
Dialogue: 0,1:34:56.31,1:35:03.32,Default,,0,0,0,,♪ Мен өмір сүре алмаймын
Dialogue: 0,1:35:05.20,1:35:11.62,Default,,0,0,0,,♪ Мен сенімен тағы кездескім келеді
Dialogue: 0,1:35:12.04,1:35:18.29,Default,,0,0,0,,♪ Жүрегім дірілдеп тұр
Dialogue: 0,1:35:18.79,1:35:22.80,Default,,0,0,0,,♪ Мен осындамын
Dialogue: 0,1:35:22.88,1:35:25.80,Default,,0,0,0,,♪ Қалыңыз
Dialogue: 0,1:35:25.88,1:35:32.81,Default,,0,0,0,,♪ Алыста жүрген саған
Dialogue: 0,1:35:33.01,1:35:39.90,Default,,0,0,0,,♪ Көзімді жұмған кезде ғана
Dialogue: 0,1:35:39.98,1:35:43.36,Default,,0,0,0,,♪ Мен сені кездестіретініме сене алар емеспін
Dialogue: 0,1:35:43.44,1:35:47.07,Default,,0,0,0,,♪ Мен сенбеймін
Dialogue: 0,1:35:47.49,1:35:53.58,Default,,0,0,0,,♪ Мен сені сүйгім келеді
Dialogue: 0,1:35:54.04,1:36:01.04,Default,,0,0,0,,♪ Алыста жүрген саған
Dialogue: 0,1:36:03.21,1:36:09.22,Default,,0,0,0,,(қол шапалақтау мен қошеметпен)
Dialogue: 0,1:36:58.89,1:37:01.10,Default,,0,0,0,,Мама, өтінемін, бармаңыз.
Dialogue: 0,1:37:01.19,1:37:03.94,Default,,0,0,0,,Жоқ, мен баруым керек, бала өледі.
Dialogue: 0,1:37:24.29,1:37:29.46,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:37:30.76,1:37:36.89,Default,,0,0,0,,♪ Ла~ла ла ла~ ла ла ла ла~
Dialogue: 0,1:37:37.14,1:37:42.35,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:37:43.44,1:37:49.65,Default,,0,0,0,,♪ Ла~ла ла ла~ ла ла ла ла~
Dialogue: 0,1:37:49.86,1:37:55.74,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:37:56.32,1:38:02.16,Default,,0,0,0,,♪ Ла~ла ла ла~ ла ла ла ла~
Dialogue: 0,1:38:02.66,1:38:08.04,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:38:09.13,1:38:15.09,Default,,0,0,0,,♪ Ла~ла ла ла~ ла ла ла ла~
Dialogue: 0,1:38:15.47,1:38:19.60,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:38:28.48,1:38:33.74,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:38:34.90,1:38:41.29,Default,,0,0,0,,♪ Ра~ ла ла ла~ ла ла ла ла~
Dialogue: 0,1:38:41.37,1:38:46.67,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:38:47.67,1:38:53.88,Default,,0,0,0,,♪ Ла~ла ла ла~ ла ла ла ла~
Dialogue: 0,1:38:53.97,1:38:58.39,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:39:00.68,1:39:06.65,Default,,0,0,0,,♪ Ла~ла ла ла~ ла ла ла ла~
Dialogue: 0,1:39:06.73,1:39:10.02,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:39:12.11,1:39:13.90,Default,,0,0,0,,Сузу (Синдзиро мен Руканың Ас) Сузу-чан
Dialogue: 0,1:39:13.99,1:39:16.28,Default,,0,0,0,,(Жылау қоңырауы)
Dialogue: 0,1:39:16.57,1:39:19.57,Default,,0,0,0,,Қоңырау, ән айт, тоқтама!
Dialogue: 0,1:39:19.66,1:39:20.74,Default,,0,0,0,,Бұл Пегги Сью.
Dialogue: 0,1:39:20.83,1:39:22.04,Default,,0,0,0,,Иә, бұл Пегги?
Dialogue: 0,1:39:25.66,1:39:27.04,Default,,0,0,0,,Қоңырау ән сал!
Dialogue: 0,1:39:32.30,1:39:37.88,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:39:38.72,1:39:45.02,Default,,0,0,0,,♪ Ла~ла ла ла~ ла ла ла ла~
Dialogue: 0,1:39:45.10,1:39:51.23,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:39:51.48,1:39:57.40,Default,,0,0,0,,(альто-саксофон орындауы)
Dialogue: 0,1:39:58.03,1:40:03.54,Default,,0,0,0,,♪ Ла~ла ла ла~
Dialogue: 0,1:40:04.12,1:40:05.87,Default,,0,0,0,,Не... неге?
Dialogue: 0,1:40:05.95,1:40:08.75,Default,,0,0,0,,Неліктен ол ашылғанымен жойылмайды?
Dialogue: 0,1:40:09.12,1:40:11.38,Default,,0,0,0,,А, а, а...
Dialogue: 0,1:40:12.17,1:40:15.09,Default,,0,0,0,,Қарғыс атсын... Әй.
Dialogue: 0,1:40:15.17,1:40:16.92,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,1:40:17.01,1:40:18.34,Default,,0,0,0,,Не?
Dialogue: 0,1:40:23.60,1:40:26.81,Default,,0,0,0,,(кит дыбысы)
Dialogue: 0,1:40:35.36,1:40:41.36,Default,,0,0,0,,(қол шапалақтау мен қошеметпен)
Dialogue: 0,1:40:57.21,1:41:03.05,Default,,0,0,0,,♪ Ән, баршаға ұш
Dialogue: 0,1:41:03.14,1:41:09.10,Default,,0,0,0,,♪ Мен мұңайып, бақыттымын! қазір
Dialogue: 0,1:41:09.18,1:41:15.06,Default,,0,0,0,,♪ Бұл дүниеде бәрі бар
Dialogue: 0,1:41:15.15,1:41:21.03,Default,,0,0,0,,♪ Көзімді аспанға да түсірдім
Dialogue: 0,1:41:21.11,1:41:26.99,Default,,0,0,0,,♪ Жұлдыздар жарқырап, күн шығады
Dialogue: 0,1:41:27.08,1:41:33.58,Default,,0,0,0,,♪ Гүлдер жайнап тұр, әдемі.
Dialogue: 0,1:41:34.54,1:41:35.67,Default,,0,0,0,,♪ Ән
Dialogue: 0,1:41:37.55,1:41:38.55,Default,,0,0,0,,♪ Ән
Dialogue: 0,1:41:39.05,1:41:40.17,Default,,0,0,0,,♪ Ән
Dialogue: 0,1:41:40.67,1:41:46.60,Default,,0,0,0,,♪ Мен мәңгілікке ән саламын
Dialogue: 0,1:41:46.68,1:41:50.31,Default,,0,0,0,,♪ Әнді жалғастырамын, мен сені сүйемін
Dialogue: 0,1:41:51.06,1:41:58.07,Default,,0,0,0,,♪ Мәңгі
Dialogue: 0,1:41:58.15,1:42:04.16,Default,,0,0,0,,(қол шапалақтау мен қошеметпен)
Dialogue: 0,1:42:25.22,1:42:26.26,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,1:42:26.85,1:42:31.31,Default,,0,0,0,,Кей-кун, мен... Беллмен кездескім келеді.
Dialogue: 0,1:42:32.14,1:42:34.19,Default,,0,0,0,,Бұл шынымен Белл ме?
Dialogue: 0,1:42:34.64,1:42:37.31,Default,,0,0,0,,Мен саған толық сенбедім.
Dialogue: 0,1:42:37.40,1:42:38.40,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,1:42:43.61,1:42:45.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:42:51.08,1:42:52.66,Default,,0,0,0,,Қоңырау? пайда болады?
Dialogue: 0,1:42:54.08,1:42:55.08,Default,,0,0,0,,Қоңырау?
Dialogue: 0,1:42:56.04,1:42:57.04,Default,,0,0,0,,Қоңырау?
Dialogue: 0,1:42:57.13,1:42:58.92,Default,,0,0,0,,Я... (Накай) Я...
Dialogue: 0,1:42:59.46,1:43:01.63,Default,,0,0,0,,Иә!
Dialogue: 0,1:43:02.96,1:43:03.97,Default,,0,0,0,,Қоңырау
Dialogue: 0,1:43:05.80,1:43:07.59,Default,,0,0,0,,Сузудың сезімі маған жетті.
Dialogue: 0,1:43:08.85,1:43:10.14,Default,,0,0,0,,Шинобу-кун
Dialogue: 0,1:43:11.68,1:43:13.02,Default,,0,0,0,,Керемет!
Dialogue: 0,1:43:13.93,1:43:16.19,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:43:17.85,1:43:19.69,Default,,0,0,0,,(хабарламаны қабылдау дыбысы)
Dialogue: 0,1:43:19.77,1:43:22.07,Default,,0,0,0,,(Вазаның сынған дыбысы)
Dialogue: 0,1:43:24.19,1:43:27.20,Default,,0,0,0,,Неліктен мен әкемді тыңдай алмаймын?
Dialogue: 0,1:43:27.86,1:43:29.62,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:43:30.83,1:43:33.20,Default,,0,0,0,,Мына жерге назар аударыңыз... (Есіктің ашылған дыбысы)
Dialogue: 0,1:43:35.83,1:43:36.92,Default,,0,0,0,,​​Солай ма?
Dialogue: 0,1:43:37.00,1:43:38.42,Default,,0,0,0,,Тоқта... тоқта
Dialogue: 0,1:43:38.50,1:43:39.79,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,1:43:40.84,1:43:42.50,Default,,0,0,0,,Жолдан кет! (Даналық) Мегуми
Dialogue: 0,1:43:44.96,1:43:45.97,Default,,0,0,0,,Боқ...
Dialogue: 0,1:43:46.34,1:43:48.09,Default,,0,0,0,,(Байланыстың дыбысы өшіп жатыр)
Dialogue: 0,1:43:51.22,1:43:53.77,Default,,0,0,0,,Бұл балалар қауіпті. (Ёшия) Мен барып, оларды қорғауым керек.
Dialogue: 0,1:43:53.85,1:43:55.14,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:43:55.22,1:43:57.10,Default,,0,0,0,,Мен сұрай алмадым.
Dialogue: 0,1:43:57.48,1:44:00.19,Default,,0,0,0,,Мм... түсінетін шығарсың.
Dialogue: 0,1:44:00.27,1:44:01.27,Default,,0,0,0,,Иә?
Dialogue: 0,1:44:01.48,1:44:04.94,Default,,0,0,0,,Мен жаңа ғана монитордан кешкі әуенді естідім.
Dialogue: 0,1:44:05.03,1:44:06.11,Default,,0,0,0,,Әуен?
Dialogue: 0,1:44:06.19,1:44:10.24,Default,,0,0,0,,Бірі – «күннің батуы» және екіншісі –… «кокос жемісі»
Dialogue: 0,1:44:10.66,1:44:13.24,Default,,0,0,0,,Бұл апаттың алдын алу әкімшілік радиостанциясының тұрақты әуені.
Dialogue: 0,1:44:13.33,1:44:14.33,Default,,0,0,0,,Екі?
Dialogue: 0,1:44:14.41,1:44:16.50,Default,,0,0,0,,Бұл муниципалды шекара болғандықтан, мен екі естідім.
Dialogue: 0,1:44:16.75,1:44:18.50,Default,,0,0,0,,Қайда және қайда? (Шин) Комбинацияны тексеріңіз
Dialogue: 0,1:44:18.92,1:44:21.08,Default,,0,0,0,,Жазба дайын.
Dialogue: 0,1:44:23.88,1:44:30.89,Default,,0,0,0,,(Апаттың алдын алу бойынша әкімшілік радио музыкасы)
Dialogue: 0,1:44:32.01,1:44:33.01,Default,,0,0,0,,Әрине
Dialogue: 0,1:44:33.10,1:44:35.22,Default,,0,0,0,,Лука-чан күткендей, құлағыңыз жақсы.
Dialogue: 0,1:44:35.31,1:44:37.10,Default,,0,0,0,,Иә? Терезенің сыртындағы бұл не?
Dialogue: 0,1:44:37.18,1:44:39.02,Default,,0,0,0,,Не? (Окумото) Оны үлкейтіңіз
Dialogue: 0,1:44:39.98,1:44:42.40,Default,,0,0,0,,Бұл не? (Кита) Ғимарат... пәтер?
Dialogue: 0,1:44:42.48,1:44:45.07,Default,,0,0,0,,Екі? (Накай) Қайда? іздеу
Dialogue: 0,1:44:45.15,1:44:46.57,Default,,0,0,0,,Барлығы ...
Dialogue: 0,1:44:46.65,1:44:47.69,Default,,0,0,0,,Иә? (Рука) А?
Dialogue: 0,1:44:47.78,1:44:49.24,Default,,0,0,0,,Хмм...
Dialogue: 0,1:44:49.32,1:44:52.95,Default,,0,0,0,,Ах, Лука-чан, мен бұл қай жерде екенін білемін.
Dialogue: 0,1:44:53.03,1:44:55.12,Default,,0,0,0,,Иә? (Синдзиро) Бір минут күте тұрыңыз.
Dialogue: 0,1:44:55.20,1:44:57.62,Default,,0,0,0,,Мм, ол қайда? (Хирока) Тезірек.
Dialogue: 0,1:44:58.00,1:45:00.12,Default,,0,0,0,,А, шықты. (Хирока) Бұл бар ма?
Dialogue: 0,1:45:00.42,1:45:02.04,Default,,0,0,0,,5 Токио маңында
Dialogue: 0,1:45:02.13,1:45:05.59,Default,,0,0,0,,Ота Уорд пен Кавасаки Сити арасында көпқабатты үйлер бар.
Dialogue: 0,1:45:05.67,1:45:07.55,Default,,0,0,0,,Иә, бұл солай ма?
Dialogue: 0,1:45:10.43,1:45:12.30,Default,,0,0,0,,Үшеуі де сәйкес келді, сөзсіз.
Dialogue: 0,1:45:12.39,1:45:13.43,Default,,0,0,0,,Жасайық (Синдзиро)
Dialogue: 0,1:45:13.64,1:45:14.64,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,1:45:14.89,1:45:18.77,Default,,0,0,0,,Сәлеметсіз бе? Кешіріңіз, бірақ мен сізге аймақ туралы айтып беремін ...
Dialogue: 0,1:45:18.85,1:45:21.77,Default,,0,0,0,,Тез арада қорғауды қажет ететін балалар бар...
Dialogue: 0,1:45:21.85,1:45:24.56,Default,,0,0,0,,Не, бірден жасай алмайсың ба?
Dialogue: 0,1:45:24.98,1:45:26.27,Default,,0,0,0,,Ережелер?
Dialogue: 0,1:45:26.98,1:45:28.82,Default,,0,0,0,,48 сағат?
Dialogue: 0,1:45:28.90,1:45:31.90,Default,,0,0,0,,Сонымен, егер бұл арада бірдеңе болса...
Dialogue: 0,1:45:31.99,1:45:33.16,Default,,0,0,0,,Менің кетуім керек!
Dialogue: 0,1:45:33.45,1:45:34.70,Default,,0,0,0,,Қоңырау
Dialogue: 0,1:45:35.41,1:45:36.95,Default,,0,0,0,,(Шин) Сузуды станцияға жіберіңіз
Dialogue: 0,1:45:45.59,1:45:47.50,Default,,0,0,0,,Ұшақ уақытында жетпеді.
Dialogue: 0,1:45:47.59,1:45:49.67,Default,,0,0,0,,Сонымен, Токиода қалғың келе ме?
Dialogue: 0,1:45:56.18,1:45:57.85,Default,,0,0,0,,Жалғыз болған дұрыс па?
Dialogue: 0,1:45:57.93,1:45:59.97,Default,,0,0,0,,Өйткені Сузу шешім қабылдады
Dialogue: 0,1:46:04.85,1:46:05.86,Default,,0,0,0,,Әке.
Dialogue: 0,1:46:06.56,1:46:09.03,Default,,0,0,0,,Мен ештеңе айтпастан кетіп қалдым, бірақ...
Dialogue: 0,1:46:09.44,1:46:11.40,Default,,0,0,0,,Мен сәл алысқа барамын.
Dialogue: 0,1:46:14.57,1:46:17.53,Default,,0,0,0,,Мен хор мүшелерінен электрондық хат алдым.
Dialogue: 0,1:46:18.12,1:46:20.29,Default,,0,0,0,,Мен өзімшіл қыз болғаныма өкінемін.
Dialogue: 0,1:46:20.37,1:46:22.00,Default,,0,0,0,,Жағдайлар бар, солай емес пе?
Dialogue: 0,1:46:22.71,1:46:25.33,Default,,0,0,0,,Мен үшін маңызды біреу қиыншылықта
Dialogue: 0,1:46:26.46,1:46:30.09,Default,,0,0,0,,Сіз ол адамға көмектесуге тырысасыз.
Dialogue: 0,1:46:30.51,1:46:33.72,Default,,0,0,0,,Бірақ... көмектесе аламын ба?
Dialogue: 0,1:46:34.22,1:46:35.55,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,1:46:38.81,1:46:40.10,Default,,0,0,0,,Сіз-
Dialogue: 0,1:46:41.68,1:46:45.65,Default,,0,0,0,,Анам кенет жоғалып кетті, мен өзімді жалғыз сезінемін...
Dialogue: 0,1:46:46.90,1:46:49.02,Default,,0,0,0,,Көптен бері шыдап жүрмін.
Dialogue: 0,1:46:50.57,1:46:52.53,Default,,0,0,0,,Менің ойымша, бұл өте қиын болды...
Dialogue: 0,1:46:53.78,1:46:58.32,Default,,0,0,0,,Бірақ осылай... Мен мейірімді бала болып өстім.
Dialogue: 0,1:46:59.58,1:47:02.04,Default,,0,0,0,,Мен өзгенің сезімін түсінетін бала болып өстім.
Dialogue: 0,1:47:05.25,1:47:08.58,Default,,0,0,0,,Сузу-кун-
Dialogue: 0,1:47:09.96,1:47:12.00,Default,,0,0,0,,Анамның тәрбиесінде-
Dialogue: 0,1:47:13.46,1:47:15.76,Default,,0,0,0,,Ол сондай мейірімді балаға айналды.
Dialogue: 0,1:47:19.18,1:47:20.56,Default,,0,0,0,,Сол адамға-
Dialogue: 0,1:47:21.72,1:47:23.52,Default,,0,0,0,,Мейірімді бол
Dialogue: 0,1:47:29.19,1:47:30.48,Default,,0,0,0,,(Хабар жіберу дыбысы)
Dialogue: 0,1:47:33.19,1:47:39.20,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,1:47:40.62,1:47:43.49,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,1:47:59.72,1:48:00.72,Default,,0,0,0,,Ах
Dialogue: 0,1:48:02.22,1:48:05.10,Default,,0,0,0,,Уф...
Dialogue: 0,1:48:19.53,1:48:21.03,Default,,0,0,0,,Бұл жерде ме? (Интеллект) Белл?
Dialogue: 0,1:48:21.12,1:48:22.20,Default,,0,0,0,,Ха…
Dialogue: 0,1:48:23.99,1:48:25.87,Default,,0,0,0,,Келіп... маған бердің бе?
Dialogue: 0,1:48:26.20,1:48:27.46,Default,,0,0,0,,Чи-кун!
Dialogue: 0,1:48:28.29,1:48:29.37,Default,,0,0,0,,Қоңырау!
Dialogue: 0,1:48:36.59,1:48:39.84,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:48:41.80,1:48:44.01,Default,,0,0,0,,Бұл шынымен де... Қоңырау ма?
Dialogue: 0,1:48:55.90,1:48:57.74,Default,,0,0,0,,Эй, сен қайдасың? (Мегуми) Ха...
Dialogue: 0,1:48:58.36,1:48:59.90,Default,,0,0,0,,Мегуми! Білім!
Dialogue: 0,1:49:01.45,1:49:04.49,Default,,0,0,0,,Мегуми, сен неге рұқсатсыз далаға шықтың?
Dialogue: 0,1:49:06.91,1:49:08.25,Default,,0,0,0,,Ол дәл қазір осында—
Dialogue: 0,1:49:08.33,1:49:11.62,Default,,0,0,0,,Оны интернетке шығарған сіз бе?
Dialogue: 0,1:49:11.71,1:49:13.25,Default,,0,0,0,,Сюй мырза
Dialogue: 0,1:49:14.63,1:49:15.67,Default,,0,0,0,,Ха…
Dialogue: 0,1:49:19.80,1:49:21.68,Default,,0,0,0,,Даналық
Dialogue: 0,1:49:21.76,1:49:23.93,Default,,0,0,0,,Үйге қайт. Сіз тыңдай алмайсыз ба?
Dialogue: 0,1:49:24.47,1:49:27.97,Default,,0,0,0,,Ата-анаңды тыңдау табиғи нәрсе, солай емес пе?
Dialogue: 0,1:49:28.52,1:49:30.85,Default,,0,0,0,,Қарғыс атсын мына қызға.
Dialogue: 0,1:49:31.10,1:49:33.19,Default,,0,0,0,,Сіз біздің отбасымызды ыдыратқыңыз келе ме?
Dialogue: 0,1:49:33.27,1:49:34.36,Default,,0,0,0,,Бұл…
Dialogue: 0,1:49:35.56,1:49:37.48,Default,,0,0,0,,Ху мырза (Сузу) Ух...
Dialogue: 0,1:49:37.57,1:49:38.57,Default,,0,0,0,,Уф
Dialogue: 0,1:49:39.11,1:49:40.70,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,1:49:43.45,1:49:44.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:49:54.13,1:49:55.42,Default,,0,0,0,,Уф...
Dialogue: 0,1:49:55.50,1:49:57.59,Default,,0,0,0,,Ахх!
Dialogue: 0,1:50:04.43,1:50:06.35,Default,,0,0,0,,Ммм...
Dialogue: 0,1:50:07.60,1:50:10.47,Default,,0,0,0,,Ахх...
Dialogue: 0,1:50:12.44,1:50:14.52,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:50:16.98,1:50:18.94,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:50:24.36,1:50:25.49,Default,,0,0,0,,Ах...
Dialogue: 0,1:50:26.20,1:50:28.37,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,1:50:36.63,1:50:38.54,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,1:50:43.13,1:50:44.26,Default,,0,0,0,,Қоңырау
Dialogue: 0,1:50:48.01,1:50:50.47,Default,,0,0,0,,Ертерек мені құшақтап алғанда, мен ақыры түсіндім.
Dialogue: 0,1:50:50.93,1:50:53.48,Default,,0,0,0,,Сіз шынымен Беллесіз
Dialogue: 0,1:50:55.48,1:50:57.19,Default,,0,0,0,,Не? Денің сау ма? (Миямура) Иә.
Dialogue: 0,1:50:57.94,1:51:01.48,Default,,0,0,0,,Мен шынымен... сенің келгеніңді қаладым.
Dialogue: 0,1:51:04.03,1:51:06.28,Default,,0,0,0,,Мен сені сағындым, Белл.
Dialogue: 0,1:51:07.95,1:51:09.16,Default,,0,0,0,,Мен де
Dialogue: 0,1:51:18.58,1:51:21.25,Default,,0,0,0,,Сенің тұрғаныңды көріп таң қалдым.
Dialogue: 0,1:51:21.63,1:51:24.59,Default,,0,0,0,,Мен де тұруым керек деп ойладым.
Dialogue: 0,1:51:24.67,1:51:26.88,Default,,0,0,0,,Сонымен... мен төбелесемін.
Dialogue: 0,1:51:29.22,1:51:31.60,Default,,0,0,0,,Мен де сенен тәлім алдың
Dialogue: 0,1:51:31.68,1:51:36.06,Default,,0,0,0,,Менің қорқақ жүрегімді босаттыңыз
Dialogue: 0,1:51:37.23,1:51:38.35,Default,,0,0,0,,Рахмет
Dialogue: 0,1:51:41.44,1:51:43.40,Default,,0,0,0,,Мен сені сүйемін Белл
Dialogue: 0,1:51:44.94,1:51:45.99,Default,,0,0,0,,Рахмет
Dialogue: 0,1:51:46.36,1:51:48.99,Default,,0,0,0,,Белл, сен кереметсің
Dialogue: 0,1:51:49.87,1:51:51.95,Default,,0,0,0,,Сен әдемісің
Dialogue: 0,1:52:06.97,1:52:09.14,Default,,0,0,0,,U басқа шындық
Dialogue: 0,1:52:09.47,1:52:11.51,Default,,0,0,0,,Басқа сіз сияқты
Dialogue: 0,1:52:11.97,1:52:14.81,Default,,0,0,0,,Енді басқа сені өмір сүрейік
Dialogue: 0,1:52:15.10,1:52:18.10,Default,,0,0,0,,Кел, жаңа өмір бастайық
Dialogue: 0,1:52:18.69,1:52:21.36,Default,,0,0,0,,Әлемді өзгертейік
Dialogue: 0,1:52:44.04,1:52:46.17,Default,,0,0,0,,Бүгінгі кешкі ас ше?
Dialogue: 0,1:52:48.97,1:52:50.01,Default,,0,0,0,,Тамақтану
Dialogue: 0,1:52:52.34,1:52:53.85,Default,,0,0,0,,Олай болса жеп алайық.
Dialogue: 0,1:52:56.31,1:52:57.31,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:52:59.27,1:53:00.27,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:53:01.35,1:53:03.27,Default,,0,0,0,,Қоңырау! (қоңырау) А.
Dialogue: 0,1:53:03.69,1:53:05.65,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:53:16.83,1:53:19.00,Default,,0,0,0,,Suzu (Suzu) иә?
Dialogue: 0,1:53:19.08,1:53:22.88,Default,,0,0,0,,Қоңыраудың сол балаларды қорғап тұрғанын көргенде, мен мұны істеу қиын болар деп ойладым.
Dialogue: 0,1:53:24.04,1:53:25.34,Default,,0,0,0,,Бұл тамаша болды
Dialogue: 0,1:53:29.51,1:53:31.43,Default,,0,0,0,,Уф...
Dialogue: 0,1:53:31.51,1:53:33.80,Default,,0,0,0,,Бетіңдегі бұл не?
Dialogue: 0,1:53:34.18,1:53:35.55,Default,,0,0,0,,Енді мені бақылама...
Dialogue: 0,1:53:35.64,1:53:38.35,Default,,0,0,0,,Мен қазірден бастап әдеттегідей араласа алатындай сезінемін.
Dialogue: 0,1:53:38.68,1:53:40.60,Default,,0,0,0,,Мен мұны көптен бері істегім келді.
Dialogue: 0,1:53:54.62,1:53:55.82,Default,,0,0,0,,Рахмет
Dialogue: 0,1:54:12.55,1:54:14.80,Default,,0,0,0,,Ей, бәріміз ән айтып үйге қайтайық.
Dialogue: 0,1:54:14.89,1:54:17.22,Default,,0,0,0,,Жаттығу үшін қолайлы
Dialogue: 0,1:54:17.30,1:54:18.89,Default,,0,0,0,,Концертке дайындық
Dialogue: 0,1:54:18.97,1:54:20.06,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,1:54:20.14,1:54:21.73,Default,,0,0,0,,Ол ән жалғыз, солай ма?
Dialogue: 0,1:54:21.81,1:54:23.31,Default,,0,0,0,,Жарайды, ән.
Dialogue: 0,1:54:23.81,1:54:25.10,Default,,0,0,0,,Қоңырау
Dialogue: 0,1:54:25.52,1:54:26.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:54:26.77,1:54:27.86,Default,,0,0,0,,Көшбасшы болыңыз
Dialogue: 0,1:54:28.27,1:54:29.61,Default,,0,0,0,,Sing
Dialogue: 0,1:54:32.49,1:54:33.53,Default,,0,0,0,,Тыңдау
Dialogue: 0,1:54:36.99,1:54:38.03,Default,,0,0,0,,Иә
Dialogue: 0,1:54:39.33,1:54:40.49,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,1:54:44.96,1:54:50.96,Default,,0,0,0,,♪~
Dialogue: 0,2:00:57.33,2:01:03.34,Default,,0,0,0,,~♪
