Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.50,0:00:36.34,Default,,0,0,0,,Ха~хахаха!➡
Dialogue: 0,0:00:36.34,0:00:39.84,Default,,0,0,0,,Ха~хахаха!))
Dialogue: 0,0:00:42.71,0:00:45.72,Default,,0,0,0,,)
Dialogue: 0,0:00:45.72,0:00:50.19,Default,,0,0,0,,♬～
Dialogue: 0,0:00:50.19,0:00:52.19,Default,,0,0,0,,)
Dialogue: 0,0:00:52.19,0:00:58.86,Default,,0,0,0,,♬～
Dialogue: 0,0:00:58.86,0:01:01.63,Default,,0,0,0,,((Сондай керемет!))
Dialogue: 0,0:01:01.63,0:01:05.13,Default,,0,0,0,,)
Dialogue: 0,0:01:06.54,0:01:08.54,Default,,0,0,0,,)
Dialogue: 0,0:01:14.51,0:01:18.42,Default,,0,0,0,,(Кацуки)
Dialogue: 0,0:01:18.42,0:01:21.89,Default,,0,0,0,,Неге менімен бір дохёда тұрсың!?➡
Dialogue: 0,0:01:21.89,0:01:24.89,Default,,0,0,0,,Сіз не істей аласыз!?))
Dialogue: 0,0:01:29.86,0:01:34.67,Default,,0,0,0,,(Ана)((Кешіріңіз, Изуку! Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:01:34.67,0:01:37.40,Default,,0,0,0,,Уф… ух…))
Dialogue: 0,0:01:50.65,0:01:53.65,Default,,0,0,0,,Тұлғасыз батыр бола аласың ба?
Dialogue: 0,0:01:56.29,0:01:59.29,Default,,0,0,0,,Тіпті даралықсыз адамдар➡
Dialogue: 0,0:01:59.29,0:02:01.39,Default,,0,0,0,,Мен сен сияқты бола аламын ба!?
Dialogue: 0,0:02:01.39,0:02:12.24,Default,,0,0,0,,♬～
Dialogue: 0,0:02:12.24,0:02:14.24,Default,,0,0,0,,Жекелік...
Dialogue: 0,0:02:14.24,0:02:19.24,Default,,0,0,0,,Уф!Гуаааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:02:23.25,0:02:25.75,Default,,0,0,0,,≪О... жоқ≫
Dialogue: 0,0:02:25.75,0:02:29.42,Default,,0,0,0,,≪Қасиетті!≫
Dialogue: 0,0:02:29.42,0:02:31.92,Default,,0,0,0,,Өйткені даралық жоқ...➡
Dialogue: 0,0:02:31.92,0:02:34.93,Default,,0,0,0,,Тек осыған байланысты емес шығар➡
Dialogue: 0,0:02:34.93,0:02:37.86,Default,,0,0,0,,Мені көптен бері мазақ етті...
Dialogue: 0,0:02:37.86,0:02:41.00,Default,,0,0,0,,Сол себепті ме, білмеймін➡
Dialogue: 0,0:02:41.00,0:02:45.87,Default,,0,0,0,,Менің ойымша, адамдарға көмектесу өте керемет.
Dialogue: 0,0:02:45.87,0:02:49.87,Default,,0,0,0,,Ол сізге қорқынышсыз күлкімен көмектеседі➡
Dialogue: 0,0:02:49.87,0:02:53.24,Default,,0,0,0,,Сіздей ең жақсы батырға➡
Dialogue: 0,0:02:53.24,0:02:55.98,Default,,0,0,0,,Мен де...
Dialogue: 0,0:02:55.98,0:02:59.58,Default,,0,0,0,,Ооо...｡
Dialogue: 0,0:03:00.99,0:03:04.02,Default,,0,0,0,,Уау!!
Dialogue: 0,0:03:04.02,0:03:40.49,Default,,0,0,0,,♬～
Dialogue: 0,0:03:43.83,0:04:32.34,Default,,0,0,0,,♬～
Dialogue: 0,0:04:41.19,0:04:45.29,Default,,0,0,0,,Хмм... хмм?➡
Dialogue: 0,0:04:45.29,0:04:49.19,Default,,0,0,0,,Эй, бұл қайда?Жер бетінде не ...
Dialogue: 0,0:04:49.19,0:04:51.20,Default,,0,0,0,,)
Dialogue: 0,0:04:51.20,0:04:53.93,Default,,0,0,0,,Иә, әлгі бейбақ!
Dialogue: 0,0:04:53.93,0:04:56.03,Default,,0,0,0,,)
Dialogue: 0,0:04:56.03,0:04:59.44,Default,,0,0,0,,≪Ол бейбақ кетсе ғой!≫
Dialogue: 0,0:04:59.44,0:05:03.44,Default,,0,0,0,,(Студент) Эй, Кацуки, Мидория екеуің бала кезден дос емессіңдер ме?
Dialogue: 0,0:05:03.44,0:05:06.44,Default,,0,0,0,,Күткендей, бүгін тым көп болды.
Dialogue: 0,0:05:06.44,0:05:09.78,Default,,0,0,0,,Менің жолымда болғаныма кінәлі болдым.
Dialogue: 0,0:05:09.78,0:05:12.18,Default,,0,0,0,,Бұлай ашуланбаңыз.
Dialogue: 0,0:05:14.75,0:05:23.69,Default,,0,0,0,,)
Dialogue: 0,0:05:23.69,0:05:26.73,Default,,0,0,0,,(Кацуки) Сіз жай ғана баласыз және сіз арманшылсыз...
Dialogue: 0,0:05:26.73,0:05:30.13,Default,,0,0,0,,Қайырлы күн!Мен оны көріп ашуланамын!
Dialogue: 0,0:05:30.13,0:05:32.70,Default,,0,0,0,,Каран Каран (2 адам) Я...｡
Dialogue: 0,0:05:32.70,0:05:35.41,Default,,0,0,0,,(Студент) Ендеше, сергіту үшін аркадаға барайық.➡
Dialogue: 0,0:05:35.41,0:05:38.91,Default,,0,0,0,,Кацуки де келеді, солай ма?(Кацуки) Иә?Ах...
Dialogue: 0,0:05:38.91,0:05:42.91,Default,,0,0,0,,(Оқушы) Вокзалдың алдына барайық. Ол жақта үйректер көп.
Dialogue: 0,0:05:42.91,0:05:45.35,Default,,0,0,0,,Жаман адам. (Кацуки) Ах!?➡
Dialogue: 0,0:05:45.35,0:05:48.95,Default,,0,0,0,,Егер ол анықталса, ол менің шағым ретінде тыңдалады!
Dialogue: 0,0:05:48.95,0:05:50.95,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:05:52.36,0:05:56.13,Default,,0,0,0,,Жақсы тұлғаның сыры!
Dialogue: 0,0:05:56.13,0:06:00.97,Default,,0,0,0,,♬～
Dialogue: 0,0:06:00.97,0:06:05.27,Default,,0,0,0,,Уау!!
Dialogue: 0,0:06:06.70,0:06:10.61,Default,,0,0,0,,Шиши... Мен түңілдім!
Dialogue: 0,0:06:10.61,0:06:14.01,Default,,0,0,0,,Не, дәл осы уақытқа дейін... Иә!?
Dialogue: 0,0:06:14.01,0:06:17.68,Default,,0,0,0,,Жалған... Алаяқ!? Хосо~!
Dialogue: 0,0:06:17.68,0:06:20.62,Default,,0,0,0,,Күрсіну... I'm Оллмайт.
Dialogue: 0,0:06:20.62,0:06:25.06,Default,,0,0,0,,Гехо! Апыр-ай!Бұл өтірік!
Dialogue: 0,0:06:25.06,0:06:29.79,Default,,0,0,0,,Бассейнде іш бұлшықеттерін жасай беретін адамдар бар, солай емес пе?
Dialogue: 0,0:06:29.79,0:06:33.56,Default,,0,0,0,,Осымен. Бұл өтірік!
Dialogue: 0,0:06:33.56,0:06:36.63,Default,,0,0,0,,Уф... бұл өтірік.
Dialogue: 0,0:06:36.63,0:06:41.91,Default,,0,0,0,,Оллмайт қорықпайды және әрқашан күлімсіреп көмектеседі➡
Dialogue: 0,0:06:41.91,0:06:45.01,Default,,0,0,0,,Ең жақсы…｡ Phew~｡
Dialogue: 0,0:06:45.01,0:06:47.51,Default,,0,0,0,,Бұл қорқынышсыз күлкі...｡
Dialogue: 0,0:06:51.58,0:06:54.32,Default,,0,0,0,,Көргеннен кейін, балам.
Dialogue: 0,0:06:54.32,0:06:57.32,Default,,0,0,0,,Қателік жасасаңыз да, оны интернетке қоймаңыз.
Dialogue: 0,0:06:57.32,0:07:00.19,Default,,0,0,0,,Бас (көйлек аударылған дыбыс) Эй!
Dialogue: 0,0:07:00.19,0:07:04.23,Default,,0,0,0,,Бұл бес жыл бұрын жау шабуылында алған жарақатым.
Dialogue: 0,0:07:04.23,0:07:08.57,Default,,0,0,0,,Тыныс алу мүшесі жартылай бұзылған, асқазан сөмкесі толығымен жойылған.
Dialogue: 0,0:07:08.57,0:07:12.77,Default,,0,0,0,,Мен қайталанатын операциялар мен кейінгі әсерлерден шаршадым.
Dialogue: 0,0:07:14.21,0:07:17.91,Default,,0,0,0,,Батыр ретіндегі әрекеттерімнің шегі қазір➡
Dialogue: 0,0:07:17.91,0:07:21.41,Default,,0,0,0,,Бұл күніне шамамен 3 сағат.
Dialogue: 0,0:07:21.41,0:07:24.48,Default,,0,0,0,,Осымен... 5 жыл бұрын➡
Dialogue: 0,0:07:24.48,0:07:27.79,Default,,0,0,0,,Сіз улы арамен қашан күрестіңіз?
Dialogue: 0,0:07:27.79,0:07:32.79,Default,,0,0,0,,Мен бұл туралы көп білмеймін. Бірақ ондай қаскөйдің мені ұруына жол бермеймін!
Dialogue: 0,0:07:34.16,0:07:39.96,Default,,0,0,0,,Бұл жарияланбаған. Мен олардан бұны жария етпеулерін өтіндім.
Dialogue: 0,0:07:42.33,0:07:46.57,Default,,0,0,0,,Адамдарды күлімсіреп құтқарыңыз. Бейбітшілік символы – ➡
Dialogue: 0,0:07:46.57,0:07:49.57,Default,,0,0,0,,Ешқашан жамандыққа берілме.
Dialogue: 0,0:07:51.01,0:07:56.38,Default,,0,0,0,,Мені күлдіретіні - батыр болудың қысымы және ➡
Dialogue: 0,0:07:56.38,0:08:00.08,Default,,0,0,0,,Ішіңізде пайда болған қорқыныштан өзіңізді алдау.
Dialogue: 0,0:08:02.39,0:08:05.82,Default,,0,0,0,,Кәсіби мамандар әрқашан өз өмірлерін қатерге тігеді.
Dialogue: 0,0:08:05.82,0:08:08.39,Default,,0,0,0,,Даралықсыз да не мүмкін➡
Dialogue: 0,0:08:08.39,0:08:11.53,Default,,0,0,0,,Шынымен емес, бірақ мен оны айта алмаймын.
Dialogue: 0,0:08:11.53,0:08:15.43,Default,,0,0,0,,♬～
Dialogue: 0,0:08:15.43,0:08:18.17,Default,,0,0,0,,Күрсіну...｡
Dialogue: 0,0:08:18.17,0:08:23.17,Default,,0,0,0,,Адамдарға көмектескіңіз келсе, полиция қызметкері бола аласыз.
Dialogue: 0,0:08:23.17,0:08:26.51,Default,,0,0,0,,Мені «жаман қабылдаушы» деп мазақ етеді➡
Dialogue: 0,0:08:26.51,0:08:29.31,Default,,0,0,0,,Бұл да тамаша жұмыс. ≫Гача (есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:08:31.52,0:08:35.12,Default,,0,0,0,,Армандау жаман емес.
Dialogue: 0,0:08:35.12,0:08:39.62,Default,,0,0,0,,Бірақ соған сәйкес шындыққа да қарау керек, балам.
Dialogue: 0,0:08:39.62,0:08:44.16,Default,,0,0,0,,♬～
Dialogue: 0,0:08:44.16,0:08:46.60,Default,,0,0,0,,Гохо, гохо, гохо.
Dialogue: 0,0:08:46.60,0:08:49.60,Default,,0,0,0,,Енді тезірек мынаны ал... Ха!
Dialogue: 0,0:08:55.04,0:08:58.04,Default,,0,0,0,,≫Бум!(жарылыс дыбысы)
Dialogue: 0,0:09:05.12,0:09:07.95,Default,,0,0,0,,Мүмкін емес...｡
Dialogue: 0,0:09:07.95,0:09:10.55,Default,,0,0,0,,≫Бум!
Dialogue: 0,0:09:12.49,0:09:15.49,Default,,0,0,0,,Жаман!? Сахнада қай кейіпкер!
Dialogue: 0,0:09:18.13,0:09:20.90,Default,,0,0,0,,((Индивидуалдылықсыз да не мүмкін➡
Dialogue: 0,0:09:20.90,0:09:24.30,Default,,0,0,0,,Олай емес, бірақ айта алмаймын))
Dialogue: 0,0:09:26.04,0:09:28.07,Default,,0,0,0,,Күрсіну...｡
Dialogue: 0,0:09:28.07,0:09:32.98,Default,,0,0,0,,♬～
Dialogue: 0,0:09:32.98,0:09:36.61,Default,,0,0,0,,[Спикер] Уау!(Патруль көлігінің сиренасы) Хаа ха ха...
Dialogue: 0,0:09:36.61,0:09:41.29,Default,,0,0,0,,♬～
Dialogue: 0,0:09:41.29,0:09:43.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:43.95,0:09:46.02,Default,,0,0,0,,Бум!Парин!
Dialogue: 0,0:09:46.02,0:09:48.96,Default,,0,0,0,,(Азамат) Иә!(Азамат) Бұл жауыз!
Dialogue: 0,0:09:48.96,0:09:52.30,Default,,0,0,0,,♬～
Dialogue: 0,0:09:52.30,0:09:55.30,Default,,0,0,0,,Уф...｡➡
Dialogue: 0,0:09:55.30,0:09:59.14,Default,,0,0,0,,Гуо~｡ (Десутегоро) Баланы кепілге алу!?➡
Dialogue: 0,0:09:59.14,0:10:01.44,Default,,0,0,0,,Жексұрын~!➡
Dialogue: 0,0:10:03.14,0:10:05.14,Default,,0,0,0,,Хамф!Дау!
Dialogue: 0,0:10:05.14,0:10:07.78,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:07.78,0:10:10.65,Default,,0,0,0,,Бұл не?! Мен оны ұстай алмаймын!
Dialogue: 0,0:10:10.65,0:10:13.52,Default,,0,0,0,,(Хедро Виран) Иә!Гррр...
Dialogue: 0,0:10:13.52,0:10:16.05,Default,,0,0,0,,(Хичкок Вудл) Дестегоро!(Слаггер) Ия!
Dialogue: 0,0:10:16.05,0:10:18.72,Default,,0,0,0,,(Хичкокедудл) Жоқ!(Хедро Виран) Уф!Эй➡
Dialogue: 0,0:10:18.72,0:10:22.69,Default,,0,0,0,,Маған жақындама!(Кацуки) Уф!➡
Dialogue: 0,0:10:22.69,0:10:25.70,Default,,0,0,0,,Уау!➡
Dialogue: 0,0:10:25.70,0:10:28.60,Default,,0,0,0,,Сондай лас адамға➡
Dialogue: 0,0:10:28.60,0:10:31.60,Default,,0,0,0,,Мен мас боламын ба?
Dialogue: 0,0:10:31.60,0:10:34.71,Default,,0,0,0,,Қайырлы күн!Мінеки біз!
Dialogue: 0,0:10:34.71,0:10:36.74,Default,,0,0,0,,Құтты болсын!Бум!!
Dialogue: 0,0:10:36.74,0:10:40.71,Default,,0,0,0,,(Дестегоро) Уф!(Hitch-cockoo-doodle) Ооо!
Dialogue: 0,0:10:40.71,0:10:45.38,Default,,0,0,0,,(Хедро Виран) ≪Үлкен күш. Бұл үлкен хит.➡
Dialogue: 0,0:10:45.38,0:10:47.95,Default,,0,0,0,,Осы даралықпен және күшпен➡
Dialogue: 0,0:10:47.95,0:10:50.96,Default,,0,0,0,,Мен одан кек ала аламын!≫
Dialogue: 0,0:10:50.96,0:10:53.12,Default,,0,0,0,,Бұл таңқаларлық. Бұл не?
Dialogue: 0,0:10:53.12,0:10:56.29,Default,,0,0,0,,Бұл кездейсоқ үлкен атау емес пе?О, міне!➡
Dialogue: 0,0:10:56.29,0:10:58.80,Default,,0,0,0,,Жаңадан келген кейіпкер Mt. Lady!
Dialogue: 0,0:10:58.80,0:11:01.53,Default,,0,0,0,,Ха!Күте тұрыңыз... бір сәт➡
Dialogue: 0,0:11:01.53,0:11:04.67,Default,,0,0,0,,Мен: Екі немесе одан да көп жолақ болмаса, бұл мүмкін емес.
Dialogue: 0,0:11:04.67,0:11:08.54,Default,,0,0,0,,Ахх... Уау!
Dialogue: 0,0:11:08.54,0:11:12.28,Default,,0,0,0,,(Шинринкамуи) Қарғыс атсын... Жарылғыш жалын - менің әлсіз жерім.➡
Dialogue: 0,0:11:12.28,0:11:14.75,Default,,0,0,0,,Бүгін оны басқа біреуге тапсырайық!
Dialogue: 0,0:11:14.75,0:11:17.75,Default,,0,0,0,,(Фон жобасы) Бұл үшін рахмет. Өртті сөндіруге қолым тоқ.➡
Dialogue: 0,0:11:17.75,0:11:20.75,Default,,0,0,0,,Өрт сөндіру көлігі әлі?Не болып жатыр?
Dialogue: 0,0:11:20.75,0:11:23.12,Default,,0,0,0,,Ол жабысқақ, мен оны ұстай алмаймын➡
Dialogue: 0,0:11:23.12,0:11:26.12,Default,,0,0,0,,Мінезі жақсы бала қарсылық көрсетіп, күресуде!
Dialogue: 0,0:11:26.12,0:11:30.06,Default,,0,0,0,,(Слаггер) Сізге рахмет, бұл мина алаңы.Біз жолдан ештеңе шығара алмайтын үштік жағдайға тап болдық!
Dialogue: 0,0:11:30.06,0:11:35.10,Default,,0,0,0,,♬～
Dialogue: 0,0:11:35.10,0:11:37.67,Default,,0,0,0,,(Слаггер) Иә! (Хедро Виран) Уау!
Dialogue: 0,0:11:37.67,0:11:41.24,Default,,0,0,0,,(Дестегоро) Жақсы емес. Егер сіз мұны шеше алмасаңыз, дәл қазір осында болмаңыз!
Dialogue: 0,0:11:41.24,0:11:45.18,Default,,0,0,0,,(Hitchy Dog) Біздің қолымыздан келетіні тек жақсы мінезі бар біреудің келуін күту!
Dialogue: 0,0:11:45.18,0:11:47.75,Default,,0,0,0,,Оған дейін зиянды шектейік.➡
Dialogue: 0,0:11:47.75,0:11:50.75,Default,,0,0,0,,Жақында біреу келеді!➡
Dialogue: 0,0:11:50.75,0:11:54.12,Default,,0,0,0,,Мен ол балаға ренжідім, бірақ одан біраз шыдауын сұрайық.
Dialogue: 0,0:11:54.12,0:11:56.22,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:11:56.22,0:12:00.12,Default,,0,0,0,,(Дестегоро) ≪Айдаһарларды ұшыруға күшім жетсе ғой!≫
Dialogue: 0,0:12:00.12,0:12:02.69,Default,,0,0,0,,Эй, бұл біртүрлі сезім, солай емес пе?
Dialogue: 0,0:12:02.69,0:12:04.70,Default,,0,0,0,,Сәттілік, батыр!
Dialogue: 0,0:12:04.70,0:12:11.44,Default,,0,0,0,,♬～
Dialogue: 0,0:12:11.44,0:12:14.14,Default,,0,0,0,,>
Dialogue: 0,0:12:14.14,0:12:17.47,Default,,0,0,0,,≪Мен белсенділік уақытыммен алаңдадым≫
Dialogue: 0,0:12:17.47,0:12:22.37,Default,,0,0,0,,≪Жанкүйерлерді ескертіңіз. Қандай қателік!Өкінішті≫
Dialogue: 0,0:12:24.11,0:12:26.11,Default,,0,0,0,,<< Өкінішті!≫
Dialogue: 0,0:14:42.54,0:14:44.54,Default,,0,0,0,,((Орта мектептің үшінші курсында да➡
Dialogue: 0,0:14:44.54,0:14:47.31,Default,,0,0,0,,Ол әлі шындықты көре алмайды))
Dialogue: 0,0:14:47.31,0:14:49.31,Default,,0,0,0,,((Шынымен➡
Dialogue: 0,0:14:49.31,0:14:52.21,Default,,0,0,0,,Болашақты ойлайтын кез келді))
Dialogue: 0,0:14:52.21,0:14:55.58,Default,,0,0,0,,)
Dialogue: 0,0:14:55.58,0:14:57.58,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:14:57.58,0:15:01.46,Default,,0,0,0,,≪Тіпті жоғарғы кәсіпқойларға да айтылады≫
Dialogue: 0,0:15:01.46,0:15:05.06,Default,,0,0,0,,<<Жылама!Сіз білдіңіз бе?Шындық≫
Dialogue: 0,0:15:06.46,0:15:09.53,Default,,0,0,0,,≪Менің ойымша, ол білгендіктен үмітсіз болды≫
Dialogue: 0,0:15:09.53,0:15:13.23,Default,,0,0,0,,≪Қарама, қарама≫
Dialogue: 0,0:15:13.23,0:15:15.63,Default,,0,0,0,,≫Бум!
Dialogue: 0,0:15:17.07,0:15:21.07,Default,,0,0,0,,≪Осы жерде жарылыс бұрын болды ма?≫
Dialogue: 0,0:15:21.07,0:15:24.81,Default,,0,0,0,,≪Ей, сен мұнда әдетіңнен келдің бе?≫
Dialogue: 0,0:15:24.81,0:15:27.38,Default,,0,0,0,,Dokun dokun dokunun…(жүрек соғысы)
Dialogue: 0,0:15:27.38,0:15:30.72,Default,,0,0,0,,≪Қазір тоқтатыңыз. Бұл сізді бос сезінеді≫
Dialogue: 0,0:15:30.72,0:15:32.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:32.72,0:15:34.72,Default,,0,0,0,,≪Неге ол жігіт!?≫
Dialogue: 0,0:15:34.72,0:15:38.22,Default,,0,0,0,,≪Ha, Оллмайт?Сіз қашып үлгердіңіз бе?≫
Dialogue: 0,0:15:41.73,0:15:45.43,Default,,0,0,0,,≪ Сіз оны тастадыңыз ба?Олай болса...≫
Dialogue: 0,0:15:46.77,0:15:49.74,Default,,0,0,0,,Бұл менің кінәм...
Dialogue: 0,0:15:49.74,0:15:52.11,Default,,0,0,0,,Батыр: Неге биік тұрсың?
Dialogue: 0,0:15:52.11,0:15:55.54,Default,,0,0,0,,(Азамат) Қолымнан келмейді. Кіші мектеп оқушысы қамауға алынды.➡
Dialogue: 0,0:15:55.54,0:15:58.18,Default,,0,0,0,,Мәңгі солай болды.
Dialogue: 0,0:15:58.18,0:16:01.95,Default,,0,0,0,,≪Ұсталғанын айтты... Мәңгі солай болды...≫
Dialogue: 0,0:16:01.95,0:16:04.92,Default,,0,0,0,,≪Осындай азапқа шыдап жүрсің бе!?≫
Dialogue: 0,0:16:04.92,0:16:08.22,Default,,0,0,0,,≪Мен тіпті бірнеше секунд ішінде өлемін деп ойладым≫
Dialogue: 0,0:16:09.66,0:16:12.56,Default,,0,0,0,,Керемет... (Азамат) Цуука Сол жауыз➡
Dialogue: 0,0:16:12.56,0:16:15.46,Default,,0,0,0,,Бұрын Оллмайт қуған жігіт емес пе?
Dialogue: 0,0:16:15.46,0:16:18.53,Default,,0,0,0,,Барлығы мүмкін!? Өтірік!Келесің бе?
Dialogue: 0,0:16:18.53,0:16:22.14,Default,,0,0,0,,Мен оны біраз бұрын көрдім. Шынымен!?➡
Dialogue: 0,0:16:22.14,0:16:24.71,Default,,0,0,0,,Сонымен не істеп жатырсың?Оллмайт.
Dialogue: 0,0:16:24.71,0:16:26.71,Default,,0,0,0,,Өтірік өтірік. Қайда?қайда?иә?
Dialogue: 0,0:16:26.71,0:16:31.31,Default,,0,0,0,,(Доёмеки)
Dialogue: 0,0:16:31.31,0:16:35.11,Default,,0,0,0,,>
Dialogue: 0,0:16:36.32,0:16:38.95,Default,,0,0,0,,≪Өкінішті≫
Dialogue: 0,0:16:38.95,0:16:41.39,Default,,0,0,0,,≪Мен ол жігітті ұстай алмаймын≫
Dialogue: 0,0:16:41.39,0:16:44.69,Default,,0,0,0,,≪Тұлғасы жақсы кейіпкерді күтуден басқа амалымыз жоқ!≫
Dialogue: 0,0:16:46.19,0:16:48.33,Default,,0,0,0,,≪Өкінішті≫
Dialogue: 0,0:16:48.33,0:16:53.10,Default,,0,0,0,,≪Сәттілік. Кешіріңіз... кешіріңіз≫
Dialogue: 0,0:16:53.10,0:16:55.10,Default,,0,0,0,,<< Өкінішті!≫
Dialogue: 0,0:16:55.10,0:16:58.44,Default,,0,0,0,,≪Жақында көмек келеді≫
Dialogue: 0,0:16:58.44,0:17:00.44,Default,,0,0,0,,≪Өкінішті≫
Dialogue: 0,0:17:00.44,0:17:03.78,Default,,0,0,0,,≪Жақында біреу батыр болады!≫
Dialogue: 0,0:17:03.78,0:17:15.78,Default,,0,0,0,,♬～
Dialogue: 0,0:17:20.46,0:17:22.63,Default,,0,0,0,,Не!(3 адам) Не!
Dialogue: 0,0:17:22.63,0:17:26.47,Default,,0,0,0,,Аһ!Хахаха...｡
Dialogue: 0,0:17:26.47,0:17:30.44,Default,,0,0,0,,Ақымақ!Тоқта, тоқта!
Dialogue: 0,0:17:30.44,0:17:34.07,Default,,0,0,0,,(Хедоро Байран) Әлгі бала... (Кацуки) Деку?
Dialogue: 0,0:17:34.07,0:17:38.91,Default,,0,0,0,,≪Неге шықты?Сен не істеп жатырсың!неге!≫
Dialogue: 0,0:17:38.91,0:17:41.68,Default,,0,0,0,,(Хедро Виран) Бұл жарылыс!Эй!
Dialogue: 0,0:17:41.68,0:17:44.68,Default,,0,0,0,,≪Мен не істеуім керек? Не істеуім керек?Осындай кездерде...≫
Dialogue: 0,0:17:46.05,0:17:48.76,Default,,0,0,0,,<<25 бет!≫
Dialogue: 0,0:17:48.76,0:17:51.43,Default,,0,0,0,,Ұялшақ!
Dialogue: 0,0:17:51.43,0:17:54.43,Default,,0,0,0,,Арх... Арх!
Dialogue: 0,0:17:54.43,0:17:57.03,Default,,0,0,0,,Аһ!Гохо гохо.
Dialogue: 0,0:17:58.47,0:18:02.44,Default,,0,0,0,,Качан!Арх!Неліктен?
Dialogue: 0,0:18:02.44,0:18:06.44,Default,,0,0,0,,Менің аяғым өздігінен қозғалады!Неге екенін білмеймін!
Dialogue: 0,0:18:11.01,0:18:13.15,Default,,0,0,0,,(Дәрігер)((Бұдан бас тартқан дұрыс)) ((Бұл менің кінәм...))
Dialogue: 0,0:18:13.15,0:18:15.92,Default,,0,0,0,,(Кацуки)((Сен неге менімен бір дохёда тұрсың!?))
Dialogue: 0,0:18:15.92,0:18:18.92,Default,,0,0,0,,((Мен тырысуым керек...)) ((Сәйкес шындықты көруім керек))
Dialogue: 0,0:18:18.92,0:18:21.66,Default,,0,0,0,,)
Dialogue: 0,0:18:25.66,0:18:29.63,Default,,0,0,0,,Сіз көмек сұрап тұрған сияқтысыз.
Dialogue: 0,0:18:29.63,0:18:33.07,Default,,0,0,0,,♬～
Dialogue: 0,0:18:33.07,0:18:36.90,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:36.90,0:18:39.64,Default,,0,0,0,,Өкінішті.
Dialogue: 0,0:18:39.64,0:18:42.41,Default,,0,0,0,,Өкінішті!
Dialogue: 0,0:18:42.41,0:18:45.08,Default,,0,0,0,,Кішкене ғана➡
Dialogue: 0,0:18:45.08,0:18:47.11,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,0:18:47.11,0:18:50.08,Default,,0,0,0,,Бекер өл!Сіз өз-өзіне қол жұмсауға дайынсыз ба?
Dialogue: 0,0:18:50.08,0:18:52.75,Default,,0,0,0,,Доон!!
Dialogue: 0,0:18:52.75,0:18:57.82,Default,,0,0,0,,♬～
Dialogue: 0,0:18:57.82,0:19:00.19,Default,,0,0,0,,Аһ!
Dialogue: 0,0:19:00.19,0:19:02.59,Default,,0,0,0,,Бұл шынымен аянышты.
Dialogue: 0,0:19:04.76,0:19:06.83,Default,,0,0,0,,Бәрі мүмкін...｡
Dialogue: 0,0:19:06.83,0:19:09.64,Default,,0,0,0,,Мен сізге айтайын➡
Dialogue: 0,0:19:09.64,0:19:12.64,Default,,0,0,0,,Мен оны іс жүзінде қолданбағаныма сене алмаймын!
Dialogue: 0,0:19:12.64,0:19:16.54,Default,,0,0,0,,♬～
Dialogue: 0,0:19:16.54,0:19:21.41,Default,,0,0,0,,Кәсіби мамандар әрқашан өз өмірлерін қатерге тігеді!
Dialogue: 0,0:19:21.41,0:19:23.48,Default,,0,0,0,,Бәрі мүмкін!
Dialogue: 0,0:19:23.48,0:19:27.58,Default,,0,0,0,,"DETROIT SMASH"!!
Dialogue: 0,0:19:30.02,0:19:34.03,Default,,0,0,0,,(Ханым тауы) Арх!(Барлығы) Арх!
Dialogue: 0,0:19:34.03,0:19:46.03,Default,,0,0,0,,♬～
Dialogue: 0,0:19:47.74,0:19:53.24,Default,,0,0,0,,Ха ха ха ха ха ха...｡
Dialogue: 0,0:20:01.56,0:20:03.56,Default,,0,0,0,,Ах. Жаңбыр?
Dialogue: 0,0:20:03.56,0:20:07.29,Default,,0,0,0,,Ахх... (Жаңбыр естіледі) (Азамат) Қазіргі жел қысымына сене алар емеспін...
Dialogue: 0,0:20:07.29,0:20:09.30,Default,,0,0,0,,Жоғары ағын пайда болады...
Dialogue: 0,0:20:09.30,0:20:13.30,Default,,0,0,0,,Гүрілдеу...(Гүркіреу)
Dialogue: 0,0:20:13.30,0:20:16.67,Default,,0,0,0,,Бұлттарды жаратты ма?
Dialogue: 0,0:20:16.67,0:20:22.31,Default,,0,0,0,,♬～
Dialogue: 0,0:20:22.31,0:20:25.31,Default,,0,0,0,,(Азамат) Эй, эй, эй!(Азаматтар) Уау!
Dialogue: 0,0:20:25.31,0:20:28.98,Default,,0,0,0,,(Азамат) Бір оң қолмен ауа райы өзгерді!
Dialogue: 0,0:20:28.98,0:20:32.45,Default,,0,0,0,,Керемет!Бұл бәрі мүмкін!
Dialogue: 0,0:20:32.45,0:20:39.13,Default,,0,0,0,,♬～
Dialogue: 0,0:20:39.13,0:20:45.60,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:20:45.60,0:20:50.24,Default,,0,0,0,,＜ Осыдан кейін шашыраңқы жабысқақ заттарды батырлар жинады ➡
Dialogue: 0,0:20:50.24,0:20:53.34,Default,,0,0,0,,Оны полиция аман-есен алып кеткен сияқты>
Dialogue: 0,0:20:53.34,0:20:57.24,Default,,0,0,0,,Паша Паша Паша Паша…
Dialogue: 0,0:20:57.24,0:21:00.15,Default,,0,0,0,,Мүлдем шектен шыққан!
Dialogue: 0,0:21:00.15,0:21:04.25,Default,,0,0,0,,(Дестегоро) Тәуекел етудің қажеті жоқ еді!
Dialogue: 0,0:21:04.25,0:21:07.29,Default,,0,0,0,,<Батырларға қатты ашуландым➡
Dialogue: 0,0:21:07.29,0:21:10.22,Default,,0,0,0,,Керісінше, Каччан мақталды>
Dialogue: 0,0:21:10.22,0:21:13.86,Default,,0,0,0,,(Hitchy Dog) Ол өте қатал!Және бұл тұлға!➡
Dialogue: 0,0:21:13.86,0:21:16.70,Default,,0,0,0,,Кәсіби маман болған кезде, менің кеңсеме келіңіз!➡
Dialogue: 0,0:21:16.70,0:21:19.80,Default,,0,0,0,,Сіз тамаша серіктес бола аласыз!
Dialogue: 0,0:21:36.42,0:21:40.32,Default,,0,0,0,,<<Күрсінді~｡ Мен Оллмайт-тен кешірім сұрағым келді, бірақ➡
Dialogue: 0,0:21:40.32,0:21:43.86,Default,,0,0,0,,Сұхбат жалғасын тапты... Қайтып оралғанда➡
Dialogue: 0,0:21:43.86,0:21:46.43,Default,,0,0,0,,Басты беттен хабар жіберіңіз≫
Dialogue: 0,0:21:46.43,0:21:49.20,Default,,0,0,0,,≪(Кацуки) Деку!Ах.
Dialogue: 0,0:21:49.20,0:21:51.93,Default,,0,0,0,,Качан?(Кацуки) Хахахаха...➡
Dialogue: 0,0:21:51.93,0:21:55.57,Default,,0,0,0,,Күрсін... Күрсін...
Dialogue: 0,0:21:55.57,0:21:59.67,Default,,0,0,0,,Мен шынымен де көмек сұрамаймын.
Dialogue: 0,0:21:59.67,0:22:02.01,Default,,0,0,0,,Мен сізге көмектесе алмаймын!
Dialogue: 0,0:22:02.01,0:22:05.11,Default,,0,0,0,,Ах!? Эй!Мен мұны жалғыз жасай алдым.
Dialogue: 0,0:22:05.11,0:22:08.08,Default,,0,0,0,,Өзіңіздің жеке даралығыңыз бен сәтсіздігіңізге төмен қарамаңыз.
Dialogue: 0,0:22:08.08,0:22:10.58,Default,,0,0,0,,Сатайық!?
Dialogue: 0,0:22:10.58,0:22:13.25,Default,,0,0,0,,Маған төмен қарама!➡
Dialogue: 0,0:22:13.25,0:22:16.26,Default,,0,0,0,,Нерд!
Dialogue: 0,0:22:16.26,0:22:18.26,Default,,0,0,0,,Қаттылық…｡
Dialogue: 0,0:22:21.19,0:22:23.26,Default,,0,0,0,,>
Dialogue: 0,0:22:23.26,0:22:26.67,Default,,0,0,0,,≪Мен ештеңе істей алмадым немесе ештеңені өзгерте алмадым.≫
Dialogue: 0,0:22:26.67,0:22:29.30,Default,,0,0,0,,≪Бірақ бұл жақсы болды≫
Dialogue: 0,0:22:29.30,0:22:32.24,Default,,0,0,0,,≪Енді сіз өзіңізге қолайлы болашаққа ие бола аласыз...≫
Dialogue: 0,0:22:32.24,0:22:34.64,Default,,0,0,0,,Мен осындамын!Апыр-ай!
Dialogue: 0,0:22:34.64,0:22:37.78,Default,,0,0,0,,О... Бәрі мүмкін!? Неге мұндасың?
Dialogue: 0,0:22:37.78,0:22:40.58,Default,,0,0,0,,Осы уақытқа дейін мен журналистердің қоршауында болдым...
Dialogue: 0,0:22:40.58,0:22:44.58,Default,,0,0,0,,Ha~hahaha!Түсінбейтіндігі сонша, мен оны жеңе алмаймын.
Dialogue: 0,0:22:44.58,0:22:47.29,Default,,0,0,0,,Өйткені мен➡
Dialogue: 0,0:22:47.29,0:22:51.16,Default,,0,0,0,,Барлық менің... Geho.Апыр-ай!
Dialogue: 0,0:22:51.16,0:22:53.76,Default,,0,0,0,,Гохогохо гохо...｡
Dialogue: 0,0:22:55.76,0:22:58.70,Default,,0,0,0,,Бала… Рахмет және түзету ➡
Dialogue: 0,0:22:58.70,0:23:02.37,Default,,0,0,0,,Ал мен ұсыныс жасауға келдім. иә?
Dialogue: 0,0:23:02.37,0:23:06.81,Default,,0,0,0,,Егер сіз болмасаңыз... Егер сіздің жағдайыңызды естімеген болсам➡
Dialogue: 0,0:23:06.81,0:23:09.84,Default,,0,0,0,,Бұл өтірік әңгіме болып шықты.
Dialogue: 0,0:23:09.84,0:23:12.25,Default,,0,0,0,,Рахмет. Міне бітті!
Dialogue: 0,0:23:12.25,0:23:15.15,Default,,0,0,0,,Біріншіден, бұл менің кінәм болды.
Dialogue: 0,0:23:15.15,0:23:18.85,Default,,0,0,0,,Мінезім жоқ болса да, жұмысыма кедергі жасау➡
Dialogue: 0,0:23:18.85,0:23:22.02,Default,,0,0,0,,Бірдеңе айт... Иә.
Dialogue: 0,0:23:22.02,0:23:27.59,Default,,0,0,0,,Сіз ондағы ешкімге ұқсамайтын, даралығы жоқ қорқақ адам едіңіз➡
Dialogue: 0,0:23:27.59,0:23:29.59,Default,,0,0,0,,Мен қозғалдым.
Dialogue: 0,0:23:32.53,0:23:36.37,Default,,0,0,0,,Басты қаһармандар артына студенттік кезден қалған анекдоттарды қалдырды.
Dialogue: 0,0:23:36.37,0:23:39.57,Default,,0,0,0,,Олардың көпшілігі әңгімелерін осылай аяқтайды.
Dialogue: 0,0:23:42.38,0:23:46.78,Default,,0,0,0,,​​Менің денем ойланбай тұрып қозғалды.
Dialogue: 0,0:23:46.78,0:23:55.79,Default,,0,0,0,,♬～
Dialogue: 0,0:24:00.83,0:24:06.33,Default,,0,0,0,,(Ана)((Кешіріңіз, Изуку! Кешіріңіз... Кешіріңіз))
Dialogue: 0,0:24:08.80,0:24:11.70,Default,,0,0,0,,Сіз де солай болдыңыз, солай ма?
Dialogue: 0,0:24:13.81,0:24:17.31,Default,,0,0,0,,Иә!Уф...
Dialogue: 0,0:24:29.32,0:24:33.93,Default,,0,0,0,,♬～
Dialogue: 0,0:24:33.93,0:24:37.23,Default,,0,0,0,,Сіз батыр бола аласыз.
Dialogue: 0,0:24:39.77,0:24:44.57,Default,,0,0,0,,Уау!Уф...
Dialogue: 0,0:24:51.64,0:24:55.48,Default,,0,0,0,,<Мен бұл туралы айтуды ұмытып кеттім, бірақ бұл➡
Dialogue: 0,0:24:55.48,0:24:58.98,Default,,0,0,0,,Бұл менің ең жақсы қаһарман болғанымның тарихы.
Dialogue: 0,0:25:01.49,0:25:40.46,Default,,0,0,0,,♬～
Dialogue: 0,0:25:45.60,0:26:29.79,Default,,0,0,0,,♬～
Dialogue: 0,0:28:03.50,0:28:07.37,Default,,0,0,0,,Бала!Сіз менің билігімді иеленуге лайықсыз!
Dialogue: 0,0:28:07.37,0:28:10.71,Default,,0,0,0,,Билікті мұраға алу!? Алыңыз➡
Dialogue: 0,0:28:10.71,0:28:13.75,Default,,0,0,0,,Менің мінезім: Біреуі бәрі үшін!
Dialogue: 0,0:28:13.75,0:28:16.72,Default,,0,0,0,,Енді мен де батыр бола аламын!
Dialogue: 0,0:28:16.72,0:28:19.72,Default,,0,0,0,,Хахахаха, бұл мүмкін емес. Менің денем оған төтеп бере алмайды.
Dialogue: 0,0:28:19.72,0:28:21.75,Default,,0,0,0,,Аа...｡
Dialogue: 0,0:28:21.75,0:28:24.09,Default,,0,0,0,,Келесі жолы: «Айналмалы бұлшықеттер».
Dialogue: 0,0:28:24.09,0:28:27.03,Default,,0,0,0,,Жас Мидория бұлшықетке айналады!
Dialogue: 0,0:28:27.03,0:28:30.83,Default,,0,0,0,,Әрі қарай!(Изуку/Барлығы мүмкін) PLUS ULTRA!!
Dialogue: 0,0:30:47.82,0:30:50.89,Default,,0,0,0,,Бадминтон ерлер ойыны,
Dialogue: 0,0:30:51.37,0:30:53.89,Default,,0,0,0,,Кенто Момота және Кеничи Таго
Dialogue: 0,0:30:55.56,0:30:58.26,Default,,0,0,0,,Заңсыз казино дүкеніндегі құмар ойындарға байланысты.
Dialogue: 0,0:30:59.76,0:31:04.76,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
