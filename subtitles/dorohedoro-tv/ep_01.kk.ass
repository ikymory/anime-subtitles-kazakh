Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:25.19,0:00:26.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:26.35,0:00:29.69,Default,,0,0,0,,Мацумура! Мацумура!
Dialogue: 0,0:00:31.99,0:00:34.11,Default,,0,0,0,,Уф Мацумура!
Dialogue: 0,0:00:34.32,0:00:35.61,Default,,0,0,0,,(Мацумураның ыңырануы)
Dialogue: 0,0:00:35.99,0:00:37.95,Default,,0,0,0,,Мацумура!
Dialogue: 0,0:00:38.95,0:00:41.41,Default,,0,0,0,,Қарғыс атсын, мені жібер!
Dialogue: 0,0:00:41.54,0:00:42.16,Default,,0,0,0,,Гуах
Dialogue: 0,0:00:42.95,0:00:44.16,Default,,0,0,0,,Ахххх
Dialogue: 0,0:00:44.29,0:00:45.75,Default,,0,0,0,,Фудзита... (Фудзита) Ах.
Dialogue: 0,0:00:45.87,0:00:47.25,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:00:47.38,0:00:49.54,Default,,0,0,0,,Сенің аузыңда басқа біреу бар.
Dialogue: 0,0:00:56.26,0:00:58.55,Default,,0,0,0,,Сіз басқасыз (Мацумура) Иә?
Dialogue: 0,0:00:58.89,0:01:02.77,Default,,0,0,0,,Кууууууууууууууу!
Dialogue: 0,0:01:05.39,0:01:06.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:06.27,0:01:08.23,Default,,0,0,0,,А... бұл жұмыс істемей ме?
Dialogue: 0,0:01:09.40,0:01:11.19,Default,,0,0,0,,Гияаааааааааааааааааааа
Dialogue: 0,0:01:13.94,0:01:15.32,Default,,0,0,0,,Гухаа
Dialogue: 0,0:01:18.53,0:01:19.41,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:01:19.87,0:01:22.66,Default,,0,0,0,,Еееееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:01:23.04,0:01:24.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:24.29,0:01:27.04,Default,,0,0,0,,Не айтып тұрғаныңды білмеймін, Қайман.
Dialogue: 0,0:01:27.67,0:01:29.04,Default,,0,0,0,,Бухаха
Dialogue: 0,0:01:31.04,0:01:32.13,Default,,0,0,0,,Эй (Мацумура) Ах.
Dialogue: 0,0:01:32.75,0:01:34.51,Default,,0,0,0,,Ішіндегі жігіт не деді?
Dialogue: 0,0:01:34.80,0:01:38.51,Default,,0,0,0,,Не? «Сен басқасың»
Dialogue: 0,0:01:40.30,0:01:44.27,Default,,0,0,0,,Түсіндім, иә... сонда.
Dialogue: 0,0:01:47.19,0:01:48.02,Default,,0,0,0,,Артық емес
Dialogue: 0,0:02:00.74,0:02:02.16,Default,,0,0,0,,Уф, Никайдо! Хаха
Dialogue: 0,0:02:06.00,0:02:08.33,Default,,0,0,0,,Қарғыс атсын! Мен қашып құтылдым
Dialogue: 0,0:02:08.50,0:02:11.08,Default,,0,0,0,,Қат! Мен күзетімді түсірдім
Dialogue: 0,0:02:11.21,0:02:14.42,Default,,0,0,0,,Мен ақымақпын, ақымақпын, ақымақпын...
Dialogue: 0,0:02:14.55,0:02:16.26,Default,,0,0,0,,Ал, сабыр ет.
Dialogue: 0,0:02:16.38,0:02:17.42,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:02:17.88,0:02:21.93,Default,,0,0,0,,Бірақ мен олардың есікті ашқанын бірінші рет көріп тұрмын.
Dialogue: 0,0:02:25.14,0:02:25.93,Default,,0,0,0,,О
Dialogue: 0,0:02:34.02,0:02:39.03,Default,,0,0,0,,♪~
Dialogue: 0,0:03:57.82,0:04:02.82,Default,,0,0,0,,~♪
Dialogue: 0,0:04:16.13,0:04:16.96,Default,,0,0,0,,Уф
Dialogue: 0,0:04:17.09,0:04:22.97,Default,,0,0,0,,(Жәндіктер сиқыршысының гуілдеуі)
Dialogue: 0,0:04:23.76,0:04:28.18,Default,,0,0,0,,Бұл есіктің ар жағында сиқыршылар әлемі бар.
Dialogue: 0,0:04:28.76,0:04:31.43,Default,,0,0,0,,Олар сиқырмен есік жасады...
Dialogue: 0,0:04:31.68,0:04:36.15,Default,,0,0,0,,Біз тұратын «Холл» қалашығы мен олардың әлемін байланыстыру
Dialogue: 0,0:04:55.50,0:04:59.59,Default,,0,0,0,,Аа, бүгін ең жаман күн болды.
Dialogue: 0,0:04:59.71,0:05:01.38,Default,,0,0,0,,Көңіл көтеру
Dialogue: 0,0:05:01.63,0:05:05.17,Default,,0,0,0,,Менің мейрамханамдағы сүйікті шисо жапырақ гиозасы.
Dialogue: 0,0:05:05.30,0:05:06.59,Default,,0,0,0,,Мен оны саған жасап беремін.
Dialogue: 0,0:05:06.72,0:05:08.14,Default,,0,0,0,,Ах~
Dialogue: 0,0:05:08.51,0:05:12.27,Default,,0,0,0,,Ал олар жаттығуға залға келеді.
Dialogue: 0,0:05:13.14,0:05:17.02,Default,,0,0,0,,Оларды оқыту үшін пайдаланылған адамдар саны қайтадан өсті.
Dialogue: 0,0:05:17.73,0:05:23.44,Default,,0,0,0,,Цк, сиқырдың әсерінен бүкіл тесік бұрмаланған.
Dialogue: 0,0:05:40.21,0:05:42.30,Default,,0,0,0,,Иә? Кайман не болды?
Dialogue: 0,0:05:42.75,0:05:44.96,Default,,0,0,0,,Сіз тағы да осы аллеяға қарап тұрсыз ба?
Dialogue: 0,0:05:45.34,0:05:46.42,Default,,0,0,0,,О
Dialogue: 0,0:05:46.63,0:05:50.26,Default,,0,0,0,,Мен бұл жолды жадымнан айырылар алдында көрдім.
Dialogue: 0,0:05:50.39,0:05:52.06,Default,,0,0,0,,Өйткені бұл соңғы көрініс
Dialogue: 0,0:05:53.39,0:05:56.56,Default,,0,0,0,,Ол кезде бұл аллеядағы адам кім болды?
Dialogue: 0,0:05:57.56,0:06:01.56,Default,,0,0,0,,Мен іздеп жүрген адам менің басымды осылай жасады.
Dialogue: 0,0:06:02.32,0:06:03.98,Default,,0,0,0,,Сіз сиқыршысыз ба?
Dialogue: 0,0:06:04.82,0:06:07.78,Default,,0,0,0,,Менің аузымдағы адам өзім бе?
Dialogue: 0,0:06:08.20,0:06:10.95,Default,,0,0,0,,Бұл менің шынайы пішінім ме?
Dialogue: 0,0:06:12.20,0:06:14.37,Default,,0,0,0,,А, тамақ ішейік.
Dialogue: 0,0:06:15.41,0:06:16.50,Default,,0,0,0,,О
Dialogue: 0,0:06:20.54,0:06:22.75,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:06:24.80,0:06:27.76,Default,,0,0,0,,...Мен қатты аштым.
Dialogue: 0,0:06:27.88,0:06:33.01,Default,,0,0,0,,Бірақ мен тағы бір балық бітірмейінше үйге бара алмаймын.
Dialogue: 0,0:06:34.01,0:06:36.02,Default,,0,0,0,,Аа, енді жоқ.
Dialogue: 0,0:06:36.52,0:06:40.85,Default,,0,0,0,,Никайдо, маған тез тамақтануға рұқсат етіңіз.
Dialogue: 0,0:06:41.69,0:06:42.77,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:06:43.19,0:06:44.15,Default,,0,0,0,,Ой
Dialogue: 0,0:06:44.27,0:06:46.90,Default,,0,0,0,,Оххх
Dialogue: 0,0:06:48.28,0:06:50.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:51.28,0:06:53.99,Default,,0,0,0,,Уми~ Ахаха дөңес
Dialogue: 0,0:06:54.49,0:06:59.58,Default,,0,0,0,,Күте тұрыңыз, шебер, мен оны ертең міндетті түрде табамын.
Dialogue: 0,0:07:14.39,0:07:18.27,Default,,0,0,0,,Енді жұмыртқаны қайта туылу үмітіне қойыңыз.
Dialogue: 0,0:07:21.27,0:07:24.06,Default,,0,0,0,,Мацумура… Кешіріңіз.
Dialogue: 0,0:07:31.36,0:07:33.32,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:33.45,0:07:35.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:35.28,0:07:37.41,Default,,0,0,0,,Смоук мырза, бір сәт қарсы боласыз ба?
Dialogue: 0,0:07:37.74,0:07:41.79,Default,,0,0,0,,Фудзита Мацумура қайтыс болған сияқты...
Dialogue: 0,0:07:43.37,0:07:47.04,Default,,0,0,0,,Залдағы жігіттер мені ұрады деп ойламаппын...
Dialogue: 0,0:07:48.13,0:07:50.42,Default,,0,0,0,,Бұл шындық болуы мүмкін емес, солай ма?
Dialogue: 0,0:07:50.84,0:07:52.88,Default,,0,0,0,,Жоқ, бұл рас.
Dialogue: 0,0:07:53.01,0:07:55.26,Default,,0,0,0,,Жерлеу рәсімі жақында ғана аяқталды.
Dialogue: 0,0:07:56.68,0:08:00.14,Default,,0,0,0,,Сіз жерлеуге арналған аяқ киіміңізбен қайда барасыз?
Dialogue: 0,0:08:00.48,0:08:01.98,Default,,0,0,0,,Кінәлілер – қос адам.
Dialogue: 0,0:08:02.10,0:08:06.40,Default,,0,0,0,,Бірі – әйел, екіншісі – кесіртке басы үлкен кісі.
Dialogue: 0,0:08:06.52,0:08:09.90,Default,,0,0,0,,Неге екені белгісіз, сиқыр ол адамға әсер етпеді.
Dialogue: 0,0:08:10.15,0:08:14.07,Default,,0,0,0,,Эй, ол әлдеқашан басқа бір сиқырдың астында қалған шығар.
Dialogue: 0,0:08:14.41,0:08:18.66,Default,,0,0,0,,Сонымен қатар, саусақтарыңыз сынса, сиқырды пайдалана алмайсыз.
Dialogue: 0,0:08:19.29,0:08:23.71,Default,,0,0,0,,Сиқыр жұмыс істемесе, сіз де істей алмайсыз, солай ма?
Dialogue: 0,0:08:24.79,0:08:26.54,Default,,0,0,0,,Себебі менде бір идея бар
Dialogue: 0,0:08:27.29,0:08:31.34,Default,,0,0,0,,Зал... жүректі елжірететін жер екен.
Dialogue: 0,0:08:35.89,0:08:38.05,Default,,0,0,0,,Йо Никайдо ах
Dialogue: 0,0:08:39.97,0:08:41.68,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:41.81,0:08:43.52,Default,,0,0,0,,Никайдо!
Dialogue: 0,0:08:44.06,0:08:47.15,Default,,0,0,0,,Қайман Ондай жерде не істеп жүрсің?
Dialogue: 0,0:08:47.27,0:08:49.15,Default,,0,0,0,,Хехе, бұл толық емес жұмыс күні.
Dialogue: 0,0:08:51.78,0:08:54.53,Default,,0,0,0,,Бұл жәбірленушілер бөлімі емес пе?
Dialogue: 0,0:08:54.99,0:08:58.87,Default,,0,0,0,,Мен емделушіден шебер туралы ақпаратты аламын деп ойладым.
Dialogue: 0,0:08:59.20,0:09:01.04,Default,,0,0,0,,Қазір ешкім жоқ
Dialogue: 0,0:09:01.58,0:09:04.33,Default,,0,0,0,,Менің ойымша, олар жаттығуды тоқтатты.
Dialogue: 0,0:09:04.46,0:09:08.54,Default,,0,0,0,,Біз бірнеше адамды өлтірдік, сондықтан олар да сақ болған шығар.
Dialogue: 0,0:09:08.67,0:09:11.46,Default,,0,0,0,,Сиқыршылар келмесе...
Dialogue: 0,0:09:11.59,0:09:13.76,Default,,0,0,0,,Мен осылай мәңгі қала берем бе?
Dialogue: 0,0:09:13.76,0:09:14.22,Default,,0,0,0,,Мен осылай мәңгі қала берем бе?
Dialogue: 0,0:09:13.76,0:09:14.22,Default,,0,0,0,,Иә
Dialogue: 0,0:09:14.22,0:09:14.34,Default,,0,0,0,,Иә
Dialogue: 0,0:09:14.34,0:09:14.92,Default,,0,0,0,,Иә
Dialogue: 0,0:09:14.34,0:09:14.92,Default,,0,0,0,,Ааа~ Кайман!
Dialogue: 0,0:09:14.92,0:09:15.93,Default,,0,0,0,,Ааа~ Кайман!
Dialogue: 0,0:09:16.05,0:09:18.51,Default,,0,0,0,,Сіз не істеп жатырсыз? Апаттық жағдай
Dialogue: 0,0:09:18.64,0:09:19.43,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:23.93,0:09:27.90,Default,,0,0,0,,Мутацияға ұшыраған бөліктерге қарағанда, бұл бір шебердің жұмысы сияқты.
Dialogue: 0,0:09:28.02,0:09:31.48,Default,,0,0,0,,О? Бұл шынымен жаман сиқыр.
Dialogue: 0,0:09:31.61,0:09:35.11,Default,,0,0,0,,Бұл жігіт мені жасаған жігіттен ерекше екені сөзсіз.
Dialogue: 0,0:09:35.24,0:09:36.70,Default,,0,0,0,,Ах, көңілім қалды.
Dialogue: 0,0:09:37.36,0:09:41.20,Default,,0,0,0,,Бұл қате болуы керек пе? мағынасыз нәрсе жасау
Dialogue: 0,0:09:41.33,0:09:45.08,Default,,0,0,0,,Мутацияға ұшыраған бөліктің алдында қан ұйып жатыр... Уау.
Dialogue: 0,0:09:45.54,0:09:47.83,Default,,0,0,0,,Қайманды жұлқылау!
Dialogue: 0,0:09:48.12,0:09:50.84,Default,,0,0,0,,Әй, сен ол етті не үшін пайдаланасың?
Dialogue: 0,0:09:50.96,0:09:51.92,Default,,0,0,0,,Бұл чашу
Dialogue: 0,0:09:52.04,0:09:54.71,Default,,0,0,0,,Шар сиу! Ақымақ, жұмыс!
Dialogue: 0,0:09:58.63,0:09:59.72,Default,,0,0,0,,Никайдо!
Dialogue: 0,0:10:00.01,0:10:04.02,Default,,0,0,0,,Мен жұмыстан кейін дүкенге барамын. Өтінемін, мені құтқарыңызшы.
Dialogue: 0,0:10:04.14,0:10:05.43,Default,,0,0,0,,Субару-кун?
Dialogue: 0,0:10:05.56,0:10:08.10,Default,,0,0,0,,Қарамашы, Итата... Уау.
Dialogue: 0,0:10:09.10,0:10:11.86,Default,,0,0,0,,Никайдоның «Аш қателік» дүкені
Dialogue: 0,0:10:11.98,0:10:14.82,Default,,0,0,0,,Ол залдың ортасынан алыс жерде орналасты.
Dialogue: 0,0:10:15.82,0:10:17.61,Default,,0,0,0,,Сол аллеяның жанында
Dialogue: 0,0:10:18.61,0:10:22.58,Default,,0,0,0,,Бұл аймақ сиқыршылардың жиі келетіндігімен танымал.
Dialogue: 0,0:10:22.99,0:10:24.79,Default,,0,0,0,,Сондықтан тұтынушылар аз.
Dialogue: 0,0:10:25.49,0:10:27.37,Default,,0,0,0,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:10:28.21,0:10:31.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:31.79,0:10:35.42,Default,,0,0,0,,Маған тамақ беріңізші...
Dialogue: 0,0:10:35.55,0:10:36.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:38.34,0:10:39.38,Default,,0,0,0,,А... (Жәндіктер шебері) Қайта толтыр!
Dialogue: 0,0:10:39.72,0:10:43.39,Default,,0,0,0,,Бұл дүкеннің жақсы аты бар. Бұны ұнатамын.
Dialogue: 0,0:10:43.51,0:10:45.26,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:10:45.60,0:10:49.48,Default,,0,0,0,,Бірақ жақсы тамақтанба, сен қайман сияқты жақсысың.
Dialogue: 0,0:10:49.60,0:10:50.77,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:10:51.02,0:10:54.07,Default,,0,0,0,,Сіз, бұл аймақ қауіпті аймақ.
Dialogue: 0,0:10:54.19,0:10:56.73,Default,,0,0,0,,Біз қайдамыз? Мен сені үйге апарып беремін
Dialogue: 0,0:10:57.61,0:11:01.91,Default,,0,0,0,,Қазіргі кезде адамды жәндікке айналдыратын сиқыршылар бар.
Dialogue: 0,0:11:02.03,0:11:07.54,Default,,0,0,0,,Я, жәбірленушіні жаңа көрдім, хаха, жоқ, бұл тағы да...
Dialogue: 0,0:11:07.91,0:11:12.04,Default,,0,0,0,,Бұл өте жаман Ахахха
Dialogue: 0,0:11:13.50,0:11:14.92,Default,,0,0,0,,Нашар орындалды ма?
Dialogue: 0,0:11:15.04,0:11:19.42,Default,,0,0,0,,Әй, бұл мен көрген ең жаман сұмдық.
Dialogue: 0,0:11:19.72,0:11:23.43,Default,,0,0,0,,Мен сондай бейшара сиқыр жасаған адамның жүзін көргім келеді.
Dialogue: 0,0:11:23.55,0:11:25.26,Default,,0,0,0,,Ахаха
Dialogue: 0,0:11:25.68,0:11:26.43,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:27.64,0:11:29.43,Default,,0,0,0,,Не-чан ах
Dialogue: 0,0:11:30.68,0:11:32.14,Default,,0,0,0,,Ол осылай көрінеді
Dialogue: 0,0:11:32.60,0:11:34.15,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:11:37.94,0:11:40.86,Default,,0,0,0,,Өту жоқ дегеніңіз не?
Dialogue: 0,0:11:40.99,0:11:44.49,Default,,0,0,0,,Залға кіру уақытша жабылды.
Dialogue: 0,0:11:44.62,0:11:48.49,Default,,0,0,0,,Бұл жерден кету де, қайтып оралу да мүмкін емес.
Dialogue: 0,0:11:48.62,0:11:50.20,Default,,0,0,0,,Міне! (Есік күзетшісі) Фудзита мырзаға-
Dialogue: 0,0:11:50.33,0:11:52.92,Default,,0,0,0,,Бізге бастықтан хабарлама келді.
Dialogue: 0,0:11:53.04,0:11:54.33,Default,,0,0,0,,Смоук мырзадан?
Dialogue: 0,0:11:54.88,0:11:58.63,Default,,0,0,0,,Фудзита Қазір ең бірінші не істеу керек?
Dialogue: 0,0:11:58.75,0:12:02.55,Default,,0,0,0,,Мацумураның орнына жаңа серіктес табыңыз.
Dialogue: 0,0:12:03.09,0:12:06.18,Default,,0,0,0,,Бірақ мен мұны да ойладым.
Dialogue: 0,0:12:06.60,0:12:09.35,Default,,0,0,0,,Жау - сиқыры оған әсер етпейтін қиын қарсылас.
Dialogue: 0,0:12:09.81,0:12:11.52,Default,,0,0,0,,Менің зерттеуім бойынша--
Dialogue: 0,0:12:11.64,0:12:15.86,Default,,0,0,0,,Залға барып хабарсыз кеткен оннан астам адам бар.
Dialogue: 0,0:12:16.27,0:12:18.65,Default,,0,0,0,,Бұл олардың ісі шығар.
Dialogue: 0,0:12:19.57,0:12:21.86,Default,,0,0,0,,Сен анау кесірткеге сиқырладың...
Dialogue: 0,0:12:21.99,0:12:24.86,Default,,0,0,0,,Мені тауып алып кел.
Dialogue: 0,0:12:26.16,0:12:28.91,Default,,0,0,0,,Оған жасалған сиқыр ерекше.
Dialogue: 0,0:12:29.03,0:12:29.99,Default,,0,0,0,,Ах
Dialogue: 0,0:12:30.33,0:12:34.00,Default,,0,0,0,,Менің атымды айтсаң бәрібір, мені тауып ал.
Dialogue: 0,0:12:34.71,0:12:37.25,Default,,0,0,0,,Сізде идея бар дедіңіз...
Dialogue: 0,0:12:37.79,0:12:40.25,Default,,0,0,0,,Менің ойымша, ол бәрібір мылтық қолдануды жоспарлаған.
Dialogue: 0,0:12:41.21,0:12:43.01,Default,,0,0,0,,Маған қарама!
Dialogue: 0,0:12:43.13,0:12:44.93,Default,,0,0,0,,Мен сиқыршы болсам да
Dialogue: 0,0:12:45.05,0:12:47.64,Default,,0,0,0,,Егер сіз мақтанышсыз бірдеңе жасасаңыз...
Dialogue: 0,0:12:47.76,0:12:51.02,Default,,0,0,0,,Мен сені өлтіремін, жарайды.
Dialogue: 0,0:12:52.68,0:12:54.02,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:54.77,0:12:58.15,Default,,0,0,0,,Хахахахаха... (Есік нөмірі) Әй?
Dialogue: 0,0:12:58.56,0:13:02.19,Default,,0,0,0,,Хехехе Смоук мырзаның қозғалғанына сенбеймін.
Dialogue: 0,0:13:02.32,0:13:05.91,Default,,0,0,0,,Осылайша Мацумураның жауы міндетті түрде жеңіледі.
Dialogue: 0,0:13:06.36,0:13:08.16,Default,,0,0,0,,Күте тұр, қарғыс атқыр кесіртке.
Dialogue: 0,0:13:08.66,0:13:12.62,Default,,0,0,0,,Ке, бұл дәрігер сағаттық жалақысы төмен арзан коньки.
Dialogue: 0,0:13:12.75,0:13:14.16,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:14.87,0:13:16.25,Default,,0,0,0,,Ха~а
Dialogue: 0,0:13:16.37,0:13:20.67,Default,,0,0,0,,Сергіту үшін бір ыдыс гиоза мен чашу балығын ішейік.
Dialogue: 0,0:13:21.42,0:13:25.55,Default,,0,0,0,,Иә, мен де кәдімгі сыраға тапсырыс беремін.
Dialogue: 0,0:13:26.01,0:13:28.09,Default,,0,0,0,,Сәлем, қош келдіңіз, тұтынушы.
Dialogue: 0,0:13:28.22,0:13:29.93,Default,,0,0,0,,Сіз дәл уақытында келдіңіз.
Dialogue: 0,0:13:30.05,0:13:33.31,Default,,0,0,0,,Сәлден кейін бұл жігіттің бүкіл денесі жәндікке айналады.
Dialogue: 0,0:13:33.56,0:13:35.56,Default,,0,0,0,,Гахаааааа
Dialogue: 0,0:13:35.68,0:13:37.81,Default,,0,0,0,,(Никаидоның жөтелі)
Dialogue: 0,0:13:37.94,0:13:41.48,Default,,0,0,0,,Ха~ Не деген тәртіпсіздік, Никайдо.
Dialogue: 0,0:13:41.61,0:13:44.15,Default,,0,0,0,,Ах! Сіз менің гиозаны жедіңіз!
Dialogue: 0,0:13:44.28,0:13:46.86,Default,,0,0,0,,Уайымдама, мен қазір үйге барамын.
Dialogue: 0,0:13:46.99,0:13:49.24,Default,,0,0,0,,Себебі мен практикалық квотаға қол жеткіздім.
Dialogue: 0,0:13:50.53,0:13:51.99,Default,,0,0,0,,Эй, сен сондай жамансың (Жәндіктер шебері) А?
Dialogue: 0,0:13:52.45,0:13:55.00,Default,,0,0,0,,Ауруханадағы үш адам да сен кінәлі.
Dialogue: 0,0:13:55.33,0:13:58.25,Default,,0,0,0,,Соншалықты жаман...?
Dialogue: 0,0:13:58.83,0:14:00.38,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:14:00.50,0:14:03.05,Default,,0,0,0,,Жүр, оларды өлтіріп, сол үш адамның сиқырын сындыр...
Dialogue: 0,0:14:03.17,0:14:05.30,Default,,0,0,0,,Ауруханадан сыйақы алу
Dialogue: 0,0:14:05.84,0:14:08.88,Default,,0,0,0,,Шулы! Қате болыңыз!
Dialogue: 0,0:14:10.76,0:14:13.72,Default,,0,0,0,,Иә? Эх, аа
Dialogue: 0,0:14:14.68,0:14:17.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:17.48,0:14:19.06,Default,,0,0,0,,Сиқыр жұмыс істемейді
Dialogue: 0,0:14:19.44,0:14:21.44,Default,,0,0,0,,Әйтеуір, мен қазір қашуым керек.
Dialogue: 0,0:14:21.73,0:14:23.82,Default,,0,0,0,,Хихьяххёхё
Dialogue: 0,0:14:23.94,0:14:27.44,Default,,0,0,0,,Ааааааааа!
Dialogue: 0,0:14:27.57,0:14:29.95,Default,,0,0,0,,А? Бұл не деген айқай?
Dialogue: 0,0:14:32.41,0:14:33.45,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:14:43.79,0:14:46.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:49.38,0:14:50.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.80,0:14:51.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:55.18,0:14:56.10,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:14:56.64,0:14:59.14,Default,,0,0,0,,Ішіндегі жігіт не деді?
Dialogue: 0,0:14:59.27,0:15:01.77,Default,,0,0,0,,Әлі кеш пе?
Dialogue: 0,0:15:02.69,0:15:06.73,Default,,0,0,0,,Құдай-ау, тығырыққа тірелді деп ойлап, сақамды жібердім.
Dialogue: 0,0:15:08.03,0:15:10.49,Default,,0,0,0,,Ол мүлде ебедейсіз.
Dialogue: 0,0:15:10.61,0:15:14.49,Default,,0,0,0,,Мен саған көмектескендіктен, неге бүгін кешке мені емдемейсің?
Dialogue: 0,0:15:14.62,0:15:18.25,Default,,0,0,0,,Мен ешқашан ештеңеге ақша төлеген емеспін.
Dialogue: 0,0:15:23.33,0:15:24.50,Default,,0,0,0,,Ах
Dialogue: 0,0:15:24.71,0:15:28.88,Default,,0,0,0,,Ол барлық дерлік шебердің деректерін қамтиды.
Dialogue: 0,0:15:30.55,0:15:33.51,Default,,0,0,0,,Олардың ішінде кімде-кім болса да күдікті болып көрінсе...
Dialogue: 0,0:15:33.64,0:15:35.26,Default,,0,0,0,,Мені өзіңізге әкеліңіз
Dialogue: 0,0:15:35.68,0:15:37.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:37.56,0:15:39.60,Default,,0,0,0,,Иә! рақмет сізге!
Dialogue: 0,0:15:40.48,0:15:44.48,Default,,0,0,0,,Хуаааааааааааааааааааааааааа
Dialogue: 0,0:15:44.61,0:15:46.82,Default,,0,0,0,,Уф
Dialogue: 0,0:15:47.11,0:15:48.57,Default,,0,0,0,,Иә
Dialogue: 0,0:15:49.32,0:15:51.24,Default,,0,0,0,,О-о
Dialogue: 0,0:15:51.49,0:15:54.99,Default,,0,0,0,,Ах! Бүгін сол суретке түскен күн еді.
Dialogue: 0,0:15:56.08,0:15:57.66,Default,,0,0,0,,Оссу Никайдо
Dialogue: 0,0:15:57.79,0:15:59.37,Default,,0,0,0,,Ио, ет тоқаш жегің келе ме?
Dialogue: 0,0:15:59.50,0:16:01.00,Default,,0,0,0,,А, же, же
Dialogue: 0,0:16:02.21,0:16:05.42,Default,,0,0,0,,Аузымдағы адамды жақсы суретке түсіре аламын ба деп ойлаймын
Dialogue: 0,0:16:05.54,0:16:07.75,Default,,0,0,0,,Мен жай көзбен ештеңе көре алмадым.
Dialogue: 0,0:16:08.13,0:16:11.84,Default,,0,0,0,,Бірақ камера рухани нәрселерді түсіреді, солай ма?
Dialogue: 0,0:16:11.97,0:16:15.18,Default,,0,0,0,,Жоқ, бұл рух емес, бұл сиқыр.
Dialogue: 0,0:16:16.39,0:16:19.89,Default,,0,0,0,,Ол сондай әдемі, егер Никайдо оған ғашық болып қалса, мен не істеуім керек?
Dialogue: 0,0:16:20.81,0:16:22.35,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:16:23.85,0:16:25.10,Default,,0,0,0,,Тек болжамға сүйеніп осындай қауіпті тәуекелге бара аламыз ба?
Dialogue: 0,0:16:27.15,0:16:29.27,Default,,0,0,0,,Есімі «Ебісу»
Dialogue: 0,0:16:29.69,0:16:31.40,Default,,0,0,0,,Иә? Күте тұрыңыз, бұл жігіт
Dialogue: 0,0:16:37.20,0:16:41.12,Default,,0,0,0,,Иә! Бір күні ғана ол залда біздің қасымыздан өтті.
Dialogue: 0,0:16:42.66,0:16:44.67,Default,,0,0,0,,Жарайды, бірден қарайық.
Dialogue: 0,0:16:44.79,0:16:48.09,Default,,0,0,0,,Уау~ Мен қатты толқып тұрмын~
Dialogue: 0,0:16:48.42,0:16:50.63,Default,,0,0,0,,Әй, Қайман?
Dialogue: 0,0:16:50.75,0:16:52.67,Default,,0,0,0,,Қараңызшы, иә?
Dialogue: 0,0:16:53.51,0:16:54.97,Default,,0,0,0,,Бұл олардың есігі.
Dialogue: 0,0:16:55.63,0:16:57.05,Default,,0,0,0,,Ол жоғалады, күте тұрыңыз.
Dialogue: 0,0:16:58.30,0:17:00.06,Default,,0,0,0,,Артында біреу бар ма?
Dialogue: 0,0:17:00.68,0:17:03.56,Default,,0,0,0,,Қанша тырыссам да есік ашылмайды.
Dialogue: 0,0:17:03.68,0:17:07.52,Default,,0,0,0,,Бір қызығы, бұл күндері достарымның ешқайсысын залдан әрең көрмеймін.
Dialogue: 0,0:17:07.65,0:17:09.73,Default,,0,0,0,,Онда бірдеңе болды ма?
Dialogue: 0,0:17:10.15,0:17:12.36,Default,,0,0,0,,Сиқыршы сияқты
Dialogue: 0,0:17:12.48,0:17:13.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:13.74,0:17:18.24,Default,,0,0,0,,Сол қаңқаны басынан тістеп алайыншы.
Dialogue: 0,0:17:27.12,0:17:28.08,Default,,0,0,0,,Уф
Dialogue: 0,0:17:28.75,0:17:29.67,Default,,0,0,0,,Бухе
Dialogue: 0,0:17:37.55,0:17:40.80,Default,,0,0,0,,Хм, уф, кел, бетіңді көрсет.
Dialogue: 0,0:17:44.18,0:17:44.89,Default,,0,0,0,,Не!
Dialogue: 0,0:17:45.77,0:17:46.89,Default,,0,0,0,,Ух... хе.
Dialogue: 0,0:17:47.64,0:17:50.94,Default,,0,0,0,,Әй... әйел! ? болды ма?
Dialogue: 0,0:17:51.19,0:17:53.03,Default,,0,0,0,,Біз не істеуіміз керек? кайман
Dialogue: 0,0:17:53.15,0:17:56.53,Default,,0,0,0,,Иә, мен не істеуім керек...
Dialogue: 0,0:17:56.65,0:17:58.16,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:17:58.86,0:18:01.12,Default,,0,0,0,,(Эбисудың үрейлі дауысы)
Dialogue: 0,0:18:01.49,0:18:02.62,Default,,0,0,0,,Құт
Dialogue: 0,0:18:03.04,0:18:06.00,Default,,0,0,0,,Қат! Саған бәрібір?
Dialogue: 0,0:18:06.12,0:18:08.04,Default,,0,0,0,,Ооо!
Dialogue: 0,0:18:11.13,0:18:15.42,Default,,0,0,0,,Ух... у... ха
Dialogue: 0,0:18:17.76,0:18:20.14,Default,,0,0,0,,Біреу... бар ма?
Dialogue: 0,0:18:23.64,0:18:24.52,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,0:18:25.89,0:18:26.89,Default,,0,0,0,,Сіз...
Dialogue: 0,0:18:29.19,0:18:29.90,Default,,0,0,0,,Га
Dialogue: 0,0:18:30.06,0:18:31.52,Default,,0,0,0,,Уфф
Dialogue: 0,0:18:31.90,0:18:32.44,Default,,0,0,0,,Уф
Dialogue: 0,0:18:33.02,0:18:34.44,Default,,0,0,0,,Гууууууук
Dialogue: 0,0:18:34.57,0:18:36.53,Default,,0,0,0,,Нгаааа...
Dialogue: 0,0:18:36.65,0:18:39.45,Default,,0,0,0,,Ммм! Апыр-ай!
Dialogue: 0,0:18:39.57,0:18:41.62,Default,,0,0,0,,Ууууууууууу~
Dialogue: 0,0:18:44.03,0:18:46.33,Default,,0,0,0,,Уау уау
Dialogue: 0,0:18:48.96,0:18:50.67,Default,,0,0,0,,Эй, ол жабық!
Dialogue: 0,0:18:51.38,0:18:53.79,Default,,0,0,0,,Жылы…
Dialogue: 0,0:18:54.80,0:18:56.67,Default,,0,0,0,,Бұл жақын қоңырау болды.
Dialogue: 0,0:18:57.05,0:18:59.88,Default,,0,0,0,,А... Фудзита-сама (Фудзита) А?
Dialogue: 0,0:19:04.72,0:19:05.56,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,0:19:09.39,0:19:13.11,Default,,0,0,0,,Мен... Кәдімгі сұрақты қоя алмадым.
Dialogue: 0,0:19:13.94,0:19:14.94,Default,,0,0,0,,О
Dialogue: 0,0:19:16.02,0:19:19.95,Default,,0,0,0,,Аа, дұрыс... Фотоға қарайық. Фото қандай?
Dialogue: 0,0:19:20.28,0:19:21.32,Default,,0,0,0,,О
Dialogue: 0,0:19:27.29,0:19:28.62,Default,,0,0,0,,Қуыс табылды
Dialogue: 0,0:19:28.75,0:19:30.08,Default,,0,0,0,,Қарғыс атсын! Уау
Dialogue: 0,0:19:30.21,0:19:32.58,Default,,0,0,0,,Егер бұл орын алса, бұл өте өкінішті!
Dialogue: 0,0:19:38.05,0:19:41.68,Default,,0,0,0,,(Кайманның дауысы)
Dialogue: 0,0:19:50.89,0:19:52.77,Default,,0,0,0,,Амансың ба? кайман
Dialogue: 0,0:19:52.90,0:19:55.61,Default,,0,0,0,,Ішіп отырып құсу сирек.
Dialogue: 0,0:19:55.73,0:19:59.23,Default,,0,0,0,,Ей, бірдеңе дұрыс емес.
Dialogue: 0,0:19:59.36,0:20:01.07,Default,,0,0,0,,Бір нәрсе... уф
Dialogue: 0,0:20:01.20,0:20:05.12,Default,,0,0,0,,Гуаааааааааа!
Dialogue: 0,0:20:05.24,0:20:06.49,Default,,0,0,0,,Әй, Кайман! ?
Dialogue: 0,0:20:06.87,0:20:11.46,Default,,0,0,0,,(Кайманның ыңырсыуы)
Dialogue: 0,0:20:19.09,0:20:20.01,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:20:20.13,0:20:21.38,Default,,0,0,0,,Эй, Кайман!
Dialogue: 0,0:20:27.01,0:20:29.89,Default,,0,0,0,,О, сен...
Dialogue: 0,0:20:34.39,0:20:35.65,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:20:39.23,0:20:40.57,Default,,0,0,0,,Га
Dialogue: 0,0:20:45.74,0:20:50.83,Default,,0,0,0,,Шүкір, бұл тағы бір арман ғой, о...
Dialogue: 0,0:20:51.95,0:20:56.04,Default,,0,0,0,,Қобалжыған түс күнде түнде осылай болады, сондықтан қорқыныш мүлде жоқ.
Dialogue: 0,0:20:57.54,0:21:01.21,Default,,0,0,0,,Түсімде көрінген адам менің шынайы келбетім ме?
Dialogue: 0,0:21:01.76,0:21:03.88,Default,,0,0,0,,Маған сиқырлаған
Dialogue: 0,0:21:04.42,0:21:06.18,Default,,0,0,0,,Немесе басқа…
Dialogue: 0,0:21:06.47,0:21:08.35,Default,,0,0,0,,Әй, жастықта тікен бар!
Dialogue: 0,0:21:08.47,0:21:09.30,Default,,0,0,0,,Ішек
Dialogue: 0,0:21:09.43,0:21:11.35,Default,,0,0,0,,Гах (қайшы көз) Аххх
Dialogue: 0,0:21:11.97,0:21:12.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:12.98,0:21:15.56,Default,,0,0,0,,Теяааааааааааааааааааааааааа
Dialogue: 0,0:21:20.61,0:21:22.65,Default,,0,0,0,,Нана~цу!
Dialogue: 0,0:21:25.28,0:21:26.24,Default,,0,0,0,,Иә
Dialogue: 0,0:21:27.53,0:21:30.37,Default,,0,0,0,,Сіз қанша қарттарды жинадыңыз?
Dialogue: 0,0:21:31.24,0:21:36.25,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:21:37.46,0:21:39.38,Default,,0,0,0,,Сіз емес,
Dialogue: 0,0:21:40.13,0:21:43.13,Default,,0,0,0,,Мен бүгін өлуді жоспарлаған жоқпын.
Dialogue: 0,0:21:43.59,0:21:47.26,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:21:48.43,0:21:51.26,Default,,0,0,0,,Бірақ бұл жаман ой...
Dialogue: 0,0:21:51.68,0:21:54.18,Default,,0,0,0,,Бағалы ғұмырымды ұстаған
Dialogue: 0,0:21:54.35,0:21:58.19,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:21:58.48,0:22:00.65,Default,,0,0,0,,Әлгі ақымақтар...
Dialogue: 0,0:22:01.02,0:22:03.61,Default,,0,0,0,,Өлме!
Dialogue: 0,0:22:06.03,0:22:11.03,Default,,0,0,0,,♪~
Dialogue: 0,0:23:28.65,0:23:33.66,Default,,0,0,0,,~♪
Dialogue: 0,0:23:43.92,0:23:45.96,Default,,0,0,0,,Жын 2-ден не үйренуге болады
Dialogue: 0,0:23:46.09,0:23:48.63,Default,,0,0,0,,Әлі хаос
Dialogue: 0,0:23:50.13,0:23:56.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory