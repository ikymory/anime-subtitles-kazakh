Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 1,0:00:12.11,0:00:14.28,JP,NTP,0,0,0,,Бұл өте жылдам, солай ма?
Dialogue: 1,0:00:15.26,0:00:18.22,JP,NTP,0,0,0,,Сіз мен күткеннен әлдеқайда жақсы жүргізушісіз.
Dialogue: 1,0:00:19.99,0:00:23.20,JP,NTP,0,0,0,,Дұрыс, осылай көрінсе де, мен қарқынды жаттықтым.
Dialogue: 1,0:00:25.32,0:00:30.08,JP,NTP,0,0,0,,Маған Кирицугу әкелген ойыншықтардың ішінде бұл менің сүйіктім.
Dialogue: 1,0:00:30.54,0:00:31.80,JP,NTP,0,0,0,,Бұл ойыншық па?
Dialogue: 1,0:00:36.13,0:00:38.92,JP,NTP,0,0,0,,Қамалда ауланы аралау ғана болды.
Dialogue: 1,0:00:39.12,0:00:40.83,JP,NTP,0,0,0,,Қазірдің өзінде ең жақсы
Dialogue: 1,0:00:42.43,0:00:45.40,JP,NTP,0,0,0,,Мен кәсіби жүргізуші жалдай аламын ба?
Dialogue: 1,0:00:45.98,0:00:47.71,JP,NTP,0,0,0,,Жоқ, қызықсыз
Dialogue: 1,0:00:47.86,0:00:49.78,JP,NTP,0,0,0,,Бұл қауіпті.
Dialogue: 1,0:00:49.91,0:00:52.06,JP,NTP,0,0,0,,Осы жерде саған жау шапса, не істер едің?
Dialogue: 1,0:00:52.79,0:00:54.31,JP,NTP,0,0,0,,Бұл дұрыс, бірақ
Dialogue: 1,0:00:54.89,0:00:55.51,JP,NTP,0,0,0,,Ауа райы тамаша, иә~
Dialogue: 1,0:01:02.71,0:01:05.46,JP,NTP,0,0,0,,Ирисвиэль көліктен түсті
Dialogue: 1,0:01:05.70,0:01:07.54,JP,NTP,0,0,0,,Менің қасымнан кетпе
Dialogue: 1,0:01:08.17,0:01:10.51,JP,NTP,0,0,0,,Бұл қатысу – қызметші.
Dialogue: 1,0:02:55.30,0:02:58.21,JP,NTP,0,0,0,,Мен сені қабылдауға келдім, Әулие Бикеш.
Dialogue: 1,0:03:02.20,0:03:03.46,JP,NTP,0,0,0,,Сіз білетін адам
Dialogue: 1,0:03:04.09,0:03:05.52,JP,NTP,0,0,0,,Мен оны танымаймын.
Dialogue: 1,0:03:06.27,0:03:10.15,JP,NTP,0,0,0,,Сіз бұл тәнсіз тұлғаны ұмытып кеттіңіз дейсіз бе?
Dialogue: 1,0:03:10.48,0:03:12.85,JP,NTP,0,0,0,,Мен ештеңе білмеймін, сенімен бірінші рет кездесіп тұрмын.
Dialogue: 1,0:03:13.48,0:03:14.59,JP,NTP,0,0,0,,Бұл дұрыс емес адам емес пе?
Dialogue: 1,0:03:16.27,0:03:19.40,JP,NTP,0,0,0,,Бұл менмін, Гил де Раистегі.
Dialogue: 1,0:03:20.02,0:03:21.84,JP,NTP,0,0,0,,Мен сенің қайта тірілуіңді ғана тілеймін.
Dialogue: 1,0:03:21.88,0:03:24.68,JP,NTP,0,0,0,,Мен тағы да жолым болатын ғажайыпты күтемін.
Dialogue: 1,0:03:24.96,0:03:28.23,JP,NTP,0,0,0,,Осылай ақырзаманға келдік.
Dialogue: 1,0:03:28.52,0:03:29.35,JP,NTP,0,0,0,,Жанна
Dialogue: 1,0:03:30.45,0:03:31.36,JP,NTP,0,0,0,,Жанна
Dialogue: 1,0:03:31.51,0:03:33.74,JP,NTP,0,0,0,,Мен сенің атыңды білмеймін
Dialogue: 1,0:03:34.06,0:03:36.81,JP,NTP,0,0,0,,Мен Жанна есімін де танымаймын.
Dialogue: 1,0:03:37.61,0:03:38.74,JP,NTP,0,0,0,,Мұндай нәрсе
Dialogue: 1,0:03:39.70,0:03:43.12,JP,NTP,0,0,0,,Тірі кезінде кім болғаныңды ұмыттың ба?
Dialogue: 1,0:03:43.60,0:03:46.00,JP,NTP,0,0,0,,Енді сіз өзіңіз алға шықтыңыз.
Dialogue: 1,0:03:46.39,0:03:50.18,JP,NTP,0,0,0,,Мен де рыцарьлық әдепті ұстанамын және шын есімімді жариялаймын.
Dialogue: 1,0:03:50.79,0:03:54.40,JP,NTP,0,0,0,,Менің атым Артория, Уса Пендрагонның заңды баласы.
Dialogue: 1,0:03:54.85,0:03:56.11,JP,NTP,0,0,0,,Ұлыбритания королі
Dialogue: 1,0:03:56.57,0:03:59.58,JP,NTP,0,0,0,,Бұл жолы мен Сабер класын алып, пайда болдым.
Dialogue: 1,0:04:00.47,0:04:03.83,JP,NTP,0,0,0,,Қандай аянышты, қандай аянышты
Dialogue: 1,0:04:03.91,0:04:06.81,JP,NTP,0,0,0,,Есте сақтау қабілетін жоғалтып, ақыры абдырап қалды ма?
Dialogue: 1,0:04:06.86,0:04:09.00,JP,NTP,0,0,0,,Аня Форджер
Dialogue: 1,0:04:09.08,0:04:11.09,JP,NTP,0,0,0,,Аня Форджер
Dialogue: 1,0:04:11.30,0:04:15.68,JP,NTP,0,0,0,,Менің сұлу қызыма Құдай қаншалықты қатыгездік жасайды?
Dialogue: 1,0:04:15.81,0:04:17.67,JP,NTP,0,0,0,,Ең жақсысы, бұл көріксіз
Dialogue: 1,0:04:17.76,0:04:19.28,JP,NTP,0,0,0,,Оян
Dialogue: 1,0:04:19.55,0:04:22.56,JP,NTP,0,0,0,,Өзіңді енді Сабер деп атама.
Dialogue: 1,0:04:22.99,0:04:25.59,JP,NTP,0,0,0,,​​Қасиетті Граил соғысы аяқталды.
Dialogue: 1,0:04:25.87,0:04:30.61,JP,NTP,0,0,0,,Қасиетті Граил ешкіммен бәсекелеспей Джилді таңдады.
Dialogue: 1,0:04:31.01,0:04:35.30,JP,NTP,0,0,0,,Өйткені менің жалғыз тілегім - Богородицы Жанна Арктың қайта тірілуі.
Dialogue: 1,0:04:35.35,0:04:37.53,JP,NTP,0,0,0,,Өйткені бұл жерде орындалады
Dialogue: 1,0:04:47.78,0:04:51.75,JP,NTP,0,0,0,,Әрі қарай біздің барлық батыр рухтарымыздың дұғасын мазақ етсеңіз.
Dialogue: 1,0:04:52.22,0:04:53.77,JP,NTP,0,0,0,,Келесі жолы шектеусіз кесіңіз
Dialogue: 1,0:04:54.38,0:04:55.24,JP,NTP,0,0,0,,Жүріңдер, тұрыңдар.
Dialogue: 1,0:04:56.69,0:04:59.91,JP,NTP,0,0,0,,Жанна, сен жүрегіңді осылай жауып тастай аласың ба?
Dialogue: 1,0:05:00.22,0:05:02.04,JP,NTP,0,0,0,,Біз ештеңе істей алмаймыз.
Dialogue: 1,0:05:02.27,0:05:05.05,JP,NTP,0,0,0,,Кейбір өрескел өңдеу қажет болса
Dialogue: 1,0:05:05.20,0:05:07.96,JP,NTP,0,0,0,,Әрі қарай, тиісті дайындықтарды жасайық.
Dialogue: 1,0:05:08.28,0:05:10.15,JP,NTP,0,0,0,,Ант етемін, Жанна.
Dialogue: 1,0:05:10.27,0:05:15.60,JP,NTP,0,0,0,,Мен сенің жаныңды Алланың қарғысынан міндетті түрде азат етемін.
Dialogue: 1,0:05:22.45,0:05:26.31,JP,NTP,0,0,0,,Сөйлесе алмайтын адаммен жүру шаршатады.
Dialogue: 1,0:05:26.76,0:05:29.29,JP,NTP,0,0,0,,Келесі жолы мен сөзді айта алмай тұрып, сені кесіп аламын.
Dialogue: 1,0:05:29.59,0:05:31.33,JP,NTP,0,0,0,,Мұндай қимыл мені ауыртады.
Dialogue: 1,0:05:32.27,0:05:36.32,JP,NTP,0,0,0,,Бірақ бұл мен үшін бұл кеште бата болған шығар.
Dialogue: 1,0:05:36.93,0:05:39.60,JP,NTP,0,0,0,,Сол қолыңызды бұғаттап, қазіргі күйіңізде қалай күресуге болады
Dialogue: 1,0:05:39.91,0:05:42.02,JP,NTP,0,0,0,,Мен жаудың тым қауіпті екенін сезіндім.
Dialogue: 1,0:05:49.05,0:05:51.99,JP,NTP,0,0,0,,Сабердің қожайынға ұмтылуының күтпеген салдары
Dialogue: 1,0:05:52.31,0:05:54.81,JP,NTP,0,0,0,,Сіз Йомоя Кастерді түсіре аласыз ба?
Dialogue: 1,0:05:55.03,0:05:57.32,JP,NTP,0,0,0,,Әрине, оған ұмтылмасқа амал жоқ.
Dialogue: 1,0:05:59.74,0:06:00.84,JP,NTP,0,0,0,,Жоқ, жоқ
Dialogue: 1,0:06:01.25,0:06:03.25,JP,NTP,0,0,0,,Бас бармақ осындай
Dialogue: 1,0:06:07.51,0:06:08.54,JP,NTP,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 1,0:06:09.65,0:06:11.09,JP,NTP,0,0,0,,Керемет
Dialogue: 1,0:06:16.90,0:06:18.45,JP,NTP,0,0,0,,Қош келдіңіз күйеуіңіз
Dialogue: 1,0:06:23.82,0:06:24.95,JP,NTP,0,0,0,,(Йотаро Куджо) Өкінішті, бірақ осы сапарда… Какёинге жарыстан шығудан басқа амал қалмауы мүмкін.
Dialogue: 1,0:06:25.36,0:06:31.36,JP,NTP,0,0,0,,Жексұрын құдай Жаннаның жанын әлі де тұтқындап, жібермейді.
Dialogue: 1,0:06:31.76,0:06:35.21,JP,NTP,0,0,0,,Жанна - мен сол хрусталь шарда көрген қыз.
Dialogue: 1,0:06:36.44,0:06:39.12,JP,NTP,0,0,0,,Біз дәлелдеуіміз керек
Dialogue: 1,0:06:39.72,0:06:42.58,JP,NTP,0,0,0,,Тәңірлік беделдің құлауы, махаббаттың бос болуы
Dialogue: 1,0:06:43.00,0:06:48.39,JP,NTP,0,0,0,,Ешқандай ашулану немесе жамандық Құдайдың жазасына лайық емес.
Dialogue: 1,0:06:49.41,0:06:52.73,JP,NTP,0,0,0,,Мен түсіндім, менің күйеуімдікі өте керемет.
Dialogue: 1,0:06:52.89,0:06:57.53,JP,NTP,0,0,0,,Сондықтан біз одан әрі азғындық, одан әрі күпірлік жасаймыз.
Dialogue: 1,0:06:57.64,0:07:00.70,JP,NTP,0,0,0,,Жалған құдайлардың құрбандықтарын жина
Dialogue: 1,0:07:03.07,0:07:07.36,JP,NTP,0,0,0,,Бұл енді сапаға қарағанда сан жақсы деген сөз.
Dialogue: 1,0:07:07.53,0:07:10.07,JP,NTP,0,0,0,,Иә, дұрыс.
Dialogue: 1,0:07:10.43,0:07:12.32,JP,NTP,0,0,0,,Рюноскэ күткендей
Dialogue: 1,0:07:13.07,0:07:16.78,JP,NTP,0,0,0,,Алдымен түрмеде отырған он бір адамды дереу құрбандыққа шаламын.
Dialogue: 1,0:07:17.22,0:07:20.74,JP,NTP,0,0,0,,Содан кейін жаңа балалармен толықтырыңыз
Dialogue: 1,0:07:23.73,0:07:26.13,JP,NTP,0,0,0,,Бұл ысырап.
Dialogue: 1,0:07:30.02,0:07:34.53,JP,NTP,0,0,0,,Осы уақыт ішінде біз шұғыл жаңалықтарды жеткізу үшін бағдарлама кестесін өзгерттік.
Dialogue: 1,0:07:35.61,0:07:40.14,JP,NTP,0,0,0,,Фуюки қаласының шығанағы аймағындағы қойма ауданында белгісіз себеппен жарылыс болды.
Dialogue: 1,0:07:41.30,0:07:43.52,JP,NTP,0,0,0,,Реле жаңа ғана қосылған сияқты.
Dialogue: 1,0:07:45.07,0:07:48.06,JP,NTP,0,0,0,,Неліктен мен бүгін түнде Саберді өлтіре алмадым?
Dialogue: 1,0:07:48.32,0:07:49.97,JP,NTP,0,0,0,,Бір емес, екі рет
Dialogue: 1,0:07:50.24,0:07:53.96,JP,NTP,0,0,0,,Менің пәрмендерімнің бірін жойғаннан кейін де.
Dialogue: 1,0:07:56.18,0:07:59.66,JP,NTP,0,0,0,,Сабермен жарысу соншалықты қызықты болды ма?
Dialogue: 1,0:08:00.18,0:08:01.89,JP,NTP,0,0,0,,Мұндай заттар
Dialogue: 1,0:08:04.85,0:08:06.48,JP,NTP,0,0,0,,Рыцарьдың мақтанышына бәс тігу
Dialogue: 1,0:08:06.69,0:08:09.98,JP,NTP,0,0,0,,Мен сізге уәде беремін, сіз сол Сабердің басшысы боласыз.
Dialogue: 1,0:08:10.09,0:08:12.30,JP,NTP,0,0,0,,Қайтадан ант берудің қажеті жоқ
Dialogue: 1,0:08:12.44,0:08:13.76,JP,NTP,0,0,0,,Әрине
Dialogue: 1,0:08:13.98,0:08:16.99,JP,NTP,0,0,0,,Сен маған Қасиетті Граиль әкелуге келісім жасадың.
Dialogue: 1,0:08:17.55,0:08:22.02,JP,NTP,0,0,0,,Енді мен бір Сабер үшін сенімді жеңіске ант бердім,
Dialogue: 1,0:08:22.31,0:08:24.37,JP,NTP,0,0,0,,Нені дұрыс емес киіп жүрсің?
Dialogue: 1,0:08:24.44,0:08:27.03,JP,NTP,0,0,0,,Дұрыс емес аяқ киім киген сен емессің.
Dialogue: 1,0:08:27.75,0:08:29.44,JP,NTP,0,0,0,,Лорд Эль-Меллои
Dialogue: 1,0:08:31.50,0:08:32.66,JP,NTP,0,0,0,,Солау
Dialogue: 1,0:08:32.84,0:08:34.34,JP,NTP,0,0,0,,Жарайсың Лансер
Dialogue: 1,0:08:34.80,0:08:37.55,JP,NTP,0,0,0,,Қателік сіздің жағдайға қатысты пікіріңіз емес.
Dialogue: 1,0:08:37.90,0:08:40.94,JP,NTP,0,0,0,,Сабер ерекше күшті қызметші.
Dialogue: 1,0:08:41.51,0:08:45.41,JP,NTP,0,0,0,,Мен оны сол жерде тұрақты түрде жеңу мүмкіндігін жіберіп алмадым.
Dialogue: 1,0:08:46.13,0:08:48.64,JP,NTP,0,0,0,,Емделмейтін жара салдым.
Dialogue: 1,0:08:49.09,0:08:51.85,JP,NTP,0,0,0,,Сіз оны кез келген уақытта қалдырып өлтіре аласыз.
Dialogue: 1,0:08:52.31,0:08:54.71,JP,NTP,0,0,0,,Егер сіз Саберді қауіпті деп ойласаңыз.
Dialogue: 1,0:08:54.95,0:08:58.10,JP,NTP,0,0,0,,Неліктен Сабырдың қожайынын жалғыз қалдырдың?
Dialogue: 1,0:08:58.44,0:09:01.94,JP,NTP,0,0,0,,Жасырынып қарап отырсаң, аянышты болсаң болмайды.
Dialogue: 1,0:09:03.85,0:09:04.98,JP,NTP,0,0,0,,Кейнс
Dialogue: 1,0:09:05.39,0:09:09.61,JP,NTP,0,0,0,,Басқа шеберлерден қандай артықшылығыңыз бар?
Dialogue: 1,0:09:10.14,0:09:12.03,JP,NTP,0,0,0,,Бұл сіз түсінбегендіктен емес.
Dialogue: 1,0:09:12.84,0:09:15.85,JP,NTP,0,0,0,,Бастапқы келісімшарт жүйесіне бірегей келісім қосылды
Dialogue: 1,0:09:16.11,0:09:18.69,JP,NTP,0,0,0,,Қызметші мен қожайын арасындағы ретсіз келісім-шарт
Dialogue: 1,0:09:19.52,0:09:20.98,JP,NTP,0,0,0,,Сізде командалық сиқыр бар
Dialogue: 1,0:09:21.14,0:09:24.57,JP,NTP,0,0,0,,Мен басқа шебер ретінде сиқырлы қуат беремін.
Dialogue: 1,0:09:25.24,0:09:29.65,JP,NTP,0,0,0,,Күтілгендей, ол бір кездері некромантия бөліміндегі ең ұлы балалар вундеркиндісі ретінде аталды.
Dialogue: 1,0:09:31.42,0:09:34.02,JP,NTP,0,0,0,,Бірақ бастапқы кезеңде абай болыңыз
Dialogue: 1,0:09:34.26,0:09:38.33,JP,NTP,0,0,0,,Бұл дұрыс, бірақ неге жалғыз Лансерлер нәтижеге жетуге асығады?
Dialogue: 1,0:09:38.38,0:09:39.97,JP,NTP,0,0,0,,Осымен тоқталғаныңызды қалаймын.
Dialogue: 1,0:09:41.45,0:09:44.25,JP,NTP,0,0,0,,Одан асқанның бәрі мырзамды қорлау болып табылады.
Dialogue: 1,0:09:45.24,0:09:47.06,JP,NTP,0,0,0,,Рыцарь ретінде назардан тыс қалдыруға болмайды
Dialogue: 1,0:09:48.70,0:09:50.91,JP,NTP,0,0,0,,Жоқ, бұл менің айтқым келгені емес.
Dialogue: 1,0:09:52.16,0:09:54.61,JP,NTP,0,0,0,,Кешіріңіз, мен тым көп айттым.
Dialogue: 1,0:10:04.71,0:10:06.89,JP,NTP,0,0,0,,Не?
Dialogue: 1,0:10:15.74,0:10:17.42,JP,NTP,0,0,0,,Мұнда бүкіл күн оқумен өткізудің қажеті жоқ қой?
Dialogue: 1,0:10:18.44,0:10:20.22,JP,NTP,0,0,0,,Төменгі қабатта от бар.
Dialogue: 1,0:10:20.62,0:10:23.45,JP,NTP,0,0,0,,Бұл сөзсіз өртеу.
Dialogue: 1,0:10:23.56,0:10:25.96,JP,NTP,0,0,0,,Бүгін түнде өртеу
Dialogue: 1,0:10:26.15,0:10:28.10,JP,NTP,0,0,0,,​​Бұл адамдарға ақы төлеу жоспары.
Dialogue: 1,0:10:28.21,0:10:29.90,JP,NTP,0,0,0,,Содан кейін шабуыл жасаңыз
Dialogue: 1,0:10:32.15,0:10:37.91,JP,NTP,0,0,0,,Сабердің қожайыны найзаның қарғысын тезірек алып тастағысы келетін шығар.
Dialogue: 1,0:10:38.43,0:10:41.58,JP,NTP,0,0,0,,Лансер төменгі қабатқа түсіп, оның жолын кесті.
Dialogue: 1,0:10:41.75,0:10:43.68,JP,NTP,0,0,0,,Оларды қуып жіберме
Dialogue: 1,0:10:43.88,0:10:44.78,JP,NTP,0,0,0,,Түсінікті
Dialogue: 1,0:10:51.56,0:10:54.52,JP,NTP,0,0,0,,Бір қабаты жалға берілген тамаша шеберхана.
Dialogue: 1,0:10:55.58,0:10:58.67,JP,NTP,0,0,0,,24-қабат тосқауыл, үш сиқырлы пеш
Dialogue: 1,0:10:58.98,0:11:01.81,JP,NTP,0,0,0,,Аңшы иттердің рөлін атқаратын ондаған зұлым рухтар
Dialogue: 1,0:11:02.34,0:11:06.70,JP,NTP,0,0,0,,Сансыз тұзақтар бар және дәліздің кейбір бөліктері басқа әлемге айналды.
Dialogue: 1,0:11:09.81,0:11:14.50,JP,NTP,0,0,0,,Идея: біз өзіміздің құпия техникаларымызды барынша пайдалана отырып, бір-бірімізбен бәсекелесе аламыз.
Dialogue: 1,0:11:15.54,0:11:20.16,JP,NTP,0,0,0,,Мен сізден аяныштымын деген пікіріңізден дереу бас тартуыңызды сұраймын.
Dialogue: 1,0:11:20.40,0:11:22.47,JP,NTP,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 1,0:11:29.73,0:11:31.19,JP,NTP,0,0,0,,Арчибалд мырза
Dialogue: 1,0:11:32.12,0:11:34.51,JP,NTP,0,0,0,,Кейнет Эль-Меллои Арчибалд мырза
Dialogue: 1,0:11:35.34,0:11:36.77,JP,NTP,0,0,0,,Сіз осындасыз ба?
Dialogue: 1,0:11:36.37,0:11:36.72,JP,NTP,0,0,0,,Иә
Dialogue: 1,0:11:38.71,0:11:40.54,JP,NTP,0,0,0,,Бұл менмін, уайымдама.
Dialogue: 1,0:11:43.13,0:11:44.97,JP,NTP,0,0,0,,Кейнет Эль-Меллои Арчибалд
Dialogue: 1,0:11:45.32,0:11:47.84,JP,NTP,0,0,0,,Әйелім Солау екеуміз эвакуацияландық.
Dialogue: 1,0:11:51.76,0:11:53.13,JP,NTP,0,0,0,,Солай ма?
Dialogue: 1,0:11:53.59,0:11:55.49,JP,NTP,0,0,0,,А, иә, жақсы.
Dialogue: 1,0:11:57.34,0:11:58.80,JP,NTP,0,0,0,,Барлығы эвакуацияланды
Dialogue: 1,0:11:58.94,0:11:59.43,JP,NTP,0,0,0,,Жарайды
Dialogue: 1,0:12:01.89,0:12:04.02,JP,NTP,0,0,0,,Дайындық аяқталды.
Dialogue: 1,0:12:04.27,0:12:06.40,JP,NTP,0,0,0,,Ешқандай ауытқу жоқ. Кез келген уақытта келіңіз.
Dialogue: 1,0:12:46.22,0:12:46.52,JP,NTP,0,0,0,,Майя
Dialogue: 1,0:12:47.07,0:12:49.21,JP,NTP,0,0,0,,Нысанада соңына дейін қозғалыс болған жоқ
Dialogue: 1,0:12:49.86,0:12:51.80,JP,NTP,0,0,0,,Қонақ үй сыртына қашып кетпеді
Dialogue: 1,0:12:52.05,0:12:54.95,JP,NTP,0,0,0,,150 метр биіктіктен еркін құлау
Dialogue: 1,0:12:55.82,0:12:58.20,JP,NTP,0,0,0,,Қандай сиқырлы тосқауыл болса да, өзіңді нығайтқансың.
Dialogue: 1,0:12:59.04,0:13:00.45,JP,NTP,0,0,0,,Өзіңді құтқарудың жолы жоқ.
Dialogue: 1,0:13:11.17,0:13:12.69,JP,NTP,0,0,0,,Майя, шегін.
Dialogue: 1,0:13:20.50,0:13:21.57,JP,NTP,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 1,0:13:22.20,0:13:24.12,JP,NTP,0,0,0,,Ғимаратты да жару керек пе?
Dialogue: 1,0:13:24.83,0:13:26.98,JP,NTP,0,0,0,,Мен оны мүлде сиқыршы деп ойламаймын.
Dialogue: 1,0:13:28.21,0:13:32.92,JP,NTP,0,0,0,,Жоқ. Бұл сенің сиқыршыларды жеңуге шебер екеніңді білдіре ме?
Dialogue: 1,0:13:33.89,0:13:35.58,JP,NTP,0,0,0,,Кирей Котомине
Dialogue: 1,0:13:36.05,0:13:39.14,JP,NTP,0,0,0,,Хо, бұл менің сенімен бірінші рет кездесуім болуы керек.
Dialogue: 1,0:13:39.99,0:13:43.16,JP,NTP,0,0,0,,Әлде мені білуге ​​себеп болды ма?
Dialogue: 1,0:13:43.87,0:13:46.28,JP,NTP,0,0,0,,Сонда мен сіздің фоныңызды болжай аламын.
Dialogue: 1,0:13:47.98,0:13:50.37,JP,NTP,0,0,0,,Мені жай ғана сөйлетпе, әйел.
Dialogue: 1,0:13:50.88,0:13:52.53,JP,NTP,0,0,0,,Бір ғана жауап қажет
Dialogue: 1,0:13:53.11,0:13:57.12,JP,NTP,0,0,0,,Сізге келуге тиіс адам қайда?
Dialogue: 1,0:14:06.38,0:14:08.49,JP,NTP,0,0,0,,Жаман қадам емес.
Dialogue: 1,0:14:08.89,0:14:10.98,JP,NTP,0,0,0,,Ол біршама дайындалған сияқты.
Dialogue: 1,0:14:34.98,0:14:37.21,JP,NTP,0,0,0,,Оны лақтырған әйел емес пе еді?
Dialogue: 1,0:14:48.06,0:14:49.26,JP,NTP,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 1,0:14:49.45,0:14:52.55,JP,NTP,0,0,0,,Сол әйелге көмектесетін біреу болғандықтан
Dialogue: 1,0:14:52.70,0:14:54.97,JP,NTP,0,0,0,,Бүгін түнде егін орағы.
Dialogue: 1,0:14:57.43,0:14:58.17,JP,NTP,0,0,0,,Кирей-сама
Dialogue: 1,0:14:58.69,0:15:02.75,JP,NTP,0,0,0,,Мен саған өзіңді көпшілік алдында көрсетпе деп айтуым керек еді.
Dialogue: 1,0:15:02.84,0:15:03.82,JP,NTP,0,0,0,,Қорқынышпен
Dialogue: 1,0:15:04.25,0:15:08.13,JP,NTP,0,0,0,,Сіздердің назарларыңызға тезірек жеткізілетін мәселе бар.
Dialogue: 1,0:15:08.56,0:15:10.82,JP,NTP,0,0,0,,Ақыры құймашыны қолға түсірдік.
Dialogue: 1,0:15:13.78,0:15:16.71,JP,NTP,0,0,0,,Мен Ассасинге егжей-тегжейлі тексеруді сұрадым.
Dialogue: 1,0:15:17.11,0:15:18.66,JP,NTP,0,0,0,,Дөңгелекшілер және олардың шеберлері
Dialogue: 1,0:15:18.91,0:15:21.37,JP,NTP,0,0,0,,Мияма қаласынан көрші қалаға дейін
Dialogue: 1,0:15:21.67,0:15:24.28,JP,NTP,0,0,0,,Бірінен соң бірі ұйықтап жатқан бала
Dialogue: 1,0:15:24.43,0:15:26.86,JP,NTP,0,0,0,,Таң атқанша ұрланған 15 адам
Dialogue: 1,0:15:27.38,0:15:28.72,JP,NTP,0,0,0,,Қазір шығар
Dialogue: 1,0:15:28.98,0:15:34.48,JP,NTP,0,0,0,,Бұл дүрбелең тудырған сериялық өлтірушімен бірдей адам ма?
Dialogue: 1,0:15:34.56,0:15:37.52,JP,NTP,0,0,0,,Олар сиқырлықпен айналысады.
Dialogue: 1,0:15:37.81,0:15:40.93,JP,NTP,0,0,0,,Біз оның ізін жасырған жоқпыз.
Dialogue: 1,0:15:41.77,0:15:46.61,JP,NTP,0,0,0,,Қасиетті Граил соғысының өзі енді менің ойымда мүлде жоқ па деп ойлаймын.
Dialogue: 1,0:15:47.35,0:15:52.05,JP,NTP,0,0,0,,Бақылаудан шығып кеткен ақылы бұзылған қызметші мен оны басқармайтын қожайын?
Dialogue: 1,0:15:53.06,0:15:55.81,JP,NTP,0,0,0,,Неліктен жер бетінде мұндай адамдар Қасиетті Граил соғысына қатысады?
Dialogue: 1,0:15:56.65,0:15:59.60,JP,NTP,0,0,0,,Мұны сізге қалдырамыз деп ойлаймын, Токиоми-кун.
Dialogue: 1,0:15:59.91,0:16:04.04,JP,NTP,0,0,0,,Кастерлердің әрекеттері ережелерді анық бұзады
Dialogue: 1,0:16:04.10,0:16:04.85,JP,NTP,0,0,0,,Әрине
Dialogue: 1,0:16:05.34,0:16:09.21,JP,NTP,0,0,0,,Сиқырды жасыруға жауапты адам ретінде мен өзімді кешіре алмаймын.
Dialogue: 1,0:16:09.80,0:16:14.22,JP,NTP,0,0,0,,Кастер мен оның қожайынын жоюдан басқа амал жоқ.
Dialogue: 1,0:16:14.43,0:16:18.96,JP,NTP,0,0,0,,Мәселе мынада, қызметшілердің өз қызметшілерін қарсы тұру үшін пайдаланудан басқа амалы жоқ.
Dialogue: 1,0:16:19.40,0:16:20.24,JP,NTP,0,0,0,,Саритота
Dialogue: 1,0:16:20.44,0:16:23.26,JP,NTP,0,0,0,,Мен өлтірушімді жібере алмаймын.
Dialogue: 1,0:16:26.51,0:16:29.75,JP,NTP,0,0,0,,Ереженің кішігірім өзгерістері менің құзырымда.
Dialogue: 1,0:16:29.95,0:16:33.12,JP,NTP,0,0,0,,Кастерді бағындыру үшін барлық шеберлерді жұмылдырыңыз
Dialogue: 1,0:16:38.61,0:16:39.54,JP,NTP,0,0,0,,Садақшы
Dialogue: 1,0:16:39.73,0:16:41.28,JP,NTP,0,0,0,,Саны аз болғанымен,
Dialogue: 1,0:16:41.35,0:16:43.98,JP,NTP,0,0,0,,Онда Токионың бөлмесінен де көп асыл тастар бар.
Dialogue: 1,0:16:44.20,0:16:46.42,JP,NTP,0,0,0,,Кейбір шектен шыққан шәкірттер болды.
Dialogue: 1,0:16:46.64,0:16:47.93,JP,NTP,0,0,0,,Жер бетінде ол не үшін?
Dialogue: 1,0:16:48.73,0:16:50.83,JP,NTP,0,0,0,,Тым зеріккендер
Dialogue: 1,0:16:51.05,0:16:53.29,JP,NTP,0,0,0,,Менен басқалар бар сияқты болды.
Dialogue: 1,0:16:55.06,0:16:56.03,JP,NTP,0,0,0,,Жалқаулық
Dialogue: 1,0:16:56.45,0:17:00.00,JP,NTP,0,0,0,,Әйтпесе, шіркеудің қорғауындағы қожайын мәртебесінде.
Dialogue: 1,0:17:00.11,0:17:01.98,JP,NTP,0,0,0,,Рұқсатсыз көшеге шықпаңыз.
Dialogue: 1,0:17:02.55,0:17:03.76,JP,NTP,0,0,0,,Тіпті араластырсам да—
Dialogue: 1,0:17:04.55,0:17:08.74,JP,NTP,0,0,0,,Қазір келісім-шартқа көңіліңіз толмай ма? Гильгамеш
Dialogue: 1,0:17:09.05,0:17:10.77,JP,NTP,0,0,0,,Токиоми мені шақырды
Dialogue: 1,0:17:10.99,0:17:12.92,JP,NTP,0,0,0,,Бұл денені осы дүниеде ұстау
Dialogue: 1,0:17:13.51,0:17:15.70,JP,NTP,0,0,0,,Ең бастысы, өз қол астындағылардың садақасын алатындарға.
Dialogue: 1,0:17:15.93,0:17:18.29,JP,NTP,0,0,0,,Жауап бермеуге шамасы жоқ.
Dialogue: 1,0:17:19.13,0:17:21.90,JP,NTP,0,0,0,,Бірақ мен оны соншалықты қызықсыз деп ойламадым.
Dialogue: 1,0:17:22.78,0:17:24.94,JP,NTP,0,0,0,,Мастер Токиомидің аранжировкасына көңіліңіз толмай ма?
Dialogue: 1,0:17:25.89,0:17:27.94,JP,NTP,0,0,0,,Сіз «көз құйындысына» жеткенде
Dialogue: 1,0:17:28.55,0:17:31.10,JP,NTP,0,0,0,,Бұл шынымен қызықсыз жоспар болды.
Dialogue: 1,0:17:33.36,0:17:37.90,JP,NTP,0,0,0,,«Көзге» ұмтылу тек сиқыршыларға ғана тән
Dialogue: 1,0:17:38.65,0:17:40.81,JP,NTP,0,0,0,,Бұл бөгде адамдар шағымданатын нәрсе емес.
Dialogue: 1,0:17:41.57,0:17:43.69,JP,NTP,0,0,0,,«Түбірге» саяхат дегеніміз не?
Dialogue: 1,0:17:44.21,0:17:46.89,JP,NTP,0,0,0,,Бұл, былайша айтқанда, әлемнің «сыртына» кету.
Dialogue: 1,0:17:47.50,0:17:49.98,JP,NTP,0,0,0,,Бізді тек ішкі дүние қызықтырады
Dialogue: 1,0:17:50.41,0:17:52.89,JP,NTP,0,0,0,,Мен мұны тек жалықтыратын әрекет деп түсінемін.
Dialogue: 1,0:17:53.57,0:17:59.87,JP,NTP,0,0,0,,Расында, менің бағым болған мына ғаламға тамсанып қана көңілім толады.
Dialogue: 1,0:18:00.28,0:18:03.33,JP,NTP,0,0,0,,Мені бақылаудан тыс салаларға қызықтырмаймын.
Dialogue: 1,0:18:03.69,0:18:06.37,JP,NTP,0,0,0,,«Түбірге» қызықпаймын.
Dialogue: 1,0:18:06.56,0:18:10.79,JP,NTP,0,0,0,,Алайда, Қасиетті Граил тек «тамырды» іздеуге арналған арнайы құрылғы емес.
Dialogue: 1,0:18:11.45,0:18:13.43,JP,NTP,0,0,0,,Құдіретті болу дегенді білдіреді
Dialogue: 1,0:18:13.67,0:18:19.22,JP,NTP,0,0,0,,Бұл бізде әлемнің ішкі көрінісін өзгертуге шексіз мүмкіндіктер бар екенін білдіреді.
Dialogue: 1,0:18:19.47,0:18:20.86,JP,NTP,0,0,0,,Басқа шеберлер
Dialogue: 1,0:18:21.23,0:18:25.28,JP,NTP,0,0,0,,Демек, сіз Токиомиге қарағанда Киелі Граалды басқа мақсатпен іздеп жүрсіз бе?
Dialogue: 1,0:18:25.53,0:18:29.75,JP,NTP,0,0,0,,Мастер Токиоми - сиқыршының бейнесі және сонымен бірге ең оңшыл адам.
Dialogue: 1,0:18:30.15,0:18:36.31,JP,NTP,0,0,0,,Басқа адамдардың іздегені – ішкі дүниесі, қалқыған дүниенің берекесі.
Dialogue: 1,0:18:36.82,0:18:39.15,JP,NTP,0,0,0,,Prestige Desire Power…
Dialogue: 1,0:18:39.21,0:18:42.64,JP,NTP,0,0,0,,Бұл жақсы емес пе? Олардың бәрі мен жақсы көретін нәрселер.
Dialogue: 1,0:18:43.24,0:18:47.92,JP,NTP,0,0,0,,Дүниенің шыңында билік еткен патша сенсің, Гильгамеш.
Dialogue: 1,0:18:48.55,0:18:51.81,JP,NTP,0,0,0,,Қалайсың, Кирей?
Dialogue: 1,0:18:58.04,0:19:00.29,JP,NTP,0,0,0,,Қасиетті Граилдан не қалайсыз?
Dialogue: 1,0:19:00.57,0:19:05.00,JP,NTP,0,0,0,,Менің басқа тілегім жоқ.
Dialogue: 1,0:19:05.86,0:19:07.42,JP,NTP,0,0,0,,Бұл дұрыс емес.
Dialogue: 1,0:19:07.86,0:19:12.66,JP,NTP,0,0,0,,Қасиетті Граил оны ұстауға лайық адамдарды ғана тартады емес пе?
Мен де
Dialogue: 1,0:19:13.12,0:19:14.25,JP,NTP,0,0,0,,Бұл солай болуы керек.
Dialogue: 1,0:19:14.72,0:19:16.39,JP,NTP,0,0,0,,түсінбеймін.
Dialogue: 1,0:19:16.71,0:19:21.65,JP,NTP,0,0,0,,Неліктен бұл шайқасқа мұраты мен ұмтылысы жоқ мен таңдалды?
Dialogue: 1,0:19:21.98,0:19:24.01,JP,NTP,0,0,0,,Ешбір мұрат, ұмтылыс жоқ
Dialogue: 1,0:19:24.22,0:19:26.80,JP,NTP,0,0,0,,Олай болса, біз тек рахатқа үміттенуіміз керек емес пе?
Dialogue: 1,0:19:27.35,0:19:29.14,JP,NTP,0,0,0,,Ақылсыз ләззат т.б.
Dialogue: 1,0:19:29.87,0:19:32.71,JP,NTP,0,0,0,,Сен маған осындай күнәһар азғындыққа барайын деп тұрсың ба?
Dialogue: 1,0:19:33.48,0:19:36.07,JP,NTP,0,0,0,,Күнәкар азғындық
Dialogue: 1,0:19:36.43,0:19:38.14,JP,NTP,0,0,0,,Бұл тағы бір секіріс.
Dialogue: 1,0:19:38.49,0:19:40.41,JP,NTP,0,0,0,,Ләззат пен күнә неге байланысты?
Dialogue: 1,0:19:42.21,0:19:43.05,JP,NTP,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 1,0:19:44.60,0:19:47.87,JP,NTP,0,0,0,,Түсіндім, жаман істерден алған ләззат күнә болуы мүмкін.
Dialogue: 1,0:19:48.21,0:19:50.91,JP,NTP,0,0,0,,Бірақ адам жақсы істерден де рахат алады.
Dialogue: 1,0:19:51.61,0:19:54.39,JP,NTP,0,0,0,,Ләззаттың өзі зұлымдық деген қорытынды жасау
Dialogue: 1,0:19:54.80,0:19:56.55,JP,NTP,0,0,0,,Бұл қандай логика?
Dialogue: 1,0:19:57.32,0:19:59.98,JP,NTP,0,0,0,,Ләззат та менің ішімде емес.
Dialogue: 1,0:20:00.39,0:20:02.24,JP,NTP,0,0,0,,Мен оны іздеп жүрмін, бірақ таба алмаймын
Dialogue: 1,0:20:04.15,0:20:05.88,JP,NTP,0,0,0,,Кирей Котомине
Dialogue: 1,0:20:07.35,0:20:09.43,JP,NTP,0,0,0,,Мен кенеттен саған қызыға бастадым.
Dialogue: 1,0:20:10.83,0:20:11.90,JP,NTP,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 1,0:20:13.05,0:20:14.38,JP,NTP,0,0,0,,Сөздер айтқандай.
Dialogue: 1,0:20:14.76,0:20:15.85,JP,NTP,0,0,0,,Ал, отырыңыз.
Dialogue: 1,0:20:22.62,0:20:26.49,JP,NTP,0,0,0,,Ләззат, былайша айтқанда, жанның күйі.
Dialogue: 1,0:20:27.38,0:20:28.92,JP,NTP,0,0,0,,Оның бар-жоғы туралы емес.
Dialogue: 1,0:20:29.35,0:20:31.55,JP,NTP,0,0,0,,Сіз мұны білесіз бе, білмейсіз бе деп өзіңізден сұраңыз.
Dialogue: 1,0:20:32.09,0:20:36.03,JP,NTP,0,0,0,,Кирей Сіз әлі де жаныңыздың қайда екенін көре алмайсыз.
Dialogue: 1,0:20:36.69,0:20:39.11,JP,NTP,0,0,0,,Көңіл көтеруді ұмытпаңыз
Dialogue: 1,0:20:39.19,0:20:40.77,JP,NTP,0,0,0,,Міне, осыған байланысты.
Dialogue: 1,0:20:40.85,0:20:44.35,JP,NTP,0,0,0,,Қызметші стилі маған дәріс беруге тырысып жатыр ма?
Dialogue: 1,0:20:44.67,0:20:46.22,JP,NTP,0,0,0,,Әдемі болма, дәурен
Dialogue: 1,0:20:46.68,0:20:50.35,JP,NTP,0,0,0,,Бұл дүниенің барлық сән-салтанаты мен рахатын жеген патшаның сөзі.
Dialogue: 1,0:20:50.68,0:20:52.44,JP,NTP,0,0,0,,Ал, аузыңды жап, тыңда.
Dialogue: 1,0:20:54.75,0:20:58.31,JP,NTP,0,0,0,,Кирей Сіз ойын-сауықтың не екенін білуіңіз керек.
Dialogue: 1,0:20:58.85,0:21:00.70,JP,NTP,0,0,0,,Алдымен сыртқа қараңыз.
Dialogue: 1,0:21:00.92,0:21:01.83,JP,NTP,0,0,0,,That's right.
Dialogue: 1,0:21:02.57,0:21:06.20,JP,NTP,0,0,0,,Неге менімен көңіл көтеруден бастамайсың?
Dialogue: 1,0:21:06.86,0:21:09.87,JP,NTP,0,0,0,,Көңіл көтеруге уақытым жоқ.
Dialogue: 1,0:21:10.51,0:21:12.09,JP,NTP,0,0,0,,Ал, олай айтпа.
Dialogue: 1,0:21:12.42,0:21:15.41,JP,NTP,0,0,0,,Бұл Токиоға тапсырылған жұмысты орындау кезінде бос уақытыңызда жасай алатын нәрсе.
Dialogue: 1,0:21:16.27,0:21:17.49,JP,NTP,0,0,0,,Бірінші орында Кирей
Dialogue: 1,0:21:18.08,0:21:22.06,JP,NTP,0,0,0,,Сіздің рөліңіз басқа бес шеберге тыңшыларды жіберу болады.
Dialogue: 1,0:21:23.10,0:21:24.06,JP,NTP,0,0,0,,Дәптер
Dialogue: 1,0:21:24.22,0:21:26.80,JP,NTP,0,0,0,,Олардың ниеттері мен стратегиялары ғана емес.
Dialogue: 1,0:21:26.89,0:21:29.30,JP,NTP,0,0,0,,Мотивті де зерттеңіз.
Dialogue: 1,0:21:29.61,0:21:31.78,JP,NTP,0,0,0,,Менімен сөйлесіңіз
Dialogue: 1,0:21:32.59,0:21:35.84,JP,NTP,0,0,0,,Бұл туралы өлтірушілерге айтсаң болады.
Dialogue: 1,0:21:36.53,0:21:40.62,JP,NTP,0,0,0,,Бірақ Арчер, сен мұндай нәрсені естігенде не істейсің?
Dialogue: 1,0:21:41.12,0:21:43.90,JP,NTP,0,0,0,,Бұрын да айтқанмын, Адамдардың жұмысына сүйсінемін.
Dialogue: 1,0:21:44.14,0:21:47.99,JP,NTP,0,0,0,,Ішінде бір-екі қызық адам бар шығар.
Dialogue: 1,0:21:48.94,0:21:51.38,JP,NTP,0,0,0,,Кем дегенде Токиомен салыстырғанда.
Dialogue: 1,0:21:53.61,0:21:56.21,JP,NTP,0,0,0,,Жарайды, Арчер, мен қабылдадым.
Dialogue: 1,0:21:56.61,0:21:59.30,JP,NTP,0,0,0,,Дегенмен, бұл біраз уақытты алады
Dialogue: 1,0:21:59.68,0:22:02.20,JP,NTP,0,0,0,,Маған бәрібір, шыдамдылықпен күтемін
Dialogue: 1,0:22:02.86,0:22:05.10,JP,NTP,0,0,0,,Бұл жерде сакеге де қамқорлық жасағанда.
Dialogue: 1,0:22:10.78,0:22:13.10,JP,NTP,0,0,0,,Қасиетті Граильді іздеудің себептері және т.б.
Dialogue: 1,0:22:13.75,0:22:15.93,JP,NTP,0,0,0,,Мен өте сөйлейтінмін.
Dialogue: 1,0:22:18.14,0:22:20.55,JP,NTP,0,0,0,,Әрине ләззат емес
Dialogue: 1,0:22:27.90,0:22:32.48,JP,NTP,0,0,0,,Бірақ ол кісімен таныссам
Dialogue: 1,0:22:33.09,0:22:38.63,JP,NTP,0,0,0,,Мен іздеген нәрсенің түрін де біле аламын ба?
Dialogue: 1,0:22:41.01,0:22:43.44,JP,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 1,0:24:18.38,0:24:20.83,JP,NTP,0,0,0,,Уақытша ереже өзгерістерін конфигурациялау
Dialogue: 1,0:24:20.92,0:24:22.78,JP,NTP,0,0,0,,Кирицугу Эмияны өлтіріңіз
Dialogue: 1,0:24:22.78,0:24:24.83,JP,NTP,0,0,0,,Сіз қазір қашып кете аласыз.
Dialogue: 1,0:24:24.83,0:24:27.16,JP,NTP,0,0,0,,Сабырдың басы - найзамның абыройы
Dialogue: 1,0:24:27.16,0:24:29.65,JP,NTP,0,0,0,,Менің сізбен Қасиетті Граил үшін бәсекелесуге ниетім жоқ.
Dialogue: 1,0:24:29.65,0:24:32.45,JP,NTP,0,0,0,,Мақтаншақ болма, бейбақ.
Dialogue: 0,0:24:33.95,0:24:39.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
