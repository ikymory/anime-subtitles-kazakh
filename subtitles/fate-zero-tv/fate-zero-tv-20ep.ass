Dialogue: 1,0:03:35.82,0:03:39.82,Opening-English-L1,,0,0,0,,Қайда барсам да
Dialogue: 0,0:03:40.11,0:03:45.70,Opening-Romaji-L0,,0,0,0,,Кегарекитта кисеки во се ни
Dialogue: 0,0:03:40.11,0:03:45.70,Opening-Kanji-L0,,0,0,0,,Артымда лас ғажайыппен
Dialogue: 0,0:03:40.11,0:03:45.70,Opening-English-L0,,0,0,0,,Мен бұл ластанған ғажайыптарды көтеремін
Dialogue: 1,0:03:40.11,0:03:45.70,Opening-Romaji-L1,,0,0,0,,Кегарекитта кисеки во се ни
Dialogue: 1,0:03:40.11,0:03:45.70,Opening-Kanji-L1,,0,0,0,,Артымда кір ғажайыппен
Dialogue: 1,0:03:40.11,0:03:45.70,Opening-English-L1,,0,0,0,,Мен бұл ластанған ғажайыптарды көтеремін
Dialogue: 4,0:04:09.77,0:04:13.94,Default,,0,0,0,,Сабер бір уақытта екі найзаны да іздейді.
Dialogue: 1,0:04:09.94,0:04:13.34,JP-ja,NTP,0,0,0,,Сабер бір мезетте екі найзаға қарсы қорғанды.
Dialogue: 4,0:04:14.31,0:04:18.19,Default,,0,0,0,,Ол Лансердің қай найзасы оның тұлпары екенін білмейді.
Dialogue: 1,0:04:14.52,0:04:17.72,JP-ja,NTP,0,0,0,,Өйткені мен Лансердің қандай найза екенін білмеймін.
Dialogue: 4,0:04:19.15,0:04:21.69,Default,,0,0,0,,Оң қолында ұзын найза, сол қолында қысқа найза.
Dialogue: 1,0:04:19.27,0:04:21.47,JP-ja,NTP,0,0,0,,Оң жақта ұзын найза, сол жақта қысқа найза
Dialogue: 4,0:04:22.61,0:04:24.74,Default,,0,0,0,,Солардың қайсысы оның асыл фантасмасы?
Dialogue: 1,0:04:22.70,0:04:24.38,JP-ja,NTP,0,0,0,,Қайсысы асыл фантасма?
Dialogue: 4,0:04:25.49,0:04:30.04,Default,,0,0,0,,Егер мен қайсысын анықтай алсам, мен шабуыл жасай аламын.
Dialogue: 1,0:04:25.67,0:04:27.36,JP-ja,NTP,0,0,0,,Егер біз мұны ажырата алсақ
Dialogue: 1,0:04:27.89,0:04:29.94,JP-ja,NTP,0,0,0,,Жеңіске жету мүмкіндігі бар дейді.
Dialogue: 4,0:04:30.62,0:04:33.46,Default,,0,0,0,,Оның шын есімін білсек.
Dialogue: 1,0:04:31.05,0:04:33.41,JP-ja,NTP,0,0,0,,Тым болмаса шын есіміңді білсем ғой.
Dialogue: 4,0:04:38.46,0:04:41.71,Default,,0,0,0,,Ол, сөзсіз, найза қолданатын Батырлық Рух.
Dialogue: 1,0:04:38.96,0:04:41.55,JP-ja,NTP,0,0,0,,Найзаның ұшын алатын батыр рух екені даусыз.
Dialogue: 4,0:04:42.26,0:04:43.63,Default,,0,0,0,,Бірақ бұл жеткіліксіз.
Dialogue: 1,0:04:42.42,0:04:43.94,JP-ja,NTP,0,0,0,,Бірақ бұл бәрі емес
Dialogue: 4,0:04:55.31,0:04:58.31,Default,,0,0,0,,Не болды, Сабер? Сіз қорғаныстасыз!
Dialogue: 1,0:04:55.82,0:04:58.18,JP-ja,NTP,0,0,0,,Не болды, Сабер, сенің шабуылың тым әлсіз?
Dialogue: 4,0:04:59.36,0:05:01.03,Default,,0,0,0,,Ол жақсы.
Dialogue: 1,0:04:59.53,0:05:01.32,JP-ja,NTP,0,0,0,,Бұл адам жасай алады
Dialogue: 4,0:05:19.75,0:05:21.71,Default,,0,0,0,,Оның қылышын қарғыс атсын.
Dialogue: 1,0:05:19.89,0:05:21.64,JP-ja,NTP,0,0,0,,Қандай үшбұрышты қылыш!
Dialogue: 4,0:05:22.59,0:05:26.80,Default,,0,0,0,,Мен бұл пышақтың ұзындығын білмей, қашықтықты бағалай алмаймын.
Dialogue: 1,0:05:22.71,0:05:26.59,JP-ja,NTP,0,0,0,,Пышақтың ұзындығын білмесеңіз, қашықтықты өлшеуге мүмкіндік жоқ.
Dialogue: 4,0:05:27.97,0:05:33.72,Default,,0,0,0,,Менің бұлай соққыларыма тойтарыс беру үшін ол шебер қылышшы болуы керек.
Dialogue: 1,0:05:28.12,0:05:30.44,JP-ja,NTP,0,0,0,,Менің найзаның жүзін қалай қайтара алдың?
Dialogue: 1,0:05:31.08,0:05:33.38,JP-ja,NTP,0,0,0,,Бұл әйел шебер қылышшы.
Dialogue: 4,0:06:03.80,0:06:04.71,Default,,0,0,0,,Майя.
Dialogue: 1,0:06:03.96,0:06:04.40,JP-ja,NTP,0,0,0,,Майя
Dialogue: 4,0:06:05.26,0:06:07.17,Default,,0,0,0,,Сабер мен Лансердің солтүстік-шығысында.
Dialogue: 1,0:06:05.40,0:06:07.21,JP-ja,NTP,0,0,0,,Сабердің солтүстік-шығыс бағыты
Dialogue: 4,0:06:08.09,0:06:10.18,Default,,0,0,0,,Сол қойманың төбесінде.
Dialogue: 1,0:06:08.40,0:06:11.68,JP-ja,NTP,0,0,0,,Қойманың төбесінде Лансер шебері бар.
Dialogue: 4,0:06:10.18,0:06:12.85,Default,,0,0,0,,Бұл Лансердің шебері. Сіз оны көре аласыз ба?
Dialogue: 1,0:06:12.27,0:06:12.79,JP-ja,NTP,0,0,0,,Сіз оны көре аласыз ба?
Dialogue: 4,0:06:15.60,0:06:19.35,Default,,0,0,0,,Теріс. Менің ұстанымымнан емес.
Dialogue: 1,0:06:16.03,0:06:19.11,JP-ja,NTP,0,0,0,,Жоқ. Менің ұстанымымнан бұл соқыр нүкте сияқты.
Dialogue: 4,0:06:19.73,0:06:22.61,Default,,0,0,0,,Жарайды. Мен оны шығарып саламын.
Dialogue: 1,0:06:19.86,0:06:22.61,JP-ja,NTP,0,0,0,,Жарайды, мен сені осы жерде өлтіремін.
Dialogue: 4,0:06:36.70,0:06:37.75,Default,,0,0,0,,Ассасин?
Dialogue: 1,0:06:36.75,0:06:37.37,JP-ja,NTP,0,0,0,,Ассасин
Dialogue: 4,0:06:40.67,0:06:45.13,Default,,0,0,0,,Мион өзенінің сағасындағы қоймаларда белсенділік бар.
Dialogue: 1,0:06:40.76,0:06:44.59,JP-ja,NTP,0,0,0,,Муто өзенінің сағасындағы қойма ауданында қозғалыс болды.
Dialogue: 4,0:06:45.13,0:06:49.13,Default,,0,0,0,,Бірінші шайқас ақыры басталды.
Dialogue: 1,0:06:45.50,0:06:48.88,JP-ja,NTP,0,0,0,,Бірінші шайқас ақыры басталған сияқты.
Dialogue: 4,0:06:49.84,0:06:52.30,Default,,0,0,0,,Бірінші емес.
Dialogue: 1,0:06:49.89,0:06:51.93,JP-ja,NTP,0,0,0,,Бірінші болу деген ұғым жоқ.
Dialogue: 4,0:06:52.30,0:06:55.56,Default,,0,0,0,,Бұл техникалық жағынан екінші шайқас, Кирей.
Dialogue: 1,0:06:52.43,0:06:55.36,JP-ja,NTP,0,0,0,,Ресми түрде бұл «екінші тур» Кирей.
Dialogue: 4,0:06:56.81,0:07:01.56,Default,,0,0,0,,Сабер мен Лансер жауынгерлер сияқты.
Dialogue: 1,0:06:56.97,0:06:59.22,JP-ja,NTP,0,0,0,,Ұрысатын Сабыр болса керек.
Dialogue: 1,0:06:59.60,0:07:01.30,JP-ja,NTP,0,0,0,,Және ол Лансерге ұқсайды
Dialogue: 4,0:07:01.56,0:07:05.86,Default,,0,0,0,,Қызметшілердің күйлерін Ассасиннің көзімен оқи аласыз ба?
Dialogue: 1,0:07:01.72,0:07:05.31,JP-ja,NTP,0,0,0,,Қызметші мәртебесін өлтірушінің көзімен оқуға бола ма?
Dialogue: 4,0:07:05.86,0:07:07.19,Default,,0,0,0,,Оңай.
Dialogue: 1,0:07:06.02,0:07:06.71,JP-ja,NTP,0,0,0,,Мәселе жоқ
Dialogue: 4,0:07:07.19,0:07:10.78,Default,,0,0,0,,Сабердің параметрлері ерекше жоғары.
Dialogue: 1,0:07:07.32,0:07:10.59,JP-ja,NTP,0,0,0,,Сабер қабілет құндылықтарымен ерекшеленді.
Dialogue: 4,0:07:11.16,0:07:15.41,Default,,0,0,0,,Олардың көпшілігі А дәрежелі сияқты.
Dialogue: 1,0:07:11.28,0:07:15.18,JP-ja,NTP,0,0,0,,Параметрлердің көпшілігі A дәрежесіне эквивалентті болып көрінеді.
Dialogue: 4,0:07:16.08,0:07:17.16,Default,,0,0,0,,Б... бір сызық
Dialogue: 1,0:07:16.23,0:07:17.09,JP-ja,NTP,0,0,0,,Мен көремін.
Dialogue: 4,0:07:17.54,0:07:20.08,Default,,0,0,0,,Ол ең күшті Қызметші класы.
Dialogue: 1,0:07:17.75,0:07:19.98,JP-ja,NTP,0,0,0,,Күтілгендей, бұл ең күшті сынып.
Dialogue: 4,0:07:20.71,0:07:23.50,Default,,0,0,0,,Сабер Лансерге қарағанда үлкен қауіп сияқты.
Dialogue: 1,0:07:20.77,0:07:23.46,JP-ja,NTP,0,0,0,,Сабер Лансерге қарағанда қиынырақ көрінеді.
Dialogue: 4,0:07:25.04,0:07:27.17,Default,,0,0,0,,Сіз шеберді де көре аласыз ба?
Dialogue: 1,0:07:25.18,0:07:26.69,JP-ja,NTP,0,0,0,,Мастер көрінеді ме?
Dialogue: 4,0:07:27.55,0:07:32.89,Default,,0,0,0,,Қызметшілерден басқа жасырын емес бір ғана адам бар.
Dialogue: 1,0:07:27.62,0:07:32.98,JP-ja,NTP,0,0,0,,Сырт келбетін ашық айтатын қызметшіден басқа біреу ғана.
Dialogue: 4,0:07:33.34,0:07:35.85,Default,,0,0,0,,Ол Сабердің артында тұр.
Dialogue: 1,0:07:33.48,0:07:35.70,JP-ja,NTP,0,0,0,,Сабердің артында тұру
Dialogue: 4,0:07:36.60,0:07:38.43,Default,,0,0,0,,Күміс шашы бар әйел.
Dialogue: 1,0:07:36.65,0:07:38.15,JP-ja,NTP,0,0,0,,Мен күміс шашты әйелмін.
Dialogue: 4,0:07:39.35,0:07:44.23,Default,,0,0,0,,Бұл Лансердің Мастерінде жасырын қалу үшін даналықтың бар екенін білдіреді.
Dialogue: 1,0:07:39.46,0:07:44.15,JP-ja,NTP,0,0,0,,Сонда Лансердің қожайынының жасыратын даналығы бар.
Dialogue: 4,0:07:44.73,0:07:46.36,Default,,0,0,0,,Ол жаңадан емес.
Dialogue: 1,0:07:44.89,0:07:46.29,JP-ja,NTP,0,0,0,,Мен әуесқой емеспін.
Dialogue: 4,0:07:46.77,0:07:50.19,Default,,0,0,0,,Қасиетті Граил соғысының ережелерін түсінеді.
Dialogue: 1,0:07:46.89,0:07:49.94,JP-ja,NTP,0,0,0,,Мен осы Қасиетті Граил соғысының алтын ережелерін түсінемін.
Dialogue: 4,0:07:51.57,0:07:53.95,Default,,0,0,0,,Күте тұрыңыз, күміс шашты әйел?
Dialogue: 1,0:07:51.69,0:07:53.80,JP-ja,NTP,0,0,0,,Күте тұрыңыз, бұл күміс шашты әйел.
Dialogue: 4,0:07:53.95,0:07:56.16,Default,,0,0,0,,Иә. кавказ.
Dialogue: 1,0:07:54.72,0:07:56.08,JP-ja,NTP,0,0,0,,Иә, мен ақ түсті әйелмін.
Dialogue: 4,0:07:58.66,0:08:00.96,Default,,0,0,0,,Күміс шаш, қызыл көз.
Dialogue: 1,0:07:58.83,0:08:00.93,JP-ja,NTP,0,0,0,,Күміс шаш және қызыл көз
Dialogue: 4,0:08:02.92,0:08:06.34,Default,,0,0,0,,Ол адамға ұқсамайды.
Dialogue: 1,0:08:03.01,0:08:06.42,JP-ja,NTP,0,0,0,,Бұл адамгершілікке жатпайтын сияқты.
Dialogue: 4,0:08:07.80,0:08:10.17,Default,,0,0,0,,Эйнцберн гомункуласы?
Dialogue: 1,0:08:07.91,0:08:10.17,JP-ja,NTP,0,0,0,,Эйнцберн гомункуласы?
Dialogue: 4,0:08:10.71,0:08:13.63,Default,,0,0,0,,Осылайша олар тағы бір жасанды Ұстазды жасады.
Dialogue: 1,0:08:10.81,0:08:13.77,JP-ja,NTP,0,0,0,,Сіз басқа қуыршақ шеберін құйдыңыз ба?
Dialogue: 4,0:08:14.47,0:08:19.93,Default,,0,0,0,,Мен Эмиия Кирицугу Джубстахейттің бізге дайындаған жалғыз пешканы деп ойладым.
Dialogue: 1,0:08:14.57,0:08:19.40,JP-ja,NTP,0,0,0,,Мен әрқашан Джубустахейт дайындаған шығарманы Кирицугу Эмия деп ойлайтынмын.
Dialogue: 4,0:08:19.93,0:08:22.14,Default,,0,0,0,,Мен қателескен сияқтымын.
Dialogue: 1,0:08:20.06,0:08:22.36,JP-ja,NTP,0,0,0,,Менің күткендерім дұрыс емес болады деп ешқашан күткен жоқпын.
Dialogue: 4,0:08:23.35,0:08:27.82,Default,,0,0,0,,Бұл әйел Эйнцберннің шебері, сонда?
Dialogue: 1,0:08:23.46,0:08:27.44,JP-ja,NTP,0,0,0,,Сонда бұл әйел Эйнцберннің қожайыны ма?
Dialogue: 4,0:08:28.90,0:08:34.36,Default,,0,0,0,,Қалай болғанда да, ол Грейл соғысының нәтижесіне қатты әсер етеді.
Dialogue: 1,0:08:29.02,0:08:33.81,JP-ja,NTP,0,0,0,,Қалай болғанда да, бұл әйел Қасиетті Граил соғысының үрдісін бақылаудың маңызды кілті болып табылады.
Dialogue: 4,0:08:34.36,0:08:36.87,Default,,0,0,0,,Кирей, оған көз сал.
Dialogue: 1,0:08:34.51,0:08:36.79,JP-ja,NTP,0,0,0,,Кирей, ешқашан менен көзіңді алма
Dialogue: 4,0:08:37.83,0:08:39.33,Default,,0,0,0,,Бір қолымда оқпен зарядталған винтовка
Dialogue: 1,0:08:37.97,0:08:39.53,JP-ja,NTP,0,0,0,,Түсінікті
Dialogue: 4,0:08:39.70,0:08:43.46,Default,,0,0,0,,Мен оның біреуін әрқашанда ұстаймын.
Dialogue: 1,0:08:39.89,0:08:43.09,JP-ja,NTP,0,0,0,,Сондықтан біз бір адамды әрқашан қосулы ұстаймыз.
Dialogue: 4,0:08:45.96,0:08:48.00,Default,,0,0,0,,Мен оны көріп тұрмын.
Dialogue: 1,0:08:46.25,0:08:47.86,JP-ja,NTP,0,0,0,,Сондай-ақ байқалады
Dialogue: 4,0:08:48.00,0:08:51.30,Default,,0,0,0,,Бірақ Ассасин өлген болуы керек емес пе?
Dialogue: 1,0:08:48.18,0:08:51.02,JP-ja,NTP,0,0,0,,Бірақ өлді деп есептелген Ассасин қалай болды?
Dialogue: 4,0:08:51.92,0:08:53.72,Default,,0,0,0,,Мен бірдеңе дұрыс емес екенін білдім.
Dialogue: 1,0:08:52.03,0:08:53.52,JP-ja,NTP,0,0,0,,Ақыр соңында, бұл жерде жасырын ниет болды.
Dialogue: 4,0:08:57.18,0:08:59.39,Default,,0,0,0,,Енді бұл қалай болатынын көрейік.
Dialogue: 1,0:08:57.37,0:08:59.13,JP-ja,NTP,0,0,0,,Күтіп, не болатынын көрейік.
Dialogue: 4,0:08:59.85,0:09:02.52,Default,,0,0,0,,Ассасинді бақылауды жалғастырыңыз.
Dialogue: 1,0:08:59.98,0:09:02.01,JP-ja,NTP,0,0,0,,Ассасинді бақылауды жалғастырыңыз.
Dialogue: 4,0:09:02.52,0:09:03.98,Default,,0,0,0,,Мен Лэнсерді көремін.
Dialogue: 1,0:09:02.58,0:09:04.24,JP-ja,NTP,0,0,0,,Мен Лэнсерді бақылаймын.
Dialogue: 4,0:09:04.64,0:09:11.53,Default,,0,0,0,,Мен Ассасинге шабуыл жасап, оның назарын аударамын, осылайша сіз Лансердің шеберін жою мүмкіндігін пайдалана аласыз.
Dialogue: 1,0:09:04.78,0:09:09.67,JP-ja,NTP,0,0,0,,Мен Ассасинге оның назарын аудару үшін шабуыл жасап жатқанымдай.
Dialogue: 1,0:09:10.21,0:09:11.45,JP-ja,NTP,0,0,0,,Лансер шебері
Dialogue: 4,0:09:11.53,0:09:12.82,Default,,0,0,0,,Жоқ, Майя.
Dialogue: 1,0:09:11.70,0:09:12.66,JP-ja,NTP,0,0,0,,Жоқ, Майя
Dialogue: 4,0:09:13.65,0:09:16.86,Default,,0,0,0,,Біз жұмыс істеп жатқан Assassin болғанда емес.
Dialogue: 1,0:09:13.76,0:09:16.58,JP-ja,NTP,0,0,0,,Мәселе мынада, ол жерде ассасиндер тұрған.
Dialogue: 4,0:09:17.66,0:09:21.58,Default,,0,0,0,,Біз қазір қызметшілермен күресуге дайын емеспіз.
Dialogue: 1,0:09:17.82,0:09:21.28,JP-ja,NTP,0,0,0,,Қазіргі уақытта біз Қызметшілерге қарсы шайқасқа дайын емеспіз.
Dialogue: 4,0:09:23.75,0:09:24.83,Default,,0,0,0,,Бір қолымда оқпен зарядталған винтовка
Dialogue: 1,0:09:23.86,0:09:24.80,JP-ja,NTP,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 4,0:09:35.67,0:09:39.64,Default,,0,0,0,,Аты-жөнін алмастырмай шайқаста абырой болмаса да,
Dialogue: 1,0:09:35.72,0:09:39.91,JP-ja,NTP,0,0,0,,Аты-жөніңді айтпай жекпе-жекке намыс та, боқ та жоқ.
Dialogue: 4,0:09:40.60,0:09:42.97,Default,,0,0,0,,сәлемімді білдіруге рұқсат етіңіз.
Dialogue: 1,0:09:40.70,0:09:42.36,JP-ja,NTP,0,0,0,,Мақтауды бәрібір қабыл алыңыз
Dialogue: 4,0:09:42.97,0:09:47.52,Default,,0,0,0,,Әйелдің осыншама тер төкпей күресуі әсерлі.
Dialogue: 1,0:09:43.07,0:09:45.12,JP-ja,NTP,0,0,0,,Бұл кезде мен тіпті терлеген жоқпын.
Dialogue: 1,0:09:45.43,0:09:47.27,JP-ja,NTP,0,0,0,,Ол маған әйел адамша қарады.
Dialogue: 4,0:09:47.52,0:09:50.06,Default,,0,0,0,,Сізге соншалықты кішіпейіл болудың қажеті жоқ, Лансер.
Dialogue: 1,0:09:47.89,0:09:50.20,JP-ja,NTP,0,0,0,,Бұл қажетсіз кішіпейілділік, Лансер.
Dialogue: 4,0:09:50.56,0:09:57.15,Default,,0,0,0,,Есіміңді білмесем де, Найзаның осындай шеберінің сөзі маған құрмет көрсетеді.
Dialogue: 1,0:09:50.72,0:09:52.53,JP-ja,NTP,0,0,0,,Мен сенің атыңды білмесем де
Dialogue: 1,0:09:52.78,0:09:55.04,JP-ja,NTP,0,0,0,,Найзаның ұшымен мақтауы
Dialogue: 1,0:09:55.43,0:09:56.67,JP-ja,NTP,0,0,0,,Бұл мен үшін құрмет
Dialogue: 4,0:09:57.15,0:09:58.70,Default,,0,0,0,,Мен оларды ризашылықпен қабылдаймын.
Dialogue: 1,0:09:57.28,0:09:58.80,JP-ja,NTP,0,0,0,,Шүкіршілік етейік.
Dialogue: 4,0:09:59.11,0:10:02.12,Default,,0,0,0,,Бұл жеткілікті қызық, Лансер.
Dialogue: 1,0:09:59.33,0:10:01.95,JP-ja,NTP,0,0,0,,Мұның бәрі көңіл көтеру үшін, Лансер.
Dialogue: 4,0:10:03.66,0:10:05.79,Default,,0,0,0,,Лансердің шебері?
Dialogue: 1,0:10:03.76,0:10:05.73,JP-ja,NTP,0,0,0,,Лансер Мастер
Dialogue: 4,0:10:05.79,0:10:09.12,Default,,0,0,0,,Бұл шайқастың созылуына жол бермеңіз.
Dialogue: 1,0:10:06.21,0:10:09.06,JP-ja,NTP,0,0,0,,Ұрысты бұдан былай созбаңыз.
Dialogue: 4,0:10:09.12,0:10:11.54,Default,,0,0,0,,Сабер - күшті қарсылас.
Dialogue: 1,0:10:09.25,0:10:13.77,JP-ja,NTP,0,0,0,,Сабер қиын жау бар, оны тез шығар.
Dialogue: 4,0:10:11.54,0:10:13.42,Default,,0,0,0,,Оны барлық асығыспен жеңіңіз.
Dialogue: 4,0:10:14.00,0:10:16.42,Default,,0,0,0,,Сіз асыл фантасманы пайдалана аласыз.
Dialogue: 1,0:10:14.10,0:10:16.28,JP-ja,NTP,0,0,0,,Асыл фантасманы ашуға мүмкіндік береді
Dialogue: 4,0:10:19.80,0:10:22.89,Default,,0,0,0,,Түсіндім, тақсыр.
Dialogue: 1,0:10:20.01,0:10:22.92,JP-ja,NTP,0,0,0,,Түсіндім, тақсыр.
Dialogue: 4,0:10:28.64,0:10:31.90,Default,,0,0,0,,Сонымен ұзын найза оның Асыл фантасмасы.
Dialogue: 1,0:10:28.95,0:10:31.81,JP-ja,NTP,0,0,0,,Бұл ұзын найза - Лансердің асыл фантасмасы.
Dialogue: 4,0:10:39.61,0:10:41.24,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 1,0:10:39.62,0:10:40.84,JP-ja,NTP,0,0,0,,Сондықтан
Dialogue: 4,0:10:41.24,0:10:44.12,Default,,0,0,0,,Мен қазір өлтіруге барамын.
Dialogue: 1,0:10:41.34,0:10:44.00,JP-ja,NTP,0,0,0,,Осыдан кейін мен сені өлтіруге рұқсат етемін.
Dialogue: 4,0:10:44.66,0:10:50.75,Default,,0,0,0,,Сабер, сіз әлі де желмен жүзіңізді жасыру үшін мананы қолданасыз ба?
Dialogue: 1,0:10:44.78,0:10:50.48,JP-ja,NTP,0,0,0,,Сабер Желдің сиқырлы күшімен қылышыңды жасырып жүрсің бе?
Dialogue: 4,0:10:52.58,0:10:53.88,Default,,0,0,0,,Б... бір сызық
Dialogue: 1,0:10:52.66,0:10:53.22,JP-ja,NTP,0,0,0,,Мен көремін.
Dialogue: 4,0:10:54.25,0:10:59.13,Default,,0,0,0,,Ендеше, қылышыңды жасыруға себеп бар.
Dialogue: 1,0:10:54.29,0:10:58.92,JP-ja,NTP,0,0,0,,Бұл қылышты жасыруға себеп бар дегенді білдіре ме?
Dialogue: 4,0:11:00.09,0:11:03.22,Default,,0,0,0,,Менің болжауымша, қылыш сенің шын есіміңді көрсетеді.
Dialogue: 1,0:11:00.13,0:11:01.31,JP-ja,NTP,0,0,0,,Сіздің шын есіміңіз
Dialogue: 1,0:11:01.43,0:11:03.12,JP-ja,NTP,0,0,0,,Мен оны сол қылыштан көрдім.
Dialogue: 4,0:11:03.22,0:11:05.39,Default,,0,0,0,,Қандай өкінішті, Лансер.
Dialogue: 1,0:11:03.65,0:11:05.37,JP-ja,NTP,0,0,0,,Бұл ұят, Лансер.
Dialogue: 4,0:11:06.14,0:11:09.06,Default,,0,0,0,,Сіз менің жүзімнің атын ешқашан білмейсіз.
Dialogue: 1,0:11:06.18,0:11:08.92,JP-ja,NTP,0,0,0,,Менің асыл семсерімнің кім екенін ешқашан біле алмайсың.
Dialogue: 4,0:11:10.23,0:11:13.06,Default,,0,0,0,,Мен мұны оған дейін аяқтаймын.
Dialogue: 1,0:11:10.31,0:11:12.85,JP-ja,NTP,0,0,0,,Оған дейін нәтижені шешіп, көрсетіңіз.
Dialogue: 4,0:11:13.69,0:11:15.40,Default,,0,0,0,,Біз бұл туралы көреміз.
Dialogue: 1,0:11:13.89,0:11:15.36,JP-ja,NTP,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 1,0:11:16.19,0:11:18.32,JP-ja,NTP,0,0,0,,Көрінбейтін қылышты ашып көрейін
Dialogue: 4,0:11:16.19,0:11:19.53,Default,,0,0,0,,Мен сенің көзге көрінбейтін қылышыңды ашамын, Сабер.
Dialogue: 1,0:11:18.61,0:11:19.21,JP-ja,NTP,0,0,0,,Сабер
Dialogue: 4,0:11:27.41,0:11:30.71,Default,,0,0,0,,Қадірлі қылышыңыз әшкере болды.
Dialogue: 1,0:11:27.49,0:11:30.34,JP-ja,NTP,0,0,0,,Сіз асыл қылышыңызды аштыңыз.
Dialogue: 4,0:11:30.71,0:11:33.08,Default,,0,0,0,,Көрінбейтін ауа жойылды ма?!
Dialogue: 1,0:11:31.08,0:11:33.13,JP-ja,NTP,0,0,0,,Жел патшасының тосқауылы тозған.
Dialogue: 4,0:11:55.27,0:11:57.11,Default,,0,0,0,,Не болып жатыр?
Dialogue: 1,0:11:55.38,0:11:56.98,JP-ja,NTP,0,0,0,,Не болып жатыр?
Dialogue: 4,0:12:12.25,0:12:16.50,Default,,0,0,0,,Мынау қызыл найза Көзге көрінбейтін ауаны жарып барады!
Dialogue: 1,0:12:12.40,0:12:13.59,JP-ja,NTP,0,0,0,,Мына қызыл найза
Dialogue: 1,0:12:14.38,0:12:16.46,JP-ja,NTP,0,0,0,,Жел патшасының тосқауылын кесу
Dialogue: 4,0:12:17.09,0:12:19.25,Default,,0,0,0,,Мен пышағыңның нақты ұзындығын енді білемін.
Dialogue: 1,0:12:17.14,0:12:19.10,JP-ja,NTP,0,0,0,,Мен пышақтың ұзындығын анық көрдім.
Dialogue: 4,0:12:19.92,0:12:23.01,Default,,0,0,0,,Енді мен қашықтығыма қате баға бермеймін!
Dialogue: 1,0:12:19.99,0:12:22.64,JP-ja,NTP,0,0,0,,Енді көзге көрінбейтін қашықтық сізді шатастырмайды.
Dialogue: 4,0:12:28.89,0:12:33.02,Default,,0,0,0,,Менде бұл найзаға қарсы тұрудың әлі де жолы бар.
Dialogue: 1,0:12:29.04,0:12:30.90,JP-ja,NTP,0,0,0,,Бірақ бұл найзаның желісі болса
Dialogue: 1,0:12:31.77,0:12:33.13,JP-ja,NTP,0,0,0,,Мен әлі де жауап бере аламын.
Dialogue: 4,0:12:39.44,0:12:40.98,Default,,0,0,0,,Мен жай ғана артықшылықты пайдалана алсам...
Dialogue: 1,0:12:39.60,0:12:40.98,JP-ja,NTP,0,0,0,,Тәтті соққы
Dialogue: 4,0:12:45.45,0:12:46.91,Default,,0,0,0,,...қылқаламмен шабуыл...
Dialogue: 1,0:12:45.50,0:12:46.78,JP-ja,NTP,0,0,0,,Оны жіберіп алмаңыз
Dialogue: 1,0:13:21.11,0:13:21.85,JP-ja,NTP,0,0,0,,Сабер
Dialogue: 4,0:13:21.11,0:13:21.98,Default,,0,0,0,,Сабер!
Dialogue: 4,0:13:27.32,0:13:29.12,Default,,0,0,0,,Рахмет, Ирисвиэль.
Dialogue: 1,0:13:27.41,0:13:29.11,JP-ja,NTP,0,0,0,,Рахмет сізге Ирисвиел
Dialogue: 4,0:13:29.62,0:13:32.24,Default,,0,0,0,,Менде бәрі жақсы. Емдеу тиімді болды.
Dialogue: 1,0:13:29.66,0:13:32.36,JP-ja,NTP,0,0,0,,Ештеңе етпейді, емдеу жұмыс істейді.
Dialogue: 4,0:13:34.37,0:13:38.17,Default,,0,0,0,,Олай болса, менің оңай жеңіске жетуіме жол бермейсің.
Dialogue: 1,0:13:34.40,0:13:37.85,JP-ja,NTP,0,0,0,,Оңай жеңіп шығуыма жол бермейсің бе?
Dialogue: 4,0:13:38.54,0:13:39.67,Default,,0,0,0,,Бірақ неге?
Dialogue: 1,0:13:38.64,0:13:39.50,JP-ja,NTP,0,0,0,,Бірақ неге?
Dialogue: 4,0:13:40.04,0:13:43.26,Default,,0,0,0,,Менің қару-жарақтарым бұл соққыны оңай айналып өтуі керек еді.
Dialogue: 1,0:13:40.14,0:13:43.16,JP-ja,NTP,0,0,0,,Бұл соққы броньмен жеткілікті түрде жабылуы керек еді.
Dialogue: 4,0:13:44.51,0:13:46.88,Default,,0,0,0,,Сонда бұл жүз қалай болды...
Dialogue: 1,0:13:44.61,0:13:46.83,JP-ja,NTP,0,0,0,,Бірақ найзаның жүзі неге
Dialogue: 4,0:13:52.89,0:13:54.47,Default,,0,0,0,,Құрыштың өзі тесілмеген.
Dialogue: 1,0:13:53.06,0:13:54.50,JP-ja,NTP,0,0,0,,Құрышта сызаттар жоқ
Dialogue: 4,0:13:55.39,0:13:56.85,Default,,0,0,0,,Егер ол осыған байланысты өзіне қол жұмсап көрсе, онда оны ешкім жеңе алмас еді ғой?
Dialogue: 1,0:13:55.46,0:13:56.67,JP-ja,NTP,0,0,0,,Сіз нені айтасыз?
Dialogue: 4,0:13:59.98,0:14:04.28,Default,,0,0,0,,Жалғыз түсініктеме - Лансердің жүзі менің сиқырлы тоқылған сауытымның арасынан өтті.
Dialogue: 1,0:14:00.20,0:14:01.51,JP-ja,NTP,0,0,0,,Лансердің найзасы
Dialogue: 1,0:14:01.74,0:14:04.23,JP-ja,NTP,0,0,0,,Сиқырлы күшпен тоқылған сауыт арқылы өткен сияқты.
Dialogue: 4,0:14:05.49,0:14:06.90,Default,,0,0,0,,Сонымен.
Dialogue: 1,0:14:05.68,0:14:09.78,JP-ja,NTP,0,0,0,,Қарасам, сол найзаның сыры ашылды, Лансер.
Dialogue: 4,0:14:06.90,0:14:09.95,Default,,0,0,0,,Найзаңның сырын көремін, Лансер.
Dialogue: 4,0:14:11.37,0:14:14.75,Default,,0,0,0,,Мына қызыл найза мананы жоққа шығарады.
Dialogue: 1,0:14:11.77,0:14:14.51,JP-ja,NTP,0,0,0,,Сол қызыл найза сиқырды кесіп тастайды.
Dialogue: 4,0:14:16.04,0:14:19.00,Default,,0,0,0,,Сіздің сауытыңыз мана арқылы жасалған.
Dialogue: 1,0:14:16.18,0:14:18.81,JP-ja,NTP,0,0,0,,Бұл сауыт сиқырлы күшпен жасалған.
Dialogue: 4,0:14:19.50,0:14:24.38,Default,,0,0,0,,Егер сенетін болсаң, берілу керек, Сабер.
Dialogue: 1,0:14:19.55,0:14:21.47,JP-ja,NTP,0,0,0,,Егер сіз бұған сенетін болсаңыз
Dialogue: 1,0:14:21.89,0:14:24.55,JP-ja,NTP,0,0,0,,Бер, Сабер.
Dialogue: 4,0:14:25.17,0:14:27.97,Default,,0,0,0,,Сен менің найзамның алдында жалаңашсың.
Dialogue: 1,0:14:25.21,0:14:27.78,JP-ja,NTP,0,0,0,,Сен менің найзамның алдында жалаңашсың.
Dialogue: 4,0:14:29.09,0:14:34.10,Default,,0,0,0,,Мені сауыт-сайманымнан айыру арқылы жеңдім деп ойлама.
Dialogue: 1,0:14:29.17,0:14:31.14,JP-ja,NTP,0,0,0,,Ең көбі сауыт шешілді.
Dialogue: 1,0:14:32.00,0:14:33.87,JP-ja,NTP,0,0,0,,Адамдарды бір нәрседе жақсы болуға баулу қиын.
Dialogue: 4,0:14:40.69,0:14:45.23,Default,,0,0,0,,Егер мен сенің жүзіңнен қорғана алмасам, алдымен сені кесіп тастауым керек.
Dialogue: 1,0:14:40.74,0:14:45.14,JP-ja,NTP,0,0,0,,Егер ол бөгелмейтін найза болса, оны бөгеуден бұрын кесіп алу керек.
Dialogue: 4,0:14:46.90,0:14:49.07,Default,,0,0,0,,Дайында, Лансер!
Dialogue: 1,0:14:46.94,0:14:48.93,JP-ja,NTP,0,0,0,,Лансер дайын болыңыз
Dialogue: 4,0:14:50.32,0:14:52.20,Default,,0,0,0,,Сонымен, сіз бәріңізге барасыз.
Dialogue: 1,0:14:50.41,0:14:51.87,JP-ja,NTP,0,0,0,,Бұл өте ауыр.
Dialogue: 4,0:14:52.74,0:14:55.83,Default,,0,0,0,,Сіз бәрін бір соққыға тігесіз.
Dialogue: 1,0:14:52.89,0:14:55.45,JP-ja,NTP,0,0,0,,Кенкон Хитотака
Dialogue: 4,0:14:56.70,0:15:02.50,Default,,0,0,0,,Сіз құрыштың кемшіліктерін одан бас тарту арқылы алынған артықшылықтарға айналдырып жатырсыз.
Dialogue: 1,0:14:56.80,0:14:58.81,JP-ja,NTP,0,0,0,,Құрышты алып тастаудың кемшілігі
Dialogue: 1,0:14:59.53,0:15:02.25,JP-ja,NTP,0,0,0,,Құрыштарды тастаудың артықшылығы жоққа шығарылды
Dialogue: 4,0:15:03.21,0:15:06.63,Default,,0,0,0,,Қандай батылдық. Қандай батыл шешім.
Dialogue: 1,0:15:03.38,0:15:06.31,JP-ja,NTP,0,0,0,,Оның батылдығы мен асыл шешімі
Dialogue: 4,0:15:07.80,0:15:10.22,Default,,0,0,0,,Маған ұнайды.
Dialogue: 1,0:15:07.95,0:15:10.14,JP-ja,NTP,0,0,0,,Маған мүлдем ұнамайды.
Dialogue: 4,0:15:12.01,0:15:17.85,Default,,0,0,0,,Бірақ бұл жағдайда бұл ақымақ қателік, Сабер.
Dialogue: 1,0:15:12.49,0:15:14.48,JP-ja,NTP,0,0,0,,Осы жерде айта кетсем,
Dialogue: 1,0:15:15.11,0:15:17.98,JP-ja,NTP,0,0,0,,Бұл қате болды, Сабер.
Dialogue: 4,0:15:18.81,0:15:20.48,Default,,0,0,0,,Біз көреміз.
Dialogue: 1,0:15:19.01,0:15:20.18,JP-ja,NTP,0,0,0,,Ал, сіз қалай ойлайсыз?
Dialogue: 4,0:15:21.56,0:15:25.65,Default,,0,0,0,,Менің келесі шабуылымнан кейін демонстрацияны жалғастыра аласыз.
Dialogue: 1,0:15:21.72,0:15:25.20,JP-ja,NTP,0,0,0,,Келесі сөгіс алғанша күте аласыз ба?
Dialogue: 4,0:15:41.67,0:15:43.92,Default,,0,0,0,,Мен сізге айтып тұрмын, бұл қате.
Dialogue: 1,0:15:41.83,0:15:43.75,JP-ja,NTP,0,0,0,,Бұл қате болды.
Dialogue: 4,0:15:49.26,0:15:51.76,Default,,0,0,0,,Қызметшілерде бірнеше асыл фантастика болуы мүмкін...
Dialogue: 1,0:15:49.28,0:15:51.84,JP-ja,NTP,0,0,0,,Noble Phantasm ешқашан бірегей емес
Dialogue: 4,0:15:53.01,0:15:53.93,Default,,0,0,0,,Тұзақ па?!
Dialogue: 1,0:15:53.16,0:15:53.87,JP-ja,NTP,0,0,0,,Бұл тұзақ па?
Dialogue: 4,0:16:05.94,0:16:08.44,Default,,0,0,0,,Бұл жаман. Өте нашар.
Dialogue: 1,0:16:06.10,0:16:08.72,JP-ja,NTP,0,0,0,,Жоқ, бұл жақсы емес
Dialogue: 4,0:16:08.82,0:16:11.11,Default,,0,0,0,,Бұл не?
Dialogue: 1,0:16:08.96,0:16:10.55,JP-ja,NTP,0,0,0,,Бұл не?
Dialogue: 4,0:16:11.11,0:16:14.70,Default,,0,0,0,,Лансер соңғы қимылын жасады.
Dialogue: 1,0:16:11.18,0:16:12.59,JP-ja,NTP,0,0,0,,Лансер жігіт
Dialogue: 1,0:16:12.77,0:16:14.59,JP-ja,NTP,0,0,0,,шешуші тактикаға жүгінді
Dialogue: 4,0:16:14.70,0:16:16.99,Default,,0,0,0,,Ол ұрысты дәл сол жерде аяқтағысы келеді.
Dialogue: 1,0:16:14.96,0:16:16.87,JP-ja,NTP,0,0,0,,Мен шайқасты тез шешуге ниеттімін.
Dialogue: 4,0:16:17.37,0:16:19.70,Default,,0,0,0,,Бұл бізге жақсырақ емес пе?
Dialogue: 1,0:16:17.47,0:16:19.86,JP-ja,NTP,0,0,0,,Жоқ, бұл ыңғайлы.
Dialogue: 4,0:16:21.46,0:16:24.29,Default,,0,0,0,,Ақымақ! Сен не туралы айтып тұрсың?
Dialogue: 1,0:16:21.62,0:16:24.00,JP-ja,NTP,0,0,0,,Не дейсің, ақымақ?
Dialogue: 4,0:16:25.25,0:16:29.59,Default,,0,0,0,,Мен тағы бірнеше Мастер келгенше қарап тұрғым келді,
Dialogue: 1,0:16:25.33,0:16:29.33,JP-ja,NTP,0,0,0,,Мен тағы бірнеше адам келгенше жағдайдың қалай болғанын көргім келді.
Dialogue: 4,0:16:29.59,0:16:32.42,Default,,0,0,0,,бірақ Сабер осылайша жеңілуі мүмкін.
Dialogue: 1,0:16:29.68,0:16:32.42,JP-ja,NTP,0,0,0,,Бұлай жалғаса берсе, Сабер құлап кетуі мүмкін.
Dialogue: 4,0:16:33.26,0:16:35.14,Default,,0,0,0,,Сонда бәрі кеш болады.
Dialogue: 1,0:16:33.32,0:16:34.91,JP-ja,NTP,0,0,0,,Бұл орын алған соң, бәрі кеш болады
Dialogue: 4,0:16:36.09,0:16:38.43,Default,,0,0,0,,Т-Тым кеш пе?
Dialogue: 1,0:16:36.15,0:16:38.73,JP-ja,NTP,0,0,0,,Ой, кеш болды.
Dialogue: 4,0:16:39.10,0:16:43.31,Default,,0,0,0,,Бірін-бірі нокаутқа түсіргеннен кейін шабуыл жасау жоспары емес пе еді?
Dialogue: 1,0:16:39.18,0:16:43.10,JP-ja,NTP,0,0,0,,Менің ойымша, бұл жоспар олардың шабуыл жасамас бұрын бір-бірін жаншып кетуін күту болды.
Dialogue: 4,0:16:44.31,0:16:50.90,Default,,0,0,0,,Лансердің шақыруына басқа қызметшілер жауап береді деп үміттенгенім рас.
Dialogue: 1,0:16:44.41,0:16:48.13,JP-ja,NTP,0,0,0,,Лансердің арандатуын басқа қызметшілер пайдаланғаны рас.
Dialogue: 1,0:16:48.18,0:16:50.85,JP-ja,NTP,0,0,0,,Мен ол көрінбейді деп үміттендім.
Dialogue: 4,0:16:50.90,0:16:52.28,Default,,0,0,0,,Бұл анық емес пе?
Dialogue: 1,0:16:50.97,0:16:51.82,JP-ja,NTP,0,0,0,,Әрине
Dialogue: 4,0:16:52.90,0:16:58.45,Default,,0,0,0,,Оларды бір-бірден тауып алғанша, олармен бірден күресу жылдамырақ болар еді.
Dialogue: 1,0:16:53.03,0:16:54.65,JP-ja,NTP,0,0,0,,Бірінен соң бірін іздеуден гөрі
Dialogue: 1,0:16:54.99,0:16:58.07,JP-ja,NTP,0,0,0,,Олардың барлығымен бірден күресу тезірек емес пе?
Dialogue: 4,0:16:59.24,0:17:01.70,Default,,0,0,0,,Барлығы бірден?
Dialogue: 1,0:16:59.34,0:17:01.68,JP-ja,NTP,0,0,0,,Бірлескен қарсыластар
Dialogue: 4,0:17:02.16,0:17:03.58,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 1,0:17:02.23,0:17:03.25,JP-ja,NTP,0,0,0,,Ойтомо
Dialogue: 4,0:17:03.58,0:17:09.13,Default,,0,0,0,,Басқа жастағы кейіпкерлермен соққы алмасу мүмкіндігі сирек болады.
Dialogue: 1,0:17:03.68,0:17:08.77,JP-ja,NTP,0,0,0,,Әр дәуірдің батырларымен, батырларымен жол қиылысу мүмкіндігі сирек.
Dialogue: 4,0:17:09.13,0:17:14.34,Default,,0,0,0,,Егер олардың алтауы бір жерге жиналса, мен олардың барлығымен күресетін едім.
Dialogue: 1,0:17:09.26,0:17:11.81,JP-ja,NTP,0,0,0,,Олардың алтауы болса,
Dialogue: 1,0:17:12.05,0:17:14.20,JP-ja,NTP,0,0,0,,Бір адам болса да қашып кетуіне жол жоқ.
Dialogue: 4,0:17:14.76,0:17:17.22,Default,,0,0,0,,Сабер мен Лансерге қараңыз.
Dialogue: 1,0:17:14.90,0:17:16.79,JP-ja,NTP,0,0,0,,Қазіргі уақытта Сабер және Лансер
Dialogue: 4,0:17:17.22,0:17:22.68,Default,,0,0,0,,Екеуі де мен жекпе-жек өткізгім келетін ержүрек жауынгерлер.
Dialogue: 1,0:17:17.38,0:17:18.88,JP-ja,NTP,0,0,0,,Осы екеуінен кейін
Dialogue: 1,0:17:19.13,0:17:22.31,JP-ja,NTP,0,0,0,,Екеуі де жүректі жылытатын Масуара жігіттері.
Dialogue: 4,0:17:22.68,0:17:24.85,Default,,0,0,0,,Екеуі де өлсе өкінішті.
Dialogue: 1,0:17:22.80,0:17:24.78,JP-ja,NTP,0,0,0,,Өлу өте жаман
Dialogue: 1,0:17:25.74,0:17:27.47,JP-ja,NTP,0,0,0,,Өлмей не істеуім керек?
Dialogue: 4,0:17:25.77,0:17:27.56,Default,,0,0,0,,Бірақ мәселе осы емес пе?!
Dialogue: 4,0:17:27.56,0:17:31.07,Default,,0,0,0,,Қасиетті Граил соғысында бір-біріңді өлтірулерің керек!
Dialogue: 1,0:17:27.89,0:17:30.73,JP-ja,NTP,0,0,0,,Қасиетті Граил соғысы бір-бірін өлтіруге арналған.
Dialogue: 4,0:17:34.95,0:17:37.20,Default,,0,0,0,,Жеңіске жету, бірақ жоймау...
Dialogue: 1,0:17:34.98,0:17:39.91,JP-ja,NTP,0,0,0,,Жеңіске жеткен, бірақ жойылмаған; жеңді, бірақ қорланбады
Dialogue: 4,0:17:37.20,0:17:40.20,Default,,0,0,0,,Жеңу үшін, бірақ қорламау...
Dialogue: 4,0:17:40.20,0:17:43.16,Default,,0,0,0,,Міне нағыз бәсеке!
Dialogue: 1,0:17:40.27,0:17:42.76,JP-ja,NTP,0,0,0,,Бұл нағыз «жеңу»
Dialogue: 4,0:17:59.01,0:18:01.10,Default,,0,0,0,,Біз енді көрмейміз!
Dialogue: 1,0:17:59.04,0:18:00.53,JP-ja,NTP,0,0,0,,Көруге болатын барлық нәрсе осы.
Dialogue: 4,0:18:01.10,0:18:04.14,Default,,0,0,0,,Біз де қатысамыз, балам!
Dialogue: 1,0:18:01.15,0:18:03.84,JP-ja,NTP,0,0,0,,Біз де қатысамыз, монах.
Dialogue: 4,0:18:04.14,0:18:05.75,Default,,0,0,0,,Сен шынымен де жалықтырасың.
Dialogue: 1,0:18:04.22,0:18:05.42,JP-ja,NTP,0,0,0,,Ақымақ ақымақ ақымақ
Dialogue: 4,0:18:05.75,0:18:08.06,Default,,0,0,0,,Сенің істеп жүргенің ақылсыз!
Dialogue: 1,0:18:05.79,0:18:08.24,JP-ja,NTP,0,0,0,,Сіздің істеп жатқаныңыз күлкілі.
Dialogue: 4,0:18:08.98,0:18:12.57,Default,,0,0,0,,Мақұлдамасаңыз, осында қалып, қарауыңызға болады.
Dialogue: 1,0:18:09.05,0:18:10.33,JP-ja,NTP,0,0,0,,Егер сізге ұнамаса
Dialogue: 1,0:18:10.44,0:18:12.40,JP-ja,NTP,0,0,0,,Сіз осында қалып, қарап отырсыз ба?
Dialogue: 4,0:18:13.02,0:18:14.07,Default,,0,0,0,,Мен барамын!
Dialogue: 1,0:18:13.15,0:18:15.95,JP-ja,NTP,0,0,0,,Мен барамын, мені ал, ақымақ.
Dialogue: 4,0:18:14.07,0:18:16.11,Default,,0,0,0,,Мені ал, ақымақ!
Dialogue: 4,0:18:16.53,0:18:19.74,Default,,0,0,0,,Жақсы! Енді бұл менің ұстазым!
Dialogue: 1,0:18:16.72,0:18:19.59,JP-ja,NTP,0,0,0,,Жақсы, бұл менің қожайыным.
Dialogue: 1,0:18:29.82,0:18:31.54,JP-ja,NTP,0,0,0,,Өкінішке орай, сіңірім кесілді.
Dialogue: 4,0:18:29.83,0:18:31.71,Default,,0,0,0,,Бұл жаман. Ол сіңірді кесіп тастады.
Dialogue: 4,0:18:32.92,0:18:34.50,Default,,0,0,0,,Мен бас бармағымды қозғалта алмаймын.
Dialogue: 1,0:18:32.96,0:18:34.21,JP-ja,NTP,0,0,0,,Бас бармақ қозғалмайды
Dialogue: 4,0:18:35.42,0:18:39.22,Default,,0,0,0,,Сіз маған жеңіске жетуге мүмкіндік бермейсіз.
Dialogue: 1,0:18:35.48,0:18:38.98,JP-ja,NTP,0,0,0,,Маған оңай жеңіске жетуге мүмкіндік бере алмайсың ба?
Dialogue: 4,0:18:39.80,0:18:42.76,Default,,0,0,0,,Сонда да мен сіздің табандылығыңызға тәнтімін!
Dialogue: 1,0:18:39.84,0:18:42.46,JP-ja,NTP,0,0,0,,Бұл жақсы, бірақ қаншалықты тайсалмас
Dialogue: 1,0:18:44.85,0:18:47.38,JP-ja,NTP,0,0,0,,Нені баяу айтып тұрсың?
Dialogue: 4,0:18:44.93,0:18:48.77,Default,,0,0,0,,Не үшін сонша сөйлейсің, ақымақ?
Dialogue: 1,0:18:47.77,0:18:50.18,JP-ja,NTP,0,0,0,,Ақымақ, сен мені өлтіре алмадың.
Dialogue: 4,0:18:48.77,0:18:50.27,Default,,0,0,0,,Сіз оны жеңу мүмкіндігін жіберіп алдыңыз.
Dialogue: 1,0:18:54.41,0:18:57.16,JP-ja,NTP,0,0,0,,Ауырды, тақсыр.
Dialogue: 4,0:18:54.44,0:18:57.53,Default,,0,0,0,,Кешірім сұраймын, мырзам.
Dialogue: 4,0:18:57.94,0:18:58.99,Default,,0,0,0,,Ирисвиэль.
Dialogue: 1,0:18:57.95,0:19:01.37,JP-ja,NTP,0,0,0,,Ирисвиэль, мені де емде.
Dialogue: 4,0:18:59.86,0:19:00.86,Default,,0,0,0,,Мені де емдеңіз.
Dialogue: 4,0:19:01.74,0:19:02.78,Default,,0,0,0,,Бірақ менде...
Dialogue: 1,0:19:01.76,0:19:06.10,JP-ja,NTP,0,0,0,,Мен сені шақырдым, солай атадым.
Dialogue: 4,0:19:03.37,0:19:06.12,Default,,0,0,0,,Менде бар, бірақ...
Dialogue: 1,0:19:07.12,0:19:09.78,JP-ja,NTP,0,0,0,,Емдеу міндетті түрде жұмыс істеуі керек.
Dialogue: 4,0:19:07.12,0:19:09.87,Default,,0,0,0,,Мен сені емдедім. Бұл жұмыс істеуі керек еді.
Dialogue: 4,0:19:09.87,0:19:14.38,Default,,0,0,0,,Сабер, сен әбден сауығып кеткенсің!
Dialogue: 1,0:19:10.30,0:19:14.26,JP-ja,NTP,0,0,0,,Сабер, сіз қазіргі күйіңізде толық қалпына келуіңіз керек.
Dialogue: 4,0:19:14.38,0:19:20.34,Default,,0,0,0,,Менің Гей Диргімнің алдында сауыт-сайманыңыздың пайдасыз екенін түсіндіңіз.
Dialogue: 1,0:19:14.80,0:19:16.75,JP-ja,NTP,0,0,0,,Менің «Қызыл қирау раушанымның» алдында
Dialogue: 1,0:19:17.43,0:19:20.07,JP-ja,NTP,0,0,0,,Сауыттың жарамсыз екенін түсінгенше жақсы болды.
Dialogue: 4,0:19:21.18,0:19:24.35,Default,,0,0,0,,Бірақ сіз сауытыңызды тастап кетуіңіз керек еді.
Dialogue: 1,0:19:21.21,0:19:24.13,JP-ja,NTP,0,0,0,,сауыт-сайманын мерзімінен бұрын лақтырып жіберді.
Dialogue: 1,0:19:26.55,0:19:27.72,JP-ja,NTP,0,0,0,,Әйтпесе
Dialogue: 4,0:19:26.56,0:19:30.31,Default,,0,0,0,,Егер сен мұны істемегенде, менің Гаэ Буидхеден қорғанатын едің.
Dialogue: 1,0:19:28.15,0:19:30.26,JP-ja,NTP,0,0,0,,«Үмітсіз сары раушан» - алдын алуға болатын нәрсе.
Dialogue: 1,0:19:30.81,0:19:33.32,JP-ja,NTP,0,0,0,,Түсіндім, бір рет киіп алсаң
Dialogue: 4,0:19:30.85,0:19:31.98,Default,,0,0,0,,Б... бір сызық
Dialogue: 4,0:19:31.98,0:19:36.44,Default,,0,0,0,,Жазылмайтын жара салған қарғыс атқан найза.
Dialogue: 1,0:19:33.52,0:19:36.18,JP-ja,NTP,0,0,0,,Жарасы жазылмайтын қарғыс атқан найза
Dialogue: 4,0:19:37.28,0:19:39.57,Default,,0,0,0,,Мен мұны ертерек түсінуім керек еді.
Dialogue: 1,0:19:37.30,0:19:39.36,JP-ja,NTP,0,0,0,,Ертерек байқаған жөн
Dialogue: 4,0:19:41.07,0:19:44.12,Default,,0,0,0,,Сиқырды жоққа шығаратын қызыл найза, қарғыс атқан сары найза,
Dialogue: 1,0:19:41.12,0:19:43.47,JP-ja,NTP,0,0,0,,Жындарды кесетін қызыл найза Қарғыс атқан сары найза
Dialogue: 4,0:19:44.12,0:19:47.54,Default,,0,0,0,,және оң көздің астындағы әйелдерді сиқырлайтын мең.
Dialogue: 1,0:19:44.23,0:19:47.48,JP-ja,NTP,0,0,0,,Сонымен қатар, қызды шатастыратын оң көзіндегі жылау меңі.
Dialogue: 4,0:19:48.45,0:19:53.08,Default,,0,0,0,,Фианна рыцарларының біріншісі, Нұрлы жүздің Диармуиді.
Dialogue: 1,0:19:48.47,0:19:50.63,JP-ja,NTP,0,0,0,,Фиона Найтстың ең ұлы жауынгері
Dialogue: 1,0:19:51.42,0:19:52.97,JP-ja,NTP,0,0,0,,«Жарқыраған жүз» диармуиді
Dialogue: 1,0:19:53.96,0:19:57.51,JP-ja,NTP,0,0,0,,Мен Te Aase no Sakae жетістігіне қатысамын деп ешқашан ойламадым.
Dialogue: 4,0:19:53.96,0:19:58.09,Default,,0,0,0,,Сізге қарсы тұру құрметіне ие боламын деп армандамадым.
Dialogue: 1,0:19:58.52,0:20:01.45,JP-ja,NTP,0,0,0,,Менің ойымша, бұл Қасиетті Граил соғысының біртүрлі нәрсесі.
Dialogue: 4,0:19:58.55,0:20:01.72,Default,,0,0,0,,Мұның бәрі Қасиетті Граил соғысының арқасында.
Dialogue: 1,0:20:02.22,0:20:05.32,JP-ja,NTP,0,0,0,,Әйтсе де, ең жоғары құрметке ие болған менмін.
Dialogue: 4,0:20:02.22,0:20:05.60,Default,,0,0,0,,Бірақ бұл жерде құрметке ие болған менмін.
Dialogue: 4,0:20:06.35,0:20:12.85,Default,,0,0,0,,Қасиетті Граил шақырған ешбір Батырлық Рух бұл алтын жүзді ешқашан қателесе алмайды.
Dialogue: 1,0:20:06.38,0:20:09.55,JP-ja,NTP,0,0,0,,Егер біреу уақыт пен кеңістіктен тыс «Батырлық рухтар тағына» шақырылса.
Dialogue: 1,0:20:10.03,0:20:12.44,JP-ja,NTP,0,0,0,,Бұл алтын қазына қылыштың қатесі жоқ.
Dialogue: 4,0:20:14.02,0:20:19.32,Default,,0,0,0,,Аты аңызға айналған Рыцарь патшасымен бетпе-бет келіп, бір соққы болса да жерге түсу...
Dialogue: 1,0:20:14.04,0:20:16.52,JP-ja,NTP,0,0,0,,Атақты Рыцарь патшасымен жарысу
Dialogue: 1,0:20:17.01,0:20:19.04,JP-ja,NTP,0,0,0,,Бір ғана соққы болатын дәрежеге қалай жетті?
Dialogue: 1,0:20:20.28,0:20:23.49,JP-ja,NTP,0,0,0,,Мен де тастамаған сияқтымын.
Dialogue: 4,0:20:20.32,0:20:23.36,Default,,0,0,0,,Мен өте білікті болуым керек.
Dialogue: 4,0:20:24.45,0:20:31.79,Default,,0,0,0,,Енді екеуміз бір-біріміздің есімдерімізді білетіндіктен, рыцарьлар ретінде абыроймен жекпе-жек өткізе аламыз.
Dialogue: 1,0:20:24.48,0:20:27.43,JP-ja,NTP,0,0,0,,Енді бір-біріміздің атын білеміз
Dialogue: 1,0:20:27.92,0:20:31.25,JP-ja,NTP,0,0,0,,Мен рыцарь ретінде ерекше шайқасқа шыға аламын.
Dialogue: 4,0:20:32.54,0:20:37.13,Default,,0,0,0,,Әлде қолыңнан айырылған соң осылай болып жатқанына ренжідің бе, Сабер?
Dialogue: 1,0:20:32.55,0:20:36.98,JP-ja,NTP,0,0,0,,Әлде қолыңнан айырылған соң қуанбаған шығарсың, Сабер?
Dialogue: 1,0:20:42.31,0:20:43.25,JP-ja,NTP,0,0,0,,Көңілді
Dialogue: 4,0:20:42.34,0:20:43.51,Default,,0,0,0,,Күлкілі болма.
Dialogue: 4,0:20:44.63,0:20:48.64,Default,,0,0,0,,Мұндай сызат үшін сізді алаңдату қорлау.
Dialogue: 1,0:20:44.67,0:20:48.71,JP-ja,NTP,0,0,0,,Бұл жарақат деңгейіне алаңдау өте қорлайтын нәрсе.
Dialogue: 4,0:20:52.06,0:20:53.56,Default,,0,0,0,,Дайын бол, Сабер.
Dialogue: 1,0:20:52.09,0:20:53.54,JP-ja,NTP,0,0,0,,Өзіңді дайында, Сабер.
Dialogue: 4,0:20:54.23,0:20:55.81,Default,,0,0,0,,Мен сені осы жолы аламын.
Dialogue: 1,0:20:54.32,0:20:55.69,JP-ja,NTP,0,0,0,,Мен оны келесі жолы ұстаймын
Dialogue: 4,0:20:56.27,0:21:00.32,Default,,0,0,0,,Тек сені бірінші түсінбесем, Лэнсер.
Dialogue: 1,0:20:56.34,0:21:00.20,JP-ja,NTP,0,0,0,,Мен сені ұстамадым, Лансер.
Dialogue: 4,0:21:10.03,0:21:11.16,Default,,0,0,0,,Күйме?!
Dialogue: 1,0:21:10.08,0:21:11.24,JP-ja,NTP,0,0,0,,Резервуар
Dialogue: 4,0:21:21.92,0:21:24.30,Default,,0,0,0,,Екеуің де жүздеріңді жабыңдар.
Dialogue: 1,0:21:22.28,0:21:24.23,JP-ja,NTP,0,0,0,,Екі жағы да қылышыңды таста.
Dialogue: 4,0:21:24.72,0:21:26.43,Default,,0,0,0,,Сіз патшаның алдында тұрсыз!
Dialogue: 1,0:21:24.78,0:21:26.37,JP-ja,NTP,0,0,0,,Патшаның алдында
Dialogue: 4,0:21:30.39,0:21:33.18,Default,,0,0,0,,Мен Ескендірмін, жаулаушылардың патшасы!
Dialogue: 1,0:21:30.40,0:21:32.77,JP-ja,NTP,0,0,0,,Менің атым Ескендір жаулап алушы
Dialogue: 1,0:21:33.69,0:21:38.45,JP-ja,NTP,0,0,0,,Жақында болған Қасиетті Граил соғысында ол шабандоздар класына ие болды және пайда болды.
Dialogue: 4,0:21:33.73,0:21:38.94,Default,,0,0,0,,Мен осы Грейл соғысындағы шабандоздар класынанмын.
Dialogue: 0,0:21:51.95,0:21:54.95,Sign-Title,,0,0,0,,4-бөлім
Dialogue: 0,0:21:51.95,0:21:54.95,Sign-Title,,0,0,0,,Жын найзасының жүзі
Dialogue: 1,0:21:51.95,0:21:54.95,Sign-Title,,0,0,0,,4-бөлім
Dialogue: 1,0:21:51.95,0:21:54.95,Sign-Title,,0,0,0,,Жын найзасының жүзі
Dialogue: 0,0:21:54.95,0:21:59.59,Ending-Romaji-L0,,0,0,0,,Шизука ни утсуриюку
Dialogue: 0,0:21:54.95,0:21:59.59,Ending-English-L0,,0,0,0,,Тыныш ауысу арасында
Dialogue: 0,0:21:54.95,0:21:59.59,Ending-Kanji-L0,,0,0,0,,Тыныш қозғалу
Dialogue: 1,0:21:54.95,0:21:59.59,Ending-Romaji-L1,,0,0,0,,Шизука ни утсуриюку
