Dialogue: 0,0:00:11.94,0:00:14.49,Sign-Locations,,0,0,0,,Эйнцберн сарайы, Германия
Dialogue: 0,0:00:11.94,0:00:14.49,Sign-Locations,,0,0,0,,— Сегіз жыл бұрын —
Dialogue: 1,0:00:13.48,0:00:14.52,JP-ja,NTP,0,0,0,,Кирицугу-сама
Dialogue: 4,0:00:13.53,0:00:14.49,Default,,0,0,0,,Кирицугу-сама!
Dialogue: 4,0:00:18.99,0:00:20.50,Default,,0,0,0,,Сіздің балаңыз дүниеге келді.
Dialogue: 1,0:00:19.10,0:00:20.47,JP-ja,NTP,0,0,0,,Сіз дүниеге келдіңіз
Dialogue: 4,0:00:24.37,0:00:26.08,Default,,0,0,0,,Ол сондай сүйкімді...
Dialogue: 1,0:00:24.47,0:00:25.60,JP-ja,NTP,0,0,0,,Сүйкімді
Dialogue: 4,0:00:26.08,0:00:31.38,Default,,0,0,0,,Кішкентай, сондай нәзік...
Dialogue: 1,0:00:26.24,0:00:27.30,JP-ja,NTP,0,0,0,,Өте
Dialogue: 1,0:00:28.42,0:00:29.42,JP-ja,NTP,0,0,0,,Кіші
Dialogue: 1,0:00:29.91,0:00:30.90,JP-ja,NTP,0,0,0,,нәзік
Dialogue: 4,0:00:32.22,0:00:34.18,Default,,0,0,0,,Қарашы, Кирицугу.
Dialogue: 1,0:00:32.27,0:00:36.13,JP-ja,NTP,0,0,0,,Қарашы, Кирицугу, оның көздері дәл сенікіне ұқсайды.
Dialogue: 4,0:00:34.18,0:00:36.55,Default,,0,0,0,,Оның көздері дәл сенікі сияқты.
Dialogue: 4,0:00:40.64,0:00:45.06,Default,,0,0,0,,Мен оның дүниеге келгеніне өте қуаныштымын.
Dialogue: 1,0:00:40.67,0:00:44.63,JP-ja,NTP,0,0,0,,Мен осы баланы дүниеге әкелгеніме өте қуаныштымын.
Dialogue: 4,0:00:51.19,0:00:52.19,Default,,0,0,0,,Iri.
Dialogue: 1,0:00:51.25,0:00:55.20,JP-ja,NTP,0,0,0,,Айри менмін
Dialogue: 4,0:00:54.32,0:00:58.70,Default,,0,0,0,,Мен... сенің өліміңе себепкер боламын.
Dialogue: 1,0:00:56.67,0:00:58.52,JP-ja,NTP,0,0,0,,Мен сені өлтіремін
Dialogue: 4,0:01:05.46,0:01:07.17,Default,,0,0,0,,Мұнда.
Dialogue: 1,0:01:05.66,0:01:07.16,JP-ja,NTP,0,0,0,,Мен білемін
Dialogue: 4,0:01:07.58,0:01:11.63,Default,,0,0,0,,Бұл Эйнцберндердің шынайы тілегі және менің бар болуымның себебі.
Dialogue: 1,0:01:07.61,0:01:09.62,JP-ja,NTP,0,0,0,,Бұл Эйнцберннің тілегі.
Dialogue: 1,0:01:09.98,0:01:11.66,JP-ja,NTP,0,0,0,,Мен осы мақсат үшін
Dialogue: 4,0:01:12.67,0:01:19.93,Default,,0,0,0,,Мен сенің мұраттарыңды біліп, дұғаларыңды жүрегіммен қабылдағандықтан қазір кіммін.
Dialogue: 1,0:01:12.82,0:01:14.27,JP-ja,NTP,0,0,0,,Өз идеалыңызды біліңіз
Dialogue: 1,0:01:14.77,0:01:16.86,JP-ja,NTP,0,0,0,,Өйткені біз жүрегімізде бір дұғаны ұстандық
Dialogue: 1,0:01:17.53,0:01:19.55,JP-ja,NTP,0,0,0,,Сондықтан мен бүгін кіммін.
Dialogue: 4,0:01:21.01,0:01:23.47,Default,,0,0,0,,Сіз маған жол көрсеттіңіз.
Dialogue: 1,0:01:21.10,0:01:23.31,JP-ja,NTP,0,0,0,,Мені тура жолға салдың
Dialogue: 1,0:01:24.13,0:01:26.36,JP-ja,NTP,0,0,0,,Маған қуыршақтан басқа өмір сүруге жол берді
Dialogue: 4,0:01:24.14,0:01:26.56,Default,,0,0,0,,Сіз маған қуыршақтай болмайтын өмір сыйладыңыз.
Dialogue: 4,0:01:28.35,0:01:30.82,Default,,0,0,0,,Мені аяудың қажеті жоқ.
Dialogue: 1,0:01:28.38,0:01:30.40,JP-ja,NTP,0,0,0,,Мені жоқтаудың қажеті жоқ
Dialogue: 1,0:01:30.79,0:01:32.88,JP-ja,NTP,0,0,0,,Мен сенің бір бөлшегіммін
Dialogue: 4,0:01:30.82,0:01:33.73,Default,,0,0,0,,Мен сенің бір бөлшегіммін.
Dialogue: 4,0:01:34.65,0:01:35.32,Default,,0,0,0,,Со-
Dialogue: 1,0:01:34.67,0:01:35.86,JP-ja,NTP,0,0,0,,Маған да солай
Dialogue: 4,0:01:35.32,0:01:35.95,Default,,0,0,0,,Ой, Хиёри-я! Жаңа жылды әзілмен бастап жатырсың ғой, иә?
Dialogue: 4,0:01:38.74,0:01:43.20,Default,,0,0,0,,Менің құқығым жоқ...
Dialogue: 1,0:01:38.79,0:01:45.64,JP-ja,NTP,0,0,0,,Менің ол баланы ұстауға құқығым жоқ.
Dialogue: 4,0:01:44.62,0:01:45.79,Default,,0,0,0,,...ол баланы ұстау үшін.
Dialogue: 4,0:01:49.50,0:01:52.00,Default,,0,0,0,,Кирицугу, ұмытпа.
Dialogue: 1,0:01:49.58,0:01:51.77,JP-ja,NTP,0,0,0,,Кирицугу Ұмытпаңыз
Dialogue: 4,0:01:53.34,0:01:56.22,Default,,0,0,0,,Ешкімге осылай жылаудың қажеті жоқ дүние...
Dialogue: 1,0:01:53.42,0:01:55.70,JP-ja,NTP,0,0,0,,Ешкім олай жыламайтын дүние
Dialogue: 4,0:01:56.22,0:02:01.35,Default,,0,0,0,,Бұл сіздің идеалыңыз, арманыңыз емес пе?
Dialogue: 1,0:01:56.33,0:01:57.52,JP-ja,NTP,0,0,0,,Бұл сенікі
Dialogue: 1,0:01:58.60,0:02:01.26,JP-ja,NTP,0,0,0,,Бұл Кирицугу Эмия армандаған идеал болса керек.
Dialogue: 4,0:02:03.01,0:02:06.85,Default,,0,0,0,,Тағы сегіз жыл, сонда сіздің күресіңіз аяқталады.
Dialogue: 1,0:02:03.03,0:02:06.79,JP-ja,NTP,0,0,0,,Сегіз жыл қалды, сонда сіздің шайқасыңыз бітеді.
Dialogue: 4,0:02:08.48,0:02:10.98,Default,,0,0,0,,Ал біздің идеалымыз шындыққа айналады.
Dialogue: 1,0:02:08.53,0:02:10.87,JP-ja,NTP,0,0,0,,Сіз бен біз мұратымызға жетеміз
Dialogue: 1,0:02:11.90,0:02:15.39,JP-ja,NTP,0,0,0,,Қасиетті Граил сені құтқаратынына сенімдімін.
Dialogue: 4,0:02:11.90,0:02:15.48,Default,,0,0,0,,Қасиетті Граил сені құтқаратынына сенімдімін.
Dialogue: 1,0:02:16.99,0:02:18.43,JP-ja,NTP,0,0,0,,Сонымен, бұл бала
Dialogue: 4,0:02:16.99,0:02:21.45,Default,,0,0,0,,Ендеше мына баланы, Ілиясвиелді алып, ұстаңыз.
Dialogue: 1,0:02:19.26,0:02:21.19,JP-ja,NTP,0,0,0,,Ильясвиелді ұстаңыз
Dialogue: 4,0:02:21.99,0:02:23.87,Default,,0,0,0,,Және мақтан тұтыңыз.
Dialogue: 1,0:02:22.08,0:02:27.90,JP-ja,NTP,0,0,0,,Мақтанышпен қарапайым әке ретінде
Dialogue: 4,0:02:23.87,0:02:28.04,Default,,0,0,0,,Кез келген әке сияқты.
Dialogue: 0,0:03:01.32,0:03:04.53,Sign-Locations,,0,0,0,,Турино, Италия
Dialogue: 0,0:03:01.32,0:03:04.53,Sign-Locations,,0,0,0,,— Үш жыл бұрын —
Dialogue: 1,0:03:01.32,0:03:04.53,Sign-Locations,,0,0,0,,Турино, Италия
Dialogue: 1,0:03:01.32,0:03:04.53,Sign-Locations,,0,0,0,,— Үш жыл бұрын —
Dialogue: 4,0:03:03.45,0:03:04.53,Default,,0,0,0,,Командалық заклинание?
Dialogue: 1,0:03:03.47,0:03:04.29,JP-ja,NTP,0,0,0,,Пәрмен емлесі
Dialogue: 4,0:03:04.53,0:03:07.50,Default,,0,0,0,,Иә, оң қолыңызда пайда болған белгілер.
Dialogue: 1,0:03:04.67,0:03:06.90,JP-ja,NTP,0,0,0,,Оң қолыңызда пайда болған үлгі
Dialogue: 4,0:03:07.50,0:03:10.41,Default,,0,0,0,,Бұл сізді Қасиетті Граил таңдағаныңыздың дәлелі.
Dialogue: 1,0:03:07.58,0:03:10.05,JP-ja,NTP,0,0,0,,Бұл сіздің Қасиетті Граил ретінде таңдалғаныңыздың дәлелі.
Dialogue: 4,0:03:10.41,0:03:13.79,Default,,0,0,0,,Сізге Қызметшіге бұйрық беру күшін беретін стигмата.
Dialogue: 1,0:03:10.47,0:03:13.77,JP-ja,NTP,0,0,0,,Бұл бақылаушы қызметшілерге берілетін стигма.
Dialogue: 1,0:03:15.49,0:03:16.97,JP-ja,NTP,0,0,0,,Кирей Котомине
Dialogue: 4,0:03:15.50,0:03:17.00,Default,,0,0,0,,Котомине Кирей-кун.
Dialogue: 1,0:03:18.40,0:03:20.22,JP-ja,NTP,0,0,0,,Қасиетті Граил соғысы
Dialogue: 4,0:03:18.46,0:03:20.68,Default,,0,0,0,,Қасиетті Граил соғысы...
Dialogue: 4,0:03:20.68,0:03:23.93,Default,,0,0,0,,Ғажайыптар жасай алатын құрылғы үшін шайқас...
Dialogue: 1,0:03:20.76,0:03:24.02,JP-ja,NTP,0,0,0,,Ғажайып тілек машинасы үшін күресте
Dialogue: 4,0:03:24.72,0:03:26.22,Default,,0,0,0,,Ал мен таңдалдым ба?
Dialogue: 1,0:03:24.95,0:03:25.74,JP-ja,NTP,0,0,0,,I
Dialogue: 1,0:03:26.21,0:03:30.47,JP-ja,NTP,0,0,0,,Бастапқыда Қасиетті Граил Қызметші Қожайыны ретінде таңдайтын жеті адам болды
Dialogue: 4,0:03:26.22,0:03:33.31,Default,,0,0,0,,Әдетте, Грейль қызметшілерге қожайын ретінде жеті Магиді таңдайды.
Dialogue: 1,0:03:30.81,0:03:32.97,JP-ja,NTP,0,0,0,,Екеуі де сиқыршы болуы керек.
Dialogue: 1,0:03:33.29,0:03:35.37,JP-ja,NTP,0,0,0,,Сиқырға қатысы жоқ сен сияқты біреу
Dialogue: 4,0:03:33.31,0:03:40.61,Default,,0,0,0,,Сіз сияқты сиқырға қатысы жоқ адамның ерте таңдалуы ерекше.
Dialogue: 1,0:03:35.74,0:03:38.43,JP-ja,NTP,0,0,0,,Қасиетті Граалды осындай ерте кезеңде көре білу ...
Dialogue: 1,0:03:38.51,0:03:40.02,JP-ja,NTP,0,0,0,,Бұл өте ерекше болар еді.
Dialogue: 1,0:03:40.99,0:03:44.44,JP-ja,NTP,0,0,0,,Қызметші Шақырған батырлық рух
Dialogue: 4,0:03:41.11,0:03:42.57,Default,,0,0,0,,Қызметшілер...
Dialogue: 4,0:03:42.95,0:03:48.45,Default,,0,0,0,,Мен әлі күнге дейін Батырлық рухтарды шақырып, сен үшін күресуге бұйрық беру біртүрлі деп ойлаймын.
Dialogue: 1,0:03:44.54,0:03:48.02,JP-ja,NTP,0,0,0,,Сондай-ақ олар таныс адамдар ретінде бір-бірімен төбелесуге жаратылғаны айтылады.
Dialogue: 1,0:03:48.39,0:03:52.22,JP-ja,NTP,0,0,0,,Менің ойымша, бір қарағанда сену қиын.
Dialogue: 4,0:03:48.45,0:03:52.46,Default,,0,0,0,,Мен сену қиын екенін білемін.
Dialogue: 4,0:03:52.46,0:03:58.92,Default,,0,0,0,,Әр дәуірден, әр ұлттан шыққан батырлар бірін-бірі өлтіріп, өздерінің үстемдігін дәлелдеу үшін қайта тірілген.
Dialogue: 1,0:03:52.52,0:03:56.18,JP-ja,NTP,0,0,0,,Әр дәуір мен елдің батырлары жаңа заманда жаңғырады.
Dialogue: 1,0:03:56.50,0:03:58.82,JP-ja,NTP,0,0,0,,Бірін-бірі өлтіру, үстемдік үшін жарысу
Dialogue: 4,0:04:00.76,0:04:02.80,Default,,0,0,0,,Бұл Қасиетті Граил соғысы.
Dialogue: 1,0:04:00.81,0:04:02.69,JP-ja,NTP,0,0,0,,Бұл Қасиетті Граил соғысы.
Dialogue: 4,0:04:02.80,0:04:08.10,Default,,0,0,0,,Әрине, шайқастарды жасырын жүргізу керектігі туралы айтылмаған келісім бар.
Dialogue: 1,0:04:02.95,0:04:07.56,JP-ja,NTP,0,0,0,,Әрине, текетірестің жасырын түрде өтуі айтылмаған заңдылық.
Dialogue: 1,0:04:07.95,0:04:13.31,JP-ja,NTP,0,0,0,,Мұны қамтамасыз ету үшін собор шіркеуінен бақылаушы жіберіледі.
Dialogue: 4,0:04:08.10,0:04:13.94,Default,,0,0,0,,Мұны қамтамасыз ету үшін біз Қасиетті Шіркеуден реттеушіні жібереміз.
Dialogue: 4,0:04:13.94,0:04:19.48,Default,,0,0,0,,Шіркеу мүшесі шынымен Маги арасындағы шайқаста төреші бола ала ма?
Dialogue: 1,0:04:13.99,0:04:19.33,JP-ja,NTP,0,0,0,,Біз шіркеу мүшелері сиқыршылардың шайқасында төреші боламыз ба?
Dialogue: 4,0:04:20.11,0:04:25.66,Default,,0,0,0,,Сиқыршылар қауымдастығының мүшесі әділ болу үшін бір тарапты артық көреді.
Dialogue: 1,0:04:20.23,0:04:25.30,JP-ja,NTP,0,0,0,,Сиқыршылар қауымдастығы қоршаулармен қамалған және әділ төреші бола алмайды.
Dialogue: 1,0:04:26.86,0:04:30.60,JP-ja,NTP,0,0,0,,Осы жағдайларға байланысты, соңғы рет алпыс жыл бұрын,
Dialogue: 4,0:04:26.91,0:04:34.25,Default,,0,0,0,,Сонымен алпыс жыл бұрынғыдай сенің әкең біздің шайқасымызды бақылайды.
Dialogue: 1,0:04:30.76,0:04:34.26,JP-ja,NTP,0,0,0,,Әкем біздің шайқасымызды бақылайды.
Dialogue: 4,0:04:34.25,0:04:36.88,Default,,0,0,0,,Менің әкем Фуюки қаласына барады ма?
Dialogue: 1,0:04:34.45,0:04:36.23,JP-ja,NTP,0,0,0,,Әкесі Фуюки елінде
Dialogue: 4,0:04:38.04,0:04:45.38,Default,,0,0,0,,Бірақ төреші мен қатысушының қандас туыстық қатынасында мәселе бар емес пе?
Dialogue: 1,0:04:38.14,0:04:45.01,JP-ja,NTP,0,0,0,,Дегенмен, жетекшінің жақын туыстары Қасиетті Граил соғысына қатысса, бұл қиындық тудырмай ма?
Dialogue: 4,0:04:45.38,0:04:46.39,Default,,0,0,0,,Токиоми-кун.
Dialogue: 1,0:04:45.38,0:04:49.61,JP-ja,NTP,0,0,0,,Токиоми-кун, енді негізгі тақырыпқа көшейік.
Dialogue: 4,0:04:47.43,0:04:50.06,Default,,0,0,0,,Мәселеге көшейік.
Dialogue: 1,0:04:51.10,0:04:57.16,JP-ja,NTP,0,0,0,,Кирей Осы уақытқа дейін бәрі Қасиетті Граил соғысына қатысты «ресми» жағдайлар ғана.
Dialogue: 4,0:04:51.10,0:04:57.69,Default,,0,0,0,,Кирей, біз осы уақытқа дейін айтқанымыздың барлығы қатысушыларға белгілі.
Dialogue: 1,0:04:57.68,0:05:03.58,JP-ja,NTP,0,0,0,,Бүгін сені мен Токиоми Тосакамен бірге әкелуімнің тағы бір себебі бар.
Dialogue: 4,0:04:57.69,0:05:04.11,Default,,0,0,0,,Бірақ Тохсака Токиоми екеуіңді бүгін осында келуді өтінгенімнің тағы бір себебі бар.
Dialogue: 1,0:05:04.08,0:05:05.40,JP-ja,NTP,0,0,0,,...
Dialogue: 4,0:05:04.11,0:05:05.91,Default,,0,0,0,,Бұл не болар еді?
Dialogue: 4,0:05:05.91,0:05:15.00,Default,,0,0,0,,Шындығында, көп жылдар бұрын Фуюки қаласында пайда болған Қасиетті Граил Құдай Ұлына тиесілі емес екендігінің дәлелі табылды.
Dialogue: 1,0:05:05.94,0:05:06.76,JP-ja,NTP,0,0,0,,Іс жүзінде
Dialogue: 1,0:05:07.21,0:05:12.19,JP-ja,NTP,0,0,0,,Фуюкиге көрінетін Қасиетті Граил Құдай Ұлының киелі жәдігерінен ерекшеленетіні анық па?
Dialogue: 1,0:05:12.87,0:05:14.37,JP-ja,NTP,0,0,0,,Баяғыда түсірілген.
Dialogue: 4,0:05:15.00,0:05:16.50,Default,,0,0,0,,Шынымен.
Dialogue: 1,0:05:15.10,0:05:15.77,JP-ja,NTP,0,0,0,,Менің ойымша
Dialogue: 4,0:05:16.50,0:05:22.13,Default,,0,0,0,,Әйтпесе, оны қайтарып алу туралы бұйрық бізге 8-ші Таинстволық Ассамблеядан берілген болар еді.
Dialogue: 1,0:05:16.65,0:05:21.80,JP-ja,NTP,0,0,0,,Егер олай болмаса, онда біз, Сегізінші Сакраментальдық Қоғам, қалпына келтіруге жауапты болар едік.
Dialogue: 4,0:05:22.13,0:05:26.97,Default,,0,0,0,,Дегенмен, Фуюкидегі Қасиетті Граил елеусіз қалдыру үшін тым күшті.
Dialogue: 1,0:05:22.23,0:05:26.61,JP-ja,NTP,0,0,0,,Алайда, Фуюкидің Қасиетті Граил жалғыз қалу үшін тым күшті.
Dialogue: 4,0:05:26.97,0:05:29.60,Default,,0,0,0,,Бұл құдіретті тілектерді орындайтын құрал.
Dialogue: 1,0:05:26.98,0:05:29.13,JP-ja,NTP,0,0,0,,Өйткені, бұл құдіретті тілек машинасы.
Dialogue: 1,0:05:29.53,0:05:34.01,JP-ja,NTP,0,0,0,,Егер ол қалаусыз адамдардың қолына түссе, ол қандай апат әкеледі?
Dialogue: 4,0:05:29.60,0:05:34.14,Default,,0,0,0,,Кім біледі, егер ол басқа адамдардың қолына түссе, қандай апатқа әкелуі мүмкін?
Dialogue: 4,0:05:34.60,0:05:44.15,Default,,0,0,0,,Осылайша, біз Грайлдың В жоспары ретінде, ең болмағанда, дұрыс қолға түсетінін қамтамасыз етсек жақсы болады.
Dialogue: 1,0:05:34.62,0:05:37.30,JP-ja,NTP,0,0,0,,Содан кейін келесі ең жақсы нұсқа ретінде
Dialogue: 1,0:05:37.56,0:05:41.18,JP-ja,NTP,0,0,0,,Қалаған адамға Фуюкидің Қасиетті Граясын тапсырудың жолы болса.
Dialogue: 1,0:05:41.62,0:05:43.62,JP-ja,NTP,0,0,0,,Бұдан жақсы ештеңе жоқ.
Dialogue: 4,0:05:44.15,0:05:50.87,Default,,0,0,0,,Тохсака отбасы шын мәнінде магилер, бірақ олардың шіркеумен ұзақ достық тарихы бар.
Dialogue: 1,0:05:44.23,0:05:47.49,JP-ja,NTP,0,0,0,,Тохсака отбасы сиқыршылар отбасы болса да,
Dialogue: 1,0:05:47.83,0:05:50.54,JP-ja,NTP,0,0,0,,Шіркеумен бұрыннан байланысы бар отбасы.
Dialogue: 4,0:05:50.87,0:05:55.29,Default,,0,0,0,,Мен Токиоми-кунның мінезіне де кепілдік бере аламын.
Dialogue: 1,0:05:50.93,0:05:55.01,JP-ja,NTP,0,0,0,,Токиоми-кунның өзіне келетін болсақ, мен оның мінезіне кепілдік бере аламын.
Dialogue: 1,0:05:55.23,0:05:59.34,JP-ja,NTP,0,0,0,,Ең бастысы, ол Қасиетті Граилдың қолданылуын нақты анықтайды.
Dialogue: 4,0:05:55.29,0:05:59.67,Default,,0,0,0,,Оның үстіне оның Грейльге деген ниеті анық.
Dialogue: 4,0:05:59.67,0:06:01.88,Default,,0,0,0,,Түбірге жету үшін.
Dialogue: 1,0:05:59.78,0:06:05.11,JP-ja,NTP,0,0,0,,«Түбірге» жету Тоқсақымыздың шын тілегі осы бір тұста ерекше.
Dialogue: 4,0:06:01.88,0:06:05.26,Default,,0,0,0,,Бұл Тохсака әулетінің жалғыз тілегі.
Dialogue: 1,0:06:05.57,0:06:10.10,JP-ja,NTP,0,0,0,,Алайда, бір кездері бірдей ұмтылыс болған Эйнцберн мен Мату,
Dialogue: 4,0:06:05.67,0:06:13.56,Default,,0,0,0,,Алайда, Эйнцберндер де, Матустар да бір кездері біз айтқан тілегімізді ұмытып кетті.
Dialogue: 1,0:06:10.68,0:06:13.13,JP-ja,NTP,0,0,0,,Мен бұл бастапқы ниетімді мүлде ұмыттым.
Dialogue: 4,0:06:13.76,0:06:18.39,Default,,0,0,0,,Мен басқа магистрлерге жағдайды түсіндірудің қажеті жоқ деп ойлаймын.
Dialogue: 1,0:06:13.78,0:06:17.90,JP-ja,NTP,0,0,0,,Сонымен қатар сырттан шеберлер шақырылғаны айтпаса да түсінікті
Dialogue: 4,0:06:18.39,0:06:23.86,Default,,0,0,0,,Кім біледі, олардың Грейлге қандай қараңғы жоспарлары болуы мүмкін?
Dialogue: 1,0:06:18.43,0:06:23.71,JP-ja,NTP,0,0,0,,Адамдардың Қасиетті Граилға қандай таяз қалаулары бар екенін білмеймін.
Dialogue: 1,0:06:24.17,0:06:28.81,JP-ja,NTP,0,0,0,,Сонымен, Токиоми Тохсака мырзаның жеңіске жетуі үшін И
Dialogue: 4,0:06:24.23,0:06:32.58,Default,,0,0,0,,Сондықтан мен Тохсака Токиомидің жеңісін қамтамасыз ету үшін алдағы Қасиетті Граил соғысына қатысамын.
Dialogue: 1,0:06:29.23,0:06:32.33,JP-ja,NTP,0,0,0,,Сізге келесі Қасиетті Граил соғысына қатысу жеткілікті.
Dialogue: 4,0:06:32.58,0:06:39.50,Default,,0,0,0,,Әрине, біз Grail үшін шайқасып жатқан жау ретінде әрекет етеміз.
Dialogue: 1,0:06:32.66,0:06:34.08,JP-ja,NTP,0,0,0,,Әрине, сырттай
Dialogue: 1,0:06:34.38,0:06:38.98,JP-ja,NTP,0,0,0,,Сіз және мен Қасиетті Граил үшін жарысатын жау ретінде әрекет етеміз.
Dialogue: 4,0:06:39.50,0:06:49.84,Default,,0,0,0,,Бірақ біз басқа бес Мастерді жеңіп, белгілі бір жеңіске жету үшін бірге жұмыс істейміз.
Dialogue: 1,0:06:39.66,0:06:43.51,JP-ja,NTP,0,0,0,,Бірақ біз күш біріктіріп, сахна артында бірге күресеміз.
Dialogue: 1,0:06:43.98,0:06:46.60,JP-ja,NTP,0,0,0,,Қалған бес шеберді жойып, жойыңыз.
Dialogue: 1,0:06:47.09,0:06:49.49,JP-ja,NTP,0,0,0,,Нақтырақ жеңіске жету үшін
Dialogue: 4,0:06:50.59,0:06:52.60,Default,,0,0,0,,Міне, Кирей-күн.
Dialogue: 1,0:06:50.60,0:06:57.39,JP-ja,NTP,0,0,0,,Міне, Кирей-кун, сен Киелі шіркеуден Сиқыршылар қауымдастығына жөнелтілім ретінде ауыстырдың.
Dialogue: 4,0:06:52.60,0:06:59.85,Default,,0,0,0,,Сізді Шіркеуден Сиқыршылар қауымдастығына ауыстырып, онда менің шәкіртім боласыз.
Dialogue: 1,0:06:57.73,0:06:59.35,JP-ja,NTP,0,0,0,,Менің шәкіртім бол
Dialogue: 1,0:06:59.79,0:07:02.13,JP-ja,NTP,0,0,0,,Ресми тағайындау қазірдің өзінде берілген.
Dialogue: 4,0:06:59.85,0:07:02.35,Default,,0,0,0,,Ресми бұйрықтар шығарылды.
Dialogue: 1,0:07:02.75,0:07:05.84,JP-ja,NTP,0,0,0,,Сіз Жапониядағы біздің отбасымызда сиқыршылыққа қатты жаттығасыз.
Dialogue: 4,0:07:02.77,0:07:06.23,Default,,0,0,0,,Сіз Жапонияға барып, сиқырды үйренесіз,
Dialogue: 4,0:07:06.23,0:07:14.74,Default,,0,0,0,,және үш жылдан кейін Қасиетті Граил соғысындағы Қызметшіні басқаруға жеткілікті күшті сиқыршы болыңыз.
Dialogue: 1,0:07:06.35,0:07:09.30,JP-ja,NTP,0,0,0,,Үш жылдан кейін Қасиетті Граил соғысына дейін қызметшіге бағын.
Dialogue: 1,0:07:09.64,0:07:14.43,JP-ja,NTP,0,0,0,,Шебер ретінде шайқасқа қатысуға жеткілікті сиқыршы болуы керек.
Dialogue: 1,0:07:18.86,0:07:19.51,JP-ja,NTP,0,0,0,,♪ Ка-та-на
Dialogue: 4,0:07:18.95,0:07:20.00,Default,,0,0,0,,Енді...
Dialogue: 4,0:07:20.00,0:07:22.88,Default,,0,0,0,,Сұрақтарыңыз бар ма, Кирей?
Dialogue: 1,0:07:20.15,0:07:22.14,JP-ja,NTP,0,0,0,,Сұрақтарыңыз бар ма? Кирей
Dialogue: 4,0:07:22.88,0:07:24.00,Default,,0,0,0,,Бір ғана.
Dialogue: 1,0:07:22.89,0:07:23.81,JP-ja,NTP,0,0,0,,(Теледидардың жарылу дыбысы)
Dialogue: 1,0:07:25.95,0:07:29.14,JP-ja,NTP,0,0,0,,Шеберді таңдайтын Қасиетті Граилдың еркі
Dialogue: 4,0:07:26.00,0:07:31.80,Default,,0,0,0,,Граил өз шеберлерін таңдауда нақты қандай еркі бар?
Dialogue: 1,0:07:29.52,0:07:31.48,JP-ja,NTP,0,0,0,,Бұл не?
Dialogue: 4,0:07:34.64,0:07:40.81,Default,,0,0,0,,Grail оған ең қажет магистрлерді таңдағанды ​​жөн көреді.
Dialogue: 1,0:07:34.67,0:07:40.28,JP-ja,NTP,0,0,0,,Қасиетті Граил оған көбірек мұқтаж адамдардан шеберлерге басымдық береді.
Dialogue: 1,0:07:40.75,0:07:44.20,JP-ja,NTP,0,0,0,,Сонымен, әрбір шебердің Қасиетті Граильді қалайтын себебі бар.
Dialogue: 4,0:07:40.81,0:07:44.56,Default,,0,0,0,,Бұл барлық Ұстаздардың Граильге құштар болуына себеп бар дегенді білдіре ме?
Dialogue: 4,0:07:44.56,0:07:46.57,Default,,0,0,0,,Міндетті емес.
Dialogue: 1,0:07:44.63,0:07:45.87,JP-ja,NTP,0,0,0,,Міндетті емес.
Dialogue: 1,0:07:46.53,0:07:49.57,JP-ja,NTP,0,0,0,,Ертеде бастапқыда сайланбаған тәртіпсіз адамдар болған.
Dialogue: 4,0:07:46.57,0:07:53.11,Default,,0,0,0,,Командалық сиқырлар сіз таңдалады деп күтпеген адамдарда пайда болған жағдайлар болды.
Dialogue: 1,0:07:50.20,0:07:52.52,JP-ja,NTP,0,0,0,,Ол кейде командалық заклинанияны қамтыған сияқты.
Dialogue: 1,0:07:54.14,0:08:00.71,JP-ja,NTP,0,0,0,,Түсіндім. Кирей-кун, сенің таңдалғаныңды әлі де түсінбейсің.
Dialogue: 4,0:07:54.82,0:07:56.49,Default,,0,0,0,,Түсіндім, Кирей-күн.
Dialogue: 4,0:07:56.78,0:08:00.54,Default,,0,0,0,,Таңдалғаныңызға әлі де таң қалдыңыз ба?
Dialogue: 4,0:08:03.67,0:08:07.25,Default,,0,0,0,,Мен оның келісімін тез береді деп күтпедім.
Dialogue: 1,0:08:03.78,0:08:06.80,JP-ja,NTP,0,0,0,,Ол мен күткеннен де оңай келісті.
Dialogue: 4,0:08:07.25,0:08:12.30,Default,,0,0,0,,Шіркеу қаласа, менің ұлым жанып тұрған жалынға секірер еді.
Dialogue: 1,0:08:07.46,0:08:11.72,JP-ja,NTP,0,0,0,,Егер қауымның еркі болса, ұлы отқа секіреді.
Dialogue: 4,0:08:12.30,0:08:15.39,Default,,0,0,0,,Шынымды айтсам, бұл мазасызданады.
Dialogue: 1,0:08:12.31,0:08:14.74,JP-ja,NTP,0,0,0,,Шынымды айтсам, мен қатты таң қалдым.
Dialogue: 4,0:08:15.39,0:08:21.68,Default,,0,0,0,,Оның көзқарасы бойынша, ол оған еш қатысы жоқ соғысқа тартылды.
Dialogue: 1,0:08:15.45,0:08:16.73,JP-ja,NTP,0,0,0,,Оның көзқарасы бойынша
Dialogue: 1,0:08:17.06,0:08:21.46,JP-ja,NTP,0,0,0,,Бір-бірімен байланысы жоқ қақтығысқа қатысқандай болар едік.
Dialogue: 4,0:08:22.18,0:08:27.23,Default,,0,0,0,,Жоқ, бұл оның құтқарылуы болуы мүмкін.
Dialogue: 1,0:08:22.23,0:08:26.45,JP-ja,NTP,0,0,0,,Жоқ, мүмкін бұл оның құтқарылуы болды.
Dialogue: 4,0:08:27.82,0:08:32.15,Default,,0,0,0,,Әйелі бірнеше күн бұрын ғана дүниеден өтті.
Dialogue: 1,0:08:27.93,0:08:31.50,JP-ja,NTP,0,0,0,,Күні кеше ғана әйелімнен айырылдым.
Dialogue: 4,0:08:32.15,0:08:40.62,Default,,0,0,0,,Жаңа орын мен жаңа миссия Кирейдің қалпына келуі үшін қажет нәрсе болуы мүмкін.
Dialogue: 1,0:08:32.21,0:08:35.59,JP-ja,NTP,0,0,0,,Сіздің назарыңызды өзгертіп, жаңа миссияны қабылдауға болады.
Dialogue: 1,0:08:35.88,0:08:40.04,JP-ja,NTP,0,0,0,,Қазір Кирей үшін бұл оның жарасын емдеудің төте жолы болуы мүмкін.
Dialogue: 0,0:08:43.91,0:08:49.88,Sign-Locations,,0,0,0,,Фуюки қаласы, Жапония
Dialogue: 0,0:08:43.91,0:08:49.88,Sign-Locations,,0,0,0,,— Бір жыл бұрын —
Dialogue: 1,0:08:43.91,0:08:49.88,Sign-Locations,,0,0,0,,Фуюки қаласы, Жапония
Dialogue: 1,0:08:43.91,0:08:49.88,Sign-Locations,,0,0,0,,— Бір жыл бұрын —
Dialogue: 4,0:08:51.09,0:08:52.46,Default,,0,0,0,,Аои-сан.
Dialogue: 1,0:08:51.17,0:08:51.99,JP-ja,NTP,0,0,0,,Аои-сан
Dialogue: 4,0:08:57.39,0:08:59.56,Default,,0,0,0,,Қария-күн, біраз болды.
Dialogue: 1,0:08:57.45,0:08:59.28,JP-ja,NTP,0,0,0,,Қария-күн, біраз болды.
Dialogue: 4,0:08:59.56,0:09:01.56,Default,,0,0,0,,Сіз іссапардан оралдыңыз ба?
Dialogue: 1,0:08:59.59,0:09:01.04,JP-ja,NTP,0,0,0,,Мен жаңа ғана іссапардан келдім.
Dialogue: 4,0:09:01.56,0:09:04.44,Default,,0,0,0,,Бұл өте ұзақ болды.
Dialogue: 1,0:09:01.64,0:09:04.23,JP-ja,NTP,0,0,0,,Бұл жолы көп уақыт қажет болды.
Dialogue: 4,0:09:04.44,0:09:06.60,Default,,0,0,0,,"Жоқ" жағын бөгеп, жоятын есілік балалары
Dialogue: 1,0:09:04.50,0:09:06.21,JP-ja,NTP,0,0,0,,Жақсы.
Dialogue: 1,0:09:07.31,0:09:08.31,JP-ja,NTP,0,0,0,,Қария ағай
Dialogue: 4,0:09:07.35,0:09:08.86,Default,,0,0,0,,Қария аға!
Dialogue: 4,0:09:10.77,0:09:13.07,Default,,0,0,0,,Қария аға, қош келдіңіз.
Dialogue: 1,0:09:10.83,0:09:12.59,JP-ja,NTP,0,0,0,,Қария аға, үйге қош келдіңіз
Dialogue: 1,0:09:13.31,0:09:14.02,JP-ja,NTP,0,0,0,,Рин-чан
Dialogue: 4,0:09:13.32,0:09:14.32,Default,,0,0,0,,Рин-чан.
Dialogue: 4,0:09:15.07,0:09:17.91,Default,,0,0,0,,Маған тағы бірдеңе сатып алдың ба?
Dialogue: 1,0:09:15.29,0:09:17.55,JP-ja,NTP,0,0,0,,Ол маған тағы бір кәдесый сатып алды.
Dialogue: 1,0:09:17.86,0:09:20.41,JP-ja,NTP,0,0,0,,Гор Риннің мінез-құлқы нашар
Dialogue: 4,0:09:17.91,0:09:20.95,Default,,0,0,0,,Жоқ, Рин! Бұл дөрекі болды!
Dialogue: 4,0:09:22.49,0:09:23.08,Default,,0,0,0,,Жер
Dialogue: 1,0:09:22.61,0:09:23.04,JP-ja,NTP,0,0,0,,Иә
Dialogue: 4,0:09:27.54,0:09:29.59,Default,,0,0,0,,Рахмет, ағай!
Dialogue: 1,0:09:27.61,0:09:29.10,JP-ja,NTP,0,0,0,,Рахмет, ағай.
Dialogue: 1,0:09:29.51,0:09:32.08,JP-ja,NTP,0,0,0,,Ұнаса ағай да қуанады.
Dialogue: 4,0:09:29.59,0:09:32.63,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 4,0:09:35.97,0:09:37.34,Default,,0,0,0,,Сакура-чан қайда?
Dialogue: 1,0:09:36.09,0:09:37.09,JP-ja,NTP,0,0,0,,Сакура-чан
Dialogue: 4,0:09:40.85,0:09:43.77,Default,,0,0,0,,Сакура кетті.
Dialogue: 1,0:09:40.90,0:09:43.31,JP-ja,NTP,0,0,0,,Шие гүлдері енді жоқ.
Dialogue: 1,0:09:48.23,0:09:48.75,JP-ja,NTP,0,0,0,,Аои-сан
Dialogue: 4,0:09:48.23,0:09:49.69,Default,,0,0,0,,Аои-сан?
Dialogue: 4,0:09:49.69,0:09:54.99,Default,,0,0,0,,Сакура енді менің қызым немесе Риннің қарындасы емес.
Dialogue: 1,0:09:49.80,0:09:55.04,JP-ja,NTP,0,0,0,,Сакура енді менің қызым немесе Риннің әпкесі емес.
Dialogue: 4,0:09:56.65,0:10:00.99,Default,,0,0,0,,Ол Мату отбасына кетті.
Dialogue: 1,0:09:56.67,0:10:00.88,JP-ja,NTP,0,0,0,,Әлгі қыз Матудың үйіне барды.
Dialogue: 4,0:10:02.12,0:10:03.74,Default,,0,0,0,,Неге?!
Dialogue: 1,0:10:02.15,0:10:02.98,JP-ja,NTP,0,0,0,,Неліктен?
Dialogue: 4,0:10:03.74,0:10:11.88,Default,,0,0,0,,Мату отбасының неліктен сиқыршы қаны бар балаларды қалайтынын білесіз.
Dialogue: 1,0:10:03.81,0:10:08.39,JP-ja,NTP,0,0,0,,Неліктен Мату сиқыршының қанын иемденетін баланы қалайды
Dialogue: 1,0:10:09.11,0:10:12.24,JP-ja,NTP,0,0,0,,Әрине түсінер едіңіз.
Dialogue: 4,0:10:15.09,0:10:21.30,Default,,0,0,0,,Тохсака әулетінің басшысы біздің ежелгі одақтастарымыз Матусқа олардың сұрағанын беруге шешім қабылдады.
Dialogue: 1,0:10:15.18,0:10:18.43,JP-ja,NTP,0,0,0,,Менің ескі одақтасым Матудың өтінішіне жауап ретінде,
Dialogue: 1,0:10:18.68,0:10:21.05,JP-ja,NTP,0,0,0,,Тохсака отағасы осылай шешті.
Dialogue: 1,0:10:21.67,0:10:23.62,JP-ja,NTP,0,0,0,,Пікір айта алмаймын.
Dialogue: 4,0:10:21.72,0:10:24.01,Default,,0,0,0,,Бұл менің пікірімді білдіретін жерім емес еді.
Dialogue: 4,0:10:25.56,0:10:27.10,Default,,0,0,0,,Ал сіз мұны жақсысыз ба?
Dialogue: 1,0:10:25.61,0:10:26.97,JP-ja,NTP,0,0,0,,Бұл жақсы ма?
Dialogue: 4,0:10:27.52,0:10:30.73,Default,,0,0,0,,Мен Тохсака отбасына тұрмысқа шыққанда...
Dialogue: 1,0:10:27.60,0:10:30.16,JP-ja,NTP,0,0,0,,Мен Тохсака отбасына үйленемін деп шешкен кезде
Dialogue: 1,0:10:30.67,0:10:33.17,JP-ja,NTP,0,0,0,,Мен сиқыршының әйелі боламын деп шешкен сәттен бастап
Dialogue: 4,0:10:30.73,0:10:33.82,Default,,0,0,0,,Мен Сиқыршының әйелі болуды шешкен кезде...
Dialogue: 1,0:10:33.71,0:10:35.70,JP-ja,NTP,0,0,0,,Мен осындай нәрсеге дайындалдым.
Dialogue: 4,0:10:33.82,0:10:36.07,Default,,0,0,0,,Мен мұндай нәрсеге дайын болдым.
Dialogue: 4,0:10:36.07,0:10:37.90,Default,,0,0,0,,Ал сен мұнымен жақсысың ба?!
Dialogue: 1,0:10:36.15,0:10:37.60,JP-ja,NTP,0,0,0,,Бұл жақсы ма?
Dialogue: 1,0:10:37.89,0:10:40.15,JP-ja,NTP,0,0,0,,Сиқыршылардың қанын иеленген отбасы
Dialogue: 4,0:10:37.90,0:10:44.87,Default,,0,0,0,,Сиқыршы қаны бар отбасының қалыпты отбасының бақытын күтуі дұрыс емес.
Dialogue: 1,0:10:40.66,0:10:44.68,JP-ja,NTP,0,0,0,,Қарапайым отбасы бақытын іздеу қате.
Dialogue: 1,0:10:44.77,0:10:48.86,JP-ja,NTP,0,0,0,,Бұл өтірік, бақыт тілейсің
Dialogue: 4,0:10:44.87,0:10:46.12,Default,,0,0,0,,Эбису
Dialogue: 4,0:10:46.12,0:10:49.00,Default,,0,0,0,,Сіз оны таңдаған кезде бақытты болғыңыз келді-
Dialogue: 1,0:10:48.94,0:10:52.48,JP-ja,NTP,0,0,0,,Бұл Тохсака мен Мату арасындағы мәселе.
Dialogue: 4,0:10:49.00,0:10:52.42,Default,,0,0,0,,Бұл Тохсакалар мен Матустардың арасында.
Dialogue: 4,0:10:52.92,0:10:55.63,Default,,0,0,0,,Маги әлеміне арқаңызды бұрдыңыз.
Dialogue: 1,0:10:52.95,0:10:55.53,JP-ja,NTP,0,0,0,,Сиқыршылар әлемінен бас тартқандар үшін
Dialogue: 1,0:10:56.33,0:10:57.76,JP-ja,NTP,0,0,0,,Бір-бірімен байланысы жоқ әңгіме
Dialogue: 4,0:10:56.42,0:10:58.13,Default,,0,0,0,,Бұл сізге қатысты емес.
Dialogue: 4,0:11:02.34,0:11:06.64,Default,,0,0,0,,Егер сіз Сакураны көрсеңіз, оған мейірімді болыңыз.
Dialogue: 1,0:11:02.35,0:11:06.56,JP-ja,NTP,0,0,0,,Сакураны кездестірсеңіз, оған мейірімді болыңыз.
Dialogue: 4,0:11:07.52,0:11:11.65,Default,,0,0,0,,Ол сені үнемі жақсы көретін, Қария-күн...
Dialogue: 1,0:11:07.60,0:11:11.07,JP-ja,NTP,0,0,0,,Өйткені мен сол балаға, Қария-күнге байланып қалдым.
Dialogue: 1,0:11:14.54,0:11:18.43,JP-ja,NTP,0,0,0,,Төбелескендер көңіл айтып жүретін.
Dialogue: 4,0:11:14.57,0:11:18.40,Default,,0,0,0,,Сіз сияқты сәтсіздікке оның бетін осында көрсетуге батылы баратынына таң қалдым.
Dialogue: 4,0:11:20.03,0:11:26.79,Default,,0,0,0,,Мен сені енді ешқашан көруге рұқсат етпе деп айтқаныма сенемін.
Dialogue: 1,0:11:20.12,0:11:23.48,JP-ja,NTP,0,0,0,,Енді маған ол жағын көрсетпеу керек.
Dialogue: 1,0:11:23.65,0:11:26.27,JP-ja,NTP,0,0,0,,Саған айтқаныма сенімдімін.
Dialogue: 1,0:11:27.08,0:11:27.83,JP-ja,NTP,0,0,0,,Қария
Dialogue: 4,0:11:27.08,0:11:28.45,Default,,0,0,0,,Қария.
Dialogue: 1,0:11:28.39,0:11:30.59,JP-ja,NTP,0,0,0,,Олар Тохсақаның екінші қызын асырап алған көрінеді.
Dialogue: 4,0:11:28.45,0:11:30.79,Default,,0,0,0,,Тохсаканың кіші қызын асырап алғаныңызды естідім.
Dialogue: 4,0:11:31.87,0:11:33.88,Default,,0,0,0,,Жаңалықтар сізге тез жетеді.
Dialogue: 1,0:11:31.90,0:11:33.03,JP-ja,NTP,0,0,0,,жылдам құлақ
Dialogue: 4,0:11:33.88,0:11:39.21,Default,,0,0,0,,Сіз шынымен де Мату тұқымындағы сиқырлы жақындықты сақтауды қалайсыз ба?
Dialogue: 1,0:11:33.92,0:11:35.25,JP-ja,NTP,0,0,0,,Сол дәрежеде
Dialogue: 1,0:11:35.51,0:11:39.04,JP-ja,NTP,0,0,0,,Матудың қанында сиқыршы факторды қалдырғыңыз келе ме?
Dialogue: 4,0:11:39.21,0:11:42.89,Default,,0,0,0,,Сіз маған мұны дұрыс емес деп айтасыз ба?
Dialogue: 1,0:11:39.28,0:11:42.46,JP-ja,NTP,0,0,0,,Оны түзететін сенсің.
Dialogue: 1,0:11:42.78,0:11:47.31,JP-ja,NTP,0,0,0,,Матудың осы жағдайға түсуіне кім себепші болды деп ойлайсыз?
Dialogue: 4,0:11:42.89,0:11:47.56,Default,,0,0,0,,Мату отбасының құлдырап кетуіне кім кінәлі деп ойлайсың?
Dialogue: 4,0:11:48.14,0:11:49.18,Default,,0,0,0,,Қария.
Dialogue: 1,0:11:48.14,0:11:54.27,JP-ja,NTP,0,0,0,,Онуши әулет басшысын адал мұра етіп, Матоудың құпиясын мұра еткен болса.
Dialogue: 4,0:11:49.73,0:11:57.32,Default,,0,0,0,,Егер сіз фамилияны жалғастыруға және Мату құпияларын білуге ​​келіскен болсаңыз, бұлай болмас еді.
Dialogue: 1,0:11:54.51,0:11:57.02,JP-ja,NTP,0,0,0,,Осы уақытқа дейін жағдай өзекті.
Dialogue: 1,0:11:57.30,0:11:59.42,JP-ja,NTP,0,0,0,,Бұл сенсің.
Dialogue: 4,0:11:57.32,0:11:59.61,Default,,0,0,0,,Дегенмен сіз...
Dialogue: 1,0:11:59.53,0:12:01.91,JP-ja,NTP,0,0,0,,Бұл фарсты тоқтат, вампир.
Dialogue: 4,0:11:59.61,0:12:01.82,Default,,0,0,0,,Жетеді бұл бос сөз, вампир.
Dialogue: 1,0:12:02.43,0:12:05.39,JP-ja,NTP,0,0,0,,Өзіңнің өлместігіңе жету
Dialogue: 4,0:12:02.45,0:12:08.04,Default,,0,0,0,,Сіз тек Граилдың өлместікке ие болғанын қалайсыз.
Dialogue: 1,0:12:05.62,0:12:07.39,JP-ja,NTP,0,0,0,,Ол Қасиетті Граалды ұрлап жатқан шығар.
Dialogue: 1,0:12:09.96,0:12:13.22,JP-ja,NTP,0,0,0,,Алпыс жылдық цикл келесі жылы келеді
Dialogue: 4,0:12:10.04,0:12:13.58,Default,,0,0,0,,Келесі жылға дейін алпыс жыл өтеді.
Dialogue: 1,0:12:13.47,0:12:18.23,JP-ja,NTP,0,0,0,,Бірақ Матуда төртінші Қасиетті Граил соғысында ойнайтын фигуралар жоқ.
Dialogue: 4,0:12:13.58,0:12:18.71,Default,,0,0,0,,Бірақ Мату отбасында 4-ші Қасиетті Граил соғысына ұсынатын пешкалар жоқ.
Dialogue: 1,0:12:18.61,0:12:19.77,JP-ja,NTP,0,0,0,,Сіз мадамашимосыз
Dialogue: 4,0:12:18.71,0:12:24.51,Default,,0,0,0,,Сіз сияқты ағаңыз Бякуяда Қызметшіні басқаруға мана жетіспейді.
Dialogue: 1,0:12:19.90,0:12:24.87,JP-ja,NTP,0,0,0,,Менің ағам Цуруноның сиқырлы күші қызметшіні басқара алмайды.
Dialogue: 1,0:12:24.87,0:12:31.28,JP-ja,NTP,0,0,0,,Демек, бұл шайқасты кейінге қалдырсақ та, алдағы 60 жылда жеңіске жетуге мүмкіндік бар.
Dialogue: 4,0:12:24.89,0:12:30.85,Default,,0,0,0,,Бірақ біз бұл раундтың өтуіне жол берсек те, алдағы алпыс жылдан кейін біз жеңе аламыз.
Dialogue: 4,0:12:31.35,0:12:36.94,Default,,0,0,0,,Тохсака қызының құрсағынан талантты сиқыршы шығады.
Dialogue: 1,0:12:31.44,0:12:36.39,JP-ja,NTP,0,0,0,,Тохсака қызының плацентасынан нағыз тамаша сиқыршы туады.
Dialogue: 1,0:12:36.90,0:12:40.62,JP-ja,NTP,0,0,0,,Ыдыс ретінде көп үміт бар.
Dialogue: 4,0:12:36.94,0:12:40.86,Default,,0,0,0,,Оның кеме ретінде әлеуеті өте жоғары.
Dialogue: 4,0:12:40.86,0:12:47.74,Default,,0,0,0,,Негізінде, сіз Грейльді алғаннан кейін Тохсака Сакурадан пайда таппайсыз ба?
Dialogue: 1,0:12:40.97,0:12:44.70,JP-ja,NTP,0,0,0,,​​Егер солай болса, мен Қасиетті Граильді ала алсам ғой.
Dialogue: 1,0:12:45.15,0:12:47.29,JP-ja,NTP,0,0,0,,Тохсака Сакураның пайдасы жоқ.
Dialogue: 4,0:12:48.91,0:12:51.91,Default,,0,0,0,,Сіздің ойыңызда не бар?
Dialogue: 1,0:12:49.00,0:12:51.57,JP-ja,NTP,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 4,0:12:52.29,0:12:54.50,Default,,0,0,0,,Сауда, Зукен.
Dialogue: 1,0:12:52.31,0:12:54.08,JP-ja,NTP,0,0,0,,Бұл мәміле.
Dialogue: 4,0:12:54.92,0:12:59.00,Default,,0,0,0,,Мен осы келе жатқан соғыста Грейлді қайтарамын.
Dialogue: 1,0:12:54.93,0:12:58.51,JP-ja,NTP,0,0,0,,Мен келесі Қасиетті Граил соғысында Матуға Қасиетті Граалды қайтарамын.
Dialogue: 4,0:12:59.42,0:13:03.05,Default,,0,0,0,,Оның орнына сіз Тохсака Сакураны босатасыз.
Dialogue: 1,0:12:59.48,0:13:02.81,JP-ja,NTP,0,0,0,,Оның орнына Тохсака Сакураны босатыңыз.
Dialogue: 1,0:13:04.16,0:13:09.55,JP-ja,NTP,0,0,0,,Мені ақымақ деп атаңыз. Бүгінге дейін ешқандай жаттығу жасамаған тентек.
Dialogue: 4,0:13:04.22,0:13:05.76,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 4,0:13:06.05,0:13:09.85,Default,,0,0,0,,Сіз өміріңіздің бір күнін де жаттықтырмаған сәтсіз адамсыз.
Dialogue: 4,0:13:09.85,0:13:13.93,Default,,0,0,0,,Сіз бір жылдың ішінде Мастер боламын дейсіз бе?
Dialogue: 1,0:13:09.87,0:13:13.97,JP-ja,NTP,0,0,0,,Мен бар болғаны бір жылдың ішінде қызметші шебері болғым келеді.
Dialogue: 4,0:13:14.81,0:13:21.19,Default,,0,0,0,,Сізде қателерді жою дағдыларыңызбен мұны жүзеге асыру мүмкіндігіңіз бар.
Dialogue: 1,0:13:14.86,0:13:18.05,JP-ja,NTP,0,0,0,,Сізде мұны мүмкін ететін құпия техника бар шығар.
Dialogue: 1,0:13:18.44,0:13:21.09,JP-ja,NTP,0,0,0,,Жәндіктерді қолға үйретуші ретінде қандай ерекше дағдыларыңыз бар?
Dialogue: 1,0:13:25.36,0:13:27.51,JP-ja,NTP,0,0,0,,Маған «мөр басылған қате» отырғыз
Dialogue: 4,0:13:25.36,0:13:27.66,Default,,0,0,0,,Ішімдегі құрттарды имплантациялау.
Dialogue: 4,0:13:28.28,0:13:31.29,Default,,0,0,0,,Қария, өлгің келе ме?
Dialogue: 1,0:13:28.32,0:13:31.10,JP-ja,NTP,0,0,0,,Қария, өлгің келе ме?
Dialogue: 1,0:13:31.25,0:13:33.87,JP-ja,NTP,0,0,0,,Матудың құмарлығын Матудың қолдарымен орындауға болады.
Dialogue: 4,0:13:31.29,0:13:34.25,Default,,0,0,0,,Матус өз қалауын өздігінен орындай алады.
Dialogue: 4,0:13:34.25,0:13:36.79,Default,,0,0,0,,Мен бөгде адамдардың араласуына жол бермеймін.
Dialogue: 1,0:13:34.27,0:13:36.57,JP-ja,NTP,0,0,0,,Туысы жоқ адамдарды тартуға бола ма?
Dialogue: 4,0:13:38.21,0:13:42.30,Default,,0,0,0,,Мен үшін уайымдап жүргеніңді айтпа, әке?
Dialogue: 1,0:13:38.22,0:13:41.79,JP-ja,NTP,0,0,0,,Уайымдадым деп айта алмаймын, әке.
Dialogue: 1,0:13:44.75,0:13:48.48,JP-ja,NTP,0,0,0,,Мақсатың араласпау болса, Қария
Dialogue: 4,0:13:44.92,0:13:49.05,Default,,0,0,0,,Егер сіз оны бұл істен аулақ ұстауға тырыссаңыз, Қария...
Dialogue: 1,0:13:50.17,0:13:52.78,JP-ja,NTP,0,0,0,,Менің ойымша, сәл кеш болды.
Dialogue: 4,0:13:50.18,0:13:53.18,Default,,0,0,0,,...сәл кешігіп қалдыңыз.
Dialogue: 1,0:13:53.14,0:13:55.39,JP-ja,NTP,0,0,0,,Атам жол жоқ
Dialogue: 4,0:13:53.18,0:13:56.18,Default,,0,0,0,,Ей, кәрі бейбақ, саған болмайды...!
Dialogue: 4,0:13:59.27,0:14:04.44,Default,,0,0,0,,Алғашқы үш күнде ол қатты жылады.
Dialogue: 1,0:13:59.31,0:14:03.98,JP-ja,NTP,0,0,0,,Алғашқы үш күн көп жылау сияқты болды.
Dialogue: 1,0:14:05.00,0:14:08.30,JP-ja,NTP,0,0,0,,Төртінші күннен кейін мен дыбыс шығаруды қойдым.
Dialogue: 4,0:14:05.03,0:14:08.70,Default,,0,0,0,,Ол төртінші күні айқайлауын қойды.
Dialogue: 4,0:14:08.99,0:14:15.33,Default,,0,0,0,,Мен оның қанша уақытқа шыдайтынын көру үшін бүгін таңертең оны қоқыс бөлмесіне лақтырып жібердім.
Dialogue: 1,0:14:09.09,0:14:12.35,JP-ja,NTP,0,0,0,,Бүгін мен оны таң атқаннан мына жәндіктер қоймасына тастадым.
Dialogue: 1,0:14:12.51,0:14:15.05,JP-ja,NTP,0,0,0,,Мен оны қанша уақыт сақтай алатынымды көруге тырысамын.
Dialogue: 1,0:14:15.27,0:14:19.52,JP-ja,NTP,0,0,0,,Жәндіктер жарты күн азаптаған соң мен әлі тірімін.
Dialogue: 4,0:14:15.33,0:14:19.83,Default,,0,0,0,,Жарты күн бойы ренжіді, әлі де тыныстап жатыр.
Dialogue: 1,0:14:19.83,0:14:23.73,JP-ja,NTP,0,0,0,,Тохсақаның материалдары да қоқысқа тасталмайды.
Dialogue: 4,0:14:19.83,0:14:24.21,Default,,0,0,0,,Тосақтар шынымен де жаман емес.
Dialogue: 4,0:14:24.21,0:14:25.42,Default,,0,0,0,,Сакура...
Dialogue: 1,0:14:24.31,0:14:25.12,JP-ja,NTP,0,0,0,,Сакура
Dialogue: 1,0:14:25.26,0:14:27.04,JP-ja,NTP,0,0,0,,Енді не істеуіміз керек?
Dialogue: 4,0:14:25.42,0:14:27.26,Default,,0,0,0,,Ал, сен не істейсің?
Dialogue: 4,0:14:27.26,0:14:33.39,Default,,0,0,0,,Жалғыз сынық қыз, басынан аяғына дейін қателер бұзылған.
Dialogue: 1,0:14:27.28,0:14:30.62,JP-ja,NTP,0,0,0,,Мені басымнан аяғыма дейін жәндіктер зорлады.
Dialogue: 1,0:14:30.76,0:14:33.03,JP-ja,NTP,0,0,0,,Сынған кішкентай қыз
Dialogue: 4,0:14:33.39,0:14:36.48,Default,,0,0,0,,Егер сіз оны әлі де құтқарғыңыз келсе...
Dialogue: 1,0:14:33.45,0:14:36.53,JP-ja,NTP,0,0,0,,Егер сіз әлі де сақтағыңыз келсе
Dialogue: 1,0:14:36.96,0:14:39.27,JP-ja,NTP,0,0,0,,Бұл туралы ойлаудың қажеті жоқ.
Dialogue: 4,0:14:36.98,0:14:39.48,Default,,0,0,0,,Мен оны қарастырамын.
Dialogue: 4,0:14:39.48,0:14:40.94,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 1,0:14:39.49,0:14:40.25,JP-ja,NTP,0,0,0,,Менің еш қарсылығым жоқ.
Dialogue: 1,0:14:42.75,0:14:45.65,JP-ja,NTP,0,0,0,,Бірақ нәтиже алғанша.
Dialogue: 4,0:14:42.77,0:14:49.28,Default,,0,0,0,,Сен маған нәтиже көрсеткенше мен Сакураны оқытуды жалғастырамын.
Dialogue: 1,0:14:45.78,0:14:48.89,JP-ja,NTP,0,0,0,,Сакураның білімі жалғасады.
Dialogue: 1,0:14:49.19,0:14:53.62,JP-ja,NTP,0,0,0,,Менің сүйікті ісім бірінен соң бірі өтетін Қасиетті Граил соғысы.
Dialogue: 4,0:14:49.28,0:14:53.91,Default,,0,0,0,,Мен осыдан кейін де Грайл соғысында мақтау күтемін.
Dialogue: 4,0:14:53.91,0:14:58.50,Default,,0,0,0,,Бірақ егер сіз қандай да бір жолмен Grail-ді ала алсаңыз,
Dialogue: 1,0:14:53.93,0:14:58.19,JP-ja,NTP,0,0,0,,Дегенмен, егер сіз кездейсоқ Қасиетті Граалды алсаңыз,
Dialogue: 1,0:14:58.33,0:15:02.28,JP-ja,NTP,0,0,0,,Ол кезде, әрине, кішкентай қыз қолданылған.
Dialogue: 4,0:14:58.50,0:15:02.63,Default,,0,0,0,,онда мен кішкентай қызды бұдан былай пайдалана алмаймын.
Dialogue: 4,0:15:02.63,0:15:07.96,Default,,0,0,0,,Бұл жағдайда оның білімі бір жылдан кейін аяқталады.
Dialogue: 1,0:15:02.64,0:15:07.46,JP-ja,NTP,0,0,0,,Бұл білім бір жылдан кейін тоқтатылуы мүмкін.
Dialogue: 4,0:15:08.76,0:15:11.84,Default,,0,0,0,,Сөзіңнен қайтпайсың, солай ма, Мату Зукен?
Dialogue: 1,0:15:08.83,0:15:11.40,JP-ja,NTP,0,0,0,,Екі сөз жоқ. Мату Зукен
Dialogue: 1,0:15:11.81,0:15:15.62,JP-ja,NTP,0,0,0,,Алдымен бір апта бойы жәндіктерге арналған питомник болайық.
Dialogue: 4,0:15:11.84,0:15:15.81,Default,,0,0,0,,Бір апта бойы қателердің көбею алаңы ретінде қызмет етуден бастаңыз.
Dialogue: 1,0:15:15.77,0:15:21.49,JP-ja,NTP,0,0,0,,Өлмей қалсаң, байыпты екеніңді мойындаймын.
Dialogue: 4,0:15:15.81,0:15:21.81,Default,,0,0,0,,Жындылықтан өлмесең, онда мен сенің бұл іске шыншыл екеніңді мойындаймын.
Dialogue: 4,0:15:30.99,0:15:32.70,Default,,0,0,0,,Міне, осында.
Dialogue: 1,0:15:31.00,0:15:32.65,JP-ja,NTP,0,0,0,,Ол ақыры келді ме?
Dialogue: 4,0:15:34.70,0:15:36.20,Default,,0,0,0,,Қандай ақпарат?
Dialogue: 1,0:15:34.78,0:15:35.81,JP-ja,NTP,0,0,0,,Қандай жаңалық?
Dialogue: 4,0:15:36.20,0:15:39.83,Default,,0,0,0,,Бұл Лондон сағат мұнарасына жіберген барлаушылардың есебі.
Dialogue: 1,0:15:36.23,0:15:39.60,JP-ja,NTP,0,0,0,,Бұл Лондонға сағат мұнарасына енген адамдардың есебі.
Dialogue: 4,0:15:40.25,0:15:47.21,Default,,0,0,0,,Онда Грейль Сиқыршылар қауымдастығының ең жоғарғы билігі Сағат мұнарасынан Мастер таңдағаны айтылады.
Dialogue: 1,0:15:40.38,0:15:44.01,JP-ja,NTP,0,0,0,,Шамасы, Қасиетті Граил Сиқырлар қауымдастығының ең жоғары академиясы.
Dialogue: 1,0:15:44.50,0:15:47.18,JP-ja,NTP,0,0,0,,Шебер сағат мұнарасынан да таңдалған сияқты.
Dialogue: 4,0:15:47.21,0:15:48.26,Default,,0,0,0,,Кім?
Dialogue: 1,0:15:47.43,0:15:47.89,JP-ja,NTP,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 4,0:15:48.26,0:15:49.97,Default,,0,0,0,,Мазасыз адам.
Dialogue: 1,0:15:48.37,0:15:49.52,JP-ja,NTP,0,0,0,,Ол қиын адам.
Dialogue: 4,0:15:49.97,0:15:54.30,Default,,0,0,0,,Магидің тоғыз ұрпағын тудырған әйгілі Арчибальдтар отбасының үлкен ұлы.
Dialogue: 1,0:15:50.21,0:15:54.52,JP-ja,NTP,0,0,0,,Арчибальдтың үлкен ұлы, тоғыз ұрпақтан тұратын әйгілі сиқырлы отбасы.
Dialogue: 4,0:15:54.80,0:15:57.93,Default,,0,0,0,,Кейнет Эль-Меллои Арчибалд.
Dialogue: 1,0:15:54.91,0:15:57.65,JP-ja,NTP,0,0,0,,Кейнет Эль-Меллои Арчибальд
Dialogue: 0,0:15:58.47,0:16:06.94,Sign-Locations,,0,0,0,,Сағат мұнарасы, Лондон
Dialogue: 0,0:15:58.47,0:16:06.94,Sign-Locations,,0,0,0,,— Қазіргі күн —
Dialogue: 1,0:15:58.47,0:16:06.94,Sign-Locations,,0,0,0,,Сағат мұнарасы, Лондон
Dialogue: 1,0:15:58.47,0:16:06.94,Sign-Locations,,0,0,0,,— Қазіргі күн —
Dialogue: 4,0:16:00.85,0:16:06.94,Default,,0,0,0,,Магилер әлемінде қанның тегі негізінен адамның қабілетін анықтайды.
Dialogue: 1,0:16:00.96,0:16:06.80,JP-ja,NTP,0,0,0,,Сиқыр әлемінде адамның артықшылығы немесе кемдігі көбінесе оның тегіне байланысты.
Dialogue: 4,0:16:07.44,0:16:12.20,Default,,0,0,0,,Себебі, сиқырдың құпиясы бір ұрпақта ашыла алмайды.
Dialogue: 1,0:16:07.57,0:16:08.77,JP-ja,NTP,0,0,0,,Өйткені
Dialogue: 1,0:16:08.86,0:16:11.97,JP-ja,NTP,0,0,0,,Сиқырдың құпияларына бір ұрпақта жету мүмкін емес.
Dialogue: 4,0:16:12.20,0:16:17.45,Default,,0,0,0,,Ата-ана өмір бойы алған білімінің нәтижесін баласына береді.
Dialogue: 1,0:16:12.28,0:16:16.95,JP-ja,NTP,0,0,0,,Бұл ата-ананың өмір бойы алған тәрбиесінің жемісін балаларына жеткізуі үшін.
Dialogue: 4,0:16:17.45,0:16:22.33,Default,,0,0,0,,Сондықтан Магилер отбасы неғұрлым үлкен болса, соғұрлым олардың беделі жоғары болады.
Dialogue: 1,0:16:17.56,0:16:21.83,JP-ja,NTP,0,0,0,,Сондықтан ұрпақтары көп сиқырлы отбасының беделі көбірек.
Dialogue: 4,0:16:22.33,0:16:26.84,Default,,0,0,0,,Неліктен мен қарапайым нәрсені айтып жатырмын деп ойласаңыз,
Dialogue: 1,0:16:22.37,0:16:26.58,JP-ja,NTP,0,0,0,,Неліктен мұндай қарапайым әңгімеден бастау керек?
Dialogue: 4,0:16:26.84,0:16:31.88,Default,,0,0,0,,себебі бір студент маған осы қағазды бірнеше күн бұрын тапсырды.
Dialogue: 1,0:16:26.89,0:16:32.14,JP-ja,NTP,0,0,0,,Себебі өткен күні бір студент маған жұмыс тапсырды.
Dialogue: 4,0:16:33.18,0:16:37.14,Default,,0,0,0,,Бұл мақала «Жаңа ғасырда сиқыршылық қалай болуы керек» деп аталады.
Dialogue: 1,0:16:33.26,0:16:36.96,JP-ja,NTP,0,0,0,,Тақырыбы «Жаңа ғасырдағы сиқырлы жолға сұрақ»
Dialogue: 4,0:16:37.14,0:16:41.77,Default,,0,0,0,,Ол мен айтқан стандартты үлгіні толығымен жоққа шығарады.
Dialogue: 1,0:16:37.15,0:16:41.70,JP-ja,NTP,0,0,0,,Бұл мақалада мен айтып өткен ауыр сезімге қарсы тұр.
Dialogue: 1,0:16:42.38,0:16:45.16,JP-ja,NTP,0,0,0,,Хирургиялық әдістерді тереңірек түсіну және
Dialogue: 4,0:16:42.52,0:16:48.98,Default,,0,0,0,,Ол заклинаниелерді тереңірек түсіну және мананы неғұрлым нәзік бақылауды білдіреді
Dialogue: 1,0:16:45.52,0:16:48.73,JP-ja,NTP,0,0,0,,Сиқырды шебер қолдана алсаң
Dialogue: 1,0:16:48.96,0:16:52.57,JP-ja,NTP,0,0,0,,Туа біткен қабілеттегі айырмашылықтарды кез келген жолмен өтеуге болады.
Dialogue: 4,0:16:48.98,0:16:52.53,Default,,0,0,0,,бұл кемшілікті жеңуге мүмкіндік береді.
Dialogue: 4,0:16:53.15,0:16:59.29,Default,,0,0,0,,Басқаша айтқанда, қаны жұқа адам да шебер Сиқыршы бола алады.
Dialogue: 1,0:16:53.20,0:16:59.11,JP-ja,NTP,0,0,0,,Басқаша айтқанда, қаны таяздардың да бірінші дәрежелі сиқыршы бола алатынын үйретеді.
Dialogue: 4,0:16:59.29,0:17:03.00,Default,,0,0,0,,Шынымды айтсам, мен мұны оқып бірдеңе түсіндім.
Dialogue: 1,0:16:59.44,0:17:02.98,JP-ja,NTP,0,0,0,,Мен бұл қағазды оқығанда, шынымды айтсам, есіме түсті.
Dialogue: 4,0:17:03.20,0:17:04.79,Default,,0,0,0,,Тыныш.
Dialogue: 1,0:17:03.28,0:17:04.42,JP-ja,NTP,0,0,0,,Тыныш.
Dialogue: 4,0:17:06.96,0:17:08.59,Default,,0,0,0,,Мен мүмкіндігінше ашық айтайын.
Dialogue: 1,0:17:07.10,0:17:08.47,JP-ja,NTP,0,0,0,,Ашық сөйлеңіз
Dialogue: 4,0:17:08.59,0:17:12.09,Default,,0,0,0,,Бұл қағазда кәмелетке толмағандардың қиялынан басқа ештеңе жоқ.
Dialogue: 1,0:17:08.63,0:17:11.97,JP-ja,NTP,0,0,0,,Мұнда жазылғанның бәрі тек адасушылық.
Dialogue: 4,0:17:13.63,0:17:17.01,Default,,0,0,0,,Қан тегі сиқыршының күшін анықтайды.
Dialogue: 1,0:17:13.65,0:17:16.71,JP-ja,NTP,0,0,0,,Сиқырдың артықшылығы немесе кемдігі қан тегінің айырмашылығымен анықталады.
Dialogue: 4,0:17:17.01,0:17:19.97,Default,,0,0,0,,Бұл қатал, өзгермейтін шындық.
Dialogue: 1,0:17:17.08,0:17:19.99,JP-ja,NTP,0,0,0,,Бұл бұлтартпас факт
Dialogue: 4,0:17:21.27,0:17:23.14,Default,,0,0,0,,Вавер Бархат-кун.
Dialogue: 1,0:17:21.36,0:17:23.36,JP-ja,NTP,0,0,0,,Waver Velvet
Dialogue: 4,0:17:23.68,0:17:29.40,Default,,0,0,0,,Менің бір оқушымның бұл бос сөзге ергені мені қатты ренжітті.
Dialogue: 1,0:17:23.77,0:17:27.31,JP-ja,NTP,0,0,0,,Менің кейбір оқушыларымның мұндай адасушылықтары барын білмедім.
Dialogue: 1,0:17:27.57,0:17:29.27,JP-ja,NTP,0,0,0,,Шынымен өкінішті
Dialogue: 1,0:17:29.34,0:17:34.53,JP-ja,NTP,0,0,0,,Мұғалім, мен қазіргі ескі сиқыршылар қауымдастығына қатысты мәселе көтергім келеді.
Dialogue: 4,0:17:29.40,0:17:34.65,Default,,0,0,0,,Бірақ мырза, мен тек Сиқыршылар қауымдастығы келіспей жүрген сұрақты ғана шешуге тырыстым...
Dialogue: 1,0:17:34.63,0:17:35.97,JP-ja,NTP,0,0,0,,Уэйвер мырза
Dialogue: 4,0:17:34.65,0:17:35.65,Default,,0,0,0,,Вавер-кун.
Dialogue: 4,0:17:36.32,0:17:42.16,Default,,0,0,0,,Сіздің отбасыңыз магилердің тек үш ұрпағын шығарды, солай ма?
Dialogue: 1,0:17:36.34,0:17:42.21,JP-ja,NTP,0,0,0,,Егер есімде дұрыс болса, сіздің отбасыңыздың сиқыршылар тегі үш ұрпаққа ғана жалғасты.
Dialogue: 4,0:17:42.79,0:17:44.29,Default,,0,0,0,,Мені тыңда.
Dialogue: 1,0:17:42.86,0:17:46.47,JP-ja,NTP,0,0,0,,Тыңдаңыз, егер сіз сиқырлы қауымдастықтың тарихына қарасаңыз,
Dialogue: 4,0:17:44.29,0:17:50.34,Default,,0,0,0,,Сиқыршылар қауымдастығының тарихымен салыстырғанда сіздің отбасыңыз жаңа туған нәресте ғана.
Dialogue: 1,0:17:46.58,0:17:50.09,JP-ja,NTP,0,0,0,,Үйің жаңа туған нәрестедей.
Dialogue: 4,0:17:50.34,0:17:55.17,Default,,0,0,0,,Сәбиге ата-анасынан сұрақ қоймас бұрын сөйлеуді үйрену керек емес пе?
Dialogue: 1,0:17:50.36,0:17:51.89,JP-ja,NTP,0,0,0,,Ата-анаңа өз пікіріңді айтпас бұрын
Dialogue: 1,0:17:52.15,0:17:54.69,JP-ja,NTP,0,0,0,,Менің ойымша, алдымен сөздерді үйренуіміз керек.
Dialogue: 4,0:17:57.01,0:17:59.30,Default,,0,0,0,,Ол мені мазақ қылады!
Dialogue: 1,0:17:57.04,0:18:00.39,JP-ja,NTP,0,0,0,,Мені мазақ ет мені мазақ қыл
Dialogue: 4,0:17:59.30,0:18:00.30,Default,,0,0,0,,Оның қалай батылы барды!
Dialogue: 4,0:18:00.30,0:18:02.68,Default,,0,0,0,,Лектор осылай әрекет ету керек пе?!
Dialogue: 1,0:18:00.56,0:18:02.36,JP-ja,NTP,0,0,0,,Лектор осылай істей ме?
Dialogue: 4,0:18:02.68,0:18:05.57,Default,,0,0,0,,Ол менің қағазымды оқып, қызғанып кетті!
Dialogue: 1,0:18:02.73,0:18:05.30,JP-ja,NTP,0,0,0,,Ол менің қағазымды оқып, қызғанып кетті.
Dialogue: 1,0:18:05.54,0:18:07.24,JP-ja,NTP,0,0,0,,Ол менің талантымнан қорықты.
Dialogue: 4,0:18:05.57,0:18:07.77,Default,,0,0,0,,Ол менің талантымнан қорқады!
Dialogue: 4,0:18:07.77,0:18:10.02,Default,,0,0,0,,Сондықтан ол мені жұрттың алдында ұятқа қалдырды!
Dialogue: 1,0:18:07.81,0:18:09.78,JP-ja,NTP,0,0,0,,Сондықтан мен бәрінің көзінше солай істеп жүрмін.
Dialogue: 4,0:18:12.67,0:18:14.32,Default,,0,0,0,,Мұнда.
Dialogue: 1,0:18:12.68,0:18:15.21,JP-ja,NTP,0,0,0,,Ах, мен оны аяқтай алмаймын. Сенімен бәрі жақсы ма?
Dialogue: 4,0:18:14.32,0:18:15.36,Default,,0,0,0,,Қандай сәнсіз...
Dialogue: 1,0:18:15.66,0:18:16.96,JP-ja,NTP,0,0,0,,Иә Жоқ
Dialogue: 4,0:18:15.69,0:18:17.32,Default,,0,0,0,,Мен-жақсымын.
Dialogue: 4,0:18:17.32,0:18:20.62,Default,,0,0,0,,Сіз Некромансер үйірмесінің студенті емессіз бе?
Dialogue: 1,0:18:18.03,0:18:21.70,JP-ja,NTP,0,0,0,,Сіз некромантиканың студентісіз бе? Дәріс қалай өтті?
Dialogue: 4,0:18:20.62,0:18:22.08,Default,,0,0,0,,Сен неге сабақта жоқсың?
Dialogue: 4,0:18:22.08,0:18:23.83,Default,,0,0,0,,Ал...
Dialogue: 1,0:18:22.25,0:18:23.28,JP-ja,NTP,0,0,0,,О, дұрыс.
Dialogue: 4,0:18:24.33,0:18:27.29,Default,,0,0,0,,П-профессор Арчибальд маған тапсырма орындауымды өтінді.
Dialogue: 1,0:18:24.52,0:18:26.89,JP-ja,NTP,0,0,0,,Профессор Арчибалд маған тапсырма орындауымды өтінді.
Dialogue: 4,0:18:27.29,0:18:29.71,Default,,0,0,0,,Мен асығыс едім, сондықтан...
Dialogue: 1,0:18:27.52,0:18:28.75,JP-ja,NTP,0,0,0,,Сондықтан асығыңыз
Dialogue: 4,0:18:29.71,0:18:30.79,Default,,0,0,0,,Б... бір сызық
Dialogue: 1,0:18:29.88,0:18:31.92,JP-ja,NTP,0,0,0,,Түсіндім, бұл дұрыс болды.
Dialogue: 4,0:18:30.79,0:18:32.09,Default,,0,0,0,,Бұл тамаша.
Dialogue: 4,0:18:32.09,0:18:34.77,Default,,0,0,0,,Мұны профессор Арчибальдқа бере аласыз ба?
Dialogue: 1,0:18:32.14,0:18:34.72,JP-ja,NTP,0,0,0,,Мұны профессор Арчибальдқа жеткізе аласыз ба?
Dialogue: 4,0:18:37.05,0:18:38.93,Default,,0,0,0,,Бұл?
Dialogue: 1,0:18:37.18,0:18:38.67,JP-ja,NTP,0,0,0,,Бұл ма?
Dialogue: 4,0:18:39.26,0:18:40.47,Default,,0,0,0,,Хиёри, қош келдің.
Dialogue: 1,0:18:39.51,0:18:41.99,JP-ja,NTP,0,0,0,,Маңызды болып көрінгендіктен сұрадым.
Dialogue: 4,0:18:40.47,0:18:42.22,Default,,0,0,0,,Бұл маңызды нәрсе сияқты.
Dialogue: 4,0:18:42.76,0:18:44.31,Default,,0,0,0,,Маңызды ма?
Dialogue: 1,0:18:42.86,0:18:43.75,JP-ja,NTP,0,0,0,,Маңызды нәрселер
Dialogue: 4,0:18:45.18,0:18:48.35,Default,,0,0,0,,Македониядан жіберілген...
Dialogue: 1,0:18:45.28,0:18:48.96,JP-ja,NTP,0,0,0,,Македониядан жіберілді
Dialogue: 4,0:18:55.48,0:18:56.57,Default,,0,0,0,,Сен шынымен де мазаңды аларсың, иә?
Dialogue: 1,0:18:55.52,0:18:56.54,JP-ja,NTP,0,0,0,,Міне, осы
Dialogue: 4,0:18:57.32,0:19:05.45,Default,,0,0,0,,Кейнеттің қандай да бір Қиыр Шығыс сиқырлы турнирінде жұдырықтасады деген қауесеттер рас еді.
Dialogue: 1,0:18:57.52,0:18:58.82,JP-ja,NTP,0,0,0,,Кейнеттің жігіті
Dialogue: 1,0:18:58.98,0:19:03.94,JP-ja,NTP,0,0,0,,Жақында Қиыр Шығыста өтетін сиқырлы жарысқа қатысады деген қауесет бар.
Dialogue: 1,0:19:04.09,0:19:05.29,JP-ja,NTP,0,0,0,,Бұл рас болды.
Dialogue: 4,0:19:10.29,0:19:11.88,Default,,0,0,0,,Қасиетті Граил соғысы.
Dialogue: 1,0:19:10.48,0:19:11.86,JP-ja,NTP,0,0,0,,Қасиетті Граил соғысы
Dialogue: 4,0:19:12.88,0:19:16.38,Default,,0,0,0,,Екі жүз жыл бұрын негізін қалаушы үштік деп аталатын отбасылар,
Dialogue: 1,0:19:12.99,0:19:16.15,JP-ja,NTP,0,0,0,,200 жыл бұрын Бастаудың үш тұқымдастығын атады
Dialogue: 1,0:19:16.38,0:19:18.88,JP-ja,NTP,0,0,0,,Эйнцберн Мату Тохсака
Dialogue: 4,0:19:16.38,0:19:19.43,Default,,0,0,0,,Эйнцберн, Макири және Тохсака,
Dialogue: 4,0:19:19.43,0:19:27.14,Default,,0,0,0,,Қасиетті Граильді сәтті шақыру үшін бірге жұмыс істеді, кез келген тілекті орындауға күші бар деді.
Dialogue: 1,0:19:19.51,0:19:22.47,JP-ja,NTP,0,0,0,,Сиқыршылардың үш отауы бір-бірімен ынтымақтасады.
Dialogue: 1,0:19:22.79,0:19:27.12,JP-ja,NTP,0,0,0,,Кез келген тілекті орындай алатын Қасиетті Граильді шақыра алды.
Dialogue: 1,0:19:28.35,0:19:33.24,JP-ja,NTP,0,0,0,,Бірақ Қасиетті Граил тек бір дұғаны қабылдайды.
Dialogue: 4,0:19:28.35,0:19:33.69,Default,,0,0,0,,Алайда Қасиетті Граил тек бір дұғаға жауап береді.
Dialogue: 4,0:19:34.23,0:19:39.32,Default,,0,0,0,,Ал олардың ынтымақтастығы қанды шайқасқа ұласты.
Dialogue: 1,0:19:34.37,0:19:38.61,JP-ja,NTP,0,0,0,,Ынтымақтастық қанды қақтығысқа айналды
Dialogue: 4,0:19:39.32,0:19:42.03,Default,,0,0,0,,Қасиетті Граил соғыстары осылай басталды.
Dialogue: 1,0:19:39.56,0:19:41.94,JP-ja,NTP,0,0,0,,Бұл Қасиетті Граил соғысының басталуы
Dialogue: 4,0:19:42.74,0:19:48.45,Default,,0,0,0,,Содан бері алпыс жылда бір рет Қасиетті Граил Фуюки қаласында пайда болады.
Dialogue: 1,0:19:42.92,0:19:45.75,JP-ja,NTP,0,0,0,,Содан бері алпыс жылда бір рет
Dialogue: 1,0:19:45.84,0:19:48.33,JP-ja,NTP,0,0,0,,Қасиетті Граил Фуюки еліне оралады
Dialogue: 4,0:19:48.45,0:19:53.29,Default,,0,0,0,,Ол оны ұстау құқығымен жеті Магиді таңдап, оларға билік береді
Dialogue: 1,0:19:48.53,0:19:53.32,JP-ja,NTP,0,0,0,,Оны алуға өкілеттігі бар жеті сиқыршыны таңда.
Dialogue: 4,0:19:54.17,0:19:58.55,Default,,0,0,0,,Қызметшілер деп аталатын күшті батырлық рухтарды шақыру.
Dialogue: 1,0:19:54.39,0:19:58.08,JP-ja,NTP,0,0,0,,Қызметшілер деп аталатын батырлық рухтарды шақыруға мүмкіндік береді.
Dialogue: 4,0:19:59.84,0:20:00.88,Default,,0,0,0,,Садақшы.
Dialogue: 1,0:20:00.01,0:20:00.44,JP-ja,NTP,0,0,0,,Садақшы
Dialogue: 4,0:20:00.88,0:20:02.01,Default,,0,0,0,,Сабер.
Dialogue: 1,0:20:01.16,0:20:01.87,JP-ja,NTP,0,0,0,,Сабер
Dialogue: 4,0:20:02.01,0:20:03.26,Default,,0,0,0,,Лансер.
Dialogue: 1,0:20:02.26,0:20:02.95,JP-ja,NTP,0,0,0,,Лансер
Dialogue: 4,0:20:03.26,0:20:04.22,Default,,0,0,0,,Шабандоз.
Dialogue: 1,0:20:03.36,0:20:03.97,JP-ja,NTP,0,0,0,,Шабандоз
Dialogue: 4,0:20:04.22,0:20:05.39,Default,,0,0,0,,Ассасин.
Dialogue: 1,0:20:04.46,0:20:05.09,JP-ja,NTP,0,0,0,,Ассасин
Dialogue: 4,0:20:05.39,0:20:06.51,Default,,0,0,0,,Кастер.
Dialogue: 1,0:20:05.56,0:20:06.29,JP-ja,NTP,0,0,0,,Кастер
Dialogue: 4,0:20:06.51,0:20:08.14,Default,,0,0,0,,Берсеркер.
Dialogue: 1,0:20:06.61,0:20:07.39,JP-ja,NTP,0,0,0,,Берсеркер
Dialogue: 1,0:20:08.67,0:20:12.13,JP-ja,NTP,0,0,0,,Жеті сыныпқа тағайындалған қызметшілер шек болып табылады
Dialogue: 4,0:20:08.68,0:20:19.40,Default,,0,0,0,,Осы жеті сыныпқа бөлінген Қызметшілер Грейлді жеңуге кім лайық екенін анықтау үшін өлгенше күреседі.
Dialogue: 1,0:20:12.93,0:20:19.03,JP-ja,NTP,0,0,0,,Жеті адамның қайсысы Қасиетті Граил болуға лайықты екені өліммен аяқталатын шайқаста шешіледі.
Dialogue: 4,0:20:23.11,0:20:30.83,Default,,0,0,0,,Сонымен, Қасиетті Граил соғысы - бұл атақ пен ықпалдың ештеңені білдірмейтін таза қабілет шайқасы.
Dialogue: 1,0:20:23.24,0:20:27.27,JP-ja,NTP,0,0,0,,Қасиетті Граил соғысы атақ пен билікке мұқтаж емес.
Dialogue: 1,0:20:27.61,0:20:30.48,JP-ja,NTP,0,0,0,,Бұл нағыз қабілет бәсекесі ме?
Dialogue: 4,0:20:31.54,0:20:34.50,Default,,0,0,0,,Бұл мен үшін тамаша сахна.
Dialogue: 1,0:20:31.77,0:20:33.98,JP-ja,NTP,0,0,0,,Бұл мен үшін тамаша сахна емес пе?
Dialogue: 4,0:20:36.21,0:20:42.63,Default,,0,0,0,,Сондай-ақ бұл қызметшінің реликті оларды шақыру үшін катализатор ретінде қажет екенін айтады.
Dialogue: 1,0:20:36.38,0:20:42.55,JP-ja,NTP,0,0,0,,Ей, қызметшіні шақыру үшін катализатор ретінде батырлық рухтың реликті қажет.
Dialogue: 4,0:20:43.63,0:20:45.09,Default,,0,0,0,,Реликт...
Dialogue: 1,0:20:43.67,0:20:44.63,JP-ja,NTP,0,0,0,,Қасиетті жәдігерлер
Dialogue: 1,0:21:15.50,0:21:18.34,JP-ja,NTP,0,0,0,,Қанша көрсем де, көлеңкелі қулық.
Dialogue: 4,0:21:15.50,0:21:18.59,Default,,0,0,0,,Бұл құрылғы әлі күнге дейін маған ұнамсыз болып көрінеді.
Dialogue: 4,0:21:19.00,0:21:21.30,Default,,0,0,0,,Менде Сағат мұнарасынан хабар бар.
Dialogue: 1,0:21:19.23,0:21:20.93,JP-ja,NTP,0,0,0,,Сағат мұнарасынан репортаж.
Dialogue: 4,0:21:21.30,0:21:25.26,Default,,0,0,0,,Лорд Эль-Меллои тағы бір реликтке ие болды, шамасы.
Dialogue: 1,0:21:21.45,0:21:24.97,JP-ja,NTP,0,0,0,,Лорд Эль-Меллои жаңа жәдігерге ие болған сияқты.
Dialogue: 1,0:21:25.82,0:21:28.46,JP-ja,NTP,0,0,0,,Қазір оның қатысуы расталған сияқты.
Dialogue: 4,0:21:25.84,0:21:28.68,Default,,0,0,0,,Оның қатысуы қазір анық.
Dialogue: 4,0:21:29.05,0:21:32.81,Default,,0,0,0,,Мені екі бос орын әлі есепке алынбағаны мазалайды.
Dialogue: 1,0:21:29.16,0:21:32.73,JP-ja,NTP,0,0,0,,Екі орындықтың әлі де бос болуы қорқынышты.
Dialogue: 4,0:21:32.81,0:21:34.10,Default,,0,0,0,,Не бұл, Хиёри? Жаңа жылдық әзіл ме?
Dialogue: 1,0:21:33.07,0:21:37.34,JP-ja,NTP,0,0,0,,Уақыты келгенде Қасиетті Граил жеті адамды сапасына қарамай дайындайды.
Dialogue: 4,0:21:34.10,0:21:37.81,Default,,0,0,0,,Grail шеберлігіне қарамастан, уақыты келгенде жеті адамды таңдайды.
Dialogue: 4,0:21:37.81,0:21:42.82,Default,,0,0,0,,Топты толықтыратындар әрқашан дерлік әлсіз.
Dialogue: 1,0:21:37.92,0:21:42.52,JP-ja,NTP,0,0,0,,Ақырында, адам санын ескерсек, бұл негізінен ұсақ заттар.
Dialogue: 4,0:21:42.82,0:21:44.40,Default,,0,0,0,,Олар үшін алаңдаудың қажеті жоқ.
Dialogue: 1,0:21:42.98,0:21:44.36,JP-ja,NTP,0,0,0,,Дабыл қағудың қажеті жоқ
Dialogue: 4,0:21:45.15,0:21:47.78,Default,,0,0,0,,Ең бастысы, Кирей.
Dialogue: 1,0:21:45.22,0:21:47.39,JP-ja,NTP,0,0,0,,Сақтыққа келгенде, Кирей
Dialogue: 4,0:21:47.78,0:21:51.03,Default,,0,0,0,,Сіздің сарайға кіргеніңізді ешкім көрмеді, солай ма?
Dialogue: 1,0:21:47.90,0:21:50.74,JP-ja,NTP,0,0,0,,Бұл сарайға кіргеніңді ешкім көрмейді деп ойлаймын.
Dialogue: 4,0:21:51.03,0:21:52.87,Default,,0,0,0,,Не бұл, Хиёри? Жаңа жылдық әзіл ме?
Dialogue: 1,0:21:51.20,0:21:54.40,JP-ja,NTP,0,0,0,,Уайымдамаңыз, көрінетін немесе көрінбейтін.
Dialogue: 4,0:21:52.87,0:21:58.92,Default,,0,0,0,,Бұл сарайды бақылап тұрған көрінетін немесе көрінбейтін таныс немесе сиқырлы құрылғылар жоқ.
Dialogue: 1,0:21:54.76,0:21:58.28,JP-ja,NTP,0,0,0,,Бұл сарайды бақылайтын таныстар немесе сиқырлы құрылғылар жоқ.
Dialogue: 4,0:21:58.92,0:21:59.88,Default,,0,0,0,,Ой, Хиёри-я! Жаңа жылды әзілмен бастап жатырсың ғой, иә?
Dialogue: 1,0:21:59.08,0:21:59.63,JP-ja,NTP,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 4,0:21:59.88,0:22:02.21,Default,,0,0,0,,Мен кепілдік беремін.
Dialogue: 1,0:21:59.98,0:22:02.26,JP-ja,NTP,0,0,0,,Мен бұған кепілдік беремін
Dialogue: 4,0:22:03.63,0:22:10.89,Default,,0,0,0,,Қандай айла қолданса да, стратегиялардың батырлық рухы Хасанның көзін ешкім алдай алмайды.
Dialogue: 1,0:22:03.80,0:22:05.80,JP-ja,NTP,0,0,0,,Қандай қулық жасасаңыз да
Dialogue: 1,0:22:05.88,0:22:10.41,JP-ja,NTP,0,0,0,,Ақылдың ерлік рухы ретінде мен Хасанды алдай алмаймын.
Dialogue: 4,0:22:10.89,0:22:15.93,Default,,0,0,0,,Ұстазымның соңынан ерген ешкімнің ізі жоқ.
Dialogue: 1,0:22:11.03,0:22:15.43,JP-ja,NTP,0,0,0,,Қазіргі уақытта Мастер тарапынан ешқандай қудалау белгісі жоқ.
Dialogue: 4,0:22:16.77,0:22:19.65,Default,,0,0,0,,Сенімді болыңыз.
Dialogue: 1,0:22:16.81,0:22:19.32,JP-ja,NTP,0,0,0,,Сенімді болыңыз.
Dialogue: 4,0:22:19.65,0:22:25.40,Default,,0,0,0,,Қызметші шақырылса, әкем сөзсіз біледі.
Dialogue: 1,0:22:19.86,0:22:25.31,JP-ja,NTP,0,0,0,,Егер Қасиетті Граилға шақырылған қызметші пайда болса, хабар міндетті түрде оның әкесіне беріледі.
Dialogue: 1,0:22:25.92,0:22:30.31,JP-ja,NTP,0,0,0,,Басқа сиқыршылар әрекет ету үшін көп уақыт өтуі мүмкін.
Dialogue: 4,0:22:25.94,0:22:30.95,Default,,0,0,0,,Басқа Маги біраз уақыт әрекет етпейді.
Dialogue: 4,0:22:30.95,0:22:33.16,Default,,0,0,0,,Ассасин, баруға болады.
Dialogue: 1,0:22:31.10,0:22:32.85,JP-ja,NTP,0,0,0,,Assassin Бұл жер жеткілікті
Dialogue: 4,0:22:33.16,0:22:35.66,Default,,0,0,0,,Айналадағы аумақты күзетуді жалғастырыңыз.
Dialogue: 1,0:22:33.29,0:22:35.18,JP-ja,NTP,0,0,0,,Сыртта қырағы болыңыз.
Dialogue: 1,0:22:35.65,0:22:36.48,JP-ja,NTP,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 4,0:22:35.66,0:22:36.87,Default,,0,0,0,,Қалауыңызша.
Dialogue: 4,0:22:38.75,0:22:40.96,Default,,0,0,0,,Бұл тек уақыт мәселесі.
Dialogue: 1,0:22:38.97,0:22:40.62,JP-ja,NTP,0,0,0,,Бірақ бұл тек уақыт мәселесі
Dialogue: 4,0:22:41.67,0:22:48.34,Default,,0,0,0,,Бұл сарайдың алаңы жақын арада басқа Мастерлердің таныстарымен бірге өмір сүреді.
Dialogue: 1,0:22:41.84,0:22:45.84,JP-ja,NTP,0,0,0,,Бір күні осы сарайдың айналасында басқа шеберлер шығарған таныс рухтар болады.
Dialogue: 1,0:22:45.95,0:22:48.09,JP-ja,NTP,0,0,0,,Сіз абдырап қаласыз
Dialogue: 4,0:22:49.30,0:22:49.97,Default,,0,0,0,,түн
Dialogue: 1,0:22:49.47,0:22:50.01,JP-ja,NTP,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 4,0:22:50.30,0:22:52.35,Default,,0,0,0,,Басқа мәселе.
Dialogue: 1,0:22:50.52,0:22:52.00,JP-ja,NTP,0,0,0,,Жеке тергеуде.
Dialogue: 4,0:22:52.85,0:22:56.98,Default,,0,0,0,,Мен Эйнцберн шебері туралы ақпарат жинадым.
Dialogue: 1,0:22:53.02,0:22:56.80,JP-ja,NTP,0,0,0,,Мен Эйнцберн шебері туралы ақпарат жинадым.
Dialogue: 4,0:22:57.77,0:23:03.73,Default,,0,0,0,,Тоғыз жыл бұрын өздерінің таза қанымен мақтанышпен танымал Эйнцберндер,
Dialogue: 1,0:22:57.88,0:23:00.05,JP-ja,NTP,0,0,0,,Міне, тоғыз жылдай уақыт өтті.
Dialogue: 1,0:23:00.90,0:23:03.43,JP-ja,NTP,0,0,0,,Эйнцберндер өздерінің таза қанды тегін мақтан тұтты.
Dialogue: 4,0:23:04.11,0:23:07.82,Default,,0,0,0,,Сиқыршыны отбасынан тыс күтпеген жерден қарсы алды.
Dialogue: 1,0:23:04.25,0:23:07.40,JP-ja,NTP,0,0,0,,Сырттан келген сиқыршыны кенет күйеу бала етіп алды.
Dialogue: 4,0:23:09.82,0:23:16.08,Default,,0,0,0,,Эйнцберн магилері тек алхимияға маманданған, сондықтан оларды шайқасқа жарамсыз етті.
Dialogue: 1,0:23:09.99,0:23:13.78,JP-ja,NTP,0,0,0,,Эйнцберндер отбасының сиқыршысы алғашында алхимияға маманданған.
Dialogue: 1,0:23:14.03,0:23:15.36,JP-ja,NTP,0,0,0,,Дөрекі төсеу үшін жарамсыз
Dialogue: 4,0:23:16.08,0:23:20.42,Default,,0,0,0,,Сол себепті олар бұрынғы Қасиетті Граил соғыстарында жеңілді.
Dialogue: 1,0:23:16.27,0:23:19.63,JP-ja,NTP,0,0,0,,Өткен Қасиетті Граил соғысындағы жеңілуіміздің себебі де осы болды.
Dialogue: 4,0:23:20.42,0:23:23.50,Default,,0,0,0,,Олардың шыдамдары таусылған болуы керек.
Dialogue: 1,0:23:20.61,0:23:23.30,JP-ja,NTP,0,0,0,,Менің ойымша, сондықтан олар ақыры одан шаршады.
Dialogue: 4,0:23:24.09,0:23:28.47,Default,,0,0,0,,Олар таңдаған Сиқыршы рөлге өте ыңғайлы болды.
Dialogue: 1,0:23:24.37,0:23:28.24,JP-ja,NTP,0,0,0,,Шақырылған сиқыршы: «Түсіндім» деген адам.
Dialogue: 4,0:23:31.13,0:23:33.01,Default,,0,0,0,,Эмия Кирицугу.
Dialogue: 1,0:23:31.36,0:23:32.62,JP-ja,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 4,0:23:34.47,0:23:36.97,Default,,0,0,0,,Сиқыршы өлтіруші ретінде белгілі адам.
Dialogue: 1,0:23:34.58,0:23:36.76,JP-ja,NTP,0,0,0,,Оны «Сиқыршы өлтіруші» деп атаған.
Dialogue: 1,0:23:42.94,0:23:46.85,JP-ja,NTP,0,0,0,,Біз Корнуоллда біраз уақыт зерттеген қасиетті жәдігерлер
Dialogue: 4,0:23:42.94,0:23:48.82,Default,,0,0,0,,Біз Корнуоллдан көптен бері іздеген реликті ақыры табылды.
Dialogue: 1,0:23:47.05,0:23:48.63,JP-ja,NTP,0,0,0,,Ақыры табылды
Dialogue: 4,0:23:48.82,0:23:56.49,Default,,0,0,0,,Егер сіз оны катализатор ретінде қолдансаңыз, қызметшілердің ең күштісі болып табылатын қылыш ұстаған Батырлық Рухты шақыра аласыз.
Dialogue: 1,0:23:48.88,0:23:50.35,JP-ja,NTP,0,0,0,,Егер біз оны орта ретінде қолдансақ
Dialogue: 1,0:23:50.56,0:23:53.49,JP-ja,NTP,0,0,0,,Қылыштың қаһармандық рухын қанша елестете аламын.
Dialogue: 1,0:23:53.72,0:23:56.49,JP-ja,NTP,0,0,0,,Ең күшті қызметші шақырылады
Dialogue: 4,0:23:56.78,0:23:58.24,Default,,0,0,0,,Кирицугу.
Dialogue: 1,0:23:56.95,0:23:57.76,JP-ja,NTP,0,0,0,,Кирицугу
Dialogue: 4,0:23:58.24,0:24:03.92,Default,,0,0,0,,Бұл Эйнцберндердің сізге бере алатын ең үлкен көмегі.
Dialogue: 1,0:23:58.26,0:24:03.09,JP-ja,NTP,0,0,0,,Мұны Эйнцберннің сізге жасаған ең үлкен көмегі деп санаңыз.
Dialogue: 4,0:24:03.92,0:24:06.38,Default,,0,0,0,,Ардақтымын, ақсақал.
Dialogue: 1,0:24:04.02,0:24:06.20,JP-ja,NTP,0,0,0,,Ауырды, мырза.
Dialogue: 4,0:24:06.38,0:24:10.05,Default,,0,0,0,,Бұл жолы тірі қалғандар болмауы керек.
Dialogue: 1,0:24:06.58,0:24:09.40,JP-ja,NTP,0,0,0,,Дәл осы жолы бір адамды да қалдырмаңыз.
Dialogue: 1,0:24:09.94,0:24:12.43,JP-ja,NTP,0,0,0,,Барлық алты қызметшіні аңды
Dialogue: 4,0:24:10.05,0:24:16.64,Default,,0,0,0,,Қалған алты қызметшіні өлтіріп, үшінші шынайы сиқырды, «Аспан сезімін» аяқтаңыз.
Dialogue: 1,0:24:12.74,0:24:16.59,JP-ja,NTP,0,0,0,,Үшінші сиқырға, аспан тостағанына міндетті түрде қол жеткізіңіз.
Dialogue: 4,0:24:17.22,0:24:17.89,Default,,0,0,0,,Бір қолымда оқпен зарядталған винтовка
Dialogue: 1,0:24:17.31,0:24:17.69,JP-ja,NTP,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 4,0:24:19.81,0:24:21.89,Default,,0,0,0,,Эмия Кирицугу...
Dialogue: 1,0:24:19.85,0:24:21.41,JP-ja,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 4,0:24:21.89,0:24:24.89,Default,,0,0,0,,Мен бұл есімді білемін.
Dialogue: 1,0:24:21.97,0:24:24.51,JP-ja,NTP,0,0,0,,Бұл атау таныс сияқты.
Dialogue: 4,0:24:24.89,0:24:28.69,Default,,0,0,0,,Сонда тіпті шіркеу ол туралы естіді ме?
Dialogue: 1,0:24:26.00,0:24:28.49,JP-ja,NTP,0,0,0,,Собор шіркеуінде де жаңғырықты ма?
Dialogue: 4,0:24:29.69,0:24:34.11,Default,,0,0,0,,Сиқыршы өлтіруші Эмиия өз уақытында өте беделге ие болды.
Dialogue: 1,0:24:29.79,0:24:31.83,JP-ja,NTP,0,0,0,,Сиқыршы өлтіруші Эмиия туралы айту
Dialogue: 1,0:24:31.97,0:24:33.78,JP-ja,NTP,0,0,0,,Ол кезде өте жаман болды.
Dialogue: 4,0:24:34.65,0:24:38.45,Default,,0,0,0,,Сырттай қарағанда, ол қауымдастыққа кірмейтін бидғатшы еді.
Dialogue: 1,0:24:34.78,0:24:38.23,JP-ja,NTP,0,0,0,,Ол Сиқырлы шіркеуге жатпайтын, сырттан шыққан адам болғанымен.
Dialogue: 4,0:24:38.82,0:24:43.54,Default,,0,0,0,,Алайда жоғарыдағылар оны өз мақсаттары үшін өте пайдалы деп тапты.
Dialogue: 1,0:24:38.99,0:24:43.44,JP-ja,NTP,0,0,0,,Жоғарғы жақтағылар оны әртүрлі мақсатта пайдаланған сияқты.
Dialogue: 4,0:24:43.54,0:24:48.63,Default,,0,0,0,,Бізге ұқсас Шіркеу орындаушылары?
Dialogue: 1,0:24:43.59,0:24:46.09,JP-ja,NTP,0,0,0,,Біз соборлық шіркеуде айтқандай
Dialogue: 1,0:24:46.25,0:24:48.26,JP-ja,NTP,0,0,0,,Агент сияқты ма?
Dialogue: 4,0:24:48.63,0:24:50.42,Default,,0,0,0,,Нашар.
Dialogue: 1,0:24:48.64,0:24:50.14,JP-ja,NTP,0,0,0,,Одан да сорақы
Dialogue: 4,0:24:50.42,0:24:56.84,Default,,0,0,0,,Ол негізінен Магиді өлтіруге маманданған штаттан тыс өлтіруші.
Dialogue: 1,0:24:50.50,0:24:53.67,JP-ja,NTP,0,0,0,,Бұл адам тек сиқыршыларға ғана маманданған.
Dialogue: 1,0:24:53.90,0:24:56.52,JP-ja,NTP,0,0,0,,Бұл штаттан тыс өлтіруші сияқты.
Dialogue: 4,0:24:56.84,0:25:03.10,Default,,0,0,0,,Ол Магиді жақсы түсінеді, сондықтан оларды сиқыршылыққа ұқсамайтын тәсілдермен аңдыды.
Dialogue: 1,0:24:56.93,0:24:58.35,JP-ja,NTP,0,0,0,,Өйткені мен сиқыршыны білемін
Dialogue: 1,0:24:58.60,0:25:01.14,JP-ja,NTP,0,0,0,,Ең сиқырсыз жолмен
Dialogue: 1,0:25:01.30,0:25:02.91,JP-ja,NTP,0,0,0,,Сиқыршыны іздеңіз
Dialogue: 4,0:25:04.39,0:25:05.60,Default,,0,0,0,,Оқыңыз.
Dialogue: 1,0:25:04.39,0:25:05.67,JP-ja,NTP,0,0,0,,Оқыңыз.
Dialogue: 4,0:25:07.23,0:25:08.77,Default,,0,0,0,,Қиып алу.
Dialogue: 1,0:25:07.31,0:25:09.53,JP-ja,NTP,0,0,0,,Снайпингпен улану
Dialogue: 4,0:25:08.77,0:25:09.77,Default,,0,0,0,,Улану.
Dialogue: 1,0:25:09.74,0:25:11.95,JP-ja,NTP,0,0,0,,Қоғамдық орындарда бомбалау
Dialogue: 4,0:25:09.77,0:25:12.19,Default,,0,0,0,,Қоғамдық орындарды бомбалау.
Dialogue: 4,0:25:12.19,0:25:17.36,Default,,0,0,0,,Ол бүкіл реактивті лайнерді нысанасы сонда болғаны үшін құлатты.
Dialogue: 1,0:25:12.39,0:25:16.75,JP-ja,NTP,0,0,0,,Нысана бортында болғандықтан бүкіл жолаушы ұшағын атып түсіру
Dialogue: 4,0:25:17.36,0:25:20.45,Default,,0,0,0,,Ол екі рет ойланбай, жасырын әдістерді қолданатын адам.
Dialogue: 1,0:25:17.49,0:25:20.55,JP-ja,NTP,0,0,0,,Мынандай дөрекі тактиканы оп-оңай шығаратын адам.
Dialogue: 4,0:25:22.49,0:25:31.25,Default,,0,0,0,,Дүниенің заңдары Магилерге қатысты емес, сондықтан біз өзімізге белгілеген заңдарды мұқият орындауымыз керек.
Dialogue: 1,0:25:22.59,0:25:23.70,JP-ja,NTP,0,0,0,,Сиқыршы дегеніміз не?
Dialogue: 1,0:25:24.18,0:25:26.90,JP-ja,NTP,0,0,0,,Дәл дүние заңдарынан тыс өмір сүретіндіктен.
Dialogue: 1,0:25:27.30,0:25:30.74,JP-ja,NTP,0,0,0,,Өздігінен бекітілген заңдарды қатаң сақтау
Dialogue: 4,0:25:31.25,0:25:36.59,Default,,0,0,0,,Алайда оған сиқыршы мақтанышының ізі де жоқ.
Dialogue: 1,0:25:31.37,0:25:32.52,JP-ja,NTP,0,0,0,,Бірақ бұл адам
Dialogue: 1,0:25:32.85,0:25:36.55,JP-ja,NTP,0,0,0,,Менде сиқыршы болғаныма мақтаныш сезімі жоқ.
Dialogue: 4,0:25:36.97,0:25:39.47,Default,,0,0,0,,Оның әдістері кешірілмейді.
Dialogue: 1,0:25:37.12,0:25:39.36,JP-ja,NTP,0,0,0,,Мен мұндай мінез-құлыққа мүлдем шыдай алмаймын.
Dialogue: 1,0:25:40.79,0:25:41.54,JP-ja,NTP,0,0,0,,Сонымен
Dialogue: 4,0:25:40.85,0:25:46.02,Default,,0,0,0,,Олай болса, бұл Эмия Кирицугу не істейді...
Dialogue: 1,0:25:42.98,0:25:45.78,JP-ja,NTP,0,0,0,,Бұл адам Кирицугу Эмиия деп аталады
Dialogue: 4,0:25:46.98,0:25:49.77,Default,,0,0,0,,...өлтіру арқылы пайда табуға үміттенесіз бе?
Dialogue: 1,0:25:47.05,0:25:49.29,JP-ja,NTP,0,0,0,,Адам өлтірудің мақсаты қандай?
Dialogue: 4,0:25:49.77,0:25:52.52,Default,,0,0,0,,Ақша, мен елестетер едім.
Dialogue: 1,0:25:49.82,0:25:51.95,JP-ja,NTP,0,0,0,,Мүмкін ақша.
Dialogue: 4,0:25:52.52,0:25:59.11,Default,,0,0,0,,Сіз бұл есепте оқи аласыз, ол сиқыршыны өлтірумен айналысқан жоқ.
Dialogue: 1,0:25:52.68,0:25:54.39,JP-ja,NTP,0,0,0,,Бұл баяндамада да айтылуы мүмкін.
Dialogue: 1,0:25:54.97,0:25:58.67,JP-ja,NTP,0,0,0,,Ол тек сиқыршыны өлтіруге қатысқан жоқ.
Dialogue: 4,0:25:59.11,0:26:05.58,Default,,0,0,0,,Ол бүкіл планетаның соғыс аймақтарында пайда болып, жалдамалы ретінде өз қызметтерін ұсынады.
Dialogue: 1,0:25:59.23,0:26:02.18,JP-ja,NTP,0,0,0,,Дүние жүзіндегі қақтығыс аймақтарында кез келген мүмкіндікте пайда болу.
Dialogue: 1,0:26:02.47,0:26:05.35,JP-ja,NTP,0,0,0,,Жалдамалы болып қалтасынан ақша тапқан көрінеді.
Dialogue: 1,0:26:06.25,0:26:07.12,JP-ja,NTP,0,0,0,,Осы құжат
Dialogue: 4,0:26:06.25,0:26:11.04,Default,,0,0,0,,Осы есепті біраз уақытқа алуға бола ма?
Dialogue: 1,0:26:08.41,0:26:10.73,JP-ja,NTP,0,0,0,,Мен қарызға ақша аламын ба?
Dialogue: 4,0:26:16.59,0:26:19.55,Default,,0,0,0,,Білгенімізді қайталайық, Ири.
Dialogue: 1,0:26:16.73,0:26:19.36,JP-ja,NTP,0,0,0,,Airi жинаған ақпаратты жүйелеп көрейік
Dialogue: 4,0:26:20.80,0:26:25.77,Default,,0,0,0,,Грейл таңдайтын жеті Ұстаздың ішінен біз төртеуін білеміз.
Dialogue: 1,0:26:20.96,0:26:23.18,JP-ja,NTP,0,0,0,,Қасиетті Граил таңдаған жеті шебердің ішінен
Dialogue: 1,0:26:23.65,0:26:25.58,JP-ja,NTP,0,0,0,,Қазіргі уақытта төрт адам белгілі.
Dialogue: 1,0:26:26.22,0:26:27.45,JP-ja,NTP,0,0,0,,Токиоми Тохсака
Dialogue: 4,0:26:26.22,0:26:29.69,Default,,0,0,0,,Тохсака Токиоми, Тохсака отбасының басшысы.
Dialogue: 1,0:26:27.89,0:26:29.34,JP-ja,NTP,0,0,0,,Тохсака әулетінің басшысы
Dialogue: 1,0:26:29.65,0:26:31.66,JP-ja,NTP,0,0,0,,Өрт атрибуты бар зергерлік сиқырды өңдеу
Dialogue: 4,0:26:29.69,0:26:33.44,Default,,0,0,0,,Зергерлік сиқырды қолданатын от сиқыршысы. Қиын қарсылас.
Dialogue: 1,0:26:31.75,0:26:33.63,JP-ja,NTP,0,0,0,,Ол қатал жігіт.
Dialogue: 4,0:26:33.73,0:26:35.23,Default,,0,0,0,,Мату Кария.
Dialogue: 1,0:26:33.79,0:26:34.83,JP-ja,NTP,0,0,0,,Кария Мату
Dialogue: 4,0:26:36.28,0:26:40.82,Default,,0,0,0,,Сонда олар отбасын тастап кеткен баланы алып, оны Ұстаз етті, солай ма?
Dialogue: 1,0:26:36.38,0:26:38.12,JP-ja,NTP,0,0,0,,Отағасына үлгере алмаған тентектер
Dialogue: 1,0:26:38.22,0:26:40.69,JP-ja,NTP,0,0,0,,Олар сізді шебер болуға мәжбүр етті ме?
Dialogue: 4,0:26:40.82,0:26:43.07,Default,,0,0,0,,Әлгі қарт шарасыз болса керек.
Dialogue: 1,0:26:40.92,0:26:42.65,JP-ja,NTP,0,0,0,,Сол жақтағы қария да шарасыз.
Dialogue: 4,0:26:43.32,0:26:45.53,Default,,0,0,0,,Кейнет Эль-Меллои Арчибалд.
Dialogue: 1,0:26:43.40,0:26:45.56,JP-ja,NTP,0,0,0,,Кейнет Эль-Меллои Арчибалд
Dialogue: 4,0:26:45.99,0:26:53.17,Default,,0,0,0,,Ол жел мен судың екі жақты жақындығы бар және некромантия, шақыру және алхимия бойынша сарапшы.
Dialogue: 1,0:26:46.16,0:26:48.15,JP-ja,NTP,0,0,0,,Жел мен судың қос атрибуттары бар.
Dialogue: 1,0:26:48.39,0:26:52.62,JP-ja,NTP,0,0,0,,Некромантия, шақыру, мұнай өңдеу зауытының сарапшысы
Dialogue: 4,0:26:53.17,0:26:54.34,Default,,0,0,0,,5 йен
Dialogue: 1,0:26:53.36,0:26:53.97,JP-ja,NTP,0,0,0,,Содан кейін
Dialogue: 1,0:26:54.25,0:26:55.48,JP-ja,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 4,0:26:54.34,0:26:55.96,Default,,0,0,0,,Эмия Кирицугу.
Dialogue: 4,0:26:55.96,0:26:59.38,Default,,0,0,0,,Эйнцберн жанұясының ең жаңа мүшесі және олардың қозырлары.
Dialogue: 1,0:26:56.05,0:26:59.04,JP-ja,NTP,0,0,0,,Эйнцберндер шақырған ең күшті козир
Dialogue: 4,0:26:59.92,0:27:02.13,Default,,0,0,0,,Ал мен жақсы көретін адам.
Dialogue: 1,0:27:00.07,0:27:02.05,JP-ja,NTP,0,0,0,,Менің сүйіктім
Dialogue: 1,0:27:04.54,0:27:05.80,JP-ja,NTP,0,0,0,,Және төртінші
Dialogue: 4,0:27:04.55,0:27:06.06,Default,,0,0,0,,Ал төртінші...
Dialogue: 1,0:27:06.06,0:27:08.19,JP-ja,NTP,0,0,0,,Жоқ, бесінші шебер
Dialogue: 4,0:27:06.06,0:27:12.69,Default,,0,0,0,,Менің айтайын дегенім, бесінші Ұстаз Котомине Кирей, шіркеудің агенті.
Dialogue: 1,0:27:08.67,0:27:10.58,JP-ja,NTP,0,0,0,,Собор шіркеуінен алынған
Dialogue: 1,0:27:10.85,0:27:12.64,JP-ja,NTP,0,0,0,,Аты - Котомине Кирей
Dialogue: 4,0:27:13.06,0:27:14.94,Default,,0,0,0,,Шіркеу?
Dialogue: 1,0:27:13.07,0:27:14.76,JP-ja,NTP,0,0,0,,Собор шіркеуінен
Dialogue: 4,0:27:14.94,0:27:18.86,Default,,0,0,0,,Ол судьяның ұлы, діни қызметкер Котомине Рисей.
Dialogue: 1,0:27:15.09,0:27:18.49,JP-ja,NTP,0,0,0,,Ол жетекші Рисей Котоминенің ұлы.
Dialogue: 4,0:27:19.19,0:27:26.16,Default,,0,0,0,,Ол үш жыл бойы Тохсака Токиомидің қол астында оқыды, бірақ оның командалық заклинаниелері пайда болғаннан кейін онымен бөлініп кетті.
Dialogue: 1,0:27:19.34,0:27:21.52,JP-ja,NTP,0,0,0,,Мен үш жыл бойы Токиоми Тохсаканың қол астында оқыдым.
Dialogue: 1,0:27:21.96,0:27:25.70,JP-ja,NTP,0,0,0,,Бұйрық сиқырын алғаннан кейін ол ұстазымен ажырасып кеткен дейді.
Dialogue: 4,0:27:26.16,0:27:28.08,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 1,0:27:26.30,0:27:27.20,JP-ja,NTP,0,0,0,,Не болды?
Dialogue: 4,0:27:28.08,0:27:30.20,Default,,0,0,0,,Бұл оның жеке тарихы...
Dialogue: 1,0:27:28.13,0:27:29.93,JP-ja,NTP,0,0,0,,Тіпті менің фоным да тазартылды.
Dialogue: 1,0:27:31.23,0:27:32.73,JP-ja,NTP,0,0,0,,Оны да оқу керек.
Dialogue: 4,0:27:31.25,0:27:32.92,Default,,0,0,0,,Оқыңыз.
Dialogue: 1,0:27:34.32,0:27:35.56,JP-ja,NTP,0,0,0,,Кирей Котомине
Dialogue: 4,0:27:34.38,0:27:35.88,Default,,0,0,0,,Котомине Кирей.
Dialogue: 1,0:27:35.85,0:27:39.67,JP-ja,NTP,0,0,0,,Бала кезінен әкесі Рисейді ертіп киелі жерлерге зиярат еткен.
Dialogue: 4,0:27:35.88,0:27:39.96,Default,,0,0,0,,Бала кезінен әкесі Рисейдің соңынан қажылыққа барған.
Dialogue: 1,0:27:39.94,0:27:42.70,JP-ja,NTP,0,0,0,,Манресаның Игнатиялық семинариясын бітірген
Dialogue: 4,0:27:39.96,0:27:43.22,Default,,0,0,0,,Манресада Әулие Игнатий құдайшылдық мектебін бітірген.
Dialogue: 4,0:27:43.22,0:27:46.55,Default,,0,0,0,,Екі жылды өткізіп жіберіп... валедиктор болып бітірді ме?!
Dialogue: 1,0:27:43.28,0:27:44.61,JP-ja,NTP,0,0,0,,2 жыл өткізіп жіберу
Dialogue: 1,0:27:44.94,0:27:46.39,JP-ja,NTP,0,0,0,,Сонымен қатар, бастық
Dialogue: 4,0:27:46.55,0:27:48.39,Default,,0,0,0,,Ол өте әсерлі.
Dialogue: 1,0:27:46.58,0:27:48.20,JP-ja,NTP,0,0,0,,Ол керемет адам сияқты.
Dialogue: 4,0:27:48.39,0:27:53.73,Default,,0,0,0,,Бірақ ол кенеттен примула жолын тастап, Қасиетті шіркеуге ерікті болды.
Dialogue: 1,0:27:48.43,0:27:53.02,JP-ja,NTP,0,0,0,,Алайда, ол кенеттен табысқа жету жолынан адасып, собор шіркеуіне жүгінеді.
Dialogue: 4,0:27:53.73,0:27:58.69,Default,,0,0,0,,Неліктен мұндай адам шіркеудің құпия ұйымдарының бірінде жұмыс істейді?
Dialogue: 1,0:27:53.92,0:27:55.34,JP-ja,NTP,0,0,0,,Себеп бойынша
Dialogue: 1,0:27:55.45,0:27:58.57,JP-ja,NTP,0,0,0,,Ол өзін шіркеудің астыртын ұйымына қатысы бар деп көрсетті ме?
Dialogue: 4,0:27:58.69,0:28:00.69,Default,,0,0,0,,Әкесінің арқасында шығар?
Dialogue: 1,0:27:58.93,0:28:00.80,JP-ja,NTP,0,0,0,,Әкемнің ықпалынан ба?
Dialogue: 4,0:28:00.69,0:28:06.41,Default,,0,0,0,,Қараңызшы, ол әкесі сияқты Шіркеудің 8-ші Таинсттік ассамблеясының мүшесі екенін айтады.
Dialogue: 1,0:28:01.03,0:28:05.91,JP-ja,NTP,0,0,0,,Қараңызшы, оның әкесі сияқты соборлық шіркеудің Сегізінші Сакраментальдық Қоғамына жататындығы жазылған.
Dialogue: 4,0:28:06.41,0:28:10.04,Default,,0,0,0,,Ол бұл жолды басынан бастап ұстанған болар еді.
Dialogue: 1,0:28:06.45,0:28:09.65,JP-ja,NTP,0,0,0,,Олай болса, ол әкесінің жолын әу бастан мақсат ету керек еді.
Dialogue: 4,0:28:10.04,0:28:15.92,Default,,0,0,0,,Алайда ол әкесімен бір жерге келгенше үш рет орнын ауыстырды.
Dialogue: 1,0:28:10.10,0:28:13.14,JP-ja,NTP,0,0,0,,Бірақ мен әкеммен бір бөлімге қоныстанғанша.
Dialogue: 1,0:28:13.49,0:28:15.56,JP-ja,NTP,0,0,0,,Үш рет мүшелік өзгерді
Dialogue: 4,0:28:15.92,0:28:19.21,Default,,0,0,0,,Тіпті Орындаушы болып тағайындалды.
Dialogue: 1,0:28:16.14,0:28:18.99,JP-ja,NTP,0,0,0,,Ол тіпті бір рет агент болып тағайындалды.
Dialogue: 1,0:28:19.63,0:28:20.55,JP-ja,NTP,0,0,0,,Агент
Dialogue: 4,0:28:19.63,0:28:21.30,Default,,0,0,0,,Орындаушы?
Dialogue: 4,0:28:21.30,0:28:24.05,Default,,0,0,0,,Жаман аңшы.
Dialogue: 1,0:28:21.48,0:28:23.30,JP-ja,NTP,0,0,0,,Ол бидғатты бағындыру үшін жауапты.
Dialogue: 4,0:28:24.05,0:28:25.01,Default,,0,0,0,,Негізінде...
Dialogue: 1,0:28:24.21,0:28:24.88,JP-ja,NTP,0,0,0,,Қысқасы
Dialogue: 4,0:28:25.55,0:28:27.56,Default,,0,0,0,,...мен бұрын қандай едім.
Dialogue: 1,0:28:25.65,0:28:29.12,JP-ja,NTP,0,0,0,,Менің рөлім бұрынғыдай сиқыршыны өлтіру.
Dialogue: 4,0:28:27.56,0:28:29.56,Default,,0,0,0,,Сиқыршы өлтіруші.
Dialogue: 4,0:28:30.18,0:28:31.97,Default,,0,0,0,,Эмия Кирицугу.
Dialogue: 1,0:28:30.30,0:28:31.71,JP-ja,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 4,0:28:32.35,0:28:37.81,Default,,0,0,0,,Оның қастандықтары әрқашан қысқа мерзімде бірінен соң бірі орындалды.
Dialogue: 1,0:28:32.54,0:28:34.71,JP-ja,NTP,0,0,0,,Оған жатқызылған қастандық
Dialogue: 1,0:28:35.01,0:28:37.66,JP-ja,NTP,0,0,0,,Қысқа мерзім ішінде дәйекті түрде орындалды
Dialogue: 1,0:28:37.80,0:28:41.00,JP-ja,NTP,0,0,0,,Сонымен қатар қақтығыс аймақтары да өзгереді.
Dialogue: 4,0:28:37.81,0:28:41.44,Default,,0,0,0,,Сол жалпы уақыт кезеңдерінде ол соғыс аймақтарында пайда болды,
Dialogue: 1,0:28:41.32,0:28:45.10,JP-ja,NTP,0,0,0,,Олар соғыс жағдайы күшейген кезде ғана пайда болады.
Dialogue: 4,0:28:41.44,0:28:45.65,Default,,0,0,0,,, бірақ тек ұрыс ең қатал болған кезде ғана.
Dialogue: 4,0:28:45.65,0:28:51.45,Default,,0,0,0,,Өлімнің өзін аңдығандай.
Dialogue: 1,0:28:45.74,0:28:48.12,JP-ja,NTP,0,0,0,,Өлім орнына барғандай.
Dialogue: 1,0:28:48.48,0:28:51.26,JP-ja,NTP,0,0,0,,Қандай да бір құмарлық бар сияқты.
Dialogue: 1,0:28:51.40,0:28:53.92,JP-ja,NTP,0,0,0,,Іс-әрекеттің айқын өзін-өзі жою принциптері
Dialogue: 4,0:28:51.45,0:28:53.83,Default,,0,0,0,,Оның әрекеті өзін-өзі өлтіруге бағытталғаны анық.
Dialogue: 4,0:28:56.08,0:28:58.54,Default,,0,0,0,,Жер бетінде бұл не?
Dialogue: 1,0:28:56.20,0:28:58.11,JP-ja,NTP,0,0,0,,Бұл нені білдіреді?
Dialogue: 4,0:28:58.83,0:29:03.09,Default,,0,0,0,,Алхимия. Некромантия. Шақыру. Сәуегейлік. Емдеу.
Dialogue: 1,0:28:59.01,0:29:02.86,JP-ja,NTP,0,0,0,,Тазалау Рухын шақыру, көріпкелдік сауықтыру
Dialogue: 4,0:29:03.09,0:29:06.72,Default,,0,0,0,,Ол зерттеген сиқырдың барлық түрлерін қараңыз.
Dialogue: 1,0:29:03.32,0:29:03.89,JP-ja,NTP,0,0,0,,Қараңыз
Dialogue: 1,0:29:04.30,0:29:07.02,JP-ja,NTP,0,0,0,,Бұл оның үйренген сиқырлық категориясы.
Dialogue: 4,0:29:07.64,0:29:09.55,Default,,0,0,0,,Ол неге сонша тырысады?
Dialogue: 1,0:29:07.80,0:29:09.22,JP-ja,NTP,0,0,0,,Бұл позитив дегеніміз не?
Dialogue: 4,0:29:09.55,0:29:16.56,Default,,0,0,0,,Шеберлік шегіне жетеді де, артына қарамай басқа түрге ауысады.
Dialogue: 1,0:29:09.66,0:29:12.34,JP-ja,NTP,0,0,0,,Барлығын келесі деңгейге көтеріңіз
Dialogue: 1,0:29:12.60,0:29:15.97,JP-ja,NTP,0,0,0,,Сол жерден еш өкінбей келесі жанрға ауысыңыз.
Dialogue: 1,0:29:16.39,0:29:21.66,JP-ja,NTP,0,0,0,,Осы уақытқа дейін өсіргенімнің бәрін лақтырып жібергендеймін.
Dialogue: 4,0:29:16.56,0:29:21.90,Default,,0,0,0,,Үйренгенінің бәрін қоқыс секілді лақтырып жіберетін сияқты.
Dialogue: 4,0:29:22.73,0:29:23.94,Default,,0,0,0,,Iri.
Dialogue: 1,0:29:22.87,0:29:23.65,JP-ja,NTP,0,0,0,,Айри
Dialogue: 4,0:29:24.74,0:29:28.53,Default,,0,0,0,,Мына Котомине Кирей мені қорқытады.
Dialogue: 1,0:29:24.83,0:29:28.35,JP-ja,NTP,0,0,0,,Мен үшін Котомине Кирейдің түрі қорқынышты.
Dialogue: 4,0:29:28.53,0:29:31.37,Default,,0,0,0,,Оған барлық жеке мүдде ұғымы жат.
Dialogue: 1,0:29:28.73,0:29:31.07,JP-ja,NTP,0,0,0,,Бұл адамның өзімшілдік туралы ойлары жоқ.
Dialogue: 1,0:29:31.36,0:29:36.10,JP-ja,NTP,0,0,0,,Оның іс-әрекеті практикалық пайда мен тәуекелдің арасындағы теңгерімсіз.
Dialogue: 4,0:29:31.37,0:29:36.54,Default,,0,0,0,,Оның әрекеттері тәуекел мен сыйақы туралы кез келген ойдан толығымен жойылады.
Dialogue: 4,0:29:36.54,0:29:41.04,Default,,0,0,0,,Ол тек ақша үшін айналысатын фрилансер болуы мүмкін емес.
Dialogue: 1,0:29:36.60,0:29:40.84,JP-ja,NTP,0,0,0,,Бұл жігіттің ақша іздеген фрилансер болуы мүмкін емес.
Dialogue: 1,0:29:41.02,0:29:44.88,JP-ja,NTP,0,0,0,,Бұл кісінің өмірінде бірде-бір құмарлық жоқ.
Dialogue: 4,0:29:41.04,0:29:45.09,Default,,0,0,0,,Бұл адам өмірінде ешқашан құмарлықты басынан өткерген емес.
Dialogue: 4,0:29:45.09,0:29:47.88,Default,,0,0,0,,Ол ештеңеге сенбейді.
Dialogue: 1,0:29:45.25,0:29:47.49,JP-ja,NTP,0,0,0,,Бұл кісі ештеңеге сенбейтін шығар.
Dialogue: 4,0:29:47.88,0:29:51.97,Default,,0,0,0,,Оның орындалғысы келетін бірде-бір тілегі жоқ.
Dialogue: 1,0:29:48.05,0:29:52.01,JP-ja,NTP,0,0,0,,Сізде қалау деп атауға болатын ештеңе жоқ шығар.
Dialogue: 4,0:29:52.93,0:29:54.43,Default,,0,0,0,,Ондай адам...
Dialogue: 1,0:29:53.08,0:29:54.40,JP-ja,NTP,0,0,0,,Мұндай адам
Dialogue: 4,0:29:54.43,0:29:57.56,Default,,0,0,0,,Сонда ол неден кейін болуы мүмкін?
Dialogue: 1,0:29:54.69,0:29:57.21,JP-ja,NTP,0,0,0,,Сонымен не іздеп жүрсіз?
Dialogue: 4,0:29:57.56,0:30:01.44,Default,,0,0,0,,Неліктен ол Грейл үшін өз өмірін қатерге тігеді?
Dialogue: 1,0:29:57.64,0:30:01.06,JP-ja,NTP,0,0,0,,Неліктен Қасиетті Граалды іздеу үшін өз өміріңізді қатерге тігу керек?
Dialogue: 1,0:30:01.37,0:30:02.09,JP-ja,NTP,0,0,0,,Бірақ
Dialogue: 4,0:30:01.44,0:30:06.90,Default,,0,0,0,,Бірақ Граил Котомине Кирейді Мастерлердің бірі ретінде таңдады.
Dialogue: 1,0:30:02.47,0:30:06.83,JP-ja,NTP,0,0,0,,Кирей Котомине Қасиетті Граил шеберлерінің бірі болып таңдалды.
Dialogue: 4,0:30:06.90,0:30:08.07,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 1,0:30:06.91,0:30:07.67,JP-ja,NTP,0,0,0,,Иә.
Dialogue: 4,0:30:08.07,0:30:12.78,Default,,0,0,0,,Оның Грейльге құмар болуына қандай да бір себеп болуы керек.
Dialogue: 1,0:30:08.28,0:30:12.70,JP-ja,NTP,0,0,0,,Бұл адамның Қасиетті Граильді алу үшін жеткілікті байланысы болуы керек.
Dialogue: 4,0:30:13.45,0:30:16.91,Default,,0,0,0,,Бірақ бұл не болуы мүмкін екенін білмеймін.
Dialogue: 1,0:30:13.46,0:30:16.45,JP-ja,NTP,0,0,0,,Бірақ мен оның не екенін көре алмаймын.
Dialogue: 4,0:30:16.91,0:30:19.29,Default,,0,0,0,,Мені қорқытқаны осы.
Dialogue: 1,0:30:17.03,0:30:19.29,JP-ja,NTP,0,0,0,,Бұл мен үшін қорқынышты.
Dialogue: 4,0:30:21.38,0:30:23.13,Default,,0,0,0,,Котомине Кирей.
Dialogue: 1,0:30:21.46,0:30:22.65,JP-ja,NTP,0,0,0,,Кирей Котомине
Dialogue: 4,0:30:23.42,0:30:25.59,Default,,0,0,0,,Эмия Кирицугу.
Dialogue: 1,0:30:23.61,0:30:24.93,JP-ja,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 4,0:30:25.96,0:30:32.80,Default,,0,0,0,,Оның шексіз шайқастары тоғыз жыл бұрын кенеттен тоқтап қалды,
Dialogue: 1,0:30:25.99,0:30:29.27,JP-ja,NTP,0,0,0,,Бұл кісінің шайқасы тынымсыз қайталанды.
Dialogue: 1,0:30:29.81,0:30:32.50,JP-ja,NTP,0,0,0,,9 жыл бұрын кенеттен аяқталды.
Dialogue: 4,0:30:32.80,0:30:36.47,Default,,0,0,0,,ол солтүстік магилері Эйнцберндермен кездескен кезде.
Dialogue: 1,0:30:32.84,0:30:36.35,JP-ja,NTP,0,0,0,,Солтүстік сиқыршысы Эйнцбернмен кездесу
Dialogue: 4,0:30:36.97,0:30:41.02,Default,,0,0,0,,Осылайша ол өз жауабын сол кезде тапты.
Dialogue: 1,0:30:37.01,0:30:40.92,JP-ja,NTP,0,0,0,,Сонда ол жауап алды.
Dialogue: 4,0:30:41.02,0:30:43.52,Default,,0,0,0,,Онда мен сұрақ қоюым керек...
Dialogue: 1,0:30:41.25,0:30:43.14,JP-ja,NTP,0,0,0,,Олай болса сұрау керек
Dialogue: 1,0:30:43.51,0:30:45.22,JP-ja,NTP,0,0,0,,Не үшін күресу керек
Dialogue: 4,0:30:43.52,0:30:46.40,Default,,0,0,0,,Ол сол шайқастарда не іздеді?
Dialogue: 1,0:30:45.37,0:30:46.84,JP-ja,NTP,0,0,0,,Соңында
Dialogue: 4,0:30:48.19,0:30:50.40,Default,,0,0,0,,Ал соңында не тапты?
Dialogue: 1,0:30:48.30,0:30:50.07,JP-ja,NTP,0,0,0,,Не алдыңыз?
Dialogue: 4,0:31:00.66,0:31:03.54,Default,,0,0,0,,Сіз үлгере алмадыңыз.
Dialogue: 1,0:31:00.70,0:31:03.67,JP-ja,NTP,0,0,0,,Біз уақытында әрең жеткен жоқпыз ба?
Dialogue: 4,0:31:04.13,0:31:10.72,Default,,0,0,0,,Грейл сізді таңдады, яғни ол сізді белгілі бір дәрежеде Сиқыршы ретінде таниды.
Dialogue: 1,0:31:04.16,0:31:06.23,JP-ja,NTP,0,0,0,,Қасиетті Граил ретінде таңдалу дегенді білдіреді
Dialogue: 1,0:31:06.44,0:31:10.26,JP-ja,NTP,0,0,0,,Бұл сіздің де лайықты сиқыршы ретінде танылғаныңызды білдіреді.
Dialogue: 1,0:31:10.55,0:31:13.81,JP-ja,NTP,0,0,0,,​​Мен сені әзірше мақтаймын, Қария.
Dialogue: 4,0:31:10.72,0:31:13.55,Default,,0,0,0,,Мен саған осыншама беремін, Қария.
Dialogue: 4,0:31:15.05,0:31:16.39,Default,,0,0,0,,Бірақ сіз білесіз...
Dialogue: 1,0:31:15.14,0:31:16.03,JP-ja,NTP,0,0,0,,Картоп
Dialogue: 4,0:31:16.68,0:31:19.89,Default,,0,0,0,,Сіз қорқынышты көрінесіз.
Dialogue: 1,0:31:16.86,0:31:19.54,JP-ja,NTP,0,0,0,,Қандай сұмдық көрініс.
Dialogue: 4,0:31:19.89,0:31:23.56,Default,,0,0,0,,Сол аяғыңыз әлі жұмыс істей ме?
Dialogue: 1,0:31:20.13,0:31:23.15,JP-ja,NTP,0,0,0,,Хара, сен сол аяғыңды қозғалта аласың ба?
Dialogue: 4,0:31:32.15,0:31:33.74,Default,,0,0,0,,Ашуланба.
Dialogue: 1,0:31:32.18,0:31:33.57,JP-ja,NTP,0,0,0,,Ашуланба Ашуланба
Dialogue: 4,0:31:33.74,0:31:39.66,Default,,0,0,0,,Ішіңіздегі Төбе құрттары, егер сіз оларды қоздырсаңыз, сізді жеп қояды.
Dialogue: 1,0:31:33.76,0:31:36.18,JP-ja,NTP,0,0,0,,Денеңіздегі жәндіктердің ізін қоздырсаңыз
Dialogue: 1,0:31:36.35,0:31:39.39,JP-ja,NTP,0,0,0,,Жәндіктер сені жеп қояды.
Dialogue: 4,0:31:39.66,0:31:46.92,Default,,0,0,0,,Қалай болғанда да, мен сіз ең жақсы жағдайда тағы бір ай ғана өмір сүресіз деп айтар едім.
Dialogue: 1,0:31:39.82,0:31:42.00,JP-ja,NTP,0,0,0,,Менің көзқарасым бойынша
Dialogue: 1,0:31:42.06,0:31:46.46,JP-ja,NTP,0,0,0,,Сіздің өмір сүруіңізге бір ай ғана қалды.
Dialogue: 4,0:31:46.92,0:31:48.38,Default,,0,0,0,,Бұл өте көп.
Dialogue: 1,0:31:47.00,0:31:47.68,JP-ja,NTP,0,0,0,,Жетеді.
Dialogue: 4,0:31:48.38,0:31:49.88,Default,,0,0,0,,Жер
Dialogue: 1,0:31:48.40,0:31:49.56,JP-ja,NTP,0,0,0,,Бұл не?
Dialogue: 4,0:31:49.88,0:31:52.63,Default,,0,0,0,,Мен бұл көп дедім.
Dialogue: 1,0:31:49.91,0:31:52.17,JP-ja,NTP,0,0,0,,Мен бұл жеткілікті дедім.
Dialogue: 4,0:31:53.22,0:32:00.56,Default,,0,0,0,,Кария, мен саған бір жыл бойына сыйақы беру үшін тамаша жәдігер таптым.
Dialogue: 1,0:31:53.30,0:31:56.40,JP-ja,NTP,0,0,0,,Қария, бір жыл шыдағаның үшін сыйың.
Dialogue: 1,0:31:56.56,0:32:00.22,JP-ja,NTP,0,0,0,,Мен саған лайықты қасиетті жәдігер таптым.
Dialogue: 4,0:32:01.06,0:32:04.77,Default,,0,0,0,,Әкеңнің мейіріміне жол берме.
Dialogue: 1,0:32:01.07,0:32:04.34,JP-ja,NTP,0,0,0,,Әкемнің мейіріміне жол бермеймін.
Dialogue: 4,0:32:16.74,0:32:19.28,Default,,0,0,0,,Менде де командалық заклинание бар!
Dialogue: 1,0:32:16.81,0:32:19.05,JP-ja,NTP,0,0,0,,Бұйрық сиқыры менде де болды.
Dialogue: 4,0:32:19.62,0:32:21.87,Default,,0,0,0,,Грейль мені таңдады!
Dialogue: 1,0:32:19.66,0:32:21.47,JP-ja,NTP,0,0,0,,Мен Қасиетті Граил болу үшін таңдалдым.
Dialogue: 4,0:32:21.87,0:32:25.21,Default,,0,0,0,,Грейл менің қабілетімді мойындады!
Dialogue: 1,0:32:21.92,0:32:24.71,JP-ja,NTP,0,0,0,,Қасиетті Граил менің талантымды мойындады.
Dialogue: 4,0:32:27.38,0:32:29.21,Default,,0,0,0,,Мен жай ғана қуанып отыра алмаймын.
Dialogue: 1,0:32:27.54,0:32:29.31,JP-ja,NTP,0,0,0,,Мен мәңгі бақытты бола алмаймын
Dialogue: 4,0:32:29.75,0:32:32.55,Default,,0,0,0,,Мен Қызметшімді шақыруға дайындалуым керек!
Dialogue: 1,0:32:29.79,0:32:32.32,JP-ja,NTP,0,0,0,,Мен қызметшіні шақыруға дайындалуым керек.
Dialogue: 6,0:32:35.77,0:32:43.48,Alternate2,,0,0,0,,Екі түн бұрын Фуюки қаласында жоғалып кеткен алтыншы сынып оқушысы,
Dialogue: 1,0:32:35.86,0:32:38.54,JP-ja,NTP,0,0,0,,Ол кеше кештен бері Фуюки қаласында хабарсыз кеткен.
Dialogue: 0,0:32:37.18,0:32:39.93,Sign-NewsReport,,0,0,0,,Фуюки қаласы
Dialogue: 1,0:32:37.18,0:32:39.93,Sign-NewsReport,,0,0,0,,Фуюки қаласы
Dialogue: 2,0:32:37.18,0:32:39.93,Sign-NewsReport,,0,0,0,,Фуюки қаласы
Dialogue: 3,0:32:37.18,0:32:39.93,Sign-NewsReport,,0,0,0,,Фуюки қаласы
Dialogue: 0,0:32:37.18,0:32:39.93,Sign-NewsReport,,0,0,0,,Фуюки қаласындағы сериялық өлтірулер
Dialogue: 1,0:32:37.18,0:32:39.93,Sign-NewsReport,,0,0,0,,Фуюки қаласындағы сериялық өлтірулер
Dialogue: 0,0:32:37.18,0:32:39.93,Sign-NewsLogo,,0,0,0,,Өзі құдаймын деп айтқан адаммен кездескен сол күннен бері
Dialogue: 1,0:32:37.18,0:32:39.93,Sign-NewsLogo,,0,0,0,,Өзі құдаймын деп айтқан адаммен кездескен сол күннен бері
Dialogue: 2,0:32:37.18,0:32:39.93,Sign-NewsLogo,,0,0,0,,Өзі құдаймын деп айтқан адаммен кездескен сол күннен бері
Dialogue: 3,0:32:37.18,0:32:39.93,Sign-NewsLogo,,0,0,0,,Өзі құдаймын деп айтқан адаммен кездескен сол күннен бері
Dialogue: 4,0:32:37.18,0:32:39.93,Sign-NewsLogo,,0,0,0,,Өзі құдаймын деп айтқан адаммен кездескен сол күннен бері
Dialogue: 1,0:32:38.84,0:32:40.19,JP-ja,NTP,0,0,0,,Қайырлы таң Вавер
Dialogue: 6,0:32:38.85,0:32:39.93,Default,,0,0,0,,Қайырлы таң, Вавер.
Dialogue: 4,0:32:39.93,0:32:42.52,Default,,0,0,0,,Қайырлы таң, Вавер-чан.
Dialogue: 1,0:32:40.26,0:32:42.13,JP-ja,NTP,0,0,0,,Қайырлы таң Уэйвер-чан
Dialogue: 6,0:32:43.48,0:32:47.86,Alternate2,,0,0,0,,Мики Нишимото бүгін таңертең Мияма ауданындағы орманда өлі күйінде табылды.
Dialogue: 1,0:32:43.92,0:32:47.07,JP-ja,NTP,0,0,0,,Қайырлы таң, ата мен әже.
Dialogue: 4,0:32:44.07,0:32:47.32,Default,,0,0,0,,Таң, ата, әже.
Dialogue: 4,0:32:48.45,0:32:50.62,Default,,0,0,0,,Фуюки бұл күндері өте қауіпті.
Dialogue: 1,0:32:48.49,0:32:50.43,JP-ja,NTP,0,0,0,,Фуюки де мазасызданды.
Dialogue: 1,0:32:50.52,0:32:52.06,JP-ja,NTP,0,0,0,,Иә, мүлде
Dialogue: 4,0:32:50.62,0:32:52.78,Default,,0,0,0,,Бұл шынымен де.
Dialogue: 4,0:32:52.78,0:32:59.12,Default,,0,0,0,,Әйтеуір, Марта, бүгін таңертең әтештердің қатты дауысы шықты.
Dialogue: 1,0:32:52.84,0:32:54.69,JP-ja,NTP,0,0,0,,Қалай болғанда да, сәлем Марта
Dialogue: 1,0:32:55.02,0:32:58.82,JP-ja,NTP,0,0,0,,Тауықтардың таң атқаннан бері қатты дауысы шыққаны сонша, мен оларға шыдай алмаймын.
Dialogue: 4,0:32:59.12,0:33:01.04,Default,,0,0,0,,Не болып жатыр?
Dialogue: 1,0:32:59.31,0:33:00.89,JP-ja,NTP,0,0,0,,Қызық, бұл не?
Dialogue: 1,0:33:01.02,0:33:04.36,JP-ja,NTP,0,0,0,,Менің бақшамда үш тауық бар.
Dialogue: 4,0:33:01.04,0:33:04.46,Default,,0,0,0,,Біздің аулада үш әтеш бар.
Dialogue: 4,0:33:04.46,0:33:06.17,Default,,0,0,0,,Біздің аулада?
Dialogue: 1,0:33:04.47,0:33:05.79,JP-ja,NTP,0,0,0,,Менің бақшамда
Dialogue: 1,0:33:06.04,0:33:07.27,JP-ja,NTP,0,0,0,,Не болды, мырза Мокки!
Dialogue: 4,0:33:06.17,0:33:07.34,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 4,0:33:07.34,0:33:10.22,Default,,0,0,0,,Олар қайдан келді деп ойлаймын.
Dialogue: 1,0:33:07.35,0:33:09.72,JP-ja,NTP,0,0,0,,Қызық, қайдан шықты?
Dialogue: 1,0:33:10.84,0:33:12.97,JP-ja,NTP,0,0,0,,Уэйвер-чан да кофе іше алады.
Dialogue: 4,0:33:10.84,0:33:13.18,Default,,0,0,0,,Уэйвер-чан, кофе алғыңыз келе ме?
Dialogue: 1,0:33:14.76,0:33:17.54,JP-ja,NTP,0,0,0,,Вавер-чан, бұл қол не болды?
Dialogue: 4,0:33:14.76,0:33:17.77,Default,,0,0,0,,Вавер-чан, қолыңа не болды?
Dialogue: 4,0:33:18.73,0:33:19.64,Default,,0,0,0,,Қап!
Dialogue: 1,0:33:18.82,0:33:19.47,JP-ja,NTP,0,0,0,,Шима
Dialogue: 1,0:33:19.54,0:33:20.27,JP-ja,NTP,0,0,0,,Туған белгі
Dialogue: 4,0:33:19.64,0:33:20.77,Default,,0,0,0,,Сол белгі.
Dialogue: 1,0:33:20.73,0:33:21.90,JP-ja,NTP,0,0,0,,Тіпті туу белгісі
Dialogue: 4,0:33:20.77,0:33:22.10,Default,,0,0,0,,Белгілеу?
Dialogue: 1,0:33:22.02,0:33:24.57,JP-ja,NTP,0,0,0,,Бұл көгеру кешеге дейін болған жоқ.
Dialogue: 4,0:33:22.10,0:33:24.77,Default,,0,0,0,,Ол белгі кеше болған жоқ.
Dialogue: 1,0:33:25.05,0:33:26.69,JP-ja,NTP,0,0,0,,Шабуыл
Dialogue: 4,0:33:25.86,0:33:27.32,Default,,0,0,0,,Geez!
Dialogue: 4,0:33:27.32,0:33:29.36,Default,,0,0,0,,Ең қажетсіз нәрселерді байқайсыз...
Dialogue: 1,0:33:27.41,0:33:29.59,JP-ja,NTP,0,0,0,,Мен қажет емес нәрсені байқадым
Dialogue: 4,0:33:29.36,0:33:31.74,Default,,0,0,0,,Не болды, Уэйвер?
Dialogue: 1,0:33:29.91,0:33:31.41,JP-ja,NTP,0,0,0,,Не болды, Уэйвер?
Dialogue: 1,0:33:31.74,0:33:32.80,JP-ja,NTP,0,0,0,,Вавер-чан
Dialogue: 4,0:33:31.74,0:33:33.37,Default,,0,0,0,,Вавер-чан?
Dialogue: 1,0:33:33.21,0:33:34.56,JP-ja,NTP,0,0,0,,Мен бұған көмектесе алмаймын.
Dialogue: 4,0:33:33.37,0:33:34.91,Default,,0,0,0,,Ештеңе жоқ.
Dialogue: 4,0:33:34.91,0:33:37.08,Default,,0,0,0,,Жүр, кофе ішіп ал.
Dialogue: 1,0:33:34.98,0:33:36.97,JP-ja,NTP,0,0,0,,Жүр, кофе ішейік.
Dialogue: 4,0:33:37.08,0:33:39.00,Default,,0,0,0,,Мен оған көп сүт құйдым.
Dialogue: 1,0:33:37.09,0:33:38.79,JP-ja,NTP,0,0,0,,Сүтті көп қосыңыз
Dialogue: 4,0:33:39.00,0:33:43.13,Default,,0,0,0,,Екеуің кофені ұнатпайсыңдар ма?
Dialogue: 1,0:33:39.02,0:33:40.34,JP-ja,NTP,0,0,0,,Бұл екеуіңе де ұнайды.
Dialogue: 1,0:33:41.82,0:33:42.85,JP-ja,NTP,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 4,0:33:50.13,0:33:57.56,Default,,0,0,0,,Шетелде айырбастау курсында оқып жүргеннен кейін олардың немересімін деп ойлауы үшін шынымен тағы бір сиқыр жасауым керек пе?
Dialogue: 1,0:33:50.15,0:33:51.16,JP-ja,NTP,0,0,0,,Тағы да
Dialogue: 1,0:33:51.56,0:33:54.65,JP-ja,NTP,0,0,0,,Өйткені мен шетелден оқудан оралған немеремін.
Dialogue: 1,0:33:54.74,0:33:57.58,JP-ja,NTP,0,0,0,,Менің ойымша, егер сіз оған кеңес бермесеңіз, бұл жақсы емес.
Dialogue: 1,0:34:01.91,0:34:05.65,JP-ja,NTP,0,0,0,,Мен ұрлаған тауықты жасыруым керек.
Dialogue: 4,0:34:01.94,0:34:05.89,Default,,0,0,0,,Мен де ұрлаған әтештердің түсінігін табуым керек.
Dialogue: 4,0:34:06.48,0:34:10.95,Default,,0,0,0,,Мен олардың шын мәнінде аңызға айналған қылыштың қынасын тапқанына сене алмаймын.
Dialogue: 1,0:34:06.67,0:34:10.64,JP-ja,NTP,0,0,0,,Аты аңызға айналған қасиетті қылыштың қынасын табамын деп ешқашан ойламаппын.
Dialogue: 4,0:34:10.95,0:34:12.95,Default,,0,0,0,,Бірде-бір сызат жоқ.
Dialogue: 1,0:34:11.14,0:34:12.48,JP-ja,NTP,0,0,0,,Кемшіліктері жоқ
Dialogue: 4,0:34:12.95,0:34:16.33,Default,,0,0,0,,Бұл қазылған нысанның жасы шынымен 1500 жыл ма?
Dialogue: 1,0:34:13.01,0:34:16.23,JP-ja,NTP,0,0,0,,Бұл 1500 жыл бұрынғы дәуірдің қазылған заты.
Dialogue: 4,0:34:16.70,0:34:20.04,Default,,0,0,0,,Объектінің өзі Концептуалды қарудың бір түрі.
Dialogue: 1,0:34:16.78,0:34:19.68,JP-ja,NTP,0,0,0,,Мұның өзі «концептуалды қаруланудың» бір түрі.
Dialogue: 4,0:34:20.04,0:34:23.87,Default,,0,0,0,,Ол кәдімгі физикалық заттар сияқты тот баспайды немесе тозбайды.
Dialogue: 1,0:34:20.11,0:34:23.29,JP-ja,NTP,0,0,0,,Материал ретінде ол табиғи ауа райына әсер етпеуі мүмкін.
Dialogue: 4,0:34:23.87,0:34:31.17,Default,,0,0,0,,Дәл аңыздардағыдай өз иесінің жарасын емдеп, қартаюын тоқтатады.
Dialogue: 1,0:34:23.94,0:34:25.66,JP-ja,NTP,0,0,0,,Тек оны жабдықтау арқылы
Dialogue: 1,0:34:25.78,0:34:29.01,JP-ja,NTP,0,0,0,,Аңыз бойынша бұл қабық иесінің жарасын емдейді.
Dialogue: 1,0:34:29.21,0:34:30.81,JP-ja,NTP,0,0,0,,Қартаюды тоқтатады
Dialogue: 4,0:34:31.17,0:34:35.51,Default,,0,0,0,,Әрине, бұл оның бастапқы иесінің манасымен қамтамасыз етілген жағдайда ғана.
Dialogue: 1,0:34:31.27,0:34:35.41,JP-ja,NTP,0,0,0,,Әрине, егер бастапқы иесі сиқырлы қуат берсе.
Dialogue: 1,0:34:35.76,0:34:39.22,JP-ja,NTP,0,0,0,,Басқаша айтқанда, шақырылған батырлық рухпен жұп ретінде қолдансаңыз.
Dialogue: 4,0:34:35.76,0:34:43.27,Default,,0,0,0,,Басқаша айтқанда, оны өз Қожайынын қорғау үшін шақырылған Батырлық Рухпен бірге пайдалануға болады.
Dialogue: 1,0:34:39.59,0:34:43.01,JP-ja,NTP,0,0,0,,Мұның өзін шебердің асыл фантасмасы ретінде пайдалануға болады.
Dialogue: 4,0:34:43.27,0:34:45.06,Default,,0,0,0,,Дәл сіз сияқты.
Dialogue: 1,0:34:43.31,0:34:44.73,JP-ja,NTP,0,0,0,,Сізге ұқсайды.
Dialogue: 1,0:34:45.01,0:34:47.54,JP-ja,NTP,0,0,0,,Құрал әрқашан құрал болып табылады
Dialogue: 4,0:34:45.06,0:34:47.86,Default,,0,0,0,,Құрал әрқашан құрал, солай ма?
Dialogue: 4,0:34:47.86,0:34:50.61,Default,,0,0,0,,Бұл қызметшілерге де қатысты.
Dialogue: 1,0:34:47.86,0:34:50.99,JP-ja,NTP,0,0,0,,Олай десеңіз, қызметшілер үшін де солай.
Dialogue: 4,0:34:50.90,0:34:58.20,Default,,0,0,0,,Батырлық Рух қаншалықты атақты болса да, Қызметші оның бір кездері шақырылған Қожайынының құралы ғана емес.
Dialogue: 1,0:34:51.14,0:34:55.33,JP-ja,NTP,0,0,0,,Батырлық рух қанша атақты болса да, қызметші болып шақырылса.
Dialogue: 1,0:34:55.69,0:34:57.74,JP-ja,NTP,0,0,0,,Шеберге ол құрал сияқты жақсы.
Dialogue: 4,0:34:58.20,0:35:04.20,Default,,0,0,0,,Өз қиялының алға шығуына жол берген адам бұл шайқастан ешқашан жеңіспен шықпайды.
Dialogue: 1,0:34:58.39,0:35:00.92,JP-ja,NTP,0,0,0,,Онда біртүрлі елес әкелетіндер
Dialogue: 1,0:35:01.41,0:35:03.90,JP-ja,NTP,0,0,0,,Мен бұл шайқастан аман қалмайтыныма сенімдімін.
Dialogue: 4,0:35:04.20,0:35:10.55,Default,,0,0,0,,Міне, сондықтан менің үлкен атам бұл қынапты тек саған қалдырған жәдігер деп шешті.
Dialogue: 1,0:35:04.38,0:35:07.34,JP-ja,NTP,0,0,0,,Бұл қынап сізге қолайлы.
Dialogue: 1,0:35:07.75,0:35:10.02,JP-ja,NTP,0,0,0,,Бұл атаның шешімі, солай емес пе?
Dialogue: 4,0:35:10.55,0:35:12.42,Default,,0,0,0,,Солай ма, қызық?
Dialogue: 1,0:35:10.59,0:35:12.22,JP-ja,NTP,0,0,0,,Бұл шынымен де солай ма?
Dialogue: 1,0:35:13.16,0:35:15.64,JP-ja,NTP,0,0,0,,Атаның сыйына көңілі толмаған
Dialogue: 4,0:35:13.17,0:35:15.84,Default,,0,0,0,,Оның сыйы көңіліңізден шықпай ма?
Dialogue: 4,0:35:15.84,0:35:17.35,Default,,0,0,0,,Әрине жоқ.
Dialogue: 1,0:35:15.97,0:35:19.55,JP-ja,NTP,0,0,0,,Әйтеуір, Ахт тамаша жұмыс жасады.
Dialogue: 4,0:35:17.35,0:35:19.43,Default,,0,0,0,,Ахт жақсы нәтиже көрсетті.
Dialogue: 1,0:35:19.78,0:35:22.93,JP-ja,NTP,0,0,0,,Бірде-бір қожайын мұндай қозырды ұстамаған.
Dialogue: 4,0:35:19.81,0:35:22.73,Default,,0,0,0,,Мен басқа Мастерлердің осыншама күшті козирі бар екеніне күмәнданамын.
Dialogue: 4,0:35:23.02,0:35:24.97,Default,,0,0,0,,Сонда не болды?
Dialogue: 1,0:35:23.11,0:35:25.20,JP-ja,NTP,0,0,0,,Сонда не болды?
Dialogue: 4,0:35:25.31,0:35:28.94,Default,,0,0,0,,Реликтің иесімен қаншалықты жақсы байланысқандығын ескере отырып,
Dialogue: 1,0:35:25.35,0:35:28.56,JP-ja,NTP,0,0,0,,Осы сияқты мінсіз қасиетті жәдігер болса ше?
Dialogue: 4,0:35:28.94,0:35:33.73,Default,,0,0,0,,Біз іздеп жүрген Батырлық Рух міндетті түрде шақыруға жауап береді.
Dialogue: 1,0:35:29.08,0:35:33.63,JP-ja,NTP,0,0,0,,Іздеген батырлық рухтың шақыруға жауап беретіні сөзсіз.
Dialogue: 1,0:35:34.73,0:35:38.10,JP-ja,NTP,0,0,0,,Аңызға айналған рыцарь король Артур Пендрагон
Dialogue: 4,0:35:34.74,0:35:38.24,Default,,0,0,0,,Аты аңызға айналған Рыцарь патшасы Артур Пендрагон.
Dialogue: 4,0:35:38.82,0:35:42.62,Default,,0,0,0,,Менің онымен қаншалықты үйлесімді екендігім екінші кезектегі мәселе.
Dialogue: 1,0:35:38.85,0:35:40.72,JP-ja,NTP,0,0,0,,Шебер ретінде менімен үйлесімділігіңіз қандай?
Dialogue: 1,0:35:41.09,0:35:42.46,JP-ja,NTP,0,0,0,,Екінші орын алыңыз.
Dialogue: 4,0:35:43.04,0:35:49.79,Default,,0,0,0,,Бірақ Экскалибурды ұстаушы ретінде ол, әрине, қылыш класының ең күшті қызметшісі болуы керек.
Dialogue: 1,0:35:43.13,0:35:45.77,JP-ja,NTP,0,0,0,,Бірақ егер сіз «уәде етілген жеңіс қылышын» алып жүрсеңіз
Dialogue: 1,0:35:45.96,0:35:49.53,JP-ja,NTP,0,0,0,,Сабер сыныбының ең жақсы картасы.
Dialogue: 4,0:35:49.79,0:35:51.30,Default,,0,0,0,,Шынымен.
Dialogue: 1,0:35:49.98,0:35:50.63,JP-ja,NTP,0,0,0,,That's right.
Dialogue: 4,0:35:51.30,0:35:55.26,Default,,0,0,0,,Менде басқалардан әлдеқайда күшті Қызметші болады.
Dialogue: 1,0:35:51.49,0:35:54.89,JP-ja,NTP,0,0,0,,Менде ешкімнен жеңілмейтін қызметші болады.
Dialogue: 4,0:35:55.26,0:36:00.80,Default,,0,0,0,,Мәселе сол қуатты қалай пайдалануда.
Dialogue: 1,0:35:55.33,0:35:56.40,JP-ja,NTP,0,0,0,,Мәселе мынада
Dialogue: 1,0:35:57.00,0:36:00.69,JP-ja,NTP,0,0,0,,Мен бұл күшті күшті қалай толық пайдалануым керек?
Dialogue: 4,0:36:00.80,0:36:04.06,Default,,0,0,0,,Шынымды айтсам, пайдаланудың қарапайымдылығы бойынша,
Dialogue: 1,0:36:01.08,0:36:03.95,JP-ja,NTP,0,0,0,,Шынымды айтсам, өңдеудің қарапайымдылығы тұрғысынан
Dialogue: 4,0:36:04.06,0:36:08.64,Default,,0,0,0,,Кастер немесе Ассасин маған көбірек сәйкес келеді.
Dialogue: 1,0:36:04.27,0:36:06.29,JP-ja,NTP,0,0,0,,Кастер немесе өлтіруші
Dialogue: 1,0:36:06.41,0:36:08.59,JP-ja,NTP,0,0,0,,Бұл менің мінезіме өте сәйкес келді.
Dialogue: 4,0:36:09.30,0:36:12.81,Default,,0,0,0,,Егер сіз оны шақырмас бұрын уайымдасаңыз, не істейсіз?
Dialogue: 1,0:36:09.38,0:36:12.75,JP-ja,NTP,0,0,0,,Шақыру алдында уайымдасаңыз, көмектесе алмайды.
Dialogue: 1,0:36:13.47,0:36:16.96,JP-ja,NTP,0,0,0,,Рыцарлар патшасының шын мәнінде қандай адам екенін білмеймін.
Dialogue: 4,0:36:13.47,0:36:17.40,Default,,0,0,0,,Рыцарлар патшасының қандай болғанын білмейміз.
Dialogue: 1,0:36:17.40,0:36:20.46,JP-ja,NTP,0,0,0,,Сіздің стратегияңыз қандай болса да
Dialogue: 4,0:36:17.40,0:36:23.69,Default,,0,0,0,,Оның үстіне, сіздің тактикаңызға қарамастан, ол сіздің идеалыңызды, арманыңызды білгенде...
Dialogue: 1,0:36:20.79,0:36:23.53,JP-ja,NTP,0,0,0,,Арманың мен мұратыңды білсең
Dialogue: 4,0:36:24.19,0:36:27.36,Default,,0,0,0,,Оның түсінетініне сенімдімін.
Dialogue: 1,0:36:24.27,0:36:25.53,JP-ja,NTP,0,0,0,,Сіз түсінесіз.
Dialogue: 1,0:36:25.90,0:36:27.21,JP-ja,NTP,0,0,0,,Мүмкін ол
Dialogue: 4,0:36:29.45,0:36:30.95,Default,,0,0,0,,Дәл мен сияқты.
Dialogue: 1,0:36:29.61,0:36:30.83,JP-ja,NTP,0,0,0,,Мен сияқты
Dialogue: 4,0:36:36.41,0:36:37.16,Default,,0,0,0,,Жер
Dialogue: 1,0:36:36.44,0:36:37.13,JP-ja,NTP,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 4,0:36:37.71,0:36:39.75,Default,,0,0,0,,Мен стратегиямды анықтадым.
Dialogue: 1,0:36:37.74,0:36:39.05,JP-ja,NTP,0,0,0,,Маған жоспар келді
Dialogue: 4,0:36:39.75,0:36:41.46,Default,,0,0,0,,Ең жақсы әдіс...
Dialogue: 1,0:36:39.89,0:36:41.49,JP-ja,NTP,0,0,0,,Ең күшті қызметші
Dialogue: 4,0:36:43.38,0:36:46.09,Default,,0,0,0,,...ең күшті Қызметшіні пайдалану.
Dialogue: 1,0:36:43.48,0:36:46.18,JP-ja,NTP,0,0,0,,Ең күшті қуатты пайдаланудың жолы бар
Dialogue: 4,0:36:53.89,0:36:55.77,Default,,0,0,0,,Сәлем, Рин.
Dialogue: 1,0:36:53.96,0:36:55.29,JP-ja,NTP,0,0,0,,Сәлем Рин
Dialogue: 4,0:36:57.94,0:36:59.94,Default,,0,0,0,,Сәлем, Кирей.
Dialogue: 1,0:36:58.07,0:36:59.60,JP-ja,NTP,0,0,0,,Сәлем Кирей
Dialogue: 4,0:36:59.94,0:37:01.36,Default,,0,0,0,,Шығасыз ба?
Dialogue: 1,0:36:59.95,0:37:03.75,JP-ja,NTP,0,0,0,,Мен шығамын деп ойлаймын. Жүк көп сияқты.
Dialogue: 4,0:37:01.36,0:37:03.90,Default,,0,0,0,,Бұл жерде сізде көп жүк бар.
Dialogue: 1,0:37:03.90,0:37:07.71,JP-ja,NTP,0,0,0,,Е, мен сені бүгіннен бастап Өрізеннің үйінде қарайтын боламын.
Dialogue: 4,0:37:03.90,0:37:07.95,Default,,0,0,0,,Иә, мен бұдан былай Зенджу отбасында тұратын боламын.
Dialogue: 4,0:37:09.86,0:37:14.41,Default,,0,0,0,,Сіз менің әкеммен соғысу үшін қаласыз, солай ма?
Dialogue: 1,0:37:10.03,0:37:14.02,JP-ja,NTP,0,0,0,,Кирей әкеңнің қасында қалып, бірге соғысады, солай ма?
Dialogue: 4,0:37:14.41,0:37:17.91,Default,,0,0,0,,Сондықтан мен оның шәкірті ретінде осындамын.
Dialogue: 1,0:37:14.48,0:37:18.09,JP-ja,NTP,0,0,0,,Сол үшін сенің шәкіртің болып келдім.
Dialogue: 4,0:37:19.83,0:37:23.21,Default,,0,0,0,,Саған сенуге бола ма?
Dialogue: 1,0:37:19.93,0:37:22.70,JP-ja,NTP,0,0,0,,Кирей, мен саған сенсем болады ма?
Dialogue: 4,0:37:24.21,0:37:29.30,Default,,0,0,0,,Сіз маған әкемді соңына дейін қорғаймын деп уәде бересіз бе?
Dialogue: 1,0:37:24.35,0:37:28.82,JP-ja,NTP,0,0,0,,Әкеңді соңына дейін аман-есен қорғауға уәде бересің бе?
Dialogue: 4,0:37:29.30,0:37:31.72,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 1,0:37:29.38,0:37:31.50,JP-ja,NTP,0,0,0,,Бұл мүмкін емес сұрақ.
Dialogue: 4,0:37:31.72,0:37:36.31,Default,,0,0,0,,Егер шайқас мен бұл уәдені бере алатындай қарапайым болса,
Dialogue: 1,0:37:31.80,0:37:35.90,JP-ja,NTP,0,0,0,,Егер мұндай уәде беру үшін шайқас жеткілікті бейбіт болса.
Dialogue: 1,0:37:36.26,0:37:40.27,JP-ja,NTP,0,0,0,,Сізді немесе әйеліңізді эвакуациялаудың қажеті болмайды.
Dialogue: 4,0:37:36.31,0:37:39.98,Default,,0,0,0,,сізді де, анаңызды да жіберудің қажеті жоқ еді.
Dialogue: 4,0:37:43.11,0:37:47.07,Default,,0,0,0,,Мен сені ұната алмаймын.
Dialogue: 1,0:37:43.25,0:37:46.75,JP-ja,NTP,0,0,0,,Өйткені, мен саған ғашық бола алмаймын.
Dialogue: 1,0:37:47.02,0:37:51.45,JP-ja,NTP,0,0,0,,Рин Сіз өзіңіздің шынайы сезімдеріңізді көпшілік алдында бұлай білдірмеуіңіз керек.
Dialogue: 4,0:37:47.07,0:37:51.82,Default,,0,0,0,,Рин, өз ойыңды олай айтпауың керек.
Dialogue: 4,0:37:51.82,0:37:56.79,Default,,0,0,0,,Адамдар сізді өсірген әкеңіз туралы жаман ойлауы мүмкін.
Dialogue: 1,0:37:51.88,0:37:56.48,JP-ja,NTP,0,0,0,,Әйтпесе, сені тәрбиелеп отырған әкенің адалдығына күмән келтіріледі.
Dialogue: 1,0:37:56.77,0:37:58.64,JP-ja,NTP,0,0,0,,Әкеңнің бұған қатысы жоқ шығар.
Dialogue: 4,0:37:56.79,0:37:58.54,Default,,0,0,0,,Бұған менің әкемнің не қатысы бар?!
Dialogue: 4,0:37:58.54,0:38:00.00,Default,,0,0,0,,Тыңда, Кирей!
Dialogue: 1,0:37:58.94,0:37:59.84,JP-ja,NTP,0,0,0,,Жақсы Кирей
Dialogue: 4,0:38:00.00,0:38:05.91,Default,,0,0,0,,Әкем сені ренжітсе, сені кешірмеймін!
Dialogue: 1,0:38:00.03,0:38:03.93,JP-ja,NTP,0,0,0,,Егер сіз бұрыштарды кесіп, әкеңізді ренжітсеңіз,
Dialogue: 1,0:38:04.27,0:38:06.03,JP-ja,NTP,0,0,0,,Мен сені ешқашан кешірмеймін.
Dialogue: 4,0:38:06.38,0:38:10.43,Default,,0,0,0,,Рин, сен не деп айқайлап тұрсың?
Dialogue: 1,0:38:06.43,0:38:10.02,JP-ja,NTP,0,0,0,,Рин, сен дауыстап не істеп жатырсың?
Dialogue: 4,0:38:11.43,0:38:12.76,Default,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 1,0:38:11.47,0:38:12.23,JP-ja,NTP,0,0,0,,Жақсы
Dialogue: 1,0:38:13.64,0:38:14.44,JP-ja,NTP,0,0,0,,Бұл
Dialogue: 4,0:38:13.72,0:38:14.80,Default,,0,0,0,,Ой...
Dialogue: 1,0:38:14.79,0:38:19.35,JP-ja,NTP,0,0,0,,Біз қоштасар алдында ол мені жігерлендірді, ханым.
Dialogue: 4,0:38:14.80,0:38:19.64,Default,,0,0,0,,Қоштасар алдында ол маған көңіл көтерді, ханым.
Dialogue: 1,0:38:20.40,0:38:21.30,JP-ja,NTP,0,0,0,,Көмектесейік
Dialogue: 4,0:38:20.43,0:38:21.69,Default,,0,0,0,,Маған көмектесейін.
Dialogue: 1,0:38:21.59,0:38:24.52,JP-ja,NTP,0,0,0,,Ол чемодан сізге тым ауыр болады.
Dialogue: 4,0:38:21.69,0:38:24.98,Default,,0,0,0,,Бұл чемодан сізге тым ауыр.
Dialogue: 4,0:38:24.98,0:38:26.15,Default,,0,0,0,,Жақсы.
Dialogue: 1,0:38:25.08,0:38:27.51,JP-ja,NTP,0,0,0,,Мәселе жоқ, мұны өзіңіз жасай аласыз.
Dialogue: 4,0:38:26.15,0:38:27.15,Default,,0,0,0,,Мен оны өзім көтере аламын.
Dialogue: 1,0:38:27.70,0:38:28.83,JP-ja,NTP,0,0,0,,Котомине мырза
Dialogue: 4,0:38:27.78,0:38:32.11,Default,,0,0,0,,Котомине-сан, менің күйеуіме көңіл бөл.
Dialogue: 1,0:38:29.33,0:38:31.86,JP-ja,NTP,0,0,0,,Менің күйеуіме қамқорлық жасауыңызды өтінемін.
Dialogue: 4,0:38:32.11,0:38:34.78,Default,,0,0,0,,Оның тілегін орындауға көмектесіңіз.
Dialogue: 1,0:38:32.15,0:38:34.54,JP-ja,NTP,0,0,0,,Сол адамның тілегін орындаңыз.
Dialogue: 4,0:38:34.78,0:38:37.79,Default,,0,0,0,,Мен бар күшімді саламын. Уайымдама.
Dialogue: 1,0:38:35.16,0:38:37.79,JP-ja,NTP,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын, уайымдама.
Dialogue: 4,0:38:42.16,0:38:43.42,Default,,0,0,0,,Онда оны киемін!
Dialogue: 1,0:38:42.22,0:38:43.44,JP-ja,NTP,0,0,0,,Кешіріңіз
Dialogue: 4,0:38:44.12,0:38:46.54,Default,,0,0,0,,Өте жақсы уақыт.
Dialogue: 1,0:38:44.20,0:38:46.02,JP-ja,NTP,0,0,0,,Сіз дұрыс жерге келдіңіз.
Dialogue: 1,0:38:46.52,0:38:50.01,JP-ja,NTP,0,0,0,,Мен дайындаған қасиетті жәдігерлер бүгін таңертең келді.
Dialogue: 4,0:38:46.54,0:38:50.26,Default,,0,0,0,,Мен дайындаған жәдігер бүгін таңертең келді.
Dialogue: 1,0:38:50.20,0:38:51.46,JP-ja,NTP,0,0,0,,Қараңыз
Dialogue: 4,0:38:50.26,0:38:50.93,Default,,0,0,0,,Қарау.
Dialogue: 4,0:38:52.72,0:38:54.13,Default,,0,0,0,,Қандай сәнсіз...
Dialogue: 1,0:38:52.89,0:38:53.79,JP-ja,NTP,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 4,0:38:55.01,0:39:00.47,Default,,0,0,0,,Ежелгі уақытта төгілген алғашқы жылан терісінің қалдықтары.
Dialogue: 1,0:38:55.11,0:38:56.20,JP-ja,NTP,0,0,0,,Сонау ежелгі дәуір
Dialogue: 1,0:38:56.85,0:39:00.53,JP-ja,NTP,0,0,0,,Бұл дүниеде алғаш рет терісін төккен жыланның тасқа айналған қабығы.
Dialogue: 4,0:39:01.02,0:39:09.40,Default,,0,0,0,,Егер біз оны катализатор ретінде қолдансақ және біз нені іздейтінімізді шақыра алсақ, біздің жеңіске кепілдік беріледі.
Dialogue: 1,0:39:01.11,0:39:02.50,JP-ja,NTP,0,0,0,,Осы құрал арқылы
Dialogue: 1,0:39:02.72,0:39:05.05,JP-ja,NTP,0,0,0,,Егер сіз оны сәтті шақырсаңыз
Dialogue: 1,0:39:05.07,0:39:06.58,JP-ja,NTP,0,0,0,,Сол кезде
Dialogue: 1,0:39:06.83,0:39:09.43,JP-ja,NTP,0,0,0,,Біздің жеңісіміз бекітілді.
Dialogue: 1,0:39:15.45,0:39:17.04,JP-ja,NTP,0,0,0,,Сәлем Сакура-чан
Dialogue: 4,0:39:15.45,0:39:17.12,Default,,0,0,0,,Сәлем, Сакура-чан.
Dialogue: 4,0:39:18.20,0:39:19.75,Default,,0,0,0,,Мен сізді таң қалдырдым ба?
Dialogue: 1,0:39:18.29,0:39:19.30,JP-ja,NTP,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 4,0:39:19.99,0:39:22.12,Default,,0,0,0,,Жоқ, бірақ сіздің бетіңіз...
Dialogue: 1,0:39:20.10,0:39:21.97,JP-ja,NTP,0,0,0,,Иә бет
Dialogue: 4,0:39:22.12,0:39:24.08,Default,,0,0,0,,Білесіз бе...
Dialogue: 1,0:39:22.21,0:39:23.89,JP-ja,NTP,0,0,0,,О, сәл ғана.
Dialogue: 4,0:39:24.08,0:39:28.29,Default,,0,0,0,,Ішімдегі құрттардан тағы да жеңіліп қалған сияқтымын.
Dialogue: 1,0:39:24.17,0:39:27.93,JP-ja,NTP,0,0,0,,Мен тағы да ішімдегі қателіктерден өмірімнің біразын жоғалтқан сияқтымын.
Dialogue: 4,0:39:28.29,0:39:32.09,Default,,0,0,0,,Мен сен сияқты қатал емеспін деп ойлаймын, Сакура-чан.
Dialogue: 1,0:39:28.35,0:39:32.11,JP-ja,NTP,0,0,0,,Қарт Сакура-чан сияқты шыдамды емес екеніне сенімдімін.
Dialogue: 4,0:39:33.55,0:39:37.43,Default,,0,0,0,,Сіз басқа адамға айналып бара жатырсыз, солай емес пе?
Dialogue: 1,0:39:33.56,0:39:37.58,JP-ja,NTP,0,0,0,,Қария ағай барған сайын басқа адамға ұқсайды.
Dialogue: 4,0:39:40.01,0:39:42.02,Default,,0,0,0,,Мүмкін.
Dialogue: 1,0:39:40.04,0:39:41.60,JP-ja,NTP,0,0,0,,Мүмкін солай.
Dialogue: 4,0:39:42.27,0:39:46.73,Default,,0,0,0,,Маған бүгін кешке қателер бөлмесіне барудың қажеті жоқ.
Dialogue: 1,0:39:42.43,0:39:46.40,JP-ja,NTP,0,0,0,,Бүгін түнде мен жәндіктер қоймасына барудың қажеті жоқ.
Dialogue: 4,0:39:46.73,0:39:50.77,Default,,0,0,0,,Ата одан да маңызды рәсім болатынын айтты.
Dialogue: 1,0:39:46.74,0:39:50.40,JP-ja,NTP,0,0,0,,Ата одан да маңызды салтанат бар деді.
Dialogue: 1,0:39:50.74,0:39:52.25,JP-ja,NTP,0,0,0,,Мен олардың қазіргі күйінде Элкияны құтқара алатынына сенбеймін.
Dialogue: 4,0:39:50.77,0:39:52.48,Default,,0,0,0,,Ято-чанға бұны қолдануға қазір тым кеш.
Dialogue: 4,0:39:52.48,0:39:56.11,Default,,0,0,0,,Сондықтан мен оның орнына бүгін кешке жертөлеге барамын.
Dialogue: 1,0:39:52.57,0:39:55.91,JP-ja,NTP,0,0,0,,Бүгін кешке оның орнына ағам жертөлеге барады.
Dialogue: 4,0:39:56.11,0:39:59.87,Default,,0,0,0,,Қария аға, кетесіз бе?
Dialogue: 1,0:39:56.22,0:39:57.51,JP-ja,NTP,0,0,0,,Қария ағай
Dialogue: 1,0:39:57.68,0:39:59.52,JP-ja,NTP,0,0,0,,Мен алыс жерге барамын
Dialogue: 4,0:39:59.87,0:40:04.41,Default,,0,0,0,,Мен біраз уақыт маңызды жұмыспен айналысамын.
Dialogue: 1,0:39:59.88,0:40:01.03,JP-ja,NTP,0,0,0,,Алдағы уақытта
Dialogue: 1,0:40:01.22,0:40:04.12,JP-ja,NTP,0,0,0,,Ағам маңызды жұмыстармен айналысады.
Dialogue: 4,0:40:04.41,0:40:09.92,Default,,0,0,0,,Менің енді сенімен сөйлесуге көп уақытым болмайтын шығар.
Dialogue: 1,0:40:04.51,0:40:07.35,JP-ja,NTP,0,0,0,,Сакура-чанмен осылай сөйлесетін уақыт
Dialogue: 1,0:40:07.75,0:40:09.68,JP-ja,NTP,0,0,0,,Ол азырақ таралған болуы мүмкін.
Dialogue: 4,0:40:10.88,0:40:12.05,Default,,0,0,0,,Б... бір сызық
Dialogue: 1,0:40:10.97,0:40:11.88,JP-ja,NTP,0,0,0,,Иә
Dialogue: 4,0:40:13.13,0:40:14.64,Default,,0,0,0,,Сәлем, Сакура-чан.
Dialogue: 1,0:40:13.25,0:40:14.73,JP-ja,NTP,0,0,0,,Сәлем Сакура-чан
Dialogue: 4,0:40:14.64,0:40:19.39,Default,,0,0,0,,Мен жұмысты аяқтаған соң, неге бәріміз бір жерге барып, көңіл көтермейміз?
Dialogue: 1,0:40:14.90,0:40:16.85,JP-ja,NTP,0,0,0,,Ағамның жұмысы біткен соң
Dialogue: 1,0:40:17.04,0:40:19.22,JP-ja,NTP,0,0,0,,Тағы бәріміз бірге шығамыз ба?
Dialogue: 4,0:40:19.39,0:40:21.72,Default,,0,0,0,,Анаңмен және әпкеңмен?
Dialogue: 1,0:40:19.41,0:40:21.34,JP-ja,NTP,0,0,0,,Анаң мен әпкеңді де ала кел.
Dialogue: 4,0:40:22.35,0:40:27.15,Default,,0,0,0,,Менің анам немесе әпкем деп айтатын ешкімім жоқ...
Dialogue: 1,0:40:22.51,0:40:24.17,JP-ja,NTP,0,0,0,,Сенің анаң мен әпкең
Dialogue: 1,0:40:24.78,0:40:27.17,JP-ja,NTP,0,0,0,,Ешкім сені олай атай алмайды.
Dialogue: 4,0:40:27.73,0:40:32.69,Default,,0,0,0,,Атам олар ешқашан болмаған деп ойлауым керек деді.
Dialogue: 1,0:40:27.78,0:40:32.28,JP-ja,NTP,0,0,0,,«Ол жерде болмағандай кейіп таныт» деді қарт.
Dialogue: 4,0:40:34.40,0:40:35.99,Default,,0,0,0,,Б... бір сызық
Dialogue: 1,0:40:34.47,0:40:35.24,JP-ja,NTP,0,0,0,,Мен көремін.
Dialogue: 4,0:40:45.83,0:40:47.21,Default,,0,0,0,,Ағай?
Dialogue: 1,0:40:45.88,0:40:46.71,JP-ja,NTP,0,0,0,,Ағай
Dialogue: 1,0:40:47.09,0:40:51.56,JP-ja,NTP,0,0,0,,Олай болса, Тохсака отбасынан Аои-сан мен Рин-чанды алыңыз.
Dialogue: 4,0:40:47.21,0:40:55.97,Default,,0,0,0,,Тохсактардан Аои-сан мен Рин-чанды алып, алыс жерге барайық.
Dialogue: 1,0:40:51.84,0:40:53.91,JP-ja,NTP,0,0,0,,Нағашы мен Сакура-чан және төртеуміз
Dialogue: 1,0:40:54.02,0:40:55.79,JP-ja,NTP,0,0,0,,Алыс жерге барайық
Dialogue: 4,0:40:55.97,0:41:00.68,Default,,0,0,0,,Біз бұрынғыдай қайтадан бірге ойнай аламыз.
Dialogue: 1,0:40:56.15,0:41:00.44,JP-ja,NTP,0,0,0,,Бұрынғыдай тағы бірге ойнайық
Dialogue: 4,0:41:00.68,0:41:04.18,Default,,0,0,0,,Мен оларды қайтадан көре аламын ба?
Dialogue: 1,0:41:00.71,0:41:03.78,JP-ja,NTP,0,0,0,,Мен ол адамдарды қайтадан көремін бе?
Dialogue: 4,0:41:04.18,0:41:06.35,Default,,0,0,0,,Иә, болады.
Dialogue: 1,0:41:04.19,0:41:06.28,JP-ja,NTP,0,0,0,,Аа, біз тағы кездесетінімізге сенімдімін.
Dialogue: 4,0:41:06.35,0:41:08.98,Default,,0,0,0,,Мен сізге уәде беремін.
Dialogue: 1,0:41:06.45,0:41:08.57,JP-ja,NTP,0,0,0,,Ағай бұған уәде береді.
Dialogue: 4,0:41:13.61,0:41:17.90,Default,,0,0,0,,Ал, мен кетуім керек.
Dialogue: 1,0:41:13.71,0:41:14.55,JP-ja,NTP,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 1,0:41:15.68,0:41:17.64,JP-ja,NTP,0,0,0,,Ағай бармақшы.
Dialogue: 4,0:41:17.90,0:41:19.07,Default,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 4,0:41:20.28,0:41:22.83,Default,,0,0,0,,Сау болыңыз, Қария ағай.
Dialogue: 1,0:41:20.30,0:41:22.66,JP-ja,NTP,0,0,0,,Аман болыңыз Қария аға
Dialogue: 4,0:41:26.95,0:41:28.12,Default,,0,0,0,,Қош бол.
Dialogue: 4,0:41:29.62,0:41:33.05,Default,,0,0,0,,Сіз шақыру заклинаниясын үйрендіңіз, солай ма?
Dialogue: 1,0:41:29.75,0:41:33.03,JP-ja,NTP,0,0,0,,Сіз шақыру заклинаниясын жаттаған болуыңыз керек.
Dialogue: 4,0:41:33.71,0:41:34.63,Default,,0,0,0,,Оқу, оқу
Dialogue: 1,0:41:34.56,0:41:35.39,JP-ja,NTP,0,0,0,,Бұл жақсы.
Dialogue: 4,0:41:34.63,0:41:40.93,Default,,0,0,0,,Өте жақсы, бірақ мен сізге дуалға қосымша екі жол қосуды сұраймын.
Dialogue: 1,0:41:35.59,0:41:40.04,JP-ja,NTP,0,0,0,,Дегенмен, ортада тағы екі тармақ шығыршықталып тұр.
Dialogue: 4,0:41:40.93,0:41:42.34,Default,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 1,0:41:40.98,0:41:42.13,JP-ja,NTP,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 1,0:41:42.33,0:41:44.50,JP-ja,NTP,0,0,0,,Не, бұл қарапайым ма?
Dialogue: 4,0:41:42.34,0:41:44.72,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 4,0:41:44.72,0:41:52.77,Default,,0,0,0,,Кария, сенің сиқыршы дәрежесің басқа Мастерлерден сәл төмен.
Dialogue: 1,0:41:44.97,0:41:48.11,JP-ja,NTP,0,0,0,,Қария Сиқыршы дәрежесі қандай?
Dialogue: 1,0:41:48.34,0:41:52.43,JP-ja,NTP,0,0,0,,Басқа шеберлермен салыстырғанда, мен сәл ғана төменмін.
Dialogue: 4,0:41:52.77,0:41:55.57,Default,,0,0,0,,Бұл Қызметшіңіздің негізгі статистикасына әсер етеді.
Dialogue: 1,0:41:52.77,0:41:55.66,JP-ja,NTP,0,0,0,,Бұл қызметшінің негізгі қабілеттеріне де әсер етеді.
Dialogue: 4,0:41:55.57,0:42:03.45,Default,,0,0,0,,Бұл біз сол параметрлерді көтере алатын Қызметші класын таңдауымыз керек дегенді білдіреді.
Dialogue: 1,0:41:55.85,0:41:58.90,JP-ja,NTP,0,0,0,,Олай болса, түзету қызметші класына негізделген.
Dialogue: 1,0:41:59.06,0:42:02.72,JP-ja,NTP,0,0,0,,Параметрлердің өздерін көтеруіміз керек.
Dialogue: 4,0:42:03.82,0:42:11.00,Default,,0,0,0,,Қария, сен шақырған Қызметшіге «Берсерік» қасиетін қосуыңды қалаймын.
Dialogue: 1,0:42:03.92,0:42:04.87,JP-ja,NTP,0,0,0,,Қария
Dialogue: 1,0:42:05.28,0:42:07.30,JP-ja,NTP,0,0,0,,Бұл жолы шақырылатын қызметші
Dialogue: 1,0:42:07.45,0:42:10.60,JP-ja,NTP,0,0,0,,Сіз ессіздік қасиетін қосқыңыз келе ме?
Dialogue: 4,0:42:12.79,0:42:15.96,Default,,0,0,0,,Толтыр, толтыр, толтыр, толтыр, толтыр!
Dialogue: 1,0:42:12.94,0:42:15.89,JP-ja,NTP,0,0,0,,Жабу, жабу, жабу, жабу, жабу.
Dialogue: 4,0:42:16.42,0:42:18.63,Default,,0,0,0,,Бес рет қайталаңыз.
Dialogue: 1,0:42:16.55,0:42:18.22,JP-ja,NTP,0,0,0,,Бес рет қайталаңыз
Dialogue: 1,0:42:18.54,0:42:20.94,JP-ja,NTP,0,0,0,,Тек орындалу уақытын жойыңыз
Dialogue: 4,0:42:18.63,0:42:21.05,Default,,0,0,0,,Бірақ толтырылған кезде әрқайсысын жойыңыз.
Dialogue: 4,0:42:22.18,0:42:23.93,Default,,0,0,0,,Күміс пен болаттан жасалған негіз.
Dialogue: 1,0:42:22.21,0:42:23.96,JP-ja,NTP,0,0,0,,Негізінде күміс пен темір
Dialogue: 4,0:42:24.60,0:42:27.31,Default,,0,0,0,,Тастан жасалған іргетас және келісім-шарттар герцогы.
Dialogue: 1,0:42:24.70,0:42:26.86,JP-ja,NTP,0,0,0,,Негіз тасы және Келісім Ұлы Герцог
Dialogue: 4,0:42:27.31,0:42:30.19,Default,,0,0,0,,Баба, менің ұлы ұстазым Швайнорг.
Dialogue: 1,0:42:27.40,0:42:30.12,JP-ja,NTP,0,0,0,,Менің ата-бабам – қожайыным Швайорг.
Dialogue: 4,0:42:30.60,0:42:32.64,Default,,0,0,0,,Құлаған желді бөгейтін қабырға.
Dialogue: 1,0:42:30.66,0:42:32.07,JP-ja,NTP,0,0,0,,Құлаған желге қарсы қабырғалар
Dialogue: 1,0:42:32.48,0:42:33.99,JP-ja,NTP,0,0,0,,Төрт қақпа жабық
Dialogue: 4,0:42:32.64,0:42:34.35,Default,,0,0,0,,Барлық төрт бағыттың қақпасы жабылады.
Dialogue: 1,0:42:34.24,0:42:35.78,JP-ja,NTP,0,0,0,,Тәжден
Dialogue: 4,0:42:34.35,0:42:39.36,Default,,0,0,0,,Тәжден шығып, Патшалыққа апаратын айрық жолмен жүріңіз.
Dialogue: 1,0:42:36.11,0:42:38.93,JP-ja,NTP,0,0,0,,Патшалыққа апаратын үш жақты жолды айналдыр.
Dialogue: 4,0:42:39.69,0:42:44.70,Default,,0,0,0,,Батырлық рухты шақыру үшін осындай қарапайым рәсім жеткілікті ме?
Dialogue: 1,0:42:39.85,0:42:41.93,JP-ja,NTP,0,0,0,,Бұл батырлық рухты шақыру туралы.
Dialogue: 1,0:42:42.20,0:42:44.41,JP-ja,NTP,0,0,0,,Мен мұндай қарапайым рәсімге қарсы емеспін.
Dialogue: 4,0:42:44.70,0:42:46.95,Default,,0,0,0,,Таңқаларлық, иә.
Dialogue: 1,0:42:44.83,0:42:47.01,JP-ja,NTP,0,0,0,,Бұл біраз тақырыптан тыс болуы мүмкін.
Dialogue: 4,0:42:48.08,0:42:52.87,Default,,0,0,0,,Қызметшіні шақыру егжей-тегжейлі шақыруды қажет етпейді.
Dialogue: 1,0:42:48.14,0:42:52.73,JP-ja,NTP,0,0,0,,Қызметшіні шақыру үшін мұндай ауқымды рухты шақыру қажет емес.
Dialogue: 4,0:42:52.87,0:42:56.46,Default,,0,0,0,,Граил нақты шақыруды орындайды.
Dialogue: 1,0:42:53.06,0:42:56.57,JP-ja,NTP,0,0,0,,Қызметшілерді шын мәнінде шақыратын Қасиетті Граил.
Dialogue: 4,0:42:57.04,0:43:02.05,Default,,0,0,0,,As a Master, my job is to anchor the Heroic Spirit to this world once it appears
Dialogue: 1,0:42:57.06,0:42:58.53,JP-ja,NTP,0,0,0,,Шебер ретінде
Dialogue: 1,0:42:58.94,0:43:01.74,JP-ja,NTP,0,0,0,,Дүниенің осы жағына көрінетін қаһармандық рухты байланыстыр
Dialogue: 4,0:43:02.05,0:43:05.51,Default,,0,0,0,,және оған физикалық пішінді алу үшін жеткілікті мананы беріңіз.
Dialogue: 1,0:43:02.25,0:43:05.25,JP-ja,NTP,0,0,0,,Сізге қажет нәрсенің орындалуы үшін жеткілікті сиқырлы қуат беру.
Dialogue: 4,0:43:06.64,0:43:07.85,Default,,0,0,0,,Бұл жақсы болуы керек.
Dialogue: 1,0:43:06.69,0:43:07.44,JP-ja,NTP,0,0,0,,Жарайды.
Dialogue: 4,0:43:08.68,0:43:11.64,Default,,0,0,0,,Ири, реликті құрбандық үстеліне қойыңыз.
Dialogue: 1,0:43:08.78,0:43:09.19,JP-ja,NTP,0,0,0,,Айри
Dialogue: 1,0:43:09.99,0:43:11.50,JP-ja,NTP,0,0,0,,Қасиетті жәдігерлерді құрбандық үстеліне қойыңыз.
Dialogue: 1,0:43:12.39,0:43:15.17,JP-ja,NTP,0,0,0,,Содан кейін дайындық аяқталады.
Dialogue: 4,0:43:12.48,0:43:14.61,Default,,0,0,0,,Біздің дайындықтарымыз сонда аяқталады.
Dialogue: 4,0:43:15.06,0:43:16.23,Default,,0,0,0,,Мен ұсынамын.
Dialogue: 1,0:43:15.17,0:43:15.93,JP-ja,NTP,0,0,0,,айт
Dialogue: 4,0:43:16.23,0:43:18.52,Default,,0,0,0,,Менің бұйрығыммен келесің,
Dialogue: 1,0:43:16.52,0:43:18.41,JP-ja,NTP,0,0,0,,Сенің денең менің астымда.
Dialogue: 4,0:43:18.52,0:43:20.98,Default,,0,0,0,,және менің тағдырым сенің қылышың болады.
Dialogue: 1,0:43:18.60,0:43:21.16,JP-ja,NTP,0,0,0,,Менің тағдырым сенің қылышыңда
Dialogue: 4,0:43:20.98,0:43:23.15,Default,,0,0,0,,Қасиетті Граилдың шақыруын орындай отырып,
Dialogue: 1,0:43:21.16,0:43:22.92,JP-ja,NTP,0,0,0,,Қасиетті Граилдың жақындауына сәйкес
Dialogue: 1,0:43:23.01,0:43:27.10,JP-ja,NTP,0,0,0,,Бұл мағына Осы принципті ұстанатын болсаңыз, жауап беріңіз.
Dialogue: 4,0:43:23.15,0:43:27.28,Default,,0,0,0,,егер сіз осы ерік пен ақылға қосылсаңыз, маған жауап беріңіз!
Dialogue: 4,0:43:27.28,0:43:28.99,Default,,0,0,0,,Осымен ант етемін.
Dialogue: 1,0:43:27.57,0:43:28.78,JP-ja,NTP,0,0,0,,Ант
Dialogue: 4,0:43:29.41,0:43:31.70,Default,,0,0,0,,Мәңгілік дүниеде жақсының бәрі мен боламын.
Dialogue: 1,0:43:29.49,0:43:31.90,JP-ja,NTP,0,0,0,,Мен мәңгілікте барлық жақсылыққа айналатын адаммын.
Dialogue: 4,0:43:32.37,0:43:36.25,Default,,0,0,0,,Мәңгілік дүниеде зұлымдықтың әміршісі боламын.
Dialogue: 1,0:43:32.49,0:43:36.05,JP-ja,NTP,0,0,0,,Мәңгілік дүниеде барлық зұлымдықты тудырушы менмін.
Dialogue: 4,0:43:36.25,0:43:41.05,Default,,0,0,0,,Бірақ хаос жұқа көзді бұлтқа түсірсін.
Dialogue: 1,0:43:36.47,0:43:40.92,JP-ja,NTP,0,0,0,,Дегенмен, сіз бейберекетсіздікке толы көзбен қатысуыңыз керек.
Dialogue: 4,0:43:41.05,0:43:43.76,Default,,0,0,0,,Жындылық торында қалған сен.
Dialogue: 1,0:43:41.08,0:43:43.97,JP-ja,NTP,0,0,0,,Сіз жындылық торындағы тұтқынсыз.
Dialogue: 4,0:43:43.76,0:43:46.97,Default,,0,0,0,,Ал мен, сенің шынжырыңды ұстайтынмын!
Dialogue: 1,0:43:44.20,0:43:47.08,JP-ja,NTP,0,0,0,,Шынжырды ұстайтын менмін
Dialogue: 4,0:43:46.97,0:43:52.14,Default,,0,0,0,,Сен, Ұлы Үшбірлікке киінген жеті күн, шектеу шеңберінен шығасың.
Dialogue: 1,0:43:47.32,0:43:50.33,JP-ja,NTP,0,0,0,,Рухтың үш ұлы сөзін киген жеті аспансың.
Dialogue: 1,0:43:50.54,0:43:52.27,JP-ja,NTP,0,0,0,,Тоқтау шеңберінен келіңіз
Dialogue: 4,0:43:52.14,0:43:54.39,Default,,0,0,0,,Аспан таразысының сақшысы!
Dialogue: 1,0:43:52.46,0:43:54.20,JP-ja,NTP,0,0,0,,Таразыны сақтаушы
Dialogue: 4,0:44:26.09,0:44:29.89,Default,,0,0,0,,Біз бұл шайқаста жеңдік, Кирей.
Dialogue: 1,0:44:26.21,0:44:27.67,JP-ja,NTP,0,0,0,,Сен жеңдің, Кирей.
Dialogue: 1,0:44:28.39,0:44:29.69,JP-ja,NTP,0,0,0,,Бұл шайқас
Dialogue: 4,0:44:31.05,0:44:32.93,Default,,0,0,0,,Жеңіс біздікі!
Dialogue: 1,0:44:31.09,0:44:33.24,JP-ja,NTP,0,0,0,,Бұл біздің жеңісіміз.
Dialogue: 4,0:44:40.11,0:44:41.36,Default,,0,0,0,,Кім...
Dialogue: 1,0:44:40.17,0:44:40.97,JP-ja,NTP,0,0,0,,(Норияки) Уф. (Жан) Мм…
