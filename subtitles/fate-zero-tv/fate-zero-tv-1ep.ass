Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.92,0:00:13.01,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:13.59,0:00:15.18,Default,,0,0,0,,Кирицугу-сама!
Dialogue: 0,0:00:19.18,0:00:20.52,Default,,0,0,0,,Сіздің балаңыз дүниеге келді!
Dialogue: 0,0:00:24.52,0:00:25.94,Default,,0,0,0,,Өте сүйкімді...
Dialogue: 0,0:00:26.27,0:00:31.23,Default,,0,0,0,,Өте кішкентай және нәзік...
Dialogue: 0,0:00:32.32,0:00:36.45,Default,,0,0,0,,Қарашы, Кирицугу, оның көздері дәл сенікіне ұқсайды.
Dialogue: 0,0:00:40.74,0:00:45.08,Default,,0,0,0,,Мен бұл баланы дүниеге әкелгеніме өте қуаныштымын.
Dialogue: 0,0:00:51.30,0:00:52.21,Default,,0,0,0,,Айри
Dialogue: 0,0:00:54.51,0:00:58.60,Default,,0,0,0,,Мен... сені өлтіруге мәжбүр боламын.
Dialogue: 0,0:01:05.69,0:01:06.98,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:01:07.65,0:01:11.82,Default,,0,0,0,,Бұл Эйнцберннің көптен күткен тілегі, сондықтан мен
Dialogue: 0,0:01:12.82,0:01:14.74,Default,,0,0,0,,Өз идеалыңызды біліңіз
Dialogue: 0,0:01:14.82,0:01:17.57,Default,,0,0,0,,Өйткені біз жүрегімізде бір дұғаны ұстандық
Dialogue: 0,0:01:17.66,0:01:19.99,Default,,0,0,0,,Сондықтан мен бүгін кіммін.
Dialogue: 0,0:01:21.16,0:01:23.62,Default,,0,0,0,,Мені тура жолға салдың
Dialogue: 0,0:01:24.16,0:01:27.00,Default,,0,0,0,,Маған қуыршақ болмай өмір сүруге мүмкіндік берді
Dialogue: 0,0:01:28.46,0:01:30.71,Default,,0,0,0,,Мені жоқтаудың қажеті жоқ
Dialogue: 0,0:01:30.84,0:01:33.71,Default,,0,0,0,,Мен сенің бір бөлігіңмін
Dialogue: 0,0:01:34.67,0:01:35.97,Default,,0,0,0,,Сонымен... (Кирицугу) Маған...
Dialogue: 0,0:01:38.80,0:01:45.64,Default,,0,0,0,,Мен... ол баланы ұстауға жарамды емеспін...
Dialogue: 0,0:01:49.60,0:01:52.02,Default,,0,0,0,,Кирицугу Ұмытпаңыз
Dialogue: 0,0:01:53.44,0:01:56.07,Default,,0,0,0,,Ешкім осылай жыламайтын дүние
Dialogue: 0,0:01:56.36,0:02:01.20,Default,,0,0,0,,Кирицугу Эмия ретінде армандаған идеалыңыз осы емес пе?
Dialogue: 0,0:02:03.08,0:02:07.00,Default,,0,0,0,,8 жыл қалды, сонда сіздің шайқасыңыз бітеді.
Dialogue: 0,0:02:08.58,0:02:11.00,Default,,0,0,0,,Сіз бен біз мұратымызға жетеміз
Dialogue: 0,0:02:12.00,0:02:15.71,Default,,0,0,0,,Қасиетті Граил сені құтқаратынына сенімдімін.
Dialogue: 0,0:02:17.05,0:02:19.09,Default,,0,0,0,,Сонымен, бұл бала
Dialogue: 0,0:02:19.22,0:02:21.39,Default,,0,0,0,,Ильясвиелді ұстаңыз
Dialogue: 0,0:02:22.14,0:02:28.02,Default,,0,0,0,,Мақтанышпен, кәдімгі әке ретінде
Dialogue: 0,0:03:03.55,0:03:04.55,Default,,0,0,0,,Пәрмен емлесі?
Dialogue: 0,0:03:04.76,0:03:07.22,Default,,0,0,0,,Оң қолыңызда пайда болған үлгі
Dialogue: 0,0:03:07.64,0:03:10.48,Default,,0,0,0,,Бұл менің Қасиетті Граил ретінде таңдалғанымның дәлелі.
Dialogue: 0,0:03:10.60,0:03:13.81,Default,,0,0,0,,Бұл бақылау қызметшілеріне берілген стигма.
Dialogue: 0,0:03:15.61,0:03:17.11,Default,,0,0,0,,Котомине Кирей-кун
Dialogue: 0,0:03:18.57,0:03:20.70,Default,,0,0,0,,Қасиетті Граил соғысы
Dialogue: 0,0:03:20.82,0:03:23.95,Default,,0,0,0,,Ғажайып тілек машинасы үшін шайқаста
Dialogue: 0,0:03:24.91,0:03:26.20,Default,,0,0,0,,Мен?
Dialogue: 0,0:03:26.28,0:03:27.45,Default,,0,0,0,,Бастапқыда
Dialogue: 0,0:03:27.58,0:03:30.79,Default,,0,0,0,,Қасиетті Граил қызметші ретінде таңдаған жеті адам
Dialogue: 0,0:03:30.87,0:03:33.25,Default,,0,0,0,,Олардың барлығы сиқыршы болуы керек.
Dialogue: 0,0:03:33.33,0:03:35.71,Default,,0,0,0,,Сіз сияқты сиқырға қатысы жоқ біреу
Dialogue: 0,0:03:35.79,0:03:38.50,Default,,0,0,0,,Қасиетті Граалды осындай ерте кезеңде көре алу...
Dialogue: 0,0:03:38.63,0:03:40.63,Default,,0,0,0,,Бұл өте ерекше болар еді.
Dialogue: 0,0:03:41.09,0:03:42.72,Default,,0,0,0,,Қызметші…
Dialogue: 0,0:03:43.05,0:03:44.55,Default,,0,0,0,,Шақырылған батырлық рух
Dialogue: 0,0:03:44.64,0:03:48.39,Default,,0,0,0,,Сондай-ақ олардың бір-бірімен таныс адамдар ретінде соғысуы мүмкін ...
Dialogue: 0,0:03:48.47,0:03:52.52,Default,,0,0,0,,Жарайды, менің ойымша, бір қарағанда сену қиын.
Dialogue: 0,0:03:52.64,0:03:56.56,Default,,0,0,0,,Әр дәуір мен елдің батырлары жаңа заманда қайта жаңғырды.
Dialogue: 0,0:03:56.65,0:03:58.73,Default,,0,0,0,,Үстемдік үшін жарысу үшін бір-бірін өлтіру
Dialogue: 0,0:04:00.86,0:04:02.74,Default,,0,0,0,,Бұл Қасиетті Граил соғысы.
Dialogue: 0,0:04:03.03,0:04:06.37,Default,,0,0,0,,Әрине, текетірес жасырын түрде өтеді.
Dialogue: 0,0:04:06.49,0:04:07.99,Default,,0,0,0,,Айтылмаған өсиет
Dialogue: 0,0:04:08.12,0:04:09.99,Default,,0,0,0,,Мұны қамтамасыз ету үшін
Dialogue: 0,0:04:10.08,0:04:13.75,Default,,0,0,0,,Біздің собор шіркеуінен бақылаушы жіберіледі.
Dialogue: 0,0:04:14.00,0:04:16.67,Default,,0,0,0,,Сиқыршының күресі туралы үкім
Dialogue: 0,0:04:16.75,0:04:19.50,Default,,0,0,0,,Біз шіркеу мүшелері қызмет етеміз бе?
Dialogue: 0,0:04:20.30,0:04:22.30,Default,,0,0,0,,Сиқырлы шіркеуде...
Dialogue: 0,0:04:22.38,0:04:25.84,Default,,0,0,0,,Шектеулерге байланысты әділ төрешілік мүмкін емес
Dialogue: 0,0:04:27.01,0:04:30.77,Default,,0,0,0,,Осы жағдайларға байланысты 60 жыл бұрынғы соңғы уақыттан кейін,
Dialogue: 0,0:04:30.85,0:04:34.27,Default,,0,0,0,,Әкем біздің шайқасымызды бақылайды.
Dialogue: 0,0:04:34.56,0:04:36.85,Default,,0,0,0,,Әкесі Фуюки елінде...
Dialogue: 0,0:04:38.15,0:04:41.11,Default,,0,0,0,,Дегенмен, директордың жақын туыстары
Dialogue: 0,0:04:41.19,0:04:45.36,Default,,0,0,0,,Қасиетті Граил соғысына қатысу қиын емес пе?
Dialogue: 0,0:04:45.49,0:04:46.41,Default,,0,0,0,,Токиоми-кун
Dialogue: 0,0:04:47.53,0:04:50.12,Default,,0,0,0,,Енді негізгі тақырыпқа көшейік.
Dialogue: 0,0:04:51.20,0:04:53.87,Default,,0,0,0,,Кирей Әзірге бүкіл оқиға...
Dialogue: 0,0:04:54.00,0:04:57.71,Default,,0,0,0,,Бұл Қасиетті Граил соғысына қатысты үстірт жағдай ғана.
Dialogue: 0,0:04:57.79,0:04:59.88,Default,,0,0,0,,Бүгін мен сендермен осылаймын
Dialogue: 0,0:04:59.96,0:05:04.01,Default,,0,0,0,,Токиоми Тохсака мырзаны жинағанымның тағы бір себебі бар.
Dialogue: 0,0:05:04.09,0:05:05.88,Default,,0,0,0,,дейсіз бе?
Dialogue: 0,0:05:06.01,0:05:09.22,Default,,0,0,0,,Шын мәнінде, Фуюкиде пайда болатын Қасиетті Граил
Dialogue: 0,0:05:09.30,0:05:12.85,Default,,0,0,0,,Оның Құдай Ұлының қасиетті жәдігерлерінен айырмашылығы бар екені анық па?
Dialogue: 0,0:05:12.93,0:05:15.10,Default,,0,0,0,,Ол ұзақ уақыт бұрын жойылған.
Dialogue: 0,0:05:15.23,0:05:16.52,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:05:16.64,0:05:19.52,Default,,0,0,0,,Әйтпесе, біз сегізінші қасиетті рәсімге барамыз.
Dialogue: 0,0:05:19.61,0:05:22.07,Default,,0,0,0,,Оны алудың өмірі қысқаруда болуы керек.
Dialogue: 0,0:05:22.28,0:05:26.90,Default,,0,0,0,,Бірақ Фуюкидің Қасиетті Грейлі жалғыз қалу үшін тым күшті.
Dialogue: 0,0:05:27.03,0:05:29.57,Default,,0,0,0,,Өйткені, бұл құдіретті тілек машинасы.
Dialogue: 0,0:05:29.66,0:05:31.83,Default,,0,0,0,,Егер ол сізге ұнамайтын біреудің қолына түссе,
Dialogue: 0,0:05:31.91,0:05:34.16,Default,,0,0,0,,Бұл қандай апат әкеледі...
Dialogue: 0,0:05:34.70,0:05:37.58,Default,,0,0,0,,Содан кейін келесі ең жақсы нұсқа ретінде
Dialogue: 0,0:05:37.71,0:05:41.59,Default,,0,0,0,,Егер Фуюкидің Қасиетті Граясын қалаулы адамға аманат етудің жолы болса.
Dialogue: 0,0:05:41.71,0:05:43.92,Default,,0,0,0,,Бұдан жақсы ештеңе жоқ.
Dialogue: 0,0:05:44.30,0:05:47.72,Default,,0,0,0,,Тохсака отбасы сиқыршылар отбасы болса да,
Dialogue: 0,0:05:47.93,0:05:50.93,Default,,0,0,0,,Шіркеумен байланысты ұзақ тарихы бар отбасы.
Dialogue: 0,0:05:51.01,0:05:55.27,Default,,0,0,0,,Мен Токиоми-кунның тұлғасына да кепілдік бере аламын.
Dialogue: 0,0:05:55.39,0:05:59.52,Default,,0,0,0,,Ең бастысы, ол Қасиетті Граильді пайдалануды нақты белгілейді.
Dialogue: 0,0:05:59.85,0:06:01.86,Default,,0,0,0,,Түбірге жету
Dialogue: 0,0:06:01.94,0:06:05.19,Default,,0,0,0,,Тоқсақымыздың жалынды тілегі сол бір тұста ерекше.
Dialogue: 0,0:06:05.65,0:06:10.62,Default,,0,0,0,,Дегенмен, бір кездері бірдей ұмтылыстарға ие болған Эйнцберн мен Мату,
Dialogue: 0,0:06:10.74,0:06:13.41,Default,,0,0,0,,Ол өзінің бастапқы ниетін мүлде ұмытты.
Dialogue: 0,0:06:13.74,0:06:16.62,Default,,0,0,0,,Сонымен қатар, сырттан шақырылған магистрлерге қатысты,
Dialogue: 0,0:06:16.70,0:06:18.41,Default,,0,0,0,,Айтудың қажеті жоқ
Dialogue: 0,0:06:18.50,0:06:20.96,Default,,0,0,0,,Қандай таяз қалаулар үшін
Dialogue: 0,0:06:21.08,0:06:24.13,Default,,0,0,0,,Қасиетті Граилға ұмтылу белгісіз.
Dialogue: 0,0:06:24.25,0:06:29.13,Default,,0,0,0,,Сонымен, Токиоми Тохсака мырзаның жеңіске жетуі үшін,
Dialogue: 0,0:06:29.26,0:06:32.60,Default,,0,0,0,,Келесі Қасиетті Граил соғысына қатысуым керек пе?
Dialogue: 0,0:06:32.72,0:06:35.43,Default,,0,0,0,,Әрине, сырттай сен де, мен де
Dialogue: 0,0:06:35.52,0:06:37.73,Default,,0,0,0,,Қасиетті Граил үшін жарысатын жаулар ретінде
Dialogue: 0,0:06:37.81,0:06:39.27,Default,,0,0,0,,Өзімізді ұстайық
Dialogue: 0,0:06:39.69,0:06:43.69,Default,,0,0,0,,Бірақ біз күш біріктіріп, сахна артында бірге күресеміз.
Dialogue: 0,0:06:43.98,0:06:47.07,Default,,0,0,0,,Қалған бес қожаны жою және жою.
Dialogue: 0,0:06:47.15,0:06:49.70,Default,,0,0,0,,Нақтырақ жеңіске жету үшін
Dialogue: 0,0:06:50.70,0:06:52.49,Default,,0,0,0,,Міне, Кирей-күн.
Dialogue: 0,0:06:52.82,0:06:54.70,Default,,0,0,0,,Сіз жіберілдіңіз
Dialogue: 0,0:06:54.83,0:06:57.70,Default,,0,0,0,,Қасиетті шіркеуден Сиқырлы шіркеуге ауыстырылды
Dialogue: 0,0:06:57.83,0:06:59.83,Default,,0,0,0,,Менің шәкіртім бол
Dialogue: 0,0:06:59.96,0:07:02.29,Default,,0,0,0,,Ресми тағайындау әлдеқашан шығарылды.
Dialogue: 0,0:07:02.83,0:07:06.21,Default,,0,0,0,,Сіз менің Жапониядағы отбасымда сиқыршылықпен айналысу үшін көп жұмыс істеп жатырсыз.
Dialogue: 0,0:07:06.34,0:07:09.59,Default,,0,0,0,,Үш жылдан кейін Қасиетті Граил соғысы алдында қызметшіге мойынсұн.
Dialogue: 0,0:07:09.72,0:07:12.30,Default,,0,0,0,,Ұрысқа шебер ретінде қатысуға жеткілікті
Dialogue: 0,0:07:12.39,0:07:14.85,Default,,0,0,0,,Сиқыршы болуы керек
Dialogue: 0,0:07:19.10,0:07:19.93,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:07:20.23,0:07:22.73,Default,,0,0,0,,Сұрақтарыңыз бар ма? Кирей
Dialogue: 0,0:07:22.98,0:07:24.02,Default,,0,0,0,,Бір ғана
Dialogue: 0,0:07:26.02,0:07:29.49,Default,,0,0,0,,Шеберді таңдайтын Қасиетті Граилдың еркі
Dialogue: 0,0:07:29.57,0:07:31.82,Default,,0,0,0,,Бұл нақты не?
Dialogue: 0,0:07:34.78,0:07:38.16,Default,,0,0,0,,Қасиетті Граил оған шын жүректен мұқтаж адамдардан келеді.
Dialogue: 0,0:07:38.24,0:07:40.71,Default,,0,0,0,,Негізгі таңдауға басымдық беріңіз
Dialogue: 0,0:07:40.83,0:07:44.67,Default,,0,0,0,,Сонымен, әрбір Ұстаздың Қасиетті Граильді қалайтын себебі бар ма?
Dialogue: 0,0:07:44.75,0:07:46.54,Default,,0,0,0,,Міндетті емес.
Dialogue: 0,0:07:46.67,0:07:50.21,Default,,0,0,0,,Бұрын бастапқыда іріктелмеген тәртіпсіз адамдар болған.
Dialogue: 0,0:07:50.30,0:07:53.05,Default,,0,0,0,,Ол кейде командалық заклинаниелерді сақтайтын сияқты...
Dialogue: 0,0:07:54.22,0:07:56.51,Default,,0,0,0,,Әй, түсіндім, Кирей-күн
Dialogue: 0,0:07:57.01,0:08:00.77,Default,,0,0,0,,Таңдалғаныңызды әлі де түсінбейсіз.
Dialogue: 0,0:08:03.77,0:08:07.19,Default,,0,0,0,,Ол мен күткеннен де оңай келісті.
Dialogue: 0,0:08:07.48,0:08:12.24,Default,,0,0,0,,Егер қауымның еркі болса, ұлы отқа секіреді.
Dialogue: 0,0:08:12.36,0:08:15.16,Default,,0,0,0,,Шынымды айтсам, мен қатты таң қалдым.
Dialogue: 0,0:08:15.57,0:08:17.03,Default,,0,0,0,,Оның көзқарасы бойынша
Dialogue: 0,0:08:17.12,0:08:19.58,Default,,0,0,0,,Маған еш қатысы жоқ төбелеске түсіп қалдым.
Dialogue: 0,0:08:19.66,0:08:21.75,Default,,0,0,0,,Дәл солай болар еді.
Dialogue: 0,0:08:22.25,0:08:24.42,Default,,0,0,0,,Жоқ, бұл үшін.
Dialogue: 0,0:08:24.50,0:08:27.04,Default,,0,0,0,,Мүмкін бұл менің құтқарылуым болды.
Dialogue: 0,0:08:28.00,0:08:32.13,Default,,0,0,0,,Күні кеше ғана ол әйелінен айырылды.
Dialogue: 0,0:08:32.26,0:08:35.64,Default,,0,0,0,,Фокусыңызды өзгертіп, жаңа миссияны қабылдауға болады.
Dialogue: 0,0:08:35.97,0:08:40.64,Default,,0,0,0,,Қазір Кирей үшін бұл оның жараларын емдеудің төте жолы болуы мүмкін.
Dialogue: 0,0:08:51.19,0:08:52.32,Default,,0,0,0,,Аои-сан
Dialogue: 0,0:08:54.65,0:08:55.53,Default,,0,0,0,,Иә
Dialogue: 0,0:08:57.53,0:08:59.62,Default,,0,0,0,,Қария-күн, көптен бері көрмедім
Dialogue: 0,0:08:59.70,0:09:01.66,Default,,0,0,0,,Іссапардан оралдыңыз ба?
Dialogue: 0,0:09:01.79,0:09:04.50,Default,,0,0,0,,Бұл жолы әлдеқайда ұзағырақ болды.
Dialogue: 0,0:09:04.62,0:09:06.79,Default,,0,0,0,,Ах... жақсы.
Dialogue: 0,0:09:07.38,0:09:08.79,Default,,0,0,0,,Қария аға!
Dialogue: 0,0:09:09.34,0:09:10.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:10.88,0:09:12.96,Default,,0,0,0,,Қария ағай Қош келдіңіз!
Dialogue: 0,0:09:13.38,0:09:14.55,Default,,0,0,0,,Рин-чан
Dialogue: 0,0:09:15.30,0:09:17.80,Default,,0,0,0,,Маған тағы да кәдесый сатып алдың ба?
Dialogue: 0,0:09:17.89,0:09:20.72,Default,,0,0,0,,Бұл Риннің жаман мінез-құлқы...
Dialogue: 0,0:09:22.72,0:09:24.98,Default,,0,0,0,,Иә (Рин) Уау!
Dialogue: 0,0:09:25.10,0:09:27.60,Default,,0,0,0,,Ахаха хехехе...
Dialogue: 0,0:09:27.73,0:09:29.52,Default,,0,0,0,,Рахмет, ағай!
Dialogue: 0,0:09:29.65,0:09:32.61,Default,,0,0,0,,Ұнаса ағай да қуанады.
Dialogue: 0,0:09:36.15,0:09:37.36,Default,,0,0,0,,Сакура-чан ше?
Dialogue: 0,0:09:40.99,0:09:43.58,Default,,0,0,0,,Шие гүлдері жоғалып кетті
Dialogue: 0,0:09:43.70,0:09:46.08,Default,,0,0,0,,Иә? Ах... (Риннің кетіп бара жатқан дыбысы)
Dialogue: 0,0:09:48.25,0:09:49.21,Default,,0,0,0,,Аои-сан?
Dialogue: 0,0:09:49.83,0:09:55.01,Default,,0,0,0,,Сакура енді менің қызым немесе Риннің әпкесі емес.
Dialogue: 0,0:09:56.76,0:10:00.76,Default,,0,0,0,,Сол қыз... Матудың үйіне барды.
Dialogue: 0,0:10:02.18,0:10:03.35,Default,,0,0,0,,Неге!
Dialogue: 0,0:10:03.85,0:10:08.14,Default,,0,0,0,,Матудың сиқыршының қанын иемденетін перзентті қалайтынының себебі
Dialogue: 0,0:10:09.19,0:10:11.90,Default,,0,0,0,,Әрине түсінер едіңіз, солай ма?
Dialogue: 0,0:10:15.28,0:10:18.61,Default,,0,0,0,,Менің ескі одақтасым Матудың өтінішіне жауап ретінде,
Dialogue: 0,0:10:18.70,0:10:21.53,Default,,0,0,0,,Тохсака отағасы осылай шешті.
Dialogue: 0,0:10:21.66,0:10:24.04,Default,,0,0,0,,Пікір айта алмаймын.
Dialogue: 0,0:10:25.70,0:10:27.12,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:10:27.71,0:10:30.63,Default,,0,0,0,,Мен Тохсака отбасына үйленуге шешім қабылдағанда...
Dialogue: 0,0:10:30.71,0:10:33.67,Default,,0,0,0,,Мен сиқыршының әйелі болуды шешкен сәттен бастап
Dialogue: 0,0:10:33.79,0:10:35.96,Default,,0,0,0,,Мен осындай нәрсеге дайындалдым.
Dialogue: 0,0:10:36.21,0:10:37.84,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:10:37.92,0:10:40.64,Default,,0,0,0,,Сиқыршылардың қанын иеленген отбасы
Dialogue: 0,0:10:40.72,0:10:44.85,Default,,0,0,0,,Қарапайым отбасы бақытын іздеу қате.
Dialogue: 0,0:10:44.97,0:10:46.06,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:10:46.18,0:10:48.85,Default,,0,0,0,,Онымен бақытты болғың келеді...
Dialogue: 0,0:10:48.93,0:10:52.73,Default,,0,0,0,,Бұл Тохсака мен Мату арасындағы мәселе.
Dialogue: 0,0:10:53.02,0:10:55.65,Default,,0,0,0,,Сиқыршылар әлемінен бет бұрған саған
Dialogue: 0,0:10:56.40,0:10:58.11,Default,,0,0,0,,Бір-бірімен байланысы жоқ әңгіме
Dialogue: 0,0:11:02.41,0:11:05.08,Default,,0,0,0,,Егер мен шие гүлдерін кездестірсем
Dialogue: 0,0:11:05.16,0:11:06.66,Default,,0,0,0,,Маған мейірімді бол
Dialogue: 0,0:11:07.66,0:11:11.58,Default,,0,0,0,,Мен сол Кария-кун деген балаға бауыр басып қалдым.
Dialogue: 0,0:11:14.59,0:11:18.42,Default,,0,0,0,,Төбелескендер көңіл айтып жүретін.
Dialogue: 0,0:11:20.26,0:11:23.64,Default,,0,0,0,,Ол жағын маған қайтадан көрсету керек.
Dialogue: 0,0:11:23.76,0:11:26.72,Default,,0,0,0,,Саған айтқаныма сенімдімін.
Dialogue: 0,0:11:27.14,0:11:28.10,Default,,0,0,0,,Қария
Dialogue: 0,0:11:28.43,0:11:30.81,Default,,0,0,0,,Олар Тохсақаның екінші қызын асырап алған көрінеді.
Dialogue: 0,0:11:31.23,0:11:33.73,Default,,0,0,0,,Жақтар... жылдам құлақтар
Dialogue: 0,0:11:34.11,0:11:35.61,Default,,0,0,0,,Сол дәрежеде
Dialogue: 0,0:11:35.69,0:11:38.98,Default,,0,0,0,,Матудың қанында сиқыршы элементті сақтағыңыз келе ме?
Dialogue: 0,0:11:39.40,0:11:42.74,Default,,0,0,0,,Сіз мұны мазақ етесіз бе? Сізден басқа ешкім.
Dialogue: 0,0:11:42.82,0:11:43.99,Default,,0,0,0,,Кім кінәлі?
Dialogue: 0,0:11:44.12,0:11:47.58,Default,,0,0,0,,Мату осыншама дейін төмендеді деп ойлайсыз ба?
Dialogue: 0,0:11:48.20,0:11:49.20,Default,,0,0,0,,Қария
Dialogue: 0,0:11:49.79,0:11:54.63,Default,,0,0,0,,Егер Онуши әулет басын адалдықпен мұрагер етіп, Матудың құпиясын мұра еткен болса.
Dialogue: 0,0:11:54.71,0:11:57.38,Default,,0,0,0,,Жағдай өте ауыр.
Dialogue: 0,0:11:57.46,0:11:59.55,Default,,0,0,0,,Бұл сен...
Dialogue: 0,0:11:59.63,0:12:01.84,Default,,0,0,0,,Бұл фарсты тоқтат, вампир.
Dialogue: 0,0:12:02.51,0:12:05.59,Default,,0,0,0,,Өз өлместігіңе жету үшін,
Dialogue: 0,0:12:05.68,0:12:07.76,Default,,0,0,0,,Менің ойымша, ол тек Қасиетті Граильді қалайды.
Dialogue: 0,0:12:07.85,0:12:09.31,Default,,0,0,0,,Хаха...
Dialogue: 0,0:12:10.02,0:12:13.44,Default,,0,0,0,,60 жылдық цикл келесі жылы келеді
Dialogue: 0,0:12:13.52,0:12:18.61,Default,,0,0,0,,Бірақ төртінші Қасиетті Граил соғысында Матуда ойнайтын фигура жоқ.
Dialogue: 0,0:12:18.69,0:12:19.90,Default,,0,0,0,,Сіз мадамашимосыз
Dialogue: 0,0:12:19.98,0:12:24.53,Default,,0,0,0,,Менің ағам Цуруноның сиқырлы күші қызметшіні басқара алмайды.
Dialogue: 0,0:12:24.91,0:12:27.58,Default,,0,0,0,,Бұл шайқасты кейінге қалдыру керек болса да,
Dialogue: 0,0:12:27.66,0:12:30.87,Default,,0,0,0,,Алдағы 60 жылда табысқа жету мүмкіндігі бар
Dialogue: 0,0:12:31.50,0:12:33.33,Default,,0,0,0,,Тохсақа қызының плацентасынан
Dialogue: 0,0:12:33.41,0:12:36.83,Default,,0,0,0,,Тамаша сиқыршы міндетті түрде дүниеге келеді.
Dialogue: 0,0:12:36.96,0:12:40.92,Default,,0,0,0,,Ол заттың ыдыс ретінде үміті көп.
Dialogue: 0,0:12:41.01,0:12:45.09,Default,,0,0,0,,​​Егер солай болса, мен Қасиетті Граильді ала алсам ғой.
Dialogue: 0,0:12:45.18,0:12:47.76,Default,,0,0,0,,Тохсака: Шие гүлінің пайдасы жоқ.
Dialogue: 0,0:12:49.05,0:12:51.85,Default,,0,0,0,,Сіз не ойлайсыз?
Dialogue: 0,0:12:52.39,0:12:54.35,Default,,0,0,0,,Бұл мәміле, Зоукен
Dialogue: 0,0:12:55.02,0:12:58.73,Default,,0,0,0,,Келесі Қасиетті Граил соғысында Матуға Қасиетті Граалды қайтарамын.
Dialogue: 0,0:12:59.52,0:13:03.03,Default,,0,0,0,,Оның орнына Тохсака Сакураны босатыңыз.
Dialogue: 0,0:13:03.11,0:13:05.78,Default,,0,0,0,,Хахаха... мені ақымақ деп атаңыз
Dialogue: 0,0:13:06.20,0:13:09.83,Default,,0,0,0,,Бүгінгі күнге дейін ешқандай жаттығу жасамаған тентек...
Dialogue: 0,0:13:09.91,0:13:14.33,Default,,0,0,0,,Сіз небәрі бір жылдың ішінде қызметші шебері болғыңыз келе ме?
Dialogue: 0,0:13:14.91,0:13:18.25,Default,,0,0,0,,Сізде мұны мүмкін ететін құпия техника бар шығар.
Dialogue: 0,0:13:18.54,0:13:21.05,Default,,0,0,0,,Сіздің қателерді жоюшы мамандығыңыз
Dialogue: 0,0:13:23.84,0:13:24.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:25.47,0:13:27.68,Default,,0,0,0,,Маған із қалдырыңыз
Dialogue: 0,0:13:28.43,0:13:31.18,Default,,0,0,0,,Қария... Сіз өлуді жоспарлап отырсыз ба?
Dialogue: 0,0:13:31.26,0:13:34.23,Default,,0,0,0,,Матудың құмарлығын Матудың қолдарымен орындауға болады.
Dialogue: 0,0:13:34.31,0:13:36.81,Default,,0,0,0,,Туысы жоқ адамдарды тарту дұрыс па?
Dialogue: 0,0:13:38.27,0:13:42.27,Default,,0,0,0,,Уайымдадым деп айта алмаймын, әке.
Dialogue: 0,0:13:42.40,0:13:49.07,Default,,0,0,0,,Хахаха... Мақсатың араласпау болса, Қария.
Dialogue: 0,0:13:50.24,0:13:53.08,Default,,0,0,0,,Менің ойымша, бұл сәл кеш болды.
Dialogue: 0,0:13:53.20,0:13:55.87,Default,,0,0,0,,Қария... Әйтеуір!
Dialogue: 0,0:13:59.38,0:14:01.17,Default,,0,0,0,,Алғашқы үш күн осылай болды.
Dialogue: 0,0:14:01.25,0:14:04.46,Default,,0,0,0,,Бұл қатты айқайлағандай болды.
Dialogue: 0,0:14:05.09,0:14:08.63,Default,,0,0,0,,Төртінші күннен бастап мен дыбыс шығаруды қойдым.
Dialogue: 0,0:14:09.18,0:14:12.43,Default,,0,0,0,,Бүгін таңертеңнен бастап мен оларды мына жәндіктер қоймасына тастаймын.
Dialogue: 0,0:14:12.51,0:14:15.22,Default,,0,0,0,,Мен оның қанша уақытқа созылатынын көруге тырысамын.
Dialogue: 0,0:14:15.31,0:14:19.77,Default,,0,0,0,,Жарты күн бойы жәндіктердің шабуылынан кейін мен әлі де тыныс алудамын.
Dialogue: 0,0:14:19.90,0:14:24.11,Default,,0,0,0,,Тохсақаның материалдары да қоқысқа тасталмайды.
Dialogue: 0,0:14:24.36,0:14:25.28,Default,,0,0,0,,Сакура!
Dialogue: 0,0:14:25.40,0:14:27.28,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:14:27.40,0:14:33.49,Default,,0,0,0,,Сынған кішкентай қызды жәндіктер басынан аяғына дейін зорлады...
Dialogue: 0,0:14:33.62,0:14:36.50,Default,,0,0,0,,Егер мені әлі де құтқарғың келсе
Dialogue: 0,0:14:37.08,0:14:39.46,Default,,0,0,0,,Бұл туралы ойлаудың қажеті жоқ.
Dialogue: 0,0:14:39.58,0:14:41.17,Default,,0,0,0,,Менің еш қарсылығым жоқ.
Dialogue: 0,0:14:41.29,0:14:42.79,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:42.92,0:14:45.75,Default,,0,0,0,,Бірақ нәтиже бермейінше,
Dialogue: 0,0:14:45.84,0:14:49.13,Default,,0,0,0,,Сакураның білімі жалғасады.
Dialogue: 0,0:14:49.26,0:14:53.89,Default,,0,0,0,,Менің сүйікті ісім - келесі Қасиетті Граил соғысы.
Dialogue: 0,0:14:53.97,0:14:58.27,Default,,0,0,0,,Солай бола тұра, сіз кездейсоқ Қасиетті Граалды алсаңыз,
Dialogue: 0,0:14:58.35,0:15:02.65,Default,,0,0,0,,Ол кезде, әрине, кішкентай қыз қолданылған.
Dialogue: 0,0:15:02.73,0:15:07.90,Default,,0,0,0,,Менің ойымша, оның білімі бір жылдан кейін аяқталады.
Dialogue: 0,0:15:08.86,0:15:11.78,Default,,0,0,0,,Екі сөз жоқ. Мату Зукен
Dialogue: 0,0:15:11.86,0:15:15.66,Default,,0,0,0,,Алдымен, бір апта бойы жәндіктерге арналған питомник бол.
Dialogue: 0,0:15:15.74,0:15:18.12,Default,,0,0,0,,Ендеше жынды болып өлмесең
Dialogue: 0,0:15:18.20,0:15:21.87,Default,,0,0,0,,Шынайылығыңызды мойындайық.
Dialogue: 0,0:15:31.01,0:15:32.64,Default,,0,0,0,,Ол ақыры келді ме?
Dialogue: 0,0:15:34.85,0:15:35.93,Default,,0,0,0,,Қандай жаңалық?
Dialogue: 0,0:15:36.26,0:15:39.98,Default,,0,0,0,,Бұл Лондон сағат мұнарасына енген адамдардың есебі.
Dialogue: 0,0:15:40.35,0:15:44.44,Default,,0,0,0,,Шамасы, Қасиетті Граил Сиқыр шіркеуінің ең жоғары мектебі болып табылады.
Dialogue: 0,0:15:44.52,0:15:46.98,Default,,0,0,0,,Шебер сағат мұнарасынан да таңдалғанға ұқсайды.
Dialogue: 0,0:15:47.44,0:15:48.23,Default,,0,0,0,,Who?
Dialogue: 0,0:15:48.36,0:15:49.65,Default,,0,0,0,,Ол қиын адам.
Dialogue: 0,0:15:50.19,0:15:52.66,Default,,0,0,0,,Тоғыз ұрпақтан тұратын атақты сиқырлы отбасы
Dialogue: 0,0:15:52.86,0:15:54.32,Default,,0,0,0,,Арчибальдтың үлкен ұлы
Dialogue: 0,0:15:55.03,0:15:57.66,Default,,0,0,0,,Кайнет Эль-Меллои Арчибальд
Dialogue: 0,0:16:00.96,0:16:03.71,Default,,0,0,0,,Сиқыр әлемінде, шығу тегі бойынша
Dialogue: 0,0:16:03.79,0:16:06.67,Default,,0,0,0,,Олардың артықшылығы немесе төмендігі негізінен анықталады.
Dialogue: 0,0:16:07.54,0:16:12.17,Default,,0,0,0,,Өйткені сиқырдың сыры бір ұрпақта орындалатын нәрсе емес.
Dialogue: 0,0:16:12.26,0:16:17.55,Default,,0,0,0,,Бұл ата-ананың өмір бойы алған тәрбиесінің жемісін балаларына беруі үшін.
Dialogue: 0,0:16:17.64,0:16:22.31,Default,,0,0,0,,Сондықтан сиқырлы отбасылардың ұрпақтары өткен сайын олардың беделі де арта түседі.
Dialogue: 0,0:16:22.43,0:16:26.81,Default,,0,0,0,,Неліктен біз мұндай қарапайым әңгімеден бастаймыз?
Dialogue: 0,0:16:26.90,0:16:31.90,Default,,0,0,0,,Себебі өткен күні бір студент маған қағаз тапсырды.
Dialogue: 0,0:16:32.57,0:16:33.28,Default,,0,0,0,,Ах
Dialogue: 0,0:16:33.40,0:16:36.95,Default,,0,0,0,,Тақырыбы «Жаңа ғасырдағы сиқырлы жол»
Dialogue: 0,0:16:37.16,0:16:42.25,Default,,0,0,0,,Бұл құжат мен айтқан дәстүрлі даналыққа қарсы.
Dialogue: 0,0:16:42.37,0:16:45.42,Default,,0,0,0,,Хирургиялық әдістерді тереңірек түсіну және
Dialogue: 0,0:16:45.50,0:16:48.84,Default,,0,0,0,,Егер сіз сиқырды шебер пайдалана алсаңыз
Dialogue: 0,0:16:48.92,0:16:53.09,Default,,0,0,0,,Туа біткен қабілеттегі айырмашылықтарды кез келген жолмен өтеуге болады.
Dialogue: 0,0:16:53.22,0:16:56.18,Default,,0,0,0,,Басқаша айтқанда, тіпті таяз қандылар
Dialogue: 0,0:16:56.26,0:16:59.39,Default,,0,0,0,,Ол сенің бірінші дәрежелі сиқыршы бола алатыныңды уағыздайды.
Dialogue: 0,0:16:59.47,0:17:03.02,Default,,0,0,0,,Шынымды айтсам, бұл қағазды оқығанда есіме түсті.
Dialogue: 0,0:17:03.27,0:17:04.64,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:17:07.10,0:17:08.56,Default,,0,0,0,,Ашық сөйлеңіз
Dialogue: 0,0:17:08.65,0:17:12.11,Default,,0,0,0,,Мұнда жазылғанның бәрі тек адасушылық.
Dialogue: 0,0:17:12.82,0:17:13.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:13.65,0:17:16.99,Default,,0,0,0,,Сиқырдың артықшылығы немесе төмендігі қандағы айырмашылықтармен анықталады.
Dialogue: 0,0:17:17.11,0:17:19.99,Default,,0,0,0,,Бұл жоққа шығаруға болмайтын ақиқат.
Dialogue: 0,0:17:21.41,0:17:23.70,Default,,0,0,0,,Waver Velvet-kun
Dialogue: 0,0:17:23.79,0:17:27.50,Default,,0,0,0,,Кейбір оқушыларымның мұндай адасушылықтары барын білмедім.
Dialogue: 0,0:17:27.62,0:17:29.29,Default,,0,0,0,,Шынымен өкінішті
Dialogue: 0,0:17:29.38,0:17:30.71,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:17:30.79,0:17:34.67,Default,,0,0,0,,Мен қазіргі ескі сиқырлы шіркеуге қатысты мәселе көтергім келеді...
Dialogue: 0,0:17:34.80,0:17:36.26,Default,,0,0,0,,Вавер-кун
Dialogue: 0,0:17:36.34,0:17:39.47,Default,,0,0,0,,Сіздің отбасыңыздың сиқыршы деген тегі бар екеніне сенімдімін.
Dialogue: 0,0:17:39.60,0:17:42.18,Default,,0,0,0,,Ол тек үш ұрпаққа ғана созылды.
Dialogue: 0,0:17:42.93,0:17:44.27,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:17:44.35,0:17:46.48,Default,,0,0,0,,Сиқырлы шіркеудің тарихы тұрғысынан
Dialogue: 0,0:17:46.60,0:17:50.31,Default,,0,0,0,,Үйің жаңа туған нәрестедей.
Dialogue: 0,0:17:50.40,0:17:52.11,Default,,0,0,0,,Ата-анаңа өз пікіріңді айтпас бұрын
Dialogue: 0,0:17:52.19,0:17:54.99,Default,,0,0,0,,Менің ойымша, бірінші қадам сөздерді үйрену.
Dialogue: 0,0:17:55.24,0:17:56.57,Default,,0,0,0,,(Оқушылар күледі)
Dialogue: 0,0:17:57.11,0:17:58.16,Default,,0,0,0,,Мені мазақ ет
Dialogue: 0,0:17:58.28,0:17:59.16,Default,,0,0,0,,Мені мазақ ет
Dialogue: 0,0:17:59.28,0:18:00.49,Default,,0,0,0,,Ақымақ бол!
Dialogue: 0,0:18:00.62,0:18:02.66,Default,,0,0,0,,Дәріс беруші осылай істей ме?
Dialogue: 0,0:18:02.74,0:18:05.41,Default,,0,0,0,,Ол менің қағазымды оқып, қызғанып кетті.
Dialogue: 0,0:18:05.50,0:18:07.66,Default,,0,0,0,,Олар менің талантымнан қорықты!
Dialogue: 0,0:18:07.79,0:18:09.58,Default,,0,0,0,,Сондықтан мен жұрттың алдында осылай әрекет еттім...
Dialogue: 0,0:18:09.67,0:18:11.38,Default,,0,0,0,,Хмм!
Dialogue: 0,0:18:12.71,0:18:14.17,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:14.30,0:18:15.42,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:18:15.55,0:18:17.01,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:18:17.55,0:18:20.55,Default,,0,0,0,,А, сен некромантиканың студентісің бе?
Dialogue: 0,0:18:20.68,0:18:22.14,Default,,0,0,0,,Дәріске не болды?
Dialogue: 0,0:18:22.26,0:18:23.68,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:18:24.10,0:18:25.68,Default,,0,0,0,,А... Профессор Арчибальдқа
Dialogue: 0,0:18:25.81,0:18:27.39,Default,,0,0,0,,Маған тапсырма орындауды сұрады.
Dialogue: 0,0:18:27.52,0:18:29.19,Default,,0,0,0,,Сондықтан асығыңыз...
Dialogue: 0,0:18:29.85,0:18:30.77,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:30.85,0:18:32.02,Default,,0,0,0,,Бұл дұрыс болды
Dialogue: 0,0:18:32.15,0:18:33.52,Default,,0,0,0,,Мұны профессор Арчибальдқа беріңіз.
Dialogue: 0,0:18:33.65,0:18:35.07,Default,,0,0,0,,Сіз оны жеткізе аласыз ба?
Dialogue: 0,0:18:37.19,0:18:39.28,Default,,0,0,0,,Бұл...?
Dialogue: 0,0:18:39.40,0:18:40.32,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,0:18:40.41,0:18:42.07,Default,,0,0,0,,Өйткені бұл маңызды нәрсе сияқты.
Dialogue: 0,0:18:42.87,0:18:43.99,Default,,0,0,0,,Маңызды нәрселер...
Dialogue: 0,0:18:45.24,0:18:48.62,Default,,0,0,0,,Македониядан
Dialogue: 0,0:18:55.50,0:18:56.59,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:18:57.55,0:19:01.05,Default,,0,0,0,,Кейнстің кеші жақын арада Қиыр Шығыста өтеді.
Dialogue: 0,0:19:01.14,0:19:05.64,Default,,0,0,0,,Сиқырлы жарысқа қатысу туралы қауесеттер рас болды.
Dialogue: 0,0:19:06.35,0:19:07.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.48,0:19:11.90,Default,,0,0,0,,«Қасиетті Граил соғысы»
Dialogue: 0,0:19:12.98,0:19:16.36,Default,,0,0,0,,«200 жыл бұрын, «Үш үй» деп аталды.
Dialogue: 0,0:19:16.44,0:19:19.49,Default,,0,0,0,,«Эйнцберн Макири Тохсака»
Dialogue: 0,0:19:19.57,0:19:22.70,Default,,0,0,0,,«Сиқыршылардың үш әулеті бір-бірімен ынтымақтасады».
Dialogue: 0,0:19:22.78,0:19:27.16,Default,,0,0,0,,«Кез келген тілекті орындай алатын Қасиетті Граильді шақыра алды».
Dialogue: 0,0:19:28.37,0:19:33.67,Default,,0,0,0,,«Бірақ Қасиетті Граил тек бір адамның дұғасын қабылдайды».
Dialogue: 0,0:19:34.42,0:19:39.05,Default,,0,0,0,,«Кооперативті қарым-қатынас қанды күреске айналды».
Dialogue: 0,0:19:39.59,0:19:42.05,Default,,0,0,0,,«Бұл Қасиетті Граил соғысының басы».
Dialogue: 0,0:19:42.93,0:19:46.05,Default,,0,0,0,,«Содан бері 60 жылда бір рет»
Dialogue: 0,0:19:46.14,0:19:48.43,Default,,0,0,0,,«Қасиетті Граил Фуюки еліне оралады»
Dialogue: 0,0:19:48.56,0:19:51.19,Default,,0,0,0,,«Оны алуға құқығы бар адам ретінде».
Dialogue: 0,0:19:51.27,0:19:53.31,Default,,0,0,0,,«Жеті сиқыршыны таңда»
Dialogue: 0,0:19:54.35,0:19:58.61,Default,,0,0,0,,«Қызметші деп аталатын батырлық рухты шақыруға мүмкіндік беріңіз»
Dialogue: 0,0:19:59.94,0:20:00.90,Default,,0,0,0,,«Садақшы»
Dialogue: 0,0:20:01.11,0:20:02.03,Default,,0,0,0,,«Сабер»
Dialogue: 0,0:20:02.28,0:20:03.28,Default,,0,0,0,,«Лансер»
Dialogue: 0,0:20:03.41,0:20:04.24,Default,,0,0,0,,«Шабандоз»
Dialogue: 0,0:20:04.53,0:20:05.41,Default,,0,0,0,,«Ассасин»
Dialogue: 0,0:20:05.62,0:20:06.53,Default,,0,0,0,,"Кастер"
Dialogue: 0,0:20:06.62,0:20:07.95,Default,,0,0,0,,«Берзер»
Dialogue: 0,0:20:08.79,0:20:12.33,Default,,0,0,0,,«Жеті сыныпқа бөлінген қызметшілер шынайы дүниеде...»
Dialogue: 0,0:20:12.92,0:20:16.84,Default,,0,0,0,,«Жеті адамның қайсысы Қасиетті Граилдың тасымалдаушысы болуға лайықты?»
Dialogue: 0,0:20:16.96,0:20:19.00,Default,,0,0,0,,«Оны өлімге әкелетін ұрыспен шешіңіз»
Dialogue: 0,0:20:21.13,0:20:22.01,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:20:23.30,0:20:27.55,Default,,0,0,0,,Қасиетті Граил соғысы атақ пен билікке мұқтаж емес.
Dialogue: 0,0:20:27.64,0:20:30.81,Default,,0,0,0,,Бұл нағыз қабілет бәсекесі ме?
Dialogue: 0,0:20:31.81,0:20:34.65,Default,,0,0,0,,Бұл мен үшін тамаша сахна емес пе?
Dialogue: 0,0:20:35.15,0:20:35.98,Default,,0,0,0,,Ах
Dialogue: 0,0:20:36.36,0:20:38.77,Default,,0,0,0,,``Қызметшіні шақырғаны үшін''
Dialogue: 0,0:20:38.86,0:20:42.65,Default,,0,0,0,,``Катализатор ретінде қаһармандық рухтың қасиетті жәдігерін талап етеді.''
Dialogue: 0,0:20:43.70,0:20:44.91,Default,,0,0,0,,Қасиетті жәдігерлер…
Dialogue: 0,0:20:49.66,0:20:51.41,Default,,0,0,0,,Уау
Dialogue: 0,0:21:15.52,0:21:18.65,Default,,0,0,0,,Қанша көрсем де көлеңкелі қулық.
Dialogue: 0,0:21:19.23,0:21:20.98,Default,,0,0,0,,Сағат мұнарасынан репортаж.
Dialogue: 0,0:21:21.48,0:21:24.86,Default,,0,0,0,,Лорд Эль-Меллои жаңа қасиетті жәдігерге ие болған сияқты.
Dialogue: 0,0:21:25.78,0:21:28.66,Default,,0,0,0,,Қазір оның қатысуы расталған сияқты.
Dialogue: 0,0:21:29.12,0:21:32.83,Default,,0,0,0,,Әлі де екі бос орын бар екені қорқынышты.
Dialogue: 0,0:21:33.12,0:21:34.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:21:34.08,0:21:37.79,Default,,0,0,0,,Уақыты келгенде, Қасиетті Граил олардың сапасына қарамастан жеті адамды дайындайды.
Dialogue: 0,0:21:37.87,0:21:40.21,Default,,0,0,0,,Мұндай адамдар санына қатысты
Dialogue: 0,0:21:40.21,0:21:44.42,Default,,0,0,0,,Бұл негізінен ұсақ заттар, сондықтан мен сақ болудың қажеті жоқ.
Dialogue: 0,0:21:45.22,0:21:47.59,Default,,0,0,0,,Сақтыққа келгенде, Кирей
Dialogue: 0,0:21:47.93,0:21:51.10,Default,,0,0,0,,Бұл сарайға кіргеніңізді ешкім көрмеді, солай ма?
Dialogue: 0,0:21:51.22,0:21:52.60,Default,,0,0,0,,(Идзуми) Уау! Бұл өте қызықты естіледі.
Dialogue: 0,0:21:52.93,0:21:56.69,Default,,0,0,0,,Көрінетін немесе көрінбейтін болсын, бұл сарайды бақылайтын таныс рухтар бар.
Dialogue: 0,0:21:56.77,0:21:58.77,Default,,0,0,0,,Сиқырлы құрылғы жоқ.
Dialogue: 0,0:21:59.06,0:21:59.98,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:00.06,0:22:02.23,Default,,0,0,0,,Мен бұған кепілдік беремін
Dialogue: 0,0:22:03.73,0:22:07.07,Default,,0,0,0,,Қандай айла қолданса да, ол барлаушылардың қаһарман рухы.
Dialogue: 0,0:22:07.20,0:22:10.82,Default,,0,0,0,,Мен бұл Хасанды алдамаймын.
Dialogue: 0,0:22:11.03,0:22:15.83,Default,,0,0,0,,Қазіргі уақытта Ұстаздың айналасында ешқандай қудалау белгісі жоқ.
Dialogue: 0,0:22:16.79,0:22:19.67,Default,,0,0,0,,​​Сенімді болыңыз.
Dialogue: 0,0:22:19.92,0:22:22.96,Default,,0,0,0,,Қасиетті Граилға шақырылған қызметші пайда болса,
Dialogue: 0,0:22:23.09,0:22:25.42,Default,,0,0,0,,Мен мұны міндетті түрде әкеме тапсырамын.
Dialogue: 0,0:22:25.92,0:22:30.76,Default,,0,0,0,,Басқа сиқыршылар әрекет ету үшін көп уақыт өтуі мүмкін.
Dialogue: 0,0:22:31.09,0:22:33.18,Default,,0,0,0,,Assassin Бұл жер жеткілікті
Dialogue: 0,0:22:33.31,0:22:35.64,Default,,0,0,0,,Сыртта қырағы болыңыз.
Dialogue: 0,0:22:35.77,0:22:36.64,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:22:38.94,0:22:40.98,Default,,0,0,0,,Бірақ бұл тек уақыт мәселесі
Dialogue: 0,0:22:41.81,0:22:43.32,Default,,0,0,0,,Бір күні осы сарайдың айналасында
Dialogue: 0,0:22:43.44,0:22:45.86,Default,,0,0,0,,Басқа шеберлер шығарған таныс рухтар
Dialogue: 0,0:22:45.94,0:22:48.36,Default,,0,0,0,,Сіз абдырап қаласыз
Dialogue: 0,0:22:49.45,0:22:52.28,Default,,0,0,0,,Бұл? (Токиоми) Бұл басқа мәселе бойынша тергеу болды.
Dialogue: 0,0:22:53.03,0:22:55.12,Default,,0,0,0,,Эйнцберн шебері туралы
Dialogue: 0,0:22:55.24,0:22:57.00,Default,,0,0,0,,Мен ақпарат жинадым.
Dialogue: 0,0:22:57.87,0:23:00.62,Default,,0,0,0,,Бұл шамамен тоғыз жыл бұрын болды.
Dialogue: 0,0:23:00.92,0:23:03.92,Default,,0,0,0,,Эйнцберндер өздерінің таза қанды тегін мақтан тұтты.
Dialogue: 0,0:23:04.29,0:23:07.80,Default,,0,0,0,,Кенет сырттан келген сиқыршыны күйеу баласы етіп алды.
Dialogue: 0,0:23:10.05,0:23:13.97,Default,,0,0,0,,Эйнцберндер отбасының сиқыршылары бастапқыда алхимияға маманданған.
Dialogue: 0,0:23:14.05,0:23:15.81,Default,,0,0,0,,Дөрекі төсеу үшін жарамсыз
Dialogue: 0,0:23:16.31,0:23:20.52,Default,,0,0,0,,Өткен Қасиетті Граил соғысындағы жеңілуіміздің себебі де осы болды.
Dialogue: 0,0:23:20.64,0:23:23.65,Default,,0,0,0,,Сондықтан олар ақыры одан шаршады деп ойлаймын.
Dialogue: 0,0:23:24.36,0:23:28.40,Default,,0,0,0,,Шақырылған сиқыршы болса керек
Dialogue: 0,0:23:31.36,0:23:33.07,Default,,0,0,0,,Кирицугу Эмия
Dialogue: 0,0:23:34.66,0:23:36.99,Default,,0,0,0,,Ол Сиқыршы өлтіруші деп аталды.
Dialogue: 0,0:23:43.04,0:23:44.25,Default,,0,0,0,,Ұзақ уақыт бойы—
Dialogue: 0,0:23:44.33,0:23:47.17,Default,,0,0,0,,Олар Корнуоллде зерттеп жүрген қасиетті жәдігерлер
Dialogue: 0,0:23:47.25,0:23:48.84,Default,,0,0,0,,Ақыры табылды
Dialogue: 0,0:23:48.92,0:23:50.55,Default,,0,0,0,,Егер біз оны орта ретінде қолдансақ
Dialogue: 0,0:23:50.67,0:23:53.76,Default,,0,0,0,,Менің ойымша, қылыштың батырлық рухы.
Dialogue: 0,0:23:53.84,0:23:56.51,Default,,0,0,0,,Ең күшті қызметші шақырылады
Dialogue: 0,0:23:56.97,0:23:58.27,Default,,0,0,0,,Кирицугу
Dialogue: 0,0:23:58.39,0:24:03.81,Default,,0,0,0,,Мұны Эйнцберннің сізге жасаған ең үлкен көмегі деп санаңыз.
Dialogue: 0,0:24:04.06,0:24:06.19,Default,,0,0,0,,Ауырды, мырза.
Dialogue: 0,0:24:06.65,0:24:09.90,Default,,0,0,0,,Бұл жолы бір адамды да қалдырмаңыз.
Dialogue: 0,0:24:10.03,0:24:12.70,Default,,0,0,0,,Барлық 6 қызметшіні аулаңыз
Dialogue: 0,0:24:12.82,0:24:16.83,Default,,0,0,0,,Үшінші сиқырлы Аспан сезіміне қол жеткізіңіз
Dialogue: 0,0:24:17.37,0:24:18.45,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:24:19.87,0:24:21.83,Default,,0,0,0,,Кирицугу Эмия…
Dialogue: 0,0:24:22.04,0:24:24.83,Default,,0,0,0,,Бұл атау таныс сияқты.
Dialogue: 0,0:24:25.13,0:24:28.84,Default,,0,0,0,,Собор шіркеуіне де жетті ме?
Dialogue: 0,0:24:29.84,0:24:34.34,Default,,0,0,0,,Сиқыршы өлтіруші Эмиияның сол кездегі беделі зор еді.
Dialogue: 0,0:24:34.84,0:24:38.56,Default,,0,0,0,,Ресми түрде ол Сиқырлы шіркеуге жатпайтын, шеттетілген адам болды.
Dialogue: 0,0:24:39.06,0:24:43.56,Default,,0,0,0,,Жоғарғы жақтағы адамдар оны әртүрлі мақсатта пайдаланған сияқты.
Dialogue: 0,0:24:43.69,0:24:48.69,Default,,0,0,0,,Сіз соборлық шіркеуде агент деп атайтын адамға ұқсайсыз ба?
Dialogue: 0,0:24:48.77,0:24:50.44,Default,,0,0,0,,Одан да жаман
Dialogue: 0,0:24:50.57,0:24:53.90,Default,,0,0,0,,Бұл адам тек сиқыршылар үшін ерекше бағаға ие.
Dialogue: 0,0:24:53.99,0:24:56.78,Default,,0,0,0,,Бұл штаттан тыс өлтіруші сияқты.
Dialogue: 0,0:24:57.03,0:24:58.58,Default,,0,0,0,,Өйткені мен сиқыршыны білемін
Dialogue: 0,0:24:58.70,0:25:02.95,Default,,0,0,0,,Сиқыршыны ең сиқыршылыққа жатпайтын жолмен бұру
Dialogue: 0,0:25:04.46,0:25:05.79,Default,,0,0,0,,Оқыңыз.
Dialogue: 0,0:25:07.33,0:25:08.63,Default,,0,0,0,,«Мерген»
Dialogue: 0,0:25:08.75,0:25:09.71,Default,,0,0,0,,«У»
Dialogue: 0,0:25:09.79,0:25:12.09,Default,,0,0,0,,«Қоғамдық бомбалау»
Dialogue: 0,0:25:12.42,0:25:14.26,Default,,0,0,0,,«Жолаушылар ұшағын түгел атып түсірді»?
Dialogue: 0,0:25:14.34,0:25:17.09,Default,,0,0,0,,Мақсат жолаушы болғаны үшін бе?
Dialogue: 0,0:25:17.55,0:25:19.01,Default,,0,0,0,,Мұндай дөрекі тактика
Dialogue: 0,0:25:19.10,0:25:21.01,Default,,0,0,0,,Ол істі оңай істейтін адам.
Dialogue: 0,0:25:22.60,0:25:27.19,Default,,0,0,0,,Себебі, сиқыршылар әлемдік заңдардан тыс.
Dialogue: 0,0:25:27.31,0:25:30.82,Default,,0,0,0,,Өздігінен бекітілген заңдарды қатаң сақтау керек.
Dialogue: 0,0:25:31.44,0:25:34.40,Default,,0,0,0,,Бірақ бұл адам сиқыршы екенін мақтан тұтады.
Dialogue: 0,0:25:34.49,0:25:36.61,Default,,0,0,0,,Менде оның азғантай бөлігі де жоқ.
Dialogue: 0,0:25:37.16,0:25:39.82,Default,,0,0,0,,Мен мұндай мінез-құлыққа мүлдем шыдай алмаймын.
Dialogue: 0,0:25:40.95,0:25:46.04,Default,,0,0,0,,Сонымен... бұл Кирицугу Эмия есімді адам...
Dialogue: 0,0:25:47.12,0:25:49.75,Default,,0,0,0,,Ассасиндердің мақсаты қандай?
Dialogue: 0,0:25:49.88,0:25:52.30,Default,,0,0,0,,Мүмкін ақша.
Dialogue: 0,0:25:52.80,0:25:54.80,Default,,0,0,0,,Бұл баяндамада да айтылуы мүмкін.
Dialogue: 0,0:25:55.01,0:25:59.01,Default,,0,0,0,,Ол тек сиқыршыны өлтіруге қатысқан жоқ.
Dialogue: 0,0:25:59.30,0:26:02.47,Default,,0,0,0,,Әр мүмкіндікте олар дүние жүзіндегі қақтығыс аймақтарында пайда болады.
Dialogue: 0,0:26:02.60,0:26:05.39,Default,,0,0,0,,Ол жалдамалы ретінде біраз қалтасын тапқан көрінеді.
Dialogue: 0,0:26:06.39,0:26:11.06,Default,,0,0,0,,Осы құжаттың бір бөлігін қарызға аламын ба?
Dialogue: 0,0:26:16.82,0:26:19.53,Default,,0,0,0,,Airi жинаған ақпаратты жүйелеп көрейік
Dialogue: 0,0:26:21.03,0:26:25.79,Default,,0,0,0,,Қасиетті Граил таңдаған жеті шебердің төртеуі қазіргі уақытта белгілі.
Dialogue: 0,0:26:26.25,0:26:29.67,Default,,0,0,0,,Токиоми Тохсака Тохсака отбасының басшысы
Dialogue: 0,0:26:29.75,0:26:33.46,Default,,0,0,0,,Ол от атрибуты бар және зергерлік сиқырды қолданатын айбынды жігіт.
Dialogue: 0,0:26:33.84,0:26:35.38,Default,,0,0,0,,Кария Мату
Dialogue: 0,0:26:35.51,0:26:38.17,Default,,0,0,0,,Ғұн Отағасы бола алмаған тентек.
Dialogue: 0,0:26:38.30,0:26:40.84,Default,,0,0,0,,Олар сізді шебер болуға мәжбүр етті ме?
Dialogue: 0,0:26:40.97,0:26:42.93,Default,,0,0,0,,Сол жақтағы қария да шарасыз.
Dialogue: 0,0:26:43.47,0:26:45.68,Default,,0,0,0,,Кайнет Эль-Меллои Арчибальд
Dialogue: 0,0:26:46.18,0:26:48.48,Default,,0,0,0,,Жел мен судың қос атрибуттары бар.
Dialogue: 0,0:26:48.56,0:26:53.02,Default,,0,0,0,,Некромантия, шақыру және алхимия саласындағы сарапшы
Dialogue: 0,0:26:53.36,0:26:54.19,Default,,0,0,0,,Және…
Dialogue: 0,0:26:54.32,0:26:55.98,Default,,0,0,0,,Кирицугу Эмия
Dialogue: 0,0:26:56.11,0:26:59.36,Default,,0,0,0,,Эйнцберндер шақырған ең күшті козир
Dialogue: 0,0:27:00.16,0:27:02.03,Default,,0,0,0,,Менің сүйіктім
Dialogue: 0,0:27:04.62,0:27:08.66,Default,,0,0,0,,Ал төртінші... жоқ, бесінші қожайын...
Dialogue: 0,0:27:08.75,0:27:12.71,Default,,0,0,0,,Собор шіркеуінен жіберілген. Оның аты Кирей Котомине.
Dialogue: 0,0:27:13.17,0:27:15.00,Default,,0,0,0,,Собор шіркеуінен?
Dialogue: 0,0:27:15.13,0:27:18.80,Default,,0,0,0,,Ол жетекші болып қызмет ететін Рисей Котомине әкенің ұлы.
Dialogue: 0,0:27:19.38,0:27:21.93,Default,,0,0,0,,Мен үш жыл бойы Токиоми Тохсаканың қол астында оқыдым.
Dialogue: 0,0:27:22.05,0:27:26.06,Default,,0,0,0,,Бұйрық сиқырын алғаннан кейін ол ұстазымен ажырасып кеткен дейді.
Dialogue: 0,0:27:26.39,0:27:28.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:27:28.18,0:27:30.23,Default,,0,0,0,,Тіпті менің мансап тарихым жаңартылды...
Dialogue: 0,0:27:31.39,0:27:32.81,Default,,0,0,0,,Оны да оқу керек.
Dialogue: 0,0:27:34.48,0:27:35.86,Default,,0,0,0,,«Котомине Кирей»
Dialogue: 0,0:27:35.94,0:27:39.90,Default,,0,0,0,,«Бала кезімнен әкем Рисеймен бірге киелі жерлерге зиярат еттім».
Dialogue: 0,0:27:39.99,0:27:43.11,Default,,0,0,0,,«Игнатий семинариясын бітірген адам»
Dialogue: 0,0:27:43.41,0:27:46.53,Default,,0,0,0,,Ол екі жылды өткізіп жіберді және үздік студент болды ма?
Dialogue: 0,0:27:46.62,0:27:48.37,Default,,0,0,0,,Ол керемет адам сияқты.
Dialogue: 0,0:27:48.45,0:27:53.67,Default,,0,0,0,,Алайда, ол кенеттен табысқа жету жолынан адасып, собор шіркеуіне жүгінеді.
Dialogue: 0,0:27:53.96,0:27:55.50,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:27:55.59,0:27:58.71,Default,,0,0,0,,Ол шіркеудің астыртын ұйымына кіріп кеткендей болды ма?
Dialogue: 0,0:27:59.05,0:28:00.72,Default,,0,0,0,,Әкемнің ықпалынан ба?
Dialogue: 0,0:28:01.05,0:28:06.35,Default,,0,0,0,,Қараңызшы, оның әкесі сияқты соборлық шіркеудің Сегізінші Сакраментальдық Қоғамына жататындығы жазылған.
Dialogue: 0,0:28:06.43,0:28:09.93,Default,,0,0,0,,Олай болса, ол әкесінің жолын әу бастан мақсат ету керек еді.
Dialogue: 0,0:28:10.18,0:28:13.48,Default,,0,0,0,,Бірақ мен әкеммен бір бөлімге қоныстанғанға дейін.
Dialogue: 0,0:28:13.60,0:28:15.86,Default,,0,0,0,,Үш рет мүшелік өзгерді.
Dialogue: 0,0:28:16.23,0:28:19.11,Default,,0,0,0,,Ол тіпті бір рет агент болып тағайындалды.
Dialogue: 0,0:28:19.69,0:28:20.94,Default,,0,0,0,,Агент?
Dialogue: 0,0:28:21.53,0:28:23.95,Default,,0,0,0,,Ол бидғатты бағындыруға жауапты.
Dialogue: 0,0:28:24.28,0:28:25.03,Default,,0,0,0,,Қысқасы
Dialogue: 0,0:28:25.74,0:28:29.70,Default,,0,0,0,,Менің рөлім бұрынғыдай сиқыршыны өлтіру.
Dialogue: 0,0:28:30.41,0:28:32.37,Default,,0,0,0,,«Эмия Кирицугу»
Dialogue: 0,0:28:32.58,0:28:34.96,Default,,0,0,0,,«Оған жасалған қастандық»
Dialogue: 0,0:28:35.04,0:28:37.79,Default,,0,0,0,,«Қысқа уақыт ішінде дәйекті өлім жазасына кесу»
Dialogue: 0,0:28:37.88,0:28:41.34,Default,,0,0,0,,«Сонымен қатар қақтығыс аймақтары да бір жерден екінші жерге көшіп жатыр».
Dialogue: 0,0:28:41.46,0:28:45.72,Default,,0,0,0,,«Олар соғыс жағдайы күшейген кезде ғана пайда болады».
Dialogue: 0,0:28:45.80,0:28:48.47,Default,,0,0,0,,«Бұл өлім орнына бару сияқты».
Dialogue: 0,0:28:48.56,0:28:51.35,Default,,0,0,0,,«Менде қандай да бір әуесқойлық бар сияқты болды».
Dialogue: 0,0:28:51.47,0:28:53.85,Default,,0,0,0,,«Әрекеттің өзін-өзі жоққа шығаратын принципі...»
Dialogue: 0,0:28:56.27,0:28:58.65,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:28:59.11,0:29:02.99,Default,,0,0,0,,Пак Жанды емдеуге шақыратын алхимия рухы
Dialogue: 0,0:29:03.36,0:29:07.03,Default,,0,0,0,,Оның меңгерген сиқырлық категорияларына қараңыз.
Dialogue: 0,0:29:07.82,0:29:09.62,Default,,0,0,0,,Бұл позитив дегеніміз не?
Dialogue: 0,0:29:09.70,0:29:12.58,Default,,0,0,0,,Барлығын келесі деңгейге көтеріңіз
Dialogue: 0,0:29:12.66,0:29:16.58,Default,,0,0,0,,Сол жерден мен еш өкінбей келесі жанрға ауыстым.
Dialogue: 0,0:29:16.71,0:29:21.80,Default,,0,0,0,,Осы уақытқа дейін өсіргенімнің барлығын лақтырып жіберетін сияқтымын.
Dialogue: 0,0:29:22.92,0:29:23.80,Default,,0,0,0,,Айри
Dialogue: 0,0:29:24.88,0:29:28.55,Default,,0,0,0,,Мен үшін Котомине Кирейдің жолы қорқынышты.
Dialogue: 0,0:29:28.76,0:29:31.35,Default,,0,0,0,,Бұл адамның өзімшілдік туралы ойлары жоқ.
Dialogue: 0,0:29:31.47,0:29:32.72,Default,,0,0,0,,Оның әрекеттері болды
Dialogue: 0,0:29:32.85,0:29:36.56,Default,,0,0,0,,Нақты пайда мен тәуекел арасындағы тепе-теңдік толығымен бұзылған.
Dialogue: 0,0:29:36.69,0:29:41.02,Default,,0,0,0,,Бұл жігіттің ақша іздейтін фрилансер болуы мүмкін емес.
Dialogue: 0,0:29:41.15,0:29:45.20,Default,,0,0,0,,Бұл кісінің өмірінде бірде-бір құмарлық жоқ.
Dialogue: 0,0:29:45.32,0:29:47.70,Default,,0,0,0,,Бұл адам ештеңеге сенбейтін шығар.
Dialogue: 0,0:29:48.07,0:29:51.95,Default,,0,0,0,,Менің ойымша, сізде қалау деп атауға болатын ештеңе жоқ.
Dialogue: 0,0:29:53.16,0:29:54.45,Default,,0,0,0,,Мұндай адам...
Dialogue: 0,0:29:54.70,0:29:57.58,Default,,0,0,0,,Сонымен не іздеп жүрсіз?
Dialogue: 0,0:29:57.71,0:30:01.42,Default,,0,0,0,,Неліктен Қасиетті Граалды іздеу үшін өз өміріңізді қатерге тігесіз?
Dialogue: 0,0:30:01.54,0:30:06.88,Default,,0,0,0,,Бірақ Кирей Котомине Қасиетті Граил болу үшін шеберлердің бірі ретінде таңдалды ...
Dialogue: 0,0:30:06.97,0:30:07.88,Default,,0,0,0,,Иә.
Dialogue: 0,0:30:08.34,0:30:11.22,Default,,0,0,0,,Бұл кісінің де Қасиетті Граилға ие болу себебі бар.
Dialogue: 0,0:30:11.30,0:30:13.14,Default,,0,0,0,,Менде болуы керек.
Dialogue: 0,0:30:13.56,0:30:16.77,Default,,0,0,0,,Бірақ мен оның не екенін көре алмаймын.
Dialogue: 0,0:30:17.06,0:30:19.60,Default,,0,0,0,,Бұл мен үшін қорқынышты.
Dialogue: 0,0:30:21.52,0:30:23.02,Default,,0,0,0,,Кирей Котомине
Dialogue: 0,0:30:23.61,0:30:25.49,Default,,0,0,0,,Кирицугу Эмия
Dialogue: 0,0:30:26.07,0:30:29.74,Default,,0,0,0,,Бұл кісінің шайқасы тойымсыз қайталанды.
Dialogue: 0,0:30:29.86,0:30:32.70,Default,,0,0,0,,Ол тоғыз жыл бұрын кенет аяқталды.
Dialogue: 0,0:30:32.78,0:30:36.79,Default,,0,0,0,,Солтүстік сиқыршысы Эйнцбернмен кездесу
Dialogue: 0,0:30:37.08,0:30:41.08,Default,,0,0,0,,Сол кезде ол өз жауабын алды.
Dialogue: 0,0:30:41.29,0:30:46.42,Default,,0,0,0,,Сонда біз не үшін күресіп жатырмыз және мұның соңы немен аяқталады?
Dialogue: 0,0:30:48.30,0:30:50.47,Default,,0,0,0,,Не алдыңыз?
Dialogue: 0,0:30:51.89,0:30:53.97,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:31:00.77,0:31:03.57,Default,,0,0,0,,Біз уақытында әрең жеттік.
Dialogue: 0,0:31:04.23,0:31:06.53,Default,,0,0,0,,Қасиетті Граил ретінде таңдалу дегенді білдіреді
Dialogue: 0,0:31:06.61,0:31:10.49,Default,,0,0,0,,Бұл сенің де шебер сиқыршы ретінде танылғаныңды білдіреді.
Dialogue: 0,0:31:10.61,0:31:13.78,Default,,0,0,0,,​​Мен сені әзірше мақтаймын, Қария.
Dialogue: 0,0:31:15.29,0:31:19.66,Default,,0,0,0,,Джагана, сенің түр-түрің.
Dialogue: 0,0:31:20.21,0:31:23.59,Default,,0,0,0,,Қараңызшы, сол аяғыңыз әлі қозғала ала ма? иә?
Dialogue: 0,0:31:24.50,0:31:27.42,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:31:30.97,0:31:33.68,Default,,0,0,0,,Хахаха... Ашуланба Ашуланба
Dialogue: 0,0:31:33.80,0:31:39.81,Default,,0,0,0,,Егер сіз денеңіздегі жәндіктердің ізін қоздырсаңыз, олар сізді жеп қояды.
Dialogue: 0,0:31:39.89,0:31:43.40,Default,,0,0,0,,Сонымен, менің көзқарасым бойынша, сіздің өміріңіз
Dialogue: 0,0:31:43.48,0:31:46.86,Default,,0,0,0,,Шамамен бір ай қалды.
Dialogue: 0,0:31:46.98,0:31:48.19,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:31:48.48,0:31:49.74,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:31:49.99,0:31:52.36,Default,,0,0,0,,Мен бұл жеткілікті дедім.
Dialogue: 0,0:31:52.49,0:31:56.58,Default,,0,0,0,,Хахаха Кария, бұл бір жыл шыдағанның сыйы.
Dialogue: 0,0:31:56.66,0:32:00.66,Default,,0,0,0,,Мен саған лайықты қасиетті жәдігер таптым.
Dialogue: 0,0:32:01.16,0:32:04.71,Default,,0,0,0,,Мен әкемнің мейіріміне жол бермеймін.
Dialogue: 0,0:32:08.67,0:32:13.34,Default,,0,0,0,,Ол оны маған мақтанып көрсету үшін жасап жатыр— дәл осындай нәрсе істегісі келеді!
Dialogue: 0,0:32:15.05,0:32:19.43,Default,,0,0,0,,Хахаха! Бұйрық сиқыры менде де болды!
Dialogue: 0,0:32:19.68,0:32:21.89,Default,,0,0,0,,Мен Қасиетті Граил болу үшін таңдалдым.
Dialogue: 0,0:32:22.02,0:32:25.02,Default,,0,0,0,,Қасиетті Граил менің талантымды мойындады!
Dialogue: 0,0:32:27.52,0:32:29.23,Default,,0,0,0,,Мен мәңгі бақытты бола алмаймын
Dialogue: 0,0:32:29.86,0:32:32.53,Default,,0,0,0,,Мен қызметшіні шақыруға дайындалуым керек.
Dialogue: 0,0:32:35.95,0:32:37.66,Default,,0,0,0,,Фуюки қаласында кеше кештен бері.
Dialogue: 0,0:32:37.74,0:32:38.83,Default,,0,0,0,,Ол жоғалып кетті...
Dialogue: 0,0:32:38.91,0:32:40.29,Default,,0,0,0,,Қайырлы таң Вавер
Dialogue: 0,0:32:40.41,0:32:42.33,Default,,0,0,0,,Қайырлы таң Уэйвер-чан
Dialogue: 0,0:32:42.46,0:32:44.04,Default,,0,0,0,,(Вивердің есінеу)
Dialogue: 0,0:32:44.17,0:32:47.46,Default,,0,0,0,,Қайырлы таң ата мен әже
Dialogue: 0,0:32:48.63,0:32:50.59,Default,,0,0,0,,Фуюки де проблемаға айналды.
Dialogue: 0,0:32:50.71,0:32:52.55,Default,,0,0,0,,Иә, мүлде
Dialogue: 0,0:32:52.97,0:32:54.97,Default,,0,0,0,,Қалай болғанда да, сәлем Марта
Dialogue: 0,0:32:55.05,0:32:59.06,Default,,0,0,0,,Таңертеңнен бері тауықтардың қатты дауысы шыққаны сонша, мен оларды естімеймін.
Dialogue: 0,0:32:59.35,0:33:00.97,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:33:01.06,0:33:04.39,Default,,0,0,0,,Менің бақшамда үш тауық бар.
Dialogue: 0,0:33:04.52,0:33:06.06,Default,,0,0,0,,Менің бақшамда ма?
Dialogue: 0,0:33:06.15,0:33:07.23,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:33:07.36,0:33:10.07,Default,,0,0,0,,Мен қайдан келгеніне таңғаламын.
Dialogue: 0,0:33:10.90,0:33:13.07,Default,,0,0,0,,Уэйвер-чан, мен де кофе іше аламын ба?
Dialogue: 0,0:33:13.57,0:33:14.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:33:14.86,0:33:17.82,Default,,0,0,0,,Вавер-чан, қолыңа не болды?
Dialogue: 0,0:33:17.91,0:33:19.58,Default,,0,0,0,,Хаха...
Dialogue: 0,0:33:19.66,0:33:20.66,Default,,0,0,0,,Сол туу белгісі
Dialogue: 0,0:33:20.74,0:33:21.95,Default,,0,0,0,,Көгеру бар ма?
Dialogue: 0,0:33:22.08,0:33:24.75,Default,,0,0,0,,Сізде кешеге дейін мұндай көгеру болған жоқ, солай ма?
Dialogue: 0,0:33:25.08,0:33:27.04,Default,,0,0,0,,О...
Dialogue: 0,0:33:27.50,0:33:29.38,Default,,0,0,0,,Мен қажетсіз нәрсені байқадым
Dialogue: 0,0:33:29.59,0:33:31.75,Default,,0,0,0,,Не болды, Уэйвер?
Dialogue: 0,0:33:31.84,0:33:33.21,Default,,0,0,0,,Вавер-чан
Dialogue: 0,0:33:33.30,0:33:34.92,Default,,0,0,0,,Мен бұған көмектесе алмаймын.
Dialogue: 0,0:33:35.01,0:33:36.97,Default,,0,0,0,,Жүр, кофе ішейік.
Dialogue: 0,0:33:37.09,0:33:38.93,Default,,0,0,0,,Сүтті көп қосыңыз
Dialogue: 0,0:33:39.05,0:33:43.35,Default,,0,0,0,,Сізге екеуі де ұнайды, солай ма? кофе
Dialogue: 0,0:33:43.47,0:33:45.35,Default,,0,0,0,,Үш кісі өлтіру:
Dialogue: 0,0:33:45.44,0:33:48.81,Default,,0,0,0,,Қылмыстарды бір қылмыскер қатарынан жасаған деген көзқарас...
Dialogue: 0,0:33:48.94,0:33:50.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:33:50.15,0:33:54.61,Default,,0,0,0,,Сосын тағы да немерем шетелден оқудан оралды.
Dialogue: 0,0:33:54.74,0:33:57.82,Default,,0,0,0,,Менің ойымша, бұл туралы айтпасам, бұл жақсы емес ...
Dialogue: 0,0:33:58.11,0:34:00.74,Default,,0,0,0,,(әтеш айқайлайды)
Dialogue: 0,0:34:00.87,0:34:01.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:02.12,0:34:05.62,Default,,0,0,0,,Мен ұрлаған тауықты жабуым керек.
Dialogue: 0,0:34:06.71,0:34:11.00,Default,,0,0,0,,Аты аңызға айналған қасиетті қылыштың қынасын табамын деп ешқашан ойламаппын...
Dialogue: 0,0:34:11.13,0:34:12.88,Default,,0,0,0,,Бір кемшілік жоқ
Dialogue: 0,0:34:13.00,0:34:16.67,Default,,0,0,0,,Бұл 1500 жыл бұрынғы дәуірдің қазылған заты ма?
Dialogue: 0,0:34:16.80,0:34:20.01,Default,,0,0,0,,Мұның өзі концептуалды қаруланудың бір түрі.
Dialogue: 0,0:34:20.14,0:34:23.72,Default,,0,0,0,,Материал ретінде ол табиғи түрде ауа райына әсер етпейді.
Dialogue: 0,0:34:23.93,0:34:25.73,Default,,0,0,0,,Тек оны жабдықтау арқылы
Dialogue: 0,0:34:25.81,0:34:29.15,Default,,0,0,0,,Аңызда айтылғандай, бұл қабық иесінің жарасын емдейді.
Dialogue: 0,0:34:29.23,0:34:30.98,Default,,0,0,0,,Қартаюды тоқтатады
Dialogue: 0,0:34:31.27,0:34:35.53,Default,,0,0,0,,Әрине, егер бастапқы иесі сиқырлы күш берген болса.
Dialogue: 0,0:34:35.82,0:34:39.53,Default,,0,0,0,,Басқаша айтқанда, шақырылған батырлық рухпен жұп ретінде қолдансаңыз,
Dialogue: 0,0:34:39.65,0:34:43.20,Default,,0,0,0,,Мұның өзін шебердің асыл фантасмасы ретінде пайдалануға болады.
Dialogue: 0,0:34:43.33,0:34:44.95,Default,,0,0,0,,Сізге ұқсайды.
Dialogue: 0,0:34:45.04,0:34:47.83,Default,,0,0,0,,Құрал әлі де құрал бола ма?
Dialogue: 0,0:34:47.91,0:34:50.63,Default,,0,0,0,,Олай десеңіз, қызметшілер үшін де солай.
Dialogue: 0,0:34:51.13,0:34:53.46,Default,,0,0,0,,Батырлық рух қанша атақты болса да,
Dialogue: 0,0:34:53.54,0:34:55.67,Default,,0,0,0,,Қызметші ретінде шақырылса
Dialogue: 0,0:34:55.80,0:34:58.05,Default,,0,0,0,,Шеберге ол құрал сияқты жақсы.
Dialogue: 0,0:34:58.47,0:35:00.89,Default,,0,0,0,,Оған оғаш елес әкелетіндер
Dialogue: 0,0:35:01.47,0:35:04.06,Default,,0,0,0,,Мен бұл шайқастан аман қалмайтыныма сенімдімін.
Dialogue: 0,0:35:04.47,0:35:07.68,Default,,0,0,0,,Бұл қынап сізге қолайлы.
Dialogue: 0,0:35:07.81,0:35:10.56,Default,,0,0,0,,Бұл атаның шешімі емес пе?
Dialogue: 0,0:35:10.69,0:35:12.73,Default,,0,0,0,,Қызық, бұл рас па?
Dialogue: 0,0:35:13.23,0:35:15.86,Default,,0,0,0,,Ұлы атаңыздың сыйына көңіліңіз толмай ма?
Dialogue: 0,0:35:15.98,0:35:17.03,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:35:17.40,0:35:19.36,Default,,0,0,0,,Ахт қарт жақсы жұмыс істеді.
Dialogue: 0,0:35:19.82,0:35:23.03,Default,,0,0,0,,Меніңше, қолында мұндай козирі бар басқа шебер жоқ.
Dialogue: 0,0:35:23.12,0:35:24.99,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:35:25.37,0:35:28.79,Default,,0,0,0,,Кездейсоқ сыйлық ретінде тамаша қасиетті жәдігер болса,
Dialogue: 0,0:35:29.08,0:35:33.75,Default,,0,0,0,,Сіз іздеген батырлық рухтың шақыруға жауап беретіні сөзсіз.
Dialogue: 0,0:35:34.79,0:35:38.05,Default,,0,0,0,,Аты аңызға айналған рыцарь король Артур Пендрагон
Dialogue: 0,0:35:38.88,0:35:42.64,Default,,0,0,0,,Менімен, шебермен үйлесімділігіңізді артқы жағына қойыңыз.
Dialogue: 0,0:35:43.18,0:35:45.89,Default,,0,0,0,,Бірақ егер сіз Экскалибурды тасымалдаушы болсаңыз
Dialogue: 0,0:35:46.01,0:35:49.85,Default,,0,0,0,,Бұл Сабер сыныбының ең жақсы картасы екені сөзсіз.
Dialogue: 0,0:35:49.98,0:35:51.06,Default,,0,0,0,,That's right.
Dialogue: 0,0:35:51.48,0:35:53.40,Default,,0,0,0,,Мен бәрінен де жеңілмейтін құлды қалаймын.
Dialogue: 0,0:35:53.48,0:35:55.27,Default,,0,0,0,,Сіз аласыз
Dialogue: 0,0:35:55.40,0:35:58.61,Default,,0,0,0,,Мәселе мынада: оның ең күшті күші
Dialogue: 0,0:35:58.73,0:36:00.82,Default,,0,0,0,,Бұл оны қалай жақсы пайдалану керектігі туралы мәселе.
Dialogue: 0,0:36:01.24,0:36:04.07,Default,,0,0,0,,Шынымды айтсам, өңдеудің қарапайымдылығы жағынан,
Dialogue: 0,0:36:04.28,0:36:06.37,Default,,0,0,0,,Кастер немесе Ассасин?
Dialogue: 0,0:36:06.45,0:36:08.91,Default,,0,0,0,,Бұл менің мінезіме өте сәйкес келді.
Dialogue: 0,0:36:09.45,0:36:12.83,Default,,0,0,0,,Шақыру алдында уайымдасаңыз, көмектесу мүмкін емес.
Dialogue: 0,0:36:13.50,0:36:17.09,Default,,0,0,0,,Рыцарлар патшасының шын мәнінде қандай адам екенін білмеймін.
Dialogue: 0,0:36:17.42,0:36:20.76,Default,,0,0,0,,Сіздің стратегияңыз қандай болса да
Dialogue: 0,0:36:20.84,0:36:23.72,Default,,0,0,0,,Арманың мен мұратыңды білсең
Dialogue: 0,0:36:24.30,0:36:27.39,Default,,0,0,0,,Мен оның түсінетініне сенімдімін.
Dialogue: 0,0:36:29.60,0:36:31.02,Default,,0,0,0,,Мен сияқты
Dialogue: 0,0:36:33.44,0:36:34.60,Default,,0,0,0,,(Орындықтан тұру дыбысы)
Dialogue: 0,0:36:36.44,0:36:37.19,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:36:37.82,0:36:39.44,Default,,0,0,0,,Маған бір жоспар келді
Dialogue: 0,0:36:39.94,0:36:41.49,Default,,0,0,0,,Ең күшті қызметші
Dialogue: 0,0:36:43.49,0:36:46.28,Default,,0,0,0,,Ең күшті қуатты пайдаланудың жолы бар
Dialogue: 0,0:36:47.62,0:36:51.04,Default,,0,0,0,,Иә... ой...
Dialogue: 0,0:36:54.00,0:36:55.79,Default,,0,0,0,,Сәлем Рин
Dialogue: 0,0:36:58.04,0:36:59.92,Default,,0,0,0,,Сәлем Кирей
Dialogue: 0,0:37:00.00,0:37:01.34,Default,,0,0,0,,Сіз шығасыз ба?
Dialogue: 0,0:37:01.46,0:37:03.80,Default,,0,0,0,,Бұл өте үлкен жүк сияқты.
Dialogue: 0,0:37:03.93,0:37:07.89,Default,,0,0,0,,Иә, бүгіннен бастап мен саған Зенджоудың үйінде қамқор боламын.
Dialogue: 0,0:37:10.10,0:37:14.48,Default,,0,0,0,,Кирей әкесінің қасында қалып, бірге соғысады емес пе?
Dialogue: 0,0:37:14.56,0:37:17.94,Default,,0,0,0,,Сол үшін шәкірт болып келдім.
Dialogue: 0,0:37:19.98,0:37:20.86,Default,,0,0,0,,Кирей
Dialogue: 0,0:37:21.07,0:37:23.07,Default,,0,0,0,,Саған сене аламын ба?
Dialogue: 0,0:37:23.15,0:37:24.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:24.40,0:37:29.08,Default,,0,0,0,,Әкеңді соңына дейін аман-есен қорғауға уәде бересің бе?
Dialogue: 0,0:37:29.45,0:37:31.74,Default,,0,0,0,,Бұл мүмкін емес сұрақ.
Dialogue: 0,0:37:31.83,0:37:36.17,Default,,0,0,0,,Егер мұндай уәде беру үшін шайқас жеткілікті бейбіт болса.
Dialogue: 0,0:37:36.29,0:37:40.00,Default,,0,0,0,,Сізді немесе әйеліңізді эвакуациялаудың қажеті жоқ.
Dialogue: 0,0:37:43.34,0:37:46.93,Default,,0,0,0,,Мен саған әлі ғашық бола алмаймын
Dialogue: 0,0:37:47.01,0:37:51.85,Default,,0,0,0,,Рин, сен өзіңіздің шынайы сезімдеріңізді көпшілік алдында бұлай білдірмеуіңіз керек.
Dialogue: 0,0:37:51.93,0:37:56.77,Default,,0,0,0,,Әйтпесе, сені тәрбиелеп отырған әкенің адалдығына күмән келтіріледі.
Dialogue: 0,0:37:56.85,0:37:58.56,Default,,0,0,0,,Бұған сенің әкеңнің еш қатысы жоқ!
Dialogue: 0,0:37:58.90,0:38:00.02,Default,,0,0,0,,Жақсы Кирей?
Dialogue: 0,0:38:00.11,0:38:01.52,Default,,0,0,0,,Бұрыштарды кессеңіз
Dialogue: 0,0:38:01.61,0:38:04.19,Default,,0,0,0,,Әкеңе зиян келтіруі мүмкін бірдеңе болса ше?
Dialogue: 0,0:38:04.32,0:38:06.36,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:38:06.45,0:38:08.70,Default,,0,0,0,,Рин не істеп жатырсың?
Dialogue: 0,0:38:08.82,0:38:10.41,Default,,0,0,0,,Дауыс
Dialogue: 0,0:38:10.53,0:38:12.62,Default,,0,0,0,,Әй...
Dialogue: 0,0:38:13.83,0:38:14.75,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:38:14.87,0:38:19.67,Default,,0,0,0,,Екеуміз айырылмас бұрын ол мені жігерлендірді, ханым.
Dialogue: 0,0:38:20.54,0:38:21.59,Default,,0,0,0,,Көмектесейік
Dialogue: 0,0:38:21.71,0:38:24.96,Default,,0,0,0,,Ол чемодан саған тым ауыр болады.
Dialogue: 0,0:38:25.05,0:38:27.17,Default,,0,0,0,,Мәселе жоқ, мұны өзіңіз жасай аласыз!
Dialogue: 0,0:38:27.80,0:38:32.05,Default,,0,0,0,,Котомине мырза, менің күйеуіме жақсы көңіл бөліңіз.
Dialogue: 0,0:38:32.18,0:38:34.68,Default,,0,0,0,,Өтінемін, ол кісінің тілегін орында.
Dialogue: 0,0:38:35.22,0:38:37.81,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын, уайымдама.
Dialogue: 0,0:38:39.15,0:38:39.94,Default,,0,0,0,,Ара
Dialogue: 0,0:38:40.06,0:38:41.23,Default,,0,0,0,,
Dialogue: 0,0:38:42.23,0:38:43.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:38:44.23,0:38:46.24,Default,,0,0,0,,Сіз дұрыс жерге келдіңіз.
Dialogue: 0,0:38:46.57,0:38:50.11,Default,,0,0,0,,Мен дайындаған қасиетті жәдігерлер бүгін таңертең келді.
Dialogue: 0,0:38:50.24,0:38:51.66,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:38:52.91,0:38:53.99,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:38:54.08,0:38:56.79,Default,,0,0,0,,Фуфуфу Қиыр ежелгі дәуір
Dialogue: 0,0:38:56.91,0:39:00.71,Default,,0,0,0,,Бұл дүниеде алғаш рет терісін төккен жыланның тасқа айналған қабығы.
Dialogue: 0,0:39:01.13,0:39:04.92,Default,,0,0,0,,Егер сіз оны медиа ретінде пайдаланып сәтті шақырсаңыз
Dialogue: 0,0:39:05.34,0:39:09.30,Default,,0,0,0,,Сол кезде біздің жеңісіміз расталды.
Dialogue: 0,0:39:09.84,0:39:12.39,Default,,0,0,0,,(Кәрияның ыңылдаған дауысы)
Dialogue: 0,0:39:13.60,0:39:15.39,Default,,0,0,0,,А... а...
Dialogue: 0,0:39:15.47,0:39:17.14,Default,,0,0,0,,Сәлем Сакура-чан
Dialogue: 0,0:39:18.31,0:39:19.60,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:39:20.14,0:39:22.10,Default,,0,0,0,,Иә, сіздің бетіңіз...
Dialogue: 0,0:39:22.23,0:39:24.07,Default,,0,0,0,,О, сәл ғана.
Dialogue: 0,0:39:24.19,0:39:28.28,Default,,0,0,0,,Денемдегі жәндіктерге тағы да аздап арықтаған сияқтымын.
Dialogue: 0,0:39:28.36,0:39:32.11,Default,,0,0,0,,Қарт Сакура-чан сияқты шыдамды емес екеніне сенімдімін.
Dialogue: 0,0:39:32.41,0:39:33.28,Default,,0,0,0,,Хаха…
Dialogue: 0,0:39:33.66,0:39:37.83,Default,,0,0,0,,Қария ағай барған сайын басқа адамға ұқсайды.
Dialogue: 0,0:39:40.25,0:39:42.04,Default,,0,0,0,,Мүмкін солай.
Dialogue: 0,0:39:42.46,0:39:46.75,Default,,0,0,0,,Бүгін түнде мен жәндіктер қоймасына барудың қажеті жоқ.
Dialogue: 0,0:39:46.84,0:39:50.72,Default,,0,0,0,,Қарт одан да маңызды рәсім бар екенін айтты.
Dialogue: 0,0:39:50.80,0:39:52.47,Default,,0,0,0,,Мен олардың қазіргі күйінде Элкияны құтқара алатынына сенбеймін.
Dialogue: 0,0:39:52.55,0:39:55.97,Default,,0,0,0,,Сонымен, бүгін кешке оның орнына ағам жертөлеге барады.
Dialogue: 0,0:39:56.31,0:39:59.81,Default,,0,0,0,,Қария аға, алыс жаққа барасыз ба?
Dialogue: 0,0:39:59.93,0:40:01.23,Default,,0,0,0,,Біраз уақыттан кейін
Dialogue: 0,0:40:01.31,0:40:04.40,Default,,0,0,0,,Ағай маңызды жұмыстармен айналысады.
Dialogue: 0,0:40:04.48,0:40:07.69,Default,,0,0,0,,Мен Сакура-чанмен осылай сөйлесуге уақыт бөле аламын.
Dialogue: 0,0:40:07.82,0:40:09.86,Default,,0,0,0,,Ол азырақ таралған болуы мүмкін.
Dialogue: 0,0:40:11.11,0:40:12.24,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:40:13.32,0:40:14.66,Default,,0,0,0,,Сәлем Сакура-чан
Dialogue: 0,0:40:14.87,0:40:16.95,Default,,0,0,0,,Ағасы жұмысын аяқтағанда
Dialogue: 0,0:40:17.03,0:40:19.37,Default,,0,0,0,,Бәріміз тағы бірге шығамыз ба?
Dialogue: 0,0:40:19.50,0:40:21.50,Default,,0,0,0,,Анаң мен әпкеңді де ала кел.
Dialogue: 0,0:40:22.42,0:40:24.71,Default,,0,0,0,,Анаң мен әпкең...
Dialogue: 0,0:40:24.83,0:40:27.17,Default,,0,0,0,,Мені олай атайтын ешкім жоқ па?
Dialogue: 0,0:40:27.84,0:40:30.55,Default,,0,0,0,,Мен ол жерде болмадым деп ойлаңыз.
Dialogue: 0,0:40:30.67,0:40:32.68,Default,,0,0,0,,Иә, қария
Dialogue: 0,0:40:34.51,0:40:35.59,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:40:45.90,0:40:47.02,Default,,0,0,0,,Ағай?
Dialogue: 0,0:40:47.15,0:40:51.78,Default,,0,0,0,,Олай болса, Тохсака отбасынан Аои-сан мен Рин-чанды алыңыз.
Dialogue: 0,0:40:51.86,0:40:55.91,Default,,0,0,0,,Ағай мен Сакура-чанмен алыс жерге барайық.
Dialogue: 0,0:40:56.20,0:41:00.33,Default,,0,0,0,,Бұрынғыдай тағы бірге ойнайық
Dialogue: 0,0:41:00.83,0:41:04.17,Default,,0,0,0,,Мен ол адамдарды қайтадан көремін бе?
Dialogue: 0,0:41:04.25,0:41:06.17,Default,,0,0,0,,Ах, мен тағы да кездесетінімізге сенімдімін
Dialogue: 0,0:41:06.46,0:41:08.84,Default,,0,0,0,,Бұған ағай уәде береді.
Dialogue: 0,0:41:13.80,0:41:17.80,Default,,0,0,0,,Ал, ағай, кететін уақыт болды.
Dialogue: 0,0:41:17.93,0:41:18.85,Default,,0,0,0,,Иә
Dialogue: 0,0:41:20.43,0:41:22.89,Default,,0,0,0,,Аман болыңыз Қария аға
Dialogue: 0,0:41:27.02,0:41:28.06,Default,,0,0,0,,Қош бол
Dialogue: 0,0:41:29.86,0:41:33.07,Default,,0,0,0,,Сіз шақыру заклинаниясын жаттаған болуыңыз керек, солай ма?
Dialogue: 0,0:41:33.78,0:41:34.53,Default,,0,0,0,,О
Dialogue: 0,0:41:34.61,0:41:35.57,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:41:35.70,0:41:40.95,Default,,0,0,0,,Бірақ жырдың ортасында тағы екі шумақты сөз ұштасады.
Dialogue: 0,0:41:41.08,0:41:42.24,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:41:42.37,0:41:44.75,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:41:45.08,0:41:48.25,Default,,0,0,0,,Сиқыршы ретіндегі дәрежеңіз қандай?
Dialogue: 0,0:41:48.38,0:41:52.71,Default,,0,0,0,,Басқа шеберлермен салыстырғанда мен аздап төменмін.
Dialogue: 0,0:41:52.80,0:41:55.59,Default,,0,0,0,,Бұл қызметшінің негізгі қабілеттеріне де әсер етеді.
Dialogue: 0,0:41:55.93,0:41:58.97,Default,,0,0,0,,Содан кейін, қызметшінің сыныбына негізделген түзетумен.
Dialogue: 0,0:41:59.09,0:42:03.10,Default,,0,0,0,,Біз параметрлерді өздері көтеруіміз керек.
Dialogue: 0,0:42:04.06,0:42:05.10,Default,,0,0,0,,Қария
Dialogue: 0,0:42:05.31,0:42:07.39,Default,,0,0,0,,Осы жолы мен шақыратын қызметші
Dialogue: 0,0:42:07.48,0:42:11.02,Default,,0,0,0,,Жындылық қасиетін қосқанымды қалайсыз ба?
Dialogue: 0,0:42:12.94,0:42:16.11,Default,,0,0,0,,Митаза Митаза Митаза Митаза Митаза
Dialogue: 0,0:42:16.61,0:42:18.66,Default,,0,0,0,,Бес рет қайталаңыз
Dialogue: 0,0:42:18.78,0:42:21.08,Default,,0,0,0,,Тек қана көңіліңізден шыққан уақытты жойыңыз
Dialogue: 0,0:42:22.33,0:42:23.95,Default,,0,0,0,,Негізінде күміс пен темір
Dialogue: 0,0:42:24.75,0:42:27.16,Default,,0,0,0,,Негіз тасы және Келісім Ұлы Герцог
Dialogue: 0,0:42:27.50,0:42:30.21,Default,,0,0,0,,Швайорг, ата-бабам үшін шеберім
Dialogue: 0,0:42:30.67,0:42:32.59,Default,,0,0,0,,Құлаған желге қарсы қабырғалар
Dialogue: 0,0:42:32.67,0:42:35.80,Default,,0,0,0,,Төрт қақпа жабық, тәжден шығады.
Dialogue: 0,0:42:36.13,0:42:39.30,Default,,0,0,0,,Патшалыққа апаратын үш жақты жолды айналдыр.
Dialogue: 0,0:42:39.84,0:42:42.14,Default,,0,0,0,,Бұл батырлық рухты шақыру туралы.
Dialogue: 0,0:42:42.26,0:42:44.81,Default,,0,0,0,,Мұндай қарапайым рәсімнің болуы дұрыс па?
Dialogue: 0,0:42:44.89,0:42:46.98,Default,,0,0,0,,Бұл біраз тақырыптан тыс болуы мүмкін.
Dialogue: 0,0:42:48.10,0:42:49.85,Default,,0,0,0,,Қызметшіні шақыру
Dialogue: 0,0:42:49.98,0:42:52.82,Default,,0,0,0,,Мұндай ауқымды сеанстың қажеті жоқ.
Dialogue: 0,0:42:53.07,0:42:56.57,Default,,0,0,0,,​​Қызметшіні шын мәнінде шақыратын Қасиетті Граил.
Dialogue: 0,0:42:57.07,0:42:58.65,Default,,0,0,0,,Шебер ретінде
Dialogue: 0,0:42:58.99,0:43:02.12,Default,,0,0,0,,Дүниенің осы жағына көрінген қаһармандық рухты байла
Dialogue: 0,0:43:02.24,0:43:05.79,Default,,0,0,0,,Сізге жеткілікті сиқырлы қуат беру жеткілікті.
Dialogue: 0,0:43:06.70,0:43:07.71,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:43:08.83,0:43:11.67,Default,,0,0,0,,Айри, қасиетті жәдігерді құрбандық үстеліне қойыңыз.
Dialogue: 0,0:43:12.50,0:43:14.50,Default,,0,0,0,,Содан кейін дайындық аяқталады.
Dialogue: 0,0:43:15.17,0:43:16.26,Default,,0,0,0,,айт
Dialogue: 0,0:43:16.55,0:43:21.01,Default,,0,0,0,,Денең менің астымда, тағдырым сенің қылышыңның астында.
Dialogue: 0,0:43:21.14,0:43:25.01,Default,,0,0,0,,Қасиетті Граилдың көзқарасы бойынша, бұл ниет, осы қағида
Dialogue: 0,0:43:25.14,0:43:27.18,Default,,0,0,0,,Егер мойынсұнсаңдар, жауап беріңдер!
Dialogue: 0,0:43:27.64,0:43:29.02,Default,,0,0,0,,Осы жерде кепіл
Dialogue: 0,0:43:29.52,0:43:31.94,Default,,0,0,0,,Мәңгілік әлемге жақсылық әкелетін менмін.
Dialogue: 0,0:43:32.52,0:43:36.19,Default,,0,0,0,,Мәңгілік дүниеде барлық зұлымдықты тудырушы менмін.
Dialogue: 0,0:43:36.53,0:43:41.03,Default,,0,0,0,,Дегенмен, сіз бейберекетсіздікке толы көзбен қатысуыңыз керек.
Dialogue: 0,0:43:41.16,0:43:43.78,Default,,0,0,0,,Сіз жындылық торындағы тұтқынсыз.
Dialogue: 0,0:43:44.28,0:43:46.99,Default,,0,0,0,,Шынжырды ұстайтын менмін
Dialogue: 0,0:43:47.37,0:43:50.37,Default,,0,0,0,,Рухтың үш ұлы сөзін киген жеті аспансың.
Dialogue: 0,0:43:50.75,0:43:52.17,Default,,0,0,0,,Тоқтау шеңберінен келіңіз
Dialogue: 0,0:43:52.63,0:43:54.42,Default,,0,0,0,,Таразыны сақтаушы
Dialogue: 0,0:44:09.22,0:44:11.02,Default,,0,0,0,,(Уайвердің ауыр тыныс алуы)
Dialogue: 0,0:44:16.98,0:44:18.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:19.61,0:44:23.20,Default,,0,0,0,,(Қарияның ауыр тыныс алуы)
Dialogue: 0,0:44:26.24,0:44:27.79,Default,,0,0,0,,Сен жеңдің, Кирей.
Dialogue: 0,0:44:28.45,0:44:29.75,Default,,0,0,0,,Бұл шайқас…
Dialogue: 0,0:44:31.25,0:44:32.96,Default,,0,0,0,,Біздің жеңісіміз!
Dialogue: 0,0:44:38.42,0:44:39.25,Default,,0,0,0,,Ha
Dialogue: 0,0:44:40.26,0:44:41.51,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:44:42.76,0:44:43.76,Default,,0,0,0,,Сұраймыз
Dialogue: 0,0:44:50.22,0:44:53.06,Default,,0,0,0,,Сіз менің қожайынымсыз ба?
Dialogue: 0,0:44:59.61,0:45:05.61,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:47:22.96,0:47:28.97,Default,,0,0,0,,~♪
Dialogue: 0,0:47:29.59,0:47:31.43,Default,,0,0,0,,Сіз Кирицугумен бірге нені мақсат етіп отырсыз
Dialogue: 0,0:47:31.51,0:47:32.39,Default,,0,0,0,,Менің ойымша, бұл дұрыс.
Dialogue: 0,0:47:32.47,0:47:34.47,Default,,0,0,0,,Бізге екі бастық қажет емес.
Dialogue: 0,0:47:34.60,0:47:35.76,Default,,0,0,0,,Әкем де уәде береді
Dialogue: 0,0:47:35.89,0:47:38.02,Default,,0,0,0,,Сен маған қарауға қабілетсізсің.
Dialogue: 0,0:47:38.10,0:47:39.85,Default,,0,0,0,,Сіз өте кереметсіз!
Dialogue: 0,0:47:39.94,0:47:43.98,Default,,0,0,0,,Токиоми Тохсаканы дереу жойыңыз.
Dialogue: 0,0:47:45.48,0:47:51.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory