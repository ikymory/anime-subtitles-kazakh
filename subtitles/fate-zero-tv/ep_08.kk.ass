Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.92,0:00:07.75,Default,,0,0,0,,Эй, Смоки. Ақыры ұстадым-ау.
Dialogue: 0,0:00:10.09,0:00:11.21,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:00:18.89,0:00:19.89,Default,,0,0,0,,Ханым?
Dialogue: 0,0:00:20.60,0:00:22.60,Default,,0,0,0,,Тағы бір жаңа бұзушы.
Dialogue: 0,0:00:22.85,0:00:25.56,Default,,0,0,0,,Алдымызда
Dialogue: 0,0:00:25.69,0:00:28.15,Default,,0,0,0,,Егер бұл жалғаса берсе, біз бір-бірімізді кездестіреміз
Dialogue: 0,0:00:28.27,0:00:29.40,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:00:29.48,0:00:32.11,Default,,0,0,0,,Енді солтүстік жаққа айналма жолмен барайық.
Dialogue: 0,0:00:33.53,0:00:34.45,Default,,0,0,0,,Ha
Dialogue: 0,0:00:35.07,0:00:35.95,Default,,0,0,0,,Ханым?
Dialogue: 0,0:00:36.61,0:00:38.03,Default,,0,0,0,,Не келе жатыр...
Dialogue: 0,0:00:39.95,0:00:41.62,Default,,0,0,0,,Кирей Котомине
Dialogue: 0,0:00:43.12,0:00:49.13,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:07.00,0:02:13.00,Default,,0,0,0,,~♪
Dialogue: 0,0:02:16.88,0:02:18.59,Default,,0,0,0,,Кирей Котомине
Dialogue: 0,0:02:20.64,0:02:24.39,Default,,0,0,0,,Майя-сан, Кирицугудан алған бұйрықтарыңыз болды
Dialogue: 0,0:02:24.56,0:02:26.85,Default,,0,0,0,,Бұл менің қауіпсіздігімді қамтамасыз ету туралы.
Dialogue: 0,0:02:26.98,0:02:27.81,Default,,0,0,0,,Иә
Dialogue: 0,0:02:29.27,0:02:31.06,Default,,0,0,0,,Бірақ... бірақ не?
Dialogue: 0,0:02:31.81,0:02:36.32,Default,,0,0,0,,Мен ол кісінің Кирицугуға кетуіне ешқашан рұқсат бере алмаймын.
Dialogue: 0,0:02:37.74,0:02:39.24,Default,,0,0,0,,Сіз осылай ойлайсыз ба?
Dialogue: 0,0:02:42.53,0:02:44.83,Default,,0,0,0,,Ханым, сіз...
Dialogue: 0,0:02:44.91,0:02:46.58,Default,,0,0,0,,Кездейсоқтық.
Dialogue: 0,0:02:46.70,0:02:49.83,Default,,0,0,0,,Мен де сізбен толықтай келісемін.
Dialogue: 0,0:02:50.83,0:02:52.46,Default,,0,0,0,,Кирей Котомине
Dialogue: 0,0:02:52.58,0:02:57.01,Default,,0,0,0,,Кирицугу үшін ең қауіпті адам...
Dialogue: 0,0:02:58.26,0:03:00.34,Default,,0,0,0,,Екеуміз тоқтаған жеріміз осы.
Dialogue: 0,0:03:01.09,0:03:02.89,Default,,0,0,0,,Жақсы, Майя-сан.
Dialogue: 0,0:03:04.64,0:03:06.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:06.26,0:03:09.43,Default,,0,0,0,,Дайын болыңыз, ханым.
Dialogue: 0,0:03:09.73,0:03:13.15,Default,,0,0,0,,Иә, мен үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:03:13.27,0:03:15.61,Default,,0,0,0,,Сен міндетіңді орындайсың.
Dialogue: 0,0:03:16.11,0:03:18.15,Default,,0,0,0,,Кирицугудан келген бұйрық емес.
Dialogue: 0,0:03:18.44,0:03:20.90,Default,,0,0,0,,Өзіңіз қажет деп санайтын нәрсе
Dialogue: 0,0:03:21.28,0:03:22.11,Default,,0,0,0,,Иә
Dialogue: 0,0:03:23.16,0:03:23.95,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:24.57,0:03:25.37,Default,,0,0,0,,Не?
Dialogue: 0,0:03:25.91,0:03:26.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:27.54,0:03:31.41,Default,,0,0,0,,Адамның жүрегі жұмбақ, солай емес пе?
Dialogue: 0,0:03:34.25,0:03:37.21,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:41.30,0:03:42.09,Default,,0,0,0,,Хмм…
Dialogue: 0,0:03:42.22,0:03:45.35,Default,,0,0,0,,Жұмыс істемейтінін білетін қайталанатын шабуылдар...
Dialogue: 0,0:03:54.85,0:03:55.61,Default,,0,0,0,,Ha
Dialogue: 0,0:03:56.48,0:03:57.65,Default,,0,0,0,,Ол сәл қорқынышты емес пе?
Dialogue: 0,0:04:00.82,0:04:01.82,Default,,0,0,0,,Бас терісі!
Dialogue: 0,0:04:17.67,0:04:22.13,Default,,0,0,0,,Сіз Вольмен Гидраграммасының автономды қорғанысы бұзылғанын айттыңыз ба?
Dialogue: 0,0:04:22.88,0:04:26.59,Default,,0,0,0,,Жоқ, жоқ, бұл баланың шабуылында олай емес.
Dialogue: 0,0:04:26.68,0:04:28.85,Default,,0,0,0,,Мен жай ғана сақамды түсірдім!
Dialogue: 0,0:04:29.76,0:04:31.52,Default,,0,0,0,,Жылдамырақ
Dialogue: 0,0:04:31.64,0:04:34.89,Default,,0,0,0,,Және қорғанысыңызды тиімдірек дайындаңыз...
Dialogue: 0,0:04:36.56,0:04:39.02,Default,,0,0,0,,Сиқыршының беті масқара...
Dialogue: 0,0:04:39.40,0:04:40.98,Default,,0,0,0,,Ей, масқара!
Dialogue: 0,0:04:41.36,0:04:43.36,Default,,0,0,0,,Қанымды төгу...
Dialogue: 0,0:04:44.24,0:04:46.20,Default,,0,0,0,,Бұл мені еске түсіреді!
Dialogue: 0,0:04:51.54,0:04:54.66,Default,,0,0,0,,Бұл заттың құдіретін осылай түсінді.
Dialogue: 0,0:04:55.00,0:04:57.21,Default,,0,0,0,,Дәл сол шабуыл енді жұмыс істемейді
Dialogue: 0,0:04:57.88,0:04:59.88,Default,,0,0,0,,Содан кейін оған барлық сиқырлы күшіңізді құйыңыз.
Dialogue: 0,0:05:00.00,0:05:01.46,Default,,0,0,0,,Олар өздерін қорғауы керек.
Dialogue: 0,0:05:02.71,0:05:03.55,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:04.63,0:05:06.84,Default,,0,0,0,,Егер олай болмаса, мен қиыншылыққа тап болар едім.
Dialogue: 0,0:05:07.22,0:05:08.34,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:24.99,0:05:26.20,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:32.95,0:05:33.79,Default,,0,0,0,,Гэндзюцу?
Dialogue: 0,0:05:51.39,0:05:52.81,Default,,0,0,0,,Майя-сан, жоқ!
Dialogue: 0,0:05:53.18,0:05:54.18,Default,,0,0,0,,Уф!Қарғыс атқыр...
Dialogue: 0,0:06:04.65,0:06:05.65,Default,,0,0,0,,Ha
Dialogue: 0,0:06:07.28,0:06:08.45,Default,,0,0,0,,Гах...
Dialogue: 0,0:06:10.28,0:06:12.03,Default,,0,0,0,,Гааааааааааа!
Dialogue: 0,0:06:12.16,0:06:14.45,Default,,0,0,0,,Гаха… Каа…
Dialogue: 0,0:06:20.67,0:06:23.13,Default,,0,0,0,,Ханым... Мен алмаймын...
Dialogue: 0,0:06:24.30,0:06:27.55,Default,,0,0,0,,Әйел, сіз таң қалуыңыз мүмкін, бірақ
Dialogue: 0,0:06:27.80,0:06:31.01,Default,,0,0,0,,Мен мұнда сені жеңу үшін келген жоқпын.
Dialogue: 0,0:06:31.97,0:06:35.22,Default,,0,0,0,,Мен Кирей Котоминді түсінемін
Dialogue: 0,0:06:36.47,0:06:38.48,Default,,0,0,0,,Мен сіздің мақсатыңызды білемін
Dialogue: 0,0:06:38.68,0:06:40.60,Default,,0,0,0,,Бірақ бұл қиын кеңес.
Dialogue: 0,0:06:40.90,0:06:43.90,Default,,0,0,0,,Сіз Кирицугу Эмияға ешқашан жете алмайсыз.
Dialogue: 0,0:06:44.73,0:06:46.36,Default,,0,0,0,,Біз оның алдын аламыз.
Dialogue: 0,0:06:47.28,0:06:48.24,Default,,0,0,0,,Мұнда
Dialogue: 0,0:06:48.32,0:06:49.28,Default,,0,0,0,,Ханым!
Dialogue: 0,0:06:49.36,0:06:52.82,Default,,0,0,0,,Бұл адам агент және сиқыршы аңшылықтың шебері!
Dialogue: 0,0:06:52.91,0:06:55.28,Default,,0,0,0,,Мен жай ғана сиқырмен ештеңе істей алатын адам емеспін!
Dialogue: 0,0:06:58.66,0:07:00.83,Default,,0,0,0,,Кирицугудан не үйрендім
Dialogue: 0,0:07:00.92,0:07:02.96,Default,,0,0,0,,Бұл жай ғана көлік жүргізу емес, солай ма?
Dialogue: 0,0:07:03.38,0:07:06.63,Default,,0,0,0,,Өмір сүру және аман қалу үшін!
Dialogue: 0,0:07:07.17,0:07:09.09,Default,,0,0,0,,Shape ist leben!
Dialogue: 0,0:07:09.97,0:07:11.18,Default,,0,0,0,,(айқай)
Dialogue: 0,0:07:15.47,0:07:16.43,Default,,0,0,0,,(айқай)
Dialogue: 0,0:07:24.15,0:07:24.90,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:37.83,0:07:39.91,Default,,0,0,0,,Ханым! Бұл тәтті!
Dialogue: 0,0:07:43.50,0:07:44.25,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:07:52.55,0:07:53.72,Default,,0,0,0,,Майя-сан!
Dialogue: 0,0:07:55.39,0:07:56.43,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:07:58.47,0:07:59.60,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:08:08.11,0:08:09.40,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:13.57,0:08:15.11,Default,,0,0,0,,(Кирейдің тыныс алу дыбысы)
Dialogue: 0,0:08:24.21,0:08:25.58,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:08:27.34,0:08:28.59,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:08:49.19,0:08:50.23,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:08:50.32,0:08:51.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:01.49,0:09:03.75,Default,,0,0,0,,Іс осыншама жеткенде,
Dialogue: 0,0:09:03.83,0:09:06.46,Default,,0,0,0,,Мен таң қалдым, таң қалдым.
Dialogue: 0,0:09:06.83,0:09:08.79,Default,,0,0,0,,Бұл сиқырлы кітап, Лансер.
Dialogue: 0,0:09:09.50,0:09:13.67,Default,,0,0,0,,Оның асыл фантасмасы болғанша, бұл соғыс жағдайын өзгерту мүмкін емес.
Dialogue: 0,0:09:14.42,0:09:16.68,Default,,0,0,0,,Мен көремін. Солай ма?
Dialogue: 0,0:09:17.30,0:09:19.35,Default,,0,0,0,,Бірақ әлгі көкбауырдың қолынан
Dialogue: 0,0:09:19.47,0:09:21.76,Default,,0,0,0,,Кітапты өшіргіңіз келсе
Dialogue: 0,0:09:22.01,0:09:23.31,Default,,0,0,0,,Апа, мен өскенде,
Dialogue: 0,0:09:23.43,0:09:25.89,Default,,0,0,0,,Бұл бейбақтардың қабырғасын бұзып өтуден басқа амалымыз жоқ.
Dialogue: 0,0:09:26.39,0:09:27.52,Default,,0,0,0,,Лансер
Dialogue: 0,0:09:27.65,0:09:30.86,Default,,0,0,0,,Осыған байланысты құмар ойын ойнауға дайынсыз ба?
Dialogue: 0,0:09:31.27,0:09:33.32,Default,,0,0,0,,Мен ашулымын, өйткені өзімді жеңілген сезінемін.
Dialogue: 0,0:09:33.44,0:09:36.32,Default,,0,0,0,,Закомен бұлай ойнай беруде өнер жоқ.
Dialogue: 0,0:09:36.90,0:09:39.87,Default,,0,0,0,,Жарайды, мінейік, Сабер.
Dialogue: 0,0:09:40.16,0:09:44.16,Default,,0,0,0,,Мен жол ашамын, бұл сенің бір мүмкіндігің.
Dialogue: 0,0:09:44.50,0:09:47.33,Default,,0,0,0,,Lancer Сіз желді басып жүгіре аласыз ба?
Dialogue: 0,0:09:47.67,0:09:49.79,Default,,0,0,0,,Хехе, түсіндім.
Dialogue: 0,0:09:49.88,0:09:50.88,Default,,0,0,0,,Бұл сезім… қате емес
Dialogue: 0,0:09:51.17,0:09:54.46,Default,,0,0,0,,Соңғы намазыңызды аяқтадыңыз ба?
Dialogue: 0,0:09:54.55,0:09:58.18,Default,,0,0,0,,Енді, қорқыныш, үмітсіздік!
Dialogue: 0,0:09:58.26,0:10:00.97,Default,,0,0,0,,Әскери ерлік дәрежесі арқылы ғана жеңуге болатын «сандағы айырмашылық»
Dialogue: 0,0:10:01.05,0:10:03.89,Default,,0,0,0,,Шектер бар.
Dialogue: 0,0:10:04.60,0:10:06.23,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:10:06.48,0:10:08.89,Default,,0,0,0,,Масқара, солай ма?
Dialogue: 0,0:10:09.02,0:10:11.81,Default,,0,0,0,,Жындармен жаншылған даңқ та, абырой да жоқ.
Dialogue: 0,0:10:11.90,0:10:14.65,Default,,0,0,0,,Мен тұншығып өлемін!
Dialogue: 0,0:10:14.86,0:10:18.74,Default,,0,0,0,,Батыр үшін бұдан асқан ұят жоқ.
Dialogue: 0,0:10:18.86,0:10:21.87,Default,,0,0,0,,Уау! Сол әдемі жүз!
Dialogue: 0,0:10:21.95,0:10:24.79,Default,,0,0,0,,Енді оның қатты бұрмалануына жол беретін кез келді.
Dialogue: 0,0:10:24.91,0:10:25.75,Default,,0,0,0,,Жанна!
Dialogue: 0,0:10:29.83,0:10:32.50,Default,,0,0,0,,Strike Air!
Dialogue: 0,0:10:38.01,0:10:39.01,Default,,0,0,0,,Эй!?
Dialogue: 0,0:10:40.76,0:10:43.14,Default,,0,0,0,,Міне кеттік! Дайын болыңыз!
Dialogue: 0,0:10:45.72,0:10:48.06,Default,,0,0,0,,Гуге! Жын қызыл раушан (гей жаргу)!
Dialogue: 0,0:10:49.19,0:10:50.02,Default,,0,0,0,,Эй!
Dialogue: 0,0:10:54.61,0:10:58.94,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:11:12.96,0:11:14.34,Default,,0,0,0,,Сіз
Dialogue: 0,0:11:14.79,0:11:17.92,Default,,0,0,0,,Сен, сен, сен, сен, сен...
Dialogue: 0,0:11:18.01,0:11:19.84,Default,,0,0,0,,Сіз!!
Dialogue: 0,0:11:21.93,0:11:23.09,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:23.34,0:11:25.97,Default,,0,0,0,,Сабер енді «сол қолын» артқа қайтарса
Dialogue: 0,0:11:26.10,0:11:28.64,Default,,0,0,0,,Дөрекі сөзбен айтқанда, мынандай.
Dialogue: 0,0:11:30.68,0:11:32.14,Default,,0,0,0,,Дайын болыңыз.
Dialogue: 0,0:11:32.27,0:11:33.02,Default,,0,0,0,,Git!
Dialogue: 0,0:11:33.98,0:11:35.02,Default,,0,0,0,,Гедо
Dialogue: 0,0:11:35.77,0:11:39.57,Default,,0,0,0,,Жарайды... куууу!
Dialogue: 0,0:11:51.21,0:11:52.62,Default,,0,0,0,,Бұл нонсенс...
Dialogue: 0,0:11:52.71,0:11:55.13,Default,,0,0,0,,Мен осындай шайқасқа шыққым келеді
Dialogue: 0,0:11:55.21,0:11:58.25,Default,,0,0,0,,Біз Қасиетті Граил соғысына қатыспаймыз!
Dialogue: 0,0:12:09.14,0:12:11.14,Default,,0,0,0,,Ол қайда...?
Dialogue: 0,0:12:18.15,0:12:19.73,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:12:20.94,0:12:22.82,Default,,0,0,0,,Тінтуір тінтуірі
Dialogue: 0,0:12:27.45,0:12:31.75,Default,,0,0,0,,Сіз дәл сол қозғалыс бұрынғыдай жұмыс істейді деп ешқашан ойлаған жоқсыз, солай ма?
Dialogue: 0,0:12:32.20,0:12:33.54,Default,,0,0,0,,Төменгі өмір...
Dialogue: 0,0:12:35.37,0:12:38.50,Default,,0,0,0,,Сен мені бір жебемен марапаттадың.
Dialogue: 0,0:12:38.59,0:12:41.21,Default,,0,0,0,,Бұл мәміле немесе қулық немесе басқа нәрсе емес.
Dialogue: 0,0:12:41.55,0:12:44.68,Default,,0,0,0,,Бұл абсурдтық деп аталатын жай ғана кездейсоқтық.
Dialogue: 0,0:12:44.80,0:12:46.64,Default,,0,0,0,,Мен сізге айырмашылықты көрсетемін
Dialogue: 0,0:12:47.22,0:12:49.35,Default,,0,0,0,,Мен енді оңай өлтірмеймін.
Dialogue: 0,0:12:49.68,0:12:52.77,Default,,0,0,0,,Емдеу арқылы тек өкпе мен жүрек қалпына келеді.
Dialogue: 0,0:12:52.85,0:12:55.90,Default,,0,0,0,,Мен оны саусағыңыздың ұшынан бастап мұқият кесемін.
Dialogue: 0,0:12:56.35,0:13:00.40,Default,,0,0,0,,Өкінішпен, азаптан, үмітсіздіктен өл.
Dialogue: 0,0:13:01.07,0:13:03.57,Default,,0,0,0,,Өлген сайын қарғыс айт.
Dialogue: 0,0:13:03.69,0:13:06.32,Default,,0,0,0,,Жұмыс берушіңіздің қорқақтығы
Dialogue: 0,0:13:06.53,0:13:09.91,Default,,0,0,0,,Қасиетті Граил соғысын масқара еткен Эйнцберндер!
Dialogue: 0,0:13:11.49,0:13:14.29,Default,,0,0,0,,Қуаныш, мейірімсіз!
Dialogue: 0,0:13:16.75,0:13:17.58,Default,,0,0,0,,Хун
Dialogue: 0,0:13:22.30,0:13:24.84,Default,,0,0,0,,Менің ойымша, бұл солай болды! Ақымақ!
Dialogue: 0,0:13:30.43,0:13:31.18,Default,,0,0,0,,Иә
Dialogue: 0,0:13:32.35,0:13:33.60,Default,,0,0,0,,Уа!
Dialogue: 0,0:13:35.14,0:13:36.44,Default,,0,0,0,,Күрес!
Dialogue: 0,0:13:36.94,0:13:37.69,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:13:44.19,0:13:44.99,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:13:52.62,0:13:55.91,Default,,0,0,0,,Мен... Мен жексұрын адаммын.
Dialogue: 0,0:13:57.25,0:13:58.08,Default,,0,0,0,,Лансер
Dialogue: 0,0:14:00.54,0:14:01.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:06.09,0:14:09.01,Default,,0,0,0,,Қожайыныма қауіп төніп тұр...
Dialogue: 0,0:14:09.93,0:14:13.89,Default,,0,0,0,,Шамасы, ол мені артта қалдырып, сенің негізгі қоршауыңды шауып тастады.
Dialogue: 0,0:14:17.31,0:14:20.02,Default,,0,0,0,,Мен сенімдімін... бұл менің қожайынымның ісі.
Dialogue: 0,0:14:21.94,0:14:23.90,Default,,0,0,0,,Лансер, асығыңыз!
Dialogue: 0,0:14:24.53,0:14:26.40,Default,,0,0,0,,Иемізге көмекке барыңыз.
Dialogue: 0,0:14:28.78,0:14:31.45,Default,,0,0,0,,Тоқтатуға болмайтын Рыцарлар патшасы
Dialogue: 0,0:14:31.91,0:14:32.95,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:33.08,0:14:36.37,Default,,0,0,0,,Екеуміз бұл мәселені рыцарь ретінде шешуге ант еттік.
Dialogue: 0,0:14:36.79,0:14:38.66,Default,,0,0,0,,Сол мақтанышқа бірге берік болайық
Dialogue: 0,0:14:45.80,0:14:50.55,Default,,0,0,0,,Ақырында бәрі Кирицугу жоспарлағандай болды.
Dialogue: 0,0:14:52.64,0:14:53.39,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:14:56.64,0:14:59.64,Default,,0,0,0,,Баланың шығу тегі – «кесу» және «бірлесу»
Dialogue: 0,0:14:59.77,0:15:01.02,Default,,0,0,0,,Кесу және мұра ету
Dialogue: 0,0:15:04.44,0:15:08.28,Default,,0,0,0,,Оны «жою және қалпына келтіру» деп атаудың сәл өзгеше нюансы бар.
Dialogue: 0,0:15:09.11,0:15:11.49,Default,,0,0,0,,Бірде кесіліп, қайта байланған жіп
Dialogue: 0,0:15:11.57,0:15:14.49,Default,,0,0,0,,Тек түйін бөлігінің қалыңдығы өзгереді, солай ма?
Dialogue: 0,0:15:14.62,0:15:18.70,Default,,0,0,0,,Ол қайтымсыз өзгеріс коннотациясына ие.
Dialogue: 0,0:15:23.17,0:15:28.34,Default,,0,0,0,,Бұл оқта баланың ұнтақталған қабырғалары бар.
Dialogue: 0,0:15:28.42,0:15:32.38,Default,,0,0,0,,Осы арқылы баланың шыққан тегі атылған адам үшін шындыққа айналады.
Dialogue: 0,0:15:33.34,0:15:35.51,Default,,0,0,0,,​​Бұл жігіт сиқыршыларға қауіп төндіреді.
Dialogue: 0,0:15:36.22,0:15:39.35,Default,,0,0,0,,Бұл оққа мен сиқырмен аралассам,
Dialogue: 0,0:15:39.43,0:15:42.77,Default,,0,0,0,,Баланың шығу тегіне байланысты сиқырлы тізбек «үзілген».
Dialogue: 0,0:15:42.85,0:15:44.65,Default,,0,0,0,,«Қосылу» кездейсоқ
Dialogue: 0,0:15:44.73,0:15:47.19,Default,,0,0,0,,Неғұрлым сиқыршы болсаң, соғұрлым жақсысың.
Dialogue: 0,0:15:47.32,0:15:50.15,Default,,0,0,0,,Сиқырлы тізбек бақылаудан шығып, тұйықталу.
Dialogue: 0,0:15:50.65,0:15:53.07,Default,,0,0,0,,Әрине, қарсылас қалпына келе алмайды.
Dialogue: 0,0:15:53.20,0:15:55.62,Default,,0,0,0,,Сиқыршы ретінде де, адам ретінде де.
Dialogue: 0,0:15:56.37,0:15:59.70,Default,,0,0,0,,Бұл баланың ресми киімі, «түпнұсқа оқ»
Dialogue: 0,0:16:00.33,0:16:02.00,Default,,0,0,0,,Барлығы 66 ату
Dialogue: 0,0:16:03.00,0:16:04.75,Default,,0,0,0,,Оны абайлап пайдаланыңыз, солай емес пе?
Dialogue: 0,0:16:08.67,0:16:09.63,Default,,0,0,0,,Гаха
Dialogue: 0,0:16:09.76,0:16:12.09,Default,,0,0,0,,(Кейнет еңіреп)
Dialogue: 0,0:16:14.22,0:16:15.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:17.39,0:16:20.06,Default,,0,0,0,,Ааа! Ах...
Dialogue: 0,0:16:23.39,0:16:26.65,Default,,0,0,0,,Ааааааа...
Dialogue: 0,0:16:51.17,0:16:53.26,Default,,0,0,0,,Енді мен сені осында шашпақтаймын.
Dialogue: 0,0:16:53.38,0:16:56.09,Default,,0,0,0,,Сіз мұның қаншалықты оңай екенін білесіз бе?
Dialogue: 0,0:16:57.05,0:16:58.93,Default,,0,0,0,,Сабер шебері
Dialogue: 0,0:16:59.76,0:17:01.27,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:17:01.81,0:17:03.85,Default,,0,0,0,,Менің қожайыным өлімге жол бермейді
Dialogue: 0,0:17:04.23,0:17:06.40,Default,,0,0,0,,Мен Сабырдың қожасын да өлтірмеймін.
Dialogue: 0,0:17:07.10,0:17:10.90,Default,,0,0,0,,Ол да, мен де істің осылай аяқталғанын қаламаймыз.
Dialogue: 0,0:17:11.36,0:17:12.86,Default,,0,0,0,,Армандарыңды ұмытпа
Dialogue: 0,0:17:13.40,0:17:15.90,Default,,0,0,0,,Осы сәтте сені тірі қалдыратын жалғыз нәрсе
Dialogue: 0,0:17:16.45,0:17:19.28,Default,,0,0,0,,Бұл Рыцарь патшасының адалдығына байланысты болды.
Dialogue: 0,0:17:30.09,0:17:32.00,Default,,0,0,0,,Әйел, маған бір сұрақ қой.
Dialogue: 0,0:17:32.30,0:17:36.68,Default,,0,0,0,,Екеуің Кирицугу Эмиияны қорғау үшін осындасыңдар.
Dialogue: 0,0:17:37.05,0:17:39.68,Default,,0,0,0,,Сіз маған қарсы шыққыңыз келген сияқты...
Dialogue: 0,0:17:42.39,0:17:44.39,Default,,0,0,0,,Бұл кімнің ниеті?
Dialogue: 0,0:17:46.48,0:17:48.23,Default,,0,0,0,,Өйткені команда емлесі жоқ
Dialogue: 0,0:17:48.60,0:17:51.36,Default,,0,0,0,,Сіз Эйнцберннің қожайыны емессіз.
Dialogue: 0,0:17:51.48,0:17:56.03,Default,,0,0,0,,Мүмкін, «ыдыстың қамқоршысы» рөлін алған гомункул
Dialogue: 0,0:17:56.49,0:17:58.11,Default,,0,0,0,,Мұндай адам
Dialogue: 0,0:17:58.20,0:18:02.58,Default,,0,0,0,,Мен шайқастың алдыңғы шебіне бару арқылы қателесуім мүмкін емес.
Dialogue: 0,0:18:02.66,0:18:04.04,Default,,0,0,0,,Ахх...
Dialogue: 0,0:18:04.16,0:18:05.83,Default,,0,0,0,,Мен сенен тағы сұрайын, әйел.
Dialogue: 0,0:18:06.62,0:18:10.17,Default,,0,0,0,,Сен кімнің еркі үшін күрестің?
Dialogue: 0,0:18:14.38,0:18:16.72,Default,,0,0,0,,Ух... ку...
Dialogue: 0,0:18:21.55,0:18:22.68,Default,,0,0,0,,Кирей-сама
Dialogue: 0,0:18:23.72,0:18:26.81,Default,,0,0,0,,Кастер мен Лансер және оның қожайыны да.
Dialogue: 0,0:18:26.89,0:18:29.27,Default,,0,0,0,,Бұл орманнан бәріміз бірге қаштық.
Dialogue: 0,0:18:29.77,0:18:31.73,Default,,0,0,0,,Сабер жақында келеді.
Dialogue: 0,0:18:32.02,0:18:35.19,Default,,0,0,0,,Мырзам, бұл жерде қауіпті.
Dialogue: 0,0:18:36.49,0:18:37.24,Default,,0,0,0,,Хун
Dialogue: 0,0:18:38.20,0:18:38.95,Default,,0,0,0,,Уф
Dialogue: 0,0:18:41.53,0:18:43.41,Default,,0,0,0,,Ннннн!
Dialogue: 0,0:18:44.33,0:18:47.33,Default,,0,0,0,,Мен көремін. Бұл шынымен қызыл ма?
Dialogue: 0,0:18:58.92,0:19:00.93,Default,,0,0,0,,Бұл әйелдер мүмкін емес
Dialogue: 0,0:19:01.22,0:19:03.89,Default,,0,0,0,,Мен ешкімнің нұсқауын алған жоқпын.
Dialogue: 0,0:19:03.97,0:19:06.52,Default,,0,0,0,,Сіз жекпе-жекті өз бетіңізше қабылдадыңыз ба?
Dialogue: 0,0:19:08.64,0:19:09.85,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:10.06,0:19:13.06,Default,,0,0,0,,Кирицугу Эмия менімен бірдей
Dialogue: 0,0:19:13.19,0:19:16.15,Default,,0,0,0,,Оны ешкім түсінбейді де, мойындамайды да.
Dialogue: 0,0:19:16.40,0:19:18.40,Default,,0,0,0,,Ол бос адам болса керек...
Dialogue: 0,0:19:20.99,0:19:22.99,Default,,0,0,0,,Солай болуы керек.
Dialogue: 0,0:19:24.95,0:19:26.03,Default,,0,0,0,,Iris Feel!
Dialogue: 0,0:19:26.83,0:19:27.95,Default,,0,0,0,,Iris Feel!
Dialogue: 0,0:19:28.29,0:19:29.71,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:19:32.75,0:19:34.75,Default,,0,0,0,,Айтыңыз… бар…
Dialogue: 0,0:19:34.84,0:19:37.38,Default,,0,0,0,,Жоқ! Сау болыңыз!
Dialogue: 0,0:19:37.75,0:19:39.59,Default,,0,0,0,,Мен Кирицугуға дәл қазір қоңырау шаламын.
Dialogue: 0,0:19:40.05,0:19:41.76,Default,,0,0,0,,Мен оған дейін бар күшімді саламын!
Dialogue: 0,0:19:42.09,0:19:43.39,Default,,0,0,0,,Кирей —...
Dialogue: 0,0:19:44.39,0:19:47.35,Default,,0,0,0,,Бұл жерде жау қайда?
Dialogue: 0,0:19:47.43,0:19:48.77,Default,,0,0,0,,Мен қашып құтыла алдым
Dialogue: 0,0:19:49.43,0:19:52.14,Default,,0,0,0,,Мен сәл ертерек кірсем ғой.
Dialogue: 0,0:19:52.27,0:19:54.40,Default,,0,0,0,,Бұлай болмаған нәрселер
Dialogue: 0,0:19:55.48,0:19:57.82,Default,,0,0,0,,Майя... бұл...
Dialogue: 0,0:19:57.94,0:19:59.82,Default,,0,0,0,,Ол да ауыр жарақат алды.
Dialogue: 0,0:19:59.94,0:20:01.53,Default,,0,0,0,,Өмірге қауіп төндіретін жарақаттар жоқ.
Dialogue: 0,0:20:02.11,0:20:03.45,Default,,0,0,0,,Сізге көбірек ұнайды!
Dialogue: 0,0:20:03.78,0:20:05.41,Default,,0,0,0,,Осы мөлшердегі қан жоғалтуымен...
Dialogue: 0,0:20:09.62,0:20:10.79,Default,,0,0,0,,Irisviel?
Dialogue: 0,0:20:11.87,0:20:12.79,Default,,0,0,0,,Uhu…
Dialogue: 0,0:20:16.34,0:20:17.59,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:20:19.13,0:20:20.42,Default,,0,0,0,,Бұл «барлық алыс утопия (Авалон)» болып табылады
Dialogue: 0,0:20:20.51,0:20:21.88,Default,,0,0,0,,Айри оны мен үшін ұстайды.
Dialogue: 0,0:20:22.26,0:20:23.18,Default,,0,0,0,,Е...
Dialogue: 0,0:20:23.30,0:20:27.43,Default,,0,0,0,,Бірақ бұл иесінің жарасын емдейтін Асыл Фантазм.
Dialogue: 0,0:20:27.51,0:20:29.22,Default,,0,0,0,,Керісінше, Кирицугу...
Dialogue: 0,0:20:29.43,0:20:30.27,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:30.97,0:20:32.56,Default,,0,0,0,,Сабер, бастапқы иесі,
Dialogue: 0,0:20:32.68,0:20:35.31,Default,,0,0,0,,Сен менің қасымда болып, маған сиқырлы күш бермесең.
Dialogue: 0,0:20:35.69,0:20:37.73,Default,,0,0,0,,Қаптаманың тиімділігі көрсетілмеген.
Dialogue: 0,0:20:38.36,0:20:40.86,Default,,0,0,0,,Сабермен болашақта кім жұмыс істейді?
Dialogue: 0,0:20:40.98,0:20:42.32,Default,,0,0,0,,Өйткені бұл Айри.
Dialogue: 0,0:20:42.65,0:20:44.28,Default,,0,0,0,,Оны алғаныңыз жақсы.
Dialogue: 0,0:20:44.78,0:20:47.45,Default,,0,0,0,,Оны денеңіздің ішіне концептуалды қару ретінде бекітіңіз.
Dialogue: 0,0:20:48.45,0:20:51.45,Default,,0,0,0,,Сондай-ақ, бұл туралы басқа ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:20:52.16,0:20:53.83,Default,,0,0,0,,Әрине Саберге де.
Dialogue: 0,0:20:59.29,0:21:00.84,Default,,0,0,0,,Біз әдетте соншалықты алдын ала брондамаймыз, сондықтан асығыс емесбіз
Dialogue: 0,0:21:01.76,0:21:04.05,Default,,0,0,0,,Маған қол тигізген сәттен бастап
Dialogue: 0,0:21:04.17,0:21:06.18,Default,,0,0,0,,Мен «барлық алыс утопияның (Авалон)» күшін сезіндім.
Dialogue: 0,0:21:07.18,0:21:09.35,Default,,0,0,0,,Рахмет Сабер
Dialogue: 0,0:21:12.98,0:21:14.39,Default,,0,0,0,,Кирей Котомине
Dialogue: 0,0:21:15.39,0:21:17.52,Default,,0,0,0,,Бұл агент қауіпті.
Dialogue: 0,0:21:17.73,0:21:21.40,Default,,0,0,0,,Сіз елестете алатындай, одан да көп.
Dialogue: 0,0:21:22.32,0:21:26.41,Default,,0,0,0,,Бүгін менің жолым болды, бірақ одан әрі не болатынын білмеймін.
Dialogue: 0,0:21:26.86,0:21:28.57,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:21:28.70,0:21:31.87,Default,,0,0,0,,Тек оған Кирицугумен кездесуге мүмкіндік бермеңіз.
Dialogue: 0,0:21:33.79,0:21:34.71,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:35.37,0:21:38.54,Default,,0,0,0,,Кирицугуны қорғайтын жалғыз мен емес.
Dialogue: 0,0:21:39.38,0:21:41.88,Default,,0,0,0,,Солай емес пе? Майя-сан
Dialogue: 0,0:21:43.88,0:21:46.09,Default,,0,0,0,,Келесі жолы мен міндетті түрде жеңемін
Dialogue: 0,0:21:47.55,0:21:50.89,Default,,0,0,0,,Кирицугуны бірге қорғайық.
Dialogue: 0,0:21:56.06,0:22:02.07,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:18.31,0:23:24.31,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.73,0:23:28.90,Default,,0,0,0,,Өйткені, менің қожайыным
Dialogue: 0,0:23:28.99,0:23:30.74,Default,,0,0,0,,Ол өлтірілгелі тұр.
Dialogue: 0,0:23:30.82,0:23:33.12,Default,,0,0,0,,Ұрыста да абырой керек.
Dialogue: 0,0:23:33.24,0:23:35.58,Default,,0,0,0,,Мен бұл ұсынысты қабылдай алмаймын.
Dialogue: 0,0:23:35.66,0:23:37.79,Default,,0,0,0,,Өтінемін, маған осы бұйрықтың сиқырын тапсырыңыз.
Dialogue: 0,0:23:37.87,0:23:41.00,Default,,0,0,0,,Лансердің жолы онша емес.
Dialogue: 0,0:23:42.50,0:23:48.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory