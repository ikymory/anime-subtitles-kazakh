Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.87,0:00:06.04,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:00:09.84,0:00:11.01,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:00:14.26,0:00:16.01,Default,,0,0,0,,Балалар, жазбаларыңызға оралыңыз.
Dialogue: 0,0:00:17.30,0:00:19.81,Default,,0,0,0,,Бұл сынап тамшысына ұқсайды.
Dialogue: 0,0:00:19.93,0:00:22.02,Default,,0,0,0,,Ол тірі сияқты.
Dialogue: 0,0:00:24.94,0:00:25.69,Default,,0,0,0,,Уф
Dialogue: 0,0:00:28.31,0:00:31.44,Default,,0,0,0,,Мен бұл жігітті алып шығуым керек... (Вице-капитан) Не болды?
Dialogue: 0,0:00:31.90,0:00:34.28,Default,,0,0,0,,Бұл жігітті алып шығуымыз керек... Ал ше (вице-капитан)?
Dialogue: 0,0:00:34.49,0:00:37.45,Default,,0,0,0,,Тезірек жүк көлігіне сал!
Dialogue: 0,0:00:38.12,0:00:44.12,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:01.99,0:02:08.00,Default,,0,0,0,,~♪
Dialogue: 0,0:02:08.66,0:02:12.88,Default,,0,0,0,,Қасиетті Граил соғысы қазіргі уақытта ауыр дағдарыста.
Dialogue: 0,0:02:13.38,0:02:17.05,Default,,0,0,0,,Кастер шебері осы күндері Фуюки қаласында дүрбелең туғызуда.
Dialogue: 0,0:02:17.17,0:02:20.59,Default,,0,0,0,,Бірқатар адам ұрлау әрекеттеріне кінәлі болып шықты.
Dialogue: 0,0:02:21.68,0:02:26.35,Default,,0,0,0,,Сондықтан мен өзімнің төтенше жағдайдағы қадағалау өкілеттігімді пайдаланамын.
Dialogue: 0,0:02:26.43,0:02:29.10,Default,,0,0,0,,Уақытша ереже өзгерістерін конфигурациялау
Dialogue: 0,0:02:29.44,0:02:34.11,Default,,0,0,0,,Барлық шеберлер бір-бірінің ұрыс қимылдарын дереу тоқтатады.
Dialogue: 0,0:02:34.23,0:02:37.49,Default,,0,0,0,,Әрқайсыңыз Кастерді жою үшін бар күшіңізді салуыңыз керек.
Dialogue: 0,0:02:37.61,0:02:39.28,Default,,0,0,0,,Және тамаша құюшымен
Dialogue: 0,0:02:39.40,0:02:41.66,Default,,0,0,0,,Қожайыны өлтірген адамға
Dialogue: 0,0:02:41.74,0:02:45.12,Default,,0,0,0,,Арнайы шара ретінде қосымша пәрмендік сиқырларды беріңіз.
Dialogue: 0,0:02:45.91,0:02:49.58,Default,,0,0,0,,Бұл өткен Қасиетті Граил соғысында оқуды тастаған шеберлер.
Dialogue: 0,0:02:49.66,0:02:51.92,Default,,0,0,0,,Бұл пайдаланылмаған пәрмен емлесі.
Dialogue: 0,0:02:52.00,0:02:54.21,Default,,0,0,0,,Сіз үшін бұл белгілер
Dialogue: 0,0:02:54.29,0:02:57.05,Default,,0,0,0,,Оның өте құнды құндылығы болуы керек.
Dialogue: 0,0:02:57.92,0:03:00.80,Default,,0,0,0,,Кастердің жоғалып кеткені расталған бойда.
Dialogue: 0,0:03:00.93,0:03:04.64,Default,,0,0,0,,Қасиетті Граил соғысы тағы бір рет қайта басталады.
Dialogue: 0,0:03:04.93,0:03:09.68,Default,,0,0,0,,Енді қандай да бір сұрақтарыңыз болса, оларды қазірден сұраңыз.
Dialogue: 0,0:03:10.10,0:03:15.02,Default,,0,0,0,,Мен мұны тек адам тілін ең жақсы айта алатындармен ғана шектегім келеді.
Dialogue: 0,0:03:19.11,0:03:20.78,Default,,0,0,0,,Жарайсың фр.
Dialogue: 0,0:03:21.15,0:03:22.49,Default,,0,0,0,,Енді шеберлер
Dialogue: 0,0:03:22.61,0:03:25.12,Default,,0,0,0,,Түлкі аулау сізге ұнайды.
Dialogue: 0,0:03:25.62,0:03:29.04,Default,,0,0,0,,Шіркеуге бес таныс адам жиналды.
Dialogue: 0,0:03:29.41,0:03:30.16,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:03:30.96,0:03:33.63,Default,,0,0,0,,Басқаша айтқанда, оның тірі немесе өлі екені белгісіз болды.
Dialogue: 0,0:03:33.71,0:03:34.79,Default,,0,0,0,,Лорд Эль-Меллои да
Dialogue: 0,0:03:34.92,0:03:36.59,Default,,0,0,0,,Демек, ол тірі.
Dialogue: 0,0:03:36.71,0:03:37.84,Default,,0,0,0,,Шынында да
Dialogue: 0,0:03:38.25,0:03:41.17,Default,,0,0,0,,Ал егер сыйлық әмірлік сиқыр болса,
Dialogue: 0,0:03:41.30,0:03:45.26,Default,,0,0,0,,Лорд Эль-Меллои туралы айтпағанның өзінде, ол қазірдің өзінде инсультті тұтынады.
Dialogue: 0,0:03:45.35,0:03:48.60,Default,,0,0,0,,Басқа шеберлердің де көшуден басқа амалы қалмайды.
Dialogue: 0,0:03:49.02,0:03:51.43,Default,,0,0,0,,Басқалардың қосымша пәрмен емлесін алуына жол бермеу үшін...
Dialogue: 0,0:03:52.02,0:03:55.52,Default,,0,0,0,,Және ол қосымша командалық заклинаниелерді монополиялауы үшін.
Dialogue: 0,0:03:55.65,0:03:59.69,Default,,0,0,0,,Дегенмен, командалық заклинание алған Мастер үшін,
Dialogue: 0,0:03:59.82,0:04:02.45,Default,,0,0,0,,Бұл сізге үлкен артықшылық береді.
Dialogue: 0,0:04:02.65,0:04:04.70,Default,,0,0,0,,Әрине, бұл құптарлық емес.
Dialogue: 0,0:04:05.28,0:04:07.41,Default,,0,0,0,,Бұрышта басқа иттер
Dialogue: 0,0:04:07.49,0:04:10.70,Default,,0,0,0,,Әлсіреген Кастерге соңғы соққы
Dialogue: 0,0:04:11.12,0:04:12.16,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:04:12.87,0:04:15.33,Default,,0,0,0,,Бұл садақшы болуы керек.
Dialogue: 0,0:04:16.75,0:04:18.17,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:04:18.80,0:04:22.17,Default,,0,0,0,,Сізге Маккензидің үйінде бұл дұрыс па?
Dialogue: 0,0:04:22.30,0:04:26.55,Default,,0,0,0,,Хмм, бұл жерде үй иесінің тегі болуы керек.
Dialogue: 0,0:04:26.68,0:04:28.01,Default,,0,0,0,,Ерм
Dialogue: 0,0:04:28.22,0:04:31.68,Default,,0,0,0,,Ескендір патша жаулап алушы осында ма?
Dialogue: 0,0:04:31.77,0:04:33.18,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:04:33.27,0:04:37.23,Default,,0,0,0,,Иә... түсіндім... Ахах...
Dialogue: 0,0:04:37.36,0:04:40.90,Default,,0,0,0,,Ах... оны алу үшін осы жерге қол қойыңыз.
Dialogue: 0,0:04:41.03,0:04:43.36,Default,,0,0,0,,Қол қою дұрыс па?
Dialogue: 0,0:04:46.03,0:04:47.87,Default,,0,0,0,,Мен оны, әрине, алдым.
Dialogue: 0,0:04:48.83,0:04:51.62,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:04:52.29,0:04:54.75,Default,,0,0,0,,Хмм! Ммм! Ммм!
Dialogue: 0,0:04:54.87,0:04:59.09,Default,,0,0,0,,Хахахаха... Мен бүкіл әлем картасын мына кеудеге салғаныма сене алар емеспін.
Dialogue: 0,0:04:59.21,0:05:01.13,Default,,0,0,0,,Хмм, бұл өте керемет.
Dialogue: 0,0:05:01.21,0:05:02.09,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:03.38,0:05:05.47,Default,,0,0,0,,Бұл көріністе не дұрыс емес?
Dialogue: 0,0:05:05.55,0:05:07.26,Default,,0,0,0,,Менің пакетім келді.
Dialogue: 0,0:05:08.05,0:05:09.43,Default,,0,0,0,,Сіз сыртқа шықтыңыз ба?
Dialogue: 0,0:05:09.72,0:05:13.64,Default,,0,0,0,,Джаан, мен пошта арқылы тапсырыс беруді немесе басқа нәрсені қолданып көрдім.
Dialogue: 0,0:05:13.93,0:05:16.73,Default,,0,0,0,,Мен саған екінші қабаттан шықпа дедім!
Dialogue: 0,0:05:16.85,0:05:18.60,Default,,0,0,0,,Үй иесі де қала сыртында.
Dialogue: 0,0:05:18.73,0:05:21.52,Default,,0,0,0,,Егер сізді де таныс адам мазаласа...
Dialogue: 0,0:05:21.61,0:05:23.69,Default,,0,0,0,,Менің оның орнын басудан басқа амалым жоқ деп ойлаймын.
Dialogue: 0,0:05:24.07,0:05:25.53,Default,,0,0,0,,Біздің таңдауымыз жоқ.
Dialogue: 0,0:05:25.61,0:05:28.95,Default,,0,0,0,,Собор шіркеуінен қоңырау ерекше...
Dialogue: 0,0:05:29.20,0:05:30.99,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:05:31.08,0:05:34.75,Default,,0,0,0,,Кеше түнде Саберді көргенде менде де бір ой келді.
Dialogue: 0,0:05:35.41,0:05:38.25,Default,,0,0,0,,Егер сіз заманауи костюмдерді кисеңіз, сіз көзге көрінетін боласыз.
Dialogue: 0,0:05:38.37,0:05:41.09,Default,,0,0,0,,Қалада серуендеуге шықсаңыз, шағымданатын нәрсе бар ма?
Dialogue: 0,0:05:41.42,0:05:43.55,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,0:05:43.63,0:05:45.84,Default,,0,0,0,,Көшеге шықпас бұрын шалбарыңызды шешіңіз!
Dialogue: 0,0:05:46.34,0:05:48.72,Default,,0,0,0,,Иә? Аяқ байлау...
Dialogue: 0,0:05:49.43,0:05:52.76,Default,,0,0,0,,Ойлап қарасам, бұл елде бәрі оны киген.
Dialogue: 0,0:05:53.72,0:05:54.77,Default,,0,0,0,,Бұл қажет пе?
Dialogue: 0,0:05:54.89,0:05:56.43,Default,,0,0,0,,Бұл өте маңызды!
Dialogue: 0,0:05:56.77,0:05:58.44,Default,,0,0,0,,Алдымен мынаны айтайын.
Dialogue: 0,0:05:58.56,0:06:00.94,Default,,0,0,0,,Мен сен үшін қалаға барамын
Dialogue: 0,0:06:01.06,0:06:03.11,Default,,0,0,0,,Мен үлкен шалбар сатып алмаймын.
Dialogue: 0,0:06:03.23,0:06:04.73,Default,,0,0,0,,Мен мұны ешқашан жасамаймын!
Dialogue: 0,0:06:04.82,0:06:05.94,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:06:06.03,0:06:10.16,Default,,0,0,0,,Ұстаз монах, сіз менің үстемдігіме қарсы боласыз ба?
Dialogue: 0,0:06:10.28,0:06:13.70,Default,,0,0,0,,Судо мен сіздің шалбарыңыздың арасында ешқандай байланыс жоқ! Канава шекарасы!
Dialogue: 0,0:06:13.79,0:06:15.70,Default,,0,0,0,,Мүлдем қатысы жоқ!
Dialogue: 0,0:06:15.79,0:06:18.58,Default,,0,0,0,,Бірдеңе жасамас бұрын сыртта жүріңіз.
Dialogue: 0,0:06:18.66,0:06:21.71,Default,,0,0,0,,Тым болмаса жаудың бір қызметшісін жеңуге тырыс!
Dialogue: 0,0:06:21.79,0:06:24.30,Default,,0,0,0,,Сонда мен саған шалбар немесе басқасын сатып аламын!
Dialogue: 0,0:06:24.63,0:06:27.26,Default,,0,0,0,,Көремін, түсінемін.
Dialogue: 0,0:06:27.51,0:06:31.76,Default,,0,0,0,,Маған жаудың дәрежесін көтеру ғана қалды.
Dialogue: 0,0:06:32.01,0:06:34.72,Default,,0,0,0,,Сонымен, сіз шалбар киюге уәде бересіз, солай ма?
Dialogue: 0,0:06:35.31,0:06:36.52,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:37.02,0:06:40.48,Default,,0,0,0,,Сіз шынымен заманауи киіммен шыққыңыз келе ме?
Dialogue: 0,0:06:40.69,0:06:43.31,Default,,0,0,0,,Рыцарлар патшасы мұны жасады.
Dialogue: 0,0:06:43.44,0:06:46.44,Default,,0,0,0,,Патша ретінде мен артта қалуға мүмкіндігім жоқ.
Dialogue: 0,0:06:46.53,0:06:48.69,Default,,0,0,0,,Маған бұл көйлектің үлгісі ұнады.
Dialogue: 0,0:06:48.82,0:06:51.24,Default,,0,0,0,,Жаулап алушының киімі үшін қолайлы
Dialogue: 0,0:06:51.53,0:06:52.78,Default,,0,0,0,,Кастердің тұрған жері
Dialogue: 0,0:06:52.91,0:06:54.95,Default,,0,0,0,,Мен анықтауым керек.
Dialogue: 0,0:06:55.33,0:06:57.16,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:06:58.70,0:07:01.00,Default,,0,0,0,,Энцо тауының негізі Рюдо-джи храмынан шыққан.
Dialogue: 0,0:07:01.12,0:07:03.29,Default,,0,0,0,,Күшті тосқауыл қойылды.
Dialogue: 0,0:07:03.71,0:07:07.00,Default,,0,0,0,,Осыған байланысты жаратылыстан басқа жан-жануарлар қызметшілерді ұнатады
Dialogue: 0,0:07:07.09,0:07:09.34,Default,,0,0,0,,Сіз тек жақындаудан кіре аласыз.
Dialogue: 0,0:07:10.26,0:07:12.51,Default,,0,0,0,,​​Saber қолданбасын пайдаланғанда осыны есте сақтаңыз.
Dialogue: 0,0:07:13.26,0:07:15.85,Default,,0,0,0,,Жердің тамырлары шоғырланған тағы үш негізгі орын бар.
Dialogue: 0,0:07:15.93,0:07:18.14,Default,,0,0,0,,Тохсака резиденциясы және Фуюки шіркеуі және
Dialogue: 0,0:07:18.89,0:07:21.98,Default,,0,0,0,,Бұл қала блогының шығысындағы жаңа тұрғын үй ауданы.
Dialogue: 0,0:07:22.10,0:07:27.11,Default,,0,0,0,,Therefore, the point at which you have enough spiritual power to perform the Holy Grail séance is
Dialogue: 0,0:07:27.23,0:07:30.03,Default,,0,0,0,,Фуюки қаласында 4 орын болады.
Dialogue: 0,0:07:30.49,0:07:31.99,Default,,0,0,0,,Шайқастың екінші жартысы
Dialogue: 0,0:07:32.07,0:07:34.87,Default,,0,0,0,,Бірде қызметшілер саны тарылды
Dialogue: 0,0:07:34.99,0:07:36.62,Default,,0,0,0,,Осылардың кез келгеніне негізделген
Dialogue: 0,0:07:36.70,0:07:38.91,Default,,0,0,0,,Біз оны бақылауда ұстауымыз керек.
Dialogue: 0,0:07:39.20,0:07:40.37,Default,,0,0,0,,Осымен
Dialogue: 0,0:07:40.79,0:07:43.25,Default,,0,0,0,,Regarding the topography, this is what it looks like.
Dialogue: 0,0:07:43.37,0:07:44.42,Default,,0,0,0,,Сұрақтарыңыз бар ма?
Dialogue: 0,0:07:45.42,0:07:47.30,Default,,0,0,0,,Сіз түсінбейтін нәрсе бар ма?
Dialogue: 0,0:07:47.38,0:07:51.38,Default,,0,0,0,,Бұл жеткілікті жақсы түсініктеме болды, әсіресе...
Dialogue: 0,0:07:52.63,0:07:54.47,Default,,0,0,0,,Кирицугу және басқа да шеберлер
Dialogue: 0,0:07:54.55,0:07:57.22,Default,,0,0,0,,Барлығы Кастерге ұмтылады деп болжауға бола ма?
Dialogue: 0,0:07:57.31,0:07:59.06,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:07:59.60,0:08:03.14,Default,,0,0,0,,Бірақ дөңгелектерге келетін болсақ, бізде артықшылық бар.
Dialogue: 0,0:08:03.60,0:08:06.56,Default,,0,0,0,,Сабер мен Джоан д-Арк, сіз не туралы шатастырдыңыз?
Dialogue: 0,0:08:06.65,0:08:09.03,Default,,0,0,0,,Өйткені сен қате түсініп, мені аңдып жүрсің.
Dialogue: 0,0:08:09.11,0:08:10.40,Default,,0,0,0,,Бұл жігіт ыңғайлы.
Dialogue: 0,0:08:10.86,0:08:12.95,Default,,0,0,0,,Бізге күту ғана қалды
Dialogue: 0,0:08:13.61,0:08:15.99,Default,,0,0,0,,Ұстаз Бұл жеткіліксіз
Dialogue: 0,0:08:16.07,0:08:17.95,Default,,0,0,0,,Оның қателігі қабылданбайды.
Dialogue: 0,0:08:18.08,0:08:21.66,Default,,0,0,0,,Зақым бұдан әрі тарамай тұрып оларға шабуыл жасауымыз керек.
Dialogue: 0,0:08:25.63,0:08:26.75,Default,,0,0,0,,Айри
Dialogue: 0,0:08:26.88,0:08:29.63,Default,,0,0,0,,Осы орман тосқауылының сиқырлы формуласын әлі анықтадыңыз ба?
Dialogue: 0,0:08:29.75,0:08:31.13,Default,,0,0,0,,Иә, бәрібір.
Dialogue: 0,0:08:31.67,0:08:35.09,Default,,0,0,0,,Ең үлкен мәселе - Сабердің сол қолындағы қарғыс.
Dialogue: 0,0:08:36.09,0:08:39.76,Default,,0,0,0,,Кейнетті өлтіргеніңізге 18 сағат болды.
Dialogue: 0,0:08:40.26,0:08:43.60,Default,,0,0,0,,Сабердің қолы әлі толық жазылмаған.
Dialogue: 0,0:08:44.35,0:08:46.48,Default,,0,0,0,,Лансер әлі тірі және жақсы.
Dialogue: 0,0:08:47.15,0:08:49.94,Default,,0,0,0,,Кастерді ең жақсы жолмен ұстап алу үшін
Dialogue: 0,0:08:50.02,0:08:52.11,Default,,0,0,0,,Алдымен Лансерді жеңуіміз керек емес пе?
Dialogue: 0,0:08:52.40,0:08:53.95,Default,,0,0,0,,Бұл оған жақындамайды.
Dialogue: 0,0:08:54.61,0:08:58.03,Default,,0,0,0,,Географиялық артықшылығыңызды барынша пайдаланыңыз және Саберге қашуға мүмкіндік беріңіз.
Dialogue: 0,0:08:58.12,0:09:00.37,Default,,0,0,0,,Тек жауды шатастыр.
Dialogue: 0,0:09:01.91,0:09:03.58,Default,,0,0,0,,Неге оған Кастермен жекпе-жекке жол бермеске?
Dialogue: 0,0:09:04.16,0:09:07.12,Default,,0,0,0,,Кастерді жалғыз қалдырсаңыз да, оны біреу өлтіреді.
Dialogue: 0,0:09:07.25,0:09:10.29,Default,,0,0,0,,Керісінше, Кастерді қанды көзбен қуып келе жатқан адамдар.
Dialogue: 0,0:09:10.38,0:09:11.71,Default,,0,0,0,,Бұл жақсы олжа.
Dialogue: 0,0:09:13.09,0:09:15.72,Default,,0,0,0,,Мен оларға бүйірден шабуыл жасап, соқтым.
Dialogue: 0,0:09:16.30,0:09:18.72,Default,,0,0,0,,Ұстаз, сіз кімсіз?
Dialogue: 0,0:09:19.18,0:09:22.01,Default,,0,0,0,,Сіз қаншалықты жексұрын болуға дайынсыз?
Dialogue: 0,0:09:22.14,0:09:23.89,Default,,0,0,0,,Батыр рухтарды қорлайсың.
Dialogue: 0,0:09:24.14,0:09:26.60,Default,,0,0,0,,Неге соғысты маған қалдырмайсың?
Dialogue: 0,0:09:26.69,0:09:29.31,Default,,0,0,0,,Сен менің өз құлымсың.
Dialogue: 0,0:09:29.40,0:09:31.15,Default,,0,0,0,,Маған сене алмаймын дейсіз бе?
Dialogue: 0,0:09:32.82,0:09:35.15,Default,,0,0,0,,Кастерден басқалардың бәрімен бітім болуы керек, солай ма?
Dialogue: 0,0:09:35.74,0:09:36.82,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:09:37.57,0:09:40.20,Default,,0,0,0,,​​Мен бұл жолы режиссерге шынымен сене алмаймын.
Dialogue: 0,0:09:40.70,0:09:42.29,Default,,0,0,0,,Бейкүнә жүзбен
Dialogue: 0,0:09:42.37,0:09:44.83,Default,,0,0,0,,Ол өлтіруші шеберді жасырып жатыр.
Dialogue: 0,0:09:45.37,0:09:47.21,Default,,0,0,0,,Тохсака гуру болуы мүмкін
Dialogue: 0,0:09:47.83,0:09:49.92,Default,,0,0,0,,Күдікті болған дұрыс.
Dialogue: 0,0:09:50.75,0:09:52.88,Default,,0,0,0,,Олай болса, тарайық.
Dialogue: 0,0:09:58.84,0:09:59.80,Default,,0,0,0,,Кирицугу…
Dialogue: 0,0:10:03.72,0:10:04.81,Default,,0,0,0,,Мен, Ишикава және…
Dialogue: 0,0:10:06.56,0:10:07.52,Default,,0,0,0,,Егер мен...
Dialogue: 0,0:10:08.19,0:10:12.02,Default,,0,0,0,,Егер мен бәрін тастап, қашуды шешсем ше?
Dialogue: 0,0:10:12.86,0:10:15.86,Default,,0,0,0,,Айри, менімен келесің бе?
Dialogue: 0,0:10:17.11,0:10:20.74,Default,,0,0,0,,Илья... Ол қызды сарайда не істейсің?
Dialogue: 0,0:10:21.24,0:10:24.54,Default,,0,0,0,,Артқа қайтып, оларды шығарып алыңыз. Сіздің жолыңызға түскен кез келген адамды өлтіріңіз.
Dialogue: 0,0:10:24.66,0:10:26.08,Default,,0,0,0,,Содан бастап...
Dialogue: 0,0:10:27.25,0:10:31.08,Default,,0,0,0,,Мен бәрін Ілияс екеуің үшін жұмсаймын
Dialogue: 0,0:10:32.79,0:10:34.59,Default,,0,0,0,,Сіз қашып құтыла аласыз ба? біз...
Dialogue: 0,0:10:34.71,0:10:37.21,Default,,0,0,0,,Сіз қашып құтыла аласыз! Қазір емес!
Dialogue: 0,0:10:39.01,0:10:41.89,Default,,0,0,0,,Бұл өтірік... Бұл өтірік
Dialogue: 0,0:10:43.89,0:10:45.97,Default,,0,0,0,,Ешқашан қашып құтыла алмайсың
Dialogue: 0,0:10:46.43,0:10:50.60,Default,,0,0,0,,Қасиетті тасты лақтырып тастаған мен, әлемді құтқара алмаған мен
Dialogue: 0,0:10:51.31,0:10:53.02,Default,,0,0,0,,Сіз ешқашан кешіре алмайсыз
Dialogue: 0,0:10:53.90,0:10:58.03,Default,,0,0,0,,Әрине, сен бірінші және соңғы үкім шығарушысың.
Dialogue: 0,0:10:58.82,0:11:01.32,Default,,0,0,0,,Кирицугу Эмиияны өлтіреді...
Dialogue: 0,0:11:03.32,0:11:04.41,Default,,0,0,0,,Міне, алма мен жаңғақ қосылған карамельді вафлилер.
Dialogue: 0,0:11:06.24,0:11:10.25,Default,,0,0,0,,Ол жігіт... Кирей Котомине мені нысанаға алып отыр.
Dialogue: 0,0:11:10.92,0:11:12.12,Default,,0,0,0,,Мен Майядан сұрадым
Dialogue: 0,0:11:12.71,0:11:15.67,Default,,0,0,0,,Ол мені Кайнетпен ұрып-соқты.
Dialogue: 0,0:11:16.00,0:11:17.59,Default,,0,0,0,,Менің әрекеттерім оқылды.
Dialogue: 0,0:11:18.88,0:11:21.05,Default,,0,0,0,,Мен сені соғысу үшін құрбан етемін
Dialogue: 0,0:11:21.13,0:11:23.09,Default,,0,0,0,,Илья артта қалса да
Dialogue: 0,0:11:23.84,0:11:26.81,Default,,0,0,0,,Ең қауіптісі маған көз тігіп қойған.
Dialogue: 0,0:11:27.60,0:11:29.89,Default,,0,0,0,,Мен ешқашан кездескім келмейтін жігіт!
Dialogue: 0,0:11:32.65,0:11:35.11,Default,,0,0,0,,Мен сенің жалғыз соғысуға рұқсат бермеймін
Dialogue: 0,0:11:35.65,0:11:38.78,Default,,0,0,0,,Мен қорғаймын Сабер қорғайды
Dialogue: 0,0:11:38.86,0:11:41.95,Default,,0,0,0,,Және... Майя да бар.
Dialogue: 0,0:11:44.74,0:11:45.62,Default,,0,0,0,,Ha
Dialogue: 0,0:11:46.12,0:11:46.99,Default,,0,0,0,,Кирицугу
Dialogue: 0,0:11:48.95,0:11:50.04,Default,,0,0,0,,Жаудың шабуылы...
Dialogue: 0,0:11:51.37,0:11:53.33,Default,,0,0,0,,Маған бұл оқиға Майя кеткенге дейін болды.
Dialogue: 0,0:11:54.25,0:11:56.46,Default,,0,0,0,,Енді біз барлық күшімізбен тосқауыл қоя аламыз.
Dialogue: 0,0:11:59.38,0:12:02.80,Default,,0,0,0,,Айри, алысты көретін хрусталь шар дайында.
Dialogue: 0,0:12:09.43,0:12:10.22,Default,,0,0,0,,Мен сонда болдым
Dialogue: 0,0:12:11.56,0:12:14.56,Default,,0,0,0,,Irisviel Жау сізді шақырып жатыр.
Dialogue: 0,0:12:14.98,0:12:17.73,Default,,0,0,0,,Кепіл... Менің ойымша... Мен сенімдімін...
Dialogue: 0,0:12:18.19,0:12:21.03,Default,,0,0,0,,Менің жеке барып, оны құтқарудан басқа амалым жоқ.
Dialogue: 0,0:12:24.78,0:12:26.82,Default,,0,0,0,,Ха, көріпкелдік ашылды!?
Dialogue: 0,0:12:26.95,0:12:29.33,Default,,0,0,0,,Кеше түнде уәде етілгендей
Dialogue: 0,0:12:29.45,0:12:32.75,Default,,0,0,0,,Жиль де Раис
Dialogue: 0,0:12:33.16,0:12:38.67,Default,,0,0,0,,Мен сұлу киелі пәк қызым Жаннадан мені тағы бір рет көруін өтінгім келеді.
Dialogue: 0,0:12:39.00,0:12:39.80,Default,,0,0,0,,Iris Feel!
Dialogue: 0,0:12:40.42,0:12:42.67,Default,,0,0,0,,Олай болса, араша болуды өтінемін.
Dialogue: 0,0:12:42.80,0:12:45.26,Default,,0,0,0,,Мен де сені сабырмен күтуге ниет еттім.
Dialogue: 0,0:12:45.38,0:12:48.47,Default,,0,0,0,,Мен біраз дайындық жасадым.
Dialogue: 0,0:12:48.55,0:12:49.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:50.14,0:12:53.77,Default,,0,0,0,,Кәне, балалар, тег ойнауды бастайық.
Dialogue: 0,0:12:53.89,0:12:57.31,Default,,0,0,0,,Ережелер қарапайым: тек менен қашыңыз.
Dialogue: 0,0:12:57.40,0:12:59.06,Default,,0,0,0,,Әйтпесе... (Бала) Әй!
Dialogue: 0,0:12:59.19,0:13:00.32,Default,,0,0,0,,Уау! (Сабыр) Тоқта!
Dialogue: 0,0:13:00.65,0:13:02.86,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:13:05.28,0:13:06.20,Default,,0,0,0,,(Балалардың айқайы)
Dialogue: 0,0:13:06.32,0:13:07.45,Default,,0,0,0,,Енді қаш.
Dialogue: 0,0:13:07.53,0:13:09.91,Default,,0,0,0,,100-ге дейін санасаң, мен сені қуамын.
Dialogue: 0,0:13:10.03,0:13:11.37,Default,,0,0,0,,Сәлем Жанна
Dialogue: 0,0:13:11.45,0:13:15.54,Default,,0,0,0,,Олардың барлығын ұстауым үшін қанша уақыт қажет?
Dialogue: 0,0:13:20.09,0:13:21.96,Default,,0,0,0,,Сабер Кастерді жеңіңіз!
Dialogue: 0,0:13:22.46,0:13:23.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:29.26,0:13:30.01,Default,,0,0,0,,Ах
Dialogue: 0,0:13:47.57,0:13:49.78,Default,,0,0,0,,Жанна қош келдіңіз
Dialogue: 0,0:13:50.49,0:13:55.29,Default,,0,0,0,,Бұл қайғылы оқиғаға қалай қарайсыз? Ауыртпайды ма?
Dialogue: 0,0:13:57.79,0:14:00.21,Default,,0,0,0,,Мені жек көресің бе?
Dialogue: 0,0:14:00.58,0:14:03.09,Default,,0,0,0,,Иә, сен мені жек көретін шығарсың.
Dialogue: 0,0:14:03.84,0:14:07.72,Default,,0,0,0,,Құдайдың сүйіспеншілігіне мойынсұнбағанымды ешқашан кешіре алмайсың.
Dialogue: 0,0:14:08.05,0:14:10.43,Default,,0,0,0,,Сол баланы жібер, Гедо!
Dialogue: 0,0:14:11.18,0:14:12.43,Default,,0,0,0,,Жанна
Dialogue: 0,0:14:12.51,0:14:15.85,Default,,0,0,0,,Осы баланың өмірін шынымен қаласаңыз
Dialogue: 0,0:14:16.43,0:14:19.85,Default,,0,0,0,,Кел, балам, бақытты бол.
Dialogue: 0,0:14:20.27,0:14:22.11,Default,,0,0,0,,Алланың тақуа елшісі
Dialogue: 0,0:14:22.23,0:14:24.78,Default,,0,0,0,,Ол саған көмектесемін дейді.
Dialogue: 0,0:14:24.86,0:14:28.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:28.40,0:14:30.07,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:14:30.16,0:14:33.95,Default,,0,0,0,,Бұл жерде қауіпті. Енді тез қаш.
Dialogue: 0,0:14:34.45,0:14:37.12,Default,,0,0,0,,Жалғассаң, үлкен қамалға келесің.
Dialogue: 0,0:14:37.20,0:14:38.21,Default,,0,0,0,,(Джозеф) Бір, екі. (Абдул) Бір, екі.
Dialogue: 0,0:14:49.30,0:14:50.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:53.43,0:14:56.18,Default,,0,0,0,,Мен саған айттым деп ойладым ба?
Dialogue: 0,0:14:56.85,0:15:00.85,Default,,0,0,0,,Келесі кездескенімізде, соған сәйкес дайындаламын...
Dialogue: 0,0:15:01.31,0:15:03.48,Default,,0,0,0,,Ку... Жарайды.
Dialogue: 0,0:15:03.61,0:15:07.44,Default,,0,0,0,,Мен енді Қасиетті Граил үшін сенімен бәсекеге түскім келмейді!
Dialogue: 0,0:15:16.41,0:15:18.16,Default,,0,0,0,,О... Жанна...
Dialogue: 0,0:15:18.25,0:15:20.87,Default,,0,0,0,,Қандай асыл және батыл...
Dialogue: 0,0:15:21.00,0:15:24.92,Default,,0,0,0,,Уа, киелі қыз, сенің алдыңда Құдайдың өзі бұлыңғыр!
Dialogue: 0,0:15:25.00,0:15:26.21,Default,,0,0,0,,Кастер!
Dialogue: 0,0:15:26.34,0:15:29.84,Default,,0,0,0,,Мен сені құрту үшін семсер аламын!
Dialogue: 0,0:15:29.92,0:15:30.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:33.55,0:15:34.55,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:47.40,0:15:48.19,Default,,0,0,0,,Ах
Dialogue: 0,0:15:50.95,0:15:52.70,Default,,0,0,0,,Сол қолымды қолдана алсам...
Dialogue: 0,0:15:53.78,0:15:56.78,Default,,0,0,0,,Тіпті Кастердің сиқырлы күші шексіз емес.
Dialogue: 0,0:15:57.53,0:16:02.21,Default,,0,0,0,,Егер ол таусылғанша шыдаса, Сабердің жеңу мүмкіндігі бар.
Dialogue: 0,0:16:02.50,0:16:03.25,Default,,0,0,0,,Кирицугу
Dialogue: 0,0:16:03.71,0:16:04.88,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:16:04.96,0:16:08.05,Default,,0,0,0,,Басқа шеберлердің орманға кіруіне реакция болды ма?
Dialogue: 0,0:16:08.71,0:16:12.17,Default,,0,0,0,,Майя, Айриді алып, қамалдан қаш.
Dialogue: 0,0:16:12.93,0:16:15.39,Default,,0,0,0,,Саберден және басқалардан қарама-қарсы бағытта
Dialogue: 0,0:16:16.30,0:16:18.06,Default,,0,0,0,,Мұнда қалу дұрыс па?
Dialogue: 0,0:16:18.43,0:16:20.72,Default,,0,0,0,,Сабер алыс жерде соғысып жатқандықтан
Dialogue: 0,0:16:20.81,0:16:21.98,Default,,0,0,0,,Қауіпсіз
Dialogue: 0,0:16:22.35,0:16:26.23,Default,,0,0,0,,Мен сияқты басқалар да бар екеніне сенімдімін.
Dialogue: 0,0:16:28.36,0:16:29.57,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:16:29.90,0:16:31.69,Default,,0,0,0,,Ха...
Dialogue: 0,0:16:32.24,0:16:33.74,Default,,0,0,0,,Не болды Айри...
Dialogue: 0,0:16:35.11,0:16:37.66,Default,,0,0,0,,Жаңа жігіт келген сияқты.
Dialogue: 0,0:16:38.08,0:16:39.03,Default,,0,0,0,,Хамф!
Dialogue: 0,0:16:39.99,0:16:41.79,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:16:42.25,0:16:45.67,Default,,0,0,0,,Неліктен? Оның сиқырлы күші түбі жоқ дейсіз бе?
Dialogue: 0,0:16:45.75,0:16:46.88,Default,,0,0,0,,Хехе...
Dialogue: 0,0:16:46.96,0:16:49.84,Default,,0,0,0,,Әйтеуір... Оның сиқырлы күшінің қайнар көзі...
Dialogue: 0,0:16:50.75,0:16:52.84,Default,,0,0,0,,Бұл кітап сіздің асыл фантастикаңыз ба?
Dialogue: 0,0:16:52.97,0:16:54.09,Default,,0,0,0,,Иә
Dialogue: 0,0:16:54.22,0:16:57.47,Default,,0,0,0,,Менің одақтасым Прерати қалдырған сиқырлы кітаппен ант етемін.
Dialogue: 0,0:16:57.59,0:17:01.77,Default,,0,0,0,,Мен шайтанның әскерін бағындыруды үйрендім.
Dialogue: 0,0:17:01.85,0:17:03.56,Default,,0,0,0,,Сізге қалай ұнайды, Жанна?
Dialogue: 0,0:17:03.89,0:17:08.27,Default,,0,0,0,,Бұл ностальгия, Жанна. Бәрі бұрынғыдай.
Dialogue: 0,0:17:08.35,0:17:11.15,Default,,0,0,0,,Сол асыл жауынгерлік рух, Асыл жан қандай.
Dialogue: 0,0:17:11.28,0:17:14.36,Default,,0,0,0,,Джоан-д-Арк екеніңіздің айнымас дәлелі
Dialogue: 0,0:17:14.86,0:17:16.61,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:16.70,0:17:18.99,Default,,0,0,0,,Неге оянбайсың?
Dialogue: 0,0:17:19.12,0:17:21.79,Default,,0,0,0,,Сіз әлі де Құдайдың қорғауына сенесіз бе?
Dialogue: 0,0:17:22.70,0:17:26.37,Default,,0,0,0,,Бұл қиын жағдайда да сізді ғажайып құтқарады ма?
Dialogue: 0,0:17:26.71,0:17:28.29,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:17:28.42,0:17:30.50,Default,,0,0,0,,Компьен шайқасын ұмыттыңыз ба?
Dialogue: 0,0:17:30.96,0:17:33.17,Default,,0,0,0,,Осыншама қорлық көргеннен кейін де,
Dialogue: 0,0:17:33.30,0:17:36.63,Default,,0,0,0,,Құдайдың қуыршағы болғаныңызға ризасыз ба?
Dialogue: 0,0:17:37.34,0:17:38.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:38.59,0:17:39.34,Default,,0,0,0,,Уф
Dialogue: 0,0:17:41.89,0:17:42.72,Default,,0,0,0,,Уау
Dialogue: 0,0:17:48.81,0:17:50.48,Default,,0,0,0,,Ух... ой...
Dialogue: 0,0:17:53.15,0:17:54.49,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:17:54.69,0:17:56.15,Default,,0,0,0,,Сабер тітіркендіргіш
Dialogue: 0,0:17:56.57,0:17:59.74,Default,,0,0,0,,Қылыш тартымдырақ болмаса, Рыцарлар патшасының есімі жойылады.
Dialogue: 0,0:18:01.66,0:18:03.33,Default,,0,0,0,,Қайсысы қоқыс екенін айтып бере аласыз ба?
Dialogue: 0,0:18:03.45,0:18:06.66,Default,,0,0,0,,Менің жолыма кімнің кешірімімен кедергі боласың?
Dialogue: 0,0:18:07.04,0:18:09.33,Default,,0,0,0,,Міне осы жол. Гедо!
Dialogue: 0,0:18:10.04,0:18:12.92,Default,,0,0,0,,Сабырдың бас дәрежесі - найзамның абыройы.
Dialogue: 0,0:18:13.05,0:18:16.80,Default,,0,0,0,,Қуа~! Менің дұғам! менің қасиетті дәретім
Dialogue: 0,0:18:16.92,0:18:19.13,Default,,0,0,0,,Ол әйелді тірілтті!
Dialogue: 0,0:18:19.38,0:18:21.35,Default,,0,0,0,,Ол менікі
Dialogue: 0,0:18:21.47,0:18:25.93,Default,,0,0,0,,Кез келген еттен тамшы қанға дейін, оның жаны да менікі!
Dialogue: 0,0:18:26.43,0:18:29.06,Default,,0,0,0,,Эй, Кастер, бұл мен емеспін.
Dialogue: 0,0:18:29.19,0:18:31.69,Default,,0,0,0,,Мен сенің махаббат сапарыңа араласпаймын.
Dialogue: 0,0:18:32.02,0:18:35.32,Default,,0,0,0,,Сабырды өзіне бағындырып, не болса да алып кеткің келсе.
Dialogue: 0,0:18:35.40,0:18:37.78,Default,,0,0,0,,Байқап көріңіз, бірақ...
Dialogue: 0,0:18:38.28,0:18:40.16,Default,,0,0,0,,Бұл Диармуидті артта қалдырыңыз.
Dialogue: 0,0:18:40.24,0:18:41.53,Default,,0,0,0,,Бір ғана қолы бар қылыш
Dialogue: 0,0:18:41.66,0:18:43.78,Default,,0,0,0,,Менің қолымнан келетін жалғыз нәрсе - оны жою.
Dialogue: 0,0:18:43.87,0:18:45.20,Default,,0,0,0,,Кешірімсіз!
Dialogue: 0,0:18:45.33,0:18:46.12,Default,,0,0,0,,Ununu...
Dialogue: 0,0:18:46.37,0:18:48.12,Default,,0,0,0,,Lancer Сіз...
Dialogue: 0,0:18:48.71,0:18:50.37,Default,,0,0,0,,Мені қате түсінбе, Сабер.
Dialogue: 0,0:18:50.96,0:18:55.21,Default,,0,0,0,,Бүгін маған тек Кастерді жеңу туралы бұйрық берілді.
Dialogue: 0,0:18:55.67,0:19:00.18,Default,,0,0,0,,Олай болса, менің ойымша, бұл жерде бірге күрескен дұрыс, бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:19:03.55,0:19:05.06,Default,,0,0,0,,Түсінікті болу үшін, Лансер
Dialogue: 0,0:19:05.81,0:19:07.56,Default,,0,0,0,,Мен болсам, сол қолымды ғана қолданар едім.
Dialogue: 0,0:19:07.68,0:19:09.31,Default,,0,0,0,,Мен ол бейбақтарды 100 рет талқандаймын.
Dialogue: 0,0:19:09.73,0:19:12.81,Default,,0,0,0,,Хмф... Егер солай болса, онда ерекше ештеңе жоқ.
Dialogue: 0,0:19:15.07,0:19:17.44,Default,,0,0,0,,Уннуну... Мен кешірмеймін...
Dialogue: 0,0:19:17.57,0:19:19.90,Default,,0,0,0,,Тәкаппарланба, бейбақ!
Dialogue: 0,0:19:22.95,0:19:25.70,Default,,0,0,0,,Қызу, мейірімсіз
Dialogue: 0,0:19:34.25,0:19:36.59,Default,,0,0,0,,Арчибальдтар отбасының 9-шы басшысы
Dialogue: 0,0:19:36.67,0:19:39.26,Default,,0,0,0,,Кейнет Эль-Меллои осында ұсталды.
Dialogue: 0,0:19:39.34,0:19:41.05,Default,,0,0,0,,Эйнцберн сиқыршысы
Dialogue: 0,0:19:41.13,0:19:45.93,Default,,0,0,0,,Сіз іздеген Қасиетті Граил үшін өміріңіз бен мақтанышыңызға бәс тігіңіз және осында болыңыз!
Dialogue: 0,0:20:17.25,0:20:19.46,Default,,0,0,0,,Қулыққа сүйену деген не?
Dialogue: 0,0:20:19.96,0:20:22.34,Default,,0,0,0,,Эйнцберн осыншама жерге құлады ма?
Dialogue: 0,0:20:22.80,0:20:26.72,Default,,0,0,0,,Егер сіз келісесіз, онда бұл дуэль емес, өлтіру.
Dialogue: 0,0:20:36.81,0:20:40.03,Default,,0,0,0,,Түсінемін, жауды автоматты іздеу...
Dialogue: 0,0:20:40.44,0:20:41.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:47.53,0:20:49.66,Default,,0,0,0,,Мен таптым, тышқан!
Dialogue: 0,0:20:54.71,0:20:55.75,Default,,0,0,0,,Бас терісі!
Dialogue: 0,0:20:57.58,0:20:59.92,Default,,0,0,0,,Уақытты өзгерту－екі есе жылдамдату!
Dialogue: 0,0:21:05.59,0:21:06.39,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:07.05,0:21:11.18,Default,,0,0,0,,Өз денеңізді ерекше тосқауыл ретінде пайдаланыңыз.
Dialogue: 0,0:21:11.31,0:21:14.39,Default,,0,0,0,,Бұл уақытты манипуляциялау және оны жеделдету сияқты ...
Dialogue: 0,0:21:15.02,0:21:17.85,Default,,0,0,0,,Менің ойымша, сізде сиқыр туралы біраз біліміңіз бар.
Dialogue: 0,0:21:18.31,0:21:21.19,Default,,0,0,0,,Мен сиқырлы сиқыр алсам да,
Dialogue: 0,0:21:21.28,0:21:24.49,Default,,0,0,0,,Арзан қулыққа сенетін ақымақ.
Dialogue: 0,0:21:24.61,0:21:27.16,Default,,0,0,0,,Не істеп жатқаныңды өлгенде білесің.
Dialogue: 0,0:21:29.53,0:21:30.99,Default,,0,0,0,,ренжіме:sanctio!
Dialogue: 0,0:21:33.91,0:21:35.96,Default,,0,0,0,,Дене уақытын басқаруға келгенде
Dialogue: 0,0:21:36.08,0:21:38.88,Default,,0,0,0,,Денеге түсетін жүктеме де айтарлықтай болуы керек.
Dialogue: 0,0:21:42.21,0:21:43.88,Default,,0,0,0,,Сіз оны таптыңыз ба?
Dialogue: 0,0:21:44.13,0:21:48.59,Default,,0,0,0,,Енді мен бұл денемен қаншалықты қашып құтыла аламын деп ойлаймын... хехе...
Dialogue: 0,0:21:52.26,0:21:55.18,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:21:58.02,0:22:00.52,Default,,0,0,0,,Уақыт өзгереді-үш есе тоқырау
Dialogue: 0,0:22:07.95,0:22:10.41,Default,,0,0,0,,Бұл жігіт көрмейді.
Dialogue: 0,0:22:10.99,0:22:13.79,Default,,0,0,0,,Ішкі дене уақытын үштен біріне баяулатыңыз
Dialogue: 0,0:22:13.91,0:22:17.50,Default,,0,0,0,,Жүрек соғу дыбыстары мен тыныс алу дыбыстарын шекке дейін бассаңыз...
Dialogue: 0,0:22:18.75,0:22:20.17,Default,,0,0,0,,Мақсатты сезіну мүмкін емес
Dialogue: 0,0:22:33.76,0:22:34.93,Default,,0,0,0,,Кейнс! Не!
Dialogue: 0,0:22:37.64,0:22:39.77,Default,,0,0,0,,Ақымақтар бекер күресіп жатырсыңдар!
Dialogue: 0,0:22:45.73,0:22:46.49,Default,,0,0,0,,Иә
Dialogue: 0,0:22:49.57,0:22:55.58,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:24:11.86,0:24:17.87,Default,,0,0,0,,~♪
Dialogue: 0,0:24:20.62,0:24:21.75,Default,,0,0,0,,Майя-сан, жоқ!
Dialogue: 0,0:24:21.87,0:24:24.04,Default,,0,0,0,,Сиқыршының беті масқара...
Dialogue: 0,0:24:24.12,0:24:26.88,Default,,0,0,0,,Қорық, үміт үз!
Dialogue: 0,0:24:26.96,0:24:28.96,Default,,0,0,0,,Гуге! Жын қызыл раушан (гей жаргу)!
Dialogue: 0,0:24:29.05,0:24:32.05,Default,,0,0,0,,Кімнің еркі үшін күрестіңіз?
Dialogue: 0,0:24:32.13,0:24:34.38,Default,,0,0,0,,Дайын бол, Гедо.
Dialogue: 0,0:24:35.88,0:24:41.88,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory