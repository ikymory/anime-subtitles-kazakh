Dialogue: 0,0:21:45.74,0:21:50.41,ED - EngLyrics,,0,0,0,,Күнделікті сөйлескенде де
Dialogue: 0,0:21:50.16,0:21:55.00,ED - EngLyrics,,0,0,0,,үзіледі,
Dialogue: 0,0:21:54.75,0:21:59.46,ED - EngLyrics,,0,0,0,,маған керегі - сен жанымда,
Dialogue: 0,0:21:59.21,0:22:02.80,ED - EngLyrics,,0,0,0,,сондықтан мен өзімді қауіпсіз және сау сезінемін.
Dialogue: 0,0:22:03.92,0:22:08.55,ED - EngLyrics,,0,0,0,,Сенің мейірімді жүзің
Dialogue: 0,0:22:08.30,0:22:12.64,ED - EngLyrics,,0,0,0,,жай ғана жел сияқты.
Dialogue: 0,0:22:12.39,0:22:16.89,ED - EngLyrics,,0,0,0,,Біз бір-біріміздің қолымызды мықтап ұстаймыз,
Dialogue: 0,0:22:16.64,0:22:21.86,ED - EngLyrics,,0,0,0,,және сол таулы жолмен бірге жүгіріңіз.
Dialogue: 0,0:22:21.61,0:22:25.86,ED - EngLyrics,,0,0,0,,Ертең тағы бір қуанышты күн болары сөзсіз.
Dialogue: 0,0:22:25.61,0:22:30.83,ED - EngLyrics,,0,0,0,,Ендеше иық тіресіп жүрейік.
Dialogue: 0,0:22:30.57,0:22:34.91,ED - EngLyrics,,0,0,0,,Мен сол ағып жатқан желді мықтап ұстаймын,
Dialogue: 0,0:22:34.66,0:22:39.63,ED - EngLyrics,,0,0,0,,қолымды жайып саған беру үшін.
Dialogue: 0,0:22:39.38,0:22:43.80,ED - EngLyrics,,0,0,0,,Біз ертең және одан кейінгі күні бір-біріміздің қолымызды қатты ұстаймыз.
Dialogue: 0,0:22:43.55,0:22:50.89,ED - EngLyrics,,0,0,0,,Иық тіресіп, алға бірге жүрейік.
