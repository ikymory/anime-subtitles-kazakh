Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.56,0:00:09.44,Default,,0,0,0,,Кио Чан қазірдің өзінде үлкен әпке.
Dialogue: 0,0:00:10.57,0:00:11.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:13.49,0:00:16.62,Default,,0,0,0,,Мен сенің әпкеңмін, түсіндің бе?
Dialogue: 0,0:00:17.24,0:00:18.95,Default,,0,0,0,,Сіз мені ести алатыныңызға сенімдімін.
Dialogue: 0,0:00:21.87,0:00:27.79,Simai's OS,,0,0,0,,Сол күндер... анам бар, әкем мейірімді болған күндер.
Dialogue: 0,0:00:28.92,0:00:30.51,Default,,0,0,0,,Эй... Кио Чан
Dialogue: 0,0:00:31.38,0:00:32.34,Default,,0,0,0,,Не?
Dialogue: 0,0:00:32.72,0:00:34.13,Default,,0,0,0,,Сұранысыңыз бар ма?
Dialogue: 0,0:00:35.18,0:00:38.51,Simai's OS,,0,0,0,,Сол кезде мен анама уәде берген едім.
Dialogue: 0,0:00:39.10,0:00:41.31,Simai's OS,,0,0,0,,Өте маңызды уәде...
Dialogue: 0,0:00:41.64,0:00:44.23,Default,,0,0,0,,Үлкен апа Үлкен апа
Dialogue: 0,0:00:45.19,0:00:46.31,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:00:49.61,0:00:51.15,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:00:52.15,0:00:54.24,Default,,0,0,0,,Дене қызуы төмендеді ме?
Dialogue: 0,0:00:57.24,0:00:58.37,Default,,0,0,0,,Жарайды~
Dialogue: 0,0:00:58.74,0:01:01.91,Default,,0,0,0,,Бұл ертеңгі күнмен бірдей, сондықтан мен қазірдің өзінде сауығып кеттім.
Dialogue: 0,0:01:03.00,0:01:04.46,Default,,0,0,0,,Мен газетті жеткіземін.
Dialogue: 0,0:01:04.46,0:01:05.92,Default,,0,0,0,,Сәлем, әпке
Dialogue: 0,0:01:06.50,0:01:08.00,Default,,0,0,0,,Маған қалдырыңыз~
Dialogue: 0,0:01:08.92,0:01:11.21,Default,,0,0,0,,Әпке, ол жер ашық емес.
Dialogue: 0,0:01:11.59,0:01:12.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:12.30,0:01:13.17,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:01:13.97,0:01:18.55,Default,,0,0,0,,Жаңбырда босануға мәжбүр болған соң, суық тигенім күшейіп кетті.
Dialogue: 0,0:01:18.76,0:01:22.47,Default,,0,0,0,,Жарайды, ауруыңды уайымдама дейсің...
Dialogue: 0,0:01:22.47,0:01:25.60,Default,,0,0,0,,Әй, апа, ұйықтау керек.
Dialogue: 0,0:01:36.45,0:01:40.12,Default,,0,0,0,,Мен туған жылы анам дүниеден өтті.
Dialogue: 0,0:01:40.66,0:01:43.79,Default,,0,0,0,,Әкем құмар ойындар арқылы қарызға батып, қайтыс болды.
Dialogue: 0,0:01:44.62,0:01:47.58,Default,,0,0,0,,Ал біз артта қалдық
Dialogue: 0,0:01:48.83,0:01:52.50,Default,,0,0,0,,40 жыл, едені жоқ 1К тозған пәтер
Dialogue: 0,0:01:53.09,0:01:54.92,Default,,0,0,0,,Бұл біздің үй
Dialogue: 0,0:01:55.51,0:01:57.59,Default,,0,0,0,,Бірақ көктем келгенде...
Dialogue: 0,0:01:58.29,0:02:02.92,OP_Jan,,0,0,0,,Өйткені мен естеліктерге орала алмаймын
Dialogue: 0,0:02:02.92,0:02:07.61,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:02:17.39,0:02:26.20,OP_Jan,,0,0,0,,Жалғыз болсаң да, жалғыз емессің
Dialogue: 0,0:02:26.81,0:02:35.63,OP_Jan,,0,0,0,,Жалғыз емеспіз, жалғыз емеспіз
Dialogue: 0,0:02:36.39,0:02:45.12,OP_Jan,,0,0,0,,Әлі аққан жастың алдында
Dialogue: 0,0:02:45.88,0:02:54.77,OP_Jan,,0,0,0,,Қызық, күліп, терең тыныс аламын ба?
Dialogue: 0,0:02:54.77,0:02:59.36,OP_Jan,,0,0,0,,Өйткені мен естеліктеріме орала алмаймын
Dialogue: 0,0:02:59.36,0:03:04.00,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:03:04.14,0:03:13.50,OP_Jan,,0,0,0,,Сенің таптырмас асылың жүрегімде
Dialogue: 0,0:03:13.55,0:03:18.81,OP_Jan,,0,0,0,,Басынан соққан желге терең тыныс алу
Dialogue: 0,0:03:51.33,0:03:54.33,Default,,0,0,0,,Апа, ботқа дайын.
Dialogue: 0,0:03:54.92,0:03:55.59,Default,,0,0,0,,Иә
Dialogue: 0,0:03:55.88,0:03:57.88,Default,,0,0,0,,Ертең рахмет
Dialogue: 0,0:04:01.80,0:04:03.63,Default,,0,0,0,,Күн ыстық, абай болыңыз
Dialogue: 0,0:04:06.80,0:04:08.26,Default,,0,0,0,,Дәмді
Dialogue: 0,0:04:10.14,0:04:11.77,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:04:12.44,0:04:14.56,Default,,0,0,0,,Тәбетіңіз болса, жарайсыз.
Dialogue: 0,0:04:24.36,0:04:25.95,Default,,0,0,0,,Ертең тамақ ішпейсің бе?
Dialogue: 0,0:04:26.20,0:04:27.53,Default,,0,0,0,,Иә
Dialogue: 0,0:04:28.24,0:04:29.79,Default,,0,0,0,,Қазір жақсы ма...
Dialogue: 0,0:04:30.75,0:04:31.58,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:04:34.04,0:04:37.17,Default,,0,0,0,,Мен терлеп жатырмын, сондықтан өзімді сүртіп, киімімді ауыстыруым керек.
Dialogue: 0,0:04:37.17,0:04:38.21,Default,,0,0,0,,Сол жерде...
Dialogue: 0,0:04:46.34,0:04:48.72,Default,,0,0,0,,Амансың ба? Сізге көбірек мұз керек пе?
Dialogue: 0,0:04:49.06,0:04:50.72,Default,,0,0,0,,Ертең жетеді
Dialogue: 0,0:04:52.31,0:04:56.06,Default,,0,0,0,,Температураңызды дұрыс өлшеп, демалсаңыз, жақсы болуыңыз керек.
Dialogue: 0,0:04:59.48,0:05:02.40,Simai's OS,,0,0,0,,Ара-тұра суық тию жақсы болуы мүмкін.
Dialogue: 0,0:05:06.03,0:05:08.78,Simai's OS,,0,0,0,,Ха, жоқ, жоқ, тез сауығып кетуім керек!
Dialogue: 0,0:05:09.28,0:05:12.66,Simai's OS,,0,0,0,,Ертеңгі күнді уайымдама.
Dialogue: 0,0:05:20.71,0:05:23.17,Default,,0,0,0,,Иә, мен толық қалпына келдім.
Dialogue: 0,0:05:23.30,0:05:26.38,Default,,0,0,0,,Жоқ, мен уайымдадым. Құдайға шүкір.
Dialogue: 0,0:05:26.38,0:05:28.18,Default,,0,0,0,,Әпкеме рахмет
Dialogue: 0,0:05:28.18,0:05:30.39,Default,,0,0,0,,Бүгіннен бастап қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:05:33.52,0:05:35.06,Default,,0,0,0,,Ақыры сауығып кетті
Dialogue: 0,0:05:35.43,0:05:38.44,Default,,0,0,0,,Ертеңгі күн үшін көп жұмыс істеуім керек!
Dialogue: 0,0:05:44.15,0:05:46.20,Default,,0,0,0,,Иә? Бар емес пе?
Dialogue: 0,0:05:47.57,0:05:49.24,Default,,0,0,0,,Енді ертең?
Dialogue: 0,0:05:49.74,0:05:52.12,Default,,0,0,0,,Иә? Су шығып жатыр
Dialogue: 0,0:05:52.12,0:05:53.29,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:55.08,0:05:55.96,Default,,0,0,0,,Ертең?
Dialogue: 0,0:05:58.08,0:05:59.63,Default,,0,0,0,,Ертең! ертең!
Dialogue: 0,0:06:09.84,0:06:11.68,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:12.76,0:06:16.68,Default,,0,0,0,,Үй иесі, ертең ауруханаға барыңыз.
Dialogue: 0,0:06:16.68,0:06:18.31,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:06:18.69,0:06:20.90,Default,,0,0,0,,Не болды? Ертең салқын бола ма?
Dialogue: 0,0:06:23.48,0:06:25.61,Default,,0,0,0,,Мен бұл жерден ары қарай жалғастыра алмаймын.
Dialogue: 0,0:06:25.61,0:06:27.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.07,0:06:29.49,Default,,0,0,0,,Сабыр етіңіз, жедел жәрдем шақырыңыз.
Dialogue: 0,0:06:29.91,0:06:30.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:40.75,0:06:42.92,Simai's OS,,0,0,0,,Мен неге байқамадым?
Dialogue: 0,0:06:44.05,0:06:46.05,Simai's OS,,0,0,0,,Ертең мен де суық тиіп қалдым.
Dialogue: 0,0:06:46.76,0:06:49.72,Simai's OS,,0,0,0,,Мен құлағанша ұстадым.
Dialogue: 0,0:06:56.68,0:06:57.93,Default,,0,0,0,,Анам…
Dialogue: 0,0:06:58.68,0:07:02.65,Default,,0,0,0,,Кио-чан, жарайды, бұл жай ғана суық тию.
Dialogue: 0,0:07:03.40,0:07:03.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:05.61,0:07:11.95,Simai's OS,,0,0,0,,Осыны айтып, анам жедел жәрдемге отырып, ауруханадан оралмады...
Dialogue: 0,0:07:28.26,0:07:30.55,Default,,0,0,0,,Сізге біраз уақыт ауруханада жату керек болады.
Dialogue: 0,0:07:30.55,0:07:32.51,Default,,0,0,0,,Түсінікті, өтінемін.
Dialogue: 0,0:07:32.51,0:07:33.97,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:07:34.47,0:07:38.56,Default,,0,0,0,,Қалғанын бізге қалдыр, әпкеңді шығару керек...
Dialogue: 0,0:07:38.56,0:07:42.27,Default,,0,0,0,,Кешіріңіз, мен сізді бүгін кешке ғана ертіп жүре аламын ба?
Dialogue: 0,0:07:50.53,0:07:53.20,Default,,0,0,0,,Кешіріңіз, ертең Кешіріңіз
Dialogue: 0,0:07:54.16,0:07:57.95,Simai's OS,,0,0,0,,Күшті болғым келеді...Күшті болғым келеді
Dialogue: 0,0:07:58.54,0:08:02.08,Simai's OS,,0,0,0,,Мен ертеңгі күнді қауіпсіз ететін апа болғым келеді.
Dialogue: 0,0:08:02.67,0:08:03.87,Simai's OS,,0,0,0,,Анам…
Dialogue: 0,0:08:06.25,0:08:07.63,Default,,0,0,0,,Эй... Кио Чан
Dialogue: 0,0:08:07.71,0:08:08.71,Default,,0,0,0,,Не?
Dialogue: 0,0:08:09.34,0:08:10.80,Default,,0,0,0,,Менің өтінішім бар...
Dialogue: 0,0:08:16.26,0:08:19.06,Default,,0,0,0,,Осы баланы қорғаңыз.
Dialogue: 0,0:08:21.06,0:08:23.02,Default,,0,0,0,,Иә, мен оны қорғаймын.
Dialogue: 0,0:08:23.44,0:08:25.52,Default,,0,0,0,,Мен сені міндетті түрде қорғаймын
Dialogue: 0,0:08:27.06,0:08:28.32,Simai's OS,,0,0,0,,Мен уәде бердім...
Dialogue: 0,0:08:29.36,0:08:34.11,Simai's OS,,0,0,0,,Ол кезде мен сені ертең қорғаймын деп уәде бергенмін...
Dialogue: 0,0:08:35.53,0:08:38.78,Simai's OS,,0,0,0,,Мен...ештеңе істей алмадым...
Dialogue: 0,0:08:47.67,0:08:48.84,Default,,0,0,0,,Үлкен әпке?
Dialogue: 0,0:08:53.09,0:08:53.92,Default,,0,0,0,,Ертең
Dialogue: 0,0:08:54.22,0:08:56.09,Default,,0,0,0,,Мазалағаным үшін кешіріңіз...
Dialogue: 0,0:08:58.55,0:09:02.31,Default,,0,0,0,,Ертең ауырып қалатынымды байқамаған мен едім.
Dialogue: 0,0:09:02.56,0:09:03.52,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:04.94,0:09:07.65,Default,,0,0,0,,Келесі жолы мен саған қамқор боламын.
Dialogue: 0,0:09:08.44,0:09:11.53,Default,,0,0,0,,Мен тау асуынан өттім, енді ол үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:09:11.82,0:09:13.11,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:13.82,0:09:17.66,Default,,0,0,0,,Мен осыдан кейін бірнеше сынақ жасаймын, қалғанын маған қалдырыңыз.
Dialogue: 0,0:09:18.32,0:09:18.91,Default,,0,0,0,,Иә
Dialogue: 0,0:09:18.91,0:09:20.03,Default,,0,0,0,,Баяу қабылдаңыз
Dialogue: 0,0:09:20.03,0:09:20.70,Default,,0,0,0,,Иә
Dialogue: 0,0:09:26.75,0:09:28.04,Default,,0,0,0,,Ертең...
Dialogue: 0,0:09:31.13,0:09:32.30,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:10:11.29,0:10:14.51,Default,,0,0,0,,Ойланып қарасам, ертең алма жеу керек пе?
Dialogue: 0,0:10:19.93,0:10:20.80,Default,,0,0,0,,Ах
Dialogue: 0,0:10:26.14,0:10:28.94,Default,,0,0,0,,Мен ештеңе істей алмаймын ...
Dialogue: 0,0:10:29.81,0:10:33.02,Default,,0,0,0,,Мен Асусыз ештеңе істей алмаймын.
Dialogue: 0,0:10:34.11,0:10:37.99,Default,,0,0,0,,Сіз өзіңізді бұлай қорғай алмайсыз.
Dialogue: 0,0:10:38.49,0:10:40.28,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:21.49,0:11:22.91,Default,,0,0,0,,Қайырлы таң, апа.
Dialogue: 0,0:11:22.91,0:11:24.24,Default,,0,0,0,,Қайырлы таң ертең
Dialogue: 0,0:11:24.74,0:11:25.78,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:11:26.45,0:11:28.20,Default,,0,0,0,,Мен тұра аламын ба?
Dialogue: 0,0:11:28.20,0:11:29.83,Default,,0,0,0,,Кешегіден әлдеқайда жақсы
Dialogue: 0,0:11:29.83,0:11:31.04,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:31.04,0:11:32.37,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:11:33.63,0:11:35.13,Default,,0,0,0,,Мен алманың қабығын тазаладым.
Dialogue: 0,0:11:35.21,0:11:36.59,Default,,0,0,0,,Сіздің әпкеңіз?
Dialogue: 0,0:11:39.05,0:11:39.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:40.47,0:11:43.93,Default,,0,0,0,,Апа, сіз алманы тұзды суға салмағансыз.
Dialogue: 0,0:11:43.97,0:11:44.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:44.68,0:11:45.97,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:11:48.27,0:11:49.43,Default,,0,0,0,,Дәмді~
Dialogue: 0,0:11:51.48,0:11:52.60,Default,,0,0,0,,Комен...
Dialogue: 0,0:11:53.73,0:11:54.31,Default,,0,0,0,,Е...
Dialogue: 0,0:11:54.48,0:11:58.48,Default,,0,0,0,,Мен ештеңе істей алмаймын ...
Dialogue: 0,0:12:02.95,0:12:03.95,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:12:04.49,0:12:05.74,Default,,0,0,0,,Сіз қалай ойлайсыз? Қалыңыз қалай?
Dialogue: 0,0:12:05.74,0:12:07.08,Default,,0,0,0,,А, үй иесі.
Dialogue: 0,0:12:07.08,0:12:08.70,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:08.70,0:12:10.41,Default,,0,0,0,,әлдеқайда жақсы
Dialogue: 0,0:12:10.75,0:12:12.92,Default,,0,0,0,,Кешегі күн үшін рахмет
Dialogue: 0,0:12:13.29,0:12:15.92,Default,,0,0,0,,Ал, қалғанын маған тапсырып, мектепке бар.
Dialogue: 0,0:12:15.92,0:12:18.21,Default,,0,0,0,,О, иә...
Dialogue: 0,0:12:25.18,0:12:27.01,Default,,0,0,0,,Әпке, өтінемін.
Dialogue: 0,0:12:29.52,0:12:30.81,Default,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:12:38.98,0:12:42.15,Default,,0,0,0,,Кио-чан, мына баланы қорғашы.
Dialogue: 0,0:12:43.15,0:12:44.95,Default,,0,0,0,,Иә, мен оны қорғаймын.
Dialogue: 0,0:12:44.95,0:12:46.99,Default,,0,0,0,,Мен сені міндетті түрде қорғаймын
Dialogue: 0,0:12:59.17,0:13:03.26,Default,,0,0,0,,Ертең Асу-чанға жақсылық жасау үшін гитара алып келдім.
Dialogue: 0,0:13:03.67,0:13:05.88,Default,,0,0,0,,Сіз шынымен де осында ән айтуды жоспарлап отырсыз ба?
Dialogue: 0,0:13:05.88,0:13:09.64,Default,,0,0,0,,Иә, бұл менің ниетім, бірақ... Менің ойымша, бұл жақсы емес пе?
Dialogue: 0,0:13:09.89,0:13:12.73,Default,,0,0,0,,Бұл аурухана, сізді айғайлайтын болады.
Dialogue: 0,0:13:13.14,0:13:14.64,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:13:14.81,0:13:18.65,Default,,0,0,0,,Бірақ мен Ичинокура-санның әнін тыңдағым келеді.
Dialogue: 0,0:13:19.06,0:13:21.57,Default,,0,0,0,,Мен өзімді жақсартып келе жатқандай сезінемін.
Dialogue: 0,0:13:24.11,0:13:27.20,Default,,0,0,0,,Олай болса ән айтайық. Асучан осылай деді.
Dialogue: 0,0:13:34.25,0:13:36.08,Default,,0,0,0,,Әпке, кешігіп қалдыңыз...
Dialogue: 0,0:13:34.71,0:13:40.96,Song,,0,0,0,,Тегіс, еркін
Dialogue: 0,0:14:02.65,0:14:03.82,Default,,0,0,0,,Одуванчик…
Dialogue: 0,0:14:05.24,0:14:06.53,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:14:14.12,0:14:17.62,Default,,0,0,0,,Бұл анаңның сүйікті гүлі.
Dialogue: 0,0:14:28.43,0:14:31.51,Default,,0,0,0,,Мен анаңның аурухана бөлмесіне апарамын.
Dialogue: 0,0:14:32.10,0:14:35.56,Default,,0,0,0,,Анашым, сіз одуванчикті көргенде күлесіз.
Dialogue: 0,0:14:36.48,0:14:40.23,Default,,0,0,0,,Сондықтан оны өзіңізбен бірге алып жүрсеңіз, өзіңізді жақсы сезінетініңізге сенімдімін.
Dialogue: 0,0:14:42.61,0:14:47.82,Default,,0,0,0,,Ол кезде мен күнде гүл теретінмін...
Dialogue: 0,0:14:50.86,0:14:54.70,Default,,0,0,0,,Ана, ана, мен қайтадан гүл тердім.
Dialogue: 0,0:15:11.47,0:15:16.64,Default,,0,0,0,,Ол кезде менің қолымнан ештеңе келмейтін...
Dialogue: 0,0:15:17.31,0:15:18.35,Default,,0,0,0,,Мен оны Солтүстік-Шығыс әскери театрдан алдым.
Dialogue: 0,0:15:19.98,0:15:24.31,Default,,0,0,0,,Бүгін тағы да одуванчик тердіңіз.
Dialogue: 0,0:15:25.44,0:15:26.61,Default,,0,0,0,,Анам…
Dialogue: 0,0:15:28.07,0:15:30.15,Default,,0,0,0,,Мен ештеңе істей алмаймын.
Dialogue: 0,0:15:30.57,0:15:32.91,Default,,0,0,0,,Мен саған ештеңе уәде еткен жоқпын...
Dialogue: 0,0:15:33.66,0:15:34.74,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:35.41,0:15:40.04,Default,,0,0,0,,Бүгін терген одушымдарға қарасам, ауруымды ұмытып кететін сияқтымын.
Dialogue: 0,0:15:44.54,0:15:45.63,Default,,0,0,0,,Анам…
Dialogue: 0,0:15:46.25,0:15:49.92,Default,,0,0,0,,Анамның күлкісі... бақытты көрінеді...
Dialogue: 0,0:15:51.55,0:15:52.59,Default,,0,0,0,,Ана
Dialogue: 0,0:15:53.05,0:15:57.26,Default,,0,0,0,,Ей, сенің анаң одуванчикті көргенде неге күледі?
Dialogue: 0,0:15:57.51,0:16:00.93,Default,,0,0,0,,Себебі одуванчик бақытты көрінеді.
Dialogue: 0,0:16:01.06,0:16:02.14,Default,,0,0,0,,Көңілді көрінеді ме?
Dialogue: 0,0:16:02.14,0:16:03.06,Default,,0,0,0,,Иә
Dialogue: 0,0:16:03.06,0:16:06.11,Default,,0,0,0,,Өйткені одуванчиктер Кио-чанмен бірдей.
Dialogue: 0,0:16:06.27,0:16:07.57,Default,,0,0,0,,Менімен?
Dialogue: 0,0:16:07.57,0:16:08.86,Default,,0,0,0,,Иә
Dialogue: 0,0:16:09.03,0:16:13.66,Default,,0,0,0,,Одуванчик бүгінгідей әрқашан күлімдеп тұратын сияқты.
Dialogue: 0,0:16:13.99,0:16:16.83,Default,,0,0,0,,Сол себепті мен одуванчикті көрсем күлемін.
Dialogue: 0,0:16:16.83,0:16:18.29,Default,,0,0,0,,(Панда) Бірінші курс студентін жіберуді қамтитын Арнайы сынып ісі — бұл төтенше жағдай.
Dialogue: 0,0:16:21.79,0:16:26.00,Default,,0,0,0,,Иә, сенің анаң одуваншыға күлген жоқ.
Dialogue: 0,0:16:27.34,0:16:30.05,Default,,0,0,0,,Анам маған қарап тұрды...
Dialogue: 0,0:16:30.88,0:16:33.34,Default,,0,0,0,,Ол менің күлгенімді көріп күлді...
Dialogue: 0,0:16:34.38,0:16:35.51,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:16:38.56,0:16:41.14,Default,,0,0,0,,Маған қара...
Dialogue: 0,0:16:42.52,0:16:43.98,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:16:53.32,0:16:58.66,Default,,0,0,0,,Бірақ менің... ертеңгі жүзім әрқашан мұңды...
Dialogue: 0,0:16:59.54,0:17:00.49,Default,,0,0,0,,Ертең...
Dialogue: 0,0:17:02.12,0:17:03.16,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:17:03.96,0:17:06.79,Default,,0,0,0,,Менің әпкем ешкімді алмастырмайды.
Dialogue: 0,0:17:07.25,0:17:08.13,Default,,0,0,0,,Ертең...
Dialogue: 0,0:17:10.88,0:17:14.97,Default,,0,0,0,,Сен үлкен апасың, сол қалпында қал.
Dialogue: 0,0:17:15.93,0:17:19.60,Default,,0,0,0,,Иә, түсіндім, әпкең осында.
Dialogue: 0,0:17:20.39,0:17:22.22,Default,,0,0,0,,Өйткені мен ешқайда кетпеймін
Dialogue: 0,0:17:24.56,0:17:27.94,Default,,0,0,0,,Мен не істеп едім? мен...
Dialogue: 0,0:17:37.41,0:17:39.32,Default,,0,0,0,,Ертең
Dialogue: 0,0:17:40.24,0:17:41.29,Default,,0,0,0,,Мен ұмытып қалдым...
Dialogue: 0,0:17:42.62,0:17:46.62,Default,,0,0,0,,Мен ертең жасай алатын жалғыз маңызды нәрсе
Dialogue: 0,0:17:46.96,0:17:48.21,Default,,0,0,0,,Мен ұмытып қалдым!
Dialogue: 0,0:17:55.51,0:17:58.05,Default,,0,0,0,,Әпке... Жарайды ма деп ойлаймын...
Dialogue: 0,0:17:58.84,0:18:01.43,Default,,0,0,0,,Шаршағаныңыз менің кесірімнен шығар...
Dialogue: 0,0:18:02.06,0:18:07.23,Default,,0,0,0,,Ауруханада жату үшін көп ақша керек... Менің ойымша, сіз мені мазасыз деп ойладыңыз...
Dialogue: 0,0:18:16.49,0:18:17.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:23.16,0:18:25.04,Default,,0,0,0,,Әй, әпке
Dialogue: 0,0:18:25.41,0:18:26.54,Default,,0,0,0,,Ши
Dialogue: 0,0:18:28.33,0:18:29.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:33.59,0:18:35.59,Default,,0,0,0,,Әй, әпке...
Dialogue: 0,0:18:41.18,0:18:42.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:43.64,0:18:46.68,Default,,0,0,0,,Әпке... Рахмет
Dialogue: 0,0:18:52.31,0:18:57.07,Default,,0,0,0,,Апаңның күлкісі одуванчикке ұқсайды
Dialogue: 0,0:19:00.41,0:19:02.91,Default,,0,0,0,,Асу-чан ауруханасынан шығуыңызбен құттықтаймыз
Dialogue: 0,0:19:02.91,0:19:04.66,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:04.66,0:19:06.24,Default,,0,0,0,,Біраз уақыт демалыңыз.
Dialogue: 0,0:19:06.24,0:19:06.79,Default,,0,0,0,,Иә
Dialogue: 0,0:19:06.95,0:19:08.46,Default,,0,0,0,,Сен сияқты жігіт тазаруға тиіс.
Dialogue: 0,0:19:12.42,0:19:15.84,Default,,0,0,0,,Әй, әпке, менің барғым келетін жер бар.
Dialogue: 0,0:19:24.05,0:19:26.64,Default,,0,0,0,,Енді бұлай ұстанба.
Dialogue: 0,0:19:26.72,0:19:27.31,Default,,0,0,0,,Иә
Dialogue: 0,0:19:27.68,0:19:30.98,Default,,0,0,0,,Бірақ алғашында әпкемнің суық тигені қаттырақ болды.
Dialogue: 0,0:19:31.40,0:19:35.36,Default,,0,0,0,,Мен қатты уайымдап, жалғыз болғаным сонша, өзімді ұмыттым.
Dialogue: 0,0:19:36.07,0:19:36.98,Default,,0,0,0,,Ертең...
Dialogue: 0,0:19:39.03,0:19:40.45,Default,,0,0,0,,Міне, міне.
Dialogue: 0,0:19:40.45,0:19:41.20,Default,,0,0,0,,«Аздап жұмсауға да болар...» деп ойладым.
Dialogue: 0,0:19:43.37,0:19:44.45,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:19:44.83,0:19:48.41,Default,,0,0,0,,Ал мен... анам сұрады.
Dialogue: 0,0:19:48.41,0:19:49.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:50.54,0:19:53.63,Default,,0,0,0,,Мен мұны бұл жерде баяғыда естігенмін.
Dialogue: 0,0:19:54.29,0:19:57.55,Default,,0,0,0,,Мен сенің әпкеңмін, түсіндің бе?
Dialogue: 0,0:19:59.51,0:20:00.97,Default,,0,0,0,,Үлкен апаның дауысы
Dialogue: 0,0:20:01.13,0:20:03.55,Default,,0,0,0,,Сосын анаңның дауысы
Dialogue: 0,0:20:05.35,0:20:08.31,Default,,0,0,0,,Өтінемін, өтінемін...
Dialogue: 0,0:20:09.52,0:20:10.64,Default,,0,0,0,,Менің әпкем...
Dialogue: 0,0:20:11.23,0:20:15.27,Default,,0,0,0,,Апаңызды қорғаңыз...
Dialogue: 0,0:20:17.48,0:20:19.90,Default,,0,0,0,,Бірақ ертең анаң туралы...
Dialogue: 0,0:20:19.90,0:20:22.36,Default,,0,0,0,,Иә, мүлде есімде жоқ.
Dialogue: 0,0:20:22.36,0:20:24.95,Default,,0,0,0,,Мен мұны көп рет естігендей болдым.
Dialogue: 0,0:20:25.45,0:20:28.16,Default,,0,0,0,,Сондықтан мен уәде бердім
Dialogue: 0,0:20:28.70,0:20:30.50,Default,,0,0,0,,Иә, мен оны қорғаймын!
Dialogue: 0,0:20:30.75,0:20:32.96,Default,,0,0,0,,Әпкесін қорғаймын деді.
Dialogue: 0,0:20:41.88,0:20:44.01,Default,,0,0,0,,Мама... Жарайды.
Dialogue: 0,0:20:44.72,0:20:48.01,Default,,0,0,0,,Біз уәдемізді орындай аламыз.
Dialogue: 0,0:20:51.06,0:20:55.02,Default,,0,0,0,,40 жыл, едені жоқ 1К тозығы жеткен пәтер
Dialogue: 0,0:20:55.69,0:20:58.02,Default,,0,0,0,,Бұл біздің үй
Dialogue: 0,0:20:58.98,0:21:01.15,Default,,0,0,0,,Бірақ көктем келгенде...
Dialogue: 0,0:21:04.40,0:21:06.95,Default,,0,0,0,,Әпкеңе қарашы.
Dialogue: 0,0:21:06.95,0:21:09.16,Default,,0,0,0,,Уау, гүлдеп тұр.
Dialogue: 0,0:21:14.21,0:21:17.50,Simai's OS,,0,0,0,,Біз өте бақыттымыз!
Dialogue: 0,0:21:19.84,0:21:21.96,Default,,0,0,0,,Үлкен апа, бұл өте қиын~
Dialogue: 0,0:21:22.34,0:21:24.72,Default,,0,0,0,,Бөлме гүл жапырақтарына толы
Dialogue: 0,0:21:46.40,0:21:50.53,EDJap,,0,0,0,,Жазықсыз әңгіме
Dialogue: 0,0:21:50.87,0:21:55.12,EDJap,,0,0,0,,Тіпті кенет тоқтап қалса да
Dialogue: 0,0:21:55.37,0:21:59.38,EDJap,,0,0,0,,Осылай жаныңда болу арқылы
Dialogue: 0,0:21:59.58,0:22:03.00,EDJap,,0,0,0,,Өзіңізді қауіпсіз сезініңіз
Dialogue: 0,0:22:04.30,0:22:08.72,EDJap,,0,0,0,,Маңдайыңызды ақырын сипау
Dialogue: 0,0:22:08.72,0:22:12.76,EDJap,,0,0,0,,Самал сияқты
Dialogue: 0,0:22:13.10,0:22:16.89,EDJap,,0,0,0,,Қолды мықтап ұстағанда
Dialogue: 0,0:22:17.48,0:22:22.02,EDJap,,0,0,0,,Еңіспен жүгірейік
Dialogue: 0,0:22:22.02,0:22:25.82,EDJap,,0,0,0,,Ертең де қызық болады.
Dialogue: 0,0:22:26.44,0:22:30.87,EDJap,,0,0,0,,Сапқа тұрайық
Dialogue: 0,0:22:30.99,0:22:34.83,EDJap,,0,0,0,,Тығыз, мықтап, Жел ұстасаң
Dialogue: 0,0:22:35.50,0:22:40.00,EDJap,,0,0,0,,Қолымды жайып, жеткізгім келеді
Dialogue: 0,0:22:40.00,0:22:43.84,EDJap,,0,0,0,,Тығыз, тығыз, ертең және болашақ та
Dialogue: 0,0:22:44.50,0:22:51.14,EDJap,,0,0,0,,Қатар жүрейік, бірге барайық
Dialogue: 0,0:03:30.23,0:03:34.48,generic sign style,,0,0,0,,Суық тию күні,
Dialogue: 1,0:03:30.23,0:03:34.48,generic sign style,,0,0,0,,Суық тию күні,
Dialogue: 2,0:03:30.23,0:03:34.48,generic sign style,,0,0,0,,Суық тию күні,
Dialogue: 3,0:03:30.23,0:03:34.48,generic sign style,,0,0,0,,Суық тию күні,
Dialogue: 0,0:03:30.23,0:03:34.48,generic sign style,,0,0,0,,Уәде және Ана
Dialogue: 1,0:03:30.23,0:03:34.48,generic sign style,,0,0,0,,Уәде және Ана
Dialogue: 2,0:03:30.23,0:03:34.48,generic sign style,,0,0,0,,Уәде және Ана
Dialogue: 3,0:03:30.23,0:03:34.48,generic sign style,,0,0,0,,Уәде және Ана
Dialogue: 4,0:03:30.23,0:03:34.48,generic sign style,,0,0,0,,Уәде және Ана
Dialogue: 0,0:05:20.63,0:05:20.67,OP - Kanji,,0,0,0,,«Оңтүстік-Шығыс» газеті
Dialogue: 0,0:05:20.67,0:05:20.71,OP - Kanji,,0,0,0,,Оңтүстік-Шығыс газеті
Dialogue: 0,0:05:20.71,0:05:20.75,OP - Kanji,,0,0,0,,Оңтүстік-Шығыс газеті
Dialogue: 0,0:05:20.75,0:05:20.80,OP - Kanji,,0,0,0,,Оңтүстік-Шығыс газеті
Dialogue: 0,0:05:20.80,0:05:20.84,OP - Kanji,,0,0,0,,Оңтүстік-Шығыс газеті
