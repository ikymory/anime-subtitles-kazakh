Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.88,0:00:04.75,Default,,0,0,0,,Мен кімге арнап ән айтамын...?
Dialogue: 0,0:00:05.58,0:00:06.89,Simai's OS,,0,0,0,,Мен ән айтқанды жек көремін
Dialogue: 0,0:00:07.25,0:00:09.46,Simai's OS,,0,0,0,,Ағынды дыбыспен
Dialogue: 0,0:00:09.72,0:00:12.59,Simai's OS,,0,0,0,,Сезімім барған сайын батып барады
Dialogue: 0,0:00:13.53,0:00:17.03,Default,,0,0,0,,Әндер кімдерге арналған?
Dialogue: 0,0:00:41.69,0:00:43.76,Default,,0,0,0,,Тағы да сол дауыс
Dialogue: 0,0:00:44.26,0:00:45.29,Default,,0,0,0,,Ертең
Dialogue: 0,0:00:53.43,0:00:55.97,Default,,0,0,0,,Бұл әйел елесі болуы мүмкін бе?
Dialogue: 0,0:00:56.50,0:00:58.20,Default,,0,0,0,,Жоқ, бәрібір, әпке.
Dialogue: 0,0:01:11.25,0:01:12.89,Default,,0,0,0,,Себебі мен сенімен біргемін
Dialogue: 0,0:01:13.15,0:01:14.99,Default,,0,0,0,,Ертең рахмет~
Dialogue: 0,0:01:17.49,0:01:19.43,Default,,0,0,0,,Ертең керемет болады...
Dialogue: 0,0:01:20.09,0:01:22.66,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:01:31.44,0:01:35.11,Default,,0,0,0,,Мен туған жылы анам дүниеден өтті.
Dialogue: 0,0:01:35.65,0:01:38.78,Default,,0,0,0,,Әкем құмар ойындар арқылы қарызға батып, қайтыс болды.
Dialogue: 0,0:01:39.57,0:01:42.58,Default,,0,0,0,,Ал біз артта қалдық
Dialogue: 0,0:01:43.83,0:01:47.50,Default,,0,0,0,,40 жаста, едені жоқ 1К тозығы жеткен пәтер
Dialogue: 0,0:01:48.04,0:01:49.92,Default,,0,0,0,,Бұл біздің үй
Dialogue: 0,0:01:50.50,0:01:52.59,Default,,0,0,0,,Бірақ көктем келгенде...
Dialogue: 0,0:01:53.28,0:01:57.91,OP_Jan,,0,0,0,,Өйткені мен өз естеліктерімді қайтара алмаймын
Dialogue: 0,0:01:57.91,0:02:02.60,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңгі күнді қолға ал
Dialogue: 0,0:02:12.38,0:02:21.19,OP_Jan,,0,0,0,,Жалғыз болсаң да, жалғыз емессің.
Dialogue: 0,0:02:21.80,0:02:30.62,OP_Jan,,0,0,0,,Біз жалғыз емеспіз, біз жалғыз емеспіз
Dialogue: 0,0:02:31.38,0:02:40.11,OP_Jan,,0,0,0,,Әлі аққан жастың алдында
Dialogue: 0,0:02:40.87,0:02:49.76,OP_Jan,,0,0,0,,Қызық, күліп, терең тыныс аламын ба?
Dialogue: 0,0:02:49.76,0:02:54.35,OP_Jan,,0,0,0,,Өйткені мен естеліктеріме орала алмаймын
Dialogue: 0,0:02:54.35,0:02:58.99,OP_Jan,,0,0,0,,Бүгін өмір сүріп, ертеңді қолға ал
Dialogue: 0,0:02:59.13,0:03:08.49,OP_Jan,,0,0,0,,Сенің таптырмас асылың жүрегімде
Dialogue: 0,0:03:08.54,0:03:13.80,OP_Jan,,0,0,0,,Желге терең тыныс алу
Dialogue: 0,0:03:34.90,0:03:36.73,Default,,0,0,0,,Аа, қайырлы таң, Асу-чан
Dialogue: 0,0:03:36.73,0:03:38.28,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:39.44,0:03:41.57,Default,,0,0,0,,Үй тапсырмасының жауаптарын сәйкестендірейік
Dialogue: 0,0:03:41.57,0:03:42.95,Default,,0,0,0,,Мен де Мен
Dialogue: 0,0:03:42.99,0:03:44.24,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:03:48.79,0:03:50.16,Default,,0,0,0,,Бітті
Dialogue: 0,0:03:50.62,0:03:52.04,Default,,0,0,0,,Рахмет саған Асу-чан
Dialogue: 0,0:03:52.12,0:03:53.21,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:53.54,0:03:56.21,Default,,0,0,0,,Асу-чанның қолынан бәрі келеді, солай ма?
Dialogue: 0,0:03:56.21,0:03:57.75,Default,,0,0,0,,Шынымен, шынымен
Dialogue: 0,0:03:58.35,0:03:59.92,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:04:00.22,0:04:02.19,Default,,0,0,0,,Мен жақсы емес нәрсе жоқ.
Dialogue: 0,0:04:02.45,0:04:04.99,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,0:04:06.19,0:04:07.23,Simai's OS,,0,0,0,,Жоқ.
Dialogue: 0,0:04:07.23,0:04:07.86,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:07.86,0:04:10.56,Default,,0,0,0,,Дұрыс, мен математикадан жақсы емеспін.
Dialogue: 0,0:04:11.06,0:04:13.27,Simai's OS,,0,0,0,,Мен де жақсы емес нәрселер бар...
Dialogue: 0,0:04:21.11,0:04:23.24,Simai's OS,,0,0,0,,Өйткені мен өте саңыраумын...
Dialogue: 0,0:04:26.95,0:04:29.31,Default,,0,0,0,,Иә, ән айту тестін бастайық.
Dialogue: 0,0:04:29.92,0:04:30.62,Default,,0,0,0,,Аида-сан
Dialogue: 0,0:04:31.04,0:04:31.87,Default,,0,0,0,,Иә
Dialogue: 0,0:04:33.71,0:04:34.58,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:04:41.09,0:04:48.51,UTA,,0,0,0,,Серіппелі ағын бірқалыпты ағады
Dialogue: 0,0:04:48.85,0:04:57.27,UTA,,0,0,0,,Жағалаудағы шегіргүл мен астрагал гүлдерінде
Dialogue: 0,0:04:57.31,0:05:06.11,UTA,,0,0,0,,Ақырын және әдемі
Dialogue: 0,0:05:06.20,0:05:14.91,UTA,,0,0,0,,Гүлде, гүлде, Маған сыбырлап
Dialogue: 0,0:04:51.06,0:04:52.27,Default,,0,0,0,,Шынында да, осы дүкенде…
Dialogue: 0,0:04:53.73,0:04:55.65,Default,,0,0,0,,А... Мен қатты толқып тұрмын.
Dialogue: 0,0:04:55.94,0:04:56.90,Default,,0,0,0,,Телефон қоңырау шалуда! Телефон...
Dialogue: 0,0:04:57.36,0:05:00.65,Default,,0,0,0,,Асу-чанның қатысу саны соңғы.
Dialogue: 0,0:05:00.73,0:05:02.65,Default,,0,0,0,,Менің ойымша, сынақ келесі аптада.
Dialogue: 0,0:05:02.65,0:05:04.32,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:04.86,0:05:07.66,Default,,0,0,0,,Амансың ба? Бозарып көрінесіз бе?
Dialogue: 0,0:05:07.66,0:05:11.16,Default,,0,0,0,,Жарайды... ештеңе емес...
Dialogue: 0,0:05:11.45,0:05:13.75,Default,,0,0,0,,Ертең Асу Чанның әнін асыға күтемін.
Dialogue: 0,0:05:14.08,0:05:16.08,Default,,0,0,0,,Сенің жақсы екеніңе сенімдімін~
Dialogue: 0,0:05:17.04,0:05:20.25,Default,,0,0,0,,Бұл дұрыс емес, мен саңыраумын.
Dialogue: 0,0:05:20.67,0:05:22.26,Default,,0,0,0,,Иә Келесі адам
Dialogue: 0,0:05:22.88,0:05:25.47,Default,,0,0,0,,Тек сол балалар ғана шебер, солай ма?
Dialogue: 0,0:05:25.47,0:05:26.59,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:26.59,0:05:29.35,Default,,0,0,0,,Асу-чан да сондай шығар.
Dialogue: 0,0:05:28.22,0:05:37.05,UTA,,0,0,0,,Бұлақ ағыны бірқалыпты ағады
Dialogue: 0,0:05:29.76,0:05:34.06,Default,,0,0,0,,Жоқ, мен шынымен саңыраумын...
Dialogue: 0,0:05:34.06,0:05:35.65,Default,,0,0,0,,Оны асыға күтемін~
Dialogue: 0,0:05:37.28,0:05:46.26,UTA,,0,0,0,,Жағалаудағы шегіргүл мен астрагал гүлдерінде
Dialogue: 0,0:05:45.16,0:05:48.49,Simai's OS,,0,0,0,,Күту бар... Не істеуім керек?
Dialogue: 0,0:05:55.93,0:05:59.17,Simai's OS,,0,0,0,,Бүгіннен бастап бір апта бойы күн сайын жаттығу жасайық.
Dialogue: 0,0:05:59.97,0:06:04.81,Default,,0,0,0,,Көктемгі ағын
Dialogue: 0,0:06:07.01,0:06:09.08,Simai's OS,,0,0,0,,Мен үшін қорқынышты...
Dialogue: 0,0:06:09.72,0:06:18.06,UTA,,0,0,0,,Жағалаудағы шегіргүл мен астрагал гүлдерінде
Dialogue: 0,0:06:18.06,0:06:28.57,UTA,,0,0,0,,Ақырын және әдемі
Dialogue: 0,0:06:28.57,0:06:38.88,UTA,,0,0,0,,Сыбырласып, гүлде, гүлде
Dialogue: 0,0:06:17.32,0:06:18.76,Default,,0,0,0,,Әдемі ән айтатын дауыс...
Dialogue: 0,0:06:19.02,0:06:22.61,Default,,0,0,0,,Сыртта біреу ән айтып жатыр ма?
Dialogue: 0,0:06:40.05,0:06:41.61,Simai's OS,,0,0,0,,Әдемі адам...
Dialogue: 0,0:06:41.85,0:06:44.75,Simai's OS,,0,0,0,,Адам...мүмкін...?
Dialogue: 0,0:06:46.39,0:06:48.99,Default,,0,0,0,,Сәлем, сен менің көршімсің, солай ма?
Dialogue: 0,0:06:48.99,0:06:50.19,Default,,0,0,0,,А, иә
Dialogue: 0,0:06:50.42,0:06:51.46,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:06:51.62,0:06:52.83,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:06:53.60,0:06:56.27,Default,,0,0,0,,Ән жақсы екен.
Dialogue: 0,0:06:56.47,0:06:57.31,Default,,0,0,0,,О
Dialogue: 0,0:06:58.52,0:07:00.23,Default,,0,0,0,,Мен әнші болуды мақсат етіп отырмын.
Dialogue: 0,0:07:00.48,0:07:03.36,Default,,0,0,0,,Сіз әншісіз бе? ? Бұл керемет
Dialogue: 0,0:07:03.48,0:07:06.07,Default,,0,0,0,,Жоқ, мен әлі дебют жасаған жоқпын.
Dialogue: 0,0:07:06.07,0:07:08.99,Default,,0,0,0,,Мен тыңдаудан өте алмаймын.
Dialogue: 0,0:07:10.34,0:07:10.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:11.88,0:07:14.25,Default,,0,0,0,,Бірақ сіз мұны өте жақсы орындадыңыз.
Dialogue: 0,0:07:14.68,0:07:16.68,Default,,0,0,0,,Мен шынымен саңыраумын...
Dialogue: 0,0:07:17.12,0:07:17.75,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:07:18.50,0:07:19.75,Default,,0,0,0,,Масао
Dialogue: 0,0:07:20.08,0:07:22.29,Default,,0,0,0,,О, сіз тұтынушысыз.
Dialogue: 0,0:07:22.83,0:07:25.13,Default,,0,0,0,,Масао сонда емес пе?
Dialogue: 0,0:07:25.46,0:07:27.92,Default,,0,0,0,,Иә, аздап шығады.
Dialogue: 0,0:07:28.34,0:07:29.55,Default,,0,0,0,,Сіз мені күте аласыз ба?
Dialogue: 0,0:07:33.09,0:07:34.68,Simai's OS,,0,0,0,,Масао-сан…
Dialogue: 0,0:07:35.14,0:07:37.31,Simai's OS,,0,0,0,,Мен ер адаммын
Dialogue: 0,0:07:38.47,0:07:40.18,Default,,0,0,0,,Мен қазір барамын
Dialogue: 0,0:07:40.43,0:07:42.41,Default,,0,0,0,,Мен, мен
Dialogue: 0,0:07:42.91,0:07:43.81,Default,,0,0,0,,Иә
Dialogue: 0,0:07:45.21,0:07:46.61,Default,,0,0,0,,Мен сыйлық әкелдім.
Dialogue: 0,0:07:47.05,0:07:47.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:48.08,0:07:49.92,Default,,0,0,0,,Дұрыс тамақтаныңыз, солай ма?
Dialogue: 0,0:07:50.82,0:07:51.48,Default,,0,0,0,,Иә
Dialogue: 0,0:07:51.88,0:07:52.78,Default,,0,0,0,,Олай болса~
Dialogue: 0,0:07:53.02,0:07:53.69,Default,,0,0,0,,Иә
Dialogue: 0,0:07:55.59,0:07:56.26,Default,,0,0,0,,Иә
Dialogue: 0,0:07:57.09,0:08:00.13,Default,,0,0,0,,Масао-сан, мен саған түскі ас қорапшасын жасадым♡
Dialogue: 0,0:08:00.13,0:08:00.93,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:01.23,0:08:04.23,Default,,0,0,0,,Мен әрқашан тікелей эфирді асыға күтемін.
Dialogue: 0,0:08:04.76,0:08:05.40,Default,,0,0,0,,Иә
Dialogue: 0,0:08:05.80,0:08:07.20,Default,,0,0,0,,Мен қайта ораламын♡
Dialogue: 0,0:08:07.20,0:08:07.80,Default,,0,0,0,,Иә
Dialogue: 0,0:08:09.94,0:08:10.77,Default,,0,0,0,,Иә
Dialogue: 0,0:08:11.30,0:08:15.67,Default,,0,0,0,,Масао-сан...
Dialogue: 0,0:08:16.74,0:08:18.54,Default,,0,0,0,,Жоқ рахмет
Dialogue: 0,0:08:19.44,0:08:20.41,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:08:20.85,0:08:21.48,Default,,0,0,0,,Иә
Dialogue: 0,0:08:24.22,0:08:25.35,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:08:28.49,0:08:29.96,Default,,0,0,0,,оның қазір қайда екенін немесе не істеп жатқанын білуге рұқсат жоқ па? Тіпті соны да білмейміз бе?
Dialogue: 0,0:08:30.46,0:08:31.92,Default,,0,0,0,,Сіз доссыз ба?
Dialogue: 0,0:08:31.92,0:08:35.56,Default,,0,0,0,,Хмм, мен оны онша жақсы білмеймін.
Dialogue: 0,0:08:35.56,0:08:36.26,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:08:41.07,0:08:44.74,Default,,0,0,0,,Бірақ менің әнім ұнайды дейді.
Dialogue: 0,0:08:45.24,0:08:47.04,Default,,0,0,0,,Менің де тыңдағым келеді.
Dialogue: 0,0:08:47.37,0:08:51.74,Default,,0,0,0,,Айтпақшы, сіздің жанды орындауды асыға күтетініңізді бұрын естігенмін.
Dialogue: 0,0:08:51.91,0:08:53.41,Default,,0,0,0,,Сіз мұны қайда істеп жатырсыз?
Dialogue: 0,0:08:53.85,0:08:56.58,Default,,0,0,0,,Мен тірі үйде ойнайтынмын.
Dialogue: 0,0:08:56.88,0:08:58.48,Default,,0,0,0,,Қазіргі уақытта демалыста
Dialogue: 0,0:08:58.65,0:08:59.32,Default,,0,0,0,,Е...
Dialogue: 0,0:09:00.15,0:09:02.02,Default,,0,0,0,,Менің ақшам таусылды
Dialogue: 0,0:09:02.15,0:09:05.79,Default,,0,0,0,,Мен студияны жалға ала алмаймын, ал мұндағы жалға алу қауіпті.
Dialogue: 0,0:09:06.63,0:09:09.29,Default,,0,0,0,,Ауылға қайтуды ойладым.
Dialogue: 0,0:09:09.29,0:09:12.73,Default,,0,0,0,,Мейірімді адамдардың арқасында тамақ ішемін деп уайымдамаймын.
Dialogue: 0,0:09:13.10,0:09:14.90,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:16.07,0:09:18.94,Default,,0,0,0,,Ән айтайын десем, Түн ортасында ән саламын.
Dialogue: 0,0:09:20.37,0:09:23.18,Simai's OS,,0,0,0,,Сол әлсіз дауыс осы кісі еді.
Dialogue: 0,0:09:23.81,0:09:27.41,Default,,0,0,0,,Дұрыс, мен Масао Ичинокурамын. Сен ше?
Dialogue: 0,0:09:28.11,0:09:29.41,Default,,0,0,0,,Бұл Асу Ямада.
Dialogue: 0,0:09:31.25,0:09:32.35,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:09:32.52,0:09:33.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:36.49,0:09:37.62,Default,,0,0,0,,Сіздің әніңіз
Dialogue: 0,0:09:39.29,0:09:40.59,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:09:46.73,0:09:48.73,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:09:53.24,0:09:55.57,Default,,0,0,0,,Сіздің әніңіз жақсы деп ойлаймын.
Dialogue: 0,0:09:56.61,0:10:01.11,Simai's OS,,0,0,0,,Қызық, мен де жаттығу жасасам, осылай ән айта аламын ба?
Dialogue: 0,0:10:05.52,0:10:07.19,Default,,0,0,0,,Ертең
Dialogue: 0,0:10:07.72,0:10:11.86,Default,,0,0,0,,Ертең тағы да сол дауыс
Dialogue: 0,0:10:16.90,0:10:23.00,Song,,0,0,0,,Жыпылықтау
Dialogue: 0,0:10:23.47,0:10:30.14,Song,,0,0,0,,Күн сәулесімен рахаттану
Dialogue: 0,0:10:30.78,0:10:36.32,Song,,0,0,0,,Жүрегім дірілдеп тұр
Dialogue: 0,0:10:36.32,0:10:43.26,Song,,0,0,0,,Осындай жазғы естеліктер
Dialogue: 0,0:10:18.30,0:10:21.53,Default,,0,0,0,,Жарайды, апа, мұқият тыңдаңыз.
Dialogue: 0,0:10:23.84,0:10:25.54,Default,,0,0,0,,Ән...дауыс?
Dialogue: 0,0:10:25.90,0:10:26.71,Default,,0,0,0,,Иә
Dialogue: 0,0:10:29.91,0:10:31.74,Default,,0,0,0,,Әдемі дауыс
Dialogue: 0,0:10:32.68,0:10:36.11,Default,,0,0,0,,Оны мен де ертерек түсінуім керек еді.
Dialogue: 0,0:10:36.58,0:10:39.55,Default,,0,0,0,,Бұл өте әдемі ән.
Dialogue: 0,0:10:43.76,0:10:46.56,Default,,0,0,0,,Қайырлы кеш. Шу болды ма?
Dialogue: 0,0:10:47.43,0:10:49.90,Default,,0,0,0,,Жоқ, бұл жақсы ән болды.
Dialogue: 0,0:10:50.06,0:10:53.33,Default,,0,0,0,,Қайырлы кеш, бұл Асудың әпкесі Кио Ямада.
Dialogue: 0,0:10:53.57,0:10:55.13,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:10:55.50,0:10:57.14,Default,,0,0,0,,Сәлем, қош келдіңіз
Dialogue: 0,0:11:03.21,0:11:05.18,Default,,0,0,0,,Күн суытып барады.
Dialogue: 0,0:11:07.05,0:11:09.52,Default,,0,0,0,,Мен бүгін аяқтауым керек.
Dialogue: 0,0:11:15.72,0:11:16.89,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:11:18.49,0:11:19.79,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:11:43.32,0:11:45.38,Simai's OS,,0,0,0,,Үйге ерте қайтайық, ән айтуға жаттығамыз.
Dialogue: 0,0:11:45.88,0:11:48.65,Simai's OS,,0,0,0,,Мен Ичинокура сияқты ән айта аламын ба?
Dialogue: 0,0:11:49.05,0:11:50.69,Simai's OS,,0,0,0,,Менің қолымнан келмейді...
Dialogue: 0,0:11:52.09,0:11:54.23,Simai's OS,,0,0,0,,Бұл Ичинокура.
Dialogue: 0,0:11:55.76,0:11:57.03,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:57.90,0:11:59.70,Default,,0,0,0,,А, Асу-чан, сәлем.
Dialogue: 0,0:12:05.47,0:12:06.94,Default,,0,0,0,,Мен қазір үйге бара жатырмын.
Dialogue: 0,0:12:07.07,0:12:08.21,Default,,0,0,0,,Иә
Dialogue: 0,0:12:08.51,0:12:10.81,Default,,0,0,0,,Мен үйде ән айтуды үйренемін...
Dialogue: 0,0:12:19.12,0:12:21.15,Default,,0,0,0,,Мм, қарсы болмасаңыз.
Dialogue: 0,0:12:21.15,0:12:21.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:22.32,0:12:27.13,Default,,0,0,0,,Өтінемін... маған ән үйретші, өтінемін.
Dialogue: 0,0:12:27.26,0:12:27.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:28.33,0:12:30.50,Default,,0,0,0,,Мектепте ән айту сынағы бар.
Dialogue: 0,0:12:30.96,0:12:35.00,Default,,0,0,0,,А, бірақ... рахмет айта алмаймын... Егер бұл мүмкін болмаса, жақсы.
Dialogue: 0,0:12:35.27,0:12:35.87,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:38.84,0:12:39.40,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:41.37,0:12:42.54,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:12:43.01,0:12:44.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:44.51,0:12:46.35,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:12:48.25,0:12:50.35,Default,,0,0,0,,Ал, енді бірден бастайық.
Dialogue: 0,0:12:50.65,0:12:52.99,Default,,0,0,0,,Сізде шу шығаратын нәрсе бар ма?
Dialogue: 0,0:12:53.59,0:12:54.55,Default,,0,0,0,,Жақсы
Dialogue: 0,0:12:55.89,0:12:57.82,Default,,0,0,0,,Пернетақта гармоникасы...
Dialogue: 0,0:12:58.02,0:13:00.99,Default,,0,0,0,,Хмм... жарайды деп ойлаймын.
Dialogue: 0,0:13:01.43,0:13:03.43,Default,,0,0,0,,Дәл осы дыбысты шығарып көріңіз
Dialogue: 0,0:13:04.20,0:13:04.80,Default,,0,0,0,,Иә
Dialogue: 0,0:13:05.76,0:13:06.97,Default,,0,0,0,,Do～～
Dialogue: 0,0:13:07.67,0:13:09.40,Default,,0,0,0,,Лех～～
Dialogue: 0,0:13:09.94,0:13:11.34,Default,,0,0,0,,Мэй~~
Dialogue: 0,0:13:15.21,0:13:15.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:16.81,0:13:18.88,Default,,0,0,0,,Мен F және А дыбыстарын естімеймін бе?
Dialogue: 0,0:13:19.38,0:13:23.25,Default,,0,0,0,,Бұл әпкемнің қолымен жасалған, сондықтан сәл сынған.
Dialogue: 0,0:13:23.78,0:13:27.49,Default,,0,0,0,,Анама жаңасын сатып ал деп айтсам ғой.
Dialogue: 0,0:13:28.32,0:13:32.36,Default,,0,0,0,,Менің анам да, әкем де жоқ...
Dialogue: 0,0:13:32.56,0:13:33.13,Default,,0,0,0,,Эх!
Dialogue: 0,0:13:33.69,0:13:36.40,Default,,0,0,0,,Екеуің сол пәтерде тұрасыңдар ма?
Dialogue: 0,0:13:36.56,0:13:37.13,Default,,0,0,0,,Иә
Dialogue: 0,0:13:40.03,0:13:42.57,Default,,0,0,0,,Кешіріңіз... Мен ештеңе білмеймін...
Dialogue: 0,0:13:44.20,0:13:47.34,Default,,0,0,0,,Жарайды, менің әпкем бар.
Dialogue: 0,0:13:47.54,0:13:51.08,Default,,0,0,0,,Егер мен бірдеңе істей алатын болсам, маған хабарлаңыз.
Dialogue: 0,0:13:51.08,0:13:54.55,Default,,0,0,0,,Бірақ, маған ән айтуды үйретті.
Dialogue: 0,0:13:54.81,0:13:56.32,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:13:59.79,0:14:02.49,Default,,0,0,0,,Мен Ичинокура-санның әнін тыңдағым келеді.
Dialogue: 0,0:14:02.69,0:14:03.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:16.57,0:14:17.27,Default,,0,0,0,,Иә
Dialogue: 0,0:14:19.64,0:14:20.84,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:14:21.27,0:14:22.41,Default,,0,0,0,,Мен кез келген уақытта ән айтамын
Dialogue: 0,0:14:31.48,0:14:34.39,Default,,0,0,0,,Әнді қалай қатты және дұрыс дыбыспен айту керек
Dialogue: 0,0:14:35.19,0:14:37.39,Default,,0,0,0,,Бүкіл денедегі бұлшықеттер де маңызды
Dialogue: 0,0:14:37.52,0:14:38.19,Default,,0,0,0,,Иә
Dialogue: 0,0:14:41.19,0:14:46.67,Default,,0,0,0,,Ичи Ни-сан
Dialogue: 0,0:14:43.03,0:14:49.20,Simai's OS,,0,0,0,,Одан кейін мен Ичинокура мырзамен күнде ән айтуды үйрендім.
Dialogue: 0,0:14:53.14,0:14:54.81,Simai's OS,,0,0,0,,Сіздің әпкеңізбен де
Dialogue: 0,0:14:55.54,0:14:56.51,Default,,0,0,0,,25
Dialogue: 0,0:14:56.51,0:14:57.64,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:14:57.64,0:14:58.71,Default,,0,0,0,,26
Dialogue: 0,0:14:57.78,0:14:58.71,Default,,0,0,0,,Ертең
Dialogue: 0,0:15:08.99,0:15:17.53,UTA,,0,0,0,,Бұлақ ағыны бірқалыпты ағып жатыр
Dialogue: 0,0:15:17.80,0:15:26.00,UTA,,0,0,0,,Жағалаудағы шегіргүл мен астрагал гүлдерінде
Dialogue: 0,0:15:26.21,0:15:34.12,UTA,,0,0,0,,Ақырын және әдемі
Dialogue: 0,0:15:34.12,0:15:43.46,UTA,,0,0,0,,Сыбырласып, гүлде, гүлде
Dialogue: 0,0:15:47.09,0:15:49.67,Default,,0,0,0,,Иә, өте жақсы болды.
Dialogue: 0,0:15:49.67,0:15:50.55,Default,,0,0,0,,Иә
Dialogue: 0,0:15:51.26,0:15:52.72,Default,,0,0,0,,(Таңғажайып)
Dialogue: 0,0:15:54.26,0:15:56.85,Default,,0,0,0,,Асу-чан жақсы болды.
Dialogue: 0,0:15:57.14,0:15:59.61,Default,,0,0,0,,Сен қалай ән айта аласың?
Dialogue: 0,0:16:01.34,0:16:03.51,Default,,0,0,0,,Мұғалімнің жақсы болғанынан болар.
Dialogue: 0,0:16:08.28,0:16:10.12,Default,,0,0,0,,Мен мұны ертең жасадым♡
Dialogue: 0,0:16:13.20,0:16:15.20,Default,,0,0,0,,...
Dialogue: 0,0:16:15.41,0:16:18.42,Default,,0,0,0,,Мен де Ичинокура-санға есеп беруім керек.
Dialogue: 0,0:16:18.76,0:16:21.36,Default,,0,0,0,,Аа, дұрыс, жасайық.
Dialogue: 0,0:16:25.36,0:16:28.80,Default,,0,0,0,,Ичинокура мырза, сынақ тамаша өтті!
Dialogue: 0,0:16:33.24,0:16:34.57,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:16:35.24,0:16:37.38,Default,,0,0,0,,Мен оның жақын арада оралатынына сенімдімін.
Dialogue: 0,0:16:44.32,0:16:46.65,Default,,0,0,0,,Менің ойымша, ол әлі оралған жоқ...
Dialogue: 0,0:16:50.59,0:16:56.06,Default,,0,0,0,,Бір аптадан кейін Ичинокура-сан әлі оралмады.
Dialogue: 0,0:16:57.86,0:17:00.63,Default,,0,0,0,,Ичинокура мырза, не болды?
Dialogue: 0,0:17:02.87,0:17:06.54,Default,,0,0,0,,Масао бар, солай ма? Масао
Dialogue: 0,0:17:08.14,0:17:09.44,Default,,0,0,0,,Масао
Dialogue: 0,0:17:12.08,0:17:12.64,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:12.91,0:17:13.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:13.68,0:17:15.78,Default,,0,0,0,,Не? Балалар сендер кімсіңдер?
Dialogue: 0,0:17:15.95,0:17:17.45,Default,,0,0,0,,О, мм...
Dialogue: 0,0:17:18.22,0:17:19.55,Default,,0,0,0,,Менің көршім
Dialogue: 0,0:17:19.89,0:17:23.66,Default,,0,0,0,,Ичинокура мырза...бір аптадан бері қайтып келмеді.
Dialogue: 0,0:17:23.79,0:17:25.29,Default,,0,0,0,,Егер сіз бірдеңе білсеңіз
Dialogue: 0,0:17:25.29,0:17:26.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:27.76,0:17:32.40,Default,,0,0,0,,Негізі, өзі қатысамын деген кастингке бармаған сияқты.
Dialogue: 0,0:17:32.90,0:17:36.37,Default,,0,0,0,,Сіз бұл жолы көбірек тырысамын деп айта бердіңіз.
Dialogue: 0,0:17:37.84,0:17:42.37,Default,,0,0,0,,Ойлап қарасам, сүйікті гитарасын сыйға тартты деген қауесеттер бар.
Dialogue: 0,0:17:42.47,0:17:43.84,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:17:43.84,0:17:47.35,Default,,0,0,0,,Гитара - Масаоның өмірінен маңыздырақ Такара бұйымы!
Dialogue: 0,0:17:48.15,0:17:50.08,Simai's OS,,0,0,0,,Өйткені, бұл...
Dialogue: 0,0:17:54.89,0:17:57.89,Simai's OS,,0,0,0,,Сен маған көп қызық үйреттің.
Dialogue: 0,0:17:58.52,0:18:00.43,Simai's OS,,0,0,0,,Ән өте керемет...
Dialogue: 0,0:18:01.29,0:18:02.36,Simai's OS,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:18:04.00,0:18:06.50,Default,,0,0,0,,Мен Ичинокура-санның әнін тыңдағым келеді.
Dialogue: 0,0:18:06.50,0:18:09.67,Default,,0,0,0,,Иә, маған қалдырыңыз, мен кез келген уақытта ән айтамын.
Dialogue: 0,0:18:12.77,0:18:14.84,Simai's OS,,0,0,0,,Мен уәде берсем де...
Dialogue: 0,0:18:15.14,0:18:18.24,Simai's OS,,0,0,0,,Сол кезде сіз әнді қайта айтамын дедіңіз.
Dialogue: 0,0:18:18.44,0:18:20.01,Simai's OS,,0,0,0,,Мен уәде берсем де...
Dialogue: 0,0:18:27.62,0:18:34.43,Song,,0,0,0,,Тегіс және бос
Dialogue: 0,0:18:34.43,0:18:41.13,Song,,0,0,0,,Желдің сыбыры, дәл солай
Dialogue: 0,0:18:41.43,0:18:49.17,Song,,0,0,0,,Көздеріңнен көктем нұрын төгеді...
Dialogue: 0,0:18:30.06,0:18:33.88,Default,,0,0,0,,Әнді естимін әнді...
Dialogue: 0,0:18:36.46,0:18:37.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:37.20,0:18:38.40,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:18:38.40,0:18:39.00,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:18:39.40,0:18:40.70,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:42.00,0:18:42.73,Default,,0,0,0,,Қайда?
Dialogue: 0,0:18:46.10,0:18:48.41,Default,,0,0,0,,Масао-кун~
Dialogue: 0,0:18:51.74,0:18:54.15,Default,,0,0,0,,(Масао)
Dialogue: 0,0:18:54.15,0:18:56.65,Default,,0,0,0,,(Мен уайымдадым)
Dialogue: 0,0:18:56.65,0:18:57.62,Default,,0,0,0,,Масао-сан
Dialogue: 0,0:18:58.88,0:18:59.79,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:59.79,0:19:04.39,Default,,0,0,0,,Мен түнгі толық емес жұмыс күні үшін біраз қиындық тудырған сияқтымын...
Dialogue: 0,0:19:04.39,0:19:07.06,Default,,0,0,0,,Қазірдің өзінде ақымақ
Dialogue: 0,0:19:09.76,0:19:12.03,Default,,0,0,0,,Бұдан былай дұрыстап айт.
Dialogue: 0,0:19:12.03,0:19:13.67,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:19:14.13,0:19:16.97,Default,,0,0,0,,Ичинокура-сан бәріне ұнайды, солай ма?
Dialogue: 0,0:19:16.97,0:19:17.77,Default,,0,0,0,,Иә
Dialogue: 0,0:19:19.44,0:19:21.51,Default,,0,0,0,,Өйткені мен тыңдаудан өте алмаймын.
Dialogue: 0,0:19:21.61,0:19:24.98,Default,,0,0,0,,Жалғастырудың қажеті жоқ деп ойлай бастадым.
Dialogue: 0,0:19:25.68,0:19:28.88,Default,,0,0,0,,Мен тіпті әншілікті тастауды да ойладым.
Dialogue: 0,0:19:29.51,0:19:30.32,Default,,0,0,0,,Бірақ
Dialogue: 0,0:19:37.16,0:19:39.79,Default,,0,0,0,,Бірақ мен ән айтуды шештім.
Dialogue: 0,0:19:40.53,0:19:43.90,Default,,0,0,0,,Сондықтан мен толық емес жұмысқа орналастым және осы гитараны қайта сатып алдым.
Dialogue: 0,0:19:46.27,0:19:47.10,Default,,0,0,0,,Гитара
Dialogue: 0,0:19:56.54,0:19:57.94,Default,,0,0,0,,Өйткені мен уәде бердім
Dialogue: 0,0:19:58.28,0:20:00.98,Default,,0,0,0,,Өйткені мен тағы да ән айтамын деп уәде бердім
Dialogue: 0,0:20:28.41,0:20:29.58,Default,,0,0,0,,Мен ән айтамын
Dialogue: 0,0:20:29.94,0:20:34.05,Default,,0,0,0,,Өйткені бұл менің қолымнан келетін жалғыз нәрсе
Dialogue: 0,0:20:35.51,0:20:36.98,Simai's OS,,0,0,0,,Әндер жұмбақ
Dialogue: 0,0:20:37.42,0:20:39.75,Simai's OS,,0,0,0,,Ағынды дыбыспен
Dialogue: 0,0:20:40.39,0:20:43.79,Simai's OS,,0,0,0,,Сезімдерім жылынып барады.
Dialogue: 0,0:20:45.66,0:20:48.93,Default,,0,0,0,,Сондықтан мен әнді жалғастырамын
Dialogue: 0,0:20:59.10,0:21:03.18,Simai's OS,,0,0,0,,Сондықтан мен мұнда мәңгі қала аламын
Dialogue: 0,0:21:03.68,0:21:05.61,Simai's OS,,0,0,0,,Мен әпкеммен барымды саламын.
Dialogue: 0,0:21:10.08,0:21:13.19,Default,,0,0,0,,Әнді әрқашан тыңдау үшін
Dialogue: 0,0:20:23.94,0:20:30.44,Song,,0,0,0,,Тегіс, еркін
Dialogue: 0,0:20:30.44,0:20:37.38,Song,,0,0,0,,Желдің сыбыры, дәл солай
Dialogue: 0,0:20:37.85,0:20:43.82,Song,,0,0,0,,Көздеріңде жарқырап тұрғанда
Dialogue: 0,0:20:43.82,0:20:50.00,Song,,0,0,0,,Мен көктемді осылай шақырамын
Dialogue: 0,0:20:50.60,0:20:56.70,Song,,0,0,0,,Жыпылықтау
Dialogue: 0,0:20:57.17,0:21:03.84,Song,,0,0,0,,Күн сәулесімен рахаттану
Dialogue: 0,0:21:04.48,0:21:10.02,Song,,0,0,0,,Жүрегім дірілдеп тұр
Dialogue: 0,0:21:10.02,0:21:16.96,Song,,0,0,0,,Осындай жазғы естеліктер
Dialogue: 0,0:21:46.45,0:21:50.58,EDJap,,0,0,0,,Жазықсыз әңгіме
Dialogue: 0,0:21:50.91,0:21:55.16,EDJap,,0,0,0,,Тіпті кенет тоқтап қалса да
Dialogue: 0,0:21:55.41,0:21:59.42,EDJap,,0,0,0,,Осылай жаныңда болу арқылы
Dialogue: 0,0:21:59.63,0:22:03.05,EDJap,,0,0,0,,Өзіңізді қауіпсіз сезініңіз
Dialogue: 0,0:22:04.34,0:22:08.76,EDJap,,0,0,0,,Маңдайыңызды ақырын сипау
Dialogue: 0,0:22:08.76,0:22:12.81,EDJap,,0,0,0,,Самал сияқты
Dialogue: 0,0:22:13.14,0:22:16.94,EDJap,,0,0,0,,Қолды мықтап, қатты ұстағанда
Dialogue: 0,0:22:17.52,0:22:22.07,EDJap,,0,0,0,,Еңіспен жүгірейік
Dialogue: 0,0:22:22.07,0:22:25.86,EDJap,,0,0,0,,Ертең де қызық болады.
Dialogue: 0,0:22:26.49,0:22:30.91,EDJap,,0,0,0,,Сапқа тұрайық
Dialogue: 0,0:22:31.03,0:22:34.87,EDJap,,0,0,0,,Тығыз, мықтап, Жел ұстасаң
Dialogue: 0,0:22:35.54,0:22:40.04,EDJap,,0,0,0,,Қолымды жайып, жеткізгім келеді
Dialogue: 0,0:22:40.04,0:22:43.84,EDJap,,0,0,0,,Тығыз, тығыз, ертең және болашақ та
Dialogue: 0,0:22:44.55,0:22:51.18,EDJap,,0,0,0,,Қатар барайық, бірге барайық
Dialogue: 0,0:22:57.52,0:23:01.15,Default,,0,0,0,,Мен ертең лотереядан ұтып алған ұялы телефонымды абайлап пайдалануым керек.
Dialogue: 0,0:23:01.15,0:23:04.19,Default,,0,0,0,,Әпке, қызық, неге болмайды?
Dialogue: 0,0:23:04.78,0:23:06.53,Default,,0,0,0,,Бейшара апалар әңгімесі
Dialogue: 0,0:23:06.69,0:23:09.74,Simai's OS,,0,0,0,,Ойлар, алаңдаушылық және ұялы телефондар күні
Dialogue: 0,0:23:09.91,0:23:11.61,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:03:25.30,0:03:29.56,generic sign style,,0,0,0,,Гитара күні, армандар,
