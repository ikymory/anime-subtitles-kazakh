Dialogue: 0,0:14:37.02,0:14:37.26,generic sign style,,0,0,0,,Тест!
Dialogue: 0,0:14:37.26,0:14:39.73,generic sign style,,0,0,0,,Тест!
Dialogue: 0,0:15:08.59,0:15:11.06,generic sign style,,0,0,0,,Тест!
Dialogue: 0,0:16:34.81,0:16:38.21,generic sign style,,0,0,0,,Тест!
Dialogue: 0,0:16:52.99,0:16:58.26,generic sign style,,0,0,0,,Тест!
Dialogue: 0,0:00:02.92,0:00:04.89,Dialogue-italic,,0,0,0,,Кімге арнап ән айтамын?
Dialogue: 0,0:00:05.66,0:00:07.32,Dialogue-italic,,0,0,0,,Мен музыканы ұнатпаймын.
Dialogue: 0,0:00:07.32,0:00:12.75,Dialogue-italic,,0,0,0,,Менің жүрегім үнемі ағып жатқан ноталардан бір мұңды табады.
Dialogue: 0,0:00:13.54,0:00:16.99,Dialogue-italic,,0,0,0,,Музыка кім үшін бар?
Dialogue: 0,0:00:41.76,0:00:44.19,Dialogue,,0,0,0,,Бұл қайтадан дауыс!
Dialogue: 0,0:00:44.40,0:00:45.76,Dialogue,,0,0,0,,Асу!
Dialogue: 0,0:00:53.51,0:00:56.16,Dialogue,,0,0,0,,Бұл шынымен де әйелдің елесі ме?
Dialogue: 0,0:00:56.16,0:00:58.36,Dialogue,,0,0,0,,Д-Уайымдама, Они-чан.
Dialogue: 0,0:01:11.38,0:01:13.28,Dialogue,,0,0,0,,Мен сен үшін осындамын.
Dialogue: 0,0:01:13.28,0:01:15.09,Dialogue,,0,0,0,,Рахмет, Асу.
Dialogue: 0,0:01:17.68,0:01:20.03,Dialogue,,0,0,0,,Сен өте батылсың, Асу!
Dialogue: 0,0:01:20.22,0:01:22.99,Dialogue,,0,0,0,,Жоқ, мен шынымен де...
Dialogue: 0,0:01:31.33,0:01:35.06,Dialogue,,0,0,0,,Анам Асу туған жылы жұмаққа аттанды.
Dialogue: 0,0:01:35.55,0:01:38.81,Dialogue,,0,0,0,,Әкем құмар ойындарға қарыздар жинап, жоғалып кетті.
Dialogue: 0,0:01:39.39,0:01:42.99,Dialogue,,0,0,0,,Осылайша бізді тастап кетті.
Dialogue: 0,0:01:43.74,0:01:47.82,Dialogue,,0,0,0,,Бұл 40 жастағы, бір бөлмелі, моншасы жоқ, тозығы жеткен пәтер.
Dialogue: 0,0:01:47.82,0:01:49.89,Dialogue,,0,0,0,,Бұл біздің үй.
Dialogue: 0,0:01:50.30,0:01:52.57,Dialogue,,0,0,0,,Бірақ көктем келгенде…
Dialogue: 0,0:03:35.42,0:03:36.97,Dialogue,,0,0,0,,Қайырлы таң, Асу-чан.
Dialogue: 0,0:03:36.97,0:03:38.19,Dialogue,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:03:39.27,0:03:41.40,Dialogue,,0,0,0,,Өткен түнгі үй тапсырмасының жауаптарын салыстырғыңыз келе ме?
Dialogue: 0,0:03:41.40,0:03:42.86,Dialogue,,0,0,0,,Мен де, мен де.
Dialogue: 0,0:03:42.86,0:03:44.03,Dialogue,,0,0,0,,Жарайды, әрине.
Dialogue: 0,0:03:44.51,0:03:45.44,Dialogue,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:03:45.44,0:03:46.49,Dialogue,,0,0,0,,Қайырлы таң, сэр!
Dialogue: 0,0:03:48.55,0:03:51.41,Dialogue,,0,0,0,,Міне! Көп рахмет, Асу Чан!
Dialogue: 0,0:03:52.45,0:03:54.67,Dialogue,,0,0,0,,Сіз жасай алмайтын ештеңе жоқ!
Dialogue: 0,0:03:54.67,0:03:55.63,Dialogue,,0,0,0,,Шынымен де.
Dialogue: 0,0:03:56.42,0:03:57.80,Dialogue,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:03:58.19,0:04:00.51,Dialogue,,0,0,0,,Сіздің осал тұстарыңыз жоқ, солай ма?
Dialogue: 0,0:04:00.51,0:04:02.97,Dialogue,,0,0,0,,Иә, ол жоқ сияқты, солай ма?
Dialogue: 0,0:04:04.17,0:04:05.33,Dialogue-italic,,0,0,0,,Сіз қателесесіз.
Dialogue: 0,0:04:05.33,0:04:06.14,Dialogue,,0,0,0,,Бұл жақсы болуы керек.
Dialogue: 0,0:04:06.14,0:04:09.23,Dialogue,,0,0,0,,Мен солай деп ойлаймын. Мен арифметикадан өте нашармын, білесіз бе.
Dialogue: 0,0:04:09.95,0:04:12.66,Dialogue-italic,,0,0,0,,Мен де басқалар сияқты адаммын.
Dialogue: 0,0:04:20.60,0:04:22.36,Dialogue-italic,,0,0,0,,Мен мүлдем естімейтінмін.
Dialogue: 0,0:04:26.14,0:04:28.72,Dialogue,,0,0,0,,Жарайды. Музыкалық тестті бастайық!
Dialogue: 0,0:04:29.50,0:04:30.83,Dialogue,,0,0,0,,Аида-сан.
Dialogue: 0,0:04:30.83,0:04:31.61,Dialogue,,0,0,0,,Иә, ханым.
Dialogue: 0,0:04:32.99,0:04:33.64,Dialogue,,0,0,0,,Олай болса.
Dialogue: 0,0:04:39.85,0:04:48.72,INSERT SONGS 5000,,0,0,0,song,Көктемнің кішкентай бұлағы шулайды,
Dialogue: 0,0:04:48.72,0:04:57.24,INSERT SONGS 5000,,0,0,0,song,оның жағасындағы шегіргүлдер мен лотос гүлдерін айналып өту.
Dialogue: 0,0:04:57.31,0:05:05.73,INSERT SONGS 5000,,0,0,0,song,Өзінің мейірімді сыртқы түрімен және әдемі түстерімен,
Dialogue: 0,0:05:06.11,0:05:14.58,INSERT SONGS 5000,,0,0,0,song,ол оларға: «Гүлдеңдер!
Dialogue: 0,0:04:50.80,0:04:52.18,Dialogue-italic,,0,0,0,,Мен не істеймін?
Dialogue: 0,0:04:53.62,0:04:56.82,Dialogue,,0,0,0,,Ах, мен қатты қобалжыдым. Бұл болмайды!
Dialogue: 0,0:04:57.24,0:05:02.52,Dialogue,,0,0,0,,Асу-чан, сен тізімдегі соңғы адамсың, сондықтан келесі аптада баратын шығарсың, солай ма?
Dialogue: 0,0:05:02.52,0:05:04.15,Dialogue,,0,0,0,,И-иә.
Dialogue: 0,0:05:04.72,0:05:07.53,Dialogue,,0,0,0,,Амансың ба? Сіз аздап бозарған сияқтысыз.
Dialogue: 0,0:05:08.10,0:05:10.82,Dialogue,,0,0,0,,Менде бәрі жақсы. Ештеңе етпейді.
Dialogue: 0,0:05:11.22,0:05:13.79,Dialogue,,0,0,0,,Мен сіздің ән айтуыңызды асыға күтемін!
Dialogue: 0,0:05:13.79,0:05:15.87,Dialogue,,0,0,0,,Сіз шынымен дарынды екеніңізге сенімдімін!
Dialogue: 0,0:05:16.87,0:05:19.96,Dialogue,,0,0,0,,Бұл дұрыс емес! Мен мүлдем саңыраумын!
Dialogue: 0,0:05:20.52,0:05:22.21,Dialogue,,0,0,0,,Жарайды! Келесі адам.
Dialogue: 0,0:05:22.79,0:05:25.47,Dialogue,,0,0,0,,Мұны айтатын адамдар әрқашан таланттылар, солай ма?
Dialogue: 0,0:05:25.47,0:05:28.68,Dialogue,,0,0,0,,Дұрыс айтасыз. Асу-чан да дәл осындай адам сияқты.
Dialogue: 0,0:05:28.68,0:05:33.05,Dialogue,,0,0,0,,N-Жоқ, бұл мүлдем дұрыс емес. Мен шынымен саңыраумын.
Dialogue: 0,0:05:33.05,0:05:34.43,Dialogue,,0,0,0,,Біз күте алмаймыз!
Dialogue: 0,0:05:27.56,0:05:35.92,INSERT SONGS 5000,,0,0,0,song,Көктемнің кішкентай бұлағы шулайды,
Dialogue: 0,0:05:36.35,0:05:44.58,INSERT SONGS 5000,,0,0,0,song,оның жағасындағы шегіргүлдер мен лотос гүлдерін айналып өту.
Dialogue: 0,0:05:43.81,0:05:46.96,Dialogue-italic,,0,0,0,,Олар қатты көңілдері қалады... Мен не істеймін?
Dialogue: 0,0:05:53.99,0:05:57.27,Dialogue-italic,,0,0,0,,Бүгіннен бастап менде толық апта бар, сондықтан мен күн сайын жаттығу жасаймын.
Dialogue: 0,0:05:58.18,0:06:02.97,Dialogue,,0,0,0,,Көктемнің кішкентай бұлағы...
Dialogue: 0,0:06:05.13,0:06:07.00,Dialogue-italic,,0,0,0,,Менің дауысым қорқынышты естіледі.
Dialogue: 0,0:06:07.95,0:06:17.52,Dialogue,,0,0,0,song,…жағасындағы шегіргүлдер мен лотос гүлдерінің жанынан өтіп бара жатыр.
Dialogue: 0,0:06:17.52,0:06:26.74,Dialogue,,0,0,0,song,Мейірімді келбеті мен әдемі түстерімен,
Dialogue: 0,0:06:26.74,0:06:37.06,Dialogue,,0,0,0,song,ол оларға: «Гүлдеңдер!
Dialogue: 0,0:06:16.63,0:06:18.31,Dialogue,,0,0,0,,Дауысы қандай әдемі...
Dialogue: 0,0:06:18.74,0:06:21.61,Dialogue,,0,0,0,,Сыртта ән айтып жатқан біреу бар ма?
Dialogue: 0,0:06:38.41,0:06:40.21,Dialogue-italic,,0,0,0,,Ол әдемі…
Dialogue: 0,0:06:40.21,0:06:42.71,Dialogue-italic,,0,0,0,,…немесе күте тұрыңыз, мүмкін ол ол адам шығар?
Dialogue: 0,0:06:44.53,0:06:47.82,Dialogue,,0,0,0,,Қайырлы күн. Сіз менің көршімсіз, солай ма?
Dialogue: 0,0:06:48.32,0:06:49.32,Dialogue,,0,0,0,,Y-Иә, мен.
Dialogue: 0,0:06:49.55,0:06:50.89,Dialogue,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:06:51.30,0:06:52.89,Dialogue,,0,0,0,,Сізбен де танысқаныма қуаныштымын.
Dialogue: 0,0:06:53.35,0:06:56.21,Dialogue,,0,0,0,,Мм... сіз ән айтуда өте жақсысыз, солай емес пе?
Dialogue: 0,0:06:56.21,0:06:59.89,Dialogue,,0,0,0,,Менің арманым әнші болу.
Dialogue: 0,0:07:00.24,0:07:02.69,Dialogue,,0,0,0,,Сіз әншісіз бе? Бұл керемет!
Dialogue: 0,0:07:02.91,0:07:03.67,Dialogue,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:07:03.67,0:07:07.37,Dialogue,,0,0,0,,Мен әлі дебют жасаған жоқпын. Мен қазір қайта-қайта тыңдаудан өтіп жатырмын.
Dialogue: 0,0:07:10.51,0:07:13.51,Dialogue,,0,0,0,,В-Бірақ сен керемет ән айтасың!
Dialogue: 0,0:07:14.06,0:07:16.71,Dialogue,,0,0,0,,Мен мүлдем естімейтінмін.
Dialogue: 0,0:07:16.71,0:07:17.74,Dialogue,,0,0,0,,Эй, тыңда...
Dialogue: 0,0:07:18.30,0:07:19.47,Dialogue,,0,0,0,,Масао!
Dialogue: 0,0:07:20.37,0:07:21.75,Dialogue,,0,0,0,,Қонақ келген сияқты.
Dialogue: 0,0:07:22.32,0:07:24.62,Dialogue,,0,0,0,,Масао! Сіз сондасыз ба?
Dialogue: 0,0:07:24.62,0:07:25.50,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:07:25.50,0:07:28.76,Dialogue,,0,0,0,,Мен бірден қайтамын. Мені күт, жарай ма?
Dialogue: 0,0:07:32.54,0:07:36.04,Dialogue-italic,,0,0,0,,«Масао-сан». Демек ол жігіт.
Dialogue: 0,0:07:37.01,0:07:38.50,Dialogue,,0,0,0,,Мен дәл қазір келе жатырмын.
Dialogue: 0,0:07:38.50,0:07:40.35,Dialogue,,0,0,0,,Бұл менмін! Мен!
Dialogue: 0,0:07:40.99,0:07:41.67,Dialogue,,0,0,0,,Иә?
Dialogue: 0,0:07:43.27,0:07:44.77,Dialogue,,0,0,0,,Мен саған бірдеңе әкелдім.
Dialogue: 0,0:07:45.22,0:07:46.25,Dialogue,,0,0,0,,Рахмет.
Dialogue: 0,0:07:46.25,0:07:48.05,Dialogue,,0,0,0,,Дұрыс тамақтан, жарай ма?
Dialogue: 0,0:07:48.89,0:07:49.88,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:07:49.88,0:07:50.96,Dialogue,,0,0,0,,Кездескенше!
Dialogue: 0,0:07:53.67,0:07:54.43,Dialogue,,0,0,0,,Иә?
Dialogue: 0,0:07:55.32,0:07:58.28,Dialogue,,0,0,0,,Масао-сан, мен саған қораптағы түскі ас әзірледім.
Dialogue: 0,0:07:58.28,0:07:59.10,Dialogue,,0,0,0,,Рахмет.
Dialogue: 0,0:07:59.41,0:08:02.26,Dialogue,,0,0,0,,Мен сіздің келесі тікелей эфиріңізді асыға күтемін!
Dialogue: 0,0:08:03.86,0:08:05.23,Dialogue,,0,0,0,,Мен кейінірек қайтамын.
Dialogue: 0,0:08:07.95,0:08:09.03,Dialogue,,0,0,0,,Иә?
Dialogue: 0,0:08:09.35,0:08:13.67,Dialogue,,0,0,0,,Масао-сан, иә, бұл алаңдатпайды деп үміттенемін, бірақ…
Dialogue: 0,0:08:14.94,0:08:17.01,Dialogue,,0,0,0,,О, мүлде емес. Рақмет сізге.
Dialogue: 0,0:08:17.52,0:08:18.54,Dialogue,,0,0,0,,Қош бол!
Dialogue: 0,0:08:22.36,0:08:23.47,Dialogue,,0,0,0,,Күткенім үшін кешіріңіз.
Dialogue: 0,0:08:26.42,0:08:28.04,Dialogue,,0,0,0,,Бұл шынымен де бір нәрсе.
Dialogue: 0,0:08:28.42,0:08:29.85,Dialogue,,0,0,0,,Олар сенің достарың ба?
Dialogue: 0,0:08:31.24,0:08:33.58,Dialogue,,0,0,0,,Негізі мен оларды онша жақсы білмеймін.
Dialogue: 0,0:08:39.01,0:08:43.00,Dialogue,,0,0,0,,Бірақ олар менің әндерімді қатты бағалайды.
Dialogue: 0,0:08:43.35,0:08:45.35,Dialogue,,0,0,0,,Мен де оларды тыңдағым келеді.
Dialogue: 0,0:08:45.35,0:08:49.91,Dialogue,,0,0,0,,Дұрыс, олардың бірі сіздің ойнағаныңызды асыға күтетінін айтты.
Dialogue: 0,0:08:49.91,0:08:51.49,Dialogue,,0,0,0,,Сіз қай жерде өнер көрсетесіз?
Dialogue: 0,0:08:51.95,0:08:56.59,Dialogue,,0,0,0,,Өткен жолы жанды музыка клубында болды, бірақ қазір мен үзіліс жасап жатырмын.
Dialogue: 0,0:08:58.26,0:09:02.19,Dialogue,,0,0,0,,Менің ақшам таусылды, сондықтан мен студияда басқа уақытты төлей алмаймын;
Dialogue: 0,0:09:02.19,0:09:03.92,Dialogue,,0,0,0,,Мен мұндағы пәтерді әрең төлеймін.
Dialogue: 0,0:09:04.74,0:09:07.55,Dialogue,,0,0,0,,Мен тіпті ауылға оралуды ойладым,
Dialogue: 0,0:09:07.55,0:09:11.06,Dialogue,,0,0,0,,бірақ жанкүйерлерімнің қолдауымен мен әлі де үнемі тамақтана аламын.
Dialogue: 0,0:09:11.06,0:09:12.99,Dialogue,,0,0,0,,Мен не болды деп ойладым.
Dialogue: 0,0:09:14.08,0:09:17.05,Dialogue,,0,0,0,,Әдетте ән айтқым келетін болса, қазірдің өзінде түн болады.
Dialogue: 0,0:09:18.37,0:09:21.57,Dialogue-italic,,0,0,0,,Сол елес дауыс оның басынан бері болатын.
Dialogue: 0,0:09:22.01,0:09:25.51,Dialogue,,0,0,0,,Иә, мен Ичинокура Масаомын. Және сен?
Dialogue: 0,0:09:26.10,0:09:27.47,Dialogue,,0,0,0,,Мен Ямада Асумын.
Dialogue: 0,0:09:29.35,0:09:30.53,Dialogue,,0,0,0,,Бұл жақсы, сіз білесіз.
Dialogue: 0,0:09:34.62,0:09:35.69,Dialogue,,0,0,0,,Сіздің әніңіз, яғни.
Dialogue: 0,0:09:37.87,0:09:39.04,Dialogue,,0,0,0,,Жарайды, кейін кездесеміз.
Dialogue: 0,0:09:44.83,0:09:46.69,Dialogue,,0,0,0,,Тағам үшін рахмет!
Dialogue: 0,0:09:51.35,0:09:53.68,Dialogue-italic,,0,0,0,,Бұл жақсы, сіз білесіз. Сіздің әніңіз, яғни.
Dialogue: 0,0:09:54.78,0:09:59.19,Dialogue-italic,,0,0,0,,Егер мен көп жаттығу жасасам, ол сияқты ән айта аламын ба деп ойлаймын.
Dialogue: 0,0:10:03.55,0:10:05.17,Dialogue-italic,,0,0,0,,Асу!
Dialogue: 0,0:10:05.81,0:10:10.00,Dialogue,,0,0,0,,Асу! Асу! Бұл қайтадан дауыс!
Dialogue: 0,0:10:16.45,0:10:19.53,Dialogue,,0,0,0,,Бәрі жақсы, Они-чан. Мұқият тыңдаңыз.
Dialogue: 0,0:10:16.45,0:10:20.80,INSERT SONGS 5000,,0,0,0,,Жарқыраған, жарқыраған,
Dialogue: 0,0:10:20.80,0:10:24.36,INSERT SONGS 5000,,0,0,0,,күн сәулесімен рахаттану.
Dialogue: 0,0:10:24.36,0:10:28.04,INSERT SONGS 5000,,0,0,0,,Осылайша.
Dialogue: 0,0:10:28.04,0:10:34.17,INSERT SONGS 5000,,0,0,0,,Сыбырлаған жүрек
Dialogue: 0,0:10:34.64,0:10:36.97,INSERT SONGS 5000,,0,0,0,,жаз туралы естелік.
Dialogue: 0,0:10:37.48,0:10:39.86,INSERT SONGS 5000,,0,0,0,,Осылайша.
Dialogue: 0,0:10:21.81,0:10:23.95,Dialogue,,0,0,0,,Дауыс ән айтып тұр?
Dialogue: 0,0:10:23.95,0:10:25.00,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:10:28.02,0:10:29.97,Dialogue,,0,0,0,,Бұл өте әдемі дауыс.
Dialogue: 0,0:10:30.78,0:10:34.20,Dialogue-italic,,0,0,0,,Мен мұны ертерек байқасам ғой.
Dialogue: 0,0:10:34.56,0:10:37.66,Dialogue-italic,,0,0,0,,Бұл өте әдемі ән.
Dialogue: 0,0:10:41.79,0:10:44.77,Dialogue,,0,0,0,,Қайырлы кеш. Мен сені мазаладым ба?
Dialogue: 0,0:10:45.40,0:10:48.14,Dialogue,,0,0,0,,Мүлдем емес, тамаша ән болды.
Dialogue: 0,0:10:48.14,0:10:51.56,Dialogue,,0,0,0,,Қайырлы кеш. Мен Асудың үлкен әпкесі Ямада Кёумын.
Dialogue: 0,0:10:51.56,0:10:53.16,Dialogue,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:10:53.60,0:10:55.29,Dialogue,,0,0,0,,S-Бұл жерде де солай.
Dialogue: 0,0:11:01.20,0:11:03.28,Dialogue,,0,0,0,,Күн суытып кеткен сияқты, солай емес пе?
Dialogue: 0,0:11:05.05,0:11:07.38,Dialogue,,0,0,0,,Менің бүгінгі күнім осы ғана сияқты.
Dialogue: 0,0:11:14.02,0:11:15.40,Dialogue,,0,0,0,,Олай болса, қайырлы түн.
Dialogue: 0,0:11:17.49,0:11:19.04,Dialogue,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:11:41.36,0:11:43.41,Dialogue-italic,,0,0,0,,Маған үйге барып, ән айту керек!
Dialogue: 0,0:11:43.97,0:11:47.04,Dialogue-italic,,0,0,0,,Мен бір күні Ичинокура-сан сияқты ән айта аламын ба деп ойлаймын.
Dialogue: 0,0:11:47.04,0:11:48.86,Dialogue-italic,,0,0,0,,Бұл мүмкін емес деп ойлаймын.
Dialogue: 0,0:11:49.95,0:11:52.96,Dialogue,,0,0,0,,О, бұл Ичинокура-сан.
Dialogue: 0,0:11:53.82,0:11:55.19,Dialogue,,0,0,0,,Қайырлы күн!
Dialogue: 0,0:11:55.19,0:11:57.84,Dialogue,,0,0,0,,Қайырлы күн, Асу.
Dialogue: 0,0:12:03.54,0:12:05.14,Dialogue,,0,0,0,,Үйге бара жатырсыз ба?
Dialogue: 0,0:12:05.61,0:12:09.14,Dialogue,,0,0,0,,Иә, мен ән айтуға жаттығуға барамын...
Dialogue: 0,0:12:17.22,0:12:19.40,Dialogue,,0,0,0,,Мм, егер сізге жараса...
Dialogue: 0,0:12:20.16,0:12:25.35,Dialogue,,0,0,0,,Маған үйретші... Ән айтуды үйретші. Өтінемін!
Dialogue: 0,0:12:26.37,0:12:28.65,Dialogue,,0,0,0,,Біз мектепте ән айтудан емтихан тапсыруымыз керек...
Dialogue: 0,0:12:28.65,0:12:33.23,Dialogue,,0,0,0,,Бұл мүмкін емес шығар, сондықтан бас тартсаңыз жақсы.
Dialogue: 0,0:12:33.23,0:12:34.17,Dialogue,,0,0,0,,Бірақ…
Dialogue: 0,0:12:36.93,0:12:37.64,Dialogue,,0,0,0,,Әрине.
Dialogue: 0,0:12:39.39,0:12:44.40,Dialogue,,0,0,0,,Сіз шынымен солай етесіз бе? Сізге көп рахмет!
Dialogue: 0,0:12:46.28,0:12:48.73,Dialogue,,0,0,0,,Олай болса, бастайық.
Dialogue: 0,0:12:48.73,0:12:50.75,Dialogue,,0,0,0,,Музыка ойнай алатын нәрсе әкелдіңіз бе?
Dialogue: 0,0:12:51.56,0:12:52.73,Dialogue,,0,0,0,,Um…
Dialogue: 0,0:12:53.99,0:12:55.92,Dialogue,,0,0,0,,Мелодика, иә?
Dialogue: 0,0:12:57.29,0:12:59.07,Dialogue,,0,0,0,,Менің ойымша, бұл жеткілікті жақсы.
Dialogue: 0,0:12:59.57,0:13:01.64,Dialogue,,0,0,0,,Онымен бірдей дыбыстарды шығарып көріңіз.
Dialogue: 0,0:13:02.31,0:13:02.89,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:13:03.89,0:13:05.31,Dialogue,,0,0,0,,Do!
Dialogue: 0,0:13:05.93,0:13:07.77,Dialogue,,0,0,0,,Re!
Dialogue: 0,0:13:07.77,0:13:09.47,Dialogue,,0,0,0,,Mi!
Dialogue: 0,0:13:13.21,0:13:16.81,Dialogue,,0,0,0,,Иә? Ол Fa және La дыбыстарын шығармайды.
Dialogue: 0,0:13:17.49,0:13:21.28,Dialogue,,0,0,0,,Бұл менің әпкемнің қолымен жасалған, аздап бүлінген.
Dialogue: 0,0:13:21.82,0:13:25.78,Dialogue,,0,0,0,,Сіз анаңыздан жаңасын сатып алуды сұрай алмайсыз ба?
Dialogue: 0,0:13:26.44,0:13:30.56,Dialogue,,0,0,0,,Бізде… анамыз… не әкеміз жоқ.
Dialogue: 0,0:13:31.72,0:13:34.58,Dialogue,,0,0,0,,Бұл пәтерде екеуің тұрып жатырсыңдар ма?
Dialogue: 0,0:13:34.58,0:13:35.37,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:13:38.01,0:13:40.63,Dialogue,,0,0,0,,Кешіріңіз. Мен білмеген едім.
Dialogue: 0,0:13:42.22,0:13:45.37,Dialogue,,0,0,0,,Бәрі жақсы! Менің әпкем әлі бар.
Dialogue: 0,0:13:45.64,0:13:49.14,Dialogue,,0,0,0,,Ум, мен көмектесе алатын бірдеңе болса, сұраңыз.
Dialogue: 0,0:13:49.69,0:13:52.84,Dialogue,,0,0,0,,Бірақ сіз маған ән айтуды үйретіп жатырсыз,
Dialogue: 0,0:13:52.84,0:13:54.30,Dialogue,,0,0,0,,s-so…
Dialogue: 0,0:13:57.90,0:14:00.52,Dialogue,,0,0,0,,Мен сенің әніңді тыңдағым келеді.
Dialogue: 0,0:14:17.61,0:14:20.99,Dialogue,,0,0,0,,Жарайды, маған қалдырыңыз. Мен саған кез келген уақытта ән айтамын.
Dialogue: 0,0:14:29.53,0:14:32.71,Dialogue,,0,0,0,,Әнді күйге келтіріп, дұрыс айта білу,
Dialogue: 0,0:14:33.36,0:14:35.29,Dialogue,,0,0,0,,күшті бұлшықеттер өте маңызды!
Dialogue: 0,0:14:35.60,0:14:36.26,Dialogue,,0,0,0,,Жарайды!
Dialogue: 0,0:14:39.31,0:14:40.57,Dialogue,,0,0,0,,Бір!
Dialogue: 0,0:14:40.57,0:14:41.34,Dialogue,,0,0,0,,Екі!
Dialogue: 0,0:14:41.81,0:14:42.72,Dialogue,,0,0,0,,Үш!
Dialogue: 0,0:14:42.98,0:14:45.98,Dialogue,,0,0,0,,Тағы да, диафрагманы пайдаланып! Хоо!
Dialogue: 0,0:14:41.34,0:14:45.41,Dialogue-italic,,0,0,0,,Содан бері Ичинокура-санның басшылығымен және көмегімен
Dialogue: 0,0:14:45.41,0:14:47.43,Dialogue-italic,,0,0,0,,Мен ән айтуды жалғастырдым.
Dialogue: 0,0:14:51.38,0:14:52.90,Dialogue-italic,,0,0,0,,Оне-чан да жаттықты.
Dialogue: 0,0:14:53.82,0:14:54.79,Dialogue,,0,0,0,,Жиырма бес!
Dialogue: 0,0:14:55.53,0:14:56.82,Dialogue,,0,0,0,,Жиырма алты!
Dialogue: 0,0:14:54.79,0:14:56.82,Dialogue,,0,0,0,,Жалғастыр, Асу!
Dialogue: 0,0:15:07.10,0:15:15.82,Dialogue,,0,0,0,song,Көктемнің кішкентай бұлағы шулайды,
Dialogue: 0,0:15:15.82,0:15:24.54,Dialogue,,0,0,0,song,оның жағасындағы шегіргүлдер мен лотос гүлдерін айналып өту.
Dialogue: 0,0:15:24.54,0:15:33.19,Dialogue,,0,0,0,song,Мейірімді келбеті мен әдемі түстерімен,
Dialogue: 0,0:15:33.19,0:15:42.66,Dialogue,,0,0,0,song,ол оларға: «Гүлдеңдер!
Dialogue: 0,0:15:46.90,0:15:49.53,Dialogue,,0,0,0,,Міне. Өте жақсы орындадың.
Dialogue: 0,0:15:49.53,0:15:50.27,Dialogue,,0,0,0,,Жарайды!
Dialogue: 0,0:15:53.13,0:15:55.39,Dialogue,,0,0,0,,Асу-чан, бұл өте керемет болды!
Dialogue: 0,0:15:55.39,0:15:57.74,Dialogue,,0,0,0,,Сен қалай жақсы ән айта аласың?
Dialogue: 0,0:15:59.26,0:16:01.65,Dialogue,,0,0,0,,Менің жақсы мұғалімім болды деп ойлаймын.
Dialogue: 0,0:16:07.20,0:16:09.05,Dialogue,,0,0,0,,Сен істедің, Асу!
Dialogue: 0,0:16:12.15,0:16:13.78,Dialogue,,0,0,0,,Рахмет, Они-чан.
Dialogue: 0,0:16:13.78,0:16:16.75,Dialogue,,0,0,0,,Біз де Ичинокура-санға айтуымыз керек.
Dialogue: 0,0:16:16.75,0:16:19.52,Dialogue,,0,0,0,,Аа, дұрыс. Барайық.
Dialogue: 0,0:16:24.00,0:16:27.24,Dialogue,,0,0,0,,Ичинокура-сан! Мен сынақтан өте жақсы өттім!
Dialogue: 0,0:16:31.25,0:16:32.67,Dialogue,,0,0,0,,Мүмкін ол үйде жоқ шығар?
Dialogue: 0,0:16:33.50,0:16:35.51,Dialogue,,0,0,0,,Мен оның жақын арада оралатынына сенімдімін.
Dialogue: 0,0:16:42.41,0:16:45.52,Dialogue,,0,0,0,,Ол әлі оралмаған сияқты.
Dialogue: 0,0:16:48.74,0:16:51.34,Dialogue-italic,,0,0,0,,Бір апта өтті,
Dialogue: 0,0:16:51.34,0:16:54.20,Dialogue-italic,,0,0,0,,және Ичинокура-сан әлі оралған жоқ.
Dialogue: 0,0:16:56.02,0:16:58.26,Dialogue,,0,0,0,,Ичинокура-санға не болды деп ойлаймын.
Dialogue: 0,0:17:00.94,0:17:04.84,Dialogue,,0,0,0,,Масао! Сіз сондасыз ба, Масао?
Dialogue: 0,0:17:06.24,0:17:07.51,Dialogue,,0,0,0,,Масао?
Dialogue: 0,0:17:10.07,0:17:10.91,Dialogue,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:17:11.73,0:17:13.71,Dialogue,,0,0,0,,Не? Сен кімсің?
Dialogue: 0,0:17:14.65,0:17:15.57,Dialogue,,0,0,0,,Um…
Dialogue: 0,0:17:16.21,0:17:17.85,Dialogue,,0,0,0,,Біз оның көршіміз.
Dialogue: 0,0:17:17.85,0:17:21.84,Dialogue,,0,0,0,,Ичинокура-сан апта бойы үйге келмеді.
Dialogue: 0,0:17:21.84,0:17:23.25,Dialogue,,0,0,0,,Сіз одан бірдеңе естідіңіз бе?
Dialogue: 0,0:17:23.46,0:17:24.65,Dialogue,,0,0,0,,Қалай!
Dialogue: 0,0:17:25.82,0:17:30.47,Dialogue,,0,0,0,,Біз оған келесі тыңдауға дейін көмектесетінімізді айттық, бірақ ол бізді тастап кеткен сияқты.
Dialogue: 0,0:17:30.97,0:17:34.30,Dialogue,,0,0,0,,Бұл жолы бар күшімді саламын десе де!
Dialogue: 0,0:17:35.95,0:17:40.53,Dialogue,,0,0,0,,Сосын, ол маған өзінің сүйікті гитарасын сатқанын айтқан кезде…
Dialogue: 0,0:17:40.53,0:17:45.18,Dialogue,,0,0,0,,Сіз оны ешқашан сатпайтынын білесіз! Масао-сан бұл гитараны өз өмірінен артық бағалайды.
Dialogue: 0,0:17:46.30,0:17:48.01,Dialogue-italic,,0,0,0,,Міне, солай болды.
Dialogue: 0,0:17:53.04,0:17:55.92,Dialogue-italic,,0,0,0,,Өзінің қиындықтары болса да, ол маған ән айтуды үйретті.
Dialogue: 0,0:17:56.53,0:17:58.51,Dialogue-italic,,0,0,0,,Оның музыкасы өте керемет болды!
Dialogue: 0,0:17:59.35,0:18:00.30,Dialogue-italic,,0,0,0,,Дегенмен…
Dialogue: 0,0:18:02.05,0:18:04.26,Dialogue,,0,0,0,,Мен сенің әніңді тыңдағым келеді.
Dialogue: 0,0:18:04.67,0:18:07.65,Dialogue,,0,0,0,,Жарайды, маған қалдырыңыз. Мен саған кез келген уақытта ән айтамын.
Dialogue: 0,0:18:10.86,0:18:13.60,Dialogue-italic,,0,0,0,,Ол маған уәде берсе де!
Dialogue: 0,0:18:13.60,0:18:18.46,Dialogue-italic,,0,0,0,,Ол маған тағы да ән айтамын деп уәде берді!
Dialogue: 0,0:18:28.45,0:18:30.73,Dialogue,,0,0,0,,Оның әні... Мен оны естимін.
Dialogue: 0,0:18:26.30,0:18:32.32,INSERT SONGS 5000,,0,0,0,,Жеңіл ағады,
Dialogue: 0,0:18:32.60,0:18:35.46,INSERT SONGS 5000,,0,0,0,,жел сыбырлайды.
Dialogue: 0,0:18:35.46,0:18:39.16,INSERT SONGS 5000,,0,0,0,,Осылайша.
Dialogue: 0,0:18:39.64,0:18:45.72,INSERT SONGS 5000,,0,0,0,,Жасыл нұрлы өрістерде,
Dialogue: 0,0:18:45.72,0:18:47.18,INSERT SONGS 5000,,0,0,0,,шақырайық
Dialogue: 0,0:18:31.30,0:18:32.29,Dialogue,,0,0,0,,Оның әні…
Dialogue: 0,0:18:35.35,0:18:36.48,Dialogue,,0,0,0,,Дұрыс айтасыз!
Dialogue: 0,0:18:36.48,0:18:37.53,Dialogue,,0,0,0,,Ол қайда?
Dialogue: 0,0:18:37.53,0:18:38.80,Dialogue,,0,0,0,,Осылайша!
Dialogue: 0,0:18:40.01,0:18:40.88,Dialogue,,0,0,0,,Қайда?
Dialogue: 0,0:18:44.18,0:18:45.37,Dialogue,,0,0,0,,Масао-сан!
Dialogue: 0,0:18:44.96,0:18:46.64,Dialogue,,0,0,0,,Масао-сан!
Dialogue: 0,0:18:47.97,0:18:49.61,Dialogue,,0,0,0,,H-Эй.
Dialogue: 0,0:18:49.89,0:18:51.59,Dialogue,,0,0,0,,Уа, Масао!
Dialogue: 0,0:18:52.10,0:18:53.83,Dialogue,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:18:53.09,0:18:54.75,Dialogue,,0,0,0,,Барлығы сен үшін уайымдады!
Dialogue: 0,0:18:54.75,0:18:55.81,Dialogue,,0,0,0,,Масао-сан.
Dialogue: 0,0:18:56.97,0:18:57.82,Dialogue,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:18:57.82,0:18:59.45,Dialogue,,0,0,0,,Мен жарты күндік жұмысымда түнеп жүрдім.
Dialogue: 0,0:18:59.86,0:19:02.29,Dialogue,,0,0,0,,Мен сізді орынсыз алаңдатқан сияқтымын.
Dialogue: 0,0:19:02.29,0:19:03.86,Dialogue,,0,0,0,,Ақымақ!
Dialogue: 0,0:19:05.04,0:19:06.48,Dialogue,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:19:07.93,0:19:10.28,Dialogue,,0,0,0,,Келесі жолы бізге алдын ала айтыңыз!
Dialogue: 0,0:19:10.93,0:19:11.73,Dialogue,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:12.29,0:19:15.05,Dialogue,,0,0,0,,Ичинокура-санды бәрі жақсы көреді, солай емес пе?
Dialogue: 0,0:19:15.05,0:19:15.74,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:19:17.52,0:19:19.70,Dialogue,,0,0,0,,Менің барлық тыңдауларымды қабылдамаған соң,
Dialogue: 0,0:19:19.70,0:19:23.09,Dialogue,,0,0,0,,Мен музыкант болу мен үшін мүмкін емес шығар деп ойлай бастадым.
Dialogue: 0,0:19:23.71,0:19:27.01,Dialogue,,0,0,0,,Мен ән айтуды біржола тастауды шештім.
Dialogue: 0,0:19:27.58,0:19:28.34,Dialogue,,0,0,0,,Бірақ…
Dialogue: 0,0:19:35.09,0:19:37.98,Dialogue,,0,0,0,,Бірақ мен ән айтуды жалғастырғым келеді.
Dialogue: 0,0:19:38.58,0:19:42.07,Dialogue,,0,0,0,,Сондықтан мен толық емес жұмыс күнін таптым, сондықтан мен гитарамды қайтарып алуға мүмкіндігім болды.
Dialogue: 0,0:19:44.27,0:19:45.16,Dialogue,,0,0,0,,Оның гитарасы…
Dialogue: 0,0:19:54.78,0:19:56.32,Dialogue,,0,0,0,,Өйткені мен уәде бердім.
Dialogue: 0,0:19:56.32,0:19:59.14,Dialogue,,0,0,0,,Сізге тағы да ән айтамын деген уәде.
Dialogue: 0,0:20:22.30,0:20:28.22,INSERT SONGS 5000,,0,0,0,,Жеңіл ағады,
Dialogue: 0,0:20:28.36,0:20:31.22,INSERT SONGS 5000,,0,0,0,,жел сыбырлайды.
Dialogue: 0,0:20:31.30,0:20:35.08,INSERT SONGS 5000,,0,0,0,,Осылайша.
Dialogue: 0,0:20:35.74,0:20:41.66,INSERT SONGS 5000,,0,0,0,,Жасыл нұрлы өрістерде,
Dialogue: 0,0:20:41.88,0:20:44.76,INSERT SONGS 5000,,0,0,0,,көктемді шақырайық.
Dialogue: 0,0:20:45.18,0:20:47.98,INSERT SONGS 5000,,0,0,0,,Осылайша.
Dialogue: 0,0:20:48.96,0:20:54.84,INSERT SONGS 5000,,0,0,0,,Жарқыраған, жарқыраған,
Dialogue: 0,0:20:55.28,0:20:57.94,INSERT SONGS 5000,,0,0,0,,күн сәулесімен қызу.
Dialogue: 0,0:20:57.94,0:21:01.76,INSERT SONGS 5000,,0,0,0,,Осылайша.
Dialogue: 0,0:21:01.76,0:21:08.12,INSERT SONGS 5000,,0,0,0,,Сыбырлаған жүрек
Dialogue: 0,0:21:08.40,0:21:11.17,INSERT SONGS 5000,,0,0,0,,жаз туралы естелік.
Dialogue: 0,0:21:11.17,0:21:14.70,INSERT SONGS 5000,,0,0,0,,Осылайша.
Dialogue: 0,0:20:26.53,0:20:28.05,Dialogue-italic,,0,0,0,,Мен ән айтамын.
Dialogue: 0,0:20:28.05,0:20:32.13,Dialogue-italic,,0,0,0,,Мен мұны істей аламын. Менің қолымнан келетін жалғыз нәрсе.
Dialogue: 0,0:20:33.65,0:20:35.05,Dialogue-italic,,0,0,0,,Музыка жұмбақ.
Dialogue: 0,0:20:35.64,0:20:37.81,Dialogue-italic,,0,0,0,,Әрбір нотаның ырғағы мен ағынымен,
Dialogue: 0,0:20:38.53,0:20:41.80,Dialogue-italic,,0,0,0,,Көңілім көтерілгенін сеземін.
Dialogue: 0,0:20:43.74,0:20:47.08,Dialogue-italic,,0,0,0,,Сондықтан мен ән айтуды жалғастырамын.
Dialogue: 0,0:20:57.21,0:21:01.35,Dialogue-italic,,0,0,0,,Сондықтан мен осында мәңгі қалғым келеді.
Dialogue: 0,0:21:01.77,0:21:03.71,Dialogue-italic,,0,0,0,,Мен Они Чанмен бар күшімді саламын.
Dialogue: 0,0:21:08.21,0:21:11.15,Dialogue-italic,,0,0,0,,Осылайша біз әрқашан музыканы ести аламыз.
Dialogue: 0,0:22:57.56,0:22:59.74,Dialogue,,0,0,0,,Асу ұтыс ойынында ұялы телефон ұтып алды.
Dialogue: 0,0:22:59.74,0:23:00.90,Dialogue,,0,0,0,,Оны мұқият пайдаланыңыз!
Dialogue: 0,0:23:01.14,0:23:03.73,Dialogue,,0,0,0,,Они-чан, сен неге телефоныңды көтермейсің?
Dialogue: 0,0:23:04.25,0:23:05.91,Dialogue,,0,0,0,,Бейшара апалардың әңгімесі:
Dialogue: 0,0:23:05.91,0:23:08.64,Dialogue,,0,0,0,,«Эмоциялар, мазасыздықтар және ұялы телефондар күні».
Dialogue: 0,0:23:08.64,0:23:09.95,Dialogue,,0,0,0,,Көріңіз!
