Dialogue: 0,0:24:08.42,0:24:09.30,Default,,0000,0000,0000,,

Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.09,0:00:08.41,OS,,0000,0000,0000,,Мен бұл қаланы жек көремін
Dialogue: 0,0:00:11.02,0:00:13.36,OS,,0000,0000,0000,,Өйткені бұл мен ұмытқым келетін естеліктерге толы жер.
Dialogue: 0,0:00:17.41,0:00:22.59,OS,,0000,0000,0000,,Мен күнде мектепке барамын, достарыммен араласамын, үйге барғым келмейтін үйге барамын.
Dialogue: 0,0:00:24.35,0:00:27.46,OS,,0000,0000,0000,,Егер жағдай осылай жалғаса берсе, бір күні бірдеңе өзгере ме?
Dialogue: 0,0:00:30.41,0:00:32.03,OS,,0000,0000,0000,,Ол өзгере ме?
Dialogue: 0,0:00:49.40,0:00:50.13,Default,,0000,0000,0000,,Анпан!
Dialogue: 0,0:00:52.05,0:00:53.98,Default,,0000,0000,0000,,Сізге бұл мектеп ұнай ма?
Dialogue: 0,0:00:54.95,0:00:57.42,Default,,0000,0000,0000,,Маған өте, өте ұнайды.
Dialogue: 0,0:00:57.96,0:01:01.76,Default,,0000,0000,0000,,Бірақ бәрі... бұрынғыша қалуы мүмкін емес.
Dialogue: 0,0:01:02.87,0:01:04.16,OS,,0000,0000,0000,,Белгісіз студент қыз
Dialogue: 0,0:01:05.10,0:01:07.00,OS,,0000,0000,0000,,Бұл сөздер маған арналмаған.
Dialogue: 0,0:01:07.92,0:01:11.30,OS,,0000,0000,0000,,Мүмкін ол жүрегінде біреумен сөйлесіп тұрған шығар.
Dialogue: 0,0:01:12.10,0:01:15.10,Default,,0000,0000,0000,,Қызықты нәрселер, қуанышты нәрселер, бәрі...
Dialogue: 0,0:01:16.38,0:01:18.77,Default,,0000,0000,0000,,Бәрі өзгермейді.
Dialogue: 0,0:01:19.32,0:01:22.10,Default,,0000,0000,0000,,Сіз бұл жерді әлі де жақсы көре аласыз ба?
Dialogue: 0,0:01:24.07,0:01:25.18,Default,,0000,0000,0000,,Тек оны табыңыз.
Dialogue: 0,0:01:37.50,0:01:41.44,Default,,0000,0000,0000,,Тек келесі қызықты нәрсені немесе сізді бақытты ететін нәрсені табыңыз.
Dialogue: 0,0:01:44.21,0:01:45.52,Default,,0000,0000,0000,,Жүр, кеттік.
Dialogue: 0,0:01:51.58,0:01:53.26,OS,,0000,0000,0000,,Біз көтеріле бастаймыз
Dialogue: 0,0:01:55.03,0:01:58.42,OS,,0000,0000,0000,,Ұзын, ұзын еңіс
Dialogue: 0,0:03:32.42,0:03:34.32,Default,,0000,0000,0000,,Рамуне туралы естеліктерді еске түсіретін бір нәрсе бар, солай ма?
Dialogue: 0,0:03:38.73,0:03:39.54,Default,,0000,0000,0000,,Өзіңіз үйленетін адамға келсек—
Dialogue: 0,0:03:39.79,0:03:41.88,Default,,0000,0000,0000,,Сунохара, тәубеге келдің бе?
Dialogue: 0,0:03:42.18,0:03:44.78,Default,,0000,0000,0000,,Күн сайын қатты дыбыспен CD ойнатыңыз!
Dialogue: 0,0:03:45.04,0:03:47.96,Default,,0000,0000,0000,,Жоқ, бірақ мен оны тыңдамасам, мен күйге түспеймін.
Dialogue: 0,0:03:47.98,0:03:48.81,Default,,0000,0000,0000,,Scrum!
Dialogue: 0,0:03:50.94,0:03:52.89,Default,,0000,0000,0000,,Күн сайын қолыңыздан келгеннің бәрін жасаңыз.
Dialogue: 0,0:03:53.07,0:03:55.25,Default,,0000,0000,0000,,Оказаки, маған қарама және көмектес!
Dialogue: 0,0:03:55.78,0:03:56.96,Default,,0000,0000,0000,,Маған ұнамайды, өйткені мен ақымақпын.
Dialogue: 0,0:03:57.17,0:03:59.00,Default,,0000,0000,0000,,Сіз шынымен де жүрексіз екенсіз!
Dialogue: 0,0:04:16.17,0:04:17.65,Default,,0000,0000,0000,,Якамаши!
Dialogue: 0,0:04:18.94,0:04:20.52,Default,,0000,0000,0000,,Сабыр етіңіз!
Dialogue: 0,0:04:23.03,0:04:24.01,Default,,0000,0000,0000,,Такумо!
Dialogue: 0,0:04:24.75,0:04:27.41,Default,,0000,0000,0000,,Көршілерден шағым түсетін адаммын.
Dialogue: 0,0:04:27.97,0:04:29.93,OS,,0000,0000,0000,,Жатақханадағы ана болу да қиын жұмыс.
Dialogue: 0,0:04:30.41,0:04:33.79,Default,,0000,0000,0000,,Мисэ-сан, маған тезірек көмектес!
Dialogue: 0,0:04:34.33,0:04:36.26,Default,,0000,0000,0000,,Менің ойымша, бұл сіздің де кінәлі.
Dialogue: 0,0:04:36.50,0:04:38.61,Default,,0000,0000,0000,,Осыдан сабақ алып, аздап ойланыңыз.
Dialogue: 0,0:04:38.84,0:04:39.53,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:04:41.41,0:04:43.47,Default,,0000,0000,0000,,Қарғыс атсын...регби клубы...
Dialogue: 0,0:04:44.06,0:04:46.23,Default,,0000,0000,0000,,Даусыңыз соншалықты төмен болса, сіз оны ести алмайсыз.
Dialogue: 0,0:04:46.77,0:04:48.87,Default,,0000,0000,0000,,Қарғыс атсын! Регби клубы!
Dialogue: 0,0:04:49.43,0:04:50.73,Default,,0000,0000,0000,,Қазір кім!?
Dialogue: 0,0:04:50.99,0:04:51.60,Default,,0000,0000,0000,,Өзіңіз үйленетін адамға келсек—
Dialogue: 0,0:04:52.39,0:04:53.83,Default,,0000,0000,0000,,Сіз мені өлтірмекшісіз бе?
Dialogue: 0,0:04:54.25,0:04:55.85,Default,,0000,0000,0000,,Сіз тым ашулы екенсіз
Dialogue: 0,0:04:56.00,0:04:58.35,Default,,0000,0000,0000,,Тіпті мен жеке-жеке жағдайда кері шегінбеймін.
Dialogue: 0,0:04:58.67,0:05:00.37,Default,,0000,0000,0000,,Бірақ қарсыластар өте көп, солай емес пе?
Dialogue: 0,0:05:00.81,0:05:01.61,Default,,0000,0000,0000,,Қараңдаршы.
Dialogue: 0,0:05:01.91,0:05:04.82,Default,,0000,0000,0000,,Оқуыңды бітірейін деп жатқанда, мен саған үлкен ақша төлеймін.
Dialogue: 0,0:05:05.10,0:05:08.45,Default,,0000,0000,0000,,Олай болса, Оказаки, мен саған арқамды қалдырамын!
Dialogue: 0,0:05:08.88,0:05:10.53,Default,,0000,0000,0000,,Бақытты, алданба
Dialogue: 0,0:05:10.57,0:05:11.73,Default,,0000,0000,0000,,Келме! Бар!
Dialogue: 0,0:05:11.90,0:05:13.98,Default,,0000,0000,0000,,Себебі мен регби командасының жағындамын, солай ма?
Dialogue: 0,0:05:13.98,0:05:14.77,Default,,0000,0000,0000,,Қашаннан бері!?
Dialogue: 0,0:05:14.94,0:05:15.92,Default,,0000,0000,0000,,Жоқ, тек сол уақытта
Dialogue: 0,0:05:16.11,0:05:17.44,Default,,0000,0000,0000,,Тыныш болыңыз!
Dialogue: 0,0:05:17.45,0:05:17.97,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:05:20.98,0:05:22.00,Default,,0000,0000,0000,,Мен сені артқа жіберейін бе?
Dialogue: 0,0:05:22.07,0:05:23.22,Default,,0000,0000,0000,,Иииияаааааааааааааааааааааа
Dialogue: 0,0:05:24.02,0:05:27.88,OS,,0000,0000,0000,,Дәл солай, бүгінде ешкімге ұқсамайтын тағы бір күн аяқталады.
Dialogue: 0,0:05:27.99,0:05:28.93,Default,,0000,0000,0000,,Жаман шай
Dialogue: 0,0:05:29.27,0:05:30.24,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:05:30.53,0:05:35.13,OS,,0000,0010,0000,,Менің мақсатым немесе мен ынталы нәрсе жоқ.
Dialogue: 0,0:05:35.54,0:05:36.07,Default,,0000,0000,0000,,Өйткені мен табынамын
Dialogue: 0,0:05:36.79,0:05:38.00,Default,,0000,0000,0000,,Маған табынсаң да, шықпаймын!
Dialogue: 0,0:05:36.07,0:05:37.80,OS,,0000,0000,0000,,Нопперабу күні...
Dialogue: 0,0:05:40.50,0:05:42.77,OS,,0000,0000,0000,,Бұл біткен дүние
Dialogue: 0,0:05:44.11,0:05:46.56,OS,,0000,0000,0000,,Ештеңе тумайды, ештеңе өлмейді
Dialogue: 0,0:05:47.28,0:05:49.52,OS,,0000,0000,0000,,Өтіп бара жатқан уақыт та жоқ
Dialogue: 0,0:05:50.64,0:05:56.60,OS,,0000,0000,0000,,Туған жерді іздесем, бұл дүниені таңдамау керек деп ойладым.
Dialogue: 0,0:05:59.22,0:06:00.77,OS,,0000,0000,0000,,Бұл дүниеде адамдар болған
Dialogue: 0,0:06:02.42,0:06:03.96,OS,,0000,0000,0000,,Сіз мені көре аласыз ба?
Dialogue: 0,0:06:05.08,0:06:07.10,OS,,0000,0000,0000,,Мен бұл дүниеде туған жоқпын
Dialogue: 0,0:06:10.23,0:06:13.11,OS,,0000,0000,0000,,Ақырғы дүниеде жалғыз тұратын қыз
Dialogue: 0,0:06:15.71,0:06:19.07,OS,,0000,0000,0000,,Бос, статикалық әлемде өмір сүретін қыз
Dialogue: 0,0:06:20.95,0:06:24.36,OS,,0000,0000,0000,,Неге екені белгісіз, маған қызық болды.
Dialogue: 0,0:06:32.16,0:06:34.63,Default,,0000,0000,0000,,Оказаки мен Сунохара әлі келген жоқ.
Dialogue: 0,0:06:35.18,0:06:36.63,Default,,0000,0000,0000,,Олар не істемекші?
Dialogue: 0,0:06:36.75,0:06:38.03,Default,,0000,0000,0000,,Мансап жолы немесе түсу емтиханы?
Dialogue: 0,0:06:38.32,0:06:39.57,Default,,0000,0000,0000,,Үш жыл болды
Dialogue: 0,0:06:39.71,0:06:40.71,Default,,0000,0000,0000,,Оны жай қалдырыңыз
Dialogue: 0,0:06:41.01,0:06:44.10,Default,,0000,0000,0000,,Бос уақыты бар адамдарға көңіл бөлуге шамамыз жоқ.
Dialogue: 0,0:06:43.46,0:06:43.84,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:06:51.22,0:06:53.23,Default,,0000,0000,0000,,Ах, мм... Оказаки-кун...
Dialogue: 0,0:06:53.47,0:06:55.95,Default,,0000,0000,0000,,Иә? Бұл не, Фудзибаяши?
Dialogue: 0,0:06:56.48,0:06:58.79,Default,,0000,0000,0000,,Оказаки-кун, сен бүгін тағы кешігіп қалдың.
Dialogue: 0,0:06:58.96,0:06:59.57,Default,,0000,0000,0000,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:00.06,0:07:04.10,Default,,0000,0000,0000,,Мм...Меніңше күнде мектепке барған дұрыс.
Dialogue: 0,0:07:04.35,0:07:07.60,Default,,0000,0000,0000,,Әй, сен сыныптағыдай сөйлеп тұрсың.
Dialogue: 0,0:07:07.83,0:07:11.85,Default,,0000,0000,0000,,Мен-мен ондай емеспін, мен сынып төрағасымын...
Dialogue: 0,0:07:12.16,0:07:14.42,Default,,0000,0000,0000,,Эй Оказаки, төраға, мені жылатпа.
Dialogue: 0,0:07:14.58,0:07:15.96,Default,,0000,0000,0000,,Менің әпкем ұшып келе жатыр.
Dialogue: 0,0:07:16.33,0:07:18.52,Default,,0000,0000,0000,,...Жарайды...Мен жыламаймын...
Dialogue: 0,0:07:18.87,0:07:22.39,Default,,0000,0000,0000,,Жарайды, ертеңгі көңіл-күйіме байланысты...
Dialogue: 0,0:07:22.84,0:07:26.18,Default,,0000,0000,0000,,Олай болса...мм, ертеңгі жағдайды айтамын.
Dialogue: 0,0:07:26.38,0:07:28.00,Default,,0000,0000,0000,,Өйткені көріпкелдік менің хоббиім.
Dialogue: 0,0:07:31.55,0:07:32.64,Default,,0000,0000,0000,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:07:33.11,0:07:35.43,Default,,0000,0000,0000,,...Оказаки-кун, ертең кешігесің.
Dialogue: 0,0:07:37.20,0:07:38.75,Default,,0000,0000,0000,,Сіз ұрыс таңдауға тырысып жатырсыз ба?
Dialogue: 0,0:07:38.90,0:07:42.32,Default,,0000,0000,0000,,Бұл картада, сондықтан менің ойымша, бұл сәуегейліктің бір түрі.
Dialogue: 0,0:07:42.51,0:07:43.80,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:07:44.08,0:07:48.76,Default,,0000,0000,0000,,Мен мектепке барар жолда мейірімді әйелмен романтикалық кездесіп қалдым.
Dialogue: 0,0:07:49.07,0:07:52.42,Default,,0000,0000,0000,,Уақыттың өткенін ұмытып, кешігіп қаламын.
Dialogue: 0,0:07:52.60,0:07:54.44,Default,,0000,0000,0000,,Бұл өте ерекше.
Dialogue: 0,0:07:54.63,0:07:56.83,Default,,0000,0000,0000,,О, қыздың шабыты.
Dialogue: 0,0:07:56.95,0:07:58.60,Default,,0000,0000,0000,,Кола Томоя Оказаки!
Dialogue: 0,0:08:03.04,0:08:04.04,Default,,0000,0000,0000,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:08:04.41,0:08:04.98,Default,,0000,0000,0000,,Бір…
Dialogue: 0,0:08:06.15,0:08:10.78,Default,,0000,0000,0000,,Менің әпкемді қорлауға батылыңыз жетпейді!
Dialogue: 0,0:08:11.00,0:08:12.93,Default,,0000,0000,0000,,Біз аздап сөйлесіп тұрған шығармыз!
Dialogue: 0,0:08:13.03,0:08:15.68,Default,,0000,0000,0000,,Дұрыс, апа, мені қорлап жатқан жоқ.
Dialogue: 0,0:08:17.36,0:08:19.85,Default,,0000,0000,0000,,Хмм, жақсы.
Dialogue: 0,0:08:20.95,0:08:23.90,Default,,0000,0000,0000,,Иә? Сіздің байлығыңызды Муку айтты ма?
Dialogue: 0,0:08:24.16,0:08:28.33,Default,,0000,0000,0000,,Аа, ертең мен бір мейірімді әйелмен романтикалық кездесуім болады.
Dialogue: 0,0:08:29.12,0:08:30.43,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:08:31.13,0:08:32.30,Default,,0000,0000,0000,,Бұл қандай бет?
Dialogue: 0,0:08:32.57,0:08:35.45,Default,,0000,0000,0000,,Шынында да. Іске сәт!
Dialogue: 0,0:08:36.54,0:08:39.04,Default,,0000,0000,0000,,Ахаха ахаха
Dialogue: 0,0:08:43.57,0:08:45.82,Default,,0000,0000,0000,,Енді қай жерде тамақтанамыз?
Dialogue: 0,0:08:46.48,0:08:47.25,Default,,0000,0000,0000,,Елес пе?
Dialogue: 0,0:08:48.10,0:08:51.95,Default,,0000,0000,0000,,Жол-көлік оқиғасына ұшыраған студент қыздың елесі пайда болады.
Dialogue: 0,0:08:52.28,0:08:53.45,Default,,0000,0000,0000,,Мен қателестім бе?
Dialogue: 0,0:08:53.60,0:08:54.74,Default,,0000,0000,0000,,Бұл рас...
Dialogue: 0,0:08:53.87,0:08:54.73,OS,,0000,0000,0000,,Елес...
Dialogue: 0,0:08:54.74,0:08:55.83,Default,,0000,0000,0000,,Ол өте сүйкімді қыз сияқты.
Dialogue: 0,0:08:59.84,0:09:01.47,Default,,0000,0000,0000,,Эй, сен жалғызсың ба?
Dialogue: 0,0:09:02.70,0:09:04.62,Default,,0000,0000,0000,,Мен сыныпта достарыммен бірге тамақтансам екен.
Dialogue: 0,0:09:07.15,0:09:07.77,OS,,0000,0000,0000,,Анпан?
Dialogue: 0,0:09:08.60,0:09:09.86,Default,,0000,0000,0000,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:09:10.10,0:09:13.61,Default,,0000,0000,0000,,Кешіріңіз...Мен қазір тамақтанып жатырмын.
Dialogue: 0,0:09:15.06,0:09:15.51,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:09:32.34,0:09:34.37,Default,,0000,0000,0000,,...Мм, бұл не?
Dialogue: 0,0:09:34.72,0:09:37.92,Default,,0000,0000,0000,,Неге мұндай жерде түскі асты жалғыз ішесің?
Dialogue: 0,0:09:39.42,0:09:42.06,Default,,0000,0000,0000,,Сізге бұл мектеп ұнай ма?
Dialogue: 0,0:09:43.17,0:09:44.35,Default,,0000,0000,0000,,Жоқ, айтайық...
Dialogue: 0,0:09:44.70,0:09:47.23,Default,,0000,0000,0000,,Маған бұл өте ұнайды.
Dialogue: 0,0:09:47.57,0:09:51.18,Default,,0000,0000,0000,,Бұрын сөйлесетін адамдарым, жақын араласатын мұғалімдерім болатын.
Dialogue: 0,0:09:51.47,0:09:52.87,Default,,0000,0000,0000,,Бірақ қазір...
Dialogue: 0,0:09:53.38,0:09:54.34,Default,,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:09:55.21,0:09:59.36,Default,,0000,0000,0000,,Өткен жылы мен мектептен ұзақ үзіліс алдым.
Dialogue: 0,0:09:59.72,0:10:00.63,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:10:01.60,0:10:02.28,Default,,0000,0000,0000,,Бұл көшірме болды ма?
Dialogue: 0,0:10:03.27,0:10:05.24,Default,,0000,0000,0000,,А, иә, ол көшірілді.
Dialogue: 0,0:10:09.00,0:10:14.39,Default,,0000,0000,0000,,Мен білетіндердің бәрі бітірді, ал қазір мектепте мен танымайтын адамдар ғана қалды...
Dialogue: 0,0:10:15.18,0:10:17.81,Default,,0000,0000,0000,,Мен өзімді Таро Урашима сияқты сезіндім
Dialogue: 0,0:10:19.58,0:10:23.49,Default,,0000,0000,0000,,Аа, кешіріңіз, мен жаңа кездескен адамға осылай жасадым...
Dialogue: 0,0:10:24.18,0:10:26.38,Default,,0000,0000,0000,,Сонда сіз өзіңізбен осылай сөйлескенсіз бе?
Dialogue: 0,0:10:27.90,0:10:29.56,Default,,0000,0000,0000,,Сізде үйірме жұмыстары болған жоқ па?
Dialogue: 0,0:10:30.00,0:10:33.90,Default,,0000,0000,0000,,Иә...Мен драма үйірмесіне қатысқым келді...
Dialogue: 0,0:10:34.23,0:10:38.54,Default,,0000,0000,0000,,Менің денем әлсіз, сондықтан дұрыс жұмыс істей алмаймын деп ойлаймын...
Dialogue: 0,0:10:39.13,0:10:41.26,Default,,0000,0000,0000,,Мүмкіндігінше қатысыңыз.
Dialogue: 0,0:10:41.54,0:10:43.70,Default,,0000,0000,0000,,Сабақтан кейін неге драма үйірмесіне бармайсың?
Dialogue: 0,0:10:44.12,0:10:44.75,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:10:44.96,0:10:45.73,Default,,0000,0000,0000,,О, қараңдаршы!
Dialogue: 0,0:10:46.61,0:10:47.62,Default,,0000,0000,0000,,Саған қарап
Dialogue: 0,0:10:49.26,0:10:51.68,Default,,0000,0000,0000,,Көңілсіз көрінсең, дос таппайсың.
Dialogue: 0,0:10:52.34,0:10:53.57,Default,,0000,0000,0000,,Күлімсіреу және қол бұлғау
Dialogue: 0,0:10:54.54,0:10:56.38,Default,,0000,0000,0000,,Қараңдаршы, бұл үлкен күлкі.
Dialogue: 0,0:11:02.10,0:11:03.32,Default,,0000,0000,0000,,Сіз байқамадыңыз ба...
Dialogue: 0,0:11:04.10,0:11:07.48,Default,,0000,0000,0000,,Мен...тіпті сыныпта да, менің қатысуым аз...
Dialogue: 0,0:11:12.51,0:11:13.41,Default,,0000,0000,0000,,Не...?
Dialogue: 0,0:11:12.80,0:11:13.80,PS,,0000,0000,0000,,Эй, бұл қызық екен.
Dialogue: 0,0:11:19.35,0:11:21.85,Default,,0000,0000,0000,,О, тамаша!
Dialogue: 0,0:11:22.17,0:11:23.85,Default,,0000,0000,0000,,Сунохара: Бұл не туралы?
Dialogue: 0,0:11:24.23,0:11:25.52,Default,,0000,0000,0000,,Бұл шабуыл емес пе?
Dialogue: 0,0:11:25.84,0:11:28.61,Default,,0000,0000,0000,,Басқа орта мектептен бір жігіт мотоциклмен келді...
Dialogue: 0,0:11:29.09,0:11:31.45,Default,,0000,0000,0000,,Ендеше, сен біреудің басына не істеп жүрсің?
Dialogue: 0,0:11:34.88,0:11:36.78,Default,,0000,0000,0000,,Сіз кездейсоқ уағыз айтуды ойлайсыз ба?
Dialogue: 0,0:11:46.79,0:11:48.46,Default,,0000,0000,0000,,Неліктен бұл болып жатыр?
Dialogue: 0,0:11:48.91,0:11:52.05,Default,,0000,0000,0000,,Бұл қаладағы ең жақсы дайындық мектебі.
Dialogue: 0,0:11:52.28,0:11:53.95,Default,,0000,0000,0000,,Мұндай нәрсеге ренжітетін адамдар бар.
Dialogue: 0,0:11:54.84,0:11:56.19,Default,,0000,0000,0000,,Сіз көмектесесіз бе?
Dialogue: 0,0:11:56.72,0:11:58.29,Default,,0000,0000,0000,,Мен үндемедім және қарап отырмаймын.
Dialogue: 0,0:11:58.59,0:12:00.34,Default,,0000,0000,0000,,Томойо-сан үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:12:00.84,0:12:01.35,Default,,0000,0000,0000,,Томойо?
Dialogue: 0,0:12:01.50,0:12:02.54,Default,,0000,0000,0000,,...
Dialogue: 0,0:12:02.82,0:12:06.69,Default,,0000,0000,0000,,Бұл көктемде екінші курсқа ауысқан Томойо Сакагами.
Dialogue: 0,0:12:06.83,0:12:08.16,Default,,0000,0000,0000,,Бұл өте күшті.
Dialogue: 0,0:12:08.31,0:12:10.65,Default,,0000,0000,0000,,Егер сіз жаман жолмен шықсаңыз, ол шынымен жолға түседі.
Dialogue: 0,0:12:10.91,0:12:12.08,Default,,0000,0000,0000,,Сіз айттыңыз...
Dialogue: 0,0:12:12.72,0:12:14.60,Default,,0000,0000,0000,,Мен қажетсіз қиындық тудырғым келмейді.
Dialogue: 0,0:12:14.99,0:12:16.52,Default,,0000,0000,0000,,Жарақат алмас бұрын жоғалып кет
Dialogue: 0,0:12:17.13,0:12:19.20,Default,,0000,0000,0000,,Үйге тыныш барсаң, мен сені сағынамын.
Dialogue: 0,0:12:20.02,0:12:22.43,Default,,0000,0000,0000,,Сіз өзіңізді ауыртпайсыз, солай ма?
Dialogue: 0,0:12:22.97,0:12:23.73,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,0:12:47.75,0:12:48.72,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,0:12:52.04,0:12:53.33,Default,,0000,0350,0280,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 1,0:12:52.41,0:12:53.33,Default,,0000,0560,0260,,Керемет!
Dialogue: 0,0:12:55.40,0:12:56.17,Default,,0000,0000,0000,,…Бұл не?
Dialogue: 0,0:12:56.75,0:12:59.97,Default,,0000,0000,0000,,Студентті ауыстыру...бұл не...бұрынғы адам?
Dialogue: 0,0:13:00.49,0:13:03.81,Default,,0000,0000,0000,,Мен сізге ұқсас жағдайға ие болсам да, мен соншалықты танымалмын.
Dialogue: 0,0:13:04.13,0:13:05.99,Default,,0000,0000,0000,,Барлығы адамның өзіне байланысты.
Dialogue: 0,0:13:06.59,0:13:08.97,Default,,0000,0000,0000,,…Мүмкін солай шығар.
Dialogue: 0,0:13:09.80,0:13:14.17,OS,,0000,0000,0000,,Не, мен басқаларға уағыз айта алатын жалғыз адаммын ба?
Dialogue: 0,0:13:16.39,0:13:17.46,Default,,0000,0000,0000,,Жарайды, мен кетейін.
Dialogue: 0,0:13:17.88,0:13:19.47,Default,,0000,0000,0000,,Иә, иә...
Dialogue: 0,0:13:19.50,0:13:19.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:20.31,0:13:21.70,Default,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:13:24.00,0:13:26.03,Default,,0000,0000,0000,,Мен D сыныбынан Томоя Оказакимін.
Dialogue: 0,0:13:26.49,0:13:28.98,Default,,0000,0000,0000,,Мен В сыныбынан шыққан Нагиса Фурукавамын.
Dialogue: 0,0:13:29.33,0:13:30.00,Default,,0000,0000,0000,,Танысқаныма қуаныштымын
Dialogue: 0,0:13:30.54,0:13:33.53,Default,,0000,0000,0000,,Иә, танысқаныма қуаныштымын, Томоя Оказаки.
Dialogue: 0,0:13:34.11,0:13:34.90,Default,,0000,0000,0000,,Сәлем Оказаки
Dialogue: 0,0:13:37.47,0:13:38.95,Default,,0000,0000,0000,,Кейін кездескенше
Dialogue: 0,0:13:42.19,0:13:42.79,Default,,0000,0000,0000,,Мені мұны істеуге мәжбүр етті ме?
Dialogue: 0,0:13:42.99,0:13:46.50,Default,,0000,0000,0000,,Әй, әйел еркекті жеңе алмайды.
Dialogue: 0,0:13:46.55,0:13:49.76,Default,,0000,0000,0000,,Менің ойымша, олар оған ақшаны жоғалтып алу үшін, танымал болу үшін берді.
Dialogue: 0,0:13:50.51,0:13:52.57,Default,,0000,0000,0000,,Әлде ақша емес, анау ма?
Dialogue: 0,0:13:52.87,0:13:54.22,Default,,0000,0000,0000,,Қыздар жақсы
Dialogue: 0,0:13:54.43,0:13:57.22,Default,,0000,0000,0000,,Сондықтан ақымақ адамдар айтқанын істейді.
Dialogue: 0,0:13:57.42,0:13:58.70,Default,,0000,0000,0000,,Бұл адамдар кімдер?
Dialogue: 0,0:13:58.95,0:14:02.52,Default,,0000,0000,0000,,Үшінші жылдағы құқық бұзушылар. Есімде дұрыс болса, есімдері Сунохара мен Оказаки...
Dialogue: 0,0:14:02.55,0:14:06.76,Default,,0000,0000,0000,,Қуан. Бір мектептің оқушыларына тиіспеймін деп ойладым.
Dialogue: 0,0:14:07.16,0:14:09.49,Default,,0000,0000,0000,,Мен саған ерекше қараймын.
Dialogue: 0,0:14:09.80,0:14:11.61,Default,,0000,0000,0000,,Сен сондай сүйкімдісің, сен сондай күштісің
Dialogue: 0,0:14:12.02,0:14:13.67,Default,,0000,0000,0000,,Сіздің тізеңіз дірілдеп тұр ма?
Dialogue: 0,0:14:13.74,0:14:16.75,Default,,0000,0000,0000,,Мен мұны өзін-өзі қорғау деп атағым келеді. Маған қоңырау шалыңыз.
Dialogue: 0,0:14:17.17,0:14:19.20,Default,,0000,0000,0000,,Уф, сенің көңіл-күйің жоқ деп ойлаймын.
Dialogue: 0,0:14:20.65,0:14:22.32,Default,,0000,0000,0000,,Бұл өлімге байланысты――――
Dialogue: 0,0:14:23.21,0:14:24.96,OS,,0000,0000,0000,,Сол кезде есіме түсті
Dialogue: 0,0:14:25.91,0:14:30.52,OS,,0000,0000,0000,,...Ертеде бұл қалада керемет күшті және сұлу қыз болыпты.
Dialogue: 0,0:14:31.04,0:14:35.29,OS,,0000,0000,0000,,Қарапайым халықты бүлдіргісі келген ақымақтарды ұрып-соғады.
Dialogue: 0,0:14:35.80,0:14:37.08,Default,,0000,0000,0000,,деген қауесет бар.
Dialogue: 0,0:14:37.52,0:14:39.02,Default,,0000,0000,0000,,Мұны жасамас бұрын маған айтыңыз
Dialogue: 0,0:14:39.28,0:14:40.96,Default,,0000,0220,0220,,Иә!
Dialogue: 0,0:14:39.33,0:14:40.96,Default,,0000,0470,0220,,Салқын
Dialogue: 0,0:14:39.33,0:14:40.96,Default,,0400,0000,0225,,Екінші тарап өте нашар
Dialogue: 0,0:14:40.00,0:14:41.14,Default,,0000,0000,0000,,Қайта келмеуіңізді өтінемін.
Dialogue: 0,0:14:42.63,0:14:43.82,Default,,0000,0000,0000,,Чикушо
Dialogue: 0,0:14:46.24,0:14:47.39,OS,,0000,0000,0000,,Ескі мектеп ғимаратының үшінші қабаты
Dialogue: 0,0:14:48.02,0:14:50.86,OS,,0000,0000,0000,,Бұл мәдени үйірме бөлмесі екеніне сенімдімін.
Dialogue: 0,0:14:52.75,0:14:54.24,OS,,0000,0000,0000,,Ол мотивация алды ма?
Dialogue: 0,0:14:57.06,0:14:57.97,Default,,0000,0000,0000,,Гамбургер?
Dialogue: 0,0:14:58.70,0:14:59.79,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:15:14.75,0:15:17.28,Default,,0000,0000,0000,,Оказаки мырза...сіз осындасыз ба?
Dialogue: 0,0:15:17.53,0:15:18.05,Default,,0000,0000,0000,,О
Dialogue: 0,0:15:19.05,0:15:20.62,Default,,0000,0000,0000,,Бұл қандай қозғалыс?
Dialogue: 0,0:15:21.34,0:15:22.49,Default,,0000,0000,0000,,Жоқ, олай емес...
Dialogue: 0,0:15:24.60,0:15:25.48,Default,,0000,0000,0000,,Мен ұмытып қалдым
Dialogue: 0,0:15:26.03,0:15:29.08,Default,,0000,0000,0000,,Драма үйірмесі осы жылдың наурыз айында жұмысын тоқтатты.
Dialogue: 0,0:15:29.64,0:15:32.92,Default,,0000,0000,0000,,Үйірме мүшелері көп емес деп естідім...
Dialogue: 0,0:15:37.32,0:15:41.67,Default,,0000,0000,0000,,Бірақ тоқтата тұру, егер шарттар орындалса, әрекеттерді жалғастыруға болатынын білдіреді.
Dialogue: 0,0:15:42.12,0:15:43.28,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:15:43.89,0:15:45.74,Default,,0000,0000,0000,,Неге аздап тырыспайсың?
Dialogue: 0,0:15:45.88,0:15:46.95,Default,,0000,0000,0000,,Мен де саған көмектесемін.
Dialogue: 0,0:15:47.43,0:15:48.96,Default,,0000,0000,0000,,Мм...мырза. Оказаки...
Dialogue: 0,0:15:49.91,0:15:52.98,Default,,0000,0000,0000,,Маған неге сонша мейірімді боласың?
Dialogue: 0,0:15:53.28,0:15:54.85,Default,,0000,0000,0000,,Жаңа кездескен маған...
Dialogue: 0,0:15:55.44,0:15:56.59,Default,,0000,0000,0000,,Неге...
Dialogue: 0,0:15:57.17,0:15:58.35,Default,,0000,0000,0000,,Қызық, неге?
Dialogue: 0,0:16:16.93,0:16:18.24,Default,,0000,0000,0000,,Отырыңыз және дұрыс тамақтаныңыз.
Dialogue: 0,0:16:23.54,0:16:24.83,Default,,0000,0000,0000,,Міне, міне.
Dialogue: 0,0:16:24.94,0:16:25.88,Default,,0000,0000,0000,,О, онда.
Dialogue: 0,0:16:26.39,0:16:27.79,Default,,0000,0000,0000,,Мм...мырза. Оказаки
Dialogue: 0,0:16:28.00,0:16:28.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:28.45,0:16:32.25,Default,,0000,0000,0000,,Менікі - саябақтың қарсы жағындағы наубайхана.
Dialogue: 0,0:16:32.62,0:16:34.73,Default,,0000,0000,0000,,Қаласаңыз, тезірек келіңіз.
Dialogue: 0,0:16:35.08,0:16:36.05,Default,,0000,0000,0000,,Қаласаңыз
Dialogue: 0,0:16:38.07,0:16:38.97,Default,,0000,0000,0000,,Чис
Dialogue: 0,0:16:39.55,0:16:40.90,Default,,0000,0000,0000,,Ешкім жоқ па?
Dialogue: 0,0:16:43.64,0:16:46.42,Default,,0000,0000,0000,,Бұл осы аптаның жаңа өнімі.
Dialogue: 0,0:16:46.85,0:16:48.65,Default,,0000,0000,0000,,Қаласаңыз, көріңіз.
Dialogue: 0,0:16:49.04,0:16:51.41,OS,,0000,0000,0000,,Коганың әпкесі...анасы?
Dialogue: 0,0:16:51.87,0:16:54.85,Default,,0000,0000,0000,,Бағасы жақсы, қалды.
Dialogue: 0,0:16:55.35,0:16:57.28,Default,,0000,0000,0000,,Тұжырымдамасы «нагоми»
Dialogue: 0,0:16:57.61,0:16:58.44,Default,,0000,0000,0000,,Нагоми…
Dialogue: 0,0:16:59.20,0:17:01.74,Default,,0000,0000,0000,,Олай болса, сөзіңізді қабыл алыңыз...
Dialogue: 0,0:17:06.68,0:17:08.72,Default,,0000,0000,0000,,Ішінде күріш крекерлері бар.
Dialogue: 0,0:17:09.15,0:17:11.18,Default,,0000,0000,0000,,«Күріш нан» деп аталады.
Dialogue: 0,0:17:11.56,0:17:15.69,Default,,0000,0000,0000,,Оның аты ғана емес, нан жасаудың да қасиеті бар.
Dialogue: 0,0:17:15.86,0:17:16.93,Default,,0000,0000,0000,,Ицумида-сан ба?
Dialogue: 0,0:17:20.58,0:17:22.03,Default,,0000,0000,0000,,Идеялардың салтанат құруы
Dialogue: 0,0:17:23.90,0:17:25.88,Default,,0000,0000,0000,,Мм...не болды?
Dialogue: 0,0:17:26.23,0:17:29.14,Default,,0000,0000,0000,,Ал, мен мұны анық айтайын,
Dialogue: 0,0:17:29.41,0:17:30.36,Default,,0000,0000,0000,,Бұл сәтсіздік.
Dialogue: 0,0:17:30.83,0:17:31.40,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:17:33.09,0:17:35.01,Default,,0000,0000,0000,,Әй, бұл дәмді емес пе?
Dialogue: 0,0:17:35.35,0:17:38.28,Default,,0000,0000,0000,,Дәмі де қиын, бірақ бірінші кезекте оны жеу тым қиын.
Dialogue: 0,0:17:38.89,0:17:40.63,Default,,0000,0000,0000,,Осымен оның сатылмай қалуы заңды.
Dialogue: 0,0:17:44.95,0:17:47.70,Default,,0000,0000,0000,,Менің наным… Менің наным…
Dialogue: 0,0:17:47.76,0:17:48.79,Default,,0000,0000,0000,,Эй, сәл күте тұрыңыз...
Dialogue: 0,0:17:49.39,0:17:52.27,Default,,0000,0000,0000,,Оның сатылмай қалуы заңды еді.
Dialogue: 0,0:17:52.95,0:17:54.96,OS,,0000,0000,0000,,Мына ананың мына баласы бар...
Dialogue: 0,0:17:55.57,0:17:58.17,OS,,0000,0000,0000,,Әкемнің әдепті екеніне сенемін.
Dialogue: 0,0:17:58.53,0:17:59.17,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:17:59.92,0:18:00.51,Default,,0000,0000,0000,,Мен білмейтін қыз…➡
Dialogue: 0,0:18:00.76,0:18:01.72,OS,,0000,0000,0000,,Бұл ең нашар болды...
Dialogue: 0,0:18:02.06,0:18:04.13,Default,,0000,0000,0000,,Айтуға болмайтын нәрсені айттыңыз.
Dialogue: 0,0:18:04.86,0:18:07.74,Default,,0000,0000,0000,,Тамақтан ләззат алып, ренжімей-ақ дәмді деп айту дұрыс.
Dialogue: 0,0:18:07.83,0:18:09.43,Default,,0000,0000,0000,,Бұл міндет, солай ма?
Dialogue: 0,0:18:09.86,0:18:12.19,Default,,0000,0000,0000,,Шындық қашанда қатал
Dialogue: 0,0:18:12.35,0:18:16.48,Default,,0000,0000,0000,,Егер сіз мені осымен қарсы алсаңыз... Мен сізді аяймын!
Dialogue: 0,0:18:16.96,0:18:19.84,Default,,0000,0000,0000,,Жан-жағындағылар оның нанын жеп, дәмді екен дейді.
Dialogue: 0,0:18:19.90,0:18:21.90,Default,,0000,0000,0000,,Бұл айтылмаған заң! Бұл заң!
Dialogue: 0,0:18:22.30,0:18:23.80,Default,,0000,0000,0000,,Сондықтан да өзіңізді қорғаңыз.
Dialogue: 0,0:18:23.80,0:18:25.20,Default,,0000,0000,0000,,Олай етпесең, мен тоқтаймын, міне!
Dialogue: 0,0:18:26.35,0:18:28.94,Default,,0000,0000,0000,,Бұл менің балам сияқты мектеп формасы емес пе?
Dialogue: 0,0:18:29.28,0:18:31.73,Default,,0000,0000,0000,,Мүмкін Теме Нағисаның досы шығар?
Dialogue: 0,0:18:32.68,0:18:34.48,Default,,0000,0000,0000,,Тез айт, ақымақ.
Dialogue: 0,0:18:34.67,0:18:38.42,Default,,0000,0000,0000,,Кешіріңіз, мен қызымның досына ұят нәрсе көрсеттім.
Dialogue: 0,0:18:39.29,0:18:40.27,Default,,0000,0000,0000,,Уайымдама, Сана
Dialogue: 0,0:18:40.52,0:18:43.13,Default,,0000,0000,0000,,Бұл жігіт ақымақ сияқты, сондықтан мен оны ұмытып кететін шығармын.
Dialogue: 0,0:18:43.48,0:18:43.72,Default,,0000,0000,0000,,Мен және ұлым
Dialogue: 0,0:18:44.11,0:18:46.39,Default,,0000,0000,0000,,Клиенттеріңізге бұлай айтпаңыз
Dialogue: 0,0:18:46.62,0:18:47.87,OS,,0000,0000,0000,,Неліктен бұл орын алады?
Dialogue: 0,0:18:47.94,0:18:49.15,Default,,0000,0000,0000,,Қандай жағдай болмасын құттықтаймын
Dialogue: 0,0:18:49.64,0:18:52.63,Default,,0000,0000,0000,,Нағисаның жаңа оқу жылында достарын ерте алып келгеніне сене алар емеспін.
Dialogue: 0,0:18:52.93,0:18:54.98,Default,,0000,0000,0000,,Бұл бала, Акио-сан.
Dialogue: 0,0:18:55.26,0:18:57.59,Default,,0000,0000,0000,,Эй!? Бұл ер адам!
Dialogue: 0,0:18:57.62,0:18:58.57,OS,,0000,0000,0000,,Жаңа ғана байқадыңыз ба?
Dialogue: 0,0:18:58.87,0:19:01.40,Default,,0000,0000,0000,,Мүмкін бұл сенің жігітің шығар.
Dialogue: 0,0:19:01.56,0:19:05.64,Default,,0000,0000,0000,,Әй, Нағисаны сондай бейбаққа тапсыра аласың ба? Үйге бар, үйге бар!
Dialogue: 0,0:19:05.95,0:19:07.45,Default,,0000,0000,0000,,Міне, мен...
Dialogue: 0,0:19:07.84,0:19:09.45,Default,,0000,0000,0000,,Теме, сен әлі еркексің!
Dialogue: 0,0:19:09.85,0:19:12.41,Default,,0000,0000,0000,,Ер болсаң, сүйген әйеліңді күшпен болса да тартып ал.
Dialogue: 0,0:19:12.80,0:19:14.24,Default,,0000,0000,0000,,Соны айтсам да, Ватари мырза!
Dialogue: 0,0:19:15.90,0:19:18.37,Default,,0000,0000,0000,,Уау, біз жақсы доспыз.
Dialogue: 0,0:19:18.52,0:19:21.61,Default,,0000,0000,0000,,Бұл анық. Сіз қызыңыздың досына жамандық жасамас едіңіз.
Dialogue: 0,0:19:22.10,0:19:22.52,Default,,0000,0000,0000,,Гү!
Dialogue: 0,0:19:24.18,0:19:25.72,Default,,0000,0000,0000,,Не болды, сен ақымақ болып жүрсің бе?
Dialogue: 0,0:19:26.15,0:19:29.78,Default,,0000,0000,0000,,Жоқ, мен бұл отбасымен араласпауым керек деп ойлаймын.
Dialogue: 0,0:19:29.80,0:19:34.22,Default,,0000,0000,0000,,Хахаха Көріп тұрғаныңыздай, біз қазірдің өзінде ауыр әзілдерді айта алатын жақсы достармыз.
Dialogue: 0,0:19:34.55,0:19:37.47,Default,,0000,0000,0000,,Дұрыс, мен сенің атыңды сұрамадым.
Dialogue: 0,0:19:37.47,0:19:39.68,Default,,0000,0000,0000,,Бұл Оказаки мырза. Томоя Оказаки мырза.
Dialogue: 0,0:19:40.02,0:19:41.95,Default,,0000,0000,0000,,Эй, бұл Мимикчидің аты.
Dialogue: 0,0:19:42.43,0:19:44.18,Default,,0000,0000,0000,,Оны Оказаки галактикасы деп атаймыз.
Dialogue: 0,0:19:44.38,0:19:47.61,Default,,0000,0000,0000,,Бұл жақсы. Мен сені Джинга-сан деп атай аламын ба?
Dialogue: 0,0:19:48.16,0:19:50.09,Default,,0000,0000,0000,,Айтпақшы, фамилияңызды Макрокосмға өзгертіңіз.
Dialogue: 0,0:19:50.42,0:19:52.43,Default,,0000,0000,0000,,Ұлы ғарыш галактикасы, бұл жақсы атау емес пе?
Dialogue: 0,0:19:52.63,0:19:54.52,Default,,0000,0000,0000,,Менің атым Томоя Оказаки!
Dialogue: 0,0:19:55.01,0:19:56.71,Default,,0000,0000,0000,,Хмм, бұл тітіркендіргіш.
Dialogue: 0,0:19:57.37,0:19:59.34,Default,,0000,0000,0000,,Сана, сенің есімің жақсы ма?
Dialogue: 0,0:20:00.01,0:20:00.94,Default,,0000,0000,0000,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:20:01.65,0:20:04.40,Default,,0000,0000,0000,,Атаудың астына бірдеңе қосу туралы не айтуға болады?
Dialogue: 0,0:20:04.80,0:20:11.07,Default,,0000,0000,0000,,Ол үлкен ғана емес, сонымен бірге уақыт пен кеңістік ағынынан да асып түседі, сондықтан Томоя Оказаки - Мәңгілік!
Dialogue: 0,0:20:11.38,0:20:12.93,Default,,0000,0000,0000,,Әдемі емес пе?
Dialogue: 0,0:20:13.11,0:20:15.02,Default,,0000,0000,0000,,Бұдан былай өзіңізді этанол деп атаңыз!
Dialogue: 0,0:20:15.25,0:20:16.18,Default,,0000,0000,0000,,Ол өзгерді...
Dialogue: 0,0:20:35.15,0:20:37.53,Default,,0000,0000,0000,,Рахмет. Осы уақытқа дейін келсең, жолды білесің.
Dialogue: 0,0:20:38.10,0:20:40.48,Default,,0000,0000,0000,,Сізді ұстап қалғаным үшін кешіріңіз.
Dialogue: 0,0:20:41.78,0:20:43.04,Default,,0000,0000,0000,,... Біртүрлі болды.
Dialogue: 0,0:20:43.28,0:20:43.70,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:44.00,0:20:45.68,Default,,0000,0000,0000,,Осындай отбасылар бар ма деп ойлаймын.
Dialogue: 0,0:20:46.56,0:20:47.80,Default,,0000,0000,0000,,Біз жақсы араласамыз.
Dialogue: 0,0:20:48.35,0:20:51.51,Default,,0000,0000,0000,,Солай ма? Менің ойымша, бұл қалыпты жағдай
Dialogue: 0,0:20:53.02,0:20:54.18,Default,,0000,0000,0000,,Ертең кездескенше
Dialogue: 0,0:20:54.79,0:20:56.43,Default,,0000,0000,0000,,Иә, қайырлы түн.
Dialogue: 0,0:20:56.67,0:21:03.63,PS,,0000,0000,0000,,(27-де Жер мен Марс бір-біріне 55,75 миллион км қашықтыққа жақындайды)
Dialogue: 0,0:21:03.75,0:21:06.66,Default,,0000,0000,0000,,Әке, ұйықтағың келсе, жату керек.
Dialogue: 0,0:21:07.78,0:21:08.73,Default,,0000,0000,0000,,Сәлем, әке.
Dialogue: 0,0:21:14.26,0:21:19.37,Default,,0000,0000,0000,,Мынау... мынау... Томоя-кунға тағы да қиындық тудырдым ба деп ойлаймын...
Dialogue: 0,0:21:24.93,0:21:28.59,OS,,0000,0000,0000,,Кішкентай кезімде анам жол апатынан қайтыс болды.
Dialogue: 0,0:21:29.49,0:21:34.51,OS,,0000,0000,0000,,Соған байланысты шығар, әкем ішімдікке, құмар ойындарға құмар болып, сирек жұмыс істеді.
Dialogue: 0,0:21:44.03,0:21:46.02,Default,,0000,0000,0000,,Қарсы болмасаңыз...
Dialogue: 0,0:21:50.13,0:21:52.98,Default,,0000,0000,0000,,Мен сені өзіммен бірге ала кетейін бе?
Dialogue: 0,0:21:53.59,0:21:54.15,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:55.39,0:21:58.77,Default,,0000,0000,0000,,Бұл қаланың тілектері орындалатын жер
Dialogue: 0,0:22:00.33,0:22:01.46,Default,,0000,0000,0000,,А, а...
Dialogue: 0,0:23:41.07,0:23:43.58,Default,,0000,0000,0000,,Оказаки, бүгін демалайық.
Dialogue: 0,0:23:44.02,0:23:46.17,Default,,0000,0000,0000,,Бәрібір сенбі күні жарты күндік сабақ.
Dialogue: 0,0:23:49.54,0:23:53.01,Default,,0000,0000,0000,,Мен оны бірден аяқтаймын, сондықтан клуб бөлмесінде күтіңіз.
Dialogue: 0,0:23:54.85,0:23:57.35,Default,,0000,0000,0000,,Жарайды, жарақаттар жоқ.
Dialogue: 0,0:23:57.66,0:23:59.53,Default,,0000,0000,0000,,Мен сізге жөндеу шығындарын өтеймін.
Dialogue: 0,0:23:59.72,0:24:00.98,Default,,0000,0000,0000,,Шешілді!
Dialogue: 0,0:24:03.45,0:24:05.67,Default,,0000,0000,0000,,Бұл ештеңе емес, ұмытыңыз.
Dialogue: 0,0:24:08.42,0:24:09.30,Default,,0000,0000,0000,,Сіз жалғызсыз ба?
Dialogue: 0,0:24:10.80,0:24:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
