Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.70,0:00:03.41,Default,,0000,0000,0000,,Қарсы болмасаңыз...
Dialogue: 0,0:00:03.77,0:00:06.47,Default,,0000,0000,0000,,Мен сені өзіммен бірге ала кетейін бе?
Dialogue: 0,0:00:06.74,0:00:07.36,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:00:08.00,0:00:11.73,Default,,0000,0000,0000,,Бұл қаланың тілектері орындалатын жер
Dialogue: 0,0:00:13.78,0:00:14.75,Default,,0000,0000,0000,,А, а...
Dialogue: 0,0:00:19.43,0:00:22.26,Default,,0000,0000,0000,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:00:22.46,0:00:22.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:00:23.35,0:00:25.74,Default,,0000,0000,0000,,Үйде бір нәрсені ұмыттыңыз ба?
Dialogue: 0,0:00:25.97,0:00:28.54,Default,,0000,0000,0000,,Ой, жоқ, мен жай серуендеп жүр едім.
Dialogue: 0,0:00:28.74,0:00:30.21,Default,,0000,0000,0000,,Эй, енді...
Dialogue: 0,0:00:32.15,0:00:34.02,Default,,0000,0000,0000,,Бұл пьесаның желісі.
Dialogue: 0,0:00:34.08,0:00:37.69,Default,,0000,0000,0000,,Бұл драма үйірмесі қайта жанданған соң айтқым келетін оқиға.
Dialogue: 0,0:00:39.36,0:00:40.88,Default,,0000,0000,0000,,Бұл пьесаның желісі ме?
Dialogue: 0,0:00:41.37,0:00:43.49,Default,,0000,0000,0000,,Мен үнемі осында жаттығамын.
Dialogue: 0,0:00:43.93,0:00:46.93,Default,,0000,0000,0000,,Оказаки мырза сонда болды, мен одан бір қарап шығуын өтіндім.
Dialogue: 0,0:00:47.59,0:00:50.05,Default,,0000,0000,0000,,Сіз драма үйірмесін қайта құруға мүдделісіз бе?
Dialogue: 0,0:00:51.21,0:00:54.17,Default,,0000,0000,0000,,Иә, мен қанша жүре алатынымды білмеймін, бірақ
Dialogue: 0,0:00:54.77,0:00:56.68,Default,,0000,0000,0000,,Мен бар күшімді саламын...
Dialogue: 0,0:00:58.36,0:00:59.11,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:00:59.96,0:01:00.48,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:02:37.89,0:02:40.56,OS,,0000,0000,0000,,Қыздың өмірі жалғыздықпен өтті
Dialogue: 0,0:02:44.18,0:02:46.82,OS,,0000,0000,0000,,Қыздан басқа ешкім болмады.
Dialogue: 0,0:02:47.99,0:02:49.33,OS,,0000,0000,0000,,Бұл табиғи болды
Dialogue: 0,0:02:52.75,0:02:56.91,OS,,0000,0000,0000,,Бұл жерден ештеңе тумайды және ештеңе өлмейді.
Dialogue: 0,0:02:57.73,0:02:58.73,OS,,0000,0000,0000,,Бұл дүние
Dialogue: 0,0:03:03.05,0:03:06.35,OS,,0000,0000,0000,,Ол дене маған арналған.
Dialogue: 0,0:03:08.26,0:03:11.01,OS,,0000,0000,0000,,Қалауым керек пе?
Dialogue: 0,0:03:12.20,0:03:13.99,OS,,0000,0000,0000,,Бұл дүниеге келу
Dialogue: 0,0:03:15.79,0:03:18.09,OS,,0000,0000,0000,,Бұл дүниедегі жалғыз жылулық
Dialogue: 0,0:03:19.09,0:03:22.37,OS,,0000,0000,0000,,Бір күні мен оны сұрадым
Dialogue: 0,0:03:29.97,0:03:31.89,Default,,0000,0000,0000,,Драма үйірмесін қайта құру…
Dialogue: 0,0:03:32.66,0:03:35.45,Default,,0000,0000,0000,,Бұл сізге зерігуді жеңуге көмектеседі.
Dialogue: 0,0:03:36.20,0:03:37.47,Default,,0000,0000,0000,,Томоя, қаш!
Dialogue: 0,0:03:38.17,0:03:38.51,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:03:38.51,0:03:41.24,Default,,0000,0000,0000,,Денені тексеру? Неге ондай істегіңіз келеді?
Dialogue: 0,0:03:44.96,0:03:46.28,Default,,0000,0000,0000,,Itter
Dialogue: 0,0:03:46.80,0:03:48.30,Default,,0000,0000,0000,,Тек сақ болыңыз!
Dialogue: 0,0:03:48.66,0:03:50.80,Default,,0000,0000,0000,,Бұл сызық. Сіз мені өлтіргіңіз келе ме?
Dialogue: 0,0:03:53.30,0:03:57.93,Default,,0000,0000,0000,,Ахахахха, мен әлі көлік жүргізуге үйренбегенмін.
Dialogue: 0,0:03:58.18,0:04:00.42,Default,,0000,0000,0000,,Сіз лицензияңызды өткен аптада ғана алдыңыз, солай ма?
Dialogue: 0,0:04:04.52,0:04:06.86,Default,,0000,0000,0000,,Жарайды, жарақаттар жоқ.
Dialogue: 0,0:04:07.16,0:04:09.11,Default,,0000,0000,0000,,Мен сізге жөндеу шығындарын өтеймін.
Dialogue: 0,0:04:09.58,0:04:11.00,Default,,0000,0000,0000,,Шүкіршілік ет
Dialogue: 0,0:04:11.12,0:04:15.21,Default,,0000,0000,0000,,Егер бірдеңе болса, құрбан болған мен емеспін бе?
Dialogue: 0,0:04:15.36,0:04:16.68,Default,,0000,0000,0000,,Ахахаха…
Dialogue: 0,0:04:19.08,0:04:20.81,Default,,0000,0000,0000,,Фудзибаяши?
Dialogue: 0,0:04:20.81,0:04:23.63,Default,,0000,0000,0000,,Бұл мектепте дөрекі қыздар көп.
Dialogue: 0,0:04:23.63,0:04:27.65,Default,,0000,0000,0000,,Сунохара: Бұл әдеттен тыс, лайықты уақытта.
Dialogue: 0,0:04:28.38,0:04:31.92,Default,,0000,0000,0000,,Хмф, мен қарызымды мүмкіндігінше тезірек төлегім келеді.
Dialogue: 0,0:04:32.14,0:04:34.61,Default,,0000,0000,0000,,Басқа дөрекі әйелге
Dialogue: 0,0:04:35.99,0:04:37.71,Default,,0000,0000,0000,,Ол табанды жігіт.
Dialogue: 0,0:04:37.95,0:04:41.00,Default,,0000,0000,0000,,Бір күні қолдарым солғын еді, бірақ бүгін басқа!
Dialogue: 0,0:04:41.38,0:04:43.67,Default,,0000,0000,0000,,Егер көріністер арасындағы интервал тым ұзақ болса,
Dialogue: 0,0:04:44.10,0:04:48.05,Default,,0000,0000,0000,,Тіпті жақсы құмыралар да соғылады!
Dialogue: 0,0:04:48.22,0:04:50.87,OS,,0000,0000,0000,,Бұл өте жаман ұқсастық.
Dialogue: 0,0:04:52.33,0:04:55.32,Default,,0000,0000,0000,,Мен жаман ештеңе айтпаймын, сондықтан оны қазір тоқтатыңыз.
Dialogue: 0,0:04:55.47,0:04:58.39,Default,,0000,0000,0000,,Әлде мен сабаққа келе алмасам жақсы ма?
Dialogue: 0,0:04:58.78,0:04:59.42,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:05:01.81,0:05:04.00,Default,,0000,0000,0000,,Мектепке келе алмау дегеніміз:
Dialogue: 0,0:05:04.15,0:05:05.66,Default,,0000,0000,0000,,Ал, қайсысы?
Dialogue: 0,0:05:05.92,0:05:07.63,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:05:08.54,0:05:12.32,Default,,0000,0000,0000,,Сіз куәлік бересіз бе? Бұл өзін-өзі қорғау.
Dialogue: 0,0:05:12.50,0:05:15.03,Default,,0000,0000,0000,,Аа, бұл шын мәнінде рас.
Dialogue: 0,0:05:15.20,0:05:15.78,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:05:16.51,0:05:18.32,Default,,0000,0000,0000,,Енді не қалайсыз?
Dialogue: 0,0:05:18.65,0:05:21.10,Default,,0000,0000,0000,,Біраз уақыт жерде адам болуды доғарайық.
Dialogue: 0,0:05:21.22,0:05:22.60,Default,,0000,0000,0000,,Сіз осындай нәрсені жасай аласыз ба?
Dialogue: 0,0:05:23.14,0:05:25.43,Default,,0000,0000,0000,,Ештеңе айтпа, жай ғана қоңырау шал!
Dialogue: 0,0:05:31.04,0:05:32.95,Default,,0000,0000,0000,,Әй, ұшады, ұшады
Dialogue: 0,0:05:32.95,0:05:35.00,Default,,0000,0000,0000,,Шаңды атуға қатысқандар
Dialogue: 0,0:05:35.02,0:05:37.10,Default,,0000,0000,0000,,Не? О
Dialogue: 0,0:05:41.10,0:05:43.69,Default,,0000,0000,0000,,Уау~ Маған көмектесіңізші...
Dialogue: 0,0:05:47.65,0:05:49.48,Default,,0000,0000,0000,,Оны алып тастасам құлап қалады, не істеуім керек?
Dialogue: 0,0:05:49.48,0:05:50.24,Default,,0000,0000,0000,,Иә? Иә?
Dialogue: 0,0:05:50.49,0:05:51.59,Default,,0000,0000,0000,,Сіз құлағыңыз келе ме?
Dialogue: 0,0:05:51.65,0:05:52.43,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:05:52.43,0:05:54.13,Default,,0000,0000,0000,,Мен ештеңеге жауап берген жоқпын.
Dialogue: 0,0:06:02.81,0:06:04.10,Default,,0000,0000,0000,,Мүмкін мен шектен шығып кеткен шығармын
Dialogue: 0,0:06:04.10,0:06:06.75,Default,,0000,0000,0000,,Жоқ, ол жақсы.
Dialogue: 0,0:06:08.10,0:06:11.85,Default,,0000,0000,0000,,Эй Сунохара, сен тірісің бе?
Dialogue: 0,0:06:12.01,0:06:15.07,Default,,0000,0000,0000,,Шүкір, бұлай бітпейді!
Dialogue: 0,0:06:15.07,0:06:15.51,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:06:16.00,0:06:19.15,Default,,0000,0000,0000,,Мұның соңы осымен бітсе екен.
Dialogue: 0,0:06:21.30,0:06:25.74,Default,,0000,0000,0000,,Бірақ мен сендерге қарасам, мен аздап сағыныш сезінемін.
Dialogue: 0,0:06:25.99,0:06:26.41,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:27.35,0:06:29.49,Default,,0000,0000,0000,,Бұл ештеңе емес, ұмытыңыз.
Dialogue: 0,0:06:34.08,0:06:34.78,Default,,0000,0000,0000,,Ол сонда болды.
Dialogue: 0,0:06:34.89,0:06:37.18,Default,,0000,0000,0000,,А, сен шынымен барсың.
Dialogue: 0,0:06:37.80,0:06:38.97,Default,,0000,0000,0000,,Сол қыздың шаш түсіне ұқсас шашы бар қыз…
Dialogue: 0,0:06:39.29,0:06:40.17,Default,,0000,0000,0000,,Оказаки?
Dialogue: 0,0:06:40.43,0:06:42.34,Default,,0000,0000,0000,,Мен дәл қазір осы дәлізде болдым.
Dialogue: 0,0:06:42.42,0:06:43.89,Default,,0000,0000,0000,,Оқушы қыздың елесі
Dialogue: 0,0:06:44.13,0:06:47.89,Default,,0000,0000,0000,,Менімен арғы жақтан сөйлесіп, қарғыс атқан затты маған беріңіз.
Dialogue: 0,0:06:48.09,0:06:52.35,Default,,0000,0000,0000,,Ол кәдімгі қызға ұқсайды, бірақ оның бір қызығы бар.
Dialogue: 0,0:06:49.55,0:06:50.27,Default,,0310,0000,0290,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:06:59.33,0:07:01.04,Default,,0000,0000,0000,,Құлып ашық па?
Dialogue: 0,0:07:07.85,0:07:09.77,Default,,0000,0000,0000,,Дұрыс, мен осында ұйықтайын――
Dialogue: 0,0:07:09.77,0:07:10.60,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:07:19.65,0:07:20.95,Default,,0000,0000,0000,,Cola Cola Cola
Dialogue: 0,0:07:23.13,0:07:24.99,Default,,0000,0000,0000,,Міне, бұл кітап.
Dialogue: 0,0:07:25.08,0:07:26.85,Default,,0000,0000,0000,,Өз еркімен кесіп тастасаң жаман болар еді.
Dialogue: 0,0:07:27.24,0:07:28.04,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:07:31.07,0:07:33.27,Default,,0000,0000,0000,,Сіз қиын кітапты оқып жатырсыз.
Dialogue: 0,0:07:34.49,0:07:36.74,Default,,0000,0000,0000,,Сіз де сабақты жіберіп жатырсыз ба?
Dialogue: 0,0:07:44.85,0:07:46.66,Default,,0000,0000,0000,,Бұл менің қолөнерім.
Dialogue: 0,0:07:37.57,0:07:39.03,Default,,0000,0000,0000,,Неге жалаң аяқсың?
Dialogue: 0,0:07:46.97,0:07:47.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:47.70,0:07:49.72,Default,,0000,0000,0000,,Мен бұл бөлімді ерекше мақтан тұтамын.
Dialogue: 0,0:07:49.91,0:07:51.96,Default,,0000,0000,0000,,Кітапханада ішіп-жеуге тыйым салынады.
Dialogue: 0,0:07:52.42,0:07:53.10,Default,,0000,0000,0000,,Тамақтану керек пе?
Dialogue: 0,0:07:58.79,0:08:00.62,Default,,0000,0000,0000,,Жақсы идея екен.
Dialogue: 0,0:08:00.93,0:08:01.63,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:08:02.31,0:08:03.00,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:08:03.34,0:08:05.26,Default,,0000,0000,0000,,Менде бір ғана таяқша жинағы бар.
Dialogue: 0,0:08:14.63,0:08:15.28,Default,,0000,0000,0000,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:08:20.15,0:08:22.07,Default,,0000,0000,0000,,Мұны тезірек орындағаныңыз жөн.
Dialogue: 0,0:08:22.21,0:08:24.12,Default,,0000,0000,0000,,Жақында сабақ басталады.
Dialogue: 0,0:08:25.74,0:08:27.27,Default,,0000,0000,0000,,Сізге әлі де бірдеңе керек пе?
Dialogue: 0,0:08:29.31,0:08:30.24,Default,,0000,0000,0000,,…жақында кездескенше
Dialogue: 0,0:08:32.21,0:08:35.96,OS,,0000,0000,0000,,Бұл апатқа ұшыраған студенттің елесі емес екеніне сенімдімін...
Dialogue: 0,0:08:36.83,0:08:40.16,Default,,0000,0000,0000,,Бұл А класындағы Котоми Ичиноза болуы керек.
Dialogue: 0,0:08:40.27,0:08:41.70,Default,,0000,0000,0000,,Котоми Ичиноза?
Dialogue: 0,0:08:41.75,0:08:46.60,Default,,0000,0000,0000,,Ол ұлттық сынақ емтихандарында әр пән бойынша әрқашан үздік 10-ның қатарынан көрінетін данышпан қыз.
Dialogue: 0,0:08:46.72,0:08:51.22,Default,,0000,0000,0000,,Сабаққа бармай оқудың ұяты жоқ сияқты.
Dialogue: 0,0:08:51.57,0:08:53.71,Default,,0000,0000,0000,,Ол мектептегі атақты адам.
Dialogue: 0,0:08:53.91,0:08:55.63,Default,,0000,0000,0000,,Данышпан қыз...
Dialogue: 0,0:08:56.06,0:08:57.57,Default,,0000,0000,0000,,Өзгерген болуы керек
Dialogue: 0,0:08:59.00,0:09:01.61,Default,,0000,0000,0000,,Дұрыс, Фудзибаяши, сенің әпкең.
Dialogue: 0,0:09:01.61,0:09:03.05,Default,,0000,0000,0000,,Ой, сөз жоқ.
Dialogue: 0,0:09:03.39,0:09:05.39,Default,,0000,0000,0000,,Әпкеңе не болды?
Dialogue: 0,0:09:05.83,0:09:07.88,Default,,0000,0000,0000,,Мен не істесем де, ол қош бол...
Dialogue: 0,0:09:07.88,0:09:08.95,Default,,0000,0000,0000,,Корат Томоя!
Dialogue: 0,0:09:09.24,0:09:10.69,Default,,0000,0000,0000,,Не? Апыр-ай!?
Dialogue: 0,0:09:12.29,0:09:13.39,Default,,0000,0000,0000,,Бір сәт осында келіңіз.
Dialogue: 0,0:09:13.39,0:09:14.46,Default,,0000,0000,0000,,Е, а...
Dialogue: 0,0:09:16.03,0:09:17.90,Default,,0000,0000,0000,,Сәлеметсіз бе? би дегеніміз не?
Dialogue: 0,0:09:18.06,0:09:18.77,Default,,0000,0000,0000,,Сәлеметсіз бе?
Dialogue: 0,0:09:19.33,0:09:22.77,Default,,0000,0000,0000,,Сіз! Сынып ортасында не айтасың?
Dialogue: 0,0:09:23.04,0:09:25.15,Default,,0000,0000,0000,,Сіз не айтып тұрсыз?
Dialogue: 0,0:09:25.70,0:09:28.38,Default,,0000,0000,0000,,Менің мектептен шеттетілгенімді қалайсың ба?
Dialogue: 0,0:09:28.52,0:09:31.00,Default,,0000,0000,0000,,Сіз мектепке велосипедпен баруға тыйым салынғанын білесіз бе?
Dialogue: 0,0:09:32.69,0:09:36.32,Default,,0000,0000,0000,,Оказаки-кун, сен апаңмен не туралы сөйлестің?
Dialogue: 0,0:09:37.54,0:09:39.00,Default,,0000,0000,0000,,Бәріңіз тыңдаңыздар!
Dialogue: 0,0:09:39.14,0:09:41.97,Default,,0000,0000,0000,,Е сыныбынан шыққан Фудзибаяши би!
Dialogue: 0,0:09:44.57,0:09:45.24,Default,,0000,0000,0000,,Бір айдан кейін
Dialogue: 0,0:09:45.48,0:09:46.60,Default,,0000,0000,0000,,Бай деген не?
Dialogue: 0,0:09:46.76,0:09:49.28,Default,,0000,0000,0000,,Сау болыңыз!? Ерлер де, әйелдер де жақсы ма?
Dialogue: 0,0:09:49.28,0:09:52.71,Default,,0000,0000,0000,,Ол міндетті түрде адамға ұқсайды. Иә...
Dialogue: 0,0:09:53.65,0:09:54.91,Default,,0000,0000,0000,,Не?!
Dialogue: 0,0:09:57.30,0:09:59.28,Default,,0270,0000,0000,,A-n-ta-ne...
Dialogue: 0,0:09:57.11,0:09:59.28,Default,,0100,0000,0000,,Қатты, ауыртпалық, ауыртпалық...
Dialogue: 0,0:09:59.61,0:10:01.71,Default,,0000,0000,0000,,Үлкен апа...қазір не болып жатыр...
Dialogue: 0,0:10:02.03,0:10:03.90,Default,,0000,0000,0000,,Маған сенбеңіз
Dialogue: 0,0:10:03.90,0:10:06.60,Default,,0000,0000,0000,,Велосипед, велосипед! Мопедтер туралы айту
Dialogue: 0,0:10:17.80,0:10:18.63,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:10:20.58,0:10:21.76,Default,,0000,0000,0000,,Сіз тазалау бойынша кезекшіліктесіз бе?
Dialogue: 0,0:10:23.88,0:10:24.69,Default,,0000,0000,0000,,Сіз жалғызсыз ба?
Dialogue: 0,0:10:27.67,0:10:30.19,Default,,0000,0000,0000,,Кога...Бірдеңе болды ма?
Dialogue: 0,0:10:32.23,0:10:34.46,Default,,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:10:35.24,0:10:38.85,Default,,0000,0000,0000,,Мен оны бірден аяқтаймын, сондықтан клуб бөлмесінде күтіңіз.
Dialogue: 0,0:10:45.23,0:10:45.90,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:10:46.68,0:10:50.13,Default,,0000,0000,0000,,Біріншіден, адам санын жинамайынша сөйлесе алмаймыз.
Dialogue: 0,0:10:50.39,0:10:52.06,Default,,0000,0000,0000,,Мүшелерді қабылдау туралы хабарлау
Dialogue: 0,0:10:52.33,0:10:53.00,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:10:55.47,0:10:57.55,Default,,0000,0000,0000,,Құрылтайшылар фестивалінен кейін маған ұнады.
Dialogue: 0,0:10:58.23,0:10:58.78,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:11:00.95,0:11:01.99,Default,,0000,0000,0000,,Дайын
Dialogue: 0,0:11:02.45,0:11:04.15,Default,,0000,0000,0000,,Маған бірдеңе жетіспеді ме?
Dialogue: 0,0:11:04.43,0:11:06.36,Default,,0000,0000,0000,,Енді ше?
Dialogue: 0,0:11:06.89,0:11:12.53,Default,,0000,0000,0000,,Әй, «Мектептің ең әдемі менеджері сені күтуде» дегенді неге қоспайсың?
Dialogue: 0,0:11:13.84,0:11:16.86,Default,,0000,0000,0000,,Мектептегі ең сұлу қыз...
Dialogue: 0,0:11:17.98,0:11:20.38,Default,,0000,0000,0000,,Мм...мүмкін бұл...
Dialogue: 0,0:11:20.59,0:11:22.56,Default,,0000,0000,0000,,Тағы кім бар?
Dialogue: 0,0:11:22.59,0:11:23.50,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:11:23.83,0:11:27.67,Default,,0000,0000,0000,,Соны жазып алсаң, бір ақымақ жігіт ұсталып қалуы мүмкін.
Dialogue: 0,0:11:27.67,0:11:30.46,Default,,0000,0000,0000,,Егер бізде осындай нәрсе үшін адамдар жиналса, бұл мәселе болар еді.
Dialogue: 0,0:11:30.46,0:11:33.26,Default,,0000,0000,0000,,Ал егер сіз менеджер болсаңыз, Оказаки мырза жақсырақ...
Dialogue: 0,0:11:33.47,0:11:34.51,Default,,0000,0000,0000,,Мен саған кеше айттым
Dialogue: 0,0:11:34.81,0:11:36.12,Default,,0000,0000,0000,,Мен жай ғана көмектесіп жатырмын
Dialogue: 0,0:11:36.47,0:11:38.41,Default,,0000,0000,0000,,Мен театрға қызықпаймын.
Dialogue: 0,0:11:38.92,0:11:42.22,Default,,0000,0000,0000,,Драма үйірмесі қайта жанданса да мен оған кірмеймін.
Dialogue: 0,0:11:43.18,0:11:44.61,Default,,0000,0000,0000,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:11:44.95,0:11:48.36,Default,,0000,0000,0000,,Әрекеттер сіздің айналаңызда шоғырланады.
Dialogue: 0,0:11:48.75,0:11:51.18,Default,,0000,0000,0000,,Ең соңында менеджер бәрін шешеді.
Dialogue: 0,0:11:51.69,0:11:53.72,Default,,0000,0000,0000,,Сіз көргіңіз келетін пьеса бар деп ойлаймын.
Dialogue: 0,0:11:54.99,0:11:57.86,Default,,0000,0000,0000,,Бірақ... мен мұны істей аламын ба?
Dialogue: 0,0:11:58.07,0:11:59.30,Default,,0000,0000,0000,,Мықты болыңыз
Dialogue: 0,0:11:59.74,0:12:02.45,Default,,0000,0000,0000,,Бұл флайерге қалағаныңызша жаза аласыз.
Dialogue: 0,0:12:04.51,0:12:05.69,Default,,0000,0000,0000,,Қалауыңызша...
Dialogue: 0,0:12:06.10,0:12:09.44,Default,,0000,0000,0000,,Олай болса, мен сіздің сүйікті иллюстрацияңызды сала аламын ба?
Dialogue: 0,0:12:09.58,0:12:11.38,Default,,0000,0000,0000,,О, жақсы емес пе?
Dialogue: 0,0:12:11.67,0:12:13.84,Default,,0000,0000,0000,,Бұл жай ғана мәтін болса, бұл жалаң көрініс.
Dialogue: 0,0:12:14.13,0:12:15.33,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:12:15.92,0:12:16.97,Default,,0000,0000,0000,,Олай болса
Dialogue: 0,0:12:17.74,0:12:27.30,Default,,0000,0000,0000,,♪Данго Данго Данго Данго Данго Үлкен отбасы
Dialogue: 0,0:12:28.00,0:12:29.01,Default,,0000,0000,0000,,Дайын
Dialogue: 0,0:12:32.26,0:12:34.50,Default,,0000,0000,0000,,Бұл баяғыда болды...
Dialogue: 0,0:12:34.50,0:12:36.64,Default,,0000,0000,0000,,Иә, біз үлкен Данго отбасымыз.
Dialogue: 0,0:12:36.91,0:12:38.77,Default,,0000,0000,0000,,Мен сені жақсы көремін.
Dialogue: 0,0:12:39.27,0:12:42.02,Default,,0000,0000,0000,,Данго неліктен үлкен отбасы?
Dialogue: 0,0:12:42.43,0:12:44.93,Default,,0000,0000,0000,,Модадан баяғыда кеткен.
Dialogue: 0,0:12:45.26,0:12:48.38,Default,,0000,0000,0000,,Менің ойымша, ол әлі де сүйкімді...
Dialogue: 0,0:12:49.51,0:12:50.85,Default,,0000,0000,0000,,Бұл жақсы емес пе...
Dialogue: 0,0:12:51.14,0:12:54.99,Default,,0000,0000,0000,,О, жоқ, егер сіз Ами жақсы деп ойласаңыз, бұл жақсы.
Dialogue: 0,0:12:55.29,0:12:57.36,Default,,0000,0000,0000,,Өзіңе ұнайтын іспен айналыс деген мен едім.
Dialogue: 0,0:12:58.68,0:12:59.64,Default,,0000,0000,0000,,Тонкацу
Dialogue: 0,0:12:59.64,0:13:00.38,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:13:03.31,0:13:06.91,Default,,0000,0000,0000,,А, бұл өзіңізді жігерлендіру үшін жасалған сиқыр.
Dialogue: 0,0:13:07.37,0:13:11.74,Default,,0000,0000,0000,,Егер сіз көп жұмыс жасасаңыз, өзіңізді сүйікті ванкпен марапаттаңыз.
Dialogue: 0,0:13:12.49,0:13:13.66,Default,,0000,0000,0000,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:13:14.59,0:13:16.23,Default,,0000,0000,0000,,Жоқ, бұл таңқаларлық емес.
Dialogue: 0,0:13:18.12,0:13:21.15,Default,,0000,0000,0000,,Шошқа котлетінен гөрі, үлкен отбасы данго сатып алып, үйге қайтайық.
Dialogue: 0,0:13:21.63,0:13:23.19,Default,,0000,0000,0000,,Парақша жапсырылғаннан кейін
Dialogue: 0,0:13:24.95,0:13:25.55,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:27.82,0:13:30.08,Default,,0000,0000,0000,,Менің де бос уақытым көп.
Dialogue: 0,0:13:30.08,0:13:30.61,Default,,0000,0000,0000,,Ауырды
Dialogue: 0,0:13:44.38,0:13:45.05,Default,,0000,0000,0000,,Ауырды
Dialogue: 0,0:13:48.44,0:13:48.84,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:13:50.80,0:13:52.81,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:54.00,0:13:55.00,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:13:56.00,0:13:57.82,Default,,0000,0000,0000,,Б-Таң қалдыңыз ба?
Dialogue: 0,0:13:58.37,0:13:59.49,Default,,0000,0000,0000,,Ято-сама!
Dialogue: 0,0:13:59.69,0:14:02.00,Default,,0000,0000,0000,,Бұл өнер үйірмесі ме?
Dialogue: 0,0:14:04.09,0:14:06.40,Default,,0000,0000,0000,,Сонымен, көркем үй тапсырмасын орындап жатырсың ба?
Dialogue: 0,0:14:07.51,0:14:08.69,Default,,0000,0000,0000,,Сонда бұл не?
Dialogue: 0,0:14:10.23,0:14:11.32,Default,,0000,0000,0000,,Бұл ма?
Dialogue: 0,0:14:11.72,0:14:16.00,Default,,0000,0000,0000,,Бұл...менің сүйікті...
Dialogue: 0,0:14:16.70,0:14:18.10,Default,,0000,0000,0000,,Эй, эй...
Dialogue: 0,0:14:30.47,0:14:31.05,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:14:31.51,0:14:31.98,Default,,0000,0000,0000,,Га
Dialogue: 0,0:14:33.12,0:14:35.02,Default,,0000,0000,0000,,А-а-а
Dialogue: 0,0:14:36.93,0:14:38.13,Default,,0000,0000,0000,,Пышақ жоқ
Dialogue: 0,0:14:38.28,0:14:40.33,Default,,0000,0000,0000,,Мұндай нәрсені пайдалану қауіпті
Dialogue: 0,0:14:40.56,0:14:41.77,Default,,0000,0000,0000,,Оны қайтарыңыз
Dialogue: 0,0:14:42.21,0:14:44.84,Default,,0000,0000,0000,,Дұрыс қайралған қашауды қолданыңыз
Dialogue: 0,0:14:45.29,0:14:47.08,Default,,0000,0000,0000,,Өнер бөлмесіне барсаңыз, сол жерде.
Dialogue: 0,0:14:47.36,0:14:48.59,Default,,0000,0000,0000,,Мектеп формасы ма? Тамаша! Қызық!
Dialogue: 0,0:14:49.20,0:14:50.67,Default,,0000,0000,0000,,Сіздің қолыңыз ауырады, солай ма?
Dialogue: 0,0:14:51.57,0:14:52.80,Default,,0000,0000,0000,,Бұл ауырмайды
Dialogue: 0,0:14:53.07,0:14:53.53,Default,,0000,0000,0000,,Қолдар
Dialogue: 0,0:14:53.86,0:14:54.13,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:14:54.66,0:14:55.28,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:14:55.54,0:14:57.00,Default,,0000,0000,0000,,Қараңызшы, ауырады, солай емес пе?
Dialogue: 0,0:14:57.19,0:14:58.65,Default,,0000,0000,0000,,Бұл ауырмайды
Dialogue: 0,0:15:00.51,0:15:01.37,Default,,0000,0000,0000,,Жоғары бес
Dialogue: 0,0:15:01.65,0:15:02.89,Default,,0000,0000,0000,,Хайтатчи?
Dialogue: 0,0:15:03.04,0:15:07.22,Default,,0000,0000,0000,,Баскетболда у... соққы жасағанда қолын біріктіретін жігіт.
Dialogue: 0,0:15:07.33,0:15:09.60,Default,,0000,0000,0000,,Білемін, көрдім.
Dialogue: 0,0:15:09.93,0:15:11.90,Default,,0000,0000,0000,,Ал, бестік жоғары, кеттік.
Dialogue: 0,0:15:11.99,0:15:14.77,Default,,0000,0000,0000,,Дрибл ~ Ат!
Dialogue: 0,0:15:14.77,0:15:15.96,OS,,0000,0000,0000,,Сол жерден бастайық па?
Dialogue: 0,0:15:16.34,0:15:17.35,Default,,0000,0000,0000,,Шешілді!
Dialogue: 0,0:15:18.61,0:15:21.05,Default,,0000,0000,0000,,Иә, жарайды, жақсы түсірілім.
Dialogue: 0,0:15:21.39,0:15:22.61,Default,,0000,0000,0000,,Ия
Dialogue: 0,0:15:22.81,0:15:23.63,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:15:23.78,0:15:25.09,Default,,0000,0000,0000,,Қараңызшы, ауырып тұр.
Dialogue: 0,0:15:26.84,0:15:30.04,Default,,0000,0000,0000,,Мен мұны сақтаймын. Сонда кездескенше.
Dialogue: 0,0:15:31.33,0:15:33.43,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:15:35.48,0:15:37.66,Default,,0000,0000,0000,,Бұл соңы
Dialogue: 0,0:15:38.07,0:15:39.75,Default,,0000,0000,0000,,Театр клубының мүшелерін жинау?
Dialogue: 0,0:15:40.04,0:15:42.48,Default,,0000,0000,0000,,Оказаки, сен мұны істеп жатырсың ба?
Dialogue: 0,0:15:42.84,0:15:44.49,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:44.61,0:15:47.83,Default,,0000,0000,0000,,Хмф, бұл Томойо Сакагамиді жеңу үшін арнайы жаттығу.
Dialogue: 0,0:15:48.70,0:15:50.80,Default,,0000,0000,0000,,Бірақ драма үйірмесі?
Dialogue: 0,0:15:51.15,0:15:55.35,Default,,0000,0000,0000,,Мен сізді тағы да клуб іс-шаралары сияқты жиіркенішті нәрсеге қызықтырғаныңызға таң қалдым.
Dialogue: 0,0:15:56.97,0:16:02.50,Default,,0000,0000,0000,,Мен сізді үйірмедегі адамдарды жек көретініңіз соншалық, құсқыңыз келді деп ойладым.
Dialogue: 0,0:16:03.74,0:16:06.88,Default,,0000,0000,0000,,Жақында мен сізге бұл туралы көбірек хабарлаймын.
Dialogue: 0,0:16:07.34,0:16:07.80,Default,,0000,0000,0000,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:16:09.57,0:16:10.65,Default,,0000,0000,0000,,Оказаки мырза...
Dialogue: 0,0:16:13.67,0:16:17.20,Default,,0000,0000,0000,,Оказаки мырза... сіз клубтық іс-шараларды жек көресіз бе?
Dialogue: 0,0:16:17.62,0:16:19.40,Default,,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:16:19.62,0:16:21.05,Default,,0000,0000,0000,,Бұл қызықсыз әңгіме.
Dialogue: 0,0:16:24.57,0:16:26.75,Default,,0000,0000,0000,,Менің ойымша, олар оны сатпайды деп көмектесу мүмкін емес.
Dialogue: 0,0:16:29.24,0:16:31.91,Default,,0000,0000,0000,,Ештеңе жоқтан жақсы.
Dialogue: 0,0:16:35.02,0:16:37.13,Default,,0000,0000,0000,,О, бұл ностальгиялық.
Dialogue: 0,0:16:41.22,0:16:43.34,Default,,0000,0000,0000,,Мұнымен не істеуім керек?
Dialogue: 0,0:16:45.13,0:16:46.45,Default,,0000,0000,0000,,…Достарыңызға беріңіз.
Dialogue: 0,0:16:47.10,0:16:49.75,Default,,0000,0000,0000,,Маған да көмектесе аласыз ба?
Dialogue: 0,0:16:50.15,0:16:51.74,Default,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:16:53.04,0:16:54.36,Default,,0000,0000,0000,,Маған айта аласыз ба?
Dialogue: 0,0:16:54.73,0:16:56.71,Default,,0000,0000,0000,,Маған тиіспе!
Dialogue: 0,0:16:57.97,0:16:59.74,Default,,0000,0000,0000,,Сабыр етіңіз!
Dialogue: 0,0:17:00.63,0:17:03.51,Default,,0000,0000,0000,,Осы басқа сыпайы сөйлеу тәсілі қандай?
Dialogue: 0,0:17:04.13,0:17:06.30,Default,,0000,0000,0000,,Мен сен үшін қандаймын?
Dialogue: 0,0:17:08.56,0:17:09.63,Default,,0000,0000,0000,,Томоя-кун…
Dialogue: 0,0:17:14.59,0:17:17.44,Default,,0000,0000,0000,,Боқ, боқ, боқ.
Dialogue: 0,0:17:32.11,0:17:35.08,Default,,0000,0000,0000,,Ах, үлкен Данго отбасы.
Dialogue: 0,0:17:35.52,0:17:37.17,Default,,0000,0000,0000,,Бұл нақты емес
Dialogue: 0,0:17:37.36,0:17:39.82,Default,,0000,0000,0000,,Жоқ, мен бақыттымын.
Dialogue: 0,0:17:40.68,0:17:45.10,Default,,0000,0000,0000,,Бұл өте үлкен отбасы, мен де қосылғым келеді.
Dialogue: 0,0:17:48.96,0:17:52.60,Default,,0000,0000,0000,,Мен бүгін күні бойы депрессияда болдым.
Dialogue: 0,0:17:54.23,0:18:01.30,Default,,0000,0000,0000,,Тазалық кезінде алдымен бүкіл сынып тазалықпен айналысты, бірақ кейін мен жалғыз екенімді түсіндім...
Dialogue: 0,0:18:02.04,0:18:02.79,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:18:03.55,0:18:06.26,Default,,0000,0000,0000,,Әрқашан, әрқашан ебедейсіз...
Dialogue: 0,0:18:07.41,0:18:11.10,Default,,0000,0000,0000,,Мені осылай мазақтамағанына көп болды...
Dialogue: 0,0:18:12.50,0:18:15.01,Default,,0000,0000,0000,,Бірақ мен қазір өзімді жақсы сезінемін.
Dialogue: 0,0:18:15.26,0:18:16.89,Default,,0000,0000,0000,,Оказаки мырзаға рахмет
Dialogue: 0,0:18:24.65,0:18:26.66,Default,,0000,0000,0000,,Мен бұл туралы бұрын айтқан болатынмын.
Dialogue: 0,0:18:26.66,0:18:27.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:27.44,0:18:30.45,Default,,0000,0000,0000,,Мен және Сунохара спортпен айналысуға кеңес береді.
Dialogue: 0,0:18:31.23,0:18:33.07,Default,,0000,0000,0000,,Спорт ұсынысы Сіз білесіз бе?
Dialogue: 0,0:18:34.56,0:18:36.81,Default,,0000,0000,0000,,Сунохара футбол ойнайды, мен баскетбол ойнаймын
Dialogue: 0,0:18:37.11,0:18:39.43,Default,,0000,0000,0000,,Алайда, мен бастаған бойда жұмысты тастадым.
Dialogue: 0,0:18:39.76,0:18:41.43,Default,,0000,0000,0000,,Кейбір жағдайлар бар.
Dialogue: 0,0:18:41.58,0:18:43.88,Default,,0000,0000,0000,,Баскетболды жек көретін болдыңыз ба?
Dialogue: 0,0:18:45.06,0:18:46.54,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:18:47.05,0:18:49.40,Default,,0000,0000,0000,,Мен көптен бері тесікке қол тигізбедім.
Dialogue: 0,0:18:51.29,0:18:56.91,Default,,0000,0000,0000,,Оказаки-сан, ертең сабақтан кейін менімен баскетбол ойнағың келе ме?
Dialogue: 0,0:18:57.31,0:18:57.77,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:57.89,0:19:00.95,Default,,0000,0000,0000,,Мен осындай болсам да, мен өте спортшымын.
Dialogue: 0,0:19:01.25,0:19:03.60,Default,,0000,0000,0000,,Мен сабақтан кейін жерде күтемін.
Dialogue: 0,0:19:03.87,0:19:05.10,Default,,0000,0000,0000,,О, жоқ, мен...
Dialogue: 0,0:19:05.58,0:19:07.00,Default,,0000,0000,0000,,Баскетбол ойнайық
Dialogue: 0,0:19:16.87,0:19:21.05,Default,,0000,0000,0000,,Олай болса ертең сабақтан кейін менімен баскетбол ойнағың келе ме?
Dialogue: 0,0:19:23.79,0:19:26.26,Default,,0000,0000,0000,,Оказаки, бүгін демалайық.
Dialogue: 0,0:19:26.57,0:19:28.63,Default,,0000,0000,0000,,Бәрібір сенбі күні жарты күндік сабақ.
Dialogue: 0,0:19:29.65,0:19:30.66,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:19:38.44,0:19:40.91,Default,,0000,0000,0000,,Сізді біраз уақыттан бері сыртта не уайымдап жүрсіз?
Dialogue: 0,0:19:46.78,0:19:48.84,Default,,0000,0000,0000,,Қолшатырыңды қарызға аламын, Сунохара.
Dialogue: 0,0:19:49.24,0:19:49.80,Default,,0000,0000,0000,,А?
Dialogue: 0,0:19:52.61,0:19:53.77,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:20:04.36,0:20:05.20,Default,,0000,0000,0000,,Кога!
Dialogue: 0,0:20:11.19,0:20:12.14,Default,,0000,0000,0000,,Mr. Okazaki
Dialogue: 0,0:20:12.36,0:20:13.53,Default,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,0:20:13.72,0:20:15.90,Default,,0000,0000,0000,,Жаңбыр жауып тұр, сондықтан үйге бару керек!!
Dialogue: 0,0:20:16.41,0:20:21.35,Default,,0000,0000,0000,,Бірақ мен жоқта Оказаки мырза келсе, мен оны көре алмаймын.
Dialogue: 0,0:20:21.71,0:20:23.68,Default,,0000,0000,0000,,Менің келетініме кепілдік жоқ!
Dialogue: 0,0:20:24.60,0:20:27.12,Default,,0000,0000,0000,,Бірақ...ол келді.
Dialogue: 0,0:20:28.85,0:20:32.27,Default,,0000,0000,0000,,Оказаки мырза маған әрқашан көмектеседі...
Dialogue: 0,0:20:33.00,0:20:36.13,Default,,0000,0000,0000,,Ендеше, ең болмағанда бірге баскетбол ойнай аламыз...
Dialogue: 0,0:20:36.51,0:20:37.75,Default,,0000,0000,0000,,Жақсылығыңыз үшін
Dialogue: 0,0:20:38.54,0:20:41.21,Default,,0000,0000,0000,,Жаңбырда осылай не істейсің?
Dialogue: 0,0:20:42.51,0:20:44.94,Default,,0000,0000,0000,,Олай болса, маған кадрды көрсетіңізші.
Dialogue: 0,0:20:46.47,0:20:47.89,Default,,0000,0000,0000,,Мен оны көргім келеді
Dialogue: 0,0:20:48.33,0:20:52.06,Default,,0000,0000,0000,,Мен бұрынғы баскетболшының оқ атқанын көрген емеспін.
Dialogue: 0,0:20:52.73,0:20:55.52,Default,,0000,0000,0000,,Осылайша сіз салқын түрде орнатып, соғыңыз.
Dialogue: 0,0:20:56.96,0:21:00.40,Default,,0000,0000,0000,,Мен сияқты, сен жерге лақтырушы емессің.
Dialogue: 0,0:21:27.52,0:21:29.78,Default,,0000,0000,0000,,...Оң қолымды көтере алмаймын.
Dialogue: 0,0:21:30.13,0:21:30.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:31.99,0:21:37.63,Default,,0000,0000,0000,,Мен орта мектептің үшінші курсында оқып жүргенімде әкеммен ұрысып қалып, оң иығымды ауыртып алдым.
Dialogue: 0,0:21:38.19,0:21:40.25,Default,,0000,0000,0000,,Иықтан жоғары көтерілмейді
Dialogue: 0,0:21:42.45,0:21:45.95,Default,,0000,0000,0000,,Мен енді баскетбол ойнай алмаймын...Мен
Dialogue: 0,0:21:49.27,0:21:52.14,Default,,0000,0000,0000,,Кешіріңіз...Мен...
Dialogue: 0,0:21:53.11,0:21:53.90,Default,,0000,0000,0000,,Кога…
Dialogue: 0,0:21:54.28,0:22:00.20,Default,,0000,0000,0000,,Мен...Мен Оказаки мырзаны мазаладым...барлық уақытта...
Dialogue: 0,0:22:00.68,0:22:01.33,Default,,0000,0000,0000,,Кога
Dialogue: 0,0:22:05.58,0:22:07.76,Default,,0000,0000,0000,,Кога... Кога!
Dialogue: 0,0:23:42.86,0:23:45.07,Default,,0000,0000,0000,,Сіз ақымақ шығарсыз, бірақ
Dialogue: 0,0:23:45.32,0:23:46.47,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:23:48.47,0:23:49.69,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:23:49.88,0:23:53.96,Default,,0000,0005,0000,,Әй, сен ондай нәрселерді шебер басқаратын түрің емессің ғой?
Dialogue: 0,0:23:54.25,0:23:55.37,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:23:55.37,0:23:57.71,Default,,0000,0000,0000,,Мен өз ойымды дәл айтатын адаммын.
Dialogue: 0,0:23:57.92,0:23:58.95,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:23:59.52,0:24:01.26,Default,,0000,0000,0000,,Кейде өзімді ашулы сезінемін.
Dialogue: 0,0:24:01.33,0:24:03.76,Default,,0000,0000,0000,,Сондықтан өз сөзіңізге сеніңіз
Dialogue: 0,0:24:04.81,0:24:05.40,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:24:05.92,0:24:07.74,Default,,0000,0000,0000,,Қолыңнан келгеннің бәрін істе, Нагиса Фурукава
Dialogue: 0,0:24:09.17,0:24:09.62,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:24:11.12,0:24:17.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
