Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.96,0:00:10.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:16.34,0:00:17.89,Default,,0,0,0,,Сухада...
Dialogue: 0,0:00:17.97,0:00:21.02,Default,,0,0,0,,Жоқ, ол адамдарға қатысты болмауы керек.
Dialogue: 0,0:00:21.52,0:00:24.77,Default,,0,0,0,,Біз вампирлерміз
Dialogue: 0,0:00:27.73,0:00:29.15,Default,,0,0,0,,Хааа~
Dialogue: 0,0:00:29.23,0:00:34.40,Default,,0,0,0,,Тікұшақтардың көмегімен аз уақыт ішінде барлығы тазартылды.
Dialogue: 0,0:00:35.78,0:00:37.74,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:00:38.45,0:00:39.66,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:00:39.74,0:00:41.45,Default,,0,0,0,,Бізге
Dialogue: 0,0:00:42.70,0:00:44.41,Default,,0,0,0,,Себебі бір сыр бар.
Dialogue: 0,0:00:44.50,0:00:46.29,Default,,0,0,0,,Е... иә!
Dialogue: 0,0:00:46.37,0:00:49.63,Default,,0,0,0,,Енді сен... менің басымдасың!
Dialogue: 0,0:00:50.13,0:00:50.96,Default,,0,0,0,,Телепатия
Dialogue: 0,0:00:51.05,0:00:53.21,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,0:00:53.30,0:00:54.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:54.17,0:00:55.93,Default,,0,0,0,,Негізі мен де...
Dialogue: 0,0:00:56.43,0:00:57.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:58.60,0:01:00.81,Default,,0,0,0,,Қолдарың суық болса, мен оларды жылытамын.
Dialogue: 0,0:01:00.89,0:01:02.10,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:01:07.23,0:01:09.27,Default,,0,0,0,,Мен өзімді осылай сезінемін
Dialogue: 0,0:01:12.98,0:01:15.40,Default,,0,0,0,,Осы уақытқа дейін осы күштің арқасында
Dialogue: 0,0:01:15.49,0:01:18.36,Default,,0,0,0,,Мені бірнеше рет вампир деп күдіктенген.
Dialogue: 0,0:01:18.91,0:01:21.79,Default,,0,0,0,,Бірақ мен жалғыз емес едім.
Dialogue: 0,0:01:21.87,0:01:25.50,Default,,0,0,0,,Тіпті адамдардың да тылсым күштері бар.
Dialogue: 0,0:01:27.25,0:01:32.42,Default,,0,0,0,,Крис, мен мұнда қалыпты студенттік өмір сүре аламын деп ойлаймын.
Dialogue: 0,0:01:42.14,0:01:43.31,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:01:43.39,0:01:44.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:50.69,0:01:53.86,Default,,0,0,0,,Қоқыс жинау орындары өте аз.
Dialogue: 0,0:01:53.94,0:01:58.28,Default,,0,0,0,,Біраз бұрын жақын жерде кісі өлтіру болды.
Dialogue: 0,0:01:58.36,0:02:01.66,Default,,0,0,0,,Бұл вампирлердің ісі деген қауесет бар.
Dialogue: 0,0:02:01.74,0:02:03.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:08.00,0:02:11.42,Default,,0,0,0,,Оны тез лақтырып, тез оралыңыз.
Dialogue: 0,0:02:15.76,0:02:17.76,Default,,0,0,0,,♪～
Dialogue: 0,0:03:42.22,0:03:44.22,Default,,0,0,0,,～♪
Dialogue: 0,0:03:50.02,0:03:52.44,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:53.31,0:03:54.35,Default,,0,0,0,,- (Хан) Мм... - Ха!
Dialogue: 0,0:03:58.32,0:03:59.28,Default,,0,0,0,,Аһ!
Dialogue: 0,0:03:59.36,0:04:01.53,Default,,0,0,0,,Не... не?!
Dialogue: 0,0:04:01.61,0:04:02.99,Default,,0,0,0,,Мүмкін вампир шығар?
Dialogue: 0,0:04:03.07,0:04:04.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:04.45,0:04:06.41,Default,,0,0,0,,Аа... қалыңызшы
Dialogue: 0,0:04:06.49,0:04:09.99,Default,,0,0,0,,Біркелкі киім? Бірақ бұл менің мектебім емес пе?
Dialogue: 0,0:04:10.08,0:04:10.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:11.16,0:04:12.00,Default,,0,0,0,,Хан!
Dialogue: 0,0:04:12.08,0:04:13.00,Default,,0,0,0,,Хан аға!
Dialogue: 0,0:04:14.54,0:04:16.63,Default,,0,0,0,,Тағы бір рет, өтінемін!
Dialogue: 0,0:04:17.71,0:04:19.34,Default,,0,0,0,,Жарайсың Хан!
Dialogue: 0,0:04:19.42,0:04:20.46,Default,,0,0,0,,- Ха! -На...
Dialogue: 0,0:04:21.46,0:04:23.30,Default,,0,0,0,,Иә? Қыз ба?
Dialogue: 0,0:04:23.38,0:04:24.22,Default,,0,0,0,,Гухо...
Dialogue: 0,0:04:26.55,0:04:27.55,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:28.05,0:04:29.85,Default,,0,0,0,,Нажак-ниисан!
Dialogue: 0,0:04:31.52,0:04:33.02,Default,,0,0,0,,Қап…
Dialogue: 0,0:04:33.10,0:04:36.69,Default,,0,0,0,,Уау~ Наджак-хёнды жеңгеніме де сене алар емеспін!
Dialogue: 0,0:04:36.77,0:04:37.77,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:04:37.86,0:04:40.69,Default,,0,0,0,,А... сендер кімсіңдер, жігіттер!
Dialogue: 0,0:04:40.78,0:04:41.82,Default,,0,0,0,,Сіз вампирсіз бе?
Dialogue: 0,0:04:41.90,0:04:43.49,Default,,0,0,0,,Не?
Dialogue: 0,0:04:43.57,0:04:45.36,Default,,0,0,0,,Жаңа айтқаныңыздан бас тартыңыз!
Dialogue: 0,0:04:45.86,0:04:47.78,Default,,0,0,0,,Біз вампир емеспіз
Dialogue: 0,0:04:48.28,0:04:49.53,Default,,0,0,0,,Engie-niisan
Dialogue: 0,0:04:49.62,0:04:52.04,Default,,0,0,0,,Мені дұрыс түсінбеуіңізді өтінемін.
Dialogue: 0,0:04:52.12,0:04:55.33,Default,,0,0,0,,Бұл біз үшін ең ауыр қорлық.
Dialogue: 0,0:04:55.42,0:04:56.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:56.75,0:04:59.92,Default,,0,0,0,,Мен вампирмен қателескенім үшін өзімді ешқашан кешіре алмаймын.
Dialogue: 0,0:05:00.00,0:05:01.67,Default,,0,0,0,,Ой…
Dialogue: 0,0:05:01.75,0:05:04.55,Default,,0,0,0,,Uuuuuuuuuuu I got goosebumps just listening to it!
Dialogue: 0,0:05:06.18,0:05:08.55,Default,,0,0,0,,Бұл дүниедегі кез келген нәрседен артық, біз...
Dialogue: 0,0:05:09.51,0:05:11.68,Default,,0,0,0,,Өйткені мен вампирлерді жек көремін
Dialogue: 0,0:05:12.18,0:05:14.06,Default,,0,0,0,,Э? Ах…
Dialogue: 0,0:05:15.35,0:05:16.77,Default,,0,0,0,,Мен де
Dialogue: 0,0:05:18.77,0:05:19.31,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,0:05:19.40,0:05:21.32,Default,,0,0,0,,Мен Sunshine City мектебінің оқушысымын.
Dialogue: 0,0:05:21.40,0:05:22.69,Default,,0,0,0,,Мен Ханмын
Dialogue: 0,0:05:22.78,0:05:24.24,Default,,0,0,0,,Бұл Наджак
Dialogue: 0,0:05:24.32,0:05:25.11,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:05:25.19,0:05:27.74,Default,,0,0,0,,Арттағы екі адам - Энги мен Тахер.
Dialogue: 0,0:05:27.82,0:05:29.62,Default,,0,0,0,,Сәлем, мен Энгимін.
Dialogue: 0,0:05:29.70,0:05:32.54,Default,,0,0,0,,Сіз кереметсіз. Сіз жекпе-жек өнерімен айналысасыз ба?
Dialogue: 0,0:05:32.62,0:05:34.41,Default,,0,0,0,,Иә... жақсы
Dialogue: 0,0:05:34.91,0:05:36.12,Default,,0,0,0,,Мен Сухамын
Dialogue: 0,0:05:36.62,0:05:38.88,Default,,0,0,0,,Бірақ сен біздің мектепке не үшін келдің?
Dialogue: 0,0:05:39.58,0:05:42.80,Default,,0,0,0,,Негізі біз белгілі бір істі тергеп жатқан едік...
Dialogue: 0,0:05:42.88,0:05:43.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:44.55,0:05:45.72,Default,,0,0,0,,Балалар сендер...
Dialogue: 0,0:05:45.80,0:05:48.68,Default,,0,0,0,,Ах Джака Ноа
Dialogue: 0,0:05:49.26,0:05:50.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:52.31,0:05:54.52,Default,,0,0,0,,Менің оқушымның не істегенін қалайсың?
Dialogue: 0,0:05:54.60,0:05:57.39,Default,,0,0,0,,Менің айтайын дегенім, сен мұнда не үшін келдің?
Dialogue: 0,0:05:57.48,0:05:58.85,Default,,0,0,0,,А, сіз білесіз бе...
Dialogue: 0,0:05:58.94,0:06:00.44,Default,,0,0,0,,Қандай мақсатта?
Dialogue: 0,0:06:00.52,0:06:01.77,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,0:06:01.86,0:06:02.90,Default,,0,0,0,,Тахер
Dialogue: 0,0:06:02.98,0:06:06.44,Default,,0,0,0,,Жақында болған кісі өлтіру туралы білесіз бе?
Dialogue: 0,0:06:06.53,0:06:08.61,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:06:09.11,0:06:11.66,Default,,0,0,0,,Қаза тапқан адам менің мектебімнің оқушысы болатын.
Dialogue: 0,0:06:11.74,0:06:12.45,Default,,0,0,0,,- Иә? - (Джака Ноа) А...
Dialogue: 0,0:06:13.33,0:06:14.62,Default,,0,0,0,,Сол себепті...
Dialogue: 0,0:06:14.70,0:06:16.50,Default,,0,0,0,,Оның бізге қатысы жоқ, солай ма?
Dialogue: 0,0:06:16.58,0:06:18.16,Default,,0,0,0,,Маңызды емес пе?
Dialogue: 0,0:06:18.25,0:06:20.37,Default,,0,0,0,,Ха... керісінше
Dialogue: 0,0:06:20.96,0:06:23.59,Default,,0,0,0,,Балалар сендер қатыспайсыңдар ма?
Dialogue: 0,0:06:25.09,0:06:28.80,Default,,0,0,0,,Жаңа айтқан сөзіңізге өкіну тым кеш.
Dialogue: 0,0:06:28.88,0:06:29.43,Default,,0,0,0,,Иә
Dialogue: 0,0:06:29.51,0:06:32.22,Default,,0,0,0,,Ай осылай жарық түнде келеді.
Dialogue: 0,0:06:32.72,0:06:35.85,Default,,0,0,0,,Өйткені сіз әдетте бізбен бәсекелесе алмайтыныңызды білесіз, солай ма?
Dialogue: 0,0:06:35.93,0:06:37.27,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:06:38.18,0:06:39.56,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:40.98,0:06:43.44,Default,,0,0,0,,Барлығы, тоқтаңдар! Ұрыспа!
Dialogue: 0,0:06:43.52,0:06:44.61,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:46.19,0:06:47.36,Default,,0,0,0,,Тоқтатылды ма?
Dialogue: 0,0:06:48.40,0:06:50.11,Default,,0,0,0,,Қандай құдірет!
Dialogue: 0,0:06:51.20,0:06:52.62,Default,,0,0,0,,Біз жай ғана
Dialogue: 0,0:06:52.70,0:06:55.12,Default,,0,0,0,,Мен сені қорлап жатыр деп ойладым...
Dialogue: 0,0:06:55.70,0:06:57.41,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:06:57.50,0:06:59.54,Default,,0,0,0,,Бізде кішкене түсініспеушілік болды.
Dialogue: 0,0:06:59.62,0:07:00.92,Default,,0,0,0,,Ендеше тоқтатыңыз!
Dialogue: 0,0:07:01.00,0:07:02.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:07.34,0:07:09.38,Default,,0,0,0,,Сіз бұл сағатта не істеп жатырсыз?
Dialogue: 0,0:07:09.47,0:07:10.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:12.26,0:07:14.51,Default,,0,0,0,,Ол... тікұшақ
Dialogue: 0,0:07:18.81,0:07:19.93,Default,,0,0,0,,Балалар
Dialogue: 0,0:07:20.81,0:07:23.19,Default,,0,0,0,,Қазір Сухадан кет.
Dialogue: 0,0:07:23.27,0:07:25.69,Default,,0,0,0,,Тікұшақ, жоқ па?
Dialogue: 0,0:07:25.77,0:07:28.57,Default,,0,0,0,,Мен қоқыс тастауға келгенде, кездейсоқ кездесіп қалдық...
Dialogue: 0,0:07:28.65,0:07:30.44,Default,,0,0,0,,Кішкене түсінбеушілік болды.
Dialogue: 0,0:07:31.45,0:07:32.99,Default,,0,0,0,,Бір жеріңіз ауырды ма?
Dialogue: 0,0:07:33.07,0:07:35.12,Default,,0,0,0,,Не? Мм... иә
Dialogue: 0,0:07:35.20,0:07:36.62,Default,,0,0,0,,жақсы болар еді
Dialogue: 0,0:07:37.33,0:07:38.87,Default,,0,0,0,,Бұл тым кеш және қауіпті.
Dialogue: 0,0:07:39.37,0:07:41.29,Default,,0,0,0,,Мен сені сонда жіберемін, тез үйге қайтайық.
Dialogue: 0,0:07:41.37,0:07:43.62,Default,,0,0,0,,Не? Сол кішкене...
Dialogue: 0,0:07:43.71,0:07:46.50,Default,,0,0,0,,Сәлем! Әңгіме әлі біткен жоқ.
Dialogue: 0,0:07:46.59,0:07:48.63,Default,,0,0,0,,Бізде сөйлесетін ештеңе жоқ.
Dialogue: 0,0:07:50.13,0:07:52.30,Default,,0,0,0,,Қазір бұл жерден кет.
Dialogue: 0,0:07:53.38,0:07:55.51,Default,,0,0,0,,Мен өз мектебімдегі жігітті өлтірдім.
Dialogue: 0,0:07:56.01,0:07:57.26,Default,,0,0,0,,Бұл сендерсіңдер, балалар.
Dialogue: 0,0:07:57.35,0:07:58.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:58.14,0:08:00.85,Default,,0,0,0,,Иә? «Жоқ» жеткіліксіз.
Dialogue: 0,0:08:00.93,0:08:02.69,Default,,0,0,0,,Біз мұны істемейміз.
Dialogue: 0,0:08:02.77,0:08:04.56,Default,,0,0,0,,Сіз дәлелдей алмайсыз ба?
Dialogue: 0,0:08:04.65,0:08:08.94,Default,,0,0,0,,Біздің кінәлі екендігімізге дәлел бар ма?
Dialogue: 0,0:08:12.40,0:08:14.95,Default,,0,0,0,,Мен сендерден басқа ешкімді ойламаймын.
Dialogue: 0,0:08:15.03,0:08:17.20,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:08:17.28,0:08:20.70,Default,,0,0,0,,Егер біз шынымен кінәлі болсақ...
Dialogue: 0,0:08:21.95,0:08:24.46,Default,,0,0,0,,Балалар, не істеуді жоспарлап отырсыңдар?
Dialogue: 0,0:08:25.04,0:08:25.88,Default,,0,0,0,,Тікұшақ…
Dialogue: 0,0:08:26.38,0:08:26.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:27.04,0:08:29.05,Default,,0,0,0,,Бұл сендерсіңдер!
Dialogue: 0,0:08:29.96,0:08:31.26,Default,,0,0,0,,Тоқта, тікұшақ!
Dialogue: 0,0:08:31.34,0:08:32.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:32.55,0:08:35.22,Default,,0,0,0,,Ұрыспа...
Dialogue: 0,0:08:35.76,0:08:37.01,Default,,0,0,0,,Тахер де
Dialogue: 0,0:08:37.09,0:08:38.89,Default,,0,0,0,,Барлығыңызды өтінемін!
Dialogue: 0,0:08:39.60,0:08:41.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:41.60,0:08:43.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:43.60,0:08:45.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:45.60,0:08:46.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:47.56,0:08:48.52,Default,,0,0,0,,Цк
Dialogue: 0,0:08:49.77,0:08:51.44,Default,,0,0,0,,Кешіріңіз Суха
Dialogue: 0,0:08:51.53,0:08:53.57,Default,,0,0,0,,Ах... тікұшақ...
Dialogue: 0,0:08:54.07,0:08:55.49,Default,,0,0,0,,Ұрыспас
Dialogue: 0,0:08:55.99,0:08:57.53,Default,,0,0,0,,Сізді таң қалдырғаны үшін кешіріңіз
Dialogue: 0,0:08:58.82,0:09:02.16,Default,,0,0,0,,Хан Оқиғаға қатысымыз жоқ.
Dialogue: 0,0:09:02.25,0:09:03.54,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:09:04.62,0:09:07.29,Default,,0,0,0,,Ха, сіз артқа шегіне аласыз ба?
Dialogue: 0,0:09:08.71,0:09:10.59,Default,,0,0,0,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:09:11.09,0:09:13.30,Default,,0,0,0,,Жақында түнгі доп ойыны келеді.
Dialogue: 0,0:09:15.13,0:09:17.30,Default,,0,0,0,,Ойынды сонда шешсек ше?
Dialogue: 0,0:09:17.39,0:09:21.43,Default,,0,0,0,,Жұдырықтасу емес, әділ спорт.
Dialogue: 0,0:09:22.47,0:09:23.31,Default,,0,0,0,,Суха
Dialogue: 0,0:09:23.39,0:09:24.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:24.77,0:09:27.02,Default,,0,0,0,,Ертерек сені таң қалдырғаны үшін менің кінәм болды.
Dialogue: 0,0:09:27.10,0:09:30.48,Default,,0,0,0,,Ах... сені лақтырып жібергенім үшін кешір.
Dialogue: 0,0:09:30.57,0:09:33.73,Default,,0,0,0,,Не? Суха Ханды қуып жіберді ме?
Dialogue: 0,0:09:33.82,0:09:36.61,Default,,0,0,0,,Мен сені бүгінге қалдырамын.
Dialogue: 0,0:09:36.70,0:09:38.24,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:09:38.32,0:09:39.12,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:40.37,0:09:42.79,Default,,0,0,0,,Оқиға мен түнгі доп әртүрлі.
Dialogue: 0,0:09:42.87,0:09:45.50,Default,,0,0,0,,Ең дұрысы, өз әрекеттеріңізге абай болыңыз.
Dialogue: 0,0:09:46.00,0:09:48.12,Default,,0,0,0,,Біз әрқашан бақылап отырамыз.
Dialogue: 0,0:09:48.71,0:09:52.30,Default,,0,0,0,,Және, әрине, мен сені түнгі ойында талқандаймын.
Dialogue: 0,0:09:52.80,0:09:54.88,Default,,0,0,0,,А, мен дайындаламын.
Dialogue: 0,0:09:56.42,0:09:57.47,Default,,0,0,0,,Балалар сендер үйге барасыңдар.
Dialogue: 0,0:09:57.55,0:10:00.18,Default,,0,0,0,,Не? Сіз шынымен осылай қайтасыз ба?
Dialogue: 0,0:10:02.10,0:10:03.89,Default,,0,0,0,,Хан, жақсысың ба?
Dialogue: 0,0:10:03.97,0:10:04.64,Default,,0,0,0,,О
Dialogue: 0,0:10:04.72,0:10:06.10,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:10:22.07,0:10:26.50,Default,,0,0,0,,Достарымды өлтіретін вампирден басқа ешкімді ойламаймын.
Dialogue: 0,0:10:29.00,0:10:31.21,Default,,0,0,0,,Ал маған ұнамайтыны
Dialogue: 0,0:10:31.29,0:10:33.46,Default,,0,0,0,,Түнгі балдағы жігіттер биыл тағы да ойнайды
Dialogue: 0,0:10:33.54,0:10:36.17,Default,,0,0,0,,Сіз жеңемін деп ойлайсыз.
Dialogue: 0,0:10:38.26,0:10:42.39,Default,,0,0,0,,Махан мен оның достары матч уақытында оралады, солай ма?
Dialogue: 0,0:10:42.47,0:10:43.68,Default,,0,0,0,,Хехехе
Dialogue: 0,0:10:43.76,0:10:45.77,Default,,0,0,0,,Мен сенің жеңуіңе жол бермеймін.
Dialogue: 0,0:10:46.97,0:10:48.35,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:49.27,0:10:49.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:54.65,0:10:57.36,Default,,0,0,0,,Кешіріңіз, мен бірдеңені есіме түсірдім.
Dialogue: 0,0:10:58.03,0:10:58.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:58.65,0:11:00.40,Default,,0,0,0,,Алдымен үйге бара аласыз ба?
Dialogue: 0,0:11:01.32,0:11:04.62,Default,,0,0,0,,Жарайды, бірақ олармен араласпа.
Dialogue: 0,0:11:05.49,0:11:06.99,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:11:09.25,0:11:11.00,Default,,0,0,0,,-Кешіріңіз, иә?
Dialogue: 0,0:11:11.08,0:11:14.63,Default,,0,0,0,,Мен сенің алдыңда төбелесуге тырыстым.
Dialogue: 0,0:11:14.71,0:11:18.13,Default,,0,0,0,,Жарайды, бірден тоқтадың.
Dialogue: 0,0:11:18.71,0:11:19.72,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:20.22,0:11:23.30,Default,,0,0,0,,Дұрыс? сондықтан бұл туралы алаңдамаңыз
Dialogue: 0,0:11:27.43,0:11:29.56,Default,,0,0,0,,Суха? Не болды?
Dialogue: 0,0:11:29.64,0:11:32.06,Default,,0,0,0,,Иә? Бұл ештеңе емес
Dialogue: 0,0:11:37.65,0:11:39.19,Default,,0,0,0,,Суха...
Dialogue: 0,0:11:39.28,0:11:42.32,Default,,0,0,0,,Жоқ, ол адамдарға қатысты болмауы керек.
Dialogue: 0,0:11:42.82,0:11:46.08,Default,,0,0,0,,Біз вампирлерміз
Dialogue: 0,0:11:54.33,0:11:56.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:20.23,0:12:21.03,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:12:21.11,0:12:22.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:22.74,0:12:24.78,Default,,0,0,0,,А... Енги?
Dialogue: 0,0:12:24.86,0:12:26.62,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:12:27.12,0:12:29.29,Default,,0,0,0,,Өткен жылғы түнгі доп ойынынан бері болды ма?
Dialogue: 0,0:12:30.58,0:12:31.29,Default,,0,0,0,,Оның сыртқы түрі...
Dialogue: 0,0:12:37.29,0:12:39.46,Default,,0,0,0,,Сен де қасқырсың ғой.
Dialogue: 0,0:12:39.55,0:12:40.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:40.63,0:12:41.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:41.88,0:12:44.30,Default,,0,0,0,,Оны жасырудың қажеті жоқ.
Dialogue: 0,0:12:44.84,0:12:47.34,Default,,0,0,0,,Мен де сен сияқты қасқырмын.
Dialogue: 0,0:12:47.43,0:12:50.26,Default,,0,0,0,,Мен сендерден ерекшемін.
Dialogue: 0,0:12:51.89,0:12:54.60,Default,,0,0,0,,Сіз вампирмен араласасыз ба?
Dialogue: 0,0:12:56.65,0:13:00.23,Default,,0,0,0,,Бұрын көргенім сенің маған көмектеспедің.
Dialogue: 0,0:13:00.73,0:13:03.44,Default,,0,0,0,,Мүмкін сіз мұны достарыңыздан жасырып жүрген шығарсыз?
Dialogue: 0,0:13:03.53,0:13:06.07,Default,,0,0,0,,Себебі мен сендермен ешнәрсеге араласқым келмейді.
Dialogue: 0,0:13:06.16,0:13:07.32,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:08.74,0:13:12.37,Default,,0,0,0,,Дегенмен, вампир мен қасқырдың араласуы сирек кездеседі.
Dialogue: 0,0:13:12.87,0:13:15.58,Default,,0,0,0,,Өйткені біз ұзақ уақыт бойы антпен жау болғанбыз, солай емес пе?
Dialogue: 0,0:13:17.67,0:13:20.71,Default,,0,0,0,,Нені меңзеп тұрғаныңызды түсіндіре аласыз ба?
Dialogue: 0,0:13:21.21,0:13:23.92,Default,,0,0,0,,Мен мұны не үшін айтуым керек?
Dialogue: 0,0:13:24.01,0:13:25.01,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:25.09,0:13:27.80,Default,,0,0,0,,Әрине, сіз жауап беруге міндетті емессіз.
Dialogue: 0,0:13:28.30,0:13:29.60,Default,,0,0,0,,Айтқың келмесе, жақсы.
Dialogue: 0,0:13:30.51,0:13:32.89,Default,,0,0,0,,Сіз мұны ертерек естідіңіз.
Dialogue: 0,0:13:32.97,0:13:36.27,Default,,0,0,0,,Өткен күні менің мектебімде бір оқушыны өлтірген оқиға туралы.
Dialogue: 0,0:13:37.39,0:13:38.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:39.61,0:13:43.07,Default,,0,0,0,,Жәбірленушінің мойнында айқын тіс іздері бар.
Dialogue: 0,0:13:43.15,0:13:46.24,Default,,0,0,0,,Оның денесінде бір тамшы қан қалмады.
Dialogue: 0,0:13:47.24,0:13:48.41,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:13:48.49,0:13:51.20,Default,,0,0,0,,Бұл біздің ісіміз деп айтасыз ба?
Dialogue: 0,0:13:53.29,0:13:55.96,Default,,0,0,0,,Біз мұны жасамас едік!
Dialogue: 0,0:13:56.04,0:13:58.25,Default,,0,0,0,,Хели де осылай деді.
Dialogue: 0,0:13:58.83,0:14:00.96,Default,,0,0,0,,Бірақ бұл жерде сен жалғызсың...
Dialogue: 0,0:14:01.04,0:14:02.59,Default,,0,0,0,,О, әрине
Dialogue: 0,0:14:03.09,0:14:05.84,Default,,0,0,0,,Кейде мен бұл жігерді сезінемін.
Dialogue: 0,0:14:06.42,0:14:08.38,Default,,0,0,0,,Балалар сендерге де солай емес пе?
Dialogue: 0,0:14:09.18,0:14:10.89,Default,,0,0,0,,Толық ай жақындаған сайын...
Dialogue: 0,0:14:11.80,0:14:15.89,Default,,0,0,0,,Әй, ай үлкен және жарық болатын осындай күнде...
Dialogue: 0,0:14:18.56,0:14:19.94,Default,,0,0,0,,Туа біткен инстинкт
Dialogue: 0,0:14:20.02,0:14:21.31,Default,,0,0,0,,Мен ауырып тұрмын, оған көмектесе алмаймын.
Dialogue: 0,0:14:21.40,0:14:24.40,Default,,0,0,0,,(Қасқырдың ұлыуы)
Dialogue: 0,0:14:25.78,0:14:28.45,Default,,0,0,0,,Сондықтан мен адамдарды ренжітпеймін.
Dialogue: 0,0:14:28.53,0:14:30.53,Default,,0,0,0,,Бізде де солай.
Dialogue: 0,0:14:30.61,0:14:32.62,Default,,0,0,0,,Басқа вампирлерден айырмашылығы
Dialogue: 0,0:14:33.33,0:14:36.00,Default,,0,0,0,,Жоқ, біздің көзқарасымыз бойынша
Dialogue: 0,0:14:36.08,0:14:38.12,Default,,0,0,0,,Басқа вампирлер біртүрлі екен.
Dialogue: 0,0:14:38.21,0:14:41.25,Default,,0,0,0,,Неліктен біз тек өзімізді ерекшеміз деп ойлаймыз?
Dialogue: 0,0:14:41.33,0:14:42.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:44.04,0:14:46.01,Default,,0,0,0,,Сіз дәл қазір не істедіңіз?
Dialogue: 0,0:14:46.09,0:14:49.26,Default,,0,0,0,,Қасқыр мен вампирдің араласуы туады деп естідім, солай ма?
Dialogue: 0,0:14:51.26,0:14:52.80,Default,,0,0,0,,Мен бұған жауап бере алмаймын.
Dialogue: 0,0:14:53.30,0:14:55.51,Default,,0,0,0,,Айтқың келмесе, айтудың қажеті жоқ.
Dialogue: 0,0:14:55.60,0:14:56.52,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:57.31,0:15:00.60,Default,,0,0,0,,Жауап бергім келмейтіні емес, жауап бере алмайтындығым.
Dialogue: 0,0:15:01.98,0:15:04.27,Default,,0,0,0,,Өйткені мен де...
Dialogue: 0,0:15:06.28,0:15:09.78,Default,,0,0,0,,Мен өз болмысымның не екенін білмеймін.
Dialogue: 0,0:15:14.28,0:15:17.54,Default,,0,0,0,,Бұл тек мен емес, менің барлық достарым
Dialogue: 0,0:15:20.12,0:15:23.63,Default,,0,0,0,,Біз бір жерде жаратылғандай.
Dialogue: 0,0:15:24.13,0:15:26.55,Default,,0,0,0,,Ұзақ түстен оянғандай
Dialogue: 0,0:15:28.17,0:15:29.88,Default,,0,0,0,,Мен де таң қалдым...
Dialogue: 0,0:15:32.38,0:15:35.93,Default,,0,0,0,,Қалай болғанда да, біздің оқиғаға қатысымыз жоқ.
Dialogue: 0,0:15:36.01,0:15:37.47,Default,,0,0,0,,Балалар, сендер бізсіңдер.
Dialogue: 0,0:15:37.56,0:15:39.93,Default,,0,0,0,,Менің ойымша, сен күдіктенесің, өйткені сен кінәлі сияқты вампирсің.
Dialogue: 0,0:15:40.52,0:15:43.27,Default,,0,0,0,,Біз оларды өзіміздің түріміз деп санамаймыз.
Dialogue: 0,0:15:43.77,0:15:44.94,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:45.73,0:15:48.94,Default,,0,0,0,,Мен де бұл оқиғаның рас екеніне сенемін.
Dialogue: 0,0:15:49.44,0:15:53.16,Default,,0,0,0,,Сіздердің кем дегенде жартыңыз біз сияқтысыздар.
Dialogue: 0,0:15:56.70,0:15:57.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:00.87,0:16:03.54,Default,,0,0,0,,Мен... бұл...
Dialogue: 0,0:16:04.04,0:16:05.13,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:05.88,0:16:07.88,Default,,0,0,0,,Жарайды, мен қазір кетуім керек.
Dialogue: 0,0:16:08.38,0:16:10.97,Default,,0,0,0,,Келесі кездескенде, тым болмаса амандасайық.
Dialogue: 0,0:16:12.26,0:16:13.05,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:16:16.51,0:16:17.30,Default,,0,0,0,,Гррр…
Dialogue: 0,0:16:18.60,0:16:21.10,Default,,0,0,0,,Ертерек келгеніңіз үшін рахмет.
Dialogue: 0,0:16:21.18,0:16:24.14,Default,,0,0,0,,Мен өз бетімше жаттығудан кейін өтіп бара жатқанмын.
Dialogue: 0,0:16:24.23,0:16:24.94,Default,,0,0,0,,Иә
Dialogue: 0,0:16:25.02,0:16:25.98,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:26.06,0:16:28.57,Default,,0,0,0,,Бірақ сіз тікұшақ туралы қайдан білдіңіз?
Dialogue: 0,0:16:28.65,0:16:29.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:30.78,0:16:31.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:33.61,0:16:37.07,Default,,0,0,0,,А... Мен де қасынан өтіп бара жатқанмын.
Dialogue: 0,0:16:37.16,0:16:39.66,Default,,0,0,0,,Дұрыс, рахмет
Dialogue: 0,0:16:40.16,0:16:42.33,Default,,0,0,0,,Тікұшақтың келгеніне қуаныштымын...
Dialogue: 0,0:16:42.41,0:16:43.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:43.58,0:16:45.33,Default,,0,0,0,,Не... бұл ештеңе емес!
Dialogue: 0,0:16:45.42,0:16:47.54,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:16:47.63,0:16:48.54,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:16:48.63,0:16:50.55,Default,,0,0,0,,Нұх пен Жакаға да қайырлы түн.
Dialogue: 0,0:16:50.63,0:16:52.67,Default,,0,0,0,,Не? А... аа
Dialogue: 0,0:16:52.76,0:16:53.67,Default,,0,0,0,,Иә
Dialogue: 0,0:16:55.72,0:16:57.09,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:16:57.18,0:16:58.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:59.64,0:17:01.77,Default,,0,0,0,,Бұл хандар туралы.
Dialogue: 0,0:17:02.27,0:17:05.10,Default,,0,0,0,,Мысалдағы оқиғада вампир өлтірген адам
Dialogue: 0,0:17:05.19,0:17:07.02,Default,,0,0,0,,Біз доспыз дедіңіз ғой, солай ма?
Dialogue: 0,0:17:07.10,0:17:08.48,Default,,0,0,0,,О
Dialogue: 0,0:17:08.56,0:17:12.40,Default,,0,0,0,,Бұл адамдар да вампирлерді жек көретін сияқты.
Dialogue: 0,0:17:12.90,0:17:15.78,Default,,0,0,0,,Сондықтан мен сені мен сияқты деп ойладым.
Dialogue: 0,0:17:15.86,0:17:17.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:17.61,0:17:22.91,Default,,0,0,0,,Менің де бір досымды баяғыда вампир өлтірген болатын.
Dialogue: 0,0:17:25.00,0:17:28.42,Default,,0,0,0,,Сондықтан мен де вампирлерді жек көремін.
Dialogue: 0,0:17:29.08,0:17:33.71,Default,,0,0,0,,А... Сондықтан мен Хан мен оның достарының сезімін түсіне алмаймын.
Dialogue: 0,0:17:33.80,0:17:36.38,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:17:37.22,0:17:39.01,Default,,0,0,0,,Бұл жолы қайырлы түн.
Dialogue: 0,0:17:41.43,0:17:42.97,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:46.06,0:17:48.60,Default,,0,0,0,,Менің досым өлтірілді...
Dialogue: 0,0:17:49.10,0:17:52.07,Default,,0,0,0,,Сол себепті сіз вампирлерді жек көрдіңіз бе?
Dialogue: 0,0:17:56.57,0:17:58.16,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:58.70,0:18:02.53,Default,,0,0,0,,Бүгін тым көп нәрсе болды.
Dialogue: 0,0:18:03.70,0:18:08.54,Default,,0,0,0,,Бірақ тікұшақтардың төбелеспегеніне қуаныштымын.
Dialogue: 0,0:18:09.42,0:18:13.05,Default,,0,0,0,,Бірақ не? Сол кезде...
Dialogue: 0,0:18:13.67,0:18:16.05,Default,,0,0,0,,Тікұшақ ештеңе істемеді.
Dialogue: 0,0:18:16.13,0:18:19.05,Default,,0,0,0,,Неге екені белгісіз, бірден тоқтау керек сияқты болдым.
Dialogue: 0,0:18:19.64,0:18:23.51,Default,,0,0,0,,Әйтпесе, бір сұмдық болады...
Dialogue: 0,0:18:24.14,0:18:26.56,Default,,0,0,0,,Суха, әрине, қалыпты емес.
Dialogue: 0,0:18:26.64,0:18:28.35,Default,,0,0,0,,Ура!
Dialogue: 0,0:18:28.44,0:18:30.69,Default,,0,0,0,,Өйткені сенде мен сияқты адамнан тыс күш бар.
Dialogue: 0,0:18:30.77,0:18:32.90,Default,,0,0,0,,Олар – Құдайдың үкімі еді.
Dialogue: 0,0:18:32.98,0:18:34.32,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:18:37.36,0:18:39.40,Default,,0,0,0,,Өз бетінше жаттығудан үйге қайтар жолда...
Dialogue: 0,0:18:39.49,0:18:40.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:41.16,0:18:44.83,Default,,0,0,0,,Мен керемет күш-қуатты сезіндім және сонда бардым.
Dialogue: 0,0:18:46.04,0:18:47.96,Default,,0,0,0,,Сол бала сонда болды.
Dialogue: 0,0:18:48.46,0:18:52.88,Default,,0,0,0,,Бұл мен бұрын-соңды сезінбеген керемет қуат болды.
Dialogue: 0,0:18:53.71,0:18:55.09,Default,,0,0,0,,А...
Dialogue: 0,0:18:55.17,0:18:58.97,Default,,0,0,0,,Ал мен сол жігіттермен төбелесіп қала жаздадым.
Dialogue: 0,0:18:59.05,0:19:00.63,Default,,0,0,0,,Суха мені тоқтатты.
Dialogue: 0,0:19:01.22,0:19:02.26,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:02.85,0:19:05.51,Default,,0,0,0,,Барлығы, тоқтаңдар! Ұрыспа!
Dialogue: 0,0:19:06.18,0:19:09.27,Default,,0,0,0,,Оның бұл сөздерінен бір сәт тоңып қалдым.
Dialogue: 0,0:19:09.77,0:19:11.85,Default,,0,0,0,,Байланғандай
Dialogue: 0,0:19:12.60,0:19:13.65,Default,,0,0,0,,О
Dialogue: 0,0:19:14.15,0:19:15.27,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:18.28,0:19:19.86,Default,,0,0,0,,Ах
Dialogue: 0,0:19:20.61,0:19:23.24,Default,,0,0,0,,Солон, сен қайда болдың?
Dialogue: 0,0:19:23.32,0:19:26.74,Default,,0,0,0,,Неге менің бөлмеме тағы жиналып жатырсың?
Dialogue: 0,0:19:26.83,0:19:30.33,Default,,0,0,0,,Әй, бұрын жиналатын ескі бөлме.
Dialogue: 0,0:19:30.41,0:19:31.83,Default,,0,0,0,,Өйткені Суха оны пайдаланып жатыр.
Dialogue: 0,0:19:31.92,0:19:33.21,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:19:33.29,0:19:35.96,Default,,0,0,0,,Сондай-ақ, бұл бөлме ең таза.
Dialogue: 0,0:19:36.04,0:19:37.71,Default,,0,0,0,,Орналасқан жері де дәл ортасында, солай ма?
Dialogue: 0,0:19:37.80,0:19:40.05,Default,,0,0,0,,Ортада десең, Шионның бөлмесі.
Dialogue: 0,0:19:40.13,0:19:44.60,Default,,0,0,0,,Жоқ, мен оны кейін тазалауым керек.
Dialogue: 0,0:19:44.68,0:19:46.97,Default,,0,0,0,,Сіз өткен күні айттыңыз.
Dialogue: 0,0:19:47.06,0:19:50.27,Default,,0,0,0,,Мен бұл дүниеде тазалауды жақсы көремін.
Dialogue: 0,0:19:50.35,0:19:51.98,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:19:52.06,0:19:53.77,Default,,0,0,0,,Сол кезде менің жүрегімде
Dialogue: 0,0:19:53.85,0:19:55.65,Default,,0,0,0,,«Бұл өтірік», - деп күбірледім.
Dialogue: 0,0:19:55.73,0:19:56.77,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:19:56.86,0:19:58.48,Default,,0,0,0,,Солоннан
Dialogue: 0,0:19:58.57,0:20:00.99,Default,,0,0,0,,Менің мектебіме қасқыр келді.
Dialogue: 0,0:20:01.95,0:20:04.11,Default,,0,0,0,,А... солай сияқты
Dialogue: 0,0:20:04.20,0:20:06.78,Default,,0,0,0,,Иә? Сіз қалай білесіз?
Dialogue: 0,0:20:06.87,0:20:09.20,Default,,0,0,0,,А... жоқ, әйтеуір
Dialogue: 0,0:20:09.70,0:20:12.21,Default,,0,0,0,,Сол жігіттердің иісі шықты.
Dialogue: 0,0:20:12.29,0:20:14.54,Default,,0,0,0,,Тіпті осы уақытқа дейін
Dialogue: 0,0:20:14.63,0:20:17.13,Default,,0,0,0,,Вампирлердің адамдарға шабуыл жасайтын оқиғалары көп.
Dialogue: 0,0:20:17.63,0:20:20.71,Default,,0,0,0,,Бізге тағы да күдік туғандай.
Dialogue: 0,0:20:20.80,0:20:23.97,Default,,0,0,0,,Бірақ біз қан ішеміз...
Dialogue: 0,0:20:24.05,0:20:25.97,Default,,0,0,0,,А, дәл сол күні.
Dialogue: 0,0:20:26.05,0:20:29.26,Default,,0,0,0,,Мен оларға күдіктенбей тұра алмаймын.
Dialogue: 0,0:20:30.02,0:20:30.72,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:20:31.52,0:20:35.56,Default,,0,0,0,,Мен Суханың мені дұрыс түсінбегенін немесе сол үшін мені жек көргенін қаламаймын.
Dialogue: 0,0:20:45.66,0:20:47.62,Default,,0,0,0,,Хан аға!
Dialogue: 0,0:20:48.12,0:20:49.91,Default,,0,0,0,,А, мен қазір барамын.
Dialogue: 0,0:20:49.99,0:20:51.33,Default,,0,0,0,,Хаа…
Dialogue: 0,0:20:51.41,0:20:54.58,Default,,0,0,0,,Сол қызбен араласпа дедім ғой.
Dialogue: 0,0:20:54.67,0:20:58.50,Default,,0,0,0,,Бірақ сендер балалар! қабілеттеріңізді көрсетіңіз
Dialogue: 0,0:20:58.59,0:20:59.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:59.42,0:21:02.38,Default,,0,0,0,,Солон да бізге өзінің қабілетін көрсетпейді.
Dialogue: 0,0:21:02.46,0:21:03.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:03.55,0:21:06.43,Default,,0,0,0,,Сонымен, сіз қарапайым адамсыз ба?
Dialogue: 0,0:21:06.51,0:21:08.43,Default,,0,0,0,,Онда мен сені тістеймін.
Dialogue: 0,0:21:08.51,0:21:09.68,Default,,0,0,0,,Гаруруруру~
Dialogue: 0,0:21:09.76,0:21:11.10,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:21:11.18,0:21:13.23,Default,,0,0,0,,Әзіл
Dialogue: 0,0:21:13.31,0:21:15.23,Default,,0,0,0,,Мен Солонға сенемін.
Dialogue: 0,0:21:15.31,0:21:18.90,Default,,0,0,0,,Солон бұл дүниеде басқалардан гөрі адамдарды тепкілеуде жақсы, солай ма?
Dialogue: 0,0:21:18.98,0:21:21.53,Default,,0,0,0,,Бұл шынымен де керемет қабілет.
Dialogue: 0,0:21:21.61,0:21:22.94,Default,,0,0,0,,Өлтіру...
Dialogue: 0,0:21:23.53,0:21:25.07,Default,,0,0,0,,Қалай болғанда да, артық емес
Dialogue: 0,0:21:25.15,0:21:27.49,Default,,0,0,0,,Мен дұрыс түсінбейтін ештеңе істегім келмейді.
Dialogue: 0,0:21:27.57,0:21:28.99,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:21:29.07,0:21:30.62,Default,,0,0,0,,Мен Суханың мені жек көргенін қаламаймын.
Dialogue: 0,0:21:30.70,0:21:33.70,Default,,0,0,0,,Олай болса, балалар, сәлемдесу керек.
Dialogue: 0,0:21:33.79,0:21:35.25,Default,,0,0,0,,Көп сөйлеме
Dialogue: 0,0:21:35.33,0:21:36.71,Default,,0,0,0,,Тым таныс болмаңыз!
Dialogue: 0,0:21:39.54,0:21:41.04,Default,,0,0,0,,Солон дұрыс айтады.
Dialogue: 0,0:21:41.13,0:21:41.75,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:21:41.84,0:21:45.30,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:21:47.55,0:21:48.97,Default,,0,0,0,,Суха~
Dialogue: 0,0:21:49.05,0:21:52.60,Default,,0,0,0,,Осы демалыс күндері менімен бірге қыдырғың келе ме?
Dialogue: 0,0:21:55.06,0:21:55.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:55.98,0:21:57.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:21.40,0:23:23.40,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.08,0:23:37.49,Default,,0,0,0,,Келесі 3 эпизод
Dialogue: 0,0:23:37.58,0:23:40.37,Default,,0,0,0,,«Жарты ай - Жүгіру күні-»
Dialogue: 0,0:23:41.87,0:23:47.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory