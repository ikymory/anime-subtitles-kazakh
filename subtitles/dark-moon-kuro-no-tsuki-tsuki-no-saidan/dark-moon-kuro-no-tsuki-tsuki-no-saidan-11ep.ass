Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.66,0:00:03.21,Default,,0,0,0,,Сіз...
Dialogue: 0,0:00:03.79,0:00:06.25,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:00:07.42,0:00:09.88,Default,,0,0,0,,Ликантроп
Dialogue: 0,0:00:13.72,0:00:15.51,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:00:17.72,0:00:21.10,Default,,0,0,0,,Мен... мені іздедім.
Dialogue: 0,0:00:21.18,0:00:22.48,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:22.56,0:00:24.85,Default,,0,0,0,,Білсең, тез сөйле.
Dialogue: 0,0:00:24.94,0:00:27.73,Default,,0,0,0,,Бізге қосылуға қош келдіңіз!
Dialogue: 0,0:00:28.86,0:00:29.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:29.73,0:00:31.32,Default,,0,0,0,,- Наджак-хён! - (Хан) Нажак!
Dialogue: 0,0:00:32.44,0:00:33.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:33.40,0:00:36.57,Default,,0,0,0,,Маған шабуыл жасамағаныңыз дұрыс.
Dialogue: 0,0:00:37.32,0:00:42.04,Default,,0,0,0,,Ай құрбандық үстелінде әлі де көптеген достарыңыз бар.
Dialogue: 0,0:00:42.12,0:00:44.66,Default,,0,0,0,,Олармен не болуы керек?
Dialogue: 0,0:00:44.75,0:00:45.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:45.58,0:00:46.96,Default,,0,0,0,,Бір нәрсені тыңдауға рұқсат етіңіз.
Dialogue: 0,0:00:47.04,0:00:48.33,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:00:49.79,0:00:52.67,Default,,0,0,0,,Бұл ел... жоқ...
Dialogue: 0,0:00:53.17,0:00:55.88,Default,,0,0,0,,Осы дүниенің патшасы болу
Dialogue: 0,0:00:55.97,0:00:57.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:01.77,0:01:05.23,Default,,0,0,0,,Ол үшін маған сенің қаның керек.
Dialogue: 0,0:01:06.69,0:01:08.73,Default,,0,0,0,,Маған сенімен бірге келуге рұқсат ет.
Dialogue: 0,0:01:11.36,0:01:12.65,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:01:13.15,0:01:17.61,Default,,0,0,0,,Мен таққа отырғанда вампирлер ғана емес
Dialogue: 0,0:01:17.70,0:01:21.20,Default,,0,0,0,,Мен де сендерді қасқырларға бағыныштымын.
Dialogue: 0,0:01:21.28,0:01:22.79,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:01:24.41,0:01:25.71,Default,,0,0,0,,Мен барудың орнына...
Dialogue: 0,0:01:25.79,0:01:26.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:26.58,0:01:30.75,Default,,0,0,0,,Достарыңа ешқашан тиіспеймін деп уәде бер.
Dialogue: 0,0:01:30.84,0:01:33.88,Default,,0,0,0,,О, жарайды.
Dialogue: 0,0:01:36.80,0:01:39.26,Default,,0,0,0,,Жарайды, мен сенің айтқаныңды орындаймын.
Dialogue: 0,0:01:39.34,0:01:40.60,Default,,0,0,0,,Хан аға!
Dialogue: 0,0:01:40.68,0:01:41.55,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:41.64,0:01:43.60,Default,,0,0,0,,Хан! Сіз әлі...
Dialogue: 0,0:01:46.23,0:01:48.73,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:01:50.81,0:01:53.48,Default,,0,0,0,,Наджакты сұраңыз
Dialogue: 0,0:01:53.57,0:01:55.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:08.04,0:02:10.12,Default,,0,0,0,,Онда барайық.
Dialogue: 0,0:02:13.46,0:02:16.30,Default,,0,0,0,,Танығыңыз келетін адамдар бар.
Dialogue: 0,0:02:32.81,0:02:34.82,Default,,0,0,0,,♪～
Dialogue: 0,0:03:59.48,0:04:01.49,Default,,0,0,0,,～♪
Dialogue: 0,0:04:06.99,0:04:11.91,Default,,0,0,0,,(Тікұшақтардың ауыр тыныс алуы)
Dialogue: 0,0:04:13.21,0:04:15.42,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:04:16.00,0:04:16.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:16.75,0:04:18.80,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:04:19.50,0:04:21.17,Default,,0,0,0,,Шион, жақсысың ба?
Dialogue: 0,0:04:21.26,0:04:22.80,Default,,0,0,0,,- Иә? -Гохо...
Dialogue: 0,0:04:22.88,0:04:24.26,Default,,0,0,0,,Ал, көзіңді жұм.
Dialogue: 0,0:04:24.34,0:04:26.93,Default,,0,0,0,,Суха сені қайтадан емдейтініне сенімдімін.
Dialogue: 0,0:04:27.76,0:04:32.77,Default,,0,0,0,,Жоқ... Жараның баяу жазыла бастағанын сеземін.
Dialogue: 0,0:04:33.27,0:04:36.65,Default,,0,0,0,,Сезіп тұрмын... Қолыма еш күш ала алмаймын.
Dialogue: 0,0:04:36.73,0:04:38.86,Default,,0,0,0,,О, мен де.
Dialogue: 0,0:04:39.57,0:04:42.53,Default,,0,0,0,,Жоқ... Сухаға бірдеңе болды.
Dialogue: 0,0:04:42.61,0:04:43.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:43.90,0:04:44.99,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,0:04:45.07,0:04:47.03,Default,,0,0,0,,А... бірдеңе келе жатыр.
Dialogue: 0,0:04:48.62,0:04:54.25,Default,,0,0,0,,(Бірнеше адамның жүгіріп келе жатқан аяқ дыбысы)
Dialogue: 0,0:04:54.75,0:04:55.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:55.37,0:04:57.21,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:04:57.29,0:04:59.25,Default,,0,0,0,,Балалар, мұнда неге келдіңдер?
Dialogue: 0,0:04:59.34,0:05:00.75,Default,,0,0,0,,Балалар
Dialogue: 0,0:05:03.88,0:05:05.05,Default,,0,0,0,,Дардан ханға?
Dialogue: 0,0:05:06.30,0:05:07.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:07.84,0:05:09.18,Default,,0,0,0,,Артық уақыт жоқ
Dialogue: 0,0:05:10.05,0:05:11.35,Default,,0,0,0,,Толық ай шыққанда...
Dialogue: 0,0:05:11.93,0:05:13.39,Default,,0,0,0,,Оның күші бар
Dialogue: 0,0:05:13.47,0:05:15.31,Default,,0,0,0,,Менің ойымша, жеңу мүмкіндігі жоқ.
Dialogue: 0,0:05:15.39,0:05:17.27,Default,,0,0,0,,Мұндай жағдай болуы мүмкін бе?
Dialogue: 0,0:05:17.35,0:05:18.10,Default,,0,0,0,,Иә
Dialogue: 0,0:05:18.19,0:05:19.69,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:05:20.19,0:05:22.57,Default,,0,0,0,,Суха ханшайым болған
Dialogue: 0,0:05:31.70,0:05:32.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:32.62,0:05:34.54,Default,,0,0,0,,(Қасқырлар айқайлайды)
Dialogue: 0,0:05:34.62,0:05:35.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:35.83,0:05:36.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:38.92,0:05:40.33,Default,,0,0,0,,Суха!
Dialogue: 0,0:05:44.42,0:05:47.13,Default,,0,0,0,,Мен тым көп күш бердім бе?
Dialogue: 0,0:05:48.13,0:05:49.59,Default,,0,0,0,,Бұл Серен ханшайым.
Dialogue: 0,0:05:49.68,0:05:51.18,Default,,0,0,0,,Сіз менімен кездескіңіз келді, солай ма?
Dialogue: 0,0:05:51.26,0:05:52.60,Default,,0,0,0,,Серен ханшайым?
Dialogue: 0,0:05:52.68,0:05:55.89,Default,,0,0,0,,О, сен білмедің.
Dialogue: 0,0:05:55.98,0:05:59.15,Default,,0,0,0,,Олай болса, маған хабарлаңыз.
Dialogue: 0,0:06:01.48,0:06:04.53,Default,,0,0,0,,Ежелгі патшалықтан шыққан ханшайымның реинкарнациясы?
Dialogue: 0,0:06:04.61,0:06:06.07,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:06.15,0:06:08.53,Default,,0,0,0,,Оны сіз де сезген боларсыз.
Dialogue: 0,0:06:08.61,0:06:11.78,Default,,0,0,0,,Суханың бізді қозғайтын күші бар.
Dialogue: 0,0:06:11.87,0:06:13.16,Default,,0,0,0,,Барлығыңызды өтінемін!
Dialogue: 0,0:06:17.37,0:06:19.58,Default,,0,0,0,,Ал біз
Dialogue: 0,0:06:19.67,0:06:22.38,Default,,0,0,0,,Ол инстинктивті түрде оны қорғауға тырысады.
Dialogue: 0,0:06:22.46,0:06:23.92,Default,,0,0,0,,Әрине
Dialogue: 0,0:06:24.00,0:06:27.72,Default,,0,0,0,,Сонымен... сіз де Суха сияқты реинкарнацияланасыз ба?
Dialogue: 0,0:06:27.80,0:06:30.13,Default,,0,0,0,,Жоқ, біз...
Dialogue: 0,0:06:31.22,0:06:34.18,Default,,0,0,0,,Серен ханшайым соңғы күшін жинайды.
Dialogue: 0,0:06:34.76,0:06:39.19,Default,,0,0,0,,Ол біздің жанымызды ғасырлар бойы болашаққа ұшыру арқылы құтқарды.
Dialogue: 0,0:06:43.77,0:06:48.69,Default,,0,0,0,,Содан кейін жүздеген жылдар бойы біз бұл естелікті ұмыттық.
Dialogue: 0,0:06:49.49,0:06:52.49,Default,,0,0,0,,Өзіңіздің вампир екеніңізді басқалардан жасыруды жалғастыру
Dialogue: 0,0:06:52.99,0:06:55.16,Default,,0,0,0,,Мен осы уақытқа дейін осылай өмір сүрдім
Dialogue: 0,0:06:55.66,0:07:00.92,Default,,0,0,0,,Неліктен бар екенімізді білмей-ақ
Dialogue: 0,0:07:01.42,0:07:04.92,Default,,0,0,0,,Бірақ ханшайым Суха болып қайта туды.
Dialogue: 0,0:07:05.00,0:07:08.80,Default,,0,0,0,,Бізбен кездесу өткен күндерді еске түсірді.
Dialogue: 0,0:07:09.30,0:07:14.10,Default,,0,0,0,,Патшалық құлағанда не болды?
Dialogue: 0,0:07:14.60,0:07:18.68,Default,,0,0,0,,Біз де Суханы қорғау үшін сол жерде болдық.
Dialogue: 0,0:07:18.77,0:07:22.85,Default,,0,0,0,,Дарданмен келісетін уақыт келді.
Dialogue: 0,0:07:22.94,0:07:24.36,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:07:24.86,0:07:25.90,Default,,0,0,0,,О
Dialogue: 0,0:07:28.90,0:07:30.36,Default,,0,0,0,,Суха...
Dialogue: 0,0:07:31.03,0:07:32.53,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:07:32.61,0:07:35.07,Default,,0,0,0,,Қаныңызды алайын ба?
Dialogue: 0,0:07:39.75,0:07:41.58,Default,,0,0,0,,Маған бермесең...
Dialogue: 0,0:07:42.83,0:07:43.83,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:46.38,0:07:49.34,Default,,0,0,0,,Мен Хан үшін уайымдаймын...
Dialogue: 0,0:07:50.01,0:07:52.30,Default,,0,0,0,,Мен ешқашан қасқырға айналған емеспін.
Dialogue: 0,0:07:52.38,0:07:53.34,Default,,0,0,0,,А...
Dialogue: 0,0:07:56.35,0:07:57.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:05.35,0:08:06.69,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:11.24,0:08:11.78,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:18.62,0:08:20.20,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:28.13,0:08:29.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:37.76,0:08:40.97,Default,,0,0,0,,Бұл Балғаның қанының құдіреті!
Dialogue: 0,0:08:41.68,0:08:42.85,Default,,0,0,0,,Суха! Сенімен бәрі жақсы ма?
Dialogue: 0,0:08:42.93,0:08:44.44,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:08:44.52,0:08:48.23,Default,,0,0,0,,Ханшайымға қол тигізуге болады деп кім айтты?
Dialogue: 0,0:08:48.31,0:08:49.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:55.24,0:08:57.62,Default,,0,0,0,,Әй, сен Сухаға не істедің!
Dialogue: 0,0:08:57.70,0:08:59.16,Default,,0,0,0,,Мен айттым ғой, солай ма?
Dialogue: 0,0:08:59.24,0:09:04.91,Default,,0,0,0,,Сіздің мінез-құлқыңызға қарай достарыңыздың өмірі жойылады.
Dialogue: 0,0:09:05.92,0:09:07.83,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:07.92,0:09:10.67,Default,,0,0,0,,Ликантроп ретінде
Dialogue: 0,0:09:10.75,0:09:14.97,Default,,0,0,0,,Мен достарымның өлгенін қарап тұра алмаймын.
Dialogue: 0,0:09:15.05,0:09:16.30,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:09:16.38,0:09:17.09,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:18.01,0:09:20.85,Default,,0,0,0,,Ханшайымнан аулақ жүр
Dialogue: 0,0:09:21.93,0:09:22.60,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:26.23,0:09:28.52,Default,,0,0,0,,Мен саған кет дедім...
Dialogue: 0,0:09:28.60,0:09:30.52,Default,,0,0,0,,- (Хан) Арғх! -Мені естімей тұрсың ба?
Dialogue: 0,0:09:30.61,0:09:32.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:32.23,0:09:34.15,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:09:34.24,0:09:37.66,Default,,0,0,0,,Сенің де ханшайымға деген сезімің бар, солай ма?
Dialogue: 0,0:09:37.74,0:09:39.07,Default,,0,0,0,,- Ал егер! -(Хан) Ой...
Dialogue: 0,0:09:39.16,0:09:42.54,Default,,0,0,0,,Өз адамдарыңды тастап кетсең де, ханшайымды құтқару керек!
Dialogue: 0,0:09:43.24,0:09:45.41,Default,,0,0,0,,Өйткені екеуінің бірін таңдай алмаймын.
Dialogue: 0,0:09:45.50,0:09:48.42,Default,,0,0,0,,Екеуі де! Мен сені құтқара алмаймын!
Dialogue: 0,0:09:48.50,0:09:51.04,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:09:51.13,0:09:52.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:53.55,0:09:58.93,Default,,0,0,0,,(Ханның зары)
Dialogue: 0,0:09:59.01,0:10:00.93,Default,,0,0,0,,(Барлығы ауыр тыныс алады)
Dialogue: 0,0:10:01.01,0:10:03.26,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:10:03.35,0:10:04.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:04.89,0:10:05.85,Default,,0,0,0,,Күн...
Dialogue: 0,0:10:24.54,0:10:28.21,Default,,0,0,0,,Қазір бәрі өз орнында
Dialogue: 0,0:10:29.00,0:10:30.21,Default,,0,0,0,,Емле
Dialogue: 0,0:10:30.79,0:10:32.46,Default,,0,0,0,,Ханшайым да
Dialogue: 0,0:10:32.54,0:10:34.42,Default,,0,0,0,,Балгтың қаны да
Dialogue: 0,0:10:38.76,0:10:43.51,Default,,0,0,0,,Түнгі аспанда толық ай көтерілгенде
Dialogue: 0,0:10:44.10,0:10:49.69,Default,,0,0,0,,Егер сіз заклинание айтсаңыз, құрбандық үстелінде мөрленген қуат босатылады.
Dialogue: 0,0:10:50.19,0:10:52.61,Default,,0,0,0,,Ханшайымға берілді
Dialogue: 0,0:10:53.81,0:10:57.11,Default,,0,0,0,,Және күш
Dialogue: 0,0:10:57.78,0:10:59.32,Default,,0,0,0,,I
Dialogue: 0,0:11:05.24,0:11:09.33,Default,,0,0,0,,Менде көбірек... күш болса
Dialogue: 0,0:11:13.08,0:11:15.17,Default,,0,0,0,,Ликантроп
Dialogue: 0,0:11:15.67,0:11:16.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:16.92,0:11:19.47,Default,,0,0,0,,Ликантроп
Dialogue: 0,0:11:20.13,0:11:21.72,Default,,0,0,0,,Бұл дауыс...
Dialogue: 0,0:11:27.43,0:11:29.98,Default,,0,0,0,,Ликантроп
Dialogue: 0,0:11:30.48,0:11:31.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:33.56,0:11:39.32,Default,,0,0,0,,Мен, қасқыр құдай Балгтың қанын мұрагер сенсің.
Dialogue: 0,0:11:40.78,0:11:45.66,Default,,0,0,0,,Біздің нәсілге ай сияқтысың.
Dialogue: 0,0:11:45.74,0:11:49.33,Default,,0,0,0,,Жарыстың күшін оятады.
Dialogue: 0,0:11:49.41,0:11:52.29,Default,,0,0,0,,Бірақ мұны қалай істеуге болады...
Dialogue: 0,0:11:53.04,0:11:57.00,Default,,0,0,0,,Сенің түйсігің бәрін айтып береді.
Dialogue: 0,0:11:57.50,0:12:02.38,Default,,0,0,0,,Жаңғыртып әркімге, Нәсіліміздің ай болып.
Dialogue: 0,0:12:02.88,0:12:08.14,Default,,0,0,0,,Сіз қызмет ететін ханшайымды қорғау үшін осы күшті пайдаланыңыз.
Dialogue: 0,0:12:29.12,0:12:33.04,Default,,0,0,0,,Мен Барг қанының мұрагерімін.
Dialogue: 0,0:12:43.42,0:12:44.47,Default,,0,0,0,,Керемет!
Dialogue: 0,0:12:44.55,0:12:45.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.51,0:12:49.47,Default,,0,0,0,,Міне!
Dialogue: 0,0:12:49.56,0:12:51.27,Default,,0,0,0,,Ликантроп
Dialogue: 0,0:12:54.02,0:12:55.94,Default,,0,0,0,,Ликантроп!
Dialogue: 0,0:12:56.02,0:12:58.65,Default,,0,0,0,,Ол бізге көмектесуге келді!
Dialogue: 0,0:12:59.48,0:13:02.23,Default,,0,0,0,,(Хан айқайы)
Dialogue: 0,0:13:02.32,0:13:06.74,Default,,0,0,0,,(Қасқырлар айқайлайды)
Dialogue: 0,0:13:08.82,0:13:10.78,Default,,0,0,0,,Барлығы жүгіреді!
Dialogue: 0,0:13:10.87,0:13:12.04,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:13:16.29,0:13:17.33,Default,,0,0,0,,Ууууу...
Dialogue: 0,0:13:20.54,0:13:22.09,Default,,0,0,0,,Қандай ысырап!
Dialogue: 0,0:13:23.05,0:13:23.59,Default,,0,0,0,,Аға… Көмектес маған
Dialogue: 0,0:13:27.13,0:13:30.97,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:13:31.06,0:13:33.22,Default,,0,0,0,,-Арх! -(Хан) Гууууу...
Dialogue: 0,0:13:33.72,0:13:35.31,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,0:13:35.39,0:13:38.56,Default,,0,0,0,,«ханшайымға тиіспе» дегенім жоқ па?
Dialogue: 0,0:13:38.65,0:13:42.82,Default,,0,0,0,,Мен бұл сөздерді дәл сол күйінде қайтарамын!
Dialogue: 0,0:13:42.90,0:13:45.40,Default,,0,0,0,,Мен саған ұнайтын нәрсені істеуге рұқсат бермеймін!
Dialogue: 0,0:13:45.49,0:13:46.70,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:47.99,0:13:49.70,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:13:49.78,0:13:51.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:57.08,0:14:01.46,Default,,0,0,0,,Қалай ойлайсың, қасқыр сияқты нәрсе менің қазіргі статусыма сәйкес келе ме?
Dialogue: 0,0:14:02.34,0:14:04.84,Default,,0,0,0,,Маған қарсы шықсаң, мен сені өлтіремін.
Dialogue: 0,0:14:04.92,0:14:06.59,Default,,0,0,0,,Ол тесілді ме?
Dialogue: 0,0:14:07.17,0:14:08.55,Default,,0,0,0,,Достар
Dialogue: 0,0:14:09.05,0:14:11.22,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:14:11.30,0:14:13.47,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:14:15.56,0:14:16.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:17.48,0:14:18.52,Default,,0,0,0,,Не?
Dialogue: 0,0:14:19.02,0:14:20.73,Default,,0,0,0,,Бұл үлкен сан сияқты.
Dialogue: 0,0:14:28.78,0:14:30.78,Default,,0,0,0,,Жоқ, жау емес.
Dialogue: 0,0:14:30.87,0:14:32.37,Default,,0,0,0,,Достар
Dialogue: 0,0:14:39.08,0:14:41.00,Default,,0,0,0,,Не болды? қайдан келдің?
Dialogue: 0,0:14:41.08,0:14:44.09,Default,,0,0,0,,Ай... Бұл ай құрбандық үстелі.
Dialogue: 0,0:14:44.17,0:14:45.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:45.21,0:14:46.21,Default,,0,0,0,,Хан ше?
Dialogue: 0,0:14:46.30,0:14:47.09,Default,,0,0,0,,(Джо Хирако) Ах! (Ирими) Ха!
Dialogue: 0,0:14:47.17,0:14:48.84,Default,,0,0,0,,Хан аға?
Dialogue: 0,0:14:49.34,0:14:53.47,Default,,0,0,0,,Мүмкін... сіз ликантропты айтып тұрған боларсыз!
Dialogue: 0,0:14:54.10,0:14:57.85,Default,,0,0,0,,Ол бізге көмектесті.
Dialogue: 0,0:14:57.93,0:14:58.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:59.23,0:15:00.39,Default,,0,0,0,,Сонымен, Хан...
Dialogue: 0,0:15:00.48,0:15:02.40,Default,,0,0,0,,Мен қасқырға айнала алдым!
Dialogue: 0,0:15:02.90,0:15:03.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:03.81,0:15:05.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:06.03,0:15:08.19,Default,,0,0,0,,Сонда Хан ше?
Dialogue: 0,0:15:08.28,0:15:10.24,Default,,0,0,0,,Дарданға қарсы тұру
Dialogue: 0,0:15:10.74,0:15:11.95,Default,,0,0,0,,Жалғыз
Dialogue: 0,0:15:12.03,0:15:13.24,Default,,0,0,0,,А...
Dialogue: 0,0:15:22.88,0:15:25.79,Default,,0,0,0,,Онда тыныш болыңыз.
Dialogue: 0,0:15:27.38,0:15:30.05,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:15:40.89,0:15:44.81,Default,,0,0,0,,Пломба бұзыла бастады ма?
Dialogue: 0,0:15:45.52,0:15:50.65,Default,,0,0,0,,Ежелгі патшалықтан ұрпақтан-ұрпаққа жалғасып келе жатқан билік дәл осы.
Dialogue: 0,0:15:52.15,0:15:56.91,Default,,0,0,0,,Мен сенің қасыңда ғана қорқынышты энергияны сезіне аламын.
Dialogue: 0,0:15:56.99,0:15:58.83,Default,,0,0,0,,Күшті күш
Dialogue: 0,0:15:59.70,0:16:03.62,Default,,0,0,0,,Мұның бәрі менікі
Dialogue: 0,0:16:05.92,0:16:09.38,Default,,0,0,0,,Ханшайым... Бастайық.
Dialogue: 0,0:16:11.92,0:16:15.89,Default,,0,0,0,,Сүмбезер Баттауба
Dialogue: 0,0:16:15.97,0:16:19.47,Default,,0,0,0,,Поттон Шо Гуа Садақ Селмер есік Асаетода
Dialogue: 0,0:16:19.56,0:16:22.52,Default,,0,0,0,,...
Dialogue: 0,0:16:22.60,0:16:25.15,Default,,0,0,0,,Центрпеттен Бантертеппен…
Dialogue: 0,0:16:29.44,0:16:34.78,Default,,0,0,0,,(Дардан әні)
Dialogue: 0,0:16:34.86,0:16:36.28,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:16:36.37,0:16:37.49,Default,,0,0,0,,-Ах! -Қараңдар!
Dialogue: 0,0:16:37.57,0:16:40.70,Default,,0,0,0,,Жарық... бұл...
Dialogue: 0,0:16:41.58,0:16:45.62,Default,,0,0,0,,Құрбандық үстелінде мөрленген патша әулетінің билігі...
Dialogue: 0,0:16:45.71,0:16:48.00,Default,,0,0,0,,Бұл рәсімнің басталғанын білдіре ме?
Dialogue: 0,0:16:48.09,0:16:49.13,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:16:49.21,0:16:53.13,Default,,0,0,0,,Бұл... бұл күш...
Dialogue: 0,0:16:53.22,0:16:56.55,Default,,0,0,0,,Бәрі менікі
Dialogue: 0,0:17:02.81,0:17:06.06,Default,,0,0,0,,Мейлі...?
Dialogue: 0,0:17:06.56,0:17:08.36,Default,,0,0,0,,Патартерниметия
Dialogue: 0,0:17:08.44,0:17:10.65,Default,,0,0,0,,Шениль ханшайымы жақын жерде…
Dialogue: 0,0:17:10.73,0:17:12.03,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:13.19,0:17:14.07,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:14.15,0:17:16.57,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,0:17:16.66,0:17:18.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:18.12,0:17:19.37,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:17:21.33,0:17:24.71,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:17:24.79,0:17:26.79,Default,,0,0,0,,Артық емес
Dialogue: 0,0:17:27.71,0:17:29.29,Default,,0,0,0,,Тірі қалдыруға болмайды!
Dialogue: 0,0:17:30.09,0:17:31.25,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:32.55,0:17:33.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:33.80,0:17:35.09,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:37.68,0:17:38.68,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:17:41.26,0:17:43.18,Default,,0,0,0,,Хан! Сенімен бәрі жақсы ма?
Dialogue: 0,0:17:43.27,0:17:44.93,Default,,0,0,0,,ал өзі Лизалисаның арқасына күтпеген жерден пышақ сұқтайды
Dialogue: 0,0:17:46.48,0:17:47.27,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:48.10,0:17:49.10,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:49.19,0:17:50.19,Default,,0,0,0,,- Уф! -(Орташа вампир) Гуаа...
Dialogue: 0,0:17:50.27,0:17:51.19,Default,,0,0,0,,Тікұшақ
Dialogue: 0,0:17:52.65,0:17:54.61,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:17:54.69,0:17:56.57,Default,,0,0,0,,Сенің қазір келе жатқаныңа сене алар емеспін.
Dialogue: 0,0:17:56.65,0:17:57.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:58.32,0:17:59.16,Default,,0,0,0,,Суха
Dialogue: 0,0:18:01.28,0:18:03.54,Default,,0,0,0,,Шаштың түсі... мүмкін емес
Dialogue: 0,0:18:03.62,0:18:04.79,Default,,0,0,0,,Хан аға!
Dialogue: 0,0:18:04.87,0:18:06.00,Default,,0,0,0,,Хан!
Dialogue: 0,0:18:06.08,0:18:07.66,Default,,0,0,0,,Бұл өте ауыр жарақат.
Dialogue: 0,0:18:07.75,0:18:09.00,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:18:09.08,0:18:11.59,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:18:12.09,0:18:14.30,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:18:14.38,0:18:17.13,Default,,0,0,0,,Сіздің достарыңыз ше?
Dialogue: 0,0:18:17.22,0:18:18.34,Default,,0,0,0,,Барлығы қауіпсіз.
Dialogue: 0,0:18:18.84,0:18:20.89,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:18:30.19,0:18:32.82,Default,,0,0,0,,Бізге билік бергенің үшін бе?
Dialogue: 0,0:18:32.90,0:18:33.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:37.69,0:18:38.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:38.99,0:18:41.91,Default,,0,0,0,,Жоқ, бұл…
Dialogue: 0,0:18:42.49,0:18:44.24,Default,,0,0,0,,Денеден…
Dialogue: 0,0:18:44.87,0:18:49.50,Default,,0,0,0,,Менің күш-қуатым... таусылып бара жатқандай сезінемін.
Dialogue: 0,0:18:52.50,0:18:55.00,Default,,0,0,0,,Бізбен бөліскен күш
Dialogue: 0,0:18:55.88,0:18:57.97,Default,,0,0,0,,Мен Сухаға қайтамын.
Dialogue: 0,0:18:58.05,0:19:00.63,Default,,0,0,0,,Бұл жаман! Дәл қазір ол жігітті алыңыз!
Dialogue: 0,0:19:00.72,0:19:04.22,Default,,0,0,0,,Жака Енді мен Дарданды тартамын.
Dialogue: 0,0:19:04.30,0:19:06.01,Default,,0,0,0,,Осы уақытта Суха...
Dialogue: 0,0:19:06.60,0:19:07.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:09.69,0:19:12.23,Default,,0,0,0,,Телепатияны қолдануға болмайды
Dialogue: 0,0:19:12.81,0:19:14.19,Default,,0,0,0,,Жака! Суха!
Dialogue: 0,0:19:14.27,0:19:15.36,Default,,0,0,0,,Иә
Dialogue: 0,0:19:15.86,0:19:16.98,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:17.48,0:19:18.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:18.78,0:19:21.16,Default,,0,0,0,,Мүмкіндікті пайдалана алмайсыз ба?
Dialogue: 0,0:19:21.24,0:19:22.24,Default,,0,0,0,,Хи хи
Dialogue: 0,0:19:22.32,0:19:24.95,Default,,0,0,0,,Енді қызықты бөлім келді.
Dialogue: 0,0:19:25.03,0:19:27.66,Default,,0,0,0,,Дардан-саманың жолына түспе!
Dialogue: 0,0:19:27.74,0:19:30.33,Default,,0,0,0,,Уау! Гррр...
Dialogue: 0,0:19:30.41,0:19:32.67,Default,,0,0,0,,…
Dialogue: 0,0:19:32.75,0:19:35.25,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:19:35.34,0:19:38.67,Default,,0,0,0,,(Тікұшақтар ыңылдап жатыр)
Dialogue: 0,0:19:38.76,0:19:42.18,Default,,0,0,0,,Гррр! Уф...
Dialogue: 0,0:19:42.26,0:19:46.10,Default,,0,0,0,,Patarternimetia Queen Schneer Focusnia
Dialogue: 0,0:19:46.18,0:19:48.18,Default,,0,0,0,,Рюруш Мениавейт
Dialogue: 0,0:19:48.27,0:19:49.43,Default,,0,0,0,,Хупаттен
Dialogue: 0,0:20:00.78,0:20:05.70,Default,,0,0,0,,Сіз менің барлығын сол жерден алғанымды көре аласыз.
Dialogue: 0,0:20:05.78,0:20:10.83,Default,,0,0,0,,Билік те, ханшайым да менікі.
Dialogue: 0,0:20:10.91,0:20:13.58,Default,,0,0,0,,Оны көзіңізге ойып салыңыз!
Dialogue: 0,0:20:13.67,0:20:14.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:17.79,0:20:20.05,Default,,0,0,0,,Балалар, кеттік!
Dialogue: 0,0:20:20.13,0:20:20.96,Default,,0,0,0,,О!
Dialogue: 0,0:20:21.47,0:20:22.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:23.80,0:20:25.51,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:25.59,0:20:26.68,Default,,0,0,0,,Гррр…
Dialogue: 0,0:20:26.76,0:20:28.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:28.31,0:20:29.43,Default,,0,0,0,,Гррр…
Dialogue: 0,0:20:31.52,0:20:32.64,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:32.73,0:20:33.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:34.48,0:20:37.98,Default,,0,0,0,,Мұны бізге қалдыр, сонда Дарданды жеңу керек!
Dialogue: 0,0:20:39.36,0:20:40.40,Default,,0,0,0,,Иә
Dialogue: 0,0:20:44.24,0:20:45.20,Default,,0,0,0,,Дардан
Dialogue: 0,0:20:46.74,0:20:48.49,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:20:48.58,0:20:50.70,Default,,0,0,0,,Ол енді менің серіктесім емес.
Dialogue: 0,0:20:51.29,0:20:52.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:55.04,0:20:56.04,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:20:56.54,0:20:57.96,Default,,0,0,0,,Аһ!
Dialogue: 0,0:20:58.04,0:20:59.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:00.80,0:21:02.97,Default,,0,0,0,,Бұл күлкілі
Dialogue: 0,0:21:03.05,0:21:06.68,Default,,0,0,0,,Сіз патшалықтағы ең ұлы рыцарь болдыңыз.
Dialogue: 0,0:21:07.43,0:21:12.60,Default,,0,0,0,,Енді осылай менің алдымда тізерлеп отыр
Dialogue: 0,0:21:13.64,0:21:18.19,Default,,0,0,0,,Жақында сіз барлық күш-қуатыңызды жоғалтасыз.
Dialogue: 0,0:21:19.65,0:21:22.36,Default,,0,0,0,,Егер ортақ қуат жоғалса
Dialogue: 0,0:21:22.44,0:21:26.61,Default,,0,0,0,,Біз ештеңе емеспіз
Dialogue: 0,0:21:26.70,0:21:29.32,Default,,0,0,0,,Өз көзіңізбен көргенде түсінесіз.
Dialogue: 0,0:21:47.13,0:21:48.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:56.02,0:21:58.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:22.23,0:23:24.23,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.16,0:23:37.58,Default,,0,0,0,,Келесі жолы соңғы эпизод
Dialogue: 0,0:23:38.20,0:23:40.96,Default,,0,0,0,,«Қараңғы ай - Ай алтарь-»
Dialogue: 0,0:23:42.46,0:23:48.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory