Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.91,0:00:02.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:05.38,0:00:07.04,Default,,0,0,0,,Найшу Джака!
Dialogue: 0,0:00:07.13,0:00:07.92,Default,,0,0,0,,Әкем әдеттегідей драмалық болып жатыр—
Dialogue: 0,0:00:08.00,0:00:09.80,Default,,0,0,0,,Жарайсыңдар! Келесі мен
Dialogue: 0,0:00:09.88,0:00:12.05,Default,,0,0,0,,Әй, Суха~!
Dialogue: 0,0:00:12.13,0:00:14.05,Default,,0,0,0,,Шион! барлығы!
Dialogue: 0,0:00:15.01,0:00:16.76,Default,,0,0,0,,Жаттығу Сіз оны көруге келдіңіз бе?
Dialogue: 0,0:00:16.85,0:00:18.93,Default,,0,0,0,,Иә, ойын ертең, солай ма?
Dialogue: 0,0:00:19.01,0:00:20.43,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:00:20.52,0:00:21.60,Default,,0,0,0,,Керемет!
Dialogue: 0,0:00:21.68,0:00:24.73,Default,,0,0,0,,Демек, сіз өзіңіздің атуыңызды мүлде шешкен жоқсыз.
Dialogue: 0,0:00:24.81,0:00:26.65,Default,,0,0,0,,үшін? Солай ма?
Dialogue: 0,0:00:26.73,0:00:31.23,Default,,0,0,0,,Бірақ бәрібір, өйткені бұл жолы мен тамаша өнеріммен жеңіске жеттім.
Dialogue: 0,0:00:31.32,0:00:32.99,Default,,0,0,0,,-Жеңісті саған арнаймын -Уау
Dialogue: 0,0:00:33.07,0:00:35.24,Default,,0,0,0,,-Аа... -Иә? Солай ма?
Dialogue: 0,0:00:35.32,0:00:36.61,Default,,0,0,0,,Хаха... Рахмет
Dialogue: 0,0:00:36.70,0:00:39.45,Default,,0,0,0,,Суха, келгеніңізге рахмет.
Dialogue: 0,0:00:39.53,0:00:41.37,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:00:42.25,0:00:44.50,Default,,0,0,0,,Мен сені қорғау үшін дүниеге келдім
Dialogue: 0,0:00:45.00,0:00:48.42,Default,,0,0,0,,Бұдан былай мен сол мақсат үшін өмір сүруім керек.
Dialogue: 0,0:00:50.09,0:00:52.59,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын, сондықтан маған қолдау көрсетіңіз.
Dialogue: 0,0:00:52.67,0:00:56.22,Default,,0,0,0,,Ух... Иә, мен сенің жеңгеніңді қалаймын.
Dialogue: 0,0:00:56.30,0:00:57.22,Default,,0,0,0,,Иә
Dialogue: 0,0:00:57.30,0:00:58.76,Default,,0,0,0,,- Эй - (Хери Суха) Иә?
Dialogue: 0,0:00:58.85,0:01:00.51,Default,,0,0,0,,Бұл жерде қалу қауіпті.
Dialogue: 0,0:01:00.60,0:01:02.85,Default,,0,0,0,,Зардап алғың келмесе, қайта келме.
Dialogue: 0,0:01:03.35,0:01:04.48,Default,,0,0,0,,Солон
Dialogue: 0,0:01:04.56,0:01:06.69,Default,,0,0,0,,Мен үшін алаңдайсың ба?
Dialogue: 0,0:01:06.77,0:01:09.27,Default,,0,0,0,,Иә? Олай емес...
Dialogue: 0,0:01:09.36,0:01:11.48,Default,,0,0,0,,Қараңдар! Жаттығу жасайық!
Dialogue: 0,0:01:11.57,0:01:12.44,Default,,0,0,0,,О
Dialogue: 0,0:01:12.53,0:01:14.49,Default,,0,0,0,,Онда мен барамын.
Dialogue: 0,0:01:23.83,0:01:24.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:25.96,0:01:26.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:29.25,0:01:31.17,Default,,0,0,0,,120 жыл болды.
Dialogue: 0,0:01:31.75,0:01:33.67,Default,,0,0,0,,Қалайсың, директор?
Dialogue: 0,0:01:34.17,0:01:36.55,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:01:36.63,0:01:39.72,Default,,0,0,0,,Мен баяғыда берілдім деп ойладым.
Dialogue: 0,0:01:40.22,0:01:42.60,Default,,0,0,0,,Сіз әлі де бізді іздедіңіз бе?
Dialogue: 0,0:01:42.68,0:01:45.60,Default,,0,0,0,,Мен сендерді іздеп келген жоқпын.
Dialogue: 0,0:01:45.68,0:01:46.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:46.31,0:01:49.10,Default,,0,0,0,,Бірақ мен сені кездестіремін деп ойламадым.
Dialogue: 0,0:01:49.73,0:01:51.73,Default,,0,0,0,,Біз бәріміз бірге болдық, солай ма?
Dialogue: 0,0:01:51.82,0:01:53.11,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:01:53.19,0:01:55.61,Default,,0,0,0,,Біз осылай кездесе алдық.
Dialogue: 0,0:01:56.11,0:01:58.11,Default,,0,0,0,,Балалар, сендермен де сөйлесейік.
Dialogue: 0,0:01:58.70,0:02:01.16,Default,,0,0,0,,Сіз кенеттен келіп, әңгімеңізді тыңдауымды айттыңыз ба?
Dialogue: 0,0:02:01.24,0:02:02.37,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:02:02.87,0:02:04.79,Default,,0,0,0,,Мына жігітті тыңдама!
Dialogue: 0,0:02:04.87,0:02:06.29,Default,,0,0,0,,Кім тыңдайды?
Dialogue: 0,0:02:06.37,0:02:08.04,Default,,0,0,0,,Қазір жоғал!
Dialogue: 0,0:02:09.08,0:02:10.50,Default,,0,0,0,,Біз қазірдің өзінде
Dialogue: 0,0:02:11.00,0:02:13.63,Default,,0,0,0,,Мен сіз білетін бала емеспін.
Dialogue: 0,0:02:18.38,0:02:21.26,Default,,0,0,0,,Дәл қазір... олай емес.
Dialogue: 0,0:02:32.52,0:02:34.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:34.86,0:02:36.03,Default,,0,0,0,,Хан!
Dialogue: 0,0:02:36.11,0:02:37.65,Default,,0,0,0,,Сізді кенеттен шақырғаным үшін кешіріңіз.
Dialogue: 0,0:02:37.74,0:02:38.78,Default,,0,0,0,,«Оның аман-есен жетуін қамтамасыз етші.»
Dialogue: 0,0:02:38.86,0:02:40.78,Default,,0,0,0,,Жоқ, шын мәнінде...
Dialogue: 0,0:02:41.28,0:02:44.45,Default,,0,0,0,,Мен сізге бір нәрсе айтқым келеді.
Dialogue: 0,0:02:44.53,0:02:45.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:46.33,0:02:49.29,Default,,0,0,0,,Мен... Маған Суха ұнайды.
Dialogue: 0,0:02:49.37,0:02:50.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:51.79,0:02:56.67,Default,,0,0,0,,Қасқырлар – ғашық болған адамын өмір бойы сүюді жалғастыратын тіршілік иелері.
Dialogue: 0,0:02:57.59,0:02:58.80,Default,,0,0,0,,Сонымен, I
Dialogue: 0,0:02:58.88,0:03:01.51,Default,,0,0,0,,Өлгенше мен сені ғана ойлаймын
Dialogue: 0,0:03:01.59,0:03:02.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:04.01,0:03:06.22,Default,,0,0,0,,Жақында түнгі доп ойыны
Dialogue: 0,0:03:06.72,0:03:10.02,Default,,0,0,0,,Маған қолдау көрсетсеңіздер өте қуанышты болар едім.
Dialogue: 0,0:03:11.56,0:03:14.06,Default,,0,0,0,,Мен жеткізгім келгені осы болды.
Dialogue: 0,0:03:18.03,0:03:20.36,Default,,0,0,0,,Онда мен оны сізге жіберемін.
Dialogue: 0,0:03:24.16,0:03:30.21,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:03:30.29,0:03:34.29,Default,,0,0,0,,Енді, бүгін түнгі доп финалы!
Dialogue: 0,0:03:34.79,0:03:36.59,Default,,0,0,0,,Биыл да Sunshine City мектебімен бірге
Dialogue: 0,0:03:36.67,0:03:39.71,Default,,0,0,0,,Десерис академиясының қақтығысы!
Dialogue: 0,0:03:41.67,0:03:44.64,Default,,0,0,0,,Мен бар күшімді саламын, сондықтан маған қолдау көрсетіңіздер.
Dialogue: 0,0:03:44.72,0:03:47.93,Default,,0,0,0,,Маған қолдау көрсетсеңіздер өте қуанышты болар едім.
Dialogue: 0,0:03:48.01,0:03:52.35,Default,,0,0,0,,Мен не істеуім керек? Екеуі тамаша дос.
Dialogue: 0,0:03:52.98,0:03:54.85,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,0:03:54.94,0:03:57.57,Default,,0,0,0,,Екеуміз де маңыздымыз...
Dialogue: 0,0:03:58.07,0:03:59.32,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,0:03:59.40,0:04:01.49,Default,,0,0,0,,Қалай болғанда да, бізге қазір қолдау көрсетіңіз!
Dialogue: 0,0:04:03.95,0:04:07.41,Default,,0,0,0,,Өткен жылғы жеңімпаз мектеп Десерис бірінен соң бірі чемпионаттарды ұтады ма?
Dialogue: 0,0:04:07.49,0:04:10.75,Default,,0,0,0,,Бұл күн сәулелі қала үшін кек бола ма?
Dialogue: 0,0:04:10.83,0:04:14.17,Default,,0,0,0,,Жақында қызу шешуші шайқас басталады!
Dialogue: 0,0:04:15.38,0:04:19.34,Default,,0,0,0,,Махан Руслан Камил…
Dialogue: 0,0:04:19.42,0:04:21.97,Default,,0,0,0,,Сіз міндетті түрде қайтатыныңызды айттыңыз.
Dialogue: 0,0:04:22.47,0:04:24.09,Default,,0,0,0,,Жоқ, концентрат.
Dialogue: 0,0:04:24.18,0:04:26.34,Default,,0,0,0,,Бұл матчта біз жеңеміз!
Dialogue: 0,0:04:26.43,0:04:29.06,Default,,0,0,0,,Мен сені биыл да оңай жеңемін.
Dialogue: 0,0:04:29.14,0:04:29.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:29.89,0:04:33.48,Default,,0,0,0,,Суха~! Көңіл көтеру орындарымыз сол жақта.
Dialogue: 0,0:04:33.56,0:04:34.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:36.02,0:04:37.02,Default,,0,0,0,,Суха…
Dialogue: 0,0:04:37.52,0:04:40.19,Default,,0,0,0,,Мен сен үшін міндетті түрде жеңемін!
Dialogue: 0,0:04:40.27,0:04:42.19,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:04:44.15,0:04:47.24,Default,,0,0,0,,Ал, ойын басталғалы жатыр!
Dialogue: 0,0:04:57.33,0:04:57.92,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:59.00,0:04:59.67,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:02.05,0:05:05.38,Default,,0,0,0,,Ой! Десерис Бұл мақсат па?
Dialogue: 0,0:05:06.43,0:05:07.34,Default,,0,0,0,,Джино осылай!
Dialogue: 0,0:05:09.43,0:05:09.93,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:05:10.01,0:05:11.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:11.39,0:05:12.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:12.52,0:05:13.68,Default,,0,0,0,,Сион!
Dialogue: 0,0:05:14.18,0:05:15.98,Default,,0,0,0,,Күшті соққы!
Dialogue: 0,0:05:16.06,0:05:17.06,Default,,0,0,0,,Жарайсың, Хан!
Dialogue: 0,0:05:17.15,0:05:18.86,Default,,0,0,0,,Engie-niisan!
Dialogue: 0,0:05:18.94,0:05:19.65,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:23.23,0:05:23.78,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:05:23.86,0:05:25.28,Default,,0,0,0,,- Әй... - (Хан) А...
Dialogue: 0,0:05:26.28,0:05:27.24,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:31.78,0:05:33.33,Default,,0,0,0,,Бірінші нүкте - Децерис!
Dialogue: 0,0:05:33.41,0:05:34.95,Default,,0,0,0,,-Жарайды, тікұшақ -Жарайды.
Dialogue: 0,0:05:35.04,0:05:36.75,Default,,0,0,0,,-Мен істеймін -Ой...
Dialogue: 0,0:05:37.96,0:05:39.00,Default,,0,0,0,,Тікұшақ…
Dialogue: 0,0:05:39.08,0:05:40.59,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:42.05,0:05:43.13,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:43.21,0:05:44.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:54.10,0:05:58.10,Default,,0,0,0,,Бірінші тайм Десеристің бір ұпаймен алға шығуымен аяқталды!
Dialogue: 0,0:05:58.85,0:06:01.61,Default,,0,0,0,,Бұл мен күткеннен де қарқынды.
Dialogue: 0,0:06:01.69,0:06:03.73,Default,,0,0,0,,Барлығы зардап шекпейді деп үміттенемін.
Dialogue: 0,0:06:03.82,0:06:04.90,Default,,0,0,0,,-Суха~! -иә?
Dialogue: 0,0:06:04.98,0:06:07.53,Default,,0,0,0,,Менің дәл қазір гол соққанымды көрдіңіз бе?
Dialogue: 0,0:06:07.61,0:06:09.78,Default,,0,0,0,,Иә! Бұл керемет болды!
Dialogue: 0,0:06:09.86,0:06:11.03,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:06:11.12,0:06:13.20,Default,,0,0,0,,Мен 2 ұпай жинадым.
Dialogue: 0,0:06:13.70,0:06:14.54,Default,,0,0,0,,Суха~!
Dialogue: 0,0:06:14.62,0:06:17.33,Default,,0,0,0,,Біздің көңіл көтеру орындары сол жерде.
Dialogue: 0,0:06:17.41,0:06:18.50,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:06:18.58,0:06:19.83,Default,,0,0,0,,- (Хан) Суха! -Аа...
Dialogue: 0,0:06:19.92,0:06:21.38,Default,,0,0,0,,Дәл қазір мен әлі жеңіліп жатырмын.
Dialogue: 0,0:06:21.46,0:06:23.96,Default,,0,0,0,,Біз міндетті түрде жеңеміз, сондықтан бізді қолдаңыздар!
Dialogue: 0,0:06:24.05,0:06:27.67,Default,,0,0,0,,Иә? Суха бізді жақтайды.
Dialogue: 0,0:06:27.76,0:06:30.18,Default,,0,0,0,,Суха~ Біздің орындар ана жақта!
Dialogue: 0,0:06:30.26,0:06:30.97,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:31.05,0:06:32.64,Default,,0,0,0,,Өйткені Суха осында
Dialogue: 0,0:06:33.30,0:06:35.06,Default,,0,0,0,,Суха көңілді жүрсің бе?
Dialogue: 0,0:06:35.14,0:06:36.56,Default,,0,0,0,,Тікұшақ?
Dialogue: 0,0:06:37.64,0:06:38.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:39.10,0:06:40.65,Default,,0,0,0,,Бізді қолдаңыз
Dialogue: 0,0:06:40.73,0:06:41.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:42.02,0:06:42.65,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:06:42.73,0:06:44.19,Default,,0,0,0,,А... осымен бітті ме?
Dialogue: 0,0:06:44.27,0:06:45.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:47.94,0:06:49.11,Default,,0,0,0,,Тікұшақ…
Dialogue: 0,0:06:50.74,0:06:52.45,Default,,0,0,0,,- (Біріктіру) Суха - А?
Dialogue: 0,0:06:53.74,0:06:55.03,Default,,0,0,0,,Қарсы боласыз ба?
Dialogue: 0,0:07:07.42,0:07:08.84,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:09.55,0:07:12.59,Default,,0,0,0,,Сондықтан мен сені іздедім
Dialogue: 0,0:07:15.18,0:07:16.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:17.01,0:07:18.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:20.81,0:07:22.73,Default,,0,0,0,,-Ах! -(Марж) Жоқ!
Dialogue: 0,0:07:22.81,0:07:24.23,Default,,0,0,0,,Гү…
Dialogue: 0,0:07:25.52,0:07:28.32,Default,,0,0,0,,Ал, енді Суха...
Dialogue: 0,0:07:29.44,0:07:30.65,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:07:30.74,0:07:31.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:34.20,0:07:36.41,Default,,0,0,0,,Онда жоқ... жоқ
Dialogue: 0,0:07:37.03,0:07:38.16,Default,,0,0,0,,Суха!
Dialogue: 0,0:07:38.24,0:07:39.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:39.37,0:07:42.12,Default,,0,0,0,,Хмм... Хмм!
Dialogue: 0,0:07:45.88,0:07:47.30,Default,,0,0,0,,-Тікұшақ~! -Аа...
Dialogue: 0,0:07:47.38,0:07:48.55,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:49.88,0:07:51.67,Default,,0,0,0,,Суха… Суха…
Dialogue: 0,0:07:52.34,0:07:53.93,Default,,0,0,0,,Мен бүгін мүлдем бас тарта алмаймын.
Dialogue: 0,0:07:55.26,0:07:56.97,Default,,0,0,0,,Біз міндетті түрде жеңеміз!
Dialogue: 0,0:07:57.05,0:07:57.68,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:59.10,0:08:01.10,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:08:01.18,0:08:03.85,Default,,0,0,0,,Менің құмарлығымның мақсаты анықталды!
Dialogue: 0,0:08:03.94,0:08:05.23,Default,,0,0,0,,Күншуақ қаланың қорлауы...
Dialogue: 0,0:08:05.31,0:08:06.73,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:08:07.23,0:08:08.23,Default,,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:08:08.32,0:08:10.74,Default,,0,0,0,,Күн шуағы! Күн шуағы!
Dialogue: 0,0:08:10.82,0:08:12.70,Default,,0,0,0,,Күн шуағы! Күн шуағы!
Dialogue: 0,0:08:12.78,0:08:14.66,Default,,0,0,0,,Тікұшақта не болды?
Dialogue: 0,0:08:15.16,0:08:17.33,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:08:18.95,0:08:22.00,Default,,0,0,0,,Суха~!
Dialogue: 0,0:08:28.79,0:08:30.50,Default,,0,0,0,,Неге Сухамен бірге болдың?
Dialogue: 0,0:08:30.59,0:08:32.67,Default,,0,0,0,,Сізді кім алып кетті?
Dialogue: 0,0:08:34.51,0:08:37.18,Default,,0,0,0,,Негізін салушы... Дардан.
Dialogue: 0,0:08:38.26,0:08:41.22,Default,,0,0,0,,негізін қалаушы Дардан? Ол кім?
Dialogue: 0,0:08:41.72,0:08:42.68,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:08:42.77,0:08:47.77,Default,,0,0,0,,Балалар сендер шынымен ештеңе білмейсіңдер.
Dialogue: 0,0:08:50.27,0:08:53.86,Default,,0,0,0,,Дардан — ежелгі Балг патшалығының премьер-министрі.
Dialogue: 0,0:08:54.70,0:08:57.11,Default,,0,0,0,,Ол бастапқыда жай ғана адам болған, бірақ
Dialogue: 0,0:08:57.20,0:09:02.66,Default,,0,0,0,,Билікке ұмтылып, тыйым салынған жолмен өзім вампир болдым.
Dialogue: 0,0:09:04.25,0:09:05.71,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:09:05.79,0:09:06.79,Default,,0,0,0,,Сіз кездестірдіңіз бе?
Dialogue: 0,0:09:06.87,0:09:07.75,Default,,0,0,0,,О
Dialogue: 0,0:09:08.25,0:09:11.88,Default,,0,0,0,,Ол вампирлердің үлкен тобымен бізге шабуыл жасады.
Dialogue: 0,0:09:11.96,0:09:13.55,Default,,0,0,0,,Ол кіммен болды?
Dialogue: 0,0:09:14.34,0:09:15.38,Default,,0,0,0,,Яғни
Dialogue: 0,0:09:15.47,0:09:19.47,Default,,0,0,0,,Дардан жасаған төмен вампир.
Dialogue: 0,0:09:19.97,0:09:23.81,Default,,0,0,0,,Олар күн сәулесінің әсеріне әлсіз және ешқандай себепсіз.
Dialogue: 0,0:09:23.89,0:09:26.35,Default,,0,0,0,,Бақыланбайтын қан құмарлығы
Dialogue: 0,0:09:28.02,0:09:29.23,Default,,0,0,0,,Сіз не білесіз?
Dialogue: 0,0:09:29.31,0:09:32.73,Default,,0,0,0,,Біздің сол вампирлерден айырмашылығымыз.
Dialogue: 0,0:09:33.23,0:09:34.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:34.28,0:09:35.49,Default,,0,0,0,,Балалар
Dialogue: 0,0:09:35.57,0:09:38.24,Default,,0,0,0,,Ежелгі Балг патшалығынан шыққан вампир лорд.
Dialogue: 0,0:09:38.74,0:09:41.66,Default,,0,0,0,,Вампир Лорд?
Dialogue: 0,0:09:41.74,0:09:42.83,Default,,0,0,0,,О
Dialogue: 0,0:09:43.33,0:09:47.33,Default,,0,0,0,,Сонымен бірге ол сол патшалықтың ханшайымына қызмет еткен рыцарь болды.
Dialogue: 0,0:09:47.42,0:09:50.08,Default,,0,0,0,,Бізді түрмеге отырғызған жігіттің сөзіне сене аласыз ба?
Dialogue: 0,0:09:50.17,0:09:52.13,Default,,0,0,0,,Мен түрмеде отырған жоқпын.
Dialogue: 0,0:09:52.63,0:09:55.01,Default,,0,0,0,,Дарданнан қорғау үшін
Dialogue: 0,0:09:55.09,0:09:57.22,Default,,0,0,0,,Мен оны Ванфилдте ұстадым.
Dialogue: 0,0:09:57.72,0:10:02.68,Default,,0,0,0,,Мыңдаған және жүздеген жылдар бұрын Дардан көтерілісі патшалық бұрышқа тығылған кезде.
Dialogue: 0,0:10:02.76,0:10:07.89,Default,,0,0,0,,Ханшайым сені қорғау үшін жанын алыс болашаққа жіберді.
Dialogue: 0,0:10:08.52,0:10:11.98,Default,,0,0,0,,Алайда, ол кезде жады жоғалады.
Dialogue: 0,0:10:12.06,0:10:14.82,Default,,0,0,0,,Оның келбеті де сәби кейпіне енген.
Dialogue: 0,0:10:15.32,0:10:19.45,Default,,0,0,0,,Мен әрқайсыңды іздеймін.
Dialogue: 0,0:10:19.53,0:10:22.33,Default,,0,0,0,,Мен оны Ванфилд үйінде күзететінмін.
Dialogue: 0,0:10:23.62,0:10:24.91,Default,,0,0,0,,Ханшайым...
Dialogue: 0,0:10:25.66,0:10:27.25,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:10:27.33,0:10:30.21,Default,,0,0,0,,Бұл ханшайым болуы мүмкін бе...
Dialogue: 0,0:10:32.00,0:10:34.71,Default,,0,0,0,,Суха... солай ма?
Dialogue: 0,0:10:34.80,0:10:35.80,Default,,0,0,0,,О
Dialogue: 0,0:10:36.30,0:10:40.47,Default,,0,0,0,,Мен ханшайымның жігеріне еріп, осында жеттім.
Dialogue: 0,0:10:40.55,0:10:43.97,Default,,0,0,0,,Балалар, сендер инстинктивті түрде білулерің керек еді.
Dialogue: 0,0:10:44.06,0:10:47.31,Default,,0,0,0,,Біздің тағдырымыз қандай?
Dialogue: 0,0:10:47.81,0:10:49.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:49.35,0:10:50.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:55.78,0:10:59.82,Default,,0,0,0,,Сонымен Дарданның Суханы ұрлаудағы мақсаты не болды?
Dialogue: 0,0:11:00.40,0:11:01.95,Default,,0,0,0,,Сол кездегідей.
Dialogue: 0,0:11:02.57,0:11:06.24,Default,,0,0,0,,Дардан ханшайымның билігін алуға тырысады.
Dialogue: 0,0:11:06.33,0:11:09.58,Default,,0,0,0,,Енді бәрі менікі
Dialogue: 0,0:11:10.08,0:11:12.08,Default,,0,0,0,,Ханшайым... Дардан...
Dialogue: 0,0:11:12.58,0:11:13.88,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:43.07,0:11:45.49,Default,,0,0,0,,Ханшайым, сен осындасың ба?
Dialogue: 0,0:11:45.57,0:11:47.70,Default,,0,0,0,,Ах... Лорд Хери
Dialogue: 0,0:11:48.58,0:11:50.45,Default,,0,0,0,,Мәртебелі шақырып жатыр.
Dialogue: 0,0:11:50.96,0:11:52.83,Default,,0,0,0,,Мен бұл оқиға екеніне сенімдімін.
Dialogue: 0,0:11:52.92,0:11:53.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:54.17,0:11:58.30,Default,,0,0,0,,Негізі маған көрші елдің ханзадасынан үйлену туралы ұсыныс түсті.
Dialogue: 0,0:11:58.80,0:12:00.76,Default,,0,0,0,,Иә, тыңдап тұрмын.
Dialogue: 0,0:12:01.26,0:12:03.22,Default,,0,0,0,,Ол өте жақсы адам сияқты.
Dialogue: 0,0:12:03.76,0:12:06.85,Default,,0,0,0,,Бірақ мен әлі үйленбегенмін...
Dialogue: 0,0:12:07.35,0:12:12.35,Default,,0,0,0,,Және тіпті танымайтын адамға өмір бойы міндеттеме алу?
Dialogue: 0,0:12:12.85,0:12:17.15,Default,,0,0,0,,Маған еркін ғашық болуға рұқсат жоқ.
Dialogue: 0,0:12:17.94,0:12:19.32,Default,,0,0,0,,Кездесетінімізге сенімдімін
Dialogue: 0,0:12:20.74,0:12:23.07,Default,,0,0,0,,Шын жүрегімен сүйе алатындарға
Dialogue: 0,0:12:23.57,0:12:26.82,Default,,0,0,0,,Сенің анаң ғой
Dialogue: 0,0:12:26.91,0:12:28.62,Default,,0,0,0,,Түсінікті болсын...
Dialogue: 0,0:12:28.70,0:12:29.70,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:12:32.16,0:12:33.41,Default,,0,0,0,,Мен Архитектуралық дизайн бөлімінен Отомын; сіз маған қоңырау шалған едіңіз.
Dialogue: 0,0:12:34.62,0:12:36.92,Default,,0,0,0,,Рахмет, Лорд Хери.
Dialogue: 0,0:12:37.50,0:12:41.92,Default,,0,0,0,,Сіз маған әрқашан көмектесесіз.
Dialogue: 0,0:12:44.43,0:12:47.85,Default,,0,0,0,,Менің міндетім ханшайымды қорғау.
Dialogue: 0,0:12:50.47,0:12:51.68,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:56.60,0:12:57.48,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:00.65,0:13:02.94,Default,,0,0,0,,Бүгін тағы да туған күнің құтты болсын.
Dialogue: 0,0:13:03.03,0:13:04.40,Default,,0,0,0,,Серен ханшайым
Dialogue: 0,0:13:04.90,0:13:07.70,Default,,0,0,0,,Некеңізге не болды?
Dialogue: 0,0:13:07.78,0:13:09.53,Default,,0,0,0,,Премьер-министр Дардан
Dialogue: 0,0:13:10.03,0:13:12.24,Default,,0,0,0,,Бұл жағдайда мен сыпайы түрде бас тарттым.
Dialogue: 0,0:13:12.33,0:13:14.79,Default,,0,0,0,,Бұл жақсы жаңалық.
Dialogue: 0,0:13:15.29,0:13:18.13,Default,,0,0,0,,Менің қалағанымды істеу
Dialogue: 0,0:13:18.71,0:13:20.17,Default,,0,0,0,,Бұл сенің шаруаң емес!
Dialogue: 0,0:13:20.25,0:13:23.38,Default,,0,0,0,,Менің ойым Серен ханшайыммен бірдей.
Dialogue: 0,0:13:23.88,0:13:26.05,Default,,0,0,0,,Өйткені мен саяси некеге қарсымын.
Dialogue: 0,0:13:26.13,0:13:27.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:27.34,0:13:29.51,Default,,0,0,0,,Сіз тыңдадыңыз ба?
Dialogue: 0,0:13:29.60,0:13:33.47,Default,,0,0,0,,Серен ханшайымның даусы табиғи естіледі.
Dialogue: 0,0:13:33.56,0:13:34.85,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:13:34.93,0:13:36.94,Default,,0,0,0,,Себебі мен қуып келемін
Dialogue: 0,0:13:37.02,0:13:38.23,Default,,0,0,0,,Дөрекі!
Dialogue: 0,0:13:38.31,0:13:39.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:39.69,0:13:41.40,Default,,0,0,0,,Дөрекілік дегеніміз не?
Dialogue: 0,0:13:42.15,0:13:44.61,Default,,0,0,0,,Мен патша емеспін бе?
Dialogue: 0,0:13:45.57,0:13:48.03,Default,,0,0,0,,Сайып келгенде, мәртебе маңызды.
Dialogue: 0,0:13:48.11,0:13:49.16,Default,,0,0,0,,Жібер!
Dialogue: 0,0:13:50.99,0:13:54.37,Default,,0,0,0,,Мен сенің жүрегіңді қалай жаулай аламын?
Dialogue: 0,0:13:55.54,0:13:56.37,Default,,0,0,0,,Дардан!
Dialogue: 0,0:13:56.46,0:13:59.63,Default,,0,0,0,,Келесі жолы ханшайымға осындай құрметсіздік көрсетсеңіз,
Dialogue: 0,0:13:59.71,0:14:01.00,Default,,0,0,0,,Оны жалғыз қалдырмаңыз!
Dialogue: 0,0:14:01.09,0:14:02.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:04.09,0:14:06.09,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:07.34,0:14:09.97,Default,,0,0,0,,Бұл адам шынымен...
Dialogue: 0,0:14:10.05,0:14:10.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:11.01,0:14:11.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:11.60,0:14:12.93,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:14:14.10,0:14:15.89,Default,,0,0,0,,(Селеннің ауыр тыныс алуы)
Dialogue: 0,0:14:15.98,0:14:18.52,Default,,0,0,0,,Селен! селен! Мықты болыңыз
Dialogue: 0,0:14:18.60,0:14:21.27,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:14:21.36,0:14:23.40,Default,,0,0,0,,Менің қорқатыным осы болды.
Dialogue: 0,0:14:23.90,0:14:25.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:25.11,0:14:28.49,Default,,0,0,0,,Патша әулетінің ұрпақтан-ұрпаққа ие болғаны бақсының билігінен бе?
Dialogue: 0,0:14:28.57,0:14:29.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:30.11,0:14:34.41,Default,,0,0,0,,Серен-сама патшалық тарихындағы ең үлкен күшке ие.
Dialogue: 0,0:14:34.49,0:14:37.66,Default,,0,0,0,,Менің денем енді шыдай алмайды.
Dialogue: 0,0:14:38.16,0:14:40.79,Default,,0,0,0,,Бұлай жалғаса берсе, мен өлемін.
Dialogue: 0,0:14:41.79,0:14:44.34,Default,,0,0,0,,Оны пайдаланудың бір ғана жолы бар
Dialogue: 0,0:14:45.17,0:14:48.84,Default,,0,0,0,,Патшалықтың қазынасы, ежелгі қасқыр құдайдың қаны
Dialogue: 0,0:14:49.63,0:14:52.14,Default,,0,0,0,,«Балг қанын» қолданудан басқа амалыңыз жоқ
Dialogue: 0,0:14:57.47,0:14:58.56,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:15:00.48,0:15:01.69,Default,,0,0,0,,Селен!
Dialogue: 0,0:15:04.06,0:15:07.28,Default,,0,0,0,,Бірдеңе... өте жылы
Dialogue: 0,0:15:07.78,0:15:08.90,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:15:09.40,0:15:13.16,Default,,0,0,0,,Сен бақсының қанын алған ханшайымсың, Серен.
Dialogue: 0,0:15:13.66,0:15:18.04,Default,,0,0,0,,Мына қасқыр құдай Балг саған күш береді.
Dialogue: 0,0:15:18.54,0:15:21.08,Default,,0,0,0,,Сіз Баргсыз...
Dialogue: 0,0:15:27.50,0:15:30.09,Default,,0,0,0,,Селен! Сіз байқадыңыз ба?
Dialogue: 0,0:15:30.59,0:15:33.59,Default,,0,0,0,,Аа, жақсы... қазір бәрі жақсы.
Dialogue: 0,0:15:33.68,0:15:35.10,Default,,0,0,0,,Ана…
Dialogue: 0,0:15:35.64,0:15:38.18,Default,,0,0,0,,Мен Балг құдайымен таныстым
Dialogue: 0,0:15:38.27,0:15:42.85,Default,,0,0,0,,А... Құдай Балг, көп рахмет.
Dialogue: 0,0:15:51.15,0:15:53.70,Default,,0,0,0,,Анашым! ана!
Dialogue: 0,0:15:54.20,0:15:58.58,Default,,0,0,0,,Серен... мұңайма.
Dialogue: 0,0:15:59.08,0:16:01.08,Default,,0,0,0,,Сіз білесіз
Dialogue: 0,0:16:01.58,0:16:04.04,Default,,0,0,0,,Бұл жалғыз жол
Dialogue: 0,0:16:04.12,0:16:05.25,Default,,0,0,0,,Ана…
Dialogue: 0,0:16:06.21,0:16:07.92,Default,,0,0,0,,негізін қалаушы Дардан
Dialogue: 0,0:16:08.00,0:16:11.51,Default,,0,0,0,,Мен бұл патшалықты өзімдікі етуге тырысамын.
Dialogue: 0,0:16:12.51,0:16:18.39,Default,,0,0,0,,Қасқырлар да бізге қосылды, бірақ олардың санына сәйкес келе алмадық.
Dialogue: 0,0:16:19.85,0:16:25.56,Default,,0,0,0,,Онда сіз өз қаныңызды бөлісесіз...
Dialogue: 0,0:16:35.86,0:16:39.37,Default,,0,0,0,,Жаңа вампир лорд құрылды
Dialogue: 0,0:16:40.91,0:16:43.96,Default,,0,0,0,,Өтінемін, сіз және олар.
Dialogue: 0,0:16:46.17,0:16:50.88,Default,,0,0,0,,Бұл елді Дарданнан қорға
Dialogue: 0,0:16:54.43,0:16:56.72,Default,,0,0,0,,Бірақ мен әлі де...
Dialogue: 0,0:16:56.80,0:16:59.72,Default,,0,0,0,,Балгтың қанын іштің.
Dialogue: 0,0:17:00.51,0:17:05.77,Default,,0,0,0,,Ежелгі қасқыр құдайының күшін алып, Вампир патшайымы болды.
Dialogue: 0,0:17:06.98,0:17:08.06,Default,,0,0,0,,Селен…
Dialogue: 0,0:17:08.56,0:17:12.48,Default,,0,0,0,,Менің бақсы күшім ғана қалды...
Dialogue: 0,0:17:13.28,0:17:15.53,Default,,0,0,0,,Менің бар күшім
Dialogue: 0,0:17:15.61,0:17:18.87,Default,,0,0,0,,Ол «Ай құрбандық үстелінде» мөрленген.
Dialogue: 0,0:17:18.95,0:17:20.16,Default,,0,0,0,,Ана…
Dialogue: 0,0:17:20.24,0:17:21.79,Default,,0,0,0,,Селен
Dialogue: 0,0:17:22.29,0:17:23.87,Default,,0,0,0,,Мен өлсем
Dialogue: 0,0:17:24.37,0:17:29.13,Default,,0,0,0,,Айдың құрбандық үстелінде дереу тәж кию рәсімін өткізіп, мөрді бұзыңыз.
Dialogue: 0,0:17:29.63,0:17:31.42,Default,,0,0,0,,Королеваның билігін алу
Dialogue: 0,0:17:32.38,0:17:35.84,Default,,0,0,0,,Тарихтағы ең күшті патшайым бол
Dialogue: 0,0:17:35.92,0:17:36.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:37.26,0:17:39.55,Default,,0,0,0,,Уайымдама, патшайым.
Dialogue: 0,0:17:40.05,0:17:44.93,Default,,0,0,0,,Мен сол билікті мұра етіп алып, бұл патшалықты мықтап басқарамын.
Dialogue: 0,0:17:46.02,0:17:46.64,Default,,0,0,0,,Дардан!
Dialogue: 0,0:17:46.73,0:17:48.44,Default,,0,0,0,,Серен ханшайым
Dialogue: 0,0:17:48.52,0:17:51.65,Default,,0,0,0,,Менің де мұны істегім келмеді.
Dialogue: 0,0:17:51.73,0:17:54.49,Default,,0,0,0,,Мен сенің махаббатыңды ғана қаладым
Dialogue: 0,0:17:54.57,0:17:56.49,Default,,0,0,0,,Өйткені олар маған назар аудармайды да
Dialogue: 0,0:17:57.11,0:17:57.91,Default,,0,0,0,,Түсіңіз!
Dialogue: 0,0:17:58.49,0:17:59.11,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:59.20,0:18:00.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:00.95,0:18:02.33,Default,,0,0,0,,Біріктіру!
Dialogue: 0,0:18:03.58,0:18:08.54,Default,,0,0,0,,Сондықтан менде сені алу үшін ұрлап, жаншып кетуден басқа амалым жоқ.
Dialogue: 0,0:18:09.63,0:18:10.67,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:12.38,0:18:13.25,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:13.34,0:18:14.67,Default,,0,0,0,,Гаа…
Dialogue: 0,0:18:14.76,0:18:15.96,Default,,0,0,0,,Ханшайымды қорғаңыз!
Dialogue: 0,0:18:16.05,0:18:17.34,Default,,0,0,0,,- Уф! -(Вампирлер) Гах...
Dialogue: 0,0:18:17.42,0:18:18.84,Default,,0,0,0,,-Арх! -(Вампирлер) Гуааа...
Dialogue: 0,0:18:18.93,0:18:20.76,Default,,0,0,0,,-Ах! -(Вампир) Гуууу...
Dialogue: 0,0:18:20.84,0:18:22.14,Default,,0,0,0,,- Уф... - (Вампирлер) Гаа...
Dialogue: 0,0:18:22.22,0:18:23.60,Default,,0,0,0,,- Уф! -(Вампирлер) Гуууу...
Dialogue: 0,0:18:24.10,0:18:25.77,Default,,0,0,0,,- Уф! -(Вампирлер) Ааа...
Dialogue: 0,0:18:25.85,0:18:27.52,Default,,0,0,0,,Тікұшақ! Ханшайым!
Dialogue: 0,0:18:28.23,0:18:29.39,Default,,0,0,0,,Ханшайым! Сіз амансыз деп үміттенемін!
Dialogue: 0,0:18:30.06,0:18:31.65,Default,,0,0,0,,Құрметті Дардан!
Dialogue: 0,0:18:31.73,0:18:33.23,Default,,0,0,0,,(Ринраку) Бұл тек бір теория ғана, бірақ адам еті мен қанын жеудің орнына, Незуко…
Dialogue: 0,0:18:34.36,0:18:35.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:35.73,0:18:37.40,Default,,0,0,0,,Сэр Хэли…
Dialogue: 0,0:18:37.49,0:18:40.45,Default,,0,0,0,,Өйткені ханшайымға деген сезімің де болды.
Dialogue: 0,0:18:40.53,0:18:42.03,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:18:42.12,0:18:46.04,Default,,0,0,0,,Сонда ғана мені тану керек.
Dialogue: 0,0:18:49.62,0:18:51.54,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:18:51.63,0:18:53.54,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:18:53.63,0:18:55.00,Default,,0,0,0,,Гах...
Dialogue: 0,0:18:55.09,0:18:56.26,Default,,0,0,0,,Гах…
Dialogue: 0,0:18:56.34,0:18:57.80,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:19:00.05,0:19:03.39,Default,,0,0,0,,Енді бәрі менікі.
Dialogue: 0,0:19:03.89,0:19:06.06,Default,,0,0,0,,Айға құрбандық шалатын ханшайым
Dialogue: 0,0:19:06.14,0:19:07.72,Default,,0,0,0,,Өтінемін, асығыңыз!
Dialogue: 0,0:19:08.39,0:19:10.56,Default,,0,0,0,,Ханшайым... Ханшайым!
Dialogue: 0,0:19:10.64,0:19:11.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:16.40,0:19:17.61,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:24.66,0:19:27.12,Default,,0,0,0,,Ах... Марж артқа!
Dialogue: 0,0:19:27.20,0:19:30.04,Default,,0,0,0,,Тәжін кию рәсімі мүмкіндігінше тезірек өтеді...
Dialogue: 0,0:19:30.54,0:19:32.12,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,0:19:32.21,0:19:33.92,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:19:34.00,0:19:36.88,Default,,0,0,0,,Королева болу үшін бәрін құрбан еттің!
Dialogue: 0,0:19:39.76,0:19:42.43,Default,,0,0,0,,Марж, сенен бір өтінішім бар.
Dialogue: 0,0:19:42.93,0:19:45.51,Default,,0,0,0,,Мен қазір сарайға қайтамын.
Dialogue: 0,0:19:45.60,0:19:48.93,Default,,0,0,0,,Мен тікұшақ иелерінің рухын алыс болашаққа жібергім келеді.
Dialogue: 0,0:19:49.43,0:19:52.19,Default,,0,0,0,,Сонымен, уақыты келгенде
Dialogue: 0,0:19:52.69,0:19:55.77,Default,,0,0,0,,Барлығын тауып, оларды жақсы қорғаңыз.
Dialogue: 0,0:19:55.86,0:19:56.86,Default,,0,0,0,,Ханшайым...
Dialogue: 0,0:20:05.45,0:20:07.12,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:20:07.20,0:20:11.29,Default,,0,0,0,,Мен саған қалағанымдай қатыгез бола аламын
Dialogue: 0,0:20:13.62,0:20:15.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:15.13,0:20:17.00,Default,,0,0,0,,Қыңыр жігіт!
Dialogue: 0,0:20:25.64,0:20:26.80,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:20:26.89,0:20:29.64,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:20:29.72,0:20:33.64,Default,,0,0,0,,Сэр Хели, сіз бұрын болдыңыз ба?
Dialogue: 0,0:20:34.14,0:20:38.73,Default,,0,0,0,,Сен мені талай рет қауіптен құтқардың.
Dialogue: 0,0:20:39.36,0:20:42.82,Default,,0,0,0,,Ешқандай қорықпай, ойланбастан
Dialogue: 0,0:20:43.45,0:20:49.74,Default,,0,0,0,,Мен сенің көптен бері бірдеңені жасырып жүргеніңді білемін.
Dialogue: 0,0:20:50.33,0:20:55.33,Default,,0,0,0,,Өйткені мен де дәл солай жасырдым.
Dialogue: 0,0:20:56.75,0:20:59.92,Default,,0,0,0,,Келесі жолы өтінемін
Dialogue: 0,0:21:00.00,0:21:03.09,Default,,0,0,0,,Біз сияқты бір-бірімізбен
Dialogue: 0,0:21:10.68,0:21:12.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:26.41,0:21:29.99,Default,,0,0,0,,Дарданда Суханың шамандық күші бар және
Dialogue: 0,0:21:30.08,0:21:32.49,Default,,0,0,0,,Сіз Балгтың билігін ұрламақ болдыңыз ба?
Dialogue: 0,0:21:33.37,0:21:34.37,Default,,0,0,0,,О
Dialogue: 0,0:21:36.12,0:21:39.00,Default,,0,0,0,,Түсіндім, бұл аңыз
Dialogue: 0,0:21:39.71,0:21:41.55,Default,,0,0,0,,Бұл біз туралы болды.
Dialogue: 0,0:21:55.93,0:21:57.94,Default,,0,0,0,,♪～
Dialogue: 0,0:23:22.15,0:23:24.15,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.03,0:23:37.16,Default,,0,0,0,,Келесі 9 эпизод
Dialogue: 0,0:23:37.66,0:23:40.87,Default,,0,0,0,,«Тұманды ай - Рельстің қара тұманы-»
Dialogue: 0,0:23:42.37,0:23:48.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory