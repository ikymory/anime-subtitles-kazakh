Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.79,0:00:03.79,Default,,0,0,0,,♪～
Dialogue: 0,0:01:28.42,0:01:30.42,Default,,0,0,0,,～♪
Dialogue: 0,0:01:38.34,0:01:40.51,Default,,0,0,0,,Қанатты Маханнан
Dialogue: 0,0:01:40.60,0:01:42.01,Default,,0,0,0,,Ханға тік өту
Dialogue: 0,0:01:42.10,0:01:45.23,Default,,0,0,0,,Тахер осы позициядан қақпаққа кіреді...
Dialogue: 0,0:01:45.31,0:01:46.85,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:01:58.15,0:01:59.49,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:01:59.57,0:02:03.20,Default,,0,0,0,,Ал, Махан мен басқалары қайтып келгенде модельдеу жасайық.
Dialogue: 0,0:02:03.28,0:02:05.29,Default,,0,0,0,,Біз чемпиондықты міндетті түрде қайтарамыз.
Dialogue: 0,0:02:05.37,0:02:08.71,Default,,0,0,0,,Мен енді Десерис жігіттеріне үлкен жүздер жасауға жол бермеймін.
Dialogue: 0,0:02:08.79,0:02:09.71,Default,,0,0,0,,Сәлем капитан
Dialogue: 0,0:02:10.88,0:02:13.25,Default,,0,0,0,,Не? Ах... кешіріңіз.
Dialogue: 0,0:02:13.34,0:02:14.13,Default,,0,0,0,,Не?
Dialogue: 0,0:02:14.21,0:02:17.34,Default,,0,0,0,,Түнгібол ойынының жоспары.
Dialogue: 0,0:02:17.42,0:02:19.01,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:02:19.09,0:02:20.89,Default,,0,0,0,,Иә, келісемін.
Dialogue: 0,0:02:20.97,0:02:22.47,Default,,0,0,0,,Сіз мені дұрыс естідіңіз бе?
Dialogue: 0,0:02:22.55,0:02:24.26,Default,,0,0,0,,Сондай-ақ... әрине.
Dialogue: 0,0:02:24.35,0:02:25.81,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:02:26.52,0:02:29.94,Default,,0,0,0,,Басқаша айтқанда, мен гол соғуым керек, солай ма?
Dialogue: 0,0:02:31.94,0:02:33.36,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:33.44,0:02:36.28,Default,,0,0,0,,Ханхён, сен бүгін біртүрлі екенсің, солай ма?
Dialogue: 0,0:02:36.36,0:02:36.90,Default,,0,0,0,,Не!
Dialogue: 0,0:02:36.99,0:02:38.82,Default,,0,0,0,,Мен қашанда аң-таң болдым
Dialogue: 0,0:02:38.90,0:02:40.61,Default,,0,0,0,,Ал... бұл дұрыс емес.
Dialogue: 0,0:02:40.70,0:02:41.53,Default,,0,0,0,,Қызу!
Dialogue: 0,0:02:41.61,0:02:43.91,Default,,0,0,0,,Не... ештеңе болуы мүмкін емес.
Dialogue: 0,0:02:44.41,0:02:45.74,Default,,0,0,0,,Мен жай ғана шаршадым.
Dialogue: 0,0:02:46.24,0:02:47.41,Default,,0,0,0,,Мен бүгін ұйықтаймын
Dialogue: 0,0:02:47.50,0:02:49.25,Default,,0,0,0,,Бұл белгіленген екен — онда бірдеңе дұрыс емес пе?
Dialogue: 0,0:02:49.33,0:02:51.17,Default,,0,0,0,,Олардан
Dialogue: 0,0:02:51.25,0:02:51.83,Default,,0,0,0,,Ит пе?
Dialogue: 0,0:02:51.92,0:02:53.38,Default,,0,0,0,,Мені төбелеске сатады.
Dialogue: 0,0:02:53.46,0:02:56.55,Default,,0,0,0,,Тіпті туған күн кешіне шақыру.
Dialogue: 0,0:02:57.05,0:02:58.05,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:03:00.13,0:03:02.68,Default,,0,0,0,,Мен бұлай істемеймін.
Dialogue: 0,0:03:02.76,0:03:04.47,Default,,0,0,0,,Туған күн кімге ұнайды?
Dialogue: 0,0:03:04.55,0:03:05.43,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:03:05.51,0:03:08.06,Default,,0,0,0,,Жоқ, бірақ бәріңіз кеткіңіз келеді.
Dialogue: 0,0:03:08.14,0:03:09.98,Default,,0,0,0,,Бұл әлеуметтік сәлемдесу
Dialogue: 0,0:03:10.06,0:03:11.02,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:12.98,0:03:14.06,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:19.90,0:03:21.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:21.15,0:03:23.74,Default,,0,0,0,,Тезірек демалып алғаныңыз жөн.
Dialogue: 0,0:03:23.82,0:03:24.87,Default,,0,0,0,,О
Dialogue: 0,0:03:26.87,0:03:27.87,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:03:27.95,0:03:29.37,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:03:31.33,0:03:34.04,Default,,0,0,0,,Айдың толық тұтылуына байланысты ма?
Dialogue: 0,0:03:34.13,0:03:36.79,Default,,0,0,0,,Бірақ бәрінен де адам емес.
Dialogue: 0,0:03:36.88,0:03:38.13,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:38.76,0:03:40.05,Default,,0,0,0,,Жақсы өтеді деп үміттенемін.
Dialogue: 0,0:03:43.13,0:03:45.30,Default,,0,0,0,,Сіз шақыру жібердіңіз бе?
Dialogue: 0,0:03:45.39,0:03:47.56,Default,,0,0,0,,Менің таңдауым болмады.
Dialogue: 0,0:03:47.64,0:03:50.73,Default,,0,0,0,,Суха оларды да шақырғанымды қалайды.
Dialogue: 0,0:03:50.81,0:03:52.02,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:52.52,0:03:55.48,Default,,0,0,0,,Ал егер Суха солай айтса, менің ойымша, оған көмектесу мүмкін емес.
Dialogue: 0,0:03:55.56,0:03:59.53,Default,,0,0,0,,Сондықтан туған күніңді қасқырлармен бірге тойладың.
Dialogue: 0,0:03:59.61,0:04:01.11,Default,,0,0,0,,Жалпы Суха
Dialogue: 0,0:04:01.19,0:04:03.45,Default,,0,0,0,,Олардың несі сізге ұнайды?
Dialogue: 0,0:04:03.53,0:04:05.16,Default,,0,0,0,,Менен сұрасаң да
Dialogue: 0,0:04:05.24,0:04:07.95,Default,,0,0,0,,Себебі сіз вампирлерді жек көресіз.
Dialogue: 0,0:04:10.29,0:04:10.95,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:04:11.04,0:04:13.25,Default,,0,0,0,,Еске салма
Dialogue: 0,0:04:13.33,0:04:15.21,Default,,0,0,0,,Мен енді қалпына келтіре алмаймын
Dialogue: 0,0:04:15.29,0:04:16.63,Default,,0,0,0,,Көп уайымдамаңыз
Dialogue: 0,0:04:16.71,0:04:19.67,Default,,0,0,0,,Суха біз туралы біліп, олай айтқан сияқты емес.
Dialogue: 0,0:04:20.17,0:04:21.30,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:21.38,0:04:24.22,Default,,0,0,0,,Суха біздің шынайы болмысымызды анықтаса
Dialogue: 0,0:04:24.30,0:04:27.01,Default,,0,0,0,,Мені енді ешқашан көрмейтініне сенімдімін.
Dialogue: 0,0:04:27.10,0:04:30.35,Default,,0,0,0,,Ол баланың не ойлайтыны маңызды емес.
Dialogue: 0,0:04:30.43,0:04:32.81,Default,,0,0,0,,Сондықтан мен саған жараспаңдар дедім.
Dialogue: 0,0:04:32.89,0:04:33.85,Default,,0,0,0,,Эх!
Dialogue: 0,0:04:33.94,0:04:36.56,Default,,0,0,0,,Мен Сухамен дос болғым келеді!
Dialogue: 0,0:04:36.65,0:04:40.07,Default,,0,0,0,,Бірақ мен сені соншалықты жек көреді деп күтпедім.
Dialogue: 0,0:04:40.65,0:04:43.36,Default,,0,0,0,,Шын мәнінде, сізге ұнайтын ешкім жоқ.
Dialogue: 0,0:04:43.44,0:04:45.82,Default,,0,0,0,,Адам болсаң, оны жек көру табиғи нәрсе.
Dialogue: 0,0:04:46.32,0:04:48.16,Default,,0,0,0,,Тіпті менің достарым да өлтірілді.
Dialogue: 0,0:04:48.24,0:04:52.50,Default,,0,0,0,,Бірақ біз адамдарға зиян келтірмейміз.
Dialogue: 0,0:04:52.58,0:04:55.21,Default,,0,0,0,,Мұны бәріміз білеміз, солай ма?
Dialogue: 0,0:04:55.87,0:04:59.09,Default,,0,0,0,,Адамның көзқарасы бойынша олар бір вампир.
Dialogue: 0,0:04:59.59,0:05:02.30,Default,,0,0,0,,Біз ерекшелік десек те.
Dialogue: 0,0:05:02.38,0:05:04.63,Default,,0,0,0,,Бұл проблема емес.
Dialogue: 0,0:05:05.51,0:05:06.68,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:06.76,0:05:10.05,Default,,0,0,0,,Мен Суханы сенуге мәжбүрлей алмаймын.
Dialogue: 0,0:05:10.14,0:05:14.18,Default,,0,0,0,,Негізі бізге осы уақытқа дейін ешкім сенген жоқ.
Dialogue: 0,0:05:14.89,0:05:16.94,Default,,0,0,0,,Онда менің таңдауым жоқ.
Dialogue: 0,0:05:17.02,0:05:17.85,Default,,0,0,0,,Суха бар
Dialogue: 0,0:05:17.94,0:05:21.94,Default,,0,0,0,,Солонды вампир деп айт, сонда біз аман қаламыз.
Dialogue: 0,0:05:22.03,0:05:22.73,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:22.82,0:05:25.57,Default,,0,0,0,,Е! Солон вампир ме?
Dialogue: 0,0:05:25.65,0:05:28.91,Default,,0,0,0,,Дұрыс, біз де таң қалдық.
Dialogue: 0,0:05:28.99,0:05:31.37,Default,,0,0,0,,Шатаспаңыз, тез бітірейік.
Dialogue: 0,0:05:31.45,0:05:32.29,Default,,0,0,0,,Иә, отын
Dialogue: 0,0:05:32.37,0:05:33.24,Default,,0,0,0,,Қараңызшы, бұл от.
Dialogue: 0,0:05:33.33,0:05:35.46,Default,,0,0,0,,Қарғыс атқан вампир!
Dialogue: 0,0:05:35.54,0:05:36.71,Default,,0,0,0,,Тоқта! сәуле!
Dialogue: 0,0:05:36.79,0:05:38.00,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:05:38.08,0:05:41.38,Default,,0,0,0,,Солон Сіздің құрбандық ешқашан ұмытылмайды.
Dialogue: 0,0:05:41.88,0:05:43.88,Default,,0,0,0,,Біздің жүрегімізде мәңгілік
Dialogue: 0,0:05:43.96,0:05:45.21,Default,,0,0,0,,Эй!
Dialogue: 0,0:05:45.30,0:05:48.55,Default,,0,0,0,,Нұх! Неге отын теріп жатырсың?
Dialogue: 0,0:05:48.63,0:05:50.35,Default,,0,0,0,,Джино, сен де от жақпа!
Dialogue: 0,0:05:50.43,0:05:51.85,Default,,0,0,0,,Мен көп жинасам да.
Dialogue: 0,0:05:51.93,0:05:52.68,Default,,0,0,0,,Көңіл күйде
Dialogue: 0,0:05:52.76,0:05:54.10,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:05:54.18,0:05:57.14,Default,,0,0,0,,Қазірдің өзінде! Сізге тек өзіңізді құрбан ету керек болды.
Dialogue: 0,0:05:57.23,0:05:59.23,Default,,0,0,0,,Сонда сен бір болу керексің!
Dialogue: 0,0:05:59.31,0:06:00.98,Default,,0,0,0,,Қазіргі жағдайда оның барар жері жоқ.
Dialogue: 0,0:06:01.06,0:06:04.78,Default,,0,0,0,,Осы мәселе бойынша әзірге екі кандидат бар...
Dialogue: 0,0:06:04.86,0:06:06.11,Default,,0,0,0,,Үміткерлер қандай?
Dialogue: 0,0:06:06.69,0:06:09.78,Default,,0,0,0,,Әйтеуір, өзіміздің шынайы болмысымызды ашудан сақ болайық.
Dialogue: 0,0:06:11.95,0:06:13.03,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:06:13.79,0:06:16.41,Default,,0,0,0,,Өз қабілеттеріңізді барынша қолданбауға тырысыңыз.
Dialogue: 0,0:06:17.16,0:06:19.42,Default,,0,0,0,,Шынайы болмысымыз ашылса
Dialogue: 0,0:06:20.42,0:06:23.71,Default,,0,0,0,,Мен енді мұнда қала алмаймын...
Dialogue: 0,0:06:29.51,0:06:33.39,Default,,0,0,0,,Мен бұл мектепте біраз уақыт қала аламын деп ойладым.
Dialogue: 0,0:06:33.89,0:06:36.68,Default,,0,0,0,,Бірақ біздің вампир екенімізді білсеңіз де
Dialogue: 0,0:06:36.77,0:06:40.35,Default,,0,0,0,,Суха ешкімге айтпайды деп ойлаймын.
Dialogue: 0,0:06:41.06,0:06:42.69,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:06:43.56,0:06:45.07,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:06:51.28,0:06:54.62,Default,,0,0,0,,Вампирлерде махаббат мүлде болмайды.
Dialogue: 0,0:06:55.20,0:06:58.62,Default,,0,0,0,,Вампирлер - жай ғана суық, қатыгез құбыжықтар!
Dialogue: 0,0:06:58.70,0:07:01.04,Default,,0,0,0,,Қасқырлар әлдеқайда жақсы!
Dialogue: 0,0:07:01.12,0:07:03.96,Default,,0,0,0,,Жоқ, салыстырудың қажеті жоқ.
Dialogue: 0,0:07:04.04,0:07:06.05,Default,,0,0,0,,Вампирлер - ең нашар!
Dialogue: 0,0:07:08.51,0:07:10.26,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:10.34,0:07:11.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.14,0:07:14.85,Default,,0,0,0,,Тікұшақ…
Dialogue: 0,0:07:14.93,0:07:16.43,Default,,0,0,0,,Сен мұнда болғансың ғой.
Dialogue: 0,0:07:20.39,0:07:21.39,Default,,0,0,0,,(Отыру дыбысы)
Dialogue: 0,0:07:28.53,0:07:31.99,Default,,0,0,0,,А-а... Ертерек бұл үшін кешірім сұраймын.
Dialogue: 0,0:07:32.07,0:07:34.45,Default,,0,0,0,,Мен жаңа ғана эмоционалды болдым.
Dialogue: 0,0:07:35.16,0:07:36.12,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:36.62,0:07:39.45,Default,,0,0,0,,Сіз вампирлерді қаншалықты жек көресіз?
Dialogue: 0,0:07:39.54,0:07:41.08,Default,,0,0,0,,Мен өте жақсы түсінемін.
Dialogue: 0,0:07:41.58,0:07:42.71,Default,,0,0,0,,Әрине
Dialogue: 0,0:07:42.79,0:07:45.71,Default,,0,0,0,,Иә...рахмет.
Dialogue: 0,0:07:46.21,0:07:47.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:47.50,0:07:50.97,Default,,0,0,0,,Бұны саған ертерек беруді ұмытып кетіппін.
Dialogue: 0,0:07:59.77,0:08:00.89,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:08:01.48,0:08:05.40,Default,,0,0,0,,Ойланып қарасам, жақында туған күнің келе жатыр дедің.
Dialogue: 0,0:08:05.48,0:08:08.73,Default,,0,0,0,,Суха келсе бәрі бақытты болар еді деп ойлаймын.
Dialogue: 0,0:08:09.23,0:08:10.23,Default,,0,0,0,,Келіңіз
Dialogue: 0,0:08:10.32,0:08:11.61,Default,,0,0,0,,Әрине!
Dialogue: 0,0:08:12.11,0:08:14.78,Default,,0,0,0,,Айтпақшы, кімнің туған күні?
Dialogue: 0,0:08:15.57,0:08:17.07,Default,,0,0,0,,Барлығымыз
Dialogue: 0,0:08:17.16,0:08:18.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:19.74,0:08:22.08,Default,,0,0,0,,Әркім өзінің туған күнін білмейді.
Dialogue: 0,0:08:22.71,0:08:23.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:23.79,0:08:25.63,Default,,0,0,0,,Сонымен, бұл күн туралы не деуге болады?
Dialogue: 0,0:08:27.46,0:08:30.76,Default,,0,0,0,,Біз мекемеден шыққан күн
Dialogue: 0,0:08:34.51,0:08:36.80,Default,,0,0,0,,Мен Ванфилдтен қашқан кезде
Dialogue: 0,0:08:36.89,0:08:39.01,Default,,0,0,0,,Мен сондай қорқынышты оқиғаны бастан өткерсем де
Dialogue: 0,0:08:39.51,0:08:42.43,Default,,0,0,0,,Балалар, сендер әлі де адамға сенесіңдер ме?
Dialogue: 0,0:08:44.14,0:08:47.61,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:08:47.69,0:08:49.36,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:08:49.44,0:08:54.36,Default,,0,0,0,,(Барлығы ауыр тыныс алады)
Dialogue: 0,0:08:55.03,0:08:56.41,Default,,0,0,0,,Сіздің артыңыздан ешкім жоқ па?
Dialogue: 0,0:08:56.49,0:08:58.49,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:08:58.57,0:08:59.20,Default,,0,0,0,,Үй!
Dialogue: 0,0:08:59.28,0:09:05.21,Default,,0,0,0,,(Барлығы ауыр тыныс алады)
Dialogue: 0,0:09:13.38,0:09:16.01,Default,,0,0,0,,Сіз мекемеден қашып кеттіңіз бе?
Dialogue: 0,0:09:17.51,0:09:18.55,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:19.14,0:09:20.81,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:22.14,0:09:25.77,Default,,0,0,0,,Бұл қойма пайдаланылмаған, сондықтан тыныштықта демалыңыз.
Dialogue: 0,0:09:25.85,0:09:27.48,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:09:27.56,0:09:30.48,Default,,0,0,0,,Жарайды, ешкімге айтпаймын.
Dialogue: 0,0:09:32.53,0:09:35.03,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:09:35.53,0:09:36.70,Default,,0,0,0,,Бұл пайдалы болды.
Dialogue: 0,0:09:36.78,0:09:37.49,Default,,0,0,0,,Иә
Dialogue: 0,0:09:37.57,0:09:39.95,Default,,0,0,0,,Кішкене демалғаннан кейін жолға шығайық.
Dialogue: 0,0:09:40.03,0:09:42.99,Default,,0,0,0,,(әтештер айғайлайды)
Dialogue: 0,0:09:43.08,0:09:44.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:48.04,0:09:49.75,Default,,0,0,0,,Қарапайым отбасы рөлін ойнауды жалғастыр
Dialogue: 0,0:09:49.83,0:09:51.00,Default,,0,0,0,,Мен де
Dialogue: 0,0:09:51.50,0:09:52.55,Default,,0,0,0,,Сабырлы болыңыз
Dialogue: 0,0:09:57.30,0:09:59.05,Default,,0,0,0,,Сіз аштыңыз ба?
Dialogue: 0,0:09:59.14,0:10:00.47,Default,,0,0,0,,Бұл қалдықтар...
Dialogue: 0,0:10:00.55,0:10:01.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:09.81,0:10:11.73,Default,,0,0,0,,Вампир пайда болды ма?
Dialogue: 0,0:10:11.81,0:10:14.03,Default,,0,0,0,,Олардың барлығын қазір өлтіруіміз керек.
Dialogue: 0,0:10:14.11,0:10:18.03,Default,,0,0,0,,(Барлығы ауыр тыныс алады)
Dialogue: 0,0:10:18.11,0:10:20.28,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:10:22.24,0:10:23.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:26.83,0:10:28.91,Default,,0,0,0,,Сіз осындай жерде болдыңыз ба?
Dialogue: 0,0:10:30.00,0:10:31.54,Default,,0,0,0,,Мен бұл туралы айттым ба?
Dialogue: 0,0:10:32.79,0:10:34.92,Default,,0,0,0,,Бұл нысанның сыртында қауіпті.
Dialogue: 0,0:10:35.80,0:10:39.13,Default,,0,0,0,,Енді Ванфилд үйіне оралайық.
Dialogue: 0,0:10:41.39,0:10:45.64,Default,,0,0,0,,Біз сенетін жалғыз адам – өзіміз.
Dialogue: 0,0:10:56.48,0:10:57.40,Default,,0,0,0,,Суха
Dialogue: 0,0:10:57.49,0:10:58.44,Default,,0,0,0,,Достар алдында
Dialogue: 0,0:10:58.53,0:11:01.41,Default,,0,0,0,,Сізді бір рет вампир өлтірді деп айттыңыз.
Dialogue: 0,0:11:01.91,0:11:02.95,Default,,0,0,0,,Иә
Dialogue: 0,0:11:04.08,0:11:05.45,Default,,0,0,0,,Сіз жақын болдыңыз ба?
Dialogue: 0,0:11:08.00,0:11:11.29,Default,,0,0,0,,Қараңдаршы, менде біртүрлі күш бар, солай ма?
Dialogue: 0,0:11:12.00,0:11:15.96,Default,,0,0,0,,Сондықтан айналамдағылар мені вампир деп ойлайды.
Dialogue: 0,0:11:17.42,0:11:20.88,Default,,0,0,0,,Мен жалғыз болдым...
Dialogue: 0,0:11:23.93,0:11:25.30,Default,,0,0,0,,Ата-анамнан
Dialogue: 0,0:11:25.39,0:11:28.89,Default,,0,0,0,,Маған бұл күшті ешқашан қолданбау керектігін айтты.
Dialogue: 0,0:11:32.19,0:11:35.82,Default,,0,0,0,,Крис мені түсінетін жалғыз адам болды.
Dialogue: 0,0:11:36.90,0:11:38.98,Default,,0,0,0,,Бірақ бір күні...
Dialogue: 0,0:11:39.07,0:11:41.11,Default,,0,0,0,,Крис әлі ішінде!
Dialogue: 0,0:11:41.20,0:11:42.49,Default,,0,0,0,,Кірме!
Dialogue: 0,0:11:42.57,0:11:46.70,Default,,0,0,0,,Жібер! Кристің аяғы ауыр!
Dialogue: 0,0:11:47.33,0:11:48.29,Default,,0,0,0,,(Ауыл тұрғындары айқайлайды)
Dialogue: 0,0:11:48.37,0:11:49.75,Default,,0,0,0,,А, сен!
Dialogue: 0,0:11:52.71,0:11:56.54,Default,,0,0,0,,Сол кезде менің ойым оған көмектесу ғана болатын.
Dialogue: 0,0:11:57.04,0:11:58.34,Default,,0,0,0,,Жоқ, Суха
Dialogue: 0,0:11:58.42,0:12:02.01,Default,,0,0,0,,Егер мені біреу көрсе, мені дұрыс түсінбейді.
Dialogue: 0,0:12:02.51,0:12:05.59,Default,,0,0,0,,Барлығы сені вампир деп ойлайды.
Dialogue: 0,0:12:06.76,0:12:09.43,Default,,0,0,0,,Крис! Крис!
Dialogue: 0,0:12:09.52,0:12:10.47,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:12:10.56,0:12:12.94,Default,,0,0,0,,Маған енді біреудің не ойлайтыны маңызды емес
Dialogue: 0,0:12:13.02,0:12:14.69,Default,,0,0,0,,Маған сенің айтқаның бәрібір
Dialogue: 0,0:12:15.19,0:12:16.90,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:12:16.98,0:12:18.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:19.28,0:12:20.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:21.24,0:12:22.40,Default,,0,0,0,,Крис!
Dialogue: 0,0:12:22.49,0:12:23.70,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:12:23.78,0:12:27.20,Default,,0,0,0,,Маған қазір көмектесуге рұқсат етіңіз!
Dialogue: 0,0:12:27.91,0:12:29.87,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:12:31.08,0:12:33.50,Default,,0,0,0,,Сол кезде мен ойладым
Dialogue: 0,0:12:34.00,0:12:34.92,Default,,0,0,0,,Менің күшім...
Dialogue: 0,0:12:38.84,0:12:41.21,Default,,0,0,0,,Осы мақсатта берілген.
Dialogue: 0,0:12:46.30,0:12:48.26,Default,,0,0,0,,Мен сендім.
Dialogue: 0,0:12:50.51,0:12:51.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:51.77,0:12:53.02,Default,,0,0,0,,Сен…
Dialogue: 0,0:12:54.81,0:12:57.27,Default,,0,0,0,,Оның келетініне сенімдімін.
Dialogue: 0,0:13:02.90,0:13:08.91,Default,,0,0,0,,Менің енді ешқашан Крис сияқты досым болмауы мүмкін.
Dialogue: 0,0:13:11.41,0:13:14.79,Default,,0,0,0,,Бірде маған өз мойынымды тістеп ал депті.
Dialogue: 0,0:13:15.29,0:13:18.00,Default,,0,0,0,,«Себебі мен сіздің вампир емес екеніңізге сенемін»
Dialogue: 0,0:13:19.59,0:13:23.01,Default,,0,0,0,,Тіпті өзім де сене алмадым
Dialogue: 0,0:13:24.34,0:13:26.01,Default,,0,0,0,,Уф…
Dialogue: 0,0:13:29.14,0:13:32.56,Default,,0,0,0,,Менің вампирге ғашық болып қалуым мүмкін емес.
Dialogue: 0,0:13:34.68,0:13:36.10,Default,,0,0,0,,-Суха -Хмм?
Dialogue: 0,0:13:36.60,0:13:38.98,Default,,0,0,0,,Менің мойнымды тістегің келе ме?
Dialogue: 0,0:13:39.06,0:13:39.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:39.90,0:13:41.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:42.02,0:13:44.36,Default,,0,0,0,,Жоқ... жоқ жоқ, не айтып тұрсың?
Dialogue: 0,0:13:44.44,0:13:45.61,Default,,0,0,0,,Ах, жоқ, яғни…
Dialogue: 0,0:13:45.69,0:13:48.32,Default,,0,0,0,,Мен сені ұнатпаймын деген сөз емес.
Dialogue: 0,0:13:48.41,0:13:49.41,Default,,0,0,0,,Иә
Dialogue: 0,0:13:49.99,0:13:55.66,Default,,0,0,0,,Себебі мен ол кезде бала едім, ал қазір мүлде басқаша.
Dialogue: 0,0:13:55.75,0:14:00.17,Default,,0,0,0,,Біз қазір ересек болуға тырысамыз, солай емес пе?
Dialogue: 0,0:14:00.25,0:14:03.88,Default,,0,0,0,,Ал... бәрібір бұл!
Dialogue: 0,0:14:03.96,0:14:04.92,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:06.51,0:14:07.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:08.88,0:14:10.43,Default,,0,0,0,,Міне, өтінемін?
Dialogue: 0,0:14:12.64,0:14:15.43,Default,,0,0,0,,Уау! Жоқ! Ұят!
Dialogue: 0,0:14:15.52,0:14:16.98,Default,,0,0,0,,Мүлде мүмкін емес!
Dialogue: 0,0:14:17.06,0:14:21.36,Default,,0,0,0,,Бірақ мен Сухаға сенемін.
Dialogue: 0,0:14:21.44,0:14:22.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:25.28,0:14:26.28,Default,,0,0,0,,Ой…
Dialogue: 0,0:14:26.36,0:14:28.70,Default,,0,0,0,,Сонымен... сонда тікұшақ ше?
Dialogue: 0,0:14:28.78,0:14:29.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:31.20,0:14:34.45,Default,,0,0,0,,Тікұшақ менің мойнымды да тістей алады ма?
Dialogue: 0,0:14:36.29,0:14:38.46,Default,,0,0,0,,О, мм...
Dialogue: 0,0:14:38.54,0:14:41.75,Default,,0,0,0,,Қараңдар! Сіз ұялып қалдыңыз, солай емес пе?
Dialogue: 0,0:14:41.83,0:14:43.09,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:14:43.17,0:14:44.96,Default,,0,0,0,,Жақсы... бұл дұрыс.
Dialogue: 0,0:14:46.26,0:14:48.47,Default,,0,0,0,,Хехе... Ахаха
Dialogue: 0,0:14:48.55,0:14:50.47,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:14:51.68,0:14:53.01,Default,,0,0,0,,Шынымды айтсам
Dialogue: 0,0:14:53.10,0:14:57.39,Default,,0,0,0,,Бұл мектепке келуімнің бір себебі – кітапхана.
Dialogue: 0,0:14:57.89,0:14:58.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:59.94,0:15:03.19,Default,,0,0,0,,Мүмкін бізде ескі кітаптар көп болғандықтан.
Dialogue: 0,0:15:03.27,0:15:06.32,Default,,0,0,0,,Менің ойымша, мен вампирдің әлсіз тұсын таба аламын.
Dialogue: 0,0:15:06.82,0:15:11.24,Default,,0,0,0,,Бірақ кеше плазада вампир пайда болды, солай ма?
Dialogue: 0,0:15:11.95,0:15:15.08,Default,,0,0,0,,Мен оны бірінші рет көрдім.
Dialogue: 0,0:15:15.58,0:15:18.91,Default,,0,0,0,,Қорыққаным сонша, мен бұрын ешқашан сезінбегенмін
Dialogue: 0,0:15:19.00,0:15:20.91,Default,,0,0,0,,Мен селк ете алмадым.
Dialogue: 0,0:15:21.67,0:15:24.71,Default,,0,0,0,,Бүкіл денем қатып қалғандай.
Dialogue: 0,0:15:25.21,0:15:27.92,Default,,0,0,0,,Бірақ соның арқасында мен түсіндім.
Dialogue: 0,0:15:28.01,0:15:32.13,Default,,0,0,0,,Вампирлер шын мәнінде құбыжықтар.
Dialogue: 0,0:15:32.64,0:15:33.84,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:35.76,0:15:36.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:39.10,0:15:40.77,Default,,0,0,0,,Мен қазір қайтуым керек.
Dialogue: 0,0:15:42.90,0:15:43.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:45.19,0:15:46.52,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:47.40,0:15:49.36,Default,,0,0,0,,Барлығы оны асыға күтеді.
Dialogue: 0,0:15:49.94,0:15:51.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:08.00,0:16:10.42,Default,,0,0,0,,Махан, ол жақта жағдай қалай?
Dialogue: 0,0:16:10.51,0:16:12.51,Default,,0,0,0,,Хабарсыз кеткен досым
Dialogue: 0,0:16:12.59,0:16:15.22,Default,,0,0,0,,Біз оны қайда алып кеткенін әлі білмейміз.
Dialogue: 0,0:16:15.30,0:16:19.31,Default,,0,0,0,,Осы қаланың жанында біреу вампирді көрген сияқты.
Dialogue: 0,0:16:19.39,0:16:20.98,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:21.06,0:16:25.23,Default,,0,0,0,,Біз өлтірілген студент қызға қатысты Десериске отырдық.
Dialogue: 0,0:16:25.31,0:16:28.57,Default,,0,0,0,,Бұл вампирлердің бұған еш қатысы жоқ сияқты.
Dialogue: 0,0:16:28.65,0:16:31.86,Default,,0,0,0,,Олардың шындықты айтуы мүмкін емес.
Dialogue: 0,0:16:31.94,0:16:35.07,Default,,0,0,0,,Вампирлер біздің достарымызға шабуыл жасайды.
Dialogue: 0,0:16:35.16,0:16:36.28,Default,,0,0,0,,Өйткені бұл анық
Dialogue: 0,0:16:36.78,0:16:39.20,Default,,0,0,0,,А... бірақ осы уақыт ішінде
Dialogue: 0,0:16:39.28,0:16:41.91,Default,,0,0,0,,Мен олардың вампирлермен соғысып жатқанын көрдім.
Dialogue: 0,0:16:42.41,0:16:45.42,Default,,0,0,0,,Мен оларды одақтас деп ойламадым.
Dialogue: 0,0:16:45.50,0:16:49.34,Default,,0,0,0,,Қалай болғанда да, қаладан көптеген қасқырлар жоғалып кетті.
Dialogue: 0,0:16:49.42,0:16:53.38,Default,,0,0,0,,Вампирлердің қандай да бір түрде қатысы бар екеніне күмән жоқ.
Dialogue: 0,0:16:54.05,0:16:56.72,Default,,0,0,0,,Сенің қасқыр екеніңді білсек, сені де нысанаға алады.
Dialogue: 0,0:16:57.34,0:16:59.60,Default,,0,0,0,,Түрлендіру кезінде абай болыңыз
Dialogue: 0,0:17:00.10,0:17:01.18,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:17:01.68,0:17:02.60,Default,,0,0,0,,Руслан
Dialogue: 0,0:17:02.68,0:17:05.48,Default,,0,0,0,,Менің ойымша, ол түнгі доп ойынына уақытында оралады ма?
Dialogue: 0,0:17:05.56,0:17:06.31,Default,,0,0,0,,Әрине
Dialogue: 0,0:17:06.40,0:17:09.36,Default,,0,0,0,,Камил-нии-сан, таныс емессің бе?
Dialogue: 0,0:17:09.44,0:17:11.02,Default,,0,0,0,,Рэм де көмектеседі.
Dialogue: 0,0:17:11.11,0:17:12.90,Default,,0,0,0,,Неге тым кеш дейсің?
Dialogue: 0,0:17:12.99,0:17:14.32,Default,,0,0,0,,-Аа -Кездескенше
Dialogue: 0,0:17:14.40,0:17:15.70,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:17:16.95,0:17:18.20,Default,,0,0,0,,Иә? Аға
Dialogue: 0,0:17:18.28,0:17:19.58,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:17:21.20,0:17:24.71,Default,,0,0,0,,Хан жігіті өзгере алмайтын шығар...
Dialogue: 0,0:17:24.79,0:17:27.12,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:17:27.21,0:17:30.00,Default,,0,0,0,,Бұған ешкім мән бермейді.
Dialogue: 0,0:17:30.09,0:17:33.46,Default,,0,0,0,,Ханнан артық басшы жоқ.
Dialogue: 0,0:17:33.55,0:17:34.47,Default,,0,0,0,,О
Dialogue: 0,0:17:34.55,0:17:35.34,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:36.05,0:17:39.85,Default,,0,0,0,,Әр адамның немен айналысатыны өзіне байланысты.
Dialogue: 0,0:17:41.76,0:17:44.22,Default,,0,0,0,,Сіз вампирмен араласасыз ба?
Dialogue: 0,0:17:48.48,0:17:50.77,Default,,0,0,0,,Менің болмысым қандай?
Dialogue: 0,0:17:50.86,0:17:51.98,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:17:52.98,0:17:56.24,Default,,0,0,0,,Бұл тек мен емес, менің барлық достарым
Dialogue: 0,0:18:09.33,0:18:13.25,Default,,0,0,0,,Қасқырлар шынымен келе жатыр ма?
Dialogue: 0,0:18:13.34,0:18:15.51,Default,,0,0,0,,Шақыруға әлі жауап келмеген сияқты.
Dialogue: 0,0:18:16.13,0:18:18.34,Default,,0,0,0,,Бұл келмейтініңді білдіре ме?
Dialogue: 0,0:18:18.43,0:18:20.89,Default,,0,0,0,,Тек адам саны көбейген жағдайда
Dialogue: 0,0:18:20.97,0:18:23.10,Default,,0,0,0,,Сіз дайындалып жатқан сияқтысыз.
Dialogue: 0,0:18:25.43,0:18:26.52,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл
Dialogue: 0,0:18:26.60,0:18:27.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:32.61,0:18:35.19,Default,,0,0,0,,Сіздің суреттеріңіз әдеттегідей жақсы.
Dialogue: 0,0:18:35.28,0:18:37.40,Default,,0,0,0,,Мен де осында көмектестім.
Dialogue: 0,0:18:37.49,0:18:39.15,Default,,0,0,0,,-Уау! -иә?
Dialogue: 0,0:18:39.24,0:18:43.12,Default,,0,0,0,,Менің шедеврім!
Dialogue: 0,0:18:43.20,0:18:43.95,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:44.03,0:18:47.16,Default,,0,0,0,,Тікұшақ тортты қағып кетті.
Dialogue: 0,0:18:47.25,0:18:48.41,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:49.12,0:18:52.17,Default,,0,0,0,,Оған көмектесу мүмкін емес. Әлі уақыт бар, оны қайта жасайық.
Dialogue: 0,0:18:52.25,0:18:55.42,Default,,0,0,0,,Туған күніңізде торт алмау мүмкін емес.
Dialogue: 0,0:18:55.50,0:18:57.46,Default,,0,0,0,,Маған материал сатып алу керек.
Dialogue: 0,0:18:57.55,0:18:58.76,Default,,0,0,0,,Жакадан сұраңыз
Dialogue: 0,0:18:58.84,0:19:00.05,Default,,0,0,0,,Эх!
Dialogue: 0,0:19:00.13,0:19:03.01,Default,,0,0,0,,Сіз қалай ойлайсыз? Өте жақсы, иә?
Dialogue: 0,0:19:10.27,0:19:11.27,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:12.15,0:19:15.07,Default,,0,0,0,,Жака Кешіріңіз, мен сізден тез бірдеңе сатып алуыңызды сұраймын.
Dialogue: 0,0:19:15.15,0:19:16.82,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:19:20.28,0:19:22.41,Default,,0,0,0,,Иә? Күйіп қалды ма?
Dialogue: 0,0:19:25.33,0:19:26.45,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:19:28.25,0:19:29.45,Default,,0,0,0,,Мен сиқыр жасаймын.
Dialogue: 0,0:19:29.54,0:19:32.25,Default,,0,0,0,,Осындай кездерде Джака болуы ыңғайлы.
Dialogue: 0,0:19:32.33,0:19:34.46,Default,,0,0,0,,А... рамен жоқ.
Dialogue: 0,0:19:34.54,0:19:35.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:35.17,0:19:37.34,Default,,0,0,0,,Бұл сіздің жазбаңызда жоқ еді, солай ма?
Dialogue: 0,0:19:37.42,0:19:40.13,Default,,0,0,0,,Тікұшақ Сіз оны жазуды ұмытып қалдыңыз ба?
Dialogue: 0,0:19:40.22,0:19:42.97,Default,,0,0,0,,Жоқ, бар ма? Рамен
Dialogue: 0,0:19:43.80,0:19:45.22,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:19:45.80,0:19:47.47,Default,,0,0,0,,Раменсіз
Dialogue: 0,0:19:49.31,0:19:51.60,Default,,0,0,0,,Тағы барасыз ба?
Dialogue: 0,0:20:30.06,0:20:31.02,Default,,0,0,0,,(Сувенир дүкенінің иесі) Хмм… (Турист 1) Ә?
Dialogue: 0,0:20:36.61,0:20:37.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:37.86,0:20:41.19,Default,,0,0,0,,Сәлем, Суха!
Dialogue: 0,0:20:41.28,0:20:42.32,Default,,0,0,0,,(Кашиваги) Олай деу дұрыс па?
Dialogue: 0,0:20:42.40,0:20:44.03,Default,,0,0,0,,Мен көптен күттім!
Dialogue: 0,0:20:45.78,0:20:47.41,Default,,0,0,0,,Қандай керемет жер.
Dialogue: 0,0:20:47.49,0:20:49.41,Default,,0,0,0,,Не? Денің сау ма? (Миямура) Иә.
Dialogue: 0,0:20:49.49,0:20:52.16,Default,,0,0,0,,Орманның ортасында, сондықтан келу қиын болған шығар.
Dialogue: 0,0:20:52.25,0:20:54.67,Default,,0,0,0,,Егер ол оны өзінің Қабілетімен көтерсе, бастаманы өз қолына алады
Dialogue: 0,0:20:54.75,0:20:56.83,Default,,0,0,0,,Бірақ мен шынымен таң қалдым.
Dialogue: 0,0:20:56.92,0:21:01.09,Default,,0,0,0,,Мен орманның тереңінде осындай керемет сарай бар екеніне сене алар емеспін.
Dialogue: 0,0:21:01.17,0:21:03.34,Default,,0,0,0,,Дұрыс? Мен оны салдым.
Dialogue: 0,0:21:03.42,0:21:07.22,Default,,0,0,0,,Жарайды, шүкір, кездейсоқ мұраға қалдым.
Dialogue: 0,0:21:07.30,0:21:09.10,Default,,0,0,0,,Не? Кімнен?
Dialogue: 0,0:21:09.18,0:21:14.10,Default,,0,0,0,,Бізді мекемеден кеткеннен кейін де көптен бері қолдаған адамдар болды.
Dialogue: 0,0:21:14.18,0:21:15.39,Default,,0,0,0,,А...
Dialogue: 0,0:21:15.48,0:21:17.73,Default,,0,0,0,,Көмегің үшін көп рахмет.
Dialogue: 0,0:21:17.81,0:21:21.15,Default,,0,0,0,,Ол кісі өмірден озды, бізге мұра болды.
Dialogue: 0,0:21:21.23,0:21:22.94,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:21:23.03,0:21:24.78,Default,,0,0,0,,Жарайды, мен жатақханада тұрамын.
Dialogue: 0,0:21:24.86,0:21:27.61,Default,,0,0,0,,Мен тек демалыс күндері және жазғы демалыста келе аламын.
Dialogue: 0,0:21:28.49,0:21:31.37,Default,,0,0,0,,Бақша да өте тамаша.
Dialogue: 0,0:21:31.45,0:21:33.20,Default,,0,0,0,,Мен оған қамқорлық жасадым.
Dialogue: 0,0:21:33.29,0:21:34.79,Default,,0,0,0,,Бұл да өтірік
Dialogue: 0,0:21:34.87,0:21:37.00,Default,,0,0,0,,Кіріңіз, мен сізге айналаңызды көрсетемін.
Dialogue: 0,0:21:37.08,0:21:38.67,Default,,0,0,0,,-Аа -Ах...
Dialogue: 0,0:21:40.92,0:21:41.84,Default,,0,0,0,,Суха!
Dialogue: 0,0:21:41.92,0:21:42.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:44.05,0:21:44.88,Default,,0,0,0,,Хан!
Dialogue: 0,0:21:44.97,0:21:46.63,Default,,0,0,0,,Йо...й
Dialogue: 0,0:21:55.93,0:21:57.94,Default,,0,0,0,,♪～
Dialogue: 0,0:23:21.23,0:23:23.23,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.53,0:23:37.58,Default,,0,0,0,,Келесі 6 эпизод
Dialogue: 0,0:23:38.08,0:23:40.87,Default,,0,0,0,,«Аңшының айы -Туған күн кеші-»
Dialogue: 0,0:23:42.37,0:23:48.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory