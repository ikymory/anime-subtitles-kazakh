Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:08.17,Default,,0,0,0,,Анна Қуыршақ
Dialogue: 0,0:00:08.25,0:00:09.80,Default,,0,0,0,,қабылдаңыз.
Dialogue: 0,0:00:09.88,0:00:11.67,Default,,0,0,0,,Иә, Ламберт мырза.
Dialogue: 0,0:00:11.76,0:00:16.01,Default,,0,0,0,,Кел! Менің жануарым Зубен Эль Генуби!
Dialogue: 0,0:00:17.01,0:00:18.97,Default,,0,0,0,,Раушан боран!
Dialogue: 0,0:00:20.72,0:00:23.52,Default,,0,0,0,,Сириустың құйындары!
Dialogue: 0,0:00:26.69,0:00:27.94,Default,,0,0,0,,Ммм
Dialogue: 0,0:00:28.02,0:00:29.32,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:32.61,0:00:34.03,Default,,0,0,0,,-Ох~ -Мм...
Dialogue: 0,0:00:34.70,0:00:35.03,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:00:35.03,0:00:37.57,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:00:35.03,0:00:37.57,Default,,0,0,0,,Өсімдіктерді еркін өңдей алатын жер сиқыры
Dialogue: 0,0:00:37.57,0:00:37.66,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:00:37.66,0:00:41.16,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:00:37.66,0:00:41.16,Default,,0,0,0,,Аннаның жел сиқырымен соқтығысып, мүлде жоғалып кетті.
Dialogue: 0,0:00:41.16,0:00:41.24,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:00:41.24,0:00:41.70,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:00:41.24,0:00:41.70,Default,,0,0,0,,Иә, мен сабақта білгенімдей.
Dialogue: 0,0:00:41.70,0:00:44.33,Default,,0,0,0,,Иә, мен сабақта білгенімдей.
Dialogue: 0,0:00:44.41,0:00:47.08,Default,,0,0,0,,Сиқырлы таяқша кітабын пайдалануға қалай қарайсың?
Dialogue: 0,0:00:47.17,0:00:48.79,Default,,0,0,0,,Ламберт мырза
Dialogue: 0,0:00:49.67,0:00:51.25,Default,,0,0,0,,Иә Мисс Грейс
Dialogue: 0,0:00:51.34,0:00:54.47,Default,,0,0,0,,Күткендей... жоқ, күткеннен жақсы
Dialogue: 0,0:00:54.55,0:00:55.59,Default,,0,0,0,,Керемет!
Dialogue: 0,0:00:55.68,0:00:57.09,Default,,0,0,0,,Жақсы теңдестірілген және қолмен ұстауға оңай
Dialogue: 0,0:00:57.18,0:00:59.43,Default,,0,0,0,,Мына кітаптың омыртқасына қара!
Dialogue: 0,0:00:59.51,0:01:01.43,Default,,0,0,0,,Беттерді ашық ұстауды жеңілдетіңіз
Dialogue: 0,0:01:01.51,0:01:03.93,Default,,0,0,0,,Түптеу әдісі де ойлап табылды...
Dialogue: 0,0:01:04.77,0:01:07.10,Default,,0,0,0,,Хмм... Ахх
Dialogue: 0,0:01:07.19,0:01:08.52,Default,,0,0,0,,(Ламберт канализациясы)
Dialogue: 0,0:01:08.61,0:01:11.57,Default,,0,0,0,,Кешіріңіз, сізді тыныштық деп санайтын қызметші еткенім үшін.
Dialogue: 0,0:01:11.65,0:01:13.32,Default,,0,0,0,,Мен жай ғана ренжідім.
Dialogue: 0,0:01:13.40,0:01:14.78,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:01:14.86,0:01:16.24,Default,,0,0,0,,Тыныштық?
Dialogue: 0,0:01:16.32,0:01:19.24,Default,,0,0,0,,Сізге ұнаған сияқты.
Dialogue: 0,0:01:19.32,0:01:20.74,Default,,0,0,0,,Мейстер Вальс!
Dialogue: 0,0:01:20.83,0:01:22.54,Default,,0,0,0,,Осы уақыт үшін рахмет.
Dialogue: 0,0:01:22.62,0:01:25.25,Default,,0,0,0,,Ол сіздің қолыңызға ыңғайлы және пайдалану сіз ойлағаннан да оңай...
Dialogue: 0,0:01:25.33,0:01:27.75,Default,,0,0,0,,Сиқырлы көрмеден бір аптадан кейін
Dialogue: 0,0:01:28.42,0:01:30.79,Default,,0,0,0,,Ламберт, Анна және ханзада Лукас
Dialogue: 0,0:01:30.88,0:01:33.25,Default,,0,0,0,,Мұнда Оверн отбасына барды.
Dialogue: 0,0:01:33.34,0:01:36.05,Default,,0,0,0,,Ламберт Грейстің сиқырлы қорын көрді.
Dialogue: 0,0:01:36.13,0:01:39.26,Default,,0,0,0,,Мен де осыған ұқсас нәрсе жасағым келеді.
Dialogue: 0,0:01:39.34,0:01:43.77,Default,,0,0,0,,Екі апта бұрын мен Вальс шеберінен кітапты өзгертуді өтіндім.
Dialogue: 0,0:01:43.85,0:01:46.68,Default,,0,0,0,,Бүгінгі таңда сиқырлы таяқшасы бар кітап...
Dialogue: 0,0:01:46.77,0:01:49.27,Default,,0,0,0,,«Таяқша кітабын» алуға келдім.
Dialogue: 0,0:01:49.35,0:01:50.73,Default,,0,0,0,,Анна да телефон соқты
Dialogue: 0,0:01:50.81,0:01:54.53,Default,,0,0,0,,Әрине, бұл менің стратегиямды алға жылжытуға мүмкіндік деп ойладым.
Dialogue: 0,0:01:54.61,0:01:57.15,Default,,0,0,0,,Анна мен Ламберт
Dialogue: 0,0:01:57.24,0:02:00.70,Default,,0,0,0,,Сиқырлы атрибуттар жел мен жерге қарама-қарсы.
Dialogue: 0,0:02:00.78,0:02:04.20,Default,,0,0,0,,Үйлесімділік таңқаларлықтай жаман емес сияқты.
Dialogue: 0,0:02:04.29,0:02:05.41,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:02:05.50,0:02:07.71,Default,,0,0,0,,Қарама-қарсы мінезді екі адам жақсырақ
Dialogue: 0,0:02:07.79,0:02:11.92,Default,,0,0,0,,Мүмкін олар бір-бірін толықтырып, жақсы жұмыс істейді.
Dialogue: 0,0:02:12.00,0:02:16.17,Default,,0,0,0,,Бұл екі адам бір-біріне мүлде қарама-қайшы болғандықтан, олар бірігсе, бәрі жақсы болады.
Dialogue: 0,0:02:16.26,0:02:19.05,Default,,0,0,0,,Байқадым, мұндай жағдайлар кейде болады.
Dialogue: 0,0:02:19.13,0:02:21.55,Default,,0,0,0,,Мен бірден ешқандай мысал келтіре алмаймын, бірақ
Dialogue: 0,0:02:21.64,0:02:23.51,Default,,0,0,0,,Өзім!
Dialogue: 0,0:02:24.01,0:02:29.02,Default,,0,0,0,,♪～
Dialogue: 0,0:03:48.93,0:03:53.94,Default,,0,0,0,,～♪
Dialogue: 0,0:03:54.02,0:03:55.56,Default,,0,0,0,,Бейлдің кітабы
Dialogue: 0,0:03:55.65,0:03:57.15,Default,,0,0,0,,Доктор Фауст
Dialogue: 0,0:03:57.23,0:03:58.90,Default,,0,0,0,,«Сиқырлы шеңберлерге кіріспе», солай ма?
Dialogue: 0,0:03:58.98,0:04:00.19,Default,,0,0,0,,Иә
Dialogue: 0,0:04:00.28,0:04:02.28,Default,,0,0,0,,Бұл жақсы кітап.
Dialogue: 0,0:04:02.36,0:04:04.57,Default,,0,0,0,,Мен де кітапханада оқыдым.
Dialogue: 0,0:04:04.66,0:04:05.99,Default,,0,0,0,,Сіз жақсы білетіндей, біздің Марли еліміздің жаулары тым көп.
Dialogue: 0,0:04:06.07,0:04:09.54,Default,,0,0,0,,Мен туған отбасы шекарадағы кедей ақсүйектер болатын.
Dialogue: 0,0:04:09.62,0:04:14.79,Default,,0,0,0,,Менің ата-анам бауырларымның білім алуына көп қаржы бөлді.
Dialogue: 0,0:04:14.87,0:04:19.42,Default,,0,0,0,,Ерлік дарынды ағаларыңызға жақсы ат пен сауыт беріңіз.
Dialogue: 0,0:04:19.50,0:04:23.68,Default,,0,0,0,,Бұл кітапты маған сиқырды жақсы көретінім үшін берді.
Dialogue: 0,0:04:24.30,0:04:25.93,Default,,0,0,0,,Әлі есімде
Dialogue: 0,0:04:26.01,0:04:28.68,Default,,0,0,0,,Алғаш рет жетістікке жеткеніңіз туралы
Dialogue: 0,0:04:29.68,0:04:32.52,Default,,0,0,0,,Әлсіз ағашты гүлдендіріп жіберген сиқыр болды.
Dialogue: 0,0:04:33.73,0:04:35.81,Default,,0,0,0,,Сол кезде мен ойладым
Dialogue: 0,0:04:35.90,0:04:39.11,Default,,0,0,0,,Егер сізде бұл кітап болса, ол сіздің өміріңізді толықтыратыны сөзсіз.
Dialogue: 0,0:04:39.19,0:04:42.03,Default,,0,0,0,,Үлкен гүлдерді гүлдете алсаң
Dialogue: 0,0:04:42.53,0:04:44.07,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:04:44.15,0:04:45.61,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:04:45.70,0:04:49.08,Default,,0,0,0,,Ламберт мырза ата-анасының мақтанышы.
Dialogue: 0,0:04:49.16,0:04:50.70,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:04:51.29,0:04:55.37,Default,,0,0,0,,Мен... Мен де солай ойлаймын, Ламберт мырза.
Dialogue: 0,0:04:55.46,0:04:57.63,Default,,0,0,0,,Жоқ, жоқ, егер солай десеңіз.
Dialogue: 0,0:04:57.71,0:05:00.71,Default,,0,0,0,,Сіздің ата-анаңыз да солай емес пе? Анна ханым
Dialogue: 0,0:05:00.80,0:05:04.88,Default,,0,0,0,,А... жоқ, бұл...
Dialogue: 0,0:05:04.97,0:05:07.47,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:05:07.55,0:05:08.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:08.55,0:05:11.47,Default,,0,0,0,,Ой, бұл жақсы атмосфера емес пе?
Dialogue: 0,0:05:11.56,0:05:14.64,Default,,0,0,0,,Өйткені олардың жағдайлары ұқсас.
Dialogue: 0,0:05:14.73,0:05:17.60,Default,,0,0,0,,Ламберт жолы да шынайы нұсқа болып табылады.
Dialogue: 0,0:05:18.19,0:05:20.11,Default,,0,0,0,,Біріншіден, Анна қарапайым адам.
Dialogue: 0,0:05:20.19,0:05:23.19,Default,,0,0,0,,Ламберт бастапқыда шекарадан шыққан әлсіз дворян болды.
Dialogue: 0,0:05:23.28,0:05:26.74,Default,,0,0,0,,Оверн герцогы да ауыл ақсүйектерінен шыққан.
Dialogue: 0,0:05:26.82,0:05:29.20,Default,,0,0,0,,Бұл дүниеде төменгі тап
Dialogue: 0,0:05:29.28,0:05:31.78,Default,,0,0,0,,Сіздің қабілетіңізге байланысты мәртебеңіз көтерілуі мүмкін.
Dialogue: 0,0:05:31.87,0:05:33.87,Default,,0,0,0,,Бұл кең таралған
Dialogue: 0,0:05:33.95,0:05:37.04,Default,,0,0,0,,Содан кейін сценарийдің орындалу барысына байланысты,
Dialogue: 0,0:05:37.12,0:05:40.13,Default,,0,0,0,,Анна ханзадаға үйленіп патшайым болатын жол да бар.
Dialogue: 0,0:05:40.21,0:05:42.30,Default,,0,0,0,,Бұл мүмкін екенін білдіреді.
Dialogue: 0,0:05:42.38,0:05:43.88,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:05:43.96,0:05:46.51,Default,,0,0,0,,Анна Сіз ештеңе жемеген сияқтысыз.
Dialogue: 0,0:05:46.59,0:05:47.47,Default,,0,0,0,,Ах
Dialogue: 0,0:05:47.55,0:05:48.93,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:05:49.01,0:05:52.51,Default,,0,0,0,,Жоқ... шын мәнінде, бұл...
Dialogue: 0,0:05:52.60,0:05:56.68,Default,,0,0,0,,Мен бұл тәттілерді бірінші рет көріп тұрмын, қалай жейтінімді білмеймін.
Dialogue: 0,0:05:56.77,0:05:59.15,Default,,0,0,0,,Мынау... этикет.
Dialogue: 0,0:05:59.23,0:06:00.94,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:06:01.02,0:06:03.32,Default,,0,0,0,,Баланс үйіне алғаш келгенімде,
Dialogue: 0,0:06:03.40,0:06:06.86,Default,,0,0,0,,Үстелдегі әдепті мүлде түсінбейтіндіктен мен ұтылдым.
Dialogue: 0,0:06:06.94,0:06:08.40,Default,,0,0,0,,Ламберт мырза да?
Dialogue: 0,0:06:08.49,0:06:10.11,Default,,0,0,0,,Таңқаларлық емес.
Dialogue: 0,0:06:10.20,0:06:13.16,Default,,0,0,0,,Ах, Грейс-чан, сен маған айтуың керек шығар.
Dialogue: 0,0:06:13.24,0:06:15.16,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:06:15.24,0:06:18.54,Default,,0,0,0,,Жоқ, мен сізге дәл қазір ештеңе үйреткім келмейді.
Dialogue: 0,0:06:18.62,0:06:20.42,Default,,0,0,0,,Жазғы демалыс жақындап қалды емес пе?
Dialogue: 0,0:06:20.50,0:06:21.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:21.50,0:06:24.30,Default,,0,0,0,,Анна-чан, жазғы демалысқа қандай жоспарларыңыз бар?
Dialogue: 0,0:06:24.38,0:06:26.17,Default,,0,0,0,,Иә
Dialogue: 0,0:06:26.26,0:06:27.17,Default,,0,0,0,,осы портта бір жерде жасырынып, бізді бақылап отыр.
Dialogue: 0,0:06:27.26,0:06:29.63,Default,,0,0,0,,Жатақхана ашық болған кезде ол жерде болыңыз.
Dialogue: 0,0:06:29.72,0:06:32.18,Default,,0,0,0,,Мен ата-анамның үйі жабық тұрғанда қайтуды ойлап жүрмін.
Dialogue: 0,0:06:32.26,0:06:34.31,Default,,0,0,0,,Мұның өзі ысырап!
Dialogue: 0,0:06:34.97,0:06:36.68,Default,,0,0,0,,Жазғы каникул кезінде
Dialogue: 0,0:06:36.77,0:06:39.27,Default,,0,0,0,,Грейс-чан Анна-чанды Оверннің үйіне шақырды.
Dialogue: 0,0:06:39.35,0:06:43.56,Default,,0,0,0,,Сізге ақсүйектердің өмірі туралы барлығын үйретсек қалай?
Dialogue: 0,0:06:43.65,0:06:46.40,Default,,0,0,0,,Түсіндім, бұл тамаша идея.
Dialogue: 0,0:06:46.48,0:06:47.44,Default,,0,0,0,,Иә, иә!?
Dialogue: 0,0:06:47.53,0:06:50.78,Default,,0,0,0,,Мен... Саған ондай қиындық тудыруға шамасы жоқ...
Dialogue: 0,0:06:50.86,0:06:54.95,Default,,0,0,0,,Менің ақсүйектер өмірін білудің еш мәні жоқ.
Dialogue: 0,0:06:55.03,0:06:57.08,Default,,0,0,0,,Жоқ Анна
Dialogue: 0,0:06:57.16,0:06:58.91,Default,,0,0,0,,Сіздің ұстанымыңыз әлі де бар
Dialogue: 0,0:06:59.00,0:07:01.17,Default,,0,0,0,,Сіз бұл туралы көп білмейтін сияқтысыз.
Dialogue: 0,0:07:01.25,0:07:02.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:02.17,0:07:03.96,Default,,0,0,0,,Сіз жақын болашақтасыз
Dialogue: 0,0:07:04.54,0:07:08.34,Default,,0,0,0,,Сіз тіпті осы елдегі ең жоғары лауазымға орналаса аласыз.
Dialogue: 0,0:07:08.42,0:07:10.72,Default,,0,0,0,,Егер сіз ханзада жолымен жүрсеңіз.
Dialogue: 0,0:07:10.80,0:07:12.05,Default,,0,0,0,,Сол уақытқа
Dialogue: 0,0:07:12.14,0:07:15.35,Default,,0,0,0,,Минималды ережелер мен этикетті білу керек.
Dialogue: 0,0:07:15.43,0:07:16.85,Default,,0,0,0,,Иә!?
Dialogue: 0,0:07:16.93,0:07:20.23,Default,,0,0,0,,Бұл елдегі ең жоғары мәртебе, әрине, роялти.
Dialogue: 0,0:07:20.31,0:07:22.85,Default,,0,0,0,,Ал болашақ патша мәртебелі Вергилий болады.
Dialogue: 0,0:07:22.94,0:07:24.98,Default,,0,0,0,,Келіншек – Грейс.
Dialogue: 0,0:07:25.06,0:07:27.65,Default,,0,0,0,,Бұл мен үшін...
Dialogue: 0,0:07:28.82,0:07:30.57,Default,,0,0,0,,Патшайым болған Грейске
Dialogue: 0,0:07:30.65,0:07:32.53,Default,,0,0,0,,Сот ханымы ретінде қызмет ету
Dialogue: 0,0:07:32.61,0:07:34.49,Default,,0,0,0,,Сіз оны күтесіз бе?
Dialogue: 0,0:07:34.57,0:07:36.24,Default,,0,0,0,,Түсіндім, Грейс.
Dialogue: 0,0:07:36.33,0:07:38.74,Default,,0,0,0,,Ол күн де ​​келеді... Сол күн үшін!
Dialogue: 0,0:07:38.83,0:07:41.50,Default,,0,0,0,,Жоғары сыныптың әдептілігін көрсету үшін бар күшіңізді салыңыз.
Dialogue: 0,0:07:41.58,0:07:43.29,Default,,0,0,0,,Есіңізде болатынына сенімдімін!
Dialogue: 0,0:07:44.00,0:07:46.00,Default,,0,0,0,,Сонда... шынымен бе?
Dialogue: 0,0:07:46.09,0:07:49.67,Default,,0,0,0,,Сонымен, мен жазғы демалыста өз үйімде болып, сабақ оқитын боламын.
Dialogue: 0,0:07:49.76,0:07:50.80,Default,,0,0,0,,Бұл жақсы, солай ма?
Dialogue: 0,0:07:50.88,0:07:52.68,Default,,0,0,0,,Иә, Грейс!
Dialogue: 0,0:07:52.76,0:07:55.85,Default,,0,0,0,,Бұл екеуі өте жақсы достар.
Dialogue: 0,0:07:55.93,0:07:57.01,Default,,0,0,0,,Міне~
Dialogue: 0,0:07:57.10,0:07:58.81,Default,,0,0,0,,Бірдеңе қосылмаған.
Dialogue: 0,0:07:58.89,0:08:00.93,Default,,0,0,0,,Өйткені бұл қызық!
Dialogue: 0,0:08:09.48,0:08:13.49,Default,,0,0,0,,Жек көру... бұл қайда? Міне
Dialogue: 0,0:08:13.99,0:08:16.74,Default,,0,0,0,,Бұл өте жалғыз жер.
Dialogue: 0,0:08:16.82,0:08:17.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:19.62,0:08:21.54,Default,,0,0,0,,- (Хинако) Әкем - (Кенсабуро) Иә?
Dialogue: 0,0:08:23.37,0:08:25.29,Default,,0,0,0,,О, Орион?
Dialogue: 0,0:08:25.37,0:08:28.79,Default,,0,0,0,,Міне, міне, әке.
Dialogue: 0,0:08:28.88,0:08:32.97,Default,,0,0,0,,Түсіндім, мен сенің әкең сияқтымын.
Dialogue: 0,0:08:34.38,0:08:37.89,Default,,0,0,0,,Бірақ сіз қашан сөйлей алдыңыз?
Dialogue: 0,0:08:37.97,0:08:41.68,Default,,0,0,0,,Бұл дауыс таныс сияқты...
Dialogue: 0,0:08:44.98,0:08:45.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:48.56,0:08:49.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:51.11,0:08:52.49,Default,,0,0,0,,О...
Dialogue: 0,0:09:01.87,0:09:03.29,Default,,0,0,0,,Грейс?
Dialogue: 0,0:09:05.62,0:09:07.92,Default,,0,0,0,,Грейс Ум...
Dialogue: 0,0:09:08.00,0:09:09.79,Default,,0,0,0,,Ең алдымен мен не айтуым керек?
Dialogue: 0,0:09:09.88,0:09:13.55,Default,,0,0,0,,«Танысқаныма қуаныштымын» дегені де біртүрлі көрінеді.
Dialogue: 0,0:09:13.63,0:09:17.05,Default,,0,0,0,,Біріншіден, мен бұл бала туралы не айтамын?
Dialogue: 0,0:09:19.64,0:09:21.47,Default,,0,0,0,,Ойланып қарасаңыз, И
Dialogue: 0,0:09:21.56,0:09:25.48,Default,,0,0,0,,Олар әлі біз туралы ештеңе білмейді.
Dialogue: 0,0:09:25.56,0:09:28.56,Default,,0,0,0,,Алдымен ол жерден шық, Грейс.
Dialogue: 0,0:09:29.40,0:09:33.32,Default,,0,0,0,,Мен осылай қараңғы және салқын жерде тығылып жатсам ше?
Dialogue: 0,0:09:33.40,0:09:35.57,Default,,0,0,0,,Денсаулыққа зиян
Dialogue: 0,0:09:36.53,0:09:38.95,Default,,0,0,0,,(Китамура) Жарайды, Сатору, енді уақыты келген сияқты.
Dialogue: 0,0:09:43.79,0:09:45.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:46.91,0:09:48.33,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:09:48.42,0:09:51.25,Default,,0,0,0,,Мм... жас ханым.
Dialogue: 0,0:09:51.34,0:09:53.21,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:09:53.30,0:09:58.22,Default,,0,0,0,,А... иә, қайырлы таң Джозетта.
Dialogue: 0,0:09:58.30,0:10:00.72,Default,,0,0,0,,Жаман түс көрдіңіз бе?
Dialogue: 0,0:10:00.80,0:10:02.43,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:02.51,0:10:05.14,Default,,0,0,0,,Бірақ бұл қандай түс болды?
Dialogue: 0,0:10:05.68,0:10:07.23,Default,,0,0,0,,Мен есімде жоқ.
Dialogue: 0,0:10:07.31,0:10:10.19,Default,,0,0,0,,-Мм, Грейс-сама -Хмм?
Dialogue: 0,0:10:10.27,0:10:11.19,Default,,0,0,0,,Га
Dialogue: 0,0:10:11.27,0:10:14.69,Default,,0,0,0,,Анна! не болды? Бұл көрініс
Dialogue: 0,0:10:21.41,0:10:24.41,Default,,0,0,0,,Мен таңдаулымын ба?
Dialogue: 0,0:10:24.91,0:10:28.33,Default,,0,0,0,,Жаңа болған оқиға түс болды, солай ма?
Dialogue: 0,0:10:29.04,0:10:30.54,Default,,0,0,0,,Түс көретін көрініс пайда болды ма?
Dialogue: 0,0:10:30.62,0:10:32.34,Default,,0,0,0,,Бұл бірінші рет емес пе?
Dialogue: 0,0:10:32.92,0:10:34.55,Default,,0,0,0,,Сол себетке Грейс
Dialogue: 0,0:10:34.63,0:10:37.34,Default,,0,0,0,,Мен бұл нені білдіретінін білмеймін
Dialogue: 0,0:10:38.05,0:10:42.09,Default,,0,0,0,,Бұл маңызды нәрсенің кілті болатынына сенімдімін...
Dialogue: 0,0:10:42.18,0:10:45.85,Default,,0,0,0,,Өйткені, бұл мүлдем басқа жол.
Dialogue: 0,0:10:45.93,0:10:47.73,Default,,0,0,0,,«Махаббат арасы» ойынының сценарийі қандай?
Dialogue: 0,0:10:47.81,0:10:49.02,Default,,0,0,0,,Мүлде жоқ—
Dialogue: 0,0:10:49.10,0:10:52.36,Default,,0,0,0,,Бұл әлемнің қайталанбас оқиғасы басталды.
Dialogue: 0,0:10:53.02,0:10:56.98,Default,,0,0,0,,Біріншіден, бірінші жылдың жазғы демалысы ойынның бастапқы сценарийі болып табылады.
Dialogue: 0,0:10:57.07,0:10:59.99,Default,,0,0,0,,Анна студенттік жатақханада қала ма?
Dialogue: 0,0:11:00.07,0:11:03.37,Default,,0,0,0,,Менің ата-анамның үйіне қайтудан басқа амалым жоқ.
Dialogue: 0,0:11:03.45,0:11:07.87,Default,,0,0,0,,Ал стратегия сәйкесінше өзгереді.
Dialogue: 0,0:11:07.95,0:11:10.33,Default,,0,0,0,,Дегенмен, бұл дүниеде
Dialogue: 0,0:11:10.41,0:11:12.33,Default,,0,0,0,,Ол Оверн отбасында тұруға келетінін айтты.
Dialogue: 0,0:11:12.42,0:11:14.96,Default,,0,0,0,,Мүлде басқа бағытқа тармақталу
Dialogue: 0,0:11:15.46,0:11:19.67,Default,,0,0,0,,Әңгіме Аннаға келетін болсақ, оның басты кейіпкердің ерекшеліктері бар.
Dialogue: 0,0:11:19.76,0:11:22.43,Default,,0,0,0,,Бірнеше күннің ішінде әйелдердің әдептілігін және негізгі білімдерін үйреніңіз.
Dialogue: 0,0:11:22.51,0:11:24.64,Default,,0,0,0,,Мен оны меңгердім...
Dialogue: 0,0:11:24.72,0:11:26.39,Default,,0,0,0,,Енді
Dialogue: 0,0:11:26.47,0:11:29.93,Default,,0,0,0,,Мен үйдегі қызметшілердің жұмысын үйренгім келеді.
Dialogue: 0,0:11:30.02,0:11:32.35,Default,,0,0,0,,Осыны айта бастадыңыз.
Dialogue: 0,0:11:32.44,0:11:33.40,Default,,0,0,0,,Иә
Dialogue: 0,0:11:33.48,0:11:34.98,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:35.48,0:11:38.57,Default,,0,0,0,,Жарайды, болашақта мен қызметші жалдайтын жағдайға жеткенде.
Dialogue: 0,0:11:38.65,0:11:41.74,Default,,0,0,0,,Жұмысты білу маңызды.
Dialogue: 0,0:11:41.82,0:11:45.37,Default,,0,0,0,,Бұл Аннаның да бұл туралы білгенін білдіре ме?
Dialogue: 0,0:11:45.91,0:11:48.54,Default,,0,0,0,,Мұны орындамас бұрын мұқият оқып шығыңыз
Dialogue: 0,0:11:48.62,0:11:50.91,Default,,0,0,0,,Болашақта пайдалы болатынына сенімдімін.
Dialogue: 0,0:11:51.00,0:11:53.54,Default,,0,0,0,,Иә, мен бар күшімді саламын!
Dialogue: 0,0:11:53.62,0:11:57.29,Default,,0,0,0,,Мен болашақта Грейске қызмет еткенімде!
Dialogue: 0,0:11:59.05,0:12:02.93,Default,,0,0,0,,Жас ханымның шаштарын тек Матильда-сенпай ғана жасай алады.
Dialogue: 0,0:12:03.51,0:12:06.18,Default,,0,0,0,,Қазір төсек-орынды жөндейміз.
Dialogue: 0,0:12:06.26,0:12:08.06,Default,,0,0,0,,Иә, Джозетта-сенпай.
Dialogue: 0,0:12:08.81,0:12:11.06,Default,,0,0,0,,Мен «ағаның» тоқтағанын қалаймын.
Dialogue: 0,0:12:11.14,0:12:12.81,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:16.40,0:12:18.94,Default,,0,0,0,,-Ммм... -Джорджетте...чан?
Dialogue: 0,0:12:19.02,0:12:21.24,Default,,0,0,0,,Біз ойнап жатқан жоқпыз.
Dialogue: 0,0:12:21.32,0:12:22.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:22.40,0:12:25.24,Default,,0,0,0,,Бұл бас қызметшінің ілімі.
Dialogue: 0,0:12:25.32,0:12:29.08,Default,,0,0,0,,Қызметші әрқашан қожайынның көзқарасымен ойлайды.
Dialogue: 0,0:12:29.16,0:12:32.20,Default,,0,0,0,,Осылайша мен өз қожайыныммен бірдей позицияға түсуге тырысуым керек.
Dialogue: 0,0:12:32.29,0:12:37.71,Default,,0,0,0,,Төсек немесе төбенің серпімділігінде қандай да бір ауытқушылық бар-жоғын тексеру мүмкін емес.
Dialogue: 0,0:12:37.79,0:12:41.34,Default,,0,0,0,,Уау... Түсіндім, көп нәрсені үйрендім.
Dialogue: 0,0:12:41.42,0:12:43.97,Default,,0,0,0,,Сондықтан Анна да тырысады.
Dialogue: 0,0:12:44.05,0:12:45.09,Default,,0,0,0,,Иә
Dialogue: 0,0:12:47.43,0:12:50.35,Default,,0,0,0,,Уау~ Өте жұмсақ~
Dialogue: 0,0:12:50.43,0:12:53.18,Default,,0,0,0,,Оның иісі өте жақсы
Dialogue: 0,0:12:53.27,0:12:55.35,Default,,0,0,0,,Бұл Грейс-саманың әтірі ме?
Dialogue: 0,0:12:55.44,0:12:59.77,Default,,0,0,0,,Грейс-самаға оранғандай...
Dialogue: 0,0:12:59.86,0:13:02.28,Default,,0,0,0,,-Уфуфуфу... -Анна?
Dialogue: 0,0:13:02.36,0:13:03.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:03.53,0:13:05.07,Default,,0,0,0,,Оны құтқарудың жолы бар ма?
Dialogue: 0,0:13:05.74,0:13:07.16,Default,,0,0,0,,Аномалия жоқ
Dialogue: 0,0:13:07.24,0:13:09.62,Default,,0,0,0,,Содан кейін мен парақтарды ауыстырамын.
Dialogue: 0,0:13:09.70,0:13:10.99,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:13:11.08,0:13:13.95,Default,,0,0,0,,Амансың ба? бұл маршрут
Dialogue: 0,0:13:14.71,0:13:16.96,Default,,0,0,0,,Сол Матильда-сенпай
Dialogue: 0,0:13:17.04,0:13:19.25,Default,,0,0,0,,«аға» болуды тоқтатыңыз
Dialogue: 0,0:13:19.34,0:13:21.50,Default,,0,0,0,,Джозеттадан...
Dialogue: 0,0:13:21.59,0:13:22.71,Default,,0,0,0,,Мен мұны естідім
Dialogue: 0,0:13:22.80,0:13:24.97,Default,,0,0,0,,Грейстің шаштарын жасау
Dialogue: 0,0:13:25.05,0:13:27.64,Default,,0,0,0,,Мұны тек Матильда-сенпай ғана жасай алатын сияқты.
Dialogue: 0,0:13:27.72,0:13:28.64,Default,,0,0,0,,...
Dialogue: 0,0:13:28.72,0:13:32.47,Default,,0,0,0,,Осындай әдемі шаш үлгісін қалай аласыз?
Dialogue: 0,0:13:32.56,0:13:36.48,Default,,0,0,0,,Әлгі жігіт Оланың «туа біткен сиқырын» пайдаланып жүр.
Dialogue: 0,0:13:36.56,0:13:39.56,Default,,0,0,0,,Мен оның туа біткен сиқыр екеніне сенімдімін.
Dialogue: 0,0:13:39.65,0:13:42.94,Default,,0,0,0,,Жыртқыштар сиқырлы туады, солай ма?
Dialogue: 0,0:13:43.03,0:13:44.24,Default,,0,0,0,,...
Dialogue: 0,0:13:44.32,0:13:47.40,Default,,0,0,0,,Мен оны бала кезімнен қолдана алмаймын.
Dialogue: 0,0:13:47.49,0:13:52.74,Default,,0,0,0,,Сіз оны адамдарға үйрете алмайсыз және басқа ешқандай сиқырды пайдалана алмайсыз.
Dialogue: 0,0:13:52.83,0:13:57.12,Default,,0,0,0,,Әр адам онымен туа бермейді.
Dialogue: 0,0:13:57.21,0:13:59.17,Default,,0,0,0,,Оланың туа біткен сиқыры
Dialogue: 0,0:13:59.25,0:14:02.13,Default,,0,0,0,,Қолында ұстаған затты ыстық етеді.
Dialogue: 0,0:14:03.92,0:14:06.38,Default,,0,0,0,,Су қайнағаннан да қызады.
Dialogue: 0,0:14:06.47,0:14:09.18,Default,,0,0,0,,Өрт шығатындай қызбайды
Dialogue: 0,0:14:09.26,0:14:11.64,Default,,0,0,0,,Бұл от сиқырының бір түрі ме?
Dialogue: 0,0:14:11.72,0:14:15.39,Default,,0,0,0,,Бұл сондай жарты жүректі сиқыр болса да.
Dialogue: 0,0:14:15.47,0:14:17.35,Default,,0,0,0,,Ола ойлады
Dialogue: 0,0:14:17.43,0:14:21.61,Default,,0,0,0,,Мен бұл сиқырдың біреуге көмектесетініне сенімдімін.
Dialogue: 0,0:14:22.23,0:14:26.15,Default,,0,0,0,,Содан менің ойыма темір цехы туралы ой келді.
Dialogue: 0,0:14:26.24,0:14:29.95,Default,,0,0,0,,Киім мен орамалға сиқырлы қыздырылған үтікті жағыңыз.
Dialogue: 0,0:14:30.03,0:14:32.16,Default,,0,0,0,,Әжімдерді әдемі тегістеңіз
Dialogue: 0,0:14:32.91,0:14:34.24,Default,,0,0,0,,Бірнеше стильді әйелдер жиі біздің тұтынушыларымызға айналды.
Dialogue: 0,0:14:34.24,0:14:37.04,Default,,0,0,0,,Бірқатар сәнді әйелдер жиі біздің тұтынушыларымызға айналды.
Dialogue: 0,0:14:34.24,0:14:37.04,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:14:37.04,0:14:37.66,Default,,0,0,0,,Бірнеше стильді әйелдер жиі біздің тұтынушыларымызға айналды.
Dialogue: 0,0:14:37.75,0:14:39.54,Default,,0,0,0,,Кете бар! Мен сені тыңдамаймын!
Dialogue: 0,0:14:42.38,0:14:44.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:44.13,0:14:48.22,Default,,0,0,0,,Бір күні мына жердегі әйел мені көтеріп алды.
Dialogue: 0,0:14:48.88,0:14:50.30,Default,,0,0,0,,Осылайша Ора
Dialogue: 0,0:14:50.38,0:14:52.01,Default,,0,0,0,,Үтіктеуші ретінде
Dialogue: 0,0:14:52.09,0:14:55.31,Default,,0,0,0,,Мен Оверн отбасында жұмыс істедім.
Dialogue: 0,0:14:55.39,0:14:56.93,Default,,0,0,0,,Төлем алыңыз
Dialogue: 0,0:14:57.02,0:15:00.81,Default,,0,0,0,,Мен інім мен сіңілімді қарындары тойдырдым.
Dialogue: 0,0:15:00.89,0:15:03.31,Default,,0,0,0,,Мен әйеліме ризамын.
Dialogue: 0,0:15:04.19,0:15:05.32,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:15:05.40,0:15:07.82,Default,,0,0,0,,Леди Грейс кішкентай кезінде.
Dialogue: 0,0:15:07.90,0:15:09.95,Default,,0,0,0,,Йогу, Ола мен басқалардың жұмыс орнына кел.
Dialogue: 0,0:15:10.03,0:15:13.57,Default,,0,0,0,,Сіз үтіктеу процесін тамашалағаныңызға сенімдімін.
Dialogue: 0,0:15:14.20,0:15:18.33,Default,,0,0,0,,Маған өте қызық нәрсе бар.
Dialogue: 0,0:15:20.41,0:15:23.33,Default,,0,0,0,,Мм... анау ханым
Dialogue: 0,0:15:23.42,0:15:26.21,Default,,0,0,0,,Бәлкім, бұл әдепсіз сөз шығар, бірақ
Dialogue: 0,0:15:26.30,0:15:30.72,Default,,0,0,0,,Маған жас ханымның шашын жөндеуге рұқсат бере аласыз ба?
Dialogue: 0,0:15:30.80,0:15:31.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:32.43,0:15:36.93,Default,,0,0,0,,Әй, мен көптен бері әпкелерімнің шаштарын жасап жүрмін.
Dialogue: 0,0:15:37.01,0:15:40.48,Default,,0,0,0,,Шашыңызды жылдам қыздыру немесе салқындату үшін Ораның сиқырын пайдаланыңыз.
Dialogue: 0,0:15:40.56,0:15:42.48,Default,,0,0,0,,Оны орап, созуға болады.
Dialogue: 0,0:15:43.48,0:15:45.73,Default,,0,0,0,,Бұл өте керемет!
Dialogue: 0,0:15:45.81,0:15:47.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:48.98,0:15:53.36,Default,,0,0,0,,Содан бері Ола әрқашан жас ханымның шашын жөндейтін.
Dialogue: 0,0:15:53.45,0:15:55.82,Default,,0,0,0,,Менің жалақым да өсті.
Dialogue: 0,0:15:55.91,0:16:01.83,Default,,0,0,0,,О, мен өзімді осы сиқырмен дүниеге келгенім үшін бақытты сезінемін.
Dialogue: 0,0:16:01.91,0:16:04.71,Default,,0,0,0,,Бұл жай ғана сиқыр емес
Dialogue: 0,0:16:04.79,0:16:07.46,Default,,0,0,0,,Себебі Матильданың шеберлігі жақсы.
Dialogue: 0,0:16:07.54,0:16:09.80,Default,,0,0,0,,Енді ойлап қарасам, Матильда-сенпай...
Dialogue: 0,0:16:09.88,0:16:13.76,Default,,0,0,0,,Мен жас келіншектің ашуланғанын көрген емеспін.
Dialogue: 0,0:16:13.84,0:16:16.22,Default,,0,0,0,,Мен жас ханымдардан қорқатын кезімнен бері
Dialogue: 0,0:16:16.30,0:16:20.77,Default,,0,0,0,,Жас ханым, әрине, қатал адам.
Dialogue: 0,0:16:23.52,0:16:26.77,Default,,0,0,0,,Мен себепсіз ашуланатын адам емеспін.
Dialogue: 0,0:16:26.86,0:16:28.23,Default,,0,0,0,,Көп уақыт өтті
Dialogue: 0,0:16:28.32,0:16:29.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:29.86,0:16:32.44,Default,,0,0,0,,А, шай тыныштандырады.
Dialogue: 0,0:16:32.53,0:16:35.61,Default,,0,0,0,,Мен қазір қайнатамын, сәл күте тұрыңыз.
Dialogue: 0,0:16:38.53,0:16:40.49,Default,,0,0,0,,- Nyahahah - (Анна Джозет) Ыңғайлы
Dialogue: 0,0:16:41.04,0:16:42.79,Default,,0,0,0,,Ал, Анна.
Dialogue: 0,0:16:42.87,0:16:45.21,Default,,0,0,0,,Осы жерден мен, Олив, бас қызметші,
Dialogue: 0,0:16:45.29,0:16:46.71,Default,,0,0,0,,Түсіндірейін.
Dialogue: 0,0:16:46.79,0:16:48.96,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:16:49.04,0:16:51.46,Default,,0,0,0,,Ең алдымен, біздің қожайынымыз—
Dialogue: 0,0:16:51.55,0:16:53.76,Default,,0,0,0,,Құрметті Оверн отбасының мүшелері.
Dialogue: 0,0:16:53.84,0:16:58.35,Default,,0,0,0,,Грейстің үлкен ағасы Адриан шетелде оқиды.
Dialogue: 0,0:16:58.43,0:17:02.73,Default,,0,0,0,,Сіздің анаңыз Жаклин виллада емделіп жатыр.
Dialogue: 0,0:17:02.81,0:17:04.14,Default,,0,0,0,,Енді
Dialogue: 0,0:17:04.23,0:17:05.89,Default,,0,0,0,,Үйде кім бар...
Dialogue: 0,0:17:05.98,0:17:07.56,Default,,0,0,0,,Иә, Леопольдпен.
Dialogue: 0,0:17:07.65,0:17:09.86,Default,,0,0,0,,Тек екеуің, Грейс.
Dialogue: 0,0:17:09.94,0:17:13.15,Default,,0,0,0,,Неше қызметші бар деп ойлайсың?
Dialogue: 0,0:17:13.24,0:17:14.28,Default,,0,0,0,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:17:14.36,0:17:15.99,Default,,0,0,0,,Бірақ бұл үлкен сарай.
Dialogue: 0,0:17:16.07,0:17:17.74,Default,,0,0,0,,Ондаған адамдар?
Dialogue: 0,0:17:17.82,0:17:20.28,Default,,0,0,0,,Қазіргі уақытта шамамен 300 адам
Dialogue: 0,0:17:20.37,0:17:21.74,Default,,0,0,0,,300 адам!?
Dialogue: 0,0:17:21.83,0:17:24.37,Default,,0,0,0,,Оверн сарайы – резиденция және сарай.
Dialogue: 0,0:17:24.46,0:17:27.00,Default,,0,0,0,,Кең аумақтан тұрады
Dialogue: 0,0:17:27.08,0:17:28.29,Default,,0,0,0,,Демек, қызметші де
Dialogue: 0,0:17:28.38,0:17:30.29,Default,,0,0,0,,Үйдің ішінде және сыртында жұмыс істеу —
Dialogue: 0,0:17:30.38,0:17:32.76,Default,,0,0,0,,Екі топқа бөлінеді
Dialogue: 0,0:17:32.84,0:17:35.01,Default,,0,0,0,,Бірінші, жабық топ
Dialogue: 0,0:17:35.09,0:17:38.39,Default,,0,0,0,,Тазалық пен кір жууға жауапты үй шаруашылығы тобы
Dialogue: 0,0:17:38.47,0:17:42.31,Default,,0,0,0,,Мерекелік кештер герцогтың резиденциясында да өтеді, мемлекеттік қонақтарды шақырады.
Dialogue: 0,0:17:42.39,0:17:45.77,Default,,0,0,0,,Үйіңізді әрқашан әдемі ұстауыңыз керек.
Dialogue: 0,0:17:45.85,0:17:47.69,Default,,0,0,0,,Келесі - аспаздық топ
Dialogue: 0,0:17:47.77,0:17:49.44,Default,,0,0,0,,Әрине күйеуімнің тамағы
Dialogue: 0,0:17:49.52,0:17:52.15,Default,,0,0,0,,Мен де күн сайын қызметшілерге тамақ жасаймын.
Dialogue: 0,0:17:52.23,0:17:54.28,Default,,0,0,0,,Бұл өте маңызды бөлім.
Dialogue: 0,0:17:54.36,0:17:58.24,Default,,0,0,0,,Үйдің істері мен есеп-қисаптарын басқаратын күзетшілер тобы.
Dialogue: 0,0:17:58.32,0:18:01.20,Default,,0,0,0,,Күйеулер мен жас ханымдар үшін киім мен сұлулыққа жауапты.
Dialogue: 0,0:18:01.28,0:18:03.08,Default,,0,0,0,,Кәсіби мамандар
Dialogue: 0,0:18:03.16,0:18:06.79,Default,,0,0,0,,Сырттағы топтың жұлдызы – бақшаны басқаратын бау-бақша тобы.
Dialogue: 0,0:18:06.87,0:18:10.21,Default,,0,0,0,,Көп жағдайда отбасылардан бірге тұру және жұмыс істеу сұралады.
Dialogue: 0,0:18:10.29,0:18:13.75,Default,,0,0,0,,Айтпақшы, біз қолөнершілер де отбасымызбен бірге тұрамыз.
Dialogue: 0,0:18:13.84,0:18:18.22,Default,,0,0,0,,Герцогтың резиденциясындағы жылқылар мен ірі қараларды күтетін асыл тұқымды бригада
Dialogue: 0,0:18:18.30,0:18:21.26,Default,,0,0,0,,Жүзім өсіріп, шарап жасайтын сыра қайнату бригадасы
Dialogue: 0,0:18:21.35,0:18:24.22,Default,,0,0,0,,...Мен оларды бүгін күні бойы бастан өткердім.
Dialogue: 0,0:18:24.31,0:18:25.43,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:18:25.52,0:18:27.77,Default,,0,0,0,,Иә, бұл өте қызық болды.
Dialogue: 0,0:18:28.39,0:18:31.02,Default,,0,0,0,,Бірақ герцог отбасы әлі де керемет.
Dialogue: 0,0:18:31.10,0:18:35.53,Default,,0,0,0,,Үй емес, өзін өзі қала сияқты сезінеді.
Dialogue: 0,0:18:35.61,0:18:38.53,Default,,0,0,0,,Уау, бұл шынымен де керемет.
Dialogue: 0,0:18:38.61,0:18:40.24,Default,,0,0,0,,Бірақ кем дегенде
Dialogue: 0,0:18:40.32,0:18:41.78,Default,,0,0,0,,«Махаббат арасы» сценарийінде
Dialogue: 0,0:18:41.87,0:18:43.95,Default,,0,0,0,,Дукалдық отбасы үшін мұндай егжей-тегжейлі параметрлер
Dialogue: 0,0:18:44.03,0:18:45.33,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:18:45.41,0:18:50.17,Default,,0,0,0,,Біріншіден, зұлым адамның үйіне жағдай жасаудың мағынасы жоқ.
Dialogue: 0,0:18:50.87,0:18:54.09,Default,,0,0,0,,Әйтеуір, мен аздап есінен танып қалдым.
Dialogue: 0,0:18:54.17,0:18:56.80,Default,,0,0,0,,Бұл дүниенің өзі ойын емес.
Dialogue: 0,0:18:56.88,0:18:58.55,Default,,0,0,0,,Ойын сияқты
Dialogue: 0,0:18:58.63,0:19:01.80,Default,,0,0,0,,Мен бұл шынымен бір жерде бар басқа әлем ме деп ойлаймын.
Dialogue: 0,0:19:01.89,0:19:04.56,Default,,0,0,0,,Олай болса... Иә?
Dialogue: 0,0:19:04.64,0:19:06.56,Default,,0,0,0,,Баршаңызға қайырлы күн
Dialogue: 0,0:19:11.23,0:19:13.81,Default,,0,0,0,,Герцогтың үйін аралау қалай өтті?
Dialogue: 0,0:19:13.90,0:19:15.32,Default,,0,0,0,,Құрметті Грейс!
Dialogue: 0,0:19:15.40,0:19:17.07,Default,,0,0,0,,Сонымен... бұл неге ұқсайды?
Dialogue: 0,0:19:17.15,0:19:20.99,Default,,0,0,0,,Сізді көргенде менің де оны киіп көргім келді.
Dialogue: 0,0:19:21.07,0:19:22.07,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:19:22.16,0:19:25.83,Default,,0,0,0,,Ал, бұл... саған жақсы жарасады.
Dialogue: 0,0:19:27.37,0:19:29.25,Default,,0,0,0,,«Бұл сізге сәйкес келеді»
Dialogue: 0,0:19:29.33,0:19:32.21,Default,,0,0,0,,Бұл өте қалыпты әсер сияқты естіледі, бірақ
Dialogue: 0,0:19:32.29,0:19:35.29,Default,,0,0,0,,Грейс Аннаның қызметшісі болатын жол да бар сияқты.
Dialogue: 0,0:19:35.38,0:19:36.63,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:19:36.71,0:19:39.59,Default,,0,0,0,,Сіз жасырын хабарды байқаған сияқтысыз.
Dialogue: 0,0:19:39.67,0:19:43.47,Default,,0,0,0,,Кез келген киіммен әдемі көрінетін асқан талғампаздық
Dialogue: 0,0:19:43.55,0:19:47.51,Default,,0,0,0,,Грейс күткендей, сен маған шынымен жақсы көрінесің!
Dialogue: 0,0:19:48.43,0:19:50.23,Default,,0,0,0,,Олай болса, Анна
Dialogue: 0,0:19:50.31,0:19:54.10,Default,,0,0,0,,Менің герцог отбасымның қызметшілерін көргенде қандай сезімде болдың?
Dialogue: 0,0:19:54.19,0:19:55.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:55.44,0:20:00.36,Default,,0,0,0,,Мысалы, бір отбасында 300 қызметші болуы мүмкін.
Dialogue: 0,0:20:00.44,0:20:03.61,Default,,0,0,0,,Тым сәнді ме деп ойлаймын...
Dialogue: 0,0:20:04.36,0:20:05.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:07.78,0:20:08.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:09.79,0:20:11.62,Default,,0,0,0,,Шынында да I
Dialogue: 0,0:20:12.37,0:20:15.88,Default,,0,0,0,,Алғаш естігенде қатты таң қалдым.
Dialogue: 0,0:20:15.96,0:20:17.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:18.80,0:20:22.01,Default,,0,0,0,,Джозет Сіз қызметші шәкіртсіз, солай ма?
Dialogue: 0,0:20:22.09,0:20:23.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:23.13,0:20:27.64,Default,,0,0,0,,Осында келген соң қызметші болып жұмыс істеуді үйрендің ғой, солай ма?
Dialogue: 0,0:20:27.72,0:20:28.93,Default,,0,0,0,,бұл... иә
Dialogue: 0,0:20:29.01,0:20:34.90,Default,,0,0,0,,Олар жұмыс істейді, сонымен қатар оқуды, жазуды және ақша санауды үйренеді.
Dialogue: 0,0:20:34.98,0:20:37.61,Default,,0,0,0,,Мен түсінемін, яғни.
Dialogue: 0,0:20:38.48,0:20:42.49,Default,,0,0,0,,Бұл зәулім үй жалақыға жұмыс істейтін жер.
Dialogue: 0,0:20:42.57,0:20:44.32,Default,,0,0,0,,Жас қызметшілер үшін
Dialogue: 0,0:20:44.40,0:20:47.99,Default,,0,0,0,,Бұл да өмір сүруді үйрену мектебі.
Dialogue: 0,0:20:48.49,0:20:52.83,Default,,0,0,0,,Және сарайлар мен бақшаларда өтетін кештер сияқты іс-шаралар
Dialogue: 0,0:20:52.91,0:20:56.04,Default,,0,0,0,,Қарапайым адамдарға бұл сән-салтанат болып көрінсе де,
Dialogue: 0,0:20:56.12,0:20:59.88,Default,,0,0,0,,Герцог үшін «әлеуметтену» - бұл жұмыстың өзі.
Dialogue: 0,0:21:00.46,0:21:04.13,Default,,0,0,0,,Герцог әлеуметтену үшін көптеген адамдарды жалдады.
Dialogue: 0,0:21:04.22,0:21:08.26,Default,,0,0,0,,Жұмыспен қамтылғандар жұмысқа орналасып, отбасын асырайды
Dialogue: 0,0:21:08.35,0:21:11.68,Default,,0,0,0,,Кішкентай елге осылай айналады.
Dialogue: 0,0:21:11.77,0:21:13.18,Default,,0,0,0,,Мен сезіндім
Dialogue: 0,0:21:15.19,0:21:16.06,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:21:19.27,0:21:20.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:21.15,0:21:24.32,Default,,0,0,0,,Керемет жауап, Анна.
Dialogue: 0,0:21:24.95,0:21:29.41,Default,,0,0,0,,Жас кезінде заттарды осындай кең көзқараспен көре білу
Dialogue: 0,0:21:29.91,0:21:33.37,Default,,0,0,0,,Мен сізді осы сарайға шақырғанымды дұрыс шештім.
Dialogue: 0,0:21:33.45,0:21:34.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:34.91,0:21:37.75,Default,,0,0,0,,Ақырында сіз біздің тарапқа келесіз -
Dialogue: 0,0:21:37.83,0:21:41.29,Default,,0,0,0,,Көп адамды қуантатын адамға айналасыз.
Dialogue: 0,0:21:41.80,0:21:44.21,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:21:44.30,0:21:46.63,Default,,0,0,0,,Мен барынша тырыстым
Dialogue: 0,0:21:46.72,0:21:47.93,Default,,0,0,0,,Сіз сонда жұмыс істесеңіз де
Dialogue: 0,0:21:48.01,0:21:50.22,Default,,0,0,0,,Ұялып қалмау дағдысын меңгеру
Dialogue: 0,0:21:50.30,0:21:53.10,Default,,0,0,0,,Мен көп адамдарға көмектескім келеді!
Dialogue: 0,0:21:53.18,0:21:55.35,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:21:57.31,0:21:58.81,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:21:59.31,0:22:02.98,Default,,0,0,0,,Батып бара жатқан күннің өзі сізге тамыр жаяды.
Dialogue: 0,0:22:03.07,0:22:04.99,Default,,0,0,0,,Иә, Грейс.
Dialogue: 0,0:22:05.57,0:22:07.53,Default,,0,0,0,,Шоу дәуіріндегі өндіріс
Dialogue: 0,0:22:07.61,0:22:10.99,Default,,0,0,0,,Бұл отоме ойыны емес қой!?
Dialogue: 0,0:22:11.62,0:22:16.62,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.99,0:23:41.00,Default,,0,0,0,,～♪
Dialogue: 0,0:23:46.09,0:23:47.55,Default,,0,0,0,,Сенің әкең кім?
Dialogue: 0,0:23:47.63,0:23:49.80,Default,,0,0,0,,Бұл күндері 52 жасқа толу тым ескі емес пе?
Dialogue: 0,0:23:49.88,0:23:50.76,Default,,0,0,0,,Бұтадан таяқшаға дейін
Dialogue: 0,0:23:50.84,0:23:54.43,Default,,0,0,0,,Қазіргі уақытта штрих-кодтарды білетін 50-ден асқан адамдарды табу қиын.
Dialogue: 0,0:23:54.51,0:23:57.18,Default,,0,0,0,,Иә, сенің әкеңнің бұл бас болуының себебі бар.
Dialogue: 0,0:23:57.26,0:23:59.56,Default,,0,0,0,,Өйткені, оның себебі неде?
Dialogue: 0,0:23:59.64,0:24:02.39,Default,,0,0,0,,Мен қазір сөйлесе алмаймын. Уақыты келгенде айтамын.
Dialogue: 0,0:24:02.48,0:24:05.94,Default,,0,0,0,,Отакудың сүйікті болжау желісі осында!
Dialogue: 0,0:24:07.44,0:24:13.44,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
