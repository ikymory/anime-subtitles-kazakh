Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:04.92,Default,,0,0,0,,(Айналмалы сым дыбысы)
Dialogue: 0,0:00:08.00,0:00:09.21,Default,,0,0,0,,(Келу қоңырауы)
Dialogue: 0,0:00:10.26,0:00:13.22,Default,,0,0,0,,Не? Не... мұнда?
Dialogue: 0,0:00:13.72,0:00:16.93,Default,,0,0,0,,Ах! Мүмкін елес үй шығар?
Dialogue: 0,0:00:17.01,0:00:19.72,Default,,0,0,0,,Аха~ Елес
Dialogue: 0,0:00:19.81,0:00:22.31,Default,,0,0,0,,Елес елес…
Dialogue: 0,0:00:22.39,0:00:24.69,Default,,0,0,0,,Елес қайда?
Dialogue: 0,0:00:24.77,0:00:27.44,Default,,0,0,0,,Елес қайда?
Dialogue: 0,0:00:29.98,0:00:31.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:33.32,0:00:34.53,Default,,0,0,0,,Эй
Dialogue: 0,0:00:35.03,0:00:38.20,Default,,0,0,0,,-Мен? -Тағы кім бар?
Dialogue: 0,0:00:39.16,0:00:40.45,Default,,0,0,0,,Осы жерге отырыңыз.
Dialogue: 0,0:00:41.49,0:00:43.04,Default,,0,0,0,,Өзін нашар сезіну
Dialogue: 0,0:00:44.04,0:00:49.04,Default,,0,0,0,,♪~
Dialogue: 0,0:01:58.91,0:02:03.91,Default,,0,0,0,,~♪
Dialogue: 0,0:02:03.99,0:02:06.91,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:08.12,0:02:09.62,Default,,0,0,0,,Көкеші?
Dialogue: 0,0:02:09.71,0:02:11.00,Default,,0,0,0,,Савана
Dialogue: 0,0:02:13.09,0:02:14.75,Default,,0,0,0,,Сен, мені жалғыз қалдыр
Dialogue: 0,0:02:14.84,0:02:17.92,Default,,0,0,0,,Мазасыз түсіндіруді өткізіп жіберемін, жарай ма?
Dialogue: 0,0:02:18.01,0:02:19.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:19.51,0:02:22.68,Default,,0,0,0,,Бұдан былай мен сені ол жігітпен ойын ойнауға тапсырма беремін.
Dialogue: 0,0:02:22.76,0:02:26.85,Default,,0,0,0,,Ойын? Мен бұл нені білдіретінін түсінбеймін ...
Dialogue: 0,0:02:26.93,0:02:27.93,Default,,0,0,0,,Эй
Dialogue: 0,0:02:28.48,0:02:31.48,Default,,0,0,0,,Иә? Өтірік...
Dialogue: 0,0:02:32.27,0:02:35.48,Default,,0,0,0,,Мм...болмаса басқаша болар еді...
Dialogue: 0,0:02:35.57,0:02:38.70,Default,,0,0,0,,C.H.A-дан Харада-кун емес пе?
Dialogue: 0,0:02:38.78,0:02:40.20,Default,,0,0,0,,«Кіруді бақылау жүйесіндегі автоматты есіктер—»
Dialogue: 0,0:02:40.28,0:02:43.70,Default,,0,0,0,,Мама! Джи! Ка~!
Dialogue: 0,0:02:45.49,0:02:49.50,Default,,0,0,0,,Мен үлкен жанкүйермін! Е, бұл не? Бұл қауіпті!
Dialogue: 0,0:02:49.58,0:02:50.83,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:02:50.92,0:02:53.21,Default,,0,0,0,,Аку Аку... Қолымды қысыңыз!
Dialogue: 0,0:02:53.29,0:02:54.59,Default,,0,0,0,,Бұл Майу Арита!
Dialogue: 0,0:02:54.67,0:02:55.88,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:02:55.96,0:02:57.84,Default,,0,0,0,,Кяаааааааааааааааааааааа
Dialogue: 0,0:02:58.84,0:03:00.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:01.01,0:03:04.30,Default,,0,0,0,,Маған кездесуге рұқсат бергеніңіз үшін рахмет! Шынымен!
Dialogue: 0,0:03:04.39,0:03:06.43,Default,,0,0,0,,Сонда сен кімсің?
Dialogue: 0,0:03:06.51,0:03:07.89,Default,,0,0,0,,Бұл Джинти.
Dialogue: 0,0:03:07.97,0:03:09.98,Default,,0,0,0,,Хм, бұл біртүрлі есім.
Dialogue: 0,0:03:10.06,0:03:12.44,Default,,0,0,0,,Сіз C.H.A менеджерісіз бе?
Dialogue: 0,0:03:12.52,0:03:14.44,Default,,0,0,0,,Эй, ол осында...
Dialogue: 0,0:03:14.52,0:03:16.94,Default,,0,0,0,,Жарайды, осыны басыңыз.
Dialogue: 0,0:03:17.03,0:03:19.11,Default,,0,0,0,,Ойынды шешу үшін басыңыз
Dialogue: 0,0:03:20.03,0:03:23.11,Default,,0,0,0,,Харада-кунмен ойын? Қанекей мынаны істейік!
Dialogue: 0,0:03:23.20,0:03:24.70,Default,,0,0,0,,Мен оны баса аламын ба?
Dialogue: 0,0:03:24.78,0:03:27.45,Default,,0,0,0,,Ойын ойнамайынша, мені бұл жерден жібермейді дейді.
Dialogue: 0,0:03:27.54,0:03:28.37,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:28.45,0:03:30.21,Default,,0,0,0,,Иә! сәуле!
Dialogue: 0,0:03:31.50,0:03:35.79,Default,,0,0,0,,Уа, уау, ау!
Dialogue: 0,0:03:36.92,0:03:38.55,Default,,0,0,0,,(шешім дыбысы)
Dialogue: 0,0:03:40.55,0:03:42.18,Default,,0,0,0,,Твит... Твит...
Dialogue: 0,0:03:42.26,0:03:44.47,Default,,0,0,0,,Хмм, не?
Dialogue: 0,0:03:44.97,0:03:46.72,Default,,0,0,0,,Екеуің менің артымнан жүріңдер.
Dialogue: 0,0:03:49.56,0:03:51.73,Default,,0,0,0,,Бұл мысық~
Dialogue: 0,0:03:51.81,0:03:54.35,Default,,0,0,0,,- (Харада) Кеттік - Иә!
Dialogue: 0,0:03:55.94,0:03:58.44,Default,,0,0,0,,Ойланып қарашы, бұл қайда?
Dialogue: 0,0:03:58.52,0:03:59.90,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:04:04.82,0:04:07.03,Default,,0,0,0,,Бүгін демалыстасыз ба?
Dialogue: 0,0:04:07.12,0:04:10.25,Default,,0,0,0,,Иә, бірақ жақсы есімде жоқ.
Dialogue: 0,0:04:10.33,0:04:13.75,Default,,0,0,0,,Ойланып қарасам, мұнда келген кезіңіз есіңізде ме?
Dialogue: 0,0:04:13.83,0:04:15.17,Default,,0,0,0,,№.
Dialogue: 0,0:04:15.25,0:04:16.75,Default,,0,0,0,,Жүзі күлімдеп тұр
Dialogue: 0,0:04:16.83,0:04:20.17,Default,,0,0,0,,Өйткені мен сізбен тікелей эфирде сөйлесе алатыныма өте қуаныштымын.
Dialogue: 0,0:04:20.25,0:04:21.63,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:21.71,0:04:23.38,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:04:23.47,0:04:25.89,Default,,0,0,0,,Хирои
Dialogue: 0,0:04:37.86,0:04:39.86,Default,,0,0,0,,Мен мұны білмеймін.
Dialogue: 0,0:04:39.94,0:04:44.20,Default,,0,0,0,,Ережені түсіндіріңіз: Шұлықтарыңызды шешіп, шетіне тұрыңыз.
Dialogue: 0,0:04:44.28,0:04:45.66,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:48.70,0:04:51.16,Default,,0,0,0,,Алдымен спиннер нұсқау береді.
Dialogue: 0,0:04:51.24,0:04:52.75,Default,,0,0,0,,Спиннер?
Dialogue: 0,0:04:52.83,0:04:55.87,Default,,0,0,0,,Міне, бұл рулетка.
Dialogue: 0,0:04:59.71,0:05:01.96,Default,,0,0,0,,Мысық оны айналдыра ма?
Dialogue: 0,0:05:02.05,0:05:05.05,Default,,0,0,0,,Бұл менікі. Мені атыммен шақыр.
Dialogue: 0,0:05:05.13,0:05:07.64,Default,,0,0,0,,- Күрсініп... - Тақырыпқа қайта оралу.
Dialogue: 0,0:05:08.22,0:05:10.22,Default,,0,0,0,,Спиннер нұсқауларын орындаңыз
Dialogue: 0,0:05:10.31,0:05:13.39,Default,,0,0,0,,Көрсетілген бөлікті көрсетілген шеңберге қойыңыз
Dialogue: 0,0:05:14.02,0:05:18.35,Default,,0,0,0,,Егер төсеніш құласа немесе белгіленген бөліктен басқа кез келген бөлік төсенішке тиіп кетсе, сіз ұтыласыз.
Dialogue: 0,0:05:19.48,0:05:22.40,Default,,0,0,0,,Мұның бәрі ережелер үшін. Түсінді ме?
Dialogue: 0,0:05:22.48,0:05:24.86,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:05:24.94,0:05:26.65,Default,,0,0,0,,(түйме дыбысы)
Dialogue: 0,0:05:30.83,0:05:33.66,Default,,0,0,0,,Бірінші шабуыл сол қол көк
Dialogue: 0,0:05:33.75,0:05:35.83,Default,,0,0,0,,Әйел, бұл сенен.
Dialogue: 0,0:05:35.91,0:05:37.42,Default,,0,0,0,,Ол қазірдің өзінде басталды ма?
Dialogue: 0,0:05:37.50,0:05:38.79,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:05:38.88,0:05:40.42,Default,,0,0,0,,Тым жылдам
Dialogue: 0,0:05:40.50,0:05:43.30,Default,,0,0,0,,Сондай-ақ менің атым Маю.
Dialogue: 0,0:05:43.38,0:05:45.67,Default,,0,0,0,,Маған сенің атың кім екені маңызды емес.
Dialogue: 0,0:05:45.76,0:05:47.18,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:05:47.26,0:05:50.43,Default,,0,0,0,,Бұл не... жиіркенішті...
Dialogue: 0,0:05:52.51,0:05:55.18,Default,,0,0,0,,Жақсы... Мен көрмедім.
Dialogue: 0,0:05:56.35,0:05:57.19,Default,,0,0,0,,(дұрыс дыбыс)
Dialogue: 0,0:06:02.82,0:06:05.65,Default,,0,0,0,,Екінші шабуыл оң аяқ сары
Dialogue: 0,0:06:06.78,0:06:07.95,Default,,0,0,0,,(дұрыс дыбыс)
Dialogue: 0,0:06:08.03,0:06:09.20,Default,,0,0,0,,(түйме дыбысы)
Dialogue: 0,0:06:11.91,0:06:14.08,Default,,0,0,0,,Бірінші соққы оң қол көк
Dialogue: 0,0:06:14.16,0:06:16.95,Default,,0,0,0,,Мынадай. Жарайды, бар күшіңді сал.
Dialogue: 0,0:06:17.04,0:06:18.25,Default,,0,0,0,,Бұл оңай жеңіс.
Dialogue: 0,0:06:18.25,0:06:19.46,Default,,0,0,0,,Бұл оңай жеңіс.
Dialogue: 0,0:06:18.25,0:06:19.46,Default,,0,0,0,,(дұрыс дыбыс)
Dialogue: 0,0:06:20.83,0:06:23.34,Default,,0,0,0,,Екінші шабуыл сол қол көк
Dialogue: 0,0:06:24.00,0:06:25.25,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:06:24.00,0:06:25.25,Default,,0,0,0,,(дұрыс дыбыс)
Dialogue: 0,0:06:25.34,0:06:26.34,Default,,0,0,0,,Ах
Dialogue: 0,0:06:31.18,0:06:32.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:33.05,0:06:35.35,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:06:40.39,0:06:42.81,Default,,0,0,0,,Қарасам... ол ер адам.
Dialogue: 0,0:06:42.90,0:06:45.86,Default,,0,0,0,,Егер бұл Харада-кун болса, мен оны көргенім жөн!
Dialogue: 0,0:06:45.94,0:06:48.24,Default,,0,0,0,,Не болды? Маюдың кезегі
Dialogue: 0,0:06:48.32,0:06:51.20,Default,,0,0,0,,Кя~ Олар мені атыммен атады~!
Dialogue: 0,0:06:51.28,0:06:53.53,Default,,0,0,0,,Мүмкін мен қазір өлетін шығармын~
Dialogue: 0,0:06:55.41,0:06:58.12,Default,,0,0,0,,Екінші шабуыл оң қол қызыл
Dialogue: 0,0:06:58.20,0:06:59.25,Default,,0,0,0,,(дұрыс дыбыс)
Dialogue: 0,0:06:59.33,0:07:02.38,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:07:02.46,0:07:05.04,Default,,0,0,0,,Мен тағы да сүйкімді қызбен бірге болғым келді.
Dialogue: 0,0:07:05.13,0:07:06.46,Default,,0,0,0,,Оң қол сары
Dialogue: 0,0:07:06.55,0:07:08.42,Default,,0,0,0,,Бұл тым жарқыраған...
Dialogue: 0,0:07:10.43,0:07:13.22,Default,,0,0,0,,Үйге ертерек барып, Лизаны кездестір.
Dialogue: 0,0:07:15.76,0:07:17.01,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:30.78,0:07:33.53,Default,,0,0,0,,Бірінші соққы оң аяқ көк
Dialogue: 0,0:07:35.66,0:07:36.87,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:38.37,0:07:40.12,Default,,0,0,0,,Абуна~
Dialogue: 0,0:07:40.20,0:07:42.83,Default,,0,0,0,,Екінші шабуыл сол аяқ сары
Dialogue: 0,0:07:44.29,0:07:47.34,Default,,0,0,0,,Сол аяқ сары...
Dialogue: 0,0:07:51.92,0:07:52.93,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:07:54.26,0:07:56.18,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:07:57.10,0:07:58.47,Default,,0,0,0,,(дұрыс дыбыс)
Dialogue: 0,0:07:58.56,0:08:02.14,Default,,0,0,0,,Керемет! C.H.A билейтін ханзада күткендей!
Dialogue: 0,0:08:02.89,0:08:04.19,Default,,0,0,0,,Оңай жеңіс!
Dialogue: 0,0:08:05.23,0:08:08.23,Default,,0,0,0,,Әй, бұл тым керемет
Dialogue: 0,0:08:08.73,0:08:11.86,Default,,0,0,0,,Бұл өте жақын және оның иісі өте жақсы, бұл ессіз
Dialogue: 0,0:08:19.24,0:08:21.66,Default,,0,0,0,,
Dialogue: 0,0:08:23.25,0:08:24.92,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:08:25.00,0:08:26.67,Default,,0,0,0,,Ахаха~
Dialogue: 0,0:08:26.75,0:08:28.42,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:08:29.92,0:08:31.92,Default,,0,0,0,,Ах... өте қуаныштымын...
Dialogue: 0,0:08:32.72,0:08:37.14,Default,,0,0,0,,Уақыт осылай мәңгі тоқтаса екен.
Dialogue: 0,0:08:40.18,0:08:42.18,Default,,0,0,0,,Егер ол бізбен бірге қалса, қауіп-қатерде болады.
Dialogue: 0,0:08:42.81,0:08:46.44,Default,,0,0,0,,Менің қолым шегінде... Сигім келеді...
Dialogue: 0,0:08:47.10,0:08:48.48,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:49.19,0:08:51.44,Default,,0,0,0,,-Неттеба! -Не?
Dialogue: 0,0:08:51.53,0:08:53.03,Default,,0,0,0,,Қысқа үзіліс жасаңыз
Dialogue: 0,0:08:53.11,0:08:54.32,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:54.40,0:08:56.45,Default,,0,0,0,,Сіз де үзіліс жасап жатырсыз!
Dialogue: 0,0:08:56.53,0:08:59.53,Default,,0,0,0,,Мен шаршадым! Менің де дәретханаға барғым келеді!
Dialogue: 0,0:08:59.62,0:09:00.45,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:00.53,0:09:02.91,Default,,0,0,0,,Иә? Ол не, сен?
Dialogue: 0,0:09:03.00,0:09:05.29,Default,,0,0,0,,Харада-кун, сен демалғың келеді, солай ма?
Dialogue: 0,0:09:05.37,0:09:06.46,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:06.54,0:09:08.63,Default,,0,0,0,,Шулы тәртіпсіздік
Dialogue: 0,0:09:08.71,0:09:10.75,Default,,0,0,0,,Соңғы, бірақ кем дегенде,
Dialogue: 0,0:09:10.84,0:09:12.96,Default,,0,0,0,,Жеңілсең, үйге аман-есен бара алмайсың.
Dialogue: 0,0:09:14.01,0:09:16.22,Default,,0,0,0,,Өзің жақсы болмасаң, өлесің.
Dialogue: 0,0:09:17.13,0:09:20.47,Default,,0,0,0,,Күлкілі емес... Тығыздау үшін айтылған ба?
Dialogue: 0,0:09:20.55,0:09:23.39,Default,,0,0,0,,Менің ойымша, сіз мұны айтасыз.
Dialogue: 0,0:09:23.47,0:09:24.93,Default,,0,0,0,,Та-да!
Dialogue: 0,0:09:25.02,0:09:26.69,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:09:26.77,0:09:30.48,Default,,0,0,0,,Сене алмайсың, солай ма? Мен сізге түсінуге мүмкіндік беремін
Dialogue: 0,0:09:32.15,0:09:35.65,Default,,0,0,0,,Сен ұшқан сорлы! Маған ілесіп суға сүңгисің деп кім ойлаған
Dialogue: 0,0:09:36.86,0:09:39.07,Default,,0,0,0,,Не... иә?
Dialogue: 0,0:09:39.16,0:09:41.58,Default,,0,0,0,,Ухихихихи…
Dialogue: 0,0:09:41.66,0:09:44.58,Default,,0,0,0,,Жалпы... а
Dialogue: 0,0:09:54.05,0:09:56.63,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:09:57.26,0:09:59.47,Default,,0,0,0,,Енді нағыз мәміле келді.
Dialogue: 0,0:09:59.55,0:10:01.64,Default,,0,0,0,,Ең көп рахат алыңыз.
Dialogue: 0,0:10:10.86,0:10:12.40,Default,,0,0,0,,Еш нық қалмаңыз
Dialogue: 0,0:10:12.48,0:10:15.28,Default,,0,0,0,,Сол қолыңыз қызыл. Асықшы.
Dialogue: 0,0:10:15.36,0:10:16.57,Default,,0,0,0,,Оқиға
Dialogue: 0,0:10:17.74,0:10:19.28,Default,,0,0,0,,(дұрыс дыбыс)
Dialogue: 0,0:10:19.36,0:10:20.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:21.12,0:10:22.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:22.58,0:10:23.78,Default,,0,0,0,,Не?
Dialogue: 0,0:10:25.37,0:10:26.79,Default,,0,0,0,,Ыстық!
Dialogue: 0,0:10:27.46,0:10:28.79,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:10:28.87,0:10:30.50,Default,,0,0,0,,Мына жерде
Dialogue: 0,0:10:30.58,0:10:32.29,Default,,0,0,0,,- Өте ыстық - (Харада) Сіз байсалдысыз ба...
Dialogue: 0,0:10:32.38,0:10:35.63,Default,,0,0,0,,- Әй! Тоқта! -Мені күлдірме
Dialogue: 0,0:10:35.71,0:10:37.55,Default,,0,0,0,,Тоқтауға амалым жоқ
Dialogue: 0,0:10:37.63,0:10:40.05,Default,,0,0,0,,Тепе-теңдікті жоғалтсаңыз, теріңіз еріп кетеді.
Dialogue: 0,0:10:40.13,0:10:43.22,Default,,0,0,0,,Мына жерде! Ах...
Dialogue: 0,0:10:45.39,0:10:47.31,Default,,0,0,0,,Жасыл жақта сол қол!
Dialogue: 0,0:10:47.39,0:10:49.10,Default,,0,0,0,,(дұрыс дыбыс)
Dialogue: 0,0:10:53.98,0:10:55.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:56.23,0:10:58.44,Default,,0,0,0,,Сузуши~!
Dialogue: 0,0:10:58.53,0:11:00.91,Default,,0,0,0,,Ах! Ах~!
Dialogue: 0,0:11:02.49,0:11:04.12,Default,,0,0,0,,Маған қарама!
Dialogue: 0,0:11:04.20,0:11:07.41,Default,,0,0,0,,Сіздің іш киіміңізге қызығатын адам бар ма?
Dialogue: 0,0:11:08.66,0:11:11.79,Default,,0,0,0,,Не болса да!
Dialogue: 0,0:11:14.29,0:11:18.05,Default,,0,0,0,,Мына жел... қауіпті... менің тынысым...
Dialogue: 0,0:11:18.13,0:11:20.55,Default,,0,0,0,,бұл... тез...
Dialogue: 0,0:11:20.63,0:11:22.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:22.39,0:11:23.59,Default,,0,0,0,,Көк…
Dialogue: 0,0:11:26.72,0:11:28.47,Default,,0,0,0,,(дұрыс дыбыс)
Dialogue: 0,0:11:30.48,0:11:33.06,Default,,0,0,0,,Екінші шабуыл оң аяқ сары
Dialogue: 0,0:11:33.15,0:11:37.07,Default,,0,0,0,,осылайша өлу – табиғи нәрсе шығар, деп ойлаймын.
Dialogue: 0,0:11:37.15,0:11:40.07,Default,,0,0,0,,Ойынға көңіл бөл, сен өлесің.
Dialogue: 0,0:11:40.15,0:11:43.32,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:11:47.79,0:11:49.37,Default,,0,0,0,,Сэм…
Dialogue: 0,0:11:49.91,0:11:52.33,Default,,0,0,0,,Оң аяқ сары...
Dialogue: 0,0:11:54.08,0:11:55.33,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:11:55.42,0:11:58.84,Default,,0,0,0,,Гагага... Сәттілік!
Dialogue: 0,0:12:00.63,0:12:02.09,Default,,0,0,0,,Не!
Dialogue: 0,0:12:02.68,0:12:06.10,Default,,0,0,0,,Бұл өтірік... Қазірдің өзінде... қатып қалды...
Dialogue: 0,0:12:06.18,0:12:08.60,Default,,0,0,0,,Еріп жатқанда солай болады.
Dialogue: 0,0:12:08.68,0:12:10.85,Default,,0,0,0,,Гррр... Гррр...
Dialogue: 0,0:12:10.93,0:12:14.35,Default,,0,0,0,,Қарғыс атсын... Қарғыс атсын... Қарғыс атсын
Dialogue: 0,0:12:17.52,0:12:20.03,Default,,0,0,0,,Бұл қауіпті... Мен өлемін...
Dialogue: 0,0:12:20.53,0:12:21.36,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:22.65,0:12:26.12,Default,,0,0,0,,Бұл Титаник сияқты романтикалық болуы мүмкін...
Dialogue: 0,0:12:26.78,0:12:28.87,Default,,0,0,0,,Поза біртүрлі, бірақ...
Dialogue: 0,0:12:36.96,0:12:40.63,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:12:46.76,0:12:48.14,Default,,0,0,0,,Харада-кун...
Dialogue: 0,0:12:49.22,0:12:50.81,Default,,0,0,0,,Пұт…
Dialogue: 0,0:12:51.81,0:12:53.64,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:12:55.56,0:12:59.19,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:13:07.66,0:13:10.78,Default,,0,0,0,,C.H.A C.H.A
Dialogue: 0,0:13:10.87,0:13:13.83,Default,,0,0,0,,C.H.A C.H.A…
Dialogue: 0,0:13:13.91,0:13:15.16,Default,,0,0,0,,Харада-кун…
Dialogue: 0,0:13:18.25,0:13:20.17,Default,,0,0,0,,Харада-кун…
Dialogue: 0,0:13:21.42,0:13:23.01,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:13:23.09,0:13:25.67,Default,,0,0,0,,Ikkeee~
Dialogue: 0,0:13:34.85,0:13:38.81,Default,,0,0,0,,Харада-кун ең жақсы! Мен әсер алдым!
Dialogue: 0,0:13:40.06,0:13:43.03,Default,,0,0,0,,Я... Оңай жеңіс!
Dialogue: 0,0:13:43.98,0:13:47.32,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:13:47.91,0:13:50.57,Default,,0,0,0,,- Иә? не? -(Харада) Не?
Dialogue: 0,0:13:53.16,0:13:54.33,Default,,0,0,0,,Ой…
Dialogue: 0,0:13:54.41,0:13:56.58,Default,,0,0,0,,Өтірік өтірік!
Dialogue: 0,0:13:56.66,0:13:59.08,Default,,0,0,0,,- (Харада) Уау! -Кяаааааа!
Dialogue: 0,0:13:59.75,0:14:01.09,Default,,0,0,0,,Бұл керемет көрініс емес пе?
Dialogue: 0,0:14:01.17,0:14:03.09,Default,,0,0,0,,Идиот! Маған көмектесші!
Dialogue: 0,0:14:03.17,0:14:04.96,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:14:05.05,0:14:08.63,Default,,0,0,0,,Маған сенің өлсең де, тірісің де бәрібір...
Dialogue: 0,0:14:08.72,0:14:12.05,Default,,0,0,0,,Мен осы сәтті ең жақсы көремін.
Dialogue: 0,0:14:12.68,0:14:14.77,Default,,0,0,0,,Бұл кенеттен болатын өлім.
Dialogue: 0,0:14:14.85,0:14:18.60,Default,,0,0,0,,Біреуіміз құлаған кезде ойын аяқталады.
Dialogue: 0,0:14:20.69,0:14:24.69,Default,,0,0,0,,Енді менің көңілімді көтеріңізші, жарай ма?
Dialogue: 0,0:14:24.78,0:14:26.61,Default,,0,0,0,,Адамдар
Dialogue: 0,0:14:27.57,0:14:30.36,Default,,0,0,0,,Біреуі құласа...
Dialogue: 0,0:14:31.45,0:14:32.95,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:33.45,0:14:36.87,Default,,0,0,0,,Егер сіз де түсірсеңіз...
Dialogue: 0,0:14:37.58,0:14:39.87,Default,,0,0,0,,А... не істеуім керек...
Dialogue: 0,0:14:43.71,0:14:46.17,Default,,0,0,0,,Мен алмаймын...
Dialogue: 0,0:14:52.97,0:14:54.64,Default,,0,0,0,,Менің оны тастаудан басқа амалым жоқ...
Dialogue: 0,0:14:58.73,0:15:01.23,Default,,0,0,0,,Артық емес... жоқ...
Dialogue: 0,0:15:02.56,0:15:04.90,Default,,0,0,0,,Мен зәрімді кетемін деп ойлаймын!
Dialogue: 0,0:15:06.48,0:15:10.99,Default,,0,0,0,,Егер мен оны Харада-кунның алдында жария етсем... жақсырақ болар едім...
Dialogue: 0,0:15:13.99,0:15:16.54,Default,,0,0,0,,I Ору
Dialogue: 0,0:15:19.25,0:15:21.00,Default,,0,0,0,,Харада-кун...
Dialogue: 0,0:15:21.08,0:15:23.58,Default,,0,0,0,,Мен бірге ойын ойнаймыз деп ешқашан ойламадым.
Dialogue: 0,0:15:23.67,0:15:25.79,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:15:26.34,0:15:28.55,Default,,0,0,0,,Мен бақытты болдым
Dialogue: 0,0:15:30.09,0:15:34.30,Default,,0,0,0,,Мен сені бірінші рет тікелей эфирде көргеннен бері жанкүйермін.
Dialogue: 0,0:15:34.39,0:15:37.93,Default,,0,0,0,,Мен үнемі Харада-кунға қарайтынмын.
Dialogue: 0,0:15:38.02,0:15:40.89,Default,,0,0,0,,Мен де көптеген фанаттар хаттарын жібердім.
Dialogue: 0,0:15:41.89,0:15:43.81,Default,,0,0,0,,Тіпті қиын уақытта да
Dialogue: 0,0:15:43.90,0:15:46.36,Default,,0,0,0,,Мен мұңайсам да
Dialogue: 0,0:15:46.44,0:15:50.11,Default,,0,0,0,,Әнді тыңдап көңілім көтерілді.
Dialogue: 0,0:15:51.90,0:15:54.99,Default,,0,0,0,,Мені әрқашан қолдағаны үшін...
Dialogue: 0,0:15:55.87,0:15:58.33,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:00.08,0:16:04.75,Default,,0,0,0,,Мен Харада-кунның арқасында қолымнан келгенді істей алдым.
Dialogue: 0,0:16:10.80,0:16:13.26,Default,,0,0,0,,Менің ойымша, Харада-кун әйелдерді ұнатады.
Dialogue: 0,0:16:13.34,0:16:16.14,Default,,0,0,0,,Оның маған еш қатысы жоқ.
Dialogue: 0,0:16:16.22,0:16:18.81,Default,,0,0,0,,Жалпы, мен жанкүйер болдым.
Dialogue: 0,0:16:19.93,0:16:21.73,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:16:22.35,0:16:25.02,Default,,0,0,0,,Харада-кун жанкүйерлеріне қамқорлық жасайды!
Dialogue: 0,0:16:29.07,0:16:33.11,Default,,0,0,0,,Тым болмаса... ажырасып жатырмыз демеңіз...
Dialogue: 0,0:16:33.20,0:16:36.12,Default,,0,0,0,,Кана кешіріңіз хахаха...
Dialogue: 0,0:16:41.79,0:16:44.37,Default,,0,0,0,,Кана... Бұл өтірік...
Dialogue: 0,0:16:44.46,0:16:46.33,Default,,0,0,0,,Менің айтқым келгені бұл емес еді...
Dialogue: 0,0:16:47.84,0:16:51.38,Default,,0,0,0,,Жоқ... Мен жанкүйермін...
Dialogue: 0,0:16:52.13,0:16:54.68,Default,,0,0,0,,Мен әрқашан жанкүйер боламын
Dialogue: 0,0:16:54.76,0:16:58.64,Default,,0,0,0,,C.H.A. Билеріңізге де сәттілік...
Dialogue: 0,0:17:01.14,0:17:02.14,Default,,0,0,0,,(Юки) Уф… (Ишикава) Ха…
Dialogue: 0,0:17:08.44,0:17:09.65,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:17:10.23,0:17:11.78,Default,,0,0,0,,Мұндай ойлар...
Dialogue: 0,0:17:14.24,0:17:15.65,Default,,0,0,0,,Харада-кун!
Dialogue: 0,0:17:16.61,0:17:18.16,Default,,0,0,0,,Ақымақ болма...
Dialogue: 0,0:17:18.91,0:17:22.16,Default,,0,0,0,,Сіз өте кереметсіз...
Dialogue: 0,0:17:23.08,0:17:25.66,Default,,0,0,0,,- (Харада) Мен де сондаймын. - А?
Dialogue: 0,0:17:26.29,0:17:28.83,Default,,0,0,0,,Жанкүйерлердің қолдауынсыз
Dialogue: 0,0:17:28.92,0:17:30.92,Default,,0,0,0,,Мен кумир бола алмаймын...
Dialogue: 0,0:17:31.00,0:17:33.67,Default,,0,0,0,,Қолымнан келгеннің бәрін жасай алғаным бәрінің арқасы.
Dialogue: 0,0:17:33.76,0:17:35.67,Default,,0,0,0,,Мұның бәрі Маю-чанның арқасында!
Dialogue: 0,0:17:35.76,0:17:39.18,Default,,0,0,0,,Бұл берілген...
Dialogue: 0,0:17:39.26,0:17:40.93,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:17:41.01,0:17:44.06,Default,,0,0,0,,бұл...Харада...кун
Dialogue: 0,0:17:45.64,0:17:48.56,Default,,0,0,0,,Уф!Қарғыс атқыр...
Dialogue: 0,0:17:49.86,0:17:52.78,Default,,0,0,0,,Мен бұлай ажыраса алмаймын...
Dialogue: 0,0:17:52.86,0:17:56.53,Default,,0,0,0,,Маю-чан! Қайтадан өмір сүріңіз... келіңізші
Dialogue: 0,0:17:56.61,0:17:58.07,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:58.16,0:18:01.49,Default,,0,0,0,,Ешқашан... ешқашан!
Dialogue: 0,0:18:01.58,0:18:04.08,Default,,0,0,0,,Иә! Міндетті түрде барыңыз!
Dialogue: 0,0:18:05.66,0:18:07.33,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:08.42,0:18:09.63,Default,,0,0,0,,Иә
Dialogue: 0,0:18:15.42,0:18:20.09,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:23.18,0:18:26.60,Default,,0,0,0,,Харада-кун бүгін де жақсы болды~
Dialogue: 0,0:18:26.68,0:18:30.31,Default,,0,0,0,,C.H.A! C.H.A!
Dialogue: 0,0:18:30.40,0:18:33.57,Default,,0,0,0,,C! H…
Dialogue: 0,0:18:33.65,0:18:35.15,Default,,0,0,0,,Ой! Незуко қайда?
Dialogue: 0,0:18:35.65,0:18:37.57,Default,,0,0,0,,Uso~!
Dialogue: 0,0:18:39.40,0:18:42.16,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:18:46.95,0:18:48.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:50.33,0:18:51.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:52.38,0:18:54.59,Default,,0,0,0,,Қарғыс атсын!Қарғыс атсын!
Dialogue: 0,0:18:55.25,0:18:56.96,Default,,0,0,0,,Тағы кездескенше...
Dialogue: 0,0:18:57.05,0:18:59.34,Default,,0,0,0,,Мен саған тағы да көмектесе алмадым...
Dialogue: 0,0:19:01.05,0:19:03.10,Default,,0,0,0,,Эй, Харада-кун
Dialogue: 0,0:19:03.18,0:19:04.56,Default,,0,0,0,,Оян
Dialogue: 0,0:19:05.72,0:19:08.43,Default,,0,0,0,,Мен қазір кетемін, сау болыңыз.
Dialogue: 0,0:19:09.89,0:19:11.56,Default,,0,0,0,,Сіз кетіп қалдыңыз ба?
Dialogue: 0,0:19:11.65,0:19:14.90,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:19:26.08,0:19:27.37,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:19:30.25,0:19:31.58,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:19:34.75,0:19:37.63,Default,,0,0,0,,Мен өз бетіммен құлаймын деп ешқашан ойламаппын.
Dialogue: 0,0:19:38.42,0:19:42.51,Default,,0,0,0,,Есіңде ме? Мәселе мынада, ол өлді.
Dialogue: 0,0:19:42.59,0:19:44.64,Default,,0,0,0,,- Шулы! -не?
Dialogue: 0,0:19:45.68,0:19:48.02,Default,,0,0,0,,Болды, тездетіп киім ауыстырып әкел!
Dialogue: 0,0:19:48.10,0:19:50.52,Default,,0,0,0,,Бұл шықты! Асықшы!
Dialogue: 0,0:19:51.14,0:19:52.52,Default,,0,0,0,,Мен душқа түскім келеді!
Dialogue: 0,0:19:52.60,0:19:54.27,Default,,0,0,0,,Мен таң қалдым...
Dialogue: 0,0:19:52.60,0:19:54.27,Default,,0,0,0,,Менің макияжым шығып, қорқынышты болды!
Dialogue: 0,0:19:54.27,0:19:54.35,Default,,0,0,0,,Менің макияжым шығып, қорқынышты болды!
Dialogue: 0,0:19:54.35,0:19:55.11,Default,,0,0,0,,Менің макияжым шығып, қорқынышты болды!
Dialogue: 0,0:19:54.35,0:19:55.11,Default,,0,0,0,,Сен... сен өлдің.
Dialogue: 0,0:19:55.11,0:19:56.57,Default,,0,0,0,,Сен... сен өлдің.
Dialogue: 0,0:19:57.36,0:19:58.98,Default,,0,0,0,,Сіз шынымен адамсыз ба?
Dialogue: 0,0:20:02.82,0:20:04.95,Default,,0,0,0,,Мен өлгеніме сене алар емеспін...
Dialogue: 0,0:20:05.45,0:20:06.41,Default,,0,0,0,,Савана
Dialogue: 0,0:20:06.49,0:20:08.33,Default,,0,0,0,,Кана…
Dialogue: 0,0:20:08.41,0:20:10.41,Default,,0,0,0,,- (Харада) Кешіріңіз... - Маған тиіспеңіз.
Dialogue: 0,0:20:12.25,0:20:13.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:16.46,0:20:17.67,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:20:20.46,0:20:21.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:24.64,0:20:26.14,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:20:26.22,0:20:28.18,Default,,0,0,0,,Бұл Маю, солай ма?
Dialogue: 0,0:20:29.26,0:20:31.93,Default,,0,0,0,,Ах! Эй, сен не істеп жатырсың!
Dialogue: 0,0:20:32.02,0:20:34.94,Default,,0,0,0,,Маю-чан, мен сені дұрыс түсінбедім.
Dialogue: 0,0:20:35.02,0:20:37.69,Default,,0,0,0,,- (Харада) Ол шынымен сүйкімді болып кетті - Бұл өтірік пе?
Dialogue: 0,0:20:37.77,0:20:40.19,Default,,0,0,0,,Цука супер түрі!
Dialogue: 0,0:20:40.28,0:20:42.95,Default,,0,0,0,,Гаха аха~
Dialogue: 0,0:20:43.82,0:20:45.99,Default,,0,0,0,,Сіз байсалдысыз ба? Мен өлемін деп ойлаймын
Dialogue: 0,0:20:46.07,0:20:46.57,Default,,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:20:46.57,0:20:48.58,Default,,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:20:46.57,0:20:48.58,Default,,0,0,0,,Біз қазірдің өзінде өлдік!
Dialogue: 0,0:20:48.66,0:20:49.53,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:20:49.53,0:20:50.33,Default,,0,0,0,,Ах~ Дұрыс.
Dialogue: 0,0:20:49.53,0:20:50.33,Default,,0,0,0,,(Менің жылауым)
Dialogue: 0,0:20:50.33,0:20:50.41,Default,,0,0,0,,(Менің жылауым)
Dialogue: 0,0:20:50.41,0:20:51.12,Default,,0,0,0,,(Менің жылауым)
Dialogue: 0,0:20:50.41,0:20:51.12,Default,,0,0,0,,(Харада мен Маюдың күлкісі)
Dialogue: 0,0:20:51.12,0:20:51.95,Default,,0,0,0,,(Харада мен Маюдың күлкісі)
Dialogue: 0,0:20:52.04,0:20:54.41,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.77,0:22:01.77,Default,,0,0,0,,~♪
Dialogue: 0,0:22:05.40,0:22:09.95,Default,,0,0,0,,Мия, мия...
Dialogue: 0,0:22:12.12,0:22:13.41,Default,,0,0,0,,Уф…
Dialogue: 0,0:22:13.49,0:22:15.08,Default,,0,0,0,,Барлығы~
Dialogue: 0,0:22:16.20,0:22:17.21,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:22:19.12,0:22:20.54,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:22:20.63,0:22:22.04,Default,,0,0,0,,Гү…
Dialogue: 0,0:22:22.13,0:22:25.21,Default,,0,0,0,,C.H.A! C.H.A!
Dialogue: 0,0:22:25.30,0:22:27.59,Default,,0,0,0,,Маю! рақмет сізге!
Dialogue: 0,0:22:27.67,0:22:30.18,Default,,0,0,0,,Сонымен, дебюттік синглден бастайық па?
Dialogue: 0,0:22:30.26,0:22:31.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:31.76,0:22:34.18,Default,,0,0,0,,- (Клавис) Иә! -(Қара шашты әйел, Деким) Иә~
Dialogue: 0,0:22:35.77,0:22:38.06,Default,,0,0,0,,Біздің әнді тыңдаңыздар!
Dialogue: 0,0:22:38.77,0:22:42.31,Default,,0,0,0,,Жүректің инфарктісі!
Dialogue: 0,0:22:43.81,0:22:49.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory