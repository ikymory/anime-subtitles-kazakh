Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.38,0:00:12.30,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:18.47,0:00:19.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:24.77,0:00:25.81,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:27.61,0:00:31.23,Default,,0,0,0,,- (Қара шашты әйел) Кім? -(Нона) Нона сен ше?
Dialogue: 0,0:00:32.11,0:00:33.45,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:36.32,0:00:39.95,Default,,0,0,0,,- (Қара шашты әйел) А? -(Нона) Жарайды.
Dialogue: 0,0:00:40.58,0:00:42.95,Default,,0,0,0,,Сіздің атыңыз жоқ
Dialogue: 0,0:00:44.04,0:00:49.04,Default,,0,0,0,,♪~
Dialogue: 0,0:01:58.91,0:02:03.91,Default,,0,0,0,,~♪
Dialogue: 0,0:02:03.99,0:02:06.41,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:02:19.47,0:02:21.76,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:02:21.85,0:02:23.05,Default,,0,0,0,,15 қабат.
Dialogue: 0,0:02:23.14,0:02:24.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:29.64,0:02:32.06,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:02:46.16,0:02:47.83,Default,,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,0:02:57.55,0:02:59.47,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:02.47,0:03:03.93,Default,,0,0,0,,Клавис
Dialogue: 0,0:03:04.68,0:03:06.47,Default,,0,0,0,,(Келу қоңырауы)
Dialogue: 0,0:03:07.72,0:03:09.64,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:03:09.73,0:03:12.40,Default,,0,0,0,,- (Нона) Баяу - (Клавис) Осыдан кейін сақ боламын.
Dialogue: 0,0:03:12.48,0:03:14.06,Default,,0,0,0,,Бүгін қайда барасың?
Dialogue: 0,0:03:14.15,0:03:15.52,Default,,0,0,0,,Декиминко
Dialogue: 0,0:03:15.61,0:03:17.07,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:03:19.61,0:03:24.41,Default,,0,0,0,,(лифттің көтерілу және төмендеу дыбысы)
Dialogue: 0,0:03:29.45,0:03:31.29,Default,,0,0,0,,Ах.
Dialogue: 0,0:03:33.17,0:03:34.38,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:03:36.63,0:03:38.05,Default,,0,0,0,,(Келу қоңырауы)
Dialogue: 0,0:03:41.01,0:03:43.01,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:03:43.64,0:03:46.05,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:50.06,0:03:51.27,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:00.65,0:04:03.45,Default,,0,0,0,,Рахмет, Нона.
Dialogue: 0,0:04:03.99,0:04:06.03,Default,,0,0,0,,Деким патшайымға қош келдіңіз
Dialogue: 0,0:04:06.12,0:04:09.04,Default,,0,0,0,,Менің атым бармен Деким.
Dialogue: 0,0:04:09.87,0:04:11.41,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:04:12.21,0:04:13.29,Default,,0,0,0,,Сол жер...
Dialogue: 0,0:04:13.37,0:04:15.29,Default,,0,0,0,,Өлгендер қайдан келеді
Dialogue: 0,0:04:15.38,0:04:18.80,Default,,0,0,0,,Өлген адам... өлі адам?
Dialogue: 0,0:04:18.88,0:04:22.26,Default,,0,0,0,,Дұрыс... екі өлі адам келе жатыр.
Dialogue: 0,0:04:22.34,0:04:25.55,Default,,0,0,0,,Мен оларға өз өмірлері туралы ойын ойнатамын.
Dialogue: 0,0:04:26.64,0:04:27.55,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:27.64,0:04:30.89,Default,,0,0,0,,Процесс барысында бүкіл адамзатты көрсету
Dialogue: 0,0:04:30.97,0:04:34.81,Default,,0,0,0,,Соған және өмір туралы естеліктерге негізделген өлілерге үкім
Dialogue: 0,0:04:35.40,0:04:37.81,Default,,0,0,0,,Біз төрешілерміз
Dialogue: 0,0:04:39.11,0:04:40.82,Default,,0,0,0,,Төреші…
Dialogue: 0,0:04:40.90,0:04:44.70,Default,,0,0,0,,Жарайды... сіз бірдеңені аңдамай айтып тұрғандай сезінесіз.
Dialogue: 0,0:04:47.28,0:04:49.58,Default,,0,0,0,,Сонымен, өлгендер келгенше.
Dialogue: 0,0:04:49.66,0:04:54.21,Default,,0,0,0,,Төреші қонақтардың өңделген естеліктерін алады.
Dialogue: 0,0:04:54.29,0:04:55.71,Default,,0,0,0,,Өңдеу?
Dialogue: 0,0:04:55.79,0:04:58.58,Default,,0,0,0,,Иә, бұл әке сияқты
Dialogue: 0,0:04:58.67,0:05:01.30,Default,,0,0,0,,Негізінде бұл жанып тұрған шам сияқты.
Dialogue: 0,0:05:01.38,0:05:02.59,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:05:03.38,0:05:04.72,Default,,0,0,0,,Әйтеуір
Dialogue: 0,0:05:06.01,0:05:08.59,Default,,0,0,0,,- (Қара шашты әйел) Мм, мен... - (Нона) Біраз күте тұрыңыз.
Dialogue: 0,0:05:08.68,0:05:10.60,Default,,0,0,0,,Патшайым Жарайды.
Dialogue: 0,0:05:10.68,0:05:13.60,Default,,0,0,0,,Иә, иә, жадты тасымалдау.
Dialogue: 0,0:05:22.32,0:05:25.03,Default,,0,0,0,,Сонымен қатар, демонстрация жылдам.
Dialogue: 0,0:05:25.11,0:05:26.86,Default,,0,0,0,,Деким Құрметпен
Dialogue: 0,0:05:26.95,0:05:28.70,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:05:29.95,0:05:31.70,Default,,0,0,0,,Мұнда кел~
Dialogue: 0,0:05:38.92,0:05:40.13,Default,,0,0,0,,Бұл!
Dialogue: 0,0:05:40.71,0:05:41.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:42.00,0:05:44.76,Default,,0,0,0,,Мен мұнда не істеп жатырмын?
Dialogue: 0,0:05:44.84,0:05:48.13,Default,,0,0,0,,Аа, кешіріңіз, мен ұмытып қалдым.
Dialogue: 0,0:05:48.22,0:05:50.14,Default,,0,0,0,,Көмекші
Dialogue: 0,0:05:58.56,0:05:59.77,Default,,0,0,0,,Осы мектепті бітіру – шеберліктің дәлелі.
Dialogue: 0,0:06:05.40,0:06:06.57,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:08.45,0:06:10.99,Default,,0,0,0,,Қуыршақтар - Декимудың хоббиі.
Dialogue: 0,0:06:11.07,0:06:12.58,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:06:13.66,0:06:15.20,Default,,0,0,0,,Өзін нашар сезіну
Dialogue: 0,0:06:15.83,0:06:17.96,Default,,0,0,0,,Бұл қорқынышты хобби.
Dialogue: 0,0:06:19.92,0:06:21.58,Default,,0,0,0,,Енді мұның артында
Dialogue: 0,0:06:21.67,0:06:25.34,Default,,0,0,0,,Декиму қонақтарды ойын ойнауға шақырады.
Dialogue: 0,0:06:25.42,0:06:26.84,Default,,0,0,0,,Мұның артында?
Dialogue: 0,0:06:26.92,0:06:29.09,Default,,0,0,0,,Алға күту.
Dialogue: 0,0:06:29.76,0:06:31.34,Default,,0,0,0,,Қозғалмаңыз.
Dialogue: 0,0:06:31.43,0:06:32.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:37.93,0:06:40.35,Default,,0,0,0,,Бұл жолғы басты кейіпкерлер – сол екеуі.
Dialogue: 0,0:06:41.06,0:06:42.90,Default,,0,0,0,,Такаши мен Мачико
Dialogue: 0,0:06:43.69,0:06:46.19,Default,,0,0,0,,Жаңа өлі спрей
Dialogue: 0,0:06:52.66,0:06:54.37,Default,,0,0,0,,Сен одан өлдің бе?
Dialogue: 0,0:06:54.45,0:06:56.45,Default,,0,0,0,,Өлім соққысы
Dialogue: 0,0:06:56.54,0:06:59.00,Default,,0,0,0,,Әркім өзінің өлгенін де ұмытады.
Dialogue: 0,0:06:59.08,0:07:01.46,Default,,0,0,0,,Сондықтан олар байқаса жақсы емес
Dialogue: 0,0:07:01.54,0:07:02.38,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:02.46,0:07:04.71,Default,,0,0,0,,Өлгеніңді білгенде
Dialogue: 0,0:07:04.79,0:07:07.13,Default,,0,0,0,,Сіз өз өміріңізге қауіп төндіретін ойын ойнайсыз ба?
Dialogue: 0,0:07:08.88,0:07:11.51,Default,,0,0,0,,Бірақ, біріншіден, бұл өз өміріңізді қатерге тігу ойыны емес.
Dialogue: 0,0:07:11.59,0:07:14.43,Default,,0,0,0,,Иә, әдетте жоқ
Dialogue: 0,0:07:14.51,0:07:16.01,Default,,0,0,0,,Сонымен индукция
Dialogue: 0,0:07:16.10,0:07:17.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:17.18,0:07:20.52,Default,,0,0,0,,Ойынды ойнамасам, өліп қалуым мүмкін сияқты.
Dialogue: 0,0:07:20.60,0:07:22.52,Default,,0,0,0,,Бұл қазіргі жағдай
Dialogue: 0,0:07:22.60,0:07:24.94,Default,,0,0,0,,Сіз біреуді қорқытудың ортасында жүрсіз бе?
Dialogue: 0,0:07:25.02,0:07:27.61,Default,,0,0,0,,Дұрыс, сондықтан қозғалмаңыз.
Dialogue: 0,0:07:27.69,0:07:29.78,Default,,0,0,0,,Осы жерде оны тыңдайық.
Dialogue: 0,0:07:30.36,0:07:33.53,Default,,0,0,0,,Егер сіз біреудің тілін алмасаңыз не болатынын ешқашан білмедіңіз.
Dialogue: 0,0:07:35.37,0:07:40.29,Default,,0,0,0,,(рулетаны айналдыру дыбысы)
Dialogue: 0,0:07:40.37,0:07:42.79,Default,,0,0,0,,Сәтті индукция
Dialogue: 0,0:07:44.13,0:07:47.09,Default,,0,0,0,,Неге сонша бардың...
Dialogue: 0,0:07:47.63,0:07:49.17,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:49.26,0:07:52.01,Default,,0,0,0,,Өйткені ол үкім шығару үшін қажет.
Dialogue: 0,0:07:52.09,0:07:54.84,Default,,0,0,0,,Экстремалды жағдайларды қалай жасауға болады
Dialogue: 0,0:07:54.93,0:07:59.56,Default,,0,0,0,,Менің тәжірибемнен олардың өмірлері үшін күресуіне мүмкіндік берген дұрыс.
Dialogue: 0,0:07:59.64,0:08:01.52,Default,,0,0,0,,Төтенше жағдай?
Dialogue: 0,0:08:01.60,0:08:06.02,Default,,0,0,0,,Ойын кезінде пайда болатын шектен тыс шиеленіс жағдайы.
Dialogue: 0,0:08:06.11,0:08:07.77,Default,,0,0,0,,Негізінен рухани
Dialogue: 0,0:08:08.86,0:08:10.99,Default,,0,0,0,,Енді келесіге көшейік.
Dialogue: 0,0:08:12.82,0:08:14.03,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:08:14.82,0:08:15.82,Default,,0,0,0,,Не?
Dialogue: 0,0:08:15.91,0:08:19.04,Default,,0,0,0,,Үкім шығару үшін төтенше жағдайлар қажет...
Dialogue: 0,0:08:19.12,0:08:22.54,Default,,0,0,0,,Адамның жадына ғана сүйене отырып, үкім шығаруға болмайды.
Dialogue: 0,0:08:22.62,0:08:25.54,Default,,0,0,0,,Жүрегімдегі қараңғылықты мүмкіндігінше сыртқа шығарғаннан кейін,
Dialogue: 0,0:08:25.63,0:08:28.04,Default,,0,0,0,,Төреші оны қабылдайды.
Dialogue: 0,0:08:28.54,0:08:31.05,Default,,0,0,0,,Сонда ол үкімге айналады.
Dialogue: 0,0:08:31.13,0:08:32.92,Default,,0,0,0,,Жүректің қараңғылығы...
Dialogue: 0,0:08:33.84,0:08:35.93,Default,,0,0,0,,Сенбедіңіз бе?
Dialogue: 0,0:08:36.01,0:08:39.81,Default,,0,0,0,,Адамның ең қарапайым эмоциясы не екенін білесіз бе?
Dialogue: 0,0:08:42.02,0:08:43.31,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:08:44.14,0:08:45.60,Default,,0,0,0,,Қорқыныш
Dialogue: 0,0:08:48.27,0:08:50.82,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:51.86,0:08:54.32,Default,,0,0,0,,Бұл қуыршақтың үстінде киімдері де бар.
Dialogue: 0,0:08:54.40,0:08:58.07,Default,,0,0,0,,Бұл туралы алаңдамаңыз, төменге қараңыз.
Dialogue: 0,0:08:58.66,0:09:00.79,Default,,0,0,0,,Ойын дартс па?
Dialogue: 0,0:09:00.87,0:09:02.08,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:09:07.67,0:09:10.75,Default,,0,0,0,,- (Мачико) Уф! -Мачико!
Dialogue: 0,0:09:10.84,0:09:13.34,Default,,0,0,0,,Иә? Қызық, не болды?
Dialogue: 0,0:09:13.42,0:09:16.34,Default,,0,0,0,,Бұл ойын ауыр
Dialogue: 0,0:09:16.43,0:09:17.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:17.34,0:09:19.51,Default,,0,0,0,,Өйткені иығыма нысанаға тиді.
Dialogue: 0,0:09:19.60,0:09:21.89,Default,,0,0,0,,Мачиконың иығы ауыра бастады.
Dialogue: 0,0:09:21.97,0:09:23.27,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:23.93,0:09:25.14,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:25.23,0:09:27.60,Default,,0,0,0,,Сіз! Әлі де ауырады ма?
Dialogue: 0,0:09:28.73,0:09:30.94,Default,,0,0,0,,Бұл жолы өкпе ме?
Dialogue: 0,0:09:31.57,0:09:34.65,Default,,0,0,0,,Олардың әрқайсысының дене мүшелерімен байланысты мақсаты бар.
Dialogue: 0,0:09:34.74,0:09:37.15,Default,,0,0,0,,Бұл бір-біріне жеті жебе лақтыратын ойын.
Dialogue: 0,0:09:37.24,0:09:40.28,Default,,0,0,0,,Бірін-бірі пышақтау сияқты.
Dialogue: 0,0:09:40.99,0:09:42.66,Default,,0,0,0,,Есі дұрыс емес
Dialogue: 0,0:09:43.79,0:09:45.37,Default,,0,0,0,,Оған тез үйреніп кетесіз
Dialogue: 0,0:09:49.25,0:09:52.04,Default,,0,0,0,,А, түсіндім, оны алып тастаңыз.
Dialogue: 0,0:09:52.13,0:09:54.55,Default,,0,0,0,,Декім маған сабақ берді.
Dialogue: 0,0:09:54.63,0:09:57.05,Default,,0,0,0,,- (Нона) Бірақ сіз қалай ойлайсыз? - (Қара шашты әйел) А?
Dialogue: 0,0:09:57.13,0:09:58.80,Default,,0,0,0,,Ұпай
Dialogue: 0,0:10:01.64,0:10:03.81,Default,,0,0,0,,Егер сіз оны осылай алып тастасаңыз
Dialogue: 0,0:10:03.89,0:10:05.68,Default,,0,0,0,,Мачико жеңеді
Dialogue: 0,0:10:05.77,0:10:07.06,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:10:07.14,0:10:09.48,Default,,0,0,0,,Сіздің көзқарасыңыз бойынша.
Dialogue: 0,0:10:09.56,0:10:11.56,Default,,0,0,0,,Бірақ тараптар әртүрлі.
Dialogue: 0,0:10:11.65,0:10:14.73,Default,,0,0,0,,Мен жеңіліп қалсам, мені өлтіретін сияқтымын.
Dialogue: 0,0:10:14.82,0:10:16.15,Default,,0,0,0,,Мұны ешкім жасай алмайды.
Dialogue: 0,0:10:16.24,0:10:18.07,Default,,0,0,0,,Иә... Мен олай айтқан жоқпын.
Dialogue: 0,0:10:18.15,0:10:20.57,Default,,0,0,0,,Бірақ мен бұл туралы ойлаймын.
Dialogue: 0,0:10:22.16,0:10:22.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:23.08,0:10:25.83,Default,,0,0,0,,Жеңілсек не болады екен...
Dialogue: 0,0:10:26.58,0:10:29.33,Default,,0,0,0,,Ешкім қауіпті жолға түскісі келмейді.
Dialogue: 0,0:10:29.42,0:10:31.79,Default,,0,0,0,,Өйткені бұл қорқынышты.
Dialogue: 0,0:10:36.05,0:10:37.21,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:37.30,0:10:40.22,Default,,0,0,0,,Кешіріңіз Мачико! Қолдарым есінен танып қалды
Dialogue: 0,0:10:40.30,0:10:43.10,Default,,0,0,0,,-(Нона) Мен білдім -(Қара шашты әйел) Әдейі болды ма?
Dialogue: 0,0:10:43.18,0:10:46.97,Default,,0,0,0,,Біз білетініміз – жарыс шамының жадысы.
Dialogue: 0,0:10:47.06,0:10:51.35,Default,,0,0,0,,Біз олардың дәл қазір не ойлап жатқанын болжай аламыз.
Dialogue: 0,0:10:51.44,0:10:53.36,Default,,0,0,0,,Сонымен, түйсік дегенді қалай түсінесіңдер?
Dialogue: 0,0:10:53.94,0:10:56.36,Default,,0,0,0,,Менің ойымша, сіз мұны айта аласыз ...
Dialogue: 0,0:10:56.44,0:11:01.61,Default,,0,0,0,,Үкім тәжірибе мен бақылауды қажет етеді.
Dialogue: 0,0:11:03.37,0:11:07.45,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:11:09.50,0:11:11.67,Default,,0,0,0,,Адамдар қызық.
Dialogue: 0,0:11:11.75,0:11:15.88,Default,,0,0,0,,Осыншама көп қарасақ та, біз әлі де ақыл-ойдың қалай жұмыс істейтінін түсінбейміз.
Dialogue: 0,0:11:16.67,0:11:19.55,Default,,0,0,0,,Айтпақшы, олар өлді.
Dialogue: 0,0:11:20.22,0:11:22.97,Default,,0,0,0,,Өйткені Такаши Мачикодан опасыздық жасады деп күдіктенген.
Dialogue: 0,0:11:23.05,0:11:26.18,Default,,0,0,0,,Бал айы кезінде апаттан қайтыс болды
Dialogue: 0,0:11:26.26,0:11:28.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:30.60,0:11:32.19,Default,,0,0,0,,Сіздің балаңыз
Dialogue: 0,0:11:32.94,0:11:34.56,Default,,0,0,0,,Неге үндемедің?
Dialogue: 0,0:11:35.06,0:11:38.19,Default,,0,0,0,,Мен сапарымда сізді таң қалдырғым келді...
Dialogue: 0,0:11:38.28,0:11:40.44,Default,,0,0,0,,Мен әлі ешкімге айтқан жоқпын.
Dialogue: 0,0:11:41.11,0:11:43.32,Default,,0,0,0,,Себебі мен сізге бірінші болып хабарлағым келді...
Dialogue: 0,0:11:44.49,0:11:45.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:46.83,0:11:48.33,Default,,0,0,0,,Рахмет сізге Мачико
Dialogue: 0,0:11:50.08,0:11:52.87,Default,,0,0,0,,Мен де әке болдым...
Dialogue: 0,0:11:56.96,0:11:58.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:02.68,0:12:05.80,Default,,0,0,0,,Гуаааааааааааааааааааааааааа...
Dialogue: 0,0:12:08.39,0:12:10.64,Default,,0,0,0,,Жадты қалпына келтіру
Dialogue: 0,0:12:10.73,0:12:11.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:12.02,0:12:15.10,Default,,0,0,0,,Ойын ойнау барысында мен ынталана бастадым.
Dialogue: 0,0:12:15.19,0:12:17.44,Default,,0,0,0,,Не есімде қалғанын білмеймін, бірақ
Dialogue: 0,0:12:17.52,0:12:19.19,Default,,0,0,0,,Өлім туралы естелік
Dialogue: 0,0:12:20.65,0:12:23.82,Default,,0,0,0,,Өйткені мен өлген кездегі шоктан ұмытып кеттім.
Dialogue: 0,0:12:23.90,0:12:26.45,Default,,0,0,0,,Мәжбүрлеп ояту
Dialogue: 0,0:12:37.38,0:12:40.80,Default,,0,0,0,,Құттықтаймыз, Мачико-саманың жеңісі.
Dialogue: 0,0:12:41.34,0:12:43.88,Default,,0,0,0,,Ойын енді аяқталады.
Dialogue: 0,0:12:43.97,0:12:46.47,Default,,0,0,0,,Екеуің де келіңдер.
Dialogue: 0,0:12:46.55,0:12:49.31,Default,,0,0,0,,Бір минут күтіңіз! сұраңыз! Бір минут күте тұрыңыз
Dialogue: 0,0:12:49.39,0:12:50.60,Default,,0,0,0,,Тағы бір рет
Dialogue: 0,0:12:50.68,0:12:52.27,Default,,0,0,0,,- (Мачико) Бұл бекер - Не?
Dialogue: 0,0:12:52.85,0:12:54.06,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:12:55.35,0:12:56.77,Default,,0,0,0,,Мұның бәрі ысырап
Dialogue: 0,0:12:57.69,0:12:58.52,Default,,0,0,0,,Мачико?
Dialogue: 0,0:12:58.61,0:13:01.57,Default,,0,0,0,,Эй... біз...
Dialogue: 0,0:13:02.44,0:13:04.53,Default,,0,0,0,,Ол әлдеқашан өлді, солай ма?
Dialogue: 0,0:13:04.61,0:13:08.37,Default,,0,0,0,,Иә, екеуің де өмірден өтіп кеттіңдер.
Dialogue: 0,0:13:08.45,0:13:13.16,Default,,0,0,0,,Өлгеннен кейін адамдар жұмаққа немесе тозаққа жіберіледі.
Dialogue: 0,0:13:13.25,0:13:14.96,Default,,0,0,0,,Жұмақ пен тозақ...
Dialogue: 0,0:13:15.04,0:13:18.04,Default,,0,0,0,,Адамдарға елестету оңай болғандықтан осылай аталды.
Dialogue: 0,0:13:18.13,0:13:21.55,Default,,0,0,0,,Нақтырақ айтсақ, ол реинкарнация және жоқтық болып екіге бөлінеді.
Dialogue: 0,0:13:22.13,0:13:24.67,Default,,0,0,0,,Реинкарнация және... жоқтық?
Dialogue: 0,0:13:24.76,0:13:29.22,Default,,0,0,0,,Реинкарнация кезінде жан басқа адамда тұрады.
Dialogue: 0,0:13:30.22,0:13:35.73,Default,,0,0,0,,Ештеңеге құласаң, жаның жоғалып, терең қараңғылыққа түсесің...
Dialogue: 0,0:13:35.81,0:13:39.48,Default,,0,0,0,,Үкім шығарып, жанның қайда баратынын шешіңіз...
Dialogue: 0,0:13:39.56,0:13:42.78,Default,,0,0,0,,Иә, бұл арбитрдің рөлі.
Dialogue: 0,0:13:42.86,0:13:45.78,Default,,0,0,0,,Демек, бұл жандардың трибуналы.
Dialogue: 0,0:13:46.65,0:13:49.03,Default,,0,0,0,,Менің балам емес!
Dialogue: 0,0:13:49.74,0:13:52.28,Default,,0,0,0,,Сонымен... бұл кімнің баласы?
Dialogue: 0,0:13:52.37,0:13:56.04,Default,,0,0,0,,Бұл басқа біреу болуы керек!
Dialogue: 0,0:13:56.12,0:13:57.46,Default,,0,0,0,,Уф…
Dialogue: 0,0:13:57.54,0:13:59.42,Default,,0,0,0,,Такаши...
Dialogue: 0,0:14:14.10,0:14:15.43,Default,,0,0,0,,Мен уәде беремін
Dialogue: 0,0:14:16.27,0:14:17.94,Default,,0,0,0,,Мен сені міндетті түрде бақытты етемін
Dialogue: 0,0:14:18.60,0:14:21.69,Default,,0,0,0,,Мен сенің маған тұрмысқа шыққаныңды қалаймын
Dialogue: 0,0:14:23.57,0:14:26.69,Default,,0,0,0,,Цуки… Цуки…
Dialogue: 0,0:14:32.07,0:14:33.91,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:14:35.45,0:14:39.21,Default,,0,0,0,,Маған ұнайтын басқа адам бар.
Dialogue: 0,0:14:39.29,0:14:44.42,Default,,0,0,0,,Хэхехе ахахахха...
Dialogue: 0,0:14:44.50,0:14:46.17,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:14:46.26,0:14:49.43,Default,,0,0,0,,Сіздей адамды кім жақсы көреді деп ойлайсыз?
Dialogue: 0,0:14:50.51,0:14:52.43,Default,,0,0,0,,Сен ақымақ емессің бе?
Dialogue: 0,0:14:52.51,0:14:54.43,Default,,0,0,0,,Мұның бәрі ақшада, солай ма?
Dialogue: 0,0:14:55.06,0:14:59.31,Default,,0,0,0,,Сен... Мұның бәрі ойдан шығарылған нәрсе еді ғой!
Dialogue: 0,0:14:59.39,0:15:01.31,Default,,0,0,0,,Мұның бәрі өтірік!
Dialogue: 0,0:15:01.40,0:15:02.61,Default,,0,0,0,,Сіздің балаңыз!
Dialogue: 0,0:15:04.61,0:15:07.99,Default,,0,0,0,,Мына қарғыс атқан әйел...
Dialogue: 0,0:15:09.32,0:15:11.36,Default,,0,0,0,,Олай болса, қош келдіңіз.
Dialogue: 0,0:15:16.58,0:15:19.29,Default,,0,0,0,,(лифттің көтерілу және төмендеу дыбысы)
Dialogue: 0,0:15:23.17,0:15:24.88,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:15:24.96,0:15:26.80,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:28.09,0:15:29.30,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:15:29.92,0:15:31.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:31.76,0:15:33.09,Default,,0,0,0,,Ең нашар?
Dialogue: 0,0:15:34.39,0:15:35.97,Default,,0,0,0,,Оған тез үйреніп кетесіз
Dialogue: 0,0:15:38.18,0:15:40.06,Default,,0,0,0,,Соңында қайсысы қайда кетті?
Dialogue: 0,0:15:40.14,0:15:42.85,Default,,0,0,0,,Такашидің жанын реинкарнациялау
Dialogue: 0,0:15:42.94,0:15:44.56,Default,,0,0,0,,Мачико бос, солай емес пе?
Dialogue: 0,0:15:44.65,0:15:45.86,Default,,0,0,0,,Иә
Dialogue: 0,0:15:46.44,0:15:47.78,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:15:48.78,0:15:52.57,Default,,0,0,0,,Мм... маған бір нәрсе айтқым келеді.
Dialogue: 0,0:15:58.33,0:16:02.25,Default,,0,0,0,,Басқаша айтқанда... Мачиконың басқа серіктесі болды.
Dialogue: 0,0:16:02.33,0:16:03.54,Default,,0,0,0,,Иә
Dialogue: 0,0:16:04.88,0:16:07.04,Default,,0,0,0,,Қанағаттанбаушылық көрінісі
Dialogue: 0,0:16:08.09,0:16:12.05,Default,,0,0,0,,Бұл бір реттік қателік екеніне сенімдімін.
Dialogue: 0,0:16:18.89,0:16:21.06,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:16:22.48,0:16:23.31,Default,,0,0,0,,Түйсік
Dialogue: 0,0:16:25.98,0:16:27.40,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:16:27.48,0:16:29.32,Default,,0,0,0,,Мен кептеліп қалдым...
Dialogue: 0,0:16:30.94,0:16:34.86,Default,,0,0,0,,Менің ішімдегі бала Такашидің баласы деп ойлаймын.
Dialogue: 0,0:16:35.66,0:16:39.08,Default,,0,0,0,,Алайда адамның өзі басқаша айтқан...
Dialogue: 0,0:16:39.16,0:16:42.08,Default,,0,0,0,,Мачико-сан өте қайғылы көрінді.
Dialogue: 0,0:16:42.16,0:16:44.25,Default,,0,0,0,,Менің ойымша, сіз өтірік айтқан боларсыз.
Dialogue: 0,0:16:44.92,0:16:46.29,Default,,0,0,0,,Өтірік...
Dialogue: 0,0:16:46.38,0:16:49.25,Default,,0,0,0,,Бұл не үшін қажет болды?
Dialogue: 0,0:16:49.34,0:16:53.38,Default,,0,0,0,,Менің ойымша, ол Такашиді құтқару үшін өз баласын пайдаланды.
Dialogue: 0,0:16:53.47,0:16:56.01,Default,,0,0,0,,Қолдану...?
Dialogue: 0,0:16:56.09,0:16:59.93,Default,,0,0,0,,Өз баласын өлтірген адамның азабы
Dialogue: 0,0:17:00.01,0:17:02.02,Default,,0,0,0,,Аздап жеңілдету үшін.
Dialogue: 0,0:17:02.10,0:17:05.31,Default,,0,0,0,,Тіпті... Мені жек көретін болса да.
Dialogue: 0,0:17:09.90,0:17:12.78,Default,,0,0,0,,Мұның бәрі пьеса болды.
Dialogue: 0,0:17:12.86,0:17:14.53,Default,,0,0,0,,Субару, бірдеңе дұрыс емес пе?
Dialogue: 0,0:17:18.16,0:17:22.29,Default,,0,0,0,,Мен түсінбеймін. Ол әлдеқашан өлді, солай ма?
Dialogue: 0,0:17:23.79,0:17:26.92,Default,,0,0,0,,Менің ойымша, ол өлгендіктен.
Dialogue: 0,0:17:29.79,0:17:31.17,Default,,0,0,0,,Менің қиялым ғана
Dialogue: 0,0:17:31.71,0:17:34.59,Default,,0,0,0,,Шынымен қоштасатын уақыт келгенде
Dialogue: 0,0:17:34.67,0:17:38.18,Default,,0,0,0,,Менің ойымша, сіз өз сезімдеріңізге қамқорлық жасағыңыз келді.
Dialogue: 0,0:17:38.84,0:17:41.05,Default,,0,0,0,,Менің... сезімдерім?
Dialogue: 0,0:17:41.14,0:17:44.18,Default,,0,0,0,,Неге түсінбейсің? Сіз мені жақсы көретін сияқтысыз, солай ма?
Dialogue: 0,0:17:46.73,0:17:48.44,Default,,0,0,0,,Бұл махаббат деп аталады ма?
Dialogue: 0,0:17:51.86,0:17:52.69,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:17:52.78,0:17:56.49,Default,,0,0,0,,Рас, матч та жеңімпаз.
Dialogue: 0,0:17:56.57,0:17:59.57,Default,,0,0,0,,Сәйкестік пе? Сіз Мачико туралы айтып отырсыз ба?
Dialogue: 0,0:18:00.66,0:18:04.08,Default,,0,0,0,,Мен қате түсінбесем, әлгі екеуі...
Dialogue: 0,0:18:05.04,0:18:06.83,Default,,0,0,0,,Мен бақытты болуым керек еді...
Dialogue: 0,0:18:08.17,0:18:11.25,Default,,0,0,0,,Нона-сан, мүмкін мен...
Dialogue: 0,0:18:16.84,0:18:19.01,Default,,0,0,0,,Әр адам қателеседі
Dialogue: 0,0:18:19.09,0:18:24.01,Default,,0,0,0,,Алайда адамның эмоциясы кездейсоқ бет әлпетінде жиі кездеседі.
Dialogue: 0,0:18:24.10,0:18:26.77,Default,,0,0,0,,Сіз төреші болсаңыз да, оны оңай назардан тыс қалдырмаңыз.
Dialogue: 0,0:18:26.85,0:18:29.23,Default,,0,0,0,,Сондай-ақ… Кешіріңіз.
Dialogue: 0,0:18:29.85,0:18:32.31,Default,,0,0,0,,-(Нона) Ұмытпа -Иә
Dialogue: 0,0:18:32.40,0:18:34.32,Default,,0,0,0,,Жақсы! Содан кейін әдеттегідей
Dialogue: 0,0:18:34.40,0:18:35.78,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:18:52.13,0:18:53.63,Default,,0,0,0,,Бұл әдеттегідей ме?
Dialogue: 0,0:18:53.71,0:18:56.00,Default,,0,0,0,,Не? Бұл дәмді
Dialogue: 0,0:18:57.01,0:19:00.22,Default,,0,0,0,,әлі де ең жақсы
Dialogue: 0,0:19:04.60,0:19:07.06,Default,,0,0,0,,Өте дәмді
Dialogue: 0,0:19:07.77,0:19:09.56,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:11.65,0:19:13.02,Default,,0,0,0,,Бұл Деким.
Dialogue: 0,0:19:13.11,0:19:16.57,Default,,0,0,0,,Саке мен байсалды тамақ, менің жақсы білетін екі нәрсем осы.
Dialogue: 0,0:19:16.65,0:19:20.07,Default,,0,0,0,,Оның қимылы жоқ, хоббиі қуыршақ жасау.
Dialogue: 0,0:19:20.15,0:19:22.57,Default,,0,0,0,,Ха... білемін.
Dialogue: 0,0:19:25.91,0:19:27.58,Default,,0,0,0,,Олай болса, рахмет~
Dialogue: 0,0:19:28.29,0:19:29.83,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:19:31.79,0:19:35.21,Default,,0,0,0,,Хмм, оны сол күйінде қалдырыңыз.
Dialogue: 0,0:19:37.42,0:19:41.09,Default,,0,0,0,,(лифттің көтерілу және төмендеу дыбысы)
Dialogue: 0,0:19:43.72,0:19:45.10,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:19:45.18,0:19:46.81,Default,,0,0,0,,Өте орынды.
Dialogue: 0,0:19:46.89,0:19:47.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:48.64,0:19:49.85,Default,,0,0,0,,Не?
Dialogue: 0,0:19:51.35,0:19:53.85,Default,,0,0,0,,Маған тіл тигізбейтін сирек.
Dialogue: 0,0:19:59.03,0:20:00.61,Default,,0,0,0,,Бақыттысың ба?
Dialogue: 0,0:20:00.69,0:20:03.61,Default,,0,0,0,,Сәйкестік пе? Сіз Мачико туралы айтып отырсыз ба?
Dialogue: 0,0:20:04.82,0:20:07.12,Default,,0,0,0,,Бұл жай ғана түсінбеушілік емес.
Dialogue: 0,0:20:07.70,0:20:08.87,Default,,0,0,0,,(Келу қоңырауы)
Dialogue: 0,0:20:10.95,0:20:15.33,Default,,0,0,0,,Ол адам басқаларға сене алмайтын адам.
Dialogue: 0,0:20:15.42,0:20:18.92,Default,,0,0,0,,Бақытты болу мүмкін емес.
Dialogue: 0,0:20:22.51,0:20:25.34,Default,,0,0,0,,Өйткені, бұрынғыдан келген түзету
Dialogue: 0,0:20:25.43,0:20:26.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:27.26,0:20:28.64,Default,,0,0,0,,Әлі жоқ
Dialogue: 0,0:20:32.18,0:20:35.23,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:20:35.31,0:20:36.86,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:20:36.94,0:20:39.61,Default,,0,0,0,,Сондай-ақ, кешірім сұраймын.
Dialogue: 0,0:20:39.69,0:20:40.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:40.98,0:20:45.36,Default,,0,0,0,,Мен өз өмірін толық өткізген адамдарды құрметтеймін.
Dialogue: 0,0:20:45.45,0:20:48.91,Default,,0,0,0,,Бұл жолы... Мен төрелік ету құқығынан айырылдым.
Dialogue: 0,0:20:52.04,0:20:54.92,Default,,0,0,0,,Мен... кейінірек көремін.
Dialogue: 0,0:20:55.00,0:20:56.50,Default,,0,0,0,,(Танжиро) Толық шоғырланған тыныс алуды сақтай отырып жаттығу енді екінші табиғатқа айнала бастады.
Dialogue: 0,0:20:58.00,0:21:00.67,Default,,0,0,0,,Бұл... Маған тағы да толтырыңыз.
Dialogue: 0,0:21:02.67,0:21:03.88,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:21:10.97,0:21:15.98,Default,,0,0,0,,♪~
Dialogue: 0,0:22:17.08,0:22:20.88,Default,,0,0,0,,~♪
Dialogue: 0,0:22:24.50,0:22:25.92,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:22:26.55,0:22:28.43,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:28.51,0:22:30.51,Default,,0,0,0,,Егер сіз бұрыннан білсеңіз
Dialogue: 0,0:22:30.59,0:22:32.72,Default,,0,0,0,,Тапсыру мерзімі – 3 ай.
Dialogue: 0,0:22:34.22,0:22:40.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory