Dialogue: 3,1:49:35.14,1:49:41.30,IN_Freyja_JP2,,0,0,0,,Жарық теңізінің арғы жағында
Dialogue: 3,1:49:41.30,1:49:47.06,IN_Freyja_JP2,,0,0,0,,Дұға әнін айту
Dialogue: 3,1:49:47.06,1:49:53.32,IN_Freyja_JP2,,0,0,0,,Өміріме жетуге деген ұмтылыс өртенеді
Dialogue: 3,1:49:53.32,1:49:58.21,IN_Freyja_JP2,,0,0,0,,Дүниеге келу қуанышын ойнайық
Dialogue: 3,1:49:58.21,1:50:02.56,IN_Freyja_JP2,,0,0,0,,--Мен сені сүйемін
Dialogue: 3,1:50:09.18,1:50:14.84,IN_Mikumo_JP2,,0,0,0,,Аспанда қалықтаған сөздер алмасады
Dialogue: 3,1:50:15.06,1:50:19.26,IN_Mikumo_JP2,,0,0,0,,Әуенді гуілдету
Dialogue: 3,1:50:20.87,1:50:26.70,IN_Mikumo_JP2,,0,0,0,,Менің ішімде
Dialogue: 3,1:50:26.70,1:50:30.60,IN_Mikumo_JP2,,0,0,0,,Ақырында галактикаға айналады
Dialogue: 3,1:50:31.18,1:50:36.75,IN_Freyja_JP2,,0,0,0,,Қуаныш та, қайғы да
Dialogue: 3,1:50:37.01,1:50:42.74,IN_Freyja_JP2,,0,0,0,,Тыныс алудың толықтығы
Dialogue: 3,1:50:42.74,1:50:48.31,IN_Freyja_JP2,,0,0,0,,Тікелей эфирдегі шоу сияқты
Dialogue: 3,1:50:48.31,1:50:54.52,IN_Freyja_JP2,,0,0,0,,Мені үлкен сандықта ұстап отыр
Dialogue: 3,1:50:54.52,1:51:00.18,IN_Freyja_JP2,,0,0,0,,Нәзік арман жаңғырсын
Dialogue: 3,1:51:00.38,1:51:06.57,IN_Freyja_JP2,,0,0,0,,Махаббатқа толы дене жанады
Dialogue: 3,1:51:06.57,1:51:19.16,IN_Mikumo_JP2,,0,0,0,,Жаңа болашаққа жылулық сену
Dialogue: 3,1:51:38.04,1:51:44.01,IN_Freyja_JP2,,0,0,0,,Жарық теңізінің арғы жағында
Dialogue: 3,1:51:44.34,1:51:50.02,IN_Freyja_JP2,,0,0,0,,Дұға жырын айтайық
Dialogue: 3,1:51:50.20,1:51:55.77,IN_Freyja_JP2,,0,0,0,,Менің өмірім соған жетуге деген ұмтылыспен жанады.
Dialogue: 3,1:51:56.06,1:51:56.52,IN_Freyja_JP2,,0,0,0,,Өмір сүру...
Dialogue: 3,1:53:06.56,1:53:12.40,IN_Freyja_JP2,,0,0,0,,Маған нәзік түс естуге рұқсат етіңіз
Dialogue: 3,1:53:12.40,1:53:18.35,IN_Freyja_JP2,,0,0,0,,Махаббатқа толы дене жанады
Dialogue: 3,1:53:18.69,1:53:27.49,IN_Freyja_JP2,,0,0,0,,Жаңа болашаққа жылулық сеніп тапсыру
Dialogue: 3,1:53:29.54,1:53:38.39,IN_Freyja_JP2,,0,0,0,,--Мен сені шын жүрегіммен жақсы көремін.
Dialogue: 1,1:48:50.18,1:48:52.77,IN_Freyja_CN2,,0,0,0,,«Көк жеміс
Dialogue: 1,1:48:53.07,1:48:55.74,IN_Freyja_CN2,,0,0,0,,Өзара махаббат, екі адам
Dialogue: 1,1:48:56.05,1:49:00.21,IN_Freyja_CN2,,0,0,0,,Менің жүрегім аюдың отында».
Dialogue: 1,1:49:04.73,1:49:10.52,IN_Freyja_CN2,,0,0,0,,Алыстан естеліктер
Dialogue: 1,1:49:10.52,1:49:14.39,IN_Freyja_CN2,,0,0,0,,Жектікке толы ән салған дауыс
Dialogue: 1,1:49:17.92,1:49:23.54,IN_Freyja_CN2,,0,0,0,,Сараңдық жолы, шығу жолы
Dialogue: 1,1:49:23.85,1:49:29.54,IN_Freyja_CN2,,0,0,0,,Бұрын-соңды болмаған күдіктер
Dialogue: 1,1:49:29.54,1:49:35.14,IN_Freyja_CN2,,0,0,0,,Себебі мен бақыттымын
Dialogue: 1,1:49:35.14,1:49:41.30,IN_Freyja_CN2,,0,0,0,,Жарық теңізінің жағалауы
Dialogue: 1,1:49:41.30,1:49:47.06,IN_Freyja_CN2,,0,0,0,,Музыка тыңдауға арналған дұға әні
Dialogue: 1,1:49:47.06,1:49:53.32,IN_Freyja_CN2,,0,0,0,,Дезирдің арманы Жарқыраған өмір
Dialogue: 1,1:49:53.32,1:49:58.21,IN_Freyja_CN2,,0,0,0,,Әннің әні
Dialogue: 1,1:49:58.21,1:50:02.56,IN_Freyja_CN2,,0,0,0,,—— саған деген терең махаббат
Dialogue: 1,1:50:09.18,1:50:14.84,IN_Mikumo_CN2,,0,0,0,,Біз әрекеттесетін сөздер, қалқымалы ауа
Dialogue: 1,1:50:15.06,1:50:19.26,IN_Mikumo_CN2,,0,0,0,,Әннің әуені
Dialogue: 1,1:50:20.87,1:50:26.70,IN_Mikumo_CN2,,0,0,0,,Сол кеудем жүрегімде терең.
Dialogue: 1,1:50:26.70,1:50:30.60,IN_Mikumo_CN2,,0,0,0,,Гинга өзені Масару
Dialogue: 1,1:50:31.18,1:50:36.75,IN_Freyja_CN2,,0,0,0,,Қуанышты және қайғылы жағдайлар
Dialogue: 1,1:50:37.01,1:50:42.74,IN_Freyja_CN2,,0,0,0,,Жас жүректерге жалпы шақыру
Dialogue: 1,1:50:42.74,1:50:48.31,IN_Freyja_CN2,,0,0,0,,Nyoichijo Life поэзия қоғамына
Dialogue: 1,1:50:48.31,1:50:54.52,IN_Freyja_CN2,,0,0,0,,Жүрегіңнің жылы да икемді арманы
Dialogue: 1,1:50:54.52,1:51:00.18,IN_Freyja_CN2,,0,0,0,,Сыйымдылық
Dialogue: 1,1:51:00.38,1:51:06.57,IN_Freyja_CN2,,0,0,0,,Махаббаттың тұла бойы жанған
Dialogue: 1,1:51:06.57,1:51:19.16,IN_Mikumo_CN2,,0,0,0,,Жылы және жаңа болашақ
Dialogue: 1,1:51:38.04,1:51:44.01,IN_Freyja_CN2,,0,0,0,,Жарық теңізінің жағалауы
Dialogue: 1,1:51:44.34,1:51:50.02,IN_Freyja_CN2,,0,0,0,,Дұға әні
Dialogue: 1,1:51:50.20,1:51:55.77,IN_Freyja_CN2,,0,0,0,,Дезирдің арманы Жарқыраған өмір
Dialogue: 1,1:51:56.06,1:51:56.52,IN_Freyja_CN2,,0,0,0,,Тірі қалу…
Dialogue: 1,1:53:06.56,1:53:12.40,IN_Freyja_CN2,,0,0,0,,Сыйымдылық
Dialogue: 1,1:53:12.40,1:53:18.35,IN_Freyja_CN2,,0,0,0,,Махаббаттың толық денесі
Dialogue: 1,1:53:18.69,1:53:27.49,IN_Freyja_CN2,,0,0,0,,Жаңа, жылы болашақ
Dialogue: 1,1:53:29.54,1:53:38.39,IN_Freyja_CN2,,0,0,0,,——Мен саған қатты ғашықпын
Dialogue: 3,1:58:06.42,1:58:15.03,IN_Freyja_JP,,0,0,0,,Шөлдеген еріннен
Dialogue: 3,1:58:16.06,1:58:24.90,IN_Freyja_JP,,0,0,0,,Төгілген сөздер көкке ериді
Dialogue: 3,1:58:30.12,1:58:41.08,IN_Freyja_JP,,0,0,0,,Менің жыртылған қабығымды ал
Dialogue: 3,1:58:42.35,1:58:49.30,IN_Freyja_JP,,0,0,0,,Даусыңды естігім келеді
Dialogue: 3,1:58:51.28,1:58:57.04,IN_Freyja_JP,,0,0,0,,Кеңейіп жатқан аспанға қарасаң
Dialogue: 3,1:58:57.37,1:59:04.52,IN_Freyja_JP,,0,0,0,,Менің аяғым тағы дірілдеп тұр
Dialogue: 3,1:59:05.00,1:59:10.59,IN_Freyja_JP,,0,0,0,,Осы әлемге
Dialogue: 3,1:59:10.87,1:59:16.53,IN_Freyja_JP,,0,0,0,,Оның мағынасы бар екеніне сенгім келеді
Dialogue: 3,1:59:17.02,1:59:22.14,IN_Freyja_JP,,0,0,0,,Бір дірілдеген жүрек
Dialogue: 3,1:59:22.14,1:59:28.57,IN_Freyja_JP,,0,0,0,,Тасымалдау кезінде саяхат жалғасады
Dialogue: 3,1:59:29.04,1:59:34.14,IN_Freyja_JP,,0,0,0,,Жоғалған жүрек - бұл
Dialogue: 3,1:59:34.14,1:59:41.06,IN_Freyja_JP,,0,0,0,,Мен бүгін де тірімін, бұл дәлел.
Dialogue: 3,2:00:26.32,2:00:29.97,ED_JP,,0,0,0,,Бұл өзімшілдік пе? Бұл дегеніміз?
Dialogue: 3,2:00:29.97,2:00:33.17,ED_JP,,0,0,0,,Мен оны жоғалтқым келмейді
Dialogue: 3,2:00:33.53,2:00:36.63,ED_JP,,0,0,0,,Уақыт бірте-бірте өтіп жатыр
Dialogue: 3,2:00:36.63,2:00:40.43,ED_JP,,0,0,0,,Жоқ
Dialogue: 3,2:00:40.89,2:00:44.40,ED_JP,,0,0,0,,Осындай кезде басыңызды көтеріңіз
Dialogue: 3,2:00:44.40,2:00:48.06,ED_JP,,0,0,0,,Бізде алға жылжудан басқа амал жоқ, солай ма?
Dialogue: 3,2:00:48.06,2:00:51.50,ED_JP,,0,0,0,,Мен дайынмын.
Dialogue: 3,2:00:51.50,2:00:53.41,ED_JP,,0,0,0,,Таза және ақылсыз БАЛА
Dialogue: 3,2:00:53.41,2:00:55.25,ED_JP,,0,0,0,,Тәкаппар, тіл алғыш БАЛА
Dialogue: 3,2:00:55.25,2:00:56.76,ED_JP,,0,0,0,,Бұл тыйым салынған алма ма?
Dialogue: 3,2:00:56.76,2:00:58.82,ED_JP,,0,0,0,,Барлығы иә
Dialogue: 3,2:00:58.82,2:01:00.57,ED_JP,,0,0,0,,Мені батыл құшақтап алсаң болды
Dialogue: 3,2:01:00.57,2:01:02.27,ED_JP,,0,0,0,,Ең жақсы аяқталу жақсы
Dialogue: 3,2:01:02.27,2:01:05.67,ED_JP,,0,0,0,,121 2 3 GO
Dialogue: 3,2:01:05.87,2:01:09.47,ED_JP,,0,0,0,,ТЫЙЫМ БАН BA BA BA BAN
Dialogue: 3,2:01:09.47,2:01:12.62,ED_JP,,0,0,0,,Кейбір махаббат гүлдейді
Dialogue: 3,2:01:13.17,2:01:17.03,ED_JP,,0,0,0,,Егер нөсер жаңбыр болса, тұтас жұлдыз
Dialogue: 3,2:01:17.03,2:01:20.18,ED_JP,,0,0,0,,Мені құшақтап ал уау уау уау
Dialogue: 3,2:01:20.46,2:01:24.01,ED_JP,,0,0,0,,ТЫЙЫМ BA BA BA ТЫЙЫМ
Dialogue: 3,2:01:24.01,2:01:27.68,ED_JP,,0,0,0,,Көңілді өсірейік, гүлдейміз
Dialogue: 3,2:01:27.68,2:01:32.81,ED_JP,,0,0,0,,Өзіңді сезіну
Dialogue: 3,2:01:40.46,2:01:42.35,ED_JP,,0,0,0,,БАН ТЫЙЫМ
Dialogue: 3,2:01:44.06,2:01:45.99,ED_JP,,0,0,0,,БАН ТЫЙЫМ
Dialogue: 3,2:01:47.72,2:01:49.69,ED_JP,,0,0,0,,БАН ТЫЙЫМ
Dialogue: 3,2:01:51.29,2:01:54.88,ED_JP,,0,0,0,,Майури сенімен сөйлесіп, қамқорлық көрсеткісі келіп жатқанын байқамайсың ба?
Dialogue: 3,2:01:54.88,2:01:58.51,ED_JP,,0,0,0,,ТЫЙЫМ BA BA BA ТЫЙЫМ
Dialogue: 3,2:01:58.51,2:02:01.91,ED_JP,,0,0,0,,Кейбір махаббат гүлдейді
Dialogue: 3,2:02:02.30,2:02:06.11,ED_JP,,0,0,0,,Түс болса да бір күні оянамын
Dialogue: 3,2:02:06.11,2:02:09.29,ED_JP,,0,0,0,,Маған бәрібір, мен сені сүйемін
Dialogue: 3,2:02:09.54,2:02:13.09,ED_JP,,0,0,0,,ТЫЙЫМ BA BA BA ТЫЙЫМ
Dialogue: 3,2:02:13.09,2:02:16.81,ED_JP,,0,0,0,,Келешекте гүлдей берсін
Dialogue: 3,2:02:16.81,2:02:20.37,ED_JP,,0,0,0,,Біз қайтадан кездескенше
Dialogue: 3,2:02:20.37,2:02:23.86,ED_JP,,0,0,0,,БАН БАН БА БА БА БАН Лумпика!
Dialogue: 3,2:02:27.70,2:02:31.07,ED_JP,,0,0,0,,БАН БАН БА БА БА БАН Лумпика!
Dialogue: 3,2:02:34.98,2:02:38.14,ED_JP,,0,0,0,,БАН БАН БА БА БА БАН Лумпика!
Dialogue: 1,1:45:11.08,1:45:13.54,Screen,,0,0,0,,Әскери күштердің бірігуі
Dialogue: 0,1:45:11.08,1:45:13.54,Screen,,0,0,0,,Әскери күштердің бірігуі
Dialogue: 0,1:45:11.08,1:45:13.54,Screen,,0,0,0,,Болат темір менің кумирім
Dialogue: 0,1:45:11.08,1:45:13.54,Screen,,0,0,0,,…Якай тез ұшады!
