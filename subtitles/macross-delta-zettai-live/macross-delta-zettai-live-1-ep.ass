Dialogue: 3,0:14:12.50,0:14:17.84,IN_YamiQRay_JP,,0,0,0,,Жарқыраған көздер, Қараңғы жаққа түсіп
Dialogue: 3,0:14:17.84,0:14:20.98,IN_YamiQRay_JP,,0,0,0,,Мен қайта орала алмаймын
Dialogue: 3,0:14:20.98,0:14:24.10,IN_YamiQRay_JP,,0,0,0,,Жою жолы
Dialogue: 3,0:14:24.10,0:14:33.21,IN_YamiQRay_JP,,0,0,0,,Ай сәулесі мені осы әуенге жетелейді
Dialogue: 3,0:14:33.90,0:14:36.79,IN_YamiQRay_JP,,0,0,0,,Музыка әлемі
Dialogue: 3,0:14:37.08,0:14:41.29,IN_YamiQRay_JP,,0,0,0,,Не болып жатқанын тыныш көру үшін күтіңіз
Dialogue: 3,0:14:41.29,0:14:43.79,IN_YamiQRay_JP,,0,0,0,,Жою сынағы
Dialogue: 3,0:14:43.79,0:14:45.50,IN_YamiQRay_JP,,0,0,0,,Сондықтан артқа қарамаңыз
Dialogue: 3,0:14:45.50,0:14:49.43,IN_YamiQRay_JP,,0,0,0,,Революция және тұншығу
Dialogue: 3,0:14:49.43,0:14:53.44,IN_YamiQRay_JP,,0,0,0,,Ішіңізде, әзірге жол жоқ
Dialogue: 3,0:14:53.44,0:14:56.26,IN_YamiQRay_JP,,0,0,0,,Оянатын уақытты күту
Dialogue: 3,0:14:56.26,0:14:59.95,IN_YamiQRay_JP,,0,0,0,,Тыныш, тыныш...
Dialogue: 3,0:14:59.95,0:15:02.16,IN_YamiQRay_JP,,0,0,0,,Шалқуға дайын болу керек.
Dialogue: 3,0:15:02.16,0:15:03.11,IN_YamiQRay_JP,,0,0,0,,Мүмкін…
Dialogue: 3,0:15:03.11,0:15:05.46,IN_YamiQRay_JP,,0,0,0,,Тек сіз ғана аласыз, тек сіз аласыз
Dialogue: 3,0:15:05.46,0:15:06.27,IN_YamiQRay_JP,,0,0,0,,мені шайқаңыз
Dialogue: 3,0:15:06.27,0:15:08.86,IN_YamiQRay_JP,,0,0,0,,Сенің қолыңнан келетінін білемін, қолыңнан келетінін білемін
Dialogue: 3,0:15:09.45,0:15:11.90,IN_YamiQRay_JP,,0,0,0,,Тек сіз ғана аласыз, тек сіз аласыз
Dialogue: 3,0:15:11.90,0:15:12.70,IN_YamiQRay_JP,,0,0,0,,мені шайқаңыз
Dialogue: 3,0:15:12.70,0:15:15.84,IN_YamiQRay_JP,,0,0,0,,Қараңғылыққа, қараңғылыққа
Dialogue: 3,0:15:15.84,0:15:19.27,IN_YamiQRay_JP,,0,0,0,,Тербелуге дайын болыңыз!
Dialogue: 3,0:15:19.27,0:15:22.07,IN_YamiQRay_JP,,0,0,0,,Қираудың кері санағы Иә!
Dialogue: 3,0:15:22.07,0:15:25.50,IN_YamiQRay_JP,,0,0,0,,Тербелуге дайын болыңыз!
Dialogue: 3,0:15:25.50,0:15:28.88,IN_YamiQRay_JP,,0,0,0,,Қазір босатыңыз
Dialogue: 3,0:15:28.88,0:15:31.05,IN_YamiQRay_JP,,0,0,0,,Мен шайқауға дайын боламын
Dialogue: 3,0:15:32.64,0:15:34.37,IN_YamiQRay_JP,,0,0,0,,Сізге
Dialogue: 3,0:15:34.84,0:15:37.60,IN_YamiQRay_JP,,0,0,0,,Мен шайқауға дайын боламын
Dialogue: 3,0:15:38.41,0:15:43.53,IN_YamiQRay_JP2,,0,0,0,,Дайын болыңыз, шайқауға дайын болыңыз!
Dialogue: 2,0:15:38.41,0:15:43.53,IN_YamiQRay_CN2,,0,0,0,,Тадамачи Киокё Тадамачи Киокио
Dialogue: 3,0:19:27.97,0:19:33.49,IN_Freyja_JP,,0,0,0,,Қаңғып жүрген мұз бетінде
Dialogue: 3,0:19:33.86,0:19:38.82,IN_Freyja_JP,,0,0,0,,Құпия жасырылды
Dialogue: 3,0:19:39.53,0:19:45.36,IN_Mikumo_JP,,0,0,0,,Керемет кездейсоқтықтан
Dialogue: 3,0:19:45.36,0:19:51.61,IN_Mikumo_JP,,0,0,0,,Мен сені кездестірдім, Каринжи Ашиме.
Dialogue: 3,0:19:51.61,0:19:54.64,IN_Makina_JP,,0,0,0,,Бейбітшіліктің ортасында, келе жатыр
Dialogue: 3,0:19:54.64,0:19:57.88,IN_Reina_JP,,0,0,0,,Супер қату нүктесі енді 108 өзгереді
Dialogue: 3,0:19:57.88,0:20:03.18,IN_Kaname_JP,,0,0,0,,Менің еріндерім ысып, еріп кеткендей
Dialogue: 3,0:20:03.18,0:20:06.23,IN_Freyja_JP,,0,0,0,,Толық балқытылған және аяқталған
Dialogue: 3,0:20:06.23,0:20:09.53,IN_Mikumo_JP,,0,0,0,,Мен бұл құштарлықты ғана білмеймін
Dialogue: 3,0:20:09.53,0:20:14.08,IN_Kaname_JP,,0,0,0,,Қайталаңыз және жіберіңіз
Dialogue: 3,0:20:14.08,0:20:20.24,IN_Mikumo_JP,,0,0,0,,Бірін-бірі тартқысы келген жазықсыз жауған қарға қолым тиді.
Dialogue: 3,0:20:20.24,0:20:25.91,IN_Mikumo_JP,,0,0,0,,Ойым әбігерге түседі, Айналып кеттім
Dialogue: 3,0:20:25.91,0:20:32.69,IN_Mikumo_JP,,0,0,0,,Резервсіз өмір Сен және Мен шегіне дейін
Dialogue: 3,0:20:32.69,0:20:36.89,IN_Mikumo_JP,,0,0,0,,қабылдаңыз.
Dialogue: 3,0:20:36.89,0:20:41.21,IN_Mikumo_JP,,0,0,0,,Мені қазір сүй
Dialogue: 3,0:20:49.47,0:20:55.16,IN_Makina_JP,,0,0,0,,Қараңдаршы, күміс дүние қайтып келді.
Dialogue: 3,0:20:55.16,0:21:01.20,IN_Reina_JP,,0,0,0,,Тыныштықтың әлсіз дыбысы
Dialogue: 3,0:21:01.60,0:21:06.81,IN_Makina_JP,,0,0,0,,Бұрынғы эмоцияларыңызды босатыңыз
Dialogue: 3,0:21:06.81,0:21:09.88,IN_Mikumo_JP,,0,0,0,,ән айту ән айту
Dialogue: 3,0:21:13.83,0:21:19.90,IN_Mikumo_JP,,0,0,0,,Осы шексіз галактикада мен ғашық болдым
Dialogue: 3,0:21:19.90,0:21:25.72,IN_Freyja_JP,,0,0,0,,Толқыған сезім шашыраңқы
Dialogue: 3,0:21:25.72,0:21:32.32,IN_Kaname_JP,,0,0,0,,Бейкүнә инстинкттердің әсерінен қабаттасу
Dialogue: 3,0:21:32.32,0:21:36.19,IN_Kaname_JP,,0,0,0,,Оны әлі алып кетпеңіз
Dialogue: 3,0:21:37.10,0:21:43.13,IN_Freyja_JP,,0,0,0,,Бірін-бірі тартқысы келген жазықсыз жауған қарға қолым тиді.
Dialogue: 3,0:21:43.13,0:21:48.35,IN_Freyja_JP,,0,0,0,,Ойым әбігерге түседі, Айналып кеттім
Dialogue: 3,0:21:48.93,0:21:55.31,IN_Mikumo_JP,,0,0,0,,Резервсіз өмір Сен және Мен шегіне дейін
Dialogue: 3,0:21:55.69,0:21:59.83,IN_Mikumo_JP,,0,0,0,,Оны қабылдаңыз.
Dialogue: 3,0:21:59.83,0:22:05.77,IN_Mikumo_JP,,0,0,0,,Мені қазір сүй
Dialogue: 3,0:33:49.32,0:33:52.25,IN_Freyja_JP,,0,0,0,,Бір Аоими
Dialogue: 3,0:33:52.55,0:33:55.50,IN_Freyja_JP,,0,0,0,,Екіден жүгіру
Dialogue: 3,0:33:55.93,0:34:00.19,IN_Freyja_JP,,0,0,0,,Жүрегім өртеніп барады
Dialogue: 3,0:34:02.52,0:34:05.43,IN_Freyja_JP,,0,0,0,,Юбикири Мицу
Dialogue: 3,0:34:05.79,0:34:08.65,IN_Freyja_JP,,0,0,0,,Бөлінген
Dialogue: 3,0:34:09.07,0:34:13.26,IN_Freyja_JP,,0,0,0,,...
Dialogue: 3,0:34:14.30,0:34:20.78,IN_Freyja_JP,,0,0,0,,Хошимо Канаши Каруте
Dialogue: 3,0:34:21.10,0:34:27.47,IN_Freyja_JP,,0,0,0,,Төгілу және құлау
Dialogue: 3,0:34:27.77,0:34:35.20,IN_Freyja_JP,,0,0,0,,Өмір сүре алмайтындар туралы ойлау
Dialogue: 3,0:34:37.11,0:34:44.18,IN_Freyja_JP,,0,0,0,,Жарық теңізінің арғы жағында
Dialogue: 3,0:34:44.18,0:34:50.95,IN_Freyja_JP,,0,0,0,,Шаттық әнін алып жүрейік
Dialogue: 3,0:34:50.95,0:34:57.87,IN_Freyja_JP,,0,0,0,,Қызыл алма Кішкентай алма
Dialogue: 3,0:34:57.87,0:35:01.33,IN_Freyja_JP,,0,0,0,,Түрлі-түсті бақыт
Dialogue: 3,0:35:01.33,0:35:07.96,IN_Freyja_JP,,0,0,0,,Бір-бірден сана
Dialogue: 3,0:35:07.96,0:35:16.57,IN_Freyja_JP,,0,0,0,,Бір-бірімізбен кездесуге барайық
Dialogue: 3,0:36:31.69,0:36:36.38,IN_YamiQRay_JP,,0,0,0,,Жарқыраған көздер, Қараңғы жаққа түсіп
Dialogue: 3,0:36:36.38,0:36:39.55,IN_YamiQRay_JP,,0,0,0,,Мен қайта орала алмаймын
Dialogue: 3,0:36:39.55,0:36:42.77,IN_YamiQRay_JP,,0,0,0,,Жою жолы
Dialogue: 3,0:36:42.77,0:36:51.80,IN_YamiQRay_JP,,0,0,0,,Ай сәулесі мені осы әуенге жетелейді
Dialogue: 3,0:36:52.33,0:36:55.38,IN_YamiQRay_JP,,0,0,0,,Музыка әлемі
Dialogue: 3,0:36:55.38,0:36:59.76,IN_YamiQRay_JP,,0,0,0,,Не болып жатқанын тыныш көру үшін күтіңіз
Dialogue: 3,0:36:59.76,0:37:02.38,IN_YamiQRay_JP,,0,0,0,,Жою сынағы
Dialogue: 3,0:37:02.38,0:37:04.22,IN_YamiQRay_JP,,0,0,0,,Сондықтан артқа қарамаңыз
Dialogue: 3,0:37:04.22,0:37:08.00,IN_YamiQRay_JP,,0,0,0,,Революция және тұншығу
Dialogue: 3,0:37:08.00,0:37:12.19,IN_YamiQRay_JP,,0,0,0,,Ішіңізде, әзірге жол жоқ
Dialogue: 3,0:37:12.19,0:37:14.82,IN_YamiQRay_JP,,0,0,0,,Оянатын уақытты күту
Dialogue: 3,0:37:14.82,0:37:18.55,IN_YamiQRay_JP,,0,0,0,,Тыныш, тыныш...
Dialogue: 3,0:37:18.55,0:37:20.49,IN_YamiQRay_JP,,0,0,0,,Шалқуға дайын болу керек.
Dialogue: 3,0:37:20.79,0:37:21.66,IN_YamiQRay_JP,,0,0,0,,Мүмкін…
Dialogue: 3,0:37:21.66,0:37:24.11,IN_YamiQRay_JP,,0,0,0,,Тек сіз ғана аласыз, тек сіз аласыз
Dialogue: 3,0:37:24.11,0:37:24.79,IN_YamiQRay_JP,,0,0,0,,мені шайқаңыз
Dialogue: 3,0:37:24.79,0:37:27.30,IN_YamiQRay_JP,,0,0,0,,Сенің қолыңнан келетінін білемін, қолыңнан келетінін білемін
Dialogue: 3,0:37:28.01,0:37:30.51,IN_YamiQRay_JP,,0,0,0,,Тек сіз ғана аласыз, тек сіз аласыз
Dialogue: 3,0:37:30.51,0:37:31.26,IN_YamiQRay_JP,,0,0,0,,мені шайқаңыз
Dialogue: 3,0:37:31.26,0:37:34.36,IN_YamiQRay_JP,,0,0,0,,Қараңғылыққа, қараңғылыққа
Dialogue: 3,0:37:34.36,0:37:37.80,IN_YamiQRay_JP,,0,0,0,,Тербелуге дайын болыңыз!
Dialogue: 3,0:37:37.80,0:37:40.82,IN_YamiQRay_JP,,0,0,0,,Қираудың кері санағы Иә!
Dialogue: 3,0:37:40.82,0:37:44.17,IN_YamiQRay_JP,,0,0,0,,Тербелуге дайын болыңыз!
Dialogue: 3,0:37:44.17,0:37:47.47,IN_YamiQRay_JP,,0,0,0,,Қазір босатыңыз
Dialogue: 3,0:37:47.47,0:37:49.85,IN_YamiQRay_JP,,0,0,0,,Мен шайқауға дайын боламын
Dialogue: 3,0:37:51.19,0:37:52.62,IN_YamiQRay_JP,,0,0,0,,Сізге
Dialogue: 3,0:37:54.21,0:37:55.60,IN_YamiQRay_JP,,0,0,0,,Мен шайқауға дайын боламын
Dialogue: 3,0:37:56.85,0:38:01.76,IN_YamiQRay_JP,,0,0,0,,Дайын болыңыз, шайқауға дайын болыңыз!
Dialogue: 3,0:38:15.23,0:38:17.51,IN_YamiQRay_JP,,0,0,0,,Иә, барлығына, қазір шоу уақыты
Dialogue: 3,0:38:17.51,0:38:19.21,IN_YamiQRay_JP,,0,0,0,,Әй, қазір жүр
Dialogue: 3,0:38:19.21,0:38:21.75,IN_YamiQRay_JP,,0,0,0,,Тасты жою үшін! Рок!
Dialogue: 3,0:38:21.75,0:38:24.13,IN_YamiQRay_JP,,0,0,0,,Иә, кез келген уақытта жай ғана салқын болыңыз,
Dialogue: 3,0:38:24.13,0:38:25.86,IN_YamiQRay_JP,,0,0,0,,Мен білемін, мүмкін сіз дұрыс шығарсыз
Dialogue: 3,0:38:25.86,0:38:28.48,IN_YamiQRay_JP,,0,0,0,,Мен…Жоқ Жоқ Жоқ Жоқ!
Dialogue: 3,0:38:28.48,0:38:30.65,IN_YamiQRay_JP,,0,0,0,,На на на на, не айтасың деп айт
Dialogue: 3,0:38:30.65,0:38:34.83,IN_YamiQRay_JP,,0,0,0,,Мен сені менікі қыламын, На! На! На! На!
Dialogue: 3,0:38:35.09,0:38:36.00,IN_YamiQRay_JP,,0,0,0,,Сен жындысың ба?
Dialogue: 3,0:38:36.00,0:38:37.50,IN_YamiQRay_JP,,0,0,0,,Сізді ешқашан жібермеңіз
Dialogue: 3,0:38:37.50,0:38:40.73,IN_YamiQRay_JP,,0,0,0,,Сіз оны құрбандықпен алдыңыз, ешқашан білмейсіз
Dialogue: 3,0:38:40.73,0:38:43.28,IN_YamiQRay_JP,,0,0,0,,Иә, білемін, білемін
Dialogue: 3,0:38:43.28,0:38:44.93,IN_YamiQRay_JP,,0,0,0,,Не болып жатыр?
Dialogue: 3,0:38:44.93,0:38:45.64,IN_YamiQRay_JP,,0,0,0,,Дұрыс айтасыз
Dialogue: 3,0:38:45.64,0:38:51.19,IN_YamiQRay_JP,,0,0,0,,Ақылсыз, бұзыңыз, бұзыңыз, бұзыңыз
Dialogue: 3,0:38:51.19,0:38:52.80,IN_YamiQRay_JP,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 3,0:38:52.80,0:38:55.07,IN_YamiQRay_JP,,0,0,0,,Мүмкін, мүмкін... О!
Dialogue: 3,0:38:55.07,0:38:57.53,IN_YamiQRay_JP,,0,0,0,,Тек оны шындыққа айналдырыңыз
Dialogue: 3,0:38:57.53,0:39:00.12,IN_YamiQRay_JP,,0,0,0,,Жынды, жынды, шық!
Dialogue: 3,0:39:00.12,0:39:01.32,IN_YamiQRay_JP,,0,0,0,,Сіз не айтасыз?
Dialogue: 3,0:39:01.80,0:39:03.91,IN_YamiQRay_JP,,0,0,0,,Мен сенің не қалайтыныңды білемін
Dialogue: 3,0:39:03.91,0:39:07.09,IN_YamiQRay_JP,,0,0,0,,Жалғызсың, мені биікке көтер
Dialogue: 3,0:39:07.09,0:39:11.05,IN_YamiQRay_JP,,0,0,0,,Айтшы, қараңғылық, қараңғылық деген не?
Dialogue: 3,0:39:11.05,0:39:13.58,IN_YamiQRay_JP,,0,0,0,,Амал жоқ, айтайын
Dialogue: 3,0:39:13.77,0:39:19.43,IN_YamiQRay_JP,,0,0,0,,О! О! Маған жол көрсетші, амал жоқ, жол жоқ
