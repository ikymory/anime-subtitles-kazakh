Dialogue: 3,1:04:09.28,1:04:12.24,IN_Mikumo_JP,,0,0,0,,Анчикушо Анчикушо
Dialogue: 3,1:04:12.24,1:04:15.08,IN_Mikumo_JP,,0,0,0,,Бір жерде жоғалып кетіңізші.
Dialogue: 3,1:04:15.08,1:04:18.21,IN_Mikumo_JP,,0,0,0,,Арман ұры Уау
Dialogue: 3,1:14:08.11,1:14:09.63,IN_YamiQRay_JP2,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 3,1:14:09.63,1:14:11.92,IN_YamiQRay_JP2,,0,0,0,,Мүмкін, мүмкін... О!
Dialogue: 3,1:14:11.92,1:14:13.99,IN_YamiQRay_JP2,,0,0,0,,Тек оны шындыққа айналдырыңыз
Dialogue: 3,1:14:14.46,1:14:17.15,IN_YamiQRay_JP2,,0,0,0,,Жынды, жынды, шық!
Dialogue: 3,1:14:17.15,1:14:18.77,IN_YamiQRay_JP2,,0,0,0,,Сіз не айтасыз?
Dialogue: 3,1:14:18.77,1:14:20.41,IN_YamiQRay_JP2,,0,0,0,,Мен сенің не қалайтыныңды білемін
Dialogue: 3,1:14:20.72,1:14:23.63,IN_YamiQRay_JP2,,0,0,0,,Жалғызсың, мені биікке көтер
Dialogue: 2,1:14:08.11,1:14:09.63,IN_YamiQRay_CN2,,0,0,0,,Бұл рас па, жоқ па?
Dialogue: 2,1:14:09.63,1:14:11.92,IN_YamiQRay_CN2,,0,0,0,,…
Dialogue: 2,1:14:11.92,1:14:13.99,IN_YamiQRay_CN2,,0,0,0,,Бұл жай ғана арман мен арман
Dialogue: 2,1:14:14.46,1:14:17.15,IN_YamiQRay_CN2,,0,0,0,,...
Dialogue: 2,1:14:17.15,1:14:18.77,IN_YamiQRay_CN2,,0,0,0,,Жарайды, бұл тек менің жеке пікірім ғана.
Dialogue: 2,1:14:18.77,1:14:20.41,IN_YamiQRay_CN2,,0,0,0,,Мен сізге қажет жолды білемін.
Dialogue: 2,1:14:20.72,1:14:23.63,IN_YamiQRay_CN2,,0,0,0,,Биік ұшатын жалғыз сенсің
Dialogue: 3,1:14:15.93,1:14:16.54,IN_Freyja_JP,,0,0,0,,Сіз ұша аласыз!
Dialogue: 3,1:14:16.54,1:14:17.15,IN_Freyja_JP,,0,0,0,,махаббат
Dialogue: 3,1:14:17.15,1:14:17.73,IN_Mikumo_JP,,0,0,0,,махаббат
Dialogue: 3,1:14:17.73,1:14:18.37,IN_Freyja_JP,,0,0,0,,Сүйісумен
Dialogue: 3,1:14:18.37,1:14:19.03,IN_Mikumo_JP,,0,0,0,,Сүйісумен
Dialogue: 3,1:14:19.03,1:14:21.19,IN_Freyja_JP,,0,0,0,,Соңына сілтеме
Dialogue: 3,1:14:21.19,1:14:22.27,IN_Freyja_JP,,0,0,0,,Мен сені жақсы көремін
Dialogue: 3,1:14:22.27,1:14:25.80,IN_Freyja_JP,,0,0,0,,Өзіңіздің құмарлығыңызды бұзыңыз және одан асып кетіңіз ...
Dialogue: 3,1:14:25.80,1:14:30.37,IN_Freyja_JP,,0,0,0,,Сіз және абсолютті нөл
Dialogue: 3,1:14:43.24,1:14:45.29,IN_Kaname_JP,,0,0,0,,Мен саған арманның ұшқынын беремін
Dialogue: 3,1:14:45.29,1:14:49.95,IN_Kaname_JP,,0,0,0,,Сіз сенетін барлық нәрсені қабылдаңыз
Dialogue: 3,1:14:49.95,1:14:52.33,IN_Makina_JP,,0,0,0,,Ша-ла гені
Dialogue: 3,1:14:53.95,1:14:59.12,IN_Reina_JP,,0,0,0,,Жүрегімдегі жылуды қанша қастерлесем, соғұрлым оның жалған екенін сеземін.
Dialogue: 3,1:14:59.12,1:15:02.98,IN_Reina_JP,,0,0,0,,Мені сілкіп тастаңыз және басқа өлшемге сығыңыз
Dialogue: 3,1:15:03.94,1:15:05.08,IN_Freyja_JP,,0,0,0,,Дукудуку
Dialogue: 3,1:15:04.57,1:15:06.89,IN_Makina_JP2,,0,0,0,,Қарау
Dialogue: 3,1:15:05.08,1:15:07.90,IN_Mikumo_JP,,0,0,0,,Соқтығысқан ядролардан туған
Dialogue: 3,1:15:07.90,1:15:10.16,IN_Mikumo_JP,,0,0,0,,Мен сізді жақсы көремін анашым
Dialogue: 3,1:15:10.16,1:15:15.12,IN_Reina_JP,,0,0,0,,Жалғыз төге алмас көз жасым, Тағдырым мені байланыстырады
Dialogue: 3,1:15:15.90,1:15:16.50,IN_Freyja_JP,,0,0,0,,Сіз ұша аласыз!
Dialogue: 3,1:15:16.50,1:15:17.05,IN_Freyja_JP,,0,0,0,,махаббат
Dialogue: 3,1:15:17.05,1:15:17.80,IN_Makina_JP,,0,0,0,,Жылдамдық
Dialogue: 3,1:15:17.80,1:15:18.42,IN_Freyja_JP,,0,0,0,,Тікелей эфир
Dialogue: 3,1:15:18.42,1:15:19.00,IN_Reina_JP,,0,0,0,,Ессіз күйде
Dialogue: 3,1:15:19.00,1:15:21.08,IN_Freyja_JP2,,0,0,0,,Суперновалық
Dialogue: 2,1:15:04.57,1:15:06.89,IN_Makina_CN2,,0,0,0,,Ескертулер
Dialogue: 2,1:15:19.00,1:15:21.08,IN_Freyja_CN2,,0,0,0,,Супернова бомбасы
Dialogue: 3,1:15:19.52,1:15:28.21,IN_YamiQRay_JP,,0,0,0,,Қанатсыз құлау
Dialogue: 3,1:15:28.57,1:15:39.67,IN_YamiQRay_JP,,0,0,0,,Мен ақыры боспын
Dialogue: 3,1:15:40.92,1:15:49.89,IN_YamiQRay_JP,,0,0,0,,Өзін әділ деп атаған Құдайға
Dialogue: 3,1:15:50.16,1:15:56.17,IN_YamiQRay_JP,,0,0,0,,Қазір айыптаңыз
Dialogue: 3,1:16:16.72,1:16:18.77,IN_YamiQRay_JP,,0,0,0,,Жүр, көңіл көтерейік
Dialogue: 3,1:16:18.77,1:16:27.52,IN_YamiQRay_JP,,0,0,0,,Бұл дүние қызықсыз, көңілім түсіп барады.
Dialogue: 3,1:16:27.52,1:16:31.61,IN_YamiQRay_JP,,0,0,0,,Мен бәрін алып кетемін.
Dialogue: 3,1:16:32.34,1:16:33.36,IN_YamiQRay_JP,,0,0,0,,Махаббат
Dialogue: 3,1:16:33.36,1:16:34.55,IN_YamiQRay_JP,,0,0,0,,Армандар
Dialogue: 3,1:16:34.55,1:16:35.57,IN_YamiQRay_JP,,0,0,0,,Ән де
Dialogue: 3,1:16:35.57,1:16:37.07,IN_YamiQRay_JP,,0,0,0,,Үміт те
Dialogue: 3,1:16:37.07,1:16:40.25,IN_YamiQRay_JP,,0,0,0,,Бұл дауыс сізге жетпейді
Dialogue: 3,1:16:40.25,1:16:44.57,IN_YamiQRay_JP,,0,0,0,,Ковашитешимае
Dialogue: 3,1:16:44.57,1:16:48.35,IN_YamiQRay_JP,,0,0,0,,Бүкіл денені бөліктерге бөледі
Dialogue: 3,1:16:48.35,1:16:53.42,IN_YamiQRay_JP,,0,0,0,,Өмір, бәрі
Dialogue: 3,1:16:53.42,1:16:57.51,IN_YamiQRay_JP,,0,0,0,,Мені жүрек қызықтырмайды.
Dialogue: 3,1:16:57.51,1:17:02.80,IN_YamiQRay_JP,,0,0,0,,Мені қазір қуып жібер
Dialogue: 3,1:17:03.38,1:17:06.47,IN_YamiQRay_JP,,0,0,0,,Бастау - Жою -
Dialogue: 3,1:17:06.80,1:17:10.98,IN_YamiQRay_JP,,0,0,0,,Соңындағы дыбыс естілді.
Dialogue: 3,1:17:10.98,1:17:13.28,IN_YamiQRay_JP,,0,0,0,,Мазаламау
Dialogue: 3,1:17:13.28,1:17:17.68,IN_YamiQRay_JP,,0,0,0,,Періште сияқты Жасушалардың тереңінен
Dialogue: 3,1:17:17.68,1:17:25.15,IN_YamiQRay_JP,,0,0,0,,Қираудың айқайындай ән сал
Dialogue: 3,1:17:25.15,1:17:29.16,IN_YamiQRay_JP,,0,0,0,,Жаман, Жаман Сен де Жаман, Жаман
Dialogue: 3,1:17:29.16,1:17:33.70,IN_YamiQRay_JP,,0,0,0,,Сіз шынымен де бұған үміттеніп жатқаныңызға сенімдімін.
Dialogue: 3,1:17:33.70,1:17:38.26,IN_YamiQRay_JP,,0,0,0,,Бірақ маған ұнамайды, ұнамайды, мен әлі өтірікшімін
Dialogue: 3,1:17:38.26,1:17:42.76,IN_YamiQRay_JP,,0,0,0,,Ауырсыну жеткіліксіз сияқты.
Dialogue: 3,1:17:54.63,1:17:56.94,IN_YamiQRay_JP,,0,0,0,,Қирату – рахат
Dialogue: 3,1:18:05.91,1:18:09.57,IN_YamiQRay_JP,,0,0,0,,Көбірек ойнаңыз
Dialogue: 3,1:18:09.57,1:18:14.20,IN_YamiQRay_JP2,,0,0,0,,Бұл жеткіліксіз
Dialogue: 2,1:18:09.57,1:18:14.20,IN_YamiQRay_CN2,,0,0,0,,Бұл дұрыс емес.
Dialogue: 3,1:18:12.31,1:18:23.10,IN_Freyja_JP,,0,0,0,,30 жылда бір болатын шоқжұлдыз жақындап қалды
Dialogue: 3,1:18:24.18,1:18:34.61,IN_Freyja_JP,,0,0,0,,Мен сені қасымда көрмейінше ұйықтағым келмейді
Dialogue: 3,1:18:34.61,1:18:43.98,IN_Freyja_JP,,0,0,0,,Мен берілістердің баяу, баяу бұрылып жатқанын сеземін.
Dialogue: 3,1:18:46.45,1:18:54.97,IN_Freyja_JP,,0,0,0,,Қызық, бір жылда неше жыл, бір сәтте неше күн, неше секунд бар?
Dialogue: 3,1:18:55.26,1:19:00.81,IN_Freyja_JP,,0,0,0,,Сіз бұл туралы ешқашан ойлаған жоқсыз, солай ма?
Dialogue: 3,1:19:01.10,1:19:02.62,IN_Freyja_JP,,0,0,0,,Енді маған айтпа
Dialogue: 3,1:19:02.62,1:19:10.69,IN_Freyja_JP,,0,0,0,,Келесі метеордың қашан пайда болатынын білгім де келмейді.
Dialogue: 3,1:19:12.86,1:19:14.31,IN_Freyja_JP,,0,0,0,,Енді маған айтпа
Dialogue: 3,1:19:14.31,1:19:22.14,IN_Freyja_JP,,0,0,0,,Бұл соңғы рет болса да, мен өкінгім келмейді
Dialogue: 3,1:19:24.53,1:19:31.74,IN_Freyja_JP,,0,0,0,,Жел ескертусіз соға бастайды.
Dialogue: 3,1:19:42.06,1:19:46.27,IN_Freyja_JP,,0,0,0,,Бүгін түнде мені ренжітпе
Dialogue: 3,1:19:47.85,1:19:50.85,IN_Freyja_JP,,0,0,0,,Шоқжұлдыздарды табыңыз
Dialogue: 3,1:28:02.53,1:28:05.47,IN_YamiQRay_JP,,0,0,0,,Тыныштық және жоғалып кету
Dialogue: 3,1:28:05.11,1:28:07.90,IN_YamiQRay_JP2,,0,0,0,,Мен жалғызбын жақсымын
Dialogue: 3,1:28:06.99,1:28:11.67,IN_YamiQRay_JP,,0,0,0,,Қараңғылық жарықтан да әдемі
Dialogue: 3,1:28:11.67,1:28:14.19,IN_YamiQRay_JP,,0,0,0,,Сіз нені қорғағыңыз келеді?
Dialogue: 3,1:28:14.19,1:28:18.76,IN_YamiQRay_JP,,0,0,0,,Сол әлсіз жүрекпен, тіпті өзің де
Dialogue: 3,1:28:18.76,1:28:21.83,IN_YamiQRay_JP,,0,0,0,,Ол ұсақ-түйек болады.
Dialogue: 3,1:28:24.29,1:28:27.47,IN_YamiQRay_JP,,0,0,0,,Әуенді есту
Dialogue: 3,1:28:27.47,1:28:29.23,IN_YamiQRay_JP,,0,0,0,,Мұқият тыңдаңыз
Dialogue: 3,1:28:29.23,1:28:34.50,IN_YamiQRay_JP,,0,0,0,,Тағдыр мен саған айтпаймын...
Dialogue: 3,1:28:35.66,1:28:39.10,IN_YamiQRay_JP,,0,0,0,,Бастау - Жою -
Dialogue: 3,1:28:39.10,1:28:43.34,IN_YamiQRay_JP2,,0,0,0,,Соңындағы дыбыс естілді.
Dialogue: 3,1:28:43.34,1:28:45.43,IN_YamiQRay_JP,,0,0,0,,Мазаламау
Dialogue: 3,1:28:45.43,1:28:49.99,IN_YamiQRay_JP,,0,0,0,,Періште сияқты жасушалардың тереңінен
Dialogue: 3,1:28:49.99,1:28:57.07,IN_YamiQRay_JP,,0,0,0,,Қираудың айқайындай ән сал
Dialogue: 3,1:28:57.51,1:29:01.40,IN_YamiQRay_JP,,0,0,0,,Жаман, Жаман Сен де Жаман, Жаман
Dialogue: 3,1:29:01.40,1:29:05.82,IN_YamiQRay_JP,,0,0,0,,Сіз байқаған боларсыз.
Dialogue: 3,1:29:06.02,1:29:10.54,IN_YamiQRay_JP,,0,0,0,,Бірақ маған ұнамайды, ұнамайды, мен әлі өтірікшімін.
Dialogue: 3,1:29:10.54,1:29:16.65,IN_YamiQRay_JP,,0,0,0,,Ауырсыну жеткіліксіз сияқты.
Dialogue: 3,1:29:17.76,1:29:21.79,IN_YamiQRay_JP,,0,0,0,,Жаман, Жаман Мен Жаманмын, Жаманмын
Dialogue: 3,1:29:20.85,1:29:25.19,IN_YamiQRay_JP2,,0,0,0,,Барлығы қазір
Dialogue: 3,1:29:21.79,1:29:26.26,IN_YamiQRay_JP,,0,0,0,,Құлаған періштенің әні тоқтамас
Dialogue: 3,1:29:25.37,1:29:27.17,IN_YamiQRay_JP2,,0,0,0,,Жабу
Dialogue: 3,1:29:26.26,1:29:30.81,IN_YamiQRay_JP,,0,0,0,,Қараңдаршы, қараңғы, қараңғы, қатқан дүние
Dialogue: 3,1:29:30.81,1:29:32.91,IN_YamiQRay_JP,,0,0,0,,Мен сені сүйсіндіремін
Dialogue: 3,1:29:32.91,1:29:38.77,IN_YamiQRay_JP,,0,0,0,,Тұңғиық
Dialogue: 2,1:28:05.11,1:28:07.90,IN_YamiQRay_CN2,,0,0,0,,Гакикин бірегей тұлға
Dialogue: 2,1:28:39.10,1:28:43.34,IN_YamiQRay_CN2,,0,0,0,,Әңгіменің соңы
Dialogue: 2,1:29:20.85,1:29:25.19,IN_YamiQRay_CN2,,0,0,0,,Барлық тікелей меншік
Dialogue: 2,1:29:25.37,1:29:27.17,IN_YamiQRay_CN2,,0,0,0,,Таусылып қалды
Dialogue: 3,1:31:06.31,1:31:14.40,IN_Kaname_JP,,0,0,0,,Мен жете алмаймын, сен әрқашан
Dialogue: 3,1:31:14.40,1:31:23.72,IN_Kaname_JP,,0,0,0,,Бұл жерден не көрдіңіз?
Dialogue: 3,1:31:23.72,1:31:34.95,IN_Kaname_JP,,0,0,0,,Егер сіз жоғалтатын нәрселерді алсаңыз, оларды санаңыз.
Dialogue: 3,1:31:34.95,1:31:43.32,IN_Kaname_JP,,0,0,0,,Сен де көз жасыңды жасырдың.
Dialogue: 3,1:31:43.32,1:31:51.67,IN_Kaname_JP,,0,0,0,,Бұл көздер тым түзу
Dialogue: 3,1:31:51.67,1:32:02.87,IN_Kaname_JP,,0,0,0,,Мен бұл дүниеге қиғаш қарап отырдым.
Dialogue: 3,1:32:02.87,1:32:11.79,IN_Kaname_JP,,0,0,0,,Арманды өзің ғана салмайды.
Dialogue: 3,1:32:11.79,1:32:14.84,IN_Kaname_JP,,0,0,0,,Көзге көрінбейтін жел...
Dialogue: 3,1:32:14.84,1:32:17.22,IN_YamiQRay_JP,,0,0,0,,Қирату – рахат
Dialogue: 3,1:32:26.01,1:32:29.66,IN_YamiQRay_JP,,0,0,0,,Көбірек ойнаңыз
Dialogue: 3,1:32:29.66,1:32:34.08,IN_YamiQRay_JP,,0,0,0,,Бұл жеткіліксіз
Dialogue: 3,1:32:34.96,1:32:37.93,IN_YamiQRay_JP,,0,0,0,,Қызық, сол қол маған жетеді ме?
Dialogue: 3,1:32:37.93,1:32:39.73,IN_YamiQRay_JP,,0,0,0,,Келіңіздер!
Dialogue: 3,1:32:39.73,1:32:44.76,IN_YamiQRay_JP,,0,0,0,,Қиындықтарыңды, қайғыңды көрсет
Dialogue: 3,1:32:44.76,1:32:48.82,IN_YamiQRay_JP,,0,0,0,,...
Dialogue: 3,1:32:48.82,1:32:53.50,IN_YamiQRay_JP,,0,0,0,,Екіжүзді адамның бейкүнә күлгені
Dialogue: 3,1:32:53.79,1:32:59.80,IN_YamiQRay_JP,,0,0,0,,Күнәһар армандар
Dialogue: 3,1:35:20.23,1:35:23.33,IN_YamiQRay_JP,,0,0,0,,Докудоку, сен бәрібір менің құлымсың.
Dialogue: 3,1:35:23.33,1:35:26.51,IN_YamiQRay_JP,,0,0,0,,Камиками Керемет көрінуге тырыссаңыз да Жоқ Жоқ Жоқ Жоқ
Dialogue: 3,1:35:26.51,1:35:29.58,IN_YamiQRay_JP,,0,0,0,,Бұл сіздің қолыңызда, солай емес пе?
Dialogue: 3,1:35:29.58,1:35:31.77,IN_YamiQRay_JP,,0,0,0,,Тозақтың шақыруы
Dialogue: 3,1:35:31.77,1:35:34.76,IN_YamiQRay_JP,,0,0,0,,Тұйық, мүмкін қазірдің өзінде
Dialogue: 3,1:35:34.76,1:35:37.87,IN_YamiQRay_JP,,0,0,0,,Не болса да, бәрібір
Dialogue: 3,1:35:37.87,1:35:41.19,IN_YamiQRay_JP,,0,0,0,,Ауау Көзді ашып-жұмғанша бұл дүние
Dialogue: 3,1:35:41.19,1:35:43.09,IN_YamiQRay_JP,,0,0,0,,Азғындық түрмесі
Dialogue: 3,1:35:43.66,1:35:48.08,IN_YamiQRay_JP,,0,0,0,,Бірақ бірақ сен
Dialogue: 3,1:35:48.08,1:35:51.10,IN_YamiQRay_JP,,0,0,0,,Білмей
Dialogue: 3,1:35:51.33,1:35:56.30,IN_YamiQRay_JP,,0,0,0,,Жалған махаббатпен көкке көтерілу
Dialogue: 3,1:35:56.86,1:35:59.79,IN_YamiQRay_JP,,0,0,0,,Жану, құшақтау, жылау, өкініш
Dialogue: 3,1:35:59.79,1:36:02.26,IN_YamiQRay_JP,,0,0,0,,Сүйекке дейін
Dialogue: 3,1:36:02.71,1:36:05.51,IN_YamiQRay_JP,,0,0,0,,Оны ұсақтап, сорып ал.
Dialogue: 3,1:36:05.51,1:36:08.46,IN_YamiQRay_JP,,0,0,0,,Жемқорлық
Dialogue: 3,1:36:08.46,1:36:11.44,IN_YamiQRay_JP,,0,0,0,,Агония, жансыздану, суға бату
Dialogue: 3,1:36:11.44,1:36:15.25,IN_YamiQRay_JP,,0,0,0,,Мұнда кел
Dialogue: 3,1:36:35.94,1:36:38.77,IN_YamiQRay_JP,,0,0,0,,Мені азғырсаң, сараңсың.
Dialogue: 3,1:36:38.77,1:36:41.24,IN_YamiQRay_JP,,0,0,0,,Сүйкімді қыз
Dialogue: 3,1:36:41.59,1:36:44.66,IN_YamiQRay_JP,,0,0,0,,Тек әділдіктің одақтастары
Dialogue: 3,1:36:44.66,1:36:47.70,IN_YamiQRay_JP,,0,0,0,,Бұл қызықсыз
Dialogue: 3,1:36:50.39,1:36:55.52,IN_YamiQRay_JP,,0,0,0,,Үміт ет, жинал, табын, табын
Dialogue: 3,1:36:56.18,1:36:59.13,IN_YamiQRay_JP,,0,0,0,,Жану, құшақтау, жылау, өкініш
Dialogue: 3,1:36:59.13,1:37:01.93,IN_YamiQRay_JP,,0,0,0,,Сүйекке дейін
Dialogue: 3,1:37:02.23,1:37:04.72,IN_YamiQRay_JP,,0,0,0,,Оны ұсақтап, сорып ал.
Dialogue: 3,1:37:04.72,1:37:07.55,IN_YamiQRay_JP,,0,0,0,,Жемқорлық
Dialogue: 3,1:37:07.55,1:37:10.73,IN_YamiQRay_JP,,0,0,0,,Таза, ақ және таза
Dialogue: 3,1:37:10.73,1:37:13.50,IN_YamiQRay_JP,,0,0,0,,Сіз солай ойладыңыз.
Dialogue: 3,1:37:13.50,1:37:18.49,IN_YamiQRay_JP,,0,0,0,,Жоқ, жоқ, жоқ, әдемі гүлдер
Dialogue: 3,1:37:18.49,1:37:21.01,IN_YamiQRay_JP,,0,0,0,,Бұл улы (жынды болу)
Dialogue: 3,1:37:21.01,1:37:24.17,IN_YamiQRay_JP,,0,0,0,,Күндіз-түні билеу (жынды махаббат)
Dialogue: 3,1:37:24.17,1:37:26.80,IN_YamiQRay_JP,,0,0,0,,Уландыру жұмыстары (қараңғы ессіздік)
Dialogue: 3,1:37:26.80,1:37:30.09,IN_YamiQRay_JP,,0,0,0,,Күндіз-түні ән айт, иә!
Dialogue: 3,1:37:30.09,1:37:32.46,IN_YamiQRay_JP,,0,0,0,,Бұл улы (жынды болу)
Dialogue: 3,1:37:32.46,1:37:35.02,IN_YamiQRay_JP,,0,0,0,,Күндіз-түні билеу (жындыны жақсы көру)
Dialogue: 3,1:37:35.71,1:37:38.19,IN_YamiQRay_JP,,0,0,0,,Уландыру жұмыстары (қараңғы ессіздік)
Dialogue: 3,1:37:38.19,1:37:41.61,IN_YamiQRay_JP,,0,0,0,,Күндіз-түні ән айт, иә!
Dialogue: 3,1:37:41.61,1:37:45.58,IN_YamiQRay_JP,,0,0,0,,Детоксикация пайдасыз.
Dialogue: 3,1:37:59.44,1:38:06.14,IN_Freyja_JP,,0,0,0,,Берілмеу Берілмеу Берілмеу Берілмеу
Dialogue: 3,1:38:07.59,1:38:09.79,IN_Freyja_JP,,0,0,0,,Ал дегенмен!
Dialogue: 3,1:38:11.43,1:38:18.46,IN_Freyja_JP,,0,0,0,,Енді, қазір, қазір, мен біреудің дауысын естимін
Dialogue: 3,1:40:10.39,1:40:15.01,IN_Freyja_JP,,0,0,0,,Берілмеу Берілмеу Ай Ай Ай Ай А
Dialogue: 3,1:40:15.01,1:40:19.67,IN_Mikumo_JP,,0,0,0,,Ал дегенмен!
Dialogue: 3,1:40:42.93,1:40:48.44,IN_Freyja_JP,,0,0,0,,Енді, қазір, қазір, мен біреудің дауысын естимін
Dialogue: 3,1:40:48.62,1:40:53.66,IN_Mikumo_JP,,0,0,0,,Жұлдызаралық тартылыс күшін басшылыққа алған ән, ән, ән
Dialogue: 3,1:40:53.66,1:40:57.24,IN_Freyja_JP,,0,0,0,,Жұмбақ үн (Аспанға ұшады)
Dialogue: 3,1:40:57.24,1:41:00.20,IN_Mikumo_JP,,0,0,0,,Мен оны сол ғаламға жібергім келеді (ЖҰЛДЫЗҒА ҰШ)
Dialogue: 3,1:41:00.20,1:41:04.56,IN_Freyja_JP,,0,0,0,,Махаббат нұрына ұялаған күй
Dialogue: 3,1:41:05.58,1:41:10.49,IN_Mikumo_JP,,0,0,0,,Асыл, туа бер!
Dialogue: 3,1:41:07.33,1:41:09.18,IN_Reina_JP2,,0,0,0,,Оян
Dialogue: 3,1:41:10.49,1:41:14.75,IN_Freyja_JP,,0,0,0,,Құбылмалы заманда бірге ән айт
Dialogue: 3,1:41:14.75,1:41:18.80,IN_Freyja_JP,,0,0,0,,Шешімділіктің шуы әлі әлі
Dialogue: 3,1:41:18.80,1:41:21.63,IN_Kaname_JP,,0,0,0,,«Мен бас тартпаймын» Мен ештеңе бермеймін
Dialogue: 3,1:41:21.63,1:41:24.78,IN_Kaname_JP,,0,0,0,,Қанағатсыз махаббат жылайды
Dialogue: 3,1:41:24.78,1:41:30.16,IN_Freyja_JP,,0,0,0,,Эстетика жеке алып жүрді? Маған бұл керек емес!
Dialogue: 3,1:41:30.16,1:41:32.90,IN_Kaname_JP,,0,0,0,,Бірін-бірі шақыратын жүректер
Dialogue: 3,1:41:32.90,1:41:36.02,IN_Kaname_JP,,0,0,0,,Резонанстық шығарылым әні
Dialogue: 3,1:41:36.02,1:41:38.74,IN_Mikumo_JP,,0,0,0,,Супер-кеңістіктен тыс
Dialogue: 3,1:41:38.74,1:41:43.21,IN_Mikumo_JP,,0,0,0,,Мен сені терең, терең сезінуге рұқсат етіңіз!
Dialogue: 3,1:41:43.21,1:41:47.08,IN_Freyja_JP,,0,0,0,,Берілмеңіз Бас тартпаңыз Ай Ай
Dialogue: 3,1:41:47.08,1:41:48.75,IN_Mikumo_JP,,0,0,0,,Жақсырақ істе
Dialogue: 3,1:41:48.75,1:41:53.35,IN_Freyja_JP,,0,0,0,,Мен резонанс жасағым келеді Мен оны резонансқа жеткізгім келеді Ай Ай Ай Ай А.
Dialogue: 3,1:41:53.35,1:41:58.21,IN_Mikumo_JP,,0,0,0,,Ал дегенмен!
Dialogue: 2,1:41:07.33,1:41:09.18,IN_Makina_CN2,,0,0,0,,Ояну
Dialogue: 3,1:42:22.53,1:42:27.32,IN_Mikumo_JP,,0,0,0,,Бұзып, мені одан сайын сезін
Dialogue: 3,1:42:27.32,1:42:30.04,IN_Mikumo_JP,,0,0,0,,Сіз сондасыз ба?
Dialogue: 3,1:42:30.35,1:42:33.96,IN_Mikumo_JP,,0,0,0,,Майдан даласында өмір гүлдейді
Dialogue: 3,1:42:33.96,1:42:35.43,IN_Kaname_JP,,0,0,0,,Күйіп қал, күйдір
Dialogue: 3,1:42:35.43,1:42:39.50,IN_Mikumo_JP,,0,0,0,,Мені өлтіріп, шіріп кетейін
Dialogue: 3,1:42:39.50,1:42:42.57,IN_Mikumo_JP,,0,0,0,,Тагире Тагире Қираудың соңында
Dialogue: 3,1:42:42.57,1:42:46.74,IN_Freyja_JP,,0,0,0,,Ғажайыпты ояту
Dialogue: 3,1:42:46.74,1:42:51.13,IN_Mikumo_JP,,0,0,0,,Жабық аспанға
Dialogue: 3,1:42:53.38,1:42:55.60,IN_Mikumo_JP,,0,0,0,,Соңғы минуттық махаббат
Dialogue: 3,1:42:55.60,1:43:00.45,IN_Mikumo_JP,,0,0,0,,Қауіпті шекарасыз Бұл ақылсыз.
Dialogue: 3,1:43:00.84,1:43:05.01,IN_Mikumo_JP,,0,0,0,,Әлі де жылдамдауда
Dialogue: 3,1:43:05.29,1:43:07.51,IN_Mikumo_JP,,0,0,0,,Кирикири биі
Dialogue: 3,1:43:07.51,1:43:12.71,IN_Mikumo_JP,,0,0,0,,Егер сыну нүктесіне жетсеңіз, оны қайта бояуға болады.
Dialogue: 3,1:43:12.71,1:43:19.97,IN_Mikumo_JP,,0,0,0,,Жоюдан және қайта туылудан мен мұны істей аламын.
Dialogue: 3,1:43:39.56,1:43:41.61,IN_Mikumo_JP,,0,0,0,,Соңғы минуттық махаббат
Dialogue: 3,1:43:41.78,1:43:46.87,IN_Mikumo_JP,,0,0,0,,Шекара сызығы тіпті G қиындық деңгейінде де жақсы емес
Dialogue: 3,1:43:46.87,1:43:51.20,IN_Mikumo_JP,,0,0,0,,Барлығын жойыңыз
Dialogue: 3,1:43:51.50,1:43:53.50,IN_Mikumo_JP,,0,0,0,,Кирикири биі
Dialogue: 3,1:43:53.71,1:43:58.91,IN_Mikumo_JP,,0,0,0,,Сана көбірек Г-ге ериді
Dialogue: 3,1:43:58.91,1:44:05.63,IN_Mikumo_JP,,0,0,0,,Менің денем бақылаудан шықты, мен өліп қалуым мүмкін.
Dialogue: 3,1:44:06.39,1:44:06.95,IN_Mikumo_JP,,0,0,0,,Жеткізу!
Dialogue: 3,1:44:06.95,1:44:07.62,IN_Mikumo_JP,,0,0,0,,Махаббатпен
Dialogue: 3,1:44:07.62,1:44:08.19,IN_Reina_JP,,0,0,0,,Қорғасын
Dialogue: 3,1:44:08.19,1:44:08.77,IN_Mikumo_JP,,0,0,0,,Би
Dialogue: 3,1:44:08.77,1:44:09.57,IN_Freyja_JP,,0,0,0,,Бостандық!
Dialogue: 3,1:44:09.57,1:44:11.75,IN_Mikumo_JP,,0,0,0,,Иллюзия аркурийі
Dialogue: 3,1:44:11.75,1:44:12.93,IN_Kaname_JP,,0,0,0,,Бұл тамаша
Dialogue: 3,1:44:12.93,1:44:17.45,IN_Mikumo_JP,,0,0,0,,Оянсам жаныңда боламын, Ешқашан жібермеймін
Dialogue: 3,1:44:17.45,1:44:18.28,IN_Mikumo_JP,,0,0,0,,ант берді
