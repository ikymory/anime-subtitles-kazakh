Dialogue: 0,0:15:38.92,0:15:46.18,Staff,,150,0,0,,Бұл субтитрді Мэн Чая жазған және коммерциялық алмасу мақсаттарына арналған.
Dialogue: 3,0:01:38.42,0:01:43.24,IN_Lanka_JP,,0,0,0,,Бұл міндетті түрде осында.
Dialogue: 3,0:01:43.24,0:01:49.34,IN_Lanka_JP,,0,0,0,,Бақыланбай толып жатыр
Dialogue: 3,0:01:50.08,0:01:58.94,IN_Lanka_JP,,0,0,0,,Сені ойласам, Жүрегім ғаламға айналады
Dialogue: 3,0:01:59.61,0:02:03.35,IN_Lanka_JP,,0,0,0,,Жұлдыздарды құшақтау
Dialogue: 3,0:02:04.85,0:02:10.49,IN_Lanka_JP,,0,0,0,,Шектеулі уақыт пен күн
Dialogue: 3,0:02:10.49,0:02:15.56,IN_Lanka_JP,,0,0,0,,Мен оны сені жақсы көру үшін қолданамын
Dialogue: 3,0:02:16.42,0:02:22.21,IN_Lanka_JP,,0,0,0,,Мен сені сүйемін деп айтуға күш
Dialogue: 3,0:02:22.45,0:02:27.35,IN_Lanka_JP,,0,0,0,,Мен біле бастадым
Dialogue: 3,0:02:27.35,0:02:31.38,IN_Lanka_JP,,0,0,0,,Бұл ұзақ жол
Dialogue: 3,0:02:31.63,0:02:41.33,IN_Lanka_JP,,0,0,0,,Алыстағы жарықтың жетегінде
Dialogue: 3,0:02:43.34,0:02:47.86,IN_Lanka_JP,,0,0,0,,Қайта-қайта кездесейік.
Dialogue: 3,0:02:52.44,0:02:55.32,IN_Lanka_JP,,0,0,0,,…Сізбен кездессем деп едім.
Dialogue: 3,0:02:56.58,0:02:59.87,IN_Lanka_JP,,0,0,0,,Цуруконың сезімі
Dialogue: 3,0:03:00.37,0:03:06.85,IN_Lanka_JP,,0,0,0,,Суық желде теңселме
Dialogue: 3,0:03:06.85,0:03:15.65,IN_Lanka_JP,,0,0,0,,Мен сізді қорғауды жалғастыруға ант етемін
Dialogue: 3,0:05:00.93,0:05:04.03,IN_Lanka_JP,,0,0,0,,Бұл уақыттың жұмбақ лабиринті.
Dialogue: 3,0:05:04.03,0:05:07.15,IN_Lanka_JP,,0,0,0,,Жабық естеліктерді ояту
Dialogue: 3,0:05:07.15,0:05:10.28,IN_Lanka_JP,,0,0,0,,Мен неге мұндамын? Неге мен?
Dialogue: 3,0:05:10.28,0:05:13.52,IN_Lanka_JP,,0,0,0,,Бос жауап билейді
Dialogue: 3,0:05:13.52,0:05:16.63,IN_Lanka_JP,,0,0,0,,Түс болса жарайды
Dialogue: 3,0:05:16.63,0:05:19.22,IN_Lanka_JP,,0,0,0,,Өткенді қайта жаза алатын болсақ
Dialogue: 3,0:05:19.22,0:05:24.63,IN_Lanka_JP,,0,0,0,,Шайтанға айналу
Dialogue: 3,0:05:51.59,0:05:54.75,IN_Lanka_JP,,0,0,0,,Мен сенімен алғаш рет болған кезім есімде
Dialogue: 3,0:05:54.75,0:05:57.14,IN_Lanka_JP,,0,0,0,,Біз кездескен күн туралы
Dialogue: 3,0:05:58.22,0:06:01.91,IN_Lanka_JP,,0,0,0,,Жел жұмсақ болды.
Dialogue: 3,0:06:02.11,0:06:04.38,IN_Lanka_JP2,,0,0,0,,Менің бір болжамым бар еді
Dialogue: 3,0:06:04.38,0:06:07.17,IN_Lanka_JP,,0,0,0,,Алғаш кездессек те, мен ностальгияны сезінемін
Dialogue: 3,0:06:07.17,0:06:09.64,IN_Lanka_JP,,0,0,0,,Мүмкін сіз де шығарсыз
Dialogue: 3,0:06:10.59,0:06:14.34,IN_Lanka_JP,,0,0,0,,Сіз солай ойладыңыз ба деп ойлаймын.
Dialogue: 3,0:06:15.56,0:06:20.07,IN_Lanka_JP,,0,0,0,,Содан бері мен әр күнім көңілді өтті.
Dialogue: 3,0:06:20.07,0:06:21.44,IN_Lanka_JP,,0,0,0,,Өте өкінішті
Dialogue: 3,0:06:21.44,0:06:25.53,IN_Lanka_JP,,0,0,0,,Кішкене жалғыздық
Dialogue: 3,0:06:26.32,0:06:30.54,IN_Lanka_JP,,0,0,0,,Менің жүрегім осының бәріне толы.
Dialogue: 3,0:06:30.54,0:06:36.80,IN_Lanka_JP,,0,0,0,,Сенің есімің жүрегімді толтырады
Dialogue: 3,0:06:37.34,0:06:40.41,IN_Lanka_JP,,0,0,0,,025-8- және S04
Dialogue: 3,0:06:40.41,0:06:43.05,IN_Lanka_JP,,0,0,0,,Сіз бұл дауысты ести аласыз ба?
Dialogue: 3,0:06:43.46,0:06:46.65,IN_Lanka_JP,,0,0,0,,Мен көбірек білгім келеді
