Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.01,0:00:10.96,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:00:12.13,0:00:13.09,Default,,0,0,0,,Осы уақытта Джозеф пен басқалар—
Dialogue: 0,0:00:14.63,0:00:15.76,Default,,0,0,0,,Өте көп
Dialogue: 0,0:00:17.30,0:00:17.93,Default,,0,0,0,,Су…
Dialogue: 0,0:00:35.49,0:00:36.11,Default,,0,0,0,,Не!
Dialogue: 0,0:00:36.91,0:00:38.37,Default,,0,0,0,,Интернет ақымақ!
Dialogue: 0,0:00:38.45,0:00:42.20,Default,,0,0,0,,Жалпы алғанда, интернетте ештеңе жоқ... Иә?
Dialogue: 0,0:00:43.62,0:00:44.91,Default,,0,0,0,,Колология?
Dialogue: 0,0:00:48.17,0:00:51.21,Default,,0,0,0,,Ямада, сен теледидардасың ба?
Dialogue: 0,0:00:51.80,0:00:54.76,Default,,0,0,0,,Әр сейсенбіде сағат 19:00-ден...
Dialogue: 0,0:00:54.84,0:00:56.34,Default,,0,0,0,,Бүгін!
Dialogue: 0,0:00:59.35,0:01:01.22,Default,,0,0,0,,Қарғыс атқыр... кеш болды.
Dialogue: 0,0:01:01.72,0:01:04.02,Default,,0,0,0,,Не? Сіз не көріп тұрсыз?
Dialogue: 0,0:01:06.23,0:01:07.48,Default,,0,0,0,,Не?
Dialogue: 0,0:01:08.48,0:01:10.44,Default,,0,0,0,,Егер сіз оны көрмесеңіз, мен оны өшіремін бе?
Dialogue: 0,0:01:12.48,0:01:14.49,Default,,0,0,0,,♪～
Dialogue: 0,0:02:39.99,0:02:41.99,Default,,0,0,0,,～♪
Dialogue: 0,0:02:46.66,0:02:48.50,Default,,0,0,0,,Маған Ямада ұнайды
Dialogue: 0,0:02:49.96,0:02:52.04,Default,,0,0,0,,Бірақ бәрі осы.
Dialogue: 0,0:02:53.42,0:02:54.96,Default,,0,0,0,,Менің жігітім болғың келе ме?
Dialogue: 0,0:02:55.04,0:02:57.21,Default,,0,0,0,,Әрине мен сенімен қыдырғым келмейді.
Dialogue: 0,0:02:57.71,0:03:00.55,Default,,0,0,0,,Бұрынғыдан ештеңе өзгермейді.
Dialogue: 0,0:03:01.05,0:03:04.60,Default,,0,0,0,,Жоқ, мен ештеңені өзгертпес едім...
Dialogue: 0,0:03:05.60,0:03:08.27,Default,,0,0,0,,Хаа... О, жоқ, шыдамдылық жүгіру
Dialogue: 0,0:03:08.77,0:03:11.14,Default,,0,0,0,,Менің де шебер емеспін, ендеше бірге жүгірейік.
Dialogue: 0,0:03:11.23,0:03:12.10,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:03:12.19,0:03:14.27,Default,,0,0,0,,О? бұл жалау
Dialogue: 0,0:03:18.86,0:03:20.15,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:03:20.24,0:03:21.61,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:03:23.36,0:03:24.99,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:03:25.07,0:03:27.70,Default,,0,0,0,,Мәдени фестивальдер мен жұмысқа турлар сияқты жағымсыз оқиғалар
Dialogue: 0,0:03:28.20,0:03:30.71,Default,,0,0,0,,Мен бұл жаман емес деп ойладым.
Dialogue: 0,0:03:30.79,0:03:32.25,Default,,0,0,0,,Дәл осы...
Dialogue: 0,0:03:32.75,0:03:33.71,Default,,0,0,0,,Ха... иә?
Dialogue: 0,0:03:36.13,0:03:37.63,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:03:37.71,0:03:38.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:39.13,0:03:39.92,Default,,0,0,0,,Жоқ... жоқ
Dialogue: 0,0:03:40.01,0:03:42.84,Default,,0,0,0,,Мен ер адам ретінде Ямаданы жанымнан өткізе алмаймын!
Dialogue: 0,0:03:44.59,0:03:45.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:50.48,0:03:50.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:51.06,0:03:52.73,Default,,0,0,0,,Ал... күте тұрыңыз
Dialogue: 0,0:03:52.81,0:03:54.31,Default,,0,0,0,,... жылдам!
Dialogue: 0,0:03:54.81,0:03:57.07,Default,,0,0,0,,Көпшілікке араласпа дедім.
Dialogue: 0,0:03:57.15,0:03:58.23,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:58.32,0:03:59.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:59.15,0:04:01.99,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:04:03.24,0:04:05.78,Default,,0,0,0,,Жарайды, мүлдем бөлек...
Dialogue: 0,0:04:08.37,0:04:09.45,Default,,0,0,0,,А...
Dialogue: 0,0:04:10.87,0:04:13.25,Default,,0,0,0,,Жұмбақ баяу
Dialogue: 0,0:04:16.46,0:04:17.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:18.42,0:04:20.09,Default,,0,0,0,,Артқы және алдыңғы жағы Керісінше емес пе?
Dialogue: 0,0:04:20.17,0:04:20.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:21.34,0:04:22.59,Default,,0,0,0,,Уау, бұл рас!
Dialogue: 0,0:04:23.09,0:04:24.68,Default,,0,0,0,,Оны біраз уақыт ұстаңыз
Dialogue: 0,0:04:35.35,0:04:38.02,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:04:38.61,0:04:41.03,Default,,0,0,0,,Қайтадан баяулау...
Dialogue: 0,0:04:42.99,0:04:44.20,Default,,0,0,0,,А, қазірдің өзінде
Dialogue: 0,0:04:48.70,0:04:53.04,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:04:58.42,0:04:59.88,Default,,0,0,0,,Иә? Неге...
Dialogue: 0,0:05:01.34,0:05:02.21,Default,,0,0,0,,Оң көз
Dialogue: 0,0:05:02.30,0:05:02.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:04.05,0:05:07.26,Default,,0,0,0,,Оң көз Бірінші рет көрген
Dialogue: 0,0:05:12.31,0:05:12.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:13.47,0:05:14.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:14.93,0:05:16.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:21.61,0:05:23.28,Default,,0,0,0,,Бұл енді мүмкін емес...
Dialogue: 0,0:05:23.78,0:05:25.49,Default,,0,0,0,,Соңында бәрі бітті.
Dialogue: 0,0:05:26.49,0:05:27.99,Default,,0,0,0,,Иә? Ха!
Dialogue: 0,0:05:28.07,0:05:31.99,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:05:32.58,0:05:34.75,Default,,0,0,0,,Барлығы ертерек қайтты.
Dialogue: 0,0:05:38.33,0:05:39.00,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:05:39.08,0:05:40.33,Default,,0,0,0,,Бум!
Dialogue: 0,0:05:43.59,0:05:45.97,Default,,0,0,0,,Кешіріңіз, мен алға кеттім.
Dialogue: 0,0:05:46.05,0:05:49.18,Default,,0,0,0,,Жарайды, өз қарқының маңызды.
Dialogue: 0,0:05:49.26,0:05:50.51,Default,,0,0,0,,Жоқ, Ямада мырза.
Dialogue: 0,0:05:50.60,0:05:52.93,Default,,0,0,0,,Бұл менің қарқыным емес еді, солай ма?
Dialogue: 0,0:05:53.01,0:05:53.51,Default,,0,0,0,,А...
Dialogue: 0,0:05:53.60,0:05:54.47,Default,,0,0,0,,бұл… Хара мырза…
Dialogue: 0,0:05:54.56,0:05:57.35,Default,,0,0,0,,Бірақ ғажап, қуып жете алмадым.
Dialogue: 0,0:06:02.86,0:06:04.86,Default,,0,0,0,,Мм! Жоқ, жоқ, жоқ
Dialogue: 0,0:06:04.94,0:06:07.78,Default,,0,0,0,,Екінші адам - ​​Ямада, солай ма? Бұл қалыпты жағдай
Dialogue: 0,0:06:07.86,0:06:11.20,Default,,0,0,0,,Не, мен тым көп ойлап отырмын ба?
Dialogue: 0,0:06:12.08,0:06:12.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:14.70,0:06:15.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:15.87,0:06:16.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:17.83,0:06:19.79,Default,,0,0,0,,Хаа~ Егер қолынан келсе
Dialogue: 0,0:06:19.87,0:06:22.29,Default,,0,0,0,,Мен жейделерді несиеге беруге және қарызға алуға тырыстым.
Dialogue: 0,0:06:22.38,0:06:25.25,Default,,0,0,0,,Сөмкеңізді көрсетіңіз.
Dialogue: 0,0:06:25.34,0:06:27.30,Default,,0,0,0,,- (Йошида) Уау, уау - (Кобаяши) Мм
Dialogue: 0,0:06:27.38,0:06:30.89,Default,,0,0,0,,Бірақ сіз бір сыныпта болсаңыз, мұны істей алмайсыз.
Dialogue: 0,0:06:30.97,0:06:34.31,Default,,0,0,0,,Менің бұл сыныптағы баламен танысу мүмкіндігім жоқ.
Dialogue: 0,0:06:34.39,0:06:35.26,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:35.77,0:06:36.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:36.89,0:06:37.81,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:06:38.31,0:06:42.15,Default,,0,0,0,,Егер сіз менің жейдені киіп алғанымды байқамай, көрмесеңіз...
Dialogue: 0,0:06:42.73,0:06:43.69,Default,,0,0,0,,- (Ямада) Ах! -(Секине) Уау!
Dialogue: 0,0:06:43.77,0:06:46.07,Default,,0,0,0,,Неліктен мына лас жейде киіп жүрсің?
Dialogue: 0,0:06:46.15,0:06:47.28,Default,,0,0,0,,Сасық!
Dialogue: 0,0:06:47.36,0:06:49.90,Default,,0,0,0,,Ямаданың құны төмендейді!
Dialogue: 0,0:06:50.86,0:06:52.74,Default,,0,0,0,,4-кезең сабақ басталады
Dialogue: 0,0:06:53.24,0:06:56.74,Default,,0,0,0,,Осы жерде және мектептегі түскі асқа аман қалсаңыз, түскі ас уақыты келді...
Dialogue: 0,0:06:57.25,0:06:57.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:58.58,0:07:00.00,Default,,0,0,0,,Мен оны кидім!
Dialogue: 0,0:07:01.08,0:07:03.54,Default,,0,0,0,,Қазір аздап салқындағаны сөзсіз.
Dialogue: 0,0:07:04.13,0:07:04.92,Default,,0,0,0,,Мен де...
Dialogue: 0,0:07:05.00,0:07:06.09,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:07:06.59,0:07:09.47,Default,,0,0,0,,Соны біле тұра киіп алсаң, жай... бұзықсың.
Dialogue: 0,0:07:09.55,0:07:12.47,Default,,0,0,0,,Енді осы мәселені талқылайық... Адачи
Dialogue: 0,0:07:12.55,0:07:14.22,Default,,0,0,0,,(Бас редактор) Таңырқап қарап тұрма, материалдарды жина.
Dialogue: 0,0:07:14.30,0:07:15.72,Default,,0,0,0,,Е, жоқ!
Dialogue: 0,0:07:15.81,0:07:17.89,Default,,0,0,0,,Ең қиын адам!
Dialogue: 0,0:07:17.97,0:07:21.52,Default,,0,0,0,,Оның үстіне оның мүддесі негізінен кеудеде.
Dialogue: 0,0:07:22.40,0:07:24.23,Default,,0,0,0,,«Ичикава»?
Dialogue: 0,0:07:25.86,0:07:28.44,Default,,0,0,0,,А, бұл! Мен оны шешкім келеді!
Dialogue: 0,0:07:28.53,0:07:29.65,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:07:29.74,0:07:31.82,Default,,0,0,0,,Ах, содан кейін Ичикава.
Dialogue: 0,0:07:36.62,0:07:39.25,Default,,0,0,0,,Уау, қатты көрінеді
Dialogue: 0,0:07:39.83,0:07:42.33,Default,,0,0,0,,Әйтеуір байқамайды.
Dialogue: 0,0:07:44.83,0:07:45.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:46.88,0:07:48.46,Default,,0,0,0,,Біліңіз
Dialogue: 0,0:07:53.43,0:07:55.55,Default,,0,0,0,,- (Адачи) Әй, бұл не? - (Ичикава) А?
Dialogue: 0,0:07:55.64,0:07:56.93,Default,,0,0,0,,Жер
Dialogue: 0,0:07:57.01,0:08:00.73,Default,,0,0,0,,Бұл «осы қарапайым мәселені маған қалдыр» позасы ма?
Dialogue: 0,0:08:00.81,0:08:03.52,Default,,0,0,0,,Иә, бұл тамаша! Ичикава мырза!
Dialogue: 0,0:08:03.60,0:08:05.56,Default,,0,0,0,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:08:05.65,0:08:08.15,Default,,0,0,0,,Жоқ, өкінішке орай қателесесіз.
Dialogue: 0,0:08:08.23,0:08:08.98,Default,,0,0,0,,А...
Dialogue: 0,0:08:09.82,0:08:12.32,Default,,0,0,0,,Мен өлгім келеді, өйткені өлгім келеді
Dialogue: 0,0:08:15.78,0:08:18.74,Default,,0,0,0,,Бірақ нағыз тозақ басталғалы тұр!
Dialogue: 0,0:08:19.24,0:08:22.08,Default,,0,0,0,,Хаа~ менің қарным ашты~!
Dialogue: 0,0:08:22.16,0:08:23.92,Default,,0,0,0,,Кеудеңізді ашпаңыз!
Dialogue: 0,0:08:26.08,0:08:27.42,Default,,0,0,0,,Иә Уау!
Dialogue: 0,0:08:27.50,0:08:29.17,Default,,0,0,0,,О, бұл үлкен мәселе.
Dialogue: 0,0:08:30.05,0:08:31.26,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:08:38.05,0:08:39.60,Default,,0,0,0,,Ах~ мен жедім, жедім!
Dialogue: 0,0:08:39.68,0:08:41.64,Default,,0,0,0,,Тым көп толтыру.
Dialogue: 0,0:08:41.72,0:08:43.73,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:08:44.23,0:08:45.65,Default,,0,0,0,,- (Ямада) Ичикава - (Ичикава) Иә?
Dialogue: 0,0:08:49.73,0:08:52.07,Default,,0,0,0,,Әйтеуір түсіндім
Dialogue: 0,0:08:53.15,0:08:55.32,Default,,0,0,0,,Олар қашан ауыстырылды деп ойлаймын.
Dialogue: 0,0:08:55.95,0:08:57.70,Default,,0,0,0,,Та… әрине.
Dialogue: 0,0:08:57.78,0:09:00.24,Default,,0,0,0,,Мен оны мүлде байқамадым
Dialogue: 0,0:09:01.24,0:09:03.04,Default,,0,0,0,,Актерлік өнер өте нашар
Dialogue: 0,0:09:04.41,0:09:05.29,Default,,0,0,0,,Ичикава
Dialogue: 0,0:09:05.37,0:09:07.96,Default,,0,0,0,,Мен оны көптен бері кимедім, суық емес пе?
Dialogue: 0,0:09:08.04,0:09:09.42,Default,,0,0,0,,О, мүлде емес пе?
Dialogue: 0,0:09:10.17,0:09:11.38,Default,,0,0,0,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,0:09:13.38,0:09:14.92,Default,,0,0,0,,Бірақ Ямада...
Dialogue: 0,0:09:16.30,0:09:18.80,Default,,0,0,0,,Қызық, сіз оны қай кезеңде түсіндіңіз?
Dialogue: 0,0:09:30.15,0:09:30.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:31.98,0:09:34.07,Default,,0,0,0,,- (Ичикава) Күріш дәндері бар - (Ямада) Иә?
Dialogue: 0,0:09:35.40,0:09:37.36,Default,,0,0,0,,Оны өлшейміз бе?
Dialogue: 0,0:09:37.45,0:09:38.74,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:09:38.82,0:09:39.74,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:09:41.95,0:09:43.66,Default,,0,0,0,,Хмм... бұл қиын...
Dialogue: 0,0:09:48.25,0:09:49.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:50.46,0:09:51.84,Default,,0,0,0,,～
Dialogue: 0,0:09:52.96,0:09:53.71,Default,,0,0,0,,Қолмен
Dialogue: 0,0:09:54.67,0:09:57.55,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:09:58.55,0:09:59.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:59.14,0:10:02.18,Default,,0,0,0,,Жарайды... дұрыс тұрсаң, тағы бар.
Dialogue: 0,0:10:02.81,0:10:04.06,Default,,0,0,0,,Онда менмін.
Dialogue: 0,0:10:04.56,0:10:05.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:05.89,0:10:07.02,Default,,0,0,0,,Сізге стенд қажет
Dialogue: 0,0:10:07.10,0:10:07.81,Default,,0,0,0,,Ой...
Dialogue: 0,0:10:15.44,0:10:16.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:16.57,0:10:17.07,Default,,0,0,0,,Осы жерден айналып өтейік…
Dialogue: 0,0:10:17.15,0:10:20.20,Default,,0,0,0,,171.9
Dialogue: 0,0:10:20.28,0:10:22.28,Default,,0,0,0,,172 дерлік осында
Dialogue: 0,0:10:22.37,0:10:25.04,Default,,0,0,0,,Қазірдің өзінде... Сосын тағы да Ичикава.
Dialogue: 0,0:10:25.54,0:10:26.79,Default,,0,0,0,,Осы жолы дұрыс өлшейміз бе?
Dialogue: 0,0:10:26.87,0:10:29.71,Default,,0,0,0,,Е, жоқ, жетеді.
Dialogue: 0,0:10:29.79,0:10:31.25,Default,,0,0,0,,Барлығы мен туралы
Dialogue: 0,0:10:31.33,0:10:33.71,Default,,0,0,0,,Жоқ, өлшейік дедім...
Dialogue: 0,0:10:34.50,0:10:35.17,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:10:38.05,0:10:38.84,Default,,0,0,0,,Сіз оны көрдіңіз!
Dialogue: 0,0:10:39.34,0:10:40.22,Default,,0,0,0,,Мен оны көрген жоқпын.
Dialogue: 0,0:10:40.80,0:10:42.55,Default,,0,0,0,,Маған сенің салмағың бәрібір.
Dialogue: 0,0:10:42.64,0:10:44.06,Default,,0,0,0,,Мен оны көрдім!
Dialogue: 0,0:10:44.14,0:10:45.01,Default,,0,0,0,,Мен оны көрмедім!
Dialogue: 0,0:10:45.10,0:10:46.02,Default,,0,0,0,,Мен көрдім!
Dialogue: 0,0:10:46.10,0:10:48.64,Default,,0,0,0,,Ми... Мен оны көрдім, бірақ ұмытып кеттім.
Dialogue: 0,0:10:48.73,0:10:51.19,Default,,0,0,0,,Өтірік! Міндетті түрде есімде!
Dialogue: 0,0:10:56.07,0:10:58.99,Default,,0,0,0,,Ештеңе шынымен өзгермейді.
Dialogue: 0,0:10:59.70,0:11:01.57,Default,,0,0,0,,Мен сені ұнататынымды білгенде
Dialogue: 0,0:11:02.07,0:11:03.57,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:04.08,0:11:06.37,Default,,0,0,0,,Ямада ештеңе білмейді.
Dialogue: 0,0:11:11.29,0:11:12.50,Default,,0,0,0,,Эй, сен мұны естідің бе?
Dialogue: 0,0:11:12.58,0:11:14.04,Default,,0,0,0,,Ямада: Мен сізді фильмге түсетініңізді естідім.
Dialogue: 0,0:11:14.13,0:11:14.79,Default,,0,0,0,,А...
Dialogue: 0,0:11:16.09,0:11:19.67,Default,,0,0,0,,Не... Не? Солай ма?
Dialogue: 0,0:11:19.76,0:11:22.01,Default,,0,0,0,,Бұл бәрібір бір театрдан шыққан сұмдық фильм.
Dialogue: 0,0:11:22.09,0:11:24.93,Default,,0,0,0,,Басты рөлдегі Наоки Шуга ақылсыз!
Dialogue: 0,0:11:25.01,0:11:26.68,Default,,0,0,0,,Мен қобалжыдым!
Dialogue: 0,0:11:26.76,0:11:29.02,Default,,0,0,0,,Е, мен де актерді танимын.
Dialogue: 0,0:11:29.10,0:11:31.48,Default,,0,0,0,,Оның Мо Чанға қатысы жоқ.
Dialogue: 0,0:11:31.56,0:11:33.27,Default,,0,0,0,,Е, біз қосыла алмаймыз.
Dialogue: 0,0:11:33.77,0:11:36.98,Default,,0,0,0,,Одан да сорақысы Кеничи Фукуда директор!
Dialogue: 0,0:11:37.07,0:11:38.65,Default,,0,0,0,,Бұл бүкілхалықтық роудшоу!
Dialogue: 0,0:11:38.73,0:11:40.03,Default,,0,0,0,,Не, Каннда?
Dialogue: 0,0:11:40.90,0:11:44.32,Default,,0,0,0,,Тіпті мен түсінемін, бұл актриса ретінде мен үшін үлкен мүмкіндік.
Dialogue: 0,0:11:44.41,0:11:46.58,Default,,0,0,0,,Керемет актриса болудың алғашқы қадамы
Dialogue: 0,0:11:47.08,0:11:47.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:49.79,0:11:53.25,Default,,0,0,0,,Неге тым бақытты көрінбейсің?
Dialogue: 0,0:11:55.00,0:11:56.29,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:11:56.79,0:11:59.17,Default,,0,0,0,,Бірқалыпты дамып келе жатқан мен
Dialogue: 0,0:11:59.26,0:12:04.26,Default,,0,0,0,,Сіз мен айналаңыздағы ақымақ адамдар арасындағы сынып айырмашылығына байланысты өзіңізді аздап жалғыз сезінесіз бе?
Dialogue: 0,0:12:05.30,0:12:07.26,Default,,0,0,0,,Ямада мейірімді.
Dialogue: 0,0:12:08.76,0:12:10.64,Default,,0,0,0,,Үй бөлмесін бастайық
Dialogue: 0,0:12:10.73,0:12:12.98,Default,,0,0,0,,- (Маэда) Барлығы отырады - (Оқушылар) Иә.
Dialogue: 0,0:12:13.56,0:12:16.77,Default,,0,0,0,,Бүгін, өткен аптада айтқанымдай, біз орындарды ауыстырамыз.
Dialogue: 0,0:12:17.27,0:12:21.49,Default,,0,0,0,,Мен лотерея ойнадым, сондықтан барлығы соңғы қатардан бастап ретімен ұтыс ойнасын.
Dialogue: 0,0:12:22.07,0:12:23.53,Default,,0,0,0,,Орындарды ауыстыру керек пе?
Dialogue: 0,0:12:23.61,0:12:25.49,Default,,0,0,0,,Пазлды тек Құдай біледі
Dialogue: 0,0:12:25.57,0:12:26.37,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:26.45,0:12:27.83,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:12:28.49,0:12:28.99,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:30.91,0:12:32.25,Default,,0,0,0,,Ол қайда болды?
Dialogue: 0,0:12:32.33,0:12:33.96,Default,,0,0,0,,А, сен кетіп қалдың.
Dialogue: 0,0:12:34.04,0:12:35.37,Default,,0,0,0,,Ах~ Жақсы~
Dialogue: 0,0:12:35.46,0:12:36.83,Default,,0,0,0,,Кездесу аяқталғаннан кейін де, үйге келген соң қылмыскерлерді үкім шығарумен қайта айналысамын.
Dialogue: 0,0:12:37.84,0:12:41.38,Default,,0,0,0,,Енді әрқайсысың өз парталарыңды алып, қозғалыңдар.
Dialogue: 0,0:12:47.39,0:12:48.43,Default,,0,0,0,,Құдай…
Dialogue: 0,0:12:50.81,0:12:51.89,Default,,0,0,0,,Құдай…
Dialogue: 0,0:12:53.77,0:12:54.98,Default,,0,0,0,,Құдай…
Dialogue: 0,0:12:57.35,0:13:00.27,Default,,0,0,0,,Құдай... бір қабат
Dialogue: 0,0:13:01.03,0:13:01.82,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:13:02.32,0:13:04.78,Default,,0,0,0,,- (Ичикава) Жарайды... - (Адачи) Әй, көрші Ямада!
Dialogue: 0,0:13:04.86,0:13:05.99,Default,,0,0,0,,Бұл жігіт!
Dialogue: 0,0:13:06.49,0:13:09.37,Default,,0,0,0,,Жоқ, мен оны жақсырақ деп ойлауым керек пе?
Dialogue: 0,0:13:10.41,0:13:12.79,Default,,0,0,0,,Сонда қасымдағы адам...
Dialogue: 0,0:13:15.04,0:13:15.79,Default,,0,0,0,,Ах
Dialogue: 0,0:13:15.87,0:13:17.17,Default,,0,0,0,,Бұл Хара-сан!
Dialogue: 0,0:13:17.25,0:13:18.54,Default,,0,0,0,,- (Хара) Ахаха - (Ямада) Ия!
Dialogue: 0,0:13:18.63,0:13:20.88,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:13:20.96,0:13:22.55,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:13:23.76,0:13:25.63,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,0:13:31.14,0:13:31.93,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:33.97,0:13:35.23,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:13:36.31,0:13:37.27,Default,,0,0,0,,Неліктен қозғалады?
Dialogue: 0,0:13:38.19,0:13:38.69,Default,,0,0,0,,Ах
Dialogue: 0,0:13:39.69,0:13:40.90,Default,,0,0,0,,Ұзын кірпіктер
Dialogue: 0,0:13:42.19,0:13:42.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:43.78,0:13:44.74,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:47.91,0:13:48.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:48.74,0:13:50.45,Default,,0,0,0,,Қарама
Dialogue: 0,0:13:50.53,0:13:53.74,Default,,0,0,0,,Тақтаға қарасам, ол менің көру аймағыма келеді.
Dialogue: 0,0:13:53.83,0:13:55.20,Default,,0,0,0,,- (Адачи) Әй, тозақ - (Ямада) А?
Dialogue: 0,0:13:55.29,0:13:58.12,Default,,0,0,0,,Мен қазіргі оқулығымды ұмытып қалдым.
Dialogue: 0,0:13:58.21,0:13:59.42,Default,,0,0,0,,- (Ямада) Сонда... - (Адачи) Хехе.
Dialogue: 0,0:13:59.50,0:14:01.67,Default,,0,0,0,,Оқулықпен бөлісу шарасы!
Dialogue: 0,0:14:01.75,0:14:02.84,Default,,0,0,0,,- (Ичикава) Бұл біртүрлі! -(Адачи) Уау.
Dialogue: 0,0:14:02.92,0:14:04.80,Default,,0,0,0,,Мен оны жаңа ғана үстелімнен таптым...
Dialogue: 0,0:14:05.30,0:14:06.09,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:14:06.17,0:14:08.55,Default,,0,0,0,,Бұл жігіт соңғы кездері мұнда жиі келетін болды.
Dialogue: 0,0:14:08.63,0:14:10.26,Default,,0,0,0,,Жақсы достар
Dialogue: 0,0:14:11.01,0:14:13.56,Default,,0,0,0,,Бірақ менде нақты мәселе болды.
Dialogue: 0,0:14:14.06,0:14:16.64,Default,,0,0,0,,Практикалық есеп: Мен тақтаны мүлдем көрмеймін.
Dialogue: 0,0:14:18.56,0:14:19.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:19.65,0:14:20.77,Default,,0,0,0,,- (Ичикава) Хмм... - (Хара) Иә?
Dialogue: 0,0:14:20.86,0:14:22.15,Default,,0,0,0,,Уф... кешіріңіз
Dialogue: 0,0:14:22.23,0:14:24.36,Default,,0,0,0,,Жоқ, сіз оны көре алмайсыз ба?
Dialogue: 0,0:14:24.44,0:14:26.03,Default,,0,0,0,,А... иә
Dialogue: 0,0:14:26.11,0:14:28.86,Default,,0,0,0,,Сонымен, менің жазбаларымды көшіргіңіз келе ме?
Dialogue: 0,0:14:28.95,0:14:29.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:30.57,0:14:33.37,Default,,0,0,0,,Мұғалімге кейінірек айту керек шығар.
Dialogue: 0,0:14:33.45,0:14:33.95,Default,,0,0,0,,Иә
Dialogue: 0,0:14:34.95,0:14:37.29,Default,,0,0,0,,Жылы адам Хара-сан
Dialogue: 0,0:14:40.62,0:14:42.21,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:14:44.09,0:14:44.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:52.93,0:14:54.22,Default,,0,0,0,,Ямада~
Dialogue: 0,0:14:54.31,0:14:54.93,Default,,0,0,0,,Не?
Dialogue: 0,0:14:55.43,0:14:57.10,Default,,0,0,0,,«Не?» емес
Dialogue: 0,0:14:57.18,0:14:58.60,Default,,0,0,0,,Неге мұнда келмейсің?
Dialogue: 0,0:14:58.68,0:15:00.10,Default,,0,0,0,,Онда кел.
Dialogue: 0,0:15:00.19,0:15:01.40,Default,,0,0,0,,Патша!
Dialogue: 0,0:15:02.15,0:15:03.69,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:15:04.19,0:15:06.78,Default,,0,0,0,,Киноға түскенді ұнатпайтын шығарсыз...
Dialogue: 0,0:15:07.36,0:15:10.11,Default,,0,0,0,,Жоқ, мен қазір тақта туралы көбірек айтып отырмын.
Dialogue: 0,0:15:10.20,0:15:12.70,Default,,0,0,0,,Бірақ мен сенің бойың үшін алаңдадым.
Dialogue: 0,0:15:13.20,0:15:16.20,Default,,0,0,0,,«Мен оны көре алмаймын, себебі ол үлкен» деп айта алмайсыз.
Dialogue: 0,0:15:17.20,0:15:19.54,Default,,0,0,0,,Тонарихара-сан болғанына қуаныштымын.
Dialogue: 0,0:15:20.04,0:15:22.21,Default,,0,0,0,,Не? бөлек
Dialogue: 0,0:15:22.71,0:15:25.34,Default,,0,0,0,,Бұл мейірімді және жұмсақ
Dialogue: 0,0:15:27.46,0:15:28.42,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:15:33.22,0:15:35.39,Default,,0,0,0,,Сол сабақта...
Dialogue: 0,0:15:35.89,0:15:36.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:38.47,0:15:40.06,Default,,0,0,0,,Мен тек Ямаданы ғана көре аламын
Dialogue: 0,0:15:45.81,0:15:46.65,Default,,0,0,0,,Е...
Dialogue: 0,0:15:58.83,0:16:02.21,Default,,0,0,0,,мен тақтаны мүлдем көре алмаймын...
Dialogue: 0,0:16:04.25,0:16:05.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:10.42,0:16:12.47,Default,,0,0,0,,Мен мұғалімге айттым~
Dialogue: 0,0:16:12.55,0:16:13.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:15.43,0:16:16.35,Default,,0,0,0,,Хмм?
Dialogue: 0,0:16:18.06,0:16:21.27,Default,,0,0,0,,Түсіндім, тақтаны көре алмадыңыз ба?
Dialogue: 0,0:16:21.77,0:16:24.31,Default,,0,0,0,,Жоқ, қазір шешілді.
Dialogue: 0,0:16:24.81,0:16:27.23,Default,,0,0,0,,Бұл неліктен болып жатыр?
Dialogue: 0,0:16:27.31,0:16:29.98,Default,,0,0,0,,Бұл ең нашар шешім болғанымен
Dialogue: 0,0:16:30.07,0:16:31.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:31.49,0:16:35.45,Default,,0,0,0,,Жоқ, Ямада да... Әртүрлі нәрселер бар екеніне сенімдімін.
Dialogue: 0,0:16:35.95,0:16:37.41,Default,,0,0,0,,Иә? Әртүрлі заттар ше?
Dialogue: 0,0:16:37.91,0:16:41.45,Default,,0,0,0,,Не? Бұл... фильм... әлде бір нәрсе ме?
Dialogue: 0,0:16:41.54,0:16:42.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:42.75,0:16:45.08,Default,,0,0,0,,Сізді Ичикава фильмі қызықтырады ма?
Dialogue: 0,0:16:45.17,0:16:46.92,Default,,0,0,0,,Сізге қол тигізгенімді қалайтын сияқтысыз!
Dialogue: 0,0:16:47.00,0:16:50.30,Default,,0,0,0,,Ал... енді ойлап қарасам, бірдеңе шығып жатқан сияқты.
Dialogue: 0,0:16:50.80,0:16:52.38,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:16:52.88,0:16:53.67,Default,,0,0,0,,Ағаштың рөлі?
Dialogue: 0,0:16:54.17,0:16:55.59,Default,,0,0,0,,Қазірдің өзінде! Жоқ, бұл дұрыс емес.
Dialogue: 0,0:16:56.09,0:16:58.55,Default,,0,0,0,,Басты кейіпкерді бұрышқа түсіретін детектив қызының рөлін сомдайды.
Dialogue: 0,0:16:59.05,0:17:00.60,Default,,0,0,0,,Тіпті дұрыс рөл атауы бар ма?
Dialogue: 0,0:17:00.68,0:17:03.48,Default,,0,0,0,,Рөлдің деңгейі қандай?
Dialogue: 0,0:17:04.06,0:17:07.90,Default,,0,0,0,,Жоғары сынып оқушысы детектив жолда өледі...
Dialogue: 0,0:17:07.98,0:17:11.15,Default,,0,0,0,,Иә? Ол бұрынғыдан әлдеқайда бақытты көрінеді.
Dialogue: 0,0:17:11.86,0:17:16.32,Default,,0,0,0,,Мүмкін Ямаданың рөлін ешкім айтпаған шығар.
Dialogue: 0,0:17:16.91,0:17:19.03,Default,,0,0,0,,- (Ямада) Жолдар да бар - (Ичикава) Хмм.
Dialogue: 0,0:17:19.53,0:17:20.58,Default,,0,0,0,,(Ямаданың Секібарайы)
Dialogue: 0,0:17:24.41,0:17:25.50,Default,,0,0,0,,Өте қорқынышты
Dialogue: 0,0:17:28.88,0:17:30.34,Default,,0,0,0,,шешуші сызық болып табылады.
Dialogue: 0,0:17:30.84,0:17:32.05,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:17:32.55,0:17:33.76,Default,,0,0,0,,Анықтау сызықтары?
Dialogue: 0,0:17:34.26,0:17:35.97,Default,,0,0,0,,Өйткені мен оны әдетте онша көп айтпаймын.
Dialogue: 0,0:17:36.05,0:17:37.59,Default,,0,0,0,,Маған жаттығу керек
Dialogue: 0,0:17:38.68,0:17:39.18,Default,,0,0,0,,О...
Dialogue: 0,0:17:40.76,0:17:41.93,Default,,0,0,0,,Өте қорқынышты!
Dialogue: 0,0:17:42.01,0:17:45.02,Default,,0,0,0,,Сондай-ақ... сәл салқындату үшін.
Dialogue: 0,0:17:45.68,0:17:46.89,Default,,0,0,0,,Өте қорқынышты...
Dialogue: 0,0:17:46.98,0:17:48.44,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:17:48.52,0:17:50.02,Default,,0,0,0,,Өте қорқынышты
Dialogue: 0,0:17:50.11,0:17:51.32,Default,,0,0,0,,Жақсырақ болды.
Dialogue: 0,0:17:51.40,0:17:52.86,Default,,0,0,0,,Цк... бұл шынымен қорқынышты
Dialogue: 0,0:17:52.94,0:17:54.69,Default,,0,0,0,,Қалай... жақсылап барады...
Dialogue: 0,0:17:54.78,0:17:55.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:56.32,0:17:57.49,Default,,0,0,0,,Ал... күтіңіз, күтіңіз.
Dialogue: 0,0:17:57.57,0:17:58.07,Default,,0,0,0,,«Мен… мен адаммын.»
Dialogue: 0,0:17:58.16,0:17:59.99,Default,,0,0,0,,Елсіз жер жақсырақ
Dialogue: 0,0:18:00.07,0:18:00.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:02.79,0:18:05.79,Default,,0,0,0,,Жарақат алған адамдар көп емес пе?
Dialogue: 0,0:18:06.29,0:18:08.42,Default,,0,0,0,,Өйткені басқа ештеңе жоқ.
Dialogue: 0,0:18:09.00,0:18:11.63,Default,,0,0,0,,Бірақ екі адам сыймайтындай кішкентай...
Dialogue: 0,0:18:14.63,0:18:18.09,Default,,0,0,0,,Сонымен... Мм... Фильм қашан шығады?
Dialogue: 0,0:18:18.59,0:18:22.39,Default,,0,0,0,,Біз түсіруді қазір бастаймыз, сондықтан келесі жылдың көктемінде болатын шығар.
Dialogue: 0,0:18:22.89,0:18:24.22,Default,,0,0,0,,Бұл өте алыс.
Dialogue: 0,0:18:24.72,0:18:26.06,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:18:26.14,0:18:28.60,Default,,0,0,0,,Келесі жылдың көктемі...
Dialogue: 0,0:18:30.35,0:18:34.11,Default,,0,0,0,,Сол кезде мен және Ямада
Dialogue: 0,0:18:36.24,0:18:38.36,Default,,0,0,0,,Біз бірге боламыз ба?
Dialogue: 0,0:18:40.41,0:18:41.99,Default,,0,0,0,,Сіз қарай аласыз ба?
Dialogue: 0,0:18:42.53,0:18:43.20,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:18:43.70,0:18:44.79,Default,,0,0,0,,Э~?
Dialogue: 0,0:18:45.29,0:18:47.50,Default,,0,0,0,,Бірақ жақсылық жаса
Dialogue: 0,0:18:48.00,0:18:49.37,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:52.00,0:18:56.42,Default,,0,0,0,,Көріну... жақсылық жасау...
Dialogue: 0,0:19:07.68,0:19:08.31,Default,,0,0,0,,Соңы!
Dialogue: 0,0:19:08.81,0:19:09.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.27,0:19:12.02,Default,,0,0,0,,Сіз сызықтарыңызды жаттықтырасыз ба?
Dialogue: 0,0:19:16.78,0:19:17.94,Default,,0,0,0,,Мен енді айта алмаймын
Dialogue: 0,0:19:29.96,0:19:33.38,Default,,0,0,0,,«Ашу! Колумб мектебі»
Dialogue: 0,0:19:34.04,0:19:34.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:34.92,0:19:36.13,Default,,0,0,0,,Бұл басталды
Dialogue: 0,0:19:36.88,0:19:40.59,Default,,0,0,0,,Иә, ол «Ашу! Колумб мектебін» бастады.
Dialogue: 0,0:19:40.67,0:19:42.68,Default,,0,0,0,,Не? Бұл қайда?
Dialogue: 0,0:19:43.18,0:19:47.06,Default,,0,0,0,,Бүгінгі жастардың шынайы үнін естігіміз келеді!
Dialogue: 0,0:19:47.14,0:19:49.68,Default,,0,0,0,,Әй, бұл матрос костюмі ғой!
Dialogue: 0,0:19:50.18,0:19:52.73,Default,,0,0,0,,Сонымен Шумай.
Dialogue: 0,0:19:52.81,0:19:54.69,Default,,0,0,0,,Шумай ұнай ма?
Dialogue: 0,0:19:54.77,0:19:55.98,Default,,0,0,0,,Мен оны жақсы көремін!
Dialogue: 0,0:19:56.06,0:19:57.27,Default,,0,0,0,,Тек «Маймай»!
Dialogue: 0,0:19:57.36,0:19:58.61,Default,,0,0,0,,Оны қабылдамаңыз!
Dialogue: 0,0:19:58.69,0:19:59.65,Default,,0,0,0,,Мұның бәрі ме?
Dialogue: 0,0:20:00.15,0:20:02.49,Default,,0,0,0,,Адам көп болған соң өте қиын...
Dialogue: 0,0:20:02.99,0:20:06.28,Default,,0,0,0,,Рахмет. Келесі жолы Мику.
Dialogue: 0,0:20:06.37,0:20:06.99,Default,,0,0,0,,О!
Dialogue: 0,0:20:07.08,0:20:10.12,Default,,0,0,0,,Түскі асқа өрік алғыңыз келе ме?
Dialogue: 0,0:20:10.20,0:20:11.37,Default,,0,0,0,,Иә! Мен осындамын
Dialogue: 0,0:20:11.96,0:20:13.92,Default,,0,0,0,,Мен сені көп бақылап отырмын Мен сені көп бақылап отырмын!
Dialogue: 0,0:20:15.04,0:20:15.67,Default,,0,0,0,,Бірдеңе айт!
Dialogue: 0,0:20:15.75,0:20:19.63,Default,,0,0,0,,Сонымен барлығының пікірлері жинақталды.
Dialogue: 0,0:20:19.71,0:20:20.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:21.01,0:20:23.55,Default,,0,0,0,,Әйтеуір... Әй, қайта шағылыстырады...
Dialogue: 0,0:20:25.09,0:20:27.89,Default,,0,0,0,,Ақыр соңында ол кесілді ме?
Dialogue: 0,0:20:28.39,0:20:31.27,Default,,0,0,0,,Бұл әдеттегі нәрсе деп ойлаймын.
Dialogue: 0,0:20:31.77,0:20:33.06,Default,,0,0,0,,Шағылысу туралы айту
Dialogue: 0,0:20:33.77,0:20:35.65,Default,,0,0,0,,Біреу Ямадаға тым көп қарайды
Dialogue: 0,0:20:35.73,0:20:38.86,Default,,0,0,0,,Ямада әзілкештің қызықсыз кекестігіне күледі
Dialogue: 0,0:20:39.36,0:20:40.23,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:40.32,0:20:42.15,Default,,0,0,0,,Ямада майлықтан шығып тұр
Dialogue: 0,0:20:42.24,0:20:44.99,Default,,0,0,0,,Келесі аптада кездескенше!
Dialogue: 0,0:20:45.07,0:20:48.12,Default,,0,0,0,,Соңында Ямада бір ауыз сөз айтпады.
Dialogue: 0,0:20:49.28,0:20:50.33,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:20:52.41,0:20:55.33,Default,,0,0,0,,Неліктен аздап жеңілдеп қалдыңыз?
Dialogue: 0,0:20:57.08,0:20:58.38,Default,,0,0,0,,Мен қоқыспын
Dialogue: 0,0:20:58.88,0:21:01.84,Default,,0,0,0,,Мен Ямаданың дәл қазір жараланғанына сенімдімін.
Dialogue: 0,0:21:07.01,0:21:09.68,Default,,0,0,0,,Мен бұл мәселені мүмкіндігінше қозғамаймын...
Dialogue: 0,0:21:10.81,0:21:14.14,Default,,0,0,0,,Сіз кеше «Корогакуды» көрдіңіз бе? Бұл өте жақсы көрінді!
Dialogue: 0,0:21:14.23,0:21:16.81,Default,,0,0,0,,- (Кобаяши және басқалар) Хмм... - (Ичикава) Жақсы ма?
Dialogue: 0,0:21:17.31,0:21:20.52,Default,,0,0,0,,Ямада үлкен актриса болу үшін ұзақ жолды күтіп тұр
Dialogue: 0,0:21:21.23,0:21:22.73,Default,,0,0,0,,Ал мынау...
Dialogue: 0,0:21:22.82,0:21:23.86,Default,,0,0,0,,Уау~
Dialogue: 0,0:21:23.94,0:21:26.70,Default,,0,0,0,,Наоки Суганың қолы
Dialogue: 0,0:21:26.78,0:21:28.62,Default,,0,0,0,,Жасандылық жасамаңыз!
Dialogue: 0,0:21:28.70,0:21:29.87,Default,,0,0,0,,Өте алыс
Dialogue: 0,0:21:29.95,0:21:31.03,Default,,0,0,0,,Бұл тым күрделі!
Dialogue: 0,0:21:31.12,0:21:33.54,Default,,0,0,0,,- (Ямада) Хехехе... - (Кобаяши) Неге барамын деп ойладың?
Dialogue: 0,0:21:34.04,0:21:36.04,Default,,0,0,0,,♪～
Dialogue: 0,0:23:00.62,0:23:02.63,Default,,0,0,0,,～♪
