Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.92,0:00:11.80,jp,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:00:12.24,0:00:13.59,jp,,0,0,0,,Хмм, қанағаттандым.
Dialogue: 0,0:00:13.68,0:00:15.30,jp,,0,0,0,,Ең жақсы гондола
Dialogue: 0,0:00:15.47,0:00:16.76,jp,,0,0,0,,Акари-сан
Dialogue: 0,0:00:18.22,0:00:20.64,jp,,0,0,0,,Бұл қиын, бұл ғажайып.
Dialogue: 0,0:00:20.64,0:00:22.64,jp,,0,0,0,,Ай-чан, тұтынушы
Dialogue: 0,0:00:22.64,0:00:24.64,jp,,0,0,0,,Ах, кешіріңіз.
Dialogue: 0,0:00:25.56,0:00:27.60,jp,,0,0,0,,Еңбегіңізге рахмет, көмектесіңізші.
Dialogue: 0,0:00:28.06,0:00:29.15,jp,,0,0,0,,Рахмет
Dialogue: 0,0:00:29.15,0:00:31.11,jp,,0,0,0,,Керемет нәрсе болды.
Dialogue: 0,0:00:31.11,0:00:32.65,jp,,0,0,0,,Иә, өте
Dialogue: 0,0:00:32.65,0:00:35.45,jp,,0,0,0,,Бұл қала ғажайыптарға толы.
Dialogue: 0,0:00:35.86,0:00:36.99,jp,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:00:36.99,0:00:40.03,jp,,0,0,0,,Біз де ғажайыптарға тап болғымыз келеді
Dialogue: 0,0:00:40.49,0:00:43.29,jp,,0,0,0,,Сол үшін мен ертең көп жүремін.
Dialogue: 0,0:00:43.29,0:00:44.29,jp,,0,0,0,,Гатта
Dialogue: 0,0:00:45.75,0:00:46.96,jp,,0,0,0,,Рахмет
Dialogue: 0,0:00:47.08,0:00:48.96,jp,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:00:49.34,0:00:50.38,jp,,0,0,0,,Қай жерде тамақтану керек?
Dialogue: 0,0:00:51.13,0:00:52.84,jp,,0,0,0,,Мен китара жегім келеді
Dialogue: 0,0:00:52.96,0:00:54.26,jp,,0,0,0,,Әй, жақсы, жақсы
Dialogue: 0,0:00:55.05,0:00:57.05,jp,,0,0,0,,Сонымен, Ай Чанның кереметі неде?
Dialogue: 0,0:00:57.14,0:00:58.80,jp,,0,0,0,,А, дұрыс.
Dialogue: 0,0:00:58.85,0:01:00.89,jp,,0,0,0,,Тыңдашы, Акари-сан.
Dialogue: 0,0:01:01.06,0:01:04.64,jp,,0,0,0,,Керемет, ғажайып ғажайып болды.
Dialogue: 0,0:01:04.81,0:01:06.14,jp,,0,0,0,,Иә, бұл не?
Dialogue: 0,0:01:06.14,0:01:07.77,jp,,0,0,0,,Сәлем, президент Ария.
Dialogue: 0,0:01:08.81,0:01:11.11,jp,,0,0,0,,Президент Арияның көңіл-күйі көтеріңкі.
Dialogue: 0,0:01:11.11,0:01:14.53,jp,,0,0,0,,Бұл шынымен жұмбақ.
Dialogue: 0,0:01:14.53,0:01:16.61,jp,,0,0,0,,Мүмкін мен
Dialogue: 0,0:01:16.61,0:01:20.37,jp,,0,0,0,,Мен Акваның кереметіне кіретін жерді тапқан шығармын.
Dialogue: 0,0:01:20.37,0:01:23.08,jp,,0,0,0,,Иә, не болды, не болды?
Dialogue: 0,0:01:38.05,0:01:39.34,jp,,0,0,0,,Сәлем
Dialogue: 0,0:01:39.34,0:01:42.60,jp,,0,0,0,,Иә, барлық пайымдаулар жақсы көріне бастады.
Dialogue: 0,0:01:42.60,0:01:44.01,jp,,0,0,0,,Шынымен бе?
Dialogue: 0,0:01:44.02,0:01:45.14,jp,,0,0,0,,Сәттілік
Dialogue: 0,0:01:45.14,0:01:46.68,jp,,0,0,0,,Рахмет
Dialogue: 0,0:01:47.02,0:01:49.39,jp,,0,0,0,,Жұмысыңызға сәттілік, ағай.
Dialogue: 0,0:01:55.19,0:01:59.32,jp,,0,0,0,,Мен керемет күн болатынын сеземін.
Dialogue: 0,0:01:59.45,0:02:03.12,jp,,0,0,0,,Жоқ, жоқ, мұндай нәрсеге риза болма.
Dialogue: 0,0:02:03.24,0:02:05.24,jp,,0,0,0,,Жаттығу! жаттығу!
Dialogue: 0,0:02:21.01,0:02:24.30,jp,,0,0,0,,Осындай жерде аллея болды ма?
Dialogue: 0,0:02:25.72,0:02:31.69,jp,,0,0,0,,Әй, мысық?
Dialogue: 0,0:02:33.69,0:02:37.53,jp,,0,0,0,,Жоқ, бұл Кэйт Сит.
Dialogue: 0,0:02:47.39,0:03:00.49,jp,,0,0,0,,Таңертеңгі күн терезеден ақырын өтіп жатыр.
Dialogue: 0,0:03:00.86,0:03:13.75,jp,,0,0,0,,Ұйықтап жатқан кірпігіме төгіледі
Dialogue: 0,0:03:14.63,0:03:28.97,jp,,0,0,0,,Мені жел бөлмесіне шақырыңыз
Dialogue: 0,0:03:30.18,0:03:36.15,jp,,0,0,0,,Ағаштарды сүзіп өткен күн сәулесіндегі ұйықтап жатқан жүзіңіз
Dialogue: 0,0:03:36.19,0:03:38.94,jp,,0,0,0,,Түрі
Dialogue: 0,0:03:39.03,0:03:41.40,jp,,0,0,0,,Эйфория
Dialogue: 0,0:03:41.49,0:03:47.49,jp,,0,0,0,,Қарапайым таң
Dialogue: 0,0:03:48.62,0:03:55.46,jp,,0,0,0,,Ол ашық түсті
Dialogue: 0,0:03:55.46,0:04:02.63,jp,,0,0,0,,Сізбен кездескенім бір ғажап
Dialogue: 0,0:04:02.97,0:04:06.68,jp,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:04:06.76,0:04:13.81,jp,,0,0,0,,Себебі мен сенімен біргемін
Dialogue: 0,0:04:27.10,0:04:29.81,jp,,0,0,0,,О, бұл.
Dialogue: 0,0:04:33.85,0:04:35.73,jp,,0,0,0,,Оның мұндай жерге қосылғанына сене алар емеспін
Dialogue: 0,0:04:36.31,0:04:38.36,jp,,0,0,0,,Президент Ария, сіз білесіз бе?
Dialogue: 0,0:04:43.53,0:04:44.28,jp,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:04:44.28,0:04:47.20,jp,,0,0,0,,Мияу, мияу, мияу
Dialogue: 0,0:04:48.66,0:04:51.87,jp,,0,0,0,,Бұл жерде жоқ, мен оны жоғалтып алдым деп ойлаймын.
Dialogue: 0,0:04:52.75,0:04:53.12,jp,,0,0,0,,Мияу мияу! ?
Dialogue: 0,0:04:54.25,0:04:54.50,jp,,0,0,0,,Няняня! ?
Dialogue: 0,0:04:54.50,0:04:56.96,jp,,0,0,0,,Бұл бізді не деп атайды?
Dialogue: 0,0:04:56.96,0:05:00.50,jp,,0,0,0,,Бұл мысық кәдімгі мысықтан да артық екені сөзсіз.
Dialogue: 0,0:05:00.80,0:05:04.72,jp,,0,0,0,,Мүмкін сіз Кейт Ситті іздеп жүрген боларсыз?
Dialogue: 0,0:05:04.72,0:05:07.43,jp,,0,0,0,,Кэйт Ситті іздеу керек пе?
Dialogue: 0,0:05:07.80,0:05:11.26,jp,,0,0,0,,Ах, Aria компаниясының жаңа мүшесі.
Dialogue: 0,0:05:11.26,0:05:14.93,jp,,0,0,0,,Ой, балалар...
Dialogue: 0,0:05:21.44,0:05:23.86,jp,,0,0,0,,Мен Азуса Б. Макларенмін
Dialogue: 0,0:05:23.86,0:05:27.70,jp,,0,0,0,,Химейя филиалында мен филиал менеджерінен тікелей басшылық аламын.
Dialogue: 0,0:05:27.70,0:05:31.33,jp,,0,0,0,,Оны өзім айту қиын, бірақ ол болашағы бар акция.
Dialogue: 0,0:05:31.53,0:05:33.54,jp,,0,0,0,,Аня Достоевская
Dialogue: 0,0:05:33.54,0:05:36.96,jp,,0,0,0,,Мен Orange Planet-те Алиса-сенпайға қарыздармын.
Dialogue: 0,0:05:37.33,0:05:39.96,jp,,0,0,0,,А, мен Айно Аймын.
Dialogue: 0,0:05:40.42,0:05:41.42,jp,,0,0,0,,Мен білемін
Dialogue: 0,0:05:41.42,0:05:44.09,jp,,0,0,0,,О, о, неге?
Dialogue: 0,0:05:44.26,0:05:46.42,jp,,0,0,0,,Бұл әжеден бері ұрпаққа жалғасып келеді.
Dialogue: 0,0:05:46.47,0:05:48.80,jp,,0,0,0,,Цуцара, беделді Aria компаниясына жаңадан келген
Dialogue: 0,0:05:48.80,0:05:50.97,jp,,0,0,0,,Мен қызықпын және оны қараймын.
Dialogue: 0,0:05:51.22,0:05:54.60,jp,,0,0,0,,Иә, мен оны тексеремін, бірақ егер бұл біртүрлі жаңа жігіт болса.
Dialogue: 0,0:05:54.60,0:05:56.31,jp,,0,0,0,,Сібірге жіберілді
Dialogue: 0,0:05:57.56,0:05:59.73,jp,,0,0,0,,Сонымен, Сібір қайда?
Dialogue: 0,0:05:59.73,0:06:01.69,jp,,0,0,0,,Мен шынымен білмеймін.
Dialogue: 0,0:06:01.69,0:06:04.32,jp,,0,0,0,,Мм, сен қалай зерттейсің?
Dialogue: 0,0:06:04.69,0:06:07.32,jp,,0,0,0,,Гондола қауымдастығының тіркеу деректері
Dialogue: 0,0:06:07.49,0:06:08.99,jp,,0,0,0,,Түсіндім.
Dialogue: 0,0:06:08.99,0:06:12.95,jp,,0,0,0,,Ал, филиал менеджерінен алынған ақпарат бойынша.
Dialogue: 0,0:06:12.95,0:06:15.58,jp,,0,0,0,,Бұрынғы жартылай тегін шабандоз
Dialogue: 0,0:06:15.58,0:06:19.58,jp,,0,0,0,,Алайда, Aria компаниясының керемет күшімен мен ойымды өзгерттім.
Dialogue: 0,0:06:19.83,0:06:22.88,jp,,0,0,0,,Мм, екеуің мысық іздеп жүрсіңдер ме?
Dialogue: 0,0:06:22.88,0:06:23.92,jp,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:06:23.92,0:06:27.67,jp,,0,0,0,,Осы жерде көк көзді мысық пайда болады деген қауесет бар.
Dialogue: 0,0:06:27.67,0:06:30.93,jp,,0,0,0,,Біз қазір Himeya негізгі дүкенінің президентін іріктеудеміз.
Dialogue: 0,0:06:31.55,0:06:32.64,jp,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:32.64,0:06:36.93,jp,,0,0,0,,Сонымен, Ай-сан, сен Кейт Ситті іздеп пе едің?
Dialogue: 0,0:06:36.93,0:06:39.48,jp,,0,0,0,,Ахахаха, мүмкін емес.
Dialogue: 0,0:06:39.48,0:06:41.90,jp,,0,0,0,,Мен бұл туралы Алиса-сенпайдан да сұрадым.
Dialogue: 0,0:06:42.23,0:06:46.40,jp,,0,0,0,,Ай-санда керемет жұмбақ кездесулер Акари-саннан кейінгі ең жоғары көрсеткішке ие.
Dialogue: 0,0:06:47.40,0:06:48.94,jp,,0,0,0,,Мүмкін...
Dialogue: 0,0:06:49.20,0:06:51.91,jp,,0,0,0,,Мен бұрын көлеңке көрдім деп ойладым.
Dialogue: 0,0:06:52.49,0:06:54.20,jp,,0,0,0,,Бұл мені қуантты.
Dialogue: 0,0:06:54.20,0:06:56.79,jp,,0,0,0,,Егер мені қуып бара жатсаңыз, осы жерде
Dialogue: 0,0:06:56.79,0:07:00.08,jp,,0,0,0,,Сонымен, мен біртүрлі нәрсе айтып тұрмын ба?
Dialogue: 0,0:07:00.46,0:07:02.29,jp,,0,0,0,,Жоқ, бар, өте көп.
Dialogue: 0,0:07:02.71,0:07:03.63,jp,,0,0,0,,болып табылады
Dialogue: 0,0:07:03.63,0:07:07.42,jp,,0,0,0,,Жарайды, онда бірге іздейміз, жарай ма?
Dialogue: 0,0:07:08.01,0:07:09.76,jp,,0,0,0,,Бұта емес
Dialogue: 0,0:07:09.97,0:07:11.80,jp,,0,0,0,,Филиал меңгерушісі жиі айтады
Dialogue: 0,0:07:11.80,0:07:16.01,jp,,0,0,0,,Бұл керемет күшпен келетін керемет нәрседен үзіліс алудың жақсы мүмкіндігі.
Dialogue: 0,0:07:16.22,0:07:19.64,jp,,0,0,0,,Енді бір сәт бір-бірімізбен ойнайық.
Dialogue: 0,0:07:21.14,0:07:22.39,jp,,0,0,0,,№
Dialogue: 0,0:07:22.40,0:07:24.31,jp,,0,0,0,,Осы жерден тағы барайық.
Dialogue: 0,0:07:24.31,0:07:26.61,jp,,0,0,0,,Шынымен бе?
Dialogue: 0,0:07:26.61,0:07:28.40,jp,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:07:35.91,0:07:37.66,jp,,0,0,0,,Мен енді жүре алмаймын
Dialogue: 0,0:07:37.66,0:07:40.95,jp,,0,0,0,,Демалу дегенді білмейсің бе?
Dialogue: 0,0:07:40.96,0:07:43.04,jp,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:07:43.08,0:07:45.04,jp,,0,0,0,,Өте керемет
Dialogue: 0,0:07:45.29,0:07:46.54,jp,,0,0,0,,Қорқынышты
Dialogue: 0,0:07:46.54,0:07:48.96,jp,,0,0,0,,Шәй ішкің келе ме?
Dialogue: 0,0:07:48.96,0:07:50.76,jp,,0,0,0,,Ол бар, көп бар
Dialogue: 0,0:07:50.76,0:07:52.05,jp,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:07:54.34,0:07:56.34,jp,,0,0,0,,Сізді күткенім үшін кешіріңіз, Президент Ария.
Dialogue: 0,0:08:00.98,0:08:02.60,jp,,0,0,0,,Мен ақыры дем ала аламын.
Dialogue: 0,0:08:03.02,0:08:04.52,jp,,0,0,0,,тым кеш
Dialogue: 0,0:08:04.60,0:08:07.52,jp,,0,0,0,,Азуса-чан, мен бүгін көп жаттығу жасаған жоқпын.
Dialogue: 0,0:08:07.52,0:08:09.48,jp,,0,0,0,,Айка-сан саған ашуланбайды ма?
Dialogue: 0,0:08:09.48,0:08:11.53,jp,,0,0,0,,Мияу мияу, жоқ
Dialogue: 0,0:08:11.65,0:08:16.32,jp,,0,0,0,,Бірақ мен жаңа президенттікке үміткер болу үшін мысық іздедім.
Dialogue: 0,0:08:16.32,0:08:18.62,jp,,0,0,0,,Мен негізінен Кейт Ситті іздедім.
Dialogue: 0,0:08:18.62,0:08:19.87,jp,,0,0,0,,Мияу мияу
Dialogue: 0,0:08:19.87,0:08:22.87,jp,,0,0,0,,Алиса-сенпайға қарағанда, Айка-сан қатал.
Dialogue: 0,0:08:22.87,0:08:24.83,jp,,0,0,0,,Сізді қандай жаза күтіп тұр?
Dialogue: 0,0:08:25.08,0:08:27.46,jp,,0,0,0,,А, бұл жаман болуы мүмкін.
Dialogue: 0,0:08:27.63,0:08:31.63,jp,,0,0,0,,Екеуің бірге жаттығу жасайсыңдар ма?
Dialogue: 0,0:08:32.05,0:08:33.42,jp,,0,0,0,,Иә, иә.
Dialogue: 0,0:08:33.42,0:08:34.84,jp,,0,0,0,,Бірдей дерлік
Dialogue: 0,0:08:36.14,0:08:39.68,jp,,0,0,0,,Мм, мен де сізге қосылғым келеді.
Dialogue: 0,0:08:40.43,0:08:41.52,jp,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:08:44.56,0:08:45.56,jp,,0,0,0,,Әрине
Dialogue: 0,0:08:50.19,0:08:52.82,jp,,0,0,0,,Акари-сан, бұл болуы мүмкін бе?
Dialogue: 0,0:08:52.82,0:08:55.74,jp,,0,0,0,,Бұл сізге Кейт Сит берген керемет емес пе?
Dialogue: 0,0:08:55.91,0:08:57.99,jp,,0,0,0,,Иә, мен сенімдімін.
Dialogue: 0,0:08:57.99,0:08:59.57,jp,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:01.29,0:09:02.83,jp,,0,0,0,,Кэйт Сит?
Dialogue: 0,0:09:03.58,0:09:05.08,jp,,0,0,0,,Қазірдің өзінде, бір жерде
Dialogue: 0,0:09:05.08,0:09:07.08,jp,,0,0,0,,Сіз мені бақылап отырсыз, солай емес пе?
Dialogue: 0,0:09:07.75,0:09:09.92,jp,,0,0,0,,Ойланып қарашы, Акари-сан
Dialogue: 0,0:09:09.92,0:09:12.13,jp,,0,0,0,,Сіз Кейт Ситпен қайта кездестіңіз бе?
Dialogue: 0,0:09:18.01,0:09:21.22,jp,,0,0,0,,Сол жолы соңғы рет мен болатын
Dialogue: 0,0:09:26.35,0:09:29.15,jp,,0,0,0,,Иә, Кэйт Сит.
Dialogue: 0,0:09:29.15,0:09:33.44,jp,,0,0,0,,Иә, соңғы кездері сені мүлдем көре алмай жүрмін.
Dialogue: 0,0:09:33.82,0:09:35.65,jp,,0,0,0,,Бұл үлкен ұят.
Dialogue: 0,0:09:35.65,0:09:38.49,jp,,0,0,0,,Иә, мүмкін.
Dialogue: 0,0:09:38.49,0:09:40.16,jp,,0,0,0,,Меніңше, біз енді кездесе алмаймыз ба?
Dialogue: 0,0:09:43.33,0:09:46.04,jp,,0,0,0,,Біз прима болғымыз келеді
Dialogue: 0,0:09:46.04,0:09:49.42,jp,,0,0,0,,Ересек адам болу деген осы емес пе?
Dialogue: 0,0:09:49.42,0:09:53.00,jp,,0,0,0,,Сонымен, балалар ғана көре алатын дүниеден,
Dialogue: 0,0:09:53.00,0:09:55.46,jp,,0,0,0,,Бұл оқуды аяқтау керек дегенді білдірмейді ме?
Dialogue: 0,0:09:59.51,0:10:00.51,jp,,0,0,0,,Өзің бар
Dialogue: 0,0:10:01.10,0:10:02.60,jp,,0,0,0,,Соңында
Dialogue: 0,0:10:02.60,0:10:05.31,jp,,0,0,0,,Бір көргеннен болса да сенімен танысқым келеді.
Dialogue: 0,0:10:14.53,0:10:16.44,jp,,0,0,0,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:10:22.37,0:10:24.12,jp,,0,0,0,,Барамыз ба?
Dialogue: 0,0:10:29.25,0:10:30.83,jp,,0,0,0,,Қараңызшы, мінеки.
Dialogue: 0,0:10:31.38,0:10:33.75,jp,,0,0,0,,Нео-Венецияның жеті кереметінің бірі
Dialogue: 0,0:10:33.75,0:10:35.05,jp,,0,0,0,,Бақытсыздық тасы
Dialogue: 0,0:10:35.42,0:10:36.88,jp,,0,0,0,,Бақытсыздықтың тасы?
Dialogue: 0,0:10:36.88,0:10:39.13,jp,,0,0,0,,О, мен білемін.
Dialogue: 0,0:10:39.13,0:10:42.89,jp,,0,0,0,,Бұл тас Мэнгомның Венециялық анекдотын қайталады.
Dialogue: 0,0:10:42.97,0:10:45.01,jp,,0,0,0,,Тас салыстырмалы түрде танымал.
Dialogue: 0,0:10:45.64,0:10:48.35,jp,,0,0,0,,Әй, бәрі қашып жатыр.
Dialogue: 0,0:10:48.35,0:10:49.23,jp,,0,0,0,,Иә
Dialogue: 0,0:10:49.23,0:10:51.56,jp,,0,0,0,,Бассаң жамандық болады дейді.
Dialogue: 0,0:10:51.73,0:10:53.10,jp,,0,0,0,,Жаман деген не?
Dialogue: 0,0:10:53.11,0:10:56.82,jp,,0,0,0,,Бұл бәрібір жақсы емес.
Dialogue: 0,0:10:56.82,0:10:58.28,jp,,0,0,0,,Бұл қорқынышты тастың бір түрі.
Dialogue: 0,0:10:58.28,0:10:59.90,jp,,0,0,0,,Енді бастайық.
Dialogue: 0,0:10:59.90,0:11:01.49,jp,,0,0,0,,Сәлем, кенже! ?
Dialogue: 0,0:11:01.53,0:11:02.49,jp,,0,0,0,,Эйяаа
Dialogue: 0,0:11:03.95,0:11:05.03,jp,,0,0,0,,Ах
Dialogue: 0,0:11:05.28,0:11:06.58,jp,,0,0,0,,Бақытсыздық тасына
Dialogue: 0,0:11:06.58,0:11:07.74,jp,,0,0,0,,Мен міндім
Dialogue: 0,0:11:07.75,0:11:10.83,jp,,0,0,0,,Не істеп жатырсың, қызым?
Dialogue: 0,0:11:11.12,0:11:13.29,jp,,0,0,0,,Ештеңе болмайды.
Dialogue: 0,0:11:13.71,0:11:15.75,jp,,0,0,0,,Мүмкін деп ойладым
Dialogue: 0,0:11:15.75,0:11:16.29,jp,,0,0,0,,Иә?
Dialogue: 0,0:11:16.50,0:11:17.42,jp,,0,0,0,,Жарайды
Dialogue: 0,0:11:18.01,0:11:20.05,jp,,0,0,0,,Мен оны бала кезімде талай рет басқанмын.
Dialogue: 0,0:11:20.05,0:11:22.34,jp,,0,0,0,,Ерекше ештеңе болған жоқ.
Dialogue: 0,0:11:22.34,0:11:24.84,jp,,0,0,0,,Дұрыс, мені қорқытпа.
Dialogue: 0,0:11:24.97,0:11:27.01,jp,,0,0,0,,Бірақ егер сіз Акари-сенпаймен бірге болсаңыз
Dialogue: 0,0:11:27.06,0:11:28.47,jp,,0,0,0,,Мен бұл мүмкін деп ойладым.
Dialogue: 0,0:11:28.60,0:11:30.02,jp,,0,0,0,,Қорқынышты эксперименттерге жол берілмейді
Dialogue: 0,0:11:33.60,0:11:35.19,jp,,0,0,0,,Аа, бұл қазірдің өзінде ұзақ
Dialogue: 0,0:11:35.19,0:11:36.27,jp,,0,0,0,,Айка-чан
Dialogue: 0,0:11:36.27,0:11:38.78,jp,,0,0,0,,Бүгін мен кіші сыныптарға сабақ беремін.
Dialogue: 0,0:11:38.78,0:11:40.44,jp,,0,0,0,,Нана, мен ұмытып қалдым.
Dialogue: 0,0:11:40.86,0:11:42.78,jp,,0,0,0,,Мен мектепке баруым керек.
Dialogue: 0,0:11:44.20,0:11:45.57,jp,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:11:45.57,0:11:46.49,jp,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:11:46.49,0:11:47.53,jp,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:11:50.12,0:11:51.20,jp,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:11:51.79,0:11:54.25,jp,,0,0,0,,Мен де жұмысқа қайта оралуым керек.
Dialogue: 0,0:11:58.63,0:12:03.01,jp,,0,0,0,,Нео-Венецияның жеті кереметінің бірі - бақытсыздық тасы ма?
Dialogue: 0,0:12:17.31,0:12:19.94,jp,,0,0,0,,Біз мінеміз бе?
Dialogue: 0,0:12:21.03,0:12:22.44,jp,,0,0,0,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:12:22.45,0:12:24.45,jp,,0,0,0,,Сіз Кейт Ситті кездестіруіңіз мүмкін
Dialogue: 0,0:12:40.67,0:12:41.38,jp,,0,0,0,,Жарайды
Dialogue: 0,0:13:06.24,0:13:10.07,jp,,0,0,0,,Күткендей ештеңе болмайды, президент Ария.
Dialogue: 0,0:13:14.41,0:13:18.12,jp,,0,0,0,,Мен Кейт Ситті енді ешқашан көрмеймін деп ойлаймын.
Dialogue: 0,0:13:22.63,0:13:25.22,jp,,0,0,0,,Мен өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:13:42.69,0:13:44.57,jp,,0,0,0,,Хохе?
Dialogue: 0,0:14:03.96,0:14:04.88,jp,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:14:05.26,0:14:07.09,jp,,0,0,0,,Ақыры біз кездестік
Dialogue: 0,0:14:07.84,0:14:10.93,jp,,0,0,0,,Мен сені іздедім
Dialogue: 0,0:14:10.93,0:14:12.89,jp,,0,0,0,,Мен сенімен осылай қайта кездесуге мүмкіндік алдым.
Dialogue: 0,0:14:12.89,0:14:15.01,jp,,0,0,0,,Мен шынымен бақыттымын
Dialogue: 0,0:14:22.82,0:14:25.98,jp,,0,0,0,,Мен сені келесі жолы көруге барамын.
Dialogue: 0,0:14:26.99,0:14:29.65,jp,,0,0,0,,Сізді қай жерде кездестіруге болады?
Dialogue: 0,0:14:29.66,0:14:32.28,jp,,0,0,0,,Сол тасты тағы басайын ба?
Dialogue: 0,0:14:37.96,0:14:42.75,jp,,0,0,0,,Қайта кездесе алмаймыз ба? енді ешқашан
Dialogue: 0,0:14:44.42,0:14:47.84,jp,,0,0,0,,Мен мұны қаламаймын.
Dialogue: 0,0:14:59.69,0:15:01.27,jp,,0,0,0,,Сіз мұнда мәңгі болдыңыз ба?
Dialogue: 0,0:15:24.79,0:15:27.46,jp,,0,0,0,,Мен ұмытпаймын
Dialogue: 0,0:15:27.71,0:15:30.97,jp,,0,0,0,,Мен сені ешқашан ұмытпаймын
Dialogue: 0,0:15:39.68,0:15:41.35,jp,,0,0,0,,Сонымен
Dialogue: 0,0:15:42.60,0:15:45.44,jp,,0,0,0,,Біз мұнда мәңгі бірге болдық.
Dialogue: 0,0:16:27.73,0:16:29.23,jp,,0,0,0,,Президент Ария
Dialogue: 0,0:16:53.67,0:16:55.47,jp,,0,0,0,,Бұл әдемі, солай емес пе?
Dialogue: 0,0:16:55.47,0:16:56.72,jp,,0,0,0,,Иә
Dialogue: 0,0:16:57.22,0:16:58.93,jp,,0,0,0,,Бұлдағы жарық
Dialogue: 0,0:16:59.14,0:17:01.85,jp,,0,0,0,,Мұның бәрі бір ғажайып шығар.
Dialogue: 0,0:17:02.52,0:17:05.56,jp,,0,0,0,,Жарқырап тұрғаны сондықтан шығар.
Dialogue: 0,0:17:07.35,0:17:08.90,jp,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:09.40,0:17:10.98,jp,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:13.57,0:17:16.40,jp,,0,0,0,,Ай Чанның бүгін алған кереметі
Dialogue: 0,0:17:16.41,0:17:18.53,jp,,0,0,0,,Бұл жарқыраған кездесу.
Dialogue: 0,0:17:18.53,0:17:21.53,jp,,0,0,0,,Иә, үшеуміз көп жаттығу жасадық.
Dialogue: 0,0:17:21.54,0:17:23.87,jp,,0,0,0,,Прима Ундинге ұмтылу
Dialogue: 0,0:17:23.87,0:17:28.62,jp,,0,0,0,,Бірақ мен әлі күнге дейін Кейт Ситпен кездескім келеді.
Dialogue: 0,0:17:30.88,0:17:32.59,jp,,0,0,0,,Егер кездессек
Dialogue: 0,0:17:32.59,0:17:35.17,jp,,0,0,0,,Қоштасатын уақыт міндетті түрде келеді
Dialogue: 0,0:17:35.88,0:17:39.47,jp,,0,0,0,,Бірақ сол күні қоштасуы керек болған Кэйт Ситке,
Dialogue: 0,0:17:39.60,0:17:43.10,jp,,0,0,0,,Ай Чанның арқасында мен қайта кездескендей болдым.
Dialogue: 0,0:17:44.14,0:17:45.39,jp,,0,0,0,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:17:45.39,0:17:47.14,jp,,0,0,0,,Махаббат сезімі
Dialogue: 0,0:17:47.14,0:17:50.15,jp,,0,0,0,,Мүмкін ол ғажайыпты шақырар.
Dialogue: 0,0:17:57.72,0:18:12.57,jp,,0,0,0,,Тыныш көгілдірде мен алыстағы жоғалып бара жатқан бұлттарды тілеймін
Dialogue: 0,0:18:12.77,0:18:31.33,jp,,0,0,0,,Екеуміздің таңымыз, жолға шығамыз, кететін сәт
Dialogue: 0,0:18:31.33,0:18:43.35,jp,,0,0,0,,Енді бірге ескек есуді бастайық.
Dialogue: 0,0:18:43.93,0:18:52.27,jp,,0,0,0,,Бірте-бірте жүрейік
Dialogue: 0,0:18:52.56,0:18:58.78,jp,,0,0,0,,Иә, мен оны үнемі байқадым.
Dialogue: 0,0:18:58.86,0:19:12.58,jp,,0,0,0,,Ол қазір жоқ болса да, мені бақылап отырды
Dialogue: 0,0:19:12.79,0:19:19.47,jp,,0,0,0,,Иә, бақыт деген осы.
Dialogue: 0,0:19:19.51,0:19:42.66,jp,,0,0,0,,Мен сенің маған үйреткеніңді ешқашан ұмытпаймын, қазір де есімде.
Dialogue: 0,0:19:43.62,0:19:46.08,jp,,0,0,0,,Мәңгілік
Dialogue: 0,0:19:47.58,0:19:53.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory