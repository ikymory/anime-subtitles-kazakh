Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:57.84,0:01:01.85,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:01:38.89,0:01:40.01,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:01:44.39,0:01:47.94,Default,,0,0,0,,Қош бол сау бол Ча бай Инья
Dialogue: 0,0:01:48.35,0:01:52.52,Default,,0,0,0,,Мияу ~ Бынья Бынья ~
Dialogue: 0,0:01:53.44,0:01:55.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:55.78,0:01:57.45,Default,,0,0,0,,Қатты жақын қашықтықтағы шайқаста ол дерлік ешқандай осал тұс қалдырмайды—
Dialogue: 0,0:01:58.15,0:02:00.66,Default,,0,0,0,,Амансың ба? Ария президенті
Dialogue: 0,0:02:01.83,0:02:07.29,Default,,0,0,0,,Менің құстармен дос болу жоспарым орындалмай жатыр.
Dialogue: 0,0:02:07.37,0:02:08.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:09.33,0:02:12.17,Default,,0,0,0,,Президент Ариядан бас тартпай барымызды салайық
Dialogue: 0,0:02:12.67,0:02:14.30,Default,,0,0,0,,Сенсең, бұл Ғажайып
Dialogue: 0,0:02:14.63,0:02:16.30,Default,,0,0,0,,Мен де мүмкіндігінше тезірек
Dialogue: 0,0:02:16.38,0:02:19.47,Default,,0,0,0,,Мен Прима Ундин болу үшін көп жұмыс істеуім керек.
Dialogue: 0,0:02:19.80,0:02:21.26,Default,,0,0,0,,Енді жаттығуды орындаңыз
Dialogue: 0,0:02:21.64,0:02:24.43,Default,,0,0,0,,Уфуфу Ай Чан, сен қатты толқыдың.
Dialogue: 0,0:02:24.64,0:02:27.98,Default,,0,0,0,,Иә, мен бойдаққа көтерілгеннен бері.
Dialogue: 0,0:02:28.06,0:02:29.69,Default,,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:02:31.27,0:02:35.78,Default,,0,0,0,,Олай болса, бүгінгі жаттығуға кетейік. Алдын ала рахмет.
Dialogue: 0,0:02:36.19,0:02:37.40,Default,,0,0,0,,Иә
Dialogue: 0,0:02:46.12,0:02:49.04,Default,,0,0,0,,Аква су планетасындағы Нео Венеция
Dialogue: 0,0:02:50.25,0:02:53.79,Default,,0,0,0,,Бұл бір кездері Мангом болған Венеция қаласы.
Dialogue: 0,0:02:53.88,0:02:56.46,Default,,0,0,0,,Көшірілген қала сияқты көшірілді
Dialogue: 0,0:02:58.09,0:03:00.80,Default,,0,0,0,,Жаңа мен ескі араласады
Dialogue: 0,0:03:01.43,0:03:06.10,Default,,0,0,0,,Уақыт баяу өтіп, кейде ғажайыптарға тап болатын қала
Dialogue: 0,0:03:08.60,0:03:12.65,Default,,0,0,0,,Бұл қаланы аралаудың ең жақсы жолы - жартылай жартылай жартылай саяхат.
Dialogue: 0,0:03:13.19,0:03:16.86,Default,,0,0,0,,Біз Undines деп аталатын ұшқышпыз.
Dialogue: 0,0:03:18.36,0:03:22.28,Default,,0,0,0,,Менің Aria компаниясында мен және Акари Мизунаши
Dialogue: 0,0:03:22.66,0:03:25.83,Default,,0,0,0,,Менің кіші қызым Ай Чан саған айналады көрсетеді.
Dialogue: 0,0:03:26.74,0:03:30.12,Default,,0,0,0,,Кәне, бірге тамаша саяхат жасайық.
Dialogue: 0,0:03:30.20,0:03:36.21,Default,,0,0,0,,♪〜
Dialogue: 0,0:05:13.81,0:05:19.81,Default,,0,0,0,,〜♪
Dialogue: 0,0:05:28.66,0:05:30.74,Default,,0,0,0,,Бұл екеуін кездестіргеніме көп болды.
Dialogue: 0,0:05:31.45,0:05:34.29,Default,,0,0,0,,Прима Ундин рөліндегі Элис пен Айка
Dialogue: 0,0:05:34.37,0:05:36.54,Default,,0,0,0,,Сіз тамаша жұмыс істеп жатырсыз.
Dialogue: 0,0:05:37.25,0:05:38.79,Default,,0,0,0,,А, бұл мысық~
Dialogue: 0,0:05:39.21,0:05:40.54,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:05:41.71,0:05:44.09,Default,,0,0,0,,Бұл үш адам қалай кездейсоқ кездесті?
Dialogue: 0,0:05:44.30,0:05:46.38,Default,,0,0,0,,Мен бұл Акваның маған берген кереметі екеніне сенімдімін.
Dialogue: 0,0:05:46.88,0:05:48.22,Default,,0,0,0,,Миракуру?
Dialogue: 0,0:05:53.56,0:05:56.06,Default,,0,0,0,,Алисия белсенді болған кезде
Dialogue: 0,0:05:56.18,0:05:58.56,Default,,0,0,0,,Мен күнде асығыспын...
Dialogue: 0,0:06:00.65,0:06:03.11,Default,,0,0,0,,Ахи… Бұл кесте
Dialogue: 0,0:06:03.52,0:06:07.28,Default,,0,0,0,,Осы қарқынмен, Алисия, сен демалуға уақыт таппайсың.
Dialogue: 0,0:06:07.36,0:06:08.20,Default,,0,0,0,,Bui~
Dialogue: 0,0:06:08.86,0:06:11.07,Default,,0,0,0,,Тез толыққанды адам болыңыз—
Dialogue: 0,0:06:11.70,0:06:14.91,Default,,0,0,0,,Мен де саған көмектесуім керек.
Dialogue: 0,0:06:15.66,0:06:17.79,Default,,0,0,0,,Ах~ Ах...
Dialogue: 0,0:06:20.42,0:06:22.13,Default,,0,0,0,,Сәлем Акира-сан
Dialogue: 0,0:06:23.13,0:06:24.92,Default,,0,0,0,,Фу (Акари) Эх~
Dialogue: 0,0:06:26.42,0:06:29.22,Default,,0,0,0,,Үйде істеу керек нәрсе жоқ па?
Dialogue: 0,0:06:29.38,0:06:31.97,Default,,0,0,0,,Жоқ, мен кездейсоқ өтіп бара жатырмын.
Dialogue: 0,0:06:32.43,0:06:35.52,Default,,0,0,0,,Мүмкін сенің Алисияға қатысың бар шығар?
Dialogue: 0,0:06:37.60,0:06:41.48,Default,,0,0,0,,Қазіргі... А, мен бүгін...
Dialogue: 0,0:06:44.32,0:06:46.86,Default,,0,0,0,,Иә, бұл Алисияның жасырын туған күні.
Dialogue: 0,0:06:47.28,0:06:50.36,Default,,0,0,0,,Мен оны мүлде байқамадым
Dialogue: 0,0:06:50.66,0:06:53.07,Default,,0,0,0,,Өйткені Акари-чан Мэнхомадан.
Dialogue: 0,0:06:53.32,0:06:54.16,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:06:54.83,0:06:58.54,Default,,0,0,0,,Aqua күнтізбесінде бір жылда 24 ай бар.
Dialogue: 0,0:06:58.75,0:07:01.54,Default,,0,0,0,,Сіз туған күніңізді 12 айдан кейін де тойладыңыз.
Dialogue: 0,0:07:01.83,0:07:03.84,Default,,0,0,0,,Иә, бұл құпия туған күн.
Dialogue: 0,0:07:04.34,0:07:07.46,Default,,0,0,0,,Алисияның туған күні 30 қазан.
Dialogue: 0,0:07:08.09,0:07:10.93,Default,,0,0,0,,Өйткені бүгін 30 ақпан...
Dialogue: 0,0:07:11.43,0:07:14.68,Default,,0,0,0,,Бүгін Алисияның жасырын туған күні.
Dialogue: 0,0:07:15.30,0:07:18.68,Default,,0,0,0,,Сол үшін маған сыйлық беруге келдің.
Dialogue: 0,0:07:18.77,0:07:23.40,Default,,0,0,0,,Аа, жоқ, мен бүгін біраз уақыттан кейін бірінші рет жарты күн демалыс алдым...
Dialogue: 0,0:07:23.65,0:07:25.73,Default,,0,0,0,,Жүзі мұңайып жұмыс істеп тұрған жігітке
Dialogue: 0,0:07:25.82,0:07:29.44,Default,,0,0,0,,Мен мұнда сені мазақ ету және өзін көрсету үшін келдім...
Dialogue: 0,0:07:30.45,0:07:31.36,Default,,0,0,0,,Фу
Dialogue: 0,0:07:32.74,0:07:36.24,Default,,0,0,0,,Алисия, бүгінгі тұтынушы соңғысы.
Dialogue: 0,0:07:36.45,0:07:40.16,Default,,0,0,0,,Кешкі сағат 18:00-дегі Гондола қауымдастығының жиналысына дейін тегін.
Dialogue: 0,0:07:40.54,0:07:42.54,Default,,0,0,0,,Кешіріңіз. Ой, ей!
Dialogue: 0,0:07:44.00,0:07:46.59,Default,,0,0,0,,Негізі Афина да келуі керек еді.
Dialogue: 0,0:07:47.42,0:07:49.42,Default,,0,0,0,,Менің шұғыл жұмысым бар сияқты.
Dialogue: 0,0:07:49.80,0:07:51.26,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:07:51.38,0:07:53.47,Default,,0,0,0,,А, иә, иә.
Dialogue: 0,0:07:57.31,0:07:59.89,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, бұл Aria компаниясы.
Dialogue: 0,0:08:00.43,0:08:01.60,Default,,0,0,0,,Акари-чан?
Dialogue: 0,0:08:01.68,0:08:03.23,Default,,0,0,0,,Ах, Алисия.
Dialogue: 0,0:08:03.73,0:08:07.57,Default,,0,0,0,,Кешіріңіз, бұдан былай мен Гондола қауымдастығының қонақтарымен сөйлесетін боламын.
Dialogue: 0,0:08:07.73,0:08:09.82,Default,,0,0,0,,Мен саған айнала көрсетуім керек еді.
Dialogue: 0,0:08:10.07,0:08:11.69,Default,,0,0,0,,А... иә
Dialogue: 0,0:08:12.24,0:08:15.95,Default,,0,0,0,,Жиналыс түнде болады, сондықтан мен бүгін үйге қайтайын.
Dialogue: 0,0:08:16.78,0:08:17.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:17.70,0:08:20.37,Default,,0,0,0,,Олай болса, сіз тұтынушыны күтіп отырсыз.
Dialogue: 0,0:08:20.87,0:08:21.70,Default,,0,0,0,,Иә
Dialogue: 0,0:08:26.04,0:08:28.34,Default,,0,0,0,,Акира-сан (Акира) Олай болса.
Dialogue: 0,0:08:28.42,0:08:29.25,Default,,0,0,0,,Bui?
Dialogue: 0,0:08:29.50,0:08:32.30,Default,,0,0,0,,Кешкі уақытта менде үйде жаттығу бар.
Dialogue: 0,0:08:32.63,0:08:33.84,Default,,0,0,0,,Мен үйге жайлап бара жатырмын
Dialogue: 0,0:08:34.47,0:08:38.10,Default,,0,0,0,,Мен саған сыйлық қалдырамын, ертең оны маған бер.
Dialogue: 0,0:08:39.35,0:08:40.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:42.52,0:08:44.23,Default,,0,0,0,,Акира-сан (Акира) Иә?
Dialogue: 0,0:08:44.98,0:08:48.19,Default,,0,0,0,,Осыдан кейін мен өз бетіммен жаттығым келеді.
Dialogue: 0,0:08:48.27,0:08:49.90,Default,,0,0,0,,Менімен келе аласыз ба?
Dialogue: 0,0:08:50.44,0:08:51.48,Default,,0,0,0,,Өз бетінше оқыту?
Dialogue: 0,0:08:51.65,0:08:55.28,Default,,0,0,0,,Иә, әсіресе Алисия жиі қолданатын курстар.
Dialogue: 0,0:08:56.07,0:08:56.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:57.20,0:08:58.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:00.16,0:09:04.37,Default,,0,0,0,,Әй, айтайын, менің басшылығым қатал.
Dialogue: 0,0:09:05.21,0:09:06.29,Default,,0,0,0,,Уау
Dialogue: 0,0:09:06.42,0:09:09.13,Default,,0,0,0,,Цуки… Цуки…
Dialogue: 0,0:09:41.87,0:09:45.87,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:09:50.13,0:09:53.38,Default,,0,0,0,,Рахмет, Акари-чан, қайтайық.
Dialogue: 0,0:09:54.51,0:09:55.46,Default,,0,0,0,,Иә
Dialogue: 0,0:09:59.64,0:10:04.02,Default,,0,0,0,,Негізі бүгінгі мақсатым саған сыйлық беру емес еді.
Dialogue: 0,0:10:05.31,0:10:06.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:07.39,0:10:10.06,Default,,0,0,0,,Біз бойдақ кезімізден бірге болдық
Dialogue: 0,0:10:10.15,0:10:13.02,Default,,0,0,0,,Еңбек етіп, прима бол
Dialogue: 0,0:10:13.32,0:10:16.03,Default,,0,0,0,,Олар үш ұлы су перісі деп аталды.
Dialogue: 0,0:10:17.28,0:10:19.95,Default,,0,0,0,,Бірақ үшеуміз кездесеміз...
Dialogue: 0,0:10:20.45,0:10:22.83,Default,,0,0,0,,Тек сол қиын болды...
Dialogue: 0,0:10:23.91,0:10:26.91,Default,,0,0,0,,Сондықтан мен бұл керемет деп ойлаймын.
Dialogue: 0,0:10:27.87,0:10:31.75,Default,,0,0,0,,Үшеуміз бірге кездесетін уақыт өте маңызды.
Dialogue: 0,0:10:33.29,0:10:36.17,Default,,0,0,0,,Сол күндерге қайта оралғым келмейді.
Dialogue: 0,0:10:37.30,0:10:38.55,Default,,0,0,0,,Мен неге таң қалдым
Dialogue: 0,0:10:39.22,0:10:42.89,Default,,0,0,0,,Мен бүгін үшеумізбен кездескім келді.
Dialogue: 0,0:10:44.22,0:10:45.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:47.35,0:10:49.69,Default,,0,0,0,,Бұл өте аянышты.
Dialogue: 0,0:10:50.39,0:10:52.61,Default,,0,0,0,,Ол кішкентай қыз емес.
Dialogue: 0,0:10:55.98,0:10:58.15,Default,,0,0,0,,Ах, о, о…
Dialogue: 0,0:10:58.82,0:10:59.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:07.62,0:11:08.62,Default,,0,0,0,,Алисия
Dialogue: 0,0:11:12.92,0:11:13.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:16.30,0:11:17.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:18.96,0:11:21.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:21.84,0:11:25.43,Default,,0,0,0,,(Афинаның ән салған дауысы)
Dialogue: 0,0:11:25.51,0:11:27.26,Default,,0,0,0,,бұл... а
Dialogue: 0,0:11:34.61,0:11:38.61,Default,,0,0,0,,(Афинаның ән салған дауысы)
Dialogue: 0,0:11:43.41,0:11:44.57,Default,,0,0,0,,Афина
Dialogue: 0,0:11:45.45,0:11:46.99,Default,,0,0,0,,Буйбуича~
Dialogue: 0,0:11:52.96,0:11:54.63,Default,,0,0,0,,Ху (Акари) Е...
Dialogue: 0,0:11:56.25,0:12:00.09,Default,,0,0,0,,Құрметті қауымдастық мүшелері, мен Химеядан келген Акира Э.Ферраримін.
Dialogue: 0,0:12:00.17,0:12:01.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:01.42,0:12:04.47,Default,,0,0,0,,Бір сәт дөрекілігім үшін кешіріңіз.
Dialogue: 0,0:12:05.55,0:12:07.64,Default,,0,0,0,,Ал, Алисия!
Dialogue: 0,0:12:10.56,0:12:11.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:22.57,0:12:24.20,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:12:25.87,0:12:26.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:27.49,0:12:28.58,Default,,0,0,0,,Акира-сан
Dialogue: 0,0:12:42.42,0:12:44.97,Default,,0,0,0,,Туған күніңмен Алисия!
Dialogue: 0,0:12:45.18,0:12:46.47,Default,,0,0,0,,Қош бол
Dialogue: 0,0:12:47.47,0:12:48.43,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:12:51.14,0:12:53.73,Default,,0,0,0,,Қош бол, сау бол
Dialogue: 0,0:12:59.19,0:13:02.19,Default,,0,0,0,,Рахмет, бәрі Акари-чанның арқасында.
Dialogue: 0,0:13:02.90,0:13:03.86,Default,,0,0,0,,Жоқ—
Dialogue: 0,0:13:05.24,0:13:09.12,Default,,0,0,0,,Бұл Миракуру. Бұл керемет, Акира-сан.
Dialogue: 0,0:13:10.45,0:13:12.50,Default,,0,0,0,,Ахахахха
Dialogue: 0,0:13:13.58,0:13:15.83,Default,,0,0,0,,Бұл артық айтқандық, Акари-чан.
Dialogue: 0,0:13:16.17,0:13:17.83,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:13:19.17,0:13:21.55,Default,,0,0,0,,Бірақ бұл шынымен де ғажайып.
Dialogue: 0,0:13:22.13,0:13:22.96,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:13:26.34,0:13:28.34,Default,,0,0,0,,Мұны айтқанда Акира күлді.
Dialogue: 0,0:13:28.68,0:13:31.14,Default,,0,0,0,,Алисия да, Афина да —
Dialogue: 0,0:13:31.81,0:13:36.14,Default,,0,0,0,,Сол кездегі күлкің кішкентай қыздың күлкісі сияқты еді.
Dialogue: 0,0:13:41.27,0:13:43.53,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:13:43.61,0:13:44.44,Default,,0,0,0,,Иә
Dialogue: 0,0:13:45.90,0:13:49.03,Default,,0,0,0,,Мен де... Мен де бір күні...
Dialogue: 0,0:13:49.24,0:13:51.87,Default,,0,0,0,,Алисия үшін Акира мен Афина
Dialogue: 0,0:13:52.20,0:13:55.83,Default,,0,0,0,,Акари-сан үшін, Айка-сан және Алиса-сан сияқты біреумен...
Dialogue: 0,0:13:56.04,0:13:57.58,Default,,0,0,0,,Біз кездесеміз деп үміттенемін
Dialogue: 0,0:13:58.08,0:14:01.25,Default,,0,0,0,,Иә, мен де Ай Чанды кездестіретінімізге сенімдімін.
Dialogue: 0,0:14:01.54,0:14:02.42,Default,,0,0,0,,Айня~
Dialogue: 0,0:14:03.09,0:14:07.63,Default,,0,0,0,,Өйткені бұл Ғажайып Аква планетасына келді.
Dialogue: 0,0:14:08.01,0:14:10.76,Default,,0,0,0,,Ха... иә
Dialogue: 0,0:14:16.85,0:14:19.19,Default,,0,0,0,,Біреумен кездескіңіз келсе кездесе білу
Dialogue: 0,0:14:19.85,0:14:22.02,Default,,0,0,0,,Даусыңды естігің келген кезде ести білу
Dialogue: 0,0:14:23.32,0:14:25.36,Default,,0,0,0,,Кейде сіз бұл ештеңе емес деп ойлайсыз
Dialogue: 0,0:14:25.69,0:14:28.61,Default,,0,0,0,,Бұл керемет Миракуру болуы мүмкін
Dialogue: 0,0:14:29.70,0:14:33.37,Default,,0,0,0,,Енді мен Ай Чанмен біргемін,
Dialogue: 0,0:14:48.88,0:14:50.34,Default,,0,0,0,,Сен бүкіл отбасыңмен бірге осыған көшіп алғаның дұрыс.
Dialogue: 0,0:14:50.47,0:14:53.76,Default,,0,0,0,,Хмм, қанағаттандым (2-тұтынушы) Гондола ең жақсы~
Dialogue: 0,0:14:54.05,0:14:56.68,Default,,0,0,0,,Акари-сан Пунюпу-и
Dialogue: 0,0:14:56.81,0:14:58.93,Default,,0,0,0,,Бұл қиын! Бұл Миракуру!
Dialogue: 0,0:14:59.14,0:15:01.19,Default,,0,0,0,,Ай-чан Тұтынушы...
Dialogue: 0,0:15:01.56,0:15:03.36,Default,,0,0,0,,Ах, кешіріңіз.
Dialogue: 0,0:15:03.94,0:15:06.19,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Маған қол ұшын беріңіз.
Dialogue: 0,0:15:06.32,0:15:09.45,Default,,0,0,0,,Рахмет, керемет нәрсе болды.
Dialogue: 0,0:15:09.74,0:15:13.78,Default,,0,0,0,,Иә, бұл қала ғажайыптарға толы.
Dialogue: 0,0:15:13.99,0:15:15.49,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:15:15.58,0:15:18.50,Default,,0,0,0,,Біз Миракурумен де кездестік.
Dialogue: 0,0:15:19.00,0:15:21.75,Default,,0,0,0,,Сол үшін мен ертең шамам келгенше жүремін.
Dialogue: 0,0:15:21.83,0:15:23.58,Default,,0,0,0,,Бұл Гаттен (Акари) Уфуфу
Dialogue: 0,0:15:24.17,0:15:25.54,Default,,0,0,0,,Рахмет~
Dialogue: 0,0:15:25.67,0:15:27.55,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:27.76,0:15:29.38,Default,,0,0,0,,Қай жерде тамақтану керек?
Dialogue: 0,0:15:29.47,0:15:32.76,Default,,0,0,0,,Мен Китараны қолданып көргім келеді (1-тұтынушы) Ах, жақсы...
Dialogue: 0,0:15:32.84,0:15:35.51,Default,,0,0,0,,Ай Чанның Миракурусы ше?
Dialogue: 0,0:15:35.76,0:15:37.26,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:15:37.47,0:15:39.39,Default,,0,0,0,,Тыңдашы, Акари-сан.
Dialogue: 0,0:15:39.52,0:15:42.94,Default,,0,0,0,,Керемет, ғажап, ғажайып нәрсе болды.
Dialogue: 0,0:15:43.02,0:15:44.69,Default,,0,0,0,,А, қызық, бұл не?
Dialogue: 0,0:15:44.77,0:15:46.23,Default,,0,0,0,,Сәлем, президент Ария
Dialogue: 0,0:15:46.36,0:15:47.36,Default,,0,0,0,,Сүйкімді!
Dialogue: 0,0:15:47.44,0:15:49.61,Default,,0,0,0,,Президент Ария қатты толқыды
Dialogue: 0,0:15:49.74,0:15:52.95,Default,,0,0,0,,Бұл шынымен жұмбақ.
Dialogue: 0,0:15:53.61,0:15:54.95,Default,,0,0,0,,Мүмкін мен...
Dialogue: 0,0:15:55.16,0:15:58.91,Default,,0,0,0,,Мен Акваның кереметіне кіретін жерді тапқан шығармын.
Dialogue: 0,0:15:58.99,0:16:01.71,Default,,0,0,0,,Не? Не? Не болды?
Dialogue: 0,0:16:12.34,0:16:13.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:16.43,0:16:18.51,Default,,0,0,0,,Сәлем~ (Ер адам) Йо
Dialogue: 0,0:16:18.81,0:16:21.06,Default,,0,0,0,,Жалпы пікір жақсаруда.
Dialogue: 0,0:16:21.14,0:16:22.48,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:16:22.69,0:16:25.27,Default,,0,0,0,,Қолыңнан келгенін істе~ Рахмет
Dialogue: 0,0:16:25.52,0:16:27.98,Default,,0,0,0,,Жұмысыңызға сәттілік, ағай да!
Dialogue: 0,0:16:28.23,0:16:29.11,Default,,0,0,0,,Уау
Dialogue: 0,0:16:31.86,0:16:33.32,Default,,0,0,0,,Фу мфуфуфуфуфу
Dialogue: 0,0:16:34.11,0:16:36.95,Default,,0,0,0,,Мен керемет күн болатынын сеземін.
Dialogue: 0,0:16:38.83,0:16:41.75,Default,,0,0,0,,Жоқ, жоқ, мен мұндай нәрсеге риза емеспін.
Dialogue: 0,0:16:42.08,0:16:43.50,Default,,0,0,0,,Практика
Dialogue: 0,0:16:45.21,0:16:47.58,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:16:49.00,0:16:49.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:59.56,0:17:02.77,Default,,0,0,0,,Осындай жерде аллея болды ма?
Dialogue: 0,0:17:04.14,0:17:05.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:08.65,0:17:09.90,Default,,0,0,0,,Мысық…
Dialogue: 0,0:17:12.40,0:17:16.11,Default,,0,0,0,,Жоқ, бұл... Кэйт Сит
Dialogue: 0,0:17:18.24,0:17:20.03,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:17:21.62,0:17:23.79,Default,,0,0,0,,Қош бол... қош бол~
Dialogue: 0,0:17:24.12,0:17:30.13,Default,,0,0,0,,♪〜
Dialogue: 0,0:18:53.75,0:18:59.76,Default,,0,0,0,,〜♪
Dialogue: 0,0:19:05.97,0:19:08.31,Default,,0,0,0,,Міне...
Dialogue: 0,0:19:08.89,0:19:10.31,Default,,0,0,0,,Қош бол
Dialogue: 0,0:19:12.23,0:19:14.82,Default,,0,0,0,,Оның мұндай жерге қосылғанына сене алар емеспін...
Dialogue: 0,0:19:15.11,0:19:16.98,Default,,0,0,0,,Президент Ария, сіз білесіз бе?
Dialogue: 0,0:19:17.15,0:19:18.28,Default,,0,0,0,,О
Dialogue: 0,0:19:21.66,0:19:22.49,Default,,0,0,0,,Е...
Dialogue: 0,0:19:22.78,0:19:25.99,Default,,0,0,0,,Мияу~ Мияу~ Мияу~
Dialogue: 0,0:19:26.24,0:19:30.50,Default,,0,0,0,,Хаа, бұл өте жақсы, мен оны жоғалтып алдым деп ойлаймын.
Dialogue: 0,0:19:31.17,0:19:32.79,Default,,0,0,0,,Иә? Мияу мияу!?
Dialogue: 0,0:19:32.88,0:19:37.96,Default,,0,0,0,,Мен мысықтың бізді жайып салатын адам емес екеніне сенімдімін.
Dialogue: 0,0:19:38.30,0:19:39.30,Default,,0,0,0,,Муо!
Dialogue: 0,0:19:39.59,0:19:42.97,Default,,0,0,0,,Мүмкін сіз Кейт Ситті іздеп жүрген боларсыз?
Dialogue: 0,0:19:43.22,0:19:46.22,Default,,0,0,0,,ше? Кейт Ситті іздеп жүрсіз бе?
Dialogue: 0,0:19:46.35,0:19:49.77,Default,,0,0,0,,Ах, Aria компаниясының жаңа мүшесі.
Dialogue: 0,0:19:49.98,0:19:53.48,Default,,0,0,0,,Не? Ах... сендер балалар...
Dialogue: 0,0:20:00.03,0:20:02.28,Default,,0,0,0,,Мен Азуса Б. Макларенмін
Dialogue: 0,0:20:02.57,0:20:05.82,Default,,0,0,0,,Химейя филиалында филиал менеджері маған тікелей басшылық береді.
Dialogue: 0,0:20:06.58,0:20:09.95,Default,,0,0,0,,Өзім айтсам да, болашағы зор қор.
Dialogue: 0,0:20:10.16,0:20:12.12,Default,,0,0,0,,Аня Достоевская
Dialogue: 0,0:20:12.21,0:20:15.71,Default,,0,0,0,,Қызғылт сары планетада мен Алиса-сенпайға қарыздармын.
Dialogue: 0,0:20:15.83,0:20:18.55,Default,,0,0,0,,Аа, мен Айно Аймын.
Dialogue: 0,0:20:18.67,0:20:20.01,Default,,0,0,0,,Мен білемін~
Dialogue: 0,0:20:20.34,0:20:22.38,Default,,0,0,0,,Не? А... неге...
Dialogue: 0,0:20:22.59,0:20:24.80,Default,,0,0,0,,Әжеден бері ұрпақтан-ұрпаққа жалғасып келеді.
Dialogue: 0,0:20:24.89,0:20:27.35,Default,,0,0,0,,Цутара, беделді Aria компаниясына жаңадан келген
Dialogue: 0,0:20:27.47,0:20:29.39,Default,,0,0,0,,Мен қызықпын және оны қараймын.
Dialogue: 0,0:20:29.77,0:20:33.10,Default,,0,0,0,,Иә, тексеріңіз. Егер бұл біртүрлі жаңа жігіт болса...
Dialogue: 0,0:20:33.31,0:20:34.73,Default,,0,0,0,,Сібірге жіберілді
Dialogue: 0,0:20:34.81,0:20:35.90,Default,,0,0,0,,мен Токио вокзалына дейін шамамен бір жарым сағат Шинкансенге отырдым
Dialogue: 0,0:20:36.23,0:20:38.02,Default,,0,0,0,,Сібір қайда орналасқан?
Dialogue: 0,0:20:38.27,0:20:39.94,Default,,0,0,0,,Мен шынымен білмеймін.
Dialogue: 0,0:20:40.32,0:20:42.78,Default,,0,0,0,,Мұны қалай тексересіз?
Dialogue: 0,0:20:43.57,0:20:45.70,Default,,0,0,0,,Гондола қауымдастығының тіркеу деректері
Dialogue: 0,0:20:46.11,0:20:47.74,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:20:47.82,0:20:51.33,Default,,0,0,0,,Және филиал басшысынан алынған ақпарат бойынша.
Dialogue: 0,0:20:51.62,0:20:53.96,Default,,0,0,0,,Бұрынғы жартылай тегін шабандоз...
Dialogue: 0,0:20:54.25,0:20:58.04,Default,,0,0,0,,Дегенмен, Aria компаниясының керемет күші менің ойымды өзгертуге көмектесті.
Dialogue: 0,0:20:58.50,0:21:01.09,Default,,0,0,0,,Екеуің мысық іздеп жүрсіңдер ме?
Dialogue: 0,0:21:01.46,0:21:02.34,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:02.55,0:21:06.09,Default,,0,0,0,,Осы жерде көк көзді мысық пайда болады деген қауесет бар.
Dialogue: 0,0:21:06.30,0:21:09.51,Default,,0,0,0,,Біз қазір Himeya Main Store президентін іріктеу үстіндеміз.
Dialogue: 0,0:21:09.85,0:21:10.85,Default,,0,0,0,,Мен көремін~
Dialogue: 0,0:21:11.35,0:21:15.44,Default,,0,0,0,,Сонда Ай Сан Кэйт Ситті іздеп жүр еді ғой?
Dialogue: 0,0:21:15.56,0:21:17.69,Default,,0,0,0,,Ахахаха мүмкін емес
Dialogue: 0,0:21:18.06,0:21:20.61,Default,,0,0,0,,Мен бұл туралы Алиса-сенпайдан да сұрадым.
Dialogue: 0,0:21:20.86,0:21:25.03,Default,,0,0,0,,Ай-сан керемет жұмбақ кездесулер бойынша Акари-саннан кейінгі екінші орында тұр...
Dialogue: 0,0:21:25.99,0:21:27.57,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:21:27.95,0:21:30.45,Default,,0,0,0,,Мен бұрын көлеңке көрдім деп ойладым.
Dialogue: 0,0:21:31.20,0:21:35.33,Default,,0,0,0,,Сосын қуанып, артымнан қудым да, осында келгенде.
Dialogue: 0,0:21:35.46,0:21:38.63,Default,,0,0,0,,Мен біртүрлі нәрсе айтып тұрмын ба?
Dialogue: 0,0:21:38.83,0:21:41.92,Default,,0,0,0,,Жоқ, иә! Тамаша! Хаа~
Dialogue: 0,0:21:42.09,0:21:45.97,Default,,0,0,0,,Жарайды, бірге іздейік, жарай ма?
Dialogue: 0,0:21:46.43,0:21:48.26,Default,,0,0,0,,Бұта емес
Dialogue: 0,0:21:48.64,0:21:51.72,Default,,0,0,0,,Филиал менеджері басым күшпен шабуыл жасайтынын жиі айтады.
Dialogue: 0,0:21:51.81,0:21:54.43,Default,,0,0,0,,Бұл керемет нәрсені сезінудің тамаша мүмкіндігі.
Dialogue: 0,0:21:54.77,0:21:58.02,Default,,0,0,0,,Енді бір сәт бірге ойнайық.
Dialogue: 0,0:21:58.31,0:22:00.90,Default,,0,0,0,,Фу Инаиши
Dialogue: 0,0:22:01.06,0:22:02.94,Default,,0,0,0,,Осында тағы барайық.
Dialogue: 0,0:22:03.03,0:22:05.11,Default,,0,0,0,,Хаа, рас па?
Dialogue: 0,0:22:05.53,0:22:06.70,Default,,0,0,0,,Күтіңіз~
Dialogue: 0,0:22:06.95,0:22:10.95,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:22:14.54,0:22:16.12,Default,,0,0,0,,Мен енді жүре алмаймын
Dialogue: 0,0:22:16.46,0:22:19.54,Default,,0,0,0,,Әдемі қыздардың демалатынын білмейсің бе?
Dialogue: 0,0:22:19.62,0:22:21.54,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:22:22.00,0:22:25.17,Default,,0,0,0,,Өте керемет... қорқынышты
Dialogue: 0,0:22:25.26,0:22:27.47,Default,,0,0,0,,Шай ішкіңіз келе ме?
Dialogue: 0,0:22:27.59,0:22:30.39,Default,,0,0,0,,Иә, бар! (Аня) Мен күттім.
Dialogue: 0,0:22:33.01,0:22:34.93,Default,,0,0,0,,Күткеніңізге рахмет, Президент Ария.
Dialogue: 0,0:22:35.10,0:22:36.52,Default,,0,0,0,,Пуджа!
Dialogue: 0,0:22:37.60,0:22:38.85,Default,,0,0,0,,Хаа~
Dialogue: 0,0:22:39.06,0:22:41.31,Default,,0,0,0,,Мен ақыры дем аламын~
Dialogue: 0,0:22:41.69,0:22:45.98,Default,,0,0,0,,Кеш болды, бірақ Азуса-чан, мен бүгін көп жаттығу жасаған жоқпын.
Dialogue: 0,0:22:46.15,0:22:47.86,Default,,0,0,0,,Айка-сан саған ашуланбайды ма?
Dialogue: 0,0:22:48.07,0:22:48.99,Default,,0,0,0,,Няня!?
Dialogue: 0,0:22:49.61,0:22:51.62,Default,,0,0,0,,Жоқ... бірақ жағдайға байланысты
Dialogue: 0,0:22:51.70,0:22:54.91,Default,,0,0,0,,Мен жаңа президенттікке үміткер болу үшін мысық іздедім...
Dialogue: 0,0:22:55.08,0:22:57.12,Default,,0,0,0,,Мен негізінен Кейт Ситті іздедім.
Dialogue: 0,0:22:57.20,0:22:58.21,Default,,0,0,0,,Мияу мияу...
Dialogue: 0,0:22:58.37,0:23:01.42,Default,,0,0,0,,Алиса-сенпайға қарағанда, Айка-сан қатал.
Dialogue: 0,0:23:01.63,0:23:03.54,Default,,0,0,0,,Қандай жаза күтіп тұр...
Dialogue: 0,0:23:03.79,0:23:06.09,Default,,0,0,0,,Уф, бұл сөзсіз жаман.
Dialogue: 0,0:23:06.21,0:23:07.59,Default,,0,0,0,,Ум (2 адам) Иә?
Dialogue: 0,0:23:08.01,0:23:10.34,Default,,0,0,0,,Екеуің бірге жаттығу жасайсыңдар ма?
Dialogue: 0,0:23:10.72,0:23:13.14,Default,,0,0,0,,Иә, иә (Аня) Дәл солай.
Dialogue: 0,0:23:13.64,0:23:18.02,Default,,0,0,0,,Хаа~ Ум... уф! Мен де саған қосылғым келеді!
Dialogue: 0,0:23:19.14,0:23:20.02,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:23:22.10,0:23:23.98,Default,,0,0,0,,Хехе, әрине!
Dialogue: 0,0:23:28.94,0:23:31.20,Default,,0,0,0,,Акари-сан, бұл мүмкін бе
Dialogue: 0,0:23:31.45,0:23:34.37,Default,,0,0,0,,Менің ойымша, бұл Кэйт Сит маған берген ғажайып.
Dialogue: 0,0:23:34.45,0:23:36.45,Default,,0,0,0,,Иә, дұрыс, мен сенімдімін
Dialogue: 0,0:23:36.74,0:23:38.12,Default,,0,0,0,,, солай ма?
Dialogue: 0,0:23:38.50,0:23:39.41,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:23:40.00,0:23:41.33,Default,,0,0,0,,Кэйт Сит?
Dialogue: 0,0:23:42.37,0:23:45.25,Default,,0,0,0,,Ол әлі бір жерде мені бақылап отыр.
Dialogue: 0,0:23:45.63,0:23:47.34,Default,,0,0,0,,Ах, енді ойласам...
Dialogue: 0,0:23:47.55,0:23:50.34,Default,,0,0,0,,Акари-сан, сен Кейт Ситпен қайта кездесе алдың ба?
Dialogue: 0,0:23:51.76,0:23:52.59,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:23:54.22,0:23:55.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:56.56,0:23:59.85,Default,,0,0,0,,Бұл мен үшін соңғы рет болды...
Dialogue: 0,0:24:05.15,0:24:07.65,Default,,0,0,0,,Хмм, Кейт Сит.
Dialogue: 0,0:24:08.32,0:24:11.90,Default,,0,0,0,,Иә, соңғы кездері сені мүлдем көре алмай жүрмін.
Dialogue: 0,0:24:12.40,0:24:13.95,Default,,0,0,0,,Қандай ұят.
Dialogue: 0,0:24:14.16,0:24:15.28,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:24:15.95,0:24:18.58,Default,,0,0,0,,Мүмкін енді кездесе алмайтын шығармыз?
Dialogue: 0,0:24:18.79,0:24:20.70,Default,,0,0,0,,Эх~ Пуикю~
Dialogue: 0,0:24:22.08,0:24:24.71,Default,,0,0,0,,Біз прима болғымыз келеді.
Dialogue: 0,0:24:24.92,0:24:27.67,Default,,0,0,0,,Бұл ересек адам болуды білдірмейді ме?
Dialogue: 0,0:24:27.96,0:24:31.42,Default,,0,0,0,,Сонымен балалар ғана көре алатын дүниеден...
Dialogue: 0,0:24:31.51,0:24:34.22,Default,,0,0,0,,Бұл оқуды аяқтау керек дегенді білдірмейді ме?
Dialogue: 0,0:24:35.55,0:24:36.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:38.10,0:24:43.39,Default,,0,0,0,,Егер солай болса, мен сізбен соңғы рет болса да кездескім келеді.
Dialogue: 0,0:24:44.19,0:24:45.23,Default,,0,0,0,,Хаа
Dialogue: 0,0:24:49.44,0:24:50.86,Default,,0,0,0,,Бай-нябай
Dialogue: 0,0:24:52.15,0:24:54.70,Default,,0,0,0,,А, мүмкін...
Dialogue: 0,0:24:55.16,0:24:56.41,Default,,0,0,0,,Не? (Акари) А...
Dialogue: 0,0:24:59.41,0:25:02.62,Default,,0,0,0,,Фу, кеттік.
Dialogue: 0,0:25:07.71,0:25:09.04,Default,,0,0,0,,Қараңдаршы, мына жерде.
Dialogue: 0,0:25:10.13,0:25:13.67,Default,,0,0,0,,Нео-Венецияның жеті кереметінің бірі: бақытсыздық тасы
Dialogue: 0,0:25:13.97,0:25:15.13,Default,,0,0,0,,Бақытсыздықтың тасы?
Dialogue: 0,0:25:15.63,0:25:17.43,Default,,0,0,0,,О, мен білемін.
Dialogue: 0,0:25:17.93,0:25:21.31,Default,,0,0,0,,Бұл тас Мэнгомның Венециялық анекдотын қайта жасады.
Dialogue: 0,0:25:21.64,0:25:23.06,Default,,0,0,0,,Бұл өте әйгілі тас.
Dialogue: 0,0:25:24.10,0:25:26.77,Default,,0,0,0,,Хехе~ Жүріп жүргенде бәрі бір-бірінен қашып жүреді.
Dialogue: 0,0:25:27.10,0:25:30.02,Default,,0,0,0,,Иә, бассаң жамандық болады...
Dialogue: 0,0:25:30.44,0:25:31.78,Default,,0,0,0,,Жаман деген не?
Dialogue: 0,0:25:32.11,0:25:34.90,Default,,0,0,0,,Бұл бәрібір жақсы емес.
Dialogue: 0,0:25:35.20,0:25:36.95,Default,,0,0,0,,Бұл қорқынышты тас.
Dialogue: 0,0:25:37.16,0:25:38.45,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:25:38.53,0:25:39.99,Default,,0,0,0,,Иә, кішкентай бала ма?
Dialogue: 0,0:25:40.16,0:25:41.03,Default,,0,0,0,,Эйя
Dialogue: 0,0:25:42.66,0:25:43.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:43.79,0:25:46.21,Default,,0,0,0,,Мен бақытсыздық тасына міндім... (Акари)
Dialogue: 0,0:25:46.50,0:25:49.21,Default,,0,0,0,,Мына қыз не істеп жатыр?
Dialogue: 0,0:25:49.83,0:25:54.26,Default,,0,0,0,,Ештеңе болған жоқ, мүмкін деп ойладым.
Dialogue: 0,0:25:54.34,0:25:55.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:55.26,0:25:58.55,Default,,0,0,0,,Жарайды. Мен оны бала кезімде талай рет басқанмын, бірақ...
Dialogue: 0,0:25:58.72,0:26:00.68,Default,,0,0,0,,Ерекше ештеңе болған жоқ.
Dialogue: 0,0:26:00.89,0:26:03.43,Default,,0,0,0,,Дұрыс, мені қорқытпа~
Dialogue: 0,0:26:03.52,0:26:06.98,Default,,0,0,0,,Бірақ мен Акари-сенпайдың қасында болсам болар деп ойладым.
Dialogue: 0,0:26:07.06,0:26:08.56,Default,,0,0,0,,Қорқынышты эксперименттерге жол берілмейді!
Dialogue: 0,0:26:08.85,0:26:11.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:11.94,0:26:13.73,Default,,0,0,0,,Аа, бұл қазірдің өзінде ұзақ
Dialogue: 0,0:26:13.94,0:26:17.20,Default,,0,0,0,,Айка-чан, сен бүгін кішілерге сабақ бересің...
Dialogue: 0,0:26:17.32,0:26:19.20,Default,,0,0,0,,Нана... Мен ұмытып кетіппін.
Dialogue: 0,0:26:19.28,0:26:21.37,Default,,0,0,0,,Мен мектепке баруым керек.
Dialogue: 0,0:26:21.70,0:26:23.91,Default,,0,0,0,,Онда кездескенше, мен барамын.
Dialogue: 0,0:26:23.99,0:26:26.20,Default,,0,0,0,,Қош келдіңіз, сәттілік тілейміз
Dialogue: 0,0:26:28.58,0:26:32.71,Default,,0,0,0,,Жарайды, мен де жұмысқа қайта оралуым керек.
Dialogue: 0,0:26:32.79,0:26:33.67,Default,,0,0,0,,Пуйпуича~
Dialogue: 0,0:26:37.47,0:26:41.97,Default,,0,0,0,,Нео-Венецияның жеті кереметінің бірі, бақытсыздық тасы...
Dialogue: 0,0:26:42.22,0:26:43.14,Default,,0,0,0,,Пуи~
Dialogue: 0,0:26:56.48,0:26:57.94,Default,,0,0,0,,Біз мінеміз бе?
Dialogue: 0,0:26:58.57,0:26:59.45,Default,,0,0,0,,Пуи!?
Dialogue: 0,0:26:59.61,0:27:02.62,Default,,0,0,0,,Мүмкін сіз Кейт Ситпен кездесе аласыз.
Dialogue: 0,0:27:03.37,0:27:04.37,Default,,0,0,0,,Бай-нябай
Dialogue: 0,0:27:19.26,0:27:20.18,Default,,0,0,0,,Жарайды
Dialogue: 0,0:27:22.51,0:27:23.60,Default,,0,0,0,,Ей! Пуи
Dialogue: 0,0:27:27.02,0:27:27.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:37.11,0:27:37.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:43.57,0:27:48.54,Default,,0,0,0,,Фу Ештеңе болмайды, президент Ария.
Dialogue: 0,0:27:48.75,0:27:50.00,Default,,0,0,0,,Байча~
Dialogue: 0,0:27:53.17,0:27:56.67,Default,,0,0,0,,Мен Кейт Ситті енді ешқашан көрмеймін деп ойлаймын.
Dialogue: 0,0:28:01.30,0:28:03.39,Default,,0,0,0,,Мен өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:28:10.27,0:28:11.85,Default,,0,0,0,,Иә? Сау бол...
Dialogue: 0,0:28:14.60,0:28:15.81,Default,,0,0,0,,Байняпай?
Dialogue: 0,0:28:17.27,0:28:18.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:21.82,0:28:22.78,Default,,0,0,0,,Хе...
Dialogue: 0,0:28:24.74,0:28:25.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:35.42,0:28:36.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:42.42,0:28:45.51,Default,,0,0,0,,Мен сені кездестіргеніме қуаныштымын.
Dialogue: 0,0:28:46.47,0:28:49.01,Default,,0,0,0,,Мен сені іздедім
Dialogue: 0,0:28:49.56,0:28:53.10,Default,,0,0,0,,Сізбен қайта кездескеніме өте қуаныштымын.
Dialogue: 0,0:29:01.53,0:29:04.49,Default,,0,0,0,,Келесі жолы мен сені көруге келемін.
Dialogue: 0,0:29:04.90,0:29:07.95,Default,,0,0,0,,Хехе, қай жерден таныссам болады?
Dialogue: 0,0:29:08.32,0:29:10.66,Default,,0,0,0,,Сол тасты тағы басайын ба?
Dialogue: 0,0:29:12.95,0:29:13.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:16.54,0:29:18.92,Default,,0,0,0,,Қайта кездесе алмаймыз ба?
Dialogue: 0,0:29:20.17,0:29:21.17,Default,,0,0,0,,Енді ешқашан емес пе?
Dialogue: 0,0:29:23.01,0:29:25.51,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:29:27.01,0:29:27.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:38.31,0:29:39.65,Default,,0,0,0,,Әрқашан осында...
Dialogue: 0,0:29:51.20,0:29:52.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:55.71,0:29:57.00,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:30:03.55,0:30:09.34,Default,,0,0,0,,Ұмытпаймын Мен сені ешқашан ұмытпаймын
Dialogue: 0,0:30:13.01,0:30:13.93,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:30:18.69,0:30:19.52,Default,,0,0,0,,Сонымен—
Dialogue: 0,0:30:21.23,0:30:24.03,Default,,0,0,0,,Біз мұнда мәңгі бірге болдық.
Dialogue: 0,0:30:47.55,0:30:49.26,Default,,0,0,0,,(суға секіру дыбысы)
Dialogue: 0,0:30:49.63,0:30:50.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:58.64,0:30:59.60,Default,,0,0,0,,О
Dialogue: 0,0:31:04.77,0:31:07.53,Default,,0,0,0,,Ах... Президент Ария
Dialogue: 0,0:31:07.99,0:31:09.20,Default,,0,0,0,,Байча~
Dialogue: 0,0:31:11.07,0:31:11.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:15.91,0:31:16.83,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:31:21.00,0:31:22.29,Default,,0,0,0,,Байча~
Dialogue: 0,0:31:32.34,0:31:33.93,Default,,0,0,0,,Бұл әдемі~
Dialogue: 0,0:31:34.51,0:31:35.43,Default,,0,0,0,,Иә
Dialogue: 0,0:31:36.01,0:31:40.27,Default,,0,0,0,,Мүмкін осының бәрі Миракуру шығар.
Dialogue: 0,0:31:41.23,0:31:44.06,Default,,0,0,0,,Жарқырап тұрғаны сондықтан шығар деп ойлаймын.
Dialogue: 0,0:31:46.40,0:31:49.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:31:52.41,0:31:56.74,Default,,0,0,0,,Ай Чанның бүгін алған ғажайыптары жарқыраған кездесу.
Dialogue: 0,0:31:57.20,0:31:58.04,Default,,0,0,0,,Иә
Dialogue: 0,0:31:58.16,0:32:02.21,Default,,0,0,0,,Үшеуміз көп жаттығып, Прима Ундин болуды мақсат етеміз.
Dialogue: 0,0:32:02.79,0:32:07.17,Default,,0,0,0,,Бірақ мен әлі күнге дейін Кейт Ситпен кездескім келеді.
Dialogue: 0,0:32:09.71,0:32:13.26,Default,,0,0,0,,Қашан кездессек те, қоштасатын уақыт әрқашан келеді.
Dialogue: 0,0:32:14.64,0:32:17.97,Default,,0,0,0,,Бірақ сол күні мен Кэйт Ситпен қоштасуым керек еді.
Dialogue: 0,0:32:18.31,0:32:21.35,Default,,0,0,0,,Ай Чанның арқасында мен қайта кездескендей болдым.
Dialogue: 0,0:32:22.69,0:32:25.61,Default,,0,0,0,,Мүмкін махаббат сезімі
Dialogue: 0,0:32:25.81,0:32:28.40,Default,,0,0,0,,Мүмкін бұл Ғажайыпты шақырып жатқан шығар.
Dialogue: 0,0:32:46.71,0:32:48.50,Default,,0,0,0,,Э? Хмм…
Dialogue: 0,0:32:52.80,0:32:54.47,Default,,0,0,0,,Есікті бастайық
Dialogue: 0,0:32:55.18,0:32:56.39,Default,,0,0,0,,Байча~
Dialogue: 0,0:32:56.68,0:32:59.64,Default,,0,0,0,,О, Президент Ария, қайырлы таң.
Dialogue: 0,0:33:00.06,0:33:01.72,Default,,0,0,0,,Пуйпуи пуя~
Dialogue: 0,0:33:01.81,0:33:07.81,Default,,0,0,0,,♪〜
Dialogue: 0,0:34:41.82,0:34:47.83,Default,,0,0,0,,〜♪
Dialogue: 0,0:34:48.12,0:34:52.54,Default,,0,0,0,,Гондолалар қауымдастығына жұмысқа өтінім жіберіп, көше плакаттарын жасаңыз.
Dialogue: 0,0:34:52.63,0:34:53.50,Default,,0,0,0,,Пуйпуи
Dialogue: 0,0:34:53.71,0:34:56.84,Default,,0,0,0,,Әрине, әңгімелесу және тәжірибелік емтихан міндетті болып табылады.
Dialogue: 0,0:35:03.51,0:35:07.18,Default,,0,0,0,,Менің Aria компаниясына лайықты балам бар.
Dialogue: 0,0:35:07.77,0:35:10.85,Default,,0,0,0,,Біз мұқият және мұқият таңдауға міндеттіміз.
Dialogue: 0,0:35:16.15,0:35:19.20,Default,,0,0,0,,Компанияға қосылуды сұрайтын электрондық пошта? Пуи?
Dialogue: 0,0:35:19.28,0:35:22.41,Default,,0,0,0,,Бұл №1 өтініш беруші, Президент Ария.
Dialogue: 0,0:35:22.95,0:35:24.24,Default,,0,0,0,,Кю~и
Dialogue: 0,0:35:24.70,0:35:26.95,Default,,0,0,0,,Ах... Мэнхомадан...
Dialogue: 0,0:35:27.50,0:35:31.33,Default,,0,0,0,,Сіз жаңа ғана дүкеніңіздің алдында жұмыс туралы хабарландыру жарияладыңыз, солай емес пе?
Dialogue: 0,0:35:31.50,0:35:32.63,Default,,0,0,0,,Пуикюи
Dialogue: 0,0:35:33.50,0:35:36.09,Default,,0,0,0,,Біз басты бетке әлі ешқандай жалдау жариялаған жоқпыз.
Dialogue: 0,0:35:36.30,0:35:37.63,Default,,0,0,0,,Осы уақытта...
Dialogue: 0,0:35:39.22,0:35:43.59,Default,,0,0,0,,А... аааа... Өзімнен озып кеткенім үшін кешіріңіз.
Dialogue: 0,0:35:44.10,0:35:46.26,Default,,0,0,0,,Неліктен бізге қосылғың келеді?
Dialogue: 0,0:35:46.68,0:35:50.94,Default,,0,0,0,,Мен Ундинді әрқашан таңдандырдым.
Dialogue: 0,0:35:51.52,0:35:56.23,Default,,0,0,0,,Интернеттен Aria компаниясының суретін тауып алғанымда...
Dialogue: 0,0:35:57.40,0:36:00.61,Default,,0,0,0,,Мені қандай да бір себептермен шақырғандай сезіндім.
Dialogue: 0,0:36:02.57,0:36:05.20,Default,,0,0,0,,Сіз білуге ​​уақыт бөлемін дедіңіз.
Dialogue: 0,0:36:06.12,0:36:08.37,Default,,0,0,0,,Мен өзіме қайшы келетінімді білемін.
Dialogue: 0,0:36:09.66,0:36:12.25,Default,,0,0,0,,Бірақ неге...
Dialogue: 0,0:36:17.96,0:36:19.88,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:36:21.47,0:36:22.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:23.47,0:36:29.10,Default,,0,0,0,,Сол кезде мен қатты қорықтым, бұл қыз ғой.
Dialogue: 0,0:36:30.52,0:36:31.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:52.62,0:36:55.37,Default,,0,0,0,,Өйткені, бұл декорация ерекше.
Dialogue: 0,0:36:57.08,0:36:59.38,Default,,0,0,0,,Мм... екеуміз көптен бері біргеміз...
Dialogue: 0,0:36:59.55,0:37:01.88,Default,,0,0,0,,Айка-сан мен Алиса-санға тәнті болдыңыз ба?
Dialogue: 0,0:37:02.34,0:37:04.97,Default,,0,0,0,,Иә? Жоқ, әсіресе!
Dialogue: 0,0:37:05.05,0:37:09.22,Default,,0,0,0,,Бірдеңе болса, филиал менеджері маған ғашық деп ойлаймын.
Dialogue: 0,0:37:09.31,0:37:12.64,Default,,0,0,0,,Orange Planet – компания белгілейтін әдет.
Dialogue: 0,0:37:12.85,0:37:16.98,Default,,0,0,0,,А... Мен өзім таңдай алмаймын.
Dialogue: 0,0:37:17.81,0:37:21.98,Default,,0,0,0,,Сондықтан сіз таңдаған аға буынның түрі маңызды мәселе болып табылады.
Dialogue: 0,0:37:22.11,0:37:25.49,Default,,0,0,0,,Талантым болса да, мені үлкендер танымайды.
Dialogue: 0,0:37:25.57,0:37:27.28,Default,,0,0,0,,Кейбір балалар жұмысын тоқтатады.
Dialogue: 0,0:37:27.66,0:37:29.66,Default,,0,0,0,,Ех... солай...
Dialogue: 0,0:37:30.49,0:37:31.83,Default,,0,0,0,,Сонымен, біз—
Dialogue: 0,0:37:32.50,0:37:35.41,Default,,0,0,0,,Сәтіңізді құр жібермеу үшін бар күшіңізді салуыңыз керек.
Dialogue: 0,0:37:35.75,0:37:38.83,Default,,0,0,0,,Иә, мен бұл кездесуге ризамын.
Dialogue: 0,0:37:39.04,0:37:42.59,Default,,0,0,0,,Иә, үшеуміз міндетті түрде Прима Ундинге айналамыз.
Dialogue: 0,0:37:42.67,0:37:45.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:45.97,0:37:49.60,Default,,0,0,0,,Президент Ария! Осыны ұстаныңыз
Dialogue: 0,0:37:49.85,0:37:51.64,Default,,0,0,0,,Бубубубубубу~!
Dialogue: 0,0:37:53.14,0:37:54.18,Default,,0,0,0,,Хаа…
Dialogue: 0,0:37:54.98,0:37:57.27,Default,,0,0,0,,Годоланың жанынан өту
Dialogue: 0,0:38:03.69,0:38:06.95,Default,,0,0,0,,Мен білмейтін дүниелер әлі де көп.
Dialogue: 0,0:38:07.53,0:38:12.29,Default,,0,0,0,,Хехе, мен де солай, өйткені қала өзгеріп жатыр.
Dialogue: 0,0:38:12.74,0:38:15.00,Default,,0,0,0,,Егер Примаундин сізбен бірге жүрсе—
Dialogue: 0,0:38:15.16,0:38:19.29,Default,,0,0,0,,Бұрын жолаушылар бойдақ болса да мінуге мүмкіндік беретін жүйе болмаған.
Dialogue: 0,0:38:19.58,0:38:20.96,Default,,0,0,0,,А... солай ма?
Dialogue: 0,0:38:21.38,0:38:24.84,Default,,0,0,0,,Жасөспірімдерді оқыту үшін біреу...
Dialogue: 0,0:38:25.42,0:38:30.14,Default,,0,0,0,,Уақыт өте ол жайылып, жағдай біртіндеп өзгере бастады.
Dialogue: 0,0:38:30.85,0:38:32.05,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:38:32.81,0:38:35.47,Default,,0,0,0,,Аты-жөнін де білмейтін көп адамдардың сезімі
Dialogue: 0,0:38:36.02,0:38:40.69,Default,,0,0,0,,Менің ойымша, олар бізді қаланың сезімімен қолдап жатыр.
Dialogue: 0,0:38:41.73,0:38:43.44,Default,,0,0,0,,Мияу мияу... Бұл... (Аня) А...
Dialogue: 0,0:38:43.86,0:38:45.44,Default,,0,0,0,,Ұятты өсек...
Dialogue: 0,0:38:45.53,0:38:46.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:46.57,0:38:49.57,Default,,0,0,0,,Ахахха, жақсы, жақсы, уайымдама~
Dialogue: 0,0:39:00.62,0:39:02.67,Default,,0,0,0,,Кенет бұлтты болды.
Dialogue: 0,0:39:02.92,0:39:05.09,Default,,0,0,0,,Бұл маусымда көмектесу мүмкін емес.
Dialogue: 0,0:39:05.63,0:39:08.17,Default,,0,0,0,,Жақында Aqua Alta келеді емес пе?
Dialogue: 0,0:39:08.92,0:39:10.30,Default,,0,0,0,,Aqua Alta...
Dialogue: 0,0:39:11.09,0:39:13.64,Default,,0,0,0,,Гондола өтеді (3 адам) А...
Dialogue: 0,0:39:23.61,0:39:27.23,Default,,0,0,0,,Сол күлімсіреп, ән салған дауыс бәрінің көңілін жұбатады.
Dialogue: 0,0:39:27.40,0:39:29.57,Default,,0,0,0,,Түсіндім~ (Аня) Бірақ...
Dialogue: 0,0:39:29.65,0:39:30.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:30.74,0:39:34.37,Default,,0,0,0,,Афинаның алдағы музыка фестиваліндегі ерекше өнері—
Dialogue: 0,0:39:34.99,0:39:37.58,Default,,0,0,0,,Оны Алиса-сенпай да асыға күтті.
Dialogue: 0,0:39:38.16,0:39:41.92,Default,,0,0,0,,Мен кенеттен бас тарта алмайтын жұмысқа орналастым...
Dialogue: 0,0:39:42.08,0:39:45.92,Default,,0,0,0,,Ал... Жарайды, ол күні тым бос емес едік.
Dialogue: 0,0:39:46.00,0:39:48.05,Default,,0,0,0,,Филиал меңгерушісі де қайда екенін білмейді.
Dialogue: 0,0:39:48.51,0:39:50.59,Default,,0,0,0,,Бізде де толық брондалған.
Dialogue: 0,0:39:50.93,0:39:53.97,Default,,0,0,0,,Бұл көмектесуге болмайтын нәрсе.
Dialogue: 0,0:39:54.47,0:39:55.97,Default,,0,0,0,,Ах! Буй?
Dialogue: 0,0:39:56.39,0:39:57.43,Default,,0,0,0,,Не болды?
Dialogue: 0,0:39:58.81,0:40:00.81,Default,,0,0,0,,Біз керемет жасаймыз
Dialogue: 0,0:40:01.48,0:40:03.81,Default,,0,0,0,,Ғажайып жасағың келе ме?
Dialogue: 0,0:40:04.19,0:40:05.15,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:40:05.73,0:40:06.98,Default,,0,0,0,,Aqua Alta
Dialogue: 0,0:40:07.07,0:40:09.49,Default,,0,0,0,,Aqua Alta Миракуруны әкеледі
Dialogue: 0,0:40:09.99,0:40:13.57,Default,,0,0,0,,Керемет нәрсе іске қосылған сияқты.
Dialogue: 0,0:40:14.53,0:40:17.12,Default,,0,0,0,,Жүру? (Аня) Бұл бұта емес.
Dialogue: 0,0:40:33.68,0:40:36.43,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:40:39.81,0:40:40.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:44.56,0:40:47.65,Default,,0,0,0,,Ах~ Міне келді~
Dialogue: 0,0:40:47.77,0:40:50.57,Default,,0,0,0,,Бұл Aqua Alta, Президент Ария~
Dialogue: 0,0:40:51.11,0:40:53.86,Default,,0,0,0,,Аква ғажайыптарға толы.
Dialogue: 0,0:40:54.66,0:40:56.28,Default,,0,0,0,,Енді операция басталады.
Dialogue: 0,0:40:56.49,0:40:57.70,Default,,0,0,0,,О! Сау бол ча!
Dialogue: 0,0:40:58.33,0:40:59.37,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:40:59.79,0:41:02.33,Default,,0,0,0,,Ах, Акари-сан, қайырлы таң.
Dialogue: 0,0:41:02.54,0:41:03.75,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:41:03.83,0:41:05.88,Default,,0,0,0,,Aqua Alta Иә!
Dialogue: 0,0:41:05.96,0:41:08.50,Default,,0,0,0,,Бүгінгі жұмыс тоқтатылады.
Dialogue: 0,0:41:08.63,0:41:12.84,Default,,0,0,0,,Иә, бүгін балконда демалып күн өткізгіңіз келе ме?
Dialogue: 0,0:41:13.30,0:41:14.93,Default,,0,0,0,,Жоқ! (Акури) Е~
Dialogue: 0,0:41:15.01,0:41:16.89,Default,,0,0,0,,Мен шығайын деп жатырмын.
Dialogue: 0,0:41:17.01,0:41:20.76,Default,,0,0,0,,Ахи... Сонымен, түскі асқа бірге құймақ жасағыларың келе ме?
Dialogue: 0,0:41:20.85,0:41:22.52,Default,,0,0,0,,Пісіруге болмайды! (Акури) Е~
Dialogue: 0,0:41:22.77,0:41:25.39,Default,,0,0,0,,Өкінішке орай, бүгін бізде түскі ас бөлек болады.
Dialogue: 0,0:41:25.64,0:41:28.15,Default,,0,0,0,,Олай болса, кешкі ас әзірлейік.
Dialogue: 0,0:41:28.36,0:41:30.11,Default,,0,0,0,,Жоқ, мұны жасамаңыз.
Dialogue: 0,0:41:30.57,0:41:31.61,Default,,0,0,0,,мен Токио вокзалына дейін шамамен бір жарым сағат Шинкансенге отырдым
Dialogue: 0,0:41:32.11,0:41:33.94,Default,,0,0,0,,Мен сізге кешке хабарласамын.
Dialogue: 0,0:41:34.03,0:41:36.57,Default,,0,0,0,,Акари-сан, өтінемін, оған дейін демалыңыз.
Dialogue: 0,0:41:36.66,0:41:37.66,Default,,0,0,0,,Бай-чай
Dialogue: 0,0:41:38.07,0:41:38.99,Default,,0,0,0,,Иә
Dialogue: 0,0:41:45.21,0:41:47.83,Default,,0,0,0,,Енді мен сендердің әрқайсыңдар өздеріңе тапсырма алғандарыңды қалаймын.
Dialogue: 0,0:41:48.25,0:41:49.50,Default,,0,0,0,,Қарастыру үшін дұға етіңіз
Dialogue: 0,0:41:49.63,0:41:50.63,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:42:07.56,0:42:11.52,Default,,0,0,0,,Айка-чан мен Алиса-чанның бүгін кешке дейін жоспарлары бар ма...
Dialogue: 0,0:42:13.61,0:42:15.44,Default,,0,0,0,,Ай Чан да бос емес сияқты.
Dialogue: 0,0:42:17.57,0:42:21.87,Default,,0,0,0,,Мен сол ыстық бұлаққа келесі жолы барлығына ыңғайлы кезде барғым келеді.
Dialogue: 0,0:42:22.37,0:42:25.41,Default,,0,0,0,,Теңізде жүзген жақсы емес пе? Сондай-ақ тәжірибе үшін.
Dialogue: 0,0:42:26.79,0:42:31.92,Default,,0,0,0,,Мүмкін болса, Алисия мен әжем менімен бірге жүрсе екен.
Dialogue: 0,0:42:34.88,0:42:39.64,Default,,0,0,0,,Орындалмайтын тілектер жүрегімде жинала береді.
Dialogue: 0,0:42:40.26,0:42:44.22,Default,,0,0,0,,Сонда да бір күні, бір күні соны ойлауды тоқтата алмаймын.
Dialogue: 0,0:42:45.27,0:42:46.27,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:42:48.10,0:42:50.27,Default,,0,0,0,,О, электрондық хат.
Dialogue: 0,0:42:52.19,0:42:53.48,Default,,0,0,0,,Ай Чаннан
Dialogue: 0,0:42:54.61,0:42:55.44,Default,,0,0,0,,Е...
Dialogue: 0,0:42:55.73,0:42:58.11,Default,,0,0,0,,Акари-сан, жақсы демалдың ба?
Dialogue: 0,0:42:58.57,0:43:00.70,Default,,0,0,0,,Сағат 5-те осында келіңіз.
Dialogue: 0,0:43:00.86,0:43:01.99,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:43:03.74,0:43:05.04,Default,,0,0,0,,Өлімдік күнәлардың кардиналының оң қолы.
Dialogue: 0,0:43:16.30,0:43:17.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:32.02,0:43:32.94,Default,,0,0,0,,Ах~
Dialogue: 0,0:43:33.31,0:43:35.32,Default,,0,0,0,,Ах, Акари-сан, қош келдіңіз.
Dialogue: 0,0:43:35.52,0:43:36.65,Default,,0,0,0,,Қош бол
Dialogue: 0,0:43:36.82,0:43:39.40,Default,,0,0,0,,Мен сені күттім. (Аня) Өтінемін, осында кел.
Dialogue: 0,0:43:40.03,0:43:42.11,Default,,0,0,0,,Партия? иә!
Dialogue: 0,0:43:42.66,0:43:44.95,Default,,0,0,0,,Бүгін бір нәрсенің мерейтойы ма?
Dialogue: 0,0:43:45.28,0:43:47.41,Default,,0,0,0,,Жоқ, бұл қарапайым күн.
Dialogue: 0,0:43:48.08,0:43:51.46,Default,,0,0,0,,Кәдімгі күні кеш? Өте жақсы~
Dialogue: 0,0:43:51.75,0:43:52.96,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:43:53.08,0:43:56.00,Default,,0,0,0,,Иә, кенже? Әй... Айка-сенпай
Dialogue: 0,0:43:56.21,0:43:57.34,Default,,0,0,0,,А... міне!
Dialogue: 0,0:43:57.67,0:43:58.51,Default,,0,0,0,,Е...
Dialogue: 0,0:43:59.17,0:44:02.13,Default,,0,0,0,,Демек, Айқа-сенпайды да сенің кіші балаң шақырған екен?
Dialogue: 0,0:44:02.30,0:44:05.76,Default,,0,0,0,,Дұрыс. Ойланып жүр ме екен деп ойлаймын.
Dialogue: 0,0:44:06.10,0:44:08.31,Default,,0,0,0,,Айка-чан Алиса-чан
Dialogue: 0,0:44:08.47,0:44:11.81,Default,,0,0,0,,...Мияу! Баба...
Dialogue: 0,0:44:11.94,0:44:13.31,Default,,0,0,0,,Баа!
Dialogue: 0,0:44:13.40,0:44:16.27,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:44:17.27,0:44:20.15,Default,,0,0,0,,Түсіндім, бүгін әркімнің бір шаруасы бар...
Dialogue: 0,0:44:20.94,0:44:22.95,Default,,0,0,0,,Қысқасы, бұл солай болды.
Dialogue: 0,0:44:23.99,0:44:25.82,Default,,0,0,0,,Бұл үлкен, мінсіз қылмыс.
Dialogue: 0,0:44:26.78,0:44:27.62,Default,,0,0,0,,Паа~
Dialogue: 0,0:44:27.99,0:44:30.45,Default,,0,0,0,,Әлі де біраз орындық қалды.
Dialogue: 0,0:44:30.83,0:44:31.83,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:44:32.21,0:44:35.54,Default,,0,0,0,,Сонымен... мүмкін, балалар?
Dialogue: 0,0:44:35.67,0:44:37.54,Default,,0,0,0,,Ах...хехехе
Dialogue: 0,0:44:37.63,0:44:39.71,Default,,0,0,0,,Сіз Алисия мен басқаларды шақырып жатырсыз ба?
Dialogue: 0,0:44:39.80,0:44:41.26,Default,,0,0,0,,Иә! (Айка) Ия!
Dialogue: 0,0:44:41.80,0:44:44.47,Default,,0,0,0,,Уфуфуфу (Акира) Мен сіздің бақытты сезінетініңізді түсінемін.
Dialogue: 0,0:44:44.59,0:44:47.43,Default,,0,0,0,,Бұл Алисия емес, Акира және басқалары шығар.
Dialogue: 0,0:44:47.93,0:44:49.60,Default,,0,0,0,,О, тәңірім.
Dialogue: 0,0:44:50.47,0:44:52.77,Default,,0,0,0,,Алисия әже
Dialogue: 0,0:44:53.69,0:44:55.73,Default,,0,0,0,,Бүгін мені шақырғаныңызға рахмет.
Dialogue: 0,0:44:56.06,0:44:57.65,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:44:58.11,0:44:59.73,Default,,0,0,0,,Мен істеймін, балалар.
Dialogue: 0,0:45:00.11,0:45:02.78,Default,,0,0,0,,Күнделікті ризашылықпен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:45:03.32,0:45:05.82,Default,,0,0,0,,Афинада музыка фестивалі туралы жиналыс бар.
Dialogue: 0,0:45:05.91,0:45:09.24,Default,,0,0,0,,Ертерек бітіремін деп, асығыс келеді.
Dialogue: 0,0:45:10.58,0:45:13.96,Default,,0,0,0,,Егер Афина-сенпай мұны істей алса, бұл Миракуру болар еді.
Dialogue: 0,0:45:14.42,0:45:18.13,Default,,0,0,0,,Міне, біз көп адам жинағанымыз өте жақсы.
Dialogue: 0,0:45:18.34,0:45:20.63,Default,,0,0,0,,Иә, жеткілікті.
Dialogue: 0,0:45:21.26,0:45:24.80,Default,,0,0,0,,О, жақсы иіс. Менің ойымша, бұл раушан шайы.
Dialogue: 0,0:45:24.88,0:45:25.72,Default,,0,0,0,,Иә
Dialogue: 0,0:45:25.80,0:45:30.10,Default,,0,0,0,,Уууу, бұл Ай-чандар әкелген Ғажайыптың иісі.
Dialogue: 0,0:45:30.18,0:45:32.72,Default,,0,0,0,,Ұятсыз жолдар жоқ~ (Акари) Ех~
Dialogue: 0,0:45:39.06,0:45:42.40,Default,,0,0,0,,Рахмет, өте дәмді болды.
Dialogue: 0,0:45:43.19,0:45:45.99,Default,,0,0,0,,Бірақ осылайша үш компанияның синглы...
Dialogue: 0,0:45:46.07,0:45:48.20,Default,,0,0,0,,Бірлескен жаттығу үшін дос болғанда не болады?
Dialogue: 0,0:45:48.70,0:45:50.58,Default,,0,0,0,,Біртүрлі байланыс екен, әже.
Dialogue: 0,0:45:51.03,0:45:52.41,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:45:53.04,0:45:57.71,Default,,0,0,0,,Менің президент Ариямен кездесуім уақыт өте келе баяу өсті.
Dialogue: 0,0:45:58.38,0:46:03.26,Default,,0,0,0,,Мен мұндай тамаша кездесуге әкеледі деп ойламаппын.
Dialogue: 0,0:46:04.47,0:46:06.97,Default,,0,0,0,,Өзін өте бақытты сезіну
Dialogue: 0,0:46:07.80,0:46:09.26,Default,,0,0,0,,Мен болашаққа үмітпен қараймын.
Dialogue: 0,0:46:09.89,0:46:11.85,Default,,0,0,0,,Ах... Алисия
Dialogue: 0,0:46:12.76,0:46:13.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:14.39,0:46:15.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:15.81,0:46:17.10,Default,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:46:17.98,0:46:21.11,Default,,0,0,0,,Қолданыстағы жүйені өзгерту оңай емес
Dialogue: 0,0:46:21.86,0:46:23.86,Default,,0,0,0,,Ах... жүйені өзгертіңіз
Dialogue: 0,0:46:24.49,0:46:26.40,Default,,0,0,0,,Келешек тындыруға арналған
Dialogue: 0,0:46:26.82,0:46:30.62,Default,,0,0,0,,Біз Prima жылжыту жүйесін және басқа да нәрселерді өзгертуге тырысамыз.
Dialogue: 0,0:46:31.87,0:46:34.58,Default,,0,0,0,,Керісінше, бақытты кездесулер болады.
Dialogue: 0,0:46:34.91,0:46:37.83,Default,,0,0,0,,Кездесулер болашаққа тосқауыл қоюы мүмкін
Dialogue: 0,0:46:38.92,0:46:42.54,Default,,0,0,0,,Егер лоцмандық саланың жүйесі оны...
Dialogue: 0,0:46:42.88,0:46:45.84,Default,,0,0,0,,Сіз өзгеру керек деп ойлайсыз ба?
Dialogue: 0,0:46:46.38,0:46:47.84,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:46:49.09,0:46:52.10,Default,,0,0,0,,Кездесудің маңыздылығы туралы кім көбірек біледі?
Dialogue: 0,0:46:52.39,0:46:54.26,Default,,0,0,0,,Алисияның өзі
Dialogue: 0,0:47:00.44,0:47:05.07,Default,,0,0,0,,Көп ұзамай бізді үш ірі су перісі деп атай бастады.
Dialogue: 0,0:47:06.15,0:47:10.78,Default,,0,0,0,,Маған гондола қауымдастығының өтініші келді.
Dialogue: 0,0:47:12.12,0:47:13.99,Default,,0,0,0,,Тіпті сыпайы түрде бас тартқаннан кейін де...
Dialogue: 0,0:47:14.45,0:47:17.79,Default,,0,0,0,,Бірлестік мүшелері бізге жиі келіп тұрады.
Dialogue: 0,0:47:18.83,0:47:22.00,Default,,0,0,0,,Келесі 10 жыл, 100 жыл және т.б.
Dialogue: 0,0:47:22.29,0:47:25.67,Default,,0,0,0,,Ұшқыштар өнеркәсібі мен ұшқыштар үшін.
Dialogue: 0,0:47:26.34,0:47:31.30,Default,,0,0,0,,Мен оның мәнін ынтамен түсіндіріп жатқанда, мен өзімді қиналып қалдым.
Dialogue: 0,0:47:31.80,0:47:35.68,Default,,0,0,0,,Сондықтан мен оны көргім келеді деп шештім.
Dialogue: 0,0:47:36.77,0:47:38.27,Default,,0,0,0,,Бубубува
Dialogue: 0,0:47:39.18,0:47:43.15,Default,,0,0,0,,Президент Ария, мен гондола қауымдастығының мүшелері бізді күтетінін естідім.
Dialogue: 0,0:47:43.69,0:47:47.53,Default,,0,0,0,,Бос емес кезде компанияны сеніп тапсыра алатын кіші оқушыны іздеймін.
Dialogue: 0,0:47:48.15,0:47:50.28,Default,,0,0,0,,Мен өскенге дейін
Dialogue: 0,0:47:50.82,0:47:53.62,Default,,0,0,0,,Фу ах... кіші
Dialogue: 0,0:47:54.74,0:47:55.95,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:48:00.54,0:48:02.33,Default,,0,0,0,,Мені шақырып жатқандай сезіндім.
Dialogue: 0,0:48:03.67,0:48:08.67,Default,,0,0,0,,Менің Акаримен кездесуім мен күтпеген сөзден басталды.
Dialogue: 0,0:48:14.80,0:48:19.68,Default,,0,0,0,,Сондықтан баратын жерді таңдауға өзіңізді мәжбүрлемеңіз, баяу жүріңіз.
Dialogue: 0,0:48:21.02,0:48:22.94,Default,,0,0,0,,Мен жақсы көретін осы ария компаниясында
Dialogue: 0,0:48:23.73,0:48:27.90,Default,,0,0,0,,Осы баламен бірге жайлап өсейік.
Dialogue: 0,0:48:29.28,0:48:30.53,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,0:48:32.03,0:48:35.57,Default,,0,0,0,,Уау, сондай сүйкімді~ Бұл не?
Dialogue: 0,0:48:35.78,0:48:37.03,Default,,0,0,0,,Түнгі жарық қоңырауы
Dialogue: 0,0:48:37.62,0:48:40.75,Default,,0,0,0,,Ахи~ Мен оны бірінші рет көріп тұрмын~ Ой, қызық екен
Dialogue: 0,0:48:43.04,0:48:45.79,Default,,0,0,0,,Танто Грацце…
Dialogue: 0,0:48:48.96,0:48:50.88,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:48:53.05,0:48:55.84,Default,,0,0,0,,Осы Аквада төрт мезгілді бірге өткізейік
Dialogue: 0,0:48:56.68,0:49:00.97,Default,,0,0,0,,Бірте-бірте ерекше адамға айналасың.
Dialogue: 0,0:49:03.06,0:49:06.36,Default,,0,0,0,,Бұл өте қолайлы уақыт болды
Dialogue: 0,0:49:08.02,0:49:11.28,Default,,0,0,0,,Өте маңызды және сүйікті кеңістік
Dialogue: 0,0:49:12.69,0:49:16.41,Default,,0,0,0,,Қарапайым күнделікті өмір... Дүниенің көрінісі...
Dialogue: 0,0:49:17.12,0:49:18.95,Default,,0,0,0,,Әдемі жарқырайды
Dialogue: 0,0:49:20.45,0:49:23.91,Default,,0,0,0,,Сиқырдың астында қалғандай
Dialogue: 0,0:49:26.17,0:49:29.00,Default,,0,0,0,,Мен бұл орны толмас сәтті жоғалтқым келмейді
Dialogue: 0,0:49:30.59,0:49:32.17,Default,,0,0,0,,Мәңгілік жүре бер
Dialogue: 0,0:49:33.72,0:49:37.01,Default,,0,0,0,,Егер мен сиқырды қолдансам...
Dialogue: 0,0:49:38.14,0:49:41.26,Default,,0,0,0,,Мен уақытты тоқтатқым келеді.
Dialogue: 0,0:49:43.18,0:49:44.02,Default,,0,0,0,,Фуфу
Dialogue: 0,0:49:54.82,0:49:56.36,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:49:56.82,0:50:01.99,Default,,0,0,0,,Уфуфу Мен оны өзіммен бірге алып келдім, бірақ ол енді жанбайды.
Dialogue: 0,0:50:04.58,0:50:06.21,Default,,0,0,0,,Сәлем, Акари-чан
Dialogue: 0,0:50:07.00,0:50:11.04,Default,,0,0,0,,Яко Сузумен қоштасқанда қандай сезімде болдыңыз?
Dialogue: 0,0:50:14.01,0:50:17.43,Default,,0,0,0,,Мен сондай жалғыз болдым.
Dialogue: 0,0:50:19.14,0:50:21.47,Default,,0,0,0,,Қоштасу қашанда мұңды
Dialogue: 0,0:50:22.26,0:50:25.98,Default,,0,0,0,,Осы түнгі жарық қоңырауымен де... Гондола мырзамен де...
Dialogue: 0,0:50:26.60,0:50:29.81,Default,,0,0,0,,Мен соншалықты жалғыз және қайғылы болдым.
Dialogue: 0,0:50:31.19,0:50:32.11,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:50:33.07,0:50:37.57,Default,,0,0,0,,Бұл жақсы нәрсе шығар, Алисия.
Dialogue: 0,0:50:37.95,0:50:38.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:40.45,0:50:45.29,Default,,0,0,0,,Жалғыз болсаң... Соғұрлым мұңаясың...
Dialogue: 0,0:50:46.16,0:50:49.17,Default,,0,0,0,,Себебі ол менің сүйікті адамым болды.
Dialogue: 0,0:50:51.59,0:50:54.00,Default,,0,0,0,,Бұл өмір бойы жалғасатын сияқты.
Dialogue: 0,0:50:54.96,0:50:59.89,Default,,0,0,0,,Осы аквамен жарқырап тұратын сүйіспеншілікке толы қатысу
Dialogue: 0,0:51:02.30,0:51:05.64,Default,,0,0,0,,Сондықтан менің мұңды сезімдерім де...
Dialogue: 0,0:51:06.02,0:51:08.23,Default,,0,0,0,,Бұл бақытты адам болудың белгісі.
Dialogue: 0,0:51:17.28,0:51:21.91,Default,,0,0,0,,Жүрегімде жинақталған тоқырау ериді
Dialogue: 0,0:51:27.45,0:51:32.63,Default,,0,0,0,,Тәнім мөлдір, түсің.
Dialogue: 0,0:51:33.96,0:51:37.84,Default,,0,0,0,,Акваны ақырын орап жатқандай.
Dialogue: 0,0:51:38.84,0:51:40.97,Default,,0,0,0,,Алыстағы көк теңіздей
Dialogue: 0,0:51:43.05,0:51:45.51,Default,,0,0,0,,Рахмет сізге Акари-чан
Dialogue: 0,0:51:52.94,0:51:56.86,Default,,0,0,0,,Ахахха Акари-чан маған солай деді ме?
Dialogue: 0,0:51:57.19,0:51:58.07,Default,,0,0,0,,Иә
Dialogue: 0,0:51:58.40,0:52:02.95,Default,,0,0,0,,Жалғыздық пен мұңды болу – бақыттың белгісі... Бұл сөзсіз.
Dialogue: 0,0:52:03.74,0:52:06.12,Default,,0,0,0,,Алиса да орта мектепті бітірді.
Dialogue: 0,0:52:06.54,0:52:08.54,Default,,0,0,0,,Біз де дайын болуымыз керек.
Dialogue: 0,0:52:10.08,0:52:14.13,Default,,0,0,0,,Сізді күтіп тұрған тек Гондола қауымдастығы ғана емес, ол да...
Dialogue: 0,0:52:14.88,0:52:15.71,Default,,0,0,0,,Иә
Dialogue: 0,0:52:15.84,0:52:17.63,Default,,0,0,0,,Олардың барлығы жақсылыққа толы.
Dialogue: 0,0:52:17.71,0:52:19.21,Default,,0,0,0,,бұл... (Акира) Иә.
Dialogue: 0,0:52:21.88,0:52:23.89,Default,,0,0,0,,Мен енді бір орында тұра алмаймын
Dialogue: 0,0:52:26.14,0:52:27.01,Default,,0,0,0,,Иә
Dialogue: 0,0:52:33.69,0:52:35.98,Default,,0,0,0,,Жаңбыр тоқтады
Dialogue: 0,0:52:38.65,0:52:39.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:42.78,0:52:45.12,Default,,0,0,0,,Олай болса, бастайық.
Dialogue: 0,0:52:45.74,0:52:46.62,Default,,0,0,0,,Иә
Dialogue: 0,0:52:48.49,0:52:50.33,Default,,0,0,0,,Сиқыр ериді
Dialogue: 0,0:52:51.54,0:52:55.42,Default,,0,0,0,,Тоқтап қалған уақытым қайта жылжи бастайды.
Dialogue: 0,0:52:56.75,0:52:58.42,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:52:59.30,0:53:00.51,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:53:01.01,0:53:03.59,Default,,0,0,0,,А... арман?
Dialogue: 0,0:53:04.09,0:53:06.05,Default,,0,0,0,,Сіз қандай түс көрдіңіз?
Dialogue: 0,0:53:07.72,0:53:10.64,Default,,0,0,0,,Уфу Сағынышқа толы кездесу туралы арман
Dialogue: 0,0:53:10.89,0:53:12.81,Default,,0,0,0,,Ах... хехе?
Dialogue: 0,0:53:14.23,0:53:16.86,Default,,0,0,0,,Мен өзімді еркін сезінгеніме біраз болды.
Dialogue: 0,0:53:17.52,0:53:19.73,Default,,0,0,0,,Жоспарлаған үш адамға рахмет.
Dialogue: 0,0:53:20.90,0:53:23.95,Default,,0,0,0,,Афина, сен келе алмадың.
Dialogue: 0,0:53:24.49,0:53:27.03,Default,,0,0,0,,Мен оны асығыс аяқтай алмаймын.
Dialogue: 0,0:53:27.74,0:53:29.33,Default,,0,0,0,,Мен күткендей
Dialogue: 0,0:53:29.95,0:53:33.79,Default,,0,0,0,,Бірақ сенің арқаңда тілегімнің дәні бұзылмай қалды.
Dialogue: 0,0:53:34.08,0:53:36.79,Default,,0,0,0,,А... Тілек дәні?
Dialogue: 0,0:53:36.88,0:53:40.42,Default,,0,0,0,,Иә, орындалмаған тілектің дәні
Dialogue: 0,0:53:40.75,0:53:45.51,Default,,0,0,0,,Жүрегімде қалып, үміт нұрын шашып келеді.
Dialogue: 0,0:53:46.51,0:53:51.93,Default,,0,0,0,,Өзіңіз өшірмесеңіз, толқу мәңгілікке жалғасады.
Dialogue: 0,0:53:53.22,0:53:56.19,Default,,0,0,0,,Бұл қуанышты жағдай емес пе?
Dialogue: 0,0:53:57.60,0:54:00.90,Default,,0,0,0,,Сондықтан сіз ол тұқымдарды сақтайсыз.
Dialogue: 0,0:54:01.36,0:54:04.90,Default,,0,0,0,,Ухухуху, бұл біртүрлі.
Dialogue: 0,0:54:05.11,0:54:08.03,Default,,0,0,0,,Мен ешқашан орындалмайды деп ойлаған тілегім
Dialogue: 0,0:54:08.24,0:54:13.04,Default,,0,0,0,,Кейде түріңді өзгертіп, кенет бетіңді көрсетесің.
Dialogue: 0,0:54:13.54,0:54:15.29,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:54:20.34,0:54:23.63,Default,,0,0,0,,Келесі жолы барлығымызды біріктіруге тырысайық.
Dialogue: 0,0:54:23.96,0:54:26.80,Default,,0,0,0,,Мүмкін келесі жолы гондола кешін өткізетін шығармыз.
Dialogue: 0,0:54:26.93,0:54:28.05,Default,,0,0,0,,Жақсы~
Dialogue: 0,0:54:33.72,0:54:36.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:39.19,0:54:40.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:41.98,0:54:45.99,Default,,0,0,0,,(Афинаның ән салған дауысы)
Dialogue: 0,0:54:49.49,0:54:50.70,Default,,0,0,0,,Афина Сенпай
Dialogue: 0,0:55:13.14,0:55:17.14,Default,,0,0,0,,(Афинаның ән салған дауысы)
Dialogue: 0,0:56:14.66,0:56:16.95,Default,,0,0,0,,Бұл үлкен ғажайып
Dialogue: 0,0:56:18.75,0:56:22.62,Default,,0,0,0,,Бүгін Ай Чан және басқалар жасаған Миракуру мерейтойы.
Dialogue: 0,0:56:22.83,0:56:24.88,Default,,0,0,0,,Ұятсыз жолдар жоқ
Dialogue: 0,0:56:26.09,0:56:29.88,Default,,0,0,0,,Содан бері біз қосылдық...
Dialogue: 0,0:56:30.13,0:56:30.97,Default,,0,0,0,,Иә
Dialogue: 0,0:56:33.13,0:56:38.14,Default,,0,0,0,,Әрқайсымыз жүретін жолдар қиылысып, жаңа жолға айналады.
Dialogue: 0,0:56:38.81,0:56:41.02,Default,,0,0,0,,Қайтадан кету
Dialogue: 0,0:56:42.89,0:56:44.98,Default,,0,0,0,,Құттықтаймыз, Алиса
Dialogue: 0,0:56:47.32,0:56:50.78,Default,,0,0,0,,Апельсин ханшайымы жоқ
Dialogue: 0,0:56:51.90,0:56:55.03,Default,,0,0,0,,Бүгіннен бастап сіз Prima Undineсіз.
Dialogue: 0,0:56:57.24,0:56:58.79,Default,,0,0,0,,Құлап қалсаң, қабылдамаймын.
Dialogue: 0,0:57:04.71,0:57:06.33,Default,,0,0,0,,Мәртебелі болашақ патшайым
Dialogue: 0,0:57:07.96,0:57:08.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:57:16.59,0:57:20.18,Default,,0,0,0,,Мен сені кездестіргеніме өте қуаныштымын
Dialogue: 0,0:57:21.93,0:57:25.19,Default,,0,0,0,,Рахмет саған менің Аквамарин
Dialogue: 0,0:57:25.90,0:57:29.15,Default,,0,0,0,,Ах... Аквамарин...
Dialogue: 0,0:57:31.36,0:57:33.19,Default,,0,0,0,,Алыс көк
Dialogue: 0,0:57:34.40,0:57:35.61,Default,,0,0,0,,Бугья~
Dialogue: 0,0:57:38.32,0:57:42.66,Default,,0,0,0,,Өйткені мен өз жолымды тоқтаусыз жүріп келемін...
Dialogue: 0,0:57:43.12,0:57:44.41,Default,,0,0,0,,Мен сені кездестірдім
Dialogue: 0,0:57:45.83,0:57:49.54,Default,,0,0,0,,Сондықтан біз жаңа сыйлыққа қарай жылжуды жалғастырамыз—
Dialogue: 0,0:57:50.38,0:57:51.55,Default,,0,0,0,,Жаяу жүру
Dialogue: 0,0:57:56.55,0:58:02.56,Default,,0,0,0,,♪〜
Dialogue: 0,0:59:42.32,0:59:44.16,Default,,0,0,0,,Енді ескек есуді бастайық
Dialogue: 0,0:59:44.99,0:59:46.83,Default,,0,0,0,,Біздің болашағымызға
Dialogue: 0,0:59:47.70,0:59:49.29,Default,,0,0,0,,Қош бол
Dialogue: 0,1:00:03.85,1:00:09.85,Default,,0,0,0,,〜♪
