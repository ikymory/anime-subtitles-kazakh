Dialogue: 0,0:00:30.16,0:00:50.11,Default,,0,0,0,,♬～
Dialogue: 0,0:00:50.11,0:01:10.13,Default,,0,0,0,,♬～
Dialogue: 0,0:01:10.13,0:01:17.14,Default,,0,0,0,,♬～
Dialogue: 0,0:01:17.14,0:01:19.11,Default,,0,0,0,,Пуи
Dialogue: 0,0:01:23.15,0:01:26.15,Default,,0,0,0,,Пуи Пуи Ча Пуй Ня
Dialogue: 0,0:01:26.15,0:01:32.16,Default,,0,0,0,,Мияу Пуинья Пуинья
Dialogue: 0,0:01:32.16,0:01:34.16,Default,,0,0,0,,Уау! Уау
Dialogue: 0,0:01:34.16,0:01:36.16,Default,,0,0,0,,Пуи... Пуи
Dialogue: 0,0:01:36.16,0:01:39.16,Default,,0,0,0,,Шамдар
Dialogue: 0,0:01:36.16,0:01:39.16,Default,,0,0,0,,Амансың ба? Ария президенті
Dialogue: 0,0:01:39.16,0:01:43.10,Default,,0,0,0,,Пуи
Dialogue: 0,0:01:39.16,0:01:43.10,Default,,0,0,0,,Құстармен дос болу стратегиясы➡
Dialogue: 0,0:01:43.10,0:01:46.10,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:01:46.10,0:01:48.10,Default,,0,0,0,,Пуи…
Dialogue: 0,0:01:48.10,0:01:51.11,Default,,0,0,0,,Қолымыздан келгеннің бәрін жасайық, берілмейік
Dialogue: 0,0:01:48.10,0:01:51.11,Default,,0,0,0,,Президент Ария
Dialogue: 0,0:01:51.11,0:01:53.11,Default,,0,0,0,,Егер сенсеңіз, бұл «Миракуру»
Dialogue: 0,0:01:53.11,0:01:56.11,Default,,0,0,0,,Мен де мүмкіндігінше тезірек
Dialogue: 0,0:01:53.11,0:01:56.11,Default,,0,0,0,,Prima Undine болыңыз➡
Dialogue: 0,0:01:56.11,0:01:58.11,Default,,0,0,0,,Мен бар күшімді салуым керек.
Dialogue: 0,0:01:58.11,0:02:01.12,Default,,0,0,0,,Енді жаттығуды орындаңыз
Dialogue: 0,0:02:01.12,0:02:03.12,Default,,0,0,0,,Ай Чан, сен қатты толқыдың.
Dialogue: 0,0:02:03.12,0:02:06.12,Default,,0,0,0,,Иә Жалғыз
Dialogue: 0,0:02:03.12,0:02:06.12,Default,,0,0,0,,Жоғары көтерілгеннен кейін➡
Dialogue: 0,0:02:06.12,0:02:09.13,Default,,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:02:09.13,0:02:12.13,Default,,0,0,0,,Енді бүгінгі жаттығуды бастайық.
Dialogue: 0,0:02:12.13,0:02:14.13,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:02:14.13,0:02:17.10,Default,,0,0,0,,Иә
Dialogue: 0,0:02:14.13,0:02:17.10,Default,,0,0,0,,Энчер
Dialogue: 0,0:02:24.14,0:02:28.14,Default,,0,0,0,,<Аква су планетасында
Dialogue: 0,0:02:24.14,0:02:28.14,Default,,0,0,0,,Нео Венеция>
Dialogue: 0,0:02:28.14,0:02:31.15,Default,,0,0,0,,＜Бұл жер бұрын болған
Dialogue: 0,0:02:28.14,0:02:31.15,Default,,0,0,0,,Ол кісінің үйінде болды➡
Dialogue: 0,0:02:31.15,0:02:36.15,Default,,0,0,0,,Венеция қаласы
Dialogue: 0,0:02:31.15,0:02:36.15,Default,,0,0,0,,Қайта шығарылған қала сияқты көшірілді＞
Dialogue: 0,0:02:36.15,0:02:40.16,Default,,0,0,0,,<Жаңа және ескі
Dialogue: 0,0:02:36.15,0:02:40.16,Default,,0,0,0,,Араластыру➡
Dialogue: 0,0:02:40.16,0:02:45.13,Default,,0,0,0,,Уақыт баяу өтеді
Dialogue: 0,0:02:40.16,0:02:45.13,Default,,0,0,0,,Кейде оғаш нәрселерді кездестіретін қала＞
Dialogue: 0,0:02:47.10,0:02:51.10,Default,,0,0,0,,<Ал мына қала
Dialogue: 0,0:02:47.10,0:02:51.10,Default,,0,0,0,,Гондоланың жетекшілігімен➡
Dialogue: 0,0:02:51.10,0:02:56.11,Default,,0,0,0,,Бізді Undine деп атайды
Dialogue: 0,0:02:51.10,0:02:56.11,Default,,0,0,0,,Мен ұшқышпын.＞
Dialogue: 0,0:02:56.11,0:02:59.11,Default,,0,0,0,,Ария
Dialogue: 0,0:02:56.11,0:02:59.11,Default,,0,0,0,,<Біздің ARIA компаниясында➡
Dialogue: 0,0:02:59.11,0:03:05.11,Default,,0,0,0,,Су алмұрт
Dialogue: 0,0:02:59.11,0:03:05.11,Default,,0,0,0,,Мен Акари Мизунаши және менің кіші Ай Чан
Dialogue: 0,0:02:59.11,0:03:05.11,Default,,0,0,0,,Біз сізге жол көрсетеміз >
Dialogue: 0,0:03:05.11,0:03:09.12,Default,,0,0,0,,<Тамаша саяхат болсын
Dialogue: 0,0:03:05.11,0:03:09.12,Default,,0,0,0,,Қосылайық>
Dialogue: 0,0:03:09.12,0:03:29.14,Default,,0,0,0,,♬～
Dialogue: 0,0:03:29.14,0:03:49.09,Default,,0,0,0,,♬～
Dialogue: 0,0:03:49.09,0:04:09.11,Default,,0,0,0,,♬～
Dialogue: 0,0:04:09.11,0:04:29.13,Default,,0,0,0,,♬～
Dialogue: 0,0:04:29.13,0:04:49.09,Default,,0,0,0,,♬～
Dialogue: 0,0:04:49.09,0:04:59.06,Default,,0,0,0,,♬～
Dialogue: 0,0:05:07.10,0:05:10.11,Default,,0,0,0,,Менің бұл екеуін кездестіргеніме көп уақыт болды.
Dialogue: 0,0:05:10.11,0:05:13.11,Default,,0,0,0,,Айка
Dialogue: 0,0:05:10.11,0:05:13.11,Default,,0,0,0,,Алиса да, Айка да
Dialogue: 0,0:05:10.11,0:05:13.11,Default,,0,0,0,,Prima Undine ретінде➡
Dialogue: 0,0:05:13.11,0:05:15.11,Default,,0,0,0,,Сіз тамаша жұмыс істеп жатырсыз.
Dialogue: 0,0:05:15.11,0:05:17.11,Default,,0,0,0,,А, бұл мысық!
Dialogue: 0,0:05:17.11,0:05:20.12,Default,,0,0,0,,Хуннюпуи
Dialogue: 0,0:05:17.11,0:05:20.12,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:05:20.12,0:05:22.12,Default,,0,0,0,,Бұл үш адам қалай кездейсоқ кездесіп қалды?
Dialogue: 0,0:05:22.12,0:05:25.12,Default,,0,0,0,,Оны маған Аква бергеніне сенімдімін.
Dialogue: 0,0:05:22.12,0:05:25.12,Default,,0,0,0,,Бұл «Миракуру»
Dialogue: 0,0:05:25.12,0:05:28.09,Default,,0,0,0,,«Ғажайып» иә...
Dialogue: 0,0:05:32.13,0:05:34.13,Default,,0,0,0,,Алисия
Dialogue: 0,0:05:32.13,0:05:34.13,Default,,0,0,0,,Ол әлі белсенді болған кезде➡
Dialogue: 0,0:05:34.13,0:05:38.10,Default,,0,0,0,,Мен күн сайын бос емеспін...
Dialogue: 0,0:05:39.14,0:05:42.07,Default,,0,0,0,,｟Хахи… Бұл кесте｠
Dialogue: 0,0:05:42.07,0:05:45.07,Default,,0,0,0,,｟Міне, Алисия-сан
Dialogue: 0,0:05:42.07,0:05:45.07,Default,,0,0,0,,Демалуға уақыт жоқ.
Dialogue: 0,0:05:45.07,0:05:47.08,Default,,0,0,0,,｟Пуи｠
Dialogue: 0,0:05:47.08,0:05:50.08,Default,,0,0,0,,｟Тез толыққанды тұлға болыңыз➡
Dialogue: 0,0:05:50.08,0:05:54.05,Default,,0,0,0,,Мен де сізге көмектесе аламын деп үміттенемін.
Dialogue: 0,0:05:50.08,0:05:54.05,Default,,0,0,0,,Болуы керек
Dialogue: 0,0:05:55.08,0:05:58.05,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:05:55.08,0:05:58.05,Default,,0,0,0,,｟Пуи｠
Dialogue: 0,0:05:59.09,0:06:01.06,Default,,0,0,0,,Акира
Dialogue: 0,0:05:59.09,0:06:01.06,Default,,0,0,0,,｟ Сәлем Акира-сан｠
Dialogue: 0,0:06:02.09,0:06:04.06,Default,,0,0,0,,｟Иә...｠
Dialogue: 0,0:06:05.09,0:06:08.10,Default,,0,0,0,,｟Маған үйде бірдеңе керек.
Dialogue: 0,0:06:05.09,0:06:08.10,Default,,0,0,0,,солай емес пе? ｠
Dialogue: 0,0:06:08.10,0:06:11.10,Default,,0,0,0,,｟Жоқ, кездейсоқ
Dialogue: 0,0:06:08.10,0:06:11.10,Default,,0,0,0,,Өйткені мен жай ғана өтіп бара жатырмын｠
Dialogue: 0,0:06:11.10,0:06:14.10,Default,,0,0,0,,｟Мүмкін
Dialogue: 0,0:06:11.10,0:06:14.10,Default,,0,0,0,,Сенің Алисияға қатысың бар ма? ｠
Dialogue: 0,0:06:14.10,0:06:16.11,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:06:16.11,0:06:21.08,Default,,0,0,0,,｟Қазір
Dialogue: 0,0:06:16.11,0:06:21.08,Default,,0,0,0,,А, мен бүгін...｠
Dialogue: 0,0:06:23.11,0:06:26.12,Default,,0,0,0,,(Акира)
Dialogue: 0,0:06:23.11,0:06:26.12,Default,,0,0,0,,｟Иә, бұл Алисияның жасырын туған күні｠
Dialogue: 0,0:06:26.12,0:06:29.12,Default,,0,0,0,,｟I
Dialogue: 0,0:06:26.12,0:06:29.12,Default,,0,0,0,,Мен оны мүлде байқамадым｠
Dialogue: 0,0:06:29.12,0:06:31.12,Default,,0,0,0,,｟ Акари-чан
Dialogue: 0,0:06:29.12,0:06:31.12,Default,,0,0,0,,Себебі мен Мэнхоумнанмын.
Dialogue: 0,0:06:31.12,0:06:33.12,Default,,0,0,0,,｟Менің таңдауым жоқ｠
Dialogue: 0,0:06:33.12,0:06:37.13,Default,,0,0,0,,｟Aqua күнтізбесінде
Dialogue: 0,0:06:33.12,0:06:37.13,Default,,0,0,0,,Өйткені бір жылда 24 ай бар➡
Dialogue: 0,0:06:37.13,0:06:40.13,Default,,0,0,0,,Тіпті 12 айдан кейін
Dialogue: 0,0:06:37.13,0:06:40.13,Default,,0,0,0,,Сіз туған күніңізді тойлап жатқансыз, солай ма?
Dialogue: 0,0:06:40.13,0:06:43.07,Default,,0,0,0,,｟Иә, бұл жасырын туған күн｠
Dialogue: 0,0:06:43.07,0:06:46.07,Default,,0,0,0,,｟Алисияның туған күні
Dialogue: 0,0:06:43.07,0:06:46.07,Default,,0,0,0,,30 қазанда➡
Dialogue: 0,0:06:46.07,0:06:50.07,Default,,0,0,0,,Өйткені бүгін 30 желтоқсан...｠
Dialogue: 0,0:06:50.07,0:06:54.08,Default,,0,0,0,,｟Бүгін де солай
Dialogue: 0,0:06:50.07,0:06:54.08,Default,,0,0,0,,Алисияның жасырын туған күні｠
Dialogue: 0,0:06:54.08,0:06:57.08,Default,,0,0,0,,｟Сондықтан мен саған сыйлық беру үшін барын салдым.
Dialogue: 0,0:06:54.08,0:06:57.08,Default,,0,0,0,,Сен келдің.
Dialogue: 0,0:06:57.08,0:07:02.08,Default,,0,0,0,,｟Аа, жоқ...Мен бүгінмін
Dialogue: 0,0:06:57.08,0:07:02.08,Default,,0,0,0,,Жарты күндік демалыс алғаныма көп болды➡
Dialogue: 0,0:07:02.08,0:07:04.09,Default,,0,0,0,,Мұңды жүзбен жұмыс істейтін сол жігітке➡
Dialogue: 0,0:07:04.09,0:07:09.06,Default,,0,0,0,,Кездейсоқ салқындату
Dialogue: 0,0:07:04.09,0:07:09.06,Default,,0,0,0,,Мен мұнда мақтануға келдім...
Dialogue: 0,0:07:11.09,0:07:15.10,Default,,0,0,0,,｟Алисия-сан, бүгін.
Dialogue: 0,0:07:11.09,0:07:15.10,Default,,0,0,0,,Ағымдағы тұтынушы - соңғы➡
Dialogue: 0,0:07:15.10,0:07:19.10,Default,,0,0,0,,Гондола қауымдастығының жиналысы сағат 18.00-ге дейін.
Dialogue: 0,0:07:15.10,0:07:19.10,Default,,0,0,0,,Бұл тегін｠
Dialogue: 0,0:07:19.10,0:07:22.10,Default,,0,0,0,,｟Түсіндім, рахмет｠
Dialogue: 0,0:07:22.10,0:07:26.11,Default,,0,0,0,,｟Шын мәнінде, бұл Афинаныкі.
Dialogue: 0,0:07:22.10,0:07:26.11,Default,,0,0,0,,Ол келуі керек еді➡
Dialogue: 0,0:07:26.11,0:07:30.11,Default,,0,0,0,,Менің шұғыл жұмысым бар сияқты.
Dialogue: 0,0:07:26.11,0:07:30.11,Default,,0,0,0,,｟Солай ма?｠
Dialogue: 0,0:07:30.11,0:07:35.12,Default,,0,0,0,,☎ (рингтон)
Dialogue: 0,0:07:30.11,0:07:35.12,Default,,0,0,0,,｟Иә Иә｠
Dialogue: 0,0:07:35.12,0:07:39.12,Default,,0,0,0,,｟Күткеніңізге рахмет
Dialogue: 0,0:07:35.12,0:07:39.12,Default,,0,0,0,,ARIA компаниясы｠
Dialogue: 0,0:07:39.12,0:07:42.06,Default,,0,0,0,,☎｟ Акари-чан? ｠
Dialogue: 0,0:07:39.12,0:07:42.06,Default,,0,0,0,,｟Ах, Алисия-сан｠
Dialogue: 0,0:07:42.06,0:07:46.06,Default,,0,0,0,,☎｟Кешіріңіз, қазірден бастап
Dialogue: 0,0:07:42.06,0:07:46.06,Default,,0,0,0,,Гондола қауымдастығының қонақтары үшін➡
Dialogue: 0,0:07:46.06,0:07:48.06,Default,,0,0,0,,Сізге хабарлау үшін
Dialogue: 0,0:07:46.06,0:07:48.06,Default,,0,0,0,,Бұл айналды
Dialogue: 0,0:07:48.06,0:07:50.07,Default,,0,0,0,,｟Иә｠
Dialogue: 0,0:07:50.07,0:07:54.07,Default,,0,0,0,,☎｟Кездесу түнде болады.
Dialogue: 0,0:07:50.07,0:07:54.07,Default,,0,0,0,,Мен үйге бүгін барамын.
Dialogue: 0,0:07:54.07,0:07:56.07,Default,,0,0,0,,｟фу｠
Dialogue: 0,0:07:54.07,0:07:56.07,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:07:56.07,0:07:59.08,Default,,0,0,0,,☎｟Жарайды онда.
Dialogue: 0,0:07:56.07,0:07:59.08,Default,,0,0,0,,Өйткені біз өз тұтынушыларымызды күтеміз｠
Dialogue: 0,0:07:59.08,0:08:01.04,Default,,0,0,0,,｟Иә…｠
Dialogue: 0,0:08:04.08,0:08:06.08,Default,,0,0,0,,｟Акира-сан…｠
Dialogue: 0,0:08:06.08,0:08:08.08,Default,,0,0,0,,｟Қазір...｠
Dialogue: 0,0:08:06.08,0:08:08.08,Default,,0,0,0,,｟Пуи? ｠
Dialogue: 0,0:08:08.08,0:08:11.09,Default,,0,0,0,,｟Мен де түннен
Dialogue: 0,0:08:08.08,0:08:11.09,Default,,0,0,0,,Үйде оқыту сабақтары кіреді➡
Dialogue: 0,0:08:11.09,0:08:13.09,Default,,0,0,0,,Мен жақында үйге барамын.
Dialogue: 0,0:08:13.09,0:08:17.06,Default,,0,0,0,,｟Мен саған сыйлық қалдырамын.
Dialogue: 0,0:08:13.09,0:08:17.06,Default,,0,0,0,,Маған ертең беріңізші.
Dialogue: 0,0:08:18.09,0:08:20.06,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:08:21.10,0:08:23.10,Default,,0,0,0,,｟Акира-сан｠
Dialogue: 0,0:08:21.10,0:08:23.10,Default,,0,0,0,,Иә? ｠
Dialogue: 0,0:08:23.10,0:08:26.10,Default,,0,0,0,,｟I Осыдан кейін
Dialogue: 0,0:08:23.10,0:08:26.10,Default,,0,0,0,,Өз бетімше жаттығым келеді➡
Dialogue: 0,0:08:26.10,0:08:29.11,Default,,0,0,0,,Менімен бірге бола аласыз ба? ｠
Dialogue: 0,0:08:29.11,0:08:31.11,Default,,0,0,0,,｟Өз бетінше оқыту? ｠
Dialogue: 0,0:08:29.11,0:08:31.11,Default,,0,0,0,,｟Иә｠
Dialogue: 0,0:08:31.11,0:08:34.11,Default,,0,0,0,,｟Алисия
Dialogue: 0,0:08:31.11,0:08:34.11,Default,,0,0,0,,Әсіресе жиі қолданылатын курстар үшін｠
Dialogue: 0,0:08:34.11,0:08:36.08,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:08:38.11,0:08:44.09,Default,,0,0,0,,｟Ааа, айтайын.
Dialogue: 0,0:08:38.11,0:08:44.09,Default,,0,0,0,,Менің басшылығым қатаң.
Dialogue: 0,0:08:45.05,0:08:48.06,Default,,0,0,0,,｟Иә, көп рахмет｠
Dialogue: 0,0:08:48.06,0:09:08.08,Default,,0,0,0,,♬～
Dialogue: 0,0:09:08.08,0:09:28.10,Default,,0,0,0,,♬～
Dialogue: 0,0:09:28.10,0:09:30.10,Default,,0,0,0,,｟ Рахмет сізге Акари-чан｠
Dialogue: 0,0:09:30.10,0:09:33.10,Default,,0,0,0,,｟Қайтамыз ба?｠
Dialogue: 0,0:09:33.10,0:09:35.07,Default,,0,0,0,,｟Иә…｠
Dialogue: 0,0:09:38.11,0:09:43.11,Default,,0,0,0,,｟Шынымен де бүгін саған сыйлығым бар.
Dialogue: 0,0:09:38.11,0:09:43.11,Default,,0,0,0,,Мақсат оны сізге беру емес｠
Dialogue: 0,0:09:43.11,0:09:45.08,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:09:46.12,0:09:48.12,Default,,0,0,0,,｟Мен бойдақ кезімнен
Dialogue: 0,0:09:46.12,0:09:48.12,Default,,0,0,0,,Мәңгі бірге➡
Dialogue: 0,0:09:48.12,0:09:51.12,Default,,0,0,0,,Барыңды шын жүректен істе
Dialogue: 0,0:09:48.12,0:09:51.12,Default,,0,0,0,,Прима болыңыз➡
Dialogue: 0,0:09:51.12,0:09:55.12,Default,,0,0,0,,Судың үш ұлы перілері
Dialogue: 0,0:09:51.12,0:09:55.12,Default,,0,0,0,,Мені шақыра бастады...｠
Dialogue: 0,0:09:55.12,0:09:59.13,Default,,0,0,0,,｟Бірақ үшеуміз кездесеміз➡
Dialogue: 0,0:09:59.13,0:10:02.13,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:09:59.13,0:10:02.13,Default,,0,0,0,,Бұл қиындап барады｠
Dialogue: 0,0:10:02.13,0:10:06.14,Default,,0,0,0,,｟Сондықтан мен көп ойлаймын｠
Dialogue: 0,0:10:06.14,0:10:11.14,Default,,0,0,0,,｟Үшеуміз қашан кездесе аламыз?
Dialogue: 0,0:10:06.14,0:10:11.14,Default,,0,0,0,,Бұл өте маңызды.
Dialogue: 0,0:10:11.14,0:10:15.14,Default,,0,0,0,,｟Ол күндерге қайта оралғым келмейді.
Dialogue: 0,0:10:11.14,0:10:15.14,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:10:15.14,0:10:22.12,Default,,0,0,0,,｟Неге екенін білмеймін, бірақ бүгін
Dialogue: 0,0:10:15.14,0:10:22.12,Default,,0,0,0,,Мен үшеуміз кездескіміз келгендей болды.
Dialogue: 0,0:10:25.15,0:10:29.16,Default,,0,0,0,,｟Ах, өте аянышты｠
Dialogue: 0,0:10:29.16,0:10:32.13,Default,,0,0,0,,｟Кішкентай қыз
Dialogue: 0,0:10:29.16,0:10:32.13,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:10:34.16,0:10:37.17,Default,,0,0,0,,｟А, а, а...! ｠
Dialogue: 0,0:10:37.17,0:10:39.14,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:10:46.11,0:10:48.08,Default,,0,0,0,,｟Алисия｠
Dialogue: 0,0:10:51.11,0:10:53.08,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:10:56.12,0:10:58.12,Default,,0,0,0,,♪ (Афинаның ән салған дауысы)
Dialogue: 0,0:10:58.12,0:11:01.12,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:11:01.12,0:11:04.13,Default,,0,0,0,,♪ (Афинаның ән салған дауысы)
Dialogue: 0,0:11:04.13,0:11:06.13,Default,,0,0,0,,｟Ха…｠
Dialogue: 0,0:11:06.13,0:11:11.13,Default,,0,0,0,,♪ (Афинаның ән салған дауысы)
Dialogue: 0,0:11:11.13,0:11:21.14,Default,,0,0,0,,♪～
Dialogue: 0,0:11:21.14,0:11:24.15,Default,,0,0,0,,｟Афина｠
Dialogue: 0,0:11:24.15,0:11:26.12,Default,,0,0,0,,｟Пуи Пуи Жаңа｠
Dialogue: 0,0:11:31.15,0:11:34.16,Default,,0,0,0,,｟｟｠
Dialogue: 0,0:11:31.15,0:11:34.16,Default,,0,0,0,,Кімге ｟? ｠
Dialogue: 0,0:11:34.16,0:11:40.16,Default,,0,0,0,,｟Құрметті қауымдастық мүшелері
Dialogue: 0,0:11:34.16,0:11:40.16,Default,,0,0,0,,Химея
Dialogue: 0,0:11:34.16,0:11:40.16,Default,,0,0,0,,Бұл Химеядан келген Акира Э. Феррари｠
Dialogue: 0,0:11:40.16,0:11:44.10,Default,,0,0,0,,｟Бір сәт кешірім сұраймын
Dialogue: 0,0:11:40.16,0:11:44.10,Default,,0,0,0,,Мені кешіріңіз｠
Dialogue: 0,0:11:44.10,0:11:47.07,Default,,0,0,0,,｟Ал, Алисия! ｠
Dialogue: 0,0:11:48.10,0:11:51.11,Default,,0,0,0,,｟Пуи... Пуина｠
Dialogue: 0,0:11:48.10,0:11:51.11,Default,,0,0,0,,｟Уау｠
Dialogue: 0,0:11:51.11,0:12:01.12,Default,,0,0,0,,♪～
Dialogue: 0,0:12:01.12,0:12:04.12,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:12:04.12,0:12:06.12,Default,,0,0,0,,｟Уф…｠
Dialogue: 0,0:12:06.12,0:12:08.12,Default,,0,0,0,,｟Акира-сан｠
Dialogue: 0,0:12:06.12,0:12:08.12,Default,,0,0,0,,｟Пуэнь｠
Dialogue: 0,0:12:08.12,0:12:19.10,Default,,0,0,0,,♪～
Dialogue: 0,0:12:21.14,0:12:23.14,Default,,0,0,0,,｟Туған күніңмен Алисия! ｠
Dialogue: 0,0:12:23.14,0:12:26.14,Default,,0,0,0,,｟Пуи Пуи Жаңа｠
Dialogue: 0,0:12:26.14,0:12:28.11,Default,,0,0,0,,｟Хехе｠
Dialogue: 0,0:12:29.15,0:12:33.15,Default,,0,0,0,,｟Пуи Пуи Пуи Чар｠
Dialogue: 0,0:12:33.15,0:12:37.15,Default,,0,0,0,,♪～
Dialogue: 0,0:12:37.15,0:12:41.09,Default,,0,0,0,,｟Рахмет
Dialogue: 0,0:12:37.15,0:12:41.09,Default,,0,0,0,,Акари-чанға рахмет｠
Dialogue: 0,0:12:41.09,0:12:43.09,Default,,0,0,0,,｟Жоқ｠
Dialogue: 0,0:12:43.09,0:12:46.10,Default,,0,0,0,,｟Бұл «Миракуру»｠
Dialogue: 0,0:12:46.10,0:12:49.10,Default,,0,0,0,,｟Таңғажайып Акира-сан｠
Dialogue: 0,0:12:49.10,0:12:52.10,Default,,0,0,0,,｟Хахахаха｠
Dialogue: 0,0:12:52.10,0:12:57.11,Default,,0,0,0,,｟Сен асыра айтып тұрсың, Акари-чан｠
Dialogue: 0,0:12:52.10,0:12:57.11,Default,,0,0,0,,｟… Иә｠
Dialogue: 0,0:12:57.11,0:13:01.08,Default,,0,0,0,,｟Бірақ бұл шынымен де ғажайып｠
Dialogue: 0,0:13:05.11,0:13:10.12,Default,,0,0,0,,Мұны айтқанда Акира күлді.
Dialogue: 0,0:13:05.11,0:13:10.12,Default,,0,0,0,,Алисия да, Афина да➡
Dialogue: 0,0:13:10.12,0:13:15.09,Default,,0,0,0,,Сол кезде маған көрсеткен күлкің
Dialogue: 0,0:13:10.12,0:13:15.09,Default,,0,0,0,,Ол кішкентай қызға ұқсайды.
Dialogue: 0,0:13:19.13,0:13:22.13,Default,,0,0,0,,Жақсы нәрсе
Dialogue: 0,0:13:22.13,0:13:24.13,Default,,0,0,0,,Иә
Dialogue: 0,0:13:24.13,0:13:27.14,Default,,0,0,0,,Мен де... Мен де бір күні➡
Dialogue: 0,0:13:27.14,0:13:30.14,Default,,0,0,0,,Алисия үшін
Dialogue: 0,0:13:27.14,0:13:30.14,Default,,0,0,0,,Акира-сан және Афина-сан➡
Dialogue: 0,0:13:30.14,0:13:33.14,Default,,0,0,0,,Акари-сан үшін
Dialogue: 0,0:13:30.14,0:13:33.14,Default,,0,0,0,,Айка мен Алиса➡ сияқты
Dialogue: 0,0:13:33.14,0:13:36.15,Default,,0,0,0,,Мен біреуді кездестірсем жақсы болар еді
Dialogue: 0,0:13:36.15,0:13:40.15,Default,,0,0,0,,Иә, кездесетінімізге сенімдімін.
Dialogue: 0,0:13:36.15,0:13:40.15,Default,,0,0,0,,Ай Чан да
Dialogue: 0,0:13:40.15,0:13:42.08,Default,,0,0,0,,Пунья
Dialogue: 0,0:13:42.08,0:13:44.09,Default,,0,0,0,,Өйткені бұл «Миракуру»
Dialogue: 0,0:13:42.08,0:13:44.09,Default,,0,0,0,,Жұлдыздар көп➡
Dialogue: 0,0:13:44.09,0:13:47.06,Default,,0,0,0,,Себебі мен Акваға келдім
Dialogue: 0,0:13:48.09,0:13:50.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:55.10,0:13:58.10,Default,,0,0,0,,<Біреумен кездескіңіз келгенде
Dialogue: 0,0:13:55.10,0:13:58.10,Default,,0,0,0,,Таныса білу>
Dialogue: 0,0:13:58.10,0:14:01.10,Default,,0,0,0,,<Тыңдағыңыз келгенде
Dialogue: 0,0:13:58.10,0:14:01.10,Default,,0,0,0,,Дауысты ести білу＞
Dialogue: 0,0:14:01.10,0:14:04.11,Default,,0,0,0,,<Бұл ештеңе емес.
Dialogue: 0,0:14:01.10,0:14:04.11,Default,,0,0,0,,Мен не ойлап отырмын➡
Dialogue: 0,0:14:04.11,0:14:08.11,Default,,0,0,0,,Шын мәнінде таңқаларлық
Dialogue: 0,0:14:04.11,0:14:08.11,Default,,0,0,0,,Бұл «Миракуру»> болуы мүмкін
Dialogue: 0,0:14:08.11,0:14:13.08,Default,,0,0,0,,＜Енді осылай
Dialogue: 0,0:14:08.11,0:14:13.08,Default,,0,0,0,,Ай Чанмен бірге болу>
Dialogue: 0,0:14:27.13,0:14:29.13,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:14:29.13,0:14:32.13,Default,,0,0,0,,Хмм, қанағаттандым!
Dialogue: 0,0:14:29.13,0:14:32.13,Default,,0,0,0,,Гондола - ең жақсы!
Dialogue: 0,0:14:32.13,0:14:35.14,Default,,0,0,0,,Акари-сан!
Dialogue: 0,0:14:32.13,0:14:35.14,Default,,0,0,0,,Пуину Пуи
Dialogue: 0,0:14:35.14,0:14:37.14,Default,,0,0,0,,Бұл қиын! Бұл керемет!
Dialogue: 0,0:14:37.14,0:14:40.14,Default,,0,0,0,,Ай-чан, тұтынушы...
Dialogue: 0,0:14:37.14,0:14:40.14,Default,,0,0,0,,Хмм?
Dialogue: 0,0:14:40.14,0:14:42.08,Default,,0,0,0,,Ах, кешіріңіз.
Dialogue: 0,0:14:40.14,0:14:42.08,Default,,0,0,0,,Нашар
Dialogue: 0,0:14:42.08,0:14:45.08,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Маған қол ұшын беріңіз.
Dialogue: 0,0:14:45.08,0:14:48.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:45.08,0:14:48.08,Default,,0,0,0,,Керемет нәрсе болды.
Dialogue: 0,0:14:48.08,0:14:50.09,Default,,0,0,0,,Иә! Өте
Dialogue: 0,0:14:50.09,0:14:52.09,Default,,0,0,0,,Бұл қала «Миракуру»
Dialogue: 0,0:14:50.09,0:14:52.09,Default,,0,0,0,,Толып жатыр.
Dialogue: 0,0:14:52.09,0:14:54.09,Default,,0,0,0,,көремін.
Dialogue: 0,0:14:54.09,0:14:57.09,Default,,0,0,0,,Біз де
Dialogue: 0,0:14:54.09,0:14:57.09,Default,,0,0,0,,Мен «Миракурумен» таныстым
Dialogue: 0,0:14:57.09,0:15:00.10,Default,,0,0,0,,Ол үшін ертең де
Dialogue: 0,0:14:57.09,0:15:00.10,Default,,0,0,0,,Мен көп жүремін.
Dialogue: 0,0:15:00.10,0:15:02.10,Default,,0,0,0,,Бұл кездейсоқтық.
Dialogue: 0,0:15:00.10,0:15:02.10,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:02.10,0:15:04.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:04.10,0:15:06.10,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:06.10,0:15:10.11,Default,,0,0,0,,Қай жерде тамақтану керек?
Dialogue: 0,0:15:06.10,0:15:10.11,Default,,0,0,0,,Мен китара жегім келеді
Dialogue: 0,0:15:10.11,0:15:14.11,Default,,0,0,0,,О, тамаша
Dialogue: 0,0:15:10.11,0:15:14.11,Default,,0,0,0,,Сонымен, Ай Чанның «Миракуру» деген не?
Dialogue: 0,0:15:14.11,0:15:16.11,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:15:16.11,0:15:19.11,Default,,0,0,0,,Тыңдашы, Акари-сан.
Dialogue: 0,0:15:16.11,0:15:19.11,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:15:19.11,0:15:21.12,Default,,0,0,0,,Таңғажайып «миракуру» оқиғалары орын алады
Dialogue: 0,0:15:19.11,0:15:21.12,Default,,0,0,0,,болды
Dialogue: 0,0:15:21.12,0:15:23.12,Default,,0,0,0,,Не?
Dialogue: 0,0:15:23.12,0:15:25.12,Default,,0,0,0,,Дұрыс па? Ария президенті
Dialogue: 0,0:15:25.12,0:15:28.12,Default,,0,0,0,,Cui! Пуи Пуи…
Dialogue: 0,0:15:25.12,0:15:28.12,Default,,0,0,0,,Президент Ария қатты толқыды
Dialogue: 0,0:15:28.12,0:15:32.13,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:15:28.12,0:15:32.13,Default,,0,0,0,,Бұл шынымен де біртүрлі.
Dialogue: 0,0:15:32.13,0:15:35.13,Default,,0,0,0,,Мүмкін мен Аква шығармын.
Dialogue: 0,0:15:32.13,0:15:35.13,Default,,0,0,0,,«Миракуруға» кіру➡
Dialogue: 0,0:15:35.13,0:15:37.13,Default,,0,0,0,,Мүмкін мен таптым
Dialogue: 0,0:15:35.13,0:15:37.13,Default,,0,0,0,,Мен емес
Dialogue: 0,0:15:37.13,0:15:41.07,Default,,0,0,0,,Иә, не? Не болды?
Dialogue: 0,0:15:41.07,0:15:51.08,Default,,0,0,0,,♬～
Dialogue: 0,0:15:51.08,0:15:53.05,Default,,0,0,0,,Ах
Dialogue: 0,0:15:55.08,0:15:57.09,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:55.08,0:15:57.09,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:57.09,0:15:59.09,Default,,0,0,0,,Барлық шешім
Dialogue: 0,0:15:57.09,0:15:59.09,Default,,0,0,0,,Сіз осылай көріне бастадыңыз.
Dialogue: 0,0:15:59.09,0:16:02.09,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:15:59.09,0:16:02.09,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе!
Dialogue: 0,0:16:02.09,0:16:04.09,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:04.09,0:16:06.10,Default,,0,0,0,,Ағай да
Dialogue: 0,0:16:04.09,0:16:06.10,Default,,0,0,0,,Жұмысыңызға сәттілік
Dialogue: 0,0:16:06.10,0:16:08.06,Default,,0,0,0,,О
Dialogue: 0,0:16:11.10,0:16:17.11,Default,,0,0,0,,Ммф, иә?
Dialogue: 0,0:16:11.10,0:16:17.11,Default,,0,0,0,,Мен керемет күн болатынын сеземін.
Dialogue: 0,0:16:17.11,0:16:20.11,Default,,0,0,0,,Көптеген жылдар бойы дәрігер болып—
Dialogue: 0,0:16:17.11,0:16:20.11,Default,,0,0,0,,Мұндай нәрсеге қуанба
Dialogue: 0,0:16:20.11,0:16:23.08,Default,,0,0,0,,Практика
Dialogue: 0,0:16:24.11,0:16:27.12,Default,,0,0,0,,Ммм...
Dialogue: 0,0:16:27.12,0:16:29.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:38.13,0:16:42.06,Default,,0,0,0,,Осындай жерде аллея болды ма?
Dialogue: 0,0:16:42.06,0:16:44.03,Default,,0,0,0,,Ах
Dialogue: 0,0:16:47.07,0:16:49.04,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:16:50.07,0:16:55.08,Default,,0,0,0,,Жоқ, бұл... Кэйт Сит!
Dialogue: 0,0:16:55.08,0:17:00.08,Default,,0,0,0,,Нх ха ха...
Dialogue: 0,0:17:00.08,0:17:03.09,Default,,0,0,0,,Пуи Пуи Мяу
Dialogue: 0,0:17:03.09,0:17:23.11,Default,,0,0,0,,♬～
Dialogue: 0,0:17:23.11,0:17:43.06,Default,,0,0,0,,♬～
Dialogue: 0,0:17:43.06,0:18:03.08,Default,,0,0,0,,♬～
Dialogue: 0,0:18:03.08,0:18:23.10,Default,,0,0,0,,♬～
Dialogue: 0,0:18:23.10,0:18:38.08,Default,,0,0,0,,♬～
Dialogue: 0,0:18:44.05,0:18:47.06,Default,,0,0,0,,…
Dialogue: 0,0:18:47.06,0:18:50.06,Default,,0,0,0,,Пуйчер
Dialogue: 0,0:18:50.06,0:18:53.06,Default,,0,0,0,,Мен осындай жерге қосылғаныма сене алар емеспін.
Dialogue: 0,0:18:53.06,0:18:58.03,Default,,0,0,0,,Президент Ария, сіз білесіз бе?
Dialogue: 0,0:18:53.06,0:18:58.03,Default,,0,0,0,,Мен енді сол қателігімді қайталамаймын.
Dialogue: 0,0:19:00.07,0:19:05.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:00.07,0:19:05.07,Default,,0,0,0,,Мияу Мияу Мияу
Dialogue: 0,0:19:05.07,0:19:09.08,Default,,0,0,0,,Мен мұнда емеспін, мен сені көрмей қалдым деп ойлаймын.
Dialogue: 0,0:19:09.08,0:19:11.08,Default,,0,0,0,,Иә? Няня!
Dialogue: 0,0:19:11.08,0:19:13.08,Default,,0,0,0,,Бізге себу деген нені білдіреді?➡
Dialogue: 0,0:19:13.08,0:19:17.09,Default,,0,0,0,,Бұл мысық, мен сенімдімін
Dialogue: 0,0:19:13.08,0:19:17.09,Default,,0,0,0,,Тек ешкім емес
Dialogue: 0,0:19:17.09,0:19:19.09,Default,,0,0,0,,Хуо
Dialogue: 0,0:19:17.09,0:19:19.09,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:19:19.09,0:19:22.09,Default,,0,0,0,,Сіз Кейт Ситті іздедіңіз бе?
Dialogue: 0,0:19:22.09,0:19:25.09,Default,,0,0,0,,ше? Кейт Ситті іздеп жүрсіз бе?
Dialogue: 0,0:19:25.09,0:19:28.10,Default,,0,0,0,,Ах, ARIA компаниясы.
Dialogue: 0,0:19:25.09,0:19:28.10,Default,,0,0,0,,Сіз жаңадан келген адамсыз.
Dialogue: 0,0:19:28.10,0:19:33.07,Default,,0,0,0,,А... сендер балалар...
Dialogue: 0,0:19:38.11,0:19:41.11,Default,,0,0,0,,Мен Азуса Б. Макларенмін
Dialogue: 0,0:19:41.11,0:19:45.11,Default,,0,0,0,,Химея филиалында филиал менеджері былай деді:
Dialogue: 0,0:19:41.11,0:19:45.11,Default,,0,0,0,,Сізге басшылық жасалып жатыр ма?
Dialogue: 0,0:19:45.11,0:19:48.12,Default,,0,0,0,,Мен өзім не айтамын?
Dialogue: 0,0:19:45.11,0:19:48.12,Default,,0,0,0,,Перспективалық акция.
Dialogue: 0,0:19:48.12,0:19:50.12,Default,,0,0,0,,(Аня)
Dialogue: 0,0:19:48.12,0:19:50.12,Default,,0,0,0,,Аня Достоевская
Dialogue: 0,0:19:50.12,0:19:54.12,Default,,0,0,0,,Қызғылт сары планетада
Dialogue: 0,0:19:50.12,0:19:54.12,Default,,0,0,0,,Мен Алиса-сенпайға қарыздармын.
Dialogue: 0,0:19:54.12,0:19:57.13,Default,,0,0,0,,Айно
Dialogue: 0,0:19:54.12,0:19:57.13,Default,,0,0,0,,А, мен Айно Аймын.
Dialogue: 0,0:19:57.13,0:19:59.13,Default,,0,0,0,,Мен білемін~
Dialogue: 0,0:19:59.13,0:20:01.13,Default,,0,0,0,,А... неге?
Dialogue: 0,0:20:01.13,0:20:03.13,Default,,0,0,0,,Иә, әжеден бері ұрпақтан-ұрпаққа жалғасып келеді➡
Dialogue: 0,0:20:03.13,0:20:06.13,Default,,0,0,0,,Беделді ARIA компаниясына жаңадан келген адам
Dialogue: 0,0:20:03.13,0:20:06.13,Default,,0,0,0,,Шаршасаңыз➡
Dialogue: 0,0:20:06.13,0:20:08.14,Default,,0,0,0,,Мен қызықпын және оны қарастырамын.
Dialogue: 0,0:20:08.14,0:20:12.14,Default,,0,0,0,,Иә, тексеріңіз.
Dialogue: 0,0:20:08.14,0:20:12.14,Default,,0,0,0,,Біртүрлі жаңа жігіт болса ше?➡
Dialogue: 0,0:20:12.14,0:20:15.14,Default,,0,0,0,,Сібірге жіберілді
Dialogue: 0,0:20:12.14,0:20:15.14,Default,,0,0,0,,Эх!
Dialogue: 0,0:20:15.14,0:20:19.15,Default,,0,0,0,,Сібір қайда орналасқан?
Dialogue: 0,0:20:15.14,0:20:19.15,Default,,0,0,0,,Енді мен бұл туралы көп білмеймін.
Dialogue: 0,0:20:19.15,0:20:22.15,Default,,0,0,0,,Мұны қалай тексересіз?
Dialogue: 0,0:20:22.15,0:20:24.15,Default,,0,0,0,,Гондола қауымдастығының тіркеу деректері
Dialogue: 0,0:20:24.15,0:20:26.15,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,0:20:26.15,0:20:30.16,Default,,0,0,0,,Мен филиал менеджерінен естідім.
Dialogue: 0,0:20:26.15,0:20:30.16,Default,,0,0,0,,Ақпаратқа сәйкес…
Dialogue: 0,0:20:30.16,0:20:32.16,Default,,0,0,0,,Бұрынғы гондола тегін шабандоз
Dialogue: 0,0:20:30.16,0:20:32.16,Default,,0,0,0,,А...
Dialogue: 0,0:20:32.16,0:20:37.17,Default,,0,0,0,,Дегенмен, ARIA компаниясының
Dialogue: 0,0:20:32.16,0:20:37.17,Default,,0,0,0,,Ол өзінің өмірін үлкен күшпен өзгерткенін айтты.
Dialogue: 0,0:20:37.17,0:20:39.17,Default,,0,0,0,,Сол екеуі
Dialogue: 0,0:20:37.17,0:20:39.17,Default,,0,0,0,,Сіз мысық іздеп жүрсіз бе?
Dialogue: 0,0:20:39.17,0:20:41.10,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:20:41.10,0:20:44.11,Default,,0,0,0,,Мына жерде көк көзді мысық бар.
Dialogue: 0,0:20:41.10,0:20:44.11,Default,,0,0,0,,Ол пайда болды деген қауесет бар.
Dialogue: 0,0:20:44.11,0:20:48.11,Default,,0,0,0,,Қазір Himeya Main Store президенті
Dialogue: 0,0:20:44.11,0:20:48.11,Default,,0,0,0,,Біз жақсы пікірлерді іздейміз.
Dialogue: 0,0:20:48.11,0:20:50.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:50.11,0:20:54.12,Default,,0,0,0,,-де Ай мырза
Dialogue: 0,0:20:50.11,0:20:54.12,Default,,0,0,0,,Сіз Кейт Ситті іздедіңіз бе?
Dialogue: 0,0:20:54.12,0:20:56.12,Default,,0,0,0,,Хахаха мүмкін емес
Dialogue: 0,0:20:56.12,0:20:59.12,Default,,0,0,0,,Бұл Элис-сенпайға да қатысты.
Dialogue: 0,0:20:56.12,0:20:59.12,Default,,0,0,0,,Мен естідім➡
Dialogue: 0,0:20:59.12,0:21:04.13,Default,,0,0,0,,Ай-сан Акари-саннан кейінгі екінші орында.
Dialogue: 0,0:20:59.12,0:21:04.13,Default,,0,0,0,,Тамаша жұмбақ кездесулердің жылдамдығы жоғары болса
Dialogue: 0,0:21:04.13,0:21:06.13,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:21:06.13,0:21:09.13,Default,,0,0,0,,Мен бұрын көлеңке көрдім деп ойладым.
Dialogue: 0,0:21:09.13,0:21:14.14,Default,,0,0,0,,Бұл мені қуантты.
Dialogue: 0,0:21:09.13,0:21:14.14,Default,,0,0,0,,Мені қусаң, осында жетесің.
Dialogue: 0,0:21:14.14,0:21:17.14,Default,,0,0,0,,Мен біртүрлі нәрсе айтып тұрмын ба?
Dialogue: 0,0:21:17.14,0:21:20.14,Default,,0,0,0,,Жоқ, бар, бар!
Dialogue: 0,0:21:17.14,0:21:20.14,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:21:20.14,0:21:25.15,Default,,0,0,0,,Жарайсыңдар! Жарайды онда
Dialogue: 0,0:21:20.14,0:21:25.15,Default,,0,0,0,,Оны бірге іздейміз, жарай ма?
Dialogue: 0,0:21:25.15,0:21:27.15,Default,,0,0,0,,Ябусакада емес
Dialogue: 0,0:21:27.15,0:21:30.15,Default,,0,0,0,,Филиал меңгерушісі жиі айтады
Dialogue: 0,0:21:27.15,0:21:30.15,Default,,0,0,0,,Күшті шабуылдар➡
Dialogue: 0,0:21:30.15,0:21:33.16,Default,,0,0,0,,Керемет нәрсені сезініңіз
Dialogue: 0,0:21:30.15,0:21:33.16,Default,,0,0,0,,Жақсы мүмкіндік
Dialogue: 0,0:21:33.16,0:21:37.16,Default,,0,0,0,,Момент
Dialogue: 0,0:21:33.16,0:21:37.16,Default,,0,0,0,,Ендеше бірге ойнайық
Dialogue: 0,0:21:37.16,0:21:39.16,Default,,0,0,0,,Хмм, жоқ...
Dialogue: 0,0:21:39.16,0:21:41.10,Default,,0,0,0,,Мұнда тағы келіңіз
Dialogue: 0,0:21:39.16,0:21:41.10,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:41.10,0:21:45.10,Default,,0,0,0,,А... Шынайы ма?
Dialogue: 0,0:21:41.10,0:21:45.10,Default,,0,0,0,,(Декү) Кешір мені (Каири) Ах…
Dialogue: 0,0:21:45.10,0:21:51.07,Default,,0,0,0,,Хаха...
Dialogue: 0,0:21:45.10,0:21:51.07,Default,,0,0,0,,Хаха...
Dialogue: 0,0:21:53.11,0:21:55.11,Default,,0,0,0,,Мен енді жүре алмаймын
Dialogue: 0,0:21:55.11,0:21:58.11,Default,,0,0,0,,Қандай сүйкімді бала
Dialogue: 0,0:21:55.11,0:21:58.11,Default,,0,0,0,,Демалу дегеннің не екенін білмейсің бе?
Dialogue: 0,0:21:58.11,0:22:00.12,Default,,0,0,0,,Уф... Кешіріңіз.
Dialogue: 0,0:22:00.12,0:22:03.12,Default,,0,0,0,,Өте керемет...
Dialogue: 0,0:22:00.12,0:22:03.12,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:22:03.12,0:22:06.12,Default,,0,0,0,,Мм... шәй ішкің келе ме?
Dialogue: 0,0:22:06.12,0:22:10.09,Default,,0,0,0,,Иә, бар!
Dialogue: 0,0:22:06.12,0:22:10.09,Default,,0,0,0,,Мен күттім!
Dialogue: 0,0:22:11.13,0:22:13.13,Default,,0,0,0,,Күткеніңізге рахмет, Президент Ария.
Dialogue: 0,0:22:13.13,0:22:16.13,Default,,0,0,0,,Пунья!
Dialogue: 0,0:22:16.13,0:22:20.14,Default,,0,0,0,,Пухат
Dialogue: 0,0:22:16.13,0:22:20.14,Default,,0,0,0,,Мен ақыры дем ала аламын.
Dialogue: 0,0:22:20.14,0:22:24.14,Default,,0,0,0,,тым кеш, бірақ бүгін, Азуса-чан.
Dialogue: 0,0:22:20.14,0:22:24.14,Default,,0,0,0,,Мен әрең жаттығамын➡
Dialogue: 0,0:22:24.14,0:22:26.14,Default,,0,0,0,,Айка-сан саған ашуланбайды ма?
Dialogue: 0,0:22:26.14,0:22:29.14,Default,,0,0,0,,Жоқ, жоқ, бірақ➡
Dialogue: 0,0:22:29.14,0:22:33.15,Default,,0,0,0,,Жаңа президенттікке кандидат үшін мысық.
Dialogue: 0,0:22:29.14,0:22:33.15,Default,,0,0,0,,Мен оны іздегендіктен...
Dialogue: 0,0:22:33.15,0:22:35.15,Default,,0,0,0,,(Аня)
Dialogue: 0,0:22:33.15,0:22:35.15,Default,,0,0,0,,Мен негізінен Кейт Ситті іздедім.
Dialogue: 0,0:22:35.15,0:22:37.15,Default,,0,0,0,,Няняня...
Dialogue: 0,0:22:37.15,0:22:40.16,Default,,0,0,0,,Алиса-сенпайға қарағанда
Dialogue: 0,0:22:37.15,0:22:40.16,Default,,0,0,0,,Айка-сан қатал➡
Dialogue: 0,0:22:40.16,0:22:42.09,Default,,0,0,0,,Мені қандай жаза күтіп тұр?
Dialogue: 0,0:22:42.09,0:22:44.09,Default,,0,0,0,,А... бұл жаман болуы мүмкін.
Dialogue: 0,0:22:44.09,0:22:46.09,Default,,0,0,0,,Бұл!
Dialogue: 0,0:22:44.09,0:22:46.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:46.09,0:22:49.10,Default,,0,0,0,,Екі адам бірге
Dialogue: 0,0:22:46.09,0:22:49.10,Default,,0,0,0,,Сіз жаттығу жасайсыз ба?
Dialogue: 0,0:22:49.10,0:22:52.10,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:22:49.10,0:22:52.10,Default,,0,0,0,,Бірдей дерлік
Dialogue: 0,0:22:52.10,0:22:55.10,Default,,0,0,0,,Ха... Мм... Мм!
Dialogue: 0,0:22:55.10,0:22:57.11,Default,,0,0,0,,Мен де сізге қосылғым келеді.
Dialogue: 0,0:22:55.10,0:22:57.11,Default,,0,0,0,,Вакю!
Dialogue: 0,0:22:57.11,0:22:59.07,Default,,0,0,0,,Жапонияға оралғаннан кейін ол агенттік ашты—
Dialogue: 0,0:23:00.11,0:23:04.08,Default,,0,0,0,,Хехе, әрине!
Dialogue: 0,0:23:07.12,0:23:10.12,Default,,0,0,0,,Акари-сан, осы шығар➡
Dialogue: 0,0:23:10.12,0:23:13.12,Default,,0,0,0,,Кейт Сит берген «Ғажайып».
Dialogue: 0,0:23:10.12,0:23:13.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:13.12,0:23:15.12,Default,,0,0,0,,Иә, дұрыс, мен сенімдімін
Dialogue: 0,0:23:15.12,0:23:17.13,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:23:17.13,0:23:20.13,Default,,0,0,0,,Фуфуккат теңізі каа
Dialogue: 0,0:23:20.13,0:23:24.13,Default,,0,0,0,,Қазірдің өзінде, бір жерде
Dialogue: 0,0:23:20.13,0:23:24.13,Default,,0,0,0,,Сіз мені бақылап отырсыз, солай емес пе?
Dialogue: 0,0:23:24.13,0:23:27.14,Default,,0,0,0,,Ааа, енді ойлап қарасам, Акари-сан➡
Dialogue: 0,0:23:27.14,0:23:30.11,Default,,0,0,0,,Кэйт Ситте бар
Dialogue: 0,0:23:27.14,0:23:30.11,Default,,0,0,0,,Қайта кездесе алдыңыз ба?
Dialogue: 0,0:23:35.14,0:23:39.11,Default,,0,0,0,,Бұл мен үшін соңғы рет болды
Dialogue: 0,0:23:43.08,0:23:47.09,Default,,0,0,0,,(Айка)
Dialogue: 0,0:23:43.08,0:23:47.09,Default,,0,0,0,,｟Мм Кэйт Си Эй｠
Dialogue: 0,0:23:47.09,0:23:50.09,Default,,0,0,0,,｟Иә, соңғы кезде мүлдем жоқ
Dialogue: 0,0:23:47.09,0:23:50.09,Default,,0,0,0,,Мен сені көре алмаймын.
Dialogue: 0,0:23:50.09,0:23:52.09,Default,,0,0,0,,｟Қандай ұят?
Dialogue: 0,0:23:52.09,0:23:57.10,Default,,0,0,0,,｟Мм, мүмкін
Dialogue: 0,0:23:52.09,0:23:57.10,Default,,0,0,0,,Меніңше, біз енді кездесе алмаймыз ба? ｠
Dialogue: 0,0:23:57.10,0:24:00.10,Default,,0,0,0,,｟Иә…｠
Dialogue: 0,0:23:57.10,0:24:00.10,Default,,0,0,0,,｟Пуикю｠
Dialogue: 0,0:24:00.10,0:24:03.10,Default,,0,0,0,,｟Біз
Dialogue: 0,0:24:00.10,0:24:03.10,Default,,0,0,0,,Мен прима болғым келеді.
Dialogue: 0,0:24:03.10,0:24:06.11,Default,,0,0,0,,｟Бұл қатты
Dialogue: 0,0:24:03.10,0:24:06.11,Default,,0,0,0,,Бұл ересек болуды білдіреді, солай ма? ｠
Dialogue: 0,0:24:06.11,0:24:10.11,Default,,0,0,0,,｟Сондықтан ол тек балаларға арналған
Dialogue: 0,0:24:06.11,0:24:10.11,Default,,0,0,0,,Көрінбейтін әлемнен➡
Dialogue: 0,0:24:10.11,0:24:13.08,Default,,0,0,0,,Түлек
Dialogue: 0,0:24:10.11,0:24:13.08,Default,,0,0,0,,деген осы емес пе? ｠
Dialogue: 0,0:24:16.12,0:24:20.12,Default,,0,0,0,,｟ Соңында одан да көп➡
Dialogue: 0,0:24:20.12,0:24:23.09,Default,,0,0,0,,Бір көргеннен болса да сенімен танысқым келеді.
Dialogue: 0,0:24:28.13,0:24:30.13,Default,,0,0,0,,｟Пуина Пуи｠
Dialogue: 0,0:24:30.13,0:24:33.13,Default,,0,0,0,,｟А, мүмкін...｠
Dialogue: 0,0:24:33.13,0:24:36.10,Default,,0,0,0,,Кімге ｟? ｠
Dialogue: 0,0:24:33.13,0:24:36.10,Default,,0,0,0,,Иә? ｠
Dialogue: 0,0:24:39.14,0:24:42.11,Default,,0,0,0,,｟Кетеміз бе?｠
Dialogue: 0,0:24:46.08,0:24:48.08,Default,,0,0,0,,｟Міне, мына жерде｠
Dialogue: 0,0:24:48.08,0:24:51.09,Default,,0,0,0,,｟Нео-Венеция
Dialogue: 0,0:24:48.08,0:24:51.09,Default,,0,0,0,,Жеті кереметтің бірі➡
Dialogue: 0,0:24:51.09,0:24:54.09,Default,,0,0,0,,Бақытсыздық тасы｠
Dialogue: 0,0:24:51.09,0:24:54.09,Default,,0,0,0,,｟Бақыттың тасы? ｠
Dialogue: 0,0:24:54.09,0:24:56.09,Default,,0,0,0,,｟А, мен білемін｠
Dialogue: 0,0:24:56.09,0:25:00.10,Default,,0,0,0,,｟Ол Манхом тасы
Dialogue: 0,0:24:56.09,0:25:00.10,Default,,0,0,0,,Венециядағы анекдотты қайталау➡
Dialogue: 0,0:25:00.10,0:25:02.10,Default,,0,0,0,,Бұл өте әйгілі тас.
Dialogue: 0,0:25:02.10,0:25:05.10,Default,,0,0,0,,｟Бәріне
Dialogue: 0,0:25:02.10,0:25:05.10,Default,,0,0,0,,Сіз қашып, жүресіз.
Dialogue: 0,0:25:05.10,0:25:09.10,Default,,0,0,0,,｟Иә Егер сіз оны бассаңыз
Dialogue: 0,0:25:05.10,0:25:09.10,Default,,0,0,0,,Жаман нәрселер орын алады｠
Dialogue: 0,0:25:09.10,0:25:11.11,Default,,0,0,0,,｟Не жаман? ｠
Dialogue: 0,0:25:09.10,0:25:11.11,Default,,0,0,0,,｟Келіңіз...｠
Dialogue: 0,0:25:11.11,0:25:13.11,Default,,0,0,0,,｟Бәрібір, бұл жақсы нәрсе емес｠
Dialogue: 0,0:25:13.11,0:25:17.11,Default,,0,0,0,,｟Қандай қорқынышты тас.｠
Dialogue: 0,0:25:13.11,0:25:17.11,Default,,0,0,0,,｟Мінекей! ｠
Dialogue: 0,0:25:17.11,0:25:19.11,Default,,0,0,0,,｟ Сәлем!
Dialogue: 0,0:25:17.11,0:25:19.11,Default,,0,0,0,,Кіші! ? ｠
Dialogue: 0,0:25:19.11,0:25:22.12,Default,,0,0,0,,｟Айя! ｠
Dialogue: 0,0:25:19.11,0:25:22.12,Default,,0,0,0,,｟Ха! ｠
Dialogue: 0,0:25:22.12,0:25:25.12,Default,,0,0,0,,｟Бақыт тасына...｠
Dialogue: 0,0:25:22.12,0:25:25.12,Default,,0,0,0,,｟Мен міндім｠
Dialogue: 0,0:25:25.12,0:25:28.12,Default,,0,0,0,,｟Сіз не істейсіз?
Dialogue: 0,0:25:25.12,0:25:28.12,Default,,0,0,0,,Мына кішкентай қыз! ｠
Dialogue: 0,0:25:28.12,0:25:30.13,Default,,0,0,0,,｟Күтілгендей, ештеңе болмайды｠
Dialogue: 0,0:25:30.13,0:25:33.13,Default,,0,0,0,,｟Мүмкін
Dialogue: 0,0:25:30.13,0:25:33.13,Default,,0,0,0,,Мен солай ойладым｠
Dialogue: 0,0:25:33.13,0:25:35.13,Default,,0,0,0,,｟Иә? ｠
Dialogue: 0,0:25:33.13,0:25:35.13,Default,,0,0,0,,｟Жарайды｠
Dialogue: 0,0:25:35.13,0:25:37.13,Default,,0,0,0,,｟Мен оны бала кезімде талай рет басқанмын➡
Dialogue: 0,0:25:37.13,0:25:39.13,Default,,0,0,0,,Ерекше ештеңе болған жоқ｠
Dialogue: 0,0:25:39.13,0:25:42.07,Default,,0,0,0,,｟Дұрыс, мені қорқытпа｠
Dialogue: 0,0:25:42.07,0:25:45.07,Default,,0,0,0,,｟Бірақ сіз Акари-сенпаймен бірге болсаңыз
Dialogue: 0,0:25:42.07,0:25:45.07,Default,,0,0,0,,Мен бұл мүмкін деп ойладым｠
Dialogue: 0,0:25:45.07,0:25:47.08,Default,,0,0,0,,｟Қорқынышты эксперименттерге тыйым салынады! ｠
Dialogue: 0,0:25:47.08,0:25:49.08,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:25:49.08,0:25:52.08,Default,,0,0,0,,Иә? ｠
Dialogue: 0,0:25:49.08,0:25:52.08,Default,,0,0,0,,｟Ааа, осынша уақыт болды｠
Dialogue: 0,0:25:52.08,0:25:56.08,Default,,0,0,0,,｟Айка-чан бүгін
Dialogue: 0,0:25:52.08,0:25:56.08,Default,,0,0,0,,Жасөспірімдерге нұсқау беріңіз｠
Dialogue: 0,0:25:56.08,0:26:00.09,Default,,0,0,0,,｟Na… Мен ұмытып қалдым.
Dialogue: 0,0:25:56.08,0:26:00.09,Default,,0,0,0,,｠Мен мектепке баруым керек｠
Dialogue: 0,0:26:00.09,0:26:02.09,Default,,0,0,0,,｟Кездескенше｠
Dialogue: 0,0:26:00.09,0:26:02.09,Default,,0,0,0,,｟Мен келемін｠
Dialogue: 0,0:26:02.09,0:26:05.06,Default,,0,0,0,,｟Келіңіз және бар күшіңізді салыңыз｠
Dialogue: 0,0:26:07.10,0:26:11.10,Default,,0,0,0,,｟Ал, мен де.
Dialogue: 0,0:26:07.10,0:26:11.10,Default,,0,0,0,,Мен жұмысқа оралуым керек｠
Dialogue: 0,0:26:11.10,0:26:13.07,Default,,0,0,0,,｟Пуйпуикю｠
Dialogue: 0,0:26:16.10,0:26:18.11,Default,,0,0,0,,｟Нео-Венеция
Dialogue: 0,0:26:16.10,0:26:18.11,Default,,0,0,0,,Жеті кереметтің бірі➡
Dialogue: 0,0:26:18.11,0:26:21.11,Default,,0,0,0,,Бақытсыздықтың тасы?
Dialogue: 0,0:26:21.11,0:26:23.11,Default,,0,0,0,,｟Пуи｠
Dialogue: 0,0:26:23.11,0:26:35.12,Default,,0,0,0,,♬～
Dialogue: 0,0:26:35.12,0:26:37.13,Default,,0,0,0,,｟Жүрейік｠
Dialogue: 0,0:26:37.13,0:26:39.13,Default,,0,0,0,,｟Пуи｠
Dialogue: 0,0:26:37.13,0:26:39.13,Default,,0,0,0,,｟Мүмкін➡
Dialogue: 0,0:26:39.13,0:26:42.06,Default,,0,0,0,,Сіз Кейт Ситпен кездесе аласыз｠
Dialogue: 0,0:26:42.06,0:26:44.07,Default,,0,0,0,,｟Пуина Пуи｠
Dialogue: 0,0:26:44.07,0:26:57.08,Default,,0,0,0,,♬～
Dialogue: 0,0:26:57.08,0:26:59.05,Default,,0,0,0,,｟Жарайды! ｠
Dialogue: 0,0:27:01.08,0:27:03.08,Default,,0,0,0,,｟Eit｠
Dialogue: 0,0:27:01.08,0:27:03.08,Default,,0,0,0,,｟Пуи｠
Dialogue: 0,0:27:03.08,0:27:15.10,Default,,0,0,0,,♬～
Dialogue: 0,0:27:15.10,0:27:17.07,Default,,0,0,0,,｟мм…｠
Dialogue: 0,0:27:23.10,0:27:26.11,Default,,0,0,0,,｟Ештеңе болмайды｠
Dialogue: 0,0:27:26.11,0:27:29.08,Default,,0,0,0,,｜Президент Ария｠
Dialogue: 0,0:27:26.11,0:27:29.08,Default,,0,0,0,,｟Pui Жаңа｠
Dialogue: 0,0:27:31.11,0:27:35.12,Default,,0,0,0,,｟Кейт Ситта қазірдің өзінде бар
Dialogue: 0,0:27:31.11,0:27:35.12,Default,,0,0,0,,Мен сенімен кездесе алмаймын ба?
Dialogue: 0,0:27:35.12,0:27:37.09,Default,,0,0,0,,｟Пуи｠
Dialogue: 0,0:27:40.12,0:27:43.09,Default,,0,0,0,,｟Мен өзімді аздап жалғыз сезінемін｠
Dialogue: 0,0:27:48.06,0:27:51.03,Default,,0,0,0,,｟Күшік? Пуикю｠
Dialogue: 0,0:27:53.07,0:27:55.07,Default,,0,0,0,,｟Пуину Пуи｠
Dialogue: 0,0:27:55.07,0:27:57.04,Default,,0,0,0,,｟Ах! ｠
Dialogue: 0,0:28:00.08,0:28:03.08,Default,,0,0,0,,｟Хохе…｠
Dialogue: 0,0:28:03.08,0:28:05.08,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:28:05.08,0:28:14.09,Default,,0,0,0,,♬～
Dialogue: 0,0:28:14.09,0:28:16.06,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:28:21.10,0:28:25.10,Default,,0,0,0,,｟Мен сені кездестіргеніме қуаныштымын｠
Dialogue: 0,0:28:25.10,0:28:28.10,Default,,0,0,0,,｟Мәңгі сен
Dialogue: 0,0:28:25.10,0:28:28.10,Default,,0,0,0,,Мен оны іздедім｠
Dialogue: 0,0:28:28.10,0:28:30.11,Default,,0,0,0,,｟Осылайша
Dialogue: 0,0:28:28.10,0:28:30.11,Default,,0,0,0,,Қайта кездесеміз деп үміттенемін➡
Dialogue: 0,0:28:30.11,0:28:33.07,Default,,0,0,0,,Мен шынымен бақыттымын｠
Dialogue: 0,0:28:40.12,0:28:44.05,Default,,0,0,0,,｜Мен сені келесі жолы көруге келемін.｠
Dialogue: 0,0:28:44.05,0:28:46.05,Default,,0,0,0,,｟Мен қайда баруым керек?
Dialogue: 0,0:28:44.05,0:28:46.05,Default,,0,0,0,,Сізбен кездесе аламын ба? ｠
Dialogue: 0,0:28:46.05,0:28:50.02,Default,,0,0,0,,｟Тағы да сол тас
Dialogue: 0,0:28:46.05,0:28:50.02,Default,,0,0,0,,Бассам жарай ма? ｠
Dialogue: 0,0:28:55.06,0:29:01.07,Default,,0,0,0,,｟Біз тағы кездесе алмаймыз ба?
Dialogue: 0,0:28:55.06,0:29:01.07,Default,,0,0,0,,Енді ешқашан емес пе? ｠
Dialogue: 0,0:29:01.07,0:29:05.07,Default,,0,0,0,,｟Маған бұл ұнамайды｠
Dialogue: 0,0:29:05.07,0:29:07.08,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:29:07.08,0:29:17.09,Default,,0,0,0,,♬～
Dialogue: 0,0:29:17.09,0:29:19.09,Default,,0,0,0,,｟Әрқашан осындасыз ба? ｠
Dialogue: 0,0:29:19.09,0:29:30.10,Default,,0,0,0,,♬～
Dialogue: 0,0:29:30.10,0:29:32.07,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:29:34.10,0:29:36.07,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:29:42.11,0:29:45.11,Default,,0,0,0,,｟Мен ұмытпаймын｠
Dialogue: 0,0:29:45.11,0:29:49.08,Default,,0,0,0,,｟Сіз туралы
Dialogue: 0,0:29:45.11,0:29:49.08,Default,,0,0,0,,Мен ешқашан ұмытпаймын｠
Dialogue: 0,0:29:57.13,0:30:03.13,Default,,0,0,0,,｟Сондықтан мен мұнда мәңгі болдым
Dialogue: 0,0:29:57.13,0:30:03.13,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:30:03.13,0:30:23.15,Default,,0,0,0,,♬～
Dialogue: 0,0:30:23.15,0:30:28.16,Default,,0,0,0,,♬～
Dialogue: 0,0:30:28.16,0:30:30.12,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:30:45.11,0:30:48.11,Default,,0,0,0,,｟Президент Ария｠
Dialogue: 0,0:30:45.11,0:30:48.11,Default,,0,0,0,,｟Puyture｠
Dialogue: 0,0:30:48.11,0:30:59.12,Default,,0,0,0,,♬～
Dialogue: 0,0:30:59.12,0:31:02.12,Default,,0,0,0,,｟Puyture｠
Dialogue: 0,0:31:02.12,0:31:11.13,Default,,0,0,0,,♬～
Dialogue: 0,0:31:11.13,0:31:14.14,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:31:11.13,0:31:14.14,Default,,0,0,0,,Иә
Dialogue: 0,0:31:14.14,0:31:19.14,Default,,0,0,0,,Мұның бәрі жарық
Dialogue: 0,0:31:14.14,0:31:19.14,Default,,0,0,0,,Бұл «Миракуру» болуы мүмкін
Dialogue: 0,0:31:19.14,0:31:23.11,Default,,0,0,0,,Сондықтан да ұшқын
Dialogue: 0,0:31:19.14,0:31:23.11,Default,,0,0,0,,Менің ойымша, сіз мұны істеп жатырсыз.
Dialogue: 0,0:31:25.15,0:31:28.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:31:28.15,0:31:31.15,Default,,0,0,0,,P…
Dialogue: 0,0:31:31.15,0:31:33.15,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:31:31.15,0:31:33.15,Default,,0,0,0,,Сондай-ақ мен бүгін алған «Миракуру»➡
Dialogue: 0,0:31:33.15,0:31:36.16,Default,,0,0,0,,Бұл жарқыраған кездесу.
Dialogue: 0,0:31:33.15,0:31:36.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:31:36.16,0:31:41.10,Default,,0,0,0,,Үшеуміз көп жаттығу жасадық.
Dialogue: 0,0:31:36.16,0:31:41.10,Default,,0,0,0,,Прима Ундин болуды мақсат ету
Dialogue: 0,0:31:41.10,0:31:47.07,Default,,0,0,0,,Бірақ бір күні мен де болады
Dialogue: 0,0:31:41.10,0:31:47.07,Default,,0,0,0,,Мен Кейт Ситпен кездескім келеді.
Dialogue: 0,0:31:48.10,0:31:53.11,Default,,0,0,0,,<Егер кездессек
Dialogue: 0,0:31:48.10,0:31:53.11,Default,,0,0,0,,Қоштасатын уақыт міндетті түрде келеді>
Dialogue: 0,0:31:53.11,0:31:56.11,Default,,0,0,0,,＜Бірақ сол күні қоштасуымыз керек еді.
Dialogue: 0,0:31:53.11,0:31:56.11,Default,,0,0,0,,Ситке ➡
Dialogue: 0,0:31:56.11,0:32:01.12,Default,,0,0,0,,Ай Чанға рахмет
Dialogue: 0,0:31:56.11,0:32:01.12,Default,,0,0,0,,Мен тағы кездескендей болдым>
Dialogue: 0,0:32:01.12,0:32:04.12,Default,,0,0,0,,<Мүмкін
Dialogue: 0,0:32:01.12,0:32:04.12,Default,,0,0,0,,Махаббат сезімі➡
Dialogue: 0,0:32:04.12,0:32:08.09,Default,,0,0,0,,Ғажайып
Dialogue: 0,0:32:04.12,0:32:08.09,Default,,0,0,0,,Мүмкін мен сізге телефон соғармын>
Dialogue: 0,0:32:25.14,0:32:28.11,Default,,0,0,0,,Э? Хмм…
Dialogue: 0,0:32:31.15,0:32:33.15,Default,,0,0,0,,Есікті бастайық
Dialogue: 0,0:32:33.15,0:32:35.15,Default,,0,0,0,,Пуйчер
Dialogue: 0,0:32:35.15,0:32:38.15,Default,,0,0,0,,О, Президент Ария.
Dialogue: 0,0:32:35.15,0:32:38.15,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:32:38.15,0:32:41.09,Default,,0,0,0,,Пуи Пуи Пуи
Dialogue: 0,0:32:41.09,0:33:01.11,Default,,0,0,0,,♬～
Dialogue: 0,0:33:01.11,0:33:21.13,Default,,0,0,0,,♬～
Dialogue: 0,0:33:21.13,0:33:41.08,Default,,0,0,0,,♬～
Dialogue: 0,0:33:41.08,0:34:01.10,Default,,0,0,0,,♬～
Dialogue: 0,0:34:01.10,0:34:21.12,Default,,0,0,0,,♬～
Dialogue: 0,0:34:21.12,0:34:26.13,Default,,0,0,0,,♬～
Dialogue: 0,0:34:26.13,0:34:29.13,Default,,0,0,0,,Гондола қауымдастығына жұмысқа сұраныс жіберіңіз➡
Dialogue: 0,0:34:29.13,0:34:32.13,Default,,0,0,0,,Көше плакаттарын да жасадым.
Dialogue: 0,0:34:29.13,0:34:32.13,Default,,0,0,0,,Пуи Пуи
Dialogue: 0,0:34:32.13,0:34:36.10,Default,,0,0,0,,Әрине
Dialogue: 0,0:34:32.13,0:34:36.10,Default,,0,0,0,,Әңгімелесу және тәжірибелік сынақ міндетті болып табылады
Dialogue: 0,0:34:42.08,0:34:46.08,Default,,0,0,0,,《Мен үшін ARIA компаниясы
Dialogue: 0,0:34:42.08,0:34:46.08,Default,,0,0,0,,Дұрыс баланы табыңыз➡
Dialogue: 0,0:34:46.08,0:34:50.08,Default,,0,0,0,,Мұқият және мұқият таңдаңыз
Dialogue: 0,0:34:46.08,0:34:50.08,Default,,0,0,0,,Жауапты》
Dialogue: 0,0:34:50.08,0:34:52.05,Default,,0,0,0,,📺 (Қабылданған дыбыс)
Dialogue: 0,0:34:54.09,0:34:57.09,Default,,0,0,0,,📺 (электрондық дыбыс)
Dialogue: 0,0:34:54.09,0:34:57.09,Default,,0,0,0,,Компанияға қосылуды сұрайтын электрондық пошта?
Dialogue: 0,0:34:57.09,0:35:00.09,Default,,0,0,0,,Пуи
Dialogue: 0,0:34:57.09,0:35:00.09,Default,,0,0,0,,Бұл №1 өтініш беруші.
Dialogue: 0,0:35:00.09,0:35:03.10,Default,,0,0,0,,Президент Ария
Dialogue: 0,0:35:00.09,0:35:03.10,Default,,0,0,0,,Кезек
Dialogue: 0,0:35:03.10,0:35:06.10,Default,,0,0,0,,Иә? Manhom-дан?
Dialogue: 0,0:35:06.10,0:35:10.10,Default,,0,0,0,,Қазір дүкеннің алдында жұмыс туралы хабарландыру
Dialogue: 0,0:35:06.10,0:35:10.10,Default,,0,0,0,,Жаңа ғана шықты, солай ма?
Dialogue: 0,0:35:10.10,0:35:12.11,Default,,0,0,0,,Пуикюу
Dialogue: 0,0:35:12.11,0:35:17.11,Default,,0,0,0,,Біз әлі ешқандай жалдау туралы басты бетке жариялаған жоқпыз.
Dialogue: 0,0:35:12.11,0:35:17.11,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:35:17.11,0:35:19.11,Default,,0,0,0,,☎Е, а, а...
Dialogue: 0,0:35:19.11,0:35:22.12,Default,,0,0,0,,☎Мен болсам, өзімнен озып жүгірер едім.
Dialogue: 0,0:35:19.11,0:35:22.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:35:22.12,0:35:25.12,Default,,0,0,0,,Неліктен бізге қосылғыңыз келеді?
Dialogue: 0,0:35:25.12,0:35:30.12,Default,,0,0,0,,☎Мен мәңгілік
Dialogue: 0,0:35:25.12,0:35:30.12,Default,,0,0,0,,Мен Ундинге тәнті болдым.
Dialogue: 0,0:35:30.12,0:35:33.13,Default,,0,0,0,,☎Сонымен интернетте
Dialogue: 0,0:35:30.12,0:35:33.13,Default,,0,0,0,,ARIA компаниясының суреттері➡
Dialogue: 0,0:35:33.13,0:35:36.13,Default,,0,0,0,,Мен оны кездейсоқ тауып алған кезде...
Dialogue: 0,0:35:36.13,0:35:40.10,Default,,0,0,0,,☎Әйтеуір мені шақырғандай болды.
Dialogue: 0,0:35:36.13,0:35:40.10,Default,,0,0,0,,Мен өзімді сезіндім
Dialogue: 0,0:35:41.07,0:35:44.07,Default,,0,0,0,,《Мұқият білу үшін
Dialogue: 0,0:35:41.07,0:35:44.07,Default,,0,0,0,,Мен айттым➡
Dialogue: 0,0:35:44.07,0:35:48.08,Default,,0,0,0,,Тіпті өзім де
Dialogue: 0,0:35:44.07,0:35:48.08,Default,,0,0,0,,Мен бұл қайшылық екенін білемін.
Dialogue: 0,0:35:48.08,0:35:52.05,Default,,0,0,0,,《Бірақ неге?》
Dialogue: 0,0:35:55.08,0:35:59.05,Default,,0,0,0,,Nnnnnnn…
Dialogue: 0,0:36:00.09,0:36:02.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:02.09,0:36:08.06,Default,,0,0,0,,《Ол кезде тіпті мына бала
Dialogue: 0,0:36:02.09,0:36:08.06,Default,,0,0,0,,Мен таң қалдым.》
Dialogue: 0,0:36:09.10,0:36:11.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:31.12,0:36:35.12,Default,,0,0,0,,Өйткені, бұл декорация ерекше.
Dialogue: 0,0:36:35.12,0:36:38.13,Default,,0,0,0,,Бұл екеуі әрқашан сонда болады➡
Dialogue: 0,0:36:38.13,0:36:41.06,Default,,0,0,0,,Айка мен Алисаға
Dialogue: 0,0:36:38.13,0:36:41.06,Default,,0,0,0,,Сізге таң қалдыңыз ба?
Dialogue: 0,0:36:41.06,0:36:43.06,Default,,0,0,0,,Иә? Жоқ, әсіресе
Dialogue: 0,0:36:41.06,0:36:43.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:43.06,0:36:48.07,Default,,0,0,0,,Бір нәрсе болса, филиал басшысы
Dialogue: 0,0:36:43.06,0:36:48.07,Default,,0,0,0,,Сен маған ғашықсың деп ойлаймын.
Dialogue: 0,0:36:48.07,0:36:51.07,Default,,0,0,0,,Қызғылт сары планета
Dialogue: 0,0:36:48.07,0:36:51.07,Default,,0,0,0,,Өйткені бұл компания белгілейтін әдет.
Dialogue: 0,0:36:51.07,0:36:53.07,Default,,0,0,0,,Иә
Dialogue: 0,0:36:53.07,0:36:56.08,Default,,0,0,0,,Сіз өзіңіз таңдай алмайсыз
Dialogue: 0,0:36:56.08,0:37:00.08,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:36:56.08,0:37:00.08,Default,,0,0,0,,Үлкенге еру маңызды мәселе емес пе?
Dialogue: 0,0:37:00.08,0:37:04.09,Default,,0,0,0,,Талантың болса да
Dialogue: 0,0:37:00.08,0:37:04.09,Default,,0,0,0,,Үлкендерім танымай қалды➡
Dialogue: 0,0:37:04.09,0:37:06.09,Default,,0,0,0,,Кейбір балалар жұмысын тоқтатады.
Dialogue: 0,0:37:06.09,0:37:09.09,Default,,0,0,0,,О, солай…
Dialogue: 0,0:37:09.09,0:37:12.09,Default,,0,0,0,,Яғни, біз
Dialogue: 0,0:37:09.09,0:37:12.09,Default,,0,0,0,,Сәтіңізді құр жібермеу үшін➡
Dialogue: 0,0:37:12.09,0:37:14.10,Default,,0,0,0,,Бар күшіңізді салу керек
Dialogue: 0,0:37:14.10,0:37:17.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:37:14.10,0:37:17.10,Default,,0,0,0,,Осы кездесуге ризашылықпен
Dialogue: 0,0:37:17.10,0:37:20.10,Default,,0,0,0,,Иә, міндетті түрде үш адаммен.
Dialogue: 0,0:37:17.10,0:37:20.10,Default,,0,0,0,,Prima undine болыңыз
Dialogue: 0,0:37:20.10,0:37:22.10,Default,,0,0,0,,Жаңа!
Dialogue: 0,0:37:20.10,0:37:22.10,Default,,0,0,0,,(суға құлау дыбысы)
Dialogue: 0,0:37:22.10,0:37:24.11,Default,,0,0,0,,Мияу пучочо пучочо…
Dialogue: 0,0:37:24.11,0:37:26.11,Default,,0,0,0,,Президент Ария!
Dialogue: 0,0:37:26.11,0:37:28.11,Default,,0,0,0,,Осыны ұстаныңыз
Dialogue: 0,0:37:28.11,0:37:31.11,Default,,0,0,0,,Уа... уах вах...!
Dialogue: 0,0:37:31.11,0:37:33.11,Default,,0,0,0,,Фу…
Dialogue: 0,0:37:33.11,0:37:36.08,Default,,0,0,0,,Годоланың жанынан өту
Dialogue: 0,0:37:42.06,0:37:46.06,Default,,0,0,0,,Менің әлі алда көп жолым бар
Dialogue: 0,0:37:42.06,0:37:46.06,Default,,0,0,0,,Мен білмейтін нәрселер өте көп
Dialogue: 0,0:37:46.06,0:37:48.06,Default,,0,0,0,,Мен де солаймын.
Dialogue: 0,0:37:48.06,0:37:51.07,Default,,0,0,0,,Өйткені қала өзгеруде.
Dialogue: 0,0:37:51.07,0:37:53.07,Default,,0,0,0,,Prima Undine
Dialogue: 0,0:37:51.07,0:37:53.07,Default,,0,0,0,,Менімен бірге жүрсең➡
Dialogue: 0,0:37:53.07,0:37:56.07,Default,,0,0,0,,Тұтынушылар бойдақ болса да
Dialogue: 0,0:37:53.07,0:37:56.07,Default,,0,0,0,,Сондай-ақ, мінуге қабілетті болу жүйесі бар➡
Dialogue: 0,0:37:56.07,0:38:00.07,Default,,0,0,0,,Ол бұрын болмаған.
Dialogue: 0,0:37:56.07,0:38:00.07,Default,,0,0,0,,Ә? Шынында ма?
Dialogue: 0,0:38:00.07,0:38:05.08,Default,,0,0,0,,Жасөспірімдерді дамыту
Dialogue: 0,0:38:00.07,0:38:05.08,Default,,0,0,0,,Бұл туралы біреу айта бастайды, содан кейін ол тарайды.
Dialogue: 0,0:38:05.08,0:38:09.08,Default,,0,0,0,,Дәл осылай, бірте-бірте
Dialogue: 0,0:38:05.08,0:38:09.08,Default,,0,0,0,,Заттар өзгерді, солай емес пе?
Dialogue: 0,0:38:09.08,0:38:11.09,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:38:11.09,0:38:14.09,Default,,0,0,0,,Мен атын да білмеймін
Dialogue: 0,0:38:11.09,0:38:14.09,Default,,0,0,0,,Көп адамның ойы➡
Dialogue: 0,0:38:14.09,0:38:20.09,Default,,0,0,0,,Қаланың ойына айнал
Dialogue: 0,0:38:14.09,0:38:20.09,Default,,0,0,0,,Сіз бізді қолдап жатырсыз, солай емес пе?
Dialogue: 0,0:38:20.09,0:38:22.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:38:20.09,0:38:22.10,Default,,0,0,0,,Няня Бұл...
Dialogue: 0,0:38:22.10,0:38:25.10,Default,,0,0,0,,Ұятты өсек...
Dialogue: 0,0:38:22.10,0:38:25.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:25.10,0:38:29.10,Default,,0,0,0,,Хахаха, жарайды, жарайды.
Dialogue: 0,0:38:25.10,0:38:29.10,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:38:29.10,0:38:39.11,Default,,0,0,0,,♬～
Dialogue: 0,0:38:39.11,0:38:44.05,Default,,0,0,0,,Кенет бұлтты болды.
Dialogue: 0,0:38:39.11,0:38:44.05,Default,,0,0,0,,Бұл маусымда мен ештеңе істей алмаймын.
Dialogue: 0,0:38:44.05,0:38:47.05,Default,,0,0,0,,Aqua Alta жақында келеді
Dialogue: 0,0:38:44.05,0:38:47.05,Default,,0,0,0,,Келіп жатқан жоқ па?
Dialogue: 0,0:38:47.05,0:38:49.06,Default,,0,0,0,,Aqua Alta?
Dialogue: 0,0:38:49.06,0:38:53.06,Default,,0,0,0,,Гондола жолы
Dialogue: 0,0:38:49.06,0:38:53.06,Default,,0,0,0,,Ах
Dialogue: 0,0:38:53.06,0:39:02.07,Default,,0,0,0,,♬～
Dialogue: 0,0:39:02.07,0:39:06.07,Default,,0,0,0,,Сол күлкі мен ән салған дауыс
Dialogue: 0,0:39:02.07,0:39:06.07,Default,,0,0,0,,Барлығы сауығып кетті, солай ма?
Dialogue: 0,0:39:06.07,0:39:08.08,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:39:06.07,0:39:08.08,Default,,0,0,0,,Мен аш емеспін. Хүү…
Dialogue: 0,0:39:08.08,0:39:11.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:08.08,0:39:11.08,Default,,0,0,0,,Алдағы музыка фестивалінде➡
Dialogue: 0,0:39:11.08,0:39:16.08,Default,,0,0,0,,Афинаның ерекше қойылымы
Dialogue: 0,0:39:11.08,0:39:16.08,Default,,0,0,0,,Оны Алиса-сенпай да асыға күтті.
Dialogue: 0,0:39:16.08,0:39:20.09,Default,,0,0,0,,Мен сіз сұраған жұмыстан кенет бас тарта алмаймын.
Dialogue: 0,0:39:16.08,0:39:20.09,Default,,0,0,0,,Ол кірді.
Dialogue: 0,0:39:20.09,0:39:24.09,Default,,0,0,0,,Е! Жарайды, біз де
Dialogue: 0,0:39:20.09,0:39:24.09,Default,,0,0,0,,Ол күн үшін уайымдамаңыз➡
Dialogue: 0,0:39:24.09,0:39:27.09,Default,,0,0,0,,Филиал менеджері де
Dialogue: 0,0:39:24.09,0:39:27.09,Default,,0,0,0,,Бұл бәрі емес...
Dialogue: 0,0:39:27.09,0:39:29.10,Default,,0,0,0,,Бізде де толық брондалған.
Dialogue: 0,0:39:29.10,0:39:33.10,Default,,0,0,0,,Мұның бәрі
Dialogue: 0,0:39:29.10,0:39:33.10,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:39:33.10,0:39:35.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:33.10,0:39:35.10,Default,,0,0,0,,Пуи?
Dialogue: 0,0:39:35.10,0:39:37.10,Default,,0,0,0,,Рука, сен күнде қылыш айналдыру жаттығуын жасап жүрсің ғой?
Dialogue: 0,0:39:37.10,0:39:40.11,Default,,0,0,0,,Біз «Миракуру» жасаймыз!
Dialogue: 0,0:39:40.11,0:39:44.11,Default,,0,0,0,,«Миракуру» жаса?
Dialogue: 0,0:39:40.11,0:39:44.11,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:39:44.11,0:39:46.11,Default,,0,0,0,,Aqua Alta!
Dialogue: 0,0:39:44.11,0:39:46.11,Default,,0,0,0,,Aqua Alta➡
Dialogue: 0,0:39:46.11,0:39:48.12,Default,,0,0,0,,«Миракуру» әкелу!
Dialogue: 0,0:39:48.12,0:39:53.12,Default,,0,0,0,,Жақсы нәрсе
Dialogue: 0,0:39:48.12,0:39:53.12,Default,,0,0,0,,Іске қосылған сияқты.
Dialogue: 0,0:39:53.12,0:39:56.09,Default,,0,0,0,,Жүру?
Dialogue: 0,0:39:53.12,0:39:56.09,Default,,0,0,0,,Бұл бұта емес
Dialogue: 0,0:40:12.14,0:40:18.15,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:40:18.15,0:40:20.11,Default,,0,0,0,,Ha
Dialogue: 0,0:40:23.15,0:40:26.15,Default,,0,0,0,,Ах! Бұл келді! Бұл келді!
Dialogue: 0,0:40:26.15,0:40:29.16,Default,,0,0,0,,Бұл Aqua Alta.
Dialogue: 0,0:40:26.15,0:40:29.16,Default,,0,0,0,,Президент Ария!
Dialogue: 0,0:40:29.16,0:40:33.16,Default,,0,0,0,,Өйткені, Aqua
Dialogue: 0,0:40:29.16,0:40:33.16,Default,,0,0,0,,Ол «миракуруға» толы!
Dialogue: 0,0:40:33.16,0:40:36.16,Default,,0,0,0,,Енді операцияны бастайық О!
Dialogue: 0,0:40:33.16,0:40:36.16,Default,,0,0,0,,Пуинья
Dialogue: 0,0:40:36.16,0:40:39.17,Default,,0,0,0,,⚟Қайырлы таң
Dialogue: 0,0:40:36.16,0:40:39.17,Default,,0,0,0,,Ах Акари-сан
Dialogue: 0,0:40:39.17,0:40:42.10,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:40:39.17,0:40:42.10,Default,,0,0,0,,Пуину Пуи
Dialogue: 0,0:40:42.10,0:40:44.10,Default,,0,0,0,,Бұл Aqua Alta.
Dialogue: 0,0:40:44.10,0:40:47.11,Default,,0,0,0,,Иә! Бүгінгі жұмысыңыз қандай?
Dialogue: 0,0:40:44.10,0:40:47.11,Default,,0,0,0,,Ол жойылады.
Dialogue: 0,0:40:47.11,0:40:51.11,Default,,0,0,0,,Иә, бүгінгі күн.
Dialogue: 0,0:40:47.11,0:40:51.11,Default,,0,0,0,,Сіз балконда демаласыз ба?
Dialogue: 0,0:40:51.11,0:40:53.11,Default,,0,0,0,,Бұл Музан мырза…
Dialogue: 0,0:40:51.11,0:40:53.11,Default,,0,0,0,,Иә~
Dialogue: 0,0:40:53.11,0:40:55.12,Default,,0,0,0,,Мен шығайын деп жатырмын.
Dialogue: 0,0:40:55.12,0:40:59.12,Default,,0,0,0,,Эй... онда
Dialogue: 0,0:40:55.12,0:40:59.12,Default,,0,0,0,,Түскі асқа бірге құймақ жасаймыз ба?
Dialogue: 0,0:40:59.12,0:41:01.12,Default,,0,0,0,,Пісіруге болмайды!
Dialogue: 0,0:40:59.12,0:41:01.12,Default,,0,0,0,,Иә~
Dialogue: 0,0:41:01.12,0:41:04.12,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:41:01.12,0:41:04.12,Default,,0,0,0,,Бүгінгі түскі ас бөлек болады.
Dialogue: 0,0:41:04.12,0:41:09.13,Default,,0,0,0,,Олай болса мен кешкі ас әзірлеймін.
Dialogue: 0,0:41:04.12,0:41:09.13,Default,,0,0,0,,Жоқ! өтінемін, жасамаңыз
Dialogue: 0,0:41:09.13,0:41:11.13,Default,,0,0,0,,Иә~
Dialogue: 0,0:41:11.13,0:41:13.13,Default,,0,0,0,,Мен сізге кешке хабарласамын.
Dialogue: 0,0:41:11.13,0:41:13.13,Default,,0,0,0,,Оған дейін, Акари-сан➡
Dialogue: 0,0:41:13.13,0:41:16.14,Default,,0,0,0,,Демалыңыз.
Dialogue: 0,0:41:13.13,0:41:16.14,Default,,0,0,0,,Пуинья
Dialogue: 0,0:41:16.14,0:41:18.11,Default,,0,0,0,,Иә...
Dialogue: 0,0:41:23.14,0:41:26.15,Default,,0,0,0,,әрбір адам
Dialogue: 0,0:41:23.14,0:41:26.15,Default,,0,0,0,,Мен сіздің тапсырманы орындауыңызды қалаймын!
Dialogue: 0,0:41:26.15,0:41:28.15,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:41:28.15,0:41:30.15,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:41:28.15,0:41:30.15,Default,,0,0,0,,Пуинья
Dialogue: 0,0:41:30.15,0:41:46.10,Default,,0,0,0,,♬～
Dialogue: 0,0:41:46.10,0:41:51.07,Default,,0,0,0,,Айка-чан да, Алиса-чан да
Dialogue: 0,0:41:46.10,0:41:51.07,Default,,0,0,0,,Бүгін кешке дейін жоспарларыңыз бар ма?
Dialogue: 0,0:41:52.11,0:41:55.08,Default,,0,0,0,,《Ай Чан да бос емес сияқты》
Dialogue: 0,0:41:56.11,0:42:01.12,Default,,0,0,0,,《Келесі жолы барлығына ыңғайлы кезде,
Dialogue: 0,0:41:56.11,0:42:01.12,Default,,0,0,0,,Менің сол ыстық бұлаққа барғым келеді》
Dialogue: 0,0:42:01.12,0:42:05.12,Default,,0,0,0,,《Теңізге шомылуға бола ма?
Dialogue: 0,0:42:01.12,0:42:05.12,Default,,0,0,0,,Сондай-ақ тәжірибе үшін》
Dialogue: 0,0:42:05.12,0:42:11.09,Default,,0,0,0,,《Мүмкіндігінше, Алисия
Dialogue: 0,0:42:05.12,0:42:11.09,Default,,0,0,0,,Әжем менімен бірге жүрсе екен.
Dialogue: 0,0:42:13.13,0:42:15.13,Default,,0,0,0,,《Орындалу қиын тілек➡
Dialogue: 0,0:42:15.13,0:42:18.13,Default,,0,0,0,,Кеудемде барған сайын
Dialogue: 0,0:42:15.13,0:42:18.13,Default,,0,0,0,,Ол жинала береді➡
Dialogue: 0,0:42:18.13,0:42:23.14,Default,,0,0,0,,Сонда да, бір күні бір күні
Dialogue: 0,0:42:18.13,0:42:23.14,Default,,0,0,0,,Ойымды тоқтата алмаймын
Dialogue: 0,0:42:23.14,0:42:26.14,Default,,0,0,0,,《Бұл біртүрлі》
Dialogue: 0,0:42:26.14,0:42:30.14,Default,,0,0,0,,📺 (Қабылданған дыбыс)
Dialogue: 0,0:42:26.14,0:42:30.14,Default,,0,0,0,,О, электрондық хат.
Dialogue: 0,0:42:30.14,0:42:34.15,Default,,0,0,0,,Бұл Ай Чанның денесі, иә?
Dialogue: 0,0:42:34.15,0:42:37.15,Default,,0,0,0,,📺 Акари-сан
Dialogue: 0,0:42:34.15,0:42:37.15,Default,,0,0,0,,Жақсы демалдыңыз ба?
Dialogue: 0,0:42:37.15,0:42:39.15,Default,,0,0,0,,📺Осыдан кейін сағат 5-те
Dialogue: 0,0:42:37.15,0:42:39.15,Default,,0,0,0,,Мұнда келіңіз
Dialogue: 0,0:42:39.15,0:42:42.09,Default,,0,0,0,,📺Мен күтемін.
Dialogue: 0,0:42:39.15,0:42:42.09,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:42:42.09,0:42:44.09,Default,,0,0,0,,Өлімдік күнәлардың кардиналының оң қолы.
Dialogue: 0,0:42:44.09,0:42:55.10,Default,,0,0,0,,♬～
Dialogue: 0,0:42:55.10,0:42:57.10,Default,,0,0,0,,Ах
Dialogue: 0,0:42:57.10,0:43:10.12,Default,,0,0,0,,♬～
Dialogue: 0,0:43:10.12,0:43:14.12,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:43:10.12,0:43:14.12,Default,,0,0,0,,Ах, Акари-сан, қош келдіңіз.
Dialogue: 0,0:43:14.12,0:43:16.12,Default,,0,0,0,,Пуй Чай
Dialogue: 0,0:43:14.12,0:43:16.12,Default,,0,0,0,,Мен сені күттім.
Dialogue: 0,0:43:16.12,0:43:18.13,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:43:18.13,0:43:21.13,Default,,0,0,0,,Партия?
Dialogue: 0,0:43:18.13,0:43:21.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:21.13,0:43:24.13,Default,,0,0,0,,Бүгін бір нәрсенің мерейтойы ма?
Dialogue: 0,0:43:24.13,0:43:26.13,Default,,0,0,0,,Жоқ, бұл жай ғана күн.
Dialogue: 0,0:43:26.13,0:43:30.14,Default,,0,0,0,,Кәдімгі күні кеш?
Dialogue: 0,0:43:26.13,0:43:30.14,Default,,0,0,0,,Керемет нәрсе!
Dialogue: 0,0:43:30.14,0:43:33.14,Default,,0,0,0,,Хехехе
Dialogue: 0,0:43:30.14,0:43:33.14,Default,,0,0,0,,Иә? Кіші?
Dialogue: 0,0:43:33.14,0:43:35.14,Default,,0,0,0,,Ах
Dialogue: 0,0:43:33.14,0:43:35.14,Default,,0,0,0,,Айка Сенпай
Dialogue: 0,0:43:35.14,0:43:37.14,Default,,0,0,0,,О, міне!
Dialogue: 0,0:43:35.14,0:43:37.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:37.14,0:43:41.08,Default,,0,0,0,,Сосын, Айка-сенпай да.
Dialogue: 0,0:43:37.14,0:43:41.08,Default,,0,0,0,,Сізді кіші қызыңыз шақырды ма?
Dialogue: 0,0:43:41.08,0:43:44.08,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:43:41.08,0:43:44.08,Default,,0,0,0,,Осыны ойлап отыр ма деп ойлаймын.
Dialogue: 0,0:43:44.08,0:43:47.09,Default,,0,0,0,,Айка-чан Алиса-чан
Dialogue: 0,0:43:47.09,0:43:50.09,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:43:47.09,0:43:50.09,Default,,0,0,0,,Вавава…
Dialogue: 0,0:43:50.09,0:43:53.06,Default,,0,0,0,,Уау
Dialogue: 0,0:43:50.09,0:43:53.06,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:43:55.10,0:43:59.10,Default,,0,0,0,,Мен бүгін бәрін көрдім.
Dialogue: 0,0:43:55.10,0:43:59.10,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:43:59.10,0:44:02.10,Default,,0,0,0,,Қысқасы, бұл солай болды.
Dialogue: 0,0:44:02.10,0:44:04.10,Default,,0,0,0,,Бұл үлкен, мінсіз қылмыс.
Dialogue: 0,0:44:04.10,0:44:06.11,Default,,0,0,0,,Уу-у
Dialogue: 0,0:44:04.10,0:44:06.11,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:44:06.11,0:44:09.11,Default,,0,0,0,,(Айка)
Dialogue: 0,0:44:06.11,0:44:09.11,Default,,0,0,0,,Әлі де біраз орындықтар қалды.
Dialogue: 0,0:44:09.11,0:44:12.11,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:44:09.11,0:44:12.11,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:44:12.11,0:44:14.11,Default,,0,0,0,,Мүмкін! Сендер...
Dialogue: 0,0:44:14.11,0:44:16.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:14.11,0:44:16.12,Default,,0,0,0,,Хехехе
Dialogue: 0,0:44:16.12,0:44:18.12,Default,,0,0,0,,Алисия және басқалар
Dialogue: 0,0:44:16.12,0:44:18.12,Default,,0,0,0,,Сіз маған қоңырау шалып жатырсыз!
Dialogue: 0,0:44:18.12,0:44:20.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:18.12,0:44:20.12,Default,,0,0,0,,Гарт!
Dialogue: 0,0:44:20.12,0:44:23.12,Default,,0,0,0,,Хехехе
Dialogue: 0,0:44:20.12,0:44:23.12,Default,,0,0,0,,Мен сенің бақытты екеніңді түсіндім, бірақ➡
Dialogue: 0,0:44:23.12,0:44:26.13,Default,,0,0,0,,Бұл Алисия емес.
Dialogue: 0,0:44:23.12,0:44:26.13,Default,,0,0,0,,Акира-сан және т.б.
Dialogue: 0,0:44:26.13,0:44:29.13,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:44:29.13,0:44:32.13,Default,,0,0,0,,Алисия! Әже!
Dialogue: 0,0:44:32.13,0:44:34.13,Default,,0,0,0,,Бүгін мені шақырғаныңызға рахмет.
Dialogue: 0,0:44:34.13,0:44:38.14,Default,,0,0,0,,​​Керемет тамаша!
Dialogue: 0,0:44:34.13,0:44:38.14,Default,,0,0,0,,Мен жасаймын, балалар.
Dialogue: 0,0:44:38.14,0:44:42.08,Default,,0,0,0,,Күнделікті алғысымызбен
Dialogue: 0,0:44:38.14,0:44:42.08,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:44:42.08,0:44:46.08,Default,,0,0,0,,Афинада музыка фестивалі туралы кездесу бар.
Dialogue: 0,0:44:42.08,0:44:46.08,Default,,0,0,0,,Ерте аяқтаңыз➡
Dialogue: 0,0:44:46.08,0:44:49.08,Default,,0,0,0,,Ол асығыс келетінін айтты.
Dialogue: 0,0:44:49.08,0:44:51.09,Default,,0,0,0,,Афина Сенпайға
Dialogue: 0,0:44:49.08,0:44:51.09,Default,,0,0,0,,Егер сіз мұны істей алсаңыз➡
Dialogue: 0,0:44:51.09,0:44:53.09,Default,,0,0,0,,«Миракуру»
Dialogue: 0,0:44:53.09,0:44:57.09,Default,,0,0,0,,Жарайды, бірақ қанша адам жиналды.
Dialogue: 0,0:44:53.09,0:44:57.09,Default,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,0:44:57.09,0:45:00.09,Default,,0,0,0,,Иә, бұл «Миракуру» жеткілікті.
Dialogue: 0,0:45:00.09,0:45:03.10,Default,,0,0,0,,О, жақсы иіс.
Dialogue: 0,0:45:00.09,0:45:03.10,Default,,0,0,0,,Раушан шайы мүмкін бе?
Dialogue: 0,0:45:03.10,0:45:05.10,Default,,0,0,0,,Иә
Dialogue: 0,0:45:03.10,0:45:05.10,Default,,0,0,0,,Хехехе
Dialogue: 0,0:45:05.10,0:45:08.10,Default,,0,0,0,,Ай-чан және басқалары әкелді
Dialogue: 0,0:45:05.10,0:45:08.10,Default,,0,0,0,,Бұл «Миракуру» хош иісі.
Dialogue: 0,0:45:08.10,0:45:12.07,Default,,0,0,0,,Ұятсыз жолдар жоқ
Dialogue: 0,0:45:08.10,0:45:12.07,Default,,0,0,0,,Иә~
Dialogue: 0,0:45:17.11,0:45:21.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:45:17.11,0:45:21.12,Default,,0,0,0,,Өте дәмді болды.
Dialogue: 0,0:45:21.12,0:45:24.12,Default,,0,0,0,,Бірақ осылай
Dialogue: 0,0:45:21.12,0:45:24.12,Default,,0,0,0,,3 компанияның тағы бір синглы➡
Dialogue: 0,0:45:24.12,0:45:29.12,Default,,0,0,0,,Бірлескен жаттығу үшін дос болған кезде не болады?
Dialogue: 0,0:45:24.12,0:45:29.12,Default,,0,0,0,,Қандай қызық байланыс, әже.
Dialogue: 0,0:45:29.12,0:45:33.13,Default,,0,0,0,,(Нисимура) Цубасаның кеудесі өте үлкен, сондықтан ол жүгіргенде әр жаққа секіріп тұрады.
Dialogue: 0,0:45:29.12,0:45:33.13,Default,,0,0,0,,Президент Ариямен кездесу➡
Dialogue: 0,0:45:33.13,0:45:37.13,Default,,0,0,0,,Уақыт өте баяу өсіңіз➡
Dialogue: 0,0:45:37.13,0:45:40.13,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:45:37.13,0:45:40.13,Default,,0,0,0,,Кездесулерге әкеледі➡
Dialogue: 0,0:45:40.13,0:45:43.07,Default,,0,0,0,,Мен бұл туралы ешқашан ойламадым
Dialogue: 0,0:45:43.07,0:45:46.07,Default,,0,0,0,,Өзімді өте бақытты сезіну
Dialogue: 0,0:45:46.07,0:45:49.08,Default,,0,0,0,,Мен болашақты асыға күтемін Ах...
Dialogue: 0,0:45:49.08,0:45:51.08,Default,,0,0,0,,Алисия
Dialogue: 0,0:45:51.08,0:45:54.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:54.08,0:45:56.08,Default,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:45:56.08,0:46:00.05,Default,,0,0,0,,Қолданыстағы жүйені өзгерту
Dialogue: 0,0:45:56.08,0:46:00.05,Default,,0,0,0,,Бұл оңай емес
Dialogue: 0,0:46:01.09,0:46:03.09,Default,,0,0,0,,Жүйені өзгерту керек пе?
Dialogue: 0,0:46:03.09,0:46:05.09,Default,,0,0,0,,Болашақ
Dialogue: 0,0:46:03.09,0:46:05.09,Default,,0,0,0,,Артқы жағы үшін➡
Dialogue: 0,0:46:05.09,0:46:07.09,Default,,0,0,0,,Prima жарнамасы қалай жұмыс істейді және ➡
Dialogue: 0,0:46:07.09,0:46:10.10,Default,,0,0,0,,Әртүрлі заттар
Dialogue: 0,0:46:07.09,0:46:10.10,Default,,0,0,0,,Өзгеруге тырысу
Dialogue: 0,0:46:10.10,0:46:13.10,Default,,0,0,0,,Керісінше бақытты кездесулер болады➡
Dialogue: 0,0:46:13.10,0:46:17.10,Default,,0,0,0,,Кездесулер болашақты анықтайды
Dialogue: 0,0:46:13.10,0:46:17.10,Default,,0,0,0,,Жабылуы мүмкін
Dialogue: 0,0:46:17.10,0:46:21.11,Default,,0,0,0,,Ұшқыштық саланың жүйесі болып табылады
Dialogue: 0,0:46:17.10,0:46:21.11,Default,,0,0,0,,Егер сіз оларға рұқсат етсеңіз➡
Dialogue: 0,0:46:21.11,0:46:25.11,Default,,0,0,0,,Мен оны өзгертуім керек
Dialogue: 0,0:46:21.11,0:46:25.11,Default,,0,0,0,,Ойланып жүрсіз бе?
Dialogue: 0,0:46:25.11,0:46:27.11,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:46:27.11,0:46:31.12,Default,,0,0,0,,Кездесулердің маңыздылығы
Dialogue: 0,0:46:27.11,0:46:31.12,Default,,0,0,0,,Кім көп біледі➡
Dialogue: 0,0:46:31.12,0:46:33.09,Default,,0,0,0,,Алисияның өзі
Dialogue: 0,0:46:39.13,0:46:44.06,Default,,0,0,0,,《Біз судың үш ұлы перісіміз.
Dialogue: 0,0:46:39.13,0:46:44.06,Default,,0,0,0,,Шақырылғаннан кейін көп ұзамай
Dialogue: 0,0:46:44.06,0:46:50.07,Default,,0,0,0,,《Мен Гондола қауымдастығынанмын
Dialogue: 0,0:46:44.06,0:46:50.07,Default,,0,0,0,,Мен белгілі бір сұрау алдым》
Dialogue: 0,0:46:50.07,0:46:53.07,Default,,0,0,0,,《Әдептілікпен бас тартқаннан кейін де➡
Dialogue: 0,0:46:53.07,0:46:57.08,Default,,0,0,0,,Бірлестіктер үшін
Dialogue: 0,0:46:53.07,0:46:57.08,Default,,0,0,0,,Бізге жиі келіп тұрғаныңыз үшін рахмет➡
Dialogue: 0,0:46:57.08,0:47:01.08,Default,,0,0,0,,Бұдан былай 10 немесе 100 жыл жалғасады➡
Dialogue: 0,0:47:01.08,0:47:05.09,Default,,0,0,0,,Ұшқыштар өнеркәсібі және
Dialogue: 0,0:47:01.08,0:47:05.09,Default,,0,0,0,,Артқы жағы үшін➡
Dialogue: 0,0:47:05.09,0:47:08.09,Default,,0,0,0,,Оның маңызы
Dialogue: 0,0:47:05.09,0:47:08.09,Default,,0,0,0,,Құмарланып уағыздалып жатқанда➡
Dialogue: 0,0:47:08.09,0:47:15.10,Default,,0,0,0,,Мәселе мынада, мен оны сынап көргім келеді.
Dialogue: 0,0:47:08.09,0:47:15.10,Default,,0,0,0,,Мен солай ойладым.》
Dialogue: 0,0:47:15.10,0:47:17.10,Default,,0,0,0,,｟Пуй Пуи Пуи｠
Dialogue: 0,0:47:17.10,0:47:22.10,Default,,0,0,0,,｟Ария президенті Гондола қауымдастығы
Dialogue: 0,0:47:17.10,0:47:22.10,Default,,0,0,0,,Ол күтетін сияқты｠
Dialogue: 0,0:47:22.10,0:47:26.11,Default,,0,0,0,,｟Бос емес кезде жұмыста жұмыс істеу
Dialogue: 0,0:47:22.10,0:47:26.11,Default,,0,0,0,,Сеніп тапсыруға болатын кіші оқушыны табыңыз ➡
Dialogue: 0,0:47:26.11,0:47:30.08,Default,,0,0,0,,Мен өскенше｠
Dialogue: 0,0:47:31.11,0:47:35.08,Default,,0,0,0,,｟Коухай… Уфуфу｠
Dialogue: 0,0:47:39.12,0:47:42.06,Default,,0,0,0,,《"Мені шақырғандай болдым."》
Dialogue: 0,0:47:42.06,0:47:44.06,Default,,0,0,0,,《Мен бұны күтпедім.
Dialogue: 0,0:47:42.06,0:47:44.06,Default,,0,0,0,,Бір сөзбен➡
Dialogue: 0,0:47:44.06,0:47:48.03,Default,,0,0,0,,Мен Акари-чанмен қалай таныстым
Dialogue: 0,0:47:44.06,0:47:48.03,Default,,0,0,0,,Бұл басталды》
Dialogue: 0,0:47:53.07,0:47:59.07,Default,,0,0,0,,《Бұл мүмкін емес
Dialogue: 0,0:47:53.07,0:47:59.07,Default,,0,0,0,,Қайда барарымызды білмей ақырын жүрейік》
Dialogue: 0,0:47:59.07,0:48:02.08,Default,,0,0,0,,《Мен оны жақсы көремін
Dialogue: 0,0:47:59.07,0:48:02.08,Default,,0,0,0,,Осы ARIA компаниясында➡
Dialogue: 0,0:48:02.08,0:48:07.08,Default,,0,0,0,,Мен тым баяу
Dialogue: 0,0:48:02.08,0:48:07.08,Default,,0,0,0,,Осы баламен бірге өсейік》
Dialogue: 0,0:48:07.08,0:48:10.08,Default,,0,0,0,,《Мен солай ойладым》
Dialogue: 0,0:48:10.08,0:48:14.09,Default,,0,0,0,,｟Уау сүйкімді
Dialogue: 0,0:48:10.08,0:48:14.09,Default,,0,0,0,,Не? Бұл｠
Dialogue: 0,0:48:14.09,0:48:16.09,Default,,0,0,0,,Якорин
Dialogue: 0,0:48:14.09,0:48:16.09,Default,,0,0,0,,｜Түнгі жарық қоңырауы｠
Dialogue: 0,0:48:16.09,0:48:20.09,Default,,0,0,0,,｟Уау~ Бірінші рет көруім｠
Dialogue: 0,0:48:16.09,0:48:20.09,Default,,0,0,0,,｟Ой, бұл қызық｠
Dialogue: 0,0:48:20.09,0:48:25.07,Default,,0,0,0,,｟Tantgraze｠
Dialogue: 0,0:48:27.10,0:48:30.07,Default,,0,0,0,,｟Мынау, анау, анау...｠
Dialogue: 0,0:48:31.10,0:48:35.11,Default,,0,0,0,,《Осы акваның айналасындағы төрт мезгіл
Dialogue: 0,0:48:31.10,0:48:35.11,Default,,0,0,0,,Бірге уақыт өткізу➡
Dialogue: 0,0:48:35.11,0:48:41.05,Default,,0,0,0,,Бірте-бірте сен
Dialogue: 0,0:48:35.11,0:48:41.05,Default,,0,0,0,,Ерекше болмысқа айналу》
Dialogue: 0,0:48:41.05,0:48:46.05,Default,,0,0,0,,《Ол
Dialogue: 0,0:48:41.05,0:48:46.05,Default,,0,0,0,,Өте ыңғайлы уақыт》
Dialogue: 0,0:48:46.05,0:48:51.06,Default,,0,0,0,,《Өте маңызды және қымбат кеңістік》
Dialogue: 0,0:48:51.06,0:48:55.06,Default,,0,0,0,,《Қарапайым болған күнделікті өмір
Dialogue: 0,0:48:51.06,0:48:55.06,Default,,0,0,0,,Дүниенің көрінісі➡
Dialogue: 0,0:48:55.06,0:48:59.07,Default,,0,0,0,,Ол әдемі жарқырады》
Dialogue: 0,0:48:59.07,0:49:03.04,Default,,0,0,0,,《Сол сияқты
Dialogue: 0,0:48:59.07,0:49:03.04,Default,,0,0,0,,Сиқырланғандай》
Dialogue: 0,0:49:04.07,0:49:09.08,Default,,0,0,0,,《Ауыстырылмайтын
Dialogue: 0,0:49:04.07,0:49:09.08,Default,,0,0,0,,Мен бұл сәтті жоғалтқым келмейді.
Dialogue: 0,0:49:09.08,0:49:12.08,Default,,0,0,0,,《Мәңгілік жүре бер》
Dialogue: 0,0:49:12.08,0:49:16.08,Default,,0,0,0,,《Егер мен сиқырды қолдансам➡
Dialogue: 0,0:49:16.08,0:49:21.09,Default,,0,0,0,,Мен жай ғана уақытты тоқтатқым келеді》
Dialogue: 0,0:49:21.09,0:49:33.10,Default,,0,0,0,,♬～
Dialogue: 0,0:49:33.10,0:49:35.10,Default,,0,0,0,,｟О, бұл｠
Dialogue: 0,0:49:35.10,0:49:38.11,Default,,0,0,0,,｟Эхехе, мен әкелдім｠
Dialogue: 0,0:49:38.11,0:49:41.07,Default,,0,0,0,,｟Ол енді жарқырамайды｠
Dialogue: 0,0:49:43.11,0:49:48.12,Default,,0,0,0,,｟Сәлем, Акари-чан
Dialogue: 0,0:49:43.11,0:49:48.12,Default,,0,0,0,,Сол нұрлы қоңыраумен қоштасқанда➡
Dialogue: 0,0:49:48.12,0:49:50.08,Default,,0,0,0,,Өзіңізді қалай сезіндіңіз? ｠
Dialogue: 0,0:49:52.12,0:49:57.12,Default,,0,0,0,,｟Ол жалғыздық еді.
Dialogue: 0,0:49:52.12,0:49:57.12,Default,,0,0,0,,Керемет
Dialogue: 0,0:49:57.12,0:50:00.13,Default,,0,0,0,,｟Қоштасу
Dialogue: 0,0:49:57.12,0:50:00.13,Default,,0,0,0,,Мен өзімді үнемі жалғыз сезінемін｠
Dialogue: 0,0:50:00.13,0:50:05.13,Default,,0,0,0,,｟Тіпті түнгі жарық қоңырауы соққанда
Dialogue: 0,0:50:00.13,0:50:05.13,Default,,0,0,0,,Тіпті Гондола мырза➡
Dialogue: 0,0:50:05.13,0:50:09.14,Default,,0,0,0,,өте өте
Dialogue: 0,0:50:05.13,0:50:09.14,Default,,0,0,0,,Мен өзімді жалғыз және қайғылы сезіндім｠
Dialogue: 0,0:50:09.14,0:50:15.14,Default,,0,0,0,,｟Бірақ солай шығар
Dialogue: 0,0:50:09.14,0:50:15.14,Default,,0,0,0,,Бұл жақсы нәрсе.
Dialogue: 0,0:50:15.14,0:50:18.11,Default,,0,0,0,,｟Алисия｠
Dialogue: 0,0:50:15.14,0:50:18.11,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:50:19.15,0:50:24.15,Default,,0,0,0,,｟Жалғыздық неғұрлым көп болса, соғұрлым жалғыз болады
Dialogue: 0,0:50:19.15,0:50:24.15,Default,,0,0,0,,Неғұрлым мұңайса, соғұрлым қайғылы➡
Dialogue: 0,0:50:24.15,0:50:29.12,Default,,0,0,0,,Бұл мен жақсы көретін нәрсе
Dialogue: 0,0:50:24.15,0:50:29.12,Default,,0,0,0,,Өйткені солай болды
Dialogue: 0,0:50:30.16,0:50:33.16,Default,,0,0,0,,｟Бұл өмір бойы
Dialogue: 0,0:50:30.16,0:50:33.16,Default,,0,0,0,,Менің ойымша...｠
Dialogue: 0,0:50:33.16,0:50:39.13,Default,,0,0,0,,｟Осы аквамен жарқыраған
Dialogue: 0,0:50:33.16,0:50:39.13,Default,,0,0,0,,Жарқырап тұратын асыл болмыс｠
Dialogue: 0,0:50:40.17,0:50:48.14,Default,,0,0,0,,｟Сондықтан мен мұңайып тұрмын
Dialogue: 0,0:50:40.17,0:50:48.14,Default,,0,0,0,,Бұл да бақытты адамның белгісі.
Dialogue: 0,0:50:56.12,0:51:01.09,Default,,0,0,0,,《Жүрегіме жинақталған тоқырау
Dialogue: 0,0:50:56.12,0:51:01.09,Default,,0,0,0,,Шешу》
Dialogue: 0,0:51:06.13,0:51:12.13,Default,,0,0,0,,《Тәнім де сен сияқты мөлдір болады.
Dialogue: 0,0:51:06.13,0:51:12.13,Default,,0,0,0,,Нақтырақ болу》
Dialogue: 0,0:51:12.13,0:51:17.14,Default,,0,0,0,,《Ол сияқты
Dialogue: 0,0:51:12.13,0:51:17.14,Default,,0,0,0,,Осы акваны➡ жайлап ораңыз
Dialogue: 0,0:51:17.14,0:51:21.14,Default,,0,0,0,,Алыстағы көк теңіз сияқты》
Dialogue: 0,0:51:21.14,0:51:25.11,Default,,0,0,0,,《Рахмет саған Акари-чан》
Dialogue: 0,0:51:31.15,0:51:33.15,Default,,0,0,0,,｟Ахахаха｠
Dialogue: 0,0:51:33.15,0:51:35.16,Default,,0,0,0,,｟Акари-чанға
Dialogue: 0,0:51:33.15,0:51:35.16,Default,,0,0,0,,Сіз мұны айттыңыз ба?
Dialogue: 0,0:51:35.16,0:51:37.16,Default,,0,0,0,,｟Иә｠
Dialogue: 0,0:51:37.16,0:51:42.10,Default,,0,0,0,,｟Жалғыз және қайғылы
Dialogue: 0,0:51:37.16,0:51:42.10,Default,,0,0,0,,Бақытты адамның дәлелі ғана белгілі｠
Dialogue: 0,0:51:42.10,0:51:45.10,Default,,0,0,0,,｟Алис-чан да
Dialogue: 0,0:51:42.10,0:51:45.10,Default,,0,0,0,,Орта мектептің түлегі｠
Dialogue: 0,0:51:45.10,0:51:48.10,Default,,0,0,0,,｟Біз де дайын болуымыз керек｠
Dialogue: 0,0:51:48.10,0:51:53.11,Default,,0,0,0,,｟Тек гондола қауымдастығы ғана емес
Dialogue: 0,0:51:48.10,0:51:53.11,Default,,0,0,0,,Сіз мені күтіп отырсыз ба? Ол да
Dialogue: 0,0:51:53.11,0:51:55.11,Default,,0,0,0,,｟Иә｠
Dialogue: 0,0:51:55.11,0:51:57.08,Default,,0,0,0,,(Акира)
Dialogue: 0,0:51:55.11,0:51:57.08,Default,,0,0,0,,｜Олардың барлығы жақсы нәрселер｠
Dialogue: 0,0:52:00.11,0:52:03.08,Default,,0,0,0,,｟Қазір тоқтамаңыз
Dialogue: 0,0:52:00.11,0:52:03.08,Default,,0,0,0,,Мен қала алмаймын.
Dialogue: 0,0:52:04.12,0:52:06.09,Default,,0,0,0,,｟Иә｠
Dialogue: 0,0:52:12.13,0:52:15.10,Default,,0,0,0,,｟Жаңбыр тоқтады｠
Dialogue: 0,0:52:17.13,0:52:19.10,Default,,0,0,0,,｟Е...｠
Dialogue: 0,0:52:21.13,0:52:24.14,Default,,0,0,0,,｟Олай болса бастайық｠
Dialogue: 0,0:52:24.14,0:52:26.11,Default,,0,0,0,,｟Иә! ｠
Dialogue: 0,0:52:27.14,0:52:30.14,Default,,0,0,0,,《Сиқыр ериді》
Dialogue: 0,0:52:30.14,0:52:35.15,Default,,0,0,0,,《Менің уақытым тоқтап қалды
Dialogue: 0,0:52:30.14,0:52:35.15,Default,,0,0,0,,Қайтадан қозғалуды бастау》
Dialogue: 0,0:52:35.15,0:52:37.15,Default,,0,0,0,,N... Nnn...
Dialogue: 0,0:52:37.15,0:52:39.15,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:52:39.15,0:52:42.09,Default,,0,0,0,,А, арман?
Dialogue: 0,0:52:42.09,0:52:45.06,Default,,0,0,0,,Сіз қандай түс көрдіңіз?
Dialogue: 0,0:52:46.09,0:52:50.10,Default,,0,0,0,,Хехе, сағынышпен кездесу арманы
Dialogue: 0,0:52:50.10,0:52:52.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:52.10,0:52:56.10,Default,,0,0,0,,(Айка)
Dialogue: 0,0:52:52.10,0:52:56.10,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші рет босаңсып қалдым.
Dialogue: 0,0:52:56.10,0:52:59.11,Default,,0,0,0,,(Акира)
Dialogue: 0,0:52:56.10,0:52:59.11,Default,,0,0,0,,Жоспарлаған үш адамға рахмет.
Dialogue: 0,0:52:59.11,0:53:03.11,Default,,0,0,0,,Афина
Dialogue: 0,0:52:59.11,0:53:03.11,Default,,0,0,0,,Сіз келе алмадыңыз.
Dialogue: 0,0:53:03.11,0:53:06.11,Default,,0,0,0,,Оны аяқтауға асықпа
Dialogue: 0,0:53:03.11,0:53:06.11,Default,,0,0,0,,Менің қолымнан келмесе де
Dialogue: 0,0:53:06.11,0:53:08.11,Default,,0,0,0,,Мен күткендей
Dialogue: 0,0:53:08.11,0:53:12.12,Default,,0,0,0,,Бірақ рахмет
Dialogue: 0,0:53:08.11,0:53:12.12,Default,,0,0,0,,Тілегімнің дәні қалды.
Dialogue: 0,0:53:12.12,0:53:14.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:14.12,0:53:16.12,Default,,0,0,0,,Тілек тұқымы?
Dialogue: 0,0:53:14.12,0:53:16.12,Default,,0,0,0,,Иә
Dialogue: 0,0:53:16.12,0:53:21.13,Default,,0,0,0,,Орындалмаған тілектің дәні
Dialogue: 0,0:53:16.12,0:53:21.13,Default,,0,0,0,,Жүрегімде қал➡
Dialogue: 0,0:53:21.13,0:53:25.13,Default,,0,0,0,,Үміт нұрын шашып тұр
Dialogue: 0,0:53:25.13,0:53:31.14,Default,,0,0,0,,Оны өзіңіз жоймасаңыз
Dialogue: 0,0:53:25.13,0:53:31.14,Default,,0,0,0,,Толқу мәңгілікке жалғасады
Dialogue: 0,0:53:31.14,0:53:36.14,Default,,0,0,0,,Бұл қуанышты жағдай емес пе?
Dialogue: 0,0:53:36.14,0:53:39.15,Default,,0,0,0,,Сонымен тұқым
Dialogue: 0,0:53:36.14,0:53:39.15,Default,,0,0,0,,Сіз оны жинайсыз.
Dialogue: 0,0:53:39.15,0:53:43.08,Default,,0,0,0,,Хехехе, бұл біртүрлі нәрсе➡
Dialogue: 0,0:53:43.08,0:53:46.09,Default,,0,0,0,,Мен сенімен қазір кездесуім керек
Dialogue: 0,0:53:43.08,0:53:46.09,Default,,0,0,0,,Ойымда бар тілек➡
Dialogue: 0,0:53:46.09,0:53:52.09,Default,,0,0,0,,Сыртқы түріңізді және кенеттен өзгертіңіз
Dialogue: 0,0:53:46.09,0:53:52.09,Default,,0,0,0,,Кейде бетіңді көрсетесің, солай ма?
Dialogue: 0,0:53:52.09,0:53:55.06,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:53:59.10,0:54:02.10,Default,,0,0,0,,Келесі жолы мен сенімдімін
Dialogue: 0,0:53:59.10,0:54:02.10,Default,,0,0,0,,Барлығымызды біріктіру үшін барымызды салайық.
Dialogue: 0,0:54:02.10,0:54:05.11,Default,,0,0,0,,Бұл жолы гондола кеші
Dialogue: 0,0:54:02.10,0:54:05.11,Default,,0,0,0,,Қандай жақсы.
Dialogue: 0,0:54:05.11,0:54:07.07,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:54:12.11,0:54:17.12,Default,,0,0,0,,♪ (Афинаның ән салған дауысы)
Dialogue: 0,0:54:17.12,0:54:20.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:20.12,0:54:27.13,Default,,0,0,0,,♪～
Dialogue: 0,0:54:27.13,0:54:30.13,Default,,0,0,0,,Га, Афина-сенпай
Dialogue: 0,0:54:30.13,0:54:50.08,Default,,0,0,0,,♪～
Dialogue: 0,0:54:50.08,0:55:10.10,Default,,0,0,0,,♪～
Dialogue: 0,0:55:10.10,0:55:30.12,Default,,0,0,0,,♪～
Dialogue: 0,0:55:30.12,0:55:50.08,Default,,0,0,0,,♪～
Dialogue: 0,0:55:50.08,0:55:53.08,Default,,0,0,0,,♪～
Dialogue: 0,0:55:53.08,0:55:56.05,Default,,0,0,0,,Бұл үлкен «Миракуру»
Dialogue: 0,0:55:57.08,0:56:01.09,Default,,0,0,0,,Ай-чан және басқалары бүгін жасады.
Dialogue: 0,0:55:57.08,0:56:01.09,Default,,0,0,0,,Бұл Миракурдың мерейтойы.
Dialogue: 0,0:56:01.09,0:56:04.09,Default,,0,0,0,,Ұятсыз сызықтарға жол берілмейді
Dialogue: 0,0:56:04.09,0:56:08.09,Default,,0,0,0,,Олар байланысқан.
Dialogue: 0,0:56:04.09,0:56:08.09,Default,,0,0,0,,Содан бері
Dialogue: 0,0:56:08.09,0:56:10.06,Default,,0,0,0,,Иә
Dialogue: 0,0:56:11.10,0:56:15.10,Default,,0,0,0,,Әрқайсымыз басып өтетін жол
Dialogue: 0,0:56:11.10,0:56:15.10,Default,,0,0,0,,Бір-бірімен әрекеттесу➡
Dialogue: 0,0:56:15.10,0:56:20.07,Default,,0,0,0,,Жаңа жолға айналып, қайта алыстау
Dialogue: 0,0:56:21.11,0:56:24.08,Default,,0,0,0,,｟Құттықтаймыз Алиса Чан｠
Dialogue: 0,0:56:25.11,0:56:30.12,Default,,0,0,0,,｟Апельсин ханшайымы жоқ｠
Dialogue: 0,0:56:30.12,0:56:34.09,Default,,0,0,0,,｟Бүгіннен бастап, сіз
Dialogue: 0,0:56:30.12,0:56:34.09,Default,,0,0,0,,Бұл Prima Undine｠
Dialogue: 0,0:56:35.12,0:56:38.09,Default,,0,0,0,,｜Егер сен құласаң, мен оны қабылдамаймын｠
Dialogue: 0,0:56:43.06,0:56:46.07,Default,,0,0,0,,｜Болашақ патшайым Мәртебелі｠
Dialogue: 0,0:56:46.07,0:56:48.03,Default,,0,0,0,,｟Иә! ｠
Dialogue: 0,0:56:55.07,0:57:00.08,Default,,0,0,0,,｟Сізбен кездесу
Dialogue: 0,0:56:55.07,0:57:00.08,Default,,0,0,0,,Бұл өте жақсы болды｠
Dialogue: 0,0:57:00.08,0:57:05.05,Default,,0,0,0,,｟Рахмет менің Аквамарин｠
Dialogue: 0,0:57:06.09,0:57:09.06,Default,,0,0,0,,｟Аквамарин…｠
Dialogue: 0,0:57:10.09,0:57:13.09,Default,,0,0,0,,Хару
Dialogue: 0,0:57:10.09,0:57:13.09,Default,,0,0,0,,Көк
Dialogue: 0,0:57:10.09,0:57:13.09,Default,,0,0,0,,｟Дистант көк｠
Dialogue: 0,0:57:13.09,0:57:15.06,Default,,0,0,0,,｟Puyture｠
Dialogue: 0,0:57:16.10,0:57:21.10,Default,,0,0,0,,｟Мен өз жолымды ұстанамын
Dialogue: 0,0:57:16.10,0:57:21.10,Default,,0,0,0,,Өйткені мен тоқтамай жүрдім➡
Dialogue: 0,0:57:21.10,0:57:24.10,Default,,0,0,0,,Мен сені кездестірдім｠
Dialogue: 0,0:57:24.10,0:57:31.08,Default,,0,0,0,,｟Бұдан былай да
Dialogue: 0,0:57:24.10,0:57:31.08,Default,,0,0,0,,Жаңа сыйлыққа қарай жүру｠
Dialogue: 0,0:57:35.11,0:57:55.07,Default,,0,0,0,,♬～
Dialogue: 0,0:57:55.07,0:58:15.09,Default,,0,0,0,,♬～
Dialogue: 0,0:58:15.09,0:58:35.11,Default,,0,0,0,,♬～
Dialogue: 0,0:58:35.11,0:58:55.06,Default,,0,0,0,,♬～
Dialogue: 0,0:58:55.06,0:59:15.08,Default,,0,0,0,,♬～
Dialogue: 0,0:59:15.08,0:59:20.09,Default,,0,0,0,,♬～
Dialogue: 0,0:59:20.09,0:59:23.09,Default,,0,0,0,,Есікті бастайық
Dialogue: 0,0:59:23.09,0:59:26.09,Default,,0,0,0,,Біздің болашағымызға
Dialogue: 0,0:59:26.09,0:59:29.10,Default,,0,0,0,,Пуйчер
Dialogue: 0,0:59:29.10,0:59:49.08,Default,,0,0,0,,♬～
Dialogue: 0,0:59:50.58,0:59:56.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory