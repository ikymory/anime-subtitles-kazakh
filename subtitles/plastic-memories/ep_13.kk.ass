Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:53.43,0:01:57.03,OPJP,,0,0,0,,Жарықты жинау
Dialogue: 0,0:02:05.03,0:02:09.53,OPJP,,0,0,0,,Қоштасудан естеліктер
Dialogue: 0,0:02:10.63,0:02:16.70,OPJP,,0,0,0,,Көзіме тамсанып, алысқа қадалған арман
Dialogue: 0,0:02:16.88,0:02:22.13,OPJP,,0,0,0,,Ән жады бұзылады
Dialogue: 0,0:02:22.43,0:02:27.53,OPJP,,0,0,0,,Жалғыздықтың көз жасын ақырын сүртейік
Dialogue: 0,0:02:27.83,0:02:34.73,OPJP,,0,0,0,,Ұзартылған қол - айналмалы дөңгелек, оны абайлап алыңыз
Dialogue: 0,0:02:35.04,0:02:40.03,OPJP,,0,0,0,,Оянғалы тұрған жадының үзінділері
Dialogue: 0,0:02:41.03,0:02:45.93,OPJP,,0,0,0,,Мен төмен қарап, жоқ болып кетсін деп дұға етемін, бірақ
Dialogue: 0,0:02:46.04,0:02:52.03,OPJP,,0,0,0,,Бұл сіз тапқан дауыс
Dialogue: 0,0:02:52.33,0:02:59.03,OPJP,,0,0,0,,Сағат тілі қозғала бастайды, көп ұзамай дүниенің түсі өзгереді
Dialogue: 0,0:02:59.33,0:03:05.23,OPJP,,0,0,0,,Менің пластикалық жүрегім жарқырайды
Dialogue: 0,0:03:05.50,0:03:10.13,OPJP,,0,0,0,,Ұмытпа, есте сақта
Dialogue: 0,0:03:10.54,0:03:17.03,OPJP,,0,0,0,,Бір күні тағы кездескенше
Dialogue: 0,0:01:53.43,0:01:57.03,OPCN,,0,0,0,,Банарюкодюки
Dialogue: 0,0:02:05.03,0:02:09.53,OPCN,,0,0,0,,Өткен және қазіргі заманның түрлері
Dialogue: 0,0:02:10.63,0:02:16.70,OPCN,,0,0,0,,Хитоми Накасокойори Шинчу Атсуши Миядзаки Сузуки
Dialogue: 0,0:02:16.88,0:02:22.13,OPCN,,0,0,0,,Соруваканың қалқымалы арманы
Dialogue: 0,0:02:22.43,0:02:27.53,OPCN,,0,0,0,,Көзді уқалау
Dialogue: 0,0:02:27.83,0:02:34.73,OPCN,,0,0,0,,Көз алдымда зәулім ғимарат.
Dialogue: 0,0:02:35.04,0:02:40.03,OPCN,,0,0,0,,Өткеннің шығу тегі және оғаш ойлардың пайда болуы туралы егжей-тегжейлі баяндау
Dialogue: 0,0:02:41.03,0:02:45.93,OPCN,,0,0,0,,Мен басымды төмен қараймын.
Dialogue: 0,0:02:46.04,0:02:52.03,OPCN,,0,0,0,,Жүрегіңнің үні
Dialogue: 0,0:02:52.33,0:02:59.03,OPCN,,0,0,0,,Тоқырауын заман, сұр-қараңғы дүние
Dialogue: 0,0:02:59.33,0:03:05.23,OPCN,,0,0,0,,Пластикалық жүрек те жарық шығарады
Dialogue: 0,0:03:05.50,0:03:10.13,OPCN,,0,0,0,,Юкун Мубо Синджу Хисазу
Dialogue: 0,0:03:10.54,0:03:17.03,OPCN,,0,0,0,,Бір күні таң ата, Мен сені тағы да кездестіремін.
Dialogue: 0,0:20:56.15,0:20:59.49,EDJP,,0,0,0,,Ажырасқан сені іздедім.
Dialogue: 0,0:20:59.75,0:21:03.25,EDJP,,0,0,0,,Мені шақырған дауыс сөніп қалды
Dialogue: 0,0:21:03.45,0:21:10.85,EDJP,,0,0,0,,Мен ұстаған қол дірілдеп тұрды.
Dialogue: 0,0:21:11.33,0:21:14.85,EDJP,,0,0,0,,Біздің сезімдер
Dialogue: 0,0:21:15.05,0:21:20.05,EDJP,,0,0,0,,Қайтаруға болмайтын уақытты қабыл алыңыз
Dialogue: 0,0:21:20.26,0:21:24.76,EDJP,,0,0,0,,Мен биік ұшамын
Dialogue: 0,0:21:25.56,0:21:29.15,EDJP,,0,0,0,,Аспанда жарқыраған калейдоскоп
Dialogue: 0,0:21:29.35,0:21:33.15,EDJP,,0,0,0,,Сіз ыңғайсызданып күлдіңіз
Dialogue: 0,0:21:33.46,0:21:39.15,EDJP,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:21:40.35,0:21:43.91,EDJP,,0,0,0,,Жарық ерігенге дейін
Dialogue: 0,0:21:44.05,0:21:47.05,EDJP,,0,0,0,,Мен шын жүректен үміттенемін
Dialogue: 0,0:21:47.25,0:21:59.25,EDJP,,0,0,0,,Осы сәтті мәңгі ұмытпа
Dialogue: 0,0:20:56.15,0:20:59.49,EDCN,,0,0,0,,Бұл тікелей тәжірибе.
Dialogue: 0,0:20:59.75,0:21:03.25,EDCN,,0,0,0,,Дауыс дауысы
Dialogue: 0,0:21:03.45,0:21:10.85,EDCN,,0,0,0,,...
Dialogue: 0,0:21:11.33,0:21:14.85,EDCN,,0,0,0,,Жеке ойлар
Dialogue: 0,0:21:15.05,0:21:20.05,EDCN,,0,0,0,,Қайтылатын қозғалыс уақыты жоқ
Dialogue: 0,0:21:20.26,0:21:24.76,EDCN,,0,0,0,,Аспанда биік ұшқаннан кейін
Dialogue: 0,0:21:25.56,0:21:29.15,EDCN,,0,0,0,,Отты жүзім күміс гүлі мантан лалагүлі
Dialogue: 0,0:21:29.35,0:21:33.15,EDCN,,0,0,0,,Жүзіңнен күлкі
Dialogue: 0,0:21:33.46,0:21:39.15,EDCN,,0,0,0,,Таусылмас махаббат пен қадір-қасиет
Dialogue: 0,0:21:40.35,0:21:43.91,EDCN,,0,0,0,,Жарықтың таралуы
Dialogue: 0,0:21:44.05,0:21:47.05,EDCN,,0,0,0,,Менің тілегім сізге ыңғайлы болу.
Dialogue: 0,0:21:47.25,0:21:59.25,EDCN,,0,0,0,,Бір сәт, бұл өмір мәңгілікке ұмытылады.
Dialogue: 0,0:18:12.82,0:18:21.41,INJP,,0,0,0,,Жарық аспанмен сөйлесу үшін жерге жату
Dialogue: 0,0:18:22.04,0:18:37.89,INJP,,0,0,0,,ағып жатқан жұлдыз терең аспан арқылы ұшып өтті
Dialogue: 0,0:18:46.07,0:18:53.19,INJP,,0,0,0,,бұлдыр көздер...
Dialogue: 0,0:18:54.54,0:19:07.67,INJP,,0,0,0,,көз жасыңызбен жүрегіңізді жаулап алды және...
Dialogue: 0,0:19:07.79,0:19:11.13,INJP,,0,0,0,,ешқашан артқа бұрылмаңыз
Dialogue: 0,0:19:11.30,0:19:15.51,INJP,,0,0,0,,баланың ойнақы ойы сияқты
Dialogue: 0,0:19:15.59,0:19:18.10,INJP,,0,0,0,,біз өзгереміз
Dialogue: 0,0:19:18.51,0:19:23.43,INJP,,0,0,0,,көрінбейтін қанаттарымен ұшады
Dialogue: 0,0:19:23.60,0:19:25.94,INJP,,0,0,0,,қазір бірге
Dialogue: 0,0:19:26.60,0:19:34.78,INJP,,0,0,0,,температураңыз қалыптыдан сәл төмен
Dialogue: 0,0:19:34.90,0:19:41.91,INJP,,0,0,0,,бірақ біз құпия терминалда жылы сезіне аламыз
Dialogue: 0,0:19:42.83,0:19:49.29,INJP,,0,0,0,,билет қақпасында, көптің ішінде
Dialogue: 0,0:19:49.63,0:19:53.01,INJP,,0,0,0,,сәлем, қош бол
Dialogue: 0,0:19:53.92,0:20:00.01,INJP,,0,0,0,,қайта-қайта
Dialogue: 0,0:20:13.00,0:20:27.70,INJP,,0,0,0,,болашақты телескоппен көру
Dialogue: 0,0:20:31.30,0:20:35.00,INJP,,0,0,0,,осында қал
Dialogue: 0,0:18:12.82,0:18:21.41,INCN,,0,0,0,,Жердің арқасы, түнгі аспан
Dialogue: 0,0:18:22.04,0:18:37.89,INCN,,0,0,0,,Бір жолды метеор
Dialogue: 0,0:18:46.07,0:18:53.19,INCN,,0,0,0,,Барлығы…
Dialogue: 0,0:18:54.54,0:19:07.67,INCN,,0,0,0,,Айкен Джигган Айкен Коносей…
Dialogue: 0,0:19:07.79,0:19:11.13,INCN,,0,0,0,,Дыбыстың жоғалуы
Dialogue: 0,0:19:11.30,0:19:15.51,INCN,,0,0,0,,...
Dialogue: 0,0:19:15.59,0:19:18.10,INCN,,0,0,0,,Йокун бірігіп жойылатын хризалис
Dialogue: 0,0:19:18.51,0:19:23.43,INCN,,0,0,0,,Қанатсыз қанаттар
Dialogue: 0,0:19:23.60,0:19:25.94,INCN,,0,0,0,,Бұл өзара
Dialogue: 0,0:19:26.60,0:19:34.78,INCN,,0,0,0,,Дене температурасы
Dialogue: 0,0:19:34.90,0:19:41.91,INCN,,0,0,0,,Хакуба Суджо
Dialogue: 0,0:19:42.83,0:19:49.29,INCN,,0,0,0,,Тіркеу дереу
Dialogue: 0,0:19:49.63,0:19:53.01,INCN,,0,0,0,,Өзара қарым-қатынас және бөліну
Dialogue: 0,0:19:53.92,0:20:00.01,INCN,,0,0,0,,Әлі тыныс алмай жатыр
Dialogue: 0,0:20:13.00,0:20:27.70,INCN,,0,0,0,,Харука Юкичири
Dialogue: 0,0:20:31.30,0:20:35.00,INCN,,0,0,0,,Ықтимал бөлу
Dialogue: 0,0:00:33.41,0:00:34.52,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:35.73,0:00:37.90,JPN,,0,0,0,,Сонда бұл бала ше?
Dialogue: 0,0:00:38.94,0:00:40.41,JPN,,0,0,0,,Бала Челси
Dialogue: 0,0:00:41.05,0:00:43.70,JPN,,0,0,0,,Ол менің ең жақын досым болды.
Dialogue: 0,0:00:45.06,0:00:46.22,JPN,,0,0,0,,Сіз қай жерде кездестіңіз?
Dialogue: 0,0:00:47.17,0:00:51.69,JPN,,0,0,0,,Мен оның жақын маңдағы саябақта итімен серуендеп жүргенін жиі көрдім.
Dialogue: 0,0:00:52.84,0:00:54.05,JPN,,0,0,0,,Сізге иттерді ұнатасыз ба?
Dialogue: 0,0:00:55.17,0:00:59.54,JPN,,0,0,0,,Бірақ мен оған қол тигізейін десем, қобалжып, үре бастайды.
Dialogue: 0,0:01:00.35,0:01:01.70,JPN,,0,0,0,,Исла сияқты естіледі.
Dialogue: 0,0:01:02.63,0:01:03.60,JPN,,0,0,0,,Ауырды
Dialogue: 0,0:01:04.20,0:01:05.34,JPN,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:01:21.10,0:01:24.03,JPN,,0,0,0,,Исла Челсиді де қайтарды.
Dialogue: 0,0:01:25.13,0:01:25.53,JPN,,0,0,0,,Иә
Dialogue: 0,0:01:27.61,0:01:29.70,JPN,,0,0,0,,Исла туралы мен білмейтін естеліктер
Dialogue: 0,0:01:30.54,0:01:31.96,JPN,,0,0,0,,Олардың саны өте көп.
Dialogue: 0,0:01:49.46,0:01:51.95,JPN,,0,0,0,,Бұл соңғы күн.
Dialogue: 0,0:03:54.01,0:03:56.33,JPN,,0,0,0,,Жақсы ма? Мен өзгертуім керек пе?
Dialogue: 0,0:03:57.62,0:03:59.30,JPN,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:04:01.08,0:04:01.66,JPN,,0,0,0,,Ира
Dialogue: 0,0:04:07.96,0:04:09.93,JPN,,0,0,0,,Цукаса Бұл өте лас.
Dialogue: 0,0:04:10.98,0:04:11.86,JPN,,0,0,0,,Исла да
Dialogue: 0,0:04:13.74,0:04:14.31,JPN,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:04:18.62,0:04:20.78,JPN,,0,0,0,,Сіз бізге қосылғыңыз келетінін айттыңыз.
Dialogue: 0,0:04:21.32,0:04:23.22,JPN,,0,0,0,,Мен мұны істегім келді ме?
Dialogue: 0,0:04:24.02,0:04:25.96,JPN,,0,0,0,,Қайталап көрейін бе?
Dialogue: 0,0:04:27.34,0:04:28.09,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:04:29.09,0:04:30.80,JPN,,0,0,0,,Енді менің кезегім
Dialogue: 0,0:04:41.56,0:04:44.17,JPN,,0,0,0,,Исла қатты толқыды
Dialogue: 0,0:04:51.93,0:04:53.23,JPN,,0,0,0,,Тоқта
Dialogue: 0,0:05:05.06,0:05:06.36,JPN,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:05:08.70,0:05:10.13,JPN,,0,0,0,,Иә, мен жасадым.
Dialogue: 0,0:05:11.17,0:05:12.08,JPN,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:06:04.31,0:06:05.32,JPN,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:06:06.80,0:06:08.25,JPN,,0,0,0,,Кадзуки қайырлы таң
Dialogue: 0,0:06:08.56,0:06:09.53,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:10.50,0:06:11.66,JPN,,0,0,0,,Таку
Dialogue: 0,0:06:11.81,0:06:13.76,JPN,,0,0,0,,Кадзуки-сан, бұл өте ерте.
Dialogue: 0,0:06:13.90,0:06:15.36,JPN,,0,0,0,,Бұл әрқашан соңғы минут болса да
Dialogue: 0,0:06:15.50,0:06:18.44,JPN,,0,0,0,,Мен мұнда ертерек келдім.
Dialogue: 0,0:06:18.70,0:06:20.15,JPN,,0,0,0,,Содан кейін, күткендей,
Dialogue: 0,0:06:20.79,0:06:23.49,JPN,,0,0,0,,Балалар, осындай күні жұмысқа неге келдіңдер?
Dialogue: 0,0:06:24.30,0:06:25.01,JPN,,0,0,0,,Кадзуки
Dialogue: 0,0:06:25.56,0:06:29.85,JPN,,0,0,0,,Соңғы күніме дейін мен Терминал қызметтерінің мүшесі боламын.
Dialogue: 0,0:06:30.50,0:06:32.63,JPN,,0,0,0,,О, түсіндім.
Dialogue: 0,0:06:33.95,0:06:35.75,JPN,,0,0,0,,Бұл сізге керек
Dialogue: 0,0:06:36.72,0:06:38.79,JPN,,0,0,0,,Жай ғана сыйлық, солай ма?
Dialogue: 0,0:06:39.10,0:06:40.72,JPN,,0,0,0,,немесе оны қайтарыңыз
Dialogue: 0,0:06:40.81,0:06:41.78,JPN,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:06:47.16,0:06:49.66,JPN,,0,0,0,,Кадзуки айлакер, әрқашан болған.
Dialogue: 0,0:06:50.27,0:06:51.89,JPN,,0,0,0,,Бұл қандай тұлға?
Dialogue: 0,0:06:52.73,0:06:54.09,JPN,,0,0,0,,Сіз оны қайтармайсыз ба?
Dialogue: 0,0:06:54.21,0:06:54.85,JPN,,0,0,0,,О
Dialogue: 0,0:06:55.03,0:06:55.91,JPN,,0,0,0,,Қалай болғанда да?
Dialogue: 0,0:06:56.24,0:06:56.85,JPN,,0,0,0,,О
Dialogue: 0,0:06:58.09,0:06:58.92,JPN,,0,0,0,,Түсіндім
Dialogue: 0,0:07:02.10,0:07:06.48,JPN,,0,0,0,,Казуки Мен мұнда жұмыс істей алатыныма қуаныштымын.
Dialogue: 0,0:07:07.22,0:07:09.91,JPN,,0,0,0,,Не өзгерді...
Dialogue: 0,0:07:11.32,0:07:12.95,JPN,,0,0,0,,Қиын кездер болса да
Dialogue: 0,0:07:13.65,0:07:18.13,JPN,,0,0,0,,Одан да көп қуанышты жағдайлар болды.
Dialogue: 0,0:07:19.64,0:07:20.57,JPN,,0,0,0,,Жақсы айт
Dialogue: 0,0:07:21.60,0:07:23.69,JPN,,0,0,0,,Мен сені қатты уайымдадым.
Dialogue: 0,0:07:25.77,0:07:27.06,JPN,,0,0,0,,Кадзуки мырза?
Dialogue: 0,0:07:27.62,0:07:29.36,JPN,,0,0,0,,Мен мұны саған қалдырамын, Цукаса.
Dialogue: 0,0:07:30.76,0:07:32.25,JPN,,0,0,0,,Жүр, үйге қайт.
Dialogue: 0,0:07:33.13,0:07:35.18,JPN,,0,0,0,,Қазір шығыңыз!
Dialogue: 0,0:07:40.23,0:07:43.17,JPN,,0,0,0,,Егер бұл екеуі болса, мен оларды әлдеқашан қуып кетер едім.
Dialogue: 0,0:07:44.60,0:07:46.18,JPN,,0,0,0,,Бардың ба?
Dialogue: 0,0:07:46.55,0:07:47.91,JPN,,0,0,0,,Мен кеттім.
Dialogue: 0,0:07:48.69,0:07:53.28,JPN,,0,0,0,,Таңертең ерте келіп сізді тексеруге бәрі ұят.
Dialogue: 0,0:07:53.70,0:07:54.64,JPN,,0,0,0,,Мен келісемін.
Dialogue: 0,0:07:55.12,0:07:57.13,JPN,,0,0,0,,Соның ішінде сізді.
Dialogue: 0,0:07:57.56,0:08:00.11,JPN,,0,0,0,,Бізге жасыру керек болды ма?
Dialogue: 0,0:08:00.26,0:08:04.05,JPN,,0,0,0,,Ең болмаса қоштасқым келді.
Dialogue: 0,0:08:04.50,0:08:07.12,JPN,,0,0,0,,Егер мен сені кездестірсем, мен сені маған назар аударамын.
Dialogue: 0,0:08:18.20,0:08:20.97,JPN,,0,0,0,,Менің біраз уақытым бар.
Dialogue: 0,0:08:22.85,0:08:23.45,JPN,,0,0,0,,Жарайды
Dialogue: 0,0:08:23.81,0:08:25.82,JPN,,0,0,0,,Бір жерге көңіл көтеру үшін барайық.
Dialogue: 0,0:08:26.44,0:08:27.76,JPN,,0,0,0,,Исла барғысы келетін жер бар ма?
Dialogue: 0,0:08:28.38,0:08:29.16,JPN,,0,0,0,,Цукаса ше?
Dialogue: 0,0:08:31.66,0:08:32.85,JPN,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:35.94,0:08:38.93,JPN,,0,0,0,,Олай болса, бірге айтайық.
Dialogue: 0,0:08:39.30,0:08:42.08,JPN,,0,0,0,,Сонымен, егер бізде бірдей пікір болса, онда бару керек.
Dialogue: 0,0:08:43.33,0:08:43.77,JPN,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:08:44.42,0:08:45.50,JPN,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:08:45.81,0:08:46.75,JPN,,0,0,0,,Ойын-сауық саябағы!
Dialogue: 0,0:09:42.86,0:09:44.14,JPN,,0,0,0,,Исла да барса ше?
Dialogue: 0,0:09:45.00,0:09:48.11,JPN,,0,0,0,,Уау, мен онымен жақсымын.
Dialogue: 0,0:09:48.38,0:09:50.02,JPN,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:09:53.47,0:09:54.13,JPN,,0,0,0,,Қараңыз
Dialogue: 0,0:10:30.74,0:10:31.44,JPN,,0,0,0,,Цукаса?
Dialogue: 0,0:10:33.97,0:10:34.85,JPN,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:10:36.38,0:10:37.38,JPN,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:10:37.68,0:10:39.91,JPN,,0,0,0,,Ал, ары қарай жалғастырайық.
Dialogue: 0,0:10:40.10,0:10:43.40,JPN,,0,0,0,,Мен барлық аттракциондарға бармайынша тоқтамаймын.
Dialogue: 0,0:10:43.60,0:10:44.62,JPN,,0,0,0,,О, және
Dialogue: 0,0:10:44.80,0:10:47.32,JPN,,0,0,0,,Азық-түлік дүкендеріндегі барлық тәттілерді жеңу керек.
Dialogue: 0,0:10:47.88,0:10:50.60,JPN,,0,0,0,,Қолымыздан келгеннің бәрін жасайық
Dialogue: 0,0:10:50.97,0:10:52.00,JPN,,0,0,0,,О
Dialogue: 0,0:10:58.53,0:10:59.33,JPN,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:10:59.76,0:11:01.01,JPN,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:11:01.41,0:11:03.12,JPN,,0,0,0,,Денсаулығың мықты болса, тоқ боласың.
Dialogue: 0,0:11:03.62,0:11:05.33,JPN,,0,0,0,,Исла жақсы ма?
Dialogue: 0,0:11:05.64,0:11:06.34,JPN,,0,0,0,,Шаршаған жоқсың ба?
Dialogue: 0,0:11:06.89,0:11:07.64,JPN,,0,0,0,,Мен жақсымын
Dialogue: 0,0:11:08.14,0:11:09.83,JPN,,0,0,0,,Өйткені Цукаса әрқашан менімен бірге болды
Dialogue: 0,0:11:10.53,0:11:14.08,JPN,,0,0,0,,Бұл жолы қызуым көтеріліп, жолда құлап қалмаймын.
Dialogue: 0,0:11:14.17,0:11:15.05,JPN,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:11:22.39,0:11:23.96,JPN,,0,0,0,,Барлығы күледі
Dialogue: 0,0:11:24.64,0:11:30.21,JPN,,0,0,0,,Исла бұған дейін мұндағы адамдардың күлкісін көргенді ұнататынын айтқан.
Dialogue: 0,0:11:31.03,0:11:31.42,JPN,,0,0,0,,Иә
Dialogue: 0,0:11:32.12,0:11:36.29,JPN,,0,0,0,,Оның мимикасы күндіз де, кеште де, түнде де әртүрлі.
Dialogue: 0,0:11:37.00,0:11:38.05,JPN,,0,0,0,,Түскі ас кезінде
Dialogue: 0,0:11:38.38,0:11:40.74,JPN,,0,0,0,,Барлығының шаттанған күлкілері
Dialogue: 0,0:11:42.89,0:11:44.96,JPN,,0,0,0,,Кешке жақын болған кезде
Dialogue: 0,0:11:45.29,0:11:48.08,JPN,,0,0,0,,Бірте-бірте қобалжи бастадым.
Dialogue: 0,0:11:48.85,0:11:51.13,JPN,,0,0,0,,Сонымен, қазір қанша уақытыңыз бар?
Dialogue: 0,0:11:52.77,0:11:54.50,JPN,,0,0,0,,Кішкене жалғызсырап көрінеді
Dialogue: 0,0:11:58.82,0:11:59.56,JPN,,0,0,0,,Бірақ
Dialogue: 0,0:12:00.22,0:12:01.32,JPN,,0,0,0,,Бұл жалғыздық сияқты
Dialogue: 0,0:12:01.81,0:12:04.68,JPN,,0,0,0,,Көптеген адамдар өте риза күлкіге ие.
Dialogue: 0,0:12:05.62,0:12:09.21,JPN,,0,0,0,,Мен өзіммен бірге бақытты естеліктерді қайтара аламын.
Dialogue: 0,0:12:10.77,0:12:11.36,JPN,,0,0,0,,Ира…
Dialogue: 0,0:12:12.71,0:12:15.21,JPN_Up,,0,0,0,,Жақында жабылатын уақыт болады.
Dialogue: 0,0:12:16.77,0:12:21.03,JPN_Up,,0,0,0,,Біз сізді тағы да күтеміз.
Dialogue: 0,0:12:22.24,0:12:24.74,JPN_Up,,0,0,0,,Бізге келгеніңіз үшін рахмет.
Dialogue: 0,0:12:36.33,0:12:38.90,JPN,,0,0,0,,Цукаса Жабу уақыты.
Dialogue: 0,0:12:41.05,0:12:42.93,JPN,,0,0,0,,Жақында жабылады
Dialogue: 0,0:12:48.36,0:12:48.91,JPN,,0,0,0,,Кеттік
Dialogue: 0,0:12:51.13,0:12:52.63,JPN,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:13:00.34,0:13:01.43,JPN,,0,0,0,,Рұқсат берілді
Dialogue: 0,0:13:01.91,0:13:02.58,JPN,,0,0,0,,Рұқсат?
Dialogue: 0,0:13:02.76,0:13:03.76,JPN,,0,0,0,,Мінуге болатынын айту
Dialogue: 0,0:13:04.10,0:13:06.93,JPN,,0,0,0,,Мен саябақты аралап жүріп, жабылатын уақытта жүгіріп шықтым.
Dialogue: 0,0:13:07.32,0:13:08.52,JPN,,0,0,0,,Ол мені күтетінін айтты.
Dialogue: 0,0:13:12.80,0:13:14.66,JPN,,0,0,0,,Мен Цукасамен бірге мінгім келеді
Dialogue: 0,0:13:30.54,0:13:33.32,JPN,,0,0,0,,Танысқанымызға көп уақыт болды.
Dialogue: 0,0:13:37.38,0:13:39.46,JPN,,0,0,0,,Цукасамен көбірек
Dialogue: 0,0:13:39.86,0:13:42.32,JPN,,0,0,0,,Мен көп көңіл көтергім келді.
Dialogue: 0,0:13:44.12,0:13:44.57,JPN,,0,0,0,,Иә
Dialogue: 0,0:13:45.53,0:13:46.45,JPN,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:47.41,0:13:51.96,JPN,,0,0,0,,Бұдан былай Цукаса мен білмейтін уақытты өткізеді.
Dialogue: 0,0:13:53.42,0:13:54.96,JPN,,0,0,0,,Иә...дұрыс.
Dialogue: 0,0:13:56.09,0:13:58.74,JPN,,0,0,0,,Цукаса болашақта не істейді деп ойлаймын.
Dialogue: 0,0:13:59.32,0:14:02.00,JPN,,0,0,0,,Қызық, ол Terminal Services-те жұмысын жалғастыра ма?
Dialogue: 0,0:14:03.21,0:14:04.71,JPN,,0,0,0,,Иә...дұрыс.
Dialogue: 0,0:14:06.71,0:14:08.46,JPN,,0,0,0,,Бірақ бұл терезе бөлімі.
Dialogue: 0,0:14:08.71,0:14:11.01,JPN,,0,0,0,,Шығындарды азайту үшін таратылуы мүмкін
Dialogue: 0,0:14:12.01,0:14:12.98,JPN,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:13.70,0:14:15.60,JPN,,0,0,0,,Бірақ Цукаса жақсы.
Dialogue: 0,0:14:16.08,0:14:17.77,JPN,,0,0,0,,Қайда барсам да дұрыс істей аламын.
Dialogue: 0,0:14:18.27,0:14:19.51,JPN,,0,0,0,,Мен кепілдік беремін
Dialogue: 0,0:14:20.44,0:14:21.61,JPN,,0,0,0,,Дұрыс...
Dialogue: 0,0:14:26.01,0:14:31.64,JPN,,0,0,0,,Мүмкін Цукаса бірнеше жылдан кейін жаңа ғашығы болады.
Dialogue: 0,0:14:36.36,0:14:37.35,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:38.24,0:14:40.42,JPN,,0,0,0,,Бұл дөрекі болды
Dialogue: 0,0:14:41.36,0:14:42.33,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:14:47.21,0:14:50.64,JPN,,0,0,0,,Эй Цукаса, саған менің не ұнайды?
Dialogue: 0,0:14:53.51,0:14:57.25,JPN,,0,0,0,,Цукасаның маған ұнайтын тұстары өте көп.
Dialogue: 0,0:14:57.93,0:14:58.72,JPN,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:15:00.68,0:15:03.41,JPN,,0,0,0,,Әрқашан нұсқаулықты дұрыс оқып шығыңыз
Dialogue: 0,0:15:04.78,0:15:05.14,JPN,,0,0,0,,Иә
Dialogue: 0,0:15:05.53,0:15:07.19,JPN,,0,0,0,,Себебі мен саған бір нәрсені үйреттім.
Dialogue: 0,0:15:07.41,0:15:08.69,JPN,,0,0,0,,Келесі кезекте Цукаса
Dialogue: 0,0:15:09.69,0:15:11.21,JPN,,0,0,0,,Менің айтпағым сол емес еді—
Dialogue: 0,0:15:14.26,0:15:17.77,JPN,,0,0,0,,Мен құлайын деп ойлаймын...
Dialogue: 0,0:15:19.69,0:15:21.45,JPN,,0,0,0,,Онда мен келесі боламын...
Dialogue: 0,0:15:23.17,0:15:24.64,JPN,,0,0,0,,Әдемі қолжазба
Dialogue: 0,0:15:25.48,0:15:25.88,JPN,,0,0,0,,Иә
Dialogue: 0,0:15:27.27,0:15:28.78,JPN,,0,0,0,,Елеусіздік
Dialogue: 0,0:15:29.32,0:15:31.30,JPN,,0,0,0,,Омлет күрішінің маған ұнайтыны
Dialogue: 0,0:15:32.23,0:15:33.92,JPN,,0,0,0,,Шағын биіктік
Dialogue: 0,0:15:34.87,0:15:36.96,JPN,,0,0,0,,Мен үнемі сынға ұшырағандай сезінемін.
Dialogue: 0,0:15:38.00,0:15:40.47,JPN,,0,0,0,,Бұл маған ұнайды, солай ма?
Dialogue: 0,0:15:44.60,0:15:47.20,JPN,,0,0,0,,Шайды дәмді ішетін жер
Dialogue: 0,0:15:48.54,0:15:51.78,JPN,,0,0,0,,Себебі Исла шай қайнатады.
Dialogue: 0,0:15:52.93,0:15:55.25,JPN,,0,0,0,,Қолдар таңқаларлық үлкен
Dialogue: 0,0:15:56.41,0:15:57.60,JPN,,0,0,0,,Қорқынышты жерлер
Dialogue: 0,0:15:58.46,0:16:00.48,JPN,,0,0,0,,Ауырса да жыламауға тырысыңыз
Dialogue: 0,0:16:00.97,0:16:02.92,JPN,,0,0,0,,Күлімсіреуге тырысу
Dialogue: 0,0:16:06.42,0:16:08.50,JPN,,0,0,0,,Мұндай күлімсіреу керемет
Dialogue: 0,0:16:09.24,0:16:12.43,JPN,,0,0,0,,Бірақ... Мен аздап уайымдап тұрмын.
Dialogue: 0,0:16:14.77,0:16:15.50,JPN,,0,0,0,,Ира…
Dialogue: 0,0:16:23.89,0:16:25.23,JPN,,0,0,0,,Мен бақытты болдым
Dialogue: 0,0:16:30.58,0:16:32.09,JPN,,0,0,0,,Сәлем Цукаса
Dialogue: 0,0:16:32.80,0:16:35.92,JPN,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:16:41.78,0:16:45.89,JPN,,0,0,0,,Өйткені армандардың уақыты аяқталуға жақын
Dialogue: 0,0:16:51.09,0:16:53.77,JPN,,0,0,0,,Бұл соңғы орын.
Dialogue: 0,0:16:55.17,0:16:57.14,JPN,,0,0,0,,Доңғалақ айналмай тұрып
Dialogue: 0,0:16:58.50,0:16:58.88,JPN,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:17:14.30,0:17:15.02,JPN,,0,0,0,,Ира
Dialogue: 0,0:17:16.78,0:17:17.40,JPN,,0,0,0,,Мен...
Dialogue: 0,0:17:19.85,0:17:22.98,JPN,,0,0,0,,Сен маған алғаш рет жылаған жүзіңді көрсеттің.
Dialogue: 0,0:17:24.63,0:17:27.08,JPN,,0,0,0,,Мен көптен бері ұстадым.
Dialogue: 0,0:17:30.39,0:17:33.25,JPN,,0,0,0,,Цукаса сабырлы адам.
Dialogue: 0,0:17:40.55,0:17:41.43,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:17:42.45,0:17:44.41,JPN,,0,0,0,,Мен үшін жылағаны үшін
Dialogue: 0,0:17:45.24,0:17:46.02,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:18:22.43,0:18:23.69,JPN,,0,0,0,,Жақын адамдармен
Dialogue: 0,0:18:24.28,0:18:27.15,JPN,,0,0,0,,Бір күні тағы кездесерміз деп үміттенемін
Dialogue: 0,0:18:28.60,0:18:29.05,JPN,,0,0,0,,Иә
Dialogue: 0,0:19:01.88,0:19:03.77,JPN,,0,0,0,,Сіз сабырлы көрінесіз, солай емес пе?
Dialogue: 0,0:19:05.40,0:19:05.85,JPN,,0,0,0,,Иә
Dialogue: 0,0:19:09.21,0:19:11.69,JPN,,0,0,0,,Соңына дейін бар күшіңді салдың.
Dialogue: 0,0:19:18.22,0:19:19.94,JPN,,0,0,0,,Сіз мұны оқыған кезде
Dialogue: 0,0:19:20.47,0:19:23.64,JPN,,0,0,0,,Мен ұйықтап жатырмын деп ойлаймын
Dialogue: 0,0:19:24.92,0:19:25.65,JPN,,0,0,0,,Оны түсініп-ақ болмайды.
Dialogue: 0,0:19:26.18,0:19:29.68,JPN,,0,0,0,,Терминал қызметінің міндеті - естеліктерді жырту.
Dialogue: 0,0:19:30.13,0:19:31.40,JPN,,0,0,0,,Ешқашан марапатталмаған
Dialogue: 0,0:19:31.82,0:19:34.50,JPN,,0,0,0,,Мен алғыс айтуға лайық емес деп ойладым.
Dialogue: 0,0:19:35.43,0:19:36.28,JPN,,0,0,0,,Және де
Dialogue: 0,0:19:36.70,0:19:39.81,JPN,,0,0,0,,Маған рахмет айтатындар аз емес.
Dialogue: 0,0:19:40.06,0:19:41.41,JPN,,0,0,0,,Бұл біртүрлі болды.
Dialogue: 0,0:19:42.20,0:19:45.30,JPN,,0,0,0,,Менің соңыма келгенде
Dialogue: 0,0:19:45.81,0:19:48.03,JPN,,0,0,0,,Мен ақыры түсінгендей болдым.
Dialogue: 0,0:19:49.13,0:19:52.51,JPN,,0,0,0,,Себебі барлығы 1-терминал қызметінде
Dialogue: 0,0:19:53.03,0:19:54.92,JPN,,0,0,0,,Сен сондай мейірімдісің, жылағым келеді
Dialogue: 0,0:19:55.42,0:19:56.98,JPN,,0,0,0,,Өйткені олар тамаша адамдар.
Dialogue: 0,0:19:58.36,0:20:01.63,JPN,,0,0,0,,Өйткені ол маған көп жұмыс істейді.
Dialogue: 0,0:20:02.77,0:20:05.41,JPN,,0,0,0,,Алғыс сөздері өздігінен келеді.
Dialogue: 0,0:20:06.42,0:20:09.92,JPN,,0,0,0,,Мен мұнда барлығымен осылай жұмыс істегеніме қуаныштымын.
Dialogue: 0,0:20:11.04,0:20:15.14,JPN,,0,0,0,,Мен Терминал қызметтерінде жұмыс істегенімді мақтан тұтамын.
Dialogue: 0,0:20:16.70,0:20:17.39,JPN,,0,0,0,,Казуки
Dialogue: 0,0:20:18.08,0:20:20.18,JPN,,0,0,0,,Мен сіздермен алты жыл жұмыс істей алдым.
Dialogue: 0,0:20:20.65,0:20:22.99,JPN,,0,0,0,,Мен үшін де қымбат естелік.
Dialogue: 0,0:20:24.50,0:20:25.29,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:20:26.05,0:20:28.92,JPN,,0,0,0,,Мен сені кездестіргеніме қуаныштымын.
Dialogue: 0,0:20:31.76,0:20:32.58,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:20:34.09,0:20:37.05,JPN,,0,0,0,,Барлығына рахмет
Dialogue: 0,0:22:14.84,0:22:20.14,JPN,,0,0,0,,Өміріңіздің уақыты алдын ала белгіленген болса ше?
Dialogue: 0,0:22:21.24,0:22:23.57,JPN,,0,0,0,,Мен оны қалай қабылдаймын?
Dialogue: 0,0:22:27.68,0:22:33.66,JPN,,0,0,0,,Менің ойымша, мен сол шектеулі уақытта толық өмір сүремін.
Dialogue: 0,0:23:13.36,0:23:16.22,JPN,,0,0,0,,Ол жақта жаттығу қалай өтті?
Dialogue: 0,0:23:16.50,0:23:18.60,JPN,,0,0,0,,Иә, мен көп нәрсені үйрендім.
Dialogue: 0,0:23:19.01,0:23:20.81,JPN,,0,0,0,,Тоғыз ай?
Dialogue: 0,0:23:21.01,0:23:23.02,JPN,,0,0,0,,Бұл өте тез өтті.
Dialogue: 0,0:23:23.37,0:23:25.68,JPN,,0,0,0,,Мен бұдан былай тағы да осында боламын.
Dialogue: 0,0:23:25.91,0:23:26.97,JPN,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:23:41.00,0:23:42.65,JPN,,0,0,0,,О, сәл жақсы болды.
Dialogue: 0,0:23:43.10,0:23:43.78,JPN,,0,0,0,,Кіріспе
Dialogue: 0,0:23:44.46,0:23:48.14,JPN,,0,0,0,,Цукаса Бұл сіздің жаңа серіктесіңіз.
Dialogue: 0,0:23:53.80,0:23:54.42,JPN,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:23:55.92,0:24:01.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
