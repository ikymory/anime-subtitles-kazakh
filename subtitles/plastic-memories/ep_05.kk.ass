Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.36,0:00:03.94,OPJP,,0,0,0,,Жарықты жинау
Dialogue: 0,0:00:11.95,0:00:16.45,OPJP,,0,0,0,,Қоштасудан естеліктер
Dialogue: 0,0:00:17.54,0:00:23.63,OPJP,,0,0,0,,Көзіме тамсанып, алысқа қадалған арман
Dialogue: 0,0:00:23.80,0:00:29.05,OPJP,,0,0,0,,Ән жады бұзылады
Dialogue: 0,0:00:29.34,0:00:34.43,OPJP,,0,0,0,,Жалғыздықтың көз жасын ақырын сүртейік
Dialogue: 0,0:00:34.72,0:00:41.65,OPJP,,0,0,0,,Ұзартылған қол - айналмалы дөңгелек, оны абайлап алыңыз
Dialogue: 0,0:00:41.94,0:00:46.94,OPJP,,0,0,0,,Оянғалы тұрған жадының үзінділері
Dialogue: 0,0:00:47.94,0:00:52.82,OPJP,,0,0,0,,Мен төмен қарап, жоқ болып кетсін деп дұға етемін, бірақ
Dialogue: 0,0:00:52.95,0:00:58.96,OPJP,,0,0,0,,Бұл сіз тапқан дауыс
Dialogue: 0,0:00:59.25,0:01:05.92,OPJP,,0,0,0,,Сағат тілі қозғала бастайды, көп ұзамай дүниенің түсі өзгереді
Dialogue: 0,0:01:06.25,0:01:12.14,OPJP,,0,0,0,,Менің пластикалық жүрегім жарқырайды
Dialogue: 0,0:01:12.43,0:01:17.06,OPJP,,0,0,0,,Ұмытпа, есте сақта
Dialogue: 0,0:01:17.43,0:01:23.94,OPJP,,0,0,0,,Бір күні тағы кездескенше
Dialogue: 0,0:22:45.10,0:22:48.44,EDJP,,0,0,0,,Ажырасқан сені іздедім.
Dialogue: 0,0:22:48.70,0:22:52.20,EDJP,,0,0,0,,Мені шақырған дауыс өшіп қалды
Dialogue: 0,0:22:52.40,0:22:59.80,EDJP,,0,0,0,,Мен ұстаған қол дірілдеп тұрды.
Dialogue: 0,0:23:00.28,0:23:03.80,EDJP,,0,0,0,,Біздің сезімдер
Dialogue: 0,0:23:04.00,0:23:09.00,EDJP,,0,0,0,,Қайтаруға болмайтын уақытты қабыл алыңыз
Dialogue: 0,0:23:09.21,0:23:13.71,EDJP,,0,0,0,,Мен биік ұшамын
Dialogue: 0,0:23:14.51,0:23:18.10,EDJP,,0,0,0,,Аспанда жарқыраған калейдоскоп
Dialogue: 0,0:23:18.30,0:23:22.10,EDJP,,0,0,0,,Сіз ыңғайсызданып күлдіңіз
Dialogue: 0,0:23:22.41,0:23:28.10,EDJP,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:23:29.30,0:23:32.86,EDJP,,0,0,0,,Жарық ерігенге дейін
Dialogue: 0,0:23:33.00,0:23:36.00,EDJP,,0,0,0,,Мен шын жүректен үміттенемін
Dialogue: 0,0:23:36.20,0:23:48.20,EDJP,,0,0,0,,Осы сәтті ұмытпа
Dialogue: 0,0:01:34.10,0:01:36.13,JPN,,0,0,0,,Мен аздап көп сатып алдым деп ойлаймын.
Dialogue: 0,0:01:37.41,0:01:40.37,JPN,,0,0,0,,Бірақ ертең Соутамен соңғы рет болады.
Dialogue: 0,0:01:42.29,0:01:43.91,JPN,,0,0,0,,Уау, бұл ұзақ болды
Dialogue: 0,0:01:44.42,0:01:45.65,JPN,,0,0,0,,Мен үйге асығуым керек.
Dialogue: 0,0:02:04.41,0:02:05.34,JPN,,0,0,0,,Сәлем Сута-кун
Dialogue: 0,0:02:05.99,0:02:06.69,JPN,,0,0,0,,Не болды?
Dialogue: 0,0:02:07.16,0:02:09.36,JPN,,0,0,0,,А, Маша қалай?
Dialogue: 0,0:02:11.03,0:02:11.77,JPN,,0,0,0,,Сота-кун?
Dialogue: 0,0:02:13.65,0:02:15.52,JPN,,0,0,0,,Марсия қайтып келмейді.
Dialogue: 0,0:02:20.61,0:02:22.71,JPN,,0,0,0,,Мен SAI компаниясынанмын.
Dialogue: 0,0:02:23.01,0:02:24.71,JPN,,0,0,0,,Марсия үйде ме?
Dialogue: 0,0:02:25.28,0:02:27.84,JPN,,0,0,0,,Мен жаңа ғана дүкен аралауға шықтым.
Dialogue: 0,0:02:28.07,0:02:29.26,JPN,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:02:29.43,0:02:33.10,JPN,,0,0,0,,Менің қайда дүкен аралағанымды білесің бе?
Dialogue: 0,0:02:42.73,0:02:44.57,JPN,,0,0,0,,Қара коллекционер болу мүмкіндігі...
Dialogue: 0,0:02:46.69,0:02:49.94,JPN,,0,0,0,,Марсияның өмір сүру ұзақтығына шамамен 24 сағат қалды
Dialogue: 0,0:02:50.39,0:02:51.37,JPN,,0,0,0,,Осыдан кейін
Dialogue: 0,0:02:52.21,0:02:55.70,JPN,,0,0,0,,Ей, ол қарт Цукаса мен оның достарының танысы болуы керек.
Dialogue: 0,0:02:56.07,0:02:58.10,JPN,,0,0,0,,Маған хабарласып, Марсияны әкел.
Dialogue: 0,0:03:00.39,0:03:01.21,JPN,,0,0,0,,Бұл...
Dialogue: 0,0:03:01.54,0:03:02.16,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:03:08.55,0:03:09.17,JPN,,0,0,0,,Сота-кун
Dialogue: 0,0:03:09.92,0:03:12.12,JPN,,0,0,0,,Әлгі қария сені алдады.
Dialogue: 0,0:03:12.45,0:03:14.36,JPN,,0,0,0,,Мүмкін ол Марсияны алып кеткен шығар.
Dialogue: 0,0:03:15.33,0:03:15.82,JPN,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:03:16.26,0:03:16.92,JPN,,0,0,0,,Жарайды
Dialogue: 0,0:03:17.42,0:03:19.42,JPN,,0,0,0,,Маша-санды өзіміз табыңыз.
Dialogue: 0,0:03:19.73,0:03:20.60,JPN,,0,0,0,,Мені қайтар
Dialogue: 0,0:03:21.72,0:03:23.91,JPN,,0,0,0,,Сондықтан мен сенің осында күтуіңді қалаймын.
Dialogue: 0,0:03:26.31,0:03:29.44,JPN,,0,0,0,,Менімен бір қараңғы коллекционер хабарласқанына күмән жоқ сияқты.
Dialogue: 0,0:03:29.91,0:03:30.61,JPN,,0,0,0,,Түсіндім
Dialogue: 0,0:03:31.10,0:03:33.27,JPN,,0,0,0,,Әйтеуір, бөлініп, Марсияны іздейік.
Dialogue: 0,0:03:33.67,0:03:35.72,JPN,,0,0,0,,Жарайды, әлі уақыт бар.
Dialogue: 0,0:03:36.13,0:03:36.73,JPN,,0,0,0,,Иә
Dialogue: 0,0:03:37.90,0:03:40.02,JPN,,0,0,0,,Егер сіз саяхатшы болсаңыз
Dialogue: 0,0:03:40.34,0:03:41.68,JPN,,0,0,0,,3 жыл болды ма?
Dialogue: 0,0:03:41.97,0:03:43.97,JPN,,0,0,0,,Бұл әлі шешілген жоқ.
Dialogue: 0,0:03:44.32,0:03:45.36,JPN,,0,0,0,,Бейқам сөздерді айтпа
Dialogue: 0,0:03:45.92,0:03:47.17,JPN,,0,0,0,,Міне
Dialogue: 0,0:03:47.33,0:03:50.50,JPN,,0,0,0,,Өйткені, менеджерге хабарласу керек.
Dialogue: 0,0:03:50.69,0:03:52.17,JPN,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:03:53.77,0:03:54.70,JPN,,0,0,0,,Директор Годо
Dialogue: 0,0:03:55.60,0:03:58.99,JPN,,0,0,0,,1-терминалдың қызмет көрсету бөлімінің менеджері Ямабе мырза бізге хабарласты.
Dialogue: 0,0:04:00.26,0:04:02.47,JPN,,0,0,0,,Менеджер, шын мәнінде.
Dialogue: 0,0:04:02.79,0:04:05.04,JPN,,0,0,0,,Сәл күрделі жағдай
Dialogue: 0,0:04:05.82,0:04:06.41,JPN,,0,0,0,,Не?
Dialogue: 0,0:04:06.58,0:04:12.06,JPN,,0,0,0,,Инкассация нысанын қараңғы коллекторлық агенттік алып кеткен сияқты.
Dialogue: 0,0:04:12.26,0:04:14.69,JPN,,0,0,0,,Мен сізбен байланыса алмаймын дедім.
Dialogue: 0,0:04:14.69,0:04:16.21,JPN,,0,0,0,,Сыйлықтардың өмір сүру ұзақтығы қандай?
Dialogue: 0,0:04:16.90,0:04:19.45,JPN,,0,0,0,,Ал, ертең 13:00.
Dialogue: 0,0:04:20.15,0:04:22.95,JPN,,0,0,0,,R.SECURITY нөміріне қоңырау шалыңыз. Бұл шұғыл.
Dialogue: 0,0:04:23.45,0:04:24.34,JPN,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:04:24.70,0:04:26.53,JPN,,0,0,0,,Балалар, іздеуді жалғастырыңдар.
Dialogue: 0,0:04:27.09,0:04:28.53,JPN,,0,0,0,,Мұнда да әрекет жасаңыз.
Dialogue: 0,0:04:29.13,0:04:29.80,JPN,,0,0,0,,Иә
Dialogue: 0,0:04:38.37,0:04:40.33,JPN,,0,0,0,,Жоқ, бұл еш жерде емес.
Dialogue: 0,0:04:42.66,0:04:44.90,JPN,,0,0,0,,Егер мен оны осылай таба алмасам
Dialogue: 0,0:04:47.40,0:04:50.96,JPN,,0,0,0,,Іздеген жерлерді тағы бір рет айналып өту керек.
Dialogue: 0,0:04:51.82,0:04:52.88,JPN,,0,0,0,,Сабырмен іздеңіз
Dialogue: 0,0:04:54.88,0:04:58.50,JPN,,0,0,0,,Негізі, мен Мичируден естіген әңгімені ойымнан шығара алмаймын.
Dialogue: 0,0:04:59.17,0:05:01.46,JPN,,0,0,0,,Исла Уандерер туралы қаншалықты біледі?
Dialogue: 0,0:05:02.72,0:05:04.79,JPN,,0,0,0,,Саяхатшы болу – сирек кездесетін жағдай.
Dialogue: 0,0:05:05.46,0:05:07.65,JPN,,0,0,0,,Тіпті Марсия да әрқашан солай бола бермейді.
Dialogue: 0,0:05:08.41,0:05:11.62,JPN,,0,0,0,,Ендеше, қазір теріс ойламаған дұрыс.
Dialogue: 0,0:05:15.24,0:05:16.79,JPN,,0,0,0,,Иә, рахмет
Dialogue: 0,0:05:17.14,0:05:17.86,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:05:19.03,0:05:20.26,JPN,,0,0,0,,Ол қалай табылды?
Dialogue: 0,0:05:20.68,0:05:21.72,JPN,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:05:22.26,0:05:22.86,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:23.41,0:05:25.09,JPN,,0,0,0,,Содан кейін біз сол жерден іздейміз.
Dialogue: 0,0:06:11.41,0:06:13.37,JPN,,0,0,0,,Кешеден бері ұйықтамадың.
Dialogue: 0,0:06:13.60,0:06:15.24,JPN,,0,0,0,,Мен сізге үзіліс жасаңыз дедім.
Dialogue: 0,0:06:15.60,0:06:17.85,JPN,,0,0,0,,Жоқ, менде бәрі жақсы.
Dialogue: 0,0:06:18.00,0:06:19.96,JPN,,0,0,0,,Жарайсың, бірақ Исла...
Dialogue: 0,0:06:22.32,0:06:23.66,JPN,,0,0,0,,Мен де жақсымын.
Dialogue: 0,0:06:26.18,0:06:27.80,JPN,,0,0,0,,О, мен мұны қалаймын
Dialogue: 0,0:06:27.99,0:06:30.07,JPN,,0,0,0,,Сонда сіз қайда барасыз?
Dialogue: 0,0:06:30.62,0:06:31.96,JPN,,0,0,0,,Кейбір айғақтардан
Dialogue: 0,0:06:32.34,0:06:36.50,JPN,,0,0,0,,Алда қараңғы қалпына келтіру цехының дәмі бар болуы ықтималдығы жоғары болып шықты.
Dialogue: 0,0:06:36.81,0:06:38.18,JPN,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:38.53,0:06:39.74,JPN,,0,0,0,,Соңында анықтама
Dialogue: 0,0:06:40.15,0:06:42.78,JPN,,0,0,0,,Қолданылатын орындардың ауқымы өте кең.
Dialogue: 0,0:06:43.17,0:06:45.18,JPN,,0,0,0,,Дегенмен, бұл кеңес бермегеннен жақсы.
Dialogue: 0,0:06:50.38,0:06:52.26,JPN,,0,0,0,,Бұл аймақ қазір құлыптаулы.
Dialogue: 0,0:06:52.77,0:06:53.77,JPN,,0,0,0,,Айналмалы жолмен жүріңіз
Dialogue: 0,0:06:54.21,0:06:55.61,JPN,,0,0,0,,R. ҚАУІПСІЗДІК?
Dialogue: 0,0:06:56.02,0:06:57.80,JPN,,0,0,0,,Өйткені, іссапармен келдің ғой.
Dialogue: 0,0:06:58.41,0:06:59.53,JPN,,0,0,0,,R. ҚАУІПСІЗДІК?
Dialogue: 0,0:07:00.04,0:07:03.96,JPN,,0,0,0,,Біздің компаниямен іскерлік одақтастығы бар жеке қауіпсіздік компаниясы
Dialogue: 0,0:07:04.38,0:07:06.14,JPN,,0,0,0,,Құлыпта болу деген нені білдіреді?
Dialogue: 0,0:07:06.54,0:07:08.47,JPN,,0,0,0,,Сізде ондай өкілеттік жоқ.
Dialogue: 0,0:07:08.88,0:07:10.29,JPN,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:07:10.70,0:07:12.17,JPN,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:07:12.39,0:07:14.97,JPN,,0,0,0,,Бірақ менің де кейінірек істейтін жұмысым бар.
Dialogue: 0,0:07:15.22,0:07:18.10,JPN,,0,0,0,,Егер сіз оны шынымен өткізбесеңіз, жауапты адамды жіберіңіз.
Dialogue: 0,0:07:18.19,0:07:20.86,JPN,,0,0,0,,Казуки: Келіссөздерді бейбіт түрде жүргізген дұрыс.
Dialogue: 0,0:07:21.27,0:07:22.69,JPN,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,0:07:28.12,0:07:31.79,JPN,,0,0,0,,Мен сені қайта көретініме сене алар емеспін. 3 жыл болды.
Dialogue: 0,0:07:32.19,0:07:35.39,JPN,,0,0,0,,Сіз біршама жоғарылаған сияқтысыз, Шиноно-сан.
Dialogue: 0,0:07:35.92,0:07:37.20,JPN,,0,0,0,,Шиноном.
Dialogue: 0,0:07:37.75,0:07:41.84,JPN,,0,0,0,,Сонымен, сіз сол кездегідей себеппен іссапарға келдіңіз бе?
Dialogue: 0,0:07:42.29,0:07:43.51,JPN,,0,0,0,,Ал сендерге келсек, капитан Леви міндетті түрде
Dialogue: 0,0:07:46.28,0:07:47.97,JPN,,0,0,0,,Қорқынышты бет жасама
Dialogue: 0,0:07:48.22,0:07:52.34,JPN,,0,0,0,,Біздің мақсатымыз - қара коллекционерлерді ұстау.
Dialogue: 0,0:07:52.92,0:07:55.51,JPN,,0,0,0,,Мені алып кеткен Гидидия қызықтырмайды.
Dialogue: 0,0:07:56.02,0:07:57.25,JPN,,0,0,0,,Әзірге
Dialogue: 0,0:07:58.08,0:07:59.29,JPN,,0,0,0,,О, түсіндім.
Dialogue: 0,0:07:59.42,0:08:01.98,JPN,,0,0,0,,Сонымен, сізде қандай ақпарат бар?
Dialogue: 0,0:08:02.68,0:08:03.98,JPN,,0,0,0,,Мен айтамын деп ойлайсың ба?
Dialogue: 0,0:08:04.50,0:08:06.47,JPN,,0,0,0,,Біз қайырымдылықпен айналыспаймыз.
Dialogue: 0,0:08:06.62,0:08:08.37,JPN,,0,0,0,,Олай айтпа
Dialogue: 0,0:08:08.58,0:08:12.49,JPN,,0,0,0,,Заттарды қалай өңдеуге байланысты өткенді жууға болады.
Dialogue: 0,0:08:16.29,0:08:17.10,JPN,,0,0,0,,Маған картаны беріңіз
Dialogue: 0,0:08:17.62,0:08:18.29,JPN,,0,0,0,,Дегенмен
Dialogue: 0,0:08:18.40,0:08:19.19,JPN,,0,0,0,,Уа!!
Dialogue: 0,0:08:20.07,0:08:21.77,JPN,,0,0,0,,Сен жақсы жігіт емессің бе?
Dialogue: 0,0:08:22.21,0:08:24.15,JPN,,0,0,0,,Мен осылайша жоғарыладым.
Dialogue: 0,0:08:24.61,0:08:25.81,JPN,,0,0,0,,«Алдау?» Оны алдау үшін не істемексің?
Dialogue: 0,0:08:27.33,0:08:29.82,JPN,,0,0,0,,Ақпараттық желіні пайдалану
Dialogue: 0,0:08:29.95,0:08:32.92,JPN,,0,0,0,,Мен қараңғы коллектордың жасырынатын жерін болжадым.
Dialogue: 0,0:08:33.20,0:08:34.69,JPN,,0,0,0,,Бұл аймақтың бәрі осы.
Dialogue: 0,0:08:35.52,0:08:37.95,JPN,,0,0,0,,Ол қазір ешкім кіре немесе шыға алмайтындай етіп жабылған.
Dialogue: 0,0:08:38.34,0:08:40.41,JPN,,0,0,0,,Мұндағы ақпаратқа шамамен сәйкес келеді.
Dialogue: 0,0:08:40.72,0:08:43.23,JPN,,0,0,0,,Бұл Марсияның да бар екенін білдіре ме?
Dialogue: 0,0:08:43.45,0:08:46.98,JPN,,0,0,0,,Эй, сіз Giftia-ға таратқышты әлі қосқан жоқсыз ба?
Dialogue: 0,0:08:47.08,0:08:49.26,JPN,,0,0,0,,Бұл Android қорғау заңында жазылған.
Dialogue: 0,0:08:49.68,0:08:52.59,JPN,,0,0,0,,Бұл адам құқықтарын қорғау мәселелеріне байланысты заңсыз.
Dialogue: 0,0:08:52.86,0:08:55.92,JPN,,0,0,0,,Адам құқықтары? Бұл адам емес, машина шығар.
Dialogue: 0,0:09:15.83,0:09:17.32,JPN,,0,0,0,,Әке!
Dialogue: 0,0:09:18.40,0:09:21.08,JPN,,0,0,0,,Кезбе болу қиын, солай емес пе?
Dialogue: 0,0:09:21.41,0:09:24.41,JPN,,0,0,0,,Қараңызшы, басқа адамның шектеушісі өшірілген.
Dialogue: 0,0:09:25.24,0:09:26.66,JPN,,0,0,0,,Шектегіш...?
Dialogue: 0,0:09:27.05,0:09:29.49,JPN,,0,0,0,,Көлікті оңай көтере алады
Dialogue: 0,0:09:30.66,0:09:31.70,JPN,,0,0,0,,Неліктен?
Dialogue: 0,0:09:31.93,0:09:33.67,JPN,,0,0,0,,Қаңғыбасты қалай ұстау керек
Dialogue: 0,0:09:33.67,0:09:36.58,JPN,,0,0,0,,Мен Giftia-ға бұл туралы да байыпты қарауым керек пе?
Dialogue: 0,0:09:36.94,0:09:37.62,JPN,,0,0,0,,T: Бүгін айтатын сөздерім осы ғана.
Dialogue: 0,0:09:38.53,0:09:39.51,JPN,,0,0,0,,Мына жігітті пайдаланыңыз
Dialogue: 0,0:09:39.82,0:09:40.44,JPN,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:09:40.82,0:09:42.87,JPN,,0,0,0,,Бағдарламаны жою бағдарламасы
Dialogue: 0,0:09:43.56,0:09:47.61,JPN,,0,0,0,,Оны тек споттер ғана пайдалана алады. Бұл төтенше жағдайда соңғы шара.
Dialogue: 0,0:09:49.17,0:09:54.02,JPN,,0,0,0,,Осымен түсірілген Giftia оның барлық функциялары жойылады.
Dialogue: 0,0:09:54.52,0:09:56.16,JPN,,0,0,0,,Снарядқа ұқсайды, бірақ
Dialogue: 0,0:09:56.17,0:09:58.64,JPN,,0,0,0,,Бұл шын мәнінде вирус деректері сияқты.
Dialogue: 0,0:09:59.19,0:10:00.97,JPN,,0,0,0,,Басқаларды қатыстыру туралы алаңдаудың қажеті жоқ
Dialogue: 0,0:10:01.73,0:10:05.25,JPN,,0,0,0,,Мен мұны түсірсем, одан кейін қалпына келе ме?
Dialogue: 0,0:10:05.83,0:10:06.41,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:10:08.71,0:10:09.98,JPN,,0,0,0,,Солай ма?
Dialogue: 0,0:10:10.58,0:10:12.88,JPN,,0,0,0,,Бұл жағдайға байланысты.
Dialogue: 0,0:10:12.99,0:10:16.11,JPN,,0,0,0,,Оған дейін Марсияны тауып алсаңыз, бәрі жақсы болады.
Dialogue: 0,0:10:16.64,0:10:18.97,JPN,,0,0,0,,Сондықтан оны онша байыппен қабылдамаңыз.
Dialogue: 0,0:10:19.50,0:10:20.21,JPN,,0,0,0,,Иә
Dialogue: 0,0:10:24.21,0:10:25.34,JPN,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:10:25.82,0:10:28.48,JPN,,0,0,0,,Осы жерден біз R.SECURITY компаниясымен ынтымақтасатын боламыз
Dialogue: 0,0:10:28.64,0:10:30.36,JPN,,0,0,0,,Сенің есі дұрыс па?
Dialogue: 0,0:10:30.81,0:10:32.30,JPN,,0,0,0,,Неліктен бұл адамдармен?
Dialogue: 0,0:10:32.61,0:10:33.30,JPN,,0,0,0,,Мичиру
Dialogue: 0,0:10:34.04,0:10:35.01,JPN,,0,0,0,,Әзірше күтіңіз
Dialogue: 0,0:10:36.06,0:10:38.60,JPN,,0,0,0,,Олардың мақсаты – қара коллекционер болу.
Dialogue: 0,0:10:39.06,0:10:40.64,JPN,,0,0,0,,Маршаның араласуына жол берме.
Dialogue: 0,0:10:42.12,0:10:45.47,JPN,,0,0,0,,Мен R.SECURITY сайтынан қосымша ақпарат алуға тырысамын
Dialogue: 0,0:10:46.02,0:10:48.82,JPN,,0,0,0,,Біз Машаны қалай болса да қорғаймыз.
Dialogue: 0,0:10:49.20,0:10:49.77,JPN,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:10:50.05,0:10:50.62,JPN,,0,0,0,,Иә
Dialogue: 0,0:10:52.41,0:10:53.00,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:10:54.01,0:10:54.41,JPN,,0,0,0,,Түсінікті.
Dialogue: 0,0:10:55.70,0:10:56.80,JPN,,0,0,0,,Исла жақсы ма?
Dialogue: 0,0:10:58.61,0:10:58.98,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:10:59.61,0:11:00.73,JPN,,0,0,0,,Егер проблемалар болмаса, жақсы.
Dialogue: 0,0:11:04.59,0:11:09.05,JPN,,0,0,0,,Сіз әлі де Ираға оқиға орнына қайта оралмау керек деп ойлайсыз ба?
Dialogue: 0,0:11:09.69,0:11:13.25,JPN,,0,0,0,,3 жыл бұрынғы жағдай қайталанатын сияқты.
Dialogue: 0,0:11:18.98,0:11:22.36,JPN,,0,0,0,,Біздің мұндай адамдармен бірігіп жатқанымызға сене алар емеспін.
Dialogue: 0,0:11:22.58,0:11:24.45,JPN,,0,0,0,,Неге сонша жаусың?
Dialogue: 0,0:11:24.65,0:11:27.77,JPN,,0,0,0,,Өйткені олар Гигидияны тек объект ретінде көреді.
Dialogue: 0,0:11:28.21,0:11:32.22,JPN,,0,0,0,,Сол кездегі жігіттердің кесірінен Казуки-сан да аяғы ауыр жарақат алған.
Dialogue: 0,0:11:32.46,0:11:33.06,JPN,,0,0,0,,Неліктен?
Dialogue: 0,0:11:33.84,0:11:34.80,JPN,,0,0,0,,Сол кезде
Dialogue: 0,0:11:35.16,0:11:37.60,JPN,,0,0,0,,Мүмкін оның әкеңе қатысы бар шығар?
Dialogue: 0,0:11:38.33,0:11:39.69,JPN,,0,0,0,,Эй, Цукаса
Dialogue: 0,0:11:40.07,0:11:43.53,JPN,,0,0,0,,Мен ештеңе білмегендей әрекет етсең,
Dialogue: 0,0:11:43.66,0:11:45.85,JPN,,0,0,0,,Сіз кез келген нәрсеге жауап бере аласыз деп ойлайсыз ба?
Dialogue: 0,0:11:46.81,0:11:48.13,JPN,,0,0,0,,Э-э…
Dialogue: 0,0:11:49.00,0:11:49.66,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:51.04,0:11:53.73,JPN,,0,0,0,,Мен Цукасаның ақымақ және сезімсіз екенін білемін.
Dialogue: 0,0:11:55.33,0:11:59.60,JPN,,0,0,0,,3 жыл бұрын әкемнің Қаңғыбас болғанын айтқанмын.
Dialogue: 0,0:12:00.44,0:12:03.40,JPN,,0,0,0,,Сол кездегі жинауға жауапты адам Казуки мырза болатын.
Dialogue: 0,0:12:04.93,0:12:05.82,JPN,,0,0,0,,Кадзуки-сан?
Dialogue: 0,0:12:06.94,0:12:09.58,JPN,,0,0,0,,Бірақ мен жиналғанды ​​ұнатпаймын.
Dialogue: 0,0:12:10.07,0:12:12.04,JPN,,0,0,0,,Мен әкеммен қашып кеттім.
Dialogue: 0,0:12:14.13,0:12:16.10,JPN,,0,0,0,,Әке қатты
Dialogue: 0,0:12:16.53,0:12:18.42,JPN,,0,0,0,,Мықты бол, әке.
Dialogue: 0,0:12:22.08,0:12:23.02,JPN,,0,0,0,,Мен оны таптым
Dialogue: 0,0:12:23.96,0:12:26.20,JPN,,0,0,0,,Казуки-сан, сенің әкең...
Dialogue: 0,0:12:33.69,0:12:34.40,JPN,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:12:36.74,0:12:38.18,JPN,,0,0,0,,Бұл сыйлықтан аулақ болыңыз.
Dialogue: 0,0:12:39.24,0:12:41.66,JPN,,0,0,0,,Эй, мұны маған қалдыр.
Dialogue: 0,0:12:41.98,0:12:43.57,JPN,,0,0,0,,Жағдайды нашарлатпаңыз.
Dialogue: 0,0:12:43.85,0:12:46.94,JPN,,0,0,0,,Бірақ, менің ойымша, сіз қашан Қауіпсіздікке айналатыныңызды білмейсіз.
Dialogue: 0,0:12:47.37,0:12:48.67,JPN,,0,0,0,,Қазір жойылуы керек
Dialogue: 0,0:12:49.01,0:12:51.36,JPN,,0,0,0,,Мен саған көрінетін перде жоқ дедім.
Dialogue: 0,0:12:51.61,0:12:52.28,JPN,,0,0,0,,Шулы
Dialogue: 0,0:12:52.45,0:12:53.70,JPN,,0,0,0,,Жарайды, кет.
Dialogue: 0,0:12:53.85,0:12:55.44,JPN,,0,0,0,,Жоқ, жібер
Dialogue: 0,0:12:55.60,0:12:56.01,JPN,,0,0,0,,Эй
Dialogue: 0,0:13:04.00,0:13:04.83,JPN,,0,0,0,,Әкем
Dialogue: 0,0:13:12.58,0:13:13.30,JPN,,0,0,0,,Мичиру
Dialogue: 0,0:13:22.80,0:13:23.61,JPN,,0,0,0,,Түсіру
Dialogue: 0,0:13:23.79,0:13:24.98,JPN,,0,0,0,,Түсіру
Dialogue: 0,0:13:32.31,0:13:33.04,JPN,,0,0,0,,Әке.
Dialogue: 0,0:13:44.42,0:13:46.56,JPN,,0,0,0,,Мен ең нашармын
Dialogue: 0,0:13:46.93,0:13:50.23,JPN,,0,0,0,,Егер олар болмаса, мұның ешқайсысы болмас еді.
Dialogue: 0,0:13:51.04,0:13:52.90,JPN,,0,0,0,,Бірақ неге қазір...
Dialogue: 0,0:13:54.13,0:13:57.18,JPN,,0,0,0,,Мен қазір қолымнан келгенін істеймін
Dialogue: 0,0:13:58.04,0:14:01.68,JPN,,0,0,0,,Соута-кун үшін мен Марша-санды міндетті түрде тауып қорғаймын.
Dialogue: 0,0:14:03.53,0:14:04.47,JPN,,0,0,0,,Тіпті Казуки-сан
Dialogue: 0,0:14:04.92,0:14:07.77,JPN,,0,0,0,,Менің ойымша, Маршаны табу басты міндет болды.
Dialogue: 0,0:14:08.79,0:14:12.14,JPN,,0,0,0,,Әкеңнің басынан өткен оқиғаны қайталағым келмейді.
Dialogue: 0,0:14:13.69,0:14:16.92,JPN,,0,0,0,,Уау, мен де соны түсіндім.
Dialogue: 0,0:14:21.98,0:14:24.00,JPN,,0,0,0,,Бұдан былай бөлек іздейік.
Dialogue: 0,0:14:24.17,0:14:24.51,JPN,,0,0,0,,Иә
Dialogue: 0,0:14:31.77,0:14:33.65,JPN,,0,0,0,,Сіздің аға буыныңыз қайсысы?
Dialogue: 0,0:14:33.81,0:14:35.93,JPN,,0,0,0,,Зак бірдеңе деді.
Dialogue: 0,0:14:36.33,0:14:37.71,JPN,,0,0,0,,Бөлек
Dialogue: 0,0:14:48.46,0:14:50.36,JPN,,0,0,0,,А, мен жасырынатын жерді таптым.
Dialogue: 0,0:14:50.51,0:14:52.06,JPN,,0,0,0,,Бұл Мононокеге байланысты ма?
Dialogue: 0,0:14:52.41,0:14:53.09,JPN,,0,0,0,,Ясутака
Dialogue: 0,0:14:54.84,0:14:58.75,JPN,,0,0,0,,Ой, қара коллектордың алаңсыз ұйықтап жатқанын көргім келеді.
Dialogue: 0,0:14:59.37,0:15:01.86,JPN,,0,0,0,,Марсия жоғалып кетті
Dialogue: 0,0:15:04.20,0:15:06.28,JPN,,0,0,0,,Бұл толығымен созылған.
Dialogue: 0,0:15:06.60,0:15:07.77,JPN,,0,0,0,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:15:09.04,0:15:10.77,JPN,,0,0,0,,Бұл жаман емес пе?
Dialogue: 0,0:15:13.77,0:15:17.05,JPN,,0,0,0,,Жасыратын жердегі жағдайға қарағанда, Марша жалғыз қашып кеткен сияқты.
Dialogue: 0,0:15:17.53,0:15:18.33,JPN,,0,0,0,,Қашу
Dialogue: 0,0:15:19.21,0:15:21.16,JPN,,0,0,0,,Саяхатшы болудың жоғары мүмкіндігі
Dialogue: 0,0:15:23.42,0:15:24.18,JPN,,0,0,0,,Барлығы тыңдайды
Dialogue: 0,0:15:24.85,0:15:27.07,JPN,,0,0,0,,Бұдан былай Маршаны қорғаудан бас тарт.
Dialogue: 0,0:15:28.00,0:15:30.32,JPN,,0,0,0,,Не істесең де, Маршаны тоқтат.
Dialogue: 0,0:15:30.64,0:15:31.88,JPN,,0,0,0,,Мен сенің не айтып тұрғаныңды түсіндім.
Dialogue: 0,0:15:33.61,0:15:35.54,JPN,,0,0,0,,Бұл жерде ештеңе істемесек те
Dialogue: 0,0:15:35.90,0:15:38.36,JPN,,0,0,0,,Марсияны R.SECURITY жояды
Dialogue: 0,0:15:39.46,0:15:40.19,JPN,,0,0,0,,бірақ манга суретшісінің үйіне алты минут ерте бару—
Dialogue: 0,0:15:40.84,0:15:44.20,JPN,,0,0,0,,Ең болмаса жауапкершілікті алып, өз қолымызбен жинап алайық.
Dialogue: 0,0:15:45.26,0:15:47.38,JPN,,0,0,0,,Бұл да біздің жұмысымыз.
Dialogue: 0,0:15:48.73,0:15:50.38,JPN,,0,0,0,,Мен мұның болғанына сене алар емеспін
Dialogue: 0,0:15:51.02,0:15:54.34,JPN,,0,0,0,,Марша табылса да, Цукаса оған қарау керек.
Dialogue: 0,0:15:55.15,0:15:55.72,JPN,,0,0,0,,Ира
Dialogue: 0,0:15:56.98,0:15:58.26,JPN,,0,0,0,,Мен бірдеңе істеймін
Dialogue: 0,0:15:59.05,0:16:01.13,JPN,,0,0,0,,Цукаса Цукаса істей алатын нәрсені жасады.
Dialogue: 0,0:16:01.70,0:16:04.13,JPN,,0,0,0,,Енді бұл менің жұмысым.
Dialogue: 0,0:16:05.04,0:16:07.21,JPN,,0,0,0,,Менің ойымша, рөлдерді бөлу осыған байланысты.
Dialogue: 0,0:16:09.14,0:16:09.82,JPN,,0,0,0,,Бөлек
Dialogue: 0,0:16:14.10,0:16:16.46,JPN,,0,0,0,,Мен Сута-кунға уәде бердім.
Dialogue: 0,0:16:17.28,0:16:19.31,JPN,,0,0,0,,Ол міндетті түрде Марсияны қайтарады.
Dialogue: 0,0:16:32.40,0:16:33.20,JPN,,0,0,0,,Марсия
Dialogue: 0,0:16:33.28,0:16:33.88,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:16:44.30,0:16:47.93,JPN,,0,0,0,,Гиддия 81920 сағаттан кейін
Dialogue: 0,0:16:48.18,0:16:50.40,JPN,,0,0,0,,Тұлға мен естеліктер бірте-бірте жойылады
Dialogue: 0,0:16:51.10,0:16:52.59,JPN,,0,0,0,,Цукаса, артқа тұр.
Dialogue: 0,0:17:00.00,0:17:03.57,JPN,,0,0,0,,Естеліктер сіз үшін ауыр болды ма?
Dialogue: 0,0:17:04.52,0:17:05.22,JPN,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:17:08.08,0:17:08.80,JPN,,0,0,0,,Марша
Dialogue: 0,0:17:09.07,0:17:10.00,JPN,,0,0,0,,Сота-кун
Dialogue: 0,0:17:10.10,0:17:10.93,JPN,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:17:21.14,0:17:21.90,JPN,,0,0,0,,Марсия
Dialogue: 0,0:17:22.85,0:17:24.23,JPN,,0,0,0,,Бұл жақсы емес, қаш, Соута.
Dialogue: 0,0:17:31.07,0:17:33.28,JPN,,0,0,0,,Кешіріңіз, мен Марсияны таптым.
Dialogue: 0,0:17:33.42,0:17:35.18,JPN,,0,0,0,,В-4 ауданына қашып кетті
Dialogue: 0,0:17:35.42,0:17:38.72,JPN,,0,0,0,,Сондай-ақ, Сута-кун қазір Маша-санмен бірге.
Dialogue: 0,0:17:39.83,0:17:41.42,JPN,,0,0,0,,Сота-кун, неге?
Dialogue: 0,0:17:41.99,0:17:42.89,JPN,,0,0,0,,Исла жақсы ма?
Dialogue: 0,0:17:43.10,0:17:43.68,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:17:44.78,0:17:46.23,JPN,,0,0,0,,Сондықтан мен оны айтпаймын.
Dialogue: 0,0:17:46.63,0:17:49.46,JPN,,0,0,0,,Мен инженер жіберемін, Цукаса мен басқалары сонда күтіп тұр.
Dialogue: 0,0:17:49.77,0:17:50.96,JPN,,0,0,0,,Ислаға абайсызда ештеңе жасауға жол берме.
Dialogue: 0,0:17:51.24,0:17:51.88,JPN,,0,0,0,,Бірақ
Dialogue: 0,0:17:52.00,0:17:52.93,JPN,,0,0,0,,Мені тыңда
Dialogue: 0,0:17:54.34,0:17:55.09,JPN,,0,0,0,,Барайық
Dialogue: 0,0:17:57.24,0:18:00.33,JPN,,0,0,0,,Жоқ, менің мұнда күтуге уақытым жоқ.
Dialogue: 0,0:18:00.81,0:18:02.29,JPN,,0,0,0,,Осы қарқынмен бұл Сута-кунға дейін.
Dialogue: 0,0:18:03.50,0:18:04.87,JPN,,0,0,0,,Жалғыз қуып барайын ба?
Dialogue: 0,0:18:05.75,0:18:06.42,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:18:06.87,0:18:10.14,JPN,,0,0,0,,Қазір бәрі жақсы, Машаның артынан барайық.
Dialogue: 0,0:18:10.80,0:18:12.21,JPN,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл қисынсыз.
Dialogue: 0,0:18:13.74,0:18:14.40,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:18:15.26,0:18:16.78,JPN,,0,0,0,,Кедергі болма
Dialogue: 0,0:18:17.34,0:18:20.21,JPN,,0,0,0,,Сондықтан менің рөлімді тартып алмаңыз.
Dialogue: 0,0:18:20.73,0:18:21.28,JPN,,0,0,0,,Ира
Dialogue: 0,0:18:22.08,0:18:23.85,JPN,,0,0,0,,Біз бір жұппыз
Dialogue: 0,0:18:25.02,0:18:25.77,JPN,,0,0,0,,Ицумида-сан ба?
Dialogue: 0,0:18:33.70,0:18:35.35,JPN,,0,0,0,,Сәлем, Ира.
Dialogue: 0,0:18:36.48,0:18:39.70,JPN,,0,0,0,,Бұл шынымен де Сута үшін бата.
Dialogue: 0,0:18:41.33,0:18:42.97,JPN,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:18:43.97,0:18:48.07,JPN,,0,0,0,,Бақытты немесе әдемі естеліктер міндетті түрде құтқаруға әкелмейді.
Dialogue: 0,0:18:49.24,0:18:50.76,JPN,,0,0,0,,Естеліктер соғұрлым әдемі болады
Dialogue: 0,0:18:51.18,0:18:52.57,JPN,,0,0,0,,Ауыруы мүмкін
Dialogue: 0,0:18:53.28,0:18:54.61,JPN,,0,0,0,,Бұл қорқынышты болуы мүмкін
Dialogue: 0,0:18:55.58,0:18:57.20,JPN,,0,0,0,,Кететіндер үшін
Dialogue: 0,0:18:57.70,0:18:59.30,JPN,,0,0,0,,Артта қалғандар үшін
Dialogue: 0,0:18:59.99,0:19:02.47,JPN,,0,0,0,,Сізге естеліктер қажет емес деп ойлайсыз ба?
Dialogue: 0,0:19:07.41,0:19:10.02,JPN,,0,0,0,,Бұл мені мұңайтады.
Dialogue: 0,0:19:11.62,0:19:13.34,JPN,,0,0,0,,Эй, сен нені айтып тұрсың?
Dialogue: 0,0:19:13.57,0:19:15.97,JPN,,0,0,0,,Мен де Уандерермен жұмыс істеуге нұсқау алдым.
Dialogue: 0,0:19:16.08,0:19:18.19,JPN,,0,0,0,,Мен сенің есегіңді сүртіп жатырмын.
Dialogue: 0,0:19:18.44,0:19:20.62,JPN,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:19:20.92,0:19:22.61,JPN,,0,0,0,,Онда мен барлығын осында аяқтаймын.
Dialogue: 0,0:19:23.13,0:19:25.86,JPN,,0,0,0,,Сіз де біреудің бөксесін сүртпейсіз.
Dialogue: 0,0:19:25.90,0:19:27.68,JPN,,0,0,0,,Бірақ жоғарыдан нұсқаулар болғандықтан
Dialogue: 0,0:19:27.68,0:19:29.65,JPN,,0,0,0,,Ах, менің аяғым ауырды.
Dialogue: 0,0:19:29.93,0:19:32.83,JPN,,0,0,0,,3 жыл бұрын жарақат алған оң аяғым қатты ауырады.
Dialogue: 0,0:19:33.66,0:19:35.29,JPN,,0,0,0,,Сіз оны жаңа ғана суға жібердіңіз.
Dialogue: 0,0:19:35.57,0:19:38.12,JPN,,0,0,0,,Әсіресе жаңбыр жауғанда ауырады.
Dialogue: 0,0:19:38.33,0:19:40.35,JPN,,0,0,0,,Протездік аяқ қолайсыз.
Dialogue: 0,0:19:42.84,0:19:44.25,JPN,,0,0,0,,Бар болғаны 30 минут күтіңіз
Dialogue: 0,0:19:44.76,0:19:45.47,JPN,,0,0,0,,Сәлем
Dialogue: 0,0:20:00.10,0:20:00.97,JPN,,0,0,0,,Марсия
Dialogue: 0,0:20:10.13,0:20:11.77,JPN,,0,0,0,,Цукаса күт
Dialogue: 0,0:20:11.88,0:20:12.49,JPN,,0,0,0,,Қауіпті
Dialogue: 0,0:20:12.89,0:20:13.60,JPN,,0,0,0,,Жарайды
Dialogue: 0,0:20:13.97,0:20:14.69,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:20:15.55,0:20:17.44,JPN,,0,0,0,,Марсия, тыңдашы.
Dialogue: 0,0:20:18.03,0:20:20.51,JPN,,0,0,0,,Мен сені және Сута-кунды құтқарғым келеді.
Dialogue: 0,0:20:21.52,0:20:25.07,JPN,,0,0,0,,Егер сізде әлі де ең кішкентай естеліктер қалса
Dialogue: 0,0:20:25.72,0:20:26.99,JPN,,0,0,0,,Қарсылық көрсетпеу
Dialogue: 0,0:20:29.28,0:20:30.56,JPN,,0,0,0,,Сен де айттың ғой, солай ма?
Dialogue: 0,0:20:31.28,0:20:34.25,JPN,,0,0,0,,Ол сені бақылап жүргенін айтады, Сута.
Dialogue: 0,0:20:35.09,0:20:36.74,JPN,,0,0,0,,Біз мәңгі бірге боламыз
Dialogue: 0,0:20:44.61,0:20:47.09,JPN,,0,0,0,,Жүр, қолымды ал.
Dialogue: 0,0:20:48.08,0:20:49.33,JPN,,0,0,0,,Міне.
Dialogue: 0,0:21:02.72,0:21:04.24,JPN,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:21:04.78,0:21:06.89,JPN,,0,0,0,,Жарайды, үрейленбе.
Dialogue: 0,0:21:08.42,0:21:09.09,JPN,,0,0,0,,Баяу
Dialogue: 0,0:21:10.99,0:21:11.72,JPN,,0,0,0,,Баяу
Dialogue: 0,0:21:18.46,0:21:19.24,JPN,,0,0,0,,Марсия
Dialogue: 0,0:21:26.88,0:21:27.77,JPN,,0,0,0,,Марсия
Dialogue: 0,0:21:54.56,0:21:57.59,JPN,,0,0,0,,Маршер
Dialogue: 0,0:22:01.73,0:22:03.72,JPN,,0,0,0,,Ештеңе істей алмаймыз.
Dialogue: 0,0:23:49.70,0:23:55.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
