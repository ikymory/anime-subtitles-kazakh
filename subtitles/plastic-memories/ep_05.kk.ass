Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Жарықты жинау
Dialogue: 0,0:00:11.09,0:00:16.04,Default,,0,0,0,,Қоштасудан естеліктер
Dialogue: 0,0:00:17.05,0:00:23.06,Default,,0,0,0,,Көзіме тамсанып, алысқа қадалған арман
Dialogue: 0,0:00:23.08,0:00:29.00,Default,,0,0,0,,Ән жады бұзылады
Dialogue: 0,0:00:29.03,0:00:34.04,Default,,0,0,0,,Жалғыздықтың көз жасын ақырын сүртейік
Dialogue: 0,0:00:34.07,0:00:41.06,Default,,0,0,0,,Ұзартылған қол - айналмалы дөңгелек, оны абайлап алыңыз
Dialogue: 0,0:00:41.09,0:00:46.09,Default,,0,0,0,,Оянғалы тұрған жадының үзінділері
Dialogue: 0,0:00:47.09,0:00:52.08,Default,,0,0,0,,Мен төмен қарап, жоқ болып кетсін деп дұға етемін, бірақ
Dialogue: 0,0:00:52.09,0:00:58.09,Default,,0,0,0,,Бұл сіз тапқан дауыс
Dialogue: 0,0:00:59.02,0:01:05.09,Default,,0,0,0,,Сағат тілі қозғала бастайды, көп ұзамай дүниенің түсі өзгереді
Dialogue: 0,0:01:06.02,0:01:12.01,Default,,0,0,0,,Менің пластикалық жүрегім жарқырайды
Dialogue: 0,0:01:12.04,0:01:17.00,Default,,0,0,0,,Ұмытпа, есте сақта
Dialogue: 0,0:01:17.04,0:01:23.09,Default,,0,0,0,,Бір күні тағы кездескенше
Dialogue: 0,0:01:34.01,0:01:36.01,Default,,0,0,0,,Мен аздап көп сатып алдым деп ойлаймын.
Dialogue: 0,0:01:37.04,0:01:40.03,Default,,0,0,0,,Бірақ ертең Соутамен соңғы рет болады.
Dialogue: 0,0:01:42.02,0:01:43.09,Default,,0,0,0,,Уау, бұл ұзақ болды
Dialogue: 0,0:01:44.04,0:01:45.06,Default,,0,0,0,,Мен үйге асығуым керек.
Dialogue: 0,0:02:04.04,0:02:05.03,Default,,0,0,0,,Сәлем Сута-кун
Dialogue: 0,0:02:05.09,0:02:06.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:07.01,0:02:09.03,Default,,0,0,0,,А, Маша қалай?
Dialogue: 0,0:02:11.00,0:02:11.50,Default,,0,0,0,,Сота-кун?
Dialogue: 0,0:02:13.06,0:02:15.05,Default,,0,0,0,,Марсия қайтып келмейді.
Dialogue: 0,0:02:20.06,0:02:22.07,Default,,0,0,0,,Мен SAI компаниясынанмын.
Dialogue: 0,0:02:23.00,0:02:24.07,Default,,0,0,0,,Марсия үйде ме?
Dialogue: 0,0:02:25.02,0:02:27.08,Default,,0,0,0,,Мен жаңа ғана дүкен аралауға шықтым.
Dialogue: 0,0:02:28.00,0:02:29.02,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:02:29.04,0:02:33.01,Default,,0,0,0,,Менің қайда дүкен аралағанымды білесің бе?
Dialogue: 0,0:02:42.07,0:02:44.05,Default,,0,0,0,,Қара коллекционер болу мүмкіндігі...
Dialogue: 0,0:02:46.06,0:02:49.09,Default,,0,0,0,,Марсияның өмір сүру ұзақтығына шамамен 24 сағат қалды
Dialogue: 0,0:02:50.03,0:02:51.03,Default,,0,0,0,,Осыдан кейін
Dialogue: 0,0:02:52.02,0:02:55.07,Default,,0,0,0,,Ей, ол қарт Цукаса мен оның достарының танысы болуы керек.
Dialogue: 0,0:02:56.00,0:02:58.01,Default,,0,0,0,,Маған хабарласып, Марсияны әкел.
Dialogue: 0,0:03:00.03,0:03:01.02,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:01.05,0:03:02.01,Default,,0,0,0,,Цукаса
Dialogue: 0,0:03:08.05,0:03:09.01,Default,,0,0,0,,Сота-кун
Dialogue: 0,0:03:09.09,0:03:12.01,Default,,0,0,0,,Әлгі қария сені алдады.
Dialogue: 0,0:03:12.04,0:03:14.03,Default,,0,0,0,,Мүмкін ол Марсияны алып кеткен шығар.
Dialogue: 0,0:03:15.03,0:03:15.53,Default,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:03:16.02,0:03:16.52,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:17.04,0:03:19.04,Default,,0,0,0,,Маша-санды өзіміз табыңыз.
Dialogue: 0,0:03:19.07,0:03:20.06,Default,,0,0,0,,Мені қайтар
Dialogue: 0,0:03:21.07,0:03:23.09,Default,,0,0,0,,Сондықтан мен сенің осында күтуіңді қалаймын.
Dialogue: 0,0:03:26.03,0:03:29.04,Default,,0,0,0,,Менімен бір қараңғы коллекционер хабарласқанына күмән жоқ сияқты.
Dialogue: 0,0:03:29.09,0:03:30.06,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:03:31.01,0:03:33.02,Default,,0,0,0,,Әйтеуір, бөлініп, Марсияны іздейік.
Dialogue: 0,0:03:33.06,0:03:35.07,Default,,0,0,0,,Жарайды, әлі уақыт бар.
Dialogue: 0,0:03:36.01,0:03:36.51,Default,,0,0,0,,Иә
Dialogue: 0,0:03:37.09,0:03:40.00,Default,,0,0,0,,Егер сіз саяхатшы болсаңыз
Dialogue: 0,0:03:40.03,0:03:41.06,Default,,0,0,0,,3 жыл болды ма?
Dialogue: 0,0:03:41.09,0:03:43.09,Default,,0,0,0,,Бұл әлі шешілген жоқ.
Dialogue: 0,0:03:44.03,0:03:45.03,Default,,0,0,0,,Бейқам сөздерді айтпа
Dialogue: 0,0:03:45.09,0:03:47.01,Default,,0,0,0,,Міне
Dialogue: 0,0:03:47.03,0:03:50.05,Default,,0,0,0,,Өйткені, менеджерге хабарласу керек.
Dialogue: 0,0:03:50.06,0:03:52.01,Default,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:03:53.07,0:03:54.07,Default,,0,0,0,,Директор Годо
Dialogue: 0,0:03:55.06,0:03:58.09,Default,,0,0,0,,1-терминалдың қызмет көрсету бөлімінің менеджері Ямабе мырза бізге хабарласты.
Dialogue: 0,0:04:00.02,0:04:02.04,Default,,0,0,0,,Менеджер, шын мәнінде.
Dialogue: 0,0:04:02.07,0:04:05.00,Default,,0,0,0,,Сәл күрделі жағдай
Dialogue: 0,0:04:05.08,0:04:06.04,Default,,0,0,0,,Не?
Dialogue: 0,0:04:06.05,0:04:12.00,Default,,0,0,0,,Инкассация нысанын қараңғы коллекторлық агенттік алып кеткен сияқты.
Dialogue: 0,0:04:12.02,0:04:14.06,Default,,0,0,0,,Мен сізбен байланыса алмаймын дедім.
Dialogue: 0,0:04:14.06,0:04:16.02,Default,,0,0,0,,Сыйлықтардың өмір сүру ұзақтығы қандай?
Dialogue: 0,0:04:16.09,0:04:19.04,Default,,0,0,0,,Ал, ертең 13:00.
Dialogue: 0,0:04:20.01,0:04:22.09,Default,,0,0,0,,R.SECURITY нөміріне қоңырау шалыңыз. Бұл шұғыл.
Dialogue: 0,0:04:23.04,0:04:24.03,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:04:24.07,0:04:26.05,Default,,0,0,0,,Балалар, іздеуді жалғастырыңдар.
Dialogue: 0,0:04:27.00,0:04:28.05,Default,,0,0,0,,Мұнда да әрекет жасаңыз.
Dialogue: 0,0:04:29.01,0:04:29.51,Default,,0,0,0,,Иә
Dialogue: 0,0:04:38.03,0:04:40.03,Default,,0,0,0,,Жоқ, бұл еш жерде емес.
Dialogue: 0,0:04:42.06,0:04:44.09,Default,,0,0,0,,Егер мен оны осылай таба алмасам
Dialogue: 0,0:04:47.04,0:04:50.09,Default,,0,0,0,,Іздеген жерлерді тағы бір рет айналып өту керек.
Dialogue: 0,0:04:51.08,0:04:52.08,Default,,0,0,0,,Сабырмен іздеңіз
Dialogue: 0,0:04:54.08,0:04:58.05,Default,,0,0,0,,Негізі, мен Мичируден естіген әңгімені ойымнан шығара алмаймын.
Dialogue: 0,0:04:59.01,0:05:01.04,Default,,0,0,0,,Исла Уандерер туралы қаншалықты біледі?
Dialogue: 0,0:05:02.07,0:05:04.07,Default,,0,0,0,,Саяхатшы болу – сирек кездесетін жағдай.
Dialogue: 0,0:05:05.04,0:05:07.06,Default,,0,0,0,,Тіпті Марсия да әрқашан солай бола бермейді.
Dialogue: 0,0:05:08.04,0:05:11.06,Default,,0,0,0,,Ендеше, қазір теріс ойламаған дұрыс.
Dialogue: 0,0:05:15.02,0:05:16.07,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:05:17.01,0:05:17.51,Default,,0,0,0,,Цукаса
Dialogue: 0,0:05:19.00,0:05:20.02,Default,,0,0,0,,Ол қалай табылды?
Dialogue: 0,0:05:20.06,0:05:21.07,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:05:22.02,0:05:22.52,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:23.04,0:05:25.00,Default,,0,0,0,,Содан кейін біз сол жерден іздейміз.
Dialogue: 0,0:06:11.04,0:06:13.03,Default,,0,0,0,,Кешеден бері ұйықтамадың.
Dialogue: 0,0:06:13.06,0:06:15.02,Default,,0,0,0,,Мен сізге үзіліс жасаңыз дедім.
Dialogue: 0,0:06:15.06,0:06:17.08,Default,,0,0,0,,Жоқ, менде бәрі жақсы.
Dialogue: 0,0:06:18.00,0:06:19.09,Default,,0,0,0,,Жарайсың, бірақ Исла...
Dialogue: 0,0:06:22.03,0:06:23.06,Default,,0,0,0,,Мен де жақсымын.
Dialogue: 0,0:06:26.01,0:06:27.08,Default,,0,0,0,,О, мен мұны қалаймын
Dialogue: 0,0:06:27.09,0:06:30.00,Default,,0,0,0,,Сонда сіз қайда барасыз?
Dialogue: 0,0:06:30.06,0:06:31.09,Default,,0,0,0,,Кейбір айғақтардан
Dialogue: 0,0:06:32.03,0:06:36.05,Default,,0,0,0,,Алда қараңғы қалпына келтіру цехының дәмі бар болуы ықтималдығы жоғары болып шықты.
Dialogue: 0,0:06:36.08,0:06:38.01,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:38.05,0:06:39.07,Default,,0,0,0,,Соңында анықтама
Dialogue: 0,0:06:40.01,0:06:42.07,Default,,0,0,0,,Қолданылатын орындардың ауқымы өте кең.
Dialogue: 0,0:06:43.01,0:06:45.01,Default,,0,0,0,,Дегенмен, бұл кеңес бермегеннен жақсы.
Dialogue: 0,0:06:50.03,0:06:52.02,Default,,0,0,0,,Бұл аймақ қазір құлыптаулы.
Dialogue: 0,0:06:52.07,0:06:53.07,Default,,0,0,0,,Айналмалы жолмен жүріңіз
Dialogue: 0,0:06:54.02,0:06:55.06,Default,,0,0,0,,R. ҚАУІПСІЗДІК?
Dialogue: 0,0:06:56.00,0:06:57.08,Default,,0,0,0,,Өйткені, іссапармен келдің ғой.
Dialogue: 0,0:06:58.04,0:06:59.05,Default,,0,0,0,,R. ҚАУІПСІЗДІК?
Dialogue: 0,0:07:00.00,0:07:03.09,Default,,0,0,0,,Біздің компаниямен іскерлік одақтастығы бар жеке қауіпсіздік компаниясы
Dialogue: 0,0:07:04.03,0:07:06.01,Default,,0,0,0,,Құлыпта болу деген нені білдіреді?
Dialogue: 0,0:07:06.05,0:07:08.04,Default,,0,0,0,,Сізде ондай өкілеттік жоқ.
Dialogue: 0,0:07:08.08,0:07:12.01,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:07:12.03,0:07:14.09,Default,,0,0,0,,Бірақ менің де кейінірек істейтін жұмысым бар.
Dialogue: 0,0:07:15.02,0:07:18.01,Default,,0,0,0,,Егер сіз оны шынымен өткізбесеңіз, жауапты адамды жіберіңіз.
Dialogue: 0,0:07:18.01,0:07:20.08,Default,,0,0,0,,Казуки: Келіссөздерді бейбіт түрде жүргізген дұрыс.
Dialogue: 0,0:07:21.02,0:07:22.06,Default,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,0:07:28.01,0:07:31.07,Default,,0,0,0,,Мен сені қайта көретініме сене алар емеспін. 3 жыл болды.
Dialogue: 0,0:07:32.01,0:07:35.03,Default,,0,0,0,,Сіз біршама жоғарылаған сияқтысыз, Шиноно-сан.
Dialogue: 0,0:07:35.09,0:07:37.02,Default,,0,0,0,,Шиноном.
Dialogue: 0,0:07:37.07,0:07:41.08,Default,,0,0,0,,Сонымен, сіз сол кездегідей себеппен іссапарға келдіңіз бе?
Dialogue: 0,0:07:42.02,0:07:43.05,Default,,0,0,0,,Ал сендерге келсек, капитан Леви міндетті түрде
Dialogue: 0,0:07:46.02,0:07:47.09,Default,,0,0,0,,Қорқынышты бет жасама
Dialogue: 0,0:07:48.02,0:07:52.03,Default,,0,0,0,,Біздің мақсатымыз - қара коллекционерлерді ұстау.
Dialogue: 0,0:07:52.09,0:07:55.05,Default,,0,0,0,,Мені алып кеткен Гидидия қызықтырмайды.
Dialogue: 0,0:07:56.00,0:07:57.02,Default,,0,0,0,,Әзірге
Dialogue: 0,0:07:58.00,0:07:59.02,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:07:59.04,0:08:01.09,Default,,0,0,0,,Сонымен, сізде қандай ақпарат бар?
Dialogue: 0,0:08:02.06,0:08:03.09,Default,,0,0,0,,Мен айтамын деп ойлайсың ба?
Dialogue: 0,0:08:04.05,0:08:06.04,Default,,0,0,0,,Біз қайырымдылықпен айналыспаймыз.
Dialogue: 0,0:08:06.06,0:08:08.03,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:08:08.05,0:08:12.04,Default,,0,0,0,,Заттарды қалай өңдеуге байланысты өткенді жууға болады.
Dialogue: 0,0:08:16.02,0:08:17.01,Default,,0,0,0,,Маған картаны беріңіз
Dialogue: 0,0:08:17.06,0:08:18.02,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:08:18.04,0:08:19.01,Default,,0,0,0,,Уа!!
Dialogue: 0,0:08:20.00,0:08:21.07,Default,,0,0,0,,Сен жақсы жігіт емессің бе?
Dialogue: 0,0:08:22.02,0:08:24.01,Default,,0,0,0,,Мен осылайша жоғарыладым.
Dialogue: 0,0:08:24.06,0:08:25.08,Default,,0,0,0,,«Алдау?» Оны алдау үшін не істемексің?
Dialogue: 0,0:08:27.03,0:08:29.08,Default,,0,0,0,,Ақпараттық желіні пайдалану
Dialogue: 0,0:08:29.09,0:08:32.09,Default,,0,0,0,,Мен қараңғы коллектордың жасырынатын жерін болжадым.
Dialogue: 0,0:08:33.02,0:08:34.06,Default,,0,0,0,,Бұл аймақтың бәрі осы.
Dialogue: 0,0:08:35.05,0:08:37.09,Default,,0,0,0,,Ол қазір ешкім кіре немесе шыға алмайтындай етіп жабылған.
Dialogue: 0,0:08:38.03,0:08:40.04,Default,,0,0,0,,Мұндағы ақпаратқа шамамен сәйкес келеді.
Dialogue: 0,0:08:40.07,0:08:43.02,Default,,0,0,0,,Бұл Марсияның да бар екенін білдіре ме?
Dialogue: 0,0:08:43.04,0:08:46.09,Default,,0,0,0,,Эй, сіз Giftia-ға таратқышты әлі қосқан жоқсыз ба?
Dialogue: 0,0:08:47.00,0:08:49.02,Default,,0,0,0,,Бұл Android қорғау заңында жазылған.
Dialogue: 0,0:08:49.06,0:08:52.05,Default,,0,0,0,,Бұл адам құқықтарын қорғау мәселелеріне байланысты заңсыз.
Dialogue: 0,0:08:52.08,0:08:55.09,Default,,0,0,0,,Адам құқықтары? Бұл адам емес, машина шығар.
Dialogue: 0,0:09:15.08,0:09:17.03,Default,,0,0,0,,Әке!
Dialogue: 0,0:09:18.04,0:09:21.00,Default,,0,0,0,,Кезбе болу қиын, солай емес пе?
Dialogue: 0,0:09:21.04,0:09:24.04,Default,,0,0,0,,Қараңызшы, басқа адамның шектеушісі өшірілген.
Dialogue: 0,0:09:25.02,0:09:26.06,Default,,0,0,0,,Шектегіш...?
Dialogue: 0,0:09:27.00,0:09:29.04,Default,,0,0,0,,Көлікті оңай көтере алады
Dialogue: 0,0:09:30.06,0:09:31.07,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:31.09,0:09:33.06,Default,,0,0,0,,Қаңғыбасты қалай ұстау керек
Dialogue: 0,0:09:33.06,0:09:36.05,Default,,0,0,0,,Мен Giftia-ға бұл туралы да байыпты қарауым керек пе?
Dialogue: 0,0:09:36.09,0:09:37.06,Default,,0,0,0,,T: Бүгін айтатын сөздерім осы ғана.
Dialogue: 0,0:09:38.05,0:09:39.05,Default,,0,0,0,,Мына жігітті пайдаланыңыз
Dialogue: 0,0:09:39.08,0:09:40.04,Default,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:09:40.08,0:09:42.08,Default,,0,0,0,,Бағдарламаны жою бағдарламасы
Dialogue: 0,0:09:43.05,0:09:47.06,Default,,0,0,0,,Оны тек споттер ғана пайдалана алады. Бұл төтенше жағдайда соңғы шара.
Dialogue: 0,0:09:49.01,0:09:54.00,Default,,0,0,0,,Осымен түсірілген Giftia оның барлық функциялары жойылады.
Dialogue: 0,0:09:54.05,0:09:56.01,Default,,0,0,0,,Снарядқа ұқсайды, бірақ
Dialogue: 0,0:09:56.01,0:09:58.06,Default,,0,0,0,,Бұл шын мәнінде вирус деректері сияқты.
Dialogue: 0,0:09:59.01,0:10:00.09,Default,,0,0,0,,Басқаларды қатыстыру туралы алаңдаудың қажеті жоқ
Dialogue: 0,0:10:01.07,0:10:05.02,Default,,0,0,0,,Мен мұны түсірсем, одан кейін қалпына келе ме?
Dialogue: 0,0:10:05.08,0:10:06.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:08.07,0:10:09.09,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:10.05,0:10:12.08,Default,,0,0,0,,Бұл жағдайға байланысты.
Dialogue: 0,0:10:12.09,0:10:16.01,Default,,0,0,0,,Оған дейін Марсияны тауып алсаңыз, бәрі жақсы болады.
Dialogue: 0,0:10:16.06,0:10:18.09,Default,,0,0,0,,Сондықтан оны онша байыппен қабылдамаңыз.
Dialogue: 0,0:10:19.05,0:10:20.02,Default,,0,0,0,,Иә
Dialogue: 0,0:10:24.02,0:10:25.03,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:10:25.08,0:10:28.04,Default,,0,0,0,,Осы жерден біз R.SECURITY компаниясымен ынтымақтасатын боламыз
Dialogue: 0,0:10:28.06,0:10:30.03,Default,,0,0,0,,Сенің есі дұрыс па?
Dialogue: 0,0:10:30.08,0:10:32.03,Default,,0,0,0,,Неліктен бұл адамдармен?
Dialogue: 0,0:10:32.06,0:10:33.03,Default,,0,0,0,,Мичиру
Dialogue: 0,0:10:34.00,0:10:35.00,Default,,0,0,0,,Әзірше күтіңіз
Dialogue: 0,0:10:36.00,0:10:38.06,Default,,0,0,0,,Олардың мақсаты – қара коллекционер болу.
Dialogue: 0,0:10:39.00,0:10:40.06,Default,,0,0,0,,Маршаның араласуына жол берме.
Dialogue: 0,0:10:42.01,0:10:45.04,Default,,0,0,0,,Мен R.SECURITY сайтынан қосымша ақпарат алуға тырысамын
Dialogue: 0,0:10:46.00,0:10:48.08,Default,,0,0,0,,Біз Машаны қалай болса да қорғаймыз.
Dialogue: 0,0:10:49.02,0:10:49.52,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:10:50.00,0:10:50.50,Default,,0,0,0,,Иә
Dialogue: 0,0:10:52.04,0:10:53.00,Default,,0,0,0,,Цукаса
Dialogue: 0,0:10:54.00,0:10:54.50,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:10:55.07,0:10:56.08,Default,,0,0,0,,Исла жақсы ма?
Dialogue: 0,0:10:58.06,0:10:58.56,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:59.06,0:11:00.07,Default,,0,0,0,,Егер проблемалар болмаса, жақсы.
Dialogue: 0,0:11:04.05,0:11:09.00,Default,,0,0,0,,Сіз әлі де Ираға оқиға орнына қайта оралмау керек деп ойлайсыз ба?
Dialogue: 0,0:11:09.06,0:11:13.02,Default,,0,0,0,,3 жыл бұрынғы жағдай қайталанатын сияқты.
Dialogue: 0,0:11:18.09,0:11:22.03,Default,,0,0,0,,Біздің мұндай адамдармен бірігіп жатқанымызға сене алар емеспін.
Dialogue: 0,0:11:22.05,0:11:24.04,Default,,0,0,0,,Неге сонша жаусың?
Dialogue: 0,0:11:24.06,0:11:27.07,Default,,0,0,0,,Өйткені олар Гигидияны тек объект ретінде көреді.
Dialogue: 0,0:11:28.02,0:11:32.02,Default,,0,0,0,,Сол кездегі жігіттердің кесірінен Казуки-сан да аяғы ауыр жарақат алған.
Dialogue: 0,0:11:32.04,0:11:33.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:33.08,0:11:34.08,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:11:35.01,0:11:37.06,Default,,0,0,0,,Мүмкін оның әкеңе қатысы бар шығар?
Dialogue: 0,0:11:38.03,0:11:39.06,Default,,0,0,0,,Эй, Цукаса
Dialogue: 0,0:11:40.00,0:11:43.05,Default,,0,0,0,,Мен ештеңе білмегендей әрекет етсең,
Dialogue: 0,0:11:43.06,0:11:45.08,Default,,0,0,0,,Сіз кез келген нәрсеге жауап бере аласыз деп ойлайсыз ба?
Dialogue: 0,0:11:46.08,0:11:48.01,Default,,0,0,0,,Э-э…
Dialogue: 0,0:11:49.00,0:11:49.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:51.00,0:11:53.07,Default,,0,0,0,,Мен Цукасаның ақымақ және сезімсіз екенін білемін.
Dialogue: 0,0:11:55.03,0:11:59.06,Default,,0,0,0,,3 жыл бұрын әкемнің Қаңғыбас болғанын айтқанмын.
Dialogue: 0,0:12:00.04,0:12:03.04,Default,,0,0,0,,Сол кездегі жинауға жауапты адам Казуки мырза болатын.
Dialogue: 0,0:12:04.09,0:12:05.08,Default,,0,0,0,,Кадзуки-сан?
Dialogue: 0,0:12:06.09,0:12:09.05,Default,,0,0,0,,Бірақ мен жиналғанды ​​ұнатпаймын.
Dialogue: 0,0:12:10.00,0:12:12.00,Default,,0,0,0,,Мен әкеммен қашып кеттім.
Dialogue: 0,0:12:14.01,0:12:16.01,Default,,0,0,0,,Әке қатты
Dialogue: 0,0:12:16.05,0:12:18.04,Default,,0,0,0,,Мықты бол, әке.
Dialogue: 0,0:12:22.00,0:12:23.00,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:12:23.09,0:12:26.02,Default,,0,0,0,,Казуки-сан, сенің әкең...
Dialogue: 0,0:12:33.06,0:12:34.04,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:12:36.07,0:12:38.01,Default,,0,0,0,,Бұл сыйлықтан аулақ болыңыз.
Dialogue: 0,0:12:39.02,0:12:41.06,Default,,0,0,0,,Эй, мұны маған қалдыр.
Dialogue: 0,0:12:41.09,0:12:43.05,Default,,0,0,0,,Жағдайды нашарлатпаңыз.
Dialogue: 0,0:12:43.08,0:12:46.09,Default,,0,0,0,,Бірақ, менің ойымша, сіз қашан Қауіпсіздікке айналатыныңызды білмейсіз.
Dialogue: 0,0:12:47.03,0:12:48.06,Default,,0,0,0,,Қазір жойылуы керек
Dialogue: 0,0:12:49.00,0:12:51.03,Default,,0,0,0,,Мен саған көрінетін перде жоқ дедім.
Dialogue: 0,0:12:51.06,0:12:52.02,Default,,0,0,0,,Шулы
Dialogue: 0,0:12:52.04,0:12:53.07,Default,,0,0,0,,Жарайды, кет.
Dialogue: 0,0:12:53.08,0:12:55.04,Default,,0,0,0,,Жоқ, жібер
Dialogue: 0,0:12:55.06,0:12:56.00,Default,,0,0,0,,Эй
Dialogue: 0,0:13:04.00,0:13:04.50,Default,,0,0,0,,Әкем
Dialogue: 0,0:13:12.05,0:13:13.03,Default,,0,0,0,,Мичиру
Dialogue: 0,0:13:22.08,0:13:24.09,Default,,0,0,0,,Түсіру
Dialogue: 0,0:13:32.03,0:13:33.00,Default,,0,0,0,,Әке.
Dialogue: 0,0:13:44.04,0:13:46.05,Default,,0,0,0,,Мен ең нашармын
Dialogue: 0,0:13:46.09,0:13:50.02,Default,,0,0,0,,Егер олар болмаса, мұның ешқайсысы болмас еді.
Dialogue: 0,0:13:51.00,0:13:52.09,Default,,0,0,0,,Бірақ неге қазір...
Dialogue: 0,0:13:54.01,0:13:57.01,Default,,0,0,0,,Мен қазір қолымнан келгенін істеймін
Dialogue: 0,0:13:58.00,0:14:01.06,Default,,0,0,0,,Соута-кун үшін мен Марша-санды міндетті түрде тауып қорғаймын.
Dialogue: 0,0:14:03.05,0:14:04.04,Default,,0,0,0,,Тіпті Казуки-сан
Dialogue: 0,0:14:04.09,0:14:07.07,Default,,0,0,0,,Менің ойымша, Маршаны табу басты міндет болды.
Dialogue: 0,0:14:08.07,0:14:12.01,Default,,0,0,0,,Әкеңнің басынан өткен оқиғаны қайталағым келмейді.
Dialogue: 0,0:14:13.06,0:14:16.09,Default,,0,0,0,,Уау, мен де соны түсіндім.
Dialogue: 0,0:14:21.09,0:14:24.00,Default,,0,0,0,,Бұдан былай бөлек іздейік.
Dialogue: 0,0:14:24.01,0:14:24.51,Default,,0,0,0,,Иә
Dialogue: 0,0:14:31.07,0:14:33.06,Default,,0,0,0,,Сіздің аға буыныңыз қайсысы?
Dialogue: 0,0:14:33.08,0:14:35.09,Default,,0,0,0,,Зак бірдеңе деді.
Dialogue: 0,0:14:36.03,0:14:37.07,Default,,0,0,0,,Бөлек
Dialogue: 0,0:14:48.04,0:14:50.03,Default,,0,0,0,,А, мен жасырынатын жерді таптым.
Dialogue: 0,0:14:50.05,0:14:52.00,Default,,0,0,0,,Бұл Мононокеге байланысты ма?
Dialogue: 0,0:14:52.04,0:14:53.00,Default,,0,0,0,,Ясутака
Dialogue: 0,0:14:54.08,0:14:58.07,Default,,0,0,0,,Ой, қара коллектордың алаңсыз ұйықтап жатқанын көргім келеді.
Dialogue: 0,0:14:59.03,0:15:01.08,Default,,0,0,0,,Марсия жоғалып кетті
Dialogue: 0,0:15:04.02,0:15:06.02,Default,,0,0,0,,Бұл толығымен созылған.
Dialogue: 0,0:15:06.06,0:15:07.07,Default,,0,0,0,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:15:09.00,0:15:10.07,Default,,0,0,0,,Бұл жаман емес пе?
Dialogue: 0,0:15:13.07,0:15:17.00,Default,,0,0,0,,Жасыратын жердегі жағдайға қарағанда, Марша жалғыз қашып кеткен сияқты.
Dialogue: 0,0:15:17.05,0:15:18.03,Default,,0,0,0,,Қашу
Dialogue: 0,0:15:19.02,0:15:21.01,Default,,0,0,0,,Саяхатшы болудың жоғары мүмкіндігі
Dialogue: 0,0:15:23.04,0:15:24.01,Default,,0,0,0,,Барлығы тыңдайды
Dialogue: 0,0:15:24.08,0:15:27.00,Default,,0,0,0,,Бұдан былай Маршаны қорғаудан бас тарт.
Dialogue: 0,0:15:28.00,0:15:30.03,Default,,0,0,0,,Не істесең де, Маршаны тоқтат.
Dialogue: 0,0:15:30.06,0:15:31.08,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды түсіндім.
Dialogue: 0,0:15:33.06,0:15:35.05,Default,,0,0,0,,Бұл жерде ештеңе істемесек те
Dialogue: 0,0:15:35.09,0:15:38.03,Default,,0,0,0,,Марсияны R.SECURITY жояды
Dialogue: 0,0:15:39.04,0:15:40.01,Default,,0,0,0,,бірақ манга суретшісінің үйіне алты минут ерте бару—
Dialogue: 0,0:15:40.08,0:15:44.02,Default,,0,0,0,,Ең болмаса жауапкершілікті алып, өз қолымызбен жинап алайық.
Dialogue: 0,0:15:45.02,0:15:47.03,Default,,0,0,0,,Бұл да біздің жұмысымыз.
Dialogue: 0,0:15:48.07,0:15:50.03,Default,,0,0,0,,Мен мұның болғанына сене алар емеспін
Dialogue: 0,0:15:51.00,0:15:54.03,Default,,0,0,0,,Марша табылса да, Цукаса оған қарау керек.
Dialogue: 0,0:15:55.01,0:15:55.51,Default,,0,0,0,,Ира
Dialogue: 0,0:15:56.09,0:15:58.02,Default,,0,0,0,,Мен бірдеңе істеймін
Dialogue: 0,0:15:59.00,0:16:01.01,Default,,0,0,0,,Цукаса Цукаса істей алатын нәрсені жасады.
Dialogue: 0,0:16:01.07,0:16:04.01,Default,,0,0,0,,Енді бұл менің жұмысым.
Dialogue: 0,0:16:05.00,0:16:07.02,Default,,0,0,0,,Менің ойымша, рөлдерді бөлу осыған байланысты.
Dialogue: 0,0:16:09.01,0:16:09.51,Default,,0,0,0,,Бөлек
Dialogue: 0,0:16:14.01,0:16:16.04,Default,,0,0,0,,Мен Сута-кунға уәде бердім.
Dialogue: 0,0:16:17.02,0:16:19.03,Default,,0,0,0,,Ол міндетті түрде Марсияны қайтарады.
Dialogue: 0,0:16:32.04,0:16:33.02,Default,,0,0,0,,Марсия
Dialogue: 0,0:16:33.02,0:16:33.52,Default,,0,0,0,,Цукаса
Dialogue: 0,0:16:44.03,0:16:47.09,Default,,0,0,0,,Гиддия 81920 сағаттан кейін
Dialogue: 0,0:16:48.01,0:16:50.04,Default,,0,0,0,,Тұлға мен естеліктер бірте-бірте жойылады
Dialogue: 0,0:16:51.01,0:16:52.05,Default,,0,0,0,,Цукаса, артқа тұр.
Dialogue: 0,0:17:00.00,0:17:03.05,Default,,0,0,0,,Естеліктер сіз үшін ауыр болды ма?
Dialogue: 0,0:17:04.05,0:17:05.02,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:17:08.00,0:17:08.50,Default,,0,0,0,,Марша
Dialogue: 0,0:17:09.00,0:17:10.00,Default,,0,0,0,,Сота-кун
Dialogue: 0,0:17:10.01,0:17:10.51,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:17:21.01,0:17:21.51,Default,,0,0,0,,Марсия
Dialogue: 0,0:17:22.08,0:17:24.02,Default,,0,0,0,,Бұл жақсы емес, қаш, Соута.
Dialogue: 0,0:17:31.00,0:17:33.02,Default,,0,0,0,,Кешіріңіз, мен Марсияны таптым.
Dialogue: 0,0:17:33.04,0:17:35.01,Default,,0,0,0,,В-4 ауданына қашып кетті
Dialogue: 0,0:17:35.04,0:17:38.07,Default,,0,0,0,,Сондай-ақ, Сута-кун қазір Маша-санмен бірге.
Dialogue: 0,0:17:39.08,0:17:41.04,Default,,0,0,0,,Сота-кун, неге?
Dialogue: 0,0:17:41.09,0:17:42.08,Default,,0,0,0,,Исла жақсы ма?
Dialogue: 0,0:17:43.01,0:17:43.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:44.07,0:17:46.02,Default,,0,0,0,,Сондықтан мен оны айтпаймын.
Dialogue: 0,0:17:46.06,0:17:49.04,Default,,0,0,0,,Мен инженер жіберемін, Цукаса мен басқалары сонда күтіп тұр.
Dialogue: 0,0:17:49.07,0:17:50.09,Default,,0,0,0,,Ислаға абайсызда ештеңе жасауға жол берме.
Dialogue: 0,0:17:51.02,0:17:51.52,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:52.00,0:17:52.50,Default,,0,0,0,,Мені тыңда
Dialogue: 0,0:17:54.03,0:17:55.00,Default,,0,0,0,,Барайық
Dialogue: 0,0:17:57.02,0:18:00.03,Default,,0,0,0,,Жоқ, менің мұнда күтуге уақытым жоқ.
Dialogue: 0,0:18:00.08,0:18:02.02,Default,,0,0,0,,Осы қарқынмен бұл Сута-кунға дейін.
Dialogue: 0,0:18:03.05,0:18:04.08,Default,,0,0,0,,Жалғыз қуып барайын ба?
Dialogue: 0,0:18:05.07,0:18:06.04,Default,,0,0,0,,Цукаса
Dialogue: 0,0:18:06.08,0:18:10.01,Default,,0,0,0,,Қазір бәрі жақсы, Машаның артынан барайық.
Dialogue: 0,0:18:10.08,0:18:12.02,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл қисынсыз.
Dialogue: 0,0:18:13.07,0:18:14.04,Default,,0,0,0,,Цукаса
Dialogue: 0,0:18:15.02,0:18:16.07,Default,,0,0,0,,Кедергі болма
Dialogue: 0,0:18:17.03,0:18:20.02,Default,,0,0,0,,Сондықтан менің рөлімді тартып алмаңыз.
Dialogue: 0,0:18:20.07,0:18:21.02,Default,,0,0,0,,Ира
Dialogue: 0,0:18:22.00,0:18:23.08,Default,,0,0,0,,Біз бір жұппыз
Dialogue: 0,0:18:25.00,0:18:25.50,Default,,0,0,0,,Ицумида-сан ба?
Dialogue: 0,0:18:33.07,0:18:35.03,Default,,0,0,0,,Сәлем, Ира.
Dialogue: 0,0:18:36.04,0:18:39.07,Default,,0,0,0,,Бұл шынымен де Сута үшін бата.
Dialogue: 0,0:18:41.03,0:18:42.09,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:18:43.09,0:18:48.00,Default,,0,0,0,,Бақытты немесе әдемі естеліктер міндетті түрде құтқаруға әкелмейді.
Dialogue: 0,0:18:49.02,0:18:50.07,Default,,0,0,0,,Естеліктер соғұрлым әдемі болады
Dialogue: 0,0:18:51.01,0:18:52.05,Default,,0,0,0,,Ауыруы мүмкін
Dialogue: 0,0:18:53.02,0:18:54.06,Default,,0,0,0,,Бұл қорқынышты болуы мүмкін
Dialogue: 0,0:18:55.05,0:18:57.02,Default,,0,0,0,,Кететіндер үшін
Dialogue: 0,0:18:57.07,0:18:59.03,Default,,0,0,0,,Артта қалғандар үшін
Dialogue: 0,0:18:59.09,0:19:02.04,Default,,0,0,0,,Сізге естеліктер қажет емес деп ойлайсыз ба?
Dialogue: 0,0:19:07.04,0:19:10.00,Default,,0,0,0,,Бұл мені мұңайтады.
Dialogue: 0,0:19:11.06,0:19:13.03,Default,,0,0,0,,Эй, сен нені айтып тұрсың?
Dialogue: 0,0:19:13.05,0:19:15.09,Default,,0,0,0,,Мен де Уандерермен жұмыс істеуге нұсқау алдым.
Dialogue: 0,0:19:16.00,0:19:18.01,Default,,0,0,0,,Мен сенің есегіңді сүртіп жатырмын.
Dialogue: 0,0:19:18.04,0:19:20.06,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:19:20.09,0:19:22.06,Default,,0,0,0,,Онда мен барлығын осында аяқтаймын.
Dialogue: 0,0:19:23.01,0:19:25.08,Default,,0,0,0,,Сіз де біреудің бөксесін сүртпейсіз.
Dialogue: 0,0:19:25.09,0:19:27.06,Default,,0,0,0,,Бірақ жоғарыдан нұсқаулар болғандықтан
Dialogue: 0,0:19:27.06,0:19:29.06,Default,,0,0,0,,Ах, менің аяғым ауырды.
Dialogue: 0,0:19:29.09,0:19:32.08,Default,,0,0,0,,3 жыл бұрын жарақат алған оң аяғым қатты ауырады.
Dialogue: 0,0:19:33.06,0:19:35.02,Default,,0,0,0,,Сіз оны жаңа ғана суға жібердіңіз.
Dialogue: 0,0:19:35.05,0:19:38.01,Default,,0,0,0,,Әсіресе жаңбыр жауғанда ауырады.
Dialogue: 0,0:19:38.03,0:19:40.03,Default,,0,0,0,,Протездік аяқ қолайсыз.
Dialogue: 0,0:19:42.08,0:19:44.02,Default,,0,0,0,,Бар болғаны 30 минут күтіңіз
Dialogue: 0,0:19:44.07,0:19:45.04,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:00.01,0:20:00.51,Default,,0,0,0,,Марсия
Dialogue: 0,0:20:10.01,0:20:11.07,Default,,0,0,0,,Цукаса күт
Dialogue: 0,0:20:11.08,0:20:12.04,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:20:12.08,0:20:13.06,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:13.09,0:20:14.06,Default,,0,0,0,,Цукаса
Dialogue: 0,0:20:15.05,0:20:17.04,Default,,0,0,0,,Марсия, тыңдашы.
Dialogue: 0,0:20:18.00,0:20:20.05,Default,,0,0,0,,Мен сені және Сута-кунды құтқарғым келеді.
Dialogue: 0,0:20:21.05,0:20:25.00,Default,,0,0,0,,Егер сізде әлі де ең кішкентай естеліктер қалса
Dialogue: 0,0:20:25.07,0:20:26.09,Default,,0,0,0,,Қарсылық көрсетпеу
Dialogue: 0,0:20:29.02,0:20:30.05,Default,,0,0,0,,Сен де айттың ғой, солай ма?
Dialogue: 0,0:20:31.02,0:20:34.02,Default,,0,0,0,,Ол сені бақылап жүргенін айтады, Сута.
Dialogue: 0,0:20:35.00,0:20:36.07,Default,,0,0,0,,Біз мәңгі бірге боламыз
Dialogue: 0,0:20:44.06,0:20:47.00,Default,,0,0,0,,Жүр, қолымды ал.
Dialogue: 0,0:20:48.00,0:20:49.03,Default,,0,0,0,,Міне.
Dialogue: 0,0:21:02.07,0:21:04.02,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:21:04.07,0:21:06.08,Default,,0,0,0,,Жарайды, үрейленбе.
Dialogue: 0,0:21:08.04,0:21:09.00,Default,,0,0,0,,Баяу
Dialogue: 0,0:21:10.09,0:21:11.07,Default,,0,0,0,,Баяу
Dialogue: 0,0:21:18.04,0:21:19.02,Default,,0,0,0,,Марсия
Dialogue: 0,0:21:26.08,0:21:27.07,Default,,0,0,0,,Марсия
Dialogue: 0,0:21:54.05,0:21:57.05,Default,,0,0,0,,Маршер
Dialogue: 0,0:22:01.07,0:22:03.07,Default,,0,0,0,,Ештеңе істей алмаймыз.
Dialogue: 0,0:22:45.01,0:22:48.04,Default,,0,0,0,,Ажырасқан сені іздедім.
Dialogue: 0,0:22:48.07,0:22:52.02,Default,,0,0,0,,Мені шақырған дауыс өшіп қалды
Dialogue: 0,0:22:52.04,0:22:59.08,Default,,0,0,0,,Мен ұстаған қол дірілдеп тұрды.
Dialogue: 0,0:23:00.02,0:23:03.08,Default,,0,0,0,,Біздің сезімдер
Dialogue: 0,0:23:04.00,0:23:09.00,Default,,0,0,0,,Қайтаруға болмайтын уақытты қабыл алыңыз
Dialogue: 0,0:23:09.02,0:23:13.07,Default,,0,0,0,,Мен биік ұшамын
Dialogue: 0,0:23:14.05,0:23:18.01,Default,,0,0,0,,Аспанда жарқыраған калейдоскоп
Dialogue: 0,0:23:18.03,0:23:22.01,Default,,0,0,0,,Сіз ыңғайсызданып күлдіңіз
Dialogue: 0,0:23:22.04,0:23:28.01,Default,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:23:29.03,0:23:32.08,Default,,0,0,0,,Жарық ерігенге дейін
Dialogue: 0,0:23:33.00,0:23:36.00,Default,,0,0,0,,Мен шын жүректен үміттенемін
Dialogue: 0,0:23:36.02,0:23:48.02,Default,,0,0,0,,Осы сәтті ұмытпа
Dialogue: 0,0:23:49.52,0:23:54.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
