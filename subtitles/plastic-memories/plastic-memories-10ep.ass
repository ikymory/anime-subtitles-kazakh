Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.40,0:00:43.00,OPJP,,0,0,0,,Жарықты жинау
Dialogue: 0,0:00:51.00,0:00:55.50,OPJP,,0,0,0,,Қоштасудан естеліктер
Dialogue: 0,0:00:56.60,0:01:02.67,OPJP,,0,0,0,,Көзіме тамсанып, алысқа қадалған арман
Dialogue: 0,0:01:02.85,0:01:08.10,OPJP,,0,0,0,,Ән жады бұзылады
Dialogue: 0,0:01:08.40,0:01:13.50,OPJP,,0,0,0,,Жалғыздықтың көз жасын ақырын сүртейік
Dialogue: 0,0:01:13.80,0:01:20.70,OPJP,,0,0,0,,Ұзартылған қол - айналмалы дөңгелек, оны абайлап алыңыз
Dialogue: 0,0:01:21.01,0:01:26.00,OPJP,,0,0,0,,Оянғалы тұрған жадының үзінділері
Dialogue: 0,0:01:27.00,0:01:31.90,OPJP,,0,0,0,,Мен төмен қарап, жоқ болып кетсін деп дұға етемін, бірақ
Dialogue: 0,0:01:32.01,0:01:38.00,OPJP,,0,0,0,,Бұл сіз тапқан дауыс
Dialogue: 0,0:01:38.30,0:01:45.00,OPJP,,0,0,0,,Сағат тілі қозғала бастайды, көп ұзамай дүниенің түсі өзгереді
Dialogue: 0,0:01:45.30,0:01:51.20,OPJP,,0,0,0,,Менің пластикалық жүрегім жарқырайды
Dialogue: 0,0:01:51.47,0:01:56.10,OPJP,,0,0,0,,Ұмытпа, есте сақта
Dialogue: 0,0:01:56.51,0:02:03.00,OPJP,,0,0,0,,Бір күні тағы кездескенше
Dialogue: 0,0:22:45.10,0:22:48.44,EDJP,,0,0,0,,Ажырасқан сені іздедім.
Dialogue: 0,0:22:48.70,0:22:52.20,EDJP,,0,0,0,,Мені шақырған дауыс өшіп қалды
Dialogue: 0,0:22:52.40,0:22:59.80,EDJP,,0,0,0,,Мен ұстаған қол дірілдеп тұрды.
Dialogue: 0,0:23:00.28,0:23:03.80,EDJP,,0,0,0,,Біздің сезімдер
Dialogue: 0,0:23:04.00,0:23:09.00,EDJP,,0,0,0,,Қайтаруға болмайтын уақытты қабыл алыңыз
Dialogue: 0,0:23:09.21,0:23:13.71,EDJP,,0,0,0,,Мен биік ұшамын
Dialogue: 0,0:23:14.51,0:23:18.10,EDJP,,0,0,0,,Аспанда жарқыраған калейдоскоп
Dialogue: 0,0:23:18.30,0:23:22.10,EDJP,,0,0,0,,Сіз ыңғайсызданып күлдіңіз
Dialogue: 0,0:23:22.41,0:23:28.10,EDJP,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:23:29.30,0:23:32.86,EDJP,,0,0,0,,Жарық ерігенге дейін
Dialogue: 0,0:23:33.00,0:23:36.00,EDJP,,0,0,0,,Мен шын жүректен үміттенемін
Dialogue: 0,0:23:36.20,0:23:48.20,EDJP,,0,0,0,,Осы сәтті мәңгі естен шығарма
Dialogue: 0,0:18:35.39,0:18:43.30,INJP,,0,0,0,,Қандай да бір себептермен мұңайсам да
Dialogue: 0,0:18:45.00,0:18:54.03,INJP,,0,0,0,,Мен сенің күлгеніңді көрдім
Dialogue: 0,0:18:57.00,0:19:01.30,INJP,,0,0,0,,«табылмады...» ау дегендей
Dialogue: 0,0:19:01.61,0:19:06.00,INJP,,0,0,0,,Білмеу сезімі
Dialogue: 0,0:19:06.61,0:19:16.00,INJP,,0,0,0,,Сіз маған сыйлаған көптеген естеліктер
Dialogue: 0,0:19:16.81,0:19:22.30,INJP,,0,0,0,,Дірілдейтін жүрек Платоникалық
Dialogue: 0,0:19:22.50,0:19:26.21,INJP,,0,0,0,,Толып жатқан сезімдер
Dialogue: 0,0:19:26.35,0:19:32.35,INJP,,0,0,0,,Иә, бұл тек сіз туралы.
Dialogue: 0,0:19:32.35,0:19:35.80,INJP,,0,0,0,,Махаббат сезімі
Dialogue: 0,0:19:36.00,0:19:40.99,INJP,,0,0,0,,Айтылса
Dialogue: 0,0:19:41.67,0:19:50.54,INJP,,0,0,0,,Ертең аздап өзгере аламын ба?
Dialogue: 0,0:19:51.20,0:19:59.60,INJP,,0,0,0,,Мен сіздермен көптеген естеліктер жасай аламын деп үміттенемін.
Dialogue: 0,0:19:59.60,0:20:02.81,INJP,,0,0,0,,Намаз оқу
Dialogue: 0,0:20:09.01,0:20:17.00,INJP,,0,0,0,,Дұрыс күле алмаған түндерім болды.
Dialogue: 0,0:20:18.60,0:20:28.56,INJP,,0,0,0,,Бірақ сен мені күттің.
Dialogue: 0,0:20:30.51,0:20:35.00,INJP,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:20:35.31,0:20:39.60,INJP,,0,0,0,,Мен ойладым
Dialogue: 0,0:20:40.21,0:20:49.86,INJP,,0,0,0,,ah Өсіп келе жатқан сезімімнің «атын» байқадым
Dialogue: 0,0:20:52.90,0:20:58.26,INJP,,0,0,0,,Қайырлы таң, көріскенше, қош келдіңіз.
Dialogue: 0,0:20:58.45,0:21:02.79,INJP,,0,0,0,,Жазықсыз сөздер
Dialogue: 0,0:21:03.00,0:21:07.80,INJP,,0,0,0,,Мен оны мәңгілікке ауыстырғым келеді
Dialogue: 0,0:21:08.10,0:21:15.90,INJP,,0,0,0,,Жаныңызда болыңыз
Dialogue: 0,0:21:19.20,0:21:23.20,INJP,,0,0,0,,ah жүрек платоникалық
Dialogue: 0,0:21:23.70,0:21:27.60,INJP,,0,0,0,,Толып жатқан сезімдер
Dialogue: 0,0:21:27.60,0:21:33.51,INJP,,0,0,0,,Иә, бұл тек сіз туралы.
Dialogue: 0,0:21:33.51,0:21:37.11,INJP,,0,0,0,,Махаббат сезімі
Dialogue: 0,0:21:37.21,0:21:42.55,INJP,,0,0,0,,Егер хабарланса
Dialogue: 0,0:21:42.90,0:21:52.20,INJP,,0,0,0,,Ертең аздап өзгере аламын ба?
Dialogue: 0,0:21:52.80,0:22:00.80,INJP,,0,0,0,,Мен сізбен көптеген естеліктер жасай аламын деп үміттенемін.
Dialogue: 0,0:22:00.80,0:22:07.00,INJP,,0,0,0,,Намаз оқу
Dialogue: 0,0:00:01.53,0:00:02.77,JPN,,0,0,0,,Сіз естіген жоқсыз ба?
Dialogue: 0,0:00:03.23,0:00:04.51,JPN,,0,0,0,,Серіктестіктің таратылуы
Dialogue: 0,0:00:04.70,0:00:06.97,JPN,,0,0,0,,Бұл... неге кенеттен?
Dialogue: 0,0:00:07.25,0:00:08.66,JPN,,0,0,0,,Себебін айтыңызшы
Dialogue: 0,0:00:09.21,0:00:10.54,JPN,,0,0,0,,Міне, солай.
Dialogue: 0,0:00:11.06,0:00:12.99,JPN,,0,0,0,,Қызметтік романстарға тыйым салынады.
Dialogue: 0,0:00:14.23,0:00:17.26,JPN,,0,0,0,,Сіз бұрын-соңды мұндай сөзді айтқан жоқсыз, солай ма?
Dialogue: 0,0:00:17.49,0:00:20.28,JPN,,0,0,0,,Әйтеуір, мен Ислаға қамқор боламын.
Dialogue: 0,0:00:20.70,0:00:22.94,JPN,,0,0,0,,Цукаса ертеңнен бастап Констанспен бірге болады.
Dialogue: 0,0:00:23.17,0:00:23.75,JPN,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:00:24.36,0:00:25.06,JPN,,0,0,0,,Бірақ...
Dialogue: 0,0:00:25.75,0:00:26.46,JPN,,0,0,0,,Түсіндім
Dialogue: 0,0:00:29.71,0:00:30.58,JPN,,0,0,0,,Енді түсіндім
Dialogue: 0,0:00:32.12,0:00:32.90,JPN,,0,0,0,,Ира
Dialogue: 0,0:02:11.40,0:02:12.95,JPN,,0,0,0,,Бұл былай деді:
Dialogue: 0,0:02:13.67,0:02:15.35,JPN,,0,0,0,,Не болды?
Dialogue: 0,0:02:19.50,0:02:21.58,JPN,,0,0,0,,Констанс қайда болды?
Dialogue: 0,0:02:22.20,0:02:23.57,JPN,,0,0,0,,Сәлем Констанс
Dialogue: 0,0:02:24.05,0:02:25.17,JPN,,0,0,0,,Констанс
Dialogue: 0,0:02:25.74,0:02:28.29,JPN,,0,0,0,,Неге осында келіп сөйлеспейсің?
Dialogue: 0,0:02:29.01,0:02:31.43,JPN,,0,0,0,,Маған сиқырлы амалдар көрсетсеңдер мен қарсы емеспін.
Dialogue: 0,0:02:32.40,0:02:34.10,JPN,,0,0,0,,14-ші эпизод: Флоренцияға экспресс пойыз
Dialogue: 0,0:02:34.58,0:02:37.95,JPN,,0,0,0,,Қымбаттама, тез шық.
Dialogue: 0,0:02:38.16,0:02:38.81,JPN,,0,0,0,,Кадзуки
Dialogue: 0,0:02:40.47,0:02:43.10,JPN,,0,0,0,,Мен менеджер Яманобемен түнде балық аулауға барамын.
Dialogue: 0,0:02:43.29,0:02:44.30,JPN,,0,0,0,,Мен бүгін қайтпаймын.
Dialogue: 0,0:02:44.62,0:02:45.36,JPN,,0,0,0,,Констанс
Dialogue: 0,0:02:45.70,0:02:48.39,JPN,,0,0,0,,Бұл не? Бұл сөзсіз өтірік.
Dialogue: 0,0:02:48.63,0:02:51.12,JPN,,0,0,0,,Түнгі балық аулау хобби екенін естіген емеспін.
Dialogue: 0,0:02:52.02,0:02:55.03,JPN,,0,0,0,,Менің Исланы үйге әкелетінімді оқыдың ба?
Dialogue: 0,0:02:55.40,0:02:56.99,JPN,,0,0,0,,Әлгі бейбақ
Dialogue: 0,0:03:03.68,0:03:05.12,JPN,,0,0,0,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:03:10.89,0:03:13.46,JPN,,0,0,0,,Ол болады
Dialogue: 0,0:03:33.63,0:03:34.44,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:39.27,0:03:40.89,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:43.41,0:03:44.33,JPN,,0,0,0,,Бұл…
Dialogue: 0,0:03:44.60,0:03:45.71,JPN,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:03:46.81,0:03:47.96,JPN,,0,0,0,,Мүлдем
Dialogue: 0,0:03:50.64,0:03:51.99,JPN,,0,0,0,,Құрылғыңызға қараңыз
Dialogue: 0,0:03:53.72,0:03:57.32,JPN,,0,0,0,,Менің ішу әдетім үш жыл бұрынғыдан бері өзгерген жоқ.
Dialogue: 0,0:04:04.50,0:04:05.97,JPN,,0,0,0,,Эй, сен
Dialogue: 0,0:04:06.57,0:04:08.49,JPN,,0,0,0,,Цукаса туралы не істеуді жоспарлап отырсыз?
Dialogue: 0,0:04:10.39,0:04:11.18,JPN,,0,0,0,,Маған келсек
Dialogue: 0,0:04:11.18,0:04:15.07,JPN,,0,0,0,,Қайтпасақ екеумізге де жақсы деп ойлаймын.
Dialogue: 0,0:04:23.90,0:04:26.21,JPN,,0,0,0,,Бір-біріне...
Dialogue: 0,0:04:30.87,0:04:33.00,JPN,,0,0,0,,Қызметтік романтикаға тыйым салынған ба?
Dialogue: 0,0:04:33.18,0:04:35.42,JPN,,0,0,0,,Сіз мұны айттыңыз ба? Казуки-сан?
Dialogue: 0,0:04:40.55,0:04:41.45,JPN,,0,0,0,,Мен оны бірінші рет естіп тұрмын.
Dialogue: 0,0:04:42.03,0:04:43.14,JPN,,0,0,0,,Мен оны бірінші рет естіп тұрмын.
Dialogue: 0,0:04:44.21,0:04:45.04,JPN,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:45.45,0:04:49.62,JPN,,0,0,0,,Мен Кадзуки-санның да бұрын кеңселік романс болғанын естідім.
Dialogue: 0,0:04:50.51,0:04:51.75,JPN,,0,0,0,,Бұл жай ғана өсек
Dialogue: 0,0:04:52.45,0:04:54.57,JPN,,0,0,0,,Шерри қауесетті біле ме?
Dialogue: 0,0:04:57.00,0:04:58.20,JPN,,0,0,0,,Бұл таныс жүз.
Dialogue: 0,0:04:58.46,0:05:00.16,JPN,,0,0,0,,сұраңыз, айтыңызшы
Dialogue: 0,0:05:00.56,0:05:04.54,JPN,,0,0,0,,Бұл олардың кеңселік романстарға тыйым салынғанын айтқанымен байланысты болуы мүмкін.
Dialogue: 0,0:05:05.58,0:05:08.04,JPN,,0,0,0,,Кадзукидің абыройы үшін олай айта алмаймын.
Dialogue: 0,0:05:08.52,0:05:09.30,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:10.61,0:05:11.71,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:19.66,0:05:21.63,JPN,,0,0,0,,Сондықтан абай болыңыз.
Dialogue: 0,0:05:22.41,0:05:24.22,JPN,,0,0,0,,Осы уақытқа дейін сұрақтарыңыз бар ма?
Dialogue: 0,0:05:30.38,0:05:32.63,JPN,,0,0,0,,Сондай-ақ, кенеттен болғанымен,
Dialogue: 0,0:05:32.98,0:05:36.18,JPN,,0,0,0,,Бүгіннен бастап мен және Цукаса серіктес боламыз.
Dialogue: 0,0:05:37.72,0:05:40.36,JPN,,0,0,0,,Рұқсатсыз менің басымнан осындай бірдеңе болса қиналып қалар едім.
Dialogue: 0,0:05:40.36,0:05:42.96,JPN,,0,0,0,,Констанс Кешіріңіз, бұл солай.
Dialogue: 0,0:05:43.07,0:05:43.73,JPN,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:05:44.10,0:05:44.52,JPN,,0,0,0,,Иә
Dialogue: 0,0:05:45.24,0:05:45.71,JPN,,0,0,0,,Бар болғаны
Dialogue: 0,0:05:46.10,0:05:46.81,JPN,,0,0,0,,Казуки-сан
Dialogue: 0,0:05:47.40,0:05:50.32,JPN,,0,0,0,,Мен Исламен жұмысты тоқтатқым келмейді.
Dialogue: 0,0:05:53.50,0:05:54.23,JPN,,0,0,0,,Еріту
Dialogue: 0,0:05:54.68,0:05:55.58,JPN,,0,0,0,,Цукасаны артта қалдырыңыз.
Dialogue: 0,0:05:59.61,0:06:00.79,JPN_Up,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:01.40,0:06:04.03,JPN_Up,,0,0,0,,Секция бастығының ұлылығын түсінер күн туар.
Dialogue: 0,0:06:06.61,0:06:07.44,JPN,,0,0,0,,Қызық па?
Dialogue: 0,0:06:15.85,0:06:16.80,JPN,,0,0,0,,Гвуу…
Dialogue: 0,0:06:17.32,0:06:19.81,JPN,,0,0,0,,Мен Исланың серіктесі болуға қалай оралуға болады?
Dialogue: 0,0:06:20.50,0:06:22.42,JPN,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:06:25.10,0:06:26.27,JPN,,0,0,0,,Бастапқыда
Dialogue: 0,0:06:26.41,0:06:29.45,JPN,,0,0,0,,Менің ашуланғанымды мойындағаныңыз үшін шығар.
Dialogue: 0,0:06:30.05,0:06:31.29,JPN,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:06:31.76,0:06:34.53,JPN,,0,0,0,,Бірақ мен оның осылай аяқталуына жол бере алмаймын.
Dialogue: 0,0:06:36.31,0:06:39.34,JPN,,0,0,0,,Офистік романтикаға тыйым салу - бұл жай ғана сылтау.
Dialogue: 0,0:06:40.20,0:06:41.80,JPN,,0,0,0,,Мен оны көре алмадым.
Dialogue: 0,0:06:42.43,0:06:44.68,JPN,,0,0,0,,Мен сені және Исланы осылай жалғыз қалдырсам.
Dialogue: 0,0:06:45.10,0:06:47.45,JPN,,0,0,0,,Мен оны қайтара алмайтындай сезінемін.
Dialogue: 0,0:06:47.78,0:06:49.03,JPN,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:06:49.29,0:06:51.29,JPN,,0,0,0,,Менің көзім мені алдамайды
Dialogue: 0,0:06:51.91,0:06:54.84,JPN,,0,0,0,,Шындығында, Ира бұл туралы бүгін таңертең айтты.
Dialogue: 0,0:06:55.32,0:06:58.23,JPN,,0,0,0,,«Цукасадан аулақ болу екеумізге де керек».
Dialogue: 0,0:06:59.34,0:07:00.49,JPN,,0,0,0,,Маған бұл өте ұнамайды.
Dialogue: 0,0:07:02.51,0:07:03.34,JPN,,0,0,0,,Арал...
Dialogue: 0,0:07:06.30,0:07:09.11,JPN,,0,0,0,,Сіз әлі дайынсыз ба?
Dialogue: 0,0:07:09.54,0:07:10.02,JPN,,0,0,0,,Иә
Dialogue: 0,0:07:10.42,0:07:12.54,JPN,,0,0,0,,Олай болса қазір маған қалдырыңыз.
Dialogue: 0,0:07:14.31,0:07:19.53,JPN,,0,0,0,,Мен Айраның мазасыз тамырына тікелей соққы беремін.
Dialogue: 0,0:07:20.40,0:07:21.73,JPN,,0,0,0,,Аа.
Dialogue: 0,0:07:28.33,0:07:29.40,JPN,,0,0,0,,Не айтылды?
Dialogue: 0,0:07:29.78,0:07:31.89,JPN,,0,0,0,,Исланы жалғыз қалдырайық.
Dialogue: 0,0:07:32.41,0:07:35.22,JPN,,0,0,0,,Жыныс мүшелерін тағы ұрайын дегендей бірдеңе айтты.
Dialogue: 0,0:07:36.29,0:07:37.68,JPN,,0,0,0,,А, мен оны білдім
Dialogue: 0,0:07:38.30,0:07:40.23,JPN,,0,0,0,,Казуки-сан, сен мүлдем байсалды емессің.
Dialogue: 0,0:07:40.66,0:07:42.51,JPN,,0,0,0,,Исла аман-есен шыға алмауы мүмкін.
Dialogue: 0,0:07:43.44,0:07:45.56,JPN,,0,0,0,,Бұл адам өте мейірімсіз.
Dialogue: 0,0:07:45.90,0:07:49.14,JPN,,0,0,0,,Мичируге де біраз уақыт бұрын жақсы қараған.
Dialogue: 0,0:07:49.38,0:07:52.50,JPN,,0,0,0,,Ол кезде мен бір айда 10 кг арықтайтын едім.
Dialogue: 0,0:07:56.52,0:07:59.69,JPN,,0,0,0,,Цукаса-кун, бұрын жақсы болдыңыз ба?
Dialogue: 0,0:08:00.10,0:08:03.31,JPN,,0,0,0,,Кадзуки-кунның итергіштігі мені қатты мазалайды.
Dialogue: 0,0:08:03.49,0:08:04.93,JPN,,0,0,0,,Тіпті бүгінгі мәселе
Dialogue: 0,0:08:06.01,0:08:07.90,JPN,,0,0,0,,Иә, менің ішім ауырады...
Dialogue: 0,0:08:10.96,0:08:12.21,JPN,,0,0,0,,Абайлаңыз
Dialogue: 0,0:08:13.74,0:08:15.72,JPN,,0,0,0,,Айраға келгенде, Казуки
Dialogue: 0,0:08:15.90,0:08:18.94,JPN,,0,0,0,,Сізге әдеттегіден гөрі сабырлы болу қиынырақ болады.
Dialogue: 0,0:08:20.70,0:08:23.11,JPN,,0,0,0,,Мен бұл тақырыпты бұрыннан қозғағанымда,
Dialogue: 0,0:08:23.11,0:08:25.81,JPN,,0,0,0,,Ол мас күйінде соққыға жығылған.
Dialogue: 0,0:08:26.22,0:08:27.42,JPN,,0,0,0,,Саке бөтелкесімен.
Dialogue: 0,0:08:28.61,0:08:32.70,JPN,,0,0,0,,Бірақ ол кезде мен адал, бейкүнә қыз едім.
Dialogue: 0,0:08:33.20,0:08:34.47,JPN,,0,0,0,,Ішімдік бөтелкесі емес...
Dialogue: 0,0:08:36.04,0:08:36.84,JPN,,0,0,0,,Цукаса-кун
Dialogue: 0,0:08:37.30,0:08:39.25,JPN,,0,0,0,,Сіз менің бөлмемді қалай ауыстыратынымды естідіңіз бе?
Dialogue: 0,0:08:40.48,0:08:40.99,JPN,,0,0,0,,Қараңыз
Dialogue: 0,0:08:41.31,0:08:44.13,JPN,,0,0,0,,Ереже Спортер мен Максман бірге тұрады.
Dialogue: 0,0:08:44.80,0:08:48.70,JPN,,0,0,0,,Осыған байланысты мен біреудің қайда қозғалатынын растауым керек.
Dialogue: 0,0:08:50.61,0:08:53.07,JPN,,0,0,0,,Қозғалмас бұрын сәл күте аласыз ба?
Dialogue: 0,0:08:54.39,0:08:56.05,JPN,,0,0,0,,Кадзуки-сан осылай деді ме?
Dialogue: 0,0:08:56.50,0:08:57.35,JPN,,0,0,0,,Бұл...
Dialogue: 0,0:08:58.45,0:08:58.90,JPN,,0,0,0,,Иә
Dialogue: 0,0:08:59.53,0:09:00.62,JPN,,0,0,0,,Мен осылай дедім.
Dialogue: 0,0:09:07.46,0:09:08.20,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:08.71,0:09:09.20,JPN,,0,0,0,,Түсінікті
Dialogue: 0,0:09:09.90,0:09:10.87,JPN,,0,0,0,,Сіз жақсы оқисыз деп үміттенемін
Dialogue: 0,0:09:13.24,0:09:14.70,JPN,,0,0,0,,Констанс Ум...
Dialogue: 0,0:09:14.81,0:09:15.90,JPN,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:09:16.57,0:09:18.43,JPN,,0,0,0,,Оның орнына жұмыс уақыты келді.
Dialogue: 0,0:09:18.71,0:09:19.75,JPN,,0,0,0,,Дайындаңыз
Dialogue: 0,0:09:21.73,0:09:24.10,JPN,,0,0,0,,Бір-бірімізге жақсылық жасайық
Dialogue: 0,0:09:24.80,0:09:27.10,JPN,,0,0,0,,Сіз және мен серіктеспіз.
Dialogue: 0,0:09:31.18,0:09:32.76,JPN,,0,0,0,,Жинақтың мақсаты - Сара
Dialogue: 0,0:09:33.26,0:09:35.10,JPN,,0,0,0,,Иесі – Антонио Горизонт
Dialogue: 0,0:09:35.80,0:09:39.34,JPN,,0,0,0,,Қарапайым тілмен айтсақ, әлгі қария мафияның басы.
Dialogue: 0,0:09:39.93,0:09:42.40,JPN,,0,0,0,,Жағдайға байланысты қиындыққа айналуы мүмкін.
Dialogue: 0,0:09:44.62,0:09:46.65,JPN,,0,0,0,,Мен Цукасаның баяндамасын оқыдым.
Dialogue: 0,0:09:47.35,0:09:50.23,JPN,,0,0,0,,Мен енді кептелмеймін деп ойлаймын.
Dialogue: 0,0:09:52.58,0:09:53.26,JPN,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:09:54.05,0:09:58.99,JPN,,0,0,0,,Менің есімде, сіз бұл бетті жасаған кездеріңіз әдетте жақсы болмай жатқанда болды.
Dialogue: 0,0:10:01.46,0:10:02.47,JPN,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:10:03.11,0:10:05.82,JPN,,0,0,0,,Мүмкін бұл жұмыс қазір сізге өте ыңғайлы.
Dialogue: 0,0:10:10.37,0:10:11.65,JPN,,0,0,0,,Бір аптадан кейін
Dialogue: 0,0:10:12.40,0:10:13.99,JPN,,0,0,0,,Жақында кездескенше, Льюис.
Dialogue: 0,0:10:14.60,0:10:15.34,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:10:15.61,0:10:17.33,JPN,,0,0,0,,Цукаса-сан Констанс-сан
Dialogue: 0,0:10:18.40,0:10:20.25,JPN,,0,0,0,,Констанс керемет
Dialogue: 0,0:10:20.77,0:10:22.58,JPN,,0,0,0,,Менің шаруам жоқ еді.
Dialogue: 0,0:10:23.32,0:10:27.10,JPN,,0,0,0,,Тіпті Цукаса да бұл қыздың жүрегін қатты ұстады.
Dialogue: 0,0:10:27.65,0:10:29.00,JPN,,0,0,0,,Қандай үлкен мәселе!
Dialogue: 0,0:10:29.65,0:10:30.48,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:38.91,0:10:40.21,JPN,,0,0,0,,Түске таяп қалды.
Dialogue: 0,0:10:49.96,0:10:51.80,JPN,,0,0,0,,Кадзукиге алаңдайсың ба?
Dialogue: 0,0:10:53.01,0:10:53.96,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:10:55.97,0:10:56.66,JPN,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:10:59.35,0:11:00.65,JPN,,0,0,0,,Сіз Цукасаны білесіз бе?
Dialogue: 0,0:11:01.52,0:11:03.50,JPN,,0,0,0,,Басқа терминалдық қызметтермен салыстырғанда
Dialogue: 0,0:11:03.93,0:11:06.23,JPN,,0,0,0,,Тек бізде басқа жинау әдісі бар.
Dialogue: 0,0:11:06.77,0:11:07.24,JPN,,0,0,0,,О
Dialogue: 0,0:11:07.81,0:11:10.20,JPN,,0,0,0,,Бұрын Эндимен жұмыс істегенде қандай сезімде болдыңыз?
Dialogue: 0,0:11:10.90,0:11:15.00,JPN,,0,0,0,,Менің ойымша, ол өте механикалық және басқа адамның жағдайына мән бермейді.
Dialogue: 0,0:11:16.28,0:11:20.59,JPN,,0,0,0,,Екінші жағынан, біз басқа адамның сезіміне мүмкіндігінше жанашырлықпен қарауға тырысамыз.
Dialogue: 0,0:11:21.33,0:11:24.47,JPN,,0,0,0,,Бұл әдісті алғашында Ира бастаған.
Dialogue: 0,0:11:25.54,0:11:26.45,JPN,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:11:27.08,0:11:28.65,JPN,,0,0,0,,Бұл көп шығын мен күш жұмсайды.
Dialogue: 0,0:11:29.38,0:11:33.17,JPN,,0,0,0,,Компания саясаты мұндай тәсілге жол бермейтіні анық.
Dialogue: 0,0:11:34.09,0:11:38.68,JPN,,0,0,0,,Тіпті Казуки Айраның адал әдістеріне ілесе алмады.
Dialogue: 0,0:11:39.51,0:11:42.55,JPN,,0,0,0,,Алайда, Исламен ажырасқаннан кейін,
Dialogue: 0,0:11:42.93,0:11:45.81,JPN,,0,0,0,,Керісінше, Кадзуки бәрін көндірді.
Dialogue: 0,0:11:46.64,0:11:48.35,JPN,,0,0,0,,Мен мұны осылай жасағым келеді.
Dialogue: 0,0:11:49.61,0:11:50.44,JPN,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:11:50.90,0:11:55.23,JPN,,0,0,0,,Иә, Казуки Исланы қатты жақсы көреді.
Dialogue: 0,0:12:02.74,0:12:04.05,JPN,,0,0,0,,Содан кейін айналаңдағы 'болашақ оқиғаларды' болжа
Dialogue: 0,0:12:04.58,0:12:05.66,JPN,,0,0,0,,Маған шыда
Dialogue: 0,0:12:06.29,0:12:08.86,JPN,,0,0,0,,Айраның жыныс мүшесін тағы соғасың.
Dialogue: 0,0:12:13.67,0:12:14.57,JPN,,0,0,0,,Сол жігіттер
Dialogue: 0,0:12:14.76,0:12:16.61,JPN,,0,0,0,,Егер олар Исланы жылатса, мені кешір.
Dialogue: 0,0:12:16.92,0:12:17.91,JPN,,0,0,0,,Сені жылатсам кешірші
Dialogue: 0,0:12:18.22,0:12:19.13,JPN,,0,0,0,,Сені жылатсам кешір
Dialogue: 0,0:12:19.22,0:12:20.29,JPN,,0,0,0,,Сені жылатсам кешір
Dialogue: 0,0:12:29.90,0:12:32.87,JPN,,0,0,0,,Бұл ностальгиялық, бұл толғандыратын сезім
Dialogue: 0,0:12:33.40,0:12:35.66,JPN,,0,0,0,,Бұрынғы уақытта үнемі осылай болатын.
Dialogue: 0,0:12:39.36,0:12:44.14,JPN,,0,0,0,,Мен де айналамдағылар өміріме қауіп төндіретін жағдайдамын.
Dialogue: 0,0:12:44.99,0:12:47.72,JPN,,0,0,0,,Мен бұл баланы ұзақ уақыт бойы менің күзетшімін.
Dialogue: 0,0:12:48.58,0:12:52.19,JPN,,0,0,0,,Сізге рахмет, маған адамдық ештеңе жасауға рұқсат етілмеді.
Dialogue: 0,0:12:53.46,0:12:56.30,JPN,,0,0,0,,Ендеше менің сізге өтінішім бар, жас ханым.
Dialogue: 0,0:12:57.17,0:12:57.98,JPN,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:13:00.51,0:13:01.96,JPN,,0,0,0,,Қолымнан келсе
Dialogue: 0,0:13:03.10,0:13:04.70,JPN,,0,0,0,,Осы балаға қалған уақыт
Dialogue: 0,0:13:05.10,0:13:07.56,JPN,,0,0,0,,Мен сенің менің досым болғаныңды қалаймын.
Dialogue: 0,0:13:08.06,0:13:10.53,JPN,,0,0,0,,Ата, менімен ойнаңызшы.
Dialogue: 0,0:13:19.11,0:13:19.80,JPN,,0,0,0,,Қуанышпен
Dialogue: 0,0:13:20.57,0:13:21.35,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:13:22.70,0:13:23.50,JPN,,0,0,0,,...
Dialogue: 0,0:13:24.12,0:13:25.82,JPN,,0,0,0,,Қалған уақыттан рахат алыңыз
Dialogue: 0,0:13:26.24,0:13:27.66,JPN,,0,0,0,,Иә, ата.
Dialogue: 0,0:13:32.75,0:13:33.67,JPN,,0,0,0,,Оның орнына
Dialogue: 0,0:13:36.50,0:13:37.23,JPN,,0,0,0,,Амансың ба?
Dialogue: 0,0:13:39.47,0:13:40.29,JPN,,0,0,0,,Оның орнына
Dialogue: 0,0:13:41.34,0:13:42.52,JPN,,0,0,0,,Сіз де маған қосылыңыз.
Dialogue: 0,0:13:46.51,0:13:47.85,JPN,,0,0,0,,Мен де?
Dialogue: 0,0:13:52.64,0:13:54.45,JPN,,0,0,0,,Өзіңізге ұнайтын адаммен уақыт өткізу
Dialogue: 0,0:13:55.06,0:13:56.62,JPN,,0,0,0,,Өйткені бұл ең бақытты нәрсе
Dialogue: 0,0:14:00.82,0:14:03.80,JPN,,0,0,0,,Цукаса Исладағы өзгерісті байқады ма?
Dialogue: 0,0:14:04.41,0:14:05.10,JPN,,0,0,0,,Өзгерту?
Dialogue: 0,0:14:05.66,0:14:06.25,JPN,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:14:07.03,0:14:11.39,JPN,,0,0,0,,Айраның құрылысын алғаш бастаған кезде оның қандай болғанын еске түсіріп көріңіз.
Dialogue: 0,0:14:12.79,0:14:14.92,JPN,,0,0,0,,Бұл өте қызықсыз болды.
Dialogue: 0,0:14:15.88,0:14:17.87,JPN,,0,0,0,,Жатақханада бірге тұра бастаған кезіміз
Dialogue: 0,0:14:18.30,0:14:20.05,JPN,,0,0,0,,Мен онымен сөйлескенімде де ол мені елемейтін.
Dialogue: 0,0:14:20.50,0:14:21.01,JPN,,0,0,0,,Иә
Dialogue: 0,0:14:21.80,0:14:23.97,JPN,,0,0,0,,Жұмыстағы шиеленістің салдарынан ба?
Dialogue: 0,0:14:24.26,0:14:25.89,JPN,,0,0,0,,Кенет қозғала алмай қалды
Dialogue: 0,0:14:26.72,0:14:30.30,JPN,,0,0,0,,Казуки бұл шамадан тыс жұмыстан болуы мүмкін деді.
Dialogue: 0,0:14:31.35,0:14:33.81,JPN,,0,0,0,,Кадзукимен ажырасқанға дейін
Dialogue: 0,0:14:34.31,0:14:36.92,JPN,,0,0,0,,Исла жүрегін өлтіргендей болды.
Dialogue: 0,0:14:37.94,0:14:40.42,JPN,,0,0,0,,Әйтпесе, менде болмас еді.
Dialogue: 0,0:14:41.19,0:14:42.83,JPN,,0,0,0,,Ира қалай жұмыс істейді?
Dialogue: 0,0:14:43.28,0:14:45.61,JPN,,0,0,0,,Жинайтын тарапқа тым көп жүк тие ме?
Dialogue: 0,0:14:46.37,0:14:49.10,JPN,,0,0,0,,Жалғыз Исла тым көп тырысты деп айтуға болады.
Dialogue: 0,0:14:51.75,0:14:52.96,JPN,,0,0,0,,Алайда жақында
Dialogue: 0,0:14:53.66,0:14:56.38,JPN,,0,0,0,,Исланың ескі өрнегі қайта оралуда.
Dialogue: 0,0:14:57.63,0:15:00.26,JPN,,0,0,0,,Кадзуки бұған қатты қуанды.
Dialogue: 0,0:15:01.88,0:15:04.26,JPN,,0,0,0,,Мүмкін Исла маған үйреніп қалған шығар.
Dialogue: 0,0:15:05.34,0:15:06.89,JPN,,0,0,0,,Бұл өте таңқаларлық.
Dialogue: 0,0:15:07.68,0:15:08.72,JPN,,0,0,0,,Исла үш жылға
Dialogue: 0,0:15:09.01,0:15:10.87,JPN,,0,0,0,,Мені ешкім аулақ ұстауға тырыспады.
Dialogue: 0,0:15:12.22,0:15:14.16,JPN,,0,0,0,,Біз сізді шақырсақ та
Dialogue: 0,0:15:14.64,0:15:18.11,JPN,,0,0,0,,Сіз тек минимумға жауап бердіңіз.
Dialogue: 0,0:15:18.73,0:15:19.36,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:20.02,0:15:22.65,JPN,,0,0,0,,Кадзуки сізді сатып алуда.
Dialogue: 0,0:15:23.61,0:15:25.55,JPN,,0,0,0,,Ол сонымен бірге Ислаға жауапты қалдыра алатынымды айтты.
Dialogue: 0,0:15:27.89,0:15:28.36,JPN,,0,0,0,,Өтінемін
Dialogue: 0,0:15:29.03,0:15:30.38,JPN,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:15:58.85,0:16:01.15,JPN,,0,0,0,,Сізге ұнайтын адаммен...
Dialogue: 0,0:16:17.58,0:16:18.94,JPN,,0,0,0,,Сіз ше?
Dialogue: 0,0:16:23.30,0:16:24.54,JPN,,0,0,0,,Сіз айттыңыз.
Dialogue: 0,0:16:25.13,0:16:29.04,JPN,,0,0,0,,Ең бақытты нәрсе - сүйікті адамыңызбен уақыт өткізу.
Dialogue: 0,0:16:30.01,0:16:33.02,JPN,,0,0,0,,Сен мені бүгін сол жұмысқа мәжбүрледің бе?
Dialogue: 0,0:16:33.51,0:16:34.80,JPN,,0,0,0,,Сіз ше?
Dialogue: 0,0:16:35.22,0:16:36.29,JPN,,0,0,0,,Казуки айлакер
Dialogue: 0,0:16:36.73,0:16:37.70,JPN,,0,0,0,,Көптен бері солай.
Dialogue: 0,0:16:38.31,0:16:40.00,JPN,,0,0,0,,Бұл қандай тұлға?
Dialogue: 0,0:16:42.52,0:16:46.97,JPN,,0,0,0,,Менімен болған естеліктеріңіз мәңгі есте қалғанын қаламайсыз ба?
Dialogue: 0,0:16:48.40,0:16:51.57,JPN,,0,0,0,,Біздің еңбегіміз ешқашан марапатталмайды
Dialogue: 0,0:16:52.32,0:16:55.25,JPN,,0,0,0,,Бұл естеліктерді жыртудың құны
Dialogue: 0,0:16:55.74,0:16:57.13,JPN,,0,0,0,,Шынымен солай ма?
Dialogue: 0,0:16:57.87,0:17:01.17,JPN,,0,0,0,,Тіпті сіз қазір жинауға бағынасыз.
Dialogue: 0,0:17:07.59,0:17:08.76,JPN,,0,0,0,,Бүгін таңертең де айттым деп ойлаймын.
Dialogue: 0,0:17:09.13,0:17:11.10,JPN,,0,0,0,,Мен Цукасадан кетемін
Dialogue: 0,0:17:11.51,0:17:13.21,JPN,,0,0,0,,Өйткені ол бір-біріне арналған
Dialogue: 0,0:17:13.76,0:17:17.10,JPN,,0,0,0,,Бұл... ол өте қиын.
Dialogue: 0,0:17:19.39,0:17:20.80,JPN,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:17:21.10,0:17:23.25,JPN,,0,0,0,,Мен саған қыңыр болма дедім.
Dialogue: 0,0:17:23.56,0:17:25.02,JPN,,0,0,0,,Бұл надан адам
Dialogue: 0,0:17:28.74,0:17:31.86,JPN,,0,0,0,,Сіз... Цукаса үшін шегінуге тырысып жатырсыз.
Dialogue: 0,0:17:34.78,0:17:35.67,JPN,,0,0,0,,Үш жыл бұрын
Dialogue: 0,0:17:37.45,0:17:40.66,JPN,,0,0,0,,Мен дуэттің тарағанын жақсы деп ойладым.
Dialogue: 0,0:17:41.37,0:17:43.75,JPN,,0,0,0,,Мен бұл сізге арналған деп ойладым.
Dialogue: 0,0:17:44.42,0:17:46.80,JPN,,0,0,0,,Бірақ жоқ, бұл дұрыс емес.
Dialogue: 0,0:17:47.59,0:17:50.45,JPN,,0,0,0,,Бұл ешкімге жақсы емес.
Dialogue: 0,0:17:51.38,0:17:53.49,JPN,,0,0,0,,Цукасаны осында қалдырсаңыз
Dialogue: 0,0:17:53.93,0:17:57.77,JPN,,0,0,0,,Оның ішінде сенімен болған азапты естеліктер ғана қалады.
Dialogue: 0,0:17:58.47,0:18:00.00,JPN,,0,0,0,,Адамдардың өзі сондай.
Dialogue: 0,0:18:00.81,0:18:04.00,JPN,,0,0,0,,Өкініп, өзімді кінәлай берем.
Dialogue: 0,0:18:06.98,0:18:08.48,JPN,,0,0,0,,Сен мұнымен жақсысың ба?
Dialogue: 0,0:18:41.10,0:18:47.34,JPN,,0,0,0,,Мен де Казукимен өткізген қызық кездерді ұмытқым келді.
Dialogue: 0,0:18:48.32,0:18:49.80,JPN,,0,0,0,,Мен көп өкіндім
Dialogue: 0,0:18:50.86,0:18:54.15,JPN,,0,0,0,,Қызықтар да көп болса керек.
Dialogue: 0,0:18:59.41,0:19:00.14,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:19:02.44,0:19:03.20,JPN,,0,0,0,,Мен...
Dialogue: 0,0:19:39.95,0:19:41.67,JPN,,0,0,0,,Енді қорықпа.
Dialogue: 0,0:19:51.00,0:19:51.79,JPN,,0,0,0,,Егер ол қабырғалар ішінде қозғалып, заттарды көріп, естіп жүрсе—
Dialogue: 0,0:20:01.18,0:20:02.54,JPN,,0,0,0,,Цуцукаса
Dialogue: 0,0:20:06.06,0:20:07.70,JPN,,0,0,0,,Ира, не болды?
Dialogue: 0,0:20:07.77,0:20:10.80,JPN,,0,0,0,,Цукасаға...Саған маңызды бір нәрсе айтамын.
Dialogue: 0,0:20:12.40,0:20:13.54,JPN,,0,0,0,,Енді осындасыз ба?
Dialogue: 0,0:20:19.53,0:20:20.26,JPN,,0,0,0,,Түсіндім
Dialogue: 0,0:20:24.71,0:20:25.16,JPN,,0,0,0,,Мен...
Dialogue: 0,0:20:27.68,0:20:28.56,JPN,,0,0,0,,Мен...
Dialogue: 0,0:20:31.67,0:20:34.09,JPN,,0,0,0,,Цукаса мені мойындаған кезде
Dialogue: 0,0:20:34.63,0:20:37.83,JPN,,0,0,0,,Мен бұдан былай естелік шығармауым керек деп ойладым.
Dialogue: 0,0:20:39.05,0:20:41.04,JPN,,0,0,0,,Ол міндетті түрде үзіліп кетеді.
Dialogue: 0,0:20:41.89,0:20:44.27,JPN,,0,0,0,,Ажырасу оны тек қиындатады.
Dialogue: 0,0:20:45.06,0:20:48.26,JPN,,0,0,0,,Зардап шеккен Цукаса, ол артта қалды.
Dialogue: 0,0:20:49.39,0:20:50.95,JPN,,0,0,0,,Ең бастысы, Цукаса үшін
Dialogue: 0,0:20:52.31,0:20:56.98,JPN,,0,0,0,,Мен Цукасадан кету керек деп шештім.
Dialogue: 0,0:20:59.32,0:21:00.28,JPN,,0,0,0,,Мен шешсем де...
Dialogue: 0,0:21:04.28,0:21:06.66,JPN,,0,0,0,,Мен елестетуге тырыстым...
Dialogue: 0,0:21:10.75,0:21:15.57,JPN,,0,0,0,,Цукаса мені болашақта қалай еске алады?
Dialogue: 0,0:21:18.47,0:21:25.45,JPN,,0,0,0,,Мен суық, жалғыз және мұңды екенімді білемін... Мен ғана сондаймын
Dialogue: 0,0:21:27.60,0:21:32.51,JPN,,0,0,0,,Менде бір жақсы естелік қалмаған сияқты.
Dialogue: 0,0:21:34.02,0:21:34.90,JPN,,0,0,0,,Солай ма...
Dialogue: 0,0:21:36.65,0:21:40.05,JPN,,0,0,0,,Маған... бұл ұнамайды.
Dialogue: 0,0:21:44.87,0:21:45.50,JPN,,0,0,0,,Ира…
Dialogue: 0,0:21:49.01,0:21:52.74,JPN,,0,0,0,,Мен Цукасамен көбірек естеліктер жасағым келеді
Dialogue: 0,0:21:53.29,0:21:56.67,JPN,,0,0,0,,Мен Цукаса менің осында болғанымды есте сақтағанын қалаймын.
Dialogue: 0,0:21:57.05,0:21:58.19,JPN,,0,0,0,,сөзсіз Лорд Дэмиан болары анық.
Dialogue: 0,0:21:59.60,0:22:00.53,JPN,,0,0,0,,сөзсіз Лорд Дэмиан болары анық.
Dialogue: 0,0:22:02.40,0:22:05.15,JPN,,0,0,0,,Мен Цукасамен бірге болғым келеді
Dialogue: 0,0:22:07.81,0:22:08.50,JPN,,0,0,0,,Жарайды
Dialogue: 0,0:22:14.65,0:22:16.84,JPN,,0,0,0,,Мен әрқашан сенімен бірге боламын
Dialogue: 0,0:22:19.23,0:22:19.98,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:22:24.07,0:22:27.67,JPN,,0,0,0,,Маған ұнайсың
Dialogue: 0,0:22:46.34,0:22:47.72,JPN,,0,0,0,,Күн ыстық.
Dialogue: 0,0:22:48.47,0:22:49.46,JPN,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:22:49.68,0:22:50.85,JPN,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:22:50.14,0:22:51.81,JPN,,0,0,0,,О, жастар.
Dialogue: 0,0:22:55.65,0:22:57.41,JPN,,0,0,0,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:23:06.03,0:23:06.90,JPN,,0,0,0,,Аня нәжіске батты.
Dialogue: 0,0:23:08.24,0:23:09.10,JPN,,0,0,0,,Констанс
Dialogue: 0,0:23:09.99,0:23:11.74,JPN,,0,0,0,,Бүгін кешке сусын ішейік
Dialogue: 0,0:23:12.20,0:23:15.03,JPN,,0,0,0,,Эй, сен мені бірінші рет шақырып тұрған жоқсың ба?
Dialogue: 0,0:23:15.50,0:23:16.11,JPN,,0,0,0,,Сізге бұл ұнамайды ма?
Dialogue: 0,0:23:16.83,0:23:19.33,JPN,,0,0,0,,Жоқ, мен сізбен жұмыс істеуге қуаныштымын.
Dialogue: 0,0:23:22.26,0:23:25.25,JPN,,0,0,0,,Мен бүгін жақсы саке ішетін сияқтымын.
Dialogue: 0,0:23:49.70,0:23:55.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
