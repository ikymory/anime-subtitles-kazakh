Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:00.42,0:01:04.02,OPJP,,0,0,0,,Жарықты жинау
Dialogue: 0,0:01:12.02,0:01:16.52,OPJP,,0,0,0,,Қоштасудан естеліктер
Dialogue: 0,0:01:17.62,0:01:23.69,OPJP,,0,0,0,,Көзіме тамсанып, алысқа қадалған арман
Dialogue: 0,0:01:23.87,0:01:29.12,OPJP,,0,0,0,,Ән жады бұзылады
Dialogue: 0,0:01:29.42,0:01:34.52,OPJP,,0,0,0,,Жалғыздықтың көз жасын ақырын сүртейік
Dialogue: 0,0:01:34.82,0:01:41.72,OPJP,,0,0,0,,Ұзартылған қол - айналмалы дөңгелек, оны абайлап алыңыз
Dialogue: 0,0:01:42.03,0:01:47.02,OPJP,,0,0,0,,Оянғалы тұрған жадының үзінділері
Dialogue: 0,0:01:48.02,0:01:52.92,OPJP,,0,0,0,,Мен төмен қарап, жоқ болып кетсін деп дұға етемін, бірақ
Dialogue: 0,0:01:53.03,0:01:59.02,OPJP,,0,0,0,,Бұл сіз тапқан дауыс
Dialogue: 0,0:01:59.32,0:02:06.02,OPJP,,0,0,0,,Сағат тілі қозғала бастайды, көп ұзамай дүниенің түсі өзгереді
Dialogue: 0,0:02:06.32,0:02:12.22,OPJP,,0,0,0,,Менің пластикалық жүрегім жарқырайды
Dialogue: 0,0:02:12.49,0:02:17.12,OPJP,,0,0,0,,Ұмытпа, есте сақта
Dialogue: 0,0:02:17.53,0:02:24.02,OPJP,,0,0,0,,Бір күні тағы кездескенше
Dialogue: 0,0:22:45.10,0:22:48.44,EDJP,,0,0,0,,Ажырасқан сені іздедім.
Dialogue: 0,0:22:48.70,0:22:52.20,EDJP,,0,0,0,,Мені шақырған дауыс өшіп қалды
Dialogue: 0,0:22:52.40,0:22:59.80,EDJP,,0,0,0,,Мен ұстаған қол дірілдеп тұрды.
Dialogue: 0,0:23:00.28,0:23:03.80,EDJP,,0,0,0,,Біздің сезімдер
Dialogue: 0,0:23:04.00,0:23:09.00,EDJP,,0,0,0,,Қайтаруға болмайтын уақытты қабыл алыңыз
Dialogue: 0,0:23:09.21,0:23:13.71,EDJP,,0,0,0,,Мен биік ұшамын
Dialogue: 0,0:23:14.51,0:23:18.10,EDJP,,0,0,0,,Аспанда жарқыраған калейдоскоп
Dialogue: 0,0:23:18.30,0:23:22.10,EDJP,,0,0,0,,Сіз ыңғайсызданып күлдіңіз
Dialogue: 0,0:23:22.41,0:23:28.10,EDJP,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:23:29.30,0:23:32.86,EDJP,,0,0,0,,Жарық ерігенге дейін
Dialogue: 0,0:23:33.00,0:23:36.00,EDJP,,0,0,0,,Мен шын жүректен үміттенемін
Dialogue: 0,0:23:36.20,0:23:48.20,EDJP,,0,0,0,,Осы сәтті ұмытпа
Dialogue: 0,0:03:01.87,0:03:03.75,JPN,,0,0,0,,Цукаса оянады
Dialogue: 0,0:03:07.17,0:03:09.17,JPN,,0,0,0,,Қайырлы таң, таң атты.
Dialogue: 0,0:03:10.92,0:03:11.73,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:19.80,0:03:22.89,JPN,,0,0,0,,Уау, мен душ қабылдауым керек.
Dialogue: 0,0:03:26.10,0:03:26.79,JPN,,0,0,0,,Ира?
Dialogue: 0,0:03:27.73,0:03:28.40,JPN,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:03:32.44,0:03:33.25,JPN,,0,0,0,,Жарайды
Dialogue: 0,0:03:53.38,0:03:54.57,JPN,,0,0,0,,О, бұл
Dialogue: 0,0:03:55.20,0:03:55.61,JPN,,0,0,0,,Иә
Dialogue: 0,0:03:56.30,0:04:01.47,JPN,,0,0,0,,Мен Исла анда-санда менімен бірге тамақтанғысы келеді ме деп ойлаймын.
Dialogue: 0,0:04:02.10,0:04:02.81,JPN,,0,0,0,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,0:04:11.11,0:04:13.05,JPN,,0,0,0,,Егер мен мұны істесем
Dialogue: 0,0:04:13.52,0:04:15.02,JPN,,0,0,0,,Цукаса бақытты ма?
Dialogue: 0,0:04:15.44,0:04:17.40,JPN,,0,0,0,,Иә, мен бақыттымын.
Dialogue: 0,0:04:20.36,0:04:21.78,JPN,,0,0,0,,Онда мен мұны істеймін.
Dialogue: 0,0:04:23.41,0:04:23.88,JPN,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:04:24.12,0:04:24.48,JPN,,0,0,0,,Иә
Dialogue: 0,0:04:25.04,0:04:26.83,JPN,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:27.29,0:04:28.76,JPN,,0,0,0,,Оң қолымен теңдеулерді шешіп отыр
Dialogue: 0,0:04:34.55,0:04:36.13,JPN,,0,0,0,,Мен толтырамын.
Dialogue: 0,0:04:36.57,0:04:37.64,JPN,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:04:41.05,0:04:41.80,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:41.34,0:04:42.35,JPN,,0,0,0,,Крест
Dialogue: 0,0:04:50.14,0:04:50.96,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:51.31,0:04:53.39,JPN,,0,0,0,,Менде шөптер ерте таусылды.
Dialogue: 0,0:04:51.31,0:04:53.39,Ruby,,0,0,0,,Шөп
Dialogue: 0,0:04:53.73,0:04:57.23,JPN,,0,0,0,,Иә, Майрам шайы, Цукасаның сүйіктісі.
Dialogue: 0,0:04:57.61,0:04:59.01,JPN,,0,0,0,,Мен оны қайтадан сатып алуым керек
Dialogue: 0,0:04:59.45,0:05:00.29,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:02.25,0:05:05.87,JPN,,0,0,0,,Олай болса, жұмыстан кейін неге дүкенге бармасқа?
Dialogue: 0,0:05:06.16,0:05:07.71,JPN,,0,0,0,,Бірге
Dialogue: 0,0:05:14.21,0:05:14.99,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:15.67,0:05:17.71,JPN,,0,0,0,,Қайырлы таң Марс
Dialogue: 0,0:05:18.01,0:05:20.16,JPN,,0,0,0,,Ей, мына екеуі қазір
Dialogue: 0,0:05:20.35,0:05:22.72,JPN,,0,0,0,,Олар қол ұстасып жатқан сияқты емес пе?
Dialogue: 0,0:05:24.60,0:05:26.59,JPN,,0,0,0,,Өзіңізді көп көрсетпеңіз.
Dialogue: 0,0:05:26.81,0:05:29.06,JPN,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:05:29.27,0:05:30.74,JPN,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:05:31.94,0:05:34.94,JPN,,0,0,0,,Солай болса да, кешіріңіз.
Dialogue: 0,0:05:35.19,0:05:40.54,JPN,,0,0,0,,Мен Айракчидің өмірде бір рет болатын супер конфессия уақытын қалай өткізіп алдым?
Dialogue: 0,0:05:41.15,0:05:46.33,JPN,,0,0,0,,Айракчи, менің алдымда Цукасачиге тағы да мойындай аласыз ба?
Dialogue: 0,0:05:47.12,0:05:48.93,JPN,,0,0,0,,Бұл менің өмірлік тілегім.
Dialogue: 0,0:05:49.08,0:05:50.13,JPN,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:05:50.16,0:05:52.24,JPN,,0,0,0,,Тоқта, қиналып қалдың.
Dialogue: 0,0:05:52.58,0:05:54.48,JPN,,0,0,0,,Шынымды айтсам
Dialogue: 0,0:05:54.67,0:05:57.88,JPN,,0,0,0,,Ира істеген ісі үшін көп мақтауға лайық емес еді.
Dialogue: 0,0:05:58.25,0:06:00.50,JPN,,0,0,0,,Жұмыста болған кезде мойындайсыз ба?
Dialogue: 0,0:06:00.60,0:06:04.53,JPN,,0,0,0,,Мичиру осылай деді, ол кеше түнде жалғыз қалып, көңілін қалдырды.
Dialogue: 0,0:06:04.89,0:06:07.66,JPN,,0,0,0,,«Мен де осындай романтикалық нәрсені мойындағым келеді».
Dialogue: 0,0:06:07.66,0:06:08.57,JPN,,0,0,0,,немесе сол сияқты нәрсе
Dialogue: 0,0:06:09.40,0:06:11.45,JPN,,0,0,0,,Мен мұны істегім келмейді, мен оны істегім келеді.
Dialogue: 0,0:06:11.56,0:06:13.06,JPN,,0,0,0,,Мұны айтпа
Dialogue: 0,0:06:13.77,0:06:17.84,JPN,,0,0,0,,Ақ боз атты ханзада бір күні Мичиручиге көрінеді дейді.
Dialogue: 0,0:06:17.90,0:06:21.06,JPN,,0,0,0,,Сіз мені міндетті түрде мазақ етесіз.
Dialogue: 0,0:06:23.07,0:06:24.58,JPN,,0,0,0,,Чао екі
Dialogue: 0,0:06:25.20,0:06:27.03,JPN,,0,0,0,,Кеше жақсы ұйықтадың ба?
Dialogue: 0,0:06:27.37,0:06:30.39,JPN,,0,0,0,,Немесе мен көп ұйықтамадым.
Dialogue: 0,0:06:34.71,0:06:37.00,JPN,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:06:37.17,0:06:39.98,JPN,,0,0,0,,Біз әлі сүйіскен жоқпыз.
Dialogue: 0,0:06:40.09,0:06:43.91,JPN,,0,0,0,,Түн өте ауыр болды.
Dialogue: 0,0:06:45.16,0:06:46.63,JPN,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:06:47.76,0:06:50.79,JPN,,0,0,0,,Ясутака Мұндай әзіл ең жаманы.
Dialogue: 0,0:06:51.39,0:06:54.53,JPN,,0,0,0,,Менің ойымша, бұл екеуі компанияда ресми түрде танылған.
Dialogue: 0,0:06:54.89,0:06:58.40,JPN,,0,0,0,,Ондай жағдайда онымен осылай ойнаған дұрыс.
Dialogue: 0,0:07:00.48,0:07:02.18,JPN,,0,0,0,,Бұл абсурдтық логика.
Dialogue: 0,0:07:04.20,0:07:07.11,JPN,,0,0,0,,Цукаса немесе Айрамен айналысудың қажеті жоқ.
Dialogue: 0,0:07:07.32,0:07:11.10,JPN,,0,0,0,,Менің сүйікті серіктесім күткендей, сіз байсалдысыз.
Dialogue: 0,0:07:12.12,0:07:15.81,JPN,,0,0,0,,Айтпақшы, Цукасаға бір маңызды нәрсені айтайын.
Dialogue: 0,0:07:16.62,0:07:17.63,JPN,,0,0,0,,Бұл не?
Dialogue: 0,0:07:18.13,0:07:23.46,JPN,,0,0,0,,Сүйіктіңмен жақсы тіл табысудың айласы - әрқашан оларды таң қалдыруға тырысу.
Dialogue: 0,0:07:24.42,0:07:26.20,JPN,,0,0,0,,Таңқаларлық...?
Dialogue: 0,0:07:26.72,0:07:32.13,JPN,,0,0,0,,Иә, әйелдер әрқашан романтикалық тосын сыйларды іздейді.
Dialogue: 0,0:07:32.64,0:07:35.01,JPN,,0,0,0,,Мен өзімді ханшайымдай сезінгенімді тойлағым келеді.
Dialogue: 0,0:07:35.35,0:07:35.98,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:36.23,0:07:38.68,JPN,,0,0,0,,Цукаса Мұны байыппен қабылдамаңыз
Dialogue: 0,0:07:38.94,0:07:42.44,JPN,,0,0,0,,Менің ойымша, Шерри де оны іздейді.
Dialogue: 0,0:07:42.70,0:07:44.82,JPN,,0,0,0,,Осындай тосын сыймен келіңіз.
Dialogue: 0,0:07:45.32,0:07:47.41,JPN,,0,0,0,,Ира, саған сұрақ қойсам болады ма?
Dialogue: 0,0:07:48.78,0:07:52.70,JPN,,0,0,0,,Жолдасыма ғашық болу үшін не істеуім керек?
Dialogue: 0,0:07:53.65,0:07:55.12,JPN,,0,0,0,,Мен сені жақсы көремін, мм.
Dialogue: 0,0:07:55.66,0:07:56.57,JPN,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:07:56.66,0:08:00.82,JPN,,0,0,0,,Шерри мені ұнатпайтын сияқты.
Dialogue: 0,0:08:01.21,0:08:04.07,JPN,,0,0,0,,Жұмысқа уақыт бөле алмайтын серіктес болуы
Dialogue: 0,0:08:04.42,0:08:05.99,JPN,,0,0,0,,Мен саған қалай ғашық боламын?
Dialogue: 0,0:08:06.26,0:08:07.43,JPN,,0,0,0,,Китата мырза
Dialogue: 0,0:08:07.76,0:08:11.00,JPN,,0,0,0,,Ой, сату бөлімінен Шокомен кездесу уақыты келді.
Dialogue: 0,0:08:11.30,0:08:13.41,JPN,,0,0,0,,Уақытыңызды сақтайсыз, солай ма?
Dialogue: 0,0:08:14.47,0:08:16.37,JPN,,0,0,0,,Кішкене талқылаймыз ба?
Dialogue: 0,0:08:16.64,0:08:18.34,JPN,,0,0,0,,Екеуің де жақсылық жасаңдар.
Dialogue: 0,0:08:21.90,0:08:24.82,JPN,,0,0,0,,Тосын… Тосын…
Dialogue: 0,0:08:25.40,0:08:26.67,JPN,,0,0,0,,Мүмкін, мен әдеттегідей өлімге әкелетін жара салуым керек еді.
Dialogue: 0,0:08:27.74,0:08:29.50,JPN,,0,0,0,,Не деп күбірлеп тұрсың?
Dialogue: 0,0:08:30.24,0:08:31.60,JPN,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:08:33.45,0:08:35.61,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:08:40.79,0:08:44.17,JPN,,0,0,0,,Кадзуки Цукасаны ашуландырып жатыр.
Dialogue: 0,0:08:44.84,0:08:45.98,JPN,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:08:46.55,0:08:47.40,JPN,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:08:48.09,0:08:50.41,JPN,,0,0,0,,Исла-чан, маған шай берші.
Dialogue: 0,0:08:51.72,0:08:53.63,JPN,,0,0,0,,Әйеліңіздің қолымен жасаған жұмысы бүгін де бар ма?
Dialogue: 0,0:08:54.05,0:08:55.49,JPN,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:08:56.10,0:08:58.29,JPN,,0,0,0,,Сіз үшін біреудің жасағанына қуаныштысыз ба?
Dialogue: 0,0:08:58.52,0:08:59.52,JPN,,0,0,0,,Әрине
Dialogue: 0,0:09:00.02,0:09:03.64,JPN,,0,0,0,,Менің әйелім тамақтану балансына өте мұқият.
Dialogue: 0,0:09:03.94,0:09:08.78,JPN,,0,0,0,,Жақсы. Мен 10 жылдан астам уақыт бойы маған бірдеңе жасамадым.
Dialogue: 0,0:09:09.36,0:09:09.80,JPN,,0,0,0,,Сәлем
Dialogue: 0,0:09:10.36,0:09:11.93,JPN,,0,0,0,,Ой-ой-о-о-о-о
Dialogue: 0,0:09:12.36,0:09:15.53,JPN,,0,0,0,,Исла-чан, оны Цукаса-кунға жасағың келе ме?
Dialogue: 0,0:09:15.79,0:09:17.38,JPN,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:09:17.62,0:09:20.47,JPN,,0,0,0,,Мен оны ешқашан жасаған емеспін.
Dialogue: 0,0:09:21.08,0:09:23.29,JPN,,0,0,0,,Мичирудан сізге сабақ беруді өтінуге қалай қарайсыз?
Dialogue: 0,0:09:23.96,0:09:25.37,JPN,,0,0,0,,Ол тамақ әзірлеуге шебер болуы керек.
Dialogue: 0,0:09:26.59,0:09:27.62,JPN,,0,0,0,,Тосын
Dialogue: 0,0:09:29.92,0:09:32.86,JPN,,0,0,0,,Қыздарға қандай тосын сый ұнайды?
Dialogue: 0,0:09:35.10,0:09:36.80,JPN,,0,0,0,,Бұл гүл шоғы шығар.
Dialogue: 0,0:09:37.26,0:09:39.37,JPN,,0,0,0,,Сіз мұны бұрын қолданып, сәтсіздікке ұшыраған жоқсыз ба?
Dialogue: 0,0:09:39.81,0:09:41.48,JPN,,0,0,0,,Артынан тізе көкек
Dialogue: 0,0:09:41.81,0:09:44.71,JPN,,0,0,0,,Бұл тосыннан гөрі еркелік.
Dialogue: 0,0:09:45.06,0:09:46.89,JPN,,0,0,0,,Керемет түскі асқа кімді шақыру керек?
Dialogue: 0,0:09:47.32,0:09:50.47,JPN,,0,0,0,,Ол тамаққа аса қызықпайтын сияқты.
Dialogue: 0,0:09:50.82,0:09:52.48,JPN,,0,0,0,,Өзгерістер енгізіп көріңіз
Dialogue: 0,0:09:52.82,0:09:54.54,JPN,,0,0,0,,Исла мұндай нәрсені жақсы біледі.
Dialogue: 0,0:09:54.91,0:09:57.40,JPN,,0,0,0,,Қыздарды қуантатын нәрсе деп айтпадым ба?
Dialogue: 0,0:09:58.37,0:10:02.50,JPN,,0,0,0,,Дәлірек айтқанда, Исла өзгеруге жақсы ма?
Dialogue: 0,0:10:03.79,0:10:05.17,JPN,,0,0,0,,Өте қорқынышты
Dialogue: 0,0:10:05.67,0:10:06.58,JPN,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:10:07.80,0:10:08.97,JPN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:09.55,0:10:10.49,JPN,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:10:11.38,0:10:12.80,JPN,,0,0,0,,Немесе осы сияқты
Dialogue: 0,0:10:13.30,0:10:13.85,JPN,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:10:13.88,0:10:15.83,JPN,,0,0,0,,Қазіргі Цукаса да өте қорқынышты.
Dialogue: 0,0:10:16.51,0:10:18.28,JPN,,0,0,0,,Бақытты болып көрінгеніңізге қуаныштымын.
Dialogue: 0,0:10:20.02,0:10:21.76,JPN,,0,0,0,,Менімен құпия кеңес беру?
Dialogue: 0,0:10:22.27,0:10:23.85,JPN,,0,0,0,,Мүмкін Цукасамен байланысты шығар?
Dialogue: 0,0:10:26.65,0:10:27.33,JPN,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:10:27.52,0:10:30.24,JPN,,0,0,0,,Менің де Исладан сұрайын дегенім бар еді.
Dialogue: 0,0:10:36.32,0:10:39.87,JPN,,0,0,0,,Шын мәнінде қарым-қатынаста болу қандай?
Dialogue: 0,0:10:40.33,0:10:41.44,JPN,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:41.79,0:10:45.39,JPN,,0,0,0,,Біз ғашық болғанға дейін және кейін мұнда бірдеңе өзгерді ме?
Dialogue: 0,0:10:46.36,0:10:51.44,JPN,,0,0,0,,Мүмкін сен мені кеше сүйген шығарсың?
Dialogue: 0,0:10:51.92,0:10:52.89,JPN,,0,0,0,,Айяяяя
Dialogue: 0,0:10:53.05,0:10:55.25,JPN,,0,0,0,,Әлі ерте шығар.
Dialogue: 0,0:10:55.68,0:10:56.67,JPN,,0,0,0,,Бірақ күте тұрыңыз
Dialogue: 0,0:10:56.97,0:10:59.81,JPN,,0,0,0,,Бірге өмір сүрудің өзі ұзақ уақыт бойы жалғасты.
Dialogue: 0,0:10:59.93,0:11:03.69,JPN,,0,0,0,,Қалыпты жұпқа қарағанда ілгерілеудің жылдам болуы таңқаларлық емес пе?
Dialogue: 0,0:11:03.89,0:11:07.68,JPN,,0,0,0,,Аа, біріншіден, түнде бір бөлмеде ұйықтап, оянғанда.
Dialogue: 0,0:11:08.98,0:11:10.39,JPN,,0,0,0,,Мүмкін тіпті сүйіспеншілік?
Dialogue: 0,0:11:10.69,0:11:12.33,JPN,,0,0,0,,Тағы не бар?
Dialogue: 0,0:11:13.61,0:11:18.29,JPN,,0,0,0,,Неге екені белгісіз, ғашық болғанға дейінгідей жақсы сөйлей алмаймын.
Dialogue: 0,0:11:19.45,0:11:20.34,JPN,,0,0,0,,Солай ма?
Dialogue: 0,0:11:22.79,0:11:26.64,JPN,,0,0,0,,Егер сіз бұл жағдайға қарасаңыз, сіз оны елестете аласыз.
Dialogue: 0,0:11:27.08,0:11:30.70,JPN,,0,0,0,,Ендеше мен тағамның жасалу жолын білгім келеді.
Dialogue: 0,0:11:31.84,0:11:32.81,JPN,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:33.42,0:11:34.60,JPN,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:11:35.72,0:11:38.09,JPN,,0,0,0,,Мен оны оған жасағым келеді.
Dialogue: 0,0:11:39.76,0:11:41.48,JPN,,0,0,0,,Мен сенің бақытты болғаныңды қалаймын.
Dialogue: 0,0:11:43.77,0:11:44.56,JPN,,0,0,0,,Then
Dialogue: 0,0:11:45.23,0:11:49.01,JPN,,0,0,0,,Бұрынғыдай сөйлей алатын шығармын деп ойладым.
Dialogue: 0,0:11:57.24,0:11:59.34,JPN,,0,0,0,,Менің денсаулығым өте жақсы.
Dialogue: 0,0:12:00.03,0:12:01.89,JPN,,0,0,0,,Жақсы, мен саған айтамын.
Dialogue: 0,0:12:03.74,0:12:05.90,JPN,,0,0,0,,Қандай тағам жасағың келеді?
Dialogue: 0,0:12:06.96,0:12:10.87,JPN,,0,0,0,,Қараңдар, не жасайтының Цукасаның талғамына байланысты болады.
Dialogue: 0,0:12:13.05,0:12:15.45,JPN,,0,0,0,,Цукаса нені ұнатады?
Dialogue: 0,0:12:15.76,0:12:17.41,JPN,,0,0,0,,Менен сұрасаң да
Dialogue: 0,0:12:19.09,0:12:21.20,JPN,,0,0,0,,Мен мұны тіпті білмеймін.
Dialogue: 0,0:12:21.55,0:12:24.40,JPN,,0,0,0,,Мен ғашық болу құқығынан айырылдым
Dialogue: 0,0:12:28.27,0:12:29.03,JPN,,0,0,0,,баяу
Dialogue: 0,0:12:29.56,0:12:31.34,JPN,,0,0,0,,Түскі үзіліс аяқталады.
Dialogue: 0,0:12:32.02,0:12:33.02,JPN,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:12:33.36,0:12:35.49,JPN,,0,0,0,,Исла сенен бір нәрсе сұрағысы келетінін айтты.
Dialogue: 0,0:12:38.49,0:12:38.96,JPN,,0,0,0,,Қараңыз
Dialogue: 0,0:12:39.24,0:12:41.65,JPN,,0,0,0,,Қате Мен сізді жақсы ести алмадым.
Dialogue: 0,0:12:41.95,0:12:43.20,JPN,,0,0,0,,Тағы да айтайын...
Dialogue: 0,0:12:43.24,0:12:45.53,JPN,,0,0,0,,Неге қазір ұялшақсың?
Dialogue: 0,0:12:45.87,0:12:46.92,JPN,,0,0,0,,Өйткені
Dialogue: 0,0:12:47.54,0:12:50.14,JPN,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:12:50.42,0:12:53.91,JPN,,0,0,0,,Исла сізге тамақ әзірлегісі келеді.
Dialogue: 0,0:12:54.13,0:12:56.61,JPN,,0,0,0,,Сонымен, не жегіңіз келетінін сұраңыз.
Dialogue: 0,0:12:56.88,0:12:57.45,JPN,,0,0,0,,На
Dialogue: 0,0:12:58.42,0:13:04.02,JPN,,0,0,0,,Сүйіктіңмен жақсы тіл табысудың айласы - әрқашан оларды таң қалдыруға тырысу.
Dialogue: 0,0:13:05.39,0:13:07.72,JPN,,0,0,0,,Бұл Исланың тосын сыйы.
Dialogue: 0,0:13:07.77,0:13:08.97,JPN,,0,0,0,,асып кетті
Dialogue: 0,0:13:09.18,0:13:10.87,JPN,,0,0,0,,Сіз жай тыңдап тұрсыз ба?
Dialogue: 0,0:13:11.31,0:13:12.22,JPN,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:13:12.90,0:13:15.46,JPN,,0,0,0,,Айраның сезіміне қатты қуандым.
Dialogue: 0,0:13:15.98,0:13:20.93,JPN,,0,0,0,,Бірақ мен біреуден бір жақты талап етуді ыңғайсыз сезінемін.
Dialogue: 0,0:13:21.86,0:13:26.01,JPN,,0,0,0,,Бүгін таңертең айтқаным жай ғана Исламен кешкі ас ішкім келеді.
Dialogue: 0,0:13:26.70,0:13:31.11,JPN,,0,0,0,,Олай болса, екеуіңнің басынан бірге жұмыс істегендерің дұрыс емес пе?
Dialogue: 0,0:13:32.04,0:13:32.89,JPN,,0,0,0,,Екі адам...
Dialogue: 0,0:13:33.96,0:13:34.80,JPN,,0,0,0,,…
Dialogue: 0,0:13:41.47,0:13:43.86,JPN,,0,0,0,,Сіз қорытындыға оңай келген сияқтысыз.
Dialogue: 0,0:13:44.43,0:13:47.64,JPN,,0,0,0,,Бұл жағдайда көмектеспеген дұрыс деп ойлаймын.
Dialogue: 0,0:13:47.93,0:13:49.49,JPN,,0,0,0,,Бұл жай ғана кедергі жасайды.
Dialogue: 0,0:13:49.85,0:13:53.81,JPN,,0,0,0,,Айтайын дегенім, жатақханаға қайтып келгенше күте тұрыңыз, олай жасамас бұрын.
Dialogue: 0,0:13:53.94,0:13:55.60,JPN,,0,0,0,,Сондықтан да өнерпаздар
Dialogue: 0,0:13:56.15,0:13:57.53,JPN,,0,0,0,,Мені қызықтырса да.
Dialogue: 0,0:13:57.69,0:13:58.70,JPN,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:13:58.94,0:14:00.24,JPN,,0,0,0,,Бөлек
Dialogue: 0,0:14:13.79,0:14:15.90,JPN,,0,0,0,,Бұрынғы пісіру туралы.
Dialogue: 0,0:14:16.21,0:14:16.71,JPN,,0,0,0,,Иә
Dialogue: 0,0:14:18.17,0:14:20.73,JPN,,0,0,0,,Мен мұны сенімен жасағым келеді.
Dialogue: 0,0:14:21.30,0:14:23.41,JPN,,0,0,0,,Сондықтан мен сенімен бірге тамақтанғым келеді.
Dialogue: 0,0:14:23.84,0:14:24.83,JPN,,0,0,0,,Цукаса ше?
Dialogue: 0,0:14:25.30,0:14:26.34,JPN,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:14:26.80,0:14:27.20,JPN,,0,0,0,,Ум...
Dialogue: 0,0:14:27.70,0:14:30.14,JPN,,0,0,0,,Неге бүгін кешке тырыспайсыз?
Dialogue: 0,0:14:31.68,0:14:32.94,JPN,,0,0,0,,Не жегің келеді?
Dialogue: 0,0:14:33.39,0:14:35.78,JPN,,0,0,0,,Мен Цукаса нені ұнататынын білгім келеді.
Dialogue: 0,0:14:37.69,0:14:38.46,JPN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:14:38.90,0:14:39.98,JPN,,0,0,0,,Маған ұнайтын нәрсе
Dialogue: 0,0:14:40.90,0:14:42.38,JPN,,0,0,0,,Омлет күріш
Dialogue: 0,0:14:43.90,0:14:45.02,JPN,,0,0,0,,Бала сияқты
Dialogue: 0,0:14:55.46,0:14:58.02,JPN,,0,0,0,,Цукаса менің ресми серіктесім
Dialogue: 0,0:14:58.54,0:14:59.67,JPN,,0,0,0,,Кадзукиден басқару...
Dialogue: 0,0:14:59.71,0:15:00.62,JPN,,0,0,0,,Жарайды
Dialogue: 0,0:15:01.80,0:15:03.68,JPN,,0,0,0,,Мен оның көпшілігін түсінемін.
Dialogue: 0,0:15:07.76,0:15:09.25,JPN,,0,0,0,,Таңқаларлық?
Dialogue: 0,0:15:13.77,0:15:15.39,JPN,,0,0,0,,Мүмкін, мен әдеттегідей өлімге әкелетін жара салуым керек еді.
Dialogue: 0,0:15:27.11,0:15:28.69,JPN,,0,0,0,,Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 0,0:15:29.83,0:15:31.06,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:15:31.87,0:15:35.52,JPN,,0,0,0,,Мысалы, егер сізге ұнайтын адам сізді таң қалдырса.
Dialogue: 0,0:15:35.83,0:15:37.69,JPN,,0,0,0,,Мені не қуантатыны қызық...
Dialogue: 0,0:15:38.33,0:15:40.45,JPN,,0,0,0,,Ираны қуантқыңыз келе ме?
Dialogue: 0,0:15:40.75,0:15:42.01,JPN,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:15:42.55,0:15:44.19,JPN,,0,0,0,,Сізді түсіну оңай.
Dialogue: 0,0:15:44.51,0:15:46.29,JPN,,0,0,0,,О, солай ма?
Dialogue: 0,0:15:49.43,0:15:51.53,JPN,,0,0,0,,Өзіңізге ұнайтын адаммен уақыт өткізу
Dialogue: 0,0:15:52.01,0:15:53.17,JPN,,0,0,0,,Ең бақытты
Dialogue: 0,0:15:54.14,0:15:56.04,JPN,,0,0,0,,Ира-сан осылай деді.
Dialogue: 0,0:15:57.14,0:15:59.43,JPN,,0,0,0,,Менің ойымша, бұл мағынаны білдіреді.
Dialogue: 0,0:16:03.78,0:16:06.57,JPN,,0,0,0,,Сонда да атам да, сен де жақсысыңдар.
Dialogue: 0,0:16:07.28,0:16:10.12,JPN,,0,0,0,,Көптеген ер адамдар ебедейсіз.
Dialogue: 0,0:16:16.21,0:16:17.73,JPN,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:16:18.42,0:16:19.22,JPN,,0,0,0,,Жарайды
Dialogue: 0,0:16:19.96,0:16:22.12,JPN,,0,0,0,,Мен көмектесу үшін бірдеңе істей аламын ба?
Dialogue: 0,0:16:22.58,0:16:23.70,JPN,,0,0,0,,Мен қазір жақсымын
Dialogue: 0,0:16:24.13,0:16:25.41,JPN,,0,0,0,,Егер бірдеңе болса, мен сізге хабарлаймын.
Dialogue: 0,0:16:25.96,0:16:27.09,JPN,,0,0,0,,Ізгі ниетпен
Dialogue: 0,0:16:27.67,0:16:29.12,JPN,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:16:37.14,0:16:39.19,JPN,,0,0,0,,Мен тым жағдайға байланысты тұрамын.
Dialogue: 0,0:16:39.69,0:16:41.35,JPN,,0,0,0,,Өтінемін, ұмытпаңыз
Dialogue: 0,0:16:42.40,0:16:43.99,JPN,,0,0,0,,Қандай кездейсоқ кездесу, Хиёри
Dialogue: 0,0:16:58.50,0:16:59.17,JPN,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:17:01.38,0:17:04.09,JPN,,0,0,0,,Күн өте кеш батады.
Dialogue: 0,0:17:04.50,0:17:04.88,JPN,,0,0,0,,Иә
Dialogue: 0,0:17:07.63,0:17:08.57,JPN,,0,0,0,,Бұл емес пе?
Dialogue: 0,0:17:09.80,0:17:10.16,JPN,,0,0,0,,Иә
Dialogue: 0,0:17:11.59,0:17:12.86,JPN,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:17:14.10,0:17:16.08,JPN,,0,0,0,,Цукаса Мен пижама алғым келеді
Dialogue: 0,0:17:16.64,0:17:19.55,JPN,,0,0,0,,Не, сенде ол жоқ еді, солай қалды ма?
Dialogue: 0,0:17:19.98,0:17:21.84,JPN,,0,0,0,,Мен мұны керек емес деп ойлағаннан кейін
Dialogue: 0,0:17:22.77,0:17:23.95,JPN,,0,0,0,,Не, сәйкестік?
Dialogue: 0,0:17:24.36,0:17:24.86,JPN,,0,0,0,,Жоқ?
Dialogue: 0,0:17:25.23,0:17:26.85,JPN,,0,0,0,,А, жоқ, бұл жақсы.
Dialogue: 0,0:17:34.12,0:17:35.15,JPN,,0,0,0,,Сіздің қарныңыз ашты ма?
Dialogue: 0,0:17:35.70,0:17:37.15,JPN,,0,0,0,,Иә, ол бос.
Dialogue: 0,0:17:37.83,0:17:41.04,JPN,,0,0,0,,Бірақ тағам осылайша дәмдірек болады.
Dialogue: 0,0:17:41.58,0:17:43.65,JPN,,0,0,0,,Солай ма? Бұл біртүрлі.
Dialogue: 0,0:17:53.14,0:17:56.70,JPN,,0,0,0,,Біз ғашық болдық, солай ма?
Dialogue: 0,0:17:58.18,0:17:58.60,JPN,,0,0,0,,Иә
Dialogue: 0,0:17:59.64,0:18:00.45,JPN,,0,0,0,,Бірақ мен
Dialogue: 0,0:18:01.35,0:18:05.71,JPN,,0,0,0,,Мен Исла үшін ерекше ештеңе істей алмаған сияқтымын.
Dialogue: 0,0:18:08.19,0:18:10.60,JPN,,0,0,0,,Мен көп нәрсені ойладым.
Dialogue: 0,0:18:11.61,0:18:14.02,JPN,,0,0,0,,Исланы бақытты ету үшін мен не істей аламын?
Dialogue: 0,0:18:14.74,0:18:16.30,JPN,,0,0,0,,Мен оны мүлдем түсінбеймін
Dialogue: 0,0:18:27.92,0:18:30.94,JPN,,0,0,0,,Мен әдеттегідей жақсымын.
Dialogue: 0,0:18:32.09,0:18:33.33,JPN,,0,0,0,,Әдеттегідей жақсырақ
Dialogue: 0,0:18:34.63,0:18:36.62,JPN,,0,0,0,,Цукасамен бірге болу
Dialogue: 0,0:18:37.14,0:18:38.22,JPN,,0,0,0,,Өйткені бұл ерекше
Dialogue: 0,0:18:39.60,0:18:40.92,JPN,,0,0,0,,Қазірдің өзінде I
Dialogue: 0,0:18:41.56,0:18:43.30,JPN,,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:18:44.14,0:18:46.10,JPN,,0,0,0,,Менің жүрегім сыздап кетті
Dialogue: 0,0:19:07.63,0:19:08.48,JPN,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:19:10.80,0:19:15.58,JPN,,0,0,0,,Қызық, әр түрлі адамдар сол жарықта әдеттегідей өмір сүріп жатыр ма?
Dialogue: 0,0:19:17.18,0:19:19.65,JPN,,0,0,0,,Мен солардың бірімін деп ойлаймын.
Dialogue: 0,0:19:25.27,0:19:27.98,JPN,,0,0,0,,Оны ерекше ететін де осы.
Dialogue: 0,0:19:28.94,0:19:29.33,JPN,,0,0,0,,Иә
Dialogue: 0,0:20:02.51,0:20:04.15,JPN,,0,0,0,,Сыртқы түрі нәзік
Dialogue: 0,0:20:04.77,0:20:06.88,JPN,,0,0,0,,Бұл жақсы бастама деп ойлаймын.
Dialogue: 0,0:20:07.81,0:20:09.11,JPN,,0,0,0,,Қалағаныңызша ойнаңыз
Dialogue: 0,0:20:17.86,0:20:19.89,JPN,,0,0,0,,Мынау
Dialogue: 0,0:20:26.59,0:20:28.28,JPN,,0,0,0,,Оны жоюдың қажеті жоқ.
Dialogue: 0,0:20:28.75,0:20:30.89,JPN,,0,0,0,,Себебі мен ұятқа шыдай алмадым
Dialogue: 0,0:20:32.25,0:20:33.31,JPN,,0,0,0,,Содан кейін I
Dialogue: 0,0:20:39.43,0:20:41.10,JPN,,0,0,0,,Бұл сәл үлкен болды.
Dialogue: 0,0:20:41.43,0:20:41.77,JPN,,0,0,0,,Иә
Dialogue: 0,0:20:42.89,0:20:44.40,JPN,,0,0,0,,Сосын мен аламын.
Dialogue: 0,0:20:44.85,0:20:45.93,JPN,,0,0,0,,Itadadakimasu
Dialogue: 0,0:20:54.94,0:20:55.45,JPN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:20:56.36,0:20:57.94,JPN,,0,0,0,,Иә, бұл дәмді.
Dialogue: 0,0:20:58.70,0:20:59.92,JPN,,0,0,0,,Ислейді де жеп көріңіз.
Dialogue: 0,0:21:03.99,0:21:04.42,JPN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:05.58,0:21:06.49,JPN,,0,0,0,,Дәмді
Dialogue: 0,0:21:11.67,0:21:14.61,JPN,,0,0,0,,Міне, мен күнделік жүргізе бастадым.
Dialogue: 0,0:21:15.05,0:21:15.52,JPN,,0,0,0,,Иә
Dialogue: 0,0:21:16.30,0:21:17.34,JPN,,0,0,0,,Сіз не жазасыз?
Dialogue: 0,0:21:18.72,0:21:19.73,JPN,,0,0,0,,Күлмейсің бе?
Dialogue: 0,0:21:20.63,0:21:21.66,JPN,,0,0,0,,Күлмеймін.
Dialogue: 0,0:21:43.62,0:21:46.28,JPN,,0,0,0,,Бүгін Исла үшін қандай болды?
Dialogue: 0,0:21:48.37,0:21:52.22,JPN,,0,0,0,,Көңілді болды, көңілді болдым, аздап ұялдым.
Dialogue: 0,0:21:52.67,0:21:53.41,JPN,,0,0,0,,Және…
Dialogue: 0,0:21:54.17,0:21:54.79,JPN,,0,0,0,,Және?
Dialogue: 0,0:21:55.71,0:21:56.84,JPN,,0,0,0,,Омлет күріш күні
Dialogue: 0,0:21:58.67,0:22:00.81,JPN,,0,0,0,,Ал, ертең карри жейміз.
Dialogue: 0,0:22:01.26,0:22:03.62,JPN,,0,0,0,,Цукаса: Сен бала сияқтысың ғой.
Dialogue: 0,0:22:05.80,0:22:06.52,JPN,,0,0,0,,Қайырлы түн
Dialogue: 0,0:22:07.35,0:22:08.38,JPN,,0,0,0,,Қайырлы түн
Dialogue: 0,0:23:49.70,0:23:55.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
