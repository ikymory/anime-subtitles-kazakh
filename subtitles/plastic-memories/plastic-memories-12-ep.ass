Dialogue: 0,0:01:35.41,0:01:39.01,OPJP,,0,0,0,,Жарықты жинау
Dialogue: 0,0:01:47.01,0:01:51.51,OPJP,,0,0,0,,Қоштасудан естеліктер
Dialogue: 0,0:01:52.61,0:01:58.68,OPJP,,0,0,0,,Көзіме тамсанып, алысқа қадалған арман
Dialogue: 0,0:01:58.86,0:02:04.11,OPJP,,0,0,0,,Ән жады бұзылады
Dialogue: 0,0:02:04.41,0:02:09.51,OPJP,,0,0,0,,Жалғыздықтың көз жасын ақырын сүртейік
Dialogue: 0,0:02:09.81,0:02:16.71,OPJP,,0,0,0,,Ұзартылған қол - айналмалы дөңгелек, оны абайлап алыңыз
Dialogue: 0,0:02:17.02,0:02:22.01,OPJP,,0,0,0,,Оянғалы тұрған жадының үзінділері
Dialogue: 0,0:02:23.01,0:02:27.91,OPJP,,0,0,0,,Мен төмен қарап, жоқ болып кетсін деп дұға етемін, бірақ
Dialogue: 0,0:02:28.02,0:02:34.01,OPJP,,0,0,0,,Бұл сіз тапқан дауыс
Dialogue: 0,0:02:34.31,0:02:41.01,OPJP,,0,0,0,,Сағат тілі қозғала бастайды, көп ұзамай дүниенің түсі өзгереді
Dialogue: 0,0:02:41.31,0:02:47.21,OPJP,,0,0,0,,Менің пластикалық жүрегім жарқырайды
Dialogue: 0,0:02:47.48,0:02:52.11,OPJP,,0,0,0,,Ұмытпа, есте сақта
Dialogue: 0,0:02:52.52,0:02:59.01,OPJP,,0,0,0,,Бір күні тағы кездескенше
Dialogue: 0,0:22:45.14,0:22:48.48,EDJP,,0,0,0,,Ажырасқан сені іздедім.
Dialogue: 0,0:22:48.74,0:22:52.24,EDJP,,0,0,0,,Мені шақырған дауыс өшіп қалды
Dialogue: 0,0:22:52.44,0:22:59.84,EDJP,,0,0,0,,Мен ұстаған қол дірілдеп тұрды.
Dialogue: 0,0:23:00.32,0:23:03.84,EDJP,,0,0,0,,Біздің сезімдер
Dialogue: 0,0:23:04.04,0:23:09.04,EDJP,,0,0,0,,Қайтаруға болмайтын уақытты қабыл алыңыз
Dialogue: 0,0:23:09.25,0:23:13.75,EDJP,,0,0,0,,Мен биік ұшамын
Dialogue: 0,0:23:14.55,0:23:18.14,EDJP,,0,0,0,,Аспанда жарқыраған калейдоскоп
Dialogue: 0,0:23:18.34,0:23:22.14,EDJP,,0,0,0,,Сіз ыңғайсызданып күлдіңіз
Dialogue: 0,0:23:22.45,0:23:28.14,EDJP,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:23:29.34,0:23:32.90,EDJP,,0,0,0,,Жарық ерігенге дейін
Dialogue: 0,0:23:33.04,0:23:36.04,EDJP,,0,0,0,,Мен шын жүректен үміттенемін
Dialogue: 0,0:23:36.24,0:23:48.24,EDJP,,0,0,0,,Осы сәтті ұмытпа
Dialogue: 0,0:00:13.24,0:00:15.34,JPN,,0,0,0,,Цукаса… Цукаса…
Dialogue: 0,0:00:17.41,0:00:18.04,JPN,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:00:19.98,0:00:20.80,JPN,,0,0,0,,Уау, бұл шекара ма?
Dialogue: 0,0:00:21.56,0:00:23.30,JPN,,0,0,0,,Мен жалғыз болғанды ұнатпаймын.
Dialogue: 0,0:00:29.00,0:00:30.01,JPN,,0,0,0,,Сіз әлі де сондасыз, солай емес пе?
Dialogue: 0,0:00:30.35,0:00:32.51,JPN,,0,0,0,,Цукаса сенің жаныңда, солай ма?
Dialogue: 0,0:00:37.09,0:00:39.22,JPN,,0,0,0,,Мен мұндамын Мен осындамын
Dialogue: 0,0:00:40.21,0:00:43.12,JPN,,0,0,0,,Ешқайда кетпеңіз
Dialogue: 0,0:00:54.32,0:00:55.30,JPN,,0,0,0,,Itadadakimasu
Dialogue: 0,0:00:56.14,0:00:57.07,JPN,,0,0,0,,Itadadakimasu
Dialogue: 0,0:00:58.97,0:00:59.52,JPN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:01:00.08,0:01:02.06,JPN,,0,0,0,,Сіз оны бұрынғыдан жақсырақ жасай алар едіңіз деп ойламайсыз ба?
Dialogue: 0,0:01:02.63,0:01:04.88,JPN,,0,0,0,,Бұл күнделікті күш-жігердің нәтижесі.
Dialogue: 0,0:01:05.63,0:01:07.96,JPN,,0,0,0,,Мен тырыссам қолымнан келетін баламын.
Dialogue: 0,0:01:19.43,0:01:20.90,JPN,,0,0,0,,Ира Аноса
Dialogue: 0,0:01:22.65,0:01:23.00,JPN,,0,0,0,,Иә?
Dialogue: 0,0:01:25.27,0:01:26.68,JPN,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:01:29.90,0:01:30.55,JPN,,0,0,0,,Оның дәмі қандай?
Dialogue: 0,0:03:05.18,0:03:06.21,JPN,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:10.84,0:03:12.13,JPN,,0,0,0,,Не Ни Цукаса
Dialogue: 0,0:03:13.63,0:03:17.21,JPN,,0,0,0,,Сіз дәл қазір киноға барғыңыз келеді.
Dialogue: 0,0:03:18.13,0:03:19.18,JPN,,0,0,0,,Сіз солай ойлайсыз.
Dialogue: 0,0:03:20.76,0:03:22.49,JPN,,0,0,0,,Иә, бұл
Dialogue: 0,0:03:25.94,0:03:26.87,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:03:27.56,0:03:28.84,JPN,,0,0,0,,Бірақ неге кенеттен?
Dialogue: 0,0:03:29.44,0:03:31.92,JPN,,0,0,0,,Зактың сізге сыйлық беруі сирек.
Dialogue: 0,0:03:33.44,0:03:36.77,JPN,,0,0,0,,Мичирудан сұраудан басқа амалым қалмады...
Dialogue: 0,0:03:36.77,0:03:38.03,JPN,,0,0,0,,Ах, ақымақ.
Dialogue: 0,0:03:43.41,0:03:45.29,JPN,,0,0,0,,Жарайды, қабылдаңыз.
Dialogue: 0,0:03:45.42,0:03:47.46,JPN,,0,0,0,,Ира екеуміз келіп, көңіл көтерсек ше?
Dialogue: 0,0:03:48.94,0:03:52.40,JPN,,0,0,0,,Жарайды, мен билетті кездейсоқ алдым.
Dialogue: 0,0:03:52.72,0:03:56.56,JPN,,0,0,0,,Бірақ мен бос емеспін, бос жүргендер сендерге қалдырамын.
Dialogue: 0,0:03:56.81,0:03:57.93,JPN,,0,0,0,,Мұның бәрі шын мәнінде бар.
Dialogue: 0,0:03:58.43,0:04:00.35,JPN,,0,0,0,,Түсіндім, бәрібір рахмет.
Dialogue: 0,0:04:00.47,0:04:01.80,JPN,,0,0,0,,О Цукаса-кун
Dialogue: 0,0:04:02.47,0:04:03.60,JPN,,0,0,0,,Бұл дұрыс болды.
Dialogue: 0,0:04:03.95,0:04:05.80,JPN,,0,0,0,,Қаласаңыз, алыңыз.
Dialogue: 0,0:04:07.10,0:04:07.85,JPN,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:04:08.19,0:04:10.32,JPN,,0,0,0,,Risotto қонақ үй каталогы?
Dialogue: 0,0:04:11.31,0:04:13.00,JPN,,0,0,0,,тиімді пайдалану
Dialogue: 0,0:04:13.73,0:04:14.24,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:04:14.94,0:04:18.15,JPN,,0,0,0,,Мен жиі баратын мейрамханаға шақыру билетін алдым.
Dialogue: 0,0:04:18.57,0:04:19.44,JPN,,0,0,0,,Саған берейін бе?
Dialogue: 0,0:04:19.95,0:04:22.15,JPN,,0,0,0,,Дүкенде дресс-код болғандықтан.
Dialogue: 0,0:04:22.41,0:04:24.04,JPN,,0,0,0,,Мен де салтанатты киім дайындадым.
Dialogue: 0,0:04:24.83,0:04:27.12,JPN,,0,0,0,,Кешкі ас билеттері мен қосалқы тауарларды көрсетеді
Dialogue: 0,0:04:27.62,0:04:30.21,JPN,,0,0,0,,Мен фан-клуб жәрдемақысы ретінде қосымша ақша алдым.
Dialogue: 0,0:04:30.50,0:04:31.24,JPN,,0,0,0,,Қарсы болмасаңыз
Dialogue: 0,0:04:31.54,0:04:35.32,JPN,,0,0,0,,Сіз менің көлігімді қалаған уақытта пайдалана аласыз.
Dialogue: 0,0:04:36.67,0:04:38.33,JPN,,0,0,0,,Бұл тұрақ картасы.
Dialogue: 0,0:04:39.05,0:04:39.51,JPN,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:04:39.70,0:04:40.99,JPN,,0,0,0,,Лицензияңыз жоқ па?
Dialogue: 0,0:04:41.59,0:04:42.73,JPN,,0,0,0,,сабырлы және сабырлы
Dialogue: 0,0:04:42.97,0:04:44.67,JPN,,0,0,0,,Өйткені бұл автоматты схема сияқты
Dialogue: 0,0:04:45.01,0:04:47.00,JPN,,0,0,0,,Кешіріңіз, Цукаса-кун.
Dialogue: 0,0:04:47.23,0:04:49.92,JPN,,0,0,0,,Менің қалтамдағы ақшам ай сайын аз.
Dialogue: 0,0:04:50.21,0:04:52.44,JPN,,0,0,0,,Сондықтан мен дайындай алатын жалғыз нәрсе осы.
Dialogue: 0,0:04:59.65,0:05:01.76,JPN,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:05:01.99,0:05:04.05,JPN,,0,0,0,,Ертең түсіріп, сыртқа шығамыз ба?
Dialogue: 0,0:05:16.46,0:05:18.40,JPN,,0,0,0,,Бұл арман өмір сияқты
Dialogue: 0,0:05:19.13,0:05:20.18,JPN,,0,0,0,,Бұл арман емес
Dialogue: 0,0:05:20.51,0:05:23.00,JPN,,0,0,0,,Шынымен керемет, сізге рахмет
Dialogue: 0,0:05:23.51,0:05:24.26,JPN,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:05:24.80,0:05:27.09,JPN,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:05:27.56,0:05:29.22,JPN,,0,0,0,,Жасағым келетін нәрселер өте көп.
Dialogue: 0,0:05:29.81,0:05:31.27,JPN,,0,0,0,,Көп адамдар қызық.
Dialogue: 0,0:05:31.60,0:05:32.79,JPN,,0,0,0,,Мен сені қызғанамын
Dialogue: 0,0:05:33.44,0:05:34.61,JPN,,0,0,0,,Суық, солай емес пе?
Dialogue: 0,0:05:34.94,0:05:36.96,JPN,,0,0,0,,Мен өмірден көбірек ләззат алғым келеді.
Dialogue: 0,0:05:37.57,0:05:38.63,JPN,,0,0,0,,Бұл ысырап
Dialogue: 0,0:05:39.36,0:05:44.28,JPN,,0,0,0,,Мен сенің сүйкімді күлкіңді монополиялай алғым келеді
Dialogue: 0,0:05:45.03,0:05:46.23,JPN,,0,0,0,,Осының өзі қанағаттанарлық
Dialogue: 0,0:05:46.70,0:05:48.81,JPN,,0,0,0,,Ах, Джо, мен сені жақсы көремін.
Dialogue: 0,0:05:51.33,0:05:53.60,JPN,,0,0,0,,Қалай болды? Сіздің алғашқы фильміңіз қандай болды?
Dialogue: 0,0:05:53.92,0:05:55.31,JPN,,0,0,0,,Бұл өте қызық болды
Dialogue: 0,0:05:56.00,0:05:57.44,JPN,,0,0,0,,Менің жүрегім әлі соғып тұр
Dialogue: 0,0:05:57.88,0:06:00.38,JPN,,0,0,0,,Жол бойы қолымды ұстадың.
Dialogue: 0,0:06:01.97,0:06:02.81,JPN,,0,0,0,,Бұл...
Dialogue: 0,0:06:03.34,0:06:07.94,JPN,,0,0,0,,Мен қараңғы жерде жүргенде Цукаса жоғалып кете ме деп қорқамын.
Dialogue: 0,0:06:08.64,0:06:09.15,JPN,,0,0,0,,Ира
Dialogue: 0,0:06:10.10,0:06:11.32,JPN,,0,0,0,,Мазасыздық тудырды ма?
Dialogue: 0,0:06:14.31,0:06:15.98,JPN,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:06:18.23,0:06:21.44,JPN,,0,0,0,,Қолымды қалағаныңызша ұстай аласыз.
Dialogue: 0,0:06:23.78,0:06:24.56,JPN,,0,0,0,,Сәлем Цукаса
Dialogue: 0,0:06:24.86,0:06:27.92,JPN,,0,0,0,,Мен бұл нәрсені фильмде көргім келеді.
Dialogue: 0,0:06:28.59,0:06:29.06,JPN,,0,0,0,,Иә?
Dialogue: 0,0:06:31.87,0:06:33.16,JPN,,0,0,0,,Бұл шынында да тізе жастығы ма?
Dialogue: 0,0:06:33.91,0:06:38.28,JPN,,0,0,0,,Мендікін пайдаланғаның дұрыс.
Dialogue: 0,0:06:42.51,0:06:45.42,JPN,,0,0,0,,Олай болса, сөзіңізді қабыл алыңыз.
Dialogue: 0,0:06:51.22,0:06:53.40,JPN,,0,0,0,,Цукасаның шашы дірілдейді
Dialogue: 0,0:06:54.06,0:06:56.14,JPN,,0,0,0,,Мен қатты ұялып тұрмын
Dialogue: 0,0:06:56.77,0:06:59.16,JPN,,0,0,0,,Қате Мен сізді анық ести алмадым.
Dialogue: 0,0:06:59.52,0:07:00.74,JPN,,0,0,0,,Жоқ, бұл қате.
Dialogue: 0,0:07:01.15,0:07:02.76,JPN,,0,0,0,,Сіз оны шынымен ести аласыз, солай ма?
Dialogue: 0,0:07:03.36,0:07:04.39,JPN,,0,0,0,,Мен сізді естімеймін
Dialogue: 0,0:07:04.82,0:07:05.28,JPN,,0,0,0,,Қараңыз
Dialogue: 0,0:07:16.25,0:07:17.21,JPN,,0,0,0,,Сәлем Цукаса
Dialogue: 0,0:07:17.87,0:07:21.64,JPN,,0,0,0,,Мен, соңғы кездері түнде ұйықтауға қорқатын болдым.
Dialogue: 0,0:07:23.30,0:07:24.93,JPN,,0,0,0,,Мен оны елестетемін.
Dialogue: 0,0:07:25.72,0:07:28.76,JPN,,0,0,0,,Мен енді ешқашан оянбаймын ба деп қорқамын
Dialogue: 0,0:07:29.60,0:07:32.92,JPN,,0,0,0,,Мен Цукасамен енді кездесе алмаймын ба деп қорқамын.
Dialogue: 0,0:07:33.68,0:07:36.46,JPN,,0,0,0,,Бірақ мен Цукасамен осылай болғанда,
Dialogue: 0,0:07:36.81,0:07:40.25,JPN,,0,0,0,,Сол қорқынышты сезім кенет жоғалады
Dialogue: 0,0:07:43.65,0:07:45.53,JPN,,0,0,0,,Цукаса керемет
Dialogue: 0,0:07:46.95,0:07:49.54,JPN,,0,0,0,,Сіз әрқашан маған сене аласыз.
Dialogue: 0,0:07:50.76,0:07:51.11,JPN,,0,0,0,,Иә
Dialogue: 0,0:07:56.66,0:07:57.61,JPN,,0,0,0,,Ертең не істейсің?
Dialogue: 0,0:07:58.25,0:08:01.96,JPN,,0,0,0,,Мен шынымен де бәрі менің жұмыстан үзіліс алғанымды қалайтынын сезінемін.
Dialogue: 0,0:08:11.43,0:08:14.74,JPN,,0,0,0,,Цукаса сыртқа шыққысы келсе, маған да жарайды.
Dialogue: 0,0:08:16.18,0:08:17.27,JPN,,0,0,0,,Ол мазасыз көрінді.
Dialogue: 0,0:08:21.94,0:08:25.50,JPN,,0,0,0,,Күндерім осылай жалғаса берсе, мен өте бақытты болар едім.
Dialogue: 0,0:08:26.15,0:08:29.28,JPN,,0,0,0,,Бірақ мен мұны істесем, менің денем баяу болатынына сенімдімін.
Dialogue: 0,0:08:30.57,0:08:34.69,JPN,,0,0,0,,Соңғы күніне дейін қозғала алмасаңыз
Dialogue: 0,0:08:35.41,0:08:36.08,JPN,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:08:36.50,0:08:37.29,JPN,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:08:37.56,0:08:40.58,JPN,,0,0,0,,Иә, бұл мүмкін емес.
Dialogue: 0,0:08:41.42,0:08:43.69,JPN,,0,0,0,,Бірақ мен бұл туралы ойладым
Dialogue: 0,0:08:59.10,0:09:00.16,JPN,,0,0,0,,Егер солай болса, онда
Dialogue: 0,0:09:00.85,0:09:02.12,JPN,,0,0,0,,Әдеттегідей жалғастырайық.
Dialogue: 0,0:09:03.56,0:09:05.80,JPN,,0,0,0,,Бүгінгідей күндер анда-санда жақсы.
Dialogue: 0,0:09:08.69,0:09:09.44,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:09:21.33,0:09:24.95,JPN,,0,0,0,,Деректер туралы ерекше жаңа ештеңе жоқ.
Dialogue: 0,0:09:25.54,0:09:26.28,JPN,,0,0,0,,Солай ма?
Dialogue: 0,0:09:29.42,0:09:31.08,JPN,,0,0,0,,Кешіріңіз, кешігіп қалдым
Dialogue: 0,0:09:31.30,0:09:32.74,JPN,,0,0,0,,Түсіндім. Яғни бұл…
Dialogue: 0,0:09:32.74,0:09:34.44,JPN,,0,0,0,,Сіз кешігіп қалдыңыз.
Dialogue: 0,0:09:34.60,0:09:36.38,JPN,,0,0,0,,Мен жұмыстан бос емеспін.
Dialogue: 0,0:09:36.81,0:09:38.41,JPN,,0,0,0,,Оны би тобына ұсынайық.
Dialogue: 0,0:09:38.70,0:09:39.55,JPN,,0,0,0,,Дайындал
Dialogue: 0,0:09:41.01,0:09:42.55,JPN,,0,0,0,,Мен киімімді ауыстырғалы жатырмын.
Dialogue: 0,0:09:45.06,0:09:46.85,JPN,,0,0,0,,Бұл Исланың деректері ме?
Dialogue: 0,0:09:47.07,0:09:48.61,JPN,,0,0,0,,Бүгін де келдің бе?
Dialogue: 0,0:09:48.82,0:09:50.16,JPN,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:50.24,0:09:51.87,JPN,,0,0,0,,Бұл жігіттер
Dialogue: 0,0:09:52.30,0:09:55.02,JPN,,0,0,0,,Мұны жиі жасаудың қажеті жоқ.
Dialogue: 0,0:09:55.37,0:09:58.43,JPN,,0,0,0,,Ал, өз басым, бұл жеңілдеу сияқты.
Dialogue: 0,0:09:58.58,0:10:00.23,JPN,,0,0,0,,Мен мұны түсінемін, бірақ
Dialogue: 0,0:10:01.16,0:10:04.24,JPN,,0,0,0,,Сондықтан демалыс күніне дейін келудің қажеті жоқ.
Dialogue: 0,0:10:04.88,0:10:09.00,JPN,,0,0,0,,Сол екеуіне қарап жылағым келеді.
Dialogue: 0,0:10:15.79,0:10:16.34,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:10:17.22,0:10:17.85,JPN,,0,0,0,,Саған бір нәрсе сұрасам бола ма?
Dialogue: 0,0:10:24.14,0:10:25.33,JPN,,0,0,0,,Бұл аздап жақсы болды.
Dialogue: 0,0:10:25.71,0:10:27.57,JPN,,0,0,0,,Менің де Кадзуки-саннан сұрайын дегенім бар.
Dialogue: 0,0:10:27.94,0:10:28.40,JPN,,0,0,0,,Не?
Dialogue: 0,0:10:29.07,0:10:30.82,JPN,,0,0,0,,Маған келесі жұмысты беруіңізді сұраймын.
Dialogue: 0,0:10:31.56,0:10:35.48,JPN,,0,0,0,,Сара екеуміз ғана басқарамыз.
Dialogue: 0,0:10:43.41,0:10:44.12,JPN,,0,0,0,,Бұл...
Dialogue: 0,0:10:45.12,0:10:46.63,JPN,,0,0,0,,Бұл Айраның инкассалық келісімі.
Dialogue: 0,0:10:47.29,0:10:49.32,JPN,,0,0,0,,Сіз қол қоясыз.
Dialogue: 0,0:10:53.42,0:10:54.58,JPN,,0,0,0,,Себебі мен оны сізге қалдырдым.
Dialogue: 0,0:10:55.05,0:10:57.84,JPN,,0,0,0,,Біраз уақыт Ислаға назар аударыңыз.
Dialogue: 0,0:10:59.47,0:10:59.92,JPN,,0,0,0,,Иә
Dialogue: 0,0:11:02.81,0:11:06.24,JPN,,0,0,0,,Түймедақ – үнемі жапырақтары бар бір жылдық өсімдік.
Dialogue: 0,0:11:07.98,0:11:09.22,JPN,,0,0,0,,Тұқымдар өздігінен түседі
Dialogue: 0,0:11:09.65,0:11:11.59,JPN,,0,0,0,,Жаңа көздер үнемі шығып тұрады.
Dialogue: 0,0:11:11.90,0:11:13.36,JPN,,0,0,0,,Оны жай қалдырсаңыз, ол тым көбейеді.
Dialogue: 0,0:11:13.99,0:11:16.56,JPN,,0,0,0,,Жақсы емес нәрсе болса, одан құтылған абзал.
Dialogue: 0,0:11:16.99,0:11:17.55,JPN,,0,0,0,,Түсіндім
Dialogue: 0,0:11:17.95,0:11:21.16,JPN,,0,0,0,,Бұл тасшөп жаздың аптап ыстығына сезімтал, сондықтан сақ болыңыз.
Dialogue: 0,0:11:21.79,0:11:24.20,JPN,,0,0,0,,Екінші жағынан, розмарин ыстыққа төзімді.
Dialogue: 0,0:11:24.79,0:11:26.50,JPN,,0,0,0,,Тек оған дұрыс күтім жасамаңыз
Dialogue: 0,0:11:26.75,0:11:29.56,JPN,,0,0,0,,Жапырақтардың қалың болғаны сонша, төменгі бөлігі қурап қалады.
Dialogue: 0,0:11:30.29,0:11:32.71,JPN,,0,0,0,,Жазда бір рет жинау керек
Dialogue: 0,0:11:37.26,0:11:38.15,JPN,,0,0,0,,Не болды?
Dialogue: 0,0:11:38.80,0:11:42.05,JPN,,0,0,0,,Исла шөптер туралы өте жақсы біледі.
Dialogue: 0,0:11:42.77,0:11:43.66,JPN,,0,0,0,,Сіз көп оқыдыңыз ба?
Dialogue: 0,0:11:44.31,0:11:48.18,JPN,,0,0,0,,Оларды өсіре бастағанда уақытым көп болды.
Dialogue: 0,0:11:48.81,0:11:53.41,JPN,,0,0,0,,Сондай-ақ, мен қайнатқан шай дәмді дейді.
Dialogue: 0,0:11:54.23,0:11:57.09,JPN,,0,0,0,,Мен әлі де осында болатындай сезінемін.
Dialogue: 0,0:11:59.07,0:12:01.92,JPN,,0,0,0,,Мен көп нәрсені өсіргім келді.
Dialogue: 0,0:12:27.10,0:12:27.88,JPN,,0,0,0,,Ха... Уф...
Dialogue: 0,0:12:32.36,0:12:33.22,JPN,,0,0,0,,«Шағып алған» деген сөзді әдемі айтыпсың, иә?
Dialogue: 0,0:12:34.32,0:12:35.80,JPN,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:12:38.45,0:12:39.48,JPN,,0,0,0,,Жоқ
Dialogue: 0,0:12:39.82,0:12:41.15,JPN,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:41.49,0:12:44.86,JPN,,0,0,0,,Дәл қазір тек Исла екеуміз көңіл көтеріп жатырмыз.
Dialogue: 0,0:12:45.29,0:12:47.29,JPN,,0,0,0,,Бірдеңе бар ма деп ойладым.
Dialogue: 0,0:12:47.75,0:12:49.11,JPN,,0,0,0,,Мені Исла үйретеді.
Dialogue: 0,0:12:49.58,0:12:51.78,JPN,,0,0,0,,Соңғы кездері мен оны игере бастадым.
Dialogue: 0,0:12:54.96,0:12:56.15,JPN,,0,0,0,,Мен оны меңгере бастадым.
Dialogue: 0,0:12:56.46,0:12:58.20,JPN,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:13:00.68,0:13:02.60,JPN,,0,0,0,,Сондықтан да өнерпаздар
Dialogue: 0,0:13:03.39,0:13:05.70,JPN,,0,0,0,,Сол кезде мен анық айтамын.
Dialogue: 0,0:13:05.88,0:13:07.22,JPN,,0,0,0,,Неге демалмайсың?
Dialogue: 0,0:13:07.73,0:13:10.24,JPN,,0,0,0,,Атмосфераны аздап оқыңыз.
Dialogue: 0,0:13:11.21,0:13:11.84,JPN,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:13:12.23,0:13:13.97,JPN,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:13:14.02,0:13:18.16,JPN,,0,0,0,,Жұмысқа келгеннен гөрі, Исламен көбірек уақыт өткізгеніңізді қалаймын.
Dialogue: 0,0:13:19.11,0:13:21.96,JPN,,0,0,0,,Мен қазір жұмыссызмын деп ешкім шағым айтпайды.
Dialogue: 0,0:13:23.87,0:13:25.92,JPN,,0,0,0,,Мен үзіліс жасай алмаймын
Dialogue: 0,0:13:26.33,0:13:27.12,JPN,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:13:27.66,0:13:30.94,JPN,,0,0,0,,Мен Мичиру мен барлығының осылай айтқанына өте ризамын.
Dialogue: 0,0:13:31.71,0:13:33.50,JPN,,0,0,0,,Бұл Ира екеуіміз бірге шешкен нәрсе болды.
Dialogue: 0,0:13:34.29,0:13:35.71,JPN,,0,0,0,,Әдеттегідей жалғастырайық
Dialogue: 0,0:13:36.21,0:13:37.86,JPN,,0,0,0,,Мұны түсінгеніңізді қалаймын.
Dialogue: 0,0:13:40.76,0:13:42.61,JPN,,0,0,0,,Мичиру, сен жеңілдің.
Dialogue: 0,0:13:42.80,0:13:43.89,JPN,,0,0,0,,Казуки-сан
Dialogue: 0,0:13:48.35,0:13:51.74,JPN,,0,0,0,,Екеуің үшін уайымдамай тұра алмаймын.
Dialogue: 0,0:13:52.98,0:13:54.42,JPN,,0,0,0,,Сонымен, мұндай нәрсе
Dialogue: 0,0:13:57.41,0:13:58.96,JPN,,0,0,0,,Рахмет саған Мичиру
Dialogue: 0,0:13:59.90,0:14:00.70,JPN,,0,0,0,,Ира
Dialogue: 0,0:14:01.57,0:14:04.77,JPN,,0,0,0,,Бірақ мен Цукасамен қанша уақыт өткіздім, сонша уақыт өткіздім.
Dialogue: 0,0:14:05.20,0:14:07.46,JPN,,0,0,0,,Өйткені мен осы жерде уақытымды бағалағым келеді
Dialogue: 0,0:14:07.91,0:14:10.01,JPN,,0,0,0,,Тек өзіңіз қалаған нәрсені жасаңыз.
Dialogue: 0,0:14:10.54,0:14:13.17,JPN,,0,0,0,,Енді, балалар, іздеуді тоқтатып, жұмысқа қайта кірісіңдер.
Dialogue: 0,0:14:13.37,0:14:14.84,JPN,,0,0,0,,Жалқау болмаңыз.
Dialogue: 0,0:14:15.21,0:14:17.57,JPN,,0,0,0,,Ой, біз қазір кездесуге барамыз.
Dialogue: 0,0:14:17.67,0:14:18.87,JPN,,0,0,0,,Қандай әзіл айтып тұрсың?
Dialogue: 0,0:14:19.17,0:14:21.32,JPN,,0,0,0,,Исла-чан, маған екінші көмек бола ма?
Dialogue: 0,0:14:21.59,0:14:21.94,JPN,,0,0,0,,Иә
Dialogue: 0,0:14:22.22,0:14:22.72,JPN,,0,0,0,,Оны қамауға алу үшін дереу келіңіз.
Dialogue: 0,0:14:31.77,0:14:32.14,JPN,,0,0,0,,Ира
Dialogue: 0,0:14:32.98,0:14:33.45,JPN,,0,0,0,,Жарай ма?
Dialogue: 0,0:14:42.28,0:14:45.00,JPN,,0,0,0,,Мен оған қол қоюым керек.
Dialogue: 0,0:14:46.24,0:14:47.76,JPN,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:14:49.12,0:14:49.74,JPN,,0,0,0,,Амансың ба?
Dialogue: 0,0:14:50.45,0:14:50.62,JPN,,0,0,0,,Иә
Dialogue: 0,0:14:51.91,0:14:52.47,JPN,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:14:53.79,0:14:55.87,JPN,,0,0,0,,Мен Цукаса қол қойғанын қалаймын.
Dialogue: 0,0:14:59.09,0:14:59.67,JPN,,0,0,0,,Цукаса?
Dialogue: 0,0:15:01.17,0:15:03.80,JPN,,0,0,0,,Кейде мен бұл туралы кенеттен ойлаймын.
Dialogue: 0,0:15:05.38,0:15:09.07,JPN,,0,0,0,,Екеуіміз осылай қашып кетсем не болар екен деп ойлаймын
Dialogue: 0,0:15:10.10,0:15:13.93,JPN,,0,0,0,,Екі адам ешкімге айтпай қалай жоғалады?
Dialogue: 0,0:15:14.23,0:15:15.88,JPN,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:15:22.69,0:15:25.32,JPN,,0,0,0,,Сіз мені жаман сезініп жатырсыз.
Dialogue: 0,0:15:59.97,0:16:00.72,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:16:07.07,0:16:10.07,JPN,,0,0,0,,Ертең Сараның жинайтын күні.
Dialogue: 0,0:16:11.06,0:16:13.21,JPN,,0,0,0,,Екеуміз де жауаптымыз
Dialogue: 0,0:16:14.29,0:16:17.60,JPN,,0,0,0,,Міне, солай.
Dialogue: 0,0:16:27.26,0:16:28.11,JPN,,0,0,0,,Мен дайындадым
Dialogue: 0,0:16:31.20,0:16:31.68,JPN,,0,0,0,,Жарайды
Dialogue: 0,0:16:32.51,0:16:33.04,JPN_Up,,0,0,0,,Иә
Dialogue: 0,0:16:33.76,0:16:36.02,JPN_Up,,0,0,0,,Мен сенің айтып тұрғаныңды жақсы түсінемін.
Dialogue: 0,0:16:36.43,0:16:37.48,JPN_Up,,0,0,0,,Бірақ...
Dialogue: 0,0:16:37.60,0:16:38.89,JPN,,0,0,0,,Онда барайық.
Dialogue: 0,0:16:38.19,0:16:41.60,JPN_Up,,0,0,0,,Ештеңе жасамайды десем жарайды ма деп ойлаймын.
Dialogue: 0,0:16:42.11,0:16:42.78,JPN_Up,,0,0,0,,Иә Иә
Dialogue: 0,0:16:43.23,0:16:44.47,JPN_Up,,0,0,0,,Бірақ...
Dialogue: 0,0:16:45.40,0:16:46.92,JPN,,0,0,0,,Бұл екеуі кетті ме?
Dialogue: 0,0:16:46.40,0:16:48.24,JPN_Up,,0,0,0,,Бұл туралы бірдеңе жасаңыз
Dialogue: 0,0:16:47.44,0:16:47.98,JPN,,0,0,0,,Иә
Dialogue: 0,0:16:49.53,0:16:51.25,JPN,,0,0,0,,Олай болса бастайық па?
Dialogue: 0,0:17:13.41,0:17:14.09,JPN,,0,0,0,,Сіз де
Dialogue: 0,0:17:27.69,0:17:28.51,JPN,,0,0,0,,Бітті.
Dialogue: 0,0:17:30.35,0:17:30.78,JPN,,0,0,0,,Өміріңде —
Dialogue: 0,0:17:33.90,0:17:36.25,JPN,,0,0,0,,Тағы біреуі қалды.
Dialogue: 0,0:17:37.49,0:17:38.11,JPN,,0,0,0,,Мен білемін
Dialogue: 0,0:17:41.67,0:17:42.26,JPN,,0,0,0,,Цукаса
Dialogue: 0,0:17:47.55,0:17:48.39,JPN,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:17:48.84,0:17:50.44,JPN,,0,0,0,,Сараның сауығуы аяқталды ма?
Dialogue: 0,0:17:50.98,0:17:54.03,JPN,,0,0,0,,Егер сізге ұнаса, кеңсеге оралыңыз.
Dialogue: 0,0:17:54.66,0:17:57.29,JPN,,0,0,0,,Сіздің жұмысыңыз аяқталды.
Dialogue: 0,0:17:57.76,0:18:00.23,JPN,,0,0,0,,Кем дегенде шағын алғыс кеші
Dialogue: 0,0:18:02.35,0:18:03.81,JPN,,0,0,0,,Сіз оны мен үшін аша аласыз.
Dialogue: 0,0:18:07.11,0:18:08.92,JPN,,0,0,0,,Өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:18:09.44,0:18:13.88,JPN,,0,0,0,,Өзіңізге ыңғайлы болуды бәрінен жоғары қойыңыз.
Dialogue: 0,0:18:14.45,0:18:17.12,JPN,,0,0,0,,Келсең де, келмесең де осындамыз.
Dialogue: 0,0:18:17.37,0:18:18.34,JPN,,0,0,0,,Өйткені мен мұны өз бетімше істеп жатырмын.
Dialogue: 0,0:18:20.41,0:18:21.27,JPN,,0,0,0,,Барлығы осы
Dialogue: 0,0:18:21.83,0:18:22.34,JPN,,0,0,0,,Джейн
Dialogue: 0,0:18:24.71,0:18:26.03,JPN,,0,0,0,,Менің айтып тұрғаным осы.
Dialogue: 0,0:18:26.56,0:18:27.27,JPN,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:18:30.26,0:18:30.75,JPN,,0,0,0,,Кеттік
Dialogue: 0,0:18:31.92,0:18:33.32,JPN,,0,0,0,,А, мен қайтып келдім.
Dialogue: 0,0:18:33.97,0:18:35.04,JPN,,0,0,0,,Қош келдің үйге.
Dialogue: 0,0:18:34.26,0:18:35.53,JPN,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:18:35.39,0:18:35.96,JPN,,0,0,0,,Сіз қайтып келдіңіз бе?
Dialogue: 0,0:18:35.64,0:18:36.39,JPN,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:18:36.80,0:18:38.60,JPN,,0,0,0,,Мен бастадым.
Dialogue: 0,0:18:41.02,0:18:41.64,JPN,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:18:44.06,0:18:45.80,JPN,,0,0,0,,Бүгінгі күннің басты кейіпкері осында.
Dialogue: 0,0:18:46.86,0:18:49.04,JPN,,0,0,0,,Жұмыста ішімдік ішуге бола ма?
Dialogue: 0,0:18:49.61,0:18:50.69,JPN,,0,0,0,,сабырлы және сабырлы
Dialogue: 0,0:18:50.82,0:18:55.78,JPN,,0,0,0,,Мұндағылардың барлығы бүгін өз жұмыстарын аяқтады.
Dialogue: 0,0:18:56.32,0:18:58.62,JPN,,0,0,0,,Ясутака енді ғана ұйықтап жатқан сияқты.
Dialogue: 0,0:18:58.95,0:19:00.10,JPN,,0,0,0,,Солай ма?
Dialogue: 0,0:19:00.70,0:19:02.09,JPN,,0,0,0,,Бүгінгі күн кестесін бөлу
Dialogue: 0,0:19:02.61,0:19:05.30,JPN,,0,0,0,,Барлығы біраз уақыттан бері өз жұмысын істеп жатыр.
Dialogue: 0,0:19:05.79,0:19:09.69,JPN,,0,0,0,,Соның кесірінен мен бір аптаға жуық бос жүрдім.
Dialogue: 0,0:19:12.96,0:19:15.56,JPN,,0,0,0,,Қалай болғанда да, жұмыс уақыты бітті.
Dialogue: 0,0:19:15.80,0:19:17.17,JPN,,0,0,0,,Ішсең мен сені кешіремін
Dialogue: 0,0:19:17.30,0:19:20.12,JPN,,0,0,0,,Жоқ, жоқ, мен сені кешірдім.
Dialogue: 0,0:19:20.39,0:19:23.71,JPN,,0,0,0,,Мен менеджерге лайықты түрде бас иіп, рұқсат алдым.
Dialogue: 0,0:19:24.10,0:19:25.49,JPN,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:19:25.06,0:19:28.86,JPN_Up,,0,0,0,,Түсіндім, түсіндім, жақсы істедің, бастық.
Dialogue: 0,0:19:27.60,0:19:29.52,JPN,,0,0,0,,Иә, бұл екеумізде де бар.
Dialogue: 0,0:19:29.90,0:19:32.12,JPN,,0,0,0,,Жарайды, барлығының назары.
Dialogue: 0,0:19:37.11,0:19:40.36,JPN,,0,0,0,,Ира, ұзақ уақыт бойы қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:19:45.87,0:19:47.25,JPN,,0,0,0,,Қане, тост айтайық.
Dialogue: 0,0:19:47.71,0:19:49.50,JPN,,0,0,0,,Сәлем!
Dialogue: 0,0:20:11.40,0:20:17.53,JPN,,0,0,0,,Менің бір ойым бар...
Dialogue: 0,0:20:18.99,0:20:20.42,JPN,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:20:22.00,0:20:23.63,JPN,,0,0,0,,Ира Көңілді көрінеді
Dialogue: 0,0:20:24.26,0:20:27.80,JPN,,0,0,0,,Мен жұмысқа қайта ораламын деп ешқашан ойламадым.
Dialogue: 0,0:20:28.21,0:20:30.21,JPN,,0,0,0,,Сізге хабарласқан адам Мичиру болды, солай ма?
Dialogue: 0,0:20:30.54,0:20:31.88,JPN,,0,0,0,,Бұл рас.
Dialogue: 0,0:20:32.29,0:20:33.97,JPN,,0,0,0,,немесе сол сияқты нәрсе.
Dialogue: 0,0:20:34.21,0:20:36.95,JPN,,0,0,0,,Мичиру бізге бұл кездесуді өткізуді ұсынған.
Dialogue: 0,0:20:37.34,0:20:38.24,JPN,,0,0,0,,Зак
Dialogue: 0,0:20:39.30,0:20:41.98,JPN,,0,0,0,,Неліктен сіз оны үнемі бөлектейсіз?
Dialogue: 0,0:20:43.37,0:20:44.04,JPN,,0,0,0,,Рахмет
Dialogue: 0,0:20:44.76,0:20:45.79,JPN_Up,,0,0,0,,Исла, іш.
Dialogue: 0,0:20:45.52,0:20:46.16,JPN,,0,0,0,,Бөлек
Dialogue: 0,0:20:46.48,0:20:49.78,JPN,,0,0,0,,Мен Цукасаның қамқор адам екенін бұрыннан білетінмін.
Dialogue: 0,0:20:55.73,0:20:57.92,JPN,,0,0,0,,Әй, несіне күлесің?
Dialogue: 0,0:20:58.40,0:21:00.06,JPN,,0,0,0,,Мичиру күлетін еді.
Dialogue: 0,0:21:00.28,0:21:01.22,JPN,,0,0,0,,Мен күлмеймін.
Dialogue: 0,0:21:01.44,0:21:03.10,JPN,,0,0,0,,Мен күлдім. Мен күлдім.
Dialogue: 0,0:21:03.45,0:21:04.92,JPN,,0,0,0,,Закқа
Dialogue: 0,0:21:13.50,0:21:14.22,JPN,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:21:14.88,0:21:17.94,JPN,,0,0,0,,Иә, мен тым қатты толқып кеттім деп ойлаймын.
Dialogue: 0,0:21:18.34,0:21:18.94,JPN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:19.34,0:21:20.28,JPN,,0,0,0,,Ақырында
Dialogue: 0,0:21:21.01,0:21:21.72,JPN,,0,0,0,,Көңілді болды ма?
Dialogue: 0,0:21:24.51,0:21:26.98,JPN,,0,0,0,,Мен, көп нәрсе болды.
Dialogue: 0,0:21:27.40,0:21:29.10,JPN,,0,0,0,,Мен сонда жұмыс істегеніме қуаныштымын.
Dialogue: 0,0:21:29.87,0:21:30.26,JPN,,0,0,0,,Иә
Dialogue: 0,0:21:31.02,0:21:33.22,JPN,,0,0,0,,Барлығымен танысқаныма қуаныштымын.
Dialogue: 0,0:21:34.52,0:21:34.91,JPN,,0,0,0,,Иә
Dialogue: 0,0:21:35.66,0:21:39.45,JPN,,0,0,0,,Дәл қазір көңілді және қуанышты нәрселер өте көп.
Dialogue: 0,0:21:39.99,0:21:41.86,JPN,,0,0,0,,Оның бәрін күнделігіме жазып та үлгермеймін.
Dialogue: 0,0:21:42.70,0:21:45.55,JPN,,0,0,0,,Мұның бәрі Цукасаның арқасында.
Dialogue: 0,0:21:48.20,0:21:48.74,JPN,,0,0,0,,Осымен
Dialogue: 0,0:21:49.75,0:21:50.56,JPN,,0,0,0,,Сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:21:52.37,0:21:55.29,JPN,,0,0,0,,Сен бүгін Сараға бірдеңе дедің ғой, солай ма?
Dialogue: 0,0:21:56.01,0:21:56.38,JPN,,0,0,0,,Иә
Dialogue: 0,0:21:57.09,0:22:00.97,JPN,,0,0,0,,Осы уақытқа дейін мен мұны әрқашан жинақтың соңында жасайтынмын, солай ма?
Dialogue: 0,0:22:01.65,0:22:04.07,JPN,,0,0,0,,Маған біраз уақыт қызық болды.
Dialogue: 0,0:22:04.81,0:22:06.63,JPN,,0,0,0,,Маған таң қалдым, сіз не айтып тұрсыз.
Dialogue: 0,0:22:09.43,0:22:13.68,JPN,,0,0,0,,«Сүйікті адамымды бір күні тағы кездестіремін деп үміттенемін».
Dialogue: 0,0:23:49.74,0:23:55.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
