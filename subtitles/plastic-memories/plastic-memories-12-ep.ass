Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.02,0:00:15.03,Default,,0,0,0,,Цукаса… Цукаса…
Dialogue: 0,0:00:17.04,0:00:18.00,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:00:19.09,0:00:20.08,Default,,0,0,0,,Уау, бұл шекара ма?
Dialogue: 0,0:00:21.05,0:00:23.03,Default,,0,0,0,,Мен жалғыз болғанды ұнатпаймын.
Dialogue: 0,0:00:29.00,0:00:30.00,Default,,0,0,0,,Сіз әлі де сондасыз, солай емес пе?
Dialogue: 0,0:00:30.03,0:00:32.05,Default,,0,0,0,,Цукаса сенің жаныңда, солай ма?
Dialogue: 0,0:00:37.00,0:00:39.02,Default,,0,0,0,,Мен мұндамын Мен осындамын
Dialogue: 0,0:00:40.02,0:00:43.01,Default,,0,0,0,,Ешқайда кетпеңіз
Dialogue: 0,0:00:54.03,0:00:55.03,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:00:56.01,0:00:57.00,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:00:58.09,0:00:59.05,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:01:00.00,0:01:02.00,Default,,0,0,0,,Сіз оны бұрынғыдан жақсырақ жасай алар едіңіз деп ойламайсыз ба?
Dialogue: 0,0:01:02.06,0:01:04.08,Default,,0,0,0,,Бұл күнделікті күш-жігердің нәтижесі.
Dialogue: 0,0:01:05.06,0:01:07.09,Default,,0,0,0,,Мен тырыссам қолымнан келетін баламын.
Dialogue: 0,0:01:19.04,0:01:20.09,Default,,0,0,0,,Ира Аноса
Dialogue: 0,0:01:22.06,0:01:23.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:25.02,0:01:26.06,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:01:29.09,0:01:30.05,Default,,0,0,0,,Оның дәмі қандай?
Dialogue: 0,0:01:35.04,0:01:39.00,Default,,0,0,0,,Жарықты жинау
Dialogue: 0,0:01:47.00,0:01:51.05,Default,,0,0,0,,Қоштасудан естеліктер
Dialogue: 0,0:01:52.06,0:01:58.06,Default,,0,0,0,,Көзіме тамсанып, алысқа қадалған арман
Dialogue: 0,0:01:58.08,0:02:04.01,Default,,0,0,0,,Ән жады бұзылады
Dialogue: 0,0:02:04.04,0:02:09.05,Default,,0,0,0,,Жалғыздықтың көз жасын ақырын сүртейік
Dialogue: 0,0:02:09.08,0:02:16.07,Default,,0,0,0,,Ұзартылған қол - айналмалы дөңгелек, оны абайлап алыңыз
Dialogue: 0,0:02:17.00,0:02:22.00,Default,,0,0,0,,Оянғалы тұрған жадының үзінділері
Dialogue: 0,0:02:23.00,0:02:27.09,Default,,0,0,0,,Мен төмен қарап, жоқ болып кетсін деп дұға етемін, бірақ
Dialogue: 0,0:02:28.00,0:02:34.00,Default,,0,0,0,,Бұл сіз тапқан дауыс
Dialogue: 0,0:02:34.03,0:02:41.00,Default,,0,0,0,,Сағат тілі қозғала бастайды, көп ұзамай дүниенің түсі өзгереді
Dialogue: 0,0:02:41.03,0:02:47.02,Default,,0,0,0,,Менің пластикалық жүрегім жарқырайды
Dialogue: 0,0:02:47.04,0:02:52.01,Default,,0,0,0,,Ұмытпа, есте сақта
Dialogue: 0,0:02:52.05,0:02:59.00,Default,,0,0,0,,Бір күні тағы кездескенше
Dialogue: 0,0:03:05.01,0:03:06.02,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:10.08,0:03:12.01,Default,,0,0,0,,Не Ни Цукаса
Dialogue: 0,0:03:13.06,0:03:17.02,Default,,0,0,0,,Сіз дәл қазір киноға барғыңыз келеді.
Dialogue: 0,0:03:18.01,0:03:19.01,Default,,0,0,0,,Сіз солай ойлайсыз.
Dialogue: 0,0:03:20.07,0:03:22.04,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:03:25.09,0:03:26.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:27.05,0:03:28.08,Default,,0,0,0,,Бірақ неге кенеттен?
Dialogue: 0,0:03:29.04,0:03:31.09,Default,,0,0,0,,Зактың сізге сыйлық беруі сирек.
Dialogue: 0,0:03:33.04,0:03:36.07,Default,,0,0,0,,Мичирудан сұраудан басқа амалым қалмады...
Dialogue: 0,0:03:36.07,0:03:38.00,Default,,0,0,0,,Ах, ақымақ.
Dialogue: 0,0:03:43.04,0:03:45.02,Default,,0,0,0,,Жарайды, қабылдаңыз.
Dialogue: 0,0:03:45.04,0:03:47.04,Default,,0,0,0,,Ира екеуміз келіп, көңіл көтерсек ше?
Dialogue: 0,0:03:48.09,0:03:52.04,Default,,0,0,0,,Жарайды, мен билетті кездейсоқ алдым.
Dialogue: 0,0:03:52.07,0:03:56.05,Default,,0,0,0,,Бірақ мен бос емеспін, бос жүргендер сендерге қалдырамын.
Dialogue: 0,0:03:56.08,0:03:57.09,Default,,0,0,0,,Мұның бәрі шын мәнінде бар.
Dialogue: 0,0:03:58.04,0:04:00.03,Default,,0,0,0,,Түсіндім, бәрібір рахмет.
Dialogue: 0,0:04:00.04,0:04:01.08,Default,,0,0,0,,О Цукаса-кун
Dialogue: 0,0:04:02.04,0:04:03.06,Default,,0,0,0,,Бұл дұрыс болды.
Dialogue: 0,0:04:03.09,0:04:05.08,Default,,0,0,0,,Қаласаңыз, алыңыз.
Dialogue: 0,0:04:07.01,0:04:07.51,Default,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:04:08.01,0:04:10.03,Default,,0,0,0,,Risotto қонақ үй каталогы?
Dialogue: 0,0:04:11.03,0:04:13.00,Default,,0,0,0,,тиімді пайдалану
Dialogue: 0,0:04:13.07,0:04:14.02,Default,,0,0,0,,Цукаса
Dialogue: 0,0:04:14.09,0:04:18.01,Default,,0,0,0,,Мен жиі баратын мейрамханаға шақыру билетін алдым.
Dialogue: 0,0:04:18.05,0:04:19.04,Default,,0,0,0,,Саған берейін бе?
Dialogue: 0,0:04:19.09,0:04:22.01,Default,,0,0,0,,Дүкенде дресс-код болғандықтан.
Dialogue: 0,0:04:22.04,0:04:24.00,Default,,0,0,0,,Мен де салтанатты киім дайындадым.
Dialogue: 0,0:04:24.08,0:04:27.01,Default,,0,0,0,,Кешкі ас билеттері мен қосалқы тауарларды көрсетеді
Dialogue: 0,0:04:27.06,0:04:30.02,Default,,0,0,0,,Мен фан-клуб жәрдемақысы ретінде қосымша ақша алдым.
Dialogue: 0,0:04:30.05,0:04:31.02,Default,,0,0,0,,Қарсы болмасаңыз
Dialogue: 0,0:04:31.05,0:04:35.03,Default,,0,0,0,,Сіз менің көлігімді қалаған уақытта пайдалана аласыз.
Dialogue: 0,0:04:36.06,0:04:38.03,Default,,0,0,0,,Бұл тұрақ картасы.
Dialogue: 0,0:04:39.00,0:04:40.09,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық. Лицензияңыз жоқ па?
Dialogue: 0,0:04:41.05,0:04:42.07,Default,,0,0,0,,сабырлы және сабырлы
Dialogue: 0,0:04:42.09,0:04:44.06,Default,,0,0,0,,Өйткені бұл автоматты схема сияқты
Dialogue: 0,0:04:45.00,0:04:47.00,Default,,0,0,0,,Кешіріңіз, Цукаса-кун.
Dialogue: 0,0:04:47.02,0:04:49.09,Default,,0,0,0,,Менің қалтамдағы ақшам ай сайын аз.
Dialogue: 0,0:04:50.02,0:04:52.04,Default,,0,0,0,,Сондықтан мен дайындай алатын жалғыз нәрсе осы.
Dialogue: 0,0:04:59.06,0:05:01.07,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:05:01.09,0:05:04.00,Default,,0,0,0,,Ертең түсіріп, сыртқа шығамыз ба?
Dialogue: 0,0:05:16.04,0:05:18.04,Default,,0,0,0,,Бұл арман өмір сияқты
Dialogue: 0,0:05:19.01,0:05:20.01,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:05:20.05,0:05:23.00,Default,,0,0,0,,Шынымен керемет, сізге рахмет
Dialogue: 0,0:05:23.05,0:05:24.02,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:05:24.08,0:05:27.00,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:05:27.05,0:05:29.02,Default,,0,0,0,,Жасағым келетін нәрселер өте көп.
Dialogue: 0,0:05:29.08,0:05:31.02,Default,,0,0,0,,Көп адамдар қызық.
Dialogue: 0,0:05:31.06,0:05:32.07,Default,,0,0,0,,Мен сені қызғанамын
Dialogue: 0,0:05:33.04,0:05:34.06,Default,,0,0,0,,Суық, солай емес пе?
Dialogue: 0,0:05:34.09,0:05:36.09,Default,,0,0,0,,Мен өмірден көбірек ләззат алғым келеді.
Dialogue: 0,0:05:37.05,0:05:38.06,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:05:39.03,0:05:44.02,Default,,0,0,0,,Мен сенің сүйкімді күлкіңді монополиялай алғым келеді
Dialogue: 0,0:05:45.00,0:05:46.02,Default,,0,0,0,,Осының өзі қанағаттанарлық
Dialogue: 0,0:05:46.07,0:05:48.08,Default,,0,0,0,,Ах, Джо, мен сені жақсы көремін.
Dialogue: 0,0:05:51.03,0:05:53.06,Default,,0,0,0,,Қалай болды? Сіздің алғашқы фильміңіз қандай болды?
Dialogue: 0,0:05:53.09,0:05:55.03,Default,,0,0,0,,Бұл өте қызық болды
Dialogue: 0,0:05:56.00,0:05:57.04,Default,,0,0,0,,Менің жүрегім әлі соғып тұр
Dialogue: 0,0:05:57.08,0:06:00.03,Default,,0,0,0,,Жол бойы қолымды ұстадың.
Dialogue: 0,0:06:01.09,0:06:02.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:03.03,0:06:07.09,Default,,0,0,0,,Мен қараңғы жерде жүргенде Цукаса жоғалып кете ме деп қорқамын.
Dialogue: 0,0:06:08.06,0:06:09.01,Default,,0,0,0,,Ира
Dialogue: 0,0:06:10.01,0:06:11.03,Default,,0,0,0,,Мазасыздық тудырды ма?
Dialogue: 0,0:06:14.03,0:06:15.09,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:06:18.02,0:06:21.04,Default,,0,0,0,,Қолымды қалағаныңызша ұстай аласыз.
Dialogue: 0,0:06:23.07,0:06:24.05,Default,,0,0,0,,Сәлем Цукаса
Dialogue: 0,0:06:24.08,0:06:27.09,Default,,0,0,0,,Мен бұл нәрсені фильмде көргім келеді.
Dialogue: 0,0:06:28.05,0:06:29.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:31.08,0:06:33.01,Default,,0,0,0,,Бұл шынында да тізе жастығы ма?
Dialogue: 0,0:06:33.09,0:06:38.02,Default,,0,0,0,,Мендікін пайдаланғаның дұрыс.
Dialogue: 0,0:06:42.05,0:06:45.04,Default,,0,0,0,,Олай болса, сөзіңізді қабыл алыңыз.
Dialogue: 0,0:06:51.02,0:06:53.04,Default,,0,0,0,,Цукасаның шашы дірілдейді
Dialogue: 0,0:06:54.00,0:06:56.01,Default,,0,0,0,,Мен қатты ұялып тұрмын
Dialogue: 0,0:06:56.07,0:06:59.01,Default,,0,0,0,,Қате Мен сізді анық ести алмадым.
Dialogue: 0,0:06:59.05,0:07:00.07,Default,,0,0,0,,Жоқ, бұл қате.
Dialogue: 0,0:07:01.01,0:07:02.07,Default,,0,0,0,,Сіз оны шынымен ести аласыз, солай ма?
Dialogue: 0,0:07:03.03,0:07:04.03,Default,,0,0,0,,Мен сізді естімеймін
Dialogue: 0,0:07:04.08,0:07:05.02,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:16.02,0:07:17.02,Default,,0,0,0,,Сәлем Цукаса
Dialogue: 0,0:07:17.08,0:07:21.06,Default,,0,0,0,,Мен, соңғы кездері түнде ұйықтауға қорқатын болдым.
Dialogue: 0,0:07:23.03,0:07:24.09,Default,,0,0,0,,Мен оны елестетемін.
Dialogue: 0,0:07:25.07,0:07:28.07,Default,,0,0,0,,Мен енді ешқашан оянбаймын ба деп қорқамын
Dialogue: 0,0:07:29.06,0:07:32.09,Default,,0,0,0,,Мен Цукасамен енді кездесе алмаймын ба деп қорқамын.
Dialogue: 0,0:07:33.06,0:07:36.04,Default,,0,0,0,,Бірақ мен Цукасамен осылай болғанда,
Dialogue: 0,0:07:36.08,0:07:40.02,Default,,0,0,0,,Сол қорқынышты сезім кенет жоғалады
Dialogue: 0,0:07:43.06,0:07:45.05,Default,,0,0,0,,Цукаса керемет
Dialogue: 0,0:07:46.09,0:07:49.05,Default,,0,0,0,,Сіз әрқашан маған сене аласыз.
Dialogue: 0,0:07:50.07,0:07:51.01,Default,,0,0,0,,Иә
Dialogue: 0,0:07:56.06,0:07:57.06,Default,,0,0,0,,Ертең не істейсің?
Dialogue: 0,0:07:58.02,0:08:01.09,Default,,0,0,0,,Мен шынымен де бәрі менің жұмыстан үзіліс алғанымды қалайтынын сезінемін.
Dialogue: 0,0:08:11.04,0:08:14.07,Default,,0,0,0,,Цукаса сыртқа шыққысы келсе, маған да жарайды.
Dialogue: 0,0:08:16.01,0:08:17.02,Default,,0,0,0,,Ол мазасыз көрінді.
Dialogue: 0,0:08:21.09,0:08:25.05,Default,,0,0,0,,Күндерім осылай жалғаса берсе, мен өте бақытты болар едім.
Dialogue: 0,0:08:26.01,0:08:29.02,Default,,0,0,0,,Бірақ мен мұны істесем, менің денем баяу болатынына сенімдімін.
Dialogue: 0,0:08:30.05,0:08:34.06,Default,,0,0,0,,Соңғы күніне дейін қозғала алмасаңыз
Dialogue: 0,0:08:35.04,0:08:36.00,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:08:36.05,0:08:37.02,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:08:37.05,0:08:40.05,Default,,0,0,0,,Иә, бұл мүмкін емес.
Dialogue: 0,0:08:41.04,0:08:43.06,Default,,0,0,0,,Бірақ мен бұл туралы ойладым
Dialogue: 0,0:08:59.01,0:09:00.01,Default,,0,0,0,,Егер солай болса, онда
Dialogue: 0,0:09:00.08,0:09:02.01,Default,,0,0,0,,Әдеттегідей жалғастырайық.
Dialogue: 0,0:09:03.05,0:09:05.08,Default,,0,0,0,,Бүгінгідей күндер анда-санда жақсы.
Dialogue: 0,0:09:08.06,0:09:09.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:21.03,0:09:24.09,Default,,0,0,0,,Деректер туралы ерекше жаңа ештеңе жоқ.
Dialogue: 0,0:09:25.05,0:09:26.02,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:09:29.04,0:09:31.00,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым
Dialogue: 0,0:09:31.03,0:09:32.07,Default,,0,0,0,,Түсіндім. Яғни бұл…
Dialogue: 0,0:09:32.07,0:09:34.04,Default,,0,0,0,,Сіз кешігіп қалдыңыз.
Dialogue: 0,0:09:34.06,0:09:36.03,Default,,0,0,0,,Мен жұмыстан бос емеспін.
Dialogue: 0,0:09:36.08,0:09:38.04,Default,,0,0,0,,Оны би тобына ұсынайық.
Dialogue: 0,0:09:38.07,0:09:39.05,Default,,0,0,0,,Дайындал
Dialogue: 0,0:09:41.00,0:09:42.05,Default,,0,0,0,,Мен киімімді ауыстырғалы жатырмын.
Dialogue: 0,0:09:45.00,0:09:46.08,Default,,0,0,0,,Бұл Исланың деректері ме?
Dialogue: 0,0:09:47.00,0:09:48.06,Default,,0,0,0,,Бүгін де келдің бе?
Dialogue: 0,0:09:48.08,0:09:50.01,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:50.02,0:09:51.08,Default,,0,0,0,,Бұл жігіттер
Dialogue: 0,0:09:52.03,0:09:55.00,Default,,0,0,0,,Мұны жиі жасаудың қажеті жоқ.
Dialogue: 0,0:09:55.03,0:09:58.04,Default,,0,0,0,,Ал, өз басым, бұл жеңілдеу сияқты.
Dialogue: 0,0:09:58.05,0:10:00.02,Default,,0,0,0,,Мен мұны түсінемін, бірақ
Dialogue: 0,0:10:01.01,0:10:04.02,Default,,0,0,0,,Сондықтан демалыс күніне дейін келудің қажеті жоқ.
Dialogue: 0,0:10:04.08,0:10:09.00,Default,,0,0,0,,Сол екеуіне қарап жылағым келеді.
Dialogue: 0,0:10:15.07,0:10:16.03,Default,,0,0,0,,Цукаса
Dialogue: 0,0:10:17.02,0:10:17.52,Default,,0,0,0,,Саған бір нәрсе сұрасам бола ма?
Dialogue: 0,0:10:24.01,0:10:25.03,Default,,0,0,0,,Бұл аздап жақсы болды.
Dialogue: 0,0:10:25.07,0:10:27.05,Default,,0,0,0,,Менің де Кадзуки-саннан сұрайын дегенім бар.
Dialogue: 0,0:10:27.09,0:10:28.04,Default,,0,0,0,,Не?
Dialogue: 0,0:10:29.00,0:10:30.08,Default,,0,0,0,,Маған келесі жұмысты беруіңізді сұраймын.
Dialogue: 0,0:10:31.05,0:10:35.04,Default,,0,0,0,,Сара екеуміз ғана басқарамыз.
Dialogue: 0,0:10:43.04,0:10:44.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:45.01,0:10:46.06,Default,,0,0,0,,Бұл Айраның инкассалық келісімі.
Dialogue: 0,0:10:47.02,0:10:49.03,Default,,0,0,0,,Сіз қол қоясыз.
Dialogue: 0,0:10:53.04,0:10:54.05,Default,,0,0,0,,Себебі мен оны сізге қалдырдым.
Dialogue: 0,0:10:55.00,0:10:57.08,Default,,0,0,0,,Біраз уақыт Ислаға назар аударыңыз.
Dialogue: 0,0:10:59.04,0:10:59.54,Default,,0,0,0,,Иә
Dialogue: 0,0:11:02.08,0:11:06.02,Default,,0,0,0,,Түймедақ – үнемі жапырақтары бар бір жылдық өсімдік.
Dialogue: 0,0:11:07.09,0:11:09.02,Default,,0,0,0,,Тұқымдар өздігінен түседі
Dialogue: 0,0:11:09.06,0:11:11.05,Default,,0,0,0,,Жаңа көздер үнемі шығып тұрады.
Dialogue: 0,0:11:11.09,0:11:13.03,Default,,0,0,0,,Оны жай қалдырсаңыз, ол тым көбейеді.
Dialogue: 0,0:11:13.09,0:11:16.05,Default,,0,0,0,,Жақсы емес нәрсе болса, одан құтылған абзал.
Dialogue: 0,0:11:16.09,0:11:17.05,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:11:17.09,0:11:21.01,Default,,0,0,0,,Бұл тасшөп жаздың аптап ыстығына сезімтал, сондықтан сақ болыңыз.
Dialogue: 0,0:11:21.07,0:11:24.02,Default,,0,0,0,,Екінші жағынан, розмарин ыстыққа төзімді.
Dialogue: 0,0:11:24.07,0:11:26.05,Default,,0,0,0,,Тек оған дұрыс күтім жасамаңыз
Dialogue: 0,0:11:26.07,0:11:29.05,Default,,0,0,0,,Жапырақтардың қалың болғаны сонша, төменгі бөлігі қурап қалады.
Dialogue: 0,0:11:30.02,0:11:32.07,Default,,0,0,0,,Жазда бір рет жинау керек
Dialogue: 0,0:11:37.02,0:11:38.01,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:38.08,0:11:42.00,Default,,0,0,0,,Исла шөптер туралы өте жақсы біледі.
Dialogue: 0,0:11:42.07,0:11:43.06,Default,,0,0,0,,Сіз көп оқыдыңыз ба?
Dialogue: 0,0:11:44.03,0:11:48.01,Default,,0,0,0,,Оларды өсіре бастағанда уақытым көп болды.
Dialogue: 0,0:11:48.08,0:11:53.04,Default,,0,0,0,,Сондай-ақ, мен қайнатқан шай дәмді дейді.
Dialogue: 0,0:11:54.02,0:11:57.00,Default,,0,0,0,,Мен әлі де осында болатындай сезінемін.
Dialogue: 0,0:11:59.00,0:12:01.09,Default,,0,0,0,,Мен көп нәрсені өсіргім келді.
Dialogue: 0,0:12:27.01,0:12:27.51,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:12:32.03,0:12:33.02,Default,,0,0,0,,«Шағып алған» деген сөзді әдемі айтыпсың, иә?
Dialogue: 0,0:12:34.03,0:12:35.08,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:12:38.04,0:12:39.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:39.08,0:12:41.01,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:41.04,0:12:44.08,Default,,0,0,0,,Дәл қазір тек Исла екеуміз көңіл көтеріп жатырмыз.
Dialogue: 0,0:12:45.02,0:12:47.02,Default,,0,0,0,,Бірдеңе бар ма деп ойладым.
Dialogue: 0,0:12:47.07,0:12:49.01,Default,,0,0,0,,Мені Исла үйретеді.
Dialogue: 0,0:12:49.05,0:12:51.07,Default,,0,0,0,,Соңғы кездері мен оны игере бастадым.
Dialogue: 0,0:12:54.09,0:12:56.01,Default,,0,0,0,,Мен оны меңгере бастадым.
Dialogue: 0,0:12:56.04,0:12:58.02,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:13:00.06,0:13:02.06,Default,,0,0,0,,Сондықтан да өнерпаздар
Dialogue: 0,0:13:03.03,0:13:05.07,Default,,0,0,0,,Сол кезде мен анық айтамын.
Dialogue: 0,0:13:05.08,0:13:07.02,Default,,0,0,0,,Неге демалмайсың?
Dialogue: 0,0:13:07.07,0:13:10.02,Default,,0,0,0,,Атмосфераны аздап оқыңыз.
Dialogue: 0,0:13:12.02,0:13:13.09,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:13:14.00,0:13:18.01,Default,,0,0,0,,Жұмысқа келгеннен гөрі, Исламен көбірек уақыт өткізгеніңізді қалаймын.
Dialogue: 0,0:13:19.01,0:13:21.09,Default,,0,0,0,,Мен қазір жұмыссызмын деп ешкім шағым айтпайды.
Dialogue: 0,0:13:23.08,0:13:25.09,Default,,0,0,0,,Мен үзіліс жасай алмаймын
Dialogue: 0,0:13:26.03,0:13:27.01,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:13:27.06,0:13:30.09,Default,,0,0,0,,Мен Мичиру мен барлығының осылай айтқанына өте ризамын.
Dialogue: 0,0:13:31.07,0:13:33.05,Default,,0,0,0,,Бұл Ира екеуіміз бірге шешкен нәрсе болды.
Dialogue: 0,0:13:34.02,0:13:35.07,Default,,0,0,0,,Әдеттегідей жалғастырайық
Dialogue: 0,0:13:36.02,0:13:37.08,Default,,0,0,0,,Мұны түсінгеніңізді қалаймын.
Dialogue: 0,0:13:40.07,0:13:42.06,Default,,0,0,0,,Мичиру, сен жеңілдің.
Dialogue: 0,0:13:42.08,0:13:43.08,Default,,0,0,0,,Казуки-сан
Dialogue: 0,0:13:48.03,0:13:51.07,Default,,0,0,0,,Екеуің үшін уайымдамай тұра алмаймын.
Dialogue: 0,0:13:52.09,0:13:54.04,Default,,0,0,0,,Сонымен, мұндай нәрсе
Dialogue: 0,0:13:57.04,0:13:58.09,Default,,0,0,0,,Рахмет саған Мичиру
Dialogue: 0,0:13:59.09,0:14:00.07,Default,,0,0,0,,Ира
Dialogue: 0,0:14:01.05,0:14:04.07,Default,,0,0,0,,Бірақ мен Цукасамен қанша уақыт өткіздім, сонша уақыт өткіздім.
Dialogue: 0,0:14:05.02,0:14:07.04,Default,,0,0,0,,Өйткені мен осы жерде уақытымды бағалағым келеді
Dialogue: 0,0:14:07.09,0:14:10.00,Default,,0,0,0,,Тек өзіңіз қалаған нәрсені жасаңыз.
Dialogue: 0,0:14:10.05,0:14:13.01,Default,,0,0,0,,Енді, балалар, іздеуді тоқтатып, жұмысқа қайта кірісіңдер.
Dialogue: 0,0:14:13.03,0:14:14.08,Default,,0,0,0,,Жалқау болмаңыз.
Dialogue: 0,0:14:15.02,0:14:17.05,Default,,0,0,0,,Ой, біз қазір кездесуге барамыз.
Dialogue: 0,0:14:17.06,0:14:18.08,Default,,0,0,0,,Қандай әзіл айтып тұрсың?
Dialogue: 0,0:14:19.01,0:14:21.03,Default,,0,0,0,,Исла-чан, маған екінші көмек бола ма?
Dialogue: 0,0:14:21.05,0:14:21.55,Default,,0,0,0,,Иә
Dialogue: 0,0:14:22.02,0:14:22.52,Default,,0,0,0,,Оны қамауға алу үшін дереу келіңіз.
Dialogue: 0,0:14:31.07,0:14:32.01,Default,,0,0,0,,Ира
Dialogue: 0,0:14:32.09,0:14:33.04,Default,,0,0,0,,Жарай ма?
Dialogue: 0,0:14:42.02,0:14:45.00,Default,,0,0,0,,Мен оған қол қоюым керек.
Dialogue: 0,0:14:46.02,0:14:47.07,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:14:49.01,0:14:49.51,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:14:50.04,0:14:50.54,Default,,0,0,0,,Иә
Dialogue: 0,0:14:51.09,0:14:52.04,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:14:53.07,0:14:55.08,Default,,0,0,0,,Мен Цукаса қол қойғанын қалаймын.
Dialogue: 0,0:14:59.00,0:14:59.50,Default,,0,0,0,,Цукаса?
Dialogue: 0,0:15:01.01,0:15:03.08,Default,,0,0,0,,Кейде мен бұл туралы кенеттен ойлаймын.
Dialogue: 0,0:15:05.03,0:15:09.00,Default,,0,0,0,,Екеуіміз осылай қашып кетсем не болар екен деп ойлаймын
Dialogue: 0,0:15:10.01,0:15:13.09,Default,,0,0,0,,Екі адам ешкімге айтпай қалай жоғалады?
Dialogue: 0,0:15:14.02,0:15:15.08,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:15:22.06,0:15:25.03,Default,,0,0,0,,Сіз мені жаман сезініп жатырсыз.
Dialogue: 0,0:15:59.09,0:16:00.07,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:07.00,0:16:10.00,Default,,0,0,0,,Ертең Сараның жинайтын күні.
Dialogue: 0,0:16:11.00,0:16:13.02,Default,,0,0,0,,Екеуміз де жауаптымыз
Dialogue: 0,0:16:14.02,0:16:17.06,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:16:27.02,0:16:28.01,Default,,0,0,0,,Мен дайындадым
Dialogue: 0,0:16:31.02,0:16:31.52,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:32.05,0:16:33.00,Default,,0,0,0,,Иә
Dialogue: 0,0:16:33.07,0:16:36.00,Default,,0,0,0,,Мен сенің айтып тұрғаныңды жақсы түсінемін.
Dialogue: 0,0:16:36.04,0:16:37.04,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:37.06,0:16:38.08,Default,,0,0,0,,Онда барайық.
Dialogue: 0,0:16:38.01,0:16:41.06,Default,,0,0,0,,Ештеңе жасамайды десем жарайды ма деп ойлаймын.
Dialogue: 0,0:16:42.01,0:16:42.51,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:16:43.02,0:16:44.04,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:45.04,0:16:46.09,Default,,0,0,0,,Бұл екеуі кетті ме?
Dialogue: 0,0:16:46.04,0:16:48.02,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз
Dialogue: 0,0:16:47.04,0:16:47.54,Default,,0,0,0,,Иә
Dialogue: 0,0:16:49.05,0:16:51.02,Default,,0,0,0,,Олай болса бастайық па?
Dialogue: 0,0:17:13.04,0:17:14.00,Default,,0,0,0,,Сіз де
Dialogue: 0,0:17:27.06,0:17:28.05,Default,,0,0,0,,Бітті.
Dialogue: 0,0:17:30.03,0:17:30.53,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:17:33.09,0:17:36.02,Default,,0,0,0,,Тағы біреуі қалды.
Dialogue: 0,0:17:37.04,0:17:38.01,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:17:41.06,0:17:42.02,Default,,0,0,0,,Цукаса
Dialogue: 0,0:17:47.05,0:17:48.03,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:17:48.08,0:17:50.04,Default,,0,0,0,,Сараның сауығуы аяқталды ма?
Dialogue: 0,0:17:50.09,0:17:54.00,Default,,0,0,0,,Егер сізге ұнаса, кеңсеге оралыңыз.
Dialogue: 0,0:17:54.06,0:17:57.02,Default,,0,0,0,,Сіздің жұмысыңыз аяқталды.
Dialogue: 0,0:17:57.07,0:18:00.02,Default,,0,0,0,,Кем дегенде шағын алғыс кеші
Dialogue: 0,0:18:02.03,0:18:03.08,Default,,0,0,0,,Сіз оны мен үшін аша аласыз.
Dialogue: 0,0:18:07.01,0:18:08.09,Default,,0,0,0,,Өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:18:09.04,0:18:13.08,Default,,0,0,0,,Өзіңізге ыңғайлы болуды бәрінен жоғары қойыңыз.
Dialogue: 0,0:18:14.04,0:18:17.01,Default,,0,0,0,,Келсең де, келмесең де осындамыз.
Dialogue: 0,0:18:17.03,0:18:18.03,Default,,0,0,0,,Өйткені мен мұны өз бетімше істеп жатырмын.
Dialogue: 0,0:18:20.04,0:18:21.02,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:18:21.08,0:18:22.03,Default,,0,0,0,,Джейн
Dialogue: 0,0:18:24.07,0:18:26.00,Default,,0,0,0,,Менің айтып тұрғаным осы.
Dialogue: 0,0:18:26.05,0:18:27.02,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:18:30.02,0:18:30.52,Default,,0,0,0,,Кеттік
Dialogue: 0,0:18:31.09,0:18:33.03,Default,,0,0,0,,А, мен қайтып келдім.
Dialogue: 0,0:18:33.09,0:18:35.00,Default,,0,0,0,,Қош келдің үйге.
Dialogue: 0,0:18:34.02,0:18:35.05,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:18:35.03,0:18:35.53,Default,,0,0,0,,Сіз қайтып келдіңіз бе?
Dialogue: 0,0:18:36.08,0:18:38.06,Default,,0,0,0,,Мен бастадым.
Dialogue: 0,0:18:41.00,0:18:41.50,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:18:44.00,0:18:45.08,Default,,0,0,0,,Бүгінгі күннің басты кейіпкері осында.
Dialogue: 0,0:18:46.08,0:18:49.00,Default,,0,0,0,,Жұмыста ішімдік ішуге бола ма?
Dialogue: 0,0:18:49.06,0:18:50.06,Default,,0,0,0,,сабырлы және сабырлы
Dialogue: 0,0:18:50.08,0:18:55.07,Default,,0,0,0,,Мұндағылардың барлығы бүгін өз жұмыстарын аяқтады.
Dialogue: 0,0:18:56.03,0:18:58.06,Default,,0,0,0,,Ясутака енді ғана ұйықтап жатқан сияқты.
Dialogue: 0,0:18:58.09,0:19:00.01,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:00.07,0:19:02.00,Default,,0,0,0,,Бүгінгі күн кестесін бөлу
Dialogue: 0,0:19:02.06,0:19:05.03,Default,,0,0,0,,Барлығы біраз уақыттан бері өз жұмысын істеп жатыр.
Dialogue: 0,0:19:05.07,0:19:09.06,Default,,0,0,0,,Соның кесірінен мен бір аптаға жуық бос жүрдім.
Dialogue: 0,0:19:12.09,0:19:15.05,Default,,0,0,0,,Қалай болғанда да, жұмыс уақыты бітті.
Dialogue: 0,0:19:15.08,0:19:17.01,Default,,0,0,0,,Ішсең мен сені кешіремін
Dialogue: 0,0:19:17.03,0:19:20.01,Default,,0,0,0,,Жоқ, жоқ, мен сені кешірдім.
Dialogue: 0,0:19:20.03,0:19:23.07,Default,,0,0,0,,Мен менеджерге лайықты түрде бас иіп, рұқсат алдым.
Dialogue: 0,0:19:24.01,0:19:25.04,Default,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:19:25.00,0:19:28.08,Default,,0,0,0,,Түсіндім, түсіндім, жақсы істедің, бастық.
Dialogue: 0,0:19:27.06,0:19:29.05,Default,,0,0,0,,Иә, бұл екеумізде де бар.
Dialogue: 0,0:19:29.09,0:19:32.01,Default,,0,0,0,,Жарайды, барлығының назары.
Dialogue: 0,0:19:37.01,0:19:40.03,Default,,0,0,0,,Ира, ұзақ уақыт бойы қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:19:45.08,0:19:47.02,Default,,0,0,0,,Қане, тост айтайық.
Dialogue: 0,0:19:47.07,0:19:49.05,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:11.04,0:20:17.05,Default,,0,0,0,,Менің бір ойым бар...
Dialogue: 0,0:20:18.09,0:20:20.04,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:20:22.00,0:20:23.06,Default,,0,0,0,,Ира Көңілді көрінеді
Dialogue: 0,0:20:24.02,0:20:27.08,Default,,0,0,0,,Мен жұмысқа қайта ораламын деп ешқашан ойламадым.
Dialogue: 0,0:20:28.02,0:20:30.02,Default,,0,0,0,,Сізге хабарласқан адам Мичиру болды, солай ма?
Dialogue: 0,0:20:30.05,0:20:31.08,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:20:32.02,0:20:33.09,Default,,0,0,0,,немесе сол сияқты нәрсе.
Dialogue: 0,0:20:34.02,0:20:36.09,Default,,0,0,0,,Мичиру бізге бұл кездесуді өткізуді ұсынған.
Dialogue: 0,0:20:37.03,0:20:38.02,Default,,0,0,0,,Зак
Dialogue: 0,0:20:39.03,0:20:41.09,Default,,0,0,0,,Неліктен сіз оны үнемі бөлектейсіз?
Dialogue: 0,0:20:43.03,0:20:44.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:44.07,0:20:45.07,Default,,0,0,0,,Исла, іш.
Dialogue: 0,0:20:45.05,0:20:46.01,Default,,0,0,0,,Бөлек
Dialogue: 0,0:20:46.04,0:20:49.07,Default,,0,0,0,,Мен Цукасаның қамқор адам екенін бұрыннан білетінмін.
Dialogue: 0,0:20:55.07,0:20:57.09,Default,,0,0,0,,Әй, несіне күлесің?
Dialogue: 0,0:20:58.04,0:21:00.00,Default,,0,0,0,,Мичиру күлетін еді.
Dialogue: 0,0:21:00.02,0:21:01.02,Default,,0,0,0,,Мен күлмеймін.
Dialogue: 0,0:21:01.04,0:21:03.01,Default,,0,0,0,,Мен күлдім. Мен күлдім.
Dialogue: 0,0:21:03.04,0:21:04.09,Default,,0,0,0,,Закқа
Dialogue: 0,0:21:13.05,0:21:14.02,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:21:14.08,0:21:17.09,Default,,0,0,0,,Иә, мен тым қатты толқып кеттім деп ойлаймын.
Dialogue: 0,0:21:18.03,0:21:18.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:19.03,0:21:20.02,Default,,0,0,0,,Ақырында
Dialogue: 0,0:21:21.00,0:21:21.50,Default,,0,0,0,,Көңілді болды ма?
Dialogue: 0,0:21:24.05,0:21:26.09,Default,,0,0,0,,Мен, көп нәрсе болды.
Dialogue: 0,0:21:27.04,0:21:29.01,Default,,0,0,0,,Мен сонда жұмыс істегеніме қуаныштымын.
Dialogue: 0,0:21:29.08,0:21:30.02,Default,,0,0,0,,Иә
Dialogue: 0,0:21:31.00,0:21:33.02,Default,,0,0,0,,Барлығымен танысқаныма қуаныштымын.
Dialogue: 0,0:21:34.05,0:21:34.55,Default,,0,0,0,,Иә
Dialogue: 0,0:21:35.06,0:21:39.04,Default,,0,0,0,,Дәл қазір көңілді және қуанышты нәрселер өте көп.
Dialogue: 0,0:21:39.09,0:21:41.08,Default,,0,0,0,,Оның бәрін күнделігіме жазып та үлгермеймін.
Dialogue: 0,0:21:42.07,0:21:45.05,Default,,0,0,0,,Мұның бәрі Цукасаның арқасында.
Dialogue: 0,0:21:48.02,0:21:48.52,Default,,0,0,0,,Осымен
Dialogue: 0,0:21:49.07,0:21:50.05,Default,,0,0,0,,Сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:21:52.03,0:21:55.02,Default,,0,0,0,,Сен бүгін Сараға бірдеңе дедің ғой, солай ма?
Dialogue: 0,0:21:56.00,0:21:56.50,Default,,0,0,0,,Иә
Dialogue: 0,0:21:57.00,0:22:00.09,Default,,0,0,0,,Осы уақытқа дейін мен мұны әрқашан жинақтың соңында жасайтынмын, солай ма?
Dialogue: 0,0:22:01.06,0:22:04.00,Default,,0,0,0,,Маған біраз уақыт қызық болды.
Dialogue: 0,0:22:04.08,0:22:06.06,Default,,0,0,0,,Маған таң қалдым, сіз не айтып тұрсыз.
Dialogue: 0,0:22:09.04,0:22:13.06,Default,,0,0,0,,«Сүйікті адамымды бір күні тағы кездестіремін деп үміттенемін».
Dialogue: 0,0:22:45.01,0:22:48.04,Default,,0,0,0,,Ажырасқан сені іздедім.
Dialogue: 0,0:22:48.07,0:22:52.02,Default,,0,0,0,,Мені шақырған дауыс өшіп қалды
Dialogue: 0,0:22:52.04,0:22:59.08,Default,,0,0,0,,Мен ұстаған қол дірілдеп тұрды.
Dialogue: 0,0:23:00.03,0:23:03.08,Default,,0,0,0,,Біздің сезімдер
Dialogue: 0,0:23:04.00,0:23:09.00,Default,,0,0,0,,Қайтаруға болмайтын уақытты қабыл алыңыз
Dialogue: 0,0:23:09.02,0:23:13.07,Default,,0,0,0,,Мен биік ұшамын
Dialogue: 0,0:23:14.05,0:23:18.01,Default,,0,0,0,,Аспанда жарқыраған калейдоскоп
Dialogue: 0,0:23:18.03,0:23:22.01,Default,,0,0,0,,Сіз ыңғайсызданып күлдіңіз
Dialogue: 0,0:23:22.04,0:23:28.01,Default,,0,0,0,,Махаббатқа толы
Dialogue: 0,0:23:29.03,0:23:32.09,Default,,0,0,0,,Жарық ерігенге дейін
Dialogue: 0,0:23:33.00,0:23:36.00,Default,,0,0,0,,Мен шын жүректен үміттенемін
Dialogue: 0,0:23:36.02,0:23:48.02,Default,,0,0,0,,Осы сәтті ұмытпа
Dialogue: 0,0:23:49.52,0:23:54.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
