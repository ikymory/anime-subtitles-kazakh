Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.33,0:00:03.67,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:00:10.30,0:00:11.55,Default,,0,0,0,,Ахаха
Dialogue: 0,0:00:11.67,0:00:12.55,Default,,0,0,0,,О...
Dialogue: 0,0:00:14.43,0:00:15.09,Default,,0,0,0,,Ei
Dialogue: 0,0:00:15.47,0:00:16.18,Default,,0,0,0,,Эй (Ямаока) О
Dialogue: 0,0:00:17.18,0:00:19.14,Default,,0,0,0,,Тасу
Dialogue: 0,0:00:19.43,0:00:20.81,Default,,0,0,0,,Таки-кун, жасайық~
Dialogue: 0,0:00:20.93,0:00:21.93,Default,,0,0,0,,О
Dialogue: 0,0:00:22.06,0:00:23.27,Default,,0,0,0,,Керемет
Dialogue: 0,0:00:24.19,0:00:26.81,Default,,0,0,0,,Шабуылшылар ақыры жиналды.
Dialogue: 0,0:00:26.94,0:00:28.44,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:00:30.53,0:00:32.36,Default,,0,0,0,,Менің блогым
Dialogue: 0,0:00:32.74,0:00:35.41,Default,,0,0,0,,Тығыз ұштар жағдайға байланысты қабылданады
Dialogue: 0,0:00:35.53,0:00:36.99,Default,,0,0,0,,немесе блок
Dialogue: 0,0:00:37.12,0:00:39.87,Default,,0,0,0,,Екеуіне де жылдам жауап бере алуы керек
Dialogue: 0,0:00:39.99,0:00:42.33,Default,,0,0,0,,Бұл сіз үшін тамаша позиция, Таки.
Dialogue: 0,0:00:42.91,0:00:46.62,Default,,0,0,0,,Хехе, оның алдында мені көп мақтама.
Dialogue: 0,0:00:46.75,0:00:49.04,Default,,0,0,0,,Ол ақымақ және оңай алшақтап кетеді.
Dialogue: 0,0:00:49.17,0:00:51.30,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:00:52.67,0:00:53.34,Default,,0,0,0,,Эххе
Dialogue: 0,0:00:53.47,0:00:55.51,Default,,0,0,0,,Ахаха мен данышпанмын
Dialogue: 0,0:00:55.63,0:00:56.43,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:00:56.55,0:00:59.30,Default,,0,0,0,,Бұл позада мені ашуландыратын бір нәрсе бар.
Dialogue: 0,0:00:59.97,0:01:00.76,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:01.06,0:01:02.85,Default,,0,0,0,,Келесі сәрсенбі
Dialogue: 0,0:01:02.97,0:01:05.98,Default,,0,0,0,,Кикугаку хамелеондарымен жаттығу матчы шешілді.
Dialogue: 0,0:01:06.10,0:01:07.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:08.06,0:01:10.11,Default,,0,0,0,,Күзгі турнир 2-тур
Dialogue: 0,0:01:10.23,0:01:12.94,Default,,0,0,0,,Бұл Юхи Гуцқа қарсы матчқа арналған жаттығу матчы.
Dialogue: 0,0:01:13.07,0:01:15.20,Default,,0,0,0,,Сақтықты төмендетпеңіз.
Dialogue: 0,0:01:15.32,0:01:17.61,Default,,0,0,0,,А... анау Хабашира-сан?
Dialogue: 0,0:01:17.86,0:01:19.24,Default,,0,0,0,,Кекекеке... (Монта/Сена) Хие~
Dialogue: 0,0:01:19.45,0:01:22.58,Default,,0,0,0,,Ахаха, бұл менің дебюттік кездесуім.
Dialogue: 0,0:01:22.70,0:01:24.20,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:24.50,0:01:27.42,Default,,0,0,0,,Боқ сақал, сен нені түсінбедің?
Dialogue: 0,0:01:27.67,0:01:29.58,Default,,0,0,0,,Сіз кетуге мүмкіндік жоқ.
Dialogue: 0,0:01:29.71,0:01:30.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:30.50,0:01:33.25,Default,,0,0,0,,Ол әлі Деймонның студенті емес.
Dialogue: 0,0:01:33.38,0:01:34.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:34.38,0:01:37.97,Default,,0,0,0,,Сіз Деймон орта мектебіне әлі түскен жоқсыз ба?
Dialogue: 0,0:01:38.09,0:01:43.10,Default,,0,0,0,,♪~
Dialogue: 0,0:02:55.34,0:03:00.34,Default,,0,0,0,,~♪
Dialogue: 0,0:03:07.18,0:03:11.44,Default,,0,0,0,,Менің дебюттік матчымды қайта жіберіп алу мүмкін емес.
Dialogue: 0,0:03:11.94,0:03:13.35,Default,,0,0,0,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:03:13.48,0:03:15.98,Default,,0,0,0,,Мен әлі ауысу емтиханын тапсырған жоқпын.
Dialogue: 0,0:03:16.11,0:03:17.40,Default,,0,0,0,,Аа... (Сүзүне) Мм...
Dialogue: 0,0:03:17.53,0:03:22.11,Default,,0,0,0,,Уайымдама, қарғыс атсын, орта жылдық қабылдау емтиханы сейсенбіде.
Dialogue: 0,0:03:22.24,0:03:26.87,Default,,0,0,0,,Басқаша айтқанда, егер сіз емтиханды тапсырсаңыз, сәрсенбі күнгі қарақшыларды зерттеу турниріне қатыса аласыз.
Dialogue: 0,0:03:26.99,0:03:27.87,Default,,0,0,0,,Аа…
Dialogue: 0,0:03:27.99,0:03:30.87,Default,,0,0,0,,Ахаха, мен дебют жасадым
Dialogue: 0,0:03:31.46,0:03:34.71,Default,,0,0,0,,Тестілеуден өткеннен кейін бұл туралы маған айтыңыз.
Dialogue: 0,0:03:34.83,0:03:37.17,Default,,0,0,0,,Уайымдама, әпкем.
Dialogue: 0,0:03:37.30,0:03:40.88,Default,,0,0,0,,Өту көрсеткіші 150% Мен данышпанмын
Dialogue: 0,0:03:41.13,0:03:43.26,Default,,0,0,0,,Кусо Мане Кусо Деко Шио бастығы
Dialogue: 0,0:03:43.38,0:03:45.47,Default,,0,0,0,,Мына жігітті сынақтан өткізіңіз.
Dialogue: 0,0:03:45.60,0:03:48.85,Default,,0,0,0,,Не істесеңіз де, оны Коугакумен жаттығу матчына уақытында жеткізіңіз.
Dialogue: 0,0:03:48.97,0:03:49.72,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:03:49.89,0:03:52.81,Default,,0,0,0,,Төбе жын, мұны айтудың жолы бар, солай ма?
Dialogue: 0,0:03:52.94,0:03:56.02,Default,,0,0,0,,Жоқ, бәрі, уайымдама.
Dialogue: 0,0:03:56.15,0:03:59.53,Default,,0,0,0,,Менің құлап қалуым мүмкін емес, солай ма?
Dialogue: 0,0:04:06.74,0:04:10.83,Default,,0,0,0,,Бәрің, ағама қамқор болыңдар.
Dialogue: 0,0:04:11.33,0:04:13.50,Default,,0,0,0,,Не болды? Өзгертілді
Dialogue: 0,0:04:14.00,0:04:16.50,Default,,0,0,0,,Бауырым, сен сондай ақымақсың ғой, солай ма?
Dialogue: 0,0:04:16.63,0:04:19.75,Default,,0,0,0,,Көшіру емтиханын тапсыра аламын ба деп уайымдап отырмын.
Dialogue: 0,0:04:20.25,0:04:23.84,Default,,0,0,0,,Бірақ Таки-кун сенімділікке толы, сондықтан бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:04:24.26,0:04:25.80,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:04:25.93,0:04:29.81,Default,,0,0,0,,Сіздің сенімділігіңіздің негізі жоқ және ол бұрыннан бар.
Dialogue: 0,0:04:29.93,0:04:31.06,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:32.23,0:04:33.52,Default,,0,0,0,,Бастауыш сынып оқушысы кезімде
Dialogue: 0,0:04:33.98,0:04:36.48,Default,,0,0,0,,Спортпен айналыса алатын бала батыр, солай ма?
Dialogue: 0,0:04:42.69,0:04:44.40,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:04:45.11,0:04:46.99,Default,,0,0,0,,Бұл бәсекелестік рух⸺
Dialogue: 0,0:04:47.12,0:04:49.99,Default,,0,0,0,,Спортпен әуестеніп кеттім.
Dialogue: 0,0:04:50.16,0:04:52.41,Default,,0,0,0,,Таки керемет! Бұл ақымақ болса да
Dialogue: 0,0:04:52.54,0:04:54.96,Default,,0,0,0,,Керемет, ақымақ сияқты
Dialogue: 0,0:05:01.09,0:05:04.13,Default,,0,0,0,,Міне! Доп ойыны, сонымен қатар жекпе-жек өнері
Dialogue: 0,0:05:04.26,0:05:06.93,Default,,0,0,0,,Екеуін де істей алатын мен үшін мінсіз емес пе?
Dialogue: 0,0:05:07.89,0:05:12.02,Default,,0,0,0,,Менің әпкем, мен NFL-де американдық футбол ойнауды шештім.
Dialogue: 0,0:05:12.14,0:05:13.64,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:05:14.60,0:05:18.65,Default,,0,0,0,,Бірақ бастауышта да, орта мектепте де американдық футбол клубтары болған жоқ.
Dialogue: 0,0:05:18.77,0:05:20.27,Default,,0,0,0,,Ақырында орта мектепте⸺
Dialogue: 0,0:05:20.40,0:05:22.57,Default,,0,0,0,,Мен американдық футбол клубы бар жерде тест тапсырдым.
Dialogue: 0,0:05:22.69,0:05:24.69,Default,,0,0,0,,Бәрін орындама, өйткені сен ақымақсың
Dialogue: 0,0:05:24.82,0:05:26.36,Default,,0,0,0,,Мен Жапониядан кеттім⸺
Dialogue: 0,0:05:26.49,0:05:29.03,Default,,0,0,0,,Осылайша ол кенет Америкаға көшті.
Dialogue: 0,0:05:29.16,0:05:31.37,Default,,0,0,0,,Хмм... Мен соған алаңдап отырмын.
Dialogue: 0,0:05:31.99,0:05:33.66,Default,,0,0,0,,Ол сондай үлкен аға⸺
Dialogue: 0,0:05:34.08,0:05:36.58,Default,,0,0,0,,Америка футболына деген құмарлығыңызға шындап қарайсыз ба?
Dialogue: 0,0:05:36.91,0:05:38.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:40.67,0:05:44.51,Default,,0,0,0,,Сондықтан қандай жағдай болмасын Деймон орта мектебін тапсырғаныңды қалаймын.
Dialogue: 0,0:05:45.05,0:05:46.84,Default,,0,0,0,,Ху Сузунэ-чан
Dialogue: 0,0:05:47.13,0:05:49.47,Default,,0,0,0,,Жарайды, Сена, сен істедің.
Dialogue: 0,0:05:49.59,0:05:50.35,Default,,0,0,0,,Иә
Dialogue: 0,0:05:50.47,0:05:51.43,Default,,0,0,0,,Мен Учидамын.
Dialogue: 0,0:05:53.22,0:05:54.68,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,0:05:54.81,0:05:56.14,Default,,0,0,0,,Ахаха
Dialogue: 0,0:05:56.27,0:05:59.60,Default,,0,0,0,,Не болды, бәрі? Күрделі болып барады
Dialogue: 0,0:05:59.73,0:06:03.02,Default,,0,0,0,,Сіз сынақтан 0 алған сияқтысыз.
Dialogue: 0,0:06:04.03,0:06:06.99,Default,,0,0,0,,Бұл... ауырады, әпкем.
Dialogue: 0,0:06:10.32,0:06:11.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:12.33,0:06:14.87,Default,,0,0,0,,Өздеріңізді шыңдап, бар күшіңізді салыңыз.
Dialogue: 0,0:06:14.99,0:06:17.87,Default,,0,0,0,,Күте тұрыңыз... бұл сәл қатал емес пе? Ахах...
Dialogue: 0,0:06:18.33,0:06:22.34,Default,,0,0,0,,Біріншіден, математикаға келетін болсақ, сіздің қазіргі деңгейіңіз қандай, Таки?
Dialogue: 0,0:06:23.34,0:06:25.51,Default,,0,0,0,,Сіз бір мезгілдегі теңдеулер туралы білесіз бе?
Dialogue: 0,0:06:26.13,0:06:28.63,Default,,0,0,0,,Ахахах, оны маған қалдырыңыз.
Dialogue: 0,0:06:28.80,0:06:31.51,Default,,0,0,0,,6-қадамға дейін тегіс.
Dialogue: 0,0:06:32.39,0:06:33.39,Default,,0,0,0,,Алты қадам…
Dialogue: 0,0:06:33.51,0:06:34.60,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:06:34.72,0:06:36.85,Default,,0,0,0,,Көбейту кестесін айтасыз ба?
Dialogue: 0,0:06:37.23,0:06:40.48,Default,,0,0,0,,Иә көбейту кестесі көбейту кестесі 18
Dialogue: 0,0:06:41.23,0:06:42.65,Default,,0,0,0,,Көбейту кестесі 81!
Dialogue: 0,0:06:42.77,0:06:45.69,Default,,0,0,0,,Өте жаман. Оны төңкеріп қою дұрыс емес пе?
Dialogue: 0,0:06:46.40,0:06:49.53,Default,,0,0,0,,А... түсіндім. Бұл көбейтуден бе?
Dialogue: 0,0:06:49.65,0:06:51.41,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:06:51.53,0:06:54.49,Default,,0,0,0,,Сонымен... онда ағылшын алфавитінен...
Dialogue: 0,0:06:54.62,0:06:55.24,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:55.99,0:06:56.83,Default,,0,0,0,,F.
Dialogue: 0,0:06:56.95,0:06:58.37,Default,,0,0,0,,Ахахха... Бұл Дж.
Dialogue: 0,0:06:58.50,0:07:00.12,Default,,0,0,0,,Сіз немен айналысасыз?
Dialogue: 0,0:07:00.58,0:07:01.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:01.96,0:07:03.38,Default,,0,0,0,,Келесі кезекте роман...
Dialogue: 0,0:07:06.17,0:07:07.13,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:07:08.80,0:07:10.09,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:07:10.34,0:07:11.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:12.30,0:07:13.05,Default,,0,0,0,,Жалғастыру…
Dialogue: 0,0:07:16.43,0:07:17.47,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:07:19.10,0:07:20.10,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:07:20.73,0:07:21.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:22.44,0:07:24.69,Default,,0,0,0,,Ахаха, ұят болды.
Dialogue: 0,0:07:24.81,0:07:27.02,Default,,0,0,0,,Егжей-тегжейлерге алаңдамаңыз, тек жалғастырыңыз
Dialogue: 0,0:07:28.48,0:07:29.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:29.65,0:07:30.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:30.53,0:07:32.03,Default,,0,0,0,,Уайымдауды доғар!
Dialogue: 0,0:07:32.16,0:07:33.74,Default,,0,0,0,,Ах... (Таки) А?
Dialogue: 0,0:07:33.91,0:07:36.49,Default,,0,0,0,,Неге ашуланасың? менің әпкем
Dialogue: 0,0:07:39.62,0:07:42.33,Default,,0,0,0,,Барлығы... бәрі ағам үшін⸺
Dialogue: 0,0:07:42.46,0:07:44.46,Default,,0,0,0,,Тынымсыз еңбек етсем де
Dialogue: 0,0:07:44.75,0:07:48.05,Default,,0,0,0,,Маңызды ағайын істі байыппен қабылдамаса, не керегі бар?
Dialogue: 0,0:07:48.50,0:07:52.30,Default,,0,0,0,,Ахаха мен әрқашан байсалдымын
Dialogue: 0,0:07:52.43,0:07:55.80,Default,,0,0,0,,Ал сондай қытырлақ болса, теріңізге зиян.
Dialogue: 0,0:07:56.76,0:07:58.35,Default,,0,0,0,,Мен енді білмеймін
Dialogue: 0,0:07:59.31,0:08:01.64,Default,,0,0,0,,Ах... Сузуне
Dialogue: 0,0:08:03.23,0:08:04.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:06.15,0:08:08.57,Default,,0,0,0,,Аха ахах...
Dialogue: 0,0:08:09.90,0:08:12.32,Default,,0,0,0,,Юкимицу, келесі жолы барамыз ба?
Dialogue: 0,0:08:12.95,0:08:14.82,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:08:15.11,0:08:17.03,Default,,0,0,0,,Таки-кун, сен мұны қалай оқисың?
Dialogue: 0,0:08:18.53,0:08:19.87,Default,,0,0,0,,Ахаха
Dialogue: 0,0:08:19.99,0:08:23.50,Default,,0,0,0,,Бұл оңай, американдық футбол.
Dialogue: 0,0:08:23.71,0:08:24.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:24.58,0:08:25.29,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:08:25.71,0:08:28.63,Default,,0,0,0,,Иә! Кенеттен не болып жатыр?
Dialogue: 0,0:08:28.75,0:08:29.71,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:08:29.84,0:08:32.01,Default,,0,0,0,,Иә? Мүмкін?
Dialogue: 0,0:08:38.01,0:08:41.52,Default,,0,0,0,,Идиот... Сен шынымен ақымақсың.
Dialogue: 0,0:08:41.81,0:08:43.27,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:43.39,0:08:45.77,Default,,0,0,0,,Иә? Сенна
Dialogue: 0,0:08:46.98,0:08:48.52,Default,,0,0,0,,Тіпті Таки-кун⸺
Dialogue: 0,0:08:50.19,0:08:52.74,Default,,0,0,0,,Мен ешқандай зиян келтірген жоқпын.
Dialogue: 0,0:08:53.82,0:08:54.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:54.74,0:08:57.66,Default,,0,0,0,,Мен енді ол жігіт туралы ештеңе білмеймін...
Dialogue: 0,0:08:58.53,0:09:00.95,Default,,0,0,0,,Сена мен басқаларды да жалғыз қалдыруға болады.
Dialogue: 0,0:09:01.16,0:09:03.62,Default,,0,0,0,,Ахаха... Болды...
Dialogue: 0,0:09:03.91,0:09:06.46,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:09:07.54,0:09:08.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:19.89,0:09:23.10,Default,,0,0,0,,Бірақ Таки-кун, егер сіз сынақтан өтпесеңіз⸺
Dialogue: 0,0:09:23.22,0:09:24.81,Default,,0,0,0,,Жаттығу матчын былай қойғанда
Dialogue: 0,0:09:24.93,0:09:27.60,Default,,0,0,0,,Тіпті менің американдық футбол ойнау мүмкіндігім де жоғалды.
Dialogue: 0,0:09:29.06,0:09:32.69,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені мен тұқымды өзім отырғыздым.
Dialogue: 0,0:09:35.32,0:09:39.03,Default,,0,0,0,,Таки-кун, маған американдық футбол ұнайды...
Dialogue: 0,0:09:40.91,0:09:42.87,Default,,0,0,0,,Америкаға кете жаздадым.
Dialogue: 0,0:09:44.83,0:09:45.87,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:48.79,0:09:52.46,Default,,0,0,0,,Ажал шеруінен бірге аман өткен достармыз.
Dialogue: 0,0:09:52.59,0:09:55.05,Default,,0,0,0,,Мен Такидің өткенін қалаймын.
Dialogue: 0,0:09:55.72,0:09:57.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:00.01,0:10:02.51,Default,,0,0,0,,Онда мен қайтамын.
Dialogue: 0,0:10:07.85,0:10:10.40,Default,,0,0,0,,Керемет, Таки-кун, сенің қолыңнан келеді!
Dialogue: 0,0:10:10.61,0:10:11.94,Default,,0,0,0,,Міне, Такикун.
Dialogue: 0,0:10:12.06,0:10:13.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:14.36,0:10:17.86,Default,,0,0,0,,Ой, сіз қатарынан 3 сұраққа дұрыс жауап бердіңіз!
Dialogue: 0,0:10:18.03,0:10:19.24,Default,,0,0,0,,Олай болса, келесіге барайық.
Dialogue: 0,0:10:19.86,0:10:21.53,Default,,0,0,0,,Алты тию нүктесі және⸺
Dialogue: 0,0:10:21.66,0:10:24.33,Default,,0,0,0,,Бар болғаны 3 соққымен 40 ұпай жинасаңыз
Dialogue: 0,0:10:24.45,0:10:26.45,Default,,0,0,0,,Сіз 201 ұпай алдыңыз.
Dialogue: 0,0:10:26.58,0:10:28.50,Default,,0,0,0,,Қанша жанасу бар?
Dialogue: 0,0:10:28.62,0:10:29.96,Default,,0,0,0,,Ахаха
Dialogue: 0,0:10:30.08,0:10:31.29,Default,,0,0,0,,Бұл 27 рет болды⸺
Dialogue: 0,0:10:31.42,0:10:32.96,Default,,0,0,0,,Шешілген жоқ па?
Dialogue: 0,0:10:33.50,0:10:35.88,Default,,0,0,0,,Дұрыс... Дұрыс.
Dialogue: 0,0:10:36.34,0:10:37.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:37.97,0:10:40.68,Default,,0,0,0,,Сенна Мүмкін, мүмкін.
Dialogue: 0,0:10:40.80,0:10:41.55,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:41.68,0:10:44.26,Default,,0,0,0,,Егер бұл жігіттің американдық футболға қатысы бар болса⸺
Dialogue: 0,0:10:44.39,0:10:45.68,Default,,0,0,0,,Мен түсінген сияқтымын.
Dialogue: 0,0:10:45.81,0:10:46.43,Default,,0,0,0,,Я~
Dialogue: 0,0:10:46.56,0:10:49.48,Default,,0,0,0,,Ахаха, сондықтан айттым ғой, солай ма?
Dialogue: 0,0:10:49.60,0:10:52.90,Default,,0,0,0,,Мен данышпанмын, хаха...
Dialogue: 0,0:10:53.69,0:10:56.86,Default,,0,0,0,,(Маморидің күлкісі)
Dialogue: 0,0:10:56.98,0:10:58.44,Default,,0,0,0,,Осылай жалғастырайық
Dialogue: 0,0:10:58.57,0:10:59.53,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:59.65,0:11:02.99,Default,,0,0,0,,Жарайды, бүгін түні бойы тұруға бар күшімізді салайық, Макс!
Dialogue: 0,0:11:03.12,0:11:06.41,Default,,0,0,0,,(Сеннаның күлкісі)
Dialogue: 0,0:11:10.96,0:11:15.96,Default,,0,0,0,,Иә, орта кәсіптік қабылдау емтиханы: 5 пәннен 500 балл⸺
Dialogue: 0,0:11:16.09,0:11:19.13,Default,,0,0,0,,200 нүктені өтетін сызық деп ойлаңыз.
Dialogue: 0,0:11:19.34,0:11:21.30,Default,,0,0,0,,Мм... сен мені тыңдап тұрсың ба?
Dialogue: 0,0:11:21.84,0:11:25.47,Default,,0,0,0,,А... Ым, күте тұрыңыз, бізге 10 минут қалды.
Dialogue: 0,0:11:25.60,0:11:26.26,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:26.51,0:11:29.56,Default,,0,0,0,,Егер Курита-кунды орталыққа алсақ⸺
Dialogue: 0,0:11:29.68,0:11:31.48,Default,,0,0,0,,Курокидің орнының бұрышы неге тең?
Dialogue: 0,0:11:37.36,0:11:38.82,Default,,0,0,0,,Ахаха
Dialogue: 0,0:11:38.94,0:11:42.49,Default,,0,0,0,,Тест мінсіз өтті, өту көрсеткіші 150% құрады.
Dialogue: 0,0:11:42.66,0:11:44.95,Default,,0,0,0,,Мару x x…
Dialogue: 0,0:11:45.32,0:11:48.70,Default,,0,0,0,,Хмм, менің ойымша, бұл өте қиын, Таки-кун.
Dialogue: 0,0:11:48.83,0:11:51.75,Default,,0,0,0,,Мару Мару Батсу Мару
Dialogue: 0,0:11:51.87,0:11:53.29,Default,,0,0,0,,Жағдай жақсарып келеді.
Dialogue: 0,0:11:53.42,0:11:55.38,Default,,0,0,0,,наурыз наурыз наурыз
Dialogue: 0,0:11:55.50,0:11:59.55,Default,,0,0,0,,О, 203 ұпай, бұл пайдалы болды, Таки-кун.
Dialogue: 0,0:12:00.26,0:12:05.76,Default,,0,0,0,,Бірақ мен неге екенін білмеймін, бірақ мен құтқарылғандай сезінемін.
Dialogue: 0,0:12:05.89,0:12:07.81,Default,,0,0,0,,Өте иә...
Dialogue: 0,0:12:09.06,0:12:10.10,Default,,0,0,0,,О
Dialogue: 0,0:12:10.27,0:12:14.06,Default,,0,0,0,,Ақырында, мен жоғары сынып оқушысымын, мен данышпанмын
Dialogue: 0,0:12:14.19,0:12:18.36,Default,,0,0,0,,Ахаха барлығына, ынтымақтастық үшін рахмет.
Dialogue: 0,0:12:18.48,0:12:21.78,Default,,0,0,0,,Бұл жігіттің сыпайылығы мені мазақ етіп тұрғандай әсер қалдырады.
Dialogue: 0,0:12:23.15,0:12:25.49,Default,,0,0,0,,Сузунэ-чан, сен келген жоқсың.
Dialogue: 0,0:12:25.61,0:12:26.49,Default,,0,0,0,,Иә
Dialogue: 0,0:12:36.25,0:12:40.05,Default,,0,0,0,,Егер сіз оны «Көктемдегі ұрыларды зерттеу» фильмімен бірдей деп ойласаңыз, сіз қатты күйіп қаласыз.
Dialogue: 0,0:12:40.30,0:12:41.34,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:12:42.63,0:12:45.97,Default,,0,0,0,,Жазғы лагерьге бекер барғаным жоқ.
Dialogue: 0,0:12:46.09,0:12:50.89,Default,,0,0,0,,Мм... өткен күні ол маған Наганодан жіберілді⸺
Dialogue: 0,0:12:51.02,0:12:52.27,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:53.18,0:12:54.23,Default,,0,0,0,,Hii~ (баған) Каа~
Dialogue: 0,0:12:54.35,0:12:56.27,Default,,0,0,0,,Әдептілік қажет емес
Dialogue: 0,0:12:56.44,0:12:58.90,Default,,0,0,0,,Бүгін мен сені өлтіруге келдім.
Dialogue: 0,0:12:59.02,0:13:00.73,Default,,0,0,0,,Айза мен Игава мырзамен бәсекелесуден туған дыбыс—
Dialogue: 0,0:13:02.90,0:13:03.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:13.00,0:13:14.62,Default,,0,0,0,,В... петарда тепті ме?
Dialogue: 0,0:13:15.00,0:13:16.92,Default,,0,0,0,,Ке! Деймонның қылмысы⸺
Dialogue: 0,0:13:17.04,0:13:20.96,Default,,0,0,0,,Тек Eyeshield арқылы жүгіріп, 80-ші маймылға өтіңіз
Dialogue: 0,0:13:21.09,0:13:22.80,Default,,0,0,0,,80 санына 4 адам орналастырылған
Dialogue: 0,0:13:22.92,0:13:26.13,Default,,0,0,0,,Мен Eyeshield-ді толығымен жоямын.
Dialogue: 0,0:13:26.26,0:13:27.13,Default,,0,0,0,,О!
Dialogue: 0,0:13:28.09,0:13:29.26,Default,,0,0,0,,Қажылық үйде⸺
Dialogue: 0,0:13:29.39,0:13:31.68,Default,,0,0,0,,Мен тығыз ұшы қосылғанын білмедім.
Dialogue: 0,0:13:36.19,0:13:38.65,Default,,0,0,0,,Мен сіздің шабуылдарыңызды оқи аламын.
Dialogue: 0,0:13:38.85,0:13:39.86,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:42.32,0:13:42.94,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:13:47.32,0:13:49.49,Default,,0,0,0,,Ахаха жанасу
Dialogue: 0,0:13:49.62,0:13:51.70,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:13:51.99,0:13:53.70,Default,,0,0,0,,Не? (Таки) Ахахха
Dialogue: 0,0:13:53.83,0:13:55.00,Default,,0,0,0,,Таки-кун...
Dialogue: 0,0:13:59.08,0:14:02.42,Default,,0,0,0,,Таки-кун, маған американдық футбол ұнайды.
Dialogue: 0,0:14:04.51,0:14:07.59,Default,,0,0,0,,Хабашира мырза, Көз қалқаны да, маймыл да емес.
Dialogue: 0,0:14:08.51,0:14:10.55,Default,,0,0,0,,Қатты ұштар туралы не деуге болады?
Dialogue: 0,0:14:10.97,0:14:12.72,Default,,0,0,0,,Кімді белгілеуім керек?
Dialogue: 0,0:14:12.85,0:14:14.68,Default,,0,0,0,,Қабақ? Маймыл ма?
Dialogue: 0,0:14:14.81,0:14:16.60,Default,,0,0,0,,Әлде тығыз ұшы ма?
Dialogue: 0,0:14:17.56,0:14:18.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:19.23,0:14:20.98,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:14:25.32,0:14:26.90,Default,,0,0,0,,Көз қалқанының жүгіруі
Dialogue: 0,0:14:31.78,0:14:33.83,Default,,0,0,0,,...
Dialogue: 0,0:14:34.08,0:14:34.70,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:14:34.83,0:14:36.12,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:14:36.95,0:14:38.83,Default,,0,0,0,,Ғажайып Хабашира мырза
Dialogue: 0,0:14:38.96,0:14:42.04,Default,,0,0,0,,Менің күшім соңғы шайқасқа шыққаннан бері бірнеше сатыға өсті.
Dialogue: 0,0:14:43.00,0:14:43.96,Default,,0,0,0,,Жарайды, мен дереу барамын.
Dialogue: 0,0:14:44.84,0:14:47.34,Default,,0,0,0,,Доп жоқ. Сіз тар шеңбердесіз бе?
Dialogue: 0,0:14:48.72,0:14:52.30,Default,,0,0,0,,Ахаха жанасу
Dialogue: 0,0:14:54.97,0:14:55.93,Default,,0,0,0,,Иә
Dialogue: 0,0:14:57.27,0:15:00.23,Default,,0,0,0,,Таки Мұны істеме~ (Деймон мүшесі В) Жаса, солай ма?
Dialogue: 0,0:15:01.56,0:15:03.61,Default,,0,0,0,,Тұйық аяқталды ма?
Dialogue: 0,0:15:04.36,0:15:05.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:07.03,0:15:09.36,Default,,0,0,0,,Мен Такиден жеңіле алмаймын. Мен сені тоқтатамын, Сена.
Dialogue: 0,0:15:09.49,0:15:10.11,Default,,0,0,0,,Иә
Dialogue: 0,0:15:10.40,0:15:12.07,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:15:13.82,0:15:14.78,Default,,0,0,0,,Гррр…
Dialogue: 0,0:15:16.45,0:15:19.29,Default,,0,0,0,,Уау~
Dialogue: 0,0:15:19.41,0:15:21.25,Default,,0,0,0,,Уау~
Dialogue: 0,0:15:21.42,0:15:24.25,Default,,0,0,0,,Уау~
Dialogue: 0,0:15:25.13,0:15:27.05,Default,,0,0,0,,Салмағы~
Dialogue: 0,0:15:28.30,0:15:29.88,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:15:30.01,0:15:31.43,Default,,0,0,0,,Тасу
Dialogue: 0,0:15:31.63,0:15:33.18,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:34.43,0:15:37.01,Default,,0,0,0,,Жарайды, итермелей берейік!
Dialogue: 0,0:15:37.14,0:15:38.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:41.44,0:15:42.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:43.15,0:15:45.77,Default,,0,0,0,,Келесі жолы көзге арналған қалқанды қолданамын деп ойлаймын.
Dialogue: 0,0:15:46.02,0:15:49.11,Default,,0,0,0,,Жоқ, сен шіркін маймылсың... Ақыры, сақал-мұртсың.
Dialogue: 0,0:15:49.23,0:15:50.95,Default,,0,0,0,,Мен қайсысын таңдауым керек?
Dialogue: 0,0:15:51.07,0:15:53.86,Default,,0,0,0,,Жарайды, мақсаттарды үшке бөл.
Dialogue: 0,0:15:54.20,0:15:56.45,Default,,0,0,0,,Ми... үш? Бұл мүмкін емес
Dialogue: 0,0:15:56.78,0:15:57.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:58.45,0:16:02.54,Default,,0,0,0,,Хамелеонның стилі – қарсыласына сәйкес стратегиясын өзгерту.
Dialogue: 0,0:16:03.25,0:16:05.04,Default,,0,0,0,,Өлсем де, оны тоқтатпаймын
Dialogue: 0,0:16:05.17,0:16:06.46,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:11.55,0:16:12.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:13.18,0:16:15.14,Default,,0,0,0,,Менің блогым
Dialogue: 0,0:16:16.30,0:16:19.22,Default,,0,0,0,,Сузунэ-чан, ондай жерге тығылма⸺
Dialogue: 0,0:16:19.35,0:16:21.14,Default,,0,0,0,,Келіңіз және көріңіз
Dialogue: 0,0:16:21.48,0:16:22.73,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:16:22.85,0:16:26.02,Default,,0,0,0,,Жарайды... Мен ағама қызықпадым...
Dialogue: 0,0:16:26.15,0:16:27.44,Default,,0,0,0,,Ол соңғы кезде...
Dialogue: 0,0:16:27.61,0:16:30.82,Default,,0,0,0,,А, иә... Деймон жеңе ме деп ойлаймын...
Dialogue: 0,0:16:32.19,0:16:33.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:34.91,0:16:36.49,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:16:37.32,0:16:38.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:40.58,0:16:41.37,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:41.50,0:16:42.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:43.62,0:16:45.04,Default,,0,0,0,,Ахаха
Dialogue: 0,0:16:47.29,0:16:48.88,Default,,0,0,0,,Уау~
Dialogue: 0,0:16:56.01,0:16:56.89,Default,,0,0,0,,Ахаха
Dialogue: 0,0:16:57.01,0:16:57.89,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:16:58.01,0:16:59.22,Default,,0,0,0,,Сен
Dialogue: 0,0:16:59.51,0:17:02.18,Default,,0,0,0,,Иә... Иә! Бауырым, бұл керемет!
Dialogue: 0,0:17:02.39,0:17:05.77,Default,,0,0,0,,Иә, Таки-кун, бұл өте қызық сияқты.
Dialogue: 0,0:17:06.44,0:17:10.65,Default,,0,0,0,,Доп жинай білу және барлығының сеніміне ие болу
Dialogue: 0,0:17:10.82,0:17:12.61,Default,,0,0,0,,Мен ақымақпын, бірақ аға...
Dialogue: 0,0:17:12.74,0:17:14.24,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:17:14.45,0:17:15.40,Default,,0,0,0,,Уау~
Dialogue: 0,0:17:27.71,0:17:29.54,Default,,0,0,0,,Мен оны тоқтатамын~
Dialogue: 0,0:17:30.09,0:17:32.55,Default,,0,0,0,,Бар, ағайын!
Dialogue: 0,0:17:35.63,0:17:36.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:38.01,0:17:38.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.30,0:17:40.14,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:40.76,0:17:42.22,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:17:42.35,0:17:44.02,Default,,0,0,0,,Тасу
Dialogue: 0,0:17:44.22,0:17:46.73,Default,,0,0,0,,Иә, аға
Dialogue: 0,0:17:47.31,0:17:48.94,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:17:49.06,0:17:50.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:51.82,0:17:52.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:53.57,0:17:55.36,Default,,0,0,0,,Ахаха
Dialogue: 0,0:17:55.82,0:17:57.82,Default,,0,0,0,,Сәттілік, ағайын!
Dialogue: 0,0:17:58.20,0:17:59.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:59.24,0:18:02.08,Default,,0,0,0,,Әпкем, мен керемет жұмыс жасадым...
Dialogue: 0,0:18:02.66,0:18:03.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:05.37,0:18:06.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:06.29,0:18:08.75,Default,,0,0,0,,Қарамашы, тентек.
Dialogue: 0,0:18:09.46,0:18:11.13,Default,,0,0,0,,Аха аха
Dialogue: 0,0:18:13.13,0:18:16.09,Default,,0,0,0,,Сен қазір шынымен ақымақсың.
Dialogue: 0,0:18:17.34,0:18:18.72,Default,,0,0,0,,Сузуне...
Dialogue: 0,0:18:23.93,0:18:26.35,Default,,0,0,0,,Такидің орындауы керемет.
Dialogue: 0,0:18:26.77,0:18:28.94,Default,,0,0,0,,Осы уақытқа дейін тек екі шабуыл картасы болды.
Dialogue: 0,0:18:29.52,0:18:31.86,Default,,0,0,0,,Такидің қатысуымен 3 бөлікке айналды.
Dialogue: 0,0:18:31.98,0:18:35.90,Default,,0,0,0,,Шабуыл үлгілерінің көбеюімен жау абдырап қалады
Dialogue: 0,0:18:36.19,0:18:37.95,Default,,0,0,0,,Ахаха
Dialogue: 0,0:18:38.28,0:18:39.28,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:18:39.40,0:18:42.62,Default,,0,0,0,,Ойын Деймон жеңісімен аяқталады
Dialogue: 0,0:18:46.33,0:18:48.54,Default,,0,0,0,,Тығыз ұшын таптың ба?
Dialogue: 0,0:18:48.66,0:18:50.21,Default,,0,0,0,,Жаңа қару.
Dialogue: 0,0:18:50.33,0:18:52.84,Default,,0,0,0,,Иә! Жазды жақсы өткізген сияқтысыз
Dialogue: 0,0:18:53.29,0:18:54.96,Default,,0,0,0,,Темерамона
Dialogue: 0,0:18:55.30,0:19:00.59,Default,,0,0,0,,Егер олар бір-бірін жеңе берсе, ширек финалда Коугаку мен Деймонның кездесуі болады.
Dialogue: 0,0:19:00.72,0:19:03.55,Default,,0,0,0,,Сол кезде мен бүгінгі қарызымды толық өтеймін.
Dialogue: 0,0:19:04.22,0:19:05.10,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:19:11.90,0:19:13.44,Default,,0,0,0,,Ахаха
Dialogue: 0,0:19:13.81,0:19:16.36,Default,,0,0,0,,Өйткені, мен ұлы данышпанмын.
Dialogue: 0,0:19:16.94,0:19:17.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:18.24,0:19:19.11,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:19:19.61,0:19:20.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:21.03,0:19:22.20,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:19:23.78,0:19:25.03,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:28.04,0:19:29.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:29.96,0:19:32.25,Default,,0,0,0,,Рахмет саған Сена
Dialogue: 0,0:19:32.58,0:19:36.13,Default,,0,0,0,,Бауырым, сен ақымақ едің, бірақ салқын едің.
Dialogue: 0,0:19:36.25,0:19:38.46,Default,,0,0,0,,А... иә
Dialogue: 0,0:19:39.92,0:19:41.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:47.81,0:19:50.48,Default,,0,0,0,,Ібіліс жарғанақтары - ең жақсы!
Dialogue: 0,0:19:50.64,0:19:52.69,Default,,0,0,0,,Ахаха
Dialogue: 0,0:19:53.06,0:19:58.07,Default,,0,0,0,,♪~
Dialogue: 0,0:21:00.71,0:21:05.72,Default,,0,0,0,,~♪
Dialogue: 0,0:21:09.30,0:21:11.52,Default,,0,0,0,,Неге бұл жерде қаңғып жүрсің?
Dialogue: 0,0:21:11.68,0:21:15.10,Default,,0,0,0,,Мен Хилл мырзаның бұйрығымен матч өтетін орынды алдын ала қарауға келдім.
Dialogue: 0,0:21:15.23,0:21:16.60,Default,,0,0,0,,Сусуму Оджо⸺
Dialogue: 0,0:21:16.73,0:21:19.31,Default,,0,0,0,,Мен жұмыс істейтін ересектер командасымен жаттығудамын.
Dialogue: 0,0:21:19.44,0:21:22.65,Default,,0,0,0,,Біз де үнсіз қарап отыра алмаймыз.
Dialogue: 0,0:21:22.78,0:21:26.57,Default,,0,0,0,,Келесі жолы «Айсшилд 21» «Ghost Seal!?»
Dialogue: 0,0:21:26.70,0:21:27.91,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:29.41,0:21:35.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
