Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.17,0:00:08.09,Default,,0,0,0,,Синрюджи добы жоғары көтерілді
Dialogue: 0,0:00:08.17,0:00:10.46,Default,,0,0,0,,Бос бұрышқа!
Dialogue: 0,0:00:11.88,0:00:13.22,Default,,0,0,0,,Бұл жақсы соққы.
Dialogue: 0,0:00:13.30,0:00:14.13,Default,,0,0,0,,О
Dialogue: 0,0:00:14.22,0:00:17.51,Default,,0,0,0,,Мен оны қайтарғанда Айсшилд 21-ге жібермеймін.
Dialogue: 0,0:00:17.60,0:00:20.06,Default,,0,0,0,,Бұл сонымен қатар айналасында ешкім жоқ тамаша орын.
Dialogue: 0,0:00:23.02,0:00:26.35,Default,,0,0,0,,Бұл стандарт. Арыстан бұрыштарды кеспейді.
Dialogue: 0,0:00:26.44,0:00:27.27,Default,,0,0,0,,Не!?
Dialogue: 0,0:00:30.82,0:00:32.94,Default,,0,0,0,,Бұл қандай жылдамдық?
Dialogue: 0,0:00:36.99,0:00:38.32,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:00:38.41,0:00:41.83,Default,,0,0,0,,Қарсы жақтан үлкен жылдамдықпен жүгіру арқылы қуып алу
Dialogue: 0,0:00:41.91,0:00:45.62,Default,,0,0,0,,Аяқтары жеңіл адам күткендей, Айсшилд 21!
Dialogue: 0,0:00:45.71,0:00:48.50,Default,,0,0,0,,Нах... Ри... Рико-чан, тағы кездескенше.
Dialogue: 0,0:00:48.59,0:00:50.84,Default,,0,0,0,,Уау... Ахаха
Dialogue: 0,0:00:53.26,0:00:54.13,Default,,0,0,0,,Бухи!
Dialogue: 0,0:00:54.22,0:00:55.30,Default,,0,0,0,,Гаугау!
Dialogue: 0,0:00:55.38,0:00:58.14,Default,,0,0,0,,Жүр! Қабақ қалқаны 21!
Dialogue: 0,0:01:02.72,0:01:03.56,Default,,0,0,0,,Ах
Dialogue: 0,0:01:07.15,0:01:09.61,Default,,0,0,0,,Сәлем! Ол әлдеқашан оралған!
Dialogue: 0,0:01:09.69,0:01:10.52,Default,,0,0,0,,Міне!
Dialogue: 0,0:01:10.61,0:01:11.98,Default,,0,0,0,,Эй!
Dialogue: 0,0:01:12.07,0:01:13.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:13.69,0:01:14.94,Default,,0,0,0,,
Dialogue: 0,0:01:15.45,0:01:18.87,Default,,0,0,0,,Синрюджи храмы күткендей, темір қабырға блогы
Dialogue: 0,0:01:18.95,0:01:21.53,Default,,0,0,0,,Кенет дроссель болды!
Dialogue: 0,0:01:21.62,0:01:22.95,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:23.04,0:01:27.62,Default,,0,0,0,,♪~
Dialogue: 0,0:02:42.91,0:02:47.91,Default,,0,0,0,,~♪
Dialogue: 0,0:02:54.50,0:02:56.92,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:57.01,0:02:58.42,Default,,0,0,0,,Жарайсың Сена! а?
Dialogue: 0,0:02:59.26,0:03:00.59,Default,,0,0,0,,Қарсы жақтағы доп
Dialogue: 0,0:03:00.68,0:03:02.39,Default,,0,0,0,,Жақсы аулау (Монта) Ах!
Dialogue: 0,0:03:02.47,0:03:04.72,Default,,0,0,0,,Қарсылас Синрюджи храмы болса да
Dialogue: 0,0:03:04.80,0:03:06.89,Default,,0,0,0,,Жарайды, Маркс!
Dialogue: 0,0:03:06.97,0:03:07.81,Default,,0,0,0,,Иә
Dialogue: 0,0:03:07.89,0:03:08.85,Default,,0,0,0,,Нихихи (кіші түйін) хун
Dialogue: 0,0:03:11.44,0:03:14.81,Default,,0,0,0,,Ібіліс жарғанақтар Ібіліс жарғанаттар Ібіліс жарғанаттар...
Dialogue: 0,0:03:14.90,0:03:18.28,Default,,0,0,0,,Нага Нага Нага…
Dialogue: 0,0:03:19.03,0:03:19.99,Default,,0,0,0,,Орнату!
Dialogue: 0,0:03:20.07,0:03:24.32,Default,,0,0,0,,Хе... Жарайды, мен де соғып кетейін, Catch Mac...
Dialogue: 0,0:03:24.41,0:03:25.45,Default,,0,0,0,,Ах
Dialogue: 0,0:03:30.58,0:03:32.42,Default,,0,0,0,,Иккю Сенпай...
Dialogue: 0,0:03:32.96,0:03:37.63,Default,,0,0,0,,Маймыл-күн, бұл сіріңке сенің қарызыңды өтейді деп айттың.
Dialogue: 0,0:03:37.71,0:03:41.38,Default,,0,0,0,,Бірақ бұл өмір бойы қажет болса да мүмкін емес.
Dialogue: 0,0:03:42.01,0:03:44.26,Default,,0,0,0,,Бұл әлі шешілген жоқ.
Dialogue: 0,0:03:44.34,0:03:47.39,Default,,0,0,0,,Мен сені осы ойын біткенше жеңемін
Dialogue: 0,0:03:47.47,0:03:50.39,Default,,0,0,0,,Хонджо мырзаға берген антымды орындаймын.
Dialogue: 0,0:03:50.98,0:03:54.35,Default,,0,0,0,,Өту немесе жүгіру... Қалай шығасың?
Dialogue: 0,0:03:54.44,0:03:56.06,Default,,0,0,0,,Жүрек!
Dialogue: 0,0:03:59.40,0:04:01.57,Default,,0,0,0,,Жүгіру! Қарғыс атқыр маймыл!
Dialogue: 0,0:04:01.65,0:04:03.07,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:04:05.11,0:04:06.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:08.83,0:04:11.37,Default,,0,0,0,,Ұстау сізді ең күшті етеді!
Dialogue: 0,0:04:11.45,0:04:13.46,Default,,0,0,0,,Қолыңнан келсе, істе!
Dialogue: 0,0:04:13.54,0:04:15.17,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:04:15.25,0:04:19.17,Default,,0,0,0,,Артқа жүгіргенде магнит сияқты Монтаға жабысып қалды.
Dialogue: 0,0:04:20.00,0:04:22.92,Default,,0,0,0,,Артқа жүгіру 40 ярд 4 секунд 89
Dialogue: 0,0:04:23.01,0:04:26.18,Default,,0,0,0,,Бұл данышпан бұрышшы Иккю Хосокава
Dialogue: 0,0:04:26.93,0:04:31.64,Default,,0,0,0,,Кері жүгіру кезіндегі белгі қабылдағыштың кенет қозғалыстарына жауап беру болып табылады.
Dialogue: 0,0:04:31.72,0:04:34.14,Default,,0,0,0,,Бұл негізгі қорғаныс техникасы.
Dialogue: 0,0:04:34.85,0:04:37.19,Default,,0,0,0,,Сақтық көшірме жасау кезінде бұл жылдамдық мүмкін емес!
Dialogue: 0,0:04:37.73,0:04:40.94,Default,,0,0,0,,Жапонияда... Немесе әлемдегі ең жақсысы шығар!
Dialogue: 0,0:04:41.48,0:04:44.45,Default,,0,0,0,,Қарғыс атсын... Мен жеңілмеймін!
Dialogue: 0,0:04:45.36,0:04:49.03,Default,,0,0,0,,Өлім шеруінде біз 2000 шақырым жүгірдік.
Dialogue: 0,0:04:49.12,0:04:51.37,Default,,0,0,0,,Осы жерден кенеттен ортасына кесіңіз...
Dialogue: 0,0:04:51.45,0:04:52.87,Default,,0,0,0,,Хо
Dialogue: 0,0:04:59.34,0:05:00.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:01.80,0:05:04.72,Default,,0,0,0,,Сәлем! Мен оны сілкіп тастай алмаймын
Dialogue: 0,0:05:04.80,0:05:05.68,Default,,0,0,0,,Монта-кун!
Dialogue: 0,0:05:06.51,0:05:07.93,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:05:10.76,0:05:11.85,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:11.93,0:05:13.35,Default,,0,0,0,,Үздіксіз финт!
Dialogue: 0,0:05:13.43,0:05:14.64,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:14.73,0:05:18.02,Default,,0,0,0,,Бұл... Өткізу маршрутын шығару
Dialogue: 0,0:05:18.10,0:05:20.15,Default,,0,0,0,,Орталық алдамшы болды!
Dialogue: 0,0:05:21.23,0:05:24.11,Default,,0,0,0,,төбе жын сенпай! Жол белгілері!
Dialogue: 0,0:05:24.19,0:05:25.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:26.57,0:05:27.74,Default,,0,0,0,,Уф
Dialogue: 0,0:05:28.91,0:05:30.37,Default,,0,0,0,,Иә!? Ах!
Dialogue: 0,0:05:30.45,0:05:31.78,Default,,0,0,0,,Не, ақымақ!
Dialogue: 0,0:05:36.37,0:05:38.17,Default,,0,0,0,,Ешбір жол нысанасы бос емес!
Dialogue: 0,0:05:38.25,0:05:40.67,Default,,0,0,0,,Лақтыру мүмкін емес.
Dialogue: 0,0:05:40.75,0:05:42.09,Default,,0,0,0,,Ти!
Dialogue: 0,0:05:42.17,0:05:43.76,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:05:43.84,0:05:47.59,Default,,0,0,0,,Сол қалпымнан, мен білмей тұрып, сен менің алдымда едің!
Dialogue: 0,0:05:48.68,0:05:50.05,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:05:50.64,0:05:51.64,Default,,0,0,0,,Ha
Dialogue: 0,0:05:52.18,0:05:53.60,Default,,0,0,0,,Бұл сәйкестік те емес.
Dialogue: 0,0:05:53.68,0:05:57.06,Default,,0,0,0,,100 жыл өтсе де, сен мені жеңе алмайсың
Dialogue: 0,0:05:57.14,0:06:00.02,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:06:01.11,0:06:02.90,Default,,0,0,0,,төбе жын сенпай!
Dialogue: 0,0:06:04.57,0:06:06.53,Default,,0,0,0,,Моккай...
Dialogue: 0,0:06:06.61,0:06:09.45,Default,,0,0,0,,Маған ағымдағы маршрутпен жүруге рұқсат етіңіз!
Dialogue: 0,0:06:09.53,0:06:13.37,Default,,0,0,0,,Бұл жолы... бұл жолы, әрине, мен...
Dialogue: 0,0:06:13.45,0:06:14.91,Default,,0,0,0,,Бұл мүмкін емес (Монта) Иә?
Dialogue: 0,0:06:15.91,0:06:18.37,Default,,0,0,0,,Мен мұны бір ғана пьесада түсіндім.
Dialogue: 0,0:06:18.96,0:06:20.12,Default,,0,0,0,,Сенің күшіңмен ол Иккюді сілкіп тастау мүмкін емес.
Dialogue: 0,0:06:20.12,0:06:21.21,Default,,0,0,0,,Сіздің күшіңізбен ол Иккюді сілкіп тастау мүмкін емес.
Dialogue: 0,0:06:20.12,0:06:21.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:21.21,0:06:22.54,Default,,0,0,0,,Сіздің күшіңізбен ол Иккюді сілкіп тастау мүмкін емес.
Dialogue: 0,0:06:22.54,0:06:23.38,Default,,0,0,0,,Сенің күшіңмен әлгі Иккюді сілкіп тастау мүмкін емес.
Dialogue: 0,0:06:22.54,0:06:23.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:23.46,0:06:27.92,Default,,0,0,0,,Басыңызда өкініш сезілсе де, оны сіздің денеңіз сезінуі керек.
Dialogue: 0,0:06:28.01,0:06:29.34,Default,,0,0,0,,Маймыл
Dialogue: 0,0:06:30.59,0:06:31.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:32.35,0:06:35.31,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:06:36.81,0:06:38.18,Default,,0,0,0,,Монта…
Dialogue: 0,0:06:39.69,0:06:41.27,Default,,0,0,0,,Сол себепті... Ах
Dialogue: 0,0:06:42.40,0:06:44.02,Default,,0,0,0,,Келесі жолы мен де сенімен бірге барамын.
Dialogue: 0,0:06:44.11,0:06:45.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:45.78,0:06:47.49,Default,,0,0,0,,Өткізу жолы - бұл қиын!
Dialogue: 0,0:06:47.57,0:06:51.82,Default,,0,0,0,,Сақтығыңыз аз болған кезде 10 секундтан төмен түседі⸺
Dialogue: 0,0:06:51.91,0:06:53.45,Default,,0,0,0,,Бұл өте қысқа өту.
Dialogue: 0,0:06:53.53,0:06:57.95,Default,,0,0,0,,Бұрынғы сәтсіздік - бұл жай ғана дайындық.
Dialogue: 0,0:06:58.58,0:07:00.29,Default,,0,0,0,,Осы жолы мені ұстаңыз
Dialogue: 0,0:07:01.12,0:07:02.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:02.79,0:07:05.59,Default,,0,0,0,,Жүр, Деймон, екінші шабуыл!
Dialogue: 0,0:07:05.67,0:07:06.67,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:07:11.80,0:07:13.09,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:07:13.18,0:07:15.93,Default,,0,0,0,,Келесі өту жолы - бұл қиын!
Dialogue: 0,0:07:17.72,0:07:19.89,Default,,0,0,0,,Кенеттен өте қысқа өту!
Dialogue: 0,0:07:19.98,0:07:21.56,Default,,0,0,0,,Бұл өтеді!
Dialogue: 0,0:07:21.64,0:07:23.44,Default,,0,0,0,,Не...
Dialogue: 0,0:07:23.73,0:07:24.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:25.69,0:07:28.15,Default,,0,0,0,,Менің артымда ешкім жоқ
Dialogue: 0,0:07:28.23,0:07:31.28,Default,,0,0,0,,Мен оны сүңгіп жүріп ұстап алсам да, соншалықты қысқа қашықтықта төмен түспесем де
Dialogue: 0,0:07:31.36,0:07:35.03,Default,,0,0,0,,Неге оны ұстап алып жүгірмейсің? Сіз жасай аласыз!
Dialogue: 0,0:07:35.12,0:07:36.33,Default,,0,0,0,,Уф
Dialogue: 0,0:07:36.41,0:07:40.29,Default,,0,0,0,,Тоқтамаңыз! Секір! Қарғыс атқыр маймыл!
Dialogue: 0,0:07:40.83,0:07:41.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:45.21,0:07:46.63,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:07:47.67,0:07:48.67,Default,,0,0,0,,Уф
Dialogue: 0,0:07:50.13,0:07:52.01,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:07:52.09,0:07:53.63,Default,,0,0,0,,Ах
Dialogue: 0,0:07:55.05,0:07:55.97,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:56.55,0:07:57.89,Default,,0,0,0,,Я...
Dialogue: 0,0:07:57.97,0:08:00.52,Default,,0,0,0,,Мен... Мен... Кетемін!
Dialogue: 0,0:08:00.60,0:08:02.94,Default,,0,0,0,,Шинрюджи доп!
Dialogue: 0,0:08:04.73,0:08:05.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:06.44,0:08:08.86,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:08:08.94,0:08:11.03,Default,,0,0,0,,Ал... мен оны ұстадым.
Dialogue: 0,0:08:11.11,0:08:13.86,Default,,0,0,0,,Ана... Ол жігіт шынымен де керемет.
Dialogue: 0,0:08:13.95,0:08:14.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:14.91,0:08:17.83,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:08:21.87,0:08:25.63,Default,,0,0,0,,Деймондағы қақпа сызығына небәрі 21 ярд қалды!
Dialogue: 0,0:08:25.71,0:08:29.75,Default,,0,0,0,,Оң жақтағы шабуыл Синрюджиге тамаша позицияда барады!
Dialogue: 0,0:08:30.42,0:08:33.22,Default,,0,0,0,,Хэхе хахаха... Кешігіп қалдым.
Dialogue: 0,0:08:33.30,0:08:37.80,Default,,0,0,0,,Кекекеке... Міне, ең сорақы данышпан келеді.
Dialogue: 0,0:08:37.89,0:08:39.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:46.02,0:08:48.65,Default,,0,0,0,,Конго… Агон
Dialogue: 0,0:08:48.73,0:08:50.02,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:01.08,0:09:03.41,Default,,0,0,0,,Сіз түсінесіз деп ойлаймын.
Dialogue: 0,0:09:03.50,0:09:07.50,Default,,0,0,0,,Әйтеуір, біз сол қарғыс атқан қорқынышты жоймай бастай алмаймыз.
Dialogue: 0,0:09:07.58,0:09:08.54,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:09:08.63,0:09:09.46,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:09:12.80,0:09:16.93,Default,,0,0,0,,Қабақ қалқаны 21 Ханым!
Dialogue: 0,0:09:17.01,0:09:19.22,Default,,0,0,0,,Ал... Бірақ, сүлгі жын.
Dialogue: 0,0:09:19.30,0:09:21.39,Default,,0,0,0,,Өйткені, бұл Сена-кун мен Агон-кун⸺
Dialogue: 0,0:09:21.47,0:09:24.14,Default,,0,0,0,,Олардың дене бітімі әртүрлі болғандықтан қауіпті...
Dialogue: 0,0:09:25.39,0:09:28.23,Default,,0,0,0,,Бұл туралы әлі айтып жатырсың ба, Пигмен?
Dialogue: 0,0:09:28.31,0:09:31.82,Default,,0,0,0,,Оның жылдамдығына басқа ешкім ілесе алмайды!
Dialogue: 0,0:09:28.31,0:09:31.82,Default,,0,0,0,,Уф... тоқтат, сүлік жын.
Dialogue: 0,0:09:32.44,0:09:34.69,Default,,0,0,0,,Мен тіпті қуып жете алмаймын, сондықтан ештеңе істей алмаймын.
Dialogue: 0,0:09:32.44,0:09:34.69,Default,,0,0,0,,Увааааааааааааааааааааааа
Dialogue: 0,0:09:34.78,0:09:37.91,Default,,0,0,0,,Қуып жетіп, құрып кеткен дұрыс!
Dialogue: 0,0:09:34.78,0:09:37.91,Default,,0,0,0,,Жоқ... тоқтатыңыз...
Dialogue: 0,0:09:37.99,0:09:42.08,Default,,0,0,0,,Не... Сіз соншалықты шектен шыққан және қорқынышты нәрсе айтып тұрсыз ...
Dialogue: 0,0:09:42.79,0:09:45.00,Default,,0,0,0,,Дәл солай ғой, шіркін.
Dialogue: 0,0:09:45.58,0:09:47.00,Default,,0,0,0,,Кенет соқтығысты
Dialogue: 0,0:09:47.58,0:09:51.96,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа соқтығысқаннан гөрі!?
Dialogue: 0,0:09:52.04,0:09:55.88,Default,,0,0,0,,Енді шабуыл және қорғаныс, орнына Синрюджидің шабуылы.
Dialogue: 0,0:09:55.97,0:09:58.93,Default,,0,0,0,,Ғасырда бір келетін данышпан Конго Агон!
Dialogue: 0,0:09:59.01,0:10:02.93,Default,,0,0,0,,Бір жылдан кейін бірінші рет негізгі құрамның толық күшпен ойнағанын көре аламыз ба?
Dialogue: 0,0:10:03.01,0:10:06.56,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:10:06.64,0:10:07.85,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:10:07.94,0:10:11.90,Default,,0,0,0,,Бұл адамға не болып жатыр? Бұл өте қорқынышты ...
Dialogue: 0,0:10:15.44,0:10:17.65,Default,,0,0,0,,Сена жақсы (Сүзүне) иә?
Dialogue: 0,0:10:17.74,0:10:19.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:19.36,0:10:21.87,Default,,0,0,0,,Соққыға тап болғаныңызды адамдарға хабарлауға болмайды
Dialogue: 0,0:10:21.95,0:10:24.20,Default,,0,0,0,,Артқа жүгіріп келе жатқандай кейіп көрсету
Dialogue: 0,0:10:24.29,0:10:27.12,Default,,0,0,0,,Жоқ, ол қорқып тұрған шығар...
Dialogue: 0,0:10:27.96,0:10:29.83,Default,,0,0,0,,Сена жүр!
Dialogue: 0,0:10:29.92,0:10:32.04,Default,,0,0,0,,Мен оны сұрадым, Сена-кун.
Dialogue: 0,0:10:33.34,0:10:34.50,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:10:35.13,0:10:37.88,Default,,0,0,0,,Бірақ мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:10:38.59,0:10:43.30,Default,,0,0,0,,Соққы – қарсыласты бетпе-бет ұру және оның позициясын бұзу әдісі.
Dialogue: 0,0:10:43.39,0:10:46.43,Default,,0,0,0,,Бірақ менің қаруым менің күшім емес.
Dialogue: 0,0:10:46.52,0:10:47.48,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:10:52.23,0:10:53.11,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:10:53.73,0:10:56.07,Default,,0,0,0,,Агонның жүрегіне бірден...
Dialogue: 0,0:10:56.73,0:11:00.86,Default,,0,0,0,,Жақсы! Бұл менің тепе-теңдігімді жоғалтады ...
Dialogue: 0,0:11:04.49,0:11:06.83,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:07.50,0:11:08.62,Default,,0,0,0,,Ах
Dialogue: 0,0:11:14.29,0:11:15.67,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:11:15.75,0:11:17.25,Default,,0,0,0,,Ах
Dialogue: 0,0:11:19.22,0:11:23.14,Default,,0,0,0,,Агон-кунға сәтті пас берілді, ол қазір белгіленбеген!
Dialogue: 0,0:11:25.68,0:11:28.56,Default,,0,0,0,,Мен сізге бұлай мақсат сызығына жетуге мүмкіндік бере алмаймын!
Dialogue: 0,0:11:29.18,0:11:31.56,Default,,0,0,0,,Біреу, Агон, тоқтат!
Dialogue: 0,0:11:37.19,0:11:40.24,Default,,0,0,0,,Күткендей, қарғыс атқан шайтан, мен оны оқыдым.
Dialogue: 0,0:11:40.32,0:11:42.07,Default,,0,0,0,,Жарайсыңдар! Мен оны тоқтатамын!
Dialogue: 0,0:11:45.16,0:11:47.91,Default,,0,0,0,,Кемеңгерге қарсы жеке-жеке
Dialogue: 0,0:11:47.99,0:11:50.58,Default,,0,0,0,,Теме сияқты, жай тырнау
Dialogue: 0,0:11:50.66,0:11:52.54,Default,,0,0,0,,Ах… Ах… Ааах…
Dialogue: 0,0:12:07.30,0:12:08.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:08.93,0:12:11.18,Default,,0,0,0,,Сенна сияқты... пышақпен кесу
Dialogue: 0,0:12:11.81,0:12:12.98,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:14.52,0:12:18.15,Default,,0,0,0,,Кекекеке мен айтайын, қарғыс атқыр.
Dialogue: 0,0:12:18.94,0:12:22.45,Default,,0,0,0,,Неліктен бір кесіндінің 11 бөлігін үйректеу оңай?
Dialogue: 0,0:12:22.53,0:12:25.07,Default,,0,0,0,,Бір жағдайдағы бір адам
Dialogue: 0,0:12:25.16,0:12:28.16,Default,,0,0,0,,Өйткені сіз бір нәрсені қайталай бересіз
Dialogue: 0,0:12:28.83,0:12:29.99,Default,,0,0,0,,Сүлік жын жігіт
Dialogue: 0,0:12:30.08,0:12:33.62,Default,,0,0,0,,Қолды әдейі төмен қарай кесіп тастады, ақыры Агонның аяғына айналды!
Dialogue: 0,0:12:33.71,0:12:36.13,Default,,0,0,0,,Иә! Төбе жын!
Dialogue: 0,0:12:36.21,0:12:37.13,Default,,0,0,0,,Хи хи
Dialogue: 0,0:12:38.84,0:12:41.76,Default,,0,0,0,,Ааа... Иә!
Dialogue: 0,0:12:43.63,0:12:44.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:44.84,0:12:45.93,Default,,0,0,0,,Аххх (крест) Уф
Dialogue: 0,0:12:46.01,0:12:47.18,Default,,0,0,0,,А... а...
Dialogue: 0,0:12:52.98,0:12:56.81,Default,,0,0,0,,О? Бірдеңе айттың ба, Қас?
Dialogue: 0,0:12:56.90,0:12:58.11,Default,,0,0,0,,
Dialogue: 0,0:12:59.19,0:13:01.61,Default,,0,0,0,,Ta... Touchdown!
Dialogue: 0,0:13:01.69,0:13:02.19,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:02.19,0:13:05.61,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:02.19,0:13:05.61,Default,,0,0,0,,Керемет... Конго Агон Өте керемет!
Dialogue: 0,0:13:12.12,0:13:14.00,Default,,0,0,0,,Төбе жын!
Dialogue: 0,0:13:14.08,0:13:15.92,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:13:17.54,0:13:19.96,Default,,0,0,0,,Ке! Мен оны тек таспен кесіп тастадым.
Dialogue: 0,0:13:25.63,0:13:26.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:27.05,0:13:28.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:30.35,0:13:35.89,Default,,0,0,0,,Сол қылыш... Мұндай агрессивті жүгіруді бірінші рет көруім.
Dialogue: 0,0:13:48.99,0:13:51.53,Default,,0,0,0,,Не болды? Агон
Dialogue: 0,0:13:52.49,0:13:55.08,Default,,0,0,0,,О? Ештеңе етпейді.
Dialogue: 0,0:13:55.16,0:13:56.75,Default,,0,0,0,,Мен ойымды өзгерттім.
Dialogue: 0,0:13:56.83,0:13:57.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:57.92,0:14:01.09,Default,,0,0,0,,Мен оны сәл қысып жіберейін деп ойладым.
Dialogue: 0,0:14:02.71,0:14:05.51,Default,,0,0,0,,Мен сені жетілдіремін
Dialogue: 0,0:14:07.42,0:14:10.01,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:14:12.81,0:14:14.47,Default,,0,0,0,,Доймон Енді жүгірді!
Dialogue: 0,0:14:14.56,0:14:16.98,Default,,0,0,0,,Және үш ағайынды сыпырып!
Dialogue: 0,0:14:17.06,0:14:19.44,Default,,0,0,0,,Мен сені талқандаймын!
Dialogue: 0,0:14:19.52,0:14:21.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:21.98,0:14:23.11,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:14:23.19,0:14:25.36,Default,,0,0,0,,Қат! (Куроки) Мен түсінбеймін!
Dialogue: 0,0:14:28.49,0:14:30.20,Default,,0,0,0,,Бұл жылдам!
Dialogue: 0,0:14:30.28,0:14:33.99,Default,,0,0,0,,Осындай сәтте қабырғаны бұзып өту... Мен одан құтыла алмаймын.
Dialogue: 0,0:14:37.45,0:14:38.54,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:14:38.62,0:14:41.42,Default,,0,0,0,,Deimon Тағы бір шабуыл сәтсіз аяқталды!
Dialogue: 0,0:14:42.38,0:14:45.42,Default,,0,0,0,,Ууууууууууууууууууууууууууууу...
Dialogue: 0,0:14:45.50,0:14:47.46,Default,,0,0,0,,Бұл тек бастамасы ғана
Dialogue: 0,0:14:47.55,0:14:49.09,Default,,0,0,0,,Алғы сөз...
Dialogue: 0,0:14:49.17,0:14:52.64,Default,,0,0,0,,Нағыз сұмдық ондай емес.
Dialogue: 0,0:14:52.72,0:14:55.22,Default,,0,0,0,,Тым көп жасамаңыз.
Dialogue: 0,0:14:55.31,0:14:57.60,Default,,0,0,0,,Жеңісті тез шешеміз.
Dialogue: 0,0:14:58.81,0:15:00.02,Default,,0,0,0,,Хаха
Dialogue: 0,0:15:00.73,0:15:02.94,Default,,0,0,0,,Инелік.
Dialogue: 0,0:15:05.65,0:15:08.53,Default,,0,0,0,,Жоқ, әлі Инелік емес.
Dialogue: 0,0:15:08.61,0:15:10.61,Default,,0,0,0,,Козыр ойнауға әлі ерте.
Dialogue: 0,0:15:10.70,0:15:14.03,Default,,0,0,0,,А... қандай жылы сөз айттың?
Dialogue: 0,0:15:14.12,0:15:17.54,Default,,0,0,0,,Ең күшті картаны басынан бастап ойнаған дұрыс.
Dialogue: 0,0:15:17.62,0:15:19.04,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:19.12,0:15:22.63,Default,,0,0,0,,99% емес, 100% жеңіс
Dialogue: 0,0:15:22.71,0:15:26.92,Default,,0,0,0,,20 немесе одан да көп ұпай айырмашылығымен шатастырмай жеңіңіз.
Dialogue: 0,0:15:27.00,0:15:29.05,Default,,0,0,0,,Ойын осылай өтеді.
Dialogue: 0,0:15:30.01,0:15:31.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:32.55,0:15:35.22,Default,,0,0,0,,Сіз маған нұсқаулар бересіз бе?
Dialogue: 0,0:15:35.30,0:15:38.18,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:15:39.68,0:15:40.89,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:43.56,0:15:46.36,Default,,0,0,0,,Жарайды, Инелікпен барайық.
Dialogue: 0,0:15:46.94,0:15:49.03,Default,,0,0,0,,Агон қорғанысқа қосылып жатыр⸺
Dialogue: 0,0:15:49.11,0:15:52.20,Default,,0,0,0,,Бүгінгі Синрюджиден гол соғудың қиындығын ескере отырып
Dialogue: 0,0:15:52.28,0:15:55.57,Default,,0,0,0,,Деймон болса да, біз одан артық ұпай жібере алмаймыз!
Dialogue: 0,0:15:56.16,0:15:59.54,Default,,0,0,0,,Енді бұл шабуылды қалай болдырмауға болады?
Dialogue: 0,0:15:59.62,0:16:03.50,Default,,0,0,0,,Осы жерде тоқтап қалмаңыз! Мен тағы бір нүкте жасай алмаймын!
Dialogue: 0,0:16:03.58,0:16:04.58,Default,,0,0,0,,Тоқта, Фуго!
Dialogue: 0,0:16:04.67,0:16:05.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:08.55,0:16:11.42,Default,,0,0,0,,Не? Мистер Агоның ұстанымы...
Dialogue: 0,0:16:12.59,0:16:14.43,Default,,0,0,0,,Міне, инелік келеді!
Dialogue: 0,0:16:15.26,0:16:16.76,Default,,0,0,0,,Инелік ше?
Dialogue: 0,0:16:30.40,0:16:31.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:31.74,0:16:33.07,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:16:34.49,0:16:35.70,Default,,0,0,0,,Допты лақтырмас бұрын...
Dialogue: 0,0:16:35.78,0:16:38.24,Default,,0,0,0,,Квартербек Егер сіз оны басып алсаңыз!
Dialogue: 0,0:16:38.33,0:16:40.20,Default,,0,0,0,,Бұлтты су!
Dialogue: 0,0:16:40.29,0:16:42.04,Default,,0,0,0,,Барма! Бұл тұзақ!
Dialogue: 0,0:16:43.87,0:16:46.75,Default,,0,0,0,,Не!? (Куроки) Бұл Унсуи емес, Агон!?
Dialogue: 0,0:16:48.42,0:16:50.13,Default,,0,0,0,,Онда тез сөйлесейік!
Dialogue: 0,0:16:50.21,0:16:52.84,Default,,0,0,0,,Осы жиіркенішті регги басын сындырыңыз!
Dialogue: 0,0:16:52.92,0:16:55.01,Default,,0,0,0,,Қарғыс атқыр ақымақтар!
Dialogue: 0,0:16:55.09,0:16:57.30,Default,,0,0,0,,Сондықтан бұл қақпан!
Dialogue: 0,0:16:58.22,0:16:59.89,Default,,0,0,0,,Unsui белгісі жоқ!
Dialogue: 0,0:17:02.60,0:17:04.64,Default,,0,0,0,,Конго ағайындылары сәтті өтті!
Dialogue: 0,0:17:04.73,0:17:07.60,Default,,0,0,0,,Бұл жаман! Мен... мен сені жібермеймін!
Dialogue: 0,0:17:08.81,0:17:10.94,Default,,0,0,0,,Әйтеуір, Сена-кун мұны тоқтатты!
Dialogue: 0,0:17:08.81,0:17:10.94,Default,,0,0,0,,
Dialogue: 0,0:17:11.02,0:17:13.57,Default,,0,0,0,,Бірақ Унсуи-кун 8 ярд ұтады!
Dialogue: 0,0:17:13.65,0:17:15.53,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:17:16.28,0:17:18.32,Default,,0,0,0,,Агон, оны талқанда!
Dialogue: 0,0:17:18.41,0:17:19.53,Default,,0,0,0,,Гюго!
Dialogue: 0,0:17:19.62,0:17:21.49,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:17:22.62,0:17:23.45,Default,,0,0,0,,Бұлтты су!
Dialogue: 0,0:17:24.25,0:17:25.75,Default,,0,0,0,,Ах (шағын қорытынды) Уф
Dialogue: 0,0:17:26.67,0:17:28.17,Default,,0,0,0,,
Dialogue: 0,0:17:28.25,0:17:29.88,Default,,0,0,0,,Шинрюджи бірінші жерге түсті!
Dialogue: 0,0:17:29.96,0:17:33.71,Default,,0,0,0,,Агоннан Унсуиге Унсуиден Агонға
Dialogue: 0,0:17:33.80,0:17:35.80,Default,,0,0,0,,Егіздерге ғана тән супер комбинациялы ойын
Dialogue: 0,0:17:35.88,0:17:36.88,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:17:36.97,0:17:40.10,Default,,0,0,0,,Конгода ағайынды екі ойыншы ойыншы⸺
Dialogue: 0,0:17:40.18,0:17:42.85,Default,,0,0,0,,Ең күшті формация Инелік!
Dialogue: 0,0:17:43.72,0:17:46.10,Default,,0,0,0,,Тіпті кім лақтыратынын білмесем де
Dialogue: 0,0:17:46.19,0:17:47.81,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:17:47.90,0:17:50.90,Default,,0,0,0,,Бұл Инелік...
Dialogue: 0,0:17:51.44,0:17:52.78,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:17:52.86,0:17:55.90,Default,,0,0,0,,Ал... тоқтауым керек... өтуді тоқтатамын.
Dialogue: 0,0:17:55.99,0:17:58.24,Default,,0,0,0,,Агон мен Унсуиді кім тоқтатуы керек?
Dialogue: 0,0:17:58.32,0:17:59.74,Default,,0,0,0,,Сіз білесіз бе! Екеуі де!
Dialogue: 0,0:18:00.37,0:18:02.74,Default,,0,0,0,,Унсуи-кун, мен өзім әкелдім!
Dialogue: 0,0:18:02.83,0:18:05.70,Default,,0,0,0,,Осындай шабуыл үлгілері бар ма?
Dialogue: 0,0:18:07.75,0:18:09.25,Default,,0,0,0,,Сол кезде мен—
Dialogue: 0,0:18:09.33,0:18:10.75,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,0:18:10.83,0:18:12.25,Default,,0,0,0,,Демон-кун Хилл оқып жатыр!
Dialogue: 0,0:18:12.88,0:18:13.71,Default,,0,0,0,,Әй
Dialogue: 0,0:18:14.34,0:18:15.17,Default,,0,0,0,,Артқа өту!
Dialogue: 0,0:18:16.30,0:18:18.13,Default,,0,0,0,,Бұл жолы Аго-кун!
Dialogue: 0,0:18:18.22,0:18:21.64,Default,,0,0,0,,Қарғыс атқыр балалар, орталық серпінді тоқтатыңыз!
Dialogue: 0,0:18:25.14,0:18:26.77,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:29.27,0:18:31.73,Default,,0,0,0,,Жаңа ғана артқа өткен Унсуи мырза...
Dialogue: 0,0:18:34.27,0:18:35.69,Default,,0,0,0,,
Dialogue: 0,0:18:35.78,0:18:37.65,Default,,0,0,0,,Ta... Touchdown!
Dialogue: 0,0:18:37.74,0:18:41.66,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:42.41,0:18:44.12,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:18:44.20,0:18:46.16,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:46.66,0:18:50.54,Default,,0,0,0,,Иккюдің кері жүгіруі және Агонның өте агрессивті ойыны
Dialogue: 0,0:18:51.63,0:18:54.00,Default,,0,0,0,,Тіпті Инелік...
Dialogue: 0,0:18:56.84,0:18:58.47,Default,,0,0,0,,Артықшылықты пайдалану мүмкіндігі жоқ
Dialogue: 0,0:19:00.59,0:19:04.43,Default,,0,0,0,,Тым күшті Синрюджи Нага...
Dialogue: 0,0:19:05.51,0:19:10.52,Default,,0,0,0,,♪~
Dialogue: 0,0:20:15.46,0:20:20.46,Default,,0,0,0,,~♪
Dialogue: 0,0:20:21.88,0:20:24.18,Default,,0,0,0,,Мықты бол, Шинрюджи Нага
Dialogue: 0,0:20:24.26,0:20:26.60,Default,,0,0,0,,Бұл Құдайдың жеңілмейтін күші ме?
Dialogue: 0,0:20:26.68,0:20:28.89,Default,,0,0,0,,Нүкте айырымы кеңейіп барады.
Dialogue: 0,0:20:28.97,0:20:30.56,Default,,0,0,0,,Барлығына сәттілік!
Dialogue: 0,0:20:30.64,0:20:31.98,Default,,0,0,0,,Берілмеңіз!
Dialogue: 0,0:20:32.06,0:20:34.85,Default,,0,0,0,,Ол әлі де балшық қақпасында!
Dialogue: 0,0:20:34.94,0:20:37.02,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:20:37.11,0:20:39.23,Default,,0,0,0,,«12-ші спортшы»
Dialogue: 0,0:20:39.32,0:20:40.44,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:20:41.94,0:20:47.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
