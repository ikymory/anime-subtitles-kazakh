Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.21,0:00:05.71,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:00:08.25,0:00:11.97,Default,,0,0,0,,Ой, Кайтани-кун, жетіп ал!
Dialogue: 0,0:00:12.05,0:00:13.93,Default,,0,0,0,,Мен оны тоқтатамын! Уф!
Dialogue: 0,0:00:14.01,0:00:17.89,Default,,0,0,0,,Вольффанг!
Dialogue: 0,0:00:23.44,0:00:24.89,Default,,0,0,0,,
Dialogue: 0,0:00:24.98,0:00:27.77,Default,,0,0,0,,Қасқыр мүйісі, Дайга Оотани
Dialogue: 0,0:00:27.86,0:00:29.61,Default,,0,0,0,,Тағы бір тию!
Dialogue: 0,0:00:29.69,0:00:30.94,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:31.03,0:00:35.61,Default,,0,0,0,,♪~
Dialogue: 0,0:01:50.94,0:01:55.94,Default,,0,0,0,,~♪
Dialogue: 0,0:02:02.08,0:02:06.20,Default,,0,0,0,,Қасқыр мүйістері VS (Қарсы) Батыс жабайы қаруластары
Dialogue: 0,0:02:06.29,0:02:09.00,Default,,0,0,0,,Ойынның басында Эйс артқа жүгірді
Dialogue: 0,0:02:09.08,0:02:12.13,Default,,0,0,0,,Дайга Оотанидің Вольффанг жарылып кетті!
Dialogue: 0,0:02:12.21,0:02:16.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:17.01,0:02:20.13,Default,,0,0,0,,Иә? Ахахха
Dialogue: 0,0:02:20.89,0:02:22.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:22.43,0:02:25.64,Default,,0,0,0,,Оотани жүгіру тәсілі оның ұзақ қадамдарын пайдаланады.
Dialogue: 0,0:02:25.72,0:02:27.60,Default,,0,0,0,,Төмен позициядан суға түсу
Dialogue: 0,0:02:27.68,0:02:32.06,Default,,0,0,0,,Вольффанг шынымен де қорғаныста да, шабуылда да қолдануға болатын жан-жақты қимыл.
Dialogue: 0,0:02:32.15,0:02:33.31,Default,,0,0,0,,Рико-чан?
Dialogue: 0,0:02:33.40,0:02:35.57,Default,,0,0,0,,Ах! Ахх!
Dialogue: 0,0:02:35.65,0:02:38.40,Default,,0,0,0,,Қалай болғанда да, Вольффанг ең күшті.
Dialogue: 0,0:02:38.49,0:02:40.41,Default,,0,0,0,,Рико-чан, сенің қабағың қайтқан жоқ.
Dialogue: 0,0:02:40.49,0:02:41.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:41.41,0:02:44.99,Default,,0,0,0,,Осындай төмен позициямен жылдамдықта...
Dialogue: 0,0:02:45.08,0:02:46.33,Default,,0,0,0,,Сусуму Сіз қалай ойлайсыз?
Dialogue: 0,0:02:47.04,0:02:50.16,Default,,0,0,0,,Оны жаншуға барсаң да, жеңілетін шығарсың.
Dialogue: 0,0:02:50.25,0:02:54.75,Default,,0,0,0,,Мақсатыңызды алғаннан кейін, ойланбастан жүгіріңіз.
Dialogue: 0,0:02:54.84,0:02:57.05,Default,,0,0,0,,Ұстау оңай емес
Dialogue: 0,0:02:57.88,0:02:59.30,Default,,0,0,0,,Бірақ одан да көп...
Dialogue: 0,0:02:59.38,0:03:00.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:01.13,0:03:04.97,Default,,0,0,0,,Рику Кайтани қазір өзін жоғалтып жатыр.
Dialogue: 0,0:03:07.60,0:03:09.93,Default,,0,0,0,,Қасқыр алқабындағы бейбақ...
Dialogue: 0,0:03:10.02,0:03:13.40,Default,,0,0,0,,Рику, салқынырақ болайық.
Dialogue: 0,0:03:14.36,0:03:17.03,Default,,0,0,0,,Жарайды, енді ғана бастадық.
Dialogue: 0,0:03:17.11,0:03:18.82,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:18.90,0:03:21.86,Default,,0,0,0,,Кид-сан мен Тецума-санның жеңіліп қалуы мүмкін емес.
Dialogue: 0,0:03:21.95,0:03:23.32,Default,,0,0,0,,Кекекеке (4 адам) А?
Dialogue: 0,0:03:23.95,0:03:25.28,Default,,0,0,0,,Мистер Хилл Демон
Dialogue: 0,0:03:25.37,0:03:27.20,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:03:27.29,0:03:30.21,Default,,0,0,0,,Эй, сен нені айтып тұрсың? аға
Dialogue: 0,0:03:30.87,0:03:33.67,Default,,0,0,0,,Өйткені шайқаста ағын бар.
Dialogue: 0,0:03:33.75,0:03:35.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:35.46,0:03:37.84,Default,,0,0,0,,Келесі пьеса кілт болып табылады
Dialogue: 0,0:03:37.92,0:03:40.88,Default,,0,0,0,,Батыс бұл шабуылмен ұпай жинай ала ма?
Dialogue: 0,0:03:40.97,0:03:44.34,Default,,0,0,0,,Егер бұл мүмкін болмаса, ағын кенеттен мүйіске қарай еңкейеді.
Dialogue: 0,0:03:44.43,0:03:45.85,Default,,0,0,0,,Сол кезде мен—
Dialogue: 0,0:03:45.93,0:03:50.02,Default,,0,0,0,,Батыстың жылап тұрған жағын көретін шығармыз.
Dialogue: 0,0:03:50.10,0:03:52.44,Default,,0,0,0,,Ух... (Сүзүнэ) Ах... Ю-нии күткендей.
Dialogue: 0,0:03:52.52,0:03:53.90,Default,,0,0,0,,Гүлденген зұлымдық
Dialogue: 0,0:03:53.98,0:03:56.02,Default,,0,0,0,,Толығымен көңілді
Dialogue: 0,0:03:56.11,0:03:59.98,Default,,0,0,0,,Бірақ... Рику ұтыла алмайды.
Dialogue: 0,0:04:00.07,0:04:01.95,Default,,0,0,0,,Орнату!
Dialogue: 0,0:04:02.03,0:04:04.78,Default,,0,0,0,,Енді Батыс бірінші тармақтан айырылды.
Dialogue: 0,0:04:04.86,0:04:06.91,Default,,0,0,0,,Қалай шабуыл жасау керек
Dialogue: 0,0:04:08.03,0:04:09.08,Default,,0,0,0,,Шабуыл күші үшін
Dialogue: 0,0:04:09.16,0:04:11.91,Default,,0,0,0,,Батыс аймағын Канто турнирінде бірінші орында деп айтуға болады.
Dialogue: 0,0:04:12.00,0:04:12.87,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:04:12.96,0:04:15.71,Default,,0,0,0,,Олар шолақ мылтықпен шабуыл жасайды.
Dialogue: 0,0:04:16.79,0:04:18.96,Default,,0,0,0,,Бұл қорқынышты емес.
Dialogue: 0,0:04:19.05,0:04:20.34,Default,,0,0,0,,Мен оны тоқтатамын.
Dialogue: 0,0:04:21.26,0:04:25.13,Default,,0,0,0,,Мен жеңілмеймін. Менің ол бейбақтан жеңілетінім жоқ.
Dialogue: 0,0:04:25.22,0:04:29.14,Default,,0,0,0,,Қатты жүр! Жабайы бұқа жабайы жүгіреді!
Dialogue: 0,0:04:29.22,0:04:30.60,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:04:30.68,0:04:33.56,Default,,0,0,0,,Кеттік, қос мүйіз!
Dialogue: 0,0:04:33.64,0:04:37.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:37.81,0:04:39.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:39.27,0:04:42.69,Default,,0,0,0,,Ушидзима-кун Мисаки қасқырларының сызығын жойды!
Dialogue: 0,0:04:42.78,0:04:45.66,Default,,0,0,0,,Керемет, Ушидзима!
Dialogue: 0,0:04:45.74,0:04:48.66,Default,,0,0,0,,Сіз шығасыз ба? Балаларға арналған жылдам атылатын мылтық
Dialogue: 0,0:04:49.33,0:04:51.41,Default,,0,0,0,,Жылдам және өрт!
Dialogue: 0,0:04:51.49,0:04:52.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:53.91,0:04:55.25,Default,,0,0,0,,Мистер Кидд
Dialogue: 0,0:04:56.46,0:04:57.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:59.21,0:05:01.34,Default,,0,0,0,,Баланы сындырыңыз!
Dialogue: 0,0:05:01.42,0:05:02.80,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:02.88,0:05:03.76,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:03.84,0:05:06.80,Default,,0,0,0,,Кид-кун, Хата-кунға жебедей өт!
Dialogue: 0,0:05:06.88,0:05:08.18,Default,,0,0,0,,Гуха!
Dialogue: 0,0:05:08.26,0:05:10.76,Default,,0,0,0,,Бірақ Хата-кун жаншып кетті.
Dialogue: 0,0:05:12.22,0:05:14.23,Default,,0,0,0,,Допты маған бергенше
Dialogue: 0,0:05:14.31,0:05:16.56,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:05:16.64,0:05:19.23,Default,,0,0,0,,Неліктен Рикуликуды пайдаланбадың?
Dialogue: 0,0:05:19.31,0:05:23.90,Default,,0,0,0,,Оотани мырза дәл Рикудың белгісінде.
Dialogue: 0,0:05:23.99,0:05:29.37,Default,,0,0,0,,Бұл матчта Мисаки Рику-кунды мұқият белгілейді.
Dialogue: 0,0:05:29.45,0:05:32.58,Default,,0,0,0,,Читчичи~ Бірақ батыста тағы бір адам бар
Dialogue: 0,0:05:32.66,0:05:36.79,Default,,0,0,0,,Ace of Ace, Iron Horse келді!
Dialogue: 0,0:05:36.87,0:05:40.17,Default,,0,0,0,,Тецуума-кунның көңіл-күйі жақсы емес сияқты.
Dialogue: 0,0:05:40.25,0:05:41.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:41.92,0:05:45.26,Default,,0,0,0,,Мен сенің суық тиіп, дене қызуың 40 градусқа жуық көтерілгенін естідім.
Dialogue: 0,0:05:45.34,0:05:48.84,Default,,0,0,0,,Иә, әлгі темір тұлпар суық тиген бе?
Dialogue: 0,0:05:48.93,0:05:50.05,Default,,0,0,0,,Оған бар күшімді салуым керек.
Dialogue: 0,0:05:50.14,0:05:54.18,Default,,0,0,0,,Мүлдем... Темір тұлпардың кешегі ақымақ адалдығын ұмыт.
Dialogue: 0,0:05:54.27,0:05:56.02,Default,,0,0,0,,Мен бұлай айтпауым керек еді.
Dialogue: 0,0:05:56.10,0:05:59.52,Default,,0,0,0,,Мен жас кезімде маңызды шайқас алдында,
Dialogue: 0,0:05:59.60,0:06:04.19,Default,,0,0,0,,Мен сіріңкеге барар алдында шомылып, жан-тәнімді тазарттым.
Dialogue: 0,0:06:04.28,0:06:07.95,Default,,0,0,0,,Балалар, сендер де бар күштеріңмен барыңдар!
Dialogue: 0,0:06:08.03,0:06:10.03,Default,,0,0,0,,Сонымен темір тұлпар жігіт
Dialogue: 0,0:06:10.11,0:06:13.12,Default,,0,0,0,,Су моншасында 12 сағат болды.
Dialogue: 0,0:06:13.20,0:06:14.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:14.74,0:06:16.20,Default,,0,0,0,,
Dialogue: 0,0:06:17.50,0:06:21.13,Default,,0,0,0,,Әлгі жігіт баптауды білмейді.
Dialogue: 0,0:06:23.00,0:06:25.25,Default,,0,0,0,,Амансың ба, Тецуума?
Dialogue: 0,0:06:25.34,0:06:28.59,Default,,0,0,0,,Дай… Джо… Күйеуі…
Dialogue: 0,0:06:28.67,0:06:30.18,Default,,0,0,0,,Оған бар күшімді салуым керек.
Dialogue: 0,0:06:30.26,0:06:31.30,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:06:31.39,0:06:32.72,Default,,0,0,0,,Мистер Кидд?
Dialogue: 0,0:06:33.55,0:06:35.85,Default,,0,0,0,,Мен Тецуума-санға үміткер боламын.
Dialogue: 0,0:06:35.93,0:06:37.73,Default,,0,0,0,,Осы жолы маған допты беріңізші.
Dialogue: 0,0:06:38.27,0:06:39.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:41.02,0:06:43.02,Default,,0,0,0,,Мен ондай жігіттен жеңіле алмаймын.
Dialogue: 0,0:06:43.65,0:06:47.74,Default,,0,0,0,,Га, Тецуума суық тиіп, Рику Қасқыр алқабында.
Dialogue: 0,0:06:47.82,0:06:49.99,Default,,0,0,0,,Екеуіңіз де қызып кеттіңіздер ме?
Dialogue: 0,0:06:50.07,0:06:51.95,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:06:52.57,0:06:56.33,Default,,0,0,0,,
Dialogue: 0,0:06:56.41,0:07:00.29,Default,,0,0,0,,Батыс 1 аула сол жақта, бірінші төмен емес.
Dialogue: 0,0:07:00.37,0:07:03.75,Default,,0,0,0,,Қасқыр мүйістеріне шабуылдау құқықтарын беру
Dialogue: 0,0:07:03.84,0:07:05.59,Default,,0,0,0,,Хехе...
Dialogue: 0,0:07:05.67,0:07:08.26,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын.
Dialogue: 0,0:07:08.34,0:07:10.55,Default,,0,0,0,,Бұл жігіттің сені мазақ етуіне жол берме
Dialogue: 0,0:07:10.63,0:07:13.59,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін, Батыс.
Dialogue: 0,0:07:13.68,0:07:15.51,Default,,0,0,0,,Әлі емес... әлі жоқ.
Dialogue: 0,0:07:16.93,0:07:19.06,Default,,0,0,0,,Егер Рику Rodeo Drive-ты шығарса
Dialogue: 0,0:07:19.14,0:07:21.52,Default,,0,0,0,,Менің жеңілетінім жоқ
Dialogue: 0,0:07:25.11,0:07:27.02,Default,,0,0,0,,Ммм
Dialogue: 0,0:07:29.57,0:07:30.86,Default,,0,0,0,,Ммм
Dialogue: 0,0:07:30.95,0:07:33.99,Default,,0,0,0,,Шабуыл жасауды тоқтатыңыз! Батыстың жабайы сиырлары!
Dialogue: 0,0:07:34.07,0:07:35.49,Default,,0,0,0,,Орнату!
Dialogue: 0,0:07:35.58,0:07:39.95,Default,,0,0,0,,Жүрген өгіз болса, менің кезегім. Бұл Буффало Ушидзима.
Dialogue: 0,0:07:40.04,0:07:43.92,Default,,0,0,0,,Қарғыс атсын, мен оны осы жолы тоқтатамын.
Dialogue: 0,0:07:44.75,0:07:46.88,Default,,0,0,0,,Нихихи…
Dialogue: 0,0:07:46.96,0:07:48.88,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:48.96,0:07:49.84,Default,,0,0,0,,Шляпа!
Dialogue: 0,0:07:52.38,0:07:54.80,Default,,0,0,0,,Сіздің жүгіруіңіз аяқталды!
Dialogue: 0,0:07:54.89,0:07:56.30,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:07:56.39,0:08:00.48,Default,,0,0,0,,Уф, қос мүйіз!
Dialogue: 0,0:08:00.56,0:08:03.44,Default,,0,0,0,,Ушидзима-кун, Оотани-кун тоқта!
Dialogue: 0,0:08:03.52,0:08:05.40,Default,,0,0,0,,Ах! Ууууу!
Dialogue: 0,0:08:05.48,0:08:07.86,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:08:07.94,0:08:09.11,Default,,0,0,0,,Рику!
Dialogue: 0,0:08:11.69,0:08:12.90,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:08:18.20,0:08:19.70,Default,,0,0,0,,Не!?
Dialogue: 0,0:08:21.91,0:08:22.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:25.67,0:08:26.67,Default,,0,0,0,,Аһ!
Dialogue: 0,0:08:28.75,0:08:30.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:31.21,0:08:32.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:32.76,0:08:34.59,Default,,0,0,0,,Хахахаха аа
Dialogue: 0,0:08:34.68,0:08:36.68,Default,,0,0,0,,Не істеп жатырсың, Кайтани?
Dialogue: 0,0:08:36.76,0:08:40.56,Default,,0,0,0,,Шынымен де, мен жылдам соққы жасаймын.
Dialogue: 0,0:08:42.60,0:08:44.52,Default,,0,0,0,,Мұны біреу тоқтатсын!
Dialogue: 0,0:08:46.02,0:08:48.48,Default,,0,0,0,,Аха, бұл мүмкін емес.
Dialogue: 0,0:08:48.56,0:08:52.44,Default,,0,0,0,,Батыс қорғаныс тобы Мен Қасқыр алқабын тоқтатуға бардым!
Dialogue: 0,0:08:52.53,0:08:56.70,Default,,0,0,0,,Қанша адам келсе де, мүмкін емес. Барайық!
Dialogue: 0,0:08:56.78,0:08:59.70,Default,,0,0,0,,Вольффанг!
Dialogue: 0,0:09:05.92,0:09:07.67,Default,,0,0,0,,
Dialogue: 0,0:09:07.75,0:09:09.79,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:09:11.80,0:09:15.88,Default,,0,0,0,,Мен ең жақсымын! Апыр-ай!
Dialogue: 0,0:09:15.97,0:09:18.14,Default,,0,0,0,,Қасқыр алқабы-кунның ғажайып ептілігі
Dialogue: 0,0:09:18.22,0:09:20.85,Default,,0,0,0,,Тізбектелген соққылар!
Dialogue: 0,0:09:20.93,0:09:22.27,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:24.48,0:09:25.31,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:25.39,0:09:29.98,Default,,0,0,0,,Қасқыр мүйістері... Турнир алдында олар мүлде белгіленбеген.
Dialogue: 0,0:09:30.06,0:09:32.78,Default,,0,0,0,,А, бұл мен күткеннен де күшті команда.
Dialogue: 0,0:09:32.86,0:09:36.65,Default,,0,0,0,,Не істеп жатырсың! Қайтарыңыз!
Dialogue: 0,0:09:36.74,0:09:39.82,Default,,0,0,0,,Сәлем, балалар, Канто турнирінде жеңіске жете беріңдер!
Dialogue: 0,0:09:39.91,0:09:42.37,Default,,0,0,0,,Мен тура Рождестволық ыдысқа барамын хаха~
Dialogue: 0,0:09:42.45,0:09:44.62,Default,,0,0,0,,Мен тым қатты қысылып тұрмын ба? Хахахаха
Dialogue: 0,0:09:46.50,0:09:48.58,Default,,0,0,0,,А, анау жігіт...
Dialogue: 0,0:09:48.67,0:09:53.34,Default,,0,0,0,,Эй, сен маған оңай жеңуге рұқсат бере аласың ба?
Dialogue: 0,0:09:56.34,0:09:58.97,Default,,0,0,0,,Тым ыстық, Рику.
Dialogue: 0,0:09:59.05,0:10:00.18,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:00.26,0:10:02.39,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:03.06,0:10:05.60,Default,,0,0,0,,Ушидзима мырза, сіз неге араластыңыз?
Dialogue: 0,0:10:05.68,0:10:07.35,Default,,0,0,0,,Маған қалдырсаңыз
Dialogue: 0,0:10:07.44,0:10:10.31,Default,,0,0,0,,А? Не болды, Рику!
Dialogue: 0,0:10:10.40,0:10:11.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:11.61,0:10:13.77,Default,,0,0,0,,Мен оны тоқтата алар едім.
Dialogue: 0,0:10:13.86,0:10:15.90,Default,,0,0,0,,Мен кедергі келтірмесем, ол жақсы болады!
Dialogue: 0,0:10:15.99,0:10:17.95,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:10:18.03,0:10:19.82,Default,,0,0,0,,Біріншіден, сіз мұны істей алмайсыз.
Dialogue: 0,0:10:19.91,0:10:20.87,Default,,0,0,0,,Бұл мен болуым керек!
Dialogue: 0,0:10:20.95,0:10:24.24,Default,,0,0,0,,Ей, сен үлкендерге осылай қарайсың!
Dialogue: 0,0:10:24.33,0:10:27.16,Default,,0,0,0,,Аааааааааааааа Қатардағы үзіліс?
Dialogue: 0,0:10:27.25,0:10:30.00,Default,,0,0,0,,Жеңілгеніміз үшін бірін-бірі кінәлау шіркін.
Dialogue: 0,0:10:30.08,0:10:32.96,Default,,0,0,0,,Не! (Ороя) Ой, қорқынышты, қорқынышты
Dialogue: 0,0:10:33.92,0:10:36.42,Default,,0,0,0,,Жоқ, Рику, сабыр ет.
Dialogue: 0,0:10:36.51,0:10:38.88,Default,,0,0,0,,Қасқыр алқабындағы бейбақ!
Dialogue: 0,0:10:38.97,0:10:41.43,Default,,0,0,0,,Уау, аа, эй, Тецуума-сан!
Dialogue: 0,0:10:41.55,0:10:42.89,Default,,0,0,0,,Тоқта, не... Уау.
Dialogue: 0,0:10:43.55,0:10:45.35,Default,,0,0,0,,Ауырды! Сен не істеп жатырсың?
Dialogue: 0,0:10:45.43,0:10:47.06,Default,,0,0,0,,Ах
Dialogue: 0,0:10:47.14,0:10:50.52,Default,,0,0,0,,Хмм... құла... киіңіз...
Dialogue: 0,0:10:50.60,0:10:53.52,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:10:53.61,0:10:56.44,Default,,0,0,0,,Сабыр сақта, Рику.
Dialogue: 0,0:10:56.53,0:10:57.49,Default,,0,0,0,,Мистер Кидд
Dialogue: 0,0:10:59.74,0:11:03.03,Default,,0,0,0,,Бұл жай ғана Қасқыр алқабы емес, сен де қасқырсың, солай ма?
Dialogue: 0,0:11:03.12,0:11:03.95,Default,,0,0,0,,Ең үздік батыр болу үшін
Dialogue: 0,0:11:05.33,0:11:07.41,Default,,0,0,0,,Жалғыз қасқыр болу – мәселе
Dialogue: 0,0:11:08.04,0:11:09.16,Default,,0,0,0,,Ах
Dialogue: 0,0:11:11.12,0:11:12.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:13.21,0:11:15.59,Default,,0,0,0,,Ах... мен...
Dialogue: 0,0:11:16.42,0:11:18.67,Default,,0,0,0,,Мен біраз уақыт бұрын бірдеңе естідім.
Dialogue: 0,0:11:18.76,0:11:21.76,Default,,0,0,0,,Қасқыр мүйістерімен бәсекеге түсе алмаймын дейсіз бе?
Dialogue: 0,0:11:21.84,0:11:23.47,Default,,0,0,0,,Бұл асыра сілтеу емес пе?
Dialogue: 0,0:11:24.10,0:11:25.72,Default,,0,0,0,,Тек шындықты айту
Dialogue: 0,0:11:35.23,0:11:38.61,Default,,0,0,0,,Біз ұрысып қалғанға дейін мен менсінбеген адам маған солай жасады.
Dialogue: 0,0:11:38.69,0:11:41.49,Default,,0,0,0,,Мен асығыс болып, асығыс айналдым.
Dialogue: 0,0:11:41.57,0:11:44.07,Default,,0,0,0,,Мен оның жағдайына алаңдаймын. (Деку) Иә.
Dialogue: 0,0:11:44.16,0:11:48.37,Default,,0,0,0,,Мен Токио ойындарында жіберген қателікті дерлік жасадым.
Dialogue: 0,0:11:50.00,0:11:51.96,Default,,0,0,0,,Түсіндім, Кидд мырза.
Dialogue: 0,0:11:52.04,0:11:53.37,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:56.13,0:11:59.38,Default,,0,0,0,,Кешіріңіз, Ушидзима-сан, мен...
Dialogue: 0,0:11:59.46,0:12:02.47,Default,,0,0,0,,Жарайды, Бала дұрыс айтады.
Dialogue: 0,0:12:02.55,0:12:05.47,Default,,0,0,0,,Егер сіз жалғыз қасқыр болсаңыз, американдық футбол ойнай алмайсыз.
Dialogue: 0,0:12:05.55,0:12:09.39,Default,,0,0,0,,Батыс жабайы зеңбірекшілер топпен жүруі керек.
Dialogue: 0,0:12:09.47,0:12:10.35,Default,,0,0,0,,Оған бар күшімді салуым керек.
Dialogue: 0,0:12:11.64,0:12:12.81,Default,,0,0,0,,Иә
Dialogue: 0,0:12:12.89,0:12:15.77,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:12:15.86,0:12:19.28,Default,,0,0,0,,Қатты қарсы шабуыл! Ганган!
Dialogue: 0,0:12:19.36,0:12:21.74,Default,,0,0,0,,Ал, уайымдама.
Dialogue: 0,0:12:21.82,0:12:24.74,Default,,0,0,0,,Өйткені біздің денеміз бірге жылы
Dialogue: 0,0:12:25.36,0:12:27.70,Default,,0,0,0,,Батыс жағы ерте кезеңде 21 ұпайға артта қалды
Dialogue: 0,0:12:27.78,0:12:32.75,Default,,0,0,0,,Күшті мүйіске қалай шабуыл жасауға болады?
Dialogue: 0,0:12:33.21,0:12:35.58,Default,,0,0,0,,Менің ойымша, кететін уақыт келді
Dialogue: 0,0:12:35.67,0:12:37.75,Default,,0,0,0,,Аа, кез келген уақыт жақсы.
Dialogue: 0,0:12:37.84,0:12:40.59,Default,,0,0,0,,Соққы... Хмф!
Dialogue: 0,0:12:42.67,0:12:46.51,Default,,0,0,0,,Мен оған енді не қаласа, соны істеуге рұқсат бермеймін.
Dialogue: 0,0:12:46.59,0:12:49.97,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:12:50.06,0:12:52.56,Default,,0,0,0,,Қарсы шабуылды бастайық.
Dialogue: 0,0:12:52.64,0:12:53.48,Default,,0,0,0,,О!
Dialogue: 0,0:12:54.60,0:12:56.65,Default,,0,0,0,,Батыстың атмосферасы өзгерді.
Dialogue: 0,0:12:56.73,0:12:58.15,Default,,0,0,0,,А? (Төбе шайтан)
Dialogue: 0,0:12:58.23,0:13:01.23,Default,,0,0,0,,Ренжімейміз деп ойлаймын, хехе.
Dialogue: 0,0:13:01.32,0:13:02.61,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:13:03.94,0:13:06.49,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:13:08.99,0:13:12.41,Default,,0,0,0,,Қос қос мүйіз!
Dialogue: 0,0:13:17.17,0:13:18.29,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:13:18.38,0:13:20.75,Default,,0,0,0,,Темір тұлпар!
Dialogue: 0,0:13:23.30,0:13:25.88,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,0:13:25.97,0:13:28.84,Default,,0,0,0,,Тецуума-кун жанып жатыр!
Dialogue: 0,0:13:28.93,0:13:30.26,Default,,0,0,0,,Тецуума-сан
Dialogue: 0,0:13:30.35,0:13:33.85,Default,,0,0,0,,Бұл керемет, Макс. Бұл жанып жатқан қашып бара жатқан локомотив.
Dialogue: 0,0:13:33.93,0:13:36.81,Default,,0,0,0,,Уау! (Темір тұлпар) Ғұн хун хун...
Dialogue: 0,0:13:36.89,0:13:40.36,Default,,0,0,0,,өтті! Жылдам және өрт!
Dialogue: 0,0:13:40.44,0:13:42.78,Default,,0,0,0,,Батыс ұзын пасында сәтті
Dialogue: 0,0:13:42.86,0:13:44.11,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:44.19,0:13:45.86,Default,,0,0,0,,Иә! Тецума~н!
Dialogue: 0,0:13:45.95,0:13:48.74,Default,,0,0,0,,«Тэцуман» Тецуума-сан дегенді білдіреді ме?
Dialogue: 0,0:13:48.82,0:13:51.41,Default,,0,0,0,,Бұл Батыс жабайы қаруластары
Dialogue: 0,0:13:51.49,0:13:53.62,Default,,0,0,0,,Керемет және ақылды баламен
Dialogue: 0,0:13:53.70,0:13:56.58,Default,,0,0,0,,Жанып тұрған темір тұлпар Темір тұлпардың алтын дуэті
Dialogue: 0,0:13:56.66,0:13:59.12,Default,,0,0,0,,Бірінші аз ақша тапты!
Dialogue: 0,0:13:59.21,0:14:00.21,Default,,0,0,0,,Оған бар күшімді салуым керек.
Dialogue: 0,0:14:00.84,0:14:04.67,Default,,0,0,0,,Буффало Усидзиманың қос қос мүйізі де күшті болды.
Dialogue: 0,0:14:06.34,0:14:09.22,Default,,0,0,0,,Жарайды, менің кезегім.
Dialogue: 0,0:14:09.30,0:14:12.05,Default,,0,0,0,,Мен оны Деймон шайқасына дейін жабық ұстауды жоспарладым, бірақ
Dialogue: 0,0:14:12.14,0:14:13.81,Default,,0,0,0,,Мұқият қара, Сена.
Dialogue: 0,0:14:14.89,0:14:17.56,Default,,0,0,0,,Rodeo Drive Kanto турнирінің нұсқасы
Dialogue: 0,0:14:17.64,0:14:20.19,Default,,0,0,0,,Rodeo Drive Stampede
Dialogue: 0,0:14:21.56,0:14:23.90,Default,,0,0,0,,Ах... Рику...
Dialogue: 0,0:14:24.78,0:14:28.36,Default,,0,0,0,,Я~ Қатты жүр, Риккурик~!
Dialogue: 0,0:14:28.45,0:14:31.66,Default,,0,0,0,,Сузунэ-чан – батыстық режиссер
Dialogue: 0,0:14:31.74,0:14:33.58,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:14:38.08,0:14:39.71,Default,,0,0,0,,Шешіңіз
Dialogue: 0,0:14:39.79,0:14:40.71,Default,,0,0,0,,Иә
Dialogue: 0,0:14:41.67,0:14:44.59,Default,,0,0,0,,Доп Кайтаниге берілді!
Dialogue: 0,0:14:44.67,0:14:47.55,Default,,0,0,0,,Хе, мен оны оңай тоқтатамын.
Dialogue: 0,0:14:47.63,0:14:51.01,Default,,0,0,0,,Жүр, Оотани-кун Кайтани-кунға жақындайды.
Dialogue: 0,0:14:51.09,0:14:53.47,Default,,0,0,0,,А... Бар! Рику-кун!
Dialogue: 0,0:14:55.51,0:14:57.39,Default,,0,0,0,,Нысана алған олжаның қашып кетуіне жол бермеу
Dialogue: 0,0:14:57.47,0:15:00.44,Default,,0,0,0,,Кеттік, Вольффанг!
Dialogue: 0,0:15:03.23,0:15:04.57,Default,,0,0,0,,Рику!
Dialogue: 0,0:15:04.65,0:15:07.03,Default,,0,0,0,,Өзіңді дайында, Кайдани
Dialogue: 0,0:15:07.11,0:15:09.32,Default,,0,0,0,,Мен сіздің родео дискіңізден бас тартамын.
Dialogue: 0,0:15:09.40,0:15:11.78,Default,,0,0,0,,Эй, мен саған көрсетемін.
Dialogue: 0,0:15:11.86,0:15:14.28,Default,,0,0,0,,Дамушы Родео Drive
Dialogue: 0,0:15:14.37,0:15:16.99,Default,,0,0,0,,Rodeo Drive Stampede!
Dialogue: 0,0:15:21.29,0:15:23.13,Default,,0,0,0,,Rodeo Drive Stampede?
Dialogue: 0,0:15:23.21,0:15:24.59,Default,,0,0,0,,Не!
Dialogue: 0,0:15:29.13,0:15:32.97,Default,,0,0,0,,Бұл! Қайтани-күндер көп сияқты.
Dialogue: 0,0:15:33.05,0:15:35.47,Default,,0,0,0,,Қайсысы нақты?
Dialogue: 0,0:15:35.55,0:15:37.64,Default,,0,0,0,,Қарқынның өте жылдам өзгеруі
Dialogue: 0,0:15:37.72,0:15:40.43,Default,,0,0,0,,Төбелес алға-артқа, солға-оңға қатты қозғалу.
Dialogue: 0,0:15:41.48,0:15:43.90,Default,,0,0,0,,Шынымен де қашқан ат
Dialogue: 0,0:15:43.98,0:15:45.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:45.44,0:15:47.52,Default,,0,0,0,,Жүгіру! жүгір!
Dialogue: 0,0:15:47.61,0:15:50.32,Default,,0,0,0,,Бұл шабуылды ешкім тоқтата алмайды
Dialogue: 0,0:15:50.40,0:15:53.82,Default,,0,0,0,,Керемет... Керемет Рику
Dialogue: 0,0:15:55.87,0:15:57.20,Default,,0,0,0,,
Dialogue: 0,0:15:57.28,0:15:59.24,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:15:59.33,0:16:01.46,Default,,0,0,0,,Жарайды, зукюн зукюн
Dialogue: 0,0:16:01.54,0:16:05.71,Default,,0,0,0,,Бұл үлкен мәселе. Осыншама қысқа уақыт ішінде қаншалықты жетілдіргеніңіз таң қалдырады.
Dialogue: 0,0:16:06.54,0:16:09.67,Default,,0,0,0,,А-а... Иә?
Dialogue: 0,0:16:09.76,0:16:14.01,Default,,0,0,0,,Бірінші нөмір үшін Eyeshield-пен күресетін адаммын.
Dialogue: 0,0:16:14.09,0:16:15.64,Default,,0,0,0,,Сіз емес
Dialogue: 0,0:16:16.26,0:16:20.14,Default,,0,0,0,,Хмм, иә! Бізде әлі 1 жеңіс пен 1 ​​жеңіліс бар, солай емес пе?
Dialogue: 0,0:16:21.39,0:16:27.31,Default,,0,0,0,,Бұл бір жеңіс - Канто турниріндегі ең үлкен естелік.
Dialogue: 0,0:16:27.40,0:16:29.32,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:16:29.40,0:16:30.82,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:30.90,0:16:32.28,Default,,0,0,0,,Егер ағам мен әпкем әлі тірі болса…
Dialogue: 0,0:16:32.36,0:16:34.61,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:34.70,0:16:37.57,Default,,0,0,0,,Батыс жабайы қарулы топтардың шабуылы!
Dialogue: 0,0:16:37.66,0:16:40.54,Default,,0,0,0,,Бұл тосқауылсыз шабуыл!
Dialogue: 0,0:16:41.25,0:16:44.04,Default,,0,0,0,,Сенна Қол тигізбейтін жылдамдыққа
Dialogue: 0,0:16:44.12,0:16:46.54,Default,,0,0,0,,Ол арқылы ешқандай қуат өте алмайды.
Dialogue: 0,0:16:47.17,0:16:51.51,Default,,0,0,0,,Сенна, біздің жалғыз қаруымыз – осы жылдамдық.
Dialogue: 0,0:16:53.47,0:16:56.97,Default,,0,0,0,,Rodeo Drive Stampede!
Dialogue: 0,0:16:57.05,0:16:58.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:02.22,0:17:03.89,Default,,0,0,0,,
Dialogue: 0,0:17:04.69,0:17:09.57,Default,,0,0,0,,Сенна, мен бұл жүгірумен міндетті түрде финалға шығамын.
Dialogue: 0,0:17:13.61,0:17:15.15,Default,,0,0,0,,Матчтың соңы
Dialogue: 0,0:17:15.24,0:17:19.53,Default,,0,0,0,,Western Wild Gunmans 48-21 есебімен басым түсті!
Dialogue: 0,0:17:19.62,0:17:21.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:21.24,0:17:23.04,Default,,0,0,0,,Western Strong!
Dialogue: 0,0:17:23.12,0:17:23.95,Default,,0,0,0,,Иә
Dialogue: 0,0:17:24.04,0:17:29.50,Default,,0,0,0,,Ке, егер шабуыл күші туралы айтатын болсақ, батыс аймақ дәл қазір Жапониядағы ең жақсы аймақ болуы мүмкін.
Dialogue: 0,0:17:29.59,0:17:33.96,Default,,0,0,0,,Батыстың шабуылын көргеніңізге қуаныштымын.
Dialogue: 0,0:17:34.05,0:17:38.47,Default,,0,0,0,,Әй, бұл темір тұлпар ең жақсы жағынан емес, бұл оның ұпай жинау қабілетінің арқасында.
Dialogue: 0,0:17:38.55,0:17:42.97,Default,,0,0,0,,(Ойыншылар қолдайды)
Dialogue: 0,0:17:46.10,0:17:47.94,Default,,0,0,0,,Рику Кайтани…
Dialogue: 0,0:17:52.98,0:17:56.11,Default,,0,0,0,,Ах... Жартылай финалға шығуыңызбен құттықтаймыз.
Dialogue: 0,0:17:56.99,0:18:00.07,Default,,0,0,0,,Ха, сәл қиын болды.
Dialogue: 0,0:18:01.20,0:18:04.29,Default,,0,0,0,,Бірақ сіз шынымен асығыс едіңіз, солай емес пе?
Dialogue: 0,0:18:04.37,0:18:06.58,Default,,0,0,0,,Сәлем Рикурик~
Dialogue: 0,0:18:07.46,0:18:11.21,Default,,0,0,0,,Маған Рикудың Rodeo Drive Stampede фильмін көрсетті.
Dialogue: 0,0:18:11.29,0:18:14.05,Default,,0,0,0,,Бұл таңқаларлық. Рику керемет.
Dialogue: 0,0:18:14.13,0:18:18.80,Default,,0,0,0,,Сенна, біз келесі жолы жеңеміз және міндетті түрде финалға өтеміз.
Dialogue: 0,0:18:18.88,0:18:22.51,Default,,0,0,0,,Оджоны жеңіп, финалға шығуды ұмытпаңыз.
Dialogue: 0,0:18:23.64,0:18:25.10,Default,,0,0,0,,Иә
Dialogue: 0,0:18:25.18,0:18:28.06,Default,,0,0,0,,Мен финалда шешемін.
Dialogue: 0,0:18:28.14,0:18:30.15,Default,,0,0,0,,Бұл поза түпнұсқа болып табылады!
Dialogue: 0,0:18:30.23,0:18:32.69,Default,,0,0,0,,Сәлем! Мені де қара!
Dialogue: 0,0:18:32.77,0:18:36.11,Default,,0,0,0,,Жоқ, жоқ, саусағыңызды қалай шығаратыныңыздың құпиясы.
Dialogue: 0,0:18:36.19,0:18:38.49,Default,,0,0,0,,Монмон Таңқаларлық егжей-тегжейлі
Dialogue: 0,0:18:38.57,0:18:40.03,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:18:42.37,0:18:43.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:45.49,0:18:46.79,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:18:46.87,0:18:49.67,Default,,0,0,0,,Бұл өте қызықты матч болды.
Dialogue: 0,0:18:49.75,0:18:51.29,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:18:57.17,0:19:00.76,Default,,0,0,0,,Келесіде Деймон, патша сарайы, ал бұл Хакушу.
Dialogue: 0,0:19:00.84,0:19:02.93,Default,,0,0,0,,Бұл ауырады.
Dialogue: 0,0:19:03.01,0:19:06.22,Default,,0,0,0,,Бұл біз бен құбыжықтың арасындағы жартылай финал.
Dialogue: 0,0:19:07.10,0:19:09.69,Default,,0,0,0,,Мен зардап шекпеу үшін барымды саламын.
Dialogue: 0,0:19:10.69,0:19:13.40,Default,,0,0,0,,Жеңіске деген жігерім толы болса да, мен мұны жиі айтамын.
Dialogue: 0,0:19:14.11,0:19:16.15,Default,,0,0,0,,Бұл өте жаман.
Dialogue: 0,0:19:16.23,0:19:20.40,Default,,0,0,0,,Егер менің қолымнан келетін нәрсе болса, маған хабарлаңыз.
Dialogue: 0,0:19:20.49,0:19:23.41,Default,,0,0,0,,Токио нөмірі бірінші қорғаушы
Dialogue: 0,0:19:23.49,0:19:26.62,Default,,0,0,0,,Кім бірінші?
Dialogue: 0,0:19:26.70,0:19:29.54,Default,,0,0,0,,Ол жай ғана тамақ іше алмайтын бейбақ.
Dialogue: 0,0:19:30.12,0:19:35.34,Default,,0,0,0,,Ху, Якко-сан, сен қандай қимылды ойлап отырсың.
Dialogue: 0,0:19:41.01,0:19:46.01,Default,,0,0,0,,♪~
Dialogue: 0,0:20:50.79,0:20:55.96,Default,,0,0,0,,~♪
Dialogue: 0,0:20:56.67,0:20:59.29,Default,,0,0,0,,Rodeo Drive Stampede
Dialogue: 0,0:20:59.38,0:21:02.38,Default,,0,0,0,,Рикудың жігіті тағы да жылдамдады емес пе?
Dialogue: 0,0:21:02.46,0:21:04.47,Default,,0,0,0,,Бізде бұл жылдамдық
Dialogue: 0,0:21:04.55,0:21:06.55,Default,,0,0,0,,Бұл жай ғана жылдамдық болса, Сусуму-сан да.
Dialogue: 0,0:21:06.64,0:21:11.01,Default,,0,0,0,,Егер Сусуму жылдамдыққа ие болса ше?
Dialogue: 0,0:21:11.10,0:21:13.06,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:13.14,0:21:14.77,Default,,0,0,0,,«Соқыр дақсыз рыцарь»
Dialogue: 0,0:21:14.85,0:21:15.98,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:17.48,0:21:23.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory