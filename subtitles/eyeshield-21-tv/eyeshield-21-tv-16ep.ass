Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.83,0:00:07.88,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:00:08.46,0:00:10.17,Default,,0,0,0,,Жоқ, менде бәрі жақсы.
Dialogue: 0,0:00:10.71,0:00:12.67,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:13.17,0:00:15.09,Default,,0,0,0,,Американдық футбол!
Dialogue: 0,0:00:15.22,0:00:17.80,Default,,0,0,0,,Иә, физикалық шайқаста кім жеңеді
Dialogue: 0,0:00:18.30,0:00:19.14,Default,,0,0,0,,Күш!
Dialogue: 0,0:00:21.10,0:00:23.27,Default,,0,0,0,,Тактика! Арнд
Dialogue: 0,0:00:24.35,0:00:25.44,Default,,0,0,0,,Жылдамдық!
Dialogue: 0,0:00:25.56,0:00:27.81,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:28.65,0:00:29.48,Default,,0,0,0,,
Dialogue: 0,0:00:29.61,0:00:30.90,Default,,0,0,0,,Тоқтау!
Dialogue: 0,0:00:31.11,0:00:36.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:38.03,0:00:44.04,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:51.94,0:01:57.95,Default,,0,0,0,,~♪
Dialogue: 0,0:02:09.96,0:02:10.79,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:02:11.33,0:02:12.54,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:02:14.80,0:02:16.01,Default,,0,0,0,,Тозақ Даш!
Dialogue: 0,0:02:16.34,0:02:17.97,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:02:18.09,0:02:19.34,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:19.84,0:02:20.93,Default,,0,0,0,,Тата... көмек...
Dialogue: 0,0:02:21.68,0:02:22.85,Default,,0,0,0,,Ги~!
Dialogue: 0,0:02:23.30,0:02:24.31,Default,,0,0,0,,Тозақ асуы!
Dialogue: 0,0:02:25.14,0:02:26.39,Default,,0,0,0,,Ең үлкен супер аулау!
Dialogue: 0,0:02:26.52,0:02:27.77,Default,,0,0,0,,Батырды ұстау!
Dialogue: 0,0:02:27.89,0:02:28.98,Default,,0,0,0,,Максималды ғажайып аулау!
Dialogue: 0,0:02:29.10,0:02:30.02,Default,,0,0,0,,Ха?
Dialogue: 0,0:02:30.15,0:02:31.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:31.31,0:02:32.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:32.36,0:02:33.73,Default,,0,0,0,,Сәттілік Монта-кун!
Dialogue: 0,0:02:34.02,0:02:35.57,Default,,0,0,0,,Ма… Мамори-сан
Dialogue: 0,0:02:37.53,0:02:38.86,Default,,0,0,0,,Тозақ блогы!
Dialogue: 0,0:02:41.91,0:02:43.37,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:02:43.62,0:02:44.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:44.58,0:02:45.41,Default,,0,0,0,,Жаса!
Dialogue: 0,0:02:45.54,0:02:46.62,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:02:46.74,0:02:47.70,Default,,0,0,0,,Хуаааааааа?
Dialogue: 0,0:02:47.83,0:02:49.08,Default,,0,0,0,,Жаса! (мылтық)
Dialogue: 0,0:02:50.04,0:02:52.00,Default,,0,0,0,,Менің ойымша, мұны істеу дұрыс.
Dialogue: 0,0:02:52.25,0:02:53.84,Default,,0,0,0,,Хааааааааа!
Dialogue: 0,0:02:53.96,0:02:55.13,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:02:55.25,0:02:56.09,Default,,0,0,0,,Гюго!
Dialogue: 0,0:02:57.67,0:03:01.18,Default,,0,0,0,,Фуго ~ Фуго ~
Dialogue: 0,0:03:01.30,0:03:02.14,Default,,0,0,0,,Гюго!
Dialogue: 0,0:03:02.43,0:03:04.43,Default,,0,0,0,,Барлығы аянбай еңбек етуде~
Dialogue: 0,0:03:04.55,0:03:06.93,Default,,0,0,0,,Жоқ, мен қатты тырысып жатырмын...
Dialogue: 0,0:03:07.06,0:03:08.14,Default,,0,0,0,,Жарайды, мен де!
Dialogue: 0,0:03:08.27,0:03:10.14,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:03:10.27,0:03:11.10,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:11.23,0:03:13.10,Default,,0,0,0,,Аха~
Dialogue: 0,0:03:13.27,0:03:15.57,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:03:17.94,0:03:21.40,Default,,0,0,0,,Хаа~
Dialogue: 0,0:03:22.28,0:03:23.91,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:03:24.03,0:03:25.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:25.83,0:03:28.45,Default,,0,0,0,,Бірақ барлығы шынымен де қолынан келгенін істеп жатыр.
Dialogue: 0,0:03:29.33,0:03:30.54,Default,,0,0,0,,Әрине!
Dialogue: 0,0:03:30.66,0:03:32.87,Default,,0,0,0,,Мен Рождестволық тостағанды ​​көздеу үшін бар күшімді саламын.
Dialogue: 0,0:03:33.00,0:03:34.67,Default,,0,0,0,,Осы жетістікке назар аударыңыз!
Dialogue: 0,0:03:34.79,0:03:35.92,Default,,0,0,0,,Фуго Фугого!
Dialogue: 0,0:03:36.29,0:03:39.80,Default,,0,0,0,,Жаттығудан кейін шаршау жақсы сезінеді.
Dialogue: 0,0:03:39.92,0:03:41.42,Default,,0,0,0,,Жарайды... дұрыс.
Dialogue: 0,0:03:41.72,0:03:43.97,Default,,0,0,0,,~ Сенаға, мен түсінемін.
Dialogue: 0,0:03:44.09,0:03:46.64,Default,,0,0,0,,Жоқ... Мен солай ойлаймын.
Dialogue: 0,0:03:46.76,0:03:48.64,Default,,0,0,0,,Әйтеуір, адам саны жиналды.
Dialogue: 0,0:03:48.77,0:03:50.14,Default,,0,0,0,,Қазірден бастап барымызды салайық!
Dialogue: 0,0:03:50.27,0:03:51.10,Default,,0,0,0,,Фуго!
Dialogue: 0,0:03:51.48,0:03:53.56,Default,,0,0,0,,Жақсы~ Осындай нәрсе
Dialogue: 0,0:03:53.98,0:03:56.65,Default,,0,0,0,,Соңғы уақытқа дейін бұл жай ғана сүлгі жын екеуміз едік.
Dialogue: 0,0:03:56.77,0:03:58.94,Default,,0,0,0,,Жаттығу жасап жүрсем де, өзімді жалғыз сезіндім.
Dialogue: 0,0:03:59.07,0:04:01.57,Default,,0,0,0,,Бірге жаттығу жасау қызық
Dialogue: 0,0:04:01.82,0:04:02.74,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:04:03.07,0:04:06.24,Default,,0,0,0,,Жарайды, мен бүгін осы жерден үйге қайтайын.
Dialogue: 0,0:04:06.37,0:04:07.24,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:04:07.87,0:04:08.87,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:09.04,0:04:12.75,Default,,0,0,0,,Барлық мүшелер бірге болғанда ең бақытты адам Курита-кун болса керек.
Dialogue: 0,0:04:12.87,0:04:13.71,Default,,0,0,0,,Пудинг
Dialogue: 0,0:04:21.84,0:04:24.09,Default,,0,0,0,,~ Бізде фестиваль өтіп жатыр.
Dialogue: 0,0:04:24.22,0:04:25.30,Default,,0,0,0,,Жоқ! (Курита) Иә?
Dialogue: 0,0:04:25.43,0:04:27.47,Default,,0,0,0,,Бұл жақсы емес пе? Келіңіздер, араласайық.
Dialogue: 0,0:04:27.60,0:04:28.51,Default,,0,0,0,,Нотарада өлім жоқ!
Dialogue: 0,0:04:29.06,0:04:31.64,Default,,0,0,0,,Бірге көңіл көтерейік~
Dialogue: 0,0:04:31.77,0:04:32.98,Default,,0,0,0,,Хи хи хи!
Dialogue: 0,0:04:33.39,0:04:34.69,Default,,0,0,0,,Хи хи хи...
Dialogue: 0,0:04:34.98,0:04:36.90,Default,,0,0,0,,Яметекудасай!
Dialogue: 0,0:04:37.02,0:04:38.15,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,0:04:38.27,0:04:39.11,Default,,0,0,0,,(Гүлп!)
Dialogue: 0,0:04:41.36,0:04:43.32,Default,,0,0,0,,Кя~!
Dialogue: 0,0:04:43.86,0:04:45.24,Default,,0,0,0,,№ №
Dialogue: 0,0:04:45.36,0:04:46.91,Default,,0,0,0,,Хи хи хи хи...
Dialogue: 0,0:04:47.28,0:04:48.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:48.70,0:04:49.53,Default,,0,0,0,,Хи хи хи хи...
Dialogue: 0,0:04:49.66,0:04:50.99,Default,,0,0,0,,Көңілді сияқты, солай ма?
Dialogue: 0,0:04:51.12,0:04:52.58,Default,,0,0,0,,Бізбен бірге көңіл көтерейік
Dialogue: 0,0:04:53.25,0:04:54.25,Default,,0,0,0,,Бақамитай!
Dialogue: 0,0:04:54.37,0:04:55.58,Default,,0,0,0,,Цукаи Киренаи!
Dialogue: 0,0:04:56.04,0:04:57.33,Default,,0,0,0,,Хеннахито!
Dialogue: 0,0:04:57.46,0:04:59.09,Default,,0,0,0,,Хи хи хи хи...
Dialogue: 0,0:04:59.21,0:05:01.71,Default,,0,0,0,,Қашпа~
Dialogue: 0,0:05:01.84,0:05:02.92,Default,,0,0,0,,Біз
Dialogue: 0,0:05:03.05,0:05:06.51,Default,,0,0,0,,Мен әпкелеріммен көңіл көтергім келеді деп жатырмын.
Dialogue: 0,0:05:06.93,0:05:09.47,Default,,0,0,0,,Хи хи хи хи...
Dialogue: 0,0:05:09.60,0:05:11.68,Default,,0,0,0,,Бұл... бла бла өлім жоқ!
Dialogue: 0,0:05:11.81,0:05:13.18,Default,,0,0,0,,Оучини Кайшит
Dialogue: 0,0:05:13.43,0:05:14.89,Default,,0,0,0,,Ярихо~!
Dialogue: 0,0:05:16.31,0:05:17.52,Default,,0,0,0,,Сол жерде болыңыз!
Dialogue: 0,0:05:17.65,0:05:18.48,Default,,0,0,0,,Нанана…
Dialogue: 0,0:05:18.60,0:05:19.65,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:20.32,0:05:22.28,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:23.07,0:05:24.28,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:05:24.74,0:05:26.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:26.78,0:05:27.61,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:27.86,0:05:28.70,Default,,0,0,0,,А…
Dialogue: 0,0:05:30.07,0:05:30.91,Default,,0,0,0,,Зенитсу! Иносуке!
Dialogue: 0,0:05:32.49,0:05:34.33,Default,,0,0,0,,Кя~!
Dialogue: 0,0:05:35.16,0:05:36.33,Default,,0,0,0,,Kya...
Dialogue: 0,0:05:36.54,0:05:37.37,Default,,0,0,0,,Не?
Dialogue: 0,0:05:37.50,0:05:38.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:39.08,0:05:40.13,Default,,0,0,0,,Не? Мынау
Dialogue: 0,0:05:40.25,0:05:41.79,Default,,0,0,0,,Фестиваль безендірулері!
Dialogue: 0,0:05:42.00,0:05:44.80,Default,,0,0,0,,Я... Ябе~ Қаш!
Dialogue: 0,0:05:45.13,0:05:45.97,Default,,0,0,0,,Міне~
Dialogue: 0,0:05:46.22,0:05:48.47,Default,,0,0,0,,Жарайды... бәрі бұзылды!
Dialogue: 0,0:05:48.84,0:05:50.43,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:05:50.80,0:05:51.64,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:05:51.76,0:05:53.64,Default,,0,0,0,,Ерекше фестивальге дайындық
Dialogue: 0,0:05:53.85,0:05:57.06,Default,,0,0,0,,Не? Ум, мен...
Dialogue: 0,0:05:57.19,0:05:58.35,Default,,0,0,0,,Мен үшін не істейсің!
Dialogue: 0,0:05:58.64,0:05:59.69,Default,,0,0,0,,Ах~ Міне!
Dialogue: 0,0:05:59.81,0:06:01.02,Default,,0,0,0,,Ә, ә…! Тс-с, жоқ! Көзіме бірдеңе түсті…
Dialogue: 0,0:06:01.27,0:06:03.52,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:06:03.86,0:06:04.86,Default,,0,0,0,,Маған қашып кетуіме жол берме!
Dialogue: 0,0:06:04.98,0:06:06.82,Default,,0,0,0,,Мен форманың...
Dialogue: 0,0:06:09.16,0:06:10.87,Default,,0,0,0,,Эй, сен мұны естідің бе? Вокзал алдында
Dialogue: 0,0:06:10.99,0:06:12.20,Default,,0,0,0,,Бұл сауда аймағы ма?
Dialogue: 0,0:06:12.33,0:06:14.87,Default,,0,0,0,,Фестивальдің барлық әшекейлері жойылды.
Dialogue: 0,0:06:15.54,0:06:17.33,Default,,0,0,0,,Бұл көп ақша жұмсады, солай ма?
Dialogue: 0,0:06:17.62,0:06:21.54,Default,,0,0,0,,Дұрыс. Кінәлі біздің студенттердің бірі болса керек.
Dialogue: 0,0:06:21.67,0:06:22.59,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:22.71,0:06:24.38,Default,,0,0,0,,Эй, кім? ДДСҰ?
Dialogue: 0,0:06:24.50,0:06:25.38,Default,,0,0,0,,(Гүлп!)
Dialogue: 0,0:06:25.80,0:06:28.47,Default,,0,0,0,,Білмеймін, бірақ ол біздің форманы киіп алған.
Dialogue: 0,0:06:28.59,0:06:29.97,Default,,0,0,0,,Мен сіздің жүзіңізді түсінбеймін
Dialogue: 0,0:06:30.09,0:06:32.68,Default,,0,0,0,,Оның дене түрі тұтас болған дейді.
Dialogue: 0,0:06:32.80,0:06:35.47,Default,,0,0,0,,Мені қылмыскер етіп жатыр ғой.
Dialogue: 0,0:06:35.60,0:06:36.97,Default,,0,0,0,,Сауда ауданындағы адамдар
Dialogue: 0,0:06:37.10,0:06:39.81,Default,,0,0,0,,Ол ашуланып, полицияға арыз жазған көрінеді.
Dialogue: 0,0:06:39.94,0:06:42.48,Default,,0,0,0,,Шынайы ма? Егер сен жақсы болмасаң, қамауға аласың!
Dialogue: 0,0:06:42.61,0:06:44.15,Default,,0,0,0,,Ең жақсы жағдайда сіз оқудан шығарыласыз.
Dialogue: 0,0:06:44.77,0:06:47.40,Default,,0,0,0,,Айтуынша, кеше ол мөлдір сәбиді немесе сондай бір нәрсені тапқан екен—
Dialogue: 0,0:06:47.82,0:06:50.11,Default,,0,0,0,,Олар бәрін әдемі қиратты.
Dialogue: 0,0:06:50.57,0:06:51.66,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:06:51.78,0:06:52.62,Default,,0,0,0,,Фуго?
Dialogue: 0,0:06:52.74,0:06:54.08,Default,,0,0,0,,Менен сұрама.
Dialogue: 0,0:06:54.45,0:06:56.87,Default,,0,0,0,,Емтихандардың күйзелісі... (Монта) Иә?
Dialogue: 0,0:06:56.99,0:06:58.08,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:06:58.45,0:07:01.04,Default,,0,0,0,,Мен... Мен мұндай нәрсені істемес едім.
Dialogue: 0,0:07:01.29,0:07:04.54,Default,,0,0,0,,Дұрыс, менің мектебімде осындай іспен айналысатындар бар...
Dialogue: 0,0:07:04.67,0:07:07.05,Default,,0,0,0,,Ах! Мұны жасайтын біреу бар.
Dialogue: 0,0:07:07.17,0:07:08.01,Default,,0,0,0,,Докин!
Dialogue: 0,0:07:08.84,0:07:09.67,Default,,0,0,0,,Ах
Dialogue: 0,0:07:09.88,0:07:11.63,Default,,0,0,0,,Неліктен ыстық?
Dialogue: 0,0:07:11.76,0:07:13.43,Default,,0,0,0,,Осындай күндер жүрегім айныды.
Dialogue: 0,0:07:13.55,0:07:14.39,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:15.35,0:07:17.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:17.68,0:07:18.52,Default,,0,0,0,,Ха?
Dialogue: 0,0:07:18.64,0:07:19.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:19.68,0:07:20.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:23.06,0:07:24.48,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,0:07:24.94,0:07:27.23,Default,,0,0,0,,Біз қандай сиқырлар жасап жатырмыз?
Dialogue: 0,0:07:27.36,0:07:28.44,Default,,0,0,0,,Наметонка (джумонджи) осында
Dialogue: 0,0:07:28.61,0:07:30.86,Default,,0,0,0,,Бұл соншалықты керемет емес.
Dialogue: 0,0:07:30.99,0:07:32.45,Default,,0,0,0,,Мұны жасаған сен едің!
Dialogue: 0,0:07:32.57,0:07:33.99,Default,,0,0,0,,Енді тоқтайық
Dialogue: 0,0:07:34.12,0:07:36.83,Default,,0,0,0,,Біздің клуб мүшелерінің мұндай әрекетке баруы мүмкін емес.
Dialogue: 0,0:07:36.95,0:07:39.45,Default,,0,0,0,,Рождестволық Боулдың іріктеу кезеңі алда болса да.
Dialogue: 0,0:07:39.58,0:07:40.41,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:40.83,0:07:41.91,Default,,0,0,0,,Оқиға орын алса
Dialogue: 0,0:07:42.04,0:07:44.46,Default,,0,0,0,,Сізге мұндай турнирлерге қатысуға рұқсат берілмейді.
Dialogue: 0,0:07:44.58,0:07:46.38,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:07:46.50,0:07:47.71,Default,,0,0,0,,Ах~
Dialogue: 0,0:07:48.05,0:07:50.84,Default,,0,0,0,,Менің қатысым бар екенін білсеңіз...
Dialogue: 0,0:07:50.97,0:07:51.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:55.89,0:07:59.72,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:59.85,0:08:00.93,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:08:10.78,0:08:12.32,Default,,0,0,0,,
Dialogue: 0,0:08:13.53,0:08:14.82,Default,,0,0,0,,Тоқтау!
Dialogue: 0,0:08:14.95,0:08:18.62,Default,,0,0,0,,Deimon Devil Bats Christmas Bowl жеңімпазы!
Dialogue: 0,0:08:20.45,0:08:23.87,Default,,0,0,0,,(Жақындау)
Dialogue: 0,0:08:27.54,0:08:29.59,Default,,0,0,0,,Не! Жаңа ғана алған ақпарат бойынша
Dialogue: 0,0:08:29.71,0:08:33.67,Default,,0,0,0,,Курита өзінің зор күшін шетелдік туристерге шабуыл жасау үшін пайдаланады!
Dialogue: 0,0:08:33.80,0:08:37.55,Default,,0,0,0,,Тоқтатылған қылмыскерлерді ауруханаға жіберіп, сауда аймағын жойыңыз!
Dialogue: 0,0:08:37.68,0:08:39.89,Default,,0,0,0,,Ой... бұл өтірік!
Dialogue: 0,0:08:40.10,0:08:42.18,Default,,0,0,0,,Жеңістің жойылуы!
Dialogue: 0,0:08:42.31,0:08:45.35,Default,,0,0,0,,Осы уақытта Deimon Devil Bats таратылды!
Dialogue: 0,0:08:45.60,0:08:47.56,Default,,0,0,0,,Қауіпсіз ~ (Курита) Уау!
Dialogue: 0,0:08:48.06,0:08:50.53,Default,,0,0,0,,Тоқта~ Тоқта~
Dialogue: 0,0:08:50.90,0:08:52.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:52.65,0:08:55.95,Default,,0,0,0,,Мен кінәсізмін!
Dialogue: 0,0:08:57.24,0:08:59.37,Default,,0,0,0,,Жерді қорғау үшін ұшырылды!
Dialogue: 0,0:09:00.24,0:09:02.08,Default,,0,0,0,,Мен қашан өлетінімді білмеймін!
Dialogue: 0,0:09:02.75,0:09:05.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:05.67,0:09:06.83,Default,,0,0,0,,Мен!
Dialogue: 0,0:09:07.00,0:09:08.92,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:09:09.88,0:09:10.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:19.55,0:09:20.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:21.72,0:09:23.39,Default,,0,0,0,,Мен жұмыстан шығу туралы хабарлама алдым...
Dialogue: 0,0:09:24.10,0:09:26.48,Default,,0,0,0,,Мен өзімді тапсырғалы жатырмын.
Dialogue: 0,0:09:26.81,0:09:28.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:30.65,0:09:31.77,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:09:32.82,0:09:34.15,Default,,0,0,0,,Сонымен
Dialogue: 0,0:09:34.28,0:09:37.70,Default,,0,0,0,,Мен осы клубта болсам, бәріне қиындық тудырамын.
Dialogue: 0,0:09:37.82,0:09:40.45,Default,,0,0,0,,Өйткені мен Рождестволық шараға қатыса алмаймын.
Dialogue: 0,0:09:41.28,0:09:44.16,Default,,0,0,0,,Мен клубты тастап, сосын өзімді тапсыруды ойлап жүрмін...
Dialogue: 0,0:09:44.29,0:09:45.37,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,0:09:45.50,0:09:48.00,Default,,0,0,0,,Неліктен Курита-кун өзін тапсыруы керек?
Dialogue: 0,0:09:48.12,0:09:49.83,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:09:49.96,0:09:52.25,Default,,0,0,0,,Сол құқық бұзушылар кінәлі емес пе?
Dialogue: 0,0:09:52.38,0:09:53.25,Default,,0,0,0,,Фуго!
Dialogue: 0,0:09:53.38,0:09:56.09,Default,,0,0,0,,Бірақ неге жасырынып жүру керек?
Dialogue: 0,0:09:56.38,0:09:58.13,Default,,0,0,0,,Бірақ мұндай нәрсе
Dialogue: 0,0:09:58.26,0:10:01.10,Default,,0,0,0,,Айғақ беретін біреу болуы керек...
Dialogue: 0,0:10:01.97,0:10:03.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:04.93,0:10:08.39,Default,,0,0,0,,Мен болсам, Рождестволық ыдыс
Dialogue: 0,0:10:08.52,0:10:10.77,Default,,0,0,0,,Өйткені бәрі бас тартуы керек.
Dialogue: 0,0:10:11.11,0:10:11.94,Default,,0,0,0,,Сен
Dialogue: 0,0:10:12.06,0:10:12.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:13.48,0:10:16.19,Default,,0,0,0,,Егер сіз оны тоқтатқыңыз келсе, жай ғана тоқтатыңыз.
Dialogue: 0,0:10:16.32,0:10:17.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:17.74,0:10:20.62,Default,,0,0,0,,Дегенмен, тоқтасаң да, ауызыңды жап.
Dialogue: 0,0:10:20.87,0:10:23.12,Default,,0,0,0,,Егер сіз бізге қиындық тудырғыңыз келмесе.
Dialogue: 0,0:10:23.24,0:10:24.58,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:10:24.70,0:10:26.33,Default,,0,0,0,,Эй...эй, сүлгі!
Dialogue: 0,0:10:26.58,0:10:30.88,Default,,0,0,0,,Жалғыз куәгерлер Бутаман мен екі шетелдік әйел болды.
Dialogue: 0,0:10:31.00,0:10:35.17,Default,,0,0,0,,Оның үстіне естігенімше, ол әйел турист екен.
Dialogue: 0,0:10:35.30,0:10:37.80,Default,,0,0,0,,Қазір қайда кеткенін білмеймін.
Dialogue: 0,0:10:37.92,0:10:40.26,Default,,0,0,0,,Бірақ Курита-кун ештеңе істеген жоқ!
Dialogue: 0,0:10:40.38,0:10:42.55,Default,,0,0,0,,Айналаңызда қанша адам сіздің кінәсіз екеніңізді айтып жүрсе де
Dialogue: 0,0:10:42.68,0:10:45.93,Default,,0,0,0,,Нағыз кінәліні білмейінше, нәтиже бірдей болады.
Dialogue: 0,0:10:46.06,0:10:47.98,Default,,0,0,0,,Олай болса үндеме, жарай ма?
Dialogue: 0,0:10:48.43,0:10:51.69,Default,,0,0,0,,Мен... Жарайды, мен мұны істеймін.
Dialogue: 0,0:10:51.81,0:10:52.65,Default,,0,0,0,,Ах
Dialogue: 0,0:10:52.77,0:10:54.65,Default,,0,0,0,,Болды... былай!
Dialogue: 0,0:10:57.07,0:10:59.61,Default,,0,0,0,,Мен міндетті түрде Рождестволық ыдысқа барамын!
Dialogue: 0,0:10:59.74,0:11:02.28,Default,,0,0,0,,Не болса да, ешқашан!
Dialogue: 0,0:11:16.92,0:11:19.76,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:11:21.22,0:11:22.55,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:11:22.68,0:11:24.80,Default,,0,0,0,,Ах, Се... Сена-кун
Dialogue: 0,0:11:25.22,0:11:27.77,Default,,0,0,0,,Мен аздап уайымдап тұрмын.
Dialogue: 0,0:11:28.18,0:11:30.27,Default,,0,0,0,,(Жануарлар дүкенінің сатушысы) Хмм… Таныс итті өсірушімнен сұрайын ба?
Dialogue: 0,0:11:31.44,0:11:32.27,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:32.81,0:11:33.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:34.52,0:11:35.40,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:11:35.52,0:11:37.69,Default,,0,0,0,,А... бұл?
Dialogue: 0,0:11:38.28,0:11:40.15,Default,,0,0,0,,Американдық футбол клубы Мен оны жасаған кезде
Dialogue: 0,0:11:40.24,0:11:42.66,Default,,0,0,0,,Бірінші мүше жазған
Dialogue: 0,0:11:43.03,0:11:46.24,Default,,0,0,0,,«Абсолютті Рождестволық ыдыс»
Dialogue: 0,0:11:47.79,0:11:50.54,Default,,0,0,0,,Рождестволық ыдысқа міндетті түрде барыңыз
Dialogue: 0,0:11:51.16,0:11:52.62,Default,,0,0,0,,Бірінші жылдан бастап...
Dialogue: 0,0:11:52.75,0:11:54.38,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:11:54.50,0:11:56.00,Default,,0,0,0,,Мусаши деген кім?
Dialogue: 0,0:11:56.13,0:11:58.38,Default,,0,0,0,,А-а... қаншама оқиға болды.
Dialogue: 0,0:11:58.50,0:12:02.05,Default,,0,0,0,,Осыдан кейін мен сүлік жынмен оңаша қалдым...
Dialogue: 0,0:12:02.88,0:12:07.22,Default,,0,0,0,,Сіз шынымен бас тартасыз ба? Рождестволық ыдыс
Dialogue: 0,0:12:08.14,0:12:10.93,Default,,0,0,0,,Барлығы Рождестволық ыдысқа бара алса
Dialogue: 0,0:12:11.06,0:12:12.44,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:12:12.77,0:12:13.94,Default,,0,0,0,,Курита мырза...
Dialogue: 0,0:12:14.77,0:12:16.65,Default,,0,0,0,,Мен үйге барамын.
Dialogue: 0,0:12:16.77,0:12:17.65,Default,,0,0,0,,Курита мырза
Dialogue: 0,0:12:17.77,0:12:19.28,Default,,0,0,0,,Курита мырза!
Dialogue: 0,0:12:19.40,0:12:20.99,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:12:32.62,0:12:35.50,Default,,0,0,0,,Өйткені, біз нағыз кінәліні табуымыз керек!
Dialogue: 0,0:12:35.62,0:12:39.71,Default,,0,0,0,,Бірақ Хиру мырза айтқандай, егер біз нағыз кінәліні тапсақ та.
Dialogue: 0,0:12:39.84,0:12:42.38,Default,,0,0,0,,Сіз мойындамайынша шешілмейді...
Dialogue: 0,0:12:42.51,0:12:43.34,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:43.47,0:12:46.34,Default,,0,0,0,,Сондықтан мен Курита-санды осылай тастап кете алмаймын!
Dialogue: 0,0:12:46.55,0:12:47.39,Default,,0,0,0,,Фуго!
Dialogue: 0,0:12:47.51,0:12:50.26,Default,,0,0,0,,Иә! Мүмкін кінәлілер шығар.
Dialogue: 0,0:12:50.39,0:12:52.31,Default,,0,0,0,,Мүмкін сен маған шындықты айтарсың.
Dialogue: 0,0:12:52.43,0:12:53.27,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:53.39,0:12:54.77,Default,,0,0,0,,Кінәліге қарамастан.
Dialogue: 0,0:12:54.89,0:12:56.81,Default,,0,0,0,,Біз бұлай ештеңе істей алмаймыз.
Dialogue: 0,0:12:56.94,0:12:57.77,Default,,0,0,0,,Фугаго!
Dialogue: 0,0:12:57.90,0:12:58.73,Default,,0,0,0,,Олай болса
Dialogue: 0,0:12:58.86,0:13:01.69,Default,,0,0,0,,Біз қылмыскерді Курита-сан атап өткен бет-әлпетіне қарап іздейміз!
Dialogue: 0,0:13:01.82,0:13:04.03,Default,,0,0,0,,Екі топқа бөлініп тиімді ізденейік!
Dialogue: 0,0:13:04.15,0:13:04.99,Default,,0,0,0,,О!
Dialogue: 0,0:13:09.70,0:13:10.53,Default,,0,0,0,,Ха?
Dialogue: 0,0:13:10.66,0:13:11.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:11.62,0:13:12.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:12.91,0:13:14.75,Default,,0,0,0,,Сіз осындай суреті бар адамды іздеп жүрсіз бе?
Dialogue: 0,0:13:14.87,0:13:16.75,Default,,0,0,0,,Ібіліс жарғанаттарының дағдарысы
Dialogue: 0,0:13:16.87,0:13:18.04,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:13:18.21,0:13:19.46,Default,,0,0,0,,Ұнады!
Dialogue: 0,0:13:19.96,0:13:21.38,Default,,0,0,0,,Сонымен... қашан? (Монта) Ка~
Dialogue: 0,0:13:21.71,0:13:23.84,Default,,0,0,0,,Ол ақаулар туралы көп білетін сияқты болды, сондықтан мен одан бұл туралы сұрадым.
Dialogue: 0,0:13:23.96,0:13:24.80,Default,,0,0,0,,Әлі емес.
Dialogue: 0,0:13:25.17,0:13:26.68,Default,,0,0,0,,Біз білуге ​​мүмкіндік жоқ!
Dialogue: 0,0:13:26.80,0:13:27.93,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:13:28.05,0:13:29.01,Default,,0,0,0,,Сонда ол қашан таратылады?
Dialogue: 0,0:13:29.30,0:13:30.51,Default,,0,0,0,,Фуго!
Dialogue: 0,0:13:30.85,0:13:31.68,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:31.85,0:13:33.47,Default,,0,0,0,,Тоқта! (Монта) Сабыр сақта!
Dialogue: 0,0:13:37.98,0:13:39.02,Default,,0,0,0,,(Гүлп!)
Dialogue: 0,0:13:40.73,0:13:42.90,Default,,0,0,0,,Хмм? Не?
Dialogue: 0,0:13:43.44,0:13:44.74,Default,,0,0,0,,Қайтадан айтыңыз
Dialogue: 0,0:13:44.86,0:13:46.11,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:13:46.24,0:13:48.32,Default,,0,0,0,,3-компьютер станциясының айналасында (қозғалтқыштың үрлеу дыбысы)
Dialogue: 0,0:13:48.45,0:13:50.82,Default,,0,0,0,,Территорияны басып алған құқық бұзушылар
Dialogue: 0,0:13:52.16,0:13:53.87,Default,,0,0,0,,А, не?
Dialogue: 0,0:13:54.29,0:13:56.12,Default,,0,0,0,,Жоқ, сондықтан 3-ші көше...
Dialogue: 0,0:13:56.33,0:13:58.33,Default,,0,0,0,,Менің ойымша, сіз білмейсіз.
Dialogue: 0,0:13:58.46,0:13:59.63,Default,,0,0,0,,Тәртіп!
Dialogue: 0,0:13:59.75,0:14:03.00,Default,,0,0,0,,Айтшы дедім, тыңдамадың.
Dialogue: 0,0:14:03.13,0:14:06.09,Default,,0,0,0,,Балалар сендер тіпті білмейсіңдер~ Хахаха~
Dialogue: 0,0:14:06.47,0:14:09.09,Default,,0,0,0,,Мен білмеймін~ Хахаха~
Dialogue: 0,0:14:09.34,0:14:11.64,Default,,0,0,0,,Қымбаттым... Сіз мені танымайтын сияқтысыз.
Dialogue: 0,0:14:11.76,0:14:13.06,Default,,0,0,0,,Өтінемін (Монта) Эй!
Dialogue: 0,0:14:13.35,0:14:15.52,Default,,0,0,0,,Егер сіз бірдеңе білсеңіз, маған хабарлаңыз!
Dialogue: 0,0:14:15.77,0:14:16.81,Default,,0,0,0,,бетін таныған адамның атын жазсаң, сол адам өліп қалады деген дәптер екенін айтты
Dialogue: 0,0:14:17.10,0:14:20.10,Default,,0,0,0,,Мен Christmas Bowl іріктеу кезеңіне қатыса алмаймын.
Dialogue: 0,0:14:20.69,0:14:22.44,Default,,0,0,0,,Сіз білмеймін деп жатырсыз!
Dialogue: 0,0:14:22.73,0:14:24.65,Default,,0,0,0,,Қараңдар! Сена үйге қайтайық
Dialogue: 0,0:14:25.53,0:14:26.36,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:14:34.33,0:14:35.33,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:39.79,0:14:40.62,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:14:41.96,0:14:44.25,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:14:44.92,0:14:46.46,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:47.01,0:14:48.47,Default,,0,0,0,,Мен түйін таба алмай тұрған сияқтымын.
Dialogue: 0,0:14:48.59,0:14:49.43,Default,,0,0,0,,Фуго
Dialogue: 0,0:14:51.09,0:14:51.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:52.18,0:14:53.89,Default,,0,0,0,,Йодоймон
Dialogue: 0,0:14:54.56,0:14:55.85,Default,,0,0,0,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:14:58.56,0:14:59.39,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,0:14:59.94,0:15:01.35,Default,,0,0,0,,Сол аркадаға өтіңіз
Dialogue: 0,0:15:01.69,0:15:04.65,Default,,0,0,0,,3-ші көшені өз аумағы деп атайтын жігіттер қыдырып жүр.
Dialogue: 0,0:15:04.86,0:15:06.32,Default,,0,0,0,,Мүмкін сіз бірдеңені анықтай аласыз.
Dialogue: 0,0:15:07.32,0:15:08.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:08.90,0:15:10.82,Default,,0,0,0,,Ах... Рахмет!
Dialogue: 0,0:15:10.95,0:15:11.78,Default,,0,0,0,,Бакуго-кунға қарсы қандай жоспары барын сұрамақ едім.
Dialogue: 0,0:15:13.03,0:15:14.45,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:15:14.58,0:15:15.49,Default,,0,0,0,,Хмм?
Dialogue: 0,0:15:15.62,0:15:17.70,Default,,0,0,0,,Не... неге бұлай істеп жатырсың?
Dialogue: 0,0:15:17.95,0:15:21.42,Default,,0,0,0,,Сізді алаңда жаншып жатқан Оджоның Сусуму емес.
Dialogue: 0,0:15:21.54,0:15:24.17,Default,,0,0,0,,Бұл мен, Руи Хабашира.
Dialogue: 0,0:15:24.75,0:15:26.21,Default,,0,0,0,,Оны асыға күтіңіздер!
Dialogue: 0,0:15:26.34,0:15:27.92,Default,,0,0,0,,(қозғалтқыш дыбысы алыстап бара жатыр)
Dialogue: 0,0:15:28.05,0:15:29.17,Default,,0,0,0,,Хабашира мырза
Dialogue: 0,0:15:29.30,0:15:30.26,Default,,0,0,0,,Coo!
Dialogue: 0,0:15:30.38,0:15:33.26,Default,,0,0,0,,Ерлердің достығы максимум! Жанып жатыр!
Dialogue: 0,0:15:34.93,0:15:39.10,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:15:39.64,0:15:42.10,Default,,0,0,0,,Ах... (Монта) Бұл олар.
Dialogue: 0,0:15:43.02,0:15:45.23,Default,,0,0,0,,Курита мырза айтқан физиогномияға өте ыңғайлы.
Dialogue: 0,0:15:45.36,0:15:48.40,Default,,0,0,0,,Жарайды... Жарайды, кеттік, тыныш...
Dialogue: 0,0:15:48.53,0:15:49.49,Default,,0,0,0,,Фуго~ (Монта) иә~?
Dialogue: 0,0:15:49.74,0:15:51.95,Default,,0,0,0,,Эй... Эй, эй!
Dialogue: 0,0:15:52.07,0:15:53.70,Default,,0,0,0,,Бар, жүр! (2-ақау) Бұл жолы!
Dialogue: 0,0:15:53.82,0:15:55.03,Default,,0,0,0,,Фуго!
Dialogue: 0,0:15:55.57,0:15:56.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:56.58,0:15:57.41,Default,,0,0,0,,Unu~
Dialogue: 0,0:15:57.87,0:16:01.25,Default,,0,0,0,,Сауда көшесі! Мен бұздым! Сіз жігіттер!
Dialogue: 0,0:16:01.37,0:16:03.37,Default,,0,0,0,,Ұстаз! Жалған киім!
Dialogue: 0,0:16:03.58,0:16:04.42,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:16:04.54,0:16:05.88,Default,,0,0,0,,Сіз кенеттен ұрысып қалдыңыз!
Dialogue: 0,0:16:06.29,0:16:07.13,Default,,0,0,0,,Фуго!
Dialogue: 0,0:16:09.59,0:16:11.30,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:16:11.42,0:16:12.34,Default,,0,0,0,,Күтіңіз~
Dialogue: 0,0:16:12.47,0:16:13.30,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:13.43,0:16:14.55,Default,,0,0,0,,Саған қашып кетуге рұқсат етемін бе?
Dialogue: 0,0:16:14.68,0:16:15.89,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:16:16.01,0:16:19.43,Default,,0,0,0,,Неліктен бұл орын алады?
Dialogue: 0,0:16:20.27,0:16:22.39,Default,,0,0,0,,Маған көмектесіңіз~
Dialogue: 0,0:16:22.52,0:16:23.35,Default,,0,0,0,,Ха?
Dialogue: 0,0:16:23.48,0:16:24.48,Default,,0,0,0,,Иә? (Куроки) Иә?
Dialogue: 0,0:16:24.60,0:16:26.40,Default,,0,0,0,,Маған көмектесіңдер~ (Джумонджи) Балалар не істеп жатырсыңдар?
Dialogue: 0,0:16:26.52,0:16:27.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:27.56,0:16:29.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:29.65,0:16:30.48,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:30.90,0:16:33.74,Default,,0,0,0,,Сіз қалай батылсыз! Бұл билеп жатқан балалар кім?
Dialogue: 0,0:16:33.95,0:16:34.78,Default,,0,0,0,,Ха?
Dialogue: 0,0:16:34.91,0:16:35.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:35.86,0:16:37.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:37.24,0:16:39.99,Default,,0,0,0,,Не айтып тұрсың, түсінбедім?
Dialogue: 0,0:16:43.21,0:16:45.83,Default,,0,0,0,,Үстелдер айналды! 6-дан 3-ке дейін!
Dialogue: 0,0:16:45.96,0:16:48.96,Default,,0,0,0,,Балалар, сауда ауданындағы әшекейлерді қираттыңдар, солай ма?
Dialogue: 0,0:16:49.38,0:16:50.21,Default,,0,0,0,,Хаа
Dialogue: 0,0:16:50.34,0:16:51.51,Default,,0,0,0,,Жаса!
Dialogue: 0,0:16:52.01,0:16:53.84,Default,,0,0,0,,Қашу~
Dialogue: 0,0:16:54.13,0:16:55.30,Default,,0,0,0,,Мен сені қуамын! иә!
Dialogue: 0,0:16:59.93,0:17:00.85,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:17:01.31,0:17:03.31,Default,,0,0,0,,Бітім, олар сондай табанды!
Dialogue: 0,0:17:03.48,0:17:04.31,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:17:04.44,0:17:05.27,Default,,0,0,0,,Фуго!
Dialogue: 0,0:17:07.69,0:17:09.02,Default,,0,0,0,,Мына жігіттер?
Dialogue: 0,0:17:10.02,0:17:11.94,Default,,0,0,0,,Мен сені ешқашан қашып кетуге жол бермеймін!
Dialogue: 0,0:17:12.19,0:17:14.40,Default,,0,0,0,,Бұл не? Бұл шынымен жылдам.
Dialogue: 0,0:17:15.61,0:17:16.53,Default,,0,0,0,,Тіпті бұл
Dialogue: 0,0:17:16.66,0:17:18.20,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:17:18.32,0:17:19.41,Default,,0,0,0,,Уау! қауіпті!
Dialogue: 0,0:17:19.53,0:17:20.87,Default,,0,0,0,,Максималды ұстаңыз!
Dialogue: 0,0:17:21.41,0:17:23.33,Default,,0,0,0,,Тамағыңызды күтіңіз!
Dialogue: 0,0:17:23.91,0:17:24.79,Default,,0,0,0,,Біз сыпайымыз.
Dialogue: 0,0:17:24.91,0:17:25.75,Default,,0,0,0,,Фуго~
Dialogue: 0,0:17:25.96,0:17:27.75,Default,,0,0,0,,Әй, бұл не деген!
Dialogue: 0,0:17:29.71,0:17:30.88,Default,,0,0,0,,Қуып жету
Dialogue: 0,0:17:31.00,0:17:33.42,Default,,0,0,0,,Курита мырза... Ібіліс жарғанақтары үшін!
Dialogue: 0,0:17:34.59,0:17:38.43,Default,,0,0,0,,40 ярд, 45 градусқа оңға тию пасы
Dialogue: 0,0:17:40.64,0:17:42.85,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:17:45.68,0:17:47.90,Default,,0,0,0,,Уау! О~
Dialogue: 0,0:17:48.19,0:17:50.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:50.69,0:17:51.57,Default,,0,0,0,,Уф
Dialogue: 0,0:17:51.69,0:17:52.52,Default,,0,0,0,,Уау~
Dialogue: 0,0:17:52.65,0:17:53.48,Default,,0,0,0,,Жарайды~
Dialogue: 0,0:17:53.78,0:17:54.61,Default,,0,0,0,,Тет
Dialogue: 0,0:17:54.74,0:17:56.90,Default,,0,0,0,,Мен сенің енді қашуыңа жол бермеймін, а?
Dialogue: 0,0:17:57.03,0:17:59.24,Default,,0,0,0,,Иә~ Сіз де!
Dialogue: 0,0:17:59.36,0:18:00.87,Default,,0,0,0,,Фуго!
Dialogue: 0,0:18:00.99,0:18:02.41,Default,,0,0,0,,Дохья!
Dialogue: 0,0:18:03.91,0:18:04.75,Default,,0,0,0,,Хун
Dialogue: 0,0:18:05.37,0:18:07.25,Default,,0,0,0,,Сіз не істеп жатырсыз? Асықшы!
Dialogue: 0,0:18:07.37,0:18:10.42,Default,,0,0,0,,Бірақ... Бірақ мен барсам да...
Dialogue: 0,0:18:10.54,0:18:11.38,Default,,0,0,0,,Алға!
Dialogue: 0,0:18:11.50,0:18:13.09,Default,,0,0,0,,Өзіңізге қамқорлық жасамаңыз! Буман!
Dialogue: 0,0:18:13.50,0:18:15.05,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:18:15.17,0:18:16.51,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:16.63,0:18:18.01,Default,,0,0,0,,Аа, Курита мырза
Dialogue: 0,0:18:18.18,0:18:19.22,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:18:19.34,0:18:21.51,Default,,0,0,0,,Мен үшін рахмет
Dialogue: 0,0:18:21.85,0:18:23.72,Default,,0,0,0,,Бұлар кінәлі, солай ма?
Dialogue: 0,0:18:23.97,0:18:25.52,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:18:25.64,0:18:29.10,Default,,0,0,0,,Бұл сендерсіңдер, солай ма? Сауда көшесін бұзған адам
Dialogue: 0,0:18:29.23,0:18:30.56,Default,,0,0,0,,Маған шындықты айт
Dialogue: 0,0:18:30.69,0:18:32.11,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,0:18:32.23,0:18:33.27,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:18:33.40,0:18:34.90,Default,,0,0,0,,Куәгерлер бар ма?
Dialogue: 0,0:18:35.03,0:18:35.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:36.19,0:18:37.65,Default,,0,0,0,,Куәгерлер бар.
Dialogue: 0,0:18:37.78,0:18:38.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:38.95,0:18:40.61,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:18:40.74,0:18:42.16,Default,,0,0,0,,Конохитачи!
Dialogue: 0,0:18:42.28,0:18:43.62,Default,,0,0,0,,Kowashitane дисплейі
Dialogue: 0,0:18:43.91,0:18:45.95,Default,,0,0,0,,Не! Сіз бе?
Dialogue: 0,0:18:46.08,0:18:47.29,Default,,0,0,0,,Сіз әшекейлерді жойдыңыз ба?
Dialogue: 0,0:18:47.41,0:18:48.79,Default,,0,0,0,,Тохохо~
Dialogue: 0,0:18:48.91,0:18:50.29,Default,,0,0,0,,Цука Кешіріңіз.
Dialogue: 0,0:18:50.62,0:18:53.00,Default,,0,0,0,,Шыққан бойда бірден шыға ма? Түзет, түзет!
Dialogue: 0,0:18:53.13,0:18:54.50,Default,,0,0,0,,Қандай тыныш
Dialogue: 0,0:18:54.84,0:18:57.38,Default,,0,0,0,,Иә! Курита мырзаның күдігі жойылды!
Dialogue: 0,0:18:57.51,0:18:58.76,Default,,0,0,0,,Макс - ең жақсы!
Dialogue: 0,0:18:58.88,0:18:59.72,Default,,0,0,0,,Фуго~
Dialogue: 0,0:19:00.22,0:19:02.09,Default,,0,0,0,,А, бұл дегеніміз...
Dialogue: 0,0:19:02.22,0:19:03.39,Default,,0,0,0,,Мен де барлығымен біргемін
Dialogue: 0,0:19:03.89,0:19:04.85,Default,,0,0,0,,Рождестволық ыдыста
Dialogue: 0,0:19:04.97,0:19:05.81,Default,,0,0,0,,Тура алға!
Dialogue: 0,0:19:05.93,0:19:07.10,Default,,0,0,0,,Фугаго~!
Dialogue: 0,0:19:07.22,0:19:10.56,Default,,0,0,0,,О! Рождестволық ыдыс О!
Dialogue: 0,0:19:10.69,0:19:12.98,Default,,0,0,0,,Рождестволық ыдыс О!
Dialogue: 0,0:19:13.11,0:19:14.15,Default,,0,0,0,,Рождестволық ыдыс…
Dialogue: 0,0:19:14.40,0:19:15.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:15.82,0:19:17.44,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:19:18.99,0:19:20.78,Default,,0,0,0,,Ол кісілер кеше жолдан шығып кетті
Dialogue: 0,0:19:20.90,0:19:23.03,Default,,0,0,0,,Сонымен, сіз Нью-Йорктен оралдыңыз ба?
Dialogue: 0,0:19:23.24,0:19:25.70,Default,,0,0,0,,Бірақ неге қайтып келдің?
Dialogue: 0,0:19:25.83,0:19:26.66,Default,,0,0,0,,Кел (Монта) Муки!
Dialogue: 0,0:19:26.79,0:19:27.74,Default,,0,0,0,,Бостандық мүсіні
Dialogue: 0,0:19:27.87,0:19:29.37,Default,,0,0,0,,Сіз бірдеңе алып бара жатқан сияқтысыз.
Dialogue: 0,0:19:29.50,0:19:31.00,Default,,0,0,0,,Камера, тоқтаңыз.
Dialogue: 0,0:19:31.58,0:19:35.67,Default,,0,0,0,,«Деймон Ібіліс жарғанаттары мүшелерді жинап жатыр»?
Dialogue: 0,0:19:36.46,0:19:37.96,Default,,0,0,0,,Ол сүлік жын.
Dialogue: 0,0:19:38.09,0:19:44.09,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:46.24,0:20:52.25,Default,,0,0,0,,~♪
Dialogue: 0,0:20:53.87,0:20:58.42,Default,,0,0,0,,Іс шешілгеннен кейін якинику тойын өткізу әзіл емес пе?
Dialogue: 0,0:20:58.54,0:20:59.63,Default,,0,0,0,,Сүлік жын үндемейді.
Dialogue: 0,0:20:59.75,0:21:02.26,Default,,0,0,0,,Олар маған ет жеуге мүмкіндік бермейді.
Dialogue: 0,0:21:02.38,0:21:03.63,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:03.76,0:21:06.05,Default,,0,0,0,,Не? Ішке секірген екі адам ше?
Dialogue: 0,0:21:06.34,0:21:08.60,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:11.47,0:21:12.64,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:14.14,0:21:20.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory