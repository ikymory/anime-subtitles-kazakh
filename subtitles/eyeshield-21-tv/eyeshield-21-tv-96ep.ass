Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.96,0:00:04.83,Default,,0,0,0,,
Dialogue: 0,0:00:05.83,0:00:07.29,Default,,0,0,0,,Ібіліс шайтандары⸺
Dialogue: 0,0:00:07.84,0:00:11.88,Default,,0,0,0,,Америка Құрама Штаттарында өткен американдық футболдан халықаралық жолдастық кездесу
Dialogue: 0,0:00:11.97,0:00:15.59,Default,,0,0,0,,Мен «Крем пуф» кубогын жеңіп алып, үйге аман-есен оралдым.
Dialogue: 0,0:00:16.51,0:00:18.64,Default,,0,0,0,,Бүгін демалыс күні.
Dialogue: 0,0:00:19.35,0:00:23.77,Default,,0,0,0,,Әркім өз үйінде шаршаған денелерін демалып жатыр.
Dialogue: 0,0:00:24.81,0:00:27.52,Default,,0,0,0,,Күшті қарсыластарға толы Канто турнирі алдында⸺
Dialogue: 0,0:00:27.61,0:00:30.28,Default,,0,0,0,,Қуатыңызды баяу қоректендіру
Dialogue: 0,0:00:30.73,0:00:31.78,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:00:32.82,0:00:34.57,Default,,0,0,0,,Ахх...
Dialogue: 0,0:00:34.65,0:00:36.24,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:00:36.32,0:00:38.53,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:00:39.20,0:00:43.12,Default,,0,0,0,,Уау... қазірдің өзінде! Егер сіз төбедегі жын болсаңыз!
Dialogue: 0,0:00:43.20,0:00:44.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:47.04,0:00:48.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:49.04,0:00:54.05,Default,,0,0,0,,♪~
Dialogue: 0,0:02:04.04,0:02:09.04,Default,,0,0,0,,~♪
Dialogue: 0,0:02:18.26,0:02:21.34,Default,,0,0,0,,Өлім наурызы Өлімге шығу да қиын болды.
Dialogue: 0,0:02:21.43,0:02:25.35,Default,,0,0,0,,Күткендей, Токио ойындарынан естеліктер көп.
Dialogue: 0,0:02:25.43,0:02:28.69,Default,,0,0,0,,Сол азапты шайқас әлі есімде
Dialogue: 0,0:02:28.77,0:02:29.60,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:02:30.31,0:02:34.61,Default,,0,0,0,,Ойлап қарасам, Сенна бұл кезде шынымен сенімсіз еді.
Dialogue: 0,0:02:35.57,0:02:39.74,Default,,0,0,0,,Бірақ бұл Сенна Көзқалқан-кун болатын.
Dialogue: 0,0:02:39.82,0:02:42.07,Default,,0,0,0,,Мен бұған сене алар емеспін
Dialogue: 0,0:02:46.95,0:02:48.91,Default,,0,0,0,,Токио турнирінің алғашқы ойыны⸺
Dialogue: 0,0:02:49.00,0:02:53.38,Default,,0,0,0,,Біз денемізді спорттық медицина негізінде құрастыру арқылы күшті команда құрдық⸺
Dialogue: 0,0:02:53.46,0:02:55.25,Default,,0,0,0,,«Амин киборгтары»
Dialogue: 0,0:03:01.97,0:03:04.47,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:03:09.27,0:03:10.81,Default,,0,0,0,,Ах… Мен оларды бір сәтке де ұмытқан емеспін.
Dialogue: 0,0:03:11.39,0:03:14.27,Default,,0,0,0,,Юхи Гуц~!
Dialogue: 0,0:03:14.81,0:03:18.69,Default,,0,0,0,,Ал екінші ойын – «Юхи Гуц»
Dialogue: 0,0:03:23.78,0:03:24.95,Default,,0,0,0,,Атами-сан!
Dialogue: 0,0:03:25.03,0:03:27.87,Default,,0,0,0,,Бұл ойын, Eyeshield 21!
Dialogue: 0,0:03:27.95,0:03:29.95,Default,,0,0,0,,Мен өзімнің үш жылымды жолға қойдым!
Dialogue: 0,0:03:31.66,0:03:33.54,Default,,0,0,0,,О!
Dialogue: 0,0:03:35.88,0:03:38.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:42.38,0:03:45.30,Default,,0,0,0,,Бұл нағыз көлік жүргізу...
Dialogue: 0,0:03:48.85,0:03:54.23,Default,,0,0,0,,(Ойыншылар қолдайды)
Dialogue: 0,0:03:55.56,0:03:58.48,Default,,0,0,0,,Сюжет құруға шебер Канекүши мырза жетекшілік етеді⸺
Dialogue: 0,0:03:58.57,0:04:00.36,Default,,0,0,0,,Неміс Скорпиондарына қарсы ойында⸺
Dialogue: 0,0:04:00.78,0:04:04.24,Default,,0,0,0,,Мен Хилл Демон-кунсыз не болар екен деп ойладым.
Dialogue: 0,0:04:06.20,0:04:10.29,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:04:14.79,0:04:16.38,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:18.71,0:04:19.92,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:04:26.93,0:04:29.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:31.22,0:04:32.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:36.27,0:04:37.31,Default,,0,0,0,,Поцелу!
Dialogue: 0,0:04:46.20,0:04:47.53,Default,,0,0,0,,
Dialogue: 0,0:04:47.62,0:04:49.03,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:04:49.12,0:04:51.08,Default,,0,0,0,,Кишо!
Dialogue: 0,0:04:51.16,0:04:53.16,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:53.25,0:04:55.08,Default,,0,0,0,,Иә! (Комусуби) Фуго!
Dialogue: 0,0:04:55.67,0:04:59.13,Default,,0,0,0,,Мұнда тек ыстық болады.
Dialogue: 0,0:04:59.21,0:05:02.63,Default,,0,0,0,,Жылы жүрек, салқын бас
Dialogue: 0,0:05:02.71,0:05:04.59,Default,,0,0,0,,Бұл американдық футбол
Dialogue: 0,0:05:05.38,0:05:08.80,Default,,0,0,0,,Енді Деймон үздік 8-ге көтеріледі
Dialogue: 0,0:05:10.39,0:05:14.52,Default,,0,0,0,,Сенна бір ойында күшейе түсті.
Dialogue: 0,0:05:22.44,0:05:24.69,Default,,0,0,0,,Бұған жол берме! Ааа!
Dialogue: 0,0:05:25.28,0:05:27.78,Default,,0,0,0,,Ах! Уф!
Dialogue: 0,0:05:28.28,0:05:30.74,Default,,0,0,0,,Үздік төрттікке өту үшін қарсыластар кімдер?
Dialogue: 0,0:05:30.83,0:05:34.62,Default,,0,0,0,,Үлкен ойыншылары бар теңіз құдайы «Алып Посейдон».
Dialogue: 0,0:05:34.70,0:05:37.62,Default,,0,0,0,,Матч алға-артқа жүріп жатты.
Dialogue: 0,0:05:37.71,0:05:39.21,Default,,0,0,0,,Ннн!
Dialogue: 0,0:05:43.09,0:05:45.09,Default,,0,0,0,,Сіз ешқашан жоғалта алмайсыз!
Dialogue: 0,0:05:45.51,0:05:46.76,Default,,0,0,0,,Бұл босқа!
Dialogue: 0,0:05:47.80,0:05:49.89,Default,,0,0,0,,Моби Дик Анкор!
Dialogue: 0,0:05:49.97,0:05:51.26,Default,,0,0,0,,Оны тартып алыңыз!
Dialogue: 0,0:05:52.14,0:05:53.51,Default,,0,0,0,,Мен сені жібермеймін!
Dialogue: 0,0:05:54.60,0:05:56.35,Default,,0,0,0,,Түсірілді! Ол аяқтады!
Dialogue: 0,0:05:56.43,0:05:57.31,Default,,0,0,0,,Оны тартып алыңыз!
Dialogue: 0,0:06:02.32,0:06:05.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:08.78,0:06:11.16,Default,,0,0,0,,Иә! Бұл жанасу!
Dialogue: 0,0:06:11.24,0:06:14.16,Default,,0,0,0,,Мен жартылай финалға шыға аламын! Жартылай финал...
Dialogue: 0,0:06:14.24,0:06:17.12,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:06:17.71,0:06:20.58,Default,,0,0,0,,Мені жіберме!
Dialogue: 0,0:06:21.42,0:06:22.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:33.60,0:06:35.06,Default,,0,0,0,,
Dialogue: 0,0:06:35.14,0:06:36.85,Default,,0,0,0,,Сағатты тоқтатыңыз!
Dialogue: 0,0:06:36.93,0:06:38.81,Default,,0,0,0,,Уақыт бітті!
Dialogue: 0,0:06:38.89,0:06:40.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:40.31,0:06:44.02,Default,,0,0,0,,Мизумачидің табандылығы Сеннаның қонуына жол бермеді!
Dialogue: 0,0:06:45.23,0:06:46.94,Default,,0,0,0,,30 см қалды
Dialogue: 0,0:06:47.03,0:06:49.45,Default,,0,0,0,,30 сантиметр қалғанда шабуыл және қорғаныс
Dialogue: 0,0:06:49.53,0:06:52.45,Default,,0,0,0,,Ал жеңісті... шешті.
Dialogue: 0,0:06:52.53,0:06:54.20,Default,,0,0,0,,Жүрек!
Dialogue: 0,0:07:00.21,0:07:01.71,Default,,0,0,0,,Мен оның үстінен секірдім!
Dialogue: 0,0:07:04.09,0:07:06.71,Default,,0,0,0,,Ах! (Мидзумачи) Керемет...
Dialogue: 0,0:07:06.80,0:07:12.80,Default,,0,0,0,,♬~
Dialogue: 0,0:07:14.39,0:07:16.26,Default,,0,0,0,,А... а...
Dialogue: 0,0:07:18.56,0:07:19.85,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:22.77,0:07:24.06,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:07:24.15,0:07:25.40,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:07:25.48,0:07:26.82,Default,,0,0,0,,Гюго!
Dialogue: 0,0:07:28.28,0:07:29.49,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:30.70,0:07:33.24,Default,,0,0,0,,Фуго!
Dialogue: 0,0:07:34.91,0:07:36.95,Default,,0,0,0,,Шағын қорытынды…
Dialogue: 0,0:07:37.49,0:07:38.49,Default,,0,0,0,,Гуааа…
Dialogue: 0,0:07:38.58,0:07:40.71,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:07:40.79,0:07:44.92,Default,,0,0,0,,2 секунд қалды, Deimon Devil Bats жеңу үшін арттан келеді!
Dialogue: 0,0:07:45.00,0:07:47.55,Default,,0,0,0,,Я-Ха-! (мылтық дыбысы)
Dialogue: 0,0:07:48.46,0:07:51.97,Default,,0,0,0,,Жеңімпаз болса, артында жеңілгендер бар.
Dialogue: 0,0:07:52.38,0:07:54.43,Default,,0,0,0,,Бұл болмай қоймайтын тағдыр⸺
Dialogue: 0,0:07:55.05,0:07:56.35,Default,,0,0,0,,Жеңіске жеткендер⸺
Dialogue: 0,0:07:56.43,0:08:00.43,Default,,0,0,0,,Біз жоғалтқандардың жалынды жүректерін мұра етуіміз керек.
Dialogue: 0,0:08:01.27,0:08:04.73,Default,,0,0,0,,Менің ойымша, бұл Сеннаға ауыр жеткізілді.
Dialogue: 0,0:08:06.02,0:08:07.48,Default,,0,0,0,,Ал мені таң қалдырғаны –⸺
Dialogue: 0,0:08:08.15,0:08:12.78,Default,,0,0,0,,Сенна екеуміздің бала кезден дос болған Рику-кун жартылай финалдағы қарсыласымыз болады.
Dialogue: 0,0:08:12.86,0:08:15.70,Default,,0,0,0,,Ол Western Wild Gunmans командасының ойыншысы болды.
Dialogue: 0,0:08:16.20,0:08:18.78,Default,,0,0,0,,Кел, Eyeshield 21, жарыл!
Dialogue: 0,0:08:18.87,0:08:20.16,Default,,0,0,0,,Тез! тез!
Dialogue: 0,0:08:20.24,0:08:22.58,Default,,0,0,0,,Бұл жылдамдықпен тию болады ма? ?
Dialogue: 0,0:08:22.66,0:08:23.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:25.88,0:08:27.04,Default,,0,0,0,,Кел, Сена!
Dialogue: 0,0:08:27.50,0:08:29.50,Default,,0,0,0,,Рикуды жеңіңіз
Dialogue: 0,0:08:29.59,0:08:32.22,Default,,0,0,0,,Мен Сенадан жеңіле алмаймын!
Dialogue: 0,0:08:35.30,0:08:36.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:36.64,0:08:38.76,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:08:38.85,0:08:40.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:40.72,0:08:42.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:42.73,0:08:45.02,Default,,0,0,0,,Ах! (Санада) Бұл тоқтатылды!
Dialogue: 0,0:08:46.40,0:08:49.02,Default,,0,0,0,,Сенна оның жүгіру шебері Рикукунға⸺
Dialogue: 0,0:08:49.11,0:08:52.07,Default,,0,0,0,,Қайта-қайта ұрыстым.
Dialogue: 0,0:08:52.15,0:08:52.99,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:08:58.24,0:08:59.58,Default,,0,0,0,,Бұл жолы!
Dialogue: 0,0:09:04.50,0:09:06.96,Default,,0,0,0,,Міне! Мұнда қашыңыз!
Dialogue: 0,0:09:08.17,0:09:09.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:11.00,0:09:12.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:13.17,0:09:14.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:15.68,0:09:17.80,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:18.18,0:09:19.51,Default,,0,0,0,,Ннн!
Dialogue: 0,0:09:20.47,0:09:23.06,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:09:23.52,0:09:26.85,Default,,0,0,0,,Тіпті «Ібіліс жарғанаты» дауылы да жұмыс істемейді...
Dialogue: 0,0:09:28.44,0:09:31.15,Default,,0,0,0,,Еркексің, жоғары қара.
Dialogue: 0,0:09:33.19,0:09:34.24,Default,,0,0,0,,Рику…
Dialogue: 0,0:09:34.32,0:09:36.32,Default,,0,0,0,,Батыстың басымдылығы
Dialogue: 0,0:09:36.40,0:09:41.03,Default,,0,0,0,,Ал Сенаны Рикукун толығымен басып қалды.
Dialogue: 0,0:09:43.08,0:09:44.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:45.37,0:09:46.75,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 0,0:09:46.83,0:09:49.58,Default,,0,0,0,,Сенің байсалды жүзің не болды? Мама әпке
Dialogue: 0,0:09:49.67,0:09:51.29,Default,,0,0,0,,Сузунэ-чан
Dialogue: 0,0:09:51.38,0:09:53.30,Default,,0,0,0,,Иә? альбом?
Dialogue: 0,0:09:56.67,0:09:59.05,Default,,0,0,0,,Сәлем! Киддон!
Dialogue: 0,0:09:59.14,0:10:02.60,Default,,0,0,0,,Батыстың халқы шынында да күшті болған емес пе?
Dialogue: 0,0:10:03.18,0:10:04.31,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:10:05.43,0:10:06.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:09.27,0:10:11.61,Default,,0,0,0,,Мистер Кидд, о
Dialogue: 0,0:10:12.32,0:10:14.07,Default,,0,0,0,,Сіз әрқашан осылай айтасыз, солай ма?
Dialogue: 0,0:10:14.15,0:10:16.49,Default,,0,0,0,,Тым жақсы жаман болуы мүмкін
Dialogue: 0,0:10:16.57,0:10:18.99,Default,,0,0,0,,Бұл туралы бірдеңе бар.
Dialogue: 0,0:10:20.87,0:10:22.58,Default,,0,0,0,,Бала – данышпан
Dialogue: 0,0:10:22.66,0:10:25.04,Default,,0,0,0,,Барлық өту түрлерінің сәттілігі туралы⸺
Dialogue: 0,0:10:25.12,0:10:28.66,Default,,0,0,0,,Ол міндетті түрде интуитивті түрде түсінеді.
Dialogue: 0,0:10:28.75,0:10:30.88,Default,,0,0,0,,Сондықтан оны оқуға болады
Dialogue: 0,0:10:30.96,0:10:34.55,Default,,0,0,0,,Уақыт неғұрлым көп болса, соғұрлым ұтасыз⸺
Dialogue: 0,0:10:34.63,0:10:37.84,Default,,0,0,0,,Іс жүзінде шабуылдар ауқымы тарылып келеді.
Dialogue: 0,0:10:39.22,0:10:43.18,Default,,0,0,0,,Бұл менде басынан бері жалғыз мүмкіндік болды!
Dialogue: 0,0:10:43.26,0:10:45.47,Default,,0,0,0,,Кеттік! Оу!
Dialogue: 0,0:10:55.69,0:10:57.07,Default,,0,0,0,,Ннн!
Dialogue: 0,0:10:59.36,0:11:01.74,Default,,0,0,0,,Ал, қарғыс атқыр маймыл!
Dialogue: 0,0:11:02.11,0:11:05.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:06.04,0:11:09.66,Default,,0,0,0,,А, мен оның оқылып жатқанын білдім.
Dialogue: 0,0:11:12.08,0:11:13.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:13.38,0:11:16.25,Default,,0,0,0,,Не! ? Қолды төмен лақтыратын өте жылдам от!
Dialogue: 0,0:11:21.22,0:11:22.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:22.22,0:11:24.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:24.93,0:11:25.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:27.10,0:11:28.39,Default,,0,0,0,,Темір тұлпар!
Dialogue: 0,0:11:28.47,0:11:31.89,Default,,0,0,0,,Әу бастан ұстағаным доп емес еді!
Dialogue: 0,0:11:31.98,0:11:32.85,Default,,0,0,0,,Не! ?
Dialogue: 0,0:11:32.94,0:11:36.86,Default,,0,0,0,,Бұл сіздің жеңілмейтін оң қолыңыздың саусақтары.
Dialogue: 0,0:11:36.94,0:11:37.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:42.28,0:11:46.12,Default,,0,0,0,,Міне! Қабақ қалқаны 21!
Dialogue: 0,0:11:46.20,0:11:48.37,Default,,0,0,0,,Балалар мен Тецууманың жылдам және өрті⸺
Dialogue: 0,0:11:48.45,0:11:51.37,Default,,0,0,0,,Ақыры ұсталды!
Dialogue: 0,0:11:51.46,0:11:53.75,Default,,0,0,0,,Бұл жанасу болады ма?
Dialogue: 0,0:11:54.29,0:11:56.88,Default,,0,0,0,,Ннн! Сенна!
Dialogue: 0,0:11:56.96,0:11:58.05,Default,,0,0,0,,Рику!
Dialogue: 0,0:11:59.88,0:12:00.92,Default,,0,0,0,,Кел, Сена!
Dialogue: 0,0:12:01.01,0:12:04.89,Default,,0,0,0,,Мен сізге жарықтың ең жылдам родео дискісін көрсетемін!
Dialogue: 0,0:12:04.97,0:12:07.05,Default,,0,0,0,,100-ші шайқас аяқталды.
Dialogue: 0,0:12:07.43,0:12:09.77,Default,,0,0,0,,Рикуды жеңіңіз
Dialogue: 0,0:12:09.85,0:12:12.02,Default,,0,0,0,,Әрқашан жүгіруші ұстазым болған Рикуға...
Dialogue: 0,0:12:12.10,0:12:14.40,Default,,0,0,0,,Eyeshield де, Кайтани де жылдам!
Dialogue: 0,0:12:20.78,0:12:21.82,Default,,0,0,0,,ұстап алды
Dialogue: 0,0:12:21.90,0:12:24.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:24.66,0:12:28.45,Default,,0,0,0,,Мен жеңгім келеді. Мен жеңуім керек.
Dialogue: 0,0:12:28.53,0:12:31.41,Default,,0,0,0,,Жалтармаңыз. Сіздің денеңіз допқа арналған.
Dialogue: 0,0:12:32.16,0:12:34.42,Default,,0,0,0,,Оны өзіңіз толық жылдамдықпен ұрыңыз!
Dialogue: 0,0:12:35.37,0:12:37.38,Default,,0,0,0,,Денеңізді левередж ретінде пайдаланыңыз...
Dialogue: 0,0:12:37.46,0:12:38.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:39.17,0:12:40.92,Default,,0,0,0,,Ібіліс жарғанатының дауылы...
Dialogue: 0,0:12:41.01,0:12:42.13,Default,,0,0,0,,Ах…
Dialogue: 0,0:12:42.21,0:12:44.30,Default,,0,0,0,,Хмм... артқа итеріңіз!
Dialogue: 0,0:12:45.43,0:12:46.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:46.34,0:12:47.51,Default,,0,0,0,,Сенна…
Dialogue: 0,0:12:50.51,0:12:52.10,Default,,0,0,0,,Біздің 100-ші шайқас...
Dialogue: 0,0:13:00.90,0:13:02.57,Default,,0,0,0,,Джосуке Хигашиката!
Dialogue: 0,0:13:06.36,0:13:09.45,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:13:09.78,0:13:11.83,Default,,0,0,0,,Кук… нг…
Dialogue: 0,0:13:12.66,0:13:16.04,Default,,0,0,0,,Мұз! Мұзды! Мұзды! Мұзды!
Dialogue: 0,0:13:16.87,0:13:19.25,Default,,0,0,0,,Ммм... Нмм...
Dialogue: 0,0:13:20.04,0:13:24.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:25.05,0:13:26.47,Default,,0,0,0,,Сеннаның соққысы⸺
Dialogue: 0,0:13:26.55,0:13:28.14,Default,,0,0,0,,Біз 3 ұпайлық айырмашылыққа жеттік, бірақ⸺
Dialogue: 0,0:13:28.51,0:13:30.89,Default,,0,0,0,,Бар болғаны бір минут қалды.
Dialogue: 0,0:13:31.47,0:13:32.56,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:33.39,0:13:35.85,Default,,0,0,0,,Бүйірдегі соққы, кеттік.
Dialogue: 0,0:13:35.94,0:13:38.31,Default,,0,0,0,,Тағдырдың соққысы...
Dialogue: 0,0:13:38.77,0:13:40.48,Default,,0,0,0,,Жаңа ғана кірді!
Dialogue: 0,0:13:43.57,0:13:44.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:44.49,0:13:46.15,Default,,0,0,0,,Рику!
Dialogue: 0,0:13:46.70,0:13:47.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:48.66,0:13:50.74,Default,,0,0,0,,Уау! Ааа!
Dialogue: 0,0:13:52.20,0:13:53.74,Default,,0,0,0,,Ннн!
Dialogue: 0,0:13:57.08,0:14:00.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:00.08,0:14:02.50,Default,,0,0,0,,Ннн!
Dialogue: 0,0:14:04.80,0:14:07.26,Default,,0,0,0,,Мен сені өлсем де жібермеймін!
Dialogue: 0,0:14:07.34,0:14:08.80,Default,,0,0,0,,Ннн!
Dialogue: 0,0:14:14.47,0:14:15.89,Default,,0,0,0,,Ннн…
Dialogue: 0,0:14:15.98,0:14:17.23,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:14:18.77,0:14:23.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:24.44,0:14:26.07,Default,,0,0,0,,Монта!
Dialogue: 0,0:14:32.95,0:14:36.08,Default,,0,0,0,,Сіз өте әдемісіз. Хмм…
Dialogue: 0,0:14:37.45,0:14:39.92,Default,,0,0,0,,
Dialogue: 0,0:14:41.08,0:14:43.63,Default,,0,0,0,,Шар Өлі Батыс доп
Dialogue: 0,0:14:51.59,0:14:55.14,Default,,0,0,0,,Ойын аяқталды!
Dialogue: 0,0:14:55.22,0:14:57.60,Default,,0,0,0,,35-32⸺
Dialogue: 0,0:14:57.68,0:15:01.60,Default,,0,0,0,,Western Wild Gunmans финалға шықты!
Dialogue: 0,0:15:05.82,0:15:08.07,Default,,0,0,0,,Біздің жаңа жылдық ыдысымыз
Dialogue: 0,0:15:08.69,0:15:10.40,Default,,0,0,0,,Бітті...
Dialogue: 0,0:15:11.57,0:15:12.62,Default,,0,0,0,,Сол кезде⸺
Dialogue: 0,0:15:12.99,0:15:17.33,Default,,0,0,0,,Мен Рождестволық ыдыстан бас тартуым керек деп ойладым.
Dialogue: 0,0:15:17.41,0:15:20.08,Default,,0,0,0,,Мен қайта матч болады деп ойламадым.
Dialogue: 0,0:15:20.16,0:15:21.58,Default,,0,0,0,,Ал басқа адам...
Dialogue: 0,0:15:22.58,0:15:25.17,Default,,0,0,0,,Иә! Бандо өрмекшілері!
Dialogue: 0,0:15:32.59,0:15:34.80,Default,,0,0,0,,Сенна қайда кетті?
Dialogue: 0,0:15:35.39,0:15:36.43,Default,,0,0,0,,А, бүгін таңертең.
Dialogue: 0,0:15:36.51,0:15:39.22,Default,,0,0,0,,Сенна: «Бұл шешуші шайқас» дегенде⸺
Dialogue: 0,0:15:39.31,0:15:42.52,Default,,0,0,0,,Ол төбелесіп жатқандай көрінді.
Dialogue: 0,0:15:43.81,0:15:45.56,Default,,0,0,0,,Сол кезде мен ойладым
Dialogue: 0,0:15:45.65,0:15:48.03,Default,,0,0,0,,Кеше Eyeshield-kun айтқандай⸺
Dialogue: 0,0:15:48.11,0:15:50.99,Default,,0,0,0,,Ол бала да 12-ші ойыншы.
Dialogue: 0,0:15:52.82,0:15:54.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:54.78,0:16:01.00,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:16:01.83,0:16:06.25,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:16:06.34,0:16:08.00,Default,,0,0,0,,Мамори-неечан...
Dialogue: 0,0:16:08.09,0:16:09.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:10.01,0:16:11.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:11.47,0:16:12.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:15.34,0:16:16.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:18.43,0:16:20.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:22.18,0:16:23.56,Default,,0,0,0,,Сенна…
Dialogue: 0,0:16:25.94,0:16:29.44,Default,,0,0,0,,Сіз не істеп жатырсыз? Сенна
Dialogue: 0,0:16:30.11,0:16:31.86,Default,,0,0,0,,Сеннаға арналған американдық футбол...
Dialogue: 0,0:16:32.49,0:16:34.82,Default,,0,0,0,,Бұл қауіпті...
Dialogue: 0,0:16:36.12,0:16:38.58,Default,,0,0,0,,Кешіріңіз, мен сізге осы уақытқа дейін айта алмадым.
Dialogue: 0,0:16:39.49,0:16:40.91,Default,,0,0,0,,Мамори-неечан
Dialogue: 0,0:16:41.87,0:16:43.87,Default,,0,0,0,,Бірақ мен кетуім керек
Dialogue: 0,0:16:45.58,0:16:48.79,Default,,0,0,0,,Бұл – қуанышты сары орамал.
Dialogue: 0,0:16:50.88,0:16:52.30,Default,,0,0,0,,Және және!
Dialogue: 0,0:16:52.38,0:16:55.93,Default,,0,0,0,,Жұмбақ Eyeshield 21 маскасын қалай шешіп, қалай кетесіз?
Dialogue: 0,0:16:56.01,0:16:58.10,Default,,0,0,0,,Жарық жылдамдығымен кері жүгіру!
Dialogue: 0,0:16:58.18,0:17:00.06,Default,,0,0,0,,Көз... жоқ...
Dialogue: 0,0:17:04.10,0:17:08.73,Default,,0,0,0,,Сена Кобаякава!
Dialogue: 0,0:17:09.73,0:17:11.23,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:17:11.73,0:17:14.19,Default,,0,0,0,,Егер Сенна шынымен...
Dialogue: 0,0:17:15.53,0:17:19.16,Default,,0,0,0,,Қашан сонша өсті?
Dialogue: 0,0:17:20.99,0:17:22.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:26.08,0:17:29.96,Default,,0,0,0,,Бұл ең ақылды топтың соғыс жариялауы!
Dialogue: 0,0:17:33.38,0:17:34.63,Default,,0,0,0,,соққыға маманданған⸺
Dialogue: 0,0:17:34.72,0:17:38.59,Default,,0,0,0,,Мұқият дайындалған Бандо Өрмекшілерімен шешуші шайқас⸺
Dialogue: 0,0:17:38.68,0:17:40.55,Default,,0,0,0,,Сіз допты ұрлай алмай-ақ алға ұзартуға болады⸺
Dialogue: 0,0:17:41.01,0:17:43.18,Default,,0,0,0,,Бұл қиын даму болды.
Dialogue: 0,0:17:43.68,0:17:45.14,Default,,0,0,0,,Сынған!
Dialogue: 0,0:17:46.02,0:17:49.27,Default,,0,0,0,,Бірақ тебуші Мусаши қайтып келді⸺
Dialogue: 0,0:17:49.35,0:17:51.69,Default,,0,0,0,,Қайта туылу мүмкіндігі туды.
Dialogue: 0,0:17:52.15,0:17:53.69,Default,,0,0,0,,Ннн!
Dialogue: 0,0:18:05.95,0:18:08.42,Default,,0,0,0,,Уау!Уф!
Dialogue: 0,0:18:09.17,0:18:10.00,Default,,0,0,0,,
Dialogue: 0,0:18:10.08,0:18:12.71,Default,,0,0,0,,Алаңдағы қақпа соққысы сәтті өтті!
Dialogue: 0,0:18:12.80,0:18:15.30,Default,,0,0,0,,Ал шайқаста не болады⸺
Dialogue: 0,0:18:15.38,0:18:18.63,Default,,0,0,0,,Сенна мен Акабане-кун арасындағы жеке жекпе-жекке қалдырылды.
Dialogue: 0,0:18:24.81,0:18:26.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:27.89,0:18:30.10,Default,,0,0,0,,Акабане-саннан құтылу...
Dialogue: 0,0:18:30.69,0:18:31.73,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:18:31.81,0:18:33.15,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:18:33.23,0:18:34.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:34.69,0:18:36.57,Default,,0,0,0,,Мен міндетті түрде барамын
Dialogue: 0,0:18:36.65,0:18:38.20,Default,,0,0,0,,Рождестволық ыдыс!
Dialogue: 0,0:18:38.90,0:18:40.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:47.16,0:18:48.62,Default,,0,0,0,,(Сырылдаған дыбыс)
Dialogue: 0,0:18:56.51,0:18:58.22,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:18:58.30,0:19:00.63,Default,,0,0,0,,Кобаякава Сена!
Dialogue: 0,0:19:00.72,0:19:03.18,Default,,0,0,0,,Жарайсыңдар! (Таки) Ахаха!
Dialogue: 0,0:19:03.26,0:19:04.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:04.22,0:19:06.60,Default,,0,0,0,,Хахахаха! Алақай! Алақай!
Dialogue: 0,0:19:06.68,0:19:09.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:11.31,0:19:14.06,Default,,0,0,0,,және шайтан шайтан жарғанақтар⸺
Dialogue: 0,0:19:14.15,0:19:16.90,Default,,0,0,0,,Мен Канто турниріне қатысуды шештім.
Dialogue: 0,0:19:18.19,0:19:19.36,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:19:19.44,0:19:22.03,Default,,0,0,0,,Барлығы өте керемет!
Dialogue: 0,0:19:29.29,0:19:33.71,Default,,0,0,0,,Сена және барлығының Рождестволық ыдысы үшін⸺
Dialogue: 0,0:19:34.79,0:19:37.46,Default,,0,0,0,,Жаңа шайқас басталады!
Dialogue: 0,0:19:39.38,0:19:41.88,Default,,0,0,0,,Барлығына сәттілік!
Dialogue: 0,0:19:43.97,0:19:48.97,Default,,0,0,0,,♪~
Dialogue: 0,0:20:53.91,0:20:58.92,Default,,0,0,0,,~♪
Dialogue: 0,0:20:59.92,0:21:02.01,Default,,0,0,0,,Аха! Өлім ойыны?
Dialogue: 0,0:21:02.09,0:21:05.09,Default,,0,0,0,,Бір рет болса да жеңіліп қалсаңыз, Канто турнирінен шығасыз ба?
Dialogue: 0,0:21:05.18,0:21:06.64,Default,,0,0,0,,Сонымен... бұл бірінші адам болды
Dialogue: 0,0:21:06.72,0:21:10.01,Default,,0,0,0,,Мынау Хаширатани Дэрс, сол жын солдаты қайда!
Dialogue: 0,0:21:10.10,0:21:11.06,Default,,0,0,0,,Егер сіз қобалжысаңыз!
Dialogue: 0,0:21:11.52,0:21:14.10,Default,,0,0,0,,Біз міндетті түрде жеңуіміз керек!
Dialogue: 0,0:21:14.18,0:21:16.81,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:17.85,0:21:18.86,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:20.36,0:21:26.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory