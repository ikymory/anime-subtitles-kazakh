Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.62,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:00:06.21,0:00:08.21,Default,,0,0,0,,Ұзын пост~!
Dialogue: 0,0:00:08.34,0:00:09.50,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:09.63,0:00:10.96,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:00:11.09,0:00:12.30,Default,,0,0,0,,Қатты макс!
Dialogue: 0,0:00:14.93,0:00:16.76,Default,,0,0,0,,(Сеннаның тыныс алуы)
Dialogue: 0,0:00:17.51,0:00:19.72,Default,,0,0,0,,Қиналған жалғыз біз емеспіз
Dialogue: 0,0:00:19.85,0:00:21.60,Default,,0,0,0,,Төңкеру! (Мүшелер) Деймон!
Dialogue: 0,0:00:21.73,0:00:23.69,Default,,0,0,0,,Төңкеру! (Мүшелер) Шинрюджи храмы!
Dialogue: 0,0:00:23.81,0:00:25.56,Default,,0,0,0,,Төңкеру! (Мүшелер) Деймон!
Dialogue: 0,0:00:25.69,0:00:27.94,Default,,0,0,0,,Төңкеру! (Мүшелер) Шинрюджи храмы!
Dialogue: 0,0:00:30.32,0:00:33.45,Default,,0,0,0,,Күн сфинксі! (мүшелер) La~!
Dialogue: 0,0:00:42.25,0:00:44.91,Default,,0,0,0,,Уақыт шегіне 38 күн қалды
Dialogue: 0,0:00:45.04,0:00:47.38,Default,,0,0,0,,Барлығы Рождестволық тостағанға қарай
Dialogue: 0,0:00:50.13,0:00:52.88,Default,,0,0,0,,Фуннураба! (Комусуби) Фуго!
Dialogue: 0,0:00:53.55,0:00:56.26,Default,,0,0,0,,Мен оны тоқтатуым керек пе еді?
Dialogue: 0,0:00:56.38,0:00:57.93,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:58.05,0:01:00.85,Default,,0,0,0,,Бұрыштарды тағы да қиып алсам да, олар білмейді деп ойлаймын~
Dialogue: 0,0:01:00.97,0:01:01.81,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:01:02.60,0:01:06.14,Default,,0,0,0,,Ах, Хилл Демон, сіз 40 км нүктеге жеттіңіз.
Dialogue: 0,0:01:06.31,0:01:08.81,Default,,0,0,0,,Біз мұнда 20 шақырымды әрең жүріп өттік.
Dialogue: 0,0:01:09.31,0:01:11.40,Default,,0,0,0,,Қанша уақытқа созылса да
Dialogue: 0,0:01:11.52,0:01:13.40,Default,,0,0,0,,Сіз Лас-Вегасқа жете алмайсыз!
Dialogue: 0,0:01:13.53,0:01:16.36,Default,,0,0,0,,Хмм!
Dialogue: 0,0:01:17.03,0:01:18.70,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:01:18.82,0:01:21.37,Default,,0,0,0,,Жапонияға қайтып оралу жақсы болар еді.
Dialogue: 0,0:01:21.66,0:01:23.91,Default,,0,0,0,,Хмм... уф.
Dialogue: 0,0:01:24.04,0:01:30.04,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:37.90,0:02:43.91,Default,,0,0,0,,~♪
Dialogue: 0,0:02:50.71,0:02:53.00,Default,,0,0,0,,Өте қалпына келтіру? (Монта) Бұл не?
Dialogue: 0,0:02:53.63,0:02:55.96,Default,,0,0,0,,Қазір бұлшық еттеріңіз ауырып жатыр ма?
Dialogue: 0,0:02:56.34,0:02:59.47,Default,,0,0,0,,Менің бұлшық ет талшықтарым үзіліп кетті.
Dialogue: 0,0:02:59.97,0:03:01.09,Default,,0,0,0,,Осы жігіттің демалуына рұқсат етсеңіз
Dialogue: 0,0:03:01.22,0:03:03.76,Default,,0,0,0,,Емдеу қарқыны бұрынғыдан да артады.
Dialogue: 0,0:03:03.89,0:03:05.93,Default,,0,0,0,,Бұл «өте қалпына келтіру» құбылысы.
Dialogue: 0,0:03:06.26,0:03:07.14,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:03:07.27,0:03:09.64,Default,,0,0,0,,Бұлшықет жаттығулары осылай жұмыс істейді ме?
Dialogue: 0,0:03:10.14,0:03:11.48,Default,,0,0,0,,Сонымен жаттығудан кейін
Dialogue: 0,0:03:11.60,0:03:14.61,Default,,0,0,0,,Жақсы демалып, жақсы қалпына келудің мәні жоқ.
Dialogue: 0,0:03:15.06,0:03:17.73,Default,,0,0,0,,Күзгі турнирге 40 күннен аз уақыт қалды
Dialogue: 0,0:03:17.86,0:03:20.11,Default,,0,0,0,,Күн сайын бір күн демалсаңыз, Лас-Вегасқа жете алмайсыз.
Dialogue: 0,0:03:20.57,0:03:22.82,Default,,0,0,0,,Сонымен... (Монта) Біз не істейміз?
Dialogue: 0,0:03:23.28,0:03:24.28,Default,,0,0,0,,(жүктеу дыбысы)
Dialogue: 0,0:03:24.49,0:03:27.37,Default,,0,0,0,,Уау, уау... Эй! (мылтық)
Dialogue: 0,0:03:28.12,0:03:30.33,Default,,0,0,0,,Екі күн бойы түні бойы жаттығу!
Dialogue: 0,0:03:31.04,0:03:32.83,Default,,0,0,0,,Біріншіден, «Өлім маршы» дегеніміз не?
Dialogue: 0,0:03:32.96,0:03:34.25,Default,,0,0,0,,Түні бойы ұйықтамай, жылдамдықты екі есе арттырыңыз
Dialogue: 0,0:03:34.38,0:03:36.29,Default,,0,0,0,,Бағдарламаны аяқтауды білдіреді.
Dialogue: 0,0:03:36.84,0:03:40.22,Default,,0,0,0,,Екі есе қалпына келтіру үшін бұлшықеттеріңізді екі рет қолданыңыз!
Dialogue: 0,0:03:40.34,0:03:42.80,Default,,0,0,0,,Екі күн түні бойы жаттығасыз ба?
Dialogue: 0,0:03:42.93,0:03:44.26,Default,,0,0,0,,Бұл біртүрлі емес пе?
Dialogue: 0,0:03:44.76,0:03:49.02,Default,,0,0,0,,Жазғы демалыста түні бойы жаттығу
Dialogue: 0,0:03:49.14,0:03:50.23,Default,,0,0,0,,Өлу~
Dialogue: 0,0:03:52.23,0:03:54.02,Default,,0,0,0,,Барлығы, оны дұрыс мұздату керек.
Dialogue: 0,0:03:54.15,0:03:55.56,Default,,0,0,0,,Ісіну төмендемейді.
Dialogue: 0,0:03:56.11,0:03:58.90,Default,,0,0,0,,Уақыты келгенде, уақытында кетеміз.
Dialogue: 0,0:04:01.61,0:04:02.90,Default,,0,0,0,,Өзіңізді суық сезінесіз бе?
Dialogue: 0,0:04:03.28,0:04:05.87,Default,,0,0,0,,Тек сүлгі жын ғана жарайды.
Dialogue: 0,0:04:06.57,0:04:09.37,Default,,0,0,0,,Өту жолында атуға жаттығу кезінде
Dialogue: 0,0:04:09.49,0:04:13.37,Default,,0,0,0,,Ауыр жүктерді көтеру және нұсқау беру қиын болуы керек.
Dialogue: 0,0:04:13.75,0:04:15.12,Default,,0,0,0,,Өйткені есіктің арғы жағында жалаңаш қыз тұр.
Dialogue: 0,0:04:15.29,0:04:17.59,Default,,0,0,0,,Тіпті жаттығу жасасақ та жақсымыз.
Dialogue: 0,0:04:17.71,0:04:18.92,Default,,0,0,0,,Барымызды салайық!
Dialogue: 0,0:04:30.27,0:04:32.98,Default,,0,0,0,,Хм, не істеп жатырсың? Блять ақша
Dialogue: 0,0:04:33.56,0:04:35.44,Default,,0,0,0,,Тез барып балаларды қорға.
Dialogue: 0,0:04:35.94,0:04:37.15,Default,,0,0,0,,Мен бармаймын.
Dialogue: 0,0:04:37.40,0:04:38.94,Default,,0,0,0,,Тізелер қозғалмай қалады
Dialogue: 0,0:04:42.69,0:04:43.86,Default,,0,0,0,,Тоқта... не істеп жатырсың?
Dialogue: 0,0:04:44.53,0:04:46.82,Default,,0,0,0,,Мен саған тыныш отыр дедім!
Dialogue: 0,0:04:46.95,0:04:47.78,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:04:48.74,0:04:52.91,Default,,0,0,0,,Егер дәл соға алсаңыз, тезірек жүгіре аласыз.
Dialogue: 0,0:04:53.04,0:04:54.75,Default,,0,0,0,,Осылайша сіз оңай шаршамайсыз.
Dialogue: 0,0:04:59.00,0:05:00.75,Default,,0,0,0,,Мен мұндай кішкентай адамды ешқашан күтпедім.
Dialogue: 0,0:05:00.88,0:05:03.17,Default,,0,0,0,,Мен бұл Айсшилд 21 екенін білмедім.
Dialogue: 0,0:05:03.42,0:05:05.01,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:05.13,0:05:08.34,Default,,0,0,0,,Көз қалқаны аздап құрметтей бастадым.
Dialogue: 0,0:05:08.47,0:05:10.18,Default,,0,0,0,,Нағыз тұлға сол жігіт еді.
Dialogue: 0,0:05:10.31,0:05:12.64,Default,,0,0,0,,Сыйласымды жоғалттым.
Dialogue: 0,0:05:12.89,0:05:16.27,Default,,0,0,0,,Жүйрік болғаның үшін ғана батырсың.
Dialogue: 0,0:05:16.39,0:05:19.65,Default,,0,0,0,,Адамда кем дегенде бір қасиет бар.
Dialogue: 0,0:05:22.32,0:05:23.74,Default,,0,0,0,,Джумонджиге не болды?
Dialogue: 0,0:05:23.86,0:05:26.03,Default,,0,0,0,,Шаршадыңыз ба, сөйлескіңіз келмейді ме?
Dialogue: 0,0:05:26.15,0:05:26.99,Default,,0,0,0,,​​О?
Dialogue: 0,0:05:28.07,0:05:29.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.95,0:05:32.41,Default,,0,0,0,,Ei… ha ha ha…
Dialogue: 0,0:05:33.04,0:05:34.41,Default,,0,0,0,,Жаңадан шыққан батыр Mt. Lady –
Dialogue: 0,0:05:36.71,0:05:38.75,Default,,0,0,0,,Бұл әдейі емес.
Dialogue: 0,0:05:38.88,0:05:39.83,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:05:42.55,0:05:44.17,Default,,0,0,0,,Шаршаған жоқсың ба?
Dialogue: 0,0:05:44.42,0:05:47.80,Default,,0,0,0,,Не? О, әрине, мен шаршадым
Dialogue: 0,0:05:47.93,0:05:49.80,Default,,0,0,0,,Маған тезірек дұрыс тебуді үйрену керек.
Dialogue: 0,0:05:51.30,0:05:52.26,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:05:52.68,0:05:53.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:54.60,0:05:57.39,Default,,0,0,0,,Сізге американдық футбол қашан сонша ұнай бастады?
Dialogue: 0,0:05:57.52,0:05:59.77,Default,,0,0,0,,О, жоқ, сен мені қашан сұрасаң да
Dialogue: 0,0:06:00.27,0:06:02.27,Default,,0,0,0,,Біртүрлі ма? Не?
Dialogue: 0,0:06:02.40,0:06:05.28,Default,,0,0,0,,Осындай қиын жаттығуларға қатысқанымызға сене алар емеспін.
Dialogue: 0,0:06:05.40,0:06:06.24,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,0:06:06.99,0:06:08.91,Default,,0,0,0,,Бұл не болды...
Dialogue: 0,0:06:09.70,0:06:14.12,Default,,0,0,0,,Осы уақытқа дейін не істегенімізді ескерсек, бұл біртүрлі.
Dialogue: 0,0:06:14.58,0:06:17.96,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:06:23.54,0:06:25.76,Default,,0,0,0,,Біз де өзгере аламыз.
Dialogue: 0,0:06:26.92,0:06:27.92,Default,,0,0,0,,Ол өзгере ме?
Dialogue: 0,0:06:29.26,0:06:30.68,Default,,0,0,0,,Өзгерту және аяқтау
Dialogue: 0,0:06:30.97,0:06:32.05,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:06:33.35,0:06:35.01,Default,,0,0,0,,А, жоқ, мен сондаймын...
Dialogue: 0,0:06:36.06,0:06:37.48,Default,,0,0,0,,Мен сізді танимын!
Dialogue: 0,0:06:37.81,0:06:38.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:39.14,0:06:39.98,Default,,0,0,0,,«Барлығын мен үшін» мұрагері…
Dialogue: 0,0:06:40.48,0:06:42.40,Default,,0,0,0,,Мен сенен ұтыла алмаймын
Dialogue: 0,0:06:43.56,0:06:45.23,Default,,0,0,0,,Джумонджи-кун
Dialogue: 0,0:06:48.32,0:06:50.15,Default,,0,0,0,,(мүшелердің ұйықтауы)
Dialogue: 0,0:06:50.28,0:06:51.11,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:51.78,0:06:53.62,Default,,0,0,0,,Джумонджи (Куроки: сыбырлап) Оян!
Dialogue: 0,0:06:55.62,0:06:56.58,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:57.33,0:06:59.58,Default,,0,0,0,,Бұл шешілді, қаш.
Dialogue: 0,0:06:59.71,0:07:01.54,Default,,0,0,0,,Мұндай азаптау мүмкін емес.
Dialogue: 0,0:07:01.87,0:07:03.46,Default,,0,0,0,,Жапонияға тез оралыңыз
Dialogue: 0,0:07:03.58,0:07:05.55,Default,,0,0,0,,Жазғы демалысты қызықты өткізейік
Dialogue: 0,0:07:06.21,0:07:07.51,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:07:08.21,0:07:09.47,Default,,0,0,0,,О? (Тоноха) Бұл не?
Dialogue: 0,0:07:10.51,0:07:11.97,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:07:12.59,0:07:13.72,Default,,0,0,0,,Не?
Dialogue: 0,0:07:14.14,0:07:16.93,Default,,0,0,0,,Құйрығымды орап алып қаша аламын ба?
Dialogue: 0,0:07:17.81,0:07:19.68,Default,,0,0,0,,Га? (Куроки) Иә?
Dialogue: 0,0:07:20.18,0:07:21.81,Default,,0,0,0,,Сіз жүк көлігін қатты итердіңіз.
Dialogue: 0,0:07:21.94,0:07:23.35,Default,,0,0,0,,Сіз жынды болдыңыз ба?
Dialogue: 0,0:07:23.48,0:07:25.73,Default,,0,0,0,,Солай дегің келе ме? Кешір мені.
Dialogue: 0,0:07:25.90,0:07:27.23,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:07:27.73,0:07:29.65,Default,,0,0,0,,Мм пий
Dialogue: 0,0:07:30.11,0:07:32.20,Default,,0,0,0,,Мен де сенімен бірге барамын (Монта) О...
Dialogue: 0,0:07:34.70,0:07:36.66,Default,,0,0,0,,Жарайды (Куроки) Әзірге...
Dialogue: 0,0:07:42.12,0:07:42.96,Default,,0,0,0,,​​О?
Dialogue: 0,0:07:43.37,0:07:44.38,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:07:44.50,0:07:46.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:49.09,0:07:50.92,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:54.18,0:07:56.97,Default,,0,0,0,,Tsk, асығыңыз...
Dialogue: 0,0:07:59.64,0:08:02.94,Default,,0,0,0,,Хааааа Бұл не? Жаман ба?
Dialogue: 0,0:08:03.06,0:08:05.02,Default,,0,0,0,,Біз қазір үйге барамыз.
Dialogue: 0,0:08:05.15,0:08:06.73,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:08:06.86,0:08:08.69,Default,,0,0,0,,Оны тоқтатудың қажеті жоқ!
Dialogue: 0,0:08:14.07,0:08:14.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:15.36,0:08:17.12,Default,,0,0,0,,Жапон елшілігінің картасы
Dialogue: 0,0:08:17.24,0:08:18.78,Default,,0,0,0,,Га? (Куроки) Иә?
Dialogue: 0,0:08:18.91,0:08:21.91,Default,,0,0,0,,Егер сіз сол жаққа дейін автостоппен жүрсеңіз, үйге қайта аласыз.
Dialogue: 0,0:08:22.33,0:08:23.92,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:08:24.54,0:08:25.54,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:08:26.33,0:08:27.29,Default,,0,0,0,,Иә? а?
Dialogue: 0,0:08:29.75,0:08:32.13,Default,,0,0,0,,Шынында да, алдағы күзгі турнир болады
Dialogue: 0,0:08:32.26,0:08:35.59,Default,,0,0,0,,Бұл сүлгі жындар мен Курита үшін өмірдегі соңғы мүмкіндік.
Dialogue: 0,0:08:35.84,0:08:37.89,Default,,0,0,0,,Өлім шеруі қаншалықты қатыгез болса да,
Dialogue: 0,0:08:38.01,0:08:39.26,Default,,0,0,0,,Менің бұған жабысқаннан басқа амалым жоқ.
Dialogue: 0,0:08:39.93,0:08:43.02,Default,,0,0,0,,Бірақ балалар, бірінші жылыңда келесі жыл бар.
Dialogue: 0,0:08:43.14,0:08:44.94,Default,,0,0,0,,Бір жыл мұқият жаттығатын болсаңыз
Dialogue: 0,0:08:45.35,0:08:47.90,Default,,0,0,0,,Келесі күзде жақсы жекпе-жек өткіземіз.
Dialogue: 0,0:08:48.02,0:08:50.40,Default,,0,0,0,,Осы жылы ойыншы ретінде өз өміріңізді қатерге тігуге ешқандай себеп жоқ.
Dialogue: 0,0:08:50.57,0:08:51.40,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:51.61,0:08:52.99,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:08:53.11,0:08:53.95,Default,,0,0,0,,Монта!
Dialogue: 0,0:08:58.20,0:08:59.41,Default,,0,0,0,,Мен де...
Dialogue: 0,0:08:59.87,0:09:02.87,Default,,0,0,0,,Тіпті мен олардың жеңуіне мүмкіндік бере аламын.
Dialogue: 0,0:09:03.33,0:09:06.67,Default,,0,0,0,,Кіші орта мектептен бері қатал американдық футбол ақымақ.
Dialogue: 0,0:09:07.04,0:09:08.50,Default,,0,0,0,,Мен мектепте жүзіп жүрдім
Dialogue: 0,0:09:08.63,0:09:12.09,Default,,0,0,0,,Олар американдық футболға құмарлығы ешкімнен кем емес жігіттер.
Dialogue: 0,0:09:13.76,0:09:15.38,Default,,0,0,0,,Маңызды емес (Джумонджи) Ха!
Dialogue: 0,0:09:15.51,0:09:16.55,Default,,0,0,0,,Иә? (Монта/Сена) Ах!
Dialogue: 0,0:09:18.05,0:09:20.85,Default,,0,0,0,,Иә, мұның бізге қандай қатысы бар?
Dialogue: 0,0:09:21.60,0:09:22.93,Default,,0,0,0,,Біз барамыз
Dialogue: 0,0:09:23.06,0:09:25.31,Default,,0,0,0,,Не істеу керек? Джумонжи
Dialogue: 0,0:09:27.48,0:09:28.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:29.40,0:09:31.82,Default,,0,0,0,,Түсіндім (Тоноха) Сіз өзгердіңіз.
Dialogue: 0,0:09:31.94,0:09:34.28,Default,,0,0,0,,（）
Dialogue: 0,0:09:34.86,0:09:35.70,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:09:35.99,0:09:37.20,Default,,0,0,0,,（）
Dialogue: 0,0:09:37.32,0:09:38.86,Default,,0,0,0,,Сәлем Куроки! Тога!
Dialogue: 0,0:09:38.99,0:09:39.82,Default,,0,0,0,,Шу!
Dialogue: 0,0:09:40.20,0:09:41.03,Default,,0,0,0,,Сол сұм Боинго! Ең болмағанда қазір! Мылтығым➡
Dialogue: 0,0:09:44.16,0:09:46.87,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:09:48.33,0:09:49.88,Default,,0,0,0,,Ах... А?
Dialogue: 0,0:09:52.63,0:09:55.34,Default,,0,0,0,,Мистер Хилл Демон Куроки-кун мен Тоно-кун!
Dialogue: 0,0:09:55.46,0:09:57.63,Default,,0,0,0,,Біз оны тез тоқтатуымыз керек! Қазір емес...
Dialogue: 0,0:09:57.76,0:09:58.93,Default,,0,0,0,,Төбе шайтан!
Dialogue: 0,0:09:59.18,0:10:01.93,Default,,0,0,0,,Мотивациясы жоқтар үйлеріне қайтсын.
Dialogue: 0,0:10:03.68,0:10:06.89,Default,,0,0,0,,Міне... Осы уақытқа дейін бірге еңбектенсек те.
Dialogue: 0,0:10:07.48,0:10:08.77,Default,,0,0,0,,Осы уақытқа дейін?
Dialogue: 0,0:10:09.44,0:10:12.11,Default,,0,0,0,,Өлім маршы енді ғана басталды!
Dialogue: 0,0:10:13.07,0:10:14.94,Default,,0,0,0,,Сүлік жын осылай деді (Монта/Сена) Иә?
Dialogue: 0,0:10:17.15,0:10:18.45,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:10:18.57,0:10:20.41,Default,,0,0,0,,Мен бұзақылармен бірге жүруім керек пе?
Dialogue: 0,0:10:20.87,0:10:21.82,Default,,0,0,0,,Гррр…
Dialogue: 0,0:10:28.58,0:10:30.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:31.00,0:10:32.34,Default,,0,0,0,,(Куроки мен Тононың ауыр тыныс алуы)
Dialogue: 0,0:10:38.80,0:10:41.01,Default,,0,0,0,,Екеуің Жапонияға оралдыңдар ма?
Dialogue: 0,0:10:41.47,0:10:43.89,Default,,0,0,0,,Сіз қатты жұмыс істеймін дедіңіз.
Dialogue: 0,0:10:44.01,0:10:45.14,Default,,0,0,0,,Фуго~
Dialogue: 0,0:10:45.81,0:10:48.48,Default,,0,0,0,,Мен қашып кеткім келетін сияқты, бірақ түсінемін.
Dialogue: 0,0:10:49.06,0:10:50.65,Default,,0,0,0,,Бірақ мүмкін
Dialogue: 0,0:10:50.77,0:10:52.98,Default,,0,0,0,,Бәлкім, тағы да ойланып, қайтып келер.
Dialogue: 0,0:10:53.65,0:10:56.69,Default,,0,0,0,,Сонда Джумонджи ғана қалды ма?
Dialogue: 0,0:10:56.82,0:10:57.74,Default,,0,0,0,,Иә
Dialogue: 0,0:10:58.69,0:11:01.91,Default,,0,0,0,,Осы уақытқа дейін бұл үшеуі мәңгі бірге болды.
Dialogue: 0,0:11:02.37,0:11:04.87,Default,,0,0,0,,Бұл туралы мәңгілік айтпа, қазір ұйықта!
Dialogue: 0,0:11:05.87,0:11:06.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:10.25,0:11:11.96,Default,,0,0,0,,Әй, бұл жеткілікті емес пе?
Dialogue: 0,0:11:12.08,0:11:13.04,Default,,0,0,0,,Не?
Dialogue: 0,0:11:13.17,0:11:14.88,Default,,0,0,0,,Сондықтан маған енді жүгірудің қажеті жоқ...
Dialogue: 0,0:11:15.00,0:11:17.05,Default,,0,0,0,,А... тез айтшы.
Dialogue: 0,0:11:17.17,0:11:20.01,Default,,0,0,0,,Дұрыс, мен сол тозақтан құтылдым.
Dialogue: 0,0:11:20.13,0:11:21.84,Default,,0,0,0,,Неге мәңгілікке жүгіресің?
Dialogue: 0,0:11:22.59,0:11:25.81,Default,,0,0,0,,Бірақ біз білмей тұрып, біз күш жинадық~
Dialogue: 0,0:11:26.31,0:11:29.52,Default,,0,0,0,,Уа, қолдарың қатты қысылған!
Dialogue: 0,0:11:30.14,0:11:31.81,Default,,0,0,0,,Хаха, сен де
Dialogue: 0,0:11:32.77,0:11:35.98,Default,,0,0,0,,Күтілгендей, Джумонжи қару-жарақ жағынан ең жақсы.
Dialogue: 0,0:11:36.61,0:11:40.03,Default,,0,0,0,,Джумонджи қол күресінен де ең күшті.
Dialogue: 0,0:11:43.70,0:11:46.24,Default,,0,0,0,,Екі адам болғаны біртүрлі.
Dialogue: 0,0:11:46.99,0:11:49.20,Default,,0,0,0,,Үшеуміз үнемі бірге болдық.
Dialogue: 0,0:11:53.12,0:11:55.25,Default,,0,0,0,,Менің соңымнан келе аласыз ба?
Dialogue: 0,0:11:55.38,0:11:56.21,Default,,0,0,0,,Джумонджи?
Dialogue: 0,0:11:56.59,0:11:57.42,Default,,0,0,0,,О
Dialogue: 0,0:11:58.42,0:11:59.63,Default,,0,0,0,,Келме
Dialogue: 0,0:12:01.59,0:12:03.01,Default,,0,0,0,,Келме
Dialogue: 0,0:12:13.60,0:12:15.94,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:12:17.98,0:12:19.44,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:12:19.57,0:12:21.19,Default,,0,0,0,,А, мен әлі ұйықтап жатырмын.
Dialogue: 0,0:12:21.32,0:12:23.90,Default,,0,0,0,,Иә? Джумонжи ше? иә?
Dialogue: 0,0:12:24.20,0:12:25.53,Default,,0,0,0,,Жүк жоқ
Dialogue: 0,0:12:25.74,0:12:26.87,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:12:27.45,0:12:30.87,Default,,0,0,0,,Джумонжи кун! Джумонжи кун!
Dialogue: 0,0:12:31.37,0:12:33.62,Default,,0,0,0,,Джумонжи кун!
Dialogue: 0,0:12:33.75,0:12:35.83,Default,,0,0,0,,Ол екеуіңнің артынан барды ма?
Dialogue: 0,0:12:35.96,0:12:37.84,Default,,0,0,0,,Міне! (Комусуби) Фуго~
Dialogue: 0,0:12:38.96,0:12:40.00,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:12:40.17,0:12:41.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:42.97,0:12:44.34,Default,,0,0,0,,Джумонджи-кун
Dialogue: 0,0:12:44.47,0:12:47.64,Default,,0,0,0,,Мен оның Куроки-кун мен Тоно-кунды алуға кеткеніне сенімдімін.
Dialogue: 0,0:12:48.35,0:12:50.10,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,0:12:50.76,0:12:51.68,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:12:53.31,0:12:55.44,Default,,0,0,0,,Біз де өзгере аламыз.
Dialogue: 0,0:13:01.40,0:13:02.49,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:13:02.61,0:13:05.74,Default,,0,0,0,,Джумонджи-кун мен басқалары қайтып келгенше кетпес бұрын күте тұрыңыз.
Dialogue: 0,0:13:06.82,0:13:08.70,Default,,0,0,0,,Сіздің қайтып келетініңізге кепілдік бар ма?
Dialogue: 0,0:13:09.24,0:13:11.24,Default,,0,0,0,,Кепілдік жоқ...
Dialogue: 0,0:13:11.37,0:13:13.16,Default,,0,0,0,,Мен не істеуім керек, сүлгі жын? Ах!
Dialogue: 0,0:13:13.91,0:13:16.25,Default,,0,0,0,,Хиру-сан, өтінемін!
Dialogue: 0,0:13:16.67,0:13:19.04,Default,,0,0,0,,Кету уақыты келді...
Dialogue: 0,0:13:19.54,0:13:22.30,Default,,0,0,0,,Төбе жын, сәл күте аласыз...
Dialogue: 0,0:13:22.42,0:13:23.55,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:26.05,0:13:28.55,Default,,0,0,0,,Қайтып келетінін білмейтіндер
Dialogue: 0,0:13:28.68,0:13:29.89,Default,,0,0,0,,Менің күтуге уақытым жоқ.
Dialogue: 0,0:13:30.51,0:13:31.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:34.43,0:13:36.31,Default,,0,0,0,,Дайындық па?
Dialogue: 0,0:13:39.81,0:13:41.19,Default,,0,0,0,,Мен қаламын!
Dialogue: 0,0:13:44.57,0:13:47.45,Default,,0,0,0,,Джумонджи-кун міндетті түрде қайтып келеді!
Dialogue: 0,0:13:47.57,0:13:48.78,Default,,0,0,0,,Сенна?
Dialogue: 0,0:13:49.57,0:13:52.49,Default,,0,0,0,,Үшеуің қайтқанда, бірге қуамыз.
Dialogue: 0,0:13:53.54,0:13:54.95,Default,,0,0,0,,Ендеше, алға!
Dialogue: 0,0:13:57.67,0:14:00.13,Default,,0,0,0,,Сена мен сенің сезіміңді түсінемін.
Dialogue: 0,0:14:00.96,0:14:06.09,Default,,0,0,0,,Жарайды, Мамори-неечан, мен міндетті түрде сенің соңынан еремін, сондықтан жүр.
Dialogue: 0,0:14:06.34,0:14:07.55,Default,,0,0,0,,Сенна…
Dialogue: 0,0:14:08.34,0:14:10.64,Default,,0,0,0,,Мен сені күтемін, сондықтан міндетті түрде жетіп ал.
Dialogue: 0,0:14:10.76,0:14:11.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:12.10,0:14:13.72,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:14:13.85,0:14:15.72,Default,,0,0,0,,Қалғысы келген адам қала алады.
Dialogue: 0,0:14:15.85,0:14:17.77,Default,,0,0,0,,Жарайды, ол тез кетеді!
Dialogue: 0,0:14:19.27,0:14:20.90,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:14:22.15,0:14:23.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.74,0:14:31.16,Default,,0,0,0,,Сенна сонша айтса, мен де қаламын.
Dialogue: 0,0:14:31.32,0:14:32.16,Default,,0,0,0,,Монта
Dialogue: 0,0:14:32.70,0:14:34.62,Default,,0,0,0,,Біз бір жылы сыныптаспыз.
Dialogue: 0,0:14:35.12,0:14:36.20,Default,,0,0,0,,Монтаға рахмет
Dialogue: 0,0:14:36.37,0:14:37.87,Default,,0,0,0,,Фу~нураба! (Комусуби) Фугоцу
Dialogue: 0,0:14:38.00,0:14:39.87,Default,,0,0,0,,Кешіріңіз, фуго
Dialogue: 0,0:14:40.12,0:14:41.17,Default,,0,0,0,,Комусуби-кун?
Dialogue: 0,0:14:41.46,0:14:42.79,Default,,0,0,0,,Қал!
Dialogue: 0,0:14:45.34,0:14:46.63,Default,,0,0,0,,Комусуби-кун!
Dialogue: 0,0:14:46.76,0:14:48.38,Default,,0,0,0,,Фуго!
Dialogue: 0,0:14:49.63,0:14:52.51,Default,,0,0,0,,Әй, бірақ Сена, маған бір нәрсені айт.
Dialogue: 0,0:14:52.64,0:14:55.43,Default,,0,0,0,,Оларға неге сонша сенесің?
Dialogue: 0,0:14:55.89,0:14:56.85,Default,,0,0,0,,Мен оны естігім келеді!
Dialogue: 0,0:14:57.31,0:14:59.48,Default,,0,0,0,,Өйткені... өйткені олардың үшеуі де
Dialogue: 0,0:14:59.60,0:15:01.60,Default,,0,0,0,,Сіз әуежайда ант бердіңіз.
Dialogue: 0,0:15:03.90,0:15:05.48,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:15:05.61,0:15:06.65,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:06.78,0:15:07.65,Default,,0,0,0,,Гюго!
Dialogue: 0,0:15:07.78,0:15:08.86,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:15:08.99,0:15:09.82,Default,,0,0,0,,Ах! (Сена/Комусуби) Иә?
Dialogue: 0,0:15:16.87,0:15:18.45,Default,,0,0,0,,Берілмеңіз
Dialogue: 0,0:15:18.58,0:15:20.25,Default,,0,0,0,,Жаңбыр қашанға дейін жауады?
Dialogue: 0,0:15:21.42,0:15:25.29,Default,,0,0,0,,Джумонджи сіз жаңбырда жүк көлігін итеріп жатырсыз ба?
Dialogue: 0,0:15:25.42,0:15:26.25,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:15:26.67,0:15:27.67,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:15:27.88,0:15:29.72,Default,,0,0,0,,Сол жігіттермен бірге болу
Dialogue: 0,0:15:29.97,0:15:31.88,Default,,0,0,0,,Бізбен Жапонияға оралыңыз.
Dialogue: 0,0:15:32.01,0:15:33.93,Default,,0,0,0,,Мұның бәрі көңілді.
Dialogue: 0,0:15:36.26,0:15:37.85,Default,,0,0,0,,Келесің бе? Сол жігіт
Dialogue: 0,0:15:37.97,0:15:38.85,Default,,0,0,0,,Келме
Dialogue: 0,0:15:43.15,0:15:43.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:44.15,0:15:45.27,Default,,0,0,0,,Ах (Тоноха) Иә?
Dialogue: 0,0:15:45.44,0:15:46.61,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:15:47.07,0:15:49.23,Default,,0,0,0,,Джумонджи (Тоно) Иә!
Dialogue: 0,0:15:49.40,0:15:52.24,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:15:52.74,0:15:55.20,Default,,0,0,0,,Бұл не? (Тоноха) Сіз бәрібір келдіңіз бе?
Dialogue: 0,0:15:56.03,0:15:58.41,Default,,0,0,0,,Сіз бізбен Жапонияға қайтасыз ба?
Dialogue: 0,0:15:58.54,0:15:59.41,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:59.54,0:16:01.71,Default,,0,0,0,,Ұшудан қорыққаныңыздан тартындыңыз ба?
Dialogue: 0,0:16:01.83,0:16:02.96,Default,,0,0,0,,Хаха, солай емес пе?
Dialogue: 0,0:16:03.08,0:16:04.67,Default,,0,0,0,,Өлім шеру жалғасуда!
Dialogue: 0,0:16:05.17,0:16:06.88,Default,,0,0,0,,Га? (Куроки) Иә?
Dialogue: 0,0:16:07.25,0:16:10.34,Default,,0,0,0,,Өлім шеруін соңына дейін жалғастыр!
Dialogue: 0,0:16:10.71,0:16:12.22,Default,,0,0,0,,Сенің есі дұрыс па?
Dialogue: 0,0:16:12.34,0:16:14.68,Default,,0,0,0,,Сізді ақымақ деп атағаныңыз дұрыс па?
Dialogue: 0,0:16:14.80,0:16:17.68,Default,,0,0,0,,Айтшы, айтсын.
Dialogue: 0,0:16:17.81,0:16:19.01,Default,,0,0,0,,Біз Жапонияға қайтамыз.
Dialogue: 0,0:16:19.14,0:16:20.81,Default,,0,0,0,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:16:21.43,0:16:25.52,Default,,0,0,0,,Біз Жапонияға қайтып бара жатқанда, жазғы демалыс. Қайтадан бірге көңіл көтерейік, үшеуміз.
Dialogue: 0,0:16:26.15,0:16:28.48,Default,,0,0,0,,Сен мұндай жерде ақымақ болып көрінесің, жүк көлігін итер.
Dialogue: 0,0:16:28.61,0:16:30.44,Default,,0,0,0,,Не болады?
Dialogue: 0,0:16:33.03,0:16:35.61,Default,,0,0,0,,Жетеді! Екеуміз үйге бара жатырмыз.
Dialogue: 0,0:16:35.99,0:16:36.87,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:16:36.99,0:16:39.08,Default,,0,0,0,,Өйткені, бұл жігіт бізден бөлек.
Dialogue: 0,0:16:40.37,0:16:41.25,Default,,0,0,0,,Не?
Dialogue: 0,0:16:42.04,0:16:43.46,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:16:43.58,0:16:45.96,Default,,0,0,0,,Қарғыс атқыр... сен де оқыдың ғой, солай ма?
Dialogue: 0,0:16:46.08,0:16:48.13,Default,,0,0,0,,Бір күнгі «Ай сайынғы американдық футбол»
Dialogue: 0,0:16:48.29,0:16:50.92,Default,,0,0,0,,Мен сені мақтадым.
Dialogue: 0,0:16:51.17,0:16:53.92,Default,,0,0,0,,Екеумізді қоқыс сияқты қарадық!
Dialogue: 0,0:16:54.30,0:16:56.01,Default,,0,0,0,,Ах (Тоноха) Бұл не?
Dialogue: 0,0:16:56.72,0:16:58.26,Default,,0,0,0,,«Курита Комусуби Джумонжи бұл»
Dialogue: 0,0:16:58.39,0:16:59.89,Default,,0,0,0,,«Ол жақсы ойнады».
Dialogue: 0,0:17:00.10,0:17:02.52,Default,,0,0,0,,«Бірақ Куроки Токане сәтсіздікке ұшырады.»
Dialogue: 0,0:17:03.52,0:17:05.44,Default,,0,0,0,,Сіз осылай жаздыңыз ба?
Dialogue: 0,0:17:05.98,0:17:07.65,Default,,0,0,0,,Сіз мұны оқыдыңыз ба?
Dialogue: 0,0:17:08.11,0:17:09.94,Default,,0,0,0,,Тіпті қоқыс жәшігін оқуға болады.
Dialogue: 0,0:17:10.57,0:17:14.15,Default,,0,0,0,,көремін. Екеуміз ғана лас дуэтпіз.
Dialogue: 0,0:17:14.32,0:17:15.70,Default,,0,0,0,,Бұл артық емес пе?
Dialogue: 0,0:17:15.82,0:17:17.24,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:17:17.36,0:17:18.66,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:17:19.62,0:17:21.62,Default,,0,0,0,,Енді барайық, Тога.
Dialogue: 0,0:17:21.74,0:17:23.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:25.96,0:17:27.33,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:17:27.67,0:17:28.83,Default,,0,0,0,,Бұл!
Dialogue: 0,0:17:29.46,0:17:30.50,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:31.71,0:17:34.26,Default,,0,0,0,,Ауырды... (Тоноха) Не істеп жатырсың!
Dialogue: 0,0:17:34.38,0:17:36.22,Default,,0,0,0,,Балалар сендер қоқыссыңдар.
Dialogue: 0,0:17:36.34,0:17:37.26,Default,,0,0,0,,Өкінбейсің бе!
Dialogue: 0,0:17:37.68,0:17:41.39,Default,,0,0,0,,Жарайды, сен қоқыс емессің.
Dialogue: 0,0:17:41.51,0:17:44.22,Default,,0,0,0,,Қоқыс бір-бірімен тіл табысады.
Dialogue: 0,0:17:45.68,0:17:46.56,Default,,0,0,0,,Уф! (Куроки) Жақсы...
Dialogue: 0,0:17:47.10,0:17:48.06,Default,,0,0,0,,Иә! (Тоноха) Бой!
Dialogue: 0,0:17:50.44,0:17:53.86,Default,,0,0,0,,Осы уақытқа дейін екеуіңді дос санайтынмын.
Dialogue: 0,0:17:54.23,0:17:55.86,Default,,0,0,0,,Бұл жай ғана емес
Dialogue: 0,0:17:55.99,0:17:58.91,Default,,0,0,0,,Мен сендерді қоқыс деп атағандарына шыдай алмадым!
Dialogue: 0,0:18:00.03,0:18:02.41,Default,,0,0,0,,Балалар, сендер қоқыс болсаңдар, мен де қоқыспын!
Dialogue: 0,0:18:02.62,0:18:04.41,Default,,0,0,0,,Біз әрқашан бірге болдық!
Dialogue: 0,0:18:04.54,0:18:07.37,Default,,0,0,0,,Ей, онда Жапонияға бірге қайтайық!
Dialogue: 0,0:18:07.79,0:18:10.38,Default,,0,0,0,,Уф... қолымыздан келмейді!
Dialogue: 0,0:18:12.80,0:18:14.34,Default,,0,0,0,,Біз өзгереміз
Dialogue: 0,0:18:14.46,0:18:15.80,Default,,0,0,0,,Тіпті ол өзгерді!
Dialogue: 0,0:18:16.17,0:18:17.01,Default,,0,0,0,,Ол...?
Dialogue: 0,0:18:17.42,0:18:18.26,Default,,0,0,0,,Сен Сенна туралы айтып тұрсың ба?
Dialogue: 0,0:18:21.64,0:18:23.35,Default,,0,0,0,,Ол жасады.
Dialogue: 0,0:18:23.47,0:18:25.72,Default,,0,0,0,,Біз мұны істей алмаймыз!
Dialogue: 0,0:18:25.89,0:18:27.85,Default,,0,0,0,,Бұл не? Теме! (төбелестің дыбысы)
Dialogue: 0,0:18:27.98,0:18:29.98,Default,,0,0,0,,Сен бейбақ! (төбелестің дыбысы)
Dialogue: 0,0:18:30.10,0:18:31.27,Default,,0,0,0,,Не!
Dialogue: 0,0:18:36.69,0:18:38.86,Default,,0,0,0,,Эй, қарашы (Джумонджи) Ой?
Dialogue: 0,0:18:38.99,0:18:40.53,Default,,0,0,0,,Бос, бос
Dialogue: 0,0:18:40.86,0:18:41.91,Default,,0,0,0,,Кемпірқосақ?
Dialogue: 0,0:18:42.07,0:18:45.49,Default,,0,0,0,,3 4 5... Иә?
Dialogue: 0,0:18:45.87,0:18:47.29,Default,,0,0,0,,Сіз нені санап жатырсыз?
Dialogue: 0,0:18:47.58,0:18:49.46,Default,,0,0,0,,Мені де сендерден көбірек ұрды.
Dialogue: 0,0:18:50.29,0:18:52.00,Default,,0,0,0,,Жоқ... олай емес.
Dialogue: 0,0:18:52.17,0:18:54.96,Default,,0,0,0,,Американдық кемпірқосақтың тек алты түсі бар ма?
Dialogue: 0,0:18:55.34,0:18:56.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:56.38,0:18:59.13,Default,,0,0,0,,4 5 6 7 8... Бұл 8 емес пе?
Dialogue: 0,0:18:59.26,0:19:01.39,Default,,0,0,0,,Өтірік 4 5 6... Қараңдар, 6, солай ма?
Dialogue: 0,0:19:01.89,0:19:04.10,Default,,0,0,0,,Балалар сендер шынымен ақымақсыңдар!
Dialogue: 0,0:19:04.47,0:19:08.06,Default,,0,0,0,,Кемпірқосақ түстері болса, әлемнің әр жерінде жеті түс болар еді...
Dialogue: 0,0:19:08.31,0:19:10.35,Default,,0,0,0,,Не! (Куроки) Сен мұнда не істеп жүрсің!
Dialogue: 0,0:19:10.56,0:19:12.98,Default,,0,0,0,,Бұл~! (Джумонджи) Гах...
Dialogue: 0,0:19:14.23,0:19:18.32,Default,,0,0,0,,Хм
Dialogue: 0,0:19:19.44,0:19:20.61,Default,,0,0,0,,Сіз оны қолданып көрдіңіз бе?
Dialogue: 0,0:19:21.24,0:19:22.45,Default,,0,0,0,,Өлім маршы!
Dialogue: 0,0:19:22.91,0:19:24.20,Default,,0,0,0,,Балалар
Dialogue: 0,0:19:24.83,0:19:27.70,Default,,0,0,0,,Мен саған айтамын, мұны өзің үшін жасама.
Dialogue: 0,0:19:27.83,0:19:30.16,Default,,0,0,0,,Біз мұны біз үшін жасаймыз
Dialogue: 0,0:19:30.29,0:19:32.42,Default,,0,0,0,,Джумонжи кун!
Dialogue: 0,0:19:32.54,0:19:33.38,Default,,0,0,0,,Пә!
Dialogue: 0,0:19:33.54,0:19:35.38,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:36.17,0:19:38.71,Default,,0,0,0,,Эй~!
Dialogue: 0,0:19:39.46,0:19:45.47,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:48.33,0:20:54.33,Default,,0,0,0,,~♪
Dialogue: 0,0:20:55.46,0:20:58.09,Default,,0,0,0,,Иә! Сан-Антониоға келу...
Dialogue: 0,0:20:58.21,0:21:01.92,Default,,0,0,0,,Сена, сен қайда бардың? Тағы адасып қалдыңыз ба?
Dialogue: 0,0:21:02.05,0:21:03.97,Default,,0,0,0,,Кез келген мәселе бірден шешіледі
Dialogue: 0,0:21:04.09,0:21:05.55,Default,,0,0,0,,Сузунэ Таки осында!
Dialogue: 0,0:21:05.80,0:21:07.18,Default,,0,0,0,,Суық~
Dialogue: 0,0:21:07.43,0:21:09.47,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:21:09.60,0:21:11.72,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:13.23,0:21:14.35,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:15.85,0:21:21.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
