Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.37,0:00:02.29,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:00:02.41,0:00:04.04,Default,,0,0,0,,Скорпион
Dialogue: 0,0:00:04.29,0:00:05.96,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:00:06.42,0:00:10.46,Default,,0,0,0,,Үздік 8-ге өту үшін Деймон мен Докко арасындағы үлкен шайқас
Dialogue: 0,0:00:10.59,0:00:13.05,Default,,0,0,0,,Алайда, таңғаларлығы, сүлгілер болмады.
Dialogue: 0,0:00:13.17,0:00:15.72,Default,,0,0,0,,Бұл үлкен оқиға!
Dialogue: 0,0:00:19.89,0:00:22.27,Default,,0,0,0,,Тығыз ұшын жойыңыз!
Dialogue: 0,0:00:29.11,0:00:30.48,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:00:30.61,0:00:32.61,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:00:33.53,0:00:35.28,Default,,0,0,0,,Шабуыл оқылады
Dialogue: 0,0:00:35.74,0:00:36.53,Default,,0,0,0,,Иә
Dialogue: 0,0:00:36.74,0:00:37.82,Default,,0,0,0,,Кишишиши…
Dialogue: 0,0:00:38.41,0:00:41.79,Default,,0,0,0,,Мұнда американдық футбол ойналады.
Dialogue: 0,0:00:42.00,0:00:42.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:44.00,0:00:46.17,Default,,0,0,0,,Қат! Сіз жасай аласыз ба?
Dialogue: 0,0:00:46.29,0:00:47.83,Default,,0,0,0,,Оны жұдырықпен ұрыңыз
Dialogue: 0,0:00:48.04,0:00:50.34,Default,,0,0,0,,Оны тоқтатудың қажеті жоқ.
Dialogue: 0,0:00:51.13,0:00:51.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:51.88,0:00:52.67,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:00:54.17,0:00:55.38,Default,,0,0,0,,Ол жерден кет!
Dialogue: 0,0:00:55.72,0:01:00.35,Default,,0,0,0,,Қозғалмаңыз! жақсы? Төбенің жындары міндетті түрде келеді
Dialogue: 0,0:01:00.47,0:01:03.10,Default,,0,0,0,,Оған дейін қолымыздан келгенін істейміз!
Dialogue: 0,0:01:05.89,0:01:08.94,Default,,0,0,0,,Иә, сүлік жын болмаса.
Dialogue: 0,0:01:09.06,0:01:11.57,Default,,0,0,0,,Біз Хилл мырзаның орнын толтыру үшін бар күшімізді саламыз!
Dialogue: 0,0:01:12.78,0:01:15.20,Default,,0,0,0,,Мұны сүлік шайтан айтатынына сенімдімін.
Dialogue: 0,0:01:15.32,0:01:19.53,Default,,0,0,0,,«Оян, қарсыласыңның сызығы онша күшті емес».
Dialogue: 0,0:01:20.62,0:01:24.54,Default,,0,0,0,,Сондықтан біз сізді дәл соғып, жолды босатамыз⸺
Dialogue: 0,0:01:24.66,0:01:27.00,Default,,0,0,0,,Енді Eyeshield-kun жүгірісімен барайық.
Dialogue: 0,0:01:27.12,0:01:28.42,Default,,0,0,0,,Барлығы сияқты!
Dialogue: 0,0:01:28.92,0:01:30.04,Default,,0,0,0,,Оши!
Dialogue: 0,0:01:30.17,0:01:31.09,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:01:31.21,0:01:32.92,Default,,0,0,0,,Маған қалдырыңыз! (Комусуби) Фугофуго!
Dialogue: 0,0:01:33.63,0:01:36.13,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:01:36.80,0:01:40.51,Default,,0,0,0,,Оны жойыңыз! Я-Ха-!
Dialogue: 0,0:01:40.93,0:01:42.97,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:01:43.52,0:01:46.02,Default,,0,0,0,,Сүлік жынсыз жарайды ма?
Dialogue: 0,0:01:46.14,0:01:48.98,Default,,0,0,0,,Сіз жеңе аласыз ба? шайтан жарғанақтар
Dialogue: 0,0:01:49.10,0:01:54.11,Default,,0,0,0,,♪~
Dialogue: 0,0:03:06.35,0:03:11.35,Default,,0,0,0,,~♪
Dialogue: 0,0:03:18.99,0:03:22.86,Default,,0,0,0,,Тәуелсіз Скорпиондар 14-0 алға
Dialogue: 0,0:03:26.74,0:03:27.54,Default,,0,0,0,,A-ra
Dialogue: 0,0:03:28.20,0:03:29.91,Default,,0,0,0,,Мусаши-кун
Dialogue: 0,0:03:39.01,0:03:41.22,Default,,0,0,0,,Барлығына сәттілік
Dialogue: 0,0:03:43.30,0:03:44.72,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:44.84,0:03:46.01,Default,,0,0,0,,Ух... (Шағын қорытынды) Ух...
Dialogue: 0,0:03:46.14,0:03:47.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:47.68,0:03:48.97,Default,,0,0,0,,Ух... (крест) Ух...
Dialogue: 0,0:03:49.97,0:03:52.35,Default,,0,0,0,,Кишишиш…
Dialogue: 0,0:03:53.14,0:03:56.69,Default,,0,0,0,,Капитан Хилл Жын Жоқ Деймон Ібіліс Жарғанаттар
Dialogue: 0,0:03:56.98,0:03:59.86,Default,,0,0,0,,Қарқынды мүлдем таба алмаймын
Dialogue: 0,0:03:59.98,0:04:02.65,Default,,0,0,0,,Бірінші тоқсан осылай аяқтала ма?
Dialogue: 0,0:04:03.24,0:04:05.28,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:04:10.83,0:04:14.37,Default,,0,0,0,,Кишиши... Жүгіріп келе жатқаны көрініп тұрды.
Dialogue: 0,0:04:15.46,0:04:19.55,Default,,0,0,0,,Оқылған болса да, Төбе шайтанның орнына барамын.
Dialogue: 0,0:04:20.05,0:04:22.26,Default,,0,0,0,,Көз қалқанын бұзыңыз!
Dialogue: 0,0:04:22.38,0:04:23.51,Default,,0,0,0,,О~
Dialogue: 0,0:04:23.63,0:04:24.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:26.18,0:04:28.14,Default,,0,0,0,,Мені кінәлама, о~
Dialogue: 0,0:04:28.30,0:04:29.10,Default,,0,0,0,,Ха?
Dialogue: 0,0:04:29.22,0:04:30.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:30.22,0:04:31.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:31.81,0:04:32.85,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:04:36.44,0:04:37.48,Default,,0,0,0,,Мені қу!
Dialogue: 0,0:04:37.81,0:04:39.27,Default,,0,0,0,,О~
Dialogue: 0,0:04:41.82,0:04:42.65,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:04:42.78,0:04:44.28,Default,,0,0,0,,Тасу
Dialogue: 0,0:04:47.41,0:04:50.20,Default,,0,0,0,,Иә! (Сүзүнэ) Иә! Я!
Dialogue: 0,0:04:50.41,0:04:52.16,Default,,0,0,0,,Тасу
Dialogue: 0,0:04:52.29,0:04:55.33,Default,,0,0,0,,Eyeshield 21 Toucher!
Dialogue: 0,0:04:55.46,0:04:57.75,Default,,0,0,0,,О... сабыр етіңізші.
Dialogue: 0,0:04:57.96,0:04:58.96,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:59.50,0:05:00.30,Default,,0,0,0,,Бұл жігіттер...
Dialogue: 0,0:05:00.42,0:05:01.46,Default,,0,0,0,,Үлкен мәселе емес.
Dialogue: 0,0:05:01.59,0:05:02.34,Default,,0,0,0,,О
Dialogue: 0,0:05:02.46,0:05:04.17,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,0:05:04.30,0:05:04.92,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:05.97,0:05:07.05,Default,,0,0,0,,Кишиши…
Dialogue: 0,0:05:07.18,0:05:10.51,Default,,0,0,0,,Бұл жай ғана сәтті соққы болды.
Dialogue: 0,0:05:10.76,0:05:15.52,Default,,0,0,0,,Eyeshield қаншалықты тез өссе де, стратегияны оқи алса, ол менікі.
Dialogue: 0,0:05:15.64,0:05:17.73,Default,,0,0,0,,Бұдан былай мен сені одан сайын итеріп жіберемін.
Dialogue: 0,0:05:18.35,0:05:21.77,Default,,0,0,0,,Шаянның шағуынан құтыламын деп ойлама.
Dialogue: 0,0:05:21.90,0:05:23.69,Default,,0,0,0,,Кишишиши…
Dialogue: 0,0:05:24.74,0:05:27.49,Default,,0,0,0,,Деймон қандай да бір жолмен жеке шабуылдан аман қалды
Dialogue: 0,0:05:27.61,0:05:30.41,Default,,0,0,0,,Ұпай 14-тен 6-ға дейін
Dialogue: 0,0:05:32.70,0:05:34.16,Default,,0,0,0,,Сүлік жын жігіт...
Dialogue: 0,0:05:38.25,0:05:41.67,Default,,0,0,0,,Баршаңызға, әлі уақыт бар. Тынышталайық.
Dialogue: 0,0:05:41.79,0:05:42.96,Default,,0,0,0,,Кишишиши…
Dialogue: 0,0:05:43.09,0:05:46.01,Default,,0,0,0,,Бұл қорғаушы пас беруге сенімсіз болуы керек⸺
Dialogue: 0,0:05:46.13,0:05:51.01,Default,,0,0,0,,Келесі жолы тынышталғанда, көзге арналған қалқан алу мүмкіндігі 100%.
Dialogue: 0,0:05:51.18,0:05:52.81,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:05:58.48,0:05:59.98,Default,,0,0,0,,Қабақ қалқаны!
Dialogue: 0,0:06:00.15,0:06:01.48,Default,,0,0,0,,Уау~
Dialogue: 0,0:06:01.61,0:06:03.19,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:06:03.73,0:06:06.36,Default,,0,0,0,,Көз қалқаны-күн езілген
Dialogue: 0,0:06:06.49,0:06:08.65,Default,,0,0,0,,Хэй~ Бұл ауыр…
Dialogue: 0,0:06:09.49,0:06:12.03,Default,,0,0,0,,Бұл пьеса көп оқылады.
Dialogue: 0,0:06:12.16,0:06:14.99,Default,,0,0,0,,Бүкіл стратегия дұрыс емес болып кеткен сияқты.
Dialogue: 0,0:06:15.37,0:06:16.62,Default,,0,0,0,,Кишишиши…
Dialogue: 0,0:06:16.75,0:06:20.29,Default,,0,0,0,,Американдық футбол – бұл жерде ойналатын психологиялық ойын.
Dialogue: 0,0:06:20.42,0:06:23.38,Default,,0,0,0,,Бұлшық етті ақымақ қанша тырысса да, пайдасы жоқ.
Dialogue: 0,0:06:23.50,0:06:27.34,Default,,0,0,0,,Тіпті патша сарайы мен батыс менің жауым емес.
Dialogue: 0,0:06:27.67,0:06:29.09,Default,,0,0,0,,Бұл әдет пе?
Dialogue: 0,0:06:29.22,0:06:32.47,Default,,0,0,0,,Аа, жай ғана ресми ойындардағы деректерді талдау⸺
Dialogue: 0,0:06:32.60,0:06:35.52,Default,,0,0,0,,Қарсыластың осы уақытқа дейінгі стратегиясын болжау мүмкін емес.
Dialogue: 0,0:06:36.10,0:06:41.48,Default,,0,0,0,,Канекуши есімді жігіт Деймон ойыншыларының егжей-тегжейлі әдеттерін бақылап отыр.
Dialogue: 0,0:06:41.90,0:06:46.23,Default,,0,0,0,,Бірақ сүлік жындардың жоқтығы Деймон үшін одан да ауыр.
Dialogue: 0,0:06:47.07,0:06:49.20,Default,,0,0,0,,Осымен екінші жақтың жүгірісі мөрленеді.
Dialogue: 0,0:06:49.61,0:06:53.74,Default,,0,0,0,,Қорғаушыны ауыстырмаңыз, ол фол үшін шақырылса маған бәрібір.
Dialogue: 0,0:06:53.99,0:06:58.25,Default,,0,0,0,,Мына кішіпейіл қорғаушыны жойып, оны шығарып жіберіңіз.
Dialogue: 0,0:06:58.62,0:07:01.12,Default,,0,0,0,,Онда біздікі.
Dialogue: 0,0:07:01.25,0:07:03.21,Default,,0,0,0,,Кишишиш…
Dialogue: 0,0:07:03.54,0:07:07.17,Default,,0,0,0,,1-ші ширек Деймонның шабуылынан 1 минут қалды
Dialogue: 0,0:07:07.71,0:07:09.84,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:07:12.72,0:07:14.26,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:07:14.39,0:07:16.47,Default,,0,0,0,,Уау~
Dialogue: 0,0:07:17.35,0:07:18.35,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:18.47,0:07:20.31,Default,,0,0,0,,Өтіп бара жатқан адамның күлуі
Dialogue: 0,0:07:21.77,0:07:23.15,Default,,0,0,0,,Ishimaru-kun!
Dialogue: 0,0:07:23.40,0:07:25.11,Default,,0,0,0,,Менің артымнан келдің бе?
Dialogue: 0,0:07:25.77,0:07:26.94,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:07:29.90,0:07:31.15,Default,,0,0,0,,Исимару мырза
Dialogue: 0,0:07:32.32,0:07:33.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:34.41,0:07:35.20,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:07:35.32,0:07:36.53,Default,,0,0,0,,Сіз мұны әдейі істедіңіз.
Dialogue: 0,0:07:36.66,0:07:38.20,Default,,0,0,0,,Бұл артық емес пе?
Dialogue: 0,0:07:38.91,0:07:40.96,Default,,0,0,0,,Сабыр етіңіз, сізді шығарып жібереді.
Dialogue: 0,0:07:41.21,0:07:44.08,Default,,0,0,0,,Мен пасты лақтырып болған соң, онымен соқтығыстым⸺
Dialogue: 0,0:07:44.21,0:07:46.21,Default,,0,0,0,,Бұл анық бұзушылық.
Dialogue: 0,0:07:46.34,0:07:49.38,Default,,0,0,0,,Дара сепкіштер 15 ярд артта тұруы керек
Dialogue: 0,0:07:49.51,0:07:52.34,Default,,0,0,0,,Бірақ бірінші тоқсанда уақыт жоқ
Dialogue: 0,0:07:53.26,0:07:54.72,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:07:54.84,0:07:56.55,Default,,0,0,0,,1-тоқсанның соңы
Dialogue: 0,0:07:57.26,0:07:59.22,Default,,0,0,0,,Сіз мұнымен өте алмайсыз.
Dialogue: 0,0:07:59.35,0:08:02.31,Default,,0,0,0,,Мен тіпті стратегия ойлай алмаймын... Қиындыққа ұшырадым.
Dialogue: 0,0:08:02.44,0:08:03.19,Default,,0,0,0,,Иә
Dialogue: 0,0:08:03.31,0:08:04.48,Default,,0,0,0,,Барлығы... (Сена Монта) А?
Dialogue: 0,0:08:04.60,0:08:05.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:06.98,0:08:09.53,Default,,0,0,0,,Кешіріңіз, бұл пайдалы емес.
Dialogue: 0,0:08:09.65,0:08:10.90,Default,,0,0,0,,Ах... жақсы...
Dialogue: 0,0:08:11.03,0:08:12.95,Default,,0,0,0,,Бұл Ишимару-санның кінәсі...
Dialogue: 0,0:08:16.07,0:08:18.91,Default,,0,0,0,,Қат! Енді мен қалай күресуім керек...
Dialogue: 0,0:08:19.08,0:08:20.16,Default,,0,0,0,,Мен бәрібір ұтылмасам...
Dialogue: 0,0:08:20.29,0:08:22.04,Default,,0,0,0,,Оларды ұрыңыз...
Dialogue: 0,0:08:22.29,0:08:23.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:23.50,0:08:24.87,Default,,0,0,0,,Мен саған мынаны беремін.
Dialogue: 0,0:08:25.00,0:08:25.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:26.08,0:08:28.09,Default,,0,0,0,,Бұл неміс соғысының ойын жоспары.
Dialogue: 0,0:08:28.25,0:08:31.21,Default,,0,0,0,,Бірінші тоқсаннан кейін ғана қажет
Dialogue: 0,0:08:31.96,0:08:33.97,Default,,0,0,0,,Оған дейін ашпаңыз.
Dialogue: 0,0:08:34.09,0:08:35.76,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:08:36.59,0:08:38.89,Default,,0,0,0,,Мен мұны Мистер Хилл Демоннан сақтадым.
Dialogue: 0,0:08:39.10,0:08:41.06,Default,,0,0,0,,Иә? Хилл Демоннан ма?
Dialogue: 0,0:08:41.18,0:08:42.52,Default,,0,0,0,,Не?
Dialogue: 0,0:08:44.19,0:08:46.23,Default,,0,0,0,,«Бірінші тоқсанның соңында⸺»
Dialogue: 0,0:08:46.35,0:08:49.73,Default,,0,0,0,,«Ұпай 14-6, ерекше көшбасшы».
Dialogue: 0,0:08:49.86,0:08:53.99,Default,,0,0,0,,«Деймонның ұпайы - Eyeshield-тің аяғына жақындауы»
Dialogue: 0,0:08:54.11,0:08:56.95,Default,,0,0,0,,«Қап қалған жау ширақшыны талқандауға келеді».
Dialogue: 0,0:08:57.07,0:08:58.07,Default,,0,0,0,,Бұл... бұл...
Dialogue: 0,0:08:58.28,0:08:59.49,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:08:59.66,0:09:00.95,Default,,0,0,0,,Төбе жын, бұл болады⸺
Dialogue: 0,0:09:01.08,0:09:02.66,Default,,0,0,0,,Сіз бәрін білдіңіз бе?
Dialogue: 0,0:09:02.79,0:09:04.91,Default,,0,0,0,,Бұл мүмкін, өйткені бұл сүлік жын туралы.
Dialogue: 0,0:09:05.04,0:09:07.88,Default,,0,0,0,,А-а, болмайды, сүлгі жын, әдейі...
Dialogue: 0,0:09:08.00,0:09:12.09,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:09:18.18,0:09:20.81,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:20.93,0:09:23.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:25.98,0:09:27.23,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:09:27.35,0:09:28.60,Default,,0,0,0,,Мистер Хилл Демон
Dialogue: 0,0:09:28.73,0:09:31.02,Default,,0,0,0,,Ақыры төбе жын келді
Dialogue: 0,0:09:31.15,0:09:31.94,Default,,0,0,0,,Хилл жын
Dialogue: 0,0:09:32.07,0:09:34.19,Default,,0,0,0,,Иә! Сіз ағаңыз пайда болды
Dialogue: 0,0:09:34.40,0:09:36.57,Default,,0,0,0,,Ах... Жақсы.
Dialogue: 0,0:09:38.41,0:09:41.53,Default,,0,0,0,,Иә, сенрё актері осында ма?
Dialogue: 0,0:09:41.78,0:09:44.20,Default,,0,0,0,,Қуанамын, сүлік жын, аман болдың.
Dialogue: 0,0:09:44.33,0:09:45.00,Default,,0,0,0,,Фуго
Dialogue: 0,0:09:45.45,0:09:50.96,Default,,0,0,0,,Сіз қауіпсізсіз бе? Не айтқың келеді? Кекекеке...
Dialogue: 0,0:09:51.50,0:09:54.92,Default,,0,0,0,,Е, дододо... неге...
Dialogue: 0,0:09:55.09,0:09:58.13,Default,,0,0,0,,Хмм, мен қате оқыдым ба?
Dialogue: 0,0:09:58.26,0:10:02.93,Default,,0,0,0,,Ugg... Ugg... Kische!
Dialogue: 0,0:10:03.47,0:10:05.35,Default,,0,0,0,,Біз сөзсіз сүлгі жындармыз⸺
Dialogue: 0,0:10:05.47,0:10:06.98,Default,,0,0,0,,Мен сенің келетініңе сендім.
Dialogue: 0,0:10:07.10,0:10:07.94,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:08.06,0:10:11.81,Default,,0,0,0,,Ке! Сіз қалай ойлайсыз? Жақсы оқыдың ба?
Dialogue: 0,0:10:11.94,0:10:14.78,Default,,0,0,0,,Сіз американдық футболда қызу арқылы жеңе алмайсыз.
Dialogue: 0,0:10:15.03,0:10:17.45,Default,,0,0,0,,О... иә
Dialogue: 0,0:10:17.99,0:10:21.53,Default,,0,0,0,,Мұнда тек ыстық болады.
Dialogue: 0,0:10:21.87,0:10:27.00,Default,,0,0,0,,Жүрегіңді ыстық, басыңды салқын ұста. Бұл американдық футбол.
Dialogue: 0,0:10:27.79,0:10:29.37,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:10:29.50,0:10:32.67,Default,,0,0,0,,Сүлік жын бізге мынаны үйретуге тырысты...
Dialogue: 0,0:10:36.13,0:10:37.55,Default,,0,0,0,,Жақсы істе
Dialogue: 0,0:10:38.22,0:10:40.38,Default,,0,0,0,,Эй, сұмдық хонмаге
Dialogue: 0,0:10:40.72,0:10:45.14,Default,,0,0,0,,Сіз ми ойындарын жақсы меңгерген сияқтысыз, бірақ оны IQ ойыны дейік.
Dialogue: 0,0:10:45.26,0:10:47.64,Default,,0,0,0,,Ой... о, маған қарашы.
Dialogue: 0,0:10:48.56,0:10:52.31,Default,,0,0,0,,Хи хи хи хи...
Dialogue: 0,0:10:53.23,0:10:56.61,Default,,0,0,0,,Эй, сүлік жын, сен қандай стратегияны қолданасың?
Dialogue: 0,0:10:56.78,0:10:58.24,Default,,0,0,0,,Ең алдымен, осы.
Dialogue: 0,0:10:58.36,0:10:59.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:02.32,0:11:03.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:03.32,0:11:06.83,Default,,0,0,0,,Бұл сіздің жеке стратегияға арналған құпия қаруыңыз.
Dialogue: 0,0:11:07.54,0:11:09.96,Default,,0,0,0,,Иә? Ерін далабы?
Dialogue: 0,0:11:10.33,0:11:11.33,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:11:11.46,0:11:13.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:14.04,0:11:16.84,Default,,0,0,0,,Енді екінші тоқсан басталды.
Dialogue: 0,0:11:16.96,0:11:19.26,Default,,0,0,0,,Деймонның оралуы бар ма?
Dialogue: 0,0:11:21.55,0:11:23.72,Default,,0,0,0,,Сонымен... Деймон...
Dialogue: 0,0:11:27.72,0:11:31.14,Default,,0,0,0,,Не болды? Сол макияж
Dialogue: 0,0:11:31.52,0:11:32.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:32.44,0:11:34.90,Default,,0,0,0,,Не... жоқ...
Dialogue: 0,0:11:35.02,0:11:38.03,Default,,0,0,0,,Бірақ көңіл-күйіңіз жақсы сияқты.
Dialogue: 0,0:11:44.03,0:11:46.62,Default,,0,0,0,,Жау жерге тиіп тұр. Саусағыңыздың ұшына қараңыз.
Dialogue: 0,0:11:46.91,0:11:48.95,Default,,0,0,0,,Егер сіз рұқсат қағазының орнына жүгірумен асығыңыз келсе⸺
Dialogue: 0,0:11:49.08,0:11:53.17,Default,,0,0,0,,Барынша қатты соғу үшін менің салмағым табиғи түрде саусақтарыма түседі.
Dialogue: 0,0:11:53.50,0:11:57.67,Default,,0,0,0,,Қан сонда жиналып, әлсіз қызыл түске боялады.
Dialogue: 0,0:11:58.30,0:12:00.63,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:12:00.92,0:12:03.84,Default,,0,0,0,,Кишиши... шешілді, Деймон жүгіріп келеді.
Dialogue: 0,0:12:04.05,0:12:05.80,Default,,0,0,0,,Көз қалқанын бұзыңыз!
Dialogue: 0,0:12:06.01,0:12:07.35,Default,,0,0,0,,алға ұмтылу
Dialogue: 0,0:12:07.47,0:12:08.89,Default,,0,0,0,,Сіз оны жүгіру деп оқыдыңыз ба?
Dialogue: 0,0:12:11.48,0:12:14.40,Default,,0,0,0,,Киш не? маймылға өту
Dialogue: 0,0:12:15.48,0:12:16.77,Default,,0,0,0,,Иә! Барыңыз~
Dialogue: 0,0:12:16.90,0:12:18.19,Default,,0,0,0,,Сәтті операция
Dialogue: 0,0:12:18.57,0:12:20.28,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:20.82,0:12:22.90,Default,,0,0,0,,Деймон 2 ұпай айырмашылығы
Dialogue: 0,0:12:23.78,0:12:25.78,Default,,0,0,0,,Бұл рас... Бұл сөзсіз рас...
Dialogue: 0,0:12:25.99,0:12:29.58,Default,,0,0,0,,Барлығының саусақтары қызарғанын байқау қиын емес...
Dialogue: 0,0:12:35.12,0:12:36.75,Default,,0,0,0,,Жақсы өтті.
Dialogue: 0,0:12:37.29,0:12:39.17,Default,,0,0,0,,Ерін далабы осы үшін керек еді, солай ма?
Dialogue: 0,0:12:39.30,0:12:40.75,Default,,0,0,0,,Seco... Seco
Dialogue: 0,0:12:40.88,0:12:44.38,Default,,0,0,0,,Киш! Келесі жолы олай болмайды.
Dialogue: 0,0:12:45.05,0:12:46.68,Default,,0,0,0,,Қарсыласыңызға маршрутыңызды оқуға жол бермеңіз⸺
Dialogue: 0,0:12:46.80,0:12:49.31,Default,,0,0,0,,Ресиверді шатастырып алу үшін мұнда және мұнда қараңыз.
Dialogue: 0,0:12:49.72,0:12:52.60,Default,,0,0,0,,Тыңда, жау қабылдаушының көзіне қара.
Dialogue: 0,0:12:52.73,0:12:57.48,Default,,0,0,0,,Көздеріңіз айнала бастағанда, ең алғаш қайда қарағаныңызды есіңізде сақтаңыз.
Dialogue: 0,0:12:57.61,0:12:59.19,Default,,0,0,0,,Ол сол жерге бұрылады.
Dialogue: 0,0:12:59.61,0:13:00.40,Default,,0,0,0,,Егер мені өлтірсең, сен де менің сияқты қарғыс атқан жанға айналасың.
Dialogue: 0,0:13:00.52,0:13:02.40,Default,,0,0,0,,Соңғысы емес пе?
Dialogue: 0,0:13:02.78,0:13:05.07,Default,,0,0,0,,Жүгіру үшін белгіленген маршруты бар адам⸺
Dialogue: 0,0:13:05.20,0:13:07.36,Default,,0,0,0,,Ешқайда іздеудің қажеті жоқ
Dialogue: 0,0:13:12.29,0:13:13.91,Default,,0,0,0,,Хмм... Уф.
Dialogue: 0,0:13:14.50,0:13:15.12,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:13:15.25,0:13:16.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:16.92,0:13:18.17,Default,,0,0,0,,Айналаңызға қарап не істеп жатырсыз?
Dialogue: 0,0:13:18.29,0:13:20.21,Default,,0,0,0,,Сіз бірінші рет көру мүмкіндігін жоғалтқан нүкте⸺
Dialogue: 0,0:13:20.34,0:13:22.00,Default,,0,0,0,,Мен алдауға тырысамын.
Dialogue: 0,0:13:22.80,0:13:24.80,Default,,0,0,0,,Егер Хилл Демон айтқандай болса...
Dialogue: 0,0:13:25.09,0:13:27.05,Default,,0,0,0,,Ол сол жерге бұрылады.
Dialogue: 0,0:13:27.18,0:13:29.30,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:13:34.52,0:13:35.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:35.64,0:13:36.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:38.40,0:13:39.02,Default,,0,0,0,,(Нацуме) Болады, бірақ мен оны шын мәнінде ұсынбаймын.
Dialogue: 0,0:13:39.56,0:13:40.77,Default,,0,0,0,,Кішет
Dialogue: 0,0:13:41.52,0:13:42.86,Default,,0,0,0,,Уау~
Dialogue: 0,0:13:43.32,0:13:44.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:47.28,0:13:50.45,Default,,0,0,0,,Жүр! көз қалқаны 21
Dialogue: 0,0:13:56.25,0:13:57.08,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:13:57.21,0:14:00.58,Default,,0,0,0,,Доймонның қондыру
Dialogue: 0,0:14:00.71,0:14:03.05,Default,,0,0,0,,Соңында керісінше
Dialogue: 0,0:14:03.80,0:14:06.55,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:14:06.67,0:14:09.76,Default,,0,0,0,,Deimon Angry қатарынан соққылар
Dialogue: 0,0:14:09.89,0:14:14.35,Default,,0,0,0,,Жоқ, Хилл Демонның қосылуымен сіз қарқыныңызды толығымен қалпына келтірдіңіз.
Dialogue: 0,0:14:14.47,0:14:16.73,Default,,0,0,0,,Бұл бастапқы балшық қақпасы.
Dialogue: 0,0:14:17.06,0:14:19.60,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:14:19.73,0:14:21.06,Default,,0,0,0,,Соңғы кездері осы қонақүйдің сапасы сәл төмендеген сияқты…
Dialogue: 0,0:14:21.27,0:14:23.32,Default,,0,0,0,,Енді неге?
Dialogue: 0,0:14:23.44,0:14:28.03,Default,,0,0,0,,Уф... Енді менің кезегім. Бұл жолы мен болжаймын.
Dialogue: 0,0:14:28.32,0:14:30.07,Default,,0,0,0,,Кімге өту керектігін біліңіз
Dialogue: 0,0:14:30.20,0:14:32.07,Default,,0,0,0,,Мақсатқа жетуге бел буған ойыншылар⸺
Dialogue: 0,0:14:32.20,0:14:35.04,Default,,0,0,0,,Мен позицияға әдеттен тыс ынтамен кірісемін.
Dialogue: 0,0:14:37.66,0:14:40.17,Default,,0,0,0,,Ахаха
Dialogue: 0,0:14:40.62,0:14:42.29,Default,,0,0,0,,Өте табиғи емес
Dialogue: 0,0:14:42.42,0:14:44.25,Default,,0,0,0,,Жол жүру билеті кім?
Dialogue: 0,0:14:46.38,0:14:48.22,Default,,0,0,0,,Ахаха
Dialogue: 0,0:14:48.38,0:14:50.51,Default,,0,0,0,,Кишиши... Тығыз соңы.
Dialogue: 0,0:14:50.68,0:14:52.18,Default,,0,0,0,,Уау~
Dialogue: 0,0:14:52.30,0:14:54.68,Default,,0,0,0,,Ахаха
Dialogue: 0,0:14:54.81,0:14:58.06,Default,,0,0,0,,Киш! Не? Маймылға қайтадан өту керек пе?
Dialogue: 0,0:14:59.27,0:15:01.35,Default,,0,0,0,,Максималды ұстаңыз!
Dialogue: 0,0:15:01.48,0:15:02.10,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:15:02.23,0:15:05.36,Default,,0,0,0,,Деймон тағы да ұпай жинайды
Dialogue: 0,0:15:05.48,0:15:06.65,Default,,0,0,0,,Ахаха
Dialogue: 0,0:15:06.78,0:15:08.36,Default,,0,0,0,,Бұл... бұл ақымақтық.
Dialogue: 0,0:15:08.49,0:15:11.32,Default,,0,0,0,,Бұл біртүрлі толқу жалған ба?
Dialogue: 0,0:15:11.45,0:15:12.20,Default,,0,0,0,,A… aha…
Dialogue: 0,0:15:12.32,0:15:17.04,Default,,0,0,0,,Сол бір ақымақтың арқасында әйтеуір алданып қаласың.
Dialogue: 0,0:15:17.41,0:15:21.25,Default,,0,0,0,,Ахаха... өте қызық
Dialogue: 0,0:15:21.79,0:15:25.71,Default,,0,0,0,,Қарсылас өте нашар. Егер сіз осындай аренада жарыссаңыз⸺
Dialogue: 0,0:15:25.84,0:15:28.71,Default,,0,0,0,,Әлгі сүлгі жынға төтеп бере аламын деп ойлаудың өзі біртүрлі.
Dialogue: 0,0:15:29.34,0:15:30.67,Default,,0,0,0,,Орнату!
Dialogue: 0,0:15:34.85,0:15:37.81,Default,,0,0,0,,Жау, сенің оң аяғың әдеттегіден 5 сантиметрге төмен.
Dialogue: 0,0:15:37.93,0:15:40.64,Default,,0,0,0,,Ол ішке кіруге дайын. Ол жүгіруге келеді.
Dialogue: 0,0:15:40.77,0:15:41.44,Default,,0,0,0,,Иә
Dialogue: 0,0:15:41.56,0:15:42.60,Default,,0,0,0,,Қалпақ қалпақ!
Dialogue: 0,0:15:46.57,0:15:48.32,Default,,0,0,0,,Ой...
Dialogue: 0,0:15:48.44,0:15:50.95,Default,,0,0,0,,Уга~ (Бусудзима) Қарғыс атсын
Dialogue: 0,0:15:51.07,0:15:54.32,Default,,0,0,0,,Ой~ (Көрермен В) Мен жүгіруді қайтадан тоқтаттым~
Dialogue: 0,0:15:56.03,0:15:57.70,Default,,0,0,0,,Доймон Доймон…
Dialogue: 0,0:15:57.83,0:15:59.62,Default,,0,0,0,,Доймон Доймон…
Dialogue: 0,0:16:00.29,0:16:04.96,Default,,0,0,0,,Тәуелсіз хабар таратушылардың екінші сөзді оқу арқылы алға жылжығаны жақсы.
Dialogue: 0,0:16:05.08,0:16:08.92,Default,,0,0,0,,Бізді оқылады деп ойламағанымыз таң қалдырады.
Dialogue: 0,0:16:09.05,0:16:11.42,Default,,0,0,0,,Кекеке! Бұл кішкентай трюк
Dialogue: 0,0:16:11.55,0:16:14.89,Default,,0,0,0,,Бұны тек өз қылықтарын өшірмегендер ғана түсіне алады.
Dialogue: 0,0:16:15.01,0:16:19.47,Default,,0,0,0,,Киш, стратегияны оқитын кез келді.
Dialogue: 0,0:16:20.02,0:16:23.02,Default,,0,0,0,,Бірақ бұл жерде жеңімпаз - тәуелсіз тарату.
Dialogue: 0,0:16:23.14,0:16:26.98,Default,,0,0,0,,Балшық қақпасында аз ғана адам бар, сондықтан оны жаншып, шыдамдылықты ұрлаңыз.
Dialogue: 0,0:16:27.48,0:16:32.40,Default,,0,0,0,,14-24 Деймон басқарады, ақыры соңғы тоқсан.
Dialogue: 0,0:16:34.78,0:16:37.41,Default,,0,0,0,,Әй, неге соңына дейін қарамайсың?
Dialogue: 0,0:16:38.12,0:16:40.12,Default,,0,0,0,,Иә, мен тағы келемін
Dialogue: 0,0:16:46.54,0:16:47.67,Default,,0,0,0,,Кішкентай жігітті басып таста!
Dialogue: 0,0:16:47.79,0:16:49.13,Default,,0,0,0,,Уау~
Dialogue: 0,0:16:54.97,0:16:56.64,Default,,0,0,0,,Кішкентай жігіттің де қолынан келеді
Dialogue: 0,0:16:56.76,0:16:58.18,Default,,0,0,0,,Ібіліс шайтандары⸺
Dialogue: 0,0:16:58.30,0:17:01.81,Default,,0,0,0,,Тек жақсы американдық футбол ойнауға болады. Тәуелсіз хабар таратудан ұтыла алмаймын.
Dialogue: 0,0:17:11.65,0:17:12.65,Default,,0,0,0,,Уау~
Dialogue: 0,0:17:12.90,0:17:14.03,Default,,0,0,0,,О...
Dialogue: 0,0:17:15.90,0:17:16.95,Default,,0,0,0,,Уау
Dialogue: 0,0:17:20.95,0:17:21.58,Default,,0,0,0,,Кишет
Dialogue: 0,0:17:28.13,0:17:30.46,Default,,0,0,0,,Киш!
Dialogue: 0,0:17:34.13,0:17:35.34,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:17:35.47,0:17:37.30,Default,,0,0,0,,Тасу
Dialogue: 0,0:17:39.30,0:17:43.18,Default,,0,0,0,,Не! Сериялық шайтанның елесі?
Dialogue: 0,0:17:43.93,0:17:45.81,Default,,0,0,0,,Мен... қазір...
Dialogue: 0,0:17:48.19,0:17:52.65,Default,,0,0,0,,Көз қалқаны 21 Қайтадан дамыды ма?
Dialogue: 0,0:17:53.44,0:17:55.32,Default,,0,0,0,,А, мен мұны істеймін.
Dialogue: 0,0:17:55.44,0:17:58.91,Default,,0,0,0,,Ей, Кәкей, анау жасанды көз қалқан.
Dialogue: 0,0:17:59.03,0:17:59.70,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:59.82,0:18:00.53,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:01.37,0:18:03.45,Default,,0,0,0,,Бұл жалған.
Dialogue: 0,0:18:03.91,0:18:07.33,Default,,0,0,0,,Хи хи хи... Я-Ха-!
Dialogue: 0,0:18:07.46,0:18:08.08,Default,,0,0,0,,Пион…
Dialogue: 0,0:18:08.21,0:18:10.96,Default,,0,0,0,,Ойын аяқталды Деймон жеңіліспен жеңеді!
Dialogue: 0,0:18:11.88,0:18:15.42,Default,,0,0,0,,(Деймон мүшелерінің қуанышты дауыстары)
Dialogue: 0,0:18:15.71,0:18:17.01,Default,,0,0,0,,...Бұл Мамо-ни дегенді білдіреді.
Dialogue: 0,0:18:17.13,0:18:19.01,Default,,0,0,0,,Иә, бұл⸺
Dialogue: 0,0:18:20.43,0:18:22.05,Default,,0,0,0,,Ең жақсы 8
Dialogue: 0,0:18:22.47,0:18:24.31,Default,,0,0,0,,8 команда қалғанда...
Dialogue: 0,0:18:24.43,0:18:26.31,Default,,0,0,0,,Ақырында келген сияқты.
Dialogue: 0,0:18:26.43,0:18:27.39,Default,,0,0,0,,Иә
Dialogue: 0,0:18:27.64,0:18:31.56,Default,,0,0,0,,Хм, мен Деймонның матчын бірінші рет тікелей эфирде көрдім...
Dialogue: 0,0:18:31.69,0:18:34.02,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:34.15,0:18:37.07,Default,,0,0,0,,Ей, Кәкей, бірінші турды көргім келеді⸺
Dialogue: 0,0:18:37.19,0:18:39.95,Default,,0,0,0,,Біз орындықта жарты жолда отыра алмаймыз ба?
Dialogue: 0,0:18:40.20,0:18:43.78,Default,,0,0,0,,Мазалама, енді оны жасырудың қажеті жоқ.
Dialogue: 0,0:18:43.91,0:18:45.91,Default,,0,0,0,,Толық қатысумен шыдаңыз
Dialogue: 0,0:18:46.45,0:18:47.83,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:47.96,0:18:50.42,Default,,0,0,0,,Бірақ, түсінікті болу үшін...
Dialogue: 0,0:18:50.54,0:18:52.75,Default,,0,0,0,,(Деймон мүшелерінің қуанышты дауыстары)
Dialogue: 0,0:18:53.09,0:18:54.88,Default,,0,0,0,,Фугофуго
Dialogue: 0,0:18:55.75,0:18:58.13,Default,,0,0,0,,Демек, ол менің жауым емес.
Dialogue: 0,0:18:59.97,0:19:02.39,Default,,0,0,0,,Мынау... Мен сондай ақымақпын...
Dialogue: 0,0:19:02.51,0:19:06.31,Default,,0,0,0,,Аа, бұл арман. Иә, бұл арман.
Dialogue: 0,0:19:06.43,0:19:08.35,Default,,0,0,0,,Сондықтан сіз сондасыз
Dialogue: 0,0:19:08.48,0:19:10.56,Default,,0,0,0,,Негізі олар мені ұстап алуы керек еді.
Dialogue: 0,0:19:10.69,0:19:12.81,Default,,0,0,0,,Маған телефон соғып, «Сізді дер кезінде ұстадық» деді.
Dialogue: 0,0:19:12.94,0:19:14.69,Default,,0,0,0,,Сіз қашып құтыла алмайсыз.
Dialogue: 0,0:19:15.40,0:19:16.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:16.44,0:19:19.19,Default,,0,0,0,,Әй, сен оны өзің бөліп алдың.
Dialogue: 0,0:19:19.32,0:19:20.11,Default,,0,0,0,,(ойнату түймесін басқан дыбыс)
Dialogue: 0,0:19:20.24,0:19:22.32,Default,,0,0,0,,«Маған қоңырау шалды, олар мені жоспарлағандай ұстап алды.»
Dialogue: 0,0:19:22.45,0:19:23.99,Default,,0,0,0,,«Сізден құтылу мүмкін емес».
Dialogue: 0,0:19:24.12,0:19:25.12,Default,,0,0,0,,(Тоқтату түймесін басқан дыбыс)
Dialogue: 0,0:19:26.45,0:19:28.29,Default,,0,0,0,,Пасири шешімі
Dialogue: 0,0:19:28.45,0:19:33.29,Default,,0,0,0,,Киш! Маған одан үзіліс беріңізші~
Dialogue: 0,0:19:33.42,0:19:36.92,Default,,0,0,0,,Кекекеке…
Dialogue: 0,0:19:38.01,0:19:43.01,Default,,0,0,0,,♪~
Dialogue: 0,0:20:45.66,0:20:50.66,Default,,0,0,0,,~♪
Dialogue: 0,0:20:54.00,0:20:57.25,Default,,0,0,0,,Иә! Үздік 8-ге өту...
Dialogue: 0,0:20:57.38,0:20:58.96,Default,,0,0,0,,Бұл тіпті дұрыс емес.
Dialogue: 0,0:20:59.09,0:21:02.55,Default,,0,0,0,,Бұл үлкен мәселе. Комусуби үйден қашып кетті.
Dialogue: 0,0:21:02.67,0:21:04.30,Default,,0,0,0,,Мен сені іздеймін.
Dialogue: 0,0:21:04.42,0:21:06.89,Default,,0,0,0,,Осындай маңызды уақытта?
Dialogue: 0,0:21:07.01,0:21:10.85,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21» «Физикалық айырмашылықтар қабырғасы»
Dialogue: 0,0:21:10.97,0:21:12.85,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:14.35,0:21:20.35,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory