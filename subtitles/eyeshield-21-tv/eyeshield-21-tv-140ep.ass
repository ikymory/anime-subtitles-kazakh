Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.29,0:00:08.59,Default,,0,0,0,,Олар бұл турнирдің ешбір жерінде татуға рұқсат бермеді⸺
Dialogue: 0,0:00:08.67,0:00:12.05,Default,,0,0,0,,Ең күшті қорғаныс патша сарайынан, ақырында...
Dialogue: 0,0:00:12.63,0:00:17.01,Default,,0,0,0,,Ақыры, енді біз темір тұлпар, жеңілмейтін қамалды жарып өттік...
Dialogue: 0,0:00:17.10,0:00:20.02,Default,,0,0,0,,Сена мен Монтаның қос тауы!
Dialogue: 0,0:00:20.02,0:00:20.97,Default,,0,0,0,,Сена мен Монтаның қос тауы!
Dialogue: 0,0:00:20.02,0:00:20.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:21.06,0:00:23.73,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:00:23.81,0:00:26.69,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:00:26.77,0:00:28.23,Default,,0,0,0,,Екінші таймға 8 минут қалды
Dialogue: 0,0:00:28.31,0:00:30.65,Default,,0,0,0,,Мен Деймонды ақыры қуып жеттім!
Dialogue: 0,0:00:30.73,0:00:33.61,Default,,0,0,0,,Ібіліс жарғанақтар! Ібіліс жарғанақтар! Ібіліс жарғанақтар!
Dialogue: 0,0:00:34.53,0:00:37.45,Default,,0,0,0,,Мен және Сеннаның комбинациясы Марк жеңді!
Dialogue: 0,0:00:37.53,0:00:38.45,Default,,0,0,0,,Эххе
Dialogue: 0,0:00:38.53,0:00:39.91,Default,,0,0,0,,Керемет!
Dialogue: 0,0:00:39.99,0:00:40.83,Default,,0,0,0,,Фуго!
Dialogue: 0,0:00:40.91,0:00:41.95,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:00:42.04,0:00:42.91,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:00:43.00,0:00:44.16,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:00:44.25,0:00:47.17,Default,,0,0,0,,Бұл ғажап Эй, жасайсың!
Dialogue: 0,0:00:47.25,0:00:50.34,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:00:53.26,0:00:55.09,Default,,0,0,0,,Сакураба…
Dialogue: 0,0:00:56.59,0:01:00.18,Default,,0,0,0,,Рухтың жетегінде кеткен
Dialogue: 0,0:01:01.06,0:01:03.39,Default,,0,0,0,,Ууууууууууууу
Dialogue: 0,0:01:04.06,0:01:05.85,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:01:07.10,0:01:09.94,Default,,0,0,0,,ДжоДжо қарсы Вамуу—
Dialogue: 0,0:01:12.98,0:01:17.95,Default,,0,0,0,,♪~
Dialogue: 0,0:02:32.52,0:02:37.90,Default,,0,0,0,,~♪
Dialogue: 0,0:02:44.53,0:02:45.91,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:02:48.37,0:02:51.75,Default,,0,0,0,,Сакурба-сенпайды мінсіз белгілеп, белгілеңіз!
Dialogue: 0,0:02:52.25,0:02:54.71,Default,,0,0,0,,Жүр! Сакураба!
Dialogue: 0,0:02:54.79,0:02:56.71,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:02:56.80,0:02:57.92,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:02:58.01,0:02:59.38,Default,,0,0,0,,Жоғалту мүмкін емес
Dialogue: 0,0:03:00.01,0:03:01.09,Default,,0,0,0,,Уф
Dialogue: 0,0:03:01.76,0:03:04.35,Default,,0,0,0,,шықты! Бұл Эверест асуы!
Dialogue: 0,0:03:05.31,0:03:07.06,Default,,0,0,0,,Бұл күшті шабуыл!
Dialogue: 0,0:03:07.14,0:03:09.43,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:10.44,0:03:11.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:12.10,0:03:16.02,Default,,0,0,0,,Ууууууууууууу (Сакураба) Ах
Dialogue: 0,0:03:16.65,0:03:18.78,Default,,0,0,0,,Монта-кун допты қағып жіберді!
Dialogue: 0,0:03:18.86,0:03:20.86,Default,,0,0,0,,Король сарайына шабуыл сәтсіз аяқталды!
Dialogue: 0,0:03:21.57,0:03:24.87,Default,,0,0,0,,Монта-кун, сенің арқаңда көзің бар сияқты!
Dialogue: 0,0:03:24.95,0:03:26.83,Default,,0,0,0,,Керемет фуго! Монта!
Dialogue: 0,0:03:26.91,0:03:28.87,Default,,0,0,0,,Шаа! Қарғыс атқыр маймыл!
Dialogue: 0,0:03:31.21,0:03:32.58,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:03:33.12,0:03:34.33,Default,,0,0,0,,Сакураба (Сакураба) Га
Dialogue: 0,0:03:34.42,0:03:37.09,Default,,0,0,0,,Сіздің рұқсатыңыз оқылды.
Dialogue: 0,0:03:37.17,0:03:39.13,Default,,0,0,0,,Осы кезде біз стратегиямызды қайта қарауымыз керек...
Dialogue: 0,0:03:39.21,0:03:40.05,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:03:42.80,0:03:43.76,Default,,0,0,0,,Маған рұқсат беруіңізді өтінемін
Dialogue: 0,0:03:43.84,0:03:44.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:45.80,0:03:47.93,Default,,0,0,0,,Мен Монтадан жеңілмеймін
Dialogue: 0,0:03:48.01,0:03:51.14,Default,,0,0,0,,Мен сенен артық екенімді дәлелдеймін.
Dialogue: 0,0:03:51.23,0:03:54.27,Default,,0,0,0,,Бірақ Сакураба...
Dialogue: 0,0:03:54.35,0:03:55.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:56.27,0:03:59.36,Default,,0,0,0,,Маған Эверест асуымен баруға рұқсат етіңіз.
Dialogue: 0,0:03:59.44,0:04:01.53,Default,,0,0,0,,Келесі жолы міндетті түрде ұстаймын.
Dialogue: 0,0:04:02.36,0:04:05.03,Default,,0,0,0,,Маған рұқсат беріңіз!
Dialogue: 0,0:04:06.45,0:04:09.45,Default,,0,0,0,,Жарайды, келесі жолы талонмен барайық.
Dialogue: 0,0:04:13.41,0:04:14.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:15.04,0:04:16.17,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:04:16.25,0:04:18.50,Default,,0,0,0,,Ах... Сусуму
Dialogue: 0,0:04:19.55,0:04:22.67,Default,,0,0,0,,Ол жүрегі оңайлықпен жараланатын адам емес.
Dialogue: 0,0:04:23.97,0:04:25.34,Default,,0,0,0,,Иә
Dialogue: 0,0:04:25.43,0:04:29.14,Default,,0,0,0,,Сакурабадан келген жігіт сәл асыққан сияқты.
Dialogue: 0,0:04:29.22,0:04:31.64,Default,,0,0,0,,Мен өзімді жоғалтпаймын деп үміттенемін...
Dialogue: 0,0:04:31.72,0:04:35.23,Default,,0,0,0,,Шулы жын жауынгер! Сакураба жарайды
Dialogue: 0,0:04:35.31,0:04:37.90,Default,,0,0,0,,Осындай кезде ғана дұрыс сөз айтпа!
Dialogue: 0,0:04:37.98,0:04:39.36,Default,,0,0,0,,Торакичи…
Dialogue: 0,0:04:39.44,0:04:42.32,Default,,0,0,0,,Сакураба міндетті түрде жеңеді!
Dialogue: 0,0:04:43.70,0:04:46.78,Default,,0,0,0,,Сакураба, не болды...
Dialogue: 0,0:04:46.86,0:04:48.49,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:04:52.04,0:04:54.41,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:04:54.50,0:04:56.37,Default,,0,0,0,,Кеттік, Сакураба
Dialogue: 0,0:04:58.21,0:05:00.34,Default,,0,0,0,,Бұл қайтадан Эверест асуы!
Dialogue: 0,0:05:01.46,0:05:02.96,Default,,0,0,0,,О, өте үлкен
Dialogue: 0,0:05:03.05,0:05:07.14,Default,,0,0,0,,Өзінің теңдессіз дәлдігімен мақтанған Таками-кун осында келіп, асуды өткізіп алды!
Dialogue: 0,0:05:07.22,0:05:08.47,Default,,0,0,0,,Жоқ, олай емес!
Dialogue: 0,0:05:08.55,0:05:11.76,Default,,0,0,0,,Бұл Сакурабаға деген сеніммен өлтіретін асу!
Dialogue: 0,0:05:12.81,0:05:16.10,Default,,0,0,0,,Бұл мүмкін емес. Жол тым үлкен!
Dialogue: 0,0:05:17.31,0:05:18.48,Default,,0,0,0,,Осы уақытқа дейін I
Dialogue: 0,0:05:18.56,0:05:21.69,Default,,0,0,0,,Мен Таками-санның қасынан санап алғаннан көп өттім.
Dialogue: 0,0:05:22.57,0:05:24.65,Default,,0,0,0,,Мен де міндетті түрде ұстаймын!
Dialogue: 0,0:05:24.74,0:05:29.24,Default,,0,0,0,,Иә! Ууууууууууу
Dialogue: 0,0:05:29.32,0:05:31.53,Default,,0,0,0,,На (Таками) Не!? Сакураба!
Dialogue: 0,0:05:31.62,0:05:32.62,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:05:32.70,0:05:34.12,Default,,0,0,0,,Ібіліс кері әсер етеді!
Dialogue: 0,0:05:34.20,0:05:37.87,Default,,0,0,0,,Не! Сакураба-кун да шайтанның кері әсері!
Dialogue: 0,0:05:37.96,0:05:40.92,Default,,0,0,0,,Сакураба!
Dialogue: 0,0:05:43.42,0:05:45.09,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:05:48.51,0:05:49.51,Default,,0,0,0,,Ах
Dialogue: 0,0:05:49.59,0:05:52.97,Default,,0,0,0,,Ол шықты! Сәтсіздікті ұстаңыз!
Dialogue: 0,0:05:53.81,0:05:57.98,Default,,0,0,0,,Қат! Неге, неге маған!
Dialogue: 0,0:05:58.06,0:05:58.94,Default,,0,0,0,,Уф
Dialogue: 0,0:06:02.77,0:06:06.99,Default,,0,0,0,,Ojo өту сәтсіз аяқталды!
Dialogue: 0,0:06:07.07,0:06:08.28,Default,,0,0,0,,Ах
Dialogue: 0,0:06:09.16,0:06:12.66,Default,,0,0,0,,Сакураба!
Dialogue: 0,0:06:12.74,0:06:15.91,Default,,0,0,0,,(Әйелдердің айқайы)
Dialogue: 0,0:06:16.58,0:06:17.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:17.87,0:06:20.63,Default,,0,0,0,,Зембіл! Маған зембіл әкеліңіз!
Dialogue: 0,0:06:20.71,0:06:23.59,Default,,0,0,0,,Бұл... бұл үлкен мәселе!
Dialogue: 0,0:06:23.67,0:06:25.96,Default,,0,0,0,,Қауіпті жағдайда құлады
Dialogue: 0,0:06:26.05,0:06:28.09,Default,,0,0,0,,Сакураба, жақсысың ба?
Dialogue: 0,0:06:30.68,0:06:33.85,Default,,0,0,0,,Сен... үлкенсің.
Dialogue: 0,0:06:34.51,0:06:36.27,Default,,0,0,0,,Керемет қабылдағыш!
Dialogue: 0,0:06:36.35,0:06:38.14,Default,,0,0,0,,Американдық футбол клубына қосылыңыз!
Dialogue: 0,0:06:38.23,0:06:41.35,Default,,0,0,0,,Қосылсаң елдің бәрі арман емес!
Dialogue: 0,0:06:41.44,0:06:43.23,Default,,0,0,0,,Өтінемін, Эйс!
Dialogue: 0,0:06:43.31,0:06:45.73,Default,,0,0,0,,Эйс? Мен Эйспін бе?
Dialogue: 0,0:06:46.32,0:06:49.28,Default,,0,0,0,,О, сен де ше? Американдық футбол клубы
Dialogue: 0,0:06:49.36,0:06:50.20,Default,,0,0,0,,Ах
Dialogue: 0,0:06:53.99,0:06:55.41,Default,,0,0,0,,Уф
Dialogue: 0,0:06:55.99,0:06:57.95,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:06:58.04,0:07:01.12,Default,,0,0,0,,Мен сізден бірінші болып неше рет хабарласуыңызды сұрауым керек еді?
Dialogue: 0,0:07:01.79,0:07:02.83,Default,,0,0,0,,Я...
Dialogue: 0,0:07:02.92,0:07:04.29,Default,,0,0,0,,Жоқ, I
Dialogue: 0,0:07:04.38,0:07:06.38,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,0:07:06.46,0:07:08.76,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,0:07:08.84,0:07:10.47,Default,,0,0,0,,Ммм
Dialogue: 0,0:07:10.55,0:07:12.18,Default,,0,0,0,,Бұл жігіт керемет
Dialogue: 0,0:07:12.26,0:07:14.43,Default,,0,0,0,,Сусуму Сейжуро...
Dialogue: 0,0:07:14.51,0:07:17.31,Default,,0,0,0,,Король сарайының жас ацы.
Dialogue: 0,0:07:17.39,0:07:18.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.35,0:07:25.11,Default,,0,0,0,,Аа, дұрыс, мен патша сарайының эйсімін...
Dialogue: 0,0:07:26.19,0:07:27.28,Default,,0,0,0,,Кя!
Dialogue: 0,0:07:27.36,0:07:30.90,Default,,0,0,0,,Барлығы Эйс Сакураба-кунға құмар.
Dialogue: 0,0:07:34.74,0:07:39.00,Default,,0,0,0,,Сакураба-кун, патша сарайының эйсімен таныстыру!
Dialogue: 0,0:07:39.08,0:07:43.21,Default,,0,0,0,,Ха... Жоқ, мен...
Dialogue: 0,0:07:54.76,0:07:57.31,Default,,0,0,0,,Мен... Сусуму...
Dialogue: 0,0:07:57.39,0:07:59.39,Default,,0,0,0,,Мен бардым! Сакураба! (Сакураба) А?
Dialogue: 0,0:08:00.93,0:08:04.27,Default,,0,0,0,,(Сакурабаның ауыр тыныс алуы)
Dialogue: 0,0:08:04.35,0:08:05.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:05.31,0:08:09.15,Default,,0,0,0,,Ууууууууууууу
Dialogue: 0,0:08:09.23,0:08:10.40,Default,,0,0,0,,Уау (Сакураба) хаха
Dialogue: 0,0:08:10.49,0:08:12.15,Default,,0,0,0,,Ұстау белгілері!
Dialogue: 0,0:08:12.74,0:08:14.49,Default,,0,0,0,,Уаааа
Dialogue: 0,0:08:14.57,0:08:15.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:16.66,0:08:17.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:21.25,0:08:23.87,Default,,0,0,0,,Мен күткендей...
Dialogue: 0,0:08:27.25,0:08:29.00,Default,,0,0,0,,Сакураба…
Dialogue: 0,0:08:29.71,0:08:32.72,Default,,0,0,0,,Бірақ жақсысың ба, Сакураба-кун?
Dialogue: 0,0:08:32.80,0:08:35.93,Default,,0,0,0,,Басыңды ұрған сияқтысың. Мен уайымдап тұрмын.
Dialogue: 0,0:08:37.01,0:08:38.68,Default,,0,0,0,,Сакураба мырза...
Dialogue: 0,0:08:43.18,0:08:45.52,Default,,0,0,0,,Сакурабаны оят
Dialogue: 0,0:08:46.52,0:08:48.06,Default,,0,0,0,,Егер сіз жеңілсеңіз, жоқ!
Dialogue: 0,0:08:54.49,0:08:55.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:56.36,0:08:58.41,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:08:59.91,0:09:01.99,Default,,0,0,0,,О... Эй! Торакичи!
Dialogue: 0,0:09:04.87,0:09:06.79,Default,,0,0,0,,Оян, Сакураба!
Dialogue: 0,0:09:09.42,0:09:11.00,Default,,0,0,0,,Берілме!
Dialogue: 0,0:09:13.88,0:09:15.09,Default,,0,0,0,,Сакураба!
Dialogue: 0,0:09:16.13,0:09:17.51,Default,,0,0,0,,Уау
Dialogue: 0,0:09:18.05,0:09:19.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:20.81,0:09:22.64,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:23.35,0:09:25.94,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:09:26.02,0:09:28.40,Default,,0,0,0,,Ха-ха... Уф
Dialogue: 0,0:09:28.48,0:09:29.52,Default,,0,0,0,,Уф
Dialogue: 0,0:09:31.11,0:09:32.36,Default,,0,0,0,,Уф
Dialogue: 0,0:09:33.03,0:09:35.24,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:09:35.32,0:09:38.45,Default,,0,0,0,,Ах, у... ха...
Dialogue: 0,0:09:41.49,0:09:44.41,Default,,0,0,0,,Ах... Сакураба!
Dialogue: 0,0:09:47.46,0:09:52.63,Default,,0,0,0,,А, жоқ... Оян, Сакураба!
Dialogue: 0,0:09:52.71,0:09:54.34,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:59.97,0:10:03.35,Default,,0,0,0,,Менің денем... ауыр.
Dialogue: 0,0:10:05.43,0:10:06.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.48,0:10:10.44,Default,,0,0,0,,Хаха... Баяғы заман.
Dialogue: 0,0:10:12.36,0:10:13.32,Default,,0,0,0,,Бұл…
Dialogue: 0,0:10:15.44,0:10:17.32,Default,,0,0,0,,Сакураба!
Dialogue: 0,0:10:18.45,0:10:19.70,Default,,0,0,0,,Ha
Dialogue: 0,0:10:19.78,0:10:22.03,Default,,0,0,0,,Сакураба!
Dialogue: 0,0:10:22.12,0:10:22.95,Default,,0,0,0,,Ах
Dialogue: 0,0:10:24.12,0:10:25.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:27.62,0:10:29.37,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:29.46,0:10:31.92,Default,,0,0,0,,Сакураба! (Сакураба) А... аа...
Dialogue: 0,0:10:32.00,0:10:34.88,Default,,0,0,0,,Сакураба!
Dialogue: 0,0:10:36.71,0:10:37.84,Default,,0,0,0,,Торакичи?
Dialogue: 0,0:10:37.92,0:10:40.38,Default,,0,0,0,,Сакураба тұр!
Dialogue: 0,0:10:40.47,0:10:42.14,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:10:42.22,0:10:44.72,Default,,0,0,0,,Сіз көп жаттығу жасадыңыз!
Dialogue: 0,0:10:44.81,0:10:46.22,Default,,0,0,0,,Бұл қатты дауыс болса керек.
Dialogue: 0,0:10:46.31,0:10:48.43,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:49.19,0:10:51.23,Default,,0,0,0,,Тұра алсаңшы.
Dialogue: 0,0:10:51.31,0:10:53.56,Default,,0,0,0,,Мен бірінші тұрамын!
Dialogue: 0,0:10:53.65,0:10:55.19,Default,,0,0,0,,Сізде батылдық жоқ!
Dialogue: 0,0:10:55.94,0:10:57.19,Default,,0,0,0,,А...
Dialogue: 0,0:10:57.28,0:10:59.15,Default,,0,0,0,,Бұл әлі де дұрыс па?
Dialogue: 0,0:10:59.24,0:11:02.82,Default,,0,0,0,,Бастауыш сынып оқушысынан жеңілу жағымсыз болар еді!
Dialogue: 0,0:11:03.87,0:11:05.91,Default,,0,0,0,,Ах... Уф
Dialogue: 0,0:11:06.45,0:11:08.37,Default,,0,0,0,,Ахх...
Dialogue: 0,0:11:08.45,0:11:10.96,Default,,0,0,0,,Әй, Сена
Dialogue: 0,0:11:11.04,0:11:12.50,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:11:15.42,0:11:19.22,Default,,0,0,0,,Уф, а, а...
Dialogue: 0,0:11:19.30,0:11:21.38,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:11:22.34,0:11:23.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:24.64,0:11:30.81,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:11:33.19,0:11:34.94,Default,,0,0,0,,Ах куууу
Dialogue: 0,0:11:38.48,0:11:40.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:41.70,0:11:42.82,Default,,0,0,0,,Тұрған...
Dialogue: 0,0:11:42.91,0:11:44.37,Default,,0,0,0,,Торакичи...
Dialogue: 0,0:11:45.12,0:11:46.87,Default,,0,0,0,,Қалай
Dialogue: 0,0:11:47.66,0:11:50.12,Default,,0,0,0,,Тұру оңай
Dialogue: 0,0:11:50.20,0:11:52.33,Default,,0,0,0,,Келесі кезекте Сакурабаның кезегі!
Dialogue: 0,0:11:53.58,0:11:56.38,Default,,0,0,0,,Ал... Торакичи...
Dialogue: 0,0:11:58.30,0:11:59.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:00.38,0:12:02.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:03.01,0:12:04.22,Default,,0,0,0,,Уф
Dialogue: 0,0:12:08.89,0:12:09.97,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:10.93,0:12:12.02,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:13.06,0:12:15.31,Default,,0,0,0,,Ах, Сакураба...
Dialogue: 0,0:12:15.40,0:12:18.40,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:12:25.45,0:12:27.07,Default,,0,0,0,,Торакичи!
Dialogue: 0,0:12:27.74,0:12:28.99,Default,,0,0,0,,Ой
Dialogue: 0,0:12:32.41,0:12:34.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:36.00,0:12:39.55,Default,,0,0,0,,Бастауыш сынып оқушыларынан ұтыла алмаймын, Сакураба
Dialogue: 0,0:12:42.09,0:12:43.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:44.43,0:12:48.43,Default,,0,0,0,,Мен жалғыз өзім ойнадым.
Dialogue: 0,0:12:48.51,0:12:50.72,Default,,0,0,0,,Ешкімге қарама, ашулан...
Dialogue: 0,0:12:51.77,0:12:53.73,Default,,0,0,0,,қате болды
Dialogue: 0,0:12:53.81,0:12:57.23,Default,,0,0,0,,Мен жалғыз күресіп жатқан жоқпын
Dialogue: 0,0:12:57.81,0:12:58.73,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:13:00.32,0:13:01.69,Default,,0,0,0,,Сенна! Монта!
Dialogue: 0,0:13:01.78,0:13:02.99,Default,,0,0,0,,Ах
Dialogue: 0,0:13:04.03,0:13:05.70,Default,,0,0,0,,Менің талантыма келетін болсақ
Dialogue: 0,0:13:05.78,0:13:08.91,Default,,0,0,0,,Мен сізге ешқашан тең келе алмауым мүмкін.
Dialogue: 0,0:13:08.99,0:13:13.37,Default,,0,0,0,,Бірақ менің жүрегім енді ешқашан жараланбайды!
Dialogue: 0,0:13:15.25,0:13:16.33,Default,,0,0,0,,Сакураба…
Dialogue: 0,0:13:18.21,0:13:20.21,Default,,0,0,0,,Мен Торакичиге уәде бердім.
Dialogue: 0,0:13:20.71,0:13:22.55,Default,,0,0,0,,Осымен бітпейді
Dialogue: 0,0:13:24.22,0:13:25.84,Default,,0,0,0,,Мен міндетті түрде барамын
Dialogue: 0,0:13:26.63,0:13:31.01,Default,,0,0,0,,Барлық Оджо Ақ Рыцарлары Рождестволық ыдыста болады!
Dialogue: 0,0:13:31.10,0:13:32.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:34.56,0:13:36.44,Default,,0,0,0,,Шин! Таками-сан!
Dialogue: 0,0:13:36.52,0:13:37.73,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:39.56,0:13:41.15,Default,,0,0,0,,Мысал техникасына көшейік.
Dialogue: 0,0:13:41.23,0:13:43.82,Default,,0,0,0,,Жоқ, мені жіберіңізші!
Dialogue: 0,0:13:43.90,0:13:45.99,Default,,0,0,0,,Бірақ Сакураба
Dialogue: 0,0:13:46.07,0:13:49.03,Default,,0,0,0,,Бұл әдісті әлі де практикалық деңгейде қолдануға болады...
Dialogue: 0,0:13:49.70,0:13:52.91,Default,,0,0,0,,Бұл қазір Сакурабамен мүмкін болуы мүмкін.
Dialogue: 0,0:13:52.99,0:13:54.16,Default,,0,0,0,,Барысы…
Dialogue: 0,0:13:55.12,0:13:59.38,Default,,0,0,0,,Екеуің халық тығыз орналасқан аймақты басып өтесіздер.
Dialogue: 0,0:13:59.46,0:14:01.13,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:14:01.63,0:14:05.76,Default,,0,0,0,,Бұл физикалық және психикалық тұрғыдан өте ауыр.
Dialogue: 0,0:14:05.84,0:14:07.05,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:14:07.13,0:14:10.22,Default,,0,0,0,,Жарайды, сен жалғыз емессің.
Dialogue: 0,0:14:11.30,0:14:12.26,Default,,0,0,0,,О
Dialogue: 0,0:14:12.85,0:14:15.31,Default,,0,0,0,,Оны екі адам міндетті түрде орындайды.
Dialogue: 0,0:14:15.39,0:14:18.81,Default,,0,0,0,,А... Жарайды, осы екеуіне сенейік.
Dialogue: 0,0:14:19.65,0:14:20.98,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:21.06,0:14:23.48,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:14:24.82,0:14:27.95,Default,,0,0,0,,Сакураба! Шин! Маған көрсет
Dialogue: 0,0:14:28.03,0:14:29.70,Default,,0,0,0,,Екеуіңнің күші!
Dialogue: 0,0:14:32.28,0:14:34.66,Default,,0,0,0,,Иә, біздің тегпен
Dialogue: 0,0:14:35.87,0:14:38.87,Default,,0,0,0,,Осы американдық футбол клубына бірге қосылайық, Сусуму.
Dialogue: 0,0:14:40.87,0:14:43.88,Default,,0,0,0,,Ақырында, олар патша сарайының екі эйсі деп аталды.
Dialogue: 0,0:14:43.96,0:14:48.55,Default,,0,0,0,,Хахаха... Осындай жағдай болса жақсы болар еді.
Dialogue: 0,0:14:49.22,0:14:52.05,Default,,0,0,0,,Монта-кун Марк Сакураба-кун тамаша!
Dialogue: 0,0:14:52.89,0:14:56.27,Default,,0,0,0,,Мен енді жеңілмеймін! Шайтанның кері әсерімен!
Dialogue: 0,0:14:56.35,0:14:58.23,Default,,0,0,0,,Иә! Уф
Dialogue: 0,0:14:58.31,0:14:59.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:59.31,0:15:01.69,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:15:05.94,0:15:08.82,Default,,0,0,0,,Сакураба-кунға қысқа жол жүру!?
Dialogue: 0,0:15:08.90,0:15:11.91,Default,,0,0,0,,Түсіндім! Егер бұл қысқа болса ...
Dialogue: 0,0:15:11.99,0:15:14.78,Default,,0,0,0,,Монтаның траекторияны бағалауға уақыты жоқ.
Dialogue: 0,0:15:14.87,0:15:19.37,Default,,0,0,0,,Сен алысқа атылатын мылтығыңды лақтырып, аман-есен ақша табу үшін келдің.
Dialogue: 0,0:15:19.46,0:15:22.54,Default,,0,0,0,,Өкінішке орай, Сакураба таңдаған шешім болды
Dialogue: 0,0:15:22.63,0:15:24.38,Default,,0,0,0,,Бұл соншалықты аңғал пьеса емес.
Dialogue: 0,0:15:25.04,0:15:26.34,Default,,0,0,0,,Чиккишо!
Dialogue: 0,0:15:26.96,0:15:29.30,Default,,0,0,0,,Қонған кезде жаншып, тоқтатамын, Сена!
Dialogue: 0,0:15:29.38,0:15:31.51,Default,,0,0,0,,Иә! Екі адам керек!
Dialogue: 0,0:15:35.55,0:15:38.18,Default,,0,0,0,,Хмф! (Монта/Сена) Уау!
Dialogue: 0,0:15:38.27,0:15:40.64,Default,,0,0,0,,Өйткені ол әлі де жалғастыруға бел буған
Dialogue: 0,0:15:41.39,0:15:42.48,Default,,0,0,0,,Сусуму!?
Dialogue: 0,0:15:43.77,0:15:47.48,Default,,0,0,0,,Не! Сакураба-кунмен аспанда ұшатын Пегасус
Dialogue: 0,0:15:47.57,0:15:50.19,Default,,0,0,0,,Ең күшті рыцарь Сусуму қосылды...
Dialogue: 0,0:15:50.28,0:15:51.24,Default,,0,0,0,,Бұл солай!
Dialogue: 0,0:15:51.32,0:15:56.33,Default,,0,0,0,,Стрелец, аспанға атып тұрған алып садақ!
Dialogue: 0,0:16:01.54,0:16:02.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:03.25,0:16:05.63,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:16:07.29,0:16:10.26,Default,,0,0,0,,Бар... Сакураба бар...
Dialogue: 0,0:16:10.34,0:16:13.38,Default,,0,0,0,,Ууууууууууууууууууууу
Dialogue: 0,0:16:13.47,0:16:14.55,Default,,0,0,0,,
Dialogue: 0,0:16:14.64,0:16:17.18,Default,,0,0,0,,Оджо Уайт Рыцарьлар бірінші болып құлады!
Dialogue: 0,0:16:17.26,0:16:20.10,Default,,0,0,0,,Жарайсыңдар! Сакураба…
Dialogue: 0,0:16:20.18,0:16:21.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:22.77,0:16:24.06,Default,,0,0,0,,Торакичи
Dialogue: 0,0:16:24.14,0:16:27.36,Default,,0,0,0,,Ке! Мен тыныс алдым
Dialogue: 0,0:16:27.44,0:16:29.07,Default,,0,0,0,,Стрелец…
Dialogue: 0,0:16:29.15,0:16:32.95,Default,,0,0,0,,Сусуму-кун мен Сакураба-кун алға қарай жүгіреді⸺
Dialogue: 0,0:16:33.03,0:16:34.28,Default,,0,0,0,,Күшті техника!
Dialogue: 0,0:16:34.36,0:16:37.57,Default,,0,0,0,,Бұл қарапайым болып көрінетін шабуыл, бірақ
Dialogue: 0,0:16:37.66,0:16:41.29,Default,,0,0,0,,Жаудың лагері екі адамның күшімен ашылады.
Dialogue: 0,0:16:41.37,0:16:44.83,Default,,0,0,0,,Менің ойымша, бұл физикалық тұрғыдан қатты шаршайды.
Dialogue: 0,0:16:45.33,0:16:47.13,Default,,0,0,0,,Келесі жолы бара аламын ба?
Dialogue: 0,0:16:47.71,0:16:48.63,Default,,0,0,0,,Of course!
Dialogue: 0,0:16:49.80,0:16:51.30,Default,,0,0,0,,Бұл аяқталды.
Dialogue: 0,0:16:52.13,0:16:56.30,Default,,0,0,0,,Аа, қайсысы жетіспесе де орындалмайтын техника.
Dialogue: 0,0:16:56.39,0:16:58.05,Default,,0,0,0,,Бірден осылай жүрейік.
Dialogue: 0,0:16:58.85,0:16:59.81,Default,,0,0,0,,О!
Dialogue: 0,0:17:03.31,0:17:07.19,Default,,0,0,0,,Бүйірлік сызықтан осылай өтейік, Сусуму!
Dialogue: 0,0:17:07.77,0:17:10.15,Default,,0,0,0,,Әй, екі адам болса, сынуы мүмкін!
Dialogue: 0,0:17:10.23,0:17:11.73,Default,,0,0,0,,Хмф! (Үш ағайынды) Ооо
Dialogue: 0,0:17:13.69,0:17:15.11,Default,,0,0,0,,Сакураба-кун мен Сусуму-кунның Стрелецінде
Dialogue: 0,0:17:15.11,0:17:16.78,Default,,0,0,0,,Сакураба-кун мен Сусуму-кунның Стрелецінде
Dialogue: 0,0:17:15.11,0:17:16.78,Default,,0,0,0,,
Dialogue: 0,0:17:16.86,0:17:19.62,Default,,0,0,0,,Бірінен соң бірін түсіру!
Dialogue: 0,0:17:19.70,0:17:22.58,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:17:22.66,0:17:25.66,Default,,0,0,0,,Стрелец тоқтамайды!
Dialogue: 0,0:17:25.75,0:17:27.29,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:17:27.37,0:17:29.33,Default,,0,0,0,,Ібілістің кері әсері
Dialogue: 0,0:17:29.42,0:17:32.92,Default,,0,0,0,,Ол ұзын асу шайқастарында күресе бастады!
Dialogue: 0,0:17:33.55,0:17:34.59,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:17:35.51,0:17:38.80,Default,,0,0,0,,Сакураба-кунға тағы бір өте қысқа пас!
Dialogue: 0,0:17:38.89,0:17:42.89,Default,,0,0,0,,Иккю: Дәл қазір рұқсатты кесіп тастай аласыз ба?
Dialogue: 0,0:17:42.97,0:17:43.97,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:44.06,0:17:47.14,Default,,0,0,0,,Мен физикалық қол жеткізе алмайтын нәрсеге ештеңе істей алмаймын.
Dialogue: 0,0:17:47.23,0:17:49.81,Default,,0,0,0,,Мен болсам, қонарда жаншып кетер едім.
Dialogue: 0,0:17:49.90,0:17:52.52,Default,,0,0,0,,Бірақ маңызды мәселе...
Dialogue: 0,0:17:53.82,0:17:54.69,Default,,0,0,0,,Хмф!
Dialogue: 0,0:17:54.78,0:17:57.24,Default,,0,0,0,,Сусуму - блок!
Dialogue: 0,0:17:58.11,0:17:58.95,Default,,0,0,0,,Құт
Dialogue: 0,0:17:59.53,0:18:00.91,Default,,0,0,0,,Жеңілмейтін Стрелец
Dialogue: 0,0:18:00.99,0:18:03.91,Default,,0,0,0,,Енді қақпа сызығында күресетін кез келді!
Dialogue: 0,0:18:03.99,0:18:06.62,Default,,0,0,0,,Тоқта! Қарғыс атқыр бауырлар!
Dialogue: 0,0:18:06.71,0:18:08.29,Default,,0,0,0,,Нашар Фуго
Dialogue: 0,0:18:08.37,0:18:09.75,Default,,0,0,0,,Тек жанасу
Dialogue: 0,0:18:09.83,0:18:11.17,Default,,0,0,0,,Бұған жол берме!
Dialogue: 0,0:18:11.25,0:18:12.92,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:18:13.00,0:18:15.96,Default,,0,0,0,,Оны жойыңыз!
Dialogue: 0,0:18:16.05,0:18:18.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:18.38,0:18:19.80,Default,,0,0,0,,Үзіліс!
Dialogue: 0,0:18:19.89,0:18:23.43,Default,,0,0,0,,Ууууууууууууу
Dialogue: 0,0:18:24.06,0:18:27.27,Default,,0,0,0,,Бұл жабысқақтық... бұрын Сакурабадта болмаған.
Dialogue: 0,0:18:27.35,0:18:30.23,Default,,0,0,0,,Ууууууууууууу
Dialogue: 0,0:18:30.31,0:18:32.73,Default,,0,0,0,,Кууууууууууууу!
Dialogue: 0,0:18:32.82,0:18:34.61,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:34.69,0:18:36.49,Default,,0,0,0,,Даун!
Dialogue: 0,0:18:36.57,0:18:39.49,Default,,0,0,0,,Сакураба-кун толығымен қайта жанданды!
Dialogue: 0,0:18:40.16,0:18:42.03,Default,,0,0,0,,Таками Сакурабаны тірі қалдырды
Dialogue: 0,0:18:42.12,0:18:46.50,Default,,0,0,0,,Сакураба-кун мен Сусуму-кун екі эйс болды!
Dialogue: 0,0:18:48.12,0:18:49.54,Default,,0,0,0,,Сакураба…
Dialogue: 0,0:18:52.54,0:18:57.63,Default,,0,0,0,,Дұрыс... Сакурабаның бәрі Аха туралы
Dialogue: 0,0:18:58.22,0:18:59.05,Default,,0,0,0,,Король сарайы⸺
Dialogue: 0,0:18:59.13,0:19:01.47,Default,,0,0,0,,Мен оны әп-сәтте итеріп жібердім!
Dialogue: 0,0:19:01.55,0:19:03.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:03.14,0:19:05.76,Default,,0,0,0,,Мені қуып жету үшін көп күш жұмсадым...
Dialogue: 0,0:19:05.85,0:19:09.73,Default,,0,0,0,,Қуып жету және жіберіп алудың қатал талшы ойыны!
Dialogue: 0,0:19:09.81,0:19:11.73,Default,,0,0,0,,Деймон 7 ұпайлық айырмашылықты қуып келеді!
Dialogue: 0,0:19:13.36,0:19:16.86,Default,,0,0,0,,Эй, сен караокеге бармадың ба?
Dialogue: 0,0:19:16.94,0:19:19.82,Default,,0,0,0,,Неге кенеттен келдің?
Dialogue: 0,0:19:20.36,0:19:21.61,Default,,0,0,0,,Ах
Dialogue: 0,0:19:21.70,0:19:23.99,Default,,0,0,0,,Енді, патша сарайындағы Стрелецтің алдында.
Dialogue: 0,0:19:24.07,0:19:25.58,Default,,0,0,0,,Көмекке келмейтін балшық қақпа!
Dialogue: 0,0:19:25.66,0:19:28.54,Default,,0,0,0,,Балшық қақпа жағында ауыр көңіл.
Dialogue: 0,0:19:29.29,0:19:31.50,Default,,0,0,0,,Біз мұны қалай жеңе аламыз?
Dialogue: 0,0:19:43.01,0:19:48.02,Default,,0,0,0,,♪~
Dialogue: 0,0:20:52.54,0:20:57.92,Default,,0,0,0,,~♪
Dialogue: 0,0:20:59.50,0:21:01.63,Default,,0,0,0,,Сусуму мен Сакурабаның Стрелеці!
Dialogue: 0,0:21:01.71,0:21:02.92,Default,,0,0,0,,Мен сені қуып жетсем де
Dialogue: 0,0:21:03.01,0:21:04.47,Default,,0,0,0,,Артық уақыт жоқ
Dialogue: 0,0:21:04.55,0:21:06.89,Default,,0,0,0,,Мен не болса да Сусумунды тоқтатуым керек!
Dialogue: 0,0:21:06.97,0:21:08.39,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:08.47,0:21:10.76,Default,,0,0,0,,«Ібіліс сөндіретін мылтық іске қосылды!»
Dialogue: 0,0:21:10.85,0:21:12.52,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:14.02,0:21:20.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory