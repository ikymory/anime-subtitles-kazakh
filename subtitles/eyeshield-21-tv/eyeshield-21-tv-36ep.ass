Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.08,0:00:09.17,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:00:12.26,0:00:14.09,Default,,0,0,0,,Ол бұзылды!
Dialogue: 0,0:00:14.59,0:00:16.55,Default,,0,0,0,,Мм, бұл жағдайда...
Dialogue: 0,0:00:16.85,0:00:18.26,Default,,0,0,0,,Бастапқыда бір тас
Dialogue: 0,0:00:18.39,0:00:21.39,Default,,0,0,0,,Егер сіз тіпті бір фигураны жоғалтсаңыз, 2000 км-ден астам жолды бастау керек.
Dialogue: 0,0:00:21.68,0:00:22.98,Default,,0,0,0,,Міне!
Dialogue: 0,0:00:23.35,0:00:24.98,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:00:25.35,0:00:26.94,Default,,0,0,0,,О, о, о...
Dialogue: 0,0:00:27.06,0:00:28.90,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:00:29.02,0:00:31.94,Default,,0,0,0,,Екі тас болсаң мен Кенкенмін.
Dialogue: 0,0:00:32.07,0:00:35.20,Default,,0,0,0,,Өйткені, менің физикалық күшім жеткілікті.
Dialogue: 0,0:00:35.32,0:00:39.03,Default,,0,0,0,,Муки Муки Муки Муки (Таки) Ахаха!
Dialogue: 0,0:00:39.16,0:00:43.75,Default,,0,0,0,,Хаха, бәрібір неге бәрі көңілді?
Dialogue: 0,0:00:44.16,0:00:46.71,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:00:47.08,0:00:49.67,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:00:49.79,0:00:53.67,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:00:56.22,0:00:58.51,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:01:00.89,0:01:03.93,Default,,0,0,0,,Барлығы соншалықты таусылды.
Dialogue: 0,0:01:05.02,0:01:06.94,Default,,0,0,0,,Менің аяқ киімім сынғыш
Dialogue: 0,0:01:07.52,0:01:09.40,Default,,0,0,0,,Менің тізем шегінде.
Dialogue: 0,0:01:10.94,0:01:11.78,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:01:12.19,0:01:13.57,Default,,0,0,0,,Иә... әйтеуір
Dialogue: 0,0:01:13.69,0:01:14.69,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:14.82,0:01:15.74,Default,,0,0,0,,Не?
Dialogue: 0,0:01:16.49,0:01:17.99,Default,,0,0,0,,Неліктен Америкада алаңдау керек?
Dialogue: 0,0:01:18.11,0:01:20.70,Default,,0,0,0,,Мұндай ауыр жаттығуларды орындаудың қажеті болмаса да
Dialogue: 0,0:01:20.83,0:01:24.62,Default,,0,0,0,,Менің ойымша, денеңізді жаттықтырудың басқа жолдары бар.
Dialogue: 0,0:01:24.87,0:01:27.25,Default,,0,0,0,,Бұл рас болуы мүмкін, бірақ...
Dialogue: 0,0:01:27.37,0:01:30.59,Default,,0,0,0,,Бірақ біз осы уақытқа дейін жеттік, сондықтан міндетті түрде мақсатқа жетуіміз керек.
Dialogue: 0,0:01:32.30,0:01:33.38,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:01:34.01,0:01:40.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:50.67,0:02:56.67,Default,,0,0,0,,~♪
Dialogue: 0,0:03:05.76,0:03:07.77,Default,,0,0,0,,Нағыз тозақ осы жерден басталады.
Dialogue: 0,0:03:08.06,0:03:10.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:10.81,0:03:14.69,Default,,0,0,0,,Денеңіздің ішінен шыққан ыңылдаумен мәңгілікке күресуге тура келеді.
Dialogue: 0,0:03:15.73,0:03:18.65,Default,,0,0,0,,«Мен неге сонша ауырдым?»
Dialogue: 0,0:03:18.78,0:03:21.57,Default,,0,0,0,,«Сіз жақсы жұмыс істедіңіз, уақыт келді».
Dialogue: 0,0:03:22.07,0:03:25.91,Default,,0,0,0,,Колледжде мен жасаған өлім маршы да 2000 км болды.
Dialogue: 0,0:03:26.20,0:03:29.66,Default,,0,0,0,,Соңғы 200 километрде барлығы бір-бірінен құлады.
Dialogue: 0,0:03:29.91,0:03:33.58,Default,,0,0,0,,Соңғы 200 шынымен де қиын ба?
Dialogue: 0,0:03:33.92,0:03:37.50,Default,,0,0,0,,``Кім 100 миль жүрсе, ол 99 мильдің жартысы.''\NСіз
Dialogue: 0,0:03:37.75,0:03:39.51,Default,,0,0,0,,туралы естідіңіз бе?
Dialogue: 0,0:03:39.84,0:03:41.30,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:03:41.55,0:03:43.01,Default,,0,0,0,,Сіз түсінуге мүмкіндік жоқ.
Dialogue: 0,0:03:43.38,0:03:46.93,Default,,0,0,0,,Бұл «Соңғы аяқтау - бәрінің ең қиын бөлігі» дегенді білдіреді.
Dialogue: 0,0:03:48.56,0:03:50.02,Default,,0,0,0,,Бұл сол кездегі фотосурет.
Dialogue: 0,0:03:50.14,0:03:51.48,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:03:51.60,0:03:53.60,Default,,0,0,0,,Оны қайдан табасың? сен
Dialogue: 0,0:03:54.15,0:03:57.57,Default,,0,0,0,,Мына бөтелке спирт кімде бар?
Dialogue: 0,0:03:57.69,0:03:58.52,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:03:58.78,0:03:59.90,Default,,0,0,0,,Жас!
Dialogue: 0,0:04:00.03,0:04:01.36,Default,,0,0,0,,Таримеда
Dialogue: 0,0:04:01.49,0:04:02.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:02.45,0:04:06.28,Default,,0,0,0,,Менің қасымдағы адам мен оны бұрын бір жерден көрген сияқтымын...
Dialogue: 0,0:04:06.41,0:04:07.33,Default,,0,0,0,,Шогун
Dialogue: 0,0:04:07.45,0:04:08.95,Default,,0,0,0,,Эээ!
Dialogue: 0,0:04:09.08,0:04:11.33,Default,,0,0,0,,Бұл Ojou White Nights режиссері ме?
Dialogue: 0,0:04:11.45,0:04:12.29,Default,,0,0,0,,Ах
Dialogue: 0,0:04:12.66,0:04:14.08,Default,,0,0,0,,Ол және мен
Dialogue: 0,0:04:14.21,0:04:17.50,Default,,0,0,0,,Олар Сенгоку университетінің американдық футбол клубының екі қылыштары деп аталды.
Dialogue: 0,0:04:17.84,0:04:19.42,Default,,0,0,0,,Кеттік! (Әндер)
Dialogue: 0,0:04:19.55,0:04:21.01,Default,,0,0,0,,Кеттік! (Әндер)
Dialogue: 0,0:04:21.13,0:04:23.09,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:04:23.22,0:04:24.47,Default,,0,0,0,,Қандай ұйқы!
Dialogue: 0,0:04:24.59,0:04:26.47,Default,,0,0,0,,Бар болғаны 200 шақырым қалды.
Dialogue: 0,0:04:26.59,0:04:27.97,Default,,0,0,0,,Бакс жойылды
Dialogue: 0,0:04:28.10,0:04:29.93,Default,,0,0,0,,Добуроку! Желіден қалып қойғандар бар ма?
Dialogue: 0,0:04:30.56,0:04:31.39,Default,,0,0,0,,Ах
Dialogue: 0,0:04:31.52,0:04:35.06,Default,,0,0,0,,(Добуроку ырылдады)
Dialogue: 0,0:04:35.56,0:04:38.06,Default,,0,0,0,,Неге жалғызсың... Басқаларға не болды?
Dialogue: 0,0:04:39.11,0:04:40.48,Default,,0,0,0,,Барлығы ұсақталған
Dialogue: 0,0:04:40.61,0:04:41.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:42.19,0:04:43.28,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:44.49,0:04:48.20,Default,,0,0,0,,Егер мен жалғыз қалсам, олар артымнан келетініне сенімдімін.
Dialogue: 0,0:04:48.49,0:04:51.24,Default,,0,0,0,,Лайлы шайқаста жеңілуге ​​қарсы ма?
Dialogue: 0,0:04:52.37,0:04:54.58,Default,,0,0,0,,Хмм... ешкім қалмады.
Dialogue: 0,0:04:55.16,0:04:57.25,Default,,0,0,0,,Өкінішке орай, барлығы оқудан шығып қалды.
Dialogue: 0,0:04:57.67,0:05:00.42,Default,,0,0,0,,Уф! Менің тізем...
Dialogue: 0,0:05:00.55,0:05:02.21,Default,,0,0,0,,Қарғыс атсын, сен ойланбайсың.
Dialogue: 0,0:05:03.30,0:05:05.72,Default,,0,0,0,,Ей, өзіңді ұста! Добуроку
Dialogue: 0,0:05:10.05,0:05:11.35,Default,,0,0,0,,Ауырсынатын көрінеді
Dialogue: 0,0:05:11.68,0:05:13.18,Default,,0,0,0,,Тағы да айтайын
Dialogue: 0,0:05:13.31,0:05:16.35,Default,,0,0,0,,Егер сіз бұлай болғыңыз келмесе, қазір тоқтай аласыз.
Dialogue: 0,0:05:16.81,0:05:20.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:20.40,0:05:21.27,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:21.40,0:05:24.24,Default,,0,0,0,,Егер сіз оны жақсы білмесеңіз, оны ешқашан пайдалана алмауыңыз мүмкін.
Dialogue: 0,0:05:24.36,0:05:26.11,Default,,0,0,0,,Ешкім зейнетке шыққысы келмейді ме?
Dialogue: 0,0:05:27.66,0:05:28.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:29.32,0:05:31.12,Default,,0,0,0,,Мен қалжыңдап тұрған жоқпын!
Dialogue: 0,0:05:31.24,0:05:32.83,Default,,0,0,0,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,0:05:33.29,0:05:34.83,Default,,0,0,0,,Ах (шағын қорытынды) Фуго барын салады!
Dialogue: 0,0:05:34.95,0:05:36.12,Default,,0,0,0,,Тағы да
Dialogue: 0,0:05:36.25,0:05:37.58,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:05:37.71,0:05:40.79,Default,,0,0,0,,Менің әлі 3-ке жуық сапарым бар.
Dialogue: 0,0:05:41.25,0:05:43.50,Default,,0,0,0,,Мақсатқа міндетті түрде жетемін!
Dialogue: 0,0:05:44.71,0:05:45.72,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:47.01,0:05:50.39,Default,,0,0,0,,Бұл жерде қаншама ақымақ бар.
Dialogue: 0,0:05:52.43,0:05:53.26,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:53.97,0:05:55.39,Default,,0,0,0,,Олай болса қазір ұйықта!
Dialogue: 0,0:05:55.52,0:05:57.77,Default,,0,0,0,,Түн батқанда біз кетеміз.
Dialogue: 0,0:05:57.89,0:05:59.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:01.81,0:06:03.98,Default,,0,0,0,,
Dialogue: 0,0:06:04.40,0:06:06.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:06.61,0:06:07.61,Default,,0,0,0,,Осы жерден айналып өтейік…
Dialogue: 0,0:06:08.78,0:06:09.99,Default,,0,0,0,,Сена Ах
Dialogue: 0,0:06:17.96,0:06:20.58,Default,,0,0,0,,Неліктен бәрің сонша жұмыс істеп жатырсыңдар?
Dialogue: 0,0:06:20.71,0:06:22.67,Default,,0,0,0,,Мақсатқа неге сонша құмарсың?
Dialogue: 0,0:06:23.09,0:06:25.96,Default,,0,0,0,,Жоқ, тіпті неге деп сұрасаңыз да
Dialogue: 0,0:06:26.09,0:06:28.01,Default,,0,0,0,,Әй, енді ашуланба!
Dialogue: 0,0:06:28.13,0:06:30.68,Default,,0,0,0,,Мен мұны әр адамның денсаулығына алаңдағандықтан айтып отырмын.
Dialogue: 0,0:06:31.47,0:06:34.06,Default,,0,0,0,,Мен бұған қуаныштымын.
Dialogue: 0,0:06:34.18,0:06:35.39,Default,,0,0,0,,Соңына дейін...
Dialogue: 0,0:06:35.85,0:06:38.64,Default,,0,0,0,,Өйткені бәріміз қолымыздан келгеннің бәрін істеуге бел будық.
Dialogue: 0,0:06:39.94,0:06:40.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:41.06,0:06:42.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:42.27,0:06:43.40,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:06:48.44,0:06:50.99,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:06:51.11,0:06:52.62,Default,,0,0,0,,Қорқынышты жол
Dialogue: 0,0:06:53.45,0:06:54.28,Default,,0,0,0,,Ах
Dialogue: 0,0:06:55.41,0:06:56.24,Default,,0,0,0,,Осы жерден айналып өтейік…
Dialogue: 0,0:06:56.58,0:06:58.70,Default,,0,0,0,,Ха ха ха... Жарайсың ба?
Dialogue: 0,0:06:58.83,0:07:00.21,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:07:01.12,0:07:03.75,Default,,0,0,0,,Мақсат дәл сіздің алдыңызда
Dialogue: 0,0:07:05.29,0:07:06.63,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:07:06.75,0:07:09.42,Default,,0,0,0,,Мен ешкімнің алдыма жүгіруіне жол бермеймін.
Dialogue: 0,0:07:09.55,0:07:11.88,Default,,0,0,0,,Жарайды, мен жеңілмеймін.
Dialogue: 0,0:07:12.01,0:07:13.89,Default,,0,0,0,,(Сүлгі шайтанның ауыр демі)
Dialogue: 0,0:07:17.31,0:07:19.56,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:07:19.68,0:07:22.10,Default,,0,0,0,,Кішкене тырысайық!
Dialogue: 0,0:07:22.23,0:07:23.35,Default,,0,0,0,,Фуго!
Dialogue: 0,0:07:23.77,0:07:25.65,Default,,0,0,0,,А, мен қырынған мұз жегім келеді.
Dialogue: 0,0:07:25.77,0:07:27.78,Default,,0,0,0,,Әдемі мұзды құлпынай-чан
Dialogue: 0,0:07:27.90,0:07:28.86,Default,,0,0,0,,Ичиго-чан?
Dialogue: 0,0:07:28.99,0:07:31.28,Default,,0,0,0,,Мұзға келетін болсақ, бұл сөзсіз қауын-чан.
Dialogue: 0,0:07:31.40,0:07:33.20,Default,,0,0,0,,Балалар сендер әлі баласыңдар.
Dialogue: 0,0:07:33.32,0:07:35.12,Default,,0,0,0,,Ересектердің дәмі - Уджи Кинтоки
Dialogue: 0,0:07:35.24,0:07:36.08,Default,,0,0,0,,Не?
Dialogue: 0,0:07:36.20,0:07:37.03,Default,,0,0,0,,Иіс
Dialogue: 0,0:07:37.16,0:07:38.16,Default,,0,0,0,,Анда және міне!
Dialogue: 0,0:07:38.29,0:07:39.25,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:07:39.50,0:07:41.16,Default,,0,0,0,,Мен үшеуін де жақсы көремін
Dialogue: 0,0:07:41.29,0:07:42.33,Default,,0,0,0,,Фуго~ (3 адам) Ха...
Dialogue: 0,0:07:42.46,0:07:45.25,Default,,0,0,0,,Не болды? Мен мүлде алға жылжымаймын.
Dialogue: 0,0:07:45.38,0:07:47.17,Default,,0,0,0,,Мен сізге тек қолыңызбен итеруге тырыспаңыз дедім.
Dialogue: 0,0:07:47.30,0:07:48.13,Default,,0,0,0,,Бұл батыл!
Dialogue: 0,0:07:48.88,0:07:50.97,Default,,0,0,0,,Цк, мен білемін.
Dialogue: 0,0:07:51.30,0:07:52.47,Default,,0,0,0,,Алға
Dialogue: 0,0:07:52.59,0:07:53.80,Default,,0,0,0,,Гатун!
Dialogue: 0,0:07:53.93,0:07:55.01,Default,,0,0,0,,Гатун!
Dialogue: 0,0:07:55.14,0:07:55.97,Default,,0,0,0,,Гатун!
Dialogue: 0,0:07:58.14,0:07:58.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:59.10,0:08:00.98,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:08:01.85,0:08:03.39,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:08:04.56,0:08:07.94,Default,,0,0,0,,Мен не істеуім керек? Мақсатқа жетуге аз қалды
Dialogue: 0,0:08:08.69,0:08:10.15,Default,,0,0,0,,Басудан басқа амалым жоқ.
Dialogue: 0,0:08:10.28,0:08:12.40,Default,,0,0,0,,А, мынаны басыңыз.
Dialogue: 0,0:08:12.53,0:08:13.36,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:14.41,0:08:16.32,Default,,0,0,0,,Се~жоқ
Dialogue: 0,0:08:16.45,0:08:17.53,Default,,0,0,0,,Гюго~
Dialogue: 0,0:08:17.66,0:08:18.49,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:08:18.62,0:08:21.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:21.41,0:08:22.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:25.12,0:08:26.29,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:08:26.42,0:08:27.96,Default,,0,0,0,,Иә? (Курита және басқалар) Уау!
Dialogue: 0,0:08:32.13,0:08:33.51,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:33.72,0:08:34.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:35.09,0:08:38.76,Default,,0,0,0,,«Кім жүз миль жол жүрсе, тоқсан тоғыз мильдің жартысы»?
Dialogue: 0,0:08:45.44,0:08:46.98,Default,,0,0,0,,Барлығы баяу.
Dialogue: 0,0:08:47.10,0:08:49.11,Default,,0,0,0,,Келетін уақыт та қалды.
Dialogue: 0,0:08:49.23,0:08:50.11,Default,,0,0,0,,Ах
Dialogue: 0,0:08:52.99,0:08:55.74,Default,,0,0,0,,Бұл өте қиын~ Өте қиын~!
Dialogue: 0,0:08:55.99,0:08:58.91,Default,,0,0,0,,Менімен бірге жүр~!
Dialogue: 0,0:08:59.03,0:09:01.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:07.08,0:09:08.67,Default,,0,0,0,,Қарғыс атсын, асты лай...
Dialogue: 0,0:09:09.09,0:09:10.75,Default,,0,0,0,,Алаңдамаңыз
Dialogue: 0,0:09:10.88,0:09:12.30,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:09:12.42,0:09:13.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:17.59,0:09:20.22,Default,,0,0,0,,Бірақ бұл жақсы нәрсе болған шығар.
Dialogue: 0,0:09:20.35,0:09:21.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:21.76,0:09:25.18,Default,,0,0,0,,Құдай маған мұны қазірдің өзінде аяқтауды айтып жатқанына сенімдімін.
Dialogue: 0,0:09:28.31,0:09:29.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:30.48,0:09:31.44,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:09:31.57,0:09:33.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:34.07,0:09:36.20,Default,,0,0,0,,Сен неге сонша үмітсізсің?
Dialogue: 0,0:09:36.32,0:09:39.41,Default,,0,0,0,,Сіз көп еңбек еттіңіз, бұл аз!
Dialogue: 0,0:09:42.74,0:09:43.79,Default,,0,0,0,,Мен сізге көмектесемін!
Dialogue: 0,0:09:44.29,0:09:45.75,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,0:09:46.04,0:09:47.12,Default,,0,0,0,,Не? (Сүзүнэ) Ах.
Dialogue: 0,0:09:47.42,0:09:49.50,Default,,0,0,0,,Біз тек сызықты басамыз.
Dialogue: 0,0:09:49.63,0:09:51.09,Default,,0,0,0,,Менімен аралассаң, мен сені үрлеймін!
Dialogue: 0,0:09:51.84,0:09:52.71,Default,,0,0,0,,Иә
Dialogue: 0,0:10:07.35,0:10:09.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:09.65,0:10:12.15,Default,,0,0,0,,Сәлем! Мен сізге қажетсіз істермен айналыспаңыз дедім!
Dialogue: 0,0:10:12.48,0:10:15.40,Default,,0,0,0,,Джумонжи-кун үшін итермеңіз.
Dialogue: 0,0:10:15.69,0:10:18.15,Default,,0,0,0,,Өйткені мақсатқа бәріміз бірге жеткіміз келеді.
Dialogue: 0,0:10:18.61,0:10:21.53,Default,,0,0,0,,Шулы ~ Маған кедергі жасама дедім!
Dialogue: 0,0:10:22.33,0:10:23.16,Default,,0,0,0,,Эй!
Dialogue: 0,0:10:23.49,0:10:25.37,Default,,0,0,0,,Қазір ұрысатын уақыт емес!
Dialogue: 0,0:10:25.49,0:10:27.66,Default,,0,0,0,,Әй, тез қаш!
Dialogue: 0,0:10:27.79,0:10:29.79,Default,,0,0,0,,Барлығына! Ол батып кетеді
Dialogue: 0,0:10:31.88,0:10:33.79,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:10:34.92,0:10:38.76,Default,,0,0,0,,Уф... жоқ, батып кетесің.
Dialogue: 0,0:10:41.22,0:10:43.68,Default,,0,0,0,,Сукедачи Макс!
Dialogue: 0,0:10:44.72,0:10:45.56,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:46.31,0:10:47.39,Default,,0,0,0,,Монта
Dialogue: 0,0:10:47.68,0:10:48.52,Default,,0,0,0,,Темера
Dialogue: 0,0:10:48.64,0:10:51.35,Default,,0,0,0,,Маған саптық топтың жұмысына кедергі жасамау керектігін айтты...
Dialogue: 0,0:10:51.48,0:10:52.69,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:10:52.81,0:10:53.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:54.44,0:10:55.69,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:10:56.61,0:10:59.36,Default,,0,0,0,,Осылай келіп, сәтсіздікке ұшырасаңыз, сіз де, балаларыңыз да жоқ болады.
Dialogue: 0,0:11:02.70,0:11:03.87,Default,,0,0,0,,Төбе жын!
Dialogue: 0,0:11:06.79,0:11:08.83,Default,,0,0,0,,Бұл қауіпті, тез қаш!
Dialogue: 0,0:11:09.16,0:11:10.58,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:11:10.71,0:11:11.79,Default,,0,0,0,,Фуго!
Dialogue: 0,0:11:14.59,0:11:16.00,Default,,0,0,0,,Иә
Dialogue: 0,0:11:18.21,0:11:20.88,Default,,0,0,0,,Юкимицу мырза, Таки мырза
Dialogue: 0,0:11:21.51,0:11:25.35,Default,,0,0,0,,Мен өзімді жақсы емес деп ойласам, сен де маған көмектестің.
Dialogue: 0,0:11:25.64,0:11:27.10,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:11:27.22,0:11:29.10,Default,,0,0,0,,Бұл маған ғана жетеді.
Dialogue: 0,0:11:29.48,0:11:32.02,Default,,0,0,0,,Жарайсыңдар! Бәріміз бірге жұмыс жасасақ
Dialogue: 0,0:11:32.14,0:11:33.52,Default,,0,0,0,,Кеттік, Макс!
Dialogue: 0,0:11:33.85,0:11:36.52,Default,,0,0,0,,(Әндер)
Dialogue: 0,0:11:37.07,0:11:39.90,Default,,0,0,0,,Неліктен? Неге сонша...
Dialogue: 0,0:11:43.11,0:11:43.95,Default,,0,0,0,,Тоқтатылды!
Dialogue: 0,0:11:44.41,0:11:45.70,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:11:45.83,0:11:47.24,Default,,0,0,0,,Дәл осылай!
Dialogue: 0,0:11:47.37,0:11:48.29,Default,,0,0,0,,Басыңыз!
Dialogue: 0,0:11:48.41,0:11:49.70,Default,,0,0,0,,(Әндер)
Dialogue: 0,0:11:49.83,0:11:51.04,Default,,0,0,0,,Ол қозғалды!
Dialogue: 0,0:11:51.41,0:11:52.87,Default,,0,0,0,,Керемет!
Dialogue: 0,0:11:55.71,0:11:56.88,Default,,0,0,0,,Керемет!
Dialogue: 0,0:11:57.42,0:11:59.84,Default,,0,0,0,,Неліктен? Мен түсінбеймін
Dialogue: 0,0:12:04.80,0:12:05.97,Default,,0,0,0,,Сәлем, мамо-ни!
Dialogue: 0,0:12:06.10,0:12:07.22,Default,,0,0,0,,Неге тоқтамайсың?
Dialogue: 0,0:12:09.18,0:12:10.60,Default,,0,0,0,,Оны қалай ғана көруге болады?
Dialogue: 0,0:12:13.48,0:12:14.94,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:12:15.40,0:12:17.15,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:12:25.66,0:12:27.03,Default,,0,0,0,,Ах, уау!
Dialogue: 0,0:12:27.58,0:12:29.45,Default,,0,0,0,,Әй, сен не істеп жатырсың!
Dialogue: 0,0:12:29.58,0:12:30.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:31.87,0:12:33.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:33.16,0:12:34.67,Default,,0,0,0,,Жылдам басыңыз
Dialogue: 0,0:12:35.58,0:12:38.04,Default,,0,0,0,,Лас-Вегасқа келгенде қырылған мұзды жейік!
Dialogue: 0,0:12:38.17,0:12:40.13,Default,,0,0,0,,Мұз Ичиго-чан күші!
Dialogue: 0,0:12:40.25,0:12:41.96,Default,,0,0,0,,Қауын-чан шайқасы~!
Dialogue: 0,0:12:42.09,0:12:42.92,Default,,0,0,0,,Бірінші адамның атын жазғаныңыздан бері қанша секунд өтті?
Dialogue: 0,0:12:46.76,0:12:49.68,Default,,0,0,0,,Кішкене ғана, бар күшіңді сал!
Dialogue: 0,0:12:49.81,0:12:55.10,Default,,0,0,0,,Ооо... Бұзыңыз~ Жойыңыз~
Dialogue: 0,0:12:55.23,0:12:56.44,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:12:56.73,0:13:00.98,Default,,0,0,0,,Бұл балалар ең соңында тамаша жиналды.
Dialogue: 0,0:13:01.11,0:13:05.82,Default,,0,0,0,,Оны жойыңыз~ Оны жойыңыз~
Dialogue: 0,0:13:06.32,0:13:10.24,Default,,0,0,0,,Оны жойыңыз~ Оны жойыңыз~
Dialogue: 0,0:13:10.91,0:13:14.66,Default,,0,0,0,,Оны жойыңыз~ Оны жойыңыз~
Dialogue: 0,0:13:14.91,0:13:19.08,Default,,0,0,0,,Оны жойыңыз~ Оны жойыңыз~
Dialogue: 0,0:13:19.46,0:13:23.46,Default,,0,0,0,,Оны құрту~ Оны жою~
Dialogue: 0,0:13:24.22,0:13:26.51,Default,,0,0,0,,Екеуміз 2000 шақырым жолды бірге еңбек еттік.
Dialogue: 0,0:13:26.80,0:13:28.51,Default,,0,0,0,,Мақсатқа бәріміз бірге жетейік
Dialogue: 0,0:13:28.93,0:13:30.55,Default,,0,0,0,,Біз бір командамыз
Dialogue: 0,0:13:30.68,0:13:32.31,Default,,0,0,0,,Оны құлатыңыз~
Dialogue: 0,0:13:32.68,0:13:37.19,Default,,0,0,0,,Оны жойыңыз~ Оны жойыңыз~
Dialogue: 0,0:13:37.31,0:13:40.56,Default,,0,0,0,,Бар күшіңізді салыңыз, барлығыңыз!
Dialogue: 0,0:13:41.65,0:13:44.44,Default,,0,0,0,,Оны жойыңыз~ Оны жойыңыз~
Dialogue: 0,0:13:44.82,0:13:47.91,Default,,0,0,0,,Оны жойыңыз~ Оны жойыңыз~
Dialogue: 0,0:13:48.16,0:13:49.37,Default,,0,0,0,,Оны жойыңыз~
Dialogue: 0,0:13:49.49,0:13:52.37,Default,,0,0,0,,Бұзыңыз~ Оны жойыңыз~
Dialogue: 0,0:13:52.58,0:13:55.37,Default,,0,0,0,,Оны құрту~ Оны жою~
Dialogue: 0,0:13:55.58,0:13:58.62,Default,,0,0,0,,Оны құрту~ Оны жою~
Dialogue: 0,0:13:58.75,0:13:59.63,Default,,0,0,0,,Бірақ қызық емес пе?
Dialogue: 0,0:14:00.50,0:14:01.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:01.46,0:14:02.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:02.46,0:14:03.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:06.76,0:14:07.59,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:14:07.97,0:14:09.09,Default,,0,0,0,,Дәл осылай!
Dialogue: 0,0:14:09.22,0:14:10.84,Default,,0,0,0,,Барымызды салайық! (Комусуби) Фуго!
Dialogue: 0,0:14:10.97,0:14:12.05,Default,,0,0,0,,О!
Dialogue: 0,0:14:12.51,0:14:15.98,Default,,0,0,0,,Бұзыңыз~ Оны жойыңыз~
Dialogue: 0,0:14:16.18,0:14:17.64,Default,,0,0,0,,Оны жойыңыз~
Dialogue: 0,0:14:18.27,0:14:21.11,Default,,0,0,0,,Жарайды, сол төбеден өткенде, сіз Лас-Вегаста боласыз.
Dialogue: 0,0:14:21.23,0:14:23.52,Default,,0,0,0,,Әр адам тасымалдаушыға міне алады!
Dialogue: 0,0:14:23.98,0:14:25.15,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:14:25.28,0:14:27.36,Default,,0,0,0,,Иә? Бұл әзіл емес
Dialogue: 0,0:14:27.49,0:14:30.11,Default,,0,0,0,,Енді осы уақытқа дейін келдіңіз, платформадағы мәреге жете аласыз ба?
Dialogue: 0,0:14:30.24,0:14:31.99,Default,,0,0,0,,Соңында бәрін басуға рұқсат етіңіз.
Dialogue: 0,0:14:32.62,0:14:33.74,Default,,0,0,0,,Фуго~
Dialogue: 0,0:14:33.87,0:14:36.00,Default,,0,0,0,,Керемет! Бұл таңқаларлық
Dialogue: 0,0:14:36.83,0:14:40.83,Default,,0,0,0,,Оны жойыңыз~ Оны жойыңыз~
Dialogue: 0,0:14:40.96,0:14:42.92,Default,,0,0,0,,Оны жойыңыз!
Dialogue: 0,0:14:49.17,0:14:50.26,Default,,0,0,0,,Әй, қара
Dialogue: 0,0:14:50.76,0:14:51.59,Default,,0,0,0,,Иә! (Курита) Ах!
Dialogue: 0,0:14:51.76,0:14:53.10,Default,,0,0,0,,Ха! (Джумонджи) Ха!
Dialogue: 0,0:14:53.22,0:14:54.35,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:14:54.47,0:14:55.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:07.61,0:15:09.95,Default,,0,0,0,,Лас-Вегас!
Dialogue: 0,0:15:13.57,0:15:17.95,Default,,0,0,0,,Өлім наурыз 2000 км, барлығы оны аяқтады~
Dialogue: 0,0:15:18.50,0:15:20.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:21.04,0:15:22.88,Default,,0,0,0,,(Куританың айқайы)
Dialogue: 0,0:15:23.00,0:15:26.88,Default,,0,0,0,,Кя~ Суық! Неліктен фонтан осы уақытқа дейін?
Dialogue: 0,0:15:31.55,0:15:35.80,Default,,0,0,0,,Біз мұны жасадық... бірге жасадық
Dialogue: 0,0:15:36.51,0:15:38.39,Default,,0,0,0,,Мен сені жалап едім.
Dialogue: 0,0:15:38.56,0:15:41.27,Default,,0,0,0,,Мен 0 оқушы болады деп ешқашан елестеткен емеспін.
Dialogue: 0,0:15:41.98,0:15:45.15,Default,,0,0,0,,Күш пен төзімділік Оны бір ай бұрынғымен салыстыруға да келмейді.
Dialogue: 0,0:15:45.27,0:15:46.90,Default,,0,0,0,,Ол күшейе түсуі керек.
Dialogue: 0,0:15:47.73,0:15:48.90,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:15:49.03,0:15:50.07,Default,,0,0,0,,Жүк көлігі...
Dialogue: 0,0:15:50.19,0:15:52.86,Default,,0,0,0,,Біріншіге қарағанда жеңілірек сияқты...
Dialogue: 0,0:15:53.11,0:15:57.20,Default,,0,0,0,,Бірақ бұл Kanto қуатын 100% жеңу үшін жеткіліксіз.
Dialogue: 0,0:15:58.04,0:16:01.41,Default,,0,0,0,,Осы азаптауды соңына дейін жеткізген тәжірибе мен ақыл-ой күші
Dialogue: 0,0:16:01.54,0:16:03.92,Default,,0,0,0,,Бұл қабілет айырмашылығын төңкереді
Dialogue: 0,0:16:04.04,0:16:06.42,Default,,0,0,0,,Америка футболы да жүрек ойыны.
Dialogue: 0,0:16:06.54,0:16:08.17,Default,,0,0,0,,Мен ілулі тұрмын
Dialogue: 0,0:16:08.71,0:16:12.13,Default,,0,0,0,,Әзірше, жарысты аяқтау үшін тек қана мас болыңыз!
Dialogue: 0,0:16:12.68,0:16:15.09,Default,,0,0,0,,Жарайсың, 2000км жүгірдім.
Dialogue: 0,0:16:15.22,0:16:17.85,Default,,0,0,0,,Балалар, сендер ең жақсысыңдар!
Dialogue: 0,0:16:18.85,0:16:21.23,Default,,0,0,0,,Қандай тамаша сөз.
Dialogue: 0,0:16:22.35,0:16:23.48,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:16:23.60,0:16:25.77,Default,,0,0,0,,Ешкім тыңдамайды.
Dialogue: 0,0:16:25.98,0:16:26.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:28.02,0:16:29.32,Default,,0,0,0,,Хаа…
Dialogue: 0,0:16:30.53,0:16:31.78,Default,,0,0,0,,(Дәрігер күрсінеді)
Dialogue: 0,0:16:35.24,0:16:37.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:38.62,0:16:40.08,Default,,0,0,0,,Қоштасу.
Dialogue: 0,0:16:40.33,0:16:41.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:41.29,0:16:42.62,Default,,0,0,0,,Жапонияға бірге оралу
Dialogue: 0,0:16:42.75,0:16:45.58,Default,,0,0,0,,Мен сіздің жаттықтырушы болғым келеді.
Dialogue: 0,0:16:46.46,0:16:48.63,Default,,0,0,0,,Мен Жапонияға қайтып бара алмаймын.
Dialogue: 0,0:16:49.21,0:16:52.30,Default,,0,0,0,,Не? Мм... бұл неге?
Dialogue: 0,0:16:53.88,0:16:55.55,Default,,0,0,0,,Біз қоштасар алдында кездесеміз.
Dialogue: 0,0:16:55.68,0:16:56.51,Default,,0,0,0,,Қый!
Dialogue: 0,0:16:56.89,0:17:00.14,Default,,0,0,0,,Ібілістің жүгіруі «Ібіліс жарғанатының елесі»
Dialogue: 0,0:17:00.35,0:17:01.77,Default,,0,0,0,,Осы уақытқа дейін аяқталуы керек еді.
Dialogue: 0,0:17:01.89,0:17:02.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:03.27,0:17:05.14,Default,,0,0,0,,Оны қатты қиратамын
Dialogue: 0,0:17:05.27,0:17:06.98,Default,,0,0,0,,Соңында мені шығарып сал.
Dialogue: 0,0:17:08.19,0:17:09.98,Default,,0,0,0,,Мен Добуроку Сенсэймін...
Dialogue: 0,0:17:10.15,0:17:11.23,Default,,0,0,0,,Бұл шынымен рас па?
Dialogue: 0,0:17:12.23,0:17:15.99,Default,,0,0,0,,Бірақ мен 2000 км өлім маршында соңына дейін шыдадым.
Dialogue: 0,0:17:16.45,0:17:17.41,Default,,0,0,0,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,0:17:24.16,0:17:25.96,Default,,0,0,0,,Мен көптен бері жаттығып жүрмін.
Dialogue: 0,0:17:26.08,0:17:29.17,Default,,0,0,0,,Жылдамдықты төмендетпейтін тежегіштері бар зигзаг!
Dialogue: 0,0:17:49.27,0:17:50.19,Default,,0,0,0,,А...
Dialogue: 0,0:17:51.11,0:17:52.02,Default,,0,0,0,,шықтыңыз ба?
Dialogue: 0,0:17:53.11,0:17:55.57,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:17:55.69,0:17:58.32,Default,,0,0,0,,Жаңа ғана көрген сұмдық менің көзіме түсті
Dialogue: 0,0:18:02.91,0:18:03.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:04.66,0:18:06.00,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:10.08,0:18:12.92,Default,,0,0,0,,Бұл мақсат емес! Темера
Dialogue: 0,0:18:13.21,0:18:15.71,Default,,0,0,0,,Ақырында, бұл күзгі турнирдің бастапқы сызығы.
Dialogue: 0,0:18:15.84,0:18:16.67,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:18:17.26,0:18:19.43,Default,,0,0,0,,Қазір бәрі жақсы, солай ма?
Dialogue: 0,0:18:22.55,0:18:24.31,Default,,0,0,0,,Үлкен дене күші
Dialogue: 0,0:18:24.43,0:18:26.85,Default,,0,0,0,,Неліктен бір адам ғана қобалжиды?
Dialogue: 0,0:18:27.35,0:18:29.77,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:18:31.48,0:18:33.27,Default,,0,0,0,,Аға, ағаң туралы сұрауым керек.
Dialogue: 0,0:18:33.40,0:18:35.32,Default,,0,0,0,,Мен бәрібір өтемін бе?
Dialogue: 0,0:18:36.90,0:18:38.32,Default,,0,0,0,,Жоқ! Сузунэ-чан
Dialogue: 0,0:18:38.45,0:18:39.28,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:41.70,0:18:43.03,Default,,0,0,0,,Ертең маған беріңіз
Dialogue: 0,0:18:43.16,0:18:43.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:44.87,0:18:48.87,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:18:56.00,0:19:02.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:03.91,0:20:09.91,Default,,0,0,0,,~♪
Dialogue: 0,0:20:12.21,0:20:14.63,Default,,0,0,0,,О! Керемет Фудзияма!
Dialogue: 0,0:20:15.13,0:20:16.84,Default,,0,0,0,,Мен Жапонияға оралдым
Dialogue: 0,0:20:16.96,0:20:19.63,Default,,0,0,0,,Сусуму Оджо мен Сакураба мырза Фудзи тауында.
Dialogue: 0,0:20:19.76,0:20:22.30,Default,,0,0,0,,Ол күзгі турнирге қиын жаттығулар жасап жатқан болуы керек.\NСакураба
Dialogue: 0,0:20:22.42,0:20:25.43,Default,,0,0,0,,оқу лагерінен қашып кетті ме?
Dialogue: 0,0:20:25.55,0:20:27.68,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:20:29.60,0:20:30.93,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:20:32.43,0:20:38.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory