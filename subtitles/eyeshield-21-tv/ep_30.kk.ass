Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.66,0:00:05.79,Default,,0,0,0,,♪ Фуфуфу~ Пікір қажет емес.
Dialogue: 0,0:00:05.92,0:00:10.30,Default,,0,0,0,,♪ Мен континенттің дрифтісімін
Dialogue: 0,0:00:10.38,0:00:12.01,Default,,0,0,0,,...Сен қалай ойлайсың?
Dialogue: 0,0:00:12.13,0:00:14.51,Default,,0,0,0,,Deco Truck Devil Bat қаншалықты ыңғайлы?
Dialogue: 0,0:00:14.97,0:00:18.47,Default,,0,0,0,,Ғажайып, шексіз жол
Dialogue: 0,0:00:18.68,0:00:21.39,Default,,0,0,0,,Қаладан шыққанда көкжиек қана көрінеді.
Dialogue: 0,0:00:21.52,0:00:24.44,Default,,0,0,0,,Гахахаха! Америка үлкен
Dialogue: 0,0:00:25.56,0:00:27.19,Default,,0,0,0,,Жоқ, мен құтқарылдым.
Dialogue: 0,0:00:27.77,0:00:30.98,Default,,0,0,0,,Бұл жігітпен автостоппен де жүре алмайсың.
Dialogue: 0,0:00:31.11,0:00:33.03,Default,,0,0,0,,Жоқ, бұл бізбіз.
Dialogue: 0,0:00:33.15,0:00:34.99,Default,,0,0,0,,Жабайы зеңбірекшілер жаттығу жасап жатқан ранчода
Dialogue: 0,0:00:35.11,0:00:36.57,Default,,0,0,0,,Маған түнеуге рұқсат бергеніңізге сене алар емеспін.
Dialogue: 0,0:00:36.82,0:00:40.04,Default,,0,0,0,,Алдағы екі күнде тамаша жаттығуға болады.
Dialogue: 0,0:00:40.41,0:00:45.00,Default,,0,0,0,,Шынында да, біреу алда мүлдем ойламайды.
Dialogue: 0,0:00:53.55,0:00:54.92,Default,,0,0,0,,(тоқтату дыбысы)
Dialogue: 0,0:00:55.93,0:00:58.43,Default,,0,0,0,,Бен Ранчтың келуі!
Dialogue: 0,0:00:58.80,0:00:59.64,Default,,0,0,0,,Кең!
Dialogue: 0,0:01:05.98,0:01:08.15,Default,,0,0,0,,Гахахаха!
Dialogue: 0,0:01:10.40,0:01:12.32,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасауға тырысыңыз!
Dialogue: 0,0:01:12.82,0:01:15.11,Default,,0,0,0,,Itadakimasu!
Dialogue: 0,0:01:19.16,0:01:20.28,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:01:20.62,0:01:21.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:21.87,0:01:24.70,Default,,0,0,0,,Уау~ Келме! Cerberus!
Dialogue: 0,0:01:24.83,0:01:26.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:27.17,0:01:29.17,Default,,0,0,0,,Иә! Келме! Келме!
Dialogue: 0,0:01:29.46,0:01:30.29,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:39.26,0:01:40.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:41.01,0:01:47.02,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:54.34,0:03:00.34,Default,,0,0,0,,~♪
Dialogue: 0,0:03:11.35,0:03:12.60,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:03:12.90,0:03:13.90,Default,,0,0,0,,Мен енді тамақ жей алмаймын
Dialogue: 0,0:03:14.52,0:03:17.07,Default,,0,0,0,,Сенің қандай түсінігің бар, бейбақ?
Dialogue: 0,0:03:19.24,0:03:20.65,Default,,0,0,0,,Ататата…
Dialogue: 0,0:03:20.78,0:03:22.49,Default,,0,0,0,,Мусашиге не болды?
Dialogue: 0,0:03:22.95,0:03:26.45,Default,,0,0,0,,Бұл үш адамның берген уәдесі емес пе?
Dialogue: 0,0:03:26.74,0:03:29.45,Default,,0,0,0,,Рождестволық тостағанға бірге барайық.
Dialogue: 0,0:03:29.58,0:03:30.87,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:31.00,0:03:32.29,Default,,0,0,0,,Шу!
Dialogue: 0,0:03:32.58,0:03:34.58,Default,,0,0,0,,Мусаши міндетті түрде оралады
Dialogue: 0,0:03:34.79,0:03:37.50,Default,,0,0,0,,Мен жоспарларымның бұзылғанын қаламаймын.
Dialogue: 0,0:03:40.09,0:03:41.72,Default,,0,0,0,,Олай болса мені қазір әкел!
Dialogue: 0,0:03:42.01,0:03:43.34,Default,,0,0,0,,Енді?
Dialogue: 0,0:03:43.64,0:03:45.85,Default,,0,0,0,,Заттардың реті бар.
Dialogue: 0,0:03:46.97,0:03:48.26,Default,,0,0,0,,Бұл…
Dialogue: 0,0:03:49.18,0:03:51.14,Default,,0,0,0,,Не... нені айтып тұрсың?
Dialogue: 0,0:03:51.27,0:03:53.98,Default,,0,0,0,,Мм... иә Мусаши деген не?
Dialogue: 0,0:03:54.35,0:03:56.44,Default,,0,0,0,,Му... Мусаши... дегенді білдіреді.
Dialogue: 0,0:03:58.94,0:04:02.61,Default,,0,0,0,,Біз доспыз, мен және сүлгі жын.
Dialogue: 0,0:04:03.78,0:04:06.95,Default,,0,0,0,,Біз әлі орта мектеп оқушысы кезімізде
Dialogue: 0,0:04:08.91,0:04:10.41,Default,,0,0,0,,Сіз форманы жасадыңыз ба?
Dialogue: 0,0:04:11.37,0:04:13.41,Default,,0,0,0,,Әдеттегідей, бірдеңе істеуге әлі ерте
Dialogue: 0,0:04:13.54,0:04:16.08,Default,,0,0,0,,Аты Эфедра Ібіліс Жарғанақтары
Dialogue: 0,0:04:16.38,0:04:19.05,Default,,0,0,0,,Егер сіз мұны орта мектептен жасасаңыз, сіз орта мектепте артықшылыққа ие боласыз.
Dialogue: 0,0:04:19.17,0:04:21.38,Default,,0,0,0,,Рождестволық ыдыс Сіз барасыз ба?
Dialogue: 0,0:04:22.67,0:04:24.43,Default,,0,0,0,,Уф... Иә, кеттік!
Dialogue: 0,0:04:26.55,0:04:28.22,Default,,0,0,0,,Ібіліс жарғанақтары?
Dialogue: 0,0:04:28.93,0:04:31.39,Default,,0,0,0,,Жалғыз күші күште болатын алып лайнер.
Dialogue: 0,0:04:31.85,0:04:34.35,Default,,0,0,0,,Ескі көрінетін тепкіш
Dialogue: 0,0:04:34.73,0:04:37.31,Default,,0,0,0,,Және Ібілістің қорғаушысы
Dialogue: 0,0:04:37.86,0:04:41.28,Default,,0,0,0,,Мықты бол, бұл команда жақсы
Dialogue: 0,0:04:46.95,0:04:49.49,Default,,0,0,0,,Бұл Мусаши
Dialogue: 0,0:04:50.87,0:04:52.41,Default,,0,0,0,,Мусаши...
Dialogue: 0,0:04:53.87,0:04:55.54,Default,,0,0,0,,Мына теледидар белгісі?
Dialogue: 0,0:04:56.50,0:04:57.33,Default,,0,0,0,,Иә
Dialogue: 0,0:04:57.63,0:05:00.04,Default,,0,0,0,,Рождестволық ыдысқа міндетті түрде барыңыз
Dialogue: 0,0:05:00.17,0:05:01.71,Default,,0,0,0,,Оны үш адам жазған.
Dialogue: 0,0:05:01.92,0:05:04.92,Default,,0,0,0,,Бірақ ол адам неліктен жұмысын тоқтатты?
Dialogue: 0,0:05:05.17,0:05:07.68,Default,,0,0,0,,Көптеген себептер бар ...
Dialogue: 0,0:05:09.64,0:05:12.56,Default,,0,0,0,,Дұрыс, түсінемін.
Dialogue: 0,0:05:12.97,0:05:13.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:14.64,0:05:15.73,Default,,0,0,0,,Мистер Хилл Демон
Dialogue: 0,0:05:15.85,0:05:18.73,Default,,0,0,0,,Неліктен Ібіліс жарғанақтар тепкенді іздемейді?
Dialogue: 0,0:05:18.94,0:05:19.77,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:05:20.27,0:05:24.03,Default,,0,0,0,,Мұсаши-сан бір күні қайтып келеді деп үміттенемін.
Dialogue: 0,0:05:24.57,0:05:25.40,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:05:26.32,0:05:29.74,Default,,0,0,0,,Төбе шайтандары әрқашан алға қарай ойлайды.
Dialogue: 0,0:05:30.95,0:05:32.95,Default,,0,0,0,,Мен бұл американдық оқу-жаттығу лагеріне сенімдімін
Dialogue: 0,0:05:33.41,0:05:35.91,Default,,0,0,0,,Оның мағынасы біз ойлағаннан да көп.
Dialogue: 0,0:05:36.66,0:05:39.29,Default,,0,0,0,,Сонда мен не істеуім керек...
Dialogue: 0,0:05:40.42,0:05:43.09,Default,,0,0,0,,Сенна Мен мұны істеймін.
Dialogue: 0,0:05:43.92,0:05:46.51,Default,,0,0,0,,Бұдан былай жеңіске жете беріңіз!
Dialogue: 0,0:05:46.92,0:05:49.14,Default,,0,0,0,,Егер солай болса, Мұсаши мырза деген біреу бар.
Dialogue: 0,0:05:49.26,0:05:52.47,Default,,0,0,0,,Мен оның орнында отыра алмай, қайтып келетініне сенімдімін.
Dialogue: 0,0:05:53.14,0:05:55.56,Default,,0,0,0,,Иә, дұрыс, мен сенімдімін
Dialogue: 0,0:05:55.93,0:05:57.77,Default,,0,0,0,,Фугофугофуго
Dialogue: 0,0:05:58.23,0:05:59.35,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:06:00.69,0:06:02.52,Default,,0,0,0,,(Куританың күлкісі)
Dialogue: 0,0:06:02.94,0:06:07.49,Default,,0,0,0,,Дұрыс, Мұсаши қайтып келгенше ұтып жүрейік.
Dialogue: 0,0:06:08.20,0:06:10.49,Default,,0,0,0,,Рождестволық тостағанды ​​мақсат ету үшін барымызды салайық!
Dialogue: 0,0:06:10.74,0:06:13.41,Default,,0,0,0,,Әй, бұл жақсы команда емес пе?
Dialogue: 0,0:06:15.62,0:06:17.16,Default,,0,0,0,,Уау~
Dialogue: 0,0:06:17.46,0:06:21.58,Default,,0,0,0,,Хуа~ Таңертең бұл не?
Dialogue: 0,0:06:21.79,0:06:22.84,Default,,0,0,0,,Таңертеңгілік жаттығу?
Dialogue: 0,0:06:26.38,0:06:28.22,Default,,0,0,0,,Темір тұлпар!
Dialogue: 0,0:06:29.43,0:06:30.80,Default,,0,0,0,,Жарылғыш серпіліс...
Dialogue: 0,0:06:31.34,0:06:35.01,Default,,0,0,0,,Осындай қуат айырмашылығымен біз шетелдіктерге қарсы шайқаста жеңіліп қалдық.
Dialogue: 0,0:06:36.27,0:06:37.98,Default,,0,0,0,,Мықты болыңдар, мылтықшылар
Dialogue: 0,0:06:38.35,0:06:40.14,Default,,0,0,0,,Әлі де күшейе түсуде
Dialogue: 0,0:06:47.65,0:06:49.95,Default,,0,0,0,,Үнділік жүгіру
Dialogue: 0,0:06:52.03,0:06:54.91,Default,,0,0,0,,Бұдан былай мен саған жарылғыш серпіліс күшін беремін.
Dialogue: 0,0:06:55.62,0:06:57.83,Default,,0,0,0,,Костюммен жүгіру керек пе?
Dialogue: 0,0:06:58.41,0:07:00.96,Default,,0,0,0,,Жарылғыш күшті осылай аласыз ба?
Dialogue: 0,0:07:01.08,0:07:02.88,Default,,0,0,0,,Ах~ Идиот.
Dialogue: 0,0:07:03.13,0:07:05.59,Default,,0,0,0,,Әй, бірінші кезекте.
Dialogue: 0,0:07:06.25,0:07:07.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:07.88,0:07:08.76,Default,,0,0,0,,Ыстық~
Dialogue: 0,0:07:08.88,0:07:10.51,Default,,0,0,0,,Жоғарыға шығыңыз!
Dialogue: 0,0:07:10.63,0:07:11.97,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,0:07:12.89,0:07:14.01,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:07:14.35,0:07:15.93,Default,,0,0,0,,Үндістан немен жүгіреді?
Dialogue: 0,0:07:16.35,0:07:17.72,Default,,0,0,0,,Билли ше?
Dialogue: 0,0:07:17.85,0:07:18.89,Default,,0,0,0,,Сәлем~!
Dialogue: 0,0:07:19.98,0:07:21.85,Default,,0,0,0,,Жергілікті американдықтардың рәсімдерінде
Dialogue: 0,0:07:21.98,0:07:25.36,Default,,0,0,0,,Ереже бойынша соңғы адам бірден майданға аттанады.
Dialogue: 0,0:07:25.65,0:07:28.32,Default,,0,0,0,,Қуат таусылғанша жүгіре беретін төзімділік жарысы.
Dialogue: 0,0:07:29.03,0:07:31.03,Default,,0,0,0,,Сызық пен лақтыруды қайталау арқылы
Dialogue: 0,0:07:31.36,0:07:34.28,Default,,0,0,0,,Баламалы аэробты және анаэробты жаттығулар
Dialogue: 0,0:07:34.70,0:07:38.08,Default,,0,0,0,,Жүрек-өкпе қызметін күшейтіп, жылдамдықты жақсартады
Dialogue: 0,0:07:38.20,0:07:40.46,Default,,0,0,0,,Билікті лезде көрсету сияқты әсерлер...
Dialogue: 0,0:07:40.66,0:07:41.87,Default,,0,0,0,,Қиын~
Dialogue: 0,0:07:42.00,0:07:44.17,Default,,0,0,0,,Басқаша айтқанда, сіз жарылғыш серпінді күшке ие боласыз.
Dialogue: 0,0:07:44.58,0:07:45.96,Default,,0,0,0,,Ачи~! Ола
Dialogue: 0,0:07:46.09,0:07:48.88,Default,,0,0,0,,Бөлмеде 1 секундтан артық болған адам ыстық су тозақта!
Dialogue: 0,0:07:54.59,0:07:56.55,Default,,0,0,0,,Өйткені оның керемет аяқтары бар.
Dialogue: 0,0:07:56.89,0:07:58.72,Default,,0,0,0,,Қабақ қалқаны 21
Dialogue: 0,0:07:58.85,0:08:02.27,Default,,0,0,0,,Бұл жай ғана жылдамдық болса, мен патша сарайынан Сусумуға жеңіле алмаймын.
Dialogue: 0,0:08:02.73,0:08:04.02,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:04.81,0:08:06.73,Default,,0,0,0,,Ачи чи чи чи! Бұл қайнаған су болды!
Dialogue: 0,0:08:12.99,0:08:16.78,Default,,0,0,0,,Көп болды, бірақ қызық болды, Америка емес пе?
Dialogue: 0,0:08:17.70,0:08:20.62,Default,,0,0,0,,Ертең үйге бару ұят болатын сияқты.
Dialogue: 0,0:08:20.83,0:08:21.70,Default,,0,0,0,,Иә
Dialogue: 0,0:08:22.71,0:08:25.37,Default,,0,0,0,,Америкаға келгеннен кейін оны тағы да түсіндім.
Dialogue: 0,0:08:25.79,0:08:28.00,Default,,0,0,0,,Хирума мырза мен Курита мырзамен бірдей.
Dialogue: 0,0:08:28.13,0:08:29.67,Default,,0,0,0,,Мен де американдық футболды жақсы көремін.
Dialogue: 0,0:08:30.59,0:08:34.47,Default,,0,0,0,,Мен ойын ойнаудан басқа ештеңе істеуге мәжбүр болдым және достар таба алмадым.
Dialogue: 0,0:08:34.93,0:08:36.47,Default,,0,0,0,,Қазір менің достарым бар
Dialogue: 0,0:08:36.93,0:08:39.64,Default,,0,0,0,,Мен бұл досыммен бірге Рождестволық ыдысқа барғым келеді.
Dialogue: 0,0:08:39.89,0:08:41.02,Default,,0,0,0,,Оны дәлелдейтін дәлелім жоқ, сондай-ақ ол орын алмас бұрын оны болдырмаудың да жолы жоқ —
Dialogue: 0,0:08:44.94,0:08:47.48,Default,,0,0,0,,Мен жеңуім керек, Сусуму-сан.
Dialogue: 0,0:08:48.90,0:08:50.15,Default,,0,0,0,,Эх… Ха-ха-ха
Dialogue: 0,0:08:50.98,0:08:52.78,Default,,0,0,0,,Сіз Сусумуды жеңуге тырысасыз ба?
Dialogue: 0,0:08:54.24,0:08:55.74,Default,,0,0,0,,Мені шығарып сал
Dialogue: 0,0:08:55.91,0:08:57.99,Default,,0,0,0,,Үміт бар ма, көремін.
Dialogue: 0,0:09:01.08,0:09:01.91,Default,,0,0,0,,Иә
Dialogue: 0,0:09:05.12,0:09:07.83,Default,,0,0,0,,Сіз мені жеңе аласыз ба?
Dialogue: 0,0:09:11.17,0:09:12.67,Default,,0,0,0,,Кел! иә!
Dialogue: 0,0:09:31.27,0:09:34.03,Default,,0,0,0,,О, бұл керемет қисық! Мінеки біз!
Dialogue: 0,0:09:36.36,0:09:37.20,Default,,0,0,0,,(Дыбыс)
Dialogue: 0,0:09:39.49,0:09:40.70,Default,,0,0,0,,FB… FB!
Dialogue: 0,0:09:46.46,0:09:48.21,Default,,0,0,0,,Кішкене қулық
Dialogue: 0,0:09:48.62,0:09:51.21,Default,,0,0,0,,Сіздің қаншалықты жылдам болғаныңыз маңызды емес.
Dialogue: 0,0:09:52.63,0:09:55.55,Default,,0,0,0,,Бұл қария жай ғана ішімдік күзетшісі емес.
Dialogue: 0,0:09:55.84,0:09:58.47,Default,,0,0,0,,Мұндай қарт кісі де ұсталады.
Dialogue: 0,0:09:58.84,0:09:59.97,Default,,0,0,0,,Лайықты қорғаныс
Dialogue: 0,0:10:00.34,0:10:04.02,Default,,0,0,0,,Ешқашан Eyeshield-тің өлімге әкелетін әлсіздігін назардан тыс қалдырмаңыз
Dialogue: 0,0:10:06.14,0:10:08.81,Default,,0,0,0,,Өлімге әкелетін әлсіздік?
Dialogue: 0,0:10:09.27,0:10:12.44,Default,,0,0,0,,Шын мәнінде, Сусуму мен Пантерамен байланыста және т.б.
Dialogue: 0,0:10:12.90,0:10:15.48,Default,,0,0,0,,Доппен ішке кіргенде
Dialogue: 0,0:10:16.19,0:10:17.65,Default,,0,0,0,,Сіз оны бір рет болса да жеңдіңіз бе?
Dialogue: 0,0:10:17.90,0:10:18.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:19.41,0:10:21.62,Default,,0,0,0,,Сонда сіздің әлсіз тұсыңыз неде?
Dialogue: 0,0:10:22.45,0:10:24.45,Default,,0,0,0,,Енді маған бұлай айтудың пайдасы жоқ.
Dialogue: 0,0:10:24.91,0:10:25.75,Default,,0,0,0,,Қалдықтар?
Dialogue: 0,0:10:26.95,0:10:29.37,Default,,0,0,0,,Бұлай жалғаса берсе, сіз Сусумуды жеңе алмайсыз.
Dialogue: 0,0:10:37.80,0:10:40.30,Default,,0,0,0,,Осы қарқынмен сіз Сусумуды жеңе алмайсыз.
Dialogue: 0,0:10:43.60,0:10:46.22,Default,,0,0,0,,Үндістанның жүгіруіне қараңыз
Dialogue: 0,0:10:46.35,0:10:48.68,Default,,0,0,0,,Мен Деймонның күшін шамамен түсінемін.
Dialogue: 0,0:10:50.90,0:10:54.27,Default,,0,0,0,,Мысалы, бұл жылқы Қойгахама болса
Dialogue: 0,0:10:54.90,0:10:57.03,Default,,0,0,0,,Команданың шығуға дейін күші жетерлік.
Dialogue: 0,0:10:57.74,0:10:58.74,Default,,0,0,0,,Койгахама
Dialogue: 0,0:10:58.86,0:11:02.07,Default,,0,0,0,,Ібіліс жарғанақтары
Dialogue: 0,0:11:02.20,0:11:04.16,Default,,0,0,0,,Сфинкс айналасындағы бірінші орын ма?
Dialogue: 0,0:11:04.45,0:11:07.91,Default,,0,0,0,,О... Оджу немесе Батыс жабайы қарулы адамдар ше?
Dialogue: 0,0:11:11.25,0:11:12.58,Default,,0,0,0,,Қоршаудан тыс
Dialogue: 0,0:11:12.71,0:11:13.54,Default,,0,0,0,,Е...
Dialogue: 0,0:11:14.42,0:11:17.21,Default,,0,0,0,,НАСА-ның шетелдіктері де дуалдың үстінде.
Dialogue: 0,0:11:17.67,0:11:21.22,Default,,0,0,0,,Балалар сендерге шетелдіктерге қарсы 1 ұпай айырмашылығы болғаны өте бақытты болды.
Dialogue: 0,0:11:21.38,0:11:26.26,Default,,0,0,0,,Сонымен қатар, батыс аймақтар мен патша сарайлары күзгі турнирге өз күштерін жасыруда.
Dialogue: 0,0:11:27.72,0:11:29.35,Default,,0,0,0,,Синрюджи храмын қалай көресіз?
Dialogue: 0,0:11:31.44,0:11:34.81,Default,,0,0,0,,Америка материгінің батыс жағалауы.
Dialogue: 0,0:11:35.19,0:11:37.07,Default,,0,0,0,,Сонда... соншама?
Dialogue: 0,0:11:37.32,0:11:39.24,Default,,0,0,0,,Міне, бұл солай.
Dialogue: 0,0:11:40.95,0:11:42.78,Default,,0,0,0,,Ей, балалар, міне 2 жыл болды.
Dialogue: 0,0:11:43.03,0:11:46.66,Default,,0,0,0,,Соңғы жарыс үшінші курстың күзінде болды.
Dialogue: 0,0:11:47.12,0:11:49.58,Default,,0,0,0,,Мен бір жылда қанша өсе аламын?
Dialogue: 0,0:11:51.08,0:11:54.29,Default,,0,0,0,,Деймон клубының қызметі екінші жылдың күзгі турнирімен аяқталады.
Dialogue: 0,0:11:56.34,0:11:58.75,Default,,0,0,0,,Не? Сонда... бұл рас па?
Dialogue: 0,0:11:59.26,0:12:00.42,Default,,0,0,0,,Ал Са… сен, тез арада мұнда кет.
Dialogue: 0,0:12:00.55,0:12:02.93,Default,,0,0,0,,Соңғы мүмкіндікке бір айдан астам уақыт қалды
Dialogue: 0,0:12:03.05,0:12:06.22,Default,,0,0,0,,Бізді 40 күнде ең күшті командаға айналдыр.
Dialogue: 0,0:12:06.85,0:12:08.26,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:12:08.51,0:12:10.98,Default,,0,0,0,,Небәрі 40 күннен кейін... (Хилл Демон) Мен өлім маршын жасаймын.
Dialogue: 0,0:12:11.81,0:12:12.73,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:12:13.06,0:12:14.31,Default,,0,0,0,,Өлім наурызы?
Dialogue: 0,0:12:14.60,0:12:17.57,Default,,0,0,0,,«Өлім маршы»?
Dialogue: 0,0:12:18.07,0:12:18.90,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:12:19.48,0:12:20.99,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:12:22.36,0:12:25.32,Default,,0,0,0,,Бұл жаттығу емес, бұл жай ғана азаптау.
Dialogue: 0,0:12:27.07,0:12:28.78,Default,,0,0,0,,Өлім маршы ақымақтық
Dialogue: 0,0:12:29.08,0:12:31.25,Default,,0,0,0,,Ойыншы ретіндегі мансабы қысқарған бейбақ.
Dialogue: 0,0:12:31.37,0:12:33.66,Default,,0,0,0,,Мен дәл қазір сіздің алдыңызда тұрмын.
Dialogue: 0,0:12:34.71,0:12:36.54,Default,,0,0,0,,Олай болса, Өлім наурызынан басқа
Dialogue: 0,0:12:36.67,0:12:39.71,Default,,0,0,0,,Турнирде бір айдан кейін жеңіске жетудің жолы бар ма?
Dialogue: 0,0:12:41.88,0:12:42.72,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:45.59,0:12:47.01,Default,,0,0,0,,Басқа таңдау жоқ!
Dialogue: 0,0:12:47.30,0:12:50.39,Default,,0,0,0,,Мен Америкаға әу бастан сол ниетпен келдім.
Dialogue: 0,0:12:52.89,0:12:55.02,Default,,0,0,0,,Мен оларға ілесе алмаймын!
Dialogue: 0,0:12:58.40,0:13:00.98,Default,,0,0,0,,Бұл маңызды емес! Жаса!
Dialogue: 0,0:13:02.94,0:13:03.78,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:13:04.15,0:13:07.24,Default,,0,0,0,,Өлме! Мен Рождестволық ыдысқа барғанша
Dialogue: 0,0:13:19.88,0:13:20.96,Default,,0,0,0,,Мен шарасызмын
Dialogue: 0,0:13:21.59,0:13:26.01,Default,,0,0,0,,Сүлік өзі үшін не істей алады және қазір не істеу керек
Dialogue: 0,0:13:50.20,0:13:52.03,Default,,0,0,0,,Сіз Жапонияға қайта барасыз ба?
Dialogue: 0,0:13:52.62,0:13:53.45,Default,,0,0,0,,Иә
Dialogue: 0,0:13:53.74,0:13:55.70,Default,,0,0,0,,Оқу-жаттығу жиыны бүгін аяқталады.
Dialogue: 0,0:14:02.04,0:14:02.92,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:14:03.05,0:14:07.38,Default,,0,0,0,,Мен және семіз жігіт Америкада қалып, жазғы демалыста арнайы жаттығу жасаймыз.
Dialogue: 0,0:14:07.80,0:14:11.10,Default,,0,0,0,,Менімен қалсаң, сол сызықтан өтіп, осында кел.
Dialogue: 0,0:14:15.56,0:14:16.98,Default,,0,0,0,,Өлім наурызы
Dialogue: 0,0:14:17.39,0:14:20.06,Default,,0,0,0,,Ешкім оны сәтті орындай алмады.
Dialogue: 0,0:14:20.56,0:14:23.02,Default,,0,0,0,,Сынғанынан бастап, орнына лақтыр.
Dialogue: 0,0:14:23.15,0:14:25.03,Default,,0,0,0,,Өмірге кепілдік жоқ.
Dialogue: 0,0:14:25.32,0:14:26.78,Default,,0,0,0,,Сондықтан оны мәжбүрлемеңіз.
Dialogue: 0,0:14:28.15,0:14:31.78,Default,,0,0,0,,Дегенмен, биылғы күзгі турнир тарихтағы ең мықты ойыншыларды жинайды.
Dialogue: 0,0:14:32.24,0:14:34.45,Default,,0,0,0,,Бұл жеңіске жетудің жалғыз жолы
Dialogue: 0,0:14:35.20,0:14:37.71,Default,,0,0,0,,Сіз не істеп жатырсыз? Барлығы
Dialogue: 0,0:14:38.46,0:14:39.75,Default,,0,0,0,,Егер сіз ұшақта жалғастырсаңыз,
Dialogue: 0,0:14:39.87,0:14:43.25,Default,,0,0,0,,Мен үйге жылы төсекке барсам болады, ал анам мені күтіп отыр.
Dialogue: 0,0:14:45.55,0:14:47.97,Default,,0,0,0,,Өлсем де күшейемін.
Dialogue: 0,0:14:48.17,0:14:53.01,Default,,0,0,0,,Жұмаққа билетіңді сындырып, менімен бірге тозаққа бар.
Dialogue: 0,0:14:54.97,0:14:57.98,Default,,0,0,0,,Ешкімнің еркі, өзің шеш
Dialogue: 0,0:14:58.31,0:15:00.44,Default,,0,0,0,,Мен үйге тыныштықпен оралуым керек пе?
Dialogue: 0,0:15:00.69,0:15:03.15,Default,,0,0,0,,Тозақта Ібіліс Батпен бірге өз-өзіңе қол жұмсайсың ба?
Dialogue: 0,0:15:03.94,0:15:07.11,Default,,0,0,0,,Сіз бұл сызықты кесіп өткеннен кейін, өлім шеруіне кері қайтару мүмкін емес.
Dialogue: 0,0:15:07.36,0:15:11.07,Default,,0,0,0,,Тозақта 40 күн өмір сүріңіз немесе өліңіз.
Dialogue: 0,0:15:11.82,0:15:13.82,Default,,0,0,0,,Өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:15:13.95,0:15:15.99,Default,,0,0,0,,Егер мен қазір сол ұшаққа отырсам
Dialogue: 0,0:15:16.12,0:15:19.25,Default,,0,0,0,,Сізді Жапонияда қызықты жазғы демалыс күтіп тұр.
Dialogue: 0,0:15:19.87,0:15:21.00,Default,,0,0,0,,Жазғы демалыс…
Dialogue: 0,0:15:22.79,0:15:26.88,Default,,0,0,0,,Жапонияға оралғанда көптеген қызықты нәрселер болатыны рас.
Dialogue: 0,0:15:27.84,0:15:32.26,Default,,0,0,0,,Мұнда отшашулар, фестивальдар және көптеген қызықты нәрселер бар.
Dialogue: 0,0:15:32.59,0:15:33.43,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:35.22,0:15:36.68,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:15:38.85,0:15:43.02,Default,,0,0,0,,Дәл қазір өзіңіз үшін не істеу керек...
Dialogue: 0,0:15:46.69,0:15:49.11,Default,,0,0,0,,Таро Каминаримон формасы №80
Dialogue: 0,0:15:49.57,0:15:51.15,Default,,0,0,0,,Позиция қабылдаушы!
Dialogue: 0,0:15:51.65,0:15:52.49,Default,,0,0,0,,Хо
Dialogue: 0,0:15:53.24,0:15:56.83,Default,,0,0,0,,Қан тобы B Менің сүйікті тағамым банан
Dialogue: 0,0:15:56.95,0:15:59.83,Default,,0,0,0,,Сүйікті сөзім – талпыныс Менің сүйікті спорт түрім...
Dialogue: 0,0:16:00.08,0:16:02.54,Default,,0,0,0,,Ей, жетеді.
Dialogue: 0,0:16:02.67,0:16:05.88,Default,,0,0,0,,Қазір сіздің сүйікті спорт түрі қандай?
Dialogue: 0,0:16:06.00,0:16:07.67,Default,,0,0,0,,Америка футболы!
Dialogue: 0,0:16:08.00,0:16:08.84,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:12.34,0:16:16.30,Default,,0,0,0,,Мен үшін фестивальдер өмір бойы жұмыс үстелімнен ғана тамашалай алатын нәрсе.
Dialogue: 0,0:16:18.35,0:16:19.18,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:16:20.81,0:16:23.56,Default,,0,0,0,,Мен фестивальге бір рет болса да қатысқым келеді.
Dialogue: 0,0:16:24.73,0:16:27.56,Default,,0,0,0,,Маған ең ұнайтыны – оқу емес.
Dialogue: 0,0:16:30.78,0:16:32.78,Default,,0,0,0,,Юкикогаку №16
Dialogue: 0,0:16:33.28,0:16:35.32,Default,,0,0,0,,Әзірге позициялар жоқ
Dialogue: 0,0:16:37.16,0:16:37.99,Default,,0,0,0,,Фуго!
Dialogue: 0,0:16:38.70,0:16:40.74,Default,,0,0,0,,Комусуби Дайкичи №55
Dialogue: 0,0:16:40.87,0:16:42.20,Default,,0,0,0,,Фуго сызығы!
Dialogue: 0,0:16:42.83,0:16:44.71,Default,,0,0,0,,Комусуби-кун
Dialogue: 0,0:16:45.92,0:16:48.17,Default,,0,0,0,,Tsk, бұл тамаша.
Dialogue: 0,0:16:48.29,0:16:51.13,Default,,0,0,0,,Жазғы демалыста Спарта болды
Dialogue: 0,0:16:51.76,0:16:53.84,Default,,0,0,0,,Эй, кеттік Джумонджи
Dialogue: 0,0:16:56.34,0:16:57.30,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:16:59.60,0:17:02.47,Default,,0,0,0,,Бізден әлсіз адамдар соғысып жатыр.
Dialogue: 0,0:17:02.98,0:17:05.44,Default,,0,0,0,,Юкимицу... Сенпай...
Dialogue: 0,0:17:05.56,0:17:09.02,Default,,0,0,0,,Қабақ қалқаны 21... Жоқ, бұл Сена.
Dialogue: 0,0:17:11.40,0:17:12.74,Default,,0,0,0,,Бұл тесік емес.
Dialogue: 0,0:17:13.28,0:17:14.95,Default,,0,0,0,,Га? (Куроки) Иә?
Dialogue: 0,0:17:15.40,0:17:17.87,Default,,0,0,0,,Менің айналамдағы адамдарға мәңгілікке айтуға рұқсат ете ме?
Dialogue: 0,0:17:18.20,0:17:19.83,Default,,0,0,0,,Бұл пайдасыз қоқыс
Dialogue: 0,0:17:20.20,0:17:21.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:22.24,0:17:24.25,Default,,0,0,0,,Сіз тағы да сабақты өткізіп жібердіңіз бе?
Dialogue: 0,0:17:24.83,0:17:26.75,Default,,0,0,0,,Сендер сияқты маскүнемдер
Dialogue: 0,0:17:26.87,0:17:30.04,Default,,0,0,0,,Мені ешбір орта мектеп қабылдамайды деп ойлаймын.
Dialogue: 0,0:17:30.88,0:17:35.05,Default,,0,0,0,,Джумонджи-кун соңғы кездері жаман достарымен араласып жүрген сияқты.
Dialogue: 0,0:17:35.42,0:17:38.39,Default,,0,0,0,,Оларға қатысың жоқ. Қоқыс жұқпалы.
Dialogue: 0,0:17:40.39,0:17:42.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:42.35,0:17:43.18,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:45.68,0:17:47.56,Default,,0,0,0,,«Уау» деген не!
Dialogue: 0,0:17:48.06,0:17:51.15,Default,,0,0,0,,Анау ақшыл шаш көзді ауыртады.
Dialogue: 0,0:17:52.36,0:17:53.36,Default,,0,0,0,,Ой!
Dialogue: 0,0:17:54.28,0:17:57.53,Default,,0,0,0,,Арттан келген соққы, қорқақтық менің ұраным Кодзи Куроки
Dialogue: 0,0:17:57.82,0:17:59.99,Default,,0,0,0,,Мен Тоно мангасын жақсы көремін... Жыртылған!
Dialogue: 0,0:18:00.12,0:18:01.87,Default,,0,0,0,,Комикс жақсы емес пе?
Dialogue: 0,0:18:01.99,0:18:02.95,Default,,0,0,0,,Жібер, қара, манга...
Dialogue: 0,0:18:04.29,0:18:05.37,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:18:05.79,0:18:07.04,Default,,0,0,0,,Ақымақтар
Dialogue: 0,0:18:08.08,0:18:11.84,Default,,0,0,0,,Шетелдіктер шайқасында бір сәт бөгет жасамадық па?
Dialogue: 0,0:18:14.80,0:18:16.55,Default,,0,0,0,,Жеңіске жетсең, оны бәрі таниды.
Dialogue: 0,0:18:16.67,0:18:18.38,Default,,0,0,0,,Дұрыс, американдық футбол
Dialogue: 0,0:18:20.89,0:18:22.60,Default,,0,0,0,,Не істейміз, Тога?
Dialogue: 0,0:18:22.72,0:18:25.06,Default,,0,0,0,,Джумонжи Өртеніп жатыр
Dialogue: 0,0:18:25.39,0:18:28.23,Default,,0,0,0,,Әзірше манга оқи алмайтыным ауырады.
Dialogue: 0,0:18:28.52,0:18:30.40,Default,,0,0,0,,Американдық комикстерді анда-санда оқу жақсы ма?
Dialogue: 0,0:18:32.56,0:18:33.94,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:36.65,0:18:40.11,Default,,0,0,0,,Ikki Jumonji No. 51 Позиция - сызық
Dialogue: 0,0:18:40.36,0:18:43.58,Default,,0,0,0,,Коджи Куроки №52 Төмендегідей
Dialogue: 0,0:18:43.83,0:18:47.08,Default,,0,0,0,,Шозо Токано №53 Сондай-ақ желіде
Dialogue: 0,0:18:47.33,0:18:48.66,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:18:49.29,0:18:50.12,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:50.50,0:18:51.33,Default,,0,0,0,,Барлығы
Dialogue: 0,0:18:51.46,0:18:54.63,Default,,0,0,0,,Мен шынымен кім болғым келетінін іздеу үшін американдық футбол ойнаймын.
Dialogue: 0,0:18:55.46,0:18:57.09,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:18:57.55,0:18:58.88,Default,,0,0,0,,Бір жүрек
Dialogue: 0,0:18:59.26,0:19:01.97,Default,,0,0,0,,Осы достармен бірге жаттығыңыз және күшті болыңыз!
Dialogue: 0,0:19:05.14,0:19:05.97,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:19:10.56,0:19:12.90,Default,,0,0,0,,Кобаякава Сена №21
Dialogue: 0,0:19:13.02,0:19:15.48,Default,,0,0,0,,Позиция кері бұрылуда
Dialogue: 0,0:19:15.65,0:19:16.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:17.07,0:19:19.32,Default,,0,0,0,,Айсшилд 21 Сена ма?
Dialogue: 0,0:19:19.70,0:19:22.28,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:19:26.66,0:19:28.66,Default,,0,0,0,,Жарайды, шешілді.
Dialogue: 0,0:19:28.79,0:19:31.50,Default,,0,0,0,,Америкадағы өлім маршына қатысушылар
Dialogue: 0,0:19:32.46,0:19:34.00,Default,,0,0,0,,Барлық шайтан шайтан жарғанақтар!
Dialogue: 0,0:19:35.17,0:19:37.92,Default,,0,0,0,,Барлығымыз Рождестволық ыдысқа барайық!
Dialogue: 0,0:19:44.97,0:19:50.98,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:53.08,0:20:59.09,Default,,0,0,0,,~♪
Dialogue: 0,0:21:01.05,0:21:04.30,Default,,0,0,0,,Go Go Go! Өлім наурызы!
Dialogue: 0,0:21:04.51,0:21:06.64,Default,,0,0,0,,Бұл соншалықты алаңсыз әңгіме емес.
Dialogue: 0,0:21:07.05,0:21:11.56,Default,,0,0,0,,Бірақ Сусуму-сан мен Пантер-кун да шыңға қарай жүгіріп келеді.
Dialogue: 0,0:21:11.85,0:21:12.68,Default,,0,0,0,,Мен де...
Dialogue: 0,0:21:12.81,0:21:14.60,Default,,0,0,0,,Жалқау болма
Dialogue: 0,0:21:14.98,0:21:17.02,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:18.56,0:21:19.65,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:21.15,0:21:27.15,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
