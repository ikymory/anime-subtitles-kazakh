Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.55,0:00:14.43,Default,,0,0,0,,Бұлтты су!
Dialogue: 0,0:00:14.51,0:00:15.89,Default,,0,0,0,,Ах (шағын қорытынды) Уф
Dialogue: 0,0:00:16.47,0:00:19.01,Default,,0,0,0,,Агоннан Унсуиге Унсуиден Агонға
Dialogue: 0,0:00:19.10,0:00:20.56,Default,,0,0,0,,Егіздерге ғана тән супер комбинациялы ойын
Dialogue: 0,0:00:20.64,0:00:21.47,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:00:23.64,0:00:25.94,Default,,0,0,0,,Бұл Инелік...
Dialogue: 0,0:00:26.02,0:00:30.61,Default,,0,0,0,,♪~
Dialogue: 0,0:01:45.93,0:01:50.94,Default,,0,0,0,,~♪
Dialogue: 0,0:01:58.28,0:02:01.37,Default,,0,0,0,,Шинрюджи Нага осы уақытқа дейін керемет күш көрсетті.
Dialogue: 0,0:02:01.45,0:02:02.95,Default,,0,0,0,,Ойынға небәрі 3 минут қалды
Dialogue: 0,0:02:03.03,0:02:06.41,Default,,0,0,0,,Біз Деймонды 14 ұпайға жеңдік!
Dialogue: 0,0:02:07.37,0:02:09.37,Default,,0,0,0,,Мені тоқтатсаң да бәрібір
Dialogue: 0,0:02:09.46,0:02:11.08,Default,,0,0,0,,Агонға асығу
Dialogue: 0,0:02:11.17,0:02:12.46,Default,,0,0,0,,Бұл сіздің шыдамдылығыңызды төмендетеді!
Dialogue: 0,0:02:12.54,0:02:13.38,Default,,0,0,0,,Лорд Тенген…
Dialogue: 0,0:02:13.46,0:02:15.09,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:02:15.17,0:02:18.34,Default,,0,0,0,,Егер Агон мырза бүкіл тебу ойынына қатыса алса⸺
Dialogue: 0,0:02:18.42,0:02:21.14,Default,,0,0,0,,Мүмкін сіздің шыдамыңыз таусылатын шығар.
Dialogue: 0,0:02:21.22,0:02:22.64,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:02:22.72,0:02:23.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:23.64,0:02:26.52,Default,,0,0,0,,Сол қорқыныштың шыдамы таусылды.
Dialogue: 0,0:02:26.60,0:02:28.35,Default,,0,0,0,,Мен мұны бұрын ешқашан көрген емеспін.
Dialogue: 0,0:02:29.44,0:02:31.44,Default,,0,0,0,,Олай болса неге соншалықты ұзаққа бардың?
Dialogue: 0,0:02:31.52,0:02:32.77,Default,,0,0,0,,Сіз оған толық қатысуға рұқсат бердіңіз бе?
Dialogue: 0,0:02:33.40,0:02:36.78,Default,,0,0,0,,Ке! Мұнда барлығы толық қатысады.
Dialogue: 0,0:02:36.86,0:02:40.45,Default,,0,0,0,,Бір жаққа тек екінші жақ қатысып, төзімділігін сақтаса ше?
Dialogue: 0,0:02:40.53,0:02:42.74,Default,,0,0,0,,Бұл жеңудің жолы емес, солай ма?
Dialogue: 0,0:02:43.87,0:02:47.70,Default,,0,0,0,,Бірақ Деймонның жеңіске жетуі үшін серпіліс бар.
Dialogue: 0,0:02:47.79,0:02:49.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:50.08,0:02:51.54,Default,,0,0,0,,Қабақ қалқаны 21!
Dialogue: 0,0:02:51.62,0:02:54.38,Default,,0,0,0,,Конго Агонды жылдамдығыңызбен жойыңыз!
Dialogue: 0,0:02:56.25,0:02:57.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:58.26,0:02:59.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:00.13,0:03:04.01,Default,,0,0,0,,Енді, ойын Шинрюджиде басталумен жалғасады!
Dialogue: 0,0:03:04.10,0:03:05.51,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:05.60,0:03:07.72,Default,,0,0,0,,А, қателік пе?
Dialogue: 0,0:03:07.81,0:03:12.23,Default,,0,0,0,,Доп жарық жылдамдығымен қозғалады, Eyeshield 21, Сена Кобаякаваға қарай!
Dialogue: 0,0:03:14.06,0:03:16.19,Default,,0,0,0,,Ол мені әдейі тепкілеп жіберді.
Dialogue: 0,0:03:16.27,0:03:18.90,Default,,0,0,0,,Ойынды тез шешу үшін.
Dialogue: 0,0:03:18.99,0:03:21.61,Default,,0,0,0,,Мен сізге таланттың айырмашылығын түсіндіремін.
Dialogue: 0,0:03:21.70,0:03:23.41,Default,,0,0,0,,Байқап көріңіз, масқара!
Dialogue: 0,0:03:26.66,0:03:29.91,Default,,0,0,0,,Оны шығарыңыз, Ібіліс Бат Елесі!
Dialogue: 0,0:03:36.92,0:03:38.76,Default,,0,0,0,,шықты!
Dialogue: 0,0:03:38.84,0:03:40.92,Default,,0,0,0,,Кенет Аго-кунмен бетпе-бет келді
Dialogue: 0,0:03:41.01,0:03:42.80,Default,,0,0,0,,Ібілістің елесі!
Dialogue: 0,0:03:44.72,0:03:45.76,Default,,0,0,0,,Барлығы жақсы болады, иә?
Dialogue: 0,0:03:46.97,0:03:50.10,Default,,0,0,0,,Эй, сен өткен жолғыға қарағанда жылдамсың.
Dialogue: 0,0:03:50.18,0:03:52.06,Default,,0,0,0,,Ха! Хмм
Dialogue: 0,0:03:56.19,0:03:57.82,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:03:57.90,0:03:58.98,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,0:03:59.07,0:04:00.44,Default,,0,0,0,,Ібіліс жарғанатының елесі
Dialogue: 0,0:04:00.53,0:04:01.78,Default,,0,0,0,,Ібіліс жарғанатының дауылы!
Dialogue: 0,0:04:01.86,0:04:03.53,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:04:03.99,0:04:05.07,Default,,0,0,0,,Ha
Dialogue: 0,0:04:05.49,0:04:06.91,Default,,0,0,0,,Хэхе хахаха...
Dialogue: 0,0:04:07.53,0:04:11.04,Default,,0,0,0,,Ал, 100 қабілеті бар дарынды қарсыласқа қарсы.
Dialogue: 0,0:04:11.12,0:04:15.12,Default,,0,0,0,,10 15-ке айналған сияқты.
Dialogue: 0,0:04:15.21,0:04:16.08,Default,,0,0,0,,Ах
Dialogue: 0,0:04:16.17,0:04:17.88,Default,,0,0,0,,Қарғыс атсын! Гах!
Dialogue: 0,0:04:20.34,0:04:21.63,Default,,0,0,0,,Нашар! Ұстаңыз!
Dialogue: 0,0:04:21.71,0:04:23.59,Default,,0,0,0,,Хаха...
Dialogue: 0,0:04:23.68,0:04:25.72,Default,,0,0,0,,Аха~ха~!
Dialogue: 0,0:04:25.80,0:04:27.80,Default,,0,0,0,,Жақсы! (Юкимицу) Мен төгілген допты ұстадым!
Dialogue: 0,0:04:28.47,0:04:30.01,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:30.10,0:04:31.10,Default,,0,0,0,,Гах
Dialogue: 0,0:04:31.18,0:04:32.60,Default,,0,0,0,,
Dialogue: 0,0:04:32.68,0:04:34.85,Default,,0,0,0,,Deimon Devil Bats Қауіпсіздігі!
Dialogue: 0,0:04:34.94,0:04:37.69,Default,,0,0,0,,Мені таң қалдырғаны Такидің денесі болды
Dialogue: 0,0:04:37.77,0:04:40.32,Default,,0,0,0,,Деймон өз қақпасының сызығын кесіп өтті!
Dialogue: 0,0:04:40.40,0:04:42.15,Default,,0,0,0,,Бұл жағдайда қауіпсіздік ретінде
Dialogue: 0,0:04:42.24,0:04:44.28,Default,,0,0,0,,2 ұпай Синрюджи храмына барады
Dialogue: 0,0:04:45.57,0:04:48.32,Default,,0,0,0,,Елестер мен дауылдар...
Dialogue: 0,0:04:50.24,0:04:52.50,Default,,0,0,0,,Екеуін де бұзуға болады...
Dialogue: 0,0:04:53.33,0:04:55.67,Default,,0,0,0,,Дегенмен, Агоның қазіргі ойыны
Dialogue: 0,0:04:55.75,0:04:57.33,Default,,0,0,0,,Түсіндіре аласыз ба, Рико-чан?
Dialogue: 0,0:04:57.42,0:04:58.42,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:04:58.50,0:05:00.71,Default,,0,0,0,,Көзден миға Мидан бұлшықетке
Dialogue: 0,0:05:00.80,0:05:04.17,Default,,0,0,0,,Импульс...м, бұл электрлік сигнал.
Dialogue: 0,0:05:04.26,0:05:07.97,Default,,0,0,0,,Бұл ақпаратты көруден бастап қозғалуға дейін жеткізуге кететін уақыт
Dialogue: 0,0:05:08.05,0:05:11.18,Default,,0,0,0,,Агонның реакция уақыты 0,11 секунд
Dialogue: 0,0:05:11.26,0:05:14.85,Default,,0,0,0,,0,10 секунд немесе одан аз уақыт ғылыми тұрғыдан мүмкін емес деп саналады.
Dialogue: 0,0:05:14.93,0:05:18.02,Default,,0,0,0,,Мах қозғалысы, оны реакция жылдамдығының шегі деп атауға болады
Dialogue: 0,0:05:18.86,0:05:19.81,Default,,0,0,0,,Енді бұлай емес⸺
Dialogue: 0,0:05:19.90,0:05:22.65,Default,,0,0,0,,Бұл дүние жігермен ештеңе істей алмайтын дүние емес.
Dialogue: 0,0:05:22.73,0:05:26.99,Default,,0,0,0,,Оны тек Алланың сүйген сыйы деп сипаттауға болады!
Dialogue: 0,0:05:27.07,0:05:29.99,Default,,0,0,0,,Оның үстіне балшық қақпасы мәре сызығына жақын.
Dialogue: 0,0:05:30.07,0:05:32.58,Default,,0,0,0,,Допты кері тебу керек!
Dialogue: 0,0:05:32.66,0:05:35.04,Default,,0,0,0,,Бұл шарасыз жағдай!
Dialogue: 0,0:05:35.71,0:05:38.50,Default,,0,0,0,,Оның оңай аяқталуына жол берме!
Dialogue: 0,0:05:39.50,0:05:41.50,Default,,0,0,0,,Бұл тебушінің жұмысы.
Dialogue: 0,0:05:41.59,0:05:44.46,Default,,0,0,0,,Түсінікті. Шынында да, мен осы жұқа тақтайға қатты қызығамын, бірақ
Dialogue: 0,0:05:50.93,0:05:52.56,Default,,0,0,0,,Жын өте үлкен!
Dialogue: 0,0:05:53.18,0:05:56.52,Default,,0,0,0,,Қақпа алдындағы шарасыз жағдайды бір соққымен кері қайтару!
Dialogue: 0,0:05:56.60,0:05:58.48,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:05:59.02,0:06:01.02,Default,,0,0,0,,Қарсы шабуыл белгілері!
Dialogue: 0,0:06:01.11,0:06:04.98,Default,,0,0,0,,Шинрюджиге қарсы матч алдында Басында бәрі ойланады
Dialogue: 0,0:06:05.07,0:06:07.45,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:06:08.28,0:06:09.45,Default,,0,0,0,,Гуах
Dialogue: 0,0:06:09.53,0:06:10.37,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:10.45,0:06:12.91,Default,,0,0,0,,Пуг... қандай күш!
Dialogue: 0,0:06:12.99,0:06:15.24,Default,,0,0,0,,«Синрюджи қаншалықты күшті болса да»
Dialogue: 0,0:06:15.33,0:06:17.87,Default,,0,0,0,,«Мүмкін біз бәсекелесе аламыз».
Dialogue: 0,0:06:17.96,0:06:18.87,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:06:18.96,0:06:22.29,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:22.38,0:06:23.50,Default,,0,0,0,,Курита! Ахх
Dialogue: 0,0:06:23.59,0:06:24.88,Default,,0,0,0,,Уф
Dialogue: 0,0:06:25.55,0:06:27.34,Default,,0,0,0,,Ұйқы, семіз.
Dialogue: 0,0:06:27.42,0:06:28.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:29.05,0:06:32.30,Default,,0,0,0,,О, Агон-кун, бұл үлкен қайтарым!
Dialogue: 0,0:06:32.39,0:06:36.22,Default,,0,0,0,,Деймондағы қақпа сызығына небәрі 40 ярд қалды!
Dialogue: 0,0:06:36.31,0:06:39.23,Default,,0,0,0,,Бұл лотерея билетін сатып алғандай...
Dialogue: 0,0:06:39.31,0:06:40.77,Default,,0,0,0,,Гррррр
Dialogue: 0,0:06:40.85,0:06:43.36,Default,,0,0,0,,«Мен бүгін ғана бара аламын»...
Dialogue: 0,0:06:44.07,0:06:48.78,Default,,0,0,0,,Бірақ ойын бастала салысымен мен қателескенімді түсінемін.
Dialogue: 0,0:06:49.61,0:06:50.86,Default,,0,0,0,,
Dialogue: 0,0:06:50.95,0:06:52.20,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:06:52.28,0:06:54.78,Default,,0,0,0,,Шинрюджи 22 ұпаймен алда!
Dialogue: 0,0:06:54.87,0:06:57.41,Default,,0,0,0,,Аспан қатал болса, бұл жердегі шайқас.
Dialogue: 0,0:06:57.50,0:07:00.37,Default,,0,0,0,,Ұлы терең шайқаста қолданылған қалақ сүйек
Dialogue: 0,0:07:00.46,0:07:02.17,Default,,0,0,0,,Мен Чибизару комбинациясымен барамын.
Dialogue: 0,0:07:02.25,0:07:03.21,Default,,0,0,0,,Иә! иә!
Dialogue: 0,0:07:05.75,0:07:07.71,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:07:07.80,0:07:09.67,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:07:15.68,0:07:17.18,Default,,0,0,0,,Хи хи
Dialogue: 0,0:07:18.02,0:07:19.35,Default,,0,0,0,,Ha
Dialogue: 0,0:07:20.27,0:07:22.81,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,0:07:22.90,0:07:24.06,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:07:24.15,0:07:28.78,Default,,0,0,0,,Қаншалықты жылдам фитинг жасасаңыз да, кейін әрекет етіп, ұсталып қаласыз.
Dialogue: 0,0:07:28.86,0:07:32.78,Default,,0,0,0,,Есеп алшақтығы баяу кеңейіп бара жатқанын көріп, мен ештеңе істей алмадым ...
Dialogue: 0,0:07:33.66,0:07:35.74,Default,,0,0,0,,Даун!
Dialogue: 0,0:07:36.53,0:07:38.20,Default,,0,0,0,,Шындықты білу
Dialogue: 0,0:07:38.83,0:07:41.41,Default,,0,0,0,,Ең күшті әрқашан күшті
Dialogue: 0,0:07:41.50,0:07:44.88,Default,,0,0,0,,Сіздің қабілетіңізде қате жоқ.
Dialogue: 0,0:07:44.96,0:07:46.63,Default,,0,0,0,,
Dialogue: 0,0:07:46.71,0:07:49.34,Default,,0,0,0,,32-0 Бірінші тайм аяқталды!
Dialogue: 0,0:07:50.01,0:07:51.38,Default,,0,0,0,,Шынымен де жын!
Dialogue: 0,0:07:51.47,0:07:54.80,Default,,0,0,0,,Бұл Кантоның қатарынан 9-шы жеңісі, Шинрюджи Нага!
Dialogue: 0,0:07:54.89,0:07:57.05,Default,,0,0,0,,Хехе, мен айттым ғой.
Dialogue: 0,0:07:57.14,0:08:00.31,Default,,0,0,0,,Маған бірінші таймда ғана 30 ұпай беріңіз.
Dialogue: 0,0:08:00.39,0:08:04.77,Default,,0,0,0,,О? А-а, түсіндім, сіз бірдеңе дедіңіз, а?
Dialogue: 0,0:08:04.85,0:08:06.48,Default,,0,0,0,,Рождестволық ыдыс?
Dialogue: 0,0:08:06.56,0:08:09.73,Default,,0,0,0,,Ха ха ха Мен төрт жыл бойы қоқысты армандадым.
Dialogue: 0,0:08:09.82,0:08:12.70,Default,,0,0,0,,Құттықтаймыз, ойын аяқталды.
Dialogue: 0,0:08:12.78,0:08:13.86,Default,,0,0,0,,Уф
Dialogue: 0,0:08:16.07,0:08:18.58,Default,,0,0,0,,Не болды? Сенна
Dialogue: 0,0:08:18.66,0:08:20.45,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:08:20.70,0:08:25.12,Default,,0,0,0,,Не? Бұл... мен бірінші рет осылай сезініп тұрғандай...
Dialogue: 0,0:08:25.67,0:08:29.05,Default,,0,0,0,,Мені қоқыс деп атайсыз ба, чиби десеңіз де бәрібір.
Dialogue: 0,0:08:29.13,0:08:30.09,Default,,0,0,0,,Бірақ⸺
Dialogue: 0,0:08:31.13,0:08:36.80,Default,,0,0,0,,Хирума-сан, Курита-сан және Мусаши-санның Рождестволық ыдыс туралы арманы
Dialogue: 0,0:08:37.51,0:08:40.26,Default,,0,0,0,,Мені мазақ етуіңізге жол бермеймін!
Dialogue: 0,0:08:49.52,0:08:52.19,Default,,0,0,0,,Жарайды, Сенна, біз екінші таймда жағдайды өзгертеміз!
Dialogue: 0,0:08:52.28,0:08:53.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:53.19,0:08:54.53,Default,,0,0,0,,Тыңдап тұрсың ба? Темера
Dialogue: 0,0:08:54.61,0:08:55.49,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:56.66,0:08:59.45,Default,,0,0,0,,Жарақат алмай күресу
Dialogue: 0,0:08:59.53,0:09:02.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:03.04,0:09:06.87,Default,,0,0,0,,Бұл матчта жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:09:06.96,0:09:10.84,Default,,0,0,0,,Иә!? Не... Мистер Хилл Демон
Dialogue: 0,0:09:10.92,0:09:13.88,Default,,0,0,0,,Агонья Иккюя Шинрюджи храмына қарсы
Dialogue: 0,0:09:13.97,0:09:17.84,Default,,0,0,0,,Бірінші таймнан кейін 32 ұпай айырмашылығын жою мүмкін емес.
Dialogue: 0,0:09:17.93,0:09:20.60,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:20.68,0:09:22.81,Default,,0,0,0,,Біз не істеуіміз керек? Рождестволық ыдыс!
Dialogue: 0,0:09:22.89,0:09:24.93,Default,,0,0,0,,Біз бәріміз міндетті түрде барамыз...
Dialogue: 0,0:09:25.02,0:09:26.89,Default,,0,0,0,,Маймыл (Монта) А...
Dialogue: 0,0:09:27.40,0:09:30.48,Default,,0,0,0,,Соншалықты ұятсыз және жауапсыз болма.
Dialogue: 0,0:09:30.57,0:09:32.48,Default,,0,0,0,,О, бірақ...
Dialogue: 0,0:09:32.57,0:09:34.40,Default,,0,0,0,,Тәжірибе мен күш-жігермен
Dialogue: 0,0:09:34.49,0:09:37.32,Default,,0,0,0,,Бұл мен айналысқым келген адам емес еді, бар болғаны.
Dialogue: 0,0:09:37.41,0:09:38.53,Default,,0,0,0,,Сүлік жын...
Dialogue: 0,0:09:42.12,0:09:44.33,Default,,0,0,0,,Темерада келесі жыл бар
Dialogue: 0,0:09:46.79,0:09:49.67,Default,,0,0,0,,Менің жүрегім ойлағаннан да тез соқты.
Dialogue: 0,0:09:49.75,0:09:51.04,Default,,0,0,0,,Ештеңе⸺
Dialogue: 0,0:09:51.13,0:09:55.21,Default,,0,0,0,,Екінші тайм басталар алдында командирдің не айтқаны маған бәрібір...
Dialogue: 0,0:09:55.30,0:09:58.51,Default,,0,0,0,,Бұл не сұмдық?
Dialogue: 0,0:09:58.59,0:10:00.68,Default,,0,0,0,,Тағы бір ақымақ қулық?
Dialogue: 0,0:10:01.60,0:10:03.93,Default,,0,0,0,,Айналаңыздағы кішкентай шабақтардың сол көрінісі
Dialogue: 0,0:10:04.02,0:10:07.39,Default,,0,0,0,,Иә, бұл әрекет болуы мүмкін емес.
Dialogue: 0,0:10:08.27,0:10:11.94,Default,,0,0,0,,Үшеуміздің арманымыз осы жерде аяқталады.
Dialogue: 0,0:10:12.57,0:10:16.36,Default,,0,0,0,,Келесі жылы, жеңіске үмітсіз ойында.
Dialogue: 0,0:10:16.44,0:10:20.11,Default,,0,0,0,,Жарақат тудыруы мүмкін жарқыраған контактілі ойындарға араласпаңыз.
Dialogue: 0,0:10:21.16,0:10:22.70,Default,,0,0,0,,Төбе жын...
Dialogue: 0,0:10:22.78,0:10:26.00,Default,,0,0,0,,Деймонның ұту көрсеткіші
Dialogue: 0,0:10:26.08,0:10:30.04,Default,,0,0,0,,Бұл нөлдік үтірлердің бірнеше пайызы, солай емес пе?
Dialogue: 0,0:10:30.12,0:10:31.58,Default,,0,0,0,,На
Dialogue: 0,0:10:31.67,0:10:34.55,Default,,0,0,0,,Не... не болды? аға
Dialogue: 0,0:10:34.63,0:10:36.59,Default,,0,0,0,,Сәлем, мамо-ни
Dialogue: 0,0:10:38.38,0:10:41.84,Default,,0,0,0,,Бұл Деймондағы стартпен басталады!
Dialogue: 0,0:10:42.39,0:10:43.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:43.93,0:10:48.35,Default,,0,0,0,,Егер 0% болмаса, бас тартуға әлі ерте.
Dialogue: 0,0:10:48.60,0:10:51.98,Default,,0,0,0,,Әлгі сүлгі шайтан бұлай айтпауы керек еді...
Dialogue: 0,0:10:52.06,0:10:53.02,Default,,0,0,0,,Ах
Dialogue: 0,0:10:53.81,0:10:56.48,Default,,0,0,0,,Жеңіске жетудің шамалы мүмкіндігі бар.
Dialogue: 0,0:10:56.57,0:10:59.20,Default,,0,0,0,,Хилл мырзаның шындап бас тартуы мүмкін емес!
Dialogue: 0,0:10:59.28,0:11:00.49,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:00.57,0:11:04.12,Default,,0,0,0,,Біз бәріміз бұл Рождестволық ыдыс болады деп ант еткенбіз!
Dialogue: 0,0:11:04.20,0:11:05.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:05.12,0:11:07.12,Default,,0,0,0,,«Жарақат әкелетіндей ойнама»?
Dialogue: 0,0:11:07.20,0:11:09.37,Default,,0,0,0,,Ей, сен мейірімді галасың.
Dialogue: 0,0:11:09.46,0:11:12.08,Default,,0,0,0,,Сіздің айтып отырғаныңыз өте біртүрлі естіледі, солай емес пе?
Dialogue: 0,0:11:12.17,0:11:14.04,Default,,0,0,0,,Өтірік
Dialogue: 0,0:11:14.13,0:11:17.05,Default,,0,0,0,,Сіз жарақатқа әкелетіндей ойнағыңыз келе ме?
Dialogue: 0,0:11:17.13,0:11:20.01,Default,,0,0,0,,Аха~ха~ Сіз жеңесіз, солай емес пе?
Dialogue: 0,0:11:20.09,0:11:21.72,Default,,0,0,0,,Мамо-ни...
Dialogue: 0,0:11:22.09,0:11:22.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:23.80,0:11:27.43,Default,,0,0,0,,Шынымен... Мен оны шынымен байқамаймын.
Dialogue: 0,0:11:28.22,0:11:31.14,Default,,0,0,0,,Бәріңіз бір қадам артқа барасыз ба?
Dialogue: 0,0:11:32.14,0:11:35.15,Default,,0,0,0,,Мұсашидің зор соққысының әсерінен бе?
Dialogue: 0,0:11:35.23,0:11:36.36,Default,,0,0,0,,Ах
Dialogue: 0,0:11:44.03,0:11:46.03,Default,,0,0,0,,Енді сол Агон төменгі жағында
Dialogue: 0,0:11:46.12,0:11:49.41,Default,,0,0,0,,Біздің допты ұстап алу мүмкіндігіміз бар.
Dialogue: 0,0:11:49.50,0:11:51.04,Default,,0,0,0,,Егер сіз мұны істегіңіз келсе, қазір уақыт
Dialogue: 0,0:11:51.12,0:11:55.54,Default,,0,0,0,,Бірақ Шинрюджи ғибадатханасының макетін қарап, стратегияны қайта бастауды шештім.
Dialogue: 0,0:11:55.63,0:11:57.25,Default,,0,0,0,,Сізге міндетті түрде ескерту беріледі.
Dialogue: 0,0:11:58.13,0:11:59.80,Default,,0,0,0,,Менің бәс тігуден басқа амалым жоқ
Dialogue: 0,0:12:01.51,0:12:04.01,Default,,0,0,0,,Өтінемін... барлығыңыз
Dialogue: 0,0:12:05.14,0:12:08.01,Default,,0,0,0,,Түсіндім... Түсіндім!
Dialogue: 0,0:12:08.10,0:12:09.27,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:11.77,0:12:14.44,Default,,0,0,0,,Бәріміз шабуыл жасамайынша, біз оны ұстай алмаймыз.
Dialogue: 0,0:12:14.52,0:12:18.90,Default,,0,0,0,,Маған стратегияның өзгергенін айтпаңыз, есі дұрыс па! Сол қарғыс атқан шайтан!
Dialogue: 0,0:12:19.48,0:12:20.61,Default,,0,0,0,,Ешкім⸺
Dialogue: 0,0:12:20.69,0:12:23.20,Default,,0,0,0,,Мен Рождестволық ыдыстан бас тартпаймын.
Dialogue: 0,0:12:23.28,0:12:25.16,Default,,0,0,0,,Сенуден басқа амалым жоқ!
Dialogue: 0,0:12:27.20,0:12:29.45,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:12:30.08,0:12:32.33,Default,,0,0,0,,Барлығы тебуге жиналды!
Dialogue: 0,0:12:32.41,0:12:34.33,Default,,0,0,0,,Сырттан соққы!?
Dialogue: 0,0:12:34.42,0:12:36.54,Default,,0,0,0,,Допты ұстаңыз! Тұр!
Dialogue: 0,0:12:36.63,0:12:40.17,Default,,0,0,0,,Ұстап алайық!
Dialogue: 0,0:12:40.25,0:12:42.09,Default,,0,0,0,,Уау...
Dialogue: 0,0:12:43.84,0:12:47.09,Default,,0,0,0,,Иә! Ямабуши-сан, жын керемет!
Dialogue: 0,0:12:47.18,0:12:48.30,Default,,0,0,0,,Менің атым Ая Цуидзи
Dialogue: 0,0:12:48.39,0:12:49.26,Default,,0,0,0,,Ах
Dialogue: 0,0:12:49.35,0:12:51.27,Default,,0,0,0,,Ммм... Ммм...
Dialogue: 0,0:12:52.73,0:12:53.98,Default,,0,0,0,,Фуго!
Dialogue: 0,0:12:54.06,0:12:55.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:55.73,0:12:57.10,Default,,0,0,0,,Комусуби-кун!
Dialogue: 0,0:12:57.19,0:12:58.94,Default,,0,0,0,,Сырттан сәтті соққы!
Dialogue: 0,0:12:59.02,0:13:01.73,Default,,0,0,0,,Деймон шабуыл жасау құқығын басып алыңыз!
Dialogue: 0,0:13:01.82,0:13:03.94,Default,,0,0,0,,Мен... сене алар емеспін.
Dialogue: 0,0:13:04.03,0:13:07.41,Default,,0,0,0,,Хи хи хи... Таңдануға әлі ерте.
Dialogue: 0,0:13:08.37,0:13:11.37,Default,,0,0,0,,Балшық қақпасында арнайы қозыр қалды.
Dialogue: 0,0:13:12.50,0:13:14.91,Default,,0,0,0,,Үзіліс уақытында қызу уақыты келді деп ойлаймын!
Dialogue: 0,0:13:15.00,0:13:15.83,Default,,0,0,0,,Kuso Deco
Dialogue: 0,0:13:18.96,0:13:19.79,Default,,0,0,0,,Уф
Dialogue: 0,0:13:20.71,0:13:22.25,Default,,0,0,0,,Сіздің кезегіңіз
Dialogue: 0,0:13:23.17,0:13:25.05,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:13:26.34,0:13:28.93,Default,,0,0,0,,Ри... Рико-чан, сен білесің бе? бұл ойыншы
Dialogue: 0,0:13:29.01,0:13:30.85,Default,,0,0,0,,Жарайды, қолдағы құжаттарда да... ха.
Dialogue: 0,0:13:30.93,0:13:32.01,Default,,0,0,0,,Уау
Dialogue: 0,0:13:32.10,0:13:35.23,Default,,0,0,0,,Дәлірек айтсам, ол ешқашан матчқа бармаған шығар.
Dialogue: 0,0:13:35.31,0:13:37.27,Default,,0,0,0,,Шындық қатыгез
Dialogue: 0,0:13:37.35,0:13:40.06,Default,,0,0,0,,17 жыл партаға жабысқан саған
Dialogue: 0,0:13:40.15,0:13:42.69,Default,,0,0,0,,Толық қатысуға менің шыдамым жетпейді.
Dialogue: 0,0:13:42.78,0:13:45.44,Default,,0,0,0,,Бірақ тек шабуыл...
Dialogue: 0,0:13:45.53,0:13:49.66,Default,,0,0,0,,Егер сіз күшіңізді екінші таймға ғана шоғырландырсаңыз, Юкимицу, сіз...
Dialogue: 0,0:13:49.74,0:13:52.87,Default,,0,0,0,,Сіз де басқалар сияқты қатты жүгіре алуыңыз керек.
Dialogue: 0,0:13:52.95,0:13:56.58,Default,,0,0,0,,Сіз соншалықты көп жаттығулардан өттіңіз.
Dialogue: 0,0:13:57.58,0:14:00.88,Default,,0,0,0,,Мен мұны сырттан қарау ғана болды.
Dialogue: 0,0:14:00.96,0:14:02.29,Default,,0,0,0,,Шеттен тыс
Dialogue: 0,0:14:03.30,0:14:06.92,Default,,0,0,0,,Жақын және шексіз алыс қабырға
Dialogue: 0,0:14:08.51,0:14:10.43,Default,,0,0,0,,Енді, ақырында...
Dialogue: 0,0:14:10.51,0:14:13.72,Default,,0,0,0,,Ақырында, бұл жол ...
Dialogue: 0,0:14:18.81,0:14:19.65,Default,,0,0,0,,Ах
Dialogue: 0,0:14:22.98,0:14:25.78,Default,,0,0,0,,Бұл... бұл өріс
Dialogue: 0,0:14:26.19,0:14:28.32,Default,,0,0,0,,Орындықтан мүлде басқаша
Dialogue: 0,0:14:29.74,0:14:30.82,Default,,0,0,0,,Уф
Dialogue: 0,0:14:30.91,0:14:33.53,Default,,0,0,0,,О? Кенет мүк пайда болды
Dialogue: 0,0:14:33.62,0:14:34.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:34.91,0:14:36.41,Default,,0,0,0,,Қар-сан!
Dialogue: 0,0:14:36.50,0:14:37.50,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:38.08,0:14:40.46,Default,,0,0,0,,Сена-кун Монта-кун
Dialogue: 0,0:14:41.25,0:14:45.21,Default,,0,0,0,,Деймон Ібілістердің бәрі жиналған күнге дейін
Dialogue: 0,0:14:46.01,0:14:48.01,Default,,0,0,0,,Біз жеңілмейміз!
Dialogue: 0,0:14:50.59,0:14:53.72,Default,,0,0,0,,Иә, әркімнің сезіміне жауап беру үшін.
Dialogue: 0,0:14:53.80,0:14:55.60,Default,,0,0,0,,Мен мұны осында істеуім керек!
Dialogue: 0,0:14:57.64,0:14:58.56,Default,,0,0,0,,Ах
Dialogue: 0,0:14:59.31,0:15:02.52,Default,,0,0,0,,Жарайды, Сена-кун, Монта-кун.
Dialogue: 0,0:15:02.61,0:15:05.82,Default,,0,0,0,,Юки-сан, бұл Деймон Ібіліс Жарғанақтар...
Dialogue: 0,0:15:05.90,0:15:08.53,Default,,0,0,0,,Ең жақсы мүшелер осында.
Dialogue: 0,0:15:09.19,0:15:10.15,Default,,0,0,0,,Иә
Dialogue: 0,0:15:10.78,0:15:11.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:11.86,0:15:15.95,Default,,0,0,0,,Сол бұлшықеттерді қалай құрастыруға болады... Олар әуесқойларды пайдалана ма?
Dialogue: 0,0:15:16.04,0:15:17.87,Default,,0,0,0,,Қар жарығына қараңыз
Dialogue: 0,0:15:17.95,0:15:21.62,Default,,0,0,0,,Сіз жарты жыл бойы орындықта әр ойынды қарап отырдыңыз. Сіздің қаруыңыз
Dialogue: 0,0:15:21.71,0:15:22.92,Default,,0,0,0,,Көру
Dialogue: 0,0:15:23.00,0:15:24.88,Default,,0,0,0,,Орнату! қалпақ!
Dialogue: 0,0:15:27.42,0:15:31.30,Default,,0,0,0,,Кекекеке Осы сәтті жарты жыл күттім.
Dialogue: 0,0:15:32.13,0:15:35.14,Default,,0,0,0,,Шинрюджи храмын қорғау командасының барлық мүшелерінің қозғалысы...
Dialogue: 0,0:15:35.22,0:15:38.06,Default,,0,0,0,,Гений Аго-кун мен Иккю-кун
Dialogue: 0,0:15:38.14,0:15:40.68,Default,,0,0,0,,Қазір қайдасың және қайда бара жатырсың?
Dialogue: 0,0:15:40.77,0:15:42.19,Default,,0,0,0,,Kuso Deco
Dialogue: 0,0:15:42.27,0:15:46.65,Default,,0,0,0,,Үстелге жабыстырып өткізген 17 жыл зая кеткен жоқ.
Dialogue: 0,0:15:47.36,0:15:50.36,Default,,0,0,0,,Міне! Сүлік жын болсаң, міндетті түрде сол жерге лақтырасың.
Dialogue: 0,0:15:50.44,0:15:52.82,Default,,0,0,0,,Егер солай жасасаңыз, сіз мұны байқайсыз.
Dialogue: 0,0:15:52.91,0:15:55.03,Default,,0,0,0,,Алдымен жол бағытын шешпеңіз
Dialogue: 0,0:15:55.12,0:15:59.33,Default,,0,0,0,,Жаудың қимылдарына қарап, лезде үкім шығаруды сүлгі жындарымен синхрондаңыз.
Dialogue: 0,0:15:59.41,0:16:03.33,Default,,0,0,0,,Мені алда! Генийлер!
Dialogue: 0,0:16:03.42,0:16:07.25,Default,,0,0,0,,Гуманитарлық ғылымдар қабылдағыштың ең жақсы қару нұсқасы!
Dialogue: 0,0:16:07.84,0:16:10.42,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:16:11.51,0:16:14.47,Default,,0,0,0,,Ол бос! Өтінемін, байқамаңыз.
Dialogue: 0,0:16:14.55,0:16:16.18,Default,,0,0,0,,Агон-кун Иккю-кун
Dialogue: 0,0:16:18.93,0:16:21.85,Default,,0,0,0,,Хэхе! Супер реакция Агон!
Dialogue: 0,0:16:21.93,0:16:23.31,Default,,0,0,0,,Иккю де келе жатыр!
Dialogue: 0,0:16:23.39,0:16:24.60,Default,,0,0,0,,Бұл алғаш рет.
Dialogue: 0,0:16:24.69,0:16:27.40,Default,,0,0,0,,Бір сәтке жақсы түс көрдіңіз бе? Касдеко
Dialogue: 0,0:16:27.48,0:16:28.32,Default,,0,0,0,,Уф
Dialogue: 0,0:16:28.40,0:16:30.28,Default,,0,0,0,,А, олар қуып жетті!
Dialogue: 0,0:16:30.36,0:16:31.99,Default,,0,0,0,,Юкки! Бұл қауіпті!
Dialogue: 0,0:16:32.07,0:16:33.78,Default,,0,0,0,,Жын жанып тұр!
Dialogue: 0,0:16:33.86,0:16:36.53,Default,,0,0,0,,Агон мырза, мұны кім ұстайтынын көру үшін бұл шайқас.
Dialogue: 0,0:16:36.62,0:16:38.20,Default,,0,0,0,,Егер бұл әуе шайқасы болса, сіз жеңіле алмайсыз!
Dialogue: 0,0:16:38.91,0:16:42.41,Default,,0,0,0,,Екеуің менімен, әуесқоймен жарыспайсыңдар.
Dialogue: 0,0:16:42.50,0:16:46.17,Default,,0,0,0,,Олар үшін менің күш-жігерім жәндіктердің күресіндей...
Dialogue: 0,0:16:46.25,0:16:47.92,Default,,0,0,0,,Жүр! Қар!
Dialogue: 0,0:16:48.00,0:16:49.63,Default,,0,0,0,,Берілмеңіз!
Dialogue: 0,0:16:49.71,0:16:51.38,Default,,0,0,0,,Берілмеңіз!
Dialogue: 0,0:16:51.46,0:16:52.84,Default,,0,0,0,,Уф
Dialogue: 0,0:16:53.59,0:16:55.55,Default,,0,0,0,,Менің талантым жоқ
Dialogue: 0,0:16:55.63,0:16:59.56,Default,,0,0,0,,Осылай айтсам, мен соңғы 17 жылда ештеңе істеген жоқпын.
Dialogue: 0,0:17:00.14,0:17:02.93,Default,,0,0,0,,Мен ештеңе істей алмадым, өйткені мен ештеңе істемедім.
Dialogue: 0,0:17:03.48,0:17:05.69,Default,,0,0,0,,Бірақ биыл ғана⸺
Dialogue: 0,0:17:07.44,0:17:08.44,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:09.98,0:17:12.36,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:17:12.44,0:17:13.74,Default,,0,0,0,,Ол ұшты!
Dialogue: 0,0:17:13.82,0:17:16.41,Default,,0,0,0,,Әлі ерте, бірақ ол сізге жетпейді.
Dialogue: 0,0:17:18.99,0:17:20.33,Default,,0,0,0,,Tsk! Ах
Dialogue: 0,0:17:20.41,0:17:22.24,Default,,0,0,0,,Әлі жоқ! Қарғыс атқыр деко!
Dialogue: 0,0:17:23.37,0:17:24.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:24.29,0:17:25.50,Default,,0,0,0,,Міндетті түрде ұстаңыз!
Dialogue: 0,0:17:25.58,0:17:27.42,Default,,0,0,0,,Мен сені осында ұстауым керек...
Dialogue: 0,0:17:27.50,0:17:30.42,Default,,0,0,0,,ДжоДжо қарсы Вамуу—
Dialogue: 0,0:17:30.50,0:17:31.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:33.46,0:17:34.34,Default,,0,0,0,,Ах
Dialogue: 0,0:17:34.42,0:17:35.30,Default,,0,0,0,,Ах
Dialogue: 0,0:17:42.31,0:17:43.85,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,0:17:43.93,0:17:45.39,Default,,0,0,0,,
Dialogue: 0,0:17:45.48,0:17:47.35,Default,,0,0,0,,Даун!
Dialogue: 0,0:17:47.44,0:17:52.23,Default,,0,0,0,,Деймон Ібіліс Жарғанаттар Бұл матч ақырында... ақырында...
Dialogue: 0,0:17:52.32,0:17:55.94,Default,,0,0,0,,Бірінші ұпайды шабуылшы Юкико Манабу алды!
Dialogue: 0,0:17:56.03,0:17:57.78,Default,,0,0,0,,Уау, мен жасадым! (Комусуби) Иә!
Dialogue: 0,0:17:57.86,0:18:01.41,Default,,0,0,0,,Иә! Қар мырза! Хахаха…
Dialogue: 0,0:18:02.74,0:18:04.66,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:04.75,0:18:07.08,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:18:07.16,0:18:08.00,Default,,0,0,0,,Қар-сан
Dialogue: 0,0:18:08.08,0:18:11.00,Default,,0,0,0,,(Юкимицудың жылауы)
Dialogue: 0,0:18:12.17,0:18:13.25,Default,,0,0,0,,Деймон Ібіліс жарғанақтары
Dialogue: 0,0:18:13.34,0:18:15.67,Default,,0,0,0,,Өрістің бір жағына қатты жылжытылды⸺
Dialogue: 0,0:18:15.76,0:18:18.68,Default,,0,0,0,,Ол мінсіз соққыға дайын!
Dialogue: 0,0:18:18.76,0:18:20.84,Default,,0,0,0,,Деймонның жоспары таусылды
Dialogue: 0,0:18:20.93,0:18:23.60,Default,,0,0,0,,Бір жақтан соққыны ұстаныңыз.
Dialogue: 0,0:18:23.68,0:18:26.06,Default,,0,0,0,,Міне, Онихэй осылай болжады...
Dialogue: 0,0:18:26.81,0:18:29.02,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:31.06,0:18:33.07,Default,,0,0,0,,Әй, тепкінің алдында
Dialogue: 0,0:18:33.15,0:18:36.44,Default,,0,0,0,,Деймон бірден қалыпты стартқа оралады.
Dialogue: 0,0:18:36.53,0:18:39.49,Default,,0,0,0,,Сонымен, жын сарбазының болжамы қайтадан бұзылды!
Dialogue: 0,0:18:39.57,0:18:40.41,Default,,0,0,0,,Ммм
Dialogue: 0,0:18:40.49,0:18:42.41,Default,,0,0,0,,Бұл келе жатыр! Бұл келе жатыр! Мусаши...
Dialogue: 0,0:18:43.12,0:18:44.37,Default,,0,0,0,,Уф
Dialogue: 0,0:18:44.45,0:18:46.41,Default,,0,0,0,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,0:18:48.96,0:18:51.08,Default,,0,0,0,,Артқа қайт! Қайтып келу! (Хачиджо) Пугии
Dialogue: 0,0:18:51.17,0:18:52.63,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:18:53.96,0:18:55.59,Default,,0,0,0,,Бұл сүлік трюк!
Dialogue: 0,0:18:55.67,0:18:58.47,Default,,0,0,0,,Күшті жігіт әдеттен тыс қуылып, қалықтап қалады.
Dialogue: 0,0:18:58.55,0:19:01.68,Default,,0,0,0,,Айла арқылы шатастыруға шақыру
Dialogue: 0,0:19:03.93,0:19:05.39,Default,,0,0,0,,Ой, Аго-кун
Dialogue: 0,0:19:05.47,0:19:08.02,Default,,0,0,0,,Доп қону нүктесіне тез жетті!
Dialogue: 0,0:19:08.10,0:19:10.52,Default,,0,0,0,,Сондықтан 11 адам болғанымыз жақсы болар еді.
Dialogue: 0,0:19:10.60,0:19:12.06,Default,,0,0,0,,Бұл күшті!
Dialogue: 0,0:19:12.15,0:19:14.57,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:19:15.32,0:19:17.53,Default,,0,0,0,,Ахх...
Dialogue: 0,0:19:17.61,0:19:20.11,Default,,0,0,0,,Тыныш және жинал! Барлығы бір уақытта әдеттегідей⸺
Dialogue: 0,0:19:20.20,0:19:22.49,Default,,0,0,0,,Орталыққа жақын оралу Үлкен қайтару!
Dialogue: 0,0:19:22.57,0:19:25.58,Default,,0,0,0,,Tsk! Бұл тәтті емес пе?
Dialogue: 0,0:19:26.91,0:19:29.96,Default,,0,0,0,,Мен бірдеңе істеуім керек... әйтеуір.
Dialogue: 0,0:19:31.00,0:19:36.00,Default,,0,0,0,,♪~
Dialogue: 0,0:20:40.90,0:20:45.91,Default,,0,0,0,,~♪
Dialogue: 0,0:20:46.82,0:20:49.62,Default,,0,0,0,,Иә! Деко жарығы!
Dialogue: 0,0:20:49.70,0:20:51.33,Default,,0,0,0,,Ей, Сена, енді сенің кезегің!
Dialogue: 0,0:20:51.41,0:20:53.33,Default,,0,0,0,,Мынау агон жігітін ұрып таста!
Dialogue: 0,0:20:53.41,0:20:55.75,Default,,0,0,0,,Эй, әлгі Агон-сан блиц алды!?
Dialogue: 0,0:20:55.83,0:20:57.79,Default,,0,0,0,,Бірақ мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:20:57.88,0:20:58.84,Default,,0,0,0,,Тек орындаңыз!
Dialogue: 0,0:20:58.92,0:21:01.59,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:01.67,0:21:03.42,Default,,0,0,0,,«Қарапайым таланттың күші»
Dialogue: 0,0:21:03.51,0:21:05.93,Default,,0,0,0,,Я-Ха-!
Dialogue: 0,0:21:07.43,0:21:13.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory