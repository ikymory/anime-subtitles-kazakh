Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.21,0:00:07.67,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:14.68,0:00:16.51,Default,,0,0,0,,(Қара барыстың ақыруы)
Dialogue: 0,0:00:16.64,0:00:18.35,Default,,0,0,0,,(Сеннаның жүрек соғысы)
Dialogue: 0,0:00:18.47,0:00:19.31,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:00:19.51,0:00:22.48,Default,,0,0,0,,(Пантераның жүрек соғысы)
Dialogue: 0,0:00:23.23,0:00:24.31,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:00:24.64,0:00:28.23,Default,,0,0,0,,Әп-сәтте ол көзінің қалқанын жұлып алып, бағанаға шықты.
Dialogue: 0,0:00:28.61,0:00:30.69,Default,,0,0,0,,Бұл 21 саны керемет
Dialogue: 0,0:00:30.82,0:00:32.28,Default,,0,0,0,,Пантера Мен мұны көргенде
Dialogue: 0,0:00:33.24,0:00:34.90,Default,,0,0,0,,Міне осылай болады.
Dialogue: 0,0:00:38.03,0:00:44.04,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:51.44,0:01:57.45,Default,,0,0,0,,~♪
Dialogue: 0,0:02:04.04,0:02:06.54,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:07.21,0:02:09.46,Default,,0,0,0,,Егер сіз менің стратегиямды орындасаңыз, сіз жеңе аласыз.
Dialogue: 0,0:02:09.58,0:02:12.50,Default,,0,0,0,,Бізге қарсы шыққандар бұл салаға керек емес.
Dialogue: 0,0:02:13.29,0:02:15.09,Default,,0,0,0,,Стратегияны елемеу дереу ауыстыруға әкеледі.
Dialogue: 0,0:02:15.21,0:02:16.05,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:02:16.17,0:02:17.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:17.88,0:02:19.80,Default,,0,0,0,,Тек қыздыру жаттығуларын орындаңыз
Dialogue: 0,0:02:19.93,0:02:22.18,Default,,0,0,0,,Мен тіпті форма ала алмаймын. Менің қолымнан келмейтіні
Dialogue: 0,0:02:22.35,0:02:23.93,Default,,0,0,0,,Менің қолымнан келетіні – күту
Dialogue: 0,0:02:24.39,0:02:25.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:28.94,0:02:32.44,Default,,0,0,0,,Мен Айсшилд 21-мен... шайқасқым келеді!
Dialogue: 0,0:02:32.77,0:02:35.57,Default,,0,0,0,,Мен Пантерамен... ұрысқым келеді!
Dialogue: 0,0:02:35.69,0:02:38.03,Default,,0,0,0,,Пантераның осылай жүгіріп келе жатқанын көріп тұрсың ба?
Dialogue: 0,0:02:38.15,0:02:39.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:39.20,0:02:40.45,Default,,0,0,0,,Балаларға арналған тағам.
Dialogue: 0,0:02:40.57,0:02:42.28,Default,,0,0,0,,Хилл Демон мырза осылай деді.
Dialogue: 0,0:02:42.41,0:02:43.95,Default,,0,0,0,,Бірдеңені қаласаң, жең!
Dialogue: 0,0:02:44.08,0:02:45.03,Default,,0,0,0,,Монта
Dialogue: 0,0:02:45.16,0:02:47.66,Default,,0,0,0,,Қапты кесу арқылы жеңіңіз.
Dialogue: 0,0:02:47.79,0:02:49.16,Default,,0,0,0,,Егер сіз ондаған ұпаймен көш бастасаңыз
Dialogue: 0,0:02:49.29,0:02:51.88,Default,,0,0,0,,Олар пантераны жіберуі керек, солай ма?
Dialogue: 0,0:02:52.17,0:02:53.79,Default,,0,0,0,,Бірақ тым кеш!
Dialogue: 0,0:02:54.04,0:02:55.42,Default,,0,0,0,,Деймон үшін үлкен жеңіс!
Dialogue: 0,0:02:55.55,0:02:57.51,Default,,0,0,0,,Біз Жапонияда қала аламыз
Dialogue: 0,0:02:57.63,0:03:00.17,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл оңай, солай емес пе?
Dialogue: 0,0:03:00.55,0:03:02.84,Default,,0,0,0,,Жоқ, бұл қарапайым.
Dialogue: 0,0:03:02.97,0:03:04.85,Default,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:03:04.97,0:03:06.85,Default,,0,0,0,,Ондаған ұпаймен алда?
Dialogue: 0,0:03:07.35,0:03:09.60,Default,,0,0,0,,Қолыңнан келеді ме, жоқ па бәрібір!
Dialogue: 0,0:03:09.73,0:03:12.94,Default,,0,0,0,,Шын айтсаң, өлсем де қосыламын.
Dialogue: 0,0:03:13.06,0:03:14.98,Default,,0,0,0,,А... Монта
Dialogue: 0,0:03:15.73,0:03:16.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:17.28,0:03:19.36,Default,,0,0,0,,Мен Сусуму-санмен соғысқандағыдай.
Dialogue: 0,0:03:20.11,0:03:21.49,Default,,0,0,0,,Менің аяғым тынышсыз.
Dialogue: 0,0:03:22.20,0:03:24.03,Default,,0,0,0,,Мен Пантерамен жарысқым келеді!
Dialogue: 0,0:03:25.12,0:03:26.53,Default,,0,0,0,,Set hat!
Dialogue: 0,0:03:27.70,0:03:28.54,Default,,0,0,0,,Ha
Dialogue: 0,0:03:30.62,0:03:33.12,Default,,0,0,0,,Максималды ұстаңыз!
Dialogue: 0,0:03:34.63,0:03:35.46,Default,,0,0,0,,Senna!
Dialogue: 0,0:03:36.29,0:03:38.05,Default,,0,0,0,,Пантерамен шайқас!
Dialogue: 0,0:03:38.55,0:03:39.38,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:03:39.51,0:03:40.34,Default,,0,0,0,,Аһ!
Dialogue: 0,0:03:40.80,0:03:42.63,Default,,0,0,0,,Уау! (Юкимицу) Бұл қайтадан Eyeshield.
Dialogue: 0,0:03:43.22,0:03:44.09,Default,,0,0,0,,Оны ұсақтаңыз!
Dialogue: 0,0:03:46.18,0:03:47.76,Default,,0,0,0,,
Dialogue: 0,0:03:48.93,0:03:50.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:50.31,0:03:52.02,Default,,0,0,0,,Мен бірінші болдым!
Dialogue: 0,0:03:52.31,0:03:53.77,Default,,0,0,0,,Set hat!
Dialogue: 0,0:03:54.60,0:03:55.44,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:03:58.19,0:03:59.65,Default,,0,0,0,,Бірінші төмен!
Dialogue: 0,0:04:00.90,0:04:01.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:02.49,0:04:03.82,Default,,0,0,0,,Жүр!
Dialogue: 0,0:04:04.57,0:04:05.57,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:04:07.95,0:04:09.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:09.95,0:04:11.29,Default,,0,0,0,,Бірінші төмен!
Dialogue: 0,0:04:11.66,0:04:14.12,Default,,0,0,0,,Уф уф~
Dialogue: 0,0:04:16.79,0:04:17.67,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:04:24.47,0:04:25.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:25.76,0:04:27.05,Default,,0,0,0,,Ой! О?
Dialogue: 0,0:04:27.76,0:04:29.39,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:04:29.89,0:04:32.48,Default,,0,0,0,,Тау!
Dialogue: 0,0:04:32.60,0:04:33.77,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:34.14,0:04:35.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:35.56,0:04:36.94,Default,,0,0,0,,Керемет тамаша!
Dialogue: 0,0:04:37.06,0:04:38.86,Default,,0,0,0,,Көз қалқаны ояту!
Dialogue: 0,0:04:38.98,0:04:42.11,Default,,0,0,0,,Инопланетяндардың жылдамдығымен біз оны мүлде ұстай алмаймыз!
Dialogue: 0,0:04:42.24,0:04:43.49,Default,,0,0,0,,Бұл екі ұпайлық айырмашылық!
Dialogue: 0,0:04:43.61,0:04:45.20,Default,,0,0,0,,Мен шатасып бара жатырмын!
Dialogue: 0,0:04:47.41,0:04:48.91,Default,,0,0,0,,Хмм... уф
Dialogue: 0,0:04:49.87,0:04:51.29,Default,,0,0,0,,Не... Қарғыс атсын.
Dialogue: 0,0:04:53.62,0:04:56.87,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:04:58.13,0:04:59.25,Default,,0,0,0,,Пантера
Dialogue: 0,0:05:04.72,0:05:07.18,Default,,0,0,0,,Егер мен сонда болсам
Dialogue: 0,0:05:15.14,0:05:15.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:17.48,0:05:18.73,Default,,0,0,0,,Не? о?
Dialogue: 0,0:05:18.86,0:05:19.77,Default,,0,0,0,,Пантера
Dialogue: 0,0:05:21.90,0:05:22.78,Default,,0,0,0,,Директор
Dialogue: 0,0:05:23.90,0:05:24.74,Default,,0,0,0,,Не?
Dialogue: 0,0:05:28.41,0:05:29.24,Default,,0,0,0,,О!
Dialogue: 0,0:05:30.78,0:05:31.70,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:32.29,0:05:34.95,Default,,0,0,0,,Әлгі жігіт... Көз қалқаны 21
Dialogue: 0,0:05:35.08,0:05:36.66,Default,,0,0,0,,Маған оны тоқтатуға рұқсат етіңіз!
Dialogue: 0,0:05:37.42,0:05:38.62,Default,,0,0,0,,Пантера
Dialogue: 0,0:05:39.25,0:05:40.59,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:05:41.50,0:05:44.01,Default,,0,0,0,,Допты жинаушы не дейді?
Dialogue: 0,0:05:44.38,0:05:45.34,Default,,0,0,0,,Жинаңыз!
Dialogue: 0,0:05:50.09,0:05:52.06,Default,,0,0,0,,Қарсылас сізді ұпай жинауға шақырып жатыр.
Dialogue: 0,0:05:52.97,0:05:55.06,Default,,0,0,0,,Олай болса мен де осыны қалаймын.
Dialogue: 0,0:05:55.31,0:05:58.69,Default,,0,0,0,,Менің нұсқауларымды орындасаңыз, міндетті түрде өтесіз.
Dialogue: 0,0:05:58.98,0:06:00.48,Default,,0,0,0,,Жақсы! (Барлығы) Иә!
Dialogue: 0,0:06:00.73,0:06:01.56,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:06:03.73,0:06:05.44,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:06:07.49,0:06:08.61,Default,,0,0,0,,№ 8!
Dialogue: 0,0:06:09.03,0:06:10.91,Default,,0,0,0,,8 саны Раджа!
Dialogue: 0,0:06:11.03,0:06:12.66,Default,,0,0,0,,Қону нүктесін растаңыз!
Dialogue: 0,0:06:12.95,0:06:16.33,Default,,0,0,0,,Үш екі бір нөл!
Dialogue: 0,0:06:16.45,0:06:17.33,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:06:18.21,0:06:19.79,Default,,0,0,0,,Қону нүктесін растаңыз OK (Жарайды)
Dialogue: 0,0:06:22.92,0:06:23.84,Default,,0,0,0,,Ах (Монта) Каа!
Dialogue: 0,0:06:24.05,0:06:25.30,Default,,0,0,0,,Мукки!
Dialogue: 0,0:06:25.42,0:06:26.88,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:06:27.01,0:06:28.17,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:06:28.30,0:06:30.30,Default,,0,0,0,,Шаттл өткелінен төмен түсу!
Dialogue: 0,0:06:32.22,0:06:33.76,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:06:34.93,0:06:36.22,Default,,0,0,0,,
Dialogue: 0,0:06:36.52,0:06:37.85,Default,,0,0,0,,Доп шешілді!
Dialogue: 0,0:06:37.98,0:06:39.98,Default,,0,0,0,,Шетелдіктерді қайтадан итеріп жіберіңіз!
Dialogue: 0,0:06:40.39,0:06:41.48,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:41.90,0:06:44.86,Default,,0,0,0,,Гонсалес аға, сіздің кезегіңіз.
Dialogue: 0,0:06:45.32,0:06:46.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:46.48,0:06:49.15,Default,,0,0,0,,Енді, шетелдіктер, ойыншыларды ауыстыратын кез келді.
Dialogue: 0,0:06:49.82,0:06:52.87,Default,,0,0,0,,Орындалмайтын татуировка жасаған ағалар
Dialogue: 0,0:06:52.99,0:06:56.54,Default,,0,0,0,,Үлкен Гонсалес және оның інісі Гонсалес
Dialogue: 0,0:06:56.66,0:06:57.87,Default,,0,0,0,,Мұның бәрі қазір осында
Dialogue: 0,0:06:58.50,0:06:59.58,Default,,0,0,0,,Не?
Dialogue: 0,0:06:59.79,0:07:01.08,Default,,0,0,0,,Қайтымсыз?
Dialogue: 0,0:07:01.87,0:07:02.79,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:05.09,0:07:06.55,Default,,0,0,0,,Маған канджи татуировкасы ұнайды
Dialogue: 0,0:07:06.67,0:07:10.05,Default,,0,0,0,,«Үлкен пайдалы» Үлкен және пайдалы адам!
Dialogue: 0,0:07:10.17,0:07:11.93,Default,,0,0,0,,«Пайдалы»
Dialogue: 0,0:07:12.22,0:07:14.85,Default,,0,0,0,,Бұл жақсы ма? Ыңғайлы «тасымалдау»
Dialogue: 0,0:07:14.97,0:07:17.52,Default,,0,0,0,,Бұған «үлкен» дегенді қоссақ, жақсы болмай ма?
Dialogue: 0,0:07:17.89,0:07:18.72,Default,,0,0,0,,Үлкен
Dialogue: 0,0:07:18.85,0:07:20.89,Default,,0,0,0,,Жас!
Dialogue: 0,0:07:21.81,0:07:23.35,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:07:23.48,0:07:25.02,Default,,0,0,0,,Бұл нәжіс!
Dialogue: 0,0:07:25.15,0:07:26.52,Default,,0,0,0,,Ябба!
Dialogue: 0,0:07:26.65,0:07:27.82,Default,,0,0,0,,Нәжіс адам!
Dialogue: 0,0:07:27.94,0:07:29.53,Default,,0,0,0,,Салқын~
Dialogue: 0,0:07:29.74,0:07:32.16,Default,,0,0,0,,Шын мәнінде қайтымсыз
Dialogue: 0,0:07:32.36,0:07:33.28,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:07:34.66,0:07:35.87,Default,,0,0,0,,Set hat!
Dialogue: 0,0:07:38.45,0:07:39.91,Default,,0,0,0,,(үш адам ауыр тыныс алуда)
Dialogue: 0,0:07:40.04,0:07:42.50,Default,,0,0,0,,Деймон Бұл тағы бір сыпырып.
Dialogue: 0,0:07:44.54,0:07:45.38,Default,,0,0,0,,Үлкен
Dialogue: 0,0:07:45.50,0:07:47.17,Default,,0,0,0,,Жас!
Dialogue: 0,0:07:47.30,0:07:48.13,Default,,0,0,0,,Ах
Dialogue: 0,0:07:48.38,0:07:49.34,Default,,0,0,0,,Керемет күш!
Dialogue: 0,0:07:51.55,0:07:53.59,Default,,0,0,0,,Үлкен пайдалы!
Dialogue: 0,0:07:55.34,0:07:57.93,Default,,0,0,0,,Eyeshield-kun, сен одан тез құтылдың!
Dialogue: 0,0:07:58.43,0:07:59.85,Default,,0,0,0,,Бұл жылдамдықтың өзгеруі!
Dialogue: 0,0:08:02.94,0:08:03.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:04.02,0:08:04.90,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:08:05.02,0:08:06.61,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:08:06.73,0:08:09.78,Default,,0,0,0,,Кішкентай Гонсалес! Мен Eyeshield-kun жүгіруін тоқтаттым!
Dialogue: 0,0:08:10.32,0:08:12.74,Default,,0,0,0,,Кішкентаймын деп мені кінәлама
Dialogue: 0,0:08:15.70,0:08:17.99,Default,,0,0,0,,Ағам жауды күшпен басады
Dialogue: 0,0:08:18.12,0:08:20.66,Default,,0,0,0,,Ағам жылдамдығымен оның орнын толтырады.
Dialogue: 0,0:08:20.79,0:08:22.46,Default,,0,0,0,,Бұл ағайынды Гонсалес.
Dialogue: 0,0:08:23.50,0:08:25.83,Default,,0,0,0,,Ерекше таланты бар бір ғана адам бар.
Dialogue: 0,0:08:26.08,0:08:28.38,Default,,0,0,0,,Командаңызды жеңіске жетелеме
Dialogue: 0,0:08:28.50,0:08:31.26,Default,,0,0,0,,Жеке адамдар өздеріне жүктелген рөлдерді орындай алуы керек.
Dialogue: 0,0:08:31.38,0:08:33.17,Default,,0,0,0,,Ең маңыздысы
Dialogue: 0,0:08:34.13,0:08:37.68,Default,,0,0,0,,Ойыншы мен айтқандай қозғалады. Бұл бір бөлік болғанша жақсы.
Dialogue: 0,0:08:39.26,0:08:41.89,Default,,0,0,0,,Күтілгендей, шетелдіктер қорқынышты.
Dialogue: 0,0:08:42.60,0:08:44.27,Default,,0,0,0,,Енді ол қалай шығады? балшық қақпасы
Dialogue: 0,0:08:44.39,0:08:46.77,Default,,0,0,0,,О! Сіз ұпай жинамайсыз ба?
Dialogue: 0,0:08:46.90,0:08:48.77,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:08:48.94,0:08:52.03,Default,,0,0,0,,(Сусумуның ауыр тыныс алуы)
Dialogue: 0,0:08:53.07,0:08:54.32,Default,,0,0,0,,Set hat!
Dialogue: 0,0:08:56.07,0:08:57.62,Default,,0,0,0,,Лақтырмас бұрын оны ұсақтап тастаңыз!
Dialogue: 0,0:08:57.95,0:08:58.82,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,0:09:00.45,0:09:01.37,Default,,0,0,0,,
Dialogue: 0,0:09:01.83,0:09:03.08,Default,,0,0,0,,Әй~ Деймон!
Dialogue: 0,0:09:03.20,0:09:05.62,Default,,0,0,0,,Қорғаушы Хирума-кун жеңілді!
Dialogue: 0,0:09:06.04,0:09:06.87,Default,,0,0,0,,Төбе шайтан!
Dialogue: 0,0:09:07.00,0:09:08.33,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:09:08.46,0:09:09.29,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:09:09.42,0:09:12.59,Default,,0,0,0,,Мен қалаған нәрсені жасау оңай емес пе?
Dialogue: 0,0:09:13.51,0:09:14.55,Default,,0,0,0,,Пантера-кун
Dialogue: 0,0:09:20.56,0:09:23.72,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:24.85,0:09:25.94,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:09:26.06,0:09:27.56,Default,,0,0,0,,Тыңдаңдар, бейбақтар.
Dialogue: 0,0:09:27.69,0:09:29.40,Default,,0,0,0,,Соңғы аймақ дәл сол жерде.
Dialogue: 0,0:09:30.06,0:09:30.90,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:09:31.32,0:09:32.36,Default,,0,0,0,,О!
Dialogue: 0,0:09:32.73,0:09:35.32,Default,,0,0,0,,Енді Деймонның шабуылын жалғастырайық!
Dialogue: 0,0:09:35.70,0:09:37.57,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:09:37.86,0:09:39.16,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:09:43.58,0:09:45.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:46.00,0:09:47.96,Default,,0,0,0,,Мен сыпыруға бардым!
Dialogue: 0,0:09:48.29,0:09:49.63,Default,,0,0,0,,Оны жалама!
Dialogue: 0,0:09:56.22,0:09:57.38,Default,,0,0,0,,Қайда? Ах
Dialogue: 0,0:09:57.72,0:09:59.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:59.80,0:10:00.89,Default,,0,0,0,,Не!
Dialogue: 0,0:10:01.68,0:10:04.81,Default,,0,0,0,,Ах~ Хилл жын жалған!
Dialogue: 0,0:10:05.10,0:10:07.81,Default,,0,0,0,,Қарғыс атсын! Ешқашан бұл жолға түспе!
Dialogue: 0,0:10:08.02,0:10:09.15,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:10:09.44,0:10:11.15,Default,,0,0,0,,Максималды ұстаңыз!
Dialogue: 0,0:10:11.27,0:10:12.44,Default,,0,0,0,,Хи хи хи~
Dialogue: 0,0:10:13.98,0:10:16.32,Default,,0,0,0,,Төмен басыңыз!
Dialogue: 0,0:10:16.44,0:10:17.32,Default,,0,0,0,,
Dialogue: 0,0:10:17.61,0:10:20.53,Default,,0,0,0,,Шешілді! Деймонның тиюі!
Dialogue: 0,0:10:21.12,0:10:23.16,Default,,0,0,0,,Жоқ, Деймон, керемет жұмыс.
Dialogue: 0,0:10:23.62,0:10:24.83,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:10:24.95,0:10:26.66,Default,,0,0,0,,Осылай жалғастырайық
Dialogue: 0,0:10:26.79,0:10:28.87,Default,,0,0,0,,Осылай жасасаңыз, тіпті пантера да пайда болады.
Dialogue: 0,0:10:29.46,0:10:30.29,Default,,0,0,0,,Иә
Dialogue: 0,0:10:30.88,0:10:33.29,Default,,0,0,0,,Уф э
Dialogue: 0,0:10:33.46,0:10:36.34,Default,,0,0,0,,Сіз не істеп жатырсыз, 30 саны? Кезекпен айналысатын кез келді!
Dialogue: 0,0:10:37.63,0:10:38.80,Default,,0,0,0,,
Dialogue: 0,0:10:39.18,0:10:42.51,Default,,0,0,0,,Сондай-ақ, "Ұпайлар үшін әрекет" арқылы 2 ұпай алыңыз!
Dialogue: 0,0:10:42.64,0:10:46.18,Default,,0,0,0,,Ақырында біз шетелдіктер арасындағы алшақтықты бір ұпайға жаптық!
Dialogue: 0,0:10:47.35,0:10:48.64,Default,,0,0,0,,Set hat!
Dialogue: 0,0:10:49.27,0:10:50.10,Default,,0,0,0,,№3!
Dialogue: 0,0:10:50.35,0:10:51.19,Default,,0,0,0,,Раджа!
Dialogue: 0,0:10:51.31,0:10:52.77,Default,,0,0,0,,Қону нүктесін растаңыз!
Dialogue: 0,0:10:52.90,0:10:56.53,Default,,0,0,0,,Үш екі бір нөл!
Dialogue: 0,0:10:56.65,0:10:58.49,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:10:58.74,0:11:00.95,Default,,0,0,0,,Керемет! №25 жүгіріңіз!
Dialogue: 0,0:11:01.95,0:11:02.78,Default,,0,0,0,,Уф
Dialogue: 0,0:11:05.12,0:11:05.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:06.12,0:11:07.41,Default,,0,0,0,,Ой! Ах
Dialogue: 0,0:11:09.12,0:11:10.87,Default,,0,0,0,,Ах... Уф
Dialogue: 0,0:11:11.00,0:11:11.92,Default,,0,0,0,,
Dialogue: 0,0:11:12.04,0:11:13.13,Default,,0,0,0,,Балшық добы!
Dialogue: 0,0:11:13.42,0:11:15.67,Default,,0,0,0,,Жарайды! Eyeshield күткендей!
Dialogue: 0,0:11:16.21,0:11:19.09,Default,,0,0,0,,Не деген сұмдық, балалар!
Dialogue: 0,0:11:19.34,0:11:22.59,Default,,0,0,0,,No 25 Кезектесіп отыратын кез келді. Артқа қадам жасаңыз!
Dialogue: 0,0:11:23.30,0:11:25.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:29.39,0:11:31.77,Default,,0,0,0,,Бұл үлкен қателік емес еді.
Dialogue: 0,0:11:32.02,0:11:33.60,Default,,0,0,0,,Қайтадан ауыстырамыз ба?
Dialogue: 0,0:11:33.90,0:11:37.07,Default,,0,0,0,,Хехехе жақсы көріне бастады.
Dialogue: 0,0:11:37.19,0:11:40.65,Default,,0,0,0,,Олар сәтсіздікке ұшырай алмайды, сондықтан олардың көңілі түседі.
Dialogue: 0,0:11:40.78,0:11:44.66,Default,,0,0,0,,Бір ғана қате, сонда сіз ауыстырыласыз.
Dialogue: 0,0:11:45.16,0:11:47.24,Default,,0,0,0,,Оны шайқаймыз!
Dialogue: 0,0:11:47.70,0:11:50.33,Default,,0,0,0,,Сіз шыдамсызданып бара жатырсыз, шетелдіктер.
Dialogue: 0,0:11:50.45,0:11:53.37,Default,,0,0,0,,Шынымен бе? Ол әрқашан бірдей көрінеді
Dialogue: 0,0:11:53.50,0:11:55.79,Default,,0,0,0,,Шетелдіктер өту туралы
Dialogue: 0,0:11:56.25,0:11:59.21,Default,,0,0,0,,Олай болса, жолға назар аудару арқылы балшық қақпасын қорғауға болады.
Dialogue: 0,0:11:59.80,0:12:01.13,Default,,0,0,0,,Екінші жағынан, Деймон
Dialogue: 0,0:12:01.38,0:12:04.97,Default,,0,0,0,,Хилл жынының айлалы стратегиясы және Eyeshield аяқтары
Dialogue: 0,0:12:05.93,0:12:09.18,Default,,0,0,0,,Шетелдіктерде бұл аяқтарды тоқтататын ешкім жоқ.
Dialogue: 0,0:12:09.31,0:12:10.43,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:10.56,0:12:12.14,Default,,0,0,0,,Set hat!
Dialogue: 0,0:12:13.44,0:12:14.44,Default,,0,0,0,,Уау~ (Докан) Уау~
Dialogue: 0,0:12:14.56,0:12:15.52,Default,,0,0,0,,Дея~ (Комусуби) Фуго~
Dialogue: 0,0:12:15.86,0:12:16.98,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:12:19.02,0:12:20.19,Default,,0,0,0,,Оны атамаңыз
Dialogue: 0,0:12:23.45,0:12:24.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:25.03,0:12:26.28,Default,,0,0,0,,Маған тағы да беремін деп жүрсің бе?
Dialogue: 0,0:12:27.78,0:12:29.62,Default,,0,0,0,,Хе хи хи... Иә?
Dialogue: 0,0:12:31.20,0:12:32.12,Default,,0,0,0,,Маймыл
Dialogue: 0,0:12:32.25,0:12:33.96,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:34.54,0:12:36.92,Default,,0,0,0,,Қабылдаушы! 80 санын ұстап тұрыңыз!
Dialogue: 0,0:12:37.13,0:12:38.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:39.04,0:12:41.30,Default,,0,0,0,,Балшық қақпасы жай ғана өту емес.
Dialogue: 0,0:12:41.42,0:12:43.30,Default,,0,0,0,,Егер сіз мені қорғап жатсаңыз...
Dialogue: 0,0:12:44.09,0:12:45.76,Default,,0,0,0,,Көз қалқаны қарама-қарсы бағытта жүреді.
Dialogue: 0,0:12:45.89,0:12:47.34,Default,,0,0,0,,Ха, эй!
Dialogue: 0,0:12:48.26,0:12:49.81,Default,,0,0,0,,Ах! Не!
Dialogue: 0,0:12:51.14,0:12:52.64,Default,,0,0,0,,Жүр! көз қалқаны
Dialogue: 0,0:12:54.31,0:12:55.56,Default,,0,0,0,,Құдай-ай~!
Dialogue: 0,0:12:55.85,0:12:56.69,Default,,0,0,0,,Сен жай ғана... отты қайта тұтаттың, иә?
Dialogue: 0,0:12:57.19,0:12:59.44,Default,,0,0,0,,Қабақтың аяқтарын тоқтатуға болмайды
Dialogue: 0,0:13:00.19,0:13:01.86,Default,,0,0,0,,Уф... Ку~!
Dialogue: 0,0:13:08.99,0:13:10.53,Default,,0,0,0,,Тау!
Dialogue: 0,0:13:10.66,0:13:11.95,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:13:12.08,0:13:13.00,Default,,0,0,0,,
Dialogue: 0,0:13:13.29,0:13:14.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:14.41,0:13:16.17,Default,,0,0,0,,Eyeshield-san керемет!
Dialogue: 0,0:13:16.67,0:13:17.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:22.46,0:13:23.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:25.76,0:13:29.05,Default,,0,0,0,,Ақыры... Деймон ақыры бұрылды!
Dialogue: 0,0:13:29.18,0:13:31.72,Default,,0,0,0,,Мен бұл кездесуде бірінші рет алға шықтым!
Dialogue: 0,0:13:31.85,0:13:32.85,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:32.97,0:13:35.31,Default,,0,0,0,,Балалар, сендер қандай ақымақсыңдар!
Dialogue: 0,0:13:36.06,0:13:36.94,Default,,0,0,0,,Ауыстыру
Dialogue: 0,0:13:37.31,0:13:40.06,Default,,0,0,0,,Менің стратегиямды орындай алмайтын адам маған керек емес!
Dialogue: 0,0:13:40.44,0:13:41.27,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:13:41.40,0:13:42.23,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:13:42.36,0:13:43.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:45.65,0:13:47.66,Default,,0,0,0,,Сіз мұны қанша уақыттан бері істеп жүрсіз? мен...
Dialogue: 0,0:13:47.78,0:13:48.61,Default,,0,0,0,,(Стефани) Ха! (Сора) Алданып қалдың.
Dialogue: 0,0:13:49.03,0:13:50.91,Default,,0,0,0,,Маған көз қалқанын ұстаңыз—
Dialogue: 0,0:13:51.03,0:13:53.04,Default,,0,0,0,,Маған бірінші және соңғы мүмкіндігіңізді беріңізші!
Dialogue: 0,0:13:53.16,0:13:54.66,Default,,0,0,0,,Не!
Dialogue: 0,0:13:54.79,0:13:58.42,Default,,0,0,0,,Егер мен Eyeshield-ді баса алмасам
Dialogue: 0,0:13:59.96,0:14:01.09,Default,,0,0,0,,Мен командадан шығамын!
Dialogue: 0,0:14:01.21,0:14:02.25,Default,,0,0,0,,Не? (Гомер) А...
Dialogue: 0,0:14:02.38,0:14:03.21,Default,,0,0,0,,Пантера
Dialogue: 0,0:14:10.26,0:14:12.85,Default,,0,0,0,,Маған бірінші және соңғы мүмкіндігіңізді беріңізші!
Dialogue: 0,0:14:27.57,0:14:28.40,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:14:29.95,0:14:30.78,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:14:31.24,0:14:34.03,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:14:34.49,0:14:36.00,Default,,0,0,0,,Бұл сол жігіт.
Dialogue: 0,0:14:36.12,0:14:38.00,Default,,0,0,0,,Леонардо Аполлон?
Dialogue: 0,0:14:38.66,0:14:42.33,Default,,0,0,0,,Ер адамдар басқа адамдарға қарағанда үш есе көп жаттығу жасайтыны рас сияқты.
Dialogue: 0,0:14:42.46,0:14:45.96,Default,,0,0,0,,Мұны айту қиын, бірақ қарапайым халық үшін бұл үміт жұлдызы.
Dialogue: 0,0:14:46.76,0:14:47.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:48.09,0:14:52.22,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:14:53.51,0:14:56.97,Default,,0,0,0,,Мен осы жылы негізгі құрамға шығуым мүмкін.
Dialogue: 0,0:15:05.65,0:15:06.48,Default,,0,0,0,,Ha
Dialogue: 0,0:15:07.53,0:15:08.36,Default,,0,0,0,,Құт
Dialogue: 0,0:15:09.03,0:15:11.07,Default,,0,0,0,,Мен не істеп жатырмын...
Dialogue: 0,0:15:11.36,0:15:14.66,Default,,0,0,0,,Мен кәсіпқой кезімдегі нәрселер әлі есімде.
Dialogue: 0,0:15:16.54,0:15:18.00,Default,,0,0,0,,«Беделді қырық алпысыншы»
Dialogue: 0,0:15:18.12,0:15:19.91,Default,,0,0,0,,«Ace Runner Morgan»
Dialogue: 0,0:15:20.16,0:15:22.42,Default,,0,0,0,,«Армадильосқа соққы беру»
Dialogue: 0,0:15:23.54,0:15:26.92,Default,,0,0,0,,Морган келсе, Аполлонды қуып жібереді.
Dialogue: 0,0:15:27.21,0:15:28.17,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:15:29.09,0:15:29.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:37.81,0:15:40.06,Default,,0,0,0,,Қанша тырысса да
Dialogue: 0,0:15:40.64,0:15:43.06,Default,,0,0,0,,Әртүрлі дарынмен туылған
Dialogue: 0,0:15:43.31,0:15:45.86,Default,,0,0,0,,Дүние тек күш салу арқылы бұрынғыдай болмайды.
Dialogue: 0,0:15:47.98,0:15:50.24,Default,,0,0,0,,Мен сені жұмыстан шығармас бұрын бір ғана ойын...
Dialogue: 0,0:15:51.20,0:15:53.95,Default,,0,0,0,,Оны Морганмен бір ғана ойын үшін салыстыра аласыз ба?
Dialogue: 0,0:15:56.20,0:15:59.16,Default,,0,0,0,,Маған бірінші және соңғы мүмкіндігіңізді беріңізші!
Dialogue: 0,0:15:59.41,0:16:02.08,Default,,0,0,0,,Сонымен, егер сіз Морганнан да нашар болсаңыз
Dialogue: 0,0:16:02.96,0:16:05.38,Default,,0,0,0,,Мен командадан үндемей кетемін!
Dialogue: 0,0:16:06.13,0:16:07.59,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:16:07.71,0:16:09.17,Default,,0,0,0,,Маған мүмкіндік беріңізші!
Dialogue: 0,0:16:10.30,0:16:11.42,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:16:12.30,0:16:13.63,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:16:14.68,0:16:16.39,Default,,0,0,0,,Бір ғана сәйкестік жеткілікті.
Dialogue: 0,0:16:18.39,0:16:19.35,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:16:20.77,0:16:23.56,Default,,0,0,0,,Өкінішке орай, бұл қажет емес.
Dialogue: 0,0:16:23.69,0:16:24.69,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:16:25.31,0:16:27.65,Default,,0,0,0,,Енді сізде мүмкіндік жоқ.
Dialogue: 0,0:16:31.49,0:16:32.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:32.74,0:16:35.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:36.07,0:16:38.87,Default,,0,0,0,,Сізде басқа мүмкіндік жоқ...
Dialogue: 0,0:16:39.37,0:16:40.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:43.54,0:16:45.46,Default,,0,0,0,,Бұл еліктеудің қандай түрі?
Dialogue: 0,0:16:45.92,0:16:47.54,Default,,0,0,0,,Мұны бізден де жасаңыз!
Dialogue: 0,0:16:47.84,0:16:49.25,Default,,0,0,0,,Пантераны шығарыңыз!
Dialogue: 0,0:16:50.21,0:16:51.13,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:16:52.17,0:16:56.01,Default,,0,0,0,,Менің досым болғандықтан ғана сенің шыққаныңды қалағаным емес.
Dialogue: 0,0:16:56.18,0:16:59.97,Default,,0,0,0,,Бұл дамумен Пантераның аяқтары болмаса 10 ұпаймен жеңу қиын болар еді.
Dialogue: 0,0:17:00.56,0:17:01.68,Default,,0,0,0,,Құт
Dialogue: 0,0:17:01.85,0:17:03.73,Default,,0,0,0,,Практикаға қатыспау
Dialogue: 0,0:17:03.85,0:17:06.73,Default,,0,0,0,,Сіз кенеттен команда болып ойнай аламын деп ойлайсыз ба?
Dialogue: 0,0:17:06.85,0:17:08.77,Default,,0,0,0,,Жоқ, мен мұны жаттығу үшін жасадым.
Dialogue: 0,0:17:08.90,0:17:09.73,Default,,0,0,0,,Не?
Dialogue: 0,0:17:10.19,0:17:11.03,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:11.15,0:17:14.53,Default,,0,0,0,,Негізі директорсыз біз ғана.
Dialogue: 0,0:17:14.90,0:17:16.66,Default,,0,0,0,,Тек сендер болсаңдар ше?
Dialogue: 0,0:17:17.53,0:17:18.37,Default,,0,0,0,,Иә
Dialogue: 0,0:17:18.49,0:17:20.95,Default,,0,0,0,,Өзіміз ойлап тапқан формация бар.
Dialogue: 0,0:17:22.12,0:17:24.41,Default,,0,0,0,,Мен оны Мунсаулт формациясы деп атадым.
Dialogue: 0,0:17:24.71,0:17:26.21,Default,,0,0,0,,Пантераның аяқтарын пайдалану
Dialogue: 0,0:17:26.33,0:17:28.46,Default,,0,0,0,,Бұл еркін жүретін формация.
Dialogue: 0,0:17:29.59,0:17:30.42,Default,,0,0,0,,Ах
Dialogue: 0,0:17:30.54,0:17:31.67,Default,,0,0,0,,Пантера жігіті
Dialogue: 0,0:17:31.80,0:17:34.97,Default,,0,0,0,,Мен доптарды алу кезінде басқа адамдарға қарағанда үш есе көп жаттықтым.
Dialogue: 0,0:17:35.09,0:17:35.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:36.55,0:17:39.18,Default,,0,0,0,,Маған оны матчта көруге рұқсат етіңіз!
Dialogue: 0,0:17:39.34,0:17:41.97,Default,,0,0,0,,Бұл түзіліс пантераның болуымен мүмкін болды.
Dialogue: 0,0:17:42.10,0:17:43.14,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:17:43.81,0:17:46.39,Default,,0,0,0,,Бізге команда ретінде сеніңіз!
Dialogue: 0,0:17:46.77,0:17:48.77,Default,,0,0,0,,Бізге мүмкіндік беріңізші!
Dialogue: 0,0:17:49.73,0:17:51.61,Default,,0,0,0,,Өтінемін! Өтінемін, маған мүмкіндік беріңіз!
Dialogue: 0,0:17:51.73,0:17:53.69,Default,,0,0,0,,Пантераны шығарыңыз!
Dialogue: 0,0:17:54.36,0:17:56.40,Default,,0,0,0,,Mi… барлығына
Dialogue: 0,0:17:57.95,0:18:00.41,Default,,0,0,0,,Уф... өтінемін!
Dialogue: 0,0:18:02.66,0:18:03.91,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:18:08.25,0:18:09.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:10.75,0:18:12.04,Default,,0,0,0,,Мүмкіндік болса...
Dialogue: 0,0:18:16.92,0:18:17.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:18.43,0:18:19.43,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:21.47,0:18:23.76,Default,,0,0,0,,Бұл сәйкестік... барлығы.
Dialogue: 0,0:18:24.18,0:18:25.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:25.14,0:18:25.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.23,0:18:27.31,Default,,0,0,0,,Ах... (ойыншылар) Ах...
Dialogue: 0,0:18:27.73,0:18:30.06,Default,,0,0,0,,(Ойыншылардың күлкісі)
Dialogue: 0,0:18:30.60,0:18:32.40,Default,,0,0,0,,Жарайсың Пантера!
Dialogue: 0,0:18:33.52,0:18:37.40,Default,,0,0,0,,Мен шетелдіктердің формасын киемін...
Dialogue: 0,0:18:39.24,0:18:40.61,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:40.91,0:18:43.41,Default,,0,0,0,,Шатаспа, қазір шық!
Dialogue: 0,0:18:43.83,0:18:45.49,Default,,0,0,0,,Мен ойымды өзгертпес бұрын!
Dialogue: 0,0:18:46.70,0:18:48.46,Default,,0,0,0,,Eyeshield қолданбасын кез келген жағдайда басыңыз!
Dialogue: 0,0:18:49.33,0:18:51.17,Default,,0,0,0,,Тек осыны істеу керек!
Dialogue: 0,0:18:51.92,0:18:53.17,Default,,0,0,0,,Уф... иә!
Dialogue: 0,0:18:57.42,0:18:59.34,Default,,0,0,0,,(Қара барыстың ақыруы)
Dialogue: 0,0:18:59.51,0:19:00.34,Default,,0,0,0,,Ах
Dialogue: 0,0:19:00.47,0:19:01.30,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:09.48,0:19:10.64,Default,,0,0,0,,Пантера-кун
Dialogue: 0,0:19:11.44,0:19:12.27,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:19:12.40,0:19:15.48,Default,,0,0,0,,Жау қозыр ойнаған сияқты.
Dialogue: 0,0:19:20.07,0:19:21.24,Default,,0,0,0,,О? (Таками) Сусуму
Dialogue: 0,0:19:26.45,0:19:28.91,Default,,0,0,0,,Айдың формациясы?
Dialogue: 0,0:19:29.29,0:19:31.67,Default,,0,0,0,,Оның қандай екенін көрейік.
Dialogue: 0,0:19:36.55,0:19:39.80,Default,,0,0,0,,Көз қалқаны 21 Уәде етілгендей.
Dialogue: 0,0:19:40.13,0:19:41.59,Default,,0,0,0,,Сіз далада шайқаса аласыз!
Dialogue: 0,0:19:41.72,0:19:42.76,Default,,0,0,0,,Пантера
Dialogue: 0,0:19:44.14,0:19:45.39,Default,,0,0,0,,Соңында сіздермен!
Dialogue: 0,0:19:50.02,0:19:55.02,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:56.02,0:20:02.03,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:21:04.26,0:21:10.26,Default,,0,0,0,,~♪
Dialogue: 0,0:21:11.68,0:21:13.85,Default,,0,0,0,,Ақыры аңды табиғатқа жіберді.
Dialogue: 0,0:21:14.27,0:21:17.27,Default,,0,0,0,,Қара қабылан пантерасы VS (Қарсы) Айсшилд 21
Dialogue: 0,0:21:17.73,0:21:19.52,Default,,0,0,0,,Салмақсыз аяқ және жеңіл жылдамдық аяқтары
Dialogue: 0,0:21:19.77,0:21:22.32,Default,,0,0,0,,Сена, маған күшіңді көрсет!
Dialogue: 0,0:21:22.61,0:21:24.74,Default,,0,0,0,,Бұл кездесуді жіберіп алмаңыз!
Dialogue: 0,0:21:25.53,0:21:27.74,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:29.32,0:21:30.70,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:32.20,0:21:38.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
