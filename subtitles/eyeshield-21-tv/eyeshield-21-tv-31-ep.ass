Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.05,0:00:15.22,Default,,0,0,0,,Айтпақшы, мен билетімді жыртып алдым...
Dialogue: 0,0:00:15.34,0:00:18.39,Default,,0,0,0,,Күзгі турнирге уақытында Жапонияға қалай ораламын?
Dialogue: 0,0:00:18.85,0:00:20.39,Default,,0,0,0,,Жапонияға бару
Dialogue: 0,0:00:20.52,0:00:21.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:21.68,0:00:22.64,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:00:22.77,0:00:23.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:23.98,0:00:25.52,Default,,0,0,0,,Жаяу...
Dialogue: 0,0:00:27.11,0:00:28.57,Default,,0,0,0,,Теңізді не істейміз?
Dialogue: 0,0:00:28.82,0:00:31.82,Default,,0,0,0,,Егер сіз батыс жағалауға барсаңыз, сіз ақша ұтып аласыз.
Dialogue: 0,0:00:32.44,0:00:34.28,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:00:34.40,0:00:36.78,Default,,0,0,0,,Батыс жағалауда ақша ұтып алу?
Dialogue: 0,0:00:37.62,0:00:39.49,Default,,0,0,0,,Баратын жер...
Dialogue: 0,0:00:42.29,0:00:43.29,Default,,0,0,0,,Лас-Вегас
Dialogue: 0,0:00:43.41,0:00:44.33,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:44.66,0:00:46.96,Default,,0,0,0,,Мұны болжам деп атамаңыз!
Dialogue: 0,0:00:47.38,0:00:49.13,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:00:49.25,0:00:50.21,Default,,0,0,0,,40 күн ішінде
Dialogue: 0,0:00:50.34,0:00:52.96,Default,,0,0,0,,Техастан Лас-Вегасқа дейін 2000 шақырым
Dialogue: 0,0:00:53.42,0:00:56.18,Default,,0,0,0,,Америка бойынша ультра жаттығу
Dialogue: 0,0:00:57.43,0:00:59.22,Default,,0,0,0,,Бұл өлім маршы
Dialogue: 0,0:00:59.43,0:01:00.85,Default,,0,0,0,,Бұл шынымен тозақ.
Dialogue: 0,0:01:00.97,0:01:02.22,Default,,0,0,0,,Шынында, хе-хе
Dialogue: 0,0:01:02.35,0:01:04.64,Default,,0,0,0,,Өлім наурызы оңай болуы мүмкін емес.
Dialogue: 0,0:01:05.48,0:01:08.69,Default,,0,0,0,,40 күнде бір жылдық оқу.
Dialogue: 0,0:01:08.90,0:01:12.36,Default,,0,0,0,,Әр позицияға жаттығу кезінде марафонды жүгіріңіз.
Dialogue: 0,0:01:12.48,0:01:13.61,Default,,0,0,0,,Позициясы бойынша?
Dialogue: 0,0:01:14.32,0:01:16.65,Default,,0,0,0,,Хэ Я-! Ха-!
Dialogue: 0,0:01:17.53,0:01:18.66,Default,,0,0,0,,Квадрат! (мылтық)
Dialogue: 0,0:01:18.78,0:01:19.82,Default,,0,0,0,,Атта, итта (Юкимицу) Уау!
Dialogue: 0,0:01:19.95,0:01:21.41,Default,,0,0,0,,Уа, күте тұрыңыз... (Юкимицу) Эй...
Dialogue: 0,0:01:21.62,0:01:23.62,Default,,0,0,0,,оның 2000 км!
Dialogue: 0,0:01:24.20,0:01:26.66,Default,,0,0,0,,Біздің қатарда болғанымызға қуаныштымын~
Dialogue: 0,0:01:26.79,0:01:27.87,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:01:29.46,0:01:30.67,Default,,0,0,0,,Осы кішкентай бензинмен
Dialogue: 0,0:01:30.79,0:01:33.25,Default,,0,0,0,,Мен оны батыс жағалауға дейін жеткізеді деп ойламаймын.
Dialogue: 0,0:01:33.38,0:01:35.80,Default,,0,0,0,,Ібіліс жарғанаты Сіз оны артта қалдыруды жоспарлап отырсыз ба?
Dialogue: 0,0:01:35.97,0:01:36.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:37.01,0:01:38.30,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:01:38.43,0:01:39.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:39.39,0:01:41.22,Default,,0,0,0,,Unnunu!
Dialogue: 0,0:01:41.60,0:01:43.52,Default,,0,0,0,,Эй, қатты басыңыз!
Dialogue: 0,0:01:43.64,0:01:45.23,Default,,0,0,0,,Ешқандай прогресс жасамайсыз.
Dialogue: 0,0:01:45.39,0:01:46.68,Default,,0,0,0,,Хаха... хахахаха
Dialogue: 0,0:01:46.81,0:01:47.69,Default,,0,0,0,,Сена иә?
Dialogue: 0,0:01:47.81,0:01:51.73,Default,,0,0,0,,Күн соғуын болдырмау үшін оны басыңызға киіңіз.
Dialogue: 0,0:01:51.86,0:01:53.23,Default,,0,0,0,,А... иә
Dialogue: 0,0:01:53.36,0:01:55.15,Default,,0,0,0,,Мен су сатып аламын.
Dialogue: 0,0:01:57.32,0:01:59.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:59.49,0:02:01.66,Default,,0,0,0,,Сена, сен мына жігітсің.
Dialogue: 0,0:02:02.83,0:02:04.04,Default,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:02:04.95,0:02:07.33,Default,,0,0,0,,Хопскот...?
Dialogue: 0,0:02:07.46,0:02:10.58,Default,,0,0,0,,Дұрыс, сол затты теуіп тұрып жүгір.
Dialogue: 0,0:02:10.71,0:02:11.75,Default,,0,0,0,,(Тас тепкен дыбыс)
Dialogue: 0,0:02:15.21,0:02:19.47,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:02:20.59,0:02:24.72,Default,,0,0,0,,Егер мен сол тасты жоғалтпай, батыс жағалауға дейін жүгіре алсам.
Dialogue: 0,0:02:24.85,0:02:28.27,Default,,0,0,0,,Сіз өзіңіздің өлімге әкелетін әлсіздігіңізді жеңдіңіз және
Dialogue: 0,0:02:28.39,0:02:30.98,Default,,0,0,0,,Өте өлімге әкелетін кесу, оны тіпті Сусуму да тоқтата алмайды
Dialogue: 0,0:02:31.10,0:02:32.86,Default,,0,0,0,,Сіз оны меңгеруіңіз керек еді.
Dialogue: 0,0:02:35.02,0:02:35.86,Default,,0,0,0,,(Тас тепкен дыбыс)
Dialogue: 0,0:02:37.40,0:02:40.49,Default,,0,0,0,,(Сенаның ауыр тыныс алуы)
Dialogue: 0,0:02:41.20,0:02:42.78,Default,,0,0,0,,Бұл Өлім наурызы
Dialogue: 0,0:02:43.20,0:02:45.95,Default,,0,0,0,,Бұл ыстық және қатты.
Dialogue: 0,0:02:47.12,0:02:48.00,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:02:49.50,0:02:53.59,Default,,0,0,0,,Бұл әрекетті орындау барысында барлығы күшейе түседі!
Dialogue: 0,0:02:54.00,0:03:00.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:04:07.83,0:04:13.83,Default,,0,0,0,,~♪
Dialogue: 0,0:04:22.51,0:04:23.59,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:04:24.43,0:04:25.55,Default,,0,0,0,,Міне
Dialogue: 0,0:04:26.01,0:04:27.51,Default,,0,0,0,,(секіру дыбысы)
Dialogue: 0,0:04:28.26,0:04:29.10,Default,,0,0,0,,Даха!
Dialogue: 0,0:04:29.47,0:04:31.27,Default,,0,0,0,,Ыстық бұлақтар ең жақсы!
Dialogue: 0,0:04:31.52,0:04:33.06,Default,,0,0,0,,Фудзияма төрттік сұлулығы!
Dialogue: 0,0:04:33.81,0:04:38.56,Default,,0,0,0,,Мен төлқұжатымды қайта шығара алдым, қанатымды жая аламын, айтар сөзім жоқ.
Dialogue: 0,0:04:38.69,0:04:41.57,Default,,0,0,0,,Пантера Бұл ерекше оқиға.
Dialogue: 0,0:04:42.11,0:04:44.78,Default,,0,0,0,,Фудзиямада Сусуму Имамен бірге ақ рыцарьлар бар.
Dialogue: 0,0:04:44.90,0:04:46.07,Default,,0,0,0,,Ол оқу-жаттығу жиынына келе жатқан сияқты.
Dialogue: 0,0:04:46.20,0:04:47.03,Default,,0,0,0,,Не!
Dialogue: 0,0:04:47.49,0:04:51.79,Default,,0,0,0,,Бұл Сусуму Жапония тарихындағы ең мықты лайнбэкші ме?
Dialogue: 0,0:04:51.91,0:04:52.75,Default,,0,0,0,,О
Dialogue: 0,0:04:57.00,0:04:59.59,Default,,0,0,0,,Сусуму сол жерде.
Dialogue: 0,0:05:02.09,0:05:03.46,Default,,0,0,0,,Сіз қалуға шындап қарайсыз ба?
Dialogue: 0,0:05:04.05,0:05:05.80,Default,,0,0,0,,Мен Eyeshield-пен күресе алдым.
Dialogue: 0,0:05:05.93,0:05:06.88,Default,,0,0,0,,Сусуму ғана қалды
Dialogue: 0,0:05:07.64,0:05:10.56,Default,,0,0,0,,Жақын болсам да, бұлай үйге бара алмаймын.
Dialogue: 0,0:05:11.39,0:05:12.52,Default,,0,0,0,,Жалпы I
Dialogue: 0,0:05:12.81,0:05:15.10,Default,,0,0,0,,Мен енді шетелдіктермен бірге тұра алмаймын.
Dialogue: 0,0:05:20.61,0:05:22.11,Default,,0,0,0,,Өйткені бұл уәде
Dialogue: 0,0:05:22.36,0:05:23.94,Default,,0,0,0,,Ешқашан өзіңізді шетелдіктер деп атамаңыз.
Dialogue: 0,0:05:25.19,0:05:26.03,Default,,0,0,0,,Иә
Dialogue: 0,0:05:29.62,0:05:30.53,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:05:30.66,0:05:34.00,Default,,0,0,0,,Мен ойын алдында: «Біз 10 немесе одан да көп ұпай айырмашылығымен жеңуіміз керек» дедім.
Dialogue: 0,0:05:34.12,0:05:35.00,Default,,0,0,0,,«NASA шетелдіктер»
Dialogue: 0,0:05:35.12,0:05:38.71,Default,,0,0,0,,«Америка жеріне енді ешқашан аяқ баспауға» бола ма?
Dialogue: 0,0:05:38.83,0:05:39.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:40.71,0:05:42.30,Default,,0,0,0,,Топ атын өзгерту
Dialogue: 0,0:05:43.00,0:05:45.51,Default,,0,0,0,,Бүгіннен бастап біз «NASA Shuttles» боламыз.
Dialogue: 0,0:05:45.63,0:05:48.59,Default,,0,0,0,,Егер сіз мұны жасасаңыз, Америкаға оралсаңыз да, сізде ешқандай қиындық болмайды.
Dialogue: 0,0:05:49.01,0:05:52.06,Default,,0,0,0,,Уау... (Гомер) Бастауыш сыныптың сылтауы.
Dialogue: 0,0:05:52.72,0:05:54.02,Default,,0,0,0,,Пантера (Пантера) Ах!
Dialogue: 0,0:05:55.93,0:05:58.19,Default,,0,0,0,,NASA Шаттлдары кері жүгіріп келеді
Dialogue: 0,0:05:58.56,0:06:02.07,Default,,0,0,0,,Жаңа формадағы 20 санын кигіңіз келсе ашық қалдырыңыз.
Dialogue: 0,0:06:02.19,0:06:03.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:03.32,0:06:06.86,Default,,0,0,0,,О... мен NASA Shuttles-тің 20-шымын.
Dialogue: 0,0:06:07.24,0:06:08.45,Default,,0,0,0,,Артқа жүгіру...
Dialogue: 0,0:06:11.82,0:06:13.12,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:06:13.79,0:06:15.75,Default,,0,0,0,,Мен шынымен қосылғым келеді!
Dialogue: 0,0:06:16.29,0:06:18.71,Default,,0,0,0,,Леонардо Аполлонның командасына.
Dialogue: 0,0:06:19.96,0:06:23.71,Default,,0,0,0,,Мен сені бұрынғыдан да қатты қысамын, дайындал!
Dialogue: 0,0:06:29.72,0:06:30.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:39.44,0:06:41.48,Default,,0,0,0,,Бұл ойын, Сусуму!
Dialogue: 0,0:06:45.94,0:06:47.74,Default,,0,0,0,,(Сусумуның ауыр тыныс алуы)
Dialogue: 0,0:06:55.45,0:06:58.41,Default,,0,0,0,,Шин, бұл тек саған арналған арнайы мәзір.
Dialogue: 0,0:06:59.58,0:07:03.13,Default,,0,0,0,,Біз бүгіннен бастап күзгі турнирге дейін Фудзи тауында 40 күн тұрамыз.
Dialogue: 0,0:07:03.25,0:07:04.09,Default,,0,0,0,,Иә
Dialogue: 0,0:07:04.63,0:07:06.71,Default,,0,0,0,,Дегенмен, ауасы жұқа таудың басында
Dialogue: 0,0:07:06.84,0:07:10.51,Default,,0,0,0,,Жүрек-тыныс алу қабілеті артады, бірақ жаттығу әсері төмендейді
Dialogue: 0,0:07:10.84,0:07:14.22,Default,,0,0,0,,Сондықтан күндіз таудан түсіп, барлығымен бірге жаттығу жасаймын.
Dialogue: 0,0:07:14.35,0:07:18.31,Default,,0,0,0,,Басқаша айтқанда, сіз күн сайын Фудзи тауына көтеріліп, төмен түсесіз.
Dialogue: 0,0:07:18.72,0:07:19.89,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:07:20.23,0:07:21.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:21.56,0:07:22.90,Default,,0,0,0,,Мұны өзіңізбен бірге алыңыз.
Dialogue: 0,0:07:23.52,0:07:25.69,Default,,0,0,0,,Иә? (Шодзи) GPS.
Dialogue: 0,0:07:25.82,0:07:27.07,Default,,0,0,0,,Коммутаторды басып көріңіз
Dialogue: 0,0:07:27.19,0:07:28.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:28.69,0:07:31.20,Default,,0,0,0,,Жерсеріктермен байланысу арқылы ағымдағы орналасқан жеріңізді біліңіз
Dialogue: 0,0:07:31.90,0:07:36.16,Default,,0,0,0,,Ағаштар теңізі - сиқырлы орман, онда сіздің компасыңыз ессіз қалады. Адасып қалсаңыз, ешқашан шыға алмайсыз.
Dialogue: 0,0:07:36.28,0:07:37.12,Default,,0,0,0,,Иә
Dialogue: 0,0:07:37.58,0:07:38.66,Default,,0,0,0,,Тек осы
Dialogue: 0,0:07:38.95,0:07:40.58,Default,,0,0,0,,Еш ойланбаңыз!
Dialogue: 0,0:07:43.37,0:07:44.63,Default,,0,0,0,,Бұл ... болуы керек.
Dialogue: 0,0:07:45.21,0:07:47.96,Default,,0,0,0,,Мен бір нәрсені ұмытып бара жатқандай сезінемін.
Dialogue: 0,0:07:52.30,0:07:53.13,Default,,0,0,0,,Ах
Dialogue: 0,0:07:57.89,0:07:59.52,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:08:00.10,0:08:00.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:01.18,0:08:02.94,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:08:03.44,0:08:04.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:05.10,0:08:06.94,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:08:07.65,0:08:08.94,Default,,0,0,0,,Ммм!
Dialogue: 0,0:08:09.11,0:08:11.44,Default,,0,0,0,,Мм... Ах!
Dialogue: 0,0:08:11.74,0:08:12.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:12.70,0:08:13.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:13.86,0:08:15.45,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:08:19.16,0:08:20.41,Default,,0,0,0,,Карта біртүрлі екен.
Dialogue: 0,0:08:22.33,0:08:23.96,Default,,0,0,0,,Тауға өрмелеуді бастағаннан кейін 5 минуттан кейін
Dialogue: 0,0:08:24.08,0:08:27.38,Default,,0,0,0,,Сусуму Сейжуро қиналып жатыр ма? Я-ха-
Dialogue: 0,0:08:29.92,0:08:31.01,Default,,0,0,0,,Ұзын пост!
Dialogue: 0,0:08:31.13,0:08:33.30,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:33.42,0:08:37.14,Default,,0,0,0,,Ха ха ха... Бұл әдеттегі жүгіруден де қиын!
Dialogue: 0,0:08:37.26,0:08:38.10,Default,,0,0,0,,Бұрыш!
Dialogue: 0,0:08:38.22,0:08:39.56,Default,,0,0,0,,Уау... (мылтық атылды)
Dialogue: 0,0:08:39.72,0:08:43.06,Default,,0,0,0,,Ei Ei Ei
Dialogue: 0,0:08:43.18,0:08:45.02,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:08:47.40,0:08:49.65,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:08:50.02,0:08:51.98,Default,,0,0,0,,Мен сіз маршрут бойынша жаттығу жасап жатқаныңызды түсінемін.
Dialogue: 0,0:08:52.40,0:08:53.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:54.24,0:08:55.07,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:08:55.20,0:08:57.70,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:08:58.32,0:08:59.70,Default,,0,0,0,,Қарамаңдар!
Dialogue: 0,0:08:59.83,0:09:00.66,Default,,0,0,0,,Hiiii
Dialogue: 0,0:09:00.91,0:09:02.08,Default,,0,0,0,,Патрульдер жүргізіледі —
Dialogue: 0,0:09:02.20,0:09:05.29,Default,,0,0,0,,Егер сіз бұл тасты жоғалтсаңыз, қайтадан бастауға тура келеді.
Dialogue: 0,0:09:05.41,0:09:06.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:06.58,0:09:09.63,Default,,0,0,0,,Әй, қайда бардың?
Dialogue: 0,0:09:10.38,0:09:11.38,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:09:13.17,0:09:14.09,Default,,0,0,0,,Хаа~
Dialogue: 0,0:09:15.30,0:09:17.55,Default,,0,0,0,,Мен бұл нені білдіретінін білмеймін
Dialogue: 0,0:09:18.05,0:09:20.64,Default,,0,0,0,,Уақыттың аяқталуына небәрі 40 күн қалды.
Dialogue: 0,0:09:21.01,0:09:22.06,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:09:23.06,0:09:24.81,Default,,0,0,0,,Егер лайықты қорғаныс болса
Dialogue: 0,0:09:24.93,0:09:28.90,Default,,0,0,0,,Eyeshield 21-нің өлімге әкелетін әлсіздігін ешқашан назардан тыс қалдырмаңыз.
Dialogue: 0,0:09:29.31,0:09:30.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:30.40,0:09:31.52,Default,,0,0,0,,Әлсіз жақтары…
Dialogue: 0,0:09:34.49,0:09:37.07,Default,,0,0,0,,Сіз оны міндетті түрде жеңесіз!
Dialogue: 0,0:09:39.16,0:09:40.70,Default,,0,0,0,,(Сусумуның ауыр тыныс алуы)
Dialogue: 0,0:09:44.20,0:09:46.87,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:09:51.04,0:09:53.30,Default,,0,0,0,,(айқай)
Dialogue: 0,0:09:56.42,0:09:57.68,Default,,0,0,0,,Жабайы қабан
Dialogue: 0,0:09:58.55,0:09:59.97,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:10:00.09,0:10:01.80,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:10:02.64,0:10:03.97,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:10:04.81,0:10:06.93,Default,,0,0,0,,Хмм!
Dialogue: 0,0:10:11.52,0:10:12.44,Default,,0,0,0,,Urya!
Dialogue: 0,0:10:13.02,0:10:14.94,Default,,0,0,0,,(жабайы қабан)
Dialogue: 0,0:10:19.78,0:10:20.62,Default,,0,0,0,,Хамф!
Dialogue: 0,0:10:23.37,0:10:24.74,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:10:28.41,0:10:30.04,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:10:30.42,0:10:31.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:32.59,0:10:34.00,Default,,0,0,0,,Бірақ білесің бе, Коичи…
Dialogue: 0,0:10:35.21,0:10:37.38,Default,,0,0,0,,Барлығы GPS-ті ұмытпаңыз
Dialogue: 0,0:10:37.59,0:10:39.88,Default,,0,0,0,,Ешқашан жалғыз әрекет етпеңіз
Dialogue: 0,0:10:40.47,0:10:42.76,Default,,0,0,0,,Мен полицияға хабарлауым керек пе?
Dialogue: 0,0:10:42.89,0:10:44.64,Default,,0,0,0,,Сусуму кемесінің апатқа ұшырауы
Dialogue: 0,0:10:44.97,0:10:46.64,Default,,0,0,0,,Әйтеуір, өзіміз іздеп көрейік.
Dialogue: 0,0:10:47.35,0:10:50.31,Default,,0,0,0,,Сусуму-сан, сенің жақсы болатыныңа сенімдімін, солай ма?
Dialogue: 0,0:10:50.77,0:10:54.15,Default,,0,0,0,,Бірақ аюлар мен жабайы қабандар да пайда болады.
Dialogue: 0,0:10:54.27,0:10:56.86,Default,,0,0,0,,Өтінемін, енді мені қорқытпа!
Dialogue: 0,0:10:56.98,0:10:57.82,Default,,0,0,0,,
Dialogue: 0,0:10:57.94,0:10:59.32,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:02.37,0:11:03.53,Default,,0,0,0,,Аю!
Dialogue: 0,0:11:03.66,0:11:05.03,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:11:05.49,0:11:08.83,Default,,0,0,0,,Не? аю? Мен онымен күресемін
Dialogue: 0,0:11:08.95,0:11:11.83,Default,,0,0,0,,Жоқ, Шубаба әлдеқашан ағаш... А?
Dialogue: 0,0:11:12.17,0:11:13.25,Default,,0,0,0,,Шубаба?
Dialogue: 0,0:11:14.96,0:11:16.75,Default,,0,0,0,,Мүмкін сіз бірдеңені дұрыс түсінбеген шығарсыз?
Dialogue: 0,0:11:17.55,0:11:18.46,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:18.71,0:11:22.09,Default,,0,0,0,,Аю көрінсе де, Сусумуға бұл туралы алаңдаудың қажеті жоқ.
Dialogue: 0,0:11:22.22,0:11:23.55,Default,,0,0,0,,Мен қиналғанымды сезбедім.
Dialogue: 0,0:11:23.68,0:11:26.14,Default,,0,0,0,,Жақсы жаттығатыныңызға сенімдімін Нахахаха!
Dialogue: 0,0:11:26.26,0:11:28.68,Default,,0,0,0,,Бұл туралы көп уайымдамаңыз.
Dialogue: 0,0:11:38.94,0:11:40.82,Default,,0,0,0,,Мен бұл жағдайға сене алмаймын...
Dialogue: 0,0:11:45.28,0:11:46.33,Default,,0,0,0,,Құрметті Құт-береке Құдайының шын мәнінде Нора ұстайтын сиқыршы екеніне сену қиын.
Dialogue: 0,0:11:49.41,0:11:52.37,Default,,0,0,0,,Тек ет тағамдық жағынан теңдестірілген емес
Dialogue: 0,0:11:53.62,0:11:55.21,Default,,0,0,0,,Шин! (Сусуму) Иә?
Dialogue: 0,0:11:57.67,0:11:58.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:00.59,0:12:03.55,Default,,0,0,0,,Сусуму ұзақ іздеді
Dialogue: 0,0:12:03.97,0:12:05.47,Default,,0,0,0,,Жарысқа қатысу үшін!
Dialogue: 0,0:12:08.81,0:12:09.85,Default,,0,0,0,,Уа... мен...
Dialogue: 0,0:12:09.97,0:12:12.52,Default,,0,0,0,,Уау, толқудан сөйлей алмаймын.
Dialogue: 0,0:12:12.85,0:12:13.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:14.35,0:12:17.44,Default,,0,0,0,,Қарғыс атсын, тезірек, тезірек, у...
Dialogue: 0,0:12:17.86,0:12:18.69,Default,,0,0,0,,Мен
Dialogue: 0,0:12:18.82,0:12:19.78,Default,,0,0,0,,Мен ұрысқым келеді
Dialogue: 0,0:12:19.90,0:12:20.73,Default,,0,0,0,,Сусуму және
Dialogue: 0,0:12:21.24,0:12:22.82,Default,,0,0,0,,I see, I understand.
Dialogue: 0,0:12:23.36,0:12:24.24,Default,,0,0,0,,«Менің қарным ашты»
Dialogue: 0,0:12:24.57,0:12:25.87,Default,,0,0,0,,«Мені де тамақтандыр»
Dialogue: 0,0:12:26.16,0:12:27.16,Default,,0,0,0,,«Қабан»
Dialogue: 0,0:12:28.12,0:12:29.45,Default,,0,0,0,,Мен де солай сезінемін.
Dialogue: 0,0:12:30.08,0:12:30.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:31.08,0:12:32.46,Default,,0,0,0,,Саңырауқұлақтар!
Dialogue: 0,0:12:32.58,0:12:33.66,Default,,0,0,0,,Саңырауқұлақтар!
Dialogue: 0,0:12:33.83,0:12:35.67,Default,,0,0,0,,Саңырауқұлақтар!
Dialogue: 0,0:12:37.29,0:12:39.04,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:12:39.17,0:12:40.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:40.88,0:12:41.96,Default,,0,0,0,,Шин!
Dialogue: 0,0:12:42.17,0:12:44.63,Default,,0,0,0,,Хехе, неге екені белгісіз.
Dialogue: 0,0:12:44.76,0:12:46.59,Default,,0,0,0,,(Отавараның қорылдауы)
Dialogue: 0,0:12:46.72,0:12:49.26,Default,,0,0,0,,Иә~ Жаңа NASA Shuttles?
Dialogue: 0,0:12:49.39,0:12:50.22,Default,,0,0,0,,О
Dialogue: 0,0:12:50.68,0:12:53.60,Default,,0,0,0,,Мен форма кигендіктен, өкінгім келмейді.
Dialogue: 0,0:12:53.89,0:12:54.85,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:56.48,0:12:58.56,Default,,0,0,0,,Сусуму, менімен жарыс!
Dialogue: 0,0:12:58.69,0:12:59.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:59.94,0:13:02.78,Default,,0,0,0,,Мен Eyeshield-пен күрескеннен кейін бір ғана өкінемін.
Dialogue: 0,0:13:02.90,0:13:04.24,Default,,0,0,0,,Мен Сусумумен жұдырықтасқым келеді
Dialogue: 0,0:13:11.70,0:13:13.08,Default,,0,0,0,,Жаттығу жүріп жатыр
Dialogue: 0,0:13:14.54,0:13:15.37,Default,,0,0,0,,Шин!
Dialogue: 0,0:13:15.75,0:13:18.08,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:13:23.42,0:13:24.51,Default,,0,0,0,,Бұл доптың алмастырғышы.
Dialogue: 0,0:13:26.22,0:13:27.51,Default,,0,0,0,,(Қара пантераның үруі)
Dialogue: 0,0:13:31.81,0:13:32.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:35.43,0:13:36.39,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:13:36.52,0:13:38.60,Default,,0,0,0,,Бұл нөлдік гравитацияда жұмыс істей ме?
Dialogue: 0,0:13:46.57,0:13:47.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:47.70,0:13:48.95,Default,,0,0,0,,Хмм!
Dialogue: 0,0:13:49.28,0:13:50.12,Default,,0,0,0,,Аһ!
Dialogue: 0,0:13:51.78,0:13:53.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:53.37,0:13:55.54,Default,,0,0,0,,Бекітілген найза тірегі
Dialogue: 0,0:13:55.70,0:13:57.58,Default,,0,0,0,,Сәйкестік болды!
Dialogue: 0,0:13:58.25,0:14:00.46,Default,,0,0,0,,(Пантера жөтелі)
Dialogue: 0,0:14:02.04,0:14:03.34,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:03.50,0:14:04.46,Default,,0,0,0,,Аһ!
Dialogue: 0,0:14:05.59,0:14:07.42,Default,,0,0,0,,Сіз тыныс алуды тоқтаттыңыз.
Dialogue: 0,0:14:08.13,0:14:10.43,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:14:10.55,0:14:12.47,Default,,0,0,0,,Енді сенің менен өтуің мүмкін емес.
Dialogue: 0,0:14:12.60,0:14:13.43,Default,,0,0,0,,А...
Dialogue: 0,0:14:14.56,0:14:16.60,Default,,0,0,0,,Иә? Неліктен? неге!
Dialogue: 0,0:14:17.31,0:14:18.89,Default,,0,0,0,,Жүгіру тым ысырап
Dialogue: 0,0:14:19.02,0:14:19.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:20.15,0:14:21.73,Default,,0,0,0,,Оның болмағаны жақсы.
Dialogue: 0,0:14:21.86,0:14:23.11,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:14:23.40,0:14:25.86,Default,,0,0,0,,Сусуму ең аз шығынмен маршрутты көре алады.
Dialogue: 0,0:14:25.99,0:14:26.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:27.65,0:14:29.99,Default,,0,0,0,,Басқаша айтқанда, пантера ысырапсыз жүгіреді.
Dialogue: 0,0:14:30.11,0:14:32.83,Default,,0,0,0,,Оның қайда жүгіретінін болжау оңай.
Dialogue: 0,0:14:32.95,0:14:33.78,Default,,0,0,0,,Иә! (Пантера) Ха!
Dialogue: 0,0:14:36.20,0:14:37.16,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:14:37.91,0:14:38.79,Default,,0,0,0,,Атуға үлгермей тұрып байқап қалды.
Dialogue: 0,0:14:38.91,0:14:42.08,Default,,0,0,0,,Бәлкім, сіз көптен бері жаттығудан алыстаған шығарсыз.
Dialogue: 0,0:14:42.21,0:14:43.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:43.54,0:14:47.84,Default,,0,0,0,,Түсіндің бе? Тек... қандай жігіт.
Dialogue: 0,0:14:49.43,0:14:50.47,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:14:50.84,0:14:53.22,Default,,0,0,0,,На~хахаха, шаршадың ба?
Dialogue: 0,0:14:53.35,0:14:55.97,Default,,0,0,0,,Отавара неге мақтаншақ?
Dialogue: 0,0:14:58.02,0:14:59.60,Default,,0,0,0,,Маған бір нәрсе айтыңызшы.
Dialogue: 0,0:15:01.23,0:15:03.44,Default,,0,0,0,,Егер Қабақ қалқаны 21
Dialogue: 0,0:15:03.94,0:15:05.15,Default,,0,0,0,,Сусуму-саннан кетесіз бе?
Dialogue: 0,0:15:06.11,0:15:07.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:09.19,0:15:11.16,Default,,0,0,0,,Нува!
Dialogue: 0,0:15:11.28,0:15:12.99,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:15:13.20,0:15:16.37,Default,,0,0,0,,Бәріңе сәлем, жақсысыңдар ма?
Dialogue: 0,0:15:16.66,0:15:20.33,Default,,0,0,0,,Хм, құлау уақыты келді.
Dialogue: 0,0:15:20.92,0:15:25.92,Default,,0,0,0,,Төзімділік Дерби Пэддок болжамы Кім ең қобалжыған көрінеді?
Dialogue: 0,0:15:26.71,0:15:27.55,Default,,0,0,0,,Эй!
Dialogue: 0,0:15:28.42,0:15:29.80,Default,,0,0,0,,Хо~ Хо~
Dialogue: 0,0:15:30.80,0:15:31.63,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:15:32.97,0:15:33.80,Default,,0,0,0,,Фуго!
Dialogue: 0,0:15:34.97,0:15:36.39,Default,,0,0,0,,Ха! (Джумонджи) Ха!
Dialogue: 0,0:15:36.51,0:15:37.35,Default,,0,0,0,,Хааааааааа!
Dialogue: 0,0:15:38.72,0:15:41.02,Default,,0,0,0,,Шешім қабылдау қиын.
Dialogue: 0,0:15:41.39,0:15:43.94,Default,,0,0,0,,Эй, сен ше?
Dialogue: 0,0:15:44.61,0:15:47.48,Default,,0,0,0,,(Сенаның ауыр тыныс алуы)
Dialogue: 0,0:15:48.73,0:15:51.70,Default,,0,0,0,,Көптеген жарықтар және баяу жылдамдық
Dialogue: 0,0:15:51.86,0:15:53.86,Default,,0,0,0,,Мүлдем алға жылжымайды
Dialogue: 0,0:15:54.03,0:15:57.45,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:15:59.95,0:16:01.91,Default,,0,0,0,,Егер Eyeshield 21 және Сусуму-сан
Dialogue: 0,0:16:02.83,0:16:04.04,Default,,0,0,0,,Қайсысы күшті?
Dialogue: 0,0:16:04.75,0:16:08.46,Default,,0,0,0,,Нах~хаха Сусуму болатынына сенімдімін!
Dialogue: 0,0:16:08.96,0:16:09.84,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:16:10.21,0:16:11.67,Default,,0,0,0,,Менің де естігім келеді
Dialogue: 0,0:16:11.92,0:16:13.84,Default,,0,0,0,,Сусуму не ойлайды?
Dialogue: 0,0:16:18.22,0:16:22.14,Default,,0,0,0,,Ол кенет менің алдымда ойға келмейтін қимыл жасады.
Dialogue: 0,0:16:27.44,0:16:29.69,Default,,0,0,0,,Бірақ оның өткір иілуіне байланысты
Dialogue: 0,0:16:29.98,0:16:32.44,Default,,0,0,0,,Жаудың алдында тежеу керек
Dialogue: 0,0:16:32.57,0:16:33.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:45.29,0:16:46.21,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:47.38,0:16:49.46,Default,,0,0,0,,Әрқашан тебу кезінде тежегішті басыңыз
Dialogue: 0,0:16:49.59,0:16:51.21,Default,,0,0,0,,Сіздің қадамыңыз сәйкес болуы керек.
Dialogue: 0,0:16:51.34,0:16:52.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:53.05,0:16:55.63,Default,,0,0,0,,Иә! Мен қазірдің өзінде көп көшіп кеттім!
Dialogue: 0,0:16:56.97,0:16:59.10,Default,,0,0,0,,Жылдамдықты төмендетпей орындай алмайсың.
Dialogue: 0,0:16:59.51,0:17:01.52,Default,,0,0,0,,Бірақ жылдамдықты төмендетпесеңіз
Dialogue: 0,0:17:01.64,0:17:03.56,Default,,0,0,0,,Тежегішті басудың жолы болса ше?
Dialogue: 0,0:17:05.64,0:17:07.44,Default,,0,0,0,,Сәлем! ха ха ха
Dialogue: 0,0:17:07.94,0:17:09.57,Default,,0,0,0,,Әйтеуір, мен асығуым керек.
Dialogue: 0,0:17:11.36,0:17:13.49,Default,,0,0,0,,Әй, жарықшақ болды... Ой!
Dialogue: 0,0:17:14.78,0:17:15.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:17.57,0:17:19.45,Default,,0,0,0,,Егер ол мұны істей алса, ол жасайды
Dialogue: 0,0:17:20.41,0:17:23.29,Default,,0,0,0,,Енді мен ештеңе істей алмаймын, бұл шайтанның иілуі
Dialogue: 0,0:17:23.95,0:17:25.21,Default,,0,0,0,,Бұл сурет
Dialogue: 0,0:17:30.75,0:17:32.05,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:32.92,0:17:33.76,Default,,0,0,0,,Үш ойыншы оны құлатып тастады
Dialogue: 0,0:17:34.47,0:17:36.38,Default,,0,0,0,,Мүлде тежемеген
Dialogue: 0,0:17:37.26,0:17:39.47,Default,,0,0,0,,Жоқ, мен тежедім.
Dialogue: 0,0:17:39.76,0:17:41.35,Default,,0,0,0,,Әйтпесе мен оны тебе алмаймын.
Dialogue: 0,0:17:42.31,0:17:44.02,Default,,0,0,0,,Жылдамдықты төмендетпеңіз
Dialogue: 0,0:17:44.93,0:17:46.44,Default,,0,0,0,,Мен тежегішті бастым.
Dialogue: 0,0:17:47.52,0:17:49.44,Default,,0,0,0,,Ібілістің иілісі?
Dialogue: 0,0:17:57.95,0:18:00.49,Default,,0,0,0,,Хопскот және американдық футбол бірдей.
Dialogue: 0,0:18:05.58,0:18:06.66,Default,,0,0,0,,Темір жол өткеліне дейін
Dialogue: 0,0:18:06.79,0:18:08.37,Default,,0,0,0,,Өйткені мен аяғымды қағып тежеймін
Dialogue: 0,0:18:08.50,0:18:09.83,Default,,0,0,0,,Жылдамдық төмендейді
Dialogue: 0,0:18:10.88,0:18:11.71,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:18:14.92,0:18:16.88,Default,,0,0,0,,Соңғы минутқа дейін жүгіру
Dialogue: 0,0:18:19.80,0:18:20.64,Default,,0,0,0,,Және…
Dialogue: 0,0:18:23.18,0:18:26.10,Default,,0,0,0,,Соңғы қадам, мен кенет қадамымды қысқарттым.
Dialogue: 0,0:18:29.69,0:18:31.23,Default,,0,0,0,,Бірінші қадамды жасаңыз!
Dialogue: 0,0:18:31.52,0:18:32.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:33.94,0:18:35.23,Default,,0,0,0,,Гуджи...
Dialogue: 0,0:18:36.57,0:18:39.91,Default,,0,0,0,,Уф, ол тата...
Dialogue: 0,0:18:40.03,0:18:43.20,Default,,0,0,0,,Тізеңізге пайдалы~ Бұл аяқтың үлкен күшін қажет етеді.
Dialogue: 0,0:18:47.75,0:18:49.75,Default,,0,0,0,,Сіз әлі үйге барасыз ба? (Пантера) О
Dialogue: 0,0:18:50.12,0:18:52.71,Default,,0,0,0,,Мен де жүгіруімнің жетілмегенін байқадым.
Dialogue: 0,0:18:53.00,0:18:55.42,Default,,0,0,0,,Мен Жапонияға оралып, мүмкіндігінше тезірек жаттығуды қалаймын.
Dialogue: 0,0:18:56.13,0:18:57.63,Default,,0,0,0,,Өйткені, қазір мен үшін
Dialogue: 0,0:18:59.76,0:19:02.09,Default,,0,0,0,,Өйткені менде ең жақсы жаттықтырушы бар
Dialogue: 0,0:19:02.89,0:19:04.81,Default,,0,0,0,,20 санын бос қалдырыңыз.
Dialogue: 0,0:19:06.18,0:19:07.52,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:07.64,0:19:08.56,Default,,0,0,0,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:19:09.14,0:19:10.73,Default,,0,0,0,,（）
Dialogue: 0,0:19:11.73,0:19:13.02,Default,,0,0,0,,Әй, Шин!
Dialogue: 0,0:19:13.15,0:19:14.77,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:19:18.44,0:19:21.11,Default,,0,0,0,,Көз қалқаны 21 Сусуму-сан
Dialogue: 0,0:19:21.24,0:19:25.16,Default,,0,0,0,,Келесі жолы кездескенде мен күтпеген жерден жүгіремін.
Dialogue: 0,0:19:27.62,0:19:30.54,Default,,0,0,0,,Биік, мәңгі биік
Dialogue: 0,0:19:32.54,0:19:35.46,Default,,0,0,0,,Жарайды. Егер сіз жаттығу жасасаңыз, сіз жақсы болуыңыз керек.
Dialogue: 0,0:19:35.92,0:19:37.67,Default,,0,0,0,,Өлім маршы осы үшін емес пе?
Dialogue: 0,0:19:39.05,0:19:40.63,Default,,0,0,0,,Финалда күту
Dialogue: 0,0:19:46.72,0:19:48.06,Default,,0,0,0,,Күшті бол!
Dialogue: 0,0:19:53.94,0:19:59.94,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:21:02.80,0:21:08.80,Default,,0,0,0,,~♪
Dialogue: 0,0:21:09.97,0:21:11.72,Default,,0,0,0,,Өлім наурызы
Dialogue: 0,0:21:11.85,0:21:14.27,Default,,0,0,0,,Жақында біреу шығып, шу шығарады деп ойладым.
Dialogue: 0,0:21:14.39,0:21:15.48,Default,,0,0,0,,Әй, ұялма, келші
Dialogue: 0,0:21:15.60,0:21:17.69,Default,,0,0,0,,Біз мұны мәңгі жасай аламыз ба?
Dialogue: 0,0:21:17.81,0:21:19.65,Default,,0,0,0,,Біз Жапонияға қайтамыз!
Dialogue: 0,0:21:19.77,0:21:22.44,Default,,0,0,0,,Әй, үш ағайынды ақыры ажырасып кетті ме?
Dialogue: 0,0:21:23.07,0:21:25.32,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:26.70,0:21:28.53,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:30.03,0:21:36.03,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory