Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.92,0:00:05.00,Default,,0,0,0,,Иә ха!
Dialogue: 0,0:00:05.13,0:00:06.13,Default,,0,0,0,,Америка командасымен
Dialogue: 0,0:00:06.25,0:00:08.80,Default,,0,0,0,,Қарсыластың жапондық өкілін шешу матчты шешу
Dialogue: 0,0:00:08.92,0:00:10.96,Default,,0,0,0,,Екінші жартысында пайда болған Сфинкстің орақ күймесі
Dialogue: 0,0:00:11.09,0:00:12.55,Default,,0,0,0,,Монта қиын уақытты бастан өткерді
Dialogue: 0,0:00:12.67,0:00:15.51,Default,,0,0,0,,Осылай күйзеліске ұшыраған дұрыс па? макс
Dialogue: 0,0:00:15.64,0:00:18.22,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:00:19.22,0:00:20.77,Default,,0,0,0,,Сізден алынған нәрсеге алаңдамаңыз
Dialogue: 0,0:00:20.89,0:00:21.73,Default,,0,0,0,,Мен оны қайтарып аламын.
Dialogue: 0,0:00:25.48,0:00:27.61,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:00:29.40,0:00:31.78,Default,,0,0,0,,Таййо да бонус соққысын жасады ма?
Dialogue: 0,0:00:31.90,0:00:34.82,Default,,0,0,0,,Доймон сияқты адам мықты қарсылас емес.
Dialogue: 0,0:00:36.03,0:00:37.41,Default,,0,0,0,,6 жанасулар
Dialogue: 0,0:00:37.53,0:00:39.83,Default,,0,0,0,,1 бонустық соққымен бірден 7 ұпай
Dialogue: 0,0:00:40.45,0:00:42.20,Default,,0,0,0,,Өйткені біз тепкілей алмаймыз.
Dialogue: 0,0:00:42.33,0:00:44.29,Default,,0,0,0,,Егер бізде бірдей тию саны болса, біз жеңілеміз.
Dialogue: 0,0:00:45.04,0:00:48.21,Default,,0,0,0,,Мен көремін. Мен түссіндім. Деймон - қорлайтын түрі.
Dialogue: 0,0:00:48.33,0:00:49.29,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:49.42,0:00:51.17,Default,,0,0,0,,Сізге ұнайтыны осы емес пе?
Dialogue: 0,0:00:51.59,0:00:52.42,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:52.55,0:00:53.88,Default,,0,0,0,,Егер бұл төмен ұпайлы ойын болса
Dialogue: 0,0:00:54.01,0:00:55.76,Default,,0,0,0,,Біз соққы айырмашылығына байланысты жеңілеміз.
Dialogue: 0,0:00:56.09,0:00:57.68,Default,,0,0,0,,Бірақ егер бұл ұпайлар үшін шайқас болса
Dialogue: 0,0:00:57.80,0:00:58.64,Default,,0,0,0,,Соққы нүктелерінің айырмашылығы
Dialogue: 0,0:00:58.76,0:01:00.18,Default,,0,0,0,,Даундар санымен қамтуға болады
Dialogue: 0,0:01:00.31,0:01:01.14,Default,,0,0,0,,Әрине
Dialogue: 0,0:01:02.52,0:01:05.14,Default,,0,0,0,,Сондықтан сіз тек шабуылға жаттығыңыз ба?
Dialogue: 0,0:01:05.52,0:01:07.77,Default,,0,0,0,,Жеңіске ұмтылатын адамдар бар.
Dialogue: 0,0:01:07.90,0:01:10.15,Default,,0,0,0,,Мен өз басымдылығыма қарай стратегияны таңдаған жоқпын.
Dialogue: 0,0:01:10.77,0:01:12.57,Default,,0,0,0,,Жарайды, соңғы тоқсан.
Dialogue: 0,0:01:12.69,0:01:14.11,Default,,0,0,0,,Шабуыл, шабуыл, шабуыл!
Dialogue: 0,0:01:14.65,0:01:16.11,Default,,0,0,0,,Бір рет алсаң, екі рет ал
Dialogue: 0,0:01:16.24,0:01:17.07,Default,,0,0,0,,Иә
Dialogue: 0,0:01:18.49,0:01:20.70,Default,,0,0,0,,Біздің қолымыздан келетіні осы
Dialogue: 0,0:01:26.92,0:01:27.75,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:01:27.87,0:01:31.13,Default,,0,0,0,,Егер мен бұл шабуылға тосқауыл қоя алсам, не істеймін?
Dialogue: 0,0:01:31.25,0:01:33.71,Default,,0,0,0,,Әйтеуір... Мен мұны қалай да орындаймын.
Dialogue: 0,0:01:34.46,0:01:35.92,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:01:36.05,0:01:42.06,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:49.91,0:02:55.92,Default,,0,0,0,,~♪
Dialogue: 0,0:03:04.14,0:03:05.85,Default,,0,0,0,,12 минут қалды
Dialogue: 0,0:03:05.97,0:03:09.77,Default,,0,0,0,,Заттарды өзгерту үшін сізге кемінде екі сенсор қажет.
Dialogue: 0,0:03:10.02,0:03:11.85,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:03:19.94,0:03:21.11,Default,,0,0,0,,Танк соққысы!
Dialogue: 0,0:03:21.24,0:03:23.32,Default,,0,0,0,,Мукки!
Dialogue: 0,0:03:23.49,0:03:24.99,Default,,0,0,0,,Әй, Монта-кун!
Dialogue: 0,0:03:25.95,0:03:27.95,Default,,0,0,0,,Шишишишиши!
Dialogue: 0,0:03:28.08,0:03:30.79,Default,,0,0,0,,Хуу~! Танк соққысы♪
Dialogue: 0,0:03:30.91,0:03:32.92,Default,,0,0,0,,Сіз қазірдің өзінде аяқтадыңыз.
Dialogue: 0,0:03:33.04,0:03:35.67,Default,,0,0,0,,Хуу~! Танк соққысы♪
Dialogue: 0,0:03:36.21,0:03:39.05,Default,,0,0,0,,Жоқ, мен шабуыл жасай алмаймын.
Dialogue: 0,0:03:39.17,0:03:40.13,Default,,0,0,0,,Фуго…
Dialogue: 0,0:03:41.13,0:03:45.09,Default,,0,0,0,,Бұл ыстықта және бейтаныс жерде Доймон таусылды.
Dialogue: 0,0:03:45.26,0:03:48.10,Default,,0,0,0,,Олардың барлығы шабуылда да, қорғаныста да болады.
Dialogue: 0,0:03:48.64,0:03:50.89,Default,,0,0,0,,Күн ыстыққа үйренген.
Dialogue: 0,0:03:51.31,0:03:52.77,Default,,0,0,0,,Бұлай қашып құтыла алмайсың.
Dialogue: 0,0:03:52.89,0:03:55.06,Default,,0,0,0,,Мен уақытты өлтіре отырып, баяу шабуыл жасаймын.
Dialogue: 0,0:03:55.40,0:03:57.90,Default,,0,0,0,,Тіпті пастың өзі қуатпен тоқтайды! Ха!
Dialogue: 0,0:03:58.02,0:03:59.57,Default,,0,0,0,,Мен түсіндім, сондықтан сабыр етіңіз.
Dialogue: 0,0:03:59.69,0:04:03.07,Default,,0,0,0,,Шишишишиши! Ақымақ болсақ та қолданайық.
Dialogue: 0,0:04:03.20,0:04:06.37,Default,,0,0,0,,Орақ машинасы тек соқпақпен айналысады.
Dialogue: 0,0:04:07.03,0:04:07.99,Default,,0,0,0,,Хуу~!
Dialogue: 0,0:04:11.66,0:04:14.83,Default,,0,0,0,,Па... Қуат әрине жеткіліксіз.
Dialogue: 0,0:04:15.46,0:04:17.71,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:04:21.42,0:04:22.92,Default,,0,0,0,,Танк соққысы!
Dialogue: 0,0:04:23.05,0:04:23.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:25.51,0:04:26.84,Default,,0,0,0,,Танк соққысы!
Dialogue: 0,0:04:26.97,0:04:27.80,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:04:32.48,0:04:33.52,Default,,0,0,0,,О!
Dialogue: 0,0:04:35.10,0:04:37.36,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:04:37.48,0:04:38.61,Default,,0,0,0,,Мен де
Dialogue: 0,0:04:38.73,0:04:39.73,Default,,0,0,0,,Тоқ!
Dialogue: 0,0:04:41.15,0:04:43.65,Default,,0,0,0,,Мен қатты күйзелсем де бар күшімді саламын
Dialogue: 0,0:04:44.32,0:04:45.70,Default,,0,0,0,,Бірдеңе істеу керек
Dialogue: 0,0:04:47.03,0:04:48.37,Default,,0,0,0,,Сіз қанша уақыт ұйықтадыңыз?
Dialogue: 0,0:04:48.49,0:04:50.16,Default,,0,0,0,,Уақыт жоқ, оян.
Dialogue: 0,0:04:50.49,0:04:53.62,Default,,0,0,0,,Неліктен мен шешілмеген пастарды көп рет жасаймын?
Dialogue: 0,0:04:54.33,0:04:57.00,Default,,0,0,0,,Менің ойымша, Монта-кун да өз шегінде.
Dialogue: 0,0:04:59.21,0:05:02.34,Default,,0,0,0,,Өтемін, келесі жолы жаншылып қалмауға тырыс.
Dialogue: 0,0:05:02.67,0:05:06.01,Default,,0,0,0,,Мм... Мен бұлай не айтарымды білмеймін.
Dialogue: 0,0:05:06.76,0:05:09.05,Default,,0,0,0,,Маған рұқсат бермеңіз
Dialogue: 0,0:05:09.43,0:05:12.81,Default,,0,0,0,,Менің ойымша, Сеннаға оны басқаруға рұқсат беру қауіпсіз болар еді.
Dialogue: 0,0:05:14.68,0:05:15.73,Default,,0,0,0,,Монта…
Dialogue: 0,0:05:17.06,0:05:19.44,Default,,0,0,0,,Сізге тек айтқанды орындау керек.
Dialogue: 0,0:05:19.56,0:05:20.82,Default,,0,0,0,,Мен нұсқаулар беремін.
Dialogue: 0,0:05:21.69,0:05:22.61,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:05:23.19,0:05:26.61,Default,,0,0,0,,Құйрығыңды айналдырып, қашқанша, мен қарсы емеспін.
Dialogue: 0,0:05:31.78,0:05:32.62,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:05:32.95,0:05:36.58,Default,,0,0,0,,Хуу~! Танкпен соққымен тікелей жеңіске
Dialogue: 0,0:05:38.67,0:05:39.54,Default,,0,0,0,,(Стефани) Ха! (Сора) Алданып қалдың.
Dialogue: 0,0:05:40.17,0:05:43.00,Default,,0,0,0,,Менің қолымнан келмейтіні, сен маған қанша шабуыл жасасаң да
Dialogue: 0,0:05:43.84,0:05:46.97,Default,,0,0,0,,Сіз жасай алатын жалғыз нәрсе - максималды күшпен өту!
Dialogue: 0,0:05:49.43,0:05:52.43,Default,,0,0,0,,Бар болғаны екі минут қалды, ол қазірдің өзінде.
Dialogue: 0,0:05:52.60,0:05:55.64,Default,,0,0,0,,Соққыланған балшық қақпадан қарсы шабуыл болады ма?
Dialogue: 0,0:05:55.77,0:05:57.02,Default,,0,0,0,,Енді бітті.
Dialogue: 0,0:05:57.14,0:05:58.90,Default,,0,0,0,,Әй, әлі ыстық
Dialogue: 0,0:05:59.60,0:06:00.52,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:06:00.65,0:06:01.65,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:06:01.77,0:06:03.86,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:06:04.32,0:06:05.65,Default,,0,0,0,,Күшпен жеңу керек
Dialogue: 0,0:06:05.78,0:06:06.86,Default,,0,0,0,,Екі адам керек!
Dialogue: 0,0:06:17.16,0:06:19.37,Default,,0,0,0,,Күш белгілері!
Dialogue: 0,0:06:19.79,0:06:21.29,Default,,0,0,0,,Хуу~!
Dialogue: 0,0:06:22.50,0:06:24.09,Default,,0,0,0,,Соққы!
Dialogue: 0,0:06:24.34,0:06:25.21,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:25.34,0:06:26.84,Default,,0,0,0,,Хуу~!
Dialogue: 0,0:06:30.05,0:06:31.64,Default,,0,0,0,,Сенна! (Орақ көлік) Ах!
Dialogue: 0,0:06:32.76,0:06:34.56,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:37.14,0:06:40.02,Default,,0,0,0,,Балшықтан 11 ярдқа жету!
Dialogue: 0,0:06:42.48,0:06:43.98,Default,,0,0,0,,Жарайсыңдар! (Куроки) Ша~!
Dialogue: 0,0:06:47.65,0:06:49.90,Default,,0,0,0,,Бірақ бір минут қана қалды.
Dialogue: 0,0:06:50.15,0:06:52.37,Default,,0,0,0,,2 жанасулар
Dialogue: 0,0:06:52.74,0:06:55.58,Default,,0,0,0,,Танк соққысы Танк соққысы♪
Dialogue: 0,0:06:56.16,0:07:00.25,Default,,0,0,0,,30 ярд жерге дейін, менің заттарды алып жүруге уақытым жоқ.
Dialogue: 0,0:07:02.17,0:07:04.63,Default,,0,0,0,,Қарғыс атқыр маймылға ұзақ жол!
Dialogue: 0,0:07:05.09,0:07:06.88,Default,,0,0,0,,Бір әрекетте қонуға қол жеткізіңіз
Dialogue: 0,0:07:07.00,0:07:08.34,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:07:08.67,0:07:11.22,Default,,0,0,0,,Мен соққыдан толық жеңілдім...
Dialogue: 0,0:07:11.97,0:07:13.22,Default,,0,0,0,,Сіз жеңілесіз бе?
Dialogue: 0,0:07:13.59,0:07:15.56,Default,,0,0,0,,Эй, сен өз ұстанымыңды білесің бе?
Dialogue: 0,0:07:15.97,0:07:16.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:17.47,0:07:18.77,Default,,0,0,0,,Қабылдаушының ойыны
Dialogue: 0,0:07:18.89,0:07:22.56,Default,,0,0,0,,Бұл біздегідей халық тығыз орналасқан аймақта соғысудан басқаша.
Dialogue: 0,0:07:22.69,0:07:24.02,Default,,0,0,0,,Кедергілерді елемеңіз!
Dialogue: 0,0:07:24.15,0:07:25.61,Default,,0,0,0,,Тез далаға жүгір!
Dialogue: 0,0:07:25.94,0:07:26.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:26.90,0:07:29.07,Default,,0,0,0,,Кең дала – сенің бақшаң.
Dialogue: 0,0:07:36.41,0:07:38.62,Default,,0,0,0,,Жоқ? Бірыңғай №80
Dialogue: 0,0:07:43.12,0:07:44.08,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:07:44.21,0:07:48.00,Default,,0,0,0,,Құйрығыңды бұрып қашасың ба? Сіз өзіңіздің бақшаңызды аралайсыз ба?
Dialogue: 0,0:07:48.13,0:07:48.96,Default,,0,0,0,,Қайсы?
Dialogue: 0,0:07:51.72,0:07:52.68,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:53.34,0:07:55.97,Default,,0,0,0,,Хилл мырза болашақ туралы ойлайды.
Dialogue: 0,0:07:56.55,0:07:58.10,Default,,0,0,0,,Деймон жеңіске жету үшін
Dialogue: 0,0:07:58.81,0:08:01.68,Default,,0,0,0,,Монтаны аулау өте қажет.
Dialogue: 0,0:08:02.98,0:08:04.06,Default,,0,0,0,,Сондықтан жеңіліп қалсаңыз да
Dialogue: 0,0:08:06.98,0:08:08.11,Default,,0,0,0,,Жеңілген болса да
Dialogue: 0,0:08:08.61,0:08:10.36,Default,,0,0,0,,Ол пастарды лақтыра берді.
Dialogue: 0,0:08:10.90,0:08:14.32,Default,,0,0,0,,Хуу~! Сіз тағы бір танк соғу үшін осындасыз ба?
Dialogue: 0,0:08:18.08,0:08:19.62,Default,,0,0,0,,Бұл сіздің соңғы мүмкіндігіңіз деп ойлаңыз
Dialogue: 0,0:08:19.74,0:08:22.33,Default,,0,0,0,,Ұзын асудан өту үшін әркімнің күші керек.
Dialogue: 0,0:08:22.46,0:08:23.29,Default,,0,0,0,,О!
Dialogue: 0,0:08:24.75,0:08:27.92,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:08:31.96,0:08:33.01,Default,,0,0,0,,Хонджо мырза...
Dialogue: 0,0:08:34.26,0:08:35.09,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:08:37.47,0:08:41.77,Default,,0,0,0,,Қанша биік, қатты болса да қабырғамен соқтығысудан қорықпайтын спортшы болды.
Dialogue: 0,0:08:47.90,0:08:48.73,Default,,0,0,0,,Уф
Dialogue: 0,0:08:52.49,0:08:56.49,Default,,0,0,0,,Кең алаңға жалғыз өзі үстемдік еткен ойыншы болды.
Dialogue: 0,0:09:00.54,0:09:02.75,Default,,0,0,0,,Шық! Менің бақшамда!
Dialogue: 0,0:09:03.62,0:09:05.58,Default,,0,0,0,,Мен сені тағы да жаншып аламын!
Dialogue: 0,0:09:10.00,0:09:11.80,Default,,0,0,0,,Кең өрісте!
Dialogue: 0,0:09:15.17,0:09:17.89,Default,,0,0,0,,Ұзын өту уақытты алды
Dialogue: 0,0:09:18.05,0:09:19.93,Default,,0,0,0,,Қабырғаға өту Күтіңіз!
Dialogue: 0,0:09:20.26,0:09:23.27,Default,,0,0,0,,Уау~
Dialogue: 0,0:09:25.14,0:09:27.65,Default,,0,0,0,,Жақсы, менде әлі бар.
Dialogue: 0,0:09:27.77,0:09:28.85,Default,,0,0,0,,Сәттілік тілеймін!
Dialogue: 0,0:09:29.19,0:09:30.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:30.98,0:09:32.57,Default,,0,0,0,,Я... жыртылды!
Dialogue: 0,0:09:32.94,0:09:33.69,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:40.07,0:09:42.87,Default,,0,0,0,,Хуу~!
Dialogue: 0,0:09:43.29,0:09:44.83,Default,,0,0,0,,Монта!
Dialogue: 0,0:09:45.12,0:09:47.79,Default,,0,0,0,,О!
Dialogue: 0,0:09:48.29,0:09:50.67,Default,,0,0,0,,Монта!
Dialogue: 0,0:09:51.04,0:09:52.80,Default,,0,0,0,,Хуу~!
Dialogue: 0,0:09:53.13,0:09:56.01,Default,,0,0,0,,Орақпен танк шабуылы!
Dialogue: 0,0:09:56.51,0:09:57.93,Default,,0,0,0,,Гуо!
Dialogue: 0,0:09:59.47,0:10:00.80,Default,,0,0,0,,Монта!
Dialogue: 0,0:10:01.51,0:10:02.68,Default,,0,0,0,,Монта!
Dialogue: 0,0:10:03.14,0:10:06.64,Default,,0,0,0,,Хуу~! Мен мұны ұстай алмаймын
Dialogue: 0,0:10:09.60,0:10:11.65,Default,,0,0,0,,Күштің кесірінен жеңіліп қалсам да бәрібір.
Dialogue: 0,0:10:11.77,0:10:13.77,Default,,0,0,0,,Сенің неге жеңілгенің маған бәрібір.
Dialogue: 0,0:10:14.11,0:10:16.44,Default,,0,0,0,,Бірақ бұл ...
Dialogue: 0,0:10:18.53,0:10:20.95,Default,,0,0,0,,Catch – 3D шайқасы
Dialogue: 0,0:10:21.82,0:10:25.37,Default,,0,0,0,,Жеңістің шешуші факторы биіктік те, жылдамдық та емес.
Dialogue: 0,0:10:29.96,0:10:31.33,Default,,0,0,0,,Тек қағуды жалғастырыңыз
Dialogue: 0,0:10:31.96,0:10:34.00,Default,,0,0,0,,Бұл қарапайым, бірақ бұл жалғыз
Dialogue: 0,0:10:36.01,0:10:38.63,Default,,0,0,0,,Тек жылдар бойы жинақталған тәжірибе көлемі
Dialogue: 0,0:10:40.18,0:10:42.76,Default,,0,0,0,,Ұстау құдайы күледі
Dialogue: 0,0:10:45.10,0:10:46.27,Default,,0,0,0,,Хуу~!
Dialogue: 0,0:10:48.27,0:10:49.10,Default,,0,0,0,,​​О?
Dialogue: 0,0:10:52.15,0:10:53.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.15,0:11:00.99,Default,,0,0,0,,Монта?
Dialogue: 0,0:11:01.53,0:11:02.37,Default,,0,0,0,,Сіз оны алдыңыз ба?
Dialogue: 0,0:11:02.78,0:11:03.62,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:11:07.62,0:11:09.54,Default,,0,0,0,,Қарсылас қанша үлкен болса да
Dialogue: 0,0:11:10.37,0:11:12.46,Default,,0,0,0,,Қарсыласыңыз қаншалықты жылдам болса да
Dialogue: 0,0:11:13.67,0:11:15.46,Default,,0,0,0,,Жоғалтпайтын жалғыз нәрсе - аулау.
Dialogue: 0,0:11:16.59,0:11:18.38,Default,,0,0,0,,Бұл түсінікті.
Dialogue: 0,0:11:19.63,0:11:21.97,Default,,0,0,0,,Мен не істеуім керек
Dialogue: 0,0:11:23.05,0:11:26.72,Default,,0,0,0,,Бұдан былай бүкіл Жапонияда, жоқ, дүние жүзіндегі барлық Бакс.
Dialogue: 0,0:11:26.85,0:11:28.39,Default,,0,0,0,,Мен ұстау арқылы жеңемін!
Dialogue: 0,0:11:28.81,0:11:30.81,Default,,0,0,0,,Иә! Керемет Монта!
Dialogue: 0,0:11:30.94,0:11:32.31,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:11:32.44,0:11:35.82,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:36.69,0:11:39.78,Default,,0,0,0,,Ойын уақыты: 35 секунд қалды, 2 ұпай айырмашылығы, 20-18
Dialogue: 0,0:11:39.90,0:11:42.74,Default,,0,0,0,,Фуну~ Бірдеңе істе~!
Dialogue: 0,0:11:43.11,0:11:45.37,Default,,0,0,0,,Не...не?
Dialogue: 0,0:11:45.62,0:11:47.12,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:11:47.45,0:11:49.70,Default,,0,0,0,,Жоқ, бұл бірбеткейлік
Dialogue: 0,0:11:50.96,0:11:54.71,Default,,0,0,0,,Допты бірбеткей, адал ұстауға тырысу
Dialogue: 0,0:11:55.63,0:11:59.17,Default,,0,0,0,,Мүмкін бізге жетіспейтін нәрсе осы шығар.
Dialogue: 0,0:12:01.80,0:12:05.55,Default,,0,0,0,,Супер ұстау белгілері!
Dialogue: 0,0:12:05.68,0:12:06.85,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:12:07.05,0:12:09.35,Default,,0,0,0,,Өйткені, мен сол позаны орындаймын.
Dialogue: 0,0:12:09.47,0:12:10.60,Default,,0,0,0,,Мен мұны істеуім керек.
Dialogue: 0,0:12:10.72,0:12:12.14,Default,,0,0,0,,Керемет болса да
Dialogue: 0,0:12:12.27,0:12:13.14,Default,,0,0,0,,Ah~ah
Dialogue: 0,0:12:13.56,0:12:17.19,Default,,0,0,0,,Керемет! Жақсы аулау!
Dialogue: 0,0:12:18.27,0:12:19.11,Default,,0,0,0,,Мамори-сан!
Dialogue: 0,0:12:20.82,0:12:22.82,Default,,0,0,0,,Уәде еткендей, мен абыройымды қайтарамын! Жоқ, керісінше
Dialogue: 0,0:12:22.95,0:12:24.45,Default,,0,0,0,,Сіз стигмадан қалай арыласыз?
Dialogue: 0,0:12:26.82,0:12:28.74,Default,,0,0,0,,Мен өз абыройымды қайтарамын!
Dialogue: 0,0:12:29.03,0:12:32.08,Default,,0,0,0,,А-а... Көп сұрағаным үшін кешіріңіз.
Dialogue: 0,0:12:33.62,0:12:36.08,Default,,0,0,0,,Стигманы қайтару немесе беделді қалпына келтіру
Dialogue: 0,0:12:36.67,0:12:39.67,Default,,0,0,0,,Әлгі маймылға адам тілін біреу үйретеді.
Dialogue: 0,0:12:39.92,0:12:41.59,Default,,0,0,0,,Қайтадан суытыңыз
Dialogue: 0,0:12:42.47,0:12:45.43,Default,,0,0,0,,Ал, келесі күннің шабуылы.
Dialogue: 0,0:12:45.55,0:12:47.55,Default,,0,0,0,,Huh~ Қауіпті Қауіпті
Dialogue: 0,0:12:47.89,0:12:51.06,Default,,0,0,0,,Деймон Жапонияның өкілі бола жаздады.
Dialogue: 0,0:12:51.18,0:12:52.02,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:52.27,0:12:55.35,Default,,0,0,0,,Деймонның бонустық ойыны әлі қалды.
Dialogue: 0,0:12:56.27,0:12:59.82,Default,,0,0,0,,Қақпаның алдындағы 3 ярдтан соққы немесе жанасу
Dialogue: 0,0:13:00.19,0:13:02.74,Default,,0,0,0,,соққы үшін 1 ұпай, доп үшін 2 ұпай
Dialogue: 0,0:13:04.99,0:13:07.78,Default,,0,0,0,,2 ұпай айырмашылығы бар. Ол тепкілеп кірсе де, бәрібір ұтыласың.
Dialogue: 0,0:13:08.24,0:13:10.53,Default,,0,0,0,,Есепті теңестіру үшін татуға ұмтылу.
Dialogue: 0,0:13:10.91,0:13:13.00,Default,,0,0,0,,Мақсаттың алдында айлалар жұмыс істемейді.
Dialogue: 0,0:13:13.12,0:13:15.29,Default,,0,0,0,,Барлығымыз ортаға асығайық.
Dialogue: 0,0:13:17.67,0:13:21.59,Default,,0,0,0,,Соңғы аймаққа небәрі 2,7 метр қалды, күшпен итеріңіз!
Dialogue: 0,0:13:22.05,0:13:22.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:25.55,0:13:28.80,Default,,0,0,0,,Сіз пирамида сызығына бетпе-бет жүгіресіз бе?
Dialogue: 0,0:13:29.55,0:13:31.14,Default,,0,0,0,,Күш бәсекесі болмасын.
Dialogue: 0,0:13:31.56,0:13:33.14,Default,,0,0,0,,Жолды екі еселендіріңіз
Dialogue: 0,0:13:33.27,0:13:35.77,Default,,0,0,0,,Жақсы ма? Мен сені ештеңеге қарамастан қорғай аламын
Dialogue: 0,0:13:36.64,0:13:39.40,Default,,0,0,0,,Орақ машина, сені де қатарға қой
Dialogue: 0,0:13:40.06,0:13:41.77,Default,,0,0,0,,Хуу~! Түсінді
Dialogue: 0,0:13:43.15,0:13:44.57,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:47.11,0:13:49.03,Default,,0,0,0,,Жолдар саны артып келеді!
Dialogue: 0,0:13:49.16,0:13:51.74,Default,,0,0,0,,Әдетте 4 немесе 5 адам болады, бірақ 9 адам болды.
Dialogue: 0,0:13:51.87,0:13:54.58,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:56.25,0:13:57.71,Default,,0,0,0,,Ашуланбаңыз!
Dialogue: 0,0:13:58.42,0:14:00.88,Default,,0,0,0,,Қуатты орталыққа шоғырландыру
Dialogue: 0,0:14:01.09,0:14:02.63,Default,,0,0,0,,Осы бір пьеса бәрін шешеді
Dialogue: 0,0:14:04.92,0:14:06.59,Default,,0,0,0,,Барлығына қарсы (қарсы).
Dialogue: 0,0:14:09.64,0:14:10.59,Default,,0,0,0,,Бұл күш ойыны
Dialogue: 0,0:14:11.01,0:14:12.72,Default,,0,0,0,,Тоқта! (Көрермендер) Күн сфинкс!
Dialogue: 0,0:14:12.85,0:14:14.97,Default,,0,0,0,,Егер сіз мұны тоқтатсаңыз, сіз жеңесіз!
Dialogue: 0,0:14:15.60,0:14:16.85,Default,,0,0,0,,Шешіңіз!
Dialogue: 0,0:14:16.98,0:14:18.81,Default,,0,0,0,,Furefre! Деймон Ібіліс жарғанақтар!
Dialogue: 0,0:14:24.23,0:14:25.07,Default,,0,0,0,,Өйткені
Dialogue: 0,0:14:26.40,0:14:29.03,Default,,0,0,0,,Шайқастың соңы билікке не әсер етеді?
Dialogue: 0,0:14:29.36,0:14:33.03,Default,,0,0,0,,Өзіңізге сенімді болыңыз! Таййо желісі Жапониядағы ең ауыр.
Dialogue: 0,0:14:33.41,0:14:35.79,Default,,0,0,0,,Пирамида сызығының күшін көрсет!
Dialogue: 0,0:14:35.91,0:14:37.16,Default,,0,0,0,,Ra!
Dialogue: 0,0:14:38.41,0:14:40.29,Default,,0,0,0,,Доп сізде болуы керек.
Dialogue: 0,0:14:40.67,0:14:42.84,Default,,0,0,0,,Мен әрқашан шетке шығуға тырысамын.
Dialogue: 0,0:14:42.96,0:14:44.04,Default,,0,0,0,,Бұл туралы ойламаңыз
Dialogue: 0,0:14:44.71,0:14:45.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:46.34,0:14:48.72,Default,,0,0,0,,Егер сіз жалтарсаңыз немесе сәл болса да тартынсаңыз
Dialogue: 0,0:14:49.09,0:14:51.59,Default,,0,0,0,,Шабуылдың күші жойылады.
Dialogue: 0,0:14:51.72,0:14:53.93,Default,,0,0,0,,Мүмкіндігінше тіке итеріңіз
Dialogue: 0,0:14:54.43,0:14:56.68,Default,,0,0,0,,Тура? Шығу керек пе?
Dialogue: 0,0:15:01.85,0:15:05.19,Default,,0,0,0,,Бұл мүмкін емес, өлшемдері тым әртүрлі.
Dialogue: 0,0:15:05.40,0:15:07.15,Default,,0,0,0,,21 Иә?
Dialogue: 0,0:15:08.07,0:15:13.12,Default,,0,0,0,,Егер Айсшилд 21-дің 21-і тек алға қараса, ол міндетті түрде жеңеді.
Dialogue: 0,0:15:13.62,0:15:15.70,Default,,0,0,0,,21 асыға күтесіз бе?
Dialogue: 0,0:15:16.41,0:15:17.54,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:19.96,0:15:21.29,Default,,0,0,0,,21...
Dialogue: 0,0:15:22.17,0:15:24.67,Default,,0,0,0,,21 асыға күтесіз бе?
Dialogue: 0,0:15:25.71,0:15:28.51,Default,,0,0,0,,Жер бетінде не... бұл нені білдіреді?
Dialogue: 0,0:15:34.43,0:15:36.47,Default,,0,0,0,,Барлығы керемет
Dialogue: 0,0:15:36.81,0:15:38.18,Default,,0,0,0,,Фуго? Мастер?
Dialogue: 0,0:15:39.39,0:15:43.19,Default,,0,0,0,,Күнмен шындап бәсекеге түсемін деп ешқашан ойламаппын.
Dialogue: 0,0:15:43.69,0:15:47.15,Default,,0,0,0,,Енді мен балшық қақпасында жалғыз емеспін.
Dialogue: 0,0:15:47.52,0:15:49.69,Default,,0,0,0,,Бізде бес лайнер бар.
Dialogue: 0,0:15:49.82,0:15:51.53,Default,,0,0,0,,Қалпақ киіңіз!
Dialogue: 0,0:15:51.90,0:15:54.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:56.20,0:15:58.33,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:16:08.42,0:16:09.30,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:16:09.71,0:16:11.84,Default,,0,0,0,,Жалғыз күш жағынан сен менен күштісің.
Dialogue: 0,0:16:12.22,0:16:14.09,Default,,0,0,0,,Курита-кун итеріп жатыр!
Dialogue: 0,0:16:14.22,0:16:15.30,Default,,0,0,0,,3 ярд итеріңіз!
Dialogue: 0,0:16:22.14,0:16:24.94,Default,,0,0,0,,Егер сіз жалтарсаңыз немесе сәл болса да тартынсаңыз
Dialogue: 0,0:16:25.06,0:16:27.31,Default,,0,0,0,,Шабуылдың күші жойылады.
Dialogue: 0,0:16:27.98,0:16:30.36,Default,,0,0,0,,Мүмкіндігінше тіке итеріңіз
Dialogue: 0,0:16:31.28,0:16:34.78,Default,,0,0,0,,21 тек алға қараса, ол міндетті түрде жеңеді.
Dialogue: 0,0:16:39.20,0:16:40.74,Default,,0,0,0,,Пирамида сызығы
Dialogue: 0,0:16:41.54,0:16:43.21,Default,,0,0,0,,Оны жалама!
Dialogue: 0,0:16:43.75,0:16:46.21,Default,,0,0,0,,Әй! (Касаматсу) Шишишишиши!
Dialogue: 0,0:16:52.30,0:16:53.42,Default,,0,0,0,,Тоқтатылды!
Dialogue: 0,0:16:53.72,0:16:54.63,Default,,0,0,0,,Жай ғана?
Dialogue: 0,0:16:54.80,0:16:56.09,Default,,0,0,0,,Бұл енді мүмкін емес пе?
Dialogue: 0,0:16:57.85,0:16:59.93,Default,,0,0,0,,Жоқ, бұл тамаша.
Dialogue: 0,0:17:03.10,0:17:03.93,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:05.06,0:17:09.23,Default,,0,0,0,,Екі иықтағы 21 саны алға қарап тұруы керек.
Dialogue: 0,0:17:09.90,0:17:11.78,Default,,0,0,0,,Допты мықтап ұстау
Dialogue: 0,0:17:12.82,0:17:16.41,Default,,0,0,0,,Еш ойланбаңыз және оны тікелей зарядтаңыз!
Dialogue: 0,0:17:18.16,0:17:20.33,Default,,0,0,0,,Сіздің аяқтарыңыз жақсы
Dialogue: 0,0:17:24.46,0:17:25.83,Default,,0,0,0,,Қабырға бітелген
Dialogue: 0,0:17:28.04,0:17:30.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:30.54,0:17:33.09,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:34.80,0:17:36.13,Default,,0,0,0,,Жоқ, адаспаңыз.
Dialogue: 0,0:17:36.26,0:17:39.09,Default,,0,0,0,,Тек майдан... Тек майдан!
Dialogue: 0,0:17:40.76,0:17:41.68,Default,,0,0,0,,Ұш!
Dialogue: 0,0:17:43.77,0:17:45.06,Default,,0,0,0,,Я- ха-!
Dialogue: 0,0:17:49.06,0:17:50.23,Default,,0,0,0,,Ах (Курита) Уау!
Dialogue: 0,0:17:51.65,0:17:53.07,Default,,0,0,0,,О!
Dialogue: 0,0:17:57.45,0:17:59.24,Default,,0,0,0,,Секір!
Dialogue: 0,0:18:04.24,0:18:05.50,Default,,0,0,0,,Бамбаны жарып жіберіңіз!
Dialogue: 0,0:18:08.08,0:18:09.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:17.80,0:18:19.59,Default,,0,0,0,,Ібіліс жарғанатының сүңгуі
Dialogue: 0,0:18:19.93,0:18:21.18,Default,,0,0,0,,
Dialogue: 0,0:18:21.30,0:18:22.72,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:18:24.89,0:18:26.18,Default,,0,0,0,,
Dialogue: 0,0:18:26.31,0:18:28.02,Default,,0,0,0,,Ойын аяқталды!
Dialogue: 0,0:18:28.23,0:18:30.56,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:31.31,0:18:34.48,Default,,0,0,0,,Тең ойынға қуанған дұрыс емес пе?
Dialogue: 0,0:18:34.61,0:18:37.82,Default,,0,0,0,,Бұл табиғи нәрсе, өйткені біз осындай командадан жеңіліп қалдық.
Dialogue: 0,0:18:41.16,0:18:43.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:46.16,0:18:52.17,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:19:53.19,0:19:59.19,Default,,0,0,0,,~♪
Dialogue: 0,0:20:01.99,0:20:03.28,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:20:03.41,0:20:05.70,Default,,0,0,0,,Ібіліс жарғанаттарының Жапония өкілі шешті
Dialogue: 0,0:20:06.16,0:20:08.91,Default,,0,0,0,,Иә, Сена? Сен немен тығылып жүрсің?
Dialogue: 0,0:20:09.20,0:20:11.71,Default,,0,0,0,,Мен біраздан бері біреу мені бақылап тұрғандай сезіндім...
Dialogue: 0,0:20:11.91,0:20:13.75,Default,,0,0,0,,Сіз шпионсыз ба?
Dialogue: 0,0:20:14.08,0:20:15.92,Default,,0,0,0,,Уа, ана жақта күдікті көлеңке бар!
Dialogue: 0,0:20:16.38,0:20:18.21,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:20:20.17,0:20:21.01,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:20:22.51,0:20:28.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
