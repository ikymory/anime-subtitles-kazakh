Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.33,0:00:04.33,Default,,0,0,0,,Ауыстыру!
Dialogue: 0,0:00:04.62,0:00:07.38,Default,,0,0,0,,Менің стратегиямды орындай алмайтын адам маған керек емес!
Dialogue: 0,0:00:07.75,0:00:08.75,Default,,0,0,0,,Маған
Dialogue: 0,0:00:08.88,0:00:12.72,Default,,0,0,0,,Маған Eyeshield-ті басу үшін бірінші және соңғы мүмкіндік беріңізші!
Dialogue: 0,0:00:13.59,0:00:16.43,Default,,0,0,0,,Егер мен Eyeshield-ді баса алмасам
Dialogue: 0,0:00:17.72,0:00:18.97,Default,,0,0,0,,Мен командадан шығамын!
Dialogue: 0,0:00:22.10,0:00:25.23,Default,,0,0,0,,Сіздің енді мүмкіндігіңіз жоқ...
Dialogue: 0,0:00:27.48,0:00:29.36,Default,,0,0,0,,Не... қандай еліктеу!
Dialogue: 0,0:00:30.48,0:00:31.90,Default,,0,0,0,,Біз де сізден көмек сұраймыз.
Dialogue: 0,0:00:32.49,0:00:34.03,Default,,0,0,0,,Пантераны шығарыңыз.
Dialogue: 0,0:00:34.24,0:00:36.28,Default,,0,0,0,,Бізге команда ретінде сеніңіз.
Dialogue: 0,0:00:36.41,0:00:37.24,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:00:37.45,0:00:38.66,Default,,0,0,0,,Өтінемін! (Гомер) Маған мүмкіндік беріңізші.
Dialogue: 0,0:00:38.78,0:00:40.33,Default,,0,0,0,,Пантераны шығарыңыз!
Dialogue: 0,0:00:40.79,0:00:41.87,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:44.00,0:00:46.29,Default,,0,0,0,,Бұл сәйкестік... барлығы.
Dialogue: 0,0:00:49.67,0:00:51.50,Default,,0,0,0,,Eyeshield қолданбасын кез келген шығынмен басу
Dialogue: 0,0:00:52.13,0:00:53.92,Default,,0,0,0,,Тек осыны істеу керек!
Dialogue: 0,0:00:54.59,0:00:55.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:55.55,0:00:56.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:57.01,0:00:58.76,Default,,0,0,0,,Мунсаультты қалыптастыру
Dialogue: 0,0:00:58.89,0:01:01.39,Default,,0,0,0,,Айдай еркін жүгір, Пантера!
Dialogue: 0,0:01:03.68,0:01:05.73,Default,,0,0,0,,Айдың формациясы?
Dialogue: 0,0:01:06.02,0:01:12.03,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:19.88,0:02:25.89,Default,,0,0,0,,~♪
Dialogue: 0,0:02:32.65,0:02:34.86,Default,,0,0,0,,Деймон 26-21 басқарады
Dialogue: 0,0:02:35.40,0:02:37.82,Default,,0,0,0,,Шетелдіктерге оралу болады ма?
Dialogue: 0,0:02:37.94,0:02:40.61,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:40.91,0:02:42.57,Default,,0,0,0,,О! (Кумабукуро) Бұл не?
Dialogue: 0,0:02:48.16,0:02:49.91,Default,,0,0,0,,Бұл қандай ақша?
Dialogue: 0,0:02:50.04,0:02:52.58,Default,,0,0,0,,Бұл айдың формациясы ма?
Dialogue: 0,0:02:52.71,0:02:54.88,Default,,0,0,0,,Эй, сен олай ойламадың.
Dialogue: 0,0:02:55.84,0:02:57.17,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:02:57.71,0:03:00.88,Default,,0,0,0,,Сіз пантераны тордан жабайы табиғатқа жібергіңіз келе ме?
Dialogue: 0,0:03:02.64,0:03:04.35,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:03:04.47,0:03:07.22,Default,,0,0,0,,Енді матч Деймондағы басталудан басталады.
Dialogue: 0,0:03:13.06,0:03:14.98,Default,,0,0,0,,Бұл пантера, тоқтат!
Dialogue: 0,0:03:15.11,0:03:16.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:17.82,0:03:19.03,Default,,0,0,0,,Мукки!
Dialogue: 0,0:03:21.11,0:03:23.41,Default,,0,0,0,,Фуго Фуго... (Курита) Комусуби-кун, мен оны тоқтатамын!
Dialogue: 0,0:03:23.66,0:03:25.62,Default,,0,0,0,,Жүр, Пантера!
Dialogue: 0,0:03:25.74,0:03:27.62,Default,,0,0,0,,Маған аяғыңызды көрсетіңіз
Dialogue: 0,0:03:30.41,0:03:31.50,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:03:37.34,0:03:39.21,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:03:45.35,0:03:46.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:53.35,0:03:56.65,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:56.77,0:03:57.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:00.11,0:04:02.32,Default,,0,0,0,,Мен тура кесіп өттім!
Dialogue: 0,0:04:02.65,0:04:04.66,Default,,0,0,0,,Не... сен кімсің?
Dialogue: 0,0:04:04.78,0:04:05.62,Default,,0,0,0,,Who?
Dialogue: 0,0:04:05.74,0:04:07.28,Default,,0,0,0,,А... мүлде жазба жоқ.
Dialogue: 0,0:04:12.08,0:04:14.42,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:04:21.55,0:04:22.59,Default,,0,0,0,,Ха? (Джумонджи) Иә?
Dialogue: 0,0:04:22.72,0:04:23.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:24.01,0:04:25.93,Default,,0,0,0,,Қандай жеңіл қадам!
Dialogue: 0,0:04:26.05,0:04:27.97,Default,,0,0,0,,А, материалдар енді келді.
Dialogue: 0,0:04:28.10,0:04:32.23,Default,,0,0,0,,Оның аты Пантера, салмақсыз аяқты адам.
Dialogue: 0,0:04:32.48,0:04:33.69,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:33.81,0:04:35.52,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:04:39.15,0:04:40.69,Default,,0,0,0,,Тек ешкім емес!
Dialogue: 0,0:04:40.82,0:04:42.65,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:43.53,0:04:45.15,Default,,0,0,0,,Қараңызшы, әже.
Dialogue: 0,0:04:45.53,0:04:46.36,Default,,0,0,0,,немесе мүсіндердің өрнектері мен материалдарын зерттейтінмін,
Dialogue: 0,0:04:46.49,0:04:49.24,Default,,0,0,0,,Шетелдіктердің формасын киіп, алаңда жүгіру
Dialogue: 0,0:04:49.66,0:04:52.12,Default,,0,0,0,,Тоқта, Көз қалқаны 21!
Dialogue: 0,0:04:52.25,0:04:54.29,Default,,0,0,0,,Теми - сіздің соңғы қорғаныс шебіңіз!
Dialogue: 0,0:04:55.96,0:04:58.17,Default,,0,0,0,,Кел, Айсшилд 21!
Dialogue: 0,0:04:58.29,0:04:59.71,Default,,0,0,0,,Кеттік, Пантера!
Dialogue: 0,0:05:02.05,0:05:03.13,Default,,0,0,0,,(Иносукэ) Һм! (Танжиро) Уф…
Dialogue: 0,0:05:03.34,0:05:06.09,Default,,0,0,0,,Айсшилд 21 жарылғыш үдеуі!
Dialogue: 0,0:05:07.93,0:05:10.18,Default,,0,0,0,,Бұл жалғыз жүгіруден ерекшеленеді.
Dialogue: 0,0:05:11.60,0:05:14.10,Default,,0,0,0,,Мені талқандаймын деп шапқан күшті жау бар.
Dialogue: 0,0:05:14.60,0:05:17.10,Default,,0,0,0,,Бұл американдық футбол!
Dialogue: 0,0:05:18.90,0:05:21.90,Default,,0,0,0,,Мен американдық футбол ойнаймын!
Dialogue: 0,0:05:25.03,0:05:25.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:33.49,0:05:35.91,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:05:36.50,0:05:38.17,Default,,0,0,0,,Бар жылдамдықпен қуып келе жатқан жау
Dialogue: 0,0:05:38.71,0:05:42.00,Default,,0,0,0,,Сізді өзіңізден ажырататын сол үмітсіздік сезімі
Dialogue: 0,0:05:42.13,0:05:44.13,Default,,0,0,0,,
Dialogue: 0,0:05:44.26,0:05:45.97,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:05:46.88,0:05:52.64,Default,,0,0,0,,(Сенаның ауыр тыныс алуы)
Dialogue: 0,0:05:52.89,0:05:55.68,Default,,0,0,0,,С... Мен сені қуып жететін сияқтымын, Сена.
Dialogue: 0,0:05:55.81,0:05:58.14,Default,,0,0,0,,Қандай... аяқтарың қандай?
Dialogue: 0,0:05:58.27,0:05:59.10,Default,,0,0,0,,Тс!
Dialogue: 0,0:06:00.86,0:06:02.07,Default,,0,0,0,,Бұл сөзсіз.
Dialogue: 0,0:06:03.02,0:06:06.69,Default,,0,0,0,,Айсшилд 21 максималды жылдамдыққа бір сәтке ғана жетеді.
Dialogue: 0,0:06:07.78,0:06:09.32,Default,,0,0,0,,Екінші жағынан, сол адам
Dialogue: 0,0:06:09.45,0:06:12.03,Default,,0,0,0,,Жеңіл қадамдармен жаудан жалтарып бара жатқанда, салмақсыз сезіну
Dialogue: 0,0:06:13.03,0:06:15.16,Default,,0,0,0,,Ең жоғары жылдамдықты сақтауды жалғастырды
Dialogue: 0,0:06:16.04,0:06:17.62,Default,,0,0,0,,Ұпайлардың сәтсіздігін анықтап көріңіз
Dialogue: 0,0:06:17.75,0:06:19.83,Default,,0,0,0,,Бірақ шетелдіктер керісінше!
Dialogue: 0,0:06:19.96,0:06:21.79,Default,,0,0,0,,Бұл физикалық қабілеттің айырмашылығы
Dialogue: 0,0:06:22.54,0:06:24.84,Default,,0,0,0,,Бұл туа біткен талант.
Dialogue: 0,0:06:25.63,0:06:27.63,Default,,0,0,0,,Ол тумысынан спринтер
Dialogue: 0,0:06:29.09,0:06:31.84,Default,,0,0,0,,Мен тумысынан спринтермін
Dialogue: 0,0:06:32.47,0:06:34.93,Default,,0,0,0,,Кім келсе де жеңілмеймін.
Dialogue: 0,0:06:35.47,0:06:38.60,Default,,0,0,0,,Мен сізді аяймын, бірақ басқа ойыншылар жоқ.
Dialogue: 0,0:06:38.73,0:06:40.94,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:06:43.19,0:06:44.11,Default,,0,0,0,,Мен пантерамын
Dialogue: 0,0:06:44.23,0:06:46.90,Default,,0,0,0,,Сол себепті пайдаланбадың ба?
Dialogue: 0,0:06:48.15,0:06:49.61,Default,,0,0,0,,Ол тек бір рет
Dialogue: 0,0:06:49.74,0:06:52.24,Default,,0,0,0,,Менің нұсқауларымды орындамағаныңыз үшін.
Dialogue: 0,0:06:52.49,0:06:54.12,Default,,0,0,0,,Бұл жай ғана сылтау ма?
Dialogue: 0,0:06:55.45,0:06:57.20,Default,,0,0,0,,Ол Морган сияқты.
Dialogue: 0,0:06:57.33,0:06:59.50,Default,,0,0,0,,Табиғи жүйрік болу
Dialogue: 0,0:07:00.04,0:07:02.33,Default,,0,0,0,,Мен оны терең жек көргендіктен бе?
Dialogue: 0,0:07:02.58,0:07:05.17,Default,,0,0,0,,О, енді қайталау бар.
Dialogue: 0,0:07:05.29,0:07:07.05,Default,,0,0,0,,Міне.
Dialogue: 0,0:07:07.17,0:07:09.05,Default,,0,0,0,,Комусуби-кун мені тоқтатуға бірінші барды.
Dialogue: 0,0:07:09.42,0:07:12.01,Default,,0,0,0,,Минималды кесумен бірқалыпты айналып өтіңіз
Dialogue: 0,0:07:12.14,0:07:13.80,Default,,0,0,0,,Келесі, Курита-кун да.
Dialogue: 0,0:07:13.93,0:07:15.89,Default,,0,0,0,,Сонымен бір сәтке екі адамның денесінің ішінде
Dialogue: 0,0:07:16.01,0:07:17.39,Default,,0,0,0,,Сырттан өтіп кеткендей болды.
Dialogue: 0,0:07:17.64,0:07:19.18,Default,,0,0,0,,Оның жүгіруі болды
Dialogue: 0,0:07:19.31,0:07:20.85,Default,,0,0,0,,Eyeshield-kun ненің қаһарлы жүгірісі?
Dialogue: 0,0:07:20.98,0:07:23.56,Default,,0,0,0,,Олар мүлдем қарама-қарсы деп айтуға болады.
Dialogue: 0,0:07:24.19,0:07:27.15,Default,,0,0,0,,1 ұпай айырмашылығы... 9 минут қалды
Dialogue: 0,0:07:27.86,0:07:29.82,Default,,0,0,0,,Шайқас осы жерден басталады
Dialogue: 0,0:07:29.94,0:07:30.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:30.90,0:07:33.57,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:07:37.20,0:07:38.62,Default,,0,0,0,,Тазарыңыз!
Dialogue: 0,0:07:40.91,0:07:42.00,Default,,0,0,0,,Ах! (Куроки) О!
Dialogue: 0,0:07:42.75,0:07:43.88,Default,,0,0,0,,Е...
Dialogue: 0,0:07:44.46,0:07:46.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:47.46,0:07:48.92,Default,,0,0,0,,Пантера-кун, мен оны тоқтаттым!
Dialogue: 0,0:07:49.17,0:07:52.26,Default,,0,0,0,,Ібіліс жарғанаттарының сыпыруы бұзылды!
Dialogue: 0,0:07:52.51,0:07:54.93,Default,,0,0,0,,Пантераның қорғанысы да керемет.
Dialogue: 0,0:07:55.05,0:07:56.39,Default,,0,0,0,,Жылдам және жалтару мүмкін емес
Dialogue: 0,0:07:59.64,0:08:02.81,Default,,0,0,0,,Тыңдаңыздар, мәселе бөгде планетаның шабуылында.
Dialogue: 0,0:08:02.94,0:08:05.06,Default,,0,0,0,,Шаттл жолдары енді жалғыз жау емес.
Dialogue: 0,0:08:05.31,0:08:08.90,Default,,0,0,0,,Шаттл асуы және пантера жүгірісі?
Dialogue: 0,0:08:09.40,0:08:10.49,Default,,0,0,0,,Мен қайсысын қорғауым керек?
Dialogue: 0,0:08:10.61,0:08:12.15,Default,,0,0,0,,Бұл шешілді!
Dialogue: 0,0:08:12.28,0:08:14.49,Default,,0,0,0,,Екеуін де қорғаңыз! Эй жақсы!
Dialogue: 0,0:08:14.78,0:08:15.82,Default,,0,0,0,,Фуннураба!
Dialogue: 0,0:08:18.87,0:08:20.66,Default,,0,0,0,,Шаттл билеті сәтті өтті!
Dialogue: 0,0:08:20.79,0:08:22.75,Default,,0,0,0,,Шетелдіктер 20 ярдқа жетеді!
Dialogue: 0,0:08:23.16,0:08:24.00,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:08:24.12,0:08:27.21,Default,,0,0,0,,Пантераның жүгіруі асуға зейін қоюды қиындатады.
Dialogue: 0,0:08:35.05,0:08:35.89,Default,,0,0,0,,Ой, міне келдік!
Dialogue: 0,0:08:36.01,0:08:38.30,Default,,0,0,0,,Пантера-кун, орталықты жебедей жарып өт!
Dialogue: 0,0:08:44.31,0:08:46.48,Default,,0,0,0,,Бұл жеке жекпе-жек!
Dialogue: 0,0:08:53.99,0:08:54.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:57.53,0:08:58.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:02.83,0:09:04.62,Default,,0,0,0,,
Dialogue: 0,0:09:04.75,0:09:06.62,Default,,0,0,0,,Пантера-кунның соққысы!
Dialogue: 0,0:09:06.75,0:09:08.42,Default,,0,0,0,,Көз қалқаны жеңілді!
Dialogue: 0,0:09:08.63,0:09:11.63,Default,,0,0,0,,NASA шетелдіктер 7 ұпаймен алда!
Dialogue: 0,0:09:12.17,0:09:14.09,Default,,0,0,0,,Мен ұпай жинауды тоқтаттым, бірақ
Dialogue: 0,0:09:15.01,0:09:16.13,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:09:16.43,0:09:18.72,Default,,0,0,0,,Мен сенімен күрескім келеді, Пантера.
Dialogue: 0,0:09:21.06,0:09:23.77,Default,,0,0,0,,Қамшы тәрізді серпімді бұлшықеттер шығарады
Dialogue: 0,0:09:23.89,0:09:25.73,Default,,0,0,0,,Нөлдік ауырлықта жүгіру
Dialogue: 0,0:09:25.94,0:09:29.06,Default,,0,0,0,,Сені ешкім тоқтата алмайды ма, Пантера?
Dialogue: 0,0:09:32.11,0:09:35.40,Default,,0,0,0,,Пантера Пантера…
Dialogue: 0,0:09:35.53,0:09:38.82,Default,,0,0,0,,Пантера Пантера!
Dialogue: 0,0:09:44.87,0:09:45.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:45.83,0:09:48.42,Default,,0,0,0,,Eyeshield-kun, сені тағы тоқтатты!
Dialogue: 0,0:09:54.92,0:09:55.84,Default,,0,0,0,,Бұл қол.
Dialogue: 0,0:09:56.72,0:09:59.34,Default,,0,0,0,,Пантера да қарсыласын басып озу үшін қолдарын пайдаланады.
Dialogue: 0,0:10:00.14,0:10:01.85,Default,,0,0,0,,Сондықтан аз ғана иілумен
Dialogue: 0,0:10:01.97,0:10:03.97,Default,,0,0,0,,Жылдамдықты төмендетпей өте аласыз ба?
Dialogue: 0,0:10:05.89,0:10:06.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:09.60,0:10:11.52,Default,,0,0,0,,Бұлшық еттердің сапасы тым әртүрлі
Dialogue: 0,0:10:12.44,0:10:16.19,Default,,0,0,0,,Бұл адамның күшті және икемді аяқ-қолдары оның жүгіруіне мүмкіндік берді.
Dialogue: 0,0:10:16.78,0:10:18.78,Default,,0,0,0,,Оңай еліктейтін нәрсе емес
Dialogue: 0,0:10:19.36,0:10:21.74,Default,,0,0,0,,Сіз туылған кездегі бұлшықет күшінің айырмашылығы ма?
Dialogue: 0,0:10:22.45,0:10:24.83,Default,,0,0,0,,-ге келетін болсақ, Деймон қатал.
Dialogue: 0,0:10:25.83,0:10:27.79,Default,,0,0,0,,Адамдар тең болып туылмайды
Dialogue: 0,0:10:28.79,0:10:30.17,Default,,0,0,0,,Бір ғана күш-жігер ешқашан жеткіліксіз
Dialogue: 0,0:10:30.79,0:10:32.71,Default,,0,0,0,,Сіз өте алмайтын қабырға бар
Dialogue: 0,0:10:32.88,0:10:34.13,Default,,0,0,0,,Ғажайып ғажайып!
Dialogue: 0,0:10:34.25,0:10:35.42,Default,,0,0,0,,Морган!
Dialogue: 0,0:10:37.17,0:10:39.55,Default,,0,0,0,,Armadillos Ace Runner
Dialogue: 0,0:10:39.72,0:10:43.89,Default,,0,0,0,,Бұл табиғи спринтердің күші!
Dialogue: 0,0:10:45.47,0:10:47.89,Default,,0,0,0,,Өте қызық сияқты, Пантера
Dialogue: 0,0:10:48.18,0:10:49.77,Default,,0,0,0,,Америка футболын ойнай алатындықтан
Dialogue: 0,0:10:49.89,0:10:52.02,Default,,0,0,0,,Бұл қызық, жігітім.
Dialogue: 0,0:10:55.73,0:10:57.69,Default,,0,0,0,,«Көңілді»?…
Dialogue: 0,0:10:57.86,0:10:59.07,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:11:00.57,0:11:04.87,Default,,0,0,0,,Студент кезімде американдық футбол ойнағаным өте қызық еді.
Dialogue: 0,0:11:06.33,0:11:07.58,Default,,0,0,0,,Оны қараңыз
Dialogue: 0,0:11:07.95,0:11:09.58,Default,,0,0,0,,Мен міндетті түрде орындаймын
Dialogue: 0,0:11:09.71,0:11:12.04,Default,,0,0,0,,Ең мықты команданы жұлдызсыз құрыңыз
Dialogue: 0,0:11:12.96,0:11:15.54,Default,,0,0,0,,Мұқият жүйелі ұжым
Dialogue: 0,0:11:15.67,0:11:19.51,Default,,0,0,0,,Ойыншылар жаттықтырушының нұсқауларын орындайтын адал фигуралар болуы керек.
Dialogue: 0,0:11:20.30,0:11:23.05,Default,,0,0,0,,Шетелдіктер идеалды тип болуы керек еді.
Dialogue: 0,0:11:23.97,0:11:24.80,Default,,0,0,0,,(Дыбыс)
Dialogue: 0,0:11:26.68,0:11:29.06,Default,,0,0,0,,Әй, Eyeshield-kun тағы да ұсталды!
Dialogue: 0,0:11:29.77,0:11:32.69,Default,,0,0,0,,Доймон Олар 7 ұпай айырмашылығын жеңе ала ма!
Dialogue: 0,0:11:33.06,0:11:34.65,Default,,0,0,0,,2 минут қалды
Dialogue: 0,0:11:35.15,0:11:37.32,Default,,0,0,0,,Қазір бәрімізде қуат таусылып жатыр.
Dialogue: 0,0:11:37.82,0:11:39.49,Default,,0,0,0,,Қазір қиындап барады.
Dialogue: 0,0:11:39.82,0:11:40.74,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:40.86,0:11:43.57,Default,,0,0,0,,Егер тағы үш ұпай алмасақ, Америкаға қайта алмаймыз.
Dialogue: 0,0:11:44.57,0:11:45.45,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:45.83,0:11:46.95,Default,,0,0,0,,Директор Аполлон
Dialogue: 0,0:11:47.54,0:11:48.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:49.08,0:11:50.45,Default,,0,0,0,,Директордың нұсқауы бойынша
Dialogue: 0,0:11:50.58,0:11:52.29,Default,,0,0,0,,Көз қалқанын тоқтатыңыз.
Dialogue: 0,0:11:52.42,0:11:53.29,Default,,0,0,0,,Нұсқаулар беріңіз!
Dialogue: 0,0:11:54.75,0:11:56.25,Default,,0,0,0,,Директор Сіз білесіз бе?
Dialogue: 0,0:11:56.92,0:11:59.30,Default,,0,0,0,,Неліктен мен матчқа қатыса алмаймын?
Dialogue: 0,0:11:59.42,0:12:01.22,Default,,0,0,0,,Пантера жұмысын тастамады ма?
Dialogue: 0,0:12:01.84,0:12:02.68,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:04.76,0:12:06.68,Default,,0,0,0,,Негізі бәріміз директор болдық.
Dialogue: 0,0:12:06.80,0:12:08.72,Default,,0,0,0,,Мен бірде барып қарсылық көрсетпек болдым.
Dialogue: 0,0:12:11.35,0:12:13.14,Default,,0,0,0,,Өзіңіз айтпасаңыз
Dialogue: 0,0:12:13.27,0:12:15.40,Default,,0,0,0,,Біз директормен тікелей сөйлесеміз.
Dialogue: 0,0:12:16.15,0:12:17.36,Default,,0,0,0,,Бұл, әрине, біртүрлі.
Dialogue: 0,0:12:17.48,0:12:19.86,Default,,0,0,0,,Пантера доптарды ала береді
Dialogue: 0,0:12:20.03,0:12:21.24,Default,,0,0,0,,Бір рет
Dialogue: 0,0:12:21.36,0:12:24.28,Default,,0,0,0,,Жетекшінің нұсқауларын елемегеніңіз мұны білдірмейді.
Dialogue: 0,0:12:24.41,0:12:26.95,Default,,0,0,0,,Бәріміз қарсылық білдірсек, директор тыңдайтын шығар.
Dialogue: 0,0:12:28.66,0:12:30.24,Default,,0,0,0,,Мен… осындай күйде телефон шала алмаймын.
Dialogue: 0,0:12:30.83,0:12:32.62,Default,,0,0,0,,Тіпті директор Аполлон да, көріп тұрсыз.
Dialogue: 0,0:12:32.75,0:12:34.96,Default,,0,0,0,,Егер сіз бұған шындап қарасаңыз, олар міндетті түрде пайдаланады.
Dialogue: 0,0:12:35.25,0:12:37.92,Default,,0,0,0,,Маған әлі де шеберлік жетпейді.
Dialogue: 0,0:12:38.25,0:12:39.42,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:12:39.55,0:12:40.38,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:40.84,0:12:42.47,Default,,0,0,0,,Маған матчта ойнауға рұқсат беру керек.
Dialogue: 0,0:12:42.59,0:12:44.68,Default,,0,0,0,,Мен тіпті кәсіпқой бола алмаймын.
Dialogue: 0,0:12:45.97,0:12:49.43,Default,,0,0,0,,Маман болып, әжемді қуантқым келеді.
Dialogue: 0,0:12:49.56,0:12:50.81,Default,,0,0,0,,Бұл пантераның арманы
Dialogue: 0,0:12:51.43,0:12:53.68,Default,,0,0,0,,Оның американдық футбол ойнағысы келетіні не болды?
Dialogue: 0,0:12:54.56,0:12:55.81,Default,,0,0,0,,Жергілікті кәсіби команда
Dialogue: 0,0:12:55.94,0:12:57.48,Default,,0,0,0,,Даңқсыз ұлы спортшылар бар.
Dialogue: 0,0:12:57.61,0:12:59.02,Default,,0,0,0,,Мен оны көргеннен бері
Dialogue: 0,0:12:59.94,0:13:02.49,Default,,0,0,0,,Басқа біреуден үш есе көп жұмыс істейтін резервтік жүгіруші
Dialogue: 0,0:13:02.65,0:13:04.15,Default,,0,0,0,,Леонардо Аполлон
Dialogue: 0,0:13:05.11,0:13:07.53,Default,,0,0,0,,Пантерамен не болғанымен
Dialogue: 0,0:13:07.66,0:13:11.04,Default,,0,0,0,,Сіз мен құрметтейтін үлкен ағасыз.
Dialogue: 0,0:13:17.88,0:13:18.71,Default,,0,0,0,,Директор
Dialogue: 0,0:13:18.96,0:13:20.09,Default,,0,0,0,,Маған нұсқау беріңізші
Dialogue: 0,0:13:20.71,0:13:21.55,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:22.09,0:13:24.05,Default,,0,0,0,,Оны дәл қазір қалдырыңыз.
Dialogue: 0,0:13:26.01,0:13:26.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:28.05,0:13:29.93,Default,,0,0,0,,Шляпаны орнатыңыз!
Dialogue: 0,0:13:30.47,0:13:32.43,Default,,0,0,0,,Үлкен пайдалы!
Dialogue: 0,0:13:32.68,0:13:34.89,Default,,0,0,0,,Оны атамаңыз! (Комусуби) Фуго!
Dialogue: 0,0:13:39.98,0:13:42.02,Default,,0,0,0,,Тоқта! (Гомер) Пантера!
Dialogue: 0,0:13:42.86,0:13:44.53,Default,,0,0,0,,Тек пантера емес
Dialogue: 0,0:13:44.65,0:13:46.74,Default,,0,0,0,,Барлығы көңілді жүрген сияқты
Dialogue: 0,0:13:47.07,0:13:50.66,Default,,0,0,0,,Менің идеалды американдық футболым
Dialogue: 0,0:13:53.29,0:13:55.62,Default,,0,0,0,,Бұл болуы мүмкін.
Dialogue: 0,0:14:01.92,0:14:02.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:03.38,0:14:04.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:06.76,0:14:07.76,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:07.88,0:14:09.47,Default,,0,0,0,,Мен оны әлі жеңе алмаймын
Dialogue: 0,0:14:10.43,0:14:11.60,Default,,0,0,0,,Шектеу бар ма?
Dialogue: 0,0:14:12.81,0:14:14.39,Default,,0,0,0,,Қызықты жүгіру
Dialogue: 0,0:14:14.64,0:14:15.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:16.14,0:14:18.39,Default,,0,0,0,,Бірақ ол әлі толық қуатта емес.
Dialogue: 0,0:14:19.27,0:14:21.19,Default,,0,0,0,,Мен ең мықты жүгіруші боламын
Dialogue: 0,0:14:21.65,0:14:22.61,Default,,0,0,0,,екеуміз де шараптан бір-бір жұтым татып қойдық…
Dialogue: 0,0:14:22.90,0:14:25.48,Default,,0,0,0,,Бұл Сейжуро Шин немесе Eyeshield болсын.
Dialogue: 0,0:14:26.74,0:14:28.28,Default,,0,0,0,,Бар күшіңмен жең!
Dialogue: 0,0:14:30.61,0:14:32.41,Default,,0,0,0,,Сен барыңды бересің
Dialogue: 0,0:14:32.53,0:14:33.87,Default,,0,0,0,,Сен мені ұрайын деп тұрсың ба?
Dialogue: 0,0:14:36.04,0:14:36.87,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:37.75,0:14:40.25,Default,,0,0,0,,Пантера, менімен күресу үшін.
Dialogue: 0,0:14:40.37,0:14:42.04,Default,,0,0,0,,Олар Америкадан келген.
Dialogue: 0,0:14:42.29,0:14:44.34,Default,,0,0,0,,Бар күшіммен күресуім керек
Dialogue: 0,0:14:46.05,0:14:46.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:47.76,0:14:50.05,Default,,0,0,0,,Мен де Сусуму-санды жеңуге тырысамын.
Dialogue: 0,0:14:50.72,0:14:53.05,Default,,0,0,0,,Мен Пантера сияқты жүгіре алмаймын, бірақ
Dialogue: 0,0:14:53.55,0:14:55.72,Default,,0,0,0,,Мен жүгіру тәсіліммен жеңгім келеді!
Dialogue: 0,0:14:58.64,0:14:59.69,Default,,0,0,0,,Иә, мен келуім керек!
Dialogue: 0,0:15:00.56,0:15:02.48,Default,,0,0,0,,Енді, соңғы минут!
Dialogue: 0,0:15:02.61,0:15:04.65,Default,,0,0,0,,Екі команда да соңғы күшін жинайды
Dialogue: 0,0:15:04.94,0:15:06.61,Default,,0,0,0,,Ал, қарғыс атқыр маймыл!
Dialogue: 0,0:15:07.65,0:15:08.57,Default,,0,0,0,,Мукки!
Dialogue: 0,0:15:09.24,0:15:10.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:11.86,0:15:13.49,Default,,0,0,0,,Жүр!
Dialogue: 0,0:15:13.99,0:15:15.20,Default,,0,0,0,,Мені ұстады.
Dialogue: 0,0:15:16.04,0:15:18.20,Default,,0,0,0,,Пантера-кун тікелей соққыға барады!
Dialogue: 0,0:15:19.79,0:15:21.62,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:15:21.96,0:15:24.34,Default,,0,0,0,,Менің енді барлығын қууға күшім жетпейді.
Dialogue: 0,0:15:24.63,0:15:27.84,Default,,0,0,0,,Біз 14 ұпаймен жеңеміз.
Dialogue: 0,0:15:29.30,0:15:30.42,Default,,0,0,0,,Біз оны тоқтатуымыз керек!
Dialogue: 0,0:15:40.35,0:15:41.19,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:42.52,0:15:44.15,Default,,0,0,0,,Қолыңыз пайдаланылса
Dialogue: 0,0:15:47.07,0:15:47.90,Default,,0,0,0,,Қол?
Dialogue: 0,0:15:48.69,0:15:50.32,Default,,0,0,0,,Неліктен оны қолыңызбен итеруге болады?
Dialogue: 0,0:15:51.20,0:15:54.16,Default,,0,0,0,,Ол допты мықтап қорғау үшін екі қолын қолдануы керек.
Dialogue: 0,0:15:56.53,0:15:57.62,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:15:57.95,0:15:59.08,Default,,0,0,0,,Қолыңызбен итеру сәті
Dialogue: 0,0:15:59.62,0:16:01.87,Default,,0,0,0,,Саңылаумен бір қолмен ұстауға ауысыңыз!
Dialogue: 0,0:16:02.41,0:16:05.38,Default,,0,0,0,,Ол торынан шығарылған алғашқы қара қабылан болды.
Dialogue: 0,0:16:06.17,0:16:08.05,Default,,0,0,0,,Жабайы табиғатты білмеу
Dialogue: 0,0:16:09.09,0:16:11.55,Default,,0,0,0,,Пашириде дайындалған Eyeshield жүгірісі
Dialogue: 0,0:16:12.17,0:16:14.01,Default,,0,0,0,,Жай ғана жабайы табиғат
Dialogue: 0,0:16:17.68,0:16:19.60,Default,,0,0,0,,Бұрышталған шөпқоректі жануар
Dialogue: 0,0:16:19.72,0:16:23.39,Default,,0,0,0,,Кейде ол керемет күш көрсетеді!
Dialogue: 0,0:16:24.52,0:16:25.35,Default,,0,0,0,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,0:16:25.69,0:16:26.52,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:34.53,0:16:35.36,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:16:45.50,0:16:47.25,Default,,0,0,0,,Бұл Айсшилд 21!
Dialogue: 0,0:16:47.96,0:16:51.59,Default,,0,0,0,,Жарық жылдамдығымен 4 секунд 2 әлем!
Dialogue: 0,0:17:08.86,0:17:15.86,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:17:17.61,0:17:18.45,Default,,0,0,0,,Ой!
Dialogue: 0,0:17:19.24,0:17:20.37,Default,,0,0,0,,Мен оларды дәл қазір толықтай сіңіріп алдым.
Dialogue: 0,0:17:22.70,0:17:23.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:32.46,0:17:33.30,Default,,0,0,0,,
Dialogue: 0,0:17:33.42,0:17:35.17,Default,,0,0,0,,Қозғалыс!
Dialogue: 0,0:17:35.42,0:17:39.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:39.93,0:17:42.22,Default,,0,0,0,,(Сенаның ауыр тыныс алуы)
Dialogue: 0,0:17:42.89,0:17:45.98,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:17:47.98,0:17:52.23,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:52.36,0:17:53.69,Default,,0,0,0,,"Оған қанша төлейсің?"
Dialogue: 0,0:17:56.78,0:17:59.62,Default,,0,0,0,,Солтүстік-солтүстік-шығыс! Солтүстік-солтүстік-шығыс!
Dialogue: 0,0:18:00.87,0:18:03.04,Default,,0,0,0,,Матчтың нәтижесі қандай болды?
Dialogue: 0,0:18:06.46,0:18:08.25,Default,,0,0,0,,Ойын аяқталды!
Dialogue: 0,0:18:09.00,0:18:09.96,Default,,0,0,0,,Соңында балшық қақпасы
Dialogue: 0,0:18:10.08,0:18:12.71,Default,,0,0,0,,Нүкте үшін екі рет тиюді мақсат етіңіз.
Dialogue: 0,0:18:12.84,0:18:16.34,Default,,0,0,0,,Бұл оның бұлшық ет тосқауылымен жаншылуымен аяқталды.
Dialogue: 0,0:18:17.34,0:18:19.80,Default,,0,0,0,,Бұл стратегияны көз қалқанысыз орындау мүмкін емес.
Dialogue: 0,0:18:20.30,0:18:22.14,Default,,0,0,0,,Неліктен тебу арқылы галстукты көздеу керек?
Dialogue: 0,0:18:22.26,0:18:23.14,Default,,0,0,0,,Бұл жұмыс істемеді, солай ма?
Dialogue: 0,0:18:24.01,0:18:26.68,Default,,0,0,0,,Балшық қақпасында тепкі бар емес пе?
Dialogue: 0,0:18:29.39,0:18:31.06,Default,,0,0,0,,Бір ұпайлық айырмашылықтың өзі ғажайып.
Dialogue: 0,0:18:31.69,0:18:34.86,Default,,0,0,0,,Біріншіден, қазіргі Деймон жеңілетін қарсылас емес еді.
Dialogue: 0,0:18:36.11,0:18:37.57,Default,,0,0,0,,Бірақ бұл матчта
Dialogue: 0,0:18:37.69,0:18:40.28,Default,,0,0,0,,Деймондағы өнерпаздар көп нәрсеге қол жеткізді.
Dialogue: 0,0:18:40.86,0:18:42.78,Default,,0,0,0,,Сүлік жынның көздегені осы ма?
Dialogue: 0,0:18:45.12,0:18:46.66,Default,,0,0,0,,Қабақ 21
Dialogue: 0,0:18:47.12,0:18:47.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:50.67,0:18:52.88,Default,,0,0,0,,Соңында мен жеңілдім.
Dialogue: 0,0:18:53.84,0:18:55.09,Default,,0,0,0,,Пантера
Dialogue: 0,0:19:03.64,0:19:05.06,Default,,0,0,0,,Керемет ойын
Dialogue: 0,0:19:07.10,0:19:10.44,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:10.77,0:19:11.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:14.31,0:19:15.15,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:19:17.40,0:19:21.36,Default,,0,0,0,,Бүгінгі ойын мен үшін өте тиімді болды, өйткені мен алмастырушы болып шықтым.
Dialogue: 0,0:19:22.16,0:19:24.16,Default,,0,0,0,,Осы жолы да дәл осындай жағдайда күресейік
Dialogue: 0,0:19:25.78,0:19:27.79,Default,,0,0,0,,Келесі жолы да назардан тыс қалмаймын
Dialogue: 0,0:19:28.91,0:19:29.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:29.87,0:19:34.50,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:35.04,0:19:41.05,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:20:43.90,0:20:49.91,Default,,0,0,0,,~♪
Dialogue: 0,0:20:51.12,0:20:54.16,Default,,0,0,0,,Иә! Америка ақыры осында!
Dialogue: 0,0:20:54.46,0:20:56.38,Default,,0,0,0,,Сен не үрейленіп тұрсың, Сена?
Dialogue: 0,0:20:56.50,0:20:57.33,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:20:57.46,0:20:59.46,Default,,0,0,0,,Церберус әуежайда жоғалып кетті!
Dialogue: 0,0:20:59.84,0:21:00.67,Default,,0,0,0,,Егер мен оны жалғыз қалдырсам
Dialogue: 0,0:21:00.80,0:21:03.38,Default,,0,0,0,,Америкадағы барлық ет жеп қалады!
Dialogue: 0,0:21:03.59,0:21:05.97,Default,,0,0,0,,Келесі жолы «Көз қалқаны 21»
Dialogue: 0,0:21:07.80,0:21:09.60,Default,,0,0,0,,Я-! Ха-!
Dialogue: 0,0:21:11.10,0:21:17.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
