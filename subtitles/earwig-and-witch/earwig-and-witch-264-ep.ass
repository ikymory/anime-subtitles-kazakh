Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.98,0:00:15.28,Default,,0,0,0,,...
Dialogue: 0,0:00:15.28,0:00:20.12,Default,,0,0,0,,...
Dialogue: 0,0:00:20.12,0:00:29.67,Rubi,,0,0,0,,Мода
Dialogue: 0,0:00:20.12,0:00:29.67,Default,,0,0,0,,...
Dialogue: 0,0:00:29.67,0:00:32.07,Default,,0,0,0,,Don't disturb me
Dialogue: 0,0:00:36.24,0:00:38.24,Default,,0,0,0,,Иә
Dialogue: 0,0:01:49.85,0:01:51.95,Default,,0,0,0,,А...
Dialogue: 0,0:01:58.12,0:02:00.86,Default,,0,0,0,,Сізге серуен ұнады ма?
Dialogue: 0,0:02:00.86,0:02:03.43,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:02:03.43,0:02:06.33,Default,,0,0,0,,Мұндағы бөлмелердің бәрі жылтыр.
Dialogue: 0,0:02:06.33,0:02:10.20,Default,,0,0,0,,Көптеген үлкен терезелер бар.
Dialogue: 0,0:02:06.33,0:02:10.20,Default,,0,0,0,,Бұл жақсы сезінеді
Dialogue: 0,0:02:10.20,0:02:13.80,Default,,0,0,0,,Ал қойшының бәлегі дәмді.
Dialogue: 0,0:02:15.77,0:02:19.98,Default,,0,0,0,,Жарайсың ба? сен осындасың
Dialogue: 0,0:02:19.98,0:02:22.28,Default,,0,0,0,,Басқа жерге бармаңыз
Dialogue: 0,0:02:22.28,0:02:26.15,Default,,0,0,0,,Қалғанын жақсы орында.
Dialogue: 0,0:02:26.15,0:02:29.79,Default,,0,0,0,,Аяцуру
Dialogue: 0,0:02:29.79,0:02:32.69,Default,,0,0,0,,()
Dialogue: 0,0:02:32.69,0:02:35.29,Default,,0,0,0,,Таңертең ерте!
Dialogue: 0,0:02:35.29,0:02:37.79,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:02:37.79,0:02:39.73,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:02:37.79,0:02:39.73,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:02:39.73,0:02:43.13,Default,,0,0,0,,Ой, ой, ой... ой!
Dialogue: 0,0:02:39.73,0:02:43.13,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:02:43.13,0:02:46.04,Default,,0,0,0,,мен шынымен құрмет сезіндім.
Dialogue: 0,0:02:43.13,0:02:46.04,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:02:46.04,0:02:49.01,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:02:46.04,0:02:49.01,Default,,0,0,0,,Жылама Жылама
Dialogue: 0,0:02:49.01,0:02:51.77,Default,,0,0,0,,Жақсы қыз Жақсы қыз
Dialogue: 0,0:02:51.77,0:02:55.14,Default,,0,0,0,,«Менің 12 сиқыршы жолдасыма
Dialogue: 0,0:02:51.77,0:02:55.14,Default,,0,0,0,,Қуғындалу
Dialogue: 0,0:02:55.14,0:02:58.61,Default,,0,0,0,,Егер сіз қашып кетсеңіз
Dialogue: 0,0:02:55.14,0:02:58.61,Default,,0,0,0,,Мен мына баланы қайтаруға келемін.
Dialogue: 0,0:02:58.61,0:03:01.62,Default,,0,0,0,,Көп жылдар қажет болуы мүмкін, бірақ
Dialogue: 0,0:03:01.62,0:03:06.36,Default,,0,0,0,,Бұл баланың аты Аяцуру».
Dialogue: 0,0:03:01.62,0:03:06.36,Default,,0,0,0,,Аяцуру?
Dialogue: 0,0:03:06.36,0:03:10.16,Default,,0,0,0,,Мына баланың анасы
Dialogue: 0,0:03:06.36,0:03:10.16,Default,,0,0,0,,Егер сіз 12 сиқыршының досы болсаңыз.
Dialogue: 0,0:03:10.16,0:03:12.76,Default,,0,0,0,,Бұл адам да бақсы ғой, солай ма?
Dialogue: 0,0:03:12.76,0:03:16.97,Default,,0,0,0,,Ковеннің барлық мүшелерін ашуландыратын нәрсе жасаңыз.
Dialogue: 0,0:03:12.76,0:03:16.97,Default,,0,0,0,,Сіз мұны істедіңіз бе?
Dialogue: 0,0:03:16.97,0:03:19.77,Default,,0,0,0,,Сіз бақсысыз ба? күлкілі!
Dialogue: 0,0:03:19.77,0:03:23.34,Default,,0,0,0,,Сосын мына бала да.
Dialogue: 0,0:03:19.77,0:03:23.34,Default,,0,0,0,,Ол сиқыршы болуы мүмкін.
Dialogue: 0,0:03:23.34,0:03:26.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:23.34,0:03:26.24,Default,,0,0,0,,Аха хаха
Dialogue: 0,0:03:26.24,0:03:30.41,Default,,0,0,0,,Бос сөз! Қандай сиқыршы
Dialogue: 0,0:03:26.24,0:03:30.41,Default,,0,0,0,,Менің бұл дүниеде болуым мүмкін емес!
Dialogue: 0,0:03:30.41,0:03:34.11,Default,,0,0,0,,Сәлем? Барайық.
Dialogue: 0,0:03:35.79,0:03:39.66,Default,,0,0,0,,Аяцуру деген не?
Dialogue: 0,0:03:35.79,0:03:39.66,Default,,0,0,0,,Сіз адамдарды «манипуляциялайтын» сияқты емес сияқтысыз.
Dialogue: 0,0:03:39.66,0:03:44.79,Default,,0,0,0,,Ayatsuru… Ayatsuru? Aya tools
Dialogue: 0,0:03:44.79,0:03:47.33,Default,,0,0,0,,Principal?
Dialogue: 0,0:03:47.33,0:03:51.07,Default,,0,0,0,,Oh, I'll introduce everyone.
Dialogue: 0,0:03:51.07,0:03:53.80,Default,,0,0,0,,Бұл бала – Арья құралы
Dialogue: 0,0:03:53.80,0:03:56.37,Default,,0,0,0,,Aya!
Dialogue: 0,0:03:56.37,0:03:58.81,Default,,0,0,0,,Aa
Dialogue: 0,0:03:58.81,0:04:02.41,Default,,0,0,0,,(Аяның күлкісі)
Dialogue: 0,0:03:58.81,0:04:02.41,Default,,0,0,0,,Ой, көңіл-күйің жақсы.
Dialogue: 0,0:04:02.41,0:04:04.71,Default,,0,0,0,,(Ая мен мұғалімдердің күлкісі)
Dialogue: 0,0:04:06.28,0:05:44.68,Default,,0,0,0,,Сен
Dialogue: 0,0:05:51.55,0:05:54.19,Default,,0,0,0,,Хехе...
Dialogue: 0,0:05:54.19,0:05:57.29,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:54.19,0:05:57.29,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:05:59.03,0:06:22.22,Default,,0,0,0,,Сен
Dialogue: 0,0:06:22.22,0:06:24.95,Default,,0,0,0,,Baaaah!
Dialogue: 0,0:06:22.22,0:06:24.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:24.95,0:06:29.89,Default,,0,0,0,,Сен
Dialogue: 0,0:06:29.89,0:06:32.83,Default,,0,0,0,,Уфф!
Dialogue: 0,0:06:29.89,0:06:32.83,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:32.83,0:06:34.96,Default,,0,0,0,,Woof woof woof!
Dialogue: 0,0:06:32.83,0:06:34.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:34.96,0:06:38.83,Default,,0,0,0,,Уф уф! Уф уф! Уф уф!
Dialogue: 0,0:06:38.83,0:06:40.84,Default,,0,0,0,,Уфф!
Dialogue: 0,0:06:40.84,0:06:42.84,Default,,0,0,0,,Уау!!
Dialogue: 0,0:06:47.98,0:06:50.88,Default,,0,0,0,,Хехе...
Dialogue: 0,0:06:50.88,0:06:57.99,Default,,0,0,0,,Сен
Dialogue: 0,0:06:57.99,0:07:00.36,Default,,0,0,0,,Тоқтатайық, Ая.
Dialogue: 0,0:07:00.36,0:07:02.36,Default,,0,0,0,,Егер олар білсе, олар міндетті түрде ашуланады.
Dialogue: 0,0:07:02.36,0:07:06.16,Default,,0,0,0,,It's okay. Олар сені таппағанша, бәрі жақсы.
Dialogue: 0,0:07:08.40,0:07:10.50,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:07:08.40,0:07:10.50,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:13.84,0:07:15.94,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:07:18.14,0:07:20.94,Default,,0,0,0,,Маған айғай салғым келмейді.
Dialogue: 0,0:07:20.94,0:07:25.51,Default,,0,0,0,,Ақымақ, мұндай мүмкіндік
Dialogue: 0,0:07:20.94,0:07:25.51,Default,,0,0,0,,Бұл сирек кездеседі. Қараңдар!
Dialogue: 0,0:07:25.51,0:07:27.85,Default,,0,0,0,,Мен осында күте алмаймын ба?
Dialogue: 0,0:07:27.85,0:07:31.42,Default,,0,0,0,,Hehe, to you.
Dialogue: 0,0:07:27.85,0:07:31.42,Default,,0,0,0,,Егер сізде батылдық болса.
Dialogue: 0,0:07:31.42,0:07:33.42,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:35.12,0:07:39.06,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:07:39.06,0:07:42.16,Default,,0,0,0,,Aya, wait!
Dialogue: 0,0:07:51.87,0:07:54.68,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:07:51.87,0:07:54.68,Default,,0,0,0,,Не?
Dialogue: 0,0:07:54.68,0:07:58.55,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:07:54.68,0:07:58.55,Default,,0,0,0,,Қоңыраудың орнына шыңға шыққанда
Dialogue: 0,0:07:58.55,0:08:03.82,Default,,0,0,0,,Адамның кесілген басы – Боран Буран.
Dialogue: 0,0:07:58.55,0:08:03.82,Default,,0,0,0,,Дірілдеп тұр. Бұл қызық емес пе?
Dialogue: 0,0:08:03.82,0:08:08.26,Default,,0,0,0,,It's not fun!
Dialogue: 0,0:08:03.82,0:08:08.26,Default,,0,0,0,,(Аттың айғайы)
Dialogue: 0,0:08:08.26,0:08:13.13,Default,,0,0,0,,Сонымен, кесілген бастың көздері
Dialogue: 0,0:08:08.26,0:08:13.13,Default,,0,0,0,,Open your eyes...
Dialogue: 0,0:08:13.13,0:08:16.53,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:13.13,0:08:16.53,Default,,0,0,0,,Ол бізге қарап тұр.
Dialogue: 0,0:08:16.53,0:08:19.17,Default,,0,0,0,,Then suddenly
Dialogue: 0,0:08:19.17,0:08:23.91,Default,,0,0,0,,Кесілген бастың аузы ашылады...!
Dialogue: 0,0:08:19.17,0:08:23.91,Default,,0,0,0,,Aaaaaaaaaaah! мен сені ести алмаймын!
Dialogue: 0,0:08:23.91,0:08:26.31,Default,,0,0,0,,A little custard
Dialogue: 0,0:08:26.31,0:08:30.28,Default,,0,0,0,,Бұлай қорықпа
Dialogue: 0,0:08:26.31,0:08:30.28,Default,,0,0,0,,Марсиялықтар шабуыл жасаса, сен не істер едің?
Dialogue: 0,0:08:30.28,0:08:33.55,Default,,0,0,0,,Марслықтар бізге мейірімді.
Dialogue: 0,0:08:33.55,0:08:37.42,Default,,0,0,0,,Генлейн кітабында
Dialogue: 0,0:08:33.55,0:08:37.42,Default,,0,0,0,,Өйткені ол жазылған!
Dialogue: 0,0:08:37.42,0:08:41.76,Default,,0,0,0,,Бұл бәрібір сенсің
Dialogue: 0,0:08:37.42,0:08:41.76,Default,,0,0,0,,Сегіз қол мені қатты ұстайды
Dialogue: 0,0:08:41.76,0:08:45.53,Rubi,,0,0,0,,Аты Амидабутсу
Dialogue: 0,0:08:41.76,0:08:45.53,Default,,0,0,0,,Қош бол Наму Амида Буцу~
Dialogue: 0,0:08:45.53,0:08:49.53,Default,,0,0,0,,Марстардың сегіз емес, үш қолы бар!
Dialogue: 0,0:08:49.53,0:08:51.83,Default,,0,0,0,,Бұл екі жағдайда да маңызды емес.
Dialogue: 0,0:08:56.21,0:08:58.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:58.47,0:09:06.22,Default,,0,0,0,,Жақсы сезінеді~!!
Dialogue: 0,0:09:06.22,0:09:09.25,Default,,0,0,0,,Тынш! біреу мені ести алады
Dialogue: 0,0:09:09.25,0:09:12.02,Default,,0,0,0,,Ах! Барлығы
Dialogue: 0,0:09:12.02,0:09:15.49,Default,,0,0,0,,Зират шедевріндегі таңғажайып кеш!
Dialogue: 0,0:09:15.49,0:09:19.80,Default,,0,0,0,,Біз ешкімді сағынған жоқпыз
Dialogue: 0,0:09:15.49,0:09:19.80,Default,,0,0,0,,Мен байқамадым.
Dialogue: 0,0:09:19.80,0:09:22.03,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:09:22.03,0:09:24.63,Default,,0,0,0,,Бұл кеме емес пе?
Dialogue: 0,0:09:24.63,0:09:26.67,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:09:26.67,0:09:28.90,Default,,0,0,0,,Ғарыш кемесіне ұқсайды
Dialogue: 0,0:09:28.90,0:09:32.30,Default,,0,0,0,,Жақсы, мен оны мінгім келеді.
Dialogue: 0,0:09:34.38,0:09:37.08,Default,,0,0,0,,О, бұл Арья.
Dialogue: 0,0:09:37.08,0:09:40.75,Default,,0,0,0,,Оны маған біреу берді
Dialogue: 0,0:09:37.08,0:09:40.75,Default,,0,0,0,,Мен басқа жерде тұрғым келеді
Dialogue: 0,0:09:40.75,0:09:43.05,Default,,0,0,0,,Сіз бұл туралы ешқашан ойлаған жоқсыз ба?
Dialogue: 0,0:09:43.05,0:09:46.29,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:09:46.29,0:09:48.76,Default,,0,0,0,,Иә, мен олай ойламаймын.
Dialogue: 0,0:09:48.76,0:09:52.46,Default,,0,0,0,,Егер мені біреу таңдаса
Dialogue: 0,0:09:48.76,0:09:52.46,Default,,0,0,0,,Өте біртүрлі адам.
Dialogue: 0,0:09:52.46,0:09:55.93,Default,,0,0,0,,Және оны кәдімгі отбасына асырап алды.
Dialogue: 0,0:09:55.93,0:09:59.54,Default,,0,0,0,,Менің айтқанымды орындайтын адам
Dialogue: 0,0:09:55.93,0:09:59.54,Default,,0,0,0,,Екі-үш адам, солай ма?
Dialogue: 0,0:09:59.54,0:10:04.07,Default,,0,0,0,,Ең көбі 6 адам
Dialogue: 0,0:09:59.54,0:10:04.07,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:10:04.07,0:10:07.54,Default,,0,0,0,,Мұндағылардың бәрі мен айтқандай дұрыс.
Dialogue: 0,0:10:07.54,0:10:10.74,Default,,0,0,0,,Барлық жерде жылтыр
Dialogue: 0,0:10:12.38,0:10:15.32,Default,,0,0,0,,Терезелер үлкен және күн сәулесі мол түседі.
Dialogue: 0,0:10:15.32,0:10:18.82,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:10:15.32,0:10:18.82,Default,,0,0,0,,Ағайдың қойшысының бәлегі ең жақсы!
Dialogue: 0,0:10:20.66,0:10:24.96,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:20.66,0:10:24.96,Default,,0,0,0,,Сізді де ешкім ешқашан таңдамайды.
Dialogue: 0,0:10:24.96,0:10:29.47,Default,,0,0,0,,Бірақ менің алдымда тоқтайтын адамдар аз емес.
Dialogue: 0,0:10:29.47,0:10:33.34,Default,,0,0,0,,Бар
Dialogue: 0,0:10:29.47,0:10:33.34,Default,,0,0,0,,Таңдалып қала жаздаған кездерім болды.
Dialogue: 0,0:10:33.34,0:10:35.44,Default,,0,0,0,,(Аттың айғайы)
Dialogue: 0,0:10:39.01,0:10:41.58,Default,,0,0,0,,Бұл!
Dialogue: 0,0:10:39.01,0:10:41.58,Default,,0,0,0,,Мен саған үйреткендей.
Dialogue: 0,0:10:41.58,0:10:44.15,Default,,0,0,0,,Көзіңізді айқастыруды ұмытпаңыз
Dialogue: 0,0:10:44.15,0:10:47.58,Default,,0,0,0,,Түсіндіңіз бе? Кьютер-кун
Dialogue: 0,0:10:47.58,0:10:50.12,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:10:50.12,0:10:52.92,Default,,0,0,0,,Иә! капитан!
Dialogue: 0,0:10:52.92,0:10:57.46,Default,,0,0,0,,Иә! Уф...!
Dialogue: 0,0:10:57.46,0:11:01.43,Default,,0,0,0,,(Аттың айғайы)
Dialogue: 0,0:11:01.43,0:11:14.88,Default,,0,0,0,,Сен
Dialogue: 0,0:11:14.88,0:11:18.48,Default,,0,0,0,,Селма! Селма!
Dialogue: 0,0:11:18.48,0:11:22.99,Default,,0,0,0,,Қош келдіңіз, директор
Dialogue: 0,0:11:18.48,0:11:22.99,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:22.99,0:11:24.92,Default,,0,0,0,,Сіздің отбасыңыз туралы бірдеңе?
Dialogue: 0,0:11:24.92,0:11:26.86,Default,,0,0,0,,Бұл бәрі емес!
Dialogue: 0,0:11:26.86,0:11:30.59,Default,,0,0,0,,Автобус аялдамасында
Dialogue: 0,0:11:26.86,0:11:30.59,Default,,0,0,0,,Сіз көршіңіз Дженкинс мырзамен кездескен кезде
Dialogue: 0,0:11:30.59,0:11:34.46,Default,,0,0,0,,Кеше түнде балалар
Dialogue: 0,0:11:30.59,0:11:34.46,Default,,0,0,0,,Елес болып киінген...
Dialogue: 0,0:11:30.59,0:11:34.46,Default,,0,0,0,,Ал, кеше түнде?
Dialogue: 0,0:11:34.46,0:11:36.87,Default,,0,0,0,,Сіз бірдеңені байқамадыңыз ба?
Dialogue: 0,0:11:36.87,0:11:40.14,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:36.87,0:11:40.14,Default,,0,0,0,,Мен тіпті байқамай қалдым.
Dialogue: 0,0:11:40.14,0:11:42.81,Default,,0,0,0,,Сіз шынымен елес көрдіңіз бе?
Dialogue: 0,0:11:42.81,0:11:46.38,Default,,0,0,0,,Бірақ аталған адам өз келісімін берді
Dialogue: 0,0:11:42.81,0:11:46.38,Default,,0,0,0,,...
Dialogue: 0,0:11:46.38,0:11:49.88,Default,,0,0,0,,Мен солай істедім
Dialogue: 0,0:11:46.38,0:11:49.88,Default,,0,0,0,,Иә
Dialogue: 0,0:11:49.88,0:11:53.28,Default,,0,0,0,,қайнатпа
Dialogue: 0,0:11:49.88,0:11:53.28,Default,,0,0,0,,Иә
Dialogue: 0,0:11:53.28,0:11:56.49,Default,,0,0,0,,Айя, бұл нені білдіреді?
Dialogue: 0,0:11:56.49,0:12:00.29,Default,,0,0,0,,Бүгін түстен кейін тағы да
Dialogue: 0,0:11:56.49,0:12:00.29,Default,,0,0,0,,Біреу алып кетейін деп жатыр, солай ма?
Dialogue: 0,0:12:00.29,0:12:04.09,Default,,0,0,0,,Сонымен барлығы
Dialogue: 0,0:12:00.29,0:12:04.09,Default,,0,0,0,,Қоштасу кешін өткіздік.
Dialogue: 0,0:12:04.09,0:12:07.76,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:04.09,0:12:07.76,Default,,0,0,0,,Мен де директорды шақыруды жоспарлап едім.
Dialogue: 0,0:12:07.76,0:12:13.60,Default,,0,0,0,,Өйткені I
Dialogue: 0,0:12:07.76,0:12:13.60,Default,,0,0,0,,Ең дұрысы – директормен қоштасу.
Dialogue: 0,0:12:13.60,0:12:16.77,Default,,0,0,0,,Бірақ мен сәл артық кеттім бе?
Dialogue: 0,0:12:16.77,0:12:21.74,Default,,0,0,0,,Әй, Ая, сен баласың...
Dialogue: 0,0:12:21.74,0:12:27.32,Default,,0,0,0,,Иә, бұл күн.
Dialogue: 0,0:12:21.74,0:12:27.32,Default,,0,0,0,,Бұл сіздің күніңіз болуы мүмкін.
Dialogue: 0,0:12:27.32,0:12:31.75,Default,,0,0,0,,Менің сен сияқты сүйкімді қызым бар.
Dialogue: 0,0:12:27.32,0:12:31.75,Default,,0,0,0,,Мәңгі таңдалмаған
Dialogue: 0,0:12:31.75,0:12:34.35,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,0:12:41.43,0:12:45.83,Default,,0,0,0,,Аа, дұрыс, мен мүлдем ұмытып кеттім.
Dialogue: 0,0:12:47.60,0:12:49.54,Default,,0,0,0,,(сөмкені ашқан дыбыс)
Dialogue: 0,0:12:49.54,0:12:53.41,Default,,0,0,0,,Қараңызшы, мен біраздан бері осыны қалаймын.
Dialogue: 0,0:12:53.41,0:12:55.44,Default,,0,0,0,,Қызыл жемпір
Dialogue: 0,0:12:55.44,0:12:58.25,Default,,0,0,0,,Тынш! Ол әркімде бола бермейді.
Dialogue: 0,0:12:58.25,0:13:00.32,Default,,0,0,0,,Иә, жоқ деп ойлаймын.
Dialogue: 0,0:13:00.32,0:13:06.36,Default,,0,0,0,,Аа, мен бақтағы ең бақытты адаммын.
Dialogue: 0,0:13:00.32,0:13:06.36,Default,,0,0,0,,Мен сізді жақсы көремін, директор мырза!
Dialogue: 0,0:13:06.36,0:13:08.66,Default,,0,0,0,,Oh my goodness
Dialogue: 0,0:13:06.36,0:13:08.66,Default,,0,0,0,,Бұл негізгі
Dialogue: 0,0:13:08.66,0:13:10.73,Default,,0,0,0,,Дженкинс мырзаға не айтасыз?
Dialogue: 0,0:13:10.73,0:13:15.23,Default,,0,0,0,,Бейіттерді аңдыған
Dialogue: 0,0:13:10.73,0:13:15.23,Default,,0,0,0,,Соны айт!
Dialogue: 0,0:13:15.23,0:13:18.77,Default,,0,0,0,,Мұғалім, мен сенің сөмкеңді аламын.
Dialogue: 0,0:13:18.77,0:13:21.30,Default,,0,0,0,,Әй, бұл ауыр емес пе?
Dialogue: 0,0:13:21.30,0:13:24.40,Default,,0,0,0,,Одан аулақ болыңыз
Dialogue: 0,0:13:21.30,0:13:24.40,Default,,0,0,0,,Бұл көмектеседі.
Dialogue: 0,0:13:26.11,0:13:28.11,Default,,0,0,0,,Бірақ аталған адам өз келісімін берді
Dialogue: 0,0:13:34.22,0:13:36.65,Default,,0,0,0,,Әй, Ая, кеше...
Dialogue: 0,0:13:36.65,0:13:40.42,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:36.65,0:13:40.42,Default,,0,0,0,,Бәрін қайта жазып, поштаға салдым.
Dialogue: 0,0:13:40.42,0:13:43.16,Default,,0,0,0,,Ертең
Dialogue: 0,0:13:40.42,0:13:43.16,Default,,0,0,0,,Сіз махаббатқа толы жауап аласыз деп ойламайсыз ба?
Dialogue: 0,0:13:43.16,0:13:45.09,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:45.09,0:13:47.46,Default,,0,0,0,,...
Dialogue: 0,0:13:45.09,0:13:47.46,Default,,0,0,0,,...
Dialogue: 0,0:13:47.46,0:13:50.46,Default,,0,0,0,,(Иіскеу және тыныс алу дыбыстары)
Dialogue: 0,0:13:56.07,0:13:58.91,Default,,0,0,0,,Эй, бүгін түскі асқа қойшы бәлішін алғың келе ме?
Dialogue: 0,0:13:58.91,0:14:01.81,Default,,0,0,0,,Мұрны жақсы келіншек келді.
Dialogue: 0,0:14:01.81,0:14:05.45,Default,,0,0,0,,Шопан бәліш, солай ма?
Dialogue: 0,0:14:01.81,0:14:05.45,Default,,0,0,0,,Солай болуы керек.
Dialogue: 0,0:14:05.45,0:14:09.32,Default,,0,0,0,,Өйткені ағайдың пирогы
Dialogue: 0,0:14:05.45,0:14:09.32,Default,,0,0,0,,Дүниедегі ең дәмді нәрсе
Dialogue: 0,0:14:09.32,0:14:11.39,Default,,0,0,0,,Иісі керемет!
Dialogue: 0,0:14:11.39,0:14:13.96,Default,,0,0,0,,Мұнда бас аспаз кім болды?
Dialogue: 0,0:14:13.96,0:14:15.99,Default,,0,0,0,,Дұрыс айтасың, Ая.
Dialogue: 0,0:14:15.99,0:14:18.33,Default,,0,0,0,,О, мен емеспін.
Dialogue: 0,0:14:18.33,0:14:21.93,Default,,0,0,0,,Менің ішім осындай
Dialogue: 0,0:14:18.33,0:14:21.93,Default,,0,0,0,,Менде жоқ!
Dialogue: 0,0:14:21.93,0:14:26.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:21.93,0:14:26.30,Default,,0,0,0,,Егер сіз аздап арықтасаңыз ше?
Dialogue: 0,0:14:26.30,0:14:29.84,Default,,0,0,0,,Хмф! Мен бұған мүлдем шыдай алмаймын
Dialogue: 0,0:14:29.84,0:14:34.34,Default,,0,0,0,,Құлақ ұстайтын ханым
Dialogue: 0,0:14:29.84,0:14:34.34,Default,,0,0,0,,Түскі асты асыға күтіңіз
Dialogue: 0,0:14:34.34,0:14:36.34,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:39.18,0:14:41.18,Default,,0,0,0,,Мен сізді жақсы көремін, ағай!
Dialogue: 0,0:14:43.05,0:14:45.15,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:43.05,0:14:45.15,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:46.89,0:14:49.86,Default,,0,0,0,,Мен сені көрдім!
Dialogue: 0,0:14:49.86,0:14:52.69,Default,,0,0,0,,Қандай жарқыраған көздер!
Dialogue: 0,0:14:52.69,0:14:56.33,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:52.69,0:14:56.33,Default,,0,0,0,,Бәрі Кис жоспары еді…
Dialogue: 0,0:14:56.33,0:15:00.23,Default,,0,0,0,,О, оны маған бере аласыз ба?
Dialogue: 0,0:14:56.33,0:15:00.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:56.33,0:15:00.23,Default,,0,0,0,,Жақсы бала.
Dialogue: 0,0:15:01.80,0:15:04.10,Default,,0,0,0,,Уф, бұл жиіркенішті!
Dialogue: 0,0:15:06.28,0:15:08.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:15.65,0:15:18.09,Default,,0,0,0,,Сол балалар
Dialogue: 0,0:15:15.65,0:15:18.09,Default,,0,0,0,,Бұл қуыршақ емес.
Dialogue: 0,0:15:18.09,0:15:20.02,Default,,0,0,0,,Мен тірімін.
Dialogue: 0,0:15:20.02,0:15:23.02,Default,,0,0,0,,Бұл қарап, ләззат алатын нәрсе емес.
Dialogue: 0,0:15:30.10,0:15:35.80,Default,,0,0,0,,Бізде де сүйкімді қуыршақ бар.
Dialogue: 0,0:15:30.10,0:15:35.80,Default,,0,0,0,,Әрекет етейік, мистер Кистард.
Dialogue: 0,0:15:42.11,0:15:46.68,Default,,0,0,0,,Оның жасырынған жеріне қатысты белгі суреттің ішінде болуы мүмкін бе?
Dialogue: 0,0:15:46.68,0:15:49.08,Default,,0,0,0,,Иә, иә! Мен үйдемін!
Dialogue: 0,0:15:50.65,0:15:54.12,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:15:54.12,0:15:56.06,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:15:56.06,0:15:58.56,Default,,0,0,0,,(қол шапалақтау дыбысы)
Dialogue: 0,0:15:58.56,0:16:02.03,Default,,0,0,0,,(директор)
Dialogue: 0,0:15:58.56,0:16:02.03,Default,,0,0,0,,Кәне, дұрыстап сапқа тұрыңдар.
Dialogue: 0,0:16:02.03,0:16:04.33,Default,,0,0,0,,Барлығыңыз күліңіздер
Dialogue: 0,0:16:04.33,0:16:06.73,Default,,0,0,0,,Өтінемін, осы.
Dialogue: 0,0:16:08.50,0:16:10.44,Default,,0,0,0,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:16:08.50,0:16:10.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:10.44,0:16:18.65,Default,,0,0,0,,Сен
Dialogue: 0,0:16:18.65,0:16:22.52,Default,,0,0,0,,(директор)
Dialogue: 0,0:16:18.65,0:16:22.52,Default,,0,0,0,,Әр адамды бір-бірден таныстырамын.
Dialogue: 0,0:16:22.52,0:16:26.39,Default,,0,0,0,,Бұл бала Мария Хименес
Dialogue: 0,0:16:22.52,0:16:26.39,Default,,0,0,0,,Мен 8 жастамын
Dialogue: 0,0:16:26.39,0:16:30.39,Default,,0,0,0,,Бұл өте белсенді сияқты.
Dialogue: 0,0:16:26.39,0:16:30.39,Default,,0,0,0,,Бұл Ошама-сан.
Dialogue: 0,0:16:30.39,0:16:32.53,Default,,0,0,0,,Бұл Джордж МакРэй
Dialogue: 0,0:16:30.39,0:16:32.53,Default,,0,0,0,,Бет
Dialogue: 0,0:16:32.53,0:16:35.06,Default,,0,0,0,,Жүк және басқа да ірі көліктер
Dialogue: 0,0:16:32.53,0:16:35.06,Default,,0,0,0,,Мен сені жақсы көремін.
Dialogue: 0,0:16:35.06,0:16:37.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:35.06,0:16:37.00,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:16:37.00,0:16:40.47,Default,,0,0,0,,Кристиан Фрум
Dialogue: 0,0:16:37.00,0:16:40.47,Default,,0,0,0,,Мен спортты жақсы көремін
Dialogue: 0,0:16:40.47,0:16:44.11,Default,,0,0,0,,Болашақта
Dialogue: 0,0:16:40.47,0:16:44.11,Default,,0,0,0,,Велосипедші болғыңыз келе ме?
Dialogue: 0,0:16:44.11,0:16:48.98,Default,,0,0,0,,Келесі бала - Аки Райсфилд.
Dialogue: 0,0:16:44.11,0:16:48.98,Default,,0,0,0,,Бұл үйдің ең жақсысы...
Dialogue: 0,0:16:48.98,0:17:00.56,Default,,0,0,0,,Сен
Dialogue: 0,0:17:00.56,0:17:03.43,Default,,0,0,0,,Сіздің ата-анаңыз өртте қайтыс болды.
Dialogue: 0,0:17:03.43,0:17:10.30,Default,,0,0,0,,Сондай-ақ көршілес аумақтағы күдікті өртке де қатысты.
Dialogue: 0,0:17:03.43,0:17:10.30,Default,,0,0,0,,Қандай бейшара бала...
Dialogue: 0,0:17:10.30,0:17:14.94,Default,,0,0,0,,«Шындығында, Уэноға бір ғана пойызбен жетуге болады»
Dialogue: 0,0:17:10.30,0:17:14.94,Default,,0,0,0,,Бұл бала – Арья құралы
Dialogue: 0,0:17:14.94,0:17:19.44,Default,,0,0,0,,Мен сәби кезімнен осындамын.
Dialogue: 0,0:17:19.44,0:17:22.71,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:17:22.71,0:17:25.95,Default,,0,0,0,,Қалай ойлайсың, Мандрейк?
Dialogue: 0,0:17:25.95,0:17:28.52,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:28.52,0:17:30.82,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:17:32.92,0:17:35.26,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:17:32.92,0:17:35.26,Default,,0,0,0,,Иә
Dialogue: 0,0:17:35.26,0:17:37.96,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:37.96,0:17:41.43,Default,,0,0,0,,Мен бармаймын!
Dialogue: 0,0:17:37.96,0:17:41.43,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:17:41.43,0:17:46.94,Default,,0,0,0,,Мен әрқашан сенің отбасың болғанын қалаймын
Dialogue: 0,0:17:41.43,0:17:46.94,Default,,0,0,0,,Біздің не күтетінімізді білесіз бе?
Dialogue: 0,0:17:46.94,0:17:50.47,Default,,0,0,0,,Бірақ бұл маған ұнамайды.
Dialogue: 0,0:17:46.94,0:17:50.47,Default,,0,0,0,,Мен Кастадпен бірге болғым келеді!
Dialogue: 0,0:17:50.47,0:17:52.41,Default,,0,0,0,,Жоқ, Ая
Dialogue: 0,0:17:52.41,0:17:57.35,Default,,0,0,0,,Бұл адамдар дәл сол жерде.
Dialogue: 0,0:17:52.41,0:17:57.35,Default,,0,0,0,,Сіз Лайм көшесінде тұрасыз.
Dialogue: 0,0:17:57.35,0:18:02.02,Default,,0,0,0,,Сіз және сіздің достарыңыз осында
Dialogue: 0,0:17:57.35,0:18:02.02,Default,,0,0,0,,Мен сенімен кездескім келсе, бірден кездесе аламын.
Dialogue: 0,0:18:02.02,0:18:06.35,Default,,0,0,0,,Мектеп қашан басталады
Dialogue: 0,0:18:02.02,0:18:06.35,Default,,0,0,0,,Сіз сондай-ақ Кьютердпен күнде кездесе аласыз.
Dialogue: 0,0:18:06.35,0:18:10.15,Default,,0,0,0,,А, мен сені кеңседе күтемін.
Dialogue: 0,0:18:14.06,0:18:16.70,Default,,0,0,0,,Мен оны жеп қойсаңыз екен.
Dialogue: 0,0:18:16.70,0:18:19.60,Default,,0,0,0,,Мен сізді кейін толтырамын.
Dialogue: 0,0:18:19.60,0:18:21.57,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:18:21.57,0:18:25.47,Default,,0,0,0,,Дайындық біткен соң, төменге тез түс.
Dialogue: 0,0:18:27.28,0:18:31.18,Default,,0,0,0,,(есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:18:35.98,0:18:38.55,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:18:38.55,0:18:41.05,Default,,0,0,0,,Ах~
Dialogue: 0,0:18:47.06,0:18:49.97,Default,,0,0,0,,«ҚҰЛАҚ»?
Dialogue: 0,0:18:49.97,0:18:52.17,Default,,0,0,0,,Хун
Dialogue: 0,0:18:57.21,0:19:00.61,Default,,0,0,0,,Жоқ… Оларды Эрен өлтірді!!
Dialogue: 0,0:19:00.61,0:19:02.91,Default,,0,0,0,,Ая
Dialogue: 0,0:19:11.82,0:19:14.22,Default,,0,0,0,,Ая…
Dialogue: 0,0:19:18.19,0:19:22.36,Default,,0,0,0,,Мен қаламайтын нәрсені жасауға мәжбүрлеу
Dialogue: 0,0:19:18.19,0:19:22.36,Default,,0,0,0,,Өмірімде бірінші рет
Dialogue: 0,0:19:22.36,0:19:25.17,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:19:25.17,0:19:49.82,Default,,0,0,0,,Сен
Dialogue: 0,0:19:49.82,0:19:52.62,Default,,0,0,0,,Бұл мүйіз екені сөзсіз.
Dialogue: 0,0:19:56.43,0:19:58.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:56.43,0:19:58.73,Default,,0,0,0,,(Тежегіш дыбысы)
Dialogue: 0,0:20:00.30,0:20:02.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:04.11,0:20:06.04,Default,,0,0,0,,Ах
Dialogue: 0,0:20:06.04,0:20:17.99,Default,,0,0,0,,Сен
Dialogue: 0,0:20:17.99,0:20:20.89,Default,,0,0,0,,Жарайды, мен жеңілемін деп ойлаймын.
Dialogue: 0,0:20:20.89,0:20:23.19,Default,,0,0,0,,Сен
Dialogue: 0,0:20:27.00,0:20:39.31,Default,,0,0,0,,Сен
Dialogue: 0,0:20:39.31,0:20:42.91,Default,,0,0,0,,№ 13. Hmph, күткендей.
Dialogue: 0,0:20:47.45,0:20:51.32,Default,,0,0,0,,О, бұл жақсы сезінеді.
Dialogue: 0,0:20:47.45,0:20:51.32,Default,,0,0,0,,Мен кез келген уақытта қашып кететін сияқтымын.
Dialogue: 0,0:20:51.32,0:20:53.32,Default,,0,0,0,,(Қақпа жабылған дыбыс)
Dialogue: 0,0:20:51.32,0:20:53.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:58.73,0:21:01.70,Default,,0,0,0,,(Мандраке)
Dialogue: 0,0:20:58.73,0:21:01.70,Default,,0,0,0,,Мен саған қалағаныңды алдым.
Dialogue: 0,0:21:01.70,0:21:05.43,Default,,0,0,0,,Бұдан былай мені мазалама.
Dialogue: 0,0:21:05.43,0:21:08.63,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:21:05.43,0:21:08.63,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:21:11.24,0:21:13.68,Default,,0,0,0,,Сіз осында ұйықтайсыз.
Dialogue: 0,0:21:13.68,0:21:18.21,Default,,0,0,0,,Ал, кейбір нәрселер.
Dialogue: 0,0:21:13.68,0:21:18.21,Default,,0,0,0,,Түсінікті айтайын.
Dialogue: 0,0:21:18.21,0:21:22.08,Default,,0,0,0,,Менің атым Бела Яга
Dialogue: 0,0:21:18.21,0:21:22.08,Default,,0,0,0,,Бұл сиқыршы.
Dialogue: 0,0:21:22.08,0:21:26.89,Default,,0,0,0,,Сені үйге кім әкелді?
Dialogue: 0,0:21:22.08,0:21:26.89,Default,,0,0,0,,Себебі мен көмек сұрадым.
Dialogue: 0,0:21:26.89,0:21:30.66,Default,,0,0,0,,Еңбек етсең
Dialogue: 0,0:21:26.89,0:21:30.66,Default,,0,0,0,,Мен сені ауыртпаймын.
Dialogue: 0,0:21:30.66,0:21:32.66,Default,,0,0,0,,(алақанның қабырғаға соғылған дыбысы)
Dialogue: 0,0:21:34.53,0:21:38.23,Default,,0,0,0,,Бірақ егер...
Dialogue: 0,0:21:38.23,0:21:40.90,Default,,0,0,0,,Керемет!
Dialogue: 0,0:21:38.23,0:21:40.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:40.90,0:21:47.14,Default,,0,0,0,,Жарайды. Әжем анама айтты
Dialogue: 0,0:21:40.90,0:21:47.14,Default,,0,0,0,,Ол болғысы келмеді.
Dialogue: 0,0:21:47.14,0:21:49.24,Default,,0,0,0,,Олай болса, шешілді.
Dialogue: 0,0:21:50.91,0:21:54.12,Default,,0,0,0,,Апай
Dialogue: 0,0:21:50.91,0:21:54.12,Default,,0,0,0,,Маған сиқырды үйреткеннің орнына
Dialogue: 0,0:21:54.12,0:21:56.82,Default,,0,0,0,,Мен апаңның көмекшісі боламын.
Dialogue: 0,0:21:56.82,0:22:00.12,Default,,0,0,0,,Хмф, мен түсінемін. Сосын шешілді.
Dialogue: 0,0:22:02.12,0:22:04.73,Default,,0,0,0,,Бұл жерге кірме
Dialogue: 0,0:22:04.73,0:22:06.73,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:22:09.56,0:22:12.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:12.23,0:22:23.75,Default,,0,0,0,,Сен
Dialogue: 0,0:22:23.75,0:22:25.71,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:22:25.71,0:22:29.65,Default,,0,0,0,,Хехехехехе!
Dialogue: 0,0:22:29.65,0:22:34.46,Default,,0,0,0,,Әй, оны киіп, осында кел.
Dialogue: 0,0:22:34.46,0:22:38.16,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:22:34.46,0:22:38.16,Default,,0,0,0,,Бұл сіздің жұмысыңыз емес.
Dialogue: 0,0:22:42.13,0:22:44.80,Default,,0,0,0,,Мұнда не болып жатқаны сізге ұнамаса.
Dialogue: 0,0:22:44.80,0:22:48.30,Default,,0,0,0,,Ақыр соңында оны тазалау керек.
Dialogue: 0,0:22:48.30,0:22:51.21,Default,,0,0,0,,Хехехехехе!
Dialogue: 0,0:22:51.21,0:22:53.17,Default,,0,0,0,,…Уау!
Dialogue: 0,0:22:53.17,0:22:56.38,Default,,0,0,0,,Енді мына егеуқұйрықтың сүйектерін сындырыңыз.
Dialogue: 0,0:22:56.38,0:22:59.15,Default,,0,0,0,,Оны ұнтаққа айналдырыңыз.
Dialogue: 0,0:22:59.15,0:23:01.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:01.08,0:23:03.45,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,0:23:03.45,0:23:05.75,Default,,0,0,0,,Уау... Ахх!
Dialogue: 0,0:23:05.75,0:23:10.53,Default,,0,0,0,,Айтпақшы, мына үйде біреу бар.
Dialogue: 0,0:23:05.75,0:23:10.53,Default,,0,0,0,,Маңызды ереже бар.
Dialogue: 0,0:23:10.53,0:23:13.33,Default,,0,0,0,,Қазір есіңізде болсын. Ұнады ма?
Dialogue: 0,0:23:13.33,0:23:16.83,Default,,0,0,0,,Не болса да, ешқашан
Dialogue: 0,0:23:16.83,0:23:20.34,Default,,0,0,0,,Мандраке
Dialogue: 0,0:23:16.83,0:23:20.34,Default,,0,0,0,,Сізді алаңдататын ештеңе жасамаңыз
Dialogue: 0,0:23:20.34,0:23:22.27,Default,,0,0,0,,Мандраке?
Dialogue: 0,0:23:22.27,0:23:25.84,Default,,0,0,0,,Оның басында мүйіздері бар.
Dialogue: 0,0:23:22.27,0:23:25.84,Default,,0,0,0,,Ағаң ше?
Dialogue: 0,0:23:25.84,0:23:28.44,Default,,0,0,0,,Мүйіздер жоқ!
Dialogue: 0,0:23:30.15,0:23:33.35,Default,,0,0,0,,Негізінен.
Dialogue: 0,0:23:33.35,0:23:37.22,Default,,0,0,0,,Мен ашуланып, ашуланғанда ғана
Dialogue: 0,0:23:33.35,0:23:37.22,Default,,0,0,0,,Ол өседі
Dialogue: 0,0:23:37.22,0:23:40.86,Default,,0,0,0,,Қарт ашуланғанда тағы не болады?
Dialogue: 0,0:23:40.86,0:23:43.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:43.83,0:23:48.10,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:23:48.10,0:23:51.37,Default,,0,0,0,,Егер бақытыңыз болса, сізге білудің қажеті жоқ.
Dialogue: 0,0:23:51.37,0:23:54.67,Default,,0,0,0,,Жүр, жұмысқа кірісейік.
Dialogue: 0,0:24:05.38,0:24:09.25,Default,,0,0,0,,Әй, апа, мына ұнтақты не үшін қолданасыз?
Dialogue: 0,0:24:09.25,0:24:11.85,Default,,0,0,0,,Сен мұнымен сиқыр жасай аласың ба?
Dialogue: 0,0:24:11.85,0:24:14.76,Default,,0,0,0,,Ұсақталғанша ұнтақтаңыз.
Dialogue: 0,0:24:14.76,0:24:17.19,Default,,0,0,0,,Ұннан көп
Dialogue: 0,0:24:17.19,0:24:20.09,Default,,0,0,0,,Ей, қандай сиқыр? Оны кім пайдаланады?
Dialogue: 0,0:24:20.09,0:24:22.86,Default,,0,0,0,,Апай? Әлде ағай?
Dialogue: 0,0:24:22.86,0:24:25.76,Default,,0,0,0,,Аузыңды емес, қолыңды пайдалан, ақымақ!
Dialogue: 0,0:24:28.04,0:24:31.54,Default,,0,0,0,,Уф! Күрсін...
Dialogue: 0,0:24:31.54,0:24:34.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:34.41,0:24:36.41,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:24:43.45,0:24:45.42,Default,,0,0,0,,Ой, бұл қызық!
Dialogue: 0,0:24:45.42,0:24:48.79,Default,,0,0,0,,Мен саған қолыңды қозғама дедім!
Dialogue: 0,0:24:48.79,0:24:51.29,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:24:51.29,0:24:55.70,Default,,0,0,0,,Міне, менің танысым...
Dialogue: 0,0:24:55.70,0:24:58.00,Default,,0,0,0,,Томас! Сіздің кезегіңіз!
Dialogue: 0,0:25:00.00,0:25:02.00,Default,,0,0,0,,Анчоко?
Dialogue: 0,0:25:05.74,0:25:07.74,Default,,0,0,0,,Фудяо!
Dialogue: 0,0:25:16.38,0:25:18.32,Default,,0,0,0,,Мияу!
Dialogue: 0,0:25:16.38,0:25:18.32,Default,,0,0,0,,
Dialogue: 0,0:25:18.32,0:25:21.22,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:25:18.32,0:25:21.22,Default,,0,0,0,,
Dialogue: 0,0:25:21.22,0:25:25.09,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:25:21.22,0:25:25.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:25.09,0:25:29.76,Default,,0,0,0,,О, ханым
Dialogue: 0,0:25:25.09,0:25:29.76,Default,,0,0,0,,Иә, мен Бела Ягамын.
Dialogue: 0,0:25:29.76,0:25:32.80,Default,,0,0,0,,Поо!
Dialogue: 0,0:25:29.76,0:25:32.80,Default,,0,0,0,,Ұзақ уақыт үшін кешіріңіз.
Dialogue: 0,0:25:32.80,0:25:37.44,Default,,0,0,0,,Иә. Иә Иә Иә
Dialogue: 0,0:25:37.44,0:25:40.34,Default,,0,0,0,,Немерең...
Dialogue: 0,0:25:40.34,0:25:42.94,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:25:42.94,0:25:45.85,Default,,0,0,0,,«Ит шоуында жеңіске жету үшін жазу»?
Dialogue: 0,0:25:45.85,0:25:48.45,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:25:48.45,0:25:54.32,Default,,0,0,0,,«Балет рециталындағы басты рөлді алып тастау емлесі»
Dialogue: 0,0:25:48.45,0:25:54.32,Default,,0,0,0,,, солай ма?
Dialogue: 0,0:25:54.32,0:25:57.46,Default,,0,0,0,,Охохохо...! Маған қалдырыңыз
Dialogue: 0,0:25:57.46,0:26:01.30,Default,,0,0,0,,«Көршінің бақшасында гүлгүлді өлтіруге арналған сиқыр» ...
Dialogue: 0,0:26:01.30,0:26:06.17,Default,,0,0,0,,Сізге қанша керек?
Dialogue: 0,0:26:01.30,0:26:06.17,Default,,0,0,0,,«Көшедегі балаға дәрі»?
Dialogue: 0,0:26:06.17,0:26:09.17,Default,,0,0,0,,Бұлардың ешқайсысы пайдалы емес сияқты.
Dialogue: 0,0:26:09.17,0:26:11.94,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:26:11.94,0:26:17.14,Default,,0,0,0,,Мен оны сізге бірден әкелемін. Иә.
Dialogue: 0,0:26:11.94,0:26:17.14,Default,,0,0,0,,Қайырлы күн
Dialogue: 0,0:26:21.68,0:26:23.69,Default,,0,0,0,,Томас!
Dialogue: 0,0:26:23.69,0:26:28.69,Default,,0,0,0,,Томас! Мен сенің айтқаныңды тыңдауым керек
Dialogue: 0,0:26:23.69,0:26:28.69,Default,,0,0,0,,Мен саған жауын құрттарын тамақтандырамын.
Dialogue: 0,0:26:30.83,0:26:35.43,Default,,0,0,0,,Томас! Томас! Томас!
Dialogue: 0,0:26:35.43,0:26:37.73,Default,,0,0,0,,Томас…
Dialogue: 0,0:26:39.93,0:26:42.84,Default,,0,0,0,,Өзіңіз шығарған жынды күшке ие болу үшін пайдаланыңыз.
Dialogue: 0,0:26:42.84,0:26:47.74,Default,,0,0,0,,Әйел өзінің үй жануары Көкнәр итіне қамқорлық жасайды.
Dialogue: 0,0:26:42.84,0:26:47.74,Default,,0,0,0,,Маған ит шоуында жеңіске жетуге рұқсат етіңіз
Dialogue: 0,0:26:49.94,0:26:54.45,Default,,0,0,0,,Kvintere Sun Ptereptelea
Dialogue: 0,0:26:49.94,0:26:54.45,Default,,0,0,0,,Күн Квинтеле
Dialogue: 0,0:26:54.45,0:26:58.95,Default,,0,0,0,,Квентур Брестен
Dialogue: 0,0:26:54.45,0:26:58.95,Default,,0,0,0,,Брестемур Кванте
Dialogue: 0,0:26:58.95,0:27:02.82,Default,,0,0,0,,Kvintere Sun Ptereptelea
Dialogue: 0,0:26:58.95,0:27:02.82,Default,,0,0,0,,Күн Квинтеле
Dialogue: 0,0:27:02.82,0:27:08.12,Default,,0,0,0,,Квентур Брестен
Dialogue: 0,0:27:02.82,0:27:08.12,Default,,0,0,0,,Брестемур Кванте
Dialogue: 0,0:27:12.50,0:27:14.50,Default,,0,0,0,,Күлгін гүлдерінің иісі
Dialogue: 0,0:27:17.24,0:27:19.31,Default,,0,0,0,,Маған мылқаулықпен қарама!
Dialogue: 0,0:27:19.31,0:27:23.21,Default,,0,0,0,,Кешке дейін қандай жұмыс істеу керек?
Dialogue: 0,0:27:19.31,0:27:23.21,Default,,0,0,0,,Олар өте көп.
Dialogue: 0,0:27:27.32,0:27:29.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:29.25,0:27:33.05,Default,,0,0,0,,«Ең төменгі температура 25 градус, максималды температура...»
Dialogue: 0,0:27:36.12,0:27:38.26,Default,,0,0,0,,Келіңдер, жындар...
Dialogue: 0,0:27:38.26,0:27:40.19,Default,,0,0,0,,(тоңазытқыш есігінің жабылу дыбысы)
Dialogue: 0,0:27:40.19,0:27:43.19,Default,,0,0,0,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:27:40.19,0:27:43.19,Default,,0,0,0,,Қызық, өзіңмен не ала келдің~
Dialogue: 0,0:27:44.97,0:27:48.54,Default,,0,0,0,,Сток-он-Трент станциясы
Dialogue: 0,0:27:44.97,0:27:48.54,Default,,0,0,0,,Мен оны асханадан алдым.
Dialogue: 0,0:27:48.54,0:27:51.27,Default,,0,0,0,,Пирог пен картоп
Dialogue: 0,0:27:51.27,0:27:55.88,Default,,0,0,0,,Вокзалдағы бәліш... мен жек көретінім осы.
Dialogue: 0,0:27:55.88,0:27:59.75,Default,,0,0,0,,Хмм...!
Dialogue: 0,0:27:55.88,0:27:59.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:59.75,0:28:02.75,Default,,0,0,0,,Бұл менің сүйікті тағамым.
Dialogue: 0,0:28:05.55,0:28:08.06,Default,,0,0,0,,Мен станция пирогтарын жақсы көремін!
Dialogue: 0,0:28:08.06,0:28:10.93,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:28:10.93,0:28:12.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:17.60,0:28:20.50,Default,,0,0,0,,Айтарымды тәтем тыңдамас бұрын...
Dialogue: 0,0:28:20.50,0:28:22.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:28:22.44,0:28:24.74,Default,,0,0,0,,Мен өзімді қорғауым керек.
Dialogue: 0,0:28:29.28,0:28:33.41,Default,,0,0,0,,Өзіңізді ұстай алмасаңыз
Dialogue: 0,0:28:29.28,0:28:33.41,Default,,0,0,0,,Тек қашып кет.
Dialogue: 0,0:28:33.41,0:28:38.15,Default,,0,0,0,,...
Dialogue: 0,0:28:33.41,0:28:38.15,Default,,0,0,0,,Маған бұл өте қажет.
Dialogue: 0,0:28:38.15,0:28:43.05,Default,,0,0,0,,Кешіріңіз. Сонда мен сенен көмек сұрадым.
Dialogue: 0,0:28:51.43,0:28:53.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:53.37,0:28:55.47,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:29:18.53,0:29:35.74,Default,,0,0,0,,Сен
Dialogue: 0,0:29:35.74,0:29:37.81,Default,,0,0,0,,Роман?
Dialogue: 0,0:29:37.81,0:29:40.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:40.72,0:29:43.25,Default,,0,0,0,,Бұл не? Бұл өте қызықсыз.
Dialogue: 0,0:29:43.25,0:29:45.92,Default,,0,0,0,,Мен оны сізге қайта жаза аламын ба?
Dialogue: 0,0:29:45.92,0:29:50.39,Default,,0,0,0,,Бұл! Уф...
Dialogue: 0,0:29:50.39,0:29:53.29,Default,,0,0,0,,Уф…!
Dialogue: 0,0:29:50.39,0:29:53.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:53.29,0:29:55.26,Default,,0,0,0,,Бұл!
Dialogue: 0,0:29:55.26,0:29:57.56,Default,,0,0,0,,Он… бе… с…
Dialogue: 0,0:30:00.87,0:30:02.87,Default,,0,0,0,,Ах...!
Dialogue: 0,0:30:08.14,0:30:10.65,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:30:10.65,0:30:12.95,Default,,0,0,0,,Жарайды! Келесі!
Dialogue: 0,0:30:18.52,0:30:20.52,Default,,0,0,0,,Уф!
Dialogue: 0,0:30:22.86,0:30:25.16,Default,,0,0,0,,А... қарғыс атсын!
Dialogue: 0,0:30:34.27,0:30:37.27,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:30:59.29,0:31:01.29,Default,,0,0,0,,«ҚҰЛАҚ»?
Dialogue: 0,0:31:05.13,0:31:07.67,Default,,0,0,0,,Пуха!
Dialogue: 0,0:31:07.67,0:31:09.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:09.60,0:31:18.31,Default,,0,0,0,,Сен
Dialogue: 0,0:31:18.31,0:31:22.18,Default,,0,0,0,,Алдыңғы есік жоғалып кетті...
Dialogue: 0,0:31:22.18,0:31:24.15,Default,,0,0,0,,(дыбыс тербелетін терезе жақтауы)
Dialogue: 0,0:31:24.15,0:31:27.15,Default,,0,0,0,,Уф...! Уау!
Dialogue: 0,0:31:27.15,0:31:30.89,Default,,0,0,0,,Уф! Қарғыс атқыр...
Dialogue: 0,0:31:30.89,0:31:33.49,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:31:33.49,0:31:36.70,Default,,0,0,0,,Қабырғаға жабысу
Dialogue: 0,0:31:36.70,0:31:53.88,Default,,0,0,0,,Сен
Dialogue: 0,0:31:53.88,0:31:58.58,Default,,0,0,0,,Боқ~ Толығымен қамалған.
Dialogue: 0,0:32:01.19,0:32:04.59,Default,,0,0,0,,Бұл менің бірінші рет жалғыз ұйықтауым болуы мүмкін.
Dialogue: 0,0:32:10.93,0:32:15.70,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:32:15.70,0:32:18.50,Default,,0,0,0,,Оян! жалқау!
Dialogue: 0,0:32:27.95,0:32:32.35,Default,,0,0,0,,Өйткені оны менен басқа ешкім қолданбайды.
Dialogue: 0,0:32:35.82,0:32:37.96,Default,,0,0,0,,(Түкірген судың дыбысы)
Dialogue: 0,0:32:37.96,0:32:40.86,Default,,0,0,0,,Жуынатын бөлме менікі
Dialogue: 0,0:32:46.37,0:32:48.37,Default,,0,0,0,,(есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:32:54.08,0:32:56.14,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:32:56.14,0:32:59.78,Default,,0,0,0,,Ақырында
Dialogue: 0,0:32:56.14,0:32:59.78,Default,,0,0,0,,Мен саған таңғы ас әзірлеп берейін.
Dialogue: 0,0:32:59.78,0:33:02.08,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:33:02.08,0:33:06.75,Default,,0,0,0,,Әй, апаң қайда ұйықтап жатыр?
Dialogue: 0,0:33:02.08,0:33:06.75,Default,,0,0,0,,Мен өз бөлмемді таба алмай жатырмын.
Dialogue: 0,0:33:06.75,0:33:10.29,Default,,0,0,0,,Қажетсіз аңду жасамаңыз.
Dialogue: 0,0:33:10.29,0:33:14.59,Default,,0,0,0,,Егер мені тыңдамасаң
Dialogue: 0,0:33:10.29,0:33:14.59,Default,,0,0,0,,Апай, маған не істейсіз?
Dialogue: 0,0:33:16.53,0:33:18.93,Default,,0,0,0,,Мен саған жауын құрттарын тамақтандырамын
Dialogue: 0,0:33:20.50,0:33:27.54,Default,,0,0,0,,Гунегуне жоқ Такур
Dialogue: 0,0:33:20.50,0:33:27.54,Default,,0,0,0,,Бұл көк және күлгін және ол үлкен.
Dialogue: 0,0:33:27.54,0:33:29.54,Default,,0,0,0,,әйелдерді нысанаға алған қанды қырғын жылдары
Dialogue: 0,0:33:36.55,0:33:39.45,Default,,0,0,0,,Мен бақсы болсам да, кір жуғыш машинаны қолданамын.
Dialogue: 0,0:33:39.45,0:33:41.52,Default,,0,0,0,,Шатаспаңыз
Dialogue: 0,0:33:41.52,0:33:45.56,Default,,0,0,0,,Себетті тез толтырыңыз
Dialogue: 0,0:33:41.52,0:33:45.56,Default,,0,0,0,,Барып қалақай алып кел!
Dialogue: 0,0:33:45.56,0:33:47.56,Default,,0,0,0,,Хмм! Ах…
Dialogue: 0,0:33:50.06,0:33:52.16,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:33:53.93,0:33:56.57,Default,,0,0,0,,Ах, а... Ита-та-та-та-та!
Dialogue: 0,0:33:56.57,0:34:00.47,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:33:56.57,0:34:00.47,Default,,0,0,0,,Ол жерден қашып құтыла алмайсың.
Dialogue: 0,0:34:02.11,0:34:04.61,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:34:04.61,0:34:09.48,Default,,0,0,0,,Ал, мандраке.
Dialogue: 0,0:34:04.61,0:34:09.48,Default,,0,0,0,,Менде жындар бар.
Dialogue: 0,0:34:09.48,0:34:11.49,Default,,0,0,0,,И-иә… дұрыс
Dialogue: 0,0:34:11.49,0:34:13.92,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:34:11.49,0:34:13.92,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:34:13.92,0:34:18.63,Default,,0,0,0,,Мандрашкада да шебер бол
Dialogue: 0,0:34:13.92,0:34:18.63,Default,,0,0,0,,Сіз оны манипуляциялай білуіңіз керек.
Dialogue: 0,0:34:18.63,0:34:21.53,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:34:21.53,0:34:25.27,Default,,0,0,0,,(Микшердің жұмыс дыбысы)
Dialogue: 0,0:34:25.27,0:34:27.77,Default,,0,0,0,,Қараңыз! Бос тұрмаңыз
Dialogue: 0,0:34:27.77,0:34:29.97,Default,,0,0,0,,Тез кесіңіз
Dialogue: 0,0:34:31.64,0:34:35.04,Default,,0,0,0,,Сәлем апай
Dialogue: 0,0:34:31.64,0:34:35.04,Default,,0,0,0,,Ол қандай сиқыр үшін қолданылады?
Dialogue: 0,0:34:36.61,0:34:39.38,Default,,0,0,0,,Хун
Dialogue: 0,0:34:39.38,0:34:42.65,Default,,0,0,0,,Сол нәрсені тез аяқтаңыз.
Dialogue: 0,0:34:42.65,0:34:45.15,Default,,0,0,0,,Сонда маған айтасың ба?
Dialogue: 0,0:34:45.15,0:34:48.35,Default,,0,0,0,,Дайын болғаннан кейін Bryonia жемісін ұсақтаңыз.
Dialogue: 0,0:34:50.09,0:34:53.19,Default,,0,0,0,,Қолмен.
Dialogue: 0,0:34:50.09,0:34:53.19,Default,,0,0,0,,Қолмен.
Dialogue: 0,0:34:59.20,0:35:03.64,Default,,0,0,0,,Дайын!
Dialogue: 0,0:34:59.20,0:35:03.64,Default,,0,0,0,,Әй, апа, маған сиқыр үйретші.
Dialogue: 0,0:35:03.64,0:35:07.17,Default,,0,0,0,,Аулаға барып, ошағандарды ал.
Dialogue: 0,0:35:07.17,0:35:09.47,Default,,0,0,0,,Тез орындаңыз!
Dialogue: 0,0:35:12.65,0:35:15.55,Default,,0,0,0,,Тікен неге көп!
Dialogue: 0,0:35:17.25,0:35:19.19,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:35:19.19,0:35:21.66,Default,,0,0,0,,Қалақай жетпейді.
Dialogue: 0,0:35:21.66,0:35:24.19,Default,,0,0,0,,Барып қалақай алып кел.
Dialogue: 0,0:35:24.19,0:35:28.53,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:35:24.19,0:35:28.53,Default,,0,0,0,,Маған сиқырды қашан үйретесің?
Dialogue: 0,0:35:28.53,0:35:31.97,Default,,0,0,0,,«Қайтадан» деген не?
Dialogue: 0,0:35:31.97,0:35:35.47,Default,,0,0,0,,Және бұталар
Dialogue: 0,0:35:31.97,0:35:35.47,Default,,0,0,0,,Толық себетті алыңыз.
Dialogue: 0,0:35:35.47,0:35:37.47,Default,,0,0,0,,Тез жүр!
Dialogue: 0,0:35:39.17,0:35:41.47,Default,,0,0,0,,Содан бір күні бір сәуле жарқырап түсті,
Dialogue: 0,0:35:46.68,0:35:49.58,Default,,0,0,0,,24 дана жылан терісі жыртылған
Dialogue: 0,0:35:49.58,0:35:54.56,Default,,0,0,0,,Маған сиқырды үйрет
Dialogue: 0,0:35:49.58,0:35:54.56,Default,,0,0,0,,Белладонна жапырақтарын алыңыз. 120 жапырақ.
Dialogue: 0,0:35:54.56,0:35:57.76,Default,,0,0,0,,Томас!
Dialogue: 0,0:35:54.56,0:35:57.76,Default,,0,0,0,,Хмф!
Dialogue: 0,0:36:03.73,0:36:05.67,Default,,0,0,0,,Уф! мм...
Dialogue: 0,0:36:05.67,0:36:07.60,Default,,0,0,0,,Мынаны да жуу керек.
Dialogue: 0,0:36:07.60,0:36:09.90,Default,,0,0,0,,(ауызбен тыныс алу кезінде)
Dialogue: 0,0:36:07.60,0:36:09.90,Default,,0,0,0,,Ол да.
Dialogue: 0,0:36:11.94,0:36:14.84,Default,,0,0,0,,Барлығы раковинада.
Dialogue: 0,0:36:14.84,0:36:17.41,Default,,0,0,0,,Барлығы.
Dialogue: 0,0:36:17.41,0:36:19.41,Default,,0,0,0,,...Иә?
Dialogue: 0,0:36:25.95,0:36:27.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:27.89,0:36:31.46,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:36:27.89,0:36:31.46,Default,,0,0,0,,Тез аяқтаңыз.
Dialogue: 0,0:36:31.46,0:36:34.36,Default,,0,0,0,,Ей, маған да рұқсат етіңізші!
Dialogue: 0,0:36:34.36,0:36:37.97,Default,,0,0,0,,Сіз тек айтқаныңызды орындайсыз.
Dialogue: 0,0:36:34.36,0:36:37.97,Default,,0,0,0,,Тек орындаңыз!
Dialogue: 0,0:36:37.97,0:36:42.84,Default,,0,0,0,,
Dialogue: 0,0:36:37.97,0:36:42.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:42.84,0:36:46.47,Default,,0,0,0,,
Dialogue: 0,0:36:42.84,0:36:46.47,Default,,0,0,0,,Хмф!
Dialogue: 0,0:36:46.47,0:36:48.47,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:36:46.47,0:36:48.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:36:50.34,0:36:55.48,Default,,0,0,0,,Мм! Әлгі кемпір!
Dialogue: 0,0:36:55.48,0:36:58.98,Default,,0,0,0,,Маған сиқыр үйретейін деген ниетіңіз жоқ.
Dialogue: 0,0:37:00.82,0:37:04.49,Default,,0,0,0,,(ﾃﾞｰﾓﾝ)
Dialogue: 0,0:37:04.49,0:37:08.36,Default,,0,0,0,,Маған табақты беріңіз. Бұл Уинтерфордтықі.
Dialogue: 0,0:37:08.36,0:37:11.96,Default,,0,0,0,,Сізге көп рахмет, ұстаз.
Dialogue: 0,0:37:14.03,0:37:15.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:15.97,0:37:18.01,Default,,0,0,0,,Бүгін түнде Silver Hines-те
Dialogue: 0,0:37:18.01,0:37:21.18,Default,,0,0,0,,«Балық пен чипсы» алыңыз
Dialogue: 0,0:37:21.18,0:37:23.48,Default,,0,0,0,,Сіз айтқандай!
Dialogue: 0,0:37:26.51,0:37:28.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:32.39,0:37:36.09,Default,,0,0,0,,Сиқыр шынымен сасық.
Dialogue: 0,0:37:40.83,0:37:43.33,Default,,0,0,0,,Керемет мандрака.
Dialogue: 0,0:37:43.33,0:37:45.33,Default,,0,0,0,,…Ах
Dialogue: 0,0:37:49.14,0:37:51.21,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:37:51.21,0:37:56.31,Default,,0,0,0,,Тек мандрака
Dialogue: 0,0:37:51.21,0:37:56.31,Default,,0,0,0,,Сіз жындарды басқара аласыз, солай ма?
Dialogue: 0,0:37:58.68,0:38:03.35,Default,,0,0,0,,Мен мандрака сияқты едім
Dialogue: 0,0:37:58.68,0:38:03.35,Default,,0,0,0,,Мүмкін ол өмір сүрген шығар...
Dialogue: 0,0:38:03.35,0:38:05.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:05.35,0:38:09.69,Default,,0,0,0,,Мен Кстардпен кездескім келеді
Dialogue: 0,0:38:09.69,0:38:13.69,Default,,0,0,0,,Мен не туралы айтқым келеді
Dialogue: 0,0:38:09.69,0:38:13.69,Default,,0,0,0,,Қаншама көп болса да...
Dialogue: 0,0:38:15.43,0:38:18.83,Default,,0,0,0,,(Есік ашылу дыбысы)
Dialogue: 0,0:38:21.00,0:38:23.37,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:38:21.00,0:38:23.37,Default,,0,0,0,,Мияу
Dialogue: 0,0:38:23.37,0:38:26.17,Default,,0,0,0,,Томас?
Dialogue: 0,0:38:31.11,0:38:33.75,Default,,0,0,0,,Әлгі кемпір мені қатты пайдаланды.
Dialogue: 0,0:38:33.75,0:38:36.62,Default,,0,0,0,,Біз қиыншылыққа тап болдық, солай емес пе, Кютер?
Dialogue: 0,0:38:36.62,0:38:38.55,Default,,0,0,0,,…Няо
Dialogue: 0,0:38:38.55,0:38:40.62,Default,,0,0,0,,Бұл болмады. Томас
Dialogue: 0,0:38:40.62,0:38:44.29,Default,,0,0,0,,Өйткені сен
Dialogue: 0,0:38:40.62,0:38:44.29,Default,,0,0,0,,Бұл қаймақ сияқты.
Dialogue: 0,0:38:44.29,0:38:46.89,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:38:50.63,0:38:59.87,Default,,0,0,0,,～(Don't disturb me)
Dialogue: 0,0:38:59.87,0:39:09.15,Default,,0,0,0,,Сен
Dialogue: 0,0:39:09.15,0:39:13.99,Rubi,,0,0,0,,Йодо
Dialogue: 0,0:39:09.15,0:39:13.99,Default,,0,0,0,,...
Dialogue: 0,0:39:13.99,0:39:18.59,Default,,0,0,0,,Сен
Dialogue: 0,0:39:13.99,0:39:18.59,Default,,0,0,0,,Уау! Маған бұл крем ұнайды!
Dialogue: 0,0:39:18.59,0:39:20.53,Default,,0,0,0,,Сен
Dialogue: 0,0:39:18.59,0:39:20.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:39:20.53,0:39:27.27,Default,,0,0,0,,Сен
Dialogue: 0,0:39:27.27,0:39:29.60,Default,,0,0,0,,Сен
Dialogue: 0,0:39:27.27,0:39:29.60,Default,,0,0,0,,Қараңызшы, қаймақ.
Dialogue: 0,0:39:29.60,0:39:32.94,Default,,0,0,0,,Сен
Dialogue: 0,0:39:29.60,0:39:32.94,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:39:32.94,0:39:36.18,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,0:39:36.18,0:39:38.38,Default,,0,0,0,,(Түкірген судың дыбысы)
Dialogue: 0,0:39:43.32,0:39:46.19,Default,,0,0,0,,Қайырлы таң апай! Қандай керемет таң!
Dialogue: 0,0:39:46.19,0:39:50.59,Default,,0,0,0,,...
Dialogue: 0,0:39:46.19,0:39:50.59,Default,,0,0,0,,Сіз оны кептіріңіз.
Dialogue: 0,0:39:52.96,0:39:59.13,Default,,0,0,0,,23… 24…
Dialogue: 0,0:39:59.13,0:40:02.54,Default,,0,0,0,,25
Dialogue: 0,0:40:02.54,0:40:06.11,Default,,0,0,0,,24…
Dialogue: 0,0:40:06.11,0:40:10.54,Default,,0,0,0,,23... Иә? Неше жаста?
Dialogue: 0,0:40:10.54,0:40:14.15,Default,,0,0,0,,Мұқият қабылдамасаң, сені жауын құрт жазалайды.
Dialogue: 0,0:40:14.15,0:40:17.68,Default,,0,0,0,,Санау туралы
Dialogue: 0,0:40:14.15,0:40:17.68,Default,,0,0,0,,Тіпті кемпірдің де қолынан келеді, солай ма?
Dialogue: 0,0:40:17.68,0:40:23.16,Default,,0,0,0,,Мен көрегенмін.
Dialogue: 0,0:40:17.68,0:40:23.16,Default,,0,0,0,,Сіз соншалықты кішкентай нәрсені көре аласыз ба?
Dialogue: 0,0:40:23.16,0:40:25.66,Default,,0,0,0,,Басшымен бірдей.
Dialogue: 0,0:40:25.66,0:40:27.59,Default,,0,0,0,,Керек емес сөздерді айтпа
Dialogue: 0,0:40:27.59,0:40:31.30,Default,,0,0,0,,Тритонның көзі бітсе, тұз түйірлері!
Dialogue: 0,0:40:31.30,0:40:34.60,Default,,0,0,0,,Миллипед аяқтары! Рододендрон тұқымдары!
Dialogue: 0,0:40:34.60,0:40:38.41,Default,,0,0,0,,егеуқұйрық тырнақтары! Барлығы санайды
Dialogue: 0,0:40:38.41,0:40:42.34,Default,,0,0,0,,Ойсыз болсаң қасыңа жауын құрт келеді!
Dialogue: 0,0:40:42.34,0:40:47.41,Default,,0,0,0,,(Жаңбыр дыбысы)
Dialogue: 0,0:40:47.41,0:40:51.92,Default,,0,0,0,,Не! Жауын құрты Жер құрты Жер құрты!
Dialogue: 0,0:40:51.92,0:40:54.82,Default,,0,0,0,,О, сен сондай жамансың!
Dialogue: 0,0:40:54.82,0:40:58.43,Default,,0,0,0,,Бұл мүйіз емес, есек құлағы.
Dialogue: 0,0:40:58.43,0:41:02.03,Default,,0,0,0,,Ағайдың жүзі ондай емес...
Dialogue: 0,0:41:05.93,0:41:08.73,Default,,0,0,0,,Хмм, бұл дұрыс емес.
Dialogue: 0,0:41:14.47,0:41:16.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:20.05,0:41:22.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:24.45,0:41:27.42,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:41:27.42,0:41:30.26,Default,,0,0,0,,Бұл мандрака.
Dialogue: 0,0:41:30.26,0:41:34.46,Default,,0,0,0,,Оның бөлмесі осы жерде.
Dialogue: 0,0:41:34.46,0:41:36.96,Default,,0,0,0,,Сіз сөйлеп тұрсыз!
Dialogue: 0,0:41:36.96,0:41:39.97,Default,,0,0,0,,Мен онша сөйлейтін емеспін.
Dialogue: 0,0:41:39.97,0:41:43.47,Default,,0,0,0,,Бұл суретті салуды тоқтату керек.
Dialogue: 0,0:41:43.47,0:41:46.77,Default,,0,0,0,,Өйткені бұл Мандрейкті мазалайтын сияқты.
Dialogue: 0,0:41:49.01,0:41:50.94,Default,,0,0,0,,Әй!
Dialogue: 0,0:41:50.94,0:41:54.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:50.94,0:41:54.48,Default,,0,0,0,,Эй, сен заклинание туралы бірдеңе білесің бе?
Dialogue: 0,0:41:54.48,0:41:58.45,Default,,0,0,0,,Иә, өте жақсы. Мен сенен артық білемін деп ойлаймын.
Dialogue: 0,0:41:58.45,0:42:02.09,Default,,0,0,0,,Мен оның кітабын ақтарып отырғаныңды көрдім.
Dialogue: 0,0:42:02.09,0:42:06.46,Default,,0,0,0,,Мүмкін сіз ең білгіңіз келетін заклинание
Dialogue: 0,0:42:02.09,0:42:06.46,Default,,0,0,0,,Бұл аяқталуға жақын.
Dialogue: 0,0:42:06.46,0:42:08.40,Default,,0,0,0,,Қайсысын айтайын ба?
Dialogue: 0,0:42:08.40,0:42:10.96,Default,,0,0,0,,Иә, өтінемін!
Dialogue: 0,0:42:10.96,0:42:13.53,Default,,0,0,0,,Әзірге осы кәріз арқылы қашып өтуім керек
Dialogue: 0,0:42:13.53,0:42:17.50,Default,,0,0,0,,Мандрака бөлмесі бар
Dialogue: 0,0:42:13.53,0:42:17.50,Default,,0,0,0,,Бұл мүлде мүмкін емес
Dialogue: 0,0:42:17.50,0:42:19.84,Default,,0,0,0,,Мұнда жуынатын бөлме бар.
Dialogue: 0,0:42:19.84,0:42:23.58,Default,,0,0,0,,Иә, мен білемін. Бірақ бар.
Dialogue: 0,0:42:23.58,0:42:25.55,Default,,0,0,0,,Хмм.
Dialogue: 0,0:42:25.55,0:42:28.18,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:42:28.18,0:42:33.58,Default,,0,0,0,,
Dialogue: 0,0:42:35.49,0:42:39.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:35.49,0:42:39.06,Default,,0,0,0,,(жылжымалы есік тұтқасының дыбысы)
Dialogue: 0,0:42:39.06,0:42:41.36,Default,,0,0,0,,(тырналған дыбыс)
Dialogue: 0,0:42:43.76,0:42:55.81,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:42:55.81,0:42:58.58,Default,,0,0,0,,Уау! лас!
Dialogue: 0,0:42:58.58,0:43:01.48,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:42:58.58,0:43:01.48,Default,,0,0,0,,Тек оны кейінірек жалап тазалаңыз.
Dialogue: 0,0:43:01.48,0:43:03.48,Default,,0,0,0,,Жалау...
Dialogue: 0,0:43:07.29,0:43:10.32,Default,,0,0,0,,Білесің бе, оны жайына қалдыр.
Dialogue: 0,0:43:10.32,0:43:13.09,Default,,0,0,0,,Соңғы беттен бұрылу
Dialogue: 0,0:43:13.09,0:43:15.29,Default,,0,0,0,,Мен саған тоқта дегенше.
Dialogue: 0,0:43:16.96,0:43:19.77,Default,,0,0,0,,«Көп жауын құрттарын қалай жасауға болады»?
Dialogue: 0,0:43:19.77,0:43:22.10,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:43:19.77,0:43:22.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:22.10,0:43:26.94,Default,,0,0,0,,«Шіркеу базарын қирату
Dialogue: 0,0:43:22.10,0:43:26.94,Default,,0,0,0,,Дауыл қалай жасалады»
Dialogue: 0,0:43:26.94,0:43:30.44,Default,,0,0,0,,«Автобустың уақытында келуі үшін жазу»
Dialogue: 0,0:43:30.44,0:43:33.15,Default,,0,0,0,,«Сиқырдың барлық түрінен қорғайтын заклинание».
Dialogue: 0,0:43:33.15,0:43:36.42,Default,,0,0,0,,Тоқта! Бізге керегі де сол
Dialogue: 0,0:43:36.42,0:43:40.99,Default,,0,0,0,,Егер сіз бұл сиқырды қолдансаңыз
Dialogue: 0,0:43:36.42,0:43:40.99,Default,,0,0,0,,Бақсы енді бізге тиісе алмайды.
Dialogue: 0,0:43:40.99,0:43:43.29,Default,,0,0,0,,Е, бірақ қаймақ
Dialogue: 0,0:43:43.29,0:43:45.23,Default,,0,0,0,,... солай емес пе, Томас?
Dialogue: 0,0:43:45.23,0:43:48.43,Default,,0,0,0,,Бұл жүздеген түрлі материалдарды қажет ететін сияқты.
Dialogue: 0,0:43:48.43,0:43:53.27,Default,,0,0,0,,Олардың барлығы осы бөлмеде бір жерде болуы керек.
Dialogue: 0,0:43:48.43,0:43:53.27,Default,,0,0,0,,Таңға дейін көп уақыт бар.
Dialogue: 0,0:43:53.27,0:43:55.30,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:43:55.30,0:44:00.17,Default,,0,0,0,,Ең алдымен қоңыр егеуқұйрық сүйек ұнтағы және
Dialogue: 0,0:43:55.30,0:44:00.17,Default,,0,0,0,,Ньют көз алмасы
Dialogue: 0,0:44:00.17,0:44:03.01,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:44:00.17,0:44:03.01,Default,,0,0,0,,Сізге жіңішке кесілген бақалар қажет.
Dialogue: 0,0:44:03.01,0:44:05.11,Default,,0,0,0,,Уау! Ха!
Dialogue: 0,0:44:07.61,0:44:12.61,Default,,0,0,0,,Оны дайындау кезінде
Dialogue: 0,0:44:07.61,0:44:12.61,Default,,0,0,0,,Тауық етін жылы ұстау жақсы.
Dialogue: 0,0:44:14.96,0:44:19.26,Default,,0,0,0,,Ах, «Мысықтың құйрығынан шыққан үш шаш.
Dialogue: 0,0:44:14.96,0:44:19.26,Default,,0,0,0,,«Бірге күресейік» деп жазылған.
Dialogue: 0,0:44:19.26,0:44:22.23,Default,,0,0,0,,Сіз оны шығарған кезде, оны орындаңыз.
Dialogue: 0,0:44:19.26,0:44:22.23,Default,,0,0,0,,Мейірімді бол, жарай ма?
Dialogue: 0,0:44:22.23,0:44:24.40,Default,,0,0,0,,Нгя!
Dialogue: 0,0:44:24.40,0:44:26.63,Default,,0,0,0,,Келесі - белладонна сығындысы.
Dialogue: 0,0:44:26.63,0:44:28.87,Default,,0,0,0,,Бұл қатардағы төртінші бөтелке.
Dialogue: 0,0:44:28.87,0:44:32.37,Default,,0,0,0,,Тауық басына 3 тамшы тамызыңыз
Dialogue: 0,0:44:32.37,0:45:07.21,Default,,0,0,0,,Сен
Dialogue: 0,0:45:07.21,0:45:11.51,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:45:11.51,0:45:13.45,Default,,0,0,0,,Ммм...!
Dialogue: 0,0:45:13.45,0:45:15.48,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:45:15.48,0:45:18.62,Default,,0,0,0,,Ммм...!
Dialogue: 0,0:45:18.62,0:45:21.25,Default,,0,0,0,,«Танысты қойыңыз» Бұл жақсы.
Dialogue: 0,0:45:21.25,0:45:23.19,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:45:23.19,0:45:26.63,Default,,0,0,0,,«Танысты қою» нені білдіреді?
Dialogue: 0,0:45:26.63,0:45:28.56,Default,,0,0,0,,«Таныс» дегеніміз не?
Dialogue: 0,0:45:28.56,0:45:31.50,Default,,0,0,0,,Бақсыға көмектесу
Dialogue: 0,0:45:28.56,0:45:31.50,Default,,0,0,0,,Бұл мысық сияқты тіршілік иесі туралы.
Dialogue: 0,0:45:31.50,0:45:34.03,Default,,0,0,0,,Залдың дұрыс жұмыс істеуі үшін
Dialogue: 0,0:45:34.03,0:45:37.64,Default,,0,0,0,,Таныс жасайтын жер
Dialogue: 0,0:45:34.03,0:45:37.64,Default,,0,0,0,,Мен сенің жаныңда болуым керек.
Dialogue: 0,0:45:37.64,0:45:39.57,Default,,0,0,0,,Айтпақшы...
Dialogue: 0,0:45:39.57,0:45:41.51,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:45:41.51,0:45:46.15,Default,,0,0,0,,Заклинание орындауға кімнің күші көбірек?
Dialogue: 0,0:45:41.51,0:45:46.15,Default,,0,0,0,,Бұл қара мысық.
Dialogue: 0,0:45:46.15,0:45:49.65,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:45:46.15,0:45:49.65,Default,,0,0,0,,Әрқашан қашуға тырысады
Dialogue: 0,0:45:49.65,0:45:52.89,Default,,0,0,0,,Өйткені ол жасаған закымдар
Dialogue: 0,0:45:49.65,0:45:52.89,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:45:52.89,0:45:56.49,Default,,0,0,0,,Менің шашымды төңкеріп сипап жатқандай.
Dialogue: 0,0:45:56.49,0:46:00.79,Default,,0,0,0,,А, мен араластырып жатқан жасыл.
Dialogue: 0,0:45:56.49,0:46:00.79,Default,,0,0,0,,Раушанның мәнін қосыңыз
Dialogue: 0,0:46:02.30,0:46:06.13,Default,,0,0,0,,Бар
Dialogue: 0,0:46:02.30,0:46:06.13,Default,,0,0,0,,Барлығы үлкен ыдысқа ауыстырылғаннан кейін
Dialogue: 0,0:46:06.13,0:46:09.04,Default,,0,0,0,,Сөздерді араластыра отырып айту
Dialogue: 0,0:46:09.04,0:46:11.51,Default,,0,0,0,,Сөздер қандай?
Dialogue: 0,0:46:11.51,0:46:15.51,Default,,0,0,0,,Иә? Ол жазылмаған!
Dialogue: 0,0:46:11.51,0:46:15.51,Default,,0,0,0,,Қандай сөздер?
Dialogue: 0,0:46:15.51,0:46:19.38,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:46:15.51,0:46:19.38,Default,,0,0,0,,Бұл қорытынды сөз болса керек.
Dialogue: 0,0:46:19.38,0:46:23.65,Default,,0,0,0,,Бақсы қолданды
Dialogue: 0,0:46:19.38,0:46:23.65,Default,,0,0,0,,Шамамен 6 түрі болды...
Dialogue: 0,0:46:23.65,0:46:25.62,Default,,0,0,0,,Есіңізде болсын, қаймақ!
Dialogue: 0,0:46:25.62,0:46:29.19,Default,,0,0,0,,...Томас емес!
Dialogue: 0,0:46:25.62,0:46:29.19,Default,,0,0,0,,Өйткені, мен бар күшімді салдым.
Dialogue: 0,0:46:29.19,0:46:31.12,Default,,0,0,0,,Қараңдар, бәрін есте сақта!
Dialogue: 0,0:46:31.12,0:46:34.56,Default,,0,0,0,,Сіз естіген сөздер
Dialogue: 0,0:46:31.12,0:46:34.56,Default,,0,0,0,,Барлығын айт!
Dialogue: 0,0:46:34.56,0:46:39.20,Default,,0,0,0,,Түсіндім! Бірақ мен туралы
Dialogue: 0,0:46:34.56,0:46:39.20,Default,,0,0,0,,Мені қаймақ деп айтуды доғар.
Dialogue: 0,0:46:39.20,0:46:41.23,Default,,0,0,0,,Ал менің айтатын сөздерім
Dialogue: 0,0:46:41.23,0:46:45.07,Default,,0,0,0,,Бір-бірден
Dialogue: 0,0:46:41.23,0:46:45.07,Default,,0,0,0,,Қатесіз қайталау керек
Dialogue: 0,0:46:45.07,0:46:48.94,Default,,0,0,0,,Сіз бақсының рөлін ойнайсыз.
Dialogue: 0,0:46:45.07,0:46:48.94,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:46:48.94,0:46:53.18,Default,,0,0,0,,Kvintere Sun Ptereptelea
Dialogue: 0,0:46:48.94,0:46:53.18,Default,,0,0,0,,Күн Квинтеле
Dialogue: 0,0:46:53.18,0:46:57.55,Default,,0,0,0,,Kvintere Sun Ptereptelea
Dialogue: 0,0:46:53.18,0:46:57.55,Default,,0,0,0,,Күн Квинтеле
Dialogue: 0,0:46:57.55,0:47:00.05,Default,,0,0,0,,Kvuntur Blessen Ble Ble...
Dialogue: 0,0:47:00.05,0:47:02.69,Default,,0,0,0,,Уня~о
Dialogue: 0,0:47:02.69,0:47:07.53,Default,,0,0,0,,Kvuntur Blessen Ble Ble...
Dialogue: 0,0:47:02.69,0:47:07.53,Default,,0,0,0,,Уня~о
Dialogue: 0,0:47:07.53,0:47:10.30,Default,,0,0,0,,Брестемур Эстеун Кванте
Dialogue: 0,0:47:10.30,0:47:13.60,Default,,0,0,0,,Брестемур Эстеун Кванте
Dialogue: 0,0:47:13.60,0:47:19.41,Default,,0,0,0,,(Айя Томас)
Dialogue: 0,0:47:13.60,0:47:19.41,Default,,0,0,0,,Kvintere Sun Ptereptelea
Dialogue: 0,0:47:13.60,0:47:19.41,Default,,0,0,0,,Күн Квинтеле
Dialogue: 0,0:47:19.41,0:47:24.11,Default,,0,0,0,,Квунтур Брестен
Dialogue: 0,0:47:19.41,0:47:24.11,Default,,0,0,0,,Брестемур Эстеун Кванте
Dialogue: 0,0:47:25.75,0:47:27.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:25.75,0:47:27.81,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:47:27.81,0:47:29.81,Default,,0,0,0,,Раушан гүлінің иісі
Dialogue: 0,0:47:31.55,0:47:33.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:47:33.49,0:47:36.42,Default,,0,0,0,,Жоқ...бірақ мен айтқан кейбір нәрселер
Dialogue: 0,0:47:36.42,0:47:40.63,Default,,0,0,0,,Мен сөздерді есіме түсіре алмаймын
Dialogue: 0,0:47:36.42,0:47:40.63,Default,,0,0,0,,Шыққан қара сөздерді де қамтыды.
Dialogue: 0,0:47:40.63,0:47:43.43,Default,,0,0,0,,Бұл дұрыс жұмыс істейді деп үміттенемін.
Dialogue: 0,0:47:40.63,0:47:43.43,Default,,0,0,0,,Уня~о
Dialogue: 0,0:47:43.43,0:47:47.63,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:47:43.43,0:47:47.63,Default,,0,0,0,,Бүкіл денеге жағуға болады ма?
Dialogue: 0,0:47:47.63,0:47:53.51,Default,,0,0,0,,Иә, бірақ алдымен оны маған бояңыз.
Dialogue: 0,0:47:47.63,0:47:53.51,Default,,0,0,0,,Өйткені мен де сен сияқты еңбек еттім.
Dialogue: 0,0:47:53.51,0:47:57.64,Default,,0,0,0,,Ал мен бақсыны бұрын талай рет ашуландырғанмын.
Dialogue: 0,0:47:57.64,0:48:01.08,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:47:57.64,0:48:01.08,Default,,0,0,0,,Мені жауын құрттары жазалап жатыр.
Dialogue: 0,0:48:01.08,0:48:03.08,Default,,0,0,0,,Міне саған – қоштасу сүйісі.
Dialogue: 0,0:48:05.82,0:48:09.29,Default,,0,0,0,,Сәлем! Уф...
Dialogue: 0,0:48:09.29,0:48:11.22,Default,,0,0,0,,Я...
Dialogue: 0,0:48:11.22,0:48:15.50,Default,,0,0,0,,Иә! Ммммммммм! Ха...
Dialogue: 0,0:48:15.50,0:48:20.47,Default,,0,0,0,,Сәлем! Уф...
Dialogue: 0,0:48:20.47,0:48:23.14,Default,,0,0,0,,Сәлем~ Уау!
Dialogue: 0,0:48:23.14,0:48:26.44,Default,,0,0,0,,Бұл жақында
Dialogue: 0,0:48:23.14,0:48:26.44,Default,,0,0,0,,Бұл сіздің денеңізге сіңеді деп үміттенемін.
Dialogue: 0,0:48:39.72,0:48:41.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:41.86,0:48:44.62,Default,,0,0,0,,Маған қарама
Dialogue: 0,0:48:41.86,0:48:44.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:48:44.62,0:48:46.62,Default,,0,0,0,,Нгя!
Dialogue: 0,0:48:51.53,0:48:55.67,Default,,0,0,0,,Уау~ О, өте сергітеді!
Dialogue: 0,0:48:55.67,0:48:58.24,Default,,0,0,0,,Ол дұрыс жұмыс істей ме?
Dialogue: 0,0:48:58.24,0:49:00.47,Default,,0,0,0,,Жұмыс істемесе, қиналып қаламын.
Dialogue: 0,0:49:00.47,0:49:04.37,Default,,0,0,0,,Мен мұны қайта бастан өткергім келмейді.
Dialogue: 0,0:49:13.62,0:49:20.12,Default,,0,0,0,,Мен ешқашан қайтадан басынан бастағым келмейді...
Dialogue: 0,0:49:22.30,0:49:24.23,Default,,0,0,0,,...
Dialogue: 0,0:49:24.23,0:49:28.50,Default,,0,0,0,,Мандраке
Dialogue: 0,0:49:24.23,0:49:28.50,Default,,0,0,0,,Бекон мен жұмыртқаны тез пісіріңіз!
Dialogue: 0,0:49:28.50,0:49:32.24,Default,,0,0,0,,«Неге сен үшін жыннан мұны сұрамайсың?»
Dialogue: 0,0:49:28.50,0:49:32.24,Default,,0,0,0,,айтыңыз
Dialogue: 0,0:49:32.24,0:49:36.11,Default,,0,0,0,,Не болса да
Dialogue: 0,0:49:32.24,0:49:36.11,Default,,0,0,0,,...
Dialogue: 0,0:49:36.11,0:49:39.75,Default,,0,0,0,,Бірақ мен құл емеспін
Dialogue: 0,0:49:39.75,0:49:43.25,Default,,0,0,0,,...
Dialogue: 0,0:49:39.75,0:49:43.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:43.25,0:49:46.15,Default,,0,0,0,,Он… бе… с…
Dialogue: 0,0:49:46.15,0:49:49.85,Default,,0,0,0,,(Жаңбыр дыбысы)
Dialogue: 0,0:49:52.83,0:49:55.73,Default,,0,0,0,,Адамдармен көп қиналамын...
Dialogue: 0,0:49:55.73,0:49:59.93,Default,,0,0,0,,Мен қазір еске саламын.
Dialogue: 0,0:49:59.93,0:50:02.27,Default,,0,0,0,,Жалқау болма
Dialogue: 0,0:50:02.27,0:50:05.57,Default,,0,0,0,,Қалақай қосылған
Dialogue: 0,0:50:02.27,0:50:05.57,Default,,0,0,0,,Рождестволық раушан гүлін ал.
Dialogue: 0,0:50:08.38,0:50:10.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:50:13.65,0:50:17.52,Default,,0,0,0,,Мен көп қолдандым...
Dialogue: 0,0:50:17.52,0:50:20.15,Default,,0,0,0,,Жаңбыр жауып тұр!
Dialogue: 0,0:50:20.15,0:50:22.15,Default,,0,0,0,,Хмф!
Dialogue: 0,0:50:24.66,0:50:26.59,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:50:26.59,0:50:29.19,Default,,0,0,0,,Иә, көп ұзамай.
Dialogue: 0,0:50:30.96,0:50:33.36,Default,,0,0,0,,...Бұл жігіт кім!
Dialogue: 0,0:50:40.01,0:50:41.94,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:50:41.94,0:50:45.15,Default,,0,0,0,,Мен алған шөпті үлкен қазанға салуымды айтты.
Dialogue: 0,0:50:41.94,0:50:45.15,Default,,0,0,0,,Мен айттым ғой!
Dialogue: 0,0:50:45.15,0:50:47.25,Default,,0,0,0,,Хмм, хмм, хмм, хмм…
Dialogue: 0,0:50:48.92,0:50:51.15,Default,,0,0,0,,Құл емеспін дейсің!
Dialogue: 0,0:50:51.15,0:50:55.89,Default,,0,0,0,,Көмекшісің болдым, апай айтты
Dialogue: 0,0:50:51.15,0:50:55.89,Default,,0,0,0,,Ол маған сиқыр үйретуге уәде берді.
Dialogue: 0,0:50:55.89,0:50:59.76,Default,,0,0,0,,Апай, мені өлтіре жаздадың.
Dialogue: 0,0:50:55.89,0:50:59.76,Default,,0,0,0,,Оны жай ғана пайдаланбаңыз!
Dialogue: 0,0:50:59.76,0:51:02.23,Default,,0,0,0,,Мен мұндай уәде берген жоқпын.
Dialogue: 0,0:51:02.23,0:51:05.73,Default,,0,0,0,,Сізді алған адам
Dialogue: 0,0:51:02.23,0:51:05.73,Default,,0,0,0,,Өйткені қолымыз жетпеді
Dialogue: 0,0:51:02.23,0:51:05.73,Default,,0,0,0,,Он… бе… с…
Dialogue: 0,0:51:05.73,0:51:08.30,Default,,0,0,0,,Апай айлакер екен!
Dialogue: 0,0:51:05.73,0:51:08.30,Default,,0,0,0,,Директорға
Dialogue: 0,0:51:08.30,0:51:11.40,Default,,0,0,0,,Менің анам болғың келеді
Dialogue: 0,0:51:08.30,0:51:11.40,Default,,0,0,0,,Мен айтқанмен!
Dialogue: 0,0:51:13.04,0:51:15.54,Default,,0,0,0,,Он… бе… с…
Dialogue: 0,0:51:15.54,0:51:18.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:18.31,0:51:20.31,Default,,0,0,0,,(басты түрту дыбысы)
Dialogue: 0,0:51:18.31,0:51:20.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:22.78,0:51:25.69,Default,,0,0,0,,Сенің анаң? Хмф!
Dialogue: 0,0:51:25.69,0:51:29.99,Default,,0,0,0,,Қазанның астына жанармай құйыңыз!
Dialogue: 0,0:51:25.69,0:51:29.99,Default,,0,0,0,,Қазір!
Dialogue: 0,0:51:29.99,0:51:32.69,Default,,0,0,0,,Әйтпесе сені жауын құрттары жазалайды.
Dialogue: 0,0:51:46.37,0:51:50.88,Default,,0,0,0,,Сонымен
Dialogue: 0,0:51:46.37,0:51:50.88,Default,,0,0,0,,Маған сиқырды үйрете аласыз ба? Маған бермейсің бе?
Dialogue: 0,0:51:50.88,0:51:53.58,Default,,0,0,0,,Мен сізге айтпаймын. Бұл анық.
Dialogue: 0,0:51:53.58,0:51:56.38,Default,,0,0,0,,Себебі қолымыз жетпейді
Dialogue: 0,0:51:53.58,0:51:56.38,Default,,0,0,0,,Мен сені жаңа ғана осында әкелдім.
Dialogue: 0,0:51:56.38,0:52:00.58,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:52:09.40,0:52:13.67,Default,,0,0,0,,«Жаңа Каледонияда күн ашық
Dialogue: 0,0:52:09.40,0:52:13.67,Default,,0,0,0,,Ең төменгі температура 19 градус...».
Dialogue: 0,0:52:13.67,0:52:16.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:16.40,0:52:21.24,Default,,0,0,0,,«Балалар үйінен» қойшының бәлегі…
Dialogue: 0,0:52:21.24,0:52:24.48,Default,,0,0,0,,Бұл менің сүйікті тағамым.
Dialogue: 0,0:52:24.48,0:53:02.18,Default,,0,0,0,,Сен
Dialogue: 0,0:53:04.05,0:53:06.39,Default,,0,0,0,,Сіз сыпырғышқа барасыз ба?
Dialogue: 0,0:53:06.39,0:53:12.26,Default,,0,0,0,,Аа, мүмкін емес. Менің тұтынушым
Dialogue: 0,0:53:06.39,0:53:12.26,Default,,0,0,0,,Олардың барлығы жақсы адамдар.
Dialogue: 0,0:53:12.26,0:53:17.33,Default,,0,0,0,,«Жер достары» немесе «Аналар қауымдастығы»?
Dialogue: 0,0:53:12.26,0:53:17.33,Default,,0,0,0,,Тек мүшелер
Dialogue: 0,0:53:17.33,0:53:22.30,Default,,0,0,0,,Сыпыртқыда барған жерім
Dialogue: 0,0:53:17.33,0:53:22.30,Default,,0,0,0,,Көршілеріңіз сізді көрсе ше?
Dialogue: 0,0:53:22.30,0:53:25.20,Default,,0,0,0,,Мен ашуланамын
Dialogue: 0,0:53:25.20,0:53:27.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:25.20,0:53:27.84,Default,,0,0,0,,(Есік ашылу дыбысы)
Dialogue: 0,0:53:27.84,0:53:32.74,Default,,0,0,0,,Кел, бос сөзге құлақ аспа.
Dialogue: 0,0:53:27.84,0:53:32.74,Default,,0,0,0,,Мен қайтып келгенше аяқтаңыз.
Dialogue: 0,0:53:35.72,0:53:39.55,Default,,0,0,0,,Кешкі асты еденде жеуге болады
Dialogue: 0,0:53:35.72,0:53:39.55,Default,,0,0,0,,Оны тазалаңыз!
Dialogue: 0,0:53:39.55,0:53:41.55,Default,,0,0,0,,жиі
Dialogue: 0,0:53:47.86,0:53:51.73,Default,,0,0,0,,Томас! Томас!
Dialogue: 0,0:53:51.73,0:53:53.73,Default,,0,0,0,,Бұл қайда!
Dialogue: 0,0:53:53.73,0:53:57.37,Default,,0,0,0,,Не? Мен ұйықтап жатыр едім
Dialogue: 0,0:53:57.37,0:54:00.61,Default,,0,0,0,,Мен демалатын жалғыз уақыт ол далаға шыққанда...
Dialogue: 0,0:54:00.61,0:54:03.14,Default,,0,0,0,,Мен білемін. Бірақ маған көмектесіңізші, бар болғаны 5 минутқа.
Dialogue: 0,0:54:03.14,0:54:06.61,Default,,0,0,0,,Әй, біреу маған тағы бір жинақ беріңізші.
Dialogue: 0,0:54:03.14,0:54:06.61,Default,,0,0,0,,Қолды өсіретін сиқыр бар ма?
Dialogue: 0,0:54:06.61,0:54:09.81,Default,,0,0,0,,ше? Сол сияқты!
Dialogue: 0,0:54:17.19,0:54:28.64,Default,,0,0,0,,Сен
Dialogue: 0,0:54:28.64,0:54:30.57,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:54:30.57,0:54:38.31,Default,,0,0,0,,Сен
Dialogue: 0,0:54:38.31,0:54:40.71,Default,,0,0,0,,Жақсы сезім Уфуфуфу
Dialogue: 0,0:54:44.42,0:54:46.35,Default,,0,0,0,,Ең қиыны
Dialogue: 0,0:54:46.35,0:54:49.09,Default,,0,0,0,,Оның шашын қуыршаққа орау
Dialogue: 0,0:54:49.09,0:54:51.06,Default,,0,0,0,,Оны қалай алуға болады?
Dialogue: 0,0:54:51.06,0:54:54.43,Default,,0,0,0,,Титанның алдында сарбаздар бірінен соң бірі құлады.
Dialogue: 0,0:54:51.06,0:54:54.43,Default,,0,0,0,,Мен шашыма қол тигізуге рұқсат бермеймін.
Dialogue: 0,0:54:54.43,0:54:58.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:54:54.43,0:54:58.00,Default,,0,0,0,,Мен оны қалай да аламын
Dialogue: 0,0:54:58.00,0:55:01.87,Default,,0,0,0,,Әлгі келіншек: «Қолым жетпейді» деді.
Dialogue: 0,0:54:58.00,0:55:01.87,Default,,0,0,0,,Тек табанды бол.
Dialogue: 0,0:55:01.87,0:55:05.17,Default,,0,0,0,,Мен сізге міндетті түрде қосымша беремін.
Dialogue: 0,0:55:07.31,0:55:09.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:13.05,0:55:15.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:15.11,0:55:17.25,Default,,0,0,0,,～()
Dialogue: 0,0:55:17.25,0:55:19.32,Default,,0,0,0,,Кешіріңіз, сәл шу болды ма?
Dialogue: 0,0:55:19.32,0:55:21.45,Default,,0,0,0,,Эххе
Dialogue: 0,0:55:21.45,0:55:23.95,Default,,0,0,0,,Мен сіздің жұмысыңызға кедергі келтірдім бе?
Dialogue: 0,0:55:26.96,0:55:29.96,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:55:26.96,0:55:29.96,Default,,0,0,0,,Менің қарным аш болды.
Dialogue: 0,0:55:32.83,0:55:34.83,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:55:34.83,0:55:38.27,Default,,0,0,0,,Ағаңыз романшы ма?
Dialogue: 0,0:55:38.27,0:55:42.98,Default,,0,0,0,,Иә.
Dialogue: 0,0:55:38.27,0:55:42.98,Default,,0,0,0,,Уау, керемет! Келесі жолы оқуға рұқсат етіңіз!
Dialogue: 0,0:55:42.98,0:55:44.98,Default,,0,0,0,,О
Dialogue: 0,0:55:46.85,0:55:50.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:50.45,0:55:52.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:57.22,0:56:01.83,Default,,0,0,0,,Енді осы қол ғана қалды.
Dialogue: 0,0:55:57.22,0:56:01.83,Default,,0,0,0,,Оны денеңіздің қай жеріне қойғаныңызға байланысты.
Dialogue: 0,0:56:01.83,0:56:03.76,Default,,0,0,0,,Шынтағың ше?
Dialogue: 0,0:56:03.76,0:56:06.26,Default,,0,0,0,,Сіздің тізеңіз ше? Ол жігіт...
Dialogue: 0,0:56:09.57,0:56:12.57,Default,,0,0,0,,Жасырыңыз! тез! Қазір қайттып келемін!
Dialogue: 0,0:56:12.57,0:56:14.57,Default,,0,0,0,,Ей!
Dialogue: 0,0:56:17.31,0:56:19.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:30.62,0:56:35.50,Default,,0,0,0,,("Маған кедергі жасама" деп күмілжеді)
Dialogue: 0,0:56:35.50,0:56:39.13,Default,,0,0,0,,Бұл үйде ән айтуға тыйым салынған!
Dialogue: 0,0:56:39.13,0:56:41.37,Default,,0,0,0,,Бұл ән қайда еді...
Dialogue: 0,0:56:41.37,0:56:45.10,Default,,0,0,0,,Бұл еденді таза деп айта аласыз ба?
Dialogue: 0,0:56:41.37,0:56:45.10,Default,,0,0,0,,Жалқау адам!
Dialogue: 0,0:56:45.10,0:56:48.60,Default,,0,0,0,,Мен оны дұрыстап тазалауым керек.
Dialogue: 0,0:56:45.10,0:56:48.60,Default,,0,0,0,,Кешкі ас жоқ!
Dialogue: 0,0:56:52.01,0:56:56.15,Default,,0,0,0,,Мектептен шығарылу үшін қажет найзағайлар: 7 қалды
Dialogue: 0,0:56:52.01,0:56:56.15,Default,,0,0,0,,Апайдың шашын алуға болады ма?
Dialogue: 0,0:56:56.15,0:56:59.05,Default,,0,0,0,,Апайдың бөлмесі қайда?
Dialogue: 0,0:56:59.05,0:57:03.96,Default,,0,0,0,,Мандрейк бөлмесі
Dialogue: 0,0:56:59.05,0:57:03.96,Default,,0,0,0,,Менің бөлмемдегі қабырғаның екінші жағында, солай ма?
Dialogue: 0,0:57:03.96,0:57:06.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:06.59,0:57:08.53,Default,,0,0,0,,Бұл солай емес пе?
Dialogue: 0,0:57:08.53,0:57:11.03,Default,,0,0,0,,Бұл тікенді жүзім бұтасы
Dialogue: 0,0:57:11.03,0:57:15.90,Default,,0,0,0,,Оның шашы түспейді.
Dialogue: 0,0:57:11.03,0:57:15.90,Default,,0,0,0,,Өйткені олар бір-бірімен астасып жатыр
Dialogue: 0,0:57:15.90,0:57:18.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:57:18.50,0:57:24.38,Default,,0,0,0,,Сен
Dialogue: 0,0:57:24.38,0:57:27.51,Default,,0,0,0,,Хмф, қазір жағдай біршама жақсарды.
Dialogue: 0,0:57:27.51,0:57:32.39,Default,,0,0,0,,Бөлмеңізге барыңыз!
Dialogue: 0,0:57:27.51,0:57:32.39,Default,,0,0,0,,Кешкі ас бөлмедегі ірімшік пен нан ғана.
Dialogue: 0,0:57:32.39,0:57:36.69,Default,,0,0,0,,Жалқау болсаң солай болады.
Dialogue: 0,0:57:32.39,0:57:36.69,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:57:42.66,0:57:45.23,Default,,0,0,0,,Моши-ши
Dialogue: 0,0:57:45.23,0:57:49.33,Default,,0,0,0,,Демон мырза? Сен ондасың ба?
Dialogue: 0,0:57:52.67,0:57:57.27,Default,,0,0,0,,Сәлем! Сіз оны көресіз деп ойладым. Хмм...
Dialogue: 0,0:57:58.95,0:58:02.38,Default,,0,0,0,,Ағай шынымен
Dialogue: 0,0:57:58.95,0:58:02.38,Default,,0,0,0,,Сіз қызықсыз нәрселер жазасыз.
Dialogue: 0,0:58:02.38,0:58:04.38,Default,,0,0,0,,Уақытты босқа кетіру
Dialogue: 0,0:58:06.05,0:58:08.75,Default,,0,0,0,,Әйтеуір апам туралы...
Dialogue: 0,0:58:10.42,0:58:15.92,Default,,0,0,0,,Шаш щеткасына оралған шаш
Dialogue: 0,0:58:10.42,0:58:15.92,Default,,0,0,0,,Мен оны сол жерде қалдыратыныңызға сенімдімін.
Dialogue: 0,0:58:18.53,0:58:20.53,Default,,0,0,0,,(қағу)
Dialogue: 0,0:58:23.74,0:58:29.61,Default,,0,0,0,,Осы қабырғаның арғы жағында
Dialogue: 0,0:58:23.74,0:58:29.61,Default,,0,0,0,,Ағаңның бөлмесі болса.
Dialogue: 0,0:58:29.61,0:58:32.41,Default,,0,0,0,,Тіпті апамның бөлмесі
Dialogue: 0,0:58:32.41,0:58:35.85,Default,,0,0,0,,Бар болуы керек!
Dialogue: 0,0:58:35.85,0:58:37.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:39.72,0:58:42.62,Default,,0,0,0,,...
Dialogue: 0,0:58:39.72,0:58:42.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:42.62,0:58:46.23,Default,,0,0,0,,...
Dialogue: 0,0:58:46.23,0:58:49.53,Default,,0,0,0,,Иә! Уф...
Dialogue: 0,0:58:49.53,0:58:52.20,Default,,0,0,0,,～
Dialogue: 0,0:58:52.20,0:58:56.67,Default,,0,0,0,,Сен
Dialogue: 0,0:58:56.67,0:58:58.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:58.60,0:59:05.21,Default,,0,0,0,,～(Don't disturb me)
Dialogue: 0,0:59:05.21,0:59:23.60,Default,,0,0,0,,Сен
Dialogue: 0,0:59:23.60,0:59:25.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:23.60,0:59:25.80,Default,,0,0,0,,...
Dialogue: 0,0:59:27.47,0:59:29.74,Default,,0,0,0,,Бір минут, Ұсуке.
Dialogue: 0,0:59:29.74,0:59:34.44,Default,,0,0,0,,Сіз мұны істесеңіз де
Dialogue: 0,0:59:29.74,0:59:34.44,Default,,0,0,0,,Мен апамның шашын ала алмаймын.
Dialogue: 0,0:59:44.55,0:59:46.85,Default,,0,0,0,,Ммм... Мм!
Dialogue: 0,0:59:48.42,0:59:51.06,Default,,0,0,0,,Мен сиқырды түсінбеймін
Dialogue: 0,0:59:51.06,0:59:54.56,Default,,0,0,0,,Қандай жағдай болмасын, апайдың сабақ беруіне рұқсат беруім керек.
Dialogue: 0,0:59:56.86,0:59:59.30,Default,,0,0,0,,(қағу)
Dialogue: 0,0:59:59.30,1:00:01.23,Default,,0,0,0,,...
Dialogue: 0,0:59:59.30,1:00:01.23,Default,,0,0,0,,(қағу)
Dialogue: 0,1:00:01.23,1:00:05.13,Default,,0,0,0,,...
Dialogue: 0,1:00:01.23,1:00:05.13,Default,,0,0,0,,Қуырылған нан жегім келеді!
Dialogue: 0,1:00:11.34,1:00:13.34,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:16.18,1:00:18.22,Default,,0,0,0,,Ах...!
Dialogue: 0,1:00:18.22,1:00:20.55,Default,,0,0,0,,Әй!
Dialogue: 0,1:00:20.55,1:00:23.45,Default,,0,0,0,,Ендеше менің қалпына келу қабілетім…
Dialogue: 0,1:00:26.69,1:00:28.89,Default,,0,0,0,,Мен таптым!
Dialogue: 0,1:00:31.53,1:00:34.43,Default,,0,0,0,,...
Dialogue: 0,1:00:34.43,1:00:37.34,Default,,0,0,0,,Иә! Мен үйдемін!
Dialogue: 0,1:00:37.34,1:00:40.11,Default,,0,0,0,,Қазір қараңыз!
Dialogue: 0,1:00:40.11,1:00:45.11,Default,,0,0,0,,(Радио)
Dialogue: 0,1:00:40.11,1:00:45.11,Default,,0,0,0,,«Сеулде күн ашық, бірақ түстен кейін қысқа жаңбыр жауады...»
Dialogue: 0,1:00:47.58,1:00:53.99,Default,,0,0,0,,Сен
Dialogue: 0,1:00:53.99,1:00:57.49,Default,,0,0,0,,Ой... уау!
Dialogue: 0,1:00:57.49,1:01:03.30,Default,,0,0,0,,Сен
Dialogue: 0,1:01:03.30,1:01:06.57,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:01:06.57,1:01:11.40,Default,,0,0,0,,Қуырылған нан дегеніміз не?
Dialogue: 0,1:01:06.57,1:01:11.40,Default,,0,0,0,,Мен бұрын ешқашан жасаған емеспін. Мен қателестім бе?
Dialogue: 0,1:01:11.40,1:01:13.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:01:13.41,1:01:16.34,Default,,0,0,0,,Неге оны қалай жасау керектігін айтпадың?
Dialogue: 0,1:01:16.34,1:01:19.15,Default,,0,0,0,,(Бұзық) Хахаха, ә? Жақсы ғой, иә?
Dialogue: 0,1:01:19.15,1:01:22.98,Default,,0,0,0,,Па... нан пісіргендей.
Dialogue: 0,1:01:19.15,1:01:22.98,Default,,0,0,0,,Мұны кез келген адам жасай алады!
Dialogue: 0,1:01:22.98,1:01:28.79,Default,,0,0,0,,That's not true.
Dialogue: 0,1:01:22.98,1:01:28.79,Default,,0,0,0,,Бұл сізді қайтадан мазаламасын!
Dialogue: 0,1:01:28.79,1:01:31.99,Default,,0,0,0,,Мен сізге не істей аламын?
Dialogue: 0,1:01:31.99,1:01:35.46,Default,,0,0,0,,Менің қорқынышты шеберім
Dialogue: 0,1:01:35.46,1:01:37.40,Default,,0,0,0,,Аузыңызды жабыңыз
Dialogue: 0,1:01:37.40,1:01:41.00,Default,,0,0,0,,Мұны төмендетіңіз
Dialogue: 0,1:01:37.40,1:01:41.00,Default,,0,0,0,,Эпинг орман лагерінен
Dialogue: 0,1:01:41.00,1:01:44.87,Default,,0,0,0,,Скауттар жасаған
Dialogue: 0,1:01:41.00,1:01:44.87,Default,,0,0,0,,Жақсы қуырылған нан алыңыз.
Dialogue: 0,1:01:44.87,1:01:48.87,Default,,0,0,0,,Мен ақылдымын, қорқыныштың иесімін.
Dialogue: 0,1:01:50.78,1:01:52.88,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:54.88,1:01:56.88,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:01.69,1:02:04.09,Default,,0,0,0,,Ах... иә?
Dialogue: 0,1:02:10.20,1:02:13.10,Default,,0,0,0,,(Радио)
Dialogue: 0,1:02:10.20,1:02:13.10,Default,,0,0,0,,«Крайстчерчте күн ашық болады.»
Dialogue: 0,1:02:17.84,1:02:22.04,Default,,0,0,0,,Мүлдем! Осындай кез келген нәрсе
Dialogue: 0,1:02:17.84,1:02:22.04,Default,,0,0,0,,Сіз Мандрейкті ашуландырып жатырсыз!
Dialogue: 0,1:02:22.04,1:02:25.91,Default,,0,0,0,,Сізге рахмет, менің жағдайым нашар.
Dialogue: 0,1:02:22.04,1:02:25.91,Default,,0,0,0,,Менімен кездесіп қала жаздадың!
Dialogue: 0,1:02:25.91,1:02:29.92,Default,,0,0,0,,Сонда бәрі болады.
Dialogue: 0,1:02:25.91,1:02:29.92,Default,,0,0,0,,Маған мұны істе деп айтпа.
Dialogue: 0,1:02:29.92,1:02:32.65,Default,,0,0,0,,Мен сізге біраз нәрсені айтуым керек. Эй?
Dialogue: 0,1:02:32.65,1:02:34.89,Default,,0,0,0,,Ақымақ сылтау айтпа!
Dialogue: 0,1:02:34.89,1:02:38.16,Default,,0,0,0,,Сен мұнда жұмыс істеуге келдің!
Dialogue: 0,1:02:38.16,1:02:41.56,Default,,0,0,0,,Мен мысықтың қолын алғым келеді.
Dialogue: 0,1:02:38.16,1:02:41.56,Default,,0,0,0,,Қолымыз жетпейді!
Dialogue: 0,1:02:41.56,1:02:44.76,Default,,0,0,0,,Енді жұмысқа кіріс!
Dialogue: 0,1:02:51.07,1:02:53.87,Default,,0,0,0,,Мен дәретханаға барғым келеді
Dialogue: 0,1:02:53.87,1:02:59.08,Default,,0,0,0,,Менің ашуымды келтіргің келе ме?
Dialogue: 0,1:02:53.87,1:02:59.08,Default,,0,0,0,,Жарайды, 2 минут жасайық.
Dialogue: 0,1:02:59.08,1:03:02.98,Default,,0,0,0,,Қайту үшін сәл кеш болса да...
Dialogue: 0,1:03:12.09,1:03:16.93,Default,,0,0,0,,Don't disturb me
Dialogue: 0,1:03:16.93,1:03:20.63,Default,,0,0,0,,...
Dialogue: 0,1:03:25.30,1:03:27.40,Default,,0,0,0,,(дәретхана суының ағып жатқан дыбысы)
Dialogue: 0,1:03:29.11,1:03:31.04,Default,,0,0,0,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,1:03:31.04,1:03:33.84,Default,,0,0,0,,Еееееееееееееееееееееееееееееееееееееее!
Dialogue: 0,1:03:31.04,1:03:33.84,Default,,0,0,0,,Уф!
Dialogue: 0,1:03:35.55,1:03:39.65,Default,,0,0,0,,Мына тәтті қыз! Сен не істедің?
Dialogue: 0,1:03:41.95,1:03:43.89,Default,,0,0,0,,Иә?иә?
Dialogue: 0,1:03:41.95,1:03:43.89,Default,,0,0,0,,Уау!
Dialogue: 0,1:03:43.89,1:03:47.69,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:47.69,1:03:51.63,Default,,0,0,0,,Ха! Эй жақсы!
Dialogue: 0,1:03:51.63,1:03:55.80,Default,,0,0,0,,Ахахха! Ахахха!
Dialogue: 0,1:03:51.63,1:03:55.80,Default,,0,0,0,,Дани во жида
Dialogue: 0,1:03:55.80,1:03:57.87,Default,,0,0,0,,Мен қол қостым!
Dialogue: 0,1:03:57.87,1:04:02.21,Default,,0,0,0,,Өйткені апай
Dialogue: 0,1:03:57.87,1:04:02.21,Default,,0,0,0,,«Қолым жетпейді, қолым жетпейді»
Dialogue: 0,1:04:02.21,1:04:04.21,Default,,0,0,0,,Ол сондай табанды болды!
Dialogue: 0,1:04:04.21,1:04:09.11,Default,,0,0,0,,Гааааааа! Бұл Бибіздің жазасы!
Dialogue: 0,1:04:11.32,1:04:13.65,Default,,0,0,0,,Уау! уа уа уа...
Dialogue: 0,1:04:13.65,1:04:16.32,Default,,0,0,0,,Уау...!
Dialogue: 0,1:04:16.32,1:04:21.02,Default,,0,0,0,,Ой... Бұл!
Dialogue: 0,1:04:22.66,1:04:25.97,Default,,0,0,0,,...
Dialogue: 0,1:04:25.97,1:04:28.07,Default,,0,0,0,,Уняо!
Dialogue: 0,1:04:29.67,1:04:35.21,Default,,0,0,0,,Сіз бұл сиқырды денеңізге қолдандыңыз.
Dialogue: 0,1:04:29.67,1:04:35.21,Default,,0,0,0,,Мен саған жамандық жасамаймын.
Dialogue: 0,1:04:35.21,1:04:38.41,Default,,0,0,0,,Уф...
Dialogue: 0,1:04:38.41,1:04:40.41,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,1:04:40.41,1:04:42.51,Default,,0,0,0,,Хмм...
Dialogue: 0,1:04:46.15,1:04:48.65,Default,,0,0,0,,Келмейді.
Dialogue: 0,1:04:48.65,1:04:51.16,Default,,0,0,0,,Гяах...!
Dialogue: 0,1:04:48.65,1:04:51.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:51.16,1:04:53.16,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:02.60,1:05:07.14,Default,,0,0,0,,Күрсін... сиқыр бұзылды.
Dialogue: 0,1:05:07.14,1:05:10.01,Default,,0,0,0,,Қанша тырыссам да
Dialogue: 0,1:05:10.01,1:05:12.38,Default,,0,0,0,,(разрядты дыбыс)
Dialogue: 0,1:05:10.01,1:05:12.38,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:12.38,1:05:14.88,Default,,0,0,0,,(разрядты дыбыс)
Dialogue: 0,1:05:12.38,1:05:14.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:18.08,1:05:20.08,Default,,0,0,0,,Эй, Окабе.
Dialogue: 0,1:05:22.62,1:05:26.43,Default,,0,0,0,,Біздің заклинание жақсы жұмыс істейді.
Dialogue: 0,1:05:26.43,1:05:29.83,Default,,0,0,0,,Жер құрттары жай ғана еденде.
Dialogue: 0,1:05:26.43,1:05:29.83,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,1:05:31.40,1:05:36.10,Default,,0,0,0,,Ей, әлсіз!
Dialogue: 0,1:05:31.40,1:05:36.10,Default,,0,0,0,,Сіз қаймақтан да қорқыныштысыз.
Dialogue: 0,1:05:41.94,1:05:44.91,Default,,0,0,0,,Иә? Күте тұрыңыз...
Dialogue: 0,1:05:44.91,1:05:48.31,Default,,0,0,0,,Жетті, Конни
Dialogue: 0,1:05:44.91,1:05:48.31,Default,,0,0,0,,Біз өзімізді заклинание арқылы қорғаймыз.
Dialogue: 0,1:05:48.31,1:05:50.32,Default,,0,0,0,,Апай біледі!
Dialogue: 0,1:05:50.32,1:05:52.89,Default,,0,0,0,,Жасырын болуы керек!
Dialogue: 0,1:05:52.89,1:05:54.89,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:56.59,1:05:58.59,Default,,0,0,0,,Әй!
Dialogue: 0,1:06:01.93,1:06:06.80,Default,,0,0,0,,Біртүрлі екен, солай емес пе?
Dialogue: 0,1:06:01.93,1:06:06.80,Default,,0,0,0,,Шабыт қиын кезде соғады, солай емес пе?
Dialogue: 0,1:06:06.80,1:06:30.39,Default,,0,0,0,,Сен
Dialogue: 0,1:06:30.39,1:06:32.69,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:06:34.73,1:06:38.60,Default,,0,0,0,,Сол жерге жауын құрттарын салып жатырсың ба?
Dialogue: 0,1:06:34.73,1:06:38.60,Default,,0,0,0,,Мен оны ваннаға жасыруға тырыстым.
Dialogue: 0,1:06:38.60,1:06:42.43,Default,,0,0,0,,Не? Жоқ! Өте керемет!!
Dialogue: 0,1:06:42.43,1:06:47.64,Default,,0,0,0,,Кішкене қаймақ...
Dialogue: 0,1:06:42.43,1:06:47.64,Default,,0,0,0,,Томас емес пе?
Dialogue: 0,1:06:47.64,1:06:50.98,Default,,0,0,0,,жауын құрттары туралы не айтуға болады?
Dialogue: 0,1:06:47.64,1:06:50.98,Default,,0,0,0,,Марстардың үш аяғымен салыстырғанда
Dialogue: 0,1:06:50.98,1:06:52.91,Default,,0,0,0,,Әрқашан өте кішкентай...
Dialogue: 0,1:06:52.91,1:06:57.85,Rubi,,0,0,0,,Есті жойып жіберердей үркіреу
Dialogue: 0,1:06:52.91,1:06:57.85,Default,,0,0,0,,Демек, бұл… Парадис аралының Шайтаны!!
Dialogue: 0,1:06:57.85,1:07:03.56,Default,,0,0,0,,Уаааааа...!
Dialogue: 0,1:07:03.56,1:07:10.93,Default,,0,0,0,,Ууууууууу!!
Dialogue: 0,1:07:10.93,1:07:16.74,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,1:07:16.74,1:07:23.51,Default,,0,0,0,,Уууууууу!
Dialogue: 0,1:07:23.51,1:07:30.01,Default,,0,0,0,,Құрттар! Мен оған жауын құрттарын беремін.
Dialogue: 0,1:07:37.19,1:07:39.59,Default,,0,0,0,,Уау
Dialogue: 0,1:07:43.53,1:07:46.40,Default,,0,0,0,,(қабырғаны жарып өткен дыбыс)
Dialogue: 0,1:07:46.40,1:07:49.40,Default,,0,0,0,,～
Dialogue: 0,1:07:49.40,1:07:53.07,Default,,0,0,0,,(әйнек сынған дыбыс)
Dialogue: 0,1:07:53.07,1:07:55.44,Default,,0,0,0,,Бұл!
Dialogue: 0,1:07:55.44,1:07:58.31,Default,,0,0,0,,Сіз! Мен үшін не істедің!
Dialogue: 0,1:07:58.31,1:08:01.51,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,1:07:58.31,1:08:01.51,Default,,0,0,0,,Апай жақсы емес.
Dialogue: 0,1:08:01.51,1:08:04.42,Default,,0,0,0,,Не?
Dialogue: 0,1:08:01.51,1:08:04.42,Default,,0,0,0,,Ха…!!
Dialogue: 0,1:08:04.42,1:08:11.06,Default,,0,0,0,,(Мандраке)
Dialogue: 0,1:08:04.42,1:08:11.06,Default,,0,0,0,,Мен саған мазалама дедім~!!
Dialogue: 0,1:08:11.06,1:08:12.99,Default,,0,0,0,,…Уау!
Dialogue: 0,1:08:12.99,1:08:14.93,Default,,0,0,0,,～(ﾗｼﾞｶｾ)
Dialogue: 0,1:08:14.93,1:08:17.83,Default,,0,0,0,,...
Dialogue: 0,1:08:17.83,1:08:22.37,Default,,0,0,0,,...
Dialogue: 0,1:08:22.37,1:08:24.37,Default,,0,0,0,,…
Dialogue: 0,1:08:24.37,1:08:26.64,Default,,0,0,0,,Иә! Мазасыздық жойылды
Dialogue: 0,1:08:26.64,1:08:28.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:28.57,1:08:32.14,Default,,0,0,0,,Себебі мен сені бұдан былай мазаласам,
Dialogue: 0,1:08:28.57,1:08:32.14,Default,,0,0,0,,Жаман нәрселер
Dialogue: 0,1:08:32.14,1:08:34.61,Default,,0,0,0,,Сәлем? ағай
Dialogue: 0,1:08:32.14,1:08:34.61,Default,,0,0,0,,Не айтып тұрсың...
Dialogue: 0,1:08:34.61,1:08:39.05,Default,,0,0,0,,Одан кейін қалағаныңды істе! Екеуің
Dialogue: 0,1:08:39.05,1:08:41.05,Default,,0,0,0,,Уау!
Dialogue: 0,1:08:43.89,1:08:46.16,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,1:08:46.16,1:08:48.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:49.83,1:08:52.40,Default,,0,0,0,,Уау...!
Dialogue: 0,1:08:52.40,1:09:03.61,Default,,0,0,0,,Сен
Dialogue: 0,1:09:03.61,1:09:07.91,Default,,0,0,0,,Не? «ҚҰЛАҚ»? Бұл өтірік!
Dialogue: 0,1:09:07.91,1:09:12.48,Rubi,,0,0,0,,Пеш
Dialogue: 0,1:09:07.91,1:09:12.48,Default,,0,0,0,,...
Dialogue: 0,1:09:12.48,1:09:16.49,Rubi,,0,0,0,,Жалаң аяқ
Dialogue: 0,1:09:12.48,1:09:16.49,Default,,0,0,0,,...
Dialogue: 0,1:09:16.49,1:09:26.03,Default,,0,0,0,,...
Dialogue: 0,1:09:16.49,1:09:26.03,Default,,0,0,0,,Мен сені ақ боз атпен алып кетейін.''
Dialogue: 0,1:09:26.03,1:09:30.60,Rubi,,0,0,0,,Ойыншықтар
Dialogue: 0,1:09:26.03,1:09:30.60,Default,,0,0,0,,...
Dialogue: 0,1:09:30.60,1:09:35.04,Default,,0,0,0,,...
Dialogue: 0,1:09:35.04,1:09:43.75,Default,,0,0,0,,...
Dialogue: 0,1:09:35.04,1:09:43.75,Default,,0,0,0,,Әйел тек анасын біледі».
Dialogue: 0,1:09:43.75,1:09:48.29,Default,,0,0,0,,...
Dialogue: 0,1:09:48.29,1:09:52.76,Default,,0,0,0,,...
Dialogue: 0,1:09:52.76,1:10:02.27,Default,,0,0,0,,...
Dialogue: 0,1:10:02.27,1:10:11.11,Default,,0,0,0,,Don't disturb me
Dialogue: 0,1:10:02.27,1:10:11.11,Default,,0,0,0,,Қиындық тудыратындар».
Dialogue: 0,1:10:11.11,1:10:20.29,Default,,0,0,0,,Don't disturb me
Dialogue: 0,1:10:11.11,1:10:20.29,Default,,0,0,0,,Оларды өртеп жіберсе жақсы болар еді».
Dialogue: 0,1:10:20.29,1:10:29.36,Default,,0,0,0,,Don't disturb me
Dialogue: 0,1:10:20.29,1:10:29.36,Default,,0,0,0,,Қиындық тудыратындар».
Dialogue: 0,1:10:29.36,1:10:38.47,Default,,0,0,0,,Don't disturb me
Dialogue: 0,1:10:29.36,1:10:38.47,Default,,0,0,0,,Қарғыс айту жақсы».
Dialogue: 0,1:10:38.47,1:10:45.71,Default,,0,0,0,,Сен
Dialogue: 0,1:10:45.71,1:10:48.28,Default,,0,0,0,,Сен
Dialogue: 0,1:10:45.71,1:10:48.28,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,1:10:48.28,1:10:50.88,Default,,0,0,0,,Сен
Dialogue: 0,1:10:50.88,1:10:52.82,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,1:10:52.82,1:10:57.02,Default,,0,0,0,,Ол саған жауын құрттарын берді...
Dialogue: 0,1:10:52.82,1:10:57.02,Default,,0,0,0,,Ағай, сіз рок-жұлдыз едіңіз!
Dialogue: 0,1:10:57.02,1:11:01.46,Default,,0,0,0,,Маған EARWIG ұнайды!
Dialogue: 0,1:10:57.02,1:11:01.46,Default,,0,0,0,,Бұл қызыл шашты әдемі адам кім?
Dialogue: 0,1:11:01.46,1:11:06.36,Default,,0,0,0,,Ғашық?
Dialogue: 0,1:11:01.46,1:11:06.36,Default,,0,0,0,,Ол саған құртты берді.
Dialogue: 0,1:11:08.10,1:11:13.41,Default,,0,0,0,,Иә. Сондықтан мен оны жасырайын деп ойладым.
Dialogue: 0,1:11:08.10,1:11:13.41,Default,,0,0,0,,Мен сені ваннаға жібердім деп ойладым.
Dialogue: 0,1:11:13.41,1:11:15.97,Default,,0,0,0,,Мен қателестім деп ойлаймын.
Dialogue: 0,1:11:15.97,1:11:23.08,Default,,0,0,0,,Сиқырлы жерге сиқырлы құрт кіреді.
Dialogue: 0,1:11:15.97,1:11:23.08,Default,,0,0,0,,Сөйтіп ол менің бөлмеме келді.
Dialogue: 0,1:11:23.08,1:11:27.92,Default,,0,0,0,,Әндерге де солай.
Dialogue: 0,1:11:23.08,1:11:27.92,Default,,0,0,0,,Мен сені сиқырлы жерге жібердім.
Dialogue: 0,1:11:27.92,1:11:31.79,Default,,0,0,0,,Бұл жігіт әлдеқашан
Dialogue: 0,1:11:27.92,1:11:31.79,Default,,0,0,0,,Мен саған олай жасамас едім
Dialogue: 0,1:11:31.79,1:11:35.49,Default,,0,0,0,,Ешқашан дәл сол әрекетті қайталама.
Dialogue: 0,1:11:35.49,1:11:41.37,Default,,0,0,0,,Мен сені дұрыстап көмекшім етемін.
Dialogue: 0,1:11:35.49,1:11:41.37,Default,,0,0,0,,Мен оған мені оқытыңыз дедім.
Dialogue: 0,1:11:41.37,1:11:43.37,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:11:43.37,1:11:46.51,Default,,0,0,0,,Қолым ұзақ болса да,
Dialogue: 0,1:11:46.51,1:11:50.71,Default,,0,0,0,,Барабан және емле жасау...
Dialogue: 0,1:11:55.11,1:11:58.52,Default,,0,0,0,,Ағай, EARWIG тарады ма?
Dialogue: 0,1:11:58.52,1:12:01.82,Default,,0,0,0,,Қызыл шашты адам кім?
Dialogue: 0,1:12:04.19,1:12:08.36,Default,,0,0,0,,(Жаңбыр дыбысы)
Dialogue: 0,1:12:08.36,1:12:12.16,Default,,0,0,0,,Ха… Жылдам ашып көр.
Dialogue: 0,1:12:08.36,1:12:12.16,Rubi,,0,0,0,,Ояныңыз
Dialogue: 0,1:12:08.36,1:12:12.16,Default,,0,0,0,,Бақсының ережесін не істейсің?
Dialogue: 0,1:12:12.16,1:12:15.97,Default,,0,0,0,,Шулы! мен не істеймін
Dialogue: 0,1:12:12.16,1:12:15.97,Default,,0,0,0,,Мен шешемін!
Dialogue: 0,1:12:15.97,1:12:17.97,Default,,0,0,0,,(бетке соғу дыбысы)
Dialogue: 0,1:12:20.37,1:12:23.28,Default,,0,0,0,,Хмф! Сау бол әпке
Dialogue: 0,1:12:23.28,1:12:29.95,Default,,0,0,0,,12 кемпірдің айласы
Dialogue: 0,1:12:23.28,1:12:29.95,Default,,0,0,0,,Кешіріңіз. Хмф!
Dialogue: 0,1:12:29.95,1:12:36.72,Default,,0,0,0,,Сен
Dialogue: 0,1:12:36.72,1:12:41.46,Default,,0,0,0,,Бақсы жасаған тесік
Dialogue: 0,1:12:36.72,1:12:41.46,Default,,0,0,0,,Тек бақсы ғана жерлей алады
Dialogue: 0,1:12:41.46,1:12:45.96,Default,,0,0,0,,Ол кетіп қалды...
Dialogue: 0,1:12:48.00,1:12:52.87,Default,,0,0,0,,Ағай! Мен жоғалмаймын
Dialogue: 0,1:12:48.00,1:12:52.87,Default,,0,0,0,,Мен сенің керемет сиқыршы болатыныңа сенімдімін!
Dialogue: 0,1:12:52.87,1:12:56.74,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:12:52.87,1:12:56.74,Default,,0,0,0,,Сізге романшы ретінде жұмыс істеуге көмектесуге рұқсат етіңіз
Dialogue: 0,1:12:56.74,1:13:01.21,Default,,0,0,0,,Мен ағама көмектескім келеді.
Dialogue: 0,1:12:56.74,1:13:01.21,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,1:13:01.21,1:13:04.25,Default,,0,0,0,,Маған мазалағанды ұнатпаймын.
Dialogue: 0,1:13:04.25,1:13:06.75,Default,,0,0,0,,Ағай, өтінемін!
Dialogue: 0,1:13:08.95,1:13:11.42,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,1:13:11.42,1:13:15.86,Default,,0,0,0,,Білесіз бе, аға!
Dialogue: 0,1:13:11.42,1:13:15.86,Default,,0,0,0,,Мектеп ертең басталады.
Dialogue: 0,1:13:15.86,1:13:18.76,Default,,0,0,0,,Мені жіберіңізші
Dialogue: 0,1:13:15.86,1:13:18.76,Default,,0,0,0,,Маған айта аласыз ба?
Dialogue: 0,1:13:18.76,1:13:22.20,Default,,0,0,0,,...
Dialogue: 0,1:13:22.20,1:13:26.97,Default,,0,0,0,,Қаймақ
Dialogue: 0,1:13:22.20,1:13:26.97,Default,,0,0,0,,Мен де ағам сияқты кітапқұмармын.
Dialogue: 0,1:13:26.97,1:13:31.91,Default,,0,0,0,,Бірақ мен оқығанның бәрі - SF
Dialogue: 0,1:13:26.97,1:13:31.91,Default,,0,0,0,,Кейде тіпті жұмбақ оқуға болады.
Dialogue: 0,1:13:31.91,1:13:34.05,Default,,0,0,0,,...
Dialogue: 0,1:13:34.05,1:13:39.15,Default,,0,0,0,,Күндіз мектепке барсам
Dialogue: 0,1:13:34.05,1:13:39.15,Default,,0,0,0,,Менің ойымша, үйде әлдеқайда тыныш болады.
Dialogue: 0,1:13:40.79,1:13:43.29,Default,,0,0,0,,(ﾏﾝﾄﾞﾚｰｸ)
Dialogue: 0,1:13:46.59,1:13:49.09,Default,,0,0,0,,Әй, қой, маңызды емес.
Dialogue: 0,1:14:01.51,1:14:04.28,Default,,0,0,0,,Сәлем, Томас. Сол екеуі.
Dialogue: 0,1:14:04.28,1:14:08.21,Default,,0,0,0,,Қалауымызша
Dialogue: 0,1:14:04.28,1:14:08.21,Default,,0,0,0,,Сіз оны басқара аласыз.
Dialogue: 0,1:14:08.21,1:14:11.38,Default,,0,0,0,,Егер мен жақсы болсам.
Dialogue: 0,1:14:11.38,1:14:13.38,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:11.38,1:14:13.38,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:18.26,1:14:26.16,Default,,0,0,0,,(Еденді сыпыру дыбысы)
Dialogue: 0,1:14:28.93,1:14:31.40,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:31.40,1:14:36.30,Default,,0,0,0,,Сиқыр Сіз маған үйретесіз, солай ма?
Dialogue: 0,1:14:31.40,1:14:36.30,Default,,0,0,0,,Мұны дереу орындаңыз!
Dialogue: 0,1:14:37.94,1:14:40.45,Default,,0,0,0,,(үлкен күрсіну)
Dialogue: 0,1:14:40.45,1:14:43.88,Default,,0,0,0,,Бірақ мен қалай екенін білгім келеді...
Dialogue: 0,1:14:40.45,1:14:43.88,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,1:14:43.88,1:14:47.65,Default,,0,0,0,,Рахмет, апай!
Dialogue: 0,1:14:43.88,1:14:47.65,Default,,0,0,0,,Маған ағам айтты
Dialogue: 0,1:14:47.65,1:14:51.29,Default,,0,0,0,,Апай – шебер бақсы
Dialogue: 0,1:14:47.65,1:14:51.29,Default,,0,0,0,,Ол ең жақсы барабаншы!
Dialogue: 0,1:14:51.29,1:14:54.19,Default,,0,0,0,,Мен апамдай болғым келеді!
Dialogue: 0,1:14:55.89,1:15:00.43,Default,,0,0,0,,А... а... неге тоқтамайсың!
Dialogue: 0,1:15:00.43,1:15:04.37,Default,,0,0,0,,Енді... Қараңдар, алдымен оны тазалап алайық!
Dialogue: 0,1:15:04.37,1:15:07.11,Default,,0,0,0,,Бұл туралы ештеңе істей алмайсыз!
Dialogue: 0,1:15:07.11,1:15:09.11,Default,,0,0,0,,Ихихихихихи
Dialogue: 0,1:15:10.91,1:15:15.75,Default,,0,0,0,,Don't disturb me
Dialogue: 0,1:15:15.75,1:15:20.95,Default,,0,0,0,,...
Dialogue: 0,1:15:20.95,1:15:23.22,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:15:23.22,1:15:26.52,Default,,0,0,0,,Сәлем, апай!
Dialogue: 0,1:15:23.22,1:15:26.52,Default,,0,0,0,,Келесіде бәріміз пикникке барамыз ба?
Dialogue: 0,1:15:26.52,1:15:28.53,Default,,0,0,0,,Сары көлікке мін!
Dialogue: 0,1:15:28.53,1:15:33.20,Default,,0,0,0,,Идиот! Егер сізде осындай уақыт болса
Dialogue: 0,1:15:28.53,1:15:33.20,Default,,0,0,0,,Бірде-бір заклинание есімде жоқ!
Dialogue: 0,1:15:33.20,1:15:36.97,Default,,0,0,0,,Жалпы айтқанда, көліктер сол мандрака сияқты...
Dialogue: 0,1:15:33.20,1:15:36.97,Default,,0,0,0,,О, мен
Dialogue: 0,1:15:36.97,1:15:40.77,Default,,0,0,0,,Мен апам мінетін көлікке мінгім келеді.
Dialogue: 0,1:15:36.97,1:15:40.77,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:15:40.77,1:15:44.31,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:15:40.77,1:15:44.31,Default,,0,0,0,,Мен олай айтпаймын...!
Dialogue: 0,1:15:44.31,1:15:51.55,Default,,0,0,0,,Сен
Dialogue: 0,1:15:51.55,1:15:55.55,Default,,0,0,0,,<Мені мұнда әкелгеніме жарты жыл болды.
Dialogue: 0,1:15:55.55,1:16:00.59,Default,,0,0,0,,Енді
Dialogue: 0,1:15:55.55,1:16:00.59,Default,,0,0,0,,Бұл үйдегілердің бәрі мен айтқандай.
Dialogue: 0,1:16:00.59,1:16:04.23,Default,,0,0,0,,«Балалар үйінде» болған кезімнен
Dialogue: 0,1:16:00.59,1:16:04.23,Default,,0,0,0,,Әлдеқайда жақсы>
Dialogue: 0,1:16:04.23,1:16:08.43,Default,,0,0,0,,Мен аралас грильді шештім!
Dialogue: 0,1:16:08.43,1:16:11.00,Default,,0,0,0,,<Қазіргі кездегі мандрактер
Dialogue: 0,1:16:11.00,1:16:14.87,Default,,0,0,0,,«Ая-чан»
Dialogue: 0,1:16:11.00,1:16:14.87,Default,,0,0,0,,Сіз маған мейірімділікпен қоңырау шалыңыз>
Dialogue: 0,1:16:14.87,1:16:16.88,Default,,0,0,0,,Ая-чан
Dialogue: 0,1:16:16.88,1:16:21.01,Default,,0,0,0,,Қайырлы таң аға
Dialogue: 0,1:16:16.88,1:16:21.01,Default,,0,0,0,,Бүгін таңертең аралас гриль жеуге бола ма?
Dialogue: 0,1:16:21.01,1:16:23.52,Default,,0,0,0,,Иә
Dialogue: 0,1:16:21.01,1:16:23.52,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:23.52,1:16:28.09,Default,,0,0,0,,Мен кешегі қолжазбаны оқыдым.
Dialogue: 0,1:16:23.52,1:16:28.09,Default,,0,0,0,,Бұл өте қызықты болды!
Dialogue: 0,1:16:28.09,1:16:31.96,Default,,0,0,0,,Мұнарада адасып қалған балалар
Dialogue: 0,1:16:28.09,1:16:31.96,Default,,0,0,0,,Қараңғыда
Dialogue: 0,1:16:31.96,1:16:35.76,Default,,0,0,0,,Қоңырау орнына, ілулі кесілген бас
Dialogue: 0,1:16:31.96,1:16:35.76,Default,,0,0,0,,Ашу туралы
Dialogue: 0,1:16:35.76,1:16:39.03,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,1:16:39.03,1:16:41.53,Default,,0,0,0,,Қалғанын қашан оқуға болады?
Dialogue: 0,1:16:41.53,1:16:43.53,Default,,0,0,0,,Қазір жаз
Dialogue: 0,1:16:45.40,1:16:49.27,Default,,0,0,0,,<Жындар да бірте-бірте мені тыңдай бастады.
Dialogue: 0,1:16:45.40,1:16:49.27,Default,,0,0,0,,Мен тыңдай бастадым>
Dialogue: 0,1:16:49.27,1:16:52.07,Default,,0,0,0,,Енді... Жын!
Dialogue: 0,1:16:54.78,1:16:58.75,Default,,0,0,0,,Сіз қоңырау шалып жатырсыз ба?
Dialogue: 0,1:16:54.78,1:16:58.75,Default,,0,0,0,,Әдемі жас ханым
Dialogue: 0,1:16:58.75,1:17:01.89,Default,,0,0,0,,Мен және Мандрейк аралас гриль
Dialogue: 0,1:16:58.75,1:17:01.89,Default,,0,0,0,,Апай...
Dialogue: 0,1:17:01.89,1:17:07.19,Default,,0,0,0,,<Бірақ бір ғана нәрсе қалды
Dialogue: 0,1:17:01.89,1:17:07.19,Default,,0,0,0,,Кейде жағдай сіз қалағандай бола бермейді>
Dialogue: 0,1:17:08.76,1:17:12.93,Default,,0,0,0,,<Кистард сөзсіз
Dialogue: 0,1:17:08.76,1:17:12.93,Default,,0,0,0,,Олар менің үйіме келмейді.
Dialogue: 0,1:17:12.93,1:17:17.13,Default,,0,0,0,,Мен мандракадан қорқамын
Dialogue: 0,1:17:12.93,1:17:17.13,Default,,0,0,0,,Келгісі келмейді.>
Dialogue: 0,1:17:18.74,1:17:22.64,Default,,0,0,0,,Он… бе… с…
Dialogue: 0,1:17:24.34,1:17:28.95,Default,,0,0,0,,<Бірақ бәрібір
Dialogue: 0,1:17:24.34,1:17:28.95,Default,,0,0,0,,Мен бұл жаңа үйде жақсы жұмыс істеген сияқтымын.
Dialogue: 0,1:17:28.95,1:17:33.89,Default,,0,0,0,,Сондай-ақ крем туралы
Dialogue: 0,1:17:28.95,1:17:33.89,Default,,0,0,0,,Сіз сәтті пайдалана алатын нәрселер>
Dialogue: 0,1:17:33.89,1:17:37.59,Default,,0,0,0,,()
Dialogue: 0,1:17:39.69,1:17:41.69,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:44.43,1:17:46.63,Default,,0,0,0,,Оның жасырынған жеріне қатысты белгі суреттің ішінде болуы мүмкін бе?
Dialogue: 0,1:17:44.43,1:17:46.63,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:17:51.20,1:17:54.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:51.20,1:17:54.87,Default,,0,0,0,,(Есік ашылу дыбысы)
Dialogue: 0,1:17:54.87,1:17:56.84,Default,,0,0,0,,Қаймақ!
Dialogue: 0,1:17:56.84,1:17:58.84,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:58.84,1:18:02.24,Default,,0,0,0,,Рождество мерекесімен Аяцуру
Dialogue: 0,1:18:03.92,1:18:31.34,Default,,0,0,0,,Сен
Dialogue: 0,1:18:31.34,1:18:35.61,Default,,0,0,0,,...
