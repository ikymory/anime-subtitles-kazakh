Dialogue: 0,0:25:52.85,0:25:54.65,Default,,0000,0000,0000,,Күлгін раушан
Dialogue: 0,0:25:52.85,0:25:54.65,Default,,0000,0000,0000,,《Қорқпа. Дем ал.》
Dialogue: 0,0:25:52.85,0:25:54.65,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:25:54.65,0:26:06.67,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:26:06.67,0:26:08.17,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:26:06.67,0:26:08.17,Default,,0000,0000,0000,,Хамф!
Dialogue: 0,0:26:08.17,0:26:11.80,Default,,0000,0000,0000,,
Dialogue: 0,0:26:08.17,0:26:11.80,Default,,0000,0000,0000,,ашуланшақ
Dialogue: 0,0:26:08.17,0:26:11.80,Default,,0000,0000,0000,,Кансей
Dialogue: 0,0:26:08.17,0:26:11.80,Default,,0000,0000,0000,,(аудиторияның қолдауы)
Dialogue: 0,0:26:11.80,0:26:13.51,Default,,0000,0000,0000,,О!
Dialogue: 0,0:26:13.51,0:26:16.51,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:26:13.51,0:26:16.51,Default,,0000,0000,0000,,(Аомин)
Dialogue: 0,0:26:13.51,0:26:16.51,Default,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:26:13.51,0:26:16.51,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:26:13.51,0:26:16.51,Default,,0000,0000,0000,,Мен ағылшын тілін түсінбеймін. ➡
Dialogue: 0,0:26:16.51,0:26:19.31,Default,,0000,0000,0000,,Она
Dialogue: 0,0:26:16.51,0:26:19.31,Default,,0000,0000,0000,,Жарайды, солай шығар ➡
Dialogue: 0,0:26:19.31,0:26:21.98,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:26:19.31,0:26:21.98,Default,,0000,0000,0000,,Мен саған ойнап көрсетемін!
Dialogue: 0,0:26:21.98,0:26:23.48,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:26:27.02,0:26:29.19,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:26:27.02,0:26:29.19,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:26:27.02,0:26:29.19,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:26:29.19,0:26:30.66,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:26:32.52,0:26:35.79,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:26:32.52,0:26:35.79,Default,,0000,0000,0000,,《Тез!
Dialogue: 0,0:26:32.52,0:26:35.79,Default,,0000,0000,0000,,Тойоджин
Dialogue: 0,0:26:32.52,0:26:35.79,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:26:32.52,0:26:35.79,Default,,0000,0000,0000,,Мен сені шығыстық деп ойламаймын! 》
Dialogue: 0,0:26:38.53,0:26:43.30,Default,,0000,0000,0000,,Сода
Dialogue: 0,0:26:38.53,0:26:43.30,Default,,0000,0000,0000,,Сәлем. Стобаста өскен
Dialogue: 0,0:26:38.53,0:26:43.30,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:26:38.53,0:26:43.30,Default,,0000,0000,0000,,Сіз жалғыз емессіз!
Dialogue: 0,0:26:47.37,0:26:48.84,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:26:50.38,0:26:52.21,Default,,0000,0000,0000,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,0:26:50.38,0:26:52.21,Default,,0000,0000,0000,,
Dialogue: 0,0:26:52.21,0:26:54.11,Default,,0000,0000,0000,,ашуланшақ
Dialogue: 0,0:26:52.21,0:26:54.11,Default,,0000,0000,0000,,Кансей
Dialogue: 0,0:26:52.21,0:26:54.11,Default,,0000,0000,0000,,(аудиторияның қолдауы)
Dialogue: 0,0:26:52.21,0:26:54.11,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:26:54.11,0:26:58.12,Default,,0000,0000,0000,,Әке.
Dialogue: 0,0:26:54.11,0:26:58.12,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:26:54.11,0:26:58.12,Default,,0000,0000,0000,,Монах
Dialogue: 0,0:26:54.11,0:26:58.12,Default,,0000,0000,0000,,Әй, басы тамаша.
Dialogue: 0,0:26:58.12,0:27:01.62,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:26:58.12,0:27:01.62,Default,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:26:58.12,0:27:01.62,Default,,0000,0000,0000,,Сәлем. Тез шығарыңыз.
Dialogue: 0,0:26:58.12,0:27:01.62,Default,,0000,0000,0000,,Ах, о.
Dialogue: 0,0:27:06.63,0:27:08.13,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:27:06.63,0:27:08.13,Default,,0000,0000,0000,,Келіңіз.
Dialogue: 0,0:27:08.13,0:27:09.63,Default,,0000,0000,0000,,Маймылдар.
Dialogue: 0,0:27:09.63,0:27:20.81,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:27:20.81,0:27:22.31,Default,,0000,0000,0000,,Коганей
Dialogue: 0,0:27:20.81,0:27:22.31,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:27:22.31,0:27:24.64,Default,,0000,0000,0000,,Тәтті
Dialogue: 0,0:27:22.31,0:27:24.64,Default,,0000,0000,0000,,Өте тәтті! Бітір!
Dialogue: 0,0:27:24.64,0:27:27.15,Default,,0000,0000,0000,,Күлгін раушан
Dialogue: 0,0:27:24.64,0:27:27.15,Default,,0000,0000,0000,,Иә? Қайсысы!
Dialogue: 0,0:27:30.32,0:27:33.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:27:30.32,0:27:33.65,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:27:30.32,0:27:33.65,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:27:30.32,0:27:33.65,Default,,0000,0000,0000,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:27:33.65,0:27:35.15,Default,,0000,0000,0000,,Сен ақымақ.
Dialogue: 0,0:27:35.15,0:27:37.32,Default,,0000,0000,0000,,Бүгін
Dialogue: 0,0:27:35.15,0:27:37.32,Default,,0000,0000,0000,,Асаура
Dialogue: 0,0:27:35.15,0:27:37.32,Default,,0000,0000,0000,,Бүгінгі таңғы сәуегейлік➡
Dialogue: 0,0:27:37.32,0:27:40.33,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:27:37.32,0:27:40.33,Default,,0000,0000,0000,,...
Dialogue: 0,0:27:37.32,0:27:40.33,Default,,0000,0000,0000,,Бірінші орында Қатерлі ісік. ➡
Dialogue: 0,0:27:40.33,0:27:42.53,Default,,0000,0000,0000,,Сара
Dialogue: 0,0:27:40.33,0:27:42.53,Default,,0000,0000,0000,,Көбірек бақытты заттар.
Dialogue: 0,0:27:44.50,0:27:47.67,Default,,0000,0000,0000,,
Dialogue: 0,0:27:44.50,0:27:47.67,Default,,0000,0000,0000,,Мидорима
Dialogue: 0,0:27:44.50,0:27:47.67,Default,,0000,0000,0000,,Адам
Dialogue: 0,0:27:44.50,0:27:47.67,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:27:44.50,0:27:47.67,Default,,0000,0000,0000,,Миллионнан бір емес➡
Dialogue: 0,0:27:47.67,0:27:49.17,Default,,0000,0000,0000,,О.
Dialogue: 0,0:27:47.67,0:27:49.17,Default,,0000,0000,0000,,Бірдеңе құлап жатыр!
Dialogue: 0,0:27:49.17,0:27:50.84,Default,,0000,0000,0000,,ашуланшақ
Dialogue: 0,0:27:49.17,0:27:50.84,Default,,0000,0000,0000,,Кансей
Dialogue: 0,0:27:49.17,0:27:50.84,Default,,0000,0000,0000,,(аудиторияның қолдауы)
Dialogue: 0,0:27:50.84,0:27:54.47,Default,,0000,0000,0000,,(дыбыс және ысқырық)
Dialogue: 0,0:27:50.84,0:27:54.47,Default,,0000,0000,0000,,M.C.
Dialogue: 0,0:27:50.84,0:27:54.47,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:27:50.84,0:27:54.47,Default,,0000,0000,0000,,Шурё
Dialogue: 0,0:27:50.84,0:27:54.47,Default,,0000,0000,0000,,🔊 (MC) Бірінші тоқсан осында аяқталады. ➡
Dialogue: 0,0:27:54.47,0:27:57.48,Default,,0000,0000,0000,,Жетекші - Vorpal Swords!
Dialogue: 0,0:27:57.48,0:28:01.31,Default,,0000,0000,0000,,Хюга
Dialogue: 0,0:27:57.48,0:28:01.31,Default,,0000,0000,0000,,(Хината)
Dialogue: 0,0:27:57.48,0:28:01.31,Default,,0000,0000,0000,,Чоши
Dialogue: 0,0:27:57.48,0:28:01.31,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:27:57.48,0:28:01.31,Default,,0000,0000,0000,,Жарайсыңдар! Іс жақсы жүріп жатыр!
Dialogue: 0,0:28:01.31,0:28:03.31,Default,,0000,0000,0000,,Цучида
Dialogue: 0,0:28:01.31,0:28:03.31,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:28:03.31,0:28:06.28,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:28:03.31,0:28:06.28,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:28:06.28,0:28:09.65,Default,,0000,0000,0000,,Таши
Dialogue: 0,0:28:06.28,0:28:09.65,Default,,0000,0000,0000,,《Әрине
Dialogue: 0,0:28:06.28,0:28:09.65,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:28:06.28,0:28:09.65,Default,,0000,0000,0000,,О.
Dialogue: 0,0:28:06.28,0:28:09.65,Default,,0000,0000,0000,,Қазір оны итермелеп отырған – біз. ➡
Dialogue: 0,0:28:09.65,0:28:11.12,Default,,0000,0000,0000,,Бірақ…》
Dialogue: 0,0:28:13.49,0:28:14.99,Default,,0000,0000,0000,,Момой
Dialogue: 0,0:28:13.49,0:28:14.99,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:28:13.49,0:28:14.99,Default,,0000,0000,0000,,《Бірінші тоқсанда➡
Dialogue: 0,0:28:14.99,0:28:18.50,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:28:14.99,0:28:18.50,Default,,0000,0000,0000,,Барлығының таусылғаны сонша.
Dialogue: 0,0:28:14.99,0:28:18.50,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:28:14.99,0:28:18.50,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:28:14.99,0:28:18.50,Default,,0000,0000,0000,,Бірінші рет көру. ➡
Dialogue: 0,0:28:18.50,0:28:20.83,Default,,0000,0000,0000,,Ашық
Dialogue: 0,0:28:18.50,0:28:20.83,Default,,0000,0000,0000,,Ол өте жақсы қарсылас.
Dialogue: 0,0:28:20.83,0:28:25.50,Default,,0000,0000,0000,,Бұл бет болмаса
Dialogue: 0,0:28:20.83,0:28:25.50,Default,,0000,0000,0000,,Оса
Dialogue: 0,0:28:20.83,0:28:25.50,Default,,0000,0000,0000,,Осы дәрежеде басылды ма? ➡
Dialogue: 0,0:28:25.50,0:28:28.14,Default,,0000,0000,0000,,Шоджики
Dialogue: 0,0:28:25.50,0:28:28.14,Default,,0000,0000,0000,,Шынымды айтсам, мен қатты таң қалдым.
Dialogue: 0,0:28:28.14,0:28:34.15,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:28:28.14,0:28:34.15,Default,,0000,0000,0000,,Сайкоу
Dialogue: 0,0:28:28.14,0:28:34.15,Default,,0000,0000,0000,,О, бұл тамаша!
Dialogue: 0,0:28:28.14,0:28:34.15,Default,,0000,0000,0000,,Ашық
Dialogue: 0,0:28:28.14,0:28:34.15,Default,,0000,0000,0000,,Фусоку
Dialogue: 0,0:28:28.14,0:28:34.15,Default,,0000,0000,0000,,Қарсы тарап үшін кемшілік жоқ.
Dialogue: 0,0:28:37.65,0:28:39.98,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:28:37.65,0:28:39.98,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:28:39.98,0:28:43.79,Default,,0000,0000,0000,,Сондықтан. Ха...
Dialogue: 0,0:28:46.32,0:28:50.66,Default,,0000,0000,0000,,Тосын
Dialogue: 0,0:28:46.32,0:28:50.66,Default,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:28:46.32,0:28:50.66,Default,,0000,0000,0000,,Созуджо
Dialogue: 0,0:28:46.32,0:28:50.66,Default,,0000,0000,0000,,Ол сіз ойлағаннан да көп нәрсені жасайды. ➡
Dialogue: 0,0:28:50.66,0:28:54.43,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:28:50.66,0:28:54.43,Default,,0000,0000,0000,,Жапонияда да
Dialogue: 0,0:28:50.66,0:28:54.43,Default,,0000,0000,0000,,Мен мұндай адамдар бар екенін білмедім. ➡
Dialogue: 0,0:28:54.43,0:29:00.11,Default,,0000,0000,0000,,Жақсы, мен мұны істесем де.
Dialogue: 0,0:28:54.43,0:29:00.11,Default,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:28:54.43,0:29:00.11,Default,,0000,0000,0000,,Бұл маймылға қатысты. ➡
Dialogue: 0,0:29:00.11,0:29:01.77,Default,,0000,0000,0000,,Сәлем? Күміс.
Dialogue: 0,0:29:01.77,0:29:05.94,Default,,0000,0000,0000,,Оши
Dialogue: 0,0:29:01.77,0:29:05.94,Default,,0000,0000,0000,,Ах. Жақында айтайын ба?
Dialogue: 0,0:29:05.94,0:29:08.95,Default,,0000,0000,0000,,Қуат
Dialogue: 0,0:29:05.94,0:29:08.95,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:29:05.94,0:29:08.95,Default,,0000,0000,0000,,Қуат айырмашылығы. Хамф!
Dialogue: 0,0:29:10.62,0:29:12.98,Default,,0000,0000,0000,,М.К.
Dialogue: 0,0:29:10.62,0:29:12.98,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:29:10.62,0:29:12.98,Default,,0000,0000,0000,,Кайши
Dialogue: 0,0:29:10.62,0:29:12.98,Default,,0000,0000,0000,,🔊 (MC) Екінші тоқсан басталады.
Dialogue: 0,0:29:10.62,0:29:12.98,Default,,0000,0000,0000,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:29:12.98,0:29:16.45,Default,,0000,0000,0000,,М.К.
Dialogue: 0,0:29:12.98,0:29:16.45,Default,,0000,0000,0000,,
Dialogue: 0,0:29:12.98,0:29:16.45,Default,,0000,0000,0000,,🔊 (MC) Барыңыз! Vorpal Swords!
Dialogue: 0,0:29:21.66,0:29:24.16,Default,,0000,0000,0000,,Не... мынау!
Dialogue: 0,0:29:24.16,0:29:27.00,Default,,0000,0000,0000,,Хюга
Dialogue: 0,0:29:24.16,0:29:27.00,Default,,0000,0000,0000,,(Хината)
Dialogue: 0,0:29:24.16,0:29:27.00,Default,,0000,0000,0000,,Аомин
