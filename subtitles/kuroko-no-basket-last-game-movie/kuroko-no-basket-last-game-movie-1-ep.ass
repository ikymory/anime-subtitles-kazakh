Dialogue: 0,0:13:56.14,0:14:00.64,Default,,0000,0000,0000,,Куни
Dialogue: 0,0:13:56.14,0:14:00.64,Default,,0000,0000,0000,,Жоқ, бұл елде
Dialogue: 0,0:13:56.14,0:14:00.64,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:13:56.14,0:14:00.64,Default,,0000,0000,0000,,Барлық жігіттер баскетбол ойнайды➡
Dialogue: 0,0:14:00.64,0:14:03.81,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:14:00.64,0:14:03.81,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:14:00.64,0:14:03.81,Default,,0000,0000,0000,,Қазір тоқта, немесе өл.
Dialogue: 0,0:14:03.81,0:14:05.48,Default,,0000,0000,0000,,Ah, ah….
Dialogue: 0,0:14:05.48,0:14:07.81,Default,,0000,0000,0000,,Қазір жақсы
Dialogue: 0,0:14:05.48,0:14:07.81,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:07.81,0:14:11.48,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:14:07.81,0:14:11.48,Default,,0000,0000,0000,,Тіпті сендер де
Dialogue: 0,0:14:07.81,0:14:11.48,Default,,0000,0000,0000,,Сумоу
Dialogue: 0,0:14:07.81,0:14:11.48,Default,,0000,0000,0000,,Сіз маймылмен сумо ойнамас едіңіз, солай ма? ➡
Dialogue: 0,0:14:11.48,0:14:13.49,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:14:11.48,0:14:13.49,Default,,0000,0000,0000,,Бірақ біз істедік. ➡
Dialogue: 0,0:14:13.49,0:14:17.49,Default,,0000,0000,0000,,Кидо
Dialogue: 0,0:14:13.49,0:14:17.49,Default,,0000,0000,0000,,Ойыншы болып көрінген маймылмен.
Dialogue: 0,0:14:13.49,0:14:17.49,Default,,0000,0000,0000,,Мені баскетбол ойнауға жаратты. ➡
Dialogue: 0,0:14:17.49,0:14:19.33,Default,,0000,0000,0000,,...
Dialogue: 0,0:14:17.49,0:14:19.33,Default,,0000,0000,0000,,«Бір сөз»? ➡
Dialogue: 0,0:14:19.33,0:14:23.83,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:14:19.33,0:14:23.83,Default,,0000,0000,0000,,Ең алдымен, біз
Dialogue: 0,0:14:19.33,0:14:23.83,Default,,0000,0000,0000,,Тікелей
Dialogue: 0,0:14:19.33,0:14:23.83,Default,,0000,0000,0000,,Маймыл екеніңді түсін.
Dialogue: 0,0:14:23.83,0:14:28.53,Default,,0000,0000,0000,,Маймылға
Dialogue: 0,0:14:23.83,0:14:28.53,Default,,0000,0000,0000,,...
Dialogue: 0,0:14:23.83,0:14:28.53,Default,,0000,0000,0000,,Сіз баскетбол ойнай алмайсыз.
Dialogue: 0,0:14:31.00,0:14:33.01,Default,,0000,0000,0000,,Түкіру
Dialogue: 0,0:14:31.00,0:14:33.01,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,0:14:31.00,0:14:33.01,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:14:31.00,0:14:33.01,Default,,0000,0000,0000,,(Нэштің түкірген дыбысы)
Dialogue: 0,0:14:33.01,0:14:36.84,Default,,0000,0000,0000,,Ахаха….
Dialogue: 0,0:14:36.84,0:14:39.51,Default,,0000,0000,0000,,Қазір жақсы
Dialogue: 0,0:14:36.84,0:14:39.51,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:14:39.51,0:14:42.18,Default,,0000,0000,0000,,Касамацу
Dialogue: 0,0:14:39.51,0:14:42.18,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:14:42.18,0:14:44.02,Default,,0000,0000,0000,,Кагетора
Dialogue: 0,0:14:42.18,0:14:44.02,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:14:42.18,0:14:44.02,Default,,0000,0000,0000,,⚟(Қагетора) Күте тұрыңдар, балалар!
Dialogue: 0,0:14:44.02,0:14:45.82,Default,,0000,0000,0000,,Иә? а?
Dialogue: 0,0:14:46.85,0:14:51.69,Default,,0000,0000,0000,,Кагетора
Dialogue: 0,0:14:46.85,0:14:51.69,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:14:46.85,0:14:51.69,Default,,0000,0000,0000,,Мен жол бойы келдім.
Dialogue: 0,0:14:46.85,0:14:51.69,Default,,0000,0000,0000,,Суко
Dialogue: 0,0:14:46.85,0:14:51.69,Default,,0000,0000,0000,,Асо
Dialogue: 0,0:14:46.85,0:14:51.69,Default,,0000,0000,0000,,Менімен тағы ойнаңыз.
Dialogue: 0,0:14:51.69,0:14:53.96,Default,,0000,0000,0000,,О? Не айтқың келеді?
Dialogue: 0,0:14:53.96,0:14:56.63,Default,,0000,0000,0000,,Хюга
Dialogue: 0,0:14:53.96,0:14:56.63,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:14:53.96,0:14:56.63,Default,,0000,0000,0000,,Өткенге… электрондық хат па?
Dialogue: 0,0:14:56.63,0:14:59.63,Default,,0000,0000,0000,,Шуканго
Dialogue: 0,0:14:56.63,0:14:59.63,Default,,0000,0000,0000,,Бір аптадан кейін кек алу матчы!
Dialogue: 0,0:14:59.63,0:15:02.64,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:14:59.63,0:15:02.64,Default,,0000,0000,0000,,Егер біз жеңіліп қалсақ
Dialogue: 0,0:14:59.63,0:15:02.64,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:14:59.63,0:15:02.64,Default,,0000,0000,0000,,Хара
Dialogue: 0,0:14:59.63,0:15:02.64,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:14:59.63,0:15:02.64,Default,,0000,0000,0000,,Ішіңді кесемін!
Dialogue: 0,0:15:02.64,0:15:04.30,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:15:02.64,0:15:04.30,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:15:02.64,0:15:04.30,Default,,0000,0000,0000,,Алдыңғылар жеңілсе➡
Dialogue: 0,0:15:04.30,0:15:08.47,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:15:04.30,0:15:08.47,Default,,0000,0000,0000,,Кейінірек
Dialogue: 0,0:15:04.30,0:15:08.47,Default,,0000,0000,0000,,Кешірім сұрағаннан кейін
Dialogue: 0,0:15:04.30,0:15:08.47,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:15:04.30,0:15:08.47,Default,,0000,0000,0000,,Джирики
Dialogue: 0,0:15:04.30,0:15:08.47,Default,,0000,0000,0000,,Ауыстыру
Dialogue: 0,0:15:04.30,0:15:08.47,Default,,0000,0000,0000,,Үйге өзіңіз жету үшін салды пайдаланыңыз!
Dialogue: 0,0:15:08.47,0:15:11.31,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:15:08.47,0:15:11.31,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:15:08.47,0:15:11.31,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:15:08.47,0:15:11.31,Default,,0000,0000,0000,,Сіз не айттыңыз? Қарт адам.
Dialogue: 0,0:15:11.31,0:15:12.98,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:15:11.31,0:15:12.98,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:15:11.31,0:15:12.98,Default,,0000,0000,0000,,Иккай
Dialogue: 0,0:15:11.31,0:15:12.98,Default,,0000,0000,0000,,Неліктен біз мұны қайтадан жасадық➡
Dialogue: 0,0:15:12.98,0:15:16.32,Default,,0000,0000,0000,,Достық
Dialogue: 0,0:15:12.98,0:15:16.32,Default,,0000,0000,0000,,Мен ойын ойнауым керек
Dialogue: 0,0:15:12.98,0:15:16.32,Default,,0000,0000,0000,,Бұл не? Сен ақымақсың ба?
Dialogue: 0,0:15:16.32,0:15:18.52,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:15:16.32,0:15:18.52,Default,,0000,0000,0000,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:15:16.32,0:15:18.52,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:15:20.99,0:15:26.99,Default,,0000,0000,0000,,Қайдан бастарын білмеймін.
Dialogue: 0,0:15:20.99,0:15:26.99,Default,,0000,0000,0000,,Маймыл үндемей отырса жақсы болар еді.
Dialogue: 0,0:15:20.99,0:15:26.99,Default,,0000,0000,0000,,Кучики
Dialogue: 0,0:15:20.99,0:15:26.99,Default,,0000,0000,0000,,Канбен
Dialogue: 0,0:15:20.99,0:15:26.99,Default,,0000,0000,0000,,Аңғал маймылдардан бас тартпа.
Dialogue: 0,0:15:26.99,0:15:30.00,Default,,0000,0000,0000,,Ей, сен байсалдысың ба...?
Dialogue: 0,0:15:30.00,0:15:34.00,Default,,0000,0000,0000,,Хараки
Dialogue: 0,0:15:30.00,0:15:34.00,Default,,0000,0000,0000,,Қарт адамның Харакири шоуы
Dialogue: 0,0:15:30.00,0:15:34.00,Default,,0000,0000,0000,,Маған бәрібір ➡
Dialogue: 0,0:15:34.00,0:15:38.17,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:15:34.00,0:15:38.17,Default,,0000,0000,0000,,Пішін
Dialogue: 0,0:15:34.00,0:15:38.17,Default,,0000,0000,0000,,Егер мұны істегіңіз келмесе, басқа пішінді пайдаланыңыз.
Dialogue: 0,0:15:34.00,0:15:38.17,Default,,0000,0000,0000,,Цугуна
Dialogue: 0,0:15:34.00,0:15:38.17,Default,,0000,0000,0000,,Мен түзетемін. ➡
Dialogue: 0,0:15:38.17,0:15:40.51,Default,,0000,0000,0000,,Шуканго
Dialogue: 0,0:15:38.17,0:15:40.51,Default,,0000,0000,0000,,1 аптадан кейін➡
Dialogue: 0,0:15:40.51,0:15:44.01,Default,,0000,0000,0000,,Нидо
Dialogue: 0,0:15:40.51,0:15:44.01,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:15:40.51,0:15:44.01,Default,,0000,0000,0000,,Енді ешқашан
Dialogue: 0,0:15:40.51,0:15:44.01,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:15:40.51,0:15:44.01,Default,,0000,0000,0000,,Мен сенің жеңіліп қалмауыңды қадағалаймын.
Dialogue: 0,0:15:45.04,0:15:47.88,Default,,0000,0000,0000,,Әй... Әке.
Dialogue: 0,0:15:45.04,0:15:47.88,Default,,0000,0000,0000,,Кек матч деген не?
Dialogue: 0,0:15:47.88,0:15:51.05,Default,,0000,0000,0000,,Мүшелер
Dialogue: 0,0:15:47.88,0:15:51.05,Default,,0000,0000,0000,,Сіз не істеуді жоспарлап отырсыз? ?
Dialogue: 0,0:15:51.05,0:15:53.39,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:15:51.05,0:15:53.39,Default,,0000,0000,0000,,Мен ол жігіттерді жеңе алатыныма сене алар емеспін➡
Dialogue: 0,0:15:53.39,0:15:57.86,Default,,0000,0000,0000,,Олай емес...
Dialogue: 0,0:15:53.39,0:15:57.86,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:15:53.39,0:15:57.86,Default,,0000,0000,0000,,Менің ойымша, бұл оларға байланысты.
Dialogue: 0,0:16:00.63,0:16:02.63,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:16:00.63,0:16:02.63,Default,,0000,0000,0000,,Куроко
Dialogue: 0,0:16:00.63,0:16:02.63,Default,,0000,0000,0000,,Курококкиден
Dialogue: 0,0:16:00.63,0:16:02.63,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:16:00.63,0:16:02.63,Default,,0000,0000,0000,,Кенеттен маған электрондық хат келді➡
Dialogue: 0,0:16:02.63,0:16:04.80,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:16:02.63,0:16:04.80,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:16:02.63,0:16:04.80,Default,,0000,0000,0000,,Маған бірдеңе қызық болды.
Dialogue: 0,0:16:04.80,0:16:08.97,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:16:04.80,0:16:08.97,Default,,0000,0000,0000,,Бірақ солай.
Dialogue: 0,0:16:04.80,0:16:08.97,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:16:04.80,0:16:08.97,Default,,0000,0000,0000,,Ұрыс таңдаймын ба деп қорқамын.
Dialogue: 0,0:16:08.97,0:16:12.14,Default,,0000,0000,0000,,Мидорима
Dialogue: 0,0:16:08.97,0:16:12.14,Default,,0000,0000,0000,,Қайдан бастарын білмеймін.
Dialogue: 0,0:16:08.97,0:16:12.14,Default,,0000,0000,0000,,Мен үндемей тұра алмаймын
Dialogue: 0,0:16:08.97,0:16:12.14,Default,,0000,0000,0000,,Мен бармаймын.
Dialogue: 0,0:16:12.14,0:16:15.81,Default,,0000,0000,0000,,Күлгін раушан
Dialogue: 0,0:16:12.14,0:16:15.81,Default,,0000,0000,0000,,(Мұрасакибара)
Dialogue: 0,0:16:12.14,0:16:15.81,Default,,0000,0000,0000,,күрсіну. Бұл ауырса да.
Dialogue: 0,0:16:15.81,0:16:18.98,Default,,0000,0000,0000,,Айғақ
Dialogue: 0,0:16:15.81,0:16:18.98,Default,,0000,0000,0000,,(Акаши)
Dialogue: 0,0:16:15.81,0:16:18.98,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:16:15.81,0:16:18.98,Default,,0000,0000,0000,,Хехе. Бірақ бұл да қызық. ➡
Dialogue: 0,0:16:18.98,0:16:21.98,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:16:18.98,0:16:21.98,Default,,0000,0000,0000,,Бір рет
Dialogue: 0,0:16:18.98,0:16:21.98,Default,,0000,0000,0000,,Мен мұны қайталаймыз деп ойламаппын➡
Dialogue: 0,0:16:21.98,0:16:24.98,Default,,0000,0000,0000,,Она
Dialogue: 0,0:16:21.98,0:16:24.98,Default,,0000,0000,0000,,Бір командада
Dialogue: 0,0:16:21.98,0:16:24.98,Default,,0000,0000,0000,,Ұрыс
Dialogue: 0,0:16:21.98,0:16:24.98,Default,,0000,0000,0000,,Мен ұрысатынымызға сене алар емеспін.
Dialogue: 0,0:16:26.82,0:16:29.82,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:16:26.82,0:16:29.82,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:26.82,0:16:29.82,Default,,0000,0000,0000,,Мидорима
Dialogue: 0,0:16:26.82,0:16:29.82,Default,,0000,0000,0000,,Тентелер
Dialogue: 0,0:16:26.82,0:16:29.82,Default,,0000,0000,0000,,Біраз уақыт өтті.
Dialogue: 0,0:16:29.82,0:16:33.83,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:16:29.82,0:16:33.83,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:16:29.82,0:16:33.83,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:16:29.82,0:16:33.83,Default,,0000,0000,0000,,Мен күткеннен де көп кездесу
Dialogue: 0,0:16:29.82,0:16:33.83,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:16:29.82,0:16:33.83,Default,,0000,0000,0000,,Күлгін раушан
Dialogue: 0,0:16:29.82,0:16:33.83,Default,,0000,0000,0000,,Бұл тез болды. Мурасакибаракчи.
Dialogue: 0,0:16:33.83,0:16:35.66,Default,,0000,0000,0000,,Күлгін раушан
