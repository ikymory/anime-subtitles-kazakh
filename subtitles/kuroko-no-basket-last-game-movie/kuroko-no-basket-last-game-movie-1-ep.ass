Dialogue: 0,0:17:17.00,0:17:19.17,Default,,0000,0000,0000,,қою
Dialogue: 0,0:17:17.00,0:17:19.17,Default,,0000,0000,0000,,Кешіктіргеніміз үшін кешірім сұраймыз.
Dialogue: 0,0:17:19.17,0:17:20.67,Default,,0000,0000,0000,,Хюга Сенпай
Dialogue: 0,0:17:19.17,0:17:20.67,Default,,0000,0000,0000,,Хината-сенпай!
Dialogue: 0,0:17:20.67,0:17:22.17,Default,,0000,0000,0000,,Мидорима
Dialogue: 0,0:17:20.67,0:17:22.17,Default,,0000,0000,0000,,Такао
Dialogue: 0,0:17:20.67,0:17:22.17,Default,,0000,0000,0000,,Такао.
Dialogue: 0,0:17:20.67,0:17:22.17,Default,,0000,0000,0000,,Такао
Dialogue: 0,0:17:20.67,0:17:22.17,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:17:22.17,0:17:25.68,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:17:22.17,0:17:25.68,Default,,0000,0000,0000,,Вакамацу
Dialogue: 0,0:17:22.17,0:17:25.68,Default,,0000,0000,0000,,Вакамацу.
Dialogue: 0,0:17:22.17,0:17:25.68,Default,,0000,0000,0000,,Вакамацу
Dialogue: 0,0:17:22.17,0:17:25.68,Default,,0000,0000,0000,,Сенпай
Dialogue: 0,0:17:22.17,0:17:25.68,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:17:22.17,0:17:25.68,Default,,0000,0000,0000,,«сенпайды» қосыңыз Эй!
Dialogue: 0,0:17:25.68,0:17:29.35,Default,,0000,0000,0000,,Шин
Dialogue: 0,0:17:25.68,0:17:29.35,Default,,0000,0000,0000,,Сәлеметсіз бе. Менің шын Чан
Dialogue: 0,0:17:25.68,0:17:29.35,Default,,0000,0000,0000,,Сева
Dialogue: 0,0:17:25.68,0:17:29.35,Default,,0000,0000,0000,,Көмегің үшін рахмет.
Dialogue: 0,0:17:29.35,0:17:31.18,Default,,0000,0000,0000,,Мидорима
Dialogue: 0,0:17:29.35,0:17:31.18,Default,,0000,0000,0000,,Қайдан бастарын білмеймін.
Dialogue: 0,0:17:29.35,0:17:31.18,Default,,0000,0000,0000,,Такао
Dialogue: 0,0:17:29.35,0:17:31.18,Default,,0000,0000,0000,,Тыныш, Такао.
Dialogue: 0,0:17:31.18,0:17:33.69,Default,,0000,0000,0000,,Хюга
Dialogue: 0,0:17:31.18,0:17:33.69,Default,,0000,0000,0000,,Атто
Dialogue: 0,0:17:31.18,0:17:33.69,Default,,0000,0000,0000,,《Бұл шынымен де таң қалдырады. ➡
Dialogue: 0,0:17:33.69,0:17:36.36,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:17:33.69,0:17:36.36,Default,,0000,0000,0000,,Мен... Жарайды ма? Бұл мен…》
Dialogue: 0,0:17:36.36,0:17:40.03,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:17:36.36,0:17:40.03,Default,,0000,0000,0000,,Тым қатты болмай.
Dialogue: 0,0:17:36.36,0:17:40.03,Default,,0000,0000,0000,,Кангей
Dialogue: 0,0:17:36.36,0:17:40.03,Default,,0000,0000,0000,,Әрине, қош келдіңіз.
Dialogue: 0,0:17:40.03,0:17:44.03,Default,,0000,0000,0000,,Хюга
Dialogue: 0,0:17:40.03,0:17:44.03,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:17:40.03,0:17:44.03,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:17:40.03,0:17:44.03,Default,,0000,0000,0000,,《Менің ойым оқылды, және
Dialogue: 0,0:17:40.03,0:17:44.03,Default,,0000,0000,0000,,Тошишита
Dialogue: 0,0:17:40.03,0:17:44.03,Default,,0000,0000,0000,,Vegetation
Dialogue: 0,0:17:40.03,0:17:44.03,Default,,0000,0000,0000,,Артымнан өзімнен кіші біреу мейіріммен ерді! 》
Dialogue: 0,0:17:44.03,0:17:46.37,Default,,0000,0000,0000,,Күлгін раушан
Dialogue: 0,0:17:44.03,0:17:46.37,Default,,0000,0000,0000,,Хика
Dialogue: 0,0:17:44.03,0:17:46.37,Default,,0000,0000,0000,,Ими
Dialogue: 0,0:17:44.03,0:17:46.37,Default,,0000,0000,0000,,Тоқтау нені білдіреді?
Dialogue: 0,0:17:46.37,0:17:49.37,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:17:46.37,0:17:49.37,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:17:46.37,0:17:49.37,Default,,0000,0000,0000,,Хика
Dialogue: 0,0:17:46.37,0:17:49.37,Default,,0000,0000,0000,,Бұл бұл адам менің сақтық көшірмесім екенін білдіре ме?
Dialogue: 0,0:17:49.37,0:17:52.37,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:17:49.37,0:17:52.37,Default,,0000,0000,0000,,Мен сен сияқты адамды қаламаймын
Dialogue: 0,0:17:49.37,0:17:52.37,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:17:49.37,0:17:52.37,Default,,0000,0000,0000,,Мені шақырды!
Dialogue: 0,0:17:52.37,0:17:53.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:53.87,0:17:56.64,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:17:53.87,0:17:56.64,Default,,0000,0000,0000,,Енді барлығы осында.
Dialogue: 0,0:17:56.64,0:17:59.81,Default,,0000,0000,0000,,Джижо
Dialogue: 0,0:17:56.64,0:17:59.81,Default,,0000,0000,0000,,Барлығы, жағдай
Dialogue: 0,0:17:56.64,0:17:59.81,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:17:56.64,0:17:59.81,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:17:56.64,0:17:59.81,Default,,0000,0000,0000,,Менің ойымша, сіз білесіз➡
Dialogue: 0,0:17:59.81,0:18:01.81,Default,,0000,0000,0000,,Джаббервокқа
Dialogue: 0,0:17:59.81,0:18:01.81,Default,,0000,0000,0000,,Тайкоу
Dialogue: 0,0:17:59.81,0:18:01.81,Default,,0000,0000,0000,,Егер қарсы тұра алсаңыз➡
Dialogue: 0,0:18:01.81,0:18:04.65,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:18:01.81,0:18:04.65,Default,,0000,0000,0000,,Біз оның жайлы өте аз білеміз…
Dialogue: 0,0:18:01.81,0:18:04.65,Default,,0000,0000,0000,,Дөрекі болмаңыз. ➡
Dialogue: 0,0:18:04.65,0:18:08.32,Default,,0000,0000,0000,,Осы топпен
Dialogue: 0,0:18:04.65,0:18:08.32,Default,,0000,0000,0000,,Шуканго
Dialogue: 0,0:18:04.65,0:18:08.32,Default,,0000,0000,0000,,Идо
Dialogue: 0,0:18:04.65,0:18:08.32,Default,,0000,0000,0000,,Бір аптада кек алу матчына шақырыңыз. ➡
Dialogue: 0,0:18:08.32,0:18:11.82,Default,,0000,0000,0000,,Тыңдау
Dialogue: 0,0:18:08.32,0:18:11.82,Default,,0000,0000,0000,,Осындай мүмкіндік
Dialogue: 0,0:18:08.32,0:18:11.82,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:18:08.32,0:18:11.82,Default,,0000,0000,0000,,Нидо
Dialogue: 0,0:18:08.32,0:18:11.82,Default,,0000,0000,0000,,Енді ешқашан болмайды.
Dialogue: 0,0:18:11.82,0:18:15.13,Default,,0000,0000,0000,,Konkai
Dialogue: 0,0:18:11.82,0:18:15.13,Default,,0000,0000,0000,,Бұл бір реттік арман командасы.
Dialogue: 0,0:18:15.13,0:18:25.67,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:25.67,0:18:27.67,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:18:27.67,0:18:38.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:38.02,0:18:39.85,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:39.85,0:18:51.20,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:51.20,0:18:53.37,Default,,0000,0000,0000,,Иә. Жарайсың!
Dialogue: 0,0:18:53.37,0:18:58.27,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:18:53.37,0:18:58.27,Default,,0000,0000,0000,,Миката
Dialogue: 0,0:18:53.37,0:18:58.27,Default,,0000,0000,0000,,Олардың барлығы мен жағында екеніне сене алар емеспін.
Dialogue: 0,0:18:53.37,0:18:58.27,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:18:53.37,0:18:58.27,Default,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:18:53.37,0:18:58.27,Default,,0000,0000,0000,,Бұл өте сенімді әңгіме емес!
Dialogue: 0,0:18:58.27,0:19:05.44,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:05.44,0:19:08.45,Default,,0000,0000,0000,,
Dialogue: 0,0:19:05.44,0:19:08.45,Default,,0000,0000,0000,,Кагетора
Dialogue: 0,0:19:05.44,0:19:08.45,Default,,0000,0000,0000,,О.
Dialogue: 0,0:19:05.44,0:19:08.45,Default,,0000,0000,0000,,Жарайды, бітті! ➡
Dialogue: 0,0:19:08.45,0:19:11.05,Default,,0000,0000,0000,,Ертең
Dialogue: 0,0:19:08.45,0:19:11.05,Default,,0000,0000,0000,,Хонбан
Dialogue: 0,0:19:08.45,0:19:11.05,Default,,0000,0000,0000,,Ертеңгі қойылым ғана қалды!
Dialogue: 0,0:19:13.79,0:19:16.79,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:19:13.79,0:19:16.79,Default,,0000,0000,0000,,Хюга-кун
Dialogue: 0,0:19:13.79,0:19:16.79,Default,,0000,0000,0000,,Жақсы жұмыс, Хината-кун.
Dialogue: 0,0:19:13.79,0:19:16.79,Default,,0000,0000,0000,,О.
Dialogue: 0,0:19:16.79,0:19:18.46,Default,,0000,0000,0000,,Тегота
Dialogue: 0,0:19:16.79,0:19:18.46,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Жауабы қандай?
Dialogue: 0,0:19:18.46,0:19:22.96,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:19:18.46,0:19:22.96,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:19:18.46,0:19:22.96,Default,,0000,0000,0000,,Оны көргенде білесің.
Dialogue: 0,0:19:18.46,0:19:22.96,Default,,0000,0000,0000,,Бұл команда керемет.
Dialogue: 0,0:19:22.96,0:19:25.80,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:19:22.96,0:19:25.80,Default,,0000,0000,0000,,Біраз уақыттан кейін шығады.
Dialogue: 0,0:19:22.96,0:19:25.80,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:19:22.96,0:19:25.80,Default,,0000,0000,0000,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:19:25.80,0:19:29.80,Default,,0000,0000,0000,,Роппонги
Dialogue: 0,0:19:25.80,0:19:29.80,Default,,0000,0000,0000,,Ренчю
Dialogue: 0,0:19:25.80,0:19:29.80,Default,,0000,0000,0000,,Роппонги. Джеббервок жігіттері
Dialogue: 0,0:19:25.80,0:19:29.80,Default,,0000,0000,0000,,Аба
Dialogue: 0,0:19:25.80,0:19:29.80,Default,,0000,0000,0000,,Ол жабайы жүгіріп бара жатқан сияқты.
Dialogue: 0,0:19:29.80,0:19:31.97,Default,,0000,0000,0000,,Роппонги
Dialogue: 0,0:19:29.80,0:19:31.97,Default,,0000,0000,0000,,Роппонги? Джеббервок?
Dialogue: 0,0:19:31.97,0:19:34.47,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:19:31.97,0:19:34.47,Default,,0000,0000,0000,,Кагетора
Dialogue: 0,0:19:31.97,0:19:34.47,Default,,0000,0000,0000,,Бірақ неге Кагетора-сан?
Dialogue: 0,0:19:34.47,0:19:37.14,Default,,0000,0000,0000,,Кагетора
Dialogue: 0,0:19:34.47,0:19:37.14,Default,,0000,0000,0000,,Тайзай
Dialogue: 0,0:19:34.47,0:19:37.14,Default,,0000,0000,0000,,Олардың тұруы
Dialogue: 0,0:19:34.47,0:19:37.14,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:19:34.47,0:19:37.14,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:19:34.47,0:19:37.14,Default,,0000,0000,0000,,Себебі мен өзімді кейінге қалдыруға мәжбүр еттім➡
Dialogue: 0,0:19:37.14,0:19:39.98,Default,,0000,0000,0000,,Менің тобым
Dialogue: 0,0:19:37.14,0:19:39.98,Default,,0000,0000,0000,,Асо
Dialogue: 0,0:19:37.14,0:19:39.98,Default,,0000,0000,0000,,Мен оған әр түнде ойнауға рұқсат етемін. ➡
Dialogue: 0,0:19:39.98,0:19:41.98,Default,,0000,0000,0000,,Жибара
Dialogue: 0,0:19:39.98,0:19:41.98,Default,,0000,0000,0000,,Ал өз есебінен...
Dialogue: 0,0:19:41.98,0:19:44.32,Default,,0000,0000,0000,,Жибара
Dialogue: 0,0:19:41.98,0:19:44.32,Default,,0000,0000,0000,,Қалтадан! ?
Dialogue: 0,0:19:41.98,0:19:44.32,Default,,0000,0000,0000,,Хюга
Dialogue: 0,0:19:41.98,0:19:44.32,Default,,0000,0000,0000,,Өтірік...! ?
Dialogue: 0,0:19:44.32,0:19:47.65,Default,,0000,0000,0000,,Ұрыс
Dialogue: 0,0:19:44.32,0:19:47.65,Default,,0000,0000,0000,,《Бұл жекпе-жек
Dialogue: 0,0:19:44.32,0:19:47.65,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:19:44.32,0:19:47.65,Default,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:19:44.32,0:19:47.65,Default,,0000,0000,0000,,Болашақ
Dialogue: 0,0:19:44.32,0:19:47.65,Default,,0000,0000,0000,,Біздің отбасымыздың болашағына да қауіп төніп тұр》
Dialogue: 0,0:19:47.65,0:19:49.15,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:19:47.65,0:19:49.15,Default,,0000,0000,0000,,Кагами-цчи.
Dialogue: 0,0:19:49.15,0:19:51.49,Default,,0000,0000,0000,,Шиа
Dialogue: 0,0:19:49.15,0:19:51.49,Default,,0000,0000,0000,,Өңдеу үшін
Dialogue: 0,0:19:49.15,0:19:51.49,Default,,0000,0000,0000,,Суко
Dialogue: 0,0:19:49.15,0:19:51.49,Default,,0000,0000,0000,,Бірден бір
Dialogue: 0,0:19:49.15,0:19:51.49,Default,,0000,0000,0000,,Кішкене 1ON1 жасағыңыз келмей ме?
Dialogue: 0,0:19:51.49,0:19:53.16,Default,,0000,0000,0000,,О, жақсы!
Dialogue: 0,0:19:53.16,0:19:55.96,Default,,0000,0000,0000,,Момой
Dialogue: 0,0:19:53.16,0:19:55.96,Default,,0000,0000,0000,,Көп емес
Dialogue: 0,0:19:53.16,0:19:55.96,Default,,0000,0000,0000,,Тым қобалжымаңыз.
Dialogue: 0,0:19:55.96,0:19:58.96,Default,,0000,0000,0000,,және т.б.
Dialogue: 0,0:19:55.96,0:19:58.96,Default,,0000,0000,0000,,Басқалар да
Dialogue: 0,0:19:55.96,0:19:58.96,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:19:55.96,0:19:58.96,Default,,0000,0000,0000,,Кун
Dialogue: 0,0:19:55.96,0:19:58.96,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:19:55.96,0:19:58.96,Default,,0000,0000,0000,,Кисе-кун сияқты мінезің болса➡
Dialogue: 0,0:19:58.96,0:20:01.63,Default,,0000,0000,0000,,Суко
Dialogue: 0,0:19:58.96,0:20:01.63,Default,,0000,0000,0000,,«Мен… мен адаммын.»
Dialogue: 0,0:19:58.96,0:20:01.63,Default,,0000,0000,0000,,Мұны істеу оңай.
Dialogue: 0,0:20:01.63,0:20:03.64,Default,,0000,0000,0000,,Күтті
Dialogue: 0,0:20:01.63,0:20:03.64,Default,,0000,0000,0000,,Мүлде жоқ.
Dialogue: 0,0:20:03.64,0:20:06.47,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:20:03.64,0:20:06.47,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:20:03.64,0:20:06.47,Default,,0000,0000,0000,,Олай болса, кеттік, Кагами...
Dialogue: 0,0:20:06.47,0:20:08.27,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:20:06.47,0:20:08.27,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:20:06.47,0:20:08.27,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:20:08.27,0:20:10.64,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:20:08.27,0:20:10.64,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:20:08.27,0:20:10.64,Default,,0000,0000,0000,,Тецу, сен қайда кеткеніңді білмейсің бе?
Dialogue: 0,0:20:10.64,0:20:14.65,Default,,0000,0000,0000,,Мидорима
Dialogue: 0,0:20:10.64,0:20:14.65,Default,,0000,0000,0000,,Кагетора
Dialogue: 0,0:20:10.64,0:20:14.65,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:20:10.64,0:20:14.65,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:20:10.64,0:20:14.65,Default,,0000,0000,0000,,Кагетора-сан пайда болғаннан кейін бірден
Dialogue: 0,0:20:10.64,0:20:14.65,Default,,0000,0000,0000,,Ол кетті.
Dialogue: 0,0:20:14.65,0:20:16.11,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:20:14.65,0:20:16.11,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:20:14.65,0:20:16.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:17.15,0:20:24.62,Default,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:20:17.15,0:20:24.62,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:20:17.15,0:20:24.62,Default,,0000,0000,0000,,(Күмістің күлкісі)
Dialogue: 0,0:20:27.49,0:20:29.66,Default,,0000,0000,0000,,Ахаха….
Dialogue: 0,0:20:29.66,0:20:32.00,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:20:32.00,0:20:33.97,Default,,0000,0000,0000,,Ол жай ғана біреудің оны кешіруін қалады ғой, иә?
Dialogue: 0,0:20:32.00,0:20:33.97,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:20:32.00,0:20:33.97,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:20:38.67,0:20:40.67,Default,,0000,0000,0000,,Бүгін
Dialogue: 0,0:20:38.67,0:20:40.67,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:20:38.67,0:20:40.67,Default,,0000,0000,0000,,Сәлем. Бүгін не болды?
Dialogue: 0,0:20:40.67,0:20:42.34,Default,,0000,0000,0000,,Козу
Dialogue: 0,0:20:40.67,0:20:42.34,Default,,0000,0000,0000,,Сіз балаларды әкелесіз бе?
Dialogue: 0,0:20:42.34,0:20:44.84,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:20:42.34,0:20:44.84,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:20:42.34,0:20:44.84,Default,,0000,0000,0000,,О? Не айттың...
Dialogue: 0,0:20:44.84,0:20:46.35,Default,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:20:44.84,0:20:46.35,Default,,0000,0000,0000,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:20:46.35,0:20:49.68,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:20:46.35,0:20:49.68,Default,,0000,0000,0000,,Сіз.
Dialogue: 0,0:20:46.35,0:20:49.68,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:20:46.35,0:20:49.68,Default,,0000,0000,0000,,Сіз қашан менің соңымнан жүре бастадыңыз?
Dialogue: 0,0:20:49.68,0:20:51.85,Default,,0000,0000,0000,,Куроко
Dialogue: 0,0:20:49.68,0:20:51.85,Default,,0000,0000,0000,,Менің атым Тецуя Куроко.
Dialogue: 0,0:20:51.85,0:20:56.59,Default,,0000,0000,0000,,Ұрыс
Dialogue: 0,0:20:51.85,0:20:56.59,Default,,0000,0000,0000,,Ертең саған қарсы шығатын команда
Dialogue: 0,0:20:51.85,0:20:56.59,Default,,0000,0000,0000,,Сенсей
Dialogue: 0,0:20:51.85,0:20:56.59,Default,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:20:51.85,0:20:56.59,Default,,0000,0000,0000,,Ойыншылардың бірі.
Dialogue: 0,0:20:56.59,0:21:00.09,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:20:56.59,0:21:00.09,Default,,0000,0000,0000,,Джудан
Dialogue: 0,0:20:56.59,0:21:00.09,Default,,0000,0000,0000,,Иә? Не қалжыңдап тұрсың? Бұл дұрыс.
Dialogue: 0,0:21:00.09,0:21:01.79,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:21:00.09,0:21:01.79,Default,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:21:02.76,0:21:04.76,Default,,0000,0000,0000,,Пу ха ха ха….
Dialogue: 0,0:21:04.76,0:21:07.10,Default,,0000,0000,0000,,
Dialogue: 0,0:21:04.76,0:21:07.10,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:21:04.76,0:21:07.10,Default,,0000,0000,0000,,Не? Бұл дұрыс. Бұл мүмкін емес!
Dialogue: 0,0:21:07.10,0:21:08.60,Default,,0000,0000,0000,,Ашық
Dialogue: 0,0:21:07.10,0:21:08.60,Default,,0000,0000,0000,,Бұл қарсылас➡
Dialogue: 0,0:21:08.60,0:21:12.60,Default,,0000,0000,0000,,Таши
Dialogue: 0,0:21:08.60,0:21:12.60,Default,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:21:08.60,0:21:12.60,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:21:08.60,0:21:12.60,Default,,0000,0000,0000,,Расында мен күліп құладым.
Dialogue: 0,0:21:08.60,0:21:12.60,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:21:08.60,0:21:12.60,Default,,0000,0000,0000,,Мен жеңіліп қалуым мүмкін!
Dialogue: 0,0:21:12.60,0:21:14.44,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:21:12.60,0:21:14.44,Default,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:21:12.60,0:21:14.44,Default,,0000,0000,0000,,Үйге барма, мен.
Dialogue: 0,0:21:14.44,0:21:18.28,Default,,0000,0000,0000,,Осындай жерде болу
Dialogue: 0,0:21:14.44,0:21:18.28,Default,,0000,0000,0000,,Око
Dialogue: 0,0:21:14.44,0:21:18.28,Default,,0000,0000,0000,,Анам саған ашуланады, солай ма?
Dialogue: 0,0:21:18.28,0:21:19.95,Default,,0000,0000,0000,,(Номудың айғайы)
Dialogue: 0,0:21:19.95,0:21:22.45,Default,,0000,0000,0000,,Неліктен маймылдар баскетбол ойнамайды➡
Dialogue: 0,0:21:22.45,0:21:24.78,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:21:22.45,0:21:24.78,Default,,0000,0000,0000,,Сіз мұны айттыңыз ба?
Dialogue: 0,0:21:24.78,0:21:26.49,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:29.96,0:21:31.46,Default,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,0:21:31.46,0:21:33.79,Default,,0000,0000,0000,,Күлгін раушан
Dialogue: 0,0:21:31.46,0:21:33.79,Default,,0000,0000,0000,,(Мұрасакибара)
Dialogue: 0,0:21:31.46,0:21:33.79,Default,,0000,0000,0000,,Күтілгендей, бұл дұрыс емес.
Dialogue: 0,0:21:33.79,0:21:36.13,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:21:33.79,0:21:36.13,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:21:33.79,0:21:36.13,Default,,0000,0000,0000,,Іс жүзінде
Dialogue: 0,0:21:33.79,0:21:36.13,Default,,0000,0000,0000,,Менің шын мәнінде соттылығым бар!
Dialogue: 0,0:21:36.13,0:21:38.46,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:21:36.13,0:21:38.46,Default,,0000,0000,0000,,Тецу болса мүмкін...
Dialogue: 0,0:21:38.46,0:21:41.13,Default,,0000,0000,0000,,Егер солай болса
Dialogue: 0,0:21:38.46,0:21:41.13,Default,,0000,0000,0000,,Шин
Dialogue: 0,0:21:38.46,0:21:41.13,Default,,0000,0000,0000,,Ол сенгісіз.
Dialogue: 0,0:21:41.13,0:21:45.14,Default,,0000,0000,0000,,Кейде
Dialogue: 0,0:21:41.13,0:21:45.14,Default,,0000,0000,0000,,Куроко
Dialogue: 0,0:21:41.13,0:21:45.14,Default,,0000,0000,0000,,Кейде Куроко
Dialogue: 0,0:21:41.13,0:21:45.14,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:21:41.13,0:21:45.14,Default,,0000,0000,0000,,Жақсы көрінеді
Dialogue: 0,0:21:41.13,0:21:45.14,Default,,0000,0000,0000,,Сіз тіпті мен болжай алмайтын нәрселерді жасайсыз.
Dialogue: 0,0:21:45.14,0:21:47.14,Default,,0000,0000,0000,,Iso
Dialogue: 0,0:21:45.14,0:21:47.14,Default,,0000,0000,0000,,Әзірге асығайық.
Dialogue: 0,0:21:48.97,0:21:51.64,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:21:48.97,0:21:51.64,Default,,0000,0000,0000,,Сіздің көзқарасыңыз бойынша
Dialogue: 0,0:21:48.97,0:21:51.64,Default,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:21:48.97,0:21:51.64,Default,,0000,0000,0000,,Біздің баскетболымыз➡
Dialogue: 0,0:21:51.64,0:21:54.95,Default,,0000,0000,0000,,Маймыл сияқты
Dialogue: 0,0:21:51.64,0:21:54.95,Default,,0000,0000,0000,,Цутана
Dialogue: 0,0:21:51.64,0:21:54.95,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:21:51.64,0:21:54.95,Default,,0000,0000,0000,,Бұл ыңғайсыз болып көрінуі мүмкін.
Dialogue: 0,0:21:54.95,0:21:57.95,Default,,0000,0000,0000,,Бірақ солай болса да➡
Dialogue: 0,0:21:57.95,0:22:01.29,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:21:57.95,0:22:01.29,Default,,0000,0000,0000,,Неліктен маған тоқта деп айту керек?
Dialogue: 0,0:21:57.95,0:22:01.29,Default,,0000,0000,0000,,солай емес пе?
Dialogue: 0,0:22:01.29,0:22:04.46,Default,,0000,0000,0000,,Баскетбол ойнау
Dialogue: 0,0:22:01.29,0:22:04.46,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:01.29,0:22:04.46,Default,,0000,0000,0000,,Сізге ешқандай біліктілік қажет емес!
Dialogue: 0,0:22:07.59,0:22:09.76,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:22:07.59,0:22:09.76,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:07.59,0:22:09.76,Default,,0000,0000,0000,,О? Не? Алдынан.
Dialogue: 0,0:22:09.76,0:22:11.26,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:09.76,0:22:11.26,Default,,0000,0000,0000,,Неліктен бұлай айту үшін жолдан шығып кеттіңіз?
Dialogue: 0,0:22:11.26,0:22:13.43,Default,,0000,0000,0000,,Күміс!
Dialogue: 0,0:22:11.26,0:22:13.43,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:22:13.43,0:22:17.44,Default,,0000,0000,0000,,Маймыл
Dialogue: 0,0:22:13.43,0:22:17.44,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:22:13.43,0:22:17.44,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:13.43,0:22:17.44,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:22:13.43,0:22:17.44,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:22:13.43,0:22:17.44,Default,,0000,0000,0000,,Мен мұнда не айту үшін келдім...
Dialogue: 0,0:22:17.44,0:22:19.60,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:22:19.60,0:22:21.11,Default,,0000,0000,0000,,Куроко
Dialogue: 0,0:22:19.60,0:22:21.11,Default,,0000,0000,0000,,Куроко!
Dialogue: 0,0:22:21.11,0:22:23.78,Default,,0000,0000,0000,,О.
Dialogue: 0,0:22:21.11,0:22:23.78,Default,,0000,0000,0000,,болды
Dialogue: 0,0:22:21.11,0:22:23.78,Default,,0000,0000,0000,,Ауырды.
Dialogue: 0,0:22:23.78,0:22:25.98,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:23.78,0:22:25.98,Default,,0000,0000,0000,,(жөтел)
Dialogue: 0,0:22:26.95,0:22:30.78,Default,,0000,0000,0000,,Шатасу
Dialogue: 0,0:22:26.95,0:22:30.78,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:26.95,0:22:30.78,Default,,0000,0000,0000,,Ешқандай қате айтпаңыз.
Dialogue: 0,0:22:30.78,0:22:35.59,Default,,0000,0000,0000,,Әшекейлеу
Dialogue: 0,0:22:30.78,0:22:35.59,Default,,0000,0000,0000,,Маймылдың талабы қандай?
Dialogue: 0,0:22:30.78,0:22:35.59,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:22:30.78,0:22:35.59,Default,,0000,0000,0000,,Менен сұрамадың.
Dialogue: 0,0:22:40.49,0:22:42.66,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:40.49,0:22:42.66,Default,,0000,0000,0000,,Темае және т.б.
Dialogue: 0,0:22:42.66,0:22:44.16,Default,,0000,0000,0000,,Командаластарыма➡
Dialogue: 0,0:22:44.16,0:22:46.13,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:22:44.16,0:22:46.13,Default,,0000,0000,0000,,Мен үшін не істеп жатырсың!
Dialogue: 0,0:22:48.80,0:22:50.30,Default,,0000,0000,0000,,О.
Dialogue: 0,0:22:50.30,0:22:53.64,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:22:50.30,0:22:53.64,Default,,0000,0000,0000,,Шамасы, балалар
Dialogue: 0,0:22:50.30,0:22:53.64,Default,,0000,0000,0000,,Керемет ашылу
Dialogue: 0,0:22:50.30,0:22:53.64,Default,,0000,0000,0000,,Ертеңгі қарсылас сияқты.
Dialogue: 0,0:22:53.64,0:22:56.81,Default,,0000,0000,0000,,Читта
Dialogue: 0,0:22:53.64,0:22:56.81,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:22:53.64,0:22:56.81,Default,,0000,0000,0000,,Жақсырақ маймыл шықты, солай емес пе?
Dialogue: 0,0:22:56.81,0:22:59.31,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:22:56.81,0:22:59.31,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:22:56.81,0:22:59.31,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:22:59.31,0:23:01.65,Default,,0000,0000,0000,,Куккук….
Dialogue: 0,0:23:01.65,0:23:05.98,Default,,0000,0000,0000,,Қанкей
Dialogue: 0,0:23:01.65,0:23:05.98,Default,,0000,0000,0000,,Хе. Бірақ, енді бұл маңызды емес.
Dialogue: 0,0:23:05.98,0:23:08.65,Default,,0000,0000,0000,,Ол тоқтайды ма? Дәл осы жерде!
Dialogue: 0,0:23:08.65,0:23:10.16,Default,,0000,0000,0000,,Айғақ
Dialogue: 0,0:23:08.65,0:23:10.16,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:23:10.16,0:23:11.82,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:23:11.82,0:23:13.33,Default,,0000,0000,0000,,Айғақ
Dialogue: 0,0:23:11.82,0:23:13.33,Default,,0000,0000,0000,,Кун
Dialogue: 0,0:23:11.82,0:23:13.33,Default,,0000,0000,0000,,Акаши-кун.
Dialogue: 0,0:23:13.33,0:23:15.16,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:23:13.33,0:23:15.16,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:23:15.16,0:23:16.83,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:23:15.16,0:23:16.83,Default,,0000,0000,0000,,Бұл сіз туралы. ➡
Dialogue: 0,0:23:16.83,0:23:21.33,Default,,0000,0000,0000,,Сенсей
Dialogue: 0,0:23:16.83,0:23:21.33,Default,,0000,0000,0000,,Кетчаку
Dialogue: 0,0:23:16.83,0:23:21.33,Default,,0000,0000,0000,,«Егер сен спортшы болсаң, бәрі баскетболда».
Dialogue: 0,0:23:16.83,0:23:21.33,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:23:16.83,0:23:21.33,Default,,0000,0000,0000,,Менің ойымша, сіз мұны айта аласыз ба?
Dialogue: 0,0:23:21.33,0:23:24.67,Default,,0000,0000,0000,,Теріс
Dialogue: 0,0:23:21.33,0:23:24.67,Default,,0000,0000,0000,,Иә, өтінемін.
Dialogue: 0,0:23:24.67,0:23:27.17,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:23:24.67,0:23:27.17,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:23:24.67,0:23:27.17,Default,,0000,0000,0000,,Осы жерде ұрыссақ та
Dialogue: 0,0:23:24.67,0:23:27.17,Default,,0000,0000,0000,,Муи Ми
Dialogue: 0,0:23:24.67,0:23:27.17,Default,,0000,0000,0000,,Бұл жай ғана мағынасыз.
Dialogue: 0,0:23:27.17,0:23:30.18,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:23:27.17,0:23:30.18,Default,,0000,0000,0000,,Куроко
Dialogue: 0,0:23:27.17,0:23:30.18,Default,,0000,0000,0000,,Театр
Dialogue: 0,0:23:27.17,0:23:30.18,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:23:27.17,0:23:30.18,Default,,0000,0000,0000,,Кеттік. Мен алдымен Курокоға қамқорлық жасауым керек.
Dialogue: 0,0:23:30.18,0:23:32.34,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:23:30.18,0:23:32.34,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:23:30.18,0:23:32.34,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:23:32.34,0:23:34.18,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:23:34.18,0:23:37.85,Default,,0000,0000,0000,,Ха ха ха...!
Dialogue: 0,0:23:34.18,0:23:37.85,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:23:34.18,0:23:37.85,Default,,0000,0000,0000,,Не? Бұл дұрыс!
Dialogue: 0,0:23:37.85,0:23:40.02,Default,,0000,0000,0000,,Жолыңнан кет
Dialogue: 0,0:23:37.85,0:23:40.02,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:23:37.85,0:23:40.02,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:23:37.85,0:23:40.02,Default,,0000,0000,0000,,Келіңіз, бос сөз айтыңыз➡
Dialogue: 0,0:23:40.02,0:23:42.69,Default,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:23:40.02,0:23:42.69,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:23:40.02,0:23:42.69,Default,,0000,0000,0000,,Сізді тепкілеп, үйге қайтқыңыз келе ме?
Dialogue: 0,0:23:42.69,0:23:44.86,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:23:42.69,0:23:44.86,Default,,0000,0000,0000,,Кошину
Dialogue: 0,0:23:42.69,0:23:44.86,Default,,0000,0000,0000,,Тек ақымақ емес, жалқау да.
Dialogue: 0,0:23:44.86,0:23:46.86,Default,,0000,0000,0000,,Сондықтан бұл маймыл!
Dialogue: 0,0:23:46.86,0:23:50.56,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:23:50.56,0:23:52.56,Default,,0000,0000,0000,,(Күміс)
Dialogue: 0,0:23:50.56,0:23:52.56,Default,,0000,0000,0000,,Мен ертең кішкентай боламын деп үміттенемін➡
Dialogue: 0,0:23:52.56,0:23:56.33,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:23:52.56,0:23:56.33,Default,,0000,0000,0000,,Көбінесе жөргекті ауыстыру
Dialogue: 0,0:23:52.56,0:23:56.33,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:23:52.56,0:23:56.33,Default,,0000,0000,0000,,Сіз көп нәрсе әкелесіз!
Dialogue: 0,0:24:07.51,0:24:10.08,Default,,0000,0000,0000,,өтіңіз.
Dialogue: 0,0:24:11.52,0:24:17.02,Default,,0000,0000,0000,,ашуланшақ
Dialogue: 0,0:24:11.52,0:24:17.02,Default,,0000,0000,0000,,Кансей
Dialogue: 0,0:24:11.52,0:24:17.02,Default,,0000,0000,0000,,(аудиторияның қолдауы)
Dialogue: 0,0:24:17.02,0:24:21.69,Default,,0000,0000,0000,,M.C.
Dialogue: 0,0:24:17.02,0:24:21.69,Default,,0000,0000,0000,,🔊(MC) Джеббервок
Dialogue: 0,0:24:17.02,0:24:21.69,Default,,0000,0000,0000,,Зендай Мимон
Dialogue: 0,0:24:17.02,0:24:21.69,Default,,0000,0000,0000,,Куцуджоку
Dialogue: 0,0:24:17.02,0:24:21.69,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:24:17.02,0:24:21.69,Default,,0000,0000,0000,,Бұрын-соңды болмаған қорлықтан бері бір апта! ➡
Dialogue: 0,0:24:21.69,0:24:26.70,Default,,0000,0000,0000,,Танджо
Dialogue: 0,0:24:21.69,0:24:26.70,Default,,0000,0000,0000,,Және дүниеге келді
Dialogue: 0,0:24:21.69,0:24:26.70,Default,,0000,0000,0000,,Кокосей
Dialogue: 0,0:24:21.69,0:24:26.70,Default,,0000,0000,0000,,Жоғары мектеп арманындағы команда! ➡
Dialogue: 0,0:24:26.70,0:24:30.04,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:24:26.70,0:24:30.04,Default,,0000,0000,0000,,Куни
Dialogue: 0,0:24:26.70,0:24:30.04,Default,,0000,0000,0000,,«Әйнек арқылы»
Dialogue: 0,0:24:26.70,0:24:30.04,Default,,0000,0000,0000,,Тоджо
Dialogue: 0,0:24:26.70,0:24:30.04,Default,,0000,0000,0000,,Кайбутсу
Dialogue: 0,0:24:26.70,0:24:30.04,Default,,0000,0000,0000,,Пайда болған құбыжықтар➡
Dialogue: 0,0:24:30.04,0:24:33.71,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:24:30.04,0:24:33.71,Default,,0000,0000,0000,,Джаббервокты жеңу
Dialogue: 0,0:24:30.04,0:24:33.71,Default,,0000,0000,0000,,Цуруги
Dialogue: 0,0:24:30.04,0:24:33.71,Default,,0000,0000,0000,,Флуктуация
Dialogue: 0,0:24:30.04,0:24:33.71,Default,,0000,0000,0000,,Қылыштан алынған➡
Dialogue: 0,0:24:33.71,0:24:39.54,Default,,0000,0000,0000,,На
Dialogue: 0,0:24:33.71,0:24:39.54,Default,,0000,0000,0000,,Оның аты «Ворпал қылыштар»!
Dialogue: 0,0:24:39.54,0:24:43.01,Default,,0000,0000,0000,,ашуланшақ
Dialogue: 0,0:24:39.54,0:24:43.01,Default,,0000,0000,0000,,Кансей
Dialogue: 0,0:24:39.54,0:24:43.01,Default,,0000,0000,0000,,(аудиторияның қолдауы)
Dialogue: 0,0:24:46.05,0:24:50.39,Default,,0000,0000,0000,,Кюу
Dialogue: 0,0:24:46.05,0:24:50.39,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:24:46.05,0:24:50.39,Default,,0000,0000,0000,,...
Dialogue: 0,0:24:46.05,0:24:50.39,Default,,0000,0000,0000,,Реванш күтпеген жерден шешілсе де.
Dialogue: 0,0:24:46.05,0:24:50.39,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:24:46.05,0:24:50.39,Default,,0000,0000,0000,,Жақсы толтырылған.
Dialogue: 0,0:24:50.39,0:24:53.23,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:24:50.39,0:24:53.23,Default,,0000,0000,0000,,Жапонияда
Dialogue: 0,0:24:50.39,0:24:53.23,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:24:50.39,0:24:53.23,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:24:50.39,0:24:53.23,Default,,0000,0000,0000,,Баскетбол ойнайтын барлық адамдар➡
Dialogue: 0,0:24:53.23,0:24:55.96,Default,,0000,0000,0000,,Мені мазақ еткендей болдым.
Dialogue: 0,0:24:53.23,0:24:55.96,Default,,0000,0000,0000,,Өйткені бұл бір нәрсе. ➡
Dialogue: 0,0:24:55.96,0:24:58.80,Default,,0000,0000,0000,,Зенкай
Dialogue: 0,0:24:55.96,0:24:58.80,Default,,0000,0000,0000,,Шиайчуукей
Dialogue: 0,0:24:55.96,0:24:58.80,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:24:55.96,0:24:58.80,Default,,0000,0000,0000,,Сол матчтың соңғы трансляциясын көріңіз➡
Dialogue: 0,0:24:58.80,0:25:02.97,Default,,0000,0000,0000,,Осы уақытқа дейін барлығы
Dialogue: 0,0:24:58.80,0:25:02.97,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:24:58.80,0:25:02.97,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:24:58.80,0:25:02.97,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:24:58.80,0:25:02.97,Default,,0000,0000,0000,,Менің ойымша, сіз оны көру үшін келдіңіз. ➡
Dialogue: 0,0:25:02.97,0:25:05.14,Default,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:25:02.97,0:25:05.14,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:25:02.97,0:25:05.14,Default,,0000,0000,0000,,Мен сенің жеңетініңе сенімдімін. ➡
Dialogue: 0,0:25:05.14,0:25:06.64,Default,,0000,0000,0000,,Барлығына!
Dialogue: 0,0:25:08.97,0:25:12.58,Default,,0000,0000,0000,,MC
Dialogue: 0,0:25:08.97,0:25:12.58,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:25:08.97,0:25:12.58,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
