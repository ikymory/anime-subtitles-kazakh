Dialogue: 0,1:22:02.08,1:22:04.09,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:22:02.08,1:22:04.09,Default,,0000,0000,0000,,Мен Америкаға баруды шештім.
Dialogue: 0,1:22:04.09,1:22:05.59,Default,,0000,0000,0000,,Фурихата
Dialogue: 0,1:22:04.09,1:22:05.59,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:22:05.59,1:22:07.42,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ….
Dialogue: 0,1:22:07.42,1:22:12.76,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:22:07.42,1:22:12.76,Default,,0000,0000,0000,,Не? бұрынғыдай қайтадан
Dialogue: 0,1:22:07.42,1:22:12.76,Default,,0000,0000,0000,,Шугё
Dialogue: 0,1:22:07.42,1:22:12.76,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:22:07.42,1:22:12.76,Default,,0000,0000,0000,,Жаттығуға барғандай емес пе?
Dialogue: 0,1:22:12.76,1:22:16.43,Default,,0000,0000,0000,,Түсіндіру
Dialogue: 0,1:22:12.76,1:22:16.43,Default,,0000,0000,0000,,Жоқ, Алекстің кіріспе сөзімен➡
Dialogue: 0,1:22:16.43,1:22:19.94,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,1:22:16.43,1:22:19.94,Default,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,1:22:16.43,1:22:19.94,Default,,0000,0000,0000,,Коуку
Dialogue: 0,1:22:16.43,1:22:19.94,Default,,0000,0000,0000,,Сондағы күшті орта мектептен
Dialogue: 0,1:22:16.43,1:22:19.94,Default,,0000,0000,0000,,Чика
Dialogue: 0,1:22:16.43,1:22:19.94,Default,,0000,0000,0000,,Мені шақырды.
Dialogue: 0,1:22:19.94,1:22:24.24,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,1:22:19.94,1:22:24.24,Default,,0000,0000,0000,,Мен сонда ойнадым
Dialogue: 0,1:22:19.94,1:22:24.24,Default,,0000,0000,0000,,NV
Dialogue: 0,1:22:19.94,1:22:24.24,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,1:22:19.94,1:22:24.24,Default,,0000,0000,0000,,Мен НБА-ға ұмтылғым келеді!
Dialogue: 0,1:22:27.61,1:22:29.44,Default,,0000,0000,0000,,Босдық
Dialogue: 0,1:22:27.61,1:22:29.44,Default,,0000,0000,0000,,Бұл өтірік емес пе? Кагами.
Dialogue: 0,1:22:29.44,1:22:31.61,Default,,0000,0000,0000,,Кюу
Dialogue: 0,1:22:29.44,1:22:31.61,Default,,0000,0000,0000,,Кенеттен...
Dialogue: 0,1:22:31.61,1:22:34.02,Default,,0000,0000,0000,,Кавахара
Dialogue: 0,1:22:31.61,1:22:34.02,Default,,0000,0000,0000,,Куроко
Dialogue: 0,1:22:31.61,1:22:34.02,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,1:22:31.61,1:22:34.02,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:22:31.61,1:22:34.02,Default,,0000,0000,0000,,Куроко, бірдеңе айт!
Dialogue: 0,1:22:35.28,1:22:37.95,Default,,0000,0000,0000,,Фурихата
Dialogue: 0,1:22:35.28,1:22:37.95,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,1:22:35.28,1:22:37.95,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,1:22:37.95,1:22:39.45,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:22:39.45,1:22:41.79,Default,,0000,0000,0000,,Алекстен
Dialogue: 0,1:22:39.45,1:22:41.79,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,1:22:39.45,1:22:41.79,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,1:22:39.45,1:22:41.79,Default,,0000,0000,0000,,Жаңалық алған кезде➡
Dialogue: 0,1:22:41.79,1:22:43.29,Default,,0000,0000,0000,,Кенже
Dialogue: 0,1:22:41.79,1:22:43.29,Default,,0000,0000,0000,,Өйткені біз бірге болдық.
Dialogue: 0,1:22:43.29,1:22:47.30,Default,,0000,0000,0000,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,1:22:43.29,1:22:47.30,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:22:43.29,1:22:47.30,Default,,0000,0000,0000,,Сізге бұл жақсы ма?
Dialogue: 0,1:22:49.30,1:22:52.63,Default,,0000,0000,0000,,Кагами-кун
Dialogue: 0,1:22:49.30,1:22:52.63,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,1:22:49.30,1:22:52.63,Default,,0000,0000,0000,,Иә. Кагами-кун қаласа➡
Dialogue: 0,1:22:52.63,1:22:56.30,Default,,0000,0000,0000,,Сонымен, сен сол аралда не істеп жүрдің?
Dialogue: 0,1:22:52.63,1:22:56.30,Default,,0000,0000,0000,,Зенрёку
Dialogue: 0,1:22:52.63,1:22:56.30,Default,,0000,0000,0000,,Оуен
Dialogue: 0,1:22:52.63,1:22:56.30,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,1:22:52.63,1:22:56.30,Default,,0000,0000,0000,,Біз оларға бар күш-жігерімізбен қолдау көрсетуіміз керек деп ойлаймын.
Dialogue: 0,1:22:56.30,1:22:59.14,Default,,0000,0000,0000,,Куроко
Dialogue: 0,1:22:56.30,1:22:59.14,Default,,0000,0000,0000,,Куроко….
Dialogue: 0,1:22:59.14,1:23:00.81,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,1:22:59.14,1:23:00.81,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:23:00.81,1:23:04.15,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,1:23:00.81,1:23:04.15,Default,,0000,0000,0000,,Арман
Dialogue: 0,1:23:00.81,1:23:04.15,Default,,0000,0000,0000,,Суару
Dialogue: 0,1:23:00.81,1:23:04.15,Default,,0000,0000,0000,,Өз армандарыңыз туралы және басқалар туралы ойланыңыз➡
Dialogue: 0,1:23:04.15,1:23:06.31,Default,,0000,0000,0000,,Таң
Dialogue: 0,1:23:04.15,1:23:06.31,Default,,0000,0000,0000,,Суару
Dialogue: 0,1:23:04.15,1:23:06.31,Default,,0000,0000,0000,,Таңға дейін ойланып...➡
Dialogue: 0,1:23:06.31,1:23:10.02,Default,,0000,0000,0000,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,1:23:06.31,1:23:10.02,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,1:23:06.31,1:23:10.02,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:23:06.31,1:23:10.02,Default,,0000,0000,0000,,Мен Америкаға барғым келеді!
Dialogue: 0,1:23:11.49,1:23:14.32,Default,,0000,0000,0000,,күрсіну. ...Бұл соншалықты ақымақтық.
Dialogue: 0,1:23:14.32,1:23:17.16,Default,,0000,0000,0000,,Шитаму
Dialogue: 0,1:23:14.32,1:23:17.16,Default,,0000,0000,0000,,Ими
Dialogue: 0,1:23:14.32,1:23:17.16,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,1:23:14.32,1:23:17.16,Default,,0000,0000,0000,,Төмен қарау дегенді түсінбеймін!
Dialogue: 0,1:23:17.16,1:23:21.66,Default,,0000,0000,0000,,Кенже
Dialogue: 0,1:23:17.16,1:23:21.66,Default,,0000,0000,0000,,Біз сенбіз
Dialogue: 0,1:23:17.16,1:23:21.66,Default,,0000,0000,0000,,Оуен
Dialogue: 0,1:23:17.16,1:23:21.66,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,1:23:17.16,1:23:21.66,Default,,0000,0000,0000,,Біз сізді қолдамаймыз деп ойлайсыз ба?
Dialogue: 0,1:23:21.66,1:23:25.00,Default,,0000,0000,0000,,Ная
Dialogue: 0,1:23:21.66,1:23:25.00,Default,,0000,0000,0000,,Мен үшін қатты уайымдағаныңыз үшін.
Dialogue: 0,1:23:21.66,1:23:25.00,Default,,0000,0000,0000,,Жеткілікті
Dialogue: 0,1:23:21.66,1:23:25.00,Default,,0000,0000,0000,,Жетеді.
Dialogue: 0,1:23:25.00,1:23:27.20,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,1:23:25.00,1:23:27.20,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:23:25.00,1:23:27.20,Default,,0000,0000,0000,,...
Dialogue: 0,1:23:25.00,1:23:27.20,Default,,0000,0000,0000,,Өзіңізді сынаңыз!
Dialogue: 0,1:23:27.20,1:23:31.54,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,1:23:27.20,1:23:31.54,Default,,0000,0000,0000,,Оуен
Dialogue: 0,1:23:27.20,1:23:31.54,Default,,0000,0000,0000,,Біз де сізді қолдаймыз.
Dialogue: 0,1:23:27.20,1:23:31.54,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:23:27.20,1:23:31.54,Default,,0000,0000,0000,,Босдық
Dialogue: 0,1:23:27.20,1:23:31.54,Default,,0000,0000,0000,,Кел, Кагами.
Dialogue: 0,1:23:31.54,1:23:33.01,Default,,0000,0000,0000,,Барлығы….
Dialogue: 0,1:23:34.31,1:23:37.08,Default,,0000,0000,0000,,Кисе
Dialogue: 0,1:23:34.31,1:23:37.08,Default,,0000,0000,0000,,Осыны айтқыңыз келді ме?
Dialogue: 0,1:23:38.15,1:23:39.65,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,1:23:38.15,1:23:39.65,Default,,0000,0000,0000,,Балалар!
Dialogue: 0,1:23:39.65,1:23:43.32,Default,,0000,0000,0000,,Қалай
Dialogue: 0,1:23:39.65,1:23:43.32,Default,,0000,0000,0000,,Ақылға қонымды
Dialogue: 0,1:23:39.65,1:23:43.32,Default,,0000,0000,0000,,Шарт
Dialogue: 0,1:23:39.65,1:23:43.32,Default,,0000,0000,0000,,Тауық
Dialogue: 0,1:23:39.65,1:23:43.32,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,1:23:39.65,1:23:43.32,Default,,0000,0000,0000,,Мен бірдеңе дұрыс емес деп ойладым.
Dialogue: 0,1:23:43.32,1:23:47.16,Default,,0000,0000,0000,,Босдық
Dialogue: 0,1:23:43.32,1:23:47.16,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:23:43.32,1:23:47.16,Default,,0000,0000,0000,,Я~ Кагами, сен Америкаға барасың ба~?
Dialogue: 0,1:23:47.16,1:23:49.82,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,1:23:47.16,1:23:49.82,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:23:47.16,1:23:49.82,Default,,0000,0000,0000,,Неліктен бұл сенсің?
Dialogue: 0,1:23:49.82,1:23:51.49,Default,,0000,0000,0000,,Джицурёкутеки
Dialogue: 0,1:23:49.82,1:23:51.49,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,1:23:49.82,1:23:51.49,Default,,0000,0000,0000,,Қабілеті жағынан мен шығармын!
Dialogue: 0,1:23:51.49,1:23:55.66,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,1:23:51.49,1:23:55.66,Default,,0000,0000,0000,,Бір минут күтіңіз. Қашаннан бері
Dialogue: 0,1:23:51.49,1:23:55.66,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:23:51.49,1:23:55.66,Default,,0000,0000,0000,,Көпшілігі
Dialogue: 0,1:23:51.49,1:23:55.66,Default,,0000,0000,0000,,Сіз үздік болдыңыз.
Dialogue: 0,1:23:55.66,1:24:00.50,Default,,0000,0000,0000,,Хехе. Жақсы, әркім әртүрлі нәрсе
Dialogue: 0,1:23:55.66,1:24:00.50,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,1:23:55.66,1:24:00.50,Default,,0000,0000,0000,,Ойларыңыз бар екеніне сенімдімін➡
Dialogue: 0,1:24:00.50,1:24:02.84,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,1:24:00.50,1:24:02.84,Default,,0000,0000,0000,,Оуен
Dialogue: 0,1:24:00.50,1:24:02.84,Default,,0000,0000,0000,,Біз де сізге көмектесеміз. ➡
Dialogue: 0,1:24:02.84,1:24:06.01,Default,,0000,0000,0000,,Ганба
Dialogue: 0,1:24:02.84,1:24:06.01,Default,,0000,0000,0000,,Босдық
Dialogue: 0,1:24:02.84,1:24:06.01,Default,,0000,0000,0000,,Қолыңнан келгеннің бәрін істе, Кагами. ➡
Dialogue: 0,1:24:06.01,1:24:08.84,Default,,0000,0000,0000,,Суко
Dialogue: 0,1:24:06.01,1:24:08.84,Default,,0000,0000,0000,,Бұл да аздап жалғыздық. ➡
Dialogue: 0,1:24:08.84,1:24:11.18,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:24:08.84,1:24:11.18,Default,,0000,0000,0000,,Кьютеки
Dialogue: 0,1:24:08.84,1:24:11.18,Default,,0000,0000,0000,,Бар болғаны, сен айбатты жаусың➡
Dialogue: 0,1:24:11.18,1:24:14.15,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:24:11.18,1:24:14.15,Default,,0000,0000,0000,,Достық
Dialogue: 0,1:24:11.18,1:24:14.15,Default,,0000,0000,0000,,Сізбен матч
Dialogue: 0,1:24:11.18,1:24:14.15,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,1:24:11.18,1:24:14.15,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,1:24:11.18,1:24:14.15,Default,,0000,0000,0000,,Бука
Dialogue: 0,1:24:11.18,1:24:14.15,Default,,0000,0000,0000,,Бұл есте қалды.
Dialogue: 0,1:24:15.35,1:24:18.52,Default,,0000,0000,0000,,...
Dialogue: 0,1:24:15.35,1:24:18.52,Default,,0000,0000,0000,,Мен оны асыға күтемін
Dialogue: 0,1:24:15.35,1:24:18.52,Default,,0000,0000,0000,,Мен сені кездестіргеніме қуаныштымын, Тайга Кагами. ➡
Dialogue: 0,1:24:18.52,1:24:22.19,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:24:18.52,1:24:22.19,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,1:24:18.52,1:24:22.19,Default,,0000,0000,0000,,Сіз біз үшінсіз
Dialogue: 0,1:24:18.52,1:24:22.19,Default,,0000,0000,0000,,Сайкоу
Dialogue: 0,1:24:18.52,1:24:22.19,Default,,0000,0000,0000,,Менің ең жақсы қарсыласым➡
Dialogue: 0,1:24:22.19,1:24:24.16,Default,,0000,0000,0000,,Сайкоу
Dialogue: 0,1:24:22.19,1:24:24.16,Default,,0000,0000,0000,,Қалай болғанда да, біз тез арада ауруханаға жетуіміз керек…
Dialogue: 0,1:24:22.19,1:24:24.16,Default,,0000,0000,0000,,Ол менің ең жақын досым.
Dialogue: 0,1:24:27.50,1:24:29.50,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:24:27.50,1:24:29.50,Default,,0000,0000,0000,,Балалар.
Dialogue: 0,1:24:32.17,1:24:36.10,Default,,0000,0000,0000,,Айғақ
Dialogue: 0,1:24:32.17,1:24:36.10,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,1:24:32.17,1:24:36.10,Default,,0000,0000,0000,,...
Dialogue: 0,1:24:32.17,1:24:36.10,Default,,0000,0000,0000,,Бізбен қоштасу ретінде
Dialogue: 0,1:24:32.17,1:24:36.10,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,1:24:32.17,1:24:36.10,Default,,0000,0000,0000,,Тянь
