Dialogue: 0,0:41:20.11,0:41:23.28,Default,,0000,0000,0000,,О.
Dialogue: 0,0:41:20.11,0:41:23.28,Default,,0000,0000,0000,,Бітті. ➡
Dialogue: 0,0:41:23.28,0:41:26.78,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:41:23.28,0:41:26.78,Default,,0000,0000,0000,,Күмісті тоқтатуға тырыссаңыз
Dialogue: 0,0:41:23.28,0:41:26.78,Default,,0000,0000,0000,,және т.б.
Dialogue: 0,0:41:23.28,0:41:26.78,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:41:23.28,0:41:26.78,Default,,0000,0000,0000,,Басқаларды тоқтату мүмкін емес. ➡
Dialogue: 0,0:41:26.78,0:41:30.79,Default,,0000,0000,0000,,және т.б.
Dialogue: 0,0:41:26.78,0:41:30.79,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:41:26.78,0:41:30.79,Default,,0000,0000,0000,,Егер сіз басқаларды тоқтатуға тырыссаңыз
Dialogue: 0,0:41:26.78,0:41:30.79,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:41:26.78,0:41:30.79,Default,,0000,0000,0000,,Күмісті тоқтату мүмкін емес.
Dialogue: 0,0:41:30.79,0:41:35.79,Default,,0000,0000,0000,,«және күн сайын күрсінемін.»
Dialogue: 0,0:41:30.79,0:41:35.79,Default,,0000,0000,0000,,Кихонтеки
Dialogue: 0,0:41:30.79,0:41:35.79,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:41:30.79,0:41:35.79,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:41:30.79,0:41:35.79,Default,,0000,0000,0000,,Мәселе мынада, олар негізінен дәрежелері бойынша ерекшеленеді.
Dialogue: 0,0:41:35.79,0:41:41.60,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,0:41:35.79,0:41:41.60,Default,,0000,0000,0000,,Бұдан былай тісімді шықырлатып,
Dialogue: 0,0:41:35.79,0:41:41.60,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:41:35.79,0:41:41.60,Default,,0000,0000,0000,,...
Dialogue: 0,0:41:35.79,0:41:41.60,Default,,0000,0000,0000,,Зецубу
Dialogue: 0,0:41:35.79,0:41:41.60,Default,,0000,0000,0000,,Көңіліңізден түңіліңіз!
Dialogue: 0,0:41:43.63,0:41:45.14,Default,,0000,0000,0000,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:41:46.80,0:41:49.51,Default,,0000,0000,0000,,Қант қызылшасы
Dialogue: 0,0:41:46.80,0:41:49.51,Default,,0000,0000,0000,,Ikki
Dialogue: 0,0:41:46.80,0:41:49.51,Default,,0000,0000,0000,,Хира
Dialogue: 0,0:41:46.80,0:41:49.51,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:41:46.80,0:41:49.51,Default,,0000,0000,0000,,Нүктелік айырмашылық кенет кеңейе бастады.
Dialogue: 0,0:41:53.64,0:41:58.45,Default,,0000,0000,0000,,Коганей
Dialogue: 0,0:41:53.64,0:41:58.45,Default,,0000,0000,0000,,Міндетті түрде.
Dialogue: 0,0:41:53.64,0:41:58.45,Default,,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:41:53.64,0:41:58.45,Default,,0000,0000,0000,,Седай
Dialogue: 0,0:41:53.64,0:41:58.45,Default,,0000,0000,0000,,Қуат
Dialogue: 0,0:41:53.64,0:41:58.45,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:41:53.64,0:41:58.45,Default,,0000,0000,0000,,«Ғажайып ұрпақтың» күшін біріктірсек те.
Dialogue: 0,0:41:58.45,0:41:59.95,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:41:58.45,0:41:59.95,Default,,0000,0000,0000,,Біз жеңе алмаймыз ба?
Dialogue: 0,0:41:59.95,0:42:03.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:42:03.12,0:42:05.29,Default,,0000,0000,0000,,Фурихата
Dialogue: 0,0:42:03.12,0:42:05.29,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:42:03.12,0:42:05.29,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:42:03.12,0:42:05.29,Default,,0000,0000,0000,,Өтінемін... тоқтатыңыз. ➡
Dialogue: 0,0:42:05.29,0:42:09.06,Default,,0000,0000,0000,,Хира
Dialogue: 0,0:42:05.29,0:42:09.06,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:42:05.29,0:42:09.06,Default,,0000,0000,0000,,Қант қызылшасы
Dialogue: 0,0:42:05.29,0:42:09.06,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:42:05.29,0:42:09.06,Default,,0000,0000,0000,,Бұл барған сайын кеңейетін айырмашылық ... біреу!
Dialogue: 0,0:42:11.46,0:42:13.80,Default,,0000,0000,0000,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:42:11.46,0:42:13.80,Default,,0000,0000,0000,,
Dialogue: 0,0:42:13.80,0:42:15.63,Default,,0000,0000,0000,,Шинпан
Dialogue: 0,0:42:13.80,0:42:15.63,Default,,0000,0000,0000,,(Үкім)
Dialogue: 0,0:42:13.80,0:42:15.63,Default,,0000,0000,0000,,Широ
Dialogue: 0,0:42:13.80,0:42:15.63,Default,,0000,0000,0000,,Ақ! Мүше ауыстыру.
Dialogue: 0,0:42:15.63,0:42:21.14,Default,,0000,0000,0000,,ашуланшақ
Dialogue: 0,0:42:15.63,0:42:21.14,Default,,0000,0000,0000,,Сейен
Dialogue: 0,0:42:15.63,0:42:21.14,Default,,0000,0000,0000,,(аудиторияны қолдау)
Dialogue: 0,0:42:21.14,0:42:23.14,Default,,0000,0000,0000,,Соңында мүше өзгерді➡
Dialogue: 0,0:42:23.14,0:42:25.64,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:42:23.14,0:42:25.64,Default,,0000,0000,0000,,Уақытымыз аз болса да.
Dialogue: 0,0:42:23.14,0:42:25.64,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:42:23.14,0:42:25.64,Default,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:42:23.14,0:42:25.64,Default,,0000,0000,0000,,Сіз жасай алатын бірдеңе болды ма?
Dialogue: 0,0:42:25.64,0:42:27.31,Default,,0000,0000,0000,,Дұрыс! ➡
Dialogue: 0,0:42:27.31,0:42:31.48,Default,,0000,0000,0000,,Айғақ
Dialogue: 0,0:42:27.31,0:42:31.48,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:42:27.31,0:42:31.48,Default,,0000,0000,0000,,Игай
Dialogue: 0,0:42:27.31,0:42:31.48,Default,,0000,0000,0000,,Акашидің пасы басқаларды да аймаққа шығарады
Dialogue: 0,0:42:27.31,0:42:31.48,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:42:27.31,0:42:31.48,Default,,0000,0000,0000,,Сіз оны енгізуіңіз керек. ➡
Dialogue: 0,0:42:31.48,0:42:34.65,Default,,0000,0000,0000,,Сол жігіттер
Dialogue: 0,0:42:31.48,0:42:34.65,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:42:31.48,0:42:34.65,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:42:31.48,0:42:34.65,Default,,0000,0000,0000,,Егер барлығы аймаққа кірсе...
Dialogue: 0,0:42:34.65,0:42:36.65,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:42:36.65,0:42:40.49,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:42:36.65,0:42:40.49,Default,,0000,0000,0000,,Тіпті қазір мұны істесеңіз де
Dialogue: 0,0:42:36.65,0:42:40.49,Default,,0000,0000,0000,,Қорытынды
Dialogue: 0,0:42:36.65,0:42:40.49,Default,,0000,0000,0000,,Соңына дейін күтпеңіз.
Dialogue: 0,0:42:40.49,0:42:43.16,Default,,0000,0000,0000,,Хюга
Dialogue: 0,0:42:40.49,0:42:43.16,Default,,0000,0000,0000,,(Хината)
Dialogue: 0,0:42:40.49,0:42:43.16,Default,,0000,0000,0000,,《Онда не істесең де...》
Dialogue: 0,0:42:43.16,0:42:45.50,Default,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:42:43.16,0:42:45.50,Default,,0000,0000,0000,,Жоқ, менің қолым бар. ➡
Dialogue: 0,0:42:45.50,0:42:49.50,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:42:45.50,0:42:49.50,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:42:45.50,0:42:49.50,Default,,0000,0000,0000,,Бәрің де
Dialogue: 0,0:42:45.50,0:42:49.50,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:42:45.50,0:42:49.50,Default,,0000,0000,0000,,Аймаққа орналастыру мүмкін емес. ➡
Dialogue: 0,0:42:49.50,0:42:52.00,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:42:49.50,0:42:52.00,Default,,0000,0000,0000,,Бірақ айырмашылық
Dialogue: 0,0:42:49.50,0:42:52.00,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:42:49.50,0:42:52.00,Default,,0000,0000,0000,,Хиро
Dialogue: 0,0:42:49.50,0:42:52.00,Default,,0000,0000,0000,,Оның әрі қарай таралуын болдырмау үшін➡
Dialogue: 0,0:42:52.00,0:42:55.84,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:42:52.00,0:42:55.84,Default,,0000,0000,0000,,Олардың шабуылы
Dialogue: 0,0:42:52.00,0:42:55.84,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:42:52.00,0:42:55.84,Default,,0000,0000,0000,,Тоқтату керек. ➡
Dialogue: 0,0:42:55.84,0:42:58.01,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:42:55.84,0:42:58.01,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:42:55.84,0:42:58.01,Default,,0000,0000,0000,,Алдымен мен Нэшті аламын. ➡
Dialogue: 0,0:42:58.01,0:42:59.84,Default,,0000,0000,0000,,Және күміс...
Dialogue: 0,0:42:59.84,0:43:02.18,Default,,0000,0000,0000,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:42:59.84,0:43:02.18,Default,,0000,0000,0000,,
Dialogue: 0,0:43:02.18,0:43:03.68,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:43:03.68,0:43:08.02,Default,,0000,0000,0000,,Цучида
Dialogue: 0,0:43:03.68,0:43:08.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:43:03.68,0:43:08.02,Default,,0000,0000,0000,,Коганей
Dialogue: 0,0:43:03.68,0:43:08.02,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:43:03.68,0:43:08.02,Default,,0000,0000,0000,,Бұл туралы бірдеңе...
Dialogue: 0,0:43:08.02,0:43:11.82,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:43:08.02,0:43:11.82,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:43:08.02,0:43:11.82,Default,,0000,0000,0000,,Жоқ, сізбен бірге
Dialogue: 0,0:43:08.02,0:43:11.82,Default,,0000,0000,0000,,О-
Dialogue: 0,0:43:08.02,0:43:11.82,Default,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:43:08.02,0:43:11.82,Default,,0000,0000,0000,,Команданы қосатын күн келеді деп ойламаппын.
Dialogue: 0,0:43:11.82,0:43:16.33,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:43:11.82,0:43:16.33,Default,,0000,0000,0000,,Джинсей
Dialogue: 0,0:43:11.82,0:43:16.33,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:43:11.82,0:43:16.33,Default,,0000,0000,0000,,О.
Dialogue: 0,0:43:11.82,0:43:16.33,Default,,0000,0000,0000,,Ал, өмірде не болады?
Dialogue: 0,0:43:11.82,0:43:16.33,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:43:11.82,0:43:16.33,Default,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:43:16.33,0:43:19.53,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:43:16.33,0:43:19.53,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:43:16.33,0:43:19.53,Default,,0000,0000,0000,,О-
Dialogue: 0,0:43:16.33,0:43:19.53,Default,,0000,0000,0000,,Па
Dialogue: 0,0:43:16.33,0:43:19.53,Default,,0000,0000,0000,,Аяғыңызды сүйретпеңіз.
Dialogue: 0,0:43:16.33,0:43:19.53,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:43:16.33,0:43:19.53,Default,,0000,0000,0000,,Айоссу!
Dialogue: 0,0:43:24.03,0:43:26.70,Default,,0000,0000,0000,,Оқу ақпараты
Dialogue: 0,0:43:24.03,0:43:26.70,Default,,0000,0000,0000,,Бұл аймақты мәжбүрлеп босату болды!
Dialogue: 0,0:43:26.70,0:43:28.54,Default,,0000,0000,0000,,Керемет көшірме
Dialogue: 0,0:43:26.70,0:43:28.54,Default,,0000,0000,0000,,«Мінсіз еліктеу»!
Dialogue: 0,0:43:28.54,0:43:31.71,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:43:28.54,0:43:31.71,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:43:28.54,0:43:31.71,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:43:28.54,0:43:31.71,Default,,0000,0000,0000,,Неге, сіз өзіңізді ұтқандай сезінесіз!
Dialogue: 0,0:43:28.54,0:43:31.71,Default,,0000,0000,0000,,Ноукин
Dialogue: 0,0:43:28.54,0:43:31.71,Default,,0000,0000,0000,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:43:28.54,0:43:31.71,Default,,0000,0000,0000,,Ми бұлшық еті.
Dialogue: 0,0:43:31.71,0:43:33.21,Default,,0000,0000,0000,,Бұл осы жерден! ➡
Dialogue: 0,0:43:33.21,0:43:34.71,Default,,0000,0000,0000,,Хонбан
Dialogue: 0,0:43:33.21,0:43:34.71,Default,,0000,0000,0000,,Нақты нәрсе осында!
Dialogue: 0,0:43:34.71,0:43:36.21,Default,,0000,0000,0000,,Га.
Dialogue: 0,0:43:36.21,0:43:38.22,Default,,0000,0000,0000,,Бұл үлкен қысым!
Dialogue: 0,0:43:38.22,0:43:46.72,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:43:46.72,0:43:49.56,Default,,0000,0000,0000,,Матсуда мырза өледі.
Dialogue: 0,0:43:46.72,0:43:49.56,Default,,0000,0000,0000,,Жер бетінде не болды?
Dialogue: 0,0:43:46.72,0:43:49.56,Default,,0000,0000,0000,,Мына жігіттер! ➡
Dialogue: 0,0:43:49.56,0:43:52.06,Default,,0000,0000,0000,,Бұрын не болды?
Dialogue: 0,0:43:49.56,0:43:52.06,Default,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:43:49.56,0:43:52.06,Default,,0000,0000,0000,,Чиге
Dialogue: 0,0:43:49.56,0:43:52.06,Default,,0000,0000,0000,,Қозғалыс мүлдем басқа!
Dialogue: 0,0:43:52.06,0:43:54.30,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:43:52.06,0:43:54.30,Default,,0000,0000,0000,,Коганей
Dialogue: 0,0:43:52.06,0:43:54.30,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:43:54.30,0:43:57.47,Default,,0000,0000,0000,,Сайкё
Dialogue: 0,0:43:54.30,0:43:57.47,Default,,0000,0000,0000,,Ең күшті тегтер командасы
Dialogue: 0,0:43:54.30,0:43:57.47,Default,,0000,0000,0000,,Көбелек
Dialogue: 0,0:43:54.30,0:43:57.47,Default,,0000,0000,0000,,Өте қауіпті қос команда. ➡
Dialogue: 0,0:43:57.47,0:44:00.80,Default,,0000,0000,0000,,Топпа
Dialogue: 0,0:43:57.47,0:44:00.80,Default,,0000,0000,0000,,Серпілісті былай қойғанда, тіпті допты ұстау
Dialogue: 0,0:43:57.47,0:44:00.80,Default,,0000,0000,0000,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:44:00.80,0:44:04.51,Default,,0000,0000,0000,,(Годжо) Бұл қызықтай бастады.
Dialogue: 0,0:44:00.80,0:44:04.51,Default,,0000,0000,0000,,Қатты тітіркендірдіңдер, бейбақтар!
Dialogue: 0,0:44:05.64,0:44:07.81,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:44:07.81,0:44:09.31,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:44:07.81,0:44:09.31,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:44:09.31,0:44:10.81,Default,,0000,0000,0000,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:44:10.81,0:44:14.82,Default,,0000,0000,0000,,Вакамацу
Dialogue: 0,0:44:10.81,0:44:14.82,Default,,0000,0000,0000,,(Вакамацу)
Dialogue: 0,0:44:10.81,0:44:14.82,Default,,0000,0000,0000,,Аққан
Dialogue: 0,0:44:10.81,0:44:14.82,Default,,0000,0000,0000,,《Ғажайып. Бұл шынымен керемет!
Dialogue: 0,0:44:10.81,0:44:14.82,Default,,0000,0000,0000,,Керемет көшірме
Dialogue: 0,0:44:10.81,0:44:14.82,Default,,0000,0000,0000,,«Мінсіз еліктеу». ➡
Dialogue: 0,0:44:14.82,0:44:18.32,Default,,0000,0000,0000,,Ишун
Dialogue: 0,0:44:14.82,0:44:18.32,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:44:14.82,0:44:18.32,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,0:44:14.82,0:44:18.32,Default,,0000,0000,0000,,Бір сәт мен екі Аомин бар деп ойладым.
Dialogue: 0,0:44:14.82,0:44:18.32,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:44:14.82,0:44:18.32,Default,,0000,0000,0000,,Мен солай ойладым! 》
Dialogue: 0,0:44:18.32,0:44:23.33,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:44:18.32,0:44:23.33,Default,,0000,0000,0000,,《…көп. Ал не!
Dialogue: 0,0:44:18.32,0:44:23.33,Default,,0000,0000,0000,,Екі
Dialogue: 0,0:44:18.32,0:44:23.33,Default,,0000,0000,0000,,Сіздің тынысыңыз тамаша! 》
Dialogue: 0,0:44:28.17,0:44:29.67,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:44:30.67,0:44:34.84,Default,,0000,0000,0000,,Айғақ
Dialogue: 0,0:44:30.67,0:44:34.84,Default,,0000,0000,0000,,Кун
Dialogue: 0,0:44:30.67,0:44:34.84,Default,,0000,0000,0000,,《Акаши-кун бұл
Dialogue: 0,0:44:30.67,0:44:34.84,Default,,0000,0000,0000,,...
Dialogue: 0,0:44:30.67,0:44:34.84,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:44:30.67,0:44:34.84,Default,,0000,0000,0000,,Соңғы жол жабылды! ? 》
Dialogue: 0,0:44:34.84,0:44:36.34,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:44:40.51,0:44:43.35,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:44:40.51,0:44:43.35,Default,,0000,0000,0000,,ашуланшақ
Dialogue: 0,0:44:40.51,0:44:43.35,Default,,0000,0000,0000,,Кансей
Dialogue: 0,0:44:40.51,0:44:43.35,Default,,0000,0000,0000,,(аудиторияның қолдауы)
Dialogue: 0,0:44:43.35,0:44:45.05,Default,,0000,0000,0000,,Хаякава
Dialogue: 0,0:44:43.35,0:44:45.05,Default,,0000,0000,0000,,Аяқ сынуы!
Dialogue: 0,0:44:48.85,0:44:50.52,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:44:48.85,0:44:50.52,Default,,0000,0000,0000,,Аомина-сан! Ах...
Dialogue: 0,0:44:50.52,0:44:52.12,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:44:53.19,0:44:54.69,Default,,0000,0000,0000,,«Құрғап қалған болар ма?»
Dialogue: 0,0:44:55.99,0:44:57.66,Default,,0000,0000,0000,,Хамф!
Dialogue: 0,0:44:57.66,0:44:59.50,Default,,0000,0000,0000,,
Dialogue: 0,0:44:59.50,0:45:01.17,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:45:01.17,0:45:03.50,Default,,0000,0000,0000,,Бұл жылдамдық. Ол пішін...
Dialogue: 0,0:45:03.50,0:45:06.00,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:45:03.50,0:45:06.00,Default,,0000,0000,0000,,Қандай цирк түсірілімі!
Dialogue: 0,0:45:06.00,0:45:08.64,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:45:06.00,0:45:08.64,Default,,0000,0000,0000,,Дай-чан. Ки-чан.
Dialogue: 0,0:45:08.64,0:45:11.18,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:45:08.64,0:45:11.18,Default,,0000,0000,0000,,Осе
Dialogue: 0,0:45:08.64,0:45:11.18,Default,,0000,0000,0000,,Өту уақытын кешіктіріңіз. ➡
Dialogue: 0,0:45:11.18,0:45:14.18,Default,,0000,0000,0000,,Ippo
Dialogue: 0,0:45:11.18,0:45:14.18,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:45:11.18,0:45:14.18,Default,,0000,0000,0000,,Тағы бір қадам, асығыңыз!
Dialogue: 0,0:45:11.18,0:45:14.18,Default,,0000,0000,0000,,Оңай
Dialogue: 0,0:45:11.18,0:45:14.18,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:45:11.18,0:45:14.18,Default,,0000,0000,0000,,Бұл оңайырақ болуы мүмкін еді!
Dialogue: 0,0:45:14.18,0:45:17.18,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:45:14.18,0:45:17.18,Default,,0000,0000,0000,,<Иә? Тағы?
Dialogue: 0,0:45:14.18,0:45:17.18,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:45:14.18,0:45:17.18,Default,,0000,0000,0000,,Сіз оны ала аласыз ба? ＞
Dialogue: 0,0:45:17.18,0:45:19.35,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:45:17.18,0:45:19.35,Default,,0000,0000,0000,,(Аомин)
Dialogue: 0,0:45:17.18,0:45:19.35,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:45:17.18,0:45:19.35,Default,,0000,0000,0000,,＜...Біраз уақыт бұрын болған шығар, бірақ ақымақтық! ＞
Dialogue: 0,0:45:19.35,0:45:24.32,Default,,0000,0000,0000,,Момой
Dialogue: 0,0:45:19.35,0:45:24.32,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:45:19.35,0:45:24.32,Default,,0000,0000,0000,,《Тағы не?
Dialogue: 0,0:45:19.35,0:45:24.32,Default,,0000,0000,0000,,Басымдық
Dialogue: 0,0:45:19.35,0:45:24.32,Default,,0000,0000,0000,,Намида
Dialogue: 0,0:45:19.35,0:45:24.32,Default,,0000,0000,0000,,Соңғы кездері қатты жыладым...》
Dialogue: 0,0:45:26.36,0:45:30.19,Default,,0000,0000,0000,,Ганба
Dialogue: 0,0:45:26.36,0:45:30.19,Default,,0000,0000,0000,,Аомин-кун
Dialogue: 0,0:45:26.36,0:45:30.19,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:45:26.36,0:45:30.19,Default,,0000,0000,0000,,Кун
Dialogue: 0,0:45:26.36,0:45:30.19,Default,,0000,0000,0000,,Сәттілік! Амина-кун! Кисе-кун!
Dialogue: 0,0:45:30.19,0:45:31.66,Default,,0000,0000,0000,,Қап!
Dialogue: 0,0:45:33.86,0:45:38.87,Default,,0000,0000,0000,,Таши
Dialogue: 0,0:45:33.86,0:45:38.87,Default,,0000,0000,0000,,《Мен түсінемін. Әрине
Dialogue: 0,0:45:33.86,0:45:38.87,Default,,0000,0000,0000,,Сото
Dialogue: 0,0:45:33.86,0:45:38.87,Default,,0000,0000,0000,,Шуби
Dialogue: 0,0:45:33.86,0:45:38.87,Default,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:45:33.86,0:45:38.87,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:45:33.86,0:45:38.87,Default,,0000,0000,0000,,Суши
Dialogue: 0,0:45:33.86,0:45:38.87,Default,,0000,0000,0000,,Оның айтарлықтай қорғаныс диапазоны бар. ➡
Dialogue: 0,0:45:38.87,0:45:40.34,Default,,0000,0000,0000,,Алайда…》
Dialogue: 0,0:45:42.71,0:45:46.38,Default,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:45:42.71,0:45:46.38,Default,,0000,0000,0000,,Рұқсат беру – бұл
Dialogue: 0,0:45:42.71,0:45:46.38,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:45:42.71,0:45:46.38,Default,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:45:42.71,0:45:46.38,Default,,0000,0000,0000,,Мен болмасам ше!
Dialogue: 0,0:45:53.38,0:45:55.49,Default,,0000,0000,0000,,
Dialogue: 0,0:45:53.38,0:45:55.49,Default,,0000,0000,0000,,Артқы қадамнан➡
Dialogue: 0,0:45:55.49,0:45:59.16,Default,,0000,0000,0000,,Өшпелі түсірілім.
Dialogue: 0,0:45:55.49,0:45:59.16,Default,,0000,0000,0000,,Вакамацу
Dialogue: 0,0:45:55.49,0:45:59.16,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:45:55.49,0:45:59.16,Default,,0000,0000,0000,,Бірақ қандай өткір!
Dialogue: 0,0:45:59.16,0:46:00.62,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:46:05.33,0:46:07.30,Default,,0000,0000,0000,,Күлгін раушан
Dialogue: 0,0:46:05.33,0:46:07.30,Default,,0000,0000,0000,,Үш
Dialogue: 0,0:46:05.33,0:46:07.30,Default,,0000,0000,0000,,《3? 》
Dialogue: 0,0:46:05.33,0:46:07.30,Default,,0000,0000,0000,,
Dialogue: 0,0:46:10.50,0:46:13.17,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:46:10.50,0:46:13.17,Default,,0000,0000,0000,,Қос команда туралы бір нәрсе➡
Dialogue: 0,0:46:13.17,0:46:15.84,Default,,0000,0000,0000,,Менің ойымша, бұл тым көп болды.
Dialogue: 0,0:46:13.17,0:46:15.84,Default,,0000,0000,0000,,Жоқ деп ойлаймын.
Dialogue: 0,0:46:15.84,0:46:17.51,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:46:17.51,0:46:21.98,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:46:17.51,0:46:21.98,Default,,0000,0000,0000,,Аомин-cchi. Бұл жігіт
Dialogue: 0,0:46:17.51,0:46:21.98,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:46:17.51,0:46:21.98,Default,,0000,0000,0000,,Мака
Dialogue: 0,0:46:17.51,0:46:21.98,Default,,0000,0000,0000,,Маған қалдырмайсың ба?
Dialogue: 0,0:46:23.85,0:46:27.18,Default,,0000,0000,0000,,...Таку.
Dialogue: 0,0:46:23.85,0:46:27.18,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:46:23.85,0:46:27.18,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:46:23.85,0:46:27.18,Default,,0000,0000,0000,,Ал, сіз бірінші бара аласыз.
Dialogue: 0,0:46:27.18,0:46:30.19,Default,,0000,0000,0000,,Мезура
Dialogue: 0,0:46:27.18,0:46:30.19,Default,,0000,0000,0000,,Иә? Бұл сирек емес пе?
Dialogue: 0,0:46:27.18,0:46:30.19,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:46:30.19,0:46:34.32,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:46:30.19,0:46:34.32,Default,,0000,0000,0000,,Сіз оны бірінші көтердіңіз.
Dialogue: 0,0:46:30.19,0:46:34.32,Default,,0000,0000,0000,,...
Dialogue: 0,0:46:30.19,0:46:34.32,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:46:30.19,0:46:34.32,Default,,0000,0000,0000,,Тиісті жерде ауыстырыңыз!
Dialogue: 0,0:46:34.32,0:46:36.33,Default,,0000,0000,0000,,Ахх... Иә, иә.
Dialogue: 0,0:46:40.66,0:46:44.17,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:46:40.66,0:46:44.17,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:46:40.66,0:46:44.17,Default,,0000,0000,0000,,Матсуда мырза өледі.
Dialogue: 0,0:46:40.66,0:46:44.17,Default,,0000,0000,0000,,Алда! Сіз нені меңзеп тұрсыз?
Dialogue: 0,0:46:44.17,0:46:49.34,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:46:44.17,0:46:49.34,Default,,0000,0000,0000,,Жұмыс
Dialogue: 0,0:46:44.17,0:46:49.34,Default,,0000,0000,0000,,Суару
Dialogue: 0,0:46:44.17,0:46:49.34,Default,,0000,0000,0000,,Жоқ, жоқ. Егер сіз жағдайды ойласаңыз
Dialogue: 0,0:46:44.17,0:46:49.34,Default,,0000,0000,0000,,Шамамен
Dialogue: 0,0:46:44.17,0:46:49.34,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:46:44.17,0:46:49.34,Default,,0000,0000,0000,,Мен көбін түсінемін.
Dialogue: 0,0:46:49.34,0:46:53.34,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:46:49.34,0:46:53.34,Default,,0000,0000,0000,,Сіз сияқты
Dialogue: 0,0:46:49.34,0:46:53.34,Default,,0000,0000,0000,,Мен жалғызбын
Dialogue: 0,0:46:49.34,0:46:53.34,Default,,0000,0000,0000,,Жеткілікті
Dialogue: 0,0:46:49.34,0:46:53.34,Default,,0000,0000,0000,,Бұл маған ғана жетеді.
Dialogue: 0,0:46:53.34,0:46:57.78,Default,,0000,0000,0000,,Уф... мына бір ақымақ...
Dialogue: 0,0:46:57.78,0:47:00.08,Default,,0000,0000,0000,,《Сол жігіт. Мүмкін емес…»
Dialogue: 0,0:47:02.12,0:47:03.62,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,0:47:02.12,0:47:03.62,Default,,0000,0000,0000,,Ей, екеуің де.
Dialogue: 0,0:47:03.62,0:47:05.96,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:47:03.62,0:47:05.96,Default,,0000,0000,0000,,Не болса да
Dialogue: 0,0:47:03.62,0:47:05.96,Default,,0000,0000,0000,,Чоши
Dialogue: 0,0:47:03.62,0:47:05.96,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:47:03.62,0:47:05.96,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:47:03.62,0:47:05.96,Default,,0000,0000,0000,,Тым алшақ кетпеңіз...
Dialogue: 0,0:47:05.96,0:47:10.13,Default,,0000,0000,0000,,Кагетора
Dialogue: 0,0:47:05.96,0:47:10.13,Default,,0000,0000,0000,,Гяку
Dialogue: 0,0:47:05.96,0:47:10.13,Default,,0000,0000,0000,,Жоқ, керісінше.
Dialogue: 0,0:47:05.96,0:47:10.13,Default,,0000,0000,0000,,Йоюу
Dialogue: 0,0:47:05.96,0:47:10.13,Default,,0000,0000,0000,,Оларға орын жоқ.
Dialogue: 0,0:47:10.13,0:47:12.30,Default,,0000,0000,0000,,Сонымен, сен сол аралда не істеп жүрдің?
Dialogue: 0,0:47:10.13,0:47:12.30,Default,,0000,0000,0000,,Сато
Dialogue: 0,0:47:10.13,0:47:12.30,Default,,0000,0000,0000,,Бұл сізді түсінбеу үшін блеф.
Dialogue: 0,0:47:12.30,0:47:13.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:47:13.80,0:47:18.30,Default,,0000,0000,0000,,Кагетора
Dialogue: 0,0:47:13.80,0:47:18.30,Default,,0000,0000,0000,,Күлгін раушан
Dialogue: 0,0:47:13.80,0:47:18.30,Default,,0000,0000,0000,,Мұрасакибара жазған
Dialogue: 0,0:47:13.80,0:47:18.30,Default,,0000,0000,0000,,Жарылыс
Dialogue: 0,0:47:13.80,0:47:18.30,Default,,0000,0000,0000,,Жарылыс
Dialogue: 0,0:47:13.80,0:47:18.30,Default,,0000,0000,0000,,Қуат
Dialogue: 0,0:47:13.80,0:47:18.30,Default,,0000,0000,0000,,Миаяма
Dialogue: 0,0:47:13.80,0:47:18.30,Default,,0000,0000,0000,,No6 Мен №7 күшін қате бағаладым. ➡
Dialogue: 0,0:47:18.30,0:47:21.31,Default,,0000,0000,0000,,Сол себепті
Dialogue: 0,0:47:18.30,0:47:21.31,Default,,0000,0000,0000,,Тенза
Dialogue: 0,0:47:18.30,0:47:21.31,Default,,0000,0000,0000,,Чижи
Dialogue: 0,0:47:18.30,0:47:21.31,Default,,0000,0000,0000,,Ұпай айырмасы тарылған жоқ. ➡
Dialogue: 0,0:47:21.31,0:47:25.14,Default,,0000,0000,0000,,Жақсы жаңалық
Dialogue: 0,0:47:21.31,0:47:25.14,Default,,0000,0000,0000,,Және күткеннен де көп
Dialogue: 0,0:47:21.31,0:47:25.14,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:47:21.31,0:47:25.14,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:47:21.31,0:47:25.14,Default,,0000,0000,0000,,Қос командалар өте ыңғайлы. ➡
Dialogue: 0,0:47:25.14,0:47:28.65,Default,,0000,0000,0000,,Жетті, Конни
Dialogue: 0,0:47:25.14,0:47:28.65,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,0:47:25.14,0:47:28.65,Default,,0000,0000,0000,,Екеуіміздің де шыдамымыз жетпейді.
Dialogue: 0,0:47:28.65,0:47:31.98,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:47:28.65,0:47:31.98,Default,,0000,0000,0000,,Кисе
Dialogue: 0,0:47:28.65,0:47:31.98,Default,,0000,0000,0000,,Сато
Dialogue: 0,0:47:28.65,0:47:31.98,Default,,0000,0000,0000,,Құлпынай
Dialogue: 0,0:47:28.65,0:47:31.98,Default,,0000,0000,0000,,Мен мұны түсіндім және шешім қабылдадым.
Dialogue: 0,0:47:31.98,0:47:36.15,Default,,0000,0000,0000,,Аомин
Dialogue: 0,0:47:31.98,0:47:36.15,Default,,0000,0000,0000,,Аоминнің төзімділігі
Dialogue: 0,0:47:31.98,0:47:36.15,Default,,0000,0000,0000,,Онзон
Dialogue: 0,0:47:31.98,0:47:36.15,Default,,0000,0000,0000,,Сақтау үшін! ➡
Dialogue: 0,0:47:36.15,0:47:39.32,Default,,0000,0000,0000,,Мақал-мәтел
