Dialogue: 0,0:37:24.34,0:37:29.51,Default,,0000,0000,0000,,Рензоку Токутен
Dialogue: 0,0:37:24.34,0:37:29.51,Default,,0000,0000,0000,,Vorpal Swords Бірізді ұпайлар!
Dialogue: 0,0:37:30.65,0:37:34.15,Default,,0000,0000,0000,,Аомин-кун
Dialogue: 0,0:37:30.65,0:37:34.15,Default,,0000,0000,0000,,Гета
Dialogue: 0,0:37:30.65,0:37:34.15,Default,,0000,0000,0000,,Аомин-кун. Өткізу өте нашар.
Dialogue: 0,0:37:30.65,0:37:34.15,Default,,0000,0000,0000,,Мен таң қалдым.
