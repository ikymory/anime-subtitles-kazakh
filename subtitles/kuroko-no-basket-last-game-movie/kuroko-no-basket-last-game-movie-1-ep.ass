Dialogue: 0,1:08:40.78,1:08:43.62,Default,,0000,0000,0000,,Соңында соңғысы тұрады
Dialogue: 0,1:08:40.78,1:08:43.62,Default,,0000,0000,0000,,Немесе
Dialogue: 0,1:08:40.78,1:08:43.62,Default,,0000,0000,0000,,Бұл жеңіс!
Dialogue: 0,1:08:43.62,1:08:46.26,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:08:43.62,1:08:46.26,Default,,0000,0000,0000,,Алда!
Dialogue: 0,1:08:43.62,1:08:46.26,Default,,0000,0000,0000,,Мидорима
Dialogue: 0,1:08:43.62,1:08:46.26,Default,,0000,0000,0000,,Қоқыс.
Dialogue: 0,1:08:46.26,1:08:49.13,Default,,0000,0000,0000,,Күлгін раушан
Dialogue: 0,1:08:46.26,1:08:49.13,Default,,0000,0000,0000,,Қарғыс атсын... Ух...
Dialogue: 0,1:08:49.13,1:08:50.63,Default,,0000,0000,0000,,Жолдан кет!
Dialogue: 0,1:08:50.63,1:08:52.46,Default,,0000,0000,0000,,Уа, ау, не деген сұмдық!
Dialogue: 0,1:08:52.46,1:08:55.80,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,1:08:52.46,1:08:55.80,Default,,0000,0000,0000,,біз қайта орала аламыз.
Dialogue: 0,1:08:52.46,1:08:55.80,Default,,0000,0000,0000,,Цубу
Dialogue: 0,1:08:52.46,1:08:55.80,Default,,0000,0000,0000,,Мен бұл қоқысты тастаймын!
Dialogue: 0,1:08:55.80,1:08:57.63,Default,,0000,0000,0000,,Міндетті түрде.
Dialogue: 0,1:08:55.80,1:08:57.63,Default,,0000,0000,0000,,Муча жақсы емес.
Dialogue: 0,1:08:57.63,1:09:00.14,Default,,0000,0000,0000,,Мурасакибаракун
Dialogue: 0,1:08:57.63,1:09:00.14,Default,,0000,0000,0000,,Қотай
Dialogue: 0,1:08:57.63,1:09:00.14,Default,,0000,0000,0000,,Мурасакибара-кун. Кезекпен жүріңіз.
Dialogue: 0,1:09:00.14,1:09:01.64,Default,,0000,0000,0000,,Мен ұрып-соғып жатырмын...!
Dialogue: 0,1:09:01.64,1:09:03.11,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:09:04.64,1:09:06.98,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,1:09:04.64,1:09:06.98,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:09:06.98,1:09:09.55,Default,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,1:09:06.98,1:09:09.55,Default,,0000,0000,0000,,Кенже
Dialogue: 0,1:09:06.98,1:09:09.55,Default,,0000,0000,0000,,Мен де ашулы адаммын!
Dialogue: 0,1:09:12.98,1:09:15.48,Default,,0000,0000,0000,,Мүлдем
Dialogue: 0,1:09:12.98,1:09:15.48,Default,,0000,0000,0000,,Немесе
Dialogue: 0,1:09:12.98,1:09:15.48,Default,,0000,0000,0000,,Біз міндетті түрде жеңеміз!
Dialogue: 0,1:09:15.48,1:09:19.32,Default,,0000,0000,0000,,Сәлем Күміс. Чиби-чан
Dialogue: 0,1:09:15.48,1:09:19.32,Default,,0000,0000,0000,,Маған қарап тұрсың ба?
Dialogue: 0,1:09:19.32,1:09:21.99,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,1:09:19.32,1:09:21.99,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:09:24.16,1:09:30.00,Default,,0000,0000,0000,,күрсіну. Апыр-ай!
Dialogue: 0,1:09:24.16,1:09:30.00,Default,,0000,0000,0000,,Кейінірек
Dialogue: 0,1:09:24.16,1:09:30.00,Default,,0000,0000,0000,,Мака
Dialogue: 0,1:09:24.16,1:09:30.00,Default,,0000,0000,0000,,Ал, қалғанын мен саған қалдырамын. ➡
Dialogue: 0,1:09:30.00,1:09:36.07,Default,,0000,0000,0000,,Болды... Шынымен, сол жігіттер.
Dialogue: 0,1:09:30.00,1:09:36.07,Default,,0000,0000,0000,,Мені ұрып таста, жарай ма?
Dialogue: 0,1:09:36.07,1:09:37.57,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:09:41.08,1:09:44.91,Default,,0000,0000,0000,,ашуланшақ
Dialogue: 0,1:09:41.08,1:09:44.91,Default,,0000,0000,0000,,Сейен
Dialogue: 0,1:09:41.08,1:09:44.91,Default,,0000,0000,0000,,(аудиторияны қолдау)
Dialogue: 0,1:09:44.91,1:09:53.42,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:09:53.42,1:09:56.43,Default,,0000,0000,0000,,Жеке емес
