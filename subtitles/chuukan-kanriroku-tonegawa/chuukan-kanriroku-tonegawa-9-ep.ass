Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:56.67,0:03:01.65,Default,,0,0,0,,Көктемгі Teiai - бұл күн
Dialogue: 0,0:03:01.65,0:03:06.25,Default,,0,0,0,,Жыл сайынғы қосылу сұхбаты
Dialogue: 0,0:03:08.55,0:03:13.99,Default,,0,0,0,,Teiai-ге қалай қосылуға болады
Dialogue: 0,0:03:13.99,0:03:17.56,Default,,0,0,0,,Толтырыңыз! енгізу парағы
Dialogue: 0,0:03:17.56,0:03:23.47,Default,,0,0,0,,Мұны белгіленген мерзімде жіберіп, күтіңіз.
Dialogue: 0,0:03:23.47,0:03:27.97,Default,,0,0,0,,Жазба парағының нәтижелерін алғанша күтіңіз
Dialogue: 0,0:03:30.21,0:03:33.18,Default,,0,0,0,,Бірнеше күннен кейін үзіндінің хабары келгенде
Dialogue: 0,0:03:33.18,0:03:35.68,Default,,0,0,0,,Жазбаша емтиханды аяқтады
Dialogue: 0,0:03:35.68,0:03:40.38,Default,,0,0,0,,Teiai Finance сұхбат өтетін орынға
Dialogue: 0,0:03:43.85,0:03:48.53,Default,,0,0,0,,Хахаха мен биыл тағы келдім.
Dialogue: 0,0:03:48.53,0:03:55.40,Default,,0,0,0,,ТПО-ны жақсы жаста түсінбейтін азғантай сұмдық бар.
Dialogue: 0,0:03:55.40,0:03:58.10,Default,,0,0,0,,дегенді қалай түсінесіңдер?
Dialogue: 0,0:04:00.80,0:04:04.17,Default,,0,0,0,,Сұхбат басталып кетті.
Dialogue: 0,0:04:04.17,0:04:07.14,Default,,0,0,0,,Е? Иә.
Dialogue: 0,0:04:07.14,0:04:09.21,Default,,0,0,0,,Әңгімелесу туралы хабарламада
Dialogue: 0,0:04:09.21,0:04:13.65,Default,,0,0,0,,«Оқиға болатын күні өзіңізге сәйкес келетін киіммен келуіңізді сұраймыз».\NОнда
Dialogue: 0,0:04:13.65,0:04:16.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:18.19,0:04:21.29,Default,,0,0,0,,Иә, солай дейді.
Dialogue: 0,0:04:21.29,0:04:24.86,Default,,0,0,0,,Бірақ бұл тұзақ
Dialogue: 0,0:04:24.86,0:04:28.33,Default,,0,0,0,,Шайтандық шұңқыр
Dialogue: 0,0:04:28.33,0:04:31.60,Default,,0,0,0,,Мысалы, сол адам
Dialogue: 0,0:04:31.60,0:04:34.47,Default,,0,0,0,,Хабарламада не айтылса да
Dialogue: 0,0:04:34.47,0:04:39.41,Default,,0,0,0,,Teiai сұхбаты негізінен қара костюм (үстіңгі және төменгі)
Dialogue: 0,0:04:39.41,0:04:43.08,Default,,0,0,0,,Бұл айтылмаған ереже.
Dialogue: 0,0:04:43.08,0:04:45.98,Default,,0,0,0,,А... Жыл сайын бұл заңды білмейтіндер бар.
Dialogue: 0,0:04:45.98,0:04:49.92,Default,,0,0,0,,«Тегін киімді» байыппен қабылдау және ұялу
Dialogue: 0,0:04:49.92,0:04:54.12,Default,,0,0,0,,А-а, сұхбат алудың қажеті жоқ.
Dialogue: 0,0:04:54.12,0:04:57.99,Default,,0,0,0,,Сол кездегі аяқ кесілген
Dialogue: 0,0:04:57.99,0:05:00.53,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:05:00.53,0:05:06.97,Default,,0,0,0,,Teiai Group алып компаниясының №2 Юкио Тонегава
Dialogue: 0,0:05:06.97,0:05:10.31,Default,,0,0,0,,Төраға Хиодо, саяси және іскерлік әлемді басқаратын құбыжық.
Dialogue: 0,0:05:10.31,0:05:15.25,Default,,0,0,0,,Оң қол дәрежесіне көтерілген ашулы адам
Dialogue: 0,0:05:15.25,0:05:18.35,Default,,0,0,0,,Бұл оның аңызының және даңқының астарында жатыр
Dialogue: 0,0:05:18.35,0:05:23.32,Default,,0,0,0,,Мен орта буын менеджері ретінде жасырын түрде қиналып, күресемін.
Dialogue: 0,0:05:23.32,0:05:30.52,Default,,0,0,0,,Ұлы адамның шағын, шағын әңгімесі.
Dialogue: 0,0:07:00.85,0:07:05.86,Default,,0,0,0,,Жұмыс іздеуші студенттер арасындағы айырмашылықты жасайтын Teiai сұхбат сынағы
Dialogue: 0,0:07:05.86,0:07:10.09,Default,,0,0,0,,Әр оқушы 1-ден 10-ға дейін берілген стендке ауысады.
Dialogue: 0,0:07:10.09,0:07:14.19,Default,,0,0,0,,Ал сұхбат ретімен басталады.
Dialogue: 0,0:07:16.77,0:07:18.80,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:18.80,0:07:21.14,Default,,0,0,0,,Маған қоңырау шалыңыз.
Dialogue: 0,0:07:21.14,0:07:23.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:26.14,0:07:32.12,Default,,0,0,0,,Сұхбат алушы – басшы немесе одан жоғары дәрежедегі адам, бір адам қара киім киген.
Dialogue: 0,0:07:32.12,0:07:37.05,Default,,0,0,0,,Біраз сұрақтар мен жауаптардан кейін сұхбат аяқталады.
Dialogue: 0,0:07:37.05,0:07:39.46,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:39.46,0:07:42.93,Default,,0,0,0,,Үйге қайтқанда сақ болыңыз.
Dialogue: 0,0:07:42.93,0:07:46.86,Default,,0,0,0,,Өте рахмет. Енді барамын.
Dialogue: 0,0:07:46.86,0:07:50.37,Default,,0,0,0,,Осы кезде бұл туралы айтылғандар
Dialogue: 0,0:07:50.37,0:07:54.64,Default,,0,0,0,,Шығар! Сәтсіз
Dialogue: 0,0:07:54.64,0:07:57.97,Default,,0,0,0,,Қабылданса...
Dialogue: 0,0:07:57.97,0:08:00.94,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:08:00.94,0:08:05.92,Default,,0,0,0,,Енді сол есікке өтіңіз.
Dialogue: 0,0:08:05.92,0:08:07.92,Default,,0,0,0,,Индукция
Dialogue: 0,0:08:12.99,0:08:19.16,Default,,0,0,0,,Бұл жер асты әлеміне алғашқы қадам
Dialogue: 0,0:08:19.16,0:08:21.16,Default,,0,0,0,,Ах
Dialogue: 0,0:08:33.58,0:08:35.78,Default,,0,0,0,,А... а?
Dialogue: 0,0:08:39.78,0:08:43.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:43.52,0:08:47.62,Default,,0,0,0,,Құттықтау Құттықтау
Dialogue: 0,0:08:47.62,0:08:51.26,Default,,0,0,0,,А... А? Құттықтаймыз
Dialogue: 0,0:08:51.26,0:08:55.70,Default,,0,0,0,,Теяй қайтып келмейді
Dialogue: 0,0:08:55.70,0:08:57.90,Default,,0,0,0,,Өте жақсы адам ресурстары
Dialogue: 0,0:09:00.00,0:09:03.31,Default,,0,0,0,,Және... кешіріңіз.
Dialogue: 0,0:09:03.31,0:09:08.68,Default,,0,0,0,,Тонегава стенді студенттерінің келесі кіруі
Dialogue: 0,0:09:08.68,0:09:14.15,Default,,0,0,0,,Ең алдымен, маған Teiai-ге өтініш беруге мотивацияңызды айтыңыз.
Dialogue: 0,0:09:14.15,0:09:18.02,Default,,0,0,0,,Иә, мен сіздің компанияңыздың несие берудегі агрессивті ұстанымына қатты таң қалдым.
Dialogue: 0,0:09:18.02,0:09:21.99,Default,,0,0,0,,Кредиторларға екінші мүмкіндік беретін достық корпоративтік мәдениет
Dialogue: 0,0:09:21.99,0:09:24.93,Default,,0,0,0,,Сіздің компанияңыздың тамаша бастамалары...
Dialogue: 0,0:09:24.93,0:09:29.13,Default,,0,0,0,,Бұл шынайы. Империялық сүйіспеншілікке деген бұл құштарлық шынайы.
Dialogue: 0,0:09:29.13,0:09:32.10,Default,,0,0,0,,Мен солардың бірі болғым келетіндіктен,
Dialogue: 0,0:09:32.10,0:09:34.57,Default,,0,0,0,,Мен сіздің компанияңызда жұмыс істегім келеді.
Dialogue: 0,0:09:34.57,0:09:36.57,Default,,0,0,0,,Мен компанияға қосылуға өтініш бердім.
Dialogue: 0,0:09:36.57,0:09:38.71,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:09:38.71,0:09:43.21,Default,,0,0,0,,Академиялық мәлімет Жазбаша жауаптар да жаман емес.
Dialogue: 0,0:09:43.21,0:09:46.75,Default,,0,0,0,,Бұл міндетті түрде қабылдануы керек
Dialogue: 0,0:09:46.75,0:09:49.95,Default,,0,0,0,,Иә, рахмет. иә?
Dialogue: 0,0:09:49.95,0:09:53.39,Default,,0,0,0,,Үйге қайтқанда сақ болыңыз.
Dialogue: 0,0:09:53.39,0:09:56.49,Default,,0,0,0,,Сізге көп рахмет. Кешіріңіз.
Dialogue: 0,0:10:03.67,0:10:06.34,Default,,0,0,0,,Тонегава мырза хахаха
Dialogue: 0,0:10:06.34,0:10:09.61,Default,,0,0,0,,Таңқаларлық, Ямазаки? Ах...
Dialogue: 0,0:10:09.61,0:10:14.88,Default,,0,0,0,,Әрине, бүгінгі күннің адамы, оның Теяға деген махаббаты шынайы.
Dialogue: 0,0:10:14.88,0:10:18.48,Default,,0,0,0,,Сондықтан бұл жақсы емес, иә?
Dialogue: 0,0:10:18.48,0:10:21.72,Default,,0,0,0,,Мен Тейайдың керемет компания екенін айттым.
Dialogue: 0,0:10:21.72,0:10:27.16,Default,,0,0,0,,Бұл кезде түбегейлі айырмашылық бар
Dialogue: 0,0:10:27.16,0:10:29.19,Default,,0,0,0,,Е...
Dialogue: 0,0:10:29.19,0:10:33.50,Default,,0,0,0,,Императорлық махаббат - қара түсті, қаралардың қарасы
Dialogue: 0,0:10:33.50,0:10:36.03,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:10:36.03,0:10:38.03,Default,,0,0,0,,Тек ынта-ықылас алдыда
Dialogue: 0,0:10:38.03,0:10:42.11,Default,,0,0,0,,Тейайдың қарасының мәнін көре алмайтындар
Dialogue: 0,0:10:42.11,0:10:44.34,Default,,0,0,0,,Бұл ұзаққа созылмайды.
Dialogue: 0,0:10:44.34,0:10:48.21,Default,,0,0,0,,Хахаха Иә, білемін.
Dialogue: 0,0:10:48.21,0:10:53.58,Default,,0,0,0,,Жарайды, келесі жолы, Ямазаки, сіз шешесіз. Өту немесе өтпеу.
Dialogue: 0,0:10:53.58,0:10:55.59,Default,,0,0,0,,Не? мен?
Dialogue: 0,0:10:55.59,0:10:57.82,Default,,0,0,0,,Сіз де мансаптың ортасындасыз.
Dialogue: 0,0:10:57.82,0:11:00.92,Default,,0,0,0,,Мұндай тәжірибені алудың еш жамандығы жоқ.
Dialogue: 0,0:11:00.92,0:11:03.59,Default,,0,0,0,,Ух... түсіндім.
Dialogue: 0,0:11:03.59,0:11:05.66,Default,,0,0,0,,(ﾉｯｸ)
Dialogue: 0,0:11:05.66,0:11:07.86,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:11:07.86,0:11:09.86,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:12.94,0:11:14.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:14.94,0:11:18.34,Default,,0,0,0,,Бұл бет бір жерде
Dialogue: 0,0:11:18.34,0:11:21.68,Default,,0,0,0,,Ah Nu...
Dialogue: 0,0:11:21.68,0:11:24.35,Default,,0,0,0,,Жарайды... мүмкін емес, сен.
Dialogue: 0,0:11:24.35,0:11:27.55,Default,,0,0,0,,Ахаха иә
Dialogue: 0,0:11:27.55,0:11:32.46,Default,,0,0,0,,Менің ағам маған қарыздар, Тонегава мырза.
Dialogue: 0,0:11:32.46,0:11:36.33,Default,,0,0,0,,Сіз Оджионың інісісіз бе?
Dialogue: 0,0:11:36.33,0:11:38.76,Default,,0,0,0,,Ах, жоқ, яғни…
Dialogue: 0,0:11:38.76,0:11:43.83,Default,,0,0,0,,Бұл Огио емес, Хагио.
Dialogue: 0,0:11:43.83,0:11:45.84,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,0:11:45.84,0:11:49.51,Default,,0,0,0,,Дәл солай, тіпті оны қалай түзетуге болады.
Dialogue: 0,0:11:49.51,0:11:53.68,Default,,0,0,0,,Ой, бұл атмосфера өте үлкен.
Dialogue: 0,0:11:53.68,0:11:57.58,Default,,0,0,0,,Кез келген себеппен және кез келген жағдайда сұхбат дегеніміз не?
Dialogue: 0,0:11:57.58,0:12:01.35,Default,,0,0,0,,Ең бастысы - басшыларға қаншалықты ұнай алатыныңыз.
Dialogue: 0,0:12:01.35,0:12:04.62,Default,,0,0,0,,Жоқ, күте тұрыңыз.
Dialogue: 0,0:12:04.62,0:12:07.42,Default,,0,0,0,,Кенеттен жайсыздық сезімі
Dialogue: 0,0:12:07.42,0:12:11.83,Default,,0,0,0,,Жарайды Ямазаки ха
Dialogue: 0,0:12:11.83,0:12:14.40,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:12:14.40,0:12:16.90,Default,,0,0,0,,Yamazaki-ге назар аударыңыз
Dialogue: 0,0:12:16.90,0:12:18.90,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:18.90,0:12:21.84,Default,,0,0,0,,Үйге қайтқанда сақ болыңыз.
Dialogue: 0,0:12:21.84,0:12:25.88,Default,,0,0,0,,Иә, мен де ағам сияқты профессор Тонегаваға көмектескім келеді.
Dialogue: 0,0:12:25.88,0:12:27.88,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:12:34.38,0:12:38.72,Default,,0,0,0,,Хехехе, дұрыс, түсіндім.
Dialogue: 0,0:12:38.72,0:12:40.82,Default,,0,0,0,,Хаха, өйткені
Dialogue: 0,0:12:43.56,0:12:47.53,Default,,0,0,0,,Енді қажет емес
Dialogue: 0,0:12:47.53,0:12:51.37,Default,,0,0,0,,Шатастырылған тегі, ұқсас жүзі
Dialogue: 0,0:12:51.37,0:12:55.71,Default,,0,0,0,,Хехехе, дұрыс айтасың. Түсіндім, Ямазаки.
Dialogue: 0,0:12:55.71,0:12:59.14,Default,,0,0,0,,Рахмет (Nok)
Dialogue: 0,0:12:59.14,0:13:03.81,Default,,0,0,0,,А? Иә өтінемін
Dialogue: 0,0:13:03.81,0:13:05.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:08.85,0:13:11.69,Default,,0,0,0,,Ах
Dialogue: 0,0:13:11.69,0:13:16.33,Default,,0,0,0,,Неліктен біздің компанияны таңдағаныңызды айтыңыз.
Dialogue: 0,0:13:16.33,0:13:20.50,Default,,0,0,0,,Иә, мен сіздің компанияңыздың мұқият жинау әрекеттерімен келісемін.
Dialogue: 0,0:13:20.50,0:13:23.83,Default,,0,0,0,,Кредиторларға қарсы аяусыз шайтандық шаралар
Dialogue: 0,0:13:23.83,0:13:28.50,Default,,0,0,0,,Қазіргі әлемде дәл осындай қатаң компания мәдениетінің арқасында
Dialogue: 0,0:13:28.50,0:13:30.81,Default,,0,0,0,,Тірі қалу үшін маңызды...
Dialogue: 0,0:13:30.81,0:13:34.21,Default,,0,0,0,,Тонегава мырза, қараңызшы.
Dialogue: 0,0:13:34.21,0:13:36.68,Default,,0,0,0,,Қандай керемет мансап.
Dialogue: 0,0:13:36.68,0:13:42.19,Default,,0,0,0,,Оның жауаптары мінсіз болды, жазбаша емтиханда барлық пәндерден толық балл алды.
Dialogue: 0,0:13:42.19,0:13:45.35,Default,,0,0,0,,Нағыз асыл тас
Dialogue: 0,0:13:45.35,0:13:47.39,Default,,0,0,0,,Гррр…
Dialogue: 0,0:13:47.39,0:13:50.59,Default,,0,0,0,,Ең бастысы...
Dialogue: 0,0:13:50.59,0:13:53.96,Default,,0,0,0,,Ең басты ерекшеліктер
Dialogue: 0,0:13:53.96,0:13:59.87,Default,,0,0,0,,Сол бетпен басқа қара киіммен шатастыра алмайсың.
Dialogue: 0,0:13:59.87,0:14:01.87,Default,,0,0,0,,Керемет
Dialogue: 0,0:14:01.87,0:14:03.97,Default,,0,0,0,,Бұл, әрине, жақсы таңдау.
Dialogue: 0,0:14:03.97,0:14:06.91,Default,,0,0,0,,Жоқ... жоқ, бірақ…
Dialogue: 0,0:14:06.91,0:14:09.98,Default,,0,0,0,,Еңбектеріңіз үшін рахмет. Енді сол бөлмеге барайық...
Dialogue: 0,0:14:09.98,0:14:13.42,Default,,0,0,0,,Yamazaki күту
Dialogue: 0,0:14:13.42,0:14:17.39,Default,,0,0,0,,Үйге қайтқанда сақ болыңыз.
Dialogue: 0,0:14:17.39,0:14:20.49,Default,,0,0,0,,Не? Хехе
Dialogue: 0,0:14:23.03,0:14:28.33,Default,,0,0,0,,Индукция рәсімі өтетін күні кездескенше.
Dialogue: 0,0:14:28.33,0:14:30.93,Default,,0,0,0,,Доктор Тонегава Неліктен?
Dialogue: 0,0:14:33.10,0:14:38.51,Default,,0,0,0,,Шынында да, бұл адам басқа қара киімді адамдардан ерекшеленеді.\NСондықтан
Dialogue: 0,0:14:38.51,0:14:41.24,Default,,0,0,0,,...
Dialogue: 0,0:14:41.24,0:14:47.28,Default,,0,0,0,,Байқалмайды Байқамайды Төрағадан
Dialogue: 0,0:14:47.28,0:14:51.42,Default,,0,0,0,,Басқалармен шатастыруға болатын қара киімдерді шатастырып алу да мәселе.
Dialogue: 0,0:14:51.42,0:14:53.72,Default,,0,0,0,,Керісінше де рұқсат етілмейді.
Dialogue: 0,0:14:53.72,0:14:57.16,Default,,0,0,0,,А... терең тым терең
Dialogue: 0,0:14:57.16,0:15:01.56,Default,,0,0,0,,Теяйдің сұхбаты мен күткеннен де жоғары болды...
Dialogue: 0,0:15:04.40,0:15:08.77,Default,,0,0,0,,Қара тесік
Dialogue: 0,0:15:08.77,0:15:12.28,Default,,0,0,0,,Одан кейін сұхбатта үлкен проблемалар болған жоқ.
Dialogue: 0,0:15:12.28,0:15:16.98,Default,,0,0,0,,Сәтті аяқталды
Dialogue: 0,0:15:16.98,0:15:22.89,Default,,0,0,0,,Биылғы жылы барлығы 25 Teiai жаңа қызметкері
Dialogue: 0,0:15:22.89,0:15:27.39,Default,,0,0,0,,Иә, сәл табиғи түрде күліңіз.
Dialogue: 0,0:15:32.76,0:15:34.76,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:15:42.64,0:15:47.24,Default,,0,0,0,,Хехехе, көптен күткен түскі үзіліс
Dialogue: 0,0:15:47.24,0:15:51.21,Default,,0,0,0,,Тез кіріңіз! Түскі ас уақыты
Dialogue: 0,0:15:51.21,0:15:55.02,Default,,0,0,0,,Кеңсе қызметкерлері үшін қысқаша тыныштық сәті
Dialogue: 0,0:15:55.02,0:15:58.45,Default,,0,0,0,,Релаксация уақыты
Dialogue: 0,0:15:58.45,0:16:02.89,Default,,0,0,0,,Әдетте мен соба немесе жиынтық тамақпен күн көретін едім.
Dialogue: 0,0:16:02.89,0:16:04.89,Default,,0,0,0,,Бүгін...
Dialogue: 0,0:16:06.90,0:16:09.50,Default,,0,0,0,,(Асқазанның айқайлауы)
Dialogue: 0,0:16:09.50,0:16:11.90,Default,,0,0,0,,Сирек кездесетін аштық
Dialogue: 0,0:16:14.17,0:16:17.01,Default,,0,0,0,,А... иә
Dialogue: 0,0:16:17.01,0:16:20.24,Default,,0,0,0,,Бұл мен әдетте кірмейтін дүкен.
Dialogue: 0,0:16:20.24,0:16:23.38,Default,,0,0,0,,Бүгін барамыз ба?
Dialogue: 0,0:16:23.38,0:16:25.92,Default,,0,0,0,,Гацури
Dialogue: 0,0:16:25.92,0:16:29.19,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:16:29.19,0:16:31.52,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:16:31.52,0:16:34.16,Default,,0,0,0,,Жалғызсың ба? Иә
Dialogue: 0,0:16:34.16,0:16:36.16,Default,,0,0,0,,Осы жерді басыңыз.
Dialogue: 0,0:16:41.26,0:16:43.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:43.83,0:16:46.90,Default,,0,0,0,,Бұл, әрине, көлемді.
Dialogue: 0,0:16:46.90,0:16:49.91,Default,,0,0,0,,Күтпеген жайт
Dialogue: 0,0:16:49.91,0:16:53.04,Default,,0,0,0,,Маған қазір жеткіліксіз
Dialogue: 0,0:16:53.04,0:16:55.04,Default,,0,0,0,,Жарайды, тапсырыс беріңіз.
Dialogue: 0,0:16:55.04,0:16:58.21,Default,,0,0,0,,Иә, не істеуім керек?
Dialogue: 0,0:16:58.21,0:17:01.45,Default,,0,0,0,,Бір үлкен котлет ыдысы
Dialogue: 0,0:17:01.45,0:17:03.45,Default,,0,0,0,,Не? О
Dialogue: 0,0:17:05.72,0:17:08.99,Default,,0,0,0,,А... Мм, жақсысың ба?
Dialogue: 0,0:17:08.99,0:17:13.56,Default,,0,0,0,,А? Не, сен маған тым көп деу керек пе?
Dialogue: 0,0:17:13.56,0:17:16.53,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:17:16.53,0:17:20.50,Default,,0,0,0,,Тек әкел, ештеңе айтпа.
Dialogue: 0,0:17:20.50,0:17:23.40,Default,,0,0,0,,Иә... 1 үлкен порция
Dialogue: 0,0:17:25.37,0:17:27.71,Default,,0,0,0,,Және бірнеше минуттан кейін
Dialogue: 0,0:17:27.71,0:17:30.35,Default,,0,0,0,,Сізді күттіргенім үшін кешіріңіз, иә?
Dialogue: 0,0:17:30.35,0:17:33.25,Default,,0,0,0,,Нуа Катсудон - үлкен порция.
Dialogue: 0,0:17:33.25,0:17:39.76,Default,,0,0,0,,Гуаа... Бұл не деген басым сома?
Dialogue: 0,0:17:39.76,0:17:44.06,Default,,0,0,0,,Бұл қалыпты өлшем және бұл үлкен өлшем бе?
Dialogue: 0,0:17:44.06,0:17:47.66,Default,,0,0,0,,Идиот Қалыпты ойып алады
Dialogue: 0,0:17:47.66,0:17:50.56,Default,,0,0,0,,Қосымша қадамдар
Dialogue: 0,0:17:54.27,0:17:57.87,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:17:57.87,0:18:00.98,Default,,0,0,0,,Бұл дүкен ойып салынған.
Dialogue: 0,0:18:00.98,0:18:03.95,Default,,0,0,0,,Орташадан төмен…
Dialogue: 0,0:18:03.95,0:18:07.98,Default,,0,0,0,,Басқаша айтқанда, бұл өлшем орташа емес.
Dialogue: 0,0:18:07.98,0:18:10.45,Default,,0,0,0,,Гу... ақымақ
Dialogue: 0,0:18:10.45,0:18:16.46,Default,,0,0,0,,Сұрамаңыз, бұл фигурамен әйелдердің өлшемі
Dialogue: 0,0:18:16.46,0:18:18.56,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:18.56,0:18:23.10,Default,,0,0,0,,Өздерін сынағандарға суретке түсуді сұраймыз.
Dialogue: 0,0:18:23.10,0:18:25.10,Default,,0,0,0,,Мен оны кейінірек аламын ба?
Dialogue: 0,0:18:25.10,0:18:28.04,Default,,0,0,0,,А... түсіріп жатыр ма?
Dialogue: 0,0:18:28.04,0:18:30.04,Default,,0,0,0,,Осымен.
Dialogue: 0,0:18:30.04,0:18:32.21,Default,,0,0,0,,Гуах
Dialogue: 0,0:18:32.21,0:18:37.08,Default,,0,0,0,,Бірінен соң бірі тізілген жеңілгендердің тарихы
Dialogue: 0,0:18:37.08,0:18:40.42,Default,,0,0,0,,Ал, шын мәнінде, осы уақытқа дейін бәрін жеп қойған тұтынушылар
Dialogue: 0,0:18:40.42,0:18:42.62,Default,,0,0,0,,Бірде-біреуі жоқ.
Dialogue: 0,0:18:46.52,0:18:50.89,Default,,0,0,0,,Жаңа тарихтың тағы бір парағы
Dialogue: 0,0:18:50.89,0:18:54.46,Default,,0,0,0,,А... бұл мүмкін емес.
Dialogue: 0,0:18:54.46,0:18:57.27,Default,,0,0,0,,А... Күте тұрыңыз.
Dialogue: 0,0:18:57.27,0:19:01.24,Default,,0,0,0,,Шығыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:19:01.24,0:19:04.81,Default,,0,0,0,,Бірақ... бірақ қазірдің өзінде...
Dialogue: 0,0:19:04.81,0:19:10.21,Default,,0,0,0,,Тек әкел, ештеңе айтпа.
Dialogue: 0,0:19:10.21,0:19:14.88,Default,,0,0,0,,Енді біз үлкен суретті көрдік, біз артқа шегіне алмаймыз.
Dialogue: 0,0:19:14.88,0:19:17.49,Default,,0,0,0,,Бұл түскі ас уақыты болу керек еді, бірақ
Dialogue: 0,0:19:17.49,0:19:22.89,Default,,0,0,0,,Неліктен... неге бұл болып жатыр?
Dialogue: 0,0:19:22.89,0:19:24.89,Default,,0,0,0,,Хехе ах
Dialogue: 0,0:19:24.89,0:19:29.80,Default,,0,0,0,,Осы жаңа аңызға айналған сәтті жіберіп алмаңыз
Dialogue: 0,0:19:29.80,0:19:32.37,Default,,0,0,0,,Бір сәттік суретке түсу мүмкіндігі
Dialogue: 0,0:19:32.37,0:19:36.07,Default,,0,0,0,,Не? о! о!
Dialogue: 0,0:19:39.68,0:19:42.68,Default,,0,0,0,,Анықтау өзені
Dialogue: 0,0:19:57.59,0:20:01.20,Default,,0,0,0,,Үмітсіз суға түсу Катсу но Уми
Dialogue: 0,0:20:01.20,0:20:03.37,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,0:20:03.37,0:20:05.97,Default,,0,0,0,,Сіз оны ұстадыңыз!
Dialogue: 0,0:20:10.37,0:20:14.87,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:20:16.88,0:20:21.38,Default,,0,0,0,,Жарайды, котлет бітті, күріш қалды.
Dialogue: 0,0:20:23.42,0:20:26.22,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:20:26.22,0:20:28.29,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:20:28.29,0:20:30.73,Default,,0,0,0,,Күріште көбірек котлеттер
Dialogue: 0,0:20:30.73,0:20:33.56,Default,,0,0,0,,Тонегаваның үлкен қателігі
Dialogue: 0,0:20:33.56,0:20:35.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:41.44,0:20:48.81,Default,,0,0,0,,Ой, мен оны қос деп ойладым, бірақ үш есе болып шықты.
Dialogue: 0,0:20:48.81,0:20:54.98,Default,,0,0,0,,Дәл Катсу ақауы
Dialogue: 0,0:20:54.98,0:20:59.42,Default,,0,0,0,,Котлет толқындарына аяусыз шабуыл жасау
Dialogue: 0,0:20:59.42,0:21:02.29,Default,,0,0,0,,Бұл үлкен құбыжық болды.
Dialogue: 0,0:21:02.29,0:21:05.23,Default,,0,0,0,,Тон өзенін жұту
Dialogue: 0,0:21:05.23,0:21:07.76,Default,,0,0,0,,Нуах!
Dialogue: 0,0:21:07.76,0:21:13.66,Default,,0,0,0,,Жеңдер немесе жеп қойыңдар, өміріңмен ауыр ойын.
Dialogue: 0,0:21:15.94,0:21:18.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:20.64,0:21:23.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:23.11,0:21:27.32,Default,,0,0,0,,Сондай-ақ... сол кезде бас тартқан дұрыс.
Dialogue: 0,0:21:27.32,0:21:29.79,Default,,0,0,0,,Бас тарту керек пе? Ах...
Dialogue: 0,0:21:29.79,0:21:32.35,Default,,0,0,0,,Байыпты бәсекеде мұндай нәрсе бар ма?
Dialogue: 0,0:21:32.35,0:21:34.39,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:34.39,0:21:37.29,Default,,0,0,0,,Ойнау уақыты аяқталды
Dialogue: 0,0:21:41.23,0:21:44.53,Default,,0,0,0,,Сондай-ақ!
Dialogue: 0,0:21:44.53,0:21:47.00,Default,,0,0,0,,Джува!
Dialogue: 0,0:21:47.00,0:21:49.44,Default,,0,0,0,,Жеңіске жетсек жақсы болмай ма?
Dialogue: 0,0:21:49.44,0:21:52.81,Default,,0,0,0,,Жеңіске жетпесең өмір жақсы болмайды.
Dialogue: 0,0:21:52.81,0:21:56.71,Default,,0,0,0,,Нуаааааааааааааааааааааа
Dialogue: 0,0:21:56.71,0:22:00.28,Default,,0,0,0,,Ах
Dialogue: 0,0:22:00.28,0:22:02.79,Default,,0,0,0,,О! о!
Dialogue: 0,0:22:02.79,0:22:05.55,Default,,0,0,0,,Тонегава Аяқталды
Dialogue: 0,0:22:05.55,0:22:08.39,Default,,0,0,0,,Керемет Мен бәрін жедім.
Dialogue: 0,0:22:08.39,0:22:12.06,Default,,0,0,0,,Құттықтаймыз...
Dialogue: 0,0:22:12.06,0:22:16.56,Default,,0,0,0,,Кешіріңіз, сәл табиғи түрде күліңіз.
Dialogue: 0,0:22:20.30,0:22:25.01,Default,,0,0,0,,Әй, бұл ұзақ емес пе? Профессор Тонегаваның түскі ас уақыты
Dialogue: 0,0:22:25.01,0:22:30.15,Default,,0,0,0,,Ойланып қарасам, түстен кейінгі жиналыс басталатын уақыт та қалды.
Dialogue: 0,0:22:30.15,0:22:32.28,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:22:32.28,0:22:36.59,Default,,0,0,0,,Ах... Ах, Тонегава мырза.
Dialogue: 0,0:22:36.59,0:22:40.32,Default,,0,0,0,,Сіз қайда болдыңыз? Мен уайымдадым.
Dialogue: 0,0:22:40.32,0:22:43.93,Default,,0,0,0,,Маған жақындама, не боларын білмеймін.
Dialogue: 0,0:22:43.93,0:22:45.93,Default,,0,0,0,,Ағымдағы бүркітті ұстасаңыз
Dialogue: 0,0:22:45.93,0:22:49.20,Default,,0,0,0,,Сәлем
Dialogue: 0,0:22:49.20,0:22:52.47,Default,,0,0,0,,Біз түстен кейінгі жиналысты бастағалы жатырмыз.
Dialogue: 0,0:22:52.47,0:22:57.01,Default,,0,0,0,,Не... осы түскі уақытта не болды?
Dialogue: 0,0:22:57.01,0:23:00.91,Default,,0,0,0,,(Телефон қоңырау үні)
Dialogue: 0,0:23:08.18,0:23:12.59,Default,,0,0,0,,Бұл Тонегава. Сізге қоңырау шалсам бола ма?
Dialogue: 0,0:23:12.59,0:23:14.72,Default,,0,0,0,,Тон өзеніне келдің бе?
Dialogue: 0,0:23:14.72,0:23:16.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:16.89,0:23:19.93,Default,,0,0,0,,Бұл котлеттен жасалған бутерброд туралы не ойлайсыз?
Dialogue: 0,0:23:19.93,0:23:22.83,Default,,0,0,0,,Уф... аа
Dialogue: 0,0:23:25.77,0:23:28.47,Default,,0,0,0,,А... сенің де жеуің керек.
Dialogue: 0,0:23:32.01,0:23:35.24,Default,,0,0,0,,Котлеттер теңізі қайтадан ағып жатыр
Dialogue: 0,0:23:35.24,0:23:37.48,Default,,0,0,0,,Ешқашан бітпейтін қорқыныш
Dialogue: 0,0:23:37.48,0:23:39.48,Default,,0,0,0,,Ах, сонда ол ма еді?
Dialogue: 0,0:23:42.02,0:23:46.76,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Тонегава Жоғалтпа, Тонегава
Dialogue: 0,0:23:46.76,0:23:50.96,Default,,0,0,0,,Бұл бастық, төраға және бағыныштылар арасында, қара киім.
Dialogue: 0,0:23:50.96,0:23:55.46,Default,,0,0,0,,Күрес Бұл бір адамның әңгімесі.
Dialogue: 0,0:23:55.46,0:24:00.36,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,0:24:03.91,0:24:08.11,Default,,0,0,0,,Жай ғана сэндвич
Dialogue: 0,0:25:44.37,0:25:46.67,Default,,0,0,0,,Келесі жолы «Репетиция»
Dialogue: 0,0:28:32.14,0:28:34.88,Default,,0,0,0,,Шектеулі тас, қағаз, қайшы
Dialogue: 0,0:28:34.88,0:28:37.81,Default,,0,0,0,,Бұл 12 карта.
Dialogue: 0,0:28:37.81,0:28:40.62,Default,,0,0,0,,Тас, қағаз, қайшы ойнап, бір-бірінің жұлдыздары үшін жарысады
Dialogue: 0,0:28:40.62,0:28:43.75,Default,,0,0,0,,Бір қарағанда, сәттілік немесе данышпандық ойыны
Dialogue: 0,0:28:43.75,0:28:48.02,Default,,0,0,0,,Ойнап болғаннан кейін картаны тастайды.
Dialogue: 0,0:28:48.02,0:28:52.63,Default,,0,0,0,,Ол есептелетіндіктен, оны шығару реті бойынша стратегия қажет.
Dialogue: 0,0:28:52.63,0:28:55.36,Default,,0,0,0,,Сонымен қатар, уақыт шегі - 4 сағат.
Dialogue: 0,0:28:55.36,0:28:58.07,Default,,0,0,0,,Соңында 3 немесе одан да көп жұлдыздарды бекітіңіз
Dialogue: 0,0:28:58.07,0:29:02.00,Default,,0,0,0,,Егер сіз барлық карталарды пайдаланбаған болсаңыз, сіз ұтыласыз.
Dialogue: 0,0:29:02.00,0:29:05.44,Default,,0,0,0,,Алдау, бірін-бірі алдау, сатқындық
Dialogue: 0,0:29:05.44,0:29:07.91,Default,,0,0,0,,Басқалардан алдау үшін қажетті тактика
Dialogue: 0,0:29:07.91,0:29:12.35,Default,,0,0,0,,Шынымен де шайтандық ойын
Dialogue: 0,0:29:12.35,0:29:16.35,Default,,0,0,0,,Ал уақыт кері кетеді
Dialogue: 0,0:29:18.49,0:29:22.62,Default,,0,0,0,,Тонегава мырзаның электронды хабарландыру тақтасы келді
Dialogue: 0,0:29:22.62,0:29:24.99,Default,,0,0,0,,О, ұстаз
Dialogue: 0,0:29:24.99,0:29:27.96,Default,,0,0,0,,Үстел де келді ме?
Dialogue: 0,0:29:27.96,0:29:31.93,Default,,0,0,0,,Шектеулі тас қағаз қайшы Бірінші жаттығуға дейін 1 апта
Dialogue: 0,0:29:31.93,0:29:36.20,Default,,0,0,0,,Тапсырыс берілген керек-жарақтар бірінен соң бірі келеді
Dialogue: 0,0:29:36.20,0:29:42.28,Default,,0,0,0,,Хахаха ойынға қажетті заттардың көбін уақытында алдым.
Dialogue: 0,0:29:42.28,0:29:46.78,Default,,0,0,0,,Хаха Қайсысын қолданып көруім керек?
Dialogue: 0,0:29:54.79,0:29:57.93,Default,,0,0,0,,А? Ей, саны азаймайды.
Dialogue: 0,0:29:57.93,0:30:00.73,Default,,0,0,0,,Не? Менің ойымша, бұл "иә?"
Dialogue: 0,0:30:00.73,0:30:04.10,Default,,0,0,0,,Шектеулі тас, қағаз, қайшы
Dialogue: 0,0:30:04.10,0:30:07.20,Default,,0,0,0,,Әрқашан қалған карталардың санын есептеңіз
Dialogue: 0,0:30:07.20,0:30:10.77,Default,,0,0,0,,көрсету үшін маңызды
Dialogue: 0,0:30:10.77,0:30:14.34,Default,,0,0,0,,Карточкаға енгізілген магниттік чип бар ма?
Dialogue: 0,0:30:14.34,0:30:17.18,Default,,0,0,0,,А... оны имплантациялаған адам?
Dialogue: 0,0:30:17.18,0:30:19.18,Default,,0,0,0,,Оны кім енгізді?
Dialogue: 0,0:30:21.18,0:30:25.29,Default,,0,0,0,,А? Амал жоқ, жігіттер
Dialogue: 0,0:30:25.29,0:30:28.62,Default,,0,0,0,,Бұл үлкен көлемдегі карталардың барлығы қағаз
Dialogue: 0,0:30:28.62,0:30:31.52,Default,,0,0,0,,Бұл жай ғана қағаз емес деп ойлаймын.
Dialogue: 0,0:30:35.43,0:30:38.80,Default,,0,0,0,,Балалар... жоқ... жоқ.
Dialogue: 0,0:30:38.80,0:30:41.90,Default,,0,0,0,,Күтілгендей, бұл кестеде қандай да бір айла бар.
Dialogue: 0,0:30:44.07,0:30:46.24,Default,,0,0,0,,Мен үшін алғаш рет!
Dialogue: 0,0:30:46.24,0:30:48.88,Default,,0,0,0,,Аспан... Аспан?
Dialogue: 0,0:30:48.88,0:30:52.78,Default,,0,0,0,,Аа, кешіріңіз. Картаны дереу қайта тапсырыс беріңіз.
Dialogue: 0,0:30:52.78,0:30:54.92,Default,,0,0,0,,Сіз оны уақытында жасайсыз ба? Ах...
Dialogue: 0,0:30:54.92,0:30:57.75,Default,,0,0,0,,Егер бұл орын алса, жауапкершілікті өз мойныңызға алыңыз.
Dialogue: 0,0:30:57.75,0:31:01.45,Default,,0,0,0,,Ішке кіріп, өлшемдеріңізді алыңыз.
Dialogue: 0,0:31:03.56,0:31:06.03,Default,,0,0,0,,... кіру мүмкін емес пе... мүмкін емес.
Dialogue: 0,0:31:06.03,0:31:09.93,Default,,0,0,0,,Мүмкін емес Осындай шағын кеңістікте 4 сағаттан кейін
Dialogue: 0,0:31:09.93,0:31:13.14,Default,,0,0,0,,Бұл біртүрлі. Тамақ ше?
Dialogue: 0,0:31:13.14,0:31:15.27,Default,,0,0,0,,Аш болсаң не істейсің?
Dialogue: 0,0:31:15.27,0:31:18.14,Default,,0,0,0,,Дұрыс, бұл тек асқазан емес.
Dialogue: 0,0:31:18.14,0:31:21.08,Default,,0,0,0,,Кешіріңіз, менің де белім бүлінген.
Dialogue: 0,0:31:21.08,0:31:23.08,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:31:26.65,0:31:28.92,Default,,0,0,0,,Қандай жағымсыз иіс! Тамағымның арты ұстап, ауырып барады.
Dialogue: 0,0:31:28.92,0:31:32.39,Default,,0,0,0,,Ха...
Dialogue: 0,0:31:32.39,0:31:35.82,Default,,0,0,0,,Бұл мүмкін емес, бұл да мүмкін емес
Dialogue: 0,0:31:35.82,0:31:40.12,Default,,0,0,0,,You guys are astonished, do whatever you want.
Dialogue: 0,0:33:18.96,0:33:22.40,Default,,0,0,0,,Ойланып қарасаңыз,
Dialogue: 0,0:33:22.40,0:33:24.60,Default,,0,0,0,,Егер сіз қазір мердігерді мәжбүрлесеңіз
Dialogue: 0,0:33:24.60,0:33:28.80,Default,,0,0,0,,I won't make it in time for next week's rehearsal.
Dialogue: 0,0:33:28.80,0:33:34.14,Default,,0,0,0,,Even though I was pissed, “going inside” was really rude.
Dialogue: 0,0:33:34.14,0:33:36.94,Default,,0,0,0,,Мен сені кешіруім керек пе? Уақыт келді
Dialogue: 0,0:33:45.45,0:33:47.72,Default,,0,0,0,,Бұл менмін, Тонегава мырза.
Dialogue: 0,0:33:47.72,0:33:50.89,Default,,0,0,0,,I was just thinking of contacting you as well.
Dialogue: 0,0:33:50.89,0:33:53.40,Default,,0,0,0,,А? Енді 5-қабаттағы үлкен залға барыңыз.
Dialogue: 0,0:33:53.40,0:33:55.40,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:33:58.27,0:34:00.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:04.27,0:34:06.78,Default,,0,0,0,,Сіз осындасыз, Тонегава мырза.
Dialogue: 0,0:34:06.78,0:34:09.01,Default,,0,0,0,,Ямазаки Бұл...
Dialogue: 0,0:34:09.01,0:34:13.08,Default,,0,0,0,,Ахаха Өтінемін, бәрібір көріңіз.
Dialogue: 0,0:34:13.08,0:34:15.75,Default,,0,0,0,,Put your favorite card in your favorite box
Dialogue: 0,0:34:15.75,0:34:17.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:22.16,0:34:24.26,Default,,0,0,0,,Ах
Dialogue: 0,0:34:24.26,0:34:26.46,Default,,0,0,0,,Сонда бұл
Dialogue: 0,0:34:29.13,0:34:31.80,Default,,0,0,0,,Ах
Dialogue: 0,0:34:31.80,0:34:34.70,Default,,0,0,0,,Каккакка Мүмкін
Dialogue: 0,0:34:36.87,0:34:39.87,Default,,0,0,0,,Орындалды! адам өлшейтін құрал
Dialogue: 0,0:34:43.58,0:34:48.28,Default,,0,0,0,,Сіз ішке кіретініңізге сенімдісіз бе? Мен қара киім киемін.
Dialogue: 0,0:34:48.28,0:34:52.85,Default,,0,0,0,,It's been more than 5 hours and no one has dropped out.
Dialogue: 0,0:34:52.85,0:34:55.42,Default,,0,0,0,,Өтінемін... 5 сағат
Dialogue: 0,0:34:55.42,0:34:58.63,Default,,0,0,0,,Сіз қалай ойлайсыз? Сәлем Комо
Dialogue: 0,0:34:58.63,0:35:02.23,Default,,0,0,0,,Мен мұны істеймін деп ешқашан ойламадым.
Dialogue: 0,0:35:02.23,0:35:07.37,Default,,0,0,0,,I see, I understand your guts and determination.
Dialogue: 0,0:35:07.37,0:35:11.51,Default,,0,0,0,,Бірақ шықсаң да жетеді.
Dialogue: 0,0:35:11.51,0:35:13.51,Default,,0,0,0,,Сіңлім!
Dialogue: 0,0:35:15.81,0:35:18.98,Default,,0,0,0,,А... аа, мұғалім
Dialogue: 0,0:35:18.98,0:35:22.78,Default,,0,0,0,,Саймонның тақырыбы «релаксация»
Dialogue: 0,0:35:22.78,0:35:26.15,Default,,0,0,0,,Equipped with low-resilience cushions and the latest game consoles
Dialogue: 0,0:35:26.15,0:35:30.53,Default,,0,0,0,,I decided to recreate my room in just 1.3 square meters.
Dialogue: 0,0:35:30.53,0:35:33.40,Default,,0,0,0,,Үлкен жетістік...
Dialogue: 0,0:35:33.40,0:35:35.60,Default,,0,0,0,,Келесі осында
Dialogue: 0,0:35:37.57,0:35:40.37,Default,,0,0,0,,Қош келдіңіз, Нуа.
Dialogue: 0,0:35:40.37,0:35:42.90,Default,,0,0,0,,Гонда мырзаның тақырыбы «арман»
Dialogue: 0,0:35:42.90,0:35:48.08,Default,,0,0,0,,My childhood dream of opening a used bookstore came true here.
Dialogue: 0,0:35:48.08,0:35:50.41,Default,,0,0,0,,Наката мырзаның тақырыбы: «Космо»
Dialogue: 0,0:35:50.41,0:35:52.85,Default,,0,0,0,,А, жабыңыз, жабыңыз.
Dialogue: 0,0:35:52.85,0:35:56.79,Default,,0,0,0,,Мистер Хагио – идеялардың салтанат құруы
Dialogue: 0,0:35:56.79,0:35:59.42,Default,,0,0,0,,«Мысық кафесі» Ах... Ах
Dialogue: 0,0:35:59.42,0:36:02.32,Default,,0,0,0,,Бұл таңқаларлық емес пе? А... аа
Dialogue: 0,0:36:02.32,0:36:05.03,Default,,0,0,0,,Бұл таңқаларлық, бірақ
Dialogue: 0,0:36:05.03,0:36:08.26,Default,,0,0,0,,Қара киімділер мүмкін емес есептерді шешті.
Dialogue: 0,0:36:08.26,0:36:12.47,Default,,0,0,0,,Тон өзені өте бұлыңғыр
Dialogue: 0,0:36:12.47,0:36:16.57,Default,,0,0,0,,Ал, мысықтың мияулауынан сақ бол.
Dialogue: 0,0:36:16.57,0:36:19.54,Default,,0,0,0,,Ахаха сақ боламын Ха... Ха...
Dialogue: 0,0:36:19.54,0:36:22.24,Default,,0,0,0,,Мен ашулана алмаймын.
Dialogue: 0,0:36:26.15,0:36:29.68,Default,,0,0,0,,Бір аптадан кейін оны Эспоирге шақырды.
Dialogue: 0,0:36:29.68,0:36:32.69,Default,,0,0,0,,Teiai Қара киімдегі жаңа қызметкерлер
Dialogue: 0,0:36:32.69,0:36:35.16,Default,,0,0,0,,келеді
Dialogue: 0,0:36:35.16,0:36:38.66,Default,,0,0,0,,Devilish Plan Limited Rock Paper Scissors
Dialogue: 0,0:36:38.66,0:36:41.16,Default,,0,0,0,,Бірінші репетиция
Dialogue: 0,0:36:41.16,0:36:44.23,Default,,0,0,0,,Міне, ережелердің түсіндірмесі.
Dialogue: 0,0:36:44.23,0:36:49.74,Default,,0,0,0,,Жаттығу болса да, бұл тозақ қазанының түбі.
Dialogue: 0,0:36:49.74,0:36:53.31,Default,,0,0,0,,Сізге қазір не істеу керек - жеңіс.
Dialogue: 0,0:36:53.31,0:36:55.98,Default,,0,0,0,,Жеңіп, бұл жерден кет
Dialogue: 0,0:36:55.98,0:36:58.85,Default,,0,0,0,,Әркім өзін бірнеше борышкер санайды.
Dialogue: 0,0:36:58.85,0:37:01.75,Default,,0,0,0,,Бар күш-жігеріңді жұмсауыңды қалаймын.
Dialogue: 0,0:37:01.75,0:37:03.75,Default,,0,0,0,,Га
Dialogue: 0,0:37:10.33,0:37:13.29,Default,,0,0,0,,Хахахаха Ал енді
Dialogue: 0,0:37:13.29,0:37:17.67,Default,,0,0,0,,Стратегия, басқалардан алда, тек аман қалғандар
Dialogue: 0,0:37:17.67,0:37:19.67,Default,,0,0,0,,Шайтандық ойындар
Dialogue: 0,0:37:19.67,0:37:23.30,Default,,0,0,0,,Қалай болар екен деп ойлаймын.
Dialogue: 0,0:37:23.30,0:37:25.40,Default,,0,0,0,,Жануар демі: жетінші форма
Dialogue: 0,0:37:29.08,0:37:32.21,Default,,0,0,0,,Менімен төбелесуге ше? Ха!
Dialogue: 0,0:37:32.21,0:37:35.82,Default,,0,0,0,,Жинақтың ашықтығын тексеріңіз
Dialogue: 0,0:37:35.82,0:37:38.35,Default,,0,0,0,,Мен жеңдім хаха
Dialogue: 0,0:37:38.35,0:37:40.39,Default,,0,0,0,,Жұлдызды фишкалар беріңізші
Dialogue: 0,0:37:40.39,0:37:43.93,Default,,0,0,0,,Сізге көп рахмет. Менің тағы бір мүмкіндігім бар деп үміттенемін.
Dialogue: 0,0:37:43.93,0:37:47.40,Default,,0,0,0,,Қош келдіңіз, өтінемін.
Dialogue: 0,0:37:47.40,0:37:50.06,Default,,0,0,0,,Кешіріңіз, дәретхана қайда?
Dialogue: 0,0:37:50.06,0:37:52.33,Default,,0,0,0,,Жұлдыздық чиптің қозғалысы Ah
Dialogue: 0,0:37:52.33,0:37:55.04,Default,,0,0,0,,Кешіріңіз, мен оны тастадым.
Dialogue: 0,0:37:55.04,0:37:58.97,Default,,0,0,0,,Бірдеңе тым көп шертеді
Dialogue: 0,0:37:58.97,0:38:02.98,Default,,0,0,0,,Биылғы жаңа қызметкерлерді білім беру мақсатында жинадық.
Dialogue: 0,0:38:02.98,0:38:06.21,Default,,0,0,0,,Бұл өте қиын, бәрібір
Dialogue: 0,0:38:06.21,0:38:09.12,Default,,0,0,0,,Менің командамның қара киіміне аралассаң,
Dialogue: 0,0:38:09.12,0:38:12.05,Default,,0,0,0,,Мүмкін мен атмосфераны өзгерте аламын
Dialogue: 0,0:38:12.05,0:38:14.75,Default,,0,0,0,,Өкінішке орай, кестенің ішінде
Dialogue: 0,0:38:19.03,0:38:25.03,Default,,0,0,0,,Күтпеген қате есеп...
Dialogue: 0,0:38:25.03,0:38:27.44,Default,,0,0,0,,Хехехе
Dialogue: 0,0:38:27.44,0:38:30.64,Default,,0,0,0,,Менде борышкер деген нөлдік сезім жоқ.
Dialogue: 0,0:38:30.64,0:38:33.41,Default,,0,0,0,,Мен сізді қызықты жобамен жұмыс істеп жатқаныңызды естідім.
Dialogue: 0,0:38:33.41,0:38:36.18,Default,,0,0,0,,Келіп көрсеңіз
Dialogue: 0,0:38:36.18,0:38:41.58,Default,,0,0,0,,Endo Financial, Teiai, президент Юджи Эндомен байланысты қалалық банк
Dialogue: 0,0:38:41.58,0:38:46.92,Default,,0,0,0,,Бұл адам кейінірек Тонегаваны аты аңызға айналған Кайдзи Итомен таныстырды.
Dialogue: 0,0:38:46.92,0:38:48.92,Default,,0,0,0,,Кейман
Dialogue: 0,0:38:48.92,0:38:52.86,Default,,0,0,0,,Тонегава мырза, компанияға жаңадан қосылған жаңа қызметкерлер
Dialogue: 0,0:38:52.86,0:38:56.10,Default,,0,0,0,,Мен бәрінен де сәтсіздік пен қателіктерден қорқамын.
Dialogue: 0,0:38:56.10,0:38:59.77,Default,,0,0,0,,Бұл олар үшін ең қиын кезең.
Dialogue: 0,0:38:59.77,0:39:02.04,Default,,0,0,0,,Азғын және өнімсіз
Dialogue: 0,0:39:02.04,0:39:05.71,Default,,0,0,0,,Біреудің бірнеше борышкер рөлін ойнауы - бұл мүлдем керісінше.
Dialogue: 0,0:39:05.71,0:39:11.31,Default,,0,0,0,,Бұл бір түнде мүмкін емес. Бұл мүмкін емес.
Dialogue: 0,0:39:11.31,0:39:14.75,Default,,0,0,0,,Мен көптеген борышкерлерді жинадым.
Dialogue: 0,0:39:14.75,0:39:18.72,Default,,0,0,0,,Кәсіби лекция болса, әңгіме басқаша болар еді.
Dialogue: 0,0:39:18.72,0:39:21.42,Default,,0,0,0,,Сіз не айтқыңыз келеді? Хаха
Dialogue: 0,0:39:21.42,0:39:26.89,Default,,0,0,0,,Қара киімді маған бір күнге қалдыра аласың ба?
Dialogue: 0,0:39:26.89,0:39:29.63,Default,,0,0,0,,Мен оларды бір күнде өлтіретін едім
Dialogue: 0,0:39:29.63,0:39:34.20,Default,,0,0,0,,Мен сені лайықты көп борышкер етемін.
Dialogue: 0,0:39:34.20,0:39:38.14,Default,,0,0,0,,Осылайша курс басталды.
Dialogue: 0,0:39:38.14,0:39:41.24,Default,,0,0,0,,Эндоның бірнеше борышкер курсы
Dialogue: 0,0:39:44.88,0:39:48.12,Default,,0,0,0,,Барлығы бірнеше борышкерлерге қарсы
Dialogue: 0,0:39:48.12,0:39:51.19,Default,,0,0,0,,Сізде қандай бейне бар?
Dialogue: 0,0:39:51.19,0:39:53.25,Default,,0,0,0,,Бұл туралы не деуге болады? Ха!
Dialogue: 0,0:39:53.25,0:39:57.56,Default,,0,0,0,,Иә... Бұл сөзді қолданғаным үшін кешіріңіз, бірақ бұл қоқыс па?
Dialogue: 0,0:39:57.56,0:40:01.23,Default,,0,0,0,,Иә, бірақ нақты борышкер
Dialogue: 0,0:40:01.23,0:40:05.93,Default,,0,0,0,,Көңілді сөзбен айтып жеткізу мүмкін емес, қызықсыз.
Dialogue: 0,0:40:05.93,0:40:11.51,Default,,0,0,0,,Күтілетін әрекетті орындаңыз
Dialogue: 0,0:40:11.51,0:40:14.61,Default,,0,0,0,,Жарайды, мен мұны дәлелдеу үшін келдім.
Dialogue: 0,0:40:14.61,0:40:17.48,Default,,0,0,0,,Шынайы адамнан есту жылдамырақ болар еді.
Dialogue: 0,0:40:17.48,0:40:19.48,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:40:22.65,0:40:24.75,Default,,0,0,0,,Сәлем
Dialogue: 0,0:40:32.26,0:40:34.26,Default,,0,0,0,,Хехе
Dialogue: 0,0:40:36.56,0:40:40.67,Default,,0,0,0,,Сізге таныстыруға рұқсат етіңіз: 3,8 миллион иенден астам қарыз
Dialogue: 0,0:40:40.67,0:40:45.54,Default,,0,0,0,,Осы шақтағы көп борышқорлар
Dialogue: 0,0:40:45.54,0:40:47.54,Default,,0,0,0,,Бұл Ватанабе-кун.
Dialogue: 0,0:40:47.54,0:40:49.54,Default,,0,0,0,,Бұл Ватанабе.
Dialogue: 0,0:40:53.38,0:40:58.32,Default,,0,0,0,,Енді мен сізге оның қоқыс эпизодына байланысты сұрақ қоямын.
Dialogue: 0,0:40:58.32,0:41:01.42,Default,,0,0,0,,Барлығы көп борышкерге жауап беру туралы ойлайды
Dialogue: 0,0:41:01.42,0:41:04.03,Default,,0,0,0,,Түсінігіңді тереңдетуіңді қалаймын.
Dialogue: 0,0:41:04.03,0:41:06.99,Default,,0,0,0,,Сонымен бірінші сұрақ
Dialogue: 0,0:41:06.99,0:41:09.16,Default,,0,0,0,,Негізі Ватанабе-кун осылай көрінеді
Dialogue: 0,0:41:09.16,0:41:12.90,Default,,0,0,0,,Туысқанның байланысы арқылы жұмысқа тұру тәжірибем бар.
Dialogue: 0,0:41:12.90,0:41:17.24,Default,,0,0,0,,Алайда көп ұзамай оның компания ақшасын пачинко машиналарына жұмсағаны белгілі болды.
Dialogue: 0,0:41:17.24,0:41:20.74,Default,,0,0,0,,Менің бастығым жұмысқа қайта келуге шақырды.
Dialogue: 0,0:41:20.74,0:41:25.41,Default,,0,0,0,,Енді, бұдан кейін Ватанабе-кун не істеді?
Dialogue: 0,0:41:25.41,0:41:28.25,Default,,0,0,0,,Иә, дереу жұмысқа оралыңыз және догеза...
Dialogue: 0,0:41:28.25,0:41:30.25,Default,,0,0,0,,Иә
Dialogue: 0,0:41:30.25,0:41:33.65,Default,,0,0,0,,«Мәселеден құтылу үшін үйге қайттың»?
Dialogue: 0,0:41:33.65,0:41:36.06,Default,,0,0,0,,Жоқ... бұл рас.
Dialogue: 0,0:41:36.06,0:41:39.19,Default,,0,0,0,,Хехе, онда Ватанабе мырза, дұрыс жауап.
Dialogue: 0,0:41:39.19,0:41:44.20,Default,,0,0,0,,Иә «Мен соңғы пойызға дейін Yamanote желісінде болдым».
Dialogue: 0,0:41:44.20,0:41:47.80,Default,,0,0,0,,Иә? Yamanote Line... үнемі шеңбер бойымен жүреді ме?
Dialogue: 0,0:41:47.80,0:41:49.87,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:41:49.87,0:41:52.81,Default,,0,0,0,,Мен осындай мағынасыз нәрсені істегенді жөн көремін.
Dialogue: 0,0:41:52.81,0:41:55.01,Default,,0,0,0,,Үйге барған дұрыс
Dialogue: 0,0:41:55.01,0:41:58.65,Default,,0,0,0,,Бірақ үйге бару өте жаман.
Dialogue: 0,0:41:58.65,0:42:01.45,Default,,0,0,0,,Алайда мен жұмысқа қайта барғым келмейді.
Dialogue: 0,0:42:01.45,0:42:03.68,Default,,0,0,0,,Бұл жалғыз жол
Dialogue: 0,0:42:03.68,0:42:06.49,Default,,0,0,0,,Хехехе 2-сұрақ
Dialogue: 0,0:42:06.49,0:42:10.99,Default,,0,0,0,,Ватанабенің қарызын өтеу үшін ол туыстарынан қарызға ақша алды.
Dialogue: 0,0:42:10.99,0:42:14.53,Default,,0,0,0,,2 миллион ана жинады
Dialogue: 0,0:42:14.53,0:42:17.20,Default,,0,0,0,,Ватанабе ақшаны ат жарысына жұмсады.
Dialogue: 0,0:42:17.20,0:42:20.67,Default,,0,0,0,,Мен барлық ақшаны ұрлап үлгердім.
Dialogue: 0,0:42:20.67,0:42:24.07,Default,,0,0,0,,Енді неге олай істедің?
Dialogue: 0,0:42:24.07,0:42:26.47,Default,,0,0,0,,Қандай да бір себептермен ештеңе...
Dialogue: 0,0:42:26.47,0:42:29.44,Default,,0,0,0,,Ха, мен жеңдім және оны көбейтуге тырыстым.
Dialogue: 0,0:42:29.44,0:42:32.78,Default,,0,0,0,,Хехе, Ватанабе-кун
Dialogue: 0,0:42:32.78,0:42:35.05,Default,,0,0,0,,Менің хоббиім - ат жарысы.
Dialogue: 0,0:42:35.05,0:42:37.32,Default,,0,0,0,,Сізге жылқы ұнайды, солай ма?
Dialogue: 0,0:42:37.32,0:42:41.76,Default,,0,0,0,,Жоқ, жоқ, жоқ, бұл хобби немесе ұнату туралы емес.
Dialogue: 0,0:42:41.76,0:42:45.69,Default,,0,0,0,,Бірақ бұл кезеңде сіз суық тиюіңіз немесе кілттеріңізді жоғалтуыңыз мүмкін.
Dialogue: 0,0:42:45.69,0:42:48.13,Default,,0,0,0,,Өйткені жағымсыз нәрселер көп болды.
Dialogue: 0,0:42:48.13,0:42:52.73,Default,,0,0,0,,Бұл қарқынның өзгеруі ме, әлде өзіңіз үшін сыйақы ма?
Dialogue: 0,0:42:54.84,0:42:59.57,Default,,0,0,0,,Хехехе мен әлі барамын.3-сұрақ
Dialogue: 0,0:42:59.57,0:43:03.31,Default,,0,0,0,,Өйткені Эндоның борышкерлер туралы лекциясы болды
Dialogue: 0,0:43:03.31,0:43:07.58,Default,,0,0,0,,Бірнеше сағатта аяқталды
Dialogue: 0,0:43:07.58,0:43:12.22,Default,,0,0,0,,Келесі күні тас, қағаз, қайшы жаттығулары шектелді
Dialogue: 0,0:43:12.22,0:43:15.16,Default,,0,0,0,,2-ші күн
Dialogue: 0,0:43:15.16,0:43:19.53,Default,,0,0,0,,Қайырлы таң Эндо Бұл қалай аяқталды?
Dialogue: 0,0:43:19.53,0:43:22.56,Default,,0,0,0,,Хаха, бәрі тамаша.
Dialogue: 0,0:43:22.56,0:43:28.30,Default,,0,0,0,,Олардың барлығы лайықты бірнеше борышкерлерге айналды.
Dialogue: 0,0:43:28.30,0:43:31.07,Default,,0,0,0,,О, сен келген сияқтысың.
Dialogue: 0,0:43:31.07,0:43:34.28,Default,,0,0,0,,Шамасы, бір топ қоқыс.
Dialogue: 0,0:43:34.28,0:43:36.28,Default,,0,0,0,,Гррр…
Dialogue: 0,0:43:43.82,0:43:45.82,Default,,0,0,0,,Ах
Dialogue: 0,0:43:52.53,0:43:54.56,Default,,0,0,0,,О, жарайды ма?
Dialogue: 0,0:43:54.56,0:43:57.70,Default,,0,0,0,,Бұл репетиция болса да, мен бұл нақты қойылым деп ойладым.
Dialogue: 0,0:43:57.70,0:44:00.50,Default,,0,0,0,,Бар күш-жігеріңді жұмсауыңды қалаймын.
Dialogue: 0,0:44:00.50,0:44:02.57,Default,,0,0,0,,Неліктен? Ах...
Dialogue: 0,0:44:02.57,0:44:06.27,Default,,0,0,0,,Неліктен маған көп жұмыс істеу керек?
Dialogue: 0,0:44:06.27,0:44:11.11,Default,,0,0,0,,Ах... хехехе мен түсіндім.
Dialogue: 0,0:44:11.11,0:44:14.62,Default,,0,0,0,,Бұл сөзсіз қоқыс. Әдеттегі қоқыс ескертуі.
Dialogue: 0,0:44:14.62,0:44:19.05,Default,,0,0,0,,Біз репетицияның шегінен өттік, Эндо.
Dialogue: 0,0:44:19.05,0:44:21.52,Default,,0,0,0,,Хехе
Dialogue: 0,0:44:21.52,0:44:23.59,Default,,0,0,0,,Ым?
Dialogue: 0,0:44:23.59,0:44:26.96,Default,,0,0,0,,Менің ішім ауырып тұр, үйге барсам болады ма? иә?
Dialogue: 0,0:44:26.96,0:44:29.33,Default,,0,0,0,,Сосын мен де
Dialogue: 0,0:44:29.33,0:44:32.33,Default,,0,0,0,,Қалай болғанда да, қайта бөлу
Dialogue: 0,0:44:32.33,0:44:35.84,Default,,0,0,0,,Дайындықтың 2-ші күнін бастау
Dialogue: 0,0:44:35.84,0:44:38.51,Default,,0,0,0,,Жануар демі: жетінші форма
Dialogue: 0,0:44:38.51,0:44:41.31,Default,,0,0,0,,１ ２ ３ ４
Dialogue: 0,0:44:41.31,0:44:45.61,Default,,0,0,0,,«Үй жануары танымал жарнамадағы танымал адамнан 5000 доллар алады».
Dialogue: 0,0:44:45.61,0:44:47.72,Default,,0,0,0,,5000 доллар жасады
Dialogue: 0,0:44:47.72,0:44:49.72,Default,,0,0,0,,Иә Банктен
Dialogue: 0,0:44:53.55,0:44:57.16,Default,,0,0,0,,Не... бұл балалар не істеп жатыр?
Dialogue: 0,0:44:57.16,0:44:59.49,Default,,0,0,0,,Бұл үстел ойыны, мен түсінемін.
Dialogue: 0,0:44:59.49,0:45:02.03,Default,,0,0,0,,Цк, мен көмектесе алмаймын, Хигаши.
Dialogue: 0,0:45:02.03,0:45:05.73,Default,,0,0,0,,Ха, оны әкел.
Dialogue: 0,0:45:05.73,0:45:07.74,Default,,0,0,0,,Бірнеше минуттан кейін
Dialogue: 0,0:45:07.74,0:45:11.67,Default,,0,0,0,,А, мен бір маңызды нәрсені айтуды ұмытып кетіппін.
Dialogue: 0,0:45:11.67,0:45:16.34,Default,,0,0,0,,Шектеулі тас-қағаз-қайшы ойынын тазалаған алғашқы 10 адам алады.
Dialogue: 0,0:45:16.34,0:45:20.05,Default,,0,0,0,,Қазіргі! Teiai арнайы таза файл
Dialogue: 0,0:45:20.05,0:45:23.85,Default,,0,0,0,,Тонегава Тауарларды тамақтандыруға шабыт
Dialogue: 0,0:45:23.85,0:45:26.59,Default,,0,0,0,,ешқандай әсер етпейді
Dialogue: 0,0:45:26.59,0:45:30.06,Default,,0,0,0,,Шамадан тыс немқұрайлылық
Dialogue: 0,0:45:30.06,0:45:32.06,Default,,0,0,0,,Төлем күні Акция сертификаттары туралы не деуге болады?
Dialogue: 0,0:45:32.06,0:45:35.96,Default,,0,0,0,,Сатып алмаңыз... онда
Dialogue: 0,0:45:35.96,0:45:41.40,Default,,0,0,0,,Clear File Plus арнайы Quo картасы
Dialogue: 0,0:45:41.40,0:45:43.50,Default,,0,0,0,,1000 иен
Dialogue: 0,0:45:43.50,0:45:46.57,Default,,0,0,0,,А, мен лотереядан 200 000 доллар ұтып алдым.
Dialogue: 0,0:45:46.57,0:45:50.48,Default,,0,0,0,,Қызығушылық шайтандық жылдамдықпен жоғалады, бұл туралы ештеңе істей алмайсыз
Dialogue: 0,0:45:50.48,0:45:52.95,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:45:52.95,0:45:55.32,Default,,0,0,0,,Бұл... бұл жігіттер хехе
Dialogue: 0,0:45:55.32,0:45:59.29,Default,,0,0,0,,Дұрыс. Өйткені, олар қазір
Dialogue: 0,0:45:59.29,0:46:04.59,Default,,0,0,0,,Бақытты отбасы және ондаған мың доллар тұратын мүлкі бар миллионер.
Dialogue: 0,0:46:04.59,0:46:09.06,Default,,0,0,0,,Сол жақтағы жігіттің жеке ұшағы бар жоғарғы лига ойыншысы.
Dialogue: 0,0:46:09.06,0:46:12.57,Default,,0,0,0,,Е, жылдық жалақы 15 миллион доллар.
Dialogue: 0,0:46:12.57,0:46:15.20,Default,,0,0,0,,Мен оянбаймын, болды.
Dialogue: 0,0:46:15.20,0:46:18.84,Default,,0,0,0,,Жоқ, жоқ, бірақ бұл ойында.
Dialogue: 0,0:46:18.84,0:46:24.15,Default,,0,0,0,,Хехе, олар қазір өмірлерінің соңына дейін қашады.
Dialogue: 0,0:46:24.15,0:46:27.31,Default,,0,0,0,,Ойын мен шындықты жартылай ажыратуға болмайды
Dialogue: 0,0:46:27.31,0:46:31.29,Default,,0,0,0,,Жоқ, негізі сол жаққа жақынырақ.
Dialogue: 0,0:46:31.29,0:46:33.79,Default,,0,0,0,,А... не істеуім керек?
Dialogue: 0,0:46:33.79,0:46:38.49,Default,,0,0,0,,Хехе, маған қалдырыңызшы.
Dialogue: 0,0:46:46.00,0:46:48.60,Default,,0,0,0,,О, сіз ақша тауып жатырсыз.
Dialogue: 0,0:46:48.60,0:46:51.24,Default,,0,0,0,,Ах... Қалай? Бұл қызық па?
Dialogue: 0,0:46:51.24,0:46:53.31,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:46:53.31,0:46:57.58,Default,,0,0,0,,Бірақ мен саған одан да қызықты ойын бар десем ше?
Dialogue: 0,0:46:57.58,0:47:00.45,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:47:00.45,0:47:03.08,Default,,0,0,0,,Бұл қандай ойын түрі? Хехе
Dialogue: 0,0:47:03.08,0:47:07.09,Default,,0,0,0,,Қоқыс пен маскүнем бір-бірінен айласын асырып, бірін-бірі төмендетеді.
Dialogue: 0,0:47:07.09,0:47:10.69,Default,,0,0,0,,Ібіліс ойыны Ах...
Dialogue: 0,0:47:10.69,0:47:14.20,Default,,0,0,0,,Иә, бірақ қиындық деңгейі жоғарырақ
Dialogue: 0,0:47:14.20,0:47:16.26,Default,,0,0,0,,Өте қатты режим
Dialogue: 0,0:47:16.26,0:47:18.87,Default,,0,0,0,,Ойын қалай аталады? Мен қызықпын
Dialogue: 0,0:47:18.87,0:47:21.34,Default,,0,0,0,,Мен оны сынап көргім келеді хехехе
Dialogue: 0,0:47:21.34,0:47:25.04,Default,,0,0,0,,Эндо күткендей, мен борышкерлермен жұмыс істеуде көп жылдық тәжірибе жинадым.
Dialogue: 0,0:47:25.04,0:47:28.44,Default,,0,0,0,,Олардың назарын аудару үшін тапқыр сөйлесу
Dialogue: 0,0:47:28.44,0:47:32.31,Default,,0,0,0,,Ойынның атын айтайын...
Dialogue: 0,0:47:32.31,0:47:35.12,Default,,0,0,0,,Иә, шектеулі тас, қағаз, қайшы
Dialogue: 0,0:47:35.12,0:47:38.49,Default,,0,0,0,,Нағыз А?
Dialogue: 0,0:47:38.49,0:47:40.79,Default,,0,0,0,,Қарсыласыңызды таныстыру
Dialogue: 0,0:47:48.70,0:47:53.10,Default,,0,0,0,,Мен инвестициялаған барлық компаниялар банкротқа ұшырады. Нөлдік болжау.
Dialogue: 0,0:47:53.10,0:47:56.20,Default,,0,0,0,,Инвестициялық ақымақ Омура командасы
Dialogue: 0,0:47:56.20,0:48:00.01,Default,,0,0,0,,Жылдық табысы болмаса да, көлікті өзгерту қанша тұрады?
Dialogue: 0,0:48:00.01,0:48:02.01,Default,,0,0,0,,Айына 1 миллионнан астам
Dialogue: 0,0:48:02.01,0:48:04.65,Default,,0,0,0,,Пайдаланушы Yamaguchi командасы
Dialogue: 0,0:48:04.65,0:48:09.25,Default,,0,0,0,,1980 жылдардағы өлтірушілер, олар сол кездегі мінез-құлқын ұмыта алмайды
Dialogue: 0,0:48:09.25,0:48:11.65,Default,,0,0,0,,Bubble Kawakami командасы
Dialogue: 0,0:48:11.65,0:48:15.86,Default,,0,0,0,,Көп мөлшерде тапсырыс берілген өнімдер үлкен қателік, дәмі сәйкес келмеді.
Dialogue: 0,0:48:15.86,0:48:18.86,Default,,0,0,0,,EBI Nakane командасы
Dialogue: 0,0:48:23.90,0:48:26.50,Default,,0,0,0,,Мен осындай нәрсе болуы мүмкін бе деп ойлаймын.
Dialogue: 0,0:48:26.50,0:48:30.30,Default,,0,0,0,,Борышкердің басқа түрін пайдалану арқылы жасалған
Dialogue: 0,0:48:30.30,0:48:32.64,Default,,0,0,0,,Шамамен 4 команда
Dialogue: 0,0:48:32.64,0:48:35.94,Default,,0,0,0,,Бірдей адамдар тобы болса жұмыс істемейтін жағдайлар
Dialogue: 0,0:48:35.94,0:48:38.51,Default,,0,0,0,,Егер бұл орын алса, бәрі басқаша
Dialogue: 0,0:48:38.51,0:48:41.38,Default,,0,0,0,,Еріксіздік: асығу керек
Dialogue: 0,0:48:41.38,0:48:46.32,Default,,0,0,0,,Қан жуатын командалық шайқаста...
Dialogue: 0,0:48:46.32,0:48:50.46,Default,,0,0,0,,Хехехехе Ал, жеңімпаз болады
Dialogue: 0,0:48:50.46,0:48:52.69,Default,,0,0,0,,Қай команда?
Dialogue: 0,0:48:52.69,0:48:57.26,Default,,0,0,0,,Жоқ, Limited Rock Paper Scissors бұл ойын түрі емес.
Dialogue: 0,0:48:57.26,0:49:01.07,Default,,0,0,0,,репетицияның 2-ші күні сәтсіз аяқталды
Dialogue: 0,0:49:01.07,0:49:05.01,Default,,0,0,0,,Жаңа қызметкерлерді оқыту да қайта жүктелді
Dialogue: 0,0:49:05.01,0:49:07.54,Default,,0,0,0,,Ах! Тонегава өкінішті
Dialogue: 0,0:49:07.54,0:49:10.28,Default,,0,0,0,,Жаңадан келгендер үшін өте өкінішті
Dialogue: 0,0:49:10.28,0:49:12.45,Default,,0,0,0,,Эндоның да көңілі қалды
Dialogue: 0,0:49:12.45,0:49:14.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:49:14.45,0:49:17.25,Default,,0,0,0,,Үстелдің іші де көңіл көншітпейді.
Dialogue: 0,0:49:20.42,0:49:23.02,Default,,0,0,0,,Сонда да Тонегаваға бар күшіңізді салыңыз
Dialogue: 0,0:49:23.02,0:49:26.66,Default,,0,0,0,,Тонегавадан айырылып қалмаңыз
Dialogue: 0,0:49:26.66,0:49:31.93,Default,,0,0,0,,Бұл бастық, төраға және оның қарамағындағылар арасында, қара киім.
Dialogue: 0,0:49:31.93,0:49:36.27,Default,,0,0,0,,Күрес Бұл бір адамның әңгімесі.
Dialogue: 0,0:49:36.27,0:49:40.57,Default,,0,0,0,,Юкио Тонегава орта менеджері
Dialogue: 0,0:51:19.77,0:51:22.17,Default,,0,0,0,,Келесі «Іскерлік сапар»
Dialogue: 0,0:54:06.07,0:54:08.11,Default,,0,0,0,,Токио станциясы
Dialogue: 0,0:54:08.11,0:54:11.25,Default,,0,0,0,,Токайдо Шинкансен кету және келу платформасы
Dialogue: 0,0:54:11.25,0:54:14.88,Default,,0,0,0,,7:10 Нозоми №9 Хакатаға барады
Dialogue: 0,0:54:14.88,0:54:16.88,Default,,0,0,0,,Пойыз жақында жолға шығады.
Dialogue: 0,0:54:16.88,0:54:20.92,Default,,0,0,0,,Хехе, мен Teiai-ге қосылғаныма көп жыл болды.
Dialogue: 0,0:54:20.92,0:54:25.49,Default,,0,0,0,,Фукуокаға іссапар өте сирек кездеседі.
Dialogue: 0,0:54:25.49,0:54:29.73,Default,,0,0,0,,Іссапар болса да, шағын жиналыста көрініп тұр.
Dialogue: 0,0:54:29.73,0:54:33.23,Default,,0,0,0,,Шамамен 2-3 сағатта біткен шығар
Dialogue: 0,0:54:33.23,0:54:37.07,Default,,0,0,0,,Мен бір түн боламын, қалған уақыт солай болады
Dialogue: 0,0:54:37.07,0:54:41.28,Default,,0,0,0,,Көрікті жерлерді аралау Хаката көшелерін аралап ішу
Dialogue: 0,0:54:41.28,0:54:45.28,Default,,0,0,0,,Күтпеген жерден пайда алу
Dialogue: 0,0:54:48.28,0:54:50.55,Default,,0,0,0,,Тонегава мырза
Dialogue: 0,0:54:50.55,0:54:53.45,Default,,0,0,0,,Неліктен Шинкансен? иә?
Dialogue: 0,0:54:53.45,0:54:58.76,Default,,0,0,0,,Жоқ, егер сіз Фукуокаға бара жатсаңыз, ұшақпен жүру жылдамырақ...
Dialogue: 0,0:54:58.76,0:55:02.70,Default,,0,0,0,,Хехе, қызықсыз.
Dialogue: 0,0:55:02.70,0:55:06.03,Default,,0,0,0,,Менің уақытым көп...
Dialogue: 0,0:55:06.03,0:55:09.17,Default,,0,0,0,,Жоқ, мен іссапарда болдым.
Dialogue: 0,0:55:09.17,0:55:14.34,Default,,0,0,0,,Уақытыңызды алып, саяхаттан ләззат алу босқа кетеді.
Dialogue: 0,0:55:14.34,0:55:18.68,Default,,0,0,0,,Не, Тонегава мырза, сыра алғыңыз келе ме?
Dialogue: 0,0:55:18.68,0:55:22.98,Default,,0,0,0,,Шыны керек, қазір ішсем де, кездесуге дейін ішімдікті тастап кетуім мүмкін.
Dialogue: 0,0:55:22.98,0:55:25.82,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:55:25.82,0:55:28.52,Default,,0,0,0,,Автокөліктегі сату
Dialogue: 0,0:55:28.52,0:55:33.63,Default,,0,0,0,,Кофе, шай және сэндвичке ше?
Dialogue: 0,0:55:33.63,0:55:35.86,Default,,0,0,0,,А, бір ғана нәрсе, иә.
Dialogue: 0,0:55:35.86,0:55:38.80,Default,,0,0,0,,Чикама...
Dialogue: 0,0:55:38.80,0:55:42.70,Default,,0,0,0,,Профессор Тонегаваның осы іссапарда болатынына еш күмән жоқ...
Dialogue: 0,0:55:46.41,0:55:48.94,Default,,0,0,0,,Рахмет, мен мұны дәлел ретінде айтайын деп едім.
Dialogue: 0,0:55:48.94,0:55:54.11,Default,,0,0,0,,Мен бұрын «саяхат» дегенде, мен іссапарды білдірмедім.
Dialogue: 0,0:55:54.11,0:55:56.58,Default,,0,0,0,,Үлкен іссапар болмаса да.
Dialogue: 0,0:55:56.58,0:56:00.89,Default,,0,0,0,,Сен мұнымен жақсысың ба? Жарайды ма?
Dialogue: 0,0:56:00.89,0:56:04.59,Default,,0,0,0,,Ах! Уайымдама, мен сенімдімін
Dialogue: 0,0:56:04.59,0:56:06.96,Default,,0,0,0,,20 күн қатарынан жұмыс істегеннен кейін сыра
Dialogue: 0,0:56:06.96,0:56:09.43,Default,,0,0,0,,Не? Қатарынан 20 ауысым? а?
Dialogue: 0,0:56:09.43,0:56:14.27,Default,,0,0,0,,Аа, төраға мені болмашы нәрсеге шақырады.
Dialogue: 0,0:56:14.27,0:56:20.51,Default,,0,0,0,,Мен үшін жоқ нәрсе, мысалы, демалыс күні.
Dialogue: 0,0:56:20.51,0:56:25.91,Default,,0,0,0,,Егер сіз 20 күн қатарынан жұмыс істесеңіз, бұл таңқаларлық емес.
Dialogue: 0,0:56:28.38,0:56:31.25,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:56:31.25,0:56:35.69,Default,,0,0,0,,Сәл саяхаттайтын болсаң да, жарайды.
Dialogue: 0,0:56:35.69,0:56:39.43,Default,,0,0,0,,Сыра ішкеніне кім кінәлі?
Dialogue: 0,0:56:39.43,0:56:42.53,Default,,0,0,0,,Маған тек күшті болу керек.
Dialogue: 0,0:56:42.53,0:56:45.73,Default,,0,0,0,,Тонегава мырза жеңіл жүрсін деп
Dialogue: 0,0:56:45.73,0:56:49.10,Default,,0,0,0,,Егер мен сізге еретін болсам!
Dialogue: 0,0:56:49.10,0:56:52.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:52.77,0:56:57.58,Default,,0,0,0,,Сәлем, Тонегава, қазір қайдасың?
Dialogue: 0,0:56:57.58,0:56:59.68,Default,,0,0,0,,Нуа төрағасы
Dialogue: 0,0:57:02.02,0:57:04.02,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,0:57:04.02,0:57:07.65,Default,,0,0,0,,Мен қазір Фукуокаға іссапармен бара жатырмын.
Dialogue: 0,0:57:07.65,0:57:11.56,Default,,0,0,0,,Иә, уақыт нашар болды деп ойлаймын.
Dialogue: 0,0:57:11.56,0:57:14.16,Default,,0,0,0,,Жоқ Не болды?
Dialogue: 0,0:57:14.16,0:57:20.03,Default,,0,0,0,,Каккакка, сен жиіркеніштісің, Тонегава...
Dialogue: 0,0:57:20.03,0:57:22.94,Default,,0,0,0,,Йога туралы не ойлайсыз?
Dialogue: 0,0:57:22.94,0:57:25.07,Default,,0,0,0,,Йога дегеніміз не?
Dialogue: 0,0:57:25.07,0:57:29.31,Default,,0,0,0,,Аа, шынында да, соңғы кездері белім аздап ауырып жүр.
Dialogue: 0,0:57:29.31,0:57:31.68,Default,,0,0,0,,Мен сізді зерттеуге мәжбүр еттім.
Dialogue: 0,0:57:31.68,0:57:35.52,Default,,0,0,0,,Йога жақсы сияқты.
Dialogue: 0,0:57:35.52,0:57:40.25,Default,,0,0,0,,Дегенмен, егде жастағы адамдар үшін өте қиын көптеген позалар бар.
Dialogue: 0,0:57:40.25,0:57:45.46,Default,,0,0,0,,...
Dialogue: 0,0:57:45.46,0:57:48.10,Default,,0,0,0,,Қалай ойлайсың, Тонегава?
Dialogue: 0,0:57:48.10,0:57:51.60,Default,,0,0,0,,Сіз йога бар деп ойлайсыз ба?
Dialogue: 0,0:57:56.57,0:58:01.61,Default,,0,0,0,,Төраға: Шынымды айтсам, йогамен айналысу керек пе, жоқ па.
Dialogue: 0,0:58:01.61,0:58:03.61,Default,,0,0,0,,Мен шеше алмаймын.
Dialogue: 0,0:58:03.61,0:58:05.91,Default,,0,0,0,,А? Мен мұны істей алмаймын, бірақ
Dialogue: 0,0:58:05.91,0:58:10.18,Default,,0,0,0,,Мен бір ғана нәрсені айта аламын... Тонегава, қазір уақыт.
Dialogue: 0,0:58:10.18,0:58:12.82,Default,,0,0,0,,Адалдықты жеткізу уақыты
Dialogue: 0,0:58:12.82,0:58:18.76,Default,,0,0,0,,Төрағаның белі ауырып, жүре алмай қалса да.
Dialogue: 0,0:58:18.76,0:58:21.70,Default,,0,0,0,,Бұл мүлдем маңызды емес
Dialogue: 0,0:58:21.70,0:58:24.13,Default,,0,0,0,,А? өйткені
Dialogue: 0,0:58:24.13,0:58:26.97,Default,,0,0,0,,Төраға аппаратының орнына...
Dialogue: 0,0:58:26.97,0:58:29.24,Default,,0,0,0,,(төмендеген қоңырау дыбысы)
Dialogue: 0,0:58:29.24,0:58:32.07,Default,,0,0,0,,Е... а...
Dialogue: 0,0:58:32.07,0:58:34.07,Default,,0,0,0,,Әй?
Dialogue: 0,0:58:36.11,0:58:38.91,Default,,0,0,0,,Кесу... Жоқ, жоқ.
Dialogue: 0,0:58:41.28,0:58:46.89,Default,,0,0,0,,Туннельде радиотолқындар үзілді.
Dialogue: 0,0:58:46.89,0:58:50.32,Default,,0,0,0,,Ең нашар уақыт.
Dialogue: 0,0:58:50.32,0:58:53.63,Default,,0,0,0,,Мынау...
Dialogue: 0,0:58:53.63,0:58:57.36,Default,,0,0,0,,Әй?
Dialogue: 0,0:58:57.36,0:59:00.80,Default,,0,0,0,,Маған тез арада... дереу хабарласу керек
Dialogue: 0,0:59:00.80,0:59:04.50,Default,,0,0,0,,Мо… Сәлеметсіз бе?
Dialogue: 0,0:59:04.50,0:59:10.64,Default,,0,0,0,,Тонегава мырза, сіз нені айтып тұрсыз? Бұрын не айтқыңыз келді?
Dialogue: 0,0:59:10.64,0:59:13.95,Default,,0,0,0,,Не керек, менден келген қоңырауларға тұтқаны қойма.
Dialogue: 0,0:59:13.95,0:59:18.22,Default,,0,0,0,,Жоқ... бұл дұрыс емес.
Dialogue: 0,0:59:18.22,0:59:20.75,Default,,0,0,0,,Гаа! Сондай-ақ
Dialogue: 0,0:59:20.75,0:59:25.96,Default,,0,0,0,,Көңілсіз Тонегава, үмітсіз қайта теру
Dialogue: 0,0:59:25.96,0:59:28.23,Default,,0,0,0,,Жануар демі: жетінші форма
Dialogue: 0,0:59:28.23,0:59:31.63,Default,,0,0,0,,Моши Моши Бұл қоңырау сіздің ыңғайлылығыңызға байланысты.
Dialogue: 0,0:59:31.63,0:59:33.77,Default,,0,0,0,,Қосылу мүмкін емес
Dialogue: 0,0:59:33.77,0:59:36.70,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:59:36.70,0:59:39.64,Default,,0,0,0,,Төраға күтпеген жеткізуден бас тарту
Dialogue: 0,0:59:39.64,0:59:43.41,Default,,0,0,0,,Гах гах!
Dialogue: 0,0:59:43.41,0:59:46.98,Default,,0,0,0,,Ойға келмейтін тілек!
Dialogue: 0,0:59:46.98,0:59:50.18,Default,,0,0,0,,Неліктен туннельдер көп?
Dialogue: 0,0:59:50.18,0:59:52.95,Default,,0,0,0,,Нозоми!
Dialogue: 0,0:59:52.95,0:59:57.36,Default,,0,0,0,,Тонегава Нагояда кері бұрылды
Dialogue: 0,0:59:57.36,1:00:00.23,Default,,0,0,0,,Ух... Тонегава мырза
Dialogue: 0,1:00:00.23,1:00:03.76,Default,,0,0,0,,Қайда барсаң да мен саған еремін.
Dialogue: 0,1:00:03.76,1:00:06.40,Default,,0,0,0,,Ямадзаки адамның айқайы
Dialogue: 0,1:00:06.40,1:00:09.00,Default,,0,0,0,,Қайғы көз жасы
Dialogue: 0,1:00:09.00,1:00:14.04,Default,,0,0,0,,Сыра немесе жеңіл тағамдар алғыңыз келе ме?
Dialogue: 0,1:00:14.04,1:00:18.45,Default,,0,0,0,,Тонегава төрағаның түсінбеушілігін анықтап, жиналысты аяқтайды.
Dialogue: 0,1:00:18.45,1:00:20.95,Default,,0,0,0,,Бұл өте кеш.
Dialogue: 0,1:00:20.95,1:00:24.95,Default,,0,0,0,,Осы кезде мен жай ғана ішіп бара жатқандай емеспін.
Dialogue: 0,1:00:28.09,1:00:30.16,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:00:30.16,1:00:32.63,Default,,0,0,0,,Не?
Dialogue: 0,1:00:32.63,1:00:34.63,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:00:34.63,1:00:38.33,Default,,0,0,0,,Не болды? Бұл шұғыл бизнес аудиті.
Dialogue: 0,1:00:38.33,1:00:42.03,Default,,0,0,0,,Мен тікелей Қансай филиалына барамын.
Dialogue: 0,1:02:13.63,1:02:16.13,Default,,0,0,0,,Алдымен Ямадзакиді Токиоға қайтарыңыз
Dialogue: 0,1:02:16.13,1:02:19.17,Default,,0,0,0,,Тонегава Кансай филиалына
Dialogue: 0,1:02:19.17,1:02:22.54,Default,,0,0,0,,Қысқа мерзімде бір апталық іссапар
Dialogue: 0,1:02:22.54,1:02:27.34,Default,,0,0,0,,Күтпеген Осака, тамақ жейтін қала
Dialogue: 0,1:02:27.34,1:02:31.24,Default,,0,0,0,,Қандай пайда! Гурман индульгенциясы
Dialogue: 0,1:02:31.24,1:02:33.95,Default,,0,0,0,,Алайда, шын мәнінде, И
Dialogue: 0,1:02:33.95,1:02:37.28,Default,,0,0,0,,Мен Осакадағы жақсы мейрамханалар туралы көп білмеймін.
Dialogue: 0,1:02:37.28,1:02:39.29,Default,,0,0,0,,Бірақ солай
Dialogue: 0,1:02:39.29,1:02:43.42,Default,,0,0,0,,Мұнда қара киінген біреудің айналаңызды көрсеткенін қалайсыз ба?
Dialogue: 0,1:02:43.42,1:02:48.93,Default,,0,0,0,,Ах, жақында Қансайдың іскерлік көрсеткіштері баяу болды.
Dialogue: 0,1:02:48.93,1:02:52.73,Default,,0,0,0,,Бұл Тонегава, ол бас кеңседен операцияларды тексеруге келген.
Dialogue: 0,1:02:52.73,1:02:56.84,Default,,0,0,0,,Мен осы филиалдың жұмыс кестесін дереу тексердім.
Dialogue: 0,1:02:56.84,1:03:01.81,Default,,0,0,0,,Ашығын айтқанда, ысырапшылдық өте көп.
Dialogue: 0,1:03:01.81,1:03:04.88,Default,,0,0,0,,Өнімділікті тиімдірек жақсарту үшін
Dialogue: 0,1:03:04.88,1:03:07.91,Default,,0,0,0,,Уақытты басқару кілті болып табылады
Dialogue: 0,1:03:07.91,1:03:13.31,Default,,0,0,0,,Келесі аптада біз қатаң түрде тексереміз және мұнда және мұнда нұсқаулар береміз.
Dialogue: 0,1:03:15.32,1:03:19.49,Default,,0,0,0,,Ал, өз позициямды ескере отырып, бұл қиын екенін айтуым керек.
Dialogue: 0,1:03:19.49,1:03:24.56,Default,,0,0,0,,Бұл тек жұмыс уақытында. Демалу уақыты келгенде, демалыңыз.
Dialogue: 0,1:03:24.56,1:03:28.94,Default,,0,0,0,,Басқаша айтқанда, маған ұнамайды.
Dialogue: 0,1:03:28.94,1:03:32.74,Default,,0,0,0,,Алкоголь бестен кейін!
Dialogue: 0,1:03:32.74,1:03:36.34,Default,,0,0,0,,Жақсы ауа ағынын жасаңыз
Dialogue: 0,1:03:36.34,1:03:39.35,Default,,0,0,0,,Жақсы атмосфера құрды
Dialogue: 0,1:03:39.35,1:03:41.95,Default,,0,0,0,,Енді бұл жігіттер мені оңай ішуге шақыра алады...
Dialogue: 0,1:03:41.95,1:03:44.25,Default,,0,0,0,,Ей, ақымақтар! Иіс және т.б.
Dialogue: 0,1:03:44.25,1:03:47.45,Default,,0,0,0,,Тонегава-сенсейге сәл мейірімді жүзді көрсету арқылы.
Dialogue: 0,1:03:47.45,1:03:50.32,Default,,0,0,0,,Қазір демаламын деп қателеспе.
Dialogue: 0,1:03:50.32,1:03:52.96,Default,,0,0,0,,Балалар, сендер демалуларың керек емес.
Dialogue: 0,1:03:52.96,1:03:55.86,Default,,0,0,0,,Бұл профессор Тонегавамен ғана шектелген әңгіме...
Dialogue: 0,1:03:55.86,1:04:00.27,Default,,0,0,0,,Тұрақты ауа тоқырауын жасаңыз
Dialogue: 0,1:04:00.27,1:04:03.10,Default,,0,0,0,,А... жоқ, бұл дұрыс емес... Тонегава мырза
Dialogue: 0,1:04:03.10,1:04:05.27,Default,,0,0,0,,Менің ақымақтарым кешірім сұрады.
Dialogue: 0,1:04:05.27,1:04:07.97,Default,,0,0,0,,А... жоқ, мен... ақымақтар болса ше...
Dialogue: 0,1:04:07.97,1:04:11.38,Default,,0,0,0,,Егер сіз өзіңізді дөрекі ұстасаңыз, ренжімеңіз.
Dialogue: 0,1:04:11.38,1:04:13.75,Default,,0,0,0,,Маған айналдырыңызшы.
Dialogue: 0,1:04:13.75,1:04:17.55,Default,,0,0,0,,Кейбір жағдайларда мен, Кансай филиалының менеджері Кинезаки,
Dialogue: 0,1:04:17.55,1:04:20.65,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,1:04:20.65,1:04:24.96,Default,,0,0,0,,Сен ақымақсың, жайбарақат атмосфераны бұздың.
Dialogue: 0,1:04:24.96,1:04:29.36,Default,,0,0,0,,Кинезаки есімді адамға байланысты атмосфера ең нашар.
Dialogue: 0,1:04:29.36,1:04:35.24,Default,,0,0,0,,Цк, жақсы, бір аптадан кейін атмосфера біртіндеп босайды.
Dialogue: 0,1:04:35.24,1:04:38.04,Default,,0,0,0,,Ал жетінші күн, соңғы күн
Dialogue: 0,1:04:42.14,1:04:47.41,Default,,0,0,0,,Шиеленіс атмосферасы 7 күн бойы бір секунд болса да басылмады.
Dialogue: 0,1:04:47.41,1:04:50.48,Default,,0,0,0,,Уау...
Dialogue: 0,1:04:50.48,1:04:55.39,Default,,0,0,0,,Мен... Кешіріңіз, кешіріңіз, маған үзіліс беріңізші!
Dialogue: 0,1:04:55.39,1:04:59.16,Default,,0,0,0,,Керісінше, қара киім киіп, қорқады
Dialogue: 0,1:04:59.16,1:05:03.63,Default,,0,0,0,,Жүйке күйі, шек шегінде
Dialogue: 0,1:05:03.63,1:05:08.07,Default,,0,0,0,,Цк, бұл соңғы күн ме?
Dialogue: 0,1:05:08.07,1:05:11.04,Default,,0,0,0,,Ақырында, содан бері мені ешқашан сусынға шақырған емес.
Dialogue: 0,1:05:11.04,1:05:13.27,Default,,0,0,0,,Уақыт 17:00-ден асты
Dialogue: 0,1:05:13.27,1:05:16.88,Default,,0,0,0,,Бір апталық аудиторлық жұмыс сәтті аяқталды
Dialogue: 0,1:05:16.88,1:05:20.85,Default,,0,0,0,,Ал қара киім арқылы өтетін ауа
Dialogue: 0,1:05:20.85,1:05:26.15,Default,,0,0,0,,Тонегавамен ешбір әрекеттесусіз істің аяқталуы дұрыс па?
Dialogue: 0,1:05:28.52,1:05:30.89,Default,,0,0,0,,Ей, бүгін соңғы күн.
Dialogue: 0,1:05:30.89,1:05:34.36,Default,,0,0,0,,Қоштасу тойын өткізе аламыз ба деп ойлаймын.
Dialogue: 0,1:05:34.36,1:05:37.33,Default,,0,0,0,,Идиот, егер бірдеңе дұрыс болмаса, өлтіресің.
Dialogue: 0,1:05:37.33,1:05:40.70,Default,,0,0,0,,Бірақ бірінші күні мен ішімдікті ұнатпайтынымды айттым.
Dialogue: 0,1:05:40.70,1:05:44.34,Default,,0,0,0,,Есікке қызмет көрсету, әлеуметтік сәлемдесу, т.б.
Dialogue: 0,1:05:44.34,1:05:46.57,Default,,0,0,0,,Ал, қарап көрейік. А?
Dialogue: 0,1:05:46.57,1:05:50.58,Default,,0,0,0,,Тонегава мырза, жұмыс уақыты өтіп кетті.
Dialogue: 0,1:05:50.58,1:05:53.31,Default,,0,0,0,,Мен сөзжұмбақ ойнай бастадым.
Dialogue: 0,1:05:53.31,1:05:57.18,Default,,0,0,0,,Тон өзені ағынды тартады
Dialogue: 0,1:05:57.18,1:05:59.89,Default,,0,0,0,,Сіз ішімдік ішуге шақыру күтіп тұрсыз ба?
Dialogue: 0,1:05:59.89,1:06:02.96,Default,,0,0,0,,Енді ойлап қарасам, доктор Тонегава, мен қорықпаймын.
Dialogue: 0,1:06:02.96,1:06:04.99,Default,,0,0,0,,Бұл өте мейірімді емес пе?
Dialogue: 0,1:06:04.99,1:06:07.83,Default,,0,0,0,,Қоштасу тойын өткізейік.
Dialogue: 0,1:06:07.83,1:06:09.90,Default,,0,0,0,,Ашуланған адамдар жоқ.
Dialogue: 0,1:06:09.90,1:06:12.20,Default,,0,0,0,,Олай десеңіз, бұл рас
Dialogue: 0,1:06:12.20,1:06:14.57,Default,,0,0,0,,Жарайды, жақсы ағын.
Dialogue: 0,1:06:14.57,1:06:19.41,Default,,0,0,0,,Тек итеріңіз, қыранды қоштасу кешіне шақырыңыз
Dialogue: 0,1:06:19.41,1:06:23.24,Default,,0,0,0,,Бүркіттің ілмегін тістеу
Dialogue: 0,1:06:23.24,1:06:26.78,Default,,0,0,0,,Ах! Бірақ Шинкансен үйіне бару жақсы бола ма?
Dialogue: 0,1:06:26.78,1:06:29.15,Default,,0,0,0,,Уақыт Nuaaa
Dialogue: 0,1:06:29.15,1:06:32.85,Default,,0,0,0,,А, сәлем, а, иә.
Dialogue: 0,1:06:32.85,1:06:35.52,Default,,0,0,0,,Қайтар жолдағы Шинкансен соңғысы.
Dialogue: 0,1:06:35.52,1:06:38.69,Default,,0,0,0,,Оған дейін мен мұнда уақытты өлтіруім керек.
Dialogue: 0,1:06:38.69,1:06:40.69,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,1:06:40.69,1:06:43.16,Default,,0,0,0,,Хмм, Тонегава қуу
Dialogue: 0,1:06:43.16,1:06:46.70,Default,,0,0,0,,Кез келген жағдайда ішуді қалайтын аштық мінез-құлқы
Dialogue: 0,1:06:46.70,1:06:51.34,Default,,0,0,0,,Эй, эй, сен мұны естідің бе? Иә, Тонегава мырзаны шақырыңыз.
Dialogue: 0,1:06:51.34,1:06:54.41,Default,,0,0,0,,Жарайды, қажет болды.
Dialogue: 0,1:06:54.41,1:06:57.31,Default,,0,0,0,,Жейтін балықтың үйірі
Dialogue: 0,1:06:57.31,1:06:59.85,Default,,0,0,0,,Көптен күткен ішімдік кеші
Dialogue: 0,1:06:59.85,1:07:04.65,Default,,0,0,0,,Ішімдік кештеріне тенденцияның шарықтау шегі
Dialogue: 0,1:07:04.65,1:07:08.15,Default,,0,0,0,,Тонегава мырза, осыдан кейін...
Dialogue: 0,1:07:08.15,1:07:10.32,Default,,0,0,0,,Ахондара! Ах
Dialogue: 0,1:07:10.32,1:07:13.73,Default,,0,0,0,,Жұмыс уақыты өтіп кетсе де, қанша уақыт қалды?
Dialogue: 0,1:07:13.73,1:07:17.30,Default,,0,0,0,,Неге тез үйге бармайсың? Профессор Тонегава осылай деді.
Dialogue: 0,1:07:17.30,1:07:20.70,Default,,0,0,0,,Уақытыңызды тиімді пайдаланғыңыз келе ме?
Dialogue: 0,1:07:20.70,1:07:23.80,Default,,0,0,0,,Иә, алдын ала кешіріңіз.
Dialogue: 0,1:07:23.80,1:07:25.84,Default,,0,0,0,,...соншама ақымақ
Dialogue: 0,1:07:25.84,1:07:30.01,Default,,0,0,0,,Кешіріңіз, менің тентектерім соңына дейін тоқтады.
Dialogue: 0,1:07:30.01,1:07:32.18,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,1:07:32.18,1:07:34.65,Default,,0,0,0,,Үйге қайтқанда абай болыңыз.
Dialogue: 0,1:07:34.65,1:07:36.95,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,1:07:36.95,1:07:41.69,Default,,0,0,0,,Мен бүркіттің балық аулайтын тоғанына секірдім.
Dialogue: 0,1:07:41.69,1:07:43.69,Default,,0,0,0,,Өйткені
Dialogue: 0,1:07:45.69,1:07:50.43,Default,,0,0,0,,Тонегавадан Токиоға дейін ішімдік ішусіз
Dialogue: 0,1:07:50.43,1:07:54.23,Default,,0,0,0,,Ка! Тонегава мырза, Тонегава мырза...
Dialogue: 0,1:07:54.23,1:07:57.43,Default,,0,0,0,,Мен, Кинезаки!
Dialogue: 0,1:07:59.57,1:08:03.18,Default,,0,0,0,,Уақыт Тонегаваға оралады, Осакаға іссапармен барады
Dialogue: 0,1:08:03.18,1:08:06.08,Default,,0,0,0,,Teiai Үшінші мәжіліс залы
Dialogue: 0,1:08:06.08,1:08:08.88,Default,,0,0,0,,Ямадаки мырза, құжаттарды тексеріңіз.
Dialogue: 0,1:08:08.88,1:08:11.82,Default,,0,0,0,,Жарайды, сол жерде қалдырыңыз.
Dialogue: 0,1:08:11.82,1:08:14.22,Default,,0,0,0,,Иә? Саймон
Dialogue: 0,1:08:14.22,1:08:17.89,Default,,0,0,0,,Сіз туралы бірдеңе бар...
Dialogue: 0,1:08:17.89,1:08:21.39,Default,,0,0,0,,Не... бұл үшкір аяқ киімдер?
Dialogue: 0,1:08:21.39,1:08:24.06,Default,,0,0,0,,А, байқадың ба?
Dialogue: 0,1:08:24.06,1:08:26.90,Default,,0,0,0,,Мен үшкір аяқ киім сатып алдым.
Dialogue: 0,1:08:26.90,1:08:29.54,Default,,0,0,0,,Кеше Хараджукуда Жоқ, күтпе, күт
Dialogue: 0,1:08:29.54,1:08:33.64,Default,,0,0,0,,Қара киім киіп, осындай агрессивті аяқ киім киіп жүрсең жақсы емес.
Dialogue: 0,1:08:33.64,1:08:35.98,Default,,0,0,0,,Не? ше?
Dialogue: 0,1:08:35.98,1:08:39.18,Default,,0,0,0,,Жоқ, Саймонның аяқ киімі
Dialogue: 0,1:08:39.18,1:08:41.71,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,1:08:41.71,1:08:44.05,Default,,0,0,0,,Саймон сен
Dialogue: 0,1:08:44.05,1:08:46.05,Default,,0,0,0,,Бұл аяқ киім
Dialogue: 0,1:08:46.05,1:08:48.29,Default,,0,0,0,,Не... қайдан сатып алдың?
Dialogue: 0,1:08:48.29,1:08:50.69,Default,,0,0,0,,А... Дошита мырза?
Dialogue: 0,1:08:52.96,1:08:55.06,Default,,0,0,0,,Сүйір саусақ
Dialogue: 0,1:08:55.06,1:08:57.56,Default,,0,0,0,,Саймонның қыңырлығына байланысты
Dialogue: 0,1:09:01.03,1:09:07.44,Default,,0,0,0,,Тонегава командасының бұрын-соңды болмаған сән бумы
Dialogue: 0,1:09:07.44,1:09:10.01,Default,,0,0,0,,Ямазаки Гондадан басқа
Dialogue: 0,1:09:10.01,1:09:14.18,Default,,0,0,0,,Саймон! Профессор Тонегава іссапардан оралғанда не дейді?
Dialogue: 0,1:09:14.18,1:09:16.82,Default,,0,0,0,,Хахаха! Жарайды
Dialogue: 0,1:09:16.82,1:09:19.69,Default,,0,0,0,,Бұл тым қатты, Ямадзаки мырза.
Dialogue: 0,1:09:19.69,1:09:23.49,Default,,0,0,0,,Профессор Тонегава мұндай нәрсеге ашуланатын адам емес.
Dialogue: 0,1:09:23.49,1:09:26.83,Default,,0,0,0,,Жұмысыңды дұрыс орындасаң, жақсы болуың керек.
Dialogue: 0,1:09:26.83,1:09:28.96,Default,,0,0,0,,Жоқ, бірақ адамгершіліктің бұзылуы жүректің ісі...
Dialogue: 0,1:09:28.96,1:09:31.30,Default,,0,0,0,,Хехе...
Dialogue: 0,1:09:31.30,1:09:35.17,Default,,0,0,0,,А, жоқ, кешіріңіз, бірақ...
Dialogue: 0,1:09:35.17,1:09:37.47,Default,,0,0,0,,Мен сізді директорға ұқсайды деп ойладым.
Dialogue: 0,1:09:37.47,1:09:39.91,Default,,0,0,0,,Фуфуфу а... а...
Dialogue: 0,1:09:39.91,1:09:43.91,Default,,0,0,0,,Тұрақты өзен Гонда Ямазаки
Dialogue: 0,1:09:43.91,1:09:47.41,Default,,0,0,0,,Мен түсінемін, бұл сөзсіз проблема.
Dialogue: 0,1:09:47.41,1:09:49.85,Default,,0,0,0,,Мен шындап назар аударамын.
Dialogue: 0,1:09:49.85,1:09:52.65,Default,,0,0,0,,Саймон өте жақсы.
Dialogue: 0,1:09:52.65,1:09:57.89,Default,,0,0,0,,Мен байқаусызда мысқылдық түсініктеме сияқты естіледім.
Dialogue: 0,1:09:57.89,1:10:00.29,Default,,0,0,0,,Менің ешқандай зиянды ниетім жоқ екенін біліңіз.
Dialogue: 0,1:10:00.29,1:10:02.36,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,1:10:02.36,1:10:07.17,Default,,0,0,0,,Хаха Менің ойымша, бұл ереже болғандықтан, жоқ деп айту дұрыс.
Dialogue: 0,1:10:07.17,1:10:10.90,Default,,0,0,0,,Бұл ереже ме? Не, сен білмейсің бе?
Dialogue: 0,1:10:10.90,1:10:14.67,Default,,0,0,0,,Тейайда қара киім киюдің қатаң ережелері бар.
Dialogue: 0,1:10:14.67,1:10:18.31,Default,,0,0,0,,Сондықтан мұның барлығын келтірсеңіз болғаны.
Dialogue: 0,1:10:18.31,1:10:20.31,Default,,0,0,0,,Сабыр сақта… Тек сабыр сақтасаң болғаны!
Dialogue: 0,1:10:20.31,1:10:22.65,Default,,0,0,0,,Ал, уайымдама, апта басынан...
Dialogue: 0,1:10:22.65,1:10:26.55,Default,,0,0,0,,(Қоңырауды ажырату дыбысы)
Dialogue: 0,1:10:26.55,1:10:28.96,Default,,0,0,0,,Мүмкін туннель...
Dialogue: 0,1:10:28.96,1:10:31.49,Default,,0,0,0,,Ал аптаның соңы
Dialogue: 0,1:10:31.49,1:10:33.56,Default,,0,0,0,,Саймон Ома...
Dialogue: 0,1:10:33.56,1:10:36.23,Default,,0,0,0,,Не? Не болды, Ямадзаки мырза?
Dialogue: 0,1:10:36.23,1:10:38.63,Default,,0,0,0,,Идиот! Бұл сызық
Dialogue: 0,1:10:38.63,1:10:41.27,Default,,0,0,0,,Егеуқұйрықтар мен Жұлдыздар қалай қарасаңыз да
Dialogue: 0,1:10:41.27,1:10:43.80,Default,,0,0,0,,Осы сенбі және жексенбіде салонға бардыңыз ба?
Dialogue: 0,1:10:43.80,1:10:47.14,Default,,0,0,0,,Ал, Ямадаки мырза, сіз де, Наката.
Dialogue: 0,1:10:47.14,1:10:51.18,Default,,0,0,0,,Неліктен Бекхэм шашы ұзақ уақыт бойы танымал болды?
Dialogue: 0,1:10:51.18,1:10:53.31,Default,,0,0,0,,Жоқ, бұл жұмсақ могаук...
Dialogue: 0,1:10:53.31,1:10:56.58,Default,,0,0,0,,Екеуі де жақсы! Тек Наката емес
Dialogue: 0,1:10:56.58,1:10:58.65,Default,,0,0,0,,Барлығы тым тәртіпсіз.
Dialogue: 0,1:10:58.65,1:11:01.55,Default,,0,0,0,,Сіз солай ойлайсыз ба, Гонда мырза?
Dialogue: 0,1:11:01.55,1:11:05.26,Default,,0,0,0,,Өтінемін... Ку...
Dialogue: 0,1:11:05.26,1:11:08.53,Default,,0,0,0,,Кирари...
Dialogue: 0,1:11:08.53,1:11:10.70,Default,,0,0,0,,Гонда мырза, күннен қорғайтын көзілдірік
Dialogue: 0,1:11:10.70,1:11:15.00,Default,,0,0,0,,Ха, сен маған жақсы көрінесің, Көз жасы.
Dialogue: 0,1:11:15.00,1:11:18.50,Default,,0,0,0,,Мен оны демалыс күні Хараджукуға апарғанымда, ол қатты құлап қалды.
Dialogue: 0,1:11:18.50,1:11:22.14,Default,,0,0,0,,Арг, Тонегава командасының моральдық жағдайы бұзылды.
Dialogue: 0,1:11:22.14,1:11:25.88,Default,,0,0,0,,Мұнда өте сирек кездеседі
Dialogue: 0,1:11:25.88,1:11:28.28,Default,,0,0,0,,Ямадзаки мырза, мұны да жасамаңыз.
Dialogue: 0,1:11:28.28,1:11:30.32,Default,,0,0,0,,Оларды алдыңда қиыстырып, баяу, терең дем ал.
Dialogue: 0,1:11:30.32,1:11:34.72,Default,,0,0,0,,Өйткені бұл ереже Уау.
Dialogue: 0,1:11:34.72,1:11:38.99,Default,,0,0,0,,Қаншалықты жақсы болсаң да, аут - бұл аут
Dialogue: 0,1:11:38.99,1:11:41.69,Default,,0,0,0,,Қара түсті форма дәптерінде жазылған ережелерді сақтау керек.
Dialogue: 0,1:11:41.69,1:11:44.90,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,1:11:44.90,1:11:49.20,Default,,0,0,0,,Жоқ, Ямадзаки мырза, мен оны дұрыс оқыдым ба?
Dialogue: 0,1:11:49.20,1:11:52.47,Default,,0,0,0,,Не? Осылай жазылған
Dialogue: 0,1:11:52.47,1:11:55.31,Default,,0,0,0,,«Костюм, галстук, күннен қорғайтын көзілдірік, былғары аяқ киім»
Dialogue: 0,1:11:55.31,1:11:58.48,Default,,0,0,0,,«Жоғарыда айтылғандардың барлығы қара түспен біріктірілуі керек»
Dialogue: 0,1:11:58.48,1:12:01.11,Default,,0,0,0,,А? Не айтқың келеді... аа
Dialogue: 0,1:12:01.11,1:12:04.92,Default,,0,0,0,,Эй, байқадың ба?
Dialogue: 0,1:12:04.92,1:12:07.35,Default,,0,0,0,,Жылан хаха
Dialogue: 0,1:12:07.35,1:12:10.59,Default,,0,0,0,,Иә, мен кептеліп қалған жоқпын.
Dialogue: 0,1:12:10.59,1:12:13.69,Default,,0,0,0,,Ештеңе
Dialogue: 0,1:12:24.57,1:12:28.54,Default,,0,0,0,,және бітелген сейф
Dialogue: 0,1:12:28.54,1:12:31.01,Default,,0,0,0,,Мәселе жоқ, ештеңе жоқ
Dialogue: 0,1:12:31.01,1:12:33.91,Default,,0,0,0,,Ұрлық, тонау, төбелес, өрт қою — ол жасамаған жалғыз қылмыс — кісі өлтіру еді
Dialogue: 0,1:12:33.91,1:12:36.85,Default,,0,0,0,,Хахаха мен көремін, көремін.
Dialogue: 0,1:12:36.85,1:12:39.89,Default,,0,0,0,,А, бұл мағынасы бар.
Dialogue: 0,1:12:39.89,1:12:42.96,Default,,0,0,0,,Кіші мектеп оқушысының сылтауы сияқты.
Dialogue: 0,1:12:42.96,1:12:46.13,Default,,0,0,0,,Оқиға шындық.
Dialogue: 0,1:12:46.13,1:12:48.13,Default,,0,0,0,,Ах
Dialogue: 0,1:12:48.13,1:12:52.06,Default,,0,0,0,,Ал... Тонегава мырза
Dialogue: 0,1:12:52.06,1:12:55.20,Default,,0,0,0,,Хаха, бірақ Саймон күткендей
Dialogue: 0,1:12:55.20,1:12:58.20,Default,,0,0,0,,Бұл көрініс жоқ.
Dialogue: 0,1:12:58.20,1:13:00.57,Default,,0,0,0,,Бірақ ережеде ештеңе жоқ.
Dialogue: 0,1:13:00.57,1:13:05.31,Default,,0,0,0,,Жоқ, мен ережелер туралы айтып отырған жоқпын.
Dialogue: 0,1:13:05.31,1:13:10.41,Default,,0,0,0,,Қысқасы, ол киім сәнсіз.
Dialogue: 0,1:13:12.99,1:13:17.82,Default,,0,0,0,,Түсінбедім, сендер костюм стилінің негізі сияқтысыңдар.
Dialogue: 0,1:13:17.82,1:13:19.93,Default,,0,0,0,,Ересек адам қалай киіну керек
Dialogue: 0,1:13:19.93,1:13:21.99,Default,,0,0,0,,Мысалы, мына көйлек
Dialogue: 0,1:13:21.99,1:13:24.69,Default,,0,0,0,,Уф, Букабука
Dialogue: 0,1:13:26.77,1:13:28.83,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:28.83,1:13:30.84,Default,,0,0,0,,Курткалар мен шалбарлар
Dialogue: 0,1:13:30.84,1:13:35.24,Default,,0,0,0,,Киіміңізді тігінші сізге лайықтап тігіп беруі - бұл негіздердің ең негізгісі.
Dialogue: 0,1:13:35.24,1:13:39.35,Default,,0,0,0,,Тіпті осы негіздерді ескермесеңіз және әдеттен тыс заттарды кисеңіз де.
Dialogue: 0,1:13:39.35,1:13:42.35,Default,,0,0,0,,Косплей Итадеке
Dialogue: 0,1:13:42.35,1:13:44.38,Default,,0,0,0,,Костюм стиліндегі маңызды нәрсе
Dialogue: 0,1:13:44.38,1:13:48.45,Default,,0,0,0,,Өлшем сияқты негіздерді есте ұстай отырып, оны асыра алмаңыз
Dialogue: 0,1:13:48.45,1:13:52.49,Default,,0,0,0,,Бірақ содан кейін, әдеттегідей, сәнді ештеңе жоқ.
Dialogue: 0,1:13:52.49,1:13:55.99,Default,,0,0,0,,Ха ха Ямазаки Иә
Dialogue: 0,1:14:01.27,1:14:05.17,Default,,0,0,0,,Не? Ал... Тонегава мырза
Dialogue: 0,1:14:07.21,1:14:10.24,Default,,0,0,0,,Оған қалта шаршысын салыңыз
Dialogue: 0,1:14:10.24,1:14:13.65,Default,,0,0,0,,Бұрынғыдан...
Dialogue: 0,1:14:13.65,1:14:16.85,Default,,0,0,0,,Хаха Сән деген не? Кездейсоқ
Dialogue: 0,1:14:16.85,1:14:22.15,Default,,0,0,0,,Тек осылай істеу арқылы сіз таныстық сезімін ала аласыз.
Dialogue: 0,1:14:22.15,1:14:25.52,Default,,0,0,0,,Сонымен... керемет
Dialogue: 0,1:14:25.52,1:14:30.06,Default,,0,0,0,,Ол киілді ме? Киімді киген мен болдым.
Dialogue: 0,1:14:30.06,1:14:33.43,Default,,0,0,0,,Саймон, сен бұл аяқ киімді қайдан алдың?
Dialogue: 0,1:14:33.43,1:14:35.47,Default,,0,0,0,,... Хараджуку тілінде
Dialogue: 0,1:14:35.47,1:14:38.80,Default,,0,0,0,,Хехе, сол қала бұрынғысынша ба?
Dialogue: 0,1:14:38.80,1:14:44.28,Default,,0,0,0,,Тонегава мырза, әдетте киіміңізді қайдан сатып аласыз?
Dialogue: 0,1:14:44.28,1:14:46.41,Default,,0,0,0,,Хмф, дұрыс.
Dialogue: 0,1:14:46.41,1:14:50.52,Default,,0,0,0,,Менің бүгін әлі уақытым бар.
Dialogue: 0,1:14:50.52,1:14:54.02,Default,,0,0,0,,Сіз Гинза Марунучиге барасыз ба?
Dialogue: 0,1:14:56.16,1:15:00.66,Default,,0,0,0,,Үлкендердің қадір-қасиетін көрсету үшін модерация
Dialogue: 0,1:15:00.66,1:15:06.27,Default,,0,0,0,,Бұл бастық, төраға және оның қарамағындағылар, қара киім.
Dialogue: 0,1:15:06.27,1:15:09.54,Default,,0,0,0,,Кейде жергілікті филиалдардағы адамдармен
Dialogue: 0,1:15:09.54,1:15:14.71,Default,,0,0,0,,Күрес Бұл бір адамның әңгімесі.
Dialogue: 0,1:15:14.71,1:15:19.31,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,1:16:54.41,1:16:56.71,Default,,0,0,0,,Келесі жолы «Еліктеу»
Dialogue: 0,1:19:41.61,1:19:44.28,Default,,0,0,0,,Тон өзені
Dialogue: 0,1:19:44.28,1:19:46.48,Default,,0,0,0,,Сізге телефон соғуға бола ма, төраға?
Dialogue: 0,1:19:50.18,1:19:52.62,Default,,0,0,0,,Тон өзеніне келдің бе?
Dialogue: 0,1:19:52.62,1:19:55.09,Default,,0,0,0,,Эй, ха!
Dialogue: 0,1:19:55.09,1:19:57.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:01.36,1:20:03.36,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:05.36,1:20:08.13,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:08.13,1:20:11.37,Default,,0,0,0,,Қалай ойлайсың, Тонегава?
Dialogue: 0,1:20:11.37,1:20:15.34,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз қалай ойлайсыз?
Dialogue: 0,1:20:15.34,1:20:20.78,Default,,0,0,0,,Жәндік торы доп бала жаз
Dialogue: 0,1:20:20.78,1:20:22.78,Default,,0,0,0,,Ах
Dialogue: 0,1:20:25.35,1:20:27.65,Default,,0,0,0,,Мүмкін «жазғы естеліктер»…
Dialogue: 0,1:20:27.65,1:20:29.89,Default,,0,0,0,,Менің соңымнан келе жатқан біреу бар.
Dialogue: 0,1:20:29.89,1:20:31.96,Default,,0,0,0,,Не? бүркіттің өмірі
Dialogue: 0,1:20:31.96,1:20:33.96,Default,,0,0,0,,Ах... өмір?
Dialogue: 0,1:20:35.96,1:20:39.63,Default,,0,0,0,,3 күн бұрын...
Dialogue: 0,1:20:39.63,1:20:41.63,Default,,0,0,0,,Қауіпті! сурет?
Dialogue: 0,1:20:41.63,1:20:43.64,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,1:20:43.64,1:20:47.07,Default,,0,0,0,,Сәлем! Кешіріңіз
Dialogue: 0,1:20:47.07,1:20:49.07,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,1:20:49.07,1:20:51.54,Default,,0,0,0,,Кеше де... Әй, төраға.
Dialogue: 0,1:20:51.54,1:20:54.05,Default,,0,0,0,,Сіздің арқаңызда ара бар
Dialogue: 0,1:20:54.05,1:20:56.55,Default,,0,0,0,,Ах! Хе!
Dialogue: 0,1:20:56.55,1:20:59.89,Default,,0,0,0,,ақылды айла
Dialogue: 0,1:20:59.89,1:21:03.72,Default,,0,0,0,,Енді ойлап қарасам, өткен аптада шалынып қала жаздадым.
Dialogue: 0,1:21:03.72,1:21:08.36,Default,,0,0,0,,Бұл... Тонегава байқайды
Dialogue: 0,1:21:08.36,1:21:14.10,Default,,0,0,0,,Бұл жай ғана болмашы бақытсыздықтардан туындаған паранойя.
Dialogue: 0,1:21:14.10,1:21:19.24,Default,,0,0,0,,Сонымен, Тонегава, түсіндің бе? Мен сенен не қалаймын
Dialogue: 0,1:21:19.24,1:21:21.24,Default,,0,0,0,,Иә, дереу қауіпсіздікті күшейтіңіз...
Dialogue: 0,1:21:21.24,1:21:24.34,Default,,0,0,0,,Қагемуша, мені ізде
Dialogue: 0,1:21:24.34,1:21:28.05,Default,,0,0,0,,Бүркіт және екі адам
Dialogue: 0,1:21:28.05,1:21:31.25,Default,,0,0,0,,А... Қагемуша?
Dialogue: 0,1:23:02.31,1:23:06.68,Default,,0,0,0,,Осылайша, төраға Хиодоның басым паранойясына байланысты,
Dialogue: 0,1:23:06.68,1:23:08.68,Default,,0,0,0,,Тонегава командасы басталады
Dialogue: 0,1:23:08.68,1:23:10.85,Default,,0,0,0,,Оны іздеңіз хаха
Dialogue: 0,1:23:10.85,1:23:16.32,Default,,0,0,0,,Төрағаға ұқсайтын керемет ізденіс!
Dialogue: 0,1:23:16.32,1:23:19.86,Default,,0,0,0,,Бірақ бәрі – бәрі
Dialogue: 0,1:23:19.86,1:23:23.06,Default,,0,0,0,,Жіңішке жарымжан
Dialogue: 0,1:23:26.30,1:23:29.90,Default,,0,0,0,,Ха, мен ешбір ұқсасты таба алмаймын.
Dialogue: 0,1:23:29.90,1:23:33.44,Default,,0,0,0,,Ал, олар шынымен бар ма?
Dialogue: 0,1:23:33.44,1:23:36.21,Default,,0,0,0,,Төрағаға кім ұқсайды?
Dialogue: 0,1:23:36.21,1:23:38.44,Default,,0,0,0,,Идиот! Мұны айту...
Dialogue: 0,1:23:38.44,1:23:41.48,Default,,0,0,0,,Өйткені төрағаның сол мұрны
Dialogue: 0,1:23:41.48,1:23:45.72,Default,,0,0,0,,Алдыңғы жағынан қарасаң, мұрны домалақ, бүйірінен қарасаң қатайған көрінеді.
Dialogue: 0,1:23:45.72,1:23:48.02,Default,,0,0,0,,3D туралы не деуге болады?
Dialogue: 0,1:23:48.02,1:23:51.76,Default,,0,0,0,,Фигураларды жасау мүмкін емес, сондықтан ондай адамдар жоқ.
Dialogue: 0,1:23:51.76,1:23:55.23,Default,,0,0,0,,Со-сондай Ямадзаки... о
Dialogue: 0,1:23:55.23,1:23:58.43,Default,,0,0,0,,Жарайды, тамақ ішейік.
Dialogue: 0,1:24:03.67,1:24:06.04,Default,,0,0,0,,Кешіріңіз, жақсы ма? тапсырыс
Dialogue: 0,1:24:06.04,1:24:09.34,Default,,0,0,0,,А, иә, кесте 3, тапсырыс беріңіз.
Dialogue: 0,1:24:09.34,1:24:11.34,Default,,0,0,0,,Иә
Dialogue: 0,1:24:13.55,1:24:15.91,Default,,0,0,0,,Күткеніңізге рахмет.
Dialogue: 0,1:24:15.91,1:24:17.92,Default,,0,0,0,,Ал, шамамен...
Dialogue: 0,1:24:17.92,1:24:19.92,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,1:24:22.02,1:24:24.26,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,1:24:24.26,1:24:26.63,Default,,0,0,0,,Га… Га…
Dialogue: 0,1:24:26.63,1:24:29.16,Default,,0,0,0,,Гу... Иә?
Dialogue: 0,1:24:29.16,1:24:31.96,Default,,0,0,0,,Және... Доктор Тонегава: Иә.
Dialogue: 0,1:24:35.40,1:24:39.50,Default,,0,0,0,,Қалай қарасаңыз да, төрағаға өте ұқсастық
Dialogue: 0,1:24:39.50,1:24:41.91,Default,,0,0,0,,Мұрынның пішіні де тамаша.
Dialogue: 0,1:24:41.91,1:24:44.24,Default,,0,0,0,,Қандай жақсылық
Dialogue: 0,1:24:44.24,1:24:46.61,Default,,0,0,0,,Сіздің тапсырысыңыз туралы не айтасыз? Эх...
Dialogue: 0,1:24:46.61,1:24:50.58,Default,,0,0,0,,Не? А... а, м, екі қуырылған ет пен көкөніс жиынтығы.
Dialogue: 0,1:24:50.58,1:24:53.15,Default,,0,0,0,,Айо
Dialogue: 0,1:24:53.15,1:24:56.96,Default,,0,0,0,,Шыдамдылығыңыз үшін рахмет. Күн жылы болғанша келіңіз.
Dialogue: 0,1:24:56.96,1:25:00.56,Default,,0,0,0,,бұл... иә itadakimasu
Dialogue: 0,1:25:04.16,1:25:06.66,Default,,0,0,0,,Ооо...
Dialogue: 0,1:25:09.40,1:25:12.44,Default,,0,0,0,,O… O…
Dialogue: 0,1:25:12.44,1:25:16.48,Default,,0,0,0,,Ооо!
Dialogue: 0,1:25:16.48,1:25:19.85,Default,,0,0,0,,Профессор Тонегава Иә, бұл өте қиын.
Dialogue: 0,1:25:19.85,1:25:21.88,Default,,0,0,0,,Уау, тәтті емес пе?
Dialogue: 0,1:25:21.88,1:25:25.78,Default,,0,0,0,,Учихане Толығымен пестицидсіз
Dialogue: 0,1:25:25.78,1:25:28.55,Default,,0,0,0,,Дәмдеуіш туралы не ойлайсың? сурет?
Dialogue: 0,1:25:28.55,1:25:33.73,Default,,0,0,0,,Ингредиенттердің дәмін татудың ең жақсы тәсілі тек тұз...
Dialogue: 0,1:25:33.73,1:25:36.83,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:36.83,1:25:39.90,Default,,0,0,0,,Сіз аса таңданбаған сияқтысыз.
Dialogue: 0,1:25:39.90,1:25:42.07,Default,,0,0,0,,Тұтынушы, шаршадыңыз ба?
Dialogue: 0,1:25:42.07,1:25:45.80,Default,,0,0,0,,Мен…
Dialogue: 0,1:25:45.80,1:25:49.37,Default,,0,0,0,,Сіздің жұмысыңыз қиын ба? Ах!
Dialogue: 0,1:25:49.37,1:25:52.54,Default,,0,0,0,,Аспан мен жер төңкерілсе де
Dialogue: 0,1:25:52.54,1:25:58.45,Default,,0,0,0,,Төраға Хиодо ешқашан айтпайтын сөздер.
Dialogue: 0,1:25:58.45,1:26:00.45,Default,,0,0,0,,нені білдіреді?
Dialogue: 0,1:26:00.45,1:26:03.62,Default,,0,0,0,,Еліктеу
Dialogue: 0,1:26:03.62,1:26:08.26,Default,,0,0,0,,Олар ұқсайды, бірақ...
Dialogue: 0,1:26:08.26,1:26:10.40,Default,,0,0,0,,Толығымен пестицидсіз
Dialogue: 0,1:26:10.40,1:26:14.00,Default,,0,0,0,,Шаршадыңыз ба? Сіздің жұмысыңыз қиын ба?
Dialogue: 0,1:26:14.00,1:26:16.97,Default,,0,0,0,,Жоқ Мазмұны тым әртүрлі
Dialogue: 0,1:26:16.97,1:26:20.01,Default,,0,0,0,,Доктор Тонегава, осы адаммен барайық.
Dialogue: 0,1:26:20.01,1:26:23.07,Default,,0,0,0,,Ой, бірақ... бәрібір.
Dialogue: 0,1:26:23.07,1:26:25.31,Default,,0,0,0,,Менімен бірге бұрынғы президент бар.
Dialogue: 0,1:26:25.31,1:26:30.22,Default,,0,0,0,,Төрағаның қимылын, жүріс-тұрысын, үнін жақыннан бақылап отырдым.
Dialogue: 0,1:26:30.22,1:26:35.59,Default,,0,0,0,,Төрағаға мазмұнын қайта құрайық.
Dialogue: 0,1:26:35.59,1:26:37.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:42.99,1:26:46.47,Default,,0,0,0,,Ақыры жынға ұқсайтын адамды тапты
Dialogue: 0,1:26:46.47,1:26:50.27,Default,,0,0,0,,Хонда Масаясу, яғни И
Dialogue: 0,1:26:50.27,1:26:53.10,Default,,0,0,0,,Хиодо-санның орнын алғың келе ме?
Dialogue: 0,1:26:53.10,1:26:55.91,Default,,0,0,0,,Иә, бұл солай. Хмм.
Dialogue: 0,1:26:55.91,1:26:57.98,Default,,0,0,0,,Әрине, бөлмедегі тамақтану кіреді.
Dialogue: 0,1:26:57.98,1:26:59.98,Default,,0,0,0,,Мен мұны бағалаймын.
Dialogue: 0,1:26:59.98,1:27:02.68,Default,,0,0,0,,Өтінемін, бұл адамдарға көмектесіп жатыр деп ойлаймын.
Dialogue: 0,1:27:02.68,1:27:05.62,Default,,0,0,0,,Хмм.
Dialogue: 0,1:27:05.62,1:27:07.62,Default,,0,0,0,,Кеттік, Масаян.
Dialogue: 0,1:27:07.62,1:27:11.66,Default,,0,0,0,,Не? Бірақ... Апай, жарайды, жарайды.
Dialogue: 0,1:27:11.66,1:27:14.56,Default,,0,0,0,,Қиындыққа ұшырағандарды жалғыз қалдыруға болмайды.
Dialogue: 0,1:27:14.56,1:27:18.43,Default,,0,0,0,,Ахахха апаймен жарыса алмаймын ғой.
Dialogue: 0,1:27:18.43,1:27:21.03,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,1:27:21.03,1:27:23.64,Default,,0,0,0,,Оны мына масаяға қалдырыңыз
Dialogue: 0,1:27:23.64,1:27:27.87,Default,,0,0,0,,Ия ияйй...
Dialogue: 0,1:27:27.87,1:27:32.47,Default,,0,0,0,,Осылайша, Масаян Тейайға ауыстырылды.
Dialogue: 0,1:27:34.61,1:27:37.12,Default,,0,0,0,,Бұл Масаян-саманың ерекше бөлмесі.
Dialogue: 0,1:27:37.12,1:27:39.12,Default,,0,0,0,,Yahoo
Dialogue: 0,1:27:41.22,1:27:45.12,Default,,0,0,0,,Кешіріңіз. Бұл тек мен үшін...
Dialogue: 0,1:27:45.12,1:27:47.43,Default,,0,0,0,,Не? Алақай?
Dialogue: 0,1:27:47.43,1:27:49.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:55.33,1:27:58.10,Default,,0,0,0,,О... Иә? мм...
Dialogue: 0,1:27:58.10,1:28:01.21,Default,,0,0,0,,Олай болса, Ямадаки, мен мұны саған қалдырамын.
Dialogue: 0,1:28:01.21,1:28:04.38,Default,,0,0,0,,Мен оны толтыруға жауапты боламын.
Dialogue: 0,1:28:04.38,1:28:07.68,Default,,0,0,0,,Мына кісіні қара төраға ет
Dialogue: 0,1:28:07.68,1:28:11.82,Default,,0,0,0,,Не? Қараңғы...
Dialogue: 0,1:28:11.82,1:28:14.39,Default,,0,0,0,,Ямадзаки мырза енді не істейді?
Dialogue: 0,1:28:14.39,1:28:16.99,Default,,0,0,0,,Жоқ! Президент есімде жоқ
Dialogue: 0,1:28:16.99,1:28:20.39,Default,,0,0,0,,Қара киімдердің атаулары, т.б. Мүлдем!
Dialogue: 0,1:28:20.39,1:28:22.76,Default,,0,0,0,,Не? сен маған қоңырау шалғанда
Dialogue: 0,1:28:22.76,1:28:25.46,Default,,0,0,0,,«Ой» «Бұрын» «Глассан»
Dialogue: 0,1:28:25.46,1:28:29.23,Default,,0,0,0,,Жоқ, жоқ, мен... «мен» емеспін
Dialogue: 0,1:28:29.23,1:28:32.10,Default,,0,0,0,,Бұл «қыран»!
Dialogue: 0,1:28:32.10,1:28:35.47,Default,,0,0,0,,Я... ол басталып кетті.
Dialogue: 0,1:28:35.47,1:28:37.68,Default,,0,0,0,,Төраға болу үшін арнайы дайындық
Dialogue: 0,1:28:37.68,1:28:39.68,Default,,0,0,0,,Хи хи...
Dialogue: 0,1:28:39.68,1:28:41.68,Default,,0,0,0,,Бастау
Dialogue: 0,1:28:41.68,1:28:45.25,Default,,0,0,0,,Санкциялар Санкциялар Санкциялар…
Dialogue: 0,1:28:45.25,1:28:48.35,Default,,0,0,0,,Тербелу баяу, жылдам және икемді
Dialogue: 0,1:28:48.35,1:28:54.69,Default,,0,0,0,,Ямадзакидің қатал және қатал Спартандық сыныбы
Dialogue: 0,1:28:54.69,1:28:57.06,Default,,0,0,0,,Итадаки... Иә, тоқта!
Dialogue: 0,1:28:57.06,1:29:00.10,Default,,0,0,0,,Осы кезде сіз үш қателік жібердіңіз бе?
Dialogue: 0,1:29:00.10,1:29:05.07,Default,,0,0,0,,1. Төраға «Итадакимасу» демейді.
Dialogue: 0,1:29:05.07,1:29:08.04,Default,,0,0,0,,Екі пышақ пен шанышқыны пайдаланбаңыз.
Dialogue: 0,1:29:08.04,1:29:10.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:10.11,1:29:12.21,Default,,0,0,0,,Қолды ұстау принципі
Dialogue: 0,1:29:12.21,1:29:14.21,Default,,0,0,0,,Және үш
Dialogue: 0,1:29:14.21,1:29:18.78,Default,,0,0,0,,Төрағаның аузына үнемі сіңіп тұрады.
Dialogue: 0,1:29:18.78,1:29:20.79,Default,,0,0,0,,Кукукуку
Dialogue: 0,1:29:20.79,1:29:23.79,Default,,0,0,0,,А... Иә? Аспаз Аспаз Аспаз... Аспаз
Dialogue: 0,1:29:26.99,1:29:30.83,Default,,0,0,0,,Негізінде төрағаның күлкісінің 90%-ы ка линиясы.
Dialogue: 0,1:29:30.83,1:29:35.57,Default,,0,0,0,,Какака және кукуку Гуфуфу және басқа қолданбалар да бар.
Dialogue: 0,1:29:35.57,1:29:40.74,Default,,0,0,0,,Хмм, Какака және Кукуку қолданылады...
Dialogue: 0,1:29:40.74,1:29:45.21,Default,,0,0,0,,Иә, міне, кенет менің алдымда қиналған борышкер пайда болды.
Dialogue: 0,1:29:45.21,1:29:48.48,Default,,0,0,0,,Не? сурет? Біз не істеуіміз керек, төраға?
Dialogue: 0,1:29:48.48,1:29:51.32,Default,,0,0,0,,Уф
Dialogue: 0,1:29:51.32,1:29:53.99,Default,,0,0,0,,Каккакка! Жоқ
Dialogue: 0,1:29:53.99,1:29:56.69,Default,,0,0,0,,Бұл жағдайда Кикики
Dialogue: 0,1:29:56.69,1:29:59.16,Default,,0,0,0,,Ки...Кикики қайтадан
Dialogue: 0,1:29:59.16,1:30:01.46,Default,,0,0,0,,Ібіліссіз Кикики
Dialogue: 0,1:30:01.46,1:30:05.36,Default,,0,0,0,,Дрол көбірек, Кикики
Dialogue: 0,1:30:05.36,1:30:07.37,Default,,0,0,0,,Сіз қалай ойлайсыз? Мәре қалай? Кикики
Dialogue: 0,1:30:07.37,1:30:10.47,Default,,0,0,0,,Иә, сіз әлі де шатасасыз ба?
Dialogue: 0,1:30:10.47,1:30:13.34,Default,,0,0,0,,Мен төраға болудан әлі алыспын.
Dialogue: 0,1:30:13.34,1:30:16.31,Default,,0,0,0,,Кейде сіз оны нағыз төраға деп қателесе аласыз.
Dialogue: 0,1:30:16.31,1:30:19.11,Default,,0,0,0,,Ол сізді таң қалдыратын көрініс көрсетеді.
Dialogue: 0,1:30:19.11,1:30:21.11,Default,,0,0,0,,Кикики
Dialogue: 0,1:30:21.11,1:30:25.55,Default,,0,0,0,,Менде міндетті түрде жылтыр бір нәрсе бар.
Dialogue: 0,1:30:25.55,1:30:28.52,Default,,0,0,0,,Мүмкін біз керемет Қагемүшаны жасаймыз.
Dialogue: 0,1:30:28.52,1:30:30.69,Default,,0,0,0,,Мүмкін сіз таптыңыз.
Dialogue: 0,1:30:30.69,1:30:34.09,Default,,0,0,0,,Ки Ки Ки Ки Ки Ки
Dialogue: 0,1:30:37.63,1:30:39.73,Default,,0,0,0,,Сіздің жұмысыңыз қиын ба?
Dialogue: 0,1:30:42.83,1:30:46.50,Default,,0,0,0,,Санкциялар Санкциялар Санкциялар…
Dialogue: 0,1:30:46.50,1:30:49.67,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,1:30:49.67,1:30:53.88,Default,,0,0,0,,Нағыз төраға шайтаншылырақ.
Dialogue: 0,1:30:53.88,1:30:56.55,Default,,0,0,0,,Бұл шу емес, ызың.
Dialogue: 0,1:30:56.55,1:30:59.75,Default,,0,0,0,,Қанша айтсам да, түсінемін. Сіз мотивациясыз ба?
Dialogue: 0,1:30:59.75,1:31:03.22,Default,,0,0,0,,Не істесең де, қолыңнан келмейді! Жақсы
Dialogue: 0,1:31:03.22,1:31:07.16,Default,,0,0,0,,Сізді төрағаға ұқсағаныңыз үшін әкелдім, бірақ не керек?
Dialogue: 0,1:31:07.16,1:31:12.56,Default,,0,0,0,,Демалыңыз! Орыныңыздан тұрыңыз, орныңыздан тұрыңыз, орныңыздан тұрыңыз!
Dialogue: 0,1:31:12.56,1:31:16.03,Default,,0,0,0,,Мен... мен...
Dialogue: 0,1:31:16.03,1:31:19.43,Default,,0,0,0,,Жалқау болмаңыз!
Dialogue: 0,1:31:21.51,1:31:25.54,Default,,0,0,0,,Дәл қазір ат құйрығындай икемді.
Dialogue: 0,1:31:25.54,1:31:28.55,Default,,0,0,0,,Дұрыс, қазір қандай сезімде екенін ұмытпа.
Dialogue: 0,1:31:28.55,1:31:31.55,Default,,0,0,0,,Ал... әдейі болуы мүмкін бе?
Dialogue: 0,1:31:31.55,1:31:35.72,Default,,0,0,0,,Санкция дегеніміз не? Ашу деген не?
Dialogue: 0,1:31:35.72,1:31:40.06,Default,,0,0,0,,Ашуды бақылау және үкім шығару
Dialogue: 0,1:31:40.06,1:31:43.03,Default,,0,0,0,,Осыншама қысқа мерзімде осыншама жерге жетемін деп ойламаппын.
Dialogue: 0,1:31:43.03,1:31:45.33,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,1:31:45.33,1:31:48.00,Default,,0,0,0,,Жарайды, бүгінге осы.
Dialogue: 0,1:31:48.00,1:31:51.00,Default,,0,0,0,,Себебі мен президенттің күлкісінің дискісін жасадым.
Dialogue: 0,1:31:51.00,1:31:53.00,Default,,0,0,0,,Түнде ұйықтар алдында тыңдаңыз.
Dialogue: 0,1:31:53.00,1:31:56.14,Default,,0,0,0,,Иә және бір айдан кейін
Dialogue: 0,1:31:56.14,1:31:58.48,Default,,0,0,0,,Өтінемін, Тонегава мырза.
Dialogue: 0,1:31:58.48,1:32:00.95,Default,,0,0,0,,Ах
Dialogue: 0,1:32:00.95,1:32:02.95,Default,,0,0,0,,Хе-хе-хе.
Dialogue: 0,1:32:05.08,1:32:07.35,Default,,0,0,0,,Кел, Тон өзені
Dialogue: 0,1:32:07.35,1:32:09.55,Default,,0,0,0,,Ма... Масаян?
Dialogue: 0,1:32:09.55,1:32:11.56,Default,,0,0,0,,Каккаккака
Dialogue: 0,1:32:11.56,1:32:16.09,Default,,0,0,0,,Сіздің сыртқы түріңіз ғана емес, дауысыңыз, ым-ишараңыз, үніңіз, ойыңыз да.
Dialogue: 0,1:32:16.09,1:32:18.90,Default,,0,0,0,,Біз мінсіз төраға жасадық
Dialogue: 0,1:32:18.90,1:32:23.50,Default,,0,0,0,,Жоқ, керісінше, Масаян төрағадан гөрі төраға.
Dialogue: 0,1:32:23.50,1:32:27.64,Default,,0,0,0,,Ол түпнұсқадан асып кеткен болуы мүмкін.
Dialogue: 0,1:32:27.64,1:32:30.07,Default,,0,0,0,,Төраға, түскі ас уақыты.
Dialogue: 0,1:32:30.07,1:32:32.94,Default,,0,0,0,,Иә? Өтінемін
Dialogue: 0,1:32:32.94,1:32:35.18,Default,,0,0,0,,О
Dialogue: 0,1:32:35.18,1:32:38.48,Default,,0,0,0,,Эй Ямадаки, біз оны көбірек суытуымыз керек.
Dialogue: 0,1:32:38.48,1:32:40.55,Default,,0,0,0,,Nuo
Dialogue: 0,1:32:40.55,1:32:43.05,Default,,0,0,0,,Иии!
Dialogue: 0,1:32:43.05,1:32:47.09,Default,,0,0,0,,Аа, дәл солай.
Dialogue: 0,1:32:47.09,1:32:51.23,Default,,0,0,0,,Шынымды айтсам, осы уақытқа дейін меңгеру керек пе, білмеймін.
Dialogue: 0,1:32:51.23,1:32:54.80,Default,,0,0,0,,Жарайсың Ямадаки, рахмет
Dialogue: 0,1:32:54.80,1:32:58.04,Default,,0,0,0,,Қагемуша жобасы
Dialogue: 0,1:32:58.04,1:33:01.57,Default,,0,0,0,,2 айдан кейін аяқталды!
Dialogue: 0,1:33:01.57,1:33:06.91,Default,,0,0,0,,Күшті Кагемуша Масаянның келуі
Dialogue: 0,1:33:06.91,1:33:10.22,Default,,0,0,0,,Ал келесі күні
Dialogue: 0,1:33:10.22,1:33:12.22,Default,,0,0,0,,Тон өзені
Dialogue: 0,1:33:14.45,1:33:16.82,Default,,0,0,0,,Сізге телефон соғуға бола ма, төраға?
Dialogue: 0,1:33:16.82,1:33:21.53,Default,,0,0,0,,Тонегава, мен сені не үшін шақырғанымды білесің бе?
Dialogue: 0,1:33:21.53,1:33:25.23,Default,,0,0,0,,Әрине, бұл төрағаның сұрағанының көлеңкесі...
Dialogue: 0,1:33:25.23,1:33:28.77,Default,,0,0,0,,Олай болса, оқиға жылдам болады. А?
Dialogue: 0,1:33:28.77,1:33:32.17,Default,,0,0,0,,Не? сурет? Эх...
Dialogue: 0,1:33:34.74,1:33:36.91,Default,,0,0,0,,Біреуін таңдаңыз
Dialogue: 0,1:33:36.91,1:33:39.71,Default,,0,0,0,,Әй?
Dialogue: 0,1:33:39.71,1:33:41.71,Default,,0,0,0,,Тон өзенінің суретін салдың ба?
Dialogue: 0,1:33:41.71,1:33:43.72,Default,,0,0,0,,Ах… Хаа
Dialogue: 0,1:33:43.72,1:33:47.45,Default,,0,0,0,,Мен оны естимін. Мен оны естимін.
Dialogue: 0,1:33:47.45,1:33:52.32,Default,,0,0,0,,Жүрегіңдегі дауысты жасыруға тырысасың
Dialogue: 0,1:33:52.32,1:33:55.96,Default,,0,0,0,,Сіз таңдаған карта дәл.
Dialogue: 0,1:33:55.96,1:33:57.96,Default,,0,0,0,,Үшбұрыш
Dialogue: 0,1:33:57.96,1:34:02.46,Default,,0,0,0,,Ішім, бұл мүмкін бе...
Dialogue: 0,1:34:05.10,1:34:08.17,Default,,0,0,0,,Осы кезде Тон өзенінде алдын ала ескерту бар.
Dialogue: 0,1:34:08.17,1:34:10.21,Default,,0,0,0,,Жоқ, бұл алдын ала ескерту сияқты...
Dialogue: 0,1:34:10.21,1:34:12.61,Default,,0,0,0,,Сіз қалай ойлайсыз? Жақсы
Dialogue: 0,1:34:12.61,1:34:14.61,Default,,0,0,0,,Сенім!
Dialogue: 0,1:34:14.61,1:34:19.98,Default,,0,0,0,,Төрағаның арасынан Қагемуша бум өтіп кетті
Dialogue: 0,1:34:19.98,1:34:24.28,Default,,0,0,0,,Тонегава мен оның достарының талпыныстары еш нәтиже бермейді
Dialogue: 0,1:34:26.96,1:34:31.56,Default,,0,0,0,,Сонымен... Масаян не болады?
Dialogue: 0,1:34:31.56,1:34:35.43,Default,,0,0,0,,Ямадзаки, өкінішке орай, мен сізге үйде қамқорлық жасай алмаймын.
Dialogue: 0,1:34:35.43,1:34:38.84,Default,,0,0,0,,Керемет... бірақ
Dialogue: 0,1:34:38.84,1:34:42.31,Default,,0,0,0,,Масаян...
Dialogue: 0,1:34:42.31,1:34:44.71,Default,,0,0,0,,Тонегава мырза, кешіріңіз.
Dialogue: 0,1:34:44.71,1:34:48.11,Default,,0,0,0,,Мен сіз сұраған құжаттарды әкелдім.
Dialogue: 0,1:34:48.11,1:34:50.92,Default,,0,0,0,,О, бұл керемет.
Dialogue: 0,1:34:50.92,1:34:53.25,Default,,0,0,0,,Мысалдағы Қагемуша осы ма?
Dialogue: 0,1:34:53.25,1:34:56.85,Default,,0,0,0,,Аа, дәл солай.
Dialogue: 0,1:34:59.09,1:35:02.46,Default,,0,0,0,,Не деген бум... Бұл мәселе болды.
Dialogue: 0,1:35:02.46,1:35:06.66,Default,,0,0,0,,А, жарайды, бұл менің оқиғам, оған алаңдама.
Dialogue: 0,1:35:18.04,1:35:21.81,Default,,0,0,0,,Ұйықтап жатқанда оятқаным үшін кешірім сұраймын.
Dialogue: 0,1:35:21.81,1:35:26.81,Default,,0,0,0,,Бірақ сіз жақында дәмді стейк жей аласыз, Масаян.
Dialogue: 0,1:35:30.89,1:35:34.83,Default,,0,0,0,,Аспаз, стейк қайда?
Dialogue: 0,1:35:34.83,1:35:38.10,Default,,0,0,0,,Міне. Қараңызшы, бұл стейк.
Dialogue: 0,1:35:38.10,1:35:40.10,Default,,0,0,0,,Ахахха
Dialogue: 0,1:35:42.87,1:35:45.27,Default,,0,0,0,,Ал мына жігіт
Dialogue: 0,1:35:45.27,1:35:47.27,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:52.78,1:35:54.78,Default,,0,0,0,,Хмм.
Dialogue: 0,1:36:00.15,1:36:02.79,Default,,0,0,0,,Не істесең де, қолыңнан келмейді!
Dialogue: 0,1:36:02.79,1:36:04.79,Default,,0,0,0,,Жалқау бол!
Dialogue: 0,1:36:04.79,1:36:08.33,Default,,0,0,0,,Дұрыс, қазір қандай сезімде екенін ұмытпа.
Dialogue: 0,1:36:08.33,1:36:11.43,Default,,0,0,0,,Осыншама қысқа мерзімде осыншама жерге жетемін деп ойламаппын.
Dialogue: 0,1:36:21.77,1:36:24.18,Default,,0,0,0,,Не? Сіз оны лақтырып жібердіңіз бе?
Dialogue: 0,1:36:24.18,1:36:26.18,Default,,0,0,0,,Сіз қиындыққа тап болған сияқтысыз,
Dialogue: 0,1:36:26.18,1:36:30.15,Default,,0,0,0,,Идиот! Сондықтан оны табиғатқа қайтару...
Dialogue: 0,1:36:30.15,1:36:33.35,Default,,0,0,0,,Уф, не болды, Ямадзаки? барып іздейік
Dialogue: 0,1:36:33.35,1:36:35.59,Default,,0,0,0,,Масаян қазір!
Dialogue: 0,1:36:35.59,1:36:41.46,Default,,0,0,0,,Ямадзаки мен Тонегава Масаянды іздеп, Эндоның оны тастап кеткен жеріне назар аударады.
Dialogue: 0,1:36:41.46,1:36:44.66,Default,,0,0,0,,Бірақ ешқандай анықтама жоқ
Dialogue: 0,1:36:46.73,1:36:51.40,Default,,0,0,0,,Алдыңғы жағынан қарасаң домалақ мұрынды, бүйірінен қарасаң қырлы көрінеді.
Dialogue: 0,1:36:51.40,1:36:55.17,Default,,0,0,0,,Аузы құрғаған қарт қолымен стейк жеп отыр
Dialogue: 0,1:36:55.17,1:36:57.54,Default,,0,0,0,,Сен мұнда келмедің бе?
Dialogue: 0,1:36:57.54,1:37:01.95,Default,,0,0,0,,Хахаха, мұндай адамның болуы мүмкін емес.
Dialogue: 0,1:37:01.95,1:37:04.48,Default,,0,0,0,,Сіз! Тоқта
Dialogue: 0,1:37:04.48,1:37:06.58,Default,,0,0,0,,Ямазакиді тыныштандырыңыз
Dialogue: 0,1:37:15.13,1:37:17.83,Default,,0,0,0,,Көңіліңді түсірме, Ямадзаки
Dialogue: 0,1:37:17.83,1:37:23.47,Default,,0,0,0,,Бірақ Масаянның мына найзағайда не істеп жатқаны маған таң қалды.
Dialogue: 0,1:37:23.47,1:37:26.20,Default,,0,0,0,,Шындығында, Марио — Цезардың ер адамға қоятын идеалы еді
Dialogue: 0,1:37:26.20,1:37:29.24,Default,,0,0,0,,Ах... Не болды, Ямадзаки?
Dialogue: 0,1:37:29.24,1:37:33.54,Default,,0,0,0,,Жоқ... Жоқ, дәл қазір Масаянның күлкісіне ұқсас бірдеңені естідім.
Dialogue: 0,1:37:33.54,1:37:36.61,Default,,0,0,0,,Киккикикки... Ах Масаян
Dialogue: 0,1:37:36.61,1:37:39.48,Default,,0,0,0,,Күт, тыныштал, Ямадаки
Dialogue: 0,1:37:39.48,1:37:41.52,Default,,0,0,0,,Киккикикки
Dialogue: 0,1:37:41.52,1:37:44.99,Default,,0,0,0,,Масаян!
Dialogue: 0,1:37:44.99,1:37:47.89,Default,,0,0,0,,Бұл дұрыс емес, бұл шын. Бұл төраға шын.
Dialogue: 0,1:37:47.89,1:37:50.69,Default,,0,0,0,,Киккикки киккикки Ах...
Dialogue: 0,1:37:56.37,1:37:59.57,Default,,0,0,0,,Қарашы, Ямадаки, сен суық тиіп кетесің.
Dialogue: 0,1:38:01.64,1:38:04.84,Default,,0,0,0,,Менің бөлмеме қайтайық.
Dialogue: 0,1:38:10.45,1:38:13.68,Default,,0,0,0,,Маған керек емессің, мен саған қамқор боламын.
Dialogue: 0,1:38:13.68,1:38:18.06,Default,,0,0,0,,Хехехе, Тонегава мырзаның орнына қолдарыңызды ластаңыз.
Dialogue: 0,1:38:18.06,1:38:20.66,Default,,0,0,0,,Бұл менің жұмысым.
Dialogue: 0,1:38:20.66,1:38:22.66,Default,,0,0,0,,Ha
Dialogue: 0,1:38:22.66,1:38:24.93,Default,,0,0,0,,А? Ах...
Dialogue: 0,1:38:24.93,1:38:28.33,Default,,0,0,0,,Киккикки Киккикки
Dialogue: 0,1:38:28.33,1:38:31.80,Default,,0,0,0,,А, мен естіп тұрмын.
Dialogue: 0,1:38:31.80,1:38:33.80,Default,,0,0,0,,Не болды, Ямадзаки?
Dialogue: 0,1:38:39.14,1:38:41.14,Default,,0,0,0,,Ha
Dialogue: 0,1:38:47.82,1:38:50.96,Default,,0,0,0,,Полицей,
Dialogue: 0,1:38:50.96,1:38:53.86,Default,,0,0,0,,Кикки Кикки Кикки
Dialogue: 0,1:38:53.86,1:38:55.86,Default,,0,0,0,,Ах
Dialogue: 0,1:39:04.60,1:39:09.67,Default,,0,0,0,,Масаян мен сені енді жібермеймін
Dialogue: 0,1:39:09.67,1:39:11.74,Default,,0,0,0,,Чин
Dialogue: 0,1:39:11.74,1:39:14.54,Default,,0,0,0,,Мен ол жерден жаяу кетемін деп ешқашан ойламадым.
Dialogue: 0,1:39:18.18,1:39:20.69,Default,,0,0,0,,Тонегава мырза.
Dialogue: 0,1:39:20.69,1:39:23.52,Default,,0,0,0,,Ух... өтінемін
Dialogue: 0,1:39:23.52,1:39:27.69,Default,,0,0,0,,Масаянды Тейайда осылай қалдырыңыз.
Dialogue: 0,1:39:27.69,1:39:29.69,Default,,0,0,0,,Уу...
Dialogue: 0,1:39:31.80,1:39:33.80,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:39:36.23,1:39:38.74,Default,,0,0,0,,Ха, дұрыс айтасың.
Dialogue: 0,1:39:38.74,1:39:42.61,Default,,0,0,0,,Мен саған қамқорлық жасауым керек.
Dialogue: 0,1:39:42.61,1:39:45.38,Default,,0,0,0,,Ха…
Dialogue: 0,1:39:45.38,1:39:48.98,Default,,0,0,0,,Рахмет, профессор Тонегава.
Dialogue: 0,1:39:53.15,1:39:55.82,Default,,0,0,0,,Хахаха... осылайша
Dialogue: 0,1:39:55.82,1:40:00.36,Default,,0,0,0,,Төраға Хиодоның Кагемуша көтерілісі, бұралулар мен бұрылыстар, бірақ
Dialogue: 0,1:40:00.36,1:40:02.76,Default,,0,0,0,,Әзірше тынышталыңыз
Dialogue: 0,1:40:10.17,1:40:12.20,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,1:40:12.20,1:40:14.94,Default,,0,0,0,,Сақтандыру? Сақтандыру?
Dialogue: 0,1:40:14.94,1:40:19.51,Default,,0,0,0,,Егер сіз бұл туралы ойласаңыз, бұл қайталанбайтынына кепілдік жоқ, солай ма?
Dialogue: 0,1:40:19.51,1:40:23.78,Default,,0,0,0,,Төрағаның Қагемуша бумы
Dialogue: 0,1:40:23.78,1:40:28.19,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Тонегава Жоғалтпа, Тонегава
Dialogue: 0,1:40:28.19,1:40:32.86,Default,,0,0,0,,Бұл бастық, төраға және оның қарамағындағылар арасындағы қара киім.
Dialogue: 0,1:40:32.86,1:40:37.33,Default,,0,0,0,,Күрес Бұл бір адамның әңгімесі.
Dialogue: 0,1:40:37.33,1:40:40.93,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,1:40:40.93,1:40:44.24,Default,,0,0,0,,Қайтып келсең, берген ақшамды қайтарасың ба?
Dialogue: 0,1:40:44.24,1:40:46.30,Default,,0,0,0,,Бөлмеге кірер алдында қақ деп айтқанмын ғой, иә?
Dialogue: 0,1:40:46.30,1:40:48.31,Default,,0,0,0,,Бұл
Dialogue: 0,1:40:48.31,1:40:51.81,Default,,0,0,0,,Санкция Yay Yay
Dialogue: 0,1:40:51.81,1:40:54.41,Default,,0,0,0,,Масаян Тейайда болыңыз
Dialogue: 0,1:42:29.94,1:42:32.14,Default,,0,0,0,,Келесі жолы «Шығу»
Dialogue: 0,1:45:17.47,1:45:22.51,Default,,0,0,0,,Хахаха, мен осы уақытқа дейін жеттім.
Dialogue: 0,1:45:22.51,1:45:26.01,Default,,0,0,0,,Көп қиындықты жеңіп, келер
Dialogue: 0,1:45:28.75,1:45:33.06,Default,,0,0,0,,Төраға Хиодо бұйырған шайтандық өлім ойыны
Dialogue: 0,1:45:33.06,1:45:37.13,Default,,0,0,0,,1-ші шектеулі тас, қағаз, қайшы
Dialogue: 0,1:45:37.13,1:45:42.07,Default,,0,0,0,,Хахахаха, осы уақытқа дейін барлығы керемет жұмыс жасады.
Dialogue: 0,1:45:42.07,1:45:45.47,Default,,0,0,0,,Топ басшысы ретінде мен сізге алғыс айтқым келеді.
Dialogue: 0,1:45:45.47,1:45:49.74,Default,,0,0,0,,Сыйлық ретінде бүгін бізде боулинг турнирі өтеді.
Dialogue: 0,1:45:49.74,1:45:51.98,Default,,0,0,0,,Ооо
Dialogue: 0,1:45:51.98,1:45:56.68,Default,,0,0,0,,Мен сонда барғым келеді, бірақ бұл ертең спектакльден кейін болады.
Dialogue: 0,1:45:56.68,1:45:59.38,Default,,0,0,0,,Ах... хехе
Dialogue: 0,1:45:59.38,1:46:02.59,Default,,0,0,0,,Мен бәрінің қайтадан кешіккенін қаламаймын.
Dialogue: 0,1:46:02.59,1:46:06.09,Default,,0,0,0,,Бұл туралы айтуды доғарыңыз.
Dialogue: 0,1:46:06.09,1:46:09.73,Default,,0,0,0,,Тонегава мырза 1-ші шектеулі тас, қағаз, қайшы
Dialogue: 0,1:46:09.73,1:46:12.66,Default,,0,0,0,,Оны сәтті орындайық! Тонегава мырза!
Dialogue: 0,1:46:12.66,1:46:14.67,Default,,0,0,0,,Мұғалім! мұғалім!
Dialogue: 0,1:46:14.67,1:46:17.27,Default,,0,0,0,,Ұстаз!
Dialogue: 0,1:46:17.27,1:46:20.37,Default,,0,0,0,,Мұғалім! Иә
Dialogue: 0,1:46:20.37,1:46:23.64,Default,,0,0,0,,Ынтымақ пен шаттықты арттыру
Dialogue: 0,1:46:23.64,1:46:26.84,Default,,0,0,0,,Тонегава командасы ертеңгі өнер көрсету үшін
Dialogue: 0,1:46:26.84,1:46:28.85,Default,,0,0,0,,Жақсы көріну!
Dialogue: 0,1:46:28.85,1:46:32.68,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,1:46:32.68,1:46:35.85,Default,,0,0,0,,Сәлем, Тонегава Вашижа
Dialogue: 0,1:46:35.85,1:46:38.75,Default,,0,0,0,,Не? Төраға Хиодо!
Dialogue: 0,1:46:40.92,1:46:46.56,Default,,0,0,0,,Teiai Group алып компаниясының №2 Юкио Тонегава
Dialogue: 0,1:46:46.56,1:46:49.77,Default,,0,0,0,,Бұл оның аңызының және даңқының астарында жатыр
Dialogue: 0,1:46:49.77,1:46:54.57,Default,,0,0,0,,Мен орта буын менеджері ретінде жасырын түрде қиналып, күресемін.
Dialogue: 0,1:46:54.57,1:47:01.28,Default,,0,0,0,,Ұлы адамның шағын әңгімесі.
Dialogue: 0,1:47:01.28,1:47:03.28,Default,,0,0,0,,Жарайды
Dialogue: 0,1:47:11.39,1:47:14.66,Default,,0,0,0,,Сізге телефон соғуға болады ма? Төраға Хиодо
Dialogue: 0,1:47:14.66,1:47:17.73,Default,,0,0,0,,Егер тас, қағаз, қайшы шектеулі болса, сіз дайынсыз.
Dialogue: 0,1:47:17.73,1:47:19.93,Default,,0,0,0,,Тонегава мырза
Dialogue: 0,1:47:19.93,1:47:22.77,Default,,0,0,0,,Сіз мені құрметтейсіз бе? Бүркіт туралы
Dialogue: 0,1:47:22.77,1:47:24.87,Default,,0,0,0,,Е...
Dialogue: 0,1:47:24.87,1:47:26.87,Default,,0,0,0,,Иә, бұл айтпаса да түсінікті.
Dialogue: 0,1:47:26.87,1:47:29.91,Default,,0,0,0,,Төраға – құрмет пен құрметке лайық ұлы тұлға.
Dialogue: 0,1:47:29.91,1:47:34.81,Default,,0,0,0,,Каккакка Ал, сіз кез келген нәрсені айта аласыз, егер бұл жай ғана сөз болса.
Dialogue: 0,1:47:34.81,1:47:36.81,Default,,0,0,0,,Жоқ, мен... үндемедім.
Dialogue: 0,1:47:39.42,1:47:42.32,Default,,0,0,0,,Ерінмен не айтсаң да
Dialogue: 0,1:47:42.32,1:47:44.69,Default,,0,0,0,,Жүректе, іште
Dialogue: 0,1:47:44.69,1:47:49.79,Default,,0,0,0,,Тіліңді шығарып күлмеймін деп те айта алмайсың.
Dialogue: 0,1:47:49.79,1:47:53.83,Default,,0,0,0,,Мен мұндай адамдарды көргенім сонша, мен оларды жек көремін.
Dialogue: 0,1:47:53.83,1:47:56.40,Default,,0,0,0,,Иә? Ешқашан олай емес...
Dialogue: 0,1:47:56.40,1:48:00.90,Default,,0,0,0,,Егер солай болса, мен оны қолданып көруім керек пе? сол адалдық
Dialogue: 0,1:48:00.90,1:48:03.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:48:03.31,1:48:06.18,Default,,0,0,0,,Чу адалдығыңызды сынайсыз ба?
Dialogue: 0,1:48:06.18,1:48:10.11,Default,,0,0,0,,Біз неден бастауымыз керек?
Dialogue: 0,1:48:10.11,1:48:13.18,Default,,0,0,0,,Бір күні жәндіктің үні болдың
Dialogue: 0,1:48:13.18,1:48:17.32,Default,,0,0,0,,Мен өсімдіктерге толы орманда жүрдім.
Dialogue: 0,1:48:17.32,1:48:21.43,Default,,0,0,0,,А...? Содан кейін кенеттен
Dialogue: 0,1:48:21.43,1:48:25.50,Default,,0,0,0,,Жануар шөптің артынан секіреді.
Dialogue: 0,1:48:25.50,1:48:29.83,Default,,0,0,0,,Енді ол қандай жануар?
Dialogue: 0,1:48:29.83,1:48:32.20,Default,,0,0,0,,Ио... Мен шынымен түсінбеймін.
Dialogue: 0,1:48:32.20,1:48:34.51,Default,,0,0,0,,Осы жерде төрағаны ренжітсем ше?
Dialogue: 0,1:48:34.51,1:48:36.84,Default,,0,0,0,,Ертеңгі шектеулі тас, қағаз, қайшы жойылды.
Dialogue: 0,1:48:36.84,1:48:41.11,Default,,0,0,0,,Мен тағы бір ақымақтық айта алмаймын, жауап беруім керек.
Dialogue: 0,1:48:41.11,1:48:43.98,Default,,0,0,0,,Төрағаның көңілінен шықпайтын жануарлар
Dialogue: 0,1:48:43.98,1:48:47.18,Default,,0,0,0,,Бір күні орманда кездестік.
Dialogue: 0,1:48:47.18,1:48:49.19,Default,,0,0,0,,Аю!
Dialogue: 0,1:48:49.19,1:48:51.22,Default,,0,0,0,,Бұл жауап тым орташа
Dialogue: 0,1:48:51.22,1:48:55.19,Default,,0,0,0,,Мынау төрағаның жақсы көретін...жолбарысы ма?
Dialogue: 0,1:48:55.19,1:48:58.30,Default,,0,0,0,,А-а... жоқ, егер барсаң, олар оны көреді.
Dialogue: 0,1:48:58.30,1:49:02.73,Default,,0,0,0,,Гуаа, білмеймін, не деп жауап беруім керек...
Dialogue: 0,1:49:02.73,1:49:07.30,Default,,0,0,0,,Көп ойланба, түйсігімен жауап бер
Dialogue: 0,1:49:07.30,1:49:10.84,Default,,0,0,0,,Сонымен... Енді, Қоян!
Dialogue: 0,1:49:10.84,1:49:13.28,Default,,0,0,0,,Tonegawa Entrust
Dialogue: 0,1:49:13.28,1:49:16.08,Default,,0,0,0,,Өз түйсігіңді қоянға сеніп тапсыр
Dialogue: 0,1:49:16.08,1:49:18.22,Default,,0,0,0,,Менің тағдырым
Dialogue: 0,1:49:18.22,1:49:21.29,Default,,0,0,0,,Хунг Каккакка
Dialogue: 0,1:49:21.29,1:49:23.55,Default,,0,0,0,,Мен көремін...
Dialogue: 0,1:49:23.55,1:49:26.39,Default,,0,0,0,,Тонегава мырза
Dialogue: 0,1:49:26.39,1:49:32.20,Default,,0,0,0,,Сырт келбетіне қарамастан, махаббатқа ғашық болатын адам түрі.
Dialogue: 0,1:49:32.20,1:49:36.20,Default,,0,0,0,,Ғашық па? 2-сұрақ
Dialogue: 0,1:49:36.20,1:49:39.10,Default,,0,0,0,,Ертең, сайып келгенде, театр концерті
Dialogue: 0,1:49:39.10,1:49:42.21,Default,,0,0,0,,Ертең шектеулі тас-қағаз-қайшы ойыны басталады...
Dialogue: 0,1:49:42.21,1:49:44.24,Default,,0,0,0,,Бөлмеңіз
Dialogue: 0,1:49:44.24,1:49:46.24,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,1:49:46.24,1:49:48.25,Default,,0,0,0,,Сіз қанша жерден оқыдыңыз?
Dialogue: 0,1:49:48.25,1:49:52.05,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:49:52.05,1:49:54.08,Default,,0,0,0,,Психологиялық тест?
Dialogue: 0,1:49:54.08,1:49:59.76,Default,,0,0,0,,Сіз қазір оған тәуелдісіз бе?
Dialogue: 0,1:49:59.76,1:50:03.36,Default,,0,0,0,,Спектакль айту кезінде
Dialogue: 0,1:50:03.36,1:50:09.00,Default,,0,0,0,,Сіз ханзада рөлін ойнай отырып, кенет ханшайымның рөлін көресіз.
Dialogue: 0,1:50:09.00,1:50:11.64,Default,,0,0,0,,Таң қалдырыңыз!
Dialogue: 0,1:50:11.64,1:50:15.31,Default,,0,0,0,,Енді бұл неге?
Dialogue: 0,1:50:15.31,1:50:19.28,Default,,0,0,0,,Тез жауап бер, ә...
Dialogue: 0,1:50:19.28,1:50:24.35,Default,,0,0,0,,Өйткені ол мен күткеннен үлкен еді.
Dialogue: 0,1:50:24.35,1:50:26.35,Default,,0,0,0,,Аяқ киімнің түсі қандай? сурет?
Dialogue: 0,1:50:26.35,1:50:28.99,Default,,0,0,0,,Ханшайымның киген аяқ киімі қандай түсті?
Dialogue: 0,1:50:28.99,1:50:32.52,Default,,0,0,0,,Иә... иә
Dialogue: 0,1:50:32.52,1:50:34.63,Default,,0,0,0,,Ши… ақ
Dialogue: 0,1:50:34.63,1:50:38.36,Default,,0,0,0,,Карка ка ка ка соншама?
Dialogue: 0,1:50:38.36,1:50:43.87,Default,,0,0,0,,Ей, менің аяқ киімім қартайғандықтан аппақ... Керемет екен.
Dialogue: 0,1:50:43.87,1:50:46.84,Default,,0,0,0,,Маған осылай қарадың ба?
Dialogue: 0,1:50:46.84,1:50:49.31,Default,,0,0,0,,Сен мені қатты жақсы көресің, иә...
Dialogue: 0,1:50:49.31,1:50:52.01,Default,,0,0,0,,Мынаны қарашы, ха!
Dialogue: 0,1:50:54.31,1:50:56.61,Default,,0,0,0,,Бұл тағы да дұрыс емес.
Dialogue: 0,1:50:56.61,1:50:59.55,Default,,0,0,0,,Мынау, мынау.
Dialogue: 0,1:50:59.55,1:51:03.32,Default,,0,0,0,,Не, не, не жазылған?
Dialogue: 0,1:51:03.32,1:51:05.36,Default,,0,0,0,,Ал, 3-сұрақ
Dialogue: 0,1:51:05.36,1:51:09.43,Default,,0,0,0,,Ах... жалғасы бар! Сіз ғарышкерсіз
Dialogue: 0,1:51:09.43,1:51:13.36,Default,,0,0,0,,Ғарыш кемесі ақауға байланысты апатты жағдайда қонды.
Dialogue: 0,1:51:13.36,1:51:16.90,Default,,0,0,0,,Ғарыш кемесінен шыққанда белгілі бір планета
Dialogue: 0,1:51:16.90,1:51:20.17,Default,,0,0,0,,Онда жат планеталық бар, уау
Dialogue: 0,1:51:20.17,1:51:22.31,Default,,0,0,0,,Сол планетаның тұрғындары
Dialogue: 0,1:51:22.31,1:51:27.11,Default,,0,0,0,,Енді мына бөтен планета қандай көрінеді?
Dialogue: 0,1:51:27.11,1:51:29.51,Default,,0,0,0,,3 секунд ішінде жауап беріңізші...
Dialogue: 0,1:51:29.51,1:51:32.28,Default,,0,0,0,,３ ２ １
Dialogue: 0,1:51:32.28,1:51:34.82,Default,,0,0,0,,Сегізаяқ тәрізді, аяқтары көп
Dialogue: 0,1:51:34.82,1:51:37.85,Default,,0,0,0,,Сегізаяқ тәрізді алып планеталық
Dialogue: 0,1:51:37.85,1:51:41.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:51:41.26,1:51:44.90,Default,,0,0,0,,Көңілді тон өзені
Dialogue: 0,1:51:44.90,1:51:48.63,Default,,0,0,0,,Сегізаяқ тәрізді бөтеннің түсі қандай?
Dialogue: 0,1:51:48.63,1:51:51.70,Default,,0,0,0,,Түс…
Dialogue: 0,1:51:51.70,1:51:55.64,Default,,0,0,0,,Түс… Түс… Түс…
Dialogue: 0,1:51:55.64,1:51:59.11,Default,,0,0,0,,қызыл қызыл
Dialogue: 0,1:51:59.11,1:52:01.21,Default,,0,0,0,,Қызыл қызыл
Dialogue: 0,1:52:01.21,1:52:03.41,Default,,0,0,0,,Қызыл қызыл?
Dialogue: 0,1:52:05.92,1:52:09.35,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,1:52:09.35,1:52:12.46,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,1:52:12.46,1:52:15.16,Default,,0,0,0,,Дөрекі! санкциялар санкциялары
Dialogue: 0,1:52:15.16,1:52:18.90,Default,,0,0,0,,Санкциялар! Қызыл емес...
Dialogue: 0,1:52:18.90,1:52:22.17,Default,,0,0,0,,Көк көк қате болды.
Dialogue: 0,1:52:22.17,1:52:24.17,Default,,0,0,0,,Әй?
Dialogue: 0,1:52:26.30,1:52:28.80,Default,,0,0,0,,А... бұл көк?
Dialogue: 0,1:52:32.48,1:52:34.51,Default,,0,0,0,,Көк түстің қандай түрі?
Dialogue: 0,1:52:34.51,1:52:37.65,Default,,0,0,0,,Не айтсаң да, у...
Dialogue: 0,1:52:37.65,1:52:42.09,Default,,0,0,0,,Күлгін-ish Жоқ, жоқ.
Dialogue: 0,1:52:42.09,1:52:45.89,Default,,0,0,0,,Қараңдаршы, сендер де көк күлгін екенсіңдер хаха
Dialogue: 0,1:52:47.89,1:52:50.19,Default,,0,0,0,,Уау
Dialogue: 0,1:52:55.03,1:52:58.00,Default,,0,0,0,,Не… не болды? Қорқынышты!
Dialogue: 0,1:52:58.00,1:53:01.10,Default,,0,0,0,,Көк-күлгін нені білдіреді?
Dialogue: 0,1:53:03.27,1:53:06.04,Default,,0,0,0,,Тоқта! Эх...
Dialogue: 0,1:53:06.04,1:53:09.75,Default,,0,0,0,,Мен де түрлі бұзықтарды көрдім.
Dialogue: 0,1:53:09.75,1:53:12.78,Default,,0,0,0,,Тонегава сіз...
Dialogue: 0,1:53:12.78,1:53:15.65,Default,,0,0,0,,Жеңімпаз! Ең азғын
Dialogue: 0,1:53:15.65,1:53:18.02,Default,,0,0,0,,Не? иә?
Dialogue: 0,1:53:18.02,1:53:20.56,Default,,0,0,0,,Балалар, тойлағыларың келе ме?
Dialogue: 0,1:53:20.56,1:53:23.39,Default,,0,0,0,,Га
Dialogue: 0,1:53:23.39,1:53:26.73,Default,,0,0,0,,Құттықтау Құттықтау
Dialogue: 0,1:53:26.73,1:53:28.77,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,1:53:28.77,1:53:32.77,Default,,0,0,0,,Тонегава жеңімпазын құттықтаймыз!
Dialogue: 0,1:53:32.77,1:53:36.14,Default,,0,0,0,,Шектеулі тас, қағаз, қайшы қауіпсіз ұсталады!
Dialogue: 0,1:53:36.14,1:53:38.94,Default,,0,0,0,,Мазасыздықты жеңілдету! Бірақ...
Dialogue: 0,1:53:38.94,1:53:44.05,Default,,0,0,0,,Не деді? көк-күлгін
Dialogue: 0,1:53:44.05,1:53:49.05,Default,,0,0,0,,Моямоя асқан Моямоя
Dialogue: 0,1:53:49.05,1:53:53.66,Default,,0,0,0,,Келесі күні, осы түнде, ақыры болып жатыр!
Dialogue: 0,1:53:53.66,1:53:55.96,Default,,0,0,0,,Тонегава командасының шарықтау шегі
Dialogue: 0,1:53:55.96,1:54:00.86,Default,,0,0,0,,Еске алу 1-ші шектеулі тас, қағаз, қайшы
Dialogue: 0,1:54:03.73,1:54:08.04,Default,,0,0,0,,Каккакка, ақыры келді, Тон өзені
Dialogue: 0,1:54:08.04,1:54:10.21,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,1:54:10.21,1:54:13.01,Default,,0,0,0,,Сізге кеш ұнайды деп үміттенемін.
Dialogue: 0,1:54:17.28,1:54:20.82,Default,,0,0,0,,Үміт кемесі Эспоир
Dialogue: 0,1:54:20.82,1:54:24.89,Default,,0,0,0,,Тонегава және борышкерлердің тағдыры қыл үстінде болды
Dialogue: 0,1:54:24.89,1:54:29.09,Default,,0,0,0,,Шексіз саяхат енді басталады
Dialogue: 0,1:54:39.44,1:54:44.27,Default,,0,0,0,,Тұйыққа тірелген адамдардың бір түндік құмар ойыны жиыны.
Dialogue: 0,1:54:44.27,1:54:48.41,Default,,0,0,0,,Шектеулі тас қағаз қайшы!
Dialogue: 0,1:54:48.41,1:54:51.45,Default,,0,0,0,,Баршаңызға сәттілік.
Dialogue: 0,1:54:51.45,1:54:54.55,Default,,0,0,0,,Барлығы 12 картадан тұратын тас-қағаз-қайшы ойнаңыз.
Dialogue: 0,1:54:54.55,1:54:57.59,Default,,0,0,0,,Кеудедегі жұлдыз үшін жарысайық
Dialogue: 0,1:54:57.59,1:55:01.09,Default,,0,0,0,,Миссия үшін,
Dialogue: 0,1:55:01.09,1:55:04.73,Default,,0,0,0,,Бір рет пайдаланылған карталар қорапқа салынады.
Dialogue: 0,1:55:04.73,1:55:10.33,Default,,0,0,0,,Содан кейін ол автоматты түрде жинақталады.
Dialogue: 0,1:55:10.33,1:55:13.90,Default,,0,0,0,,Электрондық хабарландыру тақтасында көрсетіледі
Dialogue: 0,1:55:13.90,1:55:15.91,Default,,0,0,0,,Уақыт шегі - 4 сағат
Dialogue: 0,1:55:15.91,1:55:20.18,Default,,0,0,0,,Жолда не болғанына қарамастан, мен ақырында 3 жұлдызды қамтамасыз еттім.
Dialogue: 0,1:55:20.18,1:55:22.88,Default,,0,0,0,,Барлық карталарды пайдалансаңыз, ұтыңыз
Dialogue: 0,1:55:22.88,1:55:25.38,Default,,0,0,0,,Бұл жай ғана ойын
Dialogue: 0,1:55:29.19,1:55:33.32,Default,,0,0,0,,Холл Мастер Тонегава ережелерді түсіндіруді аяқтағаннан кейін.
Dialogue: 0,1:55:33.32,1:55:36.16,Default,,0,0,0,,Ойын ақыры басталады
Dialogue: 0,1:55:36.16,1:55:42.16,Default,,0,0,0,,Істеріңізге сәттілік тілейміз.
Dialogue: 0,1:55:44.53,1:55:46.64,Default,,0,0,0,,Бірақ! Қалжыңдама
Dialogue: 0,1:55:46.64,1:55:49.34,Default,,0,0,0,,Мен сізден қарыз ақшаны қалай пайдалану керектігін әлі сұраған жоқпын.
Dialogue: 0,1:55:49.34,1:55:51.71,Default,,0,0,0,,Сондай-ақ жеңілген кезде не болатынын түсіндіріңіз.
Dialogue: 0,1:55:51.71,1:55:53.71,Default,,0,0,0,,Иә, иә! Корат
Dialogue: 0,1:55:53.71,1:55:56.18,Default,,0,0,0,,Дұрыстап түсіндіріп беріңізші, қария!
Dialogue: 0,1:55:56.18,1:55:59.58,Default,,0,0,0,,Ашудың дүбірі, Борышкердің қатты тойтарыс беруі
Dialogue: 0,1:56:02.15,1:56:06.55,Default,,0,0,0,,Бля! Мен сені өлтіремін, қоқыс!
Dialogue: 0,1:56:10.79,1:56:14.19,Default,,0,0,0,,Хо хо хо
Dialogue: 0,1:56:19.10,1:56:23.21,Default,,0,0,0,,Күткендей, Тонегава ренжітуден қорықпайды
Dialogue: 0,1:56:23.21,1:56:25.61,Default,,0,0,0,,Керісінше, мен күтемін деп ойладым.
Dialogue: 0,1:56:25.61,1:56:27.61,Default,,0,0,0,,Уағыз уақыты
Dialogue: 0,1:56:27.61,1:56:29.98,Default,,0,0,0,,Тәттіден бас тарт!
Dialogue: 0,1:56:29.98,1:56:34.05,Default,,0,0,0,,Шабадағы шайқаста жеңіліп, осындасың.
Dialogue: 0,1:56:34.05,1:56:39.42,Default,,0,0,0,,Былайша айтқанда, мен аспанға баспалдақты сағындым.
Dialogue: 0,1:56:39.42,1:56:43.89,Default,,0,0,0,,Енді тек жеңіске жету керек.
Dialogue: 0,1:56:43.89,1:56:47.09,Default,,0,0,0,,Егер сіз ұтпасаңыз, сіз қоқыссыз! аа...
Dialogue: 0,1:56:49.93,1:56:52.37,Default,,0,0,0,,Номо — Усуноро
Dialogue: 0,1:56:52.37,1:56:54.90,Default,,0,0,0,,Ханью тамырсыз
Dialogue: 0,1:56:54.90,1:56:58.24,Default,,0,0,0,,Ичиро - барғанды ұнатпайтын өз бетімен жүретін жігіт.
Dialogue: 0,1:56:58.24,1:57:02.61,Default,,0,0,0,,Бірақ олар ойламайтын нәрсе - бұл
Dialogue: 0,1:57:02.61,1:57:08.18,Default,,0,0,0,,Ол ерекше дарынды болғандықтан ғана емес, жеңіске жетуде.
Dialogue: 0,1:57:08.18,1:57:11.39,Default,,0,0,0,,Егер сіз жеңіліп қалсаңыз, сізге қалай қарайды?
Dialogue: 0,1:57:11.39,1:57:13.86,Default,,0,0,0,,Мен жеңуім керек
Dialogue: 0,1:57:13.86,1:57:17.16,Default,,0,0,0,,Біз жеңуіміз керек! Мен жеңуім керек!
Dialogue: 0,1:57:23.10,1:57:26.17,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,1:57:26.17,1:57:28.77,Default,,0,0,0,,Сіз жеңесіз! Жеңіске жетейік! Жеңіске жетейік!
Dialogue: 0,1:57:32.44,1:57:37.94,Default,,0,0,0,,Толық өзгеріс: Тонегава сөйлеген кезде залдағы атмосфера көтеріңкі болды.
Dialogue: 0,1:57:40.82,1:57:44.15,Default,,0,0,0,,Сол себепті
Dialogue: 0,1:57:44.15,1:57:46.16,Default,,0,0,0,,Бейбақ, маған жұлдыздарды қайтар!
Dialogue: 0,1:57:46.16,1:57:48.36,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,1:57:53.60,1:57:56.17,Default,,0,0,0,,Эй, мен бірдеңе естідім.
Dialogue: 0,1:57:56.17,1:57:58.17,Default,,0,0,0,,Бұл алаяқтық емес пе?
Dialogue: 0,1:57:58.17,1:58:01.50,Default,,0,0,0,,Мияу!
Dialogue: 0,1:58:01.50,1:58:05.34,Default,,0,0,0,,Тірі қалу және жеңімпаз болу үшін
Dialogue: 0,1:58:05.34,1:58:10.95,Default,,0,0,0,,Шын табиғаты ашылған, шіркін, күрескен, күрескен, үміт үзген.
Dialogue: 0,1:58:10.95,1:58:13.98,Default,,0,0,0,,Тозақ суреті Тозақ суреті
Dialogue: 0,1:58:13.98,1:58:17.69,Default,,0,0,0,,Тозақтың суреті!
Dialogue: 0,1:58:17.69,1:58:23.53,Default,,0,0,0,,Кааккакка керемет шынымен керемет
Dialogue: 0,1:58:23.53,1:58:26.70,Default,,0,0,0,,Юкайджа Тонегава Ха
Dialogue: 0,1:58:26.70,1:58:29.50,Default,,0,0,0,,Шешім қандай?
Dialogue: 0,1:58:29.50,1:58:32.44,Default,,0,0,0,,2-ші жиналыс 3 күннен кейін болады
Dialogue: 0,1:58:32.44,1:58:34.90,Default,,0,0,0,,Не? А... қайырлы түн
Dialogue: 0,1:58:34.90,1:58:38.07,Default,,0,0,0,,А, аа... күте тұрыңыз…
Dialogue: 0,1:58:38.07,1:58:40.21,Default,,0,0,0,,Қалай болғанда да сәтті аяқталды.
Dialogue: 0,1:58:40.21,1:58:43.41,Default,,0,0,0,,1-ші шектеулі тас, қағаз, қайшы
Dialogue: 0,1:58:49.49,1:58:52.29,Default,,0,0,0,,Керемет жұмыс! Иә?
Dialogue: 0,1:58:52.29,1:58:55.93,Default,,0,0,0,,Сіз нені айтасыз? Әрине, мен сөз сөйлеу туралы айтып отырмын.
Dialogue: 0,1:58:55.93,1:58:58.29,Default,,0,0,0,,Бұл ad-lib па?
Dialogue: 0,1:58:58.29,1:59:02.67,Default,,0,0,0,,Хехехе, бұл үлкен мәселе ме?
Dialogue: 0,1:59:02.67,1:59:06.70,Default,,0,0,0,,Мен аспанға баспалдақты сағындым.
Dialogue: 0,1:59:06.70,1:59:10.57,Default,,0,0,0,,Мен борышкерлерге айттым, бірақ олар жылы болды.
Dialogue: 0,1:59:10.57,1:59:16.41,Default,,0,0,0,,Қоқыстардың әуелден аспанға баспалдақтары жоқ.
Dialogue: 0,1:59:16.41,1:59:18.68,Default,,0,0,0,,Бұл тозақ қазанының түбі
Dialogue: 0,1:59:18.68,1:59:21.92,Default,,0,0,0,,Ой... итеріп жіберген дұрыс
Dialogue: 0,1:59:21.92,1:59:27.36,Default,,0,0,0,,Ой... Түсініп тұрмын, бірақ әлгі ғажайып нәрсе жиі шыға бермейді.
Dialogue: 0,1:59:27.36,1:59:31.36,Default,,0,0,0,,Әсіресе борышкерлердің аузын ашқан сөздер.
Dialogue: 0,1:59:31.36,1:59:35.50,Default,,0,0,0,,«Бақыт сені, мен сені төңкеріп тастаймын, қоқыс».
Dialogue: 0,1:59:35.50,1:59:37.93,Default,,0,0,0,,Бұл өте қорқынышты болды.
Dialogue: 0,1:59:37.93,1:59:42.94,Default,,0,0,0,,Жоқ, сені емес, блять.
Dialogue: 0,1:59:42.94,1:59:46.01,Default,,0,0,0,,...
Dialogue: 0,1:59:46.01,1:59:50.45,Default,,0,0,0,,…
Dialogue: 0,1:59:50.45,1:59:52.92,Default,,0,0,0,,...
Dialogue: 0,1:59:52.92,1:59:56.55,Default,,0,0,0,,...
Dialogue: 0,1:59:56.55,1:59:58.89,Default,,0,0,0,,Түнгі самал салқын...
Dialogue: 0,1:59:58.89,2:00:00.99,Default,,0,0,0,,Иә?
Dialogue: 0,2:00:00.99,2:00:04.09,Default,,0,0,0,,Мұғалімге арналған сөйлеу дегеніміз не?
Dialogue: 0,2:00:04.09,2:00:06.29,Default,,0,0,0,,Уф
Dialogue: 0,2:00:08.77,2:00:12.74,Default,,0,0,0,,Цк, сен ақымақ...
Dialogue: 0,2:00:12.74,2:00:16.44,Default,,0,0,0,,...
Dialogue: 0,2:00:16.44,2:00:18.81,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,2:00:18.81,2:00:23.38,Default,,0,0,0,,...
Dialogue: 0,2:00:23.38,2:00:26.18,Default,,0,0,0,,Таңертеңге дейін сөйлесіңіз
Dialogue: 0,2:00:30.35,2:00:32.36,Default,,0,0,0,,3 күннен кейін
Dialogue: 0,2:00:32.36,2:00:36.86,Default,,0,0,0,,２
Dialogue: 0,2:00:36.86,2:00:39.76,Default,,0,0,0,,90 адам, оның ішінде қайталағыштар
Dialogue: 0,2:00:39.76,2:00:43.33,Default,,0,0,0,,Бірге жиналып үлгерген борышкерлер
Dialogue: 0,2:00:43.33,2:00:47.57,Default,,0,0,0,,Жоқ, мен оны енді сыға алмаймын...
Dialogue: 0,2:00:47.57,2:00:50.97,Default,,0,0,0,,Төраға Хиодо күтпеген жерден ұйықтап қалды
Dialogue: 0,2:00:50.97,2:00:55.88,Default,,0,0,0,,Ширакава түнгі кемесінен арман әлеміне шығу
Dialogue: 0,2:00:55.88,2:00:58.11,Default,,0,0,0,,Енді қысым жоқ
Dialogue: 0,2:00:58.11,2:01:01.02,Default,,0,0,0,,Екінші әрекет табысқа дерлік кепілдік берді
Dialogue: 0,2:01:01.02,2:01:04.72,Default,,0,0,0,,...
Dialogue: 0,2:01:08.36,2:01:11.26,Default,,0,0,0,,Сіз сөйлей алмайсыз ба? Тонегава мырза
Dialogue: 0,2:01:14.63,2:01:17.67,Default,,0,0,0,,Жоқ…
Dialogue: 0,2:01:17.67,2:01:22.67,Default,,0,0,0,,...
Dialogue: 0,2:01:22.67,2:01:25.74,Default,,0,0,0,,Дұрыс!
Dialogue: 0,2:01:25.74,2:01:28.55,Default,,0,0,0,,Күтпеген жазатайым оқиғалар
Dialogue: 0,2:01:28.55,2:01:31.81,Default,,0,0,0,,Холл Мастер Ямадзакидің дүниеге келуі
Dialogue: 0,2:01:31.81,2:01:33.85,Default,,0,0,0,,Бірақ!
Dialogue: 0,2:01:33.85,2:01:36.59,Default,,0,0,0,,…
Dialogue: 0,2:01:36.59,2:01:38.59,Default,,0,0,0,,35
Dialogue: 0,2:01:38.59,2:01:40.66,Default,,0,0,0,,Фаа… факуюу
Dialogue: 0,2:01:40.66,2:01:43.06,Default,,0,0,0,,Ху... Факую Хух
Dialogue: 0,2:01:43.06,2:01:45.46,Default,,0,0,0,,… ５
Dialogue: 0,2:01:45.46,2:01:48.00,Default,,0,0,0,,…
Dialogue: 0,2:01:48.00,2:01:52.24,Default,,0,0,0,,...
Dialogue: 0,2:01:52.24,2:01:55.14,Default,,0,0,0,,Ах, Усуноро - Номо.
Dialogue: 0,2:01:55.14,2:01:57.24,Default,,0,0,0,,...
Dialogue: 0,2:02:03.95,2:02:06.55,Default,,0,0,0,,… (ﾏｲｸﾊｳﾘﾝｸﾞ)
Dialogue: 0,2:02:06.55,2:02:10.19,Default,,0,0,0,,...
Dialogue: 0,2:02:10.19,2:02:14.42,Default,,0,0,0,,...
Dialogue: 0,2:02:14.42,2:02:16.42,Default,,0,0,0,,Ах
Dialogue: 0,2:02:20.33,2:02:23.60,Default,,0,0,0,,ережелерді түсіндіреді
Dialogue: 0,2:02:23.60,2:02:27.57,Default,,0,0,0,,...
Dialogue: 0,2:02:27.57,2:02:31.14,Default,,0,0,0,,…
Dialogue: 0,2:02:31.14,2:02:33.94,Default,,0,0,0,,...
Dialogue: 0,2:02:33.94,2:02:37.58,Default,,0,0,0,,Бәрі ойдағыдай өткен сияқты!
Dialogue: 0,2:02:37.58,2:02:39.75,Default,,0,0,0,,Біраз күте тұрыңыз, ақшадан не пайда?
Dialogue: 0,2:02:39.75,2:02:42.25,Default,,0,0,0,,Мен жеңілген кезде не болатынын естіген жоқпын.
Dialogue: 0,2:02:42.25,2:02:46.06,Default,,0,0,0,,Иә, иә, неге! Өзіңізді мазақ етпеңіз!
Dialogue: 0,2:02:46.06,2:02:49.56,Default,,0,0,0,,Бұл осында. Жүр, жасайық.
Dialogue: 0,2:02:58.17,2:03:01.40,Default,,0,0,0,,Бля! Мен сені өлтіремін, қоқыс!
Dialogue: 0,2:03:01.40,2:03:03.40,Default,,0,0,0,,Ах...
Dialogue: 0,2:03:08.04,2:03:13.42,Default,,0,0,0,,Жарайды, шешілді! Әзірге бірінші кедергі жойылды!
Dialogue: 0,2:03:13.42,2:03:19.06,Default,,0,0,0,,Ой, балалар, Шабадағы шайқаста жеңіліп жатырсыңдар.
Dialogue: 0,2:03:19.06,2:03:22.69,Default,,0,0,0,,Енді сізге тек жеңіске жету керек!
Dialogue: 0,2:03:22.69,2:03:24.99,Default,,0,0,0,,Егер сіз ұтпасаңыз, сіз қоқыссыз!
Dialogue: 0,2:03:27.03,2:03:29.30,Default,,0,0,0,,Біз жеңуіміз керек! Бізде жеңуден басқа амал жоқ!
Dialogue: 0,2:03:29.30,2:03:31.30,Default,,0,0,0,,Біз жеңеміз! Мен жеңемін!
Dialogue: 0,2:03:31.30,2:03:33.67,Default,,0,0,0,,Біз жеңуіміз керек! шабыт
Dialogue: 0,2:03:33.67,2:03:35.67,Default,,0,0,0,,Жоғалатын итеру
Dialogue: 0,2:03:37.74,2:03:41.41,Default,,0,0,0,,Цутанай Ямадзаки рульде
Dialogue: 0,2:03:41.41,2:03:45.11,Default,,0,0,0,,Борышкерлерге бағыт-бағдар беріп, шабыттандырады
Dialogue: 0,2:03:48.58,2:03:51.42,Default,,0,0,0,,Номо Ханек…
Dialogue: 0,2:03:51.42,2:03:54.12,Default,,0,0,0,,Иә? Усуноро
Dialogue: 0,2:03:54.12,2:03:57.89,Default,,0,0,0,,I Ичиро бұл... Ичиро
Dialogue: 0,2:03:57.89,2:04:00.26,Default,,0,0,0,,Сіз өз қарқыныңызбен жүре алмайсыз!
Dialogue: 0,2:04:00.26,2:04:02.43,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,2:04:02.43,2:04:06.07,Default,,0,0,0,,Ханю...
Dialogue: 0,2:04:06.07,2:04:10.31,Default,,0,0,0,,Бұл бейбақты мазақ етпе, Ичиро. А... А?
Dialogue: 0,2:04:10.31,2:04:13.54,Default,,0,0,0,,Ичиро туралы не білесіңдер?
Dialogue: 0,2:04:13.54,2:04:16.54,Default,,0,0,0,,I. Ичиро фанаты? Бұл дұрыс, дұрыс
Dialogue: 0,2:04:18.75,2:04:22.65,Default,,0,0,0,,Конфликт Борышкердің қатал қарсылығы
Dialogue: 0,2:04:22.65,2:04:24.65,Default,,0,0,0,,Уф
Dialogue: 0,2:04:24.65,2:04:28.29,Default,,0,0,0,,Номодан кешірім сұраңыз және Ичироны кемітпеңіз.
Dialogue: 0,2:04:28.29,2:04:30.99,Default,,0,0,0,,Түсіндім, Ичиро керемет!
Dialogue: 0,2:04:30.99,2:04:34.63,Default,,0,0,0,,Номо да тамаша пионер! Бірақ Ханю...
Dialogue: 0,2:04:34.63,2:04:40.74,Default,,0,0,0,,Уф, шоги фанаты араласты.
Dialogue: 0,2:04:40.74,2:04:42.94,Default,,0,0,0,,Бірдеңе айт
Dialogue: 0,2:04:45.81,2:04:48.98,Default,,0,0,0,,Немесе... мен жеңуім керек...
Dialogue: 0,2:04:48.98,2:04:53.85,Default,,0,0,0,,Күте тұрыңыз! Қорқытшы!
Dialogue: 0,2:04:53.85,2:04:58.09,Default,,0,0,0,,Ката Ката…
Dialogue: 0,2:04:58.09,2:05:00.49,Default,,0,0,0,,Сіз жеңгіңіз келе ме?
Dialogue: 0,2:05:06.06,2:05:09.47,Default,,0,0,0,,Тоқта, ақымақ, Ямазаки!
Dialogue: 0,2:05:09.47,2:05:12.80,Default,,0,0,0,,Жеңіске жетсең, бұл аспан; жеңіліп қалсаң тозақ.
Dialogue: 0,2:05:12.80,2:05:16.41,Default,,0,0,0,,Жарайды... онда дәл солай... дәл солай!
Dialogue: 0,2:05:16.41,2:05:20.28,Default,,0,0,0,,Ичиро сияқты болғың келе ме? Ооо
Dialogue: 0,2:05:20.28,2:05:24.68,Default,,0,0,0,,Ультра викторина сияқты!
Dialogue: 0,2:05:28.72,2:05:32.69,Default,,0,0,0,,Ямадзакидің сөзіне байланысты көңіл-күй өткен жолғыдан өзгеше болғанымен,
Dialogue: 0,2:05:32.69,2:05:36.49,Default,,0,0,0,,Үлкен жетістік! 2-ші қойылым
Dialogue: 0,2:05:47.27,2:05:49.37,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,2:05:49.37,2:05:54.24,Default,,0,0,0,,Сонымен ұшыру үлкен толқумен өтті.
Dialogue: 0,2:05:54.24,2:05:59.55,Default,,0,0,0,,Бастықтары Тонегава болып табылатын төраға мен оның қарамағындағы қара киімдердің арасында.
Dialogue: 0,2:05:59.55,2:06:04.52,Default,,0,0,0,,Күрес, күрес, ірі жобаға қарсы шығу
Dialogue: 0,2:06:04.52,2:06:08.39,Default,,0,0,0,,Devilish Death Game Limited Rock Paper Scissors
Dialogue: 0,2:06:08.39,2:06:11.59,Default,,0,0,0,,Мұнда қол жеткізілді!
Dialogue: 0,2:07:44.12,2:07:46.99,Default,,0,0,0,,Ал уақыт өтеді
Dialogue: 0,2:07:46.99,2:07:51.03,Default,,0,0,0,,Бұл адамды Кайджи туды.
Dialogue: 0,2:07:51.03,2:07:53.73,Default,,0,0,0,,Күшті аңыз
Dialogue: 0,2:08:04.61,2:08:07.51,Default,,0,0,0,,Келесі жолы «Шығу»
Dialogue: 0,2:10:50.97,2:10:52.98,Default,,0,0,0,,Teiai тобы
Dialogue: 0,2:10:52.98,2:10:57.51,Default,,0,0,0,,Жапондық экономикалық әлемді басқаратын түзетуші
Dialogue: 0,2:10:57.51,2:11:01.48,Default,,0,0,0,,Оның мәні – қара қаржы
Dialogue: 0,2:11:01.48,2:11:05.35,Default,,0,0,0,,Әрине, үмітсіз қарыз иелері бірінен соң бірі пайда бола береді.
Dialogue: 0,2:11:05.35,2:11:07.36,Default,,0,0,0,,, яғни қоқыс
Dialogue: 0,2:11:07.36,2:11:09.76,Default,,0,0,0,,Жеңілгендер жинағы
Dialogue: 0,2:11:14.96,2:11:17.20,Default,,0,0,0,,Теяй жерасты қондырғысы
Dialogue: 0,2:11:17.20,2:11:21.67,Default,,0,0,0,,Мен Жапонияның қай жерде, жер түбінде екенін де білмеймін
Dialogue: 0,2:11:21.67,2:11:25.01,Default,,0,0,0,,Өлгендер тұратын мәжбүрлі еңбек нысаны
Dialogue: 0,2:11:25.01,2:11:29.15,Default,,0,0,0,,Нашар жағдайда, иә, дәл
Dialogue: 0,2:11:29.15,2:11:32.62,Default,,0,0,0,,тозақ тозақ тұңғиығы
Dialogue: 0,2:11:32.62,2:11:38.95,Default,,0,0,0,,Мұнда олар қарыздарын өтеу үшін ауыр жұмыс істеуге мәжбүр.
Dialogue: 0,2:11:38.95,2:11:44.49,Default,,0,0,0,,Кайдзи тозаққа түседі
Dialogue: 0,2:11:44.49,2:11:47.30,Default,,0,0,0,,Жердегі бұл тозақты жермен не байланыстырады
Dialogue: 0,2:11:47.30,2:11:51.00,Default,,0,0,0,,Тек бір күндік жол жүру билеті
Dialogue: 0,2:11:51.00,2:11:55.00,Default,,0,0,0,,Сен өте жамансың, Кайджи-кун, сен сондай жамансың.
Dialogue: 0,2:11:55.00,2:11:58.44,Default,,0,0,0,,Қалауды босатуда нашар
Dialogue: 0,2:11:58.44,2:12:02.38,Default,,0,0,0,,Кайджи бұл адаммен төбелеседі.
Dialogue: 0,2:12:02.38,2:12:07.98,Default,,0,0,0,,Бұл жаңа аңыздың басы
Dialogue: 0,2:12:07.98,2:12:12.59,Default,,0,0,0,,Уақыт Кайджи келгенге дейін қайтады.
Dialogue: 0,2:12:12.59,2:12:17.36,Default,,0,0,0,,А, бұл жақсы. Бір күндік саяхат билеті.
Dialogue: 0,2:12:17.36,2:12:22.00,Default,,0,0,0,,Перика Бұл жерасты құрылыстарына тән ақша бірлігі.
Dialogue: 0,2:12:22.00,2:12:27.70,Default,,0,0,0,,Осы жер асты нысанында жұмыс істейтіндердің айлық жалақысы Теяйге қарызды өтеу сомасы болып табылады.
Dialogue: 0,2:12:27.70,2:12:31.91,Default,,0,0,0,,Үйге бару ақысы азық-түлік шығындарын шегергеннен кейін 91 000 перикасты құрайды.
Dialogue: 0,2:12:31.91,2:12:38.55,Default,,0,0,0,,Басқаша айтқанда, 500 000 перикас - бұл өте көп ақша!
Dialogue: 0,2:12:38.55,2:12:41.55,Default,,0,0,0,,А... иә? (домофон)
Dialogue: 0,2:12:41.55,2:12:47.96,Default,,0,0,0,,Не? Бір күндік саяхатқа билет
Dialogue: 0,2:12:47.96,2:12:52.86,Default,,0,0,0,,Анам тағы? Қанша рет болды?
Dialogue: 0,2:12:52.86,2:12:56.80,Default,,0,0,0,,Сондықтан мен ертең күні бойы боламын.
Dialogue: 0,2:12:56.80,2:13:00.74,Default,,0,0,0,,Қалғаныңыз үшін рахмет, Исава Нумакава
Dialogue: 0,2:13:00.74,2:13:04.37,Default,,0,0,0,,Түсіндім, қош келдіңіз.
Dialogue: 0,2:13:04.37,2:13:07.74,Default,,0,0,0,,Осы қызғанышты көзқарасты қабылдаған адам
Dialogue: 0,2:13:07.74,2:13:11.35,Default,,0,0,0,,Мен жер астында болсам да, Чинчиромен бірге көп ақша таба бастадым.
Dialogue: 0,2:13:11.35,2:13:16.19,Default,,0,0,0,,Бір күндік саяхат билеті бар E тобының жоғарғы бөлігі
Dialogue: 0,2:13:16.19,2:13:18.69,Default,,0,0,0,,Топ жетекшісі Оцуки
Dialogue: 0,2:13:21.22,2:13:26.23,Default,,0,0,0,,Келесі түстен кейін Хибия саябағындағы орындық
Dialogue: 0,2:13:26.23,2:13:29.67,Default,,0,0,0,,Хмм...
Dialogue: 0,2:13:29.67,2:13:32.23,Default,,0,0,0,,Бір күндік саяхат билетін алғандар
Dialogue: 0,2:13:32.23,2:13:34.94,Default,,0,0,0,,Ешкімге Teiai мекемесінің қай жерде екенін білмеңіз.
Dialogue: 0,2:13:34.94,2:13:39.24,Default,,0,0,0,,Бірде ұйықтатып, бірде шығарды
Dialogue: 0,2:13:39.24,2:13:43.65,Default,,0,0,0,,Ал мен тілектерімді алдын ала айтып, ауданның бір жеріне қалдырдым.
Dialogue: 0,2:13:43.65,2:13:47.85,Default,,0,0,0,,Көшеге шыққанда қара киім киген адамдар қадағалайды.
Dialogue: 0,2:13:47.85,2:13:52.39,Default,,0,0,0,,Сыртқа шығар алдында қойған сағаттағы дабыл сөнгенде.
Dialogue: 0,2:13:52.39,2:13:55.52,Default,,0,0,0,,24 сағаттық кері санақ бір уақытта басталады
Dialogue: 0,2:13:55.52,2:13:58.26,Default,,0,0,0,,Хмм, басталды ма?
Dialogue: 0,2:13:58.26,2:14:00.80,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,2:14:00.80,2:14:03.87,Default,,0,0,0,,Топ жетекшісі Оцуки
Dialogue: 0,2:14:03.87,2:14:09.51,Default,,0,0,0,,Teiai Group жерасты қондырғысы E тобының көшбасшысы дәрежесіне көтерілген адам
Dialogue: 0,2:14:09.51,2:14:14.44,Default,,0,0,0,,Бұл бір күндік саяхат билеті. Қалаған билетті алыңыз.
Dialogue: 0,2:14:14.44,2:14:17.88,Default,,0,0,0,,Шектеулі уақытыңызды еркін және еркін пайдаланыңыз
Dialogue: 0,2:14:17.88,2:14:21.52,Default,,0,0,0,,Қазіргі өмірімізді уақыт қуып келеді.
Dialogue: 0,2:14:21.52,2:14:25.12,Default,,0,0,0,,Тас лақтыратын адам
Dialogue: 0,2:14:25.12,2:14:30.32,Default,,0,0,0,,Бір күндегі эпикалық саяхат туралы жазба.
Dialogue: 0,2:16:04.35,2:16:07.72,Default,,0,0,0,,Сіз сабырлысыз, иә?
Dialogue: 0,2:16:07.72,2:16:10.23,Default,,0,0,0,,Қалыпты Бұл дабыл өшсе
Dialogue: 0,2:16:10.23,2:16:13.30,Default,,0,0,0,,Әй, мен оны оңай көтере алмаймын.
Dialogue: 0,2:16:13.30,2:16:16.73,Default,,0,0,0,,Көпшілігіміз аз да болса уақытты босқа өткізгіміз келмейді.
Dialogue: 0,2:16:16.73,2:16:20.27,Default,,0,0,0,,Асығыңыз және Даш Пачинко Кабаре клубы
Dialogue: 0,2:16:20.27,2:16:23.64,Default,,0,0,0,,Ет алкогольді әйел
Dialogue: 0,2:16:23.64,2:16:26.44,Default,,0,0,0,,Күннің соңында мен сізге уақыт шегін айттым.
Dialogue: 0,2:16:26.44,2:16:29.28,Default,,0,0,0,,Ұсқынсыз және азапты
Dialogue: 0,2:16:29.28,2:16:37.05,Default,,0,0,0,,Бірақ дүрбелеңнің орнына ер адам тоқылған допты алады.
Dialogue: 0,2:16:37.05,2:16:41.06,Default,,0,0,0,,Күтілгендей, басқаша. Мен сыртқа шығуға үйреніп қалдым.
Dialogue: 0,2:16:41.06,2:16:46.40,Default,,0,0,0,,Осыдан кейін шұлықтар мен таблеткаларды кетіруге көшіңіз
Dialogue: 0,2:16:46.40,2:16:49.13,Default,,0,0,0,,Бірнеше сағаттан кейін
Dialogue: 0,2:16:49.13,2:16:54.80,Default,,0,0,0,,Өйткені, Оцуки Одан кейін қарапайым кешкі ас
Dialogue: 0,2:16:54.80,2:16:57.21,Default,,0,0,0,,Ал төсекке кет
Dialogue: 0,2:16:57.21,2:17:00.08,Default,,0,0,0,,Құны төмен бизнес қонақ үйлері
Dialogue: 0,2:17:00.08,2:17:03.28,Default,,0,0,0,,Жарты күнге жуық уақыт бітті
Dialogue: 0,2:17:05.55,2:17:10.15,Default,,0,0,0,,Келесі күні таңертең топ жетекшісі Отсуки қозғалады.
Dialogue: 0,2:17:16.69,2:17:18.79,Default,,0,0,0,,Жарайды, костюм?
Dialogue: 0,2:17:18.79,2:17:21.10,Default,,0,0,0,,Жоқ, жоқ, не үшін?
Dialogue: 0,2:17:21.10,2:17:24.17,Default,,0,0,0,,Қалай болғанда да жер астына қайта оралудың мағынасы жоқ!
Dialogue: 0,2:17:24.17,2:17:28.20,Default,,0,0,0,,Сізге не керек? Сол жігіт
Dialogue: 0,2:17:28.20,2:17:32.67,Default,,0,0,0,,Мен көремін. Көйлек коды...
Dialogue: 0,2:17:32.67,2:17:36.75,Default,,0,0,0,,Шинбаши мен Гинза дұрыс киінбейінше кіре алмайтын сияқты.
Dialogue: 0,2:17:36.75,2:17:39.21,Default,,0,0,0,,Көптеген сәнді дүкендер бар
Dialogue: 0,2:17:39.21,2:17:43.65,Default,,0,0,0,,Ол бүгін күні бойы бір нәрсеге көңіл бөліп, көшеде жүр.
Dialogue: 0,2:17:43.65,2:17:47.32,Default,,0,0,0,,Мен бәс тіккен түскі ас үшін
Dialogue: 0,2:17:47.32,2:17:51.66,Default,,0,0,0,,Сіз оған баға қойдыңыз ба? Хехе, көретін нәрсе ғой
Dialogue: 0,2:17:51.66,2:17:54.16,Default,,0,0,0,,Ол қандай сәнді дүкенге барады?
Dialogue: 0,2:17:57.83,2:18:00.23,Default,,0,0,0,,Аа, болды, болды
Dialogue: 0,2:18:04.51,2:18:07.98,Default,,0,0,0,,А, тұрған соба мейрамханасы ма?
Dialogue: 0,2:18:07.98,2:18:11.65,Default,,0,0,0,,Бұл арнайы дүкен бе?
Dialogue: 0,2:18:11.65,2:18:14.82,Default,,0,0,0,,Тағам журналы 3.2 Иә?
Dialogue: 0,2:18:14.82,2:18:20.16,Default,,0,0,0,,Бұл кеңсе қызметкерлеріне арналған кәдімгі дүкен.
Dialogue: 0,2:18:20.16,2:18:23.39,Default,,0,0,0,,Қош келдіңіз! Жалпы жабайы көкөніс соба?
Dialogue: 0,2:18:23.39,2:18:25.66,Default,,0,0,0,,Мори, тезірек, иә.
Dialogue: 0,2:18:25.66,2:18:28.20,Default,,0,0,0,,Жабайы көкөніс соясы Күтемін сені, аға, не?
Dialogue: 0,2:18:28.20,2:18:30.70,Default,,0,0,0,,Зазару Коландер
Dialogue: 0,2:18:30.70,2:18:34.47,Default,,0,0,0,,Zaru 2 Tsune Түскі ас кезінде тұрақты соба мейрамханасы
Dialogue: 0,2:18:34.47,2:18:36.47,Default,,0,0,0,,Бұл ұрыс алаңы
Dialogue: 0,2:18:36.47,2:18:39.98,Default,,0,0,0,,Генерал, біз әлі келдік пе? Иә, күтіңіз.
Dialogue: 0,2:18:39.98,2:18:44.01,Default,,0,0,0,,Собаны алу үшін нағыз шайқас
Dialogue: 0,2:18:44.01,2:18:46.01,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,2:18:46.01,2:18:48.58,Default,,0,0,0,,Тұрақты соба мейрамханасында үстелге отыру қиынға соғады
Dialogue: 0,2:18:48.58,2:18:52.12,Default,,0,0,0,,Сіз не ойлап отырсыз? Кешіріңіз.
Dialogue: 0,2:18:52.12,2:18:54.99,Default,,0,0,0,,Иә Тапсырысыңыз туралы не айтасыз? Ал,
Dialogue: 0,2:18:54.99,2:18:58.23,Default,,0,0,0,,Крокет, какиаж және...
Dialogue: 0,2:18:58.23,2:19:00.30,Default,,0,0,0,,Бір элемент Бір элемент
Dialogue: 0,2:19:00.30,2:19:04.37,Default,,0,0,0,,О, мен де асшаянның темпурасын аламын деп ойлаймын.
Dialogue: 0,2:19:04.37,2:19:08.74,Default,,0,0,0,,Маған осы шпинаттың үстіне ыстық жұмыртқасы бар кішкене тостаған беруге болады ма?
Dialogue: 0,2:19:08.74,2:19:11.71,Default,,0,0,0,,Және бір тармақ иә
Dialogue: 0,2:19:11.71,2:19:14.31,Default,,0,0,0,,Ал қалғандары
Dialogue: 0,2:19:16.24,2:19:20.75,Default,,0,0,0,,Бір құйма сыра немесе одан да көп
Dialogue: 0,2:19:20.75,2:19:24.09,Default,,0,0,0,,Не? Тұтынушы Соба ше?
Dialogue: 0,2:19:24.09,2:19:27.59,Default,,0,0,0,,Иә? Соба кеспесін алайын ба?
Dialogue: 0,2:19:29.73,2:19:33.86,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. Құйма сыра.
Dialogue: 0,2:19:33.86,2:19:36.06,Default,,0,0,0,,Хехе... сонда
Dialogue: 0,2:19:44.77,2:19:48.91,Default,,0,0,0,,Каа, ауырып тұр!
Dialogue: 0,2:19:48.91,2:19:51.01,Default,,0,0,0,,Түстен бастап осылай
Dialogue: 0,2:19:53.22,2:19:55.45,Default,,0,0,0,,Менде де бір құйма сыра бар.
Dialogue: 0,2:19:55.45,2:19:59.29,Default,,0,0,0,,Идиот! Мен әлі де айналудың ортасындамын, бірақ...
Dialogue: 0,2:19:59.29,2:20:01.62,Default,,0,0,0,,Қайта толтырыңыз! Ахх...
Dialogue: 0,2:20:01.62,2:20:04.12,Default,,0,0,0,,Құмырада шикі
Dialogue: 0,2:20:10.13,2:20:13.77,Default,,0,0,0,,Түсіндім, бұл жын-шайтан.
Dialogue: 0,2:20:13.77,2:20:16.67,Default,,0,0,0,,Ол гарнир ретінде беріледі.
Dialogue: 0,2:20:16.67,2:20:21.24,Default,,0,0,0,,Күндіз ішуді қаласа да іше алмайтын кеңсе қызметкерлерінен өзін жоғары сезіну
Dialogue: 0,2:20:21.24,2:20:24.41,Default,,0,0,0,,А, бұл костюм керемет.
Dialogue: 0,2:20:24.41,2:20:27.82,Default,,0,0,0,,Егер ол әдеттегідей киініп, сол әрекетті орындаса.
Dialogue: 0,2:20:27.82,2:20:32.22,Default,,0,0,0,,Жұмысы көп емес, жұмыс күндері күндіз ішетін тентек.
Dialogue: 0,2:20:32.22,2:20:35.66,Default,,0,0,0,,Бұл солай көрінуі мүмкін, бірақ сіз қалай ойлайсыз?
Dialogue: 0,2:20:35.66,2:20:40.26,Default,,0,0,0,,Костюм киген бойда Отсуки басшыға ұқсайды.
Dialogue: 0,2:20:40.26,2:20:43.56,Default,,0,0,0,,Күндіз ішімдік ішуге рұқсат етілген билік басындағы адам
Dialogue: 0,2:20:52.51,2:20:55.38,Default,,0,0,0,,Каа! Жаңа толтыру!
Dialogue: 0,2:20:55.38,2:20:58.45,Default,,0,0,0,,Куу! Отсуки үш рет тікелей эфирде!
Dialogue: 0,2:20:58.45,2:21:00.92,Default,,0,0,0,,Ол отырған орын енді жоқ
Dialogue: 0,2:21:00.92,2:21:04.99,Default,,0,0,0,,Бұл жай ғана соба мейрамханасындағы тұрақты үстел емес.
Dialogue: 0,2:21:04.99,2:21:12.39,Default,,0,0,0,,Тақ бұл мейрамханада ішімдік ішуге болатын жалғыз орын болды.
Dialogue: 0,2:21:23.37,2:21:26.24,Default,,0,0,0,,Уақыт келді, Отсуки, жүр.
Dialogue: 0,2:21:26.24,2:21:29.08,Default,,0,0,0,,Иә, иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,2:21:29.08,2:21:32.48,Default,,0,0,0,,Тозақтың тозағы Тұңғиық түбінде болсам да
Dialogue: 0,2:21:32.48,2:21:36.05,Default,,0,0,0,,Күніңізден толық рахат алыңыз
Dialogue: 0,2:21:36.05,2:21:38.59,Default,,0,0,0,,Бұл шынымен де сән-салтанат!
Dialogue: 0,2:21:38.59,2:21:43.59,Default,,0,0,0,,Топ жетекшісі Отсуки Келесі күні қайда барасыз?
Dialogue: 0,2:21:47.36,2:21:49.56,Default,,0,0,0,,Қайта толтырыңыз!
Dialogue: 0,2:21:51.67,2:21:54.64,Default,,0,0,0,,Е тобының жоғарғы топ жетекшісі Отсуки
Dialogue: 0,2:21:54.64,2:21:58.44,Default,,0,0,0,,Бір күндік саяхат билетімен шығарылды
Dialogue: 0,2:22:02.91,2:22:05.31,Default,,0,0,0,,Киншичо?
Dialogue: 0,2:22:13.16,2:22:16.96,Default,,0,0,0,,Мұнда Оцуки күтпеген жерден жылы және көңілді.
Dialogue: 0,2:22:16.96,2:22:22.26,Default,,0,0,0,,Екі рет 8 сағат ұйықтау
Dialogue: 0,2:22:22.26,2:22:25.73,Default,,0,0,0,,Күн батып, қараңғы түскенде
Dialogue: 0,2:22:25.73,2:22:29.40,Default,,0,0,0,,Ақыры ояндым, осы күні
Dialogue: 0,2:22:29.40,2:22:32.01,Default,,0,0,0,,Қарапайым түскі астан кейін
Dialogue: 0,2:22:32.01,2:22:34.61,Default,,0,0,0,,арзан бизнес қонақүйінде ұйықтау
Dialogue: 0,2:22:37.48,2:22:40.72,Default,,0,0,0,,Түске жақын бастаңыз
Dialogue: 0,2:22:40.72,2:22:45.09,Default,,0,0,0,,Ал, келесі тамақ уақыт шегі болады.
Dialogue: 0,2:22:45.09,2:22:47.76,Default,,0,0,0,,Басқаша айтқанда, бір тамақты жіберіп алмайсыз
Dialogue: 0,2:22:47.76,2:22:53.13,Default,,0,0,0,,Киншичо? Бұл сөзсіз Джажан.
Dialogue: 0,2:22:53.13,2:22:56.63,Default,,0,0,0,,Иә? Мен көбірек күресемін ...
Dialogue: 0,2:22:56.63,2:23:00.10,Default,,0,0,0,,Тереңдікке түсу
Dialogue: 0,2:23:00.10,2:23:03.61,Default,,0,0,0,,Берілмеңіз
Dialogue: 0,2:23:03.61,2:23:06.34,Default,,0,0,0,,Бұл қала өзгермейді.
Dialogue: 0,2:23:06.34,2:23:10.68,Default,,0,0,0,,Киншичо Оцуки өзінің қиын мектеп күндерін өткізді.
Dialogue: 0,2:23:10.68,2:23:13.22,Default,,0,0,0,,Естеліктер қаласы
Dialogue: 0,2:23:13.22,2:23:18.35,Default,,0,0,0,,Иә! Оокия крабымен қуырылған күріш!
Dialogue: 0,2:23:18.35,2:23:22.39,Default,,0,0,0,,Иә, иә, солай болды.
Dialogue: 0,2:23:22.39,2:23:25.56,Default,,0,0,0,,Қытай тағамы Дайкокуя
Dialogue: 0,2:23:25.56,2:23:30.73,Default,,0,0,0,,Генерал доссыздығымен танымал, бірақ студент краб қуырылған күріш сұрағанда.
Dialogue: 0,2:23:30.73,2:23:35.10,Default,,0,0,0,,1,5x арнайы қызмет үнсіз
Dialogue: 0,2:23:35.10,2:23:37.64,Default,,0,0,0,,Жалпы Смарт жоспар
Dialogue: 0,2:23:37.64,2:23:40.04,Default,,0,0,0,,Бұл краб қуырылған күріш сіздің күнделікті ақша тапшылығыңызды шешеді.
Dialogue: 0,2:23:40.04,2:23:42.54,Default,,0,0,0,,Мен шоколадты таяқшалармен аман қалдым.
Dialogue: 0,2:23:42.54,2:23:46.05,Default,,0,0,0,,Бұл сол кездегі Отсуки үшін керемет мереке болды.
Dialogue: 0,2:23:46.05,2:23:48.58,Default,,0,0,0,,Төмен түсетін ең жоғары асыл тас
Dialogue: 0,2:23:48.58,2:23:51.89,Default,,0,0,0,,Естеліктер
Dialogue: 0,2:23:51.89,2:23:54.46,Default,,0,0,0,,А... ол әлі де болды.
Dialogue: 0,2:23:54.46,2:23:58.86,Default,,0,0,0,,Оның үстіне содан бері ештеңе өзгерген жоқ.
Dialogue: 0,2:23:58.86,2:24:01.43,Default,,0,0,0,,Сәлемдесу
Dialogue: 0,2:24:01.43,2:24:03.80,Default,,0,0,0,,Дұрыс, «Қош келдіңіз»
Dialogue: 0,2:24:03.80,2:24:06.10,Default,,0,0,0,,Бухахаха Ақымақ болма, иә?
Dialogue: 0,2:24:06.10,2:24:09.91,Default,,0,0,0,,Маджонг плиткалары мөлдір болса да, бұл шындыққа айналуы мүмкін емес...
Dialogue: 0,2:24:09.91,2:24:14.21,Default,,0,0,0,,Бұрынғыдай шулы студенттер әлі де көп.
Dialogue: 0,2:24:20.52,2:24:24.99,Default,,0,0,0,,Шашы ағарған, генерал да өзгерген жоқ.
Dialogue: 0,2:24:24.99,2:24:30.19,Default,,0,0,0,,О! Мәзірдің бұл бұрышы аударылған
Dialogue: 0,2:24:30.19,2:24:32.73,Default,,0,0,0,,Оны әлі де пайдалануда
Dialogue: 0,2:24:32.73,2:24:35.13,Default,,0,0,0,,Мазмұны да өзгерген жоқ.
Dialogue: 0,2:24:35.13,2:24:38.07,Default,,0,0,0,,Әрине бар
Dialogue: 0,2:24:38.07,2:24:42.64,Default,,0,0,0,,Менің естеліктерімді өшіру... Иә?
Dialogue: 0,2:24:42.64,2:24:46.27,Default,,0,0,0,,Шаянмен қуырылған күріш пен краб қуырылған күріштің арасында не бар?
Dialogue: 0,2:24:46.27,2:24:50.41,Default,,0,0,0,,Бұрандалы омлет күріш дегеніміз не?
Dialogue: 0,2:24:50.41,2:24:53.38,Default,,0,0,0,,Ол бұрын болмаған болуы керек.
Dialogue: 0,2:24:53.38,2:24:58.59,Default,,0,0,0,,Дәлірек айтсақ, бұл омлет күріш, солай ма? Төменгі сызық
Dialogue: 0,2:24:58.59,2:25:01.02,Default,,0,0,0,,Жоқ, жоқ, жоқ болса да, неге?
Dialogue: 0,2:25:01.02,2:25:04.49,Default,,0,0,0,,Омлет күріш қытай тілінде?
Dialogue: 0,2:25:04.49,2:25:06.56,Default,,0,0,0,,Нені орындау оңай?
Dialogue: 0,2:25:06.56,2:25:08.76,Default,,0,0,0,,Ал...
Dialogue: 0,2:25:10.90,2:25:16.47,Default,,0,0,0,,Бір күнге шығудың ең қорқыныштысы - ақша жоғалту.
Dialogue: 0,2:25:16.47,2:25:22.21,Default,,0,0,0,,Қызығушылығыңызға қарап тапсырыс беріңіз, егер ол нашар болып шықса, сіз батып кетесіз.
Dialogue: 0,2:25:22.21,2:25:27.75,Default,,0,0,0,,Бұл 50 нота болуы мүмкін және бұл позицияға кейінірек қосылған болуы мүмкін.
Dialogue: 0,2:25:27.75,2:25:31.42,Default,,0,0,0,,Сонда да біртүрлі, мен қызықпын.
Dialogue: 0,2:25:31.42,2:25:33.69,Default,,0,0,0,,Бұранданың бұл жолы
Dialogue: 0,2:25:33.69,2:25:36.09,Default,,0,0,0,,А, жоқ, жоқ, жоқ!
Dialogue: 0,2:25:36.09,2:25:39.13,Default,,0,0,0,,Мұндағы шытырман оқиға жалғасуда
Dialogue: 0,2:25:39.13,2:25:42.43,Default,,0,0,0,,Бірнеше күн жер астында
Dialogue: 0,2:25:42.43,2:25:45.07,Default,,0,0,0,,Бұл бастапқыда жоспарланғандай...
Dialogue: 0,2:25:45.07,2:25:51.17,Default,,0,0,0,,Мм, мына омлет күрішінің бірі.
Dialogue: 0,2:25:51.17,2:25:54.21,Default,,0,0,0,,Ах, мен неге қазір...
Dialogue: 0,2:25:54.21,2:25:58.05,Default,,0,0,0,,Краб қуырылған күріштің орнына омлет күріш
Dialogue: 0,2:25:58.05,2:26:04.72,Default,,0,0,0,,Ах, одан бірнеше миллиметрге жақсырақ.
Dialogue: 0,2:26:04.72,2:26:08.02,Default,,0,0,0,,Қызығу тұрақтылық әкеледі
Dialogue: 0,2:26:10.99,2:26:15.53,Default,,0,0,0,,Жоғарыда айтылғандарға сенімдісіз бе?
Dialogue: 0,2:26:15.53,2:26:19.03,Default,,0,0,0,,Иә
Dialogue: 0,2:26:19.03,2:26:21.10,Default,,0,0,0,,Иә?
Dialogue: 0,2:26:21.10,2:26:24.01,Default,,0,0,0,,Сәл күте тұрыңыз. иә?
Dialogue: 0,2:26:24.01,2:26:26.61,Default,,0,0,0,,Оны дереу ауруханаға жеткіземіз.
Dialogue: 0,2:26:28.71,2:26:34.48,Default,,0,0,0,,Бұл сәтсіздік болды ма? Мұнда шаян чаханмен жүру қауіпсіз...
Dialogue: 0,2:26:34.48,2:26:36.58,Default,,0,0,0,,Бұл дымқыл сүлгі.
Dialogue: 0,2:26:41.09,2:26:43.89,Default,,0,0,0,,Менің барғым келмейді
Dialogue: 0,2:26:47.96,2:26:52.70,Default,,0,0,0,,Бір күнге көшеге шыққанда маңыздысы ренжімеу.
Dialogue: 0,2:26:52.70,2:26:55.10,Default,,0,0,0,,Қарапайым ақыл Қарапайым ақыл
Dialogue: 0,2:26:58.01,2:27:02.04,Default,,0,0,0,,Қандай жағдай болмасын, сабыр сақтауды ұмытпау керек.
Dialogue: 0,2:27:02.04,2:27:06.71,Default,,0,0,0,,Сіз қауіпсіз баспанаға жете аласыз.
Dialogue: 0,2:27:06.71,2:27:11.99,Default,,0,0,0,,Бір қарағанда, Отсукидің таңдауы сәттілік немесе данышпандық сияқты көрінеді.
Dialogue: 0,2:27:11.99,2:27:16.76,Default,,0,0,0,,Мүлдем ойсыз ставка емес... өйткені
Dialogue: 0,2:27:16.76,2:27:20.13,Default,,0,0,0,,Коно Дайкокуяның танымал мәзірі
Dialogue: 0,2:27:20.13,2:27:24.03,Default,,0,0,0,,Жоғарғы рейтинг 4-ші орын: салат салатымен қуырылған күріш
Dialogue: 0,2:27:24.03,2:27:26.03,Default,,0,0,0,,3 орын Гомоку қуырылған күріш
Dialogue: 0,2:27:26.03,2:27:32.17,Default,,0,0,0,,2 орын: асшаяндарды қуырылған күріш және №1: краб қуырылған күріш
Dialogue: 0,2:27:32.17,2:27:34.28,Default,,0,0,0,,Яғни, қуырылған күріш түрі
Dialogue: 0,2:27:34.28,2:27:37.85,Default,,0,0,0,,Айтпақшы, 5-ші орын Ката Якисоба
Dialogue: 0,2:27:37.85,2:27:42.65,Default,,0,0,0,,Басқаша айтқанда, қуырылған күріш түрі - Дайкокуядағы темір табақ.
Dialogue: 0,2:27:42.65,2:27:45.05,Default,,0,0,0,,Шығын жоқ
Dialogue: 0,2:27:45.05,2:27:49.46,Default,,0,0,0,,Иә! Егер сіз осы мағынада жүрсеңіз
Dialogue: 0,2:27:49.46,2:27:54.63,Default,,0,0,0,,Омлет күріші де қуырылған күріштің бір түрі, сондықтан қателесуге болмайды.
Dialogue: 0,2:27:54.63,2:27:57.43,Default,,0,0,0,,Қызығымнан шытырман оқиғаға бардым.
Dialogue: 0,2:27:57.43,2:28:01.47,Default,,0,0,0,,Кешірейін сені, Сабырлы жүрекпен.
Dialogue: 0,2:28:01.47,2:28:05.07,Default,,0,0,0,,Сосын түскі ас уақыты келеді
Dialogue: 0,2:28:05.07,2:28:08.21,Default,,0,0,0,,Орналасқан жері Киншичо Дайкокуя
Dialogue: 0,2:28:08.21,2:28:11.18,Default,,0,0,0,,Шыдамдылығыңызға рахмет.
Dialogue: 0,2:28:11.18,2:28:13.92,Default,,0,0,0,,Бұл омлет күріш.
Dialogue: 0,2:28:13.92,2:28:20.76,Default,,0,0,0,,Омурай... Гах! Эх, бұл омлет күріш емес.
Dialogue: 0,2:28:20.76,2:28:24.66,Default,,0,0,0,,Омлет және күрішпен Омлет күріш
Dialogue: 0,2:28:24.66,2:28:27.63,Default,,0,0,0,,Өкініш, күтпеген түсінбеушілік
Dialogue: 0,2:28:27.63,2:28:30.70,Default,,0,0,0,,Кон... Ку... Га...
Dialogue: 0,2:28:30.70,2:28:34.60,Default,,0,0,0,,Отсуки 50 секундтай таң қалды.
Dialogue: 0,2:28:34.60,2:28:39.14,Default,,0,0,0,,уақыт шегіне жақындап қалды
Dialogue: 0,2:28:39.14,2:28:43.14,Default,,0,0,0,,Жұмыстан кету жағдайы, түскі ас уақыты
Dialogue: 0,2:28:43.14,2:28:49.64,Default,,0,0,0,,Қандай қарапайым мәзір. Студенттердің асханасы сияқты.
Dialogue: 0,2:28:51.99,2:28:55.46,Default,,0,0,0,,Иә? таралатын сезім
Dialogue: 0,2:28:55.46,2:28:58.06,Default,,0,0,0,,Бұл омлет дегеніміз не?
Dialogue: 0,2:28:58.06,2:29:01.16,Default,,0,0,0,,Іші жартылай піскен, енді жарық
Dialogue: 0,2:29:01.16,2:29:04.40,Default,,0,0,0,,Ал мұқият қарасаңыз, ол жерде.
Dialogue: 0,2:29:04.40,2:29:07.87,Default,,0,0,0,,Көп шошқа еті және кесілген көк пияз
Dialogue: 0,2:29:07.87,2:29:11.67,Default,,0,0,0,,Батыс мейрамханасында ешқашан болмайтын идеялар
Dialogue: 0,2:29:13.98,2:29:16.88,Default,,0,0,0,,Иә! жақсы!
Dialogue: 0,2:29:16.88,2:29:22.05,Default,,0,0,0,,Оның үстіне бұл Уэйвермен араласады!
Dialogue: 0,2:29:22.05,2:29:24.05,Default,,0,0,0,,Бас тарту
Dialogue: 0,2:29:24.05,2:29:26.72,Default,,0,0,0,,Қытай сорпасы ең маңызды дәмдеуіш болып саналады.
Dialogue: 0,2:29:26.72,2:29:29.46,Default,,0,0,0,,Жартылай иленген түрі
Dialogue: 0,2:29:29.46,2:29:31.89,Default,,0,0,0,,Кетчуп жетіспеді деп уайымдадым.
Dialogue: 0,2:29:31.89,2:29:34.19,Default,,0,0,0,,Бұл проблема емес
Dialogue: 0,2:29:38.40,2:29:41.84,Default,,0,0,0,,Алдын ала күріш
Dialogue: 0,2:29:41.84,2:29:44.77,Default,,0,0,0,,Мен білмей тұрып, Оцуки сонда болды!
Dialogue: 0,2:29:44.77,2:29:50.51,Default,,0,0,0,,Омлет пен күрішті бірнеше минутта дайындады.
Dialogue: 0,2:29:50.51,2:29:54.68,Default,,0,0,0,,Ах! Бұл күтпеген жерден дәмді болды
Dialogue: 0,2:29:54.68,2:30:00.19,Default,,0,0,0,,Бір кезде мен не болады деп ойладым, бірақ мен бұған қанағаттандым.
Dialogue: 0,2:30:00.19,2:30:03.09,Default,,0,0,0,,Ал, краб қуырылған күріш
Dialogue: 0,2:30:03.09,2:30:07.46,Default,,0,0,0,,Оны жемей үйге бару ұят болар.
Dialogue: 0,2:30:07.46,2:30:11.57,Default,,0,0,0,,Иә! Мини краб қуырылған күріш күтуде
Dialogue: 0,2:30:11.57,2:30:15.27,Default,,0,0,0,,Е! О, жоқ, мен сұрамадым.
Dialogue: 0,2:30:15.27,2:30:17.34,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,2:30:17.34,2:30:20.48,Default,,0,0,0,,Ан-чан, мен үнемі осыны сұрайтынмын.
Dialogue: 0,2:30:20.48,2:30:22.78,Default,,0,0,0,,Мен қателесіп алдым.
Dialogue: 0,2:30:26.21,2:30:30.72,Default,,0,0,0,,Ұңғымаға қызмет көрсету ah... ta жалпы
Dialogue: 0,2:30:30.72,2:30:34.92,Default,,0,0,0,,25 жыл өтсе де, есімде сені...
Dialogue: 0,2:30:49.74,2:30:54.58,Default,,0,0,0,,Сағынышқа толы сағыныш, жастық шақ
Dialogue: 0,2:30:54.58,2:30:58.95,Default,,0,0,0,,Уақыт саяхаты Уақыт өткен сайын өзгермейтін нәрселер
Dialogue: 0,2:30:58.95,2:31:01.78,Default,,0,0,0,,Адамның мейірімділігі және Киншичо
Dialogue: 0,2:31:01.78,2:31:05.02,Default,,0,0,0,,Краб қуырылған күріш!
Dialogue: 0,2:31:05.02,2:31:08.89,Default,,0,0,0,,Мен мұны ешқашан күткен емеспін.
Dialogue: 0,2:31:08.89,2:31:11.49,Default,,0,0,0,,Студенттік жеңілдік 25 жылда алғаш рет қолданылды
Dialogue: 0,2:31:15.40,2:31:19.20,Default,,0,0,0,,Соңында Оцуки дүкеннен өзін жақсы сезініп шықты.
Dialogue: 0,2:31:26.61,2:31:30.14,Default,,0,0,0,,Қара киім киіп смартфонды қарызға алу және Гурунавиде ұпай жинау
Dialogue: 0,2:31:30.14,2:31:32.81,Default,,0,0,0,,Киншичо Дайкокуя
Dialogue: 0,2:31:32.81,2:31:35.82,Default,,0,0,0,,Шығынның өнімділігі 5 Дәмі 5
Dialogue: 0,2:31:35.82,2:31:38.82,Default,,0,0,0,,Дүкеннің атмосферасы...
Dialogue: 0,2:31:38.82,2:31:40.82,Default,,0,0,0,,Хмм.
Dialogue: 0,2:31:40.82,2:31:42.82,Default,,0,0,0,,３
Dialogue: 0,2:31:48.00,2:31:51.20,Default,,0,0,0,,Тозақтың тозағы Тұңғиық түбінде болсам да
Dialogue: 0,2:31:51.20,2:31:54.67,Default,,0,0,0,,Күніңізден толық рахат алыңыз
Dialogue: 0,2:31:54.67,2:31:57.47,Default,,0,0,0,,Бұл шынымен де сән-салтанат.
Dialogue: 0,2:31:57.47,2:32:03.07,Default,,0,0,0,,Топ жетекшісі Отсуки Келесі күні қайда барасыз?
Dialogue: 0,2:33:40.24,2:33:43.54,Default,,0,0,0,,Келесі жолы «Го Ю»
Dialogue: 0,2:36:25.94,2:36:28.61,Default,,0,0,0,,Не?
Dialogue: 0,2:36:28.61,2:36:31.85,Default,,0,0,0,,Бір күндік саяхат билеті
Dialogue: 0,2:36:31.85,2:36:35.58,Default,,0,0,0,,Жарайды, реттейік.
Dialogue: 0,2:36:35.58,2:36:39.35,Default,,0,0,0,,Жер астында жүріп көп ақша табыңыз
Dialogue: 0,2:36:39.35,2:36:43.69,Default,,0,0,0,,Оның жалғыз үміті - бір күндік саяхат билеті бар адам.
Dialogue: 0,2:36:43.69,2:36:47.19,Default,,0,0,0,,Е тобының жоғарғы топ жетекшісі Отсуки
Dialogue: 0,2:36:49.66,2:36:53.43,Default,,0,0,0,,Бірнеше күннен кейін Оцуки босатылады.
Dialogue: 0,2:36:53.43,2:36:55.60,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,2:36:55.60,2:36:58.41,Default,,0,0,0,,Бірақ бұл жақсы болды ма?
Dialogue: 0,2:36:58.41,2:37:03.21,Default,,0,0,0,,Бүркіттермен серуендеу күні, Нумакава
Dialogue: 0,2:37:03.21,2:37:06.55,Default,,0,0,0,,Иә, егер топ басшысы келіссе.
Dialogue: 0,2:37:06.55,2:37:11.72,Default,,0,0,0,,Соңғы рет өзім шыққанда мүлде жақсы болмады.
Dialogue: 0,2:37:11.72,2:37:15.82,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,2:37:15.82,2:37:18.69,Default,,0,0,0,,Ой, кері санақ басталды.
Dialogue: 0,2:37:18.69,2:37:20.96,Default,,0,0,0,,Қайда бара жатырсың? Мен асығуым керек
Dialogue: 0,2:37:20.96,2:37:25.36,Default,,0,0,0,,Нумакава, сабыр ет. Мұны да оқы.
Dialogue: 0,2:37:27.37,2:37:31.27,Default,,0,0,0,,Біріншіден демалысты қалай өткізуге болады
Dialogue: 0,2:37:35.74,2:37:41.68,Default,,0,0,0,,Асықпау маңызды. Жан тыныштығын қалпына келтіру маңызды.
Dialogue: 0,2:37:41.68,2:37:44.75,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,2:37:44.75,2:37:50.95,Default,,0,0,0,,А? Бұл айлық па? Иә
Dialogue: 0,2:37:52.89,2:37:57.06,Default,,0,0,0,,Соңында Осыдан кейін Толық оқу 1 сағат
Dialogue: 0,2:37:57.06,2:38:01.67,Default,,0,0,0,,Сіз бұл жаңа серияны оқыдыңыз ба? Мен оқыдым, қызық болды
Dialogue: 0,2:38:01.67,2:38:04.57,Default,,0,0,0,,Қызықты журнал әсерлері
Dialogue: 0,2:38:04.57,2:38:06.97,Default,,0,0,0,,Сонымен, Чибаның шығармалары сізге не ұнайды?
Dialogue: 0,2:38:06.97,2:38:10.31,Default,,0,0,0,,Мм, соңында...
Dialogue: 0,2:38:10.31,2:38:13.65,Default,,0,0,0,,«Нотари Мацутаро» және «Мен Тецухэймін»
Dialogue: 0,2:38:13.65,2:38:16.02,Default,,0,0,0,,Уау, топ басшысына ұқсайды.
Dialogue: 0,2:38:16.02,2:38:19.25,Default,,0,0,0,,Гүлденген манга талқылауы
Dialogue: 0,2:38:19.25,2:38:22.66,Default,,0,0,0,,Жарайды, тамаққа барайық.
Dialogue: 0,2:38:22.66,2:38:25.69,Default,,0,0,0,,Соңында, Нори Ниши-Огикубо
Dialogue: 0,2:38:25.69,2:38:29.33,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,2:38:29.33,2:38:32.50,Default,,0,0,0,,Не істеу керек? Бұл дұрыс
Dialogue: 0,2:38:32.50,2:38:36.74,Default,,0,0,0,,Бұл ең қымбат сашими табақ...
Dialogue: 0,2:38:36.74,2:38:39.97,Default,,0,0,0,,Нашар орындалды, иә?
Dialogue: 0,2:38:39.97,2:38:42.64,Default,,0,0,0,,«Мен қымбат нәрсе сатып алғым келеді».
Dialogue: 0,2:38:42.64,2:38:45.15,Default,,0,0,0,,Жаңадан бастаушыларға ортақ
Dialogue: 0,2:38:45.15,2:38:49.78,Default,,0,0,0,,Бір күндегі әдеттегі қателер
Dialogue: 0,2:38:49.78,2:38:52.95,Default,,0,0,0,,Енді адасып қалдың
Dialogue: 0,2:38:52.95,2:38:57.83,Default,,0,0,0,,Көшеге шыққандағы толқудан мен қатты жегім келетін нәрсені жеуді шештім.
Dialogue: 0,2:38:57.83,2:39:01.53,Default,,0,0,0,,Соңғы бірнеше күндегі жер асты тағамы болды
Dialogue: 0,2:39:01.53,2:39:06.23,Default,,0,0,0,,Құрғақ грильдегі балық
Dialogue: 0,2:39:06.23,2:39:08.34,Default,,0,0,0,,Қуырылған тағам Уау
Dialogue: 0,2:39:08.34,2:39:11.21,Default,,0,0,0,,Бұл да тәндікі ме?
Dialogue: 0,2:39:11.21,2:39:13.57,Default,,0,0,0,,Сіз Нумакаваның қай жеріненсіз?
Dialogue: 0,2:39:13.57,2:39:16.68,Default,,0,0,0,,Не? Кюсюдегі Миядзаки
Dialogue: 0,2:39:16.68,2:39:20.58,Default,,0,0,0,,Аспаз аспаз... Түсіндім. иә?
Dialogue: 0,2:39:20.58,2:39:25.39,Default,,0,0,0,,Дәл сіз не жегіңіз келеді
Dialogue: 0,2:39:25.39,2:39:27.89,Default,,0,0,0,,Нанбан тауық еті! (асқазанның айқайлауы)
Dialogue: 0,2:39:27.89,2:39:32.59,Default,,0,0,0,,Хаха Ең жақсы жауап
Dialogue: 0,2:39:32.59,2:39:35.43,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,2:39:35.43,2:39:38.83,Default,,0,0,0,,Нанбан тауық еті өте дәмді болды!
Dialogue: 0,2:39:38.83,2:39:42.04,Default,,0,0,0,,Топ басшысы айтқандай, менің ойыма басқа ештеңе келмейді.
Dialogue: 0,2:39:42.04,2:39:46.64,Default,,0,0,0,,Дұрыс па? Жарайды, екінші үйге барайық. Иә!
Dialogue: 0,2:39:46.64,2:39:49.94,Default,,0,0,0,,Мен бұл жерде жақсы мейрамхана бар екеніне сенімдімін.
Dialogue: 0,2:39:51.98,2:39:55.32,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,2:39:55.32,2:39:57.79,Default,,0,0,0,,Не болды? Топ басшысы сс
Dialogue: 0,2:39:57.79,2:40:01.26,Default,,0,0,0,,Осы сәтте Оцукиді жайсыздық сезімі биледі.
Dialogue: 0,2:40:01.26,2:40:05.46,Default,,0,0,0,,Маңызды нәрсені елемеу Жиренішті сезім
Dialogue: 0,2:40:05.46,2:40:08.10,Default,,0,0,0,,Иә? Күте тұрыңыз
Dialogue: 0,2:40:08.10,2:40:11.80,Default,,0,0,0,,Ойды айналдыру, естеліктерді айналдыру
Dialogue: 0,2:40:11.80,2:40:14.10,Default,,0,0,0,,Мен дүкеннен жаңа шыққан кезде
Dialogue: 0,2:40:19.87,2:40:22.88,Default,,0,0,0,,Ах! Керемет...
Dialogue: 0,2:40:22.88,2:40:25.55,Default,,0,0,0,,Бөлімше басшысы!
Dialogue: 0,2:40:25.55,2:40:31.35,Default,,0,0,0,,Түйсік Оцукиді алға, алға жетелейді!
Dialogue: 0,2:40:34.22,2:40:36.22,Default,,0,0,0,,О!
Dialogue: 0,2:40:36.22,2:40:40.09,Default,,0,0,0,,Топ жетекшісі, күте тұрыңыз. Не болып жатыр? Әй?
Dialogue: 0,2:40:40.09,2:40:42.73,Default,,0,0,0,,Міне!
Dialogue: 0,2:40:42.73,2:40:48.54,Default,,0,0,0,,Хахахаха Нумакава
Dialogue: 0,2:40:48.54,2:40:53.37,Default,,0,0,0,,Бұл қызық. Бір күнге шығу шынымен қызық.
Dialogue: 0,2:40:53.37,2:40:56.91,Default,,0,0,0,,Бақытты жаз фестивалі
Dialogue: 0,2:40:56.91,2:41:01.82,Default,,0,0,0,,Юкатада ата-ана мен бала қателескен жоқ.
Dialogue: 0,2:41:01.82,2:41:05.65,Default,,0,0,0,,Топ басшысы күткендей, кеттік, Нумакава.
Dialogue: 0,2:41:05.65,2:41:07.96,Default,,0,0,0,,Иә! Кестені өзгерту
Dialogue: 0,2:41:07.96,2:41:11.53,Default,,0,0,0,,Сіз мұны білмей тұрып, Якитори Якисобадан ләззат аласыз
Dialogue: 0,2:41:11.53,2:41:14.23,Default,,0,0,0,,Құйма сыра!
Dialogue: 0,2:41:14.23,2:41:16.83,Default,,0,0,0,,Екеуі де 90% аш.
Dialogue: 0,2:41:18.97,2:41:21.34,Default,,0,0,0,,Менің ойымша, бұл аяқталуға жақын
Dialogue: 0,2:41:21.34,2:41:25.74,Default,,0,0,0,,Жарайды, біз соңғы барамыз ба? Ұнтақ?
Dialogue: 0,2:41:25.74,2:41:28.44,Default,,0,0,0,,Не? Эй, қош келдіңіз
Dialogue: 0,2:41:28.44,2:41:30.48,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,2:41:30.48,2:41:35.38,Default,,0,0,0,,Сіз қайсысын таңдар едіңіз? Екеуін де жей алмаймын.
Dialogue: 0,2:41:35.38,2:41:39.72,Default,,0,0,0,,Аа, мен оны топ басшысына қалдырамын.
Dialogue: 0,2:41:39.72,2:41:44.02,Default,,0,0,0,,Осы кезде Оцукидің басына бір төбе түсті.
Dialogue: 0,2:41:45.96,2:41:49.76,Default,,0,0,0,,Такояки мен Окономияки, әрқайсысы үшеуден.
Dialogue: 0,2:41:49.76,2:41:52.00,Default,,0,0,0,,Жоқ…
Dialogue: 0,2:41:52.00,2:41:57.37,Default,,0,0,0,,Бүгінгі қажырлы еңбектеріңіз үшін рахмет, баршаңызға! Іске сәт!
Dialogue: 0,2:41:57.37,2:42:00.21,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,2:42:00.21,2:42:02.88,Default,,0,0,0,,Бұл штаб шатыры ма?
Dialogue: 0,2:42:02.88,2:42:08.42,Default,,0,0,0,,Иә, бірақ қаласаңыз, келіңіз.
Dialogue: 0,2:42:08.42,2:42:10.52,Default,,0,0,0,,Иә? Жарайды ма?
Dialogue: 0,2:42:10.52,2:42:15.96,Default,,0,0,0,,Иә, өтінемін, өтінемін, бәрі маған беріңізші.
Dialogue: 0,2:42:15.96,2:42:19.16,Default,,0,0,0,,Рахмет! Сізге көп рахмет
Dialogue: 0,2:42:19.16,2:42:21.80,Default,,0,0,0,,Ку… Меша тәртіпсіздік!
Dialogue: 0,2:42:21.80,2:42:24.63,Default,,0,0,0,,Әрқайсысының үшеуін сатып алудың шектен шыққан әрекетінің үстіне.
Dialogue: 0,2:42:24.63,2:42:28.54,Default,,0,0,0,,Енді бейтаныс адамдарға толығымен беріңіз
Dialogue: 0,2:42:28.54,2:42:31.17,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,2:42:31.17,2:42:34.48,Default,,0,0,0,,Өтінемін, иә?
Dialogue: 0,2:42:34.48,2:42:37.48,Default,,0,0,0,,Сізге ұнаса ше? екеуің де
Dialogue: 0,2:42:37.48,2:42:41.88,Default,,0,0,0,,Амансың ба? Олай болса, менің сөзімді қабыл алыңыз.
Dialogue: 0,2:42:45.89,2:42:48.39,Default,,0,0,0,,Отсуки Нағыз тамаша ойын
Dialogue: 0,2:42:48.39,2:42:53.53,Default,,0,0,0,,Екі адам, екі ұнтақ заттар, қосымша
Dialogue: 0,2:42:53.53,2:42:56.40,Default,,0,0,0,,Тегін алкоголь және ішімдік ішетін достар
Dialogue: 0,2:42:56.40,2:43:00.20,Default,,0,0,0,,Таңертеңге дейін ішуге болады
Dialogue: 0,2:43:00.20,2:43:04.04,Default,,0,0,0,,Жарылыс! Otsuki Magic!
Dialogue: 0,2:43:04.04,2:43:07.84,Default,,0,0,0,,Нумакава мен таң қалдым!
Dialogue: 0,2:43:07.84,2:43:11.85,Default,,0,0,0,,Бөлімше басшысы! Маған қазірден бастап сенімен шығуға рұқсат етіңіз.
Dialogue: 0,2:43:11.85,2:43:14.62,Default,,0,0,0,,Хэхехе Нумакава
Dialogue: 0,2:43:14.62,2:43:19.52,Default,,0,0,0,,Сіз өзіңіздің жолыңызды кесуіңіз керек, солай ма?
Dialogue: 0,2:44:52.11,2:44:56.98,Default,,0,0,0,,Отсуки қолында бір күндік саяхат билетімен босатылды
Dialogue: 0,2:44:56.98,2:45:00.55,Default,,0,0,0,,Хибия?
Dialogue: 0,2:45:00.55,2:45:04.49,Default,,0,0,0,,Иә? Уау
Dialogue: 0,2:45:04.49,2:45:08.33,Default,,0,0,0,,Мм, жақын жерде емес пе?
Dialogue: 0,2:45:08.33,2:45:10.43,Default,,0,0,0,,Бүгін тамаша.
Dialogue: 0,2:45:10.43,2:45:13.93,Default,,0,0,0,,Бір күндік серуендеу кезінде қара киімдегі бақылаушы сүйемелдеу
Dialogue: 0,2:45:13.93,2:45:16.70,Default,,0,0,0,,Қашықтықты реттеу жоқ па?
Dialogue: 0,2:45:16.70,2:45:19.11,Default,,0,0,0,,Қара киім алыстан бақылайды.
Dialogue: 0,2:45:19.11,2:45:21.91,Default,,0,0,0,,Сырттағы біреуге сенім білдіру
Dialogue: 0,2:45:21.91,2:45:24.48,Default,,0,0,0,,Түсіндің бе, Оцуки?
Dialogue: 0,2:45:24.48,2:45:30.98,Default,,0,0,0,,Қысқасы, мен саған мүлде сенбеймін.
Dialogue: 0,2:45:33.09,2:45:37.56,Default,,0,0,0,,Бір қарағанда жұмсақ болып көрінеді, жер астында жақсы беделге ие.
Dialogue: 0,2:45:37.56,2:45:43.33,Default,,0,0,0,,нақты жер бағасының тәртібін бұзуы мүмкін ойын үйін ашады.
Dialogue: 0,2:45:43.33,2:45:45.67,Default,,0,0,0,,Әр жолы қалыптан тыс табыс
Dialogue: 0,2:45:45.67,2:45:50.10,Default,,0,0,0,,Басқаларды қара жамылып алдайсың, бірақ менің көзімді алдай алмайсың.
Dialogue: 0,2:45:50.10,2:45:53.31,Default,,0,0,0,,Енді Миямото бұл жолы бақылауға жауапты.
Dialogue: 0,2:45:53.31,2:45:55.31,Default,,0,0,0,,О, Құдай-ай…➡
Dialogue: 0,2:45:55.31,2:45:57.31,Default,,0,0,0,,Ережені кішкене болса да бұзатын әрекет жасасаңыз
Dialogue: 0,2:45:57.31,2:46:00.21,Default,,0,0,0,,Мен сені дереу жер астына айдаймын!
Dialogue: 0,2:46:02.78,2:46:04.82,Default,,0,0,0,,Хехехе
Dialogue: 0,2:46:04.82,2:46:07.25,Default,,0,0,0,,Не болды? О, жоқ
Dialogue: 0,2:46:07.25,2:46:09.52,Default,,0,0,0,,Жарайсың ба? Уақыт келді, иә?
Dialogue: 0,2:46:09.52,2:46:12.29,Default,,0,0,0,,Іске қосу қосқышы Ah... Мен...
Dialogue: 0,2:46:12.29,2:46:14.60,Default,,0,0,0,,Мен білемін
Dialogue: 0,2:46:14.60,2:46:17.63,Default,,0,0,0,,Йоккора Шотто
Dialogue: 0,2:46:17.63,2:46:22.00,Default,,0,0,0,,1 күнге кері санақ басталады
Dialogue: 0,2:46:22.00,2:46:26.24,Default,,0,0,0,,Otsuki Бірінші аялдама Кагосима префектурасының антенна дүкені
Dialogue: 0,2:46:26.24,2:46:28.91,Default,,0,0,0,,Қызықты Кагошимакан
Dialogue: 0,2:46:28.91,2:46:32.51,Default,,0,0,0,,Антенна дүкені? Бұл қызық
Dialogue: 0,2:46:32.51,2:46:34.91,Default,,0,0,0,,Осы жерлерді аралау
Dialogue: 0,2:46:37.45,2:46:40.39,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. О, міне келдік.
Dialogue: 0,2:46:40.39,2:46:44.93,Default,,0,0,0,,Лотос тамыры бар балық торты
Dialogue: 0,2:46:44.93,2:46:51.33,Default,,0,0,0,,Иә, бұл дәмді. Лотос тамырлары мен балық торттарының құрылымын айтып жеткізу мүмкін емес.
Dialogue: 0,2:46:51.33,2:46:54.84,Default,,0,0,0,,Аа, дұрыс, Миямото-сан, бұл не?
Dialogue: 0,2:46:54.84,2:46:57.97,Default,,0,0,0,,Қаласаңыз, мен ірімшікті де сатып алдым.
Dialogue: 0,2:46:57.97,2:47:01.24,Default,,0,0,0,,О? Ақымақ болма, мен қазір жұмыстамын.
Dialogue: 0,2:47:01.24,2:47:03.24,Default,,0,0,0,,Түсіндім. Содан кейін...
Dialogue: 0,2:47:06.71,2:47:09.18,Default,,0,0,0,,Дәмді 2-ші мейрамхана бүгін
Dialogue: 0,2:47:09.18,2:47:11.78,Default,,0,0,0,,Гокураку Ойта Плаза
Dialogue: 0,2:47:15.26,2:47:17.49,Default,,0,0,0,,Дүкенде аяқ ваннасы бар ма?
Dialogue: 0,2:47:17.49,2:47:22.26,Default,,0,0,0,,Әй, жұмақ, жұмақ
Dialogue: 0,2:47:22.26,2:47:25.33,Default,,0,0,0,,Қаласаң келесің бе? көрші есік
Dialogue: 0,2:47:25.33,2:47:29.14,Default,,0,0,0,,Сондықтан мен жұмыстамын... Мен бұған көнбеймін.
Dialogue: 0,2:47:29.14,2:47:33.84,Default,,0,0,0,,Не? Мен жұмыс кезінде демалуға жақсы емеспін.
Dialogue: 0,2:47:33.84,2:47:36.91,Default,,0,0,0,,Бұл ұзаққа созылмайды.
Dialogue: 0,2:47:36.91,2:47:40.75,Default,,0,0,0,,Аа, Миямото мырза, сіз қай жерде дүниеге келдіңіз?
Dialogue: 0,2:47:40.75,2:47:43.22,Default,,0,0,0,,Хоккайдо, бірақ о
Dialogue: 0,2:47:43.22,2:47:46.89,Default,,0,0,0,,Егер сіз Хоккайдода болсаңыз, осы жерден кетіп, бұрышты оңға бұрыңыз.
Dialogue: 0,2:47:46.89,2:47:49.39,Default,,0,0,0,,Антенна дүкені бар.
Dialogue: 0,2:47:49.39,2:47:53.03,Default,,0,0,0,,Үлкен көлемді теңіз өнімдері, мысалы, краб және лосось етігі
Dialogue: 0,2:47:53.03,2:47:56.66,Default,,0,0,0,,Крокет және жұмсақ балмұздақ бар.
Dialogue: 0,2:47:56.66,2:47:59.93,Default,,0,0,0,,Жарайды, мен бұл жолы бармаймын, бірақ неге?
Dialogue: 0,2:47:59.93,2:48:04.81,Default,,0,0,0,,Иә? Барғың келді ме? О, жоқ...
Dialogue: 0,2:48:04.81,2:48:08.31,Default,,0,0,0,,Мен антенна дүкенін осыдан кейін шешіп қойдым.
Dialogue: 0,2:48:10.68,2:48:15.48,Default,,0,0,0,,Келе жатқан Ибараки префектурасы Ибараки Марке
Dialogue: 0,2:48:15.48,2:48:19.92,Default,,0,0,0,,Неліктен олай ойлайсың, Ибараки?
Dialogue: 0,2:48:19.92,2:48:22.72,Default,,0,0,0,,Жауап кеңсе қызметкері ме?
Dialogue: 0,2:48:22.72,2:48:26.03,Default,,0,0,0,,Шын мәнінде, антенна дүкенінің сатушылары міндетті емес
Dialogue: 0,2:48:26.03,2:48:28.96,Default,,0,0,0,,Бұл префектурадан болуы міндетті емес
Dialogue: 0,2:48:28.96,2:48:33.96,Default,,0,0,0,,Бірдеңе болса, мен жергілікті тұрғындар ұсынатын нәрсені көргім келеді.
Dialogue: 0,2:48:38.31,2:48:42.21,Default,,0,0,0,,Бинго Мен сізді қолдау үшін әлі де осындамын.
Dialogue: 0,2:48:42.21,2:48:45.35,Default,,0,0,0,,Жергілікті сауда палатасы
Dialogue: 0,2:48:45.35,2:48:48.82,Default,,0,0,0,,Ең жақсы жер - Ибараки төңірегі, өйткені оған асығу оңай.
Dialogue: 0,2:48:48.82,2:48:51.39,Default,,0,0,0,,Иә, иә, әке, қалыңыз қалай?
Dialogue: 0,2:48:51.39,2:48:54.59,Default,,0,0,0,,Қуырылған тәтті картопты ішу қазір бір кесе үшін 100 иен
Dialogue: 0,2:48:57.29,2:49:01.50,Default,,0,0,0,,Міне, келдік, мен естімеген тамаққа барайық.
Dialogue: 0,2:49:01.50,2:49:05.20,Default,,0,0,0,,Бір жылға созылған тәтті картоп
Dialogue: 0,2:49:05.20,2:49:07.83,Default,,0,0,0,,Бұл қауыннан үш есе тәтті!
Dialogue: 0,2:49:07.83,2:49:10.57,Default,,0,0,0,,Хо 3 рет?
Dialogue: 0,2:49:10.57,2:49:15.81,Default,,0,0,0,,Бұл ішуге болатын қуырылған тәтті картопты баяу қайнату арқылы жасайды.
Dialogue: 0,2:49:15.81,2:49:19.11,Default,,0,0,0,,Олай болса, әр уақытта бір ішу керек.
Dialogue: 0,2:49:24.75,2:49:27.12,Default,,0,0,0,,Уау, дәмді!
Dialogue: 0,2:49:27.12,2:49:30.02,Default,,0,0,0,,Бай, бірақ ішуге оңай
Dialogue: 0,2:49:30.02,2:49:35.40,Default,,0,0,0,,Эй, эй, болды ғой, солай ма? Картоп революциясы!
Dialogue: 0,2:49:35.40,2:49:37.76,Default,,0,0,0,,Әй, эй, ағаң ше?
Dialogue: 0,2:49:37.76,2:49:41.47,Default,,0,0,0,,А, жоқ, мен жұмыстамын.
Dialogue: 0,2:49:41.47,2:49:44.60,Default,,0,0,0,,Ах!
Dialogue: 0,2:49:44.60,2:49:46.61,Default,,0,0,0,,Secure Ah
Dialogue: 0,2:49:46.61,2:49:48.61,Default,,0,0,0,,Мен құнын төлеймін.
Dialogue: 0,2:49:48.61,2:49:50.61,Default,,0,0,0,,Жоқ, тоқтат, Оцуки.
Dialogue: 0,2:49:50.61,2:49:53.68,Default,,0,0,0,,Фуфуфуфу Ауызбен айтып жатқанда
Dialogue: 0,2:49:53.68,2:49:56.68,Default,,0,0,0,,Дене көп қарсылық көрсетпейді.
Dialogue: 0,2:49:59.02,2:50:02.99,Default,,0,0,0,,Жоқ, мен... осы жерде шынымды айтайын.
Dialogue: 0,2:50:02.99,2:50:05.69,Default,,0,0,0,,Бурари революциясы
Dialogue: 0,2:50:07.76,2:50:10.66,Default,,0,0,0,,Мен қазір... у...
Dialogue: 0,2:50:14.87,2:50:17.27,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,2:50:22.14,2:50:26.74,Default,,0,0,0,,Миямото бөгетін осы шағумен құлатыңыз
Dialogue: 0,2:50:30.45,2:50:33.32,Default,,0,0,0,,Осыдан кейін мен сауда палатасындағы ханымның айтқанын орындадым.
Dialogue: 0,2:50:33.32,2:50:35.59,Default,,0,0,0,,Шексіз дәм
Dialogue: 0,2:50:35.59,2:50:37.89,Default,,0,0,0,,Егер сіз оны сол күйінде байқасаңыз, жылжытыңыз
Dialogue: 0,2:50:37.89,2:50:41.43,Default,,0,0,0,,Ишикава префектурасының антенна дүкені Сакеномия
Dialogue: 0,2:50:41.43,2:50:45.27,Default,,0,0,0,,Паркте жеңіл тағамдар ретінде жергілікті тағамдармен сусын ішіңіз
Dialogue: 0,2:50:45.27,2:50:47.27,Default,,0,0,0,,Керемет ойын
Dialogue: 0,2:50:47.27,2:50:50.20,Default,,0,0,0,,Ахахха... хахахаха...
Dialogue: 0,2:50:50.20,2:50:53.14,Default,,0,0,0,,Миямото-сан, уақыт таяп қалды.
Dialogue: 0,2:50:53.14,2:50:56.98,Default,,0,0,0,,О? Жарайды. Бір сағаттай уақыт өтті.
Dialogue: 0,2:50:56.98,2:51:00.15,Default,,0,0,0,,Сол себепті... Жарайды, жарайды.
Dialogue: 0,2:51:00.15,2:51:03.32,Default,,0,0,0,,Бұл Миямото кешіреді!
Dialogue: 0,2:51:03.32,2:51:06.59,Default,,0,0,0,,Соңында қарсы алған қара киінген адамдар мені көтеріп алды.
Dialogue: 0,2:51:06.59,2:51:09.96,Default,,0,0,0,,Екеуі көлікте ұйықтап қалды
Dialogue: 0,2:51:09.96,2:51:13.06,Default,,0,0,0,,Тозақтың тозағы Мен түбінде болсам да
Dialogue: 0,2:51:13.06,2:51:15.83,Default,,0,0,0,,Күніңізден толық рахат алыңыз
Dialogue: 0,2:51:15.83,2:51:18.70,Default,,0,0,0,,Бұл шынымен де сән-салтанат.
Dialogue: 0,2:51:18.70,2:51:25.27,Default,,0,0,0,,Топ жетекшісі Отсуки Келесі күні қайда барасыз?
Dialogue: 0,2:51:25.27,2:51:27.57,Default,,0,0,0,,Келесі күні
Dialogue: 0,2:51:30.91,2:51:34.11,Default,,0,0,0,,Отсуки Сіздің келесі сапарыңыз қашан болады?
Dialogue: 0,2:51:34.11,2:51:36.31,Default,,0,0,0,,Олай болса.
Dialogue: 0,2:51:38.55,2:51:40.75,Default,,0,0,0,,Басты кейіпкер – қыран
Dialogue: 0,2:51:42.82,2:51:48.33,Default,,0,0,0,,Кацузава Бұл бір кездері Тон өзені шайқасқан ұрыс алаңы.
Dialogue: 0,2:51:48.33,2:51:52.93,Default,,0,0,0,,Хехе, бұл дүкенге бірінші рет келгенім үлкен қателік болды.
Dialogue: 0,2:51:52.93,2:51:57.64,Default,,0,0,0,,Бұл үлкен бөлік, басым көлем.
Dialogue: 0,2:51:57.64,2:52:02.68,Default,,0,0,0,,Бірақ бұл менің алғашқы күндерімнен жақсы естеліктер.
Dialogue: 0,2:52:02.68,2:52:06.48,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,2:52:06.48,2:52:10.15,Default,,0,0,0,,Дайынсың ба? 1 катсудон
Dialogue: 0,2:52:10.15,2:52:12.15,Default,,0,0,0,,Әйелдер өлшемінде
Dialogue: 0,2:52:12.15,2:52:14.69,Default,,0,0,0,,Иә, бұл әйелдерге арналған.
Dialogue: 0,2:52:14.69,2:52:20.36,Default,,0,0,0,,Иә, бұл мейрамханадағы катсудон орташа өлшемнен төмен кесілген.
Dialogue: 0,2:52:20.36,2:52:25.60,Default,,0,0,0,,Егер сіз мұны білмесеңіз және үлкен порцияға тапсырыс берсеңіз, бұл тозақ.
Dialogue: 0,2:52:25.60,2:52:30.47,Default,,0,0,0,,Сондықтан бұл жерде аздап ұят болса да, әйелдердің өлшемдері жеткілікті.
Dialogue: 0,2:52:30.47,2:52:33.67,Default,,0,0,0,,Кешіріңіз, менде үлкен кацудон тостаған бар.
Dialogue: 0,2:52:38.35,2:52:42.02,Default,,0,0,0,,Бұл Man Teiai жерасты еңбек нысаны E тобының жоғарғы бөлігі
Dialogue: 0,2:52:42.02,2:52:44.48,Default,,0,0,0,,Топ жетекшісі Отсуки
Dialogue: 0,2:52:44.48,2:52:48.76,Default,,0,0,0,,Бұл адам Теяй №2 топ Тонегава
Dialogue: 0,2:52:48.76,2:52:53.46,Default,,0,0,0,,Қандай кездейсоқтық, біз Кацузавада бірге болдық.
Dialogue: 0,2:52:53.46,2:52:55.53,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,2:52:55.53,2:52:58.70,Default,,0,0,0,,Менің үлкен үлесім... Жарайды, жарайды.
Dialogue: 0,2:52:58.70,2:53:00.80,Default,,0,0,0,,Менің аш болмағаныма көп болды.
Dialogue: 0,2:53:00.80,2:53:05.71,Default,,0,0,0,,Иә, бұл үлкен мәселе!
Dialogue: 0,2:53:05.71,2:53:08.94,Default,,0,0,0,,Хехехе, бұл жігіт білмейтін сияқты.
Dialogue: 0,2:53:08.94,2:53:12.78,Default,,0,0,0,,Мұндағы үлкен қызмет Бұрынғы қыран сияқты...
Dialogue: 0,2:53:12.78,2:53:14.98,Default,,0,0,0,,Кешіріңіз? иә?
Dialogue: 0,2:53:14.98,2:53:18.92,Default,,0,0,0,,Мен түсіндім, түсіндім, басымдық үлкен бөлік деп ойлаймын
Dialogue: 0,2:53:18.92,2:53:22.52,Default,,0,0,0,,Кацузава ережелері! Үлкен тапсырыс алсаңыз
Dialogue: 0,2:53:22.52,2:53:25.49,Default,,0,0,0,,Басқа тапсырыстарға қарағанда басымдылық
Dialogue: 0,2:53:25.49,2:53:28.76,Default,,0,0,0,,Тұрақты адамдарға ортақ мағына
Dialogue: 0,2:53:28.76,2:53:31.87,Default,,0,0,0,,Ой
Dialogue: 0,2:53:31.87,2:53:37.04,Default,,0,0,0,,Ух, әдеттегідей қатты және жын-шайтандық көлем
Dialogue: 0,2:53:37.04,2:53:39.97,Default,,0,0,0,,Хехе, шыдамсыз, шыдамсыз
Dialogue: 0,2:53:39.97,2:53:44.81,Default,,0,0,0,,Қалдық, ысырап, жан-жағыңа қарасаң да, өзің сұрағаның үшін жауапкершілігің.
Dialogue: 0,2:53:44.81,2:53:48.01,Default,,0,0,0,,Кацузава өте әділ
Dialogue: 0,2:53:48.01,2:53:53.15,Default,,0,0,0,,Мәзірде жазылғанша, ол туралы білмесеңіз өте алмайсыз.
Dialogue: 0,2:53:53.15,2:53:56.16,Default,,0,0,0,,Мәзірде жоқ, бірақ сұрасаң беріледі.
Dialogue: 0,2:53:56.16,2:53:58.99,Default,,0,0,0,,Тұздық Жапон бұрышы сияқты дәмдеуіштер
Dialogue: 0,2:53:58.99,2:54:01.96,Default,,0,0,0,,Егер сіз оны бір рет бастан өткерген болсаңыз, оны толық пайдаланыңыз.
Dialogue: 0,2:54:01.96,2:54:05.87,Default,,0,0,0,,Мен алдау мен алдаудың жасырын әдісін қолданамын.
Dialogue: 0,2:54:05.87,2:54:10.34,Default,,0,0,0,,Хехехе, мен саған олай айтпаймын.
Dialogue: 0,2:54:10.34,2:54:15.81,Default,,0,0,0,,Кешіріңіз, бірақ мен өзін-өзі сынайтындарды суретке түсіруді сұраймын.
Dialogue: 0,2:54:15.81,2:54:19.65,Default,,0,0,0,,Кейінірек келгіңіз келе ме? суретке түсіру?
Dialogue: 0,2:54:19.65,2:54:22.08,Default,,0,0,0,,Ах...
Dialogue: 0,2:54:22.08,2:54:26.45,Default,,0,0,0,,Хе, анау-мынау, алдыңғы қыранға қарап тұрғандай.
Dialogue: 0,2:54:26.45,2:54:30.19,Default,,0,0,0,,Бүркіт қайсысының баяу ләззат алуы керек?
Dialogue: 0,2:54:30.19,2:54:33.53,Default,,0,0,0,,Бұл қауіпсіздік қуанышы
Dialogue: 0,2:54:33.53,2:54:38.53,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,2:54:38.53,2:54:40.53,Default,,0,0,0,,Кенет бүркіт
Dialogue: 0,2:54:40.53,2:54:43.17,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,2:54:43.17,2:54:45.17,Default,,0,0,0,,О
Dialogue: 0,2:54:53.18,2:54:55.18,Default,,0,0,0,,Гах…
Dialogue: 0,2:54:55.18,2:54:58.99,Default,,0,0,0,,Жоқ, сіз оны Пелори деп атауға әлі жассыз.
Dialogue: 0,2:54:58.99,2:55:01.19,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,2:55:01.19,2:55:04.89,Default,,0,0,0,,Иә, егер сіз соншалықты көп жей алсаңыз.
Dialogue: 0,2:55:04.89,2:55:07.86,Default,,0,0,0,,Менің кейбір заттарым туралы не айтасыз?
Dialogue: 0,2:55:07.86,2:55:12.07,Default,,0,0,0,,Не? Баруыңызды өтінемін
Dialogue: 0,2:55:12.07,2:55:14.53,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,2:55:14.53,2:55:19.04,Default,,0,0,0,,Көңілсіз болмаңыз, өйткені сізге екінші көмек келеді, үлкен адам.
Dialogue: 0,2:55:19.04,2:55:23.11,Default,,0,0,0,,Мен үлкен порцияға өзім тапсырыс бердім, ал үлкен порция мен тапсырыс бергендей келді.
Dialogue: 0,2:55:23.11,2:55:25.61,Default,,0,0,0,,Көп жалама! Кацузава
Dialogue: 0,2:55:25.61,2:55:30.65,Default,,0,0,0,,Иә, көп айтпай, бәрін жеп көріңіз.
Dialogue: 0,2:55:30.65,2:55:33.65,Default,,0,0,0,,Егер сіз ер адам болсаңыз, бұл үлкен порцияның өлшеміне тең.
Dialogue: 0,2:55:36.16,2:55:40.79,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, ол әйелдер өлшемінде болады.
Dialogue: 0,2:55:40.79,2:55:43.79,Default,,0,0,0,,Иә... Мен... Ах...
Dialogue: 0,2:55:47.70,2:55:53.34,Default,,0,0,0,,Бұл жерде де өте ерке әйел болған сияқты.
Dialogue: 0,2:55:53.34,2:55:56.74,Default,,0,0,0,,Жоқ... жоқ бұл
Dialogue: 0,2:55:56.74,2:56:01.05,Default,,0,0,0,,А, өтінемін, алдымен ханымдар.
Dialogue: 0,2:56:01.05,2:56:04.45,Default,,0,0,0,,Гррр... хи хи хи
Dialogue: 0,2:56:04.45,2:56:06.89,Default,,0,0,0,,Бұл сөз отты тұтандырады
Dialogue: 0,2:56:06.89,2:56:11.99,Default,,0,0,0,,Тонегаваның мақтанышы шынымен де от!
Dialogue: 0,2:56:11.99,2:56:16.40,Default,,0,0,0,,Жоқ, бұл
Dialogue: 0,2:56:16.40,2:56:19.23,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,2:56:19.23,2:56:21.67,Default,,0,0,0,,Иә
Dialogue: 0,2:56:21.67,2:56:25.87,Default,,0,0,0,,Маған бұйырғандай үлкен порция әкеліңіз.
Dialogue: 0,2:56:29.24,2:56:32.74,Default,,0,0,0,,Иә, мен үлкен порция алдым!
Dialogue: 0,2:56:34.91,2:56:38.85,Default,,0,0,0,,Ер адамдар арасындағы тамаша адам.
Dialogue: 0,2:56:38.85,2:56:41.25,Default,,0,0,0,,Адамдар өте оңай өліп қалады, иә?
Dialogue: 0,2:56:41.25,2:56:46.65,Default,,0,0,0,,Күтпеген ашу! Керемет кездесу!
Dialogue: 0,2:56:50.06,2:56:54.76,Default,,0,0,0,,Өйткені, Тонегава мен Отсуки
Dialogue: 0,2:56:58.00,2:57:01.67,Default,,0,0,0,,Котлет теңізіне
Dialogue: 0,2:57:01.67,2:57:03.97,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,2:57:09.92,2:57:12.82,Default,,0,0,0,,Тон өзені Отсукиге қарсы
Dialogue: 0,2:57:16.72,2:57:19.56,Default,,0,0,0,,Жеңімпаз
Dialogue: 0,2:57:19.56,2:57:21.76,Default,,0,0,0,,Катсудон
Dialogue: 0,2:57:24.20,2:57:28.50,Default,,0,0,0,,Бұл котлет пен ер адамның мақтанышы арасында.
Dialogue: 0,2:57:28.50,2:57:33.81,Default,,0,0,0,,Бұл күрескен адамның әңгімесі.
Dialogue: 0,2:57:33.81,2:57:37.61,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,2:59:15.11,2:59:18.11,Default,,0,0,0,,Келесі жолы «Табиғи жау»
Dialogue: 0,3:02:01.21,3:02:07.65,Default,,0,0,0,,Теяй тобының жетекшісі және қараңғылық әлемінде билік жүргізетін құбыжық.
Dialogue: 0,3:02:07.65,3:02:10.05,Default,,0,0,0,,Казутака Хиодо
Dialogue: 0,3:02:10.05,3:02:14.99,Default,,0,0,0,,Ал жоғарғы басшылардың бірі болып табылатын және өзін екінші нөмірлі санайтын адам.
Dialogue: 0,3:02:14.99,3:02:17.72,Default,,0,0,0,,Юкио Тонегава
Dialogue: 0,3:02:17.72,3:02:21.99,Default,,0,0,0,,Дегенмен, бұл жерде Тейайдың №2 лауазымына қауіп төніп тұр.
Dialogue: 0,3:02:21.99,3:02:24.06,Default,,0,0,0,,Ең ықтимал кандидаттардың бірі
Dialogue: 0,3:02:24.06,3:02:29.00,Default,,0,0,0,,Тонегаваның бас жауы деуге болатын адам
Dialogue: 0,3:02:29.00,3:02:33.91,Default,,0,0,0,,Оның аты - Йошихиро Куросаки
Dialogue: 0,3:02:33.91,3:02:38.98,Default,,0,0,0,,Мойындайық, қалағаныңды істе, жігіттік
Dialogue: 0,3:02:38.98,3:02:44.02,Default,,0,0,0,,Ең дұрысы, аяқ астынан сыпырылып кетпеу үшін абай болу керек.
Dialogue: 0,3:02:44.02,3:02:47.69,Default,,0,0,0,,Түсіндім, тек бұған дайын болу керек.
Dialogue: 0,3:02:47.69,3:02:49.76,Default,,0,0,0,,Ичижоны жеңіңіз
Dialogue: 0,3:02:49.76,3:02:55.39,Default,,0,0,0,,Қол астындағыларға жанашырлық, мадақтау, сәбіз және таяқша
Dialogue: 0,3:02:55.39,3:02:59.47,Default,,0,0,0,,ерекше көзге түскен Йошихиро Куросаки
Dialogue: 0,3:02:59.47,3:03:01.87,Default,,0,0,0,,Әңгіме әлі алда.
Dialogue: 0,3:03:04.00,3:03:08.47,Default,,0,0,0,,Кукукуку Мен оны асыға күтемін.
Dialogue: 0,3:03:08.47,3:03:12.75,Default,,0,0,0,,Teiai қонақүйінің жоғарғы қабаты осы күзде ашылады
Dialogue: 0,3:03:12.75,3:03:15.45,Default,,0,0,0,,Бұл бүркітті өзі шығарған
Dialogue: 0,3:03:15.45,3:03:19.32,Default,,0,0,0,,Жоғары деңгейдегі мейрамхананың дәмін тату шарасы
Dialogue: 0,3:03:19.32,3:03:24.02,Default,,0,0,0,,Осыны ойлап қана аққан тамағымды тоқтата алмаймын.
Dialogue: 0,3:03:24.02,3:03:27.82,Default,,0,0,0,,Ноу? Ха, біз де тоқтай алмаймыз.
Dialogue: 0,3:03:30.00,3:03:33.50,Default,,0,0,0,,Төраға!
Dialogue: 0,3:03:33.50,3:03:35.90,Default,,0,0,0,,Солай болса да, бұл тым көп
Dialogue: 0,3:03:35.90,3:03:38.10,Default,,0,0,0,,Аңырау?
Dialogue: 0,3:03:41.14,3:03:43.14,Default,,0,0,0,,Иә...
Dialogue: 0,3:03:45.31,3:03:47.61,Default,,0,0,0,,О, Куросаки күткендей
Dialogue: 0,3:03:47.61,3:03:51.48,Default,,0,0,0,,Мұқият болмаңыз...
Dialogue: 0,3:03:51.48,3:03:53.95,Default,,0,0,0,,Мен ұялдым.
Dialogue: 0,3:03:53.95,3:03:57.02,Default,,0,0,0,,Жоқ, тағы да.
Dialogue: 0,3:03:57.02,3:03:59.29,Default,,0,0,0,,Бұл кісі үнемі осылай
Dialogue: 0,3:03:59.29,3:04:02.26,Default,,0,0,0,,Төрағаға айту қиын болған нәрселерді оңай айта аламын.
Dialogue: 0,3:04:02.26,3:04:04.30,Default,,0,0,0,,Маған қандай да бір себептермен ұнайды
Dialogue: 0,3:04:04.30,3:04:07.23,Default,,0,0,0,,Егер мен де дәл осылай айтсам...
Dialogue: 0,3:04:07.23,3:04:10.00,Default,,0,0,0,,Төраға, тым көп ағып жатырсыз.
Dialogue: 0,3:04:10.00,3:04:14.37,Default,,0,0,0,,А? Сен мені мазақ етіп тұрсың ба? санкциялар
Dialogue: 0,3:04:14.37,3:04:16.58,Default,,0,0,0,,Бұл міндетті түрде болады
Dialogue: 0,3:04:16.58,3:04:20.65,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,3:04:20.65,3:04:23.15,Default,,0,0,0,,Мен түсінбедім
Dialogue: 0,3:04:23.15,3:04:27.52,Default,,0,0,0,,Тон өзені Цурунумоямоя
Dialogue: 0,3:04:27.52,3:04:33.89,Default,,0,0,0,,Teiai Group алып компаниясының №2 Юкио Тонегава
Dialogue: 0,3:04:33.89,3:04:42.20,Default,,0,0,0,,Саяси және іскерлік әлемді басқаратын құбыжық. Ол төраға Хиодоның оң қолы болып көтерілген ашулы адам.
Dialogue: 0,3:04:42.20,3:04:45.44,Default,,0,0,0,,Бұл оның аңызының және даңқының астарында жатыр
Dialogue: 0,3:04:45.44,3:04:50.21,Default,,0,0,0,,Мен орта буын менеджері ретінде жасырын түрде қиналып, күресемін.
Dialogue: 0,3:04:50.21,3:04:57.71,Default,,0,0,0,,Ұлы адам туралы шағын әңгіме.
Dialogue: 0,3:06:27.27,3:06:29.28,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,3:06:29.28,3:06:35.21,Default,,0,0,0,,Бірінші тағам - ең жақсы ингредиенттерден жасалған құс ұясынан жасалған сорпа.
Dialogue: 0,3:06:35.21,3:06:37.71,Default,,0,0,0,,Ләззат алыңыз.
Dialogue: 0,3:06:42.79,3:06:46.03,Default,,0,0,0,,Иә? Мен өзімді тұзды сезінемін
Dialogue: 0,3:06:46.03,3:06:50.13,Default,,0,0,0,,Жоқ, бұл тұзды емес, ащы.
Dialogue: 0,3:06:58.47,3:07:02.91,Default,,0,0,0,,Теңіз суын ішкендей...
Dialogue: 0,3:07:02.91,3:07:06.61,Default,,0,0,0,,Сізге қалай ұнады, Хиодо мырза? Хмм
Dialogue: 0,3:07:06.61,3:07:11.05,Default,,0,0,0,,Концентрлі дәмі мен тәттілігі бар оңай ішілетін сорпа
Dialogue: 0,3:07:11.05,3:07:14.02,Default,,0,0,0,,Е... Рахмет.
Dialogue: 0,3:07:14.02,3:07:17.49,Default,,0,0,0,,Ноу Тонегава...
Dialogue: 0,3:07:17.49,3:07:21.36,Default,,0,0,0,,Иә Өте тәтті және ішуге оңай
Dialogue: 0,3:07:21.36,3:07:25.90,Default,,0,0,0,,Жоқ, бұл тұзды емес пе?
Dialogue: 0,3:07:25.90,3:07:28.53,Default,,0,0,0,,Какака! Әрине
Dialogue: 0,3:07:28.53,3:07:32.07,Default,,0,0,0,,Менен сұрасаңыз, тым тұзды екені анық.
Dialogue: 0,3:07:32.07,3:07:35.17,Default,,0,0,0,,Керемет дәмдеуіш, иә?
Dialogue: 0,3:07:35.17,3:07:37.64,Default,,0,0,0,,Куросаки күткендей, №.
Dialogue: 0,3:07:37.64,3:07:42.18,Default,,0,0,0,,Сіз мұны естідіңіз бе? Менеджер, кешіріңіз.
Dialogue: 0,3:07:42.18,3:07:45.92,Default,,0,0,0,,Тонегава мырзаның талғамына сай келетін сияқты.
Dialogue: 0,3:07:45.92,3:07:50.09,Default,,0,0,0,,Егер сізге ұнаса, маған да жасап беріңізші...
Dialogue: 0,3:07:50.09,3:07:53.39,Default,,0,0,0,,Мен де...
Dialogue: 0,3:07:53.39,3:07:56.69,Default,,0,0,0,,Иә... Мен тұзды қадағалаймын.
Dialogue: 0,3:07:58.76,3:08:02.60,Default,,0,0,0,,Қан қысымының көтерілуі, шекті бұзу
Dialogue: 0,3:08:02.60,3:08:04.64,Default,,0,0,0,,Неге?
Dialogue: 0,3:08:04.64,3:08:09.04,Default,,0,0,0,,Неліктен бұл жігіт әрқашан алға ұмтылады?
Dialogue: 0,3:08:09.04,3:08:14.98,Default,,0,0,0,,Куросаки Хиодоның мина алаңының бөгетін оңай бұзады.
Dialogue: 0,3:08:14.98,3:08:17.98,Default,,0,0,0,,Тон өзені уақытынан бұрын басқарылады
Dialogue: 0,3:08:20.32,3:08:24.62,Default,,0,0,0,,Сен неге минаны баспайсың?
Dialogue: 0,3:08:24.62,3:08:27.82,Default,,0,0,0,,Күте тұрыңыз, мүмкін бұл дегенді білдіреді
Dialogue: 0,3:08:38.77,3:08:41.67,Default,,0,0,0,,Иә? Куросаки не болды?
Dialogue: 0,3:08:41.67,3:08:46.17,Default,,0,0,0,,Жоқ, бұл стейк сәл тым қатты, мен оны тістей алмаймын.
Dialogue: 0,3:08:48.21,3:08:50.38,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,3:08:50.38,3:08:52.92,Default,,0,0,0,,Мүмкіндікті пайдаланыңыз
Dialogue: 0,3:08:52.92,3:08:57.59,Default,,0,0,0,,Мен де, мен тым қаталмын ба?
Dialogue: 0,3:08:57.59,3:09:02.60,Default,,0,0,0,,Кукуку Бұл стейк тым қатты екені сөзсіз.
Dialogue: 0,3:09:02.60,3:09:05.20,Default,,0,0,0,,Екеуің айтқандай, жарайды.
Dialogue: 0,3:09:08.70,3:09:12.84,Default,,0,0,0,,Жақсы орналастырылған, Куросакидің артында қауіпсіз
Dialogue: 0,3:09:12.84,3:09:15.01,Default,,0,0,0,,Тонегаваның идеясы
Dialogue: 0,3:09:15.01,3:09:17.98,Default,,0,0,0,,Артқы жағына дәл бекітілетін даму
Dialogue: 0,3:09:17.98,3:09:21.41,Default,,0,0,0,,Содан кейін тағы бір қадам
Dialogue: 0,3:09:21.41,3:09:25.52,Default,,0,0,0,,Бұл енді стейк емес, резеңке табан.
Dialogue: 0,3:09:25.52,3:09:29.66,Default,,0,0,0,,Куросакиді жеңу
Dialogue: 0,3:09:29.66,3:09:32.56,Default,,0,0,0,,Егер бұл
Dialogue: 0,3:09:32.56,3:09:37.13,Default,,0,0,0,,Не? Резеңке табаны? мм...
Dialogue: 0,3:09:37.13,3:09:40.53,Default,,0,0,0,,Қас бұрышы 40 градус Ah...
Dialogue: 0,3:09:40.53,3:09:43.40,Default,,0,0,0,,Қазірдің өзінде қызыл аймақта
Dialogue: 0,3:09:43.40,3:09:46.11,Default,,0,0,0,,Резеңке табан деп айттыңыз ба? қазір
Dialogue: 0,3:09:46.11,3:09:50.68,Default,,0,0,0,,Жоқ, жоқ, бұл резеңке табан емес...
Dialogue: 0,3:09:50.68,3:09:54.08,Default,,0,0,0,,45 градус Сыну нүктесінен өту
Dialogue: 0,3:09:54.08,3:09:56.95,Default,,0,0,0,,Өтінемін...
Dialogue: 0,3:09:56.95,3:10:00.99,Default,,0,0,0,,50 градусқа одан әрі өсу
Dialogue: 0,3:10:00.99,3:10:05.39,Default,,0,0,0,,Ең маңыздысы
Dialogue: 0,3:10:05.39,3:10:07.86,Default,,0,0,0,,Мен көремін.
Dialogue: 0,3:10:07.86,3:10:12.63,Default,,0,0,0,,Бастапқы күйге келтіру Қауіпсіздік аймағы
Dialogue: 0,3:10:12.63,3:10:15.03,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,3:10:18.20,3:10:21.40,Default,,0,0,0,,Жаңа ғана минаны басып қалдым
Dialogue: 0,3:10:23.78,3:10:27.15,Default,,0,0,0,,Дәл қасында, дәл уақытында!
Dialogue: 0,3:10:27.15,3:10:30.18,Default,,0,0,0,,Иә, мен сені тастап кете алмаймын.
Dialogue: 0,3:10:30.18,3:10:32.65,Default,,0,0,0,,Мен әлі біртүрлі сезінбеймін.
Dialogue: 0,3:10:32.65,3:10:36.36,Default,,0,0,0,,Ең дұрысы, бәрібір орындаңыз.
Dialogue: 0,3:10:36.36,3:10:38.76,Default,,0,0,0,,Куросакидің артында
Dialogue: 0,3:10:41.13,3:10:46.10,Default,,0,0,0,,Әйтеуір, соңғы кездері қатты тітіркенетін болдым.
Dialogue: 0,3:10:46.10,3:10:48.67,Default,,0,0,0,,Кальций жеткіліксіз бе?
Dialogue: 0,3:10:48.67,3:10:51.37,Default,,0,0,0,,Хахаха сен не айтып тұрсың?
Dialogue: 0,3:10:51.37,3:10:53.77,Default,,0,0,0,,Төрағаның ашуы кальций т.б.
Dialogue: 0,3:10:53.77,3:10:55.94,Default,,0,0,0,,Оны басқаруға болмайды.
Dialogue: 0,3:10:55.94,3:10:58.58,Default,,0,0,0,,Кальций маған да жұмыс істемейді деп ойлаймын.
Dialogue: 0,3:10:58.58,3:11:01.75,Default,,0,0,0,,Каккакка Иә, бұл рас.
Dialogue: 0,3:11:01.75,3:11:04.02,Default,,0,0,0,,Дәлірек айтқанда, туғаннан.
Dialogue: 0,3:11:04.02,3:11:08.05,Default,,0,0,0,,Төрағаның ашушаңдығы туа біткен нәрсе емес пе?
Dialogue: 0,3:11:08.05,3:11:11.32,Default,,0,0,0,,Толығымен келісемін
Dialogue: 0,3:11:11.32,3:11:13.99,Default,,0,0,0,,аңырап қалды
Dialogue: 0,3:11:13.99,3:11:17.40,Default,,0,0,0,,Бірақ белгілі бір жайсыздық сезімі бар.
Dialogue: 0,3:11:17.40,3:11:19.87,Default,,0,0,0,,Амансың ба? бұл ағын
Dialogue: 0,3:11:19.87,3:11:26.67,Default,,0,0,0,,Ішінде бірдеңе бар ма? қауіпті аймаққа
Dialogue: 0,3:11:26.67,3:11:29.34,Default,,0,0,0,,Бұл шынымен де қауіпті аймақ
Dialogue: 0,3:11:29.34,3:11:31.48,Default,,0,0,0,,Қауіпті аймақ
Dialogue: 0,3:11:31.48,3:11:35.58,Default,,0,0,0,,Каккакка Мұны айту өте қиын. Екеуі де.
Dialogue: 0,3:11:35.58,3:11:39.08,Default,,0,0,0,,Міне, төраға күледі.
Dialogue: 0,3:11:39.08,3:11:42.99,Default,,0,0,0,,Ал, төраға үш күн бойы жақсы көңіл-күйде болды деп ойладым.
Dialogue: 0,3:11:42.99,3:11:46.26,Default,,0,0,0,,Жаңбыр жауады ма деп уайымдап отырмын.
Dialogue: 0,3:11:46.26,3:11:49.73,Default,,0,0,0,,Каккакка куккук
Dialogue: 0,3:11:49.73,3:11:54.67,Default,,0,0,0,,Қарлы жаңбырдың орнына үстіме найза жауа ма деп ойлаймын.
Dialogue: 0,3:11:54.67,3:11:58.14,Default,,0,0,0,,Әй?
Dialogue: 0,3:11:58.14,3:12:00.57,Default,,0,0,0,,Иә?
Dialogue: 0,3:12:00.57,3:12:04.28,Default,,0,0,0,,және Тонегава мырза
Dialogue: 0,3:12:04.28,3:12:06.95,Default,,0,0,0,,Күтілгендей, бұл асыра сілтеу
Dialogue: 0,3:12:06.95,3:12:10.18,Default,,0,0,0,,Не? Найзаны шығару?
Dialogue: 0,3:12:10.18,3:12:12.92,Default,,0,0,0,,Тонегава мырза, солай ма?
Dialogue: 0,3:12:12.92,3:12:17.56,Default,,0,0,0,,Сен мені мазақ етесің бе? О, мына қыран?
Dialogue: 0,3:12:17.56,3:12:22.19,Default,,0,0,0,,Тонегавадағы төтенше жағдай
Dialogue: 0,3:12:22.19,3:12:26.57,Default,,0,0,0,,Уф... мына жігіт қисық екен.
Dialogue: 0,3:12:26.57,3:12:29.94,Default,,0,0,0,,Куросаки Күтпеген тік бұрыш қисығы
Dialogue: 0,3:12:29.94,3:12:32.34,Default,,0,0,0,,Додж қауіпті аймағы
Dialogue: 0,3:12:32.34,3:12:35.01,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,3:12:35.01,3:12:37.71,Default,,0,0,0,,Аузыңды жап! Соңында...
Dialogue: 0,3:12:37.71,3:12:40.51,Default,,0,0,0,,Уау Уау
Dialogue: 0,3:12:40.51,3:12:44.92,Default,,0,0,0,,Тонегаваның қонуы Хиодо Клэймор
Dialogue: 0,3:12:44.92,3:12:48.39,Default,,0,0,0,,Санкциялар Санкциялар Санкциялар Санкциялар
Dialogue: 0,3:12:48.39,3:12:52.29,Default,,0,0,0,,Мен шекараны түсінбеймін! Санкциялар Санкциялар Санкциялар…
Dialogue: 0,3:12:59.50,3:13:02.30,Default,,0,0,0,,Құдай-ай, сен мені мазақ етіп тұрсың ғой.
Dialogue: 0,3:13:02.30,3:13:05.60,Default,,0,0,0,,Бұл жылқы ма? Ферма меңгерушісі ха
Dialogue: 0,3:13:05.60,3:13:08.84,Default,,0,0,0,,Плефевр және Дүйсенбі үнсіздігінің тегі бар.
Dialogue: 0,3:13:08.84,3:13:10.98,Default,,0,0,0,,Даусыз асыл тұқымды
Dialogue: 0,3:13:10.98,3:13:14.95,Default,,0,0,0,,Хиодо-саманы үлкен биіктерге апаратыныңызға сенімдімін.
Dialogue: 0,3:13:14.95,3:13:17.75,Default,,0,0,0,,Иә, сіз қалай ойлайсыз? Тон өзені
Dialogue: 0,3:13:17.75,3:13:23.19,Default,,0,0,0,,Ха, оның ең жақсы тұқымы ғана емес, оның еті мен жүні де керемет.
Dialogue: 0,3:13:23.19,3:13:26.99,Default,,0,0,0,,Төрағаға мінсіз жүйрік ат па?
Dialogue: 0,3:13:26.99,3:13:30.20,Default,,0,0,0,,Кака, сен де солай ойлайсың ба?
Dialogue: 0,3:13:30.20,3:13:34.10,Default,,0,0,0,,Жарайды, мен оны сатып алдым. А, рахмет!
Dialogue: 0,3:13:34.10,3:13:36.47,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,3:13:36.47,3:13:40.74,Default,,0,0,0,,Бүркіттей сұлу ақ жал
Dialogue: 0,3:13:40.74,3:13:43.54,Default,,0,0,0,,Жарайды, сенің атың кім?
Dialogue: 0,3:13:46.45,3:13:49.05,Default,,0,0,0,,Қазутақайзер
Dialogue: 0,3:13:51.45,3:13:54.95,Default,,0,0,0,,Қазутақайзерді атау
Dialogue: 0,3:13:54.95,3:13:57.06,Default,,0,0,0,,Керемет Керемет!
Dialogue: 0,3:13:57.06,3:13:59.06,Default,,0,0,0,,Какака иә?
Dialogue: 0,3:13:59.06,3:14:03.60,Default,,0,0,0,,Какака, анау тозығы жеткен ат ше?
Dialogue: 0,3:14:03.60,3:14:06.13,Default,,0,0,0,,Жарайды, Тонегава, оны да сатып алуға болады.
Dialogue: 0,3:14:06.13,3:14:09.30,Default,,0,0,0,,Не? Бұл ат сізге өте ыңғайлы.
Dialogue: 0,3:14:09.30,3:14:13.11,Default,,0,0,0,,Жоқ, жоқ, төраға, сіз кенеттен не істеп жатырсыз?
Dialogue: 0,3:14:13.11,3:14:15.81,Default,,0,0,0,,Аты...
Dialogue: 0,3:14:19.04,3:14:21.24,Default,,0,0,0,,Юкио туралы шешім қабылдады
Dialogue: 0,3:14:25.15,3:14:27.62,Default,,0,0,0,,Юкиоға ат қою
Dialogue: 0,3:14:27.62,3:14:31.26,Default,,0,0,0,,Юкио! Юкио!
Dialogue: 0,3:14:31.26,3:14:35.19,Default,,0,0,0,,керемет тамаша
Dialogue: 0,3:14:35.19,3:14:40.40,Default,,0,0,0,,...
Dialogue: 0,3:14:40.40,3:14:44.07,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,3:14:44.07,3:14:46.41,Default,,0,0,0,,Екі жылдан кейін
Dialogue: 0,3:14:46.41,3:14:49.01,Default,,0,0,0,,Юкионың жылдам алға жылжуы
Dialogue: 0,3:14:49.01,3:14:52.14,Default,,0,0,0,,Әдетте мен бақытты болар едім, бірақ
Dialogue: 0,3:14:52.14,3:14:54.78,Default,,0,0,0,,Жоқ! Бұл тақырып!
Dialogue: 0,3:14:54.78,3:14:56.85,Default,,0,0,0,,Өйткені Қазутақайсердің ісі дұрыс болмады.
Dialogue: 0,3:14:56.85,3:15:02.65,Default,,0,0,0,,Соңғы кездері мен төраға мен аттар туралы айтудан қашатын болдым, өйткені бұл өзімді ыңғайсыз сезінеді.
Dialogue: 0,3:15:04.92,3:15:07.99,Default,,0,0,0,,Хмм...
Dialogue: 0,3:15:07.99,3:15:10.06,Default,,0,0,0,,Моши Моши
Dialogue: 0,3:15:10.06,3:15:12.40,Default,,0,0,0,,Мен... Төрағамын
Dialogue: 0,3:15:12.40,3:15:14.40,Default,,0,0,0,,Не болды?
Dialogue: 0,3:15:14.40,3:15:17.10,Default,,0,0,0,,Мен көмектесе алмаймын. Атқораға барайық.
Dialogue: 0,3:15:17.10,3:15:19.20,Default,,0,0,0,,Иә?
Dialogue: 0,3:15:21.21,3:15:24.98,Default,,0,0,0,,Хмм, менің ойымша, сізде талант жеткілікті.
Dialogue: 0,3:15:24.98,3:15:27.01,Default,,0,0,0,,Қазутақайзер
Dialogue: 0,3:15:27.01,3:15:30.35,Default,,0,0,0,,Нәтижелеріңіз мүлде жақсармайды.
Dialogue: 0,3:15:30.35,3:15:36.12,Default,,0,0,0,,Онымен салыстырғанда жақсырақ, солай емес пе? Юкио?
Dialogue: 0,3:15:36.12,3:15:39.19,Default,,0,0,0,,Мүмкін біз де келесі Ясуока кубогына бара алармыз.
Dialogue: 0,3:15:39.19,3:15:43.43,Default,,0,0,0,,Төрағаның алдында бұлай айтуды доғар.
Dialogue: 0,3:15:43.43,3:15:47.03,Default,,0,0,0,,Каккакка Каккакка мен көремін.
Dialogue: 0,3:15:47.03,3:15:50.40,Default,,0,0,0,,Не? Өзіңізді қалай сезінесіз?
Dialogue: 0,3:15:50.40,3:15:54.54,Default,,0,0,0,,Өкінішті, мен көмектесе алмаймын
Dialogue: 0,3:15:54.54,3:15:57.44,Default,,0,0,0,,Бұл жай ғана жолға оралу.
Dialogue: 0,3:15:57.44,3:16:01.04,Default,,0,0,0,,Ноу Казутакайзер иә?
Dialogue: 0,3:16:03.08,3:16:05.85,Default,,0,0,0,,Хаха Төраға, бұл Юкио
Dialogue: 0,3:16:05.85,3:16:08.15,Default,,0,0,0,,Ноу Тонегава? иә?
Dialogue: 0,3:16:08.15,3:16:10.82,Default,,0,0,0,,Сіз де солай ойлайсыз, солай ма?
Dialogue: 0,3:16:10.82,3:16:14.12,Default,,0,0,0,,Бұл Қазутайзер бұдан былай болады.
Dialogue: 0,3:16:16.40,3:16:20.90,Default,,0,0,0,,Айтпағым, әлгі ат Қазұтақайсер емес еді.
Dialogue: 0,3:16:20.90,3:16:22.90,Default,,0,0,0,,Юкио
Dialogue: 0,3:16:22.90,3:16:26.14,Default,,0,0,0,,Төрағаның әрекеті мынау
Dialogue: 0,3:16:26.14,3:16:30.14,Default,,0,0,0,,Бағыныштының тамаша атын өз жылқысына ауыстыру
Dialogue: 0,3:16:32.48,3:16:36.11,Default,,0,0,0,,Әдетте кешірілмейтін үстемдік
Dialogue: 0,3:16:36.11,3:16:38.88,Default,,0,0,0,,Қатты бас тарту сөзсіз
Dialogue: 0,3:16:38.88,3:16:43.42,Default,,0,0,0,,Бірақ Тонегава осы уақытқа дейін жауап беруді жалғастырды.
Dialogue: 0,3:16:43.42,3:16:48.63,Default,,0,0,0,,Төрағаның өзін-өзі ақтауы мүмкін емес тапсырма
Dialogue: 0,3:16:48.63,3:16:52.53,Default,,0,0,0,,Күлімсіреп, барлығына иә деп айт.
Dialogue: 0,3:16:52.53,3:16:56.87,Default,,0,0,0,,Осылайша мен 2-ші орынға көтерілдім.
Dialogue: 0,3:16:56.87,3:16:59.87,Default,,0,0,0,,Демек, бұл Тон өзені үшін бір нәрсе.
Dialogue: 0,3:16:59.87,3:17:03.71,Default,,0,0,0,,Тейайда қалай аман қалу керек
Dialogue: 0,3:17:03.71,3:17:08.21,Default,,0,0,0,,Мен төрағаның өзімшілдігіне шыдай бердім, ал қасымдағылар құлап кетті.
Dialogue: 0,3:17:08.21,3:17:12.02,Default,,0,0,0,,Сондықтан біз қазір бармыз
Dialogue: 0,3:17:12.02,3:17:18.96,Default,,0,0,0,,Сондықтан бір ғана таңдау Тонегаваның жауабы анық
Dialogue: 0,3:17:18.96,3:17:24.66,Default,,0,0,0,,Ха, басталғалы жатыр. Бұл қазутайзер басталғалы тұр.
Dialogue: 0,3:17:26.93,3:17:28.93,Default,,0,0,0,,ауыстырылды
Dialogue: 0,3:17:28.93,3:17:34.31,Default,,0,0,0,,Төраға Юкио Казутзерді шақырғанда.
Dialogue: 0,3:17:34.31,3:17:39.81,Default,,0,0,0,,Казутакайсер еріксіз Юкиоға барады.
Dialogue: 0,3:17:39.81,3:17:44.68,Default,,0,0,0,,Казутакайзер мен Юкио орындарын ауыстырады
Dialogue: 0,3:17:44.68,3:17:49.52,Default,,0,0,0,,Және бірнеше апта
Dialogue: 0,3:17:49.52,3:17:54.83,Default,,0,0,0,,Екі ат Ясуока кубогында соқтығысады
Dialogue: 0,3:17:54.83,3:17:56.96,Default,,0,0,0,,Токио 11-ші жарыс
Dialogue: 0,3:17:56.96,3:18:00.77,Default,,0,0,0,,45-ші Ясуока кубогына арналған паддок
Dialogue: 0,3:18:00.77,3:18:04.54,Default,,0,0,0,,No 1 Қазутақайзер плюс 32 кг
Dialogue: 0,3:18:04.54,3:18:08.34,Default,,0,0,0,,Бұл өте үлкен болды. Мен мұны байқамай тұра алмаймын.
Dialogue: 0,3:18:08.34,3:18:11.88,Default,,0,0,0,,Тіпті түсі өзгерген сияқты.
Dialogue: 0,3:18:11.88,3:18:15.85,Default,,0,0,0,,No 2 Юкио минус 32 кг
Dialogue: 0,3:18:15.85,3:18:17.92,Default,,0,0,0,,Бұл тым тар ма?
Dialogue: 0,3:18:17.92,3:18:21.12,Default,,0,0,0,,Менің жалымның ағарғаны дұрыс па?
Dialogue: 0,3:18:26.16,3:18:30.73,Default,,0,0,0,,Каккаккакка Бұл өте шедевр болса керек.
Dialogue: 0,3:18:30.73,3:18:35.10,Default,,0,0,0,,Күннен қорғайтын көзілдірік қажет емес А, рахмет
Dialogue: 0,3:18:35.10,3:18:38.10,Default,,0,0,0,,Қараңызшы, сіз келесідесіз, иә?
Dialogue: 0,3:18:41.94,3:18:44.44,Default,,0,0,0,,Бұл қозғалмайды...
Dialogue: 0,3:18:44.44,3:18:48.81,Default,,0,0,0,,Сонда да төрағаның күші қорқынышты
Dialogue: 0,3:18:48.81,3:18:52.31,Default,,0,0,0,,Жылқыларды ауыстыру шынымен мүмкін бе?
Dialogue: 0,3:18:55.35,3:18:58.42,Default,,0,0,0,,Иә? Бұл керісінше емес пе?
Dialogue: 0,3:18:58.42,3:19:03.50,Default,,0,0,0,,Юкио мен Казутакайзер Сәлем! Куросаки!
Dialogue: 0,3:19:03.50,3:19:06.53,Default,,0,0,0,,Тон өзені арқылы соққы өтеді
Dialogue: 0,3:19:06.53,3:19:09.10,Default,,0,0,0,,Ақымақ ссххх жоқ жоқ
Dialogue: 0,3:19:09.10,3:19:11.47,Default,,0,0,0,,Аты айтып тұрғандай, Қазутақайсер
Dialogue: 0,3:19:11.47,3:19:13.47,Default,,0,0,0,,Төраға сияқты жалмен
Dialogue: 0,3:19:13.47,3:19:15.84,Default,,0,0,0,,Жарайды, жарайды, хмм.
Dialogue: 0,3:19:15.84,3:19:18.21,Default,,0,0,0,,Түсінбейсіз бе, Тонегава мырза?
Dialogue: 0,3:19:18.21,3:19:20.65,Default,,0,0,0,,Төраға, ақымақ!
Dialogue: 0,3:19:20.65,3:19:23.32,Default,,0,0,0,,Бірінші атқа қараңдар.
Dialogue: 0,3:19:23.32,3:19:26.45,Default,,0,0,0,,Бұл Юкио, Казутакайзер емес.
Dialogue: 0,3:19:26.45,3:19:29.35,Default,,0,0,0,,Мен... Мм...
Dialogue: 0,3:19:36.73,3:19:41.83,Default,,0,0,0,,Каккакка! Куросаки әрқашан қызықты нәрселерді айтады.
Dialogue: 0,3:19:41.83,3:19:45.54,Default,,0,0,0,,Не? Қалай қарасаңыз да, бұл...
Dialogue: 0,3:19:45.54,3:19:48.61,Default,,0,0,0,,Бұл Қазутақайсер, төраға.
Dialogue: 0,3:19:48.61,3:19:51.44,Default,,0,0,0,,Дәл қазір Юкио айтқың келмеді ме?
Dialogue: 0,3:19:51.44,3:19:57.02,Default,,0,0,0,,Каккакка Солай ма? Қарғыс атсын.
Dialogue: 0,3:19:57.02,3:20:00.42,Default,,0,0,0,,Неліктен? Төрағаның бірнеше таңдаулы сұрағы
Dialogue: 0,3:20:00.42,3:20:06.76,Default,,0,0,0,,Бұл жігіттің өзі ғана сабырмен жоқ деп айта алады.
Dialogue: 0,3:20:06.76,3:20:11.00,Default,,0,0,0,,Дегенмен, қандай да бір себептермен маған ұнайды.
Dialogue: 0,3:20:11.00,3:20:14.03,Default,,0,0,0,,Каккакка Каккаккакка
Dialogue: 0,3:20:14.03,3:20:16.60,Default,,0,0,0,,Төраға дірілдеп жатыр
Dialogue: 0,3:20:16.60,3:20:18.74,Default,,0,0,0,,Апыр-ай, жақсы болды. Сонымен, іс шешілді ғой?
Dialogue: 0,3:20:18.74,3:20:23.14,Default,,0,0,0,,Түсінбейтін Тон өзені басым бұлыңғыр
Dialogue: 0,3:20:27.11,3:20:31.75,Default,,0,0,0,,Енді барлық аттар квотаға қойылған сияқты.
Dialogue: 0,3:20:31.75,3:20:34.39,Default,,0,0,0,,Басталды аааааа
Dialogue: 0,3:20:34.39,3:20:38.36,Default,,0,0,0,,Не? №1: Мен ол жерден жол таба алмаймын.
Dialogue: 0,3:20:38.36,3:20:41.76,Default,,0,0,0,,Біз өте кешігіп қалдық.
Dialogue: 0,3:20:41.76,3:20:45.50,Default,,0,0,0,,Біріншісі - Юкио, одан кейін 7 саны Арнесс Жасы
Dialogue: 0,3:20:45.50,3:20:48.83,Default,,0,0,0,,және №11: Микоко но Чикара Гугугу…
Dialogue: 0,3:20:48.83,3:20:53.10,Default,,0,0,0,,Бар, бар, Қазутақайсер
Dialogue: 0,3:20:53.10,3:20:55.94,Default,,0,0,0,,Қазіргі Қазутақайзерден сұраңыз
Dialogue: 0,3:20:55.94,3:20:58.54,Default,,0,0,0,,Ескі Юкио! Бар!
Dialogue: 0,3:21:01.71,3:21:06.65,Default,,0,0,0,,300 метр қалды, мұнда шайқас қатты өзгереді.
Dialogue: 0,3:21:06.65,3:21:09.85,Default,,0,0,0,,Қазутақайсер кешіксе де келді.
Dialogue: 0,3:21:09.85,3:21:14.13,Default,,0,0,0,,Қаһарлы қуып жетіп, жетекшіге тез жақындады
Dialogue: 0,3:21:14.13,3:21:17.43,Default,,0,0,0,,О! Казутакайзер немесе Юкио?
Dialogue: 0,3:21:17.43,3:21:21.27,Default,,0,0,0,,Юкио немесе Казутакайзер? Google...
Dialogue: 0,3:21:21.27,3:21:23.67,Default,,0,0,0,,Барыңыз, жай ғана тартып алыңыз!
Dialogue: 0,3:21:23.67,3:21:25.94,Default,,0,0,0,,Юки... Казутакайзер
Dialogue: 0,3:21:25.94,3:21:28.84,Default,,0,0,0,,Бар, бар, Қазутақайсер
Dialogue: 0,3:21:28.84,3:21:31.48,Default,,0,0,0,,Ескі Юкио! Ол келе ме?
Dialogue: 0,3:21:31.48,3:21:34.65,Default,,0,0,0,,Жауап бересіз бе? Тонегаваның ойлары
Dialogue: 0,3:21:34.65,3:21:37.82,Default,,0,0,0,,Қазіргі Қазутакайзер Бұрынғы Юкио
Dialogue: 0,3:21:37.82,3:21:40.49,Default,,0,0,0,,Қазутақайзерге барыңыз
Dialogue: 0,3:21:40.49,3:21:43.52,Default,,0,0,0,,Сұра, жең, қарт Юкио
Dialogue: 0,3:21:43.52,3:21:45.99,Default,,0,0,0,,Тон өзені Жүрек тебірентер дұға
Dialogue: 0,3:21:45.99,3:21:50.53,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз, қазіргі Казутакайзер, бұрынғы Юкио
Dialogue: 0,3:21:50.53,3:21:55.33,Default,,0,0,0,,Қазутайқайсер Қазутақайсер Қазутақайсер
Dialogue: 0,3:21:55.33,3:21:59.67,Default,,0,0,0,,Ескі Юкио Ескі Юкио Ескі Юкио
Dialogue: 0,3:21:59.67,3:22:02.47,Default,,0,0,0,,Қазутақайсер Қазутақайсер
Dialogue: 0,3:22:02.47,3:22:04.91,Default,,0,0,0,,Ескі Юкио Ескі Юкио
Dialogue: 0,3:22:04.91,3:22:07.38,Default,,0,0,0,,Ах! Ыстық іздеу!
Dialogue: 0,3:22:07.38,3:22:12.72,Default,,0,0,0,,Арасында тағы біреуі! №8 Макросаки!
Dialogue: 0,3:22:12.72,3:22:16.89,Default,,0,0,0,,А-а, менің атым.
Dialogue: 0,3:22:16.89,3:22:19.09,Default,,0,0,0,,Иә
Dialogue: 0,3:22:24.60,3:22:27.50,Default,,0,0,0,,Мен оны енгіздім! № 8 МакКроссаки
Dialogue: 0,3:22:27.50,3:22:30.07,Default,,0,0,0,,1-орын мәре сызығы
Dialogue: 0,3:22:30.07,3:22:32.27,Default,,0,0,0,,Ой, сен істедің, анау жігіт.
Dialogue: 0,3:22:34.54,3:22:36.57,Default,,0,0,0,,Күтпеген шабуыл
Dialogue: 0,3:22:36.57,3:22:39.84,Default,,0,0,0,,Куросакидің сүйікті жылқысы Макросаки
Dialogue: 0,3:22:39.84,3:22:44.85,Default,,0,0,0,,Тонегава Хиодо дауыссыз
Dialogue: 0,3:22:44.85,3:22:49.32,Default,,0,0,0,,Бұл бастық, төраға және оның бағыныштысы, қара костюм.
Dialogue: 0,3:22:49.32,3:22:53.96,Default,,0,0,0,,Ал кейде екінші нөмірге қауіп төндіретін басшылармен.
Dialogue: 0,3:22:53.96,3:22:58.83,Default,,0,0,0,,Күрес Бұл бір адамның әңгімесі.
Dialogue: 0,3:22:58.83,3:23:04.30,Default,,0,0,0,,Юкио Тонегава ортаңғы менеджері
Dialogue: 0,3:23:04.30,3:23:07.47,Default,,0,0,0,,Кейінірек
Dialogue: 0,3:23:07.47,3:23:10.78,Default,,0,0,0,,Мен оны асыға күтемін Қазутақайсер
Dialogue: 0,3:23:10.78,3:23:13.88,Default,,0,0,0,,Жоқ, бұл Макросаки.
Dialogue: 0,3:24:49.04,3:24:52.34,Default,,0,0,0,,Келесі жолы «Ақпарат»
Dialogue: 0,3:24:53.84,3:24:59.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory