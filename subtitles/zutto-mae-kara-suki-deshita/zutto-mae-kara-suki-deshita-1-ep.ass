Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:27.88,0:00:31.34,,,0,0,80,,Сол күннің де ойлары
Dialogue: 0,0:00:31.34,0:00:34.06,,,0,0,80,,Бүгінгі күннің де ойлары
Dialogue: 0,0:00:34.06,0:00:37.55,,,0,0,80,,Жүгіру
Dialogue: 0,0:00:37.55,0:00:40.28,,,0,0,80,,Тыныс алу
Dialogue: 0,0:00:40.28,0:00:44.30,,,0,0,80,,Ертең басқасын жасайық
Dialogue: 0,0:00:53.92,0:00:56.34,,,0,0,80,,Мен жалғыздыққа үйрендім
Dialogue: 0,0:00:56.34,0:00:58.44,,,0,0,80,,Жүрек сөйлегіш
Dialogue: 0,0:00:58.44,0:01:04.10,,,0,0,80,,«Жоқ,мен өзімді бұлай сүйе алмаймын».
Dialogue: 0,0:01:04.10,0:01:06.89,,,0,0,80,,Әркім өзгергісі келетін шығар.
Dialogue: 0,0:01:06.89,0:01:08.83,,,0,0,80,,Бірдей болу жақсы емес
Dialogue: 0,0:01:08.83,0:01:14.52,,,0,0,80,,Ол кенет орнынан тұрып,мәлімдеді
Dialogue: 0,0:01:14.52,0:01:18.36,,,0,0,80,,«Ештеңе емес,мен сені қорғаймын».
Dialogue: 0,0:01:18.36,0:01:20.74,,,0,0,80,,Негізсіз
Dialogue: 0,0:01:20.74,0:01:24.99,,,0,0,80,,Мені жастық шаққа апар
Dialogue: 0,0:01:24.99,0:01:32.62,,,0,0,80,,Бір күні сенің махаббатың мендікіндей болады.
Dialogue: 0,0:01:32.62,0:01:36.33,,,0,0,80,,Мен де кешегі күнді жек көремін
Dialogue: 0,0:01:36.33,0:01:38.96,,,0,0,80,,Бүгінгі мейірімділік те
Dialogue: 0,0:01:38.96,0:01:42.40,,,0,0,80,,Дауылдың дыбысы
Dialogue: 0,0:01:42.40,0:01:44.94,,,0,0,80,,Әрқашан жаңғырық
Dialogue: 0,0:01:44.94,0:01:50.14,,,0,0,80,,Ертеңге қайта жүгіру
Dialogue: 0,0:01:50.14,0:01:55.27,,,0,0,80,,Сіздің кеуде
Dialogue: 0,0:01:55.27,0:01:57.33,,,0,0,80,,шу шығару
Dialogue: 0,0:20:04.53,0:20:07.32,,,0,0,60,,Түсіндегі табиғи дене
Dialogue: 0,0:20:07.32,0:20:11.37,,,0,0,60,,Сәлемдесудің өзі өткен күн.
Dialogue: 0,0:20:11.37,0:20:14.16,,,0,0,60,,Гикочинай шындықтағы
Dialogue: 0,0:20:14.16,0:20:17.58,,,0,0,60,,Екі адамның махаббаты туралы әңгіме
Dialogue: 0,0:20:32.10,0:20:34.77,,,0,0,60,,«Көршіңіздің жағдайы жақсы ма?»
Dialogue: 0,0:20:34.77,0:20:37.93,,,0,0,60,,Қайрат берген таңғы пойыз
Dialogue: 0,0:20:38.81,0:20:41.56,,,0,0,60,,«Өтінемін!» деп жауап беріңіз.
Dialogue: 0,0:20:41.56,0:20:45.40,,,0,0,60,,Содан бері үнсіздік
Dialogue: 0,0:20:45.69,0:20:48.49,,,0,0,60,,Мен бірдеңе айтуым керек
Dialogue: 0,0:20:48.49,0:20:52.20,,,0,0,60,,Асықпасаң,діттеген жеріңе жетесің
Dialogue: 0,0:20:52.49,0:20:55.29,,,0,0,60,,Мен ер адам болуым керек
Dialogue: 0,0:20:55.29,0:20:58.41,,,0,0,60,,«...Ұялы телефоныңды тыңдай аламын ба?»
Dialogue: 0,0:20:58.41,0:21:02.83,,,0,0,60,,Кенеттен айтылған сөзге күлдім.
Dialogue: 0,0:21:02.83,0:21:05.92,,,0,0,60,,«...Мен де солай ойладым».
Dialogue: 0,0:21:06.34,0:21:09.67,,,0,0,60,,Бақытты бол
Dialogue: 0,0:21:09.67,0:21:13.10,,,0,0,60,,Бүгін тағы да «Рахмет».
Dialogue: 0,0:21:13.10,0:21:17.18,,,0,0,60,,Мен сіз туралы көбірек білгім келеді және біз доспыз.
Dialogue: 0,0:21:17.18,0:21:19.94,,,0,0,60,,Сізге телефон соғуға болады ма?
Dialogue: 0,0:21:19.94,0:21:26.15,,,0,0,60,,Мен уайымдап жүргенде, мен уақытты өткізіп алдым,ах...
Dialogue: 0,0:21:26.78,0:21:30.74,,,0,0,60,,Сүйікті кәмпит және сүйікті түсі
Dialogue: 0,0:21:30.90,0:21:33.70,,,0,0,60,,Маған да хабарлаңыз... түрін де.
Dialogue: 0,0:21:33.70,0:21:37.54,,,0,0,60,,Мен идеалды адамға жақындағым келеді
Dialogue: 0,0:21:37.54,0:21:40.33,,,0,0,60,,Бұл теңгерімсіз махаббат
Dialogue: 0,0:21:40.54,0:21:42.29,,,0,0,60,,«Не болады?»
Dialogue: 0,0:27:51.23,0:27:57.23,,,0,0,80,,Махаббат стратегиясы жұмыс істемейді
Dialogue: 0,0:27:57.23,0:28:02.44,,,0,0,80,,Саған шара қолданамын... көңілің қалады,солай ма?
Dialogue: 0,0:28:03.24,0:28:05.54,,,0,0,80,,Қыз жүрегі
Dialogue: 0,0:28:06.24,0:28:08.82,,,0,0,80,,Күзгі аспанның өзгеруі
Dialogue: 0,0:28:09.25,0:28:14.54,,,0,0,80,,Айналмасаң,өкінесің.
Dialogue: 0,0:28:15.25,0:28:18.26,,,0,0,80,,Біреу сізді мақтап жатыр
Dialogue: 0,0:28:18.26,0:28:21.59,,,0,0,80,,Мен өз басым бақыттымын,бірақ
Dialogue: 0,0:28:21.59,0:28:26.22,,,0,0,80,,Бұл «біреу» ...
Dialogue: 0,0:28:26.22,0:28:30.27,,,0,0,80,,Қыздарға қатысты сәл күрделірек.
Dialogue: 0,0:28:30.27,0:28:33.40,,,0,0,80,,Біреуді жақсы көру ащы
Dialogue: 0,0:28:33.40,0:28:36.38,,,0,0,80,,Мұның бәрі ащы,мен оны іше алмаймын.
Dialogue: 0,0:28:36.38,0:28:39.23,,,0,0,80,,Көңілім толқып,жүрегім дүрсілдегенде ауырады.
Dialogue: 0,0:28:39.23,0:28:42.38,,,0,0,80,,Дәрілер ауруға әсер етпейді.
Dialogue: 0,0:28:42.38,0:28:45.38,,,0,0,80,,«Мен сені сүйемін» деген екі сөзді қолданғым келеді
Dialogue: 0,0:28:45.38,0:28:48.41,,,0,0,80,,Мен басқа ештеңе қаламаймын.
Dialogue: 0,0:28:48.41,0:28:51.14,,,0,0,80,,Мені бүгіннен бастап ұната бастасаңыз ше?
Dialogue: 0,0:28:51.14,0:28:54.26,,,0,0,80,,Саған анда-санда адасу керек!
Dialogue: 0,0:28:54.26,0:28:57.46,,,0,0,80,,Дұрыс? Махаббат - ауру.
Dialogue: 0,0:28:57.46,0:29:01.97,,,0,0,80,,Жауапсыз махаббат қызық деп естідім,бірақ бұл өтірік
Dialogue: 0,0:29:01.97,0:29:07.32,,,0,0,80,,Ауырды,жылап тұрмын.
Dialogue: 0,0:29:07.32,0:29:14.38,,,0,0,80,,Бірақ білесің бе,мен сені ұнататынымды білгенде қуандым.
Dialogue: 0,0:29:15.16,0:29:18.24,,,0,0,80,,Біреуді сүю қиын
Dialogue: 0,0:29:18.24,0:29:21.28,,,0,0,80,,Жалғыз көтеруге тым ауыр.
Dialogue: 0,0:29:21.28,0:29:24.17,,,0,0,80,,Мен қатты толқып,толқып кеттім
Dialogue: 0,0:29:24.17,0:29:27.40,,,0,0,80,,Ерекше болмаса ұнамайды.
Dialogue: 0,0:47:47.06,0:47:52.49,,Destiny～～,0,0,0,,Қатарласып,бір күні түсінемін
Dialogue: 0,0:47:52.49,0:47:58.52,,Destiny～～,0,0,0,,Биіктік айырмашылығына сәл жоғары қарау
Dialogue: 0,0:47:58.52,0:48:01.79,,Destiny～～,0,0,0,,саналы болады
Dialogue: 0,0:48:01.79,0:48:04.50,,Destiny～～,0,0,0,,«Достар»,солай ма?
Dialogue: 0,0:48:04.50,0:48:10.67,,Destiny～～,0,0,0,,Саған дұрыс қарай алмаймын
Dialogue: 0,0:48:10.67,0:48:17.69,,Destiny～～,0,0,0,,«Не болды?» \h\h\h\h\h\h\hСенің кесіріңнен айта алмадым.
Dialogue: 0,0:48:21.42,0:48:26.80,,Destiny～～,0,0,0,,Алғашқы махаббатыма қарап отырдым
Dialogue: 0,0:48:27.55,0:48:32.15,,Destiny～～,0,0,0,,Мен сен білмейсің деп ойладым.
Dialogue: 0,0:48:32.15,0:48:35.07,,Destiny～～,0,0,0,,Сонда да...
Dialogue: 0,0:48:35.07,0:48:43.20,,Destiny～～,0,0,0,,Күліп тұрған күн де ​​келеді
Dialogue: 0,0:48:43.20,0:48:46.08,,Destiny～～,0,0,0,,ТАҒДЫР
Dialogue: 0,0:48:46.08,0:48:53.63,,Destiny～～,0,0,0,,Махаббатты біліп,махаббатқа барамын
Dialogue: 0,0:48:53.63,0:48:56.70,,Destiny～～,0,0,0,,СЕН МАҒАН КЕРЕКСІҢ
Dialogue: 0,0:48:56.70,0:49:03.80,,Destiny～～,0,0,0,,Қабыл ал...Мен сені қазірдің өзінде жақсы көремін бе?
Dialogue: 0,0:49:03.80,0:49:11.02,,Destiny～～,0,0,0,,Махаббат туралы біліп,ғашық болдым.
Dialogue: 0,0:49:11.02,0:49:14.32,,Destiny～～,0,0,0,,МЕН СІЗГЕ УӘДЕ БЕРЕМІН
Dialogue: 0,0:49:14.32,0:49:21.39,,Destiny～～,0,0,0,,Мен сені құшақтағым келеді...Мен сені бұрыннан жақсы көремін бе?
Dialogue: 0,0:49:21.39,0:49:32.11,,Destiny～～,0,0,0,,Әй,мен сені сүйемін.
Dialogue: 0,0:49:33.63,0:49:39.18,,Destiny～～,0,0,0,,Мен біреудің бет-әлпетіне қызық болдым
Dialogue: 0,0:49:39.18,0:49:44.75,,Destiny～～,0,0,0,,Мен танымайтын адамды білгім келеді
Dialogue: 0,0:49:45.47,0:49:48.42,,Destiny～～,0,0,0,,«Күте тұрыңыз,кетпеңіз».
Dialogue: 0,0:49:48.42,0:49:52.84,,Destiny～～,0,0,0,,Мен айта алмаймын...Мен әлі айта алмаймын.
Dialogue: 0,0:49:56.39,0:50:01.50,,Destiny～～,0,0,0,,Менің алғашқы махаббатым деп мойындадым
Dialogue: 0,0:50:02.47,0:50:06.87,,Destiny～～,0,0,0,,Келмейді деп ойладым.
Dialogue: 0,0:50:06.87,0:50:10.00,,Destiny～～,0,0,0,,Сонда да...
Dialogue: 0,0:50:10.00,0:50:18.07,,Destiny～～,0,0,0,,Ұйқысыз жүрегімде тасып
Dialogue: 0,0:50:18.07,0:50:20.37,,Destiny～～,0,0,0,,ESTINYD
Dialogue: 0,0:50:20.95,0:50:28.13,,Destiny～～,0,0,0,,Махаббат туралы біліп,ғашық болдым.
Dialogue: 0,0:50:28.13,0:50:31.40,,Destiny～～,0,0,0,,МЕН СІЗГЕ УӘДЕ БЕРЕМІН
Dialogue: 0,0:50:31.40,0:50:38.80,,Destiny～～,0,0,0,,Мен сені құшақтағым келеді...Мен сені қазірдің өзінде жақсы көремін
Dialogue: 0,0:50:38.80,0:50:51.44,,Destiny～～,0,0,0,,Эй,мен сені жақсы көремін.
Dialogue: 0,0:51:10.03,0:51:15.15,,,30,30,30,,«Кенеттен келгенім үшін кешіріңіз,мен сізді көптен бері жақсы көремін».
Dialogue: 0,0:51:15.15,0:51:20.02,,,30,30,30,,Менің жүрегімнің кеудемде соққанын естімейсің бе?
Dialogue: 0,0:51:30.50,0:51:35.88,,,30,30,30,,Кокухаку репетициясы «Сіз мені байсалды деп ойладыңыз ба?»
Dialogue: 0,0:51:35.88,0:51:40.96,,,30,30,30,,Сіз сүйкімдісіз бе? Сіз таң қалдыңыз ба? Маған олай қарама.
Dialogue: 0,0:51:40.96,0:51:46.14,,,30,30,30,,Сіз байсалдысыз ба? Өтірік айтпа!! Тоқта!
Dialogue: 0,0:51:46.14,0:51:51.48,,,30,30,30,,Дұрыс,бүгін кішкене айналма жолмен жүріп үйге қайтайық.
Dialogue: 0,0:51:51.48,0:51:56.69,,,30,30,30,,Ертең мен саған сүйген адамымды айтамын.
Dialogue: 0,0:51:56.69,0:52:01.72,,,30,30,30,,Маған қолдау көрсетіңіз. Маған уәде бер.
Dialogue: 0,0:52:01.72,0:52:06.94,,,30,30,30,,Менің өзімшілдігімді ертең ғана тыңдайсың ба?
Dialogue: 0,0:52:06.94,0:52:12.09,,,30,30,30,,Жүрегімдегі өзімшілдік аздап өсті
Dialogue: 0,0:52:12.09,0:52:17.42,,,30,30,30,,Байыпты болыңыз,жаттығу жасаңыз!
Dialogue: 0,0:52:17.42,0:52:22.25,,,30,30,30,,Өтірік жүректі қараңыз
Dialogue: 0,0:53:06.48,0:53:11.89,,,30,30,30,,Менің жүрегімнің кеудемде соққанын естімейсің бе?
Dialogue: 0,0:53:11.89,0:53:17.01,,,30,30,30,,Менің жүрегімдегі дірілдеген дауысты естігеніңді қалаймын
Dialogue: 0,0:56:39.47,0:56:47.86,,,0,0,80,,Сіздің әңгімеңіздің ұмытылмас минуты мен секунды
Dialogue: 0,0:57:02.87,0:57:09.63,,,0,0,0,,Уәде беру Өз армандарына ұмтылатын адамдар
Dialogue: 0,0:57:09.63,0:57:15.22,,,0,0,0,,Алғашқы махаббатынан абдырап қалған адам
Dialogue: 0,0:57:15.22,0:57:21.93,,,0,0,0,,Болашақты жарықтандыруға тырысатын адамдар
Dialogue: 0,0:57:21.93,0:57:27.48,,,0,0,0,,Жылап жүріп,қайратты болған адам
Dialogue: 0,0:57:27.48,0:57:33.65,,,0,0,0,,Әрбір жасты байланыстыру
Dialogue: 0,0:57:33.65,0:57:40.07,,,0,0,0,,Әр сәтті толық өмір сүру
Dialogue: 0,0:57:41.41,0:57:42.91,,,0,0,0,,Жарқыраған траектория
Dialogue: 0,0:57:42.91,0:57:48.46,,,0,0,0,,Мен сенің сөздеріңді минут сайын ұмытпаймын
Dialogue: 0,0:57:49.04,0:57:53.88,,,0,0,0,,Қорықпайтын жұлдыздар менің оқиғамды көрсетеді
Dialogue: 0,0:57:53.88,0:57:58.26,,,0,0,0,,Егер сүрінсең,кез келген уақытта осында кел.
Dialogue: 0,0:57:58.26,0:58:04.43,,,0,0,0,,Қанатымызды демалып,жоғары қарап күлейік
Dialogue: 0,0:58:04.43,0:58:07.18,,,0,0,0,,«Жарайды».
Dialogue: 0,0:58:08.10,0:58:14.23,,,0,0,0,,Айнымас және сүйікті Даңқ күндері
Dialogue: 0,0:58:14.23,0:58:19.03,,,0,0,0,,Сіздің ішіңізде өмір сүру
Dialogue: 0,0:58:32.17,0:58:38.88,,,0,0,0,,Кездесуге толы көктем
Dialogue: 0,0:58:38.88,0:58:44.43,,,0,0,0,,Қол қосылып,Жаз қызықпен жүгіре бастайды
Dialogue: 0,0:58:44.43,0:58:51.19,,,0,0,0,,Соқтығысу арқылы бір-бірімізді растай алдық күз
Dialogue: 0,0:58:51.19,0:58:56.69,,,0,0,0,,Бәріміз бірге болып,табанды қысты таптық.
Dialogue: 0,0:58:56.69,0:59:02.95,,,0,0,0,,Себебі мен болашақ жоспарларымызды байланыстырғым келеді
Dialogue: 0,0:59:02.95,0:59:09.62,,,0,0,0,,Ешқашан қайталанбайтын сәтті толық өмір сүру
Dialogue: 0,0:59:10.79,0:59:12.17,,,0,0,0,,Ертеңге қарай ұшады
Dialogue: 0,0:59:12.17,0:59:17.84,,,0,0,0,,Сенің күлкіңді минут сайын ұмытпаймын
Dialogue: 0,0:59:18.26,0:59:23.09,,,0,0,0,,Аспанға тартқымыз келетін армандар,болашағымыз
Dialogue: 0,0:59:23.09,0:59:30.52,,,0,0,0,,Қиын кезде бір-біріміздің иығымызға сүйеніп сөйлесейік.
Dialogue: 0,0:59:30.52,0:59:33.69,,,0,0,0,,Алға,алға ұмтылайық
Dialogue: 0,0:59:33.69,0:59:36.52,,,0,0,0,,«Жарайды».
Dialogue: 0,0:59:37.32,0:59:43.32,,,0,0,0,,Қоштасу емес,тағдырлас досым
Dialogue: 0,0:59:43.53,0:59:48.45,,,0,0,0,,Менің кеудемде өмір сүру
Dialogue: 0,0:59:50.41,0:59:53.50,,,0,0,0,,Жылауға болмайды
Dialogue: 0,0:59:53.50,0:59:56.50,,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:59:56.50,0:59:58.17,,,0,0,0,,Суретке түсейік
Dialogue: 0,0:59:58.17,1:00:05.51,,,0,0,0,,Бірінші және соңғы арнайы бөлім
Dialogue: 0,1:00:32.04,1:00:38.29,,,0,0,0,,Әрбір жасты байланыстыру
Dialogue: 0,1:00:38.29,1:00:44.97,,,0,0,0,,Әр сәтті толық өмір сүру
Dialogue: 0,1:00:47.51,1:00:53.14,,,0,0,0,,Мен сенің дауысыңды минут сайын ұмытпаймын
Dialogue: 0,1:00:53.64,1:00:59.19,,,0,0,0,,Мен жалғыз емеспін,бәрібір
Dialogue: 0,1:00:59.82,1:01:02.94,,,0,0,0,,Жарқыраған траектория,ертеңге қарай ұшады
Dialogue: 0,1:01:02.94,1:01:09.03,,,0,0,0,,Мен сенің сөздеріңді минут сайын ұмытпаймын
Dialogue: 0,1:01:09.03,1:01:13.83,,,0,0,0,,Қорықпайтын жұлдыздар менің оқиғамды көрсетеді
Dialogue: 0,1:01:13.83,1:01:18.29,,,0,0,0,,Сүрінсең,кез келген уақытта осында кел.
Dialogue: 0,1:01:18.29,1:01:24.46,,,0,0,0,,Қанатымызды демалып,жоғары қарап күлейік.
Dialogue: 0,1:01:24.46,1:01:26.93,,,0,0,0,,«Жарайды».
Dialogue: 0,1:01:28.09,1:01:34.18,,,0,0,0,,Айнымас және сүйікті Даңқ күндері
Dialogue: 0,1:01:34.18,1:01:39.77,,,0,0,0,,Сіздің ішіңізде өмір сүру
Dialogue: 0,1:01:45.94,1:01:52.12,,,0,0,0,,Әрі қарай, алға қарап,«Жарайды» дейміз.
Dialogue: 0,1:01:52.12,1:01:54.49,,,0,0,0,,Сіздің әңгімеңіз
Dialogue: 0,0:00:13.09,0:00:16.08,1080,,0,0,0,,Кенеттен келгенім үшін кешіріңіз.
Dialogue: 0,0:00:20.51,0:00:21.93,1080,,0,0,0,,Zu...
Dialogue: 0,0:00:25.76,0:00:27.88,1080,,0,0,0,,Мен сені көптен бері жақсы көремін
Dialogue: 0,0:02:07.57,0:02:09.56,1080,,0,0,0,,О,дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:02:10.45,0:02:12.07,1080,,0,0,0,,Қайырлы таң Накчан
Dialogue: 0,0:02:12.07,0:02:13.73,1080,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:12.90,0:02:14.03,1080,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:14.03,0:02:15.62,1080,,0,0,0,,Кешіріңіз,күттіңіз бе?
Dialogue: 0,0:02:15.62,0:02:16.56,1080,,0,0,0,,Жоқ
Dialogue: 0,0:02:16.56,0:02:18.48,1080,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:02:25.40,0:02:28.00,1080,,0,0,0,,Бүгінгі бірінші кезең қандай?
Dialogue: 0,0:02:28.00,0:02:32.01,1080,,0,0,0,,Бұл ағылшын тілі. Олар викторина бар деді.
Dialogue: 0,0:02:32.01,0:02:34.51,1080,,0,0,0,,Солай ма?
Dialogue: 0,0:02:35.60,0:02:36.76,1080,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:02:37.65,0:02:38.81,1080,,0,0,0,,-да?
Dialogue: 0,0:02:38.81,0:02:40.01,1080,,0,0,0,,Сетогучи мырза
Dialogue: 0,0:02:41.78,0:02:43.40,1080,,0,0,0,,Оны айта аласыз ба?
Dialogue: 0,0:02:43.76,0:02:45.46,1080,,0,0,0,,Мойындау
Dialogue: 0,0:02:48.78,0:02:51.82,1080,,0,0,0,,Мұны тыңдаңыз.
Dialogue: 0,0:02:56.58,0:02:58.53,1080,,0,0,0,,Мен сені көптен бері жақсы көремін
Dialogue: 0,0:03:17.56,0:03:18.68,1080,,0,0,0,,Эрен тұрған жаққа
Dialogue: 0,0:03:20.02,0:03:21.09,1080,,0,0,0,,Эрен тұрған жаққа
Dialogue: 0,0:03:21.58,0:03:22.59,1080,,0,0,0,,Не?
Dialogue: 0,0:03:22.59,0:03:23.74,1080,,0,0,0,,Эрен тұрған жаққа
Dialogue: 0,0:03:24.99,0:03:26.92,1080,,0,0,0,,Бұл не?
Dialogue: 0,0:03:26.92,0:03:28.81,1080,,0,0,0,,Түсіндірме жоқ.
Dialogue: 0,0:03:28.81,0:03:30.40,1080,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:03:31.87,0:03:34.65,1080,,0,0,0,,Нацуки,сен
Dialogue: 0,0:03:39.46,0:03:40.82,1080,,0,0,0,,Мойындау...
Dialogue: 0,0:03:42.14,0:03:44.21,1080,,0,0,0,,...Құрғақ жаттығу..
Dialogue: 0,0:03:45.20,0:03:46.46,1080,,0,0,0,,...
Dialogue: 0,0:03:48.97,0:03:51.25,1080,,0,0,0,,Иә,жаттығу?
Dialogue: 0,0:03:52.01,0:03:55.62,1080,,0,0,0,,Ей, эй, сүйкімді,мен қатты толқыдым
Dialogue: 0,0:03:59.06,0:04:01.66,1080,,0,0,0,,Маған олай қарама.
Dialogue: 0,0:04:02.44,0:04:04.30,1080,,0,0,0,,Гоментеба
Dialogue: 0,0:04:08.95,0:04:12.02,1080,,0,0,0,,Мен байыпты болып бара жатырмын
Dialogue: 0,0:04:19.54,0:04:20.90,1080,,0,0,0,,Бұл өтірік
Dialogue: 0,0:04:23.18,0:04:24.53,1080,,0,0,0,,Қарсы алу
Dialogue: 0,0:04:29.84,0:04:31.02,1080,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:04:31.80,0:04:33.83,1080,,0,0,0,,Нақты орындауды кім орындайды?
Dialogue: 0,0:04:40.09,0:04:43.28,1080,,0,0,0,,Бұлай айту мүмкін емес.
Dialogue: 0,0:04:43.28,0:04:46.26,1080,,0,0,0,,Әй, эй,далаға шығып жаттығу жасайық.
Dialogue: 0,0:04:46.26,0:04:48.14,1080,,0,0,0,,Мен көмектесе алмаймын.
Dialogue: 0,0:04:50.60,0:04:52.52,1080,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:04:53.16,0:04:55.50,1080,,0,0,0,,Дегенмен,рамен сатып алмаңыз.
Dialogue: 0,0:04:57.87,0:05:02.32,1080,,0,0,0,,Сонымен, үйге бара жатып,вокзал алдына рамен жеуге бардым.
Dialogue: 0,0:05:03.11,0:05:07.22,1080,,0,0,0,,Бұл дәмді болды,бірақ бұл менің сән-салтанатым болды.
Dialogue: 0,0:05:08.06,0:05:10.04,1080,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:05:11.60,0:05:13.41,1080,,0,0,0,,Жоқ
Dialogue: 0,0:05:13.41,0:05:17.30,1080,,0,0,0,,Иә, аяғыңды жаб,сен қызсың.
Dialogue: 0,0:05:17.30,0:05:21.22,1080,,0,0,0,,Көрдім, олар шабуыл жасады,бірақ олар шегінді.
Dialogue: 0,0:05:21.22,0:05:22.88,1080,,0,0,0,,Жоқ,бұл дұрыс емес.
Dialogue: 0,0:05:22.88,0:05:26.84,1080,,0,0,0,,Бұл уақытша эвакуация,бұл стратегия.
Dialogue: 0,0:05:26.84,0:05:29.19,1080,,0,0,0,,Ойланып көріңізші,Мио мен Харуки ше?
Dialogue: 0,0:05:29.19,0:05:31.43,1080,,0,0,0,,мен...
Dialogue: 0,0:05:31.83,0:05:34.60,1080,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:05:34.60,0:05:36.27,1080,,0,0,0,,What is normal?
Dialogue: 0,0:05:36.27,0:05:38.62,1080,,0,0,0,,Normal is normal
Dialogue: 0,0:05:38.62,0:05:40.02,1080,,0,0,0,,Akari-chan is
Dialogue: 0,0:05:41.14,0:05:43.03,1080,,0,0,0,,Мен...
Dialogue: 0,0:05:43.03,0:05:44.24,1080,,0,0,0,,Әкем білсе,бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:05:44.24,0:05:46.78,1080,,0,0,0,,Мен Накчанның мойындау стратегиясы туралы ойлануым керек.
Dialogue: 0,0:05:46.78,0:05:49.53,1080,,0,0,0,,Уақытша эвакуациядан кейін не істеу керек
Dialogue: 0,0:05:51.59,0:05:54.48,1080,,0,0,0,,Thank you Akari
Dialogue: 0,0:05:54.48,0:05:57.21,1080,,0,0,0,,Жарайды,мен бар күшімді саламын.
Dialogue: 0,0:06:10.03,0:06:11.30,1080,,0,0,0,,Sleepy
Dialogue: 0,0:06:11.75,0:06:12.97,1080,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:15.11,0:06:16.66,1080,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:23.66,0:06:25.24,1080,,0,0,0,,Қайырлы таң Акари
Dialogue: 0,0:06:25.49,0:06:26.82,1080,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:31.21,0:06:33.44,1080,,0,0,0,,Good morning Akarin
Dialogue: 0,0:06:34.49,0:06:36.80,1080,,0,0,0,,Today is also a real angel
Dialogue: 0,0:06:36.80,0:06:39.64,1080,,0,0,0,,Say it out loud
Dialogue: 0,0:06:39.64,0:06:42.67,1080,,0,0,0,,“Akarin,good morning.”
Dialogue: 0,0:06:43.03,0:06:45.00,1080,,0,0,0,,Хмм,бұл мүмкін емес.
Dialogue: 0,0:06:45.00,0:06:47.60,1080,,0,0,0,,Менің ойымша,сіз екі жыл бойы жауапсыз махаббатта болдыңыз.
Dialogue: 0,0:06:47.60,0:06:49.46,1080,,0,0,0,,Confess!
Dialogue: 0,0:06:49.46,0:06:51.14,1080,,0,0,0,,Мүмкін емес Мүмкін емес Мүмкін емес
Dialogue: 0,0:06:51.14,0:06:55.10,1080,,0,0,0,,Өйткені біз бұл туралы ешқашан сөйлескен емеспіз,сондықтан неге мойындамайсыз?
Dialogue: 0,0:07:00.66,0:07:02.42,1080,,0,0,0,,Too lazy
Dialogue: 0,0:07:04.04,0:07:06.38,1080,,0,0,0,,Нене,бұл кім?
Dialogue: 0,0:07:06.38,0:07:08.24,1080,,0,0,0,,Ондай адам болды ма?
Dialogue: 0,0:07:08.24,0:07:10.61,1080,,0,0,0,,Hey, hey,it's not very cool.
Dialogue: 0,0:07:15.22,0:07:17.09,1080,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:07:17.88,0:07:19.25,1080,,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:20.64,0:07:23.44,1080,,0,0,0,,Ah,maybe that's it?
Dialogue: 0,0:07:24.43,0:07:26.20,1080,,0,0,0,,Ayase?
Dialogue: 0,0:07:28.31,0:07:30.01,1080,,0,0,0,,Ayase...
Dialogue: 0,0:07:30.50,0:07:34.60,1080,,0,0,0,,Оның шашы қызға ұқсап,мынандай болды.
Dialogue: 0,0:07:38.27,0:07:40.48,1080,,0,0,0,,That's Ayase-kun.
Dialogue: 0,0:07:41.95,0:07:44.27,1080,,0,0,0,,Сіз шашыңызды қидыңыз,солай ма?
Dialogue: 0,0:07:46.91,0:07:48.60,1080,,0,0,0,,Akarin
Dialogue: 0,0:07:47.12,0:07:48.48,1080,,0,0,0,,It suits you really well
Dialogue: 0,0:07:48.48,0:07:50.20,1080,,0,0,0,,Does it suit you?
Dialogue: 0,0:07:54.00,0:07:55.62,1080,,0,0,0,,You cut your hair,right?
Dialogue: 0,0:07:55.62,0:07:56.84,1080,,0,0,0,,Иә
Dialogue: 0,0:07:56.84,0:07:59.12,1080,,0,0,0,,Сонымен,сіз дәл қазір не туралы айттыңыз?
Dialogue: 0,0:07:59.86,0:08:01.79,1080,,0,0,0,,Are you with Mr. Hayasaka?
Dialogue: 0,0:08:02.60,0:08:07.28,1080,,0,0,0,,«Сіз және Мочизуки шаштарыңызды алдыңыздар,солай ма?»
Dialogue: 0,0:08:09.48,0:08:12.99,1080,,0,0,0,,Аясе: Атмосфера айтарлықтай өзгерді.
Dialogue: 0,0:08:12.99,0:08:15.00,1080,,0,0,0,,suddenly why
Dialogue: 0,0:08:24.90,0:08:26.90,1080,,0,0,0,,Мен өткен күні жалға алған DVD-ді көрдім.
Dialogue: 0,0:08:26.90,0:08:28.37,1080,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:08:27.15,0:08:29.26,1080,,0,0,0,,Do you like that?
Dialogue: 0,0:08:29.26,0:08:30.70,1080,,0,0,0,,Жарайды.
Dialogue: 0,0:08:30.70,0:08:32.20,1080,,0,0,0,,Бұл күтпеген еді,бірақ өте қызықты болды.
Dialogue: 0,0:08:32.70,0:08:33.72,1080,,0,0,0,,You can continue borrowing.
Dialogue: 0,0:08:33.21,0:08:34.54,1080,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:33.76,0:08:34.84,1080,,0,0,0,,А,жарайды.
Dialogue: 0,0:08:34.84,0:08:37.76,1080,,0,0,0,,Ayase also has someone she likes.
Dialogue: 0,0:08:40.97,0:08:44.04,1080,,0,0,0,,Мен сияқты
Dialogue: 0,0:08:44.22,0:08:46.43,1080,,0,0,0,,Мочита
Dialogue: 0,0:08:47.02,0:08:49.12,1080,,0,0,0,,This is the scene I was worried about.
Dialogue: 0,0:08:47.06,0:08:49.12,1080,,0,0,0,,Харуки Не...
Dialogue: 0,0:08:49.12,0:08:51.20,1080,,0,0,0,,Маған керемет идея келді.
Dialogue: 0,0:08:51.20,0:08:52.78,1080,,0,0,0,,Сценарийді түзете аламын ба?
Dialogue: 0,0:08:52.78,0:08:54.22,1080,,0,0,0,,Мен оны түзетемін.
Dialogue: 0,0:08:54.22,0:08:57.77,1080,,0,0,0,,бөліміне өтіңіз. Оны қазір түзету қиын емес.
Dialogue: 0,0:08:57.77,0:09:01.02,1080,,0,0,0,,Егер кестеден қорқатын болсаңыз,фильм түсіре аласыз ба?
Dialogue: 0,0:09:01.02,0:09:04.00,1080,,0,0,0,,Hey Yu,the film club is urgently summoned.
Dialogue: 0,0:09:04.00,0:09:05.02,1080,,0,0,0,,Не?
Dialogue: 0,0:09:05.02,0:09:06.24,1080,,0,0,0,,Не
Dialogue: 0,0:09:06.24,0:09:07.90,1080,,0,0,0,,Мен сценарийді қайта қараймын.
Dialogue: 0,0:09:07.90,0:09:09.32,1080,,0,0,0,,Жоқ...
Dialogue: 0,0:09:08.57,0:09:10.57,1080,,0,0,0,,Hey,come quickly.
Dialogue: 0,0:09:19.80,0:09:22.13,1080,,0,0,0,,Олардың мен адамзаттың күш арасындағы алшақтық аса үлкен еді,...
Dialogue: 0,0:09:23.51,0:09:26.78,1080,,0,0,0,,Eat Bullet Shoot
Dialogue: 0,0:09:26.78,0:09:28.17,1080,,0,0,0,,Мен сізге рұқсат бермеймін
Dialogue: 0,0:09:28.35,0:09:29.46,1080,,0,0,0,,Ю
Dialogue: 0,0:09:35.61,0:09:37.10,1080,,0,0,0,,Ято өледі
Dialogue: 0,0:09:37.10,0:09:38.90,1080,,0,0,0,,Сәттілік
Dialogue: 0,0:09:42.86,0:09:46.14,1080,,0,0,0,,Yukki,you're working hard.
To
Dialogue: 0,0:09:46.14,0:09:49.77,1080,,0,0,0,,Is Akari a bad prince type?
Dialogue: 0,0:09:51.53,0:09:53.96,1080,,0,0,0,,Не,не?
Dialogue: 0,0:09:53.96,0:09:56.66,1080,,0,0,0,,Сүйікті жарық түрі?
Dialogue: 0,0:09:56.66,0:09:59.86,1080,,0,0,0,,Like I want to hear Like I don't want to hear
Dialogue: 0,0:09:59.86,0:10:01.72,1080,,0,0,0,,Бірақ мен оны әлі де естігім келеді.
Dialogue: 0,0:10:01.72,0:10:06.09,1080,,0,0,0,,Does that mean the person you fall in love with is your type?
Dialogue: 0,0:10:06.09,0:10:08.90,1080,,0,0,0,,Қызық,солай ма?
Dialogue: 0,0:10:12.46,0:10:15.04,1080,,0,0,0,,The person you fall in love with is your type.
Dialogue: 0,0:10:15.04,0:10:18.54,1080,,0,0,0,,Isn't this the most difficult?
Dialogue: 0,0:10:19.78,0:10:23.01,1080,,0,0,0,,I wonder if there is someone I like
Dialogue: 0,0:10:23.01,0:10:26.14,1080,,0,0,0,,It's fine if the person Akarin likes has someone she likes.
Dialogue: 0,0:10:28.66,0:10:31.53,1080,,0,0,0,,Жақсы емес.
Dialogue: 0,0:10:31.53,0:10:33.54,1080,,0,0,0,,Сіз не тілейсіз?
Dialogue: 0,0:10:35.75,0:10:38.12,1080,,0,0,0,,It's the worst wish
Dialogue: 0,0:10:38.62,0:10:40.04,1080,,0,0,0,,Бірақ
Dialogue: 0,0:10:43.13,0:10:48.24,1080,,0,0,0,,Акариннің махаббатын қолдай алмаймын.
Dialogue: 0,0:10:48.24,0:10:49.97,1080,,0,0,0,,Мочита
Dialogue: 0,0:10:54.80,0:10:56.55,1080,,0,0,0,,Эй,жақсысың ба?
Dialogue: 0,0:10:56.80,0:10:58.39,1080,,0,0,0,,My nose is bleeding
Dialogue: 0,0:10:58.39,0:11:00.84,1080,,0,0,0,,This is going to the infirmary.
Dialogue: 0,0:11:01.82,0:11:04.66,1080,,0,0,0,,Falling in love with the girl you like and eating the ball?
Dialogue: 0,0:11:04.66,0:11:06.56,1080,,0,0,0,,Тым ақсақ
Dialogue: 0,0:11:06.56,0:11:09.56,1080,,0,0,0,,Hey,don't cry just because of the face block.
Dialogue: 0,0:11:09.56,0:11:11.10,1080,,0,0,0,,Мен жыламаймын
Dialogue: 0,0:11:11.10,0:11:14.44,1080,,0,0,0,,Дұрыс,жақсы қойылым болды. Жылама.
Dialogue: 0,0:11:14.44,0:11:16.74,1080,,0,0,0,,Сондықтан мен жыламаймын
Dialogue: 0,0:11:19.04,0:11:21.36,1080,,0,0,0,,Пайдасыз
Dialogue: 0,0:11:21.36,0:11:23.84,1080,,0,0,0,,Мочизуки-кун,не болды?
Dialogue: 0,0:11:23.84,0:11:27.96,1080,,0,0,0,,Бұл қызық емес сияқты.
Dialogue: 0,0:11:38.27,0:11:43.22,1080,,0,0,0,,О,бұл Эномото-сан.
Dialogue: 0,0:11:46.19,0:11:47.72,1080,,0,0,0,,Коюки-кун
Dialogue: 0,0:11:47.72,0:11:49.95,1080,,0,0,0,,Бұл сізге керемет көрінеді
Dialogue: 0,0:11:50.74,0:11:52.48,1080,,0,0,0,,Бұл рас па?
Dialogue: 0,0:11:53.46,0:11:57.10,1080,,0,0,0,,Бұл көзілдірікті шешіп алсаңыз,қалай жақсы көрінетініңіз туралы манга сияқты.
Dialogue: 0,0:11:57.98,0:12:01.49,1080,,0,0,0,,Айтпақшы,мен жаңа PV көрдім
Dialogue: 0,0:12:01.49,0:12:04.56,1080,,0,0,0,,Қараңдаршы, бұл өте жақсы болды,солай емес пе?
Dialogue: 0,0:12:04.56,0:12:07.25,1080,,0,0,0,,Бірақ ән мәтіні әлі де керемет.
Dialogue: 0,0:12:07.25,0:12:08.30,1080,,0,0,0,,Әрине
Dialogue: 0,0:12:08.30,0:12:11.22,1080,,0,0,0,,Мен алдағы CD-ге алдын ала тапсырыс бердім.
Dialogue: 0,0:12:11.22,0:12:13.76,1080,,0,0,0,,Қарыз беру және беру
Dialogue: 0,0:12:13.76,0:12:15.50,1080,,0,0,0,,Иә,жақсы.
Dialogue: 0,0:12:15.50,0:12:17.42,1080,,0,0,0,,Жасағаныңыз үшін рахмет
Dialogue: 0,0:12:16.56,0:12:18.68,1080,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:12:17.81,0:12:20.31,1080,,0,0,0,,Мен естігенім осы болды.
Dialogue: 0,0:12:20.31,0:12:22.88,1080,,0,0,0,,А,бұл сахнаның өзгеруі шығар.
Dialogue: 0,0:12:22.88,0:12:26.76,1080,,0,0,0,,Менің ойымша,кесте бойынша бұл жақсы.
Dialogue: 0,0:12:27.65,0:12:30.16,1080,,0,0,0,,Харуки,қош келдіңіз.
Dialogue: 0,0:12:30.16,0:12:33.90,1080,,0,0,0,,О,кеттік.
Dialogue: 0,0:12:34.34,0:12:36.00,1080,,0,0,0,,Қош бол
Dialogue: 0,0:12:38.79,0:12:42.10,1080,,0,0,0,,Қызық,ол жігіттер кездесіп жүр ме?
Dialogue: 0,0:12:42.10,0:12:44.30,1080,,0,0,0,,Шиннай
Dialogue: 0,0:12:44.62,0:12:46.84,1080,,0,0,0,,Не болды?
Dialogue: 0,0:12:46.84,0:12:48.55,1080,,0,0,0,,Ю
Dialogue: 0,0:12:48.55,0:12:51.66,1080,,0,0,0,,Жалғыз махаббат ұзаққа созылады
Dialogue: 0,0:12:51.66,0:12:55.02,1080,,0,0,0,,Бұл жауапсыз махаббат.
Dialogue: 0,0:12:58.18,0:12:59.68,1080,,0,0,0,,Түсіндім
Dialogue: 0,0:12:59.68,0:13:01.97,1080,,0,0,0,,Мен түсіндім,сондықтан сен де сөйлемейсің.
Dialogue: 0,0:13:01.97,0:13:04.20,1080,,0,0,0,,Рамен жейміз.
Dialogue: 0,0:13:06.23,0:13:10.82,1080,,0,0,0,,Ол кездегі бейнелер мен музыка керемет.
Dialogue: 0,0:13:10.82,0:13:13.90,1080,,0,0,0,,бөліміне өтіңіз. Қызықты көрінеді.
Dialogue: 0,0:13:13.90,0:13:16.19,1080,,0,0,0,,Келесі жолы DVD алып келемін.
Dialogue: 0,0:13:16.19,0:13:18.82,1080,,0,0,0,,Менің ойымша,сен Миоға міндетті түрде ұнайсың.
Dialogue: 0,0:13:18.82,0:13:21.76,1080,,0,0,0,,Оны асыға күтемін
Dialogue: 0,0:13:25.08,0:13:26.64,1080,,0,0,0,,Иә
Dialogue: 0,0:13:30.34,0:13:31.64,1080,,0,0,0,,Сендердің міндетің не,көпшілік?
Dialogue: 0,0:13:53.24,0:13:54.73,1080,,0,0,0,,Мен үйдемін
Dialogue: 0,0:13:57.41,0:13:59.22,1080,,0,0,0,,Жоқ, жоқ,Хина Чан
Dialogue: 0,0:13:59.22,0:14:02.02,1080,,0,0,0,,Эй Накчан,сен не істеп жатырсың?
Dialogue: 0,0:14:02.02,0:14:03.26,1080,,0,0,0,,Өйткені,сол жерде...
Dialogue: 0,0:14:03.26,0:14:05.10,1080,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:14:06.59,0:14:09.41,1080,,0,0,0,,Сен біреудің бөлмесінде не істеп жүрсің?
Dialogue: 0,0:14:09.41,0:14:11.67,1080,,0,0,0,,Үлкен аға,үйге қош келдіңіз
Dialogue: 0,0:14:11.67,0:14:13.08,1080,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:14:13.08,0:14:15.70,1080,,0,0,0,,Кеш болды. Сен қайда болдың?
Dialogue: 0,0:14:15.70,0:14:17.43,1080,,0,0,0,,Кез келген жерде жақсы болар еді.
Dialogue: 0,0:14:25.23,0:14:29.40,1080,,0,0,0,,Мойындау Бұл репетиция.
Dialogue: 0,0:14:33.99,0:14:37.19,1080,,0,0,0,,Осы сағатта жігіттің бөлмесінде болған дұрыс па?
Dialogue: 0,0:14:37.19,0:14:40.94,1080,,0,0,0,,Ю неге ерекше?
Dialogue: 0,0:14:44.12,0:14:46.66,1080,,0,0,0,,Сонымен бүгін не үшін келдің?
Dialogue: 0,0:14:46.66,0:14:49.91,1080,,0,0,0,,Мен сенен мені оқытып,үйретуіңді өтінгім келді.
Dialogue: 0,0:14:49.91,0:14:51.29,1080,,0,0,0,,Бұл ойын емес
Dialogue: 0,0:14:51.29,0:14:52.45,1080,,0,0,0,,Жоқ.
Dialogue: 0,0:15:19.66,0:15:21.80,1080,,0,0,0,,Эй,бұл
Dialogue: 0,0:15:21.80,0:15:23.23,1080,,0,0,0,,бірақ енді Эсидиси жеңілгендіктен—
Dialogue: 0,0:15:30.75,0:15:32.10,1080,,0,0,0,,Бұл...
Dialogue: 0,0:15:33.21,0:15:35.34,1080,,0,0,0,,Осы формуланы қолдан
Dialogue: 0,0:15:35.34,0:15:38.12,1080,,0,0,0,,О,түсіндім.
Dialogue: 0,0:15:58.03,0:15:59.18,1080,,0,0,0,,Қорықпаңыздар,біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:15:59.55,0:16:00.88,1080,,0,0,0,,Келесі жолы қайсысы?
Dialogue: 0,0:16:02.53,0:16:03.74,1080,,0,0,0,,Егер
Dialogue: 0,0:16:05.22,0:16:07.48,1080,,0,0,0,,Менің жігітім болса
Dialogue: 0,0:16:08.08,0:16:09.28,1080,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:16:14.05,0:16:15.34,1080,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:16:16.76,0:16:17.92,1080,,0,0,0,,Ал...
Dialogue: 0,0:16:18.49,0:16:22.62,1080,,0,0,0,,Тәжірибе серіктесі ретінде мен сізді қолдаудан басқа амалым жоқ.
Dialogue: 0,0:16:24.97,0:16:26.25,1080,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:32.81,0:16:34.08,1080,,0,0,0,,Рахмет
Dialogue: 0,0:16:39.61,0:16:40.96,1080,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:16:56.80,0:17:00.26,1080,,0,0,0,,Мойындау Сіз мұны кіммен жасайсыз?
Dialogue: 0,0:17:05.75,0:17:09.52,1080,,0,0,0,,Сіз кездесесіз бе,жоқ па?
Dialogue: 0,0:17:10.73,0:17:12.73,1080,,0,0,0,,Мен білмеймін
Dialogue: 0,0:17:22.81,0:17:25.56,1080,,0,0,0,,Менің батылдығым аз.
Dialogue: 0,0:17:29.54,0:17:32.32,1080,,0,0,0,,Барлығы ғашық
Dialogue: 0,0:17:34.75,0:17:37.75,1080,,0,0,0,,Мен де солай істеймін бе деп ойлаймын.
Dialogue: 0,0:17:41.87,0:17:43.84,1080,,0,0,0,,Сіздің сүйікті адамыңыз кім?
Dialogue: 0,0:17:43.84,0:17:48.06,1080,,0,0,0,,Сізге ұнайтын адам кім? Сізге ұнайтын адам кім?
Dialogue: 0,0:17:57.39,0:18:01.50,1080,,0,0,0,,Өйткені Ю мейірімді,өйткені ол ақкөңіл.
Dialogue: 0,0:18:02.32,0:18:04.92,1080,,0,0,0,,Сен мені әрқашан мен сені қалай көремін,солай көресің.
Dialogue: 0,0:18:05.50,0:18:07.81,1080,,0,0,0,,Мені қолдаңыз
Dialogue: 0,0:18:08.87,0:18:10.37,1080,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:18:19.63,0:18:22.28,1080,,0,0,0,,Кімге ғашық болсам да
Dialogue: 0,0:18:22.28,0:18:24.92,1080,,0,0,0,,Юу сені қолдайды
Dialogue: 0,0:19:00.25,0:19:04.00,1080,,0,0,0,,Акаринді ойлап ұйықтай алмадым.
Dialogue: 0,0:19:08.64,0:19:11.13,1080,,0,0,0,,Акарин
Dialogue: 0,0:19:13.78,0:19:14.88,1080,,0,0,0,,О...
Dialogue: 0,0:19:15.89,0:19:17.13,1080,,0,0,0,,О?
Dialogue: 0,0:19:18.52,0:19:21.14,1080,,0,0,0,,Қайырлы таң,мен төсекте жатырмын.
Dialogue: 0,0:19:23.00,0:19:28.11,1080,,0,0,0,,Мен осында секіремін...
Dialogue: 0,0:19:34.45,0:19:35.76,1080,,0,0,0,,Құпия
Dialogue: 0,0:19:39.65,0:19:43.84,1080,,0,0,0,,Айла Бұл қандай сүйкімді мақұлық?
Dialogue: 0,0:19:46.17,0:19:50.46,1080,,0,0,0,,Бұл жарық,Акарин.
Dialogue: 0,0:19:54.14,0:19:57.88,1080,,0,0,0,,Акаринтомен бірінші рет сөйлесу
Dialogue: 0,0:20:00.98,0:20:02.52,1080,,0,0,0,,Акаринто...
Dialogue: 0,0:20:17.75,0:20:19.24,1080,,0,0,0,,Ұнады
Dialogue: 0,0:20:32.21,0:20:35.54,1080,,0,0,0,,Маған ұнайды. Бұны ұнатамын.
Dialogue: 0,0:20:35.54,0:20:38.13,1080,,0,0,0,,Йойо Хейо Қарап көріңіз
Dialogue: 0,0:20:38.13,0:20:39.31,1080,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:21:01.88,0:21:05.63,1080,,0,0,0,,Маған ұнайды
Dialogue: 0,0:21:23.38,0:21:25.72,1080,,0,0,0,,Қайғылы кезіңде маған кел.
Dialogue: 0,0:21:25.72,0:21:28.07,1080,,0,0,0,,Көңіл көтергенде бірге күлейік
Dialogue: 0,0:21:28.07,0:21:31.02,1080,,0,0,0,,Ерітетін дәмді «Honeywa-do» пудингі
Dialogue: 0,0:21:31.42,0:21:33.39,1080,,0,0,0,,Қане, көже жеп,көңіл көтерейік.
Dialogue: 0,0:21:33.39,0:21:36.10,1080,,0,0,0,,Қане, көже жеп,көңіл көтерейік.
Dialogue: 0,0:21:46.63,0:21:49.20,1080,,0,0,0,,Накчан,содан бері істеп жүрсің бе?
Dialogue: 0,0:21:49.20,0:21:51.20,1080,,0,0,0,,Мойындау репетициясы
Dialogue: 0,0:21:51.20,0:21:52.68,1080,,0,0,0,,Мен мұны істеп жатырмын
Dialogue: 0,0:21:54.34,0:21:58.46,1080,,0,0,0,,Мені жаңа ғана қабылдамады.
Dialogue: 0,0:21:58.46,0:22:00.92,1080,,0,0,0,,Сіз мойындауға жоқ дейсіз бе?
Dialogue: 0,0:22:01.38,0:22:04.59,1080,,0,0,0,,Қызық,мойындау тәжірибелік нәрсе ме?
Dialogue: 0,0:22:04.59,0:22:06.39,1080,,0,0,0,,Жақсы емес.
Dialogue: 0,0:22:06.39,0:22:10.90,1080,,0,0,0,,Мен білмеймін,бірақ мен бұл туралы көп естіген жоқпын.
Dialogue: 0,0:22:10.90,0:22:14.35,1080,,0,0,0,,Бірақ мойындау мені қатты қобалжытады.
Dialogue: 0,0:22:14.35,0:22:16.36,1080,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:22:16.36,0:22:19.31,1080,,0,0,0,,Ойымды айту маған қиын
Dialogue: 0,0:22:19.31,0:22:21.44,1080,,0,0,0,,Тіпті бала кездегі достар?
Dialogue: 0,0:22:21.44,0:22:23.91,1080,,0,0,0,,Өйткені біз бала кезден доспыз.
Dialogue: 0,0:22:23.91,0:22:25.70,1080,,0,0,0,,Маған қашаннан бері ғашық болдың?
Dialogue: 0,0:22:29.21,0:22:30.83,1080,,0,0,0,,Қай уақыттан бастап?
Dialogue: 0,0:22:38.64,0:22:42.04,1080,,0,0,0,,Кез келген жағдайда бірнеше рет жасамайынша бұл мүмкін емес.
Dialogue: 0,0:22:42.85,0:22:47.84,1080,,0,0,0,,Жігіт пен қыз болу қиын,солай емес пе?
Dialogue: 0,0:22:50.14,0:22:52.78,1080,,0,0,0,,Эй,Акариді ұнататын ешкім жоқ.
Dialogue: 0,0:22:54.65,0:22:57.32,1080,,0,0,0,,Мен ұлдармен мүлдем сөйлеспеймін.
Dialogue: 0,0:22:57.73,0:23:01.36,1080,,0,0,0,,Мен Мочизукимен өткен күні бірінші рет сөйлестім.
Dialogue: 0,0:23:01.36,0:23:03.07,1080,,0,0,0,,мочито нанте
Dialogue: 0,0:23:03.07,0:23:04.90,1080,,0,0,0,,Қайырлы таң
Dialogue: 0,0:23:04.90,0:23:06.62,1080,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:23:06.62,0:23:08.83,1080,,0,0,0,,Осыдан кейін «Менің ұйықтайтын әдетім бар».
Dialogue: 0,0:23:08.83,0:23:11.58,1080,,0,0,0,,Жоқ,бұл әңгіме емес.
Dialogue: 0,0:23:11.58,0:23:13.70,1080,,0,0,0,,Бірақ бұл Акари-чанға ұқсайды.
Dialogue: 0,0:23:18.05,0:23:22.38,1080,,0,0,0,,Менің махаббат оқулығым немесе анықтамалығым болғанын қалаймын.
Dialogue: 0,0:23:27.98,0:23:30.30,1080,,0,0,0,,О,бұл Эномото-сан.
Dialogue: 0,0:23:31.02,0:23:32.93,1080,,0,0,0,,Міне,не болғаны
Dialogue: 0,0:23:32.93,0:23:35.32,1080,,0,0,0,,Не,Койюки-кун?
Dialogue: 0,0:23:35.32,0:23:39.44,1080,,0,0,0,,Мм...келесі жолы Honey Works концерті болады.
Dialogue: 0,0:23:39.44,0:23:41.30,1080,,0,0,0,,А,мен білемін.
Dialogue: 0,0:23:41.30,0:23:44.57,1080,,0,0,0,,Сіз бұл билеттерді мүлде ала алмайсыз.
Dialogue: 0,0:23:44.57,0:23:45.94,1080,,0,0,0,,Билет
Dialogue: 0,0:23:47.50,0:23:49.45,1080,,0,0,0,,Мен түсіндім,бірақ
Dialogue: 0,0:23:49.45,0:23:52.05,1080,,0,0,0,,Өтірік айту
Dialogue: 0,0:23:52.05,0:23:55.50,1080,,0,0,0,,Рас, Коюки-кун, ғажап, ғажап,ғажап
Dialogue: 0,0:23:55.50,0:23:58.50,1080,,0,0,0,,Қарсы болмасаң,менімен барғың келе ме?
Dialogue: 0,0:23:58.50,0:24:02.10,1080,,0,0,0,,Жарайды, жүр, бар,міндетті түрде бар.
Dialogue: 0,0:24:04.06,0:24:05.88,1080,,0,0,0,,Содан кейін өмір сүр
Dialogue: 0,0:24:05.88,0:24:10.28,1080,,0,0,0,,Рахмет, Коюки-кун,көп рахмет.
Dialogue: 0,0:24:15.15,0:24:18.14,1080,,0,0,0,,Накчан,мен тікелей шоуға барамын.
Dialogue: 0,0:24:18.14,0:24:19.48,1080,,0,0,0,,Әрине
Dialogue: 0,0:24:19.48,0:24:21.20,1080,,0,0,0,,Коюки-кунмен?
Dialogue: 0,0:24:21.20,0:24:24.46,1080,,0,0,0,,Иә,өйткені бұл Honeywah-тың тікелей шоуы.
Dialogue: 0,0:24:24.46,0:24:27.15,1080,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:24:27.15,0:24:29.16,1080,,0,0,0,,Ұл баламен бірге тұру
Dialogue: 0,0:24:29.16,0:24:30.62,1080,,0,0,0,,Күн емес
Dialogue: 0,0:24:30.62,0:24:32.78,1080,,0,0,0,,Соған ұқсайды.
Dialogue: 0,0:24:34.17,0:24:37.08,1080,,0,0,0,,Сетогучи-кун осында болса да жақсы ма?
Dialogue: 0,0:24:38.22,0:24:41.16,1080,,0,0,0,,Эй, Накчан,бәрі жақсы.
Dialogue: 0,0:24:41.61,0:24:44.21,1080,,0,0,0,,Менде дәл қазір ақша тапшы болды.
Dialogue: 0,0:24:44.21,0:24:47.26,1080,,0,0,0,,Бірақ мен нақты шектеулі тауарларды алғым келеді.
Dialogue: 0,0:24:47.26,0:24:49.28,1080,,0,0,0,,Қалтаңыздың ақшасын алдын ала қарызға алмасаңыз
Dialogue: 0,0:24:49.28,0:24:51.45,1080,,0,0,0,,Менде қанша болуы керек?
Dialogue: 0,0:24:51.45,0:24:53.64,1080,,0,0,0,,Мен жай ғана Коюки-куннан сұраймын.
Dialogue: 0,0:24:53.64,0:24:55.39,1080,,0,0,0,,Коюки-кун,күте тұр.
Dialogue: 0,0:24:55.39,0:24:56.58,1080,,0,0,0,,Жоқ, тіпті қазір де,егер рұқсат етсеңіз…
Dialogue: 0,0:24:56.58,0:24:57.96,1080,,0,0,0,,Қорықпаңыздар,біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:25:08.83,0:25:12.54,1080,,0,0,0,,Эй Нацуки,сен неге бүгін көрші үйге бармайсың?
Dialogue: 0,0:25:12.57,0:25:13.66,1080,,0,0,0,,Неліктен?
Dialogue: 0,0:25:13.66,0:25:17.33,1080,,0,0,0,,Неге,сен әрқашан сонда емессің бе?
Dialogue: 0,0:25:17.33,0:25:19.83,1080,,0,0,0,,Бүгін мен ертеңгі күнге дайындаламын.
Dialogue: 0,0:25:20.31,0:25:22.47,1080,,0,0,0,,Егер сізде бір іс болса,өзіңіз жүріңіз.
Dialogue: 0,0:25:22.47,0:25:25.30,1080,,0,0,0,,Менің оны пайдалануым жоқ.
Dialogue: 0,0:25:25.30,0:25:27.97,1080,,0,0,0,,Ойлап қарасам,Хина-Чан өткен күні осылай деді.
Dialogue: 0,0:25:27.97,0:25:30.34,1080,,0,0,0,,Мен Котаромен ойын ойнағым келеді.
Dialogue: 0,0:25:30.34,0:25:32.58,1080,,0,0,0,,шынымен
Dialogue: 0,0:25:32.58,0:25:33.67,1080,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:25:34.77,0:25:37.47,1080,,0,0,0,,Ондай бейқам сөз айтпа,шіркін.
Dialogue: 0,0:25:37.47,0:25:40.24,1080,,0,0,0,,Әпкеңе жамандық жасау деген не?
Dialogue: 0,0:25:40.24,0:25:42.28,1080,,0,0,0,,Ұсқынсыз x4
Dialogue: 0,0:25:44.78,0:25:47.12,1080,,0,0,0,,Тағы бір жекпе-жек
Dialogue: 0,0:25:47.12,0:25:49.98,1080,,0,0,0,,Котаро Біз мектепте жиі ұрысамыз.
Dialogue: 0,0:25:49.98,0:25:51.71,1080,,0,0,0,,Шынында да бала
Dialogue: 0,0:25:51.71,0:25:53.24,1080,,0,0,0,,Сіз айтасыз ба?
Dialogue: 0,0:25:53.24,0:25:56.98,1080,,0,0,0,,Ағасындай ердің қадірі жоқ.
Dialogue: 0,0:25:56.98,0:26:00.24,1080,,0,0,0,,Мен онымен әлі қыз таба алмаймын деп ойлаймын.
Dialogue: 0,0:26:01.06,0:26:04.24,1080,,0,0,0,,Торатаро өкінеді
Dialogue: 0,0:26:10.81,0:26:12.04,1080,,0,0,0,,Жарайды
Dialogue: 0,0:26:17.90,0:26:19.82,1080,,0,0,0,,Ю,не болды?
Dialogue: 0,0:26:20.65,0:26:22.88,1080,,0,0,0,,Мен ойынды қайтаруға келдім.
Dialogue: 0,0:26:23.54,0:26:26.68,1080,,0,0,0,,Бүгін болмағанын қалаймын.
Dialogue: 0,0:26:26.68,0:26:28.52,1080,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:26:28.52,0:26:31.52,1080,,0,0,0,,Сен кеше келмедің.
Dialogue: 0,0:26:31.52,0:26:34.53,1080,,0,0,0,,Иә,мен аздап бос емеспін.
Dialogue: 0,0:26:40.80,0:26:42.66,1080,,0,0,0,,Иә,не
Dialogue: 0,0:26:42.66,0:26:43.84,1080,,0,0,0,,Жоқ
Dialogue: 0,0:26:44.84,0:26:46.00,1080,,0,0,0,,Сіз шығасыз ба?
Dialogue: 0,0:26:46.00,0:26:48.48,1080,,0,0,0,,Иә,Honeywah тірі
Dialogue: 0,0:26:48.48,0:26:50.92,1080,,0,0,0,,Мен біраздан бері барғым келеді.
Dialogue: 0,0:26:50.92,0:26:52.67,1080,,0,0,0,,Мен билет алдым.
Dialogue: 0,0:26:53.73,0:26:55.14,1080,,0,0,0,,Годамен және басқалармен
Dialogue: 0,0:26:55.14,0:26:56.92,1080,,0,0,0,,Жоқ,Коюки-кунмен.
Dialogue: 0,0:26:59.27,0:27:01.02,1080,,0,0,0,,Бұл жейде емес
Dialogue: 0,0:27:01.02,0:27:04.31,1080,,0,0,0,,Иә, дұрыс айтасыз,бұл тікелей эфир.
Dialogue: 0,0:27:04.31,0:27:06.64,1080,,0,0,0,,Барлығы сәнді болады.
Dialogue: 0,0:27:06.64,0:27:08.72,1080,,0,0,0,,Біреу?
Dialogue: 0,0:27:10.08,0:27:13.77,1080,,0,0,0,,Неге олай дейсің? Сәнді болсам жақсы емес пе?
Dialogue: 0,0:27:13.77,0:27:16.15,1080,,0,0,0,,Әлде бұл сізге сәйкес емес деп айтқыңыз келе ме?
Dialogue: 0,0:27:16.15,0:27:17.65,1080,,0,0,0,,Бөлек
Dialogue: 0,0:27:18.29,0:27:22.88,1080,,0,0,0,,Ю үшін менің қалай киінгенім маңызды емес.
Dialogue: 0,0:27:28.66,0:27:30.04,1080,,0,0,0,,That's right.
Dialogue: 0,0:27:39.19,0:27:40.30,1080,,0,0,0,,Не болды,апа?
Dialogue: 0,0:27:40.97,0:27:42.26,1080,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:27:42.86,0:27:44.28,1080,,0,0,0,,Не болды,апа?
Dialogue: 0,0:27:46.93,0:27:51.23,1080,,0,0,0,,Мен қазірдің өзінде тікелей эфирден ләззат аламын.
Dialogue: 0,0:29:35.68,0:29:38.60,1080,,0,0,0,,Коюки-кун,бүгінгі күн үшін рахмет...
Dialogue: 0,0:29:40.35,0:29:44.26,1080,,0,0,0,,Мен сені үйге осылай апарамын,солай ма?
Dialogue: 0,0:29:44.98,0:29:46.18,1080,,0,0,0,,Кешігіп қалғаным үшін кешірім сұраймын.
Dialogue: 0,0:30:27.65,0:30:30.80,1080,,0,0,0,,Міне,біз осындамыз.
Dialogue: 0,0:30:30.80,0:30:34.77,1080,,0,0,0,,Бүгінгі күн үшін рахмет. Бұл шынымен көңілді болды.
Dialogue: 0,0:30:35.99,0:30:41.02,1080,,0,0,0,,Мен үшін бұл шынымен де арман сияқты болды.
Dialogue: 0,0:30:41.87,0:30:43.90,1080,,0,0,0,,Сіз асыра айтып отырсыз,Коюки-кун.
Dialogue: 0,0:30:45.21,0:30:48.53,1080,,0,0,0,,Ю, Менің ойымша,сіз әлі үйге келген жоқсыз.
Dialogue: 0,0:30:49.13,0:30:51.96,1080,,0,0,0,,Сіз әлі ашулысыз ба?
Dialogue: 0,0:30:51.96,0:30:53.51,1080,,0,0,0,,Демек,Өлім періштесі тек алма жей ме?
Dialogue: 0,0:30:54.38,0:30:56.30,1080,,0,0,0,,Ем,кез келген нәрсе.
Dialogue: 0,0:30:57.01,0:31:00.72,1080,,0,0,0,,Сетогучи-кунмен бірдеңе болды.
Dialogue: 0,0:31:06.31,0:31:07.89,1080,,0,0,0,,Бұл...
Dialogue: 0,0:31:07.89,0:31:10.82,1080,,0,0,0,,Сіз дәл қазір қандай болғаныңызды білесіз бе?
Dialogue: 0,0:31:11.53,0:31:15.00,1080,,0,0,0,,Мен сені бұлай мұңаймас едім.
Dialogue: 0,0:31:15.00,0:31:16.47,1080,,0,0,0,,Мүлдем
Dialogue: 0,0:31:16.87,0:31:18.40,1080,,0,0,0,,Демек,бұл Сетогучи емес...
Dialogue: 0,0:31:18.40,0:31:19.91,1080,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:31:22.45,0:31:23.40,1080,,0,0,0,,Ю
Dialogue: 0,0:31:23.40,0:31:28.03,1080,,0,0,0,,Аясе,сен ТПО сөзін білесің.
Dialogue: 0,0:31:28.03,0:31:31.78,1080,,0,0,0,,Бұл қоғамдық орын,маңайдан адамдар өтіп жатыр.
Dialogue: 0,0:31:31.78,0:31:35.04,1080,,0,0,0,,Нацуки оны осылай көрсе,қиналып қалар еді.
Dialogue: 0,0:31:35.04,0:31:36.79,1080,,0,0,0,,Солай ма?
Dialogue: 0,0:31:36.79,0:31:40.74,1080,,0,0,0,,Егер сіз өзіңізді жігітім деп көрсетсеңіз,бұл жігіт туралы көбірек ойлаңыз.
Dialogue: 0,0:31:43.43,0:31:46.36,1080,,0,0,0,,Ол сөз бумерангқа айналып кетпей ме?
Dialogue: 0,0:31:46.36,0:31:47.36,1080,,0,0,0,,Жоқ
Dialogue: 0,0:31:46.82,0:31:48.81,1080,,0,0,0,,Мұны қалай айтуға болады?
Dialogue: 0,0:31:48.81,0:31:50.30,1080,,0,0,0,,Өйткені біз бала кезден доспыз
Dialogue: 0,0:31:50.30,0:31:52.80,1080,,0,0,0,,Бала күнгі дос
Dialogue: 0,0:31:54.05,0:31:57.35,1080,,0,0,0,,Эй,тоқтат.
Dialogue: 0,0:31:58.98,0:31:59.82,1080,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:31:59.82,0:32:03.76,1080,,0,0,0,,Тоқта,қашып барасың ба? Әңгіме әлі біткен жоқ...
Dialogue: 0,0:32:02.76,0:32:05.07,1080,,0,0,0,,Әңгіменің соңы
Dialogue: 0,0:32:07.00,0:32:09.56,1080,,0,0,0,,Сенің арқасында тіпті трусигім де суға малып кетті. О,Құдай-ай…
Dialogue: 0,0:33:08.52,0:33:10.22,1080,,0,0,0,,Көздер ауыр
Dialogue: 0,0:33:20.45,0:33:22.48,1080,,0,0,0,,Мен неге жыладым деп ойлаймын
Dialogue: 0,0:33:23.28,0:33:24.96,1080,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса,ықтималдығы аз болса да
Dialogue: 0,0:33:24.96,0:33:26.84,1080,,0,0,0,,Беттің қандай түрін жасауым керек?
Dialogue: 0,0:33:37.57,0:33:38.76,1080,,0,0,0,,Жарайды
Dialogue: 0,0:33:50.94,0:33:52.12,1080,,0,0,0,,Года және т.б
Dialogue: 0,0:33:53.18,0:33:57.02,1080,,0,0,0,,Өнер үйірмесінің сайысы алда,сондықтан мен алға барамын.
Dialogue: 0,0:34:01.07,0:34:03.23,1080,,0,0,0,,Сіз не істеп жатырсыз? Барайық.
Dialogue: 0,0:34:10.29,0:34:11.48,1080,,0,0,0,,Ұнады
Dialogue: 0,0:34:15.13,0:34:18.62,1080,,0,0,0,,Кенеттен бастамаңыз Мойындау репетициясы
Dialogue: 0,0:34:18.62,0:34:20.92,1080,,0,0,0,,Бұл кенеттен болса,мойындау болар еді.
Dialogue: 0,0:34:20.92,0:34:22.50,1080,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:34:22.50,0:34:23.75,1080,,0,0,0,,Тым жеңіл
Dialogue: 0,0:34:23.75,0:34:25.17,1080,,0,0,0,,Маған ұнайды
Dialogue: 0,0:34:25.17,0:34:26.17,1080,,0,0,0,,Дауыс тым үлкен
Dialogue: 0,0:34:26.17,0:34:27.13,1080,,0,0,0,,Ұнату және ұнату
Dialogue: 0,0:34:27.13,0:34:28.13,1080,,0,0,0,,Тым көп
Dialogue: 0,0:34:28.13,0:34:29.93,1080,,0,0,0,,Маған ұнады
Dialogue: 0,0:34:29.93,0:34:30.96,1080,,0,0,0,,Бұл не?
Dialogue: 0,0:34:37.02,0:34:40.89,1080,,0,0,0,,Қарбыз және жираф
Dialogue: 0,0:34:41.78,0:34:43.95,1080,,0,0,0,,Бірге ұнайды
Dialogue: 0,0:34:43.95,0:34:46.54,1080,,0,0,0,,Тек екі әріпті айт,солай ма?
Dialogue: 0,0:34:46.54,0:34:48.00,1080,,0,0,0,,Иә,бірақ
Dialogue: 0,0:34:48.00,0:34:50.46,1080,,0,0,0,,«Мен Акаримен көбірек сөйлескім келеді».
Dialogue: 0,0:34:50.46,0:34:51.70,1080,,0,0,0,,Менің ойымша,сіз осылай ойлайсыз.
Dialogue: 0,0:34:51.70,0:34:54.07,1080,,0,0,0,,Мен мұны істей алмаймын,өйткені менде мұндай батылдық жоқ.
Dialogue: 0,0:34:54.07,0:34:57.45,1080,,0,0,0,,Акаринга біреумен жүрсе жарай ма?
Dialogue: 0,0:34:57.45,0:34:58.06,1080,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:34:58.06,0:34:59.78,1080,,0,0,0,,Содан кейін мойындаңыз.
Dialogue: 0,0:34:59.78,0:35:00.87,1080,,0,0,0,,Дұрыс~,оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,0:35:00.87,0:35:02.40,1080,,0,0,0,,Атмосфера басқаша емес.
Dialogue: 0,0:35:02.40,0:35:04.00,1080,,0,0,0,,Мен шашымды кесіп тастадым.
Dialogue: 0,0:35:06.52,0:35:08.04,1080,,0,0,0,,Бұл жақсы сезінеді.
Dialogue: 0,0:35:07.28,0:35:08.58,1080,,0,0,0,,Менің ойымша,бұл сүйкімді
Dialogue: 0,0:35:09.81,0:35:12.08,1080,,0,0,0,,Әй,бүгінгі адамдар.
Dialogue: 0,0:35:12.08,0:35:15.42,1080,,0,0,0,,Сакурагаока орта мектебі бұл станция емес пе?
Dialogue: 0,0:35:15.42,0:35:18.27,1080,,0,0,0,,Сіз өз орныңызды бердіңіз бе?
Dialogue: 0,0:35:19.94,0:35:21.30,1080,,0,0,0,,Бұл
Dialogue: 0,0:35:21.30,0:35:23.18,1080,,0,0,0,,Рахмет
Dialogue: 0,0:35:23.18,0:35:24.62,1080,,0,0,0,,Жақсы,онда
Dialogue: 0,0:35:29.70,0:35:32.44,1080,,0,0,0,,Оны білу ұят болды.
Dialogue: 0,0:35:32.44,0:35:34.66,1080,,0,0,0,,Орынымды беруге батылым жетсе де.
Dialogue: 0,0:35:34.66,0:35:37.42,1080,,0,0,0,,Мойындауға неге батылым жетпейді?
Dialogue: 0,0:35:40.45,0:35:41.90,1080,,0,0,0,,Біз өткен күні бірге болдық...
Dialogue: 0,0:35:45.54,0:35:47.45,1080,,0,0,0,,Бұл оңай
Dialogue: 0,0:35:59.69,0:36:00.94,1080,,0,0,0,,Коюки-кун
Dialogue: 0,0:36:02.94,0:36:04.35,1080,,0,0,0,,Эномото мырза
Dialogue: 0,0:36:04.35,0:36:06.76,1080,,0,0,0,,Кеше сол...
Dialogue: 0,0:36:08.49,0:36:10.10,1080,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:36:10.10,0:36:12.76,1080,,0,0,0,,Жоқ,бұл үшін кешірім сұраймын.
Dialogue: 0,0:36:12.76,0:36:14.98,1080,,0,0,0,,Біртүрлі нәрсе болды.
Dialogue: 0,0:36:14.98,0:36:17.00,1080,,0,0,0,,Жоқ,бұл...
Dialogue: 0,0:36:17.00,0:36:19.72,1080,,0,0,0,,Бұл гүлді Коюки-кун өсірді ме?
Dialogue: 0,0:36:19.72,0:36:20.49,1080,,0,0,0,,Иә
Dialogue: 0,0:36:20.49,0:36:21.84,1080,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:36:21.84,0:36:24.49,1080,,0,0,0,,Бұл таңқаларлық. Көгалдандыру клубынан күткендей.
Dialogue: 0,0:36:24.49,0:36:26.98,1080,,0,0,0,,Әр түрлі гүлдерді отырғызуды жалғастырамын.
Dialogue: 0,0:36:26.98,0:36:28.70,1080,,0,0,0,,Бізге қайта келіңіз
Dialogue: 0,0:36:28.70,0:36:29.88,1080,,0,0,0,,Иә Я
Dialogue: 0,0:36:29.88,0:36:30.74,1080,,0,0,0,,Иә
Dialogue: 0,0:36:49.68,0:36:51.69,1080,,0,0,0,,Иә,солай.
Dialogue: 0,0:36:51.69,0:36:52.99,1080,,0,0,0,,Құдай-ай,неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:36:53.45,0:36:54.74,1080,,0,0,0,,Бүгін түскі ас па?
Dialogue: 0,0:36:54.74,0:36:55.80,1080,,0,0,0,,Бүгін сатып алыңыз
Dialogue: 0,0:36:55.80,0:36:57.02,1080,,0,0,0,,Не сатып алу керек?
Dialogue: 0,0:36:57.94,0:37:00.44,1080,,0,0,0,,Акари: Түскі қорапты өзіңіз жасадыңыз ба?
Dialogue: 0,0:37:00.44,0:37:03.70,1080,,0,0,0,,Иә,анам бос емес сияқты.
Dialogue: 0,0:37:04.42,0:37:07.95,1080,,0,0,0,,Мен Акариннің қолдан жасаған бентосын көргім келеді
Dialogue: 0,0:37:22.27,0:37:24.14,1080,,0,0,0,,Сол Юкки
Dialogue: 0,0:37:24.14,0:37:25.09,1080,,0,0,0,,Юкки?
Dialogue: 0,0:37:26.86,0:37:28.72,1080,,0,0,0,,Жақсы,Юкки.
Dialogue: 0,0:37:32.78,0:37:37.54,1080,,0,0,0,,Эй,Юкки Нацукиді ұнатады.
Dialogue: 0,0:37:37.54,0:37:39.15,1080,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:37:39.15,0:37:44.24,1080,,0,0,0,,Юкки маған ұқсайтын сияқты.
Dialogue: 0,0:37:45.99,0:37:47.98,1080,,0,0,0,,Жоқ,жоқ па?
Dialogue: 0,0:37:47.98,0:37:49.92,1080,,0,0,0,,Юкки керемет
Dialogue: 0,0:37:49.92,0:37:52.42,1080,,0,0,0,,Осылайша мен өзімді өзгерте алдым
Dialogue: 0,0:37:52.42,0:37:55.66,1080,,0,0,0,,Маған өзгеруге мүмкіндік берген адам Эномото мырза болды.
Dialogue: 0,0:37:55.66,0:37:58.12,1080,,0,0,0,,Ештеңе жасамай,өкінген жақсы.
Dialogue: 0,0:37:58.12,0:38:01.76,1080,,0,0,0,,Мүмкін, қолыңнан келгенін істеп,өкінген жақсы шығар.
Dialogue: 0,0:38:01.76,0:38:04.63,1080,,0,0,0,,Мен оның нөл пайыз екенін білемін.
Dialogue: 0,0:38:04.63,0:38:06.64,1080,,0,0,0,,Бірақ мен үнсіз қалғаныма сене алар емеспін.
Dialogue: 0,0:38:06.64,0:38:08.64,1080,,0,0,0,,Бұл көңілсіз емес пе?
Dialogue: 0,0:38:09.49,0:38:13.22,1080,,0,0,0,,Юкки,мен Нацукидің сезімін білемін...
Dialogue: 0,0:38:13.22,0:38:16.78,1080,,0,0,0,,Мочизуки-кун Хаясаканы ұнатады,солай ма?
Dialogue: 0,0:38:16.78,0:38:18.52,1080,,0,0,0,,Жоқ,бұл...
Dialogue: 0,0:38:21.67,0:38:24.78,1080,,0,0,0,,Қабылдау рәсімінен бастап.
Dialogue: 0,0:38:31.01,0:38:35.64,1080,,0,0,0,,Бірақ біз бұл туралы бір рет қана айттық.
Dialogue: 0,0:38:38.39,0:38:40.14,1080,,0,0,0,,Жақында ғана
Dialogue: 0,0:38:40.14,0:38:44.36,1080,,0,0,0,,Не керек,менің айтқаным: «Ұйықтайтын әдетім бар».
Dialogue: 0,0:38:44.36,0:38:46.68,1080,,0,0,0,,Бұл алға қадам емес пе?
Dialogue: 0,0:38:46.68,0:38:49.68,1080,,0,0,0,,Бірақ мойындауға тіпті батылым жетпейді.
Dialogue: 0,0:38:49.68,0:38:51.68,1080,,0,0,0,,Қатты ойлан
Dialogue: 0,0:38:52.24,0:38:54.18,1080,,0,0,0,,Рұқсатсыз ашулану
Dialogue: 0,0:38:54.65,0:38:56.94,1080,,0,0,0,,Мен өзімді жек көремін.
Dialogue: 0,0:38:56.94,0:38:58.69,1080,,0,0,0,,Бірақ бұл сізге ұнайды деп ойлаймын.
Dialogue: 0,0:39:00.44,0:39:03.00,1080,,0,0,0,,Ғашық болу сезімі өтірік емес
Dialogue: 0,0:39:04.88,0:39:06.90,1080,,0,0,0,,Менің ойымша,бұл мүмкін
Dialogue: 0,0:39:06.90,0:39:09.54,1080,,0,0,0,,Мочизуки-кун нөл пайыз емес.
Dialogue: 0,0:39:11.08,0:39:14.06,1080,,0,0,0,,Қызық,мен де өзгере аламын ба?
Dialogue: 0,0:39:14.95,0:39:17.58,1080,,0,0,0,,«Мен өзгергім келеді» деп ойлаған кезде
Dialogue: 0,0:39:17.58,0:39:19.12,1080,,0,0,0,,Бастапқы сызық
Dialogue: 0,0:39:22.18,0:39:24.84,1080,,0,0,0,,Мен өзгергім келеді
Dialogue: 0,0:39:24.84,0:39:28.84,1080,,0,0,0,,Өйткені мен Акариннің жылаған түрін көргім келмейді.
Dialogue: 0,0:39:29.94,0:39:31.62,1080,,0,0,0,,Менің көргім келетін нәрсе...
Dialogue: 0,0:39:39.94,0:39:41.69,1080,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:39:42.09,0:39:43.36,1080,,0,0,0,,Рахмет
Dialogue: 0,0:40:19.83,0:40:21.18,1080,,0,0,0,,Хаясака мырза
Dialogue: 0,0:40:21.90,0:40:23.44,1080,,0,0,0,,Мочизуки-кун?
Dialogue: 0,0:40:25.96,0:40:27.10,1080,,0,0,0,,Біз кесіп өтетін нәрсе – ақымақтық сызығы
Dialogue: 0,0:40:28.78,0:40:30.29,1080,,0,0,0,,Менің бір оқиғам бар.
Dialogue: 0,0:40:30.29,0:40:32.18,1080,,0,0,0,,Бүгін сабақтан кейін 4:10
Dialogue: 0,0:40:32.18,0:40:34.28,1080,,0,0,0,,Өнер бөлмесінде күте аласыз ба?
Dialogue: 0,0:40:44.39,0:40:47.14,1080,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:40:50.48,0:40:51.94,1080,,0,0,0,,деді
Dialogue: 0,0:40:53.98,0:40:55.80,1080,,0,0,0,,Мен айттым
Dialogue: 0,0:40:57.86,0:41:00.06,1080,,0,0,0,,Бұл екінші әңгіме.
Dialogue: 0,0:41:00.54,0:41:04.02,1080,,0,0,0,,Бұл не?
Dialogue: 0,0:41:10.67,0:41:12.06,1080,,0,0,0,,Харуки-кун
Dialogue: 0,0:41:12.06,0:41:16.26,1080,,0,0,0,,Сіз маған кеше берген DVD өте қызық болды...
Dialogue: 0,0:41:16.26,0:41:17.74,1080,,0,0,0,,А,кешіріңіз.
Dialogue: 0,0:41:17.74,0:41:21.00,1080,,0,0,0,,Саки-нимен сөйлесетін бірдеңе бар,сондықтан бүгін алдымен үйге қайт.
Dialogue: 0,0:41:21.00,0:41:23.68,1080,,0,0,0,,Эй,сен мені мектепте мұғалім деп атасаң болады.
Dialogue: 0,0:41:23.68,0:41:27.01,1080,,0,0,0,,Мен сізді мұғалім деп атауға ыңғайсызданып тұрмын.
Dialogue: 0,0:41:27.01,0:41:29.14,1080,,0,0,0,,Егер сізге мұғалім болу ұнамаса,сіз профессор бола аласыз.
Dialogue: 0,0:41:29.14,0:41:30.48,1080,,0,0,0,,Иә Иә
Dialogue: 0,0:41:30.48,0:41:31.46,1080,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:41:31.46,0:41:34.01,1080,,0,0,0,,Жоқ,бәрі жақсы.
Dialogue: 0,0:41:34.01,0:41:37.01,1080,,0,0,0,,Мұғаліммен ұрыспа
Dialogue: 0,0:41:40.01,0:41:41.86,1080,,0,0,0,,Ұрыспаңыз
Dialogue: 0,0:41:44.16,0:41:46.20,1080,,0,0,0,,(Сакура) Ни, но, ро,я…
Dialogue: 0,0:41:48.77,0:41:50.66,1080,,0,0,0,,Неліктен жігіттер кездесіп жатырсыздар...
Dialogue: 0,0:41:50.66,0:41:51.74,1080,,0,0,0,,Жарайды,осы ғана. Абай бол.
Dialogue: 0,0:41:51.74,0:41:53.52,1080,,0,0,0,,Менің айтайын дегенім, Саки-нии,темекінің иісі бар.
Dialogue: 0,0:41:53.52,0:41:55.56,1080,,0,0,0,,Темекіні тастау керек емес пе?
Dialogue: 0,0:41:55.56,0:42:00.30,1080,,0,0,0,,Ересектердің жағдайына байланысты қазір 2 темекі және 3 кәмпит.
Мен
Dialogue: 0,0:42:00.30,0:42:03.66,1080,,0,0,0,,түсінбеймін
Dialogue: 0,0:42:03.66,0:42:05.42,1080,,0,0,0,,Біз кәмпит жейміз бе?
Dialogue: 0,0:42:05.42,0:42:08.30,1080,,0,0,0,,Қажет емес,мен бала емеспін.
Dialogue: 0,0:42:08.30,0:42:11.36,1080,,0,0,0,,Мен баламын,тағы да уақытым болады деп ойлаймын.
Dialogue: 0,0:42:12.30,0:42:14.66,1080,,0,0,0,,Оқу күндері қысқа.
Dialogue: 0,0:42:14.66,0:42:18.68,1080,,0,0,0,,Фильм сияқты артқа айналдыру немесе өңдеу мүмкін емес.
Dialogue: 0,0:42:18.98,0:42:21.61,1080,,0,0,0,,Айтқыңыз келген нәрсені тез айтыңыз.
Dialogue: 0,0:42:21.61,0:42:25.56,1080,,0,0,0,,Бәрі біткен соң өкінсеңіз де,бәрі кеш.
Dialogue: 0,0:42:25.56,0:42:27.66,1080,,0,0,0,,Бұл сіздің тәжірибеңіз бе?
Dialogue: 0,0:42:27.66,0:42:30.06,1080,,0,0,0,,Бұрынғылар айтқан
Dialogue: 0,0:42:30.40,0:42:35.10,1080,,0,0,0,,Алдымен өкінбе,жіберіп алған балығың үлкен.
Dialogue: 0,0:42:36.57,0:42:40.76,1080,,0,0,0,,Сол себепті,жастық шағыңыздың рахатын көру үшін бар күшіңізді салыңыз.
Dialogue: 0,0:42:40.76,0:42:43.59,1080,,0,0,0,,Кәмпит жеп ал,әрі қарай жеп ал.
Dialogue: 0,0:42:43.59,0:42:45.21,1080,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:42:53.02,0:42:55.84,1080,,0,0,0,,Сіздің Харукимен бірге болмағаныңыз ерекше.
Dialogue: 0,0:42:55.84,0:42:59.18,1080,,0,0,0,,Менің Әкечи-сенсімен сөйлесетін бірдеңе бар сияқты.
Dialogue: 0,0:42:59.18,0:43:01.58,1080,,0,0,0,,Мен олардың төбелесіп жатқанын да көремін.
Dialogue: 0,0:43:01.58,0:43:05.37,1080,,0,0,0,,Бірақ Харуки-кун да Акечи-сенсейді ұнататын сияқты.
Dialogue: 0,0:43:05.37,0:43:09.15,1080,,0,0,0,,Сізге ұнады ма? Бұл екеуінің қарым-қатынасы күдікті.
Dialogue: 0,0:43:09.15,0:43:13.11,1080,,0,0,0,,Е, Накчан,мен мұны айтып тұрмын.
Dialogue: 0,0:43:13.11,0:43:14.84,1080,,0,0,0,,(Иура) Жарайды,жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:43:14.84,0:43:18.38,1080,,0,0,0,,Ештеңе етпейді,еркектер қарсыластарға қосылмайды.
Dialogue: 0,0:43:18.99,0:43:21.99,1080,,0,0,0,,Демек бұл мағына емес.
Dialogue: 0,0:43:22.40,0:43:26.37,1080,,0,0,0,,Ұнамаса,айт.
Dialogue: 0,0:43:26.37,0:43:29.14,1080,,0,0,0,,Мойындау репетициясы
Dialogue: 0,0:43:29.68,0:43:32.16,1080,,0,0,0,,Сіз қай уақытқа дейін жаттығуды жоспарлайсыз?
Dialogue: 0,0:43:32.16,0:43:33.62,1080,,0,0,0,,Нақты орындалғанға дейін
Dialogue: 0,0:43:35.60,0:43:37.76,1080,,0,0,0,,Сіз шынымен жақсысыз.
Dialogue: 0,0:43:37.76,0:43:40.39,1080,,0,0,0,,Себебі мен сенімен бірге шығуға уәде бердім.
Dialogue: 0,0:43:42.78,0:43:45.77,1080,,0,0,0,,Біткен соң өкінсең де,бәрі кеш.
Dialogue: 0,0:43:46.21,0:43:48.70,1080,,0,0,0,,Егер сізге біреу ұнаса,оған тура барыңыз.
Dialogue: 0,0:43:48.70,0:43:51.27,1080,,0,0,0,,Мен сенің айтқаныңды қаламаймын.
Dialogue: 0,0:43:59.04,0:44:01.82,1080,,0,0,0,,Мойындау жоқ
Dialogue: 0,0:44:02.88,0:44:05.28,1080,,0,0,0,,Мен жақсы көретін адам бар екенін білемін
Dialogue: 0,0:44:05.28,0:44:08.80,1080,,0,0,0,,Мойындасам,бәлеге қалатынымды көріп тұрмын.
Dialogue: 0,0:44:08.80,0:44:11.67,1080,,0,0,0,,Жоқ, сәл күте тұрыңыз,оған кім ұнайды...
Dialogue: 0,0:44:11.67,0:44:15.56,1080,,0,0,0,,Мұндағы ағын, менің ойымша,аздап ауысқан дұрыс.
Dialogue: 0,0:44:16.58,0:44:18.21,1080,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,...
Dialogue: 0,0:44:25.57,0:44:26.90,1080,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:44:46.22,0:44:48.70,1080,,0,0,0,,Менің жүрегім жарылып кете жаздады
Dialogue: 0,0:44:57.44,0:44:58.50,1080,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:45:35.71,0:45:37.50,1080,,0,0,0,,Маған жақсы ма?
Dialogue: 0,0:45:37.50,0:45:40.63,1080,,0,0,0,,Иә,мен солай ойлаймын.
Dialogue: 0,0:45:43.42,0:45:45.09,1080,,0,0,0,,Бұл сенің маған ұнайтыныңды білдіреді.
Dialogue: 0,0:45:45.86,0:45:47.64,1080,,0,0,0,,Сондықтан маған ұнайды
Dialogue: 0,0:45:47.64,0:45:51.22,1080,,0,0,0,,Мен сені ешқашан мұңайтпаймын және сені күнде күлдіремін.
Dialogue: 0,0:45:52.10,0:45:55.12,1080,,0,0,0,,Маған күнде түскі ас қорапшасын жасап берулеріңізді қалаймын.
Dialogue: 0,0:46:00.67,0:46:05.78,1080,,0,0,0,,Мен күнде түскі ас жасағанды ​​ұнатпаймын,себебі бұл ауырады.
Dialogue: 0,0:46:08.05,0:46:10.36,1080,,0,0,0,,Мен тым көп күшпен айттым.
Dialogue: 0,0:46:11.22,0:46:16.00,1080,,0,0,0,,Айтпақшы,вокзал алдында жаңа торт дүкені ашылды.
Dialogue: 0,0:46:17.10,0:46:21.12,1080,,0,0,0,,Қарсы болмасаңыз,келесі жолы менімен бірге барғыңыз келе ме?
Dialogue: 0,0:46:26.23,0:46:28.44,1080,,0,0,0,,Иә,барамын.
Dialogue: 0,0:46:31.78,0:46:37.24,1080,,0,0,0,,Эй, Накчан,сен неге мойындауды шештің?
Dialogue: 0,0:46:41.00,0:46:42.64,1080,,0,0,0,,Дұрыс айтасың — ол әдеттегіден де көп әуре-сарсаңға түсіп жүр.
Dialogue: 0,0:46:45.88,0:46:47.34,1080,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:46:48.80,0:46:52.30,1080,,0,0,0,,Юуды кіші сынып оқушысы мойындап жатқан көрініс.
Dialogue: 0,0:46:52.30,0:46:55.25,1080,,0,0,0,,Ал,Юу бас тартты.
Dialogue: 0,0:46:55.68,0:46:57.67,1080,,0,0,0,,Мен мұны көргенде
Dialogue: 0,0:46:58.34,0:47:01.85,1080,,0,0,0,,Мен де мойындауым керек деп ойладым.
Dialogue: 0,0:47:01.85,0:47:03.38,1080,,0,0,0,,Мен көремін.
Dialogue: 0,0:47:04.19,0:47:05.96,1080,,0,0,0,,Бірақ мен қорықпаймын
Dialogue: 0,0:47:06.51,0:47:09.54,1080,,0,0,0,,Мойындағаннан кейін бәрі жақсы болады деп үміттенемін.
Dialogue: 0,0:47:09.54,0:47:12.32,1080,,0,0,0,,Егер сізге бас тартылса...
Dialogue: 0,0:47:21.54,0:47:23.74,1080,,0,0,0,,Кенет салқындап кетті.
Dialogue: 0,0:47:23.74,0:47:25.40,1080,,0,0,0,,Иә,кеш болды.
Dialogue: 0,0:47:27.90,0:47:30.88,1080,,0,0,0,,Иә,Миомен аздап.
Dialogue: 0,0:47:30.88,0:47:32.16,1080,,0,0,0,,Сол
Dialogue: 0,0:47:32.72,0:47:34.20,1080,,0,0,0,,Харуки және аздап
Dialogue: 0,0:47:50.19,0:47:53.12,1080,,0,0,0,,Егер сіз мойындасаңыз
Dialogue: 0,0:47:53.66,0:47:55.78,1080,,0,0,0,,Егер бас тартылса
Dialogue: 0,0:47:59.89,0:48:04.86,1080,,0,0,0,,Мен осылай мойындамасам болады ма?
Dialogue: 0,0:48:05.18,0:48:09.78,1080,,0,0,0,,Бұл әлі де қызық және біз бірге бола аламыз.
Dialogue: 0,0:48:11.20,0:48:16.76,1080,,0,0,0,,Қарсы емеспін,бала кезден доспыз.
Dialogue: 0,0:48:21.60,0:48:23.43,1080,,0,0,0,,Менің мұрным тамшылап тұр.
Dialogue: 0,0:48:23.43,0:48:25.43,1080,,0,0,0,,Ол тамшылап тұрған жоқ.
Dialogue: 0,0:48:25.43,0:48:26.76,1080,,0,0,0,,Абсолютті тамшылау
Dialogue: 0,0:48:26.76,0:48:28.96,1080,,0,0,0,,Кішкене болса да сақтығыңызды түсірмеңіз.
Dialogue: 0,0:48:28.96,0:48:30.54,1080,,0,0,0,,Бұл суық тиюдің үлгісі.
Dialogue: 0,0:48:30.80,0:48:33.43,1080,,0,0,0,,Нацуки әрқашан осылай болған.
Dialogue: 0,0:48:33.43,0:48:34.94,1080,,0,0,0,,Алдын алу
Dialogue: 0,0:48:58.47,0:49:00.20,1080,,0,0,0,,Маған әлі де ұнайды
Dialogue: 0,0:49:02.72,0:49:04.18,1080,,0,0,0,,Маған Ю
Dialogue: 0,0:49:14.65,0:49:17.43,1080,,0,0,0,,Мен өзімшілмін
Dialogue: 0,0:49:47.56,0:49:53.38,1080,,0,0,0,,Мен Юудан осы уақытқа дейін көп нәрсе алдым,мен одан да көп нәрсені қалаймын.
Dialogue: 0,0:49:53.38,0:49:56.39,1080,,0,0,0,,Ю
Dialogue: 0,0:50:00.82,0:50:03.30,1080,,0,0,0,,Өйткені Ю мен үшін ерекше
Dialogue: 0,0:50:03.30,0:50:06.27,1080,,0,0,0,,Мен де Юуға ерекше болғым келеді.
Dialogue: 0,0:50:15.09,0:50:18.07,1080,,0,0,0,,Қызық,мен сені қолдаймын ба?
Dialogue: 0,0:50:21.76,0:50:24.62,1080,,0,0,0,,Мен сені қолдауым керек.
Dialogue: 0,0:50:56.95,0:50:59.45,1080,,0,0,0,,Келесі кезекте бүгінгі жұлдыз жорамал.
Dialogue: 0,0:50:59.45,0:51:03.46,1080,,0,0,0,,Бірінші бақытты зодиак белгісі - қатерлі ісік.
Dialogue: 0,0:51:03.46,0:51:04.95,1080,,0,0,0,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:51:16.02,0:51:17.20,1080,,0,0,0,,Жарайды
Dialogue: 0,0:51:18.32,0:51:19.85,1080,,0,0,0,,Қайырлы таң
Dialogue: 0,0:51:19.85,0:51:20.80,1080,,0,0,0,,Накчан қайырлы таң...
Dialogue: 0,0:51:20.80,0:51:22.07,1080,,0,0,0,,Қайырлы таң...
Dialogue: 0,0:51:26.06,0:51:28.15,1080,,0,0,0,,Бұл бетке не болды?
Dialogue: 0,0:51:28.15,0:51:31.83,1080,,0,0,0,,Нацуки Эномото Мен бүгін тағы да шабуыл жасаймын.
Dialogue: 0,0:51:32.33,0:51:33.92,1080,,0,0,0,,Мен бүгін бара аламын.
Dialogue: 0,0:51:33.92,0:51:36.90,1080,,0,0,0,,Өйткені бүгінгі жұлдыз жорамында Қатерлі ісік бірінші орында тұрды.
Dialogue: 0,0:51:36.90,0:51:38.20,1080,,0,0,0,,Жұлдызнама?
Dialogue: 0,0:51:38.20,0:51:39.56,1080,,0,0,0,,Мен саған әйелдік күш бердім
Dialogue: 0,0:51:39.56,0:51:40.82,1080,,0,0,0,,Әйелдік күш?
Dialogue: 0,0:51:46.14,0:51:47.36,1080,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:51:48.04,0:51:49.06,1080,,0,0,0,,Чочочочочо...
Dialogue: 0,0:51:49.06,0:51:51.18,1080,,0,0,0,,Бір сәт кешіріңіз.
Dialogue: 0,0:51:51.83,0:51:54.22,1080,,0,0,0,,Әй, ерін далабыңды шешіп,жағыңыз.
Dialogue: 0,0:51:54.22,0:51:55.42,1080,,0,0,0,,Сондай-ақ негіз.
Dialogue: 0,0:51:55.42,0:51:57.86,1080,,0,0,0,,Неліктен?
Dialogue: 0,0:52:03.68,0:52:05.52,1080,,0,0,0,,Эномото кері
Dialogue: 0,0:52:07.04,0:52:09.56,1080,,0,0,0,,Itadadakimasu
Dialogue: 0,0:52:09.56,0:52:11.36,1080,,0,0,0,,Тонкацу бенто?
Dialogue: 0,0:52:11.36,0:52:15.07,1080,,0,0,0,,Қарның ашса,ұрыс...
Dialogue: 0,0:52:22.92,0:52:24.07,1080,,0,0,0,,Жарайды
Dialogue: 0,0:52:41.65,0:52:44.22,1080,,0,0,0,,Накчан,қолыңнан келгеннің бәрін істе
Dialogue: 0,0:52:48.99,0:52:51.52,1080,,0,0,0,,Күткеніңізге рахмет,Мочизуки-кун.
Dialogue: 0,0:52:51.52,0:52:52.53,1080,,0,0,0,,Жоқ
Dialogue: 0,0:52:52.53,0:52:55.32,1080,,0,0,0,,Ал,торт сататын дүкенге барайық.
Dialogue: 0,0:52:55.32,0:52:56.23,1080,,0,0,0,,Иә
Dialogue: 0,0:52:56.23,0:52:58.73,1080,,0,0,0,,Акарин және торт
Dialogue: 0,0:53:00.21,0:53:02.74,1080,,0,0,0,,Накчан жекпе-жегі
Dialogue: 0,0:53:07.97,0:53:10.86,1080,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:53:10.86,0:53:13.43,1080,,0,0,0,,Себебі мен көп жаттықтым.
Dialogue: 0,0:53:16.50,0:53:18.78,1080,,0,0,0,,Бұл нақты нәрсе.
Dialogue: 0,0:53:25.53,0:53:28.06,1080,,0,0,0,,Ю Күткеніңізге рахмет.
Dialogue: 0,0:53:38.79,0:53:40.65,1080,,0,0,0,,Мен өзімді жанып тұрғандай сезінемін.
Dialogue: 0,0:53:40.65,0:53:44.66,1080,,0,0,0,,Иә,өйткені бұл соңғы рет.
Dialogue: 0,0:53:44.66,0:53:45.88,1080,,0,0,0,,Соңғы?
Dialogue: 0,0:53:57.16,0:53:58.67,1080,,0,0,0,,Мәңгі...
Dialogue: 0,0:54:00.60,0:54:03.04,1080,,0,0,0,,Мен сені көптен бері жақсы көремін
Dialogue: 0,0:54:03.04,0:54:05.18,1080,,0,0,0,,Менімен бірге келіңізші
Dialogue: 0,0:54:18.96,0:54:20.42,1080,,0,0,0,,Жарайды.
Dialogue: 0,0:54:23.29,0:54:25.34,1080,,0,0,0,,Онда мен үйге бармаймын.
Dialogue: 0,0:54:26.46,0:54:30.36,1080,,0,0,0,,Бітті деп ойлаймын,соңғы мойындау репетициясы
Dialogue: 0,0:54:35.72,0:54:40.64,1080,,0,0,0,,Неліктен бұл тәжірибе емес?
Dialogue: 0,0:54:41.16,0:54:42.96,1080,,0,0,0,,Бұл нақты шоу болса да
Dialogue: 0,0:54:44.50,0:54:46.28,1080,,0,0,0,,Хабарланбаған
Dialogue: 0,0:54:51.11,0:54:55.35,1080,,0,0,0,,Нақты... қолыңнан келгеннің бәрін істе
Dialogue: 0,0:55:03.38,0:55:04.76,1080,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:55:06.12,0:55:09.30,1080,,0,0,0,,Күтіңіз,күтіңіз
Dialogue: 0,0:55:10.20,0:55:11.54,1080,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:55:17.12,0:55:18.50,1080,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:55:19.76,0:55:21.09,1080,,0,0,0,,Маған ұнайды
Dialogue: 0,0:55:21.74,0:55:24.48,1080,,0,0,0,,Барлық жаттығулар өтірік
Dialogue: 0,0:55:24.86,0:55:28.59,1080,,0,0,0,,Мен Юуды қатты жақсы көремін,мен оған көмектесе алмаймын.
Dialogue: 0,0:55:29.08,0:55:34.61,1080,,0,0,0,,Мен қызға ұқсамаймын,мен де қызғанамын.
Dialogue: 0,0:55:34.61,0:55:37.62,1080,,0,0,0,,Егер сіз көп кездесуге бармасаңыз,мен оны жек көретін едім.
Dialogue: 0,0:55:37.62,0:55:39.38,1080,,0,0,0,,Бұл өзімшілдік
Dialogue: 0,0:55:39.38,0:55:42.61,1080,,0,0,0,,Тек,бірақ...
Dialogue: 0,0:55:42.61,0:55:45.76,1080,,0,0,0,,Менімен бірге шығуыңды қалаймын.
Dialogue: 0,0:56:00.43,0:56:01.84,1080,,0,0,0,,Міне.
Dialogue: 0,0:56:04.58,0:56:06.76,1080,,0,0,0,,Менсіз бұл мүмкін емес еді
Dialogue: 0,0:56:18.74,0:56:23.34,1080,,0,0,0,,Қолымыздан келмейді ғой,иә?
Dialogue: 0,1:00:11.18,1:00:12.66,1080,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:00:13.40,1:00:15.38,1080,,0,0,0,,Мен жақсы көретін адам
Dialogue: 0,1:02:09.18,1:02:12.29,1080,,0,0,0,,Иә,ояныңыз.
Dialogue: 0,1:02:13.31,1:02:15.80,1080,,0,0,0,,Нацуки Не...
Dialogue: 0,1:02:15.80,1:02:17.54,1080,,0,0,0,,Менің сізге айтарым маңызды.
Dialogue: 0,1:02:17.54,1:02:19.59,1080,,0,0,0,,Не?
Dialogue: 0,1:02:20.55,1:02:23.05,1080,,0,0,0,,Ю маған ұнайды
Dialogue: 0,1:02:25.32,1:02:28.30,1080,,0,0,0,,Мм,қазір мұны айтқыңыз келе ме?
Dialogue: 0,1:02:28.30,1:02:30.22,1080,,0,0,0,,Енді ештеңе жоқ
Dialogue: 0,1:02:30.22,1:02:35.40,1080,,0,0,0,,Мен ешқашан Ю мені сүйеді деп айтқан емес.
Dialogue: 0,1:02:37.33,1:02:39.19,1080,,0,0,0,,Шынайы ма?
Dialogue: 0,1:02:39.19,1:02:40.62,1080,,0,0,0,,Шынайы ма?
Dialogue: 0,1:02:40.62,1:02:42.24,1080,,0,0,0,,Мен мойындаған кезде де
Dialogue: 0,1:02:42.24,1:02:44.98,1080,,0,0,0,,«Көп рахмет» болды.
Dialogue: 0,1:02:44.98,1:02:46.62,1080,,0,0,0,,Оны әр уақытта айтпа
Dialogue: 0,1:02:46.62,1:02:48.92,1080,,0,0,0,,Бұл қорқынышты. Мен ұяттан өліп жатырмын.
Dialogue: 0,1:02:48.92,1:02:53.04,1080,,0,0,0,,Эй Ю,тест тапсырушылардың екі рет ұйықтауы дұрыс па?
Dialogue: 0,1:02:53.04,1:02:56.02,1080,,0,0,0,,Жарайды,мен екі сағат бұрын ұйықтадым.
Dialogue: 0,1:02:56.02,1:02:59.58,1080,,0,0,0,,өтіңіз. Қайтадан түні бойы ұйықтау Тым көп жұмыс істеу жақсы емес
Dialogue: 0,1:02:59.58,1:03:00.76,1080,,0,0,0,,Маған ұнайды
Dialogue: 0,1:03:04.15,1:03:07.97,1080,,0,0,0,,Тосын шабуыл жоқ. Дұрыстап қайталап айтыңыз
Dialogue: 0,1:03:08.90,1:03:12.10,1080,,0,0,0,,Әзірше мүмкін емес. Бұл сіздің жүрегіңізге жаман.
Dialogue: 0,1:03:12.10,1:03:13.06,1080,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,1:03:13.06,1:03:16.85,1080,,0,0,0,,Сол қобалжуды жеңе отырып,мен өз сезімімді мойындадым.
Dialogue: 0,1:03:16.85,1:03:20.36,1080,,0,0,0,,Иә, иә,рахмет.
Dialogue: 0,1:03:23.13,1:03:27.50,1080,,0,0,0,,Мен өзімді мүлде жақсы сезінбеймін.
Dialogue: 0,1:03:29.00,1:03:35.00,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
