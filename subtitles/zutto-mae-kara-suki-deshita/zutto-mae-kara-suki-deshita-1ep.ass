Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.00,0:00:16.00,Default,,0,0,0,,Кенеттен келгенім үшін кешіріңіз.
Dialogue: 0,0:00:20.05,0:00:21.09,Default,,0,0,0,,Zu...
Dialogue: 0,0:00:25.07,0:00:27.08,Default,,0,0,0,,Мен сені көптен бері жақсы көремін
Dialogue: 0,0:00:27.08,0:00:31.03,Default,,0,0,0,,Сол күннің де ойлары
Dialogue: 0,0:00:31.03,0:00:34.00,Default,,0,0,0,,Бүгінгі күннің де ойлары
Dialogue: 0,0:00:34.00,0:00:37.05,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:00:37.05,0:00:40.02,Default,,0,0,0,,Тыныс алу
Dialogue: 0,0:00:40.02,0:00:44.03,Default,,0,0,0,,Ертең басқасын жасайық
Dialogue: 0,0:00:53.09,0:00:56.03,Default,,0,0,0,,Мен жалғыздыққа үйрендім
Dialogue: 0,0:00:56.03,0:00:58.04,Default,,0,0,0,,Жүрек сөйлегіш
Dialogue: 0,0:00:58.04,0:01:04.01,Default,,0,0,0,,«Жоқ, мен өзімді бұлай сүйе алмаймын».
Dialogue: 0,0:01:04.01,0:01:06.08,Default,,0,0,0,,Әркім өзгергісі келетін шығар.
Dialogue: 0,0:01:06.08,0:01:08.08,Default,,0,0,0,,Бірдей болу жақсы емес
Dialogue: 0,0:01:08.08,0:01:14.05,Default,,0,0,0,,Ол кенет орнынан тұрып, мәлімдеді
Dialogue: 0,0:01:14.05,0:01:18.03,Default,,0,0,0,,«Ештеңе емес, мен сені қорғаймын».
Dialogue: 0,0:01:18.03,0:01:20.07,Default,,0,0,0,,Негізсіз
Dialogue: 0,0:01:20.07,0:01:24.09,Default,,0,0,0,,Мені жастық шаққа апар
Dialogue: 0,0:01:24.09,0:01:32.06,Default,,0,0,0,,Бір күні сенің махаббатың мендікіндей болады.
Dialogue: 0,0:01:32.06,0:01:36.03,Default,,0,0,0,,Мен де кешегі күнді жек көремін
Dialogue: 0,0:01:36.03,0:01:38.09,Default,,0,0,0,,Бүгінгі мейірімділік те
Dialogue: 0,0:01:38.09,0:01:42.04,Default,,0,0,0,,Дауылдың дыбысы
Dialogue: 0,0:01:42.04,0:01:44.09,Default,,0,0,0,,Әрқашан жаңғырық
Dialogue: 0,0:01:44.09,0:01:50.01,Default,,0,0,0,,Ертеңге қайта жүгіру
Dialogue: 0,0:01:50.01,0:01:55.02,Default,,0,0,0,,Сіздің кеуде
Dialogue: 0,0:01:55.02,0:01:57.03,Default,,0,0,0,,шу шығару
Dialogue: 0,0:02:07.05,0:02:09.05,Default,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:02:10.04,0:02:12.00,Default,,0,0,0,,Қайырлы таң Накчан
Dialogue: 0,0:02:12.00,0:02:14.00,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:14.00,0:02:15.06,Default,,0,0,0,,Кешіріңіз, күттіңіз бе?
Dialogue: 0,0:02:15.06,0:02:16.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:16.05,0:02:18.04,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:02:25.04,0:02:28.00,Default,,0,0,0,,Бүгінгі бірінші кезең қандай?
Dialogue: 0,0:02:28.00,0:02:32.00,Default,,0,0,0,,Бұл ағылшын тілі. Олар викторина бар деді.
Dialogue: 0,0:02:32.00,0:02:34.05,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:35.06,0:02:36.07,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:02:37.06,0:02:38.08,Default,,0,0,0,,-да?
Dialogue: 0,0:02:38.08,0:02:40.00,Default,,0,0,0,,Сетогучи мырза
Dialogue: 0,0:02:41.07,0:02:43.04,Default,,0,0,0,,Оны айта аласыз ба?
Dialogue: 0,0:02:43.07,0:02:45.04,Default,,0,0,0,,Мойындау
Dialogue: 0,0:02:48.07,0:02:51.08,Default,,0,0,0,,Мұны тыңдаңыз.
Dialogue: 0,0:02:56.05,0:02:58.05,Default,,0,0,0,,Мен сені көптен бері жақсы көремін
Dialogue: 0,0:03:17.05,0:03:18.06,Default,,0,0,0,,Эрен тұрған жаққа
Dialogue: 0,0:03:20.00,0:03:21.00,Default,,0,0,0,,Эрен тұрған жаққа
Dialogue: 0,0:03:21.05,0:03:22.05,Default,,0,0,0,,Не?
Dialogue: 0,0:03:22.05,0:03:23.07,Default,,0,0,0,,Эрен тұрған жаққа
Dialogue: 0,0:03:24.09,0:03:26.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:26.09,0:03:28.08,Default,,0,0,0,,Түсіндірме жоқ.
Dialogue: 0,0:03:28.08,0:03:30.04,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:03:31.08,0:03:34.06,Default,,0,0,0,,Нацуки, сен
Dialogue: 0,0:03:39.04,0:03:40.08,Default,,0,0,0,,Мойындау...
Dialogue: 0,0:03:42.01,0:03:44.02,Default,,0,0,0,,...Құрғақ жаттығу..
Dialogue: 0,0:03:45.02,0:03:46.04,Default,,0,0,0,,...
Dialogue: 0,0:03:48.09,0:03:51.02,Default,,0,0,0,,Иә, жаттығу?
Dialogue: 0,0:03:52.00,0:03:55.06,Default,,0,0,0,,Ей, эй, сүйкімді, мен қатты толқыдым
Dialogue: 0,0:03:59.00,0:04:01.06,Default,,0,0,0,,Маған олай қарама.
Dialogue: 0,0:04:02.04,0:04:04.03,Default,,0,0,0,,Гоментеба
Dialogue: 0,0:04:08.09,0:04:12.00,Default,,0,0,0,,Мен байыпты болып бара жатырмын
Dialogue: 0,0:04:19.05,0:04:20.09,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:04:23.01,0:04:24.05,Default,,0,0,0,,Қарсы алу
Dialogue: 0,0:04:29.08,0:04:31.00,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:04:31.08,0:04:33.08,Default,,0,0,0,,Нақты орындауды кім орындайды?
Dialogue: 0,0:04:40.00,0:04:43.02,Default,,0,0,0,,Бұлай айту мүмкін емес.
Dialogue: 0,0:04:43.02,0:04:46.02,Default,,0,0,0,,Әй, эй, далаға шығып жаттығу жасайық.
Dialogue: 0,0:04:46.02,0:04:48.01,Default,,0,0,0,,Мен көмектесе алмаймын.
Dialogue: 0,0:04:50.06,0:04:52.05,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:04:53.01,0:04:55.05,Default,,0,0,0,,Дегенмен, рамен сатып алмаңыз.
Dialogue: 0,0:04:57.08,0:05:02.03,Default,,0,0,0,,Сонымен, үйге бара жатып, вокзал алдына рамен жеуге бардым.
Dialogue: 0,0:05:03.01,0:05:07.02,Default,,0,0,0,,Бұл дәмді болды, бірақ бұл менің сән-салтанатым болды.
Dialogue: 0,0:05:08.00,0:05:10.00,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:05:11.06,0:05:13.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:13.04,0:05:17.03,Default,,0,0,0,,Иә, аяғыңды жаб, сен қызсың.
Dialogue: 0,0:05:17.03,0:05:21.02,Default,,0,0,0,,Көрдім, олар шабуыл жасады, бірақ олар шегінді.
Dialogue: 0,0:05:21.02,0:05:22.08,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:05:22.08,0:05:26.08,Default,,0,0,0,,Бұл уақытша эвакуация, бұл стратегия.
Dialogue: 0,0:05:26.08,0:05:29.01,Default,,0,0,0,,Ойланып көріңізші, Мио мен Харуки ше?
Dialogue: 0,0:05:29.01,0:05:31.04,Default,,0,0,0,,мен...
Dialogue: 0,0:05:31.08,0:05:34.06,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:05:34.06,0:05:36.02,Default,,0,0,0,,What is normal?
Dialogue: 0,0:05:36.02,0:05:38.06,Default,,0,0,0,,Normal is normal
Dialogue: 0,0:05:38.06,0:05:40.00,Default,,0,0,0,,Akari-chan is
Dialogue: 0,0:05:41.01,0:05:43.00,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:43.00,0:05:44.02,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:05:44.02,0:05:46.07,Default,,0,0,0,,Мен Накчанның мойындау стратегиясы туралы ойлануым керек.
Dialogue: 0,0:05:46.07,0:05:49.05,Default,,0,0,0,,Уақытша эвакуациядан кейін не істеу керек
Dialogue: 0,0:05:51.05,0:05:54.04,Default,,0,0,0,,Thank you Akari
Dialogue: 0,0:05:54.04,0:05:57.02,Default,,0,0,0,,Жарайды, мен бар күшімді саламын.
Dialogue: 0,0:06:10.00,0:06:11.03,Default,,0,0,0,,Sleepy
Dialogue: 0,0:06:11.07,0:06:12.09,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:15.01,0:06:16.06,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:23.06,0:06:25.02,Default,,0,0,0,,Қайырлы таң Акари
Dialogue: 0,0:06:25.04,0:06:26.08,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:31.02,0:06:33.04,Default,,0,0,0,,Good morning Akarin
Dialogue: 0,0:06:34.04,0:06:36.08,Default,,0,0,0,,Today is also a real angel
Dialogue: 0,0:06:36.08,0:06:39.06,Default,,0,0,0,,Say it out loud
Dialogue: 0,0:06:39.06,0:06:42.06,Default,,0,0,0,,“Akarin, good morning.”
Dialogue: 0,0:06:43.00,0:06:45.00,Default,,0,0,0,,Хмм, бұл мүмкін емес.
Dialogue: 0,0:06:45.00,0:06:47.06,Default,,0,0,0,,Менің ойымша, сіз екі жыл бойы жауапсыз махаббатта болдыңыз.
Dialogue: 0,0:06:47.06,0:06:49.04,Default,,0,0,0,,Confess!
Dialogue: 0,0:06:49.04,0:06:51.01,Default,,0,0,0,,Мүмкін емес Мүмкін емес Мүмкін емес
Dialogue: 0,0:06:51.01,0:06:55.01,Default,,0,0,0,,Өйткені біз бұл туралы ешқашан сөйлескен емеспіз, сондықтан неге мойындамайсыз?
Dialogue: 0,0:07:00.06,0:07:02.04,Default,,0,0,0,,Too lazy
Dialogue: 0,0:07:04.00,0:07:06.03,Default,,0,0,0,,Нене, бұл кім?
Dialogue: 0,0:07:06.03,0:07:08.02,Default,,0,0,0,,Ондай адам болды ма?
Dialogue: 0,0:07:08.02,0:07:10.06,Default,,0,0,0,,Hey, hey, it's not very cool.
Dialogue: 0,0:07:15.02,0:07:17.00,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:07:17.08,0:07:19.02,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:20.06,0:07:23.04,Default,,0,0,0,,Ah, maybe that's it?
Dialogue: 0,0:07:24.04,0:07:26.02,Default,,0,0,0,,Ayase?
Dialogue: 0,0:07:28.03,0:07:30.00,Default,,0,0,0,,Ayase...
Dialogue: 0,0:07:30.05,0:07:34.06,Default,,0,0,0,,Оның шашы қызға ұқсап, мынандай болды.
Dialogue: 0,0:07:38.02,0:07:40.04,Default,,0,0,0,,That's Ayase-kun.
Dialogue: 0,0:07:41.09,0:07:44.02,Default,,0,0,0,,Сіз шашыңызды қидыңыз, солай ма?
Dialogue: 0,0:07:46.09,0:07:48.06,Default,,0,0,0,,Akarin
Dialogue: 0,0:07:47.01,0:07:48.04,Default,,0,0,0,,It suits you really well
Dialogue: 0,0:07:48.04,0:07:50.02,Default,,0,0,0,,Does it suit you?
Dialogue: 0,0:07:54.00,0:07:55.06,Default,,0,0,0,,You cut your hair, right?
Dialogue: 0,0:07:55.06,0:07:56.08,Default,,0,0,0,,Иә
Dialogue: 0,0:07:56.08,0:07:59.01,Default,,0,0,0,,Сонымен, сіз дәл қазір не туралы айттыңыз?
Dialogue: 0,0:07:59.08,0:08:01.07,Default,,0,0,0,,Are you with Mr. Hayasaka?
Dialogue: 0,0:08:02.06,0:08:07.02,Default,,0,0,0,,«Сіз және Мочизуки шаштарыңызды алдыңыздар, солай ма?»
Dialogue: 0,0:08:09.04,0:08:12.09,Default,,0,0,0,,Аясе: Атмосфера айтарлықтай өзгерді.
Dialogue: 0,0:08:12.09,0:08:15.00,Default,,0,0,0,,suddenly why
Dialogue: 0,0:08:24.09,0:08:26.09,Default,,0,0,0,,Мен өткен күні жалға алған DVD-ді көрдім.
Dialogue: 0,0:08:26.09,0:08:28.03,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:08:27.01,0:08:29.02,Default,,0,0,0,,Do you like that?
Dialogue: 0,0:08:29.02,0:08:30.07,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:30.07,0:08:32.02,Default,,0,0,0,,Бұл күтпеген еді, бірақ өте қызықты болды.
Dialogue: 0,0:08:32.07,0:08:33.07,Default,,0,0,0,,You can continue borrowing.
Dialogue: 0,0:08:33.02,0:08:34.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:34.08,0:08:37.07,Default,,0,0,0,,Ayase also has someone she likes.
Dialogue: 0,0:08:40.09,0:08:44.00,Default,,0,0,0,,Мен сияқты
Dialogue: 0,0:08:44.02,0:08:46.04,Default,,0,0,0,,Мочита
Dialogue: 0,0:08:47.00,0:08:49.01,Default,,0,0,0,,Харуки Не...
Dialogue: 0,0:08:49.01,0:08:51.02,Default,,0,0,0,,Маған керемет идея келді.
Dialogue: 0,0:08:51.02,0:08:52.07,Default,,0,0,0,,Сценарийді түзете аламын ба?
Dialogue: 0,0:08:52.07,0:08:54.02,Default,,0,0,0,,Мен оны түзетемін.
Dialogue: 0,0:08:54.02,0:08:57.07,Default,,0,0,0,,бөліміне өтіңіз. Оны қазір түзету қиын емес.
Dialogue: 0,0:08:57.07,0:09:01.00,Default,,0,0,0,,Егер кестеден қорқатын болсаңыз, фильм түсіре аласыз ба?
Dialogue: 0,0:09:01.00,0:09:04.00,Default,,0,0,0,,Hey Yu, the film club is urgently summoned.
Dialogue: 0,0:09:04.00,0:09:05.00,Default,,0,0,0,,Не?
Dialogue: 0,0:09:05.00,0:09:06.02,Default,,0,0,0,,Не
Dialogue: 0,0:09:06.02,0:09:07.09,Default,,0,0,0,,Мен сценарийді қайта қараймын.
Dialogue: 0,0:09:07.09,0:09:09.03,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:09:08.05,0:09:10.05,Default,,0,0,0,,Hey, come quickly.
Dialogue: 0,0:09:19.08,0:09:22.01,Default,,0,0,0,,Олардың мен адамзаттың күш арасындағы алшақтық аса үлкен еді,
Dialogue: 0,0:09:23.05,0:09:26.07,Default,,0,0,0,,Eat Bullet Shoot
Dialogue: 0,0:09:26.07,0:09:28.01,Default,,0,0,0,,Мен сізге рұқсат бермеймін
Dialogue: 0,0:09:28.03,0:09:29.04,Default,,0,0,0,,Ю
Dialogue: 0,0:09:35.06,0:09:37.01,Default,,0,0,0,,Ято өледі
Dialogue: 0,0:09:37.01,0:09:38.09,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:09:42.08,0:09:46.01,Default,,0,0,0,,Yukki, you're working hard. To
Dialogue: 0,0:09:46.01,0:09:49.07,Default,,0,0,0,,Is Akari a bad prince type?
Dialogue: 0,0:09:51.05,0:09:53.09,Default,,0,0,0,,Не, не?
Dialogue: 0,0:09:53.09,0:09:56.06,Default,,0,0,0,,Сүйікті жарық түрі?
Dialogue: 0,0:09:56.06,0:09:59.08,Default,,0,0,0,,Like I want to hear Like I don't want to hear
Dialogue: 0,0:09:59.08,0:10:01.07,Default,,0,0,0,,Бірақ мен оны әлі де естігім келеді.
Dialogue: 0,0:10:01.07,0:10:06.00,Default,,0,0,0,,Does that mean the person you fall in love with is your type?
Dialogue: 0,0:10:06.00,0:10:08.09,Default,,0,0,0,,Қызық, солай ма?
Dialogue: 0,0:10:12.04,0:10:15.00,Default,,0,0,0,,The person you fall in love with is your type.
Dialogue: 0,0:10:15.00,0:10:18.05,Default,,0,0,0,,Isn't this the most difficult?
Dialogue: 0,0:10:19.07,0:10:23.00,Default,,0,0,0,,I wonder if there is someone I like
Dialogue: 0,0:10:23.00,0:10:26.01,Default,,0,0,0,,It's fine if the person Akarin likes has someone she likes.
Dialogue: 0,0:10:28.06,0:10:31.05,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:10:31.05,0:10:33.05,Default,,0,0,0,,Сіз не тілейсіз?
Dialogue: 0,0:10:35.07,0:10:38.01,Default,,0,0,0,,It's the worst wish
Dialogue: 0,0:10:38.06,0:10:40.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:10:43.01,0:10:48.02,Default,,0,0,0,,Акариннің махаббатын қолдай алмаймын.
Dialogue: 0,0:10:48.02,0:10:49.09,Default,,0,0,0,,Мочита
Dialogue: 0,0:10:54.08,0:10:56.05,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:10:56.08,0:10:58.03,Default,,0,0,0,,My nose is bleeding
Dialogue: 0,0:10:58.03,0:11:00.08,Default,,0,0,0,,This is going to the infirmary.
Dialogue: 0,0:11:01.08,0:11:04.06,Default,,0,0,0,,Falling in love with the girl you like and eating the ball?
Dialogue: 0,0:11:04.06,0:11:06.05,Default,,0,0,0,,Тым ақсақ
Dialogue: 0,0:11:06.05,0:11:09.05,Default,,0,0,0,,Hey, don't cry just because of the face block.
Dialogue: 0,0:11:09.05,0:11:11.01,Default,,0,0,0,,Мен жыламаймын
Dialogue: 0,0:11:11.01,0:11:14.04,Default,,0,0,0,,Дұрыс, жақсы қойылым болды. Жылама.
Dialogue: 0,0:11:14.04,0:11:16.07,Default,,0,0,0,,Сондықтан мен жыламаймын
Dialogue: 0,0:11:19.00,0:11:21.03,Default,,0,0,0,,Пайдасыз
Dialogue: 0,0:11:21.03,0:11:23.08,Default,,0,0,0,,Мочизуки-кун, не болды?
Dialogue: 0,0:11:23.08,0:11:27.09,Default,,0,0,0,,Бұл қызық емес сияқты.
Dialogue: 0,0:11:38.02,0:11:43.02,Default,,0,0,0,,О, бұл Эномото-сан.
Dialogue: 0,0:11:46.01,0:11:47.07,Default,,0,0,0,,Коюки-кун
Dialogue: 0,0:11:47.07,0:11:49.09,Default,,0,0,0,,Бұл сізге керемет көрінеді
Dialogue: 0,0:11:50.07,0:11:52.04,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:11:53.04,0:11:57.01,Default,,0,0,0,,Бұл көзілдірікті шешіп алсаңыз, қалай жақсы көрінетініңіз туралы манга сияқты.
Dialogue: 0,0:11:57.09,0:12:01.04,Default,,0,0,0,,Айтпақшы, мен жаңа PV көрдім
Dialogue: 0,0:12:01.04,0:12:04.05,Default,,0,0,0,,Қараңдаршы, бұл өте жақсы болды, солай емес пе?
Dialogue: 0,0:12:04.05,0:12:07.02,Default,,0,0,0,,Бірақ ән мәтіні әлі де керемет.
Dialogue: 0,0:12:07.02,0:12:08.03,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:08.03,0:12:11.02,Default,,0,0,0,,Мен алдағы CD-ге алдын ала тапсырыс бердім.
Dialogue: 0,0:12:11.02,0:12:13.07,Default,,0,0,0,,Қарыз беру және беру
Dialogue: 0,0:12:13.07,0:12:15.05,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:12:15.05,0:12:17.04,Default,,0,0,0,,Жасағаныңыз үшін рахмет
Dialogue: 0,0:12:16.05,0:12:18.06,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:12:17.08,0:12:20.03,Default,,0,0,0,,Мен естігенім осы болды.
Dialogue: 0,0:12:20.03,0:12:22.08,Default,,0,0,0,,А, бұл сахнаның өзгеруі шығар.
Dialogue: 0,0:12:22.08,0:12:26.07,Default,,0,0,0,,Менің ойымша, кесте бойынша бұл жақсы.
Dialogue: 0,0:12:27.06,0:12:30.01,Default,,0,0,0,,Харуки, қош келдіңіз.
Dialogue: 0,0:12:30.01,0:12:33.09,Default,,0,0,0,,О, кеттік.
Dialogue: 0,0:12:34.03,0:12:36.00,Default,,0,0,0,,Қош бол
Dialogue: 0,0:12:38.07,0:12:42.01,Default,,0,0,0,,Қызық, ол жігіттер кездесіп жүр ме?
Dialogue: 0,0:12:42.01,0:12:44.03,Default,,0,0,0,,Шиннай
Dialogue: 0,0:12:44.06,0:12:46.08,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:46.08,0:12:48.05,Default,,0,0,0,,Ю
Dialogue: 0,0:12:48.05,0:12:51.06,Default,,0,0,0,,Жалғыз махаббат ұзаққа созылады
Dialogue: 0,0:12:51.06,0:12:55.00,Default,,0,0,0,,Бұл жауапсыз махаббат.
Dialogue: 0,0:12:58.01,0:12:59.06,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:59.06,0:13:01.09,Default,,0,0,0,,Мен түсіндім, сондықтан сен де сөйлемейсің.
Dialogue: 0,0:13:01.09,0:13:04.02,Default,,0,0,0,,Рамен жейміз.
Dialogue: 0,0:13:06.02,0:13:10.08,Default,,0,0,0,,Ол кездегі бейнелер мен музыка керемет.
Dialogue: 0,0:13:10.08,0:13:13.09,Default,,0,0,0,,бөліміне өтіңіз. Қызықты көрінеді.
Dialogue: 0,0:13:13.09,0:13:16.01,Default,,0,0,0,,Келесі жолы DVD алып келемін.
Dialogue: 0,0:13:16.01,0:13:18.08,Default,,0,0,0,,Менің ойымша, сен Миоға міндетті түрде ұнайсың.
Dialogue: 0,0:13:18.08,0:13:21.07,Default,,0,0,0,,Оны асыға күтемін
Dialogue: 0,0:13:25.00,0:13:26.06,Default,,0,0,0,,Иә
Dialogue: 0,0:13:30.03,0:13:31.06,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:13:53.02,0:13:54.07,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:13:57.04,0:13:59.02,Default,,0,0,0,,Жоқ, жоқ, Хина Чан
Dialogue: 0,0:13:59.02,0:14:02.00,Default,,0,0,0,,Эй Накчан, сен не істеп жатырсың?
Dialogue: 0,0:14:02.00,0:14:03.02,Default,,0,0,0,,Өйткені, сол жерде...
Dialogue: 0,0:14:03.02,0:14:05.01,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:14:06.05,0:14:09.04,Default,,0,0,0,,Сен біреудің бөлмесінде не істеп жүрсің?
Dialogue: 0,0:14:09.04,0:14:11.06,Default,,0,0,0,,Үлкен аға, үйге қош келдіңіз
Dialogue: 0,0:14:11.06,0:14:13.00,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:14:13.00,0:14:15.07,Default,,0,0,0,,Кеш болды. Сен қайда болдың?
Dialogue: 0,0:14:15.07,0:14:17.04,Default,,0,0,0,,Кез келген жерде жақсы болар еді.
Dialogue: 0,0:14:25.02,0:14:29.04,Default,,0,0,0,,Мойындау Бұл репетиция.
Dialogue: 0,0:14:33.09,0:14:37.01,Default,,0,0,0,,Осы сағатта жігіттің бөлмесінде болған дұрыс па?
Dialogue: 0,0:14:37.01,0:14:40.09,Default,,0,0,0,,Ю неге ерекше?
Dialogue: 0,0:14:44.01,0:14:46.06,Default,,0,0,0,,Сонымен бүгін не үшін келдің?
Dialogue: 0,0:14:46.06,0:14:49.09,Default,,0,0,0,,Мен сенен мені оқытып, үйретуіңді өтінгім келді.
Dialogue: 0,0:14:49.09,0:14:51.02,Default,,0,0,0,,Бұл ойын емес
Dialogue: 0,0:14:51.02,0:14:52.04,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:15:19.06,0:15:21.08,Default,,0,0,0,,Эй, бұл
Dialogue: 0,0:15:21.08,0:15:23.02,Default,,0,0,0,,бірақ енді Эсидиси жеңілгендіктен—
Dialogue: 0,0:15:30.07,0:15:32.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:33.02,0:15:35.03,Default,,0,0,0,,Осы формуланы қолдан
Dialogue: 0,0:15:35.03,0:15:38.01,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:15:58.00,0:15:59.01,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:15:59.05,0:16:00.08,Default,,0,0,0,,Келесі жолы қайсысы?
Dialogue: 0,0:16:02.05,0:16:03.07,Default,,0,0,0,,Егер
Dialogue: 0,0:16:05.02,0:16:07.04,Default,,0,0,0,,Менің жігітім болса
Dialogue: 0,0:16:08.00,0:16:09.02,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:16:14.00,0:16:15.03,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:16:16.07,0:16:17.09,Default,,0,0,0,,Ал...
Dialogue: 0,0:16:18.04,0:16:22.06,Default,,0,0,0,,Тәжірибе серіктесі ретінде мен сізді қолдаудан басқа амалым жоқ.
Dialogue: 0,0:16:24.09,0:16:26.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:32.08,0:16:34.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:39.06,0:16:40.09,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:16:56.08,0:17:00.02,Default,,0,0,0,,Мойындау Сіз мұны кіммен жасайсыз?
Dialogue: 0,0:17:05.07,0:17:09.05,Default,,0,0,0,,Сіз кездесесіз бе, жоқ па?
Dialogue: 0,0:17:10.07,0:17:12.07,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:17:22.08,0:17:25.05,Default,,0,0,0,,Менің батылдығым аз.
Dialogue: 0,0:17:29.05,0:17:32.03,Default,,0,0,0,,Барлығы ғашық
Dialogue: 0,0:17:34.07,0:17:37.07,Default,,0,0,0,,Мен де солай істеймін бе деп ойлаймын.
Dialogue: 0,0:17:41.08,0:17:43.08,Default,,0,0,0,,Сіздің сүйікті адамыңыз кім?
Dialogue: 0,0:17:43.08,0:17:48.00,Default,,0,0,0,,Сізге ұнайтын адам кім? Сізге ұнайтын адам кім?
Dialogue: 0,0:17:57.03,0:18:01.05,Default,,0,0,0,,Өйткені Ю мейірімді, өйткені ол ақкөңіл.
Dialogue: 0,0:18:02.03,0:18:04.09,Default,,0,0,0,,Сен мені әрқашан мен сені қалай көремін, солай көресің.
Dialogue: 0,0:18:05.05,0:18:07.08,Default,,0,0,0,,Мені қолдаңыз
Dialogue: 0,0:18:08.08,0:18:10.03,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:18:19.06,0:18:22.02,Default,,0,0,0,,Кімге ғашық болсам да
Dialogue: 0,0:18:22.02,0:18:24.09,Default,,0,0,0,,Юу сені қолдайды
Dialogue: 0,0:19:00.02,0:19:04.00,Default,,0,0,0,,Акаринді ойлап ұйықтай алмадым.
Dialogue: 0,0:19:08.06,0:19:11.01,Default,,0,0,0,,Акарин
Dialogue: 0,0:19:13.07,0:19:14.08,Default,,0,0,0,,О...
Dialogue: 0,0:19:15.08,0:19:17.01,Default,,0,0,0,,О?
Dialogue: 0,0:19:18.05,0:19:21.01,Default,,0,0,0,,Қайырлы таң, мен төсекте жатырмын.
Dialogue: 0,0:19:23.00,0:19:28.01,Default,,0,0,0,,Мен осында секіремін...
Dialogue: 0,0:19:34.04,0:19:35.07,Default,,0,0,0,,Құпия
Dialogue: 0,0:19:39.06,0:19:43.08,Default,,0,0,0,,Айла Бұл қандай сүйкімді мақұлық?
Dialogue: 0,0:19:46.01,0:19:50.04,Default,,0,0,0,,Бұл жарық, Акарин.
Dialogue: 0,0:19:54.01,0:19:57.08,Default,,0,0,0,,Акаринтомен бірінші рет сөйлесу
Dialogue: 0,0:20:00.09,0:20:02.05,Default,,0,0,0,,Акаринто...
Dialogue: 0,0:20:04.05,0:20:07.03,Default,,0,0,0,,Түсіндегі табиғи дене
Dialogue: 0,0:20:07.03,0:20:11.03,Default,,0,0,0,,Сәлемдесудің өзі өткен күн.
Dialogue: 0,0:20:11.03,0:20:14.01,Default,,0,0,0,,Гикочинай шындықтағы
Dialogue: 0,0:20:14.01,0:20:17.05,Default,,0,0,0,,Екі адамның махаббаты туралы әңгіме
Dialogue: 0,0:20:17.07,0:20:19.02,Default,,0,0,0,,Ұнады
Dialogue: 0,0:20:32.01,0:20:35.05,Default,,0,0,0,,«Көршіңіздің жағдайы жақсы ма?» Маған ұнайды. Бұны ұнатамын.
Dialogue: 0,0:20:34.07,0:20:37.09,Default,,0,0,0,,Қайрат берген таңғы пойыз
Dialogue: 0,0:20:35.05,0:20:38.01,Default,,0,0,0,,Йойо Хейо Қарап көріңіз
Dialogue: 0,0:20:38.01,0:20:41.05,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша... «Өтінемін!» деп жауап беріңіз.
Dialogue: 0,0:20:41.05,0:20:45.04,Default,,0,0,0,,Содан бері үнсіздік
Dialogue: 0,0:20:45.06,0:20:48.04,Default,,0,0,0,,Мен бірдеңе айтуым керек
Dialogue: 0,0:20:48.04,0:20:52.02,Default,,0,0,0,,Асықпасаң, діттеген жеріңе жетесің
Dialogue: 0,0:20:52.04,0:20:55.02,Default,,0,0,0,,Мен ер адам болуым керек
Dialogue: 0,0:20:55.02,0:20:58.04,Default,,0,0,0,,«...Ұялы телефоныңды тыңдай аламын ба?»
Dialogue: 0,0:20:58.04,0:21:02.08,Default,,0,0,0,,Кенеттен айтылған сөзге күлдім.
Dialogue: 0,0:21:01.08,0:21:05.06,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:21:02.08,0:21:05.09,Default,,0,0,0,,«...Мен де солай ойладым».
Dialogue: 0,0:21:06.03,0:21:09.06,Default,,0,0,0,,Бақытты бол
Dialogue: 0,0:21:09.06,0:21:13.01,Default,,0,0,0,,Бүгін тағы да «Рахмет».
Dialogue: 0,0:21:13.01,0:21:17.01,Default,,0,0,0,,Мен сіз туралы көбірек білгім келеді және біз доспыз.
Dialogue: 0,0:21:17.01,0:21:19.09,Default,,0,0,0,,Сізге телефон соғуға болады ма?
Dialogue: 0,0:21:19.09,0:21:26.01,Default,,0,0,0,,Мен уайымдап жүргенде, мен уақытты өткізіп алдым, ах...
Dialogue: 0,0:21:23.03,0:21:25.07,Default,,0,0,0,,Қайғылы кезіңде маған кел.
Dialogue: 0,0:21:25.07,0:21:28.00,Default,,0,0,0,,Көңіл көтергенде бірге күлейік
Dialogue: 0,0:21:26.07,0:21:30.07,Default,,0,0,0,,Сүйікті кәмпит және сүйікті түсі
Dialogue: 0,0:21:28.00,0:21:31.00,Default,,0,0,0,,Ерітетін дәмді «Honeywa-do» пудингі
Dialogue: 0,0:21:30.09,0:21:33.07,Default,,0,0,0,,Маған да хабарлаңыз... түрін де.
Dialogue: 0,0:21:31.04,0:21:36.01,Default,,0,0,0,,Қане, көже жеп, көңіл көтерейік.
Dialogue: 0,0:21:33.07,0:21:37.05,Default,,0,0,0,,Мен идеалды адамға жақындағым келеді
Dialogue: 0,0:21:37.05,0:21:40.03,Default,,0,0,0,,Бұл теңгерімсіз махаббат
Dialogue: 0,0:21:40.05,0:21:42.02,Default,,0,0,0,,«Не болады?»
Dialogue: 0,0:21:46.06,0:21:49.02,Default,,0,0,0,,Накчан, содан бері істеп жүрсің бе?
Dialogue: 0,0:21:49.02,0:21:51.02,Default,,0,0,0,,Мойындау репетициясы
Dialogue: 0,0:21:51.02,0:21:52.06,Default,,0,0,0,,Мен мұны істеп жатырмын
Dialogue: 0,0:21:54.03,0:21:58.04,Default,,0,0,0,,Мені жаңа ғана қабылдамады.
Dialogue: 0,0:21:58.04,0:22:00.09,Default,,0,0,0,,Сіз мойындауға жоқ дейсіз бе?
Dialogue: 0,0:22:01.03,0:22:04.05,Default,,0,0,0,,Қызық, мойындау тәжірибелік нәрсе ме?
Dialogue: 0,0:22:04.05,0:22:06.03,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:22:06.03,0:22:10.09,Default,,0,0,0,,Мен білмеймін, бірақ мен бұл туралы көп естіген жоқпын.
Dialogue: 0,0:22:10.09,0:22:14.03,Default,,0,0,0,,Бірақ мойындау мені қатты қобалжытады.
Dialogue: 0,0:22:14.03,0:22:16.03,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:22:16.03,0:22:19.03,Default,,0,0,0,,Ойымды айту маған қиын
Dialogue: 0,0:22:19.03,0:22:21.04,Default,,0,0,0,,Тіпті бала кездегі достар?
Dialogue: 0,0:22:21.04,0:22:23.09,Default,,0,0,0,,Өйткені біз бала кезден доспыз.
Dialogue: 0,0:22:23.09,0:22:25.07,Default,,0,0,0,,Маған қашаннан бері ғашық болдың?
Dialogue: 0,0:22:29.02,0:22:30.08,Default,,0,0,0,,Қай уақыттан бастап?
Dialogue: 0,0:22:38.06,0:22:42.00,Default,,0,0,0,,Кез келген жағдайда бірнеше рет жасамайынша бұл мүмкін емес.
Dialogue: 0,0:22:42.08,0:22:47.08,Default,,0,0,0,,Жігіт пен қыз болу қиын, солай емес пе?
Dialogue: 0,0:22:50.01,0:22:52.07,Default,,0,0,0,,Эй, Акариді ұнататын ешкім жоқ.
Dialogue: 0,0:22:54.06,0:22:57.03,Default,,0,0,0,,Мен ұлдармен мүлдем сөйлеспеймін.
Dialogue: 0,0:22:57.07,0:23:01.03,Default,,0,0,0,,Мен Мочизукимен өткен күні бірінші рет сөйлестім.
Dialogue: 0,0:23:01.03,0:23:03.00,Default,,0,0,0,,мочито нанте
Dialogue: 0,0:23:03.00,0:23:04.09,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:23:04.09,0:23:06.06,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:23:06.06,0:23:08.08,Default,,0,0,0,,Осыдан кейін «Менің ұйықтайтын әдетім бар».
Dialogue: 0,0:23:08.08,0:23:11.05,Default,,0,0,0,,Жоқ, бұл әңгіме емес.
Dialogue: 0,0:23:11.05,0:23:13.07,Default,,0,0,0,,Бірақ бұл Акари-чанға ұқсайды.
Dialogue: 0,0:23:18.00,0:23:22.03,Default,,0,0,0,,Менің махаббат оқулығым немесе анықтамалығым болғанын қалаймын.
Dialogue: 0,0:23:27.09,0:23:30.03,Default,,0,0,0,,О, бұл Эномото-сан.
Dialogue: 0,0:23:31.00,0:23:32.09,Default,,0,0,0,,Міне, не болғаны
Dialogue: 0,0:23:32.09,0:23:35.03,Default,,0,0,0,,Не, Койюки-кун?
Dialogue: 0,0:23:35.03,0:23:39.04,Default,,0,0,0,,Мм...келесі жолы Honey Works концерті болады.
Dialogue: 0,0:23:39.04,0:23:41.03,Default,,0,0,0,,А, мен білемін.
Dialogue: 0,0:23:41.03,0:23:44.05,Default,,0,0,0,,Сіз бұл билеттерді мүлде ала алмайсыз.
Dialogue: 0,0:23:44.05,0:23:45.09,Default,,0,0,0,,Билет
Dialogue: 0,0:23:47.05,0:23:49.04,Default,,0,0,0,,Мен түсіндім, бірақ
Dialogue: 0,0:23:49.04,0:23:52.00,Default,,0,0,0,,Өтірік айту
Dialogue: 0,0:23:52.00,0:23:55.05,Default,,0,0,0,,Рас, Коюки-кун, ғажап, ғажап, ғажап
Dialogue: 0,0:23:55.05,0:23:58.05,Default,,0,0,0,,Қарсы болмасаң, менімен барғың келе ме?
Dialogue: 0,0:23:58.05,0:24:02.01,Default,,0,0,0,,Жарайды, жүр, бар, міндетті түрде бар.
Dialogue: 0,0:24:04.00,0:24:05.08,Default,,0,0,0,,Содан кейін өмір сүр
Dialogue: 0,0:24:05.08,0:24:10.02,Default,,0,0,0,,Рахмет, Коюки-кун, көп рахмет.
Dialogue: 0,0:24:15.01,0:24:18.01,Default,,0,0,0,,Накчан, мен тікелей шоуға барамын.
Dialogue: 0,0:24:18.01,0:24:19.04,Default,,0,0,0,,Әрине
Dialogue: 0,0:24:19.04,0:24:21.02,Default,,0,0,0,,Коюки-кунмен?
Dialogue: 0,0:24:21.02,0:24:24.04,Default,,0,0,0,,Иә, өйткені бұл Honeywah-тың тікелей шоуы.
Dialogue: 0,0:24:24.04,0:24:27.01,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:24:27.01,0:24:29.01,Default,,0,0,0,,Ұл баламен бірге тұру
Dialogue: 0,0:24:29.01,0:24:30.06,Default,,0,0,0,,Күн емес
Dialogue: 0,0:24:30.06,0:24:32.07,Default,,0,0,0,,Соған ұқсайды.
Dialogue: 0,0:24:34.01,0:24:37.00,Default,,0,0,0,,Сетогучи-кун осында болса да жақсы ма?
Dialogue: 0,0:24:38.02,0:24:41.01,Default,,0,0,0,,Эй, Накчан, бәрі жақсы.
Dialogue: 0,0:24:41.06,0:24:44.02,Default,,0,0,0,,Менде дәл қазір ақша тапшы болды.
Dialogue: 0,0:24:44.02,0:24:47.02,Default,,0,0,0,,Бірақ мен нақты шектеулі тауарларды алғым келеді.
Dialogue: 0,0:24:47.02,0:24:49.02,Default,,0,0,0,,Қалтаңыздың ақшасын алдын ала қарызға алмасаңыз
Dialogue: 0,0:24:49.02,0:24:51.04,Default,,0,0,0,,Менде қанша болуы керек?
Dialogue: 0,0:24:51.04,0:24:53.06,Default,,0,0,0,,Мен жай ғана Коюки-куннан сұраймын.
Dialogue: 0,0:24:53.06,0:24:55.03,Default,,0,0,0,,Коюки-кун, күте тұр.
Dialogue: 0,0:24:55.03,0:24:56.05,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,0:24:56.05,0:24:57.09,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:25:08.08,0:25:12.05,Default,,0,0,0,,Эй Нацуки, сен неге бүгін көрші үйге бармайсың?
Dialogue: 0,0:25:12.05,0:25:13.06,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:25:13.06,0:25:17.03,Default,,0,0,0,,Неге, сен әрқашан сонда емессің бе?
Dialogue: 0,0:25:17.03,0:25:19.08,Default,,0,0,0,,Бүгін мен ертеңгі күнге дайындаламын.
Dialogue: 0,0:25:20.03,0:25:22.04,Default,,0,0,0,,Егер сізде бір іс болса, өзіңіз жүріңіз.
Dialogue: 0,0:25:22.04,0:25:25.03,Default,,0,0,0,,Менің оны пайдалануым жоқ.
Dialogue: 0,0:25:25.03,0:25:27.09,Default,,0,0,0,,Ойлап қарасам, Хина-Чан өткен күні осылай деді.
Dialogue: 0,0:25:27.09,0:25:30.03,Default,,0,0,0,,Мен Котаромен ойын ойнағым келеді.
Dialogue: 0,0:25:30.03,0:25:32.05,Default,,0,0,0,,шынымен
Dialogue: 0,0:25:32.05,0:25:33.06,Default,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:25:34.07,0:25:37.04,Default,,0,0,0,,Ондай бейқам сөз айтпа, шіркін.
Dialogue: 0,0:25:37.04,0:25:40.02,Default,,0,0,0,,Әпкеңе жамандық жасау деген не?
Dialogue: 0,0:25:40.02,0:25:42.02,Default,,0,0,0,,Ұсқынсыз x4
Dialogue: 0,0:25:44.07,0:25:47.01,Default,,0,0,0,,Тағы бір жекпе-жек
Dialogue: 0,0:25:47.01,0:25:49.09,Default,,0,0,0,,Котаро Біз мектепте жиі ұрысамыз.
Dialogue: 0,0:25:49.09,0:25:51.07,Default,,0,0,0,,Шынында да бала
Dialogue: 0,0:25:51.07,0:25:53.02,Default,,0,0,0,,Сіз айтасыз ба?
Dialogue: 0,0:25:53.02,0:25:56.09,Default,,0,0,0,,Ағасындай ердің қадірі жоқ.
Dialogue: 0,0:25:56.09,0:26:00.02,Default,,0,0,0,,Мен онымен әлі қыз таба алмаймын деп ойлаймын.
Dialogue: 0,0:26:01.00,0:26:04.02,Default,,0,0,0,,Торатаро өкінеді
Dialogue: 0,0:26:10.08,0:26:12.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:26:17.09,0:26:19.08,Default,,0,0,0,,Ю, не болды?
Dialogue: 0,0:26:20.06,0:26:22.08,Default,,0,0,0,,Мен ойынды қайтаруға келдім.
Dialogue: 0,0:26:23.05,0:26:26.06,Default,,0,0,0,,Бүгін болмағанын қалаймын.
Dialogue: 0,0:26:26.06,0:26:28.05,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:26:28.05,0:26:31.05,Default,,0,0,0,,Сен кеше келмедің.
Dialogue: 0,0:26:31.05,0:26:34.05,Default,,0,0,0,,Иә, мен аздап бос емеспін.
Dialogue: 0,0:26:40.08,0:26:42.06,Default,,0,0,0,,Иә, не
Dialogue: 0,0:26:42.06,0:26:43.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:26:44.08,0:26:46.00,Default,,0,0,0,,Сіз шығасыз ба?
Dialogue: 0,0:26:46.00,0:26:48.04,Default,,0,0,0,,Иә, Honeywah тірі
Dialogue: 0,0:26:48.04,0:26:50.09,Default,,0,0,0,,Мен біраздан бері барғым келеді.
Dialogue: 0,0:26:50.09,0:26:52.06,Default,,0,0,0,,Мен билет алдым.
Dialogue: 0,0:26:53.07,0:26:55.01,Default,,0,0,0,,Годамен және басқалармен
Dialogue: 0,0:26:55.01,0:26:56.09,Default,,0,0,0,,Жоқ, Коюки-кунмен.
Dialogue: 0,0:26:59.02,0:27:01.00,Default,,0,0,0,,Бұл жейде емес
Dialogue: 0,0:27:01.00,0:27:04.03,Default,,0,0,0,,Иә, дұрыс айтасыз, бұл тікелей эфир.
Dialogue: 0,0:27:04.03,0:27:06.06,Default,,0,0,0,,Барлығы сәнді болады.
Dialogue: 0,0:27:06.06,0:27:08.07,Default,,0,0,0,,Біреу?
Dialogue: 0,0:27:10.00,0:27:13.07,Default,,0,0,0,,Неге олай дейсің? Сәнді болсам жақсы емес пе?
Dialogue: 0,0:27:13.07,0:27:16.01,Default,,0,0,0,,Әлде бұл сізге сәйкес емес деп айтқыңыз келе ме?
Dialogue: 0,0:27:16.01,0:27:17.06,Default,,0,0,0,,Бөлек
Dialogue: 0,0:27:18.02,0:27:22.08,Default,,0,0,0,,Ю үшін менің қалай киінгенім маңызды емес.
Dialogue: 0,0:27:28.06,0:27:30.00,Default,,0,0,0,,That's right.
Dialogue: 0,0:27:39.01,0:27:40.03,Default,,0,0,0,,Не болды, апа?
Dialogue: 0,0:27:40.09,0:27:42.02,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:27:42.08,0:27:44.02,Default,,0,0,0,,Не болды, апа?
Dialogue: 0,0:27:46.09,0:27:51.02,Default,,0,0,0,,Мен қазірдің өзінде тікелей эфирден ләззат аламын.
Dialogue: 0,0:27:51.02,0:27:57.02,Default,,0,0,0,,Махаббат стратегиясы жұмыс істемейді
Dialogue: 0,0:27:57.02,0:28:02.04,Default,,0,0,0,,Саған шара қолданамын... көңілің қалады, солай ма?
Dialogue: 0,0:28:03.02,0:28:05.05,Default,,0,0,0,,Қыз жүрегі
Dialogue: 0,0:28:06.02,0:28:08.08,Default,,0,0,0,,Күзгі аспанның өзгеруі
Dialogue: 0,0:28:09.02,0:28:14.05,Default,,0,0,0,,Айналмасаң, өкінесің.
Dialogue: 0,0:28:15.02,0:28:18.02,Default,,0,0,0,,Біреу сізді мақтап жатыр
Dialogue: 0,0:28:18.02,0:28:21.05,Default,,0,0,0,,Мен өз басым бақыттымын, бірақ
Dialogue: 0,0:28:21.05,0:28:26.02,Default,,0,0,0,,Бұл «біреу» ...
Dialogue: 0,0:28:26.02,0:28:30.02,Default,,0,0,0,,Қыздарға қатысты сәл күрделірек.
Dialogue: 0,0:28:30.02,0:28:33.04,Default,,0,0,0,,Біреуді жақсы көру ащы
Dialogue: 0,0:28:33.04,0:28:36.03,Default,,0,0,0,,Мұның бәрі ащы, мен оны іше алмаймын.
Dialogue: 0,0:28:36.03,0:28:39.02,Default,,0,0,0,,Көңілім толқып, жүрегім дүрсілдегенде ауырады.
Dialogue: 0,0:28:39.02,0:28:42.03,Default,,0,0,0,,Дәрілер ауруға әсер етпейді.
Dialogue: 0,0:28:42.03,0:28:45.03,Default,,0,0,0,,«Мен сені сүйемін» деген екі сөзді қолданғым келеді
Dialogue: 0,0:28:45.03,0:28:48.04,Default,,0,0,0,,Мен басқа ештеңе қаламаймын.
Dialogue: 0,0:28:48.04,0:28:51.01,Default,,0,0,0,,Мені бүгіннен бастап ұната бастасаңыз ше?
Dialogue: 0,0:28:51.01,0:28:54.02,Default,,0,0,0,,Саған анда-санда адасу керек!
Dialogue: 0,0:28:54.02,0:28:57.04,Default,,0,0,0,,Дұрыс? Махаббат - ауру.
Dialogue: 0,0:28:57.04,0:29:01.09,Default,,0,0,0,,Жауапсыз махаббат қызық деп естідім, бірақ бұл өтірік
Dialogue: 0,0:29:01.09,0:29:07.03,Default,,0,0,0,,Ауырды, жылап тұрмын.
Dialogue: 0,0:29:07.03,0:29:14.03,Default,,0,0,0,,Бірақ білесің бе, мен сені ұнататынымды білгенде қуандым.
Dialogue: 0,0:29:15.01,0:29:18.02,Default,,0,0,0,,Біреуді сүю қиын
Dialogue: 0,0:29:18.02,0:29:21.02,Default,,0,0,0,,Жалғыз көтеруге тым ауыр.
Dialogue: 0,0:29:21.02,0:29:24.01,Default,,0,0,0,,Мен қатты толқып, толқып кеттім
Dialogue: 0,0:29:24.01,0:29:27.04,Default,,0,0,0,,Ерекше болмаса ұнамайды.
Dialogue: 0,0:29:35.06,0:29:38.06,Default,,0,0,0,,Коюки-кун, бүгінгі күн үшін рахмет...
Dialogue: 0,0:29:40.03,0:29:44.02,Default,,0,0,0,,Мен сені үйге осылай апарамын, солай ма?
Dialogue: 0,0:29:44.09,0:29:46.01,Default,,0,0,0,,Кешігіп қалғаным үшін кешірім сұраймын.
Dialogue: 0,0:30:27.06,0:30:30.08,Default,,0,0,0,,Міне, біз осындамыз.
Dialogue: 0,0:30:30.08,0:30:34.07,Default,,0,0,0,,Бүгінгі күн үшін рахмет. Бұл шынымен көңілді болды.
Dialogue: 0,0:30:35.09,0:30:41.00,Default,,0,0,0,,Мен үшін бұл шынымен де арман сияқты болды.
Dialogue: 0,0:30:41.08,0:30:43.09,Default,,0,0,0,,Сіз асыра айтып отырсыз, Коюки-кун.
Dialogue: 0,0:30:45.02,0:30:48.05,Default,,0,0,0,,Ю, Менің ойымша, сіз әлі үйге келген жоқсыз.
Dialogue: 0,0:30:49.01,0:30:51.09,Default,,0,0,0,,Сіз әлі ашулысыз ба?
Dialogue: 0,0:30:51.09,0:30:53.05,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:30:54.03,0:30:56.03,Default,,0,0,0,,Ем, кез келген нәрсе.
Dialogue: 0,0:30:57.00,0:31:00.07,Default,,0,0,0,,Сетогучи-кунмен бірдеңе болды.
Dialogue: 0,0:31:06.03,0:31:07.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:31:07.08,0:31:10.08,Default,,0,0,0,,Сіз дәл қазір қандай болғаныңызды білесіз бе?
Dialogue: 0,0:31:11.05,0:31:15.00,Default,,0,0,0,,Мен сені бұлай мұңаймас едім.
Dialogue: 0,0:31:15.00,0:31:16.04,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:31:16.08,0:31:18.04,Default,,0,0,0,,Демек, бұл Сетогучи емес...
Dialogue: 0,0:31:18.04,0:31:19.09,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:31:22.04,0:31:23.04,Default,,0,0,0,,Ю
Dialogue: 0,0:31:23.04,0:31:28.00,Default,,0,0,0,,Аясе, сен ТПО сөзін білесің.
Dialogue: 0,0:31:28.00,0:31:31.07,Default,,0,0,0,,Бұл қоғамдық орын, маңайдан адамдар өтіп жатыр.
Dialogue: 0,0:31:31.07,0:31:35.00,Default,,0,0,0,,Нацуки оны осылай көрсе, қиналып қалар еді.
Dialogue: 0,0:31:35.00,0:31:36.07,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:31:36.07,0:31:40.07,Default,,0,0,0,,Егер сіз өзіңізді жігітім деп көрсетсеңіз, бұл жігіт туралы көбірек ойлаңыз.
Dialogue: 0,0:31:43.04,0:31:46.03,Default,,0,0,0,,Ол сөз бумерангқа айналып кетпей ме?
Dialogue: 0,0:31:46.03,0:31:48.08,Default,,0,0,0,,Жоқ Мұны қалай айтуға болады?
Dialogue: 0,0:31:48.08,0:31:50.03,Default,,0,0,0,,Өйткені біз бала кезден доспыз
Dialogue: 0,0:31:50.03,0:31:52.08,Default,,0,0,0,,Бала күнгі дос
Dialogue: 0,0:31:54.00,0:31:57.03,Default,,0,0,0,,Эй, тоқтат.
Dialogue: 0,0:31:58.09,0:31:59.08,Default,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:31:59.08,0:32:03.07,Default,,0,0,0,,Тоқта, қашып барасың ба? Әңгіме әлі біткен жоқ...
Dialogue: 0,0:32:02.07,0:32:05.00,Default,,0,0,0,,Әңгіменің соңы
Dialogue: 0,0:32:07.00,0:32:09.05,Default,,0,0,0,,Сенің арқасында тіпті трусигім де суға малып кетті. О, Құдай-ай…
Dialogue: 0,0:33:08.05,0:33:10.02,Default,,0,0,0,,Көздер ауыр
Dialogue: 0,0:33:20.04,0:33:22.04,Default,,0,0,0,,Мен неге жыладым деп ойлаймын
Dialogue: 0,0:33:23.02,0:33:24.09,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:33:24.09,0:33:26.08,Default,,0,0,0,,Беттің қандай түрін жасауым керек?
Dialogue: 0,0:33:37.05,0:33:38.07,Default,,0,0,0,,Жарайды
Dialogue: 0,0:33:50.09,0:33:52.01,Default,,0,0,0,,Года және т.б
Dialogue: 0,0:33:53.01,0:33:57.00,Default,,0,0,0,,Өнер үйірмесінің сайысы алда, сондықтан мен алға барамын.
Dialogue: 0,0:34:01.00,0:34:03.02,Default,,0,0,0,,Сіз не істеп жатырсыз? Барайық.
Dialogue: 0,0:34:10.02,0:34:11.04,Default,,0,0,0,,Ұнады
Dialogue: 0,0:34:15.01,0:34:18.06,Default,,0,0,0,,Кенеттен бастамаңыз Мойындау репетициясы
Dialogue: 0,0:34:18.06,0:34:20.09,Default,,0,0,0,,Бұл кенеттен болса, мойындау болар еді.
Dialogue: 0,0:34:20.09,0:34:22.05,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:34:22.05,0:34:23.07,Default,,0,0,0,,Тым жеңіл
Dialogue: 0,0:34:23.07,0:34:25.01,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:34:25.01,0:34:26.01,Default,,0,0,0,,Дауыс тым үлкен
Dialogue: 0,0:34:26.01,0:34:27.01,Default,,0,0,0,,Ұнату және ұнату
Dialogue: 0,0:34:27.01,0:34:28.01,Default,,0,0,0,,Тым көп
Dialogue: 0,0:34:28.01,0:34:29.09,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:34:29.09,0:34:30.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:34:37.00,0:34:40.08,Default,,0,0,0,,Қарбыз және жираф
Dialogue: 0,0:34:41.07,0:34:43.09,Default,,0,0,0,,Бірге ұнайды
Dialogue: 0,0:34:43.09,0:34:46.05,Default,,0,0,0,,Тек екі әріпті айт, солай ма?
Dialogue: 0,0:34:46.05,0:34:48.00,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:34:48.00,0:34:50.04,Default,,0,0,0,,«Мен Акаримен көбірек сөйлескім келеді».
Dialogue: 0,0:34:50.04,0:34:51.07,Default,,0,0,0,,Менің ойымша, сіз осылай ойлайсыз.
Dialogue: 0,0:34:51.07,0:34:54.00,Default,,0,0,0,,Мен мұны істей алмаймын, өйткені менде мұндай батылдық жоқ.
Dialogue: 0,0:34:54.00,0:34:57.04,Default,,0,0,0,,Акаринга біреумен жүрсе жарай ма?
Dialogue: 0,0:34:57.04,0:34:58.00,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:34:58.00,0:34:59.07,Default,,0,0,0,,Содан кейін мойындаңыз.
Dialogue: 0,0:34:59.07,0:35:00.08,Default,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,0:35:00.08,0:35:02.04,Default,,0,0,0,,Атмосфера басқаша емес.
Dialogue: 0,0:35:02.04,0:35:04.00,Default,,0,0,0,,Мен шашымды кесіп тастадым.
Dialogue: 0,0:35:06.05,0:35:08.00,Default,,0,0,0,,Бұл жақсы сезінеді.
Dialogue: 0,0:35:07.02,0:35:08.05,Default,,0,0,0,,Менің ойымша, бұл сүйкімді
Dialogue: 0,0:35:09.08,0:35:12.00,Default,,0,0,0,,Әй, бүгінгі адамдар.
Dialogue: 0,0:35:12.00,0:35:15.04,Default,,0,0,0,,Сакурагаока орта мектебі бұл станция емес пе?
Dialogue: 0,0:35:15.04,0:35:18.02,Default,,0,0,0,,Сіз өз орныңызды бердіңіз бе?
Dialogue: 0,0:35:19.09,0:35:21.03,Default,,0,0,0,,Бұл
Dialogue: 0,0:35:21.03,0:35:23.01,Default,,0,0,0,,Рахмет
Dialogue: 0,0:35:23.01,0:35:24.06,Default,,0,0,0,,Жақсы, онда
Dialogue: 0,0:35:29.07,0:35:32.04,Default,,0,0,0,,Оны білу ұят болды.
Dialogue: 0,0:35:32.04,0:35:34.06,Default,,0,0,0,,Орынымды беруге батылым жетсе де.
Dialogue: 0,0:35:34.06,0:35:37.04,Default,,0,0,0,,Мойындауға неге батылым жетпейді?
Dialogue: 0,0:35:40.04,0:35:41.09,Default,,0,0,0,,Біз өткен күні бірге болдық...
Dialogue: 0,0:35:45.05,0:35:47.04,Default,,0,0,0,,Бұл оңай
Dialogue: 0,0:35:59.06,0:36:00.09,Default,,0,0,0,,Коюки-кун
Dialogue: 0,0:36:02.09,0:36:04.03,Default,,0,0,0,,Эномото мырза
Dialogue: 0,0:36:04.03,0:36:06.07,Default,,0,0,0,,Кеше сол...
Dialogue: 0,0:36:08.04,0:36:10.01,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:36:10.01,0:36:12.07,Default,,0,0,0,,Жоқ, бұл үшін кешірім сұраймын.
Dialogue: 0,0:36:12.07,0:36:14.09,Default,,0,0,0,,Біртүрлі нәрсе болды.
Dialogue: 0,0:36:14.09,0:36:17.00,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:36:17.00,0:36:19.07,Default,,0,0,0,,Бұл гүлді Коюки-кун өсірді ме?
Dialogue: 0,0:36:19.07,0:36:20.04,Default,,0,0,0,,Иә
Dialogue: 0,0:36:21.08,0:36:24.04,Default,,0,0,0,,Бұл таңқаларлық. Көгалдандыру клубынан күткендей.
Dialogue: 0,0:36:24.04,0:36:26.09,Default,,0,0,0,,Әр түрлі гүлдерді отырғызуды жалғастырамын.
Dialogue: 0,0:36:26.09,0:36:28.07,Default,,0,0,0,,Бізге қайта келіңіз
Dialogue: 0,0:36:28.07,0:36:29.08,Default,,0,0,0,,Иә Я
Dialogue: 0,0:36:29.08,0:36:30.07,Default,,0,0,0,,Иә
Dialogue: 0,0:36:49.06,0:36:51.06,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:36:51.06,0:36:52.09,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:36:53.04,0:36:54.07,Default,,0,0,0,,Бүгін түскі ас па?
Dialogue: 0,0:36:54.07,0:36:55.08,Default,,0,0,0,,Бүгін сатып алыңыз
Dialogue: 0,0:36:55.08,0:36:57.00,Default,,0,0,0,,Не сатып алу керек?
Dialogue: 0,0:36:57.09,0:37:00.04,Default,,0,0,0,,Акари: Түскі қорапты өзіңіз жасадыңыз ба?
Dialogue: 0,0:37:00.04,0:37:03.07,Default,,0,0,0,,Иә, анам бос емес сияқты.
Dialogue: 0,0:37:04.04,0:37:07.09,Default,,0,0,0,,Мен Акариннің қолдан жасаған бентосын көргім келеді
Dialogue: 0,0:37:22.02,0:37:24.01,Default,,0,0,0,,Сол Юкки
Dialogue: 0,0:37:24.01,0:37:25.00,Default,,0,0,0,,Юкки?
Dialogue: 0,0:37:26.08,0:37:28.07,Default,,0,0,0,,Жақсы, Юкки.
Dialogue: 0,0:37:32.07,0:37:37.05,Default,,0,0,0,,Эй, Юкки Нацукиді ұнатады.
Dialogue: 0,0:37:37.05,0:37:39.01,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:37:39.01,0:37:44.02,Default,,0,0,0,,Юкки маған ұқсайтын сияқты.
Dialogue: 0,0:37:45.09,0:37:47.09,Default,,0,0,0,,Жоқ, жоқ па?
Dialogue: 0,0:37:47.09,0:37:49.09,Default,,0,0,0,,Юкки керемет
Dialogue: 0,0:37:49.09,0:37:52.04,Default,,0,0,0,,Осылайша мен өзімді өзгерте алдым
Dialogue: 0,0:37:52.04,0:37:55.06,Default,,0,0,0,,Маған өзгеруге мүмкіндік берген адам Эномото мырза болды.
Dialogue: 0,0:37:55.06,0:37:58.01,Default,,0,0,0,,Ештеңе жасамай, өкінген жақсы.
Dialogue: 0,0:37:58.01,0:38:01.07,Default,,0,0,0,,Мүмкін, қолыңнан келгенін істеп, өкінген жақсы шығар.
Dialogue: 0,0:38:01.07,0:38:04.06,Default,,0,0,0,,Мен оның нөл пайыз екенін білемін.
Dialogue: 0,0:38:04.06,0:38:06.06,Default,,0,0,0,,Бірақ мен үнсіз қалғаныма сене алар емеспін.
Dialogue: 0,0:38:06.06,0:38:08.06,Default,,0,0,0,,Бұл көңілсіз емес пе?
Dialogue: 0,0:38:09.04,0:38:13.02,Default,,0,0,0,,Юкки, мен Нацукидің сезімін білемін...
Dialogue: 0,0:38:13.02,0:38:16.07,Default,,0,0,0,,Мочизуки-кун Хаясаканы ұнатады, солай ма?
Dialogue: 0,0:38:16.07,0:38:18.05,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:38:21.06,0:38:24.07,Default,,0,0,0,,Қабылдау рәсімінен бастап.
Dialogue: 0,0:38:31.00,0:38:35.06,Default,,0,0,0,,Бірақ біз бұл туралы бір рет қана айттық.
Dialogue: 0,0:38:38.03,0:38:40.01,Default,,0,0,0,,Жақында ғана
Dialogue: 0,0:38:40.01,0:38:44.03,Default,,0,0,0,,Не керек, менің айтқаным: «Ұйықтайтын әдетім бар».
Dialogue: 0,0:38:44.03,0:38:46.06,Default,,0,0,0,,Бұл алға қадам емес пе?
Dialogue: 0,0:38:46.06,0:38:49.06,Default,,0,0,0,,Бірақ мойындауға тіпті батылым жетпейді.
Dialogue: 0,0:38:49.06,0:38:51.06,Default,,0,0,0,,Қатты ойлан
Dialogue: 0,0:38:52.02,0:38:54.01,Default,,0,0,0,,Рұқсатсыз ашулану
Dialogue: 0,0:38:54.06,0:38:56.09,Default,,0,0,0,,Мен өзімді жек көремін.
Dialogue: 0,0:38:56.09,0:38:58.06,Default,,0,0,0,,Бірақ бұл сізге ұнайды деп ойлаймын.
Dialogue: 0,0:39:00.04,0:39:03.00,Default,,0,0,0,,Ғашық болу сезімі өтірік емес
Dialogue: 0,0:39:04.08,0:39:06.09,Default,,0,0,0,,Менің ойымша, бұл мүмкін
Dialogue: 0,0:39:06.09,0:39:09.05,Default,,0,0,0,,Мочизуки-кун нөл пайыз емес.
Dialogue: 0,0:39:11.00,0:39:14.00,Default,,0,0,0,,Қызық, мен де өзгере аламын ба?
Dialogue: 0,0:39:14.09,0:39:17.05,Default,,0,0,0,,«Мен өзгергім келеді» деп ойлаған кезде
Dialogue: 0,0:39:17.05,0:39:19.01,Default,,0,0,0,,Бастапқы сызық
Dialogue: 0,0:39:22.01,0:39:24.08,Default,,0,0,0,,Мен өзгергім келеді
Dialogue: 0,0:39:24.08,0:39:28.08,Default,,0,0,0,,Өйткені мен Акариннің жылаған түрін көргім келмейді.
Dialogue: 0,0:39:29.09,0:39:31.06,Default,,0,0,0,,Менің көргім келетін нәрсе...
Dialogue: 0,0:39:39.09,0:39:41.06,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:39:42.00,0:39:43.03,Default,,0,0,0,,Рахмет
Dialogue: 0,0:40:19.08,0:40:21.01,Default,,0,0,0,,Хаясака мырза
Dialogue: 0,0:40:21.09,0:40:23.04,Default,,0,0,0,,Мочизуки-кун?
Dialogue: 0,0:40:25.09,0:40:27.01,Default,,0,0,0,,Біз кесіп өтетін нәрсе – ақымақтық сызығы
Dialogue: 0,0:40:28.07,0:40:30.02,Default,,0,0,0,,Менің бір оқиғам бар.
Dialogue: 0,0:40:30.02,0:40:32.01,Default,,0,0,0,,Бүгін сабақтан кейін 4:10
Dialogue: 0,0:40:32.01,0:40:34.02,Default,,0,0,0,,Өнер бөлмесінде күте аласыз ба?
Dialogue: 0,0:40:44.03,0:40:47.01,Default,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:40:50.04,0:40:51.09,Default,,0,0,0,,деді
Dialogue: 0,0:40:53.09,0:40:55.08,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:40:57.08,0:41:00.00,Default,,0,0,0,,Бұл екінші әңгіме.
Dialogue: 0,0:41:00.05,0:41:04.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:41:10.06,0:41:12.00,Default,,0,0,0,,Харуки-кун
Dialogue: 0,0:41:12.00,0:41:16.02,Default,,0,0,0,,Сіз маған кеше берген DVD өте қызық болды...
Dialogue: 0,0:41:16.02,0:41:17.07,Default,,0,0,0,,А, кешіріңіз.
Dialogue: 0,0:41:17.07,0:41:21.00,Default,,0,0,0,,Саки-нимен сөйлесетін бірдеңе бар, сондықтан бүгін алдымен үйге қайт.
Dialogue: 0,0:41:21.00,0:41:23.06,Default,,0,0,0,,Эй, сен мені мектепте мұғалім деп атасаң болады.
Dialogue: 0,0:41:23.06,0:41:27.00,Default,,0,0,0,,Мен сізді мұғалім деп атауға ыңғайсызданып тұрмын.
Dialogue: 0,0:41:27.00,0:41:29.01,Default,,0,0,0,,Егер сізге мұғалім болу ұнамаса, сіз профессор бола аласыз.
Dialogue: 0,0:41:29.01,0:41:30.04,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:41:30.04,0:41:31.04,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:41:31.04,0:41:34.00,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:41:34.00,0:41:37.00,Default,,0,0,0,,Мұғаліммен ұрыспа
Dialogue: 0,0:41:40.00,0:41:41.08,Default,,0,0,0,,Ұрыспаңыз
Dialogue: 0,0:41:44.01,0:41:46.02,Default,,0,0,0,,(Сакура) Ни, но, ро, я…
Dialogue: 0,0:41:48.07,0:41:50.06,Default,,0,0,0,,Неліктен жігіттер кездесіп жатырсыздар...
Dialogue: 0,0:41:50.06,0:41:51.07,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:41:51.07,0:41:53.05,Default,,0,0,0,,Менің айтайын дегенім, Саки-нии, темекінің иісі бар.
Dialogue: 0,0:41:53.05,0:41:55.05,Default,,0,0,0,,Темекіні тастау керек емес пе?
Dialogue: 0,0:41:55.05,0:42:00.03,Default,,0,0,0,,Ересектердің жағдайына байланысты қазір 2 темекі және 3 кәмпит. Мен
Dialogue: 0,0:42:00.03,0:42:03.06,Default,,0,0,0,,түсінбеймін
Dialogue: 0,0:42:03.06,0:42:05.04,Default,,0,0,0,,Біз кәмпит жейміз бе?
Dialogue: 0,0:42:05.04,0:42:08.03,Default,,0,0,0,,Қажет емес, мен бала емеспін.
Dialogue: 0,0:42:08.03,0:42:11.03,Default,,0,0,0,,Мен баламын, тағы да уақытым болады деп ойлаймын.
Dialogue: 0,0:42:12.03,0:42:14.06,Default,,0,0,0,,Оқу күндері қысқа.
Dialogue: 0,0:42:14.06,0:42:18.06,Default,,0,0,0,,Фильм сияқты артқа айналдыру немесе өңдеу мүмкін емес.
Dialogue: 0,0:42:18.09,0:42:21.06,Default,,0,0,0,,Айтқыңыз келген нәрсені тез айтыңыз.
Dialogue: 0,0:42:21.06,0:42:25.05,Default,,0,0,0,,Бәрі біткен соң өкінсеңіз де, бәрі кеш.
Dialogue: 0,0:42:25.05,0:42:27.06,Default,,0,0,0,,Бұл сіздің тәжірибеңіз бе?
Dialogue: 0,0:42:27.06,0:42:30.00,Default,,0,0,0,,Бұрынғылар айтқан
Dialogue: 0,0:42:30.04,0:42:35.01,Default,,0,0,0,,Алдымен өкінбе, жіберіп алған балығың үлкен.
Dialogue: 0,0:42:36.05,0:42:40.07,Default,,0,0,0,,Сол себепті, жастық шағыңыздың рахатын көру үшін бар күшіңізді салыңыз.
Dialogue: 0,0:42:40.07,0:42:43.05,Default,,0,0,0,,Кәмпит жеп ал, әрі қарай жеп ал.
Dialogue: 0,0:42:43.05,0:42:45.02,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:42:53.00,0:42:55.08,Default,,0,0,0,,Сіздің Харукимен бірге болмағаныңыз ерекше.
Dialogue: 0,0:42:55.08,0:42:59.01,Default,,0,0,0,,Менің Әкечи-сенсімен сөйлесетін бірдеңе бар сияқты.
Dialogue: 0,0:42:59.01,0:43:01.05,Default,,0,0,0,,Мен олардың төбелесіп жатқанын да көремін.
Dialogue: 0,0:43:01.05,0:43:05.03,Default,,0,0,0,,Бірақ Харуки-кун да Акечи-сенсейді ұнататын сияқты.
Dialogue: 0,0:43:05.03,0:43:09.01,Default,,0,0,0,,Сізге ұнады ма? Бұл екеуінің қарым-қатынасы күдікті.
Dialogue: 0,0:43:09.01,0:43:13.01,Default,,0,0,0,,Е, Накчан, мен мұны айтып тұрмын.
Dialogue: 0,0:43:13.01,0:43:14.08,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:43:14.08,0:43:18.03,Default,,0,0,0,,Ештеңе етпейді, еркектер қарсыластарға қосылмайды.
Dialogue: 0,0:43:18.09,0:43:21.09,Default,,0,0,0,,Демек бұл мағына емес.
Dialogue: 0,0:43:22.04,0:43:26.03,Default,,0,0,0,,Ұнамаса, айт.
Dialogue: 0,0:43:26.03,0:43:29.01,Default,,0,0,0,,Мойындау репетициясы
Dialogue: 0,0:43:29.06,0:43:32.01,Default,,0,0,0,,Сіз қай уақытқа дейін жаттығуды жоспарлайсыз?
Dialogue: 0,0:43:32.01,0:43:33.06,Default,,0,0,0,,Нақты орындалғанға дейін
Dialogue: 0,0:43:35.06,0:43:37.07,Default,,0,0,0,,Сіз шынымен жақсысыз.
Dialogue: 0,0:43:37.07,0:43:40.03,Default,,0,0,0,,Себебі мен сенімен бірге шығуға уәде бердім.
Dialogue: 0,0:43:42.07,0:43:45.07,Default,,0,0,0,,Біткен соң өкінсең де, бәрі кеш.
Dialogue: 0,0:43:46.02,0:43:48.07,Default,,0,0,0,,Егер сізге біреу ұнаса, оған тура барыңыз.
Dialogue: 0,0:43:48.07,0:43:51.02,Default,,0,0,0,,Мен сенің айтқаныңды қаламаймын.
Dialogue: 0,0:43:59.00,0:44:01.08,Default,,0,0,0,,Мойындау жоқ
Dialogue: 0,0:44:02.08,0:44:05.02,Default,,0,0,0,,Мен жақсы көретін адам бар екенін білемін
Dialogue: 0,0:44:05.02,0:44:08.08,Default,,0,0,0,,Мойындасам, бәлеге қалатынымды көріп тұрмын.
Dialogue: 0,0:44:08.08,0:44:11.06,Default,,0,0,0,,Жоқ, сәл күте тұрыңыз, оған кім ұнайды...
Dialogue: 0,0:44:11.06,0:44:15.05,Default,,0,0,0,,Мұндағы ағын, менің ойымша, аздап ауысқан дұрыс.
Dialogue: 0,0:44:16.05,0:44:18.02,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:44:25.05,0:44:26.09,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:44:46.02,0:44:48.07,Default,,0,0,0,,Менің жүрегім жарылып кете жаздады
Dialogue: 0,0:44:57.04,0:44:58.05,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:45:35.07,0:45:37.05,Default,,0,0,0,,Маған жақсы ма?
Dialogue: 0,0:45:37.05,0:45:40.06,Default,,0,0,0,,Иә, мен солай ойлаймын.
Dialogue: 0,0:45:43.04,0:45:45.00,Default,,0,0,0,,Бұл сенің маған ұнайтыныңды білдіреді.
Dialogue: 0,0:45:45.08,0:45:47.06,Default,,0,0,0,,Сондықтан маған ұнайды
Dialogue: 0,0:45:47.06,0:45:51.02,Default,,0,0,0,,Мен сені ешқашан мұңайтпаймын және сені күнде күлдіремін.
Dialogue: 0,0:45:52.01,0:45:55.01,Default,,0,0,0,,Маған күнде түскі ас қорапшасын жасап берулеріңізді қалаймын.
Dialogue: 0,0:46:00.06,0:46:05.07,Default,,0,0,0,,Мен күнде түскі ас жасағанды ​​ұнатпаймын, себебі бұл ауырады.
Dialogue: 0,0:46:08.00,0:46:10.03,Default,,0,0,0,,Мен тым көп күшпен айттым.
Dialogue: 0,0:46:11.02,0:46:16.00,Default,,0,0,0,,Айтпақшы, вокзал алдында жаңа торт дүкені ашылды.
Dialogue: 0,0:46:17.01,0:46:21.01,Default,,0,0,0,,Қарсы болмасаңыз, келесі жолы менімен бірге барғыңыз келе ме?
Dialogue: 0,0:46:26.02,0:46:28.04,Default,,0,0,0,,Иә, барамын.
Dialogue: 0,0:46:31.07,0:46:37.02,Default,,0,0,0,,Эй, Накчан, сен неге мойындауды шештің?
Dialogue: 0,0:46:41.00,0:46:42.06,Default,,0,0,0,,Дұрыс айтасың — ол әдеттегіден де көп әуре-сарсаңға түсіп жүр.
Dialogue: 0,0:46:45.08,0:46:47.03,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:46:48.08,0:46:52.03,Default,,0,0,0,,Юуды кіші сынып оқушысы мойындап жатқан көрініс.
Dialogue: 0,0:46:52.03,0:46:55.02,Default,,0,0,0,,Ал, Юу бас тартты.
Dialogue: 0,0:46:55.06,0:46:57.06,Default,,0,0,0,,Мен мұны көргенде
Dialogue: 0,0:46:58.03,0:47:01.08,Default,,0,0,0,,Мен де мойындауым керек деп ойладым.
Dialogue: 0,0:47:01.08,0:47:03.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:47:04.01,0:47:05.09,Default,,0,0,0,,Бірақ мен қорықпаймын
Dialogue: 0,0:47:06.05,0:47:09.05,Default,,0,0,0,,Мойындағаннан кейін бәрі жақсы болады деп үміттенемін.
Dialogue: 0,0:47:09.05,0:47:12.03,Default,,0,0,0,,Егер сізге бас тартылса...
Dialogue: 0,0:47:21.05,0:47:23.07,Default,,0,0,0,,Кенет салқындап кетті.
Dialogue: 0,0:47:23.07,0:47:25.04,Default,,0,0,0,,Иә, кеш болды.
Dialogue: 0,0:47:27.09,0:47:30.08,Default,,0,0,0,,Иә, Миомен аздап.
Dialogue: 0,0:47:30.08,0:47:32.01,Default,,0,0,0,,Сол
Dialogue: 0,0:47:32.07,0:47:34.02,Default,,0,0,0,,Харуки және аздап
Dialogue: 0,0:47:47.00,0:47:52.04,Default,,0,0,0,,Қатарласып, бір күні түсінемін
Dialogue: 0,0:47:50.01,0:47:53.01,Default,,0,0,0,,Егер сіз мойындасаңыз
Dialogue: 0,0:47:52.04,0:47:58.05,Default,,0,0,0,,Биіктік айырмашылығына сәл жоғары қарау
Dialogue: 0,0:47:53.06,0:47:55.07,Default,,0,0,0,,Егер бас тартылса
Dialogue: 0,0:47:58.05,0:48:01.07,Default,,0,0,0,,саналы болады
Dialogue: 0,0:47:59.08,0:48:04.08,Default,,0,0,0,,Мен осылай мойындамасам болады ма?
Dialogue: 0,0:48:01.07,0:48:04.05,Default,,0,0,0,,«Достар», солай ма?
Dialogue: 0,0:48:04.05,0:48:10.06,Default,,0,0,0,,Саған дұрыс қарай алмаймын
Dialogue: 0,0:48:05.01,0:48:09.07,Default,,0,0,0,,Бұл әлі де қызық және біз бірге бола аламыз.
Dialogue: 0,0:48:10.06,0:48:17.06,Default,,0,0,0,,«Не болды?» Сенің кесіріңнен айта алмадым.
Dialogue: 0,0:48:11.02,0:48:16.07,Default,,0,0,0,,Қарсы емеспін, бала кезден доспыз.
Dialogue: 0,0:48:21.04,0:48:26.08,Default,,0,0,0,,Алғашқы махаббатыма қарап отырдым Менің мұрным тамшылап тұр.
Dialogue: 0,0:48:23.04,0:48:25.04,Default,,0,0,0,,Ол тамшылап тұрған жоқ.
Dialogue: 0,0:48:25.04,0:48:26.07,Default,,0,0,0,,Абсолютті тамшылау
Dialogue: 0,0:48:26.07,0:48:28.09,Default,,0,0,0,,Кішкене болса да сақтығыңызды түсірмеңіз.
Dialogue: 0,0:48:27.05,0:48:32.01,Default,,0,0,0,,Мен сен білмейсің деп ойладым.
Dialogue: 0,0:48:28.09,0:48:30.05,Default,,0,0,0,,Бұл суық тиюдің үлгісі.
Dialogue: 0,0:48:30.08,0:48:33.04,Default,,0,0,0,,Нацуки әрқашан осылай болған.
Dialogue: 0,0:48:32.01,0:48:35.00,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:48:33.04,0:48:34.09,Default,,0,0,0,,Алдын алу
Dialogue: 0,0:48:35.00,0:48:43.02,Default,,0,0,0,,Күліп тұрған күн де ​​келеді
Dialogue: 0,0:48:43.02,0:48:46.00,Default,,0,0,0,,ТАҒДЫР
Dialogue: 0,0:48:46.00,0:48:53.06,Default,,0,0,0,,Махаббатты біліп, махаббатқа барамын
Dialogue: 0,0:48:53.06,0:48:56.07,Default,,0,0,0,,СЕН МАҒАН КЕРЕКСІҢ
Dialogue: 0,0:48:56.07,0:49:03.08,Default,,0,0,0,,Қабыл ал...Мен сені қазірдің өзінде жақсы көремін бе?
Dialogue: 0,0:48:58.04,0:49:00.02,Default,,0,0,0,,Маған әлі де ұнайды
Dialogue: 0,0:49:02.07,0:49:04.01,Default,,0,0,0,,Маған Ю
Dialogue: 0,0:49:03.08,0:49:11.00,Default,,0,0,0,,Махаббат туралы біліп, ғашық болдым.
Dialogue: 0,0:49:11.00,0:49:14.03,Default,,0,0,0,,МЕН СІЗГЕ УӘДЕ БЕРЕМІН
Dialogue: 0,0:49:14.03,0:49:21.03,Default,,0,0,0,,Мен сені құшақтағым келеді...Мен сені бұрыннан жақсы көремін бе? Мен өзімшілмін
Dialogue: 0,0:49:21.03,0:49:32.01,Default,,0,0,0,,Әй, мен сені сүйемін.
Dialogue: 0,0:49:33.06,0:49:39.01,Default,,0,0,0,,Мен біреудің бет-әлпетіне қызық болдым
Dialogue: 0,0:49:39.01,0:49:44.07,Default,,0,0,0,,Мен танымайтын адамды білгім келеді
Dialogue: 0,0:49:45.04,0:49:48.04,Default,,0,0,0,,«Күте тұрыңыз, кетпеңіз».
Dialogue: 0,0:49:47.05,0:49:53.03,Default,,0,0,0,,Мен Юудан осы уақытқа дейін көп нәрсе алдым, мен одан да көп нәрсені қалаймын.
Dialogue: 0,0:49:48.04,0:49:52.08,Default,,0,0,0,,Мен айта алмаймын...Мен әлі айта алмаймын.
Dialogue: 0,0:49:53.03,0:49:56.03,Default,,0,0,0,,Ю
Dialogue: 0,0:49:56.03,0:50:01.05,Default,,0,0,0,,Менің алғашқы махаббатым деп мойындадым
Dialogue: 0,0:50:00.08,0:50:03.03,Default,,0,0,0,,Өйткені Ю мен үшін ерекше
Dialogue: 0,0:50:02.04,0:50:06.08,Default,,0,0,0,,Келмейді деп ойладым.
Dialogue: 0,0:50:03.03,0:50:06.02,Default,,0,0,0,,Мен де Юуға ерекше болғым келеді.
Dialogue: 0,0:50:06.08,0:50:10.00,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:50:10.00,0:50:18.00,Default,,0,0,0,,Ұйқысыз жүрегімде тасып
Dialogue: 0,0:50:15.00,0:50:18.00,Default,,0,0,0,,Қызық, мен сені қолдаймын ба?
Dialogue: 0,0:50:18.00,0:50:20.03,Default,,0,0,0,,ESTINYD
Dialogue: 0,0:50:20.09,0:50:28.01,Default,,0,0,0,,Махаббат туралы біліп, ғашық болдым.
Dialogue: 0,0:50:21.07,0:50:24.06,Default,,0,0,0,,Мен сені қолдауым керек.
Dialogue: 0,0:50:28.01,0:50:31.04,Default,,0,0,0,,МЕН СІЗГЕ УӘДЕ БЕРЕМІН
Dialogue: 0,0:50:31.04,0:50:38.08,Default,,0,0,0,,Мен сені құшақтағым келеді...Мен сені қазірдің өзінде жақсы көремін
Dialogue: 0,0:50:38.08,0:50:51.04,Default,,0,0,0,,Эй, мен сені жақсы көремін.
Dialogue: 0,0:50:56.09,0:50:59.04,Default,,0,0,0,,Келесі кезекте бүгінгі жұлдыз жорамал.
Dialogue: 0,0:50:59.04,0:51:03.04,Default,,0,0,0,,Бірінші бақытты зодиак белгісі - қатерлі ісік.
Dialogue: 0,0:51:03.04,0:51:04.09,Default,,0,0,0,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:51:10.00,0:51:15.01,Default,,0,0,0,,«Кенеттен келгенім үшін кешіріңіз, мен сізді көптен бері жақсы көремін».
Dialogue: 0,0:51:15.01,0:51:20.00,Default,,0,0,0,,Менің жүрегімнің кеудемде соққанын естімейсің бе?
Dialogue: 0,0:51:16.00,0:51:17.02,Default,,0,0,0,,Жарайды
Dialogue: 0,0:51:18.03,0:51:19.08,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:51:19.08,0:51:20.08,Default,,0,0,0,,Накчан қайырлы таң...
Dialogue: 0,0:51:20.08,0:51:22.00,Default,,0,0,0,,Қайырлы таң...
Dialogue: 0,0:51:26.00,0:51:28.01,Default,,0,0,0,,Бұл бетке не болды?
Dialogue: 0,0:51:28.01,0:51:31.08,Default,,0,0,0,,Нацуки Эномото Мен бүгін тағы да шабуыл жасаймын.
Dialogue: 0,0:51:30.05,0:51:35.08,Default,,0,0,0,,Кокухаку репетициясы «Сіз мені байсалды деп ойладыңыз ба?»
Dialogue: 0,0:51:32.03,0:51:33.09,Default,,0,0,0,,Мен бүгін бара аламын.
Dialogue: 0,0:51:33.09,0:51:36.09,Default,,0,0,0,,Өйткені бүгінгі жұлдыз жорамында Қатерлі ісік бірінші орында тұрды.
Dialogue: 0,0:51:35.08,0:51:40.09,Default,,0,0,0,,Сіз сүйкімдісіз бе? Сіз таң қалдыңыз ба? Маған олай қарама.
Dialogue: 0,0:51:36.09,0:51:38.02,Default,,0,0,0,,Жұлдызнама?
Dialogue: 0,0:51:38.02,0:51:39.05,Default,,0,0,0,,Мен саған әйелдік күш бердім
Dialogue: 0,0:51:39.05,0:51:40.08,Default,,0,0,0,,Әйелдік күш?
Dialogue: 0,0:51:40.09,0:51:46.01,Default,,0,0,0,,Сіз байсалдысыз ба? Өтірік айтпа!! Тоқта!
Dialogue: 0,0:51:46.01,0:51:51.04,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша... Дұрыс, бүгін кішкене айналма жолмен жүріп үйге қайтайық.
Dialogue: 0,0:51:48.00,0:51:49.00,Default,,0,0,0,,Чочочочочо...
Dialogue: 0,0:51:49.00,0:51:51.01,Default,,0,0,0,,Бір сәт кешіріңіз.
Dialogue: 0,0:51:51.04,0:51:56.06,Default,,0,0,0,,Ертең мен саған сүйген адамымды айтамын. Әй, ерін далабыңды шешіп, жағыңыз.
Dialogue: 0,0:51:54.02,0:51:55.04,Default,,0,0,0,,Сондай-ақ негіз.
Dialogue: 0,0:51:55.04,0:51:57.08,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:51:56.06,0:52:01.07,Default,,0,0,0,,Маған қолдау көрсетіңіз. Маған уәде бер.
Dialogue: 0,0:52:01.07,0:52:06.09,Default,,0,0,0,,Менің өзімшілдігімді ертең ғана тыңдайсың ба?
Dialogue: 0,0:52:03.06,0:52:05.05,Default,,0,0,0,,Эномото кері
Dialogue: 0,0:52:06.09,0:52:12.00,Default,,0,0,0,,Жүрегімдегі өзімшілдік аздап өсті
Dialogue: 0,0:52:07.00,0:52:09.05,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:52:09.05,0:52:11.03,Default,,0,0,0,,Тонкацу бенто?
Dialogue: 0,0:52:11.03,0:52:15.00,Default,,0,0,0,,Қарның ашса, ұрыс...
Dialogue: 0,0:52:12.00,0:52:17.04,Default,,0,0,0,,Байыпты болыңыз, жаттығу жасаңыз!
Dialogue: 0,0:52:17.04,0:52:22.02,Default,,0,0,0,,Өтірік жүректі қараңыз
Dialogue: 0,0:52:22.09,0:52:24.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:52:41.06,0:52:44.02,Default,,0,0,0,,Накчан, қолыңнан келгеннің бәрін істе
Dialogue: 0,0:52:48.09,0:52:51.05,Default,,0,0,0,,Күткеніңізге рахмет, Мочизуки-кун.
Dialogue: 0,0:52:51.05,0:52:52.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:52:52.05,0:52:55.03,Default,,0,0,0,,Ал, торт сататын дүкенге барайық.
Dialogue: 0,0:52:55.03,0:52:56.02,Default,,0,0,0,,Иә
Dialogue: 0,0:52:56.02,0:52:58.07,Default,,0,0,0,,Акарин және торт
Dialogue: 0,0:53:00.02,0:53:02.07,Default,,0,0,0,,Накчан жекпе-жегі
Dialogue: 0,0:53:06.04,0:53:11.08,Default,,0,0,0,,Менің жүрегімнің кеудемде соққанын естімейсің бе?
Dialogue: 0,0:53:07.09,0:53:10.08,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:53:10.08,0:53:13.04,Default,,0,0,0,,Себебі мен көп жаттықтым.
Dialogue: 0,0:53:11.08,0:53:17.00,Default,,0,0,0,,Менің жүрегімдегі дірілдеген дауысты естігеніңді қалаймын
Dialogue: 0,0:53:16.05,0:53:18.07,Default,,0,0,0,,Бұл нақты нәрсе.
Dialogue: 0,0:53:25.05,0:53:28.00,Default,,0,0,0,,Ю Күткеніңізге рахмет.
Dialogue: 0,0:53:38.07,0:53:40.06,Default,,0,0,0,,Мен өзімді жанып тұрғандай сезінемін.
Dialogue: 0,0:53:40.06,0:53:44.06,Default,,0,0,0,,Иә, өйткені бұл соңғы рет.
Dialogue: 0,0:53:44.06,0:53:45.08,Default,,0,0,0,,Соңғы?
Dialogue: 0,0:53:57.01,0:53:58.06,Default,,0,0,0,,Мәңгі...
Dialogue: 0,0:54:00.06,0:54:03.00,Default,,0,0,0,,Мен сені көптен бері жақсы көремін
Dialogue: 0,0:54:03.00,0:54:05.01,Default,,0,0,0,,Менімен бірге келіңізші
Dialogue: 0,0:54:18.09,0:54:20.04,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:54:23.02,0:54:25.03,Default,,0,0,0,,Онда мен үйге бармаймын.
Dialogue: 0,0:54:26.04,0:54:30.03,Default,,0,0,0,,Бітті деп ойлаймын, соңғы мойындау репетициясы
Dialogue: 0,0:54:35.07,0:54:40.06,Default,,0,0,0,,Неліктен бұл тәжірибе емес?
Dialogue: 0,0:54:41.01,0:54:42.09,Default,,0,0,0,,Бұл нақты шоу болса да
Dialogue: 0,0:54:44.05,0:54:46.02,Default,,0,0,0,,Хабарланбаған
Dialogue: 0,0:54:51.01,0:54:55.03,Default,,0,0,0,,Нақты... қолыңнан келгеннің бәрін істе
Dialogue: 0,0:55:03.03,0:55:04.07,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:55:06.01,0:55:09.03,Default,,0,0,0,,Күтіңіз, күтіңіз
Dialogue: 0,0:55:10.02,0:55:11.05,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:55:17.01,0:55:18.05,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:55:19.07,0:55:21.00,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:55:21.07,0:55:24.04,Default,,0,0,0,,Барлық жаттығулар өтірік
Dialogue: 0,0:55:24.08,0:55:28.05,Default,,0,0,0,,Мен Юуды қатты жақсы көремін, мен оған көмектесе алмаймын.
Dialogue: 0,0:55:29.00,0:55:34.06,Default,,0,0,0,,Мен қызға ұқсамаймын, мен де қызғанамын.
Dialogue: 0,0:55:34.06,0:55:37.06,Default,,0,0,0,,Егер сіз көп кездесуге бармасаңыз, мен оны жек көретін едім.
Dialogue: 0,0:55:37.06,0:55:39.03,Default,,0,0,0,,Бұл өзімшілдік
Dialogue: 0,0:55:39.03,0:55:42.06,Default,,0,0,0,,Тек, бірақ...
Dialogue: 0,0:55:42.06,0:55:45.07,Default,,0,0,0,,Менімен бірге шығуыңды қалаймын.
Dialogue: 0,0:56:00.04,0:56:01.08,Default,,0,0,0,,Міне.
Dialogue: 0,0:56:04.05,0:56:06.07,Default,,0,0,0,,Менсіз бұл мүмкін емес еді
Dialogue: 0,0:56:18.07,0:56:23.03,Default,,0,0,0,,Қолымыздан келмейді ғой, иә?
Dialogue: 0,0:56:39.04,0:56:47.08,Default,,0,0,0,,Сіздің әңгімеңіздің ұмытылмас минуты мен секунды
Dialogue: 0,0:57:02.08,0:57:09.06,Default,,0,0,0,,Уәде беру Өз армандарына ұмтылатын адамдар
Dialogue: 0,0:57:09.06,0:57:15.02,Default,,0,0,0,,Алғашқы махаббатынан абдырап қалған адам
Dialogue: 0,0:57:15.02,0:57:21.09,Default,,0,0,0,,Болашақты жарықтандыруға тырысатын адамдар
Dialogue: 0,0:57:21.09,0:57:27.04,Default,,0,0,0,,Жылап жүріп, қайратты болған адам
Dialogue: 0,0:57:27.04,0:57:33.06,Default,,0,0,0,,Әрбір жасты байланыстыру
Dialogue: 0,0:57:33.06,0:57:40.00,Default,,0,0,0,,Әр сәтті толық өмір сүру
Dialogue: 0,0:57:41.04,0:57:42.09,Default,,0,0,0,,Жарқыраған траектория
Dialogue: 0,0:57:42.09,0:57:48.04,Default,,0,0,0,,Мен сенің сөздеріңді минут сайын ұмытпаймын
Dialogue: 0,0:57:49.00,0:57:53.08,Default,,0,0,0,,Қорықпайтын жұлдыздар менің оқиғамды көрсетеді
Dialogue: 0,0:57:53.08,0:57:58.02,Default,,0,0,0,,Егер сүрінсең, кез келген уақытта осында кел.
Dialogue: 0,0:57:58.02,0:58:04.04,Default,,0,0,0,,Қанатымызды демалып, жоғары қарап күлейік
Dialogue: 0,0:58:04.04,0:58:07.01,Default,,0,0,0,,«Жарайды».
Dialogue: 0,0:58:08.01,0:58:14.02,Default,,0,0,0,,Айнымас және сүйікті Даңқ күндері
Dialogue: 0,0:58:14.02,0:58:19.00,Default,,0,0,0,,Сіздің ішіңізде өмір сүру
Dialogue: 0,0:58:32.01,0:58:38.08,Default,,0,0,0,,Кездесуге толы көктем
Dialogue: 0,0:58:38.08,0:58:44.04,Default,,0,0,0,,Қол қосылып, Жаз қызықпен жүгіре бастайды
Dialogue: 0,0:58:44.04,0:58:51.01,Default,,0,0,0,,Соқтығысу арқылы бір-бірімізді растай алдық күз
Dialogue: 0,0:58:51.01,0:58:56.06,Default,,0,0,0,,Бәріміз бірге болып, табанды қысты таптық.
Dialogue: 0,0:58:56.06,0:59:02.09,Default,,0,0,0,,Себебі мен болашақ жоспарларымызды байланыстырғым келеді
Dialogue: 0,0:59:02.09,0:59:09.06,Default,,0,0,0,,Ешқашан қайталанбайтын сәтті толық өмір сүру
Dialogue: 0,0:59:10.07,0:59:12.01,Default,,0,0,0,,Ертеңге қарай ұшады
Dialogue: 0,0:59:12.01,0:59:17.08,Default,,0,0,0,,Сенің күлкіңді минут сайын ұмытпаймын
Dialogue: 0,0:59:18.02,0:59:23.00,Default,,0,0,0,,Аспанға тартқымыз келетін армандар, болашағымыз
Dialogue: 0,0:59:23.00,0:59:30.05,Default,,0,0,0,,Қиын кезде бір-біріміздің иығымызға сүйеніп сөйлесейік.
Dialogue: 0,0:59:30.05,0:59:33.06,Default,,0,0,0,,Алға, алға ұмтылайық
Dialogue: 0,0:59:33.06,0:59:36.05,Default,,0,0,0,,«Жарайды».
Dialogue: 0,0:59:37.03,0:59:43.03,Default,,0,0,0,,Қоштасу емес, тағдырлас досым
Dialogue: 0,0:59:43.05,0:59:48.04,Default,,0,0,0,,Менің кеудемде өмір сүру
Dialogue: 0,0:59:50.04,0:59:53.05,Default,,0,0,0,,Жылауға болмайды
Dialogue: 0,0:59:53.05,0:59:56.05,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:59:56.05,0:59:58.01,Default,,0,0,0,,Суретке түсейік
Dialogue: 0,0:59:58.01,1:00:05.05,Default,,0,0,0,,Бірінші және соңғы арнайы бөлім
Dialogue: 0,1:00:11.01,1:00:12.06,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:00:13.04,1:00:15.03,Default,,0,0,0,,Мен жақсы көретін адам
Dialogue: 0,1:00:32.00,1:00:38.02,Default,,0,0,0,,Әрбір жасты байланыстыру
Dialogue: 0,1:00:38.02,1:00:44.09,Default,,0,0,0,,Әр сәтті толық өмір сүру
Dialogue: 0,1:00:47.05,1:00:53.01,Default,,0,0,0,,Мен сенің дауысыңды минут сайын ұмытпаймын
Dialogue: 0,1:00:53.06,1:00:59.01,Default,,0,0,0,,Мен жалғыз емеспін, бәрібір
Dialogue: 0,1:00:59.08,1:01:02.09,Default,,0,0,0,,Жарқыраған траектория, ертеңге қарай ұшады
Dialogue: 0,1:01:02.09,1:01:09.00,Default,,0,0,0,,Мен сенің сөздеріңді минут сайын ұмытпаймын
Dialogue: 0,1:01:09.00,1:01:13.08,Default,,0,0,0,,Қорықпайтын жұлдыздар менің оқиғамды көрсетеді
Dialogue: 0,1:01:13.08,1:01:18.02,Default,,0,0,0,,Сүрінсең, кез келген уақытта осында кел.
Dialogue: 0,1:01:18.02,1:01:24.04,Default,,0,0,0,,Қанатымызды демалып, жоғары қарап күлейік.
Dialogue: 0,1:01:24.04,1:01:26.09,Default,,0,0,0,,«Жарайды».
Dialogue: 0,1:01:28.00,1:01:34.01,Default,,0,0,0,,Айнымас және сүйікті Даңқ күндері
Dialogue: 0,1:01:34.01,1:01:39.07,Default,,0,0,0,,Сіздің ішіңізде өмір сүру
Dialogue: 0,1:01:45.09,1:01:52.01,Default,,0,0,0,,Әрі қарай, алға қарап, «Жарайды» дейміз.
Dialogue: 0,1:01:52.01,1:01:54.04,Default,,0,0,0,,Сіздің әңгімеңіз
Dialogue: 0,1:02:09.01,1:02:12.02,Default,,0,0,0,,Иә, ояныңыз.
Dialogue: 0,1:02:13.03,1:02:15.08,Default,,0,0,0,,Нацуки Не...
Dialogue: 0,1:02:15.08,1:02:17.05,Default,,0,0,0,,Менің сізге айтарым маңызды.
Dialogue: 0,1:02:17.05,1:02:19.05,Default,,0,0,0,,Не?
Dialogue: 0,1:02:20.05,1:02:23.00,Default,,0,0,0,,Ю маған ұнайды
Dialogue: 0,1:02:25.03,1:02:28.03,Default,,0,0,0,,Мм, қазір мұны айтқыңыз келе ме?
Dialogue: 0,1:02:28.03,1:02:30.02,Default,,0,0,0,,Енді ештеңе жоқ
Dialogue: 0,1:02:30.02,1:02:35.04,Default,,0,0,0,,Мен ешқашан Ю мені сүйеді деп айтқан емес.
Dialogue: 0,1:02:37.03,1:02:40.06,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,1:02:40.06,1:02:42.02,Default,,0,0,0,,Мен мойындаған кезде де
Dialogue: 0,1:02:42.02,1:02:44.09,Default,,0,0,0,,«Көп рахмет» болды.
Dialogue: 0,1:02:44.09,1:02:46.06,Default,,0,0,0,,Оны әр уақытта айтпа
Dialogue: 0,1:02:46.06,1:02:48.09,Default,,0,0,0,,Бұл қорқынышты. Мен ұяттан өліп жатырмын.
Dialogue: 0,1:02:48.09,1:02:53.00,Default,,0,0,0,,Эй Ю, тест тапсырушылардың екі рет ұйықтауы дұрыс па?
Dialogue: 0,1:02:53.00,1:02:56.00,Default,,0,0,0,,Жарайды, мен екі сағат бұрын ұйықтадым.
Dialogue: 0,1:02:56.00,1:02:59.05,Default,,0,0,0,,өтіңіз. Қайтадан түні бойы ұйықтау Тым көп жұмыс істеу жақсы емес
Dialogue: 0,1:02:59.05,1:03:00.07,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,1:03:04.01,1:03:07.09,Default,,0,0,0,,Тосын шабуыл жоқ. Дұрыстап қайталап айтыңыз
Dialogue: 0,1:03:08.09,1:03:12.01,Default,,0,0,0,,Әзірше мүмкін емес. Бұл сіздің жүрегіңізге жаман.
Dialogue: 0,1:03:13.00,1:03:16.08,Default,,0,0,0,,Сол қобалжуды жеңе отырып, мен өз сезімімді мойындадым.
Dialogue: 0,1:03:16.08,1:03:20.03,Default,,0,0,0,,Иә, иә, рахмет.
Dialogue: 0,1:03:23.01,1:03:27.05,Default,,0,0,0,,Мен өзімді мүлде жақсы сезінбеймін.
Dialogue: 0,1:03:28.55,1:03:33.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
