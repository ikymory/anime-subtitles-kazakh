Dialogue: 0,0:21:44.75,0:21:47.05,Default,,0,0,0,,Көрінгендей, осы елде қарапайым адамдар осылайша өмір сүреді.
Dialogue: 0,0:21:47.17,0:21:50.76,Default,,0,0,0,,(Будың дыбысы)
Dialogue: 0,0:21:51.18,0:21:52.05,Default,,0,0,0,,Өзін-өзі жөндеуді айтарлықтай тиімсіз етеді.
Dialogue: 0,0:21:52.13,0:21:55.68,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:21:57.22,0:21:58.31,Default,,0,0,0,,(Джозефтің ауыр демі)
Dialogue: 0,0:21:58.39,0:22:04.40,Default,,0,0,0,,♪~
Dialogue: 0,0:23:20.06,0:23:26.06,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.94,0:23:37.41,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:23:37.53,0:23:41.37,Default,,0,0,0,,(Төртеуінің ауыр демі)
