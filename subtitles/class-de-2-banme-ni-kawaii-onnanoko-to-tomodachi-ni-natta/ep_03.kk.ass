Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.41,0:00:04.33,Default,,0,0,0,,...Бірдеңе болды.
Dialogue: 0,0:00:04.42,0:00:05.75,Default,,0,0,0,,Иә~ Ахахахаха
Dialogue: 0,0:00:05.83,0:00:06.67,Default,,0,0,0,,Ах
Dialogue: 0,0:00:07.67,0:00:09.05,Default,,0,0,0,,- (кеш) Қайырлы таң! -(Маки) Ах.
Dialogue: 0,0:00:10.42,0:00:12.09,Default,,0,0,0,,Бүгін де ауа райы жақсы.
Dialogue: 0,0:00:13.34,0:00:16.30,Default,,0,0,0,,Қайырлы таң, түсінемін...
Dialogue: 0,0:00:16.39,0:00:17.55,Default,,0,0,0,,Ммм~
Dialogue: 0,0:00:17.64,0:00:20.97,Default,,0,0,0,,Маки-кун бейтаныс адам сияқты әрекет етеді.
Dialogue: 0,0:00:21.06,0:00:23.35,Default,,0,0,0,,Жоқ... жақсы...
Dialogue: 0,0:00:23.44,0:00:25.35,Default,,0,0,0,,Эй... Эй Ючин
Dialogue: 0,0:00:25.44,0:00:28.98,Default,,0,0,0,,Сұрау керек пе, Макикун? Амал жоқ...
Dialogue: 0,0:00:29.07,0:00:31.99,Default,,0,0,0,,Не? Жоқ, Нина Читара
Dialogue: 0,0:00:32.07,0:00:34.40,Default,,0,0,0,,Бұл әрине Маэхара-кун.
Dialogue: 0,0:00:34.49,0:00:36.57,Default,,0,0,0,,Маки Маэхара
Dialogue: 0,0:00:36.66,0:00:39.16,Default,,0,0,0,,Мүмкін сіздің есіміңіз есіңізде жоқ шығар?
Dialogue: 0,0:00:39.24,0:00:40.91,Default,,0,0,0,,Жоқ, бұл дұрыс емес...
Dialogue: 0,0:00:40.99,0:00:44.87,Default,,0,0,0,,Біз жарасып, дос болдық, солай ма?
Dialogue: 0,0:00:44.96,0:00:46.75,Default,,0,0,0,,-(Оқушылар) А... -(Маки) Ух... Иә...
Dialogue: 0,0:00:46.83,0:00:48.67,Default,,0,0,0,,Қайда... сонша алыста
Dialogue: 0,0:00:48.75,0:00:50.75,Default,,0,0,0,,Әлгі жігіт пен Амами-сан?
Dialogue: 0,0:00:50.84,0:00:53.97,Default,,0,0,0,,Қандай да бір әлсіздік пайдаланылып жатқан болуы мүмкін бе?
Dialogue: 0,0:00:54.05,0:00:55.59,Default,,0,0,0,,Әлсіздік дегеніміз не?
Dialogue: 0,0:00:56.43,0:00:59.05,Default,,0,0,0,,Біртүрлі нәрсе болды...
Dialogue: 0,0:00:59.14,0:01:02.81,Default,,0,0,0,,Кеше сен мені лақтырып тастағаннан кейін не болды?
Dialogue: 0,0:01:02.89,0:01:04.23,Default,,0,0,0,,Мм... құпия
Dialogue: 0,0:01:04.23,0:01:05.64,Default,,0,0,0,,Мм... құпия
Dialogue: 0,0:01:04.23,0:01:05.64,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:01:05.73,0:01:07.90,Default,,0,0,0,,Мен одан да қызықпын!
Dialogue: 0,0:01:07.98,0:01:10.02,Default,,0,0,0,,Кешім үшін кешірім сұраймын.
Dialogue: 0,0:01:11.48,0:01:13.03,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:01:14.99,0:01:19.53,Default,,0,0,0,,♪～
Dialogue: 0,0:02:41.61,0:02:44.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:46.41,0:02:48.33,Default,,0,0,0,,Уау, бұл рас!
Dialogue: 0,0:02:48.96,0:02:51.71,Default,,0,0,0,,Мұндай жер болса да, ол жерде ешкім жоқ.
Dialogue: 0,0:02:51.79,0:02:56.96,Default,,0,0,0,,Күн сәулесі жақсы, орындықтары жақсы жер.
Dialogue: 0,0:02:57.05,0:02:59.42,Default,,0,0,0,,Бұлай айтқаныңызға қуаныштымын.
Dialogue: 0,0:03:02.97,0:03:05.64,Default,,0,0,0,,Мен бұл екеуімен түскі ас ішемін деп ешқашан ойламадым.
Dialogue: 0,0:03:05.72,0:03:08.06,Default,,0,0,0,,Мен оны жейтініме сене алар емеспін.
Dialogue: 0,0:03:08.56,0:03:09.64,Default,,0,0,0,,Маки-кун
Dialogue: 0,0:03:09.73,0:03:12.27,Default,,0,0,0,,Бүгін бірге түскі ас ішеміз бе?
Dialogue: 0,0:03:12.35,0:03:13.52,Default,,0,0,0,,- (Маки) Әй! -(Оқушылар) Әй!
Dialogue: 0,0:03:13.61,0:03:15.02,Default,,0,0,0,,Сәлем, кеш!
Dialogue: 0,0:03:15.11,0:03:17.48,Default,,0,0,0,,Бұл жақсы емес...
Dialogue: 0,0:03:17.57,0:03:18.57,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:03:18.65,0:03:19.49,Default,,0,0,0,,Маки-кун
Dialogue: 0,0:03:19.57,0:03:22.86,Default,,0,0,0,,Ол үлкен топтарда жұмыс істеуде жақсы емес екенін айтты.
Dialogue: 0,0:03:22.95,0:03:26.24,Default,,0,0,0,,Олай болса, екеуміз ғана болғанымыз дұрыс болар еді деп ойлаймын.
Dialogue: 0,0:03:26.33,0:03:28.04,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:03:28.12,0:03:31.83,Default,,0,0,0,,Бұл мүлдем жаман емес, бірақ...
Dialogue: 0,0:03:31.92,0:03:34.21,Default,,0,0,0,,Маэхара-кун да солай ойлайды, солай ма?
Dialogue: 0,0:03:34.29,0:03:35.79,Default,,0,0,0,,Ей! Естисің бе!? Польнареф!?
Dialogue: 0,0:03:35.88,0:03:39.26,Default,,0,0,0,,Күткендей, бұл мені қобалжытады...
Dialogue: 0,0:03:39.34,0:03:42.22,Default,,0,0,0,,Қараңызшы, Маэхара-кун да солай дейді.
Dialogue: 0,0:03:42.30,0:03:44.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:46.01,0:03:48.81,Default,,0,0,0,,Ах! Сонымен, теңіз туралы не деуге болады?
Dialogue: 0,0:03:48.89,0:03:49.85,Default,,0,0,0,,Не!
Dialogue: 0,0:03:49.93,0:03:52.77,Default,,0,0,0,,Уми де кеше Макимен бірге болды.
Dialogue: 0,0:03:53.60,0:03:55.86,Default,,0,0,0,,Эй, Макикун, жақсы, солай ма?
Dialogue: 0,0:03:55.94,0:03:58.32,Default,,0,0,0,,Ух... у...
Dialogue: 0,0:03:59.69,0:04:00.65,Default,,0,0,0,,Я...
Dialogue: 0,0:04:01.24,0:04:02.24,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:02.32,0:04:05.49,Default,,0,0,0,,Сонымен, бүгін Асанаги-сан мен Амами-сан, біз үшеуміз ғана.
Dialogue: 0,0:04:05.57,0:04:06.41,Default,,0,0,0,,Сонымен
Dialogue: 0,0:04:06.49,0:04:07.62,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:07.70,0:04:09.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:12.12,0:04:14.92,Default,,0,0,0,,Асанаги-сан мен Амами-санмен.
Dialogue: 0,0:04:15.00,0:04:17.46,Default,,0,0,0,,Өйткені ол айналаңыздағылардың назарын міндетті түрде аударады.
Dialogue: 0,0:04:17.54,0:04:19.92,Default,,0,0,0,,Жалғыз тамақтануға арналған арнайы орын
Dialogue: 0,0:04:20.00,0:04:22.34,Default,,0,0,0,,Екеуіне осылай жол көрсеттім.
Dialogue: 0,0:04:22.42,0:04:23.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:23.34,0:04:26.14,Default,,0,0,0,,Маки-кунның тамогояки дәмді көрінеді
Dialogue: 0,0:04:26.22,0:04:28.10,Default,,0,0,0,,Оны менің винеріме айырбастағыңыз келе ме?
Dialogue: 0,0:04:28.18,0:04:31.89,Default,,0,0,0,,Е... жарайды, маған бәрібір.
Dialogue: 0,0:04:31.98,0:04:34.10,Default,,0,0,0,,Сіздің талғамыңызға сәйкес келмеуі мүмкін
Dialogue: 0,0:04:34.19,0:04:37.73,Default,,0,0,0,,Сол түскі қорапты өзіңіз дайындаған шығарсыз?
Dialogue: 0,0:04:37.81,0:04:39.19,Default,,0,0,0,,Кейде
Dialogue: 0,0:04:39.27,0:04:41.57,Default,,0,0,0,,Себебі ата-анам жұмыстан қолы бос емес.
Dialogue: 0,0:04:41.65,0:04:43.40,Default,,0,0,0,,Теңіз Біз не істеуіміз керек?
Dialogue: 0,0:04:43.49,0:04:46.49,Default,,0,0,0,,Бізде Маки-кунға қарағанда әйелдік күш аз!
Dialogue: 0,0:04:46.57,0:04:49.41,Default,,0,0,0,,Мені ол жерге қосуды тоқтатасыз ба?
Dialogue: 0,0:04:50.24,0:04:51.08,Default,,0,0,0,,Аму
Dialogue: 0,0:04:51.16,0:04:52.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:52.12,0:04:54.46,Default,,0,0,0,,Бұл жұмыртқа орамы дәмді.
Dialogue: 0,0:04:54.54,0:04:57.21,Default,,0,0,0,,Оның тәтті және тұзды дәмі бар, күрішпен жақсы үйлеседі!
Dialogue: 0,0:04:57.29,0:04:58.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:58.63,0:05:01.17,Default,,0,0,0,,Маэхара-кун, мен де ала аламын ба?
Dialogue: 0,0:05:01.25,0:05:03.34,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:05:10.72,0:05:11.72,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:11.81,0:05:12.64,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:05:14.23,0:05:15.94,Default,,0,0,0,,Алдау
Dialogue: 0,0:05:17.02,0:05:21.32,Default,,0,0,0,,Эй, Маки-кун тіпті тәттілерді де жасай алады!
Dialogue: 0,0:05:21.40,0:05:25.53,Default,,0,0,0,,Сонымен, жақында жасаған тәттілеріңіздің қайсысы дәмді болды?
Dialogue: 0,0:05:25.61,0:05:27.66,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:27.74,0:05:32.20,Default,,0,0,0,,Жұмыртқа мен бананнан жасалған суфле құймақтары...
Dialogue: 0,0:05:32.29,0:05:33.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:35.91,0:05:40.50,Default,,0,0,0,,Тәтті жасағың келсе, мен де жасап көрейін...
Dialogue: 0,0:05:40.59,0:05:43.13,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,0:05:43.21,0:05:46.22,Default,,0,0,0,,Бұл мүмкін емес. Мен жеңе алмадым...
Dialogue: 0,0:05:46.30,0:05:49.14,Default,,0,0,0,,Мықты болыңыз! Жара әлі таяз!
Dialogue: 0,0:05:49.22,0:05:51.43,Default,,0,0,0,,Бұл соншалықты қиын емес
Dialogue: 0,0:05:51.51,0:05:54.93,Default,,0,0,0,,Оны онлайн бейнелерді көру арқылы қарапайым қадамдармен жасауға болады.
Dialogue: 0,0:05:55.02,0:06:00.10,Default,,0,0,0,,Бу~ Маки-кун, сен оңай айттың~
Dialogue: 0,0:06:00.19,0:06:02.52,Default,,0,0,0,,Жақсы~ Керемет~
Dialogue: 0,0:06:02.61,0:06:05.82,Default,,0,0,0,,Ертегіні тыңдап жегім келді~
Dialogue: 0,0:06:05.90,0:06:09.36,Default,,0,0,0,,Уау~ Құймақ~…
Dialogue: 0,0:06:09.45,0:06:12.99,Default,,0,0,0,,Сонша жегің келсе, бөлек дайында.
Dialogue: 0,0:06:13.08,0:06:14.66,Default,,0,0,0,,Иә! Шынымен бе?
Dialogue: 0,0:06:14.74,0:06:16.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:16.95,0:06:18.75,Default,,0,0,0,,♪ Панпапапанпапа~н
Dialogue: 0,0:06:18.83,0:06:21.08,Default,,0,0,0,,А, онда бүгін шыға аламыз ба?
Dialogue: 0,0:06:21.17,0:06:22.00,Default,,0,0,0,,Е...
Dialogue: 0,0:06:23.67,0:06:24.84,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:06:25.67,0:06:28.76,Default,,0,0,0,,Рахмет! Мен оны шынымен асыға күтемін!
Dialogue: 0,0:06:28.84,0:06:31.55,Default,,0,0,0,,А, теңіз де жақсы, солай ма?
Dialogue: 0,0:06:31.64,0:06:32.64,Default,,0,0,0,,Иә
Dialogue: 0,0:06:34.18,0:06:35.39,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:06:36.18,0:06:39.14,Default,,0,0,0,,Жарайды, мен саған шай алып берейін!
Dialogue: 0,0:06:40.14,0:06:41.94,Default,,0,0,0,,Ю Сен жақсы қызсың ғой, солай ма?
Dialogue: 0,0:06:42.02,0:06:42.94,Default,,0,0,0,,Иә
Dialogue: 0,0:06:43.02,0:06:48.19,Default,,0,0,0,,Бастапқыда мен сізді жарқын адам деп ойладым, бірақ не айтамын...
Dialogue: 0,0:06:49.40,0:06:50.78,Default,,0,0,0,,Ит сияқты ма?
Dialogue: 0,0:06:50.86,0:06:51.70,Default,,0,0,0,,А… арыстан!
Dialogue: 0,0:06:53.16,0:06:56.62,Default,,0,0,0,,Маэхара: Сіз біртүрлі қиындыққа тап болдыңыз ба?
Dialogue: 0,0:06:56.70,0:06:57.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:58.37,0:07:00.79,Default,,0,0,0,,Не айтайын, кеште онша емес
Dialogue: 0,0:07:00.87,0:07:04.13,Default,,0,0,0,,Мен басқалардың не ойлайтынына мән беретін адам емеспін.
Dialogue: 0,0:07:04.21,0:07:07.09,Default,,0,0,0,,Бірақ мен бастапқыда жүзіп жүрдім.
Dialogue: 0,0:07:07.17,0:07:09.97,Default,,0,0,0,,Сізге тікелей бірдеңе жасалғанына қарамастан
Dialogue: 0,0:07:10.05,0:07:12.01,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған хабарлаңыз.
Dialogue: 0,0:07:12.97,0:07:14.64,Default,,0,0,0,,Мен ештеңе жоқ деп ойлаймын.
Dialogue: 0,0:07:14.72,0:07:16.93,Default,,0,0,0,,Мен білмеймін бе?
Dialogue: 0,0:07:17.01,0:07:20.43,Default,,0,0,0,,Өйткені ол «ең сүйкімді Амами-сан»
Dialogue: 0,0:07:20.52,0:07:21.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:24.15,0:07:25.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:25.31,0:07:27.86,Default,,0,0,0,,Жоқ, бәрі солай айтады.
Dialogue: 0,0:07:28.65,0:07:31.28,Default,,0,0,0,,Әдетте бұл жерде де хабарланады.
Dialogue: 0,0:07:31.95,0:07:35.74,Default,,0,0,0,,Иә, мен ешкімге айтпай солай айттым.
Dialogue: 0,0:07:36.45,0:07:38.95,Default,,0,0,0,,Ең сүйкімді Амами-санмен
Dialogue: 0,0:07:39.04,0:07:41.00,Default,,0,0,0,,Екінші ең сүйкімді...
Dialogue: 0,0:07:41.96,0:07:45.96,Default,,0,0,0,,Бұл менің сыныбымдағы кейбір адамдар айтқан еркелік.
Dialogue: 0,0:07:46.04,0:07:49.55,Default,,0,0,0,,Иә? Менің ойымша, сіз орындысыз.
Dialogue: 0,0:07:50.30,0:07:55.55,Default,,0,0,0,,Тіпті менің қыз ретіндегі көзқарасым бойынша Юу әрқашан сүйкімді болды.
Dialogue: 0,0:07:55.64,0:07:58.01,Default,,0,0,0,,Сыртқы түрі және тұлғасы
Dialogue: 0,0:07:58.10,0:07:59.14,Default,,0,0,0,,-(Маки) Мен... -(Уми) Сол себепті—
Dialogue: 0,0:07:59.89,0:08:02.44,Default,,0,0,0,,Жақында сен де Маэхараға ғашық боласың.
Dialogue: 0,0:08:04.48,0:08:06.86,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:08:06.94,0:08:09.44,Default,,0,0,0,,Күткеніңізге рахмет! Хахахаха...
Dialogue: 0,0:08:09.53,0:08:10.07,Default,,0,0,0,,Дос ретінде... сіз мұны айтасыз ба?
Dialogue: 0,0:08:10.07,0:08:11.40,Default,,0,0,0,,Дос ретінде... сіз мұны айтасыз ба?
Dialogue: 0,0:08:10.07,0:08:11.40,Default,,0,0,0,,Мен көп шай іштім.
Dialogue: 0,0:08:11.40,0:08:11.49,Default,,0,0,0,,Дос ретінде... сіз мұны айтасыз ба?
Dialogue: 0,0:08:11.49,0:08:13.74,Default,,0,0,0,,Дос ретінде... сіз мұны айтасыз ба?
Dialogue: 0,0:08:11.49,0:08:13.74,Default,,0,0,0,,Мен ең қызық көрінетінін сатып алдым.
Dialogue: 0,0:08:15.66,0:08:18.74,Default,,0,0,0,,Бірақ сіз неге кенеттен Маэхара-кунға қызығып кеттіңіз?
Dialogue: 0,0:08:21.95,0:08:23.46,Default,,0,0,0,,Өйткені ол жақсы адам!
Dialogue: 0,0:08:23.54,0:08:29.25,Default,,0,0,0,,Оның өз ойы бар, менімен сөйлескенде көзіме қарайды.
Dialogue: 0,0:08:30.67,0:08:33.26,Default,,0,0,0,,Ол аздап теңізге ұқсайды.
Dialogue: 0,0:08:35.09,0:08:36.84,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:39.56,0:08:40.39,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:08:40.47,0:08:41.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:41.93,0:08:44.27,Default,,0,0,0,,Рахмет, Макикун!
Dialogue: 0,0:08:44.77,0:08:48.02,Default,,0,0,0,,Жарайды, мен аламын!
Dialogue: 0,0:08:48.11,0:08:49.40,Default,,0,0,0,,Аму
Dialogue: 0,0:08:49.48,0:08:53.07,Default,,0,0,0,,Уау! Мынау не сонша жұмсақ?
Dialogue: 0,0:08:53.15,0:08:54.99,Default,,0,0,0,,Теңіз Бұл қауіпті.
Dialogue: 0,0:08:55.07,0:08:57.45,Default,,0,0,0,,Иә! бұл дәмді
Dialogue: 0,0:08:55.07,0:08:57.45,Default,,0,0,0,,(Ағын су дыбысы)
Dialogue: 0,0:08:57.45,0:08:57.53,Default,,0,0,0,,(Ағын су дыбысы)
Dialogue: 0,0:08:57.53,0:08:59.58,Default,,0,0,0,,(Ағын су дыбысы)
Dialogue: 0,0:08:57.53,0:08:59.58,Default,,0,0,0,,Бұл керемет, Макикун.
Dialogue: 0,0:08:59.66,0:09:02.75,Default,,0,0,0,,Мен рецепттерді қарасам да, мен сәтсіздікке ұшыраймын.
Dialogue: 0,0:09:02.83,0:09:05.16,Default,,0,0,0,,Кешке қарай іс күрделене түседі.
Dialogue: 0,0:09:05.25,0:09:06.33,Default,,0,0,0,,Ммм~
Dialogue: 0,0:09:07.00,0:09:08.00,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:09:09.71,0:09:14.09,Default,,0,0,0,,Өткен жылы ғашықтар күніне теңіздің өзі көмір жасады.
Dialogue: 0,0:09:14.17,0:09:17.22,Default,,0,0,0,,Көмір емес печенье!
Dialogue: 0,0:09:17.89,0:09:19.05,Default,,0,0,0,,Валентин?
Dialogue: 0,0:09:19.14,0:09:22.06,Default,,0,0,0,,Әй, ғашықтар күні болса да.
Dialogue: 0,0:09:22.14,0:09:25.02,Default,,0,0,0,,Қыздар жаңа ғана дос шоколадтарын алмастырды.
Dialogue: 0,0:09:25.10,0:09:27.02,Default,,0,0,0,,Көңілді болды~
Dialogue: 0,0:09:27.85,0:09:29.40,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:09:29.48,0:09:32.73,Default,,0,0,0,,Екеуі орта мектепке дейін жалпы қыздар мектебінде оқыды.
Dialogue: 0,0:09:33.61,0:09:37.66,Default,,0,0,0,,Тачибана Джоши - осы жердегі ең жақсы қыздар мектебі.
Dialogue: 0,0:09:37.74,0:09:41.66,Default,,0,0,0,,Бұл біріктірілген бастауыш, орта және жоғары мектеп білімі болуы керек.
Dialogue: 0,0:09:42.45,0:09:46.71,Default,,0,0,0,,Екеуі неге сыртқы орта мектепке барғанына таңғаламын...
Dialogue: 0,0:09:47.71,0:09:50.08,Default,,0,0,0,,(Ойын музыкасы)
Dialogue: 0,0:09:51.21,0:09:52.04,Default,,0,0,0,,Керемет
Dialogue: 0,0:09:52.96,0:09:55.84,Default,,0,0,0,,Амами-сан, сен шынымен де бүгін бірінші рет жасап тұрсың ба?
Dialogue: 0,0:09:55.92,0:09:57.17,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:57.26,0:09:59.51,Default,,0,0,0,,Мен мұны түсіндім.
Dialogue: 0,0:09:59.59,0:10:00.51,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:00.60,0:10:04.35,Default,,0,0,0,,Міне осылай~ Уми-чан, ұстап алшы~
Dialogue: 0,0:10:04.43,0:10:06.06,Default,,0,0,0,,Мына жігіт байсалды...!
Dialogue: 0,0:10:06.14,0:10:09.56,Default,,0,0,0,,Хехе, міне, осылай... мынандай...
Dialogue: 0,0:10:09.65,0:10:11.81,Default,,0,0,0,,Жүр! (ойынның шабуыл дыбысы)
Dialogue: 0,0:10:11.90,0:10:13.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:13.36,0:10:15.28,Default,,0,0,0,,Енді қандай шабуыл!
Dialogue: 0,0:10:15.36,0:10:17.11,Default,,0,0,0,,Мен оны жаңа ғана таптым.
Dialogue: 0,0:10:17.19,0:10:19.16,Default,,0,0,0,,Мұнда басыңыз, мында басыңыз!
Dialogue: 0,0:10:19.24,0:10:20.24,Default,,0,0,0,,…бұл Цезарь әлі білмейтін нәрсе.
Dialogue: 0,0:10:20.32,0:10:21.66,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,0:10:21.74,0:10:24.91,Default,,0,0,0,,Амами-сан, қайталап көріңіз.
Dialogue: 0,0:10:24.99,0:10:26.41,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:10:26.50,0:10:30.25,Default,,0,0,0,,Мұнда басыңыз, осы жерді басыңыз және түсіргіңіз келетін бағытта атыңыз...
Dialogue: 0,0:10:30.33,0:10:31.33,Default,,0,0,0,,Иә
Dialogue: 0,0:10:33.54,0:10:36.13,Default,,0,0,0,,Мазалағаным үшін кешіріңіз!
Dialogue: 0,0:10:36.21,0:10:38.22,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:38.30,0:10:39.43,Default,,0,0,0,,А, жоқ.
Dialogue: 0,0:10:39.51,0:10:40.55,Default,,0,0,0,,Не?
Dialogue: 0,0:10:40.63,0:10:42.72,Default,,0,0,0,,Мен сұрауды ұмытып кетіппін.
Dialogue: 0,0:10:42.80,0:10:47.10,Default,,0,0,0,,Мен де Маки-кунға бірдеңені емдегім келеді.
Dialogue: 0,0:10:47.18,0:10:49.77,Default,,0,0,0,,Жасауы мүмкін емес болса да, бұл бір рахат.
Dialogue: 0,0:10:49.85,0:10:53.73,Default,,0,0,0,,Мен саған айтамын, мен бұл жолы сенің соңынан ермеймін.
Dialogue: 0,0:10:53.81,0:10:55.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:55.90,0:10:58.74,Default,,0,0,0,,Менсіз мәселе жоқ
Dialogue: 0,0:10:59.45,0:11:03.16,Default,,0,0,0,,Ю Маэхара-кунмен дос болғың келеді, солай ма?
Dialogue: 0,0:11:03.24,0:11:04.83,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:06.24,0:11:07.75,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:11:07.83,0:11:09.46,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:11:10.04,0:11:11.50,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:11:11.58,0:11:13.92,Default,,0,0,0,,Маки-кун, сен осы жұмада боссың ба?
Dialogue: 0,0:11:16.05,0:11:18.63,Default,,0,0,0,,Иә, түсіндім, рахмет.
Dialogue: 0,0:11:18.71,0:11:20.47,Default,,0,0,0,,Сау бол~
Dialogue: 0,0:11:21.68,0:11:22.72,Default,,0,0,0,,Ол бос па?
Dialogue: 0,0:11:22.80,0:11:26.18,Default,,0,0,0,,Жоқ, менің ойымша, ол басқа қызға уәде берді.
Dialogue: 0,0:11:26.26,0:11:27.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:31.14,0:11:33.60,Default,,0,0,0,,Жоқ, мен смартфонымды ұмытып қалдым!
Dialogue: 0,0:11:33.69,0:11:35.82,Default,,0,0,0,,А, Макикун?
Dialogue: 0,0:11:35.90,0:11:37.40,Default,,0,0,0,,Иә, мүмкін!
Dialogue: 0,0:11:37.48,0:11:38.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:41.03,0:11:42.86,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:42.95,0:11:45.41,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:46.70,0:11:48.24,Default,,0,0,0,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:11:48.33,0:11:49.45,Default,,0,0,0,,Ngi
Dialogue: 0,0:11:50.41,0:11:51.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:53.46,0:11:55.13,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:11:56.09,0:11:59.55,Default,,0,0,0,,Мм... иә...
Dialogue: 0,0:12:08.81,0:12:10.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:10.10,0:12:14.10,Default,,0,0,0,,Өткен күні маған берген манга өте қызықты.
Dialogue: 0,0:12:14.19,0:12:15.35,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:12:15.44,0:12:19.15,Default,,0,0,0,,Үйге келе жатып, сатылымдағы соңғы томды ерте таптым. Мен оны оқуым керек пе?
Dialogue: 0,0:12:19.23,0:12:20.32,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:12:20.40,0:12:22.78,Default,,0,0,0,,Алдымен соны айт!
Dialogue: 0,0:12:22.86,0:12:26.82,Default,,0,0,0,,Ол қайда? Махараның бөлмесі? Маған оқуға рұқсат етіңіз!
Dialogue: 0,0:12:26.91,0:12:28.91,Default,,0,0,0,,Жақсы, бірақ мен оны әлі оқыған жоқпын...
Dialogue: 0,0:12:28.99,0:12:31.16,Default,,0,0,0,,Олай болса бірге оқуымыз керек.
Dialogue: 0,0:12:31.25,0:12:34.79,Default,,0,0,0,,Мен тез бөлмеме барамын! Асығыңыз, асығыңыз!
Dialogue: 0,0:12:41.63,0:12:43.55,Default,,0,0,0,,Maehara Next жақсы.
Dialogue: 0,0:12:43.63,0:12:44.63,Default,,0,0,0,,Иә
Dialogue: 0,0:12:44.72,0:12:46.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:48.14,0:12:50.39,Default,,0,0,0,,Соңында не болар екен деп ойладым.
Dialogue: 0,0:12:50.47,0:12:52.73,Default,,0,0,0,,Оның соңы бақытты болғанына қуаныштымын.
Dialogue: 0,0:12:52.81,0:12:56.23,Default,,0,0,0,,Иә, менің ойымша, патша жолы ең жақсысы.
Dialogue: 0,0:12:56.31,0:12:58.81,Default,,0,0,0,,Басынан бастап қайталап, ақырын оқыңыз
Dialogue: 0,0:12:59.48,0:13:01.03,Default,,0,0,0,,1-том Қайда?
Dialogue: 0,0:13:11.54,0:13:15.41,Default,,0,0,0,,Әй... Оқуға көңіл бөлгеніме біраз болды.
Dialogue: 0,0:13:16.50,0:13:19.42,Default,,0,0,0,,Асанаги мен кофе дайындаймын, бірақ...
Dialogue: 0,0:13:19.50,0:13:20.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:20.42,0:13:23.30,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:13:23.38,0:13:25.42,Default,,0,0,0,,Ол ұйықтап жатыр...
Dialogue: 0,0:13:28.34,0:13:31.14,Default,,0,0,0,,Бұл өте босаңсытады.
Dialogue: 0,0:13:32.68,0:13:33.68,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:43.82,0:13:47.07,Default,,0,0,0,,Оян, Маки, оян.
Dialogue: 0,0:13:48.49,0:13:50.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:50.83,0:13:56.71,Default,,0,0,0,,Хмм... Кешіріңіз Асанаги, мен де біраз ұйықтап қалдым...
Dialogue: 0,0:13:56.79,0:14:01.75,Default,,0,0,0,,Мм... Анау ана жақтағы қыз, оның аты Асанаги-сан?
Dialogue: 0,0:14:01.84,0:14:02.84,Default,,0,0,0,,Не!
Dialogue: 0,0:14:04.05,0:14:07.34,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет жұмысымды ерте аяқтадым деп ойлағанда...
Dialogue: 0,0:14:08.01,0:14:10.51,Default,,0,0,0,,Сіз маған түсіндіре аласыз, солай ма?
Dialogue: 0,0:14:11.72,0:14:13.68,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:14.18,0:14:18.89,Default,,0,0,0,,Екеуміз бірге манга оқып жатқандай болдық, жай ғана ұйықтап жатырмыз...
Dialogue: 0,0:14:18.98,0:14:22.27,Default,,0,0,0,,Жоқ, мен шамам келгенше ұйықтап қалдым...
Dialogue: 0,0:14:18.98,0:14:22.27,Default,,0,0,0,,Иә, иә, менің балам шынымен де осында...
Dialogue: 0,0:14:22.27,0:14:22.36,Default,,0,0,0,,Иә, иә, менің балам шынымен де осында...
Dialogue: 0,0:14:22.36,0:14:23.19,Default,,0,0,0,,Иә, иә, менің балам шынымен де осында...
Dialogue: 0,0:14:22.36,0:14:23.19,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:23.19,0:14:23.27,Default,,0,0,0,,Иә, иә, менің балам шынымен де осында...
Dialogue: 0,0:14:23.27,0:14:24.11,Default,,0,0,0,,Иә, иә, менің балам шынымен де осында...
Dialogue: 0,0:14:23.27,0:14:24.11,Default,,0,0,0,,Уақыт келгенде сені оятуды ойладым...
Dialogue: 0,0:14:24.11,0:14:26.44,Default,,0,0,0,,Уақыт келгенде сені оятуды ойладым...
Dialogue: 0,0:14:27.65,0:14:29.32,Default,,0,0,0,,Күткеніңізге рахмет, Уми-чан
Dialogue: 0,0:14:29.41,0:14:30.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:30.49,0:14:32.32,Default,,0,0,0,,Анаңнан.
Dialogue: 0,0:14:32.41,0:14:34.08,Default,,0,0,0,,Себебі мен рұқсат алдым
Dialogue: 0,0:14:34.16,0:14:35.16,Default,,0,0,0,,Қазірдің өзінде кеш
Dialogue: 0,0:14:35.24,0:14:37.25,Default,,0,0,0,,Бүгін менің үйімде болыңыз.
Dialogue: 0,0:14:37.33,0:14:40.00,Default,,0,0,0,,Иә?Бірақ...
Dialogue: 0,0:14:40.08,0:14:42.54,Default,,0,0,0,,Бірінші ваннаны қабылдаңыз.
Dialogue: 0,0:14:42.63,0:14:45.34,Default,,0,0,0,,Мен түнгі көйлегімді далада қалдырамын.
Dialogue: 0,0:14:45.42,0:14:48.13,Default,,0,0,0,,Ум... у...
Dialogue: 0,0:14:48.22,0:14:50.26,Default,,0,0,0,,Еш ойланбаңыз...
Dialogue: 0,0:14:52.22,0:14:54.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:59.69,0:15:00.52,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:01.65,0:15:03.36,Default,,0,0,0,,Маки
Dialogue: 0,0:15:04.52,0:15:08.61,Default,,0,0,0,,Жақында мен сенбі күні түні бойы ұйықтамай үйге келдім.
Dialogue: 0,0:15:08.69,0:15:12.45,Default,,0,0,0,,Мен оны үнемі дезодорант сияқты иіс шығарады деп ойладым.
Dialogue: 0,0:15:12.53,0:15:15.16,Default,,0,0,0,,Уми-чанды қашаннан бастап әкелдің?
Dialogue: 0,0:15:15.24,0:15:16.79,Default,,0,0,0,,Қалай айту керек...
Dialogue: 0,0:15:17.91,0:15:21.50,Default,,0,0,0,,Біз екі ай бұрын өз үйімізде ойнай бастадық.
Dialogue: 0,0:15:22.12,0:15:25.25,Default,,0,0,0,,Бірақ шын мәнінде, Асанаги жай ғана дос.
Dialogue: 0,0:15:25.34,0:15:27.34,Default,,0,0,0,,Анамды алаңдататын бірде-бір нәрсе жоқ...
Dialogue: 0,0:15:27.42,0:15:30.92,Default,,0,0,0,,Мен саған сенемін, бірақ
Dialogue: 0,0:15:31.01,0:15:35.43,Default,,0,0,0,,...
Dialogue: 0,0:15:35.51,0:15:37.47,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:15:37.56,0:15:39.27,Default,,0,0,0,,Мен ертең барып кешірім сұраймын.
Dialogue: 0,0:15:39.35,0:15:40.18,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:15:57.33,0:15:58.41,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:58.49,0:16:00.16,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:16:00.25,0:16:01.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:01.54,0:16:05.58,Default,,0,0,0,,Нағашы апам маған сәйкес келмеді.
Dialogue: 0,0:16:05.67,0:16:08.13,Default,,0,0,0,,...
Dialogue: 0,0:16:08.21,0:16:11.05,Default,,0,0,0,,Маған бәрібір...
Dialogue: 0,0:16:15.22,0:16:17.89,Default,,0,0,0,,Ой... Мен қонақ бөлмеде ұйықтап жатырмын.
Dialogue: 0,0:16:17.97,0:16:19.56,Default,,0,0,0,,Төсекті қалауыңызша пайдалана аласыз...
Dialogue: 0,0:16:19.64,0:16:21.27,Default,,0,0,0,,- (Уми) Бір минут күте тұрыңыз - (Маки) Тәубе!
Dialogue: 0,0:16:23.23,0:16:25.19,Default,,0,0,0,,Мен осы уақытқа дейін ұйықтадым, және
Dialogue: 0,0:16:25.27,0:16:28.32,Default,,0,0,0,,Жуындым, көзім мүлде босап қалды.
Dialogue: 0,0:16:30.44,0:16:32.32,Default,,0,0,0,,Кішкене сөйлесейік.
Dialogue: 0,0:16:35.24,0:16:39.37,Default,,0,0,0,,Солай бола тұра, осындай сүйкімді қызды әкелгеніме сене алар емеспін.
Dialogue: 0,0:16:39.45,0:16:42.45,Default,,0,0,0,,...
Dialogue: 0,0:16:43.29,0:16:47.04,Default,,0,0,0,,Бастапқыда бұл Асанаги ұйықтап кеткендіктен.
Dialogue: 0,0:16:47.13,0:16:49.59,Default,,0,0,0,,…
Dialogue: 0,0:16:50.59,0:16:52.01,Default,,0,0,0,,Бұл мағынасы бар.
Dialogue: 0,0:16:52.55,0:16:55.59,Default,,0,0,0,,Қыз болса да қорғансыз еді.
Dialogue: 0,0:16:55.68,0:16:57.85,Default,,0,0,0,,Мен өкінемін
Dialogue: 0,0:16:59.30,0:17:01.72,Default,,0,0,0,,Біз жаман балалармыз, солай емес пе?
Dialogue: 0,0:17:02.31,0:17:03.31,Default,,0,0,0,,Иә
Dialogue: 0,0:17:07.02,0:17:10.82,Default,,0,0,0,,…
Dialogue: 0,0:17:11.53,0:17:14.49,Default,,0,0,0,,Бұл қарым-қатынасты кешке мойындаймыз ба?
Dialogue: 0,0:17:14.57,0:17:16.95,Default,,0,0,0,,...
Dialogue: 0,0:17:17.03,0:17:20.41,Default,,0,0,0,,...
Dialogue: 0,0:17:20.49,0:17:24.00,Default,,0,0,0,,Мен уақытты тексеріп, кешке сөйлесемін.
Dialogue: 0,0:17:24.08,0:17:26.29,Default,,0,0,0,,...
Dialogue: 0,0:17:26.37,0:17:28.75,Default,,0,0,0,,...
Dialogue: 0,0:17:29.92,0:17:32.46,Default,,0,0,0,,...
Dialogue: 0,0:17:33.71,0:17:35.09,Default,,0,0,0,,１
Dialogue: 0,0:17:35.72,0:17:36.84,Default,,0,0,0,,Не?
Dialogue: 0,0:17:39.60,0:17:42.18,Default,,0,0,0,,...
Dialogue: 0,0:17:43.18,0:17:44.31,Default,,0,0,0,,Мұндағы Штрохейм — сен бетпе-бет келетін соңғы қарсыласың.
Dialogue: 0,0:17:44.98,0:17:48.94,Default,,0,0,0,,Қайта айтсам, біртүрлі.
Dialogue: 0,0:17:49.81,0:17:50.36,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:50.36,0:17:52.23,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:50.36,0:17:52.23,Default,,0,0,0,,…
Dialogue: 0,0:17:52.23,0:17:53.23,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:18:01.33,0:18:02.66,Default,,0,0,0,,...
Dialogue: 0,0:18:02.74,0:18:03.99,Default,,0,0,0,,Не!
Dialogue: 0,0:18:05.37,0:18:08.75,Default,,0,0,0,,Иә, мен келдім. Бұл менің үйім.
Dialogue: 0,0:18:08.83,0:18:10.29,Default,,0,0,0,,О...
Dialogue: 0,0:18:12.63,0:18:13.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:13.84,0:18:16.05,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:19.76,0:18:22.26,Default,,0,0,0,,…
Dialogue: 0,0:18:23.51,0:18:25.93,Default,,0,0,0,,Теңізге қош келдіңіз
Dialogue: 0,0:18:26.02,0:18:29.23,Default,,0,0,0,,…
Dialogue: 0,0:18:29.31,0:18:32.90,Default,,0,0,0,,... Танысқаныма қуаныштымын, мен Маки Маэхарамын.
Dialogue: 0,0:18:32.98,0:18:36.53,Default,,0,0,0,,Уфуфу мейірімділігіңіз үшін рахмет.
Dialogue: 0,0:18:36.61,0:18:38.61,Default,,0,0,0,,Мен Асанаги Сорамын
Dialogue: 0,0:18:38.70,0:18:42.12,Default,,0,0,0,,Ынық көрмей, мен сол жердегі бұзық қыздың анасымын.
Dialogue: 0,0:18:42.20,0:18:43.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:45.33,0:18:46.62,Default,,0,0,0,,Әй, теңіз
Dialogue: 0,0:18:46.70,0:18:50.21,Default,,0,0,0,,Мен сені ойнамау керек деп айтпаймын.
Dialogue: 0,0:18:50.29,0:18:53.59,Default,,0,0,0,,Тек айту керек нәрсені айтыңыз
Dialogue: 0,0:18:53.67,0:18:55.84,Default,,0,0,0,,Мазасыздық тудырмау
Dialogue: 0,0:18:55.92,0:18:57.38,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:18:57.46,0:19:02.51,Default,,0,0,0,,Иә, кешіріңіз. Келесі жолы мұқият боламын.
Dialogue: 0,0:19:02.59,0:19:04.39,Default,,0,0,0,,Мен де сақ боламын
Dialogue: 0,0:19:04.47,0:19:05.93,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:06.01,0:19:07.98,Default,,0,0,0,,Сонымен, Маэхара-кун
Dialogue: 0,0:19:08.06,0:19:11.02,Default,,0,0,0,,Менің мұхитыммен қалай дос болдың?
Dialogue: 0,0:19:11.10,0:19:11.94,Default,,0,0,0,,Эй!
Dialogue: 0,0:19:12.02,0:19:13.77,Default,,0,0,0,,Мен теңізді сұраймын
Dialogue: 0,0:19:13.86,0:19:17.53,Default,,0,0,0,,Анам маған оның оған қатысы жоқ екенін айтқан жоқ.
Dialogue: 0,0:19:17.61,0:19:18.99,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:19.07,0:19:21.45,Default,,0,0,0,,Маэхара! Оны айтудың қажеті жоқ!
Dialogue: 0,0:19:21.53,0:19:24.32,Default,,0,0,0,,Қараңызшы, бұл былай~
Dialogue: 0,0:19:24.41,0:19:28.45,Default,,0,0,0,,Бұл менің қызымның бірінші жігіті.
Dialogue: 0,0:19:28.54,0:19:30.62,Default,,0,0,0,,Сізге бұл таныс па?
Dialogue: 0,0:19:30.71,0:19:34.00,Default,,0,0,0,,Бұл әңгіме де маңызды емес, сондықтан жақсы!
Dialogue: 0,0:19:34.08,0:19:35.00,Default,,0,0,0,,Қараңызшы, Маэхара да.
Dialogue: 0,0:19:35.09,0:19:38.17,Default,,0,0,0,,Ондай кемпірмен айналысудың қажеті жоқ!
Dialogue: 0,0:19:39.72,0:19:42.09,Default,,0,0,0,,Одан да шабдалы же, шабдалы.
Dialogue: 0,0:19:42.18,0:19:44.09,Default,,0,0,0,,Өйткені ол тәтті және дәмді
Dialogue: 0,0:19:44.18,0:19:45.35,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:19:45.43,0:19:47.47,Default,,0,0,0,,Әй, ебедейсіз болсаң да
Dialogue: 0,0:19:47.56,0:19:50.43,Default,,0,0,0,,Оны өзіңіз аршып алғаныңыз дұрыс емес пе?
Dialogue: 0,0:19:50.52,0:19:51.48,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:19:53.44,0:19:54.31,Default,,0,0,0,,Маэхара-кун
Dialogue: 0,0:19:55.52,0:19:58.48,Default,,0,0,0,,Теңіз туралы Әрқашан қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:19:58.57,0:20:01.24,Default,,0,0,0,,Ол сондай болуы мүмкін, бірақ шын мәнінде ол жақсы қыз.
Dialogue: 0,0:20:04.11,0:20:05.24,Default,,0,0,0,,Иә
Dialogue: 0,0:20:05.32,0:20:06.53,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:07.49,0:20:10.50,Default,,0,0,0,,А, қарсы болмасаң, осында қалғың келе ме?
Dialogue: 0,0:20:10.58,0:20:14.58,Default,,0,0,0,,Бұл жағдайда мен оны қарап шыға алатыныма сенімді бола аласыз.
Dialogue: 0,0:20:14.67,0:20:17.25,Default,,0,0,0,,Иә, бұл жақсы идея.
Dialogue: 0,0:20:18.21,0:20:22.01,Default,,0,0,0,,Маэхара! Мен саған рұқсат беремін, аузыңды тігіп ал!
Dialogue: 0,0:20:22.09,0:20:25.01,Default,,0,0,0,,Маэхара-кун, маған көмектесші
Dialogue: 0,0:20:25.09,0:20:26.97,Default,,0,0,0,,Теңіз қорқынышты
Dialogue: 0,0:20:27.05,0:20:28.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:28.51,0:20:30.89,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:20:32.64,0:20:35.35,Default,,0,0,0,,Барлығына белгілі.
Dialogue: 0,0:20:35.44,0:20:38.23,Default,,0,0,0,,Келесі айда мектеп фестивалі болады.
Dialogue: 0,0:20:38.32,0:20:41.57,Default,,0,0,0,,Бүгін мен атқару комитеті туралы шешім қабылдаймын.
Dialogue: 0,0:20:41.65,0:20:43.32,Default,,0,0,0,,Иә... шын ба?
Dialogue: 0,0:20:43.40,0:20:45.66,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:20:46.53,0:20:48.62,Default,,0,0,0,,... жоқ па?
Dialogue: 0,0:20:49.70,0:20:54.58,Default,,0,0,0,,Мен солай ойладым. Мұғалім, мен лотерея билетін дайындап қойдым!
Dialogue: 0,0:20:57.13,0:21:00.34,Default,,0,0,0,,Мұғалім, мен дұрыс түсіндім...
Dialogue: 0,0:21:00.42,0:21:02.17,Default,,0,0,0,,Иә иә
Dialogue: 0,0:21:02.76,0:21:04.72,Default,,0,0,0,,Олай болса, ер адамдар атқару комитетінің мүшелері
Dialogue: 0,0:21:04.80,0:21:06.72,Default,,0,0,0,,Мен Маэхара-кун туралы шешім қабылдадым.
Dialogue: 0,0:21:06.80,0:21:07.64,Default,,0,0,0,,(бормен жазу дыбысы)
Dialogue: 0,0:21:07.72,0:21:11.43,Default,,0,0,0,,Бейшара қыздар, олар өте кедей адамдар.
Dialogue: 0,0:21:11.52,0:21:13.77,Default,,0,0,0,,Бұл шын мәнінде Маэхараның тұмары, солай ма?
Dialogue: 0,0:21:14.81,0:21:17.48,Default,,0,0,0,,Жиналыста сөйлей алмайды ма?
Dialogue: 0,0:21:17.56,0:21:18.52,Default,,0,0,0,,(Ұлдардың күлкісі)
Dialogue: 0,0:21:18.52,0:21:21.36,Default,,0,0,0,,(Ұлдардың күлкісі)
Dialogue: 0,0:21:18.52,0:21:21.36,Default,,0,0,0,,Не? Ол Ючинді ұнататынын айтты.
Dialogue: 0,0:21:23.03,0:21:25.03,Default,,0,0,0,,Келме, Келме
Dialogue: 0,0:21:25.11,0:21:26.53,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:26.61,0:21:28.16,Default,,0,0,0,,Жарайды, ұтыласың!
Dialogue: 0,0:21:26.61,0:21:28.16,Default,,0,0,0,,Мен осылай болады деп күткенмін, бірақ...
Dialogue: 0,0:21:28.16,0:21:28.24,Default,,0,0,0,,Мен осылай болады деп күткенмін, бірақ...
Dialogue: 0,0:21:28.24,0:21:29.49,Default,,0,0,0,,Мен осылай болады деп күткенмін, бірақ...
Dialogue: 0,0:21:28.24,0:21:29.49,Default,,0,0,0,,Иә~
Dialogue: 0,0:21:29.57,0:21:31.54,Default,,0,0,0,,Сәттілік.
Dialogue: 0,0:21:31.62,0:21:32.45,Default,,0,0,0,,Иә Қауіпсіз
Dialogue: 0,0:21:32.54,0:21:34.96,Default,,0,0,0,,Мен күткен едім, бірақ...
Dialogue: 0,0:21:35.04,0:21:37.92,Default,,0,0,0,,Аа, сіз қателесесіз.
Dialogue: 0,0:21:46.34,0:21:48.39,Default,,0,0,0,,Не болды? Амами мырза
Dialogue: 0,0:21:48.47,0:21:51.72,Default,,0,0,0,,Иә, менің бәріне айтқым келетін бір нәрсе бар.
Dialogue: 0,0:21:54.77,0:21:58.65,Default,,0,0,0,,Эй, бәрің Маэхара-кунды жек көресіңдер ме?
Dialogue: 0,0:22:06.03,0:22:09.07,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.95,0:23:35.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:38.12,0:23:39.91,Default,,0,0,0,,«Футари мәдени фестивалі»
Dialogue: 0,0:23:41.41,0:23:47.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory