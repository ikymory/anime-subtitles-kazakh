Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:07.38,Default,,0,0,0,,Үлкен зал
Dialogue: 0,0:00:07.46,0:00:10.55,Default,,0,0,0,,Бұл адаммен қақтығысуға болмайды.
Dialogue: 0,0:00:10.63,0:00:13.01,Default,,0,0,0,,Ах, бұл үлкен қысымның реті.
Dialogue: 0,0:00:13.09,0:00:14.18,Default,,0,0,0,,Абайсыз қозғала алмау
Dialogue: 0,0:00:17.85,0:00:20.56,Default,,0,0,0,,Бұлай күресуге болмайды.
Dialogue: 0,0:00:20.64,0:00:21.47,Default,,0,0,0,,Ұйқыға кетіңіз
Dialogue: 0,0:00:24.77,0:00:26.23,Default,,0,0,0,,Хехе, бұл жаман.
Dialogue: 0,0:00:26.31,0:00:28.94,Default,,0,0,0,,Енді мен жұмысқа барайын ба?
Dialogue: 0,0:00:30.48,0:00:31.86,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:00:35.78,0:00:38.32,Default,,0,0,0,,Сонымен... бөгет бұзылды ма?
Dialogue: 0,0:00:38.95,0:00:39.58,Default,,0,0,0,,Дионың Рух толқынының шынайы табиғатын қалай ашуға болады
Dialogue: 0,0:00:39.66,0:00:40.66,Default,,0,0,0,,Мен оны… есептей алмаймын.
Dialogue: 0,0:00:40.74,0:00:42.70,Default,,0,0,0,,Ол әйелдің керегі жоқ.
Dialogue: 0,0:00:43.20,0:00:44.41,Default,,0,0,0,,Дене қуыршақ
Dialogue: 0,0:00:48.04,0:00:48.79,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:48.88,0:00:51.30,Default,,0,0,0,,Кяаааааааааа!
Dialogue: 0,0:00:51.38,0:00:52.17,Default,,0,0,0,,Амелия!
Dialogue: 0,0:00:54.38,0:00:56.59,Default,,0,0,0,,А... мені өлтірме.
Dialogue: 0,0:00:57.09,0:00:58.72,Default,,0,0,0,,Тасымалдауды сәл жеңілдетті.
Dialogue: 0,0:00:59.39,0:01:00.10,Default,,0,0,0,,Амелия!
Dialogue: 0,0:01:00.18,0:01:01.26,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:01:01.35,0:01:01.93,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:01:02.02,0:01:03.68,Default,,0,0,0,,Практикалық емтиханға келесі қай команда шығады екен?
Dialogue: 0,0:01:03.77,0:01:06.44,Default,,0,0,0,,Көзіңіздің нашар көретінін білесіз бе?
Dialogue: 0,0:01:06.94,0:01:09.40,Default,,0,0,0,,Сіз мені өлтіретін сияқтысыз.
Dialogue: 0,0:01:11.48,0:01:12.28,Default,,0,0,0,,Иә
Dialogue: 0,0:01:14.49,0:01:16.49,Default,,0,0,0,,♪～
Dialogue: 0,0:02:41.32,0:02:43.32,Default,,0,0,0,,～♪
Dialogue: 0,0:02:47.29,0:02:50.46,Default,,0,0,0,,Мырза... арандатушылықты пайдаланба.
Dialogue: 0,0:02:51.29,0:02:53.92,Default,,0,0,0,,Мен жынды болып кете ме деп қатты уайымдап отырмын.
Dialogue: 0,0:02:54.00,0:02:55.92,Default,,0,0,0,,Жеңіске жету мүмкіндігі аз екенін түсінемін.
Dialogue: 0,0:02:56.42,0:02:58.46,Default,,0,0,0,,Амелияны үйге әкелуге басымдық беріңіз.
Dialogue: 0,0:02:58.55,0:03:00.22,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:03:00.30,0:03:04.47,Default,,0,0,0,,Мені ханшайымды ұрлауға жібереді деп ойламадым.
Dialogue: 0,0:03:04.55,0:03:05.14,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:03:10.73,0:03:12.31,Default,,0,0,0,,Кедергі сиқырлы шеңбер?
Dialogue: 0,0:03:13.02,0:03:16.73,Default,,0,0,0,,Қашқан адамды қуу қиын, шаршатады.
Dialogue: 0,0:03:17.36,0:03:20.28,Default,,0,0,0,,Не істеу керек? Мен жай ғана көлеңкелі сиқырды қолдандым.
Dialogue: 0,0:03:20.36,0:03:21.91,Default,,0,0,0,,Сіз толық қуатыңызды пайдалана алмайсыз.
Dialogue: 0,0:03:22.41,0:03:24.20,Default,,0,0,0,,Бар-жоғын жасыру да жұмыс істемеуі мүмкін.
Dialogue: 0,0:03:25.95,0:03:26.95,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:03:27.45,0:03:30.00,Default,,0,0,0,,Ода/Акираның «Одасы» Нобунагадан алынған ба?
Dialogue: 0,0:03:30.08,0:03:32.04,Default,,0,0,0,,Әлде шағын күріш алқабы?
Dialogue: 0,0:03:32.54,0:03:33.08,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:03:34.29,0:03:35.88,Default,,0,0,0,,Шынымен…
Dialogue: 0,0:03:35.96,0:03:37.80,Default,,0,0,0,,Иә
Dialogue: 0,0:03:37.88,0:03:42.88,Default,,0,0,0,,Мен сендерден сәл өзгешемін, бірақ мен де осында келгенге дейін Жапонияда болдым.
Dialogue: 0,0:03:42.97,0:03:44.72,Default,,0,0,0,,Аты - Махиро Абэ
Dialogue: 0,0:03:45.22,0:03:47.64,Default,,0,0,0,,Рахмет айтқым келмейді, бірақ өтінемін
Dialogue: 0,0:03:47.72,0:03:49.27,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:03:49.77,0:03:50.81,Default,,0,0,0,,Неге жын болу керек?
Dialogue: 0,0:03:50.89,0:03:54.69,Default,,0,0,0,,Онда мен сені өлтіріп, ханшайымыңды аламын.
Dialogue: 0,0:03:55.19,0:03:58.11,Default,,0,0,0,,Мен сәлем бердім, бірақ қоштасатын кез келді.
Dialogue: 0,0:03:58.19,0:03:59.03,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:04:02.28,0:04:03.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:03.28,0:04:03.86,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:03.95,0:04:06.37,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:04:07.78,0:04:09.04,Default,,0,0,0,,Туған сәтіңнен бастап ерекше болғансың ғой.
Dialogue: 0,0:04:11.12,0:04:12.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:15.92,0:04:17.21,Default,,0,0,0,,Көлеңке сиқыры іске қосылды!
Dialogue: 0,0:04:22.59,0:04:25.34,Default,,0,0,0,,Мм... Қызық сиқыр.
Dialogue: 0,0:04:25.43,0:04:26.68,Default,,0,0,0,,Бірақ анық
Dialogue: 0,0:04:26.76,0:04:30.01,Default,,0,0,0,,Сиқырдың жоқтығынан бұл энергияны үнемдейтін көлік жүргізу сияқты.
Dialogue: 0,0:04:30.10,0:04:31.27,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:31.85,0:04:35.60,Default,,0,0,0,,Мен барымды бергенде не болатынын көргім келетінін сеземін.
Dialogue: 0,0:04:35.69,0:04:39.86,Default,,0,0,0,,Жарайды, көп ойнасаң, ашуланасың.
Dialogue: 0,0:04:41.40,0:04:43.49,Default,,0,0,0,,Оңай ұлғайту
Dialogue: 0,0:04:43.57,0:04:47.32,Default,,0,0,0,,Қалғандардың арқасында менің сиқырлы күшім біршама қалпына келді.
Dialogue: 0,0:04:48.53,0:04:49.16,Default,,0,0,0,,Yoru…
Dialogue: 0,0:04:49.24,0:04:51.08,Default,,0,0,0,,Қара мысық
Dialogue: 0,0:04:51.58,0:04:53.12,Default,,0,0,0,,Сіз енді толықтайсыз
Dialogue: 0,0:04:53.20,0:04:55.42,Default,,0,0,0,,Сол лагерьде болу дұрыс па?
Dialogue: 0,0:04:55.50,0:04:56.87,Default,,0,0,0,,Менің атым «Түн»
Dialogue: 0,0:04:57.38,0:05:00.80,Default,,0,0,0,,Менің Жын патшасына қайтып бару ойым жоқ.
Dialogue: 0,0:05:02.88,0:05:06.13,Default,,0,0,0,,Мырза, мен қожайын-қызметші келісімшартын бұзғым келеді.
Dialogue: 0,0:05:08.30,0:05:11.22,Default,,0,0,0,,Екі тарап келіссе бірден мүмкін
Dialogue: 0,0:05:11.31,0:05:12.39,Default,,0,0,0,,Бірақ егер біз мұнда сүрінсек, Құрылтайшы Титанға қарсы ешқашан мүмкіндігіміз болмайды.
Dialogue: 0,0:05:13.02,0:05:17.02,Default,,0,0,0,,Мен бұл кісіні бетінен пышақ сұғу арқылы жеңе аламын.
Dialogue: 0,0:05:17.10,0:05:19.48,Default,,0,0,0,,Иеміз өлмейді.
Dialogue: 0,0:05:20.15,0:05:21.48,Default,,0,0,0,,Мен сенің өлуге жол бермеймін!
Dialogue: 0,0:05:21.57,0:05:22.44,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:05:24.99,0:05:28.36,Default,,0,0,0,,Не? Сіз тіпті жасырын сөйлесесіз бе?
Dialogue: 0,0:05:28.45,0:05:29.87,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:29.95,0:05:32.83,Default,,0,0,0,,Бұл соңғысы, сондықтан біткенше күтемін.
Dialogue: 0,0:05:38.83,0:05:41.00,Default,,0,0,0,,Мен жеңу мүмкіндігі жоқ деп ойладым.
Dialogue: 0,0:05:41.09,0:05:43.38,Default,,0,0,0,,Екі адам болса, әйтеуір бір нәтиже шығар.
Dialogue: 0,0:05:44.05,0:05:46.01,Default,,0,0,0,,Менің өмірім саған байланысты
Dialogue: 0,0:05:46.51,0:05:47.88,Default,,0,0,0,,Сіз де маған бәс тігесіз!
Dialogue: 0,0:05:47.97,0:05:49.55,Default,,0,0,0,,Сіз ақылсыз ештеңе жасамайсыз деп үміттенемін.
Dialogue: 0,0:05:49.64,0:05:51.10,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:05:51.18,0:05:52.81,Default,,0,0,0,,Мен бұл туралы ұмытып кеттім.
Dialogue: 0,0:05:53.31,0:05:56.56,Default,,0,0,0,,Ұмытшақ қожайын болса, қиналады.
Dialogue: 0,0:05:59.23,0:05:59.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:06.28,0:06:07.45,Default,,0,0,0,,Я~
Dialogue: 0,0:06:07.53,0:06:10.45,Default,,0,0,0,,Марқұм данышпан Саран Мисрей.
Dialogue: 0,0:06:11.07,0:06:14.20,Default,,0,0,0,,Бұл сізге қарсы тұра алатын жалғыз өзгеріс.
Dialogue: 0,0:06:14.79,0:06:17.71,Default,,0,0,0,,Негізгі зал Бұл көрініс ұзақ уақытқа созылады
Dialogue: 0,0:06:18.21,0:06:19.67,Default,,0,0,0,,Барлығын бірден аяқтаймын.
Dialogue: 0,0:06:21.25,0:06:22.13,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:06:26.21,0:06:28.17,Default,,0,0,0,,Менің денем – қылыш
Dialogue: 0,0:06:28.26,0:06:31.84,Default,,0,0,0,,Қожайынымның жауларына нұрдың балғасы!
Dialogue: 0,0:06:34.93,0:06:37.06,Default,,0,0,0,,Цк... Бұл үлкен дайындық.
Dialogue: 0,0:06:38.60,0:06:39.23,Default,,0,0,0,,Жеңіл балға!
Dialogue: 0,0:06:40.56,0:06:41.98,Default,,0,0,0,,Алтын жарық
Dialogue: 0,0:06:47.65,0:06:49.07,Default,,0,0,0,,Жарық көлеңкені күшейтеді...
Dialogue: 0,0:06:49.15,0:06:50.74,Default,,0,0,0,,Йору! Барайық!
Dialogue: 0,0:06:51.32,0:06:52.24,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:06:57.12,0:06:58.04,Default,,0,0,0,,Найзағай патшасы
Dialogue: 0,0:07:06.67,0:07:07.71,Default,,0,0,0,,Көлеңкемен жабылған!
Dialogue: 0,0:07:20.43,0:07:20.94,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:27.69,0:07:28.65,Default,,0,0,0,,—умеренділермен қақтығысып жатыр.
Dialogue: 0,0:07:32.82,0:07:33.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:39.50,0:07:42.21,Default,,0,0,0,,Көсем Саран тірі болса...
Dialogue: 0,0:07:43.04,0:07:46.79,Default,,0,0,0,,Бәлкім, осылай бірге күресетін шығармыз.
Dialogue: 0,0:07:47.80,0:07:50.21,Default,,0,0,0,,Осыны ойласам, өзімді жалғыз сезінемін.
Dialogue: 0,0:07:51.09,0:07:52.22,Default,,0,0,0,,Мен Йоруға ренжідім.
Dialogue: 0,0:07:53.26,0:07:56.22,Default,,0,0,0,,Осы сәтте мен шайқастың қызығына бөлендім.
Dialogue: 0,0:07:58.31,0:08:00.18,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,0:08:01.18,0:08:03.10,Default,,0,0,0,,Трансформация жақын арада шешіледі.
Dialogue: 0,0:08:03.19,0:08:04.98,Default,,0,0,0,,Мәселе жоқ, келесіні шешіңіз
Dialogue: 0,0:08:05.06,0:08:07.98,Default,,0,0,0,,Аа... Мені бұрышқа алмақшысың ба?
Dialogue: 0,0:08:09.44,0:08:11.78,Default,,0,0,0,,Сиқырлы шеңбер де сатылып кеткен сияқты.
Dialogue: 0,0:08:11.86,0:08:13.20,Default,,0,0,0,,Үлкен зал
Dialogue: 0,0:08:13.28,0:08:14.36,Default,,0,0,0,,О
Dialogue: 0,0:08:14.45,0:08:14.95,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:08:15.95,0:08:18.78,Default,,0,0,0,,Қолымды… арқанмен байла.
Dialogue: 0,0:08:21.41,0:08:22.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:27.79,0:08:30.42,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:08:36.43,0:08:38.39,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:08:40.39,0:08:41.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:41.81,0:08:42.68,Default,,0,0,0,,Раббым!
Dialogue: 0,0:08:42.77,0:08:43.89,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:44.52,0:08:48.77,Default,,0,0,0,,Жоооу!
Dialogue: 0,0:08:54.32,0:08:56.03,Default,,0,0,0,,Ах... Акира...
Dialogue: 0,0:08:56.70,0:08:58.78,Default,,0,0,0,,Кешіріңіз, а...
Dialogue: 0,0:08:58.87,0:09:00.58,Default,,0,0,0,,Кешіріңіз, ааа...
Dialogue: 0,0:09:00.66,0:09:01.91,Default,,0,0,0,,Ием!
Dialogue: 0,0:09:02.45,0:09:04.50,Default,,0,0,0,,Акира... Акира!
Dialogue: 0,0:09:04.58,0:09:06.21,Default,,0,0,0,,Бұл туралы уайымдамаңыз...
Dialogue: 0,0:09:06.71,0:09:08.88,Default,,0,0,0,,Бұл Амелия кінәлі емес...
Dialogue: 0,0:09:09.46,0:09:11.67,Default,,0,0,0,,Бастапқыда ол шығарған сиқырлы шеңбер болды ма?
Dialogue: 0,0:09:11.75,0:09:13.46,Default,,0,0,0,,Иә
Dialogue: 0,0:09:13.55,0:09:19.01,Default,,0,0,0,,Дене қуыршақ өзі басқаратын адамның әлеуетін 100% шығарады.
Dialogue: 0,0:09:19.10,0:09:22.18,Default,,0,0,0,,Сіз менің мәртебемді одан әрі арттыра аласыз.
Dialogue: 0,0:09:22.27,0:09:23.18,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,0:09:23.68,0:09:25.85,Default,,0,0,0,,Мен әлі өле алмаймын
Dialogue: 0,0:09:26.35,0:09:29.65,Default,,0,0,0,,Амелияны өзіммен бірге ала кетейін... жоқ.
Dialogue: 0,0:09:30.23,0:09:31.61,Default,,0,0,0,,Акира... Акира!
Dialogue: 0,0:09:31.69,0:09:33.19,Default,,0,0,0,,Суық...
Dialogue: 0,0:09:33.28,0:09:35.90,Default,,0,0,0,,Әлі ештеңе жасалған жоқ.
Dialogue: 0,0:09:35.99,0:09:36.82,Default,,0,0,0,,Ием!
Dialogue: 0,0:09:37.41,0:09:38.78,Default,,0,0,0,,Акира! Жоқ!
Dialogue: 0,0:09:38.86,0:09:40.41,Default,,0,0,0,,Өлуге болмайды
Dialogue: 0,0:09:40.91,0:09:43.29,Default,,0,0,0,,Кек көшбасшысы Саранның өлімі
Dialogue: 0,0:09:44.29,0:09:46.58,Default,,0,0,0,,Үйге қайт...
Dialogue: 0,0:09:49.67,0:09:52.25,Default,,0,0,0,,Негізгі зақым төзімділіктен асып түседі
Dialogue: 0,0:09:52.75,0:09:54.51,Default,,0,0,0,,Көлеңкелік сиқырды мәжбүрлеп қосу
Dialogue: 0,0:09:55.01,0:09:56.17,Default,,0,0,0,,«Емдеу» режимі
Dialogue: 0,0:09:57.13,0:09:57.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:57.93,0:09:59.05,Default,,0,0,0,,Сол кездегідей...
Dialogue: 0,0:09:59.14,0:10:01.05,Default,,0,0,0,,Ол қыңыр жігіт.
Dialogue: 0,0:10:03.51,0:10:04.27,Default,,0,0,0,,Чи…
Dialogue: 0,0:10:06.06,0:10:07.48,Default,,0,0,0,,Емдеу аяқталды
Dialogue: 0,0:10:10.10,0:10:11.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:13.07,0:10:13.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:14.73,0:10:16.11,Default,,0,0,0,,Неліктен тұру керек?
Dialogue: 0,0:10:16.74,0:10:18.32,Default,,0,0,0,,«Жауынгерлік» режимі
Dialogue: 0,0:10:18.82,0:10:21.82,Default,,0,0,0,,«Жын Махиро Абэ» нысанасы
Dialogue: 0,0:10:21.91,0:10:23.91,Default,,0,0,0,,«Сиқыршы» кәсібі
Dialogue: 0,0:10:25.04,0:10:26.33,Default,,0,0,0,,Незуко мені құтқарды ма? Рақмет.
Dialogue: 0,0:10:26.41,0:10:28.37,Default,,0,0,0,,Ұрыстың басталуы
Dialogue: 0,0:10:30.33,0:10:31.50,Default,,0,0,0,,Өл.
Dialogue: 0,0:10:34.71,0:10:35.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:37.72,0:10:38.76,Default,,0,0,0,,Камаитачи!
Dialogue: 0,0:10:40.68,0:10:41.72,Default,,0,0,0,,Байланыстырушы көлеңке
Dialogue: 0,0:10:43.80,0:10:44.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:44.93,0:10:47.98,Default,,0,0,0,,Сізді бірдеңе басқарып жатыр ма?
Dialogue: 0,0:10:48.06,0:10:49.60,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:10:49.69,0:10:53.02,Default,,0,0,0,,Амелия Роуз Кварцқа жасалған заклинанияны жою
Dialogue: 0,0:10:53.11,0:10:55.23,Default,,0,0,0,,Содан кейін дереу шығу
Dialogue: 0,0:10:55.32,0:10:58.90,Default,,0,0,0,,Бұл ұсыныс па? Менің артымнан еру мүмкін емес.
Dialogue: 0,0:10:59.40,0:11:03.12,Default,,0,0,0,,Сіз адамдар, әрине, жын-перілерге тең келе алмайсыз.
Dialogue: 0,0:11:03.62,0:11:05.99,Default,,0,0,0,,Бұл сөзсіз және белгіленген.
Dialogue: 0,0:11:06.49,0:11:08.45,Default,,0,0,0,,Өз еркімен шешім қабылдамаңыз
Dialogue: 0,0:11:08.95,0:11:11.71,Default,,0,0,0,,Еңбег әрқашан нәтиже бермейді.
Dialogue: 0,0:11:12.21,0:11:15.13,Default,,0,0,0,,Бұл сондай мейірімді дүние емес.
Dialogue: 0,0:11:15.21,0:11:16.50,Default,,0,0,0,,Алайда
Dialogue: 0,0:11:16.59,0:11:19.84,Default,,0,0,0,,Тіпті тырыспай-ақ бас тарту дұрыс емес.
Dialogue: 0,0:11:19.92,0:11:22.22,Default,,0,0,0,,Маған дәріс берме, ақымақ!
Dialogue: 0,0:11:22.30,0:11:23.64,Default,,0,0,0,,Су инесі!
Dialogue: 0,0:11:26.68,0:11:27.85,Default,,0,0,0,,Амелия ханым!
Dialogue: 0,0:11:27.93,0:11:29.14,Default,,0,0,0,,Менің аяғым қозғалмайды!
Dialogue: 0,0:11:29.23,0:11:31.14,Default,,0,0,0,,Жүр, маған көмектесіп өл.
Dialogue: 0,0:11:31.23,0:11:32.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:32.23,0:11:34.15,Default,,0,0,0,,Әй... Амелия!
Dialogue: 0,0:11:35.11,0:11:36.11,Default,,0,0,0,,Амелия!
Dialogue: 0,0:11:50.71,0:11:51.83,Default,,0,0,0,,Алайда, кейбір қарсыластар қашып кетті
Dialogue: 0,0:11:52.58,0:11:53.33,Default,,0,0,0,,Қарға мырза...
Dialogue: 0,0:11:53.42,0:11:55.58,Default,,0,0,0,,Қарға... мұнда неге келдің?
Dialogue: 0,0:11:58.17,0:12:02.63,Default,,0,0,0,,Аңдардың өмір сүру ұзақтығы адамдарға қарағанда шамамен 100 жылға артық, солай ма?
Dialogue: 0,0:12:03.13,0:12:04.72,Default,,0,0,0,,Неліктен әлі бас тартпадың?
Dialogue: 0,0:12:05.39,0:12:07.39,Default,,0,0,0,,Өзінің гүлденген кезіндегідей жақсы болмаса да.
Dialogue: 0,0:12:07.47,0:12:09.93,Default,,0,0,0,,Мен де онша әлсіз емеспін.
Dialogue: 0,0:12:10.02,0:12:11.35,Default,,0,0,0,,Эй, Зекро
Dialogue: 0,0:12:11.85,0:12:14.85,Default,,0,0,0,,Менің барлық сиқырымды бір сәтте жойыңыз
Dialogue: 0,0:12:17.06,0:12:19.15,Default,,0,0,0,,Мен оны бүгін елемеймін.
Dialogue: 0,0:12:19.23,0:12:21.24,Default,,0,0,0,,Бұл сызық.
Dialogue: 0,0:12:21.32,0:12:24.16,Default,,0,0,0,,Мен ол сиқырлы шеңберді өшірмеймін.
Dialogue: 0,0:12:31.70,0:12:32.66,Default,,0,0,0,,Қарға мырза
Dialogue: 0,0:12:33.79,0:12:36.83,Default,,0,0,0,,Мен сені келеді деп ойламаппын.
Dialogue: 0,0:12:36.92,0:12:39.25,Default,,0,0,0,,Бұл тұйыққа тіреледі.
Dialogue: 0,0:12:39.34,0:12:42.84,Default,,0,0,0,,Сенің жүзің кең екен, Қарға.
Dialogue: 0,0:12:44.22,0:12:47.01,Default,,0,0,0,,Сен сол жын мен Риамен таныссың ба?
Dialogue: 0,0:12:47.09,0:12:48.97,Default,,0,0,0,,Сізге біраз демалу керек.
Dialogue: 0,0:12:49.47,0:12:52.98,Default,,0,0,0,,А, мен мұны істейін ...
Dialogue: 0,0:12:53.06,0:12:54.14,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:13:00.02,0:13:00.61,Default,,0,0,0,,Хм. Арнайы дәрежелі Шинохарадан осы мүмкіндікті де тексертуді қалаймын
Dialogue: 0,0:13:01.65,0:13:02.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:04.90,0:13:07.49,Default,,0,0,0,,Бұл жолы қанша ұйықтадыңыз?
Dialogue: 0,0:13:07.57,0:13:09.58,Default,,0,0,0,,3 күн 5 сағат.
Dialogue: 0,0:13:10.83,0:13:12.41,Default,,0,0,0,,Мен тағы да көп ұйықтадым.
Dialogue: 0,0:13:12.91,0:13:16.50,Default,,0,0,0,,Бірақ бұрынғыдай емес, Амелия осында.
Dialogue: 0,0:13:17.58,0:13:18.38,Default,,0,0,0,,Акира…
Dialogue: 0,0:13:21.63,0:13:22.80,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:22.88,0:13:24.38,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:13:25.76,0:13:28.09,Default,,0,0,0,,Сіздің арқаңызда мен өмірімді сақтап қалдым.
Dialogue: 0,0:13:28.93,0:13:29.68,Default,,0,0,0,,Лия ше?
Dialogue: 0,0:13:29.76,0:13:32.68,Default,,0,0,0,,Мен қауіпсізмін. Мен патша сарайына оралдым.
Dialogue: 0,0:13:33.18,0:13:34.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:34.85,0:13:37.27,Default,,0,0,0,,Кездессем, саған бас иемін.
Dialogue: 0,0:13:37.85,0:13:39.19,Default,,0,0,0,,Мен кіруге қарсы емеспін.
Dialogue: 0,0:13:41.77,0:13:43.94,Default,,0,0,0,,Балалар... мұнда неге келдіңдер?
Dialogue: 0,0:13:47.07,0:13:48.95,Default,,0,0,0,,Әй, біраз уақыт болды!
Dialogue: 0,0:13:49.03,0:13:51.91,Default,,0,0,0,,Мен Қарға мырзаның ескі танысымын.
Dialogue: 0,0:13:51.99,0:13:55.16,Default,,0,0,0,,Батырлар тобы да бір қалыпты деңгейге көтерілуде.
Dialogue: 0,0:13:55.25,0:13:57.92,Default,,0,0,0,,Мен лайықты қару іздеп келдім.
Dialogue: 0,0:13:58.54,0:14:00.54,Default,,0,0,0,,Акира, мен сені кездестірдім.
Dialogue: 0,0:14:01.13,0:14:01.84,Default,,0,0,0,,О
Dialogue: 0,0:14:02.34,0:14:04.55,Default,,0,0,0,,Киосуке және басқалары да патша сарайынан шықты ма?
Dialogue: 0,0:14:05.84,0:14:08.05,Default,,0,0,0,,Ынталы-сан Асахина-кунға жол көрсетеді
Dialogue: 0,0:14:08.13,0:14:10.80,Default,,0,0,0,,Ол маған мұндағы мүшелердің қарғысын көтеруге көмектесті.
Dialogue: 0,0:14:10.89,0:14:12.22,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:14:12.72,0:14:14.35,Default,,0,0,0,,Қарғыс атса да
Dialogue: 0,0:14:14.43,0:14:17.23,Default,,0,0,0,,Ол кезде мен Акираны да қорғамадым...
Dialogue: 0,0:14:17.31,0:14:18.56,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:14:19.44,0:14:22.06,Default,,0,0,0,,Мен Акира қарғысымды бұзды деп естідім.
Dialogue: 0,0:14:22.57,0:14:24.07,Default,,0,0,0,,Тағы да рахмет
Dialogue: 0,0:14:24.15,0:14:26.15,Default,,0,0,0,,Бұл жай ғана заңдылық.
Dialogue: 0,0:14:26.65,0:14:29.57,Default,,0,0,0,,Бірақ сіз жалғыз әрекет ете алмайсыз.
Dialogue: 0,0:14:29.66,0:14:31.91,Default,,0,0,0,,Ақыл-есі дұрыс болып, сізбен ақылдассам ғой.
Dialogue: 0,0:14:33.03,0:14:35.29,Default,,0,0,0,,Бұл мүмкін емес еді.
Dialogue: 0,0:14:35.83,0:14:37.91,Default,,0,0,0,,Батырдан күткендей
Dialogue: 0,0:14:38.41,0:14:39.92,Default,,0,0,0,,Көшбасшылық дегеніміз не?
Dialogue: 0,0:14:41.92,0:14:43.00,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:14:43.09,0:14:46.21,Default,,0,0,0,,Зел мырзаның патша сарайынан кетуі дұрыс па?
Dialogue: 0,0:14:46.30,0:14:48.47,Default,,0,0,0,,Мен рыцарь болуды қойдым.
Dialogue: 0,0:14:48.55,0:14:50.97,Default,,0,0,0,,Дәлірек айтсақ, мені жұмыстан шығарды.
Dialogue: 0,0:14:51.47,0:14:53.85,Default,,0,0,0,,Патша рыцарларымыздың жолына бөгет болған сияқты.
Dialogue: 0,0:14:53.93,0:14:56.35,Default,,0,0,0,,Сонда мағынасы бар.
Dialogue: 0,0:14:56.43,0:14:57.31,Default,,0,0,0,,Акира
Dialogue: 0,0:14:57.81,0:15:01.19,Default,,0,0,0,,Саған қосылатын уақытты асыға күттім.
Dialogue: 0,0:15:01.77,0:15:04.02,Default,,0,0,0,,Енді менімен жұмыс істеуге дайынсың ба?
Dialogue: 0,0:15:04.11,0:15:07.65,Default,,0,0,0,,Жоқ, мен шебердің жалғыз серіктесімін.
Dialogue: 0,0:15:07.74,0:15:10.03,Default,,0,0,0,,Мен Акирадан сұраймын.
Dialogue: 0,0:15:10.11,0:15:12.03,Default,,0,0,0,,Йору, сәл үндемей тұршы.
Dialogue: 0,0:15:12.11,0:15:13.66,Default,,0,0,0,,Менің атымды кездейсоқ атама!
Dialogue: 0,0:15:13.74,0:15:16.24,Default,,0,0,0,,Тоқта, күте тұр, екеуің тынышталыңдар.
Dialogue: 0,0:15:17.75,0:15:18.58,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:15:19.08,0:15:23.00,Default,,0,0,0,,Кёсуке де, батырлар жағы да аман-есен босап қалды.
Dialogue: 0,0:15:23.50,0:15:26.80,Default,,0,0,0,,Бірақ балалар, қазірден бастап не істеуді жоспарлап отырсыздар?
Dialogue: 0,0:15:27.38,0:15:30.55,Default,,0,0,0,,Біз жын патшаны бағындыруды ойлап жатырмыз.
Dialogue: 0,0:15:30.63,0:15:35.76,Default,,0,0,0,,Жын патшасын жеңген сіз сияқты адамдар туралы үлкен әңгіме.
Dialogue: 0,0:15:35.85,0:15:37.14,Default,,0,0,0,,Бір жағы ауырады
Dialogue: 0,0:15:37.22,0:15:38.43,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:38.52,0:15:39.06,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:15:39.77,0:15:41.98,Default,,0,0,0,,Шынында да, бұл не? бұл мысық
Dialogue: 0,0:15:42.06,0:15:45.44,Default,,0,0,0,,Кешеден бері мен Асахина-кун мен Сато-кунды көп кездестірдім.
Dialogue: 0,0:15:45.52,0:15:47.27,Default,,0,0,0,,Сен де кеше келдің бе?
Dialogue: 0,0:15:47.36,0:15:48.94,Default,,0,0,0,,Мен оны артқа қудым, бірақ
Dialogue: 0,0:15:51.11,0:15:54.03,Default,,0,0,0,,Йору, кешіріңіз, сәл шешіп алыңыз.
Dialogue: 0,0:15:54.11,0:15:55.82,Default,,0,0,0,,Мен оны еріксіз үйрендім.
Dialogue: 0,0:15:57.28,0:15:58.99,Default,,0,0,0,,Жын патшасын жеңгеннен кейін не істейсің?
Dialogue: 0,0:15:59.50,0:16:00.96,Default,,0,0,0,,Батыр болғың келе ме?
Dialogue: 0,0:16:01.04,0:16:05.88,Default,,0,0,0,,Жоқ, егер сіз белгі жасасаңыз, король Лейтиспен келіссөздер жүргізе аласыз.
Dialogue: 0,0:16:06.38,0:16:09.46,Default,,0,0,0,,Бүкіл сыныпты бастапқы әлеміне жіберіңіз.
Dialogue: 0,0:16:09.55,0:16:13.34,Default,,0,0,0,,Сіз оны шақыра алғандықтан, оны қалай қайтару керектігін білуіңіз керек.
Dialogue: 0,0:16:14.05,0:16:15.97,Default,,0,0,0,,Маған күш бере аласыз ба?
Dialogue: 0,0:16:16.05,0:16:17.18,Default,,0,0,0,,Бұл көңілсіз
Dialogue: 0,0:16:17.26,0:16:19.31,Default,,0,0,0,,Акира бізбен салыстыруға келмейді...
Dialogue: 0,0:16:19.39,0:16:20.35,Default,,0,0,0,,Бұл күшті сияқты
Dialogue: 0,0:16:20.43,0:16:21.43,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:16:21.93,0:16:23.73,Default,,0,0,0,,Бірге күрес, Акира.
Dialogue: 0,0:16:26.06,0:16:27.48,Default,,0,0,0,,Кейбір мәселелер бар.
Dialogue: 0,0:16:28.52,0:16:31.49,Default,,0,0,0,,Біріншіден, егер біз король Лейтиспен лайықты келіссөз жүргізе алсақ.
Dialogue: 0,0:16:31.57,0:16:32.99,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:16:33.07,0:16:35.82,Default,,0,0,0,,Олар адамдарды қарғыспен басқаратын адамдар.
Dialogue: 0,0:16:36.70,0:16:38.74,Default,,0,0,0,,Капитан Саран да...
Dialogue: 0,0:16:40.33,0:16:42.37,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:42.87,0:16:44.62,Default,,0,0,0,,Тағы қандай мәселелер бар?
Dialogue: 0,0:16:45.29,0:16:46.13,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:46.75,0:16:52.01,Default,,0,0,0,,Батырды шақыру үшін әркімнің өмірі қиылды.
Dialogue: 0,0:16:53.13,0:16:54.30,Default,,0,0,0,,Мен саған бір күні айтамын
Dialogue: 0,0:16:54.80,0:16:57.55,Default,,0,0,0,,Мен бәрібір оларға сенумен келіспеймін.
Dialogue: 0,0:16:57.64,0:16:59.22,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:16:59.30,0:17:01.18,Default,,0,0,0,,Акира да үйіне қайтқысы келеді, солай ма?
Dialogue: 0,0:17:01.27,0:17:03.39,Default,,0,0,0,,Аа, мен үйге барғым келеді.
Dialogue: 0,0:17:04.98,0:17:08.52,Default,,0,0,0,,Жындардың екінші дәрежесі телепортацияның сиқырлы шеңберлерін жасай алады.
Dialogue: 0,0:17:08.61,0:17:11.73,Default,,0,0,0,,Сонымен бастапқы әлеммен байланыстыратын сиқырлы шеңбер туралы не деуге болады?
Dialogue: 0,0:17:12.23,0:17:13.28,Default,,0,0,0,,…қандай зат болмасын, бәрін бомбаға айналдырады.
Dialogue: 0,0:17:14.61,0:17:18.53,Default,,0,0,0,,Мен жындар аумағына кіріп, оны бір күні қыспақшымын.
Dialogue: 0,0:17:19.07,0:17:21.58,Default,,0,0,0,,Бұған дейін менде аяқтағым келетін нәрсе бар.
Dialogue: 0,0:17:22.16,0:17:23.62,Default,,0,0,0,,Біз не істей аламыз?
Dialogue: 0,0:17:23.70,0:17:24.50,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:17:24.58,0:17:25.29,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:26.29,0:17:27.67,Default,,0,0,0,,Айтпақшы,
Dialogue: 0,0:17:27.75,0:17:32.30,Default,,0,0,0,,Тіпті ісім біткен соң сенімен баруды шешсем де.
Dialogue: 0,0:17:32.80,0:17:34.84,Default,,0,0,0,,Мені қорғайтын адам керек емес
Dialogue: 0,0:17:38.47,0:17:42.39,Default,,0,0,0,,Мен де үйге бару үшін ең жақсы таңдауды жасаймын.
Dialogue: 0,0:17:42.47,0:17:43.72,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:17:46.89,0:17:49.73,Default,,0,0,0,,Балалар, не істейтіндерің туралы мұқият ойланыңдар.
Dialogue: 0,0:17:53.36,0:17:57.36,Default,,0,0,0,,Мен мистер Кроумен қаруға тапсырыс беруді де талқылағым келеді.
Dialogue: 0,0:17:58.07,0:17:59.91,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:18:01.12,0:18:04.50,Default,,0,0,0,,Ендеше... Ода жігіт, қалағаныңды айт!
Dialogue: 0,0:18:05.08,0:18:07.96,Default,,0,0,0,,Бірақ үйге қайту ықтималдығы жоғары
Dialogue: 0,0:18:08.04,0:18:10.83,Default,,0,0,0,,Менің ойымша, бұл Акирамен бірге жұмыс істеу дегенді білдіреді.
Dialogue: 0,0:18:11.84,0:18:12.63,Default,,0,0,0,,Ода-кун
Dialogue: 0,0:18:12.71,0:18:14.96,Default,,0,0,0,,Бізге аздап бейімделсеңіз жақсы болар еді.
Dialogue: 0,0:18:15.05,0:18:18.13,Default,,0,0,0,,Көмек болмас, ол сондай жігіт.
Dialogue: 0,0:18:18.22,0:18:19.05,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:18:19.13,0:18:23.56,Default,,0,0,0,,Олар бізді мойындамаса, бізбен бірге келмейтін сияқты.
Dialogue: 0,0:18:23.64,0:18:24.89,Default,,0,0,0,,Бұл қиын сұрақ.
Dialogue: 0,0:18:37.07,0:18:37.69,Default,,0,0,0,,Амелия
Dialogue: 0,0:18:42.20,0:18:44.08,Default,,0,0,0,,Бір күні екеуміз де айырылармыз
Dialogue: 0,0:18:45.08,0:18:46.87,Default,,0,0,0,,Мен білуім керек еді
Dialogue: 0,0:18:48.58,0:18:50.87,Default,,0,0,0,,Уақыт келе ме деп қорқамын
Dialogue: 0,0:18:54.17,0:18:55.80,Default,,0,0,0,,Білесің бе, Акира
Dialogue: 0,0:18:57.71,0:19:00.43,Default,,0,0,0,,Мен кешірім сұрауым керек
Dialogue: 0,0:19:03.05,0:19:06.39,Default,,0,0,0,,Менің қолым Акираның денесіне енгенде...
Dialogue: 0,0:19:06.89,0:19:09.73,Default,,0,0,0,,Бұл Амелия кінәлі емес еді.
Dialogue: 0,0:19:10.31,0:19:12.60,Default,,0,0,0,,Бұл мені есінен шығарғандай азапты болды.
Dialogue: 0,0:19:13.44,0:19:15.61,Default,,0,0,0,,Мен Акираны ренжіттім
Dialogue: 0,0:19:17.40,0:19:20.07,Default,,0,0,0,,Бірақ кейінірек ойладым
Dialogue: 0,0:19:21.41,0:19:22.61,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:19:27.04,0:19:28.91,Default,,0,0,0,,Мен өзімнің бастапқы әлеміме оралғанда
Dialogue: 0,0:19:29.00,0:19:31.92,Default,,0,0,0,,Акира мені ұмытады
Dialogue: 0,0:19:32.62,0:19:36.38,Default,,0,0,0,,Бірақ мен жасаған тыртық мәңгі қалады.
Dialogue: 0,0:19:37.96,0:19:42.01,Default,,0,0,0,,Мұндай нәрсеге қуану сұмдық.
Dialogue: 0,0:19:44.09,0:19:47.22,Default,,0,0,0,,Мен жақсы сөз айтатын адам емеспін.
Dialogue: 0,0:19:47.72,0:19:50.39,Default,,0,0,0,,Бірақ Амелия мен үшін...
Dialogue: 0,0:19:50.98,0:19:52.85,Default,,0,0,0,,Ол маған қамқорлық жасайды
Dialogue: 0,0:19:53.52,0:19:54.90,Default,,0,0,0,,Мен солай ойлағым келеді.
Dialogue: 0,0:19:55.73,0:19:57.02,Default,,0,0,0,,Бірақ мен білмеймін
Dialogue: 0,0:19:57.11,0:20:00.40,Default,,0,0,0,,Дүниенің көзімен қарасаң да, адамдардың шынайы сезімін көре алмайсың.
Dialogue: 0,0:20:01.57,0:20:05.62,Default,,0,0,0,,Оның үстіне адамдардың жүрегі өте құбылмалы.
Dialogue: 0,0:20:06.74,0:20:10.75,Default,,0,0,0,,Мен шын мәнінде не қалайтынымды да білмеймін.
Dialogue: 0,0:20:11.71,0:20:13.21,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:20:14.08,0:20:14.71,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:14.79,0:20:16.42,Default,,0,0,0,,(қылыштың тартылған дыбысы)
Dialogue: 0,0:20:19.63,0:20:21.26,Default,,0,0,0,,Мен болған әлемде
Dialogue: 0,0:20:21.34,0:20:23.43,Default,,0,0,0,,Өз болашағын бір-біріне берген әйел мен еркек
Dialogue: 0,0:20:24.01,0:20:27.47,Default,,0,0,0,,Сол қолдың сақина саусағына жүзік тағу салты бар.
Dialogue: 0,0:20:34.02,0:20:34.69,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:36.31,0:20:37.27,Default,,0,0,0,,Амелия
Dialogue: 0,0:20:38.27,0:20:40.23,Default,,0,0,0,,Хашида айтты, сен Комимада онымен кездесе алмаған сияқтысың.
Dialogue: 0,0:20:43.28,0:20:45.20,Default,,0,0,0,,Амелия қаласа
Dialogue: 0,0:20:46.28,0:20:49.70,Default,,0,0,0,,Мен бұл денені жараласам бақытты боламын
Dialogue: 0,0:20:54.75,0:20:56.63,Default,,0,0,0,,Маған да Акира ұнайды
Dialogue: 0,0:20:57.50,0:20:58.46,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:20:59.17,0:21:00.21,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:21:16.81,0:21:17.73,Default,,0,0,0,,Амелия
Dialogue: 0,0:21:18.40,0:21:20.44,Default,,0,0,0,,Тілегің болса, бәрін айт.
Dialogue: 0,0:21:21.23,0:21:23.99,Default,,0,0,0,,Егер қолымнан келсе, міндетті түрде орындаймын.
Dialogue: 0,0:21:25.28,0:21:26.91,Default,,0,0,0,,Маған уәде бергеніңізді қалаймын
Dialogue: 0,0:21:27.91,0:21:29.12,Default,,0,0,0,,«Оқыттым» деген сөз дәл келмейді—
Dialogue: 0,0:21:29.78,0:21:30.95,Default,,0,0,0,,Майури сенімен сөйлесіп, қамқорлық көрсеткісі келіп жатқанын байқамайсың ба?
Dialogue: 0,0:21:31.58,0:21:32.83,Default,,0,0,0,,Мені тастама
Dialogue: 0,0:21:34.25,0:21:36.12,Default,,0,0,0,,Маған қарап тұра бер
Dialogue: 0,0:21:44.38,0:21:46.97,Default,,0,0,0,,Бұл тілек тыңдалды.
Dialogue: 0,0:21:48.26,0:21:49.68,Default,,0,0,0,,Оны орындайық
Dialogue: 0,0:22:11.32,0:22:13.33,Default,,0,0,0,,♪～
Dialogue: 0,0:23:38.91,0:23:40.91,Default,,0,0,0,,～♪
