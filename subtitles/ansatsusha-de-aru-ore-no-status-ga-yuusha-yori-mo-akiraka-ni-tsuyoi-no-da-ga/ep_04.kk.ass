Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.08,0:00:07.54,Default,,0,0,0,,Мен жай ғана серуендеуге барсам да жақсымын.
Dialogue: 0,0:00:07.63,0:00:11.51,Default,,0,0,0,,Мәртебелі Король ұзақ уақыт бойы болмаған жағдайда...
Dialogue: 0,0:00:11.59,0:00:12.47,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:12.55,0:00:14.01,Default,,0,0,0,,Ах
Dialogue: 0,0:00:24.73,0:00:25.31,Default,,0,0,0,,Эй!
Dialogue: 0,0:00:26.35,0:00:28.02,Default,,0,0,0,,- Уф... - (Сарбаздар) Уф!
Dialogue: 0,0:00:28.86,0:00:30.03,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:00:36.11,0:00:37.28,Default,,0,0,0,,Ахх!
Dialogue: 0,0:00:43.25,0:00:45.29,Default,,0,0,0,,Кирика маған қарағанда жақсы
Dialogue: 0,0:00:45.37,0:00:47.54,Default,,0,0,0,,Үздіксіз нақтылау
Dialogue: 0,0:00:47.63,0:00:49.59,Default,,0,0,0,,Кирика-сама да тамаша.
Dialogue: 0,0:00:49.67,0:00:52.34,Default,,0,0,0,,Амелия ханым ақырында елді басқарады.
Dialogue: 0,0:00:52.42,0:00:53.42,Default,,0,0,0,,Біліңіз
Dialogue: 0,0:00:57.34,0:01:00.72,Default,,0,0,0,,Мен Амелия-самамен келісімімді тоқтатқым келеді.
Dialogue: 0,0:01:01.47,0:01:03.18,Default,,0,0,0,,Бұл менің шешімім емес.
Dialogue: 0,0:01:03.27,0:01:04.52,Default,,0,0,0,,Әкеңе айт
Dialogue: 0,0:01:04.60,0:01:07.48,Default,,0,0,0,,Лиам үйленгісі келмейді.
Dialogue: 0,0:01:08.35,0:01:10.90,Default,,0,0,0,,Сіздің әпкеңіз «жаман бала»
Dialogue: 0,0:01:12.40,0:01:13.82,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:21.83,0:01:25.37,Default,,0,0,0,,Сіздің әпкеңіз кешірілмейтін қылмыс жасады.
Dialogue: 0,0:01:25.46,0:01:26.79,Default,,0,0,0,,Жоқ! мен...
Dialogue: 0,0:01:26.87,0:01:29.25,Default,,0,0,0,,Жексұрын бала ханшайымға ыдыс емес.
Dialogue: 0,0:01:29.33,0:01:31.25,Default,,0,0,0,,Кирика-сама - жалғыз нағыз ханшайым!
Dialogue: 0,0:01:33.71,0:01:35.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:40.22,0:01:41.14,Default,,0,0,0,,Иә
Dialogue: 0,0:01:41.22,0:01:44.39,Default,,0,0,0,,Кирика Мен осы жерден кетемін, сондықтан...
Dialogue: 0,0:01:44.47,0:01:47.23,Default,,0,0,0,,Сен маған сені жалғыз қалдыруды айтқың келе ме?
Dialogue: 0,0:01:47.31,0:01:49.52,Default,,0,0,0,,Өзі жексұрын болса да, өзімшіл.
Dialogue: 0,0:01:49.60,0:01:51.94,Default,,0,0,0,,-(Акира) Эй, сен асыра айтып тұрсың. -Ах.
Dialogue: 0,0:01:52.02,0:01:54.73,Default,,0,0,0,,Күнәкарды қорғау деген нені білдіреді?
Dialogue: 0,0:01:54.82,0:01:56.44,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:01:56.53,0:01:59.91,Default,,0,0,0,,Мен бұл жігітті жақында өтіп бара жатып кездестірдім...
Dialogue: 0,0:01:59.99,0:02:01.49,Default,,0,0,0,,Ассасин
Dialogue: 0,0:02:02.49,0:02:04.49,Default,,0,0,0,,♪～
Dialogue: 0,0:03:29.41,0:03:31.41,Default,,0,0,0,,～♪
Dialogue: 0,0:03:39.51,0:03:41.67,Default,,0,0,0,,Ол Лиамды ренжітеді деп ойлау үшін...
Dialogue: 0,0:03:41.76,0:03:44.09,Default,,0,0,0,,Сіз көбірек күнә жасадыңыз.
Dialogue: 0,0:03:44.18,0:03:46.89,Default,,0,0,0,,Мен сені күнәһар деп жүргеніме біраз болды.
Dialogue: 0,0:03:46.97,0:03:48.06,Default,,0,0,0,,Бұл жігіт не істеді?
Dialogue: 0,0:03:50.27,0:03:51.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:51.14,0:03:52.06,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:52.14,0:03:54.98,Default,,0,0,0,,Әпке уды дәрі ретінде бүркеді.
Dialogue: 0,0:03:55.06,0:03:56.73,Default,,0,0,0,,Ол маған берді.
Dialogue: 0,0:03:56.81,0:04:00.07,Default,,0,0,0,,Тіпті бір патша отбасының мүшелері де корольдік отбасына зиян келтіру қылмысынан құтыла алмайды!
Dialogue: 0,0:04:00.15,0:04:01.82,Default,,0,0,0,,- (Солдат) Бұл жиіркенішті - (Солдат) Мен оны кешіре алмаймын.
Dialogue: 0,0:04:01.90,0:04:03.57,Default,,0,0,0,,- (Солдат) Жиренішті - (Солдат) Кирика-сама
Dialogue: 0,0:04:03.66,0:04:05.91,Default,,0,0,0,,Жоқ! Мен сенімдімін.
Dialogue: 0,0:04:05.99,0:04:08.28,Default,,0,0,0,,Сіз мұны өзіңіз жаздым дейсіз бе?
Dialogue: 0,0:04:10.62,0:04:11.79,Default,,0,0,0,,Енді сіз білесіз.
Dialogue: 0,0:04:12.79,0:04:15.04,Default,,0,0,0,,Қашқан күнәкарды қайтарғаны үшін.
Dialogue: 0,0:04:15.12,0:04:16.42,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:04:18.54,0:04:19.30,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:19.38,0:04:22.09,Default,,0,0,0,,Акира! Кириканың көзіне қарама!
Dialogue: 0,0:04:26.18,0:04:27.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:28.10,0:04:29.85,Default,,0,0,0,,тым кеш
Dialogue: 0,0:04:29.93,0:04:32.77,Default,,0,0,0,,«Сүйкімділік» дағдысы әлдеқашан іске қосылды
Dialogue: 0,0:04:33.27,0:04:35.35,Default,,0,0,0,,Бұл кісінің жүрегі менікі
Dialogue: 0,0:04:36.56,0:04:39.48,Default,,0,0,0,,Әпкеңнің жағында бірде-бір адам жоқ.
Dialogue: 0,0:04:39.57,0:04:40.98,Default,,0,0,0,,Кешірім сұраңыз
Dialogue: 0,0:04:41.07,0:04:41.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:43.11,0:04:47.41,Default,,0,0,0,,Шартты қазір алып тастап, Акирадан кешірім сұра.
Dialogue: 0,0:04:48.32,0:04:53.83,Default,,0,0,0,,Акира не ойлайтынын және не істейтінін шешеді.
Dialogue: 0,0:04:53.91,0:04:57.00,Default,,0,0,0,,Сіз оны рұқсатсыз ешқашан өзгертпеуіңіз керек!
Dialogue: 0,0:04:57.08,0:04:58.25,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:58.33,0:05:02.21,Default,,0,0,0,,Не, сен маған бұрын ешқашан ашуланбадың, бірақ кенет...
Dialogue: 0,0:05:02.30,0:05:03.51,Default,,0,0,0,,Ал, тынышталыңыз.
Dialogue: 0,0:05:03.59,0:05:05.17,Default,,0,0,0,,-А-а?
Dialogue: 0,0:05:05.80,0:05:07.18,Default,,0,0,0,,Маған ештеңе жасалған жоқ
Dialogue: 0,0:05:08.14,0:05:10.05,Default,,0,0,0,,Шарм жұмыс істемейді ме?
Dialogue: 0,0:05:10.14,0:05:13.68,Default,,0,0,0,,Деңгейлік айырмашылығы үлкен қарсыластармен тіл табыса алмайды
Dialogue: 0,0:05:13.77,0:05:17.06,Default,,0,0,0,,Барлық ақыл-ой дағдылары осындай.
Dialogue: 0,0:05:17.15,0:05:20.40,Default,,0,0,0,,Мұндай қарапайым адамның менен күшті болуы мүмкін емес!
Dialogue: 0,0:05:21.11,0:05:23.36,Default,,0,0,0,,Мен қарапайым адаммын ба, әлде бір нәрсе ме, бәрібір.
Dialogue: 0,0:05:23.44,0:05:25.40,Default,,0,0,0,,Әпкеңе киген киіміңді тазаладың.
Dialogue: 0,0:05:25.49,0:05:26.90,Default,,0,0,0,,Бұл Нұрегину ма?
Dialogue: 0,0:05:27.53,0:05:29.70,Default,,0,0,0,,Біреуді алдау немесе зиян келтіру
Dialogue: 0,0:05:29.78,0:05:32.29,Default,,0,0,0,,Менің ойымша, бұл жігіт мұндай бейшаралық жасамайды.
Dialogue: 0,0:05:33.16,0:05:33.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:33.87,0:05:36.54,Default,,0,0,0,,Солдаттар, мына адамды өлтіріңдер!
Dialogue: 0,0:05:43.80,0:05:44.63,Default,,0,0,0,,үшінна!
Dialogue: 0,0:05:46.42,0:05:47.51,Default,,0,0,0,,Садағыңды таста!
Dialogue: 0,0:05:48.47,0:05:49.76,Default,,0,0,0,,Әке...
Dialogue: 0,0:05:51.30,0:05:52.64,Default,,0,0,0,,Не шу?
Dialogue: 0,0:05:52.72,0:05:54.10,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:05:54.18,0:05:56.77,Default,,0,0,0,,Себебі Амелия ханшайым қылмыс жасады...
Dialogue: 0,0:05:56.85,0:05:58.39,Default,,0,0,0,,Мен сенен сұраған жоқпын
Dialogue: 0,0:05:58.90,0:06:00.77,Default,,0,0,0,,Кирика Бұл не?
Dialogue: 0,0:06:00.86,0:06:04.15,Default,,0,0,0,,Әке, мен ұзақ мерзімді іссапардамын...
Dialogue: 0,0:06:04.23,0:06:07.03,Default,,0,0,0,,Маған бір рет қайту керек болды.
Dialogue: 0,0:06:07.11,0:06:09.78,Default,,0,0,0,,Мен тағы не естідім?
Dialogue: 0,0:06:11.12,0:06:13.28,Default,,0,0,0,,Кирика-саманы кінәлауға негіз жоқ!
Dialogue: 0,0:06:13.37,0:06:15.50,Default,,0,0,0,,Бәріне Амелия-сама кінәлі.
Dialogue: 0,0:06:15.58,0:06:17.79,Default,,0,0,0,,Дәл солдаттар айтқандай.
Dialogue: 0,0:06:19.12,0:06:21.42,Default,,0,0,0,,Сіз сарбаздарға сүйкімділік қолданасыз ба?
Dialogue: 0,0:06:21.50,0:06:22.79,Default,,0,0,0,,Қазір шешіңіз
Dialogue: 0,0:06:27.84,0:06:29.88,Default,,0,0,0,,Одан әрі жаза тағайындалады.
Dialogue: 0,0:06:31.30,0:06:34.93,Default,,0,0,0,,Кириканың сізге деген мінез-құлқы өзгереді.
Dialogue: 0,0:06:35.01,0:06:36.22,Default,,0,0,0,,Әке...
Dialogue: 0,0:06:36.31,0:06:38.06,Default,,0,0,0,,Кирика атынан кешірім сұраңыз
Dialogue: 0,0:06:38.14,0:06:42.44,Default,,0,0,0,,Оны сандарға қалдырып, біржақты шабуыл жасау жексұрындық болды.
Dialogue: 0,0:06:42.52,0:06:45.19,Default,,0,0,0,,Жарайды, біткен соң қайт.
Dialogue: 0,0:06:45.27,0:06:47.11,Default,,0,0,0,,- Ал ше (Акира)? -Әке
Dialogue: 0,0:06:47.19,0:06:50.28,Default,,0,0,0,,Акира маған көмектесіп, осында менімен бірге келді.
Dialogue: 0,0:06:50.36,0:06:55.16,Default,,0,0,0,,Қандай жағдай болмасын, жат нәсілдерге бұл жерге кіруге болмайды.
Dialogue: 0,0:06:56.62,0:06:59.12,Default,,0,0,0,,Онда мен Акираның соңынан еремін.
Dialogue: 0,0:06:59.21,0:07:00.92,Default,,0,0,0,,Мен бұл жерде болмағанды жөн көремін
Dialogue: 0,0:07:01.83,0:07:04.00,Default,,0,0,0,,Бұған рұқсат етіледі деп ойлайсыз ба?
Dialogue: 0,0:07:04.88,0:07:09.22,Default,,0,0,0,,Бір күні менің орныма ел басқарасың.
Dialogue: 0,0:07:09.30,0:07:13.01,Default,,0,0,0,,Бұл жігіт не істейтінін өзі шешеді.
Dialogue: 0,0:07:13.09,0:07:15.72,Default,,0,0,0,,Бейтаныс адамдардың араласуына жол бермеу
Dialogue: 0,0:07:15.81,0:07:18.64,Default,,0,0,0,,Мен бөтен адам болғандықтан, сізге еруге ешқандай себеп жоқ.
Dialogue: 0,0:07:20.06,0:07:23.52,Default,,0,0,0,,Сондай-ақ бұл жігіттің еркін күшпен өткізуге болады.
Dialogue: 0,0:07:24.98,0:07:27.07,Default,,0,0,0,,Мәртебелі Король
Dialogue: 0,0:07:28.11,0:07:31.49,Default,,0,0,0,,Ұятымды әшкерелегенім үшін кешіріңіз...
Dialogue: 0,0:07:31.57,0:07:33.45,Default,,0,0,0,,Бұл сізбен сөйлесіп жатқан адам ма?
Dialogue: 0,0:07:33.53,0:07:34.74,Default,,0,0,0,,Иә
Dialogue: 0,0:07:34.82,0:07:37.87,Default,,0,0,0,,Дөрекі күш батылдық емес сияқты.
Dialogue: 0,0:07:39.20,0:07:41.62,Default,,0,0,0,,Енді мен сендерді дуэльге шақырамын.
Dialogue: 0,0:07:41.71,0:07:43.88,Default,,0,0,0,,Жеңімпаздың жағын алған дұрыс.
Dialogue: 0,0:07:43.96,0:07:45.33,Default,,0,0,0,,Әке!
Dialogue: 0,0:07:45.42,0:07:48.46,Default,,0,0,0,,Мен Кириканы өз өкілім ретінде көтеремін.
Dialogue: 0,0:07:48.55,0:07:49.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:50.47,0:07:52.76,Default,,0,0,0,,Эльфтердің әдет-ғұрыптары бойынша
Dialogue: 0,0:07:52.84,0:07:55.97,Default,,0,0,0,,Жекпе-жек киелі ағаштың алдында өтеді.
Dialogue: 0,0:07:59.47,0:08:02.77,Default,,0,0,0,,Кешіріңіз, Акира, бұл менің кінәм.
Dialogue: 0,0:08:02.85,0:08:05.90,Default,,0,0,0,,Уайымдамаңыз, мен өз күшіммен істеп жатырмын.
Dialogue: 0,0:08:06.86,0:08:09.78,Default,,0,0,0,,Айтпақшы, бұл не туралы жиіркенішті бала?
Dialogue: 0,0:08:10.53,0:08:12.15,Default,,0,0,0,,Эльф туралы аңыз
Dialogue: 0,0:08:12.24,0:08:15.28,Default,,0,0,0,,Егіздердің жартысы ата-анасына ұқсамай туады.
Dialogue: 0,0:08:15.78,0:08:19.16,Default,,0,0,0,,Елге пәле әкелетін «Жаман бала».
Dialogue: 0,0:08:19.24,0:08:21.87,Default,,0,0,0,,Сіз онымен егізсіз бе?
Dialogue: 0,0:08:21.95,0:08:25.46,Default,,0,0,0,,Қажетсіз балаларды өлтіру ырымы ырым болып саналады.
Dialogue: 0,0:08:25.54,0:08:27.79,Default,,0,0,0,,Көптен бері жойылып кеткен жоқ па?
Dialogue: 0,0:08:27.88,0:08:32.55,Default,,0,0,0,,Иә...бірақ шаш пен көздің түсі басқа мен ғанамын.
Dialogue: 0,0:08:32.63,0:08:33.76,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:08:33.84,0:08:37.26,Default,,0,0,0,,Солай бола тұра, апаң неліктен бұлай айтудан бас тартады?
Dialogue: 0,0:08:37.35,0:08:39.76,Default,,0,0,0,,Бұл Мисс Амелияны қудалау болса керек.
Dialogue: 0,0:08:40.47,0:08:44.14,Default,,0,0,0,,Менің ойымша, ол шашы мен көзімен әдемі.
Dialogue: 0,0:08:44.23,0:08:45.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:55.49,0:08:57.82,Default,,0,0,0,,Мырза, қатысуды жасыру - бұл...
Dialogue: 0,0:08:57.91,0:08:59.45,Default,,0,0,0,,О, мен оны қолданбаймын.
Dialogue: 0,0:08:59.53,0:09:01.37,Default,,0,0,0,,Мен жеңгенімді анық көрсетуім керек.
Dialogue: 0,0:09:01.45,0:09:02.70,Default,,0,0,0,,Өйткені оның мағынасы жоқ
Dialogue: 0,0:09:03.29,0:09:06.83,Default,,0,0,0,,Акира Кирика - Эльф тайпасының ең күшті қылышшысы.
Dialogue: 0,0:09:06.92,0:09:07.58,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:09:07.67,0:09:10.09,Default,,0,0,0,,Менің ойымша, сіз оны өте жоғары бағалайсыз.
Dialogue: 0,0:09:10.17,0:09:12.51,Default,,0,0,0,,Біз бұрын жақсы дос болдық
Dialogue: 0,0:09:12.59,0:09:16.09,Default,,0,0,0,,Содан бері ол бала тынбай еңбек етті.
Dialogue: 0,0:09:17.93,0:09:20.10,Default,,0,0,0,,Менің мақтаныш апам
Dialogue: 0,0:09:22.43,0:09:26.06,Default,,0,0,0,,Міндетіңді орындап, патшалық қасиеттеріңді көрсет
Dialogue: 0,0:09:26.81,0:09:28.35,Default,,0,0,0,,Біз сіздің үміттеріңізді ақтаймыз
Dialogue: 0,0:09:36.07,0:09:38.70,Default,,0,0,0,,Қылышыңды суырмай-ақ жеңемін деп ойлайсың ба?
Dialogue: 0,0:09:39.32,0:09:41.58,Default,,0,0,0,,Оны тым көп күшпен өлтірсең жаман болар еді.
Dialogue: 0,0:09:41.66,0:09:43.33,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:09:43.83,0:09:46.58,Default,,0,0,0,,Әкемнің сенімін қайтарсам болғаны.
Dialogue: 0,0:09:48.08,0:09:49.17,Default,,0,0,0,,Амелия
Dialogue: 0,0:09:49.75,0:09:52.30,Default,,0,0,0,,Сіз маған бұрын ашуланған едіңіз.
Dialogue: 0,0:09:53.63,0:09:55.92,Default,,0,0,0,,Қатты ашуланғаны үшін.
Dialogue: 0,0:09:56.01,0:09:57.30,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,0:09:58.93,0:10:00.30,Default,,0,0,0,,Ал, сәл күте тұрыңыз.
Dialogue: 0,0:10:00.97,0:10:04.31,Default,,0,0,0,,Мен бұл жігітті жеңсем, сен қалағаныңды істей аласың.
Dialogue: 0,0:10:06.56,0:10:07.73,Default,,0,0,0,,Акира…
Dialogue: 0,0:10:09.27,0:10:11.69,Default,,0,0,0,,Патша атынан жекпе-жек өткізу
Dialogue: 0,0:10:15.07,0:10:16.32,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:10:18.86,0:10:20.95,Default,,0,0,0,,Ахх!
Dialogue: 0,0:10:23.03,0:10:24.41,Default,,0,0,0,,Иә! Қарғыс атсын!
Dialogue: 0,0:10:25.66,0:10:28.66,Default,,0,0,0,,Бұл перілердің ең күшті нәсілі екені рас, бірақ...
Dialogue: 0,0:10:32.21,0:10:33.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:33.13,0:10:35.67,Default,,0,0,0,,Сіздің әпкеңіз де шебер екен.
Dialogue: 0,0:10:35.76,0:10:38.09,Default,,0,0,0,,Негізгі зал күткендей керемет көрінеді.
Dialogue: 0,0:10:38.88,0:10:40.84,Default,,0,0,0,,Сіз еркіндік көрсетуге тырысасыз ба?
Dialogue: 0,0:10:40.93,0:10:42.72,Default,,0,0,0,,Зардап шеккенге дейін беріл
Dialogue: 0,0:10:43.39,0:10:44.89,Default,,0,0,0,,Мені мазақ етпе
Dialogue: 0,0:10:49.31,0:10:50.39,Default,,0,0,0,,Не?
Dialogue: 0,0:10:53.11,0:10:54.48,Default,,0,0,0,,Сиқыр беру керек пе?
Dialogue: 0,0:10:54.57,0:10:56.48,Default,,0,0,0,,Кириканың жалғыз сиқыры сол.
Dialogue: 0,0:10:56.57,0:10:58.99,Default,,0,0,0,,Бірақ оның жылтыратылғаны сондықтан.
Dialogue: 0,0:11:05.58,0:11:07.33,Default,,0,0,0,,Неге жылайсың?
Dialogue: 0,0:11:07.41,0:11:10.83,Default,,0,0,0,,Сөйле! Мен күліп тұрған жоқпын ба?
Dialogue: 0,0:11:10.92,0:11:13.29,Default,,0,0,0,,Сіз бұған күлкіңіз келе ме?
Dialogue: 0,0:11:13.38,0:11:14.46,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:15.38,0:11:16.38,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:11:17.34,0:11:18.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:19.76,0:11:20.38,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:22.51,0:11:23.43,Default,,0,0,0,,Ах
Dialogue: 0,0:11:23.51,0:11:24.55,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:11:25.64,0:11:27.72,Default,,0,0,0,,Ол сені мақтады.
Dialogue: 0,0:11:28.39,0:11:30.52,Default,,0,0,0,,Ондай адаммен татуласуға бола ма?
Dialogue: 0,0:11:30.60,0:11:32.52,Default,,0,0,0,,Мен оны мүлдем жек көремін!
Dialogue: 0,0:11:33.77,0:11:37.02,Default,,0,0,0,,Менен бәрін тартып алған адаммен дос болғаныма сене алар емеспін!
Dialogue: 0,0:11:39.44,0:11:40.99,Default,,0,0,0,,-Ха! -(Акира) Ух...
Dialogue: 0,0:11:42.45,0:11:43.36,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:44.12,0:11:45.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:47.91,0:11:48.91,Default,,0,0,0,,Гррр…
Dialogue: 0,0:11:51.62,0:11:53.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:53.12,0:11:54.71,Default,,0,0,0,,Әй! Қарғыс атсын!
Dialogue: 0,0:11:54.79,0:11:56.79,Default,,0,0,0,,Йору Амелияны қорғайды
Dialogue: 0,0:11:56.88,0:11:57.84,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:11:57.92,0:11:59.09,Default,,0,0,0,,Хмф! Ха!
Dialogue: 0,0:12:01.67,0:12:03.55,Default,,0,0,0,,Менде ештеңе жоқ
Dialogue: 0,0:12:03.63,0:12:07.60,Default,,0,0,0,,Менің әпкем, Құдайдың баласы, бәрін алып кетті!
Dialogue: 0,0:12:08.76,0:12:10.43,Default,,0,0,0,,Мен ғана басқамын
Dialogue: 0,0:12:10.52,0:12:13.44,Default,,0,0,0,,Мен сенің әдемі шашыңды жақсы көремін
Dialogue: 0,0:12:15.15,0:12:17.77,Default,,0,0,0,,Амелия-саманың кәсібі анықталды.
Dialogue: 0,0:12:17.86,0:12:20.03,Default,,0,0,0,,Бұл аңызға айналған «мико»
Dialogue: 0,0:12:20.11,0:12:21.36,Default,,0,0,0,,Мико…
Dialogue: 0,0:12:21.44,0:12:26.32,Default,,0,0,0,,Оянса, дүние оның пайдасына қозғалады деген Алланың баласы.
Dialogue: 0,0:12:27.03,0:12:30.12,Default,,0,0,0,,Біздің елде Амелия-сама болғанша,
Dialogue: 0,0:12:30.20,0:12:31.70,Default,,0,0,0,,Жан тыныштығы
Dialogue: 0,0:12:33.71,0:12:37.71,Default,,0,0,0,,Сол күннен бері маған ешкім қарамады!
Dialogue: 0,0:12:38.38,0:12:40.84,Default,,0,0,0,,Біз бәрін қайтарып алғанша
Dialogue: 0,0:12:40.92,0:12:42.80,Default,,0,0,0,,Мен тастамаймын!
Dialogue: 0,0:12:42.88,0:12:45.18,Default,,0,0,0,,Кирика, тоқта!
Dialogue: 0,0:12:45.26,0:12:46.34,Default,,0,0,0,,Құрметті Амелия!
Dialogue: 0,0:12:46.84,0:12:47.80,Default,,0,0,0,,Лиам
Dialogue: 0,0:12:48.72,0:12:51.35,Default,,0,0,0,,Кирика-саманы осымен құтқарыңыз.
Dialogue: 0,0:12:52.43,0:12:53.23,Default,,0,0,0,,Иә
Dialogue: 0,0:12:55.94,0:12:56.60,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:00.27,0:13:02.99,Default,,0,0,0,,Тазарту күші бар киелі ағаштың бұтағы.
Dialogue: 0,0:13:19.67,0:13:20.88,Default,,0,0,0,,Құрметті Амелия
Dialogue: 0,0:13:22.63,0:13:25.51,Default,,0,0,0,,Қызығу... ериді.
Dialogue: 0,0:13:26.97,0:13:29.39,Default,,0,0,0,,Соңында мен бәрін жоғалтамын
Dialogue: 0,0:13:29.47,0:13:33.06,Default,,0,0,0,,Бәрін апаң алып кетеді!
Dialogue: 0,0:13:33.60,0:13:35.85,Default,,0,0,0,,Жоқ! Бұл дұрыс емес, Кирика-сама!
Dialogue: 0,0:13:35.94,0:13:36.64,Default,,0,0,0,,Кирика!
Dialogue: 0,0:13:36.73,0:13:38.27,Default,,0,0,0,,Жалтарсаң, біраз адам өледі.
Dialogue: 0,0:13:38.35,0:13:39.98,Default,,0,0,0,,Мені ешкім көрмейді
Dialogue: 0,0:13:40.06,0:13:42.02,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:13:42.78,0:13:45.90,Default,,0,0,0,,Көлеңке сиқыры іске қосылды!
Dialogue: 0,0:13:47.99,0:13:49.57,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:13:50.99,0:13:54.25,Default,,0,0,0,,Ооо!
Dialogue: 0,0:13:58.04,0:13:59.08,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:13:59.17,0:14:00.17,Default,,0,0,0,,Мені же!
Dialogue: 0,0:14:10.18,0:14:11.51,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:11.60,0:14:15.10,Default,,0,0,0,,Сиқыр беретін көлеңке... Жоқ, олай емес.
Dialogue: 0,0:14:15.18,0:14:16.39,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:17.18,0:14:20.15,Default,,0,0,0,,Ооо!
Dialogue: 0,0:14:25.11,0:14:26.19,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:35.37,0:14:38.96,Default,,0,0,0,,«Маған ешкім қарап тұрған жоқ» дедіңіз.
Dialogue: 0,0:14:39.46,0:14:40.92,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:14:43.50,0:14:46.05,Default,,0,0,0,,Екеуің маған күлуге келдіңдер ме?
Dialogue: 0,0:14:46.71,0:14:49.34,Default,,0,0,0,,Шармның тез бұзылғанына сене алар емеспін
Dialogue: 0,0:14:49.43,0:14:51.43,Default,,0,0,0,,Лиам да таңқаларлықтай күшті болды.
Dialogue: 0,0:14:51.51,0:14:53.72,Default,,0,0,0,,Бұл дұрыс емес, Кирика-сама.
Dialogue: 0,0:14:53.80,0:14:55.68,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:14:55.76,0:15:00.31,Default,,0,0,0,,Ұйқыдан тұра салысымен, әпкем туралы, ол бәрінің сүйкімділігін жоғалтқанымен.
Dialogue: 0,0:15:00.39,0:15:02.69,Default,,0,0,0,,Кирика Лиам басынан бастап
Dialogue: 0,0:15:02.77,0:15:04.69,Default,,0,0,0,,Бұл сіздің шеберлігіңізге байланысты емес.
Dialogue: 0,0:15:04.77,0:15:06.48,Default,,0,0,0,,Мені мазақтауды доғар
Dialogue: 0,0:15:06.57,0:15:08.99,Default,,0,0,0,,Мен үшін қуу немесе өлім жазасына кесу
Dialogue: 0,0:15:09.07,0:15:11.16,Default,,0,0,0,,Әпкеңізді қалағаныңызша жазалай аласыз!
Dialogue: 0,0:15:11.24,0:15:13.91,Default,,0,0,0,,Егер кімде-кім жазалануы керек болса, ол менмін.
Dialogue: 0,0:15:14.83,0:15:16.91,Default,,0,0,0,,Амелия тоналмаған.
Dialogue: 0,0:15:16.99,0:15:19.46,Default,,0,0,0,,Оны сенен алған мен едім.
Dialogue: 0,0:15:20.16,0:15:22.83,Default,,0,0,0,,Тіпті әкем де мен түсінбейтін нәрсені айтты...
Dialogue: 0,0:15:23.83,0:15:25.59,Default,,0,0,0,,- (Зәйтүн) Кирика - А?
Dialogue: 0,0:15:25.67,0:15:29.05,Default,,0,0,0,,Енді естеліктеріңізді қайтарыңыз
Dialogue: 0,0:15:29.13,0:15:32.05,Default,,0,0,0,,«Ұмыту» дағдысының құлпы ашылды
Dialogue: 0,0:15:35.10,0:15:36.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:42.73,0:15:45.44,Default,,0,0,0,,Сен де бүгін өте ынталысың, Кирика-сама.
Dialogue: 0,0:15:45.52,0:15:47.65,Default,,0,0,0,,Тек жаттығу жеткіліксіз
Dialogue: 0,0:15:47.73,0:15:49.40,Default,,0,0,0,,Мен жасырын жаттығуға барамын.
Dialogue: 0,0:15:49.49,0:15:52.11,Default,,0,0,0,,Ах, Кирика-сама...
Dialogue: 0,0:15:54.07,0:15:56.41,Default,,0,0,0,,3-қабатқа дейін кіруге болады.
Dialogue: 0,0:15:56.49,0:15:58.20,Default,,0,0,0,,Әкем де солай айтты.
Dialogue: 0,0:15:58.29,0:15:59.91,Default,,0,0,0,,Сонда күшті бола алмайсың
Dialogue: 0,0:16:01.00,0:16:03.79,Default,,0,0,0,,Иә? Бірақ бұл уәде
Dialogue: 0,0:16:03.87,0:16:06.92,Default,,0,0,0,,А... Мен саған мынаны беремін.
Dialogue: 0,0:16:07.00,0:16:08.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:09.09,0:16:12.93,Default,,0,0,0,,Нивелирлеуге қолайлы құбыжықтар жиналады.
Dialogue: 0,0:16:17.76,0:16:18.51,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:16:21.98,0:16:24.40,Default,,0,0,0,,(Құбыжықтар айқайы)
Dialogue: 0,0:16:24.48,0:16:25.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:26.61,0:16:27.94,Default,,0,0,0,,- (Құбыжық) Гуруруру - Уау!
Dialogue: 0,0:16:28.02,0:16:28.94,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:16:29.65,0:16:31.74,Default,,0,0,0,,Кяах!
Dialogue: 0,0:16:32.24,0:16:33.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:35.41,0:16:37.78,Default,,0,0,0,,(Кириканың ауыр тыныс алуы)
Dialogue: 0,0:16:37.87,0:16:39.91,Default,,0,0,0,,А... Түсіндім...
Dialogue: 0,0:16:40.70,0:16:43.91,Default,,0,0,0,,Лабиринттегі құбыжықтар сыртқа шыға алмау керек!
Dialogue: 0,0:16:44.00,0:16:47.00,Default,,0,0,0,,Енді тоқтамасақ, халыққа шабуыл болады.
Dialogue: 0,0:16:48.25,0:16:49.29,Default,,0,0,0,,Таа!
Dialogue: 0,0:16:49.38,0:16:51.80,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:16:51.88,0:16:53.30,Default,,0,0,0,,Ахх!
Dialogue: 0,0:16:53.88,0:16:56.30,Default,,0,0,0,,(қылыштың тербелген дыбысы)
Dialogue: 0,0:16:56.39,0:16:57.26,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:16:57.34,0:16:59.05,Default,,0,0,0,,Кирика-сама!
Dialogue: 0,0:16:59.14,0:17:01.06,Default,,0,0,0,,-Лиам -Өтінемін, қаш!
Dialogue: 0,0:17:01.14,0:17:01.93,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:02.98,0:17:03.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:06.77,0:17:07.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:07.86,0:17:09.27,Default,,0,0,0,,-Ах... -Ах...
Dialogue: 0,0:17:11.36,0:17:13.53,Default,,0,0,0,,Ахахаха Ахахха!
Dialogue: 0,0:17:13.61,0:17:14.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:16.70,0:17:21.20,Default,,0,0,0,,Ахх!
Dialogue: 0,0:17:22.54,0:17:23.62,Default,,0,0,0,,Лиам…
Dialogue: 0,0:17:24.12,0:17:27.67,Default,,0,0,0,,Лиам көз алдыңда қайтыс болды.
Dialogue: 0,0:17:28.25,0:17:32.13,Default,,0,0,0,,Өкініштен жүрегің жарылды.
Dialogue: 0,0:17:34.09,0:17:36.55,Default,,0,0,0,,Оны ұмыттырудан басқа амалым қалмады.
Dialogue: 0,0:17:37.47,0:17:42.10,Default,,0,0,0,,Жағдайды бақылауға алған Амелияның «сиқырлы ұрпағы» болды.
Dialogue: 0,0:17:42.81,0:17:47.06,Default,,0,0,0,,Сол кезде Амелия гравитация сиқыры мен қайта тірілу сиқырын қолданды.
Dialogue: 0,0:17:47.56,0:17:49.98,Default,,0,0,0,,Екі дағдыны құрды
Dialogue: 0,0:18:00.03,0:18:03.04,Default,,0,0,0,,Әркім өзін бөлек сезінсе керек.
Dialogue: 0,0:18:03.54,0:18:06.33,Default,,0,0,0,,Миконың пайда болуы жалғыз себеп емес
Dialogue: 0,0:18:06.41,0:18:09.54,Default,,0,0,0,,Өйткені мұны жалғыз сен білмейді.
Dialogue: 0,0:18:09.63,0:18:11.00,Default,,0,0,0,,Тек мен...
Dialogue: 0,0:18:11.08,0:18:13.05,Default,,0,0,0,,Белгілі емес
Dialogue: 0,0:18:13.13,0:18:16.26,Default,,0,0,0,,Бізді жұқа тері қабаты бөліп тұрғандай болады.
Dialogue: 0,0:18:16.34,0:18:18.51,Default,,0,0,0,,Мен де ерекше болған жоқпын.
Dialogue: 0,0:18:20.84,0:18:23.89,Default,,0,0,0,,Дуэльде корольдік мәртебеңізді көрсетіңіз
Dialogue: 0,0:18:23.97,0:18:27.14,Default,,0,0,0,,Кирика сүйкімділікке сенбей-ақ мақтана алады.
Dialogue: 0,0:18:27.73,0:18:32.65,Default,,0,0,0,,Сол жүрек күші болса, шындықты айта аламын деп ойладым.
Dialogue: 0,0:18:32.73,0:18:34.27,Default,,0,0,0,,Сіз мені пайдаланасыз ба?
Dialogue: 0,0:18:34.90,0:18:39.28,Default,,0,0,0,,Мен жоспарлағанымнан басқа жолмен мойындауға мәжбүр болсам да,
Dialogue: 0,0:18:39.36,0:18:41.11,Default,,0,0,0,,Ол таяз болды.
Dialogue: 0,0:18:41.62,0:18:44.41,Default,,0,0,0,,Кирика-саманың өшпенділігі одан әрі күшейгенше.
Dialogue: 0,0:18:44.49,0:18:46.04,Default,,0,0,0,,Екеуіңді ажыратуға тырысамын
Dialogue: 0,0:18:46.12,0:18:49.50,Default,,0,0,0,,Мен Леди Амелияны қуып жіберуге тырыстым.
Dialogue: 0,0:18:50.50,0:18:53.29,Default,,0,0,0,,Сіз шынымен түсінбедіңіз.
Dialogue: 0,0:18:53.38,0:18:55.55,Default,,0,0,0,,Лиамды реанимациялағанда
Dialogue: 0,0:18:55.63,0:18:59.34,Default,,0,0,0,,Қасиетті ағаштың жапырақтары менің денеме абайсызда кіріп кетті.
Dialogue: 0,0:18:59.42,0:19:00.80,Default,,0,0,0,,Шарм жұмыс істемейді
Dialogue: 0,0:19:00.88,0:19:04.51,Default,,0,0,0,,Оқуын жалғастырып, биікке ұмтылған Кирикаға.
Dialogue: 0,0:19:04.60,0:19:06.89,Default,,0,0,0,,Мен саған шын жүректен тартылдым.
Dialogue: 0,0:19:07.39,0:19:10.06,Default,,0,0,0,,Кешірім сұрай алмағаным менің әлсіздігім еді.
Dialogue: 0,0:19:11.10,0:19:12.86,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:19:13.36,0:19:16.69,Default,,0,0,0,,Әркімнің алаңдаушылығын қашқақтау деп қате қабылдау
Dialogue: 0,0:19:16.78,0:19:21.61,Default,,0,0,0,,Мен үшін көгімді сүрткен апаны қызғанып, жау қылған.
Dialogue: 0,0:19:22.11,0:19:23.24,Default,,0,0,0,,Ақылсыз көрінеді
Dialogue: 0,0:19:23.32,0:19:24.58,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:19:24.66,0:19:25.66,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:26.16,0:19:28.45,Default,,0,0,0,,Кирика маған қарағанда жақсы
Dialogue: 0,0:19:28.54,0:19:31.29,Default,,0,0,0,,Бұл оқиға болғанға дейін және болғаннан кейін
Dialogue: 0,0:19:31.37,0:19:33.25,Default,,0,0,0,,Мен қатты тырыстым
Dialogue: 0,0:19:33.33,0:19:37.96,Default,,0,0,0,,Сонымен қатар, нағыз Кирика мейірімді және қамқор.
Dialogue: 0,0:19:39.84,0:19:41.80,Default,,0,0,0,,Бұл есімде
Dialogue: 0,0:19:41.88,0:19:43.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:43.26,0:19:45.35,Default,,0,0,0,,Кешіріңіз, әпке.
Dialogue: 0,0:19:45.43,0:19:47.39,Default,,0,0,0,,Кирика-сама~!
Dialogue: 0,0:19:47.47,0:19:49.14,Default,,0,0,0,,Жарақатыңызды тез емдеңіз!
Dialogue: 0,0:19:49.22,0:19:51.35,Default,,0,0,0,,Сусындар мен таңғыштар! Асығыңыз!
Dialogue: 0,0:19:51.44,0:19:52.44,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:19:52.52,0:19:53.85,Default,,0,0,0,,Ешқандай ауыр жарақат болмағанына қуаныштымын.
Dialogue: 0,0:19:53.94,0:19:56.94,Default,,0,0,0,,А... барлығы қарап тұр, солай ма?
Dialogue: 0,0:19:57.02,0:19:58.11,Default,,0,0,0,,Иә
Dialogue: 0,0:19:58.19,0:20:01.99,Default,,0,0,0,,Кирика-самаға бәрі ұнамаса да сүйсінеді.
Dialogue: 0,0:20:02.49,0:20:04.36,Default,,0,0,0,,Мен мұны білуіңізді қаладым.
Dialogue: 0,0:20:04.45,0:20:08.62,Default,,0,0,0,,Сонымен қатар, сіз түсінбеушілікпен мойындадыңыз.
Dialogue: 0,0:20:08.70,0:20:13.33,Default,,0,0,0,,(Адамдардың сөйлесіп жатқан дыбыстары)
Dialogue: 0,0:20:15.08,0:20:17.38,Default,,0,0,0,,Мен жекпе-жекте жеңсем жақсы ма?
Dialogue: 0,0:20:17.46,0:20:20.26,Default,,0,0,0,,Сондықтан біз қарсы алу кешін өткіздік.
Dialogue: 0,0:20:20.34,0:20:23.76,Default,,0,0,0,,Ендеше бұл жігіттің не істейтіні өз еркі.
Dialogue: 0,0:20:23.84,0:20:25.39,Default,,0,0,0,,Уәделер кешірілмейді
Dialogue: 0,0:20:25.47,0:20:27.51,Default,,0,0,0,,Сонда сен қайда бара жатырсың?
Dialogue: 0,0:20:27.60,0:20:30.43,Default,,0,0,0,,Әзірше аңдар құрлығын мақсат етіңіз.
Dialogue: 0,0:20:31.60,0:20:34.48,Default,,0,0,0,,Бұл қару-жарақ сатып алу және күту үшін жақсы орын.
Dialogue: 0,0:20:34.56,0:20:36.65,Default,,0,0,0,,Маған қызметшім сабақ берді
Dialogue: 0,0:20:38.77,0:20:40.65,Default,,0,0,0,,Акира, міне...
Dialogue: 0,0:20:40.73,0:20:41.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.44,0:20:43.40,Default,,0,0,0,,Не?
Dialogue: 0,0:20:44.24,0:20:45.86,Default,,0,0,0,,Маған атыммен қоңырау шалыңыз
Dialogue: 0,0:20:45.95,0:20:47.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:47.70,0:20:50.41,Default,,0,0,0,,«сіз» немесе «бұл жігіт» емес
Dialogue: 0,0:20:50.91,0:20:54.62,Default,,0,0,0,,Аты-жөні... Дуэль алдында мені шақырғандай.
Dialogue: 0,0:20:54.71,0:20:55.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:56.71,0:20:57.83,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:20:57.92,0:20:58.63,Default,,0,0,0,,А…
Dialogue: 0,0:21:01.34,0:21:02.51,Default,,0,0,0,,Амелия
Dialogue: 0,0:21:05.22,0:21:06.39,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:21:06.97,0:21:07.76,Default,,0,0,0,,Амелия
Dialogue: 0,0:21:07.84,0:21:10.01,Default,,0,0,0,,- Көбірек! -(Акира) Амелия
Dialogue: 0,0:21:10.68,0:21:11.89,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:21:12.56,0:21:13.77,Default,,0,0,0,,Қандай қызық жігіт.
Dialogue: 0,0:21:13.85,0:21:17.65,Default,,0,0,0,,Мен Акира қайда жүрсе де, оның соңынан еремін.
Dialogue: 0,0:21:17.73,0:21:18.81,Default,,0,0,0,,Мүмкін жай ғана жеп-ішіп, сәл шу шығарамыз да, сонымен бітті. (Миямура) Кешір.
Dialogue: 0,0:21:18.90,0:21:21.36,Default,,0,0,0,,Егер сіз солай шешсеңіз...
Dialogue: 0,0:21:21.44,0:21:22.65,Default,,0,0,0,,«сіз» емес
Dialogue: 0,0:21:22.73,0:21:24.03,Default,,0,0,0,,Амелия
Dialogue: 0,0:21:25.03,0:21:26.53,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:27.11,0:21:28.53,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:21:28.62,0:21:30.33,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:21:30.41,0:21:34.87,Default,,0,0,0,,Амелия ханым екеуіңіз балаға ұқсамайсыз ба?
Dialogue: 0,0:21:34.96,0:21:36.79,Default,,0,0,0,,Қаншалықты көңілсіз.
Dialogue: 0,0:21:36.87,0:21:38.71,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:21:43.30,0:21:47.47,Default,,0,0,0,,Асахина-кун, кешіріңіз, мен Акираны күте алмадым.
Dialogue: 0,0:21:47.55,0:21:49.68,Default,,0,0,0,,Жоқ, келісемін.
Dialogue: 0,0:21:49.76,0:21:53.85,Default,,0,0,0,,Ямато елінде аң аулауға болатын құбыжықтар деңгейін көтеру қиын болды.
Dialogue: 0,0:21:53.93,0:21:54.52,Default,,0,0,0,,Және...
Dialogue: 0,0:21:54.60,0:21:57.73,Default,,0,0,0,,Сато мен Асахинадан басқа мүшелер
Dialogue: 0,0:21:57.81,0:22:00.44,Default,,0,0,0,,Қару-жарақты жаңарту уақыты келді.
Dialogue: 0,0:22:00.52,0:22:02.82,Default,,0,0,0,,-ге келетін болсақ, сіз мақсат қоюыңыз керек ...
Dialogue: 0,0:22:03.90,0:22:05.65,Default,,0,0,0,,Аңдар құрлығы
Dialogue: 0,0:22:10.99,0:22:12.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:38.87,0:23:40.87,Default,,0,0,0,,～♪
