Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.00,0:00:10.67,Default,,0,0,0,,Қандай зор күш!
Dialogue: 0,0:00:13.26,0:00:16.93,Default,,0,0,0,,Кең ашық алаңда шын мәнінде өзін көрсетеді, иә?
Dialogue: 0,0:00:21.77,0:00:23.23,Default,,0,0,0,,Раббым!
Dialogue: 0,0:00:27.23,0:00:28.65,Default,,0,0,0,,Негізгі зал…
Dialogue: 0,0:00:28.73,0:00:31.65,Default,,0,0,0,,Мастердің сиқырлы қуат тұтынуы рұқсат етілген мәннен асып түседі
Dialogue: 0,0:00:31.74,0:00:33.40,Default,,0,0,0,,Өмірді қамтамасыз ету бұзылған
Dialogue: 0,0:00:33.49,0:00:34.90,Default,,0,0,0,,Көлеңкелік сиқырды мәжбүрлеп қосу
Dialogue: 0,0:00:35.78,0:00:37.53,Default,,0,0,0,,«Емдеу» режимі
Dialogue: 0,0:00:37.62,0:00:41.70,Default,,0,0,0,,Көлеңке сиқырында сақталған сиқырлы күштен қажетті соманы жинаңыз
Dialogue: 0,0:00:46.08,0:00:47.50,Default,,0,0,0,,Емдеу аяқталды
Dialogue: 0,0:00:47.58,0:00:49.88,Default,,0,0,0,,Көлеңкелік сиқырды белсендіру тоқтауы
Dialogue: 0,0:00:55.05,0:00:56.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:59.55,0:01:01.56,Default,,0,0,0,,♪～
Dialogue: 0,0:02:26.93,0:02:28.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:29.56,0:02:30.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:31.23,0:02:33.57,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:02:33.65,0:02:36.03,Default,,0,0,0,,Мырза, сіз ояусыз ба?
Dialogue: 0,0:02:36.11,0:02:36.99,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:02:37.99,0:02:39.24,Default,,0,0,0,,Қарға үйі
Dialogue: 0,0:02:40.28,0:02:43.20,Default,,0,0,0,,Мен ес-түссіз басты залды осында алып жүрдім.
Dialogue: 0,0:02:43.78,0:02:45.79,Default,,0,0,0,,Мен қанша сағат ұйықтадым?
Dialogue: 0,0:02:46.29,0:02:47.62,Default,,0,0,0,,5 сағат? 6 сағат?
Dialogue: 0,0:02:47.70,0:02:49.91,Default,,0,0,0,,Жоқ, бір күн бес сағат.
Dialogue: 0,0:02:50.00,0:02:51.17,Default,,0,0,0,,Не?
Dialogue: 0,0:02:52.08,0:02:53.46,Default,,0,0,0,,Таңқаларлық емес
Dialogue: 0,0:02:53.54,0:02:56.46,Default,,0,0,0,,Бас залдың сиқырлы күші толығымен таусылды.
Dialogue: 0,0:02:56.55,0:02:59.55,Default,,0,0,0,,Ол өмірінен айырылып қалуы мүмкін жағдайда болды.
Dialogue: 0,0:03:00.05,0:03:01.13,Default,,0,0,0,,Жылдам, ЖоЖоны әкел!
Dialogue: 0,0:03:01.63,0:03:02.47,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:02.55,0:03:05.14,Default,,0,0,0,,Көлеңке сиқыры өздігінен қозғала бастайды
Dialogue: 0,0:03:05.22,0:03:07.47,Default,,0,0,0,,Үлкен залға сиқырлы күш берді.
Dialogue: 0,0:03:08.22,0:03:10.44,Default,,0,0,0,,Тым негізсіз
Dialogue: 0,0:03:10.52,0:03:11.56,Default,,0,0,0,,Негізгі зал
Dialogue: 0,0:03:12.06,0:03:14.61,Default,,0,0,0,,Бұл не сиқыр?
Dialogue: 0,0:03:16.23,0:03:17.57,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:03:17.65,0:03:21.03,Default,,0,0,0,,Менің қазір ойлағаннан гөрі жақсырақ істерім бар.
Dialogue: 0,0:03:26.74,0:03:28.16,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:28.66,0:03:29.79,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:03:29.87,0:03:31.33,Default,,0,0,0,,Төсек жалдады
Dialogue: 0,0:03:31.41,0:03:33.29,Default,,0,0,0,,Төлемді сақтаңыз.
Dialogue: 0,0:03:34.13,0:03:35.79,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:03:35.88,0:03:37.21,Default,,0,0,0,,Амелияға көмектесіңіз
Dialogue: 0,0:03:37.30,0:03:39.55,Default,,0,0,0,,Сіз қайда екеніңізді білесіз бе?
Dialogue: 0,0:03:39.63,0:03:41.59,Default,,0,0,0,,1 күннен астам уақыт өтті
Dialogue: 0,0:03:41.67,0:03:45.76,Default,,0,0,0,,Жындар аумағына бара жатқанда немесе аумақта болуы мүмкін
Dialogue: 0,0:03:45.85,0:03:48.18,Default,,0,0,0,,Егер солай болса, онда жын-шайтан аймағына кіру керек.
Dialogue: 0,0:03:48.26,0:03:49.31,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:03:49.39,0:03:50.77,Default,,0,0,0,,Мен тынышпын!
Dialogue: 0,0:03:51.98,0:03:53.44,Default,,0,0,0,,Жай ғана асығыс
Dialogue: 0,0:03:53.52,0:03:56.61,Default,,0,0,0,,Жындармен қарусыз күреспекші болған жігіт.
Dialogue: 0,0:03:56.69,0:03:58.07,Default,,0,0,0,,Тыныштық қайда?
Dialogue: 0,0:03:58.15,0:04:00.07,Default,,0,0,0,,Уф... Менде жоқ нәрсеге көмектесе алмаймын.
Dialogue: 0,0:04:00.15,0:04:01.32,Default,,0,0,0,,Онда
Dialogue: 0,0:04:04.07,0:04:07.33,Default,,0,0,0,,Көру аймағының тарылуы – сабырсыздықтың белгісі.
Dialogue: 0,0:04:10.95,0:04:12.75,Default,,0,0,0,,Ол екі бөлікке бөлінді ме?
Dialogue: 0,0:04:12.83,0:04:15.75,Default,,0,0,0,,Қанжарды өлтірушіге пайдалану оңайырақ болар еді.
Dialogue: 0,0:04:16.25,0:04:20.05,Default,,0,0,0,,Материалдар мен шығындарды алдын ала төледім, сондықтан оларды тез арада қайтаруыңызды өтінемін.
Dialogue: 0,0:04:20.13,0:04:21.05,Default,,0,0,0,,алғыс айту
Dialogue: 0,0:04:21.13,0:04:23.09,Default,,0,0,0,,Айтпақшы, мен де саған мынаны қарызға беремін.
Dialogue: 0,0:04:24.80,0:04:25.72,Default,,0,0,0,,Сақина?
Dialogue: 0,0:04:25.80,0:04:29.47,Default,,0,0,0,,Оны батырлардың екінші немесе үшінші буыны жасаған деседі.
Dialogue: 0,0:04:30.77,0:04:33.85,Default,,0,0,0,,«Мен сені жетелейтін адаммын»
Dialogue: 0,0:04:34.35,0:04:36.19,Default,,0,0,0,,Сіз оны оқи аласыз деп ойлаймын.
Dialogue: 0,0:04:36.27,0:04:38.11,Default,,0,0,0,,Бұл мен болған дүниенің тілі.
Dialogue: 0,0:04:38.61,0:04:40.15,Default,,0,0,0,,Сонымен не? Бұл
Dialogue: 0,0:04:40.23,0:04:42.11,Default,,0,0,0,,Дәл сіз айтқандай.
Dialogue: 0,0:04:42.19,0:04:45.99,Default,,0,0,0,,Сақина киген адам қалаған нәрсенің бар екенін көрсетеді.
Dialogue: 0,0:04:46.07,0:04:46.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:52.20,0:04:54.12,Default,,0,0,0,,Дөрекі лабиринт бағытында.
Dialogue: 0,0:04:54.21,0:04:57.75,Default,,0,0,0,,Егер сіз жындар аумағына қарай бет алсаңыз, сіз бұл бағытта болмайсыз.
Dialogue: 0,0:04:57.83,0:05:02.01,Default,,0,0,0,,Неге екенін білмеймін, бірақ ол әлі лабиринтте қалып қойған сияқты.
Dialogue: 0,0:05:02.59,0:05:04.51,Default,,0,0,0,,Білу жеткілікті
Dialogue: 0,0:05:05.93,0:05:06.76,Default,,0,0,0,,Кишибе Рохан секілді күші бар біреу!
Dialogue: 0,0:05:08.09,0:05:09.43,Default,,0,0,0,,Кеттік, Йору
Dialogue: 0,0:05:12.64,0:05:13.64,Default,,0,0,0,,Үлкен зал
Dialogue: 0,0:05:14.14,0:05:15.73,Default,,0,0,0,,Өйткені мен құл жынмын
Dialogue: 0,0:05:15.81,0:05:18.65,Default,,0,0,0,,Иеміз қайда жүрсе де, оның соңынан еріңіз.
Dialogue: 0,0:05:18.73,0:05:21.23,Default,,0,0,0,,Бірақ ол енді маған ештеңе істемейді.
Dialogue: 0,0:05:21.32,0:05:24.07,Default,,0,0,0,,А, мен енді кешегідей ештеңе істемеймін.
Dialogue: 0,0:05:24.57,0:05:26.74,Default,,0,0,0,,Мен өлсем, сен де өлесің.
Dialogue: 0,0:05:26.82,0:05:28.36,Default,,0,0,0,,Бұл да дұрыс...
Dialogue: 0,0:05:28.45,0:05:31.20,Default,,0,0,0,,Жоқ, тек өлме.
Dialogue: 0,0:05:32.83,0:05:34.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:46.55,0:05:49.80,Default,,0,0,0,,Иә, иә, бәрі жақсы жүріп жатыр.
Dialogue: 0,0:05:49.89,0:05:53.47,Default,,0,0,0,,Жындар ғана қолдана алатын құбыжықтарды басқару әдістері
Dialogue: 0,0:05:53.56,0:05:55.64,Default,,0,0,0,,Эльфтерге, адамдарға және хайуанаттарға қолданылғанда
Dialogue: 0,0:05:55.73,0:05:57.31,Default,,0,0,0,,Не болар екен деп ойлаймын.
Dialogue: 0,0:05:57.39,0:05:59.85,Default,,0,0,0,,Менде әрқашан күмән болды, солай емес пе?
Dialogue: 0,0:05:59.94,0:06:02.11,Default,,0,0,0,,Сендердің арқаларыңда жұмбақ шешілді.
Dialogue: 0,0:06:02.19,0:06:04.48,Default,,0,0,0,,Мен оны манипуляциялауға дейін барған жоқпын.
Dialogue: 0,0:06:04.57,0:06:07.74,Default,,0,0,0,,Элфтің қозғалысын толығымен тоқтатуға болады.
Dialogue: 0,0:06:09.36,0:06:10.99,Default,,0,0,0,,Бұл жақсы өнім.
Dialogue: 0,0:06:11.07,0:06:12.03,Default,,0,0,0,,Неге...
Dialogue: 0,0:06:12.12,0:06:14.29,Default,,0,0,0,,Эй, мен дыбыс шығара аламын.
Dialogue: 0,0:06:14.95,0:06:17.54,Default,,0,0,0,,Дұрыс, жалықтырғым келмейді
Dialogue: 0,0:06:17.62,0:06:19.62,Default,,0,0,0,,Сен неге лабиринттесің?
Dialogue: 0,0:06:19.71,0:06:24.13,Default,,0,0,0,,Көрдіңіз бе, екінші дәрежелі жын телепортацияның сиқырлы шеңберін пайдалана алады.
Dialogue: 0,0:06:24.63,0:06:28.30,Default,,0,0,0,,Мен үшінші орындамын, сондықтан ол менің бастығым шығар.
Dialogue: 0,0:06:28.38,0:06:32.05,Default,,0,0,0,,Сонымен мен сол сиқырлы шеңберді пайдаланып, осы лабиринтке келдім.
Dialogue: 0,0:06:32.14,0:06:35.06,Default,,0,0,0,,Қайту жолына ақша табу керек, солай ма?
Dialogue: 0,0:06:35.64,0:06:39.31,Default,,0,0,0,,Енді мен бастығымның мені алып кетуін күтіп отырмын.
Dialogue: 0,0:06:39.94,0:06:41.27,Default,,0,0,0,,Қашан келесіз?
Dialogue: 0,0:06:41.35,0:06:43.19,Default,,0,0,0,,Енді, қашан?
Dialogue: 0,0:06:43.27,0:06:46.78,Default,,0,0,0,,Сіз қозғала алмасаңыз да, ақпарат жинағыңыз келеді.
Dialogue: 0,0:06:46.86,0:06:49.40,Default,,0,0,0,,Жақсы, менден бірдеңе сұра.
Dialogue: 0,0:06:49.49,0:06:51.91,Default,,0,0,0,,Егер мен бірдеңе білсем, оған жауап беремін.
Dialogue: 0,0:06:51.99,0:06:55.49,Default,,0,0,0,,Осы арада әлгі өлтіруші келуі мүмкін.
Dialogue: 0,0:06:55.58,0:07:00.16,Default,,0,0,0,,Оған қандай мәлімет берсең де, ол мені жеңе алмайды.
Dialogue: 0,0:07:00.25,0:07:01.79,Default,,0,0,0,,(Аттың айғайы)
Dialogue: 0,0:07:02.29,0:07:03.04,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:03.13,0:07:03.79,Default,,0,0,0,,Ах
Dialogue: 0,0:07:03.88,0:07:06.30,Default,,0,0,0,,Уайымдама, сен өлмейсің.
Dialogue: 0,0:07:06.38,0:07:09.42,Default,,0,0,0,,Мен оны жын патшаға тірідей ұсынуым керек.
Dialogue: 0,0:07:10.22,0:07:12.30,Default,,0,0,0,,Себебі мен ашуланамын.
Dialogue: 0,0:07:16.31,0:07:18.68,Default,,0,0,0,,Жарық әлі жер астын көрсетеді.
Dialogue: 0,0:07:19.52,0:07:21.81,Default,,0,0,0,,Амелия ханым күткендей лабиринт ішінде.
Dialogue: 0,0:07:21.89,0:07:25.36,Default,,0,0,0,,Оның үстіне, олардың жеткілікті терең иерархияда тұрғаны даусыз.
Dialogue: 0,0:07:25.44,0:07:26.73,Default,,0,0,0,,Тезірек жүр, Йору.
Dialogue: 0,0:07:26.82,0:07:27.57,Default,,0,0,0,,Түсінді
Dialogue: 0,0:07:27.65,0:07:28.94,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:07:30.15,0:07:31.70,Default,,0,0,0,,Мен Акира Ода мырзамен кездесемін.
Dialogue: 0,0:07:32.28,0:07:34.37,Default,,0,0,0,,Айтар сөзім бар деп жүгіріп келдім.
Dialogue: 0,0:07:34.45,0:07:34.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:36.28,0:07:37.37,Default,,0,0,0,,Сіз...
Dialogue: 0,0:07:38.37,0:07:39.70,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:39.79,0:07:41.58,Default,,0,0,0,,Амелия ханшайымы тұзаққа түскен лабиринтте.
Dialogue: 0,0:07:41.66,0:07:43.33,Default,,0,0,0,,Мені де алыңыз...
Dialogue: 0,0:07:43.42,0:07:45.84,Default,,0,0,0,,Амелия қайда екенін қайдан білесің?
Dialogue: 0,0:07:45.92,0:07:47.71,Default,,0,0,0,,Жауап берсең мен сені өлтіремін.
Dialogue: 0,0:07:48.30,0:07:51.92,Default,,0,0,0,,«Жақсартылған иіс» дағдысын қолдандым
Dialogue: 0,0:07:52.01,0:07:56.30,Default,,0,0,0,,Амелия ханшайымының иісі лабиринттің кіреберісіне тоқтады.
Dialogue: 0,0:07:56.39,0:08:00.06,Default,,0,0,0,,Сіз сондай-ақ осы көше арқылы лабиринтке бара жатқан боларсыз.
Dialogue: 0,0:08:00.14,0:08:01.48,Default,,0,0,0,,Мен оны иіс арқылы сездім.
Dialogue: 0,0:08:01.56,0:08:02.94,Default,,0,0,0,,Иіс сезу қабілеті жақсарады
Dialogue: 0,0:08:03.02,0:08:06.77,Default,,0,0,0,,Бұл хайуанаттарда пайда болу мүмкіндігі жоғары дағды.
Dialogue: 0,0:08:06.86,0:08:08.61,Default,,0,0,0,,Бұл мағынасы бар.
Dialogue: 0,0:08:08.69,0:08:09.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:09.82,0:08:11.49,Default,,0,0,0,,Маған мән-жайды айтыңыз
Dialogue: 0,0:08:12.32,0:08:14.66,Default,,0,0,0,,Мен Лиа Лагунмын
Dialogue: 0,0:08:14.74,0:08:17.99,Default,,0,0,0,,Мен Уруктың бірінші ханшайымымын, хайуан халқымын.
Dialogue: 0,0:08:18.08,0:08:22.46,Default,,0,0,0,,Біз Жын патшасы Амелия ханшайымнан кейін қозғала бастағаны туралы ақпарат алдық.
Dialogue: 0,0:08:22.54,0:08:24.46,Default,,0,0,0,,Мен сізге ескерту айтқым келді.
Dialogue: 0,0:08:24.54,0:08:25.88,Default,,0,0,0,,Неге бірден келмедің?
Dialogue: 0,0:08:25.96,0:08:30.00,Default,,0,0,0,,Мм... Дәлелсіз маған сенесіз деп ойлаймын.
Dialogue: 0,0:08:30.09,0:08:33.59,Default,,0,0,0,,Әрі қарай тергеп жүріп, кешегі әбігерді таптым.
Dialogue: 0,0:08:34.26,0:08:36.64,Default,,0,0,0,,Мен оны пайдаланғым келмейді, бірақ менің таңдауым жоқ.
Dialogue: 0,0:08:40.14,0:08:41.93,Default,,0,0,0,,Сіз өтірік айтпаған сияқтысыз.
Dialogue: 0,0:08:42.52,0:08:44.77,Default,,0,0,0,,Құдайдың тосқауылы қандай шеберлік түріне жатады?
Dialogue: 0,0:08:44.85,0:08:46.31,Default,,0,0,0,,Не? Неге олай?
Dialogue: 0,0:08:46.40,0:08:47.19,Default,,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:08:47.77,0:08:50.02,Default,,0,0,0,,Бір… Қалыпты кедергі
Dialogue: 0,0:08:50.11,0:08:52.40,Default,,0,0,0,,Белгіленген кеңістікте созылғанымен
Dialogue: 0,0:08:52.49,0:08:53.53,Default,,0,0,0,,Құдайдың кедергісі
Dialogue: 0,0:08:53.61,0:08:55.95,Default,,0,0,0,,Қозғалатын заттарға да бекітуге болады
Dialogue: 0,0:08:56.03,0:08:57.91,Default,,0,0,0,,Оны адамның өзіне де қолдануға бола ма?
Dialogue: 0,0:08:57.99,0:08:59.20,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:08:59.28,0:09:01.12,Default,,0,0,0,,Бұл сізге көмектеседі деп үміттенемін.
Dialogue: 0,0:09:01.62,0:09:03.41,Default,,0,0,0,,Ешқашан берме...
Dialogue: 0,0:09:04.00,0:09:07.83,Default,,0,0,0,,Жын патшасы Амелия ханшайымының қайта тірілу сиқырына ұмтылады.
Dialogue: 0,0:09:12.51,0:09:14.05,Default,,0,0,0,,-(Акира) Тезірек мініп кет -Аа...
Dialogue: 0,0:09:14.13,0:09:16.80,Default,,0,0,0,,Саған сенуге бола ма? Негізгі зал
Dialogue: 0,0:09:16.88,0:09:20.18,Default,,0,0,0,,Бұл жігіттің шеберлігі Амелияны қорғауға тиімді.
Dialogue: 0,0:09:21.10,0:09:23.39,Default,,0,0,0,,Менің сөздерім айтқандай, мен көмектесемін.
Dialogue: 0,0:09:23.47,0:09:24.68,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:24.77,0:09:27.69,Default,,0,0,0,,Жын патшасы менің қайта тірілу сиқырымды пайдаланады ма?
Dialogue: 0,0:09:28.27,0:09:31.82,Default,,0,0,0,,Сендер жындар мәңгілікке тең өмір сүресіңдер.
Dialogue: 0,0:09:31.90,0:09:36.15,Default,,0,0,0,,Оның үстіне олар сирек өлетін ең күшті нәсіл.
Dialogue: 0,0:09:36.24,0:09:38.66,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:09:38.74,0:09:40.83,Default,,0,0,0,,Бұл, әрине, сирек кездесетін сиқыр.
Dialogue: 0,0:09:40.91,0:09:43.62,Default,,0,0,0,,Өлгеннен кейін тым ұзақ болса жарамсыз
Dialogue: 0,0:09:43.70,0:09:47.08,Default,,0,0,0,,Не керек, оны қолданғаннан кейін бірнеше күн пайдалана алмайсыз, солай ма?
Dialogue: 0,0:09:47.16,0:09:49.67,Default,,0,0,0,,Бұл соншалықты ыңғайлы емес.
Dialogue: 0,0:09:49.75,0:09:51.54,Default,,0,0,0,,Сіз көп нәрсені білесіз.
Dialogue: 0,0:09:51.63,0:09:53.34,Default,,0,0,0,,Ал, бұл анық
Dialogue: 0,0:09:53.42,0:09:55.63,Default,,0,0,0,,Осыдан кейін сені мен өлтірсем де, өлтіруші.
Dialogue: 0,0:09:55.72,0:09:57.63,Default,,0,0,0,,Қайта тірілту мүмкін емес
Dialogue: 0,0:09:57.72,0:10:00.85,Default,,0,0,0,,Өйткені сіз жаңа ғана өлімге әкелетін жарақат алдыңыз.
Dialogue: 0,0:10:00.93,0:10:04.22,Default,,0,0,0,,Өзіңе қайта тірілу сиқырын қолдандың.
Dialogue: 0,0:10:04.31,0:10:05.56,Default,,0,0,0,,(Аттың айғайы)
Dialogue: 0,0:10:06.73,0:10:09.65,Default,,0,0,0,,Ал, мен оны асыға күтемін.
Dialogue: 0,0:10:09.73,0:10:14.03,Default,,0,0,0,,Егер өлтіруші өлсе, сен қалай жылар едің?
Dialogue: 0,0:10:14.53,0:10:15.48,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:10:16.57,0:10:19.57,Default,,0,0,0,,Әпкең де жылап тұрды емес пе?
Dialogue: 0,0:10:19.66,0:10:22.58,Default,,0,0,0,,Мен одан асып түсетін нәрсеге үміттенемін.
Dialogue: 0,0:10:22.66,0:10:24.16,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:27.71,0:10:30.29,Default,,0,0,0,,Менімен бірінші рет кездесіп тұрған жоқсыз.
Dialogue: 0,0:10:30.79,0:10:31.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:31.71,0:10:33.92,Default,,0,0,0,,Неліктен ол кезде Лейтис елінде болдыңыз?
Dialogue: 0,0:10:35.88,0:10:39.93,Default,,0,0,0,,Менің отбасымды қара шлам ұрлап кетті.
Dialogue: 0,0:10:40.01,0:10:41.68,Default,,0,0,0,,Мен оның жүрген жерін бақылап отырдым.
Dialogue: 0,0:10:41.76,0:10:43.18,Default,,0,0,0,,Қара шлам?
Dialogue: 0,0:10:43.26,0:10:44.43,Default,,0,0,0,,Иә
Dialogue: 0,0:10:44.51,0:10:47.52,Default,,0,0,0,,Енді ол корольдік отбасына асырап алған бала ретінде қосылды.
Dialogue: 0,0:10:47.60,0:10:49.10,Default,,0,0,0,,Бұған дейін И
Dialogue: 0,0:10:49.19,0:10:52.15,Default,,0,0,0,,Мен ауылдағы шағын ауылда тұрдым.
Dialogue: 0,0:10:53.31,0:10:56.90,Default,,0,0,0,,Бір күні ауылда қара шлам пайда болды...
Dialogue: 0,0:10:59.40,0:11:02.70,Default,,0,0,0,,Шын болса, бір соққыда жеңетін құбыжық болар еді.
Dialogue: 0,0:11:02.78,0:11:04.58,Default,,0,0,0,,Әке, шеше, іні...
Dialogue: 0,0:11:04.66,0:11:07.33,Default,,0,0,0,,Барлық ауыл тұрғындары тұтқынға алынды
Dialogue: 0,0:11:07.41,0:11:09.00,Default,,0,0,0,,Сол шлам
Dialogue: 0,0:11:09.08,0:11:12.08,Default,,0,0,0,,Оны біреу өзгертіп, кейін шығарған!
Dialogue: 0,0:11:12.67,0:11:14.46,Default,,0,0,0,,Дәл солай шығар
Dialogue: 0,0:11:18.84,0:11:21.13,Default,,0,0,0,,Оның қорғаушы қабілеті сатып алынды.
Dialogue: 0,0:11:21.22,0:11:24.51,Default,,0,0,0,,Дәл сол кезде патша отбасы мені асырап алуға шақырды.
Dialogue: 0,0:11:25.22,0:11:27.31,Default,,0,0,0,,Мен жақында ханшайым боламын
Dialogue: 0,0:11:27.39,0:11:31.31,Default,,0,0,0,,Сол кезде болған оқиғаны зерттеу үшін сол өкілеттікті пайдаланыңыз.
Dialogue: 0,0:11:31.39,0:11:33.27,Default,,0,0,0,,Біз Лейтис еліне келдік.
Dialogue: 0,0:11:33.90,0:11:35.27,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:11:35.90,0:11:38.44,Default,,0,0,0,,Отбасы мен ауыл адамдарынан басқа
Dialogue: 0,0:11:38.53,0:11:41.53,Default,,0,0,0,,Көптеген аңдар мен адамдар ұрланған.
Dialogue: 0,0:11:41.61,0:11:44.37,Default,,0,0,0,,Аз болғанымен, эльфтер де бар.
Dialogue: 0,0:11:44.87,0:11:46.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:47.24,0:11:49.70,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:11:49.79,0:11:52.92,Default,,0,0,0,,Барлығы Батырды шақыру үшін
Dialogue: 0,0:11:53.00,0:11:55.17,Default,,0,0,0,,Оның өмірі қиылды
Dialogue: 0,0:11:55.75,0:11:59.67,Default,,0,0,0,,Отбасын, жерлестерін құрбандыққа шалып, шақырылған батыр.
Dialogue: 0,0:11:59.76,0:12:03.43,Default,,0,0,0,,Мен сол жерде болдым, қарап шығу керек деп ойладым.
Dialogue: 0,0:12:04.51,0:12:06.97,Default,,0,0,0,,Мен де осы дүниеге шақырылдым.
Dialogue: 0,0:12:07.47,0:12:10.73,Default,,0,0,0,,Ол сіз ең жек көретін адамдардың бірі шығар.
Dialogue: 0,0:12:10.81,0:12:12.77,Default,,0,0,0,,Бұл сенің кінәң емес
Dialogue: 0,0:12:12.85,0:12:16.73,Default,,0,0,0,,Біз кешіре алмайтын нәрсе - бізді шақырған патша мен ханшайым.
Dialogue: 0,0:12:17.52,0:12:20.53,Default,,0,0,0,,Оларды кешіре алмайтын себебім болса, менде де бар.
Dialogue: 0,0:12:21.03,0:12:22.40,Default,,0,0,0,,Айтпақшы,
Dialogue: 0,0:12:22.49,0:12:26.07,Default,,0,0,0,,Жындардың басып кіруіне қарсы күресу сияқты шақыру себебі де күдікті.
Dialogue: 0,0:12:26.16,0:12:28.91,Default,,0,0,0,,Бұл күмәнді өлшем емес.
Dialogue: 0,0:12:28.99,0:12:30.24,Default,,0,0,0,,Өтірік
Dialogue: 0,0:12:30.33,0:12:31.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:31.37,0:12:35.71,Default,,0,0,0,,Ең болмағанда соңғы 100 жылда жындар бізге қарсы соғысқан жоқ.
Dialogue: 0,0:12:36.29,0:12:39.46,Default,,0,0,0,,Жындар жиіркенішті зұлымдық сияқты әсер қалдырады.
Dialogue: 0,0:12:39.55,0:12:41.92,Default,,0,0,0,,Басқа нәсілдер бөліседі
Dialogue: 0,0:12:42.01,0:12:42.76,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:42.84,0:12:43.97,Default,,0,0,0,,Мен оны көремін.
Dialogue: 0,0:12:44.05,0:12:46.51,Default,,0,0,0,,Бұл Brute лабиринтіне кіретін есік.
Dialogue: 0,0:12:47.01,0:12:48.47,Default,,0,0,0,,Тек алға.
Dialogue: 0,0:12:49.47,0:12:52.35,Default,,0,0,0,,Иә, төмен түсетін баспалдақтарды ашу шарттары
Dialogue: 0,0:12:52.43,0:12:56.44,Default,,0,0,0,,Сол қабаттағы құбыжықтардың белгілі бір санын жеңіңіз... солай ма?
Dialogue: 0,0:12:56.52,0:12:58.98,Default,,0,0,0,,Бірінші жын патша жасаған.
Dialogue: 0,0:12:59.06,0:13:01.73,Default,,0,0,0,,Бұл барлық лабиринттерге ортақ ереже.
Dialogue: 0,0:13:01.82,0:13:03.19,Default,,0,0,0,,Шығу жолы жоқ
Dialogue: 0,0:13:03.28,0:13:05.28,Default,,0,0,0,,Істі бірден аяқтау үшін көлеңкелі сиқырды пайдаланыңыз
Dialogue: 0,0:13:05.36,0:13:08.12,Default,,0,0,0,,Күтіңіз. Келген кезде сіз жындармен күресесіз.
Dialogue: 0,0:13:08.20,0:13:10.49,Default,,0,0,0,,Негізгі залды тұтынудан аулақ болу керек.
Dialogue: 0,0:13:10.58,0:13:11.62,Default,,0,0,0,,Сонда не істеуіміз керек?
Dialogue: 0,0:13:12.20,0:13:14.21,Default,,0,0,0,,Мен дірілдеп жатқанда, Амелия...
Dialogue: 0,0:13:14.71,0:13:18.17,Default,,0,0,0,,Мен кішкентай шабақтарды түрлендіремін және тепкілеймін
Dialogue: 0,0:13:18.25,0:13:20.38,Default,,0,0,0,,Сіздің аяқтарыңыз да қазіргіден жылдамырақ болады.
Dialogue: 0,0:13:20.46,0:13:21.38,Default,,0,0,0,,Тек...
Dialogue: 0,0:13:22.96,0:13:26.84,Default,,0,0,0,,Мен өзімнің ұтымдылығымды бұл формада сақтай алатыныма сенімді емеспін.
Dialogue: 0,0:13:26.93,0:13:31.14,Default,,0,0,0,,Мен өзімді жоғалтып, Иемізге зиян келтіруім мүмкін.
Dialogue: 0,0:13:32.56,0:13:36.14,Default,,0,0,0,,Мен енді мені инстинкт тұтынбайды деп ойлағым келеді...
Dialogue: 0,0:13:36.64,0:13:39.44,Default,,0,0,0,,Мен оны бақылайтынымды айттым.
Dialogue: 0,0:13:39.52,0:13:42.94,Default,,0,0,0,,Мен сенің жаныңда болсам, бәрі жақсы болады.
Dialogue: 0,0:13:45.24,0:13:46.32,Default,,0,0,0,,Негізгі зал…
Dialogue: 0,0:13:46.82,0:13:49.37,Default,,0,0,0,,Йору Мен саған ғана сене аламын
Dialogue: 0,0:13:50.45,0:13:51.58,Default,,0,0,0,,Түсінді
Dialogue: 0,0:13:51.66,0:13:55.66,Default,,0,0,0,,Қожайынның қызметшісі болып еңбектенейік!
Dialogue: 0,0:13:57.29,0:13:59.42,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:14:00.71,0:14:02.42,Default,,0,0,0,,- (Акира) Кеттік! -иә!
Dialogue: 0,0:14:07.76,0:14:08.88,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:14:08.97,0:14:10.43,Default,,0,0,0,,Мен саған сынақ қоямын
Dialogue: 0,0:14:10.51,0:14:12.05,Default,,0,0,0,,Лақтырсаң, бітті!
Dialogue: 0,0:14:12.14,0:14:13.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:14.31,0:14:15.18,Default,,0,0,0,,Yoru…
Dialogue: 0,0:14:19.27,0:14:21.36,Default,,0,0,0,,Эй Йору, сен мені естисің бе?
Dialogue: 0,0:14:21.86,0:14:22.94,Default,,0,0,0,,- (Акира) Грррр... - Кьяа!
Dialogue: 0,0:14:23.65,0:14:24.48,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:14:24.98,0:14:26.74,Default,,0,0,0,,Менің дауысымды тыңда! Ия!
Dialogue: 0,0:14:26.82,0:14:28.20,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:14:28.28,0:14:29.15,Default,,0,0,0,,Йору!
Dialogue: 0,0:14:29.24,0:14:30.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:33.24,0:14:34.79,Default,,0,0,0,,Мырза...
Dialogue: 0,0:14:35.29,0:14:37.91,Default,,0,0,0,,Иә, мен осындамын.
Dialogue: 0,0:14:38.00,0:14:42.25,Default,,0,0,0,,Даусыңызды жіберуді жалғастырсаңыз пайдалы болар еді.
Dialogue: 0,0:14:42.96,0:14:45.25,Default,,0,0,0,,Есі қалса керек
Dialogue: 0,0:14:45.84,0:14:47.59,Default,,0,0,0,,Бұл арзан.
Dialogue: 0,0:14:52.30,0:14:54.01,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:14:54.51,0:14:55.68,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:55.76,0:14:59.35,Default,,0,0,0,,Эй Йору, бұрын айтқаныңды жалғастырғың келе ме?
Dialogue: 0,0:15:00.52,0:15:03.19,Default,,0,0,0,,Жындарды неге сонша жек көреді?
Dialogue: 0,0:15:03.73,0:15:08.28,Default,,0,0,0,,Бірінші жын патшасы басқа нәсілдерге шабуыл жасағаны сөзсіз.
Dialogue: 0,0:15:08.36,0:15:11.07,Default,,0,0,0,,Тақыр құрлықтағы жындар Жанартау
Dialogue: 0,0:15:11.16,0:15:13.49,Default,,0,0,0,,Бұл амалсыз қуылғаны үшін кек алу болса керек.
Dialogue: 0,0:15:14.24,0:15:16.87,Default,,0,0,0,,Ол сол дәуірде сақталған.
Dialogue: 0,0:15:17.45,0:15:21.46,Default,,0,0,0,,«Жын патшасы зұлымдықтың иесі, ал оны жеңгендер – батырлар».
Dialogue: 0,0:15:21.54,0:15:23.08,Default,,0,0,0,,Болжамдар дегеніміз не?
Dialogue: 0,0:15:23.17,0:15:24.17,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:24.25,0:15:26.38,Default,,0,0,0,,Бұл бақытсыздыққа әкелді
Dialogue: 0,0:15:26.96,0:15:31.88,Default,,0,0,0,,Бірнеше ұрпақ бұрын жын патша әйелін қаскүнем өлтірді.
Dialogue: 0,0:15:31.97,0:15:37.60,Default,,0,0,0,,Батыр да емес, Батырларға сүйсініп, абырой алғысы келетін ақымақ.
Dialogue: 0,0:15:37.68,0:15:40.39,Default,,0,0,0,,Жалғыз демалып жатқан әйелімді бағып-қағып алдым.
Dialogue: 0,0:15:41.27,0:15:43.31,Default,,0,0,0,,Әйелінен айырылған жын патша
Dialogue: 0,0:15:43.40,0:15:48.40,Default,,0,0,0,,Отбасын, достарын жақсы көретін ақкөңіл адам деп естідім.
Dialogue: 0,0:15:48.48,0:15:50.74,Default,,0,0,0,,Бұл жиіркенішті оқиға.
Dialogue: 0,0:15:51.24,0:15:55.12,Default,,0,0,0,,Бірақ егер қазіргі жын патша Амелияны ұрлауға бұйрық берсе.
Dialogue: 0,0:15:55.20,0:15:56.99,Default,,0,0,0,,Менің кешіруге ниетім жоқ
Dialogue: 0,0:15:57.08,0:15:58.37,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:15:58.87,0:16:00.87,Default,,0,0,0,,Есіңізде болсын
Dialogue: 0,0:16:00.96,0:16:03.17,Default,,0,0,0,,Жындар да әртүрлі.
Dialogue: 0,0:16:04.75,0:16:08.71,Default,,0,0,0,,Басқа нәсілдерді жәндіктерден басқа санайтын қатыгез адамдар бар.
Dialogue: 0,0:16:10.97,0:16:15.01,Default,,0,0,0,,Кейбір адамдар қақтығысты болдырмауға тырысады және үйлесімділікке ұмтылады.
Dialogue: 0,0:16:15.09,0:16:16.30,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:17.85,0:16:19.18,Default,,0,0,0,,Есте сақтау
Dialogue: 0,0:16:22.52,0:16:23.14,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:16:23.23,0:16:24.56,Default,,0,0,0,,Амелия!
Dialogue: 0,0:16:25.94,0:16:26.56,Default,,0,0,0,,Иә
Dialogue: 0,0:16:31.07,0:16:32.78,Default,,0,0,0,,Мен оны қайтарып аламын.
Dialogue: 0,0:16:34.91,0:16:36.03,Default,,0,0,0,,Риа кедергісі!
Dialogue: 0,0:16:36.12,0:16:36.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:39.87,0:16:41.12,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:41.20,0:16:43.79,Default,,0,0,0,,Мен күткеннен әлдеқайда жылдам
Dialogue: 0,0:16:43.87,0:16:46.83,Default,,0,0,0,,Демон патшаның оң қолы күткендей.
Dialogue: 0,0:16:46.92,0:16:49.59,Default,,0,0,0,,Мен оның Церберге айналады деп ойламадым.
Dialogue: 0,0:16:50.84,0:16:52.92,Default,,0,0,0,,Кешіріңіз, Мырза.
Dialogue: 0,0:16:53.01,0:16:54.55,Default,,0,0,0,,Біраз уақыт қозғала алмайды
Dialogue: 0,0:16:54.63,0:16:56.93,Default,,0,0,0,,Мен не айта аламын? Мұның бәрі сенің арқаң.
Dialogue: 0,0:16:57.01,0:16:58.68,Default,,0,0,0,,Кешіріңіз Акира!
Dialogue: 0,0:16:58.76,0:17:00.18,Default,,0,0,0,,Бұл менің кінәм...
Dialogue: 0,0:17:00.76,0:17:02.64,Default,,0,0,0,,Сіз де не айттыңыз?
Dialogue: 0,0:17:02.73,0:17:03.85,Default,,0,0,0,,Мен әдеттегідеймін.
Dialogue: 0,0:17:03.93,0:17:06.19,Default,,0,0,0,,Тек өзіңіз қалаған нәрсені жасаңыз.
Dialogue: 0,0:17:06.27,0:17:07.44,Default,,0,0,0,,А...
Dialogue: 0,0:17:08.11,0:17:10.02,Default,,0,0,0,,Сіз оны ешкімге бермейсіз
Dialogue: 0,0:17:11.57,0:17:13.32,Default,,0,0,0,,Мен солай шештім.
Dialogue: 0,0:17:13.90,0:17:15.15,Default,,0,0,0,,Акира…
Dialogue: 0,0:17:15.78,0:17:17.57,Default,,0,0,0,,Я~
Dialogue: 0,0:17:17.66,0:17:20.53,Default,,0,0,0,,Әдемі бірдеңе айтасың, өлтіруші.
Dialogue: 0,0:17:20.62,0:17:22.91,Default,,0,0,0,,Сіз мені кешірмейсіз
Dialogue: 0,0:17:23.00,0:17:24.62,Default,,0,0,0,,Рұқсат емес пе?
Dialogue: 0,0:17:24.71,0:17:27.79,Default,,0,0,0,,Жақында өлетін адам осылай айтса да
Dialogue: 0,0:17:28.29,0:17:30.17,Default,,0,0,0,,Бұл мүлдем резонанс тудырмайды.
Dialogue: 0,0:17:30.25,0:17:31.67,Default,,0,0,0,,Лорд Авум
Dialogue: 0,0:17:31.75,0:17:33.30,Default,,0,0,0,,Жын патшасының бұйрығы
Dialogue: 0,0:17:33.38,0:17:36.18,Default,,0,0,0,,Ол Акира Оданы Жын патшасының сарайына апаруы керек еді.
Dialogue: 0,0:17:36.26,0:17:37.63,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:37.72,0:17:39.43,Default,,0,0,0,,Мен алған бұйрықтар болды
Dialogue: 0,0:17:39.51,0:17:42.43,Default,,0,0,0,,«Маған пері ханшайымын өлтірмей әкеліңіз».
Dialogue: 0,0:17:42.51,0:17:45.18,Default,,0,0,0,,«Асасинді өлтіріңіз, өйткені ол сіздің жолыңызда»
Dialogue: 0,0:17:45.27,0:17:47.56,Default,,0,0,0,,Ақымақ! Бұлай болмауы керек...
Dialogue: 0,0:17:47.64,0:17:50.61,Default,,0,0,0,,Сіз ойыңызды өзгерттіңіз бе, жын патша?
Dialogue: 0,0:17:50.69,0:17:52.32,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:17:54.19,0:17:55.53,Default,,0,0,0,,Тосын шабуыл?
Dialogue: 0,0:17:55.61,0:17:58.24,Default,,0,0,0,,Ассасинге ұқсайды, бірақ қызық
Dialogue: 0,0:17:58.32,0:18:00.12,Default,,0,0,0,,Сіз бұл жұмыс істейді деп ойладыңыз ба?
Dialogue: 0,0:18:00.20,0:18:00.99,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:05.41,0:18:06.00,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:06.08,0:18:07.16,Default,,0,0,0,,(Аттың айғайы)
Dialogue: 0,0:18:07.92,0:18:10.38,Default,,0,0,0,,Адам үшін барымды саламын.
Dialogue: 0,0:18:10.46,0:18:12.54,Default,,0,0,0,,Бұл ұзаққа созылады деп ойламадым
Dialogue: 0,0:18:14.84,0:18:15.71,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:16.59,0:18:17.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:25.52,0:18:29.02,Default,,0,0,0,,Неге... Акира-саманың да кедергісі бар болса да.
Dialogue: 0,0:18:29.10,0:18:32.31,Default,,0,0,0,,Сол найзаның сиқырлы күші жоғары шоғырланған.
Dialogue: 0,0:18:32.40,0:18:36.32,Default,,0,0,0,,Ешқандай кедергі болмаса, сызат сізді өлтіретін еді.
Dialogue: 0,0:18:37.03,0:18:40.82,Default,,0,0,0,,Жын-шайтандарға осыншама төзе алатыныңыз таң қалдырады.
Dialogue: 0,0:18:40.91,0:18:44.37,Default,,0,0,0,,Сіздің шабуылыңыз маған әлі бір рет тиген жоқ.
Dialogue: 0,0:18:45.41,0:18:47.33,Default,,0,0,0,,Енді оны аяқтаймыз ба?
Dialogue: 0,0:18:47.41,0:18:51.00,Default,,0,0,0,,Иә, мен де солай ойладым.
Dialogue: 0,0:18:51.71,0:18:53.46,Default,,0,0,0,,Көлеңке сиқыры іске қосылды!
Dialogue: 0,0:18:58.84,0:19:02.09,Default,,0,0,0,,Көлеңкелер үлкен залдың қанына жиналады.
Dialogue: 0,0:19:06.39,0:19:07.10,Default,,0,0,0,,Көлеңке аңы
Dialogue: 0,0:19:09.69,0:19:10.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:12.65,0:19:13.94,Default,,0,0,0,,Бұл…
Dialogue: 0,0:19:15.61,0:19:16.53,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:19:20.61,0:19:21.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:22.70,0:19:23.78,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:19:26.29,0:19:27.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:30.66,0:19:32.08,Default,,0,0,0,,Акира керемет
Dialogue: 0,0:19:32.17,0:19:35.50,Default,,0,0,0,,Жын жарысында үшінші орынмен жарысу деген нені білдіреді?
Dialogue: 0,0:19:35.59,0:19:37.34,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:19:37.42,0:19:41.51,Default,,0,0,0,,（）
Dialogue: 0,0:19:41.59,0:19:42.38,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:42.47,0:19:43.39,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:19:43.47,0:19:45.72,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:19:52.48,0:19:54.10,Default,,0,0,0,,Демек, ойлағанымдай…
Dialogue: 0,0:19:54.19,0:19:57.32,Default,,0,0,0,,Жындар құбыжықтардың кез келген санын пайдалана алады.
Dialogue: 0,0:19:57.40,0:19:58.23,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:19:58.32,0:19:59.99,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:20:02.65,0:20:05.07,Default,,0,0,0,,Көлеңкелік сиқырды бірден қайта бастау мүмкін емес.
Dialogue: 0,0:20:05.57,0:20:06.49,Default,,0,0,0,,Сіз қалай өмір сүресіз?
Dialogue: 0,0:20:09.20,0:20:11.33,Default,,0,0,0,,Құдайдың кері кедергісі!
Dialogue: 0,0:20:18.34,0:20:19.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:33.85,0:20:34.94,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:36.44,0:20:37.36,Default,,0,0,0,,Амелия
Dialogue: 0,0:20:38.19,0:20:39.86,Default,,0,0,0,,Енді қозғала алады
Dialogue: 0,0:20:39.94,0:20:42.99,Default,,0,0,0,,Сол баланы әлсіз еткен Акираға рахмет.
Dialogue: 0,0:20:45.20,0:20:46.82,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:20:47.32,0:20:50.95,Default,,0,0,0,,Бірақ мен аздап көңілді болдым, бұл жақсы.
Dialogue: 0,0:20:53.50,0:20:55.21,Default,,0,0,0,,Бұл уақыт бітті
Dialogue: 0,0:20:55.71,0:20:59.13,Default,,0,0,0,,Неге оны тез арада өлтірмейсіз және бұл туралы алаңдамайсыз?
Dialogue: 0,0:20:59.21,0:21:01.84,Default,,0,0,0,,Жындарға берілу жоқ.
Dialogue: 0,0:21:04.55,0:21:07.47,Default,,0,0,0,,Асықпасаң, сауығып кетесің.
Dialogue: 0,0:21:08.35,0:21:11.06,Default,,0,0,0,,Сіз мені өлтіре алмаймын дейсіз бе?
Dialogue: 0,0:21:11.14,0:21:12.31,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:21:12.98,0:21:16.56,Default,,0,0,0,,Маған тек адамға ұқсайтын бұл жын
Dialogue: 0,0:21:16.65,0:21:17.94,Default,,0,0,0,,Өлтіре алмадым
Dialogue: 0,0:21:18.61,0:21:20.94,Default,,0,0,0,,Көсем Саран тірі болса
Dialogue: 0,0:21:21.02,0:21:23.28,Default,,0,0,0,,Ол мұны жақсы деп айтуы мүмкін.
Dialogue: 0,0:21:23.36,0:21:24.95,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:21:25.03,0:21:27.28,Default,,0,0,0,,Сіз шынымен адам қарсыласынан жеңілдіңіз бе?
Dialogue: 0,0:21:32.29,0:21:35.79,Default,,0,0,0,,Амелияны қайтару үшін мен өлтіруім керек.
Dialogue: 0,0:21:35.87,0:21:38.04,Default,,0,0,0,,Мен дайындалдым деп ойладым.
Dialogue: 0,0:21:39.25,0:21:40.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:40.75,0:21:43.55,Default,,0,0,0,,Кешігіп қалдың, Махиро.
Dialogue: 0,0:21:43.63,0:21:45.17,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:21:45.84,0:21:47.84,Default,,0,0,0,,Жындар иерархиясында екінші орын...
Dialogue: 0,0:21:51.14,0:21:53.60,Default,,0,0,0,,Сіз дұрыс емес болдыңыз ба?
Dialogue: 0,0:21:53.68,0:21:56.64,Default,,0,0,0,,Сәлем Акира Ода
Dialogue: 0,0:21:58.44,0:22:01.48,Default,,0,0,0,,Соңында дұрыс жауап қандай?
Dialogue: 0,0:22:02.36,0:22:05.53,Default,,0,0,0,,Бұл кезде мен түсінбедім.
Dialogue: 0,0:22:11.37,0:22:13.37,Default,,0,0,0,,♪～
Dialogue: 0,0:23:38.95,0:23:40.96,Default,,0,0,0,,～♪
