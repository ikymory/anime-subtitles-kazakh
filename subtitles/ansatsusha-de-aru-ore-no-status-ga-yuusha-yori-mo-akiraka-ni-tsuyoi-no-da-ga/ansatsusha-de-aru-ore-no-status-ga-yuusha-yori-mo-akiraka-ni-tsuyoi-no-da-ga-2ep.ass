Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.50,0:00:06.67,Default,,0,0,0,,Көлеңке сиқыры іске қосылды!
Dialogue: 0,0:00:09.25,0:00:11.05,Default,,0,0,0,,(Минотаврдың айқайы)
Dialogue: 0,0:00:12.63,0:00:13.88,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:00:15.84,0:00:16.93,Default,,0,0,0,,Қарғыс атсын... уф!
Dialogue: 0,0:00:25.40,0:00:26.40,Default,,0,0,0,,Ах
Dialogue: 0,0:00:30.07,0:00:31.44,Default,,0,0,0,,Ух... Ой...
Dialogue: 0,0:00:31.53,0:00:33.74,Default,,0,0,0,,Мені сүйреңіз!
Dialogue: 0,0:00:39.28,0:00:41.04,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:00:48.46,0:00:51.34,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:00:51.42,0:00:52.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:52.42,0:00:53.17,Default,,0,0,0,,Артқа тұрыңыз!
Dialogue: 0,0:01:01.18,0:01:02.35,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:01:20.70,0:01:24.79,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:01:26.12,0:01:28.46,Default,,0,0,0,,Тозу көп сияқты.
Dialogue: 0,0:01:28.54,0:01:32.21,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:01:34.21,0:01:35.59,Default,,0,0,0,,Аман қалды
Dialogue: 0,0:01:36.30,0:01:39.05,Default,,0,0,0,,Иә, сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:01:43.72,0:01:45.73,Default,,0,0,0,,♪～
Dialogue: 0,0:03:10.89,0:03:12.90,Default,,0,0,0,,～♪
Dialogue: 0,0:03:14.52,0:03:16.65,Default,,0,0,0,,Бірде-бір адамды жіберіп алмай қайттым.
Dialogue: 0,0:03:16.73,0:03:18.23,Default,,0,0,0,,Мұның бәрі Акира-кунның арқасында.
Dialogue: 0,0:03:18.32,0:03:21.11,Default,,0,0,0,,Көшбасшы Саран маған рұқсат берді.
Dialogue: 0,0:03:21.20,0:03:23.36,Default,,0,0,0,,Жаттығу кезінде бақылаудан шығып кете жаздайтын сиқыр
Dialogue: 0,0:03:25.70,0:03:28.16,Default,,0,0,0,,Ең алдымен, сіздің қосымша дағдыларыңыз
Dialogue: 0,0:03:28.24,0:03:31.50,Default,,0,0,0,,«Көлеңке сиқыры» дегенді естімеппін.
Dialogue: 0,0:03:31.58,0:03:33.67,Default,,0,0,0,,Өте күшті болғанымен
Dialogue: 0,0:03:33.75,0:03:37.13,Default,,0,0,0,,Жанармай үнемдеу мен бақылауда өлімге әкелетін мәселе бар.
Dialogue: 0,0:03:37.21,0:03:39.96,Default,,0,0,0,,Келешекте немқұрайлы қолданбайық.
Dialogue: 0,0:03:40.05,0:03:41.67,Default,,0,0,0,,Бұл қару.
Dialogue: 0,0:03:41.76,0:03:45.26,Default,,0,0,0,,Әйтеуір, мен саған мынаны беремін.
Dialogue: 0,0:03:45.35,0:03:46.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:46.10,0:03:47.81,Default,,0,0,0,,Бірінші қаһарман
Dialogue: 0,0:03:47.89,0:03:51.27,Default,,0,0,0,,Өзіңіз жасаған катана деп аталатын қару.
Dialogue: 0,0:03:54.65,0:03:56.52,Default,,0,0,0,,Неліктен батыр емес, мен?
Dialogue: 0,0:03:56.61,0:03:58.90,Default,,0,0,0,,Батырдың қолында киелі қылыш бар
Dialogue: 0,0:03:58.98,0:04:03.57,Default,,0,0,0,,Сондай-ақ оны киіп алса, патша оны байқайды.
Dialogue: 0,0:04:03.66,0:04:05.53,Default,,0,0,0,,Көзді ұстағанда қандай сезімде болады?
Dialogue: 0,0:04:05.62,0:04:08.58,Default,,0,0,0,,Мен мұны қазына бөлмесінен ұрлап алдым.
Dialogue: 0,0:04:08.66,0:04:09.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:14.79,0:04:16.38,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:04:16.88,0:04:18.34,Default,,0,0,0,,Жазу дегеніміз не?
Dialogue: 0,0:04:18.42,0:04:20.88,Default,,0,0,0,,Пышақтың түбінде ойылған.
Dialogue: 0,0:04:20.96,0:04:23.17,Default,,0,0,0,,Жазбаны бізге оқу мүмкін емес.
Dialogue: 0,0:04:24.68,0:04:26.18,Default,,0,0,0,,«Ятогами»
Dialogue: 0,0:04:27.26,0:04:28.81,Default,,0,0,0,,Менде әлі күнге дейін ойылған нәрсе бар.
Dialogue: 0,0:04:29.72,0:04:31.60,Default,,0,0,0,,«болашақта келеді»
Dialogue: 0,0:04:31.68,0:04:35.14,Default,,0,0,0,,«Мен бұл менің кіші балаларыма көмектессе деп дұға етемін».
Dialogue: 0,0:04:37.94,0:04:39.86,Default,,0,0,0,,Бірінші батырмен танысқым келді.
Dialogue: 0,0:04:39.94,0:04:43.24,Default,,0,0,0,,Егер кездессек, мен де кездескім келеді.
Dialogue: 0,0:04:44.65,0:04:46.49,Default,,0,0,0,,Айтпақшы, батырлар туралы айтсақ...
Dialogue: 0,0:04:46.57,0:04:47.32,Default,,0,0,0,,Зұлымдар Альянсы мен Шие Хачисай-кай арасында жақсы ынтымақтастық жоқ —
Dialogue: 0,0:04:51.74,0:04:53.37,Default,,0,0,0,,Өте күшті қарғыс
Dialogue: 0,0:04:53.45,0:04:55.92,Default,,0,0,0,,Сиқырды қанша сейілтсем де, оны бұзу мүмкін емес сияқты болды.
Dialogue: 0,0:04:57.29,0:04:59.42,Default,,0,0,0,,Менде бір сезім бар...
Dialogue: 0,0:05:03.51,0:05:04.88,Default,,0,0,0,,Цукаса Сато
Dialogue: 0,0:05:06.09,0:05:09.85,Default,,0,0,0,,Менің қуыршағым болып, ең басты қаһарман бол.
Dialogue: 0,0:05:16.14,0:05:17.10,Default,,0,0,0,,Жоқ, бұл тек қана тәжірибе.
Dialogue: 0,0:05:17.69,0:05:20.02,Default,,0,0,0,,Осымен батырдың қарғысы жойылады.
Dialogue: 0,0:05:20.90,0:05:24.28,Default,,0,0,0,,Қыздың жатын бөлмесіне рұқсатсыз басып кіру ұят...
Dialogue: 0,0:05:24.94,0:05:28.24,Default,,0,0,0,,Адамдарды қарғыспен манипуляциялаушы қыз емес, бақсы.
Dialogue: 0,0:05:29.41,0:05:31.37,Default,,0,0,0,,Неліктен мұны істейсің?
Dialogue: 0,0:05:31.45,0:05:34.25,Default,,0,0,0,,үшін Ұлы Мәртебелі Король үшін
Dialogue: 0,0:05:34.79,0:05:37.25,Default,,0,0,0,,Неге патшаның бұйрығын орындайсың?
Dialogue: 0,0:05:42.21,0:05:45.97,Default,,0,0,0,,үшін Ұлы Мәртебелі Король үшін...
Dialogue: 0,0:05:57.60,0:05:59.06,Default,,0,0,0,,Рюсуке Ока
Dialogue: 0,0:05:59.94,0:06:01.61,Default,,0,0,0,,Сакура Инуэ
Dialogue: 0,0:06:02.36,0:06:03.86,Default,,0,0,0,,Нацуми Саката…
Dialogue: 0,0:06:05.99,0:06:08.40,Default,,0,0,0,,Көсем Саран оқығандай болды.
Dialogue: 0,0:06:09.45,0:06:12.78,Default,,0,0,0,,Жігіт, сен әлі бас тартқан жоқсың ба?
Dialogue: 0,0:06:13.28,0:06:14.20,Default,,0,0,0,,Ол?
Dialogue: 0,0:06:15.50,0:06:18.66,Default,,0,0,0,,Оның үстіне сен ханшайымға бетіңді аштың ба?
Dialogue: 0,0:06:18.75,0:06:21.33,Default,,0,0,0,,Мен сізден не ойлайтыныңызды сұрағым келді...
Dialogue: 0,0:06:22.09,0:06:24.05,Default,,0,0,0,,Әңгіме дұрыс болмады.
Dialogue: 0,0:06:24.84,0:06:28.67,Default,,0,0,0,,Енді ол патшаның қуыршағынан артық емес.
Dialogue: 0,0:06:30.64,0:06:32.72,Default,,0,0,0,,Бүгін демалыңыз.
Dialogue: 0,0:06:33.30,0:06:37.18,Default,,0,0,0,,Дегенмен, патша сарайының ішінде ұйықтамаған дұрыс.
Dialogue: 0,0:06:37.27,0:06:38.35,Default,,0,0,0,,Неге екен?
Dialogue: 0,0:06:39.44,0:06:41.15,Default,,0,0,0,,Ханшайым батырдан басқаның бәріне арналған.
Dialogue: 0,0:06:41.23,0:06:43.02,Default,,0,0,0,,Қарғыс айту керек
Dialogue: 0,0:06:43.11,0:06:47.11,Default,,0,0,0,,Алайда жағдайы белгісіз Акира-кун мұны істей алмайды.
Dialogue: 0,0:06:47.19,0:06:50.15,Default,,0,0,0,,Егер сіз оны басқара алмасаңыз, оны өлтіріңіз ...
Dialogue: 0,0:06:50.24,0:06:52.95,Default,,0,0,0,,Ғимарат мұқият тексеріледі.
Dialogue: 0,0:06:53.95,0:06:57.70,Default,,0,0,0,,Сіз ашулы емессіз. Жүзіңді көрсету ойсыз еді.
Dialogue: 0,0:06:57.79,0:07:01.21,Default,,0,0,0,,Жас кезіңде еріксіз еріп кетесің.
Dialogue: 0,0:07:01.29,0:07:03.58,Default,,0,0,0,,Бұл ересек адамның міндеті.
Dialogue: 0,0:07:06.17,0:07:09.72,Default,,0,0,0,,Басты әлемімде сендей үлкендер болса екен.
Dialogue: 0,0:07:09.80,0:07:12.97,Default,,0,0,0,,Олай болса үйге барғанда мені де өзіңмен ала кет.
Dialogue: 0,0:07:13.55,0:07:17.35,Default,,0,0,0,,Мен Акира әлемін көргім келеді, сондықтан туристік ақпарат беріңізші.
Dialogue: 0,0:07:17.43,0:07:18.02,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:18.10,0:07:20.39,Default,,0,0,0,,Бұл ауыртпалық, сондықтан маған ол жаққа барудың қажеті жоқ.
Dialogue: 0,0:07:24.69,0:07:26.61,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:07:29.69,0:07:31.86,Default,,0,0,0,,Таңертеңнен бері не істеп жатырсың?
Dialogue: 0,0:07:34.95,0:07:35.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:36.45,0:07:38.58,Default,,0,0,0,,Акира, сен қайда болдың?
Dialogue: 0,0:07:38.66,0:07:41.29,Default,,0,0,0,,Қарғыс дұрыс жойылған сияқты.
Dialogue: 0,0:07:41.79,0:07:43.08,Default,,0,0,0,,Мен ұйықтап жатырмын.
Dialogue: 0,0:07:43.67,0:07:45.33,Default,,0,0,0,,Сонымен не туралы әбігер бар?
Dialogue: 0,0:07:45.42,0:07:48.46,Default,,0,0,0,,Са… Саранг-сан…
Dialogue: 0,0:07:57.68,0:07:58.72,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:07:59.77,0:08:02.44,Default,,0,0,0,,Саран... Көшбасшы...
Dialogue: 0,0:08:05.77,0:08:08.65,Default,,0,0,0,,Неге... не болды!
Dialogue: 0,0:08:08.73,0:08:11.32,Default,,0,0,0,,Бұлай жазықсыз әрекет етпеңіз.
Dialogue: 0,0:08:11.90,0:08:14.82,Default,,0,0,0,,Мына қанжар - сен қолданған қанжар.
Dialogue: 0,0:08:14.91,0:08:15.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.91,0:08:20.50,Default,,0,0,0,,Балалар, мына қанжарды көрдіңдер...
Dialogue: 0,0:08:20.58,0:08:22.41,Default,,0,0,0,,Әу бастан күдікті болды.
Dialogue: 0,0:08:22.50,0:08:25.04,Default,,0,0,0,,Ол көпке дейін болмады, бірақ жаттығу кезінде ғана болды.
Dialogue: 0,0:08:25.12,0:08:26.71,Default,,0,0,0,,Тіпті лабиринтте де кенет...
Dialogue: 0,0:08:26.79,0:08:29.05,Default,,0,0,0,,Саған ханшайымның қарғысы тиді ме?
Dialogue: 0,0:08:30.13,0:08:32.59,Default,,0,0,0,,- (Ока) Дұрыс, дұрыс - (Мори) Күткендей сен күдіктенесің.
Dialogue: 0,0:08:33.30,0:08:34.13,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:08:34.22,0:08:36.14,Default,,0,0,0,,Осының өзі Акира жасады деген қорытынды жасауға жеткілікті.
Dialogue: 0,0:08:36.22,0:08:37.35,Default,,0,0,0,,Тым бейқамдық
Dialogue: 0,0:08:37.43,0:08:37.97,Default,,0,0,0,,Не?
Dialogue: 0,0:08:39.06,0:08:41.60,Default,,0,0,0,,Рыцарь командирін өлтірген ұлы күнәкар.
Dialogue: 0,0:08:41.68,0:08:43.68,Default,,0,0,0,,Әділдікке қол жеткізіңіз
Dialogue: 0,0:08:46.60,0:08:48.56,Default,,0,0,0,,Сонда сен мені ұрдың ба?
Dialogue: 0,0:08:49.23,0:08:50.61,Default,,0,0,0,,Бар болуды жасыру
Dialogue: 0,0:08:51.69,0:08:52.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:52.78,0:08:54.86,Default,,0,0,0,,Іздеу! Ол әлі жақын жерде болуы керек.
Dialogue: 0,0:08:56.82,0:08:58.16,Default,,0,0,0,,- (Акира) Жылы-сан - (Жылшын) Ах.
Dialogue: 0,0:08:58.91,0:09:00.49,Default,,0,0,0,,Бұл Акира-кун.
Dialogue: 0,0:09:00.58,0:09:05.21,Default,,0,0,0,,Көсем Саран патшаның тікелей бақылауындағы қастандық жасағы түнгі қарғалардың қолынан қаза тапты.
Dialogue: 0,0:09:05.29,0:09:07.00,Default,,0,0,0,,Сізді де нысанаға алып жатыр.
Dialogue: 0,0:09:08.13,0:09:10.54,Default,,0,0,0,,Саяхатқа дайындық жетекшінің бөлмесінде.
Dialogue: 0,0:09:10.63,0:09:12.63,Default,,0,0,0,,Дереу қашып кетіңіз.
Dialogue: 0,0:09:12.71,0:09:14.42,Default,,0,0,0,,Рахмет, Зел мырза.
Dialogue: 0,0:09:15.72,0:09:18.01,Default,,0,0,0,,Акира-кун, аман бол...
Dialogue: 0,0:09:18.51,0:09:19.43,Default,,0,0,0,,Ешқашан қашып кетуіме жол берме!
Dialogue: 0,0:09:20.01,0:09:22.52,Default,,0,0,0,,Сіз бұл жағдайдың болуы мүмкін екенін білдіңіз бе?
Dialogue: 0,0:09:30.98,0:09:32.69,Default,,0,0,0,,Көшбасшы Саран
Dialogue: 0,0:09:34.99,0:09:39.24,Default,,0,0,0,,Саранның оңай жеңілгені.
Dialogue: 0,0:09:39.32,0:09:42.58,Default,,0,0,0,,Батырдан басқаларға қарғыс аяқталды.
Dialogue: 0,0:09:42.66,0:09:45.75,Default,,0,0,0,,Енді шығыс елдерімен соғысу себебін жасауымыз керек.
Dialogue: 0,0:09:45.83,0:09:49.21,Default,,0,0,0,,Ол балаларды пешке ретінде пайдаланбаңыз.
Dialogue: 0,0:09:49.75,0:09:52.80,Default,,0,0,0,,Қашқан бала бәрібір далада өлетін шығар.
Dialogue: 0,0:09:52.88,0:09:55.34,Default,,0,0,0,,Әйтеуір, түнгі қарға қуып жетсін.
Dialogue: 0,0:09:55.97,0:09:56.97,Default,,0,0,0,,Иә
Dialogue: 0,0:09:57.05,0:10:00.09,Default,,0,0,0,,үшін Ұлы Мәртебелі Патшаның қалауы бойынша
Dialogue: 0,0:10:07.89,0:10:10.73,Default,,0,0,0,,Егер сізді біреу қуып бара жатса
Dialogue: 0,0:10:10.81,0:10:13.52,Default,,0,0,0,,Лабиринттен асқан жасырынатын жер жоқ.
Dialogue: 0,0:10:14.28,0:10:19.74,Default,,0,0,0,,Дегенмен, судың саңылаулары аз, сондықтан ұзақ уақыт сүңгу кезінде абай болу керек.
Dialogue: 0,0:10:20.36,0:10:23.99,Default,,0,0,0,,Кәсіптік деңгейді қалай көтеруге болады?
Dialogue: 0,0:10:24.08,0:10:25.66,Default,,0,0,0,,Бұл әлі лабиринт.
Dialogue: 0,0:10:25.75,0:10:28.75,Default,,0,0,0,,Егер сіз терең сүңгісеңіз, күшті қарсыластармен күресуге болады.
Dialogue: 0,0:10:28.83,0:10:31.13,Default,,0,0,0,,Онда неге бәрі мұны істемейді?
Dialogue: 0,0:10:31.21,0:10:32.59,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:10:33.09,0:10:35.17,Default,,0,0,0,,Акираның бар екенін жасыру
Dialogue: 0,0:10:35.25,0:10:39.63,Default,,0,0,0,,Жоғары деңгейдегі құбыжықтардың иіс сезу және есту қабілеті жұмыс істемейтін шығар.
Dialogue: 0,0:10:41.97,0:10:42.93,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:10:43.43,0:10:47.22,Default,,0,0,0,,Дегенмен, егер сіз өзіңіздің қастандық дағдыларыңызды айтарлықтай арттырсаңыз.
Dialogue: 0,0:10:47.31,0:10:50.44,Default,,0,0,0,,Ол иістерді, дыбыстарды және тіпті дене қызуын жоя алады.
Dialogue: 0,0:10:50.94,0:10:52.73,Default,,0,0,0,,Бізде әлі ұзақ жол бар
Dialogue: 0,0:10:56.44,0:11:00.07,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:11:02.24,0:11:05.16,Default,,0,0,0,,(құбыжықтың айқайы)
Dialogue: 0,0:11:11.87,0:11:13.79,Default,,0,0,0,,Бірақ бұл күш салуға тұрарлық.
Dialogue: 0,0:11:14.38,0:11:18.13,Default,,0,0,0,,Мамандық деңгейі 100-ге жеткенде берілетін арнайы дағдылар
Dialogue: 0,0:11:18.21,0:11:21.43,Default,,0,0,0,,Бұл аман қалуға міндетті түрде көмектеседі.
Dialogue: 0,0:11:22.01,0:11:23.55,Default,,0,0,0,,Арнайы дағды?
Dialogue: 0,0:11:23.64,0:11:26.01,Default,,0,0,0,,Біріншіден, Кантинен лабиринтінде
Dialogue: 0,0:11:26.10,0:11:27.81,Default,,0,0,0,,Әр 10-қабатта бастықтар
Dialogue: 0,0:11:27.89,0:11:30.27,Default,,0,0,0,,Олардың барлығын орындай алуды мақсат ету.
Dialogue: 0,0:11:31.39,0:11:32.31,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:11:38.19,0:11:39.74,Default,,0,0,0,,Бастық бөлмесіне кіргенде
Dialogue: 0,0:11:39.82,0:11:43.95,Default,,0,0,0,,Біреуің өлмейінше алға немесе артқа кете алмайсың.
Dialogue: 0,0:11:44.95,0:11:48.37,Default,,0,0,0,,Алайда, егер біз жеңсек, айтарлықтай өсуді күтуге болады.
Dialogue: 0,0:11:53.12,0:11:57.13,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:00.92,0:12:02.80,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:12:09.31,0:12:10.22,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:12.69,0:12:14.10,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:12:14.19,0:12:16.02,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:12:16.11,0:12:19.32,Default,,0,0,0,,Осындай жерде өлсем, үйге бара алмаймын.
Dialogue: 0,0:12:19.40,0:12:21.61,Default,,0,0,0,,Көсем Саранның кегін алу мүмкін емес.
Dialogue: 0,0:12:21.69,0:12:22.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:27.41,0:12:29.08,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:12:29.83,0:12:32.41,Default,,0,0,0,,Түсіндім... Мен байсалдымын.
Dialogue: 0,0:12:34.79,0:12:37.75,Default,,0,0,0,,Көлеңке сиқыры іске қосылды!
Dialogue: 0,0:12:43.72,0:12:45.93,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:12:52.31,0:12:55.44,Default,,0,0,0,,Негізгі зақым төзімділіктен асып түседі
Dialogue: 0,0:12:55.52,0:12:58.02,Default,,0,0,0,,Көлеңкелік сиқырды мәжбүрлеп қосу
Dialogue: 0,0:13:00.11,0:13:01.44,Default,,0,0,0,,«Емдеу» режимі
Dialogue: 0,0:13:01.94,0:13:06.20,Default,,0,0,0,,Көлеңке сиқырында сақталған сиқырлы күштен қажетті соманы жинаңыз
Dialogue: 0,0:13:10.53,0:13:11.79,Default,,0,0,0,,Әңгіме қандай?
Dialogue: 0,0:13:11.87,0:13:14.50,Default,,0,0,0,,Сіз жын патшаны құртатыныңызға сенімдісіз бе?
Dialogue: 0,0:13:14.58,0:13:17.46,Default,,0,0,0,,Жоқ, мен қазір кеткім келеді.
Dialogue: 0,0:13:17.54,0:13:21.80,Default,,0,0,0,,Көшбасшы Саранды Ода өлтірді және ол әлі де абдырап қалды ма?
Dialogue: 0,0:13:21.88,0:13:23.05,Default,,0,0,0,,Сен ақымақ емессің бе?
Dialogue: 0,0:13:23.13,0:13:27.05,Default,,0,0,0,,Командирдің орынбасары Зел айтып отырған ханшайымның қарғысы ма?
Dialogue: 0,0:13:33.14,0:13:35.56,Default,,0,0,0,,Жарайды, мен жалғыз барамын.
Dialogue: 0,0:13:36.44,0:13:37.94,Default,,0,0,0,,Мен де сенімен бірге барамын.
Dialogue: 0,0:13:43.15,0:13:44.61,Default,,0,0,0,,Мен де барамын.
Dialogue: 0,0:13:44.69,0:13:45.69,Default,,0,0,0,,Мен де
Dialogue: 0,0:13:45.78,0:13:47.32,Default,,0,0,0,,Мен де сенімен бірге келемін.
Dialogue: 0,0:13:47.40,0:13:49.16,Default,,0,0,0,,- (Цуда) Мен де - (Ваки) Мен де.
Dialogue: 0,0:13:52.87,0:13:55.12,Default,,0,0,0,,Бір қызығы, оңай шықты.
Dialogue: 0,0:13:55.20,0:13:58.33,Default,,0,0,0,,Жын патшаны бағындыру алғашында патшаның бұйрығымен болды.
Dialogue: 0,0:13:58.42,0:14:00.84,Default,,0,0,0,,Қатты қарсылық білдіру қисынсыз
Dialogue: 0,0:14:01.88,0:14:04.96,Default,,0,0,0,,Оның үстіне барлығы неге келді?
Dialogue: 0,0:14:05.05,0:14:06.67,Default,,0,0,0,,Анна Цукаса-кун
Dialogue: 0,0:14:06.76,0:14:09.64,Default,,0,0,0,,Менің ойымша, мұнда бәрі қарғысқа ұшыраған.
Dialogue: 0,0:14:09.72,0:14:10.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:10.89,0:14:13.72,Default,,0,0,0,,Біз орфографиялық шебер болғандықтан, қарғысқа төзімдіміз.
Dialogue: 0,0:14:13.81,0:14:17.73,Default,,0,0,0,,Соңғы кездері мен бәрінің қарғысқа ұшыраған-қарғыс емес екенін сезетін болдым.
Dialogue: 0,0:14:18.69,0:14:21.73,Default,,0,0,0,,Менің істеген ісіме байланысты болса керек.
Dialogue: 0,0:14:24.36,0:14:26.78,Default,,0,0,0,,Бұл есте сақтау қабілеті нашар, бірақ
Dialogue: 0,0:14:26.86,0:14:29.20,Default,,0,0,0,,Мен бейтаныс бөлмеде кристалдарды кесіп жаттым.
Dialogue: 0,0:14:30.49,0:14:32.95,Default,,0,0,0,,Мен білмей тұрып, бұл қылыш менің қолымда болды ...
Dialogue: 0,0:14:34.74,0:14:36.95,Default,,0,0,0,,Менің дағдым «ұсыным».
Dialogue: 0,0:14:37.04,0:14:40.42,Default,,0,0,0,,Бір ғана әрекетті тудырса, қарғысқа қарағанда күштірек
Dialogue: 0,0:14:40.92,0:14:45.42,Default,,0,0,0,,Капитан Саранның соңғы бұйрығын орындадым.
Dialogue: 0,0:14:46.05,0:14:49.09,Default,,0,0,0,,Сәттілік, басқа дүниенің батырлары
Dialogue: 0,0:14:51.30,0:14:53.35,Default,,0,0,0,,Егер мен Акирамен кездеспесем...
Dialogue: 0,0:14:54.39,0:14:57.06,Default,,0,0,0,,Сіз төмен профильді сақтауға тырысқанда
Dialogue: 0,0:14:57.14,0:14:59.48,Default,,0,0,0,,Сізбен сөйлеспегенім қате болды
Dialogue: 0,0:15:00.14,0:15:04.82,Default,,0,0,0,,Ал қарғысқа ұшырасам да, өзімді қорғай алмадым.
Dialogue: 0,0:15:12.78,0:15:15.20,Default,,0,0,0,,Акира Ода?
Dialogue: 0,0:15:15.28,0:15:18.45,Default,,0,0,0,,Мм... біз бір сыныпта оқимыз ба?
Dialogue: 0,0:15:19.08,0:15:20.66,Default,,0,0,0,,Бұл Киосуке Асахина.
Dialogue: 0,0:15:23.13,0:15:25.79,Default,,0,0,0,,Бұл... бұл туралы.
Dialogue: 0,0:15:25.88,0:15:27.76,Default,,0,0,0,,Менің білгенімді қаламайсың.
Dialogue: 0,0:15:27.84,0:15:28.71,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:28.80,0:15:30.38,Default,,0,0,0,,Одаққа қатысты оқиғалар немесе байқаулар туралы ешқандай хабар жоқ
Dialogue: 0,0:15:30.47,0:15:33.93,Default,,0,0,0,,Мектептегі жігіттер... Әсіресе, әпкемнің білгенін қаламаймын.
Dialogue: 0,0:15:34.01,0:15:35.80,Default,,0,0,0,,Мен бірінші курста оқимын.
Dialogue: 0,0:15:35.89,0:15:36.81,Default,,0,0,0,,Сіз де?
Dialogue: 0,0:15:36.89,0:15:38.10,Default,,0,0,0,,«Сіз де»?
Dialogue: 0,0:15:39.81,0:15:41.44,Default,,0,0,0,,Бұл менің әпкем
Dialogue: 0,0:15:41.52,0:15:43.44,Default,,0,0,0,,Бұл менің әпкем.
Dialogue: 0,0:15:43.52,0:15:44.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:46.02,0:15:48.36,Default,,0,0,0,,Ол Кьюканың ағасы болды ма?
Dialogue: 0,0:15:48.44,0:15:51.07,Default,,0,0,0,,Хаха, қандай кездейсоқтық.
Dialogue: 0,0:15:53.86,0:15:55.57,Default,,0,0,0,,Уф, ах… Кеменің орнын анықтау үшін.
Dialogue: 0,0:15:55.66,0:15:57.95,Default,,0,0,0,,Киосукенің арманы?
Dialogue: 0,0:15:58.04,0:16:00.29,Default,,0,0,0,,Ол жақсы ма?
Dialogue: 0,0:16:00.37,0:16:03.21,Default,,0,0,0,,Юи мен оның анасы да дұрыс тамақтанып жатыр ма деп ойлаймын.
Dialogue: 0,0:16:03.29,0:16:05.79,Default,,0,0,0,,Иә? Бұл ауырмайды
Dialogue: 0,0:16:06.29,0:16:07.46,Default,,0,0,0,,Күй!
Dialogue: 0,0:16:08.09,0:16:09.92,Default,,0,0,0,,Ол көп көтерілді.
Dialogue: 0,0:16:10.01,0:16:12.84,Default,,0,0,0,,Жоқ, күте тұрыңыз, сіздің өмірлік күшіңіз неге толы болды?
Dialogue: 0,0:16:12.93,0:16:15.64,Default,,0,0,0,,Үш қабырға сынған болуы керек.
Dialogue: 0,0:16:16.14,0:16:18.35,Default,,0,0,0,,У да аяғымда болды.
Dialogue: 0,0:16:18.43,0:16:20.77,Default,,0,0,0,,Көлеңке сиқыры 3 болды
Dialogue: 0,0:16:20.85,0:16:23.85,Default,,0,0,0,,Бір рет қолдану арқылы сіздің деңгейіңізді екі деңгейге көтере ме?
Dialogue: 0,0:16:24.44,0:16:27.15,Default,,0,0,0,,Мен оны өңдеу оңайырақ болып кеткендей сезінемін.
Dialogue: 0,0:16:27.65,0:16:30.57,Default,,0,0,0,,Білмеймін, бірақ ары қарай қозғалудан басқа амалым жоқ.
Dialogue: 0,0:16:31.61,0:16:34.49,Default,,0,0,0,,(тас кесу дыбысы)
Dialogue: 0,0:16:43.12,0:16:46.13,Default,,0,0,0,,Шлам осыншама терең ме?
Dialogue: 0,0:16:51.63,0:16:52.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:53.59,0:16:55.09,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:16:57.14,0:16:59.10,Default,,0,0,0,,Эльфтер?
Dialogue: 0,0:16:59.18,0:17:01.64,Default,,0,0,0,,Мен мұндай әдемі жүзді көрген емеспін.
Dialogue: 0,0:17:03.31,0:17:06.69,Default,,0,0,0,,Мен шынымен түсінбеген және елеусіз қалдырған дағдыны сынап көруім керек пе?
Dialogue: 0,0:17:06.77,0:17:09.44,Default,,0,0,0,,Әлемдік көзді белсендіру
Dialogue: 0,0:17:09.52,0:17:10.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:12.53,0:17:14.32,Default,,0,0,0,,Бұл қауіпті! Дағды ашылды!
Dialogue: 0,0:17:15.20,0:17:17.03,Default,,0,0,0,,Бір сәт мен қауіпті нәрсені көрдім.
Dialogue: 0,0:17:18.16,0:17:20.16,Default,,0,0,0,,Бұл дағды қауіпті
Dialogue: 0,0:17:20.24,0:17:22.20,Default,,0,0,0,,Оны мүмкіндігінше пайдаланудан аулақ болыңыз
Dialogue: 0,0:17:22.29,0:17:23.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:25.71,0:17:26.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:27.04,0:17:27.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:28.46,0:17:29.88,Default,,0,0,0,,Бір жері ауырады ма?
Dialogue: 0,0:17:29.96,0:17:32.46,Default,,0,0,0,,А... жарайды.
Dialogue: 0,0:17:32.55,0:17:35.09,Default,,0,0,0,,Бұл рас па? Ұстамайсыз ба?
Dialogue: 0,0:17:35.17,0:17:36.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:36.09,0:17:38.51,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:17:39.43,0:17:42.89,Default,,0,0,0,,Мен оны жай көрдім Күй
Dialogue: 0,0:17:43.39,0:17:46.85,Default,,0,0,0,,Менің өміршеңдігім максималды мәнінің елуден біріне дейін төмендеді.
Dialogue: 0,0:17:47.90,0:17:50.23,Default,,0,0,0,,Бұл жігіттің де ғаламдық көзі бар.
Dialogue: 0,0:17:51.23,0:17:52.61,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:17:52.69,0:17:55.36,Default,,0,0,0,,Бұл Кантинен лабиринтінің 75-ші қабаты.
Dialogue: 0,0:17:55.44,0:17:58.99,Default,,0,0,0,,Акира... иә... мұнда неге келдің?
Dialogue: 0,0:17:59.07,0:18:00.91,Default,,0,0,0,,Мен деңгейді көтеру үшін келдім.
Dialogue: 0,0:18:00.99,0:18:02.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:02.28,0:18:04.37,Default,,0,0,0,,Менің ойымша, сіз оны көре аласыз.
Dialogue: 0,0:18:04.45,0:18:06.62,Default,,0,0,0,,Алдымен атыңызды айтыңызшы.
Dialogue: 0,0:18:06.71,0:18:08.21,Default,,0,0,0,,Келісімді пайдаланбай-ақ мені одақтасың қыла аласың деп ойладың ғой?
Dialogue: 0,0:18:09.83,0:18:12.54,Default,,0,0,0,,Ха... Менің әлі де қызуым бар.
Dialogue: 0,0:18:18.55,0:18:20.47,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:18:20.55,0:18:21.55,Default,,0,0,0,,Ах
Dialogue: 0,0:18:26.35,0:18:27.06,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:27.14,0:18:29.98,Default,,0,0,0,,Өз ішіңіздің дыбысы сізді оятады ма?
Dialogue: 0,0:18:30.06,0:18:31.52,Default,,0,0,0,,А...
Dialogue: 0,0:18:31.61,0:18:33.07,Default,,0,0,0,,Жақсы, оны ішіңіз.
Dialogue: 0,0:18:33.15,0:18:35.53,Default,,0,0,0,,(Ауыз судың қатты дыбысы)
Dialogue: 0,0:18:36.07,0:18:37.44,Default,,0,0,0,,Пуха!
Dialogue: 0,0:18:38.65,0:18:41.62,Default,,0,0,0,,Дене қызуыңыз көтерілсе, суды көп ішіңіз.
Dialogue: 0,0:18:41.70,0:18:43.74,Default,,0,0,0,,Жылы ұйықтаған дұрыс.
Dialogue: 0,0:18:44.24,0:18:46.25,Default,,0,0,0,,Менің қарным ашты, ұйықтай алмаймын
Dialogue: 0,0:18:46.33,0:18:48.21,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:18:48.29,0:18:49.83,Default,,0,0,0,,Күріш ботқасы
Dialogue: 0,0:18:49.92,0:18:51.92,Default,,0,0,0,,Ыстық, сондықтан бұралған кезде тамақтаныңыз.
Dialogue: 0,0:18:52.00,0:18:52.75,Default,,0,0,0,,Иә
Dialogue: 0,0:18:53.29,0:18:55.96,Default,,0,0,0,,У-у-у-у
Dialogue: 0,0:18:58.76,0:19:00.72,Default,,0,0,0,,Осыншама жесең, тез сауығып кетесің.
Dialogue: 0,0:19:02.22,0:19:04.97,Default,,0,0,0,,Акира ауруларды емдеуді біледі ме?
Dialogue: 0,0:19:05.06,0:19:08.39,Default,,0,0,0,,Менің анам жиі ауырады, сондықтан мен оның күтіміне үйреніп қалғанмын.
Dialogue: 0,0:19:08.48,0:19:09.77,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:13.73,0:19:16.44,Default,,0,0,0,,Оны Акира жазды, солай ма? Не?
Dialogue: 0,0:19:16.53,0:19:17.57,Default,,0,0,0,,69
Dialogue: 0,0:19:18.28,0:19:21.07,Default,,0,0,0,,Адасып қалмас үшін әр қабатта ойылған.
Dialogue: 0,0:19:21.16,0:19:24.03,Default,,0,0,0,,Сіз бұрын 75-қабат дедіңіз.
Dialogue: 0,0:19:24.12,0:19:25.83,Default,,0,0,0,,Сіз қайтып келдіңіз бе?
Dialogue: 0,0:19:25.91,0:19:27.66,Default,,0,0,0,,Сіз өз деңгейіңізді көтеру үшін келдіңіз бе?
Dialogue: 0,0:19:27.74,0:19:30.33,Default,,0,0,0,,Бұл ең жақын су тесігі болды.
Dialogue: 0,0:19:30.41,0:19:32.17,Default,,0,0,0,,Сіз оны алып жүрдіңіз бе?
Dialogue: 0,0:19:32.25,0:19:33.54,Default,,0,0,0,,Сіз біртүрлі нәрсені ұстадыңыз ба?
Dialogue: 0,0:19:33.63,0:19:35.34,Default,,0,0,0,,Оған тимеңіз
Dialogue: 0,0:19:35.42,0:19:36.46,Default,,0,0,0,,Жарайды, қазір ұйықта.
Dialogue: 0,0:19:36.55,0:19:37.67,Default,,0,0,0,,Иә
Dialogue: 0,0:19:38.55,0:19:41.09,Default,,0,0,0,,Мен король әулетінің мүшесімін.
Dialogue: 0,0:19:41.18,0:19:43.80,Default,,0,0,0,,Білемін, енді ғана көрдім.
Dialogue: 0,0:19:44.39,0:19:47.60,Default,,0,0,0,,Маған ешқашан бұлай қараған емес...
Dialogue: 0,0:19:47.68,0:19:49.18,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:51.48,0:19:55.61,Default,,0,0,0,,(Амелия ұйқысы)
Dialogue: 0,0:19:56.19,0:19:58.65,Default,,0,0,0,,Аа... Жақсы ұйықтап жатырмын.
Dialogue: 0,0:19:59.48,0:20:03.36,Default,,0,0,0,,Қауіпті анықтау әлі қосылып тұрғанда, мен де біраз ұйықтаймын деп ойлаймын.
Dialogue: 0,0:20:17.67,0:20:20.96,Default,,0,0,0,,Тас еден болса да, жылы.
Dialogue: 0,0:20:25.89,0:20:26.80,Default,,0,0,0,,Гравитация!
Dialogue: 0,0:20:29.39,0:20:30.47,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:20:30.56,0:20:31.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:32.06,0:20:33.31,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:20:34.56,0:20:37.56,Default,,0,0,0,,Сіздің денеңіз сауығып жатыр, солай ма? Менімен неге келдің?
Dialogue: 0,0:20:38.15,0:20:40.65,Default,,0,0,0,,Біз жай ғана бір бағытта жүргіміз келеді.
Dialogue: 0,0:20:40.73,0:20:43.15,Default,,0,0,0,,Олай болса өзіңізді қорғаңыз.
Dialogue: 0,0:20:43.24,0:20:45.99,Default,,0,0,0,,Акира адамдардан да күшті күшке ие.
Dialogue: 0,0:20:46.07,0:20:49.03,Default,,0,0,0,,Мен де өзімді қорғай алмайтындай әлсіз емеспін.
Dialogue: 0,0:20:57.83,0:20:58.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:59.29,0:21:00.21,Default,,0,0,0,,Айдаһар?
Dialogue: 0,0:21:02.17,0:21:03.59,Default,,0,0,0,,Белгілерді жасыру!
Dialogue: 0,0:21:05.18,0:21:06.09,Default,,0,0,0,,Гравитация!
Dialogue: 0,0:21:07.55,0:21:08.35,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:21:12.81,0:21:15.39,Default,,0,0,0,,Бұл жігіт өзінің сиқыры арқылы Акираның орнын табады.
Dialogue: 0,0:21:15.48,0:21:17.48,Default,,0,0,0,,Өз сиқырыңызды айналаңызға ерітіңіз
Dialogue: 0,0:21:17.56,0:21:18.27,Default,,0,0,0,,Ах
Dialogue: 0,0:21:19.56,0:21:20.36,Default,,0,0,0,,Дөрекі болма!
Dialogue: 0,0:21:24.28,0:21:25.57,Default,,0,0,0,,Сиқырлы күш…
Dialogue: 0,0:21:25.65,0:21:27.28,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:21:31.33,0:21:31.99,Default,,0,0,0,,(Инумаки) Та… (Бірдеңенің тесіп өткен дыбысы)
Dialogue: 0,0:21:33.58,0:21:35.50,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:21:35.58,0:21:36.50,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:21:40.50,0:21:43.42,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:21:43.51,0:21:45.26,Default,,0,0,0,,Акира Алдыңғы ше?
Dialogue: 0,0:21:46.17,0:21:50.51,Default,,0,0,0,,Айналамен араласу нәзік нәрсе, қолымнан келмейді.
Dialogue: 0,0:21:51.10,0:21:53.64,Default,,0,0,0,,Сөйтіп, шарасыздықтан мен керісінше әрекет жасадым.
Dialogue: 0,0:21:54.22,0:21:56.77,Default,,0,0,0,,А... сен мұны істей аласың...
Dialogue: 0,0:22:03.69,0:22:04.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:11.28,0:22:13.29,Default,,0,0,0,,♪～
Dialogue: 0,0:23:38.87,0:23:40.87,Default,,0,0,0,,～♪
