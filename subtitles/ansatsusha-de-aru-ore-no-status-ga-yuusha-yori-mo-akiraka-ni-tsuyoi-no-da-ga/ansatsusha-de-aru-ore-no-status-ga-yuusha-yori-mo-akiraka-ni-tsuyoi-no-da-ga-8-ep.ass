Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.21,0:00:05.17,Default,,0,0,0,,Акира, біз не істей аламыз?
Dialogue: 0,0:00:05.25,0:00:06.00,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:00:06.08,0:00:07.04,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:00:08.29,0:00:11.01,Default,,0,0,0,,Балалар, не істейтіндерің туралы мұқият ойланыңдар.
Dialogue: 0,0:00:15.80,0:00:18.18,Default,,0,0,0,,Біз оған бізді тануға мәжбүр етуіміз керек.
Dialogue: 0,0:00:18.26,0:00:20.14,Default,,0,0,0,,Менімен бірге келмейтін сияқтысың.
Dialogue: 0,0:00:21.18,0:00:22.02,Default,,0,0,0,,Бұл қиын сұрақ.
Dialogue: 0,0:00:23.56,0:00:27.15,Default,,0,0,0,,Мм... Мен бұл туралы гильдияда естідім.
Dialogue: 0,0:00:27.23,0:00:28.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:28.94,0:00:30.36,Default,,0,0,0,,Ал...
Dialogue: 0,0:00:30.44,0:00:33.74,Default,,0,0,0,,Дәл қазір осы маңдағы қалада фестиваль өтіп жатыр.
Dialogue: 0,0:00:33.82,0:00:35.70,Default,,0,0,0,,- (Кёсүкэ) фестивалі? -(Цуда) Иә.
Dialogue: 0,0:00:35.78,0:00:38.49,Default,,0,0,0,,Ол жерде конкурс өтіп жатыр.
Dialogue: 0,0:00:38.58,0:00:41.24,Default,,0,0,0,,Жеңімпаз жыл сайын жоғалып кетеді.
Dialogue: 0,0:00:41.33,0:00:42.16,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:00:43.29,0:00:45.83,Default,,0,0,0,,Адам саудасы қараңғыда орын алуда.
Dialogue: 0,0:00:45.92,0:00:46.96,Default,,0,0,0,,Бұл қауесет
Dialogue: 0,0:00:47.46,0:00:50.00,Default,,0,0,0,,Бірнеше авантюрист дәл осылай айтты.
Dialogue: 0,0:00:50.09,0:00:51.30,Default,,0,0,0,,Сенімділік жоғары деп ойлаймын.
Dialogue: 0,0:00:52.80,0:00:55.84,Default,,0,0,0,,Егер біз бұл қылмыскерді ұстай алсақ...
Dialogue: 0,0:00:55.93,0:00:57.01,Default,,0,0,0,,Ода-кун да
Dialogue: 0,0:00:57.09,0:01:00.06,Default,,0,0,0,,Бізге пайдалы болуы мүмкін.
Dialogue: 0,0:01:00.14,0:01:01.39,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:01:01.47,0:01:04.14,Default,,0,0,0,,Кедергі болу бейнесін жоюға болады.
Dialogue: 0,0:01:05.77,0:01:07.23,Default,,0,0,0,,Байқап көруге тұрарлық
Dialogue: 0,0:01:09.73,0:01:12.90,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:01:13.49,0:01:15.49,Default,,0,0,0,,♪～
Dialogue: 0,0:02:40.95,0:02:42.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:44.87,0:02:46.70,Default,,0,0,0,,- (Акира) Фестиваль? - (Кёсүкэ) Ой
Dialogue: 0,0:02:47.20,0:02:50.37,Default,,0,0,0,,Мали деген қалада, осы жерден сәл алыс жерде.
Dialogue: 0,0:02:50.46,0:02:52.83,Default,,0,0,0,,Себебі менің қыздарым барғысы келеді.
Dialogue: 0,0:02:52.92,0:02:55.17,Default,,0,0,0,,Амелия ханшайымы ше?
Dialogue: 0,0:02:55.25,0:02:57.21,Default,,0,0,0,,Азық-түлік сататын орын бар ма?
Dialogue: 0,0:02:57.30,0:02:58.63,Default,,0,0,0,,Мен көп екеніне сенімдімін.
Dialogue: 0,0:02:58.72,0:02:59.63,Default,,0,0,0,,Бар!
Dialogue: 0,0:03:00.43,0:03:02.34,Default,,0,0,0,,Сұлулық байқауы бар.
Dialogue: 0,0:03:02.43,0:03:03.55,Default,,0,0,0,,Біз бірге шыға аламыз ба?
Dialogue: 0,0:03:03.64,0:03:07.02,Default,,0,0,0,,Егер сіз ұтып алсаңыз, сіз өте сәнді сыйлық аласыз.
Dialogue: 0,0:03:07.10,0:03:07.89,Default,,0,0,0,,Шық!
Dialogue: 0,0:03:09.89,0:03:11.19,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:03:11.27,0:03:12.40,Default,,0,0,0,,Бұл жанды!
Dialogue: 0,0:03:12.48,0:03:15.98,Default,,0,0,0,,Байқауда жеңіске жетудің жүлдесі міндетті түрде тағам.
Dialogue: 0,0:03:16.07,0:03:19.90,Default,,0,0,0,,Өйткені ол азық-түлік өндірісі белсенді болып табылатын жыртқыш аумақта өткізіледі.
Dialogue: 0,0:03:19.99,0:03:21.91,Default,,0,0,0,,Бұл өте ықтимал.
Dialogue: 0,0:03:21.99,0:03:23.66,Default,,0,0,0,,Ертерек кіру керек
Dialogue: 0,0:03:24.32,0:03:26.87,Default,,0,0,0,,Фестивальде көңілім көтеріліп жатыр.
Dialogue: 0,0:03:27.37,0:03:29.29,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:03:31.41,0:03:32.79,Default,,0,0,0,,Бұл кемсітушілік! Бұл кемсітушілік!
Dialogue: 0,0:03:34.21,0:03:35.63,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:03:35.71,0:03:38.13,Default,,0,0,0,,Түсінгеніңізге рахмет...
Dialogue: 0,0:03:38.21,0:03:39.46,Default,,0,0,0,,Сізде қиындық бар ма?
Dialogue: 0,0:03:39.55,0:03:40.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:40.67,0:03:44.22,Default,,0,0,0,,Жындардың жарысқа қатысуына рұқсат етілмейді, бұл кемсітушілік.
Dialogue: 0,0:03:44.30,0:03:45.80,Default,,0,0,0,,Сіз де солай ойлайсыз, солай ма?
Dialogue: 0,0:03:45.89,0:03:48.31,Default,,0,0,0,,А... сен жынсың ба?
Dialogue: 0,0:03:48.39,0:03:49.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:49.68,0:03:50.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:50.27,0:03:52.35,Default,,0,0,0,,А, ол адам...
Dialogue: 0,0:03:52.44,0:03:54.23,Default,,0,0,0,,Мен торлы шегемін
Dialogue: 0,0:03:54.31,0:03:55.69,Default,,0,0,0,,Мені Русти деп атаңыз
Dialogue: 0,0:03:55.77,0:03:57.44,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:03:57.98,0:04:00.53,Default,,0,0,0,,Бұл жігіт шынымен де жын ба?
Dialogue: 0,0:04:01.03,0:04:03.45,Default,,0,0,0,,Мен ешқандай күш пен қысым сезінбеймін.
Dialogue: 0,0:04:04.16,0:04:06.74,Default,,0,0,0,,Әй, ағаңнан бірдеңе айтшы.
Dialogue: 0,0:04:06.82,0:04:09.54,Default,,0,0,0,,Мен сайысқа қатысқым келеді.
Dialogue: 0,0:04:09.62,0:04:10.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:11.91,0:04:12.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:12.91,0:04:13.96,Default,,0,0,0,,-Хмф - (2 адам) А...
Dialogue: 0,0:04:14.04,0:04:18.38,Default,,0,0,0,,Қатысқыңыз келсе, жеке басын куәландырыңыз...
Dialogue: 0,0:04:19.46,0:04:19.96,Default,,0,0,0,,Не!
Dialogue: 0,0:04:22.55,0:04:26.01,Default,,0,0,0,,А... Элф ханшайымы Амелия?
Dialogue: 0,0:04:26.09,0:04:27.01,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:04:27.10,0:04:29.43,Default,,0,0,0,,бұл... Иә! Қабылданды!
Dialogue: 0,0:04:31.14,0:04:33.73,Default,,0,0,0,,Ол менен басқа балаларға ашуланады.
Dialogue: 0,0:04:33.81,0:04:34.94,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:04:35.02,0:04:35.85,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:04:35.94,0:04:37.31,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:04:40.44,0:04:43.32,Default,,0,0,0,,Адамдар, аңдар және эльфтер қатыса алады.
Dialogue: 0,0:04:43.40,0:04:45.45,Default,,0,0,0,,Неліктен бұл тек жындарға ғана зиян?
Dialogue: 0,0:04:45.53,0:04:47.12,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:04:47.20,0:04:48.95,Default,,0,0,0,,Эльфтер кінәлі.
Dialogue: 0,0:04:49.03,0:04:50.54,Default,,0,0,0,,Олардың көпшілігі әдемі.
Dialogue: 0,0:04:50.62,0:04:52.20,Default,,0,0,0,,Сен солай айтсаң да...
Dialogue: 0,0:04:52.29,0:04:53.29,Default,,0,0,0,,Біртүрлі!
Dialogue: 0,0:04:53.37,0:04:54.87,Default,,0,0,0,,Мырза Президент, қазіргі L, шатастырмау үшін,
Dialogue: 0,0:04:54.96,0:04:56.12,Default,,0,0,0,,Қанша кешірім сұрасаң да
Dialogue: 0,0:04:56.21,0:04:57.63,Default,,0,0,0,,Өйткені мен берілмеймін.
Dialogue: 0,0:04:57.71,0:04:59.38,Default,,0,0,0,,-(Қабылдау қызметкері) Әйтеуір... -(Акира) Жарайды ма?
Dialogue: 0,0:05:00.30,0:05:01.67,Default,,0,0,0,,Бұл бала жаман емес.
Dialogue: 0,0:05:01.75,0:05:03.92,Default,,0,0,0,,Мен жай ғана Акира қызықпайды деп үміттенемін.
Dialogue: 0,0:05:04.51,0:05:06.38,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:05:07.47,0:05:09.26,Default,,0,0,0,,Маған қатысуға рұқсат етіңіз.
Dialogue: 0,0:05:09.35,0:05:11.22,Default,,0,0,0,,Егер зорлық-зомбылық болса, мен оны ұстап тұрамын.
Dialogue: 0,0:05:11.31,0:05:12.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:12.27,0:05:14.02,Default,,0,0,0,,Жігіт күткендей!
Dialogue: 0,0:05:14.10,0:05:17.73,Default,,0,0,0,,Егер ханшайымның серігі жауапкершілікті өз мойнына алса.
Dialogue: 0,0:05:18.94,0:05:20.77,Default,,0,0,0,,Бұл шешілді!
Dialogue: 0,0:05:21.48,0:05:23.03,Default,,0,0,0,,-Сен... -(Түн) Ня!
Dialogue: 0,0:05:23.61,0:05:25.07,Default,,0,0,0,,Қара мысық мырза?
Dialogue: 0,0:05:25.15,0:05:28.53,Default,,0,0,0,,Эй... біраз болды, Тор Наиль мырза.
Dialogue: 0,0:05:28.61,0:05:30.32,Default,,0,0,0,,Енді менің атым Йору...
Dialogue: 0,0:05:30.41,0:05:33.37,Default,,0,0,0,,А, сіз келісімшартқа қол қойдыңыз ба?
Dialogue: 0,0:05:33.45,0:05:34.70,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:05:35.46,0:05:37.00,Default,,0,0,0,,Танысқаныма қуаныштымын...
Dialogue: 0,0:05:37.08,0:05:39.04,Default,,0,0,0,,Иә? Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:05:39.54,0:05:40.88,Default,,0,0,0,,Екеуі де жын ғой.
Dialogue: 0,0:05:40.96,0:05:44.26,Default,,0,0,0,,Негізгі зал Кейін түсіндіремін.
Dialogue: 0,0:05:44.34,0:05:47.55,Default,,0,0,0,,Ей, сайыстың басталуына әлі уақыт бар.
Dialogue: 0,0:05:47.63,0:05:49.26,Default,,0,0,0,,Фестивальді тамашалайық
Dialogue: 0,0:05:49.34,0:05:50.64,Default,,0,0,0,,- Келісемін! -(Акира) А...
Dialogue: 0,0:05:51.85,0:05:54.52,Default,,0,0,0,,Сіз оны тез жеңдіңіз.
Dialogue: 0,0:05:59.60,0:06:04.11,Default,,0,0,0,,Мен Rustyмін! Мен сұлулық байқауына қатысамын
Dialogue: 0,0:06:04.19,0:06:07.74,Default,,0,0,0,,Сондықтан барлығыңыз маған дауыс беріңіздер!
Dialogue: 0,0:06:08.78,0:06:09.70,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:06:09.78,0:06:10.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:11.03,0:06:12.33,Default,,0,0,0,,Қозғалмай отырыңыз
Dialogue: 0,0:06:12.41,0:06:13.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:14.99,0:06:16.91,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:06:17.00,0:06:18.92,Default,,0,0,0,,Бұл менің қолтаңбам
Dialogue: 0,0:06:19.00,0:06:21.46,Default,,0,0,0,,Ол аңызға айналған алғашқы қаһарман кейіпкерлерде жазылған.
Dialogue: 0,0:06:21.54,0:06:22.29,Default,,0,0,0,,Керемет, солай ма?
Dialogue: 0,0:06:22.38,0:06:24.42,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:06:24.50,0:06:26.55,Default,,0,0,0,,Қане, сапқа тұр, сапқа тұр!
Dialogue: 0,0:06:26.63,0:06:28.05,Default,,0,0,0,,Бұл бастамасы.
Dialogue: 0,0:06:28.13,0:06:29.93,Default,,0,0,0,,Кезек-кезек қол алысып, қолтаңба берейік!
Dialogue: 0,0:06:30.01,0:06:32.35,Default,,0,0,0,,Мен де тең болады деп ойлаймын.
Dialogue: 0,0:06:32.43,0:06:34.18,Default,,0,0,0,,Қол алысу оқиғасы?
Dialogue: 0,0:06:34.26,0:06:35.97,Default,,0,0,0,,Бұл не жын?
Dialogue: 0,0:06:36.06,0:06:38.31,Default,,0,0,0,,Тор Наил мырза сәл...
Dialogue: 0,0:06:38.39,0:06:41.31,Default,,0,0,0,,Жоқ, ол мүлдем басқа.
Dialogue: 0,0:06:41.40,0:06:44.36,Default,,0,0,0,,Ол бала жын болса да, мен оған ренжімеймін.
Dialogue: 0,0:06:45.53,0:06:48.44,Default,,0,0,0,,Бұл мүлдем басқаша.
Dialogue: 0,0:06:48.53,0:06:49.90,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:06:49.99,0:06:51.45,Default,,0,0,0,,А, иә!
Dialogue: 0,0:06:51.53,0:06:53.66,Default,,0,0,0,,Қараңғы өлтіруші (үнсіз өлтіруші) емес пе?
Dialogue: 0,0:06:53.74,0:06:55.66,Default,,0,0,0,,Ха... иә!
Dialogue: 0,0:06:55.74,0:06:56.87,Default,,0,0,0,,- (Әйелдер) Мынаны қараңдар! -(Акира) А?
Dialogue: 0,0:06:56.95,0:06:58.41,Default,,0,0,0,,Мен туралы айттыңыз ба?
Dialogue: 0,0:06:58.50,0:07:00.46,Default,,0,0,0,,Сіз атақты адамсыз
Dialogue: 0,0:07:00.54,0:07:01.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:01.17,0:07:04.42,Default,,0,0,0,,Құбыжықтар тобын қара сиқырмен жойыңыз.
Dialogue: 0,0:07:04.50,0:07:07.88,Default,,0,0,0,,Сіз айғайлаған қалаға тыныштық орнаттыңыз.
Dialogue: 0,0:07:07.96,0:07:09.97,Default,,0,0,0,,Көп адам қарады
Dialogue: 0,0:07:10.05,0:07:14.80,Default,,0,0,0,,Жарайды, ол кісі өлтіруші болса да, сыпайы әрекет етті.
Dialogue: 0,0:07:14.89,0:07:17.60,Default,,0,0,0,,Бас залдың қызығы осы.
Dialogue: 0,0:07:17.68,0:07:19.35,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:07:19.43,0:07:23.90,Default,,0,0,0,,Куәгерлер сені қара кісі өлтіруші дейді.
Dialogue: 0,0:07:23.98,0:07:27.36,Default,,0,0,0,,«Үнсіз өлтіруші» термині танымал болды.
Dialogue: 0,0:07:27.44,0:07:29.03,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:07:29.11,0:07:30.03,Default,,0,0,0,,(бір нәрсені орналастыру дыбысы)
Dialogue: 0,0:07:30.11,0:07:30.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:30.82,0:07:34.32,Default,,0,0,0,,Мен оны авантюристер гильдиясынан сақтағанымды ұмытып қалдым.
Dialogue: 0,0:07:34.82,0:07:36.83,Default,,0,0,0,,Жұмысыңызды бағалаңыз
Dialogue: 0,0:07:36.91,0:07:40.00,Default,,0,0,0,,Ерекше жағдай ретінде сары дәреже ретінде куәландырылатыны айтылады.
Dialogue: 0,0:07:40.08,0:07:43.37,Default,,0,0,0,,Сертификаттың орнына пайдалануға болатындықтан ыңғайлы
Dialogue: 0,0:07:44.00,0:07:45.46,Default,,0,0,0,,Мен күміс дәрежемін
Dialogue: 0,0:07:46.92,0:07:49.17,Default,,0,0,0,,Ол сарыдан жоғары ма?
Dialogue: 0,0:07:49.26,0:07:50.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:50.92,0:07:54.39,Default,,0,0,0,,Кирика - алтын дәреже. Әлемде бар болғаны 4 адам бар.
Dialogue: 0,0:07:54.89,0:07:56.51,Default,,0,0,0,,Әлгі жігіт күшті еді.
Dialogue: 0,0:07:57.01,0:07:59.89,Default,,0,0,0,,Акира Бәріміз де сары рангпыз.
Dialogue: 0,0:07:59.97,0:08:02.77,Default,,0,0,0,,Мен сізге авантюрист ретінде ақша табуды үйрете аламын.
Dialogue: 0,0:08:02.85,0:08:04.15,Default,,0,0,0,,Менен кез келген уақытта сұраңыз
Dialogue: 0,0:08:04.23,0:08:05.10,Default,,0,0,0,,О
Dialogue: 0,0:08:05.19,0:08:06.52,Default,,0,0,0,,Амелия-чан!
Dialogue: 0,0:08:06.61,0:08:09.36,Default,,0,0,0,,Бұл жерде сирек кездесетін тағамдар бар!
Dialogue: 0,0:08:09.44,0:08:10.57,Default,,0,0,0,,Менің тамақ жегім келеді!
Dialogue: 0,0:08:11.78,0:08:13.95,Default,,0,0,0,,Асахина! Лотерея бар!
Dialogue: 0,0:08:14.03,0:08:16.07,Default,,0,0,0,,Оны түйсігіңмен тап!
Dialogue: 0,0:08:16.57,0:08:19.83,Default,,0,0,0,,Менің дағдыларым олай пайдалануға арналмаған.
Dialogue: 0,0:08:19.91,0:08:22.83,Default,,0,0,0,,Ахаха... Онда кәдімгідей тартып алайық.
Dialogue: 0,0:08:24.25,0:08:26.38,Default,,0,0,0,,Амелияға еріңіз.
Dialogue: 0,0:08:26.88,0:08:29.34,Default,,0,0,0,,Егер сізге қоңырау шалып жатқан адамдар болса, олардың аузын жауып тастаңыз.
Dialogue: 0,0:08:29.42,0:08:30.71,Default,,0,0,0,,Түсінді
Dialogue: 0,0:08:39.18,0:08:41.43,Default,,0,0,0,,Мен білмей тұрып, біз дос болып кеттік.
Dialogue: 0,0:08:41.52,0:08:43.60,Default,,0,0,0,,Осы уақытқа дейін 2 күндік жол
Dialogue: 0,0:08:43.68,0:08:47.02,Default,,0,0,0,,Менің ойымша, бұл олардың бір-бірімен танысуға уақыттары болды дегенді білдіреді.
Dialogue: 0,0:08:47.10,0:08:48.56,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:08:48.65,0:08:52.15,Default,,0,0,0,,Неге менің артымнан ергеніңізді де білмеймін.
Dialogue: 0,0:08:52.65,0:08:55.32,Default,,0,0,0,,Сізді орын алған оқиғалар қызықтырмайды деп ойлаймын.
Dialogue: 0,0:08:57.24,0:09:00.45,Default,,0,0,0,,Менің әпкем бар екенін білесің бе?
Dialogue: 0,0:09:01.70,0:09:03.58,Default,,0,0,0,,Йор мен Амелиядан естіген
Dialogue: 0,0:09:04.62,0:09:07.21,Default,,0,0,0,,Кек алмау себептері
Dialogue: 0,0:09:07.71,0:09:11.00,Default,,0,0,0,,Менің әпкем мұны қаламайды деп ойламаймын.
Dialogue: 0,0:09:11.09,0:09:13.13,Default,,0,0,0,,Мен тым қартайдым
Dialogue: 0,0:09:13.63,0:09:15.22,Default,,0,0,0,,Олай емес сияқты
Dialogue: 0,0:09:15.30,0:09:18.64,Default,,0,0,0,,Айуандардың қартаюын сырттай ғана көрсету қиын.
Dialogue: 0,0:09:18.72,0:09:21.22,Default,,0,0,0,,Қуат әлдеқашан азайып кетті.
Dialogue: 0,0:09:23.52,0:09:28.10,Default,,0,0,0,,Менің әпкемнің жауында үнемі күшті жеке әскер күзетіп тұрады.
Dialogue: 0,0:09:28.19,0:09:30.40,Default,,0,0,0,,Жерлеу оңай емес
Dialogue: 0,0:09:31.27,0:09:34.11,Default,,0,0,0,,Грам кластері осындай адам.
Dialogue: 0,0:09:34.19,0:09:35.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:36.03,0:09:38.41,Default,,0,0,0,,Урук, хайуандардың ең үлкен елі
Dialogue: 0,0:09:38.49,0:09:41.70,Default,,0,0,0,,Корольдік отбасында Грам есімді адам болды ма?
Dialogue: 0,0:09:42.45,0:09:46.37,Default,,0,0,0,,Амелия ханшайымы елге кірген бойда оны жындар нысанаға алды.
Dialogue: 0,0:09:46.46,0:09:47.54,Default,,0,0,0,,Жеңіске жетіп, сол адамдардың өмірімен сол жараларды жазайық
Dialogue: 0,0:09:48.21,0:09:49.08,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:09:49.17,0:09:52.04,Default,,0,0,0,,Грам ақпаратты жындарға сатты.
Dialogue: 0,0:09:52.13,0:09:54.59,Default,,0,0,0,,Оның күшімен
Dialogue: 0,0:09:54.67,0:09:58.80,Default,,0,0,0,,Сауда кемесіндегі жолаушылардың тізімін алу оңай.
Dialogue: 0,0:10:00.51,0:10:01.55,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:10:01.64,0:10:04.39,Default,,0,0,0,,Сен ұйықтап жатқанда мен артта қалдым
Dialogue: 0,0:10:04.47,0:10:08.98,Default,,0,0,0,,Айтпақшы, Лияның аса таяғын өзім жасағанын айта кетейін.
Dialogue: 0,0:10:09.60,0:10:11.56,Default,,0,0,0,,Не? Бұтадан таяқшаға дейін
Dialogue: 0,0:10:11.65,0:10:16.24,Default,,0,0,0,,Штабтағы сиқырлы тас қалған материалдармен үндеседі.
Dialogue: 0,0:10:16.32,0:10:18.82,Default,,0,0,0,,Дағдарысыңды естіп, сенің орныңа жүгірдім.
Dialogue: 0,0:10:19.36,0:10:23.99,Default,,0,0,0,,Көмегіңе рахмет, бірақ қазір бұл туралы неге айтып отырсың?
Dialogue: 0,0:10:24.08,0:10:28.75,Default,,0,0,0,,Себебі, осы оқиғаны айту менің сендермен бірге келуімнің себебі.
Dialogue: 0,0:10:29.92,0:10:33.75,Default,,0,0,0,,Ол сізге кек алуға көмектесті деді.
Dialogue: 0,0:10:35.59,0:10:38.59,Default,,0,0,0,,Мен өлтіруші Акира Оданы сұрағым келеді.
Dialogue: 0,0:10:39.09,0:10:43.51,Default,,0,0,0,,♪～
Dialogue: 0,0:10:45.60,0:10:49.06,Default,,0,0,0,,Мен бірден қорытындыға келмейтінімді білемін.
Dialogue: 0,0:10:49.14,0:10:51.48,Default,,0,0,0,,Сондықтан мен қанша қаласам, сонша айтамын
Dialogue: 0,0:10:53.02,0:10:53.94,Default,,0,0,0,,Қарға мырза
Dialogue: 0,0:10:54.44,0:10:56.57,Default,,0,0,0,,Орналастыруды ұйымдастыру уақыты келді.
Dialogue: 0,0:10:56.65,0:10:57.94,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:58.03,0:11:01.45,Default,,0,0,0,,Сайыс өтетін жерге келгенде менің атымды айтыңыз.
Dialogue: 0,0:11:01.53,0:11:04.66,Default,,0,0,0,,Оқиғаны жайбарақат қарайтын орын дайындаңыз.
Dialogue: 0,0:11:05.16,0:11:07.87,Default,,0,0,0,,Қарға-санның беті кәдімгідей кең.
Dialogue: 0,0:11:08.54,0:11:11.04,Default,,0,0,0,,Көптеген адамдар жақсылық сатады.
Dialogue: 0,0:11:11.96,0:11:15.29,Default,,0,0,0,,Ұзақ өмір сүрсең солай болады.
Dialogue: 0,0:11:21.63,0:11:23.84,Default,,0,0,0,,Енді биылғы сұлулық байқауына.
Dialogue: 0,0:11:23.93,0:11:26.01,Default,,0,0,0,,Бұл одан да қызықты болды.
Dialogue: 0,0:11:26.10,0:11:29.52,Default,,0,0,0,,Одан кейін 289 нөмірі жазылады
Dialogue: 0,0:11:29.60,0:11:32.35,Default,,0,0,0,,Юуки Уэно!
Dialogue: 0,0:11:32.85,0:11:34.52,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:34.61,0:11:36.48,Default,,0,0,0,,Уэно Өте сүйкімді
Dialogue: 0,0:11:36.57,0:11:38.69,Default,,0,0,0,,Мен оны жақынырақ көргім келді.
Dialogue: 0,0:11:38.78,0:11:42.86,Default,,0,0,0,,Мен мұндай орынды Қарғаның қалауы бойынша дайындайды деп ойламаппын.
Dialogue: 0,0:11:42.95,0:11:44.74,Default,,0,0,0,,Мен жеке бөлмені бағалаймын.
Dialogue: 0,0:11:44.82,0:11:48.79,Default,,0,0,0,,Акира қазірдің өзінде атақты және көпшіліктің назарында.
Dialogue: 0,0:11:53.29,0:11:56.59,Default,,0,0,0,,Келесі жазба нөмірі 290
Dialogue: 0,0:11:56.67,0:11:58.46,Default,,0,0,0,,Шиори Хосояма!
Dialogue: 0,0:11:58.55,0:11:59.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:00.09,0:12:02.13,Default,,0,0,0,,Күткендей, Хосояма мырза, бұл жақсы.
Dialogue: 0,0:12:02.22,0:12:03.80,Default,,0,0,0,,Ах, бұл...
Dialogue: 0,0:12:06.39,0:12:07.64,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:12:07.72,0:12:11.48,Default,,0,0,0,,Мырза, келесі кезек Амелия ханымға келді.
Dialogue: 0,0:12:11.56,0:12:13.98,Default,,0,0,0,,Әрі қарай, барлығыңыз күтіңіздер.
Dialogue: 0,0:12:14.06,0:12:17.23,Default,,0,0,0,,Жеңімпаз кандидатты таныстыру!
Dialogue: 0,0:12:17.31,0:12:19.82,Default,,0,0,0,,Жазба нөмірі 291
Dialogue: 0,0:12:19.90,0:12:22.82,Default,,0,0,0,,Амелия Роуз кварц!
Dialogue: 0,0:12:22.90,0:12:25.61,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:12:27.20,0:12:28.33,Default,,0,0,0,,Бұл әдемі...
Dialogue: 0,0:12:29.87,0:12:31.37,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:12:32.16,0:12:34.75,Default,,0,0,0,,Күткендей, сен мені баурап аласың.
Dialogue: 0,0:12:35.50,0:12:36.33,Default,,0,0,0,,О
Dialogue: 0,0:12:36.83,0:12:38.92,Default,,0,0,0,,Толқуым әлі суыған жоқ.
Dialogue: 0,0:12:39.00,0:12:40.59,Default,,0,0,0,,Бұл соңғы рет.
Dialogue: 0,0:12:40.67,0:12:44.26,Default,,0,0,0,,Жазба нөмірі 292 Rusty!
Dialogue: 0,0:12:44.34,0:12:45.26,Default,,0,0,0,,Ах
Dialogue: 0,0:12:52.73,0:12:55.27,Default,,0,0,0,,Иә? Ол жігітті не істеп жатырсың?
Dialogue: 0,0:13:10.41,0:13:12.08,Default,,0,0,0,,Бұл Rusty!
Dialogue: 0,0:13:12.16,0:13:14.33,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:13:14.91,0:13:17.46,Default,,0,0,0,,Барлығына! Дауыс бергеніңіз үшін рахмет!
Dialogue: 0,0:13:18.33,0:13:22.17,Default,,0,0,0,,Мен сенен тағы сұрайын, ол шынымен де жын ба?
Dialogue: 0,0:13:22.25,0:13:25.67,Default,,0,0,0,,Хмм... Сену қиын, бірақ бұл рас.
Dialogue: 0,0:13:25.76,0:13:28.22,Default,,0,0,0,,Дауыстар саналды
Dialogue: 0,0:13:28.30,0:13:32.89,Default,,0,0,0,,Әйелдерге арналған сұлулық байқауының жеңімпазы...
Dialogue: 0,0:13:34.77,0:13:39.15,Default,,0,0,0,,Жазба нөмірі 291 Амелия Роуз Кварц!
Dialogue: 0,0:13:39.23,0:13:41.82,Default,,0,0,0,,№ 292 Тотты!
Dialogue: 0,0:13:41.90,0:13:45.78,Default,,0,0,0,,Бұл тарихта бірінші орынға тең келетін бірінші рет!
Dialogue: 0,0:13:47.91,0:13:50.74,Default,,0,0,0,,Тез және қойылым тамаша шешілген болса да.
Dialogue: 0,0:13:50.83,0:13:54.50,Default,,0,0,0,,Эльф ханшайымымен ұтыс ойыны ең жақсысы ма?
Dialogue: 0,0:13:54.58,0:13:56.96,Default,,0,0,0,,Русти жеңсе, таң қалмас еді.
Dialogue: 0,0:13:57.54,0:13:59.96,Default,,0,0,0,,Амелиямен 50 минут өткізу мақтанатын нәрсе болар еді.
Dialogue: 0,0:14:00.04,0:14:03.50,Default,,0,0,0,,Не? Бауырым, маған қызықсың ба?
Dialogue: 0,0:14:03.59,0:14:06.47,Default,,0,0,0,,Мен мақтанбаймын, бірақ маған ер адамдар ұнайды.
Dialogue: 0,0:14:06.55,0:14:09.84,Default,,0,0,0,,Жоқ, мені тек Амелия қызықтырады.
Dialogue: 0,0:14:11.55,0:14:14.60,Default,,0,0,0,,Тексеріңіз, сіздің махаббатыңыз таң қалдырады.
Dialogue: 0,0:14:14.68,0:14:16.27,Default,,0,0,0,,Бірақ келесі жолы мен жеңемін
Dialogue: 0,0:14:16.35,0:14:18.60,Default,,0,0,0,,Ей, келесі жылы сайысқа бірге қатысайық.
Dialogue: 0,0:14:18.69,0:14:21.23,Default,,0,0,0,,Акира жақсы десе, кетеді.
Dialogue: 0,0:14:21.31,0:14:23.36,Default,,0,0,0,,Бұл... Торлы шеге
Dialogue: 0,0:14:23.86,0:14:26.74,Default,,0,0,0,,Егер сіз тым көп көзге түсетін нәрсені жасасаңыз.
Dialogue: 0,0:14:26.82,0:14:28.36,Default,,0,0,0,,Сенің әкең...
Dialogue: 0,0:14:28.45,0:14:30.66,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:14:30.74,0:14:33.83,Default,,0,0,0,,Себебі мен әкеммен ұрысып, үйден қашып кеттім.
Dialogue: 0,0:14:33.91,0:14:35.87,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:35.95,0:14:37.20,Default,,0,0,0,,Әке?
Dialogue: 0,0:14:37.71,0:14:40.21,Default,,0,0,0,,Эй Йору, бұл жігіт кім?
Dialogue: 0,0:14:40.29,0:14:42.59,Default,,0,0,0,,Тор Наил мырза
Dialogue: 0,0:14:42.67,0:14:44.55,Default,,0,0,0,,Ол жын патшаның қызы.
Dialogue: 0,0:14:44.63,0:14:45.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:45.46,0:14:46.38,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:46.46,0:14:47.84,Default,,0,0,0,,Хмф
Dialogue: 0,0:14:53.14,0:14:55.26,Default,,0,0,0,,Грэм мырза, тапсырысыңызды беріңізші.
Dialogue: 0,0:14:55.35,0:14:57.81,Default,,0,0,0,,Балалар сендер шығудың қажеті жоқ.
Dialogue: 0,0:14:58.31,0:15:00.89,Default,,0,0,0,,Дегенмен, оларға бақылауды назардан тыс қалдырмауларын айтыңыз.
Dialogue: 0,0:15:00.98,0:15:01.98,Default,,0,0,0,,Га
Dialogue: 0,0:15:02.06,0:15:03.77,Default,,0,0,0,,Жындар нені бұзды
Dialogue: 0,0:15:03.86,0:15:07.19,Default,,0,0,0,,Мен қамтамасыз етемін және қамтамасыз етемін
Dialogue: 0,0:15:07.82,0:15:10.65,Default,,0,0,0,,Жақсы мәміле сияқты.
Dialogue: 0,0:15:16.49,0:15:18.91,Default,,0,0,0,,Бұл өте қорқынышты мәртебе.
Dialogue: 0,0:15:19.00,0:15:21.12,Default,,0,0,0,,Ол жын патшаның қызы ма, жоқ па
Dialogue: 0,0:15:21.21,0:15:23.67,Default,,0,0,0,,Мен бұл баланың мықты екенін әу бастан білдім.
Dialogue: 0,0:15:24.17,0:15:27.92,Default,,0,0,0,,Акира да мен айтпас бұрын World Eye қолданбасын қолдануы керек.
Dialogue: 0,0:15:28.01,0:15:30.42,Default,,0,0,0,,Кейбір адамдар қабілеттерін жасырады
Dialogue: 0,0:15:32.34,0:15:33.34,Default,,0,0,0,,О
Dialogue: 0,0:15:33.84,0:15:34.93,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:38.68,0:15:39.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:40.27,0:15:42.23,Default,,0,0,0,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,0:15:42.73,0:15:44.61,Default,,0,0,0,,Қонатын жерім бар.
Dialogue: 0,0:15:44.69,0:15:48.11,Default,,0,0,0,,Ой, сізге басқа бөлме керек пе?
Dialogue: 0,0:15:48.19,0:15:50.69,Default,,0,0,0,,Мен сонда лагерь жасаймын.
Dialogue: 0,0:15:50.78,0:15:53.11,Default,,0,0,0,,Қарт адамнан басқасы
Dialogue: 0,0:15:53.20,0:15:56.62,Default,,0,0,0,,Менімен болмасаң жақсы ұйықтайсың.
Dialogue: 0,0:15:56.70,0:15:59.62,Default,,0,0,0,,Ертең жүлдені алған кезде кездескенше.
Dialogue: 0,0:15:59.70,0:16:00.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:00.87,0:16:02.58,Default,,0,0,0,,Тағы да аға~
Dialogue: 0,0:16:02.67,0:16:04.25,Default,,0,0,0,,А-а, мен сенің атыңды естімедім.
Dialogue: 0,0:16:04.83,0:16:05.83,Default,,0,0,0,,Акира Ода
Dialogue: 0,0:16:05.92,0:16:09.25,Default,,0,0,0,,Иә, бұл Акира. Бұл есімде, аға.
Dialogue: 0,0:16:09.84,0:16:11.72,Default,,0,0,0,,Аты өзгеріссіз қалады.
Dialogue: 0,0:16:13.63,0:16:14.76,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:16:14.84,0:16:17.35,Default,,0,0,0,,Жеңімпаз жүлдені ертең аламын ба?
Dialogue: 0,0:16:17.43,0:16:20.14,Default,,0,0,0,,Иә, мен уақытында дайын болмаған сияқтымын.
Dialogue: 0,0:16:20.81,0:16:22.35,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:16:22.43,0:16:24.52,Default,,0,0,0,,Ерлер арасында жарысқа қатысып, жеңіске жеттім.
Dialogue: 0,0:16:24.60,0:16:25.98,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:16:26.06,0:16:29.02,Default,,0,0,0,,Сарат дегенде батырдан күткендей.
Dialogue: 0,0:16:29.11,0:16:31.03,Default,,0,0,0,,Сіздің жүлдеңіз де тамақ па?
Dialogue: 0,0:16:31.11,0:16:34.15,Default,,0,0,0,,Олай болса, мен оның бәрін Амелияға беремін.
Dialogue: 0,0:16:34.24,0:16:35.53,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:16:35.61,0:16:38.20,Default,,0,0,0,,Акира Йору жоқ...
Dialogue: 0,0:16:38.28,0:16:40.70,Default,,0,0,0,,О, мен сенен бір тапсырманы орындауды өтіндім.
Dialogue: 0,0:16:40.79,0:16:41.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:42.96,0:16:44.71,Default,,0,0,0,,Әзірге жуынып алайық.
Dialogue: 0,0:16:44.79,0:16:45.37,Default,,0,0,0,,О
Dialogue: 0,0:16:45.46,0:16:47.88,Default,,0,0,0,,Солай болса да, дәл қазір бұл таңқаларлық болды.
Dialogue: 0,0:16:48.46,0:16:50.71,Default,,0,0,0,,Акира! Жуынатын бөлмеге бірге барайық
Dialogue: 0,0:16:50.80,0:16:54.09,Default,,0,0,0,,Бірге жасай алмаймыз. Мен әйелдер ваннасын қабылдай алмаймын.
Dialogue: 0,0:16:54.17,0:16:55.68,Default,,0,0,0,,Сіз өзіңіздің қатысуыңызды жасыру арқылы жасай аласыз.
Dialogue: 0,0:16:55.76,0:16:56.97,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:57.05,0:16:59.18,Default,,0,0,0,,Өте өкінішті хехехе
Dialogue: 0,0:16:59.26,0:17:00.26,Default,,0,0,0,,Хм. Арнайы дәрежелі Шинохарадан осы мүмкіндікті де тексертуді қалаймын
Dialogue: 0,0:17:00.76,0:17:04.02,Default,,0,0,0,,Сіз мысалды ұмытқан жоқсыз, солай емес пе?
Dialogue: 0,0:17:05.73,0:17:08.02,Default,,0,0,0,,Аа... Ойланып көрейін.
Dialogue: 0,0:17:12.11,0:17:13.03,Default,,0,0,0,,Не?
Dialogue: 0,0:17:13.11,0:17:16.57,Default,,0,0,0,,Ваннадан бас тартылды Акира шаршады.
Dialogue: 0,0:17:16.66,0:17:19.16,Default,,0,0,0,,Мен кеше де, алдыңғы күні де дұрыс ұйықтамадым.
Dialogue: 0,0:17:21.24,0:17:22.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:24.91,0:17:28.29,Default,,0,0,0,,Оған дейін мен үш күн үзбей ұйықтадым.
Dialogue: 0,0:17:28.38,0:17:29.67,Default,,0,0,0,,Мен жеңіл ұйықтауға үйренгенмін...
Dialogue: 0,0:17:29.75,0:17:30.46,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:31.04,0:17:34.21,Default,,0,0,0,,Акираны қорғау үшін күшті шаралар қабылдаңыз
Dialogue: 0,0:17:34.30,0:17:37.05,Default,,0,0,0,,Сиқырлы ұрпақ мәжбүрлі ұйқы!
Dialogue: 0,0:17:37.55,0:17:38.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:46.19,0:17:48.94,Default,,0,0,0,,Ол өте қатыгез ханшайым.
Dialogue: 0,0:17:49.02,0:17:50.98,Default,,0,0,0,,Акираға не құйдың?
Dialogue: 0,0:17:51.06,0:17:53.48,Default,,0,0,0,,Біз жай ғана жұмыс туралы айттық.
Dialogue: 0,0:17:53.57,0:17:56.86,Default,,0,0,0,,Мен саған Акираға ол қаламайтын нәрсені мәжбүрлеуге рұқсат бермеймін.
Dialogue: 0,0:17:56.95,0:18:00.20,Default,,0,0,0,,Ол жынға соңғы соққыны бермесе керек.
Dialogue: 0,0:18:00.28,0:18:02.62,Default,,0,0,0,,Бұл да сізге қажет емес нәрсе ме?
Dialogue: 0,0:18:02.70,0:18:03.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:05.95,0:18:08.37,Default,,0,0,0,,Не ойласаң да, сенің еркіндігің
Dialogue: 0,0:18:08.46,0:18:11.38,Default,,0,0,0,,Тек Акираның өмір жолын бұрмалама.
Dialogue: 0,0:18:11.46,0:18:14.67,Default,,0,0,0,,Менің олай істеуге ниетім жоқ, мен сені мәжбүрлемеймін.
Dialogue: 0,0:18:14.76,0:18:16.51,Default,,0,0,0,,Ол шешеді.
Dialogue: 0,0:18:16.59,0:18:18.01,Default,,0,0,0,,Және...
Dialogue: 0,0:18:18.09,0:18:21.51,Default,,0,0,0,,Сіз қаламайтын нәрсені жасауға соңғы итермелеу
Dialogue: 0,0:18:21.60,0:18:24.77,Default,,0,0,0,,Бұл сізді қорғау ниеті болуы мүмкін.
Dialogue: 0,0:18:25.47,0:18:26.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:33.27,0:18:36.61,Default,,0,0,0,,Акира мен үшін...
Dialogue: 0,0:18:36.69,0:18:38.95,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:18:43.87,0:18:45.37,Default,,0,0,0,,Бүгін сенің ағаң кім?
Dialogue: 0,0:18:45.45,0:18:46.33,Default,,0,0,0,,(Үш мүйізді) Құрлықтағыдай еркін қозғала алмайсың. Көресің әлі!
Dialogue: 0,0:18:47.37,0:18:49.46,Default,,0,0,0,,Акира қатты шаршады.
Dialogue: 0,0:18:50.04,0:18:52.84,Default,,0,0,0,,Бұлай болады деп ойламаппын.
Dialogue: 0,0:18:52.92,0:18:55.00,Default,,0,0,0,,Онда оны оятпағаны дұрыс.
Dialogue: 0,0:18:55.09,0:18:57.92,Default,,0,0,0,,Иә, мен бүгін сыйлығымды алайын деп жатырмын.
Dialogue: 0,0:18:58.01,0:19:02.39,Default,,0,0,0,,Бұл жеткізу адам саудагерлерінің көздегені болуы мүмкін.
Dialogue: 0,0:19:02.47,0:19:04.72,Default,,0,0,0,,Мен құтқарылдым, себебі Акира жоқ.
Dialogue: 0,0:19:04.81,0:19:07.35,Default,,0,0,0,,Ол осында болса, бізге шығуға жол жоқ.
Dialogue: 0,0:19:07.43,0:19:10.98,Default,,0,0,0,,Мен де сол жын баланың не ойлап жүргенін білмеймін.
Dialogue: 0,0:19:11.06,0:19:13.40,Default,,0,0,0,,Қане, сақ болайық.
Dialogue: 0,0:19:15.65,0:19:18.07,Default,,0,0,0,,Сіз бейтаныс жерлерде сыйлықтар аласыз.
Dialogue: 0,0:19:18.78,0:19:21.53,Default,,0,0,0,,Көрсетілген орын міндетті түрде осында.
Dialogue: 0,0:19:22.03,0:19:23.70,Default,,0,0,0,,Амелия ханшайымымен кездесу
Dialogue: 0,0:19:23.78,0:19:25.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:31.58,0:19:33.29,Default,,0,0,0,,Иә, бірақ не?
Dialogue: 0,0:19:33.92,0:19:36.17,Default,,0,0,0,,Грам-сама сізді шақырды, келіңіз.
Dialogue: 0,0:19:37.25,0:19:38.13,Default,,0,0,0,,Грам…
Dialogue: 0,0:19:38.63,0:19:42.01,Default,,0,0,0,,Әй, мен өз түрімді өз аяшым үшін өлтірдім.
Dialogue: 0,0:19:42.09,0:19:44.68,Default,,0,0,0,,Ол адам ұрлауда көшбасшы болған ақымақ.
Dialogue: 0,0:19:45.26,0:19:48.68,Default,,0,0,0,,Мен ол жігіттің қоңырауына жауап беремін деп ойлайсың ба?
Dialogue: 0,0:19:48.77,0:19:50.77,Default,,0,0,0,,Онда мен сені күшпен сонда апарамын!
Dialogue: 0,0:19:52.06,0:19:53.27,Default,,0,0,0,,Гравитация!
Dialogue: 0,0:19:55.23,0:19:56.27,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:56.36,0:19:57.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:57.36,0:19:59.28,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:19:59.36,0:20:01.24,Default,,0,0,0,,Ха... Сонымен?
Dialogue: 0,0:20:01.32,0:20:03.49,Default,,0,0,0,,Грам менімен не істеуді жоспарлап отыр?
Dialogue: 0,0:20:03.57,0:20:05.16,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:20:05.24,0:20:07.74,Default,,0,0,0,,Бізге оны әкелу ғана қалды.
Dialogue: 0,0:20:07.83,0:20:09.04,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:20:09.12,0:20:12.46,Default,,0,0,0,,Мен сенен он есе көп өмір сүрдім.
Dialogue: 0,0:20:12.54,0:20:15.46,Default,,0,0,0,,Өтірік осындай адамға қарсы әрекет етеді деп ойлайсың ба?
Dialogue: 0,0:20:15.54,0:20:17.46,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:20:17.54,0:20:18.80,Default,,0,0,0,,Әй... сөйлес
Dialogue: 0,0:20:21.38,0:20:24.80,Default,,0,0,0,,Бұрынғы жеңімпаздар, бірақ бәрі емес
Dialogue: 0,0:20:24.89,0:20:27.43,Default,,0,0,0,,Ұсталғандардың органдары сатылады
Dialogue: 0,0:20:28.35,0:20:30.22,Default,,0,0,0,,Өсек-аяң тарай бастағанда
Dialogue: 0,0:20:30.72,0:20:33.23,Default,,0,0,0,,Master Gram оны ақшамен жабады.
Dialogue: 0,0:20:33.31,0:20:35.52,Default,,0,0,0,,Бұл қайталау.
Dialogue: 0,0:20:36.19,0:20:38.44,Default,,0,0,0,,Демек, сен мені сатып жатырсың.
Dialogue: 0,0:20:39.44,0:20:40.94,Default,,0,0,0,,Арх! Уф...
Dialogue: 0,0:20:41.82,0:20:44.70,Default,,0,0,0,,Король болу тек әдемі болуды білдірмейді.
Dialogue: 0,0:20:44.78,0:20:47.95,Default,,0,0,0,,Мұны есте сақта, содан кейін өл.
Dialogue: 0,0:20:48.03,0:20:49.95,Default,,0,0,0,,Иә, тоқта!
Dialogue: 0,0:20:50.04,0:20:51.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:51.95,0:20:53.50,Default,,0,0,0,,(Қара киімнің ыңырануы)
Dialogue: 0,0:20:53.58,0:20:56.75,Default,,0,0,0,,Сахна артында біреу болса да, біреуді өлтіру жақсы емес.
Dialogue: 0,0:20:57.50,0:20:59.67,Default,,0,0,0,,Қарсылас алдымен қаруын суырып алды.
Dialogue: 0,0:20:59.75,0:21:01.63,Default,,0,0,0,,Дуэль қылмыс емес
Dialogue: 0,0:21:02.71,0:21:08.47,Default,,0,0,0,,Жаман адам болсам да, әр адам баласының адамдық тарихы бар.
Dialogue: 0,0:21:08.55,0:21:12.10,Default,,0,0,0,,Менің ойымша, бұл басқалар алып кетпеуі керек нәрсе.
Dialogue: 0,0:21:12.60,0:21:15.64,Default,,0,0,0,,Сондықтан мен ешкімнің көз алдымда өлуіне жол бермеймін.
Dialogue: 0,0:21:19.69,0:21:24.90,Default,,0,0,0,,Бұл... Амелия көріп тұрған нәрсе ме?
Dialogue: 0,0:21:25.49,0:21:28.37,Default,,0,0,0,,Себебі сен мені сиқырмен ұйықтаттың
Dialogue: 0,0:21:28.95,0:21:32.95,Default,,0,0,0,,Сиқыр мен рух бір-бірімен тығыз байланысты ма?
Dialogue: 0,0:21:35.46,0:21:37.21,Default,,0,0,0,,Жарайды, егер мені сонша өлтіргіңіз келсе.
Dialogue: 0,0:21:37.29,0:21:39.17,Default,,0,0,0,,Мен іздемегенде келіңізші.
Dialogue: 0,0:21:40.09,0:21:42.13,Default,,0,0,0,,Мен әділдік жағындамын
Dialogue: 0,0:21:42.21,0:21:45.42,Default,,0,0,0,,Көзге көрінбейтін адамдарды құтқара алмайсың.
Dialogue: 0,0:21:45.51,0:21:49.22,Default,,0,0,0,,Мен Амелия біреуді өлтіргенін көргім келмейді.
Dialogue: 0,0:21:50.68,0:21:53.77,Default,,0,0,0,,Осы жігіттің арқасында мен оны қараудың қажеті болмады.
Dialogue: 0,0:21:58.73,0:22:01.11,Default,,0,0,0,,Егер мен біреуді өлтірсем...
Dialogue: 0,0:22:02.11,0:22:07.03,Default,,0,0,0,,Бұл туралы білгенде Амелия не ойлайды екен.
Dialogue: 0,0:22:11.03,0:22:13.04,Default,,0,0,0,,♪～
Dialogue: 0,0:23:38.91,0:23:40.91,Default,,0,0,0,,～♪
