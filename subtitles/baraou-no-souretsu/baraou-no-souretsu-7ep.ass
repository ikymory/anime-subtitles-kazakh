Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.42,0:00:07.13,Default,,0,0,0,,Сіз кімге бәс тігесіз?
Dialogue: 0,0:00:07.21,0:00:08.75,Default,,0,0,0,,Мен Джорджға бәс тігемін
Dialogue: 0,0:00:08.84,0:00:10.09,Default,,0,0,0,,Мен де Король Джордж боламын
Dialogue: 0,0:00:11.21,0:00:14.09,Default,,0,0,0,,Өйткені, Уорвик графы біз жақта.
Dialogue: 0,0:00:14.18,0:00:17.10,Default,,0,0,0,,Бұл елде Лорд Кингмейкерге тең келетін ешкім жоқ...
Dialogue: 0,0:00:17.18,0:00:19.06,Default,,0,0,0,,Эдвардқа бәс тігу
Dialogue: 0,0:00:19.14,0:00:21.77,Default,,0,0,0,,Осыған байланысты, жас ханым
Dialogue: 0,0:00:21.85,0:00:23.94,Default,,0,0,0,,Әйелдер әдемі еркектерді жақсы көреді.
Dialogue: 0,0:00:24.02,0:00:25.23,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:00:25.31,0:00:28.86,Default,,0,0,0,,Мен нағыз Эдвардты бір-ақ рет көргім келеді.
Dialogue: 0,0:00:29.36,0:00:31.23,Default,,0,0,0,,Олар ұсталған жер осы ма?
Dialogue: 0,0:00:31.32,0:00:32.99,Default,,0,0,0,,Ол енді мұнда емес.
Dialogue: 0,0:00:33.74,0:00:35.74,Default,,0,0,0,,Менің көңілімді көтеретін болсаң
Dialogue: 0,0:00:35.82,0:00:37.37,Default,,0,0,0,,Баратын жерімді айтсам да...
Dialogue: 0,0:00:37.45,0:00:39.62,Default,,0,0,0,,Маған бірден айтыңыз (қоғамдық A) А...
Dialogue: 0,0:00:39.70,0:00:40.83,Default,,0,0,0,,(Ыдыстардың құлаған дыбысы)
Dialogue: 0,0:00:40.91,0:00:42.70,Default,,0,0,0,,Сондай-ақ... Кешіріңіз.
Dialogue: 0,0:00:43.20,0:00:46.92,Default,,0,0,0,,Саған қызмет ететін болсам, әйел болғанын қалаймын.
Dialogue: 0,0:00:49.34,0:00:50.55,Default,,0,0,0,,Эдвард
Dialogue: 0,0:00:52.84,0:00:55.68,Default,,0,0,0,,Қалағаныңызша, әйел...
Dialogue: 0,0:00:56.26,0:00:57.59,Default,,0,0,0,,Бұл мойын.
Dialogue: 0,0:01:01.51,0:01:03.56,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:03.64,0:01:05.73,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:06.23,0:01:12.19,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:12.69,0:01:17.53,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:01:21.49,0:01:23.50,Default,,0,0,0,,♪～
Dialogue: 0,0:02:47.37,0:02:49.37,Default,,0,0,0,,～♪
Dialogue: 0,0:02:52.00,0:02:53.67,Default,,0,0,0,,Уф... Бұл өтірік.
Dialogue: 0,0:02:54.25,0:02:55.50,Default,,0,0,0,,Өтірік екенін айт
Dialogue: 0,0:02:59.67,0:03:01.09,Default,,0,0,0,,Жай әзіл.
Dialogue: 0,0:03:01.18,0:03:03.51,Default,,0,0,0,,Өкінішке орай, әйелім
Dialogue: 0,0:03:03.60,0:03:06.43,Default,,0,0,0,,Сіз дәл уақытында ғибадатханаға қашып үлгердіңіз.
Dialogue: 0,0:03:06.93,0:03:09.06,Default,,0,0,0,,Мен өкілдік етуді осылай сұрадым.
Dialogue: 0,0:03:10.35,0:03:11.60,Default,,0,0,0,,Сіздің…
Dialogue: 0,0:03:14.02,0:03:16.07,Default,,0,0,0,,Қайын атама
Dialogue: 0,0:03:17.86,0:03:21.20,Default,,0,0,0,,Уорвик Егер бұған рұқсат етілсе...
Dialogue: 0,0:03:21.28,0:03:22.91,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:03:23.41,0:03:26.78,Default,,0,0,0,,Парламент сізді тағыңыздан ресми түрде айырады.
Dialogue: 0,0:03:26.87,0:03:29.54,Default,,0,0,0,,Егер Джордж жаңа патша болса
Dialogue: 0,0:03:29.62,0:03:32.83,Default,,0,0,0,,Сіздің әйеліңіз енді өлтіруге тұрарлық емес.
Dialogue: 0,0:03:32.92,0:03:34.00,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:03:34.50,0:03:37.92,Default,,0,0,0,,Менен тағыны алуға құқы бар.
Dialogue: 0,0:03:38.42,0:03:42.30,Default,,0,0,0,,Расымен де, алып кете алмасам
Dialogue: 0,0:03:42.38,0:03:45.60,Default,,0,0,0,,Бәлкім, Құдайға оны алып тастауға рұқсат беру керек шығар.
Dialogue: 0,0:03:46.39,0:03:48.01,Default,,0,0,0,,Мен қорқатындай.
Dialogue: 0,0:03:48.51,0:03:51.85,Default,,0,0,0,,Өйткені, Уорвик біз жақта емес еді.
Dialogue: 0,0:03:52.56,0:03:57.73,Default,,0,0,0,,Сіз мені Францияға қайтарып, ештеңе болмағандай кейіп танытқыңыз келе ме?
Dialogue: 0,0:04:04.41,0:04:06.03,Default,,0,0,0,,Не, сен!
Dialogue: 0,0:04:06.12,0:04:09.08,Default,,0,0,0,,Мен сізге бөлменің толып кеткенін талай рет айттым!
Dialogue: 0,0:04:09.16,0:04:11.54,Default,,0,0,0,,Орын жоқ болса, бейшара тұтынушыларды қуып жібер!
Dialogue: 0,0:04:11.62,0:04:12.25,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:15.08,0:04:15.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:16.33,0:04:19.21,Default,,0,0,0,,Уф... сен қандайсың?
Dialogue: 0,0:04:20.63,0:04:24.05,Default,,0,0,0,,Бұл Уорвиктің елтаңбасы...
Dialogue: 0,0:04:28.30,0:04:31.64,Default,,0,0,0,,Бұл әдепті қылыш, мен оны саған сақтаймын.
Dialogue: 0,0:04:31.72,0:04:33.43,Default,,0,0,0,,Бұл әйел...
Dialogue: 0,0:04:34.56,0:04:36.27,Default,,0,0,0,,Егер әйел өлтірсе
Dialogue: 0,0:04:36.35,0:04:38.27,Default,,0,0,0,,Бұл сіздің беделіңізге нұқсан келтіреді.
Dialogue: 0,0:04:38.77,0:04:41.32,Default,,0,0,0,,Ақшаға сатып алынған абырой болса да
Dialogue: 0,0:04:41.40,0:04:43.28,Default,,0,0,0,,Қарғыс атсын, қызметші!
Dialogue: 0,0:04:43.78,0:04:45.66,Default,,0,0,0,,Сен мықтысың, солай ма?
Dialogue: 0,0:04:45.74,0:04:49.16,Default,,0,0,0,,Қонатын жер іздесеңіз, екі адамға арналған орын бар.
Dialogue: 0,0:04:49.24,0:04:52.66,Default,,0,0,0,,Бұл рас па? Мен атты сәл демалдырғым келеді.
Dialogue: 0,0:04:52.75,0:04:54.83,Default,,0,0,0,,Жанжал үшін кешірім сұраймын.
Dialogue: 0,0:04:54.91,0:04:57.88,Default,,0,0,0,,Ерлі-зайыптыларды іздеуде болмайды, солай ма?
Dialogue: 0,0:04:58.46,0:05:01.34,Default,,0,0,0,,Қараңдар, тұтынушылар, біз жаңамыз!
Dialogue: 0,0:05:02.38,0:05:03.63,Default,,0,0,0,,Құрметті Ричард...
Dialogue: 0,0:05:03.72,0:05:05.68,Default,,0,0,0,,Жерге қарағанда жақсы
Dialogue: 0,0:05:05.76,0:05:06.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:06.72,0:05:08.55,Default,,0,0,0,,Сонда сіз қабырғаға айнала аласыз.
Dialogue: 0,0:05:14.64,0:05:15.85,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:20.48,0:05:23.32,Default,,0,0,0,,Бала кезімде қорқынышты түс көретінмін.
Dialogue: 0,0:05:23.82,0:05:26.40,Default,,0,0,0,,Мен сені бір рет ояттым.
Dialogue: 0,0:05:28.74,0:05:30.62,Default,,0,0,0,,Дене температурасының жылуы
Dialogue: 0,0:05:31.12,0:05:33.87,Default,,0,0,0,,Мен оны енді ешқашан алмаймын деп ойладым.
Dialogue: 0,0:05:36.46,0:05:41.25,Default,,0,0,0,,Бұл күн соңғы рет...Генри
Dialogue: 0,0:05:44.84,0:05:46.22,Default,,0,0,0,,Жетті. Мен сені де, әпкеңді де өлтіремін.
Dialogue: 0,0:05:46.92,0:05:48.51,Default,,0,0,0,,(Сөйлесіп отырған қонақтардың дауысы)
Dialogue: 0,0:06:01.44,0:06:02.48,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:06:02.57,0:06:05.65,Default,,0,0,0,,Кешегі адам Уорвиктен келген хабаршы болған сияқты.
Dialogue: 0,0:06:07.61,0:06:08.61,Default,,0,0,0,,Онда...
Dialogue: 0,0:06:10.16,0:06:13.33,Default,,0,0,0,,Кэтсби екеуміз оны жалғыз алып шығуымыз мүмкін емес.
Dialogue: 0,0:06:14.58,0:06:16.37,Default,,0,0,0,,Менің одақтастарым көбірек болса...
Dialogue: 0,0:06:19.46,0:06:20.54,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:06:20.63,0:06:24.38,Default,,0,0,0,,Мен Уорвиктің сатқындығын елемей, Францияға орала алмаймын...
Dialogue: 0,0:06:24.46,0:06:26.51,Default,,0,0,0,,Осылай жалғаса берсе, менің махаббатым...
Dialogue: 0,0:06:29.84,0:06:31.05,Default,,0,0,0,,Ричард…
Dialogue: 0,0:06:33.30,0:06:34.72,Default,,0,0,0,,Уорвиктің бағыныштысы екеніне сенімдісіз бе?
Dialogue: 0,0:06:34.81,0:06:35.85,Default,,0,0,0,,Кешіріңіз, мен жасырын жолаушымын.
Dialogue: 0,0:06:35.93,0:06:39.56,Default,,0,0,0,,Мені қонаққа шақырды, бірақ мен оған ешқашан сенбедім.
Dialogue: 0,0:06:39.64,0:06:41.65,Default,,0,0,0,,Бірақ сен менің соңынан ердің бе?
Dialogue: 0,0:06:41.73,0:06:44.36,Default,,0,0,0,,Енді мен Уорвиктен кек алғым келеді.
Dialogue: 0,0:06:44.86,0:06:45.82,Default,,0,0,0,,Сізге де солай емес пе?
Dialogue: 0,0:06:45.90,0:06:47.94,Default,,0,0,0,,Менің кім екенімді білесің бе?
Dialogue: 0,0:06:48.03,0:06:48.78,Default,,0,0,0,,Білмеймін!
Dialogue: 0,0:06:48.86,0:06:51.16,Default,,0,0,0,,Сен сүйкімді қыз екенсің басқа.
Dialogue: 0,0:06:54.33,0:06:56.12,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:06:56.62,0:06:59.83,Default,,0,0,0,,Сіздің әйеліңіз ретінде мен сізді сарайға дейін ертіп баруға рұқсат етіңіз.
Dialogue: 0,0:07:01.92,0:07:03.17,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:07:05.80,0:07:07.88,Default,,0,0,0,,Адамдардың менің бетімді мүмкіндігінше көргенін қаламаймын
Dialogue: 0,0:07:08.38,0:07:11.76,Default,,0,0,0,,Мен атқа мінгеннен басқа уақытта жалғыз баруға рұқсат етіңізші.
Dialogue: 0,0:07:11.84,0:07:12.89,Default,,0,0,0,,Әрине.
Dialogue: 0,0:07:20.43,0:07:24.81,Default,,0,0,0,,Мен ханшайым боламын деген арман сияқты
Dialogue: 0,0:07:26.27,0:07:28.44,Default,,0,0,0,,Мәртебелі Корольді тұтқынға алу?
Dialogue: 0,0:07:28.94,0:07:31.24,Default,,0,0,0,,Неліктен әкең мұндай әрекетке барады?
Dialogue: 0,0:07:31.32,0:07:33.16,Default,,0,0,0,,Бұл Эдвардтың кінәсі.
Dialogue: 0,0:07:33.74,0:07:36.49,Default,,0,0,0,,Әке тек әділдікті жүзеге асырды.
Dialogue: 0,0:07:39.75,0:07:41.04,Default,,0,0,0,,Құрметті Ричард...
Dialogue: 0,0:07:41.71,0:07:46.21,Default,,0,0,0,,Операция қамалға келіп, әскерді таратқаннан кейін бірден өтеді.
Dialogue: 0,0:07:46.71,0:07:49.88,Default,,0,0,0,,Бұл сарбаздардың ең шаршаған және босаңсыған кезі.
Dialogue: 0,0:07:50.47,0:07:51.13,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:51.92,0:07:55.34,Default,,0,0,0,,Сіз ерекше қонақ сияқтысыз.
Dialogue: 0,0:07:55.85,0:07:58.97,Default,,0,0,0,,Ерекше мінез-құлыққа белгілі бір дәрежеде рұқсат етіледі
Dialogue: 0,0:08:00.14,0:08:01.18,Default,,0,0,0,,Міне (Ханзада Эдвард) Уау...
Dialogue: 0,0:08:01.77,0:08:05.06,Default,,0,0,0,,Сіз мені Эдвард патшаға бересіз.
Dialogue: 0,0:08:05.56,0:08:07.19,Default,,0,0,0,,Жоғары дәрежелі жезөкше ретінде
Dialogue: 0,0:08:07.27,0:08:10.65,Default,,0,0,0,,Ал... саған берсем ше? Жоқ, өтінемін, мені кешіріңіз.
Dialogue: 0,0:08:10.74,0:08:13.03,Default,,0,0,0,,Өзіңізге жақсырақ қарау керек!
Dialogue: 0,0:08:15.11,0:08:19.04,Default,,0,0,0,,Шынымен еркекпен жатуға болмайды, бұл әзіл емес.
Dialogue: 0,0:08:20.16,0:08:22.25,Default,,0,0,0,,Бірақ бұл денені қолдануға болады.
Dialogue: 0,0:08:22.75,0:08:24.62,Default,,0,0,0,,Бұл дене жексұрын...
Dialogue: 0,0:08:26.63,0:08:30.38,Default,,0,0,0,,Жарайды, егер көп айтсаң.
Dialogue: 0,0:08:32.22,0:08:35.01,Default,,0,0,0,,Ал... Мен сенен бір нәрсе сұрауым керек.
Dialogue: 0,0:08:35.72,0:08:39.26,Default,,0,0,0,,Ой... сен менің қызымсың ба?
Dialogue: 0,0:08:39.76,0:08:40.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:40.35,0:08:43.43,Default,,0,0,0,,Сен мені ренжітетін данышпансың.
Dialogue: 0,0:08:43.52,0:08:45.94,Default,,0,0,0,,Ал, әлгі ғашық...
Dialogue: 0,0:08:46.02,0:08:48.19,Default,,0,0,0,,Менде ондай ештеңе жоқ.
Dialogue: 0,0:08:48.69,0:08:49.73,Default,,0,0,0,,Бұдан былай да
Dialogue: 0,0:08:51.73,0:08:55.15,Default,,0,0,0,,Бұл рас па? Әкең кім?
Dialogue: 0,0:08:56.32,0:08:59.12,Default,,0,0,0,,Бұл денеде әлі ешкім жоқ...
Dialogue: 0,0:09:00.74,0:09:04.21,Default,,0,0,0,,Жоқ! Ричард маған сенеді.
Dialogue: 0,0:09:06.04,0:09:09.84,Default,,0,0,0,,Бірақ мұндай мүмкіндіктер енді жоқ...
Dialogue: 0,0:09:14.42,0:09:15.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:16.34,0:09:17.30,Default,,0,0,0,,Құрметті Ричард!
Dialogue: 0,0:09:17.80,0:09:19.43,Default,,0,0,0,,(көлге кірген дыбыс)
Dialogue: 0,0:09:20.51,0:09:23.89,Default,,0,0,0,,Көп жылғы бақытсыздықтан кейін мақтанышыңызды ұмыттыңыз ба?
Dialogue: 0,0:09:24.39,0:09:26.48,Default,,0,0,0,,Мен Ланкастер ханзадасымын.
Dialogue: 0,0:09:27.65,0:09:31.15,Default,,0,0,0,,Өзіңіз қалаған нәрсені әділ және нақты түрде алыңыз
Dialogue: 0,0:09:31.23,0:09:34.19,Default,,0,0,0,,Өйткені мен патша болатын адаммын!
Dialogue: 0,0:09:34.69,0:09:36.57,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:09:37.32,0:09:41.16,Default,,0,0,0,,Қонақ үйге жеткенше әлі уақыт бар. Қарап көргіңіз келе ме?
Dialogue: 0,0:09:41.66,0:09:42.79,Default,,0,0,0,,Не үшін?
Dialogue: 0,0:09:42.87,0:09:44.45,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:09:44.54,0:09:49.17,Default,,0,0,0,,Егер сіз жоғары санатты жезөкше болсаңыз, сәл көбірек киім киіңіз...
Dialogue: 0,0:09:50.71,0:09:53.17,Default,,0,0,0,,Әйел жүрегін жаулағыңыз келсе...
Dialogue: 0,0:09:54.76,0:09:55.92,Default,,0,0,0,,Бұл сыйлық!
Dialogue: 0,0:09:56.42,0:09:58.30,Default,,0,0,0,,Менің ойымша, бұл жеткілікті.
Dialogue: 0,0:09:58.38,0:10:00.05,Default,,0,0,0,,Әйтеуір, әйтеуір.
Dialogue: 0,0:10:00.14,0:10:02.89,Default,,0,0,0,,Бұл туралы не деуге болады? Бұл сізге жақсы көрінеді
Dialogue: 0,0:10:02.97,0:10:04.77,Default,,0,0,0,,Неліктен оны киіп көрмеске?
Dialogue: 0,0:10:04.85,0:10:05.56,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:05.64,0:10:07.27,Default,,0,0,0,,Оны пайдаланып көріңіз
Dialogue: 0,0:10:09.10,0:10:11.15,Default,,0,0,0,,Қылыш сермеу қиын емес пе?
Dialogue: 0,0:10:11.23,0:10:15.11,Default,,0,0,0,,Өте сүйкімді! Мен оны суретке салып, артта қалдырғым келеді.
Dialogue: 0,0:10:15.19,0:10:16.40,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:10:16.90,0:10:19.57,Default,,0,0,0,,Тек бет аймағыңызды жауып тұратын шүберекті пайдаланыңыз
Dialogue: 0,0:10:21.57,0:10:23.83,Default,,0,0,0,,Неліктен? Ақша бар!
Dialogue: 0,0:10:23.91,0:10:26.62,Default,,0,0,0,,Сіз неғұрлым көп киінсеңіз, соншалықты әйелдікке айналасыз!
Dialogue: 0,0:10:28.12,0:10:29.96,Default,,0,0,0,,Сондықтан маған ұнамайды
Dialogue: 0,0:10:31.21,0:10:33.79,Default,,0,0,0,,Сіз мені әйел ретінде көресіз бе?
Dialogue: 0,0:10:34.96,0:10:36.30,Default,,0,0,0,,Л-Ллойд, қарашы…
Dialogue: 0,0:10:38.26,0:10:39.34,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:43.35,0:10:48.14,Default,,0,0,0,,Ол қиын әйел. Өйткені, бұл оңай емес.
Dialogue: 0,0:10:48.77,0:10:50.23,Default,,0,0,0,,Бірақ бұл жақсы нәрсе.
Dialogue: 0,0:10:51.40,0:10:54.32,Default,,0,0,0,,Адамдар көп. Ажырасудан сақ болыңыз.
Dialogue: 0,0:10:56.61,0:10:59.03,Default,,0,0,0,,Менің жігіттігім туралы не ойлайсың?
Dialogue: 0,0:10:59.53,0:11:01.49,Default,,0,0,0,,Жаяу жүру қиын. Жіберу.
Dialogue: 0,0:11:01.57,0:11:02.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:04.70,0:11:05.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:11.25,0:11:13.96,Default,,0,0,0,,Құлпынай бәлішін алғыңыз келе ме?
Dialogue: 0,0:11:15.46,0:11:17.67,Default,,0,0,0,,Әй, дүкенші, маған екі бер, тез!
Dialogue: 0,0:11:18.17,0:11:20.01,Default,,0,0,0,,Маған басқасын сатып алыңыз.
Dialogue: 0,0:11:20.09,0:11:22.09,Default,,0,0,0,,Мен қанша қаласаңыз, сонша сатып аламын!
Dialogue: 0,0:11:31.27,0:11:31.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:39.07,0:11:41.45,Default,,0,0,0,,Жақсы ма? Мен де өзімді істеймін бе?
Dialogue: 0,0:11:42.15,0:11:43.82,Default,,0,0,0,,Сіз тамақ ішпейсіз бе?
Dialogue: 0,0:11:43.91,0:11:47.58,Default,,0,0,0,,Жарайды, мен саған қалағаныңды сатып алғым келді.
Dialogue: 0,0:11:48.08,0:11:50.45,Default,,0,0,0,,Сіз қалаған нәрсеге қол жеткізбедіңіз бе?
Dialogue: 0,0:11:51.79,0:11:55.71,Default,,0,0,0,,Менің қалағаным...
Dialogue: 0,0:11:59.63,0:12:00.88,Default,,0,0,0,,Маған тәж керек
Dialogue: 0,0:12:03.93,0:12:06.76,Default,,0,0,0,,Тәжін тек король талап ете алады.
Dialogue: 0,0:12:07.35,0:12:09.85,Default,,0,0,0,,Мен мұны білемін, бірақ...
Dialogue: 0,0:12:09.93,0:12:11.64,Default,,0,0,0,,Тек тілеу – күнә
Dialogue: 0,0:12:12.85,0:12:17.02,Default,,0,0,0,,Егер сіз патшаны құтқарсаңыз, сіз сыйлық ретінде алтын тәж аласыз.
Dialogue: 0,0:12:17.11,0:12:18.23,Default,,0,0,0,,Сіз...
Dialogue: 0,0:12:19.11,0:12:20.99,Default,,0,0,0,,Сіз ешқашан тілек тілеп көрмедіңіз бе?
Dialogue: 0,0:12:21.99,0:12:26.07,Default,,0,0,0,,Қылмыс жасау болса да, мен бірдеңе алғым келеді.
Dialogue: 0,0:12:29.12,0:12:30.54,Default,,0,0,0,,Күнә болса да...
Dialogue: 0,0:12:32.66,0:12:34.37,Default,,0,0,0,,Жасалса да
Dialogue: 0,0:12:39.00,0:12:40.88,Default,,0,0,0,,Сәл демалуларыңызды қалаймын.
Dialogue: 0,0:12:40.96,0:12:42.84,Default,,0,0,0,,Жұмыс күші жетіспейді.
Dialogue: 0,0:12:42.92,0:12:45.26,Default,,0,0,0,,Соңғы уақытта мұнда да, жерде де жанжал көп болды, солай ма?
Dialogue: 0,0:12:45.34,0:12:48.72,Default,,0,0,0,,Мен айтқанымдай сат, сәтсіздікке ұшырама.
Dialogue: 0,0:12:48.80,0:12:52.48,Default,,0,0,0,,Маған қалдыр, пәктігіңді сақтаймын.
Dialogue: 0,0:12:53.81,0:12:56.27,Default,,0,0,0,,үшінңызға сәлем, жұмысыңыз сәтті өтсін.
Dialogue: 0,0:12:56.35,0:12:57.65,Default,,0,0,0,,Ой
Dialogue: 0,0:12:57.73,0:13:01.40,Default,,0,0,0,,Мен мұнда не үшін келгеніме сенің неге күдіктенетініңді түсінемін.
Dialogue: 0,0:13:01.48,0:13:03.03,Default,,0,0,0,,Бірақ бұл солай
Dialogue: 0,0:13:03.86,0:13:06.49,Default,,0,0,0,,Эдвардқа олжаны аулауға рұқсат етіңіз.
Dialogue: 0,0:13:07.07,0:13:08.57,Default,,0,0,0,,Мен сондай қызғаншақпын
Dialogue: 0,0:13:09.07,0:13:11.20,Default,,0,0,0,,Ал, мен сендерге ашуға рұқсат етіңіздер.
Dialogue: 0,0:13:14.62,0:13:15.66,Default,,0,0,0,,Бауырым...
Dialogue: 0,0:13:16.17,0:13:17.12,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:13:17.63,0:13:21.25,Default,,0,0,0,,Мүмкін болса, есікті ашық қалдырыңыз.
Dialogue: 0,0:13:21.75,0:13:23.01,Default,,0,0,0,,Ол қадағаланады ма?
Dialogue: 0,0:13:28.43,0:13:31.76,Default,,0,0,0,,Бұл кім? Не айтқың келеді?
Dialogue: 0,0:13:32.26,0:13:34.23,Default,,0,0,0,,Мен оның өлтіруші екеніне сене алар емеспін.
Dialogue: 0,0:13:34.85,0:13:37.65,Default,,0,0,0,,Жоқ ешқашан
Dialogue: 0,0:13:38.48,0:13:38.98,Default,,0,0,0,,Рича…
Dialogue: 0,0:13:39.06,0:13:39.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:43.90,0:13:45.69,Default,,0,0,0,,Кешіріңіз, Мәртебелі.
Dialogue: 0,0:13:45.78,0:13:50.53,Default,,0,0,0,,Мен жай ғана Эдвардтың жүрегін сақтағым келеді.
Dialogue: 0,0:13:52.95,0:13:54.62,Default,,0,0,0,,Сүйкімді жігіт
Dialogue: 0,0:13:55.12,0:13:57.04,Default,,0,0,0,,Енді маған дәлелді көрсетіңіз.
Dialogue: 0,0:13:58.83,0:14:02.25,Default,,0,0,0,,Түсіндім, дайынмын.
Dialogue: 0,0:14:02.34,0:14:04.63,Default,,0,0,0,,Бірақ бұл тамаша мүмкіндік.
Dialogue: 0,0:14:05.21,0:14:06.13,Default,,0,0,0,,Сәлем түрмеші
Dialogue: 0,0:14:06.84,0:14:10.14,Default,,0,0,0,,Неге бәрің есікті жауып, осында келмейсіңдер?
Dialogue: 0,0:14:13.26,0:14:16.14,Default,,0,0,0,,Неліктен? Неге ешкім келмейді?
Dialogue: 0,0:14:16.23,0:14:19.40,Default,,0,0,0,,Жоғары мәртебелі! Түрлі жерлерде қақтығыстар мен қақтығыстардың көптеген белгілері бар.
Dialogue: 0,0:14:19.48,0:14:22.61,Default,,0,0,0,,Лордтардан олардың аумағынан шығу қиын екені туралы хабар!
Dialogue: 0,0:14:22.69,0:14:24.44,Default,,0,0,0,,Жоғары мәртебелі! Бұл қолдау сұрауы.
Dialogue: 0,0:14:24.53,0:14:26.49,Default,,0,0,0,,Бұған дейін осы петицияны жіберіңіз!
Dialogue: 0,0:14:26.57,0:14:29.07,Default,,0,0,0,,Король! патша – мен
Dialogue: 0,0:14:32.70,0:14:35.79,Default,,0,0,0,,Қақтығыстың себебі - патшаның жоқтығы.
Dialogue: 0,0:14:35.87,0:14:38.54,Default,,0,0,0,,Формальды патша билігі ғана басқара алады
Dialogue: 0,0:14:38.62,0:14:40.67,Default,,0,0,0,,Олай болса мені тез патша етіңіз...
Dialogue: 0,0:14:40.75,0:14:42.50,Default,,0,0,0,,Парламент өтуі керек
Dialogue: 0,0:14:42.59,0:14:44.55,Default,,0,0,0,,Мен сені патша ете алмаймын
Dialogue: 0,0:14:45.42,0:14:48.13,Default,,0,0,0,,Егер Эдвард өлмесе...
Dialogue: 0,0:14:48.63,0:14:52.34,Default,,0,0,0,,Егер сіз осы жақтан келсеңіз, қауіпсіздік салыстырмалы түрде жеңіл болуы керек.
Dialogue: 0,0:14:52.85,0:14:55.81,Default,,0,0,0,,Кэтсби атын жетектеп, қамал сыртында жасырынып жатыр.
Dialogue: 0,0:14:55.89,0:14:56.52,Default,,0,0,0,,Осындай күйде тежеліп тұру аса жағымды емес
Dialogue: 0,0:15:04.27,0:15:06.53,Default,,0,0,0,,Сондай-ақ... бұл өте қымбат.
Dialogue: 0,0:15:06.61,0:15:08.44,Default,,0,0,0,,Плащыңды шеш (Ханзада Эдвард) Иә?
Dialogue: 0,0:15:08.53,0:15:10.40,Default,,0,0,0,,Мен суға батып кетемін (Ханзада Эдвард) Уау!
Dialogue: 0,0:15:12.07,0:15:13.12,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:15:13.20,0:15:15.24,Default,,0,0,0,,Мен сізге белгі берген бойда маған қарай жүріңіз.
Dialogue: 0,0:15:15.33,0:15:16.91,Default,,0,0,0,,Кэтсбиге нұсқау береді
Dialogue: 0,0:15:16.99,0:15:19.08,Default,,0,0,0,,Жарайды, сіз де дереу келуіңіз керек.
Dialogue: 0,0:15:33.97,0:15:36.76,Default,,0,0,0,,Тез, күзетші келе жатыр.
Dialogue: 0,0:15:36.85,0:15:37.72,Default,,0,0,0,,Эй
Dialogue: 0,0:15:41.73,0:15:42.77,Default,,0,0,0,,Біз бірге барамыз ба?
Dialogue: 0,0:15:45.73,0:15:46.23,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:46.94,0:15:49.53,Default,,0,0,0,,көремін. Олай болса, қоштасу.
Dialogue: 0,0:15:50.03,0:15:51.99,Default,,0,0,0,,Асылып қалмау үшін сақ болыңыз
Dialogue: 0,0:15:52.07,0:15:54.82,Default,,0,0,0,,Ал... күте тұрыңыз! бұл
Dialogue: 0,0:15:55.41,0:15:59.41,Default,,0,0,0,,Мен оны базардан сатып алдым. Оны мен сияқты ұстаңыз.
Dialogue: 0,0:16:07.34,0:16:08.50,Default,,0,0,0,,Бір күні тағы да...
Dialogue: 0,0:16:09.46,0:16:11.26,Default,,0,0,0,,Біз қайтадан кездескенше
Dialogue: 0,0:16:12.55,0:16:17.85,Default,,0,0,0,,Сол кезде мен сізге патша болып міндетті түрде келемін.
Dialogue: 0,0:16:20.22,0:16:23.52,Default,,0,0,0,,Мәртебелі, уақыты мен орны шұғыл.
Dialogue: 0,0:16:23.60,0:16:25.52,Default,,0,0,0,,Қуғыншыларыңыз келмей тұрып, қайықпен шетелге барыңыз!
Dialogue: 0,0:16:30.44,0:16:33.82,Default,,0,0,0,,Ақымақ қуғыншы тым ерте келді
Dialogue: 0,0:16:40.16,0:16:42.71,Default,,0,0,0,,Мәртебелі король Эдвард IV
Dialogue: 0,0:16:44.08,0:16:47.04,Default,,0,0,0,,Месс Букингем сізді алып кетуге келді.
Dialogue: 0,0:16:49.67,0:16:52.13,Default,,0,0,0,,Сіз өте жақсы жұмыс істедіңіз.
Dialogue: 0,0:16:52.21,0:16:55.84,Default,,0,0,0,,Адалдығың үшін сауап алатын уақыт келеді.
Dialogue: 0,0:16:56.34,0:16:58.68,Default,,0,0,0,,Бүгін кешке қанағаттанғанша демалыңыз.
Dialogue: 0,0:16:59.18,0:17:01.81,Default,,0,0,0,,Керек болса әйелді дайындаймын.
Dialogue: 0,0:17:02.43,0:17:03.64,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:17:04.14,0:17:07.48,Default,,0,0,0,,Бірақ дәл қазір мен әйелден артық нәрсені қалаймын.
Dialogue: 0,0:17:08.36,0:17:09.36,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:17:13.36,0:17:14.86,Default,,0,0,0,,Сен кеткенше мен киімімді ауыстырайын.
Dialogue: 0,0:17:14.95,0:17:17.41,Default,,0,0,0,,Сіз бұл киіммен жақсы көрінесіз.
Dialogue: 0,0:17:18.37,0:17:21.29,Default,,0,0,0,,Біздің не істеп жатқанымызды қайдан білдің?
Dialogue: 0,0:17:21.37,0:17:22.79,Default,,0,0,0,,Мен сені іздедім
Dialogue: 0,0:17:23.41,0:17:27.54,Default,,0,0,0,,Менің ағамды құтқарғаныңыз күтпеген еді, бірақ бұл ыңғайлы болды.
Dialogue: 0,0:17:28.04,0:17:32.76,Default,,0,0,0,,Ағаңның жерлеу шайқасына айналса, ерлік пен әділетті болады.
Dialogue: 0,0:17:32.84,0:17:34.67,Default,,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:17:34.76,0:17:36.80,Default,,0,0,0,,Қазір әлі уақыт бар
Dialogue: 0,0:17:37.80,0:17:41.43,Default,,0,0,0,,Тақтың бір тікенін алып таста.
Dialogue: 0,0:17:42.06,0:17:43.77,Default,,0,0,0,,Сұраса, мынаны айта аласыз.
Dialogue: 0,0:17:44.35,0:17:47.35,Default,,0,0,0,,Мен оны құтқарғанымда, ол өліп қалды.
Dialogue: 0,0:17:56.40,0:17:57.82,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:17:58.32,0:18:01.24,Default,,0,0,0,,Мен Йорк корольдік отбасының тыныштығы мен қауіпсіздігін қалаймын.
Dialogue: 0,0:18:02.28,0:18:04.91,Default,,0,0,0,,Менің қазір қалайтыным әйел емес
Dialogue: 0,0:18:05.00,0:18:07.71,Default,,0,0,0,,Мен дәл қазір бір ғана нәрсені қалаймын
Dialogue: 0,0:18:08.29,0:18:10.88,Default,,0,0,0,,Бұл сенсің, Уорвик.
Dialogue: 0,0:18:11.54,0:18:13.21,Default,,0,0,0,,Сен мені мазақ қылдың.
Dialogue: 0,0:18:13.92,0:18:17.55,Default,,0,0,0,,Мен енді ешқашан қуаныш көрмеймін
Dialogue: 0,0:18:18.05,0:18:20.68,Default,,0,0,0,,Мен сенің басыңды алғанша
Dialogue: 0,0:18:20.76,0:18:22.89,Default,,0,0,0,,Эдвард қашып кетті ме?
Dialogue: 0,0:18:22.97,0:18:25.89,Default,,0,0,0,,Біреу кіріп, шығарып алған сияқты...
Dialogue: 0,0:18:25.97,0:18:28.77,Default,,0,0,0,,Қолдаушылардың кез келген саны ойға келуі мүмкін.
Dialogue: 0,0:18:28.85,0:18:31.15,Default,,0,0,0,,Ричард та әлі табылған жоқ.
Dialogue: 0,0:18:32.02,0:18:35.57,Default,,0,0,0,,Патша құтқарылса, жаудың рухы көтеріледі.
Dialogue: 0,0:18:35.65,0:18:38.03,Default,,0,0,0,,үшінна оларды босатқанымызды айт.
Dialogue: 0,0:18:38.11,0:18:38.61,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:38.70,0:18:40.74,Default,,0,0,0,,Ренжімеңіз!
Dialogue: 0,0:18:40.82,0:18:45.54,Default,,0,0,0,,Ағам әскер жинаса да, қазір бізді жеңе алмас еді.
Dialogue: 0,0:18:46.04,0:18:49.79,Default,,0,0,0,,Мен патшамын! Адамның жүрегі біздікі!
Dialogue: 0,0:18:49.87,0:18:51.54,Default,,0,0,0,,Бірақ қазір
Dialogue: 0,0:18:51.63,0:18:55.17,Default,,0,0,0,,Патшаның жоқтығынан дүниенің тұрақсыздығынан қолдаушылар екі есе қысқарды.
Dialogue: 0,0:18:55.67,0:18:58.72,Default,,0,0,0,,Жағдай қалқыған кеме сияқты тұрақсыз.
Dialogue: 0,0:18:58.80,0:18:59.76,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:01.47,0:19:04.60,Default,,0,0,0,,Мен оның қадірлі қонағымын.
Dialogue: 0,0:19:05.10,0:19:08.18,Default,,0,0,0,,Дұрыс? Уорвик
Dialogue: 0,0:19:08.93,0:19:10.10,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:12.73,0:19:14.23,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:19:15.15,0:19:17.11,Default,,0,0,0,,Айтшы, Уорвик.
Dialogue: 0,0:19:17.78,0:19:19.49,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:19:20.03,0:19:20.95,Default,,0,0,0,,Құрметті Джордж
Dialogue: 0,0:19:22.57,0:19:25.12,Default,,0,0,0,,Сіз ағаңызды өлтіруге дайынсыз ба?
Dialogue: 0,0:19:25.62,0:19:29.54,Default,,0,0,0,,Мынау... Өлтірмесеңіз де, қайтадан қолға түсіру керек.
Dialogue: 0,0:19:30.04,0:19:32.50,Default,,0,0,0,,Джордж әлі жеңе алмайды
Dialogue: 0,0:19:33.92,0:19:35.46,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:19:35.54,0:19:37.17,Default,,0,0,0,,Мен сізден тағы сұраймын.
Dialogue: 0,0:19:37.25,0:19:38.17,Default,,0,0,0,,Ханзада
Dialogue: 0,0:19:39.30,0:19:42.89,Default,,0,0,0,,Уәде бойынша мен саған қызымды беремін.
Dialogue: 0,0:19:42.97,0:19:45.10,Default,,0,0,0,,Ханзада? Не айтқың келеді?
Dialogue: 0,0:19:45.72,0:19:48.35,Default,,0,0,0,,Уәде дегеніміз не? Айтыңызшы! Уорвик!
Dialogue: 0,0:19:48.43,0:19:49.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:50.73,0:19:52.27,Default,,0,0,0,,Хехе…
Dialogue: 0,0:19:59.69,0:20:03.36,Default,,0,0,0,,Мені қайта көргеніңіз үшін рахмет, қымбатты Уорвик.
Dialogue: 0,0:20:03.99,0:20:08.54,Default,,0,0,0,,Енді, Эдвард, қалыңдығыңды ал.
Dialogue: 0,0:20:12.92,0:20:13.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:13.83,0:20:17.46,Default,,0,0,0,,Әке, сіз маған патшайым болатынымды айттыңыз!
Dialogue: 0,0:20:17.54,0:20:19.88,Default,,0,0,0,,Жағдай өзгерді.
Dialogue: 0,0:20:20.42,0:20:20.92,Default,,0,0,0,,(Туған туыс) Олай деуге болады, бірақ (Туған туыс) бұл маңызды мәселе.
Dialogue: 0,0:20:22.01,0:20:24.89,Default,,0,0,0,,Сіз енді Эдвардтың әйелісіз.
Dialogue: 0,0:20:25.59,0:20:27.35,Default,,0,0,0,,Келесі патшаның әйелі.
Dialogue: 0,0:20:27.43,0:20:32.89,Default,,0,0,0,,Бұдан былай Невилл отбасы өз тағдырын Ланкастриан отбасымен бөліседі.
Dialogue: 0,0:20:33.39,0:20:34.35,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:20:34.85,0:20:36.06,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:36.15,0:20:39.11,Default,,0,0,0,,Қорқынышты... қорқынышты
Dialogue: 0,0:20:39.19,0:20:40.78,Default,,0,0,0,,(Изабелланың айқайы)
Dialogue: 0,0:20:40.86,0:20:41.78,Default,,0,0,0,,Изабель…
Dialogue: 0,0:20:41.86,0:20:43.15,Default,,0,0,0,,Шынымен. Түскі асқа таяп қалды ғой, иә?
Dialogue: 0,0:20:43.24,0:20:45.99,Default,,0,0,0,,Сіздің әпкеңіз ақырында патшайым болады.
Dialogue: 0,0:20:46.07,0:20:48.12,Default,,0,0,0,,Мен қатты толқып кеттім, өзімді ақымақ сезінемін
Dialogue: 0,0:20:48.83,0:20:52.54,Default,,0,0,0,,Соншалықты аянышты... Қандай аянышты.
Dialogue: 0,0:20:53.96,0:20:55.62,Default,,0,0,0,,Кешір мені, Изабель
Dialogue: 0,0:20:56.21,0:20:58.84,Default,,0,0,0,,Бірақ мен бақытсыз адаммын
Dialogue: 0,0:21:00.05,0:21:03.13,Default,,0,0,0,,Бізде шамалы болса да түсіністік бар деп қате ойлап қалдым.
Dialogue: 0,0:21:03.63,0:21:05.80,Default,,0,0,0,,Мен Ричардқа ғашық болдым...
Dialogue: 0,0:21:07.43,0:21:08.80,Default,,0,0,0,,Тек формада
Dialogue: 0,0:21:09.35,0:21:10.72,Default,,0,0,0,,Жүрек бұл...
Dialogue: 0,0:21:14.10,0:21:15.94,Default,,0,0,0,,Жүрек бұл жерде емес
Dialogue: 0,0:21:18.48,0:21:20.40,Default,,0,0,0,,Сонымен тағы да
Dialogue: 0,0:21:20.48,0:21:23.61,Default,,0,0,0,,Уорвик Оны барлығының алдында жариялаңыз.
Dialogue: 0,0:21:24.19,0:21:26.20,Default,,0,0,0,,Англия королінің аты-жөні
Dialogue: 0,0:21:28.87,0:21:30.49,Default,,0,0,0,,Бүгін, осы жақсы күнде
Dialogue: 0,0:21:31.33,0:21:35.96,Default,,0,0,0,,Құдай шынайы Патшаны тағына қайтарды.
Dialogue: 0,0:21:38.25,0:21:42.67,Default,,0,0,0,,Осы есімді асқақтата білген бақытымызға шүкіршілік етейік.
Dialogue: 0,0:21:43.46,0:21:44.97,Default,,0,0,0,,Мырзамыз...
Dialogue: 0,0:21:47.18,0:21:49.55,Default,,0,0,0,,Мәртебелі король Генри VI
Dialogue: 0,0:22:01.48,0:22:03.48,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:30.95,Default,,0,0,0,,～♪
