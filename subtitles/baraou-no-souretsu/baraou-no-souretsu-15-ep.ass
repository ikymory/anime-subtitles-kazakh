Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.33,0:00:05.96,Default,,0,0,0,,Құдай... әкеме көмектес.
Dialogue: 0,0:00:08.46,0:00:09.84,Default,,0,0,0,,Фуфуфуфу аа...
Dialogue: 0,0:00:09.92,0:00:11.30,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:00:12.26,0:00:14.47,Default,,0,0,0,,Бұл тамаша қойылым болды.
Dialogue: 0,0:00:15.05,0:00:16.30,Default,,0,0,0,,Мәртебелі патшайым
Dialogue: 0,0:00:20.18,0:00:21.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:22.27,0:00:23.31,Default,,0,0,0,,Бауырым...
Dialogue: 0,0:00:23.81,0:00:26.56,Default,,0,0,0,,Оның менде болмағанның бәрі болды.
Dialogue: 0,0:00:27.06,0:00:30.69,Default,,0,0,0,,Әкемнің айнасы болған мінсіз адам
Dialogue: 0,0:00:31.19,0:00:31.82,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:32.32,0:00:34.15,Default,,0,0,0,,Бұл қорқынышты бет.
Dialogue: 0,0:00:37.74,0:00:41.29,Default,,0,0,0,,Ри... Шард
Dialogue: 0,0:00:42.66,0:00:44.75,Default,,0,0,0,,Енді патша емес
Dialogue: 0,0:00:45.92,0:00:48.46,Default,,0,0,0,,Өлетін кез келді, ағайын.
Dialogue: 0,0:00:50.67,0:00:53.38,Default,,0,0,0,,Эдвардтың уақыты жақындап қалды.
Dialogue: 0,0:00:55.51,0:00:56.72,Default,,0,0,0,,Кеттік
Dialogue: 0,0:00:57.22,0:01:02.52,Default,,0,0,0,,Патшаның байлығы да кешіре алмаған күнәларды өтеу.
Dialogue: 0,0:01:06.90,0:01:07.94,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:01:09.36,0:01:10.40,Default,,0,0,0,,Уорвик
Dialogue: 0,0:01:16.53,0:01:18.57,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:18.66,0:01:20.70,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:21.20,0:01:27.21,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:27.71,0:01:32.55,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:01:36.51,0:01:38.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:02.84,0:03:04.85,Default,,0,0,0,,～♪
Dialogue: 0,0:03:07.27,0:03:12.06,Default,,0,0,0,,Құдайдың, Ұлының және Рухтың атымен, Әумин.
Dialogue: 0,0:03:13.35,0:03:18.94,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:32.46,0:03:34.04,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,0:03:34.13,0:03:36.84,Default,,0,0,0,,Өлім сені кенеттен алып кетеді
Dialogue: 0,0:03:37.34,0:03:39.21,Default,,0,0,0,,Қарсы тұрудың жолы жоқ
Dialogue: 0,0:03:39.76,0:03:42.43,Default,,0,0,0,,Ұрыс даласында біреуді өлтірумен бірдей.
Dialogue: 0,0:03:42.93,0:03:44.51,Default,,0,0,0,,Құдай да өлімді аңсау керек.
Dialogue: 0,0:03:47.56,0:03:48.68,Default,,0,0,0,,Букингем
Dialogue: 0,0:03:49.18,0:03:52.14,Default,,0,0,0,,Ең бірінші өлтірген адам есіңізде ме?
Dialogue: 0,0:03:53.14,0:03:55.52,Default,,0,0,0,,Жоқ, оның мәні неде?
Dialogue: 0,0:03:56.02,0:03:58.48,Default,,0,0,0,,Жаңа есіме түсті
Dialogue: 0,0:03:59.07,0:04:03.32,Default,,0,0,0,,Джон Грей... Элизабеттің күйеуі болған адам
Dialogue: 0,0:04:04.16,0:04:07.62,Default,,0,0,0,,Мен сізді аты-жөні жоқ солдат өлтірді деп естідім...
Dialogue: 0,0:04:08.12,0:04:09.29,Default,,0,0,0,,Оны маған не үшін бердіңіз?
Dialogue: 0,0:04:10.75,0:04:12.83,Default,,0,0,0,,Менде құпия жоқ деп ант бердім.
Dialogue: 0,0:04:19.34,0:04:21.42,Default,,0,0,0,,Мен барлығын саған қоямын
Dialogue: 0,0:04:22.13,0:04:24.18,Default,,0,0,0,,Маған опасыздық жасама
Dialogue: 0,0:04:28.14,0:04:30.35,Default,,0,0,0,,Бүгін барлық ақымақтардың күні!
Dialogue: 0,0:04:30.93,0:04:33.77,Default,,0,0,0,,Ер – әйел, бала – ересек.
Dialogue: 0,0:04:33.85,0:04:37.31,Default,,0,0,0,,Жындылық әлемінде қайыршы патша бола алады!
Dialogue: 0,0:04:38.11,0:04:40.53,Default,,0,0,0,,Сізге де тәж керек пе?
Dialogue: 0,0:04:41.65,0:04:44.78,Default,,0,0,0,,Мен... патша бола алмаймын
Dialogue: 0,0:04:44.86,0:04:49.08,Default,,0,0,0,,Неліктен? Бұл жынды дүние емес пе?
Dialogue: 0,0:04:49.58,0:04:52.37,Default,,0,0,0,,Тіпті шайтан да патша бола алады
Dialogue: 0,0:04:52.91,0:04:53.58,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:04:54.08,0:04:56.87,Default,,0,0,0,,Лорд Хастингстің шұғыл хабары.
Dialogue: 0,0:04:56.96,0:04:59.59,Default,,0,0,0,,Эрл Риверс регент лауазымына ие болу үшін.
Dialogue: 0,0:04:59.67,0:05:03.30,Default,,0,0,0,,Ол жоғары мәртебелі тақ мұрагерін үлкен әскермен патша сарайына апаруды жоспарлап отырғанын айтты.
Dialogue: 0,0:05:04.42,0:05:06.55,Default,,0,0,0,,Бұл жерде бізде де әскери дайындық бар.
Dialogue: 0,0:05:07.05,0:05:09.26,Default,,0,0,0,,Мен дереу ханзаданы алып келейін.
Dialogue: 0,0:05:09.35,0:05:13.73,Default,,0,0,0,,Жаңа патшаны ертіп, қадір-қасиетімізді көрсету арқылы.
Dialogue: 0,0:05:13.81,0:05:18.52,Default,,0,0,0,,Бұл Энтони, Риверс графы регент ретінде танылуға тиіс.
Dialogue: 0,0:05:18.60,0:05:20.77,Default,,0,0,0,,Бұл тек ханзаданы қарсы алу туралы емес.
Dialogue: 0,0:05:20.86,0:05:22.61,Default,,0,0,0,,Сіздің жұмысыңыз
Dialogue: 0,0:05:23.65,0:05:27.24,Default,,0,0,0,,Ричардты ұстап алып, мұнараға апарыңыз
Dialogue: 0,0:05:27.32,0:05:31.58,Default,,0,0,0,,Мен Джонды өз қолыммен өлтірген адамды өлтіремін.
Dialogue: 0,0:05:32.54,0:05:33.29,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:33.87,0:05:38.00,Default,,0,0,0,,Джонның өлімі туралы шындықты айтқаныңыз үшін рахмет.
Dialogue: 0,0:05:38.75,0:05:42.96,Default,,0,0,0,,Букингем... менің патшам
Dialogue: 0,0:05:43.71,0:05:46.09,Default,,0,0,0,,Мен Эрл Риверстің көшкенін естігенде.
Dialogue: 0,0:05:46.17,0:05:49.22,Default,,0,0,0,,Ол кісі міндетті түрде менің соңымнан үлкен әскермен келеді.
Dialogue: 0,0:05:50.01,0:05:54.89,Default,,0,0,0,,Сіз жалғыз келіп, онымен достық шыныаяқтарын ауыстырасыз.
Dialogue: 0,0:05:54.97,0:05:58.19,Default,,0,0,0,,Сақтандырсаң, мені сатқындық үшін қамауға ал.
Dialogue: 0,0:05:58.27,0:06:00.94,Default,,0,0,0,,Бірақ мен оның әскерінің қоршауында болсам ше?
Dialogue: 0,0:06:01.69,0:06:02.98,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:06:03.48,0:06:09.03,Default,,0,0,0,,Мен күткен менің сарбаздарым Ричардты өлтірді.
Dialogue: 0,0:06:11.32,0:06:13.83,Default,,0,0,0,,Әй, бұл қандай киімдер?
Dialogue: 0,0:06:13.91,0:06:15.95,Default,,0,0,0,,Мен бұл киіммен патша сарайына барғым келмейді!
Dialogue: 0,0:06:16.04,0:06:17.33,Default,,0,0,0,,Мәртебелі тақ мұрагері…
Dialogue: 0,0:06:17.41,0:06:18.29,Default,,0,0,0,,Мені Мәртебелі деп атаңыз
Dialogue: 0,0:06:18.37,0:06:20.25,Default,,0,0,0,,Мен патшамын!
Dialogue: 0,0:06:20.33,0:06:23.25,Default,,0,0,0,,Сондай-ақ... Кешіріңіз, Мәртебелі.
Dialogue: 0,0:06:23.34,0:06:25.21,Default,,0,0,0,,Қарғыс атқыр ақымақ.
Dialogue: 0,0:06:25.30,0:06:27.42,Default,,0,0,0,,Аз ғана серік бар.
Dialogue: 0,0:06:27.51,0:06:29.43,Default,,0,0,0,,Ричард неге келмейді?
Dialogue: 0,0:06:30.01,0:06:32.01,Default,,0,0,0,,Жақындап келе жатқан сияқты.
Dialogue: 0,0:06:32.10,0:06:34.56,Default,,0,0,0,,Эрл Риверс сізді алып кетуге бара жатыр.
Dialogue: 0,0:06:34.64,0:06:36.89,Default,,0,0,0,,Мәртебелі осында түнейді...
Dialogue: 0,0:06:37.48,0:06:39.39,Default,,0,0,0,,Демалыңыз
Dialogue: 0,0:06:40.44,0:06:42.81,Default,,0,0,0,,(Сарбаздардың ізі)
Dialogue: 0,0:06:42.90,0:06:45.53,Default,,0,0,0,,Сізді көргеніме қуаныштымын, Ричард, мен сізді көптен күттім.
Dialogue: 0,0:06:46.11,0:06:47.40,Default,,0,0,0,,Эрл Риверс
Dialogue: 0,0:06:48.11,0:06:48.99,Default,,0,0,0,,Басқа серіктері бар ма?
Dialogue: 0,0:06:49.57,0:06:50.70,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:06:51.28,0:06:53.12,Default,,0,0,0,,Бұл үлкен әскер емес пе еді?
Dialogue: 0,0:06:53.62,0:06:54.99,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:56.24,0:06:57.95,Default,,0,0,0,,Мәртебелі тақ мұрагері қайда?
Dialogue: 0,0:06:58.45,0:07:02.38,Default,,0,0,0,,Кешіріңіз, бірақ жоғары мәртебелі мәртебені қорғау үшін бізге өте аз адамдар керек...
Dialogue: 0,0:07:02.46,0:07:05.88,Default,,0,0,0,,Жарайды, бұл жолдағы шаршауды басады деп ойлаймын.
Dialogue: 0,0:07:05.96,0:07:08.09,Default,,0,0,0,,Мен сенің келетініңе сендім.
Dialogue: 0,0:07:08.97,0:07:13.30,Default,,0,0,0,,Осыншама көп әскерді басқарғаның бізді қорғау үшін емес пе?
Dialogue: 0,0:07:14.14,0:07:16.97,Default,,0,0,0,,Әй, құрметті жездем!
Dialogue: 0,0:07:17.06,0:07:19.31,Default,,0,0,0,,Қайтыс болған патшаның рухының тыныштығы үшін
Dialogue: 0,0:07:19.39,0:07:22.60,Default,,0,0,0,,Қол ұстасып, жаңа патшаға қолдау көрсетейік!
Dialogue: 0,0:07:23.19,0:07:24.86,Default,,0,0,0,,Енді шарап.
Dialogue: 0,0:07:24.94,0:07:28.15,Default,,0,0,0,,Бүгін кешті бірге көңілді өткізейік, тек екеуміз.
Dialogue: 0,0:07:30.36,0:07:31.74,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:07:32.32,0:07:36.74,Default,,0,0,0,,Сіз аздап ішкен сияқтысыз. Графты бөлмеңе апар.
Dialogue: 0,0:07:37.24,0:07:38.79,Default,,0,0,0,,Мен де қазір қайтып демаламын.
Dialogue: 0,0:07:40.20,0:07:43.50,Default,,0,0,0,,Қожайыныңыздың қорқынышы негізсіз болған сияқты.
Dialogue: 0,0:07:44.00,0:07:47.80,Default,,0,0,0,,Солай ма? Егер солай болса, бұл жақсы.
Dialogue: 0,0:07:49.05,0:07:52.22,Default,,0,0,0,,Қол ұстасып, жаңа патшаны қолдаңыз...
Dialogue: 0,0:07:52.72,0:07:55.39,Default,,0,0,0,,Менің қалағаным - Йорк корольдік отбасының тыныштығы мен қауіпсіздігі.
Dialogue: 0,0:07:55.89,0:07:58.85,Default,,0,0,0,,Ол үшін тіпті Джордж да құрбан болды.
Dialogue: 0,0:08:00.10,0:08:04.06,Default,,0,0,0,,Неліктен әкең сол күні патша болуға шешім қабылдады?
Dialogue: 0,0:08:05.15,0:08:09.11,Default,,0,0,0,,Қаласам да, қолым ешқашан жарықты ұстай алмайды...
Dialogue: 0,0:08:09.19,0:08:10.65,Default,,0,0,0,,(қозғалатын өсімдіктердің дыбысы)
Dialogue: 0,0:08:11.61,0:08:12.74,Default,,0,0,0,,Қайсысы қоқыс екенін айтып бере аласыз ба?
Dialogue: 0,0:08:13.61,0:08:14.66,Default,,0,0,0,,Ұры?
Dialogue: 0,0:08:16.03,0:08:17.16,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:17.99,0:08:20.41,Default,,0,0,0,,Дау-дамай шығармаған дұрыс
Dialogue: 0,0:08:20.50,0:08:24.37,Default,,0,0,0,,Бұл дененің сыры ашылса, отқа жағыласың.
Dialogue: 0,0:08:25.42,0:08:26.42,Default,,0,0,0,,Сен осы жолы сол тікұшаққа мінгің келмейтін шығар, иә?
Dialogue: 0,0:08:27.42,0:08:30.34,Default,,0,0,0,,Мен сені анық есімде сақтаймын
Dialogue: 0,0:08:30.42,0:08:31.80,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:08:31.88,0:08:32.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:33.55,0:08:35.97,Default,,0,0,0,,Ормандағы қараусыз үйдегі бала...
Dialogue: 0,0:08:36.05,0:08:39.47,Default,,0,0,0,,Кір плащ және жарамсыз шынжырлы пошта
Dialogue: 0,0:08:39.56,0:08:42.31,Default,,0,0,0,,Астында не жасырылған...
Dialogue: 0,0:08:43.60,0:08:45.27,Default,,0,0,0,,Ібілістің денесі
Dialogue: 0,0:08:45.35,0:08:47.77,Default,,0,0,0,,Ақымақ! Сол кезде...
Dialogue: 0,0:08:47.86,0:08:52.03,Default,,0,0,0,,Өз сарбаздарың сені бәрібір қорғайды деп ойлайсың, солай ма?
Dialogue: 0,0:08:52.11,0:08:55.53,Default,,0,0,0,,Бірақ мен де үлкен әскердің тірегі бар.
Dialogue: 0,0:08:56.03,0:08:58.99,Default,,0,0,0,,Солай емес пе? Букингем герцогы
Dialogue: 0,0:08:59.49,0:09:00.91,Default,,0,0,0,,Букингем!
Dialogue: 0,0:09:01.91,0:09:05.62,Default,,0,0,0,,Сіз оны жоққа шығармайсыз ба? Ол кісінің ақымақтығы
Dialogue: 0,0:09:05.71,0:09:06.58,Default,,0,0,0,,Қандай шу, жын-перілер.
Dialogue: 0,0:09:07.21,0:09:08.54,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:09:11.46,0:09:11.96,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:09:12.05,0:09:12.80,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:13.84,0:09:16.51,Default,,0,0,0,,(киімнің жыртылған дыбысы)
Dialogue: 0,0:09:17.51,0:09:20.14,Default,,0,0,0,,Қараңызшы, бұл шайтанның куәлігі.
Dialogue: 0,0:09:26.64,0:09:30.61,Default,,0,0,0,,Өз көзіммен көрмейінше сенбедім
Dialogue: 0,0:09:30.69,0:09:32.28,Default,,0,0,0,,Енді сіз білесіз.
Dialogue: 0,0:09:32.36,0:09:34.69,Default,,0,0,0,,Мына жігіт осы елді құртпақшы.
Dialogue: 0,0:09:34.78,0:09:37.15,Default,,0,0,0,,Корольдік отбасына жіберілген шайтан!
Dialogue: 0,0:09:37.66,0:09:39.99,Default,,0,0,0,,Біртүрлі, мен ештеңе сезбеймін.
Dialogue: 0,0:09:40.91,0:09:42.45,Default,,0,0,0,,Бұл табиғи қорытынды.
Dialogue: 0,0:09:42.95,0:09:47.16,Default,,0,0,0,,Жарық... шайтанға түспейді.
Dialogue: 0,0:09:48.33,0:09:51.13,Default,,0,0,0,,Өйткені, Құдай маған қарап тұрды.
Dialogue: 0,0:09:51.63,0:09:55.46,Default,,0,0,0,,Енді, мәртебелі мәртебелі, маған атақ пен ақша беруге уәде беремін!
Dialogue: 0,0:09:55.97,0:09:58.26,Default,,0,0,0,,Мен саған қалағаныңды беремін
Dialogue: 0,0:09:58.84,0:10:00.22,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:10:03.56,0:10:05.06,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:10:05.14,0:10:07.10,Default,,0,0,0,,Тағы бір сөзбен алмассақ
Dialogue: 0,0:10:07.18,0:10:09.15,Default,,0,0,0,,Жанның құны төмендейді.
Dialogue: 0,0:10:10.19,0:10:12.61,Default,,0,0,0,,Орындалу? мен
Dialogue: 0,0:10:13.73,0:10:17.82,Default,,0,0,0,,Эрл Риверс сізді сатқындық жасады деген күдікпен ертең таңертең тұтқындайды.
Dialogue: 0,0:10:18.32,0:10:22.58,Default,,0,0,0,,Вудвиллдің сізбен билік бөлісуге ниеті жоқ.
Dialogue: 0,0:10:22.66,0:10:26.50,Default,,0,0,0,,Ал бұл органда патша болуға ешқандай біліктілігің жоқ.
Dialogue: 0,0:10:27.62,0:10:28.71,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:10:30.37,0:10:32.34,Default,,0,0,0,,Неге оны менен жасырдың?
Dialogue: 0,0:10:32.84,0:10:35.67,Default,,0,0,0,,Осы денені біліп, үмітім үзілсе ше?
Dialogue: 0,0:10:36.59,0:10:38.88,Default,,0,0,0,,Мені жоғалтып аламын ба деп қорықтыңыз ба?
Dialogue: 0,0:10:40.13,0:10:40.97,Default,,0,0,0,,Сіз?
Dialogue: 0,0:10:41.05,0:10:42.35,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:42.43,0:10:45.31,Default,,0,0,0,,Екеуміз кездескенде... Мен әйел екен деп ойладым.
Dialogue: 0,0:10:45.81,0:10:47.18,Default,,0,0,0,,Дәл сол кезде мен елестеткендей.
Dialogue: 0,0:10:47.27,0:10:48.73,Default,,0,0,0,,Тоқта! мен...
Dialogue: 0,0:10:48.81,0:10:50.27,Default,,0,0,0,,Ер адам болса ше?
Dialogue: 0,0:10:50.35,0:10:54.65,Default,,0,0,0,,Еркек екеніңіз рас, бірақ сізді әйелдік жағыңыз үшін жақсы көрген кезіңіз болды ма?
Dialogue: 0,0:10:54.73,0:10:55.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:55.73,0:10:59.32,Default,,0,0,0,,Мен өзімді көптен бері жасырып жүрмін.
Dialogue: 0,0:10:59.82,0:11:01.11,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:11:01.74,0:11:03.24,Default,,0,0,0,,Біз бірдейміз
Dialogue: 0,0:11:05.58,0:11:08.58,Default,,0,0,0,,Егер сіз маған ешкім білмейтін адамды ұсынатын болсаңыз,
Dialogue: 0,0:11:09.08,0:11:11.33,Default,,0,0,0,,Мен шайтанның жартысы боламын
Dialogue: 0,0:11:12.46,0:11:14.29,Default,,0,0,0,,Ібіліс... Ібіліс
Dialogue: 0,0:11:14.38,0:11:18.26,Default,,0,0,0,,Құдайдың еркіне бағынбады... Қанды...
Dialogue: 0,0:11:19.09,0:11:21.76,Default,,0,0,0,,Ричард, соңғы мүмкіндік.
Dialogue: 0,0:11:21.84,0:11:23.89,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені аласыз ба?
Dialogue: 0,0:11:23.97,0:11:27.14,Default,,0,0,0,,Ештеңені ұға алмай өміріңді аяқтайсың ба?
Dialogue: 0,0:11:28.85,0:11:29.93,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:11:30.02,0:11:31.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:31.60,0:11:34.73,Default,,0,0,0,,Нені қалайтыныңызды айтыңыз
Dialogue: 0,0:11:35.48,0:11:37.94,Default,,0,0,0,,Сіз әрқашан қалаған нәрсе
Dialogue: 0,0:11:38.53,0:11:39.40,Default,,0,0,0,,Қалағаныңды айт!
Dialogue: 0,0:11:41.24,0:11:42.99,Default,,0,0,0,,Хо...
Dialogue: 0,0:11:44.78,0:11:45.95,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:11:47.08,0:11:48.04,Default,,0,0,0,,Мен мұны қалаймын
Dialogue: 0,0:11:48.74,0:11:51.16,Default,,0,0,0,,Мен тәж алғым келеді...
Dialogue: 0,0:11:52.62,0:11:55.63,Default,,0,0,0,,Мен сізге тәжді беремін
Dialogue: 0,0:11:55.71,0:11:56.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:57.50,0:11:59.84,Default,,0,0,0,,Осы ауырсынуды есте сақтаңыз
Dialogue: 0,0:12:00.34,0:12:02.63,Default,,0,0,0,,Сен екеуміздің арамыздағы кепіл мөрі
Dialogue: 0,0:12:03.47,0:12:06.22,Default,,0,0,0,,Бірге істеген күнәлардың азабы.
Dialogue: 0,0:12:07.93,0:12:12.69,Default,,0,0,0,,Қанша дұға етсем де, тілесем де қарғыс үні өшпеді.
Dialogue: 0,0:12:13.39,0:12:16.90,Default,,0,0,0,,Мен ақымақтықпен жабыса берген жоғалған жылуым
Dialogue: 0,0:12:16.98,0:12:18.77,Default,,0,0,0,,Егер сіз оны қайтадан ала алмасаңыз
Dialogue: 0,0:12:19.78,0:12:22.24,Default,,0,0,0,,Тағдырдан қашып құтыла алмасаң...
Dialogue: 0,0:12:24.95,0:12:27.62,Default,,0,0,0,,Шайтанға айнал...
Dialogue: 0,0:12:37.33,0:12:38.71,Default,,0,0,0,,Бұл да Зигтің ісі ме?
Dialogue: 0,0:12:38.79,0:12:39.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:40.80,0:12:43.01,Default,,0,0,0,,Мен сендерге жаңа киімдер дайындап қойдым.
Dialogue: 0,0:12:43.51,0:12:45.09,Default,,0,0,0,,Мен саған киінуге көмектесемін.
Dialogue: 0,0:12:46.72,0:12:50.51,Default,,0,0,0,,Вудвилл мен саған опасыздық жасадым деп ойлайды.
Dialogue: 0,0:12:50.60,0:12:51.64,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:12:52.64,0:12:56.48,Default,,0,0,0,,Уайымдама, Ричард, мен кеше болдым...
Dialogue: 0,0:12:57.69,0:12:59.61,Default,,0,0,0,,Мен оны төсекке апардым.
Dialogue: 0,0:12:59.69,0:13:00.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:01.15,0:13:03.69,Default,,0,0,0,,Енді... Өзендер
Dialogue: 0,0:13:03.78,0:13:07.24,Default,,0,0,0,,Қазірге дейін таққа отыруды армандағаныңызға сенімдімін.
Dialogue: 0,0:13:08.66,0:13:09.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:11.41,0:13:11.91,Default,,0,0,0,,О...
Dialogue: 0,0:13:11.99,0:13:15.29,Default,,0,0,0,,Қайырлы таң, Эрл Риверс мырза.
Dialogue: 0,0:13:15.37,0:13:19.46,Default,,0,0,0,,Кеше мен басқа адамды абайсызда ұстау үшін тым көп ішіп алдым.
Dialogue: 0,0:13:19.54,0:13:21.63,Default,,0,0,0,,Сонымен, жоспарланғандай...
Dialogue: 0,0:13:21.71,0:13:22.51,Default,,0,0,0,,Иә
Dialogue: 0,0:13:23.76,0:13:27.38,Default,,0,0,0,,Қазір мен бұл елдегі ең күшті адаммын
Dialogue: 0,0:13:27.47,0:13:29.64,Default,,0,0,0,,Барлық патшалардан асып түсетін патша бол!
Dialogue: 0,0:13:30.22,0:13:30.89,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:13:30.97,0:13:35.35,Default,,0,0,0,,Бұл Энтони, Өзен графы патшаның атынан бұйрық береді.
Dialogue: 0,0:13:35.43,0:13:37.39,Default,,0,0,0,,Сатқынды ұстаңыз!
Dialogue: 0,0:13:39.06,0:13:41.32,Default,,0,0,0,,Не болды? Мен оны ұстайтын адам емеспін...
Dialogue: 0,0:13:41.40,0:13:42.73,Default,,0,0,0,,Эрл Риверс
Dialogue: 0,0:13:42.82,0:13:44.90,Default,,0,0,0,,Ри... Ричард!
Dialogue: 0,0:13:44.99,0:13:46.78,Default,,0,0,0,,Ия, тоқта! Боқ...
Dialogue: 0,0:13:46.86,0:13:48.99,Default,,0,0,0,,Сен маған опасыздық жасадың, Букингем!
Dialogue: 0,0:13:49.07,0:13:50.95,Default,,0,0,0,,Мен тек әділдік жасадым.
Dialogue: 0,0:13:51.53,0:13:53.54,Default,,0,0,0,,Сіз маған опасыздық жасаған болуыңыз керек.
Dialogue: 0,0:13:54.20,0:13:55.54,Default,,0,0,0,,Кері
Dialogue: 0,0:13:58.46,0:13:59.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:00.92,0:14:03.59,Default,,0,0,0,,Жібер! Неге мен!
Dialogue: 0,0:14:03.67,0:14:04.71,Default,,0,0,0,,Анам рұқсат бермейді!
Dialogue: 0,0:14:04.80,0:14:08.30,Default,,0,0,0,,Сатқын менің сарайыма қамалсын.
Dialogue: 0,0:14:08.80,0:14:12.18,Default,,0,0,0,,Букингем Мен Мәртебелі тақ мұрагерін алып кетейін.
Dialogue: 0,0:14:14.22,0:14:16.06,Default,,0,0,0,,О! Ханзада келді!
Dialogue: 0,0:14:16.14,0:14:19.98,Default,,0,0,0,,Ханзада Эдвард...жоқ, Мәртебелі Король Эдвард V!
Dialogue: 0,0:14:20.06,0:14:23.07,Default,,0,0,0,,Ура! Мәртебелі Патша аман болсын!
Dialogue: 0,0:14:23.15,0:14:26.74,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:26.82,0:14:30.45,Default,,0,0,0,,Ақыры... ақыры, уақыт келді.
Dialogue: 0,0:14:30.53,0:14:35.04,Default,,0,0,0,,Менің... Вудвиллдің қаны Йорк қанын билейді.
Dialogue: 0,0:14:35.12,0:14:39.83,Default,,0,0,0,,Джон мен сіздің қайғылы өліміңізді жарылқаймын және тазартамын.
Dialogue: 0,0:14:40.33,0:14:42.13,Default,,0,0,0,,Күнәкар Ричард
Dialogue: 0,0:14:42.21,0:14:45.38,Default,,0,0,0,,Сіз Лондонға енді ешқашан аяқ баспайсыз.
Dialogue: 0,0:14:45.88,0:14:48.84,Default,,0,0,0,,Фестивальді қызыл қанмен боя.
Dialogue: 0,0:14:50.09,0:14:51.09,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:14:51.18,0:14:54.43,Default,,0,0,0,,Ал менің қымбатты ағам...
Dialogue: 0,0:14:54.51,0:14:55.76,Default,,0,0,0,,Анашым!
Dialogue: 0,0:14:57.31,0:14:58.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:00.73,0:15:03.15,Default,,0,0,0,,Мен жаңа ғана оралдым.
Dialogue: 0,0:15:04.11,0:15:05.86,Default,,0,0,0,,Құрметті жеңге
Dialogue: 0,0:15:05.94,0:15:07.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:11.36,0:15:12.53,Default,,0,0,0,,Ричард…
Dialogue: 0,0:15:13.32,0:15:15.87,Default,,0,0,0,,Менің ағам мен Грей қайда?
Dialogue: 0,0:15:15.95,0:15:17.62,Default,,0,0,0,,Құрметті Элизабет
Dialogue: 0,0:15:17.70,0:15:20.33,Default,,0,0,0,,Менде бұған қатысты өкінішті хабар бар...
Dialogue: 0,0:15:20.41,0:15:23.63,Default,,0,0,0,,Ах! Мен Лондонға тезірек келгім келді
Dialogue: 0,0:15:23.71,0:15:26.05,Default,,0,0,0,,Риверс және басқалары біртүрлі көңіл-күйге түсіп, қамауға алынды.
Dialogue: 0,0:15:26.13,0:15:27.76,Default,,0,0,0,,Не...?
Dialogue: 0,0:15:27.84,0:15:31.13,Default,,0,0,0,,Еріндері балдай тәтті.
Dialogue: 0,0:15:31.22,0:15:34.22,Default,,0,0,0,,Жүрегінің тереңінде уды жасырды.
Dialogue: 0,0:15:34.89,0:15:38.43,Default,,0,0,0,,Олар мені жазықсыз қылмыс жасады деп айыптауды жоспарлады.
Dialogue: 0,0:15:38.52,0:15:40.10,Default,,0,0,0,,Мүмкін емес! Бұл ақымақтық!
Dialogue: 0,0:15:40.18,0:15:42.27,Default,,0,0,0,,Көтеріліс ұйымдастырған осы!
Dialogue: 0,0:15:42.35,0:15:44.94,Default,,0,0,0,,Күзетшілер, Глостер қамауға алынсын!
Dialogue: 0,0:15:46.40,0:15:48.28,Default,,0,0,0,,Қарғыс атсын... түкке тұрғысызсың!
Dialogue: 0,0:15:48.36,0:15:50.24,Default,,0,0,0,,Дорсет жынданып кетті!
Dialogue: 0,0:15:50.32,0:15:51.28,Default,,0,0,0,,Ұлы Мәртебелін қорғаңыз!
Dialogue: 0,0:15:51.36,0:15:53.53,Default,,0,0,0,,Не? Кешіріңіз...
Dialogue: 0,0:15:54.03,0:15:55.70,Default,,0,0,0,,Күте тұрыңыз! Оны жіберіп алмаңыз!
Dialogue: 0,0:15:55.78,0:15:57.03,Default,,0,0,0,,Дорсет…
Dialogue: 0,0:15:57.79,0:15:59.54,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:15:59.62,0:16:01.87,Default,,0,0,0,,Анаңды тастап қашып кету деген не?
Dialogue: 0,0:16:01.96,0:16:04.17,Default,,0,0,0,,Енді амансыз, Мәртебелі.
Dialogue: 0,0:16:05.29,0:16:10.46,Default,,0,0,0,,Мен осы елдің тыныштығын бұзатын қарақшылардың әрқайсысын жойамын.
Dialogue: 0,0:16:11.09,0:16:12.93,Default,,0,0,0,,Патша сарайына барайық
Dialogue: 0,0:16:15.05,0:16:17.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:17.64,0:16:20.77,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:16:22.81,0:16:26.69,Default,,0,0,0,,Енді патша сарайында сенің жауларың жоқ.
Dialogue: 0,0:16:26.77,0:16:31.24,Default,,0,0,0,,Элизабет... саған әлі сене ме?
Dialogue: 0,0:16:31.74,0:16:34.82,Default,,0,0,0,,Адамдарды сендірудің көптеген жолдары бар.
Dialogue: 0,0:16:35.36,0:16:38.16,Default,,0,0,0,,Тіпті мені Патшашы деп атады.
Dialogue: 0,0:16:39.62,0:16:41.54,Default,,0,0,0,,Не, қызғандың ба?
Dialogue: 0,0:16:42.04,0:16:44.92,Default,,0,0,0,,Сен менің патшамсың
Dialogue: 0,0:16:45.83,0:16:50.21,Default,,0,0,0,,Элизабет әлі қол жетімді, сондықтан сіз біз жақта екеніңізді көрсетіңіз.
Dialogue: 0,0:16:50.84,0:16:53.09,Default,,0,0,0,,Әрине, менің патшам.
Dialogue: 0,0:16:53.72,0:16:54.55,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:16:54.63,0:16:56.76,Default,,0,0,0,,Мәртебелі Патша шақырып жатыр.
Dialogue: 0,0:16:57.43,0:16:58.43,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:04.31,0:17:06.35,Default,,0,0,0,,Бақылау - жақсы хобби.
Dialogue: 0,0:17:06.44,0:17:08.40,Default,,0,0,0,,Келесі жолы мен сізге соңына дейін көрсетемін
Dialogue: 0,0:17:09.06,0:17:11.32,Default,,0,0,0,,Ричардты ренжіткен кез келген адам
Dialogue: 0,0:17:11.82,0:17:14.70,Default,,0,0,0,,Мен саған ешкімге аямаймын дедім.
Dialogue: 0,0:17:15.32,0:17:17.03,Default,,0,0,0,,Бірақ егер сіз мұны қаласаңыз...
Dialogue: 0,0:17:17.53,0:17:20.41,Default,,0,0,0,,Өзіңізге зиян келтіргіңіз келсе де...
Dialogue: 0,0:17:20.49,0:17:22.95,Default,,0,0,0,,Мен шайтанның жартысы болдым.
Dialogue: 0,0:17:23.45,0:17:26.08,Default,,0,0,0,,Ричардтың тілегін орындау үшін
Dialogue: 0,0:17:26.58,0:17:27.92,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:17:28.00,0:17:31.17,Default,,0,0,0,,Қолды Құдайдың қанымен ластау
Dialogue: 0,0:17:31.25,0:17:32.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:34.09,0:17:36.30,Default,,0,0,0,,Сюжеттің бәрі ашылды.
Dialogue: 0,0:17:36.93,0:17:38.97,Default,,0,0,0,,Сіз ұйымдастырушы екенсіз.
Dialogue: 0,0:17:40.43,0:17:44.81,Default,,0,0,0,,Ричардқа ақша бергеніңіз қате емес пе?
Dialogue: 0,0:17:44.89,0:17:48.35,Default,,0,0,0,,Әлде сіз онымен басынан бастап жұмыс істедіңіз бе?
Dialogue: 0,0:17:48.44,0:17:50.06,Default,,0,0,0,,А...
Dialogue: 0,0:17:50.15,0:17:53.73,Default,,0,0,0,,Дәлел бар. Әлде мен куәгерді айтуым керек пе?
Dialogue: 0,0:17:53.82,0:17:55.57,Default,,0,0,0,,(Өсімдіктердің қозғалу дыбысы)
Dialogue: 0,0:17:56.49,0:17:57.28,Default,,0,0,0,,Ана…
Dialogue: 0,0:17:57.36,0:17:58.32,Default,,0,0,0,,Бет?
Dialogue: 0,0:17:59.78,0:18:03.74,Default,,0,0,0,,Мен Букингемнен Ричардқа көмектесуін өтіндім.
Dialogue: 0,0:18:03.83,0:18:04.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:05.04,0:18:09.29,Default,,0,0,0,,Сенің анаңның арқасында мен Ричардты енді ешқашан күлімсіреп көре алмаймын.
Dialogue: 0,0:18:09.37,0:18:12.71,Default,,0,0,0,,Энтони ағай мен оның достарының тұтқынға түскені табиғи нәрсе!
Dialogue: 0,0:18:12.80,0:18:16.05,Default,,0,0,0,,Сонда да анаңды кешірген Букингемге.
Dialogue: 0,0:18:16.13,0:18:17.51,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:18.22,0:18:21.43,Default,,0,0,0,,Бұл ақылды қыз менің ең үлкен қазынам.
Dialogue: 0,0:18:21.51,0:18:26.52,Default,,0,0,0,,Қоғамдық саясатқа араласпаңыз және қасиетті ғибадатханаға бармаңыз.
Dialogue: 0,0:18:26.60,0:18:30.90,Default,,0,0,0,,Осылайша, Ричард ең нашар таңдау жасаудың қажеті болмайды.
Dialogue: 0,0:18:32.94,0:18:35.98,Default,,0,0,0,,Менің таңдауым жоқ сияқты.
Dialogue: 0,0:18:36.65,0:18:37.74,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:18:37.82,0:18:39.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:40.28,0:18:43.24,Default,,0,0,0,,Оның орнына мен де інім ханзаданы аламын.
Dialogue: 0,0:18:43.74,0:18:46.66,Default,,0,0,0,,Олай болмаса, мен өзімді осында және қазір өлтіремін.
Dialogue: 0,0:18:47.54,0:18:50.29,Default,,0,0,0,,Менің әлі өлгенімді қаламайсың ғой, солай ма?
Dialogue: 0,0:18:51.88,0:18:53.13,Default,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:18:54.88,0:18:56.21,Default,,0,0,0,,Мәртебелі Патшайым Ана
Dialogue: 0,0:18:59.22,0:19:02.14,Default,,0,0,0,,Бүгін кешке шақырғаныңызға рахмет.
Dialogue: 0,0:19:02.22,0:19:04.10,Default,,0,0,0,,Біздің жауымыз кетті!
Dialogue: 0,0:19:04.60,0:19:06.43,Default,,0,0,0,,О, біздің патшамыз
Dialogue: 0,0:19:06.93,0:19:08.02,Default,,0,0,0,,Патшаға
Dialogue: 0,0:19:09.81,0:19:11.48,Default,,0,0,0,,Ах... хаха
Dialogue: 0,0:19:11.56,0:19:13.69,Default,,0,0,0,,Мен сусындар жақсы болатын түнді өткізгеніме біраз болды.
Dialogue: 0,0:19:14.27,0:19:15.57,Default,,0,0,0,,Лорд Хастингс
Dialogue: 0,0:19:16.07,0:19:18.90,Default,,0,0,0,,Мені ескерткеніңіз үшін рахмет.
Dialogue: 0,0:19:18.99,0:19:22.57,Default,,0,0,0,,Біз талай шайқастарды бірге өткізген достармыз!
Dialogue: 0,0:19:22.66,0:19:23.74,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:24.32,0:19:26.03,Default,,0,0,0,,Бірақ біз сақтықты әлі түсіре алмаймыз.
Dialogue: 0,0:19:26.54,0:19:28.95,Default,,0,0,0,,Ол әйел патшаның анасы болғанша
Dialogue: 0,0:19:31.21,0:19:33.13,Default,,0,0,0,,Енді бақылаушы жіберейік.
Dialogue: 0,0:19:33.21,0:19:36.59,Default,,0,0,0,,Сонда бізде дұрыс адам табылды, Джейн!
Dialogue: 0,0:19:36.67,0:19:38.34,Default,,0,0,0,,Сенің сиқыршың ба?
Dialogue: 0,0:19:38.84,0:19:40.59,Default,,0,0,0,,Ал... енді солай деп ойлаймын.
Dialogue: 0,0:19:40.67,0:19:45.14,Default,,0,0,0,,Бақсымен араласу адам баласының ақылына сыймайтын ләззат сияқты.
Dialogue: 0,0:19:45.22,0:19:47.06,Default,,0,0,0,,Сүйегіңе жетеді
Dialogue: 0,0:19:47.64,0:19:49.73,Default,,0,0,0,,Жоқ... мен және ол
Dialogue: 0,0:19:49.81,0:19:52.31,Default,,0,0,0,,Бізді жай ғана махаббат байланыстырады.
Dialogue: 0,0:19:52.98,0:19:56.48,Default,,0,0,0,,Кіреберістің керемет әсерлі болғаны рас, бірақ...
Dialogue: 0,0:19:57.11,0:20:02.20,Default,,0,0,0,,Өйткені, қатты бүршіктерді қопсытудың бірінші қадамы ынталандыру болып табылады.
Dialogue: 0,0:20:05.12,0:20:07.53,Default,,0,0,0,,Хастингстің қолдауы берік.
Dialogue: 0,0:20:08.04,0:20:11.75,Default,,0,0,0,,Жоқ, ол Эдвардты қолдайды.
Dialogue: 0,0:20:13.79,0:20:15.25,Default,,0,0,0,,Неге ашуланасың?
Dialogue: 0,0:20:15.75,0:20:17.75,Default,,0,0,0,,Маған неге олай қарадың?
Dialogue: 0,0:20:17.84,0:20:20.26,Default,,0,0,0,,Бұл көздер? Сенің көзің қандай?
Dialogue: 0,0:20:20.76,0:20:22.47,Default,,0,0,0,,Мен бұл күн тек бір рет болады деп ешқашан күтпедім.
Dialogue: 0,0:20:23.05,0:20:26.18,Default,,0,0,0,,Менің жанымды сатып аламын деп ойлама.
Dialogue: 0,0:20:27.22,0:20:28.47,Default,,0,0,0,,Киіміңді өзің шеш
Dialogue: 0,0:20:31.48,0:20:34.98,Default,,0,0,0,,Құрметті Ричард, сол көзіңізге не болды?
Dialogue: 0,0:20:35.06,0:20:37.23,Default,,0,0,0,,Қызметші балалар
Dialogue: 0,0:20:37.31,0:20:38.82,Default,,0,0,0,,Менің көзім біртүрлі дейді
Dialogue: 0,0:20:39.73,0:20:41.40,Default,,0,0,0,,Тіпті менің анам әрқашан...
Dialogue: 0,0:20:42.57,0:20:45.11,Default,,0,0,0,,Мен неге басқаша болуым керек?
Dialogue: 0,0:20:45.86,0:20:48.37,Default,,0,0,0,,Менің қалағаным махаббат емес
Dialogue: 0,0:20:48.87,0:20:51.12,Default,,0,0,0,,Талап етілетін нәрсе - кепіл
Dialogue: 0,0:20:51.62,0:20:56.25,Default,,0,0,0,,Енді маған қалағаныңызша ауыртпалық түсіріңіз.
Dialogue: 0,0:20:56.75,0:20:58.75,Default,,0,0,0,,Келісім-шарттың жарасы жазылмай тұрып
Dialogue: 0,0:20:59.54,0:21:02.26,Default,,0,0,0,,Менің тері түсім де басқаларға ұқсамайды.
Dialogue: 0,0:21:02.76,0:21:03.63,Default,,0,0,0,,Біртүрлі ма?
Dialogue: 0,0:21:04.13,0:21:06.01,Default,,0,0,0,,Жоқ, бұл таңқаларлық емес.
Dialogue: 0,0:21:06.09,0:21:09.43,Default,,0,0,0,,Ричардта да таңқаларлық ештеңе жоқ.
Dialogue: 0,0:21:10.60,0:21:12.81,Default,,0,0,0,,Сіз әлі түсінбейсіз.
Dialogue: 0,0:21:13.31,0:21:15.77,Default,,0,0,0,,Тек тез кететін ауырсыну
Dialogue: 0,0:21:16.40,0:21:20.57,Default,,0,0,0,,Айттым ғой, өзің де білмейтініңді ұсын.
Dialogue: 0,0:21:21.07,0:21:25.07,Default,,0,0,0,,Тыңдашы, Ричард, мен ойып жазатын нәрсе...
Dialogue: 0,0:21:25.70,0:21:27.28,Default,,0,0,0,,Оны шашыңызбен жасырыңыз
Dialogue: 0,0:21:27.99,0:21:31.91,Default,,0,0,0,,Жасырсаң, мұңды сезім өшеді.
Dialogue: 0,0:21:33.54,0:21:35.87,Default,,0,0,0,,Тәтті ауырсыну
Dialogue: 0,0:21:37.87,0:21:39.50,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:21:40.34,0:21:41.96,Default,,0,0,0,,Мен не істей аламын...
Dialogue: 0,0:21:42.05,0:21:44.67,Default,,0,0,0,,Иә... бұл жақсы.
Dialogue: 0,0:21:45.26,0:21:46.05,Default,,0,0,0,,Ричард
Dialogue: 0,0:21:46.55,0:21:49.72,Default,,0,0,0,,Мен сен туралы шындықты білетін жалғыз адаммын.
Dialogue: 0,0:21:50.89,0:21:53.27,Default,,0,0,0,,Тіпті ләззат азапқа айналады
Dialogue: 0,0:21:53.81,0:21:58.35,Default,,0,0,0,,Махаббатқа ұқсас етіп жасалған бұл рәсіммен мен өлтірілемін ... және қайта туамын.
Dialogue: 0,0:21:58.85,0:22:00.86,Default,,0,0,0,,♪～
Dialogue: 0,0:22:02.90,0:22:05.44,Default,,0,0,0,,Барлығың мұқият тыңдаңдар.
Dialogue: 0,0:22:05.53,0:22:08.03,Default,,0,0,0,,Генри VI, әлсіз және ақылсыз король
Dialogue: 0,0:22:08.11,0:22:09.74,Default,,0,0,0,,Ағамның көмегінсіз
Dialogue: 0,0:22:09.82,0:22:12.49,Default,,0,0,0,,Бұл елді басқару мүмкін емес еді.
Dialogue: 0,0:22:12.58,0:22:16.20,Default,,0,0,0,,Мен қабілетсіз емеспін, бірақ бұл ереже.
Dialogue: 0,0:22:16.29,0:22:18.71,Default,,0,0,0,,Иә, ол жігіт
Dialogue: 0,0:22:19.21,0:22:23.13,Default,,0,0,0,,Ересек болса да оған регент керек еді.
Dialogue: 0,0:22:23.21,0:22:24.67,Default,,0,0,0,,Ол кездегіден басқаша.
Dialogue: 0,0:22:24.76,0:22:27.26,Default,,0,0,0,,Олай болса, мырзалар, менің қарсылығым жоқ.
Dialogue: 0,0:22:27.34,0:22:30.47,Default,,0,0,0,,Енді Өзендер кеткен соң, бізде таңдау жоқ деп ойлаймын.
Dialogue: 0,0:22:30.55,0:22:33.72,Default,,0,0,0,,Бұл патша сарайында бұған қарсы шыққан адамға орын жоқ.
Dialogue: 0,0:22:34.31,0:22:36.52,Default,,0,0,0,,Ричард, Глостер герцогы
Dialogue: 0,0:22:36.60,0:22:39.02,Default,,0,0,0,,Мен сізді регент етіп тағайындаймын.
Dialogue: 0,0:22:39.52,0:22:41.69,Default,,0,0,0,,Біз сіздің өтінішіңізді құрметпен қабылдаймыз.
Dialogue: 0,0:22:47.82,0:22:50.95,Default,,0,0,0,,Сол кезде әкем ұстағалы тұрған жарық...
Dialogue: 0,0:22:51.91,0:22:53.99,Default,,0,0,0,,Бұл өткінші жарық
Dialogue: 0,0:22:54.99,0:22:56.45,Default,,0,0,0,,Сол кезде біз
Dialogue: 0,0:22:56.95,0:23:00.37,Default,,0,0,0,,Болашақты ғана армандаған дәрменсіз бала едім.
Dialogue: 0,0:23:01.42,0:23:05.34,Default,,0,0,0,,Тәж екеуміздің арамызда көп адам болды.
Dialogue: 0,0:23:07.09,0:23:08.80,Default,,0,0,0,,Бірақ қазір сол жерде тұрмын
Dialogue: 0,0:23:08.88,0:23:10.76,Default,,0,0,0,,Тек екі ханзада
Dialogue: 0,0:23:11.43,0:23:13.47,Default,,0,0,0,,Енді раушан гүлін алыңыз!
Dialogue: 0,0:23:14.22,0:23:16.68,Default,,0,0,0,,Қол болса да
Dialogue: 0,0:23:16.77,0:23:18.68,Default,,0,0,0,,Қанға бояса да
Dialogue: 0,0:23:28.90,0:23:30.90,Default,,0,0,0,,～♪
