Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.13,0:00:12.97,Default,,0,0,0,,Эй, бұл Букингем герцогы...
Dialogue: 0,0:00:13.55,0:00:14.76,Default,,0,0,0,,Бұл... Мәртебелі.
Dialogue: 0,0:00:17.14,0:00:19.60,Default,,0,0,0,,Әрбір бөлме патшаға тиесілі.
Dialogue: 0,0:00:19.68,0:00:21.39,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:00:21.89,0:00:25.27,Default,,0,0,0,,Букингем герцогы қазір қала сыртында.
Dialogue: 0,0:00:25.90,0:00:27.69,Default,,0,0,0,,Мен таңға дейін қайтпаймын
Dialogue: 0,0:00:29.57,0:00:31.82,Default,,0,0,0,,Біраз уақыт айналаға қараңыз.
Dialogue: 0,0:00:31.90,0:00:32.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:34.82,0:00:37.53,Default,,0,0,0,,Таңертеңге дейін...?
Dialogue: 0,0:00:39.20,0:00:41.70,Default,,0,0,0,,Бұл таңқаларлық емес.
Dialogue: 0,0:00:41.79,0:00:47.75,Default,,0,0,0,,Әрине, менімен түнейтін болсаңыз, мен болмағаныңыз жақсы.
Dialogue: 0,0:00:49.13,0:00:51.80,Default,,0,0,0,,Сіз мұның бәрін алуыңыз керек еді.
Dialogue: 0,0:00:52.30,0:00:53.63,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:00:55.97,0:00:59.76,Default,,0,0,0,,Алтын ұйқы неге келмейді?
Dialogue: 0,0:01:00.72,0:01:04.35,Default,,0,0,0,,Мен жылуды қалаймын, бұл жану ...
Dialogue: 0,0:01:05.60,0:01:07.81,Default,,0,0,0,,Сен сол қолыңмен кімді ұстап тұрсың?
Dialogue: 0,0:01:09.02,0:01:13.78,Default,,0,0,0,,Бұл денені сенен басқа ұстайтын ешкім жоқ.
Dialogue: 0,0:01:16.11,0:01:17.41,Default,,0,0,0,,Букингем…
Dialogue: 0,0:01:17.99,0:01:19.99,Default,,0,0,0,,Ричард... Мұнда не істеп жүрсің?
Dialogue: 0,0:01:22.04,0:01:22.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:28.25,0:01:29.42,Default,,0,0,0,,Бөлмеге оралу
Dialogue: 0,0:01:33.46,0:01:36.59,Default,,0,0,0,,Бөлмеңізге тез оралыңыз.
Dialogue: 0,0:01:37.22,0:01:39.39,Default,,0,0,0,,Мен қайтып барсам... дейді
Dialogue: 0,0:01:39.47,0:01:41.35,Default,,0,0,0,,Сіз патшасыз
Dialogue: 0,0:01:43.10,0:01:43.97,Default,,0,0,0,,Неге...
Dialogue: 0,0:01:44.89,0:01:48.85,Default,,0,0,0,,Букингем Неге сонша дымқылсың?
Dialogue: 0,0:01:50.90,0:01:52.48,Default,,0,0,0,,Осы жолмен! Тез кел!
Dialogue: 0,0:02:04.58,0:02:06.58,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:02:06.66,0:02:08.75,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:02:09.25,0:02:15.21,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:02:15.71,0:02:20.51,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:02:24.51,0:02:26.52,Default,,0,0,0,,♪～
Dialogue: 0,0:03:50.85,0:03:52.85,Default,,0,0,0,,～♪
Dialogue: 0,0:03:55.52,0:03:56.81,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:03:56.90,0:03:59.03,Default,,0,0,0,,Бұл театрда ойнаған әртістер.
Dialogue: 0,0:03:59.11,0:04:02.03,Default,,0,0,0,,Патшаны мазақ еткендер.
Dialogue: 0,0:04:02.11,0:04:03.53,Default,,0,0,0,,Бұл жай ғана шоу үшін бе?
Dialogue: 0,0:04:03.61,0:04:07.49,Default,,0,0,0,,Сол кезде мен ұлы мәртебелі өзінің көмекшілеріне бірдеңе бұйырғанын көрдім.
Dialogue: 0,0:04:07.58,0:04:09.83,Default,,0,0,0,,Жау сен білмей тұрып өлікке айналады.
Dialogue: 0,0:04:09.91,0:04:11.75,Default,,0,0,0,,Бұл шайтанның әдеттегі тактикасы.
Dialogue: 0,0:04:16.33,0:04:19.17,Default,,0,0,0,,Енді не істеуіміз керек? Мәртебелі Король
Dialogue: 0,0:04:19.67,0:04:23.01,Default,,0,0,0,,Келесі банкетте жұмақты қандай әдемі жасасақ та,
Dialogue: 0,0:04:23.09,0:04:25.51,Default,,0,0,0,,Қанша әулие боп жүрсең де
Dialogue: 0,0:04:25.59,0:04:30.60,Default,,0,0,0,,Бейшара шейіттердің өлімі бәріне көлеңке түсіреді.
Dialogue: 0,0:04:32.48,0:04:35.73,Default,,0,0,0,,Пьесаның жалғасын асыға күтемін.
Dialogue: 0,0:04:39.07,0:04:41.65,Default,,0,0,0,,Неліктен екі адам...
Dialogue: 0,0:04:42.99,0:04:46.45,Default,,0,0,0,,Мен жай ғана досыммен уақыт өткіздім.
Dialogue: 0,0:04:47.70,0:04:48.95,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:49.62,0:04:53.66,Default,,0,0,0,,Мәртебелі Король мені патшайымның қасында болуымды өтінді.
Dialogue: 0,0:04:54.54,0:04:56.62,Default,,0,0,0,,Өткен түндегі оқиғаға байланысты,
Dialogue: 0,0:04:58.08,0:04:59.54,Default,,0,0,0,,Ричард
Dialogue: 0,0:04:59.63,0:05:02.80,Default,,0,0,0,,Маған аз да болса көңіл бөлесің.
Dialogue: 0,0:05:02.88,0:05:08.01,Default,,0,0,0,,Мәртебелі патшайым туралы әрқашан алаңдаушылық білдірді.
Dialogue: 0,0:05:10.14,0:05:14.27,Default,,0,0,0,,Онда неге түнгі міндеттеріңді орындай алмадың?
Dialogue: 0,0:05:15.89,0:05:19.94,Default,,0,0,0,,Махаббат болмаса да, Эдвард екеуміз бір-біріміздің алдындағы міндеттерімізді орындадық.
Dialogue: 0,0:05:20.61,0:05:22.48,Default,,0,0,0,,Біз үшін болашақта...
Dialogue: 0,0:05:23.19,0:05:25.45,Default,,0,0,0,,Сіз оны басқалардан жақсы білесіз
Dialogue: 0,0:05:26.20,0:05:28.70,Default,,0,0,0,,Егер сіз жасырып жүрген бірдеңе болса, айтыңызшы.
Dialogue: 0,0:05:34.29,0:05:38.54,Default,,0,0,0,,Сол кезде Ричард өзін қорғайын дегендей секіріп кетті.
Dialogue: 0,0:05:39.04,0:05:40.92,Default,,0,0,0,,Сол себепті айттым.
Dialogue: 0,0:05:41.00,0:05:44.01,Default,,0,0,0,,Ричард сені ешқашан сүймейді
Dialogue: 0,0:05:44.51,0:05:48.55,Default,,0,0,0,,Өйткені Ричард әйел.
Dialogue: 0,0:05:49.05,0:05:50.26,Default,,0,0,0,,Екінші бомба!
Dialogue: 0,0:05:50.97,0:05:54.02,Default,,0,0,0,,Әкем анаммен қалуымды өтінді.
Dialogue: 0,0:05:56.14,0:05:57.52,Default,,0,0,0,,Эдвард…
Dialogue: 0,0:05:58.02,0:05:59.65,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:06:00.86,0:06:02.23,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:06:02.98,0:06:05.28,Default,,0,0,0,,Мүмкін емес... мүлде
Dialogue: 0,0:06:06.28,0:06:09.99,Default,,0,0,0,,Мәртебелі мырза, мен ұсақ-түйек туралы бос сөзге мән бермеймін.
Dialogue: 0,0:06:10.07,0:06:11.74,Default,,0,0,0,,Көбінесе марапаттар туралы.
Dialogue: 0,0:06:11.82,0:06:13.49,Default,,0,0,0,,Ажырасу немесе бірдеңе болуы мүмкін.
Dialogue: 0,0:06:13.99,0:06:16.95,Default,,0,0,0,,Біріншіден, оларды өлтірудің қажеті жоқ.
Dialogue: 0,0:06:18.16,0:06:21.42,Default,,0,0,0,,Ол кісі мәйіттердің арасында болмаған.
Dialogue: 0,0:06:22.00,0:06:23.46,Default,,0,0,0,,Сіз тым көп ойлайсыз ба?
Dialogue: 0,0:06:24.21,0:06:28.38,Default,,0,0,0,,Қандай да бір маңыздылық бар болса, ол дәл осы қазіргі жағдайда.
Dialogue: 0,0:06:28.93,0:06:33.26,Default,,0,0,0,,Бұл мәртебелі мәртебеге кінә артудың тамаша мүмкіндігі.
Dialogue: 0,0:06:34.10,0:06:37.23,Default,,0,0,0,,Сіз кеше түннен бері көзілдірікті тақпадыңыз.
Dialogue: 0,0:06:39.06,0:06:40.39,Default,,0,0,0,,Абайсызда...
Dialogue: 0,0:06:40.48,0:06:42.19,Default,,0,0,0,,Бірден жасайық
Dialogue: 0,0:06:42.77,0:06:44.23,Default,,0,0,0,,Жоқ, Мәртебелі.
Dialogue: 0,0:06:44.90,0:06:47.90,Default,,0,0,0,,Қазір жарқын көрінбеген дұрыс.
Dialogue: 0,0:06:49.40,0:06:50.61,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:55.12,0:06:56.16,Default,,0,0,0,,Бәрі жақсы ма?
Dialogue: 0,0:06:56.66,0:06:59.62,Default,,0,0,0,,Банкетті жоспарланғандай өткізуде ешқандай өзгеріс жоқ.
Dialogue: 0,0:07:00.21,0:07:04.59,Default,,0,0,0,,Бірақ алдымен шақырылған адамға осы хатты мүмкіндігінше тезірек жіберіңіз.
Dialogue: 0,0:07:04.67,0:07:09.30,Default,,0,0,0,,Ричардтың жұмағында тұратындарға, оларға бір ауыз сөз қалдырмай.
Dialogue: 0,0:07:09.80,0:07:11.68,Default,,0,0,0,,Дворяндар мен қызметшілер
Dialogue: 0,0:07:11.76,0:07:13.72,Default,,0,0,0,,Сарбаздар мен діни қызметкерлер
Dialogue: 0,0:07:14.72,0:07:17.10,Default,,0,0,0,,Әрине ол кісі де.
Dialogue: 0,0:07:18.10,0:07:20.23,Default,,0,0,0,,«Құрметті актер»
Dialogue: 0,0:07:20.73,0:07:24.81,Default,,0,0,0,,«Бүгін түнде сен басқа адам болып, менің жұмағыма келдің».
Dialogue: 0,0:07:25.57,0:07:28.94,Default,,0,0,0,,«Люцифердің құлағанынан» кейін «Адам мен Хауа».
Dialogue: 0,0:07:29.53,0:07:31.74,Default,,0,0,0,,Бұл фестиваль пьесаларының негізгі бөлігі ме?
Dialogue: 0,0:07:32.32,0:07:35.70,Default,,0,0,0,,Сау болыңыз, Мәртебелі, граф Ричмонд.
Dialogue: 0,0:07:36.66,0:07:38.49,Default,,0,0,0,,Ланкастриялық Ричмонд
Dialogue: 0,0:07:38.58,0:07:40.96,Default,,0,0,0,,Жеңілген және қашуда
Dialogue: 0,0:07:41.46,0:07:44.17,Default,,0,0,0,,Мен жай ғана саяхатшымын
Dialogue: 0,0:07:44.25,0:07:47.30,Default,,0,0,0,,Бірақ Ланкастерді қалпына келтіру
Dialogue: 0,0:07:47.38,0:07:49.51,Default,,0,0,0,,Мәртебелі иығына тіреледі.
Dialogue: 0,0:07:50.01,0:07:54.14,Default,,0,0,0,,Өтінемін, ешнәрсе жасамаңыз...
Dialogue: 0,0:07:54.22,0:07:59.35,Default,,0,0,0,,Мен өлсем, бұл Құдайдың шақыруы...
Dialogue: 0,0:08:00.35,0:08:02.73,Default,,0,0,0,,Менің тағдырым шешілді
Dialogue: 0,0:08:03.94,0:08:07.32,Default,,0,0,0,,Құдай мені сайлайды
Dialogue: 0,0:08:08.65,0:08:11.32,Default,,0,0,0,,Сонда да мен білмеймін.
Dialogue: 0,0:08:11.40,0:08:13.24,Default,,0,0,0,,«Өзге бол»?
Dialogue: 0,0:08:13.86,0:08:19.20,Default,,0,0,0,,Жын ретінде мен жаратушы патшаға ыңғайсыздықпын.
Dialogue: 0,0:08:19.29,0:08:22.08,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:08:22.58,0:08:26.13,Default,,0,0,0,,Тойға шайтан осылай келсе
Dialogue: 0,0:08:26.21,0:08:30.84,Default,,0,0,0,,Адам ата мен Хауа ананың әсем жұмағы қирады.
Dialogue: 0,0:08:31.38,0:08:32.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:32.09,0:08:35.18,Default,,0,0,0,,(Халықтың күлкісі)
Dialogue: 0,0:08:36.76,0:08:39.68,Default,,0,0,0,,Ібілістің жұмағына қош келдіңіздер
Dialogue: 0,0:08:40.18,0:08:40.89,Default,,0,0,0,,Ібіліс?
Dialogue: 0,0:08:42.52,0:08:46.15,Default,,0,0,0,,Басқаша бол... Ешқандай ереже жоқ.
Dialogue: 0,0:08:46.65,0:08:48.98,Default,,0,0,0,,Сіз қаласаңыз, кез келген адам бола аласыз.
Dialogue: 0,0:08:50.52,0:08:52.57,Default,,0,0,0,,Бұл сенің жұмағың
Dialogue: 0,0:08:53.44,0:08:57.28,Default,,0,0,0,,Кәне, бәріміз билейміз. Қалағаныңызша билей аласыз.
Dialogue: 0,0:08:57.37,0:09:00.16,Default,,0,0,0,,Мен мұндай көңілді кеш өткізген емеспін.
Dialogue: 0,0:09:00.24,0:09:03.04,Default,,0,0,0,,Менің бала күнгі арманым орындалды
Dialogue: 0,0:09:03.12,0:09:05.33,Default,,0,0,0,,Жаңа патшаға тост айтайық
Dialogue: 0,0:09:05.41,0:09:08.17,Default,,0,0,0,,Мәртебелі Король III Ричардқа!
Dialogue: 0,0:09:08.25,0:09:10.67,Default,,0,0,0,,Патшамызға сәлем!
Dialogue: 0,0:09:10.75,0:09:14.88,Default,,0,0,0,,Ричард… Ричард III…
Dialogue: 0,0:09:16.26,0:09:17.59,Default,,0,0,0,,Ұнады!
Dialogue: 0,0:09:18.22,0:09:18.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:18.80,0:09:20.89,Default,,0,0,0,,Керемет жұмақ!
Dialogue: 0,0:09:21.97,0:09:24.02,Default,,0,0,0,,Бұл керемет, Ричард.
Dialogue: 0,0:09:24.52,0:09:27.35,Default,,0,0,0,,Әйтпесе, ұрлаудың қажеті жоқ.
Dialogue: 0,0:09:28.35,0:09:29.44,Default,,0,0,0,,Ричард
Dialogue: 0,0:09:30.19,0:09:32.90,Default,,0,0,0,,Біз Адам ата мен Хауа анамыз ба?
Dialogue: 0,0:09:32.98,0:09:34.28,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:09:34.78,0:09:36.95,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:09:37.45,0:09:38.86,Default,,0,0,0,,Сіз не сұрағыңыз келеді? кел
Dialogue: 0,0:09:39.91,0:09:42.41,Default,,0,0,0,,Менен бірдеңе жасырып тұрсың ба?
Dialogue: 0,0:09:43.16,0:09:44.41,Default,,0,0,0,,Айтыңызшы, Ричард.
Dialogue: 0,0:09:44.91,0:09:48.79,Default,,0,0,0,,Сен екеуміз неге ерекшеленбейміз?
Dialogue: 0,0:09:49.83,0:09:53.63,Default,,0,0,0,,Егер сізде басқа костюмдер болса, маған хабарлаңыз.
Dialogue: 0,0:09:54.63,0:09:58.05,Default,,0,0,0,,Тек біз патша мен патшайым болып қала береміз...
Dialogue: 0,0:09:59.26,0:10:01.43,Default,,0,0,0,,Кешіріңіз, бірақ мен ештеңе дайындаған жоқпын.
Dialogue: 0,0:10:01.51,0:10:03.06,Default,,0,0,0,,Бұл жақсы болар еді
Dialogue: 0,0:10:03.56,0:10:05.73,Default,,0,0,0,,Негізі мен оны осында дайындадым.
Dialogue: 0,0:10:06.23,0:10:07.52,Default,,0,0,0,,Біздің бетперде
Dialogue: 0,0:10:08.10,0:10:09.02,Default,,0,0,0,,Бетперделеу?
Dialogue: 0,0:10:09.10,0:10:11.48,Default,,0,0,0,,Қарапайым киімнен еш айырмашылығы жоқ, бірақ
Dialogue: 0,0:10:12.40,0:10:13.32,Default,,0,0,0,,Ол емес.
Dialogue: 0,0:10:14.07,0:10:15.90,Default,,0,0,0,,Бұл сіздің кигеніңіз
Dialogue: 0,0:10:15.99,0:10:16.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:17.11,0:10:18.86,Default,,0,0,0,,Патша мен патшайым қарама-қарсы орналасқан.
Dialogue: 0,0:10:19.70,0:10:21.91,Default,,0,0,0,,Кеш тақырыбына сай емес пе?
Dialogue: 0,0:10:22.62,0:10:25.83,Default,,0,0,0,,Сол кезде бір нәрсені түсіндіңіз бе?
Dialogue: 0,0:10:26.87,0:10:30.25,Default,,0,0,0,,Ричард шынымен әйел болса ше?
Dialogue: 0,0:10:30.83,0:10:34.42,Default,,0,0,0,,үшінның алдында өзіңнің шынайы болудың жолы жоқ.
Dialogue: 0,0:10:36.34,0:10:38.55,Default,,0,0,0,,Егер сізге шынымен ұнамаса, маған хабарлаңыз.
Dialogue: 0,0:10:39.05,0:10:41.97,Default,,0,0,0,,Егер айқас кие алмаудың себебі бар болса...
Dialogue: 0,0:10:42.76,0:10:44.64,Default,,0,0,0,,Екінші бомба!
Dialogue: 0,0:10:45.35,0:10:47.60,Default,,0,0,0,,Сіздің әкеңіз де костюм кие ме?
Dialogue: 0,0:10:47.68,0:10:50.73,Default,,0,0,0,,Иә! Әкең патшайым болады.
Dialogue: 0,0:10:50.81,0:10:51.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:51.81,0:10:55.27,Default,,0,0,0,,Мәртебелі, басқа жейтін ештеңең болмаса.
Dialogue: 0,0:10:55.36,0:10:56.19,Default,,0,0,0,,Менің маскам...
Dialogue: 0,0:10:56.28,0:10:57.53,Default,,0,0,0,,Мен оны көргім келеді!
Dialogue: 0,0:10:58.74,0:11:01.53,Default,,0,0,0,,Егер Энн сенімді болса
Dialogue: 0,0:11:01.61,0:11:03.32,Default,,0,0,0,,Оны көрмеу керек еді
Dialogue: 0,0:11:11.21,0:11:12.75,Default,,0,0,0,,Амал жоқ
Dialogue: 0,0:11:12.83,0:11:16.30,Default,,0,0,0,,Егер сіз үзілді-кесілді бас тартсаңыз, бұл сіздің күмәніңізді тереңдетеді.
Dialogue: 0,0:11:17.96,0:11:22.05,Default,,0,0,0,,Біртүрлі... Мен сол кездегідей қарсылықты сезінбеймін.
Dialogue: 0,0:11:22.13,0:11:27.60,Default,,0,0,0,,Костюм кигендіктен бе, әлде шайтан болып кеткендіктен бе?
Dialogue: 0,0:11:28.64,0:11:30.10,Default,,0,0,0,,Мен бұл сен болады деп күтпедім.
Dialogue: 0,0:11:30.18,0:11:32.98,Default,,0,0,0,,Мен саған әйел болып киінуге көмектесетін күн келеді деп ойламаппын.
Dialogue: 0,0:11:33.60,0:11:36.19,Default,,0,0,0,,Мен әйел болып өскен болсам
Dialogue: 0,0:11:36.27,0:11:39.78,Default,,0,0,0,,Маған осылай күнде көйлек кигіздіңіз бе?
Dialogue: 0,0:11:40.78,0:11:42.41,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:42.91,0:11:46.33,Default,,0,0,0,,Сенің қасыңда қалған мен емес едім.
Dialogue: 0,0:11:46.83,0:11:48.41,Default,,0,0,0,,А, мен түсіндім...
Dialogue: 0,0:11:49.08,0:11:50.45,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:11:51.46,0:11:55.96,Default,,0,0,0,,Мен әйел болсам, бәрі басқаша болар еді.
Dialogue: 0,0:11:56.96,0:12:01.59,Default,,0,0,0,,Бірақ менің сүйіктім мені «ұлым» деп атағандықтан
Dialogue: 0,0:12:02.09,0:12:05.18,Default,,0,0,0,,Осының өзі мені мақтан тұтты.
Dialogue: 0,0:12:05.93,0:12:09.31,Default,,0,0,0,,Анашым, тамаша! Бұл өте жақсы
Dialogue: 0,0:12:10.56,0:12:15.40,Default,,0,0,0,,Ричард Сіз серпін жоғалтып, оны киюді шешкен сияқтысыз.
Dialogue: 0,0:12:15.94,0:12:19.02,Default,,0,0,0,,Мен сенімдімін... Менің барлық қорқынышым негізсіз екеніне сенімдімін.
Dialogue: 0,0:12:19.86,0:12:23.15,Default,,0,0,0,,Өйткені иә, олай болуы мүмкін емес.
Dialogue: 0,0:12:23.65,0:12:25.49,Default,,0,0,0,,(Туған туыс) Олай деуге болады, бірақ (Туған туыс) бұл маңызды мәселе.
Dialogue: 0,0:12:30.54,0:12:31.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:32.50,0:12:33.96,Default,,0,0,0,,Уау...
Dialogue: 0,0:12:38.84,0:12:40.67,Default,,0,0,0,,Бұл... жақсы ма?
Dialogue: 0,0:12:40.75,0:12:45.13,Default,,0,0,0,,Мен өмірімде мұндай сұлуды көрмедім.
Dialogue: 0,0:12:52.35,0:12:54.14,Default,,0,0,0,,Мен екенімді білмеді ме?
Dialogue: 0,0:12:54.64,0:12:56.85,Default,,0,0,0,,Мен маска киюім керек еді.
Dialogue: 0,0:12:57.73,0:13:00.61,Default,,0,0,0,,Эдвардтың қате түсінгені таңқаларлық емес.
Dialogue: 0,0:13:01.11,0:13:04.90,Default,,0,0,0,,Сенің қасыңда болсам да мен өзімді сондай ыстық сезінемін...
Dialogue: 0,0:13:06.20,0:13:08.07,Default,,0,0,0,,Маған не болды?
Dialogue: 0,0:13:08.57,0:13:11.66,Default,,0,0,0,,Оны неге сонша әдемі деп санайсың?
Dialogue: 0,0:13:12.16,0:13:14.58,Default,,0,0,0,,Ханымдар, жиналсақ қалай болады?
Dialogue: 0,0:13:14.66,0:13:16.42,Default,,0,0,0,,Бізбен билей аласыз ба?
Dialogue: 0,0:13:17.00,0:13:20.38,Default,,0,0,0,,Жоқ, жоқ, ол... ол менің серігім.
Dialogue: 0,0:13:20.46,0:13:24.01,Default,,0,0,0,,Ұстаз, бүгін кеште әркім әртүрлі!
Dialogue: 0,0:13:24.09,0:13:25.72,Default,,0,0,0,,Бұл Мәртебелі Корольдің бұйрығы.
Dialogue: 0,0:13:25.80,0:13:27.30,Default,,0,0,0,,Би билейік
Dialogue: 0,0:13:27.38,0:13:30.64,Default,,0,0,0,,Туған жеріңіз бен атыңызды ұмытыңыз.
Dialogue: 0,0:13:31.81,0:13:34.35,Default,,0,0,0,,Ал егер... Ал егер мен...
Dialogue: 0,0:13:36.60,0:13:37.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:39.86,0:13:42.15,Default,,0,0,0,,Егер бұл Ричард болмаса...
Dialogue: 0,0:13:44.65,0:13:46.40,Default,,0,0,0,,Кет, қойшы!
Dialogue: 0,0:13:46.49,0:13:48.20,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:13:48.70,0:13:49.74,Default,,0,0,0,,Бір жерде…
Dialogue: 0,0:13:50.24,0:13:53.95,Default,,0,0,0,,Жоқ, кездессек те, түсінбейтініңізге сенімдімін.
Dialogue: 0,0:13:55.45,0:13:57.58,Default,,0,0,0,,Бүгін түнде ешкім жоқ...
Dialogue: 0,0:13:58.92,0:14:01.42,Default,,0,0,0,,Сұлу қызыммен билеп жүрген менмін
Dialogue: 0,0:14:01.50,0:14:02.88,Default,,0,0,0,,Жоқ, мен билеймін.
Dialogue: 0,0:14:02.96,0:14:04.63,Default,,0,0,0,,Мен бірінші кезекте тұрмын!
Dialogue: 0,0:14:04.71,0:14:07.17,Default,,0,0,0,,Артында болыңыз! Сіз таңдай алмайсыз!
Dialogue: 0,0:14:07.26,0:14:10.72,Default,,0,0,0,,Енді, ханшайым, сен кімді таңдайсың?
Dialogue: 0,0:14:11.35,0:14:14.35,Default,,0,0,0,,Кім... Кімді іздеп жүрсің?
Dialogue: 0,0:14:14.93,0:14:18.60,Default,,0,0,0,,Жүр, Ричард, сені тезірек табуымыз керек.
Dialogue: 0,0:14:18.69,0:14:22.44,Default,,0,0,0,,Сізде бәрі бар кезде неден қорқасыз?
Dialogue: 0,0:14:22.52,0:14:24.61,Default,,0,0,0,,Енді кімді таңдайсың?
Dialogue: 0,0:14:24.69,0:14:27.99,Default,,0,0,0,,Кім... Кім... Кім!
Dialogue: 0,0:14:28.61,0:14:30.49,Default,,0,0,0,,Мен кіммін...
Dialogue: 0,0:14:33.70,0:14:36.70,Default,,0,0,0,,Бұл шайтан... Бұл шайтан!
Dialogue: 0,0:14:41.00,0:14:43.54,Default,,0,0,0,,Мен сізге қатты ұқсайтын адамды білемін.
Dialogue: 0,0:14:44.55,0:14:45.50,Default,,0,0,0,,Сол дауыс…
Dialogue: 0,0:14:46.88,0:14:49.76,Default,,0,0,0,,Бұл қолдар... бұл жылулық...
Dialogue: 0,0:14:51.01,0:14:55.10,Default,,0,0,0,,Букингем, мен сені іздедім.
Dialogue: 0,0:14:57.27,0:15:00.73,Default,,0,0,0,,Әйелдерге арналған жеңіл сөздер т.б.
Dialogue: 0,0:15:01.23,0:15:03.61,Default,,0,0,0,,Өйткені ол жерде жан жоқ
Dialogue: 0,0:15:04.19,0:15:07.90,Default,,0,0,0,,Бірақ шынайы сөз ешқашан айтылмайды
Dialogue: 0,0:15:08.53,0:15:14.28,Default,,0,0,0,,Менің ойларым соншалықты ақылсыз болса да, жанымның тозақ оты мені жалмап кетсе де ...
Dialogue: 0,0:15:15.16,0:15:17.75,Default,,0,0,0,,Сенің ол адам болмағаныңа қуаныштымын.
Dialogue: 0,0:15:18.25,0:15:21.75,Default,,0,0,0,,Мен сені осылай құшақтап алсам, ешқашан жібере алмайсың
Dialogue: 0,0:15:22.63,0:15:26.59,Default,,0,0,0,,Жоқ... Маған ұнамайды. Мен сені енді ешқашан жібермеймін.
Dialogue: 0,0:15:26.67,0:15:27.84,Default,,0,0,0,,Барма!
Dialogue: 0,0:15:28.59,0:15:30.97,Default,,0,0,0,,Сене алмайсың...Ричард
Dialogue: 0,0:15:31.55,0:15:32.97,Default,,0,0,0,,Ричард емес
Dialogue: 0,0:15:33.47,0:15:36.01,Default,,0,0,0,,Сен де... сен емес.
Dialogue: 0,0:15:37.06,0:15:37.97,Default,,0,0,0,,Тек бүгін кешке...
Dialogue: 0,0:15:39.68,0:15:41.85,Default,,0,0,0,,Сұлу әйел өзімен бірге шайтан әкелді.
Dialogue: 0,0:15:41.94,0:15:44.19,Default,,0,0,0,,Әдемі әйел костюм кисе, ол әдетте не киеді?
Dialogue: 0,0:15:46.11,0:15:47.44,Default,,0,0,0,,Ричард…
Dialogue: 0,0:15:49.49,0:15:52.49,Default,,0,0,0,,Әй, күт, қайда бара жатырсың?
Dialogue: 0,0:15:52.99,0:15:54.32,Default,,0,0,0,,Кез келген жерде жақсы
Dialogue: 0,0:15:54.87,0:15:57.33,Default,,0,0,0,,«Патша» мен «герцог» сізді бақылай алмайтын жерде.
Dialogue: 0,0:16:00.79,0:16:04.17,Default,,0,0,0,,Дәл бүгін түнде... дәл бүгін түнде
Dialogue: 0,0:16:12.47,0:16:13.72,Default,,0,0,0,,Сіз қаншалықты алысқа барғыңыз келеді?
Dialogue: 0,0:16:14.34,0:16:16.30,Default,,0,0,0,,Тағы... әлі алыс
Dialogue: 0,0:16:17.14,0:16:20.47,Default,,0,0,0,,Бұл дүниеде бәрінен қашып құтылуға болатын жер
Dialogue: 0,0:16:21.06,0:16:23.06,Default,,0,0,0,,Бұл орманда ешкім жоқ
Dialogue: 0,0:16:23.56,0:16:26.02,Default,,0,0,0,,Әй, атыңды тоқтат! Сіз соғасыз!
Dialogue: 0,0:16:26.11,0:16:28.73,Default,,0,0,0,,Халық, ақсүйектер, патша...
Dialogue: 0,0:16:28.82,0:16:29.94,Default,,0,0,0,,Ричард!
Dialogue: 0,0:16:30.03,0:16:31.40,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:16:32.44,0:16:33.57,Default,,0,0,0,,Ричард!
Dialogue: 0,0:16:33.65,0:16:34.99,Default,,0,0,0,,(Бұрқаққа құлаған дыбыс)
Dialogue: 0,0:16:37.53,0:16:39.24,Default,,0,0,0,,Сіз... өлгіңіз келе ме?
Dialogue: 0,0:16:43.33,0:16:45.46,Default,,0,0,0,,Сіз жасаған патша
Dialogue: 0,0:16:45.96,0:16:48.29,Default,,0,0,0,,Мені солай етіп көрсетіп жатырсың ба?
Dialogue: 0,0:16:50.00,0:16:51.46,Default,,0,0,0,,Сіз неден қорқасыз?
Dialogue: 0,0:16:51.55,0:16:54.76,Default,,0,0,0,,Сіз өз қолыңызбен жасаған барлық нәрсені жоғалтасыз ба?
Dialogue: 0,0:16:56.59,0:16:57.68,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:16:58.18,0:16:59.43,Default,,0,0,0,,Оны неге байқадың?
Dialogue: 0,0:17:00.60,0:17:05.14,Default,,0,0,0,,Мен оны қанша іштей жоққа шығарсам да, қайта айта алмаймын.
Dialogue: 0,0:17:06.98,0:17:09.52,Default,,0,0,0,,«Мен сүйетін адам жоқ» т.б.
Dialogue: 0,0:17:13.57,0:17:14.15,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:17:15.07,0:17:19.20,Default,,0,0,0,,Сенімен ант берген жеріміз де раушан гүлге оранған.
Dialogue: 0,0:17:21.45,0:17:23.70,Default,,0,0,0,,Мен ешқашан орала алмаймын
Dialogue: 0,0:17:24.29,0:17:26.62,Default,,0,0,0,,Сіз шындықты түсінген кезде...
Dialogue: 0,0:17:27.75,0:17:32.67,Default,,0,0,0,,«Біз бірдейміз». Сол кезде сен солай айтқансың.
Dialogue: 0,0:17:34.13,0:17:35.80,Default,,0,0,0,,Иә
Dialogue: 0,0:17:36.47,0:17:38.64,Default,,0,0,0,,Біздің қалауымыз бір
Dialogue: 0,0:17:39.22,0:17:42.51,Default,,0,0,0,,Маған шынымен не қалайтыныңызды айтыңыз
Dialogue: 0,0:17:44.73,0:17:46.94,Default,,0,0,0,,Шындық ...
Dialogue: 0,0:17:48.15,0:17:51.73,Default,,0,0,0,,Басынан, басынан, барлық уақытта...
Dialogue: 0,0:17:53.40,0:17:56.61,Default,,0,0,0,,Ричард, мен сені қалаймын.
Dialogue: 0,0:17:58.74,0:18:00.53,Default,,0,0,0,,Сен менің екінші жартымсың
Dialogue: 0,0:18:24.31,0:18:26.93,Default,,0,0,0,,Осылай ұйықтасаң суық тигізбе.
Dialogue: 0,0:18:27.81,0:18:29.85,Default,,0,0,0,,Мен сенімен бірге тоңып өлсем
Dialogue: 0,0:18:29.94,0:18:31.40,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:33.15,0:18:34.90,Default,,0,0,0,,Менің киімімді киіп, үйге қайт.
Dialogue: 0,0:18:35.40,0:18:37.03,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:18:37.11,0:18:40.41,Default,,0,0,0,,Осы жерде менің ағам пайдаланатын үй бар.
Dialogue: 0,0:18:41.28,0:18:43.45,Default,,0,0,0,,Бүгін түнде менеджер болмауы керек.
Dialogue: 0,0:18:43.95,0:18:46.58,Default,,0,0,0,,Ойланып қарашы, сен неге бұлай киіндің?
Dialogue: 0,0:18:47.08,0:18:49.00,Default,,0,0,0,,Энн мен Эдвард маған өтінді.
Dialogue: 0,0:18:49.08,0:18:50.92,Default,,0,0,0,,Уф... (Ричард) Жақсысың ба?
Dialogue: 0,0:18:51.46,0:18:52.84,Default,,0,0,0,,Себебі менде көзілдірік жоқ
Dialogue: 0,0:18:54.46,0:18:55.34,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:18:58.38,0:18:59.59,Default,,0,0,0,,Босатпаңыз
Dialogue: 0,0:19:00.63,0:19:03.22,Default,,0,0,0,,Қолыңызды ешқашан жібермеңіз
Dialogue: 0,0:19:04.10,0:19:08.52,Default,,0,0,0,,Түнгі орман әрқашан жылуды көздейді.
Dialogue: 0,0:19:12.90,0:19:15.61,Default,,0,0,0,,Әке, қызық, қайда бардыңыз?
Dialogue: 0,0:19:17.73,0:19:19.86,Default,,0,0,0,,А... Қабан мырза?
Dialogue: 0,0:19:22.03,0:19:23.91,Default,,0,0,0,,Бұл жай ғана менің қиялым болды ма?
Dialogue: 0,0:19:24.41,0:19:24.95,Default,,0,0,0,,Ах
Dialogue: 0,0:19:26.08,0:19:27.16,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:28.04,0:19:28.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:28.83,0:19:31.46,Default,,0,0,0,,Уф... Кешіріңіз...
Dialogue: 0,0:19:34.46,0:19:35.59,Default,,0,0,0,,Бұл адам...
Dialogue: 0,0:19:36.09,0:19:39.51,Default,,0,0,0,,Сіз Ричард корольдің ұлысыз ба?
Dialogue: 0,0:19:40.01,0:19:41.30,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:19:41.38,0:19:42.72,Default,,0,0,0,,Олар бір-біріне ұқсамайды.
Dialogue: 0,0:19:43.68,0:19:48.72,Default,,0,0,0,,Шашымыздың түсінен бастап, аяғымыздың ұшына дейін ұқсамайтын сияқтымыз.
Dialogue: 0,0:19:49.22,0:19:50.77,Default,,0,0,0,,Бұл солай...
Dialogue: 0,0:19:50.85,0:19:54.06,Default,,0,0,0,,Сіз шынымен патшаның ұлысыз ба?
Dialogue: 0,0:19:54.56,0:19:55.65,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:56.15,0:19:58.78,Default,,0,0,0,,Жылқының сүйегі қайда екенін білмесең⸺
Dialogue: 0,0:19:58.86,0:20:01.15,Default,,0,0,0,,Егер бұл ұл болса
Dialogue: 0,0:20:01.24,0:20:03.16,Default,,0,0,0,,Күткендей, бұл қауесеттер...
Dialogue: 0,0:20:03.24,0:20:04.24,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:04.99,0:20:06.41,Default,,0,0,0,,H... Әке?
Dialogue: 0,0:20:06.99,0:20:10.25,Default,,0,0,0,,Ол сенің әкең емес пе деп қорқамын.
Dialogue: 0,0:20:10.33,0:20:13.21,Default,,0,0,0,,Элизабет, сен мұнда неге...
Dialogue: 0,0:20:13.29,0:20:16.34,Default,,0,0,0,,Мен саған мені «Бет» деп атаңдар дедім.
Dialogue: 0,0:20:16.42,0:20:17.42,Default,,0,0,0,,А... (Эдвард) Иә?
Dialogue: 0,0:20:22.51,0:20:24.18,Default,,0,0,0,,Элизабет…
Dialogue: 0,0:20:25.51,0:20:27.80,Default,,0,0,0,,Бұрынғы патшаның қызы?
Dialogue: 0,0:20:31.23,0:20:34.98,Default,,0,0,0,,Мен бұл жерге енді келемін деп ешқашан ойламаппын.
Dialogue: 0,0:20:35.06,0:20:37.31,Default,,0,0,0,,Менің жалғыз құтқарушым сен едің
Dialogue: 0,0:20:37.40,0:20:38.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:38.77,0:20:42.49,Default,,0,0,0,,Сол күні онымен бірге өткізген осы жерде...
Dialogue: 0,0:20:43.07,0:20:44.20,Default,,0,0,0,,Менің ауыстырған киімім қайда?
Dialogue: 0,0:20:44.99,0:20:47.74,Default,,0,0,0,,Сіз отты ұстаңыз, мен сізге әкелемін.
Dialogue: 0,0:20:48.24,0:20:50.49,Default,,0,0,0,,Сізге көп көмек қажет емес.
Dialogue: 0,0:20:51.16,0:20:54.21,Default,,0,0,0,,Мені кім деп ойлайсың? Мен енді бала емеспін
Dialogue: 0,0:20:56.00,0:20:58.46,Default,,0,0,0,,Өзіңді кіммен салыстырасың... ақымақ?
Dialogue: 0,0:20:59.50,0:21:03.97,Default,,0,0,0,,Бірдеңе болды ма? Мен бұл сарайға келгеннен бері біртүрлі болды.
Dialogue: 0,0:21:04.80,0:21:05.76,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:21:06.64,0:21:10.22,Default,,0,0,0,,Мәселе жоқ... Жарайды Букингем.
Dialogue: 0,0:21:11.01,0:21:13.68,Default,,0,0,0,,Иә, ол жігіттен бөлек.
Dialogue: 0,0:21:14.73,0:21:15.85,Default,,0,0,0,,Ричард
Dialogue: 0,0:21:16.44,0:21:21.23,Default,,0,0,0,,Сіз мені герцогтың атымен емес, шын атыңызбен атай аласыз ба?
Dialogue: 0,0:21:21.82,0:21:22.99,Default,,0,0,0,,Менің атым
Dialogue: 0,0:21:24.74,0:21:26.49,Default,,0,0,0,,Сіздің атыңыз...
Dialogue: 0,0:21:26.99,0:21:30.24,Default,,0,0,0,,Иә, Генри Стаффорд.
Dialogue: 0,0:21:31.37,0:21:32.54,Default,,0,0,0,,«Генри»
Dialogue: 0,0:21:34.33,0:21:36.08,Default,,0,0,0,,Бірақ та...
Dialogue: 0,0:21:36.16,0:21:38.63,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:21:39.13,0:21:40.50,Default,,0,0,0,,Сол күн сияқты...
Dialogue: 0,0:21:41.38,0:21:44.55,Default,,0,0,0,,Қайтып келмейтін сол күн сияқты...
Dialogue: 0,0:21:46.51,0:21:49.85,Default,,0,0,0,,Сіз... осындасыз ба?
Dialogue: 0,0:22:01.48,0:22:03.48,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:30.95,Default,,0,0,0,,～♪
