Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.42,0:00:11.21,Default,,0,0,0,,Қош бол анашым
Dialogue: 0,0:00:12.55,0:00:14.80,Default,,0,0,0,,Менің... қарғысым.
Dialogue: 0,0:00:24.98,0:00:25.90,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:00:25.98,0:00:28.36,Default,,0,0,0,,Рұқсат етілмейді! Мен сенің күнәңді білемін!
Dialogue: 0,0:00:29.27,0:00:30.69,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:00:38.45,0:00:39.37,Default,,0,0,0,,Сен…
Dialogue: 0,0:00:41.33,0:00:43.96,Default,,0,0,0,,Сіз мені қабылдайтыныңызға сенімдімін
Dialogue: 0,0:00:44.96,0:00:47.08,Default,,0,0,0,,Өйткені сен ештеңе білмейсің
Dialogue: 0,0:00:49.21,0:00:51.59,Default,,0,0,0,,Және жалғыздық
Dialogue: 0,0:00:53.59,0:00:55.97,Default,,0,0,0,,Ричард, кешіріңіз...
Dialogue: 0,0:00:57.47,0:00:59.93,Default,,0,0,0,,Бұл, әрине, менің жадым емес.
Dialogue: 0,0:01:01.01,0:01:03.22,Default,,0,0,0,,Мен естіген оның үзінділері...
Dialogue: 0,0:01:04.27,0:01:08.40,Default,,0,0,0,,Бұл маған қатты ұқсайтын Генри туралы әңгіме.
Dialogue: 0,0:01:16.78,0:01:18.49,Default,,0,0,0,,Жау әскерлері қазір қайда?
Dialogue: 0,0:01:19.41,0:01:20.49,Default,,0,0,0,,Хабарланғандай
Dialogue: 0,0:01:20.58,0:01:23.41,Default,,0,0,0,,Олардың Тамворт маңына жеткені айтылады.
Dialogue: 0,0:01:23.95,0:01:26.46,Default,,0,0,0,,Шешуші шайқас Босворт жазығында болады.
Dialogue: 0,0:01:27.12,0:01:28.50,Default,,0,0,0,,Сарбаздарға айтыңыз.
Dialogue: 0,0:01:29.00,0:01:35.38,Default,,0,0,0,,Ұрыс даласында тамақ іше алмайсыз, ұйықтай алмайсыз, бірақ бүгін сіз соңғы кешкі асыңызды іше аласыз.
Dialogue: 0,0:01:37.55,0:01:39.55,Default,,0,0,0,,Мен қатты шаршадым.
Dialogue: 0,0:01:40.47,0:01:43.68,Default,,0,0,0,,Құдай бұл адамға неге сонша берілген?
Dialogue: 0,0:01:45.27,0:01:46.98,Default,,0,0,0,,Сен де, Кэтсби.
Dialogue: 0,0:01:47.06,0:01:49.65,Default,,0,0,0,,Егер бірдеңе қалайтын болса, маған хабарлаңыз.
Dialogue: 0,0:01:50.15,0:01:51.86,Default,,0,0,0,,Кез келген тамаша шарап немесе сыйлық
Dialogue: 0,0:01:51.94,0:01:55.03,Default,,0,0,0,,Бұл сіздің адалдығыңызды марапаттау үшін жеткіліксіз болуы мүмкін.
Dialogue: 0,0:01:55.69,0:01:58.74,Default,,0,0,0,,Менің тілегім – Мәртебелі ханымның денсаулығы мен еркі...
Dialogue: 0,0:01:58.82,0:02:02.53,Default,,0,0,0,,Маған шынымен не қалайтыныңызды айтыңыз! Бұл мен үшін тілек емес
Dialogue: 0,0:02:03.87,0:02:06.37,Default,,0,0,0,,Мен жоғалып кетсем не істер едің...
Dialogue: 0,0:02:06.96,0:02:10.46,Default,,0,0,0,,Бәрі біткен соң, сен не үшін өмір сүрмексің?
Dialogue: 0,0:02:13.75,0:02:18.13,Default,,0,0,0,,(Сарбаздардың күлкісі)
Dialogue: 0,0:02:34.36,0:02:37.78,Default,,0,0,0,,Тәжі ғана қалды.
Dialogue: 0,0:02:38.49,0:02:41.91,Default,,0,0,0,,Мен солай ойладым, бірақ...
Dialogue: 0,0:02:42.41,0:02:44.03,Default,,0,0,0,,Сенің әкең
Dialogue: 0,0:02:44.12,0:02:47.95,Default,,0,0,0,,Ричард, Йорк герцогы Плантагенет емес
Dialogue: 0,0:02:49.66,0:02:50.96,Default,,0,0,0,,Сіз білесіз бе...
Dialogue: 0,0:02:54.63,0:02:57.67,Default,,0,0,0,,Әке әрқашан...
Dialogue: 0,0:03:01.26,0:03:04.80,Default,,0,0,0,,(Ричардтың жөтелі)
Dialogue: 0,0:03:06.89,0:03:12.60,Default,,0,0,0,,Бұл атау, тіпті бұл қанның бәрі елес болса.
Dialogue: 0,0:03:13.10,0:03:16.69,Default,,0,0,0,,Бұл шайқастың мәні неде?
Dialogue: 0,0:03:17.19,0:03:19.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:29.08,0:03:31.62,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:03:35.59,0:03:36.46,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:03:38.63,0:03:41.47,Default,,0,0,0,,Бұндай жағдай бұрын да болған...
Dialogue: 0,0:03:52.14,0:03:53.52,Default,,0,0,0,,жылы
Dialogue: 0,0:03:54.85,0:03:59.53,Default,,0,0,0,,Ешкім жоқ шатырдың астынан да көп...
Dialogue: 0,0:04:02.03,0:04:05.11,Default,,0,0,0,,Тек осылай қалдырыңыз...
Dialogue: 0,0:04:08.53,0:04:09.41,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:04:09.49,0:04:10.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:11.96,0:04:14.00,Default,,0,0,0,,Мұнда ұйықтауға ыңғайлы.
Dialogue: 0,0:04:16.21,0:04:19.09,Default,,0,0,0,,Бұл... олай болмауы керек...
Dialogue: 0,0:04:20.30,0:04:21.46,Default,,0,0,0,,Сіз...
Dialogue: 0,0:04:27.72,0:04:31.98,Default,,0,0,0,,Сен мені өлтіруге келдің бе? Джеймс Тиррелл
Dialogue: 0,0:04:32.89,0:04:35.56,Default,,0,0,0,,Бұл есім сіздің шын атыңыз емес.
Dialogue: 0,0:04:36.44,0:04:38.61,Default,,0,0,0,,Қазір менің атым жоқ
Dialogue: 0,0:04:39.44,0:04:41.82,Default,,0,0,0,,Менің атым, өткенім, достарым...
Dialogue: 0,0:04:43.40,0:04:44.70,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:04:47.03,0:04:47.95,Default,,0,0,0,,Мен оны Солтүстік-Шығыс әскери театрдан алдым.
Dialogue: 0,0:04:49.08,0:04:53.83,Default,,0,0,0,,Букингем де кетті, мені өлтірудің қажеті жоқ...
Dialogue: 0,0:04:55.00,0:04:58.25,Default,,0,0,0,,Менде енді ештеңе жоқ.
Dialogue: 0,0:04:58.84,0:05:03.38,Default,,0,0,0,,Тәжін алсам, жұмаққа ие боламын деп сендім.
Dialogue: 0,0:05:04.22,0:05:07.89,Default,,0,0,0,,Бірақ ол жұмақта мен жалғызбын
Dialogue: 0,0:05:09.22,0:05:11.26,Default,,0,0,0,,Мен мұны жақсы деп ойладым.
Dialogue: 0,0:05:11.89,0:05:15.06,Default,,0,0,0,,Жалғыздық бір кездері маған мейірімді болды
Dialogue: 0,0:05:16.02,0:05:17.65,Default,,0,0,0,,Бірақ мен үшін қазір...
Dialogue: 0,0:05:18.15,0:05:18.94,Default,,0,0,0,,Ричард
Dialogue: 0,0:05:19.52,0:05:22.65,Default,,0,0,0,,Қашқың келсе, мен сені сонда апарамын.
Dialogue: 0,0:05:23.40,0:05:26.99,Default,,0,0,0,,Құтқарылғыңыз келсе
Dialogue: 0,0:05:27.86,0:05:30.20,Default,,0,0,0,,Өйткені сізде енді ештеңе жоқ.
Dialogue: 0,0:05:33.08,0:05:33.95,Default,,0,0,0,,Генри
Dialogue: 0,0:05:34.45,0:05:38.96,Default,,0,0,0,,Сіз де тәждің ішінде жалғыздықтан зардап шектіңіз бе?
Dialogue: 0,0:05:40.00,0:05:43.13,Default,,0,0,0,,Мен сені ешқашан көргім келмеген.
Dialogue: 0,0:05:43.67,0:05:47.51,Default,,0,0,0,,Тәждің салмағы, сәнді шатыр астындағы салқындық
Dialogue: 0,0:05:48.01,0:05:51.35,Default,,0,0,0,,Мен дәл қазір айтқым келетін нәрселер өте көп...
Dialogue: 0,0:05:52.14,0:05:55.02,Default,,0,0,0,,Бірақ сол күні, соңында
Dialogue: 0,0:05:55.64,0:05:59.52,Default,,0,0,0,,Неліктен ұрыс даласында болдың?
Dialogue: 0,0:06:00.52,0:06:03.57,Default,,0,0,0,,Сіз сол күні қашып кетуіңіз керек еді.
Dialogue: 0,0:06:04.32,0:06:05.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:08.20,0:06:12.87,Default,,0,0,0,,Сіз Букингем герцогымен жалғыз өткізген жаңбырлы түн.
Dialogue: 0,0:06:13.49,0:06:17.71,Default,,0,0,0,,Мен бұл бослықтың шын мәнін алғаш рет білдім.
Dialogue: 0,0:06:18.54,0:06:20.54,Default,,0,0,0,,Тек құрып кету емес.
Dialogue: 0,0:06:21.04,0:06:24.46,Default,,0,0,0,,Менің бар болуым үшін бір ғана нәрсе жеткілікті
Dialogue: 0,0:06:25.63,0:06:26.80,Default,,0,0,0,,Мен жарықты қалаймын
Dialogue: 0,0:06:26.88,0:06:29.63,Default,,0,0,0,,Ақымақ тәжі оған...
Dialogue: 0,0:06:29.72,0:06:33.85,Default,,0,0,0,,Жарық жұмақ емес, соны білу керек.
Dialogue: 0,0:06:34.51,0:06:37.60,Default,,0,0,0,,Жарық та тікенек
Dialogue: 0,0:06:39.56,0:06:43.19,Default,,0,0,0,,Сонда да... Сұрамасқа амалым жоқ.
Dialogue: 0,0:06:48.74,0:06:51.20,Default,,0,0,0,,Өйткені сіз қалаған нәрсе - өмір сүрудің мәні
Dialogue: 0,0:06:51.70,0:06:55.66,Default,,0,0,0,,Ақ, күте тұр, бұл үйге баратын жол емес.
Dialogue: 0,0:06:56.66,0:06:58.29,Default,,0,0,0,,Сол қабанмен барғың келе ме?
Dialogue: 0,0:06:59.16,0:07:00.37,Default,,0,0,0,,Сол бала болуы керек
Dialogue: 0,0:07:00.87,0:07:02.96,Default,,0,0,0,,Орманда ұзақ өмір сүре алмайсың, бірақ...
Dialogue: 0,0:07:12.64,0:07:15.64,Default,,0,0,0,,А... сен үйге барасың.
Dialogue: 0,0:07:16.64,0:07:18.35,Default,,0,0,0,,Дүние мені қабылдамаса да
Dialogue: 0,0:07:19.68,0:07:22.31,Default,,0,0,0,,Егер сіз осы жерде болғыңыз келсе...
Dialogue: 0,0:07:26.82,0:07:31.28,Default,,0,0,0,,Сіз не істейсіз? сен қайда болғың келеді?
Dialogue: 0,0:07:32.32,0:07:35.28,Default,,0,0,0,,Менің... Мен не қалаймын...
Dialogue: 0,0:07:36.99,0:07:41.87,Default,,0,0,0,,Суық шатырдың астында емес, жылы орманда емес.
Dialogue: 0,0:07:43.00,0:07:44.83,Default,,0,0,0,,үшінн алдым
Dialogue: 0,0:07:45.38,0:07:47.34,Default,,0,0,0,,Осы денеде патша болды
Dialogue: 0,0:07:48.09,0:07:51.88,Default,,0,0,0,,Қан да, есім де емес, менің қалағаным осы
Dialogue: 0,0:07:55.14,0:07:58.14,Default,,0,0,0,,Ұрыстың мәні де осы
Dialogue: 0,0:08:02.81,0:08:05.44,Default,,0,0,0,,Сіз ұрыс даласына қайтасыз.
Dialogue: 0,0:08:06.31,0:08:08.19,Default,,0,0,0,,Бұл жерде патша болуы керек.
Dialogue: 0,0:08:11.28,0:08:12.82,Default,,0,0,0,,Менің сізге өтінішім бар.
Dialogue: 0,0:08:15.70,0:08:18.95,Default,,0,0,0,,Менің... жарығым боласың ба?
Dialogue: 0,0:08:19.79,0:08:22.04,Default,,0,0,0,,Сіздің... жарығыңыз?
Dialogue: 0,0:08:23.25,0:08:26.75,Default,,0,0,0,,Сен де, мен де көп нәрседен айырылдық.
Dialogue: 0,0:08:28.67,0:08:29.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:31.84,0:08:36.39,Default,,0,0,0,,Мен... сенің менің досым болғаныңды қалаймын.
Dialogue: 0,0:08:46.98,0:08:49.98,Default,,0,0,0,,Ах... дос болайық
Dialogue: 0,0:08:51.28,0:08:54.20,Default,,0,0,0,,Ричардқа рахмет
Dialogue: 0,0:09:02.16,0:09:04.00,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,0:09:05.83,0:09:10.96,Default,,0,0,0,,Баратын жері тіпті ұйықтай алмайтын ұрыс алаңы болса да
Dialogue: 0,0:09:16.18,0:09:19.68,Default,,0,0,0,,Егер сіз сол жерде болғыңыз келсе
Dialogue: 0,0:09:22.56,0:09:24.68,Default,,0,0,0,,Сен менің досымсың
Dialogue: 0,0:09:29.52,0:09:31.52,Default,,0,0,0,,Енді, уайымдама...
Dialogue: 0,0:09:34.19,0:09:37.70,Default,,0,0,0,,Мен сені өлтіре аламын, Ричард.
Dialogue: 0,0:09:45.50,0:09:47.54,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:09:47.62,0:09:49.67,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:09:50.17,0:09:56.17,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:09:56.67,0:10:01.47,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:10:06.85,0:10:10.23,Default,,0,0,0,,Дүние қайтадан шу болды.
Dialogue: 0,0:10:10.31,0:10:12.15,Default,,0,0,0,,Тамақ тұқымдары да жоғалып кетті.
Dialogue: 0,0:10:12.23,0:10:14.48,Default,,0,0,0,,Сіз келесі Джеймс Тайреллді іздеп жүрсіз бе?
Dialogue: 0,0:10:15.44,0:10:20.32,Default,,0,0,0,,Форрест Даутон, мен сізге біраз ақпарат жібергім келеді.
Dialogue: 0,0:10:20.41,0:10:22.20,Default,,0,0,0,,Мені тамақтандырғаны үшін рахмет...
Dialogue: 0,0:10:23.58,0:10:27.91,Default,,0,0,0,,Бала кезіңізден қанша рет майдан даласына оралдыңыз?
Dialogue: 0,0:10:28.58,0:10:33.34,Default,,0,0,0,,Басында бұл жай ғана кек, ал қазір...
Dialogue: 0,0:10:34.34,0:10:38.05,Default,,0,0,0,,Авангард садақшыларға шоғырланады, ал Ховард команда сұрайды.
Dialogue: 0,0:10:38.13,0:10:41.64,Default,,0,0,0,,Стэнли мен Нортумберленд әрқайсысы өз адамдарын басқарады.
Dialogue: 0,0:10:41.72,0:10:43.76,Default,,0,0,0,,Ха! (Ховард) Мен түсінемін.
Dialogue: 0,0:10:45.60,0:10:47.10,Default,,0,0,0,,Стэнлиге не болды?
Dialogue: 0,0:10:48.02,0:10:50.73,Default,,0,0,0,,Ол Ричмондтағы әскерлерді қадағалап жүрген дейді.
Dialogue: 0,0:10:51.81,0:10:54.98,Default,,0,0,0,,Оларға ертең күн шыққанға дейін жасақтарды жіберуді айт.
Dialogue: 0,0:10:57.19,0:11:00.86,Default,,0,0,0,,Менің қайын атам әлі өз көзқарасын шешпеген сияқты.
Dialogue: 0,0:11:00.95,0:11:03.28,Default,,0,0,0,,Бірдеңені жайлап айтып тұрғанда ма?
Dialogue: 0,0:11:03.78,0:11:06.37,Default,,0,0,0,,Жау бізден де көп деп естимін.
Dialogue: 0,0:11:06.45,0:11:09.58,Default,,0,0,0,,Олардың көпшілігін қайын атамның әскері алып жатыр.
Dialogue: 0,0:11:10.33,0:11:11.87,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:11:11.96,0:11:16.50,Default,,0,0,0,,Жауларыңыздың көпшілігі сіз тарапта болса ше?
Dialogue: 0,0:11:17.00,0:11:18.88,Default,,0,0,0,,(Ричардтың жөтелі)
Dialogue: 0,0:11:18.96,0:11:20.01,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,0:11:20.51,0:11:22.64,Default,,0,0,0,,Жарайды, ештеңе емес...
Dialogue: 0,0:11:27.97,0:11:31.19,Default,,0,0,0,,Нортумберленд графы, ол сізге жетті ме?
Dialogue: 0,0:11:31.69,0:11:36.23,Default,,0,0,0,,Бұл хат патша әскерінің негізгі мүшелеріне таратылған көрінеді.
Dialogue: 0,0:11:38.98,0:11:40.28,Default,,0,0,0,,«Ричмонд графы»
Dialogue: 0,0:11:40.36,0:11:41.74,Default,,0,0,0,,«Генри Тюдор»
Dialogue: 0,0:11:42.24,0:11:46.70,Default,,0,0,0,,«Ресми түрде некеде тұрған Элизабет IV Эдвардтың қызы…»
Dialogue: 0,0:11:47.24,0:11:49.29,Default,,0,0,0,,Бұл белгі нақты
Dialogue: 0,0:11:49.37,0:11:51.83,Default,,0,0,0,,Олай болса, Ричмонд енді жоқ
Dialogue: 0,0:11:51.91,0:11:54.50,Default,,0,0,0,,Жай ғана ланкастриялық басып алушы емес
Dialogue: 0,0:11:55.46,0:11:57.84,Default,,0,0,0,,Өткен патшалардың өкініштерін көтеру⸺
Dialogue: 0,0:11:58.42,0:12:00.63,Default,,0,0,0,,Әділдіктің батыры бол
Dialogue: 0,0:12:10.43,0:12:12.89,Default,,0,0,0,,Ховард есебі Рахмет
Dialogue: 0,0:12:12.98,0:12:15.73,Default,,0,0,0,,Паллиативтік шаралармен ғана күресе алатын қорқақ
Dialogue: 0,0:12:15.81,0:12:18.82,Default,,0,0,0,,Ертең мен саған қылышпен соғысуды үйретемін.
Dialogue: 0,0:12:23.82,0:12:24.66,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:12:25.16,0:12:28.66,Default,,0,0,0,,Кетуге дейін де алаңдатарлық қауесеттер тарады.
Dialogue: 0,0:12:30.04,0:12:32.71,Default,,0,0,0,,Мәртебелі, кері кетуіңізді өтінемін.
Dialogue: 0,0:12:34.04,0:12:35.96,Default,,0,0,0,,Тақты осы жерде және қазір тартып алса да
Dialogue: 0,0:12:36.46,0:12:40.67,Default,,0,0,0,,Сауықтырудан кейін, егер сіз мінсіз күйде күрессеңіз, оны міндетті түрде қайтара аласыз.
Dialogue: 0,0:12:41.17,0:12:42.84,Default,,0,0,0,,Ешқашан екінші рет болмайды.
Dialogue: 0,0:12:43.34,0:12:47.60,Default,,0,0,0,,Бұл өлімге әкелетін ауру денені күннен-күнге бүлдіреді.
Dialogue: 0,0:12:48.72,0:12:49.64,Default,,0,0,0,,Майданға келгенше
Dialogue: 0,0:12:49.72,0:12:54.89,Default,,0,0,0,,Мен бейбіт патша сарайынан қан мен қорқынышқа толы ұрыс алаңына бара жатырмын деп ойладым.
Dialogue: 0,0:12:55.39,0:12:58.69,Default,,0,0,0,,Бірақ қазір менің жүрегім таң қалдырады.
Dialogue: 0,0:12:59.98,0:13:01.86,Default,,0,0,0,,Енді мен оны анық көремін
Dialogue: 0,0:13:02.36,0:13:07.66,Default,,0,0,0,,Бұл жерде патша болуы керек... өйткені мен болғым келетін жерде.
Dialogue: 0,0:13:09.87,0:13:12.37,Default,,0,0,0,,Сіз шайқаста өлуге ниетіңіз бар ма?
Dialogue: 0,0:13:18.46,0:13:21.88,Default,,0,0,0,,Сіз маған не қалайтыныңызды айтасыз
Dialogue: 0,0:13:23.09,0:13:24.05,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:26.72,0:13:31.56,Default,,0,0,0,,Өзің қалаған жолмен жүру үшін...
Dialogue: 0,0:13:33.43,0:13:36.89,Default,,0,0,0,,Мен ешқашан сенің жолыңмен жүрген емеспін
Dialogue: 0,0:13:37.39,0:13:40.23,Default,,0,0,0,,Мен ешқашан өз қалауыммен бұғаттауға тырысқан емеспін.
Dialogue: 0,0:13:41.44,0:13:44.74,Default,,0,0,0,,Бірақ, ақырында, менің өзімшілдігімді тыңдасаңыз.
Dialogue: 0,0:13:45.24,0:13:46.53,Default,,0,0,0,,Мен не қалаймын...
Dialogue: 0,0:13:47.36,0:13:49.07,Default,,0,0,0,,Тілек айтыңыз...
Dialogue: 0,0:13:51.53,0:13:56.54,Default,,0,0,0,,Құрметті Ричард! Өтінемін мен үшін өмір сүр...
Dialogue: 0,0:14:10.30,0:14:12.97,Default,,0,0,0,,Кешіріңіз, Кэтсби.
Dialogue: 0,0:14:22.82,0:14:23.65,Default,,0,0,0,,Мыау! Ах, Ферис, не болды?
Dialogue: 0,0:14:24.94,0:14:28.82,Default,,0,0,0,,Мен қорықтым... Түсімде қорқынышты орман болды.
Dialogue: 0,0:14:34.37,0:14:35.70,Default,,0,0,0,,Екінші форма: Суиша!
Dialogue: 0,0:14:36.75,0:14:41.46,Default,,0,0,0,,Жаман түс көрмейді деп үміттенемін.
Dialogue: 0,0:14:46.71,0:14:51.64,Default,,0,0,0,,(қорқынышты айқай)
Dialogue: 0,0:14:51.72,0:14:52.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:54.93,0:14:55.85,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:56.35,0:14:57.31,Default,,0,0,0,,Жоғары мәртебелі
Dialogue: 0,0:14:57.85,0:14:58.98,Default,,0,0,0,,Не!
Dialogue: 0,0:14:59.06,0:15:01.94,Default,,0,0,0,,Бізге ақпарат бергісі келетін кез келген адам...
Dialogue: 0,0:15:08.61,0:15:09.90,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,0:15:10.45,0:15:14.28,Default,,0,0,0,,Менің денем туралы не ойладың?
Dialogue: 0,0:15:15.74,0:15:18.62,Default,,0,0,0,,Мен әдемі деп ойладым.
Dialogue: 0,0:15:19.29,0:15:21.25,Default,,0,0,0,,Бұл дүниеге келген сәттен бастап
Dialogue: 0,0:15:29.38,0:15:33.51,Default,,0,0,0,,Мен патшамын, жеңілу үшін күреспеймін.
Dialogue: 0,0:15:42.35,0:15:43.44,Default,,0,0,0,,Мырзалар!
Dialogue: 0,0:15:43.52,0:15:47.15,Default,,0,0,0,,Ричард III - қатыгез және қатыгез тиран.
Dialogue: 0,0:15:47.23,0:15:50.28,Default,,0,0,0,,Қанында тұрып, қанымен тұғырын нығайтқан адам.
Dialogue: 0,0:15:51.07,0:15:55.62,Default,,0,0,0,,Амалсыз жоспар құрып, өз амбициясын орындап жүріп, тіпті өз жолдастарын өлтірген адам.
Dialogue: 0,0:15:56.20,0:15:58.95,Default,,0,0,0,,Бұл дүниеге келген сәттен бастап
Dialogue: 0,0:15:59.04,0:16:02.62,Default,,0,0,0,,Ол шайтан әрқашан Құдайдың жауы болған!
Dialogue: 0,0:16:05.96,0:16:07.75,Default,,0,0,0,,Енді қылышыңды алатын кез!
Dialogue: 0,0:16:07.84,0:16:11.92,Default,,0,0,0,,Садағыңды толған айдай тарт және жауынгер атпен қан теңізіне бар!
Dialogue: 0,0:16:14.89,0:16:15.93,Default,,0,0,0,,Тәж!
Dialogue: 0,0:16:16.01,0:16:17.51,Default,,0,0,0,,Ар-намыс өлімі!
Dialogue: 0,0:16:26.27,0:16:31.15,Default,,0,0,0,,(Солдаттардың ұрыс дауысы)
Dialogue: 0,0:16:37.49,0:16:40.04,Default,,0,0,0,,Мәртебелі, авангард итеріп жатыр!
Dialogue: 0,0:16:40.12,0:16:42.00,Default,,0,0,0,,Мұнда әлі лорд Стэнли бар.
Dialogue: 0,0:16:42.08,0:16:43.87,Default,,0,0,0,,Нортумберленд графы да күтіп тұр.
Dialogue: 0,0:16:45.62,0:16:48.04,Default,,0,0,0,,Мұны жау білуі керек.
Dialogue: 0,0:16:48.54,0:16:50.88,Default,,0,0,0,,Оксфорд графы - ардагер генерал.
Dialogue: 0,0:16:51.38,0:16:53.47,Default,,0,0,0,,Неліктен мұндай шарасыз тактика...
Dialogue: 0,0:16:54.68,0:16:57.14,Default,,0,0,0,,Нортумберленд графына сұрыптауға бұйрық беріңіз.
Dialogue: 0,0:17:01.68,0:17:05.81,Default,,0,0,0,,Мен болашақсыз соғыста сенімен бірге жүре алмаймын...
Dialogue: 0,0:17:06.31,0:17:09.15,Default,,0,0,0,,Мен Нортумберленд графы мені сатады деп ешқашан ойламадым...
Dialogue: 0,0:17:09.65,0:17:11.19,Default,,0,0,0,,Сатқындық көп болатынына сенімдімін.
Dialogue: 0,0:17:13.19,0:17:16.66,Default,,0,0,0,,Менің әлі де жоғалтатын нәрсем бар деп ойлау.
Dialogue: 0,0:17:17.49,0:17:21.83,Default,,0,0,0,,Мен шайтанмен бірге тозаққа барар едім...
Dialogue: 0,0:17:23.16,0:17:24.16,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:17:26.17,0:17:27.42,Default,,0,0,0,,Мен барамын!
Dialogue: 0,0:17:27.50,0:17:28.63,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:17:30.00,0:17:30.75,Default,,0,0,0,,Гуааа…
Dialogue: 0,0:17:32.05,0:17:32.67,Default,,0,0,0,,Аһ!
Dialogue: 0,0:17:39.30,0:17:40.22,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:17:41.89,0:17:42.77,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:17:43.27,0:17:44.52,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,0:17:45.81,0:17:47.81,Default,,0,0,0,,Ұрыс! Артқа қадам жасамаңыз!
Dialogue: 0,0:17:47.90,0:17:50.06,Default,,0,0,0,,Сіздің патшаңыз осында!
Dialogue: 0,0:17:51.94,0:17:54.78,Default,,0,0,0,,Міне... Ричмондтың негізгі күші!
Dialogue: 0,0:17:54.86,0:17:58.82,Default,,0,0,0,,Оның арғы жағында Стэнли лагері бар! Көмек сұрауға барсаңыз...
Dialogue: 0,0:18:03.49,0:18:05.87,Default,,0,0,0,,Жұмаққа барғысы келетіндер кетсін
Dialogue: 0,0:18:06.50,0:18:09.96,Default,,0,0,0,,Бірақ менің артымнан ерсең
Dialogue: 0,0:18:10.63,0:18:12.38,Default,,0,0,0,,Бірге тозаққа!
Dialogue: 0,0:18:15.71,0:18:18.09,Default,,0,0,0,,Мәртебелі мәртебеге еріңіз!
Dialogue: 0,0:18:23.18,0:18:23.81,Default,,0,0,0,,Гах...
Dialogue: 0,0:18:27.52,0:18:29.48,Default,,0,0,0,,Ричмонд~!
Dialogue: 0,0:18:45.95,0:18:47.16,Default,,0,0,0,,Қагемүше болса...
Dialogue: 0,0:18:49.46,0:18:53.50,Default,,0,0,0,,Патшаның өзімен күресудің қажеті жоқ, солай ма?
Dialogue: 0,0:18:54.21,0:18:56.67,Default,,0,0,0,,Шайқас біткенде маған қоңырау шалыңыз.
Dialogue: 0,0:19:01.59,0:19:03.64,Default,,0,0,0,,Барлық әскерлерді тастаңыз.
Dialogue: 0,0:19:04.35,0:19:05.68,Default,,0,0,0,,Біздің жауымыз...
Dialogue: 0,0:19:09.48,0:19:12.77,Default,,0,0,0,,Зұлымдық патшасы! Ричард III!
Dialogue: 0,0:19:15.23,0:19:17.32,Default,,0,0,0,,Тағдыр шешілді
Dialogue: 0,0:19:20.49,0:19:22.11,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:27.58,0:19:30.50,Default,,0,0,0,,Дүние қанша қайғырса да
Dialogue: 0,0:19:31.83,0:19:33.67,Default,,0,0,0,,Құдай жоққа шығарса да
Dialogue: 0,0:19:35.29,0:19:38.30,Default,,0,0,0,,Неше есе көп есе
Dialogue: 0,0:19:40.76,0:19:41.84,Default,,0,0,0,,Қалағаныңызша...
Dialogue: 0,0:19:44.05,0:19:46.97,Default,,0,0,0,,Осы қолдармен жарық
Dialogue: 0,0:19:51.06,0:19:52.77,Default,,0,0,0,,Сіз маған келмейсіз бе?
Dialogue: 0,0:19:53.40,0:19:55.48,Default,,0,0,0,,Ешкім кеткен жоқ...
Dialogue: 0,0:19:55.98,0:19:58.03,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:59.86,0:20:03.24,Default,,0,0,0,,Ричард, мен осындамын.
Dialogue: 0,0:20:06.87,0:20:10.62,Default,,0,0,0,,Мен әрқашан жалғыз болдым
Dialogue: 0,0:20:11.79,0:20:15.00,Default,,0,0,0,,Мен еркек те, әйел де емеспін
Dialogue: 0,0:20:15.63,0:20:17.54,Default,,0,0,0,,Жан түршігерлік Жанна д-Арк
Dialogue: 0,0:20:18.05,0:20:19.96,Default,,0,0,0,,Дәл мен сияқты...
Dialogue: 0,0:20:22.72,0:20:26.05,Default,,0,0,0,,Дұрыс... сен мен болдым.
Dialogue: 0,0:20:27.01,0:20:30.81,Default,,0,0,0,,Қарғыс байланған, Тілеу де күнә
Dialogue: 0,0:20:32.10,0:20:38.52,Default,,0,0,0,,Мен қорқынышты түстен қорқып, жарамнан жұбаныш іздедім, өзімді басқалардан артық жек көрдім.
Dialogue: 0,0:20:40.28,0:20:43.90,Default,,0,0,0,,Ол кезде... басқа мен
Dialogue: 0,0:20:47.57,0:20:50.79,Default,,0,0,0,,Жақында менің кезегім келді ме?
Dialogue: 0,0:20:51.29,0:20:56.17,Default,,0,0,0,,Егер сіз ұсынған ақпарат дұрыс болса, мен қалағаныңызды аламын.
Dialogue: 0,0:20:57.17,0:20:58.67,Default,,0,0,0,,Тайрелл мырза
Dialogue: 0,0:21:00.34,0:21:01.84,Default,,0,0,0,,Ричард өлтірілді ме?
Dialogue: 0,0:21:02.42,0:21:05.26,Default,,0,0,0,,Ол аттан құлаған соң не болды...
Dialogue: 0,0:21:05.76,0:21:08.01,Default,,0,0,0,,Жылқы қара ма еді?
Dialogue: 0,0:21:08.10,0:21:09.39,Default,,0,0,0,,Ха, мүмкін...
Dialogue: 0,0:21:10.60,0:21:12.85,Default,,0,0,0,,Хмф... Бұл жалған.
Dialogue: 0,0:21:13.68,0:21:15.64,Default,,0,0,0,,Нағыз Ричард...
Dialogue: 0,0:21:19.65,0:21:21.65,Default,,0,0,0,,Ақ боз атқа міну
Dialogue: 0,0:21:23.44,0:21:24.40,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:21:30.95,0:21:33.75,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:35.46,0:21:37.00,Default,,0,0,0,,Мен сенмін
Dialogue: 0,0:21:39.33,0:21:42.71,Default,,0,0,0,,Мен сені сүйемін Ричард
Dialogue: 0,0:21:46.38,0:21:48.39,Default,,0,0,0,,♪～
Dialogue: 0,0:21:49.47,0:21:50.43,Default,,0,0,0,,Ричард
Dialogue: 0,0:21:51.81,0:21:52.72,Default,,0,0,0,,Ричард
Dialogue: 0,0:22:04.61,0:22:07.74,Default,,0,0,0,,Ричард I...
Dialogue: 0,0:22:09.61,0:22:12.99,Default,,0,0,0,,Мені сүй
Dialogue: 0,0:22:16.25,0:22:19.79,Default,,0,0,0,,Тағдыр қайта-қайта айналады
Dialogue: 0,0:22:23.34,0:22:25.71,Default,,0,0,0,,Қанша рет алсаң да
Dialogue: 0,0:22:30.80,0:22:33.47,Default,,0,0,0,,Қанша рет жеңілсем де...
Dialogue: 0,0:22:36.18,0:22:38.94,Default,,0,0,0,,Мен сенің өлуге жол бермеймін.
Dialogue: 0,0:22:39.44,0:22:42.02,Default,,0,0,0,,Егер сіз қаласаңыз да!
Dialogue: 0,0:22:50.66,0:22:57.20,Default,,0,0,0,,А, мен оянсам, сенің тілегің...
Dialogue: 0,0:23:18.60,0:23:19.98,Default,,0,0,0,,Бірақ қазір...
