Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.71,0:00:04.12,Default,,0,0,0,,Эй, сен мұны естідің бе?
Dialogue: 0,0:00:04.21,0:00:06.96,Default,,0,0,0,,Әй, бұл қауесеттер рас болған сияқты.
Dialogue: 0,0:00:07.04,0:00:09.88,Default,,0,0,0,,«G» әрпі бар адам патша отбасын бұзса...
Dialogue: 0,0:00:11.67,0:00:14.05,Default,,0,0,0,,Шешім қабылдау қабілетін жоғалтқан Джорджға
Dialogue: 0,0:00:14.13,0:00:16.51,Default,,0,0,0,,Кінәлау оңай болды
Dialogue: 0,0:00:17.89,0:00:19.76,Default,,0,0,0,,Оның шынымен Джордж екеніне сене алар емеспін
Dialogue: 0,0:00:19.85,0:00:22.48,Default,,0,0,0,,Мен сенің маған қарғыс айтып жатқаныңды білмедім...
Dialogue: 0,0:00:23.06,0:00:27.36,Default,,0,0,0,,Бірақ әзірше мен сізді қылмысқа қарамастан бақылауда ұстаймын.
Dialogue: 0,0:00:27.86,0:00:30.28,Default,,0,0,0,,Мүмкін мен ақыры есін жиармын.
Dialogue: 0,0:00:30.36,0:00:32.99,Default,,0,0,0,,Бірақ ешқандай жазасыз
Dialogue: 0,0:00:33.07,0:00:33.61,Default,,0,0,0,,Мен сізге көрсеткім келеді...
Dialogue: 0,0:00:33.70,0:00:34.90,Default,,0,0,0,,Ричард
Dialogue: 0,0:00:34.99,0:00:37.95,Default,,0,0,0,,Жұмыстарыңызға көп рахмет.
Dialogue: 0,0:00:38.91,0:00:41.41,Default,,0,0,0,,үшін, сәл ерте, бірақ кеш аяқталды.
Dialogue: 0,0:00:41.49,0:00:42.00,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,0:00:42.87,0:00:45.42,Default,,0,0,0,,Иә, сіздің денеңіз бірінші орында.
Dialogue: 0,0:00:45.92,0:00:47.46,Default,,0,0,0,,Мен оны өлтіруім керек еді.
Dialogue: 0,0:00:48.08,0:00:51.71,Default,,0,0,0,,Әдеттегідей, үміт адамды жынды етеді.
Dialogue: 0,0:00:52.21,0:00:54.76,Default,,0,0,0,,Бүгін мен тек отбасыммен бірге ләззат алғым келеді.
Dialogue: 0,0:00:56.51,0:00:59.60,Default,,0,0,0,,Ричард, мен бүгін кешке қалаға шығамын.
Dialogue: 0,0:01:00.10,0:01:00.93,Default,,0,0,0,,Балалар, сендер де келіңдер.
Dialogue: 0,0:01:06.52,0:01:08.56,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:08.65,0:01:10.69,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:11.19,0:01:17.20,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:17.70,0:01:22.58,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:01:26.50,0:01:28.50,Default,,0,0,0,,♪～
Dialogue: 0,0:02:52.83,0:02:54.84,Default,,0,0,0,,～♪
Dialogue: 0,0:02:57.05,0:02:59.30,Default,,0,0,0,,Мәртебелі, қош келдіңіз.
Dialogue: 0,0:02:59.88,0:03:01.68,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:03:01.76,0:03:03.85,Default,,0,0,0,,Мен ағаларымды алып келдім.
Dialogue: 0,0:03:05.05,0:03:07.14,Default,,0,0,0,,Мәртебелі ол ханымға ғашық.
Dialogue: 0,0:03:07.22,0:03:10.31,Default,,0,0,0,,Бізді ұмыттыңыз ба?
Dialogue: 0,0:03:10.39,0:03:12.94,Default,,0,0,0,,Ол раушан гүл, ал сен лалагүлсің.
Dialogue: 0,0:03:13.44,0:03:14.94,Default,,0,0,0,,Гүлдердің бәрі әдемі
Dialogue: 0,0:03:15.61,0:03:18.15,Default,,0,0,0,,Бұл жиіркеніштен тыс, құрметке дейін.
Dialogue: 0,0:03:18.74,0:03:20.19,Default,,0,0,0,,Қайталау...
Dialogue: 0,0:03:20.74,0:03:22.20,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:03:22.70,0:03:24.62,Default,,0,0,0,,Тек оны жеңіп ал
Dialogue: 0,0:03:26.08,0:03:28.41,Default,,0,0,0,,Патшаға бұл сізге ұнағанын айтыңыз
Dialogue: 0,0:03:28.91,0:03:31.04,Default,,0,0,0,,Мен уақытты өз қалауымша өлтіремін.
Dialogue: 0,0:03:31.12,0:03:34.00,Default,,0,0,0,,Мм... Мен оны төлеу үшін жұмыс істеймін.
Dialogue: 0,0:03:34.50,0:03:36.21,Default,,0,0,0,,Дәл бұйырғандай
Dialogue: 0,0:03:36.71,0:03:38.46,Default,,0,0,0,,Егер бұл Йорк үшін болса...
Dialogue: 0,0:03:38.55,0:03:39.92,Default,,0,0,0,,Дөрекі!
Dialogue: 0,0:03:40.01,0:03:42.84,Default,,0,0,0,,Не? Жезөкшеге ұқсама
Dialogue: 0,0:03:42.93,0:03:43.51,Default,,0,0,0,,Жүр, іш!
Dialogue: 0,0:03:44.51,0:03:45.47,Default,,0,0,0,,Ой…
Dialogue: 0,0:03:47.39,0:03:48.81,Default,,0,0,0,,Жоқ... Бұл не, сен?
Dialogue: 0,0:03:48.89,0:03:50.27,Default,,0,0,0,,Глостер герцогы
Dialogue: 0,0:03:50.98,0:03:52.98,Default,,0,0,0,,Ричард Плантагенет
Dialogue: 0,0:03:53.06,0:03:55.81,Default,,0,0,0,,Бұл... Бұл мәртебелі герцог.
Dialogue: 0,0:03:55.90,0:03:56.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:57.90,0:03:59.94,Default,,0,0,0,,Ричардқа рахмет!
Dialogue: 0,0:04:00.03,0:04:01.19,Default,,0,0,0,,Уау
Dialogue: 0,0:04:01.28,0:04:03.45,Default,,0,0,0,,Сіз массыз ба? Бет
Dialogue: 0,0:04:03.53,0:04:06.37,Default,,0,0,0,,Иә, бірге ойнайық.
Dialogue: 0,0:04:06.45,0:04:07.87,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:04:07.95,0:04:09.16,Default,,0,0,0,,№
Dialogue: 0,0:04:09.66,0:04:11.37,Default,,0,0,0,,Бұл сіз келетін жер емес...
Dialogue: 0,0:04:11.45,0:04:13.33,Default,,0,0,0,,Онда мен қалаға барамын!
Dialogue: 0,0:04:13.41,0:04:15.67,Default,,0,0,0,,Мен оны бір рет көргім келді.
Dialogue: 0,0:04:17.09,0:04:19.50,Default,,0,0,0,,Ей, қарашы, саған жақсы көрінеді.
Dialogue: 0,0:04:19.59,0:04:21.97,Default,,0,0,0,,Ухухухухуху...
Dialogue: 0,0:04:22.05,0:04:25.80,Default,,0,0,0,,Ханшайымның түнде еркекше киініп шығуы ақырзаман.
Dialogue: 0,0:04:25.89,0:04:28.10,Default,,0,0,0,,Жалғыз секіргеннен жақсы.
Dialogue: 0,0:04:28.68,0:04:30.26,Default,,0,0,0,,Маған батасын беріңізші
Dialogue: 0,0:04:30.35,0:04:33.06,Default,,0,0,0,,Ата-анам тастап кеткенім үшін Алла разы болсын...
Dialogue: 0,0:04:33.14,0:04:37.73,Default,,0,0,0,,Күнә дертке айналды, денемді шайтан иемденді.
Dialogue: 0,0:04:38.23,0:04:40.61,Default,,0,0,0,,Бұл жігіт пен менің айырмашылығымыз неде?
Dialogue: 0,0:04:41.19,0:04:45.20,Default,,0,0,0,,Күйі мен аты бойынша қорғалған киімдер жұлынса, бұл дене де...
Dialogue: 0,0:04:45.28,0:04:47.07,Default,,0,0,0,,Сіз мұны бұрын көргенсіз.
Dialogue: 0,0:04:47.16,0:04:51.33,Default,,0,0,0,,Хехехе... Бір жерде кездестік қой? Күйеу
Dialogue: 0,0:04:51.41,0:04:52.54,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:04:52.62,0:04:54.25,Default,,0,0,0,,Сен неге сонша бастықсың?
Dialogue: 0,0:04:54.33,0:04:57.33,Default,,0,0,0,,Сен де біз сияқты қаңғыбас болуың керек!
Dialogue: 0,0:04:58.46,0:05:00.59,Default,,0,0,0,,Біз бәріміз бірдей құлшыныспен жанып тұрмыз!
Dialogue: 0,0:05:00.67,0:05:03.05,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:05:03.13,0:05:05.51,Default,,0,0,0,,Иә! Бұл менің жеңісім
Dialogue: 0,0:05:06.22,0:05:10.81,Default,,0,0,0,,Жарайсың ба? Жеңілсек, бәріміз патшаның бұйрығын орындауға уәде береміз.
Dialogue: 0,0:05:10.89,0:05:12.68,Default,,0,0,0,,Мен уәдемді орындаймын.
Dialogue: 0,0:05:13.18,0:05:14.60,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:05:15.89,0:05:16.94,Default,,0,0,0,,Гохон
Dialogue: 0,0:05:17.02,0:05:19.61,Default,,0,0,0,,Содан кейін патша бұйрық береді.
Dialogue: 0,0:05:21.32,0:05:24.11,Default,,0,0,0,,Алғашқы махаббатыңызды бір-бірден мойындаңыз!
Dialogue: 0,0:05:25.61,0:05:26.40,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:05:26.49,0:05:28.03,Default,,0,0,0,,Иә? Өтірік!
Dialogue: 0,0:05:28.11,0:05:29.07,Default,,0,0,0,,Сіздің әйеліңіз ше?
Dialogue: 0,0:05:29.57,0:05:30.58,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:30.66,0:05:35.04,Default,,0,0,0,,Әй... Бір тамаша әңгіме естігім келді.
Dialogue: 0,0:05:35.54,0:05:38.54,Default,,0,0,0,,Екеуің армандарыңды айтасыңдар, солай ма?
Dialogue: 0,0:05:40.33,0:05:41.21,Default,,0,0,0,,Менің әйелім.
Dialogue: 0,0:05:41.79,0:05:43.71,Default,,0,0,0,,Мен солай ойладым!
Dialogue: 0,0:05:43.80,0:05:45.97,Default,,0,0,0,,Алғашқы махаббатыңызға тұрмысқа шығасыз ба?
Dialogue: 0,0:05:46.05,0:05:49.01,Default,,0,0,0,,Өйткені, Энн мен Ричард - тамаша жұп.
Dialogue: 0,0:05:49.51,0:05:51.26,Default,,0,0,0,,Кэтсби туралы не деуге болады?
Dialogue: 0,0:05:51.35,0:05:52.93,Default,,0,0,0,,Мені де қызықтырады.
Dialogue: 0,0:05:53.01,0:05:57.73,Default,,0,0,0,,Тіпті сіз сияқты түзу жігіттің де әйелдер туралы ойлайтын кезі болды ма?
Dialogue: 0,0:05:57.81,0:05:59.56,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:05:59.65,0:06:00.48,Default,,0,0,0,,Иә
Dialogue: 0,0:06:02.98,0:06:06.99,Default,,0,0,0,,Менің өмірімде бір ғана адам бар... ол адам.
Dialogue: 0,0:06:07.57,0:06:10.07,Default,,0,0,0,,Сіз қандай адамсыз? Сен әлі менің жанымдасың ба?
Dialogue: 0,0:06:11.37,0:06:15.04,Default,,0,0,0,,Мен... сенде ондай адам бар екенін білмедім.
Dialogue: 0,0:06:16.70,0:06:19.04,Default,,0,0,0,,Адам мейірімді ме?
Dialogue: 0,0:06:19.54,0:06:20.42,Default,,0,0,0,,Иә
Dialogue: 0,0:06:21.42,0:06:22.25,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:22.92,0:06:23.46,Default,,0,0,0,,Құрметті Ричард...
Dialogue: 0,0:06:23.54,0:06:25.05,Default,,0,0,0,,Енді мен патшамын
Dialogue: 0,0:06:27.26,0:06:28.80,Default,,0,0,0,,Мен бұйрық бойынша шешім қабылдадым.
Dialogue: 0,0:06:29.30,0:06:33.43,Default,,0,0,0,,Ричард Мен ең сенетін адам
Dialogue: 0,0:06:33.51,0:06:34.43,Default,,0,0,0,,Мені сүй
Dialogue: 0,0:06:34.51,0:06:35.93,Default,,0,0,0,,Букингем герцогы
Dialogue: 0,0:06:36.02,0:06:37.64,Default,,0,0,0,,Мен мұны істей алмаймын ...
Dialogue: 0,0:06:38.23,0:06:41.60,Default,,0,0,0,,Бұл патшаның бұйрығы. Сіз басқаларға қарағанда адалсыз, солай ма?
Dialogue: 0,0:06:44.27,0:06:45.02,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:47.61,0:06:50.78,Default,,0,0,0,,Үміт адамдарды жынды етеді...
Dialogue: 0,0:06:53.57,0:06:57.04,Default,,0,0,0,,Дұрыс айтасың, Букингем.
Dialogue: 0,0:06:58.08,0:07:00.04,Default,,0,0,0,,Әзіл, Ричард.
Dialogue: 0,0:07:02.46,0:07:03.46,Default,,0,0,0,,Бітірдің бе?
Dialogue: 0,0:07:03.96,0:07:07.30,Default,,0,0,0,,Иә, түнгі өмір аяқталды.
Dialogue: 0,0:07:14.51,0:07:19.56,Default,,0,0,0,,Баяғыда... Ол мені арқасына көтеріп, әр жерде жүрді.
Dialogue: 0,0:07:23.15,0:07:25.27,Default,,0,0,0,,Адамдар өзгермейді
Dialogue: 0,0:07:25.36,0:07:29.57,Default,,0,0,0,,Егер сіз басқаша сезінсеңіз, сіз жай ғана білмедіңіз.
Dialogue: 0,0:07:32.49,0:07:34.82,Default,,0,0,0,,Ричард Мейірімсіз бол
Dialogue: 0,0:07:35.49,0:07:38.37,Default,,0,0,0,,Сізде әлі де басқалардан үміт бар.
Dialogue: 0,0:07:38.87,0:07:43.21,Default,,0,0,0,,Өзгелерден үміт күтпесең, өзіңнен үміт күте аласың.
Dialogue: 0,0:07:44.00,0:07:45.67,Default,,0,0,0,,Сізге ұнайды ма?
Dialogue: 0,0:07:45.75,0:07:46.29,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:48.34,0:07:50.76,Default,,0,0,0,,Мен ешкімге ұқсамаймын
Dialogue: 0,0:07:53.84,0:07:56.18,Default,,0,0,0,,Мен жай ғана менмін
Dialogue: 0,0:07:57.14,0:08:02.23,Default,,0,0,0,,Бұл денеде маған үміт сыйлайтын жалғыз нәрсе – осы қан.
Dialogue: 0,0:08:02.77,0:08:06.73,Default,,0,0,0,,Йорк қаны бұл дененің күнәларын жабады.
Dialogue: 0,0:08:07.23,0:08:11.15,Default,,0,0,0,,Оның құдіреттілігі сонша, тіпті Құдай оны жазалай алмайды.
Dialogue: 0,0:08:13.24,0:08:14.11,Default,,0,0,0,,Букингем
Dialogue: 0,0:08:17.62,0:08:19.54,Default,,0,0,0,,Джорджды өлтіріңіз
Dialogue: 0,0:08:20.95,0:08:22.50,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:08:28.09,0:08:31.01,Default,,0,0,0,,Джеймс Тайрелл деген кісі өлтіруші бар.
Dialogue: 0,0:08:31.09,0:08:35.05,Default,,0,0,0,,Ақшасы бар болса, ол кез келген лас жұмысты мінсіз атқара алатын адам.
Dialogue: 0,0:08:35.93,0:08:38.85,Default,,0,0,0,,Мен сіздің өміріңіз туралы делдалға хабарлаймын.
Dialogue: 0,0:08:38.93,0:08:40.81,Default,,0,0,0,,Тек өлтіру жеткіліксіз
Dialogue: 0,0:08:41.31,0:08:44.81,Default,,0,0,0,,Джордж жоғалып кетсе, Королеваның күші артады.
Dialogue: 0,0:08:45.65,0:08:48.61,Default,,0,0,0,,Олай болса, патшаны ойландырыңыз
Dialogue: 0,0:08:48.69,0:08:51.78,Default,,0,0,0,,Джордждың өліміне Вудвилл себеп болды.
Dialogue: 0,0:08:52.36,0:08:53.78,Default,,0,0,0,,Маған жоспарыңызды айтыңыз
Dialogue: 0,0:08:55.95,0:08:59.08,Default,,0,0,0,,Ричард Джорджға барасыз ба?
Dialogue: 0,0:08:59.87,0:09:01.49,Default,,0,0,0,,Бұл менің анам
Dialogue: 0,0:09:01.58,0:09:04.54,Default,,0,0,0,,Бір күні осындай күн келеді деп ойладым.
Dialogue: 0,0:09:04.62,0:09:05.87,Default,,0,0,0,,Не істеп жатырсың, Ани? Қазір тоқтама.
Dialogue: 0,0:09:06.37,0:09:07.42,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:07.50,0:09:08.29,Default,,0,0,0,,(Шапалақ дауысы)
Dialogue: 0,0:09:09.50,0:09:10.67,Default,,0,0,0,,Құрметті Сесили!
Dialogue: 0,0:09:10.75,0:09:11.50,Default,,0,0,0,,Ричард!
Dialogue: 0,0:09:12.09,0:09:14.67,Default,,0,0,0,,Мен басқаларды алдауым мүмкін, бірақ мен алданбаймын.
Dialogue: 0,0:09:14.76,0:09:17.43,Default,,0,0,0,,Сен бәрін құртатын шайтансың!
Dialogue: 0,0:09:17.51,0:09:19.18,Default,,0,0,0,,О, Құдай...
Dialogue: 0,0:09:19.26,0:09:22.93,Default,,0,0,0,,Қымбатты ұлымды қорғай көр...
Dialogue: 0,0:09:27.60,0:09:28.65,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:09:28.73,0:09:30.69,Default,,0,0,0,,А... Ана?
Dialogue: 0,0:09:31.19,0:09:32.23,Default,,0,0,0,,Джордж аға
Dialogue: 0,0:09:34.36,0:09:35.15,Default,,0,0,0,,Ричард…
Dialogue: 0,0:09:35.95,0:09:39.53,Default,,0,0,0,,Ал... маған сусын бер! Бұл ауыр және төзгісіз
Dialogue: 0,0:09:40.03,0:09:42.62,Default,,0,0,0,,Өлім үкімі бүгін шығарылады.
Dialogue: 0,0:09:43.20,0:09:45.45,Default,,0,0,0,,Ақымақ! Мен сотқа шақырылған жоқпын!
Dialogue: 0,0:09:45.54,0:09:50.04,Default,,0,0,0,,Мұның бәрі патшаны қоршап алған шайтандардың жоспары.
Dialogue: 0,0:09:50.13,0:09:52.17,Default,,0,0,0,,Бұл Вудвилл отбасының жұмысы болды ма?
Dialogue: 0,0:09:52.75,0:09:53.59,Default,,0,0,0,,Аға
Dialogue: 0,0:09:54.09,0:09:56.13,Default,,0,0,0,,Мен сені бұлай қалдыра алмаймын.
Dialogue: 0,0:09:57.76,0:10:01.10,Default,,0,0,0,,Ричард... сен жалғыз мен жағындасың
Dialogue: 0,0:10:01.18,0:10:01.97,Default,,0,0,0,,Иә
Dialogue: 0,0:10:02.47,0:10:06.14,Default,,0,0,0,,Мен сенің орнын басатын болсам да, сені құтқаратыныма сенімдімін.
Dialogue: 0,0:10:10.77,0:10:11.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:13.98,0:10:17.70,Default,,0,0,0,,Бұл адамның Мәртебелі Патшаға жасаған әрекеті қабылданбайды.
Dialogue: 0,0:10:17.78,0:10:21.24,Default,,0,0,0,,Бұл опасыздық пен Құдайға тіл тигізудің күнәсі.
Dialogue: 0,0:10:21.32,0:10:22.66,Default,,0,0,0,,Демек, өлім жазасының жазасы...
Dialogue: 0,0:10:22.74,0:10:23.70,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:10:23.78,0:10:27.00,Default,,0,0,0,,Сіз мені ресми сотсыз өлтірмексіз бе?
Dialogue: 0,0:10:27.08,0:10:29.37,Default,,0,0,0,,Мені өлім жазасына кескен кім!
Dialogue: 0,0:10:29.46,0:10:30.71,Default,,0,0,0,,Сәлем! Оны ұстаңыз!
Dialogue: 0,0:10:30.79,0:10:33.42,Default,,0,0,0,,Аузыңды жап! ұятсыз Вудвилл
Dialogue: 0,0:10:33.50,0:10:36.21,Default,,0,0,0,,Қанша жетістікке жетсең де, жаның төмен болып қала береді.
Dialogue: 0,0:10:36.30,0:10:39.34,Default,,0,0,0,,Тозаққа қайт, жын-перілер!
Dialogue: 0,0:10:39.43,0:10:41.18,Default,,0,0,0,,Оны естігенге шыдай алмаймын.
Dialogue: 0,0:10:41.26,0:10:42.80,Default,,0,0,0,,үшінң тыңдаңдар.
Dialogue: 0,0:10:42.89,0:10:47.56,Default,,0,0,0,,Патша шайтанның айласына түсіп, бұл елді шайтанға сатпақшы!
Dialogue: 0,0:10:47.64,0:10:49.85,Default,,0,0,0,,Бұл құрбандық – мен!
Dialogue: 0,0:10:49.94,0:10:51.44,Default,,0,0,0,,Эдвард - қанішер!
Dialogue: 0,0:10:52.02,0:10:54.40,Default,,0,0,0,,Біреу оны тез ұстап алсын!
Dialogue: 0,0:10:54.48,0:10:56.36,Default,,0,0,0,,Гах! Қарғыс атқыр...
Dialogue: 0,0:10:56.44,0:10:57.82,Default,,0,0,0,,Маған тиіспе!
Dialogue: 0,0:10:57.90,0:11:00.61,Default,,0,0,0,,Мені өлтірсең, тозаққа барасың!
Dialogue: 0,0:11:00.70,0:11:03.12,Default,,0,0,0,,Керісінше, Құдайға шүкір
Dialogue: 0,0:11:03.62,0:11:06.08,Default,,0,0,0,,Ағаңызға айтатын кез келді.
Dialogue: 0,0:11:06.16,0:11:08.33,Default,,0,0,0,,Бұл сіздің сынақыңыз емес.
Dialogue: 0,0:11:09.91,0:11:10.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:11.62,0:11:16.34,Default,,0,0,0,,Құдай таңдаған, патша әулеті үшін өл, ағайын.
Dialogue: 0,0:11:22.89,0:11:23.89,Default,,0,0,0,,Бұл көтеріліс!
Dialogue: 0,0:11:23.97,0:11:25.64,Default,,0,0,0,,үшінның көзінше
Dialogue: 0,0:11:25.72,0:11:26.76,Default,,0,0,0,,Бұл жындар тобы!
Dialogue: 0,0:11:26.85,0:11:29.56,Default,,0,0,0,,Жеке құқықтан айыруды болдырмау мүмкін бе?
Dialogue: 0,0:11:29.64,0:11:32.52,Default,,0,0,0,,Жылы! Оның сатқындығы жалғыз уақыт емес!
Dialogue: 0,0:11:32.60,0:11:37.23,Default,,0,0,0,,Мәртебелі, беделі ең қорланған адам Мәртебелі Королева болса керек.
Dialogue: 0,0:11:37.73,0:11:39.65,Default,,0,0,0,,Ар-намысыма ұқсайтын ұсақ-түйек
Dialogue: 0,0:11:40.61,0:11:44.32,Default,,0,0,0,,Алайда, ұлы мәртебелі патшаның абыройына нұқсан келтіру
Dialogue: 0,0:11:44.82,0:11:46.37,Default,,0,0,0,,Ешкімге рұқсат етілмейді
Dialogue: 0,0:11:47.16,0:11:48.37,Default,,0,0,0,,Егер мені кешірсең, келесі жолы...
Dialogue: 0,0:11:48.45,0:11:50.41,Default,,0,0,0,,Нағыз көтеріліс орын алады!
Dialogue: 0,0:11:50.50,0:11:53.79,Default,,0,0,0,,Көтеріліс тағы бір көтеріліс тудырады.
Dialogue: 0,0:11:54.29,0:11:55.21,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:11:58.17,0:12:00.17,Default,,0,0,0,,Маған шарап беріңізші
Dialogue: 0,0:12:00.92,0:12:02.68,Default,,0,0,0,,Орындау алдында
Dialogue: 0,0:12:11.35,0:12:14.23,Default,,0,0,0,,Анам мені ешқашан кешірмейді.
Dialogue: 0,0:12:15.56,0:12:18.73,Default,,0,0,0,,Ол Джорджды ерекше жақсы көретін.
Dialogue: 0,0:12:19.23,0:12:25.49,Default,,0,0,0,,Кішкентай кезімде анам орманның бақсысы туралы ертегі айтып беретін.
Dialogue: 0,0:12:26.37,0:12:31.33,Default,,0,0,0,,Мұны естігенде ол қорқып, төсегіме кіріп кетті.
Dialogue: 0,0:12:31.83,0:12:35.50,Default,,0,0,0,,Орманда адасып қалған балалар бақсы болады дейді...
Dialogue: 0,0:12:36.75,0:12:38.59,Default,,0,0,0,,Мен бақсы болдым ба?
Dialogue: 0,0:12:39.30,0:12:42.17,Default,,0,0,0,,Оның шыншылдығы сонша, ол кез келген нәрсеге сенеді.
Dialogue: 0,0:12:42.26,0:12:46.68,Default,,0,0,0,,Құдайдың кереметі ме, шайтанның сыбыры ма...
Dialogue: 0,0:12:46.76,0:12:49.22,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:49.31,0:12:50.14,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:12:51.77,0:12:53.10,Default,,0,0,0,,Түрме күзетшісі емес.
Dialogue: 0,0:12:53.85,0:12:55.69,Default,,0,0,0,,Соңғы кешкі ас...
Dialogue: 0,0:12:56.19,0:13:00.32,Default,,0,0,0,,Түптеп келгенде, ханзаданың абыройы бос сөзден басқа ештеңе емес.
Dialogue: 0,0:13:00.82,0:13:02.61,Default,,0,0,0,,Ұйқыны жоғалтудың орнына
Dialogue: 0,0:13:02.69,0:13:05.07,Default,,0,0,0,,Маған бар болғаны уайым мен қайғы болды.
Dialogue: 0,0:13:06.61,0:13:09.33,Default,,0,0,0,,Ол кезде менде...
Dialogue: 0,0:13:11.04,0:13:14.91,Default,,0,0,0,,Мен туыстық байланыстар мәңгілік деп ойладым.
Dialogue: 0,0:13:15.71,0:13:19.84,Default,,0,0,0,,Бірақ құтқарудың бір ғана нұры бар.
Dialogue: 0,0:13:20.34,0:13:25.93,Default,,0,0,0,,Ол... Мені құтқарамын деді, тек ағамды ғана.
Dialogue: 0,0:13:27.26,0:13:29.64,Default,,0,0,0,,Джордж қабілетсіз адам болды.
Dialogue: 0,0:13:30.14,0:13:32.10,Default,,0,0,0,,Бірақ ол сүйкімді іні болатын.
Dialogue: 0,0:13:32.60,0:13:37.39,Default,,0,0,0,,Ол маған бір рет опасыздық жасады, бірақ соңында ол маған оралды.
Dialogue: 0,0:13:38.10,0:13:40.52,Default,,0,0,0,,Менің пәнім болуға ант ет...
Dialogue: 0,0:13:41.02,0:13:44.32,Default,,0,0,0,,Мен енді ағаммен төбелескім келмейді.
Dialogue: 0,0:13:44.82,0:13:47.36,Default,,0,0,0,,Бірақ жанжалдан қашып құтыла алмайсың.
Dialogue: 0,0:13:48.16,0:13:50.91,Default,,0,0,0,,Мен патша болғанша...
Dialogue: 0,0:13:53.74,0:13:55.79,Default,,0,0,0,,Ол мені құтқаруы үшін...
Dialogue: 0,0:13:56.37,0:13:58.46,Default,,0,0,0,,Қандай жанашыр адам.
Dialogue: 0,0:13:59.04,0:14:01.92,Default,,0,0,0,,Аға, қазір демалыңыз.
Dialogue: 0,0:14:02.00,0:14:04.21,Default,,0,0,0,,Жоқ... жоқ, жоқ.
Dialogue: 0,0:14:04.71,0:14:05.67,Default,,0,0,0,,Әлі де кері қайтарылған
Dialogue: 0,0:14:06.47,0:14:08.22,Default,,0,0,0,,Джорджды өлім жазасына кесу жойылды!
Dialogue: 0,0:14:08.72,0:14:11.76,Default,,0,0,0,,Иә, орындаудан бас тартайық.
Dialogue: 0,0:14:12.26,0:14:13.39,Default,,0,0,0,,Ричард…
Dialogue: 0,0:14:13.47,0:14:17.73,Default,,0,0,0,,Сіз Ричардтың бағыныштысысыз ба? Маған көмектесіңіз...
Dialogue: 0,0:14:18.31,0:14:20.31,Default,,0,0,0,,Бұл бет бір жерде...
Dialogue: 0,0:14:20.40,0:14:21.36,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:24.82,0:14:26.32,Default,,0,0,0,,(Экхарт) Кторигалга басып кірген бейбітшілікке қарсы күштер—
Dialogue: 0,0:14:28.90,0:14:29.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:32.95,0:14:36.83,Default,,0,0,0,,Уф, маған ұнамайды... Өтінемін көмектесіңізші...
Dialogue: 0,0:14:37.75,0:14:38.79,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:14:38.87,0:14:39.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:40.33,0:14:41.42,Default,,0,0,0,,Аға
Dialogue: 0,0:14:41.50,0:14:42.88,Default,,0,0,0,,Убу!
Dialogue: 0,0:14:42.96,0:14:48.38,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:52.89,0:14:55.89,Default,,0,0,0,,Зергерлік бұйымдар Алтын…
Dialogue: 0,0:14:56.47,0:14:58.06,Default,,0,0,0,,Қазір осындай нәрсе
Dialogue: 0,0:15:02.86,0:15:06.07,Default,,0,0,0,,Ах... Бұл тозақ па?
Dialogue: 0,0:15:12.07,0:15:13.24,Default,,0,0,0,,Джордж
Dialogue: 0,0:15:13.74,0:15:14.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:32.05,0:15:32.72,Default,,0,0,0,,(вазаның құлаған дыбысы)
Dialogue: 0,0:15:32.80,0:15:35.01,Default,,0,0,0,,Джордж өлді ме?
Dialogue: 0,0:15:35.51,0:15:37.56,Default,,0,0,0,,Өлім жазасын алып тастау керек еді.
Dialogue: 0,0:15:37.64,0:15:39.60,Default,,0,0,0,,Мүмкін қайғырып, өзін...
Dialogue: 0,0:15:39.68,0:15:40.18,Default,,0,0,0,,Бұл қандай да бір «Гя●ган» ба?!
Dialogue: 0,0:15:40.98,0:15:44.27,Default,,0,0,0,,Неліктен ешкім өз өмірін сұрамады?
Dialogue: 0,0:15:44.36,0:15:47.90,Default,,0,0,0,,Маған неге ескертпедің! Бауырыңды өлтірме...
Dialogue: 0,0:15:47.98,0:15:51.70,Default,,0,0,0,,Керісінше, сен мені өлім жазасына кесуге арандаттың!
Dialogue: 0,0:15:51.78,0:15:53.20,Default,,0,0,0,,үшінңыз!
Dialogue: 0,0:15:53.28,0:15:54.07,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:54.16,0:15:56.33,Default,,0,0,0,,Шық! Қазір!
Dialogue: 0,0:15:56.41,0:15:57.66,Default,,0,0,0,,Сол сөзге шебер, жалған мейірімді жігіт➡
Dialogue: 0,0:15:58.24,0:16:00.50,Default,,0,0,0,,Мәртебелі... Мәртебелі!
Dialogue: 0,0:16:00.58,0:16:01.58,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:16:03.46,0:16:06.59,Default,,0,0,0,,Бұл күлкілі! Бәріне өзіміз кінәлі дейсіз бе?
Dialogue: 0,0:16:07.21,0:16:10.26,Default,,0,0,0,,Джорджды ең жек көретін адам осы болса керек!
Dialogue: 0,0:16:10.34,0:16:11.84,Default,,0,0,0,,Іштей сергіп қалсаңыз да
Dialogue: 0,0:16:11.92,0:16:13.63,Default,,0,0,0,,Мен оны көпшілікке көрсете алмаймын.
Dialogue: 0,0:16:13.72,0:16:16.01,Default,,0,0,0,,Бұл Мәртебелі Корольді қорлау!
Dialogue: 0,0:16:16.10,0:16:18.97,Default,,0,0,0,,Мәртебелі күтпеген жағдайға тап болған сияқты.
Dialogue: 0,0:16:19.06,0:16:19.89,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:20.39,0:16:22.64,Default,,0,0,0,,Джордж ғана емес, егер...
Dialogue: 0,0:16:22.73,0:16:24.52,Default,,0,0,0,,Тіпті патша өлсе не болар еді?
Dialogue: 0,0:16:24.60,0:16:25.48,Default,,0,0,0,,Не!
Dialogue: 0,0:16:26.06,0:16:28.02,Default,,0,0,0,,Ешқандай проблема жоқ.
Dialogue: 0,0:16:28.11,0:16:32.36,Default,,0,0,0,,Заңды мұрагер бар... лайық ханзада.
Dialogue: 0,0:16:32.44,0:16:33.40,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:34.66,0:16:36.57,Default,,0,0,0,,Ханзада әлі жас
Dialogue: 0,0:16:36.66,0:16:38.53,Default,,0,0,0,,Менің ойымша, бізге регент рөлі керек.
Dialogue: 0,0:16:38.62,0:16:41.29,Default,,0,0,0,,Сіз өзіңізді лайықтымын деп айтқыңыз келе ме?
Dialogue: 0,0:16:41.37,0:16:43.25,Default,,0,0,0,,Енді Джордж қайтыс болды
Dialogue: 0,0:16:43.33,0:16:48.21,Default,,0,0,0,,Егер сіз дұрыстап ойласаңыз, регент патшаның інісі Глостер герцогы ма?
Dialogue: 0,0:16:48.29,0:16:49.55,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:16:49.63,0:16:51.55,Default,,0,0,0,,Алайда
Dialogue: 0,0:16:51.63,0:16:53.72,Default,,0,0,0,,Менің Вудвилл отбасымның құрметіне...
Dialogue: 0,0:16:53.80,0:16:55.51,Default,,0,0,0,,Ричард және біз
Dialogue: 0,0:16:55.59,0:16:58.39,Default,,0,0,0,,Мен қанымды төгіп, Ұлы мәртебелі үшін күресуді жалғастырдым.
Dialogue: 0,0:16:58.47,0:17:01.60,Default,,0,0,0,,Вудвилл отбасы Ланкастермен одақтас болғаннан бері!
Dialogue: 0,0:17:02.43,0:17:04.48,Default,,0,0,0,,Иә, Мәртебелі!
Dialogue: 0,0:17:04.56,0:17:06.35,Default,,0,0,0,,Лорд Хастингс...
Dialogue: 0,0:17:08.69,0:17:11.07,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:17:11.15,0:17:14.11,Default,,0,0,0,,Әулие Албанстағы шайқаста қаза тапты.
Dialogue: 0,0:17:14.61,0:17:17.74,Default,,0,0,0,,Күйеуінің денесін аяусыз шешіп тастаған.
Dialogue: 0,0:17:17.82,0:17:19.70,Default,,0,0,0,,Аллеяда тасталған
Dialogue: 0,0:17:20.20,0:17:23.41,Default,,0,0,0,,Осы бір естелік қалдырып...
Dialogue: 0,0:17:28.96,0:17:32.80,Default,,0,0,0,,Мен енді миссис Грейдің жесірі емеспін.
Dialogue: 0,0:17:34.17,0:17:36.47,Default,,0,0,0,,Эдвард Плантагенеттің әйелі
Dialogue: 0,0:17:36.97,0:17:38.97,Default,,0,0,0,,Англия патшайымы
Dialogue: 0,0:17:39.89,0:17:41.60,Default,,0,0,0,,Королева...
Dialogue: 0,0:17:42.22,0:17:44.18,Default,,0,0,0,,үшінңызды өтінемін, тыныш болыңыз.
Dialogue: 0,0:17:44.85,0:17:49.48,Default,,0,0,0,,Осындай күнде төбелесу – ағамның өліміне қорлық.
Dialogue: 0,0:17:50.06,0:17:54.94,Default,,0,0,0,,Бір-бірін жаулап, жек көру өлімнен де ауыр азап.
Dialogue: 0,0:17:56.53,0:17:59.66,Default,,0,0,0,,Мен енді мұндай азапқа шыдай алмаймын.
Dialogue: 0,0:18:01.37,0:18:05.20,Default,,0,0,0,,Менің ойымша, бұл аздап әдепсіз болды.
Dialogue: 0,0:18:05.70,0:18:08.21,Default,,0,0,0,,Кешіріңіз, Ричард
Dialogue: 0,0:18:13.38,0:18:16.34,Default,,0,0,0,,Бір ғана көз жасы атақты ақсүйектің үнін өшіре алады.
Dialogue: 0,0:18:16.42,0:18:17.47,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:18:18.05,0:18:20.39,Default,,0,0,0,,Бұл тіпті бақсы үшін де мүмкін емес еді
Dialogue: 0,0:18:20.89,0:18:25.31,Default,,0,0,0,,Енді бір адам ғайып болды, Тақтың екеуіңнің арасында тұрған адам.
Dialogue: 0,0:18:25.81,0:18:27.27,Default,,0,0,0,,Келесі кім?
Dialogue: 0,0:18:27.35,0:18:29.48,Default,,0,0,0,,Ханзада? Король?
Dialogue: 0,0:18:29.98,0:18:34.48,Default,,0,0,0,,Корольдік отбасына зиян келтіретін кез келген адамды жойыңыз.
Dialogue: 0,0:18:35.11,0:18:37.11,Default,,0,0,0,,Тіпті ол сіз жақсы көретін адам болса да?
Dialogue: 0,0:18:38.95,0:18:40.03,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:40.70,0:18:44.79,Default,,0,0,0,,Мен де бұл дүниеде ең жақсы көретін адамымды өлтірдім.
Dialogue: 0,0:18:46.75,0:18:48.62,Default,,0,0,0,,Біраз уақытқа аумаққа оралыңыз
Dialogue: 0,0:18:52.38,0:18:54.04,Default,,0,0,0,,Бұл шулы.
Dialogue: 0,0:18:54.59,0:18:58.09,Default,,0,0,0,,Жоғары мәртебелі, мен сізге бір кеңес беремін.
Dialogue: 0,0:18:58.59,0:19:01.93,Default,,0,0,0,,Сіздің асыл... патшаңыз туралы
Dialogue: 0,0:19:02.43,0:19:06.10,Default,,0,0,0,,Бір адам өзінің денесінің құпиялары туралы қаланы аралап жүр.
Dialogue: 0,0:19:07.47,0:19:09.43,Default,,0,0,0,,Дененің… құпиясы?
Dialogue: 0,0:19:09.52,0:19:11.81,Default,,0,0,0,,О... сен білмедің бе?
Dialogue: 0,0:19:12.65,0:19:13.86,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:14.36,0:19:16.48,Default,,0,0,0,,Өзіңіз тексерсеңіз ше?
Dialogue: 0,0:19:17.69,0:19:19.70,Default,,0,0,0,,Құпия...?
Dialogue: 0,0:19:20.53,0:19:23.24,Default,,0,0,0,,Құпиям жоқ деп сол кезде ант еттің.
Dialogue: 0,0:19:49.68,0:19:51.60,Default,,0,0,0,,Қайғылы болма
Dialogue: 0,0:19:52.10,0:19:55.15,Default,,0,0,0,,үшін менің қамытымның негізіне айналады.
Dialogue: 0,0:19:55.23,0:19:56.32,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:57.90,0:20:00.40,Default,,0,0,0,,Бұл кім? Бөлмеге рұқсатсыз кіруге болмайды...
Dialogue: 0,0:20:01.61,0:20:02.86,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:20:03.49,0:20:04.62,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:20:05.24,0:20:08.08,Default,,0,0,0,,Түсімде әкем жоғалып кетті...
Dialogue: 0,0:20:08.70,0:20:11.41,Default,,0,0,0,,Соғыс басталғанда, Әке
Dialogue: 0,0:20:11.91,0:20:15.13,Default,,0,0,0,,Әке... Уф...
Dialogue: 0,0:20:17.46,0:20:22.05,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:22.63,0:20:25.76,Default,,0,0,0,,Жаумен талай рет соғысып, жеңіске жеттім.
Dialogue: 0,0:20:25.84,0:20:28.10,Default,,0,0,0,,Мен оңай өлмеймін.
Dialogue: 0,0:20:28.85,0:20:30.18,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:30.68,0:20:33.89,Default,,0,0,0,,Ұлымның соншалықты ұялшақ болғанын қаламаймын.
Dialogue: 0,0:20:34.39,0:20:37.02,Default,,0,0,0,,Сіз қазір Солсбери графысыз.
Dialogue: 0,0:20:37.90,0:20:38.98,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:20:39.48,0:20:40.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:41.86,0:20:43.49,Default,,0,0,0,,Мені ұстағаныңды қалаймын
Dialogue: 0,0:20:45.28,0:20:47.41,Default,,0,0,0,,Өтінемін... Кешіріңіз, мен күшейемін!
Dialogue: 0,0:20:49.24,0:20:50.37,Default,,0,0,0,,Кел
Dialogue: 0,0:20:58.46,0:21:00.96,Default,,0,0,0,,Өтінемін! Мені тыңда!
Dialogue: 0,0:21:01.05,0:21:03.88,Default,,0,0,0,,Сарайда шайтан бар ма? күлкілі
Dialogue: 0,0:21:03.97,0:21:05.30,Default,,0,0,0,,Эй, бұл маңызды тақырып.
Dialogue: 0,0:21:05.38,0:21:08.18,Default,,0,0,0,,Менде сіздің адасуларыңызды тыңдауға уақытым жоқ.
Dialogue: 0,0:21:08.26,0:21:09.14,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:21:09.22,0:21:12.14,Default,,0,0,0,,Ол... шайтанның баласы еді!
Dialogue: 0,0:21:12.22,0:21:14.48,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:21:15.94,0:21:18.77,Default,,0,0,0,,Жоғары мәртебелі, сіз мұнда не істеп жүрсіз?
Dialogue: 0,0:21:19.86,0:21:21.19,Default,,0,0,0,,Сіз...
Dialogue: 0,0:21:21.94,0:21:25.74,Default,,0,0,0,,Иә, сен менің патшамның қызметшісі болдың.
Dialogue: 0,0:21:26.24,0:21:27.11,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:21:27.91,0:21:30.41,Default,,0,0,0,,Ричардтың денесінің сыры неде?
Dialogue: 0,0:21:30.49,0:21:31.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:31.70,0:21:33.33,Default,,0,0,0,,Мен мұны білдім.
Dialogue: 0,0:21:33.41,0:21:35.66,Default,,0,0,0,,Ричард неге маған айтпады?
Dialogue: 0,0:21:35.75,0:21:37.58,Default,,0,0,0,,Айт! Не жасырып тұрсың?
Dialogue: 0,0:21:39.00,0:21:39.79,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:21:41.71,0:21:45.55,Default,,0,0,0,,Ол кісіні ренжіткен адамды мен кешірмеймін.
Dialogue: 0,0:21:47.26,0:21:49.80,Default,,0,0,0,,Құрметті Ричард! Мәртебелі Король...
Dialogue: 0,0:22:01.48,0:22:03.48,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:30.95,Default,,0,0,0,,～♪
