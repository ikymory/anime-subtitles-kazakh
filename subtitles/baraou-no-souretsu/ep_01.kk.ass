Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.63,0:00:15.93,Default,,0,0,0,,Ланкастриялықтар әлі
Dialogue: 0,0:00:16.01,0:00:18.26,Default,,0,0,0,,Тақты негізсіз ұстады
Dialogue: 0,0:00:18.76,0:00:23.35,Default,,0,0,0,,Ол бір кездері сізден, Йорк үйінен алаяқтық жолмен тартып алынған.
Dialogue: 0,0:00:23.94,0:00:24.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:25.23,0:00:30.19,Default,,0,0,0,,Менің әкем опасыздық үшін өлім жазасына кесілді, ал менің Йорк отбасымның абыройы жойылды.
Dialogue: 0,0:00:30.86,0:00:31.82,Default,,0,0,0,,Йорк герцогы
Dialogue: 0,0:00:32.49,0:00:35.95,Default,,0,0,0,,Әрине сенде патшадан да асыл қан бар.
Dialogue: 0,0:00:36.45,0:00:39.87,Default,,0,0,0,,Ол тақ мұрагерлігі жағынан қазіргі патшадан асып түседі.
Dialogue: 0,0:00:42.37,0:00:45.50,Default,,0,0,0,,Уорвик Мен патша болуым керек пе?
Dialogue: 0,0:00:45.58,0:00:48.04,Default,,0,0,0,,Мына ақ раушан гүлге ант берейік
Dialogue: 0,0:00:48.54,0:00:53.34,Default,,0,0,0,,Мен сізді патша етемін, мәртебелі Ричард.
Dialogue: 0,0:00:54.55,0:00:55.59,Default,,0,0,0,,Әке...
Dialogue: 0,0:00:55.68,0:00:59.01,Default,,0,0,0,,Мен енді бұл елде үлкен дауыл қоямын.
Dialogue: 0,0:00:59.85,0:01:03.73,Default,,0,0,0,,Мен алтын сақина аламын, міндетті түрде қайтамын.
Dialogue: 0,0:01:04.23,0:01:05.94,Default,,0,0,0,,Алтын... сақина?
Dialogue: 0,0:01:06.44,0:01:08.94,Default,,0,0,0,,Бұл сақинаның ішінде жұмақ бар
Dialogue: 0,0:01:09.44,0:01:13.94,Default,,0,0,0,,Ақындар елестететін барлық қуаныш пен бақыт...
Dialogue: 0,0:01:14.03,0:01:16.82,Default,,0,0,0,,Мен де әкеммен бірге күрескім келеді.
Dialogue: 0,0:01:17.32,0:01:21.28,Default,,0,0,0,,Әй, есейсең, майдан даласында мені қолда.
Dialogue: 0,0:01:21.79,0:01:25.12,Default,,0,0,0,,Ричард... менің атымды қойған ұлы
Dialogue: 0,0:01:26.00,0:01:27.42,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:01:27.50,0:01:28.08,Default,,0,0,0,,Иә
Dialogue: 0,0:01:28.96,0:01:31.21,Default,,0,0,0,,Әке – шырағым
Dialogue: 0,0:01:31.71,0:01:35.92,Default,,0,0,0,,Мені қараңғылықтан әкем ғана құтқара алады.
Dialogue: 0,0:01:49.31,0:01:51.36,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:51.44,0:01:53.53,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:54.03,0:01:59.99,Default,,0,0,0,,Раушан эмблемасы бар патша әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:02:00.49,0:02:05.33,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:02:21.93,0:02:23.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:27.93,0:02:29.39,Default,,0,0,0,,Ричард не болды?
Dialogue: 0,0:02:29.48,0:02:30.48,Default,,0,0,0,,Бағыну?
Dialogue: 0,0:02:31.06,0:02:32.94,Default,,0,0,0,,Эдвард-нии-сан күткендей
Dialogue: 0,0:02:33.02,0:02:34.27,Default,,0,0,0,,Бауырым, тағы да...
Dialogue: 0,0:02:34.36,0:02:36.11,Default,,0,0,0,,Құрметті Ричард, енді жоқ...
Dialogue: 0,0:02:37.19,0:02:39.74,Default,,0,0,0,,Сені ренжітсең, анаң ұрсады.
Dialogue: 0,0:02:39.82,0:02:40.99,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:02:41.57,0:02:44.28,Default,,0,0,0,,Ричард, сен Кейтсбимен бірге үйге барасың.
Dialogue: 0,0:02:44.78,0:02:47.20,Default,,0,0,0,,Эдвард, үйге жарысайық.
Dialogue: 0,0:02:47.29,0:02:49.41,Default,,0,0,0,,Ал, Джордж
Dialogue: 0,0:02:49.50,0:02:51.17,Default,,0,0,0,,Ричард, кездескенше.
Dialogue: 0,0:02:51.25,0:02:52.21,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:02:52.29,0:02:54.63,Default,,0,0,0,,(жылқылардың шабысы)
Dialogue: 0,0:02:55.38,0:02:57.67,Default,,0,0,0,,Кэтсби, атты маған бер!
Dialogue: 0,0:02:58.17,0:03:02.55,Default,,0,0,0,,Құрметті Ричард, менімен жалғыз болу қауіпті.
Dialogue: 0,0:03:02.64,0:03:03.89,Default,,0,0,0,,Мен мұны істей аламын!
Dialogue: 0,0:03:05.10,0:03:09.23,Default,,0,0,0,,(жүрген аттардың дыбысы)
Dialogue: 0,0:03:12.85,0:03:15.11,Default,,0,0,0,,Мен әкеме тезірек көмектескім келеді.
Dialogue: 0,0:03:15.61,0:03:19.61,Default,,0,0,0,,Ланкастерден тағын қайтарып алу үшін ұрыс даласында бірге шайқас.
Dialogue: 0,0:03:20.11,0:03:21.40,Default,,0,0,0,,Әкемнің қолында!
Dialogue: 0,0:03:24.70,0:03:25.33,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:03:26.58,0:03:27.29,Default,,0,0,0,,Екінші бомба!
Dialogue: 0,0:03:27.99,0:03:29.12,Default,,0,0,0,,Анашым!
Dialogue: 0,0:03:29.62,0:03:32.04,Default,,0,0,0,,Орманның тереңінде бір сиқыршы бар
Dialogue: 0,0:03:32.12,0:03:35.59,Default,,0,0,0,,Сондықтан орманға жалғыз баруға болмайды.
Dialogue: 0,0:03:38.67,0:03:39.67,Default,,0,0,0,,Ана?
Dialogue: 0,0:03:42.72,0:03:45.35,Default,,0,0,0,,(аңның үруі)
Dialogue: 0,0:03:46.72,0:03:48.81,Default,,0,0,0,,Ричард (Ричард) Анасы...
Dialogue: 0,0:03:48.89,0:03:50.18,Default,,0,0,0,,Ричард Ричард
Dialogue: 0,0:03:50.27,0:03:52.02,Default,,0,0,0,,Ричард Ричард!
Dialogue: 0,0:03:52.10,0:03:54.90,Default,,0,0,0,,Шайтанның ұлы! Сізді анаңыз тастап кетті ме?
Dialogue: 0,0:03:54.98,0:03:55.73,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:03:55.81,0:03:59.15,Default,,0,0,0,,Сен дүниеге келген күні қатты дауыл ағаштарды құлатты.
Dialogue: 0,0:03:59.23,0:04:01.57,Default,,0,0,0,,Үкі қарқылдады Түнгі қарға қарқылдады
Dialogue: 0,0:04:01.65,0:04:04.24,Default,,0,0,0,,Бақытсыз күндердің келгенін хабарлау үшін
Dialogue: 0,0:04:04.32,0:04:07.58,Default,,0,0,0,,Сіздің анаңыз босану кезінде ерекше ауыртпалық көрді.
Dialogue: 0,0:04:07.66,0:04:09.54,Default,,0,0,0,,Оның үстіне мен...
Dialogue: 0,0:04:11.54,0:04:15.12,Default,,0,0,0,,Құдайдың еркіне мойынсұнбаған қанды шайтан!
Dialogue: 0,0:04:16.46,0:04:18.84,Default,,0,0,0,,Ричардқа пайғамбарлық айтайық
Dialogue: 0,0:04:18.92,0:04:22.30,Default,,0,0,0,,Көптеген қарттар ақырында балаларынан айырылады.
Dialogue: 0,0:04:22.38,0:04:26.18,Default,,0,0,0,,Көп жесір, көп жетім
Dialogue: 0,0:04:26.26,0:04:29.97,Default,,0,0,0,,Мен сенің кесіріңнен болған қатыгез өлімді жоқтаймын.
Dialogue: 0,0:04:30.52,0:04:36.15,Default,,0,0,0,,«Сен не үшін тудың?» Туған күніңе қарғыс айтасың!
Dialogue: 0,0:04:39.15,0:04:40.07,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:04:40.15,0:04:41.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:43.61,0:04:44.86,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:04:44.95,0:04:47.66,Default,,0,0,0,,Өтінемін, бұл бала әлсіз сияқты.
Dialogue: 0,0:04:49.74,0:04:51.49,Default,,0,0,0,,Ақ қабан...
Dialogue: 0,0:04:52.29,0:04:54.00,Default,,0,0,0,,Тісеуі мүмкін
Dialogue: 0,0:05:01.71,0:05:03.80,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:05:04.30,0:05:07.34,Default,,0,0,0,,Мен саған бүгін кешкі асқа қызмет етемін деп ойладым.
Dialogue: 0,0:05:07.43,0:05:08.55,Default,,0,0,0,,Екінші бомба!
Dialogue: 0,0:05:08.64,0:05:11.22,Default,,0,0,0,,Не болды? Сондай лас
Dialogue: 0,0:05:11.31,0:05:13.35,Default,,0,0,0,,Джордж балшыққа құлады.
Dialogue: 0,0:05:13.43,0:05:14.89,Default,,0,0,0,,Менің ағам итеріп жіберді!
Dialogue: 0,0:05:14.98,0:05:16.44,Default,,0,0,0,,Енді тамақ ішейік.
Dialogue: 0,0:05:16.52,0:05:17.60,Default,,0,0,0,,Оны ауыстырайық
Dialogue: 0,0:05:17.69,0:05:19.52,Default,,0,0,0,,Менің сүйкімді ханзадаларым
Dialogue: 0,0:05:20.69,0:05:22.19,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:22.78,0:05:25.65,Default,,0,0,0,,Құрметті Ричард, сіз ауырып қалдыңыз ба?
Dialogue: 0,0:05:26.15,0:05:27.99,Default,,0,0,0,,Сізге зиян тигізу мүмкін емес.
Dialogue: 0,0:05:28.49,0:05:30.99,Default,,0,0,0,,Әкем атқа мінуді үйретті.
Dialogue: 0,0:05:33.45,0:05:37.54,Default,,0,0,0,,Ағаларымнан қашан асып түсемін?
Dialogue: 0,0:05:42.75,0:05:46.01,Default,,0,0,0,,Менің қолым қашан қалыңдайды?
Dialogue: 0,0:05:47.05,0:05:50.43,Default,,0,0,0,,Мен қашан әкемдей боламын?
Dialogue: 0,0:05:52.18,0:05:56.10,Default,,0,0,0,,Мен Йорк герцогы Ричард Плантагенеттің ұлымын.
Dialogue: 0,0:05:56.60,0:05:58.14,Default,,0,0,0,,Онда мен Тэцу мен басқаларға, тіпті аздап болса да, қолдау көрсету үшін тезірек барғаным дұрыс
Dialogue: 0,0:06:02.82,0:06:04.11,Default,,0,0,0,,Йорк герцогы
Dialogue: 0,0:06:04.19,0:06:05.74,Default,,0,0,0,,Майданнан оралды
Dialogue: 0,0:06:07.15,0:06:09.70,Default,,0,0,0,,Әкемнің жеңіспен оралуы.
Dialogue: 0,0:06:10.32,0:06:12.33,Default,,0,0,0,,Қош келдіңіз, әке!
Dialogue: 0,0:06:12.83,0:06:13.87,Default,,0,0,0,,Әке
Dialogue: 0,0:06:20.83,0:06:21.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:23.54,0:06:26.09,Default,,0,0,0,,Ричард... Мен сені дұрыс түсінбедім.
Dialogue: 0,0:06:26.59,0:06:27.88,Default,,0,0,0,,Қылыш шеберлігін шыңдаңыз
Dialogue: 0,0:06:27.97,0:06:31.43,Default,,0,0,0,,Енді мен ағаларым сияқты ересек аттарды мінемін.
Dialogue: 0,0:06:31.51,0:06:34.60,Default,,0,0,0,,Көрдім, сен керемет болып кеттің.
Dialogue: 0,0:06:35.22,0:06:39.69,Default,,0,0,0,,Патшаның ұлы ретінде мен ұятқа лайық батыр болуға ант етемін.
Dialogue: 0,0:06:40.31,0:06:40.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:42.06,0:06:43.15,Default,,0,0,0,,Әке?
Dialogue: 0,0:06:43.90,0:06:46.82,Default,,0,0,0,,Шынында да, біз Ланкастерге қарсы шайқаста жеңіске жеттік.
Dialogue: 0,0:06:47.32,0:06:47.82,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:49.07,0:06:50.57,Default,,0,0,0,,Патша мені сұрады
Dialogue: 0,0:06:51.07,0:06:54.03,Default,,0,0,0,,«Осы бір ұрпақ үшін адамдарды қорғаңыз».
Dialogue: 0,0:06:54.53,0:06:57.20,Default,,0,0,0,,Петицияның күшті парламенттік ниеті бар
Dialogue: 0,0:06:57.70,0:07:00.79,Default,,0,0,0,,Мен регент ретінде қалуға мәжбүр болдым.
Dialogue: 0,0:07:01.87,0:07:04.04,Default,,0,0,0,,Мен ешқашан патша болмаймын
Dialogue: 0,0:07:04.84,0:07:07.38,Default,,0,0,0,,Қазіргі король Генри өлгенше.
Dialogue: 0,0:07:11.55,0:07:13.26,Default,,0,0,0,,Қандай ұятсыз...
Dialogue: 0,0:07:14.18,0:07:15.93,Default,,0,0,0,,Тағы бір рет шайқасайық
Dialogue: 0,0:07:16.01,0:07:19.14,Default,,0,0,0,,Тәжі әкенің басына жарасады.
Dialogue: 0,0:07:19.23,0:07:20.10,Default,,0,0,0,,Ричард…
Dialogue: 0,0:07:20.18,0:07:22.52,Default,,0,0,0,,Оны күшпен растаңыз!
Dialogue: 0,0:07:23.40,0:07:23.94,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:07:24.94,0:07:25.90,Default,,0,0,0,,Әке
Dialogue: 0,0:07:27.11,0:07:29.44,Default,,0,0,0,,«Бұл сақинаның ішінде жұмақ бар».
Dialogue: 0,0:07:29.94,0:07:33.61,Default,,0,0,0,,«Ақындар елестететін барлық қуаныш пен бақыт...»
Dialogue: 0,0:07:34.41,0:07:37.87,Default,,0,0,0,,Мұны айтқан әкем еді. Күресейік.
Dialogue: 0,0:07:38.74,0:07:42.21,Default,,0,0,0,,Бұл ақ раушан Генридің қанымен боялады.
Dialogue: 0,0:07:43.37,0:07:44.54,Default,,0,0,0,,Әке...
Dialogue: 0,0:07:48.71,0:07:49.34,Default,,0,0,0,,Мырзалар
Dialogue: 0,0:07:49.92,0:07:52.97,Default,,0,0,0,,Мен тағы да Ланкастермен қылыш айқастырамын
Dialogue: 0,0:07:53.05,0:07:57.31,Default,,0,0,0,,Бұл дауыл менің басыма алтын тәж нұрын шашқанша жарқырайды.
Dialogue: 0,0:07:57.39,0:07:58.56,Default,,0,0,0,,Ол ешқашан тоқтамайды
Dialogue: 0,0:07:59.14,0:08:02.52,Default,,0,0,0,,Қылышыңызды жылтыратып, шайқасқа дайындалыңыз.
Dialogue: 0,0:08:02.60,0:08:04.56,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:08:06.40,0:08:09.23,Default,,0,0,0,,Мен патша боламын
Dialogue: 0,0:08:09.78,0:08:12.65,Default,,0,0,0,,Иә, мен де саған көмектесемін, әке.
Dialogue: 0,0:08:13.32,0:08:16.57,Default,,0,0,0,,Жоқ... Өмірімді құрбан етуге әлі жаспын.
Dialogue: 0,0:08:16.66,0:08:19.45,Default,,0,0,0,,Дегенмен, әке, мен сізге жаттығу жасап жатырмын...
Dialogue: 0,0:08:19.54,0:08:23.25,Default,,0,0,0,,Ричард Менің атымды қалдыр, патшаның атын.
Dialogue: 0,0:08:28.50,0:08:31.63,Default,,0,0,0,,Ричард, бас тарт.
Dialogue: 0,0:08:31.71,0:08:33.72,Default,,0,0,0,,Біз әлі баламыз
Dialogue: 0,0:08:37.80,0:08:39.43,Default,,0,0,0,,Уг!?
Dialogue: 0,0:08:39.51,0:08:41.89,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:08:51.19,0:08:53.07,Default,,0,0,0,,Бұл мүмкін емес, Ричард.
Dialogue: 0,0:08:53.15,0:08:54.61,Default,,0,0,0,,Сол дене...
Dialogue: 0,0:08:56.61,0:08:57.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:02.37,0:09:03.45,Default,,0,0,0,,Қайсысы қоқыс екенін айтып бере аласыз ба?
Dialogue: 0,0:09:03.54,0:09:05.37,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:09:05.46,0:09:07.38,Default,,0,0,0,,Мен Джоан д'Аркпын
Dialogue: 0,0:09:08.75,0:09:09.63,Default,,0,0,0,,Сіз
Dialogue: 0,0:09:11.34,0:09:14.13,Default,,0,0,0,,Француз ведьмы, ақымақ болма!
Dialogue: 0,0:09:14.22,0:09:15.88,Default,,0,0,0,,Сен менікі бола алмайсың!
Dialogue: 0,0:09:15.97,0:09:17.30,Default,,0,0,0,,Ричард
Dialogue: 0,0:09:17.39,0:09:20.81,Default,,0,0,0,,Мен сен туралы бәрін білемін.
Dialogue: 0,0:09:20.89,0:09:23.98,Default,,0,0,0,,Тіпті жасырып жүрген құпияларыңыз да.
Dialogue: 0,0:09:24.06,0:09:27.19,Default,,0,0,0,,Қараңызшы, сіздің денеңіз...
Dialogue: 0,0:09:29.02,0:09:31.32,Default,,0,0,0,,Ер де, әйел де емес
Dialogue: 0,0:09:32.15,0:09:33.23,Default,,0,0,0,,(айнаның сынған дыбысы)
Dialogue: 0,0:09:33.32,0:09:34.32,Default,,0,0,0,,Құрметті Ричард!
Dialogue: 0,0:09:35.15,0:09:37.20,Default,,0,0,0,,Кешіріңіз... (Ричард) Қазір бұл не?
Dialogue: 0,0:09:37.74,0:09:41.58,Default,,0,0,0,,Мұны тек сен және әкең мен шешең ғана біледі.
Dialogue: 0,0:09:43.62,0:09:45.33,Default,,0,0,0,,Шайтанның баласы...
Dialogue: 0,0:09:45.83,0:09:47.54,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:09:48.62,0:09:49.54,Default,,0,0,0,,Құрметті Ричард...
Dialogue: 0,0:09:49.63,0:09:50.54,Default,,0,0,0,,Мынадай нәрсе!
Dialogue: 0,0:09:50.63,0:09:51.75,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:56.01,0:09:57.47,Default,,0,0,0,,Сіздің қымбат денеңіз...
Dialogue: 0,0:10:08.39,0:10:10.19,Default,,0,0,0,,Ұсқынсыз қабан
Dialogue: 0,0:10:10.69,0:10:12.86,Default,,0,0,0,,Мен сияқты...
Dialogue: 0,0:10:31.29,0:10:32.34,Default,,0,0,0,,Йорк герцогы
Dialogue: 0,0:10:32.42,0:10:34.88,Default,,0,0,0,,Ұзақ шайқастан сарбаздар қажыды.
Dialogue: 0,0:10:34.96,0:10:36.46,Default,,0,0,0,,Бір рет алып тастаңыз
Dialogue: 0,0:10:36.96,0:10:37.92,Default,,0,0,0,,Патша айтқанынан қайтпайды
Dialogue: 0,0:10:38.01,0:10:38.72,Default,,0,0,0,,Бірақ солай...
Dialogue: 0,0:10:38.80,0:10:40.63,Default,,0,0,0,,Мен Ричардқа уәде бердім.
Dialogue: 0,0:10:40.72,0:10:43.14,Default,,0,0,0,,Мен соңына дейін күресемін
Dialogue: 0,0:10:45.22,0:10:47.52,Default,,0,0,0,,Әкең қайтып келді ме?
Dialogue: 0,0:10:47.60,0:10:48.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:50.94,0:10:53.02,Default,,0,0,0,,Сіз Йорктың ұлысыз ба?
Dialogue: 0,0:10:53.11,0:10:54.73,Default,,0,0,0,,(Әйелдердің айқайы)
Dialogue: 0,0:10:57.99,0:11:00.70,Default,,0,0,0,,Ланкастердің жеңісін тойлау
Dialogue: 0,0:11:00.78,0:11:02.62,Default,,0,0,0,,Біздің король Генриге!
Dialogue: 0,0:11:02.70,0:11:04.37,Default,,0,0,0,,(Темір тордың жабылу дыбысы)
Dialogue: 0,0:11:04.45,0:11:09.08,Default,,0,0,0,,Құдай-ау... күйеуім мен баламды сақта.
Dialogue: 0,0:11:09.16,0:11:10.46,Default,,0,0,0,,Екінші бомба!
Dialogue: 0,0:11:10.54,0:11:12.92,Default,,0,0,0,,Мен сенің әкең мен ағаңның аман-есен екеніне сенімдімін.
Dialogue: 0,0:11:13.00,0:11:13.79,Default,,0,0,0,,Сәлем? Ричард
Dialogue: 0,0:11:14.75,0:11:15.38,Default,,0,0,0,,Әке...
Dialogue: 0,0:11:15.46,0:11:16.84,Default,,0,0,0,,Шайтан!
Dialogue: 0,0:11:16.92,0:11:19.97,Default,,0,0,0,,Бұл адамды тәтті сөзбен азғырғаныңыз үшін болды!
Dialogue: 0,0:11:21.34,0:11:22.43,Default,,0,0,0,,Ана?
Dialogue: 0,0:11:22.51,0:11:24.14,Default,,0,0,0,,Сіздің сол кездегі жүзіңіз...
Dialogue: 0,0:11:25.76,0:11:27.89,Default,,0,0,0,,Ол шайтанның өзі еді!
Dialogue: 0,0:11:28.89,0:11:31.10,Default,,0,0,0,,Бұл бала шайтанның баласы.
Dialogue: 0,0:11:31.19,0:11:32.44,Default,,0,0,0,,Не болды? Ана...
Dialogue: 0,0:11:32.52,0:11:34.61,Default,,0,0,0,,Джордж, сен білмейсің.
Dialogue: 0,0:11:34.69,0:11:37.53,Default,,0,0,0,,Бұл денеде шайтан бар!
Dialogue: 0,0:11:38.40,0:11:40.40,Default,,0,0,0,,(Асылдардың күлкісі)
Dialogue: 0,0:11:48.70,0:11:50.04,Default,,0,0,0,,Шайтанның ұлы!
Dialogue: 0,0:11:50.54,0:11:56.13,Default,,0,0,0,,Құдайым, күйеуімді, баламды шайтанның қолынан сақтай гөр.
Dialogue: 0,0:11:59.63,0:12:00.42,Default,,0,0,0,,Әке...
Dialogue: 0,0:12:00.51,0:12:01.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:04.89,0:12:07.56,Default,,0,0,0,,Әке... Жарайсың деп үміттенемін.
Dialogue: 0,0:12:07.64,0:12:09.22,Default,,0,0,0,,(жылжыған тастардың дыбысы)
Dialogue: 0,0:12:17.65,0:12:18.61,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:12:34.87,0:12:37.59,Default,,0,0,0,,Бұл кім? Онда не істеп жүрсің?
Dialogue: 0,0:12:48.51,0:12:50.85,Default,,0,0,0,,Мен күн сағатын жасап жатырмын.
Dialogue: 0,0:12:53.27,0:12:54.89,Default,,0,0,0,,Мынадай...
Dialogue: 0,0:12:57.98,0:13:00.23,Default,,0,0,0,,Әр минуттық өтуді бақылау
Dialogue: 0,0:13:00.32,0:13:05.07,Default,,0,0,0,,Адамның өміріне қанша жыл жетеді деп ойлаймын.
Dialogue: 0,0:13:06.03,0:13:07.62,Default,,0,0,0,,Қандай қызық жігіт.
Dialogue: 0,0:13:08.24,0:13:10.20,Default,,0,0,0,,Барлық шопандар мұны істейді.
Dialogue: 0,0:13:10.70,0:13:13.00,Default,,0,0,0,,Сіз шопансыз ба?
Dialogue: 0,0:13:14.33,0:13:15.04,Default,,0,0,0,,Мен?
Dialogue: 0,0:13:15.92,0:13:16.50,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:13:19.13,0:13:21.25,Default,,0,0,0,,Сағаттарды санап, тапсырманы орында.
Dialogue: 0,0:13:21.34,0:13:23.71,Default,,0,0,0,,Бір отар қойдың соңынан неше сағат жүреді?
Dialogue: 0,0:13:23.80,0:13:27.55,Default,,0,0,0,,Қойдың буаз болуы неше күнде болады? Аналық қой неше аптада туады?
Dialogue: 0,0:13:27.64,0:13:29.97,Default,,0,0,0,,Қырқу үшін неше жыл қажет?
Dialogue: 0,0:13:30.80,0:13:32.47,Default,,0,0,0,,Қандай қызық өмір!
Dialogue: 0,0:13:34.14,0:13:36.94,Default,,0,0,0,,Қойшы болу оңай.
Dialogue: 0,0:13:37.98,0:13:39.23,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:39.77,0:13:42.65,Default,,0,0,0,,Өйткені бұл дүниеде тек қасірет пен тілек бар
Dialogue: 0,0:13:44.40,0:13:47.36,Default,,0,0,0,,Қойшы патшадан әлдеқайда бақытты.
Dialogue: 0,0:13:47.45,0:13:49.32,Default,,0,0,0,,Ойласам, мен күлге ұқсас иісті сезбеппін
Dialogue: 0,0:13:49.41,0:13:52.12,Default,,0,0,0,,Бұл тәжде жұмақ бар!
Dialogue: 0,0:13:54.20,0:13:55.91,Default,,0,0,0,,Тәжден де артық
Dialogue: 0,0:13:56.50,0:13:59.71,Default,,0,0,0,,Мен сізді осы жерде және қазір кездестіргеніме өте қуаныштымын.
Dialogue: 0,0:14:00.84,0:14:02.75,Default,,0,0,0,,Эй, мұнда кел.
Dialogue: 0,0:14:11.43,0:14:12.51,Default,,0,0,0,,Эй!
Dialogue: 0,0:14:14.39,0:14:16.85,Default,,0,0,0,,Мұнда шатыр астынан айырмашылығы,
Dialogue: 0,0:14:16.93,0:14:19.14,Default,,0,0,0,,Мен қорқынышты түс көрмейді
Dialogue: 0,0:14:20.19,0:14:22.31,Default,,0,0,0,,Сіз қорқынышты түс көресіз бе?
Dialogue: 0,0:14:24.11,0:14:26.69,Default,,0,0,0,,Қорқынышты түс...
Dialogue: 0,0:14:27.74,0:14:31.07,Default,,0,0,0,,Мен анамның тастап кеткенін жиі армандаймын.
Dialogue: 0,0:14:33.78,0:14:35.16,Default,,0,0,0,,Бірақ соңында
Dialogue: 0,0:14:35.66,0:14:40.17,Default,,0,0,0,,Алла саған міндетті түрде нұрлы қолын созады.
Dialogue: 0,0:14:45.05,0:14:46.05,Default,,0,0,0,,Жарық…
Dialogue: 0,0:14:46.67,0:14:49.17,Default,,0,0,0,,«Мен не үшін дүниеге келдім?»
Dialogue: 0,0:14:49.26,0:14:52.39,Default,,0,0,0,,Туған күніңді қарғаймын!
Dialogue: 0,0:14:59.06,0:15:00.19,Default,,0,0,0,,Әке...
Dialogue: 0,0:15:01.52,0:15:04.27,Default,,0,0,0,,Менің нұрым Құдай емес
Dialogue: 0,0:15:06.90,0:15:09.99,Default,,0,0,0,,Шынында да, егер мен осындай жерде ұйықтасам,
Dialogue: 0,0:15:10.07,0:15:12.49,Default,,0,0,0,,Сен өлгенде Құдай саған келеді.
Dialogue: 0,0:15:12.99,0:15:14.70,Default,,0,0,0,,Бұл да жақсы болуы мүмкін.
Dialogue: 0,0:15:15.20,0:15:17.91,Default,,0,0,0,,Өлім біреуді құтқарса
Dialogue: 0,0:15:18.41,0:15:22.71,Default,,0,0,0,,Бір қойшы өлсе, оның дүниеге әсері қандай?
Dialogue: 0,0:15:23.21,0:15:23.92,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:15:25.71,0:15:29.13,Default,,0,0,0,,Ахахха мен сені жақсы көремін
Dialogue: 0,0:15:29.21,0:15:31.97,Default,,0,0,0,,Иә, мен жай ғана қойшымын.
Dialogue: 0,0:15:32.05,0:15:36.72,Default,,0,0,0,,Ақырында сен де басқалар сияқты Құдайға шақырыласың.
Dialogue: 0,0:15:39.73,0:15:42.06,Default,,0,0,0,,Мен... өлгім келмейді
Dialogue: 0,0:15:42.56,0:15:45.11,Default,,0,0,0,,Өлсем де, көкке кірмейтін шығармын.
Dialogue: 0,0:15:45.90,0:15:46.77,Default,,0,0,0,,Өйткені мен...
Dialogue: 0,0:15:48.23,0:15:49.49,Default,,0,0,0,,Өйткені мен шайтанның баласымын
Dialogue: 0,0:15:56.37,0:15:59.66,Default,,0,0,0,,Сондықтан анам да мені жақсы көрмейді.
Dialogue: 0,0:16:06.04,0:16:07.84,Default,,0,0,0,,Сен үшін дұға етейік
Dialogue: 0,0:16:08.34,0:16:10.21,Default,,0,0,0,,Маған атыңызды айта аласыз ба?
Dialogue: 0,0:16:12.34,0:16:13.47,Default,,0,0,0,,Ричард
Dialogue: 0,0:16:17.55,0:16:19.18,Default,,0,0,0,,Менің атым Генри
Dialogue: 0,0:16:19.68,0:16:23.27,Default,,0,0,0,,Ричард, сен менің досым боласың ба?
Dialogue: 0,0:16:24.02,0:16:24.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:25.94,0:16:28.02,Default,,0,0,0,,Ал енді осында мәңгі қалайық
Dialogue: 0,0:16:29.90,0:16:32.24,Default,,0,0,0,,Тоңып қалмайтыныңызға сенімдімін
Dialogue: 0,0:16:33.07,0:16:34.70,Default,,0,0,0,,Бір-бірімізді құшақтайтын болсақ
Dialogue: 0,0:16:36.24,0:16:38.58,Default,,0,0,0,,Сіз тағы да сол түрмеге қайтасыз ба?
Dialogue: 0,0:16:38.66,0:16:40.87,Default,,0,0,0,,Кедей Ричард
Dialogue: 0,0:16:41.37,0:16:44.29,Default,,0,0,0,,Сізді жақсы көретін ешкім жоқ
Dialogue: 0,0:16:44.96,0:16:49.50,Default,,0,0,0,,Қай түрмеде болсаң да, Әке саған нұрын жаусын.
Dialogue: 0,0:16:50.13,0:16:53.97,Default,,0,0,0,,Оған дейін менің міндетім - Анамды қорғау.
Dialogue: 0,0:17:00.01,0:17:01.22,Default,,0,0,0,,Генри
Dialogue: 0,0:17:02.14,0:17:04.48,Default,,0,0,0,,Бұл есімді мен айтқанды да ұнатпаймын.
Dialogue: 0,0:17:05.19,0:17:07.19,Default,,0,0,0,,Ей, оян.
Dialogue: 0,0:17:07.98,0:17:09.98,Default,,0,0,0,,Мен сені күттім, Ричард.
Dialogue: 0,0:17:10.07,0:17:12.28,Default,,0,0,0,,Сізге керемет көрінеді, солай емес пе?
Dialogue: 0,0:17:12.36,0:17:15.57,Default,,0,0,0,,Иттердің қорқытып өлтіргені Аюға ұқсайды
Dialogue: 0,0:17:15.65,0:17:18.45,Default,,0,0,0,,Бұл жағдайда сіз итсіз бе?
Dialogue: 0,0:17:18.53,0:17:22.75,Default,,0,0,0,,Ол сені ойнақылап тістеп алған шығар, бірақ алдыңғы бір аяғымен құйрығын бірден қайырып алды.
Dialogue: 0,0:17:22.83,0:17:23.83,Default,,0,0,0,,Айқайлау...
Dialogue: 0,0:17:23.91,0:17:26.33,Default,,0,0,0,,Алып кетпе, арам шайтан.
Dialogue: 0,0:17:27.58,0:17:29.75,Default,,0,0,0,,Сіздің денеңіздің құпиялары бар
Dialogue: 0,0:17:29.84,0:17:32.25,Default,,0,0,0,,Анаңның айтқаны емес пе?
Dialogue: 0,0:17:32.34,0:17:33.84,Default,,0,0,0,,Мен оны түрме бастығынан естідім.
Dialogue: 0,0:17:34.51,0:17:36.68,Default,,0,0,0,,Шайтанның құйрығы өсе ме?
Dialogue: 0,0:17:36.76,0:17:40.39,Default,,0,0,0,,Әлде аңның денесі ішіне тығылған ба?
Dialogue: 0,0:17:41.22,0:17:42.68,Default,,0,0,0,,«Мен кеттім» қалай?
Dialogue: 0,0:17:48.73,0:17:49.69,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:17:50.61,0:17:51.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:52.32,0:17:53.61,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:55.53,0:17:57.78,Default,,0,0,0,,Жәй ғана ақымақ сөздер айтпа
Dialogue: 0,0:17:57.86,0:18:00.74,Default,,0,0,0,,Әкеңнің тақуалығынан кішкене үлгі ал.
Dialogue: 0,0:18:00.82,0:18:02.95,Default,,0,0,0,,Біз көкте кешкі ас ішеміз, солай ма?
Dialogue: 0,0:18:03.04,0:18:06.00,Default,,0,0,0,,Ей, қойшы... шіркін шайтан.
Dialogue: 0,0:18:06.08,0:18:09.00,Default,,0,0,0,,Өте қатыгездік дәлел!
Dialogue: 0,0:18:09.08,0:18:10.88,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:10.96,0:18:12.34,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:18:21.85,0:18:25.10,Default,,0,0,0,,Ол... әйел болды ма?
Dialogue: 0,0:18:26.06,0:18:27.68,Default,,0,0,0,,Тезірек, Йорк келеді!
Dialogue: 0,0:18:27.77,0:18:29.44,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:18:29.52,0:18:30.81,Default,,0,0,0,,Гах...
Dialogue: 0,0:18:32.06,0:18:32.77,Default,,0,0,0,,Ричард!
Dialogue: 0,0:18:32.86,0:18:34.48,Default,,0,0,0,,Эдвард аға!
Dialogue: 0,0:18:34.57,0:18:36.36,Default,,0,0,0,,Аға, ана...
Dialogue: 0,0:18:36.44,0:18:38.86,Default,,0,0,0,,Уайымдама, біз екеуіңді ертерек құтқардық.
Dialogue: 0,0:18:38.95,0:18:41.11,Default,,0,0,0,,Лондонды біздің әскерлер басып алды.
Dialogue: 0,0:18:41.20,0:18:43.08,Default,,0,0,0,,Біз Генриді тұтқынға алдық.
Dialogue: 0,0:18:43.74,0:18:45.45,Default,,0,0,0,,Біздің жеңісіміз!
Dialogue: 0,0:18:46.75,0:18:48.50,Default,,0,0,0,,Ланкастерлік Генри
Dialogue: 0,0:18:50.96,0:18:52.71,Default,,0,0,0,,Йорк герцогінің тағына
Dialogue: 0,0:18:53.34,0:18:57.38,Default,,0,0,0,,Генри, тақты Йорк палатасы алады.
Dialogue: 0,0:18:57.88,0:19:01.47,Default,,0,0,0,,Енді бұл елдің жерін қанға бояудың қажеті жоқ.
Dialogue: 0,0:19:04.35,0:19:06.18,Default,,0,0,0,,Йорк герцогы аман болсын!
Dialogue: 0,0:19:06.77,0:19:10.10,Default,,0,0,0,,Эдвард, сен менің әкем үшін көп жұмыс істедің.
Dialogue: 0,0:19:10.60,0:19:12.77,Default,,0,0,0,,Мен сені мақтан тұтамын
Dialogue: 0,0:19:13.27,0:19:14.57,Default,,0,0,0,,Бұл тамаша болды.
Dialogue: 0,0:19:15.36,0:19:18.74,Default,,0,0,0,,Менің мұрагерім болуға лайықты ешкім жоқ.
Dialogue: 0,0:19:19.24,0:19:20.74,Default,,0,0,0,,Мен ең жақсы емеспін...
Dialogue: 0,0:19:20.82,0:19:24.16,Default,,0,0,0,,Бұл сіздің уақытыңыз басталған сияқты.
Dialogue: 0,0:19:24.24,0:19:28.20,Default,,0,0,0,,Жоқ, Генри тірі болғанша әлі патша емес.
Dialogue: 0,0:19:28.29,0:19:29.75,Default,,0,0,0,,Олай болса, әке.
Dialogue: 0,0:19:31.37,0:19:33.96,Default,,0,0,0,,Біз қазір Генриді өлтіруіміз керек.
Dialogue: 0,0:19:34.59,0:19:36.21,Default,,0,0,0,,Күте тұрыңыз, Ричард.
Dialogue: 0,0:19:36.30,0:19:38.34,Default,,0,0,0,,Генри әлі де пайдалы.
Dialogue: 0,0:19:38.84,0:19:41.13,Default,,0,0,0,,Парламент Йорк герцогы тағын танығанға дейін.
Dialogue: 0,0:19:41.22,0:19:42.80,Default,,0,0,0,,Сақтықпен әрекет ету керек.
Dialogue: 0,0:19:43.43,0:19:45.80,Default,,0,0,0,,Біріншіден, бұл мерекені тамашалауға қалай болады?
Dialogue: 0,0:19:46.60,0:19:48.10,Default,,0,0,0,,Менің қыздарым
Dialogue: 0,0:19:48.18,0:19:50.31,Default,,0,0,0,,Мен ханзадалармен билегім келетіндіктен қобалжыдым.
Dialogue: 0,0:19:51.39,0:19:52.44,Default,,0,0,0,,Сол бір кездей…
Dialogue: 0,0:19:54.90,0:19:56.73,Default,,0,0,0,,Уау, мен билегім келеді.
Dialogue: 0,0:19:56.82,0:19:57.73,Default,,0,0,0,,Бірде-бір сөз ...
Dialogue: 0,0:19:59.36,0:20:00.69,Default,,0,0,0,,Мен қалысамын.
Dialogue: 0,0:20:01.40,0:20:02.78,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:20:04.99,0:20:06.16,Default,,0,0,0,,Мен билеуге жарамсызмын
Dialogue: 0,0:20:07.41,0:20:11.04,Default,,0,0,0,,Мм... Негізі мен де билей алмаймын.
Dialogue: 0,0:20:11.12,0:20:14.08,Default,,0,0,0,,Егер мен билеуді үйренуге уақыт болса, мен қылыш шеберлігімді жетілдіргім келеді.
Dialogue: 0,0:20:14.17,0:20:15.67,Default,,0,0,0,,Маған да ұнайды!
Dialogue: 0,0:20:15.75,0:20:17.17,Default,,0,0,0,,Бұл рас па? Ах...
Dialogue: 0,0:20:19.50,0:20:20.63,Default,,0,0,0,,Қандай қызық әйел.
Dialogue: 0,0:20:20.71,0:20:24.01,Default,,0,0,0,,А... сен де біртүрлі екенсің.
Dialogue: 0,0:20:24.51,0:20:26.22,Default,,0,0,0,,Сіз...
Dialogue: 0,0:20:27.18,0:20:29.35,Default,,0,0,0,,Менің басқа адамдардан ерекшелігім неде?
Dialogue: 0,0:20:32.06,0:20:33.69,Default,,0,0,0,,Мені қате түсінбе, Ричард.
Dialogue: 0,0:20:34.69,0:20:37.31,Default,,0,0,0,,Сіз ешкімге ұқсамайсыз
Dialogue: 0,0:20:39.86,0:20:40.78,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:41.69,0:20:43.24,Default,,0,0,0,,Сіз басқасыз!
Dialogue: 0,0:20:43.32,0:20:44.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:44.82,0:20:46.62,Default,,0,0,0,,Сіз жалғызсыз
Dialogue: 0,0:20:47.62,0:20:49.16,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:20:49.24,0:20:50.54,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:51.04,0:20:55.46,Default,,0,0,0,,Тіпті Эдвардтың өзі ұрыс даласында маған сәйкес келмеуі мүмкін.
Dialogue: 0,0:20:55.54,0:20:56.42,Default,,0,0,0,,Ричардқа
Dialogue: 0,0:20:56.50,0:20:58.09,Default,,0,0,0,,Әке...
Dialogue: 0,0:20:58.17,0:21:00.80,Default,,0,0,0,,Мен сенің дауысыңды майдан даласында естідім.
Dialogue: 0,0:21:01.30,0:21:03.97,Default,,0,0,0,,«Патша күреседі»
Dialogue: 0,0:21:04.93,0:21:09.05,Default,,0,0,0,,Сол сәтте мен сенімен ерекше байланысты сезіндім.
Dialogue: 0,0:21:09.76,0:21:10.89,Default,,0,0,0,,Ричард
Dialogue: 0,0:21:10.97,0:21:11.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:12.89,0:21:16.77,Default,,0,0,0,,Әкем бұдан былай майдан даласында шегінбеймін деп ант береді.
Dialogue: 0,0:21:18.27,0:21:19.69,Default,,0,0,0,,Мен де ант етемін
Dialogue: 0,0:21:20.19,0:21:24.82,Default,,0,0,0,,Мен міндетті түрде... Мен міндетті түрде Генридің мойнын қолыммен аламын.
Dialogue: 0,0:21:26.86,0:21:29.70,Default,,0,0,0,,Мен енді патша емеспін
Dialogue: 0,0:21:30.45,0:21:32.24,Default,,0,0,0,,Жай ғана қойшы
Dialogue: 0,0:21:33.37,0:21:36.62,Default,,0,0,0,,Мен сенімен танысқым келеді...Ричард
Dialogue: 0,0:21:43.80,0:21:47.72,Default,,0,0,0,,Әке, сізді патша ету үшін
Dialogue: 0,0:21:48.22,0:21:50.55,Default,,0,0,0,,Мен тіпті құдайды да өлтіремін
Dialogue: 0,0:22:01.48,0:22:03.48,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:30.95,Default,,0,0,0,,～♪
