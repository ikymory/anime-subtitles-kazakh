Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.29,0:00:03.37,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:00:03.46,0:00:06.25,Default,,0,0,0,,Сіз Мәртебелі Патшаға дәл ұқсайсыз.
Dialogue: 0,0:00:06.33,0:00:08.96,Default,,0,0,0,,Ол өте сүйкімді ханшайым.
Dialogue: 0,0:00:10.21,0:00:11.46,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:00:12.59,0:00:15.68,Default,,0,0,0,,Әйел... Келесісі міндетті түрде ханзада болады.
Dialogue: 0,0:00:15.76,0:00:18.97,Default,,0,0,0,,Мұрагер дүниеге келсе, Джордж-самаға орын болмайды.
Dialogue: 0,0:00:19.56,0:00:21.43,Default,,0,0,0,,Уорвик графына ұқсастық.
Dialogue: 0,0:00:22.48,0:00:23.14,Default,,0,0,0,,Неге!
Dialogue: 0,0:00:23.23,0:00:26.60,Default,,0,0,0,,Неліктен Изабел екеуміз үйленбеуіміз керек?
Dialogue: 0,0:00:26.69,0:00:28.61,Default,,0,0,0,,Уорвик екеуің жақын бола берсін.
Dialogue: 0,0:00:28.69,0:00:30.48,Default,,0,0,0,,Өзін жайсыз сезінетін адамдар бар.
Dialogue: 0,0:00:31.07,0:00:32.69,Default,,0,0,0,,Кім мұндайды жасайды...
Dialogue: 0,0:00:33.19,0:00:33.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:35.07,0:00:37.24,Default,,0,0,0,,Ол әйелдің даналығы ма?
Dialogue: 0,0:00:44.50,0:00:46.54,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:00:46.62,0:00:48.67,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:00:49.17,0:00:55.18,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:00:55.68,0:01:00.51,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:01:04.48,0:01:06.48,Default,,0,0,0,,♪～
Dialogue: 0,0:02:30.35,0:02:32.36,Default,,0,0,0,,～♪
Dialogue: 0,0:02:35.19,0:02:37.94,Default,,0,0,0,,Жоғары қарашы, Маргарет.
Dialogue: 0,0:02:39.74,0:02:42.74,Default,,0,0,0,,Эдвард тәкаппар және өршіл адам.
Dialogue: 0,0:02:42.82,0:02:46.54,Default,,0,0,0,,Мен қазір Англияның заңды королі екенімді мәлімдеймін.
Dialogue: 0,0:02:47.25,0:02:48.79,Default,,0,0,0,,Бірақ нағыз патша...
Dialogue: 0,0:02:48.87,0:02:52.08,Default,,0,0,0,,А... менің әкем, нағыз патша.
Dialogue: 0,0:02:52.17,0:02:56.17,Default,,0,0,0,,Әкемді тезірек тауып алсам ғой...
Dialogue: 0,0:02:58.34,0:03:01.59,Default,,0,0,0,,Неге... Неге әкең Ричардпен бірге?
Dialogue: 0,0:03:02.80,0:03:06.72,Default,,0,0,0,,Менен тек тақты ғана емес, бәрін тартып алмақсың ба?
Dialogue: 0,0:03:12.31,0:03:13.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:14.69,0:03:17.86,Default,,0,0,0,,Бірақ Генри король әлі тірі.
Dialogue: 0,0:03:17.94,0:03:20.15,Default,,0,0,0,,Уақыт өте маңызды.
Dialogue: 0,0:03:20.24,0:03:22.36,Default,,0,0,0,,Осы уақыт ішінде жау күшейе береді...
Dialogue: 0,0:03:22.45,0:03:24.91,Default,,0,0,0,,А, біз жеткен сияқтымыз.
Dialogue: 0,0:03:24.99,0:03:25.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:29.12,0:03:30.50,Default,,0,0,0,,Мені есіңде бар ғой, иә?
Dialogue: 0,0:03:31.62,0:03:32.79,Default,,0,0,0,,Сіз!
Dialogue: 0,0:03:33.29,0:03:35.67,Default,,0,0,0,,ұятсыз Йорк таныс!
Dialogue: 0,0:03:38.46,0:03:39.09,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:03:41.05,0:03:44.01,Default,,0,0,0,,Мәртебелі құрметті патшайым
Dialogue: 0,0:03:45.39,0:03:46.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:46.35,0:03:48.85,Default,,0,0,0,,Қылышыңды таста, ханзада.
Dialogue: 0,0:03:48.93,0:03:52.06,Default,,0,0,0,,Ол сенің құтқарушың
Dialogue: 0,0:03:53.73,0:03:57.36,Default,,0,0,0,,Уорвик... біздің құтқарушымыз?
Dialogue: 0,0:03:58.69,0:03:59.48,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:03:59.98,0:04:03.11,Default,,0,0,0,,Өткен реніштеріңізді ұмытыңыз.
Dialogue: 0,0:04:05.74,0:04:11.20,Default,,0,0,0,,Сатқын Эдвардтың кесірінен намысымнан айырылғандардың бірімін.
Dialogue: 0,0:04:12.08,0:04:14.92,Default,,0,0,0,,Бұдан былай мен сенің адал қызметшің боламын.
Dialogue: 0,0:04:15.42,0:04:17.75,Default,,0,0,0,,Король Генри өзінің лайықты орнына қайта оралды
Dialogue: 0,0:04:17.84,0:04:21.01,Default,,0,0,0,,Мен оны сізге қайтарғым келеді.
Dialogue: 0,0:04:21.63,0:04:25.55,Default,,0,0,0,,Тәңірдей сөйлейді.
Dialogue: 0,0:04:26.97,0:04:27.93,Default,,0,0,0,,Мәртебелі…
Dialogue: 0,0:04:31.31,0:04:33.23,Default,,0,0,0,,Мен қуаныштымын, Уорвик.
Dialogue: 0,0:04:33.73,0:04:39.23,Default,,0,0,0,,Осы сөздермен менің бар ренішім махаббатқа айналды.
Dialogue: 0,0:04:39.94,0:04:41.44,Default,,0,0,0,,Мен және сен
Dialogue: 0,0:04:41.94,0:04:45.99,Default,,0,0,0,,Егер мен Францияның Мәртебелі Королінің көмегіне жүгінсем.
Dialogue: 0,0:04:46.07,0:04:50.41,Default,,0,0,0,,Біз жалған патшаны тез арада тақтан тайдырамыз.
Dialogue: 0,0:04:50.49,0:04:51.74,Default,,0,0,0,,Ана…
Dialogue: 0,0:04:51.83,0:04:55.71,Default,,0,0,0,,Дегенмен, сіздің сөздеріңіз жалған емес.
Dialogue: 0,0:04:55.79,0:04:58.00,Default,,0,0,0,,Егер сізде кепілдік болса
Dialogue: 0,0:04:58.50,0:04:59.34,Default,,0,0,0,,Кепілдік?
Dialogue: 0,0:05:00.92,0:05:03.21,Default,,0,0,0,,Менің қалағаным сенің...
Dialogue: 0,0:05:03.97,0:05:04.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:06.26,0:05:07.34,Default,,0,0,0,,Махаббат
Dialogue: 0,0:05:08.51,0:05:13.98,Default,,0,0,0,,Осының дәлелі ретінде үлкен қызыңыз Аннаны менің ханзаданың әйелі ретінде көрсетіңіз.
Dialogue: 0,0:05:14.06,0:05:15.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:15.73,0:05:16.69,Default,,0,0,0,,(құлаған қылыштың дыбысы)
Dialogue: 0,0:05:25.19,0:05:26.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:27.20,0:05:29.20,Default,,0,0,0,,Жоғары мәртебелі ханзада Эдвард
Dialogue: 0,0:05:29.91,0:05:32.20,Default,,0,0,0,,Йорк ұлдары қалай?
Dialogue: 0,0:05:32.79,0:05:35.66,Default,,0,0,0,,Мысалы... Ричард.
Dialogue: 0,0:05:35.75,0:05:39.92,Default,,0,0,0,,Бұл Ричард болса, ол қазір менің сарайымда тұрады.
Dialogue: 0,0:05:40.42,0:05:42.13,Default,,0,0,0,,Менің қызым да
Dialogue: 0,0:05:42.21,0:05:44.34,Default,,0,0,0,,Түсіндім! Сіздің сарайыңызда ...
Dialogue: 0,0:05:45.47,0:05:46.67,Default,,0,0,0,,Уорвиктің қызымен
Dialogue: 0,0:05:46.76,0:05:48.30,Default,,0,0,0,,Мен үйленгім келмейді
Dialogue: 0,0:05:49.01,0:05:51.26,Default,,0,0,0,,Бірақ анам мені кешіруі керек...
Dialogue: 0,0:05:51.93,0:05:54.97,Default,,0,0,0,,Сонда да үйленбей тұрып бір көргеннен танысқым келеді.
Dialogue: 0,0:05:56.27,0:05:57.27,Default,,0,0,0,,Ричардқа...
Dialogue: 0,0:05:58.39,0:05:59.40,Default,,0,0,0,,Уорвик
Dialogue: 0,0:05:59.98,0:06:03.23,Default,,0,0,0,,Өтінемін, мені Англияға апарыңыз.
Dialogue: 0,0:06:12.37,0:06:13.12,Default,,0,0,0,,Ричард
Dialogue: 0,0:06:14.95,0:06:17.46,Default,,0,0,0,,Ричард Мен сені кездестірдім!
Dialogue: 0,0:06:17.96,0:06:19.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:20.12,0:06:21.21,Default,,0,0,0,,Ричард?
Dialogue: 0,0:06:21.29,0:06:23.80,Default,,0,0,0,,Сенің де кететініңе сенімдімін.
Dialogue: 0,0:06:24.30,0:06:25.92,Default,,0,0,0,,Шынайы мені білсең
Dialogue: 0,0:06:26.01,0:06:30.22,Default,,0,0,0,,Бұл дұрыс емес. Мен әрқашан сенімен бірге болдым ...
Dialogue: 0,0:06:30.72,0:06:32.18,Default,,0,0,0,,Құрметті Ричард!
Dialogue: 0,0:06:32.26,0:06:32.97,Default,,0,0,0,,Анна…
Dialogue: 0,0:06:33.05,0:06:37.23,Default,,0,0,0,,Құрметті Ричард, мен ұзақ уақыт бойы ауырдым.
Dialogue: 0,0:06:37.85,0:06:39.60,Default,,0,0,0,,Сізге ұнайтын болып көріну
Dialogue: 0,0:06:39.69,0:06:40.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:41.52,0:06:43.56,Default,,0,0,0,,Өйткені бұл шын мәнінде менмін...
Dialogue: 0,0:06:44.23,0:06:47.90,Default,,0,0,0,,Мен сені жек көремін!
Dialogue: 0,0:06:51.32,0:06:52.20,Default,,0,0,0,,Ричард!
Dialogue: 0,0:06:52.87,0:06:55.20,Default,,0,0,0,,Келме... Келме.
Dialogue: 0,0:06:55.28,0:06:56.41,Default,,0,0,0,,Енді жоқ...
Dialogue: 0,0:07:00.71,0:07:02.63,Default,,0,0,0,,Ричард!
Dialogue: 0,0:07:11.05,0:07:12.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:16.68,0:07:18.52,Default,,0,0,0,,Мұнда ешкім жоқ
Dialogue: 0,0:07:19.02,0:07:23.56,Default,,0,0,0,,Сізді ренжіткендер және сізді жақсы көретіндер
Dialogue: 0,0:07:25.11,0:07:28.65,Default,,0,0,0,,Бұл сіздің патша сарайыңыз.
Dialogue: 0,0:07:34.24,0:07:37.66,Default,,0,0,0,,Әке, не болды? кенеттен
Dialogue: 0,0:07:38.24,0:07:39.41,Default,,0,0,0,,Аннаға не болды?
Dialogue: 0,0:07:39.50,0:07:41.08,Default,,0,0,0,,Сіздің әпкеңіз...
Dialogue: 0,0:07:41.87,0:07:43.04,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:07:43.54,0:07:47.63,Default,,0,0,0,,Қонақ бөлмеңізде күтіңіз. Мен Аннаны бірден әкелемін.
Dialogue: 0,0:07:47.71,0:07:50.67,Default,,0,0,0,,Аа, оны баяу қабылдаған дұрыс.
Dialogue: 0,0:07:52.38,0:07:55.85,Default,,0,0,0,,Мен де сенің әпкең мен Ричардтың арасына түсе алдым.
Dialogue: 0,0:07:55.93,0:07:58.56,Default,,0,0,0,,Мен оған қамқорлық жасауға тырысамын, бірақ...
Dialogue: 0,0:07:59.06,0:08:00.56,Default,,0,0,0,,Бұл туралы жеткілікті.
Dialogue: 0,0:08:00.64,0:08:01.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:02.14,0:08:05.15,Default,,0,0,0,,Мен сені Францияға апаруды шештім.
Dialogue: 0,0:08:05.23,0:08:06.31,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:08:06.40,0:08:07.06,Default,,0,0,0,,(сынған сабақтың дыбысы)
Dialogue: 0,0:08:09.28,0:08:11.07,Default,,0,0,0,,Джордж да бірге жүреді.
Dialogue: 0,0:08:19.16,0:08:22.46,Default,,0,0,0,,Соңында... сіз бастайсыз.
Dialogue: 0,0:08:24.62,0:08:27.08,Default,,0,0,0,,Қайда... дәл қайда?
Dialogue: 0,0:08:27.17,0:08:28.34,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:08:28.42,0:08:29.09,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:29.17,0:08:30.59,Default,,0,0,0,,Ричард!
Dialogue: 0,0:08:31.09,0:08:32.72,Default,,0,0,0,,Сіз бұл сарайдан емессіз.
Dialogue: 0,0:08:32.80,0:08:36.97,Default,,0,0,0,,Ал... Мен мұнда Уорвикпен жаңа ғана келдім.
Dialogue: 0,0:08:37.47,0:08:39.93,Default,,0,0,0,,Серуендеп жүріп, бөлініп кеттік.
Dialogue: 0,0:08:40.89,0:08:43.60,Default,,0,0,0,,Есіңде ме? Ричард
Dialogue: 0,0:08:44.85,0:08:49.27,Default,,0,0,0,,Мен бұл еріндерден сүйдім...
Dialogue: 0,0:08:49.82,0:08:52.19,Default,,0,0,0,,Құрметті Ричард! (Ричард) Энн...
Dialogue: 0,0:08:52.28,0:08:54.24,Default,,0,0,0,,Мына қыз?
Dialogue: 0,0:08:54.78,0:08:58.91,Default,,0,0,0,,Өткен күні мен орманда жапон құлпынайлары көп жер таптым.
Dialogue: 0,0:09:00.66,0:09:02.37,Default,,0,0,0,,Менімен бірге барғыңыз келе ме?
Dialogue: 0,0:09:02.45,0:09:04.75,Default,,0,0,0,,Екеуміз тағы атқа міндік...
Dialogue: 0,0:09:04.83,0:09:05.33,Default,,0,0,0,,(Туған туыс) Олай деуге болады, бірақ (Туған туыс) бұл маңызды мәселе.
Dialogue: 0,0:09:06.42,0:09:11.09,Default,,0,0,0,,Енді өзіңізді итермелеудің қажеті жоқ. Мен сені босатамын.
Dialogue: 0,0:09:14.51,0:09:16.97,Default,,0,0,0,,Біреу рұқсатсыз шығып кетсе, маған ұнамас еді.
Dialogue: 0,0:09:20.85,0:09:24.93,Default,,0,0,0,,Уорвик I корольге ораламын.
Dialogue: 0,0:09:25.81,0:09:26.94,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:27.02,0:09:29.86,Default,,0,0,0,,«Бақытсыз» - біртүрлі жауап.
Dialogue: 0,0:09:30.36,0:09:34.99,Default,,0,0,0,,Рахмет. Мұның бәрі сіздің біліміңіздің арқасында.
Dialogue: 0,0:09:37.45,0:09:41.20,Default,,0,0,0,,Ешқашан өз сезімдеріме ерік берме.
Dialogue: 0,0:09:41.28,0:09:43.45,Default,,0,0,0,,Өз ұстанымыңызды ешқашан ұмытпаңыз
Dialogue: 0,0:09:43.95,0:09:46.12,Default,,0,0,0,,Иә... енді ешқашан
Dialogue: 0,0:09:50.04,0:09:51.17,Default,,0,0,0,,Ричардты неге тоқтатпайсың!
Dialogue: 0,0:09:53.00,0:09:57.68,Default,,0,0,0,,Ол байланған қазықты анаң ұрлап кеткен.
Dialogue: 0,0:09:57.76,0:10:01.18,Default,,0,0,0,,Қада... Сіз Энн туралы айтып отырсыз ба?
Dialogue: 0,0:10:02.05,0:10:03.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:03.81,0:10:07.81,Default,,0,0,0,,Бірақ сіздің қызыңыз Ричардқа қызығушылық танытқан сияқты.
Dialogue: 0,0:10:08.52,0:10:11.56,Default,,0,0,0,,Бұл жай ғана әзіл. Жақында ұмытасың.
Dialogue: 0,0:10:12.06,0:10:13.82,Default,,0,0,0,,Сенімсіз
Dialogue: 0,0:10:13.90,0:10:17.03,Default,,0,0,0,,Бұл сіз туралы. Ойыңды қашан өзгертесің?
Dialogue: 0,0:10:17.11,0:10:20.16,Default,,0,0,0,,«Ричард пен Эннді үйлендірейік».
Dialogue: 0,0:10:20.24,0:10:21.62,Default,,0,0,0,,Мамыр айының схемасы
Dialogue: 0,0:10:22.41,0:10:26.25,Default,,0,0,0,,Екеуміз енді кездеспейміз.
Dialogue: 0,0:10:26.33,0:10:27.91,Default,,0,0,0,,Мен оған сене алмаймын.
Dialogue: 0,0:10:28.41,0:10:32.08,Default,,0,0,0,,Мен патшаны қалай жеңетініңді өз көзіммен көргенше.
Dialogue: 0,0:10:33.00,0:10:35.17,Default,,0,0,0,,Сонымен не істеуді жоспарлайсыз?
Dialogue: 0,0:10:35.25,0:10:37.01,Default,,0,0,0,,Мен оған дейін үйге бармаймын.
Dialogue: 0,0:10:38.01,0:10:40.38,Default,,0,0,0,,Тағы да таққа отырсаң
Dialogue: 0,0:10:40.47,0:10:43.55,Default,,0,0,0,,Сіз Ричардты қалағаныңызша ұстай алуыңыз керек.
Dialogue: 0,0:10:44.76,0:10:48.77,Default,,0,0,0,,Жолға түскендер мұнарада өлгенше қала алады.
Dialogue: 0,0:10:49.27,0:10:50.64,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:50.73,0:10:52.19,Default,,0,0,0,,L өліпті
Dialogue: 0,0:10:52.27,0:10:52.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:53.98,0:10:56.15,Default,,0,0,0,,Сіз оны бір күні көре аласыз.
Dialogue: 0,0:10:56.65,0:10:59.99,Default,,0,0,0,,Патшаның тізерлеп отырған сәті
Dialogue: 0,0:11:02.41,0:11:03.32,Default,,0,0,0,,Жаса!
Dialogue: 0,0:11:03.41,0:11:05.53,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:11:06.24,0:11:10.00,Default,,0,0,0,,Сіз естідіңіз бе? көтерілісші күштердің декларациясы
Dialogue: 0,0:11:10.50,0:11:13.13,Default,,0,0,0,,Патша ескі дворяндарға опасыздық жасады.
Dialogue: 0,0:11:13.21,0:11:17.05,Default,,0,0,0,,Бізге, Вудвилл отбасына әділетсіздік жасалып жатыр.
Dialogue: 0,0:11:17.55,0:11:18.38,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:11:18.88,0:11:21.01,Default,,0,0,0,,Бұрын да осындай қауесеттер болған...
Dialogue: 0,0:11:21.97,0:11:24.39,Default,,0,0,0,,Егер сіз көп ойласаңыз, денсаулығыңызға зиян тигізеді.
Dialogue: 0,0:11:25.10,0:11:27.68,Default,,0,0,0,,Сізде қайтадан жүктілік белгілері пайда болды ма?
Dialogue: 0,0:11:28.18,0:11:28.97,Default,,0,0,0,,Иә
Dialogue: 0,0:11:29.81,0:11:31.81,Default,,0,0,0,,Иә, солай...
Dialogue: 0,0:11:31.89,0:11:35.02,Default,,0,0,0,,Мен сенің өлуге әлі де жол бере алмаймын.
Dialogue: 0,0:11:35.52,0:11:37.69,Default,,0,0,0,,Мұрагер туғанға дейін
Dialogue: 0,0:11:45.07,0:11:51.37,Default,,0,0,0,,Бұл аласапыран, болаттың салмағы, дірілдеген шиеленіс пен шаттық.
Dialogue: 0,0:11:52.04,0:11:54.79,Default,,0,0,0,,Қайттым, майдандамын
Dialogue: 0,0:11:55.29,0:11:57.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:57.13,0:11:59.76,Default,,0,0,0,,Бұл Ричард-саманың алғашқы шайқасы болса да.
Dialogue: 0,0:11:59.84,0:12:02.17,Default,,0,0,0,,Джордж Францияда.
Dialogue: 0,0:12:02.80,0:12:06.72,Default,,0,0,0,,Бұл менің ағам ғана емес, Уорвик де жоқ.
Dialogue: 0,0:12:07.22,0:12:09.10,Default,,0,0,0,,Мәртебелі, осылай
Dialogue: 0,0:12:09.18,0:12:11.56,Default,,0,0,0,,Бұл кездейсоқтық па?
Dialogue: 0,0:12:13.60,0:12:18.48,Default,,0,0,0,,Не... менің рұқсатымсыз.
Dialogue: 0,0:12:19.32,0:12:20.53,Default,,0,0,0,,Джордж және...
Dialogue: 0,0:12:21.24,0:12:23.95,Default,,0,0,0,,Изабель Невилл үйленді ме?
Dialogue: 0,0:12:29.20,0:12:33.62,Default,,0,0,0,,Мәртебелі, менің ойымша, біз қазір кері бұрылғанымыз жөн.
Dialogue: 0,0:12:34.12,0:12:34.87,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:35.50,0:12:39.88,Default,,0,0,0,,Джордж пен Уорвик одақ құрған болуы мүмкін.
Dialogue: 0,0:12:39.96,0:12:42.26,Default,,0,0,0,,Ұлы мәртебеліге қарсы одақ
Dialogue: 0,0:12:42.34,0:12:45.72,Default,,0,0,0,,Неліктен? Неге олар маған қарсы шығып жатыр?
Dialogue: 0,0:12:45.80,0:12:48.39,Default,,0,0,0,,Мәртебелі, бұл көтеріліс
Dialogue: 0,0:12:48.47,0:12:51.06,Default,,0,0,0,,Оны Уорвик графы бұйырған деген қауесеттер де бар.
Dialogue: 0,0:12:51.56,0:12:54.56,Default,,0,0,0,,Лондонға оралып, әскерімізді күшейтейік.
Dialogue: 0,0:12:54.64,0:12:57.02,Default,,0,0,0,,Хастингс дұрыс айтады.
Dialogue: 0,0:12:57.10,0:13:01.44,Default,,0,0,0,,Ағаның рұқсатынсыз күйеуге шығу сияқты опасыздықтың айқын әрекеті
Dialogue: 0,0:13:01.53,0:13:04.07,Default,,0,0,0,,Енді бізге ешқашан бағынбау үшін.
Dialogue: 0,0:13:04.15,0:13:05.74,Default,,0,0,0,,Ауыр жаза... (Эдвард) Энтони!
Dialogue: 0,0:13:06.78,0:13:09.28,Default,,0,0,0,,Джордж менің інім.
Dialogue: 0,0:13:09.78,0:13:14.46,Default,,0,0,0,,Ол Уоррик екеуі бір өлім сызығын бөлісті, бұл бауырластық емес қарым-қатынасты құрады.
Dialogue: 0,0:13:16.37,0:13:19.84,Default,,0,0,0,,Осы екеуі мені сатып кетсе...
Dialogue: 0,0:13:20.92,0:13:23.38,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:33.60,0:13:34.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:34.52,0:13:37.31,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:13:38.15,0:13:40.65,Default,,0,0,0,,Тағы да... сол арман
Dialogue: 0,0:13:43.69,0:13:45.57,Default,,0,0,0,,Мұнда ешкім жоқ
Dialogue: 0,0:13:46.07,0:13:48.16,Default,,0,0,0,,Бұл сіздің патша сарайыңыз.
Dialogue: 0,0:13:49.41,0:13:51.24,Default,,0,0,0,,Ішінде ыңғайлы.
Dialogue: 0,0:13:51.74,0:13:55.54,Default,,0,0,0,,Бірақ шын мәнінде менің патша сарайым...
Dialogue: 0,0:13:55.62,0:13:57.00,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:57.08,0:13:58.75,Default,,0,0,0,,Мақал-мәтел
Dialogue: 0,0:13:59.25,0:14:01.79,Default,,0,0,0,,Егер Уорвик графы Эдвард корольді жеңсе
Dialogue: 0,0:14:01.88,0:14:04.71,Default,,0,0,0,,Джордж жаңа патша болу мүмкіндігі бар...
Dialogue: 0,0:14:05.76,0:14:06.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:07.22,0:14:08.18,Default,,0,0,0,,Жау шабуылы~!
Dialogue: 0,0:14:08.68,0:14:11.05,Default,,0,0,0,,(Солдаттардың ұрыс дауысы)
Dialogue: 0,0:14:11.14,0:14:12.10,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:14:12.60,0:14:15.22,Default,,0,0,0,,Патша қайда! Патша шатырына ұмтылыңыз!
Dialogue: 0,0:14:15.31,0:14:17.18,Default,,0,0,0,,Ұлы Мәртебелін қорғаңыз!
Dialogue: 0,0:14:24.40,0:14:25.78,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:14:26.82,0:14:28.70,Default,,0,0,0,,Цк...тез қаш!
Dialogue: 0,0:14:29.66,0:14:31.70,Default,,0,0,0,,Эй, бір әйел шықты.
Dialogue: 0,0:14:31.78,0:14:33.03,Default,,0,0,0,,Герцогты таптыңыз ба?
Dialogue: 0,0:14:33.12,0:14:34.41,Default,,0,0,0,,Қалай болғанда да, қару...
Dialogue: 0,0:14:34.49,0:14:36.50,Default,,0,0,0,,Мен Ричардты көре алмаймын!
Dialogue: 0,0:14:38.04,0:14:39.83,Default,,0,0,0,,Мұқият іздеңіз!
Dialogue: 0,0:14:44.67,0:14:46.34,Default,,0,0,0,,Кедерсің, әйел, шық!
Dialogue: 0,0:14:54.22,0:14:54.89,Default,,0,0,0,,(Қолды ұстау дыбысы)
Dialogue: 0,0:14:55.89,0:14:58.10,Default,,0,0,0,,Сіз шынымен әйелсіз бе?
Dialogue: 0,0:14:58.18,0:15:00.81,Default,,0,0,0,,Мен патшаның інісі өте кішкентай деп естідім.
Dialogue: 0,0:15:01.31,0:15:03.90,Default,,0,0,0,,Не болса да генералға көрсетіңіз, ол бірден түсінеді.
Dialogue: 0,0:15:03.98,0:15:06.36,Default,,0,0,0,,Уорвик пен Джордж графына
Dialogue: 0,0:15:06.44,0:15:07.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:07.61,0:15:10.90,Default,,0,0,0,,Сіз тағына шындап ұмтыласыз ба?
Dialogue: 0,0:15:11.41,0:15:13.24,Default,,0,0,0,,Түсінсең, менімен бірге жүр...
Dialogue: 0,0:15:13.32,0:15:14.03,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:15:15.08,0:15:16.79,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:15:18.87,0:15:21.17,Default,,0,0,0,,Бұл... дәлел
Dialogue: 0,0:15:22.25,0:15:23.38,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:15:28.51,0:15:31.55,Default,,0,0,0,,Бұл дененің ешқашан пайдасы болмайды.
Dialogue: 0,0:15:32.05,0:15:34.14,Default,,0,0,0,,Біз негізгі күшпен тез кездесуіміз керек.
Dialogue: 0,0:15:34.22,0:15:36.01,Default,,0,0,0,,Уф! (Ричард) А...
Dialogue: 0,0:15:36.10,0:15:37.06,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:15:37.14,0:15:41.35,Default,,0,0,0,,Мынадай уақытта еркекті шақыратын жаман әйел болуы керек.
Dialogue: 0,0:15:41.44,0:15:43.44,Default,,0,0,0,,Ей, патша керемет болды ма?
Dialogue: 0,0:15:44.23,0:15:45.11,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:45.19,0:15:46.19,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:15:53.24,0:15:54.03,Default,,0,0,0,,Құрметті Ричард!
Dialogue: 0,0:15:55.24,0:15:56.62,Default,,0,0,0,,Catesby Осы жерді басыңыз
Dialogue: 0,0:15:58.12,0:16:00.16,Default,,0,0,0,,Мәртебелі Король және Лорд Хастингс
Dialogue: 0,0:16:00.25,0:16:02.12,Default,,0,0,0,,Мен сенің осы жаққа бара жатқаныңды көрдім.
Dialogue: 0,0:16:02.62,0:16:04.88,Default,,0,0,0,,Неліктен Хастингспен бірге бармадың?
Dialogue: 0,0:16:04.96,0:16:06.29,Default,,0,0,0,,Менің ойымша, бұл сіздің қожайыныңыз.
Dialogue: 0,0:16:06.79,0:16:09.30,Default,,0,0,0,,Мен Ричардты көре алмадым.
Dialogue: 0,0:16:09.80,0:16:13.88,Default,,0,0,0,,Корольдік отбасын қорғау бұл елдің рыцарының табиғи міндеті.
Dialogue: 0,0:16:14.39,0:16:15.51,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:16:15.59,0:16:18.97,Default,,0,0,0,,Мен енді әкемнің адалдығына байланысты емеспін.
Dialogue: 0,0:16:19.06,0:16:19.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:20.27,0:16:22.73,Default,,0,0,0,,Ах! кешіріңіз
Dialogue: 0,0:16:23.52,0:16:24.77,Default,,0,0,0,,Уайымдама, мен жүгіре аламын
Dialogue: 0,0:16:25.73,0:16:28.23,Default,,0,0,0,,Мен ағаммен тезірек кездесуім керек.
Dialogue: 0,0:16:28.73,0:16:29.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:29.98,0:16:31.19,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:16:31.28,0:16:35.49,Default,,0,0,0,,Сәлем! Бұл осылай! Тез кел!
Dialogue: 0,0:16:35.57,0:16:36.99,Default,,0,0,0,,Король тұтқынға алынды!
Dialogue: 0,0:16:40.74,0:16:42.29,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:42.79,0:16:47.33,Default,,0,0,0,,Уорвик? Сенімді жаумен қайтару үшін...
Dialogue: 0,0:16:49.96,0:16:52.80,Default,,0,0,0,,Бұл қызықсыз әзіл, Эдвард.
Dialogue: 0,0:16:52.88,0:16:57.01,Default,,0,0,0,,Эдвард ше? Мен сені патша дер едім
Dialogue: 0,0:16:57.51,0:17:01.06,Default,,0,0,0,,Эдвард, сен менің сеніміме опасыздық жасаған адамсың.
Dialogue: 0,0:17:02.64,0:17:06.40,Default,,0,0,0,,Мені жерге түсіріп, қорладың.
Dialogue: 0,0:17:06.48,0:17:11.11,Default,,0,0,0,,Уорвик Енді үніңді түзетіп, мені патшаң деп ата.
Dialogue: 0,0:17:11.19,0:17:13.44,Default,,0,0,0,,Олай істесең, барлық күнәларың кешіріледі...
Dialogue: 0,0:17:13.53,0:17:16.49,Default,,0,0,0,,Сіз өз ұстанымыңызды әлі түсінбеген сияқтысыз.
Dialogue: 0,0:17:16.57,0:17:19.53,Default,,0,0,0,,Сен енді менің патшам емессің
Dialogue: 0,0:17:19.62,0:17:22.12,Default,,0,0,0,,Патшалықты басқаруға жарамсыз
Dialogue: 0,0:17:22.62,0:17:28.08,Default,,0,0,0,,Мен патшалықты оның заңды патшасына қайтарамын.
Dialogue: 0,0:17:29.04,0:17:31.92,Default,,0,0,0,,Заңды патша...?
Dialogue: 0,0:17:33.38,0:17:34.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:34.76,0:17:36.68,Default,,0,0,0,,Енді сіз осындасыз⸺
Dialogue: 0,0:17:36.76,0:17:42.39,Default,,0,0,0,,Джордж нағыз патша, ал мен оның бағынысымын.
Dialogue: 0,0:17:46.89,0:17:48.85,Default,,0,0,0,,Қуғыншылардың белгісі жоқ сияқты.
Dialogue: 0,0:17:48.94,0:17:51.15,Default,,0,0,0,,Уорвик қандай софистиканы пайдаланса да,
Dialogue: 0,0:17:52.02,0:17:54.40,Default,,0,0,0,,Джордж патша бола алмайды
Dialogue: 0,0:17:54.90,0:17:57.61,Default,,0,0,0,,Егер Эдвард король тірі болса.
Dialogue: 0,0:17:59.36,0:18:00.16,Default,,0,0,0,,Кэтсби
Dialogue: 0,0:18:00.66,0:18:04.20,Default,,0,0,0,,Сіз рыцарьлардың корольдік отбасын қорғауы табиғи нәрсе дедіңіз.
Dialogue: 0,0:18:04.87,0:18:09.17,Default,,0,0,0,,Сонда не істеуіміз керек? Егер мен патшаға опасыздық жасасам
Dialogue: 0,0:18:10.17,0:18:13.63,Default,,0,0,0,,Тақты қаласам...
Dialogue: 0,0:18:22.68,0:18:23.76,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:18:27.35,0:18:28.48,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:30.94,0:18:33.07,Default,,0,0,0,,Мен Йорк корольдік отбасын қорғаймын.
Dialogue: 0,0:18:33.90,0:18:37.78,Default,,0,0,0,,Бұл өмірді маған әкем сыйлаған.
Dialogue: 0,0:18:38.32,0:18:42.49,Default,,0,0,0,,Менің тағдырым Йорк отбасы үшін өлу.
Dialogue: 0,0:18:44.45,0:18:47.75,Default,,0,0,0,,Сен сияқты бағыныштыны бәрі қалайды.
Dialogue: 0,0:18:49.83,0:18:54.59,Default,,0,0,0,,Ойлан, Ричард, қайсысы жақсы?
Dialogue: 0,0:18:55.21,0:18:57.88,Default,,0,0,0,,Кім тағына көбірек лайық?
Dialogue: 0,0:19:03.01,0:19:07.93,Default,,0,0,0,,Соғыспасаң, құқығыңды жоқтар тартып алады.
Dialogue: 0,0:19:11.15,0:19:15.15,Default,,0,0,0,,Енді патша жеңіліп, бұл ел оның қолында...
Dialogue: 0,0:19:15.73,0:19:19.03,Default,,0,0,0,,Қазір бұл тағында кім отыр?
Dialogue: 0,0:19:19.95,0:19:22.32,Default,,0,0,0,,Әпке! Патшаға жау шабуыл жасайды!
Dialogue: 0,0:19:22.99,0:19:24.53,Default,,0,0,0,,Патша өлді ме?
Dialogue: 0,0:19:24.62,0:19:27.24,Default,,0,0,0,,Жоқ, бірақ мен жаудың қолына түстім...
Dialogue: 0,0:19:27.33,0:19:27.83,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:19:27.91,0:19:30.96,Default,,0,0,0,,Уорвик графы мен лорд Джордж осында әскерді басқарады...
Dialogue: 0,0:19:31.04,0:19:31.54,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:19:32.79,0:19:36.13,Default,,0,0,0,,Уорвик... ақымақ адам
Dialogue: 0,0:19:38.30,0:19:40.97,Default,,0,0,0,,Қашып кететін болсаң, менің әйелімді де ала кет.
Dialogue: 0,0:19:41.84,0:19:43.80,Default,,0,0,0,,Ол сенің қарындасың.
Dialogue: 0,0:19:44.47,0:19:46.76,Default,,0,0,0,,Қош келдіңіз, Букингем.
Dialogue: 0,0:19:47.26,0:19:47.76,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:19:48.52,0:19:50.98,Default,,0,0,0,,Мен неге әйел мен баламен...
Dialogue: 0,0:19:51.48,0:19:54.31,Default,,0,0,0,,Эй, Энтони, Ричардқа не болды?
Dialogue: 0,0:19:54.40,0:19:56.61,Default,,0,0,0,,Мен қамауға алынғандар туралы естіген жоқпын.
Dialogue: 0,0:19:56.69,0:19:58.48,Default,,0,0,0,,Одан гөрі әкем...
Dialogue: 0,0:19:58.57,0:20:01.15,Default,,0,0,0,,Ол біздің отбасымыздан кек алғысы келеді!
Dialogue: 0,0:20:01.24,0:20:03.41,Default,,0,0,0,,Барлығы өлтіріледі!
Dialogue: 0,0:20:03.49,0:20:06.16,Default,,0,0,0,,Мен бұған ешқашан жол бермеймін.
Dialogue: 0,0:20:07.33,0:20:08.74,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:20:10.66,0:20:13.92,Default,,0,0,0,,Егер сіз патшайымды ұстап алсаңыз, оны дереу мұнараға апарыңыз.
Dialogue: 0,0:20:14.00,0:20:16.17,Default,,0,0,0,,Мүмкіндігінше құрметтеңіз
Dialogue: 0,0:20:16.25,0:20:16.75,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:17.96,0:20:20.80,Default,,0,0,0,,Жүкті әйелдердің өлу ықтималдығы жоғары
Dialogue: 0,0:20:23.26,0:20:24.80,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:20:24.89,0:20:27.60,Default,,0,0,0,,Мен Уорвикке қалағанын жасауға рұқсат бермеймін.
Dialogue: 0,0:20:28.10,0:20:31.89,Default,,0,0,0,,Менің кек әлі біткен жоқ.
Dialogue: 0,0:20:35.98,0:20:37.73,Default,,0,0,0,,Бұл Букингем герцогы.
Dialogue: 0,0:20:38.57,0:20:40.69,Default,,0,0,0,,Сіз патшайымды көрмедіңіз бе?
Dialogue: 0,0:20:41.32,0:20:42.65,Default,,0,0,0,,Оны көрсең не істер едің?
Dialogue: 0,0:20:43.28,0:20:45.95,Default,,0,0,0,,Ақылды болсаң, түсіну керек.
Dialogue: 0,0:20:46.45,0:20:48.99,Default,,0,0,0,,Ең дұрысы не?
Dialogue: 0,0:20:49.95,0:20:52.45,Default,,0,0,0,,Егер Эдвард пен патшайымның отбасы жоғалып кетсе
Dialogue: 0,0:20:52.96,0:20:55.21,Default,,0,0,0,,Джордж жаңа патша бола ма?
Dialogue: 0,0:20:56.29,0:21:00.46,Default,,0,0,0,,Бірақ бұл орын алса, таққа мұрагерліктің келесі құқығы ... болады.
Dialogue: 0,0:21:01.67,0:21:05.47,Default,,0,0,0,,Әрине, Эрл, мен сені көрсем, бірден хабарлаймын.
Dialogue: 0,0:21:07.72,0:21:08.64,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:08.72,0:21:09.93,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:21:11.64,0:21:13.60,Default,,0,0,0,,Бұл мүмкіндікті жіберіп алудың жолы жоқ
Dialogue: 0,0:21:14.10,0:21:16.73,Default,,0,0,0,,Тақ тұрақсыз жерге қойылса...
Dialogue: 0,0:21:17.98,0:21:22.61,Default,,0,0,0,,Ей, Ричардты Уорвиктен бұрын тауып алайық.
Dialogue: 0,0:21:22.69,0:21:23.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:24.19,0:21:27.49,Default,,0,0,0,,Мен сені патша етіп таңдаймын.
Dialogue: 0,0:21:29.03,0:21:31.45,Default,,0,0,0,,Патша деген сезімі жоқ адам
Dialogue: 0,0:21:32.16,0:21:34.50,Default,,0,0,0,,Патша болуға жарамсыз адам
Dialogue: 0,0:21:35.08,0:21:37.79,Default,,0,0,0,,Екеуі де таққа лайық емес.
Dialogue: 0,0:21:38.79,0:21:40.75,Default,,0,0,0,,Тіпті Уорвик болса да
Dialogue: 0,0:21:41.25,0:21:44.97,Default,,0,0,0,,Мен саған патшалықты бермеймін...
Dialogue: 0,0:21:46.34,0:21:49.51,Default,,0,0,0,,Мен Эдвард корольді қайтарып аламын.
Dialogue: 0,0:22:01.52,0:22:03.53,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:30.95,Default,,0,0,0,,～♪
