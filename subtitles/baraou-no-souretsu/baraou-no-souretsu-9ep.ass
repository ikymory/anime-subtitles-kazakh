Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.46,0:00:08.59,Default,,0,0,0,,Сен менің періштем Ричардсың
Dialogue: 0,0:00:12.01,0:00:15.47,Default,,0,0,0,,Осылай қалсам... сенің жаныңда осылай қалсам
Dialogue: 0,0:00:15.97,0:00:17.89,Default,,0,0,0,,Біз дос болып қала алмаймыз
Dialogue: 0,0:00:17.97,0:00:20.77,Default,,0,0,0,,Уф... Мен ұятсызмын.
Dialogue: 0,0:00:21.27,0:00:25.19,Default,,0,0,0,,Мені жақсы көретіндігіңді түсінген бойда сүйікті болғың келеді
Dialogue: 0,0:00:25.69,0:00:27.11,Default,,0,0,0,,Не болды? (Ричард) А...
Dialogue: 0,0:00:27.90,0:00:30.57,Default,,0,0,0,,Жалғыз қалғанда суық болады, Ричард.
Dialogue: 0,0:00:36.57,0:00:38.62,Default,,0,0,0,,Ақ раушан қамыты
Dialogue: 0,0:00:38.70,0:00:40.74,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:00:41.24,0:00:47.25,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:00:47.75,0:00:52.59,Default,,0,0,0,,Адамдар оны «Раушандар соғысы» деп атайды.
Dialogue: 0,0:00:56.68,0:00:58.68,Default,,0,0,0,,♪～
Dialogue: 0,0:02:22.55,0:02:24.56,Default,,0,0,0,,～♪
Dialogue: 0,0:02:28.81,0:02:30.10,Default,,0,0,0,,Генри қажылық сапарында болды
Dialogue: 0,0:02:30.19,0:02:31.44,Default,,0,0,0,,Ол қашып кеткен сияқты.
Dialogue: 0,0:02:31.94,0:02:34.82,Default,,0,0,0,,Леди Кейтсби оның бетін білуі керек.
Dialogue: 0,0:02:34.90,0:02:36.61,Default,,0,0,0,,Егер біз оны қолға алсақ, біз үшін...
Dialogue: 0,0:02:36.69,0:02:39.11,Default,,0,0,0,,Ричардты құтқарған дұрыс!
Dialogue: 0,0:02:39.99,0:02:43.16,Default,,0,0,0,,Іздеген жерлерді қайта айналып өтіңіз.
Dialogue: 0,0:02:43.24,0:02:43.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:44.08,0:02:48.08,Default,,0,0,0,,(жылқылардың шабысы)
Dialogue: 0,0:02:49.37,0:02:51.62,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:03:02.05,0:03:05.01,Default,,0,0,0,,Жоқ... жоқ, сөзсіз.
Dialogue: 0,0:03:05.10,0:03:05.76,Default,,0,0,0,,Әлгі адам...
Dialogue: 0,0:03:06.64,0:03:07.14,Default,,0,0,0,,Генри
Dialogue: 0,0:03:07.22,0:03:08.43,Default,,0,0,0,,Құрметті Ричард!
Dialogue: 0,0:03:10.18,0:03:11.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:11.27,0:03:14.02,Default,,0,0,0,,Кэтсби Күтіңіз, бұл жау емес.
Dialogue: 0,0:03:15.98,0:03:18.44,Default,,0,0,0,,Мен жарақат алып, біраз уақыт қозғала алмадым.
Dialogue: 0,0:03:19.15,0:03:21.20,Default,,0,0,0,,Бұл адам мені құтқарды.
Dialogue: 0,0:03:22.36,0:03:24.49,Default,,0,0,0,,Бірақ ол адам...
Dialogue: 0,0:03:25.12,0:03:26.53,Default,,0,0,0,,Ол менің досым.
Dialogue: 0,0:03:27.16,0:03:29.45,Default,,0,0,0,,Кэтсби, сәл күте тұрыңыз.
Dialogue: 0,0:03:30.21,0:03:31.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:35.50,0:03:38.30,Default,,0,0,0,,Ол менің ескі досым.
Dialogue: 0,0:03:38.38,0:03:40.80,Default,,0,0,0,,Сен... мені алып кетуге келдің.
Dialogue: 0,0:03:40.88,0:03:41.67,Default,,0,0,0,,Мынаны ал, «Aerosmith»!
Dialogue: 0,0:03:42.26,0:03:45.85,Default,,0,0,0,,Мен сауығып кеткен соң шығамын дедім.
Dialogue: 0,0:03:46.35,0:03:49.14,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:03:49.85,0:03:51.81,Default,,0,0,0,,Ағаңызды одақтас етіп әкеліңіз
Dialogue: 0,0:03:51.89,0:03:54.10,Default,,0,0,0,,Ланкастерді жою
Dialogue: 0,0:03:54.19,0:03:56.61,Default,,0,0,0,,Егер... бітсе ше?
Dialogue: 0,0:03:56.69,0:03:58.82,Default,,0,0,0,,Осылай жасасақ, мәңгі бірге бола аламыз ба?
Dialogue: 0,0:04:00.61,0:04:03.91,Default,,0,0,0,,Шайқас біткенде, менің орным...
Dialogue: 0,0:04:05.91,0:04:09.99,Default,,0,0,0,,Сол ағаштың астында тағы кездесеміз деп уәде берейік.
Dialogue: 0,0:04:10.50,0:04:12.75,Default,,0,0,0,,Мен сені осында күттім
Dialogue: 0,0:04:15.29,0:04:18.46,Default,,0,0,0,,Түсіндім, уәде беремін
Dialogue: 0,0:04:21.30,0:04:25.89,Default,,0,0,0,,Келесі жылы осы уақытқа дейін... бәрі бітетініне сенімдімін.
Dialogue: 0,0:04:26.59,0:04:29.85,Default,,0,0,0,,Сосын, келесі жылы осы уақытта, осында.
Dialogue: 0,0:04:30.77,0:04:33.06,Default,,0,0,0,,Уәде беремін, Ричард.
Dialogue: 0,0:04:33.73,0:04:34.56,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:04:40.86,0:04:43.19,Default,,0,0,0,,Құрметті Ричард, бұл адам...
Dialogue: 0,0:04:43.28,0:04:47.24,Default,,0,0,0,,Мен оның кім екенін білмеймін. Ол қойшымын деді, бірақ...
Dialogue: 0,0:04:49.33,0:04:53.62,Default,,0,0,0,,Кэтсби Сіз біреуді жақсы көрдіңіз бе?
Dialogue: 0,0:04:54.12,0:04:57.42,Default,,0,0,0,,Ол адаммен мәңгі бірге бола алмасаңыз да
Dialogue: 0,0:04:58.17,0:05:00.21,Default,,0,0,0,,Мен сенің жаныңда болғым келеді...
Dialogue: 0,0:05:01.67,0:05:04.09,Default,,0,0,0,,Сезімімді мәңгілікке жеткізбей
Dialogue: 0,0:05:04.88,0:05:06.80,Default,,0,0,0,,Менің қасымда...
Dialogue: 0,0:05:11.56,0:05:13.93,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:05:14.43,0:05:17.90,Default,,0,0,0,,Джордждың көзқарасы бойынша мен сатқынмын.
Dialogue: 0,0:05:18.40,0:05:20.65,Default,,0,0,0,,Мен сізді көндірсем де...
Dialogue: 0,0:05:21.15,0:05:22.94,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:05:26.70,0:05:28.74,Default,,0,0,0,,(Ата-ана мен баланың күлкісі)
Dialogue: 0,0:05:29.24,0:05:31.62,Default,,0,0,0,,Рождество жақындаған сайын есіме түседі
Dialogue: 0,0:05:33.08,0:05:36.62,Default,,0,0,0,,Сол кезде мен әкемнен айырылдым.
Dialogue: 0,0:05:38.17,0:05:41.38,Default,,0,0,0,,Аға, көп нәрсені ұмытпа.
Dialogue: 0,0:05:44.55,0:05:46.30,Default,,0,0,0,,Уау! (Еркек) Хехехе...
Dialogue: 0,0:05:46.80,0:05:48.30,Default,,0,0,0,,Не болды!
Dialogue: 0,0:05:48.38,0:05:49.39,Default,,0,0,0,,Құрметті Джордж...
Dialogue: 0,0:05:49.47,0:05:52.01,Default,,0,0,0,,Бұл мәртебелі герцог!
Dialogue: 0,0:05:52.10,0:05:54.97,Default,,0,0,0,,Маған сеніңіз, мен оны шынымен көрдім.
Dialogue: 0,0:05:55.06,0:05:57.14,Default,,0,0,0,,Құрметті Джордж, бұл мас әзіл.
Dialogue: 0,0:05:57.23,0:06:00.10,Default,,0,0,0,,Ақымақ болма! Мен оны өз көзіммен анық көрдім!
Dialogue: 0,0:06:01.36,0:06:03.07,Default,,0,0,0,,Не? (Ер) А...
Dialogue: 0,0:06:03.15,0:06:06.11,Default,,0,0,0,,Ұзын шашты елес
Dialogue: 0,0:06:06.19,0:06:09.24,Default,,0,0,0,,Қамал қабырғасында жарқыраған
Dialogue: 0,0:06:09.32,0:06:12.99,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:14.16,0:06:17.37,Default,,0,0,0,,Жоғары мәртебелі сөздің артында бір тұлға бар...
Dialogue: 0,0:06:18.25,0:06:21.33,Default,,0,0,0,,Мен саған алты пенс беремін, үйге қайт.
Dialogue: 0,0:06:22.00,0:06:23.25,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:06:23.34,0:06:28.09,Default,,0,0,0,,Абайлаңыз, жылдың осы мезгілінде рухтардың күші күшті.
Dialogue: 0,0:06:30.26,0:06:33.43,Default,,0,0,0,,Егер мені біреу иеленсе
Dialogue: 0,0:06:33.51,0:06:34.97,Default,,0,0,0,,Бұл рух емес
Dialogue: 0,0:06:35.47,0:06:36.81,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:37.39,0:06:38.94,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:06:40.44,0:06:42.36,Default,,0,0,0,,Мереке басталғалы жатыр.
Dialogue: 0,0:06:42.86,0:06:47.24,Default,,0,0,0,,Енді ләззат алыңыз! Бүгін кешке патшаны таңдайық
Dialogue: 0,0:06:47.82,0:06:50.32,Default,,0,0,0,,Егер оның ішінде бұршақ болса, сіз патшасыз.
Dialogue: 0,0:06:50.41,0:06:51.95,Default,,0,0,0,,Бұл кім? Хит
Dialogue: 0,0:06:52.03,0:06:54.16,Default,,0,0,0,,Бұл Уорвик графы!
Dialogue: 0,0:06:54.24,0:06:56.66,Default,,0,0,0,,О! (Асыл А) Таққа келіңіз, мәртебелі.
Dialogue: 0,0:06:56.74,0:06:58.12,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:07:00.37,0:07:02.75,Default,,0,0,0,,Мен... отыруым керек еді.
Dialogue: 0,0:07:03.25,0:07:06.34,Default,,0,0,0,,Неліктен Уорвик сол тағында отыр?
Dialogue: 0,0:07:07.21,0:07:09.63,Default,,0,0,0,,Жоқ... король – Генри.
Dialogue: 0,0:07:09.72,0:07:12.09,Default,,0,0,0,,Содан кейін Ланкастер князі
Dialogue: 0,0:07:12.72,0:07:14.05,Default,,0,0,0,,Мен қай жерде қателестім?
Dialogue: 0,0:07:14.14,0:07:18.02,Default,,0,0,0,,Енді, Мәртебелі, мен маска әртістерін шақырамын.
Dialogue: 0,0:07:18.60,0:07:23.27,Default,,0,0,0,,Мен патшаның кіші інісі және тағының бірінші мұрагері болдым.
Dialogue: 0,0:07:23.35,0:07:24.36,Default,,0,0,0,,Құрметті Джордж
Dialogue: 0,0:07:24.44,0:07:27.19,Default,,0,0,0,,Ханымдар мен мырзалардан тамаша шарап
Dialogue: 0,0:07:27.69,0:07:29.40,Default,,0,0,0,,Барынша әкеліңіз
Dialogue: 0,0:07:29.49,0:07:31.70,Default,,0,0,0,,Мен сарайдағы барлық шарапты ішемін!
Dialogue: 0,0:07:32.32,0:07:35.66,Default,,0,0,0,,Мен Англия королімін!
Dialogue: 0,0:07:36.95,0:07:40.08,Default,,0,0,0,,Менің ұлым қайда? Ұлым!
Dialogue: 0,0:07:41.37,0:07:42.83,Default,,0,0,0,,Әке!
Dialogue: 0,0:07:46.04,0:07:48.67,Default,,0,0,0,,Әке, ант етемін
Dialogue: 0,0:07:48.75,0:07:52.51,Default,,0,0,0,,Әкемнің тақиясы үшін күресу үшін өмірімді қатерге тігемін.
Dialogue: 0,0:07:53.01,0:07:54.43,Default,,0,0,0,,Джордж да, солай ма?
Dialogue: 0,0:07:54.51,0:07:58.22,Default,,0,0,0,,Иә, ант етемін, Әке!
Dialogue: 0,0:07:58.31,0:07:59.14,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:07:59.22,0:08:03.81,Default,,0,0,0,,Қымбатты Джордж, мен сыртта желге аздап ұшырадым...
Dialogue: 0,0:08:04.31,0:08:06.61,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:08:07.65,0:08:09.61,Default,,0,0,0,,Сіз аздап көп ішкенсіз.
Dialogue: 0,0:08:12.03,0:08:15.57,Default,,0,0,0,,Сіз арнайы кешті үздіңіз.
Dialogue: 0,0:08:17.07,0:08:20.95,Default,,0,0,0,,Мен ұлы мәртебелілердің көмегінсіз кетемін.
Dialogue: 0,0:08:28.21,0:08:31.13,Default,,0,0,0,,Мен... қателестім бе?
Dialogue: 0,0:08:31.63,0:08:33.93,Default,,0,0,0,,Тіпті қазір болса да...
Dialogue: 0,0:08:37.09,0:08:39.72,Default,,0,0,0,,Сіз маска киген актерсіз бе?
Dialogue: 0,0:08:42.56,0:08:43.68,Default,,0,0,0,,Джордж…
Dialogue: 0,0:08:44.19,0:08:45.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:45.85,0:08:47.36,Default,,0,0,0,,Менің ұлым
Dialogue: 0,0:08:47.44,0:08:51.32,Default,,0,0,0,,Джордж Менің тәжім қайда?
Dialogue: 0,0:08:52.11,0:08:56.03,Default,,0,0,0,,Йорктың ұлы ақ раушан гүлін қанмен бояйды ма?
Dialogue: 0,0:08:56.11,0:08:57.99,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:08:59.12,0:09:00.99,Default,,0,0,0,,Жоқ, олай болуы мүмкін емес...
Dialogue: 0,0:09:01.79,0:09:05.00,Default,,0,0,0,,Джордж Йорктың жанын қорламаңыз.
Dialogue: 0,0:09:05.08,0:09:08.71,Default,,0,0,0,,Жаныңды ластасаң, міндетті түрде жазаланасың.
Dialogue: 0,0:09:09.29,0:09:12.17,Default,,0,0,0,,Енді менің қолыма тәжді ал
Dialogue: 0,0:09:13.38,0:09:16.72,Default,,0,0,0,,Тоқта! әке!
Dialogue: 0,0:09:23.10,0:09:23.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:29.77,0:09:32.07,Default,,0,0,0,,Бұл тамаша қойылым болды, Кэтсби.
Dialogue: 0,0:09:32.61,0:09:35.24,Default,,0,0,0,,Ол менің нағыз әкем сияқты еді.
Dialogue: 0,0:09:36.32,0:09:39.91,Default,,0,0,0,,Балалар, аруақтар туралы өсек таратасыңдар.
Dialogue: 0,0:09:40.41,0:09:45.25,Default,,0,0,0,,Ағамның алшақтығын мақсат тұтып, Әкемнің көлеңкесін әр сәт сайын жыпылықтаймын.
Dialogue: 0,0:09:45.33,0:09:45.83,Default,,0,0,0,,Га
Dialogue: 0,0:09:46.79,0:09:51.29,Default,,0,0,0,,Неғұрлым оны бұрыштасаңыз, бұл жалау соғұрлым тиімді болады.
Dialogue: 0,0:09:52.21,0:09:54.13,Default,,0,0,0,,Қарапайым ағайынды Джорджға
Dialogue: 0,0:09:54.21,0:09:56.76,Default,,0,0,0,,Бұл логикаға қарағанда әлдеқайда тиімді болады.
Dialogue: 0,0:09:57.51,0:10:00.22,Default,,0,0,0,,Мен әкемнің Рухын пайдаланамын, бірақ
Dialogue: 0,0:10:00.72,0:10:03.22,Default,,0,0,0,,Мұның бәрі сіздің өкінішіңіз үшін кек алу үшін.
Dialogue: 0,0:10:03.97,0:10:07.23,Default,,0,0,0,,Ланкастерді жеңсек ше... Генри?
Dialogue: 0,0:10:07.31,0:10:10.48,Default,,0,0,0,,Әрине, ол менің әкемнің жауы.
Dialogue: 0,0:10:11.11,0:10:13.44,Default,,0,0,0,,Келесі жолы мен сені мұнараға қамамаймын.
Dialogue: 0,0:10:13.52,0:10:17.19,Default,,0,0,0,,Мен сені ұрыс даласында міндетті түрде өлтіремін.
Dialogue: 0,0:10:18.36,0:10:18.99,Default,,0,0,0,,Жоғары мәртебелі!
Dialogue: 0,0:10:19.49,0:10:21.07,Default,,0,0,0,,(Рейнхардт) Мен Фэлт ханымды шамамен бір ай бұрын кедейлер ауданының бір бұрышынан құтқардым.
Dialogue: 0,0:10:21.16,0:10:23.41,Default,,0,0,0,,Эдвардқа Бургундия көмектесті.
Dialogue: 0,0:10:23.49,0:10:26.08,Default,,0,0,0,,Ол Англияға жол тартты!
Dialogue: 0,0:10:27.37,0:10:29.67,Default,,0,0,0,,Күте тұрыңыз, Уорвик.
Dialogue: 0,0:10:29.75,0:10:32.79,Default,,0,0,0,,Мен үлкен дауыл шақырғалы тұрмын.
Dialogue: 0,0:10:32.88,0:10:34.59,Default,,0,0,0,,Дауыл
Dialogue: 0,0:10:34.67,0:10:39.97,Default,,0,0,0,,Басымның үстінде алтын тәж жарқырап тұрғанша тоқтамаймын.
Dialogue: 0,0:10:41.14,0:10:42.97,Default,,0,0,0,,Сізге қалай ұнайды? Жоғары мәртебелі
Dialogue: 0,0:10:43.05,0:10:47.43,Default,,0,0,0,,Франция королі ештеңе істемеді деп ойлайсың ба?
Dialogue: 0,0:10:47.52,0:10:49.14,Default,,0,0,0,,Жүр!
Dialogue: 0,0:10:49.77,0:10:54.48,Default,,0,0,0,,Дауыл жоқ десе де, менің Англиям үшін!
Dialogue: 0,0:10:59.20,0:11:02.07,Default,,0,0,0,,Мәртебелі мырза, қайда бардыңыз...
Dialogue: 0,0:11:02.57,0:11:05.83,Default,,0,0,0,,Ішке кіріңіз. Сіз суық тиіп қаласыз.
Dialogue: 0,0:11:06.41,0:11:10.58,Default,,0,0,0,,Мен мұндамын, мен ұрыспаймын.
Dialogue: 0,0:11:10.66,0:11:12.29,Default,,0,0,0,,Бұл жақсы болар еді.
Dialogue: 0,0:11:13.00,0:11:16.42,Default,,0,0,0,,Йорктік дворяндарды дереу қолға түсіріңіз
Dialogue: 0,0:11:16.50,0:11:18.67,Default,,0,0,0,,Біз әлемнің түкпір-түкпірінен адал адамдарды шақырамыз...
Dialogue: 0,0:11:18.76,0:11:19.76,Default,,0,0,0,,Мені өлтірмеңдер
Dialogue: 0,0:11:20.63,0:11:22.34,Default,,0,0,0,,Жеткілікті шайқастар
Dialogue: 0,0:11:22.84,0:11:25.47,Default,,0,0,0,,Оларды үлкен әскермен басып, кері бұрылуға мәжбүрлеңіз.
Dialogue: 0,0:11:27.06,0:11:30.94,Default,,0,0,0,,Жау жойылғанда шайқас аяқталады.
Dialogue: 0,0:11:31.89,0:11:34.36,Default,,0,0,0,,Енді, мырзалар, ұлы мәртебелі мырзамен қоштасыңыздар.
Dialogue: 0,0:11:34.44,0:11:36.32,Default,,0,0,0,,Қайырлы күн мырзам
Dialogue: 0,0:11:36.82,0:11:38.61,Default,,0,0,0,,Қайырлы күн Мәртебелі
Dialogue: 0,0:11:39.53,0:11:41.61,Default,,0,0,0,,Кешіріңіз, Мәртебелі.
Dialogue: 0,0:11:42.49,0:11:45.16,Default,,0,0,0,,Қолыңызды сүйемін, Мәртебелі.
Dialogue: 0,0:11:46.45,0:11:48.41,Default,,0,0,0,,Адалдық белгісі ретінде
Dialogue: 0,0:11:53.00,0:11:54.63,Default,,0,0,0,,Жақсы Джордж…
Dialogue: 0,0:11:55.88,0:11:57.50,Default,,0,0,0,,Алла разы болсын
Dialogue: 0,0:12:00.26,0:12:02.55,Default,,0,0,0,,Шайқас... аяқталды ма?
Dialogue: 0,0:12:03.80,0:12:07.10,Default,,0,0,0,,Тән өлсе де, жан...
Dialogue: 0,0:12:08.14,0:12:10.60,Default,,0,0,0,,Кек рухы ешқашан өлмейді
Dialogue: 0,0:12:11.10,0:12:14.10,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:12:15.69,0:12:17.98,Default,,0,0,0,,Оның ештеңе істемейтінін білесіз.
Dialogue: 0,0:12:18.69,0:12:20.94,Default,,0,0,0,,Анамның көзін алдау.
Dialogue: 0,0:12:21.03,0:12:22.78,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:12:23.99,0:12:26.03,Default,,0,0,0,,Менің көңілім қалды, Эдвард.
Dialogue: 0,0:12:26.12,0:12:27.99,Default,,0,0,0,,Анашым! Бұл...
Dialogue: 0,0:12:28.08,0:12:31.66,Default,,0,0,0,,Тіпті Генри де өз міндетін атқарды.
Dialogue: 0,0:12:31.75,0:12:33.50,Default,,0,0,0,,Ерлігің сол кісіден кем бе?
Dialogue: 0,0:12:33.58,0:12:35.46,Default,,0,0,0,,Бұл... Олай емес!
Dialogue: 0,0:12:35.54,0:12:38.13,Default,,0,0,0,,Жоқ, оның мағынасы осы.
Dialogue: 0,0:12:38.63,0:12:41.84,Default,,0,0,0,,Сен Генриден де кіші адамсың.
Dialogue: 0,0:12:42.55,0:12:46.34,Default,,0,0,0,,Жоқ... мүлде олай емес...
Dialogue: 0,0:12:48.85,0:12:50.85,Default,,0,0,0,,Олай болса дәлелде.
Dialogue: 0,0:12:51.35,0:12:54.44,Default,,0,0,0,,Енді, міне, анамның алдында
Dialogue: 0,0:12:54.52,0:12:55.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:57.56,0:12:59.77,Default,,0,0,0,,Патша болсаң, Көбірек вассалдың алдында
Dialogue: 0,0:12:59.86,0:13:01.36,Default,,0,0,0,,Орындайды
Dialogue: 0,0:13:01.86,0:13:05.57,Default,,0,0,0,,Егер қолыңнан келмесе, сен патша болуға лайық емессің.
Dialogue: 0,0:13:06.82,0:13:09.49,Default,,0,0,0,,Түсіндің бе? Анн
Dialogue: 0,0:13:10.53,0:13:13.12,Default,,0,0,0,,Ричард туралы қанша ойласаңыз да
Dialogue: 0,0:13:13.20,0:13:14.79,Default,,0,0,0,,Ол әйел болғанша
Dialogue: 0,0:13:14.87,0:13:18.67,Default,,0,0,0,,Ол сені ешқашан сүймейді
Dialogue: 0,0:13:22.76,0:13:25.30,Default,,0,0,0,,Жарай ма? Сіз...
Dialogue: 0,0:13:26.01,0:13:28.97,Default,,0,0,0,,Өйткені мен сенің әйеліңмін
Dialogue: 0,0:13:30.76,0:13:33.81,Default,,0,0,0,,Ричард маған күледі
Dialogue: 0,0:13:34.31,0:13:36.39,Default,,0,0,0,,Мәңгі...
Dialogue: 0,0:13:37.10,0:13:40.11,Default,,0,0,0,,Менің әйелім әлдеқайда жігерлі.
Dialogue: 0,0:13:40.19,0:13:41.52,Default,,0,0,0,,Дәл біз сияқты...
Dialogue: 0,0:13:41.61,0:13:42.69,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:13:43.69,0:13:48.20,Default,,0,0,0,,Мен әкемнен өзгешемін! Асты былай тұрсын...
Dialogue: 0,0:13:48.28,0:13:49.95,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:13:50.03,0:13:51.78,Default,,0,0,0,,Қараңыз, анашым.
Dialogue: 0,0:13:51.87,0:13:54.58,Default,,0,0,0,,Мен лайықты адам екенімді дәлелдеймін.
Dialogue: 0,0:13:59.38,0:14:00.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:02.25,0:14:03.21,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:14:04.51,0:14:08.72,Default,,0,0,0,,Мен сенің әйелің боламын, бірақ маған бір сөз берші.
Dialogue: 0,0:14:09.39,0:14:13.68,Default,,0,0,0,,Мен Ричардты ұрыс даласында ұстап алсам да, оның өмірін ешқашан қиюға болмайды.
Dialogue: 0,0:14:15.43,0:14:17.52,Default,,0,0,0,,Айтпасаң да, айтайын дегенім.
Dialogue: 0,0:14:17.60,0:14:20.23,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:14:26.86,0:14:29.41,Default,,0,0,0,,Әскерлер бірқалыпты жиналып жатқан сияқты.
Dialogue: 0,0:14:29.49,0:14:30.20,Default,,0,0,0,,Иә
Dialogue: 0,0:14:30.28,0:14:33.62,Default,,0,0,0,,Ал Маргареттің кемесі жақында келеді.
Dialogue: 0,0:14:35.12,0:14:38.41,Default,,0,0,0,,Егер біздің күшімізге арматуралар қосылса,
Dialogue: 0,0:14:38.91,0:14:43.50,Default,,0,0,0,,Эдвардтың шетелден алған сандар армиясы мардымсыз болды.
Dialogue: 0,0:14:43.59,0:14:46.05,Default,,0,0,0,,Мәртебелі Маргарет қош келдіңіз...
Dialogue: 0,0:14:46.13,0:14:48.42,Default,,0,0,0,,Алып кету жіберілген.
Dialogue: 0,0:14:51.43,0:14:54.26,Default,,0,0,0,,Ең сенімді адамды табыңыз
Dialogue: 0,0:14:58.35,0:15:00.14,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Ричард.
Dialogue: 0,0:15:00.64,0:15:03.36,Default,,0,0,0,,Біз аман-есен кездескеніміз үшін Құдайға алғыс айтуымыз керек.
Dialogue: 0,0:15:03.86,0:15:07.40,Default,,0,0,0,,Бауырым... солдаттарға осының бәрі бар ма?
Dialogue: 0,0:15:08.65,0:15:12.28,Default,,0,0,0,,Осы дәрежедегі әскери күшпен жауды жеңе аламыз деп ойлау...
Dialogue: 0,0:15:12.95,0:15:15.03,Default,,0,0,0,,Сондықтан мен оны саған сеніп тапсырдым.
Dialogue: 0,0:15:15.53,0:15:18.75,Default,,0,0,0,,Джордж бізге қайтып келмесе...
Dialogue: 0,0:15:20.54,0:15:23.75,Default,,0,0,0,,Бұл Эдвардтың осында құлаудан басқа амалы жоқ.
Dialogue: 0,0:15:31.76,0:15:32.68,Default,,0,0,0,,Джордж…
Dialogue: 0,0:15:33.18,0:15:34.85,Default,,0,0,0,,Сатқын!
Dialogue: 0,0:15:34.93,0:15:37.85,Default,,0,0,0,,Нағыз патшайым менің әпкем екенін ұмыттың ба?
Dialogue: 0,0:15:37.93,0:15:40.35,Default,,0,0,0,,Генридің пайдасына туған ағасын тастап кетеді деп ойлау...
Dialogue: 0,0:15:40.43,0:15:41.94,Default,,0,0,0,,Энтонидің аузын жап
Dialogue: 0,0:15:43.02,0:15:46.40,Default,,0,0,0,,Маған жауап бер, Джордж, сенің қожайын кім?
Dialogue: 0,0:15:48.78,0:15:52.45,Default,,0,0,0,,Менің мырзам, әрине, патша.
Dialogue: 0,0:15:53.61,0:15:54.32,Default,,0,0,0,,Джордж
Dialogue: 0,0:15:54.82,0:15:59.12,Default,,0,0,0,,Мен жай ғана Йорк герцогымын, мен Йорк қаласына бара жатырмын.
Dialogue: 0,0:15:59.20,0:16:02.00,Default,,0,0,0,,Менің басқа ниетім жоқ, тек сол арқылы өтіңіз.
Dialogue: 0,0:16:02.87,0:16:04.83,Default,,0,0,0,,Мен оның өтуіне жол бере алмаймын.
Dialogue: 0,0:16:06.38,0:16:07.54,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:16:08.05,0:16:10.76,Default,,0,0,0,,Мен мұнда патшаға қызмет ету үшін келдім.
Dialogue: 0,0:16:11.63,0:16:13.22,Default,,0,0,0,,Герцог емес!
Dialogue: 0,0:16:14.55,0:16:16.05,Default,,0,0,0,,Йорк үйі...
Dialogue: 0,0:16:16.76,0:16:20.14,Default,,0,0,0,,Патшалық үшін қанын төккен әкемнің шаңырағы.
Dialogue: 0,0:16:20.22,0:16:21.81,Default,,0,0,0,,Біздің оны жоюға шамамыз келмейді.
Dialogue: 0,0:16:22.31,0:16:26.19,Default,,0,0,0,,Бауырым! Өтінемін, қазір өзіңізді патша деп жариялаңыз.
Dialogue: 0,0:16:26.94,0:16:29.98,Default,,0,0,0,,Енді мен сенің пәнің боламын!
Dialogue: 0,0:16:31.82,0:16:32.86,Default,,0,0,0,,Джордж!
Dialogue: 0,0:16:32.95,0:16:34.91,Default,,0,0,0,,Менің бауырым!
Dialogue: 0,0:16:36.03,0:16:39.03,Default,,0,0,0,,Мен сені ажырасқанға дейінгіден он есе артық жақсы көремін.
Dialogue: 0,0:16:39.54,0:16:43.29,Default,,0,0,0,,Менде азғантай өшпенділік болмаған күндермен салыстырғанда.
Dialogue: 0,0:16:43.79,0:16:45.92,Default,,0,0,0,,…
Dialogue: 0,0:16:47.58,0:16:50.55,Default,,0,0,0,,Уорвик және оның достары барлық жерде әскер жинап жатыр.
Dialogue: 0,0:16:51.05,0:16:54.63,Default,,0,0,0,,Жолдан шығып, Лондонға барайық.
Dialogue: 0,0:16:55.47,0:16:58.26,Default,,0,0,0,,Король сарайында жалғыз Генри қалды.
Dialogue: 0,0:16:58.35,0:17:00.39,Default,,0,0,0,,Ішке кіргеннен кейін мынаны аласыз.
Dialogue: 0,0:17:01.14,0:17:02.18,Default,,0,0,0,,Генри...
Dialogue: 0,0:17:06.85,0:17:08.27,Default,,0,0,0,,Лондонға барамыз ба?
Dialogue: 0,0:17:08.90,0:17:12.15,Default,,0,0,0,,Йоркке әскер жинағаннан кейін бірден оңтүстікке қарай бет алу керек.
Dialogue: 0,0:17:12.65,0:17:15.28,Default,,0,0,0,,Джордж-ни-сан одақтас болса ше?
Dialogue: 0,0:17:15.36,0:17:17.16,Default,,0,0,0,,Жиналған сарбаздар саны да өзгереді.
Dialogue: 0,0:17:17.66,0:17:18.57,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:17:19.99,0:17:22.95,Default,,0,0,0,,Генридің емделуін маған қалдырыңыз.
Dialogue: 0,0:17:23.70,0:17:25.08,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:17:25.16,0:17:26.33,Default,,0,0,0,,Егер сіз...
Dialogue: 0,0:17:26.42,0:17:27.62,Default,,0,0,0,,Кэтсби мырза
Dialogue: 0,0:17:28.96,0:17:30.71,Default,,0,0,0,,Хастингс мырза қоңырау шалып жатыр.
Dialogue: 0,0:17:31.59,0:17:35.72,Default,,0,0,0,,Қожайыныңызға оралыңыз, менімен бірге сіздің миссияңыз қазір аяқталуы керек.
Dialogue: 0,0:17:38.80,0:17:40.18,Default,,0,0,0,,Осы қолдармен...
Dialogue: 0,0:17:40.80,0:17:43.60,Default,,0,0,0,,Менің атым Эдвард Плантаженет.
Dialogue: 0,0:17:43.68,0:17:45.68,Default,,0,0,0,,Ол осы елдің заңды патшасы!
Dialogue: 0,0:17:46.52,0:17:50.27,Default,,0,0,0,,Әкемнің жауын жең... Генри
Dialogue: 0,0:17:55.36,0:17:56.99,Default,,0,0,0,,Сен келдің.
Dialogue: 0,0:17:57.49,0:18:00.74,Default,,0,0,0,,Эй, сен маған айта аласың ба?
Dialogue: 0,0:18:01.24,0:18:03.74,Default,,0,0,0,,Мен жаман патша болдым ба?
Dialogue: 0,0:18:04.37,0:18:06.16,Default,,0,0,0,,Мен бірде-бір рет
Dialogue: 0,0:18:06.25,0:18:09.08,Default,,0,0,0,,Халық талабына құлақ аспады
Dialogue: 0,0:18:10.00,0:18:12.46,Default,,0,0,0,,Мен олардың байлығын тартып алған жоқпын.
Dialogue: 0,0:18:12.96,0:18:14.96,Default,,0,0,0,,Оларды қинаған жоқ
Dialogue: 0,0:18:16.05,0:18:20.84,Default,,0,0,0,,Мен... Мен патша болғым келмеді.
Dialogue: 0,0:18:24.52,0:18:26.10,Default,,0,0,0,,Сыртқа шыққыңыз келе ме?
Dialogue: 0,0:18:26.60,0:18:29.52,Default,,0,0,0,,Иә, бүгін ауа райы жақсы.
Dialogue: 0,0:18:30.23,0:18:33.94,Default,,0,0,0,,Кішкене жылынса, гүлдер көбірек гүлдейді.
Dialogue: 0,0:18:34.61,0:18:36.49,Default,,0,0,0,,Сөйтіп, жаз келді
Dialogue: 0,0:18:37.49,0:18:39.86,Default,,0,0,0,,Жемістер өсіп, жапырақтары түсіп қалды.
Dialogue: 0,0:18:41.11,0:18:43.83,Default,,0,0,0,,Сонда мен сені тағы көремін...
Dialogue: 0,0:18:47.62,0:18:49.04,Default,,0,0,0,,Мен сені көріп тұрмын
Dialogue: 0,0:18:51.83,0:18:52.63,Default,,0,0,0,,Генри!
Dialogue: 0,0:18:53.38,0:18:54.29,Default,,0,0,0,,әжесі келіп, оны алып кетуге асығып тұрғандай.
Dialogue: 0,0:18:56.71,0:18:57.84,Default,,0,0,0,,бірақ қанға бөккен қол дәл алдына ұсынылғанда да,
Dialogue: 0,0:18:58.42,0:18:59.30,Default,,0,0,0,,Ричард?
Dialogue: 0,0:18:59.80,0:19:00.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:00.43,0:19:02.68,Default,,0,0,0,,Букингем! Король Генри қайда!
Dialogue: 0,0:19:02.76,0:19:04.56,Default,,0,0,0,,Сіз білуге мүмкіндік жоқ
Dialogue: 0,0:19:04.64,0:19:07.89,Default,,0,0,0,,Мен осы уақытқа дейін Уорвикте түрмеде отырдым.
Dialogue: 0,0:19:11.19,0:19:13.56,Default,,0,0,0,,Күте тұрыңыз! Сен Генриді өлтірмексің бе?
Dialogue: 0,0:19:17.40,0:19:18.15,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,0:19:18.90,0:19:20.53,Default,,0,0,0,,Дереу қашып кетіңіз.
Dialogue: 0,0:19:20.61,0:19:21.70,Default,,0,0,0,,Йорктегілер
Dialogue: 0,0:19:21.78,0:19:23.66,Default,,0,0,0,,Олар ұлы мәртебелі мəртебені ұстау үшін кемеге келді.
Dialogue: 0,0:19:24.78,0:19:29.00,Default,,0,0,0,,Егер мені қазір тұтқынға алсам, Ричардты енді ешқашан көрмес едім...
Dialogue: 0,0:19:29.71,0:19:33.88,Default,,0,0,0,,Жүр, асығыңыз! Енді сіз хаосты пайдаланып, қашып кете аласыз.
Dialogue: 0,0:19:37.46,0:19:38.63,Default,,0,0,0,,Генриге не болды?
Dialogue: 0,0:19:38.71,0:19:41.22,Default,,0,0,0,,Мен сарайды түгел ақтардым, бірақ еш жерден таба алмадым...
Dialogue: 0,0:19:41.30,0:19:42.84,Default,,0,0,0,,Лондонның барлық жерінен іздеңіз!
Dialogue: 0,0:19:42.93,0:19:45.55,Default,,0,0,0,,Оны тапқан адам сыйлық алады!
Dialogue: 0,0:19:46.22,0:19:49.10,Default,,0,0,0,,Қазір Генриді өлтіру жақсы идея емес.
Dialogue: 0,0:19:49.60,0:19:53.23,Default,,0,0,0,,Өзің қалағандай қылсаң, ағайынның сенімінен шығасың.
Dialogue: 0,0:19:55.31,0:19:58.53,Default,,0,0,0,,Сіз адал субъект сияқтысыз.
Dialogue: 0,0:20:00.44,0:20:01.65,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:20:03.16,0:20:04.36,Default,,0,0,0,,Эдвард
Dialogue: 0,0:20:04.95,0:20:06.33,Default,,0,0,0,,Элизабет!
Dialogue: 0,0:20:10.95,0:20:12.25,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,0:20:13.08,0:20:14.58,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:20:14.67,0:20:17.54,Default,,0,0,0,,Эдвард, сіздің ұлыңыз.
Dialogue: 0,0:20:18.05,0:20:18.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:20.13,0:20:22.30,Default,,0,0,0,,О... Құдай!
Dialogue: 0,0:20:24.01,0:20:25.72,Default,,0,0,0,,Осы балаға бата беріңіз
Dialogue: 0,0:20:26.85,0:20:30.10,Default,,0,0,0,,Мұрагер туды, інісі оралды.
Dialogue: 0,0:20:30.97,0:20:33.10,Default,,0,0,0,,Тіпті Эдвард қазір өлсе де
Dialogue: 0,0:20:33.19,0:20:35.85,Default,,0,0,0,,Тақ бірден сенікі болмайды.
Dialogue: 0,0:20:35.94,0:20:38.11,Default,,0,0,0,,Тақты қашан қаладым?
Dialogue: 0,0:20:38.61,0:20:41.19,Default,,0,0,0,,Тек адал болыңыз.
Dialogue: 0,0:20:41.28,0:20:46.24,Default,,0,0,0,,Менің сөзім бір сәтке де жүрегіңді елжіретпеді деп айтпа.
Dialogue: 0,0:20:52.37,0:20:54.62,Default,,0,0,0,,Мен сені осында күттім
Dialogue: 0,0:21:01.34,0:21:05.43,Default,,0,0,0,,Ланкастерді жойып, әкеңіздің жауларынан кек алыңыз.
Dialogue: 0,0:21:05.93,0:21:07.93,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:21:08.60,0:21:11.10,Default,,0,0,0,,Майдан өшсе, менің орным...
Dialogue: 0,0:21:11.18,0:21:15.02,Default,,0,0,0,,Сізде де... мен сияқты өрескел амбицияңыз бар.
Dialogue: 0,0:21:15.10,0:21:18.06,Default,,0,0,0,,Мен жүрегімде лаулап тұр деп ойладым.
Dialogue: 0,0:21:19.61,0:21:21.61,Default,,0,0,0,,Мен өз үмітімде қателескен сияқтымын.
Dialogue: 0,0:21:23.49,0:21:25.99,Default,,0,0,0,,Сіз біздің назарымыздан қалай қашып кеттіңіз?
Dialogue: 0,0:21:26.57,0:21:31.03,Default,,0,0,0,,Олар жақсы қоршаудан өткен болуы керек, Джордж не істеп жатыр?
Dialogue: 0,0:21:32.58,0:21:33.87,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:21:34.37,0:21:37.87,Default,,0,0,0,,Эдвард Лондонды алады ма, әлде Генриді өлтіреді ме
Dialogue: 0,0:21:38.38,0:21:42.50,Default,,0,0,0,,Бұл біздің әскери күшіміздің олардікінен жоғары екендігін өзгертпейді.
Dialogue: 0,0:21:43.55,0:21:44.67,Default,,0,0,0,,Эдвард…
Dialogue: 0,0:21:45.17,0:21:49.01,Default,,0,0,0,,Осы қолдармен басыңды міндетті түрде аламын.
Dialogue: 0,0:22:01.44,0:22:03.44,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.90,0:23:30.90,Default,,0,0,0,,～♪
