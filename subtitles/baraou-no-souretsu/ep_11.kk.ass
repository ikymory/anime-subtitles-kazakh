Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.62,0:00:07.88,Default,,0,0,0,,Соғыстан кейінгі естеліктер есімде жоқ.
Dialogue: 0,0:00:08.67,0:00:09.84,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:00:15.97,0:00:17.26,Default,,0,0,0,,Құрметті Ричард
Dialogue: 0,0:00:19.01,0:00:20.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:20.52,0:00:23.94,Default,,0,0,0,,Мен талай рет қағып едім, таба алмадым...
Dialogue: 0,0:00:25.02,0:00:28.15,Default,,0,0,0,,Шарап әкел, мен суға батып кетемін
Dialogue: 0,0:00:28.73,0:00:31.94,Default,,0,0,0,,Енді жоқ... Басқа жейтін нәрсе.
Dialogue: 0,0:00:32.03,0:00:33.24,Default,,0,0,0,,Бұл тапсырыс!
Dialogue: 0,0:00:33.74,0:00:34.36,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:00:34.45,0:00:35.91,Default,,0,0,0,,Неге үндемедің?
Dialogue: 0,0:00:35.99,0:00:38.87,Default,,0,0,0,,Сіз оның шын тұлғасын білетін шығарсыз.
Dialogue: 0,0:00:40.83,0:00:42.54,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:00:43.04,0:00:48.08,Default,,0,0,0,,Сол күлкіңмен маған сыйладың, мені құшақтап алған қолдарың
Dialogue: 0,0:00:48.59,0:00:51.21,Default,,0,0,0,,Ол маған Йоркты өлтіруді бұйырды.
Dialogue: 0,0:00:51.88,0:00:55.43,Default,,0,0,0,,Сонда да... Сонда да, мен...
Dialogue: 0,0:01:01.51,0:01:03.56,Default,,0,0,0,,Ақ раушан қамыт
Dialogue: 0,0:01:03.64,0:01:05.69,Default,,0,0,0,,Қызыл раушан Ланкастер
Dialogue: 0,0:01:06.19,0:01:12.23,Default,,0,0,0,,Раушан эмблемасы бар король әулеттері арасындағы таққа арналған шайқас
Dialogue: 0,0:01:12.73,0:01:17.53,Default,,0,0,0,,Адамдар оны «Раушангүлдер соғысы» деп атайды.
Dialogue: 0,0:01:21.49,0:01:23.50,Default,,0,0,0,,♪～
Dialogue: 0,0:02:47.37,0:02:49.37,Default,,0,0,0,,～♪
Dialogue: 0,0:02:53.75,0:02:54.54,Default,,0,0,0,,Энтони
Dialogue: 0,0:02:54.63,0:02:56.05,Default,,0,0,0,,Сіздің жараңыз қалай?
Dialogue: 0,0:02:56.55,0:02:58.26,Default,,0,0,0,,Ауыр жарақат алмаса да
Dialogue: 0,0:02:58.76,0:03:01.93,Default,,0,0,0,,Келесі шайқасқа қатысу қиын бола ма деп ойлаймын.
Dialogue: 0,0:03:02.43,0:03:03.14,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:03.80,0:03:08.27,Default,,0,0,0,,Сонымен, Ричардқа не болды? Мен банкетке де келмедім.
Dialogue: 0,0:03:08.77,0:03:11.98,Default,,0,0,0,,Қандай жағдай болмасын, ол соғысқа баруы керек.
Dialogue: 0,0:03:12.77,0:03:14.48,Default,,0,0,0,,Оның қалай өтетінін көрейік.
Dialogue: 0,0:03:14.98,0:03:17.44,Default,,0,0,0,,Сонымен, I
Dialogue: 0,0:03:17.94,0:03:18.94,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:03:20.03,0:03:24.91,Default,,0,0,0,,Менің бұйрығыма бағынбай, Уоррикті өлтірген адамды табыңыз.
Dialogue: 0,0:03:25.41,0:03:28.41,Default,,0,0,0,,Патшаның бұйрығын орындамаған адам жазаланады.
Dialogue: 0,0:03:29.16,0:03:30.46,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:03:31.33,0:03:32.87,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:03:34.17,0:03:36.84,Default,,0,0,0,,Неге... Біз не үшін кездестік?
Dialogue: 0,0:03:37.84,0:03:41.30,Default,,0,0,0,,Егер біз сол күні кездеспеген болсақ, онда...
Dialogue: 0,0:03:47.18,0:03:48.93,Default,,0,0,0,,Эй!
Dialogue: 0,0:03:51.60,0:03:52.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:53.35,0:03:54.94,Default,,0,0,0,,Ұшып кет…
Dialogue: 0,0:03:55.52,0:03:59.11,Default,,0,0,0,,Мен... діннен шығу күнәсін жасадым.
Dialogue: 0,0:03:59.69,0:04:03.07,Default,,0,0,0,,Сонда сіз өзіңізді жазалағыңыз келе ме?
Dialogue: 0,0:04:03.95,0:04:05.03,Default,,0,0,0,,Бұл – тұзақ екенінің дәлелі.
Dialogue: 0,0:04:05.74,0:04:08.83,Default,,0,0,0,,Жарайды, мен сені өлтіремін.
Dialogue: 0,0:04:09.37,0:04:12.58,Default,,0,0,0,,Бірақ егер сен өлсең, Йорк жеңіледі.
Dialogue: 0,0:04:15.92,0:04:17.34,Default,,0,0,0,,Тыңда, Ричард.
Dialogue: 0,0:04:17.84,0:04:20.76,Default,,0,0,0,,Мені сіздің ішкі істеріңіз қызықтырмайды.
Dialogue: 0,0:04:20.84,0:04:23.88,Default,,0,0,0,,Бірақ сіз күштің тірегісіз.
Dialogue: 0,0:04:23.97,0:04:28.26,Default,,0,0,0,,Егер шынымен өмір сүргің келмесе, қазір өл.
Dialogue: 0,0:04:28.76,0:04:31.85,Default,,0,0,0,,Бұл тозақ, сондықтан...
Dialogue: 0,0:04:32.43,0:04:33.94,Default,,0,0,0,,Жынды болыңыз
Dialogue: 0,0:04:35.14,0:04:37.48,Default,,0,0,0,,Тек алдыңыздағы жауды жеңіңіз
Dialogue: 0,0:04:37.98,0:04:40.15,Default,,0,0,0,,Басқа ештеңені ойламаңыз
Dialogue: 0,0:04:40.65,0:04:43.15,Default,,0,0,0,,Ричардты өлтіруді жалғастырыңыз.
Dialogue: 0,0:04:44.61,0:04:46.49,Default,,0,0,0,,Бұл менмін...
Dialogue: 0,0:04:47.99,0:04:50.16,Default,,0,0,0,,Менің жазам
Dialogue: 0,0:04:54.08,0:04:55.54,Default,,0,0,0,,Әке...
Dialogue: 0,0:04:56.96,0:05:01.34,Default,,0,0,0,,Мен соғыста өлу абырой екенін білемін деп ойладым.
Dialogue: 0,0:05:02.05,0:05:03.97,Default,,0,0,0,,Бірақ соңында мен сенімдімін
Dialogue: 0,0:05:04.05,0:05:07.34,Default,,0,0,0,,Олар Йорк тұрғындары әкеме көмектеседі дейді...
Dialogue: 0,0:05:08.05,0:05:10.31,Default,,0,0,0,,Ұрыста өлуде абырой жоқ.
Dialogue: 0,0:05:10.81,0:05:12.93,Default,,0,0,0,,Өлген соң бәрі бітеді
Dialogue: 0,0:05:13.02,0:05:16.94,Default,,0,0,0,,Джордж саған опасыздық жасады, әкең өлтірілді.
Dialogue: 0,0:05:17.81,0:05:19.69,Default,,0,0,0,,Йоркке мейірімділік жоқ.
Dialogue: 0,0:05:21.69,0:05:22.94,Default,,0,0,0,,Мен мұны анық айтамын
Dialogue: 0,0:05:23.44,0:05:26.57,Default,,0,0,0,,Уорвик қайтыс болғаннан кейін жеңіске деген сенімділік жоқ.
Dialogue: 0,0:05:30.78,0:05:33.66,Default,,0,0,0,,Бірақ мен шегінбеймін
Dialogue: 0,0:05:34.16,0:05:37.46,Default,,0,0,0,,Йорктың мақсаты бізді кері қайтару емес.
Dialogue: 0,0:05:37.96,0:05:39.71,Default,,0,0,0,,Өйткені бұл Ланкастердің жойылуы.
Dialogue: 0,0:05:40.79,0:05:43.30,Default,,0,0,0,,Маған неге олай істедің?
Dialogue: 0,0:05:43.80,0:05:48.09,Default,,0,0,0,,Мен бұл елге 15 жасымда Франциядан көшіп келдім.
Dialogue: 0,0:05:48.97,0:05:52.47,Default,,0,0,0,,Сот тұрақсыз Генриді манипуляциялайды.
Dialogue: 0,0:05:52.56,0:05:56.31,Default,,0,0,0,,Бұл сізді тұзаққа түсіруге тырысқан жын-перілердің ұясы еді.
Dialogue: 0,0:05:57.60,0:06:00.23,Default,,0,0,0,,Мен Генриді ешқашан жақсы көрмедім.
Dialogue: 0,0:06:00.73,0:06:03.36,Default,,0,0,0,,Мен шын сүйген адамды Құдай алып кетті.
Dialogue: 0,0:06:05.03,0:06:08.74,Default,,0,0,0,,Менде Эдвард бар
Dialogue: 0,0:06:09.74,0:06:12.62,Default,,0,0,0,,Анна, сен мейірімді қызсың.
Dialogue: 0,0:06:13.12,0:06:15.54,Default,,0,0,0,,Сізде Эдвардқа деген сезімдер пайда бола бастады.
Dialogue: 0,0:06:17.37,0:06:21.04,Default,,0,0,0,,Йорктың бұл баланың өмірін алуына жол берме.
Dialogue: 0,0:06:21.71,0:06:25.25,Default,,0,0,0,,Эдвард... Сол бала тірі болса ғой.
Dialogue: 0,0:06:26.09,0:06:29.93,Default,,0,0,0,,Ланкастер күлден көтерілуі мүмкін
Dialogue: 0,0:06:31.01,0:06:33.89,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,0:06:34.39,0:06:35.85,Default,,0,0,0,,Ұрыс басталғаннан кейін...
Dialogue: 0,0:06:35.93,0:06:38.14,Default,,0,0,0,,Ұрысқа қатысуға рұқсат етілмейді
Dialogue: 0,0:06:38.23,0:06:39.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:42.48,0:06:43.82,Default,,0,0,0,,Қалғаны менің аузымнан.
Dialogue: 0,0:06:43.90,0:06:45.73,Default,,0,0,0,,Мен бұлай айта алмаймын.
Dialogue: 0,0:06:46.53,0:06:49.86,Default,,0,0,0,,Жарайды, Энн, бұл бұйрық емес.
Dialogue: 0,0:06:51.91,0:06:56.16,Default,,0,0,0,,Мен Эдвардтың өмірін саған сеніп тапсырамын.
Dialogue: 0,0:06:58.41,0:07:00.67,Default,,0,0,0,,Мырзалар, тыңдаңыздар!
Dialogue: 0,0:07:01.21,0:07:04.13,Default,,0,0,0,,Енді сіздің лорд Генри тұтқынға алынды.
Dialogue: 0,0:07:04.63,0:07:09.26,Default,,0,0,0,,Оның билігі тартып алынып, аумағы өлім жазасына кесілетін орынға айналдырылды.
Dialogue: 0,0:07:10.09,0:07:13.47,Default,,0,0,0,,Ах... Көз жасым сөзімді тартып алмақшы
Dialogue: 0,0:07:14.14,0:07:17.64,Default,,0,0,0,,Шынында да, Уорвик графы біздің зәкіріміз болды.
Dialogue: 0,0:07:18.22,0:07:19.48,Default,,0,0,0,,Бірақ бұл не?
Dialogue: 0,0:07:20.31,0:07:23.94,Default,,0,0,0,,Діңгек сынып, якорь кетіп қалса да
Dialogue: 0,0:07:24.02,0:07:25.77,Default,,0,0,0,,Міне, мен келдім
Dialogue: 0,0:07:26.27,0:07:28.40,Default,,0,0,0,,Міне, патша қаны бар ханзада!
Dialogue: 0,0:07:29.36,0:07:32.86,Default,,0,0,0,,Құдайдың атымен батыл бол
Dialogue: 0,0:07:33.70,0:07:37.99,Default,,0,0,0,,Қызыл раушан гүлді жақсы көретіндер, Жеңіске аттаныңдар!
Dialogue: 0,0:07:38.08,0:07:40.16,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:07:43.25,0:07:46.50,Default,,0,0,0,,Балалар, сендер шайқасқа дайынсыңдар ма?
Dialogue: 0,0:07:47.75,0:07:49.96,Default,,0,0,0,,Мен осы сәтті күттім
Dialogue: 0,0:07:51.51,0:07:55.14,Default,,0,0,0,,Атты тарт! Қанның туын желбірет!
Dialogue: 0,0:07:55.80,0:07:59.39,Default,,0,0,0,,Абыроймен жеңу немесе өлім!
Dialogue: 0,0:08:13.40,0:08:15.87,Default,,0,0,0,,Енді секіріңіз
Dialogue: 0,0:08:15.95,0:08:19.33,Default,,0,0,0,,Мен толық сауыт киген Йорк жауынгерін жеңгім келеді.
Dialogue: 0,0:08:21.75,0:08:24.62,Default,,0,0,0,,Эдвард, қазір қаш.
Dialogue: 0,0:08:25.54,0:08:26.75,Default,,0,0,0,,Не айтасыз...
Dialogue: 0,0:08:26.83,0:08:30.67,Default,,0,0,0,,Мен де сенің орныңа майданда тұратын Қагемүшені шештім.
Dialogue: 0,0:08:30.76,0:08:32.92,Default,,0,0,0,,Сенің есі дұрыс па? Бұл әзіл болса керек...
Dialogue: 0,0:08:33.01,0:08:35.05,Default,,0,0,0,,Ланкастердің қанын қорғау.
Dialogue: 0,0:08:37.26,0:08:40.10,Default,,0,0,0,,Сен... тек сен
Dialogue: 0,0:08:40.93,0:08:44.23,Default,,0,0,0,,Сіз менің сезімімді түсіндіңіз деп ойладым.
Dialogue: 0,0:08:45.35,0:08:49.15,Default,,0,0,0,,Егер жеңілсең, Йорк халқы сені өлтіреді.
Dialogue: 0,0:08:50.19,0:08:52.28,Default,,0,0,0,,Әкесі де өлтірілді.
Dialogue: 0,0:08:52.90,0:08:56.16,Default,,0,0,0,,Анасы мен Изабель қазір жоқ.
Dialogue: 0,0:08:56.99,0:09:00.66,Default,,0,0,0,,Сіз жалғыз отбасысыз...
Dialogue: 0,0:09:02.16,0:09:03.87,Default,,0,0,0,,Бұл шайқаста жеңсек...
Dialogue: 0,0:09:04.50,0:09:06.54,Default,,0,0,0,,Жоқ, мен жеңетініме сенімдімін.
Dialogue: 0,0:09:07.04,0:09:12.09,Default,,0,0,0,,Ұлы патша дүниеге келді, ол бірінші шайқас ретінде тарихта қалады.
Dialogue: 0,0:09:12.88,0:09:17.68,Default,,0,0,0,,Сен... менің өмірімдегі бірінші... досымсың.
Dialogue: 0,0:09:18.68,0:09:19.80,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:09:20.43,0:09:23.68,Default,,0,0,0,,А... Мен бүгін түнде ұйықтай алмаймын деп ойлаймын.
Dialogue: 0,0:09:24.52,0:09:28.56,Default,,0,0,0,,Шахмат ойнаймыз ба? Ертеңгі шайқасқа жалған жаттығу үшін
Dialogue: 0,0:09:30.48,0:09:31.27,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:32.86,0:09:36.03,Default,,0,0,0,,Кешіріңіз... Эдвард
Dialogue: 0,0:09:39.41,0:09:41.78,Default,,0,0,0,,Қарап көріңізші, Маргарет.
Dialogue: 0,0:09:42.29,0:09:44.12,Default,,0,0,0,,Енді жау еңістің астында қалды.
Dialogue: 0,0:09:44.62,0:09:47.87,Default,,0,0,0,,Оның үстіне маңдайы мен артқы жағы бұталар мен тікенектермен қоршалған жағдайда болды.
Dialogue: 0,0:09:47.96,0:09:49.88,Default,,0,0,0,,Лагерь құруға мәжбүр болды
Dialogue: 0,0:09:50.54,0:09:54.76,Default,,0,0,0,,Жарайсың. Мен барлық бұйрықты сізге қалдырамын.
Dialogue: 0,0:09:54.84,0:09:57.17,Default,,0,0,0,,Бірақ Мәртебелі тақ мұрагері ше?
Dialogue: 0,0:09:57.26,0:09:59.05,Default,,0,0,0,,Ханзада әлі жетілмеген.
Dialogue: 0,0:09:59.55,0:10:02.85,Default,,0,0,0,,Мен саған еріп, іліміңді ізде деп айттым.
Dialogue: 0,0:10:04.10,0:10:05.39,Default,,0,0,0,,Жақсы, Эдвард.
Dialogue: 0,0:10:05.89,0:10:07.48,Default,,0,0,0,,О, Ланкастер!
Dialogue: 0,0:10:07.98,0:10:10.40,Default,,0,0,0,,Мен лагерьді осынша жақсы құра аламын деп ойламадым.
Dialogue: 0,0:10:10.98,0:10:13.69,Default,,0,0,0,,Бірақ Йоркте мораль жоғарырақ.
Dialogue: 0,0:10:13.77,0:10:16.32,Default,,0,0,0,,Хабарланғандай, зеңбіректер саны да
Dialogue: 0,0:10:16.40,0:10:18.99,Default,,0,0,0,,Бірақ олардың сарбаздары көбірек!
Dialogue: 0,0:10:19.49,0:10:20.41,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:10:21.03,0:10:21.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:23.03,0:10:24.91,Default,,0,0,0,,Менің жоспарым бар
Dialogue: 0,0:10:40.22,0:10:43.43,Default,,0,0,0,,Елтаңбаларында ақ раушан гүлдері бар жауынгерлер
Dialogue: 0,0:10:43.93,0:10:48.06,Default,,0,0,0,,Осы ұзақ шайқасты шешетін уақыт келді!
Dialogue: 0,0:10:49.31,0:10:53.44,Default,,0,0,0,,Мен алған жаралар, өлтірілген одақтастарымның жаны,
Dialogue: 0,0:10:53.94,0:10:56.61,Default,,0,0,0,,Әкеңнің өкінішін ұмытпа!
Dialogue: 0,0:10:57.53,0:11:00.15,Default,,0,0,0,,Йорктың тәжге деген заңды талабы
Dialogue: 0,0:11:01.20,0:11:04.83,Default,,0,0,0,,Бүгін осы ұрыс даласында қылышпен дәлелдеймін!
Dialogue: 0,0:11:04.91,0:11:09.29,Default,,0,0,0,,Йорк! Йорк!
Dialogue: 0,0:11:09.37,0:11:13.17,Default,,0,0,0,,Букингем Орманда бәрі тәртіппен ме?
Dialogue: 0,0:11:13.25,0:11:15.25,Default,,0,0,0,,Нұсқау бойынша.
Dialogue: 0,0:11:16.88,0:11:19.47,Default,,0,0,0,,Сонымен... соғыс басталады.
Dialogue: 0,0:11:19.55,0:11:21.01,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:11:21.09,0:11:24.18,Default,,0,0,0,,Түсіруді жалғастырыңыз! Жауға бір сәтке де еркіндік берме!
Dialogue: 0,0:11:24.26,0:11:25.89,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:11:28.43,0:11:30.31,Default,,0,0,0,,Снарядтар күткеннен көп
Dialogue: 0,0:11:30.81,0:11:33.19,Default,,0,0,0,,Олар тез шыдамсызданып барады
Dialogue: 0,0:11:33.85,0:11:35.15,Default,,0,0,0,,Құрметті Ричард!
Dialogue: 0,0:11:35.65,0:11:37.98,Default,,0,0,0,,Бұл! Жаудың оң қанаты!
Dialogue: 0,0:11:38.57,0:11:39.53,Default,,0,0,0,,(Ойын музыкасы ұялы телефоннан ойнап тұр)
Dialogue: 0,0:11:40.32,0:11:42.70,Default,,0,0,0,,Құрылымды солға жылжытыңыз! Бұрылыңыз!
Dialogue: 0,0:11:42.78,0:11:45.16,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:11:45.74,0:11:46.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:47.87,0:11:49.87,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:11:49.95,0:11:51.71,Default,,0,0,0,,Тыныш жатуыңызды өтінемін.
Dialogue: 0,0:11:52.21,0:11:53.71,Default,,0,0,0,,Міне... Ха!
Dialogue: 0,0:11:53.79,0:11:55.92,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:11:56.50,0:11:59.00,Default,,0,0,0,,Менің сауытым қайда? Менің қылышым!
Dialogue: 0,0:11:59.09,0:12:00.05,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:00.13,0:12:03.63,Default,,0,0,0,,Соғыс шешілгенше осы бөлмеде болыңыз.
Dialogue: 0,0:12:04.39,0:12:07.10,Default,,0,0,0,,Қарғыс атсын... Бұл Энннің жұмысы ма?
Dialogue: 0,0:12:09.52,0:12:11.35,Default,,0,0,0,,Соғыс әлі біткен жоқ.
Dialogue: 0,0:12:11.85,0:12:13.52,Default,,0,0,0,,Күте тұрыңыз, Йорк!
Dialogue: 0,0:12:13.60,0:12:17.48,Default,,0,0,0,,(сарбаздардың ұрыс дауыстары)
Dialogue: 0,0:12:18.32,0:12:19.65,Default,,0,0,0,,Бір қадам артқа шегінбеңіз!
Dialogue: 0,0:12:20.78,0:12:22.86,Default,,0,0,0,,Жүрегіңді ашу билесін
Dialogue: 0,0:12:22.95,0:12:25.11,Default,,0,0,0,,Қылыш, әлі түңілме!
Dialogue: 0,0:12:27.16,0:12:29.79,Default,,0,0,0,,А... Сіз одақтассыз ба?
Dialogue: 0,0:12:31.58,0:12:33.33,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:12:36.00,0:12:37.08,Default,,0,0,0,,Сіз...
Dialogue: 0,0:12:38.21,0:12:39.50,Default,,0,0,0,,Ричард!
Dialogue: 0,0:12:40.80,0:12:42.09,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:12:42.17,0:12:45.59,Default,,0,0,0,,Уф... Сөйлесуге уақыт жоқ па деп қорқамын.
Dialogue: 0,0:12:45.68,0:12:48.18,Default,,0,0,0,,Кет ол жерден, мен сені қимаймын!
Dialogue: 0,0:12:48.26,0:12:51.02,Default,,0,0,0,,Сіз Ланкастердің жағына шықтыңыз ба?
Dialogue: 0,0:12:51.10,0:12:52.64,Default,,0,0,0,,Олай болса, өтуге ешқандай себеп жоқ!
Dialogue: 0,0:12:54.14,0:12:54.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:54.94,0:12:56.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:56.65,0:12:57.65,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:12:58.98,0:13:01.23,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:13:01.32,0:13:03.82,Default,,0,0,0,,Күте тұрыңыз! Неге ұрыспайсың?
Dialogue: 0,0:13:04.78,0:13:07.03,Default,,0,0,0,,Бұл... (Ричард) Өлімнен қорқасың ба?
Dialogue: 0,0:13:07.11,0:13:08.12,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:26.68,0:13:30.39,Default,,0,0,0,,Ричард, мен сенімен күресе алмаймын.
Dialogue: 0,0:13:31.10,0:13:32.64,Default,,0,0,0,,Сіз туралы...
Dialogue: 0,0:13:32.72,0:13:33.43,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:13:33.52,0:13:34.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:39.40,0:13:40.61,Default,,0,0,0,,Ричард…
Dialogue: 0,0:13:41.82,0:13:44.19,Default,,0,0,0,,Тек сонда жат.
Dialogue: 0,0:13:46.11,0:13:47.03,Default,,0,0,0,,Ричард!
Dialogue: 0,0:13:47.53,0:13:50.41,Default,,0,0,0,,(Солдаттардың ұрыс дауысы)
Dialogue: 0,0:13:50.49,0:13:52.33,Default,,0,0,0,,Тірекке не болды?
Dialogue: 0,0:13:52.41,0:13:53.45,Default,,0,0,0,,Осы қарқынмен біздің команда...
Dialogue: 0,0:13:53.54,0:13:55.58,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:13:56.87,0:13:59.54,Default,,0,0,0,,Ричард... Қат!
Dialogue: 0,0:14:00.17,0:14:02.09,Default,,0,0,0,,Қараңдар! Жау қашып кетті!
Dialogue: 0,0:14:02.17,0:14:05.55,Default,,0,0,0,,Жау толығымен жойылды. Олардың барлығын бірден қиратыңыз!
Dialogue: 0,0:14:05.63,0:14:09.93,Default,,0,0,0,,(Солдаттардың ұрыс дауысы)
Dialogue: 0,0:14:13.18,0:14:15.27,Default,,0,0,0,,Бірде-бір Ланкастердің қашып кетуіне жол берме!
Dialogue: 0,0:14:15.35,0:14:17.02,Default,,0,0,0,,Мені бұрап өлтір!
Dialogue: 0,0:14:17.73,0:14:20.23,Default,,0,0,0,,Ланкастер ханзадасы қашып барады!
Dialogue: 0,0:14:24.15,0:14:25.44,Default,,0,0,0,,Құрметті Маргарет!
Dialogue: 0,0:14:25.53,0:14:26.61,Default,,0,0,0,,Қашып кетіңізші...
Dialogue: 0,0:14:28.20,0:14:30.82,Default,,0,0,0,,Одақтастар қалмады.
Dialogue: 0,0:14:31.62,0:14:35.49,Default,,0,0,0,,Мен Йорктың қарақшы командирінен қорқамын деп ойлайсың ба?
Dialogue: 0,0:14:37.50,0:14:40.54,Default,,0,0,0,,Енді маған жол көрсетіңіз, жазалаушы.
Dialogue: 0,0:14:41.04,0:14:46.46,Default,,0,0,0,,Құдай таңдаған патшайымды арам қолдарыңызбен өлтіріңіз.
Dialogue: 0,0:14:50.13,0:14:51.97,Default,,0,0,0,,Маргарет тұтқынға алынды.
Dialogue: 0,0:14:52.05,0:14:53.64,Default,,0,0,0,,Бұл біздің жеңісіміз!
Dialogue: 0,0:14:53.72,0:14:55.97,Default,,0,0,0,,Жоқ, ханзада әлі қашуда.
Dialogue: 0,0:14:56.06,0:14:57.31,Default,,0,0,0,,Ханзада?
Dialogue: 0,0:14:57.39,0:15:00.44,Default,,0,0,0,,Анна Кагемушаны дайындағанын айтты...
Dialogue: 0,0:15:00.52,0:15:01.15,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:15:05.23,0:15:09.53,Default,,0,0,0,,Жарайды, мен қашып кете аламын. Ат үстінде ешкімді жеңе алмаймын.
Dialogue: 0,0:15:10.07,0:15:13.82,Default,,0,0,0,,Енді мүмкіндігінше алыс... Эдвард!
Dialogue: 0,0:15:17.37,0:15:19.54,Default,,0,0,0,,Маргарет ханзаданың қашып кетуін қалады.
Dialogue: 0,0:15:19.62,0:15:20.79,Default,,0,0,0,,Ол қамауға алынған болуы керек.
Dialogue: 0,0:15:21.29,0:15:22.63,Default,,0,0,0,,Біз де ханзаданы қуамыз!
Dialogue: 0,0:15:23.25,0:15:26.09,Default,,0,0,0,,Энн мен сені менің орныма алады деп күтпедім...
Dialogue: 0,0:15:26.92,0:15:28.80,Default,,0,0,0,,Ланкастердің қанын қорғау үшін.
Dialogue: 0,0:15:29.76,0:15:31.80,Default,,0,0,0,,Анамның жұмысы ма...
Dialogue: 0,0:15:32.55,0:15:37.77,Default,,0,0,0,,Қылышты бермей, әйелімді құрбандыққа шал, жауға арқамды қайырып, қаш...
Dialogue: 0,0:15:37.85,0:15:39.10,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:15:39.18,0:15:42.02,Default,,0,0,0,,Мені кім деп ойлайсың?
Dialogue: 0,0:15:48.61,0:15:49.94,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:15:51.32,0:15:53.28,Default,,0,0,0,,Ланкастерлік Эдвард.
Dialogue: 0,0:15:53.36,0:15:54.24,Default,,0,0,0,,Сол дауыс…
Dialogue: 0,0:15:54.32,0:15:57.49,Default,,0,0,0,,Дәл қазір басыңды анаңа жеткіземін.
Dialogue: 0,0:15:57.58,0:15:58.49,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:15:58.99,0:16:00.37,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:16:02.96,0:16:04.63,Default,,0,0,0,,Эдвард... неге!
Dialogue: 0,0:16:05.67,0:16:06.34,Default,,0,0,0,,Анн?
Dialogue: 0,0:16:07.46,0:16:08.55,Default,,0,0,0,,Ричард…
Dialogue: 0,0:16:09.38,0:16:14.34,Default,,0,0,0,,Тыңдаңыз! Бұл елдің заңды патшасы Генрих VI оның үлкен ұлы.
Dialogue: 0,0:16:14.43,0:16:18.22,Default,,0,0,0,,Мен мұрагер ханзада Эдвардпын!
Dialogue: 0,0:16:19.06,0:16:21.06,Default,,0,0,0,,Сіз тақ мұрагерісіз бе?
Dialogue: 0,0:16:22.27,0:16:24.52,Default,,0,0,0,,Қаш! Жүгір, Эдвард!
Dialogue: 0,0:16:31.19,0:16:32.53,Default,,0,0,0,,Ланкастер
Dialogue: 0,0:16:33.20,0:16:36.74,Default,,0,0,0,,Сіз неше рет...
Dialogue: 0,0:16:48.21,0:16:50.21,Default,,0,0,0,,Қастарыңызды қозғалтпаңыз.
Dialogue: 0,0:16:50.84,0:16:53.67,Default,,0,0,0,,Сабырлы болып, тағдырыңа мойынсұн
Dialogue: 0,0:16:54.17,0:16:57.34,Default,,0,0,0,,Бұл қандай тағдыр?
Dialogue: 0,0:16:57.85,0:16:59.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:01.52,0:17:02.73,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:17:03.35,0:17:05.14,Default,,0,0,0,,Неге мұндасың...
Dialogue: 0,0:17:05.77,0:17:08.23,Default,,0,0,0,,Ана, мен қазірдің өзінде
Dialogue: 0,0:17:08.31,0:17:10.40,Default,,0,0,0,,Мен сенімен қолымнан ұстап жүрген бала емеспін
Dialogue: 0,0:17:12.36,0:17:13.86,Default,,0,0,0,,Ақымақ нәрсе жасаңыз
Dialogue: 0,0:17:14.99,0:17:18.62,Default,,0,0,0,,Йорк ұлдары! ханзада әлі бала
Dialogue: 0,0:17:18.70,0:17:21.41,Default,,0,0,0,,Мен сенің жек көруіңе лайық емеспін.
Dialogue: 0,0:17:21.49,0:17:23.91,Default,,0,0,0,,Кек алғың келсе, маған істе
Dialogue: 0,0:17:24.00,0:17:27.71,Default,,0,0,0,,Өйткені әкеңнің басын кескен менмін!
Dialogue: 0,0:17:28.79,0:17:30.21,Default,,0,0,0,,Ұмытпа
Dialogue: 0,0:17:30.88,0:17:35.17,Default,,0,0,0,,Әкең жылап өлді.
Dialogue: 0,0:17:35.76,0:17:37.13,Default,,0,0,0,,Ланкастер
Dialogue: 0,0:17:37.22,0:17:39.51,Default,,0,0,0,,А, мен ұмытпаймын.
Dialogue: 0,0:17:40.01,0:17:44.27,Default,,0,0,0,,Тәкаппар бүлікшінің жәндік тәрізді соңы
Dialogue: 0,0:17:44.77,0:17:47.10,Default,,0,0,0,,Көз жасына боялған бейшара мойын
Dialogue: 0,0:17:47.19,0:17:49.31,Default,,0,0,0,,Ланкастер!
Dialogue: 0,0:17:49.40,0:17:52.44,Default,,0,0,0,,Өз қолыммен кесіп тастаған сәт!
Dialogue: 0,0:17:52.94,0:17:57.03,Default,,0,0,0,,Ойлаған сайын бұл жүрек әлі де жадырап тұрады.
Dialogue: 0,0:17:57.61,0:17:59.95,Default,,0,0,0,,Әкеңнің ақымақ өлімі!
Dialogue: 0,0:18:00.03,0:18:02.99,Default,,0,0,0,,Аузыңды жап! Мен бұл жүректі дәл қазір тоқтатамын!
Dialogue: 0,0:18:03.08,0:18:04.04,Default,,0,0,0,,Күте тұрыңыз, Джордж.
Dialogue: 0,0:18:04.12,0:18:07.41,Default,,0,0,0,,Өлемін дегендерге садақа.
Dialogue: 0,0:18:07.50,0:18:08.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:08.08,0:18:11.08,Default,,0,0,0,,Дұға ет, Ланкастер ханзадасы.
Dialogue: 0,0:18:11.17,0:18:15.13,Default,,0,0,0,,Күте тұрыңыз! асылу! Ханзада маған ұқсамайтын мейірімді.
Dialogue: 0,0:18:15.63,0:18:17.63,Default,,0,0,0,,Йорк үшін дұға ет
Dialogue: 0,0:18:17.72,0:18:19.93,Default,,0,0,0,,Дұға ет, дұға ет, Эдвард!
Dialogue: 0,0:18:25.31,0:18:28.44,Default,,0,0,0,,Сіз патша болатын адамсыз, Эдвард.
Dialogue: 0,0:18:30.85,0:18:33.19,Default,,0,0,0,,Жақында шайқас болады.
Dialogue: 0,0:18:33.27,0:18:34.73,Default,,0,0,0,,Қай жағын алуым керек...
Dialogue: 0,0:18:34.82,0:18:36.19,Default,,0,0,0,,(вазаның сынған дыбысы)
Dialogue: 0,0:18:36.28,0:18:38.78,Default,,0,0,0,,Лорд Эдвард! Сіз не істедіңіз?
Dialogue: 0,0:18:44.70,0:18:45.66,Default,,0,0,0,,Патшаға...
Dialogue: 0,0:18:45.74,0:18:47.54,Default,,0,0,0,,Анашым, қараңызшы.
Dialogue: 0,0:18:47.62,0:18:49.29,Default,,0,0,0,,Мен ұлы патша боламын!
Dialogue: 0,0:18:50.58,0:18:52.17,Default,,0,0,0,,Мен патша болатыныма сенімдімін
Dialogue: 0,0:18:53.00,0:18:55.00,Default,,0,0,0,,Барлығы маған қарайды
Dialogue: 0,0:19:06.43,0:19:08.77,Default,,0,0,0,,Тақырып сияқты сөйле
Dialogue: 0,0:19:10.02,0:19:11.48,Default,,0,0,0,,Сіз не туралы айтып отырсыз ...
Dialogue: 0,0:19:11.56,0:19:13.19,Default,,0,0,0,,Тізе бер, менсінбей!
Dialogue: 0,0:19:13.77,0:19:16.48,Default,,0,0,0,,Эдвард Лечер Джордж сатқын
Dialogue: 0,0:19:16.57,0:19:19.74,Default,,0,0,0,,Бүлікшілердің қанына сіңген тұтқындар!
Dialogue: 0,0:19:19.82,0:19:22.07,Default,,0,0,0,,Мен сенің патшаңмын!
Dialogue: 0,0:19:22.16,0:19:23.20,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:19:27.16,0:19:30.75,Default,,0,0,0,,Егер сіз патша болсаңыз, бәрі орындалады.
Dialogue: 0,0:19:32.83,0:19:36.21,Default,,0,0,0,,Хмм... сатқын...
Dialogue: 0,0:19:36.30,0:19:38.30,Default,,0,0,0,,Әй, Эдвард! Эдвард!
Dialogue: 0,0:19:38.38,0:19:43.14,Default,,0,0,0,,Мені де қазір өлтір! Неге мені өлтірмейсің? Сен сондай қыңырсың!
Dialogue: 0,0:19:43.22,0:19:45.43,Default,,0,0,0,,Иә, Ричард, ол қайда?
Dialogue: 0,0:19:45.51,0:19:48.10,Default,,0,0,0,,Қан сұрағанды ​​шайтан қайтармайды!
Dialogue: 0,0:19:48.18,0:19:51.56,Default,,0,0,0,,Ричард қазір тозақта.
Dialogue: 0,0:19:51.64,0:19:54.06,Default,,0,0,0,,Ланкастер жойылмайынша.
Dialogue: 0,0:19:55.86,0:19:58.57,Default,,0,0,0,,Тыныс алу ауырады...
Dialogue: 0,0:19:59.36,0:20:04.16,Default,,0,0,0,,Бұл соңы ма? Менің барлық тілектерім орындалмай қалады.
Dialogue: 0,0:20:05.70,0:20:08.08,Default,,0,0,0,,Тәжге мән бермедім.
Dialogue: 0,0:20:08.16,0:20:11.83,Default,,0,0,0,,Негізі... мен шынымен де қалағаным...
Dialogue: 0,0:20:14.04,0:20:17.54,Default,,0,0,0,,Мен шынымен орындағым келетін бір тілек бар.
Dialogue: 0,0:20:33.56,0:20:35.85,Default,,0,0,0,,Ричард, келдің бе?
Dialogue: 0,0:20:38.52,0:20:40.61,Default,,0,0,0,,Соңғы бір нәрсе жеткілікті
Dialogue: 0,0:20:43.28,0:20:44.95,Default,,0,0,0,,Тыңда, Ричард.
Dialogue: 0,0:20:45.45,0:20:48.24,Default,,0,0,0,,Маған ұнайсың
Dialogue: 0,0:20:53.08,0:20:55.00,Default,,0,0,0,,Ең болмаса қолдарыңызбен...
Dialogue: 0,0:20:56.00,0:20:59.38,Default,,0,0,0,,Мен оны сіздің қолдарыңызбен аяқтағым келеді.
Dialogue: 0,0:21:12.81,0:21:15.94,Default,,0,0,0,,Мені де... тез өлтір
Dialogue: 0,0:21:16.02,0:21:17.90,Default,,0,0,0,,О, мен сені өлтіремін.
Dialogue: 0,0:21:17.98,0:21:18.98,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:21:19.56,0:21:22.57,Default,,0,0,0,,Сіз тым алыс кеттіңіз.
Dialogue: 0,0:21:22.65,0:21:25.70,Default,,0,0,0,,Неліктен? Бәріне кінәлі осы әйел...
Dialogue: 0,0:21:25.78,0:21:28.66,Default,,0,0,0,,Сондықтан өлім жылы болады
Dialogue: 0,0:21:29.83,0:21:33.70,Default,,0,0,0,,Маргарет Үмітсіз өмір сүреді
Dialogue: 0,0:21:39.13,0:21:40.46,Default,,0,0,0,,О, Эдвард
Dialogue: 0,0:21:41.21,0:21:43.13,Default,,0,0,0,,Менің сүйікті ұлым
Dialogue: 0,0:21:43.21,0:21:46.30,Default,,0,0,0,,Сен неге өлтірілдің, ал мен ғана...
Dialogue: 0,0:21:46.80,0:21:50.93,Default,,0,0,0,,Ах! Өлтір! Мені қазір өлтір!
Dialogue: 0,0:22:01.48,0:22:03.48,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:30.95,Default,,0,0,0,,～♪
