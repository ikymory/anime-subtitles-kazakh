Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:46.08,0:00:53.04,Default,,0,0,0,,NETFLIX түпнұсқа фильмдері
Dialogue: 0,0:01:03.00,0:01:05.62,Default,,0,0,0,,Кейбір балықтар бар, оларды ұстауға болмайды.
Dialogue: 0,0:01:07.25,0:01:08.83,Default,,0,0,0,,Өйткені ол аспанға жатады
Dialogue: 0,0:01:12.87,0:01:17.58,Default,,0,0,0,,Солтүстік теңізде Кун деген балық болған.
Dialogue: 0,0:01:17.87,0:01:23.00,Default,,0,0,0,,Оның ұзындығы мыңдаған ли және өлшеу үшін тым үлкен.
Dialogue: 0,0:01:33.25,0:01:34.54,Default,,0,0,0,,Біз кімбіз?
Dialogue: 0,0:01:35.83,0:01:37.16,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:01:38.04,0:01:39.41,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:01:45.04,0:01:47.20,Default,,0,0,0,,Бұл туралы ешкім ойлағысы келмейді
Dialogue: 0,0:01:48.54,0:01:51.20,Default,,0,0,0,,Күн сайын жұмысқа барыңыз
Dialogue: 0,0:01:52.00,0:01:53.70,Default,,0,0,0,,Күнде күлу
Dialogue: 0,0:01:54.91,0:01:55.91,Default,,0,0,0,,Шағымдану
Dialogue: 0,0:01:56.00,0:01:57.00,Default,,0,0,0,,Сауда
Dialogue: 0,0:01:57.12,0:01:57.95,Default,,0,0,0,,Мен сені нашар өтірікші деп ойлайтынмын.
Dialogue: 0,0:01:58.25,0:01:59.08,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:02:03.54,0:02:05.62,Default,,0,0,0,,Бір ғасыр өтті
Dialogue: 0,0:02:06.62,0:02:10.00,Default,,0,0,0,,Мен қазір жүз он жеті жастамын.
Dialogue: 0,0:02:11.83,0:02:14.54,Default,,0,0,0,,Мен әрқашан айтамын
Dialogue: 0,0:02:15.66,0:02:17.95,Default,,0,0,0,,Барлық адамдар-
Dialogue: 0,0:02:18.70,0:02:22.41,Default,,0,0,0,,Бұл теңізден туған үлкен балық.
Dialogue: 0,0:02:23.54,0:02:24.83,Default,,0,0,0,,Өмір - бұл саяхат
Dialogue: 0,0:02:25.62,0:02:28.20,Default,,0,0,0,,Теңізден өту
Dialogue: 0,0:02:33.12,0:02:34.87,Default,,0,0,0,,Ешкім тыңдамайды
Dialogue: 0,0:02:35.54,0:02:37.20,Default,,0,0,0,,Қарт пен келеке
Dialogue: 0,0:02:39.70,0:02:41.37,Default,,0,0,0,,Армандар әлі де жарқын
Dialogue: 0,0:02:42.20,0:02:44.87,Default,,0,0,0,,Үлкен балық...
Dialogue: 0,0:02:45.25,0:02:46.70,Default,,0,0,0,,Аспаннан түскен сурет
Dialogue: 0,0:02:47.75,0:02:49.79,Default,,0,0,0,,маған қоңырау шалып жатыр
Dialogue: 0,0:02:51.83,0:02:55.75,Default,,0,0,0,,Әдемі дауыс естеліктерді елжіретеді
Dialogue: 0,0:03:05.70,0:03:07.66,Default,,0,0,0,,4,5 млрд жыл бұрын
Dialogue: 0,0:03:08.50,0:03:12.50,Default,,0,0,0,,Бұл планетада тек мұхит пен алып балықтар ғана бар.
Dialogue: 0,0:03:13.20,0:03:15.33,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:17.04,0:03:19.83,Default,,0,0,0,,Балықтар – адамның жаны
Dialogue: 0,0:03:21.29,0:03:24.04,Default,,0,0,0,,Мен дүниеге келген сәттен бастап
Dialogue: 0,0:03:24.91,0:03:26.91,Default,,0,0,0,,Фейристің D-хаты болар.
Dialogue: 0,0:03:32.33,0:03:33.45,Default,,0,0,0,,Мен Чунмын
Dialogue: 0,0:03:34.25,0:03:36.25,Default,,0,0,0,,Мен теңіз асты әлемінен келдім.
Dialogue: 0,0:03:37.25,0:03:38.58,Default,,0,0,0,,Адам әлемі-
Dialogue: 0,0:03:39.08,0:03:41.45,Default,,0,0,0,,Аспан мен теңіз асты әлемінің арасы
Dialogue: 0,0:03:43.33,0:03:46.45,Default,,0,0,0,,Адам әлемін кезгеннен кейін-
Dialogue: 0,0:03:47.79,0:03:51.50,Default,,0,0,0,,Жан ақыры көкке жетеді
Dialogue: 0,0:03:53.25,0:03:55.58,Default,,0,0,0,,Адамның ақыл-ойы мен табиғаты -
Dialogue: 0,0:03:56.41,0:03:59.58,Default,,0,0,0,,Тәртіпті сақтау біздің міндетіміз.
Dialogue: 0,0:04:01.16,0:04:02.62,Default,,0,0,0,,Тіпті адам емес-
Dialogue: 0,0:04:03.12,0:04:04.33,Default,,0,0,0,,Тіпті Құдай емес
Dialogue: 0,0:04:04.95,0:04:06.66,Default,,0,0,0,,Біз басқалармыз
Dialogue: 0,0:04:44.33,0:04:46.95,Default,,0,0,0,,Адам әлеміндегі жұлдызды аспан әдемі.
Dialogue: 0,0:04:47.12,0:04:47.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:48.70,0:04:50.33,Default,,0,0,0,,Кәмелетке толу рәсімі басталады
Dialogue: 0,0:04:50.41,0:04:51.29,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:04:51.37,0:04:52.95,Default,,0,0,0,,Рахмет, ұлдар
Dialogue: 0,0:04:53.79,0:04:54.62,Default,,0,0,0,,Көтеріңіз!
Dialogue: 0,0:04:55.37,0:04:57.50,Default,,0,0,0,,Рәсім басталғалы жатыр.
Dialogue: 0,0:04:57.58,0:04:58.62,Default,,0,0,0,,Сізге екі жылқы керек пе?
Dialogue: 0,0:04:59.54,0:05:00.70,Default,,0,0,0,,Бірақ ол екі жылдан бері қоғамдық сахнаға шыққан жоқ
Dialogue: 0,0:05:03.91,0:05:04.75,Default,,0,0,0,,Шешім!
Dialogue: 0,0:05:05.41,0:05:07.16,Default,,0,0,0,,Қандай жақсы ат!
Dialogue: 0,0:05:07.58,0:05:08.50,Default,,0,0,0,,Биік!
Dialogue: 0,0:05:08.66,0:05:09.66,Default,,0,0,0,,Сонымен... мені ұмытып қалғың келе ме?
Dialogue: 0,0:05:12.45,0:05:13.45,Default,,0,0,0,,Жүр! Бар!
Dialogue: 0,0:05:15.87,0:05:16.70,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:05:18.08,0:05:18.91,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:05:19.00,0:05:19.91,Default,,0,0,0,,Жүр! Бар!
Dialogue: 0,0:05:20.58,0:05:21.41,Default,,0,0,0,,Жүр! Бар!
Dialogue: 0,0:05:21.50,0:05:22.33,Default,,0,0,0,,Чиу
Dialogue: 0,0:05:22.66,0:05:24.12,Default,,0,0,0,,Адам әлемі қызық па?
Dialogue: 0,0:05:24.50,0:05:26.75,Default,,0,0,0,,Мен қайтып оралғым келмейді
Dialogue: 0,0:05:27.20,0:05:28.50,Default,,0,0,0,,Мен қалуым керек еді.
Dialogue: 0,0:05:31.12,0:05:32.33,Default,,0,0,0,,Сіз оны жібере алмайсыз
Dialogue: 0,0:05:33.04,0:05:35.54,Default,,0,0,0,,Оны ешкім сұраған жоқ
Dialogue: 0,0:05:37.29,0:05:38.12,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:05:39.70,0:05:40.70,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:05:51.41,0:05:53.33,Default,,0,0,0,,Рәсім басталады Асығыңыз!
Dialogue: 0,0:06:01.12,0:06:04.20,Default,,0,0,0,,Адам әлемінде сақ болыңыз
Dialogue: 0,0:06:06.54,0:06:07.37,Default,,0,0,0,,Біз бұрын кездескенбіз! Біз бұрын кездескенбіз!
Dialogue: 0,0:06:07.83,0:06:08.66,Default,,0,0,0,,Жоғары көтеріліңіз
Dialogue: 0,0:06:09.83,0:06:10.91,Default,,0,0,0,,Қазір барыңыз!
Dialogue: 0,0:06:19.95,0:06:20.79,Default,,0,0,0,,Кемпір!
Dialogue: 0,0:06:21.29,0:06:22.33,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:06:32.33,0:06:34.83,Default,,0,0,0,,Адам әлемінде жалғызсың
Dialogue: 0,0:06:35.87,0:06:37.79,Default,,0,0,0,,Көбірек тамақтаныңыз
Dialogue: 0,0:06:38.33,0:06:39.91,Default,,0,0,0,,Толық асқазан
Dialogue: 0,0:06:40.62,0:06:41.70,Default,,0,0,0,,Аға
Dialogue: 0,0:06:42.12,0:06:43.50,Default,,0,0,0,,Қашан қайтасыз?
Dialogue: 0,0:06:44.83,0:06:47.08,Default,,0,0,0,,Жақсы қыз бол, жеті күннен кейін келемін.
Dialogue: 0,0:06:47.25,0:06:50.37,Default,,0,0,0,,Жерге күн сәулесі түседі
Dialogue: 0,0:06:50.75,0:06:53.95,Default,,0,0,0,,Құдай бәріне жақсы
Dialogue: 0,0:06:54.95,0:06:57.41,Default,,0,0,0,,Жеті күн адам әлемін кезу.
Dialogue: 0,0:06:57.87,0:07:00.45,Default,,0,0,0,,Табиғат заңдарын сақта
Dialogue: 0,0:07:01.04,0:07:04.37,Default,,0,0,0,,Адамдармен жанасуға болмайды
Dialogue: 0,0:07:04.83,0:07:07.87,Default,,0,0,0,,Бұл аспан заңы, оны бұзба.
Dialogue: 0,0:07:08.04,0:07:09.79,Default,,0,0,0,,Теңіз қақпасын ашыңыз!
Dialogue: 0,0:07:48.25,0:07:50.83,Default,,0,0,0,,Аман-есен оралған соң, сіз кәмелетке толғансыз.
Dialogue: 0,0:07:51.20,0:07:53.66,Default,,0,0,0,,Адамдардан сақ болыңыз
Dialogue: 0,0:07:53.75,0:07:57.25,Default,,0,0,0,,- Ештеңеден аулақ болыңыз - Сабыр етіңіз, бұл бала ақылды.
Dialogue: 0,0:07:57.33,0:07:59.83,Default,,0,0,0,,Джиннің қызы былтыр қайтып келмеді.
Dialogue: 0,0:08:01.33,0:08:02.87,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:02.95,0:08:04.54,Default,,0,0,0,,Жалқау болмаңыз!
Dialogue: 0,0:08:11.25,0:08:14.58,Default,,0,0,0,,Екі дүниені байланыстыратын жалғыз жол – спираль.
Dialogue: 0,0:08:14.66,0:08:17.04,Default,,0,0,0,,Жетінші күні қайтып келгенше үйге бара алмайсың.
Dialogue: 0,0:08:17.12,0:08:18.91,Default,,0,0,0,,Мен мұны талай рет естідім.
Dialogue: 0,0:08:19.33,0:08:20.50,Default,,0,0,0,,Сорпа келді!
Dialogue: 0,0:08:45.54,0:08:47.41,Default,,0,0,0,,Ересек болу
Dialogue: 0,0:08:49.87,0:08:50.70,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:51.66,0:08:52.50,Default,,0,0,0,,Өтінемін…
Dialogue: 0,0:08:53.37,0:08:54.33,Default,,0,0,0,,Жоқ… әлі де бір жол бар.
Dialogue: 0,0:08:55.04,0:08:55.87,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:08:56.12,0:08:57.75,Default,,0,0,0,,Уақытты кері қайтару
Dialogue: 0,0:08:58.41,0:09:00.04,Default,,0,0,0,,Жалғастырыңыз
Dialogue: 0,0:09:00.37,0:09:02.08,Default,,0,0,0,,Қарсымын!
Dialogue: 0,0:09:19.12,0:09:20.79,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:09:24.79,0:09:26.91,Default,,0,0,0,,Есіңізде болсын, ол жерде қауіпті.
Dialogue: 0,0:09:27.00,0:09:29.04,Default,,0,0,0,,Адамдардың жақындауына жол бермеңіз
Dialogue: 0,0:09:42.70,0:09:43.54,Default,,0,0,0,,Өтінемін…
Dialogue: 0,0:09:44.62,0:09:45.70,Default,,0,0,0,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:09:46.66,0:09:48.66,Default,,0,0,0,,Мен күтемін!
Dialogue: 0,0:09:59.25,0:10:01.83,Default,,0,0,0,,Өткен жылы он алты жасқа толған бала...
Dialogue: 0,0:10:02.70,0:10:04.70,Default,,0,0,0,,Кәмелетке толу рәсімі туралы
Dialogue: 0,0:10:04.91,0:10:06.91,Default,,0,0,0,,Адамзат әлеміне жіберілді
Dialogue: 0,0:10:07.75,0:10:13.20,Default,,0,0,0,,Табиғат заңдылықтарын өз көзіммен көру.
Dialogue: 0,0:10:14.75,0:10:18.08,Default,,0,0,0,,Үлкендер адам әлемін алғаш көргенде...
Dialogue: 0,0:10:19.08,0:10:21.58,Default,,0,0,0,,Бұл жаман жер емес еді.
Dialogue: 0,0:10:22.54,0:10:25.00,Default,,0,0,0,,Өте қуаныштымын
Dialogue: 0,0:10:26.37,0:10:28.25,Default,,0,0,0,,Адам әлемі әдемі болды.
Dialogue: 0,0:10:30.87,0:10:32.08,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:10:32.16,0:10:34.41,Default,,0,0,0,,Қызыл дельфин қайтадан келді
Dialogue: 0,0:10:34.54,0:10:36.20,Default,,0,0,0,,Мен жыл сайын келемін.
Dialogue: 0,0:10:36.58,0:10:38.08,Default,,0,0,0,,Танысайық
Dialogue: 0,0:10:38.70,0:10:40.87,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:10:42.75,0:10:45.79,Default,,0,0,0,,Сізді қайтадан көргеніме қуаныштымын!
Dialogue: 0,0:10:59.62,0:11:02.33,Default,,0,0,0,,Адам әлемін жалғыз кездім.
Dialogue: 0,0:11:03.12,0:11:05.12,Default,,0,0,0,,Мен үлкен кемені көрдім
Dialogue: 0,0:11:06.08,0:11:08.45,Default,,0,0,0,,Қаланың шамдары жұлдыздар сияқты
Dialogue: 0,0:11:09.45,0:11:13.16,Default,,0,0,0,,Адамдар – шырақ.
Dialogue: 0,0:11:13.45,0:11:14.75,Default,,0,0,0,,От жағу —
Dialogue: 0,0:11:15.37,0:11:17.37,Default,,0,0,0,,Қағаз қайықпен жүзу
Dialogue: 0,0:11:17.79,0:11:23.58,Default,,0,0,0,,Марқұмның жанын өзеннен теңізге жетелеген
Dialogue: 0,0:11:24.95,0:11:26.00,Default,,0,0,0,,Алтыншы күн -
Dialogue: 0,0:11:27.08,0:11:29.25,Default,,0,0,0,,Шамның жарығынан кейін
Dialogue: 0,0:11:30.00,0:11:34.16,Default,,0,0,0,,Сарқырамадан төмен түсіп, теңізге оралдым.
Dialogue: 0,0:11:47.58,0:11:48.41,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:11:52.62,0:11:53.45,Default,,0,0,0,,Осындай күйде Рух толқындарына шоғырлана алмаймын
Dialogue: 0,0:11:56.95,0:11:59.20,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:12:01.70,0:12:02.95,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:12:03.45,0:12:05.45,Default,,0,0,0,,Мен сізге көбірек көрсетемін
Dialogue: 0,0:12:10.66,0:12:12.08,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:15.25,0:12:17.75,Default,,0,0,0,,Арқаңызға балық тағамын жағыңыз
Dialogue: 0,0:12:18.08,0:12:18.91,Default,,0,0,0,,Иә
Dialogue: 0,0:12:21.45,0:12:22.33,Default,,0,0,0,,Сен зұлым брат
Dialogue: 0,0:12:23.45,0:12:24.91,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,0:13:03.25,0:13:04.75,Default,,0,0,0,,Көп балық!
Dialogue: 0,0:13:50.79,0:13:53.12,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:13:53.50,0:13:55.16,Default,,0,0,0,,Мен қызыл дельфинді қудым
Dialogue: 0,0:13:55.45,0:13:56.45,Default,,0,0,0,,Мына жерде.
Dialogue: 0,0:13:57.79,0:14:00.00,Default,,0,0,0,,Менің соңымнан келе жатқан сияқты
Dialogue: 0,0:14:00.79,0:14:02.45,Default,,0,0,0,,Басқа дельфиндерден айырмашылығы
Dialogue: 0,0:14:03.04,0:14:06.04,Default,,0,0,0,,- Өте ақылды - Маған ағам ұнайды.
Dialogue: 0,0:15:36.54,0:15:39.37,Default,,0,0,0,,- Не болды? - Дауылдың жанында бірдеңе
Dialogue: 0,0:15:39.70,0:15:40.62,Default,,0,0,0,,Дельфин
Dialogue: 0,0:15:41.08,0:15:42.75,Default,,0,0,0,,Сол дельфин
Dialogue: 0,0:15:42.87,0:15:44.50,Default,,0,0,0,,Торға түсіп қалды
Dialogue: 0,0:15:44.91,0:15:46.95,Default,,0,0,0,,Мен пышақты құтқарамын
Dialogue: 0,0:15:47.20,0:15:50.33,Default,,0,0,0,,- Айналмалы - Уайымдамаңыз
Dialogue: 0,0:15:52.37,0:15:53.20,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:16:04.66,0:16:06.00,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:16:37.62,0:16:38.91,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:16:44.25,0:16:45.50,Default,,0,0,0,,Мен көмекке келдім
Dialogue: 0,0:17:08.54,0:17:10.91,Default,,0,0,0,,Бауырым, қайтып кел!
Dialogue: 0,0:18:26.08,0:18:28.41,Default,,0,0,0,,Маған бауырымды қайтар!
Dialogue: 0,0:18:29.95,0:18:31.95,Default,,0,0,0,,Қайтып кел!
Dialogue: 0,0:18:32.87,0:18:34.37,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:18:54.33,0:18:55.20,Default,,0,0,0,,Біз бұрын кездескенбіз! Біз бұрын кездескенбіз!
Dialogue: 0,0:18:55.70,0:18:57.12,Default,,0,0,0,,Қайтып келгенім жақсы
Dialogue: 0,0:18:57.87,0:18:58.70,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:59.50,0:19:00.33,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:00.41,0:19:02.62,Default,,0,0,0,,- Жарайды - Әзірше үйге барайын.
Dialogue: 0,0:19:03.75,0:19:06.29,Default,,0,0,0,,Мен дәмді тамақ жасаймын.
Dialogue: 0,0:19:21.83,0:19:22.70,Default,,0,0,0,,Кемпір
Dialogue: 0,0:19:23.04,0:19:23.91,Default,,0,0,0,,Қария ше?
Dialogue: 0,0:19:39.16,0:19:41.54,Default,,0,0,0,,Адамдар өлгенде қайда барады?
Dialogue: 0,0:19:44.08,0:19:46.20,Default,,0,0,0,,Дене жерге қайта оралады
Dialogue: 0,0:19:46.75,0:19:47.75,Default,,0,0,0,,Жан туралы не деуге болады?
Dialogue: 0,0:19:48.79,0:19:52.25,Default,,0,0,0,,Ең солтүстікке көтерілу мұнарасына қарай жылжу...
Dialogue: 0,0:19:52.58,0:19:54.54,Default,,0,0,0,,Жан сақтаушысы қорғайды
Dialogue: 0,0:19:54.66,0:19:56.12,Default,,0,0,0,,Кішкентай балық бол
Dialogue: 0,0:19:56.91,0:19:58.12,Default,,0,0,0,,Біз де өлеміз бе?
Dialogue: 0,0:19:58.54,0:19:59.37,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:01.83,0:20:03.66,Default,,0,0,0,,Өмір сүру және өлу - табиғат жолы
Dialogue: 0,0:20:04.45,0:20:07.33,Default,,0,0,0,,Менің де уақытым келді
Dialogue: 0,0:20:09.00,0:20:11.08,Default,,0,0,0,,Өлме, қария.
Dialogue: 0,0:20:11.41,0:20:13.12,Default,,0,0,0,,Біртүрлі заттар
Dialogue: 0,0:20:13.20,0:20:15.37,Default,,0,0,0,,Бұл табиғат заңы.
Dialogue: 0,0:20:15.91,0:20:19.45,Default,,0,0,0,,Біз үшін мәңгіліктің алғашқы қадамы
Dialogue: 0,0:20:55.70,0:20:58.16,Default,,0,0,0,,Қыз, не болды?
Dialogue: 0,0:21:00.08,0:21:00.91,Default,,0,0,0,,Кім?
Dialogue: 0,0:21:01.00,0:21:04.70,Default,,0,0,0,,Сыбызғы үні басқа дүниеден
Dialogue: 0,0:21:05.29,0:21:06.41,Default,,0,0,0,,Менікі емес
Dialogue: 0,0:21:07.00,0:21:08.20,Default,,0,0,0,,Жақсы естіледі.
Dialogue: 0,0:21:08.87,0:21:10.91,Default,,0,0,0,,Ол кімге тиесілі?
Dialogue: 0,0:21:11.58,0:21:13.91,Default,,0,0,0,,Адам әлеміндегі бала
Dialogue: 0,0:21:14.41,0:21:15.25,Default,,0,0,0,,Эй!
Dialogue: 0,0:21:16.16,0:21:17.04,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:21:17.29,0:21:19.16,Default,,0,0,0,,Адам баласы
Dialogue: 0,0:21:20.37,0:21:22.58,Default,,0,0,0,,Егер сіз адам болсаңыз...
Dialogue: 0,0:21:23.37,0:21:25.79,Default,,0,0,0,,Сақтау мүмкін болуы мүмкін
Dialogue: 0,0:21:29.54,0:21:31.16,Default,,0,0,0,,Бүгін түнде, түн ортасы
Dialogue: 0,0:21:31.87,0:21:33.87,Default,,0,0,0,,Мұнда келіңіз
Dialogue: 0,0:21:34.54,0:21:35.66,Default,,0,0,0,,Қоңырау шалсын
Dialogue: 0,0:21:36.04,0:21:37.75,Default,,0,0,0,,Жүкті алып кететін көлік келе жатыр
Dialogue: 0,0:21:39.08,0:21:39.95,Default,,0,0,0,,Егер келсеңіз...
Dialogue: 0,0:21:41.54,0:21:43.54,Default,,0,0,0,,Күту
Dialogue: 0,0:24:19.87,0:24:21.83,Default,,0,0,0,,Кешіріңіз, мен мұны әдейі жасаған жоқпын.
Dialogue: 0,0:24:24.20,0:24:26.20,Default,,0,0,0,,Осы сағатта қайда барасыз?
Dialogue: 0,0:26:43.04,0:26:45.66,Default,,0,0,0,,Мен мұны бірден сезіндім
Dialogue: 0,0:26:47.08,0:26:50.20,Default,,0,0,0,,Қайыққа мінген сәт
Dialogue: 0,0:26:51.25,0:26:53.33,Default,,0,0,0,,Тағдыр өзгерді
Dialogue: 0,0:28:14.66,0:28:15.83,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:28:16.79,0:28:17.62,Default,,0,0,0,,Иә
Dialogue: 0,0:28:18.62,0:28:19.45,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:28:36.20,0:28:37.04,Default,,0,0,0,,Отырыңыз
Dialogue: 0,0:28:38.16,0:28:39.87,Default,,0,0,0,,Тұру
Dialogue: 0,0:28:54.70,0:28:56.29,Default,,0,0,0,,Сіз қашан өлдіңіз?
Dialogue: 0,0:28:58.29,0:29:01.25,Default,,0,0,0,,18 сәуір, Кокуудан екі күн бұрын
Dialogue: 0,0:29:02.29,0:29:03.83,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:29:04.95,0:29:08.79,Default,,0,0,0,,Адамдар күнде мысықтың мойнына бүрге салғандай өледі.
Dialogue: 0,0:29:09.70,0:29:11.91,Default,,0,0,0,,Бұл күні менің туған күнім болатын.
Dialogue: 0,0:29:12.54,0:29:16.33,Default,,0,0,0,,Табиғат заңдылықтарын өрескел бұзуға тырысу
Dialogue: 0,0:29:16.83,0:29:17.70,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:29:18.00,0:29:19.04,Default,,0,0,0,,Маған көмек керек
Dialogue: 0,0:29:19.16,0:29:20.16,Default,,0,0,0,,Қарсысыз ба?
Dialogue: 0,0:29:20.25,0:29:23.20,Default,,0,0,0,,Табиғатқа қарсы шыққандар жазаланады.
Dialogue: 0,0:29:23.29,0:29:24.12,Default,,0,0,0,,Ерекшесіз
Dialogue: 0,0:29:24.37,0:29:25.37,Default,,0,0,0,,Бұл құтқарушы
Dialogue: 0,0:29:25.83,0:29:26.83,Default,,0,0,0,,Түзетулер енгізу керек
Dialogue: 0,0:29:27.29,0:29:28.87,Default,,0,0,0,,Өте бастық
Dialogue: 0,0:29:29.41,0:29:31.54,Default,,0,0,0,,Мен 800 жыл жаттығамын.
Dialogue: 0,0:29:31.62,0:29:33.79,Default,,0,0,0,,Сонда да күнәні өтемейді
Dialogue: 0,0:29:33.95,0:29:35.54,Default,,0,0,0,,-Сен... -Тыншы!
Dialogue: 0,0:29:36.08,0:29:38.20,Default,,0,0,0,,Мен саған трагедия не екенін айтайын
Dialogue: 0,0:29:38.62,0:29:40.87,Default,,0,0,0,,Басқаларға жамандық жасау -
Dialogue: 0,0:29:40.95,0:29:42.58,Default,,0,0,0,,Мен оны түзетуге тырысамын...
Dialogue: 0,0:29:42.87,0:29:45.95,Default,,0,0,0,,Өз дәрменсіздігіңнің дәмін тат.
Dialogue: 0,0:29:46.29,0:29:48.91,Default,,0,0,0,,Өткеннің қайтарылмайтынын түсіну
Dialogue: 0,0:29:51.04,0:29:54.50,Default,,0,0,0,,Ешкім түзету жасай алмайды.
Dialogue: 0,0:29:54.58,0:29:57.04,Default,,0,0,0,,- Онда неге көмектесер едің? -Өйткені бұл аянышты
Dialogue: 0,0:29:57.79,0:30:01.50,Default,,0,0,0,,Өлгендерді тірілтудің бағасы қандай екенін білесіз бе?
Dialogue: 0,0:30:02.33,0:30:03.20,Default,,0,0,0,,Не?
Dialogue: 0,0:30:03.58,0:30:06.37,Default,,0,0,0,,Ең әдемі иелігіңнің орнына
Dialogue: 0,0:30:06.45,0:30:07.29,Default,,0,0,0,,Сіздің...
Dialogue: 0,0:30:08.58,0:30:09.50,Default,,0,0,0,,Көз және
Dialogue: 0,0:30:13.95,0:30:15.20,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:30:16.58,0:30:19.83,Default,,0,0,0,,Сүйкімді көздеріңмен қоштаса алмаймыз ба?
Dialogue: 0,0:30:20.66,0:30:23.66,Default,,0,0,0,,Немесе өміріңіздің жартысы
Dialogue: 0,0:30:24.25,0:30:25.16,Default,,0,0,0,,Сондықтан-
Dialogue: 0,0:30:26.70,0:30:27.54,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:30:31.58,0:30:35.41,Default,,0,0,0,,Жолбарыс жылы
Dialogue: 0,0:30:35.58,0:30:37.29,Default,,0,0,0,,Тағы да сол жерде...
Dialogue: 0,0:30:37.45,0:30:39.04,Default,,0,0,0,,Сіз дәрет алдыңыз ба?
Dialogue: 0,0:30:42.08,0:30:43.75,Default,,0,0,0,,Неліктен мысықтар көп?
Dialogue: 0,0:30:44.87,0:30:46.83,Default,,0,0,0,,Сондай қарияға...
Dialogue: 0,0:30:47.25,0:30:50.04,Default,,0,0,0,,Тек мысықтар қамқорлық жасайды
Dialogue: 0,0:30:54.62,0:30:57.50,Default,,0,0,0,,Барлық адамдар-
Dialogue: 0,0:30:58.12,0:31:02.33,Default,,0,0,0,,Теңіздің үлкен балығы
Dialogue: 0,0:31:05.41,0:31:07.08,Default,,0,0,0,,Сіз дүниеге келгенде...
Dialogue: 0,0:31:08.08,0:31:11.12,Default,,0,0,0,,Теңізден теңізге жүзу
Dialogue: 0,0:31:13.00,0:31:14.41,Default,,0,0,0,,Өмір -
Dialogue: 0,0:31:15.08,0:31:17.62,Default,,0,0,0,,Саяхат сияқты нәрсе
Dialogue: 0,0:31:18.75,0:31:20.83,Default,,0,0,0,,Адамдармен кездесу
Dialogue: 0,0:31:21.79,0:31:24.29,Default,,0,0,0,,Ажырасу
Dialogue: 0,0:31:29.00,0:31:30.70,Default,,0,0,0,,Адам өлгенде...
Dialogue: 0,0:31:31.75,0:31:33.83,Default,,0,0,0,,Теңіздің арғы бетіне жету
Dialogue: 0,0:31:35.12,0:31:37.70,Default,,0,0,0,,Және өз әлеміңізге оралыңыз
Dialogue: 0,0:31:43.25,0:31:45.25,Default,,0,0,0,,Бұл аспан бөлмесі
Dialogue: 0,0:31:46.41,0:31:50.91,Default,,0,0,0,,Өлгенде жаның осында сақталады.
Dialogue: 0,0:31:52.41,0:31:54.37,Default,,0,0,0,,Осыдан-
Dialogue: 0,0:31:55.62,0:31:56.79,Default,,0,0,0,,Сіз іздей аласыз ба?
Dialogue: 0,0:31:58.16,0:31:59.75,Default,,0,0,0,,Сыртқы түрі есімде
Dialogue: 0,0:32:04.08,0:32:05.87,Default,,0,0,0,,Сыртқы түрі есімде
Dialogue: 0,0:32:07.25,0:32:08.70,Default,,0,0,0,,Мен атын білмеймін
Dialogue: 0,0:32:10.70,0:32:12.70,Default,,0,0,0,,Оның көздеріне қарау
Dialogue: 0,0:32:13.16,0:32:15.37,Default,,0,0,0,,Ал маңдайдағы тыртық
Dialogue: 0,0:32:17.29,0:32:19.25,Default,,0,0,0,,Мен алты сағат іздедім.
Dialogue: 0,0:32:20.41,0:32:22.79,Default,,0,0,0,,Түні бойы
Dialogue: 0,0:32:43.75,0:32:46.12,Default,,0,0,0,,Мен саған оның жанын беремін
Dialogue: 0,0:32:46.95,0:32:50.45,Default,,0,0,0,,Жаныңды құюдан басқа оны тірілтуге жол жоқ.
Dialogue: 0,0:32:51.37,0:32:54.12,Default,,0,0,0,,Тағдыр бір-бірінен ажырамайды
Dialogue: 0,0:32:54.75,0:32:57.25,Default,,0,0,0,,Әрқашан қорғаңыз
Dialogue: 0,0:32:57.41,0:32:59.29,Default,,0,0,0,,Кез келген сынақтан
Dialogue: 0,0:32:59.66,0:33:01.66,Default,,0,0,0,,Өсу...
Dialogue: 0,0:33:02.20,0:33:03.79,Default,,0,0,0,,Адам әлеміне оралғанға дейін
Dialogue: 0,0:33:04.66,0:33:06.66,Default,,0,0,0,,Оған дейін қайта тірілмейді.
Dialogue: 0,0:33:07.41,0:33:08.66,Default,,0,0,0,,Басы - соңы
Dialogue: 0,0:33:08.91,0:33:10.16,Default,,0,0,0,,Егер сіз тоқтасаңыз
Dialogue: 0,0:33:10.91,0:33:14.66,Default,,0,0,0,,Қайта табылмас жан жоғалады.
Dialogue: 0,0:33:15.25,0:33:16.54,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:33:25.66,0:33:26.50,Default,,0,0,0,,Небосукея
Dialogue: 0,0:33:26.79,0:33:28.41,Default,,0,0,0,,Кеше түнде не істедің?
Dialogue: 0,0:33:39.12,0:33:40.12,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:33:40.79,0:33:42.66,Default,,0,0,0,,Сол кездегі қызыл дельфин.
Dialogue: 0,0:33:45.00,0:33:46.50,Default,,0,0,0,,Оның аты бар ма?
Dialogue: 0,0:33:47.79,0:33:48.95,Default,,0,0,0,,Қандай жаңалық бар?
Dialogue: 0,0:33:50.08,0:33:51.62,Default,,0,0,0,,Маған анам қоңырау шалды
Dialogue: 0,0:33:52.16,0:33:55.16,Default,,0,0,0,,Мен бегонияларды өсіру рөлін өткім келеді.
Dialogue: 0,0:33:57.25,0:33:59.25,Default,,0,0,0,,Бір күні...
Dialogue: 0,0:34:00.25,0:34:01.16,Default,,0,0,0,,Үлкен!
Dialogue: 0,0:34:01.75,0:34:03.08,Default,,0,0,0,,Аквариумнан
Dialogue: 0,0:34:03.87,0:34:05.04,Default,,0,0,0,,Айнадан
Dialogue: 0,0:34:05.29,0:34:06.29,Default,,0,0,0,,Кестеден
Dialogue: 0,0:34:06.87,0:34:08.08,Default,,0,0,0,,Төсектен
Dialogue: 0,0:34:08.41,0:34:10.41,Default,,0,0,0,,Бөлмеге тым көп сыймайды
Dialogue: 0,0:34:10.79,0:34:12.79,Default,,0,0,0,,Ғимараттан да үлкен!
Dialogue: 0,0:34:13.12,0:34:15.20,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:34:18.70,0:34:21.16,Default,,0,0,0,,Маған ең үлкен балықтың аты ұнайды.
Dialogue: 0,0:34:28.87,0:34:30.29,Default,,0,0,0,,Мен оны сақтай аламын ба?
Dialogue: 0,0:34:30.54,0:34:32.16,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:34:33.70,0:34:36.16,Default,,0,0,0,,Күте тұрыңыз! Өйткені сен үндемейсің
Dialogue: 0,0:34:37.54,0:34:38.66,Default,,0,0,0,,Бұл мағынасыз.
Dialogue: 0,0:34:42.12,0:34:42.95,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:34:43.50,0:34:44.79,Default,,0,0,0,,Менің есімім жақсы
Dialogue: 0,0:34:45.41,0:34:46.25,Default,,0,0,0,,Не?
Dialogue: 0,0:34:46.75,0:34:47.87,Default,,0,0,0,,Терезені ашыңыз.
Dialogue: 0,0:34:50.04,0:34:52.50,Default,,0,0,0,,«Солтүстік теңізде Кун деген балық бар».
Dialogue: 0,0:34:53.04,0:34:55.12,Default,,0,0,0,,«Ешкім ұзындықты өлшей алмайды»
Dialogue: 0,0:34:55.58,0:34:58.00,Default,,0,0,0,,«Ұшқан қанаттар бұлт сияқты»
Dialogue: 0,0:34:58.54,0:34:59.54,Default,,0,0,0,,Аңыз
Dialogue: 0,0:35:01.54,0:35:03.29,Default,,0,0,0,,Кун деп аталатын балық...
Dialogue: 0,0:35:03.45,0:35:04.29,Default,,0,0,0,,Үлкен...
Dialogue: 0,0:35:04.58,0:35:05.58,Default,,0,0,0,,Аспан сияқты
Dialogue: 0,0:35:05.66,0:35:06.54,Default,,0,0,0,,Сіз ұшқанда-
Dialogue: 0,0:35:06.83,0:35:08.12,Default,,0,0,0,,Қанаттар бұлт тәрізді
Dialogue: 0,0:35:08.91,0:35:09.75,Default,,0,0,0,,Алайда караокеде екі-үш ән айтқаннан кейін—
Dialogue: 0,0:35:09.87,0:35:11.04,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:35:15.00,0:35:15.87,Default,,0,0,0,,О… Қарт адам
Dialogue: 0,0:35:16.66,0:35:17.87,Default,,0,0,0,,Сіз —
Dialogue: 0,0:35:19.45,0:35:20.29,Default,,0,0,0,,Күн
Dialogue: 0,0:35:36.04,0:35:36.91,Default,,0,0,0,,Күн
Dialogue: 0,0:35:53.75,0:35:56.16,Default,,0,0,0,,Бұл маусымда жаңбыр сирек болады.
Dialogue: 0,0:36:03.70,0:36:04.95,Default,,0,0,0,,Жаңбыр тұзды
Dialogue: 0,0:36:12.25,0:36:13.12,Default,,0,0,0,,Өсу
Dialogue: 0,0:36:24.45,0:36:26.45,Default,,0,0,0,,Бірге ойнағыларың келе ме?
Dialogue: 0,0:36:27.00,0:36:27.83,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:36:28.16,0:36:30.83,Default,,0,0,0,,Теңізде қызыл дельфиндермен ойнау
Dialogue: 0,0:36:45.00,0:36:45.83,Default,,0,0,0,,Менің есімде!
Dialogue: 0,0:36:47.20,0:36:48.50,Default,,0,0,0,,Кеттік
Dialogue: 0,0:37:02.12,0:37:03.12,Default,,0,0,0,,Сіз ұша аласыз!
Dialogue: 0,0:37:06.00,0:37:07.66,Default,,0,0,0,,Сіз жаңбырда ұша аласыз!
Dialogue: 0,0:37:07.75,0:37:08.83,Default,,0,0,0,,Бұл керемет сияқты!
Dialogue: 0,0:37:42.79,0:37:44.12,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:37:44.54,0:37:46.12,Default,,0,0,0,,Отбасы мүшелері
Dialogue: 0,0:37:48.70,0:37:50.37,Default,,0,0,0,,Тез өсу
Dialogue: 0,0:37:51.25,0:37:52.50,Default,,0,0,0,,Мен сені үйіңе апарамын
Dialogue: 0,0:37:53.16,0:37:54.00,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:38:19.37,0:38:20.33,Default,,0,0,0,,Кун?
Dialogue: 0,0:38:22.25,0:38:23.87,Default,,0,0,0,,Сіз бөлмеге кірдіңіз бе?
Dialogue: 0,0:38:24.91,0:38:25.95,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:38:26.08,0:38:27.25,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:38:28.04,0:38:28.91,Default,,0,0,0,,Мен оны лақтырып жібердім
Dialogue: 0,0:38:29.00,0:38:30.70,Default,,0,0,0,,Менің басымда бір нәрсе дұрыс емес
Dialogue: 0,0:38:30.91,0:38:31.79,Default,,0,0,0,,Сондықтан ол қазірдің өзінде қаза тапқан болар деп ойлаймын.
Dialogue: 0,0:38:32.50,0:38:34.16,Default,,0,0,0,,Ол адам!
Dialogue: 0,0:38:34.37,0:38:35.25,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:38:35.37,0:38:37.58,Default,,0,0,0,,Түсіндіріңіз!
Dialogue: 0,0:38:37.70,0:38:39.58,Default,,0,0,0,,Менің артымнан ермеңіз
Dialogue: 0,0:38:40.79,0:38:41.70,Default,,0,0,0,,Не болды?
Dialogue: 0,0:38:42.95,0:38:44.20,Default,,0,0,0,,- деді анам
Dialogue: 0,0:38:45.54,0:38:47.75,Default,,0,0,0,,Мен сенің қайда екеніңді білемін.
Dialogue: 0,0:38:54.87,0:38:55.79,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:38:55.91,0:38:57.37,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:39:06.91,0:39:08.75,Default,,0,0,0,,Уайымдамаңыз, біз оны табамыз.
Dialogue: 0,0:39:09.70,0:39:10.58,Default,,0,0,0,,Әй?
Dialogue: 0,0:39:11.00,0:39:11.87,Default,,0,0,0,,Кун?
Dialogue: 0,0:39:12.50,0:39:13.33,Default,,0,0,0,,Міне!
Dialogue: 0,0:39:14.20,0:39:15.62,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,0:39:16.00,0:39:17.37,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:39:18.33,0:39:20.08,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:39:21.04,0:39:23.41,Default,,0,0,0,,Жоғалып кетсем, қиналып қалар едім.
Dialogue: 0,0:39:24.00,0:39:24.87,Default,,0,0,0,,Чиу!
Dialogue: 0,0:39:26.33,0:39:27.37,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:39:27.45,0:39:29.62,Default,,0,0,0,,Мұндай сасық жерде бірінші рет
Dialogue: 0,0:39:31.00,0:39:31.87,Default,,0,0,0,,Чиу
Dialogue: 0,0:39:32.83,0:39:33.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:39:36.62,0:39:37.54,Default,,0,0,0,,Хун!
Dialogue: 0,0:39:38.12,0:39:38.95,Default,,0,0,0,,Хун!
Dialogue: 0,0:39:39.75,0:39:41.75,Default,,0,0,0,,Уау! егеуқұйрықтарға толы
Dialogue: 0,0:39:44.16,0:39:46.16,Default,,0,0,0,,Кун жейді
Dialogue: 0,0:39:46.91,0:39:48.58,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:39:49.00,0:39:51.70,Default,,0,0,0,,Мені әп-сәтте тістеп алады
Dialogue: 0,0:39:55.25,0:39:58.08,Default,,0,0,0,,- Мас ететін иіс - Өлім иісі!
Dialogue: 0,0:40:01.16,0:40:05.79,Default,,0,0,0,,Бұл... махаббаттың иісі болса керек.
Dialogue: 0,0:40:06.37,0:40:09.62,Default,,0,0,0,,Не болды, сүйкімді қыз?
Dialogue: 0,0:40:10.29,0:40:12.12,Default,,0,0,0,,Балықты іздеу
Dialogue: 0,0:40:12.54,0:40:15.12,Default,,0,0,0,,Мен балықты көрдім.
Dialogue: 0,0:40:15.83,0:40:17.79,Default,,0,0,0,,Маған оны іздеуге көмектесе аласыз ба?
Dialogue: 0,0:40:19.08,0:40:21.62,Default,,0,0,0,,Жай балық емес
Dialogue: 0,0:40:22.29,0:40:24.50,Default,,0,0,0,,Жан сақтаушыдан алдым.
Dialogue: 0,0:40:25.62,0:40:28.33,Default,,0,0,0,,Жақсы адам балық болғанда, оның орны
Dialogue: 0,0:40:28.58,0:40:31.12,Default,,0,0,0,,Жаман адам тышқанға айналғанда, ол маған келеді.
Dialogue: 0,0:40:31.66,0:40:35.66,Default,,0,0,0,,Егеуқұйрықтар балыққа қарағанда сүйкімді.
Dialogue: 0,0:40:36.25,0:40:37.87,Default,,0,0,0,,Сен Кунды таба аласың ба?
Dialogue: 0,0:40:38.66,0:40:40.04,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:40:41.54,0:40:42.62,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:40:43.25,0:40:47.04,Default,,0,0,0,,Сүйкімді қыз билесе
Dialogue: 0,0:40:47.91,0:40:50.12,Default,,0,0,0,,Мұнда кел, музыка!
Dialogue: 0,0:40:56.75,0:40:57.58,Default,,0,0,0,,Біз бұрын кездескенбіз! Біз бұрын кездескенбіз!
Dialogue: 0,0:40:58.70,0:41:03.12,Default,,0,0,0,,Қазына
Dialogue: 0,0:41:03.20,0:41:05.79,Default,,0,0,0,,Ұлдар билеуді үйренуі керек
Dialogue: 0,0:41:08.45,0:41:10.58,Default,,0,0,0,,Егеуқұйрықтарды бақылау әдісі
Dialogue: 0,0:41:19.58,0:41:21.62,Default,,0,0,0,,Адам әлемі ғажайып жер
Dialogue: 0,0:41:22.50,0:41:23.66,Default,,0,0,0,,Бардың ба?
Dialogue: 0,0:41:24.00,0:41:25.62,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:41:32.29,0:41:33.12,Default,,0,0,0,,Хун!
Dialogue: 0,0:41:33.37,0:41:34.20,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:41:35.29,0:41:36.12,Default,,0,0,0,,Хун!
Dialogue: 0,0:41:37.20,0:41:38.16,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:41:42.70,0:41:43.54,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:41:44.54,0:41:45.54,Default,,0,0,0,,Реакция жасамайды
Dialogue: 0,0:41:50.29,0:41:51.12,Default,,0,0,0,,Мен байқадым!
Dialogue: 0,0:41:52.62,0:41:54.62,Default,,0,0,0,,Қандай таза жан
Dialogue: 0,0:41:55.41,0:41:59.16,Default,,0,0,0,,Үлкен балыққа айналатынына сенімдімін.
Dialogue: 0,0:42:06.45,0:42:07.33,Default,,0,0,0,,Міне!
Dialogue: 0,0:42:12.37,0:42:13.58,Default,,0,0,0,,Мен оны табамын
Dialogue: 0,0:42:19.70,0:42:20.58,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:42:36.41,0:42:37.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:38.00,0:42:39.54,Default,,0,0,0,,Қарт Хоут!
Dialogue: 0,0:42:39.87,0:42:43.16,Default,,0,0,0,,Мұнда балықтар бар!
Dialogue: 0,0:42:44.62,0:42:46.50,Default,,0,0,0,,Осы құдықта
Dialogue: 0,0:42:51.41,0:42:52.45,Default,,0,0,0,,Сіз қайда бардыңыз?
Dialogue: 0,0:42:52.54,0:42:54.50,Default,,0,0,0,,Балық болды
Dialogue: 0,0:42:54.83,0:42:58.00,Default,,0,0,0,,Нөсер мен тұзды су...
Dialogue: 0,0:42:58.66,0:43:00.37,Default,,0,0,0,,Жаман белгі
Dialogue: 0,0:43:00.75,0:43:02.54,Default,,0,0,0,,Барлығы сақ болыңыз
Dialogue: 0,0:43:03.12,0:43:04.00,Default,,0,0,0,,Иә
Dialogue: 0,0:43:07.87,0:43:09.95,Default,,0,0,0,,Мен таптым!
Dialogue: 0,0:43:21.87,0:43:23.75,Default,,0,0,0,,Бұл менің жаңа үйім
Dialogue: 0,0:43:24.62,0:43:25.45,Default,,0,0,0,,Мұнда
Dialogue: 0,0:43:29.08,0:43:30.37,Default,,0,0,0,,Чун Қара!
Dialogue: 0,0:43:30.91,0:43:31.79,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:43:45.04,0:43:45.87,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:44:03.29,0:44:04.16,Default,,0,0,0,,Чиу
Dialogue: 0,0:44:06.16,0:44:07.66,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:44:07.75,0:44:09.00,Default,,0,0,0,,Екі бас!
Dialogue: 0,0:44:11.79,0:44:12.62,Default,,0,0,0,,Чиу!
Dialogue: 0,0:44:24.25,0:44:25.58,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:44:33.20,0:44:34.08,Default,,0,0,0,,Чиу!
Dialogue: 0,0:44:42.20,0:44:43.08,Default,,0,0,0,,Біз бұрын кездескенбіз! Біз бұрын кездескенбіз!
Dialogue: 0,0:44:44.25,0:44:45.08,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:44:46.62,0:44:47.91,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:44:48.00,0:44:49.54,Default,,0,0,0,,Сіз ояусыз.
Dialogue: 0,0:44:50.00,0:44:51.25,Default,,0,0,0,,Ұйықтама
Dialogue: 0,0:44:51.33,0:44:52.16,Default,,0,0,0,,Мен ән айтамын
Dialogue: 0,0:44:52.37,0:44:53.62,Default,,0,0,0,,Мен саған ән айтамын
Dialogue: 0,0:44:54.95,0:44:59.20,Default,,0,0,0,,Теңіз үстінде ай мен жұлдыз жарқырайды
Dialogue: 0,0:45:00.70,0:45:04.54,Default,,0,0,0,,-Теңіз самалы мен су шашырады... -Сен саңыраусың.
Dialogue: 0,0:45:04.95,0:45:06.58,Default,,0,0,0,,Ұйықтама!
Dialogue: 0,0:45:10.75,0:45:13.20,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:45:13.54,0:45:14.54,Default,,0,0,0,,Жақында
Dialogue: 0,0:45:15.50,0:45:16.87,Default,,0,0,0,,Ұйықтама
Dialogue: 0,0:45:24.12,0:45:24.95,Default,,0,0,0,,Қария!
Dialogue: 0,0:45:25.12,0:45:26.37,Default,,0,0,0,,Чиуге көмектес!
Dialogue: 0,0:45:27.33,0:45:30.04,Default,,0,0,0,,Мені қос басты улы жылан шағып алды.
Dialogue: 0,0:45:31.75,0:45:32.70,Default,,0,0,0,,У-
Dialogue: 0,0:45:33.04,0:45:34.25,Default,,0,0,0,,Емдеу жоқ
Dialogue: 0,0:45:34.66,0:45:36.37,Default,,0,0,0,,Чиуге көмектес
Dialogue: 0,0:45:38.20,0:45:39.08,Default,,0,0,0,,Біз бұрын кездескенбіз! Біз бұрын кездескенбіз!
Dialogue: 0,0:45:40.29,0:45:41.50,Default,,0,0,0,,Бұл сізге
Dialogue: 0,0:45:41.87,0:45:43.75,Default,,0,0,0,,Бұл жалғыз нұсқа
Dialogue: 0,0:45:45.58,0:45:47.12,Default,,0,0,0,,Сыртта болыңыз
Dialogue: 0,0:45:47.58,0:45:48.54,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:46:39.75,0:46:41.75,Default,,0,0,0,,Сіз сіңіп кетесіз!
Dialogue: 0,0:46:42.41,0:46:44.25,Default,,0,0,0,,жақсарды ма?
Dialogue: 0,0:46:45.16,0:46:47.08,Default,,0,0,0,,Сенің атаң ғажап
Dialogue: 0,0:46:47.16,0:46:48.29,Default,,0,0,0,,Толық емделді
Dialogue: 0,0:46:49.20,0:46:51.79,Default,,0,0,0,,Өйткені қария емдік шөптердің шебері.
Dialogue: 0,0:47:02.00,0:47:03.16,Default,,0,0,0,,Менің әйелім
Dialogue: 0,0:47:04.25,0:47:07.50,Default,,0,0,0,,Есіңде ме, біз алғаш қай жерде кездестік?
Dialogue: 0,0:47:17.50,0:47:20.33,Default,,0,0,0,,-Қарт -Чун осында
Dialogue: 0,0:47:21.79,0:47:22.66,Default,,0,0,0,,Қария
Dialogue: 0,0:47:23.08,0:47:24.58,Default,,0,0,0,,Баратын уақыт келді
Dialogue: 0,0:47:27.45,0:47:29.16,Default,,0,0,0,,Бәріне мен кінәлімін
Dialogue: 0,0:47:30.20,0:47:32.16,Default,,0,0,0,,Өзіңізді кінәламаңыз
Dialogue: 0,0:47:33.16,0:47:35.79,Default,,0,0,0,,Бұл да табиғи процесс
Dialogue: 0,0:47:36.87,0:47:38.95,Default,,0,0,0,,Ешкім қашып құтыла алмайды
Dialogue: 0,0:47:40.29,0:47:41.41,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:47:41.75,0:47:44.50,Default,,0,0,0,,Сіз нені тәуекел етесіз?
Dialogue: 0,0:47:45.41,0:47:47.62,Default,,0,0,0,,Нені бәрі құптамайды
Dialogue: 0,0:47:48.87,0:47:51.16,Default,,0,0,0,,Мейірімді жүрегің болса...
Dialogue: 0,0:47:52.04,0:47:54.95,Default,,0,0,0,,Басқалардың қарсылық көрсетуі дұрыс.
Dialogue: 0,0:47:56.00,0:47:58.00,Default,,0,0,0,,Жүрегіңді тыңда
Dialogue: 0,0:47:59.25,0:48:01.33,Default,,0,0,0,,Бүркіт бегония ағашына айналады.
Dialogue: 0,0:48:01.66,0:48:04.66,Default,,0,0,0,,Мен кемпірмен бірге сені үнемі бақылап отырамын.
Dialogue: 0,0:48:09.25,0:48:11.91,Default,,0,0,0,,Кемпір – құстардың басшысы.
Dialogue: 0,0:48:12.58,0:48:15.91,Default,,0,0,0,,Феникс болып, қартқа бар
Dialogue: 0,0:48:17.45,0:48:19.95,Default,,0,0,0,,Кемпір қайтыс болғаннан кейін екі күннен кейін
Dialogue: 0,0:48:21.37,0:48:23.87,Default,,0,0,0,,Сол күні құстар жиналды.
Dialogue: 0,0:48:24.87,0:48:27.66,Default,,0,0,0,,Кемпір қайтып келгендей
Dialogue: 0,0:48:35.08,0:48:37.54,Default,,0,0,0,,Жаз ортасындағы қар, қалыптан тыс ауа райы.
Dialogue: 0,0:48:38.08,0:48:39.58,Default,,0,0,0,,Үлкен апат орын алды
Dialogue: 0,0:48:44.79,0:48:46.20,Default,,0,0,0,,Осы маусымдағы қар
Dialogue: 0,0:48:47.00,0:48:49.79,Default,,0,0,0,,Мен қарды жақсы көремін!
Dialogue: 0,0:48:55.58,0:48:56.91,Default,,0,0,0,,Құдай бар деп ойлайсың ба?
Dialogue: 0,0:48:57.37,0:48:58.20,Default,,0,0,0,,(Тергеуші) Тірі лабиринт аяқталғаны жақсы-ақ—
Dialogue: 0,0:48:59.41,0:49:00.29,Default,,0,0,0,,Иса
Dialogue: 0,0:49:00.41,0:49:01.62,Default,,0,0,0,,Ешкім қарап тұрған жоқ
Dialogue: 0,0:49:01.70,0:49:02.91,Default,,0,0,0,,Адамдар - біз...
Dialogue: 0,0:49:03.66,0:49:04.50,Default,,0,0,0,,Көрінбеген
Dialogue: 0,0:49:05.87,0:49:08.20,Default,,0,0,0,,Құдай бар болса, мен жазаланамын.
Dialogue: 0,0:49:10.50,0:49:12.62,Default,,0,0,0,,Ата-анаң қартайғанда...
Dialogue: 0,0:49:13.20,0:49:14.54,Default,,0,0,0,,Саған қамқорлық жасай алмаймын
Dialogue: 0,0:49:15.16,0:49:16.25,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:49:17.33,0:49:19.33,Default,,0,0,0,,Менің ғұмырым екіге қысқарды.
Dialogue: 0,0:49:19.70,0:49:20.54,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:49:21.50,0:49:23.33,Default,,0,0,0,,Жан сақтаушымен мәміле жасады
Dialogue: 0,0:49:23.58,0:49:25.29,Default,,0,0,0,,Чун қайда орналасқан?
Dialogue: 0,0:49:26.29,0:49:27.58,Default,,0,0,0,,Түсіңіз
Dialogue: 0,0:49:27.66,0:49:30.00,Default,,0,0,0,,- Қазір кет! -Қызым күтпеген жерден болды!
Dialogue: 0,0:49:30.16,0:49:32.58,Default,,0,0,0,,Аударманы сұрау
Dialogue: 0,0:49:33.25,0:49:35.25,Default,,0,0,0,,Ақсақалдар күдіктенеді
Dialogue: 0,0:49:35.58,0:49:36.91,Default,,0,0,0,,Кун қауіпті
Dialogue: 0,0:49:37.70,0:49:38.58,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:49:38.66,0:49:40.66,Default,,0,0,0,,Мені есіңе түсірмейсің бе?
Dialogue: 0,0:49:41.29,0:49:43.50,Default,,0,0,0,,Құнды төбенің арғы жағындағы қатқан өзенге апарыңыз.
Dialogue: 0,0:49:44.12,0:49:46.75,Default,,0,0,0,,Чун жазаланады.
Dialogue: 0,0:49:47.70,0:49:48.70,Default,,0,0,0,,Асығыңыз
Dialogue: 0,0:50:05.75,0:50:07.33,Default,,0,0,0,,Оны табу қиын.
Dialogue: 0,0:50:08.04,0:50:08.91,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:50:18.66,0:50:20.58,Default,,0,0,0,,Чун ренжітеді
Dialogue: 0,0:50:22.50,0:50:24.29,Default,,0,0,0,,Егер жарақат алғыңыз келмесе...
Dialogue: 0,0:50:24.66,0:50:25.50,Default,,0,0,0,,Кеттік
Dialogue: 0,0:50:36.45,0:50:37.37,Default,,0,0,0,,Кун ше?
Dialogue: 0,0:50:37.87,0:50:38.75,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:50:39.12,0:50:40.66,Default,,0,0,0,,Қайда?
Dialogue: 0,0:50:40.91,0:50:42.70,Default,,0,0,0,,өзенге жуылды
Dialogue: 0,0:50:46.04,0:50:46.91,Default,,0,0,0,,Өтінемін…
Dialogue: 0,0:50:47.04,0:50:48.16,Default,,0,0,0,,Өзіңіз үшін!
Dialogue: 0,0:51:49.83,0:51:52.75,Default,,0,0,0,,Ақыры менікі
Dialogue: 0,0:51:53.79,0:51:56.25,Default,,0,0,0,,Енді сіз адам әлеміне бара аласыз
Dialogue: 0,0:52:11.87,0:52:12.75,Default,,0,0,0,,Күн
Dialogue: 0,0:52:13.33,0:52:15.12,Default,,0,0,0,,Мен сені енді ешқашан көрмеймін деп ойладым.
Dialogue: 0,0:52:22.54,0:52:23.87,Default,,0,0,0,,Мен шығудың жолын табуым керек.
Dialogue: 0,0:52:24.70,0:52:25.75,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:55:14.00,0:55:16.70,Default,,0,0,0,,Өлмейтін ана
Dialogue: 0,0:55:22.58,0:55:23.58,Default,,0,0,0,,Ата-анасы жоқ
Dialogue: 0,0:55:24.45,0:55:25.58,Default,,0,0,0,,Әжемнің қолында өстім
Dialogue: 0,0:55:26.50,0:55:28.58,Default,,0,0,0,,Қалағаныңды істе, ештеңеден қорықпа
Dialogue: 0,0:55:29.50,0:55:32.29,Default,,0,0,0,,Бірақ сені мұңайтатын жалғыз нәрсе...
Dialogue: 0,0:55:33.04,0:55:33.91,Default,,0,0,0,,Төзгісіз
Dialogue: 0,0:55:41.45,0:55:42.58,Default,,0,0,0,,Бұл күтпеген жағдай болды.
Dialogue: 0,0:55:43.75,0:55:45.37,Default,,0,0,0,,Мен Кунның соншалықты маңызды екеніне сене алар емеспін.
Dialogue: 0,0:55:47.12,0:55:48.04,Default,,0,0,0,,Сіз зардап шегесіз
Dialogue: 0,0:55:49.16,0:55:50.29,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:55:53.37,0:55:54.37,Default,,0,0,0,,Оян!
Dialogue: 0,0:57:10.00,0:57:10.87,Default,,0,0,0,,Күн
Dialogue: 0,0:57:22.45,0:57:23.29,Default,,0,0,0,,Күн
Dialogue: 0,0:58:12.25,0:58:14.29,Default,,0,0,0,,Сіз маған көмектестіңіз.
Dialogue: 0,0:58:15.16,0:58:16.41,Default,,0,0,0,,Ер жеткен
Dialogue: 0,0:58:18.04,0:58:19.41,Default,,0,0,0,,Мені енді ешқашан тастама
Dialogue: 0,0:59:02.04,0:59:02.87,Default,,0,0,0,,Сіздің кезегіңіз
Dialogue: 0,0:59:03.66,0:59:04.54,Default,,0,0,0,,Жан түршігерлік қозғалыс!
Dialogue: 0,0:59:06.58,0:59:08.83,Default,,0,0,0,,Келсең неге кірмейсің?
Dialogue: 0,0:59:14.70,0:59:16.00,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:59:16.29,0:59:17.12,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:59:20.25,0:59:21.29,Default,,0,0,0,,Менің сұрағым бар
Dialogue: 0,0:59:21.79,0:59:22.87,Default,,0,0,0,,Не?
Dialogue: 0,0:59:23.20,0:59:25.20,Default,,0,0,0,,Неліктен Чунға адам жанын береді?
Dialogue: 0,0:59:26.83,0:59:27.95,Default,,0,0,0,,Бұл транзакция
Dialogue: 0,0:59:28.83,0:59:30.66,Default,,0,0,0,,Егер сіз бағаны төлесеңіз...
Dialogue: 0,0:59:30.91,0:59:33.16,Default,,0,0,0,,Сіз кез келген нәрсені ала аласыз.
Dialogue: 0,0:59:34.54,0:59:35.79,Default,,0,0,0,,Өмірдің жартысы?
Dialogue: 0,0:59:37.33,0:59:39.00,Default,,0,0,0,,Білетініңді не үшін сұрайсың?
Dialogue: 0,0:59:40.87,0:59:41.75,Default,,0,0,0,,Ийда…
Dialogue: 0,0:59:41.91,0:59:44.95,Default,,0,0,0,,Менің және Чун өмірінің жартысы ше?
Dialogue: 0,0:59:45.87,0:59:46.95,Default,,0,0,0,,Әрине
Dialogue: 0,0:59:47.04,0:59:48.75,Default,,0,0,0,,Бірақ баға көтерілді.
Dialogue: 0,0:59:49.00,0:59:51.37,Default,,0,0,0,,Бүкіл өміріңді ал
Dialogue: 0,0:59:51.83,0:59:52.70,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:59:54.75,0:59:56.12,Default,,0,0,0,,Сізге айтайын...
Dialogue: 0,0:59:56.33,0:59:58.04,Default,,0,0,0,,Оның өмірі -
Dialogue: 0,0:59:58.37,1:00:02.04,Default,,0,0,0,,Сол балықпен байланысты
Dialogue: 0,1:00:02.33,1:00:04.16,Default,,0,0,0,,Мен өлсем, ол да өледі.
Dialogue: 0,1:00:04.70,1:00:05.91,Default,,0,0,0,,Егер қашып кетуге рұқсат етсем ше?
Dialogue: 0,1:00:07.04,1:00:08.83,Default,,0,0,0,,Егер қашып кетуге рұқсат етсем...
Dialogue: 0,1:00:09.04,1:00:11.29,Default,,0,0,0,,Сосын ол өледі
Dialogue: 0,1:00:13.33,1:00:14.54,Default,,0,0,0,,Қалай үнемдеуге болады?
Dialogue: 0,1:00:16.50,1:00:17.50,Default,,0,0,0,,Цумо
Dialogue: 0,1:00:17.87,1:00:19.04,Default,,0,0,0,,Киёошики!
Dialogue: 0,1:00:21.62,1:00:24.25,Default,,0,0,0,,Жеңіске жетсем, саған хабарлаймын.
Dialogue: 0,1:00:25.41,1:00:26.50,Default,,0,0,0,,Орындар толы.
Dialogue: 0,1:00:26.66,1:00:27.58,Default,,0,0,0,,Орын бос
Dialogue: 0,1:00:28.16,1:00:29.04,Default,,0,0,0,,Онда
Dialogue: 0,1:00:46.08,1:00:47.70,Default,,0,0,0,,Менің жолым болды, жеңдім
Dialogue: 0,1:00:49.62,1:00:50.45,Default,,0,0,0,,(Ходжинс) Бүгіннен бастап мен Автоматты жазу қуыршағының шәкірті болып жұмыс істеймін.
Dialogue: 0,1:00:53.83,1:00:55.33,Default,,0,0,0,,Сәттілік деген жоқ
Dialogue: 0,1:00:55.41,1:00:58.00,Default,,0,0,0,,Жақсы ма, жаман ба, бұл тағдыр.
Dialogue: 0,1:01:03.83,1:01:05.83,Default,,0,0,0,,Жауап сіздің қолыңызда
Dialogue: 0,1:01:06.58,1:01:07.50,Default,,0,0,0,,Қолда ма?
Dialogue: 0,1:01:08.58,1:01:10.66,Default,,0,0,0,,Жауап өз қолыңда
Dialogue: 0,1:01:11.25,1:01:12.79,Default,,0,0,0,,қолында
Dialogue: 0,1:01:28.16,1:01:29.95,Default,,0,0,0,,Рахмет
Dialogue: 0,1:01:30.29,1:01:31.50,Default,,0,0,0,,Бала -
Dialogue: 0,1:01:31.83,1:01:34.12,Default,,0,0,0,,Өмірге тастай қарау
Dialogue: 0,1:01:34.37,1:01:38.45,Default,,0,0,0,,Тек қарттар ғана мүмкіндігінше ұзақ өмір сүруге тырысады.
Dialogue: 0,1:01:40.50,1:01:41.41,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,1:01:41.50,1:01:43.08,Default,,0,0,0,,Ұзақ өмірдің мәні жоқ
Dialogue: 0,1:03:08.41,1:03:10.83,Default,,0,0,0,,Ұмытқым келеді, бірақ ұмыта алмаймын.
Dialogue: 0,1:03:10.95,1:03:12.12,Default,,0,0,0,,Содан кейін ұмытпаңыз
Dialogue: 0,1:03:12.54,1:03:14.50,Default,,0,0,0,,Бұл тырысу туралы емес
Dialogue: 0,1:03:16.29,1:03:17.12,Default,,0,0,0,,Бірақ бұл өте ауыр
Dialogue: 0,1:03:18.25,1:03:20.33,Default,,0,0,0,,Анда-санда уайымдағаны дұрыс
Dialogue: 0,1:03:22.00,1:03:24.20,Default,,0,0,0,,Ұмытуға не көмектеседі?
Dialogue: 0,1:03:24.75,1:03:28.70,Default,,0,0,0,,Мұңды да, қуанышты да ұмытсаң
Dialogue: 0,1:03:28.79,1:03:31.20,Default,,0,0,0,,Менгба но Ю деп аталады.
Dialogue: 0,1:03:34.62,1:03:36.08,Default,,0,0,0,,Сонда алкоголь жақсы.
Dialogue: 0,1:03:42.54,1:03:44.04,Default,,0,0,0,,Сондай-ақ асқынуға қарсы дәрі
Dialogue: 0,1:03:44.12,1:03:45.33,Default,,0,0,0,,Оны бірінші рет ішу
Dialogue: 0,1:03:59.00,1:04:00.70,Default,,0,0,0,,Мені кім жақсы көреді?
Dialogue: 0,1:04:01.04,1:04:02.45,Default,,0,0,0,,Құдай!
Dialogue: 0,1:04:03.04,1:04:05.04,Default,,0,0,0,,Басқа құдайларға қарсы тұру -
Dialogue: 0,1:04:05.20,1:04:08.16,Default,,0,0,0,,Шыдап, бақытты бол деді!
Dialogue: 0,1:04:16.00,1:04:18.62,Default,,0,0,0,,Теңіз суы толып жатыр, аспанның қаһары!
Dialogue: 0,1:04:22.16,1:04:24.66,Default,,0,0,0,,Қайғылы тіршілік иесін жоймасақ
Dialogue: 0,1:04:29.12,1:04:30.79,Default,,0,0,0,,Мен оның қайда екенін білемін.
Dialogue: 0,1:04:31.87,1:04:36.66,Default,,0,0,0,,Мен күнді сағындым деп үйретудің орнына заклинание бұзу
Dialogue: 0,1:04:42.33,1:04:44.33,Default,,0,0,0,,Ол әбден тәртіпсіз болып кетті.
Dialogue: 0,1:04:45.41,1:04:47.25,Default,,0,0,0,,Маған тазалау керек
Dialogue: 0,1:04:48.79,1:04:51.50,Default,,0,0,0,,Барлығы дайын ба?
Dialogue: 0,1:04:54.45,1:04:56.95,Default,,0,0,0,,Үлкен балық келсе, кеттік.
Dialogue: 0,1:04:57.29,1:04:59.79,Default,,0,0,0,,Отбасыңмен көшетін кез келді.
Dialogue: 0,1:05:01.45,1:05:03.66,Default,,0,0,0,,Тауға бірге шығу
Dialogue: 0,1:05:03.79,1:05:07.25,Default,,0,0,0,,Мен қайда тұрамын?
Dialogue: 0,1:05:07.91,1:05:11.16,Default,,0,0,0,,Қатты жел, қатты жаңбыр
Dialogue: 0,1:05:11.37,1:05:14.58,Default,,0,0,0,,Үйді су басып кетсе де...
Dialogue: 0,1:05:15.25,1:05:17.87,Default,,0,0,0,,Маған бәрібір, мен кез келген жерге бара аламын
Dialogue: 0,1:05:18.95,1:05:21.54,Default,,0,0,0,,Мен қайда тұрамын?
Dialogue: 0,1:05:22.41,1:05:24.83,Default,,0,0,0,,Мен қайда тұруым керек?
Dialogue: 0,1:05:34.16,1:05:37.75,Default,,0,0,0,,Бұл қиын! Айдаһар патшасының маскасы жоқ!
Dialogue: 0,1:05:38.33,1:05:39.16,Default,,0,0,0,,Енді ше?
Dialogue: 0,1:05:53.12,1:05:53.95,Default,,0,0,0,,Өтінемін…
Dialogue: 0,1:05:54.25,1:05:56.25,Default,,0,0,0,,Мен әр жерден іздедім!
Dialogue: 0,1:05:57.62,1:05:59.79,Default,,0,0,0,,Құбыжықты тапсыру.
Dialogue: 0,1:06:00.12,1:06:02.41,Default,,0,0,0,,Мен құбыжық емеспін. Маған тимеңіз!
Dialogue: 0,1:06:03.08,1:06:03.91,Default,,0,0,0,,Заңсыз!
Dialogue: 0,1:06:06.00,1:06:07.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:06:19.08,1:06:20.66,Default,,0,0,0,,Неліктен жұмыстан шықтыңыз?
Dialogue: 0,1:06:21.83,1:06:22.83,Default,,0,0,0,,Мені ұстаңыз!
Dialogue: 0,1:06:24.25,1:06:26.04,Default,,0,0,0,,-Мен істеймін -Жолдан кет!
Dialogue: 0,1:06:34.95,1:06:36.62,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:06:39.00,1:06:40.00,Default,,0,0,0,,(Амон) Нагачика? (Хайд) Ах, Амон-сан.
Dialogue: 0,1:06:42.00,1:06:43.29,Default,,0,0,0,,Ұш!
Dialogue: 0,1:06:49.33,1:06:50.25,Default,,0,0,0,,Өтінемін…
Dialogue: 0,1:06:50.70,1:06:51.62,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:06:51.91,1:06:54.00,Default,,0,0,0,,Мен саған көмектесемін!
Dialogue: 0,1:06:54.45,1:06:55.83,Default,,0,0,0,,Аспан!
Dialogue: 0,1:06:55.91,1:06:58.50,Default,,0,0,0,,Кунды үйге апарыңыз!
Dialogue: 0,1:06:58.91,1:07:00.00,Default,,0,0,0,,Жүр!
Dialogue: 0,1:07:00.08,1:07:01.62,Default,,0,0,0,,Чиу Бұл ақылға қонымсыз!
Dialogue: 0,1:07:01.70,1:07:03.87,Default,,0,0,0,,Сізге аспан ашылмайды!
Dialogue: 0,1:07:16.66,1:07:19.20,Default,,0,0,0,,Анау баланың кемпірін шақыр!
Dialogue: 0,1:07:19.45,1:07:22.83,Default,,0,0,0,,Кун, ұш! Мен оны енді ұстай алмаймын!
Dialogue: 0,1:07:23.45,1:07:24.75,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,1:07:24.87,1:07:26.41,Default,,0,0,0,,Биік ұш!
Dialogue: 0,1:07:29.91,1:07:31.91,Default,,0,0,0,,Адам әлеміне барайық!
Dialogue: 0,1:07:32.95,1:07:34.95,Default,,0,0,0,,Аригато Кавайко-чан
Dialogue: 0,1:07:35.41,1:07:37.62,Default,,0,0,0,,Мен сені ойлап отырмын.
Dialogue: 0,1:07:41.54,1:07:43.37,Default,,0,0,0,,Бұл апат!
Dialogue: 0,1:07:44.54,1:07:48.50,Default,,0,0,0,,Адам әлемінен бірдеңе болмаса, Теңіз жәннаты қақпасынан өте алмайсың.
Dialogue: 0,1:08:47.33,1:08:48.45,Default,,0,0,0,,Қарияға рахмет
Dialogue: 0,1:08:59.75,1:09:00.66,Default,,0,0,0,,Хун!
Dialogue: 0,1:09:01.29,1:09:02.12,Default,,0,0,0,,Хун!
Dialogue: 0,1:09:09.25,1:09:10.75,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,1:09:14.29,1:09:16.95,Default,,0,0,0,,Екеуміз кездескен сәттен тағдырымызды бөліскенге дейін...
Dialogue: 0,1:09:17.29,1:09:19.29,Default,,0,0,0,,Бір секундқа да өкінбеймін
Dialogue: 0,1:09:30.87,1:09:33.50,Default,,0,0,0,,Әндер Джуронг бүгін қайда?
Dialogue: 0,1:09:33.58,1:09:34.54,Default,,0,0,0,,Ізденейік
Dialogue: 0,1:09:40.04,1:09:40.87,Default,,0,0,0,,Кемпір...
Dialogue: 0,1:09:42.70,1:09:45.12,Default,,0,0,0,,- Суда біреу бар! -Мен көмектесуім керек
Dialogue: 0,1:09:45.25,1:09:46.08,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,1:09:46.33,1:09:47.75,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,1:09:52.58,1:09:53.58,Default,,0,0,0,,Бірінші қыз
Dialogue: 0,1:09:59.33,1:10:00.70,Default,,0,0,0,,Әпке!
Dialogue: 0,1:10:01.87,1:10:03.66,Default,,0,0,0,,Чиу сонда болды ма?
Dialogue: 0,1:10:04.16,1:10:06.16,Default,,0,0,0,,Тим әлі осында, мен барамын.
Dialogue: 0,1:10:06.50,1:10:07.37,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:10:08.87,1:10:09.70,Default,,0,0,0,,Тинму!
Dialogue: 0,1:10:09.83,1:10:10.66,Default,,0,0,0,,Тинму!
Dialogue: 0,1:10:10.83,1:10:11.66,Default,,0,0,0,,Тинму!
Dialogue: 0,1:10:12.33,1:10:13.25,Default,,0,0,0,,Тинму!
Dialogue: 0,1:10:14.50,1:10:15.37,Default,,0,0,0,,Тинму!
Dialogue: 0,1:10:27.04,1:10:29.04,Default,,0,0,0,,Берілме!
Dialogue: 0,1:10:30.79,1:10:32.75,Default,,0,0,0,,Теңіз аспанының қақпасына ұшыңыз
Dialogue: 0,1:10:38.33,1:10:40.00,Default,,0,0,0,,Өйткені менде бәрі жақсы
Dialogue: 0,1:10:40.25,1:10:41.45,Default,,0,0,0,,Бір қария бар
Dialogue: 0,1:10:43.50,1:10:45.20,Default,,0,0,0,,Ақымақсың, тұра алмайсың.
Dialogue: 0,1:10:45.79,1:10:46.62,Default,,0,0,0,,Ұш!
Dialogue: 0,1:10:54.16,1:10:55.00,Default,,0,0,0,,Бұл құбыжық!
Dialogue: 0,1:10:57.54,1:10:58.66,Default,,0,0,0,,Ұстаңыз!
Dialogue: 0,1:10:59.20,1:11:01.45,Default,,0,0,0,,Алдымен Тиммуды сақтаңыз
Dialogue: 0,1:11:01.87,1:11:04.45,Default,,0,0,0,,Маған қашып кетуге жол берме! апатты кесіңіз
Dialogue: 0,1:11:20.20,1:11:21.04,Default,,0,0,0,,Хун!
Dialogue: 0,1:11:32.62,1:11:33.45,Default,,0,0,0,,Хун!
Dialogue: 0,1:11:34.33,1:11:35.20,Default,,0,0,0,,Хун!
Dialogue: 0,1:11:42.62,1:11:43.45,Default,,0,0,0,,Қария
Dialogue: 0,1:11:46.70,1:11:48.16,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,1:11:53.62,1:11:54.66,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:12:14.04,1:12:14.87,Default,,0,0,0,,Қария
Dialogue: 0,1:12:17.00,1:12:17.83,Default,,0,0,0,,Қария
Dialogue: 0,1:12:38.87,1:12:39.75,Default,,0,0,0,,Кемпір!
Dialogue: 0,1:12:53.91,1:12:54.75,Default,,0,0,0,,Хун!
Dialogue: 0,1:12:57.29,1:12:59.41,Default,,0,0,0,,Оны жіберіп алудың еш айыбы жоқ!
Dialogue: 0,1:12:59.91,1:13:01.20,Default,,0,0,0,,Неге сонша?
Dialogue: 0,1:13:01.29,1:13:03.62,Default,,0,0,0,,Менің өмірімді құтқарғаны үшін жасаған жақсылығын қайтару
Dialogue: 0,1:13:04.41,1:13:05.87,Default,,0,0,0,,Оның әпкесі күтіп тұр
Dialogue: 0,1:13:06.29,1:13:08.41,Default,,0,0,0,,Су тасқыны Тиммунды жұтып қойды
Dialogue: 0,1:13:08.66,1:13:10.12,Default,,0,0,0,,Менің әпкем күтіп тұр
Dialogue: 0,1:13:22.12,1:13:23.66,Default,,0,0,0,,Барлығы жүгіреді!
Dialogue: 0,1:13:25.45,1:13:28.20,Default,,0,0,0,,Таудың басына көпір сал!
Dialogue: 0,1:13:28.70,1:13:30.16,Default,,0,0,0,,Фенн, маған қол ұшын берші.
Dialogue: 0,1:13:42.16,1:13:43.87,Default,,0,0,0,,Барлығына қауіп төніп тұр!
Dialogue: 0,1:13:43.95,1:13:44.79,Default,,0,0,0,,Енді қайтайық
Dialogue: 0,1:13:52.87,1:13:54.66,Default,,0,0,0,,Мен енді сенімен бара алмаймын.
Dialogue: 0,1:13:54.87,1:13:56.29,Default,,0,0,0,,Мен отбасыма көмектесуім керек
Dialogue: 0,1:14:08.91,1:14:10.00,Default,,0,0,0,,Бауырым!
Dialogue: 0,1:14:10.08,1:14:11.58,Default,,0,0,0,,Тимму ше?
Dialogue: 0,1:14:11.91,1:14:13.00,Default,,0,0,0,,Оны таба алмадым
Dialogue: 0,1:14:13.33,1:14:14.87,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:14:16.58,1:14:18.12,Default,,0,0,0,,Маған бауырымды қайтар!
Dialogue: 0,1:14:25.87,1:14:27.66,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:14:31.58,1:14:33.54,Default,,0,0,0,,Қазір көмектесейік!
Dialogue: 0,1:14:36.75,1:14:37.70,Default,,0,0,0,,Келме!
Dialogue: 0,1:14:41.54,1:14:44.08,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,1:14:44.41,1:14:46.16,Default,,0,0,0,,Маған Тинмуды қайтар!
Dialogue: 0,1:15:25.29,1:15:27.50,Default,,0,0,0,,Асығыңыз! Кешіктірме!
Dialogue: 0,1:16:08.87,1:16:10.20,Default,,0,0,0,,Фен!
Dialogue: 0,1:16:15.54,1:16:16.70,Default,,0,0,0,,Бәріне мен кінәлімін
Dialogue: 0,1:16:17.50,1:16:19.16,Default,,0,0,0,,Мен енді қиналғым келмейді
Dialogue: 0,1:16:20.54,1:16:21.37,Default,,0,0,0,,Күн-
Dialogue: 0,1:16:21.79,1:16:23.41,Default,,0,0,0,,Қолыңнан келгеннің бәрін жасап, ұш
Dialogue: 0,1:16:24.29,1:16:25.33,Default,,0,0,0,,Бұл жерден кет
Dialogue: 0,1:16:27.54,1:16:29.54,Default,,0,0,0,,Керемет өмір сүріңіз
Dialogue: 0,1:16:30.08,1:16:31.29,Default,,0,0,0,,Дәл бұрынғы күндер сияқты
Dialogue: 0,1:16:33.08,1:16:34.12,Default,,0,0,0,,Мен сенемін
Dialogue: 0,1:16:41.20,1:16:42.66,Default,,0,0,0,,Ата, күте тұрыңыз.
Dialogue: 0,1:18:21.04,1:18:22.00,Default,,0,0,0,,Анашым!
Dialogue: 0,1:18:23.58,1:18:24.58,Default,,0,0,0,,Анашым!
Dialogue: 0,1:18:24.79,1:18:26.12,Default,,0,0,0,,Міне!
Dialogue: 0,1:18:26.45,1:18:27.29,Default,,0,0,0,,Бауырым!
Dialogue: 0,1:20:06.04,1:20:08.70,Default,,0,0,0,,Мен көптен күттім.
Dialogue: 0,1:20:41.25,1:20:42.33,Default,,0,0,0,,Бармадың ба?
Dialogue: 0,1:20:45.41,1:20:47.41,Default,,0,0,0,,Сәулелер арқылы жасалған
Dialogue: 0,1:20:47.75,1:20:49.75,Default,,0,0,0,,Сәйкес келетінін көру үшін оны киіп көріңіз.
Dialogue: 0,1:20:50.75,1:20:51.58,Default,,0,0,0,,Рахмет
Dialogue: 0,1:20:55.00,1:20:56.08,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,1:20:56.79,1:20:57.70,Default,,0,0,0,,Мен өлсем де
Dialogue: 0,1:20:58.04,1:20:58.95,Default,,0,0,0,,Мені қыран құтқарды
Dialogue: 0,1:20:59.41,1:21:01.41,Default,,0,0,0,,Бірақ мен сиқырлы күшімді жоғалттым.
Dialogue: 0,1:21:01.83,1:21:03.20,Default,,0,0,0,,Мен мұнда бара алмаймын
Dialogue: 0,1:21:03.41,1:21:04.41,Default,,0,0,0,,Барлығы ше?
Dialogue: 0,1:21:05.04,1:21:07.04,Default,,0,0,0,,Уайымдама, сен мені құтқардың.
Dialogue: 0,1:21:08.20,1:21:10.75,Default,,0,0,0,,Су тасқыны су мен жерді байланыстырды
Dialogue: 0,1:21:11.79,1:21:14.70,Default,,0,0,0,,Оңтүстікке барсаңыз, Нантиан көлін табасыз.
Dialogue: 0,1:21:15.20,1:21:17.00,Default,,0,0,0,,Мені үйге апарыңыз
Dialogue: 0,1:21:18.70,1:21:20.87,Default,,0,0,0,,Адам әлеміне оралғанда...
Dialogue: 0,1:21:21.58,1:21:22.95,Default,,0,0,0,,Мен сені ұмытамын
Dialogue: 0,1:21:24.37,1:21:25.25,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,1:21:27.08,1:21:28.91,Default,,0,0,0,,Анама менің тірі екенімді айт
Dialogue: 0,1:21:31.12,1:21:31.95,Default,,0,0,0,,Олай болса
Dialogue: 0,1:21:35.83,1:21:36.66,Default,,0,0,0,,(Көпшіліктің сыбыры) «Ал мен сені, құштарлығымның нысаны, жасырып жүрген сезімдерім—»
Dialogue: 0,1:21:38.16,1:21:39.33,Default,,0,0,0,,Пайдасыз
Dialogue: 0,1:21:40.04,1:21:41.70,Default,,0,0,0,,Өйткені бұл мәміле
Dialogue: 0,1:21:42.25,1:21:45.58,Default,,0,0,0,,Сен үшін жанын қиған балаға алғыс айт.
Dialogue: 0,1:21:59.00,1:21:59.87,Default,,0,0,0,,Өтінемін…
Dialogue: 0,1:22:01.04,1:22:01.91,Default,,0,0,0,,Өтінемін…
Dialogue: 0,1:22:02.66,1:22:04.37,Default,,0,0,0,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,1:22:04.83,1:22:06.45,Default,,0,0,0,,Бірге барайық!
Dialogue: 0,1:22:09.29,1:22:11.25,Default,,0,0,0,,Мен жүзе алмаймын!
Dialogue: 0,1:22:33.25,1:22:34.45,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,1:22:35.95,1:22:36.91,Default,,0,0,0,,Жұлдыздарға толы
Dialogue: 0,1:22:39.83,1:22:41.37,Default,,0,0,0,,Аспанға қарасаң...
Dialogue: 0,1:22:42.12,1:22:43.45,Default,,0,0,0,,Бірдеңе қоңырау шалып тұр
Dialogue: 0,1:22:46.41,1:22:47.33,Default,,0,0,0,,Сіз өлгенде-
Dialogue: 0,1:22:47.87,1:22:49.87,Default,,0,0,0,,Мен ашық аспан көре алмаймын
Dialogue: 0,1:22:51.04,1:22:53.83,Default,,0,0,0,,Махаббат жұлдыздар сияқты мәңгілік деп ойлайсың ба?
Dialogue: 0,1:22:55.33,1:22:56.16,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,1:22:58.08,1:23:00.75,Default,,0,0,0,,Мен Кунды жіберсем, ол менімен қайтып келеді?
Dialogue: 0,1:23:01.79,1:23:04.08,Default,,0,0,0,,Мен қайтып бара алмаймын, өйткені менің күшім кетті.
Dialogue: 0,1:23:05.45,1:23:06.66,Default,,0,0,0,,Адам әлемі жақсы жер
Dialogue: 0,1:23:07.45,1:23:08.79,Default,,0,0,0,,Онда тұрғың келе ме? ―
Dialogue: 0,1:23:09.62,1:23:10.45,Default,,0,0,0,,Кун және
Dialogue: 0,1:23:11.29,1:23:12.37,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:23:13.12,1:23:14.37,Default,,0,0,0,,Басқа әлемнен келген адам
Dialogue: 0,1:23:15.66,1:23:18.41,Default,,0,0,0,,Мен жай ғана сіз мұны істегіңіз келе ме деп сұрадым.
Dialogue: 0,1:23:31.20,1:23:32.54,Default,,0,0,0,,Сен маған тамақ ішкенде ұнайсың
Dialogue: 0,1:23:33.91,1:23:35.25,Default,,0,0,0,,Мына сурет сүйкімді
Dialogue: 0,1:23:40.00,1:23:41.08,Default,,0,0,0,,Әртүрлі адамдар
Dialogue: 0,1:23:42.08,1:23:43.20,Default,,0,0,0,,Сен қыңыр адамсың
Dialogue: 0,1:23:43.66,1:23:44.58,Default,,0,0,0,,Сіз ашулысыз
Dialogue: 0,1:23:45.16,1:23:46.00,Default,,0,0,0,,Қайғылы уақыттар-
Dialogue: 0,1:23:46.91,1:23:49.54,Default,,0,0,0,,Ұялсаң да сұлусың
Dialogue: 0,1:23:51.12,1:23:52.54,Default,,0,0,0,,Аға мен қарындас сияқтысыңдар
Dialogue: 0,1:23:54.33,1:23:55.16,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:24:11.70,1:24:12.54,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,1:24:13.33,1:24:14.16,Default,,0,0,0,,Иә
Dialogue: 0,1:24:16.08,1:24:16.95,Default,,0,0,0,,Суық емес пе?
Dialogue: 0,1:24:17.79,1:24:19.16,Default,,0,0,0,,- Тыныштық - Қайырлы түн
Dialogue: 0,1:24:19.87,1:24:20.70,Default,,0,0,0,,Иә
Dialogue: 0,1:24:26.20,1:24:27.54,Default,,0,0,0,,Чиу
Dialogue: 0,1:24:28.66,1:24:30.58,Default,,0,0,0,,Әрқашанғыдай рахмет.
Dialogue: 0,1:24:31.83,1:24:34.54,Default,,0,0,0,,Сіз әлемдегі ең мейірімді адамсыз
Dialogue: 0,1:25:51.16,1:25:52.41,Default,,0,0,0,,Біз тағы кездесеміз бе?
Dialogue: 0,1:25:53.58,1:25:54.66,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,1:25:57.29,1:25:58.83,Default,,0,0,0,,Бір күні кездескенше
Dialogue: 0,1:25:59.95,1:26:01.87,Default,,0,0,0,,Басқаша көрінсе де...
Dialogue: 0,1:26:02.33,1:26:04.79,Default,,0,0,0,,Мен олардың бірге болатынына сенімдімін
Dialogue: 0,1:27:00.50,1:27:01.95,Default,,0,0,0,,Хун!
Dialogue: 0,1:28:09.41,1:28:10.33,Default,,0,0,0,,Баратын уақыт
Dialogue: 0,1:28:11.66,1:28:12.54,Default,,0,0,0,,Үйге қайт
Dialogue: 0,1:30:26.20,1:30:27.66,Default,,0,0,0,,Міне!
Dialogue: 0,1:30:28.12,1:30:29.12,Default,,0,0,0,,Қолымды ұста!
Dialogue: 0,1:30:31.12,1:30:33.00,Default,,0,0,0,,Асығыңыз! Менің уақытым жоқ!
Dialogue: 0,1:30:37.04,1:30:38.16,Default,,0,0,0,,Жерде не болады?
Dialogue: 0,1:30:38.75,1:30:40.04,Default,,0,0,0,,қабылдау
Dialogue: 0,1:30:40.16,1:30:41.62,Default,,0,0,0,,Кунға оралу!
Dialogue: 0,1:30:42.79,1:30:44.29,Default,,0,0,0,,Үйге кіммен барасың?
Dialogue: 0,1:30:44.54,1:30:46.66,Default,,0,0,0,,Мен сенің өміріңді қайтардым.
Dialogue: 0,1:30:46.83,1:30:48.50,Default,,0,0,0,,Мен сені адам әлеміне жіберемін
Dialogue: 0,1:30:50.37,1:30:52.29,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,1:30:54.00,1:30:55.00,Default,,0,0,0,,Біз бұрын кездескенбіз! Біз бұрын кездескенбіз!
Dialogue: 0,1:30:55.91,1:30:56.91,Default,,0,0,0,,Шын мәнінде мектеп автобусымен келдің бе?
Dialogue: 0,1:30:57.16,1:30:58.00,Default,,0,0,0,,Біз бұрын кездескенбіз! Біз бұрын кездескенбіз!
Dialogue: 0,1:30:59.12,1:31:01.20,Default,,0,0,0,,Мен сенің қолыңды жібермеймін деп уәде беруім керек.
Dialogue: 0,1:31:01.58,1:31:02.41,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,1:31:03.45,1:31:04.54,Default,,0,0,0,,Жеткізу
Dialogue: 0,1:31:05.25,1:31:07.33,Default,,0,0,0,,Өйткені біз міндетті түрде тағы кездесеміз
Dialogue: 0,1:31:11.12,1:31:14.37,Default,,0,0,0,,Мен сені кеше құшақтап алсам ғой
Dialogue: 0,1:31:15.58,1:31:16.87,Default,,0,0,0,,Бақытты және бақытты бол
Dialogue: 0,1:31:17.66,1:31:18.54,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:31:23.91,1:31:25.41,Default,,0,0,0,,Үшеуімен ұш
Dialogue: 0,1:31:27.00,1:31:27.91,Default,,0,0,0,,Оған сеніңіз!
Dialogue: 0,1:31:29.95,1:31:30.79,Default,,0,0,0,,Бір!
Dialogue: 0,1:31:31.41,1:31:32.25,Default,,0,0,0,,Екі!
Dialogue: 0,1:31:33.00,1:31:33.83,Default,,0,0,0,,Үш!
Dialogue: 0,1:31:40.54,1:31:43.29,Default,,0,0,0,,Жел мен жаңбыр болып, сенімен бірге бол
Dialogue: 0,1:31:47.70,1:31:48.54,Default,,0,0,0,,Чиу!
Dialogue: 0,1:31:49.91,1:31:50.75,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,1:31:51.91,1:31:52.75,Default,,0,0,0,,Чиу
Dialogue: 0,1:33:15.16,1:33:16.79,Default,,0,0,0,,Сіз ғажайыптарға сенесіз бе?
Dialogue: 0,1:33:18.79,1:33:20.83,Default,,0,0,0,,Өмір - кету
Dialogue: 0,1:33:21.91,1:33:23.91,Default,,0,0,0,,Нәтижелер көрінсе де-
Dialogue: 0,1:33:24.25,1:33:27.00,Default,,0,0,0,,Бізді қанша ұрпақ күту керек?
Dialogue: 0,1:33:29.12,1:33:32.37,Default,,0,0,0,,Өмір қысқа, өлесің ақыры
Dialogue: 0,1:33:33.54,1:33:35.54,Default,,0,0,0,,Кішкене батылырақ болыңыз
Dialogue: 0,1:33:36.25,1:33:37.41,Default,,0,0,0,,Ғашық болу
Dialogue: 0,1:33:38.00,1:33:39.16,Default,,0,0,0,,Тауға шығу
Dialogue: 0,1:33:39.87,1:33:40.83,Default,,0,0,0,,Өз армандарыңа жете бер
Dialogue: 0,1:33:42.58,1:33:45.29,Default,,0,0,0,,Иә, неғұрлым батыл болса, соғұрлым жақсы.
Dialogue: 0,1:33:47.95,1:33:50.45,Default,,0,0,0,,Мен түсінбейтін нәрселер көп
Dialogue: 0,1:33:51.45,1:33:53.91,Default,,0,0,0,,Жауап әрқашан болмауы мүмкін
Dialogue: 0,1:33:55.12,1:33:56.00,Default,,0,0,0,,Бірақ менің ойымша
Dialogue: 0,1:33:57.12,1:33:58.79,Default,,0,0,0,,Аспан бізге өмір берді...
Dialogue: 0,1:33:59.54,1:34:02.54,Default,,0,0,0,,Ғажайыптар жасау
Dialogue: 0,1:34:52.12,1:34:54.91,Default,,0,0,0,,Жапон субтитрлері Наоки Окай
Dialogue: 0,1:38:21.00,1:38:21.95,Default,,0,0,0,,Уақыт келді
Dialogue: 0,1:38:39.50,1:38:40.54,Default,,0,0,0,,О… Қарт адам
Dialogue: 0,1:38:41.08,1:38:42.91,Default,,0,0,0,,Бүркіттің ізімен жүр
Dialogue: 0,1:38:44.87,1:38:47.58,Default,,0,0,0,,Ерте заманда Чун (түйе) деген үлкен ағаш болған.
Dialogue: 0,1:38:47.79,1:38:50.83,Default,,0,0,0,,Сол дүниенің көктемі сегіз мың жылға созылды.
Dialogue: 0,1:38:50.95,1:38:53.58,Default,,0,0,0,,Күзге де 8000 жыл
Dialogue: 0,1:38:55.08,1:39:01.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory