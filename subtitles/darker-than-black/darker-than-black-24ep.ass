Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.04,Default,,0,0,0,,Бір жерге ауылға шегініп, балық аулауды ойлап жүрмін.
Dialogue: 0,0:00:07.05,0:00:08.01,Default,,0,0,0,,Балық аулау?
Dialogue: 0,0:00:08.08,0:00:10.09,Default,,0,0,0,,Мен ол жерге жиі баратынмын.
Dialogue: 0,0:00:11.00,0:00:12.09,Default,,0,0,0,,Мен шпательге маманданамын.
Dialogue: 0,0:00:13.02,0:00:15.03,Default,,0,0,0,,Шөпті тұқы тәрізді мұздары бар.
Dialogue: 0,0:00:15.03,0:00:16.00,Default,,0,0,0,,Шулы
Dialogue: 0,0:00:16.09,0:00:20.08,Default,,0,0,0,,Ағып жатқан суға қарасам, уақытты ұмытамын.
Dialogue: 0,0:00:20.09,0:00:26.01,Default,,0,0,0,,Міне, біздің өміріміз өзеннен ағып жатқан жапырақтар сияқты.
Dialogue: 0,0:00:27.04,0:00:29.03,Default,,0,0,0,,Эй, сен жақсы нәрсе айттың.
Dialogue: 0,0:00:29.04,0:00:30.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:35.04,0:00:38.05,Default,,0,0,0,,Иә? Не? Сіз от жаға аласыз ба?
Dialogue: 0,0:00:40.09,0:00:42.00,Default,,0,0,0,,Ең алдымен, сен—
Dialogue: 0,0:00:42.07,0:00:44.01,Default,,0,0,0,,Темекіні тастау
Dialogue: 0,0:00:44.07,0:00:46.07,Default,,0,0,0,,Сіз тым ұялшақсыз
Dialogue: 0,0:00:50.08,0:00:51.06,Default,,0,0,0,,Ой
Dialogue: 0,0:01:01.05,0:01:02.05,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:01:09.05,0:01:12.06,Default,,0,0,0,,Нысана әлі күнге дейін Қошу тас жолымен шығысқа қарай жылжиды
Dialogue: 0,0:01:16.08,0:01:18.06,Default,,0,0,0,,Байқаған кезде қорғаныс сұраңыз
Dialogue: 0,0:01:19.02,0:01:21.01,Default,,0,0,0,,Мені мұқият бақылаңыз
Dialogue: 0,0:01:22.01,0:01:25.08,Default,,0,0,0,,Міне, ақыры басталды.
Dialogue: 0,0:01:26.01,0:01:28.03,Default,,0,0,0,,Ҳ? Не айтпақшысың?
Dialogue: 0,0:01:28.06,0:01:31.05,Default,,0,0,0,,Аяқтаудың басы
Dialogue: 0,0:01:36.04,0:01:39.03,Default,,0,0,0,,Бұл Кирихара, 4-ші сыртқы істер бөлімі, қоғамдық қауіпсіздік департаменті.
Dialogue: 0,0:01:39.06,0:01:42.00,Default,,0,0,0,,Мен доктор Роберт Шрейдермен танысқым келеді.
Dialogue: 0,0:01:42.07,0:01:43.07,Default,,0,0,0,,Уәде
Dialogue: 0,0:01:44.01,0:01:45.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:01:45.09,0:01:47.00,Default,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:01:51.01,0:01:52.06,Default,,0,0,0,,Мен сені кездестіретін сияқтымын.
Dialogue: 0,0:02:01.06,0:02:02.04,Default,,0,0,0,,Бұл да
Dialogue: 0,0:02:02.08,0:02:04.00,Default,,0,0,0,,Мен саған қамқор боламын
Dialogue: 0,0:02:07.08,0:02:08.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:11.01,0:02:13.05,Default,,0,0,0,,Қош келдіңіз суперинтендент Кирихара
Dialogue: 0,0:02:16.01,0:02:19.07,Default,,0,0,0,,Мен доктор Шредермен кездесуді өтінуім керек еді.
Dialogue: 0,0:02:20.02,0:02:23.07,Default,,0,0,0,,Жеке мен екеуміз ғана бақытты болар едім.
Dialogue: 0,0:02:24.01,0:02:26.02,Default,,0,0,0,,Мына кісі талап қояды
Dialogue: 0,0:02:26.09,0:02:31.00,Default,,0,0,0,,Мен әрқашан сенімен сөйлескім келді.
Dialogue: 0,0:02:31.04,0:02:32.09,Default,,0,0,0,,Өкінішке орай, уақытым жоқ
Dialogue: 0,0:02:33.00,0:02:34.09,Default,,0,0,0,,Тез түсіндіріп берейін.
Dialogue: 0,0:02:35.05,0:02:36.08,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,0:02:39.08,0:02:43.08,Default,,0,0,0,,Осыдан бес жыл бұрын Оңтүстік Америкада физикалық қол сұғылмайтын аймақтың құрылуына байланысты,
Dialogue: 0,0:02:44.02,0:02:48.04,Default,,0,0,0,,Біз адамдар, Аспан қақпасына кіру жолын мәңгілікке жоғалттық.
Dialogue: 0,0:02:49.01,0:02:51.08,Default,,0,0,0,,Кең кеңістік және жүздеген миллион адамдар
Dialogue: 0,0:02:52.09,0:02:57.00,Default,,0,0,0,,БК-201 сол жағдайды жасады.
Dialogue: 0,0:02:57.04,0:03:00.09,Default,,0,0,0,,Ол неліктен Оңтүстік Америкадағы қайғылы оқиғаға себепкер болды?
Dialogue: 0,0:03:01.00,0:03:02.07,Default,,0,0,0,,Ол? Жоқ, бұл дұрыс емес.
Dialogue: 0,0:03:03.00,0:03:09.05,Default,,0,0,0,,Мессье коды BK-201 сол кезде басқа әйелді көрсетуі керек еді.
Dialogue: 0,0:03:09.08,0:03:11.00,Default,,0,0,0,,Бұл не? !
Dialogue: 0,0:03:11.05,0:03:15.02,Default,,0,0,0,,Өткен оқиғаларды емес, қазіргі жағдайды түсінгеніңізді қалаймын.
Dialogue: 0,0:03:15.04,0:03:21.00,Default,,0,0,0,,EPR қазір Оңтүстік Америкада дәл осындай құбылысты Токиода тудыруға тырысуда.
Dialogue: 0,0:03:22.06,0:03:24.09,Default,,0,0,0,,Бұл ақпарат қайдан алынды?
Dialogue: 0,0:03:25.04,0:03:28.02,Default,,0,0,0,,Біз олармен мәңгі күресіп келеміз
Dialogue: 0,0:03:28.05,0:03:30.00,Default,,0,0,0,,Білмейтін жол жоқ
Dialogue: 0,0:03:31.00,0:03:34.04,Default,,0,0,0,,Токиодағы жарылыс Біз оны осылай атаймыз
Dialogue: 0,0:03:35.06,0:03:38.06,Default,,0,0,0,,Егер жарылыс Оңтүстік Америкадағыдай масштабта болса
Dialogue: 0,0:03:39.01,0:03:41.09,Default,,0,0,0,,Бүкіл жапон архипелагы қол сұғылмайтын аумаққа жұтылды.
Dialogue: 0,0:03:42.04,0:03:45.03,Default,,0,0,0,,Бар болмыс жұқа ауада жоғалады
Dialogue: 0,0:03:46.04,0:03:48.01,Default,,0,0,0,,Бірақ уайымдамаңыз
Dialogue: 0,0:03:48.04,0:03:50.02,Default,,0,0,0,,Біз бұған жол бермейміз
Dialogue: 0,0:03:51.00,0:03:52.07,Default,,0,0,0,,«Фусегу» сөзін қалай айтасыз?
Dialogue: 0,0:03:53.00,0:03:55.08,Default,,0,0,0,,Біз тозақ қақпасын жойамыз.
Dialogue: 0,0:03:56.04,0:03:58.04,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:03:58.07,0:03:59.05,Default,,0,0,0,,Әрине
Dialogue: 0,0:04:00.00,0:04:02.00,Default,,0,0,0,,Денсаулық ойынын қоршап тұрған қабырға
Dialogue: 0,0:04:02.03,0:04:05.02,Default,,0,0,0,,Зиянкестердің алдын алу үшін ғана емес
Dialogue: 0,0:04:05.09,0:04:09.03,Default,,0,0,0,,Бұл бір нәрсені қорғайтын берік қамал.
Dialogue: 0,0:04:12.03,0:04:13.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:13.05,0:04:15.02,Default,,0,0,0,,Сатурн жүйесі
Dialogue: 0,0:04:19.03,0:04:23.08,Default,,0,0,0,,Менеджер қауіпті нәрсемен айналысуы керек.
Dialogue: 0,0:04:30.00,0:04:31.03,Default,,0,0,0,,Мен менеджерге сенемін!
Dialogue: 0,0:04:32.00,0:04:34.02,Default,,0,0,0,,Жақсы деймін, артымнан жүр.
Dialogue: 0,0:04:37.02,0:04:37.52,Default,,0,0,0,,Иә
Dialogue: 0,0:04:38.01,0:04:39.02,Default,,0,0,0,,Ах, Мацумото-сан.
Dialogue: 0,0:04:40.00,0:04:42.05,Default,,0,0,0,,Иә, Коно да менімен бірге.
Dialogue: 0,0:04:43.00,0:04:43.50,Default,,0,0,0,,Иә
Dialogue: 0,0:04:45.02,0:04:46.03,Default,,0,0,0,,Бұл не? ?
Dialogue: 0,0:04:47.02,0:04:48.08,Default,,0,0,0,,Коно Пандораға барайық!
Dialogue: 0,0:04:49.05,0:04:50.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:50.06,0:04:52.02,Default,,0,0,0,,Менеджер сонда.
Dialogue: 0,0:04:52.09,0:04:53.08,Default,,0,0,0,,Есептік жазбаны осында қоямын.
Dialogue: 0,0:04:53.08,0:04:54.07,Default,,0,0,0,,Омайдо
Dialogue: 0,0:04:59.02,0:05:01.09,Default,,0,0,0,,Ей, не болып жатыр?
Dialogue: 0,0:05:02.05,0:05:05.09,Default,,0,0,0,,Үлкен қара дақ пайда болғаннан кейін 45-ші күні пайда болады.
Dialogue: 0,0:05:05.09,0:05:09.01,Default,,0,0,0,,Ауданды ұлғайтудың соңғы кезеңіне жақындау
Dialogue: 0,0:05:09.01,0:05:12.00,Default,,0,0,0,,Бұл күйді шамамен 30 минут ұстаңыз
Dialogue: 0,0:05:12.05,0:05:14.02,Default,,0,0,0,,Сол 30 минут ішінде
Dialogue: 0,0:05:14.05,0:05:18.05,Default,,0,0,0,,Сатурн сақинасы тудыратын және үдететін анти-қақпа бөлшектері
Dialogue: 0,0:05:18.06,0:05:21.04,Default,,0,0,0,,Тозақ қақпасының өзегіне оқ атсаң
Dialogue: 0,0:05:21.08,0:05:23.06,Default,,0,0,0,,Гейтс жойылды
Dialogue: 0,0:05:24.03,0:05:28.08,Default,,0,0,0,,Айтпақшы, BK-201 Токиодағы жарылысты да тудыруы мүмкін.
Dialogue: 0,0:05:28.08,0:05:31.01,Default,,0,0,0,,осы соңғы кезеңмен шектеледі
Dialogue: 0,0:05:32.02,0:05:36.07,Default,,0,0,0,,Бұл біз Оңтүстік Америкада алған үлкен білім мен сабақтардың бірі.
Dialogue: 0,0:05:36.09,0:05:38.02,Default,,0,0,0,,Қызық, солай ма?
Dialogue: 0,0:05:38.04,0:05:44.04,Default,,0,0,0,,Соңғы 30 минут ішінде адамдар мен мердігерлер арасындағы шайқас болды.
Dialogue: 0,0:05:45.01,0:05:49.02,Default,,0,0,0,,Ғасыр сәтіне 5 сағат 27 минут қалды
Dialogue: 0,0:05:51.02,0:05:51.52,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:52.03,0:05:55.07,Default,,0,0,0,,Арнайы күштер Хонмачи 2-чоме, Кита-куда соғысу жағдайына кірді.
Dialogue: 0,0:05:56.02,0:05:57.00,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:05:57.05,0:05:59.05,Default,,0,0,0,,О, бұл тек бастамасы ғана.
Dialogue: 0,0:06:00.00,0:06:01.00,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:06:18.01,0:06:20.01,Default,,0,0,0,,асықты асығыс
Dialogue: 0,0:06:20.06,0:06:25.00,Default,,0,0,0,,Жұлдыздар, жарқырап, жылаңыз
Dialogue: 0,0:06:25.03,0:06:27.04,Default,,0,0,0,,Ағып кету, жоғалу
Dialogue: 0,0:06:30.00,0:06:31.03,Default,,0,0,0,,Көп адамдар түсінбейді
Dialogue: 0,0:06:31.06,0:06:32.09,Default,,0,0,0,,Нақты есеп беріңіз!
Dialogue: 0,0:06:33.01,0:06:35.03,Default,,0,0,0,,Бұл санау мүмкін емес!
Dialogue: 0,0:06:35.08,0:06:36.01,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:37.08,0:06:39.00,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:06:43.02,0:06:45.02,Default,,0,0,0,,Астрономиялық бөлімнің деректері сыртқы ма?
Dialogue: 0,0:06:45.05,0:06:48.01,Default,,0,0,0,,Ол нақты уақытта ағып жатыр
Dialogue: 0,0:06:58.01,0:07:00.02,Default,,0,0,0,,Түсіндім, бұрын естігенмін.
Dialogue: 0,0:07:00.05,0:07:04.08,Default,,0,0,0,,Ресми түрде жоқ метро бар.
Dialogue: 0,0:07:05.03,0:07:07.08,Default,,0,0,0,,Қақпаның пайда болуынан туындаған шатасуға байланысты
Dialogue: 0,0:07:07.09,0:07:10.08,Default,,0,0,0,,Осыған қатысты материалдар да жоғалған
Dialogue: 0,0:07:11.02,0:07:13.01,Default,,0,0,0,,Қазір күзетсіз
Dialogue: 0,0:07:14.07,0:07:16.05,Default,,0,0,0,,Әй, жүресің бе?
Dialogue: 0,0:07:16.08,0:07:18.07,Default,,0,0,0,,Электр қуаты өшірілген
Dialogue: 0,0:07:18.08,0:07:23.03,Default,,0,0,0,,Екінші жағынан, тіпті полицияның бақылаушы рухтары да басып кіре алмайды.
Dialogue: 0,0:07:25.04,0:07:26.00,Default,,0,0,0,,Күміс
Dialogue: 0,0:07:28.04,0:07:29.02,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:07:52.09,0:07:57.07,Default,,0,0,0,,Жоқ, қоғамдық қауіпсіздік болсын, басқасы болсын, бұл жерден өте алмайтын жер бар.
Dialogue: 0,0:07:58.00,0:07:58.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:59.03,0:08:03.04,Default,,0,0,0,,Сайто мырза, бас кеңсеге оралғанымыз дұрыс емес пе?
Dialogue: 0,0:08:03.07,0:08:05.07,Default,,0,0,0,,Қалай қарасаң да мердігерге қатысты...
Dialogue: 0,0:08:05.07,0:08:06.08,Default,,0,0,0,,Күту режимінде екеніңізді естідім.
Dialogue: 0,0:08:06.08,0:08:07.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.07,0:08:09.05,Default,,0,0,0,,Сіз жаңа ғана телефон соғу туралы болды.
Dialogue: 0,0:08:09.07,0:08:11.08,Default,,0,0,0,,Бізге күту бұйырылды.
Dialogue: 0,0:08:12.02,0:08:14.09,Default,,0,0,0,,Егер сіз бас кеңсеге қайта барсаңыз, олар сізді бөлмеңізден шығармайды.
Dialogue: 0,0:08:15.04,0:08:16.01,Default,,0,0,0,,Не? ол
Dialogue: 0,0:08:16.03,0:08:16.53,Default,,0,0,0,,біз қайта орала аламыз.
Dialogue: 0,0:08:17.01,0:08:20.02,Default,,0,0,0,,Бұл жағдайда мұндай ақымақ тәртіп бар ма?
Dialogue: 0,0:08:20.05,0:08:22.05,Default,,0,0,0,,Жоғарыдағы адамдар не ойлайды?
Dialogue: 0,0:08:23.01,0:08:25.07,Default,,0,0,0,,Жарқыраған, жылтыр
Dialogue: 0,0:08:26.00,0:08:27.04,Default,,0,0,0,,Құрметті Жұлдыз
Dialogue: 0,0:08:27.09,0:08:34.04,Default,,0,0,0,,Аспан толқынында ұшқындап, Мені сыпырып, қайда барамын?
Dialogue: 0,0:08:34.07,0:08:38.08,Default,,0,0,0,,Мен мұны істемеймін.
Dialogue: 0,0:08:44.05,0:08:45.04,Default,,0,0,0,,Бұл басталды.
Dialogue: 0,0:08:46.02,0:08:46.52,Default,,0,0,0,,Иә
Dialogue: 0,0:08:48.00,0:08:50.02,Default,,0,0,0,,Қалғаны жоспарланғандай болады.
Dialogue: 0,0:08:54.08,0:08:55.06,Default,,0,0,0,,Эмбер ше?
Dialogue: 0,0:08:55.06,0:08:56.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:04.08,0:09:06.03,Default,,0,0,0,,Жұмыртқа бар ма?
Dialogue: 0,0:09:06.09,0:09:07.06,Default,,0,0,0,,Маған беріңіз
Dialogue: 0,0:09:13.02,0:09:15.02,Default,,0,0,0,,Бұл дәл қабырға астында ма?
Dialogue: 0,0:09:15.08,0:09:18.03,Default,,0,0,0,,Олар сізді оңай өткізбейтін сияқты.
Dialogue: 0,0:09:18.07,0:09:19.05,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:09:21.02,0:09:22.03,Default,,0,0,0,,Мұны орындаңыз
Dialogue: 0,0:09:27.04,0:09:28.03,Default,,0,0,0,,Сіз нені айтасыз? !
Dialogue: 0,0:09:28.05,0:09:33.00,Default,,0,0,0,,Менің Эмберге берген уәдем сізге осында басшылық ету.
Dialogue: 0,0:09:33.02,0:09:36.02,Default,,0,0,0,,Одан кейін өзіңізге ұнайтын нәрсені істеу шартымен.
Dialogue: 0,0:09:40.00,0:09:45.05,Default,,0,0,0,,Мен Эмбермен бірге сенімен тағы да төбелесу үшін жұмыс істедім.
Dialogue: 0,0:09:45.08,0:09:49.05,Default,,0,0,0,,Егер мен EPR-да қалсам, сізбен кездесермін деп ойладым.
Dialogue: 0,0:09:50.02,0:09:54.07,Default,,0,0,0,,Бұл билікті алғаннан кейін менің басқа біреуден жеңілуім мүмкін емес еді.
Dialogue: 0,0:09:54.08,0:09:58.02,Default,,0,0,0,,Сіз бұл қорлауды түсінесіз бе?
Dialogue: 0,0:09:58.04,0:09:58.54,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:59.05,0:10:00.09,Default,,0,0,0,,Мен солай ойлаймын!
Dialogue: 0,0:10:06.09,0:10:08.00,Default,,0,0,0,,Қорлау?
Dialogue: 0,0:10:08.04,0:10:11.07,Default,,0,0,0,,Сіз мердігер болсаңыз да, күлкілі сөздер айтасыз.
Dialogue: 0,0:10:29.08,0:10:34.06,Default,,0,0,0,,Тозақ қақпасы мен Жұмақ қақпасы бір тиынның екі жағы.
Dialogue: 0,0:10:35.09,0:10:39.09,Default,,0,0,0,,Біреуін жойсаң, екіншісін жоя аласың.
Dialogue: 0,0:10:40.09,0:10:44.04,Default,,0,0,0,,Қақпа жоғалып кетсе, мердігерге не болады?
Dialogue: 0,0:10:44.07,0:10:48.05,Default,,0,0,0,,Осы қант сияқты бәрі еріп, жоғалады
Dialogue: 0,0:10:48.07,0:10:51.07,Default,,0,0,0,,Міне! Бұл рас па? Яғни
Dialogue: 0,0:10:52.01,0:10:54.07,Default,,0,0,0,,Рас, мен тәжірибе жасадым.
Dialogue: 0,0:10:54.08,0:10:56.09,Default,,0,0,0,,Ақымақ! Сен ше? !
Dialogue: 0,0:10:57.03,0:11:01.03,Default,,0,0,0,,Тіпті мердігерлер де адам. Олардың бәрі қылмыскер емес!
Dialogue: 0,0:11:01.07,0:11:04.03,Default,,0,0,0,,мыңдаған жазылушыларға арналған
Dialogue: 0,0:11:04.06,0:11:07.04,Default,,0,0,0,,Сіз бізден жүздеген миллион адамдарды құрбан етуді сұрайсыз ба?
Dialogue: 0,0:11:09.06,0:11:12.01,Default,,0,0,0,,Гуманизм туралы айту оңай, бірақ
Dialogue: 0,0:11:12.09,0:11:15.07,Default,,0,0,0,,Шындықты елемеу арқылы қоғамға қауіп төндіру
Dialogue: 0,0:11:15.09,0:11:20.09,Default,,0,0,0,,Бұл полиция қызметкері үшін жарамсыз әрекет деп ойламайсыз ба? Кирихара
Dialogue: 0,0:11:21.05,0:11:22.02,Default,,0,0,0,,Менеджер
Dialogue: 0,0:11:22.09,0:11:26.01,Default,,0,0,0,,Менің қарамағымдағы қызметкер Нишижима мырза менен кешірім сұрады
Dialogue: 0,0:11:26.03,0:11:29.02,Default,,0,0,0,,Жоқ, бұл өте қызықты уақыт болды.
Dialogue: 0,0:11:29.05,0:11:30.08,Default,,0,0,0,,Қалғанын сізге қалдырамын.
Dialogue: 0,0:11:31.02,0:11:33.02,Default,,0,0,0,,Соңғы шеге күтіп тұр
Dialogue: 0,0:11:35.01,0:11:37.01,Default,,0,0,0,,Матана Оджо-чан
Dialogue: 0,0:11:41.06,0:11:46.08,Default,,0,0,0,,Сатурн сақинасын белсендіру біз үшін де қиын шешім.
Dialogue: 0,0:11:47.03,0:11:51.01,Default,,0,0,0,,Сонда сіз де арғы жағында болдыңыз ба?
Dialogue: 0,0:11:53.07,0:11:57.02,Default,,0,0,0,,Pandora – Біріккен Ұлттар Ұйымының Басқару бөлімінің ғылыми-зерттеу институты ғана.
Dialogue: 0,0:11:57.08,0:12:02.06,Default,,0,0,0,,Жүздеген миллион адамдардың өміріне әсер ететін операцияларды өз бетімен орындауға ешкімнің құқы жоқ.
Dialogue: 0,0:12:02.09,0:12:06.03,Default,,0,0,0,,Бұл жерде жасалып жатқан нәрсе билікті бұзу екені анық.
Dialogue: 0,0:12:06.06,0:12:07.05,Default,,0,0,0,,Бұл қылмыс
Dialogue: 0,0:12:08.01,0:12:13.00,Default,,0,0,0,,Ұлы державаның ұлт шеңберінен шығатын ерік-жігері болмаса,
Dialogue: 0,0:12:13.02,0:12:15.04,Default,,0,0,0,,Осы уақытқа дейін оны жасыру мүмкін емес еді.
Dialogue: 0,0:12:16.01,0:12:18.00,Default,,0,0,0,,11 қараша қайда болды?
Dialogue: 0,0:12:18.05,0:12:21.07,Default,,0,0,0,,Бұл зор күшке ие ұйым болды.
Dialogue: 0,0:12:22.03,0:12:24.09,Default,,0,0,0,,Сіз мұны түсінбеуіңіз мүмкін
Dialogue: 0,0:12:25.01,0:12:28.05,Default,,0,0,0,,Сіз ұйымның мүшесісіз.
Dialogue: 0,0:12:28.07,0:12:29.05,Default,,0,0,0,,Мен?
Dialogue: 0,0:12:29.07,0:12:30.04,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:31.01,0:12:34.06,Default,,0,0,0,,Әр елдің билігіне, үкіметіне және билік басындағыларға.
Dialogue: 0,0:12:34.06,0:12:36.01,Default,,0,0,0,,Ұйымның қолжетімділігі
Dialogue: 0,0:12:36.06,0:12:38.08,Default,,0,0,0,,Әлемдік тәртіпті қорғау
Dialogue: 0,0:12:39.03,0:12:42.00,Default,,0,0,0,,Мүмкін BK-201 де шығар?
Dialogue: 0,0:12:42.08,0:12:46.05,Default,,0,0,0,,BK-201 Код атауы Эй
Dialogue: 0,0:12:46.08,0:12:48.08,Default,,0,0,0,,Ол да ұйымның мүшесі.
Dialogue: 0,0:12:49.06,0:12:52.03,Default,,0,0,0,,Ол қазір жоғалып кеткенімен.
Dialogue: 0,0:12:52.05,0:12:54.02,Default,,0,0,0,,Жоғалып кетті ме?
Dialogue: 0,0:12:57.07,0:13:00.05,Default,,0,0,0,,Неге енді маған шындықты айттың?
Dialogue: 0,0:13:00.09,0:13:02.09,Default,,0,0,0,,Қараша сияқты...
Dialogue: 0,0:13:03.04,0:13:05.03,Default,,0,0,0,,Өлтіру оңай
Dialogue: 0,0:13:05.04,0:13:09.03,Default,,0,0,0,,Бірақ біз әрқашан талантты адамдарды қалаймыз.
Dialogue: 0,0:13:09.06,0:13:11.03,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:13:28.09,0:13:30.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:30.03,0:13:32.08,Default,,0,0,0,,Бұл бәрінен кейін бола ма?
Dialogue: 0,0:13:33.05,0:13:34.05,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:13:35.00,0:13:42.02,Default,,0,0,0,,Егер мен сені өлтіретін болсам, мен саған нұсқау бере алмаймын.
Dialogue: 0,0:13:42.06,0:13:45.08,Default,,0,0,0,,Сіз жеңілетініңізді әу бастан білдіңіз.
Dialogue: 0,0:13:46.05,0:13:51.00,Default,,0,0,0,,Нәтижесін білсем де, төбелеспей тұра алмадым.
Dialogue: 0,0:13:51.03,0:13:54.09,Default,,0,0,0,,Бұл мердігер үшін негізсіз әрекет.
Dialogue: 0,0:13:55.08,0:13:57.03,Default,,0,0,0,,Бұл сенің кінәң
Dialogue: 0,0:13:57.05,0:13:59.02,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:14:00.00,0:14:02.03,Default,,0,0,0,,Бұл біртүрлі, сен де.
Dialogue: 0,0:14:02.08,0:14:03.08,Default,,0,0,0,,О
Dialogue: 0,0:14:04.05,0:14:07.00,Default,,0,0,0,,BK-201 өтіңіз
Dialogue: 0,0:14:32.06,0:14:36.08,Default,,0,0,0,,Менің әкем жалғыз болғаны өкінішті.
Dialogue: 0,0:15:00.02,0:15:01.00,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:15:03.04,0:15:05.02,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:15:05.06,0:15:08.02,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені бұл өтемақы.
Dialogue: 0,0:15:12.09,0:15:14.03,Default,,0,0,0,,Мен оның сол күйінде болғанын қалаймын.
Dialogue: 0,0:15:14.08,0:15:16.01,Default,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:15:17.06,0:15:18.05,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:15:18.07,0:15:21.04,Default,,0,0,0,,Анау атам осылай жасап жатқан.
Dialogue: 0,0:15:24.00,0:15:25.09,Default,,0,0,0,,Осыны жою мүмкін болса
Dialogue: 0,0:15:45.09,0:15:47.00,Default,,0,0,0,,Кәріптас?
Dialogue: 0,0:15:47.07,0:15:48.05,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:15:49.04,0:15:50.02,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:50.08,0:15:53.04,Default,,0,0,0,,Анау атам осылай жасап жатқан.
Dialogue: 0,0:15:59.09,0:16:00.06,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:16:06.07,0:16:08.07,Default,,0,0,0,,Жақсы! сақина бұзылды
Dialogue: 0,0:16:15.04,0:16:17.06,Default,,0,0,0,,Қақпаға қарсы бөлшектер фокусы тоқтады
Dialogue: 0,0:16:17.06,0:16:18.08,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:19.02,0:16:23.00,Default,,0,0,0,,Мен үшін не істей аласың? Өмірімнің шедеврі
Dialogue: 0,0:16:30.03,0:16:31.00,Default,,0,0,0,,Британ!
Dialogue: 0,0:16:32.08,0:16:33.06,Default,,0,0,0,,Сақина
Dialogue: 0,0:16:34.02,0:16:35.00,Default,,0,0,0,,Жойылған
Dialogue: 0,0:16:35.06,0:16:36.03,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:16:37.00,0:16:39.09,Default,,0,0,0,,Шабуылға қатысқан мүшелердің барлығы дерлік жойылды.
Dialogue: 0,0:16:40.03,0:16:42.04,Default,,0,0,0,,Тірі қалғандар да қаша бастады
Dialogue: 0,0:16:43.00,0:16:43.50,Default,,0,0,0,,Иә
Dialogue: 0,0:16:44.01,0:16:45.01,Default,,0,0,0,,Жаңбырлы тұман
Dialogue: 0,0:16:47.06,0:16:48.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:48.07,0:16:49.05,Default,,0,0,0,,Қақпа...
Dialogue: 0,0:16:49.09,0:16:51.04,Default,,0,0,0,,Бұл қабырғаның ішінен
Dialogue: 0,0:16:51.09,0:16:53.08,Default,,0,0,0,,Бөлшектердің қақпаға қарсы жаңа реакциясы
Dialogue: 0,0:16:54.02,0:16:56.04,Default,,0,0,0,,Сатурн сақинасы әлі жұмыс істей ме?
Dialogue: 0,0:16:57.02,0:17:00.05,Default,,0,0,0,,Сонда біз ғана айлалы болған жоқпыз ба?
Dialogue: 0,0:17:02.05,0:17:05.09,Default,,0,0,0,,Осы балалар мен Эмберді асыға күту ғана қалды.
Dialogue: 0,0:17:06.07,0:17:08.05,Default,,0,0,0,,Мен мұндай әңгімені естігім келмейді!
Dialogue: 0,0:17:08.07,0:17:11.03,Default,,0,0,0,,Иә, мен сенімен бүгін бірінші рет сөйлестім.
Dialogue: 0,0:17:11.06,0:17:13.08,Default,,0,0,0,,Жойылған сақина, былайша айтқанда, алдамшы.
Dialogue: 0,0:17:14.03,0:17:17.00,Default,,0,0,0,,Запастың бар екені өте құпия болды.
Dialogue: 0,0:17:18.01,0:17:19.01,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:19.03,0:17:22.02,Default,,0,0,0,,Менде Юпитердің қосалқы сақинасы болған жоқ.
Dialogue: 0,0:17:22.03,0:17:24.07,Default,,0,0,0,,Мен Оңтүстік Америкада болғанымда, көзім ауырды.
Dialogue: 0,0:17:24.08,0:17:27.01,Default,,0,0,0,,Керемет! Сіз кереметсіз
Dialogue: 0,0:17:36.09,0:17:39.02,Default,,0,0,0,,Бұл қақпаның ішінде ме?
Dialogue: 0,0:17:39.07,0:17:40.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:41.05,0:17:42.05,Default,,0,0,0,,Рухты бақылау?
Dialogue: 0,0:17:43.03,0:17:44.02,Default,,0,0,0,,Оқу
Dialogue: 0,0:17:44.04,0:17:45.05,Default,,0,0,0,,Күте тұр, күміс
Dialogue: 0,0:17:46.01,0:17:47.04,Default,,0,0,0,,Қажетсіз қозғалсаңыз...
Dialogue: 0,0:17:49.05,0:17:50.02,Default,,0,0,0,,Сол жақта.
Dialogue: 0,0:17:52.08,0:17:53.08,Default,,0,0,0,,Ой
Dialogue: 0,0:17:58.04,0:18:00.09,Default,,0,0,0,,Жақсы, жақсы, бәрібір!
Dialogue: 0,0:18:03.00,0:18:03.50,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:18:05.03,0:18:07.00,Default,,0,0,0,,Сенің атың кім?
Dialogue: 0,0:18:10.05,0:18:13.09,Default,,0,0,0,,Бұл қақпа ма? Қызық емес пе?
Dialogue: 0,0:18:17.02,0:18:19.07,Default,,0,0,0,,Асығыңыз, Санзу но Кава және т.б.
Dialogue: 0,0:18:20.03,0:18:24.02,Default,,0,0,0,,Бірақ, жұлдыз, алданба.
Dialogue: 0,0:18:24.06,0:18:28.02,Default,,0,0,0,,Бағыттап отырған балаңнан бөлінбе.
Dialogue: 0,0:18:28.09,0:18:31.05,Default,,0,0,0,,Кейбір үлкен кедергі шуы пайда болады
Dialogue: 0,0:18:32.00,0:18:33.02,Default,,0,0,0,,Интерференциялық шу?
Dialogue: 0,0:18:33.03,0:18:35.07,Default,,0,0,0,,Бір жерде біздікімен бірдей ме?
Dialogue: 0,0:18:35.08,0:18:39.06,Default,,0,0,0,,Жоғары өнімділігі бар бақылау спирттерін белсендіретін жүйелер бар.
Dialogue: 0,0:18:39.08,0:18:43.00,Default,,0,0,0,,Түсіндім, олар қуыршақтарды пайдаланды.
Dialogue: 0,0:18:44.06,0:18:45.00,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:18:45.08,0:18:46.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:47.00,0:18:51.05,Default,,0,0,0,,Мен Пандовтың серверіне кіріп, ескі қағаздарды жинадым.
Dialogue: 0,0:18:51.08,0:18:52.09,Default,,0,0,0,,Мен жалықтым
Dialogue: 0,0:18:53.03,0:18:55.06,Default,,0,0,0,,Бірақ мен қызықты қағаз таптым.
Dialogue: 0,0:18:56.01,0:18:59.00,Default,,0,0,0,,Жалғыз қуыршақ үшін қандай құрал қолданылса да
Dialogue: 0,0:18:59.02,0:19:03.09,Default,,0,0,0,,Бақылаушы рухты қақпаның артқы жағынан еніп кетуі үшін көп азап керек.
Dialogue: 0,0:19:04.05,0:19:07.00,Default,,0,0,0,,Бірақ көптеген қуыршақтарды байланыстыру
Dialogue: 0,0:19:07.02,0:19:11.02,Default,,0,0,0,,Метеор фрагменттері арқылы қабілеттеріңізді күшейтетін жүйе жасасаңыз
Dialogue: 0,0:19:11.06,0:19:17.03,Default,,0,0,0,,Бақылау рухының қақпаның ортасына жақын жерден ену мүмкіндігі бар екені айтылады.
Dialogue: 0,0:19:18.03,0:19:21.06,Default,,0,0,0,,Демек, рингке шабуыл да диверсия болды ма?
Dialogue: 0,0:19:22.03,0:19:25.09,Default,,0,0,0,,BK-201 қақпаға кіріп кетті.
Dialogue: 0,0:19:26.03,0:19:30.08,Default,,0,0,0,,Бірақ егер біз шудың көзін осылай іздейтін болсақ
Dialogue: 0,0:19:34.01,0:19:37.06,Default,,0,0,0,,Жемге сенбейтіндерді жақсы көремін.
Dialogue: 0,0:19:39.09,0:19:43.05,Default,,0,0,0,,Балалар, сендермен болған қызық болды.
Dialogue: 0,0:19:44.02,0:19:44.52,Default,,0,0,0,,мысық
Dialogue: 0,0:19:45.00,0:19:49.09,Default,,0,0,0,,Бір күні маған ұқсайтын мысық қонаққа келсе...
Dialogue: 0,0:19:57.08,0:20:01.03,Default,,0,0,0,,Қанша жұлдыз болса, сонша өмір жоғалады
Dialogue: 0,0:20:01.08,0:20:04.05,Default,,0,0,0,,Барлығы жоғалады
Dialogue: 0,0:20:05.00,0:20:06.08,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:20:07.00,0:20:08.06,Default,,0,0,0,,Құлаған жұлдыз
Dialogue: 0,0:20:09.04,0:20:12.09,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:20:24.03,0:20:27.03,Default,,0,0,0,,Енді олар адасып қалды.
Dialogue: 0,0:20:27.07,0:20:32.07,Default,,0,0,0,,Сіз енді қақпаның ортасына жете алмайсыз немесе шыға алмайсыз.
Dialogue: 0,0:20:33.05,0:20:34.09,Default,,0,0,0,,Біз жеңеміз.
Dialogue: 0,0:20:36.01,0:20:38.07,Default,,0,0,0,,Адамдар қателесетін жаратылыстар.
Dialogue: 0,0:20:39.06,0:20:42.03,Default,,0,0,0,,Барлығы үшін әділеттілік жоқ.
Dialogue: 0,0:20:43.01,0:20:45.05,Default,,0,0,0,,Қателері аз жолды таңдау
Dialogue: 0,0:20:45.07,0:20:47.07,Default,,0,0,0,,Кейде құрбандық қажет
Dialogue: 0,0:20:48.01,0:20:51.03,Default,,0,0,0,,Олай болса, қолымды кірлетуге батылым бар.
Dialogue: 0,0:20:53.04,0:20:55.07,Default,,0,0,0,,Кирихара Ересек бол
Dialogue: 0,0:20:57.04,0:21:00.08,Default,,0,0,0,,Түнгі аспан бос
Dialogue: 0,0:21:01.09,0:21:05.02,Default,,0,0,0,,Бір үлкен үлкен тесік
Dialogue: 0,0:21:05.08,0:21:09.04,Default,,0,0,0,,Жарық жарқырайды, одан тысқары
Dialogue: 0,0:21:10.06,0:21:17.04,Default,,0,0,0,,Хехехехе...
Dialogue: 0,0:21:17.06,0:21:23.04,Default,,0,0,0,,Екеуі де, екеуі де, екеуі де, екеуі де...
Dialogue: 0,0:21:31.00,0:21:31.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:33.07,0:21:34.03,Default,,0,0,0,,Күміс?
Dialogue: 0,0:21:35.08,0:21:36.02,Default,,0,0,0,,Күміс?
Dialogue: 0,0:21:39.04,0:21:40.00,Default,,0,0,0,,Сол жақта.
Dialogue: 0,0:23:41.09,0:23:43.06,Default,,0,0,0,,Онда ештеңе болған жоқ.
Dialogue: 0,0:23:44.07,0:23:45.06,Default,,0,0,0,,Тозақ қақпасы
Dialogue: 0,0:23:46.01,0:23:48.00,Default,,0,0,0,,Бұл тозақ қақпасының алдында
Dialogue: 0,0:23:48.07,0:23:51.01,Default,,0,0,0,,Жарық көкжиектен естіп тұрмын.
Dialogue: 0,0:23:51.04,0:23:53.06,Default,,0,0,0,,Аспан асты елінен өлгендерді шақыру
Dialogue: 0,0:23:54.06,0:23:56.04,Default,,0,0,0,,Кеудемде нұр жанды
Dialogue: 0,0:23:56.08,0:23:58.09,Default,,0,0,0,,Тозақтың нұры қарадан қарарақ
Dialogue: 0,0:24:00.00,0:24:01.08,Default,,0,0,0,,Мердігерлер ешқашан армандамайды
Dialogue: 0,0:24:02.03,0:24:05.03,Default,,0,0,0,,Рационалды түрде бағалаңыз
Dialogue: 0,0:24:08.03,0:24:09.02,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:24:10.52,0:24:15.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
