Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.01,0:00:12.07,Default,,0,0,0,,Маған Фусаки қатты ұнайды...ол осылай майлы.
Dialogue: 0,0:00:13.00,0:00:15.00,Default,,0,0,0,,Себебі менің қарным ашты.
Dialogue: 0,0:00:15.00,0:00:16.06,Default,,0,0,0,,Соған қарамастан мен салмақ қоспаймын.
Dialogue: 0,0:00:17.06,0:00:20.01,Default,,0,0,0,,Күн сайын денеңізді қозғалтасыз.
Dialogue: 0,0:00:21.05,0:00:23.02,Default,,0,0,0,,Канами, сен не жазып тұрсың?
Dialogue: 0,0:00:25.08,0:00:27.07,Default,,0,0,0,,Ах, мансапты зерттеу
Dialogue: 0,0:00:28.01,0:00:30.06,Default,,0,0,0,,Ол келе жатыр. Бір жыл ғана болды.
Dialogue: 0,0:00:30.08,0:00:32.08,Default,,0,0,0,,Мен мансап жолым туралы ойламаймын.
Dialogue: 0,0:00:32.09,0:00:34.00,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:00:34.02,0:00:36.07,Default,,0,0,0,,Болашақты айтсаң да, білмеймін.
Dialogue: 0,0:00:36.09,0:00:38.00,Default,,0,0,0,,Әзірге жоғары оқу орындарына өту
Dialogue: 0,0:00:39.06,0:00:43.07,Default,,0,0,0,,Бұл жақсы, колледжге қайда баруды және жұмыс табуды шешкендер үшін.
Dialogue: 0,0:00:43.09,0:00:44.06,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:00:45.00,0:00:49.00,Default,,0,0,0,,Мен бұл жігіттің Токио университетінен полицияға келгенін білемін.
Dialogue: 0,0:00:49.02,0:00:50.04,Default,,0,0,0,,Полиция
Dialogue: 0,0:00:50.05,0:00:51.02,Default,,0,0,0,,Канами
Dialogue: 0,0:00:51.03,0:00:53.00,Default,,0,0,0,,Бұл шынында да әкелік тартыс.
Dialogue: 0,0:00:53.02,0:00:54.07,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:00:55.00,0:00:56.00,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:00:58.01,0:01:01.04,Default,,0,0,0,,Міне, бәрі әкемнен басталды.
Dialogue: 0,0:01:01.07,0:01:03.06,Default,,0,0,0,,Басқа себептер бар ма?
Dialogue: 0,0:01:03.07,0:01:04.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:05.07,0:01:08.07,Default,,0,0,0,,Бұл әлемде басқаларды ренжітуден еш қиындық көрмейтін адамдар бар.
Dialogue: 0,0:01:08.08,0:01:12.03,Default,,0,0,0,,Өз қалауын қанағаттандыруға тырысатындар көп.
Dialogue: 0,0:01:12.04,0:01:14.08,Default,,0,0,0,,Сахна артында жылап жатқандар көп.
Dialogue: 0,0:01:15.01,0:01:16.07,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:01:16.09,0:01:18.01,Default,,0,0,0,,Міне
Dialogue: 0,0:01:19.00,0:01:22.04,Default,,0,0,0,,Сіз әлсіз адамдармен одақтас болғыңыз келе ме?
Dialogue: 0,0:01:22.06,0:01:25.03,Default,,0,0,0,,Хусаки сондай құрметті студент.
Dialogue: 0,0:01:25.04,0:01:28.01,Default,,0,0,0,,Эй, бұл не? Мен саған мұны үйреттім.
Dialogue: 0,0:01:28.04,0:01:29.07,Default,,0,0,0,,Бұл менікі.
Dialogue: 0,0:01:29.09,0:01:31.02,Default,,0,0,0,,Маған бірдеңені қайтар.
Dialogue: 0,0:01:31.03,0:01:32.06,Default,,0,0,0,,Мен оны жеп қойдым.
Dialogue: 0,0:01:33.00,0:01:34.01,Default,,0,0,0,,Егер сіз көп жесеңіз
Dialogue: 0,0:01:34.03,0:01:35.01,Default,,0,0,0,,Дәмді, тағы біреуін беріңізші.
Dialogue: 0,0:01:35.03,0:01:35.53,Default,,0,0,0,,Дану
Dialogue: 0,0:01:36.01,0:01:37.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:09.03,0:03:12.02,Default,,0,0,0,,Бүгін қандай жақсы күн
Dialogue: 0,0:03:13.02,0:03:16.00,Default,,0,0,0,,Эй, Хусаки, сенің де солай ойлайтыныңа сенімдімін.
Dialogue: 0,0:03:16.05,0:03:17.08,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:03:18.00,0:03:21.05,Default,,0,0,0,,Өтінемін, артыма тығылып, менімен бірге тойламаңыз.
Dialogue: 0,0:03:27.01,0:03:29.07,Default,,0,0,0,,Сен, мұнда неге келдің?
Dialogue: 0,0:03:30.00,0:03:34.03,Default,,0,0,0,,Сосын үй иесі маған сусын әкелуімді өтінді.
Dialogue: 0,0:03:35.01,0:03:36.05,Default,,0,0,0,,Бірақ мен келгенде
Dialogue: 0,0:03:39.07,0:03:41.08,Default,,0,0,0,,Осы қарқынмен біз де өлтіреміз.
Dialogue: 0,0:03:42.00,0:03:43.02,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:03:43.09,0:03:45.09,Default,,0,0,0,,Не айтсаң да...
Dialogue: 0,0:03:48.04,0:03:50.01,Default,,0,0,0,,Осы араны пайдалансам да
Dialogue: 0,0:03:50.03,0:03:53.08,Default,,0,0,0,,Дүниеден ешқашан жоғалып кетпейтін нәрселер болды.
Dialogue: 0,0:03:54.02,0:03:57.05,Default,,0,0,0,,Бірақ мұның бәрі бүгін аяқталады.
Dialogue: 0,0:03:58.07,0:04:01.06,Default,,0,0,0,,Мені байланыстыратын барлық нәрсе ...
Dialogue: 0,0:04:02.00,0:04:05.07,Default,,0,0,0,,Әкесі мен Цинлонгтан да
Dialogue: 0,0:04:06.01,0:04:08.09,Default,,0,0,0,,Барлығы... хехехе...
Dialogue: 0,0:04:38.06,0:04:40.04,Default,,0,0,0,,Сіз...
Dialogue: 0,0:04:50.09,0:04:53.08,Default,,0,0,0,,Вэй маған көмектесті
Dialogue: 0,0:04:54.01,0:04:57.02,Default,,0,0,0,,Ол адам мені түсіне ме?
Dialogue: 0,0:04:58.06,0:05:02.03,Default,,0,0,0,,Сонымен қатар, бүгін өте жақсы күн.
Dialogue: 0,0:05:02.07,0:05:05.06,Default,,0,0,0,,Осындай күнде тағы кездесетініме сене алар емеспін
Dialogue: 0,0:05:06.04,0:05:09.02,Default,,0,0,0,,Оны тек тағдыр деп сипаттауға болады.
Dialogue: 0,0:05:11.07,0:05:13.04,Default,,0,0,0,,Мен сізге белгі бергенде жүгіріңіз.
Dialogue: 0,0:05:15.00,0:05:16.07,Default,,0,0,0,,Сондықтан Фусаки
Dialogue: 0,0:05:17.00,0:05:18.07,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:05:18.09,0:05:21.00,Default,,0,0,0,,Ал мені босат
Dialogue: 0,0:05:22.00,0:05:24.00,Default,,0,0,0,,Хусакиттебаа
Dialogue: 0,0:05:25.00,0:05:25.50,Default,,0,0,0,,Әлі де
Dialogue: 0,0:05:34.02,0:05:35.06,Default,,0,0,0,,Мен сенің қашуыңа жол бермеймін
Dialogue: 0,0:05:35.08,0:05:37.02,Default,,0,0,0,,Фусаки
Dialogue: 0,0:05:42.08,0:05:45.05,Default,,0,0,0,,Сіз кімсіз...?
Dialogue: 0,0:05:46.04,0:05:47.03,Default,,0,0,0,,Полиция
Dialogue: 0,0:05:47.09,0:05:50.03,Default,,0,0,0,,Сіз жас ханымның досы емессіз бе?
Dialogue: 0,0:05:54.00,0:05:55.04,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:05:55.07,0:05:59.03,Default,,0,0,0,,Біріншіден, мен бұл ғимараттан шыққым келеді...
Dialogue: 0,0:06:13.07,0:06:14.09,Default,,0,0,0,,Мұны қайталаудың қажеті жоқ.
Dialogue: 0,0:06:15.03,0:06:17.07,Default,,0,0,0,,Біз қазір себебін растап жатырмыз.
Dialogue: 0,0:06:17.08,0:06:19.05,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,0:06:20.04,0:06:23.04,Default,,0,0,0,,Сіз мені осы жерден түсірмеуді жоспарлап отырсыз ба?
Dialogue: 0,0:06:23.07,0:06:25.07,Default,,0,0,0,,Апаттық баспалдақтар бар.
Dialogue: 0,0:06:25.09,0:06:28.01,Default,,0,0,0,,Бұл заттар ұзақ уақыт бойы бөгелді.
Dialogue: 0,0:06:28.04,0:06:31.00,Default,,0,0,0,,Ешкімге ешқашан жол бермеңіз
Dialogue: 0,0:06:31.03,0:06:32.05,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:06:41.03,0:06:41.53,Default,,0,0,0,,Иә
Dialogue: 0,0:06:43.01,0:06:45.03,Default,,0,0,0,,Әр бұрылыста сезімдеріңе ерік беріп жүру ме?
Dialogue: 0,0:06:51.06,0:06:53.05,Default,,0,0,0,,Атқарушы жиналыс аяқталды.
Dialogue: 0,0:06:53.08,0:06:56.02,Default,,0,0,0,,Өзіңізді тазалаңыз
Dialogue: 0,0:06:56.05,0:06:57.02,Default,,0,0,0,,болып табылады
Dialogue: 0,0:07:06.03,0:07:10.05,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:07:10.07,0:07:12.02,Default,,0,0,0,,Мен қазір осыны ойлап отырмын
Dialogue: 0,0:07:12.05,0:07:13.09,Default,,0,0,0,,Иә
Dialogue: 0,0:07:15.02,0:07:17.02,Default,,0,0,0,,Сізде ұялы телефон жоқ
Dialogue: 0,0:07:17.05,0:07:20.07,Default,,0,0,0,,Жоқ, ереже бойынша жұмыс кезінде алып жүруге болмайды.
Dialogue: 0,0:07:21.08,0:07:22.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:25.04,0:07:26.03,Default,,0,0,0,,Электр қуатын өшіру
Dialogue: 0,0:07:26.06,0:07:31.03,Default,,0,0,0,,Аа, бірақ жақсы, бұл қонақүйдің өз электр генераторы бар.
Dialogue: 0,0:07:33.01,0:07:34.02,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:07:34.06,0:07:39.03,Default,,0,0,0,,Сіз оны электр желілерінен ажыратып, бақылаушы рухтарды кіргізбеуді жоспарлап отырсыз ба?
Dialogue: 0,0:07:39.04,0:07:40.01,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:07:43.01,0:07:44.07,Default,,0,0,0,,Неліктен бұл болып жатыр...
Dialogue: 0,0:07:45.01,0:07:45.51,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:07:47.04,0:07:50.00,Default,,0,0,0,,Неліктен Алиса мені өлтірмекші болды?
Dialogue: 0,0:07:51.01,0:07:52.07,Default,,0,0,0,,(Иида) Мен ағамның атын иемдендім. Мен мұны істеуім керек…
Dialogue: 0,0:07:53.00,0:07:54.06,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:55.04,0:07:57.04,Default,,0,0,0,,Сонда сізді сатқындық жасады ма?
Dialogue: 0,0:07:57.08,0:07:59.01,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:07:59.04,0:08:01.05,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:08:02.07,0:08:04.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:06.05,0:08:09.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:09.05,0:08:15.03,Default,,0,0,0,,Дегенмен, достың сатқындығы әлі де азап.
Dialogue: 0,0:08:20.03,0:08:23.00,Default,,0,0,0,,Неге бұлай сөйлеп тұрсың?
Dialogue: 0,0:08:23.03,0:08:24.06,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:08:26.07,0:08:27.08,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:33.04,0:08:35.04,Default,,0,0,0,,Сіз өзгердіңіз...
Dialogue: 0,0:08:35.06,0:08:37.03,Default,,0,0,0,,Бұл туралы жиі айтылады.
Dialogue: 0,0:08:37.05,0:08:38.04,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:38.08,0:08:41.09,Default,,0,0,0,,Көбінесе жүзіңді көре алмаймын.
Dialogue: 0,0:08:42.01,0:08:44.02,Default,,0,0,0,,Мен мұндай жерге тығылып қалмасам екен.
Dialogue: 0,0:08:44.05,0:08:45.07,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:08:46.00,0:08:47.07,Default,,0,0,0,,Сіз байқамадыңыз ба?
Dialogue: 0,0:08:48.02,0:08:51.01,Default,,0,0,0,,Күте тұрыңыз, содан кейін...
Dialogue: 0,0:08:51.04,0:08:54.03,Default,,0,0,0,,Залға бар, Сайтоны сыртқа шығарма.
Dialogue: 0,0:08:54.05,0:08:55.01,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:08:55.05,0:08:58.08,Default,,0,0,0,,Бұл орындалғаннан кейін сіз қашып кете аласыз немесе қалағаныңызды жасай аласыз.
Dialogue: 0,0:08:59.01,0:08:59.51,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:09:01.01,0:09:02.01,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:09:06.00,0:09:08.00,Default,,0,0,0,,Менің атым Ли Шэншунь.
Dialogue: 0,0:09:08.03,0:09:10.06,Default,,0,0,0,,Өзін-өзі таныстыру Сіз мұны әлі жасаған жоқсыз, солай ма?
Dialogue: 0,0:09:13.00,0:09:14.06,Default,,0,0,0,,Менің атым Юсаки Кирихара.
Dialogue: 0,0:09:14.09,0:09:17.08,Default,,0,0,0,,Бұл ваннада өзімді алғаш рет таныстыруым.
Dialogue: 0,0:09:18.01,0:09:19.01,Default,,0,0,0,,Мен де
Dialogue: 0,0:09:22.05,0:09:24.04,Default,,0,0,0,,Фусаки қонақ үйде
Dialogue: 0,0:09:24.06,0:09:26.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:26.04,0:09:29.06,Default,,0,0,0,,Бұл бақылаушы рухтарды өшіру үшін электр қуаты өшірілген ғимарат.
Dialogue: 0,0:09:29.08,0:09:32.03,Default,,0,0,0,,Қабілеттердің белсендіруі де байқалды.
Dialogue: 0,0:09:32.05,0:09:35.02,Default,,0,0,0,,VI-952 болуы керек, солай ма?
Dialogue: 0,0:09:35.04,0:09:37.03,Default,,0,0,0,,Неліктен мұндай жерде жүрсің?
Dialogue: 0,0:09:37.05,0:09:38.07,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:09:39.00,0:09:42.01,Default,,0,0,0,,Менің ұялы телефоным да жұмыс істемейді, сондықтан бірдеңе болып жатқанына сенімдімін.
Dialogue: 0,0:09:42.04,0:09:45.07,Default,,0,0,0,,Алайда оқиға орнында ешқандай шығын тіркелген жоқ.
Dialogue: 0,0:09:46.00,0:09:47.09,Default,,0,0,0,,Мен енді кіре алмаймын...
Dialogue: 0,0:09:48.00,0:09:49.08,Default,,0,0,0,,Ондай жағдайда тез арада жағдайды шешіңіз.
Dialogue: 0,0:09:57.02,0:09:59.06,Default,,0,0,0,,Ой, не істеп жатырсың, бастық?
Dialogue: 0,0:09:59.09,0:10:02.02,Default,,0,0,0,,Жарайды, тез жабыңыз.
Dialogue: 0,0:10:02.04,0:10:04.01,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:10:09.03,0:10:10.06,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:10.09,0:10:12.08,Default,,0,0,0,,Фусакиге барыңыз
Dialogue: 0,0:10:13.01,0:10:15.06,Default,,0,0,0,,Әйтпесе, мен бос бола алмаймын.
Dialogue: 0,0:10:16.00,0:10:19.00,Default,,0,0,0,,Иә, жай ғана әйел.
Dialogue: 0,0:10:19.02,0:10:21.08,Default,,0,0,0,,Мен бірден келіп беремін.
Dialogue: 0,0:10:22.01,0:10:24.03,Default,,0,0,0,,Жоқ, бұл басқаша.
Dialogue: 0,0:10:24.06,0:10:28.03,Default,,0,0,0,,Хусаки жалғыз емес еді; оның қасында бір ер адам да болды.
Dialogue: 0,0:10:29.01,0:10:30.06,Default,,0,0,0,,өзі құдаймын деп айтқан адаммен кездескеннен бері.
Dialogue: 0,0:10:43.09,0:10:45.02,Default,,0,0,0,,Сайто
Dialogue: 0,0:10:45.06,0:10:47.07,Default,,0,0,0,,Жақсырақ жол бар ма?
Dialogue: 0,0:10:47.08,0:10:50.02,Default,,0,0,0,,Менің ойымша, сіз тығылып, сыртқа шыққыңыз келеді.
Dialogue: 0,0:10:50.05,0:10:52.05,Default,,0,0,0,,Тек жертөледегі кір жууға барыңыз.
Dialogue: 0,0:10:52.08,0:10:54.09,Default,,0,0,0,,Ең дұрысы сол жерден қашып кеткен.
Dialogue: 0,0:10:57.00,0:10:59.09,Default,,0,0,0,,Айтпақшы, нақты не болды?
Dialogue: 0,0:11:00.01,0:11:02.02,Default,,0,0,0,,Барлығы шынымен де қышиды.
Dialogue: 0,0:11:02.04,0:11:03.09,Default,,0,0,0,,Өйткені аралға бармауға және шағын қайықта күтіп тұруға бұйрық берілді
Dialogue: 0,0:11:04.06,0:11:08.01,Default,,0,0,0,,Бұл нені білдіреді, Ли?
Dialogue: 0,0:11:09.06,0:11:10.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:10.05,0:11:12.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:13.01,0:11:14.05,Default,,0,0,0,,Басқа нәрсе
Dialogue: 0,0:11:48.08,0:11:50.07,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,0:11:52.04,0:11:55.07,Default,,0,0,0,,Сіз полицей әйелді жем ретінде пайдалануды жоспарлап отырсыз ба?
Dialogue: 0,0:11:56.00,0:11:57.04,Default,,0,0,0,,таяз
Dialogue: 0,0:11:57.08,0:12:00.02,Default,,0,0,0,,Мен оның қай ұйымнан екенін білмеймін.
Dialogue: 0,0:12:00.04,0:12:02.07,Default,,0,0,0,,Екінші тарап нашар болды.
Dialogue: 0,0:12:03.08,0:12:05.09,Default,,0,0,0,,Мен оны қайтаруды сұраймын.
Dialogue: 0,0:12:09.06,0:12:11.01,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:12:11.04,0:12:17.02,Default,,0,0,0,,Менің өз қанымды төгу - мердігер ретінде төлейтін бағам.
Dialogue: 0,0:12:17.05,0:12:19.04,Default,,0,0,0,,бастайық.
Dialogue: 0,0:12:30.01,0:12:31.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:33.06,0:12:35.08,Default,,0,0,0,,Нақты іс басталғалы тұр.
Dialogue: 0,0:13:24.05,0:13:26.03,Default,,0,0,0,,Мен естідім
Dialogue: 0,0:13:26.07,0:13:31.00,Default,,0,0,0,,Электр энергиясының ағынын еркін басқара алатын дарынды мердігер бар.
Dialogue: 0,0:13:32.08,0:13:36.03,Default,,0,0,0,,Түсіндім, сіз БК-201 екенсіз
Dialogue: 0,0:13:36.07,0:13:41.03,Default,,0,0,0,,Сіз мені әдейі бұрышқа итеріп, күзетімді түсірдіңіз бе?
Dialogue: 0,0:13:41.05,0:13:43.08,Default,,0,0,0,,Дегенмен, бұл нашар жоспарланған сияқты.
Dialogue: 0,0:13:44.02,0:13:47.06,Default,,0,0,0,,Мен сенен жылдамырақ сияқтымын.
Dialogue: 0,0:14:06.09,0:14:08.05,Default,,0,0,0,,Сайто осылай.
Dialogue: 0,0:14:10.01,0:14:11.09,Default,,0,0,0,,Ах, бірақ...
Dialogue: 0,0:14:12.03,0:14:13.02,Default,,0,0,0,,Дүрбелеңге салынбаңыз
Dialogue: 0,0:14:13.05,0:14:15.02,Default,,0,0,0,,Күдік туғызбау үшін әрекет ету.
Dialogue: 0,0:14:15.04,0:14:16.02,Default,,0,0,0,,Иә
Dialogue: 0,0:14:23.00,0:14:24.05,Default,,0,0,0,,Осы бөлмеден рахат алыңыз
Dialogue: 0,0:14:24.07,0:14:25.07,Default,,0,0,0,,Иә
Dialogue: 0,0:14:29.08,0:14:33.05,Default,,0,0,0,,Онда үстел жоқ, солай ма?
Dialogue: 0,0:14:48.02,0:14:51.09,Default,,0,0,0,,Бұл дәмді болды. Бұл сәл артық болды.
Dialogue: 0,0:14:52.02,0:14:54.07,Default,,0,0,0,,Алиса, сен нені айтып тұрсың?
Dialogue: 0,0:14:55.00,0:14:56.02,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:14:56.06,0:15:01.00,Default,,0,0,0,,Бүгін мені ұстап тұрғанның бәрі жойылатын күн.
Dialogue: 0,0:15:02.09,0:15:07.00,Default,,0,0,0,,Цинлунтанның бәрінен де жоғары бағалағаны қандас байланыс болды.
Dialogue: 0,0:15:07.03,0:15:12.00,Default,,0,0,0,,Сондықтан Ван Сяотанның қанын ең көп мұра еткен мен,
Dialogue: 0,0:15:12.01,0:15:14.05,Default,,0,0,0,,Қаласаңыз да, қаламасаңыз да
Dialogue: 0,0:15:14.06,0:15:19.04,Default,,0,0,0,,Мен үшін дайындалған жалғыз нәрсе - Чинглонгтанг деп аталатын ұйымның жүгін арқалаған өмір болды.
Dialogue: 0,0:15:21.04,0:15:25.00,Default,,0,0,0,,Тіпті, «қақпа» пайда болып, дүние осындай абыржу болса да
Dialogue: 0,0:15:25.02,0:15:27.04,Default,,0,0,0,,Ол ешқашан өзгерген жоқ.
Dialogue: 0,0:15:29.04,0:15:31.04,Default,,0,0,0,,Бірақ Ван Сяотан қайтыс болды.
Dialogue: 0,0:15:31.07,0:15:34.08,Default,,0,0,0,,Цинлунтан да із-түзсіз жоғалып кетті.
Dialogue: 0,0:15:35.02,0:15:37.07,Default,,0,0,0,,Вэй Цишунға рахмет.
Dialogue: 0,0:15:38.04,0:15:40.01,Default,,0,0,0,,Бастық: Ол...
Dialogue: 0,0:15:40.05,0:15:42.01,Default,,0,0,0,,VI-952
Dialogue: 0,0:15:47.02,0:15:48.05,Default,,0,0,0,,Сайто
Dialogue: 0,0:15:48.07,0:15:50.00,Default,,0,0,0,,Өтінемін, Вэй
Dialogue: 0,0:15:50.05,0:15:52.08,Default,,0,0,0,,Мені босат
Dialogue: 0,0:15:56.01,0:15:58.03,Default,,0,0,0,,Енді сіз боссыз
Dialogue: 0,0:16:13.04,0:16:14.03,Default,,0,0,0,,Алиса
Dialogue: 0,0:16:15.06,0:16:18.06,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:16:19.01,0:16:22.04,Default,,0,0,0,,Сіз бос болғыңыз келмеді
Dialogue: 0,0:16:22.07,0:16:24.08,Default,,0,0,0,,Байланысты болуға ұмтылу
Dialogue: 0,0:16:25.01,0:16:29.00,Default,,0,0,0,,Мен біреуге тәуелді болғым келді, Алиса.
Dialogue: 0,0:16:29.02,0:16:30.09,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:16:31.01,0:16:36.01,Default,,0,0,0,,Кейде Юсаки Кирихара болды, ал кейде мен болдым.
Dialogue: 0,0:16:36.09,0:16:40.04,Default,,0,0,0,,Әкеңнен құтылғың келмеді;
Dialogue: 0,0:16:40.04,0:16:42.09,Default,,0,0,0,,Менің байланғанымды қалаған шығарсыз.
Dialogue: 0,0:16:50.03,0:16:51.02,Default,,0,0,0,,Алиса
Dialogue: 0,0:16:52.02,0:16:54.04,Default,,0,0,0,,Алиса Алиса
Dialogue: 0,0:16:57.06,0:16:59.07,Default,,0,0,0,,Сен де күнәһарсың
Dialogue: 0,0:17:00.03,0:17:02.05,Default,,0,0,0,,Алисаның әкесіне тәуелділігінен
Dialogue: 0,0:17:02.07,0:17:05.02,Default,,0,0,0,,Адамды босатқан адам
Dialogue: 0,0:17:05.04,0:17:07.04,Default,,0,0,0,,Сіз әлі байқамадыңыз ба?
Dialogue: 0,0:17:07.06,0:17:08.09,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:17:09.00,0:17:13.03,Default,,0,0,0,,Әке билігінен толықтай бас тарту?
Dialogue: 0,0:17:13.03,0:17:17.02,Default,,0,0,0,,Бұл ол үшін бірінші тәжірибе болды.
Dialogue: 0,0:17:17.08,0:17:19.07,Default,,0,0,0,,Әке маңызды емес.
Dialogue: 0,0:17:22.00,0:17:26.09,Default,,0,0,0,,Ол сенен жаңа тәуелділік тапты.
Dialogue: 0,0:17:27.01,0:17:29.09,Default,,0,0,0,,Бірақ сіз полиция қызметкері болдыңыз
Dialogue: 0,0:17:30.02,0:17:32.04,Default,,0,0,0,,Ван Сяотанның қызы кім?
Dialogue: 0,0:17:32.06,0:17:37.04,Default,,0,0,0,,Ешқашан бітіспес дүниенің адамына айналдым.
Dialogue: 0,0:17:37.07,0:17:38.09,Default,,0,0,0,,біздің орнымыз ба?
Dialogue: 0,0:17:42.05,0:17:43.02,Default,,0,0,0,,Менеджер
Dialogue: 0,0:17:47.06,0:17:48.05,Default,,0,0,0,,Сайто
Dialogue: 0,0:17:50.01,0:17:51.08,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:18:15.09,0:18:18.08,Default,,0,0,0,,БҚ...201
Dialogue: 0,0:18:22.03,0:18:25.02,Default,,0,0,0,,Неге...
Dialogue: 0,0:18:30.00,0:18:32.03,Default,,0,0,0,,Бұл сіздің қаныңыз болды ма?
Dialogue: 0,0:18:33.01,0:18:34.09,Default,,0,0,0,,Сол сәтте
Dialogue: 0,0:18:36.00,0:18:38.08,Default,,0,0,0,,Бұл... нәрсе...
Dialogue: 0,0:18:42.08,0:18:45.02,Default,,0,0,0,,Менің жылдамдығым жақсырақ болды.
Dialogue: 0,0:18:47.03,0:18:48.01,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:19:15.08,0:19:17.03,Default,,0,0,0,,Вэй Цишун
Dialogue: 0,0:19:17.04,0:19:21.04,Default,,0,0,0,,Ол Цинлунтанды бақылауды жоюды көздеді.
Dialogue: 0,0:19:21.08,0:19:26.01,Default,,0,0,0,,Ванды және барлық басшыларды, сосын оның қызын өлтіру керек пе?
Dialogue: 0,0:19:26.03,0:19:28.01,Default,,0,0,0,,Мен өте жақсы жұмыс істеп жатырмын.
Dialogue: 0,0:19:28.02,0:19:32.01,Default,,0,0,0,,Сонда олар сізді кінәлі ретінде пайдаланбақ болды ма?
Dialogue: 0,0:19:34.02,0:19:39.01,Default,,0,0,0,,Айтпақшы, Вейдің денесі мәйітханадан жоғалып кеткен сияқты.
Dialogue: 0,0:19:39.01,0:19:43.04,Default,,0,0,0,,Мен солай ойлаймын. Бұл түнде жұлдыздар болған жоқ.
Dialogue: 0,0:19:45.09,0:19:48.03,Default,,0,0,0,,Миссия орындалды.
Dialogue: 0,0:19:54.04,0:19:58.07,Default,,0,0,0,,Егер мен ешқашан полицияға келмеген болсам
Dialogue: 0,0:19:59.01,0:20:01.06,Default,,0,0,0,,Мен Алисаны құтқара алар едім деп ойлаймын.
Dialogue: 0,0:20:02.00,0:20:03.06,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:20:04.01,0:20:07.07,Default,,0,0,0,,Адамның жүрегін, мінез-құлқын ешкім түсіне алмайды.
Dialogue: 0,0:20:08.08,0:20:14.04,Default,,0,0,0,,Бірақ мен сізді полиция емес деп елестете аламын.
Dialogue: 0,0:20:20.02,0:20:23.00,Default,,0,0,0,,Канами, сен қашаннан бері темекі тарта бастадың...
Dialogue: 0,0:20:23.03,0:20:24.05,Default,,0,0,0,,Мен де
Dialogue: 0,0:20:24.08,0:20:29.08,Default,,0,0,0,,Түрі осылай болса да, бір нәрсеге тәуелді болмай өмір сүре алмайтын әлсіз әйел.
Dialogue: 0,0:20:34.09,0:20:37.05,Default,,0,0,0,,Саған сенетін адамдар көп.
Dialogue: 0,0:20:37.08,0:20:42.02,Default,,0,0,0,,Бірақ бәрін сорып алуға тырысатын жаман әдетің.
Dialogue: 0,0:20:44.02,0:20:48.03,Default,,0,0,0,,Көмек сұраған кезде бірден келмесең, қиналып қаламын.
Dialogue: 0,0:20:51.01,0:20:52.06,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:20:54.09,0:20:59.00,Default,,0,0,0,,Бірақ менің қасымда темекі шекпеңізші.
Dialogue: 0,0:20:59.03,0:21:01.00,Default,,0,0,0,,Киімнің иісі.
Dialogue: 0,0:21:03.02,0:21:04.07,Default,,0,0,0,,Жоғарылаудан бас тарту
Dialogue: 0,0:21:04.09,0:21:05.06,Default,,0,0,0,,Иә
Dialogue: 0,0:21:06.06,0:21:08.07,Default,,0,0,0,,Маған себебін айта аласыз ба?
Dialogue: 0,0:21:09.00,0:21:10.02,Default,,0,0,0,,Жақында болған оқиғада
Dialogue: 0,0:21:10.04,0:21:13.01,Default,,0,0,0,,Мен өзімнің күш-қуатымның жоқтығын қатты түсіндім.
Dialogue: 0,0:21:13.04,0:21:15.04,Default,,0,0,0,,Біз әлі жоғары көтеріле алмаймыз.
Dialogue: 0,0:21:16.05,0:21:22.02,Default,,0,0,0,,Мен құтқара алатын бір ғана адам бар, мен оны құтқара алмадым.
Dialogue: 0,0:21:22.07,0:21:28.04,Default,,0,0,0,,Бұл ұсыныстан бас тартудың не екенін білесіз бе?
Dialogue: 0,0:21:28.08,0:21:30.02,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:21:33.06,0:21:34.05,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:34.07,0:21:36.09,Default,,0,0,0,,Жетекші Кирихара, тұрыңыз.
Dialogue: 0,0:21:37.02,0:21:38.04,Default,,0,0,0,,болып табылады
Dialogue: 0,0:21:43.00,0:21:45.03,Default,,0,0,0,,Бастық, бірдеңе болды.
Dialogue: 0,0:21:45.05,0:21:46.06,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:21:46.09,0:21:48.09,Default,,0,0,0,,Жоқ, әйтеуір
Dialogue: 0,0:21:49.00,0:21:50.05,Default,,0,0,0,,Ештеңе айтпа
Dialogue: 0,0:21:50.07,0:21:52.03,Default,,0,0,0,,кешіріңіз
Dialogue: 0,0:21:54.07,0:21:57.06,Default,,0,0,0,,Сайто Мен сізге арқа сүйеймін.
Dialogue: 0,0:21:57.07,0:21:59.03,Default,,0,0,0,,Не, бірдеңе дедіңіз бе?
Dialogue: 0,0:21:59.05,0:22:01.04,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:23:41.02,0:23:43.00,Default,,0,0,0,,«Тозақ қақпасы» ретінде белгілі
Dialogue: 0,0:23:43.02,0:23:44.07,Default,,0,0,0,,Біртүрлі өріс
Dialogue: 0,0:23:44.09,0:23:46.05,Default,,0,0,0,,Үзіліссіз кеңістік-уақыт
Dialogue: 0,0:23:46.07,0:23:48.01,Default,,0,0,0,,Кездейсоқ және
Dialogue: 0,0:23:48.02,0:23:50.09,Default,,0,0,0,,Бұралуға мәжбүр болатын физикалық заңдар
Dialogue: 0,0:23:51.02,0:23:53.01,Default,,0,0,0,,Жиналса да, оны жинауға болмайды.
Dialogue: 0,0:23:53.03,0:23:55.03,Default,,0,0,0,,Сұр ғылыми сандық
Dialogue: 0,0:23:56.00,0:23:56.50,Default,,0,0,0,,Адамдар
Dialogue: 0,0:23:57.00,0:23:59.07,Default,,0,0,0,,Алғанымның орнына жоғалтқаным
Dialogue: 0,0:23:59.09,0:24:01.05,Default,,0,0,0,,Көптеген өмірлер мен
Dialogue: 0,0:24:01.06,0:24:03.02,Default,,0,0,0,,Материктің бөлігі және
