Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.48,0:00:08.27,Default,,0,0,0,,Жалғыз ба?
Dialogue: 0,0:00:08.94,0:00:10.32,Default,,0,0,0,,Мен уәдемді орындаймын
Dialogue: 0,0:00:11.19,0:00:12.40,Default,,0,0,0,,Өйткені мен сауда компаниясының адамымын.
Dialogue: 0,0:00:15.36,0:00:17.57,Default,,0,0,0,,Әдептілік, Смит мырза.
Dialogue: 0,0:00:18.37,0:00:20.83,Default,,0,0,0,,Мен бірден сауда туралы сөйлескім келеді.
Dialogue: 0,0:00:21.45,0:00:22.08,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:00:22.50,0:00:27.37,Default,,0,0,0,,Оған дейін менің көз алдымда темекі шегуден бас тартуыңызды өтінемін.
Dialogue: 0,0:00:28.42,0:00:33.51,Default,,0,0,0,,Бүйірлік түтіннің құрамында жалпы темекі түтініне қарағанда зиянды заттар көп.
Dialogue: 0,0:00:34.38,0:00:37.34,Default,,0,0,0,,Диметилнитрозамин жоғары канцерогенді.
Dialogue: 0,0:00:37.89,0:00:42.35,Default,,0,0,0,,Ал негізгі түтін 5,3-тен 43 нанограмға дейін
Dialogue: 0,0:00:43.02,0:00:47.31,Default,,0,0,0,,680-ден 823 нанограмға дейін темекі түтінінде
Dialogue: 0,0:00:48.19,0:00:51.94,Default,,0,0,0,,Хинолиннің түтіні негізгі түтіннен 11 есе жоғары.
Dialogue: 0,0:00:52.36,0:00:55.24,Default,,0,0,0,,Құрамында шамамен 18 000 нанограмма бар
Dialogue: 0,0:00:55.61,0:00:58.16,Default,,0,0,0,,Басқаша айтқанда, шын мәнінде темекі шегетін адамнан артық
Dialogue: 0,0:00:58.49,0:01:01.62,Default,,0,0,0,,Жаныңдағы адамдарға зияны көбірек.
Dialogue: 0,0:01:03.87,0:01:05.62,Default,,0,0,0,,Содан кейін деміңізді ұстаңыз.
Dialogue: 0,0:01:07.54,0:01:09.58,Default,,0,0,0,,Бұл оқиға ешқашан болған емес
Dialogue: 0,0:01:11.75,0:01:12.50,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:01:15.67,0:01:16.59,Default,,0,0,0,,Эй
Dialogue: 0,0:01:21.60,0:01:22.56,Default,,0,0,0,,Отыру
Dialogue: 0,0:01:33.94,0:01:36.40,Default,,0,0,0,,Бұл жай ғана аванстық төлем.
Dialogue: 0,0:01:37.32,0:01:40.16,Default,,0,0,0,,Мысал элементінің түпнұсқа екенін растай алсаңыз,
Dialogue: 0,0:01:40.66,0:01:42.83,Default,,0,0,0,,Содан кейін осы соманы екі есе төлеңіз.
Dialogue: 0,0:01:44.49,0:01:46.91,Default,,0,0,0,,Сен мұнымен не істейсің?
Dialogue: 0,0:01:47.79,0:01:52.04,Default,,0,0,0,,Мен бәсекелес компанияның үш адамын өлтіруден бастаймын деп ойлаймын.
Dialogue: 0,0:01:53.96,0:01:55.00,Default,,0,0,0,,Сен менімен бірге құлайсың!
Dialogue: 0,0:01:56.05,0:01:57.13,Default,,0,0,0,,Қайта сату
Dialogue: 0,0:01:57.51,0:01:59.55,Default,,0,0,0,,Темейчи, сен не мазақтап тұрсың?
Dialogue: 0,0:02:04.39,0:02:07.48,Default,,0,0,0,,Бұл шынымен тұр ма?
Dialogue: 0,0:02:08.69,0:02:09.73,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:02:12.44,0:02:13.98,Default,,0,0,0,,Мәміле тоқтатылды
Dialogue: 0,0:02:15.40,0:02:16.19,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:02:19.78,0:02:22.16,Default,,0,0,0,,Егер бастық бас тарт десе, бас тарт.
Dialogue: 0,0:02:24.20,0:02:25.87,Default,,0,0,0,,Өте қатты ашуландырады—
Dialogue: 0,0:02:29.71,0:02:30.62,Default,,0,0,0,,Шығу.
Dialogue: 0,0:02:49.02,0:02:50.85,Default,,0,0,0,,Қару-жарақ
Dialogue: 0,0:02:51.19,0:02:51.98,Default,,0,0,0,,Босс
Dialogue: 0,0:02:55.57,0:02:56.61,Default,,0,0,0,,Ей, өзіңді бекіт.
Dialogue: 0,0:03:07.74,0:03:08.95,Default,,0,0,0,,Мен сенен күткен жоқпын
Dialogue: 0,0:03:11.00,0:03:11.66,Default,,0,0,0,,Мердігер
Dialogue: 0,0:03:15.38,0:03:18.92,Default,,0,0,0,,Келме, келме, құбыжық
Dialogue: 0,0:04:17.52,0:04:22.36,Default,,0,0,0,,Менің аяғым... аяғым қозғалмайды.
Dialogue: 0,0:04:36.54,0:04:37.38,Default,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:04:38.17,0:04:39.21,Default,,0,0,0,,Келме, құбыжық
Dialogue: 0,0:04:53.60,0:04:54.77,Default,,0,0,0,,Тұрған жері
Dialogue: 0,0:04:54.89,0:04:57.31,Default,,0,0,0,,Айт, мен саған айтамын, мені өлтірме.
Dialogue: 0,0:04:57.85,0:04:59.65,Default,,0,0,0,,Ичидори 2220
Dialogue: 0,0:04:59.73,0:05:00.69,Default,,0,0,0,,сонда болыңыз
Dialogue: 0,0:05:02.03,0:05:03.61,Default,,0,0,0,,Бұл жақсы идея.
Dialogue: 0,0:05:50.41,0:05:51.45,Default,,0,0,0,,Бірдей болып қалатын қарастыру
Dialogue: 0,0:06:05.96,0:06:07.97,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:06:24.40,0:06:25.32,Default,,0,0,0,,Бұл дүрбелең
Dialogue: 0,0:06:36.08,0:06:41.08,Default,,0,0,0,,Сіз бізбен келесі бірнеше ай бойы жұмыс істейсіз.
Dialogue: 0,0:06:42.79,0:06:45.50,Default,,0,0,0,,Оң жақтан: сәуір, шілде, мен 11 қарашамын
Dialogue: 0,0:06:49.42,0:06:50.72,Default,,0,0,0,,MI6
Dialogue: 0,0:08:36.37,0:08:37.57,Default,,0,0,0,,Әдетте Havoc ретінде белгілі
Dialogue: 0,0:08:38.28,0:08:41.54,Default,,0,0,0,,Ол тарихтағы ең нашар мердігерлердің бірі.
Dialogue: 0,0:08:43.21,0:08:46.67,Default,,0,0,0,,Үшінші Оңтүстік Америка қақтығысы, әдетте «Аспан соғысы» деп аталады
Dialogue: 0,0:08:46.88,0:08:51.42,Default,,0,0,0,,Ол өлтірген адамдардың саны жүзден жүздегенге дейін жетеді.
Dialogue: 0,0:08:52.38,0:08:56.80,Default,,0,0,0,,Келісімшарт қабілеті кез келген жерде вакуум жасау сияқты көрінеді.
Dialogue: 0,0:08:57.18,0:08:58.55,Default,,0,0,0,,Мәліметтер белгісіз
Dialogue: 0,0:09:00.18,0:09:03.02,Default,,0,0,0,,Қабілеттің іске қосылуы 5 жыл бойы расталмаған.
Dialogue: 0,0:09:03.52,0:09:08.27,Default,,0,0,0,,Сол жұлдыздың спектрлік талдауы негізінде ол қазір жоғалған адам деп танылды.
Dialogue: 0,0:09:09.11,0:09:10.90,Default,,0,0,0,,Lost person?
Dialogue: 0,0:09:12.19,0:09:13.61,Default,,0,0,0,,Бұл өте жақсы жұмыс істемейді.
Dialogue: 0,0:09:14.61,0:09:16.82,Default,,0,0,0,,жағдайлары өте аз және
Dialogue: 0,0:09:17.28,0:09:20.32,Default,,0,0,0,,Қабілетті белсендіру расталмаған кезде
Dialogue: 0,0:09:20.49,0:09:23.54,Default,,0,0,0,,Әдетте тергеуден шығарылады
Dialogue: 0,0:09:23.66,0:09:26.04,Default,,0,0,0,,Зерттеу пәні өзгерген кезде
Dialogue: 0,0:09:26.12,0:09:27.21,Default,,0,0,0,,Осымен
Dialogue: 0,0:09:28.00,0:09:28.67,Default,,0,0,0,,Басқалар
Dialogue: 0,0:09:29.46,0:09:35.76,Default,,0,0,0,,Ол MI6 жауап алу кезінде ЦРУ-мен кейбір байланыстарын мойындайтын мәлімдеме жасағанға ұқсайды.
Dialogue: 0,0:09:36.34,0:09:40.09,Default,,0,0,0,,Әрине, ЦРУ мұны толығымен жоққа шығарады.
Dialogue: 0,0:09:44.10,0:09:49.10,Default,,0,0,0,,Менің атым - Пандорадан келген Эрик Нишижима. Мен сізге бірнеше сұрақ қойғым келеді.
Dialogue: 0,0:09:50.15,0:09:54.86,Default,,0,0,0,,Ұшақтан түскенде қандай да бір физикалық ауытқуды сезіндіңіз бе?
Dialogue: 0,0:09:56.74,0:09:57.07,Default,,0,0,0,,I don't feel it
Dialogue: 0,0:09:57.91,0:09:59.16,Default,,0,0,0,,Психикалық тұрғыдан ше?
Dialogue: 0,0:10:00.37,0:10:01.37,Default,,0,0,0,,Шынында… олардың әрқайсысы «Стэйн», «Стэйн» деп тоқтамай сөйлей береді…
Dialogue: 0,0:10:02.74,0:10:06.79,Default,,0,0,0,,Бұдан былай сізді Біріккен Ұлттар Ұйымы басқаратын Pandora зерттеу ұйымы қадағалайтын болады.
Dialogue: 0,0:10:07.21,0:10:10.25,Default,,0,0,0,,Тозақ қақпасының ішіндегі әртүрлі эксперименттерде көмек сұраңыз
Dialogue: 0,0:10:11.25,0:10:12.71,Default,,0,0,0,,Сіз бұл туралы алаңдайсыз ба?
Dialogue: 0,0:10:14.96,0:10:17.09,Default,,0,0,0,,Сізді уайымдағаны осы.
Dialogue: 0,0:10:32.48,0:10:34.94,Default,,0,0,0,,Мердігер мен мердігер арасындағы қарым-қатынас қандай?
Dialogue: 0,0:10:37.24,0:10:39.82,Default,,0,0,0,,Оңтүстік Америкадағы Аспан қақпасының жоғалып кеткеніне 5 жыл
Dialogue: 0,0:10:41.12,0:10:45.45,Default,,0,0,0,,Қай жерде қаңғып, Румынияға қалай келдіңіз?
Dialogue: 0,0:10:48.54,0:10:50.46,Default,,0,0,0,,Excuse me, but
Dialogue: 0,0:10:53.04,0:10:55.46,Default,,0,0,0,,А, мен бұған күлдім.
Dialogue: 0,0:10:59.01,0:11:01.76,Default,,0,0,0,,Бұл Ұлыбритания Сыртқы істер министрлігінен Джек Саймон.
Dialogue: 0,0:11:03.01,0:11:04.55,Default,,0,0,0,,Біз сізден хабар күтеміз.
Dialogue: 0,0:11:05.06,0:11:06.06,Default,,0,0,0,,Mr.
Dialogue: 0,0:11:06.14,0:11:08.85,Default,,0,0,0,,Маған Джек Мисаки деп қоңырау шалыңыз
Dialogue: 0,0:11:13.19,0:11:14.36,Default,,0,0,0,,This is Kirihara.
Dialogue: 0,0:11:36.34,0:11:37.71,Default,,0,0,0,,Токиоға бірінші рет келіп тұрсыз ба?
Dialogue: 0,0:11:39.55,0:11:41.17,Default,,0,0,0,,No, twice before.
Dialogue: 0,0:11:42.26,0:11:43.72,Default,,0,0,0,,Мен өлтіруші болып жұмыс істедім.
Dialogue: 0,0:11:46.18,0:11:47.22,Default,,0,0,0,,Жай әзіл.
Dialogue: 0,0:11:49.31,0:11:50.27,Default,,0,0,0,,Саймон мырза
Dialogue: 0,0:11:51.14,0:11:53.27,Default,,0,0,0,,Менің де сізден сұрайын дегенім бар.
Dialogue: 0,0:11:54.27,0:11:55.27,Default,,0,0,0,,Кез келген жолмен
Dialogue: 0,0:11:56.36,0:12:01.44,Default,,0,0,0,,Неліктен MI6 сирек кездесетін және құнды Хавокты басып алды?
Dialogue: 0,0:12:01.82,0:12:03.61,Default,,0,0,0,,Тәуелсіз зерттеулер жүргізілмейді
Dialogue: 0,0:12:04.07,0:12:06.95,Default,,0,0,0,,Оны Біріккен Ұлттар Ұйымы басқаратын Пандораға беру керек пе еді?
Dialogue: 0,0:12:07.49,0:12:09.33,Default,,0,0,0,,Жапонияда мұны істемейсің бе?
Dialogue: 0,0:12:10.04,0:12:14.17,Default,,0,0,0,,Жаңа халықаралық құқық қақтығыстан кейін күшіне енсе де
Dialogue: 0,0:12:14.63,0:12:19.30,Default,,0,0,0,,Менің ойымша, елдер қабілеті мен қақпасы бар адамдарды зерттеуден бас тартқан жоқ.
Dialogue: 0,0:12:19.67,0:12:21.05,Default,,0,0,0,,Жапон құқығы
Dialogue: 0,0:12:21.22,0:12:21.92,Default,,0,0,0,,Иә
Dialogue: 0,0:12:22.42,0:12:25.51,Default,,0,0,0,,Ұлыбританияда, Оңтүстік Америкадағы соңғы сәтсіздіктен кейін,
Dialogue: 0,0:12:26.01,0:12:30.31,Default,,0,0,0,,Қазіргі жағдай – дарынды тұлғаларды зерттеу жұртшылық тарапынан көп түсінікке ие бола бермейді.
Dialogue: 0,0:12:31.39,0:12:35.48,Default,,0,0,0,,Әртүрлі тәуекелдерді болдырмау және ақпаратты тиімді алу үшін
Dialogue: 0,0:12:35.90,0:12:39.44,Default,,0,0,0,,Біз ресми процедуралардан өткен дұрыс деп шештік.
Dialogue: 0,0:12:41.49,0:12:42.36,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:12:42.70,0:12:44.86,Default,,0,0,0,,Өзі үшін өлтіруім керек пе?
Dialogue: 0,0:12:45.41,0:12:48.28,Default,,0,0,0,,Мен саған жезөкшелікке қайта оралуды ұсындым.
Dialogue: 0,0:12:57.84,0:12:58.54,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:00.25,0:13:01.55,Default,,0,0,0,,Иә
Dialogue: 0,0:13:05.13,0:13:07.72,Default,,0,0,0,,Иә Коно
Dialogue: 0,0:13:07.89,0:13:10.89,Default,,0,0,0,,Бас Хавокты тасымалдайтын көлік тікұшағына
Dialogue: 0,0:13:11.10,0:13:14.10,Default,,0,0,0,,Кейбір ұйымдар қандай да бір тәсілді қолданып жатқан сияқты.
Dialogue: 0,0:13:14.81,0:13:15.85,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:13:16.44,0:13:18.31,Default,,0,0,0,,Мен мұны артымнан жасадым.
Dialogue: 0,0:13:21.32,0:13:22.36,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:13:24.03,0:13:28.03,Default,,0,0,0,,Бір елдің монополиясына жол бермеу үшін Пандораға ауыстырылғанымен.
Dialogue: 0,0:13:28.49,0:13:30.49,Default,,0,0,0,,ЦРУ жігіттеріне келгенде
Dialogue: 0,0:13:31.62,0:13:33.70,Default,,0,0,0,,Ештеңе етпейді, бәрін өлтір.
Dialogue: 0,0:13:34.25,0:13:37.12,Default,,0,0,0,,Мен бастық Кирихарадан қалғанын шешуді сұраймын.
Dialogue: 0,0:13:39.17,0:13:40.29,Default,,0,0,0,,Мен көлікті тоқтатамын.
Dialogue: 0,0:13:42.59,0:13:45.38,Default,,0,0,0,,Коно мен Мацумото жағдайды қазір тексереді
Dialogue: 0,0:13:45.84,0:13:47.38,Default,,0,0,0,,Сайто менеджерге хабарласады
Dialogue: 0,0:13:47.93,0:13:51.72,Default,,0,0,0,,ЦРУ-ға дипломатиялық арналар арқылы ескерту жасауды айтыңыз.
Dialogue: 0,0:13:52.35,0:13:53.01,Default,,0,0,0,,Бұл шұғыл.
Dialogue: 0,0:13:56.39,0:13:57.56,Default,,0,0,0,,Мені Кираның өкілі етіп тағайындағаны — даусыз факт.
Dialogue: 0,0:13:58.81,0:14:04.40,Default,,0,0,0,,Түсініктеме жоқ, менің ойымша, ЦРУ оны қазір қайтаруға келді.
Dialogue: 0,0:14:04.99,0:14:07.49,Default,,0,0,0,,Мен сенің блефіңді шақырдым деп ойлама.
Dialogue: 0,0:14:08.16,0:14:09.07,Default,,0,0,0,,Блеф
Dialogue: 0,0:14:09.28,0:14:12.70,Default,,0,0,0,,Иә, ол сонда.
Dialogue: 0,0:14:16.41,0:14:17.25,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:21.13,0:14:22.09,Default,,0,0,0,,Ой...
Dialogue: 0,0:14:22.54,0:14:24.00,Default,,0,0,0,,Бір немесе басқа рет
Dialogue: 0,0:14:24.38,0:14:26.71,Default,,0,0,0,,Саған сенбегенім емес.
Dialogue: 0,0:14:27.26,0:14:31.43,Default,,0,0,0,,Мен жай ғана ақпараттың қай бөлігі ағып кететінін білгім келеді.
Dialogue: 0,0:14:32.64,0:14:34.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:42.15,0:14:44.02,Default,,0,0,0,,Қазір қайда жүгіріп жүрсіз?
Dialogue: 0,0:14:44.69,0:14:45.27,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:14:45.61,0:14:47.11,Default,,0,0,0,,Pandora штаб-пәтеріне бару
Dialogue: 0,0:15:01.17,0:15:01.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:02.29,0:15:03.88,Default,,0,0,0,,Жоқ, енді адам
Dialogue: 0,0:15:09.17,0:15:10.55,Default,,0,0,0,,Еш жерде адам жоқ
Dialogue: 0,0:15:10.88,0:15:12.14,Default,,0,0,0,,Бірақ, әрине...
Dialogue: 0,0:15:17.35,0:15:18.10,Default,,0,0,0,,Екі күн бұрын банк тонаған жігіт енді автобусты ұрлап кетті.
Dialogue: 0,0:15:24.11,0:15:25.06,Default,,0,0,0,,Бұл жерде
Dialogue: 0,0:15:30.78,0:15:31.07,Default,,0,0,0,,Эй... Сәлем, Саймон мырза
Dialogue: 0,0:15:31.78,0:15:32.57,Default,,0,0,0,,Жол жүру кезінде
Dialogue: 0,0:15:32.95,0:15:34.45,Default,,0,0,0,,Бұл тұзақ сияқты
Dialogue: 0,0:15:34.99,0:15:35.74,Default,,0,0,0,,Тұзақ
Dialogue: 0,0:15:52.68,0:15:53.64,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:15:55.26,0:15:59.02,Default,,0,0,0,,Бастық, бұл жаңа ғана секіріп кеткен жігіт.
Dialogue: 0,0:16:03.69,0:16:04.52,Default,,0,0,0,,Яғни
Dialogue: 0,0:16:05.40,0:16:06.61,Default,,0,0,0,,Қара қырғыш
Dialogue: 0,0:16:21.54,0:16:22.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:22.92,0:16:25.83,Default,,0,0,0,,Менеджер, бұл келісім-шарт иелері.
Dialogue: 0,0:17:17.51,0:17:19.43,Default,,0,0,0,,Штаб-пәтер Жауап беріңіз
Dialogue: 0,0:17:19.85,0:17:20.81,Default,,0,0,0,,Шұғыл қолдау көрсету
Dialogue: 0,0:17:38.95,0:17:40.58,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:17:40.99,0:17:45.79,Default,,0,0,0,,Әйтеуір, әзірге алдымен алып кеткен Хавокты қалпына келтіруді ойлаңыз.
Dialogue: 0,0:17:47.00,0:17:47.79,Default,,0,0,0,,Иә
Dialogue: 0,0:17:48.21,0:17:49.88,Default,,0,0,0,,Бұл мәселе ме?
Dialogue: 0,0:17:51.59,0:17:53.96,Default,,0,0,0,,Мен екінші ақпарат тарайды деп ешқашан күткен емеспін.
Dialogue: 0,0:17:54.59,0:17:58.59,Default,,0,0,0,,Жапон полициясы құпия ақпаратты бақылай алмайды
Dialogue: 0,0:17:59.60,0:18:01.60,Default,,0,0,0,,11 қарашаның дәл айтқаны.
Dialogue: 0,0:18:02.22,0:18:04.27,Default,,0,0,0,,11 қараша
Dialogue: 0,0:18:04.77,0:18:09.06,Default,,0,0,0,,Джек Саймон Бұл Кордоней, сізді ертіп келген дипломат.
Dialogue: 0,0:18:09.77,0:18:11.44,Default,,0,0,0,,Ол сол
Dialogue: 0,0:18:12.11,0:18:15.03,Default,,0,0,0,,MI16-ның ең жақсы агенті
Dialogue: 0,0:18:17.82,0:18:21.24,Default,,0,0,0,,Кез келген жағдайда Pandora заңының 22-бабына сәйкес
Dialogue: 0,0:18:21.70,0:18:23.45,Default,,0,0,0,,Бұдан былай сіз біздің қол астында боласыз.
Dialogue: 0,0:18:23.74,0:18:26.25,Default,,0,0,0,,Біз Havoc-ты қайтаруға көшеміз.
Dialogue: 0,0:18:26.91,0:18:27.96,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:18:28.00,0:18:28.79,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.63,0:18:33.63,Default,,0,0,0,,Мен ол супер А класының агенті ме, әлде басқа нәрсе ме, білмеймін.
Dialogue: 0,0:18:33.96,0:18:37.22,Default,,0,0,0,,Соңында олардың бәрі айлакер болып шығады.
Dialogue: 0,0:18:37.55,0:18:39.55,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:18:40.14,0:18:43.89,Default,,0,0,0,,Оны әдейі әшкерелеген жол бар емес пе?
Dialogue: 0,0:18:44.35,0:18:45.77,Default,,0,0,0,,Не үшін?
Dialogue: 0,0:18:46.10,0:18:47.85,Default,,0,0,0,,Егер сіз мұны түсінсеңіз, сізде қиындық болмайды
Dialogue: 0,0:18:50.40,0:18:53.90,Default,,0,0,0,,Бастық, маған астрономия бөлімінен телефон соқты.
Dialogue: 0,0:18:54.65,0:18:56.69,Default,,0,0,0,,Сол кезде бөлім бастықтарына шабуыл жасалды
Dialogue: 0,0:18:57.03,0:19:00.11,Default,,0,0,0,,БК201 белсенділігі байқалған сияқты.
Dialogue: 0,0:19:01.57,0:19:03.53,Default,,0,0,0,,BK201
Dialogue: 0,0:19:23.01,0:19:25.31,Default,,0,0,0,,Мердігер – қиындық тудыратын ұйым
Dialogue: 0,0:19:25.93,0:19:30.35,Default,,0,0,0,,Темекі шегу, шегуге келмейтін темекі және ішуді қаламайтын алкогольді ішу.
Dialogue: 0,0:19:30.39,0:19:32.60,Default,,0,0,0,,Мен алкогольді жақсы көремін
Dialogue: 0,0:19:34.61,0:19:38.74,Default,,0,0,0,,Бұл нәтиже болатынын алдын ала білдіңіз бе?
Dialogue: 0,0:19:39.28,0:19:40.45,Default,,0,0,0,,11 қараша
Dialogue: 0,0:19:41.91,0:19:45.83,Default,,0,0,0,,Егер сіз мұны білсеңіз, барлық мүмкін шараларды қолдануыңыз керек.
Dialogue: 0,0:19:46.87,0:19:50.08,Default,,0,0,0,,Бірақ менің шараларым жеткіліксіз болды.
Dialogue: 0,0:19:51.12,0:19:53.17,Default,,0,0,0,,Сонымен, жауап жоқ.
Dialogue: 0,0:19:54.46,0:19:59.34,Default,,0,0,0,,Дегенмен, бұл жолы бір нәрсе анық.
Dialogue: 0,0:19:59.97,0:20:02.55,Default,,0,0,0,,Хавокты алып кеткен осы ұйым.
Dialogue: 0,0:20:02.84,0:20:06.26,Default,,0,0,0,,Дипломатиялық арналар жұмыс істемейді
Dialogue: 0,0:20:06.85,0:20:07.76,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:20:08.35,0:20:10.98,Default,,0,0,0,,Жау ЦРУ емес
Dialogue: 0,0:20:13.77,0:20:17.57,Default,,0,0,0,,Синджуку Ториноза тұрағы қол жетімді
Dialogue: 0,0:20:18.23,0:20:21.78,Default,,0,0,0,,Синджуку Ториноза тұрағы қол жетімді
Dialogue: 0,0:20:24.24,0:20:29.20,Default,,0,0,0,,Ал, енді итерейік.
Dialogue: 0,0:20:30.70,0:20:33.58,Default,,0,0,0,,Мистер Екі нөл бір BK
Dialogue: 0,0:20:47.68,0:20:48.85,Default,,0,0,0,,Тыныштық
Dialogue: 0,0:20:50.89,0:20:52.10,Default,,0,0,0,,Ерекше ауытқулар жоқ
Dialogue: 0,0:20:53.31,0:20:54.27,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:21:03.20,0:21:05.11,Default,,0,0,0,,Минчо ұйымына тапсыру
Dialogue: 0,0:21:05.45,0:21:09.03,Default,,0,0,0,,Олар Хавоктың қақпаға жақындағанын қаламайтын сияқты.
Dialogue: 0,0:21:10.16,0:21:14.79,Default,,0,0,0,,Мен мұндай құбыжықты мәңгілікке жақын ұстамас едім.
Dialogue: 0,0:21:16.58,0:21:17.83,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:21:23.92,0:21:24.59,Default,,0,0,0,,Эй, Хавок қайда кетті?
Dialogue: 0,0:21:27.05,0:21:28.93,Default,,0,0,0,,Мен де қара фигураларды көре алмаймын.
Dialogue: 0,0:21:29.22,0:21:30.68,Default,,0,0,0,,Күміс Екі адам
Dialogue: 0,0:21:31.47,0:21:32.43,Default,,0,0,0,,Ол шықты
Dialogue: 0,0:21:32.52,0:21:33.68,Default,,0,0,0,,шықты
Dialogue: 0,0:21:33.77,0:21:34.81,Default,,0,0,0,,Дайынсың ба? Алтыға бес қанша?
Dialogue: 0,0:21:36.15,0:21:36.98,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:21:50.08,0:21:52.16,Default,,0,0,0,,Тірі болу құдіреті – Менікі
Dialogue: 0,0:21:53.29,0:21:55.96,Default,,0,0,0,,Мені бұл атпен атамағанына біраз болды.
Dialogue: 0,0:21:56.71,0:21:59.54,Default,,0,0,0,,Сол кезде онда не болды?
Dialogue: 0,0:22:03.96,0:22:04.88,Default,,0,0,0,,Менің әпкем
Dialogue: 0,0:22:05.80,0:22:07.34,Default,,0,0,0,,Pi қайда орналасқан?
Dialogue: 0,0:23:40.60,0:23:41.98,Default,,0,0,0,,Әпкемнің атын атау
Dialogue: 0,0:23:42.69,0:23:44.11,Default,,0,0,0,,Есім ауада қалықтап тұр
Dialogue: 0,0:23:44.52,0:23:46.07,Default,,0,0,0,,Қызыл-қара аспанға ғайып болды
Dialogue: 0,0:23:46.82,0:23:49.94,Default,,0,0,0,,Жоғалған адам Билігін жоғалтуы мүмкін адамдар
Dialogue: 0,0:23:50.45,0:23:53.16,Default,,0,0,0,,Бір сәттік тыныштық пен бір үзім үміт
Dialogue: 0,0:23:54.62,0:23:58.12,Default,,0,0,0,,Бірақ мені қуған күнә бәрін алып кетеді.
Dialogue: 0,0:23:58.75,0:24:03.71,Default,,0,0,0,,Суық жүздің тесіп өткені сол күнгі мәйіттің тірі екеніне дәлел.
Dialogue: 0,0:24:04.92,0:24:07.63,Default,,0,0,0,,Ал тозақ есіктері қағады
Dialogue: 0,0:24:09.13,0:24:15.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
