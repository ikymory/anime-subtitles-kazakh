Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.19,0:00:12.78,Default,,0,0,0,,Маған Фусаки қатты ұнайды...ол осылай майлы.
Dialogue: 0,0:00:13.03,0:00:15.03,Default,,0,0,0,,Себебі менің қарным ашты.
Dialogue: 0,0:00:15.07,0:00:16.66,Default,,0,0,0,,Соған қарамастан мен салмақ қоспаймын.
Dialogue: 0,0:00:17.66,0:00:20.12,Default,,0,0,0,,Күн сайын денеңізді қозғалтасыз.
Dialogue: 0,0:00:21.54,0:00:23.25,Default,,0,0,0,,Канами, сен не жазып тұрсың?
Dialogue: 0,0:00:25.83,0:00:27.75,Default,,0,0,0,,Ах, мансапты зерттеу
Dialogue: 0,0:00:28.17,0:00:30.67,Default,,0,0,0,,Ол келе жатыр. Бір жыл ғана болды.
Dialogue: 0,0:00:30.84,0:00:32.80,Default,,0,0,0,,Мен мансап жолым туралы ойламаймын.
Dialogue: 0,0:00:32.97,0:00:34.09,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:00:34.22,0:00:36.72,Default,,0,0,0,,Болашақты айтсаң да, білмеймін.
Dialogue: 0,0:00:36.93,0:00:38.06,Default,,0,0,0,,Әзірге жоғары оқу орындарына өту
Dialogue: 0,0:00:39.60,0:00:43.77,Default,,0,0,0,,Бұл жақсы, колледжге қайда баруды және жұмыс табуды шешкендер үшін.
Dialogue: 0,0:00:43.98,0:00:44.65,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:00:45.06,0:00:49.02,Default,,0,0,0,,Мен бұл жігіттің Токио университетінен полицияға келгенін білемін.
Dialogue: 0,0:00:49.28,0:00:50.40,Default,,0,0,0,,Полиция
Dialogue: 0,0:00:50.53,0:00:51.24,Default,,0,0,0,,Канами
Dialogue: 0,0:00:51.36,0:00:53.03,Default,,0,0,0,,Бұл шынында да әкелік тартыс.
Dialogue: 0,0:00:53.20,0:00:54.78,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:00:55.03,0:00:56.07,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:00:58.12,0:01:01.41,Default,,0,0,0,,Міне, бәрі әкемнен басталды.
Dialogue: 0,0:01:01.70,0:01:03.66,Default,,0,0,0,,Басқа себептер бар ма?
Dialogue: 0,0:01:03.71,0:01:04.96,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:05.79,0:01:08.75,Default,,0,0,0,,Бұл әлемде басқаларды ренжітуден еш қиындық көрмейтін адамдар бар.
Dialogue: 0,0:01:08.88,0:01:12.38,Default,,0,0,0,,Өз қалауын қанағаттандыруға тырысатындар көп.
Dialogue: 0,0:01:12.42,0:01:14.88,Default,,0,0,0,,Сахна артында жылап жатқандар көп.
Dialogue: 0,0:01:15.13,0:01:16.72,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:01:16.93,0:01:18.10,Default,,0,0,0,,Міне
Dialogue: 0,0:01:19.05,0:01:22.47,Default,,0,0,0,,Сіз әлсіз адамдармен одақтас болғыңыз келе ме?
Dialogue: 0,0:01:22.64,0:01:25.31,Default,,0,0,0,,Хусаки сондай құрметті студент.
Dialogue: 0,0:01:25.44,0:01:28.11,Default,,0,0,0,,Эй, бұл не? Мен саған мұны үйреттім.
Dialogue: 0,0:01:28.40,0:01:29.73,Default,,0,0,0,,Бұл менікі.
Dialogue: 0,0:01:29.98,0:01:31.23,Default,,0,0,0,,Маған бірдеңені қайтар.
Dialogue: 0,0:01:31.36,0:01:32.65,Default,,0,0,0,,Мен оны жеп қойдым.
Dialogue: 0,0:01:33.03,0:01:34.19,Default,,0,0,0,,Егер сіз көп жесеңіз
Dialogue: 0,0:01:34.36,0:01:35.11,Default,,0,0,0,,Дәмді, тағы біреуін беріңізші.
Dialogue: 0,0:01:35.36,0:01:35.86,Default,,0,0,0,,Дану
Dialogue: 0,0:01:36.16,0:01:37.03,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:09.37,0:03:12.21,Default,,0,0,0,,Бүгін қандай жақсы күн
Dialogue: 0,0:03:13.21,0:03:16.05,Default,,0,0,0,,Эй, Хусаки, сенің де солай ойлайтыныңа сенімдімін.
Dialogue: 0,0:03:16.59,0:03:17.88,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:03:18.05,0:03:21.51,Default,,0,0,0,,Өтінемін, артыма тығылып, менімен бірге тойламаңыз.
Dialogue: 0,0:03:27.10,0:03:29.77,Default,,0,0,0,,Сен, мұнда неге келдің?
Dialogue: 0,0:03:30.02,0:03:34.36,Default,,0,0,0,,Сосын үй иесі маған сусын әкелуімді өтінді.
Dialogue: 0,0:03:35.11,0:03:36.57,Default,,0,0,0,,Бірақ мен келгенде
Dialogue: 0,0:03:39.78,0:03:41.86,Default,,0,0,0,,Осы қарқынмен біз де өлтіреміз.
Dialogue: 0,0:03:42.07,0:03:43.20,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:03:43.99,0:03:45.91,Default,,0,0,0,,Не айтсаң да...
Dialogue: 0,0:03:48.45,0:03:50.16,Default,,0,0,0,,Осы араны пайдалансам да
Dialogue: 0,0:03:50.33,0:03:53.88,Default,,0,0,0,,Дүниеден ешқашан жоғалып кетпейтін нәрселер болды.
Dialogue: 0,0:03:54.29,0:03:57.55,Default,,0,0,0,,Бірақ мұның бәрі бүгін аяқталады.
Dialogue: 0,0:03:58.76,0:04:01.68,Default,,0,0,0,,Мені байланыстыратын барлық нәрсе ...
Dialogue: 0,0:04:02.05,0:04:05.76,Default,,0,0,0,,Әкесі мен Цинлонгтан да
Dialogue: 0,0:04:06.10,0:04:08.93,Default,,0,0,0,,Барлығы... хехехе...
Dialogue: 0,0:04:38.63,0:04:40.42,Default,,0,0,0,,Сіз...
Dialogue: 0,0:04:50.98,0:04:53.85,Default,,0,0,0,,Вэй маған көмектесті
Dialogue: 0,0:04:54.14,0:04:57.27,Default,,0,0,0,,Ол адам мені түсіне ме?
Dialogue: 0,0:04:58.65,0:05:02.32,Default,,0,0,0,,Сонымен қатар, бүгін өте жақсы күн.
Dialogue: 0,0:05:02.70,0:05:05.66,Default,,0,0,0,,Осындай күнде тағы кездесетініме сене алар емеспін
Dialogue: 0,0:05:06.45,0:05:09.29,Default,,0,0,0,,Оны тек тағдыр деп сипаттауға болады.
Dialogue: 0,0:05:11.75,0:05:13.46,Default,,0,0,0,,Мен сізге белгі бергенде жүгіріңіз.
Dialogue: 0,0:05:15.08,0:05:16.79,Default,,0,0,0,,Сондықтан Фусаки
Dialogue: 0,0:05:17.08,0:05:18.75,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:05:18.96,0:05:21.05,Default,,0,0,0,,Ал мені босат
Dialogue: 0,0:05:22.01,0:05:24.05,Default,,0,0,0,,Хусакиттебаа
Dialogue: 0,0:05:25.05,0:05:25.55,Default,,0,0,0,,Әлі де
Dialogue: 0,0:05:34.23,0:05:35.64,Default,,0,0,0,,Мен сенің қашуыңа жол бермеймін
Dialogue: 0,0:05:35.85,0:05:37.27,Default,,0,0,0,,Фусаки
Dialogue: 0,0:05:42.82,0:05:45.53,Default,,0,0,0,,Сіз кімсіз...?
Dialogue: 0,0:05:46.41,0:05:47.36,Default,,0,0,0,,Полиция
Dialogue: 0,0:05:47.95,0:05:50.37,Default,,0,0,0,,Сіз жас ханымның досы емессіз бе?
Dialogue: 0,0:05:54.04,0:05:55.46,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:05:55.79,0:05:59.34,Default,,0,0,0,,Біріншіден, мен бұл ғимараттан шыққым келеді...
Dialogue: 0,0:06:13.77,0:06:14.98,Default,,0,0,0,,Мұны қайталаудың қажеті жоқ.
Dialogue: 0,0:06:15.31,0:06:17.73,Default,,0,0,0,,Біз қазір себебін растап жатырмыз.
Dialogue: 0,0:06:17.81,0:06:19.52,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,0:06:20.40,0:06:23.40,Default,,0,0,0,,Сіз мені осы жерден түсірмеуді жоспарлап отырсыз ба?
Dialogue: 0,0:06:23.73,0:06:25.78,Default,,0,0,0,,Апаттық баспалдақтар бар.
Dialogue: 0,0:06:25.90,0:06:28.11,Default,,0,0,0,,Бұл заттар ұзақ уақыт бойы бөгелді.
Dialogue: 0,0:06:28.41,0:06:31.08,Default,,0,0,0,,Ешкімге ешқашан жол бермеңіз
Dialogue: 0,0:06:31.33,0:06:32.53,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:06:41.38,0:06:41.96,Default,,0,0,0,,Иә
Dialogue: 0,0:06:43.13,0:06:45.38,Default,,0,0,0,,Әр бұрылыста сезімдеріңе ерік беріп жүру ме?
Dialogue: 0,0:06:51.64,0:06:53.51,Default,,0,0,0,,Атқарушы жиналыс аяқталды.
Dialogue: 0,0:06:53.85,0:06:56.27,Default,,0,0,0,,Өзіңізді тазалаңыз
Dialogue: 0,0:06:56.52,0:06:57.27,Default,,0,0,0,,болып табылады
Dialogue: 0,0:07:06.36,0:07:10.53,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:07:10.70,0:07:12.24,Default,,0,0,0,,Мен қазір осыны ойлап отырмын
Dialogue: 0,0:07:12.57,0:07:13.99,Default,,0,0,0,,Иә
Dialogue: 0,0:07:15.24,0:07:17.29,Default,,0,0,0,,Сізде ұялы телефон жоқ
Dialogue: 0,0:07:17.50,0:07:20.75,Default,,0,0,0,,Жоқ, ереже бойынша жұмыс кезінде алып жүруге болмайды.
Dialogue: 0,0:07:21.88,0:07:22.63,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:25.46,0:07:26.34,Default,,0,0,0,,Электр қуатын өшіру
Dialogue: 0,0:07:26.67,0:07:31.39,Default,,0,0,0,,Аа, бірақ жақсы, бұл қонақүйдің өз электр генераторы бар.
Dialogue: 0,0:07:33.10,0:07:34.22,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:07:34.64,0:07:39.39,Default,,0,0,0,,Сіз оны электр желілерінен ажыратып, бақылаушы рухтарды кіргізбеуді жоспарлап отырсыз ба?
Dialogue: 0,0:07:39.48,0:07:40.14,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:07:43.15,0:07:44.77,Default,,0,0,0,,Неліктен бұл болып жатыр...
Dialogue: 0,0:07:45.11,0:07:45.90,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:07:47.40,0:07:50.07,Default,,0,0,0,,Неліктен Алиса мені өлтірмекші болды?
Dialogue: 0,0:07:51.16,0:07:52.70,Default,,0,0,0,,(Иида) Мен ағамның атын иемдендім. Мен мұны істеуім керек…
Dialogue: 0,0:07:53.03,0:07:54.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:55.41,0:07:57.45,Default,,0,0,0,,Сонда сізді сатқындық жасады ма?
Dialogue: 0,0:07:57.83,0:07:59.16,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:07:59.46,0:08:01.50,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:08:02.75,0:08:04.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:06.59,0:08:09.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:09.59,0:08:15.39,Default,,0,0,0,,Дегенмен, достың сатқындығы әлі де азап.
Dialogue: 0,0:08:20.35,0:08:23.02,Default,,0,0,0,,Неге бұлай сөйлеп тұрсың?
Dialogue: 0,0:08:23.31,0:08:24.69,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:08:26.77,0:08:27.82,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:33.45,0:08:35.41,Default,,0,0,0,,Сіз өзгердіңіз...
Dialogue: 0,0:08:35.62,0:08:37.37,Default,,0,0,0,,Бұл туралы жиі айтылады.
Dialogue: 0,0:08:37.58,0:08:38.45,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:38.83,0:08:41.91,Default,,0,0,0,,Көбінесе жүзіңді көре алмаймын.
Dialogue: 0,0:08:42.16,0:08:44.29,Default,,0,0,0,,Мен мұндай жерге тығылып қалмасам екен.
Dialogue: 0,0:08:44.58,0:08:45.75,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:08:46.00,0:08:47.75,Default,,0,0,0,,Сіз байқамадыңыз ба?
Dialogue: 0,0:08:48.21,0:08:51.13,Default,,0,0,0,,Күте тұрыңыз, содан кейін...
Dialogue: 0,0:08:51.47,0:08:54.34,Default,,0,0,0,,Залға бар, Сайтоны сыртқа шығарма.
Dialogue: 0,0:08:54.59,0:08:55.18,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:08:55.51,0:08:58.81,Default,,0,0,0,,Бұл орындалғаннан кейін сіз қашып кете аласыз немесе қалағаныңызды жасай аласыз.
Dialogue: 0,0:08:59.10,0:08:59.89,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:09:01.14,0:09:02.10,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:09:06.02,0:09:08.02,Default,,0,0,0,,Менің атым Ли Шэншунь.
Dialogue: 0,0:09:08.32,0:09:10.65,Default,,0,0,0,,Өзін-өзі таныстыру Сіз мұны әлі жасаған жоқсыз, солай ма?
Dialogue: 0,0:09:13.03,0:09:14.61,Default,,0,0,0,,Менің атым Юсаки Кирихара.
Dialogue: 0,0:09:14.99,0:09:17.83,Default,,0,0,0,,Бұл ваннада өзімді алғаш рет таныстыруым.
Dialogue: 0,0:09:18.12,0:09:19.16,Default,,0,0,0,,Мен де
Dialogue: 0,0:09:22.50,0:09:24.42,Default,,0,0,0,,Фусаки қонақ үйде
Dialogue: 0,0:09:24.67,0:09:26.29,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:26.46,0:09:29.63,Default,,0,0,0,,Бұл бақылаушы рухтарды өшіру үшін электр қуаты өшірілген ғимарат.
Dialogue: 0,0:09:29.84,0:09:32.30,Default,,0,0,0,,Қабілеттердің белсендіруі де байқалды.
Dialogue: 0,0:09:32.51,0:09:35.22,Default,,0,0,0,,VI-952 болуы керек, солай ма?
Dialogue: 0,0:09:35.47,0:09:37.30,Default,,0,0,0,,Неліктен мұндай жерде жүрсің?
Dialogue: 0,0:09:37.51,0:09:38.72,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:09:39.01,0:09:42.18,Default,,0,0,0,,Менің ұялы телефоным да жұмыс істемейді, сондықтан бірдеңе болып жатқанына сенімдімін.
Dialogue: 0,0:09:42.47,0:09:45.77,Default,,0,0,0,,Алайда оқиға орнында ешқандай шығын тіркелген жоқ.
Dialogue: 0,0:09:46.02,0:09:47.94,Default,,0,0,0,,Мен енді кіре алмаймын...
Dialogue: 0,0:09:48.06,0:09:49.82,Default,,0,0,0,,Ондай жағдайда тез арада жағдайды шешіңіз.
Dialogue: 0,0:09:57.24,0:09:59.66,Default,,0,0,0,,Ой, не істеп жатырсың, бастық?
Dialogue: 0,0:09:59.95,0:10:02.20,Default,,0,0,0,,Жарайды, тез жабыңыз.
Dialogue: 0,0:10:02.41,0:10:04.12,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:10:09.34,0:10:10.67,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:10.92,0:10:12.80,Default,,0,0,0,,Фусакиге барыңыз
Dialogue: 0,0:10:13.17,0:10:15.63,Default,,0,0,0,,Әйтпесе, мен бос бола алмаймын.
Dialogue: 0,0:10:16.01,0:10:19.05,Default,,0,0,0,,Иә, жай ғана әйел.
Dialogue: 0,0:10:19.26,0:10:21.85,Default,,0,0,0,,Мен бірден келіп беремін.
Dialogue: 0,0:10:22.18,0:10:24.31,Default,,0,0,0,,Жоқ, бұл басқаша.
Dialogue: 0,0:10:24.68,0:10:28.35,Default,,0,0,0,,Хусаки жалғыз емес еді; оның қасында бір ер адам да болды.
Dialogue: 0,0:10:29.10,0:10:30.65,Default,,0,0,0,,өзі құдаймын деп айтқан адаммен кездескеннен бері.
Dialogue: 0,0:10:43.91,0:10:45.20,Default,,0,0,0,,Сайто
Dialogue: 0,0:10:45.62,0:10:47.79,Default,,0,0,0,,Жақсырақ жол бар ма?
Dialogue: 0,0:10:47.83,0:10:50.21,Default,,0,0,0,,Менің ойымша, сіз тығылып, сыртқа шыққыңыз келеді.
Dialogue: 0,0:10:50.50,0:10:52.50,Default,,0,0,0,,Тек жертөледегі кір жууға барыңыз.
Dialogue: 0,0:10:52.80,0:10:54.96,Default,,0,0,0,,Ең дұрысы сол жерден қашып кеткен.
Dialogue: 0,0:10:57.09,0:10:59.93,Default,,0,0,0,,Айтпақшы, нақты не болды?
Dialogue: 0,0:11:00.14,0:11:02.26,Default,,0,0,0,,Барлығы шынымен де қышиды.
Dialogue: 0,0:11:02.43,0:11:03.97,Default,,0,0,0,,Өйткені аралға бармауға және шағын қайықта күтіп тұруға бұйрық берілді
Dialogue: 0,0:11:04.64,0:11:08.10,Default,,0,0,0,,Бұл нені білдіреді, Ли?
Dialogue: 0,0:11:09.60,0:11:10.31,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:10.56,0:11:12.69,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:13.11,0:11:14.53,Default,,0,0,0,,Басқа нәрсе
Dialogue: 0,0:11:48.85,0:11:50.77,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,0:11:52.40,0:11:55.77,Default,,0,0,0,,Сіз полицей әйелді жем ретінде пайдалануды жоспарлап отырсыз ба?
Dialogue: 0,0:11:56.03,0:11:57.48,Default,,0,0,0,,таяз
Dialogue: 0,0:11:57.82,0:12:00.20,Default,,0,0,0,,Мен оның қай ұйымнан екенін білмеймін.
Dialogue: 0,0:12:00.45,0:12:02.70,Default,,0,0,0,,Екінші тарап нашар болды.
Dialogue: 0,0:12:03.87,0:12:05.99,Default,,0,0,0,,Мен оны қайтаруды сұраймын.
Dialogue: 0,0:12:09.66,0:12:11.12,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:12:11.42,0:12:17.25,Default,,0,0,0,,Менің өз қанымды төгу - мердігер ретінде төлейтін бағам.
Dialogue: 0,0:12:17.59,0:12:19.47,Default,,0,0,0,,бастайық.
Dialogue: 0,0:12:30.18,0:12:31.48,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:33.65,0:12:35.81,Default,,0,0,0,,Нақты іс басталғалы тұр.
Dialogue: 0,0:13:24.53,0:13:26.37,Default,,0,0,0,,Мен естідім
Dialogue: 0,0:13:26.70,0:13:31.08,Default,,0,0,0,,Электр энергиясының ағынын еркін басқара алатын дарынды мердігер бар.
Dialogue: 0,0:13:32.83,0:13:36.38,Default,,0,0,0,,Түсіндім, сіз БК-201 екенсіз
Dialogue: 0,0:13:36.75,0:13:41.30,Default,,0,0,0,,Сіз мені әдейі бұрышқа итеріп, күзетімді түсірдіңіз бе?
Dialogue: 0,0:13:41.59,0:13:43.88,Default,,0,0,0,,Дегенмен, бұл нашар жоспарланған сияқты.
Dialogue: 0,0:13:44.26,0:13:47.64,Default,,0,0,0,,Мен сенен жылдамырақ сияқтымын.
Dialogue: 0,0:14:06.91,0:14:08.53,Default,,0,0,0,,Сайто осылай.
Dialogue: 0,0:14:10.12,0:14:11.99,Default,,0,0,0,,Ах, бірақ...
Dialogue: 0,0:14:12.37,0:14:13.29,Default,,0,0,0,,Дүрбелеңге салынбаңыз
Dialogue: 0,0:14:13.54,0:14:15.21,Default,,0,0,0,,Күдік туғызбау үшін әрекет ету.
Dialogue: 0,0:14:15.41,0:14:16.25,Default,,0,0,0,,Иә
Dialogue: 0,0:14:23.09,0:14:24.55,Default,,0,0,0,,Осы бөлмеден рахат алыңыз
Dialogue: 0,0:14:24.76,0:14:25.76,Default,,0,0,0,,Иә
Dialogue: 0,0:14:29.89,0:14:33.56,Default,,0,0,0,,Онда үстел жоқ, солай ма?
Dialogue: 0,0:14:48.24,0:14:51.95,Default,,0,0,0,,Бұл дәмді болды. Бұл сәл артық болды.
Dialogue: 0,0:14:52.20,0:14:54.75,Default,,0,0,0,,Алиса, сен нені айтып тұрсың?
Dialogue: 0,0:14:55.08,0:14:56.29,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:14:56.62,0:15:01.09,Default,,0,0,0,,Бүгін мені ұстап тұрғанның бәрі жойылатын күн.
Dialogue: 0,0:15:02.92,0:15:07.01,Default,,0,0,0,,Цинлунтанның бәрінен де жоғары бағалағаны қандас байланыс болды.
Dialogue: 0,0:15:07.34,0:15:12.05,Default,,0,0,0,,Сондықтан Ван Сяотанның қанын ең көп мұра еткен мен,
Dialogue: 0,0:15:12.18,0:15:14.56,Default,,0,0,0,,Қаласаңыз да, қаламасаңыз да
Dialogue: 0,0:15:14.68,0:15:19.48,Default,,0,0,0,,Мен үшін дайындалған жалғыз нәрсе - Чинглонгтанг деп аталатын ұйымның жүгін арқалаған өмір болды.
Dialogue: 0,0:15:21.40,0:15:25.07,Default,,0,0,0,,Тіпті, «қақпа» пайда болып, дүние осындай абыржу болса да
Dialogue: 0,0:15:25.28,0:15:27.49,Default,,0,0,0,,Ол ешқашан өзгерген жоқ.
Dialogue: 0,0:15:29.41,0:15:31.45,Default,,0,0,0,,Бірақ Ван Сяотан қайтыс болды.
Dialogue: 0,0:15:31.70,0:15:34.83,Default,,0,0,0,,Цинлунтан да із-түзсіз жоғалып кетті.
Dialogue: 0,0:15:35.20,0:15:37.79,Default,,0,0,0,,Вэй Цишунға рахмет.
Dialogue: 0,0:15:38.41,0:15:40.17,Default,,0,0,0,,Бастық: Ол...
Dialogue: 0,0:15:40.54,0:15:42.17,Default,,0,0,0,,VI-952
Dialogue: 0,0:15:47.26,0:15:48.51,Default,,0,0,0,,Сайто
Dialogue: 0,0:15:48.72,0:15:50.09,Default,,0,0,0,,Өтінемін, Вэй
Dialogue: 0,0:15:50.51,0:15:52.80,Default,,0,0,0,,Мені босат
Dialogue: 0,0:15:56.14,0:15:58.35,Default,,0,0,0,,Енді сіз боссыз
Dialogue: 0,0:16:13.45,0:16:14.37,Default,,0,0,0,,Алиса
Dialogue: 0,0:16:15.62,0:16:18.62,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:16:19.16,0:16:22.46,Default,,0,0,0,,Сіз бос болғыңыз келмеді
Dialogue: 0,0:16:22.75,0:16:24.88,Default,,0,0,0,,Байланысты болуға ұмтылу
Dialogue: 0,0:16:25.13,0:16:29.01,Default,,0,0,0,,Мен біреуге тәуелді болғым келді, Алиса.
Dialogue: 0,0:16:29.21,0:16:30.97,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:16:31.13,0:16:36.14,Default,,0,0,0,,Кейде Юсаки Кирихара болды, ал кейде мен болдым.
Dialogue: 0,0:16:36.93,0:16:40.43,Default,,0,0,0,,Әкеңнен құтылғың келмеді;
Dialogue: 0,0:16:40.48,0:16:42.98,Default,,0,0,0,,Менің байланғанымды қалаған шығарсыз.
Dialogue: 0,0:16:50.32,0:16:51.28,Default,,0,0,0,,Алиса
Dialogue: 0,0:16:52.24,0:16:54.49,Default,,0,0,0,,Алиса Алиса
Dialogue: 0,0:16:57.62,0:16:59.75,Default,,0,0,0,,Сен де күнәһарсың
Dialogue: 0,0:17:00.37,0:17:02.58,Default,,0,0,0,,Алисаның әкесіне тәуелділігінен
Dialogue: 0,0:17:02.71,0:17:05.29,Default,,0,0,0,,Адамды босатқан адам
Dialogue: 0,0:17:05.46,0:17:07.42,Default,,0,0,0,,Сіз әлі байқамадыңыз ба?
Dialogue: 0,0:17:07.67,0:17:08.92,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:17:09.05,0:17:13.34,Default,,0,0,0,,Әке билігінен толықтай бас тарту?
Dialogue: 0,0:17:13.38,0:17:17.26,Default,,0,0,0,,Бұл ол үшін бірінші тәжірибе болды.
Dialogue: 0,0:17:17.85,0:17:19.72,Default,,0,0,0,,Әке маңызды емес.
Dialogue: 0,0:17:22.02,0:17:26.90,Default,,0,0,0,,Ол сенен жаңа тәуелділік тапты.
Dialogue: 0,0:17:27.19,0:17:29.94,Default,,0,0,0,,Бірақ сіз полиция қызметкері болдыңыз
Dialogue: 0,0:17:30.23,0:17:32.40,Default,,0,0,0,,Ван Сяотанның қызы кім?
Dialogue: 0,0:17:32.61,0:17:37.41,Default,,0,0,0,,Ешқашан бітіспес дүниенің адамына айналдым.
Dialogue: 0,0:17:37.70,0:17:38.91,Default,,0,0,0,,біздің орнымыз ба?
Dialogue: 0,0:17:42.50,0:17:43.25,Default,,0,0,0,,Менеджер
Dialogue: 0,0:17:47.63,0:17:48.54,Default,,0,0,0,,Сайто
Dialogue: 0,0:17:50.13,0:17:51.84,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:18:15.95,0:18:18.82,Default,,0,0,0,,БҚ...201
Dialogue: 0,0:18:22.37,0:18:25.21,Default,,0,0,0,,Неге...
Dialogue: 0,0:18:30.00,0:18:32.34,Default,,0,0,0,,Бұл сіздің қаныңыз болды ма?
Dialogue: 0,0:18:33.13,0:18:34.92,Default,,0,0,0,,Сол сәтте
Dialogue: 0,0:18:36.01,0:18:38.84,Default,,0,0,0,,Бұл... нәрсе...
Dialogue: 0,0:18:42.89,0:18:45.27,Default,,0,0,0,,Менің жылдамдығым жақсырақ болды.
Dialogue: 0,0:18:47.35,0:18:48.15,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:19:15.88,0:19:17.30,Default,,0,0,0,,Вэй Цишун
Dialogue: 0,0:19:17.42,0:19:21.47,Default,,0,0,0,,Ол Цинлунтанды бақылауды жоюды көздеді.
Dialogue: 0,0:19:21.80,0:19:26.18,Default,,0,0,0,,Ванды және барлық басшыларды, сосын оның қызын өлтіру керек пе?
Dialogue: 0,0:19:26.39,0:19:28.10,Default,,0,0,0,,Мен өте жақсы жұмыс істеп жатырмын.
Dialogue: 0,0:19:28.27,0:19:32.15,Default,,0,0,0,,Сонда олар сізді кінәлі ретінде пайдаланбақ болды ма?
Dialogue: 0,0:19:34.23,0:19:39.15,Default,,0,0,0,,Айтпақшы, Вейдің денесі мәйітханадан жоғалып кеткен сияқты.
Dialogue: 0,0:19:39.15,0:19:43.49,Default,,0,0,0,,Мен солай ойлаймын. Бұл түнде жұлдыздар болған жоқ.
Dialogue: 0,0:19:45.95,0:19:48.37,Default,,0,0,0,,Миссия орындалды.
Dialogue: 0,0:19:54.42,0:19:58.76,Default,,0,0,0,,Егер мен ешқашан полицияға келмеген болсам
Dialogue: 0,0:19:59.13,0:20:01.68,Default,,0,0,0,,Мен Алисаны құтқара алар едім деп ойлаймын.
Dialogue: 0,0:20:02.09,0:20:03.68,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:20:04.14,0:20:07.77,Default,,0,0,0,,Адамның жүрегін, мінез-құлқын ешкім түсіне алмайды.
Dialogue: 0,0:20:08.89,0:20:14.44,Default,,0,0,0,,Бірақ мен сізді полиция емес деп елестете аламын.
Dialogue: 0,0:20:20.20,0:20:23.03,Default,,0,0,0,,Канами, сен қашаннан бері темекі тарта бастадың...
Dialogue: 0,0:20:23.37,0:20:24.58,Default,,0,0,0,,Мен де
Dialogue: 0,0:20:24.87,0:20:29.87,Default,,0,0,0,,Түрі осылай болса да, бір нәрсеге тәуелді болмай өмір сүре алмайтын әлсіз әйел.
Dialogue: 0,0:20:34.96,0:20:37.59,Default,,0,0,0,,Саған сенетін адамдар көп.
Dialogue: 0,0:20:37.84,0:20:42.22,Default,,0,0,0,,Бірақ бәрін сорып алуға тырысатын жаман әдетің.
Dialogue: 0,0:20:44.22,0:20:48.31,Default,,0,0,0,,Көмек сұраған кезде бірден келмесең, қиналып қаламын.
Dialogue: 0,0:20:51.19,0:20:52.65,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:20:54.90,0:20:59.07,Default,,0,0,0,,Бірақ менің қасымда темекі шекпеңізші.
Dialogue: 0,0:20:59.32,0:21:01.07,Default,,0,0,0,,Киімнің иісі.
Dialogue: 0,0:21:03.24,0:21:04.70,Default,,0,0,0,,Жоғарылаудан бас тарту
Dialogue: 0,0:21:04.95,0:21:05.66,Default,,0,0,0,,Иә
Dialogue: 0,0:21:06.66,0:21:08.74,Default,,0,0,0,,Маған себебін айта аласыз ба?
Dialogue: 0,0:21:09.04,0:21:10.25,Default,,0,0,0,,Жақында болған оқиғада
Dialogue: 0,0:21:10.45,0:21:13.17,Default,,0,0,0,,Мен өзімнің күш-қуатымның жоқтығын қатты түсіндім.
Dialogue: 0,0:21:13.46,0:21:15.42,Default,,0,0,0,,Біз әлі жоғары көтеріле алмаймыз.
Dialogue: 0,0:21:16.50,0:21:22.22,Default,,0,0,0,,Мен құтқара алатын бір ғана адам бар, мен оны құтқара алмадым.
Dialogue: 0,0:21:22.76,0:21:28.43,Default,,0,0,0,,Бұл ұсыныстан бас тартудың не екенін білесіз бе?
Dialogue: 0,0:21:28.89,0:21:30.27,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:21:33.64,0:21:34.52,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:34.77,0:21:36.98,Default,,0,0,0,,Жетекші Кирихара, тұрыңыз.
Dialogue: 0,0:21:37.23,0:21:38.40,Default,,0,0,0,,болып табылады
Dialogue: 0,0:21:43.07,0:21:45.32,Default,,0,0,0,,Бастық, бірдеңе болды.
Dialogue: 0,0:21:45.57,0:21:46.66,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:21:46.91,0:21:48.91,Default,,0,0,0,,Жоқ, әйтеуір
Dialogue: 0,0:21:49.03,0:21:50.58,Default,,0,0,0,,Ештеңе айтпа
Dialogue: 0,0:21:50.70,0:21:52.33,Default,,0,0,0,,кешіріңіз
Dialogue: 0,0:21:54.79,0:21:57.63,Default,,0,0,0,,Сайто Мен сізге арқа сүйеймін.
Dialogue: 0,0:21:57.75,0:21:59.34,Default,,0,0,0,,Не, бірдеңе дедіңіз бе?
Dialogue: 0,0:21:59.59,0:22:01.46,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:23:41.27,0:23:43.02,Default,,0,0,0,,«Тозақ қақпасы» ретінде белгілі
Dialogue: 0,0:23:43.27,0:23:44.78,Default,,0,0,0,,Біртүрлі өріс
Dialogue: 0,0:23:44.98,0:23:46.57,Default,,0,0,0,,Үзіліссіз кеңістік-уақыт
Dialogue: 0,0:23:46.78,0:23:48.11,Default,,0,0,0,,Кездейсоқ және
Dialogue: 0,0:23:48.28,0:23:50.91,Default,,0,0,0,,Бұралуға мәжбүр болатын физикалық заңдар
Dialogue: 0,0:23:51.20,0:23:53.12,Default,,0,0,0,,Жиналса да, оны жинауға болмайды.
Dialogue: 0,0:23:53.37,0:23:55.33,Default,,0,0,0,,Сұр ғылыми сандық
Dialogue: 0,0:23:56.04,0:23:56.70,Default,,0,0,0,,Адамдар
Dialogue: 0,0:23:57.04,0:23:59.71,Default,,0,0,0,,Алғанымның орнына жоғалтқаным
Dialogue: 0,0:23:59.92,0:24:01.50,Default,,0,0,0,,Көптеген өмірлер мен
Dialogue: 0,0:24:01.63,0:24:03.21,Default,,0,0,0,,Материктің бөлігі және
Dialogue: 0,0:24:03.42,0:24:05.13,Default,,0,0,0,,Нағыз жұлдызды аспан
Dialogue: 0,0:24:05.38,0:24:08.05,Default,,0,0,0,,Ал жынды болыңыз
