Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:26.06,0:02:53.06,Default,,0,0,0,,Сен
Dialogue: 0,0:04:05.04,0:04:08.01,Default,,0,0,0,,Сейканың шәкірттері сені шыбын десе де
Dialogue: 0,0:04:08.01,0:04:10.02,Default,,0,0,0,,Жарайды деуге негіз жоқ.
Dialogue: 0,0:04:10.02,0:04:12.03,Default,,0,0,0,,Кешірім сұрау
Dialogue: 0,0:04:12.03,0:04:14.03,Default,,0,0,0,,Мисаки Аюзава
Dialogue: 0,0:04:14.03,0:04:18.00,Default,,0,0,0,,Масагаокадағы студенттік кеңеске қосыла аласыз ба?
Dialogue: 0,0:04:18.00,0:04:21.00,Default,,0,0,0,,Мен бәріне кепілдік беремін.
Dialogue: 0,0:04:22.04,0:04:24.07,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:04:24.07,0:04:28.08,Default,,0,0,0,,Мұндай нәрсе «шабуыл» сияқты
Dialogue: 0,0:04:28.08,0:04:31.08,Default,,0,0,0,,Енді Усуйдің мазақ етуіне болмайды
Dialogue: 0,0:04:31.08,0:04:33.08,Default,,0,0,0,,Мен одан шаршадым
Dialogue: 0,0:04:52.02,0:04:55.05,Default,,0,0,0,,Сіз Миягаокадансыз.
Dialogue: 0,0:04:55.05,0:04:59.07,Default,,0,0,0,,Менің атым Маки, мен студенттік кеңестің вице-президентімін.
Dialogue: 0,0:04:59.07,0:05:01.09,Default,,0,0,0,,Мен үшін бірдеңе бар ма?
Dialogue: 0,0:05:01.09,0:05:05.09,Default,,0,0,0,,Сізбен бір сәт сөйлесе аламын ба?
Dialogue: 0,0:05:08.07,0:05:10.08,Default,,0,0,0,,Балалар
Dialogue: 0,0:05:10.08,0:05:12.08,Default,,0,0,0,,Иә
Dialogue: 0,0:05:13.00,0:05:15.06,Default,,0,0,0,,Төлеңіз.
Dialogue: 0,0:05:15.06,0:05:18.03,Default,,0,0,0,,Төраға Игарашидің шын жүректен шыққан сыйы.
Dialogue: 0,0:05:18.03,0:05:22.00,Default,,0,0,0,,Мұндай қымбат затты сұрауға негіз жоқ.
Dialogue: 0,0:05:22.00,0:05:24.00,Default,,0,0,0,,Төраға Игараши сізге
Dialogue: 0,0:05:24.00,0:05:28.07,Default,,0,0,0,,Сіз Масагаокаға ауысасыз деп үміттенемін.
Dialogue: 0,0:05:28.07,0:05:33.01,Default,,0,0,0,,Менің басыма осындай жағдай түссе де бармаймын. Мен оны өзіммен бірге үйге апарамын.
Dialogue: 0,0:05:33.01,0:05:38.08,Default,,0,0,0,,Бұл менің дүкенім осы күнге арнайы жасаған торт.
Dialogue: 0,0:05:38.08,0:05:40.01,Default,,0,0,0,,Оны ысырап ету ысырап болар еді.
Dialogue: 0,0:05:40.01,0:05:46.02,Default,,0,0,0,,Уайымдамаңыз, төрағаның мұндай нәрсеге өз пайдасын сатуға ниеті жоқ.
Dialogue: 0,0:05:46.02,0:05:50.06,Default,,0,0,0,,Төлеңіз.
Dialogue: 0,0:05:50.06,0:05:53.06,Default,,0,0,0,,Төраға Игараши сізбен бірге.
Dialogue: 0,0:05:53.06,0:05:56.06,Default,,0,0,0,,Мен Миягаоканы жақсырақ мектеп еткім келеді.
Dialogue: 0,0:05:56.06,0:05:58.06,Default,,0,0,0,,Бұл жай ғана.
Dialogue: 0,0:06:00.03,0:06:02.04,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:06:02.04,0:06:04.02,Default,,0,0,0,,Сана қош келдіңіз
Dialogue: 0,0:06:04.02,0:06:07.06,Default,,0,0,0,,Жек көру? белгісіз мырза
Dialogue: 0,0:06:07.06,0:06:10.06,Default,,0,0,0,,Сіз Аюзава Джуку университетінің екінші курс студентісіз бе?
Dialogue: 0,0:06:10.06,0:06:13.08,Default,,0,0,0,,Ондай ештеңе жоқ, сол жаққа барыңыз.
Dialogue: 0,0:06:13.08,0:06:15.07,Default,,0,0,0,,（）
Dialogue: 0,0:06:15.07,0:06:18.07,Default,,0,0,0,,Кешіріңіз, мен біртүрлі баламын.
Dialogue: 0,0:06:18.07,0:06:21.07,Default,,0,0,0,,Миягаокаға келсең
Dialogue: 0,0:06:21.07,0:06:26.08,Default,,0,0,0,,Төраға өзінің кіші қарындасын да Масагаокаға қолайлы шарттармен қабылдады.
Dialogue: 0,0:06:26.08,0:06:28.00,Default,,0,0,0,,Қандай жағдай болмасын, бұл мүмкін емес
Dialogue: 0,0:06:28.00,0:06:33.00,Default,,0,0,0,,Масагаокадағы Игараши Зайбатсудың әсері орасан зор.
Dialogue: 0,0:06:33.00,0:06:39.02,Default,,0,0,0,,Әпкеңнің игілігі үшін мынаны байыппен ойланшы →
Dialogue: 0,0:06:39.02,0:06:42.04,Default,,0,0,0,,Мен сені тағы 3 күн күтемін.
Dialogue: 0,0:06:42.04,0:06:46.00,Default,,0,0,0,,Бізге жақсы жауап беруіңізді сұраймыз.
Dialogue: 0,0:06:46.00,0:06:48.00,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:06:48.00,0:06:51.04,Default,,0,0,0,,Сіз келгенше төраға.
Dialogue: 0,0:06:51.04,0:06:54.04,Default,,0,0,0,,Миягаокада күту
Dialogue: 0,0:06:59.08,0:07:01.05,Default,,0,0,0,,Не болды, Мисаки?
Dialogue: 0,0:07:01.05,0:07:03.05,Default,,0,0,0,,Таң қалды, жоқ.
Dialogue: 0,0:07:03.05,0:07:06.07,Default,,0,0,0,,Мүмкін бұл жолбарыс туралы шығар? жолбарыс?
Dialogue: 0,0:07:06.07,0:07:08.00,Default,,0,0,0,,Игараши Зайбацудың мұрагері
Dialogue: 0,0:07:08.00,0:07:11.06,Default,,0,0,0,,Мен Тора Игараши, Масагаока студенттер кеңесінің президентімін.
Dialogue: 0,0:07:11.06,0:07:13.07,Default,,0,0,0,,Мисаки Мен оны Масагаокада болады деп ешқашан ойламадым.
Dialogue: 0,0:07:13.07,0:07:15.08,Default,,0,0,0,,Мен мектептерді ауыстырғым келмейді.
Dialogue: 0,0:07:15.08,0:07:17.08,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:07:17.08,0:07:19.06,Default,,0,0,0,,Сакура мен басқаларды тастамаңыз
Dialogue: 0,0:07:19.06,0:07:22.07,Default,,0,0,0,,Өйткені мен Мисакиге сүйенемін
Dialogue: 0,0:07:22.07,0:07:25.07,Default,,0,0,0,,Байқаусыз пікір жазудан аулақ болыңыз!
Dialogue: 0,0:07:25.07,0:07:27.04,Default,,0,0,0,,Ал, Мисаки-санның болашағын ойласам.
Dialogue: 0,0:07:27.04,0:07:31.08,Default,,0,0,0,,Уақытша эмоцияларға берілу дұрыс па?
Dialogue: 0,0:07:31.08,0:07:34.05,Default,,0,0,0,,Жақсы мектепте оқудың зияны жоқ.
Dialogue: 0,0:07:34.05,0:07:36.08,Default,,0,0,0,,Мисакидің болашағы?
Dialogue: 0,0:07:36.08,0:07:39.07,Default,,0,0,0,,Мисаки мен Тораға ауыссам ше?
Dialogue: 0,0:07:39.07,0:07:41.07,Default,,0,0,0,,Махаббат өссе
Dialogue: 0,0:07:41.07,0:07:43.07,Default,,0,0,0,,Мисаки жолбарыстың әйелі ме?
Dialogue: 0,0:07:43.07,0:07:47.07,Default,,0,0,0,,Игараши Зайбацудың атақты әйелі.
Dialogue: 0,0:07:48.08,0:07:52.00,Default,,0,0,0,,（） →
Dialogue: 0,0:07:52.00,0:07:54.05,Default,,0,0,0,,Бұл керемет емес пе?
Dialogue: 0,0:07:54.05,0:07:57.03,Default,,0,0,0,,Өйткені, әлемге әйгілі мектеп Масагаока даши
Dialogue: 0,0:07:57.03,0:08:01.01,Default,,0,0,0,,Әдетте сіз бас тартпайсыз. (Судо) Бас тартуға ешқандай себеп жоқ.
Dialogue: 0,0:08:01.01,0:08:08.01,Default,,0,0,0,,Егер төраға жоқ болса, біз бұрынғыдай қалағанымызды жасай аламыз.
Dialogue: 0,0:08:09.03,0:08:12.03,Default,,0,0,0,,Балалар, бұлай айта алмайсыңдар.
Dialogue: 0,0:08:12.03,0:08:14.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:14.04,0:08:17.02,Default,,0,0,0,,Төраға Масагаокамен төбелесіп қалғанда да
Dialogue: 0,0:08:17.02,0:08:19.02,Default,,0,0,0,,Ол бізге сенді, бізді қорғады.
Dialogue: 0,0:08:19.02,0:08:21.04,Default,,0,0,0,,Біз туралы қаншалықты?
Dialogue: 0,0:08:21.04,0:08:24.04,Default,,0,0,0,,Ойланып жатырсың ба? Түсінесіз бе?
Dialogue: 0,0:08:27.06,0:08:29.03,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:08:29.03,0:08:33.00,Default,,0,0,0,,Бірақ егер төраға Масагаокаға барғысы келетінін айтса.
Dialogue: 0,0:08:33.00,0:08:36.00,Default,,0,0,0,,Біз сізді тоқтата алмаймыз.
Dialogue: 0,0:08:37.04,0:08:40.08,Default,,0,0,0,,Мен көптен бері демалдым.
Dialogue: 0,0:08:40.08,0:08:42.08,Default,,0,0,0,,Күлге айналды.
Dialogue: 0,0:08:42.08,0:08:44.03,Default,,0,0,0,,Жинақталған жұмысты аяқтауым керек.
Dialogue: 0,0:08:44.03,0:08:46.03,Default,,0,0,0,,Усуй-сан! ?
Dialogue: 0,0:08:48.07,0:08:50.09,Default,,0,0,0,,Түсінуім үшін неше рет айту керек?
Dialogue: 0,0:08:50.09,0:08:53.06,Default,,0,0,0,,Мақсатыңыз болмаса да, студенттік кеңес бөлмесіне кірмеңіз.
Dialogue: 0,0:08:53.06,0:08:55.08,Default,,0,0,0,,Юкимура қорқады, солай ма?
Dialogue: 0,0:08:55.08,0:09:00.08,Default,,0,0,0,,Менің бір ісім бар. Мен не істеуім керек, Масагаока?
Dialogue: 0,0:09:00.08,0:09:03.08,Default,,0,0,0,,Мен Сейка орта мектебінің студенттер кеңесінің президентімін.
Dialogue: 0,0:09:03.08,0:09:06.07,Default,,0,0,0,,Мен кеткенде, Сейка...
Dialogue: 0,0:09:06.07,0:09:08.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:08.07,0:09:13.07,Default,,0,0,0,,Сен сияқты аңдыушыдан құтылғаным жақсы болар.
Dialogue: 0,0:09:14.08,0:09:17.00,Default,,0,0,0,,Миягаокаға көшу деген нені білдіреді?
Dialogue: 0,0:09:17.00,0:09:20.00,Default,,0,0,0,,Мен жоқта не болды?
Dialogue: 0,0:09:22.04,0:09:24.04,Default,,0,0,0,,Анаң ше?
Dialogue: 0,0:09:24.04,0:09:26.04,Default,,0,0,0,,Маған ауруханадан қоңырау түсті.
Dialogue: 0,0:09:26.04,0:09:30.01,Default,,0,0,0,,Мен кенеттен кеш ауысымға ауысуға тура келді.
Dialogue: 0,0:09:30.01,0:09:32.00,Default,,0,0,0,,Мен сізге қатты итермеңіз дедім.
Dialogue: 0,0:09:32.00,0:09:35.00,Default,,0,0,0,,Екі қызын жалғыз өзі тәрбиелеп отыр.
Dialogue: 0,0:09:35.00,0:09:38.00,Default,,0,0,0,,Тіпті мүмкін емес нәрсені істеу керек болса да...
Dialogue: 0,0:09:38.00,0:09:40.00,Default,,0,0,0,,Шын мәнінде, дұрыс, бірақ
Dialogue: 0,0:09:40.00,0:09:42.09,Default,,0,0,0,,（）
Dialogue: 0,0:09:42.09,0:09:45.06,Default,,0,0,0,,Мұндай тойға не бар?
Dialogue: 0,0:09:45.06,0:09:47.03,Default,,0,0,0,,Миягаока жігіттері тағы да осында!
Dialogue: 0,0:09:47.03,0:09:51.03,Default,,0,0,0,,Жоқ, мен бәрін жасадым.
Dialogue: 0,0:09:59.01,0:10:01.09,Default,,0,0,0,,Мұның бәрі әзіл. Бұл керемет.
Dialogue: 0,0:10:01.09,0:10:04.06,Default,,0,0,0,,Окара арзан әрі құнарлы.
Dialogue: 0,0:10:04.06,0:10:07.05,Default,,0,0,0,,Мен кедей болғандықтан, ас әзірлеуде шығармашылықпен айналысуым керек.
Dialogue: 0,0:10:07.05,0:10:10.08,Default,,0,0,0,,Санаға көп күш салғаным үшін кешіріңіз.
Dialogue: 0,0:10:10.08,0:10:12.00,Default,,0,0,0,,Бұл сенің апаңның кінәсі емес.
Dialogue: 0,0:10:12.00,0:10:14.00,Default,,0,0,0,,Қашып кеткен әкемнің кесірінен.
Dialogue: 0,0:10:14.00,0:10:16.09,Default,,0,0,0,,Ал тамақ әзірлеу қызық.
Dialogue: 0,0:10:16.09,0:10:19.09,Default,,0,0,0,,Итадакимасу Итадакимасу
Dialogue: 0,0:10:22.06,0:10:24.06,Default,,0,0,0,,Сақ бол.
Dialogue: 0,0:10:25.08,0:10:29.07,Default,,0,0,0,,Эй, Сана, Масагаока академиясына барғың келмей ме?
Dialogue: 0,0:10:29.07,0:10:33.01,Default,,0,0,0,,Иә? Бұл бай және ақылды адамдарға арналған мектеп, солай ма?
Dialogue: 0,0:10:33.01,0:10:35.04,Default,,0,0,0,,Бара алсаң ше?
Dialogue: 0,0:10:35.04,0:10:40.05,Default,,0,0,0,,Егер менде мұндай ақша болса, мен нағыз патша крабын сатып алар едім. Неліктен?
Dialogue: 0,0:10:40.05,0:10:43.05,Default,,0,0,0,,Жоқ, мен жай сұрадым.
Dialogue: 0,0:10:45.04,0:10:47.04,Default,,0,0,0,,Сонда да бәрінің дәмі окара сияқты.
Dialogue: 0,0:10:47.04,0:10:52.01,Default,,0,0,0,,Десертке бізде Аюзава Джуку әкелген ең жоғары сапалы торт бар.
Dialogue: 0,0:10:52.01,0:10:55.01,Default,,0,0,0,,Сондықтан бұл Аюзава Джуку емес.
Dialogue: 0,0:11:51.02,0:11:52.04,Default,,0,0,0,,Мисаки қазірдің өзінде
Dialogue: 0,0:11:52.04,0:11:55.01,Default,,0,0,0,,Қызық, қайда кетті?
Dialogue: 0,0:11:55.01,0:11:59.09,Default,,0,0,0,,Мисаки-сан ондай нәрсеге бармайды деп ойлаймын.→
Dialogue: 0,0:11:59.09,0:12:01.01,Default,,0,0,0,,Шынымды айтсам, мен де бұлай істеуден аулақ болғым келеді.
Dialogue: 0,0:12:01.01,0:12:05.00,Default,,0,0,0,,Қалай болғанда да, сіз Шидзуконы көргенде, сізге ұнайтыны сөзсіз.
Dialogue: 0,0:12:05.00,0:12:08.00,Default,,0,0,0,,Қараңызшы, бұл керемет.
Dialogue: 0,0:12:08.00,0:12:10.07,Default,,0,0,0,,Сіз әйелсіз бе? Не?
Dialogue: 0,0:12:10.07,0:12:12.06,Default,,0,0,0,,u×missi?
Dialogue: 0,0:12:12.06,0:12:16.06,Default,,0,0,0,,Бұл «Юмемиши». Сіз әдейі қателеспегеніңізге сенімдісіз бе?
Dialogue: 0,0:12:16.06,0:12:18.01,Default,,0,0,0,,Жоқ, мені қызықтырмайды.
Dialogue: 0,0:12:18.01,0:12:20.05,Default,,0,0,0,,Қазір қоңырау шалайық
Dialogue: 0,0:12:20.05,0:12:22.00,Default,,0,0,0,,...
Dialogue: 0,0:12:22.00,0:12:24.08,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:12:24.08,0:12:26.08,Default,,0,0,0,,- Миягаокаға келу
Dialogue: 0,0:12:28.00,0:12:32.06,Default,,0,0,0,,...
Dialogue: 0,0:12:32.06,0:12:35.06,Default,,0,0,0,,Сакура кешіріңіз, бірақ мен сізге кейінірек қайта қоңырау шаламын.
Dialogue: 0,0:12:35.06,0:12:37.06,Default,,0,0,0,,...
Dialogue: 0,0:13:55.06,0:13:57.06,Default,,0,0,0,,Ах Мисаки?
Dialogue: 0,0:13:57.06,0:13:59.06,Default,,0,0,0,,(Жауап беруші)
Dialogue: 0,0:13:59.06,0:14:01.06,Default,,0,0,0,,Мисаки-сан, бұл не?
Dialogue: 0,0:14:01.06,0:14:03.07,Default,,0,0,0,,Жоқ, ол жұмыс істемейді.
Dialogue: 0,0:14:03.07,0:14:06.07,Default,,0,0,0,,Сонда сіз Масагаока академиясына барасыз ба?
Dialogue: 0,0:14:06.07,0:14:09.02,Default,,0,0,0,,Мисаки, сен не істеуді жоспарлап отырсың?
Dialogue: 0,0:14:09.02,0:14:14.06,Default,,0,0,0,,Неліктен мұндай маңызды нәрселерді өзіңіз шешесіз?
Dialogue: 0,0:14:14.06,0:14:17.01,Default,,0,0,0,,《Уайымдама, мен бұл туралы бірдеңе істеймін》
Dialogue: 0,0:14:17.01,0:14:21.07,Default,,0,0,0,,《Жақсы мектепте оқудың зияны жоқ.》
Dialogue: 0,0:14:21.07,0:14:23.00,Default,,0,0,0,,《Мисаки жолбарыстың әйелі ме? →》
Dialogue: 0,0:14:23.00,0:14:26.04,Default,,0,0,0,,《Ол сонымен қатар Игараши Зайбатсудың атақты әйелі》
Dialogue: 0,0:14:26.04,0:14:31.09,Default,,0,0,0,,《Жарайды, Мисаки-сан міндетті түрде бірдеңе жасайды.》
Dialogue: 0,0:14:31.09,0:14:35.00,Default,,0,0,0,,Рас, біз тек Мисаки-санға сүйенеміз.
Dialogue: 0,0:14:35.00,0:14:38.02,Default,,0,0,0,,Мисакидің сезімі туралы ештеңе естімедім.
Dialogue: 0,0:14:38.02,0:14:41.04,Default,,0,0,0,,Сіз маңызды ештеңе айтқан жоқсыз.
Dialogue: 0,0:14:41.04,0:14:43.04,Default,,0,0,0,,Шидзуко шынымен жақсы ма?
Dialogue: 0,0:14:43.04,0:14:48.09,Default,,0,0,0,,Мисаки Масагаокаға барса да, өзіңді жалғыз сезінбейсің бе?
Dialogue: 0,0:14:48.09,0:14:51.01,Default,,0,0,0,,Сакура-сан, Мисаки-санды қайтарып алғыңыз келсе
Dialogue: 0,0:14:51.01,0:14:54.07,Default,,0,0,0,,Миягаокаға да жеңілме
Dialogue: 0,0:14:54.07,0:14:57.07,Default,,0,0,0,,Мұқият орындайық Иә.
Dialogue: 0,0:15:01.04,0:15:04.03,Default,,0,0,0,,Жақсы көңіл-күй Анаң қалай?
Dialogue: 0,0:15:04.03,0:15:07.05,Default,,0,0,0,,Иә, келесі демалыста қайда барасыз?
Dialogue: 0,0:15:11.04,0:15:14.04,Default,,0,0,0,,〈Атмосфера менікінен мүлде басқаша〉
Dialogue: 0,0:15:17.01,0:15:20.03,Default,,0,0,0,,Сейка орта мектебінің президенті Мисаки Аюзава келді.
Dialogue: 0,0:15:20.03,0:15:24.03,Default,,0,0,0,,Ең болмаса, мен оны құптайтын едім.
Dialogue: 0,0:15:24.03,0:15:26.03,Default,,0,0,0,,Бұл менің бірінші рет.
Dialogue: 0,0:15:26.03,0:15:30.07,Default,,0,0,0,,Төраға қандай әйелге сонша көңіл бөледі?
Dialogue: 0,0:15:30.07,0:15:34.07,Default,,0,0,0,,Маки, сен мені қанағаттандыра алатын әйелсің бе?
Dialogue: 0,0:15:34.07,0:15:37.07,Default,,0,0,0,,Сіз ол жерде жоқ деп ойлайсыз.
Dialogue: 0,0:15:40.08,0:15:43.08,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:15:54.08,0:15:57.08,Default,,0,0,0,,(есік тұтқасы бұрылады)
Dialogue: 0,0:16:10.04,0:16:15.00,Default,,0,0,0,,Төраға Аюзава, мен сіздің келетініңізге сенімді болдым.
Dialogue: 0,0:16:15.00,0:16:17.00,Default,,0,0,0,,Төраға Игараши
Dialogue: 0,0:16:17.00,0:16:22.07,Default,,0,0,0,,Жақсы жауап аласыз деп үміттенемін.
Dialogue: 0,0:16:22.07,0:16:24.07,Default,,0,0,0,,Бұл туралы...
Dialogue: 0,0:16:29.00,0:16:32.03,Default,,0,0,0,,（）
Dialogue: 0,0:16:32.03,0:16:34.07,Default,,0,0,0,,Бүгін
Dialogue: 0,0:16:34.07,0:16:37.02,Default,,0,0,0,,Широянның туған күні болса да
Dialogue: 0,0:16:37.02,0:16:38.06,Default,,0,0,0,,Тойлауларыңызды қалаймын~
Dialogue: 0,0:16:38.06,0:16:41.04,Default,,0,0,0,,Жүр, Куротацу, енді менің қолымнан келмейді.
Dialogue: 0,0:16:41.04,0:16:44.04,Default,,0,0,0,,Ақ! Мықты бол
Dialogue: 0,0:16:47.00,0:16:49.02,Default,,0,0,0,,...
Dialogue: 0,0:16:49.02,0:16:52.00,Default,,0,0,0,,Мен Миса Чан бола алмаймын, бірақ
Dialogue: 0,0:16:52.00,0:16:55.04,Default,,0,0,0,,Хонока және басқалары тойлай алады ма?
Dialogue: 0,0:16:55.04,0:16:57.06,Default,,0,0,0,,Біз де торт дайындадық.
Dialogue: 0,0:16:57.06,0:17:01.01,Default,,0,0,0,,Мен Мэйд Латтенің туған күніне арналған тортын жасадым.
Dialogue: 0,0:17:01.01,0:17:06.01,Default,,0,0,0,,Ештеңе етпейді, тек менің сүйікті күйеуімнің қызметі.
Dialogue: 0,0:17:08.00,0:17:10.05,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:17:10.05,0:17:13.07,Default,,0,0,0,,Бірақ «Үш ақымақ» деп жазылған сияқты
Dialogue: 0,0:17:13.07,0:17:16.07,Default,,0,0,0,,Күрделі~ Тегін болса жақсы
Dialogue: 0,0:17:17.08,0:17:20.00,Default,,0,0,0,,Кешіріңіз, иә?
Dialogue: 0,0:17:20.00,0:17:22.03,Default,,0,0,0,,Кешіріңіз, кенет Шидзуко
Dialogue: 0,0:17:22.03,0:17:27.00,Default,,0,0,0,,（）
Dialogue: 0,0:17:27.00,0:17:30.07,Default,,0,0,0,,Не? Мисаки қазір жалғыз
Dialogue: 0,0:17:30.07,0:17:33.08,Default,,0,0,0,,Төраға Миягаокаға отыра ма?
Dialogue: 0,0:17:33.08,0:17:37.08,Default,,0,0,0,,Мисаки Масагаокаға ауысуды жоспарласа.
Dialogue: 0,0:17:37.08,0:17:41.02,Default,,0,0,0,,Оны тоқтатпағанымызға да өзіміз кінәлі.
Dialogue: 0,0:17:41.02,0:17:44.07,Default,,0,0,0,,Мүмкін мен өзімшіл болып жатқан шығармын
Dialogue: 0,0:17:44.07,0:17:47.07,Default,,0,0,0,,Мен Мисакидің Сейкада қалғанын қалаймын.
Dialogue: 0,0:17:47.07,0:17:49.08,Default,,0,0,0,,Бәрі де солай емес пе?
Dialogue: 0,0:17:49.08,0:17:53.06,Default,,0,0,0,,Төраға Аюзавадан басқа президент туралы ойлай алмаймын.
Dialogue: 0,0:17:53.06,0:17:56.06,Default,,0,0,0,,Төрағаны алайық!
Dialogue: 0,0:17:58.03,0:18:00.05,Default,,0,0,0,,Біз де барамыз, о
Dialogue: 0,0:18:00.05,0:18:04.05,Default,,0,0,0,,Кеттік, бәріміз (бәрі).
Dialogue: 0,0:18:05.01,0:18:08.08,Default,,0,0,0,,Бай мектептен күткендей.
Dialogue: 0,0:18:08.08,0:18:12.07,Default,,0,0,0,,Студенттік кеңес бөлмесінің жанында душ бөлмесінің болуы қалыпты жағдай емес.
Dialogue: 0,0:18:12.07,0:18:14.08,Default,,0,0,0,,Дәлірек айтқанда, мен неге
Dialogue: 0,0:18:14.08,0:18:17.08,Default,,0,0,0,,Осылай болды ма деп ойлаймын!
Dialogue: 0,0:18:21.07,0:18:24.08,Default,,0,0,0,,Жоқ, мен оны осында қойғаныма сенімдімін.
Dialogue: 0,0:18:24.08,0:18:26.08,Default,,0,0,0,,Бұл басқа шкаф болды ма?
Dialogue: 0,0:18:26.08,0:18:28.08,Default,,0,0,0,,Тіпті мұнда емес!
Dialogue: 0,0:18:29.08,0:18:31.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:31.08,0:18:33.04,Default,,0,0,0,,（）
Dialogue: 0,0:18:33.04,0:18:36.01,Default,,0,0,0,,Формамды таба алмай жүрмін.
Dialogue: 0,0:18:36.01,0:18:39.01,Default,,0,0,0,,Сонда ол дақ болуы керек.
Dialogue: 0,0:18:39.01,0:18:42.00,Default,,0,0,0,,Мен қыздан оны тазалаушыға апаруын өтіндім.
Dialogue: 0,0:18:42.00,0:18:44.00,Default,,0,0,0,,Сонымен не киюім керек...
Dialogue: 0,0:18:44.00,0:18:47.05,Default,,0,0,0,,О? Сізде дайын ауыстыру бар ма?
Dialogue: 0,0:18:47.05,0:18:49.04,Default,,0,0,0,,〈Мұны кигенімді қалайсың ба? 〉
Dialogue: 0,0:18:49.04,0:18:51.04,Default,,0,0,0,,Не болды, Аюзава мырза?
Dialogue: 0,0:18:51.04,0:18:54.04,Default,,0,0,0,,Бұл терінің сәл тым көп екенін көрсетеді.
Dialogue: 0,0:18:54.04,0:18:58.05,Default,,0,0,0,,Мүмкін сіз душта абайсызда күйіп қалған шығарсыз?
Dialogue: 0,0:18:58.05,0:19:03.00,Default,,0,0,0,,Бірақ сіз оны киіміңізбен жасырып жатқан жоқсыз ба?
Dialogue: 0,0:19:03.00,0:19:05.02,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:19:05.02,0:19:09.07,Default,,0,0,0,,Немесе сырғып құлау.
Dialogue: 0,0:19:09.07,0:19:12.06,Default,,0,0,0,,Қалай болғанда да, сіз жарақат алған жоқсыз ба?
Dialogue: 0,0:19:12.06,0:19:14.09,Default,,0,0,0,,Жоқ, сондықтан мен кіремін.
Dialogue: 0,0:19:14.09,0:19:16.01,Default,,0,0,0,,Бір минут күтіңіз...
Dialogue: 0,0:19:16.01,0:19:20.00,Default,,0,0,0,,Жоқ... Жарайды. Мен зардап шеккен жоқпын.
Dialogue: 0,0:19:20.00,0:19:22.02,Default,,0,0,0,,Сіз ренжідіңіз, солай емес пе?
Dialogue: 0,0:19:22.02,0:19:24.00,Default,,0,0,0,,Әйтеуір, киімімнен ұялып қалдым.
Dialogue: 0,0:19:24.00,0:19:27.01,Default,,0,0,0,,Тағы да, бұл өтірік өтірік емес.
Dialogue: 0,0:19:27.01,0:19:30.08,Default,,0,0,0,,Олай болса, маған қауіпсіз екеніңді көрсет.
Dialogue: 0,0:19:30.08,0:19:34.06,Default,,0,0,0,,Мен мұны киіп, сыртқа шығамын, сондықтан 10 секунд күтіңіз.
Dialogue: 0,0:19:34.06,0:19:37.02,Default,,0,0,0,,10 секунд 10 9
Dialogue: 0,0:19:37.02,0:19:39.05,Default,,0,0,0,,8 7
Dialogue: 0,0:19:39.05,0:19:42.09,Default,,0,0,0,,6 5…
Dialogue: 0,0:19:45.08,0:19:48.06,Default,,0,0,0,,2 1
Dialogue: 0,0:19:48.06,0:19:50.06,Default,,0,0,0,,Нөл
Dialogue: 0,0:19:52.00,0:19:55.00,Default,,0,0,0,,Форманы қайтаруыңызды өтінемін!
Dialogue: 0,0:19:58.06,0:20:02.02,Default,,0,0,0,,Қорқынышты, біртүрлі, біртүрлі, солай ма? Сондықтан мен айттым.
Dialogue: 0,0:20:02.02,0:20:06.02,Default,,0,0,0,,Менің ойымша, сіз тамаша киінген сияқтысыз.
Dialogue: 0,0:20:09.08,0:20:11.05,Default,,0,0,0,,Формаңызды лас қалдырудың қажеті жоқ.
Dialogue: 0,0:20:11.05,0:20:16.01,Default,,0,0,0,,Бұл ысырап. Бұл сізге шынымен жарасады.
Dialogue: 0,0:20:16.01,0:20:19.01,Default,,0,0,0,,Өзіңіз де солай ойламайсыз ба?
Dialogue: 0,0:20:22.06,0:20:25.06,Default,,0,0,0,,Сізге мұндай нәрсе ұнайды, солай ма?
Dialogue: 0,0:20:27.03,0:20:29.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:30.04,0:20:36.03,Default,,0,0,0,,Мектепте осылай толық емес жұмыс күнін таңдаған қыздың жиіркеніштісі.
Dialogue: 0,0:20:36.03,0:20:38.03,Default,,0,0,0,,Сіз өте күлкілісіз
Dialogue: 0,0:20:42.07,0:20:46.07,Default,,0,0,0,,Бұл ысырап, сыртта адам көп, мен өзімді ұстаймын.
Dialogue: 0,0:20:48.00,0:20:50.04,Default,,0,0,0,,Әзірге.
Dialogue: 0,0:20:50.04,0:20:52.04,Default,,0,0,0,,Мұнда кел!
Dialogue: 0,0:20:52.04,0:20:55.08,Default,,0,0,0,,Ол сондай болды.
Dialogue: 0,0:20:55.08,0:20:57.03,Default,,0,0,0,,Мен оны мүлде байқамадым
Dialogue: 0,0:20:57.03,0:20:59.07,Default,,0,0,0,,Сезімсіз деп ойламаймын.
Dialogue: 0,0:20:59.07,0:21:01.07,Default,,0,0,0,,Мен оны басынан байқадым.
Dialogue: 0,0:21:01.07,0:21:03.09,Default,,0,0,0,,〈Жаман мінез〉
Dialogue: 0,0:21:03.09,0:21:07.06,Default,,0,0,0,,Бірақ оның оңай құлап кеткеніне шынымды айтсам көңілім қалды.
Dialogue: 0,0:21:07.06,0:21:11.06,Default,,0,0,0,,Мен оны әлдеқайда күшті әйел деп ойладым.
Dialogue: 0,0:21:11.06,0:21:14.03,Default,,0,0,0,,Қызметші болған кезде студенттік кеңестің төрағасы болып жұмыс істейтін әйел.
Dialogue: 0,0:21:14.03,0:21:19.00,Default,,0,0,0,,Мен олардың Миягаока туралы бірдеңе жасайтынын асыға күтемін.
Dialogue: 0,0:21:19.00,0:21:21.04,Default,,0,0,0,,Күте тұрыңыз, мен бір нәрсені дұрыс түсінбедім...
Dialogue: 0,0:21:21.04,0:21:24.04,Default,,0,0,0,,Уайымдамаңыз, бұл жеткілікті.
Dialogue: 0,0:21:26.01,0:21:30.05,Default,,0,0,0,,Егер бұл жеткіліксіз болса, мені одан да қызықтырыңыз.
Dialogue: 0,0:21:30.05,0:21:34.00,Default,,0,0,0,,Көңілді ме? Ол Игараши Зайбацудың келесі жетекшісі.
Dialogue: 0,0:21:34.00,0:21:37.07,Default,,0,0,0,,Мен үшін дәл осы атау
Dialogue: 0,0:21:37.07,0:21:39.07,Default,,0,0,0,,Маған көбірек әйелдер келеді
Dialogue: 0,0:21:39.07,0:21:42.08,Default,,0,0,0,,Мен мойынсұнғыш әйел болудан шаршадым.
Dialogue: 0,0:21:42.08,0:21:45.08,Default,,0,0,0,,Мен сенен үлкен үміт күттім.
Dialogue: 0,0:21:47.03,0:21:51.07,Default,,0,0,0,,Сен де ақшаның арбауына түсіп осында келдің.
Dialogue: 0,0:21:51.07,0:21:53.05,Default,,0,0,0,,Мен олардан өзгере алмаймын.
Dialogue: 0,0:21:53.05,0:21:56.05,Default,,0,0,0,,Қандай ақымақ әйел
Dialogue: 0,0:21:58.01,0:22:00.09,Default,,0,0,0,,Бейшара жігіт.
Dialogue: 0,0:22:00.09,0:22:04.06,Default,,0,0,0,,Сіз әрқашан осындай адамдарды менсіндіңіз бе?
Dialogue: 0,0:22:04.06,0:22:08.07,Default,,0,0,0,,Айналаңыздағы адамдар сұмдық болса
Dialogue: 0,0:22:08.07,0:22:10.07,Default,,0,0,0,,Бұл сенің кінәң.
Dialogue: 0,0:22:10.07,0:22:12.04,Default,,0,0,0,,Бұл дүниеде түкке тұрғысыз адам жоқ.
Dialogue: 0,0:22:12.04,0:22:14.04,Default,,0,0,0,,Бір емес!
Dialogue: 0,0:22:17.01,0:22:19.05,Default,,0,0,0,,Бүгін мен келдім
Dialogue: 0,0:22:19.05,0:22:21.06,Default,,0,0,0,,Миягаокаға шақырудан бас тарту
Dialogue: 0,0:22:21.06,0:22:23.03,Default,,0,0,0,,Тек соны айту үшін.
Dialogue: 0,0:22:23.03,0:22:28.03,Default,,0,0,0,,Менің Seika төрағасы қызметінен кететін ойым жоқ!
Dialogue: 0,0:22:31.01,0:22:33.01,Default,,0,0,0,,Күтілгендей, сіз
Dialogue: 0,0:22:34.01,0:22:36.01,Default,,0,0,0,,Қызықты
Dialogue: 0,0:22:38.01,0:22:41.08,Default,,0,0,0,,Мудая, егер сіз Айкидо болсаңыз
Dialogue: 0,0:22:41.08,0:22:43.07,Default,,0,0,0,,Себебі мен дзюдомен айналысамын
Dialogue: 0,0:22:43.07,0:22:45.07,Default,,0,0,0,,Ол жердегі шайқаста жақсы.
Dialogue: 0,0:22:46.07,0:22:48.07,Default,,0,0,0,,Эй, тоқта...
Dialogue: 0,0:22:57.03,0:22:59.03,Default,,0,0,0,,Ух... Суй
Dialogue: 0,0:23:01.02,0:23:03.02,Default,,0,0,0,,Иә, бәрі осы.
Dialogue: 0,0:23:04.01,0:23:06.01,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:23:07.01,0:23:09.01,Default,,0,0,0,,Сырттағылар ше?
Dialogue: 0,0:23:09.01,0:23:14.08,Default,,0,0,0,,Олар мені кіргізбеді, сондықтан мен аздап жамандық жасадым.
Dialogue: 0,0:23:14.08,0:23:16.02,Default,,0,0,0,,Кешіріңіз~
Dialogue: 0,0:23:16.02,0:23:20.09,Default,,0,0,0,,Олар бұдан да нашар.
Dialogue: 0,0:23:20.09,0:23:22.08,Default,,0,0,0,,Ей, бұзық жігіт
Dialogue: 0,0:23:22.08,0:23:24.08,Default,,0,0,0,,Иә, батыл болма.
Dialogue: 0,0:23:24.08,0:23:26.06,Default,,0,0,0,,Қалай болса да.
Dialogue: 0,0:23:26.06,0:23:29.06,Default,,0,0,0,,Басқа адамды тауып бере аласыз ба?
Dialogue: 0,0:23:32.09,0:23:34.02,Default,,0,0,0,,Бұл жігіт өте оңай
Dialogue: 0,0:23:34.02,0:23:36.04,Default,,0,0,0,,Ол қол тигізетін әйел емес
Dialogue: 0,0:23:36.04,0:23:38.04,Default,,0,0,0,,Сіз айтасыз!
Dialogue: 0,0:23:38.04,0:23:42.01,Default,,0,0,0,,Олай болса, кеттік, төраға.
Dialogue: 0,0:23:42.01,0:23:44.01,Default,,0,0,0,,Сәл күте тұрыңыз...
Dialogue: 0,0:23:46.02,0:23:48.07,Default,,0,0,0,,Төраға Игараши
Dialogue: 0,0:23:48.07,0:23:52.09,Default,,0,0,0,,Менің Сейка орта мектебінің студенттер кеңесінің президенті болғаным дұрыс болса.
Dialogue: 0,0:23:52.09,0:23:55.01,Default,,0,0,0,,Сізбен кез келген уақытта сөйлесейік
Dialogue: 0,0:23:55.01,0:23:57.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:24:00.08,0:24:02.06,Default,,0,0,0,,Усуй, сен мұнда неге келдің?
Dialogue: 0,0:24:02.06,0:24:05.07,Default,,0,0,0,,Төраға, мені әлгі бұзақы алдап жатыр.
Dialogue: 0,0:24:05.07,0:24:08.00,Default,,0,0,0,,Ал сен мені осылай атадың.
Dialogue: 0,0:24:08.00,0:24:10.02,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:24:10.02,0:24:13.02,Default,,0,0,0,,Мен сізге қоңырау шалған жоқпын...
Dialogue: 0,0:24:17.00,0:24:21.00,Default,,0,0,0,,《Мен Seika төрағасы қызметінен кететін ойым жоқ! 》
Dialogue: 0,0:24:23.07,0:24:26.07,Default,,0,0,0,,Бірақ жақсы
Dialogue: 0,0:24:30.04,0:24:32.04,Default,,0,0,0,,А, мен оны білдім бе?
Dialogue: 0,0:24:34.00,0:24:36.02,Default,,0,0,0,,Усуи
Dialogue: 0,0:24:36.02,0:24:39.02,Default,,0,0,0,,Ах, рахмет.
Dialogue: 0,0:24:45.02,0:24:47.08,Default,,0,0,0,,Мен формамды қайтарып алдым.
Dialogue: 0,0:24:47.08,0:24:50.01,Default,,0,0,0,,Мата мен тігін бұйымдары Миягаоканың ең жоғары сапасы
Dialogue: 0,0:24:50.01,0:24:54.00,Default,,0,0,0,,Қайсысы жақсы, төраға үнемі киетін Сейка?
Dialogue: 0,0:24:54.00,0:24:57.00,Default,,0,0,0,,Оны тез қайтарыңыз! Менің ойымша, бұл солай
Dialogue: 0,0:25:06.06,0:25:08.08,Default,,0,0,0,,Төраға
Dialogue: 0,0:25:08.08,0:25:10.08,Default,,0,0,0,,Мастер~
Dialogue: 0,0:25:13.02,0:25:15.00,Default,,0,0,0,,Балалар
Dialogue: 0,0:25:15.00,0:25:18.07,Default,,0,0,0,,Мисаки-сан Мисаки~
Dialogue: 0,0:25:18.07,0:25:21.08,Default,,0,0,0,,Мен аудару туралы өтініштен үзілді-кесілді бас тарттым.
Dialogue: 0,0:25:21.08,0:25:23.05,Default,,0,0,0,,Барлығыңызға сенімді болыңыз.
Dialogue: 0,0:25:23.05,0:25:25.05,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:25:26.00,0:25:30.00,Default,,0,0,0,,Неліктен Усуй?
Dialogue: 0,0:25:37.04,0:25:40.04,Default,,0,0,0,,Хонма Оморои әйелі
Dialogue: 0,0:25:45.02,0:26:29.02,Default,,0,0,0,,Сен
Dialogue: 0,0:26:30.52,0:26:35.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
