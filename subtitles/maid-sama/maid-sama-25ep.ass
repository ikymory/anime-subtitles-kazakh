Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.13,0:01:06.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:07.49,0:02:42.94,Default,,0000,0000,0000,,
Dialogue: 0,0:03:44.23,0:03:46.41,Default,,0000,0000,0000,,《(Мисаки) қазірдің өзінде》
Dialogue: 0,0:03:46.41,0:03:50.29,Default,,0000,0000,0000,,《Неге бәрінің келгенін қаламаймын дедің? 》
Dialogue: 0,0:03:50.29,0:03:52.31,Default,,0000,0000,0000,,《Осындай күйзелдім》
Dialogue: 0,0:03:52.31,0:03:56.68,Default,,0000,0000,0000,,《Сен барлығының сені шығарып салғанын шынымен қаладың, солай ма?》
Dialogue: 0,0:03:56.68,0:03:59.68,Default,,0000,0000,0000,,《Ой, оған көмектесу мүмкін емес》
Dialogue: 0,0:04:01.23,0:04:03.25,Default,,0000,0000,0000,,《Иә, мен саған мынаны беремін》
Dialogue: 0,0:04:03.25,0:04:07.12,Default,,0000,0000,0000,,《Сондықтан мен енді ондай бетті жасамаймын》
Dialogue: 0,0:04:07.12,0:04:10.12,Default,,0000,0000,0000,,《Сау бол, Йо-кун》
Dialogue: 0,0:04:59.14,0:05:02.68,Default,,0000,0000,0000,,Хината, ашулансаң да қорықпайсың ба?
Dialogue: 0,0:05:02.68,0:05:05.68,Default,,0000,0000,0000,,Не? Өйткені бұл Мисаки-чан.
Dialogue: 0,0:05:06.21,0:05:08.23,Default,,0000,0000,0000,,Олар қайтадан атлетикалық клубтан ба?
Dialogue: 0,0:05:08.23,0:05:12.78,Default,,0000,0000,0000,,Мектеп ғимаратына кірер алдында балшықты жуып алу үшін соншалықты сақ болғаныммен.
Dialogue: 0,0:05:12.78,0:05:14.30,Default,,0000,0000,0000,,Жасыру!
Dialogue: 0,0:05:14.30,0:05:18.30,Default,,0000,0000,0000,,Қараңызшы, жындар тозақпен байланысып жатыр.
Dialogue: 0,0:05:24.06,0:05:27.93,Default,,0000,0000,0000,,Уау, бұл өте азап.
Dialogue: 0,0:05:27.93,0:05:29.28,Default,,0000,0000,0000,,Мисаки-чан, қаш!
Dialogue: 0,0:05:29.28,0:05:33.65,Default,,0000,0000,0000,,Кеттік. Егер сені қазір жын ұстаса, сені ешбір ерекшеліксіз тозаққа апарады.
Dialogue: 0,0:05:33.65,0:05:35.67,Default,,0000,0000,0000,,Мисаки-чан Гигигигигин!
Dialogue: 0,0:05:35.67,0:05:38.04,Default,,0000,0000,0000,,Айтыңызшы, сіз неге президентсіз?
Dialogue: 0,0:05:38.04,0:05:43.04,Default,,0000,0000,0000,,Бұрын жақсы болған деген қауесет бар, бірақ қазір олай емес.
Dialogue: 0,0:05:46.78,0:05:51.33,Default,,0000,0000,0000,,Хмм, менің сөйлеуім бұрынғыдан сәл басқаша болған сияқты...
Dialogue: 0,0:05:51.33,0:05:53.02,Default,,0000,0000,0000,,Мисаки-чан мейірімді болғандықтан, солай ма? Қайда?
Dialogue: 0,0:05:53.02,0:05:57.22,Default,,0000,0000,0000,,Олай болса, мені ерекше деп қарайды ма?
Dialogue: 0,0:05:57.22,0:05:59.58,Default,,0000,0000,0000,,Масохист? мазохист? Күткендей
Dialogue: 0,0:05:59.58,0:06:03.62,Default,,0000,0000,0000,,Бірақ Мисаки-чан Мисаки-чанды ақыры істеді→
Dialogue: 0,0:06:03.62,0:06:08.50,Default,,0000,0000,0000,,Менің сезімім ешқашан өзгерген жоқ.
Dialogue: 0,0:06:08.50,0:06:11.87,Default,,0000,0000,0000,,Мисаки-чан болмағаныма көп болды.
Dialogue: 0,0:06:11.87,0:06:13.87,Default,,0000,0000,0000,,Мен мұны түсіндім
Dialogue: 0,0:06:21.96,0:06:23.31,Default,,0000,0000,0000,,《Қора! 》
Dialogue: 0,0:06:23.31,0:06:26.68,Default,,0000,0000,0000,,《Осындай киініп не істеп жүрсің?》
Dialogue: 0,0:06:26.68,0:06:29.68,Default,,0000,0000,0000,,《Менің жаңа формасым лас болып қалады.》 《Бум》
Dialogue: 0,0:06:41.00,0:06:45.20,Default,,0000,0000,0000,,《Корайоу-кун, сенің қолыңнан келмейді.》
Dialogue: 0,0:06:45.20,0:06:47.20,Default,,0000,0000,0000,,《Арнайы...》
Dialogue: 0,0:06:50.25,0:06:52.27,Default,,0000,0000,0000,,《Кіші орта мектеп қалай өтті? 》
Dialogue: 0,0:06:52.27,0:06:54.29,Default,,0000,0000,0000,,《Адамдар саны кенет өсті》
Dialogue: 0,0:06:54.29,0:06:56.14,Default,,0000,0000,0000,,《Көп достар тапсам жақсы болар еді》
Dialogue: 0,0:06:56.14,0:06:59.68,Default,,0000,0000,0000,,《 》
Dialogue: 0,0:06:59.68,0:07:03.21,Default,,0000,0000,0000,,《 》
Dialogue: 0,0:07:03.21,0:07:05.40,Default,,0000,0000,0000,,《Итадакимасу》
Dialogue: 0,0:07:05.40,0:07:08.77,Default,,0000,0000,0000,,《 →》
Dialogue: 0,0:07:08.77,0:07:12.14,Default,,0000,0000,0000,,《Алғашында сәл семіз болғанымен, күннен күнге жұқарып барады》
Dialogue: 0,0:07:12.14,0:07:15.33,Default,,0000,0000,0000,,《Мен саған көкөніс жегіземін.》 《Ақымақ болма.》
Dialogue: 0,0:07:15.33,0:07:17.52,Default,,0000,0000,0000,,《Ет берілсе де, оны жемейді》
Dialogue: 0,0:07:17.52,0:07:20.55,Default,,0000,0000,0000,,《Жақсымын десем де, өзімді жақсы сезінбедім→》
Dialogue: 0,0:07:20.55,0:07:22.55,Default,,0000,0000,0000,,《Бұл өте жақсы болды》
Dialogue: 0,0:07:23.58,0:07:25.60,Default,,0000,0000,0000,,《(Үлдеген дыбыс)》
Dialogue: 0,0:07:25.60,0:07:27.46,Default,,0000,0000,0000,,《（） ～ 》
Dialogue: 0,0:07:27.46,0:07:29.46,Default,,0000,0000,0000,,《(Әйелдер қошеметі)》
Dialogue: 0,0:07:33.18,0:07:35.20,Default,,0000,0000,0000,,《（）》
Dialogue: 0,0:07:35.20,0:09:48.20,Default,,0000,0000,0000,,《Сіз қайтадан тезірек →》
Dialogue: 0,0:09:48.20,0:09:50.55,Default,,0000,0000,0000,,Мен Мисаки-сан үшін уайымдап тұрмын.
Dialogue: 0,0:09:50.55,0:09:52.55,Default,,0000,0000,0000,,Осындай бірдеңе...
Dialogue: 0,0:09:56.28,0:09:58.30,Default,,0000,0000,0000,,Мисаки-санның беті қызарған.
Dialogue: 0,0:09:58.30,0:10:00.30,Default,,0000,0000,0000,,Жылы, Мисаки~
Dialogue: 0,0:10:01.33,0:10:04.36,Default,,0000,0000,0000,,Свиш
Dialogue: 0,0:10:04.36,0:10:07.72,Default,,0000,0000,0000,,（）
Dialogue: 0,0:10:07.72,0:10:11.09,Default,,0000,0000,0000,,E-ri-kari-→
Dialogue: 0,0:10:11.09,0:10:13.62,Default,,0000,0000,0000,,Э~Рикалипсо~→
Dialogue: 0,0:10:13.62,0:10:15.97,Default,,0000,0000,0000,,Келіңіздер, өтінемін (3 ақымақ) Иә!
Dialogue: 0,0:10:15.97,0:10:18.00,Default,,0000,0000,0000,,Құрметті Эрика, өтінемін (Сарашина) Миса екеуміз ше?
Dialogue: 0,0:10:18.00,0:10:20.02,Default,,0000,0000,0000,,Жоқ, мен ше? Жоқ, мен ше?
Dialogue: 0,0:10:20.02,0:10:22.88,Default,,0000,0000,0000,,Ол байланады ма?
Dialogue: 0,0:10:22.88,0:10:26.92,Default,,0000,0000,0000,,Жарайды, Миса Чан екеуіңнің болашағын болжайық.
Dialogue: 0,0:10:26.92,0:10:31.29,Default,,0000,0000,0000,,Парша ~ Русолаоно →
Dialogue: 0,0:10:31.29,0:10:35.33,Default,,0000,0000,0000,,Эри Карбонара
Dialogue: 0,0:10:35.33,0:10:39.21,Default,,0000,0000,0000,,Мико күні мен болжау жақсы идея деп шештім.
Dialogue: 0,0:10:39.21,0:10:42.24,Default,,0000,0000,0000,,Бұл мое тұрғысынан сәл әлсіз болуы мүмкін.
Dialogue: 0,0:10:42.24,0:10:44.26,Default,,0000,0000,0000,,Бірақ менеджер, қараңызшы.
Dialogue: 0,0:10:44.26,0:10:48.13,Default,,0000,0000,0000,,Эрика Мені бірдеңе басып алған сияқты, мен оған жабысып қалдым.
Dialogue: 0,0:10:48.13,0:10:50.32,Default,,0000,0000,0000,,Вива Вива
Dialogue: 0,0:10:50.32,0:10:53.85,Default,,0000,0000,0000,,Е-ли Ка-ли Е-ли Ка-ли Жүр!
Dialogue: 0,0:10:53.85,0:10:55.87,Default,,0000,0000,0000,,Қызықты
Dialogue: 0,0:10:55.87,0:10:58.23,Default,,0000,0000,0000,,Бұл шықты! ?
Dialogue: 0,0:10:58.23,0:11:00.58,Default,,0000,0000,0000,,Онда не айтылды? Мен қатты толқып тұрмын
Dialogue: 0,0:11:00.58,0:11:03.11,Default,,0000,0000,0000,,Мен толқудың ұлы жынмын Шсх!
Dialogue: 0,0:11:03.11,0:11:06.82,Default,,0000,0000,0000,,Тайғанақ ми сияқты мен ештеңе көрмеймін.
Dialogue: 0,0:11:06.82,0:11:08.34,Default,,0000,0000,0000,,Не? Не айтқың келеді?
Dialogue: 0,0:11:08.34,0:11:10.69,Default,,0000,0000,0000,,Сіз нені айтасыз? Мен ештеңе көре алмаймын
Dialogue: 0,0:11:10.69,0:11:13.21,Default,,0000,0000,0000,,Бар болғаны, яғни...
Dialogue: 0,0:11:13.21,0:11:15.40,Default,,0000,0000,0000,,Болашақ та қызық емес.
Dialogue: 0,0:11:15.40,0:11:17.93,Default,,0000,0000,0000,,Балалар, бұл мүлдем жақсы емес.
Dialogue: 0,0:11:17.93,0:11:19.95,Default,,0000,0000,0000,,Бұл кристалды хабарлама.
Dialogue: 0,0:11:19.95,0:11:22.30,Default,,0000,0000,0000,,Осылай анық айтпасаң да...
Dialogue: 0,0:11:22.30,0:11:25.50,Default,,0000,0000,0000,,Бір мағынада сәуегейлік адамдарды бақылаумен бірдей.
Dialogue: 0,0:11:25.50,0:11:27.03,Default,,0000,0000,0000,,Миса-чан үшін бұл мүмкін емес.
Dialogue: 0,0:11:27.03,0:11:31.03,Default,,0000,0000,0000,,Хахан! Өзіңді қалай сезінетініңді де білмейсің
Dialogue: 0,0:11:34.25,0:11:36.44,Default,,0000,0000,0000,,Қош келдіңіз, ұстаз.
Dialogue: 0,0:11:36.44,0:11:40.15,Default,,0000,0000,0000,,Мисаки-чан... ой, Миса-чан мұны осында жасады.
Dialogue: 0,0:11:40.15,0:11:43.52,Default,,0000,0000,0000,,Мен әлі де мүлдем үйренбегенмін, ұят.
Dialogue: 0,0:11:43.52,0:11:46.71,Default,,0000,0000,0000,,〈Жоқ, Фукая, сіз қазірдің өзінде тұрақты тұтынушысыз〉
Dialogue: 0,0:11:46.71,0:11:49.57,Default,,0000,0000,0000,,Айтпақшы, майданға «Сәуегей күні» деп жаздым.
Dialogue: 0,0:11:49.57,0:11:52.44,Default,,0000,0000,0000,,Маған да байлығыңызды айта аласыз ба? Әрине, ұстаз.
Dialogue: 0,0:11:52.44,0:11:56.98,Default,,0000,0000,0000,,Саса, шебер, кристалл шардың алдындағы орындықты алыңыз.
Dialogue: 0,0:11:56.98,0:12:00.35,Default,,0000,0000,0000,,Бұл маңызды~ Миса Чанмен болашағыңызды болжаңыз
Dialogue: 0,0:12:00.35,0:12:02.37,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:12:02.37,0:12:06.24,Default,,0000,0000,0000,,Парша ~ Руссолано
Dialogue: 0,0:12:06.24,0:12:08.26,Default,,0000,0000,0000,,Элли кардамон қызықты
Dialogue: 0,0:12:08.26,0:12:10.28,Default,,0000,0000,0000,,Мен оны көрдім. Сіз оны көрдіңіз бе?
Dialogue: 0,0:12:10.28,0:12:12.30,Default,,0000,0000,0000,,Қағаз шар... Қағаз шар?
Dialogue: 0,0:12:12.30,0:12:15.30,Default,,0000,0000,0000,,Ол өшірілді Иә!
Dialogue: 0,0:12:16.34,0:12:19.20,Default,,0000,0000,0000,,Бұл өкінішті. Бұл сөнген қағаз шар сияқты.
Dialogue: 0,0:12:19.20,0:12:22.57,Default,,0000,0000,0000,,Бәлкім, біз ештеңе көрмегендіктен жақсырақ шығармыз.
Dialogue: 0,0:12:22.57,0:12:26.95,Default,,0000,0000,0000,,Мұқият қарап, сөнген қағаз шары қайтадан ұшып кетті ме?
Dialogue: 0,0:12:26.95,0:12:29.30,Default,,0000,0000,0000,,Уау, сен оны жейсің~
Dialogue: 0,0:12:29.30,0:12:31.16,Default,,0000,0000,0000,,Мен тесікті көрмеймін
Dialogue: 0,0:12:31.16,0:12:35.03,Default,,0000,0000,0000,,Керемет~ Егер тесік болмаса, оны қайтадан үрлеңіз.
Dialogue: 0,0:12:35.03,0:12:38.39,Default,,0000,0000,0000,,Сіз өте позитивті бонуссыз
Dialogue: 0,0:12:38.39,0:12:42.77,Default,,0000,0000,0000,,Бұл позитивтілік соңғы бұрылысқа әкелуі мүмкін.
Dialogue: 0,0:12:42.77,0:12:46.81,Default,,0000,0000,0000,,Болуы мүмкін деп айта алмаймын, бірақ болмайды деп айта алмаймын.
Dialogue: 0,0:12:46.81,0:12:48.81,Default,,0000,0000,0000,,Сюжетті бұрмалау? Алақай!
Dialogue: 0,0:12:50.18,0:12:54.56,Default,,0000,0000,0000,,Олай болса, менің тағдырым Мисамен болған болашағым туралы айту керек сияқты.
Dialogue: 0,0:12:54.56,0:12:56.56,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:58.26,0:13:01.46,Default,,0000,0000,0000,,О? Мен ит көріп тұрмын. Бұл жай ғана менің қиялым ба?
Dialogue: 0,0:13:01.46,0:13:04.83,Default,,0000,0000,0000,,Олай болса сәуегейлік айтып көрейік.
Dialogue: 0,0:13:04.83,0:13:10.21,Default,,0000,0000,0000,,Тота Руссо Раоно Эри
Dialogue: 0,0:13:10.21,0:13:13.58,Default,,0000,0000,0000,,Ка~Моми~ру~!
Dialogue: 0,0:13:13.58,0:13:15.77,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:13:15.77,0:13:17.12,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:13:17.12,0:13:20.31,Default,,0000,0000,0000,,〈Мүмкіндігінше алысқа қарау〉
Dialogue: 0,0:13:20.31,0:13:22.17,Default,,0000,0000,0000,,Сәуле айтудың нәтижесі қандай?
Dialogue: 0,0:13:22.17,0:13:25.70,Default,,0000,0000,0000,,Иә, иә хмм
Dialogue: 0,0:13:25.70,0:13:27.55,Default,,0000,0000,0000,,Адал болыңыз.
Dialogue: 0,0:13:27.55,0:13:29.55,Default,,0000,0000,0000,,Олай болса...
Dialogue: 0,0:13:31.26,0:13:33.95,Default,,0000,0000,0000,,Егер сіз...
Dialogue: 0,0:13:33.95,0:13:35.97,Default,,0000,0000,0000,,Болашақ жоқ!
Dialogue: 0,0:13:35.97,0:13:37.99,Default,,0000,0000,0000,,Габин
Dialogue: 0,0:13:37.99,0:13:39.84,Default,,0000,0000,0000,,Кристалда от пен су көрінеді
Dialogue: 0,0:13:39.84,0:13:42.87,Default,,0000,0000,0000,,Сіз мүлдем үйлеспейсіз.
Dialogue: 0,0:13:42.87,0:13:45.57,Default,,0000,0000,0000,,Бірге болуға рұқсат етілмегендер
Dialogue: 0,0:13:45.57,0:13:47.59,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:47.59,0:13:50.62,Default,,0000,0000,0000,,Бірақ егер сіз әлі де сөйлескіңіз келсе
Dialogue: 0,0:13:50.62,0:13:53.65,Default,,0000,0000,0000,,Бізді күтіп тұрған үлкен сынақ
Dialogue: 0,0:13:53.65,0:13:55.65,Default,,0000,0000,0000,,Тапсырманы бірге шешейік
Dialogue: 0,0:14:00.55,0:14:03.24,Default,,0000,0000,0000,,Біздің хабарымыз өзгеріссіз қалады ма?
Dialogue: 0,0:14:03.24,0:14:05.60,Default,,0000,0000,0000,,Менің артымнан ермейсің бе?
Dialogue: 0,0:14:05.60,0:14:07.95,Default,,0000,0000,0000,,Айтшы, Эрика-сама~
Dialogue: 0,0:14:07.95,0:14:09.98,Default,,0000,0000,0000,,Маған қоңырау шалма, жасырын.
Dialogue: 0,0:14:09.98,0:14:11.83,Default,,0000,0000,0000,,Қонақ еткеніңе рахмет~
Dialogue: 0,0:14:11.83,0:14:15.20,Default,,0000,0000,0000,,...
Dialogue: 0,0:14:15.20,0:14:18.23,Default,,0000,0000,0000,,Аа, күттіңіз бе?
Dialogue: 0,0:14:18.23,0:14:22.27,Default,,0000,0000,0000,,Мишита-кун да біраз уақыт бұрын ойнап жүрген сияқты.
Dialogue: 0,0:14:22.27,0:14:24.96,Default,,0000,0000,0000,,Бір жерге кетіп қалды, мм?
Dialogue: 0,0:14:24.96,0:14:26.81,Default,,0000,0000,0000,,Сізге қызық па? Неге олай?
Dialogue: 0,0:14:26.81,0:14:30.85,Default,,0000,0000,0000,,Соңында бізді бір бұрылыс күтіп тұрған шығар.
Dialogue: 0,0:14:30.85,0:14:34.22,Default,,0000,0000,0000,,Мишита артта келе жатқан допты соқты.
Dialogue: 0,0:14:34.22,0:14:36.24,Default,,0000,0000,0000,,Эй, түсіндім.
Dialogue: 0,0:14:36.24,0:14:38.93,Default,,0000,0000,0000,,Біз онша үйлесімді емес едік.
Dialogue: 0,0:14:38.93,0:14:43.31,Default,,0000,0000,0000,,Тоқтай тұрыңыз, сәуегейліктің немесе басқалардың әсерінен сіз болдыңыз ба?
Dialogue: 0,0:14:43.31,0:14:46.85,Default,,0000,0000,0000,,Сондықтан Миса Чан маған суық қарайды.
Dialogue: 0,0:14:46.85,0:14:48.87,Default,,0000,0000,0000,,Бұл сіздің хентай бөтен планеталық екеніңізді білдіреді...
Dialogue: 0,0:14:48.87,0:14:50.89,Default,,0000,0000,0000,,Олай дейтін себебіміз біздің үйлесімділігімізге байланысты.
Dialogue: 0,0:14:50.89,0:14:54.25,Default,,0000,0000,0000,,Сен ақымақсың ба? Менімен бірге болуға рұқсат жоқ па?
Dialogue: 0,0:14:54.25,0:14:56.27,Default,,0000,0000,0000,,Онда сен осындайсың.
Dialogue: 0,0:14:56.27,0:14:59.27,Default,,0000,0000,0000,,Сіз мені оңай тастап кетуді жоспарлап отырсыз ба?
Dialogue: 0,0:15:03.34,0:15:05.34,Default,,0000,0000,0000,,Жоқ, иә...
Dialogue: 0,0:15:06.37,0:15:34.82,Default,,0000,0000,0000,,
Dialogue: 0,0:16:40.82,0:16:42.82,Default,,0000,0000,0000,,Га…
Dialogue: 0,0:16:43.85,0:16:48.85,Default,,0000,0000,0000,,Олардың барлығы спорт клубынан. Мен сені бұл жолы кешіремін.
Dialogue: 0,0:16:49.74,0:16:51.76,Default,,0000,0000,0000,,《Онда сіз осындай нәрсені істеуіңіз керек》
Dialogue: 0,0:16:51.76,0:16:54.76,Default,,0000,0000,0000,,《Мені оңай тастап кетуді жоспарлап отырсың ба? 》
Dialogue: 0,0:17:01.19,0:17:03.71,Default,,0000,0000,0000,,Мен де саған көмектесемін, Мисаки-чан.
Dialogue: 0,0:17:03.71,0:17:07.71,Default,,0000,0000,0000,,Фукая Шикаши, бұл кір~
Dialogue: 0,0:17:08.09,0:17:10.95,Default,,0000,0000,0000,,《Йо-кун, дұрыстап тазала》
Dialogue: 0,0:17:10.95,0:17:14.95,Default,,0000,0000,0000,,《Мен істеп жатырмын~》 《Енді өтірік айтпа》
Dialogue: 0,0:17:16.67,0:17:18.69,Default,,0000,0000,0000,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:17:18.69,0:17:20.69,Default,,0000,0000,0000,,Жоқ, толығымен...
Dialogue: 0,0:17:21.73,0:17:24.73,Default,,0000,0000,0000,,Рахмет, бұл пайдалы болды, Фукая.
Dialogue: 0,0:17:27.28,0:17:29.80,Default,,0000,0000,0000,,Иә, түсіндім.
Dialogue: 0,0:17:29.80,0:17:31.83,Default,,0000,0000,0000,,Жақсы, жақсы, мен барын саламын, барын саламын
Dialogue: 0,0:17:31.83,0:17:34.02,Default,,0000,0000,0000,,Фукая, не болды? Ештеңе етпейді.
Dialogue: 0,0:17:34.02,0:17:37.02,Default,,0000,0000,0000,,Мен шелектегі суды ауыстырайын деп жатырмын. Иә, әлдеқашан?
Dialogue: 0,0:17:38.73,0:17:43.11,Default,,0000,0000,0000,,Ааа~ Мен өлемін деп ойладым, өйткені ол өте сүйкімді болды
Dialogue: 0,0:17:43.11,0:17:45.11,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:17:46.14,0:17:48.32,Default,,0000,0000,0000,,Мисаки-чан Мисаки-чан Иә?
Dialogue: 0,0:17:48.32,0:17:51.35,Default,,0000,0000,0000,,Мен мұны пайдалансам, жылдамырақ емес пе? О, шланг?
Dialogue: 0,0:17:51.35,0:17:53.71,Default,,0000,0000,0000,,Шығуға жақын болса, оған жете аламын ба?
Dialogue: 0,0:17:53.71,0:17:55.71,Default,,0000,0000,0000,,Енді мұны істейік...
Dialogue: 0,0:17:57.92,0:18:00.45,Default,,0000,0000,0000,,Шлангты дұрыс қоспадыңыз ба?
Dialogue: 0,0:18:00.45,0:18:04.15,Default,,0000,0000,0000,,Суық. Қолыммен жапсам не істеуім керек? Кранды жабыңыз
Dialogue: 0,0:18:04.15,0:18:08.15,Default,,0000,0000,0000,,Оны қай жаққа бұруым керек? Жолдан кет! Сондықтан мен оны қолыммен жаптым
Dialogue: 0,0:18:11.22,0:18:13.75,Default,,0000,0000,0000,,Кешіріңіз Мисаки-чан
Dialogue: 0,0:18:13.75,0:18:16.44,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? суық аспан астында
Dialogue: 0,0:18:16.44,0:18:19.14,Default,,0000,0000,0000,,Тағы да Усуй, тез өзгермесең суық тиіп қаласың.
Dialogue: 0,0:18:19.14,0:18:22.33,Default,,0000,0000,0000,,Егер шынымен суда ойнағың келсе, мен сені тоқтатпаймын.
Dialogue: 0,0:18:22.33,0:18:25.87,Default,,0000,0000,0000,,Шулы Эй Фукая, киім ауыстырсаңшы? Егер ол жейде болса
Dialogue: 0,0:18:25.87,0:18:28.39,Default,,0000,0000,0000,,Олай болса тез киіміңді ауыстырып, үйге қайт. Мен суық тигіземін.
Dialogue: 0,0:18:28.39,0:18:31.59,Default,,0000,0000,0000,,Мисаки-чан ше? Мен бұл туралы емханада бірдеңе жасаймын.
Dialogue: 0,0:18:31.59,0:18:33.95,Default,,0000,0000,0000,,Олай болса, сен де тез кет.
Dialogue: 0,0:18:33.95,0:18:36.30,Default,,0000,0000,0000,,Аа, сәл күте тұрыңыз, төраға, иә?
Dialogue: 0,0:18:36.30,0:18:38.16,Default,,0000,0000,0000,,Сіз кетуді жоспарлап отырсыз ба?
Dialogue: 0,0:18:38.16,0:18:41.69,Default,,0000,0000,0000,,Аа, дәліз дымқыл болады, мен сырттан бастайын.
Dialogue: 0,0:18:41.69,0:18:43.71,Default,,0000,0000,0000,,Оны жібермеуім керек еді....
Dialogue: 0,0:18:43.71,0:18:47.58,Default,,0000,0000,0000,,Бұл үлкен мәселе емес, менің іш киімім ашық емес.
Dialogue: 0,0:18:47.58,0:18:51.46,Default,,0000,0000,0000,,Хмм, сіз қалай ойлайсыз? Мына жақтағы адам қызарып кетті
Dialogue: 0,0:18:51.46,0:18:54.32,Default,,0000,0000,0000,,Неліктен ұялшақсың?
Dialogue: 0,0:18:54.32,0:18:58.32,Default,,0000,0000,0000,,Сіздің соншалықты бейхабар болуыңыз сұмдық деп ойлаймын, төраға.
Dialogue: 0,0:19:09.30,0:19:11.82,Default,,0000,0000,0000,,Жарайды, сіз асыра айтып отырсыз.
Dialogue: 0,0:19:11.82,0:19:14.18,Default,,0000,0000,0000,,Киім кигізбесең, мен мұнда мүлдем жалаңаш боламын.
Dialogue: 0,0:19:14.18,0:19:17.05,Default,,0000,0000,0000,,Мектеп қақпасының алдында мүлде жалаңаш билеуге қарсы болмасаң...
Dialogue: 0,0:19:17.05,0:19:20.05,Default,,0000,0000,0000,,Түсіндім, шешіп алма, эй хентай!
Dialogue: 0,0:19:29.84,0:19:31.84,Default,,0000,0000,0000,,...Кеттік!
Dialogue: 0,0:19:39.27,0:19:41.27,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:19:43.14,0:19:46.17,Default,,0000,0000,0000,,«Бір» деген не? Жоқ, әйтеуір.
Dialogue: 0,0:19:46.17,0:19:48.19,Default,,0000,0000,0000,,Төраға, сіз де «Ня~» деп айтыңызшы.
Dialogue: 0,0:19:48.19,0:19:50.19,Default,,0000,0000,0000,,Иә? не істегіңіз келеді
Dialogue: 0,0:20:03.51,0:20:05.51,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:20:11.59,0:20:13.44,Default,,0000,0000,0000,,《（）》
Dialogue: 0,0:20:13.44,0:20:16.47,Default,,0000,0000,0000,,《(Сыныптасы А) Иә, мүмкін, солай ма? 》
Dialogue: 0,0:20:16.47,0:20:19.50,Default,,0000,0000,0000,,《(Сыныптасы В) Әсіресе ол шынымен сүйкімді болса》
Dialogue: 0,0:20:19.50,0:20:23.21,Default,,0000,0000,0000,,《Семіз және ұсқынсыз боламын деп уайымдаудың қажеті жоқ.》
Dialogue: 0,0:20:23.21,0:20:25.73,Default,,0000,0000,0000,,《Мисаки-чан салмақ қосса да сүйкімді》
Dialogue: 0,0:20:25.73,0:20:28.26,Default,,0000,0000,0000,,《（Ａ） →》
Dialogue: 0,0:20:28.26,0:20:33.47,Default,,0000,0000,0000,,《Сіз бұл туралы ешқашан ойламадыңыз ба? Бұл аңғал. Жақында біз мектеп оқушылары боламыз.》
Dialogue: 0,0:20:33.47,0:20:35.50,Default,,0000,0000,0000,,《Қаладағы қыздардың өзі кіші мектеп оқушылары...》
Dialogue: 0,0:20:35.50,0:20:39.20,Default,,0000,0000,0000,,《Егер мен жоғары сыныптың қызы болғым келсе, мен мына сияқты нәрселерді жасайтын едім》
Dialogue: 0,0:20:39.20,0:20:41.20,Default,,0000,0000,0000,,《Не? Бұл не? 》
Dialogue: 0,0:20:44.75,0:20:46.78,Default,,0000,0000,0000,,《(Сыныптасым) Не ойнап жатырсың? 》
Dialogue: 0,0:20:46.78,0:20:50.48,Default,,0000,0000,0000,,《Сіз де менің әпкемнің бөлмесінен тауып алған кітапты қарап шығуыңыз керек》
Dialogue: 0,0:20:50.48,0:20:53.85,Default,,0000,0000,0000,,《Олар ер адамдардың денесімен қорқынышты түрде ойнайды.》
Dialogue: 0,0:20:53.85,0:20:58.56,Default,,0000,0000,0000,,《Мисаки-чан бұлай жасамас еді! Ол таза, мейірімді және мейірімді болып қалады.
Dialogue: 0,0:20:58.56,0:21:01.09,Default,,0000,0000,0000,,《Армандаушы орта мектептің ұлдарын қорламаңыз》
Dialogue: 0,0:21:01.09,0:21:06.14,Default,,0000,0000,0000,,《Бірақ бұл жігітке шындықты көру үшін көз керек емес пе? Мырзалар》
Dialogue: 0,0:21:06.14,0:21:08.16,Default,,0000,0000,0000,,《Мен уайымдайтын кездер болады》
Dialogue: 0,0:21:08.16,0:21:12.03,Default,,0000,0000,0000,,《Қоштасу сыйлығы ретінде алған кәмпит орамасын қоя алмаймын.》
Dialogue: 0,0:21:12.03,0:21:14.55,Default,,0000,0000,0000,,《Неге олай? ««Сен білесің бе? Бұл жігіт》
Dialogue: 0,0:21:14.55,0:21:17.42,Default,,0000,0000,0000,,《Біз, бейсбол клубы, жеңіс үшін дұға ету үшін сатып алған сәйкес тұмарлар》
Dialogue: 0,0:21:17.42,0:21:21.46,Default,,0000,0000,0000,,《Мазмұнын ашып, ішіне кәмпит орамасын салыңыз.》
Dialogue: 0,0:21:21.46,0:21:24.99,Default,,0000,0000,0000,,《Жазда екінші раундта жеңілуімізге сен себепкерсің бе?》
Dialogue: 0,0:21:24.99,0:21:28.02,Default,,0000,0000,0000,,《Сен ақымақсың ба? Соның арқасында бірінші раундта жеңіске жеттім.》
Dialogue: 0,0:21:28.02,0:21:30.38,Default,,0000,0000,0000,,《Бұл екі жағдайда да маңызды емес.》
Dialogue: 0,0:21:30.38,0:21:32.90,Default,,0000,0000,0000,,《Хюга》
Dialogue: 0,0:21:32.90,0:21:35.43,Default,,0000,0000,0000,,《Сен орта мектепке кірген кезде мені көруге шын ниетпен барасың ба?》
Dialogue: 0,0:21:35.43,0:21:39.47,Default,,0000,0000,0000,,《Егер сіз көп нәрсені күтсеңіз, ешқашан депрессияға түсе алмайсыз.》
Dialogue: 0,0:21:39.47,0:21:42.47,Default,,0000,0000,0000,,《Бармас бұрын дайындал.》
Dialogue: 0,0:21:47.05,0:21:49.05,Default,,0000,0000,0000,,Мен дайындалдым, бірақ...
Dialogue: 0,0:21:56.30,0:21:58.30,Default,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,0:22:07.92,0:22:11.12,Default,,0000,0000,0000,,Мисаки-чан маған бас тартқаны үшін ұрысқанда
Dialogue: 0,0:22:11.12,0:22:14.12,Default,,0000,0000,0000,,Сол кезде ойлануым керек пе?
Dialogue: 0,0:22:18.53,0:22:21.22,Default,,0000,0000,0000,,Бірнеше күннен кейін ауа райы жақсы~
Dialogue: 0,0:22:21.22,0:22:23.07,Default,,0000,0000,0000,,Қауіпті!
Dialogue: 0,0:22:23.07,0:22:25.09,Default,,0000,0000,0000,,Бұл орындалады
Dialogue: 0,0:22:25.09,0:22:28.12,Default,,0000,0000,0000,,Оита Сіз күттіңіз бе? (Йо) Шынымен емес.
Dialogue: 0,0:22:28.12,0:22:31.82,Default,,0000,0000,0000,,Шамасы, Юмесаки орта мектебінің мәдени фестивалі керемет.
Dialogue: 0,0:22:31.82,0:22:33.17,Default,,0000,0000,0000,,Соған ұқсайды (Аои) Ах.
Dialogue: 0,0:22:33.17,0:22:35.19,Default,,0000,0000,0000,,Аа, AOI-чан
Dialogue: 0,0:22:35.19,0:22:38.73,Default,,0000,0000,0000,,Сіз дұрыс жерге келдіңіз. Өткен күні суретке түсе алмадым.
Dialogue: 0,0:22:38.73,0:22:41.59,Default,,0000,0000,0000,,Мен көлдің айналасындағы көріністі түсіруге тырыстым.
Dialogue: 0,0:22:41.59,0:22:43.78,Default,,0000,0000,0000,,Сіз бәрібір боссыз, сондықтан оны алыңыз.
Dialogue: 0,0:22:43.78,0:22:45.80,Default,,0000,0000,0000,,Бұл сіз мінген кеме, солай ма?
Dialogue: 0,0:22:45.80,0:22:48.83,Default,,0000,0000,0000,,Сен мұны істейсің бе? Отшашулар шулы
Dialogue: 0,0:22:48.83,0:22:51.83,Default,,0000,0000,0000,,Дыбысты кейін қосамын, рахмет.
Dialogue: 0,0:22:56.91,0:22:59.26,Default,,0000,0000,0000,,Уау, биылғы жыл да керемет.
Dialogue: 0,0:22:59.26,0:23:02.46,Default,,0000,0000,0000,,Мен қауесетті естігенмін, бірақ бұл үлкен болады деп ойламадым.
Dialogue: 0,0:23:02.46,0:23:04.82,Default,,0000,0000,0000,,Мектеп рухы мерекелерді жақсы көретін сияқты.
Dialogue: 0,0:23:04.82,0:23:08.19,Default,,0000,0000,0000,,Дайындық алты ай бұрын басталады.
Dialogue: 0,0:23:08.19,0:23:10.21,Default,,0000,0000,0000,,(Әйелдердің қошеметі)
Dialogue: 0,0:23:10.21,0:23:14.21,Default,,0000,0000,0000,,Бұл үлкен әбігер. Бұл болуы мүмкін бе?
Dialogue: 0,0:23:17.11,0:23:19.63,Default,,0000,0000,0000,,Юмемиши шықты.
Dialogue: 0,0:23:19.63,0:23:21.49,Default,,0000,0000,0000,,Сакура... Мен мұнда емеспін.
Dialogue: 0,0:23:21.49,0:23:23.51,Default,,0000,0000,0000,,Кууга-кун, мынаны маған бер.
Dialogue: 0,0:23:23.51,0:23:25.53,Default,,0000,0000,0000,,Біраз ыңғайсыздық! Уау
Dialogue: 0,0:23:25.53,0:23:27.53,Default,,0000,0000,0000,,Сакура!
Dialogue: 0,0:23:36.30,0:23:38.49,Default,,0000,0000,0000,,Мен саған айттым ғой, солай ма?
Dialogue: 0,0:23:38.49,0:23:42.19,Default,,0000,0000,0000,,Сені жақсы көрейік десең, жақсы қыз болуың керек.
Dialogue: 0,0:23:42.19,0:23:46.19,Default,,0000,0000,0000,,Тек котяттарды ғана ұстануға уәде бере аласыз.
Dialogue: 0,0:23:50.11,0:23:52.29,Default,,0000,0000,0000,,Уау, Сакура~
Dialogue: 0,0:23:52.29,0:23:54.29,Default,,0000,0000,0000,,Шизуко~
Dialogue: 0,0:23:57.01,0:23:59.20,Default,,0000,0000,0000,,Сахна алдында жуынып қалды ма?
Dialogue: 0,0:23:59.20,0:24:01.22,Default,,0000,0000,0000,,Яғни...
Dialogue: 0,0:24:01.22,0:24:04.25,Default,,0000,0000,0000,,Бұл тобырдың екінші жағында екеніңізді білдіреді.
Dialogue: 0,0:24:04.25,0:24:06.10,Default,,0000,0000,0000,,Сен… кімсің?
Dialogue: 0,0:24:06.10,0:24:09.13,Default,,0000,0000,0000,,Бұл сызық тікелей концерттегі орындарға арналған сияқты.
Dialogue: 0,0:24:09.13,0:24:11.82,Default,,0000,0000,0000,,Сакура қозғалғысы келмейтін сияқты.
Dialogue: 0,0:24:11.82,0:24:15.70,Default,,0000,0000,0000,,Мен бұдан былай сахнадан кеткім келмейді.
Dialogue: 0,0:24:15.70,0:24:19.57,Default,,0000,0000,0000,,Сондықтан мен шоу аяқталғанша осында боламын.
Dialogue: 0,0:24:19.57,0:24:22.26,Default,,0000,0000,0000,,Күтілгендей, біріктіру мүмкін емес сияқты.
Dialogue: 0,0:24:22.26,0:24:25.12,Default,,0000,0000,0000,,...
Dialogue: 0,0:24:25.12,0:24:28.15,Default,,0000,0000,0000,,Сәлем, Шидзуко, кездескенше.
Dialogue: 0,0:24:28.15,0:24:30.17,Default,,0000,0000,0000,,(Қоңырау жабылады)
Dialogue: 0,0:24:30.17,0:24:32.53,Default,,0000,0000,0000,,Ойнаңыз десе де
Dialogue: 0,0:24:32.53,0:24:34.89,Default,,0000,0000,0000,,Кууга-кун, сен жақында өзгердің, солай емес пе?
Dialogue: 0,0:24:34.89,0:24:36.91,Default,,0000,0000,0000,,Мүшелер арасындағы атмосфера да әртүрлі.
Dialogue: 0,0:24:36.91,0:24:39.43,Default,,0000,0000,0000,,Бұл жақсы жағынан шиеленісті сезінеді.
Dialogue: 0,0:24:39.43,0:24:42.46,Default,,0000,0000,0000,,Осыған байланысты мен өзімді жанкүйерлерімнен алыстатқандай сезінемін.
Dialogue: 0,0:24:42.46,0:24:46.00,Default,,0000,0000,0000,,→
Dialogue: 0,0:24:46.00,0:24:50.04,Default,,0000,0000,0000,,Бұл музыкадан ләззат алғысы келетін жанкүйерлер үшін тамаша.
Dialogue: 0,0:24:50.04,0:24:53.57,Default,,0000,0000,0000,,〈Әрине, дәл Сакура айтқандай〉
Dialogue: 0,0:24:53.57,0:24:55.43,Default,,0000,0000,0000,,〈Атмосфера басқаша болып көрінді.〉
Dialogue: 0,0:24:55.43,0:24:58.62,Default,,0000,0000,0000,,<Сенсең де, сенбесең де...>
Dialogue: 0,0:24:58.62,0:25:01.15,Default,,0000,0000,0000,,<Мен Сакура үшін алаңдаймын>
Dialogue: 0,0:25:01.15,0:25:04.18,Default,,0000,0000,0000,,<Мен уайымдаймын...>
Dialogue: 0,0:25:04.18,0:25:09.23,Default,,0000,0000,0000,,<Бірақ егер сіз басқа әлемді көрсеңіз, ойлау тәсіліңіз басқаша болуы мүмкін.>
Dialogue: 0,0:25:09.23,0:25:11.92,Default,,0000,0000,0000,,〈Жоқ, бірақ...〉
Dialogue: 0,0:25:11.92,0:25:15.46,Default,,0000,0000,0000,,Мен бұл туралы қазір қанша ойласам да, мен ештеңе істей алмаймын, солай ма?
Dialogue: 0,0:25:15.46,0:25:18.46,Default,,0000,0000,0000,,Сіз бәрібір ойнағыңыз келе ме?
Dialogue: 0,0:25:19.50,0:25:21.50,Default,,0000,0000,0000,,Ойнату...
Dialogue: 0,0:25:23.20,0:25:26.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:27.08,0:26:52.93,Default,,0000,0000,0000,,
Dialogue: 0,0:26:54.43,0:27:00.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory