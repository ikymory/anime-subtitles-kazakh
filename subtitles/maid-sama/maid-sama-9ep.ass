Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:27.32,0:02:54.32,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:55.53,0:03:05.30,Default,,0000,0000,0000,,
Dialogue: 0,0:04:09.77,0:04:11.97,Default,,0000,0000,0000,,〈(Усуи) Баяғыда, баяғы жерде〉
Dialogue: 0,0:04:11.97,0:04:15.67,Default,,0000,0000,0000,,〈Атасы мен әжесі өмір сүрген〉
Dialogue: 0,0:04:15.67,0:04:18.36,Default,,0000,0000,0000,,Бүгін де ауа-райы жақсы.
Dialogue: 0,0:04:18.36,0:04:20.05,Default,,0000,0000,0000,,<Сакура әже киім жууға өзенге барады>
Dialogue: 0,0:04:20.05,0:04:24.76,Default,,0000,0000,0000,,<Юкимура қарт тауға шөп шабуға барған жоқ>
Dialogue: 0,0:04:24.76,0:04:26.11,Default,,0000,0000,0000,,<Мен кір жууға көмектесу үшін жасалғанмын>
Dialogue: 0,0:04:26.11,0:04:28.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:28.97,0:04:31.67,Default,,0000,0000,0000,,〈Сосын үлкен шабдалы ағып келді〉
Dialogue: 0,0:04:31.67,0:04:33.02,Default,,0000,0000,0000,,Бұл не?!
Dialogue: 0,0:04:33.02,0:04:36.37,Default,,0000,0000,0000,,Кя~ Мен шабдалыларды жақсы көремін~
Dialogue: 0,0:04:36.37,0:04:38.39,Default,,0000,0000,0000,,Баа, әже!
Dialogue: 0,0:04:38.39,0:04:41.42,Default,,0000,0000,0000,,〈Атасы мен әжесі үйге шабдалы әкелді...〉
Dialogue: 0,0:04:41.42,0:04:43.28,Default,,0000,0000,0000,,～
Dialogue: 0,0:04:43.28,0:04:45.63,Default,,0000,0000,0000,,〈Мен тамақ ішейін деп жатқанда〉
Dialogue: 0,0:04:45.63,0:04:47.63,Default,,0000,0000,0000,,(Шабдалы кесілген дыбыс)
Dialogue: 0,0:04:52.70,0:04:54.89,Default,,0000,0000,0000,,<Шабдалы ішінен...>
Dialogue: 0,0:04:54.89,0:04:56.89,Default,,0000,0000,0000,,Памкапа~н!
Dialogue: 0,0:05:02.30,0:05:06.30,Default,,0000,0000,0000,,Sessessha Мен жындарды құртамын... дегозару
Dialogue: 0,0:05:10.05,0:05:13.41,Default,,0000,0000,0000,,Әже мен шабдалы адамдары
Dialogue: 0,0:05:13.41,0:05:16.44,Default,,0000,0000,0000,,Бұл шабдалы жейтін уақыт емес.
Dialogue: 0,0:05:16.44,0:05:19.47,Default,,0000,0000,0000,,Жақында бір жас қызды жын ұрлап әкетті.
Dialogue: 0,0:05:19.47,0:05:22.33,Default,,0000,0000,0000,,Ауыл адамдары қорқады емес пе?
Dialogue: 0,0:05:22.33,0:05:26.37,Default,,0000,0000,0000,,Әй, тамаша бала туды.
Dialogue: 0,0:05:26.37,0:05:29.07,Default,,0000,0000,0000,,Мен сені кешіре алмаймын, қатыгез жын!
Dialogue: 0,0:05:29.07,0:05:31.26,Default,,0000,0000,0000,,...дегозару
Dialogue: 0,0:05:31.26,0:05:37.32,Default,,0000,0000,0000,,Жарайды, Момотаро, табиғи болған дұрыс, табиғи бол.
Dialogue: 0,0:05:37.32,0:05:39.50,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:05:39.50,0:05:42.37,Default,,0000,0000,0000,,Әже, атыңызды қашан білдіңіз?
Dialogue: 0,0:05:42.37,0:05:46.74,Default,,0000,0000,0000,,Ал, ата мен әже, кеттік.
Dialogue: 0,0:05:46.74,0:05:50.62,Default,,0000,0000,0000,,Жоқ, бұл қызмет, себебі бұл өте жақсы.
Dialogue: 0,0:05:50.62,0:05:52.64,Default,,0000,0000,0000,,Кибиданго, оны тілмен же
Dialogue: 0,0:05:52.64,0:05:54.49,Default,,0000,0000,0000,,Рахмет, әже
Dialogue: 0,0:05:54.49,0:05:56.01,Default,,0000,0000,0000,,Қалайсың?
Dialogue: 0,0:05:56.01,0:05:59.01,Default,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:06:00.38,0:06:02.40,Default,,0000,0000,0000,,Бұл не болды?
Dialogue: 0,0:06:02.40,0:06:05.43,Default,,0000,0000,0000,,Жүр, шабдалы жейміз.
Dialogue: 0,0:06:05.43,0:06:09.47,Default,,0000,0000,0000,,〈Осылайша Момотаро жындарды жою үшін саяхатқа шықты〉
Dialogue: 0,0:06:09.47,0:06:11.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:11.82,0:06:14.35,Default,,0000,0000,0000,,<Мен ит, маймыл және қырғауыл таптым.>
Dialogue: 0,0:06:14.35,0:06:16.37,Default,,0000,0000,0000,,Неліктен біз осындаймыз?
Dialogue: 0,0:06:16.37,0:06:19.40,Default,,0000,0000,0000,,Ит кінәлі, ол жігітке алданып қалды.
Dialogue: 0,0:06:19.40,0:06:22.43,Default,,0000,0000,0000,,Маймылдар да жаман, өйткені қырғауылдар байқамайды.
Dialogue: 0,0:06:22.43,0:06:24.13,Default,,0000,0000,0000,,Мен күдікті деп айтпадым ба?
Dialogue: 0,0:06:24.13,0:06:27.48,Default,,0000,0000,0000,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:06:27.48,0:06:30.85,Default,,0000,0000,0000,,Анау анау бейтаныс адам (Сарашина), маған көмектесіңізші!
Dialogue: 0,0:06:30.85,0:06:34.85,Default,,0000,0000,0000,,- (Куросаки) Мен бір жаман жігітке алданып, өлтірілгелі тұрмын!
Dialogue: 0,0:06:35.40,0:06:40.45,Default,,0000,0000,0000,,〈Момотаро егер сен оған көмектессең, не айтсаң да тыңдаймын деді〉
Dialogue: 0,0:06:40.45,0:06:42.30,Default,,0000,0000,0000,,<Мен үш жануарға көмектестім>
Dialogue: 0,0:06:42.30,0:06:46.34,Default,,0000,0000,0000,,〈Себебі ол тары тұшпарасын тартып алмақ болды〉
Dialogue: 0,0:06:46.34,0:06:48.36,Default,,0000,0000,0000,,〈Мен сені жеңіл жазаладым〉
Dialogue: 0,0:06:48.36,0:06:51.36,Default,,0000,0000,0000,,Аа, сондықтан мен оны ұстадым.
Dialogue: 0,0:06:58.46,0:07:01.46,Default,,0000,0000,0000,,Жаман адам осында! Мен өлтіремін
Dialogue: 0,0:07:02.50,0:07:04.35,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:07:04.35,0:07:07.38,Default,,0000,0000,0000,,Мен Усуймін
Dialogue: 0,0:07:07.38,0:07:09.08,Default,,0000,0000,0000,,Мен 3 идиот циркінің жетекшісімін.
Dialogue: 0,0:07:09.08,0:07:13.08,Default,,0000,0000,0000,,Бұл күдікті, себебі ол біздің топтың мүшесі.
Dialogue: 0,0:07:14.13,0:07:18.49,Default,,0000,0000,0000,,Жоқ, мен цирк тобын құру мәселесіне бардым.
Dialogue: 0,0:07:18.49,0:07:20.02,Default,,0000,0000,0000,,Бұл жігіттер мүлдем пайдасыз.
Dialogue: 0,0:07:20.02,0:07:24.39,Default,,0000,0000,0000,,Мен қазірдің өзінде жеу керек деп ойладым.
Dialogue: 0,0:07:24.39,0:07:27.09,Default,,0000,0000,0000,,Түсіндім, егер біз оларды тамақ үшін өлтіретін болсақ, көмектесуге болмайды.
Dialogue: 0,0:07:27.09,0:07:29.11,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес!
Dialogue: 0,0:07:29.11,0:07:32.97,Default,,0000,0000,0000,,Мен тек жаттығумен болдым, тамақ таусылды.
Dialogue: 0,0:07:32.97,0:07:36.68,Default,,0000,0000,0000,,Бізді қамшылап жатқаның соншалық.
Dialogue: 0,0:07:36.68,0:07:39.71,Default,,0000,0000,0000,,Енді, қашан...
Dialogue: 0,0:07:39.71,0:07:42.40,Default,,0000,0000,0000,,Мен жақсы емеспін. Бұл жігіт жақсы.
Dialogue: 0,0:07:42.40,0:07:45.43,Default,,0000,0000,0000,,（）
Dialogue: 0,0:07:45.43,0:07:47.28,Default,,0000,0000,0000,,(Ширакаваға қарсы күрес және т.б.)
Dialogue: 0,0:07:47.28,0:07:49.47,Default,,0000,0000,0000,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:07:49.47,0:07:52.83,Default,,0000,0000,0000,,Маған көмектесіңізші. Тамақ ішпес бұрын сенен бір сұрағым бар.
Dialogue: 0,0:07:52.83,0:07:54.19,Default,,0000,0000,0000,,...Оны маған бермейсің бе?
Dialogue: 0,0:07:54.19,0:07:56.37,Default,,0000,0000,0000,,Сен жынның қайда екенін білесің бе?
Dialogue: 0,0:07:56.37,0:07:58.39,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:07:58.39,0:08:02.11,Default,,0000,0000,0000,,Түсіндім, Усуй, егер сен шеше алмасаң, мен 3-балық қайнатпасын ұсынамын.
Dialogue: 0,0:08:02.11,0:08:04.11,Default,,0000,0000,0000,,Мен қазір кетемін
Dialogue: 0,0:08:06.47,0:08:08.49,Default,,0000,0000,0000,,Тоқта, күт, күт!
Dialogue: 0,0:08:08.49,0:08:13.38,Default,,0000,0000,0000,,Мен жынның қайда екенін білмеймін, бірақ жақында жын пайда болған ауыл екенін білемін.
Dialogue: 0,0:08:13.38,0:08:16.08,Default,,0000,0000,0000,,Жасы көп ауыл екен, кенет жын келді.
Dialogue: 0,0:08:16.08,0:08:20.45,Default,,0000,0000,0000,,Ертеңіне қыздардың бәрі кеткен сияқты.
Dialogue: 0,0:08:20.45,0:08:22.47,Default,,0000,0000,0000,,Бұл қай ауыл?
Dialogue: 0,0:08:22.47,0:08:24.47,Default,,0000,0000,0000,,Маған көмектессең, мен саған жол көрсетемін.
Dialogue: 0,0:08:28.36,0:08:31.36,Default,,0000,0000,0000,,Усуи Жарайды.
Dialogue: 0,0:08:32.40,0:08:34.40,Default,,0000,0000,0000,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:08:35.43,0:08:37.45,Default,,0000,0000,0000,,Маған тары тұшпара беріңіз
Dialogue: 0,0:08:37.45,0:08:40.65,Default,,0000,0000,0000,,〈Осылайша, Момотаро итке, маймылға және қырғауылға айналды〉
Dialogue: 0,0:08:40.65,0:08:43.68,Default,,0000,0000,0000,,(Және күдікті цирк жетекшісімен)
Dialogue: 0,0:08:43.68,0:08:45.70,Default,,0000,0000,0000,,<Жынды табуға жолға шықтым>
Dialogue: 0,0:08:45.70,0:08:47.56,Default,,0000,0000,0000,,Бізге тары тұшпара ше?
Dialogue: 0,0:08:47.56,0:08:50.41,Default,,0000,0000,0000,,Мен гучонды жедім!
Dialogue: 0,0:08:50.41,0:08:52.60,Default,,0000,0000,0000,,Бірақ мұндай нәрсе жақсы.
Dialogue: 0,0:08:52.60,0:08:56.31,Default,,0000,0000,0000,,Жауды жеңу үшін батыр бастаған партия іспетті.
Dialogue: 0,0:08:56.31,0:08:58.17,Default,,0000,0000,0000,,Партия?
Dialogue: 0,0:08:58.17,0:09:01.69,Default,,0000,0000,0000,,Өзіңізді алдамаңыз! Кешке баратын көңіл-күйіңіз бар ма?
Dialogue: 0,0:09:01.69,0:09:03.71,Default,,0000,0000,0000,,Мен саяхатқа көңіл көтеру үшін бармаймын!
Dialogue: 0,0:09:03.71,0:09:05.73,Default,,0000,0000,0000,,Бұл партия емес
Dialogue: 0,0:09:05.73,0:09:08.59,Default,,0000,0000,0000,,Менің ойымша, бұл бес адамды біріктіретін атау болса керек...
Dialogue: 0,0:09:08.59,0:09:11.13,Default,,0000,0000,0000,,Хмм, мұндай нәрсе керек пе?
Dialogue: 0,0:09:11.13,0:09:13.15,Default,,0000,0000,0000,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,0:09:13.15,0:09:17.52,Default,,0000,0000,0000,,«Жындарды жою қоғамы» қысқаша, «Жындарды жою қоғамы»
Dialogue: 0,0:09:17.52,0:09:19.04,Default,,0000,0000,0000,,Бұл жақсы есім. Қарсылық жоқ па?
Dialogue: 0,0:09:19.04,0:09:21.39,Default,,0000,0000,0000,,Жарайды, кеттік!
Dialogue: 0,0:09:21.39,0:09:25.39,Default,,0000,0000,0000,,Дендерере~ Дендерере~
Dialogue: 0,0:09:28.97,0:09:30.98,Default,,0000,0000,0000,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:09:30.98,0:09:34.98,Default,,0000,0000,0000,,Қызын жын ұрлап кеткен ауыл
Dialogue: 0,0:09:35.53,0:09:40.41,Default,,0000,0000,0000,,Қатты дөрекі болатын сияқты, бірақ қызым былай тұрсын, ешкімнен белгі жоқ.
Dialogue: 0,0:09:40.41,0:09:43.44,Default,,0000,0000,0000,,Сіз бұл мені айттыңыз!
Dialogue: 0,0:09:43.44,0:09:45.46,Default,,0000,0000,0000,,Сіз оны ұрламақшысыз ба?
Dialogue: 0,0:09:45.46,0:09:47.48,Default,,0000,0000,0000,,Бұл менің өрісімдегі соңғы ағаш.
Dialogue: 0,0:09:47.48,0:09:49.48,Default,,0000,0000,0000,,Жоқ, бұл менің саласым.
Dialogue: 0,0:09:51.35,0:09:53.37,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:09:53.37,0:09:55.37,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:56.08,0:10:01.08,Default,,0000,0000,0000,,Әлгі бейбақ! Бұл жағдай жын ба?
Dialogue: 0,0:10:03.47,0:10:05.49,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:10:05.49,0:10:07.35,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:10:07.35,0:10:09.04,Default,,0000,0000,0000,,Кенет иіс шыдамайтынын айтты.
Dialogue: 0,0:10:09.04,0:10:12.07,Default,,0000,0000,0000,,Ол ит, сондықтан оның мұрны жақсы.
Dialogue: 0,0:10:12.07,0:10:16.60,Default,,0000,0000,0000,,Тамырыңды сондай иіспен көтергің келсе →
Dialogue: 0,0:10:16.60,0:10:19.64,Default,,0000,0000,0000,,Бұл жерден дереу кеткеніңіз жақсы болар еді.
Dialogue: 0,0:10:19.64,0:10:21.66,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:10:21.66,0:10:28.39,Default,,0000,0000,0000,,Бұл енді қарапайым адамдар тұратын ауыл емес...
Dialogue: 0,0:10:28.39,0:10:31.09,Default,,0000,0000,0000,,Әй, не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:10:31.09,0:10:35.80,Default,,0000,0000,0000,,Аххх, бұл жігіттер ақыры төбелесіп қалды.
Dialogue: 0,0:10:35.80,0:10:37.65,Default,,0000,0000,0000,,Түсіндіре аласыз ба?
Dialogue: 0,0:10:37.65,0:10:41.35,Default,,0000,0000,0000,,Сондықтан мен ешқашан шомылмаймын.
Dialogue: 0,0:10:41.35,0:10:45.07,Default,,0000,0000,0000,,Ауылда әйелдер қалмағандықтан, үй жинау, кір жуу қиынға соқты.
Dialogue: 0,0:10:45.07,0:10:48.10,Default,,0000,0000,0000,,Барлық адамдар аман қалу үшін өмір сүре ме?
Dialogue: 0,0:10:48.10,0:10:51.96,Default,,0000,0000,0000,,Ауылдан гөрі майдан даласы көбірек
Dialogue: 0,0:10:51.96,0:10:54.16,Default,,0000,0000,0000,,Шынымен де мықтының олжасы
Dialogue: 0,0:10:54.16,0:10:58.52,Default,,0000,0000,0000,,Бірақ бұл таң қаларлықтай қызық аман қалу өмірі
Dialogue: 0,0:10:58.52,0:11:00.52,Default,,0000,0000,0000,,Бұл қызықты.
Dialogue: 0,0:11:01.55,0:11:06.27,Default,,0000,0000,0000,,Ауыл осы қалпында болса, қыздар қайтып келе жатқанда қиналады.
Dialogue: 0,0:11:06.27,0:11:08.46,Default,,0000,0000,0000,,Жоқ, ол қайтып келмейді.
Dialogue: 0,0:11:08.46,0:11:10.48,Default,,0000,0000,0000,,Қарсылас – жын.
Dialogue: 0,0:11:10.48,0:11:12.66,Default,,0000,0000,0000,,Бұл болмайды.
Dialogue: 0,0:11:12.66,0:11:14.18,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:11:14.18,0:11:16.37,Default,,0000,0000,0000,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:11:16.37,0:11:20.37,Default,,0000,0000,0000,,Қызымызды құтқарамыз, олай болса жынның қайда екенін айт!
Dialogue: 0,0:11:21.09,0:11:23.09,Default,,0000,0000,0000,,Бейбітшілік!
Dialogue: 0,0:11:28.66,0:11:31.03,Default,,0000,0000,0000,,Бұл теңіздің арғы жағында Онигасима бар...
Dialogue: 0,0:11:31.03,0:11:34.38,Default,,0000,0000,0000,,Мен тек көкжиекті ғана көре аламын
Dialogue: 0,0:11:34.38,0:11:36.08,Default,,0000,0000,0000,,Ауыл адамдарына сену дұрыс па?
Dialogue: 0,0:11:36.08,0:11:40.78,Default,,0000,0000,0000,,Уау, бұл орынды болды. Әрине, менің ынтымақтасуға ниетім жоқ.
Dialogue: 0,0:11:40.78,0:11:42.78,Default,,0000,0000,0000,,Сіз мені міндетті түрде мазаладыңыз.
Dialogue: 0,0:11:43.15,0:11:46.67,Default,,0000,0000,0000,,Тоқтаймыз. Тоқтайық. Бүгінге.
Dialogue: 0,0:11:46.67,0:11:48.86,Default,,0000,0000,0000,,Басқа ауылда әртүрлі ақпаратты ести аласыз.
Dialogue: 0,0:11:48.86,0:11:50.05,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:11:50.05,0:11:53.74,Default,,0000,0000,0000,,Кеттік! тыңдамайды
Dialogue: 0,0:11:53.74,0:11:56.94,Default,,0000,0000,0000,,Не, мына тасбақаны аударып жіберші?
Dialogue: 0,0:11:56.94,0:12:00.65,Default,,0000,0000,0000,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:12:00.65,0:12:02.00,Default,,0000,0000,0000,,Жоқ, қаш!
Dialogue: 0,0:12:02.00,0:12:05.03,Default,,0000,0000,0000,,Мен тасбақаны құтқардым. Бұл кездейсоқ мысал бола ма?
Dialogue: 0,0:12:05.03,0:12:07.05,Default,,0000,0000,0000,,Мысал қандай?
Dialogue: 0,0:12:07.05,0:12:10.75,Default,,0000,0000,0000,,Мен мұндай әңгімелерді бұрын естігенмін.
Dialogue: 0,0:12:10.75,0:12:14.28,Default,,0000,0000,0000,,Мен тасбақаны құтқарғанымда, ол рахмет ретінде мені арқасына мінгізді.
Dialogue: 0,0:12:14.28,0:12:17.15,Default,,0000,0000,0000,,Ол мені теңіз түбіндегі Рюгу қамалына апаратынын айтты.
Dialogue: 0,0:12:17.15,0:12:19.17,Default,,0000,0000,0000,,Рюгуджо қандай жер?
Dialogue: 0,0:12:19.17,0:12:22.36,Default,,0000,0000,0000,,Әдемі және сексуалды ханшайым
Dialogue: 0,0:12:22.36,0:12:24.72,Default,,0000,0000,0000,,Теңіз балық, камбала, тунец, т.б.
Dialogue: 0,0:12:24.72,0:12:27.75,Default,,0000,0000,0000,,Мені жаңа теңіз өнімдерімен тамақтандырғаны үшін.
Dialogue: 0,0:12:27.75,0:12:30.28,Default,,0000,0000,0000,,Олар сізге кәдесый әкелуге рұқсат берген сияқты.
Dialogue: 0,0:12:30.28,0:12:32.30,Default,,0000,0000,0000,,Шынымды айтсам, сені өзіммен бірге ала кетейін.
Dialogue: 0,0:12:32.30,0:12:35.83,Default,,0000,0000,0000,,Дегенмен, → туралы абай болу керек
Dialogue: 0,0:12:35.83,0:12:37.18,Default,,0000,0000,0000,,Сол қазына жәшігі кәдесый →
Dialogue: 0,0:12:37.18,0:12:40.55,Default,,0000,0000,0000,,Ашсам, ішінен түтін шықты.
Dialogue: 0,0:12:40.55,0:12:43.08,Default,,0000,0000,0000,,Біраз уақыттан кейін қарияға айналатын сияқты.
Dialogue: 0,0:12:43.08,0:12:46.44,Default,,0000,0000,0000,,Неліктен бұл қауіпті?
Dialogue: 0,0:12:46.44,0:12:48.13,Default,,0000,0000,0000,,Тасбақа жігіт, сен маған жақсылығың үшін өтемін деп жатырсың ба?
Dialogue: 0,0:12:48.13,0:12:51.82,Default,,0000,0000,0000,,Сол қазына қорабын ашудың қажеті жоқ па?
Dialogue: 0,0:12:51.82,0:12:54.85,Default,,0000,0000,0000,,Дұрыс. Сіз қазына қорабын ашуыңыз керек →
Dialogue: 0,0:12:54.85,0:12:58.22,Default,,0000,0000,0000,,Дәмді тағам жеп, Отохиме-самамен дос болу...
Dialogue: 0,0:12:58.22,0:13:01.22,Default,,0000,0000,0000,,Балалар, біраз уақыттан бері не туралы айтып жатырсыңдар?
Dialogue: 0,0:13:02.94,0:13:05.46,Default,,0000,0000,0000,,Пыс, пыс… Э?
Dialogue: 0,0:13:05.46,0:13:09.67,Default,,0000,0000,0000,,Мына тасбақаның арқасына мініп Онигасимаға барамыз.
Dialogue: 0,0:13:09.67,0:13:11.86,Default,,0000,0000,0000,,Мен не болатынын көрейін.
Dialogue: 0,0:13:11.86,0:13:13.86,Default,,0000,0000,0000,,Кеттік
Dialogue: 0,0:13:14.06,0:13:18.42,Default,,0000,0000,0000,,Сіз басқа оқиғаны айтқыңыз келе ме?
Dialogue: 0,0:13:18.42,0:13:20.42,Default,,0000,0000,0000,,Жақсы емес пе?
Dialogue: 0,0:13:26.51,0:13:29.70,Default,,0000,0000,0000,,Дем ала алмаймын (Сарашина) Сен мені өлтірмекшісің бе?
Dialogue: 0,0:13:29.70,0:13:31.70,Default,,0000,0000,0000,,Құстар жүзе алмайды, солай ма?
Dialogue: 0,0:13:32.07,0:13:37.28,Default,,0000,0000,0000,,Қайықты осылай пайдалану дұрыс па? (Куросаки) Егер сіз адасып қалсаңыз не істер едіңіз? →
Dialogue: 0,0:13:37.28,0:13:39.47,Default,,0000,0000,0000,,Тамақ та жоқ
Dialogue: 0,0:13:39.47,0:13:42.83,Default,,0000,0000,0000,,Сонда мен сені жеймін, бәрібір...
Dialogue: 0,0:13:42.83,0:13:45.53,Default,,0000,0000,0000,,Қырғауыл Онигашиманы аспаннан іздеу
Dialogue: 0,0:13:45.53,0:13:47.53,Default,,0000,0000,0000,,Раджа!
Dialogue: 0,0:13:51.09,0:13:55.80,Default,,0000,0000,0000,,Жер көрінбейді (Сарашина) Қырғауыл қайтып келмеді.
Dialogue: 0,0:13:55.80,0:13:57.82,Default,,0000,0000,0000,,Сіз қашып кетпедіңіз бе?
Dialogue: 0,0:13:57.82,0:13:59.67,Default,,0000,0000,0000,,Біздің байланысымыз берік
Dialogue: 0,0:13:59.67,0:14:03.37,Default,,0000,0000,0000,,Бізді жеуге жақын қалғанда, бір-бірімізді ұзарттық.
Dialogue: 0,0:14:03.37,0:14:05.07,Default,,0000,0000,0000,,Олай емес.
Dialogue: 0,0:14:05.07,0:14:08.07,Default,,0000,0000,0000,,Мен жалғыз қашып бара жатқаныма сене алар емеспін
Dialogue: 0,0:14:11.62,0:14:14.32,Default,,0000,0000,0000,,Менің де қарным ашты.
Dialogue: 0,0:14:14.32,0:14:16.67,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:14:16.67,0:14:19.37,Default,,0000,0000,0000,,Бұл жерде біреу қалды.
Dialogue: 0,0:14:19.37,0:14:21.37,Default,,0000,0000,0000,,Бұл менмін! Маған берші!
Dialogue: 0,0:14:25.26,0:14:27.26,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:14:36.20,0:14:41.42,Default,,0000,0000,0000,,Бұл сендер түсірген кәдімгі тары тұшпара ма еді?
Dialogue: 0,0:14:41.42,0:14:46.30,Default,,0000,0000,0000,,Немесе бұл сізге бір жылдық Кибиданго беретін сыйлық ашықхаттарының шоғыры ма?
Dialogue: 0,0:14:46.30,0:14:50.34,Default,,0000,0000,0000,,Немесе біздің ең жақсы қар шаянымыз, теңіз кірпілері, лосось елігі, балық
Dialogue: 0,0:14:50.34,0:14:53.34,Default,,0000,0000,0000,,Бұл Хоккайдо теңіз өнімдері жиынтығын ұтып алуға болатын сыйлық ашық хаты ма?
Dialogue: 0,0:14:55.39,0:14:58.93,Default,,0000,0000,0000,,Міне, бұл кәдімгі тары тұшпара.
Dialogue: 0,0:14:58.93,0:15:02.46,Default,,0000,0000,0000,,Түсіндім, мм, сен адал адамсың.
Dialogue: 0,0:15:02.46,0:15:05.83,Default,,0000,0000,0000,,Сыйлық ретінде осы Хоккайдо теңіз өнімдерін ұтып алыңыз.
Dialogue: 0,0:15:05.83,0:15:07.83,Default,,0000,0000,0000,,Жүлделік ашықхат беріңіз
Dialogue: 0,0:15:09.36,0:15:11.38,Default,,0000,0000,0000,,Пост туралы не деуге болады?
Dialogue: 0,0:15:11.38,0:15:14.92,Default,,0000,0000,0000,,Теңіз жағасындағы ауылға дейін солтүстік-солтүстік-батысқа қарай 30 шақырымдай жерде.
Dialogue: 0,0:15:14.92,0:15:16.44,Default,,0000,0000,0000,,Мен оны қашан аламын?
Dialogue: 0,0:15:16.44,0:15:21.44,Default,,0000,0000,0000,,Лотерея күні бір айдан кейін болады, ал жеңімпаздар жөнелтілудің орнына жарияланады...
Dialogue: 0,0:15:24.02,0:15:26.04,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:15:26.04,0:15:29.40,Default,,0000,0000,0000,,Маған тары тұшпараларын қайтарыңыз!
Dialogue: 0,0:15:29.40,0:15:31.42,Default,,0000,0000,0000,,Сіз не жеп жатырсыз?
Dialogue: 0,0:15:31.42,0:15:34.42,Default,,0000,0000,0000,,Ах, Шидзуко әже, шабдалы жеп қойыңыз~
Dialogue: 0,0:15:35.30,0:15:39.33,Default,,0000,0000,0000,,
Dialogue: 0,0:16:55.59,0:16:58.45,Default,,0000,0000,0000,,Төраға, ұйықтап жатырсыз ба?
Dialogue: 0,0:16:58.45,0:17:00.64,Default,,0000,0000,0000,,Ұйқыға не жетсін?
Dialogue: 0,0:17:00.64,0:17:02.64,Default,,0000,0000,0000,,Мен сені оятамын.
Dialogue: 0,0:17:03.67,0:17:06.53,Default,,0000,0000,0000,,Қол тигізбеңіз...
Dialogue: 0,0:17:06.53,0:17:10.57,Default,,0000,0000,0000,,Белгілі болғандай, мен сендермен бірге саяхаттап жүрмін.
Dialogue: 0,0:17:10.57,0:17:12.93,Default,,0000,0000,0000,,Мен саған сенбеймін.
Dialogue: 0,0:17:12.93,0:17:15.96,Default,,0000,0000,0000,,Әсіресе Усуй, сен тым күдіктенесің.
Dialogue: 0,0:17:15.96,0:17:17.96,Default,,0000,0000,0000,,Сыртқы түрі мен мазмұны туралы барлығы
Dialogue: 0,0:17:19.50,0:17:21.85,Default,,0000,0000,0000,,Содан кейін өз қалауыңыз бойынша жасаңыз.
Dialogue: 0,0:17:21.85,0:17:25.56,Default,,0000,0000,0000,,（）
Dialogue: 0,0:17:25.56,0:17:27.58,Default,,0000,0000,0000,,А, мынау қырғауыл емес пе?
Dialogue: 0,0:17:27.58,0:17:30.44,Default,,0000,0000,0000,,А, мен қайтып келдім.
Dialogue: 0,0:17:30.44,0:17:32.13,Default,,0000,0000,0000,,Маған көмектес, көмектес!
Dialogue: 0,0:17:32.13,0:17:36.13,Default,,0000,0000,0000,,Қырғауылдан шыққан арқан тәрізді бірдеңе...
Dialogue: 0,0:17:45.42,0:17:48.45,Default,,0000,0000,0000,,Маған өлтіруге көмектес. Маған көмектес
Dialogue: 0,0:17:48.45,0:17:52.50,Default,,0000,0000,0000,,Қараңызшы, мінеки. Мен құлаған кемені көтеріп алдым.
Dialogue: 0,0:17:52.50,0:17:55.86,Default,,0000,0000,0000,,Әлгі жігіт өте мұқият.
Dialogue: 0,0:17:55.86,0:17:59.90,Default,,0000,0000,0000,,Жолдас дегенде мына байғұс қайықты айтып тұрсың ба?
Dialogue: 0,0:17:59.90,0:18:03.94,Default,,0000,0000,0000,,Көңілі қалған алақан көп өнім бермейтін сияқты.
Dialogue: 0,0:18:03.94,0:18:06.94,Default,,0000,0000,0000,,Сіз аз болса да көңіл көтеріңіз деп үміттенемін.
Dialogue: 0,0:18:08.49,0:18:11.52,Default,,0000,0000,0000,,Әзірге мен өз өмірімді сақтап жатырмын.
Dialogue: 0,0:18:11.52,0:18:14.55,Default,,0000,0000,0000,,Қырғауыл ақымақ! Қарақшылардың қолына түспеңіз
Dialogue: 0,0:18:14.55,0:18:17.55,Default,,0000,0000,0000,,Бәрін өзің істе, аянышты адам!
Dialogue: 0,0:18:22.63,0:18:24.48,Default,,0000,0000,0000,,Кез келген жағдайда ертерек тасбақа
Dialogue: 0,0:18:24.48,0:18:27.48,Default,,0000,0000,0000,,（） （）
Dialogue: 0,0:18:29.20,0:18:33.24,Default,,0000,0000,0000,,Сіз ешқашан ішке қарамауға уәде бере аласыз ба?
Dialogue: 0,0:18:33.24,0:18:35.24,Default,,0000,0000,0000,,Оу Оу
Dialogue: 0,0:18:39.46,0:18:43.01,Default,,0000,0000,0000,,Қарама, олар саған керемет қару дайындап қойғанына сенімдімін.
Dialogue: 0,0:18:43.01,0:18:46.37,Default,,0000,0000,0000,,Басқа оқиғаға араласқыңыз келе ме?
Dialogue: 0,0:18:46.37,0:18:48.37,Default,,0000,0000,0000,,Жақсы емес пе?
Dialogue: 0,0:18:59.50,0:19:01.50,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:03.70,0:19:06.40,Default,,0000,0000,0000,,Белгісіз адам ұйықтап жатыр Бұл жігіт кім?
Dialogue: 0,0:19:06.40,0:19:08.42,Default,,0000,0000,0000,,Шық!
Dialogue: 0,0:19:08.42,0:19:11.95,Default,,0000,0000,0000,,Балалар сендер қандай сұмдық мини-комтсыңдар.
Dialogue: 0,0:19:11.95,0:19:13.97,Default,,0000,0000,0000,,Иә, уайымдамаңыз!
Dialogue: 0,0:19:13.97,0:19:16.34,Default,,0000,0000,0000,,О, шабдалы? Тағы да бар.
Dialogue: 0,0:19:16.34,0:19:20.21,Default,,0000,0000,0000,,Шабдалылардың бәрін жеп ал, әже!
Dialogue: 0,0:19:20.21,0:19:22.21,Default,,0000,0000,0000,,Мен саған ілесе алмаймын.
Dialogue: 0,0:19:27.61,0:19:30.47,Default,,0000,0000,0000,,Оқты қылышпен кестің бе?
Dialogue: 0,0:19:30.47,0:19:32.47,Default,,0000,0000,0000,,Хун
Dialogue: 0,0:19:34.18,0:19:37.18,Default,,0000,0000,0000,,Қызық, бір секундқа осында келіңіз.
Dialogue: 0,0:19:38.55,0:19:40.55,Default,,0000,0000,0000,,Жүріңдер, көтеріліңдер.
Dialogue: 0,0:19:44.12,0:19:46.31,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:46.31,0:19:48.31,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:19:52.03,0:19:54.38,Default,,0000,0000,0000,,Бұл мүмкін емес!
Dialogue: 0,0:19:54.38,0:19:57.38,Default,,0000,0000,0000,,Әзірше құлағыңды жабу керек.
Dialogue: 0,0:20:02.63,0:20:06.63,Default,,0000,0000,0000,,Уау! Бұл кеме жанғыш.
Dialogue: 0,0:20:09.53,0:20:13.57,Default,,0000,0000,0000,,Күн ыстық, тезірек көмектесіңізші! Мүмкін кеткен дұрыс шығар
Dialogue: 0,0:20:13.57,0:20:15.09,Default,,0000,0000,0000,,That's right.
Dialogue: 0,0:20:15.09,0:20:17.09,Default,,0000,0000,0000,,Хмф, көңілді балалар.
Dialogue: 0,0:20:24.19,0:20:27.19,Default,,0000,0000,0000,,Ах, рахмет
Dialogue: 0,0:20:28.55,0:20:30.55,Default,,0000,0000,0000,,Төмен бағамен
Dialogue: 0,0:20:31.58,0:20:34.44,Default,,0000,0000,0000,,Бірақ таң болды.
Dialogue: 0,0:20:34.44,0:20:36.44,Default,,0000,0000,0000,,Осы жолы «өлім шеңберінен» аман қалған сияқтымын.
Dialogue: 0,0:20:42.69,0:20:44.69,Default,,0000,0000,0000,,Ах, бұл
Dialogue: 0,0:20:46.56,0:20:48.56,Default,,0000,0000,0000,,Ол ақырында пайда болды ма?
Dialogue: 0,0:20:49.60,0:20:51.60,Default,,0000,0000,0000,,Онигасима
Dialogue: 0,0:20:55.82,0:20:57.18,Default,,0000,0000,0000,,Ей, өзіміз жеңе аламыз ба?
Dialogue: 0,0:20:57.18,0:21:00.54,Default,,0000,0000,0000,,Менің қаруым да жоқ.
Dialogue: 0,0:21:00.54,0:21:03.57,Default,,0000,0000,0000,,Дұрыс. Мұндай жағдайда осы әдісті қолданыңыз.
Dialogue: 0,0:21:03.57,0:21:05.09,Default,,0000,0000,0000,,Мысал әдісі дегеніміз не?
Dialogue: 0,0:21:05.09,0:21:07.61,Default,,0000,0000,0000,,Рух толқындарын қолдануды да ұмытып кеткенмін
Dialogue: 0,0:21:07.61,0:21:10.14,Default,,0000,0000,0000,,Сабан? Оны әртүрлі заттармен ауыстырыңыз
Dialogue: 0,0:21:10.14,0:21:15.36,Default,,0000,0000,0000,,Саманнан басталған нәрсе ақырында орасан зор қаруға айналды.
Dialogue: 0,0:21:15.36,0:21:18.55,Default,,0000,0000,0000,,Шынымен! Алдымен нені ауыстыруым керек?
Dialogue: 0,0:21:18.55,0:21:21.58,Default,,0000,0000,0000,,О, пампакапаан!
Dialogue: 0,0:21:21.58,0:21:23.60,Default,,0000,0000,0000,,Жарайды Келесі Жарайды→
Dialogue: 0,0:21:23.60,0:21:25.62,Default,,0000,0000,0000,,Рух толқындарын қолдануды да ұмытып кеткенмін
Dialogue: 0,0:21:25.62,0:21:27.47,Default,,0000,0000,0000,,Жарайсыңдар! О
Dialogue: 0,0:21:27.47,0:21:30.50,Default,,0000,0000,0000,,Қару-жарақ, т.б. Бұл жеткілікті
Dialogue: 0,0:21:30.50,0:21:32.86,Default,,0000,0000,0000,,Фронтальды серпіліс!
Dialogue: 0,0:21:32.86,0:21:34.86,Default,,0000,0000,0000,,Төраға, мынаны қараңыз.
Dialogue: 0,0:21:36.56,0:21:41.61,Default,,0000,0000,0000,,көремін. Бұл дос болып көріну арқылы кіріп кетудің амалы ма?
Dialogue: 0,0:21:41.61,0:21:43.47,Default,,0000,0000,0000,,Шапылдап кіргеннен гөрі
Dialogue: 0,0:21:43.47,0:21:47.51,Default,,0000,0000,0000,,Қыздарыма қауіп төнбес шығар.
Dialogue: 0,0:21:47.51,0:21:51.22,Default,,0000,0000,0000,,Мұның өзі тұзақ болуы мүмкін, бірақ мен киім ауыстырып көрейін деп ойлаймын.
Dialogue: 0,0:21:51.22,0:21:53.07,Default,,0000,0000,0000,,Сонда біз
Dialogue: 0,0:21:53.07,0:21:57.94,Default,,0000,0000,0000,,Нағыз нұсқасын көру үшін жабайы жануар болып көріну
Dialogue: 0,0:21:57.94,0:21:59.30,Default,,0000,0000,0000,,Ванван сықырлайды
Dialogue: 0,0:21:59.30,0:22:03.50,Default,,0000,0000,0000,,Егер жеңу мүмкіндігі болмаса, үйге жасырын оралайық.
Dialogue: 0,0:22:03.50,0:22:05.50,Default,,0000,0000,0000,,Қалай болып жатыр?
Dialogue: 0,0:22:06.03,0:22:08.03,Default,,0000,0000,0000,,Мен болашақтағы 5,7 миллиард адамға қызықпаймын. О…
Dialogue: 0,0:22:13.60,0:22:17.47,Default,,0000,0000,0000,,- (Ширакава) Жұмақ емес пе!
Dialogue: 0,0:22:17.47,0:22:21.47,Default,,0000,0000,0000,,Бұл гарем қызметшісі!
Dialogue: 0,0:22:23.53,0:22:26.06,Default,,0000,0000,0000,,Мақсатыңды ұмытпа 3 Идиот
Dialogue: 0,0:22:26.06,0:22:29.27,Default,,0000,0000,0000,,Қыздарымды тез арада қауіпсіз жерге көшіремін.
Dialogue: 0,0:22:29.27,0:22:31.45,Default,,0000,0000,0000,,Ал, бұл не?
Dialogue: 0,0:22:31.45,0:22:33.97,Default,,0000,0000,0000,,Жаңа бала?
Dialogue: 0,0:22:33.97,0:22:37.97,Default,,0000,0000,0000,,Төраға әйел екен!
Dialogue: 0,0:22:38.68,0:22:43.57,Default,,0000,0000,0000,,Мына жігіттерді жайына қалдыр, қарғыс атсын, Усуй қайда кетті?
Dialogue: 0,0:22:43.57,0:22:45.57,Default,,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:22:49.46,0:22:52.46,Default,,0000,0000,0000,,Қош келдіңіз, әке.
Dialogue: 0,0:23:06.63,0:23:09.16,Default,,0000,0000,0000,,Сені жақсы көремін
Dialogue: 0,0:23:09.16,0:23:11.51,Default,,0000,0000,0000,,Сіз алдадыңыз ба?
Dialogue: 0,0:23:11.51,0:23:14.54,Default,,0000,0000,0000,,Иә? Жын деп айтпадың ба?
Dialogue: 0,0:23:14.54,0:23:16.23,Default,,0000,0000,0000,,Бірақ ол 3-идиот циркінің жетекшісі.
Dialogue: 0,0:23:16.23,0:23:18.75,Default,,0000,0000,0000,,Иә, шу болды, жетеді.
Dialogue: 0,0:23:18.75,0:23:21.78,Default,,0000,0000,0000,,Мына қыздарды ұрлаған сен болдың.
Dialogue: 0,0:23:21.78,0:23:23.78,Default,,0000,0000,0000,,Өзіңді дайында, эй, хентай жын!
Dialogue: 0,0:23:24.15,0:23:27.68,Default,,0000,0000,0000,,Эй, сен нені түсінбедің?
Dialogue: 0,0:23:27.68,0:23:30.21,Default,,0000,0000,0000,,Не? біз осында тұрамыз, өйткені біз оны жақсы көреміз
Dialogue: 0,0:23:30.21,0:23:32.23,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:32.23,0:23:36.93,Default,,0000,0000,0000,,Мен ол өмірден шаршадым.
Dialogue: 0,0:23:36.93,0:23:38.95,Default,,0000,0000,0000,,Ер адамдар лас және өзімшіл
Dialogue: 0,0:23:38.95,0:23:41.48,Default,,0000,0000,0000,,Жақсы адам шықты, мен оның соңынан ердім.
Dialogue: 0,0:23:41.48,0:23:43.50,Default,,0000,0000,0000,,Бұл аралда тұру өте оңай.
Dialogue: 0,0:23:43.50,0:23:45.69,Default,,0000,0000,0000,,Бұл ыңғайлы және көзге жақсы.
Dialogue: 0,0:23:45.69,0:23:47.54,Default,,0000,0000,0000,,Қанағаттанасыз ба?
Dialogue: 0,0:23:47.54,0:23:51.92,Default,,0000,0000,0000,,Осылайша менің үйімді басып алды.
Dialogue: 0,0:23:51.92,0:23:53.92,Default,,0000,0000,0000,,Бейшара мен
Dialogue: 0,0:23:55.45,0:23:57.45,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:23:59.83,0:24:02.52,Default,,0000,0000,0000,,Менімен бірге болыңыз, төраға.
Dialogue: 0,0:24:02.52,0:24:04.22,Default,,0000,0000,0000,,Бұл аралдан кетудің көңілді орны
Dialogue: 0,0:24:04.22,0:24:07.74,Default,,0000,0000,0000,,Барайық, тауып алайық
Dialogue: 0,0:24:07.74,0:24:09.26,Default,,0000,0000,0000,,Сіз не айттыңыз?
Dialogue: 0,0:24:09.26,0:24:11.61,Default,,0000,0000,0000,,Мен неге сенімен біргемін?
Dialogue: 0,0:24:11.61,0:24:13.63,Default,,0000,0000,0000,,Ахх~ Мое гүлдері~
Dialogue: 0,0:24:13.63,0:24:15.63,Default,,0000,0000,0000,,Неліктен...
Dialogue: 0,0:24:17.51,0:24:20.51,Default,,0000,0000,0000,,Мен президенттің қасында жүргенде толқып қаламын.
Dialogue: 0,0:24:21.55,0:24:24.08,Default,,0000,0000,0000,,<Осылайша екеуі ғашық болып кетті...>
Dialogue: 0,0:24:24.08,0:24:26.60,Default,,0000,0000,0000,,Иә? Бір минут күте тұрыңыз
Dialogue: 0,0:24:26.60,0:24:28.29,Default,,0000,0000,0000,,Мен әлі... Бәрібір төрағамын.
Dialogue: 0,0:24:28.29,0:24:31.98,Default,,0000,0000,0000,,Сіз тартымды көрінесіз. Сіз мені шақырасыз ба?
Dialogue: 0,0:24:31.98,0:24:33.84,Default,,0000,0000,0000,,Жалаң аяқпен
Dialogue: 0,0:24:33.84,0:24:36.20,Default,,0000,0000,0000,,Жоқ! Мен төбелесемін деп ойлап, етегінен кесіп тастадым.
Dialogue: 0,0:24:36.20,0:24:39.23,Default,,0000,0000,0000,,〈Біз бірге жаңа саяхатқа барамыз.〉
Dialogue: 0,0:24:39.23,0:24:42.92,Default,,0000,0000,0000,,<Бұл басқа әңгіме>
Dialogue: 0,0:24:42.92,0:24:44.92,Default,,0000,0000,0000,,〈Бақытты〉
Dialogue: 0,0:24:47.64,0:24:52.64,Default,,0000,0000,0000,,Ым, жоқ, тоқтат, хентай
Dialogue: 0,0:24:53.53,0:24:57.57,Default,,0000,0000,0000,,Усуй мырза, сіз төрағадан не сұрадыңыз?
Dialogue: 0,0:24:57.57,0:24:59.93,Default,,0000,0000,0000,,Менің көңілім қалды.
Dialogue: 0,0:24:59.93,0:25:02.79,Default,,0000,0000,0000,,Менің ерекше ертегім
Dialogue: 0,0:25:02.79,0:25:06.00,Default,,0000,0000,0000,,〈Айтпақшы, 3 ақымақ та жақсы араласып, 2-ге жем болады〉
Dialogue: 0,0:25:06.00,0:25:08.19,Default,,0000,0000,0000,,<Бұл басқа әңгіме>
Dialogue: 0,0:25:08.19,0:25:11.55,Default,,0000,0000,0000,,Бізді соңына дейін тамақ ретінде қарайды.
Dialogue: 0,0:25:11.55,0:25:13.74,Default,,0000,0000,0000,,Неліктен? Бұл қорқынышты.
Dialogue: 0,0:25:13.74,0:25:18.74,Default,,0000,0000,0000,,<Ах~ Сонымен, үш тентектің әрқайсысы аман-есен аман қалды.>
Dialogue: 0,0:25:20.64,0:25:22.16,Default,,0000,0000,0000,,〈Иттің аты Почи〉
Dialogue: 0,0:25:22.16,0:25:26.53,Default,,0000,0000,0000,,<Мен Ханасаки қарттың үй жануарына айналдым...>
Dialogue: 0,0:25:26.53,0:25:28.88,Default,,0000,0000,0000,,Почи…
Dialogue: 0,0:25:28.88,0:25:32.88,Default,,0000,0000,0000,,<Қырғауыл кемпірдің балдырын рұқсатсыз жеп қойды...>
Dialogue: 0,0:25:34.44,0:25:38.44,Default,,0000,0000,0000,,〈Маймыл крабды алдап, күріш шарын ұрлап кетті〉
Dialogue: 0,0:25:40.50,0:25:42.52,Default,,0000,0000,0000,,Мені өлтірме!
Dialogue: 0,0:25:42.52,0:25:44.52,Default,,0000,0000,0000,,〈Бақытты〉
Dialogue: 0,0:25:46.73,0:26:30.73,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:31.18,0:27:15.45,Default,,0000,0000,0000,,
Dialogue: 0,0:27:16.95,0:27:22.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory