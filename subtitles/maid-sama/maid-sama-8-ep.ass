Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:26.65,0:02:53.65,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:54.03,0:03:04.29,Default,,0000,0000,0000,,
Dialogue: 0,0:04:05.41,0:04:08.10,Default,,0000,0000,0000,,Сейканың шәкірттері сені шыбын десе де
Dialogue: 0,0:04:08.10,0:04:10.29,Default,,0000,0000,0000,,Жарайды деуге негіз жоқ.
Dialogue: 0,0:04:10.29,0:04:12.31,Default,,0000,0000,0000,,Кешірім сұрау
Dialogue: 0,0:04:12.31,0:04:14.33,Default,,0000,0000,0000,,Мисаки Аюзава
Dialogue: 0,0:04:14.33,0:04:18.04,Default,,0000,0000,0000,,Масагаокадағы студенттік кеңеске қосыла аласыз ба?
Dialogue: 0,0:04:18.04,0:04:21.04,Default,,0000,0000,0000,,Мен бәріне кепілдік беремін.
Dialogue: 0,0:04:22.41,0:04:24.77,Default,,0000,0000,0000,,Мен байсалдымын.
Dialogue: 0,0:04:24.77,0:04:28.80,Default,,0000,0000,0000,,Мұндай нәрсе «шабуыл» сияқты
Dialogue: 0,0:04:28.80,0:04:31.83,Default,,0000,0000,0000,,Енді Усуйдің мазақ етуіне болмайды
Dialogue: 0,0:04:31.83,0:04:33.83,Default,,0000,0000,0000,,Мен одан шаршадым
Dialogue: 0,0:04:52.20,0:04:55.57,Default,,0000,0000,0000,,Сіз Миягаокадансыз.
Dialogue: 0,0:04:55.57,0:04:59.78,Default,,0000,0000,0000,,Менің атым Маки, мен студенттік кеңестің вице-президентімін.
Dialogue: 0,0:04:59.78,0:05:01.97,Default,,0000,0000,0000,,Мен үшін бірдеңе бар ма?
Dialogue: 0,0:05:01.97,0:05:05.97,Default,,0000,0000,0000,,Сізбен бір сәт сөйлесе аламын ба?
Dialogue: 0,0:05:08.70,0:05:10.89,Default,,0000,0000,0000,,Балалар
Dialogue: 0,0:05:10.89,0:05:12.89,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:13.09,0:05:15.61,Default,,0000,0000,0000,,Төлеңіз.
Dialogue: 0,0:05:15.61,0:05:18.31,Default,,0000,0000,0000,,Төраға Игарашидің шын жүректен шыққан сыйы.
Dialogue: 0,0:05:18.31,0:05:22.01,Default,,0000,0000,0000,,Мұндай қымбат затты сұрауға негіз жоқ.
Dialogue: 0,0:05:22.01,0:05:24.03,Default,,0000,0000,0000,,Төраға Игараши сізге
Dialogue: 0,0:05:24.03,0:05:28.73,Default,,0000,0000,0000,,Сіз Масагаокаға ауысасыз деп үміттенемін.
Dialogue: 0,0:05:28.73,0:05:33.12,Default,,0000,0000,0000,,Менің басыма осындай жағдай түссе де бармаймын. Мен оны өзіммен бірге үйге апарамын.
Dialogue: 0,0:05:33.12,0:05:38.83,Default,,0000,0000,0000,,Бұл менің дүкенім осы күнге арнайы жасаған торт.
Dialogue: 0,0:05:38.83,0:05:40.19,Default,,0000,0000,0000,,Оны ысырап ету ысырап болар еді.
Dialogue: 0,0:05:40.19,0:05:46.25,Default,,0000,0000,0000,,Уайымдамаңыз, төрағаның мұндай нәрсеге өз пайдасын сатуға ниеті жоқ.
Dialogue: 0,0:05:46.25,0:05:50.62,Default,,0000,0000,0000,,Төлеңіз.
Dialogue: 0,0:05:50.62,0:05:53.65,Default,,0000,0000,0000,,Төраға Игараши сізбен бірге.
Dialogue: 0,0:05:53.65,0:05:56.68,Default,,0000,0000,0000,,Мен Миягаоканы жақсырақ мектеп еткім келеді.
Dialogue: 0,0:05:56.68,0:05:58.68,Default,,0000,0000,0000,,Бұл жай ғана.
Dialogue: 0,0:06:00.39,0:06:02.41,Default,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:06:02.41,0:06:04.27,Default,,0000,0000,0000,,Сана қош келдіңіз
Dialogue: 0,0:06:04.27,0:06:07.62,Default,,0000,0000,0000,,Жек көру? белгісіз мырза
Dialogue: 0,0:06:07.62,0:06:10.65,Default,,0000,0000,0000,,Сіз Аюзава Джуку университетінің екінші курс студентісіз бе?
Dialogue: 0,0:06:10.65,0:06:13.85,Default,,0000,0000,0000,,Ондай ештеңе жоқ, сол жаққа барыңыз.
Dialogue: 0,0:06:13.85,0:06:15.71,Default,,0000,0000,0000,,（）
Dialogue: 0,0:06:15.71,0:06:18.74,Default,,0000,0000,0000,,Кешіріңіз, мен біртүрлі баламын.
Dialogue: 0,0:06:18.74,0:06:21.77,Default,,0000,0000,0000,,Миягаокаға келсең
Dialogue: 0,0:06:21.77,0:06:26.81,Default,,0000,0000,0000,,Төраға өзінің кіші қарындасын да Масагаокаға қолайлы шарттармен қабылдады.
Dialogue: 0,0:06:26.81,0:06:28.00,Default,,0000,0000,0000,,Қандай жағдай болмасын, бұл мүмкін емес
Dialogue: 0,0:06:28.00,0:06:33.05,Default,,0000,0000,0000,,Масагаокадағы Игараши Зайбатсудың әсері орасан зор.
Dialogue: 0,0:06:33.05,0:06:39.28,Default,,0000,0000,0000,,Әпкеңнің игілігі үшін мынаны байыппен ойланшы →
Dialogue: 0,0:06:39.28,0:06:42.48,Default,,0000,0000,0000,,Мен сені тағы 3 күн күтемін.
Dialogue: 0,0:06:42.48,0:06:46.02,Default,,0000,0000,0000,,Бізге жақсы жауап беруіңізді сұраймыз.
Dialogue: 0,0:06:46.02,0:06:48.04,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:06:48.04,0:06:51.40,Default,,0000,0000,0000,,Сіз келгенше төраға.
Dialogue: 0,0:06:51.40,0:06:54.40,Default,,0000,0000,0000,,Миягаокада күту
Dialogue: 0,0:06:59.81,0:07:01.50,Default,,0000,0000,0000,,Не болды, Мисаки?
Dialogue: 0,0:07:01.50,0:07:03.52,Default,,0000,0000,0000,,Таң қалды, жоқ.
Dialogue: 0,0:07:03.52,0:07:06.71,Default,,0000,0000,0000,,Мүмкін бұл жолбарыс туралы шығар? жолбарыс?
Dialogue: 0,0:07:06.71,0:07:08.07,Default,,0000,0000,0000,,Игараши Зайбацудың мұрагері
Dialogue: 0,0:07:08.07,0:07:11.60,Default,,0000,0000,0000,,Мен Тора Игараши, Масагаока студенттер кеңесінің президентімін.
Dialogue: 0,0:07:11.60,0:07:13.78,Default,,0000,0000,0000,,Мисаки Мен оны Масагаокада болады деп ешқашан ойламадым.
Dialogue: 0,0:07:13.78,0:07:15.80,Default,,0000,0000,0000,,Мен мектептерді ауыстырғым келмейді.
Dialogue: 0,0:07:15.80,0:07:17.82,Default,,0000,0000,0000,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:07:17.82,0:07:19.67,Default,,0000,0000,0000,,Сакура мен басқаларды тастамаңыз
Dialogue: 0,0:07:19.67,0:07:22.70,Default,,0000,0000,0000,,Өйткені мен Мисакиге сүйенемін
Dialogue: 0,0:07:22.70,0:07:25.73,Default,,0000,0000,0000,,Байқаусыз пікір жазудан аулақ болыңыз!
Dialogue: 0,0:07:25.73,0:07:27.43,Default,,0000,0000,0000,,Ал, Мисаки-санның болашағын ойласам.
Dialogue: 0,0:07:27.43,0:07:31.80,Default,,0000,0000,0000,,Уақытша эмоцияларға берілу дұрыс па?
Dialogue: 0,0:07:31.80,0:07:34.50,Default,,0000,0000,0000,,Жақсы мектепте оқудың зияны жоқ.
Dialogue: 0,0:07:34.50,0:07:36.85,Default,,0000,0000,0000,,Мисакидің болашағы?
Dialogue: 0,0:07:36.85,0:07:39.71,Default,,0000,0000,0000,,Мисаки мен Тораға ауыссам ше?
Dialogue: 0,0:07:39.71,0:07:41.73,Default,,0000,0000,0000,,Махаббат өссе
Dialogue: 0,0:07:41.73,0:07:43.75,Default,,0000,0000,0000,,Мисаки жолбарыстың әйелі ме?
Dialogue: 0,0:07:43.75,0:07:47.75,Default,,0000,0000,0000,,Игараши Зайбацудың атақты әйелі.
Dialogue: 0,0:07:48.80,0:07:52.00,Default,,0000,0000,0000,,（） →
Dialogue: 0,0:07:52.00,0:07:54.53,Default,,0000,0000,0000,,Бұл керемет емес пе?
Dialogue: 0,0:07:54.53,0:07:57.39,Default,,0000,0000,0000,,Өйткені, әлемге әйгілі мектеп Масагаока даши
Dialogue: 0,0:07:57.39,0:08:01.10,Default,,0000,0000,0000,,Әдетте сіз бас тартпайсыз. (Судо) Бас тартуға ешқандай себеп жоқ.
Dialogue: 0,0:08:01.10,0:08:08.10,Default,,0000,0000,0000,,Егер төраға жоқ болса, біз бұрынғыдай қалағанымызды жасай аламыз.
Dialogue: 0,0:08:09.35,0:08:12.38,Default,,0000,0000,0000,,Балалар, бұлай айта алмайсыңдар.
Dialogue: 0,0:08:12.38,0:08:14.40,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:14.40,0:08:17.26,Default,,0000,0000,0000,,Төраға Масагаокамен төбелесіп қалғанда да
Dialogue: 0,0:08:17.26,0:08:19.28,Default,,0000,0000,0000,,Ол бізге сенді, бізді қорғады.
Dialogue: 0,0:08:19.28,0:08:21.47,Default,,0000,0000,0000,,Біз туралы қаншалықты?
Dialogue: 0,0:08:21.47,0:08:24.47,Default,,0000,0000,0000,,Ойланып жатырсың ба? Түсінесіз бе?
Dialogue: 0,0:08:27.69,0:08:29.38,Default,,0000,0000,0000,,Мен мұны білемін.
Dialogue: 0,0:08:29.38,0:08:33.08,Default,,0000,0000,0000,,Бірақ егер төраға Масагаокаға барғысы келетінін айтса.
Dialogue: 0,0:08:33.08,0:08:36.08,Default,,0000,0000,0000,,Біз сізді тоқтата алмаймыз.
Dialogue: 0,0:08:37.46,0:08:40.82,Default,,0000,0000,0000,,Мен көптен бері демалдым.
Dialogue: 0,0:08:40.82,0:08:42.84,Default,,0000,0000,0000,,Күлге айналды.
Dialogue: 0,0:08:42.84,0:08:44.36,Default,,0000,0000,0000,,Жинақталған жұмысты аяқтауым керек.
Dialogue: 0,0:08:44.36,0:08:46.36,Default,,0000,0000,0000,,Усуй-сан! ?
Dialogue: 0,0:08:48.74,0:08:50.92,Default,,0000,0000,0000,,Түсінуім үшін неше рет айту керек?
Dialogue: 0,0:08:50.92,0:08:53.62,Default,,0000,0000,0000,,Мақсатыңыз болмаса да, студенттік кеңес бөлмесіне кірмеңіз.
Dialogue: 0,0:08:53.62,0:08:55.81,Default,,0000,0000,0000,,Юкимура қорқады, солай ма?
Dialogue: 0,0:08:55.81,0:09:00.85,Default,,0000,0000,0000,,Менің бір ісім бар. Мен не істеуім керек, Масагаока?
Dialogue: 0,0:09:00.85,0:09:03.88,Default,,0000,0000,0000,,Мен Сейка орта мектебінің студенттер кеңесінің президентімін.
Dialogue: 0,0:09:03.88,0:09:06.74,Default,,0000,0000,0000,,Мен кеткенде, Сейка...
Dialogue: 0,0:09:06.74,0:09:08.76,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:08.76,0:09:13.76,Default,,0000,0000,0000,,Сен сияқты аңдыушыдан құтылғаным жақсы болар.
Dialogue: 0,0:09:14.82,0:09:17.02,Default,,0000,0000,0000,,Миягаокаға көшу деген нені білдіреді?
Dialogue: 0,0:09:17.02,0:09:20.02,Default,,0000,0000,0000,,Мен жоқта не болды?
Dialogue: 0,0:09:22.41,0:09:24.43,Default,,0000,0000,0000,,Анаң ше?
Dialogue: 0,0:09:24.43,0:09:26.45,Default,,0000,0000,0000,,Маған ауруханадан қоңырау түсті.
Dialogue: 0,0:09:26.45,0:09:30.15,Default,,0000,0000,0000,,Мен кенеттен кеш ауысымға ауысуға тура келді.
Dialogue: 0,0:09:30.15,0:09:32.01,Default,,0000,0000,0000,,Мен сізге қатты итермеңіз дедім.
Dialogue: 0,0:09:32.01,0:09:35.04,Default,,0000,0000,0000,,Екі қызын жалғыз өзі тәрбиелеп отыр.
Dialogue: 0,0:09:35.04,0:09:38.07,Default,,0000,0000,0000,,Тіпті мүмкін емес нәрсені істеу керек болса да...
Dialogue: 0,0:09:38.07,0:09:40.09,Default,,0000,0000,0000,,Шын мәнінде, дұрыс, бірақ
Dialogue: 0,0:09:40.09,0:09:42.94,Default,,0000,0000,0000,,（）
Dialogue: 0,0:09:42.94,0:09:45.63,Default,,0000,0000,0000,,Мұндай тойға не бар?
Dialogue: 0,0:09:45.63,0:09:47.33,Default,,0000,0000,0000,,Миягаока жігіттері тағы да осында!
Dialogue: 0,0:09:47.33,0:09:51.33,Default,,0000,0000,0000,,Жоқ, мен бәрін жасадым.
Dialogue: 0,0:09:59.11,0:10:01.96,Default,,0000,0000,0000,,Мұның бәрі әзіл. Бұл керемет.
Dialogue: 0,0:10:01.96,0:10:04.66,Default,,0000,0000,0000,,Окара арзан әрі құнарлы.
Dialogue: 0,0:10:04.66,0:10:07.53,Default,,0000,0000,0000,,Мен кедей болғандықтан, ас әзірлеуде шығармашылықпен айналысуым керек.
Dialogue: 0,0:10:07.53,0:10:10.89,Default,,0000,0000,0000,,Санаға көп күш салғаным үшін кешіріңіз.
Dialogue: 0,0:10:10.89,0:10:12.07,Default,,0000,0000,0000,,Бұл сенің апаңның кінәсі емес.
Dialogue: 0,0:10:12.07,0:10:14.09,Default,,0000,0000,0000,,Қашып кеткен әкемнің кесірінен.
Dialogue: 0,0:10:14.09,0:10:16.95,Default,,0000,0000,0000,,Ал тамақ әзірлеу қызық.
Dialogue: 0,0:10:16.95,0:10:19.95,Default,,0000,0000,0000,,Итадакимасу Итадакимасу
Dialogue: 0,0:10:22.67,0:10:24.67,Default,,0000,0000,0000,,Сақ бол.
Dialogue: 0,0:10:25.87,0:10:29.74,Default,,0000,0000,0000,,Эй, Сана, Масагаока академиясына барғың келмей ме?
Dialogue: 0,0:10:29.74,0:10:33.11,Default,,0000,0000,0000,,Иә? Бұл бай және ақылды адамдарға арналған мектеп, солай ма?
Dialogue: 0,0:10:33.11,0:10:35.47,Default,,0000,0000,0000,,Бара алсаң ше?
Dialogue: 0,0:10:35.47,0:10:40.52,Default,,0000,0000,0000,,Егер менде мұндай ақша болса, мен нағыз патша крабын сатып алар едім. Неліктен?
Dialogue: 0,0:10:40.52,0:10:43.52,Default,,0000,0000,0000,,Жоқ, мен жай сұрадым.
Dialogue: 0,0:10:45.40,0:10:47.43,Default,,0000,0000,0000,,Сонда да бәрінің дәмі окара сияқты.
Dialogue: 0,0:10:47.43,0:10:52.14,Default,,0000,0000,0000,,Десертке бізде Аюзава Джуку әкелген ең жоғары сапалы торт бар.
Dialogue: 0,0:10:52.14,0:10:55.14,Default,,0000,0000,0000,,Сондықтан бұл Аюзава Джуку емес.
Dialogue: 0,0:11:51.22,0:11:52.41,Default,,0000,0000,0000,,Мисаки қазірдің өзінде
Dialogue: 0,0:11:52.41,0:11:55.10,Default,,0000,0000,0000,,Қызық, қайда кетті?
Dialogue: 0,0:11:55.10,0:11:59.98,Default,,0000,0000,0000,,Мисаки-сан ондай нәрсеге бармайды деп ойлаймын.→
Dialogue: 0,0:11:59.98,0:12:01.16,Default,,0000,0000,0000,,Шынымды айтсам, мен де бұлай істеуден аулақ болғым келеді.
Dialogue: 0,0:12:01.16,0:12:05.04,Default,,0000,0000,0000,,Қалай болғанда да, сіз Шидзуконы көргенде, сізге ұнайтыны сөзсіз.
Dialogue: 0,0:12:05.04,0:12:08.07,Default,,0000,0000,0000,,Қараңызшы, бұл керемет.
Dialogue: 0,0:12:08.07,0:12:10.75,Default,,0000,0000,0000,,Сіз әйелсіз бе? Не?
Dialogue: 0,0:12:10.75,0:12:12.61,Default,,0000,0000,0000,,u×missi?
Dialogue: 0,0:12:12.61,0:12:16.64,Default,,0000,0000,0000,,Бұл «Юмемиши». Сіз әдейі қателеспегеніңізге сенімдісіз бе?
Dialogue: 0,0:12:16.64,0:12:18.16,Default,,0000,0000,0000,,Жоқ, мені қызықтырмайды.
Dialogue: 0,0:12:18.16,0:12:20.52,Default,,0000,0000,0000,,Қазір қоңырау шалайық
Dialogue: 0,0:12:20.52,0:12:22.04,Default,,0000,0000,0000,,...
Dialogue: 0,0:12:22.04,0:12:24.89,Default,,0000,0000,0000,,Қазір қайдасың?
Dialogue: 0,0:12:24.89,0:12:26.89,Default,,0000,0000,0000,,- Миягаокаға келу
Dialogue: 0,0:12:28.09,0:12:32.64,Default,,0000,0000,0000,,...
Dialogue: 0,0:12:32.64,0:12:35.67,Default,,0000,0000,0000,,Сакура кешіріңіз, бірақ мен сізге кейінірек қайта қоңырау шаламын.
Dialogue: 0,0:12:35.67,0:12:37.67,Default,,0000,0000,0000,,...
Dialogue: 0,0:12:38.03,0:12:47.45,Default,,0000,0000,0000,,
Dialogue: 0,0:13:55.63,0:13:57.65,Default,,0000,0000,0000,,Ах Мисаки?
Dialogue: 0,0:13:57.65,0:13:59.67,Default,,0000,0000,0000,,(Жауап беруші)
Dialogue: 0,0:13:59.67,0:14:01.69,Default,,0000,0000,0000,,Мисаки-сан, бұл не?
Dialogue: 0,0:14:01.69,0:14:03.71,Default,,0000,0000,0000,,Жоқ, ол жұмыс істемейді.
Dialogue: 0,0:14:03.71,0:14:06.74,Default,,0000,0000,0000,,Сонда сіз Масагаока академиясына барасыз ба?
Dialogue: 0,0:14:06.74,0:14:09.27,Default,,0000,0000,0000,,Мисаки, сен не істеуді жоспарлап отырсың?
Dialogue: 0,0:14:09.27,0:14:14.65,Default,,0000,0000,0000,,Неліктен мұндай маңызды нәрселерді өзіңіз шешесіз?
Dialogue: 0,0:14:14.65,0:14:17.19,Default,,0000,0000,0000,,《Уайымдама, мен бұл туралы бірдеңе істеймін》
Dialogue: 0,0:14:17.19,0:14:21.73,Default,,0000,0000,0000,,《Жақсы мектепте оқудың зияны жоқ.》
Dialogue: 0,0:14:21.73,0:14:23.08,Default,,0000,0000,0000,,《Мисаки жолбарыстың әйелі ме? →》
Dialogue: 0,0:14:23.08,0:14:26.45,Default,,0000,0000,0000,,《Ол сонымен қатар Игараши Зайбатсудың атақты әйелі》
Dialogue: 0,0:14:26.45,0:14:31.99,Default,,0000,0000,0000,,《Жарайды, Мисаки-сан міндетті түрде бірдеңе жасайды.》
Dialogue: 0,0:14:31.99,0:14:35.03,Default,,0000,0000,0000,,Рас, біз тек Мисаки-санға сүйенеміз.
Dialogue: 0,0:14:35.03,0:14:38.23,Default,,0000,0000,0000,,Мисакидің сезімі туралы ештеңе естімедім.
Dialogue: 0,0:14:38.23,0:14:41.43,Default,,0000,0000,0000,,Сіз маңызды ештеңе айтқан жоқсыз.
Dialogue: 0,0:14:41.43,0:14:43.45,Default,,0000,0000,0000,,Шидзуко шынымен жақсы ма?
Dialogue: 0,0:14:43.45,0:14:48.99,Default,,0000,0000,0000,,Мисаки Масагаокаға барса да, өзіңді жалғыз сезінбейсің бе?
Dialogue: 0,0:14:48.99,0:14:51.19,Default,,0000,0000,0000,,Сакура-сан, Мисаки-санды қайтарып алғыңыз келсе
Dialogue: 0,0:14:51.19,0:14:54.72,Default,,0000,0000,0000,,Миягаокаға да жеңілме
Dialogue: 0,0:14:54.72,0:14:57.72,Default,,0000,0000,0000,,Мұқият орындайық Иә.
Dialogue: 0,0:15:01.46,0:15:04.33,Default,,0000,0000,0000,,Жақсы көңіл-күй Анаң қалай?
Dialogue: 0,0:15:04.33,0:15:07.52,Default,,0000,0000,0000,,Иә, келесі демалыста қайда барасыз?
Dialogue: 0,0:15:07.52,0:15:11.40,Default,,0000,0000,0000,,<Бұрын мұнда келгенде байқамадым, бірақ Миягаока күткендей>
Dialogue: 0,0:15:11.40,0:15:14.40,Default,,0000,0000,0000,,〈Атмосфера менікінен мүлде басқаша〉
Dialogue: 0,0:15:17.11,0:15:20.32,Default,,0000,0000,0000,,Сейка орта мектебінің президенті Мисаки Аюзава келді.
Dialogue: 0,0:15:20.32,0:15:24.36,Default,,0000,0000,0000,,Ең болмаса, мен оны құптайтын едім.
Dialogue: 0,0:15:24.36,0:15:26.38,Default,,0000,0000,0000,,Бұл менің бірінші рет.
Dialogue: 0,0:15:26.38,0:15:30.75,Default,,0000,0000,0000,,Төраға қандай әйелге сонша көңіл бөледі?
Dialogue: 0,0:15:30.75,0:15:34.79,Default,,0000,0000,0000,,Маки, сен мені қанағаттандыра алатын әйелсің бе?
Dialogue: 0,0:15:34.79,0:15:37.79,Default,,0000,0000,0000,,Сіз ол жерде жоқ деп ойлайсыз.
Dialogue: 0,0:15:40.85,0:15:43.85,Default,,0000,0000,0000,,Мен де солай ойладым.
Dialogue: 0,0:15:54.82,0:15:57.82,Default,,0000,0000,0000,,(есік тұтқасы бұрылады)
Dialogue: 0,0:16:10.49,0:16:15.03,Default,,0000,0000,0000,,Төраға Аюзава, мен сіздің келетініңізге сенімді болдым.
Dialogue: 0,0:16:15.03,0:16:17.05,Default,,0000,0000,0000,,Төраға Игараши
Dialogue: 0,0:16:17.05,0:16:22.77,Default,,0000,0000,0000,,Жақсы жауап аласыз деп үміттенемін.
Dialogue: 0,0:16:22.77,0:16:24.77,Default,,0000,0000,0000,,Бұл туралы...
Dialogue: 0,0:16:29.01,0:16:32.37,Default,,0000,0000,0000,,（）
Dialogue: 0,0:16:32.37,0:16:34.73,Default,,0000,0000,0000,,Бүгін
Dialogue: 0,0:16:34.73,0:16:37.25,Default,,0000,0000,0000,,Широянның туған күні болса да
Dialogue: 0,0:16:37.25,0:16:38.60,Default,,0000,0000,0000,,Тойлауларыңызды қалаймын~
Dialogue: 0,0:16:38.60,0:16:41.46,Default,,0000,0000,0000,,Жүр, Куротацу, енді менің қолымнан келмейді.
Dialogue: 0,0:16:41.46,0:16:44.46,Default,,0000,0000,0000,,Ақ! Мықты бол
Dialogue: 0,0:16:47.02,0:16:49.21,Default,,0000,0000,0000,,...
Dialogue: 0,0:16:49.21,0:16:52.07,Default,,0000,0000,0000,,Мен Миса Чан бола алмаймын, бірақ
Dialogue: 0,0:16:52.07,0:16:55.44,Default,,0000,0000,0000,,Хонока және басқалары тойлай алады ма?
Dialogue: 0,0:16:55.44,0:16:57.62,Default,,0000,0000,0000,,Біз де торт дайындадық.
Dialogue: 0,0:16:57.62,0:17:01.16,Default,,0000,0000,0000,,Мен Мэйд Латтенің туған күніне арналған тортын жасадым.
Dialogue: 0,0:17:01.16,0:17:06.16,Default,,0000,0000,0000,,Ештеңе етпейді, тек менің сүйікті күйеуімнің қызметі.
Dialogue: 0,0:17:08.06,0:17:10.58,Default,,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,0:17:10.58,0:17:13.78,Default,,0000,0000,0000,,Бірақ «Үш ақымақ» деп жазылған сияқты
Dialogue: 0,0:17:13.78,0:17:16.78,Default,,0000,0000,0000,,Күрделі~ Тегін болса жақсы
Dialogue: 0,0:17:17.82,0:17:20.01,Default,,0000,0000,0000,,Кешіріңіз, иә?
Dialogue: 0,0:17:20.01,0:17:22.37,Default,,0000,0000,0000,,Кешіріңіз, кенет Шидзуко
Dialogue: 0,0:17:22.37,0:17:27.09,Default,,0000,0000,0000,,（）
Dialogue: 0,0:17:27.09,0:17:30.78,Default,,0000,0000,0000,,Не? Мисаки қазір жалғыз
Dialogue: 0,0:17:30.78,0:17:33.81,Default,,0000,0000,0000,,Төраға Миягаокаға отыра ма?
Dialogue: 0,0:17:33.81,0:17:37.85,Default,,0000,0000,0000,,Мисаки Масагаокаға ауысуды жоспарласа.
Dialogue: 0,0:17:37.85,0:17:41.23,Default,,0000,0000,0000,,Оны тоқтатпағанымызға да өзіміз кінәлі.
Dialogue: 0,0:17:41.23,0:17:44.75,Default,,0000,0000,0000,,Мүмкін мен өзімшіл болып жатқан шығармын
Dialogue: 0,0:17:44.75,0:17:47.78,Default,,0000,0000,0000,,Мен Мисакидің Сейкада қалғанын қалаймын.
Dialogue: 0,0:17:47.78,0:17:49.81,Default,,0000,0000,0000,,Бәрі де солай емес пе?
Dialogue: 0,0:17:49.81,0:17:53.68,Default,,0000,0000,0000,,Төраға Аюзавадан басқа президент туралы ойлай алмаймын.
Dialogue: 0,0:17:53.68,0:17:56.68,Default,,0000,0000,0000,,Төрағаны алайық!
Dialogue: 0,0:17:58.39,0:18:00.59,Default,,0000,0000,0000,,Біз де барамыз, о
Dialogue: 0,0:18:00.59,0:18:04.59,Default,,0000,0000,0000,,Кеттік, бәріміз (бәрі).
Dialogue: 0,0:18:05.13,0:18:08.83,Default,,0000,0000,0000,,Бай мектептен күткендей.
Dialogue: 0,0:18:08.83,0:18:12.70,Default,,0000,0000,0000,,Студенттік кеңес бөлмесінің жанында душ бөлмесінің болуы қалыпты жағдай емес.
Dialogue: 0,0:18:12.70,0:18:14.89,Default,,0000,0000,0000,,Дәлірек айтқанда, мен неге
Dialogue: 0,0:18:14.89,0:18:17.89,Default,,0000,0000,0000,,Осылай болды ма деп ойлаймын!
Dialogue: 0,0:18:21.79,0:18:24.82,Default,,0000,0000,0000,,Жоқ, мен оны осында қойғаныма сенімдімін.
Dialogue: 0,0:18:24.82,0:18:26.84,Default,,0000,0000,0000,,Бұл басқа шкаф болды ма?
Dialogue: 0,0:18:26.84,0:18:28.84,Default,,0000,0000,0000,,Тіпті мұнда емес!
Dialogue: 0,0:18:29.87,0:18:31.89,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:18:31.89,0:18:33.41,Default,,0000,0000,0000,,（）
Dialogue: 0,0:18:33.41,0:18:36.11,Default,,0000,0000,0000,,Формамды таба алмай жүрмін.
Dialogue: 0,0:18:36.11,0:18:39.14,Default,,0000,0000,0000,,Сонда ол дақ болуы керек.
Dialogue: 0,0:18:39.14,0:18:42.00,Default,,0000,0000,0000,,Мен қыздан оны тазалаушыға апаруын өтіндім.
Dialogue: 0,0:18:42.00,0:18:44.02,Default,,0000,0000,0000,,Сонымен не киюім керек...
Dialogue: 0,0:18:44.02,0:18:47.55,Default,,0000,0000,0000,,О? Сізде дайын ауыстыру бар ма?
Dialogue: 0,0:18:47.55,0:18:49.41,Default,,0000,0000,0000,,〈Мұны кигенімді қалайсың ба? 〉
Dialogue: 0,0:18:49.41,0:18:51.43,Default,,0000,0000,0000,,Не болды, Аюзава мырза?
Dialogue: 0,0:18:51.43,0:18:54.46,Default,,0000,0000,0000,,Бұл терінің сәл тым көп екенін көрсетеді.
Dialogue: 0,0:18:54.46,0:18:58.50,Default,,0000,0000,0000,,Мүмкін сіз душта абайсызда күйіп қалған шығарсыз?
Dialogue: 0,0:18:58.50,0:19:03.04,Default,,0000,0000,0000,,Бірақ сіз оны киіміңізбен жасырып жатқан жоқсыз ба?
Dialogue: 0,0:19:03.04,0:19:05.23,Default,,0000,0000,0000,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:19:05.23,0:19:09.77,Default,,0000,0000,0000,,Немесе сырғып құлау.
Dialogue: 0,0:19:09.77,0:19:12.63,Default,,0000,0000,0000,,Қалай болғанда да, сіз жарақат алған жоқсыз ба?
Dialogue: 0,0:19:12.63,0:19:14.99,Default,,0000,0000,0000,,Жоқ, сондықтан мен кіремін.
Dialogue: 0,0:19:14.99,0:19:16.17,Default,,0000,0000,0000,,Бір минут күтіңіз...
Dialogue: 0,0:19:16.17,0:19:20.05,Default,,0000,0000,0000,,Жоқ... Жарайды. Мен зардап шеккен жоқпын.
Dialogue: 0,0:19:20.05,0:19:22.23,Default,,0000,0000,0000,,Сіз ренжідіңіз, солай емес пе?
Dialogue: 0,0:19:22.23,0:19:24.09,Default,,0000,0000,0000,,Әйтеуір, киімімнен ұялып қалдым.
Dialogue: 0,0:19:24.09,0:19:27.12,Default,,0000,0000,0000,,Тағы да, бұл өтірік өтірік емес.
Dialogue: 0,0:19:27.12,0:19:30.82,Default,,0000,0000,0000,,Олай болса, маған қауіпсіз екеніңді көрсет.
Dialogue: 0,0:19:30.82,0:19:34.68,Default,,0000,0000,0000,,Мен мұны киіп, сыртқа шығамын, сондықтан 10 секунд күтіңіз.
Dialogue: 0,0:19:34.68,0:19:37.22,Default,,0000,0000,0000,,10 секунд 10 9
Dialogue: 0,0:19:37.22,0:19:39.57,Default,,0000,0000,0000,,8 7
Dialogue: 0,0:19:39.57,0:19:42.93,Default,,0000,0000,0000,,6 5…
Dialogue: 0,0:19:42.93,0:19:45.80,Default,,0000,0000,0000,,<Мен шындап есептеп жатырмын. Бұл не?>
Dialogue: 0,0:19:45.80,0:19:48.66,Default,,0000,0000,0000,,2 1
Dialogue: 0,0:19:48.66,0:19:50.66,Default,,0000,0000,0000,,Нөл
Dialogue: 0,0:19:52.03,0:19:55.03,Default,,0000,0000,0000,,Форманы қайтаруыңызды өтінемін!
Dialogue: 0,0:19:58.60,0:20:02.29,Default,,0000,0000,0000,,Қорқынышты, біртүрлі, біртүрлі, солай ма? Сондықтан мен айттым.
Dialogue: 0,0:20:02.29,0:20:06.29,Default,,0000,0000,0000,,Менің ойымша, сіз тамаша киінген сияқтысыз.
Dialogue: 0,0:20:07.68,0:20:09.87,Default,,0000,0000,0000,,<Әдеттегі әдеттер>
Dialogue: 0,0:20:09.87,0:20:11.56,Default,,0000,0000,0000,,Формаңызды лас қалдырудың қажеті жоқ.
Dialogue: 0,0:20:11.56,0:20:16.11,Default,,0000,0000,0000,,Бұл ысырап. Бұл сізге шынымен жарасады.
Dialogue: 0,0:20:16.11,0:20:19.11,Default,,0000,0000,0000,,Өзіңіз де солай ойламайсыз ба?
Dialogue: 0,0:20:22.66,0:20:25.66,Default,,0000,0000,0000,,Сізге мұндай нәрсе ұнайды, солай ма?
Dialogue: 0,0:20:27.39,0:20:29.39,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:20:30.42,0:20:36.30,Default,,0000,0000,0000,,Мектепте осылай толық емес жұмыс күнін таңдаған қыздың жиіркеніштісі.
Dialogue: 0,0:20:36.30,0:20:38.30,Default,,0000,0000,0000,,Сіз өте күлкілісіз
Dialogue: 0,0:20:42.70,0:20:46.70,Default,,0000,0000,0000,,Бұл ысырап, сыртта адам көп, мен өзімді ұстаймын.
Dialogue: 0,0:20:48.09,0:20:50.45,Default,,0000,0000,0000,,Әзірге.
Dialogue: 0,0:20:50.45,0:20:52.47,Default,,0000,0000,0000,,Мұнда кел!
Dialogue: 0,0:20:52.47,0:20:55.83,Default,,0000,0000,0000,,Ол сондай болды.
Dialogue: 0,0:20:55.83,0:20:57.35,Default,,0000,0000,0000,,Мен оны мүлде байқамадым
Dialogue: 0,0:20:57.35,0:20:59.70,Default,,0000,0000,0000,,Сезімсіз деп ойламаймын.
Dialogue: 0,0:20:59.70,0:21:01.72,Default,,0000,0000,0000,,Мен оны басынан байқадым.
Dialogue: 0,0:21:01.72,0:21:03.91,Default,,0000,0000,0000,,〈Жаман мінез〉
Dialogue: 0,0:21:03.91,0:21:07.61,Default,,0000,0000,0000,,Бірақ оның оңай құлап кеткеніне шынымды айтсам көңілім қалды.
Dialogue: 0,0:21:07.61,0:21:11.65,Default,,0000,0000,0000,,Мен оны әлдеқайда күшті әйел деп ойладым.
Dialogue: 0,0:21:11.65,0:21:14.36,Default,,0000,0000,0000,,Қызметші болған кезде студенттік кеңестің төрағасы болып жұмыс істейтін әйел.
Dialogue: 0,0:21:14.36,0:21:19.07,Default,,0000,0000,0000,,Мен олардың Миягаока туралы бірдеңе жасайтынын асыға күтемін.
Dialogue: 0,0:21:19.07,0:21:21.43,Default,,0000,0000,0000,,Күте тұрыңыз, мен бір нәрсені дұрыс түсінбедім...
Dialogue: 0,0:21:21.43,0:21:24.43,Default,,0000,0000,0000,,Уайымдамаңыз, бұл жеткілікті.
Dialogue: 0,0:21:26.13,0:21:30.52,Default,,0000,0000,0000,,Егер бұл жеткіліксіз болса, мені одан да қызықтырыңыз.
Dialogue: 0,0:21:30.52,0:21:34.05,Default,,0000,0000,0000,,Көңілді ме? Ол Игараши Зайбацудың келесі жетекшісі.
Dialogue: 0,0:21:34.05,0:21:37.75,Default,,0000,0000,0000,,Мен үшін дәл осы атау
Dialogue: 0,0:21:37.75,0:21:39.77,Default,,0000,0000,0000,,Маған көбірек әйелдер келеді
Dialogue: 0,0:21:39.77,0:21:42.80,Default,,0000,0000,0000,,Мен мойынсұнғыш әйел болудан шаршадым.
Dialogue: 0,0:21:42.80,0:21:45.80,Default,,0000,0000,0000,,Мен сенен үлкен үміт күттім.
Dialogue: 0,0:21:47.35,0:21:51.72,Default,,0000,0000,0000,,Сен де ақшаның арбауына түсіп осында келдің.
Dialogue: 0,0:21:51.72,0:21:53.58,Default,,0000,0000,0000,,Мен олардан өзгере алмаймын.
Dialogue: 0,0:21:53.58,0:21:56.58,Default,,0000,0000,0000,,Қандай ақымақ әйел
Dialogue: 0,0:21:58.13,0:22:00.98,Default,,0000,0000,0000,,Бейшара жігіт.
Dialogue: 0,0:22:00.98,0:22:04.68,Default,,0000,0000,0000,,Сіз әрқашан осындай адамдарды менсіндіңіз бе?
Dialogue: 0,0:22:04.68,0:22:08.72,Default,,0000,0000,0000,,Айналаңыздағы адамдар сұмдық болса
Dialogue: 0,0:22:08.72,0:22:10.74,Default,,0000,0000,0000,,Бұл сенің кінәң.
Dialogue: 0,0:22:10.74,0:22:12.44,Default,,0000,0000,0000,,Бұл дүниеде түкке тұрғысыз адам жоқ.
Dialogue: 0,0:22:12.44,0:22:14.44,Default,,0000,0000,0000,,Бір емес!
Dialogue: 0,0:22:17.15,0:22:19.50,Default,,0000,0000,0000,,Бүгін мен келдім
Dialogue: 0,0:22:19.50,0:22:21.69,Default,,0000,0000,0000,,Миягаокаға шақырудан бас тарту
Dialogue: 0,0:22:21.69,0:22:23.38,Default,,0000,0000,0000,,Тек соны айту үшін.
Dialogue: 0,0:22:23.38,0:22:28.38,Default,,0000,0000,0000,,Менің Seika төрағасы қызметінен кететін ойым жоқ!
Dialogue: 0,0:22:31.12,0:22:33.12,Default,,0000,0000,0000,,Күтілгендей, сіз
Dialogue: 0,0:22:34.15,0:22:36.15,Default,,0000,0000,0000,,Қызықты
Dialogue: 0,0:22:38.19,0:22:41.89,Default,,0000,0000,0000,,Мудая, егер сіз Айкидо болсаңыз
Dialogue: 0,0:22:41.89,0:22:43.74,Default,,0000,0000,0000,,Себебі мен дзюдомен айналысамын
Dialogue: 0,0:22:43.74,0:22:45.74,Default,,0000,0000,0000,,Ол жердегі шайқаста жақсы.
Dialogue: 0,0:22:46.77,0:22:48.77,Default,,0000,0000,0000,,Эй, тоқта...
Dialogue: 0,0:22:57.38,0:22:59.38,Default,,0000,0000,0000,,Ух... Суй
Dialogue: 0,0:23:01.26,0:23:03.26,Default,,0000,0000,0000,,Иә, бәрі осы.
Dialogue: 0,0:23:04.12,0:23:06.12,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:23:07.15,0:23:09.17,Default,,0000,0000,0000,,Сырттағылар ше?
Dialogue: 0,0:23:09.17,0:23:14.89,Default,,0000,0000,0000,,Олар мені кіргізбеді, сондықтан мен аздап жамандық жасадым.
Dialogue: 0,0:23:14.89,0:23:16.24,Default,,0000,0000,0000,,Кешіріңіз~
Dialogue: 0,0:23:16.24,0:23:20.94,Default,,0000,0000,0000,,Олар бұдан да нашар.
Dialogue: 0,0:23:20.94,0:23:22.80,Default,,0000,0000,0000,,Ей, бұзық жігіт
Dialogue: 0,0:23:22.80,0:23:24.82,Default,,0000,0000,0000,,Иә, батыл болма.
Dialogue: 0,0:23:24.82,0:23:26.67,Default,,0000,0000,0000,,Қалай болса да.
Dialogue: 0,0:23:26.67,0:23:29.67,Default,,0000,0000,0000,,Басқа адамды тауып бере аласыз ба?
Dialogue: 0,0:23:32.90,0:23:34.25,Default,,0000,0000,0000,,Бұл жігіт өте оңай
Dialogue: 0,0:23:34.25,0:23:36.44,Default,,0000,0000,0000,,Ол қол тигізетін әйел емес
Dialogue: 0,0:23:36.44,0:23:38.46,Default,,0000,0000,0000,,Сіз айтасыз!
Dialogue: 0,0:23:38.46,0:23:42.16,Default,,0000,0000,0000,,Олай болса, кеттік, төраға.
Dialogue: 0,0:23:42.16,0:23:44.16,Default,,0000,0000,0000,,Сәл күте тұрыңыз...
Dialogue: 0,0:23:46.21,0:23:48.73,Default,,0000,0000,0000,,Төраға Игараши
Dialogue: 0,0:23:48.73,0:23:52.93,Default,,0000,0000,0000,,Менің Сейка орта мектебінің студенттер кеңесінің президенті болғаным дұрыс болса.
Dialogue: 0,0:23:52.93,0:23:55.13,Default,,0000,0000,0000,,Сізбен кез келген уақытта сөйлесейік
Dialogue: 0,0:23:55.13,0:23:57.13,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:24:00.84,0:24:02.69,Default,,0000,0000,0000,,Усуй, сен мұнда неге келдің?
Dialogue: 0,0:24:02.69,0:24:05.73,Default,,0000,0000,0000,,Төраға, мені әлгі бұзақы алдап жатыр.
Dialogue: 0,0:24:05.73,0:24:08.09,Default,,0000,0000,0000,,Ал сен мені осылай атадың.
Dialogue: 0,0:24:08.09,0:24:10.28,Default,,0000,0000,0000,,Сіз не айттыңыз?
Dialogue: 0,0:24:10.28,0:24:13.28,Default,,0000,0000,0000,,Мен сізге қоңырау шалған жоқпын...
Dialogue: 0,0:24:17.01,0:24:21.01,Default,,0000,0000,0000,,《Мен Seika төрағасы қызметінен кететін ойым жоқ! 》
Dialogue: 0,0:24:23.74,0:24:26.74,Default,,0000,0000,0000,,Бірақ жақсы
Dialogue: 0,0:24:30.48,0:24:32.48,Default,,0000,0000,0000,,А, мен оны білдім бе?
Dialogue: 0,0:24:34.02,0:24:36.20,Default,,0000,0000,0000,,Усуи
Dialogue: 0,0:24:36.20,0:24:39.20,Default,,0000,0000,0000,,Ах, рахмет.
Dialogue: 0,0:24:45.29,0:24:47.82,Default,,0000,0000,0000,,Мен формамды қайтарып алдым.
Dialogue: 0,0:24:47.82,0:24:50.18,Default,,0000,0000,0000,,Мата мен тігін бұйымдары Миягаоканың ең жоғары сапасы
Dialogue: 0,0:24:50.18,0:24:54.05,Default,,0000,0000,0000,,Қайсысы жақсы, төраға үнемі киетін Сейка?
Dialogue: 0,0:24:54.05,0:24:57.05,Default,,0000,0000,0000,,Оны тез қайтарыңыз! Менің ойымша, бұл солай
Dialogue: 0,0:25:06.67,0:25:08.85,Default,,0000,0000,0000,,Төраға
Dialogue: 0,0:25:08.85,0:25:10.85,Default,,0000,0000,0000,,Мастер~
Dialogue: 0,0:25:13.24,0:25:15.09,Default,,0000,0000,0000,,Балалар
Dialogue: 0,0:25:15.09,0:25:18.79,Default,,0000,0000,0000,,Мисаки-сан Мисаки~
Dialogue: 0,0:25:18.79,0:25:21.82,Default,,0000,0000,0000,,Мен аудару туралы өтініштен үзілді-кесілді бас тарттым.
Dialogue: 0,0:25:21.82,0:25:23.51,Default,,0000,0000,0000,,Барлығыңызға сенімді болыңыз.
Dialogue: 0,0:25:23.51,0:25:25.51,Default,,0000,0000,0000,,Қайта оралдын.
Dialogue: 0,0:25:26.04,0:25:30.04,Default,,0000,0000,0000,,Неліктен Усуй?
Dialogue: 0,0:25:37.48,0:25:40.48,Default,,0000,0000,0000,,Хонма Оморои әйелі
Dialogue: 0,0:25:45.22,0:26:29.22,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:30.35,0:27:14.61,Default,,0000,0000,0000,,
Dialogue: 0,0:27:16.11,0:27:22.11,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory