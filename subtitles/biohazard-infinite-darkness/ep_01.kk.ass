Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.08,0:00:22.25,Default,,0,0,0,,Койот 6 Қазіргі орны базадан солтүстік-батысқа қарай 70 миль жерде.
Dialogue: 0,0:00:22.33,0:00:23.54,Default,,0,0,0,,2000 жылдың қазаны Пенумстан Республикасы Қону нұсқаулары
Dialogue: 0,0:00:23.54,0:00:23.62,Default,,0,0,0,,2000 жылдың қазаны Пенумстан Республикасы
Dialogue: 0,0:00:23.62,0:00:26.83,Default,,0,0,0,,2000 жылдың қазаны Пенумстан Республикасы Бұл штаб-пәтер №3 ҰҚЖ.
Dialogue: 0,0:00:26.91,0:00:28.95,Default,,0,0,0,,АҚШ әскери базасынан 70 миль қашықтықта 50 градустан 14 түйінге дейін жел соғады
Dialogue: 0,0:00:28.95,0:00:29.04,Default,,0,0,0,,АҚШ әскери базасынан 70 миль
Dialogue: 0,0:00:29.04,0:00:29.66,Default,,0,0,0,,АҚШ әскери базасынан 70 миль Биіктік шегі 2974 дюйм
Dialogue: 0,0:00:29.66,0:00:32.33,Default,,0,0,0,,Биіктік шегі - 2974 дюйм.
Dialogue: 0,0:00:34.12,0:00:36.95,Default,,0,0,0,,Мамыр! Мен соққы алдым!
Dialogue: 0,0:00:42.04,0:00:45.87,Default,,0,0,0,,Mad Dogs Team Alpha 2 көрді
Dialogue: 0,0:00:45.95,0:00:49.75,Default,,0,0,0,,Координаталар 42SWA 9465067929
Dialogue: 0,0:00:49.83,0:00:51.83,Default,,0,0,0,,Басқа құрылғылар күту режимінде.
Dialogue: 0,0:00:51.91,0:00:54.79,Default,,0,0,0,,3 және 6 командалар күту режимінде.
Dialogue: 0,0:00:54.87,0:00:55.87,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:00:55.95,0:00:57.91,Default,,0,0,0,,3 және 6 топтарды қайталау...
Dialogue: 0,0:00:58.00,0:01:00.87,Default,,0,0,0,,Түсуге дайындық Күйді тексеру
Dialogue: 0,0:01:11.54,0:01:14.29,Default,,0,0,0,,Апат болған жерде көптеген милиция
Dialogue: 0,0:01:16.83,0:01:20.04,Default,,0,0,0,,Әскерлерге шабуыл жасалуда
Dialogue: 0,0:01:28.12,0:01:31.29,Default,,0,0,0,,Штабқа Жауды қолдау үшін тартыңыз
Dialogue: 0,0:01:31.37,0:01:34.16,Default,,0,0,0,,Күтуге рұқсат етілмейді.
Dialogue: 0,0:01:34.25,0:01:35.79,Default,,0,0,0,,Шабуыл жасау
Dialogue: 0,0:01:35.87,0:01:37.37,Default,,0,0,0,,Қай бірлік?
Dialogue: 0,0:01:37.45,0:01:39.20,Default,,0,0,0,,Ақылсыз иттер отряды
Dialogue: 0,0:01:39.29,0:01:42.87,Default,,0,0,0,,Ей, ақымақ, оған қайта қалыптасып кетсін деп айт.
Dialogue: 0,0:01:42.95,0:01:44.95,Default,,0,0,0,,Mad Dogs отрядына...
Dialogue: 0,0:01:45.04,0:01:48.00,Default,,0,0,0,,Отрядты қолдау қаруларымен қамтамасыз еткеннен кейін——
Dialogue: 0,0:01:48.08,0:01:50.25,Default,,0,0,0,,Тірі қалғандарды құтқару
Dialogue: 0,0:01:50.95,0:01:54.12,Default,,0,0,0,,Mad Dogs жасағы, дереу құрамға оралыңыз.
Dialogue: 0,0:02:15.66,0:02:16.29,Default,,0,0,0,,Таза!
Dialogue: 0,0:02:16.37,0:02:17.70,Default,,0,0,0,,Менің серігім қолға түсті.
Dialogue: 0,0:02:26.12,0:02:27.66,Default,,0,0,0,,Бір адам бар.
Dialogue: 0,0:02:29.75,0:02:31.45,Default,,0,0,0,,Сіз қозғала аласыз ба?
Dialogue: 0,0:02:34.83,0:02:35.66,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:02:39.66,0:02:41.25,Default,,0,0,0,,Жарайды, мен дем алып жатырмын.
Dialogue: 0,0:03:28.25,0:03:34.04,Default,,0,0,0,,Капкомның «Resident Evil» ойынына негізделген
Dialogue: 0,0:04:28.83,0:04:31.41,Default,,0,0,0,,2006 ж
Dialogue: 0,0:04:31.50,0:04:35.16,Default,,0,0,0,,Пенумстан Республикасы Біріккен Ұлттар Ұйымының босқындар лагері
Dialogue: 0,0:04:35.25,0:04:36.33,Default,,0,0,0,,Сәлем
Dialogue: 0,0:04:37.45,0:04:38.79,Default,,0,0,0,,Мен Клэрмін
Dialogue: 0,0:04:39.62,0:04:42.83,Default,,0,0,0,,Клэр Редфилд Сіздің атыңыз кім?
Dialogue: 0,0:04:53.29,0:04:56.66,Default,,0,0,0,,Жоқ, мен сөздерді үйренуім керек еді.
Dialogue: 0,0:04:56.75,0:05:00.95,Default,,0,0,0,,Жоқ, бала сөйлей алмайды.
Dialogue: 0,0:05:01.04,0:05:02.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:02.75,0:05:06.41,Default,,0,0,0,,Азамат соғысынан кейін мен мылқау болдым.
Dialogue: 0,0:05:07.91,0:05:09.08,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:05:11.25,0:05:13.54,Default,,0,0,0,,Сіз шынымен қорқынышты нәрсені көрдіңіз.
Dialogue: 0,0:05:15.41,0:05:16.29,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:17.04,0:05:18.58,Default,,0,0,0,,Егер сіз осында қалсаңыз——
Dialogue: 0,0:05:19.83,0:05:21.16,Default,,0,0,0,,Бұл қауіпсіз.
Dialogue: 0,0:05:22.70,0:05:24.45,Default,,0,0,0,,Біз
Dialogue: 0,0:05:26.45,0:05:28.29,Default,,0,0,0,,Сіз жиі сурет саласыз ба?
Dialogue: 0,0:05:30.20,0:05:31.83,Default,,0,0,0,,Мен оны көре аламын ба?
Dialogue: 0,0:05:57.08,0:05:58.66,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:06:01.00,0:06:02.58,Default,,0,0,0,,Сіз мұны көрдіңіз бе?
Dialogue: 0,0:06:13.70,0:06:17.95,Default,,0,0,0,,DC20217 Бұл — «Көкшелер» ойыны
Dialogue: 0,0:06:18.04,0:06:22.62,Default,,0,0,0,,ҰҚЖ 01. Жел 30 градус және 5 түйін.
Dialogue: 0,0:06:28.37,0:06:31.16,Default,,0,0,0,,30 минут президент үшін жақсы...
Dialogue: 0,0:06:32.58,0:06:37.41,Default,,0,0,0,,Конгресс мүшесінің шұғыл шақыруы? Тек кейінірек қалдырыңыз.
Dialogue: 0,0:06:37.50,0:06:39.25,Default,,0,0,0,,Сіз үшінші адамсыз ба?
Dialogue: 0,0:06:39.33,0:06:41.54,Default,,0,0,0,,Төртінші адамға не болды?
Dialogue: 0,0:06:41.62,0:06:43.54,Default,,0,0,0,,Жақында Леон да осында болады.
Dialogue: 0,0:06:44.33,0:06:45.66,Default,,0,0,0,,Леон?
Dialogue: 0,0:06:45.75,0:06:48.95,Default,,0,0,0,,Президенттің қызын құтқарған адам туралы?
Dialogue: 0,0:06:49.04,0:06:53.04,Default,,0,0,0,,Иә, бұл Леон керемет сияқты.
Dialogue: 0,0:06:53.12,0:06:56.33,Default,,0,0,0,,Өте жақсы? тек сәттілік
Dialogue: 0,0:06:56.41,0:07:00.95,Default,,0,0,0,,Кездейсоқ болған істің арқасында есімді атадым.
Dialogue: 0,0:07:02.70,0:07:06.00,Default,,0,0,0,,Ол көптеген маңызды істерді шешті.
Dialogue: 0,0:07:06.08,0:07:08.87,Default,,0,0,0,,Бүгін де тапсырмадан кейін осында келіңіз.
Dialogue: 0,0:07:08.95,0:07:09.87,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:09.95,0:07:12.83,Default,,0,0,0,,Біздің жұмыс сәттілікке сене алмайды.
Dialogue: 0,0:07:12.91,0:07:14.41,Default,,0,0,0,,Қабілеттілік қажет
Dialogue: 0,0:07:17.08,0:07:18.45,Default,,0,0,0,,Дайын
Dialogue: 0,0:07:25.37,0:07:28.58,Default,,0,0,0,,«Пенхамстанның Батырымен» жұмыс істеу құрметті
Dialogue: 0,0:07:29.20,0:07:30.45,Default,,0,0,0,,Батыр?
Dialogue: 0,0:07:32.87,0:07:33.70,Default,,0,0,0,,Иә
Dialogue: 0,0:07:37.08,0:07:42.25,Default,,0,0,0,,Түсінікті ҰҚЖ 01 Жел 30 градус және 5 түйін.
Dialogue: 0,0:07:43.75,0:07:46.95,Default,,0,0,0,,Қону рұқсаты дереу беріледі.
Dialogue: 0,0:07:47.04,0:07:48.83,Default,,0,0,0,,Сіз ерекше адамсыз, солай емес пе?
Dialogue: 0,0:08:00.50,0:08:02.58,Default,,0,0,0,,Рұқсат етілмеген кіру?
Dialogue: 0,0:08:02.66,0:08:07.00,Default,,0,0,0,,Іздер президенттің құзырындағы өте құпия файлдарда болды.
Dialogue: 0,0:08:09.08,0:08:12.70,Default,,0,0,0,,Президент Райанның көмекшісі мен үш агент келеді.
Dialogue: 0,0:08:12.79,0:08:14.79,Default,,0,0,0,,Түсінді. Батыс ғимаратындағы жағдай қандай?
Dialogue: 0,0:08:14.87,0:08:15.87,Default,,0,0,0,,Аномалия жоқ
Dialogue: 0,0:08:17.12,0:08:21.66,Default,,0,0,0,,Бір адам кешігіп келді, бірақ бұл үшеуі де тамаша...
Dialogue: 0,0:08:21.75,0:08:24.29,Default,,0,0,0,,Қорғаныс министрі Уилсонды бастайық
Dialogue: 0,0:08:24.37,0:08:28.50,Default,,0,0,0,,Кеше серверге заңсыз кіру болды.
Dialogue: 0,0:08:28.58,0:08:34.16,Default,,0,0,0,,Онда әскери құпиялар мен аса құпия ақпарат бар.
Dialogue: 0,0:08:34.70,0:08:38.33,Default,,0,0,0,,Оны көру үшін сізге президенттің рұқсат коды қажет болады...
Dialogue: 0,0:08:38.41,0:08:41.00,Default,,0,0,0,,Мен рұқсат берген жоқпын
Dialogue: 0,0:08:41.08,0:08:44.62,Default,,0,0,0,,Бұл маңызды сервер болса да, оған сырттан кіруге болады ма?
Dialogue: 0,0:08:44.70,0:08:47.04,Default,,0,0,0,,Сырттан кіру мүмкін емес.
Dialogue: 0,0:08:48.16,0:08:51.50,Default,,0,0,0,,Толығымен жергілікті ортада оқшауланған
Dialogue: 0,0:08:51.58,0:08:53.70,Default,,0,0,0,,Басқаша айтқанда, бұл ішкі қылмыс па?
Dialogue: 0,0:08:53.79,0:08:57.29,Default,,0,0,0,,Мен бақылау камерасының түсірілімін талдадым, бірақ...
Dialogue: 0,0:08:57.37,0:09:00.20,Default,,0,0,0,,Күдікті анықталмады
Dialogue: 0,0:09:00.29,0:09:04.25,Default,,0,0,0,,Қылмыс жасалғанға дейін және одан кейін 24 сағат ішінде кірген және кеткен.
Dialogue: 0,0:09:04.33,0:09:06.87,Default,,0,0,0,,үшін күдікті
Dialogue: 0,0:09:07.62,0:09:09.83,Default,,0,0,0,,Біз алынып тасталды.
Dialogue: 0,0:09:09.91,0:09:13.62,Default,,0,0,0,,Сайтқа заңсыз кірген адамды ұстаңыз.
Dialogue: 0,0:09:14.54,0:09:17.66,Default,,0,0,0,,Алдымен бақылау камерасынан түсірілген бейнелерді қарастырайық.
Dialogue: 0,0:09:17.75,0:09:20.75,Default,,0,0,0,,Жалықтыратын жұмысты басқа біреуге тапсырыңыз
Dialogue: 0,0:09:20.83,0:09:23.62,Default,,0,0,0,,Кінәлі анықталды
Dialogue: 0,0:09:23.70,0:09:25.79,Default,,0,0,0,,Тағы да кешірім сұраймын.
Dialogue: 0,0:09:25.87,0:09:29.54,Default,,0,0,0,,Қытай кибершабуылының жылдары——
Dialogue: 0,0:09:29.62,0:09:33.25,Default,,0,0,0,,Тәуекел тобындағы үкімет, әскери және азаматтық тұлғалар
Dialogue: 0,0:09:33.33,0:09:35.12,Default,,0,0,0,,Бұл бастамасы ғана...
Dialogue: 0,0:09:35.20,0:09:36.54,Default,,0,0,0,,Қорғаныс министрі
Dialogue: 0,0:09:36.62,0:09:39.54,Default,,0,0,0,,Болжамдар жағдайды нашарлатады
Dialogue: 0,0:09:39.62,0:09:43.62,Default,,0,0,0,,Орынсыз болжам жасаудан аулақ болыңыз.
Dialogue: 0,0:09:45.12,0:09:47.75,Default,,0,0,0,,Күніне жүздеген адам келіп-кетеді.
Dialogue: 0,0:09:47.83,0:09:51.87,Default,,0,0,0,,Президенттің отбасы мүшелері, оның ішінде қызметкерлер мен мемлекеттік қызметкерлер
Dialogue: 0,0:09:51.95,0:09:54.25,Default,,0,0,0,,Тіпті бағбандар да тергеуге жатады...
Dialogue: 0,0:09:56.16,0:09:57.62,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:09:59.79,0:10:01.70,Default,,0,0,0,,Тыныш, барлығы жатады.
Dialogue: 0,0:10:01.79,0:10:04.04,Default,,0,0,0,,Аңды күту режимінде ұстаңыз
Dialogue: 0,0:10:06.75,0:10:08.25,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:08.79,0:10:10.83,Default,,0,0,0,,Резервтік қуат туралы не деуге болады?
Dialogue: 0,0:10:10.91,0:10:13.79,Default,,0,0,0,,Оны қолмен орнатсаңыз да, апаттық шамдар тек жанады.
Dialogue: 0,0:10:13.87,0:10:15.16,Default,,0,0,0,,Тексеру
Dialogue: 0,0:10:15.25,0:10:17.62,Default,,0,0,0,,Электр жүйесі туралы не айтасыз?
Dialogue: 0,0:10:17.70,0:10:19.16,Default,,0,0,0,,Жауап беру
Dialogue: 0,0:10:19.25,0:10:21.79,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:22.75,0:10:26.33,Default,,0,0,0,,Бұл кездейсоқ емес. Мен сыртқа қараймын.
Dialogue: 0,0:10:26.41,0:10:27.91,Default,,0,0,0,,Патрик, жүр.
Dialogue: 0,0:10:28.00,0:10:29.20,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:34.20,0:10:38.83,Default,,0,0,0,,Сабыр сақтаңыз және кеңседе күтіңіз.
Dialogue: 0,0:11:01.33,0:11:03.91,Default,,0,0,0,,Баспасөз хатшысы Спейсер, не болып жатыр?
Dialogue: 0,0:11:04.00,0:11:07.08,Default,,0,0,0,,Мен білмеймін. Жарық сөнді...
Dialogue: 0,0:11:07.16,0:11:08.83,Default,,0,0,0,,Артынан шабуыл жасалды
Dialogue: 0,0:11:08.91,0:11:11.54,Default,,0,0,0,,Сіз басқа адамды көрдіңіз бе?
Dialogue: 0,0:11:13.08,0:11:14.12,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:16.25,0:11:19.41,Default,,0,0,0,,Қауіпсіз баспасөз қызметкері жарақат алды.
Dialogue: 0,0:11:19.50,0:11:22.50,Default,,0,0,0,,Мойын жарақаты бар, бірақ есінде.
Dialogue: 0,0:11:22.58,0:11:23.41,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:23.50,0:11:26.50,Default,,0,0,0,,Маған біреу шабуыл жасады және медициналық көмек қажет
Dialogue: 0,0:11:27.12,0:11:29.25,Default,,0,0,0,,Мынаны осында қалдыр, мен жоғарыға шығамын.
Dialogue: 0,0:11:32.00,0:11:34.25,Default,,0,0,0,,Баспасөзші нық
Dialogue: 0,0:11:34.33,0:11:35.91,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:11:39.95,0:11:43.58,Default,,0,0,0,,Баспасөз қызметкерінің жүрегі тоқтап қалды, AED қолданады
Dialogue: 0,0:11:54.62,0:11:55.91,Default,,0,0,0,,Баспасөз қызметкері?
Dialogue: 0,0:12:03.83,0:12:05.33,Default,,0,0,0,,Жақын келсе атыңыз
Dialogue: 0,0:12:29.20,0:12:30.20,Default,,0,0,0,,Леон?
Dialogue: 0,0:12:30.75,0:12:33.20,Default,,0,0,0,,Басынан атып таста, тоқтайды.
Dialogue: 0,0:12:33.83,0:12:34.58,Default,,0,0,0,,Кеттік
Dialogue: 0,0:12:38.16,0:12:42.45,Default,,0,0,0,,Зомбилерді жоюды және SWAT-қа электр қуатын қалпына келтіруді қалдырыңыз.
Dialogue: 0,0:12:42.54,0:12:44.04,Default,,0,0,0,,Біз баспанаға барамыз
Dialogue: 0,0:12:44.58,0:12:46.12,Default,,0,0,0,,Олар шынымен зомби ме?
Dialogue: 0,0:12:46.20,0:12:47.16,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:12:47.25,0:12:48.87,Default,,0,0,0,,Осы киімде ыстық емес пе?
Dialogue: 0,0:12:48.95,0:12:52.75,Default,,0,0,0,,Жарайды, мен саған Эшли туралы қамқорлық жасадым.
Dialogue: 0,0:12:52.83,0:12:56.50,Default,,0,0,0,,Сіздің осында болуыңыз сізді тыныштандырады.
Dialogue: 0,0:12:57.08,0:13:00.75,Default,,0,0,0,,Дәл осындай жағдай Ракон-Ситиде де болады.
Dialogue: 0,0:13:00.83,0:13:01.58,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:13:03.20,0:13:06.04,Default,,0,0,0,,Президентті қорғап, баспанаға барыңыз
Dialogue: 0,0:13:06.12,0:13:07.33,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:13:25.16,0:13:26.70,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:13:30.41,0:13:32.41,Default,,0,0,0,,Патрик президентті қорғайды
Dialogue: 0,0:13:32.50,0:13:34.83,Default,,0,0,0,,Леон Шенмей, менімен бірге жүр.
Dialogue: 0,0:13:36.87,0:13:38.66,Default,,0,0,0,,Мен саған үлкен үміт артамын.
Dialogue: 0,0:13:41.12,0:13:41.75,Default,,0,0,0,,Эй
Dialogue: 0,0:13:43.08,0:13:44.29,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:13:45.00,0:13:46.20,Default,,0,0,0,,О
Dialogue: 0,0:13:46.79,0:13:49.29,Default,,0,0,0,,Мен аздап ренжідім.
Dialogue: 0,0:13:50.12,0:13:52.12,Default,,0,0,0,,Мен зомбилерді бірінші рет көріп тұрмын.
Dialogue: 0,0:13:53.75,0:13:55.16,Default,,0,0,0,,Мен ертерек құтқарылдым.
Dialogue: 0,0:13:56.00,0:13:57.12,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:14:01.33,0:14:04.37,Default,,0,0,0,,Алыста болсаң да жау екенін білсең, ат.
Dialogue: 0,0:14:07.58,0:14:10.25,Default,,0,0,0,,Оларды баспанаңызға жақындатпаңыз.
Dialogue: 0,0:14:10.33,0:14:11.54,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:14:11.62,0:14:12.70,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:09.41,0:16:11.54,Default,,0,0,0,,Жатқан жерің жайлы болсын, қарғыс атсын.
Dialogue: 0,0:16:25.41,0:16:26.83,Default,,0,0,0,,Т-вирус?
Dialogue: 0,0:16:28.29,0:16:30.66,Default,,0,0,0,,Тест нәтижелерін растау керек
Dialogue: 0,0:16:31.29,0:16:35.70,Default,,0,0,0,,Ең үлкен мәселе - зомбилердің Ақ үйде болуы.
Dialogue: 0,0:16:40.58,0:16:42.29,Default,,0,0,0,,Мұны кім жасады...
Dialogue: 0,0:16:43.91,0:16:46.41,Default,,0,0,0,,«Тазалау кезінде кіруге болмайды»
Dialogue: 0,0:16:50.75,0:16:55.37,Default,,0,0,0,,Мен Пенумстанды қолдайтын үкіметтік емес ұйымнанмын.
Dialogue: 0,0:16:55.45,0:16:56.62,Default,,0,0,0,,Мен сұрасам болады ма?
Dialogue: 0,0:16:56.70,0:16:57.70,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:16:57.79,0:17:01.29,Default,,0,0,0,,Баспасөз хатшысы Спейсер қазір қайда?
Dialogue: 0,0:17:01.37,0:17:03.33,Default,,0,0,0,,Мен демалыстамын
Dialogue: 0,0:17:03.41,0:17:06.29,Default,,0,0,0,,Демалыс? Мен кездесуді белгіледім
Dialogue: 0,0:17:06.37,0:17:09.66,Default,,0,0,0,,Күнді қате түсіндіңіз бе?
Dialogue: 0,0:17:09.75,0:17:12.83,Default,,0,0,0,,Мен мұнда емеспін. Кешіріңіз.
Dialogue: 0,0:17:18.79,0:17:19.87,Default,,0,0,0,,Леон?
Dialogue: 0,0:17:22.29,0:17:23.12,Default,,0,0,0,,Клэр?
Dialogue: 0,0:17:23.75,0:17:25.37,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:17:25.45,0:17:28.45,Default,,0,0,0,,Мен Пенумстан уақытша үкіметінің өкілімен келдім.
Dialogue: 0,0:17:28.54,0:17:31.70,Default,,0,0,0,,Мектептер мен ауруханалар салу туралы петиция
Dialogue: 0,0:17:31.79,0:17:33.16,Default,,0,0,0,,Пенумстан?
Dialogue: 0,0:17:33.25,0:17:36.91,Default,,0,0,0,,Америка Құрама Штаттары сол жерде әскер қалдырғысы келеді, солай ма?
Dialogue: 0,0:17:37.00,0:17:40.29,Default,,0,0,0,,Келесі аптада станциялық келісімге қол қою рәсімі болады.
Dialogue: 0,0:17:41.12,0:17:44.66,Default,,0,0,0,,Эй, мен сенің бірдеңе көргім келеді.
Dialogue: 0,0:17:44.75,0:17:47.16,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:48.50,0:17:50.50,Default,,0,0,0,,Оны бір бала салды.
Dialogue: 0,0:17:50.58,0:17:53.20,Default,,0,0,0,,Алты жыл бұрын Пенумстандағы азамат соғысы
Dialogue: 0,0:17:55.50,0:17:58.29,Default,,0,0,0,,Бұл Ракон қаласы сияқты емес пе?
Dialogue: 0,0:18:00.58,0:18:03.83,Default,,0,0,0,,Мен шындықты білмеймін, бірақ
Dialogue: 0,0:18:03.91,0:18:06.50,Default,,0,0,0,,Осы суретке қарағанда——
Dialogue: 0,0:18:06.58,0:18:08.16,Default,,0,0,0,,Вирус тудыруы мүмкін
Dialogue: 0,0:18:09.95,0:18:13.08,Default,,0,0,0,,Леон, бізде уақыт жоқ, тезірек барайық.
Dialogue: 0,0:18:14.87,0:18:15.70,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:18:16.41,0:18:20.00,Default,,0,0,0,,Қазіргі адамдар «Пенумстанның батырлары» ма?
Dialogue: 0,0:18:20.08,0:18:21.25,Default,,0,0,0,,Бұл шынайы
Dialogue: 0,0:18:22.66,0:18:24.50,Default,,0,0,0,,Мен қазір кетуім керек.
Dialogue: 0,0:18:25.58,0:18:27.58,Default,,0,0,0,,Тек қауіпті ештеңе жасамаңыз.
Dialogue: 0,0:18:27.66,0:18:29.29,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:30.12,0:18:31.25,Default,,0,0,0,,Леон
Dialogue: 0,0:18:33.04,0:18:35.16,Default,,0,0,0,,Ол костюм саған жараспайды.
Dialogue: 0,0:18:43.12,0:18:47.66,Default,,0,0,0,,Президент Қорғаныс барлау агенттігінің (ІІД) хакерлік талдауына сәйкес
Dialogue: 0,0:18:47.75,0:18:52.04,Default,,0,0,0,,Қытайға қарсы өте құпия файлдарға қол жеткізілді
Dialogue: 0,0:18:52.12,0:18:52.95,Default,,0,0,0,,Қытай?
Dialogue: 0,0:18:53.04,0:18:58.45,Default,,0,0,0,,Шанхайдағы Биология ғылымдары институты туралы мәліметтер
Dialogue: 0,0:18:59.41,0:19:01.04,Default,,0,0,0,,Биология ғылымдары институты?
Dialogue: 0,0:19:01.12,0:19:04.62,Default,,0,0,0,,Джейсон мен оның достарына тергеуге рұқсат етіңіз.
Dialogue: 0,0:19:04.70,0:19:06.75,Default,,0,0,0,,Бірден рұқсатпен
Dialogue: 0,0:19:06.83,0:19:11.50,Default,,0,0,0,,Қытайды арандатуға асықпа
Dialogue: 0,0:19:11.58,0:19:15.04,Default,,0,0,0,,Ішкі қауіпсіздік департаменті (DHS) және ЦРУ рұқсаты...
Dialogue: 0,0:19:15.12,0:19:16.29,Default,,0,0,0,,Президент
Dialogue: 0,0:19:16.37,0:19:19.45,Default,,0,0,0,,Бұзушылықтан кейін вирустық оқиға орын алды.
Dialogue: 0,0:19:19.54,0:19:21.29,Default,,0,0,0,,Ақ үй——
Dialogue: 0,0:19:21.37,0:19:23.04,Default,,0,0,0,,Бізге шабуыл жасалды!
Dialogue: 0,0:19:48.62,0:19:49.75,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:50.37,0:19:51.54,Default,,0,0,0,,Жалғастыру.
Dialogue: 0,0:19:52.12,0:19:52.70,Default,,0,0,0,,АҚШ әскери-теңіз базасы Гуам-Апра порты
Dialogue: 0,0:19:52.70,0:19:56.20,Default,,0,0,0,,АҚШ Әскери-теңіз базасы Гуам Апра Порт Вирджиния А класындағы модификацияланған ядролық сүңгуір қайық.
Dialogue: 0,0:19:56.20,0:19:56.29,Default,,0,0,0,,АҚШ әскери-теңіз базасы Гуам-Апра порты
Dialogue: 0,0:19:56.29,0:19:56.91,Default,,0,0,0,,АҚШ Әскери-теңіз базасы Гуам-Апра порты Шығыс теңіз флотының тікелей астында, сізді көлік қорабында тасымалдаңыз.
Dialogue: 0,0:19:56.91,0:20:01.04,Default,,0,0,0,,Токай флотының дәл астына барып, сізді көлік алаңына апарыңыз.
Dialogue: 0,0:20:01.12,0:20:03.79,Default,,0,0,0,,Межелі жерге аман-есен жеткізіңіз
Dialogue: 0,0:20:03.87,0:20:07.91,Default,,0,0,0,,Бұл ең озық стелс технологиясымен жабдықталған сүңгуір қайық.
Dialogue: 0,0:20:08.00,0:20:10.54,Default,,0,0,0,,Мен осындай тапсырманы күттім.
Dialogue: 0,0:20:10.62,0:20:15.12,Default,,0,0,0,,Жасырын жүргенде шу шығармаңыз. Бұл халықаралық мәселеге айналса...
Dialogue: 0,0:20:18.20,0:20:19.37,Default,,0,0,0,,Сүңгудің басталуы
Dialogue: 0,0:20:19.45,0:20:22.45,Default,,0,0,0,,Сүңгу тереңдігі 15 фут, бұрышы 5 градус.
Dialogue: 0,0:20:22.54,0:20:25.29,Default,,0,0,0,,Сүңгу тереңдігі 15 фут Бұрыш 5 градус
Dialogue: 0,0:20:31.08,0:20:32.95,Default,,0,0,0,,Сонымен стратегия қандай?
Dialogue: 0,0:20:35.16,0:20:39.08,Default,,0,0,0,,Биология ғылымын зерттеу институтына үш адам кіріп келеді.
Dialogue: 0,0:20:39.16,0:20:43.16,Default,,0,0,0,,Рұқсатсыз кіру және биотерроризмнің дәлелдерін ұрлау.
Dialogue: 0,0:20:43.25,0:20:45.37,Default,,0,0,0,,Мәліметтер қонғаннан кейін талқыланады.
Dialogue: 0,0:20:45.95,0:20:49.75,Default,,0,0,0,,Неліктен оны бұзуға болады?
Dialogue: 0,0:20:50.58,0:20:53.45,Default,,0,0,0,,Мен қазір жауап бере алмаймын, бұл өте құпия.
Dialogue: 0,0:20:55.95,0:20:58.04,Default,,0,0,0,,Институттың мәліметтері қандай?
Dialogue: 0,0:20:58.12,0:20:59.87,Default,,0,0,0,,Бұл да өте құпия
Dialogue: 0,0:21:00.75,0:21:02.08,Default,,0,0,0,,Ол қашан аяқталады деп жоспарланған?
Dialogue: 0,0:21:02.66,0:21:04.54,Default,,0,0,0,,«Аса құпия»
Dialogue: 0,0:21:07.12,0:21:09.37,Default,,0,0,0,,Жабдықты тексеріңіз
Dialogue: 0,0:21:10.70,0:21:12.08,Default,,0,0,0,,Үзіліс жасаңыз
Dialogue: 0,0:21:16.12,0:21:17.66,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:21:18.95,0:21:21.25,Default,,0,0,0,,Бөлшектерді алғаннан кейін тамақ ішуге қалай қарайсыз?
Dialogue: 0,0:21:21.33,0:21:25.20,Default,,0,0,0,,Иә, бірақ мені бір жас жігіт күтіп тұр.
Dialogue: 0,0:21:26.08,0:21:27.33,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:21:27.41,0:21:29.95,Default,,0,0,0,,Қосымша ақпарат қатаң құпия болып табылады.
Dialogue: 0,0:21:34.29,0:21:35.41,Default,,0,0,0,,Әзірге.
Dialogue: 0,0:23:22.41,0:23:26.58,Default,,0,0,0,,Хироюки Кобаяши жетекшілік етеді
Dialogue: 0,0:25:11.12,0:25:14.04,Default,,0,0,0,,Жапон субтитрлері Канан Фукузава
Dialogue: 0,0:25:15.54,0:25:21.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
