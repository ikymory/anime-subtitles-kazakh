Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.79,0:00:29.16,Default,,0,0,0,,«2006 жылғы Бейбітшілік келісімі»
Dialogue: 0,0:00:36.83,0:00:37.95,Default,,0,0,0,,Уақыт келді.
Dialogue: 0,0:00:45.37,0:00:49.29,Default,,0,0,0,,Эндрюс әуе күштерінің базасы
Dialogue: 0,0:00:56.12,0:00:57.70,Default,,0,0,0,,Бұқаралық ақпарат құралдарымен жұмыс
Dialogue: 0,0:00:57.79,0:00:58.66,Default,,0,0,0,,Мен маңызды адаммын
Dialogue: 0,0:00:58.75,0:01:01.50,Default,,0,0,0,,Жарайды, егер сізде бірдеңе болса, хабарлаңыз.
Dialogue: 0,0:01:01.58,0:01:02.75,Default,,0,0,0,,Қазір оралу
Dialogue: 0,0:01:03.75,0:01:04.58,Default,,0,0,0,,Иә
Dialogue: 0,0:01:06.20,0:01:08.20,Default,,0,0,0,,Бұл сөзсіз өтірік...
Dialogue: 0,0:01:08.95,0:01:10.50,Default,,0,0,0,,Мен өлді деп ойладым
Dialogue: 0,0:01:10.58,0:01:12.70,Default,,0,0,0,,Күте тұрыңыз, мен әңгімені бақылай алмаймын.
Dialogue: 0,0:01:13.66,0:01:15.37,Default,,0,0,0,,Ол сене ме?
Dialogue: 0,0:01:15.45,0:01:18.00,Default,,0,0,0,,Жоқ, мен сенемін...
Dialogue: 0,0:01:20.25,0:01:21.45,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:01:39.87,0:01:41.20,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:01:45.00,0:01:46.62,Default,,0,0,0,,Вильсон
Dialogue: 0,0:01:46.70,0:01:51.16,Default,,0,0,0,,Саған тыйым салғаным үшін кешірім сұраймын. Мен сіздің назарыңызды оқиғаға аударғаныңызды қалаймын.
Dialogue: 0,0:01:51.25,0:01:55.54,Default,,0,0,0,,Жақында осы нысанда қол қою рәсімі басталады.
Dialogue: 0,0:01:55.62,0:01:57.25,Default,,0,0,0,,Қысқаша жазыңыз
Dialogue: 0,0:01:57.33,0:02:02.00,Default,,0,0,0,,Мен сізді Ракон Ситиден аман қалған адам деп естідім.
Dialogue: 0,0:02:03.83,0:02:06.70,Default,,0,0,0,,Қазір Пенхамстанда——
Dialogue: 0,0:02:06.79,0:02:10.12,Default,,0,0,0,,Мектептер мен ауруханалар салуға көп еңбек ету
Dialogue: 0,0:02:10.20,0:02:12.75,Default,,0,0,0,,Оның асыл жүрегі бар.
Dialogue: 0,0:02:13.54,0:02:14.79,Default,,0,0,0,,Мен саған не үшін керекпін?
Dialogue: 0,0:02:14.87,0:02:16.66,Default,,0,0,0,,Кел, мәміле жасайық
Dialogue: 0,0:02:16.75,0:02:21.20,Default,,0,0,0,,Егер сіз иіскеуді тоқтатсаңыз, мен сізге кез келген нәрсені саламын.
Dialogue: 0,0:02:21.29,0:02:24.95,Default,,0,0,0,,Мектепте немесе ауруханада не қалайсыз
Dialogue: 0,0:02:25.79,0:02:29.83,Default,,0,0,0,,Еңбегіңіз жемісін берсе, жергілікті халық та бақытты.
Dialogue: 0,0:02:29.91,0:02:30.75,Default,,0,0,0,,Және——
Dialogue: 0,0:02:31.75,0:02:33.16,Default,,0,0,0,,Сіз өз өміріңізді сақтайсыз
Dialogue: 0,0:02:34.91,0:02:36.70,Default,,0,0,0,,Сен қорқақсың.
Dialogue: 0,0:02:36.79,0:02:39.29,Default,,0,0,0,,Мен болашаққа деген үмітті арттырғым келеді
Dialogue: 0,0:02:39.95,0:02:41.70,Default,,0,0,0,,Болашақ үшін?
Dialogue: 0,0:02:42.41,0:02:47.20,Default,,0,0,0,,Бұл сіз қалаған нәрсені жасай алатын болашақ па?
Dialogue: 0,0:02:47.29,0:02:48.87,Default,,0,0,0,,Бұл тозақ сияқты
Dialogue: 0,0:02:48.95,0:02:52.33,Default,,0,0,0,,PTSD бар сарбаздардың қалдырған заттары және т.б.
Dialogue: 0,0:02:52.41,0:02:55.70,Default,,0,0,0,,Мазмұны қандай болса да, ол дәлел емес.
Dialogue: 0,0:02:55.79,0:03:00.08,Default,,0,0,0,,Сіз дәрігерге бармаған шығарсыз.
Dialogue: 0,0:03:00.16,0:03:03.25,Default,,0,0,0,,Сіз ақылды және тәжірибелісіз.
Dialogue: 0,0:03:03.33,0:03:07.79,Default,,0,0,0,,Сол себепті біз белгілі бір заттар мен адамдардың бар екенін түсінеміз...
Dialogue: 0,0:03:07.87,0:03:10.83,Default,,0,0,0,,Сіз оны оңай өшіретінін білуіңіз керек.
Dialogue: 0,0:03:11.41,0:03:15.08,Default,,0,0,0,,Президент Қытайға қатысты қатаң ұстанымын жариялады
Dialogue: 0,0:03:16.00,0:03:20.08,Default,,0,0,0,,Ал АҚШ әскері Пенумстанда орналасқан.
Dialogue: 0,0:03:20.87,0:03:23.45,Default,,0,0,0,,Біз B.O.W.
Dialogue: 0,0:03:23.54,0:03:28.83,Default,,0,0,0,,Егер бітпейтін қайшылықтары бар ел B.O.W... енгізсе.
Dialogue: 0,0:03:28.91,0:03:31.70,Default,,0,0,0,,Ингибиторлық бизнес нарығын құру
Dialogue: 0,0:03:32.54,0:03:36.16,Default,,0,0,0,,Мен ол препаратты Б.О.В.-ны басу үшін жасадым.
Dialogue: 0,0:03:36.75,0:03:38.50,Default,,0,0,0,,Ақша табу үшін——
Dialogue: 0,0:03:38.58,0:03:41.29,Default,,0,0,0,,Сіз B.O.W. жасайсыз ба?
Dialogue: 0,0:03:41.37,0:03:43.87,Default,,0,0,0,,Өлмейтін сарбаздар жасай алады
Dialogue: 0,0:03:43.95,0:03:46.75,Default,,0,0,0,,Егер супрессанттар үнемі енгізілсе——
Dialogue: 0,0:03:46.83,0:03:49.83,Default,,0,0,0,,Одан да ұзақ мерзімді шайқастарға төтеп бере алады
Dialogue: 0,0:03:50.58,0:03:52.83,Default,,0,0,0,,Бұл жаңашыл емес пе?
Dialogue: 0,0:03:52.91,0:03:55.70,Default,,0,0,0,,Тек ақша үшін өміріңмен қалай ойнауға болады?
Dialogue: 0,0:03:55.79,0:03:57.79,Default,,0,0,0,,Қандай ақымақ
Dialogue: 0,0:03:58.66,0:04:01.91,Default,,0,0,0,,№ Дұрыс. Сен жай ғана ақымақсың.
Dialogue: 0,0:04:02.00,0:04:03.33,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:04:05.25,0:04:08.12,Default,,0,0,0,,Әулие-әнбиелерге танымал сендей емес...
Dialogue: 0,0:04:08.20,0:04:11.95,Default,,0,0,0,,Менің міндетім – ұлтты қорғау.
Dialogue: 0,0:04:12.04,0:04:16.00,Default,,0,0,0,,Кейбір сарбаздарды құрбандыққа шалса да көмектесуге болмайды.
Dialogue: 0,0:04:16.58,0:04:20.08,Default,,0,0,0,,Сіздің еңбегіңіздің орнына——
Dialogue: 0,0:04:20.16,0:04:21.20,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:22.83,0:04:27.25,Default,,0,0,0,,Сауда жасаудың қажеті жоқ, оларды жұқтырыңыз.
Dialogue: 0,0:04:27.33,0:04:31.08,Default,,0,0,0,,Бұл жағдайда жалғыз нұсқа ингибиторды пайдалану болып табылады.
Dialogue: 0,0:04:31.16,0:04:33.54,Default,,0,0,0,,Ұнамаса да досым бол
Dialogue: 0,0:04:34.45,0:04:36.58,Default,,0,0,0,,Қорғаныс министрі Уилсон
Dialogue: 0,0:04:37.41,0:04:40.00,Default,,0,0,0,,Адамдардың қолдарын ластауы әдеттен тыс
Dialogue: 0,0:04:42.58,0:04:43.62,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:04:44.45,0:04:45.66,Default,,0,0,0,,Джейсон
Dialogue: 0,0:04:47.12,0:04:49.25,Default,,0,0,0,,Бұл мені таң қалдырды.
Dialogue: 0,0:04:52.62,0:04:58.41,Default,,0,0,0,,Капкомның «Resident Evil» ойынына негізделген
Dialogue: 0,0:05:54.54,0:05:57.29,Default,,0,0,0,,Мен Вилсонда жер асты мекемесі бар деп естідім.
Dialogue: 0,0:05:57.83,0:05:59.45,Default,,0,0,0,,B.O.W. дамыту нысандары
Dialogue: 0,0:06:00.08,0:06:02.50,Default,,0,0,0,,Тікелей төменде болса, ешкім байқамайды.
Dialogue: 0,0:06:06.91,0:06:08.83,Default,,0,0,0,,​​Еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:08.91,0:06:13.45,Default,,0,0,0,,Енді сіз өлген болсаңыз, барлау қызметі оңайырақ болады.
Dialogue: 0,0:06:14.16,0:06:17.87,Default,,0,0,0,,Соңғы алты жылда мен өлгендей болдым.
Dialogue: 0,0:06:19.62,0:06:21.33,Default,,0,0,0,,Сен мені өлтірдің
Dialogue: 0,0:06:26.29,0:06:28.41,Default,,0,0,0,,Не істеп жатырсың, құбыжық?
Dialogue: 0,0:06:28.50,0:06:30.87,Default,,0,0,0,,Мен оған нүкте қою үшін келдім.
Dialogue: 0,0:06:34.12,0:06:35.66,Default,,0,0,0,,Бұл сізге керек
Dialogue: 0,0:06:39.62,0:06:41.25,Default,,0,0,0,,Адам болу
Dialogue: 0,0:06:42.20,0:06:44.45,Default,,0,0,0,,Мен ғана көмектесе аламын
Dialogue: 0,0:06:44.54,0:06:46.25,Default,,0,0,0,,Қажет болуы керек
Dialogue: 0,0:06:46.33,0:06:47.70,Default,,0,0,0,,Енді қажет емес
Dialogue: 0,0:07:08.66,0:07:12.75,Default,,0,0,0,,Анықталған B.O.W. Стерилизация жұмысын бастайды
Dialogue: 0,0:07:12.83,0:07:16.54,Default,,0,0,0,,Қорғаныс бөлігін жабу үшін эвакуациялаңыз
Dialogue: 0,0:07:29.20,0:07:30.37,Default,,0,0,0,,Леон?
Dialogue: 0,0:07:36.62,0:07:38.16,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:08:19.08,0:08:20.50,Default,,0,0,0,,О, тәңірім
Dialogue: 0,0:08:33.79,0:08:35.58,Default,,0,0,0,,Мен аяқтаймын
Dialogue: 0,0:08:36.66,0:08:41.41,Default,,0,0,0,,Біз мұны әлемге қол қою рәсімінде көрсетеміз.
Dialogue: 0,0:08:42.00,0:08:46.54,Default,,0,0,0,,Ал бұл мекеме азаптау камерасы сияқты...
Dialogue: 0,0:08:47.75,0:08:51.16,Default,,0,0,0,,бәрін өртеп жіберіңіз
Dialogue: 0,0:08:51.25,0:08:55.83,Default,,0,0,0,,Жоқ, менде ағамның чипі бар. Менде барлық дәлелдер бар.
Dialogue: 0,0:08:56.70,0:08:58.95,Default,,0,0,0,,Оны жариялау ғана қалды.
Dialogue: 0,0:08:59.04,0:09:00.62,Default,,0,0,0,,Жоспарланғандай
Dialogue: 0,0:09:01.20,0:09:02.83,Default,,0,0,0,,Сондықтан тоқтатыңыз
Dialogue: 0,0:09:02.91,0:09:05.75,Default,,0,0,0,,Оны жария етудің еш мәні жоқ.
Dialogue: 0,0:09:05.83,0:09:10.04,Default,,0,0,0,,Бұл елдің жіберген қателері және қазіргі жағдайды өзгерту мүмкін емес.
Dialogue: 0,0:09:10.12,0:09:11.87,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:09:14.62,0:09:17.79,Default,,0,0,0,,Мен саған қорқынышты көрсетемін
Dialogue: 0,0:09:25.00,0:09:26.16,Default,,0,0,0,,Джейсон!
Dialogue: 0,0:09:34.58,0:09:35.95,Default,,0,0,0,,Келме
Dialogue: 0,0:09:50.41,0:09:52.16,Default,,0,0,0,,Джейсон, тоқта!
Dialogue: 0,0:09:55.20,0:10:00.87,Default,,0,0,0,,Дүниеге қорқыныштың тамырын көрсетіңіз және таратыңыз
Dialogue: 0,0:10:00.95,0:10:02.37,Default,,0,0,0,,Бұл пайдасыз.
Dialogue: 0,0:10:02.45,0:10:05.37,Default,,0,0,0,,үшінн шынайы қорқынышпен ояту...
Dialogue: 0,0:10:05.45,0:10:10.04,Default,,0,0,0,,Бұл трагедияны қайталамаудың жалғыз жолы.
Dialogue: 0,0:10:10.12,0:10:13.00,Default,,0,0,0,,Жоқ, ол болмайды.
Dialogue: 0,0:10:14.58,0:10:16.58,Default,,0,0,0,,Тоқтаңыз!
Dialogue: 0,0:10:21.83,0:10:24.54,Default,,0,0,0,,Балалар, мені тоқтата алмайсыңдар
Dialogue: 0,0:10:53.33,0:10:54.50,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:11:05.87,0:11:07.91,Default,,0,0,0,,Сен менің ағамның жанашырысың
Dialogue: 0,0:11:09.91,0:11:11.83,Default,,0,0,0,,Мен сенің өлуге жол бермеймін
Dialogue: 0,0:11:17.08,0:11:18.62,Default,,0,0,0,,Мен өліп қалдым
Dialogue: 0,0:11:23.33,0:11:25.25,Default,,0,0,0,,Джейсон, тоқта!
Dialogue: 0,0:11:49.58,0:11:50.75,Default,,0,0,0,,Леон!
Dialogue: 0,0:11:53.37,0:11:54.29,Default,,0,0,0,,Клэр?
Dialogue: 0,0:12:01.62,0:12:02.58,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:12:02.66,0:12:03.70,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:12:10.75,0:12:11.66,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:12:12.33,0:12:14.70,Default,,0,0,0,,Мәселе жоқ, рахмет.
Dialogue: 0,0:12:23.12,0:12:24.79,Default,,0,0,0,,Президенттің сұрағы бар.
Dialogue: 0,0:12:24.87,0:12:27.70,Default,,0,0,0,,Пенумстанмен қандай байланыс бар?
Dialogue: 0,0:12:27.79,0:12:29.62,Default,,0,0,0,,Мұнда қараңыз
Dialogue: 0,0:12:29.70,0:12:30.62,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:12:31.50,0:12:33.91,Default,,0,0,0,,Президент мырза, сізге аздап айтып берейін.
Dialogue: 0,0:12:49.25,0:12:50.58,Default,,0,0,0,,Президент
Dialogue: 0,0:12:52.33,0:12:54.20,Default,,0,0,0,,Қытай ұйымдастырушы емес
Dialogue: 0,0:12:54.29,0:12:58.58,Default,,0,0,0,,Биотерроризмді бұзу Уилсонның барлық жұмыстары
Dialogue: 0,0:12:58.66,0:13:01.33,Default,,0,0,0,,Ол соғысты қоздырып жатыр
Dialogue: 0,0:13:01.41,0:13:03.16,Default,,0,0,0,,Ақпараттың қайнар көзі?
Dialogue: 0,0:13:03.25,0:13:04.66,Default,,0,0,0,,Бұл Леон.
Dialogue: 0,0:13:36.29,0:13:41.00,Default,,0,0,0,,Көмек сұрағандарға не беруіміз керек ——
Dialogue: 0,0:13:41.08,0:13:42.41,Default,,0,0,0,,Үміт
Dialogue: 0,0:13:42.50,0:13:45.41,Default,,0,0,0,,Пенхамстан халқы өз өмірін қалпына келтіреді——
Dialogue: 0,0:13:45.50,0:13:48.41,Default,,0,0,0,,Өзіңізге лайықты бақытқа қол жеткізу——
Dialogue: 0,0:13:48.50,0:13:51.37,Default,,0,0,0,,Мен ешкімге жол бермеймін
Dialogue: 0,0:13:51.95,0:13:56.95,Default,,0,0,0,,Олар сынақтан өтіп, жаңа жолға түсуді ұйғарды.
Dialogue: 0,0:13:57.75,0:14:00.91,Default,,0,0,0,,Біз сізге еріп, жол көрсетеміз.
Dialogue: 0,0:14:02.58,0:14:05.79,Default,,0,0,0,,Олардың болашағы үшін жаңа достар табыңыз
Dialogue: 0,0:14:05.87,0:14:08.58,Default,,0,0,0,,Ұрпағымыздың болашағы үшін
Dialogue: 0,0:14:08.66,0:14:11.29,Default,,0,0,0,,Ынтымақтастық үшін күшімізді аямаймыз——
Dialogue: 0,0:14:11.37,0:14:14.41,Default,,0,0,0,,Бейбітшілік пен береке орнаймыз
Dialogue: 0,0:14:30.04,0:14:32.16,Default,,0,0,0,,Басқару бөлмесінде тоқтаңыз.
Dialogue: 0,0:14:32.25,0:14:33.12,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:03.83,0:15:04.79,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:06.83,0:15:08.08,Default,,0,0,0,,Дәл осы дәлелдер бар болғандықтан
Dialogue: 0,0:15:08.70,0:15:10.58,Default,,0,0,0,,Бірдеңе болады деп үміттенемін.
Dialogue: 0,0:15:24.95,0:15:26.25,Default,,0,0,0,,Бұл мені жылатады
Dialogue: 0,0:15:41.16,0:15:42.87,Default,,0,0,0,,Ол адам қайда?
Dialogue: 0,0:15:42.95,0:15:46.16,Default,,0,0,0,,TR-103, түсінемін.
Dialogue: 0,0:15:47.08,0:15:49.58,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:15:49.66,0:15:50.62,Default,,0,0,0,,〝Орындағыңыз келе ме?〞
Dialogue: 0,0:15:50.62,0:15:52.25,Default,,0,0,0,,〝Орындағыңыз келе ме?〞
Dialogue: 0,0:15:50.62,0:15:52.25,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:15:52.83,0:15:53.33,Default,,0,0,0,,«Шығу»
Dialogue: 0,0:15:53.33,0:15:54.62,Default,,0,0,0,,«Шығу»
Dialogue: 0,0:15:53.33,0:15:54.62,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:16:13.79,0:16:15.00,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:17:20.25,0:17:21.08,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:25.75,0:17:27.08,Default,,0,0,0,,Мені жіберме
Dialogue: 0,0:17:34.95,0:17:37.41,Default,,0,0,0,,Неліктен оны тоқтатуға тырысу керек?
Dialogue: 0,0:17:38.20,0:17:40.66,Default,,0,0,0,,Бұл миссия болғандықтан ба? Бұл кек па?
Dialogue: 0,0:17:57.20,0:17:58.33,Default,,0,0,0,,Қорқыныш
Dialogue: 0,0:18:00.33,0:18:02.04,Default,,0,0,0,,Қорқыныш тарайды
Dialogue: 0,0:18:08.79,0:18:10.58,Default,,0,0,0,,Маған қарасаң——
Dialogue: 0,0:18:12.08,0:18:16.25,Default,,0,0,0,,Дүние шынайы қорқынышты үйренеді
Dialogue: 0,0:19:06.91,0:19:11.29,Default,,0,0,0,,Бейбітшілікке қауіп төндіретін ашкөз және жауапсыз адамдарға қарсы мәлімдеме жасаңыз
Dialogue: 0,0:19:11.37,0:19:13.79,Default,,0,0,0,,Біз ешқашан берілмейміз
Dialogue: 0,0:19:14.75,0:19:18.95,Default,,0,0,0,,Әлемдегі бейбітшілік пен тұрақтылық үшін Америка Құрама Штаттары——
Dialogue: 0,0:19:19.04,0:19:21.41,Default,,0,0,0,,Мен жетекшілік етуге уәде беремін.
Dialogue: 0,0:19:21.50,0:19:23.66,Default,,0,0,0,,Және адамзатты азат етіңіз——
Dialogue: 0,0:19:24.29,0:19:25.29,Default,,0,0,0,,Нұсқаулық
Dialogue: 0,0:20:07.66,0:20:09.66,Default,,0,0,0,,Қорқыныш үшін көп
Dialogue: 0,0:20:11.37,0:20:12.70,Default,,0,0,0,,Ешкім...
Dialogue: 0,0:20:19.29,0:20:21.16,Default,,0,0,0,,Ешқашан аяқталмайды
Dialogue: 0,0:20:22.50,0:20:25.20,Default,,0,0,0,,Сіз осындасыз——
Dialogue: 0,0:20:26.75,0:20:29.54,Default,,0,0,0,,Мен оны міндетті түрде көрдім
Dialogue: 0,0:20:30.58,0:20:31.91,Default,,0,0,0,,Қорқынышты——
Dialogue: 0,0:20:33.20,0:20:34.58,Default,,0,0,0,,Шындық
Dialogue: 0,0:20:39.00,0:20:40.79,Default,,0,0,0,,Енді сіздің кезегіңіз
Dialogue: 0,0:20:41.41,0:20:43.75,Default,,0,0,0,,Қорқынышты тарату
Dialogue: 0,0:20:46.62,0:20:48.00,Default,,0,0,0,,Содан кейін——
Dialogue: 0,0:20:49.25,0:20:54.91,Default,,0,0,0,,Уақыт өте бүкіл әлем шындықты біледі...
Dialogue: 0,0:21:30.16,0:21:31.12,Default,,0,0,0,,Леон
Dialogue: 0,0:21:32.12,0:21:37.79,Default,,0,0,0,,Сіз суасты қайығында да, жер асты қондырғысында да аман қалдыңыз.
Dialogue: 0,0:21:37.87,0:21:41.08,Default,,0,0,0,,Өте керемет, ол батыр ғой.
Dialogue: 0,0:21:41.16,0:21:42.70,Default,,0,0,0,,Тек сәттілік
Dialogue: 0,0:21:42.79,0:21:46.04,Default,,0,0,0,,Жарайды, сен барлығын құтқардың.
Dialogue: 0,0:21:46.12,0:21:49.16,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:21:49.25,0:21:52.08,Default,,0,0,0,,Президент елдің бағытын шеше алады
Dialogue: 0,0:21:52.87,0:21:56.16,Default,,0,0,0,,Ол сөзсіз батыр.
Dialogue: 0,0:23:05.04,0:23:09.70,Default,,0,0,0,,«Триселл»
Dialogue: 0,0:23:16.62,0:23:17.50,Default,,0,0,0,,Леон
Dialogue: 0,0:23:18.29,0:23:19.41,Default,,0,0,0,,Сіздің қолыңыз қалай?
Dialogue: 0,0:23:20.16,0:23:21.20,Default,,0,0,0,,Жақсырақ
Dialogue: 0,0:23:21.87,0:23:24.08,Default,,0,0,0,,Ауруханадан қашып кеткен
Dialogue: 0,0:23:24.75,0:23:28.00,Default,,0,0,0,,Мен терезені сындырып, төмен түсу үшін парақты пайдаландым.
Dialogue: 0,0:23:28.58,0:23:30.91,Default,,0,0,0,,Тек қауіпті ештеңе жасамаңыз.
Dialogue: 0,0:23:32.00,0:23:34.62,Default,,0,0,0,,Әзіл.
Dialogue: 0,0:23:35.25,0:23:36.95,Default,,0,0,0,,Маған бала сияқты қарауды доғар
Dialogue: 0,0:23:37.87,0:23:39.29,Default,,0,0,0,,Өмір бойы мүмкін емес
Dialogue: 0,0:23:40.91,0:23:42.25,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:23:43.37,0:23:44.54,Default,,0,0,0,,Мысал кеңес
Dialogue: 0,0:23:45.79,0:23:46.95,Default,,0,0,0,,Сізде бар ма?
Dialogue: 0,0:23:49.04,0:23:51.37,Default,,0,0,0,,Мен бұл кешкі асқа шақыру деп ойладым.
Dialogue: 0,0:23:54.95,0:23:59.25,Default,,0,0,0,,Мен деректерді қалаймын. Газет компаниясына апарыңыз.
Dialogue: 0,0:24:00.83,0:24:03.25,Default,,0,0,0,,Дүниені дүр сілкіндіргені сондықтан.
Dialogue: 0,0:24:10.33,0:24:11.58,Default,,0,0,0,,Берілмейді
Dialogue: 0,0:24:13.41,0:24:14.41,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:24:21.95,0:24:23.58,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:24:25.41,0:24:28.16,Default,,0,0,0,,Екеуіңіз әртүрлі жолды таңдайсыз ба?
Dialogue: 0,0:24:36.50,0:24:37.58,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:24:40.66,0:24:41.50,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:24:55.66,0:24:56.83,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:24:59.29,0:25:01.54,Default,,0,0,0,,Костюм маған жараспайды.
Dialogue: 0,0:25:11.50,0:25:13.08,Default,,0,0,0,,Мен оны тоқтатамын
Dialogue: 0,0:25:58.75,0:26:02.91,Default,,0,0,0,,Хироюки Кобаяши жетекшілік етеді
Dialogue: 0,0:27:47.45,0:27:50.37,Default,,0,0,0,,Жапон субтитрлері Канан Фукузава
Dialogue: 0,0:27:51.87,0:27:57.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
