Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.62,0:00:06.25,Default,,0,0,0,,Гинза, дәстүр мен жаңашылдық тоғысқан қала
Dialogue: 0,0:00:06.34,0:00:10.42,Default,,0,0,0,,Іскерлік және саяхат Жақын адамдармен өткізілетін мерекелер
Dialogue: 0,0:00:10.51,0:00:15.30,Default,,0,0,0,,Біз сапалы және босаңсу сәттерін қамтамасыз етеміз.
Dialogue: 0,0:00:15.39,0:00:17.47,Default,,0,0,0,,Gingarou қонақ үйі
Dialogue: 0,0:00:19.47,0:00:21.31,Default,,0,0,0,,Біздің тұжырымдамамыз
Dialogue: 0,0:00:21.39,0:00:26.86,Default,,0,0,0,,Біздің сүйікті тұтынушыларымызға шын жүректен күн және ең жақсы күлкі
Dialogue: 0,0:00:26.94,0:00:29.19,Default,,0,0,0,,Оны әлемге бірінші болып біз енгіздік.
Dialogue: 0,0:00:29.28,0:00:32.32,Default,,0,0,0,,Сізге ең озық қонақ үй роботтары әкеледі
Dialogue: 0,0:00:32.40,0:00:36.53,Default,,0,0,0,,Жағдайға сәйкес оңтайлы және егжей-тегжейлі қызмет көрсету
Dialogue: 0,0:00:36.62,0:00:41.00,Default,,0,0,0,,Сондай-ақ, 24 сағаттық таза орта құру арқылы.
Dialogue: 0,0:00:41.08,0:00:46.21,Default,,0,0,0,,Біз тұтынушыларымызға қауіпсіз және жайлы уақытты қамтамасыз етеміз.
Dialogue: 0,0:00:46.29,0:00:48.96,Default,,0,0,0,,Оны вирус деп анықтау қиын.
Dialogue: 0,0:00:49.04,0:00:51.21,Default,,0,0,0,,Мексикада расталған құбылыс
Dialogue: 0,0:00:51.30,0:00:54.22,Default,,0,0,0,,Оның бүкіл әлемге таралу мүмкіндігін жоққа шығаруға болмайды.
Dialogue: 0,0:00:54.30,0:00:56.47,Default,,0,0,0,,Мутагендердің әсерінен
Dialogue: 0,0:00:56.55,0:00:57.89,Default,,0,0,0,,Тамырлы өсімдіктер арасында
Dialogue: 0,0:00:57.97,0:00:59.64,Default,,0,0,0,,әсіресе папоротниктер
Dialogue: 0,0:00:59.72,0:01:01.43,Default,,0,0,0,,Ауаның ластануы кең таралған
Dialogue: 0,0:01:01.52,0:01:02.52,Default,,0,0,0,,Бөлме де
Dialogue: 0,0:01:02.60,0:01:05.48,Default,,0,0,0,,Әртүрлі түрлері бар
Dialogue: 0,0:01:05.56,0:01:09.98,Default,,0,0,0,,Шатырдағы бақ тек сергіту және демалу орны ғана емес.
Dialogue: 0,0:01:10.61,0:01:13.99,Default,,0,0,0,,Біз сондай-ақ үйлену тойы мен той жоспарларын ұсынамыз.
Dialogue: 0,0:01:14.07,0:01:15.99,Default,,0,0,0,,Ауадағы инфортуний концентрациясы
Dialogue: 0,0:01:16.07,0:01:17.49,Default,,0,0,0,,өсуіне байланысты...
Dialogue: 0,0:01:17.57,0:01:19.74,Default,,0,0,0,,Жақын адаммен естелік үшін
Dialogue: 0,0:01:20.53,0:01:21.79,Default,,0,0,0,,Заттар осылай жалғаса берсе, олар жойылып кетеді...
Dialogue: 0,0:01:21.87,0:01:23.41,Default,,0,0,0,,Оны пайдалануды ұмытпаңыз.
Dialogue: 0,0:01:23.50,0:01:25.83,Default,,0,0,0,,Адамдарға зиян келтіргені туралы да хабарланды.
Dialogue: 0,0:01:25.92,0:01:29.34,Default,,0,0,0,,Ғимараттар мен бөлмелердің жеткілікті герметикалық болуын қамтамасыз ету.
Dialogue: 0,0:01:29.42,0:01:33.01,Default,,0,0,0,,Көшеге шыққанда міндетті түрде қорғаныс маскасын киіңіз
Dialogue: 0,0:01:33.09,0:01:36.38,Default,,0,0,0,,Ішкі тұтынушылар үшін ғана емес, сонымен қатар шетелдегі тұтынушылар үшін де.
Dialogue: 0,0:01:36.47,0:01:37.64,Default,,0,0,0,,Теңіз астындағы баспаналар және
Dialogue: 0,0:01:37.72,0:01:40.39,Default,,0,0,0,,Ғарыштық баспананың дамуы жылдам қарқынмен жүріп жатыр.
Dialogue: 0,0:01:40.47,0:01:42.97,Default,,0,0,0,,қанағаттандырылды.
Dialogue: 0,0:01:43.06,0:01:46.27,Default,,0,0,0,,Бізде демалатын орындар көп.
Dialogue: 0,0:01:46.35,0:01:48.65,Default,,0,0,0,,Бүгін Жерден қашу жоспарының бірінші тобы
Dialogue: 0,0:01:48.73,0:01:49.90,Default,,0,0,0,,Баспана бекетінде
Dialogue: 0,0:01:49.98,0:01:51.19,Default,,0,0,0,,келді
Dialogue: 0,0:01:51.27,0:01:54.49,Default,,0,0,0,,Ғарыш кемелерінің құрылысы күн жүйесінен тыс дамып келеді.
Dialogue: 0,0:01:54.57,0:01:55.90,Default,,0,0,0,,Жерден қашу жоспары 18-топ
Dialogue: 0,0:01:55.99,0:01:58.66,Default,,0,0,0,,Қашу лотереясының жеңімпаздары анықталды.
Dialogue: 0,0:01:58.74,0:02:00.91,Default,,0,0,0,,Жеңімпаздарға бірнеше рет шабуыл жасалды.
Dialogue: 0,0:02:00.99,0:02:02.41,Default,,0,0,0,,(айқай)
Dialogue: 0,0:02:02.49,0:02:05.45,Default,,0,0,0,,ДДҰ мәліметтері бойынша атмосферадағы инфортуний концентрациясы
Dialogue: 0,0:02:05.54,0:02:08.46,Default,,0,0,0,,0,9%-ға жеткені туралы хабарландыру болды.
Dialogue: 0,0:02:08.54,0:02:10.04,Default,,0,0,0,,Бұдан былай біз тікелей атмосферамен тыныс алатын боламыз.
Dialogue: 0,0:02:10.04,0:02:10.92,Default,,0,0,0,,Бұдан былай біз тікелей атмосферамен тыныс алатын боламыз.
Dialogue: 0,0:02:10.04,0:02:10.92,Default,,0,0,0,,(Офицердің жөтелі)
Dialogue: 0,0:02:10.92,0:02:11.00,Default,,0,0,0,,(Офицердің жөтелі)
Dialogue: 0,0:02:11.00,0:02:12.09,Default,,0,0,0,,(Офицердің жөтелі)
Dialogue: 0,0:02:11.00,0:02:12.09,Default,,0,0,0,,іс жүзінде мүмкін емес болады
Dialogue: 0,0:02:12.09,0:02:12.17,Default,,0,0,0,,іс жүзінде мүмкін емес болады
Dialogue: 0,0:02:12.17,0:02:13.17,Default,,0,0,0,,іс жүзінде мүмкін емес болады
Dialogue: 0,0:02:12.17,0:02:13.17,Default,,0,0,0,,Гваа
Dialogue: 0,0:02:13.17,0:02:13.88,Default,,0,0,0,,Гваа
Dialogue: 0,0:02:13.96,0:02:15.71,Default,,0,0,0,,(офицерлер үшін ағылшын тілі)
Dialogue: 0,0:02:24.01,0:02:27.10,Default,,0,0,0,,Дәстүр мен жаңашылдық...
Dialogue: 0,0:02:28.60,0:02:31.19,Default,,0,0,0,,Gingarou қонақ үйі
Dialogue: 0,0:02:35.19,0:02:38.45,Default,,0,0,0,,Келіңіз.
Dialogue: 0,0:03:03.26,0:03:04.60,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:03:55.73,0:03:57.32,Default,,0,0,0,,(Қақпақты жабу дыбысы)
Dialogue: 0,0:04:37.19,0:04:40.61,Default,,0,0,0,,(Ұшатын роботтың дауысы)
Dialogue: 0,0:04:43.20,0:04:44.53,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:04:51.25,0:04:52.37,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:04:53.12,0:04:56.92,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:04:57.00,0:04:58.29,Default,,0,0,0,,Есікші Робо
Dialogue: 0,0:04:58.38,0:05:00.17,Default,,0,0,0,,Екінші форма: Суиша!
Dialogue: 0,0:05:05.72,0:05:08.72,Default,,0,0,0,,Сіз мұны қайталадыңыз ба?
Dialogue: 0,0:05:08.80,0:05:10.14,Default,,0,0,0,,Салқындатқыш сұйықтық
Dialogue: 0,0:05:10.22,0:05:11.97,Default,,0,0,0,,Іздемесең жақсы емес.
Dialogue: 0,0:05:12.06,0:05:14.98,Default,,0,0,0,,Сіз суды сақтау үшін сақталған суды пайдаландыңыз.
Dialogue: 0,0:05:15.06,0:05:17.90,Default,,0,0,0,,Дәретханаға бару азап емес.
Dialogue: 0,0:05:17.98,0:05:21.36,Default,,0,0,0,,Дегенмен, мүмкіндігінше есікті ашу және жабудан аулақ болыңыз.
Dialogue: 0,0:05:21.44,0:05:23.69,Default,,0,0,0,,Менің айтарым, ханым.
Dialogue: 0,0:05:23.78,0:05:26.78,Default,,0,0,0,,Мен есік ашу үшін тудым.
Dialogue: 0,0:05:26.86,0:05:28.49,Default,,0,0,0,,Сіз байқаған кезде...
Dialogue: 0,0:05:29.58,0:05:31.24,Default,,0,0,0,,Ашылғаннан кейін
Dialogue: 0,0:05:31.33,0:05:33.37,Default,,0,0,0,,Маңызды тұтынушы келгенде
Dialogue: 0,0:05:33.45,0:05:35.66,Default,,0,0,0,,Егер ол қызып кетсе, мағынасы болмас еді.
Dialogue: 0,0:05:35.75,0:05:38.96,Default,,0,0,0,,Ханым, мен күн сайын өткіземін
Dialogue: 0,0:05:39.04,0:05:41.67,Default,,0,0,0,,Ашылмайтын есікке шыдай алмаймын.
Dialogue: 0,0:05:41.75,0:05:44.42,Default,,0,0,0,,Есікші Робо шынымен де қыңыр.
Dialogue: 0,0:05:44.51,0:05:45.84,Default,,0,0,0,,Лоторға көңіл бөлсеңіз
Dialogue: 0,0:05:45.92,0:05:47.63,Default,,0,0,0,,Мен жұмысқа кешігіп барамын.
Dialogue: 0,0:05:47.72,0:05:49.30,Default,,0,0,0,,Тез кіріңіз.
Dialogue: 0,0:05:49.39,0:05:50.22,Default,,0,0,0,,№
Dialogue: 0,0:05:50.30,0:05:53.43,Default,,0,0,0,,Мен тұтынушы емеспін, сондықтан оны өзім аша аламын.
Dialogue: 0,0:05:53.52,0:05:57.94,Default,,0,0,0,,Мен мұны 4682-ші рет айтып отырмын.
Dialogue: 0,0:06:19.58,0:06:20.88,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:20.96,0:06:22.38,Default,,0,0,0,,(роботтардың дауысы)
Dialogue: 0,0:06:22.46,0:06:25.71,Default,,0,0,0,,12 сәуір, 2157 ж
Dialogue: 0,0:06:25.80,0:06:29.38,Default,,0,0,0,,Бүгін мен менеджердің міндетін атқарушының атынан таңғы жиналысты бастаймын.
Dialogue: 0,0:06:29.47,0:06:30.64,Default,,0,0,0,,Қоңыраудан
Dialogue: 0,0:06:32.22,0:06:34.14,Default,,0,0,0,,Хаетори Робо мырза (Хаетори Робо дауысы)
Dialogue: 0,0:06:34.22,0:06:35.31,Default,,0,0,0,,Тазалау роботы А мырза Отсу мырза
Dialogue: 0,0:06:35.31,0:06:36.14,Default,,0,0,0,,Тазалау роботы А мырза Отсу мырза
Dialogue: 0,0:06:35.31,0:06:36.14,Default,,0,0,0,,(Тазалау роботтарының дауыстары)
Dialogue: 0,0:06:36.23,0:06:37.98,Default,,0,0,0,,Есікші Робо
Dialogue: 0,0:06:38.06,0:06:40.02,Default,,0,0,0,,Ас әзірлеу роботы (ас әзірлеу роботының дауысы)
Dialogue: 0,0:06:40.10,0:06:41.90,Default,,0,0,0,,Бартен Робо-сан (Бартен Робо дауысы)
Dialogue: 0,0:06:41.98,0:06:44.86,Default,,0,0,0,,Көкөніс бақшасын өсіруге жауапты робот (бақша өсіруге жауапты роботтың дауысы)
Dialogue: 0,0:06:44.94,0:06:47.61,Default,,0,0,0,,Портер Робо мырза (Портер Робо дауысы)
Dialogue: 0,0:06:47.69,0:06:49.74,Default,,0,0,0,,Техникалық қызмет көрсетуге жауапты робот
Dialogue: 0,0:06:51.03,0:06:52.83,Default,,0,0,0,,Бұрғылау роботы
Dialogue: 0,0:06:52.91,0:06:53.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:54.58,0:06:56.29,Default,,0,0,0,,Бұрғылау роботы?
Dialogue: 0,0:06:56.87,0:07:00.58,Default,,0,0,0,,Қоңырау шалуға жауап жоқ Рұқсатсыз кешіктіру 7 минут 28 секунд
Dialogue: 0,0:07:00.67,0:07:03.92,Default,,0,0,0,,Орналасқан жері бойынша сіз жоспарланған ыстық бұлақ орнында тұрған сияқтысыз.
Dialogue: 0,0:07:04.00,0:07:06.71,Default,,0,0,0,,Кешеден бері оралмадың ба?
Dialogue: 0,0:07:07.71,0:07:09.93,Default,,0,0,0,,Іскерлік байланыстар үшін
Dialogue: 0,0:07:10.01,0:07:12.47,Default,,0,0,0,,Қазіргі уақытта 0 қонақ тұрады.
Dialogue: 0,0:07:12.55,0:07:15.31,Default,,0,0,0,,0 жаңа қонақ бүгін қалады деп жоспарланған
Dialogue: 0,0:07:15.39,0:07:17.98,Default,,0,0,0,,Кеше басты бетті қарау саны: 0
Dialogue: 0,0:07:18.06,0:07:19.60,Default,,0,0,0,,Мақсатқа қол жеткізілмеді
Dialogue: 0,0:07:19.69,0:07:22.35,Default,,0,0,0,,Осы айдағы орналастыру мақсаты: 1440 қонақ
Dialogue: 0,0:07:22.44,0:07:24.69,Default,,0,0,0,,Оған жету үшін 1440 адам
Dialogue: 0,0:07:24.77,0:07:26.19,Default,,0,0,0,,Енді әрбір жауапты адамнан.
Dialogue: 0,0:07:26.28,0:07:28.69,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:07:31.41,0:07:32.61,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:32.70,0:07:34.28,Default,,0,0,0,,Техникалық қызмет көрсетуге жауапты робот
Dialogue: 0,0:07:34.37,0:07:36.49,Default,,0,0,0,,Біріншіден, батыс бүйір қабырғасын соқпалы шолу
Dialogue: 0,0:07:36.58,0:07:38.37,Default,,0,0,0,,Инфрақызыл зерттеу жүргізіңіз
Dialogue: 0,0:07:38.45,0:07:40.33,Default,,0,0,0,,Ас әзірлеу роботы
Dialogue: 0,0:07:40.41,0:07:42.37,Default,,0,0,0,,Олай болса, бұғы жақсырақ болар еді.
Dialogue: 0,0:07:42.46,0:07:44.50,Default,,0,0,0,,Көкөніс өсіруге жауапты робот мырза
Dialogue: 0,0:07:44.59,0:07:46.63,Default,,0,0,0,,Оны жұлып алудан басқа амалымыз жоқ.
Dialogue: 0,0:07:46.71,0:07:48.30,Default,,0,0,0,,Хаетори Робо мырза
Dialogue: 0,0:07:48.38,0:07:52.38,Default,,0,0,0,,Шыбын жаңа түр болуы мүмкін. Биологиялық үлгіні алыңыз.
Dialogue: 0,0:07:52.47,0:07:54.43,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:07:55.85,0:07:58.14,Default,,0,0,0,,Келесі, Галактика мұнарасының он ережесі
Dialogue: 0,0:07:58.93,0:08:02.35,Default,,0,0,0,,Галактикадағы ең жақсы қонақүй болуды мақсат ету
Dialogue: 0,0:08:02.94,0:08:06.65,Default,,0,0,0,,Бір нәрсе: Тамақтануда, әдептілікте мәдениет бар.
Dialogue: 0,0:08:06.73,0:08:10.86,Default,,0,0,0,,Сіздің өміріңізге бір бетбелгі: бүгін.
Dialogue: 0,0:08:11.86,0:08:15.37,Default,,0,0,0,,Күлімсіреу - ең жақсы интерьер
Dialogue: 0,0:08:15.45,0:08:19.83,Default,,0,0,0,,Қонақжайлылықта жамандық жоқ.
