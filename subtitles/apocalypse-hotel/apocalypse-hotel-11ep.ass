Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:05.92,Default,,0,0,0,,(бөтен дауыс)
Dialogue: 0,0:00:13.84,0:00:15.14,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:29.32,0:00:31.03,Default,,0,0,0,,Еңбек нормалары туралы заңға сәйкес
Dialogue: 0,0:00:31.11,0:00:33.24,Default,,0,0,0,,Ячио-чан тым көп жұмыс істейді
Dialogue: 0,0:00:34.16,0:00:34.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:35.07,0:00:36.99,Default,,0,0,0,,Қызметкерлеріңізді тым көп жұмыс істеуге мәжбүр етсеңіз
Dialogue: 0,0:00:37.07,0:00:39.95,Default,,0,0,0,,Жаман істер көп болатын сияқты.
Dialogue: 0,0:00:40.04,0:00:41.45,Default,,0,0,0,,Мен демалуыңызды сұраймын.
Dialogue: 0,0:00:41.54,0:00:43.71,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:00:43.79,0:00:45.21,Default,,0,0,0,,Бірақ неге қазір?
Dialogue: 0,0:00:45.29,0:00:48.17,Default,,0,0,0,,Понко жерді зерттеп жатыр.
Dialogue: 0,0:00:48.25,0:00:49.96,Default,,0,0,0,,Бұрын Дазе Чан Жироппонға бұрылды
Dialogue: 0,0:00:50.05,0:00:53.05,Default,,0,0,0,,Ол маған жақсы жағдайда кітап дүкені бар екенін айтты.
Dialogue: 0,0:00:54.05,0:00:56.05,Default,,0,0,0,,Хмф, мен әкелдім.
Dialogue: 0,0:00:58.97,0:01:01.10,Default,,0,0,0,,Понконың пікірін түсіндім.
Dialogue: 0,0:01:01.18,0:01:02.68,Default,,0,0,0,,Бірақ... (Понко) Иә, иә.
Dialogue: 0,0:01:02.77,0:01:06.56,Default,,0,0,0,,Мен қонақүй роботымын, сондықтан маған демалыстың қажеті жоқ, солай ма?
Dialogue: 0,0:01:06.65,0:01:07.48,Default,,0,0,0,,Қабылданбады!
Dialogue: 0,0:01:07.56,0:01:12.11,Default,,0,0,0,,Тіпті роботтар қозғала берсе сынып қалады.
Dialogue: 0,0:01:14.20,0:01:16.86,Default,,0,0,0,,Қалай болғанда да, Ячио-чан ертең және одан кейінгі күні демалыс алады.
Dialogue: 0,0:01:16.95,0:01:19.53,Default,,0,0,0,,Жұмыс істей алмайтындай киіміңіз тәркіленеді.
Dialogue: 0,0:01:19.62,0:01:21.87,Default,,0,0,0,,Иә, шеш, шеш, понча, понча?
Dialogue: 0,0:01:26.50,0:01:31.63,Default,,0,0,0,,Демалыс күні не істеуім керек?
Dialogue: 0,0:01:34.88,0:01:36.18,Default,,0,0,0,,Қош келдіңіз... (Понко) Қош келдіңіз.
Dialogue: 0,0:01:36.26,0:01:37.84,Default,,0,0,0,,Gingarou қонақ үйіне
Dialogue: 0,0:01:38.51,0:01:40.93,Default,,0,0,0,,Галактика Tower қонақ үйіне қош келдіңіз
Dialogue: 0,0:01:41.01,0:01:43.27,Default,,0,0,0,,Ах, жас ханым.
Dialogue: 0,0:02:12.29,0:02:13.92,Default,,0,0,0,,(Ұшатын роботтың дауысы)
Dialogue: 0,0:02:17.42,0:02:18.93,Default,,0,0,0,,(Ұшатын роботтың дауысы)
Dialogue: 0,0:02:19.01,0:02:21.47,Default,,0,0,0,,Мен түней аламын ба?
Dialogue: 0,0:02:22.01,0:02:27.02,Default,,0,0,0,,♪～
Dialogue: 0,0:03:46.93,0:03:51.94,Default,,0,0,0,,～♪
Dialogue: 0,0:03:55.52,0:03:57.19,Default,,0,0,0,,(лифттің келу дыбысы)
Dialogue: 0,0:04:00.53,0:04:03.57,Default,,0,0,0,,Ыстық бұлақ бар көрінеді.
Dialogue: 0,0:04:03.66,0:04:04.91,Default,,0,0,0,,Мен мұны асыға күтемін.
Dialogue: 0,0:04:04.99,0:04:06.45,Default,,0,0,0,,А, сәлем (шұбар бөтен) Сәлем~
Dialogue: 0,0:04:06.53,0:04:08.70,Default,,0,0,0,,Мен түскі асқа дейін барғым келеді...
Dialogue: 0,0:04:08.79,0:04:09.95,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:15.38,0:04:16.46,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:19.46,0:04:21.26,Default,,0,0,0,,Ластану жоқ Су тамшылары жоқ
Dialogue: 0,0:04:21.34,0:04:23.09,Default,,0,0,0,,Зең жоқ Жақсы көріктендіру
Dialogue: 0,0:04:23.18,0:04:25.59,Default,,0,0,0,,Сусабынға арналған қалпақ… Ha
Dialogue: 0,0:04:51.58,0:04:54.04,Default,,0,0,0,,Хун хун хун хун...
Dialogue: 0,0:04:56.96,0:04:58.59,Default,,0,0,0,,Я...
Dialogue: 0,0:05:21.48,0:05:24.40,Default,,0,0,0,,Бұл қонақ үй үй жануарларына рұқсат ете ме?
Dialogue: 0,0:05:24.49,0:05:28.32,Default,,0,0,0,,Үй жануарларына енді рұқсат етілген
Dialogue: 0,0:05:28.41,0:05:29.91,Default,,0,0,0,,Кейде қашып кетемін
Dialogue: 0,0:05:29.99,0:05:32.41,Default,,0,0,0,,Сізден қонақ үй белгісін тіркеу сұралады.
Dialogue: 0,0:05:32.49,0:05:35.91,Default,,0,0,0,,Ммм, қызмет шолулар айтқандай жақсы.
Dialogue: 0,0:05:36.00,0:05:38.67,Default,,0,0,0,,Менің Дорадора-чаным да сол бөлмеде...
Dialogue: 0,0:05:44.17,0:05:46.59,Default,,0,0,0,,(Шетелдіктердің дауыстары)
Dialogue: 0,0:06:04.44,0:06:07.78,Default,,0,0,0,,Ит~
Dialogue: 0,0:06:37.18,0:06:38.77,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:06:41.27,0:06:42.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:51.62,0:06:52.66,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:00.17,0:07:01.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:15.05,0:09:16.18,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:47.00,0:09:48.25,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:10:00.68,0:10:01.51,Default,,0,0,0,,Ах
Dialogue: 0,0:10:18.36,0:10:19.66,Default,,0,0,0,,Оны жем ретінде қолданайық
Dialogue: 0,0:10:19.74,0:10:22.08,Default,,0,0,0,,Бұл сізден келген сыйлық.
Dialogue: 0,0:10:22.16,0:10:23.33,Default,,0,0,0,,А...
Dialogue: 0,0:11:39.61,0:11:40.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:08.52,0:12:13.52,Default,,0,0,0,,(Пачинко машинасы BGM)
Dialogue: 0,0:12:20.11,0:12:23.61,Default,,0,0,0,,Жанайық! темекі шегу бонусы
Dialogue: 0,0:12:24.20,0:12:26.24,Default,,0,0,0,,Асық!
Dialogue: 0,0:13:06.57,0:13:07.91,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:21.67,0:13:23.72,Default,,0,0,0,,(Шақпақ тастың дыбысы)
Dialogue: 0,0:13:25.26,0:13:26.64,Default,,0,0,0,,О...
Dialogue: 0,0:13:32.39,0:13:33.93,Default,,0,0,0,,(Самғақтың сыңғыры)
Dialogue: 0,0:14:00.29,0:14:02.46,Default,,0,0,0,,О...
Dialogue: 0,0:14:31.58,0:14:33.87,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:14:57.02,0:14:57.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:59.81,0:15:01.48,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:15:17.33,0:15:18.79,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:15:25.46,0:15:26.84,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:15:35.72,0:15:38.64,Default,,0,0,0,,(айқай)
Dialogue: 0,0:15:39.68,0:15:40.52,Default,,0,0,0,,Иә
Dialogue: 0,0:15:40.60,0:15:45.15,Default,,0,0,0,,(Алғаштап бара жатқан тақалардың дыбысы)
Dialogue: 0,0:15:45.98,0:15:46.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:09.01,0:16:10.17,Default,,0,0,0,,Ах
Dialogue: 0,0:16:27.90,0:16:29.32,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:16:46.92,0:16:48.84,Default,,0,0,0,,(пломба дыбысы)
Dialogue: 0,0:17:04.44,0:17:05.60,Default,,0,0,0,,Ах
Dialogue: 0,0:17:11.44,0:17:14.61,Default,,0,0,0,,(мөр айқайы)
Dialogue: 0,0:17:18.70,0:17:20.12,Default,,0,0,0,,(айқай)
Dialogue: 0,0:19:01.47,0:19:02.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:47.72,0:19:49.02,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:20:12.54,0:20:15.63,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:20:21.30,0:20:22.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:26.22,0:20:28.14,Default,,0,0,0,,(ат дыбысы)
Dialogue: 0,0:20:30.81,0:20:32.39,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:46.74,0:20:47.95,Default,,0,0,0,,Ах
Dialogue: 0,0:20:55.25,0:20:56.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:58.25,0:20:59.96,Default,,0,0,0,,Қосымша миссия
Dialogue: 0,0:21:00.05,0:21:02.13,Default,,0,0,0,,Pegasus тістеген
Dialogue: 0,0:21:02.22,0:21:05.18,Default,,0,0,0,,«Айқас көздер» жаңа мүмкіндігі қосылды
Dialogue: 0,0:21:24.36,0:21:25.78,Default,,0,0,0,,Ах
Dialogue: 0,0:21:34.79,0:21:35.83,Default,,0,0,0,,Иә
Dialogue: 0,0:21:42.13,0:21:44.05,Default,,0,0,0,,Біздің қонақ үй...
Dialogue: 0,0:21:44.13,0:21:46.38,Default,,0,0,0,,Бірақ, бірақ, бірақ егер сіз бұлай десеңіз де...
Dialogue: 0,0:21:46.47,0:21:50.14,Default,,0,0,0,,Әй, Дорадора-чан! О, жақсы
Dialogue: 0,0:21:50.22,0:21:52.14,Default,,0,0,0,,Сіз жай ғана серуендеуге болмайтынын айтып жатырсыз.
Dialogue: 0,0:21:52.22,0:21:54.02,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:21:57.27,0:21:58.90,Default,,0,0,0,,Ячио-чан
Dialogue: 0,0:21:59.56,0:22:01.23,Default,,0,0,0,,Демалыс күнің қалай өтті?
Dialogue: 0,0:22:05.36,0:22:07.78,Default,,0,0,0,,Мен өзімді тірі сезіндім.
Dialogue: 0,0:22:10.07,0:22:15.08,Default,,0,0,0,,♪～
Dialogue: 0,0:22:55.08,0:23:00.00,Default,,0,0,0,,～♪
