Dialogue: 0,0:01:44.93,0:01:49.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:51.36,0:01:53.61,Default,,0,0,0,,Тұтынушыларды тарту қызметтері
Dialogue: 0,0:01:53.69,0:01:55.78,Default,,0,0,0,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:01:58.07,0:02:00.20,Default,,0,0,0,,Ол қалыптаса бастады.
Dialogue: 0,0:02:00.28,0:02:01.20,Default,,0,0,0,,Иә
Dialogue: 0,0:02:01.28,0:02:04.70,Default,,0,0,0,,Қасиетті қонақүйдің рухы да атмосфераға шығарылады.
Dialogue: 0,0:02:04.79,0:02:06.50,Default,,0,0,0,,Жақсы Бентлер
Dialogue: 0,0:02:06.58,0:02:07.79,Default,,0,0,0,,(Ұшатын роботтың дауысы)
Dialogue: 0,0:02:07.87,0:02:08.71,Default,,0,0,0,,Иә
Dialogue: 0,0:02:08.79,0:02:11.38,Default,,0,0,0,,Бұл тәжірибенің ғылыми негізі мүлдем жоқ.
Dialogue: 0,0:02:11.46,0:02:12.46,Default,,0,0,0,,(Ұшатын робот дауысы)
Dialogue: 0,0:02:12.55,0:02:16.42,Default,,0,0,0,,Arecibo хабарламасына жауап беруді әлі растау мүмкін емес
Dialogue: 0,0:02:16.51,0:02:17.80,Default,,0,0,0,,Сонымен жалғастырыңыз
Dialogue: 0,0:02:17.88,0:02:19.93,Default,,0,0,0,,Понконың оккультизмін сынап көрейік.
Dialogue: 0,0:02:20.01,0:02:22.22,Default,,0,0,0,,Жарайды, тұтынушылар міндетті түрде келеді.
Dialogue: 0,0:02:22.30,0:02:24.77,Default,,0,0,0,,Бұл пайғамбарлық кітапта не жазылған
Dialogue: 0,0:02:24.85,0:02:27.23,Default,,0,0,0,,Мен де Армаж келеді деп болжадым.
Dialogue: 0,0:02:27.31,0:02:28.56,Default,,0,0,0,,(Ұшатын роботтың дауысы)
Dialogue: 0,0:02:28.64,0:02:30.60,Default,,0,0,0,,Егер ол жұмыс істемесе, сәл ұзағырақ жалғастырыңыз
Dialogue: 0,0:02:30.69,0:02:33.23,Default,,0,0,0,,Клиенттерді тартудың басқа әдістерін қарастырыңыз
Dialogue: 0,0:02:34.07,0:02:35.23,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:02:35.23,0:02:36.74,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:02:35.23,0:02:36.74,Default,,0,0,0,,(Ұшатын роботтың дауысы)
Dialogue: 0,0:02:36.74,0:02:36.82,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:02:36.82,0:02:38.70,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:02:36.82,0:02:38.70,Default,,0,0,0,,Ой, жаңбыр жауып тұр.
Dialogue: 0,0:02:38.70,0:02:38.78,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:02:38.78,0:02:40.49,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:02:38.78,0:02:40.49,Default,,0,0,0,,Әзірге ішке оралайық.
Dialogue: 0,0:02:41.57,0:02:44.99,Default,,0,0,0,,Осы кезеңде сақтықты түсірмесеңіз, ол тез тот басады.
Dialogue: 0,0:02:45.08,0:02:50.83,Default,,0,0,0,,...Егер ол жасанды жер серігі болса, ауа-райын да болжай алар едік.
Dialogue: 0,0:02:50.92,0:02:53.84,Default,,0,0,0,,Бұл жасанды жер серігі ме?
Dialogue: 0,0:02:56.01,0:02:58.97,Default,,0,0,0,,Біз сондай-ақ Galaxy Tower жерсерігін ұшырдық.
Dialogue: 0,0:02:59.05,0:03:01.84,Default,,0,0,0,,Мен жарнама бергім келеді.
Dialogue: 0,0:03:01.93,0:03:04.31,Default,,0,0,0,,Содан кейін бүкіл әлем бойынша көбірек адамдар
Dialogue: 0,0:03:04.39,0:03:06.85,Default,,0,0,0,,Сіз бұл қонақүй туралы білетін боласыз, солай емес пе?
Dialogue: 0,0:03:07.89,0:03:10.35,Default,,0,0,0,,Менде ондай ақша жоқ.
Dialogue: 0,0:03:10.44,0:03:12.35,Default,,0,0,0,,Жақсы, егер біз жарнамалық спутникті ұшырсақ.
Dialogue: 0,0:03:12.44,0:03:13.86,Default,,0,0,0,,Бұл жарнама болса да
Dialogue: 0,0:03:13.94,0:03:16.15,Default,,0,0,0,,Адам болмаған соң, пайда жоқ!
Dialogue: 0,0:03:16.23,0:03:19.11,Default,,0,0,0,,Егер біз сияқты шетелдіктерге жарнама жасасақ ше?
Dialogue: 0,0:03:19.19,0:03:20.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:20.20,0:03:22.11,Default,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:03:22.20,0:03:24.66,Default,,0,0,0,,Жақсы идея болуы мүмкін, жасайық
Dialogue: 0,0:03:24.74,0:03:25.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:25.74,0:03:27.62,Default,,0,0,0,,Бұл вискиден өзгеше.
Dialogue: 0,0:03:27.70,0:03:29.00,Default,,0,0,0,,Жай, жақсы.
Dialogue: 0,0:03:29.08,0:03:32.37,Default,,0,0,0,,Ауа-райын болжауға болатын болса, онда бұл жаман емес.
Dialogue: 0,0:03:32.46,0:03:33.33,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:03:33.42,0:03:35.25,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:03:35.34,0:03:36.30,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:36.38,0:03:38.59,Default,,0,0,0,,Мейрамхананың ұсынылған мәзір элементтерін де жарнамалаңыз.
Dialogue: 0,0:03:39.21,0:03:41.22,Default,,0,0,0,,Ең жоғарғы ұядағы кешкі ас
Dialogue: 0,0:03:41.30,0:03:43.47,Default,,0,0,0,,Станциядан 3 минутта Ең жақсы емдік тәжірибе!
Dialogue: 0,0:03:43.55,0:03:44.89,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:44.97,0:03:47.47,Default,,0,0,0,,Қонақ үйге қатысты сөз тіркесі де керек.
Dialogue: 0,0:03:47.56,0:03:49.73,Default,,0,0,0,,Сондай-ақ Құдайдың таяғы Құдайдың таяғы!
Dialogue: 0,0:03:49.81,0:03:51.02,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:51.10,0:03:53.31,Default,,0,0,0,,Құдай таяғы да... а
Dialogue: 0,0:03:58.11,0:04:00.49,Default,,0,0,0,,Бұл пайғамбарлық кітапта жазылған.
Dialogue: 0,0:04:01.07,0:04:03.82,Default,,0,0,0,,Бұл іс жүзінде әлемнің бір жерінде жүзеге асырылды...
Dialogue: 0,0:04:03.91,0:04:06.99,Default,,0,0,0,,Ғарыштық қарудың аяқталмаған жоспары болды.
Dialogue: 0,0:04:07.58,0:04:08.99,Default,,0,0,0,,Құдай таяғы…
Dialogue: 0,0:04:09.08,0:04:11.96,Default,,0,0,0,,Бұл спутникке орнатылған металл штанга.
Dialogue: 0,0:04:12.04,0:04:14.54,Default,,0,0,0,,Жерге қарай ату арқылы
Dialogue: 0,0:04:14.63,0:04:17.96,Default,,0,0,0,,Гипердыбыстық құлау энергиясымен
Dialogue: 0,0:04:18.05,0:04:20.97,Default,,0,0,0,,Жауларды із-түзсіз жоюға болады.
Dialogue: 0,0:04:24.18,0:04:26.97,Default,,0,0,0,,Ең қуатты ғарыштық қару
Dialogue: 0,0:04:29.06,0:04:32.10,Default,,0,0,0,,Понко, мен оны біраз бұрын байқадым.
Dialogue: 0,0:04:32.18,0:04:34.65,Default,,0,0,0,,Қонақ үйді жақсартуға қанша тырыссаңыз да,
Dialogue: 0,0:04:34.73,0:04:38.73,Default,,0,0,0,,Өзіңді қорғауға күшің жетпесе, сені бір күні біреу құртып жібереді.
Dialogue: 0,0:04:40.57,0:04:43.53,Default,,0,0,0,,Содан бері мен күнде мазасызданып, қобалжыдым.
Dialogue: 0,0:04:43.61,0:04:48.20,Default,,0,0,0,,Қорғаныс ретінде мен аздап тұз қостым, бірақ таңқаларлық ол көп қоспады ...
Dialogue: 0,0:04:48.28,0:04:49.24,Default,,0,0,0,,Сонымен
Dialogue: 0,0:04:49.33,0:04:53.08,Default,,0,0,0,,Спутник жасамақ болсаң, Құдайдың таяғын да жасайық!
Dialogue: 0,0:04:53.71,0:04:56.38,Default,,0,0,0,,Егер бұл тек қорғаныс үшін болса, зымырандар жеткілікті емес пе?
Dialogue: 0,0:04:56.46,0:05:00.09,Default,,0,0,0,,Құдайдың таяқтары зымырандарға қарағанда экологиялық таза!
Dialogue: 0,0:05:00.17,0:05:01.21,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:05:01.30,0:05:04.43,Default,,0,0,0,,Ғарыштық қаруды иеленуге Ғарыш туралы шартпен тыйым салынған.
Dialogue: 0,0:05:04.51,0:05:06.97,Default,,0,0,0,,Содан кейін біз Ғарыш туралы келісімді уақытша елемейтін боламыз.
Dialogue: 0,0:05:07.05,0:05:08.64,Default,,0,0,0,,Ішкі заңнаманы жасаңыз!
Dialogue: 0,0:05:08.72,0:05:09.81,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:05:09.89,0:05:12.31,Default,,0,0,0,,Өз еркімен заң шығару жаман.
Dialogue: 0,0:05:12.39,0:05:13.56,Default,,0,0,0,,, солай ма?
Dialogue: 0,0:05:13.64,0:05:16.19,Default,,0,0,0,,Заң көпшіліктің шешімі ғана.
Dialogue: 0,0:05:16.27,0:05:17.27,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:17.35,0:05:18.81,Default,,0,0,0,,біз шешеміз
Dialogue: 0,0:05:18.90,0:05:23.28,Default,,0,0,0,,Ғарыш туралы келісімді уақытша елемейтін ішкі заңды орнатуды жақтайтындар
Dialogue: 0,0:05:23.36,0:05:24.82,Default,,0,0,0,,Қолыңызды көтеріңіз!
Dialogue: 0,0:05:25.40,0:05:28.07,Default,,0,0,0,,Иә, аа... жоқ
Dialogue: 0,0:05:28.16,0:05:30.03,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:05:30.95,0:05:32.08,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:32.70,0:05:35.46,Default,,0,0,0,,Сізге қонақүйді жарнамалайтын спутник қажет
Dialogue: 0,0:05:35.54,0:05:39.21,Default,,0,0,0,,Ғарыш туралы келісімге дейін бізге Құдайдың таяғы қажет емес деп ойлаймын.
Dialogue: 0,0:05:39.29,0:05:41.96,Default,,0,0,0,,Жоқ! Маған Құдайдың таяғы керек
Dialogue: 0,0:05:42.05,0:05:42.92,Default,,0,0,0,,Пайғамбарлықтар кітабы
Dialogue: 0,0:05:43.01,0:05:45.92,Default,,0,0,0,,Бұл пайғамбарлық кітап! оқып көріңіз
Dialogue: 0,0:05:46.80,0:05:49.97,Default,,0,0,0,,Сонда да менің пікірім өзгермейді деп ойлаймын.
Dialogue: 0,0:05:50.05,0:05:51.64,Default,,0,0,0,,А...
Dialogue: 0,0:05:51.72,0:05:53.72,Default,,0,0,0,,Ячио-чанның белгісіз адамы!
Dialogue: 0,0:05:53.81,0:05:56.44,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:07.20,0:06:08.70,Default,,0,0,0,,Ячио-чан
Dialogue: 0,0:06:08.78,0:06:10.66,Default,,0,0,0,,Кешегі үшін кешірім сұраймын.
Dialogue: 0,0:06:10.74,0:06:11.95,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:12.03,0:06:15.45,Default,,0,0,0,,Дұрыс түсіндіре алмағаным үшін кешіріңіз.
Dialogue: 0,0:06:17.08,0:06:19.04,Default,,0,0,0,,Сонда да Құдайдың таяқтары Галактика мұнарасында...
Dialogue: 0,0:06:19.12,0:06:21.63,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:06:23.30,0:06:27.01,Default,,0,0,0,,Ал, бүгін біз тұтынушыларды тартумен де айналысамыз.
Dialogue: 0,0:06:27.67,0:06:31.55,Default,,0,0,0,,...
Dialogue: 0,0:06:31.64,0:06:33.60,Default,,0,0,0,,...
Dialogue: 0,0:06:33.60,0:06:35.52,Default,,0,0,0,,...
Dialogue: 0,0:06:33.60,0:06:35.52,Default,,0,0,0,,Құдайдың таяғы!
Dialogue: 0,0:06:35.60,0:06:39.60,Default,,0,0,0,,Bentler Bentler Құдайдың таяғы
Dialogue: 0,0:06:39.69,0:06:43.65,Default,,0,0,0,,Bentler Bentler Құдайдың таяғы
Dialogue: 0,0:06:43.73,0:06:46.53,Default,,0,0,0,,Құдайдың таяғы Құдайдың...
Dialogue: 0,0:06:56.45,0:06:57.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:00.62,0:07:02.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:03.09,0:07:05.71,Default,,0,0,0,,Загиндегі барлық адамдар, Пом Поко ломбарды!
Dialogue: 0,0:07:05.80,0:07:07.51,Default,,0,0,0,,Пон Поко ломбарды!
Dialogue: 0,0:07:07.59,0:07:09.38,Default,,0,0,0,,Эй, енот қыз
Dialogue: 0,0:07:07.59,0:07:09.38,Default,,0,0,0,,Қонақ үйді басқыншылардан қорғауымыз керек!
Dialogue: 0,0:07:09.38,0:07:09.47,Default,,0,0,0,,Қонақ үйді басқыншылардан қорғауымыз керек!
Dialogue: 0,0:07:09.47,0:07:10.80,Default,,0,0,0,,Қонақ үйді басқыншылардан қорғауымыз керек!
Dialogue: 0,0:07:09.47,0:07:10.80,Default,,0,0,0,,Егер сен сонда өлтірілсең...
Dialogue: 0,0:07:10.88,0:07:14.68,Default,,0,0,0,,Құдайдың қолымен қонақүйді қорғаймыз.
Dialogue: 0,0:07:14.76,0:07:17.89,Default,,0,0,0,,Бұл ана жұлдызы... жоқ, өгей ана жұлдызы
Dialogue: 0,0:07:17.98,0:07:20.39,Default,,0,0,0,,Жерді қорғау!
Dialogue: 0,0:07:20.48,0:07:22.56,Default,,0,0,0,,Сонымен, сайлаушылар.
Dialogue: 0,0:07:22.65,0:07:26.57,Default,,0,0,0,,Егер Құдайдың штабы орналаспаса және басқыншы пайда болса...
Dialogue: 0,0:07:26.65,0:07:28.57,Default,,0,0,0,,Сіздің өміріңіз қалай өзгереді?
Dialogue: 0,0:07:28.65,0:07:32.41,Default,,0,0,0,,Басқыншылар біздің егемендігімізді ешқашан мойындамайды.
Dialogue: 0,0:07:32.49,0:07:35.24,Default,,0,0,0,,Ал жалаң аяқпен жерімізді тапта.
Dialogue: 0,0:07:35.33,0:07:38.04,Default,,0,0,0,,Соңында аумақты белгілеу
Dialogue: 0,0:07:38.12,0:07:40.75,Default,,0,0,0,,Барлық жерге нәжіс таратыңыз!
Dialogue: 0,0:07:40.75,0:07:41.71,Default,,0,0,0,,Барлық жерге нәжіс таратыңыз!
Dialogue: 0,0:07:40.75,0:07:41.71,Default,,0,0,0,,(Ұшатын робот дауысы)
Dialogue: 0,0:07:41.79,0:07:43.67,Default,,0,0,0,,Тезек шыбындарды тартады
Dialogue: 0,0:07:43.75,0:07:47.00,Default,,0,0,0,,Шыбын тапсаң, еңбегің бітпейді!
Dialogue: 0,0:07:47.00,0:07:47.84,Default,,0,0,0,,Шыбын көрсең, еңбегің бітпейді!
Dialogue: 0,0:07:47.00,0:07:47.84,Default,,0,0,0,,(Ұшатын робот дауысы)
Dialogue: 0,0:07:47.92,0:07:50.34,Default,,0,0,0,,Енді тұр, Galaxy Tower!
Dialogue: 0,0:07:50.42,0:07:53.09,Default,,0,0,0,,Аспанға ұшатын Құдайдың таяғы
Dialogue: 0,0:07:53.18,0:07:57.72,Default,,0,0,0,,Бұл бізді және осы қонақүйді құтқарудың жалғыз жолы!
Dialogue: 0,0:07:59.64,0:08:01.31,Default,,0,0,0,,(Ұшатын роботтың дауысы)
Dialogue: 0,0:08:05.77,0:08:07.69,Default,,0,0,0,,Помпокопон Помпокопон!
Dialogue: 0,0:08:07.77,0:08:09.86,Default,,0,0,0,,Помпокопон Помпокопон!
Dialogue: 0,0:08:09.94,0:08:12.70,Default,,0,0,0,,Помпокопон Помпокопон! Пон Поко ломбарды...
Dialogue: 0,0:08:12.78,0:08:15.28,Default,,0,0,0,,Мына жігіттер жынды екен
Dialogue: 0,0:08:15.37,0:08:17.20,Default,,0,0,0,,Сөйлеуді тоқтатыңыз
Dialogue: 0,0:08:17.28,0:08:19.70,Default,,0,0,0,,А... неге?
Dialogue: 0,0:08:19.79,0:08:23.21,Default,,0,0,0,,Понконың әрекеті саяси әрекеттерді құрайды.
Dialogue: 0,0:08:23.29,0:08:27.63,Default,,0,0,0,,Қонақ үй ережелері мекемедегі саяси әрекеттерге тыйым салады.
Dialogue: 0,0:08:27.71,0:08:28.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:28.75,0:08:30.38,Default,,0,0,0,,Қалыпты сөйлесу.
Dialogue: 0,0:08:30.46,0:08:31.30,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:08:31.38,0:08:33.13,Default,,0,0,0,,Бұл қалыпты жағдай?
Dialogue: 0,0:08:33.22,0:08:36.72,Default,,0,0,0,,Егер Понко қызметкері осылай жүрсе,
Dialogue: 0,0:08:36.80,0:08:38.89,Default,,0,0,0,,Қонақ үйдің беделіне нұқсан келтіруі мүмкін
Dialogue: 0,0:08:38.97,0:08:41.85,Default,,0,0,0,,Тиісті шара қолданамыз.
Dialogue: 0,0:08:41.93,0:08:44.14,Default,,0,0,0,,Тиісті әрекет қандай?
Dialogue: 0,0:08:44.23,0:08:47.15,Default,,0,0,0,,Мазасыздық тудыратын кез келген адам қызметінен кетуді сұрайды.
Dialogue: 0,0:08:47.23,0:08:48.40,Default,,0,0,0,,Өйткені ереже
Dialogue: 0,0:08:48.48,0:08:50.48,Default,,0,0,0,,Тек ережелерді өзгертіңіз!
Dialogue: 0,0:08:50.57,0:08:52.40,Default,,0,0,0,,Қонақ үй ережелері абсолютті
Dialogue: 0,0:08:52.49,0:08:53.53,Default,,0,0,0,,Ячио-чан дегеніміз не?
Dialogue: 0,0:08:53.61,0:08:56.16,Default,,0,0,0,,Робот сияқты деп айта алмайсың!
Dialogue: 0,0:08:56.24,0:08:58.33,Default,,0,0,0,,Иә, бұл робот.
Dialogue: 0,0:08:58.41,0:08:59.58,Default,,0,0,0,,Басты басыңыз!
Dialogue: 0,0:08:59.66,0:09:01.41,Default,,0,0,0,,Жүрегің де, миың да жоқ болса да!
Dialogue: 0,0:09:04.33,0:09:06.92,Default,,0,0,0,,Иә, бұл робот.
Dialogue: 0,0:09:07.58,0:09:08.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:09.59,0:09:10.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:10.50,0:09:12.92,Default,,0,0,0,,Уф... Понко-сан
Dialogue: 0,0:09:14.01,0:09:15.68,Default,,0,0,0,,(Понконың айқайы)
Dialogue: 0,0:09:15.76,0:09:16.80,Default,,0,0,0,,Понко-сан!
Dialogue: 0,0:09:16.89,0:09:18.85,Default,,0,0,0,,Келме!
Dialogue: 0,0:09:18.93,0:09:20.93,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:09:21.01,0:09:23.31,Default,,0,0,0,,Ах, а... а...
Dialogue: 0,0:09:23.39,0:09:25.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:25.14,0:09:28.36,Default,,0,0,0,,(Понконың қиналған дауысы)
Dialogue: 0,0:09:31.82,0:09:34.28,Default,,0,0,0,,Понко-сан қонақүй туралы ойлайды.
Dialogue: 0,0:09:34.36,0:09:35.86,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:09:35.95,0:09:38.07,Default,,0,0,0,,Бірақ Құдайдың таяғы...
Dialogue: 0,0:09:38.16,0:09:39.87,Default,,0,0,0,,Мен енді қашқым келмейді!
Dialogue: 0,0:09:43.95,0:09:48.00,Default,,0,0,0,,Понко және басқалары туған планетасынан қашуға мәжбүр болды.
Dialogue: 0,0:09:49.08,0:09:51.13,Default,,0,0,0,,Содан бастап...
Dialogue: 0,0:09:51.21,0:09:53.96,Default,,0,0,0,,Мен осы уақыт бойы қашып жүрдім.
Dialogue: 0,0:09:54.97,0:09:57.88,Default,,0,0,0,,(қашып кеткен дауыс)
Dialogue: 0,0:09:58.89,0:10:01.72,Default,,0,0,0,,Мен енді бұл жерден қашқым келмейді.
Dialogue: 0,0:10:03.52,0:10:04.89,Default,,0,0,0,,Тіпті жердегілер
Dialogue: 0,0:10:04.98,0:10:08.44,Default,,0,0,0,,Ячио-чанды сүйгендіктен оны тастап кеткен сияқты емессің, солай ма?
Dialogue: 0,0:10:09.48,0:10:10.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:16.40,0:10:18.66,Default,,0,0,0,,Понко Мен енді қашқым келмейді
Dialogue: 0,0:10:18.74,0:10:21.66,Default,,0,0,0,,Мен Ячиёны жалғыз қалдырмаймын!
Dialogue: 0,0:10:22.24,0:10:25.37,Default,,0,0,0,,Өйткені Ячио-чан менің досым.
Dialogue: 0,0:10:25.45,0:10:27.75,Default,,0,0,0,,Понконың жұмыс берушісі
Dialogue: 0,0:10:28.29,0:10:29.67,Default,,0,0,0,,Біз доспыз
Dialogue: 0,0:10:29.75,0:10:32.38,Default,,0,0,0,,Понко Ячио-чан және барлығы
Dialogue: 0,0:10:32.46,0:10:34.38,Default,,0,0,0,,Мәңгі және мәңгі
Dialogue: 0,0:10:34.46,0:10:36.80,Default,,0,0,0,,Мен осы қонақүйде көңіл көтергім келеді.
Dialogue: 0,0:10:36.88,0:10:40.55,Default,,0,0,0,,Сондықтан міндетті түрде Алла таяғы тиелген зымыран жіберіңіз.
Dialogue: 0,0:10:40.64,0:10:42.43,Default,,0,0,0,,Мен ұшуым керек
Dialogue: 0,0:10:44.60,0:10:47.06,Default,,0,0,0,,Сенің сезіміңді түсінемін, Понко.
Dialogue: 0,0:10:47.14,0:10:50.23,Default,,0,0,0,,Неге түсінбейсің?
Dialogue: 0,0:10:50.31,0:10:51.40,Default,,0,0,0,,А...
Dialogue: 0,0:10:51.48,0:10:54.65,Default,,0,0,0,,Бұл менің AI-ның оңтайлы шешімінен өзгеше болса да
Dialogue: 0,0:10:54.73,0:10:58.40,Default,,0,0,0,,Шынында да, осы қонақүйді қорғауды жалғастыру үшін.
Dialogue: 0,0:10:58.49,0:11:01.99,Default,,0,0,0,,Мүмкін біз өзімізді ғана қорғамауымыз керек шығар.
Dialogue: 0,0:11:02.62,0:11:03.66,Default,,0,0,0,,Иә
Dialogue: 0,0:11:13.54,0:11:14.71,Default,,0,0,0,,Сонымен
Dialogue: 0,0:11:14.80,0:11:16.63,Default,,0,0,0,,Понко айтқандай
Dialogue: 0,0:11:16.71,0:11:20.72,Default,,0,0,0,,Мен де Құдайдың таяғы қажет деген қорытындыға келдім.
Dialogue: 0,0:11:20.80,0:11:24.26,Default,,0,0,0,,Әже де қолынан келгеннің бәрін жасайды.
Dialogue: 0,0:11:24.35,0:11:26.60,Default,,0,0,0,,Оны пешкамен ұшырайық
Dialogue: 0,0:11:26.68,0:11:28.43,Default,,0,0,0,,Мұнда да кәсіби мамандар бар.
Dialogue: 0,0:11:28.52,0:11:29.48,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:29.56,0:11:31.77,Default,,0,0,0,,Мен аздап ақымақпын және онымен ойнай аламын.
Dialogue: 0,0:11:32.52,0:11:36.27,Default,,0,0,0,,Құдайдың қызметкерлерін толтыру арнайы білімді қажет етеді.
Dialogue: 0,0:11:36.36,0:11:39.78,Default,,0,0,0,,Тейто Помпоко университетінің ғарыштық инженерия бөлімі
Dialogue: 0,0:11:39.86,0:11:42.82,Default,,0,0,0,,Сыныбын үздік бітірген қызым сияқты.
Dialogue: 0,0:11:42.91,0:11:45.03,Default,,0,0,0,,Понко-сан, солай ма?
Dialogue: 0,0:11:45.12,0:11:48.50,Default,,0,0,0,,Иә, бірақ кіргенде артқы есіктен кіресіз.
Dialogue: 0,0:11:48.58,0:11:50.54,Default,,0,0,0,,Шыққанда, оны алдыңғы жақтан жасаңыз
Dialogue: 0,0:11:50.62,0:11:54.79,Default,,0,0,0,,Сонымен, сіз келген ғарыш кемесі шын мәнінде жөнделді.
Dialogue: 0,0:11:54.88,0:11:57.30,Default,,0,0,0,,Фуфуфу... (ит ұйықтап жатыр)
Dialogue: 0,0:11:57.38,0:12:00.22,Default,,0,0,0,,Енді мен Ячио-чанмен байсалды боламын.
Dialogue: 0,0:12:00.30,0:12:03.34,Default,,0,0,0,,Мен Құдайдың таяғын жасай бастаймын.
Dialogue: 0,0:12:03.43,0:12:04.30,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:04.97,0:12:07.76,Default,,0,0,0,,Өтінемін, барлығы маған күш-қуат беруін қалаймын.
Dialogue: 0,0:12:07.85,0:12:09.22,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:12:09.31,0:12:10.81,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:30.16,0:12:32.58,Default,,0,0,0,,Осылайша, құрылымдық мәселелерге байланысты
Dialogue: 0,0:12:32.66,0:12:37.09,Default,,0,0,0,,Өйткені RFG оқтарын қаптаманың ішінде сақтау мүмкін емес.
Dialogue: 0,0:12:37.17,0:12:40.84,Default,,0,0,0,,Зымыран ұшыру кезінде сыртқы жағына бекітіледі
Dialogue: 0,0:12:40.92,0:12:42.84,Default,,0,0,0,,РФГ дегеніміз не?
Dialogue: 0,0:12:42.92,0:12:45.68,Default,,0,0,0,,Расында, Құдай таяғының киелі нысаны.
Dialogue: 0,0:12:45.76,0:12:48.35,Default,,0,0,0,,«Нудағыдан» өзгеше.
Dialogue: 0,0:12:48.43,0:12:52.89,Default,,0,0,0,,Кез келген жағдайда, спутниктік бөлінгеннен кейін Понко төмен орбитада қалады.
Dialogue: 0,0:12:52.98,0:12:56.56,Default,,0,0,0,,RFG қолмен жүктеңіз
Dialogue: 0,0:12:57.19,0:12:58.61,Default,,0,0,0,,Сұрақтарыңыз бар ма?
Dialogue: 0,0:12:58.69,0:13:01.78,Default,,0,0,0,,Әпкең ғарышқа ұшады, солай ма?
Dialogue: 0,0:13:01.86,0:13:03.11,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:13:03.20,0:13:06.66,Default,,0,0,0,,Менің әпкем енот планетасында туып, ғарышта өсті.
Dialogue: 0,0:13:06.74,0:13:10.74,Default,,0,0,0,,Ол Мори қызының ғарыш қызы болғандықтан, бұл Очаноко Пом Пом.
Dialogue: 0,0:13:13.08,0:13:15.67,Default,,0,0,0,,Содан кейін салмақ мәселесі бар.
Dialogue: 0,0:13:26.97,0:13:29.64,Default,,0,0,0,,Уф... О, құдай!
Dialogue: 0,0:13:35.39,0:13:38.48,Default,,0,0,0,,Иә! Хм... хмф
Dialogue: 0,0:13:53.91,0:13:56.50,Default,,0,0,0,,Понкоға арналған көліктен тыс белсенділік блогы
Dialogue: 0,0:13:56.58,0:13:58.08,Default,,0,0,0,,Сол жерде тамақ
Dialogue: 0,0:13:58.17,0:14:01.34,Default,,0,0,0,,Сіз алып жүрген басқа заттарда проблема жоқ сияқты.
Dialogue: 0,0:14:02.30,0:14:03.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:06.72,0:14:09.22,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:14:09.30,0:14:10.60,Default,,0,0,0,,Понко-сан
Dialogue: 0,0:14:10.68,0:14:12.14,Default,,0,0,0,,Ах Ячио-чан
Dialogue: 0,0:14:12.76,0:14:14.47,Default,,0,0,0,,Сіз дұрыс демалып жатырсыз ба?
Dialogue: 0,0:14:14.56,0:14:17.69,Default,,0,0,0,,Бүгін жұмыс бітті.
Dialogue: 0,0:14:17.77,0:14:18.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:18.77,0:14:22.44,Default,,0,0,0,,Маған салмақ мәселесін шешу қиынға соғады.
Dialogue: 0,0:14:23.98,0:14:26.40,Default,,0,0,0,,Жарайды, мен де саған көмектесемін.
Dialogue: 0,0:14:29.49,0:14:32.53,Default,,0,0,0,,Бірінші және екінші қозғалтқышты оңтайландыру
Dialogue: 0,0:14:32.62,0:14:35.95,Default,,0,0,0,,Қозғалтқыш түрі параллель. Бағалау аяқталды
Dialogue: 0,0:14:36.04,0:14:37.62,Default,,0,0,0,,Пайдалы жүктеме Мәселе жоқ
Dialogue: 0,0:14:37.71,0:14:40.71,Default,,0,0,0,,TWR – мақсатты ауқым
Dialogue: 0,0:14:40.79,0:14:42.63,Default,,0,0,0,,Модельдеуді бастау
Dialogue: 0,0:14:49.80,0:14:51.64,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:14:51.72,0:14:53.85,Default,,0,0,0,,Бұл сәл көбірек болды
Dialogue: 0,0:14:53.93,0:14:57.23,Default,,0,0,0,,Меніңше, өмірді қамтамасыз ету жүйесін қысқарту ғана қалды... Ах.
Dialogue: 0,0:14:57.23,0:14:58.14,Default,,0,0,0,,Меніңше, өмірді қамтамасыз ету жүйесін қысқарту ғана қалды... Ах.
Dialogue: 0,0:14:57.23,0:14:58.14,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:15:01.86,0:15:04.69,Default,,0,0,0,,Ячио-чан, күткендей, бәрі...
Dialogue: 0,0:15:04.77,0:15:07.49,Default,,0,0,0,,Шешімі табылған болуы мүмкін
Dialogue: 0,0:15:08.61,0:15:10.70,Default,,0,0,0,,Бұл менің көлігім
Dialogue: 0,0:15:10.78,0:15:13.37,Default,,0,0,0,,Содан кейін жолаушыларға арналған оттегі цистерналары және
Dialogue: 0,0:15:13.45,0:15:17.00,Default,,0,0,0,,Өмірді қамтамасыз етудің басқа жүйелері қажет емес.
Dialogue: 0,0:15:17.08,0:15:22.33,Default,,0,0,0,,Күн сәулесінен қуат алады, ұзақ жұмыс істеуге болады
Dialogue: 0,0:15:22.42,0:15:23.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:23.59,0:15:25.80,Default,,0,0,0,,Бұл 100% қауіпсіз емес.
Dialogue: 0,0:15:25.88,0:15:28.01,Default,,0,0,0,,Қиындық туындағанда не істеу керек
Dialogue: 0,0:15:28.09,0:15:30.84,Default,,0,0,0,,Понко көбірек біледі
Dialogue: 0,0:15:30.93,0:15:34.97,Default,,0,0,0,,Қауіпсіз болса, бортқа қосымша қызметкерлерді әкеле алмайсыз.
Dialogue: 0,0:15:35.06,0:15:36.81,Default,,0,0,0,,Ал ол үшін не істеу керек?
Dialogue: 0,0:15:36.89,0:15:40.44,Default,,0,0,0,,Сол кезде Понко-саннан сабақ алсаңыз болғаны.
Dialogue: 0,0:15:40.52,0:15:41.94,Default,,0,0,0,,Ғаламды бағалама!
Dialogue: 0,0:15:42.02,0:15:44.94,Default,,0,0,0,,Өмір сүре алмайтын жер.
Dialogue: 0,0:15:45.02,0:15:49.57,Default,,0,0,0,,Бұл жағдайда мен, робот, дұрыс адам болар едім.
Dialogue: 0,0:15:50.99,0:15:53.45,Default,,0,0,0,,Ячио-чан тірі.
Dialogue: 0,0:15:55.66,0:15:58.20,Default,,0,0,0,,Басқа шешімдерді қарастыру кезінде
Dialogue: 0,0:15:58.29,0:16:01.16,Default,,0,0,0,,Акумаге мырза келсе не істейсіз?
Dialogue: 0,0:16:01.25,0:16:02.71,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:02.79,0:16:05.25,Default,,0,0,0,,Құдайдың қызметкерлерін тез орналастырыңыз
Dialogue: 0,0:16:05.34,0:16:08.34,Default,,0,0,0,,Мен де, Понко-сан және барлығы
Dialogue: 0,0:16:08.42,0:16:11.76,Default,,0,0,0,,Мен қонақүйді мәңгілікке қорғағым келеді.
Dialogue: 0,0:16:11.84,0:16:13.13,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:16:14.80,0:16:16.14,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:17.01,0:16:21.35,Default,,0,0,0,,Осы зымыранмен Понко Ячио-чанды ғарышқа жеткізеді.
Dialogue: 0,0:16:25.02,0:16:26.15,Default,,0,0,0,,Мен оны көріп тұрмын
Dialogue: 0,0:16:26.23,0:16:29.82,Default,,0,0,0,,Біз қандай қонақүйді көздеп отырмыз?
Dialogue: 0,0:16:29.90,0:16:31.57,Default,,0,0,0,,Иә
Dialogue: 0,0:16:31.65,0:16:33.41,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:44.46,0:16:45.67,Default,,0,0,0,,Иә
Dialogue: 0,0:16:45.75,0:16:48.25,Default,,0,0,0,,Бұл мүлдем ақылсыз
Dialogue: 0,0:16:48.34,0:16:50.67,Default,,0,0,0,,Менің келгеніме 70 жыл болды.
Dialogue: 0,0:16:50.76,0:16:52.84,Default,,0,0,0,,Бұл ұзақ жол болды
Dialogue: 0,0:16:52.92,0:16:56.85,Default,,0,0,0,,Қанша рет қабырғаға соққан сайын берілгің келетінін сездің бе?
Dialogue: 0,0:16:56.93,0:16:59.31,Default,,0,0,0,,Әрбір қабырға есік
Dialogue: 0,0:16:59.39,0:17:03.06,Default,,0,0,0,,Бірінші қадамды жасау ғана қалды.
Dialogue: 0,0:17:06.52,0:17:07.98,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:17:08.06,0:17:09.69,Default,,0,0,0,,Жоқ, дәл солай.
Dialogue: 0,0:17:11.90,0:17:14.40,Default,,0,0,0,,Ячио-чан, сен осылай киініп барасың ба?
Dialogue: 0,0:17:14.49,0:17:16.70,Default,,0,0,0,,Иә, жұмыс істеп жатырмын.
Dialogue: 0,0:17:16.78,0:17:18.95,Default,,0,0,0,,Мен де шашымды дұрыстап байладым.
Dialogue: 0,0:17:19.03,0:17:21.45,Default,,0,0,0,,Ыстыққа төзімді материалдан жаңадан жасалған
Dialogue: 0,0:17:23.54,0:17:24.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:24.54,0:17:26.46,Default,,0,0,0,,Ячио-чан, жақсысың ба?
Dialogue: 0,0:17:26.54,0:17:28.29,Default,,0,0,0,,(Тсубаки) Дегенмен, Косэйдің аяғына зақым келгеніне қуаныштымын—
Dialogue: 0,0:17:28.38,0:17:32.13,Default,,0,0,0,,Бұл менің ғарышқа бірінші рет шығуым, сондықтан қорқынышты болуы мүмкін деп ойладым.
Dialogue: 0,0:17:32.84,0:17:35.34,Default,,0,0,0,,Мен бұл сезімді түсінбеймін.
Dialogue: 0,0:17:35.43,0:17:36.89,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:36.97,0:17:40.51,Default,,0,0,0,,Мен қорқатын жалғыз адам - ​​әрқашан Понко.
Dialogue: 0,0:17:40.60,0:17:43.93,Default,,0,0,0,,Әй, ғарыштан көрінген Жер шынымен де әдемі.
Dialogue: 0,0:17:44.02,0:17:45.73,Default,,0,0,0,,Сіз таң қаласыз.
Dialogue: 0,0:17:45.81,0:17:48.02,Default,,0,0,0,,...
Dialogue: 0,0:17:48.10,0:17:49.11,Default,,0,0,0,,Иә
Dialogue: 0,0:17:49.19,0:17:51.61,Default,,0,0,0,,Ячио-чан, маған қолыңды соз
Dialogue: 0,0:17:58.28,0:18:00.37,Default,,0,0,0,,Мен Ячио-чанды жақсы көремін
Dialogue: 0,0:18:00.45,0:18:01.79,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:01.87,0:18:03.45,Default,,0,0,0,,Аман-есен оралыңыз
Dialogue: 0,0:18:03.54,0:18:06.25,Default,,0,0,0,,Біз жұмысымызды кейінге қалдырғымыз келмейді.
Dialogue: 0,0:18:06.33,0:18:07.87,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:18:07.96,0:18:09.42,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:18:11.46,0:18:12.92,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:18:13.00,0:18:16.05,Default,,0,0,0,,Он тоғыз сегіз…
Dialogue: 0,0:18:16.13,0:18:18.13,Default,,0,0,0,,Тұтану ретін бастау
Dialogue: 0,0:18:18.84,0:18:23.64,Default,,0,0,0,,Бес төрт үш екі бір
Dialogue: 0,0:18:23.72,0:18:26.23,Default,,0,0,0,,Барлық қозғалтқыш жұмыс істейді
Dialogue: 0,0:18:26.31,0:18:27.56,Default,,0,0,0,,Көтерілу
Dialogue: 0,0:18:43.24,0:18:45.16,Default,,0,0,0,,Бірінші үдеткіш қозғалыс қалыпты
Dialogue: 0,0:18:46.04,0:18:47.62,Default,,0,0,0,,Әрбір мән Аномалия жоқ
Dialogue: 0,0:18:47.71,0:18:51.13,Default,,0,0,0,,Ұшақ дыбыстан жоғары жылдамдықта максималды динамикалық қысымға жетеді
Dialogue: 0,0:18:51.21,0:18:53.67,Default,,0,0,0,,Мұнда басыңыз HG1 Түсінікті
Dialogue: 0,0:18:57.76,0:18:58.68,Default,,0,0,0,,Дроссельді төмендетіңіз
Dialogue: 0,0:18:58.76,0:19:00.76,Default,,0,0,0,,Дроссельді төмендетіңіз
Dialogue: 0,0:19:00.84,0:19:02.55,Default,,0,0,0,,Бұл Загин Келесі кезеңге өту
Dialogue: 0,0:19:02.64,0:19:04.81,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:19:04.89,0:19:06.68,Default,,0,0,0,,1-ші күшейткіш бөлу
Dialogue: 0,0:19:06.77,0:19:09.69,Default,,0,0,0,,Келесі, екінші күшейткіш тұтану
Dialogue: 0,0:19:15.11,0:19:17.19,Default,,0,0,0,,Екінші күшейткіш бөлу
Dialogue: 0,0:19:17.78,0:19:20.20,Default,,0,0,0,,Бос орынға тіркелу аяқталды
Dialogue: 0,0:19:20.28,0:19:23.20,Default,,0,0,0,,(Барлығының қуаныш дауысы)
Dialogue: 0,0:19:24.20,0:19:28.20,Default,,0,0,0,,Мұнда басыңыз HG1 Қозғалтқышты тоқтату Мақсатты нүктеге жету
Dialogue: 0,0:19:28.29,0:19:31.37,Default,,0,0,0,,Бұл Загин, істер жақсы жүріп жатыр.
Dialogue: 0,0:19:31.46,0:19:34.25,Default,,0,0,0,,Енді спутникті ажыратамыз.
Dialogue: 0,0:19:35.30,0:19:36.71,Default,,0,0,0,,Галактика мұнарасының он ережесі
Dialogue: 0,0:19:36.80,0:19:40.34,Default,,0,0,0,,Галактикадағы ең жақсы қонақүй болуды мақсат ету
Dialogue: 0,0:19:40.43,0:19:43.68,Default,,0,0,0,,Бір нәрсе: Тамақтануда, әдептілікте мәдениет бар.
Dialogue: 0,0:19:43.76,0:19:48.06,Default,,0,0,0,,Сіздің өміріңіз үшін бүгін шақырылған бетбелгі.
Dialogue: 0,0:19:48.14,0:19:51.39,Default,,0,0,0,,Күлімсіреу - ең жақсы интерьер
Dialogue: 0,0:19:51.48,0:19:55.19,Default,,0,0,0,,Қонақжайлылықта жамандық жоқ.
Dialogue: 0,0:19:55.27,0:19:58.94,Default,,0,0,0,,Мұнда басыңыз HG1 Жарнамалық спутниктік бөлу расталды
Dialogue: 0,0:19:59.03,0:20:01.74,Default,,0,0,0,,Әрі қарай, RFG жүктеңіз
Dialogue: 0,0:20:40.94,0:20:42.49,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:20:44.82,0:20:47.24,Default,,0,0,0,,(Барлығының қуаныш дауысы)
Dialogue: 0,0:20:47.91,0:20:49.54,Default,,0,0,0,,Ha… күн жарқырауы
Dialogue: 0,0:21:07.14,0:21:10.14,Default,,0,0,0,,Көптеген жоғары энергиялы зарядталған бөлшектерді бақылау
Dialogue: 0,0:21:10.22,0:21:12.10,Default,,0,0,0,,Егер ол адам болса, бұл лезде өлім деңгейі болар еді.
Dialogue: 0,0:21:12.18,0:21:14.85,Default,,0,0,0,,Жақсы нәрсе Ячио-чан робот екен
Dialogue: 0,0:21:16.02,0:21:18.73,Default,,0,0,0,,Бұл Загин Ячио-чан, не болды?
Dialogue: 0,0:21:18.82,0:21:21.19,Default,,0,0,0,,Ячио-чан Ячио-чан!
Dialogue: 0,0:21:25.86,0:21:28.07,Default,,0,0,0,,Понко айтқандай
Dialogue: 0,0:21:28.16,0:21:30.74,Default,,0,0,0,,Жер әдемі еді
Dialogue: 0,0:21:31.87,0:21:34.91,Default,,0,0,0,,Ха... бұл...
Dialogue: 0,0:21:35.00,0:21:37.75,Default,,0,0,0,,Бұл жағдай болуы мүмкін.
Dialogue: 0,0:21:38.54,0:21:41.25,Default,,0,0,0,,Бұл сезім болуы керек...
Dialogue: 0,0:21:41.84,0:21:43.42,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:21:43.51,0:21:44.88,Default,,0,0,0,,Қосымша миссия
Dialogue: 0,0:21:44.97,0:21:47.26,Default,,0,0,0,,Ғарышта жоғалтуға қол жеткізілді
Dialogue: 0,0:21:47.34,0:21:49.05,Default,,0,0,0,,Өзін-өзі жою функциясы қосылды
Dialogue: 0,0:21:49.14,0:21:52.06,Default,,0,0,0,,Мен жұлдыз шаңы болуды ұсынамын.
Dialogue: 0,0:21:58.40,0:22:01.19,Default,,0,0,0,,Мен сені енді көре алмаймын.
Dialogue: 0,0:22:02.98,0:22:04.78,Default,,0,0,0,,Ал сөмкемедегі заттар да…
Dialogue: 0,0:22:10.03,0:22:15.04,Default,,0,0,0,,♪～
Dialogue: 0,0:22:55.04,0:22:59.96,Default,,0,0,0,,～♪
