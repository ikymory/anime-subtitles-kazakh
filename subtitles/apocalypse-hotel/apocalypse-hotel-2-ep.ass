Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.80,0:00:09.63,Default,,0,0,0,,Біздің сүйікті тұтынушыларымызға
Dialogue: 0,0:00:09.71,0:00:12.93,Default,,0,0,0,,Жүректі күн және ең жақсы күлкі
Dialogue: 0,0:00:13.68,0:00:16.55,Default,,0,0,0,,Gingarou қонақ үйіне қош келдіңіз
Dialogue: 0,0:00:16.64,0:00:17.93,Default,,0,0,0,,Иә
Dialogue: 0,0:00:18.01,0:00:23.02,Default,,0,0,0,,♪～
Dialogue: 0,0:01:42.93,0:01:47.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:56.32,0:02:00.99,Default,,0,0,0,,Сіз бүгінге тапсырыс берген жоқсыз, бірақ қалғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:02:01.08,0:02:06.00,Default,,0,0,0,,Зукури-но-ма-ба но-нема
Dialogue: 0,0:02:06.08,0:02:07.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:16.34,0:02:19.47,Default,,0,0,0,,...
Dialogue: 0,0:02:19.55,0:02:21.60,Default,,0,0,0,,Сіз түнде қалғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:02:21.68,0:02:22.89,Default,,0,0,0,,Мияу?
Dialogue: 0,0:02:22.97,0:02:25.22,Default,,0,0,0,,Сіз түнде қалғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:02:25.31,0:02:26.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:26.52,0:02:29.27,Default,,0,0,0,,Сіз түнде қалғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:02:29.35,0:02:31.61,Default,,0,0,0,,Сіз түнде қалғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:02:31.69,0:02:35.19,Default,,0,0,0,,Сіз түнде қалғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:02:35.28,0:02:36.15,Default,,0,0,0,,Мияу!
Dialogue: 0,0:02:41.24,0:02:43.37,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:02:43.45,0:02:45.91,Default,,0,0,0,,Сіз ұйықтағыңыз келе ме?
Dialogue: 0,0:02:52.88,0:02:55.09,Default,,0,0,0,,Сіз ұйықтағыңыз келеді.
Dialogue: 0,0:02:58.92,0:03:00.47,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:03:00.55,0:03:04.05,Default,,0,0,0,,Тұрғын үй тізімін толтырыңыз.
Dialogue: 0,0:03:04.14,0:03:07.06,Default,,0,0,0,,Баонема
Dialogue: 0,0:03:07.77,0:03:10.85,Default,,0,0,0,,Нонема Куджу?
Dialogue: 0,0:03:10.94,0:03:12.94,Default,,0,0,0,,Мұнда толтырыңыз
Dialogue: 0,0:03:23.45,0:03:25.45,Default,,0,0,0,,Кешіріңіз, тұтынушы.
Dialogue: 0,0:03:25.53,0:03:28.29,Default,,0,0,0,,Маған атыңызды ауызша айтып беріңізші.
Dialogue: 0,0:03:28.87,0:03:30.21,Default,,0,0,0,,Куо?
Dialogue: 0,0:03:30.29,0:03:33.92,Default,,0,0,0,,Мен Я Чи Йо
Dialogue: 0,0:03:34.00,0:03:34.96,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:03:35.04,0:03:37.46,Default,,0,0,0,,Джужама
Dialogue: 0,0:03:37.55,0:03:40.51,Default,,0,0,0,,Мен сізді Джужама мырза деп атасам жарай ма?
Dialogue: 0,0:03:40.59,0:03:43.47,Default,,0,0,0,,...
Dialogue: 0,0:03:43.55,0:03:46.22,Default,,0,0,0,,Құрметті Джужама-сама
Dialogue: 0,0:03:47.35,0:03:48.47,Default,,0,0,0,,Гуаа…
Dialogue: 0,0:03:55.27,0:03:58.07,Default,,0,0,0,,Бұл сіздің бөлме кілті.
Dialogue: 0,0:04:00.28,0:04:01.70,Default,,0,0,0,,Ku…
Dialogue: 0,0:04:07.28,0:04:08.37,Default,,0,0,0,,А...
Dialogue: 0,0:04:13.33,0:04:14.96,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:04:15.04,0:04:18.50,Default,,0,0,0,,Енді мен саған тікелей бөлмеңді көрсетемін.
Dialogue: 0,0:04:35.35,0:04:36.19,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:04:36.27,0:04:39.69,Default,,0,0,0,,(Саяхаттаушы бөгде адамның таңданған дауысы)
Dialogue: 0,0:04:42.44,0:04:45.11,Default,,0,0,0,,Бұл сіздің бөлмеңіз.
Dialogue: 0,0:04:46.28,0:04:49.45,Default,,0,0,0,,Жабдықты пайдалану тегін.
Dialogue: 0,0:04:49.54,0:04:52.87,Default,,0,0,0,,Ол тазалау кезінде қайта толтырылады, сондықтан оны сол күйінде қалдыра аласыз.
Dialogue: 0,0:04:52.96,0:04:54.87,Default,,0,0,0,,О...
Dialogue: 0,0:04:54.96,0:04:57.58,Default,,0,0,0,,Мұнда басыңыз Біздің қонақүй ережелері
Dialogue: 0,0:04:57.67,0:05:00.84,Default,,0,0,0,,Әрбір нысанды пайдалану туралы нұсқаулар жазылған.
Dialogue: 0,0:05:00.92,0:05:03.84,Default,,0,0,0,,Сұрақтарыңыз болса, маған хабарласыңыз.
Dialogue: 0,0:05:04.72,0:05:06.09,Default,,0,0,0,,Және
Dialogue: 0,0:05:06.80,0:05:08.89,Default,,0,0,0,,Сіз мейрамхананы да пайдалана аласыз.
Dialogue: 0,0:05:09.51,0:05:11.56,Default,,0,0,0,,Егер сіз аштық сезінсеңіз
Dialogue: 0,0:05:11.64,0:05:13.14,Default,,0,0,0,,Мұнда келіңіз
Dialogue: 0,0:05:15.31,0:05:18.15,Default,,0,0,0,,Хм! Урёнуо?
Dialogue: 0,0:05:23.53,0:05:26.41,Default,,0,0,0,,Бұл жуынатын бөлме.
Dialogue: 0,0:05:26.49,0:05:28.87,Default,,0,0,0,,Puppyari сенсің!
Dialogue: 0,0:05:28.95,0:05:29.91,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:29.99,0:05:32.45,Default,,0,0,0,,Дұрыс, бұл сусабынға арналған қалпақ!
Dialogue: 0,0:05:32.54,0:05:34.20,Default,,0,0,0,,Сіз оны пайдаланасыз, солай ма?
Dialogue: 0,0:05:36.75,0:05:37.96,Default,,0,0,0,,Ju…
Dialogue: 0,0:05:38.04,0:05:39.21,Default,,0,0,0,,А...
Dialogue: 0,0:05:41.05,0:05:43.51,Default,,0,0,0,,Сусабынға арналған қалпақ, солай ма?
Dialogue: 0,0:05:43.59,0:05:45.01,Default,,0,0,0,,Жуу…
Dialogue: 0,0:05:45.09,0:05:47.30,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:47.38,0:05:49.09,Default,,0,0,0,,үшінңыз тыңдаңыздар.
Dialogue: 0,0:05:49.18,0:05:52.31,Default,,0,0,0,,Сіз қонақүйді сусабын қалпақсыз басқара аласыз.
Dialogue: 0,0:05:52.39,0:05:56.02,Default,,0,0,0,,Бұдан былай 405-бөлме тек басқа ғаламшарларға арналған болады.
Dialogue: 0,0:05:56.10,0:05:57.44,Default,,0,0,0,,Сәл күте тұр, қыз.
Dialogue: 0,0:05:57.52,0:06:02.07,Default,,0,0,0,,Жерден тыс тіршілік формалары қонақ ретінде қамтыла ма?
Dialogue: 0,0:06:02.15,0:06:03.40,Default,,0,0,0,,А...
Dialogue: 0,0:06:04.07,0:06:06.36,Default,,0,0,0,,(А тазалау роботының дауысы)
Dialogue: 0,0:06:06.45,0:06:09.57,Default,,0,0,0,,Иә, жануарлар мен үй жануарларына рұқсат етілмейді.
Dialogue: 0,0:06:09.66,0:06:11.45,Default,,0,0,0,,Дегенмен, біздің қонақүй ережелеріне сәйкес
Dialogue: 0,0:06:11.53,0:06:14.66,Default,,0,0,0,,Жерден тыс тіршілік формаларына қатысты тармақ жоқ болғандықтан
Dialogue: 0,0:06:14.75,0:06:17.21,Default,,0,0,0,,Жануарлар ретінде қарауға болмайды
Dialogue: 0,0:06:17.29,0:06:20.46,Default,,0,0,0,,Арнайы шара ретінде біз сіздің санатыңызды жаңартамыз.
Dialogue: 0,0:06:20.54,0:06:23.00,Default,,0,0,0,,Жерден тыс тіршілік формаларын қосыңыз
Dialogue: 0,0:06:23.09,0:06:24.09,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:06:24.17,0:06:26.26,Default,,0,0,0,,Егер сіз тұтынушы болсаңыз
Dialogue: 0,0:06:26.34,0:06:30.09,Default,,0,0,0,,Біз қонақжайлылықты қамтамасыз етуіміз керек, бұл біздің қонақүйдің беделіне қауіп төндіреді.
Dialogue: 0,0:06:32.14,0:06:34.72,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:06:34.81,0:06:35.64,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:06:35.72,0:06:39.35,Default,,0,0,0,,Енді 100 жылдағы бірінші тұтынушыға.
Dialogue: 0,0:06:39.44,0:06:43.15,Default,,0,0,0,,Жүректен шыққан күн мен ең жақсы күлкі сыйлайық
Dialogue: 0,0:06:52.87,0:06:55.16,Default,,0,0,0,,Бұл негізгі тағам болады.
Dialogue: 0,0:07:12.51,0:07:13.85,Default,,0,0,0,,Кули
Dialogue: 0,0:07:18.39,0:07:20.39,Default,,0,0,0,,(қызған дауыс)
Dialogue: 0,0:07:20.48,0:07:22.94,Default,,0,0,0,,Сізге тағам ұнады ма?
Dialogue: 0,0:07:23.02,0:07:25.36,Default,,0,0,0,,(Саяхаттағы бөтен адамның құмарлы дауысы)
Dialogue: 0,0:07:25.44,0:07:27.44,Default,,0,0,0,,Дәл сол нәрсеге қызмет еткіңіз келе ме?
Dialogue: 0,0:07:27.53,0:07:29.90,Default,,0,0,0,,(Саяхаттағы бөтен адамның құмарлық дауысы)
Dialogue: 0,0:07:36.87,0:07:38.58,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:07:38.66,0:07:41.17,Default,,0,0,0,,Су-но-ха
Dialogue: 0,0:07:41.25,0:07:44.63,Default,,0,0,0,,Киімдерің лас сияқты.
Dialogue: 0,0:07:44.71,0:07:47.30,Default,,0,0,0,,Біздің кір жуу қызметін пайдаланғыңыз келе ме?
Dialogue: 0,0:07:47.38,0:07:49.30,Default,,0,0,0,,Гагагаа...
Dialogue: 0,0:07:51.88,0:07:54.89,Default,,0,0,0,,Ууу!
Dialogue: 0,0:07:54.97,0:07:57.97,Default,,0,0,0,,Құрметті тұтынушы, күткеніңізге рахмет.
Dialogue: 0,0:07:58.06,0:08:01.27,Default,,0,0,0,,(Саяхатшы бөгде адамның үрейлі дауысы)
Dialogue: 0,0:08:04.15,0:08:04.98,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:05.06,0:08:07.98,Default,,0,0,0,,Ухёча!
Dialogue: 0,0:08:11.07,0:08:12.03,Default,,0,0,0,,А...
Dialogue: 0,0:08:12.11,0:08:14.99,Default,,0,0,0,,Неге ашуға рұқсат бермейсің?
Dialogue: 0,0:09:02.54,0:09:05.12,Default,,0,0,0,,Бүгін сенің үшінші күнің.
Dialogue: 0,0:09:05.21,0:09:08.92,Default,,0,0,0,,Біздің тұтынушылардың көңілінен шықты ма?
Dialogue: 0,0:09:09.54,0:09:12.67,Default,,0,0,0,,Мен байланысып жатқанымызға сенімді емеспін.
Dialogue: 0,0:09:12.76,0:09:14.17,Default,,0,0,0,,(Роботтардың дауыстары)
Dialogue: 0,0:09:14.26,0:09:18.01,Default,,0,0,0,,Егер көңіліңізден шықпаса, кете алатыныңызға сенімдімін.
Dialogue: 0,0:09:18.10,0:09:22.06,Default,,0,0,0,,Бұл аймақта басқа қонақүйлер ашылған жоқ.
Dialogue: 0,0:09:22.14,0:09:23.56,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:23.64,0:09:26.10,Default,,0,0,0,,Ах... а... Мистер есікші Робо?
Dialogue: 0,0:09:31.65,0:09:33.03,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:09:33.86,0:09:36.66,Default,,0,0,0,,Хяхахахаха!
Dialogue: 0,0:09:36.74,0:09:38.78,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:09:38.87,0:09:41.95,Default,,0,0,0,,Мен мұндай жерде қонақүй бар екенін білмедім.
Dialogue: 0,0:09:42.04,0:09:43.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:56.72,0:09:57.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:57.63,0:09:59.89,Default,,0,0,0,,Gingarou қонақ үйіне қош келдіңіз
Dialogue: 0,0:09:59.97,0:10:02.56,Default,,0,0,0,,Сәлем! Мен жай ғана қош келдіңіз дедім бе?
Dialogue: 0,0:10:02.64,0:10:05.18,Default,,0,0,0,,Келіңіздер, мен тұтынушы емеспін.
Dialogue: 0,0:10:05.77,0:10:06.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:06.69,0:10:08.52,Default,,0,0,0,,Бастамас бұрын...
Dialogue: 0,0:10:09.48,0:10:11.82,Default,,0,0,0,,Мына жігіт жақсы ма?
Dialogue: 0,0:10:14.36,0:10:17.28,Default,,0,0,0,,Мен әрқашан кешірім сұраймын, қыз.
Dialogue: 0,0:10:17.36,0:10:20.03,Default,,0,0,0,,Не, әрқашан осылай болды ма?
Dialogue: 0,0:10:20.74,0:10:23.24,Default,,0,0,0,,Мен саған бірдеңе жасағым келеді.
Dialogue: 0,0:10:23.33,0:10:25.45,Default,,0,0,0,,Тұтынушыға есікті ашыңыз
Dialogue: 0,0:10:25.54,0:10:27.96,Default,,0,0,0,,Егер ол бұзылса, мен оны қалаймын
Dialogue: 0,0:10:28.04,0:10:29.88,Default,,0,0,0,,Бұл адам тұтынушы емес.
Dialogue: 0,0:10:29.96,0:10:30.88,Default,,0,0,0,,Не!
Dialogue: 0,0:10:30.96,0:10:33.09,Default,,0,0,0,,Маған сенетініне сенімді емеспін.
Dialogue: 0,0:10:33.17,0:10:34.88,Default,,0,0,0,,Сонда сіз ше?
Dialogue: 0,0:10:34.96,0:10:36.13,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:10:36.21,0:10:38.13,Default,,0,0,0,,Кімді естідің?
Dialogue: 0,0:10:38.72,0:10:42.39,Default,,0,0,0,,Мен қоршаған ортаны тексеретін роботпын!
Dialogue: 0,0:10:42.47,0:10:43.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:44.43,0:10:46.64,Default,,0,0,0,,Қоршаған ортаны тексеру?
Dialogue: 0,0:10:46.73,0:10:47.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:48.27,0:10:50.02,Default,,0,0,0,,Адамдардың жерден ұшып шығуы
Dialogue: 0,0:10:50.10,0:10:54.36,Default,,0,0,0,,Қайтып оралсам деп армандап, Артымда қалдым дүниені.
Dialogue: 0,0:10:54.44,0:10:57.15,Default,,0,0,0,,Біз қоршаған ортаны тексеретін роботтармыз
Dialogue: 0,0:10:57.74,0:10:59.28,Default,,0,0,0,,Бүкіл әлемде...
Dialogue: 0,0:10:59.36,0:11:02.62,Default,,0,0,0,,Біраз уақыт достарыммен көңілді болдым.
Dialogue: 0,0:11:02.70,0:11:07.00,Default,,0,0,0,,Біраз уақыт бұрын Океания жігітімен де байланыс үзілді.
Dialogue: 0,0:11:07.08,0:11:09.46,Default,,0,0,0,,Енді толығымен дербес
Dialogue: 0,0:11:09.54,0:11:13.38,Default,,0,0,0,,Енді біз осы планетаның атмосферасын, оның суын және басқалардың бәрін қарастырамыз.
Dialogue: 0,0:11:13.46,0:11:17.05,Default,,0,0,0,,Адамзат өмір сүре алады ма, соны шеше алатын жалғыз адаммын!
Dialogue: 0,0:11:17.13,0:11:20.43,Default,,0,0,0,,Сіз бұл үміт символы деп айтуға болады!
Dialogue: 0,0:11:20.51,0:11:21.68,Default,,0,0,0,,Үміт…
Dialogue: 0,0:11:21.76,0:11:22.89,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:11:22.97,0:11:27.22,Default,,0,0,0,,Содан кейін кенеттен бұл жердегі экологиялық құндылықтар әдеттен тыс өзгерді.
Dialogue: 0,0:11:27.31,0:11:30.98,Default,,0,0,0,,«Эй, эй, не болып жатыр!» Сондықтан мен оны көруге келдім.
Dialogue: 0,0:11:31.06,0:11:34.52,Default,,0,0,0,,Сонда қалай ойлайсың? Бұл біртүрлі кеме.
Dialogue: 0,0:11:34.61,0:11:37.94,Default,,0,0,0,,Оның үстіне борттағы адам тірі және қозғалып тұрған.
Dialogue: 0,0:11:38.03,0:11:39.11,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:39.19,0:11:41.41,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:11:42.57,0:11:44.24,Default,,0,0,0,,Мұнда бірдеңе келмеді ме?
Dialogue: 0,0:11:45.12,0:11:47.54,Default,,0,0,0,,Тұтынушыдан басқа кез келген адам...
Dialogue: 0,0:11:51.83,0:11:54.33,Default,,0,0,0,,Сіз басқа планетадан келе жатқан сияқтысыз.
Dialogue: 0,0:11:54.42,0:11:57.21,Default,,0,0,0,,Сіз бұл кеменің иесісіз, солай емес пе?
Dialogue: 0,0:11:58.26,0:11:59.38,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:59.46,0:12:00.97,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:12:01.05,0:12:03.76,Default,,0,0,0,,Жарайды, тез арада шешіп алайық.
Dialogue: 0,0:12:09.02,0:12:10.56,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:12:10.64,0:12:11.77,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:12:11.85,0:12:14.69,Default,,0,0,0,,Бізде де осындай функция бар.
Dialogue: 0,0:12:14.77,0:12:17.27,Default,,0,0,0,,Ол кісі біздің қонақүйдің қонағы.
Dialogue: 0,0:12:17.36,0:12:18.73,Default,,0,0,0,,Жер үшін де
Dialogue: 0,0:12:18.82,0:12:20.78,Default,,0,0,0,,Сіз өзіңізді тұтынушы деп айта аласыз ба?
Dialogue: 0,0:12:20.86,0:12:22.15,Default,,0,0,0,,А...
Dialogue: 0,0:12:25.62,0:12:28.12,Default,,0,0,0,,Көмірдей бол
Dialogue: 0,0:12:30.37,0:12:31.46,Default,,0,0,0,,№
Dialogue: 0,0:12:31.54,0:12:33.67,Default,,0,0,0,,Сонда да сол адам
Dialogue: 0,0:12:33.75,0:12:36.38,Default,,0,0,0,,Мен қонақүйіміздің қонағымын.
Dialogue: 0,0:12:39.30,0:12:40.38,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:12:40.46,0:12:43.72,Default,,0,0,0,,Әзірге ол әлі тұтынушы болып тұрғанда онымен араласпаңыз.
Dialogue: 0,0:12:43.80,0:12:44.93,Default,,0,0,0,,(түрлендірілетін дыбыс)
Dialogue: 0,0:12:45.51,0:12:47.72,Default,,0,0,0,,...енді тұтынушы емес.
Dialogue: 0,0:12:47.80,0:12:49.22,Default,,0,0,0,,Дереу тыйым салу.
Dialogue: 0,0:12:49.31,0:12:52.56,Default,,0,0,0,,Осы жерде біраз тұруға рұқсат етіңіз.
Dialogue: 0,0:13:31.89,0:13:33.10,Default,,0,0,0,,Сәлем Ячиё!
Dialogue: 0,0:13:33.18,0:13:35.06,Default,,0,0,0,,Мен сенен бір нәрсе сұрай алмаймын.
Dialogue: 0,0:13:35.14,0:13:37.23,Default,,0,0,0,,Неліктен бұлай істей бересің?
Dialogue: 0,0:13:37.31,0:13:39.31,Default,,0,0,0,,Бір ғана адам қалса да
Dialogue: 0,0:13:39.40,0:13:44.11,Default,,0,0,0,,Адамзат қайтып келгенше осы қонақүйді қорғаңыз
Dialogue: 0,0:13:44.19,0:13:46.57,Default,,0,0,0,,Бұл біздің иесіне берген уәдеміз.
Dialogue: 0,0:13:46.66,0:13:49.41,Default,,0,0,0,,Ха! Шын айтасың ба?
Dialogue: 0,0:13:50.03,0:13:51.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:51.49,0:13:53.70,Default,,0,0,0,,Мен соңғы 100 жыл болдым
Dialogue: 0,0:13:53.79,0:13:58.08,Default,,0,0,0,,Өзім басқарған ауданды айналып жүріп, мың бұрылдым аспанға.
Dialogue: 0,0:13:58.17,0:14:00.71,Default,,0,0,0,,Қоршаған ортаның жай-күйі туралы хабарлады
Dialogue: 0,0:14:00.79,0:14:02.25,Default,,0,0,0,,Қазір де?
Dialogue: 0,0:14:02.34,0:14:04.67,Default,,0,0,0,,Мен оны нүкте бойынша хабарлап отырмын.
Dialogue: 0,0:14:04.76,0:14:07.01,Default,,0,0,0,,Адамдар не дейді?
Dialogue: 0,0:14:07.09,0:14:08.55,Default,,0,0,0,,Соңғы онжылдықтарда...
Dialogue: 0,0:14:09.18,0:14:11.30,Default,,0,0,0,,Ешқашан жауап алған жоқ
Dialogue: 0,0:14:11.89,0:14:12.81,Default,,0,0,0,,А...
Dialogue: 0,0:14:12.89,0:14:15.81,Default,,0,0,0,,Таңқаларлық ештеңе жоқ!
Dialogue: 0,0:14:15.89,0:14:19.19,Default,,0,0,0,,Адамдардың келесі 100 жылда қайтып келу ықтималдығы қандай?
Dialogue: 0,0:14:19.27,0:14:22.32,Default,,0,0,0,,0,0000000002%
Dialogue: 0,0:14:22.40,0:14:24.82,Default,,0,0,0,,Негізі - мен!
Dialogue: 0,0:14:25.40,0:14:27.53,Default,,0,0,0,,Ал, мен қайтып келемін.
Dialogue: 0,0:14:27.61,0:14:31.45,Default,,0,0,0,,Біз оның әлі тірі екенін де білмейміз.
Dialogue: 0,0:14:34.70,0:14:41.67,Default,,0,0,0,,Ахх...
Dialogue: 0,0:14:44.42,0:14:45.88,Default,,0,0,0,,Ватт?
Dialogue: 0,0:14:47.30,0:14:48.63,Default,,0,0,0,,Бітті
Dialogue: 0,0:14:49.88,0:14:52.51,Default,,0,0,0,,Адамзат қайтып келмейді
Dialogue: 0,0:14:52.60,0:14:55.31,Default,,0,0,0,,Мен тіпті тұтынушыны танымаймын.
Dialogue: 0,0:14:56.06,0:14:57.68,Default,,0,0,0,,Бітті
Dialogue: 0,0:14:58.56,0:15:01.10,Default,,0,0,0,,Айтпаған дұрыс па?
Dialogue: 0,0:15:01.69,0:15:02.69,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:10.57,0:15:12.07,Default,,0,0,0,,(Пісіру роботының дауысы)
Dialogue: 0,0:15:13.33,0:15:15.58,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:15:15.66,0:15:18.41,Default,,0,0,0,,Піскен тас балық және омар.
Dialogue: 0,0:15:22.71,0:15:27.92,Default,,0,0,0,,(Саяхаттағы бөгде адамның қуанышты дауысы)
Dialogue: 0,0:15:28.01,0:15:30.43,Default,,0,0,0,,(қуаныш дыбыстары)
Dialogue: 0,0:15:35.43,0:15:38.18,Default,,0,0,0,,Ооо... аа...
Dialogue: 0,0:15:38.77,0:15:40.02,Default,,0,0,0,,Рубиба
Dialogue: 0,0:15:40.89,0:15:42.35,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:15:42.44,0:15:44.27,Default,,0,0,0,,Бар!
Dialogue: 0,0:15:47.07,0:15:47.90,Default,,0,0,0,,(кілттерді көтеру дыбысы)
Dialogue: 0,0:15:50.40,0:15:52.78,Default,,0,0,0,,Уақытыңызды бөліп, демалыңыз.
Dialogue: 0,0:15:52.86,0:15:54.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:59.87,0:16:01.29,Default,,0,0,0,,Бүгін де солай.
Dialogue: 0,0:16:01.37,0:16:03.79,Default,,0,0,0,,Тұтынушыларды күлімсіреп қарсы алу
Dialogue: 0,0:16:03.88,0:16:08.80,Default,,0,0,0,,Біздің сүйікті тұтынушыларымызға шын жүректен күн және ең жақсы күлкі
Dialogue: 0,0:16:08.88,0:16:11.13,Default,,0,0,0,,(роботтардың дауыстары)
Dialogue: 0,0:16:13.76,0:16:17.72,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:16:18.47,0:16:19.31,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:19.39,0:16:23.06,Default,,0,0,0,,Әлгі бейбақ мен оны кәдеге жаратпай тұрып өледі!
Dialogue: 0,0:16:23.14,0:16:26.56,Default,,0,0,0,,У-ху-ху У-ху-ху
Dialogue: 0,0:16:26.65,0:16:27.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:32.36,0:16:33.57,Default,,0,0,0,,Я~
Dialogue: 0,0:16:34.61,0:16:35.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:38.83,0:16:41.75,Default,,0,0,0,,Хохохо~
Dialogue: 0,0:16:45.29,0:16:47.09,Default,,0,0,0,,(шишиодоши дыбысы)
Dialogue: 0,0:16:54.55,0:16:57.01,Default,,0,0,0,,Сізге қатты соққы тиген сияқты.
Dialogue: 0,0:16:58.64,0:17:01.60,Default,,0,0,0,,Тұтынушыға 42 минут 7 секунд
Dialogue: 0,0:17:01.68,0:17:04.14,Default,,0,0,0,,78 минут 24 секунд менеджердің орынбасарына
Dialogue: 0,0:17:04.23,0:17:06.15,Default,,0,0,0,,Маған ұрысып қалды
Dialogue: 0,0:17:06.77,0:17:08.65,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:17:08.73,0:17:13.99,Default,,0,0,0,,Мен өзімді тұтынушының сезімін түсінбейтін ақаулы өнім ретінде сезінемін.
Dialogue: 0,0:17:14.82,0:17:16.99,Default,,0,0,0,,Оны қоқысқа тастаңыз
Dialogue: 0,0:17:18.66,0:17:23.08,Default,,0,0,0,,Қонақ үйді басқаруға роботтарды жалдаймын дегенімде.
Dialogue: 0,0:17:23.16,0:17:26.29,Default,,0,0,0,,Көп адамдар бұл мүмкін емес деп күлді.
Dialogue: 0,0:17:26.37,0:17:29.42,Default,,0,0,0,,Табыстың ықтималдығы 0%.
Dialogue: 0,0:17:29.50,0:17:31.42,Default,,0,0,0,,０％…
Dialogue: 0,0:17:31.50,0:17:35.13,Default,,0,0,0,,А, бірақ мен алаңдамай жалғастырдым.
Dialogue: 0,0:17:35.22,0:17:36.93,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:17:37.01,0:17:39.60,Default,,0,0,0,,Адамдар мен роботтар бір-бірін түсіне алады ма
Dialogue: 0,0:17:39.68,0:17:42.22,Default,,0,0,0,,Ықтималдық тұрғысынан ойламаңыз
Dialogue: 0,0:17:42.31,0:17:44.93,Default,,0,0,0,,Мүмкіндіктер тұрғысынан ойланыңыз
Dialogue: 0,0:17:45.44,0:17:49.06,Default,,0,0,0,,Тыңдаңыз, мынаны есте сақтаңыз.
Dialogue: 0,0:17:54.53,0:17:58.07,Default,,0,0,0,,Эй...бұзылған ба?
Dialogue: 0,0:17:58.62,0:17:59.45,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:17:59.53,0:18:02.70,Default,,0,0,0,,Ықтималдық емес, мүмкіндік
Dialogue: 0,0:18:04.29,0:18:06.92,Default,,0,0,0,,Мүмкіндік дегенді қалай түсінесіз?
Dialogue: 0,0:18:07.00,0:18:08.63,Default,,0,0,0,,Менің АИ-ге сәйкес
Dialogue: 0,0:18:08.71,0:18:10.34,Default,,0,0,0,,Шампунь қалпақ болмаса ше?
Dialogue: 0,0:18:10.42,0:18:13.09,Default,,0,0,0,,Gingarou қонақ үйінің өмір сүру деңгейі 0%
Dialogue: 0,0:18:13.76,0:18:16.09,Default,,0,0,0,,Бірақ шетелдік клиенттер
Dialogue: 0,0:18:16.17,0:18:18.38,Default,,0,0,0,,Маған шампунь қалпақ керек емес еді.
Dialogue: 0,0:18:18.47,0:18:19.64,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:18:19.72,0:18:21.60,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:18:21.68,0:18:22.89,Default,,0,0,0,,(шкафтың жабылу дыбысы)
Dialogue: 0,0:18:22.97,0:18:24.85,Default,,0,0,0,,Бұл сергітеді.
Dialogue: 0,0:18:28.65,0:18:30.23,Default,,0,0,0,,«Вакей Сейджаку»
Dialogue: 0,0:18:30.31,0:18:33.36,Default,,0,0,0,,Шайдың жүрегін білдіретін сөздер бар.
Dialogue: 0,0:18:33.44,0:18:37.45,Default,,0,0,0,,Жүректеріңді ашып, бір-біріңді сыйлаңдар
Dialogue: 0,0:18:37.53,0:18:39.61,Default,,0,0,0,,Барлық нәрседе таза бол
Dialogue: 0,0:18:39.70,0:18:44.29,Default,,0,0,0,,Және сабырлы және қимылсыз болыңыз.
Dialogue: 0,0:18:44.37,0:18:49.29,Default,,0,0,0,,Бұл сөз бізге кез келген басқа адаммен байланысу мүмкіндігін береді.
Dialogue: 0,0:18:49.37,0:18:51.25,Default,,0,0,0,,- деді иесі
Dialogue: 0,0:18:51.96,0:18:55.76,Default,,0,0,0,,Тыңдаңыз, тек мынаны есте сақтаңыз.
Dialogue: 0,0:18:55.84,0:18:58.26,Default,,0,0,0,,Сіздің тілегіңіз орындалмауы ықтималдығынан жоғары
Dialogue: 0,0:18:58.34,0:19:00.39,Default,,0,0,0,,Мүмкіндікке сену
Dialogue: 0,0:19:00.97,0:19:04.72,Default,,0,0,0,,Жасанды интеллект өзіңіз қалағандай әрекет етсін.
Dialogue: 0,0:19:05.47,0:19:06.89,Default,,0,0,0,,Шай сияқты
Dialogue: 0,0:19:13.52,0:19:15.11,Default,,0,0,0,,Көк?
Dialogue: 0,0:19:15.19,0:19:16.40,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:19:18.99,0:19:19.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:19.90,0:19:25.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:46.18,0:19:47.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:47.43,0:19:48.52,Default,,0,0,0,,Догуру!
Dialogue: 0,0:19:52.85,0:19:56.15,Default,,0,0,0,,Біздің қонақ үйдегі демалысыңыз қалай өтті?
Dialogue: 0,0:19:56.23,0:20:00.15,Default,,0,0,0,,Снунахахаба
Dialogue: 0,0:20:00.82,0:20:04.74,Default,,0,0,0,,...
Dialogue: 0,0:20:06.99,0:20:10.37,Default,,0,0,0,,Мен мұны аламын ба?
Dialogue: 0,0:20:16.34,0:20:18.50,Default,,0,0,0,,Гарю!
Dialogue: 0,0:20:23.30,0:20:24.59,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:20:25.35,0:20:26.51,Default,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:20:26.60,0:20:27.76,Default,,0,0,0,,О?
Dialogue: 0,0:20:27.85,0:20:29.85,Default,,0,0,0,,Мен әлі есепшотты төлеген жоқпын.
Dialogue: 0,0:20:29.93,0:20:31.27,Default,,0,0,0,,Nuee?
Dialogue: 0,0:20:31.35,0:20:33.65,Default,,0,0,0,,Бұрынғы тұру ақысы
Dialogue: 0,0:20:33.73,0:20:35.48,Default,,0,0,0,,Әртүрлі қызметтерді пайдаланғаны үшін төлемдер
Dialogue: 0,0:20:35.56,0:20:38.02,Default,,0,0,0,,Біріктірілген сома осында.
Dialogue: 0,0:20:40.19,0:20:42.53,Default,,0,0,0,,Noneama...
Dialogue: 0,0:20:43.49,0:20:46.49,Default,,0,0,0,,Ақшаңыз жоқ па?
Dialogue: 0,0:20:46.57,0:20:49.24,Default,,0,0,0,,Ашира...
Dialogue: 0,0:20:49.33,0:20:51.33,Default,,0,0,0,,Жарайды, егер сіз тұтынушы болмасаңыз.
Dialogue: 0,0:20:51.41,0:20:52.71,Default,,0,0,0,,Онымен айналысайық!
Dialogue: 0,0:20:52.79,0:20:54.21,Default,,0,0,0,,№
Dialogue: 0,0:20:56.75,0:20:59.42,Default,,0,0,0,,Бұл Жердің ақшасы
Dialogue: 0,0:20:59.50,0:21:01.42,Default,,0,0,0,,О...
Dialogue: 0,0:21:07.01,0:21:11.02,Default,,0,0,0,,Біздің барлық қызметкерлер сіздің қайтып келуіңізді асыға күтуде.
Dialogue: 0,0:21:11.10,0:21:12.89,Default,,0,0,0,,Иә
Dialogue: 0,0:21:15.40,0:21:18.27,Default,,0,0,0,,Ха, үйге қайтатын уақыт болды.
Dialogue: 0,0:21:18.36,0:21:19.52,Default,,0,0,0,,Иә
Dialogue: 0,0:21:19.61,0:21:23.78,Default,,0,0,0,,Бізге келгеннен кейін сіз біздің мәңгі тұтынушымызсыз.
Dialogue: 0,0:21:36.42,0:21:39.04,Default,,0,0,0,,Баршаңызға еңбектеріңіз үшін рахмет.
Dialogue: 0,0:21:39.13,0:21:43.05,Default,,0,0,0,,Келесі тұтынушыға ең жақсы қонақжайлылықты көрсетіңіз.
Dialogue: 0,0:21:43.13,0:21:45.97,Default,,0,0,0,,О
Dialogue: 0,0:21:46.05,0:21:47.05,Default,,0,0,0,,(Крекер дыбысы)
Dialogue: 0,0:21:49.14,0:21:50.68,Default,,0,0,0,,Қосымша миссия
Dialogue: 0,0:21:50.76,0:21:53.39,Default,,0,0,0,,Шетелдіктерге тұтынушыларға қызмет көрсетуге қол жеткізілді
Dialogue: 0,0:21:53.47,0:21:56.69,Default,,0,0,0,,«қайнау қазаны» жаңа мүмкіндігі қосылды
Dialogue: 0,0:21:58.15,0:21:59.86,Default,,0,0,0,,О...
Dialogue: 0,0:21:59.94,0:22:00.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:00.90,0:22:03.40,Default,,0,0,0,,Енді кеспе жеуге оңай.
Dialogue: 0,0:22:03.48,0:22:06.90,Default,,0,0,0,,Яаа! Хахаха
Dialogue: 0,0:22:09.95,0:22:14.95,Default,,0,0,0,,♪～
Dialogue: 0,0:22:54.95,0:22:59.87,Default,,0,0,0,,～♪
