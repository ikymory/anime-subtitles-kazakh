Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.38,0:00:16.09,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:00:16.18,0:00:23.10,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:00:23.18,0:00:29.19,Default,,0,0,0,,(Икуконың гуілдеуі)
Dialogue: 0,0:00:30.69,0:00:32.57,Default,,0,0,0,,Қайырлы таң анашым
Dialogue: 0,0:00:32.65,0:00:35.57,Default,,0,0,0,,Не болды? Осылай ерте оян
Dialogue: 0,0:00:35.66,0:00:39.03,Default,,0,0,0,,Әй, анашым, тағы да мысық ала аламын ба?
Dialogue: 0,0:00:39.12,0:00:42.37,Default,,0,0,0,,Жақсы! Сол жалыну үшін ерте тұрдың ба?
Dialogue: 0,0:00:42.45,0:00:43.75,Default,,0,0,0,,Эхехе...
Dialogue: 0,0:00:43.83,0:00:47.71,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен саған жақсы қарай аламын ба деп ойлаймын.
Dialogue: 0,0:00:47.79,0:00:51.09,Default,,0,0,0,,Лунаның күйеуі мен баласы.
Dialogue: 0,0:00:51.17,0:00:53.17,Default,,0,0,0,,Жақсы! (Мысық мияулайды)
Dialogue: 0,0:00:53.26,0:00:56.22,Default,,0,0,0,,Боз бала – Диана Лунаның баласы.
Dialogue: 0,0:00:56.30,0:00:59.64,Default,,0,0,0,,Ақ бала Артемида Лунаның күйеуі.
Dialogue: 0,0:00:59.72,0:01:03.14,Default,,0,0,0,,Барлық Артемидалар Р мысықтары.
Dialogue: 0,0:01:03.22,0:01:04.89,Default,,0,0,0,,Кейбір жағдайлар бар.
Dialogue: 0,0:01:04.98,0:01:06.69,Default,,0,0,0,,Мен маңызды тақырып қозғағаннан кейін айтатының осы ма?
Dialogue: 0,0:01:06.77,0:01:09.11,Default,,0,0,0,,Жақсы, анашым
Dialogue: 0,0:01:15.11,0:01:17.41,Default,,0,0,0,,Маған көп тамақ беріңізші.
Dialogue: 0,0:01:17.49,0:01:18.41,Default,,0,0,0,,А...
Dialogue: 0,0:01:18.49,0:01:20.07,Default,,0,0,0,,Ах... Юрико... Мұнда мен үшін орын жоқ па?
Dialogue: 0,0:01:23.83,0:01:24.91,Default,,0,0,0,,Ана?
Dialogue: 0,0:01:27.21,0:01:29.08,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:01:29.17,0:01:30.84,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:01:30.92,0:01:35.30,Default,,0,0,0,,Мен қоян ешқашан қайтып келмейтіндей сезінемін...
Dialogue: 0,0:01:38.43,0:01:42.39,Default,,0,0,0,,Сонымен, бұл үшеуі қазір өз планеталарында құлыптарда ма?
Dialogue: 0,0:01:42.47,0:01:47.10,Default,,0,0,0,,Көрдің бе, Хотару-чан да ұшып бара жатты.
Dialogue: 0,0:01:47.19,0:01:50.56,Default,,0,0,0,,Эй, Чибикоро, қалыпты сөйлес.
Dialogue: 0,0:01:50.65,0:01:52.57,Default,,0,0,0,,«Чибикоро» емес
Dialogue: 0,0:01:52.65,0:01:54.98,Default,,0,0,0,,«Чиби Чиби»
Dialogue: 0,0:01:55.07,0:01:56.74,Default,,0,0,0,,Олардың сарайында?
Dialogue: 0,0:01:56.82,0:01:59.74,Default,,0,0,0,,Жоқ, мен ол жерде ешқашан болған емеспін.
Dialogue: 0,0:01:59.82,0:02:04.70,Default,,0,0,0,,Әр адам әрқашан осы планетаны және мені қорғады.
Dialogue: 0,0:02:05.45,0:02:08.54,Default,,0,0,0,,Меніңше, төртеуіне бірдеңе болды.
Dialogue: 0,0:02:09.37,0:02:12.96,Default,,0,0,0,,Сыртқы күн жүйесіне жету үшін қанша уақыт қажет?
Dialogue: 0,0:02:13.75,0:02:17.05,Default,,0,0,0,,Мен төртеуіңмен тезірек кездескім келеді.
Dialogue: 0,0:02:17.13,0:02:20.01,Default,,0,0,0,,Егер бәрінің жұлдызы болса, жақын арада
Dialogue: 0,0:02:20.09,0:02:22.14,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:02:22.85,0:02:25.01,Default,,0,0,0,,Fighter Star Power!
Dialogue: 0,0:02:25.10,0:02:27.02,Default,,0,0,0,,Maker Star Power!
Dialogue: 0,0:02:27.10,0:02:29.39,Default,,0,0,0,,Емші жұлдыз күші!
Dialogue: 0,0:02:29.48,0:02:31.15,Default,,0,0,0,,Макияж!
Dialogue: 0,0:02:39.99,0:02:42.20,Default,,0,0,0,,Chibi Chibi Crystal Power!
Dialogue: 0,0:02:42.28,0:02:43.91,Default,,0,0,0,,Макияж!
Dialogue: 0,0:02:50.67,0:02:54.04,Default,,0,0,0,,Күміс айдың кристалдық күші!
Dialogue: 0,0:02:54.13,0:02:56.17,Default,,0,0,0,,Макияж!
Dialogue: 0,0:03:32.08,0:03:32.92,Default,,0,0,0,,Бұл — Они руының салты—
Dialogue: 0,0:03:35.21,0:03:36.42,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:36.50,0:03:37.42,Default,,0,0,0,,...bu
Dialogue: 0,0:03:37.50,0:03:40.13,Default,,0,0,0,,Мен сізге кедергі жасамау үшін барымды саламын.
Dialogue: 0,0:03:41.47,0:03:43.51,Default,,0,0,0,,Жарайды, сен
Dialogue: 0,0:03:44.26,0:03:47.10,Default,,0,0,0,,Ол ханшайым, сондықтан ол қорғауға лайық.
Dialogue: 0,0:03:48.18,0:03:52.23,Default,,0,0,0,,Ханшайымдар қорғалғанда күшейе түседі.
Dialogue: 0,0:03:55.61,0:03:56.69,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:03:56.77,0:03:57.61,Default,,0,0,0,,Иә
Dialogue: 0,0:04:10.87,0:04:13.92,Default,,0,0,0,,Уран! Уран!
Dialogue: 0,0:04:14.00,0:04:15.88,Default,,0,0,0,,Күзетші Уран!
Dialogue: 0,0:04:15.96,0:04:17.59,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:04:17.67,0:04:19.05,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:19.13,0:04:20.38,Default,,0,0,0,,Уран?
Dialogue: 0,0:04:22.67,0:04:25.09,Default,,0,0,0,,Нептунға барайық
Dialogue: 0,0:04:28.14,0:04:31.14,Default,,0,0,0,,Нептун! Күзетші Нептун!
Dialogue: 0,0:04:32.81,0:04:36.56,Default,,0,0,0,,Онда Уран сарайындай ешкім жоқ
Dialogue: 0,0:04:36.65,0:04:39.65,Default,,0,0,0,,Мен 4 адам болады деп ойламадым...
Dialogue: 0,0:04:45.07,0:04:47.70,Default,,0,0,0,,Плутон! Қорғаушы Плутон!
Dialogue: 0,0:04:47.78,0:04:49.08,Default,,0,0,0,,Сатурн!
Dialogue: 0,0:04:50.03,0:04:50.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:53.12,0:04:54.91,Default,,0,0,0,,Демек, ойлағанымдай…
Dialogue: 0,0:04:55.00,0:04:56.58,Default,,0,0,0,,Уф! Ах!
Dialogue: 0,0:04:56.67,0:04:58.33,Default,,0,0,0,,Тыныштық қабырғасы!
Dialogue: 0,0:05:03.21,0:05:04.05,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:06.84,0:05:08.43,Default,,0,0,0,,Тыныштық моласы...
Dialogue: 0,0:05:10.68,0:05:11.97,Default,,0,0,0,,Таң қалдырыңыз!
Dialogue: 0,0:05:15.81,0:05:18.69,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:18.77,0:05:19.61,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:22.73,0:05:24.61,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:27.28,0:05:28.20,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:29.45,0:05:32.16,Default,,0,0,0,,Плутон Сатурн
Dialogue: 0,0:05:32.24,0:05:33.54,Default,,0,0,0,,Ай!
Dialogue: 0,0:05:33.62,0:05:36.16,Default,,0,0,0,,Сейлор Мун! Тынышталыңыз
Dialogue: 0,0:05:37.37,0:05:40.59,Default,,0,0,0,,Галактика Уран мен Нептунды алады...
Dialogue: 0,0:05:40.67,0:05:42.88,Default,,0,0,0,,Плутон мен Сатурн...
Dialogue: 0,0:05:44.09,0:05:48.51,Default,,0,0,0,,Менің кристалымды алғыңыз келсе, мені көздеуіңіз керек.
Dialogue: 0,0:05:48.59,0:05:50.09,Default,,0,0,0,,Неге барлығы...
Dialogue: 0,0:05:51.10,0:05:52.60,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:05:54.77,0:05:57.52,Default,,0,0,0,,Мені Стрелец нөл жұлдызына апарыңыз
Dialogue: 0,0:05:57.60,0:06:01.27,Default,,0,0,0,,Сейлор Мун Стрелец нөл жұлдызы туралы...
Dialogue: 0,0:06:02.23,0:06:04.32,Default,,0,0,0,,Галаксия маған айтты
Dialogue: 0,0:06:05.53,0:06:10.07,Default,,0,0,0,,Мен қазір барамын, Галаксия, саған.
Dialogue: 0,0:06:12.20,0:06:15.41,Default,,0,0,0,,Берілме! Ертең матрос Але
Dialogue: 0,0:06:15.50,0:06:18.83,Default,,0,0,0,,Мүлдем! Ұстаңыз! теңізші жұлдыз
Dialogue: 0,0:06:18.92,0:06:25.92,Default,,0,0,0,,Галактикаға жақын
Dialogue: 0,0:06:30.13,0:06:35.81,Default,,0,0,0,,Сіз жоғалып кеткен сәттен бастап
Dialogue: 0,0:06:35.89,0:06:42.44,Default,,0,0,0,,Үздіксіз іздеу саяхаты басталды
Dialogue: 0,0:06:43.86,0:06:49.32,Default,,0,0,0,,Сарғайған картада періштенің трафареттік суреті.
Dialogue: 0,0:06:49.40,0:06:56.04,Default,,0,0,0,,Алдағы қараңғы Колизейді көрсетіңіз.
Dialogue: 0,0:06:56.12,0:07:02.71,Default,,0,0,0,,Дірілдеген төсімде, Сол күнгі сырлы сүйіспеншілік
Dialogue: 0,0:07:02.79,0:07:08.88,Default,,0,0,0,,Тағдыр қанша азапты болса да
Dialogue: 0,0:07:08.97,0:07:13.01,Default,,0,0,0,,Мен сені қуып жетемін
Dialogue: 0,0:07:13.09,0:07:16.35,Default,,0,0,0,,Сен өкінбейсің Сейлор Эйс
Dialogue: 0,0:07:16.43,0:07:19.64,Default,,0,0,0,,Сайлор Винд сізге еріңіз
Dialogue: 0,0:07:19.73,0:07:26.40,Default,,0,0,0,,Бұл ән жұлдызды жол көрсетуші
Dialogue: 0,0:07:26.48,0:07:29.61,Default,,0,0,0,,Берілме! Ертең матрос Але
Dialogue: 0,0:07:29.69,0:07:33.20,Default,,0,0,0,,Мүлдем! Мен оны табамын! теңізші жұлдыз
Dialogue: 0,0:07:33.28,0:07:40.29,Default,,0,0,0,,Періште қанаттарымен ұшу
Dialogue: 0,0:07:53.13,0:07:55.97,Default,,0,0,0,,Жұлдыздар ерекше шоғырланған жер
Dialogue: 0,0:07:56.05,0:07:59.27,Default,,0,0,0,,Галактиканың орталығы Стрелец А жұлдыз
Dialogue: 0,0:07:59.35,0:08:02.14,Default,,0,0,0,,Ортасы - Стрелец нөл жұлдызы
Dialogue: 0,0:08:02.23,0:08:04.40,Default,,0,0,0,,Жұлдыздар қай жерде туады
Dialogue: 0,0:08:04.48,0:08:06.81,Default,,0,0,0,,Жұлдыздар қай жерде туады?
Dialogue: 0,0:08:06.90,0:08:09.19,Default,,0,0,0,,Галактикадағы барлық жұлдыз тұқымдары
Dialogue: 0,0:08:09.32,0:08:11.74,Default,,0,0,0,,Сол Стрелец нөл жұлдызынан туған.
Dialogue: 0,0:08:12.74,0:08:16.20,Default,,0,0,0,,Жұлдыздар... жұлдызды тұқымдар туатын жер
Dialogue: 0,0:08:17.41,0:08:20.83,Default,,0,0,0,,Жер мен біз сол жерден келдік пе?
Dialogue: 0,0:08:20.91,0:08:24.08,Default,,0,0,0,,Көлеңке Галактика сол жерде.
Dialogue: 0,0:08:24.17,0:08:25.29,Default,,0,0,0,,Галактика
Dialogue: 0,0:08:25.37,0:08:29.21,Default,,0,0,0,,Галактиканың көтерілу және құлдырау жүйесін бақылау ниетімен...
Dialogue: 0,0:08:29.30,0:08:30.63,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:08:32.38,0:08:34.88,Default,,0,0,0,,Енді нөл жұлдызға дейін ұшайық.
Dialogue: 0,0:08:35.55,0:08:38.89,Default,,0,0,0,,Сіз қауіпсіз жерге қонатыныңызға кепілдік жоқ.
Dialogue: 0,0:08:38.97,0:08:41.89,Default,,0,0,0,,Мен дайынмын, ханшайым.
Dialogue: 0,0:08:41.97,0:08:47.27,Default,,0,0,0,,Неге десеңіз, бұл белгісіз аумақ, оның үстіне жау аумағының ортасында.
Dialogue: 0,0:08:47.36,0:08:49.44,Default,,0,0,0,,Біз әрқашан...
Dialogue: 0,0:08:49.52,0:08:51.65,Default,,0,0,0,,Сізге ән айтыңыз
Dialogue: 0,0:08:51.73,0:08:54.86,Default,,0,0,0,,Өмірімді саған арнаймын
Dialogue: 0,0:09:00.41,0:09:01.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:02.45,0:09:07.04,Default,,0,0,0,,Үлкен жарық жақындап қалды, қорқынышты
Dialogue: 0,0:09:07.12,0:09:11.21,Default,,0,0,0,,Жарайды, мен сені қорғаймын.
Dialogue: 0,0:09:15.01,0:09:15.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:19.39,0:09:21.14,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:09:21.22,0:09:22.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:22.35,0:09:23.77,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:23.85,0:09:24.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:26.89,0:09:28.98,Default,,0,0,0,,Нөлдік жұлдызға есік?
Dialogue: 0,0:09:32.36,0:09:33.28,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:09:33.36,0:09:34.44,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:09:34.53,0:09:36.65,Default,,0,0,0,,Тамағым құрғап кетті.
Dialogue: 0,0:09:43.08,0:09:46.79,Default,,0,0,0,,Мен Летемін, осы шөлді өзеннің өткелі.
Dialogue: 0,0:09:47.54,0:09:50.17,Default,,0,0,0,,Мініңдер, басқа ұлттар.
Dialogue: 0,0:09:55.92,0:09:56.76,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:57.84,0:09:58.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:58.76,0:10:00.18,Default,,0,0,0,,Шөл суға айналады
Dialogue: 0,0:10:02.05,0:10:02.89,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:10:07.56,0:10:11.48,Default,,0,0,0,,Ханшайым! Чиби Чиби! Жұлдыздар жарығы!
Dialogue: 0,0:10:12.36,0:10:13.23,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:15.74,0:10:20.53,Default,,0,0,0,,Мен мұны білмей тұрып, мен мұнда келдім ...
Dialogue: 0,0:10:25.16,0:10:26.91,Default,,0,0,0,,Бұл сіздің мысық па?
Dialogue: 0,0:10:27.00,0:10:28.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:28.16,0:10:29.50,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:10:29.58,0:10:31.79,Default,,0,0,0,,Менің мысық?
Dialogue: 0,0:10:31.88,0:10:32.92,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:10:33.00,0:10:37.13,Default,,0,0,0,,Мысықты ұстасаң, ол өлгенде өзіңді жалғыз сезінесің.
Dialogue: 0,0:10:37.21,0:10:40.93,Default,,0,0,0,,Жалғыз болған әлдеқайда жақсы, сен солай ойлайсың ба?
Dialogue: 0,0:10:41.01,0:10:43.30,Default,,0,0,0,,Жалғыз болған жақсы...
Dialogue: 0,0:10:44.60,0:10:48.39,Default,,0,0,0,,Жоқ, мен жалғызбын.
Dialogue: 0,0:10:48.48,0:10:52.81,Default,,0,0,0,,Сондықтан мен өзімді көп достар тапқандай сезінемін.
Dialogue: 0,0:10:52.90,0:10:55.32,Default,,0,0,0,,Жалғызсың, солай ма?
Dialogue: 0,0:10:56.11,0:10:58.57,Default,,0,0,0,,Сонымен сенің қандай достарың бар?
Dialogue: 0,0:10:59.40,0:11:00.91,Default,,0,0,0,,Не?
Dialogue: 0,0:11:00.99,0:11:03.78,Default,,0,0,0,,Менің досым...
Dialogue: 0,0:11:03.87,0:11:05.58,Default,,0,0,0,,Достар...
Dialogue: 0,0:11:05.66,0:11:07.66,Default,,0,0,0,,Мен жақсы есімде жоқ.
Dialogue: 0,0:11:09.87,0:11:12.29,Default,,0,0,0,,Сіздің сүйіктіңіз бар ма?
Dialogue: 0,0:11:13.71,0:11:15.54,Default,,0,0,0,,Сіз менің сүйіктімсіз бе?
Dialogue: 0,0:11:16.42,0:11:18.80,Default,,0,0,0,,Бұл сақина кімдікі?
Dialogue: 0,0:11:20.13,0:11:22.39,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:11:23.01,0:11:25.35,Default,,0,0,0,,Мен ештеңе есімде жоқ
Dialogue: 0,0:11:26.14,0:11:28.97,Default,,0,0,0,,Адамның жадының үлкен құндылығы жоқ.
Dialogue: 0,0:11:29.64,0:11:32.52,Default,,0,0,0,,Бұл дене жай ғана ыдыс
Dialogue: 0,0:11:32.60,0:11:35.56,Default,,0,0,0,,Қуат қана құндылыққа ие!
Dialogue: 0,0:11:37.19,0:11:38.82,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:42.20,0:11:44.20,Default,,0,0,0,,Анашым! Әке!
Dialogue: 0,0:11:45.20,0:11:46.53,Default,,0,0,0,,Кішкентай ханым
Dialogue: 0,0:11:46.62,0:11:48.37,Default,,0,0,0,,Диана жоқ
Dialogue: 0,0:11:48.45,0:11:49.87,Default,,0,0,0,,Диана қайда...
Dialogue: 0,0:11:49.95,0:11:50.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:50.87,0:11:54.67,Default,,0,0,0,,Луна! Артемида! Менің денем...
Dialogue: 0,0:11:54.75,0:11:59.34,Default,,0,0,0,,Жоқ... Диана жоғалып кетті ме?
Dialogue: 0,0:11:59.42,0:12:01.01,Default,,0,0,0,,Кішкентай ханым
Dialogue: 0,0:12:01.09,0:12:04.39,Default,,0,0,0,,Бізде Диана өткенге ұшып кетті.
Dialogue: 0,0:12:04.47,0:12:05.85,Default,,0,0,0,,Өткенге?
Dialogue: 0,0:12:06.76,0:12:09.60,Default,,0,0,0,,Мені өткенге тағы бір рет қайтаруыңызды өтінемін!
Dialogue: 0,0:12:10.31,0:12:12.06,Default,,0,0,0,,Сейлор Мунға барыңыз
Dialogue: 0,0:12:12.14,0:12:15.52,Default,,0,0,0,,Мен бастапқы тыныштықты қалпына келтіруге көмектескім келеді.
Dialogue: 0,0:12:16.23,0:12:19.98,Default,,0,0,0,,Дианаға бірдеңе болды.
Dialogue: 0,0:12:20.07,0:12:22.65,Default,,0,0,0,,Мен оны білемін, сеземін
Dialogue: 0,0:12:22.74,0:12:27.66,Default,,0,0,0,,Не болып жатыр? Айтыңызшы, анашым!
Dialogue: 0,0:12:32.04,0:12:33.25,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:12:34.00,0:12:36.67,Default,,0,0,0,,Барлығының кристалдары жарқырайды...
Dialogue: 0,0:12:36.75,0:12:39.34,Default,,0,0,0,,Әке! Плутон!
Dialogue: 0,0:12:39.42,0:12:41.63,Default,,0,0,0,,Дене жоғалып барады
Dialogue: 0,0:12:41.71,0:12:45.09,Default,,0,0,0,,Мен бұрын бірдеңе өзгерді деп ойламадым...
Dialogue: 0,0:12:45.18,0:12:47.14,Default,,0,0,0,,Әр адамның өткендегі өмірі?
Dialogue: 0,0:12:47.22,0:12:49.64,Default,,0,0,0,,Мен өткенге барамын
Dialogue: 0,0:12:49.72,0:12:53.14,Default,,0,0,0,,Ана осы 30 ғасырды қорғауы керек сияқты.
Dialogue: 0,0:12:53.23,0:12:54.52,Default,,0,0,0,,Маған
Dialogue: 0,0:12:54.60,0:12:58.65,Default,,0,0,0,,Менің Сейлор Мунға көмектесу миссиясы бар.
Dialogue: 0,0:12:58.73,0:13:01.73,Default,,0,0,0,,Менің денем «Мен баруым керек» деп айқайлайды
Dialogue: 0,0:13:01.82,0:13:03.07,Default,,0,0,0,,Барлығы қоңырау шалып жатыр
Dialogue: 0,0:13:04.24,0:13:06.91,Default,,0,0,0,,Қызғылт айдың кристалдық күші!
Dialogue: 0,0:13:06.99,0:13:08.91,Default,,0,0,0,,Макияж!
Dialogue: 0,0:13:37.27,0:13:39.48,Default,,0,0,0,,Мәңгілік теңізші Чиби Мун
Dialogue: 0,0:13:39.56,0:13:41.19,Default,,0,0,0,,Мен қазір осындамын!
Dialogue: 0,0:13:48.57,0:13:49.70,Default,,0,0,0,,Балалар!
Dialogue: 0,0:13:49.78,0:13:52.24,Default,,0,0,0,,Теңізші Церес
Dialogue: 0,0:13:52.33,0:13:53.95,Default,,0,0,0,,Теңізші Паллас
Dialogue: 0,0:13:54.04,0:13:56.46,Default,,0,0,0,,Теңізші Джуно
Dialogue: 0,0:13:56.54,0:13:58.21,Default,,0,0,0,,Теңізші Веста
Dialogue: 0,0:13:58.29,0:14:01.84,Default,,0,0,0,,Теңізшілер квартеті осында!
Dialogue: 0,0:14:01.92,0:14:04.00,Default,,0,0,0,,Мен келе жатырмын, мама.
Dialogue: 0,0:14:04.09,0:14:06.17,Default,,0,0,0,,30 ғасырды қорғаңыз.
Dialogue: 0,0:14:07.76,0:14:11.68,Default,,0,0,0,,Уақыт пен кеңістіктен асып, галактиканың екінші жағына өту
Dialogue: 0,0:14:12.60,0:14:13.89,Default,,0,0,0,,Галактикадан тыс?
Dialogue: 0,0:14:13.97,0:14:17.10,Default,,0,0,0,,Өзіңіз барып көріңіз
Dialogue: 0,0:14:17.18,0:14:20.35,Default,,0,0,0,,Галактикадан тыс жерде не болып жатыр?
Dialogue: 0,0:14:20.44,0:14:21.27,Default,,0,0,0,,Иә
Dialogue: 0,0:14:32.07,0:14:36.62,Default,,0,0,0,,Адамды қалай оңай өлтіруге болады?
Dialogue: 0,0:14:36.70,0:14:40.62,Default,,0,0,0,,Біз бәріміз өмір сүру үшін туылғанбыз.
Dialogue: 0,0:14:40.71,0:14:45.34,Default,,0,0,0,,Барлық тіршілік иелері өлу үшін туылады.
Dialogue: 0,0:14:46.05,0:14:50.34,Default,,0,0,0,,Galactica Mysotis Alpestinis!
Dialogue: 0,0:14:52.18,0:14:54.05,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:14:57.43,0:15:01.19,Default,,0,0,0,,Сен мені неге өлтірмексің?
Dialogue: 0,0:15:01.27,0:15:06.82,Default,,0,0,0,,Сен мұнда бәрінен де, атыңды да, өміріңді де жоғалту үшін келдің.
Dialogue: 0,0:15:06.90,0:15:09.07,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:15:09.15,0:15:13.62,Default,,0,0,0,,Менің жоғалтқым келмейтін асыл достарым көп болды.
Dialogue: 0,0:15:13.70,0:15:19.96,Default,,0,0,0,,Менің атым мен өмірім досыма арналды...
Dialogue: 0,0:15:20.62,0:15:21.46,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:21.54,0:15:26.00,Default,,0,0,0,,Мен мұнда жеңілу үшін емес, достарымды қайтару үшін келдім.
Dialogue: 0,0:15:27.09,0:15:32.01,Default,,0,0,0,,Осы ұмыту өзенінің түбінде мені ешкім жеңе алмайды.
Dialogue: 0,0:15:32.09,0:15:34.30,Default,,0,0,0,,Қош бол теңізші...
Dialogue: 0,0:15:34.39,0:15:35.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:36.56,0:15:37.77,Default,,0,0,0,,Тоқта, рұқсат!
Dialogue: 0,0:15:37.85,0:15:38.85,Default,,0,0,0,,Мнемосина!
Dialogue: 0,0:15:38.93,0:15:41.89,Default,,0,0,0,,Сейлор Мун қатты ауырып қалды.
Dialogue: 0,0:15:41.98,0:15:45.31,Default,,0,0,0,,Соңғы шешімді Галаксияға қалдырыңыз!
Dialogue: 0,0:15:46.77,0:15:48.28,Default,,0,0,0,,Сейлор Мун?
Dialogue: 0,0:15:48.94,0:15:50.44,Default,,0,0,0,,Аты...
Dialogue: 0,0:15:51.86,0:15:53.20,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:58.91,0:16:01.12,Default,,0,0,0,,Мен Сейлор Мунмын
Dialogue: 0,0:16:01.21,0:16:04.08,Default,,0,0,0,,Мен мұның бәрін қайтару үшін осы уақытқа дейін келдім.
Dialogue: 0,0:16:08.50,0:16:09.38,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:16:10.42,0:16:12.09,Default,,0,0,0,,Чиби Чиби!
Dialogue: 0,0:16:14.97,0:16:17.47,Default,,0,0,0,,Сіз естеліктеріңізді қалпына келтіруге қалай батылсыз!
Dialogue: 0,0:16:17.55,0:16:18.39,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:16:18.47,0:16:20.60,Default,,0,0,0,,Тоқтатыңызшы!
Dialogue: 0,0:16:26.61,0:16:28.27,Default,,0,0,0,,Маған опасыздық жасайсың ба? Мнемосин
Dialogue: 0,0:16:28.98,0:16:29.90,Default,,0,0,0,,Мен
Dialogue: 0,0:16:29.98,0:16:33.53,Default,,0,0,0,,Мен жай ғана сен сияқты басқа матрос Сеншіні ренжіткеніңді қаламаймын.
Dialogue: 0,0:16:39.33,0:16:42.00,Default,,0,0,0,,Менің естелік өзеннің суы
Dialogue: 0,0:16:44.04,0:16:45.21,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:16:45.29,0:16:47.08,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:16:47.17,0:16:50.67,Default,,0,0,0,,Сейлор Мун... бәрі қауіпсіз...
Dialogue: 0,0:16:54.17,0:16:56.80,Default,,0,0,0,,Мен мұнда бір-бірімізді өлтіру үшін келген жоқпын.
Dialogue: 0,0:16:56.89,0:17:00.35,Default,,0,0,0,,Мен досым Сейлор Кристалды алуға келдім.
Dialogue: 0,0:17:00.43,0:17:02.35,Default,,0,0,0,,Барлығының кристалдары қайда?
Dialogue: 0,0:17:03.48,0:17:04.48,Default,,0,0,0,,Мұнда емес
Dialogue: 0,0:17:05.60,0:17:07.73,Default,,0,0,0,,Бұл империя, көлеңкелі Галактика.
Dialogue: 0,0:17:07.81,0:17:11.82,Default,,0,0,0,,«Шөл өзені» қос қорғалған кең сыртқы ор.
Dialogue: 0,0:17:11.90,0:17:17.28,Default,,0,0,0,,Мен ұмытылу өзенінің сақтаушысымын, Лете жұлдызды матрос Летемін
Dialogue: 0,0:17:17.36,0:17:19.91,Default,,0,0,0,,Мен жад өзенінің сақтаушысымын
Dialogue: 0,0:17:19.99,0:17:22.83,Default,,0,0,0,,Star Mnemosyne теңізшісі
Dialogue: 0,0:17:22.91,0:17:25.62,Default,,0,0,0,,Мен сені бұл жерден ары қарай жібермеймін.
Dialogue: 0,0:17:26.25,0:17:27.71,Default,,0,0,0,,Тірі емес
Dialogue: 0,0:17:27.79,0:17:29.29,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:29.38,0:17:32.21,Default,,0,0,0,,Көргің келмесе, көзіңді жұм Мнемосин
Dialogue: 0,0:17:32.30,0:17:33.13,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:17:33.84,0:17:36.72,Default,,0,0,0,,Екі адамға тыныштық пен бақытқа жету
Dialogue: 0,0:17:36.80,0:17:39.89,Default,,0,0,0,,Мен Галаксияға еремін деп ант бердім.
Dialogue: 0,0:17:41.05,0:17:43.89,Default,,0,0,0,,Біздің планета кішкентай және кедей
Dialogue: 0,0:17:44.93,0:17:48.48,Default,,0,0,0,,Әрқашан ұрыс-керіс, хаос болды.
Dialogue: 0,0:17:51.82,0:17:55.61,Default,,0,0,0,,Жарайды, мен сені қорғаймын.
Dialogue: 0,0:17:58.61,0:18:02.24,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:18:02.33,0:18:03.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:06.54,0:18:07.37,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:08.37,0:18:10.13,Default,,0,0,0,,Галактика пайда болады
Dialogue: 0,0:18:10.21,0:18:14.59,Default,,0,0,0,,Біздің планетамызға өлім мен тыныштық келгенде де
Dialogue: 0,0:18:16.72,0:18:19.84,Default,,0,0,0,,Бізде ілесуден басқа амал қалмады.
Dialogue: 0,0:18:22.85,0:18:28.14,Default,,0,0,0,,Алайда, егер біз бұл шайқастан аман қалсақ және Галактика галактиканы біріктіретін болса,
Dialogue: 0,0:18:28.23,0:18:30.81,Default,,0,0,0,,Екеуміздің жаңа болашағымыз анық...
Dialogue: 0,0:18:30.90,0:18:34.27,Default,,0,0,0,,Бұл жолы тыныштық пен бақыт келеді.
Dialogue: 0,0:18:34.36,0:18:38.28,Default,,0,0,0,,Жойылған жауынгердің астында бейбітшілік пен бақыт болуы мүмкін емес.
Dialogue: 0,0:18:38.36,0:18:40.74,Default,,0,0,0,,Балалар мұны да білетін шығарсыңдар.
Dialogue: 0,0:18:40.82,0:18:43.99,Default,,0,0,0,,Галаксия қанша адамды өлтірді?
Dialogue: 0,0:18:44.08,0:18:47.45,Default,,0,0,0,,Бұдан былай оның астында тек жойылу мен қырғын болады.
Dialogue: 0,0:18:47.54,0:18:48.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:48.62,0:18:50.50,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,0:18:50.58,0:18:54.04,Default,,0,0,0,,Сіз үшін бейбіт және бақытты болашақ бар ма?
Dialogue: 0,0:18:54.13,0:18:56.55,Default,,0,0,0,,Соғыссыз болашақ бар ма?
Dialogue: 0,0:18:58.38,0:19:01.76,Default,,0,0,0,,Сейлор Мун, сізде бар күш шайқасқа шақырады.
Dialogue: 0,0:19:01.84,0:19:05.06,Default,,0,0,0,,Сіз бар болғанша, шайқас ешқашан аяқталмайды
Dialogue: 0,0:19:05.14,0:19:08.06,Default,,0,0,0,,Біз үшін «жаусың»!
Dialogue: 0,0:19:09.39,0:19:12.52,Default,,0,0,0,,Кім жеңсе де, болашақтың да солай болатынына сенімдімін
Dialogue: 0,0:19:12.60,0:19:15.36,Default,,0,0,0,,Мен бұл шайқасты аяқтаймын
Dialogue: 0,0:19:15.44,0:19:18.94,Default,,0,0,0,,Бізге тек екеумізге ғана тыныштық пен бақыт керек.
Dialogue: 0,0:19:19.03,0:19:19.99,Default,,0,0,0,,Міне
Dialogue: 0,0:19:23.62,0:19:26.62,Default,,0,0,0,,Бұл шайқастың соңы болса
Dialogue: 0,0:19:27.87,0:19:29.25,Default,,0,0,0,,Мені өлтір
Dialogue: 0,0:19:31.58,0:19:34.96,Default,,0,0,0,,Мен де соғысты аяқтауға келдім.
Dialogue: 0,0:19:35.71,0:19:39.09,Default,,0,0,0,,Иә, ұрысты тоқтату үшін күресіңіз
Dialogue: 0,0:19:39.17,0:19:43.09,Default,,0,0,0,,Бұл Теңізші Сенши мен Теңізші Мидың миссиясы.
Dialogue: 0,0:19:43.18,0:19:45.43,Default,,0,0,0,,Менің тілегім әрқашан бір
Dialogue: 0,0:19:45.51,0:19:47.97,Default,,0,0,0,,Бізді қандай болашақ күтіп тұрса да
Dialogue: 0,0:19:53.48,0:19:55.31,Default,,0,0,0,,Барыңыз.
Dialogue: 0,0:19:55.40,0:19:56.94,Default,,0,0,0,,Мнемосина!
Dialogue: 0,0:19:57.02,0:19:58.78,Default,,0,0,0,,Біз оны жеңбесек те
Dialogue: 0,0:19:58.86,0:20:01.74,Default,,0,0,0,,Осы жерде өлесің бе, жоқ па.
Dialogue: 0,0:20:01.82,0:20:03.78,Default,,0,0,0,,Шайқас ешқашан аяқталмайды
Dialogue: 0,0:20:03.86,0:20:05.28,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:20:06.62,0:20:08.79,Default,,0,0,0,,Пайдасыз бейбақтар
Dialogue: 0,0:20:11.71,0:20:14.08,Default,,0,0,0,,Ха! (айқай)
Dialogue: 0,0:20:14.17,0:20:15.75,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:20:15.83,0:20:17.50,Default,,0,0,0,,Мнемосина!
Dialogue: 0,0:20:20.80,0:20:22.72,Default,,0,0,0,,Келіңіздер! Мнемосин!
Dialogue: 0,0:20:24.18,0:20:25.01,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:27.10,0:20:31.89,Default,,0,0,0,,Жұлдыздық күрделі ұстара!
Dialogue: 0,0:20:34.65,0:20:39.40,Default,,0,0,0,,Жұлдызды жұмсақ жатыр!
Dialogue: 0,0:20:39.48,0:20:44.40,Default,,0,0,0,,Жұлдызды сезімтал тозақ!
Dialogue: 0,0:20:46.95,0:20:49.58,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:20:53.75,0:20:54.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:56.58,0:20:59.71,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:21:00.63,0:21:03.55,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:21:03.63,0:21:06.39,Default,,0,0,0,,Емші! Жасаушы! Боксшы!
Dialogue: 0,0:21:06.47,0:21:07.64,Default,,0,0,0,,Отты шар ханшайымы!
Dialogue: 0,0:21:07.72,0:21:08.89,Default,,0,0,0,,Жібер!
Dialogue: 0,0:21:08.97,0:21:11.68,Default,,0,0,0,,Жұлдызды шамдар... біз көмектесуіміз керек!
Dialogue: 0,0:21:11.77,0:21:12.85,Default,,0,0,0,,Үш адам!
Dialogue: 0,0:21:12.93,0:21:14.06,Default,,0,0,0,,Ах... Уф...
Dialogue: 0,0:21:18.02,0:21:19.73,Default,,0,0,0,,Біз әрқашан...
Dialogue: 0,0:21:19.82,0:21:21.86,Default,,0,0,0,,Сізге ән айтыңыз
Dialogue: 0,0:21:21.94,0:21:25.28,Default,,0,0,0,,Өмірімді саған арнаймын
Dialogue: 0,0:21:25.36,0:21:29.12,Default,,0,0,0,,Бұл біз матрос жұлдыздармыз
Dialogue: 0,0:21:29.99,0:21:33.79,Default,,0,0,0,,Емші! Жасаушы! Боксшы!
Dialogue: 0,0:21:34.66,0:21:37.04,Default,,0,0,0,,Ай!
Dialogue: 0,0:21:41.13,0:21:42.75,Default,,0,0,0,,Үш кристал!
Dialogue: 0,0:21:45.47,0:21:46.76,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:21:48.39,0:21:51.76,Default,,0,0,0,,Сейлор Мунның денесі ғана өлді
Dialogue: 0,0:21:51.85,0:21:54.47,Default,,0,0,0,,Тек дене...?
Dialogue: 0,0:21:55.73,0:21:59.81,Default,,0,0,0,,Сейлор Сенши туралы бәрі Сейлор Кристалында.
Dialogue: 0,0:21:59.90,0:22:03.36,Default,,0,0,0,,Белгісіз хрусталь теңізші кристалы ешқашан жоғалып кетпейді!
Dialogue: 0,0:22:03.98,0:22:06.07,Default,,0,0,0,,Иә, ол жоғалып кетпейді.
Dialogue: 0,0:22:07.78,0:22:10.74,Default,,0,0,0,,Отты шар ханшайымы кеттік
Dialogue: 0,0:22:10.82,0:22:13.45,Default,,0,0,0,,Теңізші кристалын қайтарыңыз.
Dialogue: 0,0:22:13.54,0:22:17.96,Default,,0,0,0,,Біз кристалды қайтарып алғанша, үшеуміз міндетті түрде қайта қалпына келе аламыз.
Dialogue: 0,0:22:19.92,0:22:21.46,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,0:22:29.59,0:22:31.72,Default,,0,0,0,,Бұл жарық ше? қамал!
Dialogue: 0,0:22:32.35,0:22:34.18,Default,,0,0,0,,Галактика сол жерде
Dialogue: 0,0:22:34.89,0:22:36.56,Default,,0,0,0,,- (Чиби Чиби Мун және т.б.) Ах... - (Отты шар) Иллюзия?
Dialogue: 0,0:22:36.64,0:22:38.14,Default,,0,0,0,,Галактика да
Dialogue: 0,0:22:38.23,0:22:42.02,Default,,0,0,0,,Ол бізбен күресуді асыға күтсе керек.
Dialogue: 0,0:22:42.11,0:22:43.57,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:22:44.65,0:22:45.69,Default,,0,0,0,,Фу…
Dialogue: 0,0:22:45.78,0:22:48.65,Default,,0,0,0,,Сейлор Мун осында
Dialogue: 0,0:22:48.74,0:22:51.07,Default,,0,0,0,,Сіз Галактика сарайына келдіңіз бе?
Dialogue: 0,0:22:51.16,0:22:55.74,Default,,0,0,0,,Құрметті Галактика, Лете мен Мнемосинаның сәтсіздігі...
Dialogue: 0,0:22:55.83,0:22:57.33,Default,,0,0,0,,Мені кешіріңіз.
Dialogue: 0,0:22:57.41,0:22:59.87,Default,,0,0,0,,Екі кристалды осында әкеліңіз
Dialogue: 0,0:22:59.96,0:23:03.25,Default,,0,0,0,,Sailor Starlights кристалдары да осында.
Dialogue: 0,0:23:08.67,0:23:10.88,Default,,0,0,0,,Қанша көрсем де әдемі
Dialogue: 0,0:23:10.97,0:23:13.85,Default,,0,0,0,,Теңізші Кристалдың бүкіл галактикадағы жарқырауы
Dialogue: 0,0:23:13.93,0:23:15.81,Default,,0,0,0,,Теңізші жауынгерлер сияқты
Dialogue: 0,0:23:15.89,0:23:19.18,Default,,0,0,0,,Мен осы бақ кристалының ішінде дем алып жатқан сияқтымын.
Dialogue: 0,0:23:19.85,0:23:23.81,Default,,0,0,0,,Бастапқыда денесі мен санасы жойылған кристалдар.
Dialogue: 0,0:23:23.90,0:23:26.19,Default,,0,0,0,,Қуаты өте аз заттар
Dialogue: 0,0:23:26.27,0:23:29.11,Default,,0,0,0,,Осылайша сіз үлкен күш көрсете аласыз.
Dialogue: 0,0:23:29.19,0:23:31.15,Default,,0,0,0,,Галактика патшайымы
Dialogue: 0,0:23:31.24,0:23:34.37,Default,,0,0,0,,Азап кристалының арқасында.
Dialogue: 0,0:23:35.08,0:23:37.58,Default,,0,0,0,,Жақында галактикадағы ең үлкен теңізші кристалы осында болады.
Dialogue: 0,0:23:37.66,0:23:38.75,Default,,0,0,0,,Қол жетімді
Dialogue: 0,0:23:39.54,0:23:44.21,Default,,0,0,0,,Менде галактикадағы ең жойқын күш Сапфер кристалы бар.
Dialogue: 0,0:23:44.29,0:23:48.80,Default,,0,0,0,,Сейлор Мунның шексіз қалпына келтіру күші бар⸺
Dialogue: 0,0:23:48.88,0:23:51.59,Default,,0,0,0,,Күміс ай кристалдары жиналған кезде
Dialogue: 0,0:23:52.30,0:23:54.09,Default,,0,0,0,,Мен жеңілмейтінмін
Dialogue: 0,0:23:54.89,0:24:00.10,Default,,0,0,0,,Барлық галактикалар... Жоқ, егер сізде бүкіл ғалам болса да, бәрі бірдей.
Dialogue: 0,0:24:00.18,0:24:01.60,Default,,0,0,0,,Келесі кезеңде
Dialogue: 0,0:24:01.69,0:24:04.90,Default,,0,0,0,,Қалғандарының кристалдары міндетті түрде біздің қолымызда болады.
Dialogue: 0,0:24:05.06,0:24:06.40,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:24:09.36,0:24:10.86,Default,,0,0,0,,Менің жүрегім шулы
Dialogue: 0,0:24:11.61,0:24:13.36,Default,,0,0,0,,Уақыт келді.
Dialogue: 0,0:24:14.45,0:24:15.74,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,0:24:16.45,0:24:18.95,Default,,0,0,0,,Ақыры мен сені кездестіре аламын.
Dialogue: 0,0:24:23.25,0:24:25.67,Default,,0,0,0,,Тағдыр басталған жерде
Dialogue: 0,0:24:25.75,0:24:30.09,Default,,0,0,0,,Жаңа галактика тарихын бастайтын уақыт келді.
Dialogue: 0,0:24:34.89,0:24:35.76,Default,,0,0,0,,Лорд Хаос
Dialogue: 0,0:24:35.84,0:24:38.76,Default,,0,0,0,,Көптен күткен сәт те келіп жетті.
Dialogue: 0,0:24:39.85,0:24:43.64,Default,,0,0,0,,Әй, уақыт келді!
Dialogue: 0,0:24:43.73,0:24:46.90,Default,,0,0,0,,Жаңа галактиканың басталатын уақыты келді
Dialogue: 0,0:24:46.98,0:24:48.06,Default,,0,0,0,,Фу…
Dialogue: 0,0:24:54.53,0:24:55.70,Default,,0,0,0,,-(Сейлор Мун) Уф... -(Чиби Чиби Мун) Уф...
Dialogue: 0,0:25:09.09,0:25:10.59,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:25:18.18,0:25:21.06,Default,,0,0,0,,Өлі жұлдыздардың фрагменттері осында келеді⸺
Dialogue: 0,0:25:21.14,0:25:23.06,Default,,0,0,0,,Соңғы орын
Dialogue: 0,0:25:23.14,0:25:27.10,Default,,0,0,0,,Бұл көбелектер жұлдыздардың соңғы шоғы
Dialogue: 0,0:25:27.19,0:25:32.15,Default,,0,0,0,,Галактикаға шашырап жатқан көбелектердің жерлеу шеруі ешқашан бітпейді.
Dialogue: 0,0:25:34.61,0:25:35.82,Default,,0,0,0,,Бұл қабір...
Dialogue: 0,0:25:35.90,0:25:38.41,Default,,0,0,0,,Жұлдыздардың қабірі?
Dialogue: 0,0:25:38.49,0:25:39.49,Default,,0,0,0,,Бұл...
Dialogue: 0,0:25:40.24,0:25:41.83,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:25:41.91,0:25:46.83,Default,,0,0,0,,Бұл өлкеде өмір отын сөндіретін жаңа адамдар пайда болған сияқты.
Dialogue: 0,0:25:46.92,0:25:50.67,Default,,0,0,0,,Қызық, бұл жолы көбелектің түсі қандай болады? Хехе...
Dialogue: 0,0:25:56.76,0:25:59.01,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:25:59.09,0:26:04.02,Default,,0,0,0,,Бейшара, келесі жаназа шеруі өздеріңдікіндей болады!
Dialogue: 0,0:26:04.10,0:26:04.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:05.02,0:26:08.52,Default,,0,0,0,,Мен матрос Анимамат соңғы жауынгермін
Dialogue: 0,0:26:08.60,0:26:10.90,Default,,0,0,0,,Sailor Heavy Metal Papillon
Dialogue: 0,0:26:10.98,0:26:15.49,Default,,0,0,0,,Мен саған ең әдемі және қайғылы жерлеуді беремін.
Dialogue: 0,0:26:16.24,0:26:19.74,Default,,0,0,0,,Бақытсыз Мәсіхтің тағдыры өртеніп кетуге шешім қабылдады.
Dialogue: 0,0:26:19.82,0:26:21.95,Default,,0,0,0,,It's okay to suffer
Dialogue: 0,0:26:24.33,0:26:25.58,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:26:30.58,0:26:31.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:33.55,0:26:34.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:35.59,0:26:40.68,Default,,0,0,0,,Pink Ladies Freezing Kiss!
Dialogue: 0,0:26:42.43,0:26:43.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:44.56,0:26:50.69,Default,,0,0,0,,Amazon Jungle Arrow!
Dialogue: 0,0:26:50.77,0:26:52.02,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:26:54.27,0:26:56.19,Default,,0,0,0,,Sailor Ceres
Dialogue: 0,0:26:56.28,0:26:57.94,Default,,0,0,0,,Sailor Pallas
Dialogue: 0,0:26:58.03,0:26:59.61,Default,,0,0,0,,Sailor Juno
Dialogue: 0,0:26:59.70,0:27:01.45,Default,,0,0,0,,Sailor Vesta
Dialogue: 0,0:27:01.53,0:27:03.33,Default,,0,0,0,,Теңізшілер квартеті!
Dialogue: 0,0:27:03.41,0:27:05.91,Default,,0,0,0,,And Sailor Chibi Moon
Dialogue: 0,0:27:05.99,0:27:07.20,Default,,0,0,0,,Міне, келдік!
Dialogue: 0,0:27:07.29,0:27:08.66,Default,,0,0,0,,Chibi Moon!
Dialogue: 0,0:27:08.75,0:27:10.79,Default,,0,0,0,,Sailor Moon!
Dialogue: 0,0:27:10.87,0:27:12.96,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым
Dialogue: 0,0:27:13.04,0:27:16.25,Default,,0,0,0,,Біз де күн жүйесінің теңізші жауынгерлеріміз.
Dialogue: 0,0:27:16.34,0:27:17.76,Default,,0,0,0,,Мен көмектесуге келдім.
Dialogue: 0,0:27:20.18,0:27:22.72,Default,,0,0,0,,Everyone fell in the 30th century.
Dialogue: 0,0:27:22.80,0:27:24.18,Default,,0,0,0,,А...
Dialogue: 0,0:27:25.01,0:27:26.56,Default,,0,0,0,,Sailor Crystal
Dialogue: 0,0:27:26.64,0:27:28.43,Default,,0,0,0,,Shining like a signal
Dialogue: 0,0:27:29.18,0:27:31.81,Default,,0,0,0,,Everyone's bodies are about to disappear
Dialogue: 0,0:27:32.69,0:27:35.44,Default,,0,0,0,,Sailor Galaxia's attack
Dialogue: 0,0:27:35.52,0:27:39.53,Default,,0,0,0,,Барлығының денесі жойылып, кристалдары ұрланған.
Dialogue: 0,0:27:39.61,0:27:41.07,Default,,0,0,0,,А...
Dialogue: 0,0:27:41.15,0:27:45.62,Default,,0,0,0,,Біз ғана емес, сонымен қатар галактиканың түкпір-түкпірінен келген матрос Сенши.
Dialogue: 0,0:27:46.70,0:27:49.87,Default,,0,0,0,,30 ғасырда әр адамның өмірі ақыры...
Dialogue: 0,0:27:49.95,0:27:53.54,Default,,0,0,0,,Will the future you know really come?
Dialogue: 0,0:27:55.34,0:27:57.05,Default,,0,0,0,,Мен келемін
Dialogue: 0,0:27:57.13,0:28:00.76,Default,,0,0,0,,Міндетті түрде өз қолымызбен саламыз.
Dialogue: 0,0:28:00.84,0:28:02.80,Default,,0,0,0,,Біздің болашағымыз
Dialogue: 0,0:28:02.88,0:28:07.93,Default,,0,0,0,,Әр адамның кристалы міндетті түрде менің қолыма қайтарылады.
Dialogue: 0,0:28:08.01,0:28:12.77,Default,,0,0,0,,Біз барлығын дұрыс жолға түсіретінімізге сенімдімін.
Dialogue: 0,0:28:14.44,0:28:18.19,Default,,0,0,0,,Chibi Moon, well so far, safely.
Dialogue: 0,0:28:19.11,0:28:25.20,Default,,0,0,0,,Мен 30 ғасырдан бастап Жерге ұштым, бірақ бәрі жоқ болды.
Dialogue: 0,0:28:26.16,0:28:30.62,Default,,0,0,0,,Луна, Артемида және Диана жеңілгеннен кейін.
Dialogue: 0,0:28:31.83,0:28:33.08,Default,,0,0,0,,Luna and the others...
Dialogue: 0,0:28:33.16,0:28:34.62,Default,,0,0,0,,Sailor Moon
Dialogue: 0,0:28:34.71,0:28:38.71,Default,,0,0,0,,Жау бекінісінде екеніңді түсінген сәтім.
Dialogue: 0,0:28:38.80,0:28:43.22,Default,,0,0,0,,Жарық сәулесі бізді бағыттады.
Dialogue: 0,0:28:43.30,0:28:47.01,Default,,0,0,0,,Бізді әп-сәтте осында әкелген адам
Dialogue: 0,0:28:47.10,0:28:49.47,Default,,0,0,0,,Сіз бе? теңізші ай
Dialogue: 0,0:28:49.56,0:28:52.43,Default,,0,0,0,,Жоқ, бұл мен емес.
Dialogue: 0,0:28:52.52,0:28:56.19,Default,,0,0,0,,Біз де Файрбол ханшайымының навигациясы арқылы осында бара аламыз.
Dialogue: 0,0:28:56.27,0:28:58.57,Default,,0,0,0,,Мен де емес
Dialogue: 0,0:28:58.65,0:29:01.82,Default,,0,0,0,,Алыстағы жердің қуатын сезіну
Dialogue: 0,0:29:01.90,0:29:06.57,Default,,0,0,0,,Мені осы галактиканың центріне тартатын күш...
Dialogue: 0,0:29:07.32,0:29:10.62,Default,,0,0,0,,Then who exactly?
Dialogue: 0,0:29:12.29,0:29:14.91,Default,,0,0,0,,Сол кішкентай жауынгерлер ше?
Dialogue: 0,0:29:15.00,0:29:18.04,Default,,0,0,0,,Жақсы! Басы ұқсас біреу
Dialogue: 0,0:29:18.13,0:29:20.09,Default,,0,0,0,,Бұл бала - матрос Чиби Чиби
Dialogue: 0,0:29:20.17,0:29:21.63,Default,,0,0,0,,Теңізші Чиби Чиби?
Dialogue: 0,0:29:21.71,0:29:25.26,Default,,0,0,0,,Иә! Бұл тіпті жақсы теңізші жауынгер
Dialogue: 0,0:29:25.34,0:29:27.30,Default,,0,0,0,,Теңізші Чиби Чиби
Dialogue: 0,0:29:28.01,0:29:31.06,Default,,0,0,0,,Ойланып қарасам, одан кейін «ай» бола ма?
Dialogue: 0,0:29:31.14,0:29:32.14,Default,,0,0,0,,...ke?
Dialogue: 0,0:29:32.22,0:29:36.56,Default,,0,0,0,,Ол Чибиуса сияқты уақыт пен кеңістіктен тыс келген сияқты.
Dialogue: 0,0:29:36.64,0:29:38.40,Default,,0,0,0,,Бұл сенің әпкең емес пе?
Dialogue: 0,0:29:38.48,0:29:41.15,Default,,0,0,0,,Не? Сіз менің әпкемсіз бе?
Dialogue: 0,0:29:41.23,0:29:45.36,Default,,0,0,0,,Жақсы! ...Королеваның екінші баласы дейсіз бе?
Dialogue: 0,0:29:45.45,0:29:47.78,Default,,0,0,0,,Менен сұрасаңыз, дәл солай.
Dialogue: 0,0:29:47.86,0:29:52.74,Default,,0,0,0,,Мыңжылдық ханшайымы тек бірінші ханшайымды дүниеге әкеледі деп естідім.
Dialogue: 0,0:29:52.83,0:29:54.70,Default,,0,0,0,,Мен де соны білдім.
Dialogue: 0,0:29:54.79,0:29:56.16,Default,,0,0,0,,Мен де!
Dialogue: 0,0:29:56.25,0:29:58.79,Default,,0,0,0,,Бұл менің балам емес пе?
Dialogue: 0,0:29:58.88,0:30:00.42,Default,,0,0,0,,Ийда…
Dialogue: 0,0:30:00.50,0:30:02.75,Default,,0,0,0,,Ол Чибиусаның баласы емес пе?
Dialogue: 0,0:30:02.84,0:30:04.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:04.26,0:30:06.13,Default,,0,0,0,,Менің балам!?
Dialogue: 0,0:30:06.84,0:30:10.68,Default,,0,0,0,,Әйтеуір, мына бала ештеңе демейді.
Dialogue: 0,0:30:10.76,0:30:14.27,Default,,0,0,0,,Сіз кімсіз? Сіздің мақсатыңыз қандай?
Dialogue: 0,0:30:14.35,0:30:15.39,Default,,0,0,0,,Бірақ
Dialogue: 0,0:30:15.48,0:30:18.73,Default,,0,0,0,,Мен сенің тамаша теңізші жауынгер екеніңді білдім.
Dialogue: 0,0:30:18.81,0:30:21.77,Default,,0,0,0,,Бұл бала маған көп көмектесті.
Dialogue: 0,0:30:21.86,0:30:23.94,Default,,0,0,0,,Менің балам?
Dialogue: 0,0:30:24.69,0:30:25.53,Default,,0,0,0,,Жоқ
Dialogue: 0,0:30:26.36,0:30:27.45,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:30:27.53,0:30:28.86,Default,,0,0,0,,Кішкентай ханым?
Dialogue: 0,0:30:28.95,0:30:31.82,Default,,0,0,0,,Жоқ, түсіндім.
Dialogue: 0,0:30:31.91,0:30:36.33,Default,,0,0,0,,Бұл бала бізді галактиканың ортасына дейін тартты ма?
Dialogue: 0,0:30:37.12,0:30:38.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:38.46,0:30:40.17,Default,,0,0,0,,Дәл Сейлор Мун сияқты
Dialogue: 0,0:30:40.25,0:30:42.50,Default,,0,0,0,,Өлшеусіз күш
Dialogue: 0,0:30:42.59,0:30:44.75,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:30:45.51,0:30:46.67,Default,,0,0,0,,А, тұман...
Dialogue: 0,0:30:46.76,0:30:47.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:51.55,0:30:54.43,Default,,0,0,0,,Бұл Галаксия сарайы
Dialogue: 0,0:30:54.51,0:30:57.85,Default,,0,0,0,,Біздің жұлдызды бақшамызға қош келдіңіздер
Dialogue: 0,0:30:59.39,0:31:02.06,Default,,0,0,0,,Біз жұлдызды бағбанбыз
Dialogue: 0,0:31:02.15,0:31:03.36,Default,,0,0,0,,Теңізші Фи
Dialogue: 0,0:31:03.44,0:31:04.82,Default,,0,0,0,,Теңізші Кай
Dialogue: 0,0:31:06.23,0:31:08.19,Default,,0,0,0,,Жұлдызды жарық кристалы қайда орналасқан?
Dialogue: 0,0:31:08.28,0:31:09.95,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:31:10.03,0:31:12.12,Default,,0,0,0,,Жаңа теңізші кристалы
Dialogue: 0,0:31:12.20,0:31:14.41,Default,,0,0,0,,Сіз нөлдік жұлдызға жеттіңіз бе?
Dialogue: 0,0:31:14.49,0:31:16.66,Default,,0,0,0,,Түсінуге тұрарлық нәрсе!
Dialogue: 0,0:31:16.74,0:31:19.04,Default,,0,0,0,,Менің бақшамдағы кристалдар да
Dialogue: 0,0:31:19.12,0:31:21.67,Default,,0,0,0,,Қуанышқа шыдамайтын сияқтысың!
Dialogue: 0,0:31:21.75,0:31:25.42,Default,,0,0,0,,Онда кристал бар ма?
Dialogue: 0,0:31:25.50,0:31:28.92,Default,,0,0,0,,Сейлор Мун мен де күресемін
Dialogue: 0,0:31:29.55,0:31:31.68,Default,,0,0,0,,Мен де матрос жауынгермін
Dialogue: 0,0:31:31.76,0:31:34.39,Default,,0,0,0,,Кинмоку жұлдыздық күші!
Dialogue: 0,0:31:34.47,0:31:36.39,Default,,0,0,0,,Макияж!
Dialogue: 0,0:31:46.94,0:31:49.19,Default,,0,0,0,,Кинмоку планетасының қорғаушысы жауынгері
Dialogue: 0,0:31:49.28,0:31:53.11,Default,,0,0,0,,Теңізші Файрбол - сіздің қарсыласыңыз.
Dialogue: 0,0:31:53.74,0:31:56.58,Default,,0,0,0,,Емші жасаушы күрескер
Dialogue: 0,0:31:56.66,0:31:58.58,Default,,0,0,0,,Маған күш бер
Dialogue: 0,0:31:59.29,0:32:05.21,Default,,0,0,0,,Starlights Royal Straight Flush!
Dialogue: 0,0:32:12.09,0:32:13.18,Default,,0,0,0,,Жоғалып кетті ме?
Dialogue: 0,0:32:14.14,0:32:16.51,Default,,0,0,0,,Жұлдызды жарық кристалы қайда орналасқан?
Dialogue: 0,0:32:16.60,0:32:18.10,Default,,0,0,0,,Бар!
Dialogue: 0,0:32:18.81,0:32:23.73,Default,,0,0,0,,Галактика зауытының боранды!
Dialogue: 0,0:32:27.44,0:32:31.03,Default,,0,0,0,,Kinmoku Fusion Tempest!
Dialogue: 0,0:32:32.78,0:32:34.82,Default,,0,0,0,,Қазір! Сейлор Мун!
Dialogue: 0,0:32:34.91,0:32:39.58,Default,,0,0,0,,Жұлдызды бал айы терапиясы.
Dialogue: 0,0:32:39.66,0:32:42.58,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:32:43.58,0:32:44.42,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:32:46.50,0:32:47.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:32:48.92,0:32:50.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:51.51,0:32:52.59,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:32:54.55,0:32:56.01,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:32:56.72,0:32:58.81,Default,,0,0,0,,Отты шар ханшайымы!
Dialogue: 0,0:32:59.81,0:33:03.06,Default,,0,0,0,,Хаа... Сейлор Мун
Dialogue: 0,0:33:03.81,0:33:06.23,Default,,0,0,0,,Бұл шайқас аяқталғанда...
Dialogue: 0,0:33:06.31,0:33:09.57,Default,,0,0,0,,Жаңа әлем басталады ма?
Dialogue: 0,0:33:09.65,0:33:14.82,Default,,0,0,0,,Келесі жолы... соғыссыз дүние бола ма?
Dialogue: 0,0:33:17.70,0:33:18.83,Default,,0,0,0,,Шайқас...
Dialogue: 0,0:33:19.78,0:33:21.83,Default,,0,0,0,,Оның жоғалып кетуі міндетті емес
Dialogue: 0,0:33:21.91,0:33:25.79,Default,,0,0,0,,Тағы да бәрімен бірге...
Dialogue: 0,0:33:26.75,0:33:28.79,Default,,0,0,0,,Мен туғым келеді
Dialogue: 0,0:33:30.46,0:33:33.55,Default,,0,0,0,,Туған... Келе аласыз ба?
Dialogue: 0,0:33:33.63,0:33:35.93,Default,,0,0,0,,Әрине.
Dialogue: 0,0:33:36.01,0:33:37.09,Default,,0,0,0,,Біз
Dialogue: 0,0:33:37.18,0:33:40.47,Default,,0,0,0,,Теңізші кристалы бар жауынгер
Dialogue: 0,0:33:40.56,0:33:43.56,Default,,0,0,0,,Сіз қайта-қайта туыла аласыз
Dialogue: 0,0:33:43.64,0:33:45.52,Default,,0,0,0,,Иә.
Dialogue: 0,0:33:45.60,0:33:48.19,Default,,0,0,0,,Теңізші Кристал бұл...
Dialogue: 0,0:33:48.27,0:33:50.19,Default,,0,0,0,,Біздің...
Dialogue: 0,0:33:50.27,0:33:53.15,Default,,0,0,0,,Мұның бәрі үміт туралы.
Dialogue: 0,0:33:55.86,0:33:57.32,Default,,0,0,0,,От шары!
Dialogue: 0,0:33:57.41,0:33:58.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:33:58.99,0:33:59.82,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:33:59.91,0:34:04.50,Default,,0,0,0,,Өлсең, түкке тұрғысыз шайқас пен азап бітеді.
Dialogue: 0,0:34:04.58,0:34:08.04,Default,,0,0,0,,Біздің империяның билігі... Жоқ.
Dialogue: 0,0:34:08.12,0:34:10.42,Default,,0,0,0,,Әлемді басқару үшін
Dialogue: 0,0:34:10.50,0:34:12.25,Default,,0,0,0,,Күміс ай хрусталы
Dialogue: 0,0:34:12.34,0:34:16.30,Default,,0,0,0,,Біз оны Shadow Galactica-ға ұсынуымыз керек!
Dialogue: 0,0:34:17.34,0:34:19.89,Default,,0,0,0,,Қанша өмірімді құрбан етсем де
Dialogue: 0,0:34:19.97,0:34:21.80,Default,,0,0,0,,Шайқас ешқашан аяқталмайды
Dialogue: 0,0:34:22.64,0:34:25.98,Default,,0,0,0,,Бұл шайқаста аман қалудан басқа амалымыз жоқ
Dialogue: 0,0:34:26.06,0:34:28.10,Default,,0,0,0,,Бермеу
Dialogue: 0,0:34:28.19,0:34:31.11,Default,,0,0,0,,Осы Күміс ай кристалының күшімен И
Dialogue: 0,0:34:31.19,0:34:33.48,Default,,0,0,0,,Ұрысты аяқтаймыз!
Dialogue: 0,0:34:34.44,0:34:35.53,Default,,0,0,0,,«Үміт»
Dialogue: 0,0:34:37.20,0:34:41.32,Default,,0,0,0,,Теңізші Кристал жойылу немесе шайқас үшін емес.
Dialogue: 0,0:34:41.41,0:34:45.79,Default,,0,0,0,,Өйткені мен бұл бейбітшілік пен бақыт үшін деп есептеймін!
Dialogue: 0,0:34:47.29,0:34:49.75,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:34:55.05,0:34:56.59,Default,,0,0,0,,Ах! Сейлор Мун!
Dialogue: 0,0:35:00.13,0:35:01.18,Default,,0,0,0,,От шары!
Dialogue: 0,0:35:08.85,0:35:10.31,Default,,0,0,0,,Келесі қарсылас...
Dialogue: 0,0:35:11.06,0:35:13.65,Default,,0,0,0,,Бұл біз Сейлор Мунмыз
Dialogue: 0,0:35:13.73,0:35:14.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:15.48,0:35:17.53,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:35:21.53,0:35:22.82,Default,,0,0,0,,Венера!
Dialogue: 0,0:35:22.91,0:35:24.28,Default,,0,0,0,,Меркурий!
Dialogue: 0,0:35:24.37,0:35:25.66,Default,,0,0,0,,Марс!
Dialogue: 0,0:35:25.74,0:35:27.04,Default,,0,0,0,,Уран!
Dialogue: 0,0:35:27.12,0:35:28.54,Default,,0,0,0,,Нептун!
Dialogue: 0,0:35:28.62,0:35:29.91,Default,,0,0,0,,Юпитер!
Dialogue: 0,0:35:30.00,0:35:31.42,Default,,0,0,0,,Плутон!
Dialogue: 0,0:35:31.50,0:35:33.00,Default,,0,0,0,,Сатурн!
Dialogue: 0,0:35:33.71,0:35:35.17,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:35:48.10,0:35:49.52,Default,,0,0,0,,Мамо-чан
Dialogue: 0,0:35:54.11,0:35:56.32,Default,,0,0,0,,Мамо-чан! барлығы!
Dialogue: 0,0:35:56.40,0:35:58.48,Default,,0,0,0,,Сейлор Мун...
Dialogue: 0,0:35:58.57,0:36:00.15,Default,,0,0,0,,- (Стокседо маскасы) Мені өлтіріңіз - (Сейлор Мун) Иә?
Dialogue: 0,0:36:00.24,0:36:03.91,Default,,0,0,0,,Күміс ай кристалын алыңыз.
Dialogue: 0,0:36:05.87,0:36:06.83,Default,,0,0,0,,Қолымды жазып бергенімдегі жақсылығымды ұмытып қалдың ба…
Dialogue: 0,0:36:06.91,0:36:09.12,Default,,0,0,0,,Біз екінші тараппыз
Dialogue: 0,0:36:09.20,0:36:13.12,Default,,0,0,0,,Mercury Aqua Rhapsody!
Dialogue: 0,0:36:13.21,0:36:17.13,Default,,0,0,0,,Марс жалынының снайпері!
Dialogue: 0,0:36:18.67,0:36:19.84,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:36:21.26,0:36:22.72,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:36:26.47,0:36:28.93,Default,,0,0,0,,Барлығына манипуляция жасалып жатыр ма?
Dialogue: 0,0:36:29.02,0:36:32.77,Default,,0,0,0,,Білезік! Мен оны алып тастай алсам ғой...
Dialogue: 0,0:36:33.77,0:36:34.60,Default,,0,0,0,,Чиби Чиби?
Dialogue: 0,0:36:34.69,0:36:36.27,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:36:36.36,0:36:37.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:42.28,0:36:43.45,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:36:46.32,0:36:47.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:48.28,0:36:50.29,Default,,0,0,0,,Бұл қандай көрініс?
Dialogue: 0,0:36:50.37,0:36:52.46,Default,,0,0,0,,Барлығы осылайша ұшты ма?
Dialogue: 0,0:36:52.54,0:36:53.54,Default,,0,0,0,,Иә
Dialogue: 0,0:36:53.62,0:36:58.75,Default,,0,0,0,,Сонда менің алдымдағылардың бәрі фейк па?
Dialogue: 0,0:36:58.84,0:37:00.13,Default,,0,0,0,,Келесі мен!
Dialogue: 0,0:37:00.21,0:37:04.13,Default,,0,0,0,,Юпитер еменінің эволюциясы!
Dialogue: 0,0:37:05.01,0:37:05.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:05.93,0:37:07.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:37:07.51,0:37:10.81,Default,,0,0,0,,Сейлор Мун! Бұл жігіттер жау.
Dialogue: 0,0:37:11.43,0:37:14.02,Default,,0,0,0,,Галаксия жасаған алаяқ.
Dialogue: 0,0:37:14.10,0:37:16.23,Default,,0,0,0,,Жау!? Бұл өтірік!
Dialogue: 0,0:37:16.31,0:37:20.65,Default,,0,0,0,,Бұл құдірет тірі, бәріміз!
Dialogue: 0,0:37:20.73,0:37:25.15,Default,,0,0,0,,Иә, біз жаңадан дүниеге келдік.
Dialogue: 0,0:37:25.99,0:37:30.16,Default,,0,0,0,,Кронос тайфуны!
Dialogue: 0,0:37:33.08,0:37:34.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:34.58,0:37:35.75,Default,,0,0,0,,Сейлор Мун!
Dialogue: 0,0:37:35.83,0:37:39.25,Default,,0,0,0,,Галаксия мырза, маған күш бер.
Dialogue: 0,0:37:40.38,0:37:45.59,Default,,0,0,0,,Галактиканың ғарыштық турбуленттігі!
Dialogue: 0,0:37:47.59,0:37:48.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:48.84,0:37:50.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:37:50.35,0:37:51.51,Default,,0,0,0,,Чиби Мун!
Dialogue: 0,0:37:51.60,0:37:56.14,Default,,0,0,0,,Хаа... Сейлор Мун, бұл бәрі емес.
Dialogue: 0,0:37:57.02,0:37:58.44,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:37:58.52,0:38:03.15,Default,,0,0,0,,Барлығының денесін Галаксия мен басқалары жарып жіберді.
Dialogue: 0,0:38:06.24,0:38:11.16,Default,,0,0,0,,Өйткені бәрі сол жерде, тірі және алдарыңызда тұрады.
Dialogue: 0,0:38:11.24,0:38:14.58,Default,,0,0,0,,Бірақ бәрі емес!
Dialogue: 0,0:38:14.66,0:38:17.75,Default,,0,0,0,,Мен Галактиканың күшімен қайта тірілдім.
Dialogue: 0,0:38:17.83,0:38:20.25,Default,,0,0,0,,Бізді өлтіру үшін!
Dialogue: 0,0:38:20.33,0:38:23.50,Default,,0,0,0,,Хехе... Келесі менің кезегім.
Dialogue: 0,0:38:24.55,0:38:25.76,Default,,0,0,0,,Сатурн
Dialogue: 0,0:38:27.80,0:38:33.14,Default,,0,0,0,,Galactica Grave тосын сыйы!
Dialogue: 0,0:38:37.48,0:38:40.52,Default,,0,0,0,,Істі қиындатып жүрген балақайлар.
Dialogue: 0,0:38:40.60,0:38:43.11,Default,,0,0,0,,Келесі қарсылас – мен.
Dialogue: 0,0:38:43.82,0:38:46.78,Default,,0,0,0,,Галактика Виолон толқыны!
Dialogue: 0,0:38:55.24,0:38:56.25,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:38:56.91,0:38:59.62,Default,,0,0,0,,Бұл қуат Нептун емес
Dialogue: 0,0:39:00.62,0:39:01.88,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:39:02.71,0:39:04.84,Default,,0,0,0,,Гранат шары!
Dialogue: 0,0:39:07.47,0:39:10.01,Default,,0,0,0,,Тыныштық Glaive!
Dialogue: 0,0:39:10.80,0:39:12.85,Default,,0,0,0,,Галактика зеңбірегі!
Dialogue: 0,0:39:19.77,0:39:22.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:39:24.27,0:39:25.65,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:39:25.73,0:39:26.90,Default,,0,0,0,,Чиби Чиби!
Dialogue: 0,0:39:27.90,0:39:29.70,Default,,0,0,0,,Венера…
Dialogue: 0,0:39:30.45,0:39:33.82,Default,,0,0,0,,Махаббат және Галактика Шок!
Dialogue: 0,0:39:39.54,0:39:40.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:39:42.54,0:39:43.42,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:39:45.09,0:39:46.50,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,0:39:47.25,0:39:49.76,Default,,0,0,0,,Жоқ, бұл Мамо-чан емес.
Dialogue: 0,0:39:49.84,0:39:52.51,Default,,0,0,0,,Анау көздер, анау білезіктер...
Dialogue: 0,0:39:55.05,0:39:55.97,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:39:56.06,0:40:00.48,Default,,0,0,0,,Галактика Гейл!
Dialogue: 0,0:40:02.77,0:40:03.60,Default,,0,0,0,,Хмм!
Dialogue: 0,0:40:06.19,0:40:07.48,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:40:09.49,0:40:12.49,Default,,0,0,0,,Барлығына! Бұл өтірік
Dialogue: 0,0:40:12.57,0:40:16.49,Default,,0,0,0,,Бәріміз бір-бірімізді өлтірсек, Жерді кім қорғайды?
Dialogue: 0,0:40:16.58,0:40:21.37,Default,,0,0,0,,Бұл галактиканы кім қорғайды? Болашақта не болады?
Dialogue: 0,0:40:21.46,0:40:22.87,Default,,0,0,0,,Оян!
Dialogue: 0,0:40:22.96,0:40:26.13,Default,,0,0,0,,...әйтпесе бәріміз осында қаламыз!
Dialogue: 0,0:40:28.80,0:40:34.47,Default,,0,0,0,,Жұлдызды бал айы терапиясы.
Dialogue: 0,0:40:40.10,0:40:43.81,Default,,0,0,0,,Бұл галактикадағы ең жақсы деп саналатын кристалдың күші ме?
Dialogue: 0,0:40:43.89,0:40:46.06,Default,,0,0,0,,Самалда билегендей
Dialogue: 0,0:40:47.65,0:40:49.07,Default,,0,0,0,,Мен алмаймын.
Dialogue: 0,0:40:49.15,0:40:51.69,Default,,0,0,0,,Барлығын жеңу
Dialogue: 0,0:40:53.28,0:40:54.41,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:40:59.29,0:41:00.20,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:41:00.29,0:41:04.75,Default,,0,0,0,,Галактика планетасына шабуыл!
Dialogue: 0,0:41:07.25,0:41:08.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:08.75,0:41:12.05,Default,,0,0,0,,Мен оларды көріп тұрмын
Dialogue: 0,0:41:13.38,0:41:15.43,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:41:16.51,0:41:18.30,Default,,0,0,0,,Қанаттарыңыздан айырылдыңыздар ма?
Dialogue: 0,0:41:18.39,0:41:20.22,Default,,0,0,0,,Олай етпесең, өлтіресің.
Dialogue: 0,0:41:20.31,0:41:21.68,Default,,0,0,0,,Осы жерден аяқтаңыз
Dialogue: 0,0:41:21.77,0:41:24.06,Default,,0,0,0,,Мен Галаксияға жете алмаймын.
Dialogue: 0,0:41:24.14,0:41:27.06,Default,,0,0,0,,Нағыз жауды жеңе алмайсың
Dialogue: 0,0:41:27.15,0:41:28.94,Default,,0,0,0,,-(Чиби Чиби Мун) Амал жоқ -(Чиби Мун) Ах...
Dialogue: 0,0:41:29.57,0:41:32.32,Default,,0,0,0,,Өйткені бұл Сейлор Мунның шайқасы
Dialogue: 0,0:41:33.11,0:41:38.57,Default,,0,0,0,,Сейлор Мун шайқасында галактиканың тағдыры қыл үстінде тұр.
Dialogue: 0,0:41:38.66,0:41:42.33,Default,,0,0,0,,Сондықтан мен Сейлор Мунға сенемін
Dialogue: 0,0:41:43.16,0:41:44.12,Default,,0,0,0,,Иә.
Dialogue: 0,0:41:44.21,0:41:46.46,Default,,0,0,0,,Бұл әлі аяқталмайды.
Dialogue: 0,0:41:47.96,0:41:49.21,Default,,0,0,0,,Соқуды аяқтаңыз
Dialogue: 0,0:41:49.29,0:41:50.96,Default,,0,0,0,,- (Чиби Мун) Иә? -(Чиби Чиби Мун) Уф...
Dialogue: 0,0:41:51.05,0:41:53.59,Default,,0,0,0,,Біз бас тарта алмаймыз!
Dialogue: 0,0:42:00.35,0:42:05.68,Default,,0,0,0,,Күміс айдың кристалдық қуаты...
Dialogue: 0,0:42:07.31,0:42:10.90,Default,,0,0,0,,Therapy Kiss!
Dialogue: 0,0:42:17.20,0:42:20.95,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:42:22.54,0:42:23.37,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:42:29.46,0:42:30.29,Default,,0,0,0,,Ха…
Dialogue: 0,0:42:37.22,0:42:39.93,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:42:51.94,0:42:56.07,Default,,0,0,0,,Менің големдерім өте жақсы шықты.
Dialogue: 0,0:42:56.15,0:42:58.65,Default,,0,0,0,,Галактикадағы ең ірі жойылу жауынгері
Dialogue: 0,0:42:58.74,0:43:01.57,Default,,0,0,0,,Теңізші Галаксия сарайына қош келдіңіз
Dialogue: 0,0:43:01.66,0:43:04.03,Default,,0,0,0,,Ақыры келді
Dialogue: 0,0:43:04.12,0:43:07.83,Default,,0,0,0,,Теңізші Галаксия сізге
Dialogue: 0,0:43:07.91,0:43:10.37,Default,,0,0,0,,Мен жараланып, қанатымнан айырылсам да
Dialogue: 0,0:43:10.46,0:43:14.34,Default,,0,0,0,,Сенің маған деген өшпенділігің соншалықты әдемі және құдіретті ме?
Dialogue: 0,0:43:16.01,0:43:19.47,Default,,0,0,0,,Менің күш-қуатым өшпенділіктен емес.
Dialogue: 0,0:43:20.34,0:43:23.26,Default,,0,0,0,,Себебі мен Теңізші Сеншидің күшіне сенемін.
Dialogue: 0,0:43:24.39,0:43:28.39,Default,,0,0,0,,Өйткені маған күш беретін әрбір адамға сенемін
Dialogue: 0,0:43:29.06,0:43:33.15,Default,,0,0,0,,Өйткені мен өзімнің осы деңгейге жету қабілетіме сенемін.
Dialogue: 0,0:43:33.86,0:43:36.15,Default,,0,0,0,,Тағы да бәрімен бірге...
Dialogue: 0,0:43:36.23,0:43:38.44,Default,,0,0,0,,Мен туғым келеді
Dialogue: 0,0:43:38.53,0:43:41.53,Default,,0,0,0,,Достар әрқашан сақталады
Dialogue: 0,0:43:41.61,0:43:44.16,Default,,0,0,0,,Өйткені біз қайтадан бірге өмір сүретінімізге сенемін
Dialogue: 0,0:43:44.99,0:43:48.29,Default,,0,0,0,,Өйткені мен біз жасай алатын болашақ бар екеніне сенемін.
Dialogue: 0,0:43:48.37,0:43:50.29,Default,,0,0,0,,Сіз қазір күресе аласыз!
Dialogue: 0,0:43:51.33,0:43:53.79,Default,,0,0,0,,«Сүйікті достарыммен болашақ»?
Dialogue: 0,0:43:55.29,0:43:56.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:01.22,0:44:02.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:09.68,0:44:12.35,Default,,0,0,0,,Тоқта! Тоқта, Мамо-чан!
Dialogue: 0,0:44:12.44,0:44:13.35,Default,,0,0,0,,Фу…
Dialogue: 0,0:44:13.44,0:44:14.27,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:44:17.44,0:44:22.24,Default,,0,0,0,,Бұл адам және галактикадағы барлық күш менікі!
Dialogue: 0,0:44:22.32,0:44:25.99,Default,,0,0,0,,Қайтарып алғың келсе, менімен соғыс!
Dialogue: 0,0:44:26.08,0:44:27.91,Default,,0,0,0,,Мен күресемін!
Dialogue: 0,0:44:27.99,0:44:32.12,Default,,0,0,0,,Осы шайқаспен күресіп, аяқтаңыз!
Dialogue: 0,0:44:33.79,0:44:34.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:44:45.39,0:44:47.47,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:44:48.89,0:44:49.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:44:50.06,0:44:51.23,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:44:52.60,0:44:53.98,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:44:56.31,0:45:01.24,Default,,0,0,0,,Галактика инфляциясы!
Dialogue: 0,0:45:02.74,0:45:06.87,Default,,0,0,0,,Күміс айдың кристалдық қуаты...
Dialogue: 0,0:45:08.99,0:45:12.41,Default,,0,0,0,,Therapy Kiss!
Dialogue: 0,0:45:16.50,0:45:17.79,Default,,0,0,0,,Сейлор Мун!
Dialogue: 0,0:45:17.88,0:45:19.29,Default,,0,0,0,,Галактика!
Dialogue: 0,0:45:20.88,0:45:22.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:23.26,0:45:25.01,Default,,0,0,0,,Ха…
Dialogue: 0,0:45:25.09,0:45:29.14,Default,,0,0,0,,Чиби Чиби, сен бұл шайқас туралы білесің.
Dialogue: 0,0:45:29.22,0:45:32.31,Default,,0,0,0,,Егер сен менің әпкем немесе балам болсаң
Dialogue: 0,0:45:32.39,0:45:36.06,Default,,0,0,0,,Бұл біздің болашағымыз жарқын деген сөз!
Dialogue: 0,0:45:36.15,0:45:39.52,Default,,0,0,0,,Бұл шайқаста жеңсек, бәрі құтқарылады, солай ма?
Dialogue: 0,0:45:41.82,0:45:45.49,Default,,0,0,0,,Чиби Чиби Сіз кімсіз?
Dialogue: 0,0:45:50.53,0:45:51.54,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:45:51.62,0:45:52.70,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:45:52.79,0:45:54.66,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:45:55.62,0:45:57.29,Default,,0,0,0,,Мен қоқыс сияқты жұлдызмын
Dialogue: 0,0:45:57.37,0:45:59.67,Default,,0,0,0,,Жалғыз боп туған
Dialogue: 0,0:46:00.59,0:46:02.00,Default,,0,0,0,,Тозақ сияқты күндер...
Dialogue: 0,0:46:02.00,0:46:02.92,Default,,0,0,0,,Тозақ сияқты күндер...
Dialogue: 0,0:46:02.00,0:46:02.92,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:46:03.01,0:46:04.63,Default,,0,0,0,,Оңаша жүріп, аман қалудан басқа амалым қалмады.
Dialogue: 0,0:46:04.63,0:46:05.80,Default,,0,0,0,,Оңаша жүріп, аман қалудан басқа амалым қалмады.
Dialogue: 0,0:46:04.63,0:46:05.80,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:46:05.80,0:46:05.88,Default,,0,0,0,,Оңаша жүріп, аман қалудан басқа амалым қалмады.
Dialogue: 0,0:46:05.88,0:46:07.38,Default,,0,0,0,,Оңаша кезіп, аман қалудан басқа амалым қалмады.
Dialogue: 0,0:46:05.88,0:46:07.38,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:46:07.38,0:46:08.18,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:46:08.22,0:46:09.05,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:46:09.93,0:46:13.14,Default,,0,0,0,,Менде теңізші жауынгер ретінде күш бар.
Dialogue: 0,0:46:13.22,0:46:15.48,Default,,0,0,0,,Бір кезде кенет оянып кетті
Dialogue: 0,0:46:16.64,0:46:19.44,Default,,0,0,0,,Мен таңдалған адам болдым
Dialogue: 0,0:46:19.52,0:46:23.90,Default,,0,0,0,,Бірақ егер сіз жай ғана теңізші жауынгер болсаңыз, сіз қоқыс сияқтысыз.
Dialogue: 0,0:46:24.82,0:46:28.53,Default,,0,0,0,,Ең күшті жұлдыз болмаса
Dialogue: 0,0:46:29.49,0:46:33.91,Default,,0,0,0,,Мен өзіме сәйкес келетін өз жұлдызымды іздедім.
Dialogue: 0,0:46:34.91,0:46:39.17,Default,,0,0,0,,Ал мен керемет жұлдыз таптым
Dialogue: 0,0:46:39.83,0:46:44.42,Default,,0,0,0,,Сол жұлдызды алу үшін галактикадағы ең күшті қуат қажет.
Dialogue: 0,0:46:46.13,0:46:47.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:46:47.09,0:46:48.97,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:46:51.09,0:46:56.27,Default,,0,0,0,,Теңізші Сеншидің күші галактикадағы әділдік пен тыныштық үшін.
Dialogue: 0,0:46:56.35,0:47:00.15,Default,,0,0,0,,Ал менің жақындарым мен достарым үшін!
Dialogue: 0,0:47:00.23,0:47:05.32,Default,,0,0,0,,Махаббат? жолдасым? Көпшілікке жиналу – қоқыстың белгісі
Dialogue: 0,0:47:05.40,0:47:09.66,Default,,0,0,0,,Біз сенетін жалғыз нәрсе - өз күшіміз.
Dialogue: 0,0:47:09.74,0:47:13.16,Default,,0,0,0,,Қуат көзі: тек Сейлор Кристалл
Dialogue: 0,0:47:13.87,0:47:15.41,Default,,0,0,0,,Барлығы осы!
Dialogue: 0,0:47:16.50,0:47:18.62,Default,,0,0,0,,Тіпті қаза тапқан жауынгерлер
Dialogue: 0,0:47:18.71,0:47:22.00,Default,,0,0,0,,Егер сізде кристал болса, сіз оңай тіріле аласыз.
Dialogue: 0,0:47:22.08,0:47:23.54,Default,,0,0,0,,Және бұл да...
Dialogue: 0,0:47:24.80,0:47:28.30,Default,,0,0,0,,Бұл оңай бұзылатын нәрсе. Хехе...
Dialogue: 0,0:47:28.38,0:47:30.30,Default,,0,0,0,,Сіз де білуіңіз керек.
Dialogue: 0,0:47:30.38,0:47:34.72,Default,,0,0,0,,Сенетін нәрсе – өткінші елес
Dialogue: 0,0:47:34.81,0:47:37.52,Default,,0,0,0,,Сіз әлі де сенесіз бе?
Dialogue: 0,0:47:37.60,0:47:42.56,Default,,0,0,0,,Махаббат пен достар, Қоқыс үшін тыныштық, болашақ
Dialogue: 0,0:47:42.65,0:47:45.52,Default,,0,0,0,,Жойылған жауынгер ретінде түсінбейсің!
Dialogue: 0,0:47:46.40,0:47:50.20,Default,,0,0,0,,Достар мен жақындардың сөздері
Dialogue: 0,0:47:50.28,0:47:53.66,Default,,0,0,0,,Бұл жылу қаншалықты күшті?
Dialogue: 0,0:47:55.41,0:47:58.58,Default,,0,0,0,,Менің осы уақытқа дейін келген себебім және аман қалуымның себебі
Dialogue: 0,0:47:58.66,0:48:02.58,Default,,0,0,0,,Сіз матрос Сенши ретінде шайқаса аласыз.
Dialogue: 0,0:48:02.67,0:48:05.79,Default,,0,0,0,,Себебі менің достарым мен жақындарым бар!
Dialogue: 0,0:48:05.88,0:48:08.17,Default,,0,0,0,,Бұл Сейлор Сенши!
Dialogue: 0,0:48:10.84,0:48:12.34,Default,,0,0,0,,Хмм!
Dialogue: 0,0:48:13.51,0:48:14.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:17.18,0:48:20.14,Default,,0,0,0,,Галактикадағы ең күшті матрос кристалының иесі
Dialogue: 0,0:48:20.23,0:48:22.56,Default,,0,0,0,,Неліктен Сейлор Мун?
Dialogue: 0,0:48:22.64,0:48:25.98,Default,,0,0,0,,Бірақ не болса да, мен бұл күшті алуым керек.
Dialogue: 0,0:48:27.19,0:48:31.15,Default,,0,0,0,,Хаосты жеңу және бүкіл галактиканы иемдену
Dialogue: 0,0:48:31.90,0:48:35.45,Default,,0,0,0,,Маған бұл күш керек!
Dialogue: 0,0:48:44.46,0:48:45.79,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:48:46.59,0:48:50.76,Default,,0,0,0,,Бұл жұлдыздардың киелі орны, Галактика қазаны
Dialogue: 0,0:48:51.55,0:48:55.43,Default,,0,0,0,,Күшті жұлдыздар мен әлсіз жұлдыздар, қоқыс пен теңізші жауынгерлер
Dialogue: 0,0:48:55.51,0:48:58.64,Default,,0,0,0,,Галактикадағы барлық жұлдыздар туатын жер
Dialogue: 0,0:48:59.35,0:49:01.02,Default,,0,0,0,,Жұлдыздар қай жерде туады?
Dialogue: 0,0:49:01.77,0:49:06.77,Default,,0,0,0,,Бұл мүмкіндіктерге толы галактикадағы ең қасиетті орын.
Dialogue: 0,0:49:06.86,0:49:08.40,Default,,0,0,0,,Бұл жер
Dialogue: 0,0:49:08.52,0:49:12.57,Default,,0,0,0,,Соңғы таңдалған адамға баратын ең жақсы кезең
Dialogue: 0,0:49:12.65,0:49:16.66,Default,,0,0,0,,Бұл жерде бәрі бар және бәрі жоғалады.
Dialogue: 0,0:49:19.08,0:49:20.41,Default,,0,0,0,,Галактика Не?
Dialogue: 0,0:49:25.46,0:49:26.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:28.04,0:49:30.67,Default,,0,0,0,,Галактикадағы теңізші кристалдары
Dialogue: 0,0:49:30.75,0:49:34.97,Default,,0,0,0,,Енді ол із-түзсіз ана теңізге еріп, жоғалып кетті.
Dialogue: 0,0:49:35.05,0:49:38.60,Default,,0,0,0,,Қандай керемет, бұл мені тоңазытады
Dialogue: 0,0:49:38.68,0:49:42.72,Default,,0,0,0,,Бұл Қазан – ғаламдағы ең күшті «жұлдыз».
Dialogue: 0,0:49:43.60,0:49:46.19,Default,,0,0,0,,Барлығының теңізші кристалдары жоғалып кетті ме?
Dialogue: 0,0:49:47.15,0:49:50.19,Default,,0,0,0,,Менде кристал болғанша, мен әрқашан сенетінмін
Dialogue: 0,0:49:50.27,0:49:52.94,Default,,0,0,0,,Мен барлығын қалыпты жағдайға қайтара алатынымызға сенімдімін.
Dialogue: 0,0:49:53.03,0:49:57.78,Default,,0,0,0,,Сол соңғы үміт, әркімнің кристалы...
Dialogue: 0,0:49:57.86,0:49:59.24,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:50:00.83,0:50:01.99,Default,,0,0,0,,Мен оларды кешіре алмаймын!
Dialogue: 0,0:50:02.08,0:50:04.08,Default,,0,0,0,,Галактика! Ха!
Dialogue: 0,0:50:05.37,0:50:06.75,Default,,0,0,0,,Иә.
Dialogue: 0,0:50:06.83,0:50:11.21,Default,,0,0,0,,Ашу отын, өшпенділік дауылын көбірек көтер.
Dialogue: 0,0:50:11.29,0:50:14.34,Default,,0,0,0,,Жалғыз болыңыз Сейлор Мун
Dialogue: 0,0:50:14.42,0:50:16.43,Default,,0,0,0,,Бұл жүрек
Dialogue: 0,0:50:16.51,0:50:20.80,Default,,0,0,0,,Ішіңіздегі түпсіз күшті оятыңыз.
Dialogue: 0,0:50:22.26,0:50:24.35,Default,,0,0,0,,Ах! Мамо-чан!
Dialogue: 0,0:50:25.18,0:50:26.48,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:50:26.56,0:50:30.11,Default,,0,0,0,,Мен хаостан барлық шындықты естігенде
Dialogue: 0,0:50:30.19,0:50:34.44,Default,,0,0,0,,Сіздің күшіңіз бақылаудан шығып, хаос жойылады.
Dialogue: 0,0:50:35.32,0:50:36.74,Default,,0,0,0,,Тек содан кейін
Dialogue: 0,0:50:36.82,0:50:41.07,Default,,0,0,0,,Осы Галактика ғаламның шынайы билеушісі болған кезде
Dialogue: 0,0:50:41.16,0:50:43.29,Default,,0,0,0,,Ай!
Dialogue: 0,0:50:44.16,0:50:45.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:45.62,0:50:47.04,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,0:50:47.12,0:50:48.79,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:50:48.87,0:50:50.79,Default,,0,0,0,,Чиби Мун!
Dialogue: 0,0:50:50.88,0:50:52.54,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,0:50:58.76,0:51:04.93,Default,,0,0,0,,Ай!
Dialogue: 0,0:51:05.02,0:51:09.02,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:51:09.10,0:51:13.77,Default,,0,0,0,,Сіз де лорд Хаостың жемі бола аласыз, Сейлор Мун.
Dialogue: 0,0:51:13.86,0:51:18.15,Default,,0,0,0,,Ал мына қазанның ішінде қуат жарылады.
Dialogue: 0,0:51:18.24,0:51:20.53,Default,,0,0,0,,Бейбітшілік желге ұшсын
Dialogue: 0,0:51:21.28,0:51:26.54,Default,,0,0,0,,Galactica Super String!
Dialogue: 0,0:51:30.87,0:51:31.79,Default,,0,0,0,,Ақымақ!?
Dialogue: 0,0:51:31.88,0:51:33.17,Default,,0,0,0,,Хмм!
Dialogue: 0,0:51:33.88,0:51:37.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:37.88,0:51:38.88,Default,,0,0,0,,Лорд Хаос
Dialogue: 0,0:51:38.97,0:51:42.72,Default,,0,0,0,,Галактикадағы ең күшті жауынгер Сейлор Мунның ең үлкен күші
Dialogue: 0,0:51:42.80,0:51:44.51,Default,,0,0,0,,Енді сіз үшін!
Dialogue: 0,0:51:45.31,0:51:50.89,Default,,0,0,0,,Галактика, бүкіл ғалам біздің қолымызда болатын уақыт келді.
Dialogue: 0,0:51:53.19,0:51:54.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:56.44,0:51:57.48,Default,,0,0,0,,Хмм!
Dialogue: 0,0:52:05.49,0:52:10.79,Default,,0,0,0,,О, ақ жарқыл, Галактикадағы ең жоғары қуат
Dialogue: 0,0:52:10.87,0:52:13.67,Default,,0,0,0,,Ақырында маған келдің бе?
Dialogue: 0,0:52:14.33,0:52:18.30,Default,,0,0,0,,Мен Хаоспын, жұлдыз бола алмаған адаммын
Dialogue: 0,0:52:18.38,0:52:22.22,Default,,0,0,0,,Ал осы Қазанның қараңғы жұлдыздарының билеушісі.
Dialogue: 0,0:52:22.30,0:52:23.30,Default,,0,0,0,,Хаос?
Dialogue: 0,0:52:23.39,0:52:27.89,Default,,0,0,0,,Сұлу Қазаннан нұр құдіретін алған бала.
Dialogue: 0,0:52:27.97,0:52:30.81,Default,,0,0,0,,Бір теңізден туған бауырлар
Dialogue: 0,0:52:30.89,0:52:34.65,Default,,0,0,0,,Өз қолыңызбен зұлымдық қараңғылық жұлдыздарын жойыңыз
Dialogue: 0,0:52:34.73,0:52:38.07,Default,,0,0,0,,Оның аты бүкіл галактикаға тарады ма?
Dialogue: 0,0:52:38.15,0:52:42.07,Default,,0,0,0,,Ағайындылар? Зұлым қараңғы жұлдыздар?
Dialogue: 0,0:52:42.15,0:52:44.57,Default,,0,0,0,,Жарық күшін іздеу
Dialogue: 0,0:52:44.66,0:52:48.58,Default,,0,0,0,,Галактиканы кезіп жүрген зұлым қараңғылықтың инкарнациясы
Dialogue: 0,0:52:48.66,0:52:54.83,Default,,0,0,0,,Сіз өшірген адамдардың барлығы менің альтер эголарым.
Dialogue: 0,0:52:55.54,0:52:59.42,Default,,0,0,0,,Барлығы уақыт пен кеңістіктен тыс осы жерден кетті.
Dialogue: 0,0:52:59.50,0:53:02.42,Default,,0,0,0,,Балалар сендер ағайындысыңдар.
Dialogue: 0,0:53:02.51,0:53:05.30,Default,,0,0,0,,Осы уақытқа дейін соғысқан жауларым
Dialogue: 0,0:53:05.39,0:53:08.72,Default,,0,0,0,,Бір жерден туған ағайынды жұлдыздар?
Dialogue: 0,0:53:08.81,0:53:12.73,Default,,0,0,0,,Сенің мұнда келуің тағдырдың жазуы еді.
Dialogue: 0,0:53:12.81,0:53:16.90,Default,,0,0,0,,Қараңғылық жарықты шақырады, жарық та қараңғылықты шақырады.
Dialogue: 0,0:53:16.98,0:53:20.53,Default,,0,0,0,,Бір-бірімізге тартқан тағдырымыз.
Dialogue: 0,0:53:20.61,0:53:24.65,Default,,0,0,0,,Басында бәрі бір болғаны сияқты.
Dialogue: 0,0:53:24.74,0:53:29.99,Default,,0,0,0,,Ал енді жарық пен қараңғылықтың тағы да қол ұстасатын кезі келді.
Dialogue: 0,0:53:30.70,0:53:36.00,Default,,0,0,0,,Сейлор Мун, маған күшіңді бер!
Dialogue: 0,0:53:36.08,0:53:42.01,Default,,0,0,0,,Менің бүкіл әлемді билейтін уақыт келді.
Dialogue: 0,0:53:43.09,0:53:45.34,Default,,0,0,0,,Сен оған көп қиындық көрсеттің ғой, иә?
Dialogue: 0,0:53:46.22,0:53:48.35,Default,,0,0,0,,Маған неге көмектестің?
Dialogue: 0,0:53:48.43,0:53:49.64,Default,,0,0,0,,Галактика
Dialogue: 0,0:53:49.72,0:53:51.06,Default,,0,0,0,,Соңғы соққыны беріңіз!
Dialogue: 0,0:53:53.31,0:53:56.77,Default,,0,0,0,,Хаос мені әу бастан ойыма алған жоқ.
Dialogue: 0,0:53:57.52,0:54:01.36,Default,,0,0,0,,Өкінішке орай, мен бұл алып болмысты жеңе алмаймын.
Dialogue: 0,0:54:02.15,0:54:04.95,Default,,0,0,0,,Бұл да менің планетам емес пе еді?
Dialogue: 0,0:54:08.70,0:54:10.70,Default,,0,0,0,,Қол созылды
Dialogue: 0,0:54:10.78,0:54:14.45,Default,,0,0,0,,Себебі мен сенен жалғыз мені көрдім
Dialogue: 0,0:54:15.41,0:54:18.58,Default,,0,0,0,,Себебі мен енді достарымды жоғалтқым келмейді.
Dialogue: 0,0:54:18.67,0:54:22.34,Default,,0,0,0,,Мен жаумын! Бұл шайқас!
Dialogue: 0,0:54:22.42,0:54:25.05,Default,,0,0,0,,Мен енді төбелесе алмаймын
Dialogue: 0,0:54:29.51,0:54:32.43,Default,,0,0,0,,Барлығы жоғалып кеткен заттар
Dialogue: 0,0:54:33.18,0:54:34.89,Default,,0,0,0,,Мен әрқашан
Dialogue: 0,0:54:34.98,0:54:39.69,Default,,0,0,0,,Мен жақындарым мен достарым үшін күрестім.
Dialogue: 0,0:54:39.77,0:54:43.69,Default,,0,0,0,,Бірақ қазір бәрі жойылды.
Dialogue: 0,0:54:44.40,0:54:47.45,Default,,0,0,0,,Ең маңыздысы енді жоқ болса да
Dialogue: 0,0:54:48.53,0:54:52.20,Default,,0,0,0,,Кім және не үшін күресуім керек?
Dialogue: 0,0:54:54.49,0:54:57.21,Default,,0,0,0,,Сен де, мен де күресе алмаймыз
Dialogue: 0,0:54:57.29,0:55:00.42,Default,,0,0,0,,Әрбір теңізші жауынгер жоғалып кетеді.
Dialogue: 0,0:55:01.29,0:55:03.96,Default,,0,0,0,,Енді шайқастың аяқталатын уақыты келді ме?
Dialogue: 0,0:55:05.67,0:55:07.67,Default,,0,0,0,,Шайқас аяқталды ма?
Dialogue: 0,0:55:09.01,0:55:12.72,Default,,0,0,0,,Менің қалағаным осы еді...
Dialogue: 0,0:55:13.51,0:55:14.68,Default,,0,0,0,,Жоқ
Dialogue: 0,0:55:14.76,0:55:18.77,Default,,0,0,0,,Ұрыс бітпейді, мәңгі жалғасады.
Dialogue: 0,0:55:18.85,0:55:20.44,Default,,0,0,0,,Сонымен, қолдарыңызбен
Dialogue: 0,0:55:20.52,0:55:24.02,Default,,0,0,0,,«Бұл жолы», шайқасты қазір аяқтаңыз.
Dialogue: 0,0:55:24.11,0:55:26.40,Default,,0,0,0,,Галактиканың болашағын сақтау
Dialogue: 0,0:55:27.28,0:55:29.74,Default,,0,0,0,,Соңғы күші бар Сейлор Мун
Dialogue: 0,0:55:29.82,0:55:33.91,Default,,0,0,0,,Хаос пен Қазанды, барлық жаулардың көзін жойыңыз.
Dialogue: 0,0:55:34.03,0:55:36.16,Default,,0,0,0,,Ұрысты аяқтаңыз
Dialogue: 0,0:55:36.83,0:55:39.29,Default,,0,0,0,,Хаос? Қазан?
Dialogue: 0,0:55:39.96,0:55:41.12,Default,,0,0,0,,Чиби Чиби?
Dialogue: 0,0:55:41.79,0:55:45.80,Default,,0,0,0,,Хаос енді Каулдронмен біріктірілді.
Dialogue: 0,0:55:45.88,0:55:47.63,Default,,0,0,0,,Толық жою
Dialogue: 0,0:55:47.71,0:55:50.13,Default,,0,0,0,,Жалғыз амал – қазанды түгел өшіру.
Dialogue: 0,0:55:51.76,0:55:55.76,Default,,0,0,0,,Бірақ Қазан жоғалып кетсе ше?
Dialogue: 0,0:55:55.85,0:55:58.14,Default,,0,0,0,,Енді жұлдыздар тумайды
Dialogue: 0,0:55:59.06,0:56:02.60,Default,,0,0,0,,Бір күні галактиканың болашағы жоқ болады.
Dialogue: 0,0:56:02.69,0:56:04.69,Default,,0,0,0,,Бірақ егер олай болмаса
Dialogue: 0,0:56:04.77,0:56:08.78,Default,,0,0,0,,Бұл шайқас пен азап тарихы мәңгілікке жалғасады.
Dialogue: 0,0:56:08.86,0:56:11.15,Default,,0,0,0,,Сіз оны арқаңызда алып жүресіз.
Dialogue: 0,0:56:11.24,0:56:14.07,Default,,0,0,0,,Егер сіз мұны қазір жасамасаңыз, сіз міндетті түрде өкінесіз.
Dialogue: 0,0:56:14.16,0:56:15.83,Default,,0,0,0,,Сейлор Мун!
Dialogue: 0,0:56:18.87,0:56:21.29,Default,,0,0,0,,Жұлдыздар туа бергенше
Dialogue: 0,0:56:21.37,0:56:23.50,Default,,0,0,0,,Шайқас ешқашан аяқталмайды, солай ма?
Dialogue: 0,0:56:24.75,0:56:29.59,Default,,0,0,0,,«Қараңғылық жарықты шақырады, ал жарық қараңғылықты да шақырады».
Dialogue: 0,0:56:29.67,0:56:32.55,Default,,0,0,0,,Бұл галактиканың еркі ме?
Dialogue: 0,0:56:32.63,0:56:37.31,Default,,0,0,0,,Соғыстың аяқталуы бәрі жойылды дегенді білдіре ме?
Dialogue: 0,0:56:39.31,0:56:42.27,Default,,0,0,0,,Ал өлім орағы
Dialogue: 0,0:56:42.89,0:56:45.90,Default,,0,0,0,,Мен оны осы жолы сілкіп тастауым керек пе?
Dialogue: 0,0:56:45.98,0:56:48.36,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:56:48.44,0:56:51.24,Default,,0,0,0,,Галактикаға қалай бейбітшілік орнатуға болады
Dialogue: 0,0:56:52.61,0:56:54.99,Default,,0,0,0,,Мен мұны істеуім керек...
Dialogue: 0,0:56:59.83,0:57:03.00,Default,,0,0,0,,Бірақ бұл галактика өлсе де
Dialogue: 0,0:57:03.08,0:57:06.58,Default,,0,0,0,,Бір жерде міндетті түрде жаңа қазан туады.
Dialogue: 0,0:57:06.67,0:57:07.50,Default,,0,0,0,,- (Чиби Чиби Мун) Иә? - (Сейлор Мун) Иә?
Dialogue: 0,0:57:08.25,0:57:14.51,Default,,0,0,0,,Жаңа болашақ бір жерде басталып, жарық пен қараңғылық да туылуы мүмкін.
Dialogue: 0,0:57:14.59,0:57:18.56,Default,,0,0,0,,Ұрыстың соңы оңайлықпен келмейді.
Dialogue: 0,0:57:20.60,0:57:22.23,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:57:22.93,0:57:27.98,Default,,0,0,0,,Осы сөздер менің ішімде әлі бар екеніне сене алар емеспін.
Dialogue: 0,0:57:28.06,0:57:29.27,Default,,0,0,0,,Иә.
Dialogue: 0,0:57:30.02,0:57:34.20,Default,,0,0,0,,Жаңа болашақ туа береді.
Dialogue: 0,0:57:34.28,0:57:39.24,Default,,0,0,0,,Ал жарық пен қараңғылық, шайқас пен үміт бар.
Dialogue: 0,0:57:39.33,0:57:43.20,Default,,0,0,0,,Өмір мен өлім, қуаныш пен қайғы
Dialogue: 0,0:57:43.29,0:57:46.17,Default,,0,0,0,,Мен бәрінің қайтадан болатынына сенімдімін.
Dialogue: 0,0:57:47.00,0:57:48.13,Default,,0,0,0,,Барлығы
Dialogue: 0,0:57:48.92,0:57:50.75,Default,,0,0,0,,Міне, бұл ғалам.
Dialogue: 0,0:57:50.84,0:57:51.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:57:53.76,0:57:55.97,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,0:57:56.05,0:58:00.60,Default,,0,0,0,,Сіз бұл ғаламның алыс болашағына сенесіз бе?
Dialogue: 0,0:58:01.26,0:58:05.44,Default,,0,0,0,,Сіз бәрін құшағына алған жауынгерсіз бе?
Dialogue: 0,0:58:06.35,0:58:08.15,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:58:08.23,0:58:14.74,Default,,0,0,0,,Менің жұлдызым тым үлкен және жету үшін тым жарық.
Dialogue: 0,0:58:15.53,0:58:17.82,Default,,0,0,0,,Бірақ... (сықырлаған дыбыс)
Dialogue: 0,0:58:18.49,0:58:20.58,Default,,0,0,0,,Бірақ бұл жұлдыз
Dialogue: 0,0:58:20.66,0:58:24.79,Default,,0,0,0,,Бұл ғаламда мәңгі жарқырайды
Dialogue: 0,0:58:28.79,0:58:29.83,Default,,0,0,0,,Чиби Чиби
Dialogue: 0,0:58:31.34,0:58:33.59,Default,,0,0,0,,Мен берілмеймін
Dialogue: 0,0:58:33.67,0:58:37.84,Default,,0,0,0,,Өйткені маған әркім сабақ берді.
Dialogue: 0,0:58:38.97,0:58:43.01,Default,,0,0,0,,Шайқастың соңында үміт пен болашақ бар.
Dialogue: 0,0:58:44.02,0:58:45.77,Default,,0,0,0,,Мен оны жасаймын
Dialogue: 0,0:58:47.19,0:58:49.02,Default,,0,0,0,,Әркіммен болашақ
Dialogue: 0,0:58:50.31,0:58:54.48,Default,,0,0,0,,Сондықтан үміт пен болашағыңнан бас тартпа.
Dialogue: 0,0:58:56.07,0:58:57.78,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:58:57.86,0:59:01.70,Default,,0,0,0,,Үміт жұлдызымыз ешқашан өшпейді
Dialogue: 0,0:59:02.70,0:59:06.45,Default,,0,0,0,,Жұлдыздар жарқырап тұрғанша, біз жақсы боламыз
Dialogue: 0,0:59:07.25,0:59:08.46,Default,,0,0,0,,Себебі мен жеңілмеймін
Dialogue: 0,0:59:10.12,0:59:10.96,Default,,0,0,0,,Иә
Dialogue: 0,0:59:27.89,0:59:29.64,Default,,0,0,0,,Чиби Чиби?
Dialogue: 0,0:59:31.06,0:59:34.52,Default,,0,0,0,,Иә, мен жеңілмеймін.
Dialogue: 0,0:59:35.86,0:59:39.65,Default,,0,0,0,,Өйткені біз Теңізші Сеншиміз.
Dialogue: 0,0:59:40.61,0:59:45.29,Default,,0,0,0,,О... Сейлор Мун
Dialogue: 0,0:59:45.37,0:59:48.50,Default,,0,0,0,,Қазан ана сенің зиратың.
Dialogue: 0,0:59:48.58,0:59:54.09,Default,,0,0,0,,Енді хаос деп аталатын ғаламдағы ең қуатты жұлдыз дүниеге келді!
Dialogue: 0,0:59:58.05,0:59:59.55,Default,,0,0,0,,Хаос
Dialogue: 0,0:59:59.63,1:00:00.84,Default,,0,0,0,,Куинн Металлия
Dialogue: 0,1:00:01.68,1:00:02.97,Default,,0,0,0,,Өлім фантомы
Dialogue: 0,1:00:03.68,1:00:05.14,Default,,0,0,0,,Перғауын90
Dialogue: 0,1:00:05.81,1:00:07.35,Default,,0,0,0,,Нехеления
Dialogue: 0,1:00:07.43,1:00:10.60,Default,,0,0,0,,Және Галактика
Dialogue: 0,1:00:10.69,1:00:12.60,Default,,0,0,0,,Енді мен білемін
Dialogue: 0,1:00:12.69,1:00:17.07,Default,,0,0,0,,Неге бәрің менің күшімді іздедіңдер?
Dialogue: 0,1:00:17.94,1:00:24.57,Default,,0,0,0,,Өзім жақсы көретін, жақсы көретін адамдарға деген сезімім сол.
Dialogue: 0,1:00:25.66,1:00:29.08,Default,,0,0,0,,Біз бәріміз жалғыз планетамыз
Dialogue: 0,1:00:29.79,1:00:33.25,Default,,0,0,0,,Сондықтан біз бір-бірімізді іздейміз, өйткені біз «бір» болғымыз келеді.
Dialogue: 0,1:00:34.17,1:00:38.30,Default,,0,0,0,,«Бір» Барлығымыз осылай бастадық
Dialogue: 0,1:00:39.26,1:00:41.47,Default,,0,0,0,,Енді мен де
Dialogue: 0,1:00:42.63,1:00:45.47,Default,,0,0,0,,Мен сені іздеп орап аламын
Dialogue: 0,1:00:46.18,1:00:50.81,Default,,0,0,0,,Осы қазанда, бәрін сақтау үшін!
Dialogue: 0,1:00:50.89,1:00:52.10,Default,,0,0,0,,Уау...
Dialogue: 0,1:00:53.02,1:00:54.73,Default,,0,0,0,,Барлығын сақтаңыз
Dialogue: 0,1:00:54.81,1:00:57.94,Default,,0,0,0,,Мен мұны істей алатынымды білмеймін.
Dialogue: 0,1:00:58.02,1:00:58.86,Default,,0,0,0,,Бірақ…
Dialogue: 0,1:00:59.82,1:01:01.61,Default,,0,0,0,,Біз әрқашан бірге боламыз
Dialogue: 0,1:01:02.45,1:01:04.03,Default,,0,0,0,,Еш ойланбастан күресіңіз
Dialogue: 0,1:01:04.70,1:01:09.24,Default,,0,0,0,,Соңында әрқашан үміт пен жаңару бар.
Dialogue: 0,1:01:09.95,1:01:14.54,Default,,0,0,0,,Теңізші Кристал біздің... үмітіміз.
Dialogue: 0,1:01:15.17,1:01:16.71,Default,,0,0,0,,Үміт
Dialogue: 0,1:01:17.59,1:01:19.84,Default,,0,0,0,,Қандай жағдай болмасын мен ешқашан берілмеймін
Dialogue: 0,1:01:19.92,1:01:22.05,Default,,0,0,0,,Ешқашан үмітіңізді үзбеңіз
Dialogue: 0,1:01:22.13,1:01:24.59,Default,,0,0,0,,Теңізшілердің кристалдары
Dialogue: 0,1:01:24.68,1:01:27.30,Default,,0,0,0,,Қазанда ұйықтап жатқан теңізші жауынгерлер
Dialogue: 0,1:01:28.22,1:01:33.69,Default,,0,0,0,,Менің көптеген достарым бүкіл галактикаға тарап кетті.
Dialogue: 0,1:01:33.77,1:01:34.60,Default,,0,0,0,,Өтінемін...
Dialogue: 0,1:01:35.52,1:01:38.02,Default,,0,0,0,,Маған күш-қуатыңызды беріңізші!
Dialogue: 0,1:01:44.95,1:01:45.82,Default,,0,0,0,,Сізді кім жалдады және қандай шарттармен?
Dialogue: 0,1:01:46.70,1:01:50.70,Default,,0,0,0,,Сейлор Мун біздің күшімізді қалайды!
Dialogue: 0,1:01:53.00,1:01:57.13,Default,,0,0,0,,Күміс ай хрусталы...
Dialogue: 0,1:01:57.21,1:02:00.17,Default,,0,0,0,,Мәңгілік күш!
Dialogue: 0,1:02:00.25,1:02:04.47,Default,,0,0,0,,Уф... Мені жұлып алмақшысың ба?
Dialogue: 0,1:02:04.55,1:02:05.38,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:02:06.63,1:02:10.18,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:02:18.90,1:02:19.94,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:21.23,1:02:23.90,Default,,0,0,0,,Әр адамның күшін сезіну
Dialogue: 0,1:02:24.74,1:02:25.99,Default,,0,0,0,,Каранэс ауданына оралу.
Dialogue: 0,1:02:32.87,1:02:34.50,Default,,0,0,0,,Сейлор Мун!
Dialogue: 0,1:02:35.25,1:02:39.67,Default,,0,0,0,,Керемет. Жер бетінде бұл жарық тасқыны несі?
Dialogue: 0,1:02:41.38,1:02:45.26,Default,,0,0,0,,Галаксия ұрлап, Қазанға шашыранды⸺
Dialogue: 0,1:02:45.34,1:02:49.64,Default,,0,0,0,,Теңізші Сеншидің кристалдары бастапқы пішініне оралды.
Dialogue: 0,1:02:50.51,1:02:53.26,Default,,0,0,0,,Біз планетамызға қайтамыз.
Dialogue: 0,1:02:58.02,1:02:59.31,Default,,0,0,0,,Чиби Чиби?
Dialogue: 0,1:03:00.15,1:03:01.27,Default,,0,0,0,,Бәрібір
Dialogue: 0,1:03:01.36,1:03:03.90,Default,,0,0,0,,Жаңа туған жұлдызды тұқым
Dialogue: 0,1:03:04.86,1:03:07.65,Default,,0,0,0,,Әр жұлдызға жеткенше
Dialogue: 0,1:03:07.74,1:03:10.99,Default,,0,0,0,,Ол өзінің бастапқы түріне қайта оралуы мүмкін.
Dialogue: 0,1:03:11.74,1:03:13.91,Default,,0,0,0,,Сейлор Мунда бар⸺
Dialogue: 0,1:03:13.99,1:03:16.08,Default,,0,0,0,,Күміс ай кристалының күшімен?
Dialogue: 0,1:03:16.79,1:03:17.91,Default,,0,0,0,,Жоқ
Dialogue: 0,1:03:18.00,1:03:19.54,Default,,0,0,0,,Бұл қалпына келтіру күші
Dialogue: 0,1:03:19.62,1:03:22.88,Default,,0,0,0,,Өйткені бүкіл галактикадағы теңізші кристалдары біртұтас болды.
Dialogue: 0,1:03:22.96,1:03:24.63,Default,,0,0,0,,Іске асырылған билік
Dialogue: 0,1:03:25.25,1:03:29.34,Default,,0,0,0,,Бұл Космос Кристаллының соңғы ламбда қуаты.
Dialogue: 0,1:03:29.43,1:03:31.30,Default,,0,0,0,,Космос кристалы?
Dialogue: 0,1:03:31.39,1:03:32.85,Default,,0,0,0,,Ламбда қуаты?
Dialogue: 0,1:03:32.93,1:03:34.60,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:03:34.68,1:03:36.81,Default,,0,0,0,,Мен Теңізші Космоспын
Dialogue: 0,1:03:36.89,1:03:37.73,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:03:38.64,1:03:43.73,Default,,0,0,0,,Сіз болашақ Сейлор Мунның соңғы формасысыз ба?
Dialogue: 0,1:03:54.66,1:03:58.75,Default,,0,0,0,,Теңізші Космос Біздің ханшайым кім?
Dialogue: 0,1:03:58.83,1:04:00.04,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,1:04:00.71,1:04:02.50,Default,,0,0,0,,Сенің ханшайымың да
Dialogue: 0,1:04:02.58,1:04:06.00,Default,,0,0,0,,Басқа жауынгерлер сияқты қайта туылды
Dialogue: 0,1:04:06.84,1:04:09.22,Default,,0,0,0,,Бір күні мен сол жарық ағынына мінемін
Dialogue: 0,1:04:09.30,1:04:12.51,Default,,0,0,0,,Сіз оны 30 ғасырға аман-есен ораласыз.
Dialogue: 0,1:04:13.30,1:04:18.72,Default,,0,0,0,,Бұл жерде жұлдыздар туып, қайтып оралады.
Dialogue: 0,1:04:18.81,1:04:23.27,Default,,0,0,0,,Барлық жаулардың көзі болып табылатын хаосты өзіне қосуға тырысу.
Dialogue: 0,1:04:23.35,1:04:25.40,Default,,0,0,0,,Сейлор Мун хаоспен бірге
Dialogue: 0,1:04:25.48,1:04:28.44,Default,,0,0,0,,Мен Қазанның алғашқы теңізіне ерідім.
Dialogue: 0,1:04:29.53,1:04:33.91,Default,,0,0,0,,Оның күшімен, Қазан және галактика
Dialogue: 0,1:04:34.53,1:04:37.29,Default,,0,0,0,,Мен бұрынғы келбетімді қалпына келтіре алдым.
Dialogue: 0,1:04:38.91,1:04:43.50,Default,,0,0,0,,Бірақ мен әлі де хаосты толығымен жоя алмадым.
Dialogue: 0,1:04:44.29,1:04:46.96,Default,,0,0,0,,Мен алыс болашақтанмын
Dialogue: 0,1:04:47.04,1:04:51.55,Default,,0,0,0,,Мен бәрін лақтырып, қашқан қорқақпын.
Dialogue: 0,1:04:53.43,1:04:56.93,Default,,0,0,0,,Болашақта қайталап сою
Dialogue: 0,1:04:57.01,1:05:00.56,Default,,0,0,0,,Теңізші Хаоспен ұзақ және азапты шайқас
Dialogue: 0,1:05:00.64,1:05:02.60,Default,,0,0,0,,Теңізші хаос?
Dialogue: 0,1:05:02.69,1:05:05.61,Default,,0,0,0,,Болашақта хаос қайта орала ма?
Dialogue: 0,1:05:06.40,1:05:09.94,Default,,0,0,0,,Теңізші хаос күшті және оны жеңу қиын.
Dialogue: 0,1:05:11.15,1:05:14.61,Default,,0,0,0,,Ұрыс ұзаққа созылды... және ұзаққа созылды.
Dialogue: 0,1:05:15.70,1:05:19.62,Default,,0,0,0,,Мен шеккен шығын мен төлеген құным тым үлкен болды.
Dialogue: 0,1:05:20.49,1:05:22.04,Default,,0,0,0,,Мен енді түсінбеймін
Dialogue: 0,1:05:22.79,1:05:25.04,Default,,0,0,0,,Біз не үшін күресеміз?
Dialogue: 0,1:05:25.67,1:05:27.42,Default,,0,0,0,,Қандай дұрыс?
Dialogue: 0,1:05:29.00,1:05:30.46,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:05:33.26,1:05:37.22,Default,,0,0,0,,Адасқан сайын, қиналған сайын есіме түседі
Dialogue: 0,1:05:37.30,1:05:39.14,Default,,0,0,0,,«Осында» шайқас
Dialogue: 0,1:05:40.01,1:05:42.98,Default,,0,0,0,,Егер Қазан осында жоғалып кетсе
Dialogue: 0,1:05:43.06,1:05:47.98,Default,,0,0,0,,Шайқас... азап... өтті ме?
Dialogue: 0,1:05:49.02,1:05:52.53,Default,,0,0,0,,Талай рет өкінгендіктен осында келдім.
Dialogue: 0,1:05:53.24,1:05:55.20,Default,,0,0,0,,Уақыт пен кеңістіктен алыс
Dialogue: 0,1:05:55.86,1:05:59.78,Default,,0,0,0,,Күш-қуатым азайып, есте сақтау қабілетім әлсіреп жатса да
Dialogue: 0,1:05:59.87,1:06:02.16,Default,,0,0,0,,Әйтеуір жетіп қалдым.
Dialogue: 0,1:06:03.75,1:06:06.04,Default,,0,0,0,,Осы жолы әрекетті қайталау үшін
Dialogue: 0,1:06:06.12,1:06:11.30,Default,,0,0,0,,Қарт мені дұрыс жолды таңдау ниетімен
Dialogue: 0,1:06:12.00,1:06:14.05,Default,,0,0,0,,Бірақ мен түсінемін.
Dialogue: 0,1:06:14.92,1:06:17.26,Default,,0,0,0,,Мен таңдаған жол қате болмады.
Dialogue: 0,1:06:18.51,1:06:23.14,Default,,0,0,0,,Жұлдыз туған жерді ешкім өшіре алмайды.
Dialogue: 0,1:06:23.22,1:06:26.81,Default,,0,0,0,,Біз осында болғандықтан, өмір сүруді жалғастыра аламыз.
Dialogue: 0,1:06:28.35,1:06:29.56,Default,,0,0,0,,Қалағаныңызша⸺
Dialogue: 0,1:06:30.77,1:06:32.23,Default,,0,0,0,,Қайтадан бастай аламын ба?
Dialogue: 0,1:06:33.78,1:06:35.82,Default,,0,0,0,,Мен енді қашпаймын
Dialogue: 0,1:06:35.90,1:06:38.16,Default,,0,0,0,,Мен алға жылжи аламын.
Dialogue: 0,1:06:38.24,1:06:41.74,Default,,0,0,0,,Өйткені Сейлор Мун маған үлкен күш берді
Dialogue: 0,1:06:42.70,1:06:48.25,Default,,0,0,0,,Бәрінен бас тартатын батылдық күші және бәрін қабылдай алатын батылдық күші
Dialogue: 0,1:06:49.42,1:06:53.25,Default,,0,0,0,,Ұмытылып бара жатқан жеңілмейтін күш
Dialogue: 0,1:06:55.30,1:06:58.93,Default,,0,0,0,,Енді галактиканы құтқарған Сейлор Мун.
Dialogue: 0,1:06:59.01,1:07:01.64,Default,,0,0,0,,Нағыз Теңізші Космостың көрінісі
Dialogue: 0,1:07:02.39,1:07:03.60,Default,,0,0,0,,Оған ұнайды⸺
Dialogue: 0,1:07:03.68,1:07:08.85,Default,,0,0,0,,Бәрін лақтырып тастауға және бәрін қабылдауға батылдық жетсе
Dialogue: 0,1:07:08.94,1:07:10.40,Default,,0,0,0,,Тек содан кейін
Dialogue: 0,1:07:10.48,1:07:13.40,Default,,0,0,0,,Мен нағыз Теңізші Космос бола алатын кезде
Dialogue: 0,1:07:14.78,1:07:17.86,Default,,0,0,0,,Келіңдер, балалар да.
Dialogue: 0,1:07:18.57,1:07:20.28,Default,,0,0,0,,Қорғайтын адамға
Dialogue: 0,1:07:20.36,1:07:21.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:40.34,1:07:41.89,Default,,0,0,0,,жылы
Dialogue: 0,1:07:42.80,1:07:45.35,Default,,0,0,0,,Сағыныштың иісі бар.
Dialogue: 0,1:07:46.52,1:07:47.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:49.31,1:07:50.77,Default,,0,0,0,,20-шы эпизод: Бастықтың соңғы бұйрығы
Dialogue: 0,1:07:54.48,1:07:55.78,Default,,0,0,0,,Are you alive?
Dialogue: 0,1:07:57.94,1:07:59.82,Default,,0,0,0,,Хаосты жұтуға тырысу
Dialogue: 0,1:08:00.74,1:08:04.91,Default,,0,0,0,,Соңғы сәтте ол қабылданбады
Dialogue: 0,1:08:05.66,1:08:07.04,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:08:07.70,1:08:10.75,Default,,0,0,0,,Барлығы жоғалып кетті ме?
Dialogue: 0,1:08:12.67,1:08:13.50,Default,,0,0,0,,Қоян
Dialogue: 0,1:08:13.58,1:08:14.42,Default,,0,0,0,,Ха!
Dialogue: 0,1:08:24.47,1:08:25.43,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:08:26.31,1:08:28.10,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:08:28.18,1:08:29.93,Default,,0,0,0,,- (Минако және т.б.) Қоян! -Ха...
Dialogue: 0,1:08:30.02,1:08:30.94,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:08:31.02,1:08:32.31,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:08:38.78,1:08:41.20,Default,,0,0,0,,Қоянның құдіретіне рахмет
Dialogue: 0,1:08:42.24,1:08:43.53,Default,,0,0,0,,Қоян
Dialogue: 0,1:08:44.37,1:08:47.62,Default,,0,0,0,,Мені жайына қалдыр... Мен сені қорғай алмағаным үшін кешір.
Dialogue: 0,1:08:47.70,1:08:50.58,Default,,0,0,0,,Рей-чан МинаП
Dialogue: 0,1:08:50.66,1:08:52.62,Default,,0,0,0,,Мәселе онда емес еді.
Dialogue: 0,1:08:52.71,1:08:54.50,Default,,0,0,0,,Жақсы
Dialogue: 0,1:08:54.58,1:08:57.92,Default,,0,0,0,,Харука-сан Мичиру-сан
Dialogue: 0,1:08:58.00,1:09:01.42,Default,,0,0,0,,Бізге қоңырау шалуды жалғастыру үшін
Dialogue: 0,1:09:01.51,1:09:04.39,Default,,0,0,0,,Қуатыңызды...
Dialogue: 0,1:09:04.47,1:09:07.39,Default,,0,0,0,,Рахмет Усаги
Dialogue: 0,1:09:07.47,1:09:08.64,Default,,0,0,0,,Рахмет
Dialogue: 0,1:09:08.72,1:09:14.27,Default,,0,0,0,,Сецуна-сан Хотару-чан Мако-чан Ами-чан
Dialogue: 0,1:09:14.35,1:09:15.65,Default,,0,0,0,,-Қоян! -Ха...
Dialogue: 0,1:09:19.23,1:09:20.53,Default,,0,0,0,,Чибиуса!
Dialogue: 0,1:09:22.36,1:09:24.53,Default,,0,0,0,,Мен 30 ғасырда күтемін.
Dialogue: 0,1:09:24.61,1:09:25.99,Default,,0,0,0,,Чибиуса!
Dialogue: 0,1:09:37.04,1:09:41.34,Default,,0,0,0,,Осылай міндетті түрде кездесетінімізге сендім
Dialogue: 0,1:09:42.34,1:09:46.18,Default,,0,0,0,,Біз тағы да бір болдық.
Dialogue: 0,1:09:47.89,1:09:51.72,Default,,0,0,0,,Бір болыңыз, өз ойыңызбен бөлісіңіз
Dialogue: 0,1:09:51.81,1:09:55.02,Default,,0,0,0,,Осылай біз тағы да кездестік.
Dialogue: 0,1:09:57.23,1:09:59.65,Default,,0,0,0,,Қандай күшті жылтыр!
Dialogue: 0,1:10:00.36,1:10:04.61,Default,,0,0,0,,Қазан ішіндегі жұлдыздың сыртқы түрін сақтауға бола ма?
Dialogue: 0,1:10:05.36,1:10:08.12,Default,,0,0,0,,Бұл Қазанның ішінде ме?
Dialogue: 0,1:10:09.74,1:10:10.87,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:10:11.62,1:10:12.87,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,1:10:13.54,1:10:16.29,Default,,0,0,0,,Мен Ғарыш қорғаушысымын
Dialogue: 0,1:10:16.37,1:10:18.88,Default,,0,0,0,,Ғарыш тұқымының қамқоршысы рухы
Dialogue: 0,1:10:19.71,1:10:22.76,Default,,0,0,0,,Мен де сендер сияқты баяғыда келдім⸺
Dialogue: 0,1:10:22.84,1:10:25.01,Default,,0,0,0,,Жарқыраған жұлдыз болды
Dialogue: 0,1:10:25.09,1:10:29.43,Default,,0,0,0,,Кішкентай жұлдыздың қабығын кеудеде ұстау
Dialogue: 0,1:10:30.43,1:10:34.85,Default,,0,0,0,,Ол жұлдыздың жарықтығы сізбен бірдей болды.
Dialogue: 0,1:10:34.93,1:10:36.44,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,1:10:38.27,1:10:42.15,Default,,0,0,0,,Сонымен сен маған келдің...
Dialogue: 0,1:10:42.78,1:10:47.82,Default,,0,0,0,,Өміріңді осы Қазан басталған теңізге таста.
Dialogue: 0,1:10:47.91,1:10:51.16,Default,,0,0,0,,Сіз жаңа жұлдыз тарихын бастағыңыз келеді дейсіз бе?
Dialogue: 0,1:10:51.95,1:10:55.50,Default,,0,0,0,,Немесе жұлдыз ретінде
Dialogue: 0,1:10:55.58,1:10:59.17,Default,,0,0,0,,Әрқайсымызды осы жерден тастап кеткіңіз келе ме?
Dialogue: 0,1:11:02.67,1:11:07.34,Default,,0,0,0,,Біз осылай мәңгі бірге өмір сүргіміз келеді.
Dialogue: 0,1:11:07.42,1:11:10.68,Default,,0,0,0,,Мен барлығымен бірге болашақты құруды жалғастырғым келеді.
Dialogue: 0,1:11:10.76,1:11:15.43,Default,,0,0,0,,Қанша қиын болса да, мына өмірді сүргім келеді!
Dialogue: 0,1:11:15.52,1:11:16.43,Default,,0,0,0,,Иә
Dialogue: 0,1:11:19.52,1:11:22.19,Default,,0,0,0,,Ах! Ғарыш қорғаушысы!
Dialogue: 0,1:11:22.27,1:11:23.44,Default,,0,0,0,,Хаос ше?
Dialogue: 0,1:11:28.15,1:11:31.99,Default,,0,0,0,,Хаостың өзегі де Қазан теңізіне ериді.
Dialogue: 0,1:11:32.07,1:11:35.04,Default,,0,0,0,,Қазір оның кішкентай болғаны сонша, мен оны таба алмаймын.
Dialogue: 0,1:11:36.04,1:11:39.71,Default,,0,0,0,,Мүмкін мен қайта туармын
Dialogue: 0,1:11:40.46,1:11:42.21,Default,,0,0,0,,Мұнда жұлдыздар бар
Dialogue: 0,1:11:42.29,1:11:43.29,Default,,0,0,0,,Және…
Dialogue: 0,1:11:44.80,1:11:47.34,Default,,0,0,0,,Өйткені мұнда мүмкіндіктер туады.
Dialogue: 0,1:12:19.04,1:12:23.38,Default,,0,0,0,,Әр адамның жүрегінде жұлдыз бар
Dialogue: 0,1:12:43.35,1:12:44.19,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:44.27,1:12:46.15,Default,,0,0,0,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,1:12:46.23,1:12:51.24,Default,,0,0,0,,Не істеп жатырсың, ақымақ қоян? Сіз өзіңізді қайтадан құлыптадыңыз ба?
Dialogue: 0,1:12:51.32,1:12:53.41,Default,,0,0,0,,Маған сәл жақсырақ апа керек.
Dialogue: 0,1:12:53.49,1:12:54.74,Default,,0,0,0,,Мысалы, осы жағдайда—
Dialogue: 0,1:12:54.82,1:12:57.28,Default,,0,0,0,,Хмм!
Dialogue: 0,1:12:57.37,1:12:58.49,Default,,0,0,0,,Шинго
Dialogue: 0,1:12:58.58,1:13:01.71,Default,,0,0,0,,Гах... Бұл не? Бұл жиіркенішті.
Dialogue: 0,1:13:01.79,1:13:04.04,Default,,0,0,0,,Хехе-хе
Dialogue: 0,1:13:04.12,1:13:04.96,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:13:05.04,1:13:06.38,Default,,0,0,0,,Шинго
Dialogue: 0,1:13:06.46,1:13:08.67,Default,,0,0,0,,Қоян, сен не істеп жатырсың?
Dialogue: 0,1:13:08.75,1:13:11.47,Default,,0,0,0,,Екеуміз тамақ ішуге дайынбыз.
Dialogue: 0,1:13:11.55,1:13:13.43,Default,,0,0,0,,Әкем ана
Dialogue: 0,1:13:13.51,1:13:14.93,Default,,0,0,0,,Ах! Менің қарным ашты
Dialogue: 0,1:13:15.93,1:13:18.22,Default,,0,0,0,,Қоян, тез кір.
Dialogue: 0,1:13:18.31,1:13:19.22,Default,,0,0,0,,Иә!
Dialogue: 0,1:13:19.93,1:13:20.81,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,1:13:20.89,1:13:23.06,Default,,0,0,0,,Уау! Луна
Dialogue: 0,1:13:23.14,1:13:25.94,Default,,0,0,0,,Усаги-чан, қош келдіңіз
Dialogue: 0,1:13:26.02,1:13:28.23,Default,,0,0,0,,Хехе... Мен үйдемін.
Dialogue: 0,1:13:48.17,1:13:55.18,Default,,0,0,0,,Тәтті сөздер көп, бірақ
Dialogue: 0,1:13:55.26,1:14:02.27,Default,,0,0,0,,«Баласың ғой» дейсің.
Dialogue: 0,1:14:02.35,1:14:06.23,Default,,0,0,0,,Қате жаса немесе түсінгендей кейіп таныт
Dialogue: 0,1:14:06.31,1:14:09.94,Default,,0,0,0,,Мен жараланғанда көз жасымды төгемін
Dialogue: 0,1:14:10.02,1:14:13.86,Default,,0,0,0,,Енді тоқтаған дұрыс
Dialogue: 0,1:14:13.94,1:14:17.53,Default,,0,0,0,,Бейбітшілік қоңырауын қайта соқайық
Dialogue: 0,1:14:17.61,1:14:21.24,Default,,0,0,0,,Айдың гүлі, желмен билейді
Dialogue: 0,1:14:21.33,1:14:24.91,Default,,0,0,0,,Осы тілегімнің орындалғанын қалаймын.
Dialogue: 0,1:14:25.00,1:14:28.63,Default,,0,0,0,,Айдың гүлдері Күлгін
Dialogue: 0,1:14:28.71,1:14:32.30,Default,,0,0,0,,Қараңғылықты нұрландырып, гүлдейді
Dialogue: 0,1:14:32.38,1:14:36.01,Default,,0,0,0,,Мен және сен
Dialogue: 0,1:14:36.09,1:14:39.72,Default,,0,0,0,,Қайта туылатын жер
Dialogue: 0,1:14:39.80,1:14:45.39,Default,,0,0,0,,Менің болашағымды айт
Dialogue: 0,1:15:07.29,1:15:10.83,Default,,0,0,0,,Тіпті тағдырды өзгертуге болады
Dialogue: 0,1:15:10.92,1:15:14.55,Default,,0,0,0,,Махаббат менің жүрегімде
Dialogue: 0,1:15:14.63,1:15:18.47,Default,,0,0,0,,Тіпті негізсіз сенім
Dialogue: 0,1:15:18.55,1:15:22.51,Default,,0,0,0,,Енді гауһар жарқырап тұр
Dialogue: 0,1:15:24.10,1:15:27.68,Default,,0,0,0,,Айдың гүлі, желге мін
Dialogue: 0,1:15:27.77,1:15:31.36,Default,,0,0,0,,Мен бұл сезімнің сізге жеткізілгенін қалаймын
Dialogue: 0,1:15:31.44,1:15:35.07,Default,,0,0,0,,Айдың гүлдері Күлгін
Dialogue: 0,1:15:35.15,1:15:38.78,Default,,0,0,0,,Түнде террасада ант ішу
Dialogue: 0,1:15:38.86,1:15:42.49,Default,,0,0,0,,Мен және сен
Dialogue: 0,1:15:42.57,1:15:46.12,Default,,0,0,0,,Қайта туылатын жер
Dialogue: 0,1:15:46.20,1:15:49.79,Default,,0,0,0,,Реинкарнация ғаламы
Dialogue: 0,1:15:49.87,1:15:55.96,Default,,0,0,0,,LetMeKnowMyNewFuture
Dialogue: 0,1:15:59.30,1:16:06.27,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:16:25.83,1:16:29.16,Default,,0,0,0,,Кешіріңіз, мен шыншыл емеспін.
Dialogue: 0,1:16:29.25,1:16:32.50,Default,,0,0,0,,Түсінде айтуға болады
Dialogue: 0,1:16:32.58,1:16:36.00,Default,,0,0,0,,Ойлау тізбегі қысқа тұйықталу шегінде
Dialogue: 0,1:16:36.09,1:16:39.38,Default,,0,0,0,,Мен сені дәл қазір көргім келеді
Dialogue: 0,1:16:39.46,1:16:42.80,Default,,0,0,0,,Жылағыңыз келетін ай сәулесі
Dialogue: 0,1:16:42.88,1:16:46.18,Default,,0,0,0,,Түн жарымда да телефон соға алмаймын
Dialogue: 0,1:16:46.26,1:16:49.60,Default,,0,0,0,,Мен таза болғандықтан, мен не істеуім керек?
Dialogue: 0,1:16:49.68,1:16:53.15,Default,,0,0,0,,Жүрек - калейдоскоп
Dialogue: 0,1:16:53.23,1:16:59.94,Default,,0,0,0,,Ай сәулесінің жетегінде
Dialogue: 0,1:17:00.03,1:17:06.49,Default,,0,0,0,,Көп рет кездесіңіз
Dialogue: 0,1:17:06.58,1:17:10.04,Default,,0,0,0,,Шоқжұлдыздарды жыпылықтап санау
Dialogue: 0,1:17:10.12,1:17:13.42,Default,,0,0,0,,Махаббат тағдырын болжау
Dialogue: 0,1:17:13.50,1:17:16.79,Default,,0,0,0,,Бір жерде туған
Dialogue: 0,1:17:16.88,1:17:20.26,Default,,0,0,0,,Ғажайып романс
Dialogue: 0,1:17:20.34,1:17:26.76,Default,,0,0,0,,Мен ғажайып романтикаға сенемін
Dialogue: 0,1:17:35.98,1:17:37.06,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:17:37.15,1:17:39.32,Default,,0,0,0,,Қайырлы таң Мамо-чан
Dialogue: 0,1:17:39.94,1:17:44.11,Default,,0,0,0,,Ұзақ, ұзақ түс көргендеймін.
Dialogue: 0,1:17:44.20,1:17:45.86,Default,,0,0,0,,Қандай арман?
Dialogue: 0,1:17:45.95,1:17:47.20,Default,,0,0,0,,Ал...
Dialogue: 0,1:17:47.28,1:17:48.33,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:48.41,1:17:51.83,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:17:54.54,1:17:56.33,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,1:17:57.63,1:18:01.71,Default,,0,0,0,,Эй, Мамо-чан, бұл сөздерді тағы бір рет айт.
Dialogue: 0,1:18:02.42,1:18:05.80,Default,,0,0,0,,Юбе Мен оны шамамен 50 рет айттым.
Dialogue: 0,1:18:05.88,1:18:07.22,Default,,0,0,0,,Тағы бір рет
Dialogue: 0,1:18:08.10,1:18:10.60,Default,,0,0,0,,Ал, соңғы рет.
Dialogue: 0,1:18:12.77,1:18:15.19,Default,,0,0,0,,Қоян үйленейік
Dialogue: 0,1:18:15.27,1:18:20.61,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:18:28.70,1:18:29.70,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:29.78,1:18:30.62,Default,,0,0,0,,Не?
Dialogue: 0,1:18:31.24,1:18:33.50,Default,,0,0,0,,Мен мұны қазір сезіндім
Dialogue: 0,1:18:34.41,1:18:38.00,Default,,0,0,0,,Менің ішімде жұлдыз туатындай сезім бар.
Dialogue: 0,1:18:38.83,1:18:41.71,Default,,0,0,0,,Жақында қызымыз келеді.
Dialogue: 0,1:18:41.80,1:18:45.51,Default,,0,0,0,,Менде жаңа Теңізші Сенші дүниеге келетін сияқты.
Dialogue: 0,1:18:46.22,1:18:47.05,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,1:18:47.84,1:18:50.97,Default,,0,0,0,,Бір күні біздің рөліміз аяқталғанша
Dialogue: 0,1:18:51.05,1:18:54.64,Default,,0,0,0,,Біз бұл планетаны мәңгі бірге қорғай аламыз ба?
Dialogue: 0,1:18:55.35,1:18:57.39,Default,,0,0,0,,Менің қолымнан келеді, әрине.
Dialogue: 0,1:18:58.27,1:19:01.15,Default,,0,0,0,,Біз мәңгі бірге өмір сүре аламыз ба?
Dialogue: 0,1:19:02.23,1:19:03.53,Default,,0,0,0,,Ант етемін
Dialogue: 0,1:19:04.57,1:19:06.74,Default,,0,0,0,,Біз әрқашан бірге боламыз
Dialogue: 0,1:19:08.36,1:19:10.16,Default,,0,0,0,,Мен де ант етемін
Dialogue: 0,1:19:10.82,1:19:14.08,Default,,0,0,0,,Мен сені мәңгілікке қорғаймын
Dialogue: 0,1:19:16.58,1:19:17.87,Default,,0,0,0,,Содан кейін
Dialogue: 0,1:19:17.96,1:19:22.71,Default,,0,0,0,,Біз қымбат достарымызды қорғауды жалғастырамыз
Dialogue: 0,1:19:27.38,1:19:28.55,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,1:19:30.68,1:19:34.06,Default,,0,0,0,,Бір күні біз жоғалып кетеміз
Dialogue: 0,1:19:35.02,1:19:36.68,Default,,0,0,0,,Жаңа теңізші Сенши...
Dialogue: 0,1:19:38.02,1:19:40.94,Default,,0,0,0,,Жаңа жұлдыздар бірінен соң бірі дүниеге келсе де
Dialogue: 0,1:19:42.65,1:19:43.73,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,1:19:44.98,1:19:48.70,Default,,0,0,0,,Мәңгілік өлмейтін боласың.
Dialogue: 0,1:19:51.07,1:19:55.45,Default,,0,0,0,,Мәңгі ең әдемі жарқыраған жұлдыз
