Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.68,0:00:20.27,Default,,0,0,0,,♪ Марутаке Эбисуни
Dialogue: 0,0:00:20.35,0:00:22.98,Default,,0,0,0,,♪ Мені жазала
Dialogue: 0,0:00:23.06,0:00:25.60,Default,,0,0,0,,♪ Йомесан Роккаку
Dialogue: 0,0:00:25.69,0:00:28.40,Default,,0,0,0,,♪ Сегізаяқ
Dialogue: 0,0:00:28.48,0:00:30.94,Default,,0,0,0,,♪ Сіз ашуландыңыз ба?
Dialogue: 0,0:00:31.03,0:00:33.70,Default,,0,0,0,,♪ Мацумангоджо
Dialogue: 0,0:00:33.78,0:00:36.03,Default,,0,0,0,,♪ Сеттачара Чара
Dialogue: 0,0:00:36.11,0:00:38.58,Default,,0,0,0,,♪ Уонотана
Dialogue: 0,0:00:38.66,0:00:41.08,Default,,0,0,0,,♪ Рокуджо Хикчо
Dialogue: 0,0:00:41.16,0:00:43.87,Default,,0,0,0,,♪ Жанынан өтіп бара жатқан
Dialogue: 0,0:00:43.96,0:00:46.50,Default,,0,0,0,,♪ Haccho Егер естісеңіз
Dialogue: 0,0:00:46.58,0:00:49.00,Default,,0,0,0,,♪ Тоджимичи
Dialogue: 0,0:00:49.09,0:00:51.71,Default,,0,0,0,,♪ Куджо Оджи де
Dialogue: 0,0:00:51.80,0:00:54.09,Default,,0,0,0,,♪ аяқтаңыз
Dialogue: 0,0:00:54.17,0:00:59.18,Default,,0,0,0,,♪~
Dialogue: 0,0:01:16.45,0:01:18.32,Default,,0,0,0,,Мен орта мектептің детективімін, Шиничи Кудо
Dialogue: 0,0:01:19.32,0:01:21.45,Default,,0,0,0,,Бала күнгі досы және сыныптасы Ран Моримен
Dialogue: 0,0:01:21.53,0:01:23.16,Default,,0,0,0,,Ойын-сауық саябағына барыңыз
Dialogue: 0,0:01:23.24,0:01:24.37,Default,,0,0,0,,Қара киінген адам
Dialogue: 0,0:01:24.45,0:01:26.46,Default,,0,0,0,,Мен күдікті транзакцияның куәсі болдым.
Dialogue: 0,0:01:28.00,0:01:30.46,Default,,0,0,0,,Мен транзакцияны тамашалауға құмар болдым.
Dialogue: 0,0:01:30.54,0:01:33.30,Default,,0,0,0,,Артынан келе жатқан басқа серігін байқамадым.
Dialogue: 0,0:01:34.26,0:01:37.18,Default,,0,0,0,,Ол кісі маған у ішті.
Dialogue: 0,0:01:37.26,0:01:38.43,Default,,0,0,0,,Мен оянғанда...
Dialogue: 0,0:01:39.18,0:01:41.43,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:01:42.01,0:01:44.35,Default,,0,0,0,,Егер олар Шиничи Кудоның тірі екенін білсе ше?
Dialogue: 0,0:01:44.43,0:01:45.93,Default,,0,0,0,,Менің өмірімдегі тағы бір әрекет
Dialogue: 0,0:01:46.02,0:01:47.69,Default,,0,0,0,,Айналаңыздағы адамдар да тәуекелге ұшырайды.
Dialogue: 0,0:01:48.56,0:01:49.52,Default,,0,0,0,,Доктор Агасаның кеңесі бойынша
Dialogue: 0,0:01:49.60,0:01:51.65,Default,,0,0,0,,Мен өзімнің шынайы тұлғамды жасыруды шештім.
Dialogue: 0,0:01:51.73,0:01:52.86,Default,,0,0,0,,Ран менің атымды сұрады
Dialogue: 0,0:01:52.94,0:01:55.36,Default,,0,0,0,,Бірден өзін Эдогава Конан деп атады
Dialogue: 0,0:01:55.44,0:01:57.49,Default,,0,0,0,,Өз ақпаратын алу
Dialogue: 0,0:01:57.57,0:02:00.24,Default,,0,0,0,,Ранның үйіне көшіп келді, оның әкесі детектив болып жұмыс істейді.
Dialogue: 0,0:02:00.32,0:02:01.57,Default,,0,0,0,,♬~
Dialogue: 0,0:02:01.66,0:02:02.49,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:12.25,0:02:16.34,Default,,0,0,0,,Мен Хэйдзи Хатторимін, Наниваның орта мектебінің детективі.
Dialogue: 0,0:02:16.42,0:02:18.13,Default,,0,0,0,,Ой қорыту қабілеті және кендо дағдылары
Dialogue: 0,0:02:18.22,0:02:20.97,Default,,0,0,0,,Осака префектуралық полиция штабының әкесінен мұраға қалды
Dialogue: 0,0:02:21.05,0:02:23.01,Default,,0,0,0,,Сізде шынымен батылдық бар...
Dialogue: 0,0:02:23.68,0:02:24.72,Default,,0,0,0,,Ақшаны беру
Dialogue: 0,0:02:25.43,0:02:28.69,Default,,0,0,0,,Ех~ Айтпақшы, қара түс атамнан қалған.
Dialogue: 0,0:02:29.27,0:02:31.98,Default,,0,0,0,,Бұрын «Батыста Хаттори, Шығыста Кудо»…
Dialogue: 0,0:02:32.06,0:02:32.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:32.98,0:02:35.23,Default,,0,0,0,,Мен есімді ретімен алдым.
Dialogue: 0,0:02:36.32,0:02:37.19,Default,,0,0,0,,Білмеймін!
Dialogue: 0,0:02:37.28,0:02:39.61,Default,,0,0,0,,Кудо күткендей.
Dialogue: 0,0:02:39.70,0:02:43.24,Default,,0,0,0,,Доктор Агаса ойлап тапқан біртүрлі механизмді қолдану...
Dialogue: 0,0:02:43.95,0:02:44.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:46.20,0:02:49.04,Default,,0,0,0,,Істерді бірінен соң бірін шешу
Dialogue: 0,0:02:49.12,0:02:51.54,Default,,0,0,0,,Кудоның шынайы болмысын білетін адам
Dialogue: 0,0:02:51.62,0:02:53.54,Default,,0,0,0,,Менен және дәрігерден басқалар бар.
Dialogue: 0,0:02:53.63,0:02:55.71,Default,,0,0,0,,Кудоның әкесі мен анасы
Dialogue: 0,0:02:55.80,0:02:59.72,Default,,0,0,0,,Сонымен қатар, Айя Хайбара Кудо сияқты бастауыш мектепте оқиды.
Dialogue: 0,0:03:00.30,0:03:04.55,Default,,0,0,0,,Бұл қарындас қара киінген адамның досы болатын.
Dialogue: 0,0:03:04.64,0:03:06.22,Default,,0,0,0,,Ұйымнан шығу кезінде
Dialogue: 0,0:03:06.31,0:03:09.56,Default,,0,0,0,,Кудо амалсыздан қабылдаған дәріні ішіп алды.
Dialogue: 0,0:03:09.64,0:03:12.06,Default,,0,0,0,,Денем тарылып барады.
Dialogue: 0,0:03:12.15,0:03:15.27,Default,,0,0,0,,Айтпақшы, менің де бала күнгі досым, сыныптасым бар.
Dialogue: 0,0:03:15.36,0:03:16.52,Default,,0,0,0,,Казуха Тояма
Dialogue: 0,0:03:16.61,0:03:19.03,Default,,0,0,0,,Е, анау шулы әйел қыз ғой.
Dialogue: 0,0:03:19.11,0:03:20.95,Default,,0,0,0,,- (Қазуба) Кім шу шығарып жатыр? -(Хедзи) Ааа...
Dialogue: 0,0:03:21.03,0:03:22.53,Default,,0,0,0,,Бұл… бұл…
Dialogue: 0,0:03:22.61,0:03:24.78,Default,,0,0,0,,Міне! Кенеттен шықпа, ақымақ!
Dialogue: 0,0:03:24.87,0:03:27.79,Default,,0,0,0,,Сен ақымақсың. Кіммен сөйлесіп тұрсың?
Dialogue: 0,0:03:27.87,0:03:28.95,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:03:29.04,0:03:32.04,Default,,0,0,0,,Сіз қарап отырғандардың барлығына түсінікті етіп сөйлейсіз бе?
Dialogue: 0,0:03:32.12,0:03:33.04,Default,,0,0,0,,Эй?
Dialogue: 0,0:03:33.12,0:03:35.96,Default,,0,0,0,,Иә? Сен жындысың ба?
Dialogue: 0,0:03:36.04,0:03:37.55,Default,,0,0,0,,Біртүрлі сенсің
Dialogue: 0,0:03:37.63,0:03:38.71,Default,,0,0,0,,
Dialogue: 0,0:03:38.80,0:03:40.88,Default,,0,0,0,,Кішірейсек те, миымыз бірдей
Dialogue: 0,0:03:40.97,0:03:43.34,Default,,0,0,0,,Әрқашан бір ақиқат бар!
Dialogue: 0,0:03:47.39,0:03:49.47,Default,,0,0,0,,Бейка Бұл Бейка. Шығу бұл...
Dialogue: 0,0:03:49.56,0:03:51.94,Default,,0,0,0,,Сондықтан мен үйге біраз уақыт бара алмаймын деп ойлаймын.
Dialogue: 0,0:03:52.02,0:03:55.44,Default,,0,0,0,,А, мен істі тергеумен айналысып жатырмын.
Dialogue: 0,0:03:55.52,0:03:56.81,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:57.57,0:04:01.32,Default,,0,0,0,,Бұл күндері күн суық болды, өзіңізді күтіңіз.
Dialogue: 0,0:04:02.11,0:04:04.03,Default,,0,0,0,,Ішің ашық күйде ұйықтама.
Dialogue: 0,0:04:04.11,0:04:05.20,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:05.28,0:04:07.45,Default,,0,0,0,,Мен ішімді ашып ұйықтамаймын, ақымақ!
Dialogue: 0,0:04:07.53,0:04:09.66,Default,,0,0,0,,«Ёшинояма»
Dialogue: 0,0:04:09.74,0:04:12.91,Default,,0,0,0,,«Менікі емес Шираюки қадам бас»
Dialogue: 0,0:04:13.00,0:04:17.00,Default,,0,0,0,,«Кіргендердің ізін сағындым»?
Dialogue: 0,0:04:17.09,0:04:19.92,Default,,0,0,0,,Йошицүнэ және Шизука Гозен
Dialogue: 0,0:04:20.00,0:04:21.26,Default,,0,0,0,,Не!
Dialogue: 0,0:04:21.34,0:04:25.22,Default,,0,0,0,,Біз бала кезден доспыз, сондықтан уайымдауға болмайды.
Dialogue: 0,0:04:25.30,0:04:27.01,Default,,0,0,0,,Әкем қатты шулап жатыр, мен оны қиып алайын.
Dialogue: 0,0:04:27.10,0:04:27.93,Default,,0,0,0,,
Dialogue: 0,0:04:28.01,0:04:29.39,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:04:29.89,0:04:31.02,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:04:31.10,0:04:33.94,Default,,0,0,0,,Келесі жолы ағам үйде жоқ кезде хабарласуым керек.
Dialogue: 0,0:04:34.02,0:04:38.15,Default,,0,0,0,,Иә? Йосицүнэ мен Шизука Гозен?
Dialogue: 0,0:04:38.23,0:04:42.36,Default,,0,0,0,,Бұл екеуі ажырасқаннан кейін ешқашан кездеспеді...
Dialogue: 0,0:04:42.44,0:04:44.20,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:05:11.26,0:05:13.60,Default,,0,0,0,,Кешіктірме, Беңкей.
Dialogue: 0,0:05:13.68,0:05:16.52,Default,,0,0,0,,А, сен жұмбақты шештің дедің.
Dialogue: 0,0:05:16.60,0:05:20.02,Default,,0,0,0,,Өйткені ол осыған ең ынталы болды.
Dialogue: 0,0:05:21.57,0:05:23.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:23.11,0:05:24.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:24.11,0:05:25.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:25.32,0:05:26.99,Default,,0,0,0,,Әй, Катаока!
Dialogue: 0,0:05:27.07,0:05:28.07,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:29.12,0:05:30.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:30.83,0:05:31.66,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:32.45,0:05:34.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:05.61,0:06:06.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:41.31,0:06:47.36,Default,,0,0,0,,Е... Тергеу нәтижесінде Токио, Осака және Киото қалаларында өлтірілген бес адам
Dialogue: 0,0:06:47.94,0:06:52.24,Default,,0,0,0,,Ол «Гендзи Хотару» ұрылар тобының мүшесі екені белгілі болды.
Dialogue: 0,0:06:52.32,0:06:53.16,Default,,0,0,0,,
Dialogue: 0,0:06:53.24,0:06:55.28,Default,,0,0,0,,Сондықтан бұл жағдай...
Dialogue: 0,0:06:55.37,0:06:56.62,Default,,0,0,0,,Сато мырза
Dialogue: 0,0:06:56.70,0:06:59.46,Default,,0,0,0,,Киото префектуралық полициясының инспекторы Аянокодзи
Dialogue: 0,0:06:59.54,0:07:01.67,Default,,0,0,0,,Ол инспектор Шираторимен бір дәуірден болса керек.
Dialogue: 0,0:07:01.75,0:07:05.92,Default,,0,0,0,,Иә, ол текті әулеттен шыққан, лақап аты «Ревизор Оджару».
Dialogue: 0,0:07:06.00,0:07:07.51,Default,,0,0,0,,Қара, сол қалта.
Dialogue: 0,0:07:07.59,0:07:08.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:08.51,0:07:11.34,Default,,0,0,0,,Не... не? Бұл
Dialogue: 0,0:07:11.43,0:07:15.05,Default,,0,0,0,,Үй жануарлары бурундуки Ол оны үнемі өзімен бірге алып жүретін сияқты.
Dialogue: 0,0:07:15.14,0:07:15.97,Default,,0,0,0,,О...
Dialogue: 0,0:07:16.06,0:07:18.47,Default,,0,0,0,,Сен Ширатори-куннан да біртүрлі екенсің.
Dialogue: 0,0:07:18.56,0:07:21.48,Default,,0,0,0,,Genji Firefly 1991 жылдан бері бар.
Dialogue: 0,0:07:21.56,0:07:23.94,Default,,0,0,0,,Негізінен Токио, Киото және Осака қалаларында
Dialogue: 0,0:07:24.02,0:07:27.82,Default,,0,0,0,,Атақты будда мүсіндері мен өнер туындыларын ұрлау жалғасуда
Dialogue: 0,0:07:27.90,0:07:33.11,Default,,0,0,0,,Олардың сипаттамасы мынада: барлық мүшелер Йосицүнэнің ұстаушыларының атымен аталады.
Dialogue: 0,0:07:33.20,0:07:36.37,Default,,0,0,0,,Бірдей «Гикейкиге» ие болу
Dialogue: 0,0:07:36.45,0:07:37.62,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:38.37,0:07:40.00,Default,,0,0,0,,Көшбасшысы Йосицунэ
Dialogue: 0,0:07:40.08,0:07:44.50,Default,,0,0,0,,Бенкейден төмен, Сабуро Исес, т.б. барлығы 8 адам
Dialogue: 0,0:07:44.58,0:07:47.30,Default,,0,0,0,,Бұл жолы үшеуінен басқа бес адам қаза тапты.
Dialogue: 0,0:07:47.96,0:07:49.67,Default,,0,0,0,,«Гикейки» алынды.
Dialogue: 0,0:07:49.76,0:07:50.80,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:50.88,0:07:52.30,Default,,0,0,0,,Кінәліге қандай да бір анықтамалар бар ма?
Dialogue: 0,0:07:52.38,0:07:54.80,Default,,0,0,0,,Қылыш пен садақтың шебері
Dialogue: 0,0:07:54.89,0:07:56.05,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:07:56.14,0:07:59.68,Default,,0,0,0,,Йошицуне Бенкей Исабуроға қатысты
Dialogue: 0,0:07:59.77,0:08:02.64,Default,,0,0,0,,Біз сіздің жасыңызды немесе жынысыңызды білмейміз.
Dialogue: 0,0:08:03.27,0:08:06.11,Default,,0,0,0,,Кез келген жағдайда мүмкіндігінше тезірек
Dialogue: 0,0:08:06.19,0:08:10.15,Default,,0,0,0,,Қылмыскерді және қарақшы топтың қалған мүшелерін тұтқындау.
Dialogue: 0,0:08:10.23,0:08:12.74,Default,,0,0,0,,Біз тергеуді жалғастырамыз.
Dialogue: 0,0:08:12.82,0:08:14.86,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:08:19.45,0:08:24.37,Default,,0,0,0,,«Хейсэй дәуіріндегі Йошицюнэ ұрылар тобының басшысы болды»?
Dialogue: 0,0:08:25.04,0:08:25.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:47.19,0:08:48.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:49.48,0:08:50.69,Default,,0,0,0,,Хэйдзи бар ма?
Dialogue: 0,0:08:50.78,0:08:51.61,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:08:51.69,0:08:52.57,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:08:57.91,0:09:01.29,Default,,0,0,0,,Жоқ, бұл маңызды емес пе? Бұл
Dialogue: 0,0:09:01.37,0:09:04.83,Default,,0,0,0,,Сосо... сояна дұрыс Шимотокан.
Dialogue: 0,0:09:05.33,0:09:06.75,Default,,0,0,0,,Хэйдзи, сыртқа шығасың ба?
Dialogue: 0,0:09:06.83,0:09:09.88,Default,,0,0,0,,А, мен бір нәрсені білгім келеді.
Dialogue: 0,0:09:09.96,0:09:12.30,Default,,0,0,0,,Иә? Бірдеңе істедің бе?
Dialogue: 0,0:09:12.38,0:09:13.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.46,0:09:18.14,Default,,0,0,0,,Жоқ, мен шие гүлдерін көру үшін Томороки жасыл саябағына баруды ойладым.
Dialogue: 0,0:09:18.22,0:09:19.05,Default,,0,0,0,,Бірақ иә.
Dialogue: 0,0:09:19.14,0:09:22.31,Default,,0,0,0,,Мен көремін. Хона, мен сәлден кейін барамын.
Dialogue: 0,0:09:23.56,0:09:24.77,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:09:24.85,0:09:26.06,Default,,0,0,0,,О
Dialogue: 0,0:09:29.81,0:09:32.98,Default,,0,0,0,,Мен сені неге күліп шығарып сала алмаймын?
Dialogue: 0,0:09:37.41,0:09:41.33,Default,,0,0,0,,Өйткені, Киото біздің жапондықтардың туған қаласы!
Dialogue: 0,0:09:41.41,0:09:44.58,Default,,0,0,0,,Жарайсың ба? Мен сені осында арнайы алып келдім.
Dialogue: 0,0:09:44.66,0:09:46.33,Default,,0,0,0,,Менің жұмысыма кедергі жасама.
Dialogue: 0,0:09:46.41,0:09:48.33,Default,,0,0,0,,Иә
Dialogue: 0,0:09:48.92,0:09:51.84,Default,,0,0,0,,Керемет, Конан-кун, Киото?
Dialogue: 0,0:09:51.92,0:09:54.38,Default,,0,0,0,,Санно-джи храмы деп аталатын ғибадатханадағы кез келген нәрсе
Dialogue: 0,0:09:54.46,0:09:56.80,Default,,0,0,0,,Моури-кунға өтініш түскенін естідім.
Dialogue: 0,0:09:56.88,0:10:00.26,Default,,0,0,0,,Тексеру... Киотоға да барайық!
Dialogue: 0,0:10:00.34,0:10:01.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:01.35,0:10:03.76,Default,,0,0,0,,Мен сені сонда апарсам, жарайды.
Dialogue: 0,0:10:03.85,0:10:04.97,Default,,0,0,0,,Не!
Dialogue: 0,0:10:05.06,0:10:06.43,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:10:06.52,0:10:07.98,Default,,0,0,0,,Конанмен таныс болыңыз!
Dialogue: 0,0:10:08.06,0:10:09.94,Default,,0,0,0,,♪ Киото Киото
Dialogue: 0,0:10:10.02,0:10:11.61,Default,,0,0,0,,♪ Ертең Киото
Dialogue: 0,0:10:10.02,0:10:11.61,Default,,0,0,0,,Дегенмен, егер сіз викторинаға жауап бере алсаңыз
Dialogue: 0,0:10:11.61,0:10:11.69,Default,,0,0,0,,Дегенмен, егер сіз викторинаға жауап бере алсаңыз
Dialogue: 0,0:10:11.69,0:10:13.19,Default,,0,0,0,,Дегенмен, егер сіз викторинаға жауап бере алсаңыз
Dialogue: 0,0:10:11.69,0:10:13.19,Default,,0,0,0,,♪ Тіпті келесі күні...
Dialogue: 0,0:10:13.27,0:10:14.78,Default,,0,0,0,,Міне...
Dialogue: 0,0:10:14.86,0:10:17.36,Default,,0,0,0,,Мен бәрібір олай ойламаймын.
Dialogue: 0,0:10:17.45,0:10:18.40,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:10:18.49,0:10:20.16,Default,,0,0,0,,- (3 адам) Иә? -(Хайбара) Неге бермейсің?
Dialogue: 0,0:10:21.07,0:10:23.16,Default,,0,0,0,,Бұл уақытты өлтірудің жақсы тәсілі болуы мүмкін
Dialogue: 0,0:10:23.24,0:10:25.20,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:10:25.29,0:10:26.45,Default,,0,0,0,,Көріп көрейік
Dialogue: 0,0:10:26.54,0:10:28.16,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:10:28.25,0:10:29.58,Default,,0,0,0,,
Dialogue: 0,0:10:29.67,0:10:31.88,Default,,0,0,0,,Бәңкейді үшеуің де білесіңдер ғой?
Dialogue: 0,0:10:31.96,0:10:35.00,Default,,0,0,0,,Иә, ол Йосицүнэнің қызметшісі.
Dialogue: 0,0:10:35.09,0:10:37.51,Default,,0,0,0,,Эй, Йосицүнэ деген кім?
Dialogue: 0,0:10:37.59,0:10:39.68,Default,,0,0,0,,Балалық есімі «Ушивакамару»
Dialogue: 0,0:10:39.76,0:10:41.39,Default,,0,0,0,,Киотодағы Годжо Охаши көпірінде
Dialogue: 0,0:10:41.47,0:10:44.89,Default,,0,0,0,,Бенкей өзінің 1000-шы қылышын көздеді.
Dialogue: 0,0:10:44.97,0:10:48.39,Default,,0,0,0,,Оны жеңіп, өзіне қызметші еткен адам – Минамото но Йосицунэ.
Dialogue: 0,0:10:49.10,0:10:54.15,Default,,0,0,0,,Ол кезде Минамото руы мен Хейке шайқасып, Йосицүнэ Хейкені жеңді.
Dialogue: 0,0:10:54.73,0:10:56.65,Default,,0,0,0,,Үлкен ағасы Йоритомо оны жек көреді.
Dialogue: 0,0:10:57.23,0:11:00.91,Default,,0,0,0,,Хирайзумидегі Киногава деп аталатын жер, қазіргі Ивате префектурасы.
Dialogue: 0,0:11:00.99,0:11:02.20,Default,,0,0,0,,Мен өз-өзіме қол жұмсадым.
Dialogue: 0,0:11:02.28,0:11:05.03,Default,,0,0,0,,О... сіз жақсырақ білесіз.
Dialogue: 0,0:11:05.12,0:11:06.41,Default,,0,0,0,,Мәселе мынада.
Dialogue: 0,0:11:07.04,0:11:10.58,Default,,0,0,0,,Бәңкейдің «Үзүне» атты алғашқы махаббаты бар.
Dialogue: 0,0:11:10.66,0:11:13.71,Default,,0,0,0,,Қызы басқа адамға тұрмысқа шықты.
Dialogue: 0,0:11:13.79,0:11:16.09,Default,,0,0,0,,Бұл туралы Бенкей білгенде...
Dialogue: 0,0:11:16.17,0:11:18.09,Default,,0,0,0,,1 ашулы
Dialogue: 0,0:11:18.17,0:11:19.76,Default,,0,0,0,,2 қуанып қалды
Dialogue: 0,0:11:19.84,0:11:21.59,Default,,0,0,0,,3 Мен жыладым
Dialogue: 0,0:11:21.68,0:11:23.22,Default,,0,0,0,,Енді қайсысы?
Dialogue: 0,0:11:23.30,0:11:26.10,Default,,0,0,0,,Иә~ Менің алғашқы махаббатым...
Dialogue: 0,0:11:26.18,0:11:27.31,Default,,0,0,0,,Ухуху…
Dialogue: 0,0:11:29.31,0:11:31.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:31.31,0:11:33.31,Default,,0,0,0,,Бұл мені ашуландырады!
Dialogue: 0,0:11:33.40,0:11:35.61,Default,,0,0,0,,Сіз бақытты бола алмайсыз!
Dialogue: 0,0:11:35.69,0:11:39.24,Default,,0,0,0,,Сонымен, жауап №1, «Мен ашуландым», солай ма?
Dialogue: 0,0:11:39.32,0:11:40.90,Default,,0,0,0,,- (Хайбара) жылады - (Ағаса) ашуланды...
Dialogue: 0,0:11:40.99,0:11:42.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:43.03,0:11:45.28,Default,,0,0,0,,Жауабы №3 «Мен жыладым»
Dialogue: 0,0:11:45.37,0:11:47.91,Default,,0,0,0,,Сіз идеяны «Бенкейдің жылаған сахнасынан» алдыңыз, солай ма?
Dialogue: 0,0:11:47.99,0:11:51.37,Default,,0,0,0,,Мен енді білмеймін... Ай-күн.
Dialogue: 0,0:11:52.12,0:11:53.92,Default,,0,0,0,,«Бенкейдің жылаған сахнасы» дегеніміз не?
Dialogue: 0,0:11:54.00,0:11:56.50,Default,,0,0,0,,Тіпті Беңкейдей мықты біреу
Dialogue: 0,0:11:56.59,0:12:00.80,Default,,0,0,0,,Егер мені бір жерден тепсе, бір жерім ауырып, жылап жіберемін.
Dialogue: 0,0:12:00.88,0:12:04.93,Default,,0,0,0,,Беңкейдің жылайтын жері осы жіліншік.
Dialogue: 0,0:12:05.01,0:12:09.43,Default,,0,0,0,,Бірақ оның викторина сұрақтарына қандай қатысы бар?
Dialogue: 0,0:12:09.52,0:12:11.73,Default,,0,0,0,,Аа, дұрыс...
Dialogue: 0,0:12:11.81,0:12:13.64,Default,,0,0,0,,- (Аюми) Түсіндім! - (Гента/Мицухико) Иә?
Dialogue: 0,0:12:14.23,0:12:17.65,Default,,0,0,0,,Күйеу жігіт пен Ұзыне үйленіп жатыр.
Dialogue: 0,0:12:17.73,0:12:18.94,Default,,0,0,0,,«Муко» және «Узунэ»
Dialogue: 0,0:12:19.02,0:12:20.11,Default,,0,0,0,,«Жіліншіктен тыс»
Dialogue: 0,0:12:20.19,0:12:21.99,Default,,0,0,0,,О...
Dialogue: 0,0:12:22.07,0:12:23.74,Default,,0,0,0,,Тағы бір сөз тіркесі?
Dialogue: 0,0:12:23.82,0:12:27.74,Default,,0,0,0,,Бірақ сіз дұрыс жауап бергендіктен, біз Киотоға бара аламыз.
Dialogue: 0,0:12:27.83,0:12:30.95,Default,,0,0,0,,А, жоқ, Айкун жауап берді...
Dialogue: 0,0:12:31.04,0:12:35.50,Default,,0,0,0,,Хайбара мырза біздің Детектив жігіттер тобының мүшесі.
Dialogue: 0,0:12:35.58,0:12:38.75,Default,,0,0,0,,Хайбара-санды сыртта қалдырмаңыз!
Dialogue: 0,0:12:38.84,0:12:43.34,Default,,0,0,0,,Анам маған уәдені бұзатын ересек адам болма деді!
Dialogue: 0,0:12:43.42,0:12:45.34,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,0:12:46.51,0:12:47.43,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:56.56,0:12:58.19,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:58.27,0:13:00.40,Default,,0,0,0,,А, сәлем, сәлем
Dialogue: 0,0:13:07.45,0:13:08.66,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:13:08.74,0:13:11.87,Default,,0,0,0,,Мен осылай айтсам да, бұл жерде ғана...
Dialogue: 0,0:13:11.95,0:13:14.79,Default,,0,0,0,,Иә? О, Моури-сан!
Dialogue: 0,0:13:14.87,0:13:17.88,Default,,0,0,0,,Алыстан қонаққа келгеніңізге рахмет.
Dialogue: 0,0:13:17.96,0:13:21.05,Default,,0,0,0,,Мен Рюенмін, саған қоңырау шалған адаммын.
Dialogue: 0,0:13:21.13,0:13:22.88,Default,,0,0,0,,Таныстыру
Dialogue: 0,0:13:22.96,0:13:25.55,Default,,0,0,0,,Бұл бас діни қызметкер Энкай.
Dialogue: 0,0:13:25.63,0:13:29.05,Default,,0,0,0,,Бұл үш адам біздің би отбасының мүшелері.
Dialogue: 0,0:13:29.14,0:13:31.14,Default,,0,0,0,,Шозо Сакура мырза
Dialogue: 0,0:13:31.22,0:13:34.43,Default,,0,0,0,,Мен Терамачи көшесінде антиквариат дүкенін басқарамын.
Dialogue: 0,0:13:34.52,0:13:37.81,Default,,0,0,0,,Сіздің мақалаңызды атақты Моури Когоро жазған ба?
Dialogue: 0,0:13:37.90,0:13:41.90,Default,,0,0,0,,Иә? А~ Жоқ, сен шынымен де атақтысың ба?
Dialogue: 0,0:13:41.98,0:13:45.36,Default,,0,0,0,,Көрші үй - Мидзуо мектебінің жас шебері.
Dialogue: 0,0:13:45.44,0:13:47.40,Default,,0,0,0,,Шунтаро Мизуо мырза
Dialogue: 0,0:13:47.49,0:13:50.91,Default,,0,0,0,,Және пайдаланылған кітап дүкенін басқаратын Тайга Сайджо.
Dialogue: 0,0:13:50.99,0:13:52.70,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:13:52.79,0:13:56.33,Default,,0,0,0,,Мен бишіден гөрі кендо досымын.
Dialogue: 0,0:13:56.41,0:13:59.38,Default,,0,0,0,,Сәлем... бәріңе, Кендо...
Dialogue: 0,0:13:59.46,0:14:02.84,Default,,0,0,0,,Бас діни қызметкердің де қобалжуы сондықтан.
Dialogue: 0,0:14:02.92,0:14:05.55,Default,,0,0,0,,Хо… Кендо достары
Dialogue: 0,0:14:05.63,0:14:07.88,Default,,0,0,0,,Айтпақшы, бұл храмда бар
Dialogue: 0,0:14:07.97,0:14:12.01,Default,,0,0,0,,12 жылда бір рет ашылатын жасырын Будда бар сияқты.
Dialogue: 0,0:14:12.10,0:14:15.47,Default,,0,0,0,,Иә, басты бейне – Медицина Будда.
Dialogue: 0,0:14:15.56,0:14:18.56,Default,,0,0,0,,Біраз уақыттан кейін ол көпшілікке ашық болады.
Dialogue: 0,0:14:18.64,0:14:21.19,Default,,0,0,0,,Біз де мұны асыға күттік.
Dialogue: 0,0:14:21.27,0:14:26.40,Default,,0,0,0,,Мен Якуши Нюрайдың бұған риза болатынына сенімдімін.
Dialogue: 0,0:14:27.15,0:14:28.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:29.20,0:14:32.78,Default,,0,0,0,,Не! Сіздің басты суретіңіз ұрланды ма?
Dialogue: 0,0:14:32.87,0:14:36.29,Default,,0,0,0,,Иә, бұл 8 жыл бұрын болды.
Dialogue: 0,0:14:39.37,0:14:42.29,Default,,0,0,0,,Оң жақта Никко Бодхисаттва мүсіні.
Dialogue: 0,0:14:42.38,0:14:45.30,Default,,0,0,0,,Сол жақта Ай сәулесі Бодхисаттва мүсіні.
Dialogue: 0,0:14:45.38,0:14:49.76,Default,,0,0,0,,Бірақ орталықта болуы тиіс Якуши Нюрай ұры болып шықты...
Dialogue: 0,0:14:49.84,0:14:53.43,Default,,0,0,0,,Мен дереу полиция шақырайық дедім.
Dialogue: 0,0:14:53.93,0:14:55.81,Default,,0,0,0,,Бас діни қызметкер тоқтатты
Dialogue: 0,0:14:56.39,0:14:57.43,Default,,0,0,0,,«Егер байланыс болса...»
Dialogue: 0,0:14:57.52,0:15:00.81,Default,,0,0,0,,Маған қайта оралуым мүмкін екенін айтты.
Dialogue: 0,0:15:00.89,0:15:03.31,Default,,0,0,0,,Қаншама уақыт...
Dialogue: 0,0:15:03.40,0:15:07.07,Default,,0,0,0,,Міне, сегіз жыл өтті.
Dialogue: 0,0:15:07.15,0:15:10.99,Default,,0,0,0,,Бес күн бұрын бұл ғибадатхананың пошта жәшігінде болған...
Dialogue: 0,0:15:11.07,0:15:13.12,Default,,0,0,0,,Мөрлері жоқ
Dialogue: 0,0:15:13.20,0:15:15.49,Default,,0,0,0,,Жіберушінің аты жоқ па?
Dialogue: 0,0:15:17.45,0:15:18.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:18.58,0:15:20.66,Default,,0,0,0,,«Егер сен осы суреттің жұмбағын шешсең»
Dialogue: 0,0:15:20.75,0:15:24.25,Default,,0,0,0,,«Мен Будда мүсінінің қайда екенін айта аламын».
Dialogue: 0,0:15:24.34,0:15:27.00,Default,,0,0,0,,Не? Мына сурет
Dialogue: 0,0:15:32.47,0:15:34.22,Default,,0,0,0,,Сәлеметсіз бе, ағай
Dialogue: 0,0:15:36.14,0:15:39.02,Default,,0,0,0,,Таңертең ерте болғандықтан, куәгерлер жоқ.
Dialogue: 0,0:15:39.10,0:15:40.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:40.48,0:15:41.81,Default,,0,0,0,,Ұры!
Dialogue: 0,0:15:44.02,0:15:45.02,Default,,0,0,0,,Канка!
Dialogue: 0,0:15:45.11,0:15:46.57,Default,,0,0,0,,Сәлем! (соққы дыбысы)
Dialogue: 0,0:15:46.65,0:15:47.78,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:48.40,0:15:49.23,Default,,0,0,0,,Гррр…
Dialogue: 0,0:15:49.86,0:15:52.20,Default,,0,0,0,,Бұл~! Есіңе түскенде
Dialogue: 0,0:15:53.11,0:15:56.62,Default,,0,0,0,,Дәл осы жерде Бәңкей ауырады деп жылайды.
Dialogue: 0,0:15:58.54,0:16:00.37,Default,,0,0,0,,Қараңызшы, бұл солай ма? Апай
Dialogue: 0,0:16:00.45,0:16:04.04,Default,,0,0,0,,Үлкен аға, сіз өте кереметсіз.
Dialogue: 0,0:16:04.12,0:16:05.92,Default,,0,0,0,,Жоқ, жоқ, онша емес...
Dialogue: 0,0:16:06.00,0:16:09.38,Default,,0,0,0,,Мен Миягава-чода шай дүкенін басқарамын.
Dialogue: 0,0:16:09.46,0:16:10.88,Default,,0,0,0,,Таэдо Ямакура
Dialogue: 0,0:16:12.63,0:16:14.55,Default,,0,0,0,,Қараңызшы, сіз де қызмет ете аласыз.
Dialogue: 0,0:16:14.64,0:16:15.80,Default,,0,0,0,,Иә
Dialogue: 0,0:16:16.30,0:16:17.72,Default,,0,0,0,,Сенга Сузудосу
Dialogue: 0,0:16:17.81,0:16:19.85,Default,,0,0,0,,Менің атым Ота.
Dialogue: 0,0:16:19.93,0:16:20.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:23.10,0:16:25.02,Default,,0,0,0,,Мм... Сізге көп рахмет...
Dialogue: 0,0:16:25.10,0:16:28.19,Default,,0,0,0,,А, жоқ, мен онша үлкен ештеңе істеген жоқпын.
Dialogue: 0,0:16:28.27,0:16:30.73,Default,,0,0,0,,Егер сіз байсалды болсаңыз, келесі жолы маған келіңіз.
Dialogue: 0,0:16:32.28,0:16:33.36,Default,,0,0,0,,Үйге қайтқанда сақ болыңыз
Dialogue: 0,0:16:33.45,0:16:35.45,Default,,0,0,0,,Қалғандары жақсы ілгерілеп жатыр ма екен?
Dialogue: 0,0:16:41.45,0:16:43.87,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:16:43.96,0:16:46.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:46.46,0:16:49.38,Default,,0,0,0,,Мына сурет не...
Dialogue: 0,0:16:49.96,0:16:53.09,Default,,0,0,0,,Жоғарғы 5-ші қатарда не сызылған
Dialogue: 0,0:16:53.17,0:16:55.76,Default,,0,0,0,,Цикада, теңге және алтын балық.
Dialogue: 0,0:16:55.84,0:16:59.64,Default,,0,0,0,,Төмендегі төртінші қатарда тауық...
Dialogue: 0,0:16:59.72,0:17:00.89,Default,,0,0,0,,Бұл лоч ба?
Dialogue: 0,0:17:00.97,0:17:03.89,Default,,0,0,0,,Сары бөренелер жиіркенішті.
Dialogue: 0,0:17:04.48,0:17:06.48,Default,,0,0,0,,Бұл нүкте қандай?
Dialogue: 0,0:17:06.56,0:17:08.27,Default,,0,0,0,,Бұл жай дақ, солай ма?
Dialogue: 0,0:17:08.86,0:17:13.90,Default,,0,0,0,,Екінші және үшінші деңгейлер, шегіргүлдер, теңге және Фудзи тауы арасында...
Dialogue: 0,0:17:13.99,0:17:16.41,Default,,0,0,0,,Әй, оның да қасында желеңді бар.
Dialogue: 0,0:17:17.07,0:17:20.66,Default,,0,0,0,,Әй, әке, ертеңге дейін тауып бере аласыз ба?
Dialogue: 0,0:17:20.74,0:17:22.79,Default,,0,0,0,,…
Dialogue: 0,0:17:22.87,0:17:26.33,Default,,0,0,0,,Мұндай сурет маған келсе, жұмбақ та, ештеңе де болмас еді.
Dialogue: 0,0:17:26.42,0:17:28.75,Default,,0,0,0,,Эй, эй... бұл рас па?
Dialogue: 0,0:17:28.83,0:17:34.63,Default,,0,0,0,,Эй, будда мүсіндерін іздеуді кәсіпқойларға қалдыр, ал Киотоға барайық.
Dialogue: 0,0:17:34.72,0:17:36.59,Default,,0,0,0,,О, мынаны істе, мынаны істе
Dialogue: 0,0:17:36.68,0:17:38.39,Default,,0,0,0,,Балалар, сендер осында болсаңдар да, бұл жай ғана ыңғайсыздық.
Dialogue: 0,0:17:39.01,0:17:41.97,Default,,0,0,0,,Негізі мен Казуха-чанға хабарластым.
Dialogue: 0,0:17:42.06,0:17:45.27,Default,,0,0,0,,Мені ертең Киотода көрсету керек.
Dialogue: 0,0:17:45.35,0:17:48.48,Default,,0,0,0,,О, бірақ Хаттори-кунның бір ісі бар, келе алмайды.
Dialogue: 0,0:17:48.56,0:17:51.48,Default,,0,0,0,,Қызы бар еркектің болмағаны дұрыс.
Dialogue: 0,0:17:52.07,0:17:54.90,Default,,0,0,0,,Хмм... Ол келмей ме?
Dialogue: 0,0:17:55.65,0:17:57.28,Default,,0,0,0,,Конан-кун, сен бізбен барасың, солай ма?
Dialogue: 0,0:17:57.36,0:17:59.82,Default,,0,0,0,,Ах, менде бәрі жақсы.
Dialogue: 0,0:17:59.91,0:18:03.16,Default,,0,0,0,,Мен көрші балалармен өзенге балық аулауға уәде бердім...
Dialogue: 0,0:18:03.24,0:18:07.04,Default,,0,0,0,,О, сенің достарың бар ма? Бірақ сақ болыңыз
Dialogue: 0,0:18:07.12,0:18:08.46,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:18:09.50,0:18:14.55,Default,,0,0,0,,Санно-джи ғибадатханасынан Будда мүсінін ұрлаған Гендзи Хотару екені күмәнсіз.
Dialogue: 0,0:18:15.05,0:18:19.76,Default,,0,0,0,,Бірақ бұл суретті кім және қандай мақсатпен жеткізген?
Dialogue: 0,0:18:19.84,0:18:23.10,Default,,0,0,0,,Мұның бес кісі өлтірумен қандай қатысы бар?
Dialogue: 0,0:18:24.89,0:18:26.93,Default,,0,0,0,,…
Dialogue: 0,0:18:27.02,0:18:31.73,Default,,0,0,0,,Йошицүнэ мен Бенкейге келетін болсақ, ол жерде екені сөзсіз.
Dialogue: 0,0:18:42.16,0:18:43.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:46.04,0:18:49.54,Default,,0,0,0,,Жұмбақ суретке қатысты ештеңе жоқ сияқты.
Dialogue: 0,0:18:50.71,0:18:53.25,Default,,0,0,0,,Киотодағы Годжо көпірінде...
Dialogue: 0,0:18:53.96,0:18:56.05,Default,,0,0,0,,…
Dialogue: 0,0:18:56.13,0:18:58.05,Default,,0,0,0,,Ұзын нагинатаңызды көтеріңіз...
Dialogue: 0,0:18:58.13,0:19:00.43,Default,,0,0,0,,Ушивакаға соққы беріңіз!
Dialogue: 0,0:19:00.51,0:19:01.64,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:01.72,0:19:02.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:03.22,0:19:04.05,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:04.14,0:19:06.06,Default,,0,0,0,,…
Dialogue: 0,0:19:07.02,0:19:08.81,Default,,0,0,0,,Сізбен осында кездесу үшін
Dialogue: 0,0:19:08.89,0:19:11.31,Default,,0,0,0,,Құдай маған да керемет істер жасайды деп үміттенемін.
Dialogue: 0,0:19:11.40,0:19:12.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:12.31,0:19:14.86,Default,,0,0,0,,Бауырым, маған бамбук қылышын қайтар!
Dialogue: 0,0:19:16.11,0:19:17.90,Default,,0,0,0,,Кешіріңіз, кешіріңіз, рахмет.
Dialogue: 0,0:19:18.57,0:19:19.65,Default,,0,0,0,,Хона, кеттік!
Dialogue: 0,0:19:19.74,0:19:21.24,Default,,0,0,0,,О!
Dialogue: 0,0:19:22.91,0:19:25.20,Default,,0,0,0,,Қатты жаттығу!
Dialogue: 0,0:19:25.28,0:19:27.49,Default,,0,0,0,,Бамбук қылышын қарызға алма.
Dialogue: 0,0:19:27.58,0:19:30.37,Default,,0,0,0,,Сонымен қатар, сен мұнда не істеп жүрсің?
Dialogue: 0,0:19:31.00,0:19:33.17,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:34.67,0:19:38.01,Default,,0,0,0,,Шындығында, Осакада такояки дүкенінің қарт адамы өлтірілді.
Dialogue: 0,0:19:38.09,0:19:39.92,Default,,0,0,0,,Бұл таныс жүз болды.
Dialogue: 0,0:19:40.01,0:19:43.76,Default,,0,0,0,,Ол ұрылар тобының мүшесі болса керек.
Dialogue: 0,0:19:43.84,0:19:46.39,Default,,0,0,0,,Мен сол дүкенге орта мектептен бастап барамын.
Dialogue: 0,0:19:46.47,0:19:51.44,Default,,0,0,0,,Сіз маған көп жағынан көмектескендіктен, сіз қылмыскердің атын атап, жау қылған шығарсыз деп ойладым.
Dialogue: 0,0:19:51.52,0:19:53.56,Default,,0,0,0,,Сонымен Киотоға келіңіз
Dialogue: 0,0:19:53.65,0:19:56.73,Default,,0,0,0,,Сонымен, сіз кінәлі туралы анықтама іздедіңіз бе?
Dialogue: 0,0:19:56.82,0:19:58.57,Default,,0,0,0,,Сонда бізде жақсы нәрсе бар.
Dialogue: 0,0:19:58.65,0:19:59.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:04.03,0:20:05.99,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:20:06.07,0:20:07.78,Default,,0,0,0,,Осы суреттің жұмбағын шешсеңдер
Dialogue: 0,0:20:07.87,0:20:12.58,Default,,0,0,0,,Бұл жай будда мүсіні, бірақ ол кісі өлтірушіге де әкелуі мүмкін.
Dialogue: 0,0:20:13.12,0:20:13.96,Default,,0,0,0,,Ал сіз...
Dialogue: 0,0:20:14.04,0:20:18.05,Default,,0,0,0,,Аа, егер Будда мүсінін ұрлаған Гендзи Фалай болса.
Dialogue: 0,0:20:18.13,0:20:22.13,Default,,0,0,0,,Йошицүнэ мен Бенкейге қатысты жерлерге барсаңыз, жұмбақ шешуге көмектесетін тұстарды табасыз.
Dialogue: 0,0:20:22.22,0:20:25.09,Default,,0,0,0,,Мен оны ұстап алатын шығармын деп ойладым.
Dialogue: 0,0:20:25.18,0:20:27.01,Default,,0,0,0,,Мен Киотоны мүлде түсінбеймін.
Dialogue: 0,0:20:27.10,0:20:29.77,Default,,0,0,0,,Шынымды айтсам, қазірден бастап маған қалдырыңыз.
Dialogue: 0,0:20:29.85,0:20:31.64,Default,,0,0,0,,Мен сізге жол көрсетемін.
Dialogue: 0,0:20:37.40,0:20:39.07,Default,,0,0,0,,Бұл Годжо Тенжин
Dialogue: 0,0:20:39.86,0:20:40.98,Default,,0,0,0,,«Гикейкиде»
Dialogue: 0,0:20:41.07,0:20:45.28,Default,,0,0,0,,Годжо Охаши көпірі Бұл жерде екі адам кездесті.
Dialogue: 0,0:20:46.16,0:20:49.16,Default,,0,0,0,,Не? Ортақ нәрсе бар ма?
Dialogue: 0,0:20:49.24,0:20:52.87,Default,,0,0,0,,Хмм... жоқ, мен олай ойламаймын.
Dialogue: 0,0:20:52.96,0:20:54.96,Default,,0,0,0,,Хона, келесі жолы барайық.
Dialogue: 0,0:20:55.04,0:20:56.50,Default,,0,0,0,,Бірақ бұл маған ұнамайды.
Dialogue: 0,0:20:56.58,0:20:57.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:57.50,0:21:02.05,Default,,0,0,0,,Неліктен Саннодзи ғибадатханасының монахына менен сұрақ қою қиын болды?
Dialogue: 0,0:21:02.13,0:21:04.51,Default,,0,0,0,,Қансайдағы детектив десең, мен шығармын.
Dialogue: 0,0:21:04.59,0:21:06.55,Default,,0,0,0,,Аа, солай.
Dialogue: 0,0:21:06.64,0:21:09.30,Default,,0,0,0,,Сіз полицияның білгенін қаламадыңыз, солай ма?
Dialogue: 0,0:21:09.39,0:21:12.18,Default,,0,0,0,,Қарашы, сенің әкең үлкен полиция қызметкері екен.
Dialogue: 0,0:21:12.27,0:21:14.48,Default,,0,0,0,,Хмм…
Dialogue: 0,0:21:14.56,0:21:16.19,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:21:16.27,0:21:18.11,Default,,0,0,0,,Иә?Күте тұрыңыз
Dialogue: 0,0:21:18.19,0:21:20.02,Default,,0,0,0,,Енді сіз бұл туралы айтып отырсыз ...
Dialogue: 0,0:21:24.24,0:21:26.03,Default,,0,0,0,,Мұнда келді.
Dialogue: 0,0:21:29.37,0:21:31.54,Default,,0,0,0,,...
Dialogue: 0,0:21:31.62,0:21:34.75,Default,,0,0,0,,Беңкей отыратын тас.
Dialogue: 0,0:21:34.83,0:21:36.96,Default,,0,0,0,,Хией тауынан лақтырылған тас, т.б.
Dialogue: 0,0:21:37.04,0:21:39.63,Default,,0,0,0,,Әртүрлі салт-дәстүрлер бар сияқты.
Dialogue: 0,0:21:39.71,0:21:42.50,Default,,0,0,0,,Бұл жерде де маңызды емес сияқты.
Dialogue: 0,0:21:42.59,0:21:45.05,Default,,0,0,0,,көремін.
Dialogue: 0,0:21:45.13,0:21:46.55,Default,,0,0,0,,Келесі қайда?
Dialogue: 0,0:21:47.05,0:21:49.05,Default,,0,0,0,,Кедж еңісі
Dialogue: 0,0:21:49.55,0:21:50.39,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:50.47,0:21:53.22,Default,,0,0,0,,Бұл Киото префектуралық полициясының қызметкері Аянокодзи.
Dialogue: 0,0:21:53.31,0:21:57.10,Default,,0,0,0,,Олар Genji Firefly оқиғасы бойынша көп зерттеу жүргізіп жатқан сияқты.
Dialogue: 0,0:21:57.19,0:22:01.98,Default,,0,0,0,,Бұл Осакадан өзгеше. Әуесқойлар мойнын ілмейді.
Dialogue: 0,0:22:02.07,0:22:03.57,Default,,0,0,0,,（）
Dialogue: 0,0:22:03.65,0:22:04.48,Default,,0,0,0,,О...
Dialogue: 0,0:22:05.74,0:22:07.07,Default,,0,0,0,,(айқай)
Dialogue: 0,0:22:07.15,0:22:07.99,Default,,0,0,0,,Фу…
Dialogue: 0,0:22:08.07,0:22:10.99,Default,,0,0,0,,Хаха... Бурундучка...
Dialogue: 0,0:22:11.58,0:22:13.12,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:22:17.41,0:22:19.67,Default,,0,0,0,,Барлық жерде жаман детективтер бар.
Dialogue: 0,0:22:19.75,0:22:20.58,Default,,0,0,0,,О
Dialogue: 0,0:22:23.17,0:22:24.84,Default,,0,0,0,,Фотоға түсейік!
Dialogue: 0,0:22:24.92,0:22:26.72,Default,,0,0,0,,Шие гүлдерін фонда қолданайық
Dialogue: 0,0:22:26.80,0:22:28.38,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:22:28.47,0:22:31.64,Default,,0,0,0,,Әй, керемет көрініс...
Dialogue: 0,0:22:31.72,0:22:35.60,Default,,0,0,0,,Егер мен онымен Макотоны көрсем, мен өте бақытты болар едім!
Dialogue: 0,0:22:35.68,0:22:37.52,Default,,0,0,0,,...
Dialogue: 0,0:22:37.60,0:22:39.85,Default,,0,0,0,,Фуфуфуфуфу… кәдімгі жақсылық.
Dialogue: 0,0:22:39.94,0:22:41.77,Default,,0,0,0,,-（） -（）
Dialogue: 0,0:22:47.32,0:22:50.24,Default,,0,0,0,,Казуха-чан, Хаттори-кун екеуің ұрысып қалдыңдар ма?
Dialogue: 0,0:22:51.82,0:22:56.45,Default,,0,0,0,,Шындығында, Хэйдзи Киотоға белгілі бір оқиғаны тергеу үшін барды...
Dialogue: 0,0:22:56.54,0:22:59.87,Default,,0,0,0,,Сонымен қатар, Хэйдзидің алғашқы махаббаты Киотода.
Dialogue: 0,0:22:59.96,0:23:01.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:01.71,0:23:03.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:11.80,0:23:13.10,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:23:13.18,0:23:15.22,Default,,0,0,0,,Мен де бұл жерде сағынып жүрген сияқтымын.
Dialogue: 0,0:23:16.06,0:23:17.47,Default,,0,0,0,,Түскі ас ішеміз бе?
Dialogue: 0,0:23:17.56,0:23:18.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:27.69,0:23:29.11,Default,,0,0,0,,…
Dialogue: 0,0:23:29.19,0:23:30.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:30.11,0:23:34.24,Default,,0,0,0,,Жоқ, мен шие гүлдерін көрсем, мен оны үнемі еске аламын.
Dialogue: 0,0:23:34.32,0:23:36.16,Default,,0,0,0,,Шамамен 8 жыл бұрын
Dialogue: 0,0:23:36.91,0:23:42.67,Default,,0,0,0,,Мен Киотодағы ғибадатхананы зерттеп жүргенімде ғибадатхананың торлы терезесіне секірдім.
Dialogue: 0,0:23:43.33,0:23:45.67,Default,,0,0,0,,Тор сынған.
Dialogue: 0,0:23:46.38,0:23:50.67,Default,,0,0,0,,Басымды еденге соғып, ес-түссіз қалдым.
Dialogue: 0,0:23:51.76,0:23:54.64,Default,,0,0,0,,Қанша ұйықтағанымды білмеймін.
Dialogue: 0,0:23:54.72,0:23:56.39,Default,,0,0,0,,Мен кенет оянғанда...
Dialogue: 0,0:23:56.47,0:23:57.01,Default,,0,0,0,,♪ Haccho Егер естісеңіз
Dialogue: 0,0:23:57.01,0:23:58.06,Default,,0,0,0,,♪ Haccho Егер естісеңіз
Dialogue: 0,0:23:57.01,0:23:58.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:58.06,0:23:58.81,Default,,0,0,0,,♪ Haccho Егер естісеңіз
Dialogue: 0,0:23:58.89,0:23:59.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:58.89,0:23:59.93,Default,,0,0,0,,♪ Тоджимичи
Dialogue: 0,0:23:59.93,0:24:00.85,Default,,0,0,0,,♪ Тоджимичи
Dialogue: 0,0:24:00.85,0:24:01.14,Default,,0,0,0,,♪ Тоджимичи
Dialogue: 0,0:24:00.85,0:24:01.14,Default,,0,0,0,,Бұл... Ха...
Dialogue: 0,0:24:01.14,0:24:01.23,Default,,0,0,0,,Бұл...ха...
Dialogue: 0,0:24:01.23,0:24:02.48,Default,,0,0,0,,Бұл...ха...
Dialogue: 0,0:24:01.23,0:24:02.48,Default,,0,0,0,,♪ Куджужи де
Dialogue: 0,0:24:02.48,0:24:03.81,Default,,0,0,0,,♪ Куджо Оджи де
Dialogue: 0,0:24:03.90,0:24:05.81,Default,,0,0,0,,♪ аяқтаңыз
Dialogue: 0,0:24:06.52,0:24:06.90,Default,,0,0,0,,♪ Марутаке Эбисуни
Dialogue: 0,0:24:06.90,0:24:08.61,Default,,0,0,0,,♪ Марутаке Эбисуни
Dialogue: 0,0:24:06.90,0:24:08.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:08.69,0:24:11.70,Default,,0,0,0,,♪ Мені жазала
Dialogue: 0,0:24:11.78,0:24:14.32,Default,,0,0,0,,♪ Йомесан Роккаку
Dialogue: 0,0:24:14.41,0:24:16.62,Default,,0,0,0,,♪ Сегізаяқ
Dialogue: 0,0:24:17.24,0:24:19.62,Default,,0,0,0,,♪ Сіз ашуландыңыз ба?
Dialogue: 0,0:24:19.70,0:24:22.41,Default,,0,0,0,,♪ Мацумангоджо
Dialogue: 0,0:24:22.50,0:24:24.75,Default,,0,0,0,,♪ Сеттачара Чара
Dialogue: 0,0:24:24.83,0:24:26.46,Default,,0,0,0,,♪ Уонотана
Dialogue: 0,0:24:26.54,0:24:31.21,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:24:31.30,0:24:32.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:38.10,0:24:39.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:45.60,0:24:48.77,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:24:48.86,0:24:50.07,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:24:50.57,0:24:51.40,Default,,0,0,0,,Ха…
Dialogue: 0,0:24:56.03,0:24:58.95,Default,,0,0,0,,Бұл түс сияқты көрінеді, бірақ бұл шындық.
Dialogue: 0,0:25:01.45,0:25:04.21,Default,,0,0,0,,Бір күні тағы кездесеміз бе деп ойлаймын
Dialogue: 0,0:25:04.29,0:25:05.96,Default,,0,0,0,,…
Dialogue: 0,0:25:06.04,0:25:07.96,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:25:08.04,0:25:10.05,Default,,0,0,0,,Әй, сен несіне күлесің?
Dialogue: 0,0:25:10.13,0:25:13.80,Default,,0,0,0,,Фуфуфуфуфу... жаман нашар жалғасуда
Dialogue: 0,0:25:13.88,0:25:16.68,Default,,0,0,0,,Киотоға келгенде мен оны үнемі өзіммен бірге алып келемін.
Dialogue: 0,0:25:18.60,0:25:20.47,Default,,0,0,0,,Хрусталь шар?
Dialogue: 0,0:25:21.01,0:25:22.77,Default,,0,0,0,,Мен оны бір жерден көрген сияқтымын.
Dialogue: 0,0:25:23.35,0:25:26.10,Default,,0,0,0,,Шынымен бе? Біреуде бірдей бар ма?
Dialogue: 0,0:25:26.19,0:25:28.40,Default,,0,0,0,,Хмм... жоқ.
Dialogue: 0,0:25:28.90,0:25:31.98,Default,,0,0,0,,Сонымен? ол бұл туралы біледі ме?
Dialogue: 0,0:25:32.07,0:25:33.57,Default,,0,0,0,,Ол...
Dialogue: 0,0:25:33.65,0:25:35.45,Default,,0,0,0,,Ах~ Казуха Кайна
Dialogue: 0,0:25:36.15,0:25:39.66,Default,,0,0,0,,Мен сізге егжей-тегжейлі айта алмаймын, бірақ сіз білетін сияқтысыз.
Dialogue: 0,0:25:39.74,0:25:42.95,Default,,0,0,0,,Бұл туралы ол ең алдымен қайдан білді...
Dialogue: 0,0:25:43.58,0:25:45.62,Default,,0,0,0,,Журналдағы сұхбат мақаласы?
Dialogue: 0,0:25:45.71,0:25:49.79,Default,,0,0,0,,Иә, бұл Кансайдағы өте танымал ақпараттық журнал.
Dialogue: 0,0:25:49.88,0:25:53.46,Default,,0,0,0,,Бұл кітапта Хэйдзиден оның алғашқы махаббаты туралы сұралған.
Dialogue: 0,0:25:54.05,0:25:55.97,Default,,0,0,0,,«Мен сені бастауыш мектептің үшінші сыныбында оқып жүргенде кездестірдім».
Dialogue: 0,0:25:56.05,0:25:58.97,Default,,0,0,0,,«Сәл үлкенірек қыз» дедіңіз бе?
Dialogue: 0,0:25:59.59,0:26:02.97,Default,,0,0,0,,Оның үстіне сол қызға қатысты маңызды заттар бар.
Dialogue: 0,0:26:03.06,0:26:06.39,Default,,0,0,0,,Маған осылай суретке түсуге рұқсат бермедің!
Dialogue: 0,0:26:07.02,0:26:08.65,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:26:08.73,0:26:12.69,Default,,0,0,0,,Бұл жай ғана хрусталь шар. Ол әйелге ғашық боласыз ба?
Dialogue: 0,0:26:12.77,0:26:14.78,Default,,0,0,0,,Сосын Казуха-чан, сол бала туралы...
Dialogue: 0,0:26:14.86,0:26:17.03,Default,,0,0,0,,Сіз білуге ​​мүмкіндік жоқ.
Dialogue: 0,0:26:17.61,0:26:20.28,Default,,0,0,0,,Мен Хеджиді жалғыз көріп тұрған сияқтымын.
Dialogue: 0,0:26:20.37,0:26:23.16,Default,,0,0,0,,Киотоға келген сайын сені іздейтін сияқтымын.
Dialogue: 0,0:26:23.24,0:26:26.71,Default,,0,0,0,,Ах! Сондықтан мен хрусталь шарды суретке түсірдім...
Dialogue: 0,0:26:26.79,0:26:29.83,Default,,0,0,0,,Бұл мақаланы сол қыз оқитын шығар.
Dialogue: 0,0:26:29.92,0:26:32.84,Default,,0,0,0,,Сіз маған хабарласа аласыз деп ойладым...
Dialogue: 0,0:26:32.92,0:26:34.88,Default,,0,0,0,,Не? Бұл тентек
Dialogue: 0,0:26:34.96,0:26:36.09,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:26:36.17,0:26:39.18,Default,,0,0,0,,Не керек, мен тіпті сол кездегі суреттерді де енгіздім.
Dialogue: 0,0:26:40.01,0:26:41.68,Default,,0,0,0,,Әй, өте сүйкімді!
Dialogue: 0,0:26:41.76,0:26:45.14,Default,,0,0,0,,Дұрыс! Хэджи бүгінде сондай сүйкімді...
Dialogue: 0,0:26:45.22,0:26:46.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:46.39,0:26:49.35,Default,,0,0,0,,Ран-чан, менде бұл мәселе бар.
Dialogue: 0,0:26:49.44,0:26:52.23,Default,,0,0,0,,Бірақ алаңдайтын ештеңе жоқ, солай ма?
Dialogue: 0,0:26:52.31,0:26:55.03,Default,,0,0,0,,Хаттори-кунның алғашқы махаббаты болса да
Dialogue: 0,0:26:55.11,0:26:57.44,Default,,0,0,0,,Бұл бұрыннан келе жатқан адам.
Dialogue: 0,0:26:57.53,0:27:00.36,Default,,0,0,0,,Казуха-чан екеуміз қазір жақсы көреміз.
Dialogue: 0,0:27:00.45,0:27:05.41,Default,,0,0,0,,Бірақ, ер адам үшін алғашқы махаббат ерекше.
Dialogue: 0,0:27:05.49,0:27:06.37,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:27:06.45,0:27:07.50,Default,,0,0,0,,Соноко!
Dialogue: 0,0:27:07.58,0:27:08.62,Default,,0,0,0,,Бол...
Dialogue: 0,0:27:08.71,0:27:11.50,Default,,0,0,0,,Мен бұл азапты әңгімені аяқтадым!
Dialogue: 0,0:27:11.58,0:27:13.13,Default,,0,0,0,,Көбірек цензай жегіңіз келе ме?
Dialogue: 0,0:27:13.75,0:27:16.09,Default,,0,0,0,,Апай! 3 цензай
Dialogue: 0,0:27:16.17,0:27:18.34,Default,,0,0,0,,Өтінемін, асығыңыз!
Dialogue: 0,0:27:23.60,0:27:24.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:30.44,0:27:32.69,Default,,0,0,0,,Бұл Курама-дера храмының батыс қақпасы.
Dialogue: 0,0:27:32.77,0:27:36.02,Default,,0,0,0,,Әдетте сіз Niomon қақпасынан кіресіз.
Dialogue: 0,0:27:36.11,0:27:38.19,Default,,0,0,0,,Бұл жақсырақ төте жол.
Dialogue: 0,0:28:08.68,0:28:11.69,Default,,0,0,0,,Бұл монах Камигая Фудодо.
Dialogue: 0,0:28:11.77,0:28:16.52,Default,,0,0,0,,Ушивакамару осы жерде теңгемен кездесіп, әскери әдіс-тәсілдерді үйреткен дейді.
Dialogue: 0,0:28:18.36,0:28:22.65,Default,,0,0,0,,Бұл, әрине, қылыш үйрету үшін тамаша орын.
Dialogue: 0,0:28:23.99,0:28:27.91,Default,,0,0,0,,Қалай болғанда да, бұл балқарағай өте үлкен.
Dialogue: 0,0:28:32.00,0:28:34.46,Default,,0,0,0,,Хаттори: Бұл жерде де басқаша...
Dialogue: 0,0:28:34.54,0:28:35.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:35.54,0:28:37.09,Default,,0,0,0,,- Жат! -(Хедзи) А?
Dialogue: 0,0:28:37.17,0:28:38.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:28:41.72,0:28:43.05,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:28:43.13,0:28:44.47,Default,,0,0,0,,О... Әй, құда!
Dialogue: 0,0:28:51.68,0:28:52.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:28:54.19,0:28:55.19,Default,,0,0,0,,Әй!
Dialogue: 0,0:28:59.23,0:29:01.65,Default,,0,0,0,,Ол Ушивакамару сияқты.
Dialogue: 0,0:29:03.99,0:29:05.41,Default,,0,0,0,,Хаха...
Dialogue: 0,0:29:10.58,0:29:11.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:29:13.04,0:29:15.37,Default,,0,0,0,,Раxмет! Мінеки біз!
Dialogue: 0,0:29:33.18,0:29:34.60,Default,,0,0,0,,Ұстадым!
Dialogue: 0,0:29:44.28,0:29:46.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:46.15,0:29:47.20,Default,,0,0,0,,Әй!
Dialogue: 0,0:29:52.79,0:29:53.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:29:55.96,0:29:57.42,Default,,0,0,0,,Уфф...
Dialogue: 0,0:30:04.42,0:30:06.34,Default,,0,0,0,,Не болды!
Dialogue: 0,0:30:10.85,0:30:11.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:32.08,0:30:34.58,Default,,0,0,0,,Егер сіз отырғызып жатсаңыз, асығыңыз.
Dialogue: 0,0:30:34.66,0:30:35.91,Default,,0,0,0,,Жақында кетеді...
Dialogue: 0,0:30:36.00,0:30:37.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:37.37,0:30:40.38,Default,,0,0,0,,Жоқ, сонша асығыс болсаң да...
Dialogue: 0,0:30:46.01,0:30:48.22,Default,,0,0,0,,Әй, міне темір жол!
Dialogue: 0,0:30:48.30,0:30:50.55,Default,,0,0,0,,Сен мені алаңдатып отырсың, менімен сөйлеспе.
Dialogue: 0,0:30:50.64,0:30:54.31,Default,,0,0,0,,Хаха... Жол қозғалысы ережесін бұзғаны үшін лицензияны уақытша тоқтаттым.
Dialogue: 0,0:31:06.36,0:31:08.28,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:31:08.90,0:31:10.20,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:31:10.28,0:31:11.78,Default,,0,0,0,,- (Хедзи) Уау! -Уф!
Dialogue: 0,0:31:14.03,0:31:14.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:14.95,0:31:16.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:31:21.92,0:31:23.04,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:31:23.79,0:31:26.05,Default,,0,0,0,,Мен тағы біраз нәрсе істей алар едім...
Dialogue: 0,0:31:26.13,0:31:28.13,Default,,0,0,0,,Күтілгендей, ағымдағы
Dialogue: 0,0:31:28.21,0:31:31.43,Default,,0,0,0,,Гендзи Хотару мүшелерін өлтірген кінәлі осы әрекетті жасаған болуы керек.
Dialogue: 0,0:31:31.51,0:31:32.80,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:31:32.89,0:31:35.43,Default,,0,0,0,,Бірақ олардың сізді неге нысанаға алғанын түсінбеймін.
Dialogue: 0,0:31:43.48,0:31:45.19,Default,,0,0,0,,Иә? Хаттори-кун!
Dialogue: 0,0:31:45.27,0:31:46.27,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:31:47.40,0:31:49.40,Default,,0,0,0,,Жарайды, қаладағы кездейсоқтық, Кудо...
Dialogue: 0,0:31:49.49,0:31:51.78,Default,,0,0,0,,...Яноуте мен бұл монахпен кездесуге барамын.
Dialogue: 0,0:31:51.86,0:31:53.99,Default,,0,0,0,,Суреттің жұмбағын бірге шешейік.
Dialogue: 0,0:31:54.07,0:31:57.29,Default,,0,0,0,,Сонымен суреттің жұмбағын шештіңдер ме?
Dialogue: 0,0:31:57.37,0:32:00.00,Default,,0,0,0,,Бұл әлі де қиын.
Dialogue: 0,0:32:00.79,0:32:03.00,Default,,0,0,0,,Айтпақшы, сіз оны шештіңіз бе?
Dialogue: 0,0:32:03.67,0:32:05.17,Default,,0,0,0,,Бұл емес...
Dialogue: 0,0:32:05.25,0:32:06.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:07.75,0:32:12.68,Default,,0,0,0,,♪ Моямакура ни (шамисен орындау)
Dialogue: 0,0:32:12.76,0:32:17.89,Default,,0,0,0,,♪ Пловер өзені
Dialogue: 0,0:32:17.97,0:32:23.69,Default,,0,0,0,,♪ Гион
Dialogue: 0,0:32:23.77,0:32:29.65,Default,,0,0,0,,♪ Қойшия
Dialogue: 0,0:32:29.73,0:32:36.24,Default,,0,0,0,,♪ Жалқау
Dialogue: 0,0:32:36.32,0:32:42.71,Default,,0,0,0,,♪ Оби
Dialogue: 0,0:32:44.00,0:32:45.88,Default,,0,0,0,,Жоқ~
Dialogue: 0,0:32:56.26,0:32:57.93,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:32:58.01,0:33:00.85,Default,,0,0,0,,Иә! Сенга Сузу-чан Жапониядағы ең жақсы!
Dialogue: 0,0:33:00.93,0:33:04.31,Default,,0,0,0,,Оокини Одаруосу
Dialogue: 0,0:33:04.39,0:33:07.15,Default,,0,0,0,,Жүр, Мори мырзаға ішейік.
Dialogue: 0,0:33:07.23,0:33:08.36,Default,,0,0,0,,Иә
Dialogue: 0,0:33:13.61,0:33:15.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:15.66,0:33:18.78,Default,,0,0,0,,Ахаха... аа...
Dialogue: 0,0:33:19.49,0:33:20.58,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:33:20.66,0:33:22.50,Default,,0,0,0,,А, жоқ, жоқ, жоқ...
Dialogue: 0,0:33:23.33,0:33:26.54,Default,,0,0,0,,О, Когоро-чан, ол көкке көтерілетін сияқты!
Dialogue: 0,0:33:26.62,0:33:28.38,Default,,0,0,0,,Егер ол жай ғана көтерілсе ше?
Dialogue: 0,0:33:28.46,0:33:29.75,Default,,0,0,0,,- (Когоро) Бухи! -(Рюен) Аа...
Dialogue: 0,0:33:30.34,0:33:32.76,Default,,0,0,0,,Ой... балалар, неге...
Dialogue: 0,0:33:32.84,0:33:36.05,Default,,0,0,0,,Хехехехе, деді маған бас діни қызметкер.
Dialogue: 0,0:33:36.13,0:33:39.22,Default,,0,0,0,,Түсіндім, бас діни қызметкер...
Dialogue: 0,0:33:39.30,0:33:41.56,Default,,0,0,0,,Хона, бәріңіз, бізге қосылғыларыңыз келе ме?
Dialogue: 0,0:33:41.64,0:33:44.56,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:33:50.57,0:33:53.03,Default,,0,0,0,,Иә? Сіз Миягава қаласынан...
Dialogue: 0,0:33:53.11,0:33:57.74,Default,,0,0,0,,Эй, Сенга Сузу, бұл бөлім үлкен.
Dialogue: 0,0:33:58.78,0:34:00.45,Default,,0,0,0,,Бір-біріңді білесіңдер ме? Хэдзи
Dialogue: 0,0:34:00.53,0:34:02.37,Default,,0,0,0,,О, сәл ғана.
Dialogue: 0,0:34:02.45,0:34:05.46,Default,,0,0,0,,Қазірдің өзінде... Бір сәт көзіңді алсаң, мынау!
Dialogue: 0,0:34:05.54,0:34:09.46,Default,,0,0,0,,Ран-сан, өтінемін, әкеңе ұрыспа, оны жайына қалдыр.
Dialogue: 0,0:34:09.54,0:34:11.88,Default,,0,0,0,,Сізді шақырған біз болдық.
Dialogue: 0,0:34:11.96,0:34:17.63,Default,,0,0,0,,Ал, мен әйгілі детективтен Гендзи Firefly оқиғасын анықтауды сұраймын деп ойлаймын.
Dialogue: 0,0:34:17.72,0:34:19.68,Default,,0,0,0,,Гендзи Хотару Утара
Dialogue: 0,0:34:19.76,0:34:22.97,Default,,0,0,0,,Барлық мүшелер Гикейкидің көшірмесін алып жүреді деп үміттенемін.
Dialogue: 0,0:34:23.06,0:34:27.19,Default,,0,0,0,,Менде де бар, бірақ бұл кітап.
Dialogue: 0,0:34:27.27,0:34:28.31,Default,,0,0,0,,Сәлем? Қолданылған кітап дүкені
Dialogue: 0,0:34:28.39,0:34:32.98,Default,,0,0,0,,Иә... бірақ бұл маған ұнамайды.
Dialogue: 0,0:34:33.07,0:34:34.23,Default,,0,0,0,,«Гикейки» деп аталса да
Dialogue: 0,0:34:34.32,0:34:37.82,Default,,0,0,0,,Негізінде, бұл Бенкейдің қызметін бейнелейтін «Бенкей Ки».
Dialogue: 0,0:34:37.90,0:34:40.03,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:34:40.11,0:34:42.49,Default,,0,0,0,,Әсіресе «Атақаның» Беңкейі үздік
Dialogue: 0,0:34:42.58,0:34:44.49,Default,,0,0,0,,«Атака» дегеніміз не?
Dialogue: 0,0:34:44.58,0:34:47.08,Default,,0,0,0,,Но спектакльдерінің бірі
Dialogue: 0,0:34:47.16,0:34:53.00,Default,,0,0,0,,Йоритомоның қуғыншыларынан қашып бара жатып, Йосицүнэ және оның қызметшілері тау діни қызметкері болып жасырынған.
Dialogue: 0,0:34:53.09,0:34:55.34,Default,,0,0,0,,Мен Атака бекетінен өтпекшімін...
Dialogue: 0,0:34:55.42,0:34:59.30,Default,,0,0,0,,Тек Йосицүнэ ғана бетпердеден көре алатындай болды.
Dialogue: 0,0:34:59.97,0:35:03.81,Default,,0,0,0,,Бенкей Йосицүнэге бірден важра таяқшасымен ұрды.
Dialogue: 0,0:35:03.89,0:35:05.68,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:35:06.27,0:35:09.06,Default,,0,0,0,,Бақылау пунктіндегі күзетшіні алдау немесе
Dialogue: 0,0:35:09.14,0:35:11.90,Default,,0,0,0,,Мен қызметші қожайынына таяқпен ұрады деп ойламаппын.
Dialogue: 0,0:35:11.98,0:35:13.61,Default,,0,0,0,,Бұл мүмкін емес, солай ма?
Dialogue: 0,0:35:13.69,0:35:17.69,Default,,0,0,0,,Осылайша Йосицүнэ мен оның партиясы бақылау-өткізу пунктінен аман-есен өте алды.
Dialogue: 0,0:35:18.40,0:35:21.99,Default,,0,0,0,,Кейінірек Бенкей Ёсицүнэден көзіне жас алып кешірім сұрайды.
Dialogue: 0,0:35:22.07,0:35:25.74,Default,,0,0,0,,Керісінше, Йосицүнэ Бенкейдің ұшқыр тапқырлығын жоғары бағалайды.
Dialogue: 0,0:35:25.83,0:35:29.50,Default,,0,0,0,,Екеуінің арасындағы байланыстың тереңдігін көруге болады. Бұл жақсы әңгіме.
Dialogue: 0,0:35:32.17,0:35:35.67,Default,,0,0,0,,Аа, кешіріңіз, соңғы кездері ұйқым қанбай жүр.
Dialogue: 0,0:35:35.75,0:35:38.97,Default,,0,0,0,,Төменгі қабаттағы бөлмеде біраз демалсам, қарсы боласыз ба?
Dialogue: 0,0:35:39.05,0:35:42.97,Default,,0,0,0,,Осылай жасасаңыз, бүгін кешке басқа қонақтар болмайды.
Dialogue: 0,0:35:43.05,0:35:44.22,Default,,0,0,0,,Келесі бөлмеде...
Dialogue: 0,0:35:44.30,0:35:47.89,Default,,0,0,0,,Жарайды, бұл жерде тыныштық.
Dialogue: 0,0:35:47.97,0:35:51.23,Default,,0,0,0,,Эй, мен сені сағат 9-да оятсам бола ма?
Dialogue: 0,0:35:51.81,0:35:52.90,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:35:52.98,0:35:56.52,Default,,0,0,0,,Жарайсыңдар, бәрің ләззат алыңдар.
Dialogue: 0,0:36:02.45,0:36:04.82,Default,,0,0,0,,Уау, мен өзенді көріп тұрмын!
Dialogue: 0,0:36:04.91,0:36:06.03,Default,,0,0,0,,Камогава Досу
Dialogue: 0,0:36:06.66,0:36:08.16,Default,,0,0,0,,Шие гүлдері әдемі!
Dialogue: 0,0:36:08.24,0:36:10.33,Default,,0,0,0,,Аа, бұл рас.
Dialogue: 0,0:36:10.41,0:36:12.04,Default,,0,0,0,,Орхидея да келуі керек!
Dialogue: 0,0:36:12.87,0:36:14.25,Default,,0,0,0,,Камогава өзенінің жағасынан
Dialogue: 0,0:36:14.33,0:36:16.79,Default,,0,0,0,,Мен оны жұп ретінде көруге кеңес беремін.
Dialogue: 0,0:36:16.88,0:36:21.92,Default,,0,0,0,,Шие гүлдері осы ғимараттың астынан ағып жатқан Мисоги өзенінен көрінеді.
Dialogue: 0,0:36:22.01,0:36:23.76,Default,,0,0,0,,Сондай-ақ ерекше
Dialogue: 0,0:36:23.84,0:36:25.60,Default,,0,0,0,,Өте әдемі.
Dialogue: 0,0:36:25.68,0:36:27.76,Default,,0,0,0,,- (Когоро) Әй, әдемі екен - (Жүгіріп) Хм...
Dialogue: 0,0:36:27.85,0:36:32.10,Default,,0,0,0,,Саусақтар ақ балыққа ұқсайды! Мен оны жегім келеді
Dialogue: 0,0:36:32.19,0:36:33.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:33.81,0:36:35.02,Default,,0,0,0,,О, ә?
Dialogue: 0,0:36:35.65,0:36:37.27,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:36:37.36,0:36:39.53,Default,,0,0,0,,Эй, күте тұрыңыз...
Dialogue: 0,0:36:39.61,0:36:41.90,Default,,0,0,0,,Когоро-чан сені емдейді.
Dialogue: 0,0:36:41.99,0:36:43.53,Default,,0,0,0,,- (Жүгіріп) Уайымдама! - (Когоро) Түсіңіз!
Dialogue: 0,0:36:43.61,0:36:46.70,Default,,0,0,0,,Хахаха... Тәртіпке түсірме, әке.
Dialogue: 0,0:36:46.78,0:36:49.16,Default,,0,0,0,,Эй, мынаны қарашы.
Dialogue: 0,0:36:49.24,0:36:50.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:51.50,0:36:53.12,Default,,0,0,0,,Инспектор Аянокодзи...
Dialogue: 0,0:36:53.21,0:36:55.46,Default,,0,0,0,,Ондай жерде не істеп жүрсің?
Dialogue: 0,0:36:55.54,0:37:00.09,Default,,0,0,0,,Балалар, түнде неге төменгі қабаттағы балконға барып, шие гүлдерін көрмейсіңдер?
Dialogue: 0,0:37:00.17,0:37:03.80,Default,,0,0,0,,Жақында бүгін түнде бұлт шығып, ай көрінетін сияқты.
Dialogue: 0,0:37:04.59,0:37:05.43,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:37:05.51,0:37:06.93,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:37:07.01,0:37:09.01,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:37:09.10,0:37:09.93,Default,,0,0,0,,Мен де
Dialogue: 0,0:37:10.01,0:37:13.43,Default,,0,0,0,,Неліктен? Сізге бұл майко не ұнайды?
Dialogue: 0,0:37:13.52,0:37:16.06,Default,,0,0,0,,Идиот... Ондай бос сөз айтпа.
Dialogue: 0,0:37:16.15,0:37:17.23,Default,,0,0,0,,Хмм…
Dialogue: 0,0:37:18.23,0:37:19.90,Default,,0,0,0,,♪ Конпира Дайгонген
Dialogue: 0,0:37:19.98,0:37:21.44,Default,,0,0,0,,♪ Бір бұрылсаңыз
Dialogue: 0,0:37:21.53,0:37:22.69,Default,,0,0,0,,Эй!
Dialogue: 0,0:37:21.53,0:37:22.69,Default,,0,0,0,,♪ Конпира кемелері
Dialogue: 0,0:37:22.69,0:37:22.78,Default,,0,0,0,,♪ Конпира кемелері
Dialogue: 0,0:37:22.78,0:37:23.78,Default,,0,0,0,,♪ Конпира кемелері
Dialogue: 0,0:37:22.78,0:37:23.78,Default,,0,0,0,,Жақсы! бұл!
Dialogue: 0,0:37:23.78,0:37:23.86,Default,,0,0,0,,Жақсы! бұл!
Dialogue: 0,0:37:23.86,0:37:24.65,Default,,0,0,0,,Жақсы! бұл!
Dialogue: 0,0:37:23.86,0:37:24.65,Default,,0,0,0,,♪ Артқы желге жүзіңіз
Dialogue: 0,0:37:24.65,0:37:24.74,Default,,0,0,0,,♪ Артқы желге жүзіңіз
Dialogue: 0,0:37:24.74,0:37:25.86,Default,,0,0,0,,♪ Артқы желге жүзіңіз
Dialogue: 0,0:37:24.74,0:37:25.86,Default,,0,0,0,,Ура! қабырға!
Dialogue: 0,0:37:25.86,0:37:25.95,Default,,0,0,0,,Ура! қабырға!
Dialogue: 0,0:37:25.95,0:37:26.99,Default,,0,0,0,,Ура! қабырға!
Dialogue: 0,0:37:25.95,0:37:26.99,Default,,0,0,0,,♪ Шурашушу
Dialogue: 0,0:37:26.99,0:37:27.07,Default,,0,0,0,,♪ Шурашушушу
Dialogue: 0,0:37:27.07,0:37:28.20,Default,,0,0,0,,♪ Шурашушу
Dialogue: 0,0:37:27.07,0:37:28.20,Default,,0,0,0,,Ура! Ача~ кетті!
Dialogue: 0,0:37:28.20,0:37:29.16,Default,,0,0,0,,Ура! Ача~ кетті!
Dialogue: 0,0:37:29.24,0:37:31.95,Default,,0,0,0,,Қозғалтқыш толық газда, әлгі жігіт
Dialogue: 0,0:37:32.04,0:37:33.96,Default,,0,0,0,,Әрқашан ашық
Dialogue: 0,0:37:34.04,0:37:36.96,Default,,0,0,0,,Сенга Сузу-чан Кек алу!
Dialogue: 0,0:37:37.04,0:37:38.83,Default,,0,0,0,,- (Сайджо) Мен де ваннадамын - (Сенга Сузу) Аа...
Dialogue: 0,0:37:38.92,0:37:41.67,Default,,0,0,0,,Жарайды, мен әлі маспын.
Dialogue: 0,0:37:41.75,0:37:43.09,Default,,0,0,0,,Сіз, Моури мырза
Dialogue: 0,0:37:43.17,0:37:44.13,Default,,0,0,0,,Иә
Dialogue: 0,0:37:44.22,0:37:46.34,Default,,0,0,0,,Әй, кеттік!
Dialogue: 0,0:37:46.43,0:37:47.43,Default,,0,0,0,,Эй!
Dialogue: 0,0:37:47.51,0:37:49.55,Default,,0,0,0,,- (Рюен) Ой, ай шықты - (Когоро) Жақсы! бұл!
Dialogue: 0,0:37:49.64,0:37:52.68,Default,,0,0,0,,Ура! қабырға! Эй!
Dialogue: 0,0:37:52.77,0:37:53.89,Default,,0,0,0,,Фу…
Dialogue: 0,0:37:54.81,0:37:55.98,Default,,0,0,0,,Ай?
Dialogue: 0,0:37:56.06,0:37:58.02,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:37:58.10,0:38:01.44,Default,,0,0,0,,Жоқ, мен Ранмен бұрын кездескен кезім туралы.
Dialogue: 0,0:38:01.52,0:38:03.28,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:38:03.36,0:38:07.45,Default,,0,0,0,,Кездесуді есіме түсіргенде, мен екі сағатқа кешігіп қалдым.
Dialogue: 0,0:38:07.53,0:38:08.78,Default,,0,0,0,,Сора, бұл қиын.
Dialogue: 0,0:38:09.57,0:38:13.12,Default,,0,0,0,,Мен де бұдан былай күтудің қажеті жоқ деп ойладым.
Dialogue: 0,0:38:13.20,0:38:16.08,Default,,0,0,0,,Әйтеуір, кездесу орнына бардым...
Dialogue: 0,0:38:19.13,0:38:22.21,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:38:26.72,0:38:27.55,Default,,0,0,0,,Who?
Dialogue: 0,0:38:27.63,0:38:30.22,Default,,0,0,0,,Хаха...
Dialogue: 0,0:38:30.30,0:38:33.22,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:38:33.89,0:38:36.81,Default,,0,0,0,,Нашар жүгіру! Шын мәнінде, мен толығымен...
Dialogue: 0,0:38:37.48,0:38:38.94,Default,,0,0,0,,Жақсы
Dialogue: 0,0:38:39.02,0:38:41.11,Default,,0,0,0,,Шиничиге бірдеңе болған болуы керек.
Dialogue: 0,0:38:41.19,0:38:42.40,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:38:43.44,0:38:44.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:48.74,0:38:50.45,Default,,0,0,0,,Бұл уақыт емес пе?
Dialogue: 0,0:38:50.53,0:38:53.12,Default,,0,0,0,,Мен ол қызды бала күнгі досым деп ойладым.
Dialogue: 0,0:38:53.20,0:38:54.54,Default,,0,0,0,,Не өзгерді?
Dialogue: 0,0:38:54.62,0:38:57.54,Default,,0,0,0,,Бар... Барлоу! Мүмкін емес.
Dialogue: 0,0:38:59.37,0:39:02.13,Default,,0,0,0,,Мен ол туралы бұрыннан білемін...
Dialogue: 0,0:39:03.79,0:39:07.72,Default,,0,0,0,,Ол мені әлі күтіп отыр, солай ма?
Dialogue: 0,0:39:08.63,0:39:09.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:09.68,0:39:11.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:11.18,0:39:13.10,Default,,0,0,0,,Не болды? Ран-чан
Dialogue: 0,0:39:13.18,0:39:15.39,Default,,0,0,0,,Барабан ырғағымен бірге қозғалып, ол жыртқыш жануардың тырнақ іздерінің пішінін алды.
Dialogue: 0,0:39:17.77,0:39:20.60,Default,,0,0,0,,Хеджидің жігіті мені қатты ашуландырды!
Dialogue: 0,0:39:20.69,0:39:23.69,Default,,0,0,0,,Бірақ мен Казуха-чанды қызғанамын.
Dialogue: 0,0:39:23.77,0:39:24.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:24.69,0:39:28.61,Default,,0,0,0,,Өйткені мен сені қалаған кезде кездестіре аламын.
Dialogue: 0,0:39:30.07,0:39:31.61,Default,,0,0,0,,Ран-чан...
Dialogue: 0,0:39:31.70,0:39:33.32,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:39:33.41,0:39:36.74,Default,,0,0,0,,Мен де Макотомен жиі кездесе бермеймін.
Dialogue: 0,0:39:36.83,0:39:39.41,Default,,0,0,0,,Қыздың қиындығы бітпейді.
Dialogue: 0,0:39:39.50,0:39:40.33,Default,,0,0,0,,Кеттік! Барайық!
Dialogue: 0,0:39:40.41,0:39:44.92,Default,,0,0,0,,Онымен салыстырғанда көңіл-күйіңіз жақсы емес пе?
Dialogue: 0,0:39:45.59,0:39:46.34,Default,,0,0,0,,♪ Торатора Торатора
Dialogue: 0,0:39:46.34,0:39:47.42,Default,,0,0,0,,♪ Торатора Торатора
Dialogue: 0,0:39:46.34,0:39:47.42,Default,,0,0,0,,Hmph...
Dialogue: 0,0:39:47.42,0:39:47.51,Default,,0,0,0,,♪ Торатора Торатора
Dialogue: 0,0:39:47.51,0:39:48.71,Default,,0,0,0,,♪ Торатора Торатора
Dialogue: 0,0:39:47.51,0:39:48.71,Default,,0,0,0,,Гао!
Dialogue: 0,0:39:48.80,0:39:49.67,Default,,0,0,0,,Уау, мен жеңілдім!
Dialogue: 0,0:39:49.76,0:39:53.47,Default,,0,0,0,,Мен тағы жеңілдім. Сен мықтысың, шынымен!
Dialogue: 0,0:39:58.93,0:39:59.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:00.77,0:40:01.94,Default,,0,0,0,,О...
Dialogue: 0,0:40:12.15,0:40:14.53,Default,,0,0,0,,Сакура-хан, сағат 9.
Dialogue: 0,0:40:14.62,0:40:16.33,Default,,0,0,0,,Сакурахан?
Dialogue: 0,0:40:16.83,0:40:18.41,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:40:18.49,0:40:21.71,Default,,0,0,0,,О? Қайда бардың?
Dialogue: 0,0:40:25.75,0:40:27.50,Default,,0,0,0,,Мен сенбеймін
Dialogue: 0,0:40:36.35,0:40:37.56,Default,,0,0,0,,Сакурахан?
Dialogue: 0,0:40:42.27,0:40:43.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:40:44.23,0:40:45.73,Default,,0,0,0,,Иә? Ха…
Dialogue: 0,0:40:45.81,0:40:46.98,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:40:47.06,0:40:49.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:40:49.73,0:40:51.15,Default,,0,0,0,,Не? қазір айқайлаңыз
Dialogue: 0,0:40:51.24,0:40:53.11,Default,,0,0,0,,Айтпасаң да түсінікті — өзің көресің
Dialogue: 0,0:40:54.91,0:40:57.07,Default,,0,0,0,,- (Үй иесі) Ух... - (Когоро) Не болды?
Dialogue: 0,0:40:57.16,0:40:59.12,Default,,0,0,0,,Са… Сакура Ханга!
Dialogue: 0,0:40:59.20,0:41:00.91,Default,,0,0,0,,- (Хедзи/Когоро) Ах! -Ха...
Dialogue: 0,0:41:03.04,0:41:04.92,Default,,0,0,0,,Ал... Сакура-сан!
Dialogue: 0,0:41:05.50,0:41:07.42,Default,,0,0,0,,Ішке ешкімді кіргізбе!
Dialogue: 0,0:41:07.50,0:41:09.04,Default,,0,0,0,,Жүгіріп кетті Полиция шақырыңыз!
Dialogue: 0,0:41:09.71,0:41:10.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:41:11.55,0:41:14.97,Default,,0,0,0,,Ұйқы артериясы өткір пышақпен кесілген
Dialogue: 0,0:41:15.05,0:41:20.10,Default,,0,0,0,,Бұған қараудың тамаша тәсілі, бұл оқиғалар сериясында дәл сол кінәлі болуы мүмкін.
Dialogue: 0,0:41:20.18,0:41:23.31,Default,,0,0,0,,Сен, мен бір жерден көрген жүзді ойладым...
Dialogue: 0,0:41:23.39,0:41:25.81,Default,,0,0,0,,Орта мектептің детективі Хэйдзи Хаттори?
Dialogue: 0,0:41:26.40,0:41:27.40,Default,,0,0,0,,Иә.
Dialogue: 0,0:41:27.48,0:41:31.69,Default,,0,0,0,,Полицейлер келгенше бөлмеңізде қалуыңызға болады ма?
Dialogue: 0,0:41:31.78,0:41:33.82,Default,,0,0,0,,Ешқашан далаға шықпаңыз
Dialogue: 0,0:41:35.24,0:41:36.82,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:41:39.91,0:41:41.49,Default,,0,0,0,,Сакура мырза
Dialogue: 0,0:41:41.58,0:41:45.87,Default,,0,0,0,,Ол шкафты ақтарып жүріп өлтірілген сияқты.
Dialogue: 0,0:41:45.96,0:41:47.54,Default,,0,0,0,,Жерде не...
Dialogue: 0,0:41:49.17,0:41:51.59,Default,,0,0,0,,Сіздің күртеңіздің түймесі үзіліп қалды.
Dialogue: 0,0:41:52.21,0:41:53.26,Default,,0,0,0,,О
Dialogue: 0,0:41:53.34,0:41:56.59,Default,,0,0,0,,Оны қолғап киген қолдармен шешу азап болса керек.
Dialogue: 0,0:41:56.68,0:42:00.05,Default,,0,0,0,,Вексельдерге толы әмиян қауіпсіз.
Dialogue: 0,0:42:00.64,0:42:02.51,Default,,0,0,0,,Бұл мүлікті ұрлау қылмысы емес.
Dialogue: 0,0:42:03.56,0:42:04.39,Default,,0,0,0,,Уф!
Dialogue: 0,0:42:04.48,0:42:06.52,Default,,0,0,0,,Мәйіттерге қол тигізбеңіз!
Dialogue: 0,0:42:06.60,0:42:08.02,Default,,0,0,0,,Түсінгенше мен неше рет айтуым керек?
Dialogue: 0,0:42:08.10,0:42:08.94,Default,,0,0,0,,Уф!
Dialogue: 0,0:42:09.02,0:42:10.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:10.27,0:42:11.77,Default,,0,0,0,,Өте~!
Dialogue: 0,0:42:11.86,0:42:13.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:15.57,0:42:16.78,Default,,0,0,0,,Иә
Dialogue: 0,0:42:16.86,0:42:18.91,Default,,0,0,0,,Бұл Киото префектуралық полициясының қызметкері Аянокодзи.
Dialogue: 0,0:42:18.99,0:42:21.08,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:42:21.16,0:42:21.99,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:42:22.87,0:42:23.79,Default,,0,0,0,,Сіз алдыңғы жаққа қарайсыз
Dialogue: 0,0:42:23.87,0:42:24.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:42:27.29,0:42:31.59,Default,,0,0,0,,Сәлеметсіз бе, мен Киото префектуралық полициясының детективімін. Сәлем, сіз осындасыз.
Dialogue: 0,0:42:34.17,0:42:36.17,Default,,0,0,0,,Эй, бүгін бурундуки туралы не деуге болады?
Dialogue: 0,0:42:37.63,0:42:40.47,Default,,0,0,0,,Мен сені үнемі өзіммен бірге ала алмаймын.
Dialogue: 0,0:42:41.18,0:42:44.47,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл сырттан келген кінәлі деп ойлайсыз ба?
Dialogue: 0,0:42:44.56,0:42:45.93,Default,,0,0,0,,Нөл деп айта алмаймын, бірақ
Dialogue: 0,0:42:46.68,0:42:50.60,Default,,0,0,0,,Алдыңғы жылжымалы есікті ашқан кезде дыбыс шығады, оны үй иесі байқайды.
Dialogue: 0,0:42:50.69,0:42:53.61,Default,,0,0,0,,Одан гөрі кінәлі Сакура-сан.
Dialogue: 0,0:42:53.69,0:42:57.61,Default,,0,0,0,,Қандай да бір себептермен қоймада екенін білген адам
Dialogue: 0,0:42:57.70,0:42:58.78,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:42:58.86,0:43:00.20,Default,,0,0,0,,Сакура мырзаның танысы—
Dialogue: 0,0:43:00.28,0:43:05.62,Default,,0,0,0,,Сайджо мырзаның, Рюэн мырзаның және Мизуо мырзаның ықтималдығы жоғары.
Dialogue: 0,0:43:06.58,0:43:10.46,Default,,0,0,0,,Үшеуі кеткен соң Сакура-сан, Ран және басқалары.
Dialogue: 0,0:43:10.54,0:43:12.29,Default,,0,0,0,,Дәретханада бір рет тұру
Dialogue: 0,0:43:12.38,0:43:16.42,Default,,0,0,0,,Оның үстіне жақын жерде жертөлеге баспалдақтар бар.
Dialogue: 0,0:43:16.51,0:43:19.80,Default,,0,0,0,,Үшеуміз жуынатын бөлмеге барғандай кейіп таныттық.
Dialogue: 0,0:43:19.88,0:43:23.97,Default,,0,0,0,,Шкафта тұрған Сакура-санды өлтіруге болатын еді.
Dialogue: 0,0:43:26.52,0:43:28.68,Default,,0,0,0,,Мені алаңдататын жалғыз нәрсе
Dialogue: 0,0:43:28.77,0:43:32.81,Default,,0,0,0,,Мидзуо мырза жуынатын бөлмеге барғанда, Сузу Сенга оның артынан ерді.
Dialogue: 0,0:43:32.90,0:43:36.98,Default,,0,0,0,,Ах... барлық майколар солай істейтін сияқты.
Dialogue: 0,0:43:37.07,0:43:41.11,Default,,0,0,0,,Бірақ мен Рюэн-сан мен Сайджо-санмен бара алмадым.
Dialogue: 0,0:43:41.20,0:43:44.20,Default,,0,0,0,,Себебі мен ағаммен ойын ойнадым.
Dialogue: 0,0:43:44.28,0:43:48.33,Default,,0,0,0,,Екінші жағынан, ол дәл сол сәтті дәретханада тұруды мақсат еткен шығар.
Dialogue: 0,0:43:48.41,0:43:52.37,Default,,0,0,0,,Чукотаға келсек, Рюэн-сан немесе Сайджо-сан кінәлі.
Dialogue: 0,0:43:52.46,0:43:53.96,Default,,0,0,0,,Мизуо Широ мырза ма?
Dialogue: 0,0:43:54.04,0:43:56.55,Default,,0,0,0,,Чига Сузу сыбайлас болмаса.
Dialogue: 0,0:43:56.63,0:43:57.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:58.05,0:44:00.34,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:44:00.84,0:44:01.68,Default,,0,0,0,,Хона кеттік
Dialogue: 0,0:44:01.76,0:44:02.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:02.72,0:44:05.05,Default,,0,0,0,,Ақыл-есіңді жоғалтсаң, жарайды
Dialogue: 0,0:44:05.14,0:44:08.02,Default,,0,0,0,,Сондықтан Сакураның күртешесін іздедіңіз ғой, солай ма?
Dialogue: 0,0:44:08.10,0:44:09.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:09.43,0:44:10.64,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:44:11.19,0:44:15.02,Default,,0,0,0,,Сакура-санның дүкені Терамачи көшесінде болған деп ойлаймын.
Dialogue: 0,0:44:19.61,0:44:20.69,Default,,0,0,0,,Ал...
Dialogue: 0,0:44:23.41,0:44:24.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:26.53,0:44:28.04,Default,,0,0,0,,«Гикейки»
Dialogue: 0,0:44:29.16,0:44:31.79,Default,,0,0,0,,А... «Исесабуро»?
Dialogue: 0,0:44:31.87,0:44:32.75,Default,,0,0,0,,Хаттори!
Dialogue: 0,0:44:32.83,0:44:33.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:35.88,0:44:38.05,Default,,0,0,0,,Ха... не!
Dialogue: 0,0:44:38.13,0:44:40.96,Default,,0,0,0,,Сакура-сан Сабуро Исені ойнады ма?
Dialogue: 0,0:44:41.05,0:44:43.59,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:44:43.68,0:44:45.39,Default,,0,0,0,,А, бұл!
Dialogue: 0,0:44:45.47,0:44:47.39,Default,,0,0,0,,Сурет үлгісінің көшірмесі
Dialogue: 0,0:44:47.47,0:44:49.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:44:49.22,0:44:52.64,Default,,0,0,0,,Сакура-санда бұл сурет бар екені...
Dialogue: 0,0:44:52.73,0:44:56.40,Default,,0,0,0,,Сол хатты Саннодзи храмына жеткізген Сакура-сан екені белгілі болды.
Dialogue: 0,0:44:57.52,0:45:00.19,Default,,0,0,0,,Бірақ қандай мақсатта...
Dialogue: 0,0:45:00.82,0:45:03.90,Default,,0,0,0,,Не? Сакура-сан Исесабуро ма?
Dialogue: 0,0:45:03.99,0:45:07.91,Default,,0,0,0,,А, бұл адам Гендзи Хотарудың мүшесі болды.
Dialogue: 0,0:45:07.99,0:45:12.08,Default,,0,0,0,,Күте тұрыңыз, бұл өлтірілген ...
Dialogue: 0,0:45:12.16,0:45:16.08,Default,,0,0,0,,Жоқ, келесіде мен жетіспейтін боламын...
Dialogue: 0,0:45:16.63,0:45:17.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:17.96,0:45:20.42,Default,,0,0,0,,Бұл бұрын болған, солай ма?
Dialogue: 0,0:45:20.50,0:45:25.22,Default,,0,0,0,,Эй, бұл Сакура-санның үйіндегі суреттің көшірме болғанын білдіре ме?
Dialogue: 0,0:45:25.30,0:45:27.80,Default,,0,0,0,,Нағызды Сакура-сан алып жүреді.
Dialogue: 0,0:45:27.89,0:45:30.22,Default,,0,0,0,,Қылмыскер алған жоқ па?
Dialogue: 0,0:45:30.31,0:45:31.72,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:45:31.81,0:45:34.31,Default,,0,0,0,,Кінәлі Сакура мырзаның суретті көшіріп алғанын білмеді.
Dialogue: 0,0:45:34.39,0:45:36.19,Default,,0,0,0,,Мен олай ойламадым.
Dialogue: 0,0:45:36.27,0:45:38.86,Default,,0,0,0,,Сонда кінәлі кім?
Dialogue: 0,0:45:39.57,0:45:44.86,Default,,0,0,0,,Менің ойымша, бұл Рюэн-сан, Сайджо-сан, Мидзуо-сан немесе Сенга Сузу-сан.
Dialogue: 0,0:45:44.95,0:45:46.32,Default,,0,0,0,,Не!
Dialogue: 0,0:45:46.41,0:45:49.41,Default,,0,0,0,,Бірақ ешкімде қару болған жоқ.
Dialogue: 0,0:45:49.49,0:45:53.58,Default,,0,0,0,,Балалар сендер шыққаннан кейін іздестірілді.
Dialogue: 0,0:45:53.66,0:45:58.38,Default,,0,0,0,,Ешбір ақымақ біреуді өлтіргеннен кейін қару ұстамас еді.
Dialogue: 0,0:45:58.46,0:46:00.71,Default,,0,0,0,,Сіз оны лақтырдыңыз ба, әлде бір жерге жасырдыңыз ба?
Dialogue: 0,0:46:00.79,0:46:04.21,Default,,0,0,0,,Бірақ дүкеннен табылған жоқ деп ойлаймын.
Dialogue: 0,0:46:04.30,0:46:06.18,Default,,0,0,0,,Мисоги өзені туралы не деуге болады?
Dialogue: 0,0:46:06.26,0:46:09.60,Default,,0,0,0,,Сіз оны жертөле дәлізінің аяғындағы әйнек терезеден лақтырған жоқсыз ба?
Dialogue: 0,0:46:09.68,0:46:12.72,Default,,0,0,0,,Дашо! Мен де солай ойладым.
Dialogue: 0,0:46:12.81,0:46:13.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:13.97,0:46:15.48,Default,,0,0,0,,Соноко
Dialogue: 0,0:46:15.56,0:46:19.02,Default,,0,0,0,,Олар Мисоги өзеніне құлаған нәрсенің дыбысын естідік дейді.
Dialogue: 0,0:46:19.10,0:46:19.98,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:46:20.06,0:46:21.40,Default,,0,0,0,,Күмән жоқ.
Dialogue: 0,0:46:21.48,0:46:27.65,Default,,0,0,0,,Бірақ полиция өзенді тінтіп, ештеңе таппады.
Dialogue: 0,0:46:27.74,0:46:29.78,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:46:29.87,0:46:32.20,Default,,0,0,0,,Егер сіз мұны істесеңіз, сіз сыбайлас боласыз.
Dialogue: 0,0:46:32.28,0:46:35.79,Default,,0,0,0,,Сыртта өзеннен кісі өлтіру қаруын алған сыбайласы болды.
Dialogue: 0,0:46:35.87,0:46:37.41,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:46:37.50,0:46:38.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:38.42,0:46:39.58,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:46:39.67,0:46:41.79,Default,,0,0,0,,Януте Ко… Конан-кун
Dialogue: 0,0:46:41.88,0:46:44.80,Default,,0,0,0,,Толық аймен бүгін түн жарық болды, солай ма?
Dialogue: 0,0:46:45.46,0:46:49.84,Default,,0,0,0,,Бұл балконның еденінде саңылау бар, сонда астында не жатқанын көруге болады.
Dialogue: 0,0:46:49.93,0:46:52.72,Default,,0,0,0,,Мисоги өзенінің сыбайласы болса ше?
Dialogue: 0,0:46:52.80,0:46:55.22,Default,,0,0,0,,Ранни мен басқалары байқайтынына сенімдімін.
Dialogue: 0,0:46:55.31,0:46:57.56,Default,,0,0,0,,Хмм... Түсінемін.
Dialogue: 0,0:46:57.64,0:46:59.35,Default,,0,0,0,,- (Когоро) Бұл шындық - иә?
Dialogue: 0,0:46:59.44,0:47:03.86,Default,,0,0,0,,Кінәлі сырттан келген, Ран мен басқалары балконға шыққанға дейін...
Dialogue: 0,0:47:03.94,0:47:06.36,Default,,0,0,0,,Жертөледегі шыны терезе арқылы кіру
Dialogue: 0,0:47:06.94,0:47:09.74,Default,,0,0,0,,Жуынатын бөлмеге тығылып, мені күт
Dialogue: 0,0:47:09.82,0:47:14.03,Default,,0,0,0,,Сакура мырза келіп, қойманы тінту кезінде оны өлтірді.
Dialogue: 0,0:47:14.12,0:47:18.87,Default,,0,0,0,,Ол кісі өлтіру қаруын ұстап тұрып, шыны терезеден қашып кетті.
Dialogue: 0,0:47:18.96,0:47:22.21,Default,,0,0,0,,Бірақ біз оны да көрмедік.
Dialogue: 0,0:47:22.29,0:47:25.17,Default,,0,0,0,,Жағалауда куәгерлер болған жоқ, солай ма?
Dialogue: 0,0:47:25.25,0:47:28.88,Default,,0,0,0,,Сәйкестік Кездейсоқ, кінәлі твиттер жазды.
Dialogue: 0,0:47:28.97,0:47:32.68,Default,,0,0,0,,Хмм... бірдеңе мағынасы жоқ.
Dialogue: 0,0:47:59.58,0:48:01.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:48:04.13,0:48:06.17,Default,,0,0,0,,Сол Курама тауындағы жігіт...
Dialogue: 0,0:48:19.43,0:48:21.44,Default,,0,0,0,,Казуханың қолын жіберме!
Dialogue: 0,0:48:21.52,0:48:22.35,Default,,0,0,0,,Не?
Dialogue: 0,0:48:22.44,0:48:23.27,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:48:23.35,0:48:25.44,Default,,0,0,0,,Кя!
Dialogue: 0,0:48:26.94,0:48:28.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:35.53,0:48:37.16,Default,,0,0,0,,Сіз осындасыз, солай ма?
Dialogue: 0,0:48:37.24,0:48:38.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:38.54,0:48:39.37,Default,,0,0,0,,Хэйдзи!
Dialogue: 0,0:48:56.55,0:48:59.10,Default,,0,0,0,,Хмф... Сіз менімен жарысуды жоспарлап отырсыз ба?
Dialogue: 0,0:48:59.18,0:49:00.10,Default,,0,0,0,,Иә.
Dialogue: 0,0:49:00.18,0:49:01.60,Default,,0,0,0,,(Ағаш қылыштың дыбысы)
Dialogue: 0,0:49:04.19,0:49:06.44,Default,,0,0,0,,Иә? Не? Көптеген олқылықтар бар
Dialogue: 0,0:49:06.52,0:49:08.11,Default,,0,0,0,,Бұл тек алдын алу тексерісі ғана
Dialogue: 0,0:49:09.23,0:49:10.65,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:49:11.23,0:49:12.32,Default,,0,0,0,,Сіз қолаяқ киіп жүрсіз бе?
Dialogue: 0,0:49:12.40,0:49:13.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:13.57,0:49:14.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:14.61,0:49:16.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:16.20,0:49:17.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:49:18.74,0:49:19.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:49:19.79,0:49:21.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:23.41,0:49:25.42,Default,,0,0,0,,Ой! Незуко қайда?
Dialogue: 0,0:49:26.42,0:49:27.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:28.54,0:49:32.84,Default,,0,0,0,,А... Сакураны өлтірген сен кінәлісің бе?
Dialogue: 0,0:49:32.92,0:49:36.34,Default,,0,0,0,,Егер солай істесең, осы жерден де дәл осылай кес!
Dialogue: 0,0:49:41.43,0:49:42.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:51.19,0:49:52.44,Default,,0,0,0,,Уф!
Dialogue: 0,0:49:52.53,0:49:53.36,Default,,0,0,0,,Әй!
Dialogue: 0,0:49:56.86,0:49:57.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:49:59.87,0:50:01.49,Default,,0,0,0,,Хмм... уф...
Dialogue: 0,0:50:04.54,0:50:05.71,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,0:50:10.50,0:50:12.13,Default,,0,0,0,,Бұл сіз қалаған нәрсе емес.
Dialogue: 0,0:50:12.21,0:50:13.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:14.42,0:50:16.51,Default,,0,0,0,,Менің көзім біртүрлі...
Dialogue: 0,0:50:16.59,0:50:17.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:50:18.59,0:50:20.01,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:50:20.10,0:50:22.85,Default,,0,0,0,,Ой! Ау!
Dialogue: 0,0:50:23.43,0:50:24.39,Default,,0,0,0,,Әй!
Dialogue: 0,0:50:25.35,0:50:26.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:50:28.65,0:50:31.23,Default,,0,0,0,,Детектив-сан, міне, міне!
Dialogue: 0,0:50:39.41,0:50:41.45,Default,,0,0,0,,Хэйдзи, жақсысың ба?
Dialogue: 0,0:50:41.53,0:50:43.91,Default,,0,0,0,,Казуха... Детектив ше?
Dialogue: 0,0:50:43.99,0:50:46.25,Default,,0,0,0,,Бұл сөзсіз өтірік.
Dialogue: 0,0:50:46.33,0:50:49.17,Default,,0,0,0,,Бұл қай жерде есіңде қалды...
Dialogue: 0,0:50:50.17,0:50:52.42,Default,,0,0,0,,Қорқынышты әйел
Dialogue: 0,0:50:52.50,0:50:53.84,Default,,0,0,0,,Ха... Хэдзи!
Dialogue: 0,0:51:02.10,0:51:04.22,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:51:04.81,0:51:06.68,Default,,0,0,0,,Хэйдзи байқадыңыз ба?
Dialogue: 0,0:51:06.77,0:51:08.06,Default,,0,0,0,,Казуха…
Dialogue: 0,0:51:08.14,0:51:09.27,Default,,0,0,0,,Керемет!
Dialogue: 0,0:51:09.35,0:51:10.98,Default,,0,0,0,,Мен уайымдадым, Тайра-чан.
Dialogue: 0,0:51:11.06,0:51:12.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:13.32,0:51:15.28,Default,,0,0,0,,Хань Отаки және...
Dialogue: 0,0:51:15.36,0:51:16.32,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:51:16.40,0:51:17.49,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:51:18.03,0:51:20.03,Default,,0,0,0,,Бұл елордалық полиция департаментінен Ширатори.
Dialogue: 0,0:51:20.11,0:51:24.33,Default,,0,0,0,,Мен өлтірілген Шозо Сакура мырзаның Гендзи Хотарудың мүшесі екенін естідім.
Dialogue: 0,0:51:24.41,0:51:26.29,Default,,0,0,0,,Мен Токиодан жүгірдім.
Dialogue: 0,0:51:26.79,0:51:28.37,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,0:51:28.46,0:51:29.29,Default,,0,0,0,,Аздап
Dialogue: 0,0:51:29.37,0:51:35.13,Default,,0,0,0,,Сакура мырзаның дүкенінен ұрланған өнер бұйымдары үйді тінту кезінде табылды.
Dialogue: 0,0:51:35.21,0:51:37.51,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:51:37.59,0:51:39.59,Default,,0,0,0,,Инспектор, анау қанжар...
Dialogue: 0,0:51:39.67,0:51:41.64,Default,,0,0,0,,Мен оны бағалауға жіберемін.
Dialogue: 0,0:51:42.22,0:51:44.30,Default,,0,0,0,,Нәтижелерді алғаннан кейін маған хабарлаңыз.
Dialogue: 0,0:51:44.39,0:51:46.81,Default,,0,0,0,,Егер дәлелдер жеткіліксіз болса...
Dialogue: 0,0:51:47.47,0:51:49.39,Default,,0,0,0,,Мен де саған иығымдағы тыртықты беремін.
Dialogue: 0,0:51:49.48,0:51:51.39,Default,,0,0,0,,Иә? Дәлел дегеніміз не?
Dialogue: 0,0:51:52.69,0:51:57.40,Default,,0,0,0,,Бұл қысқа қылыш Сакура-санды өлтірген кісі өлтіру қаруы болды.
Dialogue: 0,0:51:57.48,0:51:59.53,Default,,0,0,0,,Негізі мен қылмыскердің терісін ұстадым.
Dialogue: 0,0:51:59.61,0:52:01.70,Default,,0,0,0,,Бар болса жақсы болар еді...
Dialogue: 0,0:52:01.78,0:52:04.83,Default,,0,0,0,,А, велосипед ше? Велосипед болды
Dialogue: 0,0:52:04.91,0:52:06.41,Default,,0,0,0,,Бұл ұрланған көлік.
Dialogue: 0,0:52:06.49,0:52:09.08,Default,,0,0,0,,Қылмыскерді анықтай алатын дәлелдер?
Dialogue: 0,0:52:09.16,0:52:10.37,Default,,0,0,0,,(бетінің жарылған дыбысы)
Dialogue: 0,0:52:12.29,0:52:13.71,Default,,0,0,0,,Өте жақсы екен. Хахаха.
Dialogue: 0,0:52:14.21,0:52:16.84,Default,,0,0,0,,Сіз бұл суреттен бірдеңе таба аласыз ба?
Dialogue: 0,0:52:17.63,0:52:21.05,Default,,0,0,0,,Сакура мырзаның үйіндегі «Гикейкиде» тұрып қалған.
Dialogue: 0,0:52:22.13,0:52:23.68,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:52:24.43,0:52:26.85,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:52:31.10,0:52:34.06,Default,,0,0,0,,Бұдан сабақ алып, үндемей қалды.
Dialogue: 0,0:52:34.81,0:52:36.86,Default,,0,0,0,,Олай болса, мен де.
Dialogue: 0,0:52:37.57,0:52:39.69,Default,,0,0,0,,Сау бол, Тайра-чан
Dialogue: 0,0:52:44.53,0:52:47.16,Default,,0,0,0,,Мен әкеме телефон соғамын.
Dialogue: 0,0:52:47.24,0:52:48.37,Default,,0,0,0,,Иә
Dialogue: 0,0:52:48.45,0:52:51.37,Default,,0,0,0,,Олай болса мен мұғалімнен сұраймын.
Dialogue: 0,0:52:51.45,0:52:53.96,Default,,0,0,0,,Иә, Конан-кун да менімен бірге...
Dialogue: 0,0:52:54.04,0:52:54.92,Default,,0,0,0,,Ран-чан
Dialogue: 0,0:52:55.00,0:52:57.46,Default,,0,0,0,,Мен біраз уақытқа шығамын, Хэйдзи, өтінемін.
Dialogue: 0,0:52:57.54,0:52:58.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:58.46,0:53:01.38,Default,,0,0,0,,Бізбен дереу 17 нөміріне хабарласыңыз.
Dialogue: 0,0:53:03.59,0:53:04.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:10.31,0:53:12.89,Default,,0,0,0,,Жарай ма? Мен демалмаймын
Dialogue: 0,0:53:12.98,0:53:13.81,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:53:14.44,0:53:16.69,Default,,0,0,0,,Бұдан басқа, мен шынымен ерекше нәрсе жасадым.
Dialogue: 0,0:53:17.40,0:53:19.19,Default,,0,0,0,,Мен мұндай қылыш техникасын бірінші рет көріп тұрмын.
Dialogue: 0,0:53:19.77,0:53:23.19,Default,,0,0,0,,Бәлкім, қолтығына темір салып, оны қалқан етіп пайдаланған болар.
Dialogue: 0,0:53:23.78,0:53:27.32,Default,,0,0,0,,Мен тыртықтардан кісі өлтіру қаруын сәйкестендіруге тырысамын деп ойладым.
Dialogue: 0,0:53:27.41,0:53:29.49,Default,,0,0,0,,Қанжарымды алып, әдейі кесіп алдым.
Dialogue: 0,0:53:29.58,0:53:32.33,Default,,0,0,0,,Мен сол қанжарды тастап кеттім.
Dialogue: 0,0:53:32.41,0:53:33.83,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:53:33.91,0:53:35.00,Default,,0,0,0,,Маданде
Dialogue: 0,0:53:35.08,0:53:37.96,Default,,0,0,0,,Ол соғысып жатқанда
Dialogue: 0,0:53:38.04,0:53:40.92,Default,,0,0,0,,Мен тастап кеткен әмиянды алуға тырыстым.
Dialogue: 0,0:53:41.00,0:53:43.34,Default,,0,0,0,,Мен түсінбейтін нәрселер көп.
Dialogue: 0,0:53:43.42,0:53:47.34,Default,,0,0,0,,Бұл қарт сіздің алғашқы махаббатыңыз болуы мүмкін бе?
Dialogue: 0,0:53:47.43,0:53:49.55,Default,,0,0,0,,Ахаха... бұл үлкен хит.
Dialogue: 0,0:53:49.64,0:53:51.47,Default,,0,0,0,,...Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:53:54.56,0:53:56.98,Default,,0,0,0,,Шабуыл жасады ма? Осыдан кейін?
Dialogue: 0,0:53:57.06,0:54:01.69,Default,,0,0,0,,Сонымен, кешіріңіз, мен Мидзуо мырзаның әлібиін сұрауға келдім.
Dialogue: 0,0:54:01.78,0:54:04.90,Default,,0,0,0,,Өйткені, кінәлі қарт адамның Но маскасын киіп алған.
Dialogue: 0,0:54:04.99,0:54:06.20,Default,,0,0,0,,Қарттың Но маскасы?
Dialogue: 0,0:54:06.78,0:54:11.08,Default,,0,0,0,,Сондай-ақ, мен Сайджо-сан мен Рюэн-санның алибистерін ести аламын ба?
Dialogue: 0,0:54:11.16,0:54:12.87,Default,,0,0,0,,Біз де ше?
Dialogue: 0,0:54:12.95,0:54:14.58,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:54:14.66,0:54:16.79,Default,,0,0,0,,Бүгін төртеуміз Сузу Сенгамен біргеміз.
Dialogue: 0,0:54:16.87,0:54:20.96,Default,,0,0,0,,Сакура-санды өлтірген адам туралы сенімен сөйлесуді ойлап келдім.
Dialogue: 0,0:54:21.04,0:54:22.55,Default,,0,0,0,,Эй?
Dialogue: 0,0:54:23.84,0:54:24.80,Default,,0,0,0,,Иә.
Dialogue: 0,0:54:24.88,0:54:28.18,Default,,0,0,0,,Мен шайханадан дәл осында қайтып, төсекке жаттым.
Dialogue: 0,0:54:28.26,0:54:29.97,Default,,0,0,0,,Бірақ мен бойдақпын
Dialogue: 0,0:54:30.76,0:54:33.10,Default,,0,0,0,,Анам екеуміз бөлек бөлмелерде тұрамыз.
Dialogue: 0,0:54:33.18,0:54:36.81,Default,,0,0,0,,Одан кейін оның үйде қалғанын дәлелдеу қиын.
Dialogue: 0,0:54:36.89,0:54:39.27,Default,,0,0,0,,Мен де солаймын.
Dialogue: 0,0:54:39.35,0:54:43.48,Default,,0,0,0,,Мен Терамачи көшесіндегі дүкеннің екінші қабатында жалғыз тұрамын.
Dialogue: 0,0:54:43.57,0:54:46.99,Default,,0,0,0,,Үлкен залда біраз уақыт сутраны оқығаннан кейін,
Dialogue: 0,0:54:47.07,0:54:48.66,Default,,0,0,0,,Мен бөлмеме қайта кіріп, демалдым.
Dialogue: 0,0:54:49.41,0:54:50.82,Default,,0,0,0,,Куәгерлер жоқ.
Dialogue: 0,0:54:50.91,0:54:52.28,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:54:52.78,0:54:56.71,Default,,0,0,0,,Тағы бір нәрсе: Садақ бар ма, садақ па?
Dialogue: 0,0:54:56.79,0:54:58.42,Default,,0,0,0,,Бұл садақ па? Жоқ...
Dialogue: 0,0:54:58.50,0:55:02.84,Default,,0,0,0,,«Момиджигари» кезеңінде ол Азуса садағын алып жүреді.
Dialogue: 0,0:55:03.50,0:55:05.63,Default,,0,0,0,,Мен де садақтың бауын дыбыстаймын.
Dialogue: 0,0:55:05.71,0:55:08.51,Default,,0,0,0,,Мен бұрын зұлым рухтарды қуып үлгергенмін.
Dialogue: 0,0:55:08.59,0:55:12.76,Default,,0,0,0,,Сонда сіз сол кезде шайханада болған адамдардың арасында емес пе едіңіз?
Dialogue: 0,0:55:12.85,0:55:13.97,Default,,0,0,0,,Садақшыны ойнайтын адам
Dialogue: 0,0:55:14.85,0:55:17.48,Default,,0,0,0,,Енді ойлап қарасам, Ямакура...
Dialogue: 0,0:55:17.56,0:55:20.94,Default,,0,0,0,,Не? Әлгі Ямакура-хан, сен садақ ойнадың ба?
Dialogue: 0,0:55:21.02,0:55:23.19,Default,,0,0,0,,Бірақ ол кезде қызықсыз еді.
Dialogue: 0,0:55:23.27,0:55:24.94,Default,,0,0,0,,А, жоқ...
Dialogue: 0,0:55:25.82,0:55:26.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:55:26.74,0:55:28.70,Default,,0,0,0,,А, мен мұндамын.
Dialogue: 0,0:55:29.45,0:55:30.66,Default,,0,0,0,,- Иә? -(Хедзи) Не болды?
Dialogue: 0,0:55:30.74,0:55:32.57,Default,,0,0,0,,Келіңдер, келіңдер.
Dialogue: 0,0:55:32.66,0:55:34.08,Default,,0,0,0,,Чика Сузу-сан апа?
Dialogue: 0,0:55:34.16,0:55:35.37,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:55:35.45,0:55:38.71,Default,,0,0,0,,Сіз таңданған болуыңыз керек, өйткені сіз Майко фигурасынан басқа адамға ұқсадыңыз.
Dialogue: 0,0:55:38.79,0:55:39.79,Default,,0,0,0,,Жүр, көтеріл.
Dialogue: 0,0:55:40.96,0:55:43.04,Default,,0,0,0,,Иә, Окини
Dialogue: 0,0:55:54.22,0:55:55.51,Default,,0,0,0,,Түнге дейін көп
Dialogue: 0,0:55:55.60,0:55:57.89,Default,,0,0,0,,Менің атым тағы да Ота.
Dialogue: 0,0:55:57.97,0:55:59.06,Default,,0,0,0,,Жоқ, бұл.
Dialogue: 0,0:55:59.77,0:56:01.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:02.15,0:56:04.61,Default,,0,0,0,,Оокини Сайнара
Dialogue: 0,0:56:05.48,0:56:08.07,Default,,0,0,0,,Санноджи мырза, Роккакуға не болды?
Dialogue: 0,0:56:08.15,0:56:10.95,Default,,0,0,0,,Бұл Хигава-дори көшесі...
Dialogue: 0,0:56:11.03,0:56:12.91,Default,,0,0,0,,♪ Марутаке Эбисуни
Dialogue: 0,0:56:12.99,0:56:14.12,Default,,0,0,0,,♪ Жаза
Dialogue: 0,0:56:14.74,0:56:16.45,Default,,0,0,0,,♪ Ане-сан Роккаку
Dialogue: 0,0:56:16.53,0:56:19.58,Default,,0,0,0,,6-шы сюжетке әуре болма, хехе...
Dialogue: 0,0:56:19.66,0:56:21.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:21.21,0:56:23.83,Default,,0,0,0,,♪ Марутаке Эбисуни
Dialogue: 0,0:56:23.92,0:56:26.54,Default,,0,0,0,,♪ Жаза
Dialogue: 0,0:56:27.17,0:56:29.05,Default,,0,0,0,,Әй, бұл қандай ән?
Dialogue: 0,0:56:29.13,0:56:32.68,Default,,0,0,0,,Енді...оны «Темари-ута» дейміз.
Dialogue: 0,0:56:34.47,0:56:39.56,Default,,0,0,0,,Киотодағы шығыстан батысқа қарай көше атаулары солтүстіктен оңтүстікке қарай жырланады.
Dialogue: 0,0:56:39.64,0:56:41.77,Default,,0,0,0,,♪ Марутаке Эбисуни
Dialogue: 0,0:56:41.85,0:56:43.98,Default,,0,0,0,,♪ Жаза
Dialogue: 0,0:56:44.06,0:56:46.15,Default,,0,0,0,,♪ Ане-сан Роккаку
Dialogue: 0,0:56:46.23,0:56:48.53,Default,,0,0,0,,♪ Сегізаяқ
Dialogue: 0,0:56:48.61,0:56:50.49,Default,,0,0,0,,♪ Сіз ашуландыңыз ба?
Dialogue: 0,0:56:50.57,0:56:52.86,Default,,0,0,0,,♪ Мацумангоджо
Dialogue: 0,0:56:52.95,0:56:54.82,Default,,0,0,0,,♪ Сеттачара Чара
Dialogue: 0,0:56:54.91,0:56:56.91,Default,,0,0,0,,♪ Уонотана
Dialogue: 0,0:56:56.99,0:56:59.16,Default,,0,0,0,,♪ Рокуджо Хикчо
Dialogue: 0,0:56:59.24,0:57:01.37,Default,,0,0,0,,♪ өтіп бара жатқан
Dialogue: 0,0:57:01.45,0:57:03.62,Default,,0,0,0,,♪ Haccho Егер естісеңіз
Dialogue: 0,0:57:03.71,0:57:05.83,Default,,0,0,0,,♪ Тоджимичи
Dialogue: 0,0:57:05.92,0:57:08.09,Default,,0,0,0,,♪ Куджо Оджи де
Dialogue: 0,0:57:08.17,0:57:10.13,Default,,0,0,0,,♪ аяқтау
Dialogue: 0,0:57:11.55,0:57:15.89,Default,,0,0,0,,Киотодағы барлық балалар осы әннен көше атауларын біледі.
Dialogue: 0,0:57:15.97,0:57:17.26,Default,,0,0,0,,Хмм…
Dialogue: 0,0:57:17.35,0:57:20.10,Default,,0,0,0,,Чукото, сен де Киотодансың ба?
Dialogue: 0,0:57:20.18,0:57:21.89,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:57:21.98,0:57:23.73,Default,,0,0,0,,- (Хедзи) Жыл? - (Сенга Сузу) 19 Досу
Dialogue: 0,0:57:23.81,0:57:25.52,Default,,0,0,0,,19?
Dialogue: 0,0:57:30.90,0:57:32.65,Default,,0,0,0,,Бұл Ойке көшесі
Dialogue: 0,0:57:33.40,0:57:35.32,Default,,0,0,0,,Хона Учиха осында
Dialogue: 0,0:57:36.91,0:57:38.66,Default,,0,0,0,,- Қош бол - (Сенга Сузу) Сау бол
Dialogue: 0,0:57:40.24,0:57:42.25,Default,,0,0,0,,Сіз оны... болады деп күтпеген едіңіз...
Dialogue: 0,0:57:42.33,0:57:47.17,Default,,0,0,0,,Күмәнсіз, ол Киотодан және ол менен екі жас үлкен.
Dialogue: 0,0:57:47.25,0:57:49.92,Default,,0,0,0,,Бірақ Киотодағы барлық балалар бұл әнді айтады...
Dialogue: 0,0:57:50.00,0:57:52.05,Default,,0,0,0,,Ақыры кездесіп қалдық, ақыры...
Dialogue: 0,0:57:52.13,0:57:54.13,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:57:54.22,0:57:55.05,Default,,0,0,0,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:57:55.13,0:57:57.01,Default,,0,0,0,,Хэй Чан, не істеп жатырсың!
Dialogue: 0,0:57:57.09,0:57:59.39,Default,,0,0,0,,Егер сіз ауруханадан рұқсатсыз жасырын түрде шығып кетсеңіз, бұл жақсы емес!
Dialogue: 0,0:57:59.47,0:58:00.68,Default,,0,0,0,,Ах Отаки-хан
Dialogue: 0,0:58:01.26,0:58:02.85,Default,,0,0,0,,Ал, мұны бір жаққа қалдырыңыз.
Dialogue: 0,0:58:02.93,0:58:05.19,Default,,0,0,0,,Қан анализінің нәтижелері шықты.
Dialogue: 0,0:58:05.89,0:58:08.10,Default,,0,0,0,,Қанжардың сабынан аздап күйіп қалдым.
Dialogue: 0,0:58:08.19,0:58:12.11,Default,,0,0,0,,Сакура-сан сияқты қан тобы анықталған сияқты.
Dialogue: 0,0:58:12.19,0:58:13.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:13.11,0:58:14.40,Default,,0,0,0,,Сонымен қатар, пышақтың пішіні...
Dialogue: 0,0:58:14.49,0:58:17.20,Default,,0,0,0,,Жара Сакура-санның жарасына сәйкес келеді дейді.
Dialogue: 0,0:58:17.28,0:58:18.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:58:18.20,0:58:20.95,Default,,0,0,0,,Тайра-чан, сенімді болу үшін.
Dialogue: 0,0:58:21.03,0:58:22.87,Default,,0,0,0,,Егер шатастырып алсаңыз, кешіріңіз.
Dialogue: 0,0:58:22.95,0:58:25.96,Default,,0,0,0,,Тайра-чанға бірдеңе болса, әкеме айтамын...
Dialogue: 0,0:58:26.04,0:58:27.87,Default,,0,0,0,,А, мен білемін.
Dialogue: 0,0:58:27.96,0:58:29.63,Default,,0,0,0,,Рахмет, Отаки-хан
Dialogue: 0,0:58:29.71,0:58:31.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:31.59,0:58:32.88,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:58:35.30,0:58:38.26,Default,,0,0,0,,Енді маған шабуыл жасаған қарттың маскасы
Dialogue: 0,0:58:38.34,0:58:41.64,Default,,0,0,0,,Сакура-санды өлтірген адамның осы екеніне күмәнім жоқ.
Dialogue: 0,0:58:41.72,0:58:46.52,Default,,0,0,0,,Бұл жағдайда бұл төрт адамның өлтіру қаруын жоюға мүмкіндігі болмады.
Dialogue: 0,0:58:46.60,0:58:49.15,Default,,0,0,0,,Бұл оның кінәлі емес екенін білдіреді.
Dialogue: 0,0:58:49.23,0:58:50.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:01.53,0:59:02.91,Default,,0,0,0,,Фу…
Dialogue: 0,0:59:03.87,0:59:05.33,Default,,0,0,0,,Әй, Конан-кун!
Dialogue: 0,0:59:05.41,0:59:06.83,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:59:06.91,0:59:07.75,Default,,0,0,0,,Я...
Dialogue: 0,0:59:07.83,0:59:09.67,Default,,0,0,0,,Балалар, неге...
Dialogue: 0,0:59:09.75,0:59:13.42,Default,,0,0,0,,Викторинаға жауап бергенім үшін дәрігер мені осында әкелді.
Dialogue: 0,0:59:13.50,0:59:15.30,Default,,0,0,0,,Дегенмен, Гента...
Dialogue: 0,0:59:15.38,0:59:16.92,Default,,0,0,0,,Мен адасып қалдым.
Dialogue: 0,0:59:17.01,0:59:18.68,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:59:18.76,0:59:20.43,Default,,0,0,0,,Бұл жағдайда детектив белгісімен...
Dialogue: 0,0:59:20.51,0:59:23.85,Default,,0,0,0,,Мен сізге хабарластым.
Dialogue: 0,0:59:23.93,0:59:28.35,Default,,0,0,0,,Бірақ Гента, мен канжиді оқи алмаймын, сондықтан қайда екенімді айта алмаймын.
Dialogue: 0,0:59:28.43,0:59:32.56,Default,,0,0,0,,...Сондықтан мен сені іздеу үшін сол көзілдірікті пайдаланамын деп ойладым.
Dialogue: 0,0:59:32.65,0:59:34.61,Default,,0,0,0,,Жарайды, оны маған қалдырыңыз.
Dialogue: 0,0:59:34.69,0:59:36.19,Default,,0,0,0,,Ал...
Dialogue: 0,0:59:36.28,0:59:38.11,Default,,0,0,0,,-(Хедзи) Хух~ -Аа, о... Эй!
Dialogue: 0,0:59:38.19,0:59:39.95,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:59:40.03,0:59:41.16,Default,,0,0,0,,Әй, эй...
Dialogue: 0,0:59:41.24,0:59:42.24,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:59:52.96,0:59:55.80,Default,,0,0,0,,Мұнда да бір оқиға болған сияқты.
Dialogue: 0,0:59:55.88,0:59:59.26,Default,,0,0,0,,А, мен сізге кейінірек толығырақ айтып беремін.
Dialogue: 0,0:59:59.34,1:00:00.88,Default,,0,0,0,,Ах, тағы да...
Dialogue: 0,1:00:00.97,1:00:02.64,Default,,0,0,0,,Ай-күн, маған дәріні бер.
Dialogue: 0,1:00:07.35,1:00:08.39,Default,,0,0,0,,(дәрі жұтқан дыбыс)
Dialogue: 0,1:00:08.98,1:00:09.81,Default,,0,0,0,,Не? ол
Dialogue: 0,1:00:09.89,1:00:11.89,Default,,0,0,0,,Асқазанның шуын басатын дәрілер
Dialogue: 0,1:00:11.98,1:00:14.77,Default,,0,0,0,,Салтанатты жағдайлар үшін доктор әзірлеген.
Dialogue: 0,1:00:14.86,1:00:20.32,Default,,0,0,0,,Алкогольді ұнатпайтын адамдарға арналған, бетіңізді бірден қызартып жіберетін дәрілер де бар.
Dialogue: 0,1:00:20.40,1:00:22.03,Default,,0,0,0,,Жұмыстан демалыс алғысы келетіндер үшін
Dialogue: 0,1:00:22.11,1:00:26.37,Default,,0,0,0,,Олар сондай-ақ суық тиюге ұқсас белгілерді тудыратын дәрі ойлап тапты.
Dialogue: 0,1:00:26.45,1:00:28.66,Default,,0,0,0,,Айкун маған бәріне көмектесті.
Dialogue: 0,1:00:28.75,1:00:30.79,Default,,0,0,0,,Хмм... Мен олардың ешқайсысын пайдалана алмаймын.
Dialogue: 0,1:00:31.71,1:00:32.96,Default,,0,0,0,,О, міне, міне, міне
Dialogue: 0,1:00:33.04,1:00:35.25,Default,,0,0,0,,Мұнда Роккакудода
Dialogue: 0,1:00:35.34,1:00:36.67,Default,,0,0,0,,- (Аюми) Сен осындасың ба? -(Мицухико) Ах~ Жақсы.
Dialogue: 0,1:00:36.75,1:00:39.17,Default,,0,0,0,,Хехе, бұл жақсы.
Dialogue: 0,1:00:39.26,1:00:40.34,Default,,0,0,0,,Анашым...
Dialogue: 0,1:00:40.42,1:00:42.18,Default,,0,0,0,,А, Гента-кун келді!
Dialogue: 0,1:00:42.26,1:00:45.09,Default,,0,0,0,,Ахаха... О, мені құтқарды!
Dialogue: 0,1:00:45.18,1:00:46.89,Default,,0,0,0,,Саған жақсы, Гента-кун.
Dialogue: 0,1:00:46.97,1:00:49.43,Default,,0,0,0,,Мен сені енді ешқашан көрмеймін деп ойладым.
Dialogue: 0,1:00:49.52,1:00:50.43,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,1:00:50.52,1:00:52.69,Default,,0,0,0,,Дегенмен, бұл ыңғайлы.
Dialogue: 0,1:00:52.77,1:00:53.69,Default,,0,0,0,,Хмм...
Dialogue: 0,1:00:53.77,1:00:56.73,Default,,0,0,0,,Бұл таратқышы бар белгі ме?
Dialogue: 0,1:00:56.81,1:00:58.07,Default,,0,0,0,,О
Dialogue: 0,1:00:58.15,1:01:02.20,Default,,0,0,0,,Бұл таратқыштан шығатын жиілік осы көзілдіріктермен синхрондалады...
Dialogue: 0,1:01:02.28,1:01:03.36,Default,,0,0,0,,Ха…
Dialogue: 0,1:01:03.45,1:01:04.36,Default,,0,0,0,,Хаттори!
Dialogue: 0,1:01:04.45,1:01:05.28,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,1:01:05.37,1:01:07.45,Default,,0,0,0,,Нана... Нана... Бұл не?
Dialogue: 0,1:01:07.53,1:01:10.45,Default,,0,0,0,,Ку… Кудо: Олай емес…
Dialogue: 0,1:01:18.21,1:01:19.67,Default,,0,0,0,,Оған күмән жоқ
Dialogue: 0,1:01:19.75,1:01:21.01,Default,,0,0,0,,О
Dialogue: 0,1:01:21.09,1:01:25.68,Default,,0,0,0,,Әпкем естіген дыбыс адам өлтіру қаруының тасталған дыбысы еді.
Dialogue: 0,1:01:25.76,1:01:28.85,Default,,0,0,0,,Онда кінәлі сол төрт адамның бірі болуы керек.
Dialogue: 0,1:01:29.43,1:01:31.35,Default,,0,0,0,,Жоқ, үш адам.
Dialogue: 0,1:01:31.43,1:01:34.77,Default,,0,0,0,,Менің алғашқы махаббатым кісі өлтіруші болуы мүмкін емес.
Dialogue: 0,1:01:34.85,1:01:35.85,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,1:01:35.94,1:01:40.57,Default,,0,0,0,,Мені тек жаңа ғана естіген ән ғана мазалайды.
Dialogue: 0,1:01:40.65,1:01:43.65,Default,,0,0,0,,Менің есімде қалған әннің сөзі бір жерде әртүрлі болды.
Dialogue: 0,1:01:43.74,1:01:44.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:44.65,1:01:46.32,Default,,0,0,0,,Менің алғашқы махаббатым
Dialogue: 0,1:01:46.41,1:01:50.66,Default,,0,0,0,,«Анесан Роккаку» «Йомесан Роккаку» ретінде орындалды.
Dialogue: 0,1:01:51.62,1:01:53.04,Default,,0,0,0,,Қызық, неге?
Dialogue: 0,1:01:53.12,1:01:54.91,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,1:02:03.51,1:02:04.63,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:08.51,1:02:11.26,Default,,0,0,0,,Мен масканың бір бөлігін таптым.
Dialogue: 0,1:02:20.57,1:02:21.65,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:21.73,1:02:22.94,Default,,0,0,0,,инспектор?
Dialogue: 0,1:02:23.03,1:02:25.24,Default,,0,0,0,,Бұл ненің айқайы?
Dialogue: 0,1:02:25.32,1:02:27.07,Default,,0,0,0,,- (Сато) Бұл не? -(Мегур) Хмм.
Dialogue: 0,1:02:27.16,1:02:30.45,Default,,0,0,0,,Токиода өлтірілген үш адамның киімі осы.
Dialogue: 0,1:02:31.12,1:02:35.29,Default,,0,0,0,,Бірі бас киім киген, бірі жаға киген, бірі қолғап киген.
Dialogue: 0,1:02:35.37,1:02:39.46,Default,,0,0,0,,Түсі, өрнегі, матасы бірдей. Бұл біртүрлі деп ойламайсыз ба?
Dialogue: 0,1:02:39.54,1:02:41.42,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,1:02:41.50,1:02:43.34,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,1:02:43.42,1:02:47.34,Default,,0,0,0,,Мысалы, Ширатори осы үш нәрсені өз бетімен орындаса.
Dialogue: 0,1:02:47.43,1:02:48.93,Default,,0,0,0,,Бұл мүлдем табиғи емес.
Dialogue: 0,1:02:49.64,1:02:51.10,Default,,0,0,0,,Бұл шляпаны инспектор Мегуре айтты
Dialogue: 0,1:02:51.80,1:02:53.01,Default,,0,0,0,,Мен мына жағамын
Dialogue: 0,1:02:53.60,1:02:56.98,Default,,0,0,0,,Такаги осы қолғапты киіп жүрсе, біртүрлі болмай ма?
Dialogue: 0,1:02:57.06,1:02:58.85,Default,,0,0,0,,Әрине
Dialogue: 0,1:02:58.94,1:03:00.98,Default,,0,0,0,,Ширатори мырза өлгендей.
Dialogue: 0,1:03:01.06,1:03:04.48,Default,,0,0,0,,Заттарды үшеуңе бөлген сияқтысыңдар. Ахах...
Dialogue: 0,1:03:04.57,1:03:05.90,Default,,0,0,0,,- (Сато) Не... - (Мегуре) Болды!
Dialogue: 0,1:03:05.99,1:03:08.61,Default,,0,0,0,,Иә? Не... не?
Dialogue: 0,1:03:10.70,1:03:12.33,Default,,0,0,0,,А... Менің қарным ашты.
Dialogue: 0,1:03:12.41,1:03:13.95,Default,,0,0,0,,Сабырлы болыңыз
Dialogue: 0,1:03:14.04,1:03:17.33,Default,,0,0,0,,Сузу Чиганың анасы Миагава-чода гейша болған.
Dialogue: 0,1:03:17.96,1:03:20.83,Default,,0,0,0,,Бес жасында аурудан қайтыс болды.
Dialogue: 0,1:03:20.92,1:03:22.29,Default,,0,0,0,,Себебі мен үйленбеген ана едім...
Dialogue: 0,1:03:22.38,1:03:23.21,Default,,0,0,0,,Хмм...
Dialogue: 0,1:03:23.29,1:03:27.05,Default,,0,0,0,,Сузу Сенганы шай дүкенінің иесі Тэ Ямакура қабылдады.
Dialogue: 0,1:03:27.13,1:03:28.51,Default,,0,0,0,,Ол өскен көрінеді
Dialogue: 0,1:03:29.09,1:03:31.09,Default,,0,0,0,,Некесіз ана дегеніміз не?
Dialogue: 0,1:03:31.18,1:03:32.47,Default,,0,0,0,,Дұрыс...
Dialogue: 0,1:03:32.55,1:03:35.77,Default,,0,0,0,,Некесіз босанған әйел.
Dialogue: 0,1:03:36.39,1:03:39.31,Default,,0,0,0,,Мен оның әкесі кім екенін білмеймін.
Dialogue: 0,1:03:39.39,1:03:42.77,Default,,0,0,0,,Шайханаға ай сайын ақша жасырын түрде жіберіледі.
Dialogue: 0,1:03:43.36,1:03:45.69,Default,,0,0,0,,Бұл үш айдан бері болып жатыр. Неліктен?
Dialogue: 0,1:03:45.78,1:03:47.82,Default,,0,0,0,,Жоғалып кеткен сияқты.
Dialogue: 0,1:03:47.90,1:03:52.53,Default,,0,0,0,,Хмм... Бұл, әрине, қызықты оқиға.
Dialogue: 0,1:03:52.62,1:03:55.33,Default,,0,0,0,,3 ай бұрын?
Dialogue: 0,1:03:55.91,1:03:58.54,Default,,0,0,0,,Бірақ инспектор Ширатори, сіз мұны қайдан жасадыңыз ...
Dialogue: 0,1:03:58.62,1:04:00.92,Default,,0,0,0,,Сіз оны инспектор Оджарудан естідіңіз, солай ма?
Dialogue: 0,1:04:01.00,1:04:02.46,Default,,0,0,0,,Бұл – тұзақ.
Dialogue: 0,1:04:02.54,1:04:05.96,Default,,0,0,0,,Мен осылай болсам да, Джиёнда жай ғана бетпінмін.
Dialogue: 0,1:04:06.05,1:04:08.38,Default,,0,0,0,,Хаха... мақтанасың ба?
Dialogue: 0,1:04:08.46,1:04:12.30,Default,,0,0,0,,Ол әдетте менің қарсыласым деп айтылады.
Dialogue: 0,1:04:12.39,1:04:14.97,Default,,0,0,0,,Әрқашан өзімен бірге бурундук алып жүретін адам...
Dialogue: 0,1:04:15.05,1:04:16.26,Default,,0,0,0,,Бурундучка?
Dialogue: 0,1:04:16.35,1:04:18.64,Default,,0,0,0,,Иә, қалтамда бар.
Dialogue: 0,1:04:18.72,1:04:21.98,Default,,0,0,0,,Оқиға орнына келгенде оны артқа тастап кеткен сияқтысыз.
Dialogue: 0,1:04:22.06,1:04:23.06,Default,,0,0,0,,Бурундуч…
Dialogue: 0,1:04:23.15,1:04:24.48,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:04:25.11,1:04:26.98,Default,,0,0,0,,Иә, бұл аққу.
Dialogue: 0,1:04:27.07,1:04:32.24,Default,,0,0,0,,Бұл Мегур. Йошицуне немесе Бенкейге қатысты бір мүмкіндік пайда болды.
Dialogue: 0,1:04:33.07,1:04:34.20,Default,,0,0,0,,Сәйкестендіру?
Dialogue: 0,1:04:34.28,1:04:36.78,Default,,0,0,0,,Осылай ойласаң, жұмбақ шешуге болады.
Dialogue: 0,1:04:36.87,1:04:39.37,Default,,0,0,0,,Басқаша айтқанда, Йошицүнэ немесе Бенкей
Dialogue: 0,1:04:39.45,1:04:42.71,Default,,0,0,0,,Біздің теориямыз ол әлдеқашан өлген болуы мүмкін.
Dialogue: 0,1:04:44.13,1:04:46.13,Default,,0,0,0,,- (Барлығы) Әй... - (Когоро) Түсіндім!
Dialogue: 0,1:04:53.68,1:04:54.97,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:56.68,1:04:57.72,Default,,0,0,0,,Моури мырза
Dialogue: 0,1:04:57.81,1:05:01.18,Default,,0,0,0,,Сакура мырзаны кім өлтіргенін анықтағаныңыз рас па?
Dialogue: 0,1:05:01.27,1:05:02.10,Default,,0,0,0,,Иә
Dialogue: 0,1:05:04.52,1:05:06.23,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,1:05:06.31,1:05:07.27,Default,,0,0,0,,Кінәлі кім?
Dialogue: 0,1:05:07.36,1:05:10.32,Default,,0,0,0,,Чига Сузу, бұл сенсің.
Dialogue: 0,1:05:10.40,1:05:12.32,Default,,0,0,0,,Қандай ақымақ!
Dialogue: 0,1:05:13.20,1:05:14.74,Default,,0,0,0,,Мұндай пайымдау
Dialogue: 0,1:05:14.82,1:05:16.45,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:05:16.53,1:05:18.58,Default,,0,0,0,,Әйтеуір, соңына дейін тыңдаған соң...
Dialogue: 0,1:05:18.66,1:05:19.62,Default,,0,0,0,,(Когораның Секібарайы)
Dialogue: 0,1:05:20.41,1:05:23.41,Default,,0,0,0,,Мотив: Әкесін өлтіргені үшін кек алу
Dialogue: 0,1:05:23.50,1:05:27.88,Default,,0,0,0,,Ал бұл әке - ұрылардың басшысы Йосицүнэ!
Dialogue: 0,1:05:27.96,1:05:29.13,Default,,0,0,0,,Ха…
Dialogue: 0,1:05:29.21,1:05:31.46,Default,,0,0,0,,Yoshitsune 3 ай бұрын
Dialogue: 0,1:05:31.55,1:05:34.13,Default,,0,0,0,,Қол астындағылардың сатқындығы үшін өлтірілді.
Dialogue: 0,1:05:34.22,1:05:36.30,Default,,0,0,0,,Сол себепті шайханаға ақша аудару тоқтады.
Dialogue: 0,1:05:37.14,1:05:38.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:05:38.93,1:05:41.60,Default,,0,0,0,,Сіздің сыбайласыңыз болды.
Dialogue: 0,1:05:41.68,1:05:42.85,Default,,0,0,0,,Бенкей
Dialogue: 0,1:05:42.93,1:05:44.19,Default,,0,0,0,,Бенкей?
Dialogue: 0,1:05:44.27,1:05:46.31,Default,,0,0,0,,Әлгі Бенкей кім?
Dialogue: 0,1:05:46.90,1:05:49.32,Default,,0,0,0,,Оджару инспектор! Бұл сенсің
Dialogue: 0,1:05:49.40,1:05:50.44,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:50.52,1:05:51.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:51.57,1:05:52.99,Default,,0,0,0,,Сенга Сузу-сан
Dialogue: 0,1:05:53.07,1:05:56.86,Default,,0,0,0,,Шайханаға келгенде қасыңа бірдеңе тығып алдың.
Dialogue: 0,1:05:56.95,1:05:58.99,Default,,0,0,0,,Қысқа қылыш пен инспектордың үй жануары —
Dialogue: 0,1:05:59.08,1:06:00.66,Default,,0,0,0,,Әлгі бурундук!
Dialogue: 0,1:06:01.33,1:06:03.37,Default,,0,0,0,,(айқай)
Dialogue: 0,1:06:03.45,1:06:05.29,Default,,0,0,0,,- (Мицухико/Гента) Ой... - (Аюми) Уау, сондай сүйкімді!
Dialogue: 0,1:06:05.37,1:06:08.63,Default,,0,0,0,,Әлгі бурундук айланың кілті болды.
Dialogue: 0,1:06:08.71,1:06:09.92,Default,,0,0,0,,Сенга Сузу-сан
Dialogue: 0,1:06:10.00,1:06:13.71,Default,,0,0,0,,Татами бөлмесіне бара жатып, дәретханаға баратындай кейіп таныттың.
Dialogue: 0,1:06:13.80,1:06:15.30,Default,,0,0,0,,Сакура мырзаны қоймада өлтірді
Dialogue: 0,1:06:16.09,1:06:20.51,Default,,0,0,0,,Шкафқа немесе басқа нәрсеге жасырылған бурундуктың денесіне қанжар байлаңыз.
Dialogue: 0,1:06:20.60,1:06:23.31,Default,,0,0,0,,Мен оны жертөледегі шыны есік арқылы жібердім.
Dialogue: 0,1:06:23.39,1:06:27.56,Default,,0,0,0,,Бурундуш Мисоги өзеніне секіріп, ағысқа қарай бет алады.
Dialogue: 0,1:06:28.10,1:06:31.61,Default,,0,0,0,,Ағыстың төменгі жағында күтіп тұрған инспектор оны алды.
Dialogue: 0,1:06:31.69,1:06:34.86,Default,,0,0,0,,Кейін мен Хеджиді сол қанжармен өлтірмек болдым.
Dialogue: 0,1:06:34.94,1:06:39.32,Default,,0,0,0,,Түсіндім! Бұл судың дыбысы бурундуктың секірген дыбысы еді.
Dialogue: 0,1:06:40.12,1:06:43.91,Default,,0,0,0,,Екеуі Сакура-саннан басқа кісі өлтіруге сыбайлас болған.
Dialogue: 0,1:06:44.00,1:06:46.12,Default,,0,0,0,,Инспектор, сізде садақ бар ма?
Dialogue: 0,1:06:46.21,1:06:49.54,Default,,0,0,0,,Сіз соншалықты күрделі нәрсе жасадыңыз ба?
Dialogue: 0,1:06:49.63,1:06:52.13,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,1:06:52.84,1:06:54.21,Default,,0,0,0,,Бірақ Чига Сузу-сан
Dialogue: 0,1:06:54.80,1:06:56.05,Default,,0,0,0,,Садақшы
Dialogue: 0,1:06:56.13,1:06:59.22,Default,,0,0,0,,Бұл жерде жебенің ұшы ысқыланып, жарақат алуы мүмкін деп естідім.
Dialogue: 0,1:06:59.30,1:07:01.39,Default,,0,0,0,,(Сора) О, Патша, о, ақымақ Патша! Патшайымды өлтіруге пәндеріңе бұйрық беру – шынында да қатыгездік!
Dialogue: 0,1:07:01.47,1:07:04.97,Default,,0,0,0,,Ямакураның бұл жарақаты оның садақ атуымен байланысты...
Dialogue: 0,1:07:05.06,1:07:06.14,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:07.39,1:07:09.56,Default,,0,0,0,,Мен енді ғана бастадым
Dialogue: 0,1:07:09.65,1:07:11.73,Default,,0,0,0,,Сіз ешқашан біреуді атуға болмайды!
Dialogue: 0,1:07:12.44,1:07:14.32,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,1:07:14.40,1:07:17.61,Default,,0,0,0,,Бұл жерде жарақат алу сіздің жаңадан бастаушы екеніңіздің дәлелі дейді.
Dialogue: 0,1:07:17.70,1:07:20.49,Default,,0,0,0,,Мұны садақ ату үйірмесіндегі досымнан естідім.
Dialogue: 0,1:07:20.57,1:07:23.91,Default,,0,0,0,,Егер ол өлтірілсе, мен оның қалай көрінетінін білгім келеді...
Dialogue: 0,1:07:23.99,1:07:25.58,Default,,0,0,0,,Моури-хан!
Dialogue: 0,1:07:25.66,1:07:28.79,Default,,0,0,0,,Сіз шынымен бұл баланы кінәлі деп ойлайсыз ба?
Dialogue: 0,1:07:28.87,1:07:29.87,Default,,0,0,0,,Жоқ, сондықтан...
Dialogue: 0,1:07:29.96,1:07:31.33,Default,,0,0,0,,Әзілдер мен әзілдер!
Dialogue: 0,1:07:31.42,1:07:34.67,Default,,0,0,0,,Майко сахналық өнер мен салондармен айналысады.
Dialogue: 0,1:07:34.75,1:07:37.67,Default,,0,0,0,,Менің адамдарды өлтіруге уақытым жоқ!
Dialogue: 0,1:07:37.76,1:07:38.92,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,1:07:39.01,1:07:39.88,Default,,0,0,0,,Не?
Dialogue: 0,1:07:39.97,1:07:41.18,Default,,0,0,0,,Бурундучка
Dialogue: 0,1:07:41.26,1:07:44.10,Default,,0,0,0,,Осындай кішкентай денелі қысқа қылыш көтере алмайсың, солай ма?
Dialogue: 0,1:07:45.14,1:07:46.39,Default,,0,0,0,,Шу!
Dialogue: 0,1:07:46.47,1:07:48.27,Default,,0,0,0,,Онда мен саған дәлелді көрсетемін!
Dialogue: 0,1:07:51.02,1:07:53.11,Default,,0,0,0,,Сәлем! Қозғал, бурундук!
Dialogue: 0,1:07:53.77,1:07:55.86,Default,,0,0,0,,Мен аң-таң болып, сөйлей алмай қалдым.
Dialogue: 0,1:07:55.94,1:08:00.28,Default,,0,0,0,,Сіз өз күнәңізден құтылуға тырысатындай әдейі әрекет етесіз!
Dialogue: 0,1:08:00.36,1:08:01.41,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:01.95,1:08:03.03,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,1:08:03.12,1:08:06.12,Default,,0,0,0,,Сен сондай сүйкімді емессің бе? Ей, қария!
Dialogue: 0,1:08:06.20,1:08:07.83,Default,,0,0,0,,Бұл жануарларды қорлау!
Dialogue: 0,1:08:07.91,1:08:10.12,Default,,0,0,0,,Жоқ! Жауыз брат!
Dialogue: 0,1:08:10.21,1:08:11.96,Default,,0,0,0,,Гента-кун, Тиін мырзаға көмектес!
Dialogue: 0,1:08:12.04,1:08:13.38,Default,,0,0,0,,О!
Dialogue: 0,1:08:13.46,1:08:14.88,Default,,0,0,0,,Құрмет…
Dialogue: 0,1:08:15.50,1:08:19.38,Default,,0,0,0,,Аа, сіздің арқаңызда мен кінәлінің кім екенін білдім.
Dialogue: 0,1:08:20.13,1:08:21.38,Default,,0,0,0,,Мен де
Dialogue: 0,1:08:21.47,1:08:24.89,Default,,0,0,0,,Мен садақшы болсам, мұндай сөздерді айтпас едім.
Dialogue: 0,1:08:24.97,1:08:27.10,Default,,0,0,0,,Дәлелдер ғана қалды...
Dialogue: 0,1:08:28.27,1:08:29.98,Default,,0,0,0,,Будда мүсіні қайда орналасқан?
Dialogue: 0,1:08:30.06,1:08:32.98,Default,,0,0,0,,Бейшара бурундук.
Dialogue: 0,1:08:33.06,1:08:35.27,Default,,0,0,0,,Саған тамақ берейік.
Dialogue: 0,1:08:35.36,1:08:36.98,Default,,0,0,0,,Менде желу бар.
Dialogue: 0,1:08:37.07,1:08:38.28,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:08:42.07,1:08:42.91,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:42.99,1:08:45.16,Default,,0,0,0,,«Донгури Корокоро» әніне ұқсайды.
Dialogue: 0,1:08:45.78,1:08:47.66,Default,,0,0,0,,«Акорн орамы»…
Dialogue: 0,1:08:47.74,1:08:49.75,Default,,0,0,0,,Ха... мүмкін...
Dialogue: 0,1:08:54.33,1:08:56.09,Default,,0,0,0,,Эй, не болып жатыр, Кудо?
Dialogue: 0,1:08:56.17,1:08:58.38,Default,,0,0,0,,Мүмкін сол көшірмедегі сурет
Dialogue: 0,1:08:58.46,1:09:01.17,Default,,0,0,0,,Мен бұл Киотодағы көшенің аты деп ойладым.
Dialogue: 0,1:09:01.26,1:09:02.13,Default,,0,0,0,,Не?
Dialogue: 0,1:09:06.05,1:09:07.64,Default,,0,0,0,,Біріншіден, шығыс-батыс көшесі.
Dialogue: 0,1:09:08.35,1:09:11.81,Default,,0,0,0,,Бұл баспалдақтың бесінші сатысы Годжо көшесі
Dialogue: 0,1:09:12.39,1:09:15.44,Default,,0,0,0,,4-ші қатар - Шиджо көшесі
Dialogue: 0,1:09:15.94,1:09:18.02,Default,,0,0,0,,Осы үшінші және екінші қатар арасында
Dialogue: 0,1:09:18.11,1:09:20.36,Default,,0,0,0,,Санджо көшесі мен Ниджо көшесінің арасы
Dialogue: 0,1:09:20.44,1:09:21.86,Default,,0,0,0,,Ойке көшесі
Dialogue: 0,1:09:22.49,1:09:24.07,Default,,0,0,0,,Дәлелдер...
Dialogue: 0,1:09:24.70,1:09:27.49,Default,,0,0,0,,«Акорн орамы»… Ha…
Dialogue: 0,1:09:27.58,1:09:29.45,Default,,0,0,0,,Келесі солтүстік-оңтүстік көше.
Dialogue: 0,1:09:29.54,1:09:32.54,Default,,0,0,0,,Күлгін гүлдер де, «Көктемгі бұлақ» әнінен
Dialogue: 0,1:09:32.62,1:09:34.17,Default,,0,0,0,,Огава көшесі
Dialogue: 0,1:09:34.25,1:09:37.75,Default,,0,0,0,,Теңгу Қарасума-доридан шыққан.
Dialogue: 0,1:09:37.84,1:09:39.63,Default,,0,0,0,,және Фудзи тауы
Dialogue: 0,1:09:39.71,1:09:42.46,Default,,0,0,0,,Томикодзи көшесі «Томи» кейіпкерінен шыққан.
Dialogue: 0,1:09:43.13,1:09:44.80,Default,,0,0,0,,Тауық дегеніміз не?
Dialogue: 0,1:09:44.88,1:09:46.47,Default,,0,0,0,,Янагава набеден келген Лоч —
Dialogue: 0,1:09:47.09,1:09:49.47,Default,,0,0,0,,Мен оны Янаги Баба көшесінде жасаймын.
Dialogue: 0,1:09:49.56,1:09:51.52,Default,,0,0,0,,Тауық...
Dialogue: 0,1:09:52.02,1:09:54.23,Default,,0,0,0,,А... Нишинотоин көшесі емес пе?
Dialogue: 0,1:09:54.31,1:09:57.69,Default,,0,0,0,,Өйткені әтештің бағыты батыс.
Dialogue: 0,1:09:57.77,1:09:59.90,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,1:10:00.77,1:10:02.69,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,1:10:02.78,1:10:04.78,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:05.28,1:10:08.91,Default,,0,0,0,,Цикадалар Абураземиден Абуранокоджи көшесіне дейін
Dialogue: 0,1:10:08.99,1:10:10.74,Default,,0,0,0,,Теңгу – Қарасума көшесі
Dialogue: 0,1:10:10.83,1:10:12.54,Default,,0,0,0,,Алтын балық ше?
Dialogue: 0,1:10:12.62,1:10:14.79,Default,,0,0,0,,Алтын балыққа жем фучутодан алынады
Dialogue: 0,1:10:14.87,1:10:16.42,Default,,0,0,0,,Фуямачи көшесі
Dialogue: 0,1:10:16.50,1:10:19.71,Default,,0,0,0,,Бір түсті фиалка мен Фудзи тауы
Dialogue: 0,1:10:19.79,1:10:22.25,Default,,0,0,0,,Тауық және бөтен, цикада және алтын балық
Dialogue: 0,1:10:22.34,1:10:24.26,Default,,0,0,0,,Теңге мен теңгені сызықпен қоссаңыз...
Dialogue: 0,1:10:24.34,1:10:26.13,Default,,0,0,0,,-Ах... -(Хедзи) «Патша»?
Dialogue: 0,1:10:26.22,1:10:27.43,Default,,0,0,0,,Не? Патша деген не?
Dialogue: 0,1:10:30.39,1:10:32.43,Default,,0,0,0,,Нүкте, бұл солай емес пе?
Dialogue: 0,1:10:35.02,1:10:35.98,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:36.06,1:10:37.60,Default,,0,0,0,,«Тама» сөзін «гиоку» деп те оқуға болады.
Dialogue: 0,1:10:37.69,1:10:38.90,Default,,0,0,0,,Зергерлік бұйымдардың мағынасы бар
Dialogue: 0,1:10:39.98,1:10:41.40,Default,,0,0,0,,Өлімдік күнәлардың кардиналының оң қолы.
Dialogue: 0,1:10:42.44,1:10:43.61,Default,,0,0,0,,Буккоджи храмы…
Dialogue: 0,1:10:44.28,1:10:48.07,Default,,0,0,0,,Мен қазынаны тауып алған сияқтымын хахахаха...
Dialogue: 0,1:10:49.66,1:10:50.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:51.87,1:10:54.20,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:10:55.33,1:10:57.58,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:10:57.67,1:10:59.17,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:01.71,1:11:02.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:02.84,1:11:04.88,Default,,0,0,0,,Хаха...
Dialogue: 0,1:11:05.71,1:11:06.63,Default,,0,0,0,,Не болды?
Dialogue: 0,1:11:06.72,1:11:09.64,Default,,0,0,0,,Жоқ, менің басым айналып кетті...
Dialogue: 0,1:11:14.81,1:11:15.64,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:11:16.52,1:11:18.14,Default,,0,0,0,,Сіз қалай ойлайсыз? Өзіңізді қалай сезінесіз?
Dialogue: 0,1:11:18.23,1:11:21.65,Default,,0,0,0,,А... олай көп болып кетті.
Dialogue: 0,1:11:22.31,1:11:23.52,Default,,0,0,0,,Хаттори
Dialogue: 0,1:11:23.61,1:11:26.94,Default,,0,0,0,,Сіз 8 жыл бұрын жасырын түрде кірген ғибадатхана Санножи храмы болды, солай ма?
Dialogue: 0,1:11:27.03,1:11:29.49,Default,,0,0,0,,Боу! Неге білмейсің?
Dialogue: 0,1:11:29.57,1:11:30.66,Default,,0,0,0,,Барлоу
Dialogue: 0,1:11:30.74,1:11:34.16,Default,,0,0,0,,Сол кездегі шие гүлдеріне қараған жүзің мені жынды қылды.
Dialogue: 0,1:11:34.24,1:11:37.25,Default,,0,0,0,,Жақын жерде сіз айтқан торлы терезе де бар еді.
Dialogue: 0,1:11:37.33,1:11:38.66,Default,,0,0,0,,Хмм...
Dialogue: 0,1:11:39.16,1:11:43.25,Default,,0,0,0,,Дұрыс, мен анау шие ағашының астынан мына хрусталь шарды таптым.
Dialogue: 0,1:11:44.55,1:11:46.34,Default,,0,0,0,,Егер мен оған демпфер салып жатқан сияқтымын, кешіріңіз.
Dialogue: 0,1:11:46.42,1:11:51.01,Default,,0,0,0,,Бұл хрусталь шарды сенің алғашқы махаббатың түсірген жоқ.
Dialogue: 0,1:11:51.93,1:11:52.93,Default,,0,0,0,,Не?
Dialogue: 0,1:11:53.51,1:11:56.97,Default,,0,0,0,,Санножи храмынан ұрланған будда мүсіні болуы мүмкін.
Dialogue: 0,1:11:57.06,1:11:59.35,Default,,0,0,0,,Маңдайыма таққан ақ қағазым.
Dialogue: 0,1:11:59.44,1:12:00.85,Default,,0,0,0,,Бякко?
Dialogue: 0,1:12:00.94,1:12:04.94,Default,,0,0,0,,Сіз Будданың қастарының арасындағы жылтыр шашқа сілтеме жасайсыз ба?
Dialogue: 0,1:12:05.02,1:12:05.86,Default,,0,0,0,,О
Dialogue: 0,1:12:06.61,1:12:10.28,Default,,0,0,0,,Будда мүсіндері жиі хрусталь шармен бейнелейді.
Dialogue: 0,1:12:10.36,1:12:11.99,Default,,0,0,0,,Но маскаларына да солай.
Dialogue: 0,1:12:13.28,1:12:15.16,Default,,0,0,0,,Менің пікірім мынау.
Dialogue: 0,1:12:15.24,1:12:17.79,Default,,0,0,0,,8 жыл бұрын ұрылар, Гендзи Хотару...
Dialogue: 0,1:12:18.58,1:12:23.21,Default,,0,0,0,,Санно-джи ғибадатханасының негізгі залына жасырын кіріп, құнды будда мүсінін ұрлады.
Dialogue: 0,1:12:26.63,1:12:30.42,Default,,0,0,0,,Алайда, алып бара жатқанда, ақ қағазы шығып, құлап қалды.
Dialogue: 0,1:12:37.43,1:12:40.02,Default,,0,0,0,,Мен көшбасшы Йосицүнэ екенін кейінірек түсіндім.
Dialogue: 0,1:12:40.10,1:12:42.60,Default,,0,0,0,,Мен қол астындағыларымның бірін Санножи храмын іздеуге жібердім.
Dialogue: 0,1:12:43.19,1:12:44.44,Default,,0,0,0,,Сол кезде...
Dialogue: 0,1:12:44.94,1:12:47.15,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:12:56.74,1:12:58.62,Default,,0,0,0,,Мен Зензайды жедім!
Dialogue: 0,1:12:58.70,1:13:00.16,Default,,0,0,0,,Мен Анмицу!
Dialogue: 0,1:13:00.75,1:13:02.41,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,1:13:02.50,1:13:07.50,Default,,0,0,0,,Көшбасшының Будда мүсінін Сакура мырзаның дүкенінің қоймасында сақтаудан басқа амалы қалмады.
Dialogue: 0,1:13:07.59,1:13:10.59,Default,,0,0,0,,Ал 8 жылдан кейін қылмыскер кездейсоқ табылды.
Dialogue: 0,1:13:10.67,1:13:14.22,Default,,0,0,0,,Мен сегіз жыл бұрынғы баланың сен екеніңді білдім.
Dialogue: 0,1:13:14.30,1:13:15.43,Default,,0,0,0,,Сол журнал!
Dialogue: 0,1:13:19.01,1:13:22.64,Default,,0,0,0,,Шамамен сол уақытта қарақшылар арасында оқиға орын алды.
Dialogue: 0,1:13:22.73,1:13:25.60,Default,,0,0,0,,Мүмкін басшы қатты науқастанып қалған шығар.
Dialogue: 0,1:13:26.31,1:13:28.02,Default,,0,0,0,,Өлетінін түсінген көсем
Dialogue: 0,1:13:28.11,1:13:31.57,Default,,0,0,0,,Санно-джи храмынан ұрланған Будда мүсіні басқа жерде жасырылған.
Dialogue: 0,1:13:32.32,1:13:36.49,Default,,0,0,0,,Сол жердің жұмбақ суретін нөкерлеріңізге беріңіз.
Dialogue: 0,1:13:36.57,1:13:39.45,Default,,0,0,0,,Жұмбақ шешкен адам келесі көшбасшы болады.
Dialogue: 0,1:13:39.54,1:13:41.29,Default,,0,0,0,,Мен өсиет қалдырдым.
Dialogue: 0,1:13:42.54,1:13:45.25,Default,,0,0,0,,Сонда мен өліп кетуім мүмкін еді.
Dialogue: 0,1:13:45.33,1:13:47.13,Default,,0,0,0,,Артында қалған қолбасшылар
Dialogue: 0,1:13:47.21,1:13:50.13,Default,,0,0,0,,Мен жұмбақ шешуге көп тырыстым, бірақ шеше алмадым.
Dialogue: 0,1:13:50.21,1:13:51.05,Default,,0,0,0,,Шамамен сол кезде...
Dialogue: 0,1:13:51.84,1:13:56.09,Default,,0,0,0,,Достарымның бірі Сакура мырза маған қылмыскермен қол ұстасуымды айтты.
Dialogue: 0,1:13:57.01,1:13:59.72,Default,,0,0,0,,Сакура мырза қылмыскердің қылыш шеберлігін күтті.
Dialogue: 0,1:13:59.81,1:14:03.06,Default,,0,0,0,,Сіз оны басқа жанкештілерді өлтіруге итермеледіңіз.
Dialogue: 0,1:14:03.14,1:14:04.64,Default,,0,0,0,,Оның үстіне...
Dialogue: 0,1:14:05.23,1:14:07.98,Default,,0,0,0,,Екеуміз Будда мүсіні мен Бякконың қайда екенін анықтаймыз.
Dialogue: 0,1:14:08.06,1:14:10.94,Default,,0,0,0,,Ол менен Будда мүсінін сатудан түскен ақшаны бөлуді өтінді.
Dialogue: 0,1:14:11.02,1:14:12.40,Default,,0,0,0,,О
Dialogue: 0,1:14:12.48,1:14:16.91,Default,,0,0,0,,Ұрылардың ішіндегі жалғызы антиквариат сатушы Сакура мырза болса керек.
Dialogue: 0,1:14:16.99,1:14:20.62,Default,,0,0,0,,Ол ұрланған өнерді сату жолын басқарған болуы керек.
Dialogue: 0,1:14:20.70,1:14:24.08,Default,,0,0,0,,Сондықтан мен жалғыз өзім қауіпсіз болатыныма сенімді болдым.
Dialogue: 0,1:14:24.16,1:14:27.33,Default,,0,0,0,,Кінәлі Сакура-санның әңгімесін пайдаланғандай кейіп танытты.
Dialogue: 0,1:14:27.42,1:14:29.46,Default,,0,0,0,,Менің шын ниетім барлық достарымды о бастан өлтіру болды.
Dialogue: 0,1:14:29.54,1:14:32.34,Default,,0,0,0,,Қазына Мен мұның бәрін өзіме сақтауды мақсат еттім.
Dialogue: 0,1:14:32.42,1:14:34.47,Default,,0,0,0,,Бірақ бәрібір осы мақсат үшін
Dialogue: 0,1:14:34.55,1:14:37.47,Default,,0,0,0,,Көшбасшы қалдырған жұмбақты шешуіміз керек.
Dialogue: 0,1:14:38.05,1:14:39.30,Default,,0,0,0,,Сонымен, кінәлі...
Dialogue: 0,1:14:39.39,1:14:40.93,Default,,0,0,0,,Атақты детектив Когоро Моуриге
Dialogue: 0,1:14:41.01,1:14:42.97,Default,,0,0,0,,Мен сендерге жұмбақ шешуге көмектесу үшін осы ойды ойлап таптым деп ойлаймын.
Dialogue: 0,1:14:45.02,1:14:47.60,Default,,0,0,0,,Буккоджи храмы... осында.
Dialogue: 0,1:14:49.40,1:14:52.94,Default,,0,0,0,,Бірақ шынымен де ішінде жасырынған будда мүсіні бар ма?
Dialogue: 0,1:14:53.03,1:14:55.69,Default,,0,0,0,,А... бірдеңе басқаша сезіледі.
Dialogue: 0,1:14:55.78,1:14:56.95,Default,,0,0,0,,-Ха... -(Хедзи) О... Эй!
Dialogue: 0,1:14:59.82,1:15:00.87,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,1:15:00.95,1:15:03.87,Default,,0,0,0,,Сәлем, құда! Сіз не ойлап отырсыз?
Dialogue: 0,1:15:03.95,1:15:05.62,Default,,0,0,0,,А, бұл...
Dialogue: 0,1:15:10.17,1:15:13.00,Default,,0,0,0,,Гёкурюджи храмы? Бұл суреттегі нүкте ме?
Dialogue: 0,1:15:13.09,1:15:13.92,Default,,0,0,0,,О
Dialogue: 0,1:15:14.00,1:15:15.96,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:15:16.05,1:15:17.72,Default,,0,0,0,,Казуха... мен?
Dialogue: 0,1:15:17.80,1:15:19.30,Default,,0,0,0,,Бұл қызды қамауда ұстады.
Dialogue: 0,1:15:19.38,1:15:20.22,Default,,0,0,0,,А...
Dialogue: 0,1:15:20.30,1:15:24.14,Default,,0,0,0,,Бір сағаттан кейін Курама тауындағы Гёкурюджи храмына өзіңіз келіңіз.
Dialogue: 0,1:15:24.22,1:15:27.43,Default,,0,0,0,,Полицияға хабар берсең қызың өледі.
Dialogue: 0,1:15:27.52,1:15:29.85,Default,,0,0,0,,Хэйдзи Келсең жарайды! Мен өлтіремін!
Dialogue: 0,1:15:29.94,1:15:32.15,Default,,0,0,0,,Казуха? Казуха!
Dialogue: 0,1:15:32.69,1:15:33.52,Default,,0,0,0,,Хаттори?
Dialogue: 0,1:15:33.61,1:15:36.78,Default,,0,0,0,,Казуха... Казуханы ұрлап әкетті.
Dialogue: 0,1:15:36.86,1:15:37.69,Default,,0,0,0,,Не!
Dialogue: 0,1:15:37.78,1:15:41.91,Default,,0,0,0,,Ол маған бір сағаттан кейін Курама тауындағы Гёкурюджи храмына жалғыз келуімді айтты.
Dialogue: 0,1:15:41.99,1:15:43.03,Default,,0,0,0,,Гёкурюджи храмы?
Dialogue: 0,1:15:45.62,1:15:48.66,Default,,0,0,0,,А... Керемет емес пе?
Dialogue: 0,1:15:48.75,1:15:50.25,Default,,0,0,0,,Екеуміз қазір кіреміз...
Dialogue: 0,1:15:50.33,1:15:51.25,Default,,0,0,0,,-(Хедзи) Ух... -Ах!
Dialogue: 0,1:15:51.33,1:15:53.34,Default,,0,0,0,,Уф... Гах...
Dialogue: 0,1:15:53.42,1:15:54.25,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:54.34,1:15:55.25,Default,,0,0,0,,Уф...
Dialogue: 0,1:15:55.34,1:15:56.76,Default,,0,0,0,,Хаттори!
Dialogue: 0,1:16:13.61,1:16:17.57,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:16:17.65,1:16:19.24,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:16:19.32,1:16:20.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:31.54,1:16:32.67,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:16:32.75,1:16:33.96,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:38.21,1:16:39.46,Default,,0,0,0,,Нұсқаушы нұсқаулары және
Dialogue: 0,1:16:39.55,1:16:43.80,Default,,0,0,0,,Қосалқы қылыш Бенкейдің садағында, жебелері алтыбұрышты тартпада.
Dialogue: 0,1:16:43.89,1:16:47.31,Default,,0,0,0,,Мм, Бенкейдің тартпасы...
Dialogue: 0,1:16:47.39,1:16:49.81,Default,,0,0,0,,Жоғарыдан...
Dialogue: 0,1:16:50.52,1:16:53.81,Default,,0,0,0,,Не? Бенкей және алтыбұрышты тартпа
Dialogue: 0,1:16:54.65,1:16:55.81,Default,,0,0,0,,Буккодзи храмы?
Dialogue: 0,1:16:56.40,1:16:59.15,Default,,0,0,0,,Мен сенің бұлай айтқаныңды естідім.
Dialogue: 0,1:17:04.66,1:17:07.99,Default,,0,0,0,,Бұл екеуі шынымен қайда кетті?
Dialogue: 0,1:17:08.08,1:17:10.66,Default,,0,0,0,,Мен Казуха-чанға ұялы телефонына қоңырау шалсам да, ол жауап бермейді...
Dialogue: 0,1:17:10.75,1:17:11.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:11.66,1:17:12.75,Default,,0,0,0,,Гёкурюджи храмы?
Dialogue: 0,1:17:12.83,1:17:14.37,Default,,0,0,0,,Эй, менің қарным ашты.
Dialogue: 0,1:17:14.46,1:17:16.42,Default,,0,0,0,,Мен көремін. Мен үйге келгенде дұрыс боламын.
Dialogue: 0,1:17:16.50,1:17:17.67,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:17:17.75,1:17:21.17,Default,,0,0,0,,Бұл Гёкурюджи храмы қазір қайда?
Dialogue: 0,1:17:21.26,1:17:23.47,Default,,0,0,0,,Бұл Курама тауының артқы жағында.
Dialogue: 0,1:17:23.55,1:17:27.01,Default,,0,0,0,,Мен ғибадатхананың баяғыда қараусыз қалғанын естідім.
Dialogue: 0,1:17:27.10,1:17:29.01,Default,,0,0,0,,А, сәлем
Dialogue: 0,1:17:30.89,1:17:32.27,Default,,0,0,0,,Курама тауы…
Dialogue: 0,1:17:41.19,1:17:42.99,Default,,0,0,0,,Кеш болды.
Dialogue: 0,1:17:43.07,1:17:46.11,Default,,0,0,0,,Мен мұның тұзақ екенін білсем де, оңайлықпен келмес еді!
Dialogue: 0,1:17:46.20,1:17:50.79,Default,,0,0,0,,Меніңше... қорқақтық желінің ұшып кеткен шығар.
Dialogue: 0,1:17:55.08,1:17:56.38,Default,,0,0,0,,Хэйдзи!
Dialogue: 0,1:18:10.56,1:18:13.60,Default,,0,0,0,,Сәлем! Казухамен араласпа.
Dialogue: 0,1:18:13.68,1:18:16.85,Default,,0,0,0,,Ах... Жоқ... Жарайды, Хэйдзи.
Dialogue: 0,1:18:17.48,1:18:20.36,Default,,0,0,0,,Бұл шынымен қалаған нәрсе ме?
Dialogue: 0,1:18:24.57,1:18:27.16,Default,,0,0,0,,Мына кристалды шарды қайтару үшін
Dialogue: 0,1:18:27.24,1:18:29.95,Default,,0,0,0,,Сен кеше маған осы тауда шабуыл жасадың.
Dialogue: 0,1:18:30.03,1:18:31.87,Default,,0,0,0,,Мен сәтсіздікке ұшырадым.
Dialogue: 0,1:18:32.49,1:18:35.37,Default,,0,0,0,,Әрі қарай қазынаны өзіңізге сақтайсыз.
Dialogue: 0,1:18:35.46,1:18:38.50,Default,,0,0,0,,Понточодағы шай дүкенінде Сакура мырзаны өлтірмек болды
Dialogue: 0,1:18:39.17,1:18:42.96,Default,,0,0,0,,Неліктен Джион, Миягава-чо Януте және Понто-чоны таңдадыңыз?
Dialogue: 0,1:18:43.05,1:18:46.30,Default,,0,0,0,,Себебі тек сол шайхананың артында өзен ағып жатыр.
Dialogue: 0,1:18:46.38,1:18:47.22,Default,,0,0,0,,...
Dialogue: 0,1:18:47.30,1:18:48.55,Default,,0,0,0,,Сіз шкафтасыз.
Dialogue: 0,1:18:48.64,1:18:51.72,Default,,0,0,0,,Будда мүсінін іздеп жүрген Сакура мырзаны өлтіргеннен кейін.
Dialogue: 0,1:18:51.81,1:18:55.73,Default,,0,0,0,,Күзет компаниялары жоғалған балалар мен ұрлықтың алдын алу үшін қолданылатын құрылғылар мен қаруларды жинайды.
Dialogue: 0,1:18:55.81,1:18:58.69,Default,,0,0,0,,Мен оны пластик бөтелкеге ​​салып, лақтырып жібердім.
Dialogue: 0,1:19:00.86,1:19:02.61,Default,,0,0,0,,Ал кейін ұялы телефоныңызда
Dialogue: 0,1:19:02.69,1:19:05.74,Default,,0,0,0,,Қауіпсіздік компаниясының басты бетіне кіру
Dialogue: 0,1:19:05.82,1:19:08.36,Default,,0,0,0,,Біз құрылғының орнын зерттеп, оны қалпына келтірдік.
Dialogue: 0,1:19:08.95,1:19:10.12,Default,,0,0,0,,Содан кейін сіз
Dialogue: 0,1:19:10.20,1:19:13.12,Default,,0,0,0,,Мен Осакаға қайтып келе жатқанымда, мотоциклге мініп, мені буксирлеңіз.
Dialogue: 0,1:19:13.20,1:19:15.16,Default,,0,0,0,,Сол қанжармен өлтірмек болды
Dialogue: 0,1:19:18.17,1:19:21.08,Default,,0,0,0,,Бұл өлтіру Казуханың араласуына байланысты сәтсіз аяқталды.
Dialogue: 0,1:19:21.17,1:19:24.96,Default,,0,0,0,,Ол өзін сезікті ретінде алып тастау үшін қасақана кісі өлтіру қаруын, қанжарды қалдырған.
Dialogue: 0,1:19:25.05,1:19:25.96,Default,,0,0,0,,Қылмыскер қанжар ұстаған —
Dialogue: 0,1:19:26.05,1:19:29.01,Default,,0,0,0,,Мені сол шайханадан қашып кеткен адам деп ойлаңыз.
Dialogue: 0,1:19:29.09,1:19:31.76,Default,,0,0,0,,Солай ма? Тайга Сайджо
Dialogue: 0,1:19:31.85,1:19:35.72,Default,,0,0,0,,Жоқ, «Мусашибо Бенкей» деп айту жақсы болар еді.
Dialogue: 0,1:19:41.31,1:19:45.78,Default,,0,0,0,,Наниваның орта мектебінің детективі Яна Хаттори күткендей
Dialogue: 0,1:19:45.86,1:19:47.49,Default,,0,0,0,,Мен екенімді қайдан білдің?
Dialogue: 0,1:19:48.07,1:19:51.82,Default,,0,0,0,,Бұл менің назарымды аударды, өйткені сіз садақ ойнағаныңызды жасырып отырсыз.
Dialogue: 0,1:19:51.91,1:19:53.70,Default,,0,0,0,,Тік отырғанда
Dialogue: 0,1:19:53.78,1:19:56.16,Default,,0,0,0,,Оң аяғымды жарты жолда тартып, отырдым.
Dialogue: 0,1:19:56.24,1:19:58.33,Default,,0,0,0,,Бұл «жарты аяқты тарту» деп аталады.
Dialogue: 0,1:19:58.41,1:19:59.33,Default,,0,0,0,,Садақшы
Dialogue: 0,1:19:59.41,1:20:01.67,Default,,0,0,0,,Менің кейде әдеттен тыс отыруым.
Dialogue: 0,1:20:01.75,1:20:05.13,Default,,0,0,0,,Сондай-ақ садақшы туралы сұрағанда.
Dialogue: 0,1:20:05.21,1:20:08.42,Default,,0,0,0,,Сіз байқаусызда «Ямакура» деп айттыңыз
Dialogue: 0,1:20:09.26,1:20:11.43,Default,,0,0,0,,Бұл туралы айтатын болсақ, Ямакура...
Dialogue: 0,1:20:11.51,1:20:15.97,Default,,0,0,0,,Бұл шай дүкеніндегі Ямакура мырза туралы емес, бұл «Жебе жастығы» болды.
Dialogue: 0,1:20:16.06,1:20:17.93,Default,,0,0,0,,Садақ салу кезінде көрсеткіні жүктеу—
Dialogue: 0,1:20:18.02,1:20:21.94,Default,,0,0,0,,Сол қолдың бас бармақтың артқы бөлігінің екінші буыны.
Dialogue: 0,1:20:22.02,1:20:24.69,Default,,0,0,0,,Осыны айтқыңыз келген шығар.
Dialogue: 0,1:20:24.77,1:20:27.61,Default,,0,0,0,,«Ойланып қарашы, Ямакура жарақат алды».
Dialogue: 0,1:20:27.69,1:20:29.44,Default,,0,0,0,,«Сенга Сузу-сан?»
Dialogue: 0,1:20:30.07,1:20:34.45,Default,,0,0,0,,Ямакура сөзін тек садақ ойнайтындар ғана біледі.
Dialogue: 0,1:20:35.03,1:20:37.83,Default,,0,0,0,,Айтпақшы, Рюен ​​садақ атуға әуесқой.
Dialogue: 0,1:20:37.91,1:20:40.46,Default,,0,0,0,,«Цуру» туралы «ген» дейтін.
Dialogue: 0,1:20:40.54,1:20:42.00,Default,,0,0,0,,Фу…
Dialogue: 0,1:20:42.58,1:20:46.13,Default,,0,0,0,,Мен Рюен ​​және басқалармен бірге қаладағы кендо залына баратынмын.
Dialogue: 0,1:20:46.21,1:20:48.17,Default,,0,0,0,,Сояке Бір кездері
Dialogue: 0,1:20:48.26,1:20:52.18,Default,,0,0,0,,Киотода Йошицунэ мектебі деген ескі мектеп бар екенін білдім.
Dialogue: 0,1:20:52.26,1:20:55.47,Default,,0,0,0,,Мен Йошицүнэ стилін өзім зерттедім.
Dialogue: 0,1:20:55.55,1:21:01.81,Default,,0,0,0,,Содан екі жыл бұрын ол кендо залынан шығып, өзін Йосицүнэ мектебінің мұрагері деп жариялады.
Dialogue: 0,1:21:01.89,1:21:03.94,Default,,0,0,0,,Бенкей Йошицуне мектебі ме?
Dialogue: 0,1:21:04.02,1:21:08.69,Default,,0,0,0,,Мен... Бастапқыда мен Бенкейге қарағанда Йосицюнені жақсы көретінмін.
Dialogue: 0,1:21:08.78,1:21:10.19,Default,,0,0,0,,Мен Йосицүнэ болғым келді!
Dialogue: 0,1:21:10.28,1:21:11.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:11.78,1:21:15.07,Default,,0,0,0,,Бірақ «Ёшицүнэ» оның басына түсті.
Dialogue: 0,1:21:15.16,1:21:17.33,Default,,0,0,0,,Ұрылар тобының басында тұрған менмін.
Dialogue: 0,1:21:17.41,1:21:20.41,Default,,0,0,0,,Неліктен оған «Беңкей» деген лақап ат берілді?
Dialogue: 0,1:21:21.00,1:21:22.66,Default,,0,0,0,,Будда мүсінін кім өзіне қалдыруға тырысты?
Dialogue: 0,1:21:22.75,1:21:24.67,Default,,0,0,0,,Бұл ақша үшін бе?
Dialogue: 0,1:21:24.75,1:21:27.63,Default,,0,0,0,,Иә, бірақ бұл өзімшілдік емес.
Dialogue: 0,1:21:27.71,1:21:30.67,Default,,0,0,0,,Киотода Йошицүнэ стиліндегі дохжо құру.
Dialogue: 0,1:21:30.76,1:21:33.68,Default,,0,0,0,,Бұл ғибадатхананың басшысы – бас діни қызметкер.
Dialogue: 0,1:21:33.76,1:21:36.89,Default,,0,0,0,,Ғибадатхана тастап кеткеннен кейін де оны басқаруды басшы басқарды.
Dialogue: 0,1:21:37.47,1:21:41.22,Default,,0,0,0,,Ол маған Йосицүнэ мектебінде дохжо ретінде пайдалану үшін берді.
Dialogue: 0,1:21:41.31,1:21:46.52,Default,,0,0,0,,Бірақ басы үш ай бұрын өліп, ғибадатхана қиратылды.
Dialogue: 0,1:21:47.11,1:21:49.73,Default,,0,0,0,,Ол бұдан былай дожо ретінде пайдаланылмайды!
Dialogue: 0,1:21:50.48,1:21:52.49,Default,,0,0,0,,Мен сізден бір нәрсе сұрағым келеді.
Dialogue: 0,1:21:52.57,1:21:54.95,Default,,0,0,0,,Рюен-сан оны жай ғана пайдаланып жүр еді, солай емес пе?
Dialogue: 0,1:21:55.03,1:21:58.78,Default,,0,0,0,,Дұрыс, мен будда мүсіндері туралы бұрын естігенмін.
Dialogue: 0,1:21:58.87,1:22:01.91,Default,,0,0,0,,Егер мен бұл хатты Санножи храмына жеткізсем.
Dialogue: 0,1:22:02.00,1:22:04.50,Default,,0,0,0,,Мен күткендей, сізбен кеңесуге келдім.
Dialogue: 0,1:22:04.58,1:22:09.38,Default,,0,0,0,,Сондықтан мен Когоро Мориден өтініш жасауды өтіндім.
Dialogue: 0,1:22:09.46,1:22:12.01,Default,,0,0,0,,Мм... Мен шие гүлін жасадым.
Dialogue: 0,1:22:12.09,1:22:14.05,Default,,0,0,0,,Сол кісінің көмегін алсам да
Dialogue: 0,1:22:14.13,1:22:16.84,Default,,0,0,0,,Себебі мен Будда мүсінін сататын біреуді таптым.
Dialogue: 0,1:22:16.93,1:22:20.64,Default,,0,0,0,,Қазіргі уақытта Интернет деген ыңғайлы нәрсе бар.
Dialogue: 0,1:22:20.72,1:22:23.73,Default,,0,0,0,,Міне, әңгімеміз аяқталды.
Dialogue: 0,1:22:23.81,1:22:26.31,Default,,0,0,0,,Маған сол хрусталь шарды бере аласыз ба?
Dialogue: 0,1:22:26.39,1:22:28.40,Default,,0,0,0,,Оны тапсырудың орнына, Казуханы жібер!
Dialogue: 0,1:22:28.48,1:22:32.32,Default,,0,0,0,,Иә, Будда мүсінінің қайда жасырылғанын айтып берсеңіз.
Dialogue: 0,1:22:32.40,1:22:33.32,Default,,0,0,0,,Не!
Dialogue: 0,1:22:33.40,1:22:34.24,Default,,0,0,0,,Уф...
Dialogue: 0,1:22:34.32,1:22:36.11,Default,,0,0,0,,Келіңіздер! Будда мүсіні қайда?
Dialogue: 0,1:22:36.86,1:22:38.41,Default,,0,0,0,,Осы ғибадатханада
Dialogue: 0,1:22:38.49,1:22:39.53,Default,,0,0,0,,Не!
Dialogue: 0,1:22:39.62,1:22:41.74,Default,,0,0,0,,Маяк қараңғы жер ме?
Dialogue: 0,1:22:41.83,1:22:42.99,Default,,0,0,0,,Өтірікші!
Dialogue: 0,1:22:43.08,1:22:45.71,Default,,0,0,0,,Мен бұл ғибадатхананы зерттеп қойғанмын! еш жерде...
Dialogue: 0,1:22:45.79,1:22:47.12,Default,,0,0,0,,Бұл өтірік емес!
Dialogue: 0,1:22:51.80,1:22:52.84,Default,,0,0,0,,Уф...
Dialogue: 0,1:23:02.60,1:23:04.47,Default,,0,0,0,,Ха... Казуха жүгір!
Dialogue: 0,1:23:04.56,1:23:05.98,Default,,0,0,0,,- (Сайджо) Иә! -(Казуба) Хэдзи!
Dialogue: 0,1:23:06.06,1:23:07.35,Default,,0,0,0,,Уф!
Dialogue: 0,1:23:07.44,1:23:09.65,Default,,0,0,0,,- (Сайджо) Эй! -(Хедзи) Уф!
Dialogue: 0,1:23:12.69,1:23:13.53,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:19.45,1:23:20.57,Default,,0,0,0,,Уф...
Dialogue: 0,1:23:21.95,1:23:23.28,Default,,0,0,0,,Хмм...
Dialogue: 0,1:23:23.37,1:23:27.12,Default,,0,0,0,,Хехехе... Менің сүйкімді шәкірттерім.
Dialogue: 0,1:23:27.21,1:23:29.33,Default,,0,0,0,,Менімен араласпа!
Dialogue: 0,1:23:30.08,1:23:31.17,Default,,0,0,0,,Уф...
Dialogue: 0,1:23:31.25,1:23:32.46,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,1:23:33.92,1:23:35.26,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:35.34,1:23:36.17,Default,,0,0,0,,Хэйдзи!
Dialogue: 0,1:23:36.26,1:23:37.84,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,1:23:39.47,1:23:40.34,Default,,0,0,0,,Ха…
Dialogue: 0,1:23:40.43,1:23:42.85,Default,,0,0,0,,Тоқта! Бұл адамның аты Хэйдзи!
Dialogue: 0,1:23:42.93,1:23:44.22,Default,,0,0,0,,- (Сайджо) Жасай берейік! -(Хедзи) Ух...
Dialogue: 0,1:23:44.76,1:23:46.18,Default,,0,0,0,,Ха…
Dialogue: 0,1:23:47.23,1:23:48.64,Default,,0,0,0,,Уф...
Dialogue: 0,1:23:50.23,1:23:51.19,Default,,0,0,0,,Я...
Dialogue: 0,1:23:51.27,1:23:52.90,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:23:53.48,1:23:54.98,Default,,0,0,0,,Бұл кім? Сіз!
Dialogue: 0,1:23:55.98,1:23:57.49,Default,,0,0,0,,Шиничи Кудо...
Dialogue: 0,1:23:57.57,1:23:58.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:59.57,1:24:00.82,Default,,0,0,0,,Детектив
Dialogue: 0,1:24:00.91,1:24:02.32,Default,,0,0,0,,Не!
Dialogue: 0,1:24:02.41,1:24:05.33,Default,,0,0,0,,Не? Сіз мені бұл дәріні қабылдауға мәжбүр еттіңіз бе?
Dialogue: 0,1:24:06.45,1:24:08.04,Default,,0,0,0,,Телефондағы Кудо-куннан
Dialogue: 0,1:24:08.12,1:24:13.00,Default,,0,0,0,,Менен Шиничи Кудоға уақытша болса да қайта оралудың жолы бар ма деп сұрады.
Dialogue: 0,1:24:13.84,1:24:18.55,Default,,0,0,0,,Бірақ APTX4869 үшін антидот прототипі енді жоқ.
Dialogue: 0,1:24:18.63,1:24:23.26,Default,,0,0,0,,Бұрын Широ Цианджи оны суыққа қарсы дәрі ретінде қабылдағаннан кейін қалыпты денесіне орала алатын.
Dialogue: 0,1:24:23.34,1:24:26.06,Default,,0,0,0,,Антиденелер дамып, енді тиімді емес.
Dialogue: 0,1:24:26.14,1:24:28.60,Default,,0,0,0,,Осы кезде кенет маған бір ой келді.
Dialogue: 0,1:24:28.68,1:24:32.44,Default,,0,0,0,,Қатты суық тиюге ұқсас белгілерді тудыратын дәріні қабылдаңыз.
Dialogue: 0,1:24:32.52,1:24:35.06,Default,,0,0,0,,Егер тағы да ақ дэнджи ішсеңіз...
Dialogue: 0,1:24:35.69,1:24:39.57,Default,,0,0,0,,Олар сіздің бастапқы денеңізге кем дегенде бір рет оралуыңыз мүмкін екенін айтады.
Dialogue: 0,1:24:39.65,1:24:41.57,Default,,0,0,0,,Сонда... сонда?
Dialogue: 0,1:24:42.66,1:24:45.33,Default,,0,0,0,,Күтілгендей, эксперимент өте сәтті өтті.
Dialogue: 0,1:24:45.41,1:24:47.79,Default,,0,0,0,,Кудо-кун өзінің бастапқы денесіне оралды.
Dialogue: 0,1:24:48.62,1:24:51.25,Default,,0,0,0,,Бірақ бұл қатты суық тигенмен бірдей.
Dialogue: 0,1:24:51.33,1:24:54.75,Default,,0,0,0,,Денем дірілдеп, өміріме кепілдік бере алмаймын.
Dialogue: 0,1:24:54.83,1:24:57.17,Default,,0,0,0,,...Сонымен Хэйдзи-кунның жағдайы қалай?
Dialogue: 0,1:24:57.25,1:24:58.13,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,1:24:58.21,1:25:01.59,Default,,0,0,0,,Ертең толық тексеруден өткенше демалатын сияқты.
Dialogue: 0,1:25:01.67,1:25:04.72,Default,,0,0,0,,Маған оны бақылап отыруды өтінді.
Dialogue: 0,1:25:04.80,1:25:05.64,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:07.72,1:25:08.77,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:09.39,1:25:10.23,Default,,0,0,0,,Ха…
Dialogue: 0,1:25:13.19,1:25:14.81,Default,,0,0,0,,Кудо-кун?
Dialogue: 0,1:25:17.44,1:25:19.98,Default,,0,0,0,,Ей, сен мені алдадың.
Dialogue: 0,1:25:29.95,1:25:32.33,Default,,0,0,0,,Мен оның қашып кетуіне мүмкіндік берсем екен.
Dialogue: 0,1:25:32.41,1:25:34.17,Default,,0,0,0,,Менің денем мен қалағандай қозғалмайды
Dialogue: 0,1:25:34.25,1:25:35.25,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,1:25:35.33,1:25:36.42,Default,,0,0,0,,Гррр…
Dialogue: 0,1:25:37.04,1:25:40.26,Default,,0,0,0,,Жоқ... Широ-кэнджидің әсері әлдеқашан тозды...
Dialogue: 0,1:25:40.34,1:25:41.17,Default,,0,0,0,,Ха…
Dialogue: 0,1:25:41.26,1:25:43.09,Default,,0,0,0,,Хмм!
Dialogue: 0,1:25:43.17,1:25:44.63,Default,,0,0,0,,Орындалды!
Dialogue: 0,1:25:45.26,1:25:46.30,Default,,0,0,0,,Гррр…
Dialogue: 0,1:25:46.39,1:25:49.26,Default,,0,0,0,,Егер мен детектив болсам, мен әлемдегі ең жақсы болар едім...
Dialogue: 0,1:25:49.85,1:25:51.18,Default,,0,0,0,,Самурай ретінде...
Dialogue: 0,1:25:51.98,1:25:53.18,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,1:25:53.27,1:25:55.19,Default,,0,0,0,,- (Шиничи) Хаттори... - (Казуба) Хэйдзи!
Dialogue: 0,1:25:55.27,1:25:56.86,Default,,0,0,0,,Күткенім үшін кешіріңіз, Казуха
Dialogue: 0,1:25:56.94,1:26:01.57,Default,,0,0,0,,Не... Сізді «күтуге» не мәжбүр етті? Доахо! Осы уақытқа дейін не істедің?
Dialogue: 0,1:26:02.78,1:26:03.61,Default,,0,0,0,,Нвааах!
Dialogue: 0,1:26:04.20,1:26:05.03,Default,,0,0,0,,Сәлем, құда!
Dialogue: 0,1:26:05.11,1:26:06.16,Default,,0,0,0,,Таа!
Dialogue: 0,1:26:06.78,1:26:09.20,Default,,0,0,0,,Менің киімімді де ұрладың!
Dialogue: 0,1:26:09.28,1:26:10.12,Default,,0,0,0,,Және...
Dialogue: 0,1:26:10.99,1:26:14.46,Default,,0,0,0,,Оған не қойғаныңды білмеймін, бірақ мен онша қараңғы емеспін.
Dialogue: 0,1:26:14.54,1:26:16.21,Default,,0,0,0,,А... шынымен бе?
Dialogue: 0,1:26:16.29,1:26:19.50,Default,,0,0,0,,Жарайды, мен мұны істеймін, сен кет!
Dialogue: 0,1:26:20.21,1:26:22.67,Default,,0,0,0,,Кішкентай болғанша бір жерге тығыл.
Dialogue: 0,1:26:22.76,1:26:24.97,Default,,0,0,0,,Қалыпты күйге оралған кезде оралыңыз.
Dialogue: 0,1:26:28.05,1:26:28.89,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:26:28.97,1:26:31.39,Default,,0,0,0,,Мен сенің қарсыласыңмын!
Dialogue: 0,1:26:31.47,1:26:32.60,Default,,0,0,0,,Таа!
Dialogue: 0,1:26:33.43,1:26:36.31,Default,,0,0,0,,Казуха Кудомен кездескеніңді ешкімге айтпа!
Dialogue: 0,1:26:36.39,1:26:37.23,Default,,0,0,0,,Әй!
Dialogue: 0,1:26:37.31,1:26:38.40,Default,,0,0,0,,Тіпті анау апа!
Dialogue: 0,1:26:38.48,1:26:40.02,Default,,0,0,0,,А, Ран-Чан үшін де ме? неге?
Dialogue: 0,1:26:40.69,1:26:42.03,Default,,0,0,0,,Кез келген нәрсе
Dialogue: 0,1:26:42.11,1:26:44.03,Default,,0,0,0,,Мен сені бәрібір көре алмаймын.
Dialogue: 0,1:26:44.69,1:26:46.24,Default,,0,0,0,,Білмеу жақсы
Dialogue: 0,1:26:46.32,1:26:47.86,Default,,0,0,0,,- (Хейджи) Иә! Тат! -(Шәкірт) Уау...
Dialogue: 0,1:26:50.78,1:26:53.16,Default,,0,0,0,,Екеуің де үйге аман оралуларыңа тілектеспін!
Dialogue: 0,1:26:53.24,1:26:54.87,Default,,0,0,0,,Ха! Тат!
Dialogue: 0,1:26:54.95,1:26:56.96,Default,,0,0,0,,- (Сайджо) Иә! -(Хедзи) Уау!
Dialogue: 0,1:26:57.04,1:26:58.96,Default,,0,0,0,,Бұл қылыш тым тәтті!
Dialogue: 0,1:26:59.67,1:27:00.50,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:27:00.59,1:27:01.79,Default,,0,0,0,,Уф...
Dialogue: 0,1:27:02.63,1:27:03.84,Default,,0,0,0,,(Кристи) Ах! (Нат) Ах…
Dialogue: 0,1:27:07.63,1:27:09.05,Default,,0,0,0,,- (Шәкірт) Әй, қарның аш па? -(Жүгіріп) Ха...
Dialogue: 0,1:27:09.14,1:27:11.05,Default,,0,0,0,,-(Шәкірт) Мадая -(Шәкірт) Оны ізде!
Dialogue: 0,1:27:11.14,1:27:13.43,Default,,0,0,0,,Не? Не...
Dialogue: 0,1:27:13.51,1:27:15.48,Default,,0,0,0,,- (Жүгіріп) Мм... - (Ер) Тынш... тыныш.
Dialogue: 0,1:27:15.56,1:27:16.60,Default,,0,0,0,,Тыныш отырыңыз
Dialogue: 0,1:27:26.57,1:27:27.40,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:27:28.28,1:27:29.41,Default,,0,0,0,,Шиничи!
Dialogue: 0,1:27:29.49,1:27:32.62,Default,,0,0,0,,Сол кездегі бет.
Dialogue: 0,1:27:32.70,1:27:34.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:34.20,1:27:36.20,Default,,0,0,0,,Не болды?
Dialogue: 0,1:27:36.29,1:27:37.79,Default,,0,0,0,,Терге малындым.
Dialogue: 0,1:27:37.87,1:27:41.04,Default,,0,0,0,,Ал не? бұрынғы адамдар
Dialogue: 0,1:27:42.46,1:27:43.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:44.67,1:27:45.51,Default,,0,0,0,,Хмм...
Dialogue: 0,1:27:45.59,1:27:46.63,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,1:27:46.71,1:27:48.63,Default,,0,0,0,,Жоқ, қайтайық!
Dialogue: 0,1:27:50.30,1:27:52.80,Default,,0,0,0,,Өкінішті, Ран, мен сені қазір кездестіре алмаймын...
Dialogue: 0,1:27:52.89,1:27:54.10,Default,,0,0,0,,Уф!
Dialogue: 0,1:27:54.18,1:27:55.64,Default,,0,0,0,,Уф...
Dialogue: 0,1:27:55.72,1:27:59.56,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:27:59.64,1:28:03.11,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:28:03.19,1:28:05.07,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:28:05.15,1:28:06.78,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:28:12.70,1:28:15.08,Default,,0,0,0,,Есік құлыпталған және ашылмайды!
Dialogue: 0,1:28:15.16,1:28:16.12,Default,,0,0,0,,Бірдеңе істе!
Dialogue: 0,1:28:16.20,1:28:17.95,Default,,0,0,0,,Не? Бұл татами иісі...
Dialogue: 0,1:28:18.71,1:28:20.21,Default,,0,0,0,,Мені күштеп кіргізген бөлме
Dialogue: 0,1:28:20.29,1:28:21.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:21.58,1:28:24.42,Default,,0,0,0,,Сәлем! Маған балта әкел!
Dialogue: 0,1:28:24.50,1:28:27.92,Default,,0,0,0,,Шүкір... оның сынуы аз ғана.
Dialogue: 0,1:28:28.55,1:28:30.51,Default,,0,0,0,,Қару ретінде қолдануға болатын нәрсе бар ма?
Dialogue: 0,1:28:30.59,1:28:31.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:34.51,1:28:38.10,Default,,0,0,0,,Не? Көптеген жәшіктері бар жәшік
Dialogue: 0,1:28:39.27,1:28:40.10,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:40.18,1:28:44.27,Default,,0,0,0,,«Қосалқы қылышты Бенкейдің жәшігінде, ал садақ пен жебені алтыбұрышты тартпада сақта».
Dialogue: 0,1:28:44.36,1:28:47.78,Default,,0,0,0,,Хэйдзи Қылыш Бенкейдің жәшігінде.
Dialogue: 0,1:28:47.86,1:28:49.94,Default,,0,0,0,,Не? Бұл жәшік па?
Dialogue: 0,1:28:50.03,1:28:50.95,Default,,0,0,0,,Иә
Dialogue: 0,1:28:51.03,1:28:52.99,Default,,0,0,0,,Бірақ Джё-сан тым көп
Dialogue: 0,1:28:53.07,1:28:55.99,Default,,0,0,0,,Қайсысы Бенкейдің тартпасы екенін білмеймін.
Dialogue: 0,1:28:56.08,1:29:02.04,Default,,0,0,0,,(есіктің сынған дыбысы)
Dialogue: 0,1:29:05.59,1:29:07.46,Default,,0,0,0,,Мен мұны бір жерден көргендей сезінемін...
Dialogue: 0,1:29:07.55,1:29:08.38,Default,,0,0,0,,Ха…
Dialogue: 0,1:29:09.67,1:29:12.63,Default,,0,0,0,,Бұл жетекші сызық Киотодағы көшемен бірдей ме?
Dialogue: 0,1:29:12.72,1:29:13.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:21.14,1:29:22.73,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,1:29:22.81,1:29:25.81,Default,,0,0,0,,Бұл жол, Карасума көшесі, Такоякуши көшесі,
Dialogue: 0,1:29:26.65,1:29:28.11,Default,,0,0,0,,Күтіңіз...
Dialogue: 0,1:29:28.19,1:29:31.82,Default,,0,0,0,,Мүмкін олар жәшіктерді жер атауларынан кейін атайтын шығар?
Dialogue: 0,1:29:31.90,1:29:33.24,Default,,0,0,0,,Жер аты?
Dialogue: 0,1:29:33.32,1:29:35.16,Default,,0,0,0,,(Сыну дыбысы)
Dialogue: 0,1:29:35.24,1:29:36.37,Default,,0,0,0,,Иә!
Dialogue: 0,1:29:36.99,1:29:38.37,Default,,0,0,0,,“Роккаку” – Роккакудо
Dialogue: 0,1:29:39.45,1:29:41.37,Default,,0,0,0,,Бенкейдің тартпасы...
Dialogue: 0,1:29:43.79,1:29:45.08,Default,,0,0,0,,Бенкей тасы туралы!
Dialogue: 0,1:29:45.17,1:29:47.59,Default,,0,0,0,,Санджо Фуячо Хигашиге кіріңіз...
Dialogue: 0,1:29:47.67,1:29:49.05,Default,,0,0,0,,Темари әні!
Dialogue: 0,1:29:49.13,1:29:52.13,Default,,0,0,0,,Е, Марутаке Ебису...
Dialogue: 0,1:29:52.67,1:29:54.72,Default,,0,0,0,,Марутаке Эбису...
Dialogue: 0,1:29:54.80,1:29:56.59,Default,,0,0,0,,А, енді не болады?
Dialogue: 0,1:29:56.68,1:29:58.39,Default,,0,0,0,,(Сыну дыбысы)
Dialogue: 0,1:29:58.47,1:30:00.52,Default,,0,0,0,,А, қарғыс атқыр, есімде жоқ...
Dialogue: 0,1:30:00.60,1:30:02.39,Default,,0,0,0,,♪ Марутаке Эбисуни
Dialogue: 0,1:30:02.48,1:30:04.48,Default,,0,0,0,,♪ Жаза
Dialogue: 0,1:30:04.56,1:30:06.52,Default,,0,0,0,,♪ Йомесан Роккаку
Dialogue: 0,1:30:06.60,1:30:08.52,Default,,0,0,0,,♪ Сегізаяқ
Dialogue: 0,1:30:08.61,1:30:11.19,Default,,0,0,0,,Хэйдзи Санджо «Такодан» екі жыл алда!
Dialogue: 0,1:30:11.28,1:30:12.11,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,1:30:12.19,1:30:15.03,Default,,0,0,0,,«Сегізаяқтан» жоғары екі деңгей Шығыс және батыс көшелері…
Dialogue: 0,1:30:15.11,1:30:16.95,Default,,0,0,0,,Терагоко Фуятоми…
Dialogue: 0,1:30:17.03,1:30:18.37,Default,,0,0,0,,Фуячо - үшінші!
Dialogue: 0,1:30:18.45,1:30:19.28,Default,,0,0,0,,Кокоя!
Dialogue: 0,1:30:19.37,1:30:20.28,Default,,0,0,0,,Әй!
Dialogue: 0,1:30:20.37,1:30:21.74,Default,,0,0,0,,Ах!
Dialogue: 0,1:30:21.83,1:30:23.54,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,1:30:24.54,1:30:26.17,Default,,0,0,0,,Иә!
Dialogue: 0,1:30:32.55,1:30:33.63,Default,,0,0,0,,Хмм...
Dialogue: 0,1:30:33.71,1:30:34.92,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,1:30:38.30,1:30:39.14,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:39.22,1:30:42.56,Default,,0,0,0,,Бұл алдыңғы және артқы жағында бірегей жүз үлгісі бар...
Dialogue: 0,1:30:43.14,1:30:45.06,Default,,0,0,0,,«Мурамаса» жын қылыш
Dialogue: 0,1:30:45.14,1:30:46.19,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:30:47.06,1:30:51.73,Default,,0,0,0,,Йошицүне иеленген құбыжық - кесуге болатын қылыш қана!
Dialogue: 0,1:30:51.82,1:30:53.15,Default,,0,0,0,,Не!
Dialogue: 0,1:30:55.15,1:30:56.45,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,1:30:57.03,1:30:57.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:57.95,1:30:59.66,Default,,0,0,0,,Иә! Уф!
Dialogue: 0,1:31:01.91,1:31:04.58,Default,,0,0,0,,Сіз не істеп жатырсыз? Тездетіп, маған еріңіз!
Dialogue: 0,1:31:04.66,1:31:05.87,Default,,0,0,0,,О!
Dialogue: 0,1:31:05.96,1:31:08.67,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:31:09.29,1:31:11.21,Default,,0,0,0,,Иә? Мен оны тартамын
Dialogue: 0,1:31:11.29,1:31:12.67,Default,,0,0,0,,Бұл мүмкіндікті пайдаланып, қашыңыз!
Dialogue: 0,1:31:13.25,1:31:15.17,Default,,0,0,0,,Жоқ! Мен де...
Dialogue: 0,1:31:15.76,1:31:17.18,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:31:17.26,1:31:18.80,Default,,0,0,0,,Ха... Хэдзи...
Dialogue: 0,1:31:18.89,1:31:20.18,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:31:20.68,1:31:21.51,Default,,0,0,0,,Жүр!
Dialogue: 0,1:31:23.85,1:31:26.27,Default,,0,0,0,,(Сайджо және оның достарының ізі)
Dialogue: 0,1:31:27.44,1:31:29.77,Default,,0,0,0,,Менің қызымды ұстайсың ба?
Dialogue: 0,1:31:29.85,1:31:30.77,Default,,0,0,0,,О!
Dialogue: 0,1:31:31.86,1:31:33.02,Default,,0,0,0,,Нвааах!
Dialogue: 0,1:31:34.23,1:31:35.15,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:31:35.23,1:31:36.07,Default,,0,0,0,,Уф!
Dialogue: 0,1:31:36.15,1:31:37.11,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:37.20,1:31:38.20,Default,,0,0,0,,- (Шәкірт) Ах! -(Шәкірт) Уф!
Dialogue: 0,1:31:38.28,1:31:39.20,Default,,0,0,0,,Әй!
Dialogue: 0,1:31:39.91,1:31:40.74,Default,,0,0,0,,Уф!
Dialogue: 0,1:31:41.37,1:31:42.33,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:31:42.41,1:31:44.29,Default,,0,0,0,,Казуха-ни-чан мен Хэйдзи-ничан ше?
Dialogue: 0,1:31:44.37,1:31:45.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:48.75,1:31:50.29,Default,,0,0,0,,А... Ақко!
Dialogue: 0,1:31:50.88,1:31:51.88,Default,,0,0,0,,Хаттори!
Dialogue: 0,1:31:51.96,1:31:52.79,Default,,0,0,0,,Ха…
Dialogue: 0,1:31:56.67,1:32:01.01,Default,,0,0,0,,Шүкір, мен полицияға хабарлағым келеді, бірақ ұялы телефоным ауқымнан тыс...
Dialogue: 0,1:32:01.09,1:32:02.47,Default,,0,0,0,,Ха…
Dialogue: 0,1:32:02.55,1:32:03.55,Default,,0,0,0,,Міне!
Dialogue: 0,1:32:05.47,1:32:06.31,Default,,0,0,0,,Әй!
Dialogue: 0,1:32:10.48,1:32:11.81,Default,,0,0,0,,- (Шәкірттері) Әй... - (Қазуба) Әй?
Dialogue: 0,1:32:20.40,1:32:21.99,Default,,0,0,0,,Эй, оны дереу өшір!
Dialogue: 0,1:32:22.07,1:32:23.45,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,1:32:25.08,1:32:28.04,Default,,0,0,0,,Жарайды, егер біреу бұл өртті байқаса...
Dialogue: 0,1:32:28.70,1:32:30.83,Default,,0,0,0,,Сәлем! Эй Ран!
Dialogue: 0,1:32:30.92,1:32:32.71,Default,,0,0,0,,Хмм... га...
Dialogue: 0,1:32:33.79,1:32:35.13,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,1:32:35.21,1:32:36.80,Default,,0,0,0,,Әкем…
Dialogue: 0,1:32:39.09,1:32:40.72,Default,,0,0,0,,- (Жүгіріп) Шиничи ше? - (Когоро) Иә?
Dialogue: 0,1:32:40.80,1:32:44.68,Default,,0,0,0,,Сіз жартылай ұйықтап жатырсыз ба? Оның мұнда болуы мүмкін емес.
Dialogue: 0,1:32:44.76,1:32:47.52,Default,,0,0,0,,Ең бастысы, сен неге мұндай жерде ұйықтап жатырсың?
Dialogue: 0,1:32:47.60,1:32:50.06,Default,,0,0,0,,Әке, сіз мұнда не үшін келдіңіз?
Dialogue: 0,1:32:50.14,1:32:51.69,Default,,0,0,0,,Мен сізге хабарладым.
Dialogue: 0,1:32:51.77,1:32:54.69,Default,,0,0,0,,Казуха-кунды Гендзи Хотару ұрлап әкетті...
Dialogue: 0,1:32:54.77,1:32:56.69,Default,,0,0,0,,- (Аққу) Моури-сан! -(Когоро) Не...
Dialogue: 0,1:33:04.03,1:33:06.45,Default,,0,0,0,,(Өрт сөндіргіш ағынының дыбысы)
Dialogue: 0,1:33:09.54,1:33:12.75,Default,,0,0,0,,Енді шешейік.
Dialogue: 0,1:33:14.54,1:33:16.54,Default,,0,0,0,,Қалауыңызша!
Dialogue: 0,1:33:16.63,1:33:17.67,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,1:33:17.75,1:33:18.59,Default,,0,0,0,,Таа!
Dialogue: 0,1:33:21.88,1:33:23.97,Default,,0,0,0,,Мен бір қимылды екі рет жасамаймын
Dialogue: 0,1:33:24.05,1:33:26.30,Default,,0,0,0,,Міне... мінекей!
Dialogue: 0,1:33:26.39,1:33:28.47,Default,,0,0,0,,Иә? Кодачи?
Dialogue: 0,1:33:29.10,1:33:31.23,Default,,0,0,0,,Кішкентай қылыш
Dialogue: 0,1:33:31.31,1:33:34.23,Default,,0,0,0,,Ол өте тиімді умен қапталған!
Dialogue: 0,1:33:34.31,1:33:35.81,Default,,0,0,0,,О... не?
Dialogue: 0,1:33:35.90,1:33:38.82,Default,,0,0,0,,Кішкентай болса да, жоғалтсаң, Одабутсу.
Dialogue: 0,1:33:40.90,1:33:42.82,Default,,0,0,0,,Қандай қорқақ!
Dialogue: 0,1:33:42.90,1:33:43.99,Default,,0,0,0,,Иә!
Dialogue: 0,1:33:45.45,1:33:46.49,Default,,0,0,0,,О...
Dialogue: 0,1:33:47.99,1:33:49.16,Default,,0,0,0,,Хмм...
Dialogue: 0,1:33:51.62,1:33:52.66,Default,,0,0,0,,Иә!
Dialogue: 0,1:33:53.25,1:33:55.67,Default,,0,0,0,,Хмм...
Dialogue: 0,1:33:56.71,1:33:57.92,Default,,0,0,0,,Эй!
Dialogue: 0,1:33:58.50,1:33:59.71,Default,,0,0,0,,Ах! Арх!
Dialogue: 0,1:33:59.80,1:34:01.09,Default,,0,0,0,,Уф...
Dialogue: 0,1:34:02.51,1:34:03.72,Default,,0,0,0,,Уф...
Dialogue: 0,1:34:04.51,1:34:06.93,Default,,0,0,0,,Хмм... уф...
Dialogue: 0,1:34:09.51,1:34:11.35,Default,,0,0,0,,Жоқ! Хэйдзиге қауіп төніп тұр!
Dialogue: 0,1:34:11.43,1:34:13.77,Default,,0,0,0,,Енді қашып құтыла алмайсың.
Dialogue: 0,1:34:13.85,1:34:15.85,Default,,0,0,0,,Ол төменнен садақпен көздеп тұр.
Dialogue: 0,1:34:15.94,1:34:17.15,Default,,0,0,0,,Ха…
Dialogue: 0,1:34:21.78,1:34:23.28,Default,,0,0,0,,Бірдеңе істе...
Dialogue: 0,1:34:24.15,1:34:25.95,Default,,0,0,0,,- (Казуба) Конан-кун? -(Шәкірт) Күте тұрыңыз!
Dialogue: 0,1:34:26.03,1:34:27.45,Default,,0,0,0,,- (Қазуба) Әй! -(Шәкірт) А...
Dialogue: 0,1:34:29.74,1:34:31.16,Default,,0,0,0,,Әй, міне!
Dialogue: 0,1:34:31.24,1:34:32.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:34:33.79,1:34:34.83,Default,,0,0,0,,Әй!
Dialogue: 0,1:34:46.59,1:34:48.43,Default,,0,0,0,,Жеңдер!
Dialogue: 0,1:34:51.26,1:34:52.64,Default,,0,0,0,,Уау!
Dialogue: 0,1:34:52.72,1:34:53.77,Default,,0,0,0,,Ах!
Dialogue: 0,1:34:54.35,1:34:56.02,Default,,0,0,0,,- (Қазуба) Әй! -Аа...
Dialogue: 0,1:34:56.60,1:34:57.98,Default,,0,0,0,,Жүр! Хаттори!
Dialogue: 0,1:34:58.06,1:34:59.02,Default,,0,0,0,,Хэйдзи!
Dialogue: 0,1:34:59.90,1:35:00.94,Default,,0,0,0,,Фу…
Dialogue: 0,1:35:07.20,1:35:08.36,Default,,0,0,0,,- (Хедзи) Ия! - (Сайджо) Эй!
Dialogue: 0,1:35:09.16,1:35:10.28,Default,,0,0,0,,Таа!
Dialogue: 0,1:35:10.37,1:35:11.74,Default,,0,0,0,,Уф!
Dialogue: 0,1:35:12.62,1:35:13.91,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:13.99,1:35:17.42,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:35:27.51,1:35:30.26,Default,,0,0,0,,Бенкей Йошицүнэ болғысы келді ме?
Dialogue: 0,1:35:30.34,1:35:35.43,Default,,0,0,0,,Егер сіз Бенкейді ойнасаңыз, Ёсицүнэ Атака Секиде өлтірілген болар еді.
Dialogue: 0,1:35:35.52,1:35:37.39,Default,,0,0,0,,Шебер жеңілді!
Dialogue: 0,1:35:38.06,1:35:39.27,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,1:35:39.98,1:35:41.02,Default,,0,0,0,,Әй!
Dialogue: 0,1:35:41.56,1:35:43.11,Default,,0,0,0,,- (Шәкірт) Уф! -(Шәкірт) Уау!
Dialogue: 0,1:35:44.48,1:35:45.94,Default,,0,0,0,,Доя!
Dialogue: 0,1:35:46.44,1:35:47.70,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:47.78,1:35:48.90,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:35:48.99,1:35:49.86,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:49.95,1:35:51.49,Default,,0,0,0,,Хмф…
Dialogue: 0,1:35:53.37,1:35:55.20,Default,,0,0,0,,- (Аянокоджи) Барлығы қамауға алынды! -(Офицерлер) Ха!
Dialogue: 0,1:35:55.29,1:35:57.00,Default,,0,0,0,,Сізге жақсы, Конан-кун.
Dialogue: 0,1:35:57.08,1:35:58.12,Default,,0,0,0,,Иә!
Dialogue: 0,1:35:58.21,1:36:01.54,Default,,0,0,0,,Бірақ сіз Хэйдзиді «Хаттори» деп атай бастадыңыз.
Dialogue: 0,1:36:01.63,1:36:03.50,Default,,0,0,0,,Кешіріңіз, мен жай ғана толқып кеттім...
Dialogue: 0,1:36:03.59,1:36:05.21,Default,,0,0,0,,Ах, Хэйдзи!
Dialogue: 0,1:36:05.30,1:36:06.84,Default,,0,0,0,,Хэйдзи!
Dialogue: 0,1:36:06.92,1:36:07.97,Default,,0,0,0,,О
Dialogue: 0,1:36:10.30,1:36:11.84,Default,,0,0,0,,Бұл ғибадатхана...
Dialogue: 0,1:36:14.93,1:36:15.77,Default,,0,0,0,,Ах!
Dialogue: 0,1:36:21.48,1:36:23.36,Default,,0,0,0,,Енді барлық жұмбақтар шешілді.
Dialogue: 0,1:36:23.44,1:36:25.36,Default,,0,0,0,,-(Ағаса) Фу... -Ах...
Dialogue: 0,1:36:26.86,1:36:31.24,Default,,0,0,0,,Дәрінің әсері уақытша болған сияқты.
Dialogue: 0,1:36:31.32,1:36:34.78,Default,,0,0,0,,Міне, сіздердің арқаларыңызда мен тағы да құнды деректер жинадым.
Dialogue: 0,1:36:35.78,1:36:36.66,Default,,0,0,0,,Хахаха…
Dialogue: 0,1:36:37.41,1:36:38.91,Default,,0,0,0,,Амансың ба? Хэдзи
Dialogue: 0,1:36:39.00,1:36:42.67,Default,,0,0,0,,Жарайды, бірақ Будда мүсіні жер бетінде қай жерде...
Dialogue: 0,1:36:42.75,1:36:44.67,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:44.75,1:36:46.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:47.67,1:36:49.38,Default,,0,0,0,,Хаттори-кун Шини...
Dialogue: 0,1:36:50.09,1:36:51.26,Default,,0,0,0,,Иә? Не?
Dialogue: 0,1:36:51.34,1:36:53.18,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:36:54.85,1:36:57.47,Default,,0,0,0,,Өйткені, бұл арман еді...
Dialogue: 0,1:37:22.12,1:37:26.79,Default,,0,0,0,,Мен Будда мүсінінің қайда екенін біле алмағандықтан қатты ұялдым.
Dialogue: 0,1:37:26.88,1:37:31.59,Default,,0,0,0,,Жоқ, жоқ, бұл да Будданың шешімі.
Dialogue: 0,1:37:31.67,1:37:33.76,Default,,0,0,0,,Уайымдайтын ештеңе жоқ
Dialogue: 0,1:37:33.84,1:37:36.76,Default,,0,0,0,,Барлығыңыз сақ болыңыздар.
Dialogue: 0,1:37:38.72,1:37:40.06,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,1:37:46.73,1:37:49.44,Default,,0,0,0,,Ал, мен қиналып қалдым.
Dialogue: 0,1:37:49.53,1:37:52.99,Default,,0,0,0,,Ашылуына бір сағат қана қалды.
Dialogue: 0,1:37:53.07,1:37:57.12,Default,,0,0,0,,Не... сол қалпында көрсең, жарайды.
Dialogue: 0,1:38:03.46,1:38:04.50,Default,,0,0,0,,О!
Dialogue: 0,1:38:04.58,1:38:06.92,Default,,0,0,0,,О... Якуши Татхагата!
Dialogue: 0,1:38:07.59,1:38:10.00,Default,,0,0,0,,Қайтадан қош келдіңіз, Харука!
Dialogue: 0,1:38:17.05,1:38:18.22,Default,,0,0,0,,Ал...
Dialogue: 0,1:38:18.76,1:38:19.60,Default,,0,0,0,,О!
Dialogue: 0,1:38:20.81,1:38:21.93,Default,,0,0,0,,Кудоға қосылыңыз
Dialogue: 0,1:38:22.02,1:38:24.23,Default,,0,0,0,,Мен осылай дедім.
Dialogue: 0,1:38:28.36,1:38:31.48,Default,,0,0,0,,Мен ғибадатхананың пішіні шар тәрізді болады деп күтпедім.
Dialogue: 0,1:38:31.57,1:38:33.78,Default,,0,0,0,,Қоңырау мұнарасы нүктеде орналасқан.
Dialogue: 0,1:38:35.36,1:38:38.12,Default,,0,0,0,,Мен де күткендей зейін қоюда қиналадым.
Dialogue: 0,1:38:38.20,1:38:40.41,Default,,0,0,0,,«Допқа» тәж киген кезде
Dialogue: 0,1:38:40.49,1:38:42.12,Default,,0,0,0,,Бұл «қазына» болады
Dialogue: 0,1:38:42.20,1:38:45.08,Default,,0,0,0,,Тәжі шатырды көрсетті.
Dialogue: 0,1:38:45.16,1:38:46.79,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:38:54.72,1:38:56.88,Default,,0,0,0,,Қазір жағдай қалыпты жағдайға оралды.
Dialogue: 0,1:38:56.97,1:38:58.01,Default,,0,0,0,,О
Dialogue: 0,1:39:01.10,1:39:04.77,Default,,0,0,0,,Бұл екеуі, иә, олар бірге жұмыс істеді.
Dialogue: 0,1:39:04.85,1:39:07.56,Default,,0,0,0,,Бұл Йошицүнэ мен Бенкей сияқты болды.
Dialogue: 0,1:39:07.65,1:39:08.90,Default,,0,0,0,,Иә?
Dialogue: 0,1:39:08.98,1:39:12.32,Default,,0,0,0,,А, Хаттори баласы мен детектив Мори дейсіз бе?
Dialogue: 0,1:39:13.11,1:39:16.24,Default,,0,0,0,,Маған әлі де көбірек жаттығу керек сияқты.
Dialogue: 0,1:39:16.32,1:39:19.45,Default,,0,0,0,,Hohohohoho…
Dialogue: 0,1:39:19.53,1:39:22.49,Default,,0,0,0,,Ммм... Ммм...
Dialogue: 0,1:39:25.58,1:39:28.42,Default,,0,0,0,,Иә, келесі жолы, Аюми-чан, өтінемін.
Dialogue: 0,1:39:28.50,1:39:29.33,Default,,0,0,0,,Иә!
Dialogue: 0,1:39:30.25,1:39:33.88,Default,,0,0,0,,Сен сондай сүйкімдісің, мен сені үйге апарамын деп ойлаймын.
Dialogue: 0,1:39:33.96,1:39:37.59,Default,,0,0,0,,Мен бас тартпаймын, сен менің ең жақын досымсың.
Dialogue: 0,1:39:37.68,1:39:41.26,Default,,0,0,0,,Инспектор, сенің адами достарың көп емес шығар?
Dialogue: 0,1:39:41.35,1:39:42.30,Default,,0,0,0,,Уф...
Dialogue: 0,1:39:42.39,1:39:43.39,Default,,0,0,0,,Жоқ
Dialogue: 0,1:39:43.47,1:39:46.68,Default,,0,0,0,,Екеуіңізді қылмыскер деп атағаным үшін кешіріңіз.
Dialogue: 0,1:39:46.77,1:39:48.52,Default,,0,0,0,,Рахмет
Dialogue: 0,1:39:48.60,1:39:51.65,Default,,0,0,0,,Негізі әкемнің кім екенін білемін.
Dialogue: 0,1:39:51.73,1:39:55.69,Default,,0,0,0,,Менің жағым: ''Енді маған ақша жіберме'' деді.
Dialogue: 0,1:39:55.78,1:39:57.70,Default,,0,0,0,,Хмм... әке ше?
Dialogue: 0,1:39:57.78,1:39:58.61,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:39:59.41,1:40:00.86,Default,,0,0,0,,Айтпа
Dialogue: 0,1:40:02.24,1:40:03.70,Default,,0,0,0,,Ах!
Dialogue: 0,1:40:03.78,1:40:05.45,Default,,0,0,0,,Хмм...
Dialogue: 0,1:40:05.54,1:40:09.58,Default,,0,0,0,,Әлгі қарғыс атқыр бала!
Dialogue: 0,1:40:10.21,1:40:11.08,Default,,0,0,0,,Хе-хе…
Dialogue: 0,1:40:11.17,1:40:13.34,Default,,0,0,0,,♪ Марутаке Эбисуни
Dialogue: 0,1:40:13.42,1:40:15.63,Default,,0,0,0,,♪ Жаза
Dialogue: 0,1:40:15.71,1:40:17.51,Default,,0,0,0,,♪ Йомесан Роккаку...
Dialogue: 0,1:40:17.59,1:40:20.38,Default,,0,0,0,,«Йоме-сан» Яноуте «Ане-сан» Я Бөке
Dialogue: 0,1:40:20.47,1:40:22.80,Default,,0,0,0,,Бұл ән қай жерде есіңізде қалды?
Dialogue: 0,1:40:22.89,1:40:25.51,Default,,0,0,0,,Киотодағы туыстар арасындағы күйік
Dialogue: 0,1:40:25.60,1:40:28.27,Default,,0,0,0,,Мен мұны бастауыш сыныптың үшінші курсында оқып жүргенімде жасадым деп ойлаймын.
Dialogue: 0,1:40:28.35,1:40:31.27,Default,,0,0,0,,Мен сенімен бірге шыққанда маған хабарлаңыз.
Dialogue: 0,1:40:31.35,1:40:32.19,Default,,0,0,0,,Менімен?
Dialogue: 0,1:40:32.27,1:40:34.48,Default,,0,0,0,,Не, есіңізде жоқ па?
Dialogue: 0,1:40:34.57,1:40:38.19,Default,,0,0,0,,Түсіндім, дайындала алмаймын. Күте алмаймын?
Dialogue: 0,1:40:38.28,1:40:42.07,Default,,0,0,0,,Мен Санножи храмына барамын дедім, бірақ кеткім келмеді.
Dialogue: 0,1:40:42.16,1:40:45.66,Default,,0,0,0,,Сол кезде кимоно киіп алып кеттім.
Dialogue: 0,1:40:45.74,1:40:49.20,Default,,0,0,0,,Шашыңызды жасап, макияж жасаңыз.
Dialogue: 0,1:40:49.29,1:40:52.29,Default,,0,0,0,,Сондықтан мен сені іздеу үшін Санножи храмына бардым.
Dialogue: 0,1:40:52.37,1:40:55.34,Default,,0,0,0,,Мен сені еш жерден таба алмаймын, сондықтан біраз уақытқа үйге барамын.
Dialogue: 0,1:40:56.55,1:40:59.38,Default,,0,0,0,,Шынымен, мен де саған көрсеткім келді.
Dialogue: 0,1:40:59.47,1:41:02.84,Default,,0,0,0,,Шие гүлдері билеп, әдемі көрінеді.
Dialogue: 0,1:41:03.47,1:41:05.85,Default,,0,0,0,,♪ Марутаке Эбисуни
Dialogue: 0,1:41:05.93,1:41:08.72,Default,,0,0,0,,♪ Жаза
Dialogue: 0,1:41:08.81,1:41:11.39,Default,,0,0,0,,♪ Йомесан Роккаку
Dialogue: 0,1:41:11.48,1:41:14.15,Default,,0,0,0,,♪ Сегізаяқ
Dialogue: 0,1:41:18.61,1:41:20.86,Default,,0,0,0,,Сонымен, біз ақыры кездестік пе?
Dialogue: 0,1:41:20.94,1:41:22.95,Default,,0,0,0,,Иә? Біз кездестік пе?
Dialogue: 0,1:41:23.03,1:41:25.28,Default,,0,0,0,,Алғашқы махаббатыңызды кездестірдіңіз бе? Хэдзи
Dialogue: 0,1:41:25.37,1:41:27.03,Default,,0,0,0,,Кім? Бұл майко?
Dialogue: 0,1:41:27.91,1:41:30.33,Default,,0,0,0,,Сен мені өмір бойы оқытасың ба, ақымақ?
Dialogue: 0,1:41:30.41,1:41:32.62,Default,,0,0,0,,Иә, сараң, айтпа.
Dialogue: 0,1:41:32.71,1:41:33.54,Default,,0,0,0,,Сояна
Dialogue: 0,1:41:33.62,1:41:36.21,Default,,0,0,0,,Ал, сіз маған шамамен 1500 жылдан кейін айта аласыз.
Dialogue: 0,1:41:36.29,1:41:38.38,Default,,0,0,0,,Мм... Бұл не!
Dialogue: 0,1:41:38.46,1:41:40.01,Default,,0,0,0,,Хэхе!
Dialogue: 0,1:41:50.02,1:41:50.97,Default,,0,0,0,,Уау!
Dialogue: 0,1:41:51.06,1:41:53.23,Default,,0,0,0,,Конан-кун, сен не істеп жатырсың?
Dialogue: 0,1:41:53.31,1:41:54.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:58.40,1:41:59.90,Default,,0,0,0,,Терге малындым.
Dialogue: 0,1:42:01.24,1:42:03.40,Default,,0,0,0,,Ши… Шиничи…
Dialogue: 0,1:42:03.49,1:42:07.78,Default,,0,0,0,,Аа, енді ойлап қарасам, Шиничи-нии-чанға телефон соқтым.
Dialogue: 0,1:42:07.87,1:42:11.83,Default,,0,0,0,,Өзін Хэйдзи-ни-чан етіп көрсету және “Казуха-ни-чанға көмектес” деп айту
Dialogue: 0,1:42:11.91,1:42:12.75,Default,,0,0,0,,Эй?
Dialogue: 0,1:42:12.83,1:42:14.50,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,1:42:14.58,1:42:19.84,Default,,0,0,0,,Дұрыс, ол шынымен әлсіреп, жолда қашып кетті.
Dialogue: 0,1:42:20.50,1:42:23.30,Default,,0,0,0,,Мен өзіме «ешкімге айтпа» десем де
Dialogue: 0,1:42:26.72,1:42:29.56,Default,,0,0,0,,Мен көремін… Күткендей…
Dialogue: 0,1:42:29.64,1:42:32.14,Default,,0,0,0,,Өйткені, бұл Шиничи болатын.
Dialogue: 0,1:42:35.06,1:42:36.90,Default,,0,0,0,,Біз ақыры кездестік.
Dialogue: 0,1:42:38.86,1:42:40.19,Default,,0,0,0,,Фу…
Dialogue: 0,1:42:40.27,1:42:45.28,Default,,0,0,0,,♪~
Dialogue: 0,1:46:44.56,1:46:49.48,Default,,0,0,0,,~♪
Dialogue: 0,1:46:49.56,1:46:52.40,Default,,0,0,0,,(Шинкансен мүйізі)
Dialogue: 0,1:46:55.61,1:46:57.03,Default,,0,0,0,,Балмұздақ беріңізші
Dialogue: 0,1:46:57.11,1:46:59.57,Default,,0,0,0,,Иә, ол 300 иен болады.
Dialogue: 0,1:46:59.66,1:47:00.87,Default,,0,0,0,,Я...
Dialogue: 0,1:47:00.95,1:47:04.58,Default,,0,0,0,,Сайып келгенде, мен ғана кездескім келген адаммен кездесе алмай жүрмін бе?
Dialogue: 0,1:47:04.66,1:47:08.13,Default,,0,0,0,,Соноконың да Кёгоку-санды жақын арада кездестіретініне сенімдімін.
Dialogue: 0,1:47:08.96,1:47:14.42,Default,,0,0,0,,Бірақ мен адамдарды күтуге шебер емеспін.
Dialogue: 0,1:47:14.51,1:47:15.84,Default,,0,0,0,,Орхидея, солай ма?
Dialogue: 0,1:47:15.92,1:47:20.35,Default,,0,0,0,,О, мен адамдарды күткенді жек көрмеймін.
Dialogue: 0,1:47:20.85,1:47:25.43,Default,,0,0,0,,Өйткені біз көп күткен сайын, соғұрлым көп кездесеміз...
Dialogue: 0,1:47:25.52,1:47:28.44,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:47:29.02,1:47:31.44,Default,,0,0,0,,Сол кездегі бет.
Dialogue: 0,1:47:32.48,1:47:34.15,Default,,0,0,0,,Сіз бақытты емессіз бе?
Dialogue: 0,1:47:34.23,1:47:35.61,Default,,0,0,0,,Әй...
Dialogue: 0,1:47:35.69,1:47:39.87,Default,,0,0,0,,Менің айтқанымды Кудо-кун естігенін қалаймын.
Dialogue: 0,1:47:40.82,1:47:41.78,Default,,0,0,0,,Уф...
Dialogue: 0,1:47:41.87,1:47:44.04,Default,,0,0,0,,Хмм?
Dialogue: 0,1:47:45.54,1:47:51.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory