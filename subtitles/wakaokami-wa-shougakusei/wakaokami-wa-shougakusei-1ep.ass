Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.35,0:00:33.59,Default,,0,0,0,,Дұрыс айтасың — ол әдеттегіден де көп әуре-сарсаңға түсіп жүр.
Dialogue: 0,0:00:33.79,0:00:35.64,Default,,0,0,0,,Ыстық бұлақ аймағы сияқты.
Dialogue: 0,0:00:51.77,0:00:54.00,Default,,0,0,0,,Торий-кун!
Dialogue: 0,0:00:54.10,0:00:55.67,Default,,0,0,0,,Ой~!
Dialogue: 0,0:00:55.84,0:00:57.01,Default,,0,0,0,,Тории-кун!
Dialogue: 0,0:00:57.17,0:01:00.18,Default,,0,0,0,,Кя~! Торий-кун!
Dialogue: 0,0:01:14.76,0:01:15.86,Default,,0,0,0,,Окко
Dialogue: 0,0:01:17.13,0:01:19.50,Default,,0,0,0,,Біріншіден, мұндағы ыстық бұлақтар
Dialogue: 0,0:01:19.60,0:01:23.70,Default,,0,0,0,,Жараларын емдеу үшін ыстық суға шомылған жабайы жануарлар.
Dialogue: 0,0:01:23.83,0:01:27.37,Default,,0,0,0,,Мұны ата-бабаларымыз көріп, өміріне енгізген.
Dialogue: 0,0:01:27.50,0:01:29.17,Default,,0,0,0,,Бұл бастама
Dialogue: 0,0:01:32.01,0:01:32.81,Default,,0,0,0,,Уау...
Dialogue: 0,0:01:32.88,0:01:36.38,Default,,0,0,0,,Хананою Онсендегі ыстық судан ешкім бас тартпайды.
Dialogue: 0,0:01:36.51,0:01:39.15,Default,,0,0,0,,Жануарлар да, адамдар да
Dialogue: 0,0:01:39.22,0:01:42.02,Default,,0,0,0,,«Барлығын қабылдаңыз, солай ма?
Dialogue: 0,0:01:42.12,0:01:43.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:43.45,0:01:45.05,Default,,0,0,0,,Барабан ырғағымен бірге қозғалып, ол жыртқыш жануардың тырнақ іздерінің пішінін алды.
Dialogue: 0,0:01:45.22,0:01:46.22,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:48.16,0:01:50.73,Default,,0,0,0,,Әкелеріміз бала кезінде,
Dialogue: 0,0:01:50.83,0:01:54.06,Default,,0,0,0,,Мен бір кездері осы кагураны аңсадым.
Dialogue: 0,0:01:54.16,0:01:55.06,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:01:55.16,0:01:56.57,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:01:59.74,0:02:02.57,Default,,0,0,0,,Анам әлі де билегісі келеді.
Dialogue: 0,0:02:02.67,0:02:03.91,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:02:04.74,0:02:05.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:05.74,0:02:07.01,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:07.08,0:02:07.91,Default,,0,0,0,,Уф
Dialogue: 0,0:02:08.04,0:02:09.21,Default,,0,0,0,,...
Dialogue: 0,0:02:09.31,0:02:12.68,Default,,0,0,0,,Бірақ мен тезірек үйге баруым керек. Мен тағы да кептеліске кептелдім.
Dialogue: 0,0:02:13.08,0:02:13.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:13.98,0:02:15.82,Default,,0,0,0,,Тағы да
Dialogue: 0,0:02:15.92,0:02:18.22,Default,,0,0,0,,Окко үйге ертерек қайтқысы келеді, солай ма?
Dialogue: 0,0:02:18.32,0:02:20.56,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:20.66,0:02:21.99,Default,,0,0,0,,Хехе
Dialogue: 0,0:02:28.10,0:02:30.90,Default,,0,0,0,,Мен енеммен амандасуды ұмытып кетіппін.
Dialogue: 0,0:02:31.00,0:02:34.00,Default,,0,0,0,,Мен бос емеспін, өйткені мен бүгін толықтай брондалғанмын.
Dialogue: 0,0:02:34.10,0:02:35.94,Default,,0,0,0,,Сіздің енең неше жаста?
Dialogue: 0,0:02:36.07,0:02:37.67,Default,,0,0,0,,Қазірдің өзінде 70 болды
Dialogue: 0,0:02:37.77,0:02:40.34,Default,,0,0,0,,Қонақ үй туралы ойлауым керек.
Dialogue: 0,0:02:41.61,0:02:42.45,Default,,0,0,0,,Окко
Dialogue: 0,0:02:42.58,0:02:43.51,Default,,0,0,0,,Не?
Dialogue: 0,0:02:43.61,0:02:45.62,Default,,0,0,0,,Хананою Онсен
Dialogue: 0,0:02:45.75,0:02:49.45,Default,,0,0,0,,Хананою Онсендегі ыстық су - бұл Құдайдан алған ыстық су.
Dialogue: 0,0:02:49.59,0:02:55.26,Default,,0,0,0,,Сондықтан таңдаулы балалар жыл сайын ризашылықтарын білдіру үшін билейді.
Dialogue: 0,0:02:55.36,0:02:58.86,Default,,0,0,0,,Мама, мен сенің билегеніңді көргім келеді.
Dialogue: 0,0:02:58.96,0:03:00.23,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:01.96,0:03:03.53,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:03:09.97,0:03:10.91,Default,,0,0,0,,- Иә? -Ха...
Dialogue: 0,0:03:10.97,0:03:12.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:15.21,0:03:16.48,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:03:17.75,0:03:18.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:18.65,0:03:19.48,Default,,0,0,0,,Қауіп
Dialogue: 0,0:03:19.65,0:03:20.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:39.50,0:03:40.94,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:41.00,0:03:41.80,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:03:41.90,0:03:42.67,Default,,0,0,0,,Біреу, жедел жәрдем!
Dialogue: 0,0:03:42.77,0:03:43.97,Default,,0,0,0,,Жазатайым оқиға
Dialogue: 0,0:03:44.07,0:03:45.84,Default,,0,0,0,,Бұл оқыс оқиға болды. Біреу...
Dialogue: 0,0:03:56.85,0:03:58.86,Default,,0,0,0,,Хмм... Йотто
Dialogue: 0,0:04:03.53,0:04:04.86,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:04:26.62,0:04:28.05,Default,,0,0,0,,Бұл мен бұрын түсіргенім.
Dialogue: 0,0:04:28.22,0:04:29.22,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:04:29.32,0:04:30.82,Default,,0,0,0,,Мама, сенің түрің біртүрлі екен!
Dialogue: 0,0:04:30.89,0:04:32.32,Default,,0,0,0,,-Бұл Ки-кун -хаха
Dialogue: 0,0:04:43.63,0:04:44.73,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:44.87,0:04:45.58,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:45.62,0:04:46.69,Default,,0,0,0,,Бұл да Хананоюори…
Dialogue: 0,0:04:48.74,0:04:50.87,Default,,0,0,0,,Сіз осы уақытқа дейін жүрдіңіз бе?
Dialogue: 0,0:04:51.41,0:04:54.04,Default,,0,0,0,,♬~
Dialogue: 0,0:05:01.58,0:05:02.92,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:05:06.26,0:05:07.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:08.52,0:05:09.36,Default,,0,0,0,,Ха...
Dialogue: 0,0:05:11.49,0:05:12.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:12.53,0:05:14.26,Default,,0,0,0,,Жас ханым!
Dialogue: 0,0:05:15.43,0:05:16.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:18.77,0:05:20.20,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:05:20.27,0:05:20.94,Default,,0,0,0,,О, менің...
Dialogue: 0,0:05:21.07,0:05:22.71,Default,,0,0,0,,Окко-чан, қош келдіңіз
Dialogue: 0,0:05:22.77,0:05:23.71,Default,,0,0,0,,Кү…
Dialogue: 0,0:05:23.77,0:05:24.57,Default,,0,0,0,,Өрмекші!
Dialogue: 0,0:05:25.27,0:05:26.71,Default,,0,0,0,,Өрмекші?
Dialogue: 0,0:05:26.78,0:05:27.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:27.78,0:05:29.11,Default,,0,0,0,,Эцуконың басы
Dialogue: 0,0:05:29.21,0:05:30.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:30.78,0:05:32.42,Default,,0,0,0,,Келіңдер, келіңдер.
Dialogue: 0,0:05:33.25,0:05:35.25,Default,,0,0,0,,Жоқ, маған ұнамайды.
Dialogue: 0,0:05:35.35,0:05:36.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:37.55,0:05:38.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:39.46,0:05:40.12,Default,,0,0,0,,Жыл!
Dialogue: 0,0:05:40.26,0:05:41.12,Default,,0,0,0,,-Қараңыз -Жоқ...
Dialogue: 0,0:05:41.26,0:05:42.13,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:05:42.23,0:05:43.13,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:05:45.86,0:05:46.93,Default,,0,0,0,,Әже
Dialogue: 0,0:05:49.30,0:05:52.64,Default,,0,0,0,,Немеремнің қиналғанына өкінемін.
Dialogue: 0,0:05:52.74,0:05:53.97,Default,,0,0,0,,Енді осында кел.
Dialogue: 0,0:05:54.07,0:05:55.64,Default,,0,0,0,,Сіз немересісіз бе?
Dialogue: 0,0:05:55.74,0:05:56.97,Default,,0,0,0,,Мен өзімді жақсы сезінемін.
Dialogue: 0,0:05:57.14,0:05:59.14,Default,,0,0,0,,Нашар тәртіп
Dialogue: 0,0:05:59.78,0:06:02.15,Default,,0,0,0,,Сен неге бір орында тұрсың?
Dialogue: 0,0:06:02.28,0:06:03.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.75,0:06:05.82,Default,,0,0,0,,Клиенттер келеді!
Dialogue: 0,0:06:05.92,0:06:07.28,Default,,0,0,0,,Тез, жолдан кет!
Dialogue: 0,0:06:07.55,0:06:09.05,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:06:09.15,0:06:12.29,Default,,0,0,0,,Бұл қосымшаның соңындағы бөлме.
Dialogue: 0,0:06:12.39,0:06:13.32,Default,,0,0,0,,Иә
Dialogue: 0,0:06:13.46,0:06:14.62,Default,,0,0,0,,Сандықты алып жүру
Dialogue: 0,0:06:14.72,0:06:16.33,Default,,0,0,0,,Егер ол оны өзінің Қабілетімен көтерсе, бастаманы өз қолына алады
Dialogue: 0,0:06:18.39,0:06:20.43,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:24.73,0:06:26.00,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:06:35.14,0:06:36.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:37.48,0:06:39.12,Default,,0,0,0,,А... Түсіндім!
Dialogue: 0,0:06:42.99,0:06:43.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:45.19,0:06:46.16,Default,,0,0,0,,А...
Dialogue: 0,0:06:46.66,0:06:47.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:47.69,0:06:48.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:48.83,0:06:50.83,Default,,0,0,0,,Куку… Куку Куку
Dialogue: 0,0:06:50.93,0:06:52.63,Default,,0,0,0,,Ах... хехехе!
Dialogue: 0,0:06:52.70,0:06:53.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:53.80,0:06:55.67,Default,,0,0,0,,Хе хехе хехе
Dialogue: 0,0:07:00.34,0:07:01.64,Default,,0,0,0,,Кім?
Dialogue: 0,0:07:05.64,0:07:06.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:07.21,0:07:08.04,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:07:08.18,0:07:09.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:10.71,0:07:12.05,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:15.28,0:07:16.72,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:07:16.85,0:07:17.72,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:07:17.82,0:07:18.72,Default,,0,0,0,,А... иә?
Dialogue: 0,0:07:20.52,0:07:22.99,Default,,0,0,0,,Ой... сен мені көрмейсің бе?
Dialogue: 0,0:07:23.66,0:07:25.90,Default,,0,0,0,,Неге жүзіп жүрсің...
Dialogue: 0,0:07:26.46,0:07:28.23,Default,,0,0,0,,Сіз, ең маңыздысы!
Dialogue: 0,0:07:28.33,0:07:29.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:33.57,0:07:36.74,Default,,0,0,0,,Мен мұнда мәңгі өмір сүрдім, Юлей.
Dialogue: 0,0:07:37.07,0:07:37.79,Default,,0,0,0,,Урей?
Dialogue: 0,0:07:37.86,0:07:38.43,Default,,0,0,0,,Иә
Dialogue: 0,0:07:38.57,0:07:39.91,Default,,0,0,0,,Ұзақ уақыт бойы?
Dialogue: 0,0:07:40.08,0:07:41.24,Default,,0,0,0,,Мен Урибомын
Dialogue: 0,0:07:41.38,0:07:42.75,Default,,0,0,0,,Танысқаныма қуаныштымын, Окко
Dialogue: 0,0:07:43.65,0:07:45.08,Default,,0,0,0,,Мұрындық қолмен?
Dialogue: 0,0:07:45.25,0:07:46.08,Default,,0,0,0,,Лас!
Dialogue: 0,0:07:46.22,0:07:47.35,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:47.42,0:07:48.92,Default,,0,0,0,,Юлейдің мұрны боқ.
Dialogue: 0,0:07:49.02,0:07:50.75,Default,,0,0,0,,Сіз лас болып көрдіңіз бе?
Dialogue: 0,0:07:50.92,0:07:52.26,Default,,0,0,0,,Ей, қол алысайық!
Dialogue: 0,0:07:52.36,0:07:53.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:53.19,0:07:55.36,Default,,0,0,0,,Эй, мен дос таптым.
Dialogue: 0,0:07:55.43,0:07:56.76,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,0:07:56.89,0:07:57.89,Default,,0,0,0,,Ха...
Dialogue: 0,0:07:58.53,0:08:00.70,Default,,0,0,0,,-Ахахаха! - Сәлем...
Dialogue: 0,0:08:00.76,0:08:02.23,Default,,0,0,0,,Кя!!
Dialogue: 0,0:08:02.33,0:08:03.50,Default,,0,0,0,,Уау! Маған ұнамайды…
Dialogue: 0,0:08:03.61,0:08:04.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:04.25,0:08:04.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:05.10,0:08:06.17,Default,,0,0,0,,Келме!
Dialogue: 0,0:08:06.27,0:08:07.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:07.84,0:08:08.74,Default,,0,0,0,,Око?
Dialogue: 0,0:08:08.84,0:08:09.61,Default,,0,0,0,,Мен бұны бұрыннан-ақ есіме түсіріп қойдым, білесің бе.
Dialogue: 0,0:08:16.91,0:08:18.11,Default,,0,0,0,,Ағай...
Dialogue: 0,0:08:18.21,0:08:20.18,Default,,0,0,0,,Бұл қате немесе басқа нәрсе болуы мүмкін.
Dialogue: 0,0:08:20.28,0:08:21.58,Default,,0,0,0,,Окко
Dialogue: 0,0:08:22.19,0:08:23.95,Default,,0,0,0,,Зәріңізді ашыңыз
Dialogue: 0,0:08:27.22,0:08:28.59,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:28.69,0:08:30.13,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:08:32.06,0:08:33.76,Default,,0,0,0,,Перделерді жабыңыз
Dialogue: 0,0:08:34.93,0:08:37.30,Default,,0,0,0,,А, жоқ! Терезеде кесіртке тұр...
Dialogue: 0,0:08:37.57,0:08:39.94,Default,,0,0,0,,Хехехе, геккон емес пе?
Dialogue: 0,0:08:40.04,0:08:43.64,Default,,0,0,0,,Біз суық қанды жануарлар болғандықтан, күн көзінің астында қалғымыз келеді.
Dialogue: 0,0:08:43.74,0:08:45.04,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:08:45.14,0:08:46.14,Default,,0,0,0,,Бұл
Dialogue: 0,0:08:46.48,0:08:47.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:49.28,0:08:50.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:50.48,0:08:51.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:55.59,0:08:56.29,Default,,0,0,0,,Хмм… неге осы мысықты бақытты етуге тек мен ғана тиіс?
Dialogue: 0,0:08:56.39,0:08:57.99,Default,,0,0,0,,Мұрныңды жұлма!
Dialogue: 0,0:08:58.12,0:08:58.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:58.99,0:08:59.99,Default,,0,0,0,,О, жоқ...
Dialogue: 0,0:09:00.12,0:09:03.16,Default,,0,0,0,,Мен сені Ясуши-сан мен Эцуко-санмен тағы да таныстырамын.
Dialogue: 0,0:09:03.26,0:09:04.96,Default,,0,0,0,,Менің бөлмеме келіңізші.
Dialogue: 0,0:09:05.06,0:09:05.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:05.83,0:09:06.56,Default,,0,0,0,,Иә
Dialogue: 0,0:09:06.66,0:09:09.57,Default,,0,0,0,,Сондай-ақ, тым көп шу шығармаңыз
Dialogue: 0,0:09:09.67,0:09:11.00,Default,,0,0,0,,-Ха! -Аа...
Dialogue: 0,0:09:11.83,0:09:13.94,Default,,0,0,0,,Барлығы таң қалады.
Dialogue: 0,0:09:14.17,0:09:16.17,Default,,0,0,0,,Мен сізге шындықты айтамын.
Dialogue: 0,0:09:16.31,0:09:17.67,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:19.28,0:09:22.68,Default,,0,0,0,,Окко Минекого мүлде ұқсамайды.
Dialogue: 0,0:09:23.18,0:09:25.52,Default,,0,0,0,,Әжеңнің атын қалай білесің?
Dialogue: 0,0:09:27.02,0:09:29.85,Default,,0,0,0,,Біз ескі таныстармыз.
Dialogue: 0,0:09:29.95,0:09:30.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:30.99,0:09:34.36,Default,,0,0,0,,Минеко-чан екеуміз осында барамыз. Асықшы.
Dialogue: 0,0:09:34.52,0:09:35.63,Default,,0,0,0,,Ах
Dialogue: 0,0:09:39.46,0:09:40.93,Default,,0,0,0,,Артымнан ерме
Dialogue: 0,0:09:41.03,0:09:42.67,Default,,0,0,0,,Не айтсаң да
Dialogue: 0,0:09:42.77,0:09:45.00,Default,,0,0,0,,Ақыры сөйлесер адам таптым.
Dialogue: 0,0:09:45.20,0:09:47.54,Default,,0,0,0,,Юреймен сөйлескім келмейді.
Dialogue: 0,0:09:47.77,0:09:50.27,Default,,0,0,0,,Мұндағылардың бәрі мені көре алмайды.
Dialogue: 0,0:09:50.37,0:09:52.34,Default,,0,0,0,,Даусыңды да естімейтін сияқтымын.
Dialogue: 0,0:09:52.71,0:09:53.98,Default,,0,0,0,,Неге бұл тек мен...
Dialogue: 0,0:09:54.78,0:09:57.55,Default,,0,0,0,,Окко бір рет өліп қала жаздады.
Dialogue: 0,0:09:57.68,0:09:59.98,Default,,0,0,0,,Мүмкін, басқа әлеммен қарым-қатынас жасау оңайырақ болды.
Dialogue: 0,0:10:01.98,0:10:03.05,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:10:03.85,0:10:06.06,Default,,0,0,0,,Урибо маған көмектесті ме?
Dialogue: 0,0:10:08.16,0:10:10.56,Default,,0,0,0,,Минеко-чан күте алмайды.
Dialogue: 0,0:10:10.69,0:10:12.73,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:12.90,0:10:16.73,Default,,0,0,0,,Бүгіннен бастап Орико менің үйімде тұрады.
Dialogue: 0,0:10:16.87,0:10:19.14,Default,,0,0,0,,Сізге көп рахмет, Эцуко-сан.
Dialogue: 0,0:10:19.24,0:10:20.14,Default,,0,0,0,,Иә
Dialogue: 0,0:10:20.24,0:10:21.40,Default,,0,0,0,,Ясуши де
Dialogue: 0,0:10:21.50,0:10:22.81,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:22.91,0:10:24.24,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:10:26.74,0:10:29.51,Default,,0,0,0,,Бірақ бұл өте қиын болды.
Dialogue: 0,0:10:29.98,0:10:30.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:32.22,0:10:33.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:33.22,0:10:34.92,Default,,0,0,0,,А... жоқ
Dialogue: 0,0:10:35.65,0:10:37.25,Default,,0,0,0,,Әкесі де, анасы да
Dialogue: 0,0:10:37.35,0:10:41.52,Default,,0,0,0,,Сіз шынымен маған қолым бос емес кезде көмектесуге келесіз.
Dialogue: 0,0:10:43.53,0:10:44.76,Default,,0,0,0,,Окко
Dialogue: 0,0:10:46.06,0:10:48.73,Default,,0,0,0,,Бұдан былай мен саған көмектесемін деп айт.
Dialogue: 0,0:10:49.07,0:10:49.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:50.00,0:10:53.34,Default,,0,0,0,,Минеко-чан бұл қонақ үйді ұстау үшін көп еңбек етті.
Dialogue: 0,0:10:53.44,0:10:54.77,Default,,0,0,0,,Окко жалғыз мұрагер
Dialogue: 0,0:10:54.90,0:10:55.94,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:10:56.17,0:10:57.27,Default,,0,0,0,,Қандай мұрагер!
Dialogue: 0,0:10:57.41,0:10:58.21,Default,,0,0,0,,Иә!?
Dialogue: 0,0:10:58.71,0:11:00.44,Default,,0,0,0,,Мұрагер дегеніміз не?
Dialogue: 0,0:11:00.58,0:11:01.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:02.45,0:11:03.75,Default,,0,0,0,,Ал...
Dialogue: 0,0:11:04.05,0:11:05.45,Default,,0,0,0,,Окко осылай дейді
Dialogue: 0,0:11:05.55,0:11:08.12,Default,,0,0,0,,Бірте-бірте қонақ үйге көмектесемін!
Dialogue: 0,0:11:08.92,0:11:10.52,Default,,0,0,0,,Қонақ үйге көмектесу!?
Dialogue: 0,0:11:10.62,0:11:11.62,Default,,0,0,0,,- Иә? -Аа...
Dialogue: 0,0:11:11.75,0:11:12.92,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:11:13.02,0:11:14.12,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:14.92,0:11:16.13,Default,,0,0,0,,Әйелі
Dialogue: 0,0:11:16.26,0:11:19.96,Default,,0,0,0,,Окко-чан, сен бізге қонақ үйге көмектесуді жоспарлап отырсың ба?
Dialogue: 0,0:11:20.70,0:11:23.97,Default,,0,0,0,,Окко сіздің мұрагер болады дейсіз бе?
Dialogue: 0,0:11:24.30,0:11:25.30,Default,,0,0,0,,Ой...
Dialogue: 0,0:11:25.47,0:11:26.94,Default,,0,0,0,,Дұрыс, Окко.
Dialogue: 0,0:11:27.04,0:11:29.04,Default,,0,0,0,,Окко Харуноядан...
Dialogue: 0,0:11:29.14,0:11:31.14,Default,,0,0,0,,Мен Харунояның жас ханымы боламын!
Dialogue: 0,0:11:31.81,0:11:32.91,Default,,0,0,0,,Жас ханым!?
Dialogue: 0,0:11:33.31,0:11:34.61,Default,,0,0,0,,-Не!? -Аа...
Dialogue: 0,0:11:35.38,0:11:36.95,Default,,0,0,0,,Жас әйел
Dialogue: 0,0:11:37.05,0:11:38.95,Default,,0,0,0,,Ер адам жас әйел.
Dialogue: 0,0:11:39.05,0:11:41.62,Default,,0,0,0,,Қандай қуанышты оқиға.
Dialogue: 0,0:11:41.82,0:11:42.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:42.99,0:11:44.32,Default,,0,0,0,,Сәлем! Әйелі
Dialogue: 0,0:11:45.32,0:11:46.16,Default,,0,0,0,,А...
Dialogue: 0,0:11:46.29,0:11:48.93,Default,,0,0,0,,Бірақ Окко әлі бастауыш мектепте оқиды.
Dialogue: 0,0:11:49.16,0:11:50.59,Default,,0,0,0,,Дұрыс, Эцуко-сан.
Dialogue: 0,0:11:50.66,0:11:54.16,Default,,0,0,0,,Мен жас үй шаруасындағы әйел болуды шешкен жоқпын...
Dialogue: 0,0:11:56.73,0:11:57.67,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:57.76,0:11:58.39,Default,,0,0,0,,Иә
Dialogue: 0,0:11:58.43,0:12:01.94,Default,,0,0,0,,Мен сізге қонақүйде қалай жұмыс істеу керектігін біртіндеп үйретемін.
Dialogue: 0,0:12:04.27,0:12:06.01,Default,,0,0,0,,Бұл аз
Dialogue: 0,0:12:06.31,0:12:07.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:07.51,0:12:08.58,Default,,0,0,0,,Окко…
Dialogue: 0,0:12:08.68,0:12:09.68,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:10.35,0:12:11.28,Default,,0,0,0,,Уф
Dialogue: 0,0:12:12.35,0:12:14.25,Default,,0,0,0,,Минеко-чанға көмектес
Dialogue: 0,0:12:14.35,0:12:15.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:17.19,0:12:20.16,Default,,0,0,0,,Құтқарушының өтініштерін тыңдаңыз.
Dialogue: 0,0:12:20.42,0:12:21.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:24.86,0:12:27.50,Default,,0,0,0,,Сізге көңілді болды деп үміттенемін, ханым.
Dialogue: 0,0:12:29.33,0:12:30.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:31.00,0:12:32.54,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:33.67,0:12:37.37,Default,,0,0,0,,Ал, мен саған кимономды тігіп беретін шығармын.
Dialogue: 0,0:12:37.71,0:12:38.88,Default,,0,0,0,,А...
Dialogue: 0,0:12:40.28,0:12:44.21,Default,,0,0,0,,Иә!!
Dialogue: 0,0:13:01.33,0:13:02.87,Default,,0,0,0,,Лилилирин
Dialogue: 0,0:13:08.34,0:13:10.01,Default,,0,0,0,,А...
Dialogue: 0,0:13:11.01,0:13:12.74,Default,,0,0,0,,Окко, рахмет.
Dialogue: 0,0:13:13.24,0:13:15.41,Default,,0,0,0,,Себебі мен түсіндім
Dialogue: 0,0:13:16.58,0:13:18.88,Default,,0,0,0,,Мен сені шақырмайынша бөлмеге кірме!
Dialogue: 0,0:13:19.52,0:13:21.98,Default,,0,0,0,,Бұл мені қатты қуантты.
Dialogue: 0,0:13:22.09,0:13:24.32,Default,,0,0,0,,Сондықтан мен түсінемін
Dialogue: 0,0:13:24.42,0:13:26.92,Default,,0,0,0,,Мен өліп кетуім мүмкін деп ойладым.
Dialogue: 0,0:13:27.09,0:13:28.76,Default,,0,0,0,,Біртүрлі сөздер айтпа
Dialogue: 0,0:13:29.49,0:13:31.26,Default,,0,0,0,,Ол қазірдің өзінде өлді.
Dialogue: 0,0:13:31.83,0:13:33.16,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:13:33.26,0:13:34.26,Default,,0,0,0,,Жас әйел
Dialogue: 0,0:13:34.53,0:13:35.53,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:13:35.83,0:13:37.23,Default,,0,0,0,,Оқ жаудырыңдар! Бүйіріне нысана ал!
Dialogue: 0,0:13:37.77,0:13:39.44,Default,,0,0,0,,Юрей күткендей
Dialogue: 0,0:13:44.51,0:13:45.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:45.74,0:13:46.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:54.12,0:13:55.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:57.42,0:13:58.29,Default,,0,0,0,,Кімге…
Dialogue: 0,0:14:02.46,0:14:03.46,Default,,0,0,0,,...
Dialogue: 0,0:14:06.76,0:14:07.60,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:14:12.30,0:14:13.64,Default,,0,0,0,,Ох…
Dialogue: 0,0:14:14.64,0:14:15.81,Default,,0,0,0,,...
Dialogue: 0,0:14:16.41,0:14:18.27,Default,,0,0,0,,Не, сен тірісің бе?
Dialogue: 0,0:14:19.94,0:14:21.31,Default,,0,0,0,,Хихихихи…
Dialogue: 0,0:14:30.15,0:14:33.66,Default,,0,0,0,,Ямабуки бөлмесінде қонақтарға арналған таңғы ас аяқталды.
Dialogue: 0,0:14:33.82,0:14:36.33,Default,,0,0,0,,Иә Джинчодж бөлмесі 2 адам
Dialogue: 0,0:14:36.49,0:14:37.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:37.96,0:14:39.80,Default,,0,0,0,,Лилилилирин
Dialogue: 0,0:14:42.27,0:14:43.27,Default,,0,0,0,,Лилилирин
Dialogue: 0,0:14:44.00,0:14:45.67,Default,,0,0,0,,Лили Лили Ририн
Dialogue: 0,0:14:50.67,0:14:52.28,Default,,0,0,0,,Лилилилирин
Dialogue: 0,0:14:55.75,0:14:58.35,Default,,0,0,0,,Лилирин Лилилли
Dialogue: 0,0:15:02.19,0:15:03.35,Default,,0,0,0,,Лилин Лилилин
Dialogue: 0,0:15:03.49,0:15:04.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:08.86,0:15:09.69,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:10.36,0:15:11.36,Default,,0,0,0,,Хмм?
Dialogue: 0,0:15:11.46,0:15:12.86,Default,,0,0,0,,...
Dialogue: 0,0:15:13.03,0:15:14.20,Default,,0,0,0,,Лилили Лилилирин
Dialogue: 0,0:15:14.33,0:15:15.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:15.05,0:15:16.46,Default,,0,0,0,,Рири Ририн Рири Ририн
Dialogue: 0,0:15:16.57,0:15:18.07,Default,,0,0,0,,-Лилилирин... -Жеркінішті.
Dialogue: 0,0:15:26.88,0:15:29.05,Default,,0,0,0,,Қайта әкеліңіз
Dialogue: 0,0:15:29.38,0:15:30.95,Default,,0,0,0,,О? Қайырлы таң
Dialogue: 0,0:15:31.05,0:15:31.78,Default,,0,0,0,,Ах
Dialogue: 0,0:15:31.88,0:15:35.49,Default,,0,0,0,,Окко, сен не істеп жатырсың? Өтінемін, дұрыстап амандасыңыз.
Dialogue: 0,0:15:35.72,0:15:37.72,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:15:38.05,0:15:39.72,Default,,0,0,0,,Накай-саннан естідім.
Dialogue: 0,0:15:39.82,0:15:42.23,Default,,0,0,0,,Сіз мұнда жас ханым боласыз деп естідім.
Dialogue: 0,0:15:42.33,0:15:43.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:43.29,0:15:44.66,Default,,0,0,0,,Дұрыс. Кира өлім уақытын қаншалықты өзгертсе де,
Dialogue: 0,0:15:44.86,0:15:46.56,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:15:46.70,0:15:48.90,Default,,0,0,0,,Хаха, мен оны одан да көп күтемін.
Dialogue: 0,0:15:49.00,0:15:50.20,Default,,0,0,0,,Иә
Dialogue: 0,0:15:51.07,0:15:53.57,Default,,0,0,0,,Әже, сіз мұны білесіз бе?
Dialogue: 0,0:15:54.07,0:15:54.90,Default,,0,0,0,,Ах
Dialogue: 0,0:15:55.04,0:15:57.91,Default,,0,0,0,,Мың жыл болған плитка шеберінен сенімдімін.
Dialogue: 0,0:15:58.04,0:16:00.54,Default,,0,0,0,,Бұл атамның маған бергені.
Dialogue: 0,0:16:01.21,0:16:03.85,Default,,0,0,0,,Атам қайтыс болды, болды.
Dialogue: 0,0:16:04.08,0:16:05.92,Default,,0,0,0,,Сіз оны аштыңыз ба?
Dialogue: 0,0:16:06.22,0:16:07.05,Default,,0,0,0,,Иә
Dialogue: 0,0:16:09.59,0:16:12.09,Default,,0,0,0,,Иә? Дауысы бұрынғыдан басқаша.
Dialogue: 0,0:16:13.36,0:16:14.42,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:15.49,0:16:18.26,Default,,0,0,0,,Мұнда осындай нәрсе болды ма?
Dialogue: 0,0:16:20.76,0:16:22.06,Default,,0,0,0,,Кім?
Dialogue: 0,0:16:22.17,0:16:25.60,Default,,0,0,0,,Менің арғы атам мен үлкен әжем.
Dialogue: 0,0:16:25.74,0:16:27.57,Default,,0,0,0,,Бұл баланы...
Dialogue: 0,0:16:27.67,0:16:29.07,Default,,0,0,0,,Әже
Dialogue: 0,0:16:29.17,0:16:30.11,Default,,0,0,0,,Ә!?
Dialogue: 0,0:16:30.24,0:16:32.78,Default,,0,0,0,,Менің жасым шамалы болғанда.
Dialogue: 0,0:16:33.94,0:16:35.85,Default,,0,0,0,,Ах! Кокококо…
Dialogue: 0,0:16:35.95,0:16:38.28,Default,,0,0,0,,Бұл мен Осакада болған кезім еді.
Dialogue: 0,0:16:38.78,0:16:39.95,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:16:40.08,0:16:42.72,Default,,0,0,0,,Аа, мынау көрші тұратын қыз.
Dialogue: 0,0:16:43.39,0:16:44.69,Default,,0,0,0,,Макото-кун
Dialogue: 0,0:16:44.79,0:16:49.63,Default,,0,0,0,,Оның тегі Тачиури болатын, сондықтан мен оны Урибо деп атадым.
Dialogue: 0,0:16:51.59,0:16:54.43,Default,,0,0,0,,Урибо осы уақытта тірі болды.
Dialogue: 0,0:16:54.73,0:16:55.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:56.07,0:16:56.87,Default,,0,0,0,,Ах
Dialogue: 0,0:16:56.97,0:16:57.93,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:58.63,0:17:00.87,Default,,0,0,0,,Сіз бұл қызбен дос болдыңыз ба?
Dialogue: 0,0:17:00.97,0:17:02.14,Default,,0,0,0,,О
Dialogue: 0,0:17:02.71,0:17:04.81,Default,,0,0,0,,Сіз жақсы ойнадыңыз.
Dialogue: 0,0:17:04.94,0:17:07.61,Default,,0,0,0,,Бұл күндері менің әжем ерке.
Dialogue: 0,0:17:07.71,0:17:10.65,Default,,0,0,0,,Мен Урибомен бірге жүгірдім.
Dialogue: 0,0:17:10.81,0:17:14.12,Default,,0,0,0,,Екеуміз бірге жасырын жерлерге бардық.
Dialogue: 0,0:17:14.22,0:17:17.55,Default,,0,0,0,,Дұрыс, мен тым томбоймын.
Dialogue: 0,0:17:17.65,0:17:19.49,Default,,0,0,0,,Мен бір рет шатырдан құладым.
Dialogue: 0,0:17:19.59,0:17:22.16,Default,,0,0,0,,Урибо!
Dialogue: 0,0:17:26.83,0:17:27.66,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:17:30.50,0:17:31.97,Default,,0,0,0,,Урибо!
Dialogue: 0,0:17:33.40,0:17:35.67,Default,,0,0,0,,Не!? Бүгін таңертең болды.
Dialogue: 0,0:17:36.07,0:17:37.67,Default,,0,0,0,,Күн тікелей үстінде
Dialogue: 0,0:17:37.73,0:17:38.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.01,0:17:40.91,Default,,0,0,0,,Сен жалғыз шықтың.
Dialogue: 0,0:17:41.01,0:17:41.94,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:17:42.35,0:17:45.01,Default,,0,0,0,,Сіз қанша ұйықтайсыз? Тездетіңіз, жүріңіз.
Dialogue: 0,0:17:46.08,0:17:46.92,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:17:47.02,0:17:48.95,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:17:49.79,0:17:51.99,Default,,0,0,0,,Икомадағы тауға қара!
Dialogue: 0,0:17:53.66,0:17:54.69,Default,,0,0,0,,Әй, ә!
Dialogue: 0,0:17:54.79,0:17:55.76,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:17:55.86,0:17:57.19,Default,,0,0,0,,Урибу…
Dialogue: 0,0:17:57.29,0:17:58.09,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:58.19,0:17:59.13,Default,,0,0,0,,Минеко-чан!
Dialogue: 0,0:17:59.70,0:18:00.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:00.83,0:18:01.80,Default,,0,0,0,,Минеко-чан!
Dialogue: 0,0:18:01.86,0:18:02.93,Default,,0,0,0,,Урибу…
Dialogue: 0,0:18:03.03,0:18:03.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:04.50,0:18:05.27,Default,,0,0,0,,Уф
Dialogue: 0,0:18:05.37,0:18:06.97,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:18:08.34,0:18:09.17,Default,,0,0,0,,Мен бұны бұрыннан-ақ есіме түсіріп қойдым, білесің бе.
Dialogue: 0,0:18:09.27,0:18:11.21,Default,,0,0,0,,Минеко-чан, жараланып қалдың ба?
Dialogue: 0,0:18:11.71,0:18:14.21,Default,,0,0,0,,Пфф... ауырып қалдың ба?
Dialogue: 0,0:18:14.54,0:18:15.81,Default,,0,0,0,,Шаш бар.
Dialogue: 0,0:18:16.21,0:18:17.15,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:18.35,0:18:19.52,Default,,0,0,0,,Менің де шашым бар
Dialogue: 0,0:18:19.62,0:18:20.85,Default,,0,0,0,,Хэхе хаха
Dialogue: 0,0:18:20.95,0:18:22.39,Default,,0,0,0,,Керемет! Хахаха
Dialogue: 0,0:18:23.19,0:18:25.39,Default,,0,0,0,,Урибо - құтқарушы
Dialogue: 0,0:18:25.52,0:18:26.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:26.39,0:18:29.66,Default,,0,0,0,,Көңілді, мейірімді, жақсы бала еді.
Dialogue: 0,0:18:31.63,0:18:34.16,Default,,0,0,0,,Маған қатты ұнады.
Dialogue: 0,0:18:34.70,0:18:37.07,Default,,0,0,0,,Минеко-чан
Dialogue: 0,0:18:38.17,0:18:41.74,Default,,0,0,0,,Маған қызық, қазір қайдасың, не істеп жүрсің.
Dialogue: 0,0:18:42.41,0:18:45.91,Default,,0,0,0,,Урибо әлі де әжесін жақсы көреді.
Dialogue: 0,0:18:46.04,0:18:47.14,Default,,0,0,0,,Эй, хаха
Dialogue: 0,0:18:47.24,0:18:49.68,Default,,0,0,0,,Сіз жақсы сөздер айтасыз.
Dialogue: 0,0:18:55.08,0:18:58.76,Default,,0,0,0,,Әже Урибоның өлгенін білмейді.
Dialogue: 0,0:18:59.76,0:19:00.82,Default,,0,0,0,,Мен өлдім
Dialogue: 0,0:19:00.92,0:19:04.53,Default,,0,0,0,,Мен мұны Минеко көшкеннен кейін жасадым.
Dialogue: 0,0:19:05.50,0:19:07.76,Default,,0,0,0,,Неліктен Урибо...
Dialogue: 0,0:19:08.50,0:19:12.67,Default,,0,0,0,,Минеко-чан қазір жоқ.
Dialogue: 0,0:19:12.77,0:19:15.74,Default,,0,0,0,,Мен Минеко-чанмен төбеге шыққанда
Dialogue: 0,0:19:15.84,0:19:18.57,Default,,0,0,0,,Плитка құлап, құлады.
Dialogue: 0,0:19:18.67,0:19:20.71,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:19:21.61,0:19:23.78,Default,,0,0,0,,Сіздің арқаңызда мен Минеко-чанмен қайта кездесуге мүмкіндік алдым!
Dialogue: 0,0:19:24.95,0:19:25.78,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:26.42,0:19:29.45,Default,,0,0,0,,Маған Минеко-чанға қарау жеткілікті.
Dialogue: 0,0:19:30.19,0:19:31.45,Default,,0,0,0,,Урибо
Dialogue: 0,0:19:31.75,0:19:35.09,Default,,0,0,0,,Бірақ Окко тірі және Минеко-чанның жанында.
Dialogue: 0,0:19:35.56,0:19:37.43,Default,,0,0,0,,Жас келіншек жоқ дейді
Dialogue: 0,0:19:37.53,0:19:39.63,Default,,0,0,0,,Харунояға көмектесуді жалғастырыңыз.
Dialogue: 0,0:19:40.63,0:19:42.13,Default,,0,0,0,,Иә
Dialogue: 0,0:19:42.47,0:19:44.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.13,0:19:45.77,Default,,0,0,0,,Окко
Dialogue: 0,0:19:45.87,0:19:48.10,Default,,0,0,0,,Минеко-чан екеуміз ойнаған құпия жер
Dialogue: 0,0:19:48.20,0:19:49.14,Default,,0,0,0,,Мен саған көрсетемін!
Dialogue: 0,0:19:49.54,0:19:50.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:51.27,0:19:52.24,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:52.78,0:19:53.78,Default,,0,0,0,,♬~
Dialogue: 0,0:19:54.98,0:19:56.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:59.78,0:20:00.98,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:20:04.75,0:20:07.32,Default,,0,0,0,,Жаңбыр жауып тұр!
Dialogue: 0,0:20:09.46,0:20:10.46,Default,,0,0,0,,Әй
Dialogue: 0,0:20:10.56,0:20:11.99,Default,,0,0,0,,Таа~!
Dialogue: 0,0:20:17.83,0:20:18.84,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:19.97,0:20:21.50,Default,,0,0,0,,Әдемі!
Dialogue: 0,0:20:25.81,0:20:29.51,Default,,0,0,0,,Мен жастық шағымдағы кимононы қайта жасадым.
Dialogue: 0,0:20:29.68,0:20:33.35,Default,,0,0,0,,Телефон бағандарына бекінген аяқ-қолдар бар сияқты.
Dialogue: 0,0:20:33.75,0:20:35.35,Default,,0,0,0,,Бұл сізге жарасады.
Dialogue: 0,0:20:35.49,0:20:38.32,Default,,0,0,0,,Иә, аяқтары ішке сәл қысылған.
Dialogue: 0,0:20:38.42,0:20:40.09,Default,,0,0,0,,Бірқалыпты жүру
Dialogue: 0,0:20:40.19,0:20:41.82,Default,,0,0,0,,татами жанындағы 3 қадам
Dialogue: 0,0:20:41.92,0:20:43.36,Default,,0,0,0,,6 тік қадамнан тұратын нұсқаулық ретінде
Dialogue: 0,0:20:43.53,0:20:45.16,Default,,0,0,0,,Жиектерді баспаңыз
Dialogue: 0,0:20:45.93,0:20:46.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:48.36,0:20:49.20,Default,,0,0,0,,Ей! Уф...
Dialogue: 0,0:20:49.33,0:20:50.47,Default,,0,0,0,,Әй... ау!
Dialogue: 0,0:20:50.80,0:20:54.20,Default,,0,0,0,,Оң аяғыңызды төмен түсіріп, денеңізді тік төмен түсіріңіз.
Dialogue: 0,0:20:54.34,0:20:55.67,Default,,0,0,0,,Уһ ита тата...
Dialogue: 0,0:20:55.77,0:20:56.69,Default,,0,0,0,,-Уф-Ах
Dialogue: 0,0:20:57.01,0:20:58.31,Default,,0,0,0,,Сандалдарды қайтарып, шетіне әкеліңіз...
Dialogue: 0,0:20:58.37,0:20:59.88,Default,,0,0,0,,-Уау! -Ах!
Dialogue: 0,0:21:00.71,0:21:02.88,Default,,0,0,0,,Мен сенің өкшеңді басатын сияқтымын.
Dialogue: 0,0:21:02.98,0:21:03.71,Default,,0,0,0,,Қалай!
Dialogue: 0,0:21:03.81,0:21:04.48,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:21:04.55,0:21:05.35,Default,,0,0,0,,Ах
Dialogue: 0,0:21:05.88,0:21:07.05,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:21:07.22,0:21:07.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:08.05,0:21:09.72,Default,,0,0,0,,Ммммммм...
Dialogue: 0,0:21:11.22,0:21:12.22,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:21:12.36,0:21:15.56,Default,,0,0,0,,Бөлмеге қате кірсе, қонаққа оны ұстауға рұқсат бересіз бе?
Dialogue: 0,0:21:18.90,0:21:20.90,Default,,0,0,0,,Қонақ үйде жұмыс істеу қиын.
Dialogue: 0,0:21:21.40,0:21:23.40,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:21:23.80,0:21:25.57,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:21:26.54,0:21:28.57,Default,,0,0,0,,Қолды реттеу кезінде
Dialogue: 0,0:21:28.74,0:21:29.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:31.21,0:21:32.74,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:21:32.98,0:21:34.34,Default,,0,0,0,,Мен тағамдар әкелдім.
Dialogue: 0,0:21:34.91,0:21:36.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:36.58,0:21:39.42,Default,,0,0,0,,Тазалау кезінде әртүрлі киімдер болады.
Dialogue: 0,0:21:39.58,0:21:40.68,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:40.75,0:21:42.42,Default,,0,0,0,,Кимоно киюге үйренгім келеді.
Dialogue: 0,0:21:42.55,0:21:43.39,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:21:43.69,0:21:45.09,Default,,0,0,0,,Ыстық көктемгі пудинг
Dialogue: 0,0:21:45.19,0:21:48.26,Default,,0,0,0,,Бұл Ясуши-сан жасаған Хару-но-я пудингі.
Dialogue: 0,0:21:48.93,0:21:49.76,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:49.86,0:21:50.89,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:51.09,0:21:52.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:53.23,0:21:54.36,Default,,0,0,0,,Хмм!
Dialogue: 0,0:21:54.43,0:21:56.10,Default,,0,0,0,,Көктемнің дәмі бар
Dialogue: 0,0:21:56.57,0:21:58.43,Default,,0,0,0,,Ертең мектеп, солай ма?
Dialogue: 0,0:21:58.53,0:22:01.07,Default,,0,0,0,,Дұрыстап амандасу үшін.
Dialogue: 0,0:22:01.17,0:22:02.71,Default,,0,0,0,,Иә
Dialogue: 0,0:22:04.94,0:22:06.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:06.21,0:22:07.61,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:22:08.28,0:22:10.95,Default,,0,0,0,,Урибо! Сен неге менің пудингімді жейсің?
Dialogue: 0,0:22:11.51,0:22:13.28,Default,,0,0,0,,Мені істеме
Dialogue: 0,0:22:13.62,0:22:15.75,Default,,0,0,0,,Юрей тамақ жей ала ма?
Dialogue: 0,0:22:17.29,0:22:18.55,Default,,0,0,0,,Әрине
Dialogue: 0,0:22:19.36,0:22:21.56,Default,,0,0,0,,Ммммм
Dialogue: 0,0:22:21.62,0:22:24.79,Default,,0,0,0,,Ммммммммм
Dialogue: 0,0:22:24.93,0:22:25.76,Default,,0,0,0,,Хмм
Dialogue: 0,0:22:25.86,0:22:26.99,Default,,0,0,0,,- Пакет - Уау!
Dialogue: 0,0:22:27.90,0:22:30.97,Default,,0,0,0,,Не? Пудингті жеген әкем еді.
Dialogue: 0,0:22:31.60,0:22:33.80,Default,,0,0,0,,Окко, тез киіміңді ауыстыр.
Dialogue: 0,0:22:33.97,0:22:35.14,Default,,0,0,0,,Мектеп бүгін басталады, солай ма?
Dialogue: 0,0:22:35.27,0:22:37.47,Default,,0,0,0,,Уау, анашым, сіз кимоноға жақсысыз.
Dialogue: 0,0:22:37.87,0:22:39.94,Default,,0,0,0,,Мұғалімге сәлем беруім керек.
Dialogue: 0,0:22:41.31,0:22:44.11,Default,,0,0,0,,Бүгіннен бастап біз осы сыныпта бірге оқимыз.
Dialogue: 0,0:22:44.21,0:22:45.95,Default,,0,0,0,,Бұл Орико Секи.
Dialogue: 0,0:22:46.95,0:22:48.75,Default,,0,0,0,,Сәлемдесу
Dialogue: 0,0:22:50.65,0:22:52.22,Default,,0,0,0,,Бұл Орико Секи.
Dialogue: 0,0:22:52.32,0:22:54.32,Default,,0,0,0,,Мені «Окко» деп атаңыз
Dialogue: 0,0:22:54.46,0:22:56.16,Default,,0,0,0,,Мен Харуноя Риоканда тұрамын.
Dialogue: 0,0:22:56.43,0:22:57.49,Default,,0,0,0,,А, ана жерде!
Dialogue: 0,0:22:57.66,0:22:59.50,Default,,0,0,0,,Иә! Окко
Dialogue: 0,0:22:59.60,0:23:01.13,Default,,0,0,0,,Бұл біраз кінәлі сезім емес пе?
Dialogue: 0,0:23:01.66,0:23:03.17,Default,,0,0,0,,Ио, Хару жоқ Я!
Dialogue: 0,0:23:03.50,0:23:05.67,Default,,0,0,0,,Урибо мектепке
Dialogue: 0,0:23:10.91,0:23:12.64,Default,,0,0,0,,Эй, мен сыртқа жүгіріп келемін.
Dialogue: 0,0:23:12.74,0:23:13.51,Default,,0,0,0,,Уа!
Dialogue: 0,0:23:16.18,0:23:17.45,Default,,0,0,0,,Мен, Йорико
Dialogue: 0,0:23:17.51,0:23:20.45,Default,,0,0,0,,Біз Хананою көшесінде жапондық тәттілер дүкенін ашамыз.
Dialogue: 0,0:23:20.52,0:23:22.35,Default,,0,0,0,,Сәлем, танысқаныма қуаныштымын!
Dialogue: 0,0:23:22.85,0:23:24.35,Default,,0,0,0,,Одан да артық, Секи мырза.
Dialogue: 0,0:23:24.52,0:23:26.52,Default,,0,0,0,,Істікшені сермеу үшін абай болыңыз.
Dialogue: 0,0:23:27.59,0:23:28.52,Default,,0,0,0,,Бейнелеуді бекіту керек пе?
Dialogue: 0,0:23:28.66,0:23:29.63,Default,,0,0,0,,Иә
Dialogue: 0,0:23:30.19,0:23:31.33,Default,,0,0,0,,Қызғылт кейіпте…
Dialogue: 0,0:23:32.46,0:23:33.70,Default,,0,0,0,,Өтініш…
Dialogue: 0,0:23:34.03,0:23:36.70,Default,,0,0,0,,Сіз көктемгі дүкендесіз бе?
Dialogue: 0,0:23:37.37,0:23:38.20,Default,,0,0,0,,Хмм?
Dialogue: 0,0:23:38.67,0:23:40.70,Default,,0,0,0,,Менің... әжем менің әйелім болды.
Dialogue: 0,0:23:41.20,0:23:42.71,Default,,0,0,0,,Біздің үй де қонақ үй.
Dialogue: 0,0:23:42.84,0:23:45.37,Default,,0,0,0,,Сіз Акиёши Рёканды білесіз бе?
Dialogue: 0,0:23:45.54,0:23:48.54,Default,,0,0,0,,Мен жалғыз қызымын, Мацуки Акино.
Dialogue: 0,0:23:50.65,0:23:51.38,Default,,0,0,0,,Хмм…
Dialogue: 0,0:23:51.51,0:23:54.55,Default,,0,0,0,,Хару но Ясан - сүйкімді қонақ үй.
Dialogue: 0,0:23:54.65,0:23:55.65,Default,,0,0,0,,Рахмет
Dialogue: 0,0:23:57.19,0:24:01.02,Default,,0,0,0,,Бұл тек 5 қонақ бөлмесі бар шағын ағаш ғимарат.
Dialogue: 0,0:24:01.12,0:24:05.56,Default,,0,0,0,,Жабайы көкөністер мен сол аймақтың өзен балықтарын да ұсынасыз ба?
Dialogue: 0,0:24:05.70,0:24:06.73,Default,,0,0,0,,Иә
Dialogue: 0,0:24:06.86,0:24:11.07,Default,,0,0,0,,Біздің тағамымыз сәнді, таңғы швед үстеліміз де өте танымал.
Dialogue: 0,0:24:12.00,0:24:13.04,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:24:13.14,0:24:15.40,Default,,0,0,0,,Қазіргі уақытта біз ашық ванналары бар қонақ бөлмелерінің санын көбейтеміз.
Dialogue: 0,0:24:15.84,0:24:16.50,Default,,0,0,0,,Хамф!
Dialogue: 0,0:24:16.60,0:24:18.93,Default,,0,0,0,,-Клиенттерді жалықтырып алмау үшін... -Хихихихи
Dialogue: 0,0:24:19.08,0:24:21.69,Default,,0,0,0,,-Ол көп ақша жұмсайды және бұл азап. -Иә.
Dialogue: 0,0:24:21.88,0:24:23.71,Default,,0,0,0,,Жақсы, көктемгі дүкен
Dialogue: 0,0:24:23.81,0:24:25.92,Default,,0,0,0,,Маған бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:24:26.06,0:24:27.42,Default,,0,0,0,,-Ахахаха! -Пфф...
Dialogue: 0,0:24:28.35,0:24:29.59,Default,,0,0,0,,Не болды?
Dialogue: 0,0:24:29.69,0:24:30.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:30.75,0:24:32.42,Default,,0,0,0,,Кешіріңіз, Пинфури-сан
Dialogue: 0,0:24:32.52,0:24:33.26,Default,,0,0,0,,Ха...
Dialogue: 0,0:24:33.42,0:24:34.42,Default,,0,0,0,,Шыңғырлауды бейнелеу?
Dialogue: 0,0:24:34.59,0:24:36.09,Default,,0,0,0,,Пинфури дегеніміз не?
Dialogue: 0,0:24:36.49,0:24:38.43,Default,,0,0,0,,Қызғылт фурифури?
Dialogue: 0,0:24:39.00,0:24:40.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:40.93,0:24:42.77,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:24:43.27,0:24:44.10,Default,,0,0,0,,А... Уф
Dialogue: 0,0:24:44.23,0:24:45.87,Default,,0,0,0,,Ах, ол тек телефон арқылы сөйлескенін айтты.
Dialogue: 0,0:24:45.94,0:24:48.60,Default,,0,0,0,,Бұл аздап жарқыраған немесе қалқыған.
Dialogue: 0,0:24:48.70,0:24:51.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:51.27,0:24:52.61,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:24:52.71,0:24:56.01,Default,,0,0,0,,Мен қалыпты нәрсеге айналғым келмейді!
Dialogue: 0,0:24:56.11,0:24:59.62,Default,,0,0,0,,Бірақ уақыт пен орынға сәйкес келетін белгілі бір стильдер бар.
Dialogue: 0,0:24:59.75,0:25:01.92,Default,,0,0,0,,Бұл қалыпты жағдай, солай ма?
Dialogue: 0,0:25:02.02,0:25:03.62,Default,,0,0,0,,Мен осы қоғамдамын
Dialogue: 0,0:25:03.75,0:25:05.35,Default,,0,0,0,,Жоқ, бұл ғаламда
Dialogue: 0,0:25:05.46,0:25:07.12,Default,,0,0,0,,Мен сізді таң қалдырғым келеді!
Dialogue: 0,0:25:07.76,0:25:10.23,Default,,0,0,0,,Стив Джобс
Dialogue: 0,0:25:11.39,0:25:12.30,Default,,0,0,0,,Пу!
Dialogue: 0,0:25:14.73,0:25:16.47,Default,,0,0,0,,Қандай дөрекі!
Dialogue: 0,0:25:17.37,0:25:18.37,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:25:18.47,0:25:21.64,Default,,0,0,0,,Хару-но-яның беделінің одан әрі нашарлауына жол берме.
Dialogue: 0,0:25:22.07,0:25:23.81,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:25:24.31,0:25:26.48,Default,,0,0,0,,Біздің қонақ үй жақсы қонақ үй!
Dialogue: 0,0:25:27.78,0:25:28.64,Default,,0,0,0,,Хмм.
Dialogue: 0,0:25:29.78,0:25:31.81,Default,,0,0,0,,Уф…
Dialogue: 0,0:25:32.45,0:25:33.98,Default,,0,0,0,,Керемет Секи-сан!
Dialogue: 0,0:25:34.15,0:25:37.39,Default,,0,0,0,,Секи-сан ғана оның кейіп танытуының біртүрлі екенін айтты.
Dialogue: 0,0:25:37.49,0:25:38.65,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:25:38.76,0:25:40.39,Default,,0,0,0,,Бұл сергіту болды, солай емес пе?
Dialogue: 0,0:25:40.49,0:25:41.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:25:41.66,0:25:42.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:42.45,0:25:44.23,Default,,0,0,0,,Секи мырза, сіз батылсыз.
Dialogue: 0,0:25:44.39,0:25:45.27,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:25:46.06,0:25:46.93,Default,,0,0,0,,Әй!
Dialogue: 0,0:25:47.83,0:25:48.77,Default,,0,0,0,,Ах... Ах.
Dialogue: 0,0:25:50.17,0:25:51.47,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:25:51.67,0:25:52.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:54.84,0:25:56.07,Default,,0,0,0,,Секи мырза, бұл бетке не болды?
Dialogue: 0,0:25:56.17,0:25:58.34,Default,,0,0,0,,Бұл қызық!
Dialogue: 0,0:26:00.28,0:26:03.45,Default,,0,0,0,,Урибодан басқа Юрей де болды.
Dialogue: 0,0:26:04.01,0:26:05.82,Default,,0,0,0,,Мен оны қудым
Dialogue: 0,0:26:05.92,0:26:08.02,Default,,0,0,0,,Бір жерде жоғалып кетті
Dialogue: 0,0:26:08.15,0:26:09.59,Default,,0,0,0,,Ақан, амансың ба?
Dialogue: 0,0:26:09.69,0:26:10.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:10.59,0:26:13.36,Default,,0,0,0,,Ылғалдылықты сақтаңыз
Dialogue: 0,0:26:13.49,0:26:14.52,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:26:15.83,0:26:17.33,Default,,0,0,0,,Не болды?
Dialogue: 0,0:26:17.59,0:26:19.36,Default,,0,0,0,,Мен сізге қоңырау шалсам ше?
Dialogue: 0,0:26:19.50,0:26:20.43,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:26:20.53,0:26:23.10,Default,,0,0,0,,Өзіңізді нашар сезінесіз бе? Немесе бірдеңе
Dialogue: 0,0:26:23.20,0:26:25.30,Default,,0,0,0,,Сіз адасып қалдыңыз ба? Немесе бірдеңе
Dialogue: 0,0:26:26.04,0:26:27.20,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:26:29.21,0:26:31.51,Default,,0,0,0,,Аа, алаңдағаныңызға рахмет.
Dialogue: 0,0:26:31.61,0:26:33.88,Default,,0,0,0,,Менің баламның қызуы көтерілді.
Dialogue: 0,0:26:34.38,0:26:35.21,Default,,0,0,0,,А...
Dialogue: 0,0:26:39.55,0:26:41.22,Default,,0,0,0,,Мен тұратын жер іздеп жүрмін.
Dialogue: 0,0:26:41.35,0:26:43.15,Default,,0,0,0,,Күрсін... Барлық жер толып жатыр.
Dialogue: 0,0:26:43.69,0:26:44.89,Default,,0,0,0,,Орналастыру…
Dialogue: 0,0:26:45.19,0:26:48.83,Default,,0,0,0,,Менің үйімде қалғың келе ме? Сіз қалай ойлайсыз?
Dialogue: 0,0:26:49.39,0:26:50.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:26:50.73,0:26:53.16,Default,,0,0,0,,Әже, ашуланбайсыз ба?
Dialogue: 0,0:26:53.73,0:26:58.13,Default,,0,0,0,,Минеко-чан, адамдарға сырт келбетіне қарап баға беретін қыз болма.
Dialogue: 0,0:26:58.23,0:26:59.37,Default,,0,0,0,,Хмм
Dialogue: 0,0:27:00.74,0:27:03.41,Default,,0,0,0,,Бұл үйде қонақ үй бар.
Dialogue: 0,0:27:03.51,0:27:04.74,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:27:04.91,0:27:05.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:06.01,0:27:08.75,Default,,0,0,0,,Мен Харунояның әйелімін.
Dialogue: 0,0:27:08.88,0:27:10.91,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:27:11.41,0:27:13.42,Default,,0,0,0,,Кенет өзгеріс үшін кешірім сұраймыз.
Dialogue: 0,0:27:13.52,0:27:14.25,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:27:14.35,0:27:17.05,Default,,0,0,0,,Минеко-чан әрбір тұтынушыға сыпайы.
Dialogue: 0,0:27:17.15,0:27:17.85,Default,,0,0,0,,Иә
Dialogue: 0,0:27:18.09,0:27:19.72,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:27:22.26,0:27:24.59,Default,,0,0,0,,Дәрігерді шақырайын ба?
Dialogue: 0,0:27:24.73,0:27:26.10,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:27:26.20,0:27:29.27,Default,,0,0,0,,Менің балам шаршаған кезде қызуы жиі көтеріледі.
Dialogue: 0,0:27:30.43,0:27:31.27,Default,,0,0,0,,Ха...
Dialogue: 0,0:27:31.93,0:27:32.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:27:33.17,0:27:36.61,Default,,0,0,0,,Сонымен қатар, ыстық бұлақтар бастапқыда ыстық сумен емдеу орны болып табылады.
Dialogue: 0,0:27:36.77,0:27:37.94,Default,,0,0,0,,Бұл сәл ақымақтық емес пе?
Dialogue: 0,0:27:38.07,0:27:39.11,Default,,0,0,0,,Иә
Dialogue: 0,0:27:39.94,0:27:42.75,Default,,0,0,0,,Сіз осында саяхаттайсыз ба?
Dialogue: 0,0:27:43.41,0:27:44.61,Default,,0,0,0,,Иә
Dialogue: 0,0:27:44.75,0:27:46.88,Default,,0,0,0,,Бейітті зиярат ету кезінде
Dialogue: 0,0:27:46.95,0:27:49.05,Default,,0,0,0,,Мен ыстық суға шомыламын деп ойлаймын.
Dialogue: 0,0:27:52.46,0:27:53.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:54.62,0:27:55.63,Default,,0,0,0,,Шын мәнінде
Dialogue: 0,0:27:55.76,0:27:58.06,Default,,0,0,0,,Менің әйелім өткен айда қайтыс болды.
Dialogue: 0,0:27:58.13,0:27:59.13,Default,,0,0,0,,-Е... -Е...
Dialogue: 0,0:28:00.30,0:28:03.13,Default,,0,0,0,,Бұл сіз үшін үлкен мәселе болса керек.
Dialogue: 0,0:28:03.30,0:28:04.97,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:28:05.07,0:28:07.30,Default,,0,0,0,,Көңіл айтуымды қабыл алыңыз.
Dialogue: 0,0:28:07.80,0:28:09.74,Default,,0,0,0,,Қараңызшы, дәл сол жерде.
Dialogue: 0,0:28:09.97,0:28:10.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:10.97,0:28:12.58,Default,,0,0,0,,Анамның қайтыс болғанын айтқанымда
Dialogue: 0,0:28:12.64,0:28:14.64,Default,,0,0,0,,Бұл адамды бәрі аяйды.
Dialogue: 0,0:28:14.74,0:28:15.75,Default,,0,0,0,,Жетеді
Dialogue: 0,0:28:15.81,0:28:16.81,Default,,0,0,0,,Ақан
Dialogue: 0,0:28:17.58,0:28:18.82,Default,,0,0,0,,Әке, үйге қайтайық!
Dialogue: 0,0:28:18.98,0:28:21.45,Default,,0,0,0,,Негізі мен ыстық бұлаққа барғым келмеді.
Dialogue: 0,0:28:21.88,0:28:23.32,Default,,0,0,0,,Ақан, ұйықта.
Dialogue: 0,0:28:23.65,0:28:26.66,Default,,0,0,0,,Оның үстіне осы таудың тереңінде...
Dialogue: 0,0:28:27.26,0:28:28.32,Default,,0,0,0,,Бұл!
Dialogue: 0,0:28:28.49,0:28:29.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:28:29.89,0:28:30.63,Default,,0,0,0,,Окко
Dialogue: 0,0:28:30.73,0:28:33.96,Default,,0,0,0,,Әке, ол сіздің көңіл-күйіңізді көтермек болды.
Dialogue: 0,0:28:34.06,0:28:35.50,Default,,0,0,0,,Сіз бұл сезімді түсінбейсіз бе!?
Dialogue: 0,0:28:36.97,0:28:39.34,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:28:39.44,0:28:40.27,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:28:40.34,0:28:42.94,Default,,0,0,0,,Мен де ата-анамнан айырылдым.
Dialogue: 0,0:28:43.01,0:28:44.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:44.27,0:28:45.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:45.34,0:28:48.61,Default,,0,0,0,,Бірақ бәрі мен үшін алаңдайды, сондықтан мен бар күшімді салуым керек.
Dialogue: 0,0:28:50.58,0:28:53.68,Default,,0,0,0,,Әр нәрсеге көп еңбектену керек деп ойлау
Dialogue: 0,0:28:53.78,0:28:54.98,Default,,0,0,0,,Мен сені жек көремін.
Dialogue: 0,0:28:55.75,0:28:59.02,Default,,0,0,0,,Маған қажет емес кезде ауыр жұмыс істейтін адамдарды көрген ұнамайды.
Dialogue: 0,0:28:59.19,0:29:00.29,Default,,0,0,0,,Ақан, тоқтат!
Dialogue: 0,0:29:00.36,0:29:01.49,Default,,0,0,0,,Бұл мен туралы ма?
Dialogue: 0,0:29:01.59,0:29:02.36,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:29:02.46,0:29:04.53,Default,,0,0,0,,Дұрыс, қызу қанды.
Dialogue: 0,0:29:04.66,0:29:05.66,Default,,0,0,0,,Уау
Dialogue: 0,0:29:05.76,0:29:07.50,Default,,0,0,0,,Қандай бұзық әрекет.
Dialogue: 0,0:29:07.60,0:29:08.30,Default,,0,0,0,,Шынымен
Dialogue: 0,0:29:08.36,0:29:10.03,Default,,0,0,0,,Қандай бұзық адам!?
Dialogue: 0,0:29:10.17,0:29:11.37,Default,,0,0,0,,Айт, айт!
Dialogue: 0,0:29:11.47,0:29:14.14,Default,,0,0,0,,Бейқам болма, адам!
Dialogue: 0,0:29:15.97,0:29:19.64,Default,,0,0,0,,Сіз қанша жаста болсаңыз да, сіздің тұтынушыларыңыз сіздің тұтынушыларыңыз.
Dialogue: 0,0:29:19.71,0:29:23.38,Default,,0,0,0,,Бұл сізді Харунояның жас ханымы болуға жарамайды.
Dialogue: 0,0:29:23.88,0:29:26.55,Default,,0,0,0,,Қалыпты тұтынушы болса жақсы болар еді.
Dialogue: 0,0:29:26.68,0:29:27.88,Default,,0,0,0,,-Оқко! -Ух...
Dialogue: 0,0:29:27.98,0:29:31.49,Default,,0,0,0,,Клиенттеріңізді қалыпты деп аталатын анық емес стандартты пайдаланып өлшеуге болмайды.
Dialogue: 0,0:29:31.82,0:29:33.89,Default,,0,0,0,,«Қарапайым тұтынушы» қалай аталады?
Dialogue: 0,0:29:33.99,0:29:36.53,Default,,0,0,0,,Мен саған қарамаймын дегенмен бірдей.
Dialogue: 0,0:29:36.63,0:29:38.66,Default,,0,0,0,,Қонақжайлығыңызға көңілім қалды.
Dialogue: 0,0:29:40.46,0:29:42.70,Default,,0,0,0,,Хананою Онсендегі ыстық судың шашырауы
Dialogue: 0,0:29:42.80,0:29:44.00,Default,,0,0,0,,Ешкім бас тартпайды
Dialogue: 0,0:29:44.07,0:29:46.57,Default,,0,0,0,,Барлығын қабылдауға болады.
Dialogue: 0,0:29:46.67,0:29:49.87,Default,,0,0,0,,Өйткені бұл біз Құдайдан алатын нәрсе.
Dialogue: 0,0:29:50.37,0:29:53.74,Default,,0,0,0,,Біраз тынышталған соң барып кешірім сұрай аламын ба?
Dialogue: 0,0:29:55.68,0:29:56.75,Default,,0,0,0,,бара алмаймын
Dialogue: 0,0:29:57.65,0:29:58.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:30:00.02,0:30:01.25,Default,,0,0,0,,Кеттік
Dialogue: 0,0:30:02.22,0:30:03.02,Default,,0,0,0,,На
Dialogue: 0,0:30:03.09,0:30:04.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:30:05.15,0:30:06.09,Default,,0,0,0,,Не?
Dialogue: 0,0:30:06.92,0:30:08.26,Default,,0,0,0,,Бау!
Dialogue: 0,0:30:09.26,0:30:10.43,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:30:12.10,0:30:14.36,Default,,0,0,0,,А, жоқ, жоқ, жоқ...
Dialogue: 0,0:30:14.43,0:30:16.43,Default,,0,0,0,,Үй шаруасындағы әйел Жас ханым да
Dialogue: 0,0:30:16.57,0:30:18.57,Default,,0,0,0,,Басыңызды көтеріңіз
Dialogue: 0,0:30:18.67,0:30:20.27,Default,,0,0,0,,Бұл жаман нәрсе.
Dialogue: 0,0:30:20.60,0:30:23.11,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:30:23.51,0:30:25.27,Default,,0,0,0,,(Изуку) Ойланып көрсең, біз таңғаларлық іс жасаппыз, иә?
Dialogue: 0,0:30:26.04,0:30:28.88,Default,,0,0,0,,Одан да жас әйелмен дауласудың арқасында.
Dialogue: 0,0:30:28.95,0:30:31.71,Default,,0,0,0,,Ақанның да қызуы түсіп кеткен сияқты.
Dialogue: 0,0:30:32.62,0:30:34.28,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:30:34.88,0:30:35.95,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:30:36.55,0:30:39.46,Default,,0,0,0,,Енді кешкі ас әкелейік.
Dialogue: 0,0:30:40.09,0:30:41.62,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:30:45.90,0:30:47.73,Default,,0,0,0,,Мен омлет күрішін жегім келеді.
Dialogue: 0,0:30:47.96,0:30:48.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:48.93,0:30:50.10,Default,,0,0,0,,Ақан
Dialogue: 0,0:30:50.30,0:30:52.40,Default,,0,0,0,,Бұл мейрамхана емес.
Dialogue: 0,0:30:52.47,0:30:54.77,Default,,0,0,0,,Біз оны сізге дайындаймыз.
Dialogue: 0,0:30:54.87,0:30:55.97,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:30:56.14,0:30:57.41,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:30:58.47,0:30:59.31,Default,,0,0,0,,Торт
Dialogue: 0,0:30:59.78,0:31:00.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:01.08,0:31:02.75,Default,,0,0,0,,Бейқам болмаңыз
Dialogue: 0,0:31:02.81,0:31:04.81,Default,,0,0,0,,Сіз тым өзімшілсіз.
Dialogue: 0,0:31:04.95,0:31:06.58,Default,,0,0,0,,Мен жай ғана айттым.
Dialogue: 0,0:31:07.78,0:31:09.59,Default,,0,0,0,,Мен оны сатып аламын!
Dialogue: 0,0:31:09.65,0:31:10.49,Default,,0,0,0,,Окко?
Dialogue: 0,0:31:13.12,0:31:15.09,Default,,0,0,0,,♬~
Dialogue: 0,0:31:15.16,0:31:17.49,Default,,0,0,0,,Неліктен мұндай адам үшін?
Dialogue: 0,0:31:17.63,0:31:19.13,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:31:19.23,0:31:21.66,Default,,0,0,0,,♬~
Dialogue: 0,0:31:22.06,0:31:24.07,Default,,0,0,0,,Ақане-санға қарап тұрғанымда
Dialogue: 0,0:31:24.17,0:31:27.00,Default,,0,0,0,,Менің кеудеме бірдеңе тығылды...
Dialogue: 0,0:31:27.80,0:31:30.17,Default,,0,0,0,,Мен саған бірдеңе жасағым келді.
Dialogue: 0,0:31:30.67,0:31:32.18,Default,,0,0,0,,Мұнда да жақсы.
Dialogue: 0,0:31:32.68,0:31:35.01,Default,,0,0,0,,♬~
Dialogue: 0,0:31:35.51,0:31:37.51,Default,,0,0,0,,А... не істеуім керек?
Dialogue: 0,0:31:38.05,0:31:39.12,Default,,0,0,0,,Хаха хаха
Dialogue: 0,0:31:39.26,0:31:41.12,Default,,0,0,0,,-Хунхун хунхун -Хмм?
Dialogue: 0,0:31:41.23,0:31:48.10,Default,,0,0,0,,иә һә һә һә һә иә һә һә иә һә иә һә һә һә иә һә һә һә һә иә һә һә һә иә
Dialogue: 0,0:31:48.15,0:31:48.85,Default,,0,0,0,,А...
Dialogue: 0,0:31:48.95,0:31:50.55,Default,,0,0,0,,Хун хұн...
Dialogue: 0,0:31:51.26,0:31:53.53,Default,,0,0,0,,О, сен, көктемгі дүкеннен.
Dialogue: 0,0:31:54.30,0:31:55.70,Default,,0,0,0,,Жақында «Сакура Саку» орындалды деген хабар келеді.
Dialogue: 0,0:31:55.87,0:31:57.47,Default,,0,0,0,,Көктемгі дүкен
Dialogue: 0,0:32:00.27,0:32:01.70,Default,,0,0,0,,Ыстық көктемгі пудинг!
Dialogue: 0,0:32:01.97,0:32:02.77,Default,,0,0,0,,Хмм?
Dialogue: 0,0:32:05.27,0:32:06.98,Default,,0,0,0,,Рахмет, анашым!
Dialogue: 0,0:32:07.04,0:32:08.01,Default,,0,0,0,,пудинг?
Dialogue: 0,0:32:08.11,0:32:10.35,Default,,0,0,0,,Өзіңізді жаман сезінбеңіз.
Dialogue: 0,0:32:13.28,0:32:14.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:32:50.59,0:32:51.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:53.49,0:32:55.26,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:32:55.36,0:32:58.06,Default,,0,0,0,,Сіз оны тұтынушыларға қызмет көрсетуден ұялмайсыз.
Dialogue: 0,0:32:58.16,0:33:01.20,Default,,0,0,0,,Уау! Рахмет Ясу-сан
Dialogue: 0,0:33:01.26,0:33:02.53,Default,,0,0,0,,Менің де жегім келеді
Dialogue: 0,0:33:04.53,0:33:07.27,Default,,0,0,0,,Кешіріңіз, торт дүкені жабық...
Dialogue: 0,0:33:07.37,0:33:10.11,Default,,0,0,0,,Бірақ менің ойымша, бұл дәмді, сондықтан көріңіз.
Dialogue: 0,0:33:10.51,0:33:11.71,Default,,0,0,0,,Рахмет
Dialogue: 0,0:33:13.91,0:33:15.58,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:33:18.11,0:33:19.45,Default,,0,0,0,,Ақан
Dialogue: 0,0:33:19.85,0:33:22.75,Default,,0,0,0,,Кешіріңіз, сіз оны маған дайындадым.
Dialogue: 0,0:33:22.85,0:33:23.95,Default,,0,0,0,,Жоқ
Dialogue: 0,0:33:24.05,0:33:25.56,Default,,0,0,0,,Ашық пластинаны түсіріңіз
Dialogue: 0,0:33:26.72,0:33:28.79,Default,,0,0,0,,Өте дәмді болды.
Dialogue: 0,0:33:29.26,0:33:32.43,Default,,0,0,0,,Ақан да омлет күрішін жеп қойды.
Dialogue: 0,0:33:34.20,0:33:35.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:33:36.27,0:33:37.30,Default,,0,0,0,,А...
Dialogue: 0,0:33:37.40,0:33:39.97,Default,,0,0,0,,Тамақты әдемі жегеніңіз үшін рахмет.
Dialogue: 0,0:33:40.47,0:33:41.80,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:33:41.97,0:33:42.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:33:43.74,0:33:44.74,Default,,0,0,0,,Ой!
Dialogue: 0,0:33:45.31,0:33:46.31,Default,,0,0,0,,Юдзуки
Dialogue: 0,0:33:50.21,0:33:51.38,Default,,0,0,0,,Бұл...
Dialogue: 0,0:33:51.48,0:33:54.82,Default,,0,0,0,,Әйелі де әйеліме тамақ әзірлеп берді.
Dialogue: 0,0:33:55.45,0:33:58.32,Default,,0,0,0,,Тағы бірге тамақтанатынымызға сене алар емеспін.
Dialogue: 0,0:33:59.42,0:34:00.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:00.49,0:34:02.16,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:34:03.66,0:34:05.29,Default,,0,0,0,,Қандай бақыттысыңдар, барлық қызықты өзіңе алдыңдар.
Dialogue: 0,0:34:06.93,0:34:07.83,Default,,0,0,0,,Уф, оқ-дәрі астында қалып қоюдың өзі бір әлем екен
Dialogue: 0,0:34:09.40,0:34:10.67,Default,,0,0,0,,Хааааа...
Dialogue: 0,0:34:10.77,0:34:11.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:15.61,0:34:17.01,Default,,0,0,0,,Ақан
Dialogue: 0,0:34:17.81,0:34:20.01,Default,,0,0,0,,Сенің мұнда келгеніңе қуаныштымын.
Dialogue: 0,0:34:21.01,0:34:21.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:23.01,0:34:24.01,Default,,0,0,0,,На
Dialogue: 0,0:34:34.86,0:34:35.86,Default,,0,0,0,,Хмм
Dialogue: 0,0:34:36.49,0:34:37.86,Default,,0,0,0,,Әже
Dialogue: 0,0:34:40.43,0:34:41.46,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:34:41.53,0:34:43.53,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:34:43.67,0:34:46.94,Default,,0,0,0,,Анам маған тамақ жасауды ғана үйретті.
Dialogue: 0,0:34:47.04,0:34:48.14,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:34:48.20,0:34:49.11,Default,,0,0,0,,Тағы бір тістеу
Dialogue: 0,0:34:49.21,0:34:50.37,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:34:51.11,0:34:53.38,Default,,0,0,0,,Балалардың көзінше
Dialogue: 0,0:34:53.54,0:34:55.48,Default,,0,0,0,,Оны өзіңіз жеңіз
Dialogue: 0,0:34:55.55,0:34:58.21,Default,,0,0,0,,Анамда пудинг бар.
Dialogue: 0,0:34:58.31,0:34:59.18,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:34:59.28,0:35:00.32,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:35:00.62,0:35:02.05,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:35:03.65,0:35:04.72,Default,,0,0,0,,Эй
Dialogue: 0,0:35:05.05,0:35:07.89,Default,,0,0,0,,Анаң мен әкең тірі, солай ма?
Dialogue: 0,0:35:08.01,0:35:09.60,Default,,0,0,0,,- Иә? -Ууфуу гогого
Dialogue: 0,0:35:10.19,0:35:11.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:11.53,0:35:13.40,Default,,0,0,0,,Ал оны алдымен адам алған, иә?
Dialogue: 0,0:35:13.50,0:35:14.56,Default,,0,0,0,,Иә
Dialogue: 0,0:35:15.16,0:35:16.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:24.97,0:35:26.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:27.81,0:35:29.21,Default,,0,0,0,,Әкем
Dialogue: 0,0:35:29.31,0:35:30.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:32.52,0:35:34.42,Default,,0,0,0,,Аа, ұзақ уақыт!
Dialogue: 0,0:35:36.69,0:35:37.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:46.26,0:35:49.07,Default,,0,0,0,,Ақан маған мектепке баратынын айтты.
Dialogue: 0,0:35:49.17,0:35:52.27,Default,,0,0,0,,Мен тағы біраз демалуды жоспарладым.
Dialogue: 0,0:35:52.40,0:35:55.54,Default,,0,0,0,,Ол өз ойын өзгерткенше мен кетейін деп шештім.
Dialogue: 0,0:35:56.57,0:35:58.94,Default,,0,0,0,,Такси осында!
Dialogue: 0,0:35:59.78,0:36:01.11,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:36:01.28,0:36:04.28,Default,,0,0,0,,Жас келіншек те шабыттанған сияқты.
Dialogue: 0,0:36:04.38,0:36:05.72,Default,,0,0,0,,Жоқ
Dialogue: 0,0:36:07.78,0:36:08.62,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:36:08.72,0:36:09.45,Default,,0,0,0,,Ағай!
Dialogue: 0,0:36:09.62,0:36:10.29,Default,,0,0,0,,Уа!
Dialogue: 0,0:36:10.42,0:36:11.22,Default,,0,0,0,,О, ау!
Dialogue: 0,0:36:12.29,0:36:13.89,Default,,0,0,0,,Такси осында.
Dialogue: 0,0:36:13.96,0:36:15.26,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:36:15.79,0:36:16.76,Default,,0,0,0,,Әй?
Dialogue: 0,0:36:17.06,0:36:18.63,Default,,0,0,0,,О... мм?
Dialogue: 0,0:36:18.73,0:36:19.81,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:36:19.85,0:36:20.37,Default,,0,0,0,,Га
Dialogue: 0,0:36:20.40,0:36:21.00,Default,,0,0,0,,Окко
Dialogue: 0,0:36:21.04,0:36:21.66,Default,,0,0,0,,Уа!
Dialogue: 0,0:36:21.73,0:36:22.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:22.90,0:36:25.13,Default,,0,0,0,,Ахахаха!
Dialogue: 0,0:36:25.23,0:36:26.40,Default,,0,0,0,,Бұл бетке не болды?
Dialogue: 0,0:36:26.47,0:36:27.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:27.44,0:36:28.97,Default,,0,0,0,,А, мен таң қалдым.
Dialogue: 0,0:36:29.07,0:36:29.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:29.97,0:36:32.24,Default,,0,0,0,,Сіз шынымен басқасыз.
Dialogue: 0,0:36:32.98,0:36:35.11,Default,,0,0,0,,Бұлай көрінгенім үшін кешіріңіз
Dialogue: 0,0:36:35.21,0:36:36.41,Default,,0,0,0,,Жоқ
Dialogue: 0,0:36:36.48,0:36:39.82,Default,,0,0,0,,Кешегі ашық аспан астындағы монша пудингі мен анаммен бірге тамақтандым.
Dialogue: 0,0:36:40.82,0:36:42.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:43.29,0:36:45.49,Default,,0,0,0,,Өте дәмді болды.
Dialogue: 0,0:36:48.66,0:36:50.96,Default,,0,0,0,,Рахмет, жас ханым
Dialogue: 0,0:36:57.00,0:36:58.97,Default,,0,0,0,,А... хахахаха!
Dialogue: 0,0:36:59.07,0:37:00.30,Default,,0,0,0,,Хехехе
Dialogue: 0,0:37:00.40,0:37:02.64,Default,,0,0,0,,- Хахахаха! -Хахаха
Dialogue: 0,0:37:02.94,0:37:04.51,Default,,0,0,0,,Жас әйел!
Dialogue: 0,0:37:05.78,0:37:07.78,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:37:09.98,0:37:12.01,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:37:17.69,0:37:18.59,Default,,0,0,0,,Окко
Dialogue: 0,0:37:18.69,0:37:22.76,Default,,0,0,0,,Шынтағың былай тұрсын, үстіңгі қолыңмен сермеу.
Dialogue: 0,0:37:22.86,0:37:23.69,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:37:23.83,0:37:26.00,Default,,0,0,0,,Бетіңізді жуып болған соң, маған тапсырма беріңізші.
Dialogue: 0,0:37:26.10,0:37:26.96,Default,,0,0,0,,Ха...
Dialogue: 0,0:37:27.53,0:37:29.70,Default,,0,0,0,,Уф... жоқ!
Dialogue: 0,0:37:30.83,0:37:32.37,Default,,0,0,0,,Мына сақал
Dialogue: 0,0:37:32.50,0:37:35.20,Default,,0,0,0,,Бұл Юрейдің мектептегі жұмысы емес пе?
Dialogue: 0,0:37:35.37,0:37:36.54,Default,,0,0,0,,Хмм?
Dialogue: 0,0:37:36.64,0:37:37.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:37.87,0:37:38.67,Default,,0,0,0,,Бірақ келіңіз!
Dialogue: 0,0:37:39.11,0:37:40.21,Default,,0,0,0,,Енді?
Dialogue: 0,0:37:40.51,0:37:42.71,Default,,0,0,0,,Мені осылай бақытты еткеніңе сене алар емеспін.
Dialogue: 0,0:37:42.88,0:37:45.05,Default,,0,0,0,,Қонақ үйде жұмыс істеу керемет!
Dialogue: 0,0:37:45.21,0:37:46.45,Default,,0,0,0,,Уау.
Dialogue: 0,0:37:48.05,0:37:51.39,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Харунояның жас ханымымын.
Dialogue: 0,0:37:51.49,0:37:53.56,Default,,0,0,0,,Мен әйеліме тапсырмамен келдім.
Dialogue: 0,0:37:53.72,0:37:54.39,Default,,0,0,0,,Ал...
Dialogue: 0,0:37:58.36,0:37:59.90,Default,,0,0,0,,Жарайсың! Окко
Dialogue: 0,0:38:00.03,0:38:00.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:00.86,0:38:02.53,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:38:03.87,0:38:05.17,Default,,0,0,0,,Уау
Dialogue: 0,0:38:11.54,0:38:12.88,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:38:12.98,0:38:15.24,Default,,0,0,0,,Мен оны Ақанэ-санға көрсеткім келді.
Dialogue: 0,0:38:15.34,0:38:16.78,Default,,0,0,0,,Сіз оны көрдім деп ойлайсыз ба?
Dialogue: 0,0:38:16.82,0:38:17.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:17.58,0:38:20.99,Default,,0,0,0,,Минеко-чан, мен таксиден осы жерге келуді өтіндім.
Dialogue: 0,0:38:21.04,0:38:21.72,Default,,0,0,0,,Уау...
Dialogue: 0,0:38:21.82,0:38:23.59,Default,,0,0,0,,Әже күткендей
Dialogue: 0,0:38:25.39,0:38:27.86,Default,,0,0,0,,«Әдет – барлық нәрсенің патшасы»
Dialogue: 0,0:38:27.92,0:38:29.59,Default,,0,0,0,,Геродот бойынша
Dialogue: 0,0:38:29.73,0:38:32.43,Default,,0,0,0,,Дұрыс жауап: таяқшалар кішкентай тұқы ағындары.
Dialogue: 0,0:38:32.60,0:38:34.93,Default,,0,0,0,,Бұл жақсы тереңдік береді.
Dialogue: 0,0:38:35.10,0:38:36.03,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:38:36.10,0:38:37.93,Default,,0,0,0,,Бұл Мацуки-сан ба?
Dialogue: 0,0:38:38.10,0:38:38.94,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:38:39.07,0:38:41.10,Default,,0,0,0,,Тіпті жұмыс киімдері де қуырылған
Dialogue: 0,0:38:41.24,0:38:43.41,Default,,0,0,0,,Сазан ағындарымен араласқыңыз келе ме?
Dialogue: 0,0:38:43.51,0:38:45.78,Default,,0,0,0,,А... жоқ, ашулансаң
Dialogue: 0,0:38:45.88,0:38:46.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:46.78,0:38:47.71,Default,,0,0,0,,Окко
Dialogue: 0,0:38:47.78,0:38:48.61,Default,,0,0,0,,Әлгі жігіт!
Dialogue: 0,0:38:49.55,0:38:50.95,Default,,0,0,0,,Уфуфуфу
Dialogue: 0,0:38:51.18,0:38:52.05,Default,,0,0,0,,Хмм… неге осы мысықты бақытты етуге тек мен ғана тиіс?
Dialogue: 0,0:38:52.12,0:38:52.78,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:38:52.95,0:38:54.95,Default,,0,0,0,,Сіз тым бұзықсыз!
Dialogue: 0,0:38:55.12,0:38:55.92,Default,,0,0,0,,Хехехе
Dialogue: 0,0:38:56.02,0:38:57.42,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:38:59.06,0:38:59.96,Default,,0,0,0,,Секи мырза!
Dialogue: 0,0:39:00.12,0:39:01.46,Default,,0,0,0,,Сіз не істеп жатырсыз!?
Dialogue: 0,0:39:02.23,0:39:04.29,Default,,0,0,0,,Ах, жоқ, яғни…
Dialogue: 0,0:39:04.43,0:39:05.46,Default,,0,0,0,,Ахаха
Dialogue: 0,0:39:05.56,0:39:06.46,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:39:06.60,0:39:08.13,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:39:08.30,0:39:08.97,Default,,0,0,0,,Не? Ит пе?
Dialogue: 0,0:39:13.04,0:39:13.90,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:39:18.44,0:39:19.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:19.54,0:39:21.48,Default,,0,0,0,,Сіз, сәл ғана...
Dialogue: 0,0:39:21.98,0:39:22.81,Default,,0,0,0,,Не!?
Dialogue: 0,0:39:26.12,0:39:27.15,Default,,0,0,0,,Ханым, бар!
Dialogue: 0,0:39:27.28,0:39:28.99,Default,,0,0,0,,Біреуді ұрсаң, бәлеге қаласың!
Dialogue: 0,0:39:31.25,0:39:33.26,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:39:33.66,0:39:34.99,Default,,0,0,0,,Хехехе
Dialogue: 0,0:39:35.32,0:39:36.16,Default,,0,0,0,,Не?
Dialogue: 0,0:39:38.63,0:39:40.16,Default,,0,0,0,,Ой, не?!
Dialogue: 0,0:39:42.30,0:39:44.67,Default,,0,0,0,,Ол қайда кетті?
Dialogue: 0,0:39:45.23,0:39:47.10,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:39:47.17,0:39:48.00,Default,,0,0,0,,Уфуфуфу
Dialogue: 0,0:39:48.14,0:39:49.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:49.57,0:39:50.77,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:39:50.84,0:39:52.64,Default,,0,0,0,,Сәлем! Күте тұрыңыз
Dialogue: 0,0:39:52.74,0:39:55.01,Default,,0,0,0,,Бұл бала керемет
Dialogue: 0,0:39:58.15,0:40:00.85,Default,,0,0,0,,Ол осы жерге дейін ұшып келді де, жоғалып кетті.
Dialogue: 0,0:40:00.98,0:40:02.43,Default,,0,0,0,,Неліктен үйде?
Dialogue: 0,0:40:03.95,0:40:05.80,Default,,0,0,0,,-Жас әйел, қош келдің -Уау!
Dialogue: 0,0:40:06.49,0:40:07.69,Default,,0,0,0,,Ясуши-сан қазір
Dialogue: 0,0:40:07.79,0:40:08.99,Default,,0,0,0,,және оны осы кезеңде бізге қалдыру қисынсыз болар еді, иә?
Dialogue: 0,0:40:09.09,0:40:12.33,Default,,0,0,0,,Чамаруя мейірімді әйел болса керек.
Dialogue: 0,0:40:12.93,0:40:14.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:14.53,0:40:16.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:16.13,0:40:17.47,Default,,0,0,0,,-Ұмытып қалдым! -Ұмытып қалдым!
Dialogue: 0,0:40:17.97,0:40:19.80,Default,,0,0,0,,Мен қазір кетемін!
Dialogue: 0,0:40:19.87,0:40:20.64,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:40:20.70,0:40:21.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:22.00,0:40:23.64,Default,,0,0,0,,Бүгінгі күнге жетеді.
Dialogue: 0,0:40:23.71,0:40:24.71,Default,,0,0,0,,Себебі мен бос емеспін.
Dialogue: 0,0:40:25.11,0:40:26.04,Default,,0,0,0,,Ясуши мырза
Dialogue: 0,0:40:26.18,0:40:28.71,Default,,0,0,0,,Акиёши Рёкандағы қызметкерлерді оңай көруге болады.
Dialogue: 0,0:40:28.85,0:40:31.21,Default,,0,0,0,,Оны маған қалдырып, жұмысқа қайта кіріс.
Dialogue: 0,0:40:31.31,0:40:32.72,Default,,0,0,0,,Иә, ханым.
Dialogue: 0,0:40:32.88,0:40:34.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:40:35.22,0:40:36.05,Default,,0,0,0,,Хехехе
Dialogue: 0,0:40:36.15,0:40:36.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:38.32,0:40:40.22,Default,,0,0,0,,Сіз шынымен ебедейсіз.
Dialogue: 0,0:40:40.32,0:40:42.06,Default,,0,0,0,,Тончинканда сен ақымақсың.
Dialogue: 0,0:40:42.23,0:40:43.73,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:40:43.86,0:40:46.00,Default,,0,0,0,,Сенің ебедейсіз екенің рас.
Dialogue: 0,0:40:46.04,0:40:49.01,Default,,0,0,0,,Тончинканның кейбір ақымақ жерлері бар.
Dialogue: 0,0:40:49.10,0:40:50.20,Default,,0,0,0,,Урибо Бұл қорқынышты!
Dialogue: 0,0:40:50.30,0:40:53.24,Default,,0,0,0,,Жас әйел емес
Dialogue: 0,0:40:53.37,0:40:55.20,Default,,0,0,0,,Сен ақымақ әйел емессің бе?
Dialogue: 0,0:40:55.30,0:40:56.07,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:40:56.21,0:40:57.71,Default,,0,0,0,,Ақымақ әйел?
Dialogue: 0,0:40:57.81,0:40:59.41,Default,,0,0,0,,Поо... Гухахахаха!
Dialogue: 0,0:40:59.58,0:41:00.74,Default,,0,0,0,,-мм -мм…
Dialogue: 0,0:41:00.91,0:41:02.85,Default,,0,0,0,,Мацукиден мүлде басқаша.
Dialogue: 0,0:41:02.91,0:41:03.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:04.08,0:41:05.42,Default,,0,0,0,,Мацуки мырза?
Dialogue: 0,0:41:05.52,0:41:07.08,Default,,0,0,0,,Сіз өзіңізді түйреуіш етіп көрсетіп жүрген адамды білесіз бе?
Dialogue: 0,0:41:08.25,0:41:10.59,Default,,0,0,0,,Әпкемді жасанды деме!
Dialogue: 0,0:41:10.72,0:41:11.31,Default,,0,0,0,,Әй?
Dialogue: 0,0:41:11.36,0:41:12.09,Default,,0,0,0,,Наги…
Dialogue: 0,0:41:19.03,0:41:21.56,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:41:21.66,0:41:23.77,Default,,0,0,0,,Біреу жарақат алды ма?
Dialogue: 0,0:41:23.90,0:41:24.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:24.83,0:41:26.20,Default,,0,0,0,,Жақсы сияқты.
Dialogue: 0,0:41:26.50,0:41:27.54,Default,,0,0,0,,Жақсы
Dialogue: 0,0:41:27.60,0:41:29.27,Default,,0,0,0,,Жас келіншектің де жеңілдеп қалатынына сенімдімін.
Dialogue: 0,0:41:29.41,0:41:30.61,Default,,0,0,0,,О
Dialogue: 0,0:41:32.54,0:41:33.94,Default,,0,0,0,,Еңбек тәжірибесі бағдарламасына оралды
Dialogue: 0,0:41:37.35,0:41:39.62,Default,,0,0,0,,Сіз Пинфуридің әпкесісіз.
Dialogue: 0,0:41:39.78,0:41:40.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:41:40.75,0:41:43.55,Default,,0,0,0,,Менің әпкем Мацуки! Мен сол қыздың әпкесімін.
Dialogue: 0,0:41:44.19,0:41:46.12,Default,,0,0,0,,Ол мен 7 жасымда қайтыс болды.
Dialogue: 0,0:41:46.22,0:41:48.62,Default,,0,0,0,,Мацуки үлкейіп кетті.
Dialogue: 0,0:41:48.79,0:41:51.29,Default,,0,0,0,,Олай болса, Мацуки-санның әпкесі.
Dialogue: 0,0:41:51.43,0:41:52.30,Default,,0,0,0,,Миё!
Dialogue: 0,0:41:52.46,0:41:53.13,Default,,0,0,0,,Ах
Dialogue: 0,0:41:56.27,0:41:58.80,Default,,0,0,0,,Маған бұл жер ұнайды.
Dialogue: 0,0:41:59.64,0:42:00.47,Default,,0,0,0,,Өйткені
Dialogue: 0,0:42:00.57,0:42:02.74,Default,,0,0,0,,Бұл зерігуді жоюға өте ыңғайлы.
Dialogue: 0,0:42:03.07,0:42:04.64,Default,,0,0,0,,Жалқаулықты жеңу үшін...
Dialogue: 0,0:42:04.81,0:42:06.74,Default,,0,0,0,,Оурейлердің саны қайтадан көбейді?
Dialogue: 0,0:42:06.81,0:42:08.04,Default,,0,0,0,,О.
Dialogue: 0,0:42:08.14,0:42:09.98,Default,,0,0,0,,Мен ғана өскен жоқпын.
Dialogue: 0,0:42:10.08,0:42:10.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:11.15,0:42:12.45,Default,,0,0,0,,Аму… Аму
Dialogue: 0,0:42:12.78,0:42:14.32,Default,,0,0,0,,Аму… Аму
Dialogue: 0,0:42:14.48,0:42:15.32,Default,,0,0,0,,Хмм
Dialogue: 0,0:42:15.45,0:42:16.65,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:42:16.95,0:42:17.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:17.82,0:42:19.82,Default,,0,0,0,,Жас ханым, не болды?
Dialogue: 0,0:42:20.49,0:42:21.46,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:42:21.56,0:42:24.17,Default,,0,0,0,,Мен оның иісі жақсы деп ойладым.
Dialogue: 0,0:42:25.13,0:42:26.66,Default,,0,0,0,,Жас әйел
Dialogue: 0,0:42:26.80,0:42:28.83,Default,,0,0,0,,Тамақ жеу жаман әдет.
Dialogue: 0,0:42:29.17,0:42:30.17,Default,,0,0,0,,А...
Dialogue: 0,0:42:30.30,0:42:31.80,Default,,0,0,0,,Бұл...
Dialogue: 0,0:42:32.34,0:42:33.50,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:42:33.60,0:42:35.00,Default,,0,0,0,,Бүгінгі шайдың дәмі қандай?
Dialogue: 0,0:42:35.17,0:42:36.51,Default,,0,0,0,,- дейін? -Хехе...
Dialogue: 0,0:42:36.61,0:42:37.67,Default,,0,0,0,,Хмм
Dialogue: 0,0:42:40.51,0:42:41.51,Default,,0,0,0,,Иә
Dialogue: 0,0:42:42.95,0:42:44.11,Default,,0,0,0,,Ия
Dialogue: 0,0:42:44.18,0:42:45.68,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:42:45.85,0:42:46.78,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:42:47.52,0:42:49.69,Default,,0,0,0,,Одан да лас емес пе?
Dialogue: 0,0:42:51.42,0:42:52.66,Default,,0,0,0,,Бұл қоңырау?
Dialogue: 0,0:42:52.76,0:42:55.19,Default,,0,0,0,,Иә, менің атым Сузуки.
Dialogue: 0,0:42:55.53,0:42:56.33,Default,,0,0,0,,Сузуки?
Dialogue: 0,0:42:56.43,0:42:57.36,Default,,0,0,0,,Хмм
Dialogue: 0,0:42:57.46,0:42:58.86,Default,,0,0,0,,-Сузуки-кун? -Хмм
Dialogue: 0,0:42:58.96,0:43:00.03,Default,,0,0,0,,Сузуки-кун?
Dialogue: 0,0:43:00.13,0:43:02.63,Default,,0,0,0,,Иә, бұл жындар тобы.
Dialogue: 0,0:43:03.30,0:43:04.53,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:43:04.70,0:43:07.14,Default,,0,0,0,,Менің мөрімді кім бұзды
Dialogue: 0,0:43:07.67,0:43:08.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:10.27,0:43:11.54,Default,,0,0,0,,Хмм.
Dialogue: 0,0:43:12.34,0:43:13.38,Default,,0,0,0,,Жер
Dialogue: 0,0:43:13.51,0:43:15.81,Default,,0,0,0,,Менің пудингімді жеген Сузуки-кун болды ма?
Dialogue: 0,0:43:16.61,0:43:17.71,Default,,0,0,0,,Әй!
Dialogue: 0,0:43:18.01,0:43:19.55,Default,,0,0,0,,(Танжиро) Барлығы жақсы болады. Бұл адам ешкімді өлтірген жоқ.
Dialogue: 0,0:43:20.05,0:43:21.38,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:43:21.88,0:43:23.39,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:43:23.49,0:43:27.06,Default,,0,0,0,,Ашкөз сәби жынды бірінші рет көруім.
Dialogue: 0,0:43:27.46,0:43:30.39,Default,,0,0,0,,Осы жігітті қорапқа қайта салсам жақсы болмай ма?
Dialogue: 0,0:43:30.56,0:43:31.56,Default,,0,0,0,,Иә!?
Dialogue: 0,0:43:31.66,0:43:35.73,Default,,0,0,0,,Мен көптен бері бірінші рет шыға алдым, бірақ көп емес еді.
Dialogue: 0,0:43:35.83,0:43:38.73,Default,,0,0,0,,Сондай-ақ, мұнда барлық тұтынушыларды тартатын нәрсе
Dialogue: 0,0:43:38.84,0:43:40.40,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:43:41.30,0:43:42.17,Default,,0,0,0,,Сіз
Dialogue: 0,0:43:42.24,0:43:45.01,Default,,0,0,0,,Мазасыз тұтынушылар көп, неге оларды шақырмайсыз?
Dialogue: 0,0:43:45.09,0:43:46.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:43:46.48,0:43:48.68,Default,,0,0,0,,Мен құбыжықпын ғой.
Dialogue: 0,0:43:48.75,0:43:51.58,Default,,0,0,0,,Мінезі күшті адамдармен жақсы араласамын.
Dialogue: 0,0:43:52.25,0:43:53.42,Default,,0,0,0,,Өйткені, бұл жігіт
Dialogue: 0,0:43:53.52,0:43:55.42,Default,,0,0,0,,Сіз оны тағы бір рет мөрледіңіз бе?
Dialogue: 0,0:43:55.55,0:43:56.89,Default,,0,0,0,,Сол бел бауы тығыздағыш жіп!
Dialogue: 0,0:43:56.99,0:43:58.76,Default,,0,0,0,,Уау, тентек!
Dialogue: 0,0:43:58.89,0:43:59.72,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:43:59.82,0:44:00.69,Default,,0,0,0,,-А-а?
Dialogue: 0,0:44:00.76,0:44:01.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:02.69,0:44:05.09,Default,,0,0,0,,Сузуки-кун, мен оны осында қоямын.
Dialogue: 0,0:44:05.26,0:44:06.53,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:44:06.76,0:44:09.57,Default,,0,0,0,,Өйткені олардың бәрі қиын адамдар болуы мүмкін.
Dialogue: 0,0:44:09.67,0:44:12.40,Default,,0,0,0,,Ол маған клиенттерді әкелді.
Dialogue: 0,0:44:13.10,0:44:15.71,Default,,0,0,0,,Мен апат әкелмеймін деп айта алмаймын.
Dialogue: 0,0:44:15.77,0:44:18.61,Default,,0,0,0,,Ешбір қиындық тудырмау үшін барымды саламын!
Dialogue: 0,0:44:18.71,0:44:20.08,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:44:20.34,0:44:21.61,Default,,0,0,0,,Иә...
Dialogue: 0,0:44:21.91,0:44:23.45,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:44:24.21,0:44:26.12,Default,,0,0,0,,Қонақ үйдегі жұмысқа көмектесемін.
Dialogue: 0,0:44:26.22,0:44:26.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:27.08,0:44:29.62,Default,,0,0,0,,Мен шын мәнінде жынмын.
Dialogue: 0,0:44:30.02,0:44:32.76,Default,,0,0,0,,Жын-шайтан болсын, бәрібір.
Dialogue: 0,0:44:32.86,0:44:33.62,Default,,0,0,0,,-Ух... -Хехе
Dialogue: 0,0:44:33.79,0:44:35.46,Default,,0,0,0,,Миё-чан, сен де.
Dialogue: 0,0:44:35.63,0:44:36.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:36.59,0:44:37.73,Default,,0,0,0,,О, қой, қоя бер
Dialogue: 0,0:44:37.79,0:44:38.95,Default,,0,0,0,,Ахем
Dialogue: 0,0:44:42.23,0:44:43.57,Default,,0,0,0,,Хмм…
Dialogue: 0,0:44:45.10,0:44:46.57,Default,,0,0,0,,Хмм.
Dialogue: 0,0:44:48.64,0:44:50.14,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:44:53.88,0:44:54.81,Default,,0,0,0,,Миё-чан
Dialogue: 0,0:44:54.98,0:44:57.10,Default,,0,0,0,,Жұмысты аяқтағаннан кейін, өтінемін, артқы жағын жасаңыз.
Dialogue: 0,0:45:02.25,0:45:04.49,Default,,0,0,0,,Иә, иә, ақымақ әйел.
Dialogue: 0,0:45:07.92,0:45:09.66,Default,,0,0,0,,Оккоя күткендей
Dialogue: 0,0:45:09.76,0:45:13.10,Default,,0,0,0,,Юрейді де, құбыжықтарды да нашар пайдаланады.
Dialogue: 0,0:45:13.16,0:45:16.13,Default,,0,0,0,,Урибо мырза зеріккен сияқты.
Dialogue: 0,0:45:17.13,0:45:18.84,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:45:20.57,0:45:22.67,Default,,0,0,0,,Миё көңілді жүрген сияқты
Dialogue: 0,0:45:22.94,0:45:24.84,Default,,0,0,0,,Бұл қиын болған болуы керек.
Dialogue: 0,0:45:24.97,0:45:28.81,Default,,0,0,0,,Мен Акиёши қонақ үйіне бардым, онда менімен ешкім сөйлескісі келмеді.
Dialogue: 0,0:45:29.15,0:45:30.68,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:45:32.42,0:45:34.18,Default,,0,0,0,,Уау! Мұрныңды бля...
Dialogue: 0,0:45:34.62,0:45:36.45,Default,,0,0,0,,Сузуки-кун, мүмкіндігінше мүкке зақым келтірмеуге тырыс.
Dialogue: 0,0:45:36.52,0:45:37.35,Default,,0,0,0,,А...
Dialogue: 0,0:45:37.79,0:45:39.69,Default,,0,0,0,,Егер қураған жапырақтар болса, оларды сақтаңыз.
Dialogue: 0,0:45:40.86,0:45:42.69,Default,,0,0,0,,Ендеше
Dialogue: 0,0:45:42.79,0:45:45.96,Default,,0,0,0,,Егер сіз тоғанның ағынына ілессеңіз, мен бақытты болар едім.
Dialogue: 0,0:45:46.03,0:45:47.46,Default,,0,0,0,,Окко, мұнда біреу бар ма?
Dialogue: 0,0:45:47.53,0:45:48.87,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:45:49.03,0:45:50.33,Default,,0,0,0,,Әже
Dialogue: 0,0:45:50.43,0:45:51.97,Default,,0,0,0,,Жоқ, мен тек өзіммен сөйлесіп тұрмын
Dialogue: 0,0:45:52.37,0:45:53.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:53.37,0:45:57.04,Default,,0,0,0,,Уақытыңыз болған кезде келіп, Суйроу-саманы тексере аласыз ба?
Dialogue: 0,0:45:57.21,0:45:59.21,Default,,0,0,0,,Мен тіпті түскі ас ішкен жоқпын.
Dialogue: 0,0:45:59.71,0:46:03.05,Default,,0,0,0,,Өзіңізді жақсы сезінбесеңіз, дәрігер шақыруға болады.
Dialogue: 0,0:46:03.15,0:46:07.22,Default,,0,0,0,,Егер тәбетіңіз болмаса, біз сізге жеңіл тамақ әзірлей аламыз.
Dialogue: 0,0:46:07.35,0:46:09.32,Default,,0,0,0,,Маған тілектеріңізді білдіріңіз.
Dialogue: 0,0:46:09.39,0:46:10.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:12.46,0:46:14.22,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:46:15.39,0:46:16.73,Default,,0,0,0,,Мизурё-сама
Dialogue: 0,0:46:17.56,0:46:20.06,Default,,0,0,0,,Суирё мырза, сіз демалыс аласыз ба?
Dialogue: 0,0:46:20.20,0:46:23.17,Default,,0,0,0,,Хмм... Иә? Бірдеңе күйіп қалды ма?
Dialogue: 0,0:46:25.37,0:46:26.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:26.24,0:46:26.90,Default,,0,0,0,,Өрт!?
Dialogue: 0,0:46:28.30,0:46:29.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:46:29.41,0:46:31.07,Default,,0,0,0,,Уф... Суйроу-сама!
Dialogue: 0,0:46:32.74,0:46:33.58,Default,,0,0,0,,Лорд Суирё!
Dialogue: 0,0:46:43.19,0:46:44.22,Default,,0,0,0,,А...
Dialogue: 0,0:46:51.26,0:46:52.53,Default,,0,0,0,,Әй!
Dialogue: 0,0:46:54.73,0:46:55.77,Default,,0,0,0,,Уф
Dialogue: 0,0:46:55.87,0:46:56.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:06.94,0:47:07.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:08.88,0:47:11.05,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:47:12.35,0:47:13.95,Default,,0,0,0,,Қызық, саған бірдеңе керек пе?
Dialogue: 0,0:47:14.08,0:47:15.38,Default,,0,0,0,,Қый!
Dialogue: 0,0:47:15.45,0:47:16.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:16.55,0:47:17.29,Default,,0,0,0,,♬~
Dialogue: 0,0:47:21.12,0:47:22.56,Default,,0,0,0,,көріпкел?
Dialogue: 0,0:47:22.63,0:47:26.63,Default,,0,0,0,,Оның үстіне Ұрай сияқты ғылымға жат нәрселерге сенесің бе?
Dialogue: 0,0:47:27.43,0:47:29.63,Default,,0,0,0,,Сенемін дейсің бе?
Dialogue: 0,0:47:29.77,0:47:31.57,Default,,0,0,0,,Менің бір клиентім бар, ол көріпкел...
Dialogue: 0,0:47:31.63,0:47:34.57,Default,,0,0,0,,Қызық, ертеңгі жазғы демалыс сізді қызықтырады ма?
Dialogue: 0,0:47:34.64,0:47:36.64,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:47:36.81,0:47:39.14,Default,,0,0,0,,Мацуки-сан, сен Юрейді көргенсің бе...
Dialogue: 0,0:47:40.31,0:47:41.11,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:47:41.21,0:47:43.48,Default,,0,0,0,,Жас әйел емес, ақымақ па?
Dialogue: 0,0:47:44.48,0:47:46.65,Default,,0,0,0,,Бір жерде айтылған сияқты...
Dialogue: 0,0:47:46.75,0:47:50.82,Default,,0,0,0,,Хана-но-ю Онсен көктемгі жазғы демалыс - нағыз мәміле
Dialogue: 0,0:47:50.95,0:47:53.66,Default,,0,0,0,,Барлығы отбасылық кәсіпке көмектесумен айналысады.
Dialogue: 0,0:47:53.79,0:47:55.16,Default,,0,0,0,,Мен де
Dialogue: 0,0:47:55.26,0:47:56.09,Default,,0,0,0,,-Ммм...
Dialogue: 0,0:47:57.66,0:47:59.50,Default,,0,0,0,,Мәміле қандай?
Dialogue: 0,0:48:00.56,0:48:03.67,Default,,0,0,0,,Исхоку Доген мейрамханасының мәзірі
Dialogue: 0,0:48:05.33,0:48:06.24,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:48:06.34,0:48:08.34,Default,,0,0,0,,Исхоку Догеннің мағынасын білесің бе?
Dialogue: 0,0:48:08.50,0:48:09.64,Default,,0,0,0,,Жоқ
Dialogue: 0,0:48:10.11,0:48:12.14,Default,,0,0,0,,Сонымен мейрамхана сөзі қайдан шыққан?
Dialogue: 0,0:48:12.34,0:48:13.34,Default,,0,0,0,,Жоқ
Dialogue: 0,0:48:13.91,0:48:14.81,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:48:16.18,0:48:19.02,Default,,0,0,0,,Мейрамхана Сөздің шығу тегі латын.
Dialogue: 0,0:48:19.48,0:48:21.28,Default,,0,0,0,,Ағылшын тілін қалпына келтірумен бірдей
Dialogue: 0,0:48:21.35,0:48:24.65,Default,,0,0,0,,Қалпына келтіру немесе жақсы күйге келтіру мағынасы
Dialogue: 0,0:48:25.35,0:48:26.79,Default,,0,0,0,,Дәрі мен тағамның бір көзі
Dialogue: 0,0:48:26.86,0:48:32.53,Default,,0,0,0,,Денсаулықты сақтау үшін медициналық көмек те, тамақ та қажет және шығу тегі бір дегенді білдіреді.
Dialogue: 0,0:48:33.63,0:48:36.53,Default,,0,0,0,,Басқаша айтқанда, дәрі мен тамақ бір көз. Мейрамхана мәзірі дегеніміз не?
Dialogue: 0,0:48:36.87,0:48:38.53,Default,,0,0,0,,Шығыста ма, Батыста ма
Dialogue: 0,0:48:38.70,0:48:42.37,Default,,0,0,0,,Бұл тағам арқылы тұтынушылардың денсаулығын сақтауға көмектесетін мәзір.
Dialogue: 0,0:48:43.61,0:48:45.84,Default,,0,0,0,,Мен қазір оны қарап жатырмын.
Dialogue: 0,0:48:45.94,0:48:47.38,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:48:48.78,0:48:51.71,Default,,0,0,0,,«Менің жүрегімді тыңдама, оны үйрет»\NТолстойдың
Dialogue: 0,0:48:51.88,0:48:53.05,Default,,0,0,0,,ｂｙ
Dialogue: 0,0:48:54.85,0:48:55.99,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:48:57.99,0:49:00.49,Default,,0,0,0,,Оған тиме... Не!
Dialogue: 0,0:49:01.56,0:49:03.83,Default,,0,0,0,,Мен түйреуішпен жарыса алмаймын
Dialogue: 0,0:49:04.29,0:49:06.40,Default,,0,0,0,,Мацуки мырза дарынды адамдар отбасынан шыққан.
Dialogue: 0,0:49:06.56,0:49:09.67,Default,,0,0,0,,Оның үстіне өзі де еңбекқор.
Dialogue: 0,0:49:10.23,0:49:14.40,Default,,0,0,0,,Бұл ыстық бұлақ қаласының жетістігі де Акиёши Рёканның арқасында.
Dialogue: 0,0:49:14.54,0:49:15.74,Default,,0,0,0,,деді әкем
Dialogue: 0,0:49:15.84,0:49:16.74,Default,,0,0,0,,Иә
Dialogue: 0,0:49:21.31,0:49:22.75,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:49:22.88,0:49:23.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:24.08,0:49:25.58,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:49:26.42,0:49:28.75,Default,,0,0,0,,Коньяныкі одан бір саты жоғары.
Dialogue: 0,0:49:28.92,0:49:30.02,Default,,0,0,0,,Бамбуктың жақсы иісі
Dialogue: 0,0:49:30.09,0:49:30.85,Default,,0,0,0,,Иә
Dialogue: 0,0:49:30.92,0:49:32.42,Default,,0,0,0,,Йорико-чан бұл түрі
Dialogue: 0,0:49:32.89,0:49:34.82,Default,,0,0,0,,Ертең және жазғы демалыста
Dialogue: 0,0:49:34.92,0:49:36.43,Default,,0,0,0,,Мен әрқашан осылай боламын ба?
Dialogue: 0,0:49:36.99,0:49:38.19,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:49:40.76,0:49:41.43,Default,,0,0,0,,Жарайды
Dialogue: 0,0:49:41.60,0:49:43.17,Default,,0,0,0,,Мен де бар күшімді саламын
Dialogue: 0,0:49:43.27,0:49:45.10,Default,,0,0,0,,Ол Минеко-чанға ұқсай бастады.
Dialogue: 0,0:49:45.23,0:49:46.67,Default,,0,0,0,,Ха... сен киім ауыстырып жатырсың!
Dialogue: 0,0:49:46.77,0:49:47.50,Default,,0,0,0,,Кірме
Dialogue: 0,0:49:47.60,0:49:48.77,Default,,0,0,0,,Бітті.
Dialogue: 0,0:49:48.87,0:49:50.27,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:49:50.44,0:49:52.54,Default,,0,0,0,,А, мен Йорико-чаннан алған тағамдар.
Dialogue: 0,0:49:52.61,0:49:53.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:49:53.51,0:49:54.58,Default,,0,0,0,,Окко
Dialogue: 0,0:49:54.68,0:49:57.07,Default,,0,0,0,,-Сіздің бағаларыңыз PE-ден басқа қорқынышты. -Ах!
Dialogue: 0,0:49:57.12,0:49:58.28,Default,,0,0,0,,Оған қарамаңыз
Dialogue: 0,0:49:58.38,0:50:00.72,Default,,0,0,0,,Әркім өз ісімен айналысады
Dialogue: 0,0:50:00.78,0:50:01.89,Default,,0,0,0,,Хмм… неге осы мысықты бақытты етуге тек мен ғана тиіс?
Dialogue: 0,0:50:02.52,0:50:05.46,Default,,0,0,0,,Мен Окконың тағдырына алаңдаймын.
Dialogue: 0,0:50:05.96,0:50:07.79,Default,,0,0,0,,Мектептегі баға өмірде жалғыз нәрсе емес
Dialogue: 0,0:50:07.96,0:50:08.76,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:50:08.86,0:50:10.63,Default,,0,0,0,,Біз де орындаймыз
Dialogue: 0,0:50:10.76,0:50:11.89,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:50:16.30,0:50:18.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:50:19.64,0:50:20.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:22.71,0:50:24.64,Default,,0,0,0,,Осы жерге әкеліңізші.
Dialogue: 0,0:50:26.31,0:50:27.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:50:30.31,0:50:32.48,Default,,0,0,0,,Зәйтүн және газпачо желе
Dialogue: 0,0:50:32.65,0:50:35.65,Default,,0,0,0,,Мен тек зәйтүнге тапсырыс бердім.
Dialogue: 0,0:50:36.15,0:50:38.96,Default,,0,0,0,,Суирё-саманың тұтылуы онша жақсы дамып жатқан жоқ сияқты.
Dialogue: 0,0:50:39.06,0:50:41.49,Default,,0,0,0,,Шампанмен жақсы үйлессе, ауызға салуға болады.
Dialogue: 0,0:50:41.59,0:50:42.99,Default,,0,0,0,,Мен әкелдім.
Dialogue: 0,0:50:43.49,0:50:45.83,Default,,0,0,0,,Қаласаңыз, ләззат алыңыз.
Dialogue: 0,0:50:46.33,0:50:47.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:50:47.66,0:50:49.50,Default,,0,0,0,,Сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:50:49.67,0:50:51.30,Default,,0,0,0,,Жоқ, бұл шектен шыққан.
Dialogue: 0,0:50:56.67,0:50:57.84,Default,,0,0,0,,Ум...
Dialogue: 0,0:50:58.01,0:51:00.01,Default,,0,0,0,,Юката кигіңіз келе ме?
Dialogue: 0,0:51:00.51,0:51:02.18,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:51:02.35,0:51:05.85,Default,,0,0,0,,Мен шетелде көп болдым және оны ешқашан киіп көрмеппін.
Dialogue: 0,0:51:06.52,0:51:07.85,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:51:07.95,0:51:08.95,Default,,0,0,0,,Сен мені киіндіре аласың ба?
Dialogue: 0,0:51:09.29,0:51:10.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:10.25,0:51:11.45,Default,,0,0,0,,Қуаныштымын!
Dialogue: 0,0:51:14.66,0:51:15.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:51:15.96,0:51:17.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:17.79,0:51:19.03,Default,,0,0,0,,Мизурё-сама
Dialogue: 0,0:51:19.20,0:51:20.66,Default,,0,0,0,,Бел жұқа
Dialogue: 0,0:51:24.00,0:51:26.34,Default,,0,0,0,,Мен аздап арықтадым деп ойлаймын.
Dialogue: 0,0:51:27.94,0:51:31.04,Default,,0,0,0,,Тамақ ішіп, салмақ қоссаңыз жақсы болар еді.
Dialogue: 0,0:51:32.51,0:51:33.71,Default,,0,0,0,,Сізге бұл қалай ұнайды?
Dialogue: 0,0:51:34.71,0:51:35.55,Default,,0,0,0,,Иә
Dialogue: 0,0:51:35.71,0:51:37.21,Default,,0,0,0,,Бұл осылай болады
Dialogue: 0,0:51:37.88,0:51:39.72,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:51:39.85,0:51:41.05,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:51:42.22,0:51:43.89,Default,,0,0,0,,Хехехе
Dialogue: 0,0:51:44.05,0:51:47.52,Default,,0,0,0,,Жазғы көктем дүкені Юката коллекциясы
Dialogue: 0,0:51:48.22,0:51:49.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:49.53,0:51:51.33,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:51:51.69,0:51:53.00,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:51:53.06,0:51:55.23,Default,,0,0,0,,Харунояның жыл бойы жинағы
Dialogue: 0,0:51:55.36,0:51:57.87,Default,,0,0,0,,Бұл барабан түйіні!
Dialogue: 0,0:51:58.13,0:51:59.20,Default,,0,0,0,,Уфуфуфу
Dialogue: 0,0:52:00.40,0:52:01.57,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:52:02.47,0:52:04.24,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:52:05.98,0:52:06.74,Default,,0,0,0,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:52:06.91,0:52:07.84,Default,,0,0,0,,Ясу-сан!
Dialogue: 0,0:52:07.91,0:52:09.75,Default,,0,0,0,,Суирё-сама оның өте дәмді екенін айтты.
Dialogue: 0,0:52:10.08,0:52:11.21,Default,,0,0,0,,Жақсы
Dialogue: 0,0:52:11.31,0:52:12.75,Default,,0,0,0,,Менің тәбетім ашылды.
Dialogue: 0,0:52:13.08,0:52:14.58,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:52:15.92,0:52:18.72,Default,,0,0,0,,Салқын сусын беріңізші.
Dialogue: 0,0:52:33.44,0:52:34.90,Default,,0,0,0,,Мизурё-сама
Dialogue: 0,0:52:37.34,0:52:39.24,Default,,0,0,0,,Суирё мырза, сіз осындасыз ба?
Dialogue: 0,0:52:39.61,0:52:41.91,Default,,0,0,0,,Сіз қазірдің өзінде тұрдыңыз ба?
Dialogue: 0,0:52:43.25,0:52:44.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:47.45,0:52:48.42,Default,,0,0,0,,Пуха
Dialogue: 0,0:52:48.52,0:52:49.29,Default,,0,0,0,,Уау
Dialogue: 0,0:52:49.45,0:52:50.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:50.19,0:52:51.79,Default,,0,0,0,,Күрсін... Күрсін
Dialogue: 0,0:52:51.92,0:52:52.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:52:53.12,0:52:54.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:52:54.52,0:52:55.96,Default,,0,0,0,,Мен сізді таң қалдырдым ба?
Dialogue: 0,0:52:56.29,0:52:57.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:57.36,0:52:58.63,Default,,0,0,0,,Хехехе
Dialogue: 0,0:52:58.80,0:53:01.56,Default,,0,0,0,,Мен де жалғыз кіргенде жақсы оқимын.
Dialogue: 0,0:53:02.23,0:53:04.30,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:53:04.43,0:53:05.64,Default,,0,0,0,,Жақсы
Dialogue: 0,0:53:06.30,0:53:07.30,Default,,0,0,0,,Сол інжірлер...
Dialogue: 0,0:53:07.40,0:53:08.81,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:53:10.47,0:53:12.21,Default,,0,0,0,,Мен енді шөлдедім.
Dialogue: 0,0:53:12.31,0:53:13.64,Default,,0,0,0,,Әй, сабан ше?
Dialogue: 0,0:53:13.78,0:53:15.11,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:53:16.15,0:53:17.15,Default,,0,0,0,,Жабайы
Dialogue: 0,0:53:22.42,0:53:24.75,Default,,0,0,0,,Мен сізге бірден ауыстырамын.
Dialogue: 0,0:53:24.82,0:53:26.66,Default,,0,0,0,,Жоқ рахмет
Dialogue: 0,0:53:26.82,0:53:28.46,Default,,0,0,0,,Бұл ең жақсы сусын болды.
Dialogue: 0,0:53:28.56,0:53:29.83,Default,,0,0,0,,Ой... Кешіріңіз.
Dialogue: 0,0:53:30.79,0:53:34.66,Default,,0,0,0,,Осындай жерде сен сияқты еңбекқор адам барына сене алар емеспін.
Dialogue: 0,0:53:34.80,0:53:37.30,Default,,0,0,0,,Әжеңнің, ата-анаңның білімді болғаны жақсы.
Dialogue: 0,0:53:37.67,0:53:38.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:38.97,0:53:39.84,Default,,0,0,0,,Жоқ
Dialogue: 0,0:53:40.44,0:53:42.84,Default,,0,0,0,,Әжең өте қатал.
Dialogue: 0,0:53:43.01,0:53:44.67,Default,,0,0,0,,Маған көп ұрысады.
Dialogue: 0,0:53:44.77,0:53:46.11,Default,,0,0,0,,Бірақ мен сізді құрметтеймін.
Dialogue: 0,0:53:46.51,0:53:47.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:53:48.18,0:53:50.01,Default,,0,0,0,,Ата-анаң туралы...
Dialogue: 0,0:53:51.68,0:53:52.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:53.32,0:53:55.35,Default,,0,0,0,,Әкесі де, анасы да
Dialogue: 0,0:53:55.85,0:53:58.12,Default,,0,0,0,,Менің әжем де осыны жиі айтады.
Dialogue: 0,0:53:58.19,0:54:00.99,Default,,0,0,0,,Хананою Онсендегі ыстық судан ешкім бас тартпайды.
Dialogue: 0,0:54:01.46,0:54:05.03,Default,,0,0,0,,Ол бәрін қабылдайды және сізді емдейді.
Dialogue: 0,0:54:06.36,0:54:07.20,Default,,0,0,0,,Хмм
Dialogue: 0,0:54:08.63,0:54:09.87,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:54:10.00,0:54:12.50,Default,,0,0,0,,Жас әйелдің ермегі қандай?
Dialogue: 0,0:54:12.60,0:54:13.67,Default,,0,0,0,,Менікі?
Dialogue: 0,0:54:14.37,0:54:16.47,Default,,0,0,0,,Достармен сөйлесу және т.б.
Dialogue: 0,0:54:16.54,0:54:18.54,Default,,0,0,0,,Неге киініп, кездесуге бармайсың?
Dialogue: 0,0:54:18.84,0:54:20.04,Default,,0,0,0,,Күн!?
Dialogue: 0,0:54:20.94,0:54:21.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:54:22.28,0:54:24.21,Default,,0,0,0,,Менің жігітім жоқ.
Dialogue: 0,0:54:24.38,0:54:26.52,Default,,0,0,0,,Мен мұның сәнді екенін түсінбеймін...
Dialogue: 0,0:54:27.28,0:54:28.15,Default,,0,0,0,,Хмм
Dialogue: 0,0:54:28.72,0:54:29.89,Default,,0,0,0,,Жас әйел
Dialogue: 0,0:54:30.05,0:54:32.52,Default,,0,0,0,,Ертең менімен араласуға қарсысың ба?
Dialogue: 0,0:54:32.62,0:54:33.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:33.72,0:54:34.89,Default,,0,0,0,,Сіз араласқыңыз келе ме?
Dialogue: 0,0:54:36.06,0:54:38.56,Default,,0,0,0,,Шопинг - ең жақсы уақыт!
Dialogue: 0,0:54:38.69,0:54:41.16,Default,,0,0,0,,Менімен бірге болғандарыңызға рахмет.
Dialogue: 0,0:54:41.23,0:54:42.30,Default,,0,0,0,,Жоқ
Dialogue: 0,0:54:42.40,0:54:45.40,Default,,0,0,0,,Осы жерде екі саты жоғары орналасқан сауда орталығында.
Dialogue: 0,0:54:45.54,0:54:47.40,Default,,0,0,0,,Мен де сонда барғым келді.
Dialogue: 0,0:54:50.41,0:54:53.04,Default,,0,0,0,,Бұл бау сүйкімді.
Dialogue: 0,0:54:53.58,0:54:56.53,Default,,0,0,0,,Бірақ үнемі қоршаумен жүру азапты болатын сияқты.
Dialogue: 0,0:54:56.69,0:54:57.53,Default,,0,0,0,,Ах
Dialogue: 0,0:54:58.31,0:55:00.05,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:55:02.59,0:55:04.52,Default,,0,0,0,,Сувенир беріңізші
Dialogue: 0,0:55:04.59,0:55:05.89,Default,,0,0,0,,Кішкене зәр
Dialogue: 0,0:55:05.99,0:55:08.26,Default,,0,0,0,,Сіз осылай киініп шығуды жоспарлап отырсыз ба?
Dialogue: 0,0:55:08.39,0:55:10.23,Default,,0,0,0,,Мен ұялып тұрмын
Dialogue: 0,0:55:10.33,0:55:12.90,Default,,0,0,0,,Біздің мұнда болмағанымыз дұрыс па? Окко
Dialogue: 0,0:55:15.36,0:55:16.40,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:55:16.87,0:55:18.07,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:55:18.37,0:55:21.87,Default,,0,0,0,,Ал, басқа киімдер де осыған ұқсас.
Dialogue: 0,0:55:22.24,0:55:24.04,Default,,0,0,0,,Мен тәттілерді жақсы көремін
Dialogue: 0,0:55:24.61,0:55:26.08,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:55:28.54,0:55:31.11,Default,,0,0,0,,Бұл қымбатты досым.
Dialogue: 0,0:55:36.62,0:55:39.12,Default,,0,0,0,,Әйелім мені «Окко» деп атады.
Dialogue: 0,0:55:39.26,0:55:42.13,Default,,0,0,0,,Мен де сені Окко-чан деп атай аламын ба?
Dialogue: 0,0:55:47.13,0:55:48.93,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:55:49.03,0:55:50.07,Default,,0,0,0,,Ағай?
Dialogue: 0,0:55:50.13,0:55:51.70,Default,,0,0,0,,♬~
Dialogue: 0,0:55:51.80,0:55:53.44,Default,,0,0,0,,♬~
Dialogue: 0,0:55:53.54,0:55:54.64,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:55:54.77,0:55:56.27,Default,,0,0,0,,♬~
Dialogue: 0,0:55:56.47,0:55:58.37,Default,,0,0,0,,♬~
Dialogue: 0,0:55:58.47,0:55:59.61,Default,,0,0,0,,Окко
Dialogue: 0,0:56:01.28,0:56:03.05,Default,,0,0,0,,Тамағым құрғап қалды.
Dialogue: 0,0:56:03.15,0:56:05.28,Default,,0,0,0,,Анаңнан шай ал.
Dialogue: 0,0:56:05.38,0:56:06.98,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:56:07.08,0:56:09.39,Default,,0,0,0,,Хехе
Dialogue: 0,0:56:09.49,0:56:11.29,Default,,0,0,0,,Күн ыстық, абай болыңыз
Dialogue: 0,0:56:14.26,0:56:16.06,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:56:16.16,0:56:17.33,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:56:17.46,0:56:19.00,Default,,0,0,0,,♬~
Dialogue: 0,0:56:19.30,0:56:20.46,Default,,0,0,0,,♬~
Dialogue: 0,0:56:20.76,0:56:23.14,Default,,0,0,0,,♬~
Dialogue: 0,0:56:23.22,0:56:26.30,Default,,0,0,0,,-Хааааааааааааа... -Окко-чан, не болды?
Dialogue: 0,0:56:26.40,0:56:28.07,Default,,0,0,0,,-Ха! Күрсін... Күрсін -Жақсысың ба!?
Dialogue: 0,0:56:28.23,0:56:30.01,Default,,0,0,0,,Ха! Күрсін... Күрсін
Dialogue: 0,0:56:30.67,0:56:31.57,Default,,0,0,0,,Ха!
Dialogue: 0,0:56:33.84,0:56:35.11,Default,,0,0,0,,Урибу…
Dialogue: 0,0:56:37.61,0:56:38.85,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:56:38.95,0:56:40.82,Default,,0,0,0,,Не болды, ағай!
Dialogue: 0,0:56:41.52,0:56:43.65,Default,,0,0,0,,Мен ақымақпын ғой.
Dialogue: 0,0:56:43.75,0:56:44.52,Default,,0,0,0,,Ах
Dialogue: 0,0:56:46.46,0:56:48.49,Default,,0,0,0,,Мен мұхитты бірінші рет көріп тұрмын!
Dialogue: 0,0:56:49.19,0:56:51.19,Default,,0,0,0,,Екеуің де сонда болдыңдар.
Dialogue: 0,0:56:51.69,0:56:52.80,Default,,0,0,0,,Көп уақыт өтті.
Dialogue: 0,0:56:52.86,0:56:53.86,Default,,0,0,0,,Иә
Dialogue: 0,0:56:55.70,0:56:56.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:56:56.70,0:56:57.87,Default,,0,0,0,,Ағай!
Dialogue: 0,0:57:00.00,0:57:01.84,Default,,0,0,0,,Көлігіңізде мас күйдесіз бе?
Dialogue: 0,0:57:09.71,0:57:12.72,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:57:13.88,0:57:16.39,Default,,0,0,0,,Мені шақыруға мәжбүрлегенім үшін кешірім сұраймын.
Dialogue: 0,0:57:16.52,0:57:17.55,Default,,0,0,0,,Жоқ
Dialogue: 0,0:57:17.65,0:57:18.72,Default,,0,0,0,,Мұның бәрі мен туралы
Dialogue: 0,0:57:18.86,0:57:23.06,Default,,0,0,0,,Диверсияға су қосқаным үшін кешірім сұраймын.
Dialogue: 0,0:57:24.53,0:57:25.73,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:57:25.86,0:57:27.40,Default,,0,0,0,,Ана мен әке
Dialogue: 0,0:57:27.56,0:57:30.07,Default,,0,0,0,,Мен өзімді тірідей сезінемін, оған көмектесе алмаймын.
Dialogue: 0,0:57:30.63,0:57:32.37,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:57:33.34,0:57:34.74,Default,,0,0,0,,Жоқ
Dialogue: 0,0:57:42.08,0:57:44.51,Default,,0,0,0,,Иә, шай сәл салқындап қалды.
Dialogue: 0,0:57:44.85,0:57:46.22,Default,,0,0,0,,Рахмет
Dialogue: 0,0:57:47.68,0:57:50.25,Default,,0,0,0,,Окко-чан, көктемгі үйге қайтайық.
Dialogue: 0,0:57:52.56,0:57:53.42,Default,,0,0,0,,Окко
Dialogue: 0,0:57:53.52,0:57:54.42,Default,,0,0,0,,Окко
Dialogue: 0,0:57:54.56,0:57:55.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:58.19,0:58:00.23,Default,,0,0,0,,Иә! Қазір бәрі жақсы
Dialogue: 0,0:58:00.76,0:58:01.93,Default,,0,0,0,,Суирю-сама
Dialogue: 0,0:58:02.06,0:58:03.37,Default,,0,0,0,,Дүкенге барайық
Dialogue: 0,0:58:03.90,0:58:04.93,Default,,0,0,0,,Мен аш емеспін. Хүү…
Dialogue: 0,0:58:05.27,0:58:07.60,Default,,0,0,0,,Мен сонда барғым келеді.
Dialogue: 0,0:58:09.94,0:58:10.94,Default,,0,0,0,,Иә
Dialogue: 0,0:58:16.78,0:58:20.33,Default,,0,0,0,,Джинкан секіру
Dialogue: 0,0:58:20.64,0:58:21.75,Default,,0,0,0,,-Ой, секір!
Dialogue: 0,0:58:22.79,0:58:25.14,Default,,0,0,0,,Цинк-банджи
Dialogue: 0,0:58:25.25,0:58:26.46,Default,,0,0,0,,- Иә! -Секір
Dialogue: 0,0:58:26.57,0:58:28.25,Default,,0,0,0,,Секір!
Dialogue: 0,0:58:28.77,0:58:30.86,Default,,0,0,0,,Цинк-банджи
Dialogue: 0,0:58:30.96,0:58:32.30,Default,,0,0,0,,-Уау! -Секір
Dialogue: 0,0:58:32.40,0:58:33.93,Default,,0,0,0,,-Жақсы сезінеді -Секір!
Dialogue: 0,0:58:34.03,0:58:36.07,Default,,0,0,0,,- Кімге бәрібір, мен күнге күйіп жатырмын - Джинканбунги
Dialogue: 0,0:58:36.13,0:58:39.06,Default,,0,0,0,,- Суирё-сама, мен күнге күйіп бара жатырмын - Jump Jump!
Dialogue: 0,0:58:39.14,0:58:40.94,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:58:41.04,0:58:41.97,Default,,0,0,0,,Окко-чан ше?
Dialogue: 0,0:58:42.81,0:58:43.81,Default,,0,0,0,,♬~
Dialogue: 0,0:58:43.91,0:58:45.88,Default,,0,0,0,,Маған да бәрібір!
Dialogue: 0,0:58:45.98,0:58:46.78,Default,,0,0,0,,Ия
Dialogue: 0,0:58:46.88,0:58:47.98,Default,,0,0,0,,Мен де!
Dialogue: 0,0:58:48.05,0:58:49.31,Default,,0,0,0,,Негізі мен де
Dialogue: 0,0:58:49.41,0:58:50.88,Default,,0,0,0,,Ах ха ха!
Dialogue: 0,0:58:51.91,0:58:53.88,Default,,0,0,0,,Мені «Даңқ» деп атаңыз
Dialogue: 0,0:58:53.98,0:58:55.12,Default,,0,0,0,,Даңқ?
Dialogue: 0,0:58:55.22,0:58:56.32,Default,,0,0,0,,Иә
Dialogue: 0,0:58:56.42,0:58:58.46,Default,,0,0,0,,Даңқ Мизурё оның шын аты.
Dialogue: 0,0:58:58.76,0:59:00.82,Default,,0,0,0,,Енді көңілді сатып алайық.
Dialogue: 0,0:59:00.96,0:59:02.43,Default,,0,0,0,,Рекреациялық сатып алу?
Dialogue: 0,0:59:02.49,0:59:03.76,Default,,0,0,0,,Хохохохохо
Dialogue: 0,0:59:03.83,0:59:06.83,Default,,0,0,0,,Ол неден басталады?
Dialogue: 0,0:59:06.93,0:59:09.73,Default,,0,0,0,,Сіз осы жерден шешім қабылдай аласыз.
Dialogue: 0,0:59:09.83,0:59:10.80,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:59:10.80,0:59:13.98,Default,,0,0,0,,Сәнді сатып алу - ең жақсы уақыт!
Dialogue: 0,0:59:14.44,0:59:15.84,Default,,0,0,0,,Сәнге арналған…
Dialogue: 0,0:59:15.94,0:59:19.24,Default,,0,0,0,,Атауы жоқ Мынау, Мынау, Мынау.
Dialogue: 0,0:59:19.34,0:59:21.84,Default,,0,0,0,,Мен өзім өзгермеймін
Dialogue: 0,0:59:22.35,0:59:24.81,Default,,0,0,0,,Мен өзім өзгеремін
Dialogue: 0,0:59:24.91,0:59:26.00,Default,,0,0,0,,-Барлығы сағынып қалды -Осында.
Dialogue: 0,0:59:26.06,0:59:26.74,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:59:28.12,0:59:29.02,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:59:30.02,0:59:30.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:31.52,0:59:32.52,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:59:32.66,0:59:33.86,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:59:33.96,0:59:35.63,Default,,0,0,0,,Бұл да
Dialogue: 0,0:59:35.69,0:59:37.03,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:59:37.47,0:59:39.03,Default,,0,0,0,,Хехехе
Dialogue: 0,0:59:39.13,0:59:40.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:40.53,0:59:43.03,Default,,0,0,0,,Өрлеу мен құлдырау – адамның табиғаты
Dialogue: 0,0:59:43.17,0:59:45.54,Default,,0,0,0,,Алдыңғы және артқы жағы бір-біріне жақын орналасқан
Dialogue: 0,0:59:45.54,0:59:46.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:46.70,0:59:49.00,Default,,0,0,0,,- Керемет Ғажайып Ғажайып - Цинк банги
Dialogue: 0,0:59:49.12,0:59:50.61,Default,,0,0,0,,Секіру секіру!
Dialogue: 0,0:59:50.71,0:59:51.94,Default,,0,0,0,,Болашақ
Dialogue: 0,0:59:57.01,0:59:57.85,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:59:57.95,0:59:58.48,Default,,0,0,0,,Ньяа
Dialogue: 0,0:59:58.55,1:00:00.05,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:00:00.15,1:00:01.35,Default,,0,0,0,,Иә
Dialogue: 0,1:00:01.45,1:00:03.52,Default,,0,0,0,,Екінші турға барайық!
Dialogue: 0,1:00:03.62,1:00:04.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:04.39,1:00:05.89,Default,,0,0,0,,Екінші тур?
Dialogue: 0,1:00:06.06,1:00:07.22,Default,,0,0,0,,Хехехе
Dialogue: 0,1:00:07.39,1:00:09.73,Default,,0,0,0,,Ермегің әлі де бар емес пе?
Dialogue: 0,1:00:12.36,1:00:13.06,Default,,0,0,0,,Ах
Dialogue: 0,1:00:14.70,1:00:15.90,Default,,0,0,0,,Ахахаха
Dialogue: 0,1:00:16.07,1:00:17.00,Default,,0,0,0,,Осы жерден бастаңыз
Dialogue: 0,1:00:17.07,1:00:18.33,Default,,0,0,0,,Уау
Dialogue: 0,1:00:18.40,1:00:19.34,Default,,0,0,0,,Ммм
Dialogue: 0,1:00:19.40,1:00:20.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:20.30,1:00:22.07,Default,,0,0,0,,Ересек адамға ұқсайды
Dialogue: 0,1:00:24.97,1:00:26.74,Default,,0,0,0,,Мен ешқашан мұндай киім киген емеспін.
Dialogue: 0,1:00:26.91,1:00:28.04,Default,,0,0,0,,Иә келесі!
Dialogue: 0,1:00:30.25,1:00:31.05,Default,,0,0,0,,Га
Dialogue: 0,1:00:31.81,1:00:32.55,Default,,0,0,0,,♬~
Dialogue: 0,1:00:32.70,1:00:33.40,Default,,0,0,0,,Хехе
Dialogue: 0,1:00:33.60,1:00:34.26,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:00:34.46,1:00:35.55,Default,,0,0,0,,-Уау -Хехехе
Dialogue: 0,1:00:36.70,1:00:37.32,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:00:38.23,1:00:38.87,Default,,0,0,0,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,1:00:44.26,1:00:45.73,Default,,0,0,0,,Сізге бұл қалай ұнайды?
Dialogue: 0,1:00:45.83,1:00:47.20,Default,,0,0,0,,Барлығы керемет
Dialogue: 0,1:00:47.26,1:00:48.56,Default,,0,0,0,,Олай болса мынаны да бер.
Dialogue: 0,1:00:48.66,1:00:49.77,Default,,0,0,0,,Аяқ киім және барлығы.
Dialogue: 0,1:00:49.90,1:00:51.20,Default,,0,0,0,,Иә, мен ақылдымын.
Dialogue: 0,1:00:51.27,1:00:52.20,Default,,0,0,0,,Біз вампирлермен әлі күресіп біттік пе?!
Dialogue: 0,1:00:52.60,1:00:55.61,Default,,0,0,0,,Даңқ мырза, мені әжем ұрсып жатыр.
Dialogue: 0,1:00:55.77,1:00:57.77,Default,,0,0,0,,Тұтынушыға осындай қымбат зат беру...
Dialogue: 0,1:00:57.91,1:00:58.61,Default,,0,0,0,,...
Dialogue: 0,1:00:58.78,1:01:00.78,Default,,0,0,0,,Тұтынушы ретінде емес.
Dialogue: 0,1:01:00.91,1:01:04.11,Default,,0,0,0,,Оны көп жылдар бойы жүрген досыңыздың сыйлығы деп ойлаңыз.
Dialogue: 0,1:01:06.28,1:01:07.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:17.06,1:01:18.09,Default,,0,0,0,,Ә!?
Dialogue: 0,1:01:18.29,1:01:20.30,Default,,0,0,0,,Даңқ мырза тасталды ма?
Dialogue: 0,1:01:20.70,1:01:22.27,Default,,0,0,0,,Уфуфуфу
Dialogue: 0,1:01:22.37,1:01:24.57,Default,,0,0,0,,Үлкен реакция рахмет
Dialogue: 0,1:01:24.63,1:01:26.60,Default,,0,0,0,,Сізбен сөйлескен кезде мен өзімді еркін сезінемін.
Dialogue: 0,1:01:27.27,1:01:30.61,Default,,0,0,0,,Ойлап қарасам, Глори-сан басында көңілі болмады.
Dialogue: 0,1:01:31.11,1:01:34.31,Default,,0,0,0,,Мені тастап кеткен себебім көріпкел болғанымнан шығар.
Dialogue: 0,1:01:34.44,1:01:35.28,Default,,0,0,0,,А...
Dialogue: 0,1:01:35.48,1:01:37.08,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,1:01:37.15,1:01:39.98,Default,,0,0,0,,Сен көріпкел екенсің деп тастап кету... Бұл дұрыс емес!
Dialogue: 0,1:01:40.25,1:01:42.32,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,1:01:42.75,1:01:44.92,Default,,0,0,0,,Мен өз тағдырыма тым көп сендім.
Dialogue: 0,1:01:46.16,1:01:48.62,Default,,0,0,0,,Мен ажырасқан жігітіммен қандай үйлесімділік бар?
Dialogue: 0,1:01:48.72,1:01:50.99,Default,,0,0,0,,Бұдан жақсырақ болуы мүмкін емес еді
Dialogue: 0,1:01:51.33,1:01:55.67,Default,,0,0,0,,Қарбалас жұмыс барысында түсінбеушіліктер көп болса да, жақсы болатыныма сенімді болдым.
Dialogue: 0,1:01:56.67,1:01:59.64,Default,,0,0,0,,Бірақ маған қош айтысты
Dialogue: 0,1:01:59.97,1:02:02.84,Default,,0,0,0,,Менің ең бақытты күнім де.
Dialogue: 0,1:02:05.91,1:02:06.94,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:11.75,1:02:13.35,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,1:02:13.48,1:02:17.02,Default,,0,0,0,,Даңқ-сан әдемі, мейірімді және салқын.
Dialogue: 0,1:02:17.12,1:02:20.16,Default,,0,0,0,,Даңқ мырзаны ұнататындар көп екеніне сенімдімін.
Dialogue: 0,1:02:20.26,1:02:23.49,Default,,0,0,0,,Болжамға сенбе, келесі жолы жақсы араласамыз...
Dialogue: 0,1:02:23.59,1:02:24.86,Default,,0,0,0,,Уфуфуфу
Dialogue: 0,1:02:25.03,1:02:26.86,Default,,0,0,0,,Ахахха!
Dialogue: 0,1:02:27.03,1:02:28.20,Default,,0,0,0,,Ха~
Dialogue: 0,1:02:29.77,1:02:32.54,Default,,0,0,0,,Жұмысы адамдарды ынталандыру болып табылатын көріпкел
Dialogue: 0,1:02:32.64,1:02:34.54,Default,,0,0,0,,Адамдар мені жігерлендірді
Dialogue: 0,1:02:34.70,1:02:36.81,Default,,0,0,0,,Рахмет, Окко-чан
Dialogue: 0,1:02:38.51,1:02:41.68,Default,,0,0,0,,Егер сіз жақын жерде болсаңыз, тоқтаңыз.
Dialogue: 0,1:02:42.35,1:02:43.38,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:45.28,1:02:48.05,Default,,0,0,0,,Сәулешілік – менің шақыруым
Dialogue: 0,1:02:48.55,1:02:50.89,Default,,0,0,0,,Мен тезірек оралуым керек.
Dialogue: 0,1:02:51.15,1:02:52.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:53.62,1:02:56.06,Default,,0,0,0,,Мен сені дұрыс түсінбедім.
Dialogue: 0,1:02:56.23,1:02:58.69,Default,,0,0,0,,Шынымен хехехе
Dialogue: 0,1:03:06.24,1:03:08.40,Default,,0,0,0,,♬~
Dialogue: 0,1:03:08.67,1:03:09.71,Default,,0,0,0,,Хэхехе
Dialogue: 0,1:03:10.24,1:03:12.58,Default,,0,0,0,,Урибо Миочан сонда ма?
Dialogue: 0,1:03:12.68,1:03:13.38,Default,,0,0,0,,Хмм...
Dialogue: 0,1:03:14.24,1:03:16.08,Default,,0,0,0,,Иә? Сол кітап...
Dialogue: 0,1:03:17.88,1:03:21.42,Default,,0,0,0,,Бұл бізге Ақане-күннің әкесінен жіберілген.
Dialogue: 0,1:03:22.05,1:03:24.42,Default,,0,0,0,,Сонда әже білген бе?
Dialogue: 0,1:03:24.52,1:03:25.59,Default,,0,0,0,,Джан!
Dialogue: 0,1:03:25.72,1:03:28.69,Default,,0,0,0,,Бұл таңқаларлық. Ол тамаша енгізілген.
Dialogue: 0,1:03:29.06,1:03:30.73,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:03:30.83,1:03:33.53,Default,,0,0,0,,Мынаны қарашы, тұтынушылар келе жатыр.
Dialogue: 0,1:03:33.60,1:03:34.60,Default,,0,0,0,,Хехе
Dialogue: 0,1:03:34.70,1:03:37.73,Default,,0,0,0,,Ақанеңнің әкесі жазушы болғанына таң қалдым.
Dialogue: 0,1:03:38.37,1:03:41.57,Default,,0,0,0,,Ол «Секи Орико» орнына «Окко-сан» ретінде ғана көрінеді.
Dialogue: 0,1:03:42.41,1:03:44.27,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:03:44.67,1:03:45.74,Default,,0,0,0,,Олай болса, мырза.
Dialogue: 0,1:03:45.84,1:03:47.78,Default,,0,0,0,,Маусымдық Монблан, өтінемін.
Dialogue: 0,1:03:48.04,1:03:49.71,Default,,0,0,0,,Не, кенеттен?
Dialogue: 0,1:03:49.91,1:03:52.62,Default,,0,0,0,,Себебі мен сол ата-ана мен баланы шақырдым.
Dialogue: 0,1:03:52.75,1:03:53.78,Default,,0,0,0,,Әрине, қандай да бір...
Dialogue: 0,1:03:53.95,1:03:54.75,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:54.85,1:03:56.89,Default,,0,0,0,,Мен жаттығуға кешігіп барамын
Dialogue: 0,1:03:56.95,1:03:57.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:58.79,1:04:00.79,Default,,0,0,0,,Сәлем, жарайсың!
Dialogue: 0,1:04:00.92,1:04:01.76,Default,,0,0,0,,Не?
Dialogue: 0,1:04:01.86,1:04:04.79,Default,,0,0,0,,Сіз бізді көрмейсіз бе? Мүлдем
Dialogue: 0,1:04:04.89,1:04:07.23,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,1:04:07.63,1:04:10.07,Default,,0,0,0,,Уақыт жақындап қалды.
Dialogue: 0,1:04:10.63,1:04:11.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:16.61,1:04:19.14,Default,,0,0,0,,Эй, Сузуки, «сол кезде» деп не айта аласың!
Dialogue: 0,1:04:20.44,1:04:24.15,Default,,0,0,0,,Бұл бала енді екеуіңді де толық сезіне алмайтын кезде.
Dialogue: 0,1:04:24.28,1:04:27.42,Default,,0,0,0,,Уф... мына жігіт тағы ақымақ!
Dialogue: 0,1:04:27.48,1:04:28.48,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (ДжоДжо) Дерби?
Dialogue: 0,1:04:28.58,1:04:32.49,Default,,0,0,0,,Окко, сен бізді көре алмаған кезің болған шығар.
Dialogue: 0,1:04:36.49,1:04:37.59,Default,,0,0,0,,Ой...
Dialogue: 0,1:04:41.50,1:04:42.50,Default,,0,0,0,,Ах
Dialogue: 0,1:04:44.33,1:04:47.67,Default,,0,0,0,,Секи-сан, сен серігіңнің қимыл-қозғалысына тым әуессің.
Dialogue: 0,1:04:47.80,1:04:49.94,Default,,0,0,0,,Мен биге көбірек көңіл бөлуім керек
Dialogue: 0,1:04:50.17,1:04:51.67,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:04:51.77,1:04:53.51,Default,,0,0,0,,Қайталап көріңіз.
Dialogue: 0,1:04:54.34,1:04:57.85,Default,,0,0,0,,Біз Кагура туралы немқұрайлы ойлайтындықтан, ол шала биге айналады.
Dialogue: 0,1:04:58.75,1:05:01.12,Default,,0,0,0,,Мен бұл туралы ойлап отырмын ...
Dialogue: 0,1:05:04.52,1:05:06.52,Default,,0,0,0,,Жас әйелі бар емес пе?
Dialogue: 0,1:05:06.69,1:05:09.13,Default,,0,0,0,,Иә, мен жақында боламын.
Dialogue: 0,1:05:10.09,1:05:11.86,Default,,0,0,0,,Әй, бұл ағай!
Dialogue: 0,1:05:12.03,1:05:13.70,Default,,0,0,0,,Шыдамдылығыңыз үшін рахмет.
Dialogue: 0,1:05:13.80,1:05:14.96,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:05:15.03,1:05:16.70,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,1:05:16.80,1:05:18.13,Default,,0,0,0,,Ашық аспан астындағы ванна пудингі
Dialogue: 0,1:05:18.20,1:05:20.70,Default,,0,0,0,,Рас! Бұл ашық аспан астындағы ванна
Dialogue: 0,1:05:20.87,1:05:22.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:05:22.34,1:05:23.87,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,1:05:24.44,1:05:26.38,Default,,0,0,0,,Окко-чан да сүйкімді
Dialogue: 0,1:05:26.51,1:05:28.48,Default,,0,0,0,,Бұл кітапқа кейінірек қол қоя аласыз ба?
Dialogue: 0,1:05:28.54,1:05:30.88,Default,,0,0,0,,Әй, қолтаңба деген осы...
Dialogue: 0,1:05:31.01,1:05:31.88,Default,,0,0,0,,Мен де
Dialogue: 0,1:05:32.01,1:05:33.18,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:39.36,1:05:40.72,Default,,0,0,0,,Бітті
Dialogue: 0,1:05:40.82,1:05:42.06,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,1:05:42.19,1:05:45.73,Default,,0,0,0,,Қалғанын өзіміз шешеміз, демалыңыз.
Dialogue: 0,1:05:45.83,1:05:47.23,Default,,0,0,0,,Әже ше?
Dialogue: 0,1:05:47.33,1:05:48.90,Default,,0,0,0,,Қазірдің өзінде демалыс күні.
Dialogue: 0,1:05:51.57,1:05:52.90,Default,,0,0,0,,Урибо?
Dialogue: 0,1:05:53.00,1:05:54.24,Default,,0,0,0,,Миё-чан?
Dialogue: 0,1:05:55.40,1:05:56.87,Default,,0,0,0,,Сузуки-кун?
Dialogue: 0,1:06:10.55,1:06:12.89,Default,,0,0,0,,Урибо Мио-чан
Dialogue: 0,1:06:29.77,1:06:30.61,Default,,0,0,0,,Уау!
Dialogue: 0,1:06:30.74,1:06:32.07,Default,,0,0,0,,Уф...
Dialogue: 0,1:06:32.18,1:06:32.94,Default,,0,0,0,,Ах
Dialogue: 0,1:06:33.41,1:06:34.78,Default,,0,0,0,,Ах, кешіріңіз!
Dialogue: 0,1:06:37.61,1:06:38.58,Default,,0,0,0,,Секи мырза
Dialogue: 0,1:06:38.68,1:06:40.45,Default,,0,0,0,,Мына Кагураны қалдырыңыз.
Dialogue: 0,1:06:40.95,1:06:41.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:42.19,1:06:44.12,Default,,0,0,0,,Бұл қашанға дейін осылай болады?
Dialogue: 0,1:06:44.22,1:06:45.46,Default,,0,0,0,,Бұл Кагура
Dialogue: 0,1:06:45.62,1:06:49.79,Default,,0,0,0,,Хана но Ю үшін біз жеткізуіміз керек маңызды нәрсе.
Dialogue: 0,1:06:50.03,1:06:51.13,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,1:06:51.23,1:06:52.80,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,1:06:52.96,1:06:54.80,Default,,0,0,0,,Секи-сан жойылмайды.
Dialogue: 0,1:06:54.96,1:06:58.23,Default,,0,0,0,,Екеуі қонақ үйді мұраға алуға бел байлағандықтан таңдалды.
Dialogue: 0,1:06:58.63,1:07:00.90,Default,,0,0,0,,Қанша уақытқа созылатыны белгісіз қонақ үй болса да!?
Dialogue: 0,1:07:01.27,1:07:02.11,Default,,0,0,0,,Акино мырза
Dialogue: 0,1:07:02.21,1:07:04.44,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:07:05.88,1:07:07.48,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,1:07:07.61,1:07:10.15,Default,,0,0,0,,Өз тұтынушыларына қамқорлық жасайтын қонақ үй
Dialogue: 0,1:07:10.25,1:07:12.32,Default,,0,0,0,,Бұл ұзаққа созылады деп ойлайсыз ба?
Dialogue: 0,1:07:12.48,1:07:13.98,Default,,0,0,0,,Біз сондаймыз дейсің бе?
Dialogue: 0,1:07:14.45,1:07:16.95,Default,,0,0,0,,Өйткені Харунояда бір ғана Накай бар.
Dialogue: 0,1:07:17.05,1:07:20.32,Default,,0,0,0,,Сіздің әжеңіз де тұтынушылармен жұмыс істеуі керек.
Dialogue: 0,1:07:20.49,1:07:22.09,Default,,0,0,0,,Өйткені мен анамын.
Dialogue: 0,1:07:22.83,1:07:25.83,Default,,0,0,0,,Мен үлкен әйел болуға жасым жетпейді.
Dialogue: 0,1:07:25.93,1:07:28.83,Default,,0,0,0,,Осындай қарт адамдардан жүктеріңізді алып жүруді сұрау
Dialogue: 0,1:07:28.93,1:07:30.60,Default,,0,0,0,,Бір нәрсені сұрау
Dialogue: 0,1:07:30.67,1:07:32.17,Default,,0,0,0,,Біз өз тұтынушыларымызға қамқорлық жасаймыз
Dialogue: 0,1:07:32.40,1:07:33.67,Default,,0,0,0,,Сондықтан бұл менмін!
Dialogue: 0,1:07:34.24,1:07:36.34,Default,,0,0,0,,Сіз балаларыңызға қамқорсыз, солай ма?
Dialogue: 0,1:07:36.44,1:07:37.64,Default,,0,0,0,,Қый!
Dialogue: 0,1:07:37.74,1:07:39.34,Default,,0,0,0,,Банкрот болатын қонақ үй болатынына сене алар емеспін.
Dialogue: 0,1:07:39.44,1:07:40.84,Default,,0,0,0,,Бұл Хананою Онсен үшін масқара!
Dialogue: 0,1:07:40.98,1:07:42.28,Default,,0,0,0,,Уф...
Dialogue: 0,1:07:42.35,1:07:43.81,Default,,0,0,0,,Ұят! Ұят!
Dialogue: 0,1:07:43.91,1:07:45.01,Default,,0,0,0,,Сондықтан оны шешіп алыңыз.
Dialogue: 0,1:07:45.11,1:07:45.85,Default,,0,0,0,,А...
Dialogue: 0,1:07:46.35,1:07:47.78,Default,,0,0,0,,Ұсақталған не?
Dialogue: 0,1:07:47.85,1:07:49.99,Default,,0,0,0,,Хару-но-яның өз әрекеті бар!
Dialogue: 0,1:07:50.09,1:07:52.19,Default,,0,0,0,,Мен мұны дұрыс емес деп айтамын.
Dialogue: 0,1:07:52.32,1:07:53.16,Default,,0,0,0,,Ей, екеуің де...
Dialogue: 0,1:07:53.26,1:07:55.02,Default,,0,0,0,,Мацуки-сан деген кім?
Dialogue: 0,1:07:55.12,1:07:58.83,Default,,0,0,0,,Барлығын өзіңіз жасауға тырыспаңыз және қызметкерлерге сенбеңіз.
Dialogue: 0,1:07:58.93,1:08:00.33,Default,,0,0,0,,Ақымақ әйел не біледі?
Dialogue: 0,1:08:00.43,1:08:01.33,Default,,0,0,0,,Біз жаттығу жасап жатырмыз.
Dialogue: 0,1:08:01.43,1:08:03.87,Default,,0,0,0,,Қонақ үй бизнесінде жұмыс жасасаңыз да, неге түкті көйлек киіп жүрсіз?
Dialogue: 0,1:08:04.03,1:08:04.87,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,1:08:04.97,1:08:06.04,Default,,0,0,0,,Эй
Dialogue: 0,1:08:06.37,1:08:08.04,Default,,0,0,0,,Сіз тағы да кейіппен айттыңыз.
Dialogue: 0,1:08:08.14,1:08:08.87,Default,,0,0,0,,Ақымақ әйел!
Dialogue: 0,1:08:09.04,1:08:11.17,Default,,0,0,0,,Мен саған айттым ғой, кейіп таныт!
Dialogue: 0,1:08:11.27,1:08:12.04,Default,,0,0,0,,Ақымақ әйел!
Dialogue: 0,1:08:12.21,1:08:13.01,Default,,0,0,0,,Тіреуіш сияқты!
Dialogue: 0,1:08:13.11,1:08:14.01,Default,,0,0,0,,Ақымақ ханым!
Dialogue: 0,1:08:14.11,1:08:15.81,Default,,0,0,0,,Пимпин Фурифури!
Dialogue: 0,1:08:15.88,1:08:16.88,Default,,0,0,0,,Тітіркендіргіш ханым!
Dialogue: 0,1:08:16.98,1:08:18.21,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:08:18.31,1:08:19.88,Default,,0,0,0,,Пинг пинг пимпин фурифурифури!
Dialogue: 0,1:08:22.29,1:08:23.22,Default,,0,0,0,,Сәлем, жарайсың!
Dialogue: 0,1:08:23.72,1:08:24.65,Default,,0,0,0,,О...
Dialogue: 0,1:08:26.36,1:08:27.32,Default,,0,0,0,,Кокоя!
Dialogue: 0,1:08:27.39,1:08:28.72,Default,,0,0,0,,Урибо
Dialogue: 0,1:08:28.96,1:08:30.99,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,1:08:31.06,1:08:32.86,Default,,0,0,0,,О, сен мені көре аласың ба?
Dialogue: 0,1:08:32.96,1:08:33.66,Default,,0,0,0,,Хэхехе
Dialogue: 0,1:08:34.83,1:08:36.17,Default,,0,0,0,,Сіз мұны керемет түрде жасадыңыз.
Dialogue: 0,1:08:36.23,1:08:37.40,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,1:08:37.50,1:08:39.90,Default,,0,0,0,,Минеко-чан, маған көмектеспе, тез үйге қайт.
Dialogue: 0,1:08:40.00,1:08:41.67,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,1:08:42.87,1:08:45.41,Default,,0,0,0,,Сізді тоқтатқан Урибо болды, солай ма?
Dialogue: 0,1:08:47.74,1:08:49.88,Default,,0,0,0,,А... Урибо?
Dialogue: 0,1:08:51.75,1:08:52.72,Default,,0,0,0,,Уф
Dialogue: 0,1:08:53.25,1:08:54.42,Default,,0,0,0,,Уф
Dialogue: 0,1:08:56.55,1:08:57.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:57.42,1:08:58.86,Default,,0,0,0,,Бұл аздап аянышты, солай емес пе?
Dialogue: 0,1:08:58.92,1:08:59.79,Default,,0,0,0,,-Ей -Өрт!
Dialogue: 0,1:09:02.66,1:09:04.59,Default,,0,0,0,,Мен тағы да ұсталдым
Dialogue: 0,1:09:05.39,1:09:06.76,Default,,0,0,0,,Әй, Миё-чан!
Dialogue: 0,1:09:07.70,1:09:08.56,Default,,0,0,0,,Окко
Dialogue: 0,1:09:10.17,1:09:11.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:13.40,1:09:14.10,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:16.77,1:09:18.11,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,1:09:19.41,1:09:21.71,Default,,0,0,0,,Менің әпкем кесірткелерді жақсы көреді.
Dialogue: 0,1:09:21.78,1:09:22.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:23.61,1:09:25.11,Default,,0,0,0,,Сәлем Шота!
Dialogue: 0,1:09:25.78,1:09:27.72,Default,,0,0,0,,Әй, әке!
Dialogue: 0,1:09:27.78,1:09:29.79,Default,,0,0,0,,Хаха, әлі ерте.
Dialogue: 0,1:09:29.89,1:09:32.05,Default,,0,0,0,,Мен Харунояның тұтынушысымын ба?
Dialogue: 0,1:09:32.12,1:09:33.09,Default,,0,0,0,,Иә!
Dialogue: 0,1:09:35.46,1:09:37.73,Default,,0,0,0,,Кисе мырзаның отбасы
Dialogue: 0,1:09:37.79,1:09:39.96,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,1:09:40.53,1:09:42.80,Default,,0,0,0,,Иә, иә, сіз осындасыз.
Dialogue: 0,1:09:42.90,1:09:44.43,Default,,0,0,0,,-Ах! -Аа...
Dialogue: 0,1:09:44.63,1:09:45.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:09:46.10,1:09:48.47,Default,,0,0,0,,Үлкен әпке, мен едім!
Dialogue: 0,1:09:49.27,1:09:50.61,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,1:09:50.71,1:09:51.91,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:09:52.38,1:09:54.81,Default,,0,0,0,,О, кіре беріс те әдемі көрінеді.
Dialogue: 0,1:09:54.98,1:09:56.95,Default,,0,0,0,,Шота-кун, қош келдіңіз
Dialogue: 0,1:09:57.25,1:09:59.48,Default,,0,0,0,,Менің атымды білесің бе?
Dialogue: 0,1:10:02.15,1:10:03.49,Default,,0,0,0,,Кітаппен бірдей.
Dialogue: 0,1:10:03.62,1:10:04.82,Default,,0,0,0,,Жақсы... у...
Dialogue: 0,1:10:04.99,1:10:07.32,Default,,0,0,0,,Уайымдамаңыз, келіңіз.
Dialogue: 0,1:10:07.82,1:10:10.83,Default,,0,0,0,,Фотода ол ересек адамға ұқсайды.
Dialogue: 0,1:10:11.39,1:10:12.50,Default,,0,0,0,,Біраз
Dialogue: 0,1:10:12.60,1:10:15.97,Default,,0,0,0,,Олар тұзы аз, калориясы аз болсын деп барын салып жүрсе де.
Dialogue: 0,1:10:16.07,1:10:17.17,Default,,0,0,0,,Бұл дәмді болды.
Dialogue: 0,1:10:17.50,1:10:18.63,Default,,0,0,0,,Мен тамақтандым
Dialogue: 0,1:10:18.73,1:10:19.84,Default,,0,0,0,,Әкем туралы
Dialogue: 0,1:10:19.94,1:10:20.67,Default,,0,0,0,,Хмм...
Dialogue: 0,1:10:20.80,1:10:22.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:10:22.61,1:10:23.17,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:10:23.19,1:10:24.23,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:10:25.61,1:10:27.51,Default,,0,0,0,,Шота-кун, жақсы
Dialogue: 0,1:10:27.61,1:10:28.85,Default,,0,0,0,,Мен сізді ұстауға рұқсат етіңіз
Dialogue: 0,1:10:28.98,1:10:30.61,Default,,0,0,0,,Шишишшиш
Dialogue: 0,1:10:30.85,1:10:32.45,Default,,0,0,0,,Шишшиш
Dialogue: 0,1:10:32.52,1:10:34.52,Default,,0,0,0,,Ханым, кешіріңіз.
Dialogue: 0,1:10:34.68,1:10:35.85,Default,,0,0,0,,Мұны да төмендетіңіз.
Dialogue: 0,1:10:35.99,1:10:36.85,Default,,0,0,0,,Сен!
Dialogue: 0,1:10:37.18,1:10:40.16,Default,,0,0,0,,Дәмі соншалықты жұмсақ, аурухана тағамынан еш айырмашылығы жоқ.
Dialogue: 0,1:10:40.46,1:10:41.32,Default,,0,0,0,,Ах
Dialogue: 0,1:10:41.42,1:10:42.99,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:10:43.93,1:10:46.36,Default,,0,0,0,,Мен тағы бірдеңе дайындай аламын ба деп сұраймын.
Dialogue: 0,1:10:46.46,1:10:47.66,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:10:47.76,1:10:51.53,Default,,0,0,0,,Мен отбасыммен саяхаттай аламын.
Dialogue: 0,1:10:51.67,1:10:54.47,Default,,0,0,0,,Неліктен бүгін бай нәрсені жемейсің?
Dialogue: 0,1:10:54.54,1:10:55.81,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:10:55.87,1:10:57.97,Default,,0,0,0,,Бүйрегімді де, ұйқы безімді де алып тастады.
Dialogue: 0,1:10:58.04,1:10:59.38,Default,,0,0,0,,Ұйқы безін алып тастамаңыз.
Dialogue: 0,1:10:59.51,1:11:01.98,Default,,0,0,0,,Сіздің дәрігеріңіз мұны істеуге қатаң кеңес берді.
Dialogue: 0,1:11:02.78,1:11:04.68,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:11:04.78,1:11:07.15,Default,,0,0,0,,Мен сізге талғамыңызға сай тағам бере алмаймын.
Dialogue: 0,1:11:07.22,1:11:08.68,Default,,0,0,0,,Бұл Ясушидің кінәсі емес.
Dialogue: 0,1:11:08.79,1:11:09.49,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:11:09.55,1:11:10.55,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,1:11:11.12,1:11:13.56,Default,,0,0,0,,Бірақ тұз бен май аз
Dialogue: 0,1:11:13.72,1:11:16.23,Default,,0,0,0,,Мен оны бай, терең дәмге ие деп айтпас едім.
Dialogue: 0,1:11:16.56,1:11:20.06,Default,,0,0,0,,Дәрі-дәрмек пен тағамның шығу тегіне сүйене отырып, қайтадан тамақ дайындау туралы ойланайық.
Dialogue: 0,1:11:23.63,1:11:26.84,Default,,0,0,0,,Мацуки-санның жақсы даналығы болуы мүмкін.
Dialogue: 0,1:11:30.51,1:11:32.91,Default,,0,0,0,,Уфуфуфуфу…
Dialogue: 0,1:11:33.58,1:11:36.05,Default,,0,0,0,,Қый!
Dialogue: 0,1:11:37.88,1:11:39.25,Default,,0,0,0,,Не болды? Окко
Dialogue: 0,1:11:39.42,1:11:41.42,Default,,0,0,0,,Қый!
Dialogue: 0,1:11:41.75,1:11:42.42,Default,,0,0,0,,Хмм
Dialogue: 0,1:11:42.55,1:11:45.42,Default,,0,0,0,,Мен Akiyoshi Inn-ге барып, сізбен ақылдасамын!
Dialogue: 0,1:11:45.52,1:11:46.42,Default,,0,0,0,,Мені күт
Dialogue: 0,1:11:46.59,1:11:47.42,Default,,0,0,0,,Ағай!
Dialogue: 0,1:11:47.56,1:11:50.03,Default,,0,0,0,,Окко, сен осындай жерге барасың ба?
Dialogue: 0,1:11:50.09,1:11:52.90,Default,,0,0,0,,Жарайсыңдар! Осындай жеңіл киіммен барасыз ба?
Dialogue: 0,1:11:53.00,1:11:54.26,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:11:55.46,1:12:02.18,Default,,0,0,0,,Ха ха ха ха ха ха ха ха ха ха ха
Dialogue: 0,1:12:02.41,1:12:03.27,Default,,0,0,0,,Уау
Dialogue: 0,1:12:04.41,1:12:05.24,Default,,0,0,0,,Адамдар өте оңай өліп қалады, иә?
Dialogue: 0,1:12:05.34,1:12:06.44,Default,,0,0,0,,...
Dialogue: 0,1:12:08.51,1:12:10.78,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:12:17.92,1:12:19.96,Default,,0,0,0,,Банкротқа ұшырайтын қонақ үйлер болады.
Dialogue: 0,1:12:20.12,1:12:22.29,Default,,0,0,0,,Гүл моншасы ұят! Ұят!
Dialogue: 0,1:12:24.53,1:12:25.39,Default,,0,0,0,,Хмм...
Dialogue: 0,1:12:26.44,1:12:30.61,Default,,0,0,0,,Хаа ха ха ха ха ха...
Dialogue: 0,1:12:31.46,1:12:32.35,Default,,0,0,0,,Хаха хаха
Dialogue: 0,1:12:32.48,1:12:33.58,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,1:12:33.61,1:12:34.30,Default,,0,0,0,,Ах
Dialogue: 0,1:12:34.93,1:12:35.97,Default,,0,0,0,,Хмм...
Dialogue: 0,1:12:36.27,1:12:37.97,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:12:38.57,1:12:41.44,Default,,0,0,0,,♬~
Dialogue: 0,1:12:42.25,1:12:43.58,Default,,0,0,0,,Миё-чан?
Dialogue: 0,1:12:56.46,1:12:57.79,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,1:12:57.89,1:12:59.00,Default,,0,0,0,,Әдемі...
Dialogue: 0,1:12:59.26,1:13:01.83,Default,,0,0,0,,Бұл біздің тұтынушыларды қуантады
Dialogue: 0,1:13:01.93,1:13:03.00,Default,,0,0,0,,Иә.
Dialogue: 0,1:13:03.10,1:13:05.67,Default,,0,0,0,,Бірақ түнде өсімдіктер мен ағаштар да ұйықтайды.
Dialogue: 0,1:13:05.80,1:13:07.50,Default,,0,0,0,,Ағаштарға түсетін ауыртпалықты қарастыру
Dialogue: 0,1:13:07.60,1:13:10.47,Default,,0,0,0,,Оны 1 сағатқа қысқартып, оның қалай өтетінін көрейік.
Dialogue: 0,1:13:10.57,1:13:12.11,Default,,0,0,0,,Тыныш бол, Юри.
Dialogue: 0,1:13:13.68,1:13:14.51,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:15.85,1:13:17.35,Default,,0,0,0,,А, біреу бар.
Dialogue: 0,1:13:19.12,1:13:20.52,Default,,0,0,0,,Бұл...
Dialogue: 0,1:13:20.65,1:13:23.02,Default,,0,0,0,,Сіз көктемгі дүкеннің жас ханымысыз ба?
Dialogue: 0,1:13:23.29,1:13:26.49,Default,,0,0,0,,Неліктен күн суытқанда олай киініп, осындай жерде жүрсің?
Dialogue: 0,1:13:28.49,1:13:30.03,Default,,0,0,0,,Өйткені сен ақымақсың.
Dialogue: 0,1:13:42.84,1:13:44.54,Default,,0,0,0,,Жетті…
Dialogue: 0,1:13:47.48,1:13:48.71,Default,,0,0,0,,Екінші қабатқа өтіңіз.
Dialogue: 0,1:13:48.88,1:13:50.01,Default,,0,0,0,,Иә
Dialogue: 0,1:13:51.55,1:13:53.15,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:14:02.39,1:14:03.89,Default,,0,0,0,,Мацуки-сан?
Dialogue: 0,1:14:13.97,1:14:15.51,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,1:14:16.67,1:14:18.91,Default,,0,0,0,,Мен бос емеспін.
Dialogue: 0,1:14:20.01,1:14:21.24,Default,,0,0,0,,Миё-чан...
Dialogue: 0,1:14:21.38,1:14:22.25,Default,,0,0,0,,Сонымен?
Dialogue: 0,1:14:22.91,1:14:23.75,Default,,0,0,0,,Не?
Dialogue: 0,1:14:24.21,1:14:26.75,Default,,0,0,0,,Бұрын болған оқиға үшін кешірім сұраймын.
Dialogue: 0,1:14:27.58,1:14:30.25,Default,,0,0,0,,Жаттығуда көңілім ауды.
Dialogue: 0,1:14:30.39,1:14:32.76,Default,,0,0,0,,Айтқаныңызда ешнәрсе жоқ.
Dialogue: 0,1:14:33.52,1:14:34.59,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:34.72,1:14:35.59,Default,,0,0,0,,Сонымен?
Dialogue: 0,1:14:36.53,1:14:39.10,Default,,0,0,0,,Мацуки мырзаның маған күш бергенін қалаймын.
Dialogue: 0,1:14:39.60,1:14:42.43,Default,,0,0,0,,Біз тұтынушыларымыздың қанағаттанғанын қалаймыз.
Dialogue: 0,1:14:43.40,1:14:46.44,Default,,0,0,0,,Сізде амбиция жоқ па?
Dialogue: 0,1:14:47.50,1:14:48.40,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:48.91,1:14:49.71,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:49.77,1:14:54.21,Default,,0,0,0,,...
Dialogue: 0,1:14:54.28,1:14:56.25,Default,,0,0,0,,...
Dialogue: 0,1:14:58.01,1:14:59.78,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,1:15:00.12,1:15:01.05,Default,,0,0,0,,Хмм...
Dialogue: 0,1:15:02.25,1:15:03.09,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:03.29,1:15:04.12,Default,,0,0,0,,Ах
Dialogue: 0,1:15:06.36,1:15:07.29,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,1:15:08.42,1:15:09.26,Default,,0,0,0,,Мұның бәрі тек менің алаңдаған жүрегімді жылдамдатты
Dialogue: 0,1:15:09.36,1:15:12.96,Default,,0,0,0,,...
Dialogue: 0,1:15:13.13,1:15:14.60,Default,,0,0,0,,♬~
Dialogue: 0,1:15:16.80,1:15:19.97,Default,,0,0,0,,...
Dialogue: 0,1:15:20.14,1:15:22.31,Default,,0,0,0,,...
Dialogue: 0,1:15:22.61,1:15:23.97,Default,,0,0,0,,Буға пісірілген тағам?
Dialogue: 0,1:15:24.07,1:15:25.24,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:15:25.31,1:15:26.41,Default,,0,0,0,,Ол пісірілген.
Dialogue: 0,1:15:26.98,1:15:29.15,Default,,0,0,0,,Нан пісіргенде май кетеді.
Dialogue: 0,1:15:29.25,1:15:30.15,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,1:15:30.41,1:15:34.08,Default,,0,0,0,,100
Dialogue: 0,1:15:34.15,1:15:35.95,Default,,0,0,0,,Егер сіз 5 грамм май жоғалтсаңыз
Dialogue: 0,1:15:36.05,1:15:38.82,Default,,0,0,0,,45
Dialogue: 0,1:15:38.92,1:15:40.42,Default,,0,0,0,,Содан кейін тұз.
Dialogue: 0,1:15:40.49,1:15:43.49,Default,,0,0,0,,...
Dialogue: 0,1:15:43.66,1:15:48.26,Default,,0,0,0,,Ол біркелкі таралады және дәмі енді жұмсақ болмайды.
Dialogue: 0,1:15:48.33,1:15:49.67,Default,,0,0,0,,Ең бастысы
Dialogue: 0,1:15:49.77,1:15:51.30,Default,,0,0,0,,Материал – өмір
Dialogue: 0,1:15:51.63,1:15:52.64,Default,,0,0,0,,Мацуки мырза
Dialogue: 0,1:15:53.14,1:15:56.64,Default,,0,0,0,,“ ”
Dialogue: 0,1:15:56.74,1:15:58.17,Default,,0,0,0,,ｂｙ ･
Dialogue: 0,1:15:58.51,1:15:59.84,Default,,0,0,0,,Олай болса сәттілік.
Dialogue: 0,1:16:00.01,1:16:01.34,Default,,0,0,0,,Ах, Мацуки-сан
Dialogue: 0,1:16:01.44,1:16:03.18,Default,,0,0,0,,Мен не айтуым керек...
Dialogue: 0,1:16:03.61,1:16:05.31,Default,,0,0,0,,Мацуки-сан, бұл керемет!
Dialogue: 0,1:16:05.42,1:16:07.02,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:16:12.26,1:16:13.29,Default,,0,0,0,,Сузуки-кун
Dialogue: 0,1:16:15.46,1:16:16.49,Default,,0,0,0,,Ағай
Dialogue: 0,1:16:16.59,1:16:18.46,Default,,0,0,0,,Қоштасу күні анықталды.
Dialogue: 0,1:16:18.76,1:16:19.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:22.03,1:16:25.70,Default,,0,0,0,,...
Dialogue: 0,1:16:25.84,1:16:27.20,Default,,0,0,0,,Аспанға көтерілу
Dialogue: 0,1:16:29.04,1:16:31.87,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:16:36.71,1:16:38.88,Default,,0,0,0,,Ал, гүл моншасы!
Dialogue: 0,1:16:39.18,1:16:41.22,Default,,0,0,0,,Бұл бағаға тұрарлық емес.
Dialogue: 0,1:16:41.88,1:16:43.39,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:16:43.49,1:16:45.72,Default,,0,0,0,,Жабысқақ жазбалар дәл және уақытты үнемдейді.
Dialogue: 0,1:16:46.29,1:16:48.22,Default,,0,0,0,,Көмегіңе рахмет, жас ханым.
Dialogue: 0,1:16:50.23,1:16:51.19,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:51.96,1:16:53.53,Default,,0,0,0,,Оны маған қалдыр!
Dialogue: 0,1:16:53.96,1:16:54.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:55.36,1:16:56.37,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:16:56.47,1:16:58.53,Default,,0,0,0,,Барлығы Ясуши мырзаның қолына байланысты.
Dialogue: 0,1:16:59.34,1:17:02.91,Default,,0,0,0,,А, бұл жақсы нәрсе.
Dialogue: 0,1:17:03.01,1:17:04.41,Default,,0,0,0,,Ио, Хару жоқ Я!
Dialogue: 0,1:17:08.08,1:17:09.41,Default,,0,0,0,,Иә, бұл дәмді!
Dialogue: 0,1:17:09.55,1:17:11.21,Default,,0,0,0,,Тұзды дәмі де тиімді.
Dialogue: 0,1:17:11.58,1:17:12.42,Default,,0,0,0,,Иә
Dialogue: 0,1:17:12.55,1:17:16.25,Default,,0,0,0,,...
Dialogue: 0,1:17:16.65,1:17:18.09,Default,,0,0,0,,Мен бәрін жедім.
Dialogue: 0,1:17:18.69,1:17:20.72,Default,,0,0,0,,Сакураның чипі де тиімді.
Dialogue: 0,1:17:22.93,1:17:25.19,Default,,0,0,0,,...
Dialogue: 0,1:17:25.26,1:17:26.40,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,1:17:26.50,1:17:29.10,Default,,0,0,0,,А, мен сусын алғым келеді.
Dialogue: 0,1:17:29.20,1:17:29.93,Default,,0,0,0,,Мен айттым!
Dialogue: 0,1:17:30.03,1:17:30.90,Default,,0,0,0,,Иә
Dialogue: 0,1:17:31.20,1:17:32.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:32.77,1:17:33.87,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,1:17:35.07,1:17:37.61,Default,,0,0,0,,Алкогольмен пісірілген Мацутаке күріш
Dialogue: 0,1:17:37.74,1:17:39.78,Default,,0,0,0,,...
Dialogue: 0,1:17:39.91,1:17:41.11,Default,,0,0,0,,Я~
Dialogue: 0,1:17:42.41,1:17:44.58,Default,,0,0,0,,Бұл алкогольдің жағымды иісі.
Dialogue: 0,1:17:52.56,1:17:53.76,Default,,0,0,0,,Ей, сен! Маған әзілдедің ғой, иә!?➡
Dialogue: 0,1:17:53.86,1:17:55.76,Default,,0,0,0,,Хахахаха!
Dialogue: 0,1:17:56.06,1:17:56.89,Default,,0,0,0,,Тамаша!
Dialogue: 0,1:17:56.96,1:17:58.13,Default,,0,0,0,,Иә!
Dialogue: 0,1:18:02.30,1:18:04.30,Default,,0,0,0,,Әйеліңізге не болды?
Dialogue: 0,1:18:04.90,1:18:06.90,Default,,0,0,0,,Тұру кітапшасында бірдеңе дұрыс болмаса да.
Dialogue: 0,1:18:07.30,1:18:08.47,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:18:08.60,1:18:10.64,Default,,0,0,0,,Шынында да емес.
Dialogue: 0,1:18:11.81,1:18:15.31,Default,,0,0,0,,...
Dialogue: 0,1:18:16.25,1:18:19.65,Default,,0,0,0,,...
Dialogue: 0,1:18:19.82,1:18:20.58,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,1:18:20.65,1:18:21.65,Default,,0,0,0,,Карри!
Dialogue: 0,1:18:21.75,1:18:22.65,Default,,0,0,0,,Дегенмен, меніңше, Кира осы екі нәрсенің бірін білмейді.
Dialogue: 0,1:18:24.65,1:18:25.62,Default,,0,0,0,,Дәмді!
Dialogue: 0,1:18:25.72,1:18:26.66,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,1:18:27.09,1:18:29.16,Default,,0,0,0,,Қуаныштымын.
Dialogue: 0,1:18:29.26,1:18:30.83,Default,,0,0,0,,Ясуши мырза күткендей
Dialogue: 0,1:18:30.99,1:18:31.83,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:18:31.96,1:18:34.66,Default,,0,0,0,,～
Dialogue: 0,1:18:34.83,1:18:36.97,Default,,0,0,0,,Иә! Азалия бөлмесінің негізгі тағамы
Dialogue: 0,1:18:37.05,1:18:37.72,Default,,0,0,0,,Иә!
Dialogue: 0,1:18:38.17,1:18:39.97,Default,,0,0,0,,Хананою стейк
Dialogue: 0,1:18:40.07,1:18:40.97,Default,,0,0,0,,-Ой! -Уау
Dialogue: 0,1:18:41.07,1:18:43.67,Default,,0,0,0,,...
Dialogue: 0,1:18:43.94,1:18:46.83,Default,,0,0,0,,- -
Dialogue: 0,1:18:47.01,1:18:48.01,Default,,0,0,0,,Аму
Dialogue: 0,1:18:49.41,1:18:50.35,Default,,0,0,0,,Хмм?
Dialogue: 0,1:18:50.75,1:18:52.65,Default,,0,0,0,,-Ммм~ -Дәмді~
Dialogue: 0,1:18:53.48,1:18:54.85,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,1:18:55.65,1:18:56.79,Default,,0,0,0,,Жеңдер!
Dialogue: 0,1:18:56.85,1:18:57.85,Default,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,1:18:58.59,1:19:01.12,Default,,0,0,0,,...
Dialogue: 0,1:19:01.76,1:19:03.69,Default,,0,0,0,,Қызыл шараппен пісірілген күріш
Dialogue: 0,1:19:03.86,1:19:06.20,Default,,0,0,0,,...
Dialogue: 0,1:19:06.36,1:19:07.53,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:19:07.63,1:19:09.20,Default,,0,0,0,,Жоқ, бұл дәмді!
Dialogue: 0,1:19:09.53,1:19:10.87,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,1:19:12.44,1:19:14.67,Default,,0,0,0,,Рахмет, кішкентай қыз.
Dialogue: 0,1:19:14.77,1:19:17.17,Default,,0,0,0,,Мен сияқтылар өзімшіл, мені тыңдаңыздар.
Dialogue: 0,1:19:18.11,1:19:19.18,Default,,0,0,0,,Жоқ
Dialogue: 0,1:19:19.28,1:19:23.18,Default,,0,0,0,,...
Dialogue: 0,1:19:25.28,1:19:26.65,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,1:19:26.72,1:19:27.55,Default,,0,0,0,,Иә
Dialogue: 0,1:19:34.22,1:19:35.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:35.39,1:19:36.23,Default,,0,0,0,,Га
Dialogue: 0,1:19:36.79,1:19:38.36,Default,,0,0,0,,О, құдайым...
Dialogue: 0,1:19:42.67,1:19:43.90,Default,,0,0,0,,Мен ұйықтап қалдым
Dialogue: 0,1:19:44.90,1:19:48.91,Default,,0,0,0,,...
Dialogue: 0,1:19:49.04,1:19:51.07,Default,,0,0,0,,Дәмді тағамды жеу жақсы.
Dialogue: 0,1:19:51.81,1:19:53.24,Default,,0,0,0,,Мен тірі болғаныма қуаныштымын
Dialogue: 0,1:19:54.74,1:19:57.25,Default,,0,0,0,,Бұл адам наурыз айында апатқа ұшырады.
Dialogue: 0,1:19:57.41,1:19:59.02,Default,,0,0,0,,Мен ұзақ уақыт ауруханада жаттым.
Dialogue: 0,1:19:59.42,1:20:00.58,Default,,0,0,0,,Жазатайым оқиға…
Dialogue: 0,1:20:01.75,1:20:04.75,Default,,0,0,0,,Мен бірнеше ай бойы есін жимадым.
Dialogue: 0,1:20:04.85,1:20:07.09,Default,,0,0,0,,Басында бұл жақсы емес деп ойладым.
Dialogue: 0,1:20:08.69,1:20:10.73,Default,,0,0,0,,Ойластарыммен бірге—
Dialogue: 0,1:20:13.60,1:20:17.07,Default,,0,0,0,,...
Dialogue: 0,1:20:18.10,1:20:19.94,Default,,0,0,0,,Одан аулақ болуға тырысу
Dialogue: 0,1:20:20.07,1:20:21.90,Default,,0,0,0,,Мен қарсы жолаққа жүгірдім
Dialogue: 0,1:20:22.27,1:20:23.27,Default,,0,0,0,,Хмм...
Dialogue: 0,1:20:23.41,1:20:24.91,Default,,0,0,0,,Қарсы келе жатқан көлікпен соқтығысуы
Dialogue: 0,1:20:26.21,1:20:27.11,Default,,0,0,0,,Хмм...
Dialogue: 0,1:20:28.54,1:20:32.05,Default,,0,0,0,,Мен келе жатқан көліктің отбасын жарақаттадым.
Dialogue: 0,1:20:32.28,1:20:33.12,Default,,0,0,0,,Ха...
Dialogue: 0,1:20:34.08,1:20:35.79,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,1:20:36.72,1:20:39.39,Default,,0,0,0,,Бірақ мені құтқарған бір нәрсе болды
Dialogue: 0,1:20:39.96,1:20:43.96,Default,,0,0,0,,Оқиғаға ерлі-зайыптылардың жалғыз қызы араласты.
Dialogue: 0,1:20:44.06,1:20:46.90,Default,,0,0,0,,Мен мүлде зиянсыз аман қалдым.
Dialogue: 0,1:20:46.96,1:20:48.60,Default,,0,0,0,,Аа... бұл өтірік...
Dialogue: 0,1:20:48.70,1:20:49.47,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:49.77,1:20:51.63,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,1:20:52.14,1:20:52.97,Default,,0,0,0,,20-шы эпизод: Бастықтың соңғы бұйрығы
Dialogue: 0,1:20:53.77,1:20:54.64,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:55.04,1:20:56.11,Default,,0,0,0,,Хмм...
Dialogue: 0,1:20:56.21,1:20:58.07,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:20:58.14,1:20:59.44,Default,,0,0,0,,Өтірік
Dialogue: 0,1:20:59.54,1:21:00.44,Default,,0,0,0,,Хмм...
Dialogue: 0,1:21:07.82,1:21:09.32,Default,,0,0,0,,Мен үйге барғым келеді...
Dialogue: 0,1:21:09.89,1:21:12.59,Default,,0,0,0,,♬~
Dialogue: 0,1:21:13.06,1:21:14.49,Default,,0,0,0,,Окко
Dialogue: 0,1:21:14.59,1:21:15.76,Default,,0,0,0,,Ағай
Dialogue: 0,1:21:15.83,1:21:16.99,Default,,0,0,0,,Хмм...
Dialogue: 0,1:21:22.33,1:21:24.30,Default,,0,0,0,,Кешіріңіз, Окко.
Dialogue: 0,1:21:25.07,1:21:26.84,Default,,0,0,0,,Мен сенің жаныңда тұра алмаймын
Dialogue: 0,1:21:26.97,1:21:28.00,Default,,0,0,0,,Окко
Dialogue: 0,1:21:28.57,1:21:29.94,Default,,0,0,0,,Әкем
Dialogue: 0,1:21:30.01,1:21:31.34,Default,,0,0,0,,Анам…
Dialogue: 0,1:21:35.48,1:21:37.31,Default,,0,0,0,,Әкесі де, анасы да
Dialogue: 0,1:21:37.41,1:21:41.15,Default,,0,0,0,,Тірі екеніңізге қуаныштымын.
Dialogue: 0,1:21:42.02,1:21:44.79,Default,,0,0,0,,Біз енді бұл дүниеде болмасақ та
Dialogue: 0,1:21:44.85,1:21:48.49,Default,,0,0,0,,Дені сау, жас келіншек болатыныңа сенемін.
Dialogue: 0,1:21:48.66,1:21:50.19,Default,,0,0,0,,Маған ұнамайды... Маған ұнамайды
Dialogue: 0,1:21:50.33,1:21:52.13,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,1:21:52.20,1:21:54.03,Default,,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 0,1:21:55.26,1:21:57.17,Default,,0,0,0,,Сіз жалғыз емессіз.
Dialogue: 0,1:21:57.27,1:21:58.47,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:21:58.94,1:21:59.80,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:21:59.87,1:22:01.50,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,1:22:01.60,1:22:03.34,Default,,0,0,0,,Мені тастама!
Dialogue: 0,1:22:03.44,1:22:04.64,Default,,0,0,0,,Кішкентай қыз!
Dialogue: 0,1:22:04.71,1:22:05.68,Default,,0,0,0,,Мен бұны бұрыннан-ақ есіме түсіріп қойдым, білесің бе.
Dialogue: 0,1:22:06.88,1:22:08.04,Default,,0,0,0,,Окко
Dialogue: 0,1:22:08.18,1:22:10.55,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,1:22:10.65,1:22:12.38,Default,,0,0,0,,Жоқ... а!
Dialogue: 0,1:22:12.88,1:22:14.18,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,1:22:15.05,1:22:16.22,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:22:17.65,1:22:19.22,Default,,0,0,0,,Урибо!
Dialogue: 0,1:22:20.39,1:22:21.99,Default,,0,0,0,,Миё-чан!
Dialogue: 0,1:22:22.99,1:22:24.23,Default,,0,0,0,,Мен бұны бұрыннан-ақ есіме түсіріп қойдым, білесің бе.
Dialogue: 0,1:22:24.33,1:22:25.73,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:22:27.06,1:22:28.83,Default,,0,0,0,,Шық...
Dialogue: 0,1:22:28.90,1:22:31.20,Default,,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 0,1:22:37.74,1:22:39.08,Default,,0,0,0,,Миё-чан!
Dialogue: 0,1:22:39.48,1:22:40.24,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:22:50.59,1:22:51.69,Default,,0,0,0,,Ағай!
Dialogue: 0,1:22:54.56,1:22:55.69,Default,,0,0,0,,♬~
Dialogue: 0,1:22:56.02,1:22:59.21,Default,,0,0,0,,Уфххххххххххххххххххххххххх
Dialogue: 0,1:22:59.38,1:23:02.60,Default,,0,0,0,,-Иуууууууууууууу~ -Окко-чан
Dialogue: 0,1:23:03.01,1:23:07.43,Default,,0,0,0,,Хиуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,1:23:09.27,1:23:12.11,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,1:23:12.54,1:23:14.44,Default,,0,0,0,,Мен мұнда келуім керек.
Dialogue: 0,1:23:15.18,1:23:16.91,Default,,0,0,0,,Ата-анаң туралы
Dialogue: 0,1:23:17.61,1:23:19.78,Default,,0,0,0,,Урибо мен Миё-чан туралы
Dialogue: 0,1:23:21.05,1:23:22.79,Default,,0,0,0,,Бұл ауырған болуы керек.
Dialogue: 0,1:23:23.55,1:23:25.39,Default,,0,0,0,,Менімен сөйлескеніңізге рахмет.
Dialogue: 0,1:23:26.46,1:23:28.62,Default,,0,0,0,,Сіз жалғыз боласыз ба?
Dialogue: 0,1:23:30.43,1:23:31.63,Default,,0,0,0,,Бірақ балақай
Dialogue: 0,1:23:31.76,1:23:33.30,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,1:23:37.47,1:23:39.10,Default,,0,0,0,,Даңқ мырза
Dialogue: 0,1:23:39.77,1:23:41.64,Default,,0,0,0,,Ата-анаң да саған қарап отыр.
Dialogue: 0,1:23:46.24,1:23:49.91,Default,,0,0,0,,Сен сондай жылауық болсаң, жақсы жас әйел бола алмайсың.
Dialogue: 0,1:23:50.91,1:23:51.81,Default,,0,0,0,,Хмм
Dialogue: 0,1:23:53.98,1:23:54.65,Default,,0,0,0,,Ах
Dialogue: 0,1:23:55.79,1:23:57.15,Default,,0,0,0,,Мацуки мырза
Dialogue: 0,1:23:58.45,1:24:00.92,Default,,0,0,0,,Мацуки мырза, жолыңыздан шығып кеткенім үшін кешіріңіз.
Dialogue: 0,1:24:00.99,1:24:02.29,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:24:02.39,1:24:03.66,Default,,0,0,0,,Достардан ғашықтарға, тіпті отбасы мүшелерінен де
Dialogue: 0,1:24:03.79,1:24:05.26,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:24:05.33,1:24:06.66,Default,,0,0,0,,Шота
Dialogue: 0,1:24:06.83,1:24:09.17,Default,,0,0,0,,Мен осындамын! Мен мындамын!
Dialogue: 0,1:24:09.40,1:24:12.30,Default,,0,0,0,,Енді өзімшіл болма, аяқ киіміңді ки
Dialogue: 0,1:24:12.74,1:24:15.00,Default,,0,0,0,,Шота, кешіріңіз.
Dialogue: 0,1:24:15.10,1:24:17.34,Default,,0,0,0,,Әке, мен мұнда бола алмаймын.
Dialogue: 0,1:24:17.51,1:24:18.67,Default,,0,0,0,,Не? кеттік
Dialogue: 0,1:24:18.78,1:24:20.81,Default,,0,0,0,,Мен мұнда жалғызбын!
Dialogue: 0,1:24:20.91,1:24:23.51,Default,,0,0,0,,Анам мен әкем бара алады.
Dialogue: 0,1:24:23.68,1:24:24.35,Default,,0,0,0,,Ах
Dialogue: 0,1:24:24.65,1:24:25.68,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:24:26.18,1:24:27.18,Default,,0,0,0,,Окко
Dialogue: 0,1:24:30.02,1:24:31.52,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:24:32.02,1:24:33.36,Default,,0,0,0,,Шота-кун
Dialogue: 0,1:24:34.02,1:24:35.63,Default,,0,0,0,,Мен осында болғым келеді
Dialogue: 0,1:24:35.69,1:24:37.03,Default,,0,0,0,,Сіз түнеуге болады, солай ма?
Dialogue: 0,1:24:38.46,1:24:41.03,Default,,0,0,0,,Иә, жақсы, осында қал.
Dialogue: 0,1:24:41.20,1:24:42.37,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:45.20,1:24:47.64,Default,,0,0,0,,Секи мырза, қалғанын маған қалдырыңыз.
Dialogue: 0,1:24:48.04,1:24:49.37,Default,,0,0,0,,Қыз бала…
Dialogue: 0,1:24:49.71,1:24:51.54,Default,,0,0,0,,Мен не айтуым керек...
Dialogue: 0,1:24:51.64,1:24:53.01,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,1:24:53.11,1:24:54.18,Default,,0,0,0,,Шота, кеттік.
Dialogue: 0,1:24:54.28,1:24:55.38,Default,,0,0,0,,Шота
Dialogue: 0,1:24:55.48,1:24:56.35,Default,,0,0,0,,Ум...
Dialogue: 0,1:24:56.81,1:25:00.05,Default,,0,0,0,,Менің үйімде қалуыңызды өтінемін.
Dialogue: 0,1:25:00.45,1:25:01.65,Default,,0,0,0,,Хмм...
Dialogue: 0,1:25:01.85,1:25:02.89,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:03.32,1:25:06.36,Default,,0,0,0,,Секи-сан, жарайды. Мен оны үйде сақтаймын.
Dialogue: 0,1:25:08.72,1:25:09.69,Default,,0,0,0,,Жоқ
Dialogue: 0,1:25:14.63,1:25:16.50,Default,,0,0,0,,Сондай-ақ қайтыс болған ата-аналар
Dialogue: 0,1:25:17.37,1:25:19.74,Default,,0,0,0,,Мұны әжемнің әйелі де жиі айтады.
Dialogue: 0,1:25:22.74,1:25:24.64,Default,,0,0,0,,Хананою Онсендегі ыстық су
Dialogue: 0,1:25:24.74,1:25:27.24,Default,,0,0,0,,Құдайдан алған ыстық су
Dialogue: 0,1:25:27.38,1:25:28.85,Default,,0,0,0,,Ешкім бас тартпайды
Dialogue: 0,1:25:28.91,1:25:32.58,Default,,0,0,0,,Ол бәрін қабылдайды және сізді емдейді.
Dialogue: 0,1:25:33.92,1:25:35.08,Default,,0,0,0,,Сонымен
Dialogue: 0,1:25:35.75,1:25:37.85,Default,,0,0,0,,Жақсылап демалыңыз.
Dialogue: 0,1:25:37.92,1:25:39.09,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:25:40.39,1:25:42.93,Default,,0,0,0,,Рахмет, кішкентай қыз.
Dialogue: 0,1:25:43.59,1:25:45.76,Default,,0,0,0,,Бірақ сені алып келген менмін.
Dialogue: 0,1:25:46.43,1:25:47.26,Default,,0,0,0,,Хмм...
Dialogue: 0,1:25:48.06,1:25:49.70,Default,,0,0,0,,Өйткені сіз...
Dialogue: 0,1:25:50.10,1:25:53.54,Default,,0,0,0,,Секи мырза мен ханымның мен өлтірген жалғыз қызы.
Dialogue: 0,1:25:53.60,1:25:55.24,Default,,0,0,0,,Орико-чан, солай ма?
Dialogue: 0,1:25:55.94,1:25:57.21,Default,,0,0,0,,Е...
Dialogue: 0,1:26:10.39,1:26:11.42,Default,,0,0,0,,Жоқ
Dialogue: 0,1:26:11.89,1:26:13.59,Default,,0,0,0,,Мен осындамын...
Dialogue: 0,1:26:14.52,1:26:16.59,Default,,0,0,0,,Мен Харунояның жас ханымымын!
Dialogue: 0,1:26:22.77,1:26:23.93,Default,,0,0,0,,Окко
Dialogue: 0,1:26:25.03,1:26:26.44,Default,,0,0,0,,Ағай...
Dialogue: 0,1:26:26.90,1:26:28.94,Default,,0,0,0,,Қандай тамаша жігіт.
Dialogue: 0,1:26:29.57,1:26:30.47,Default,,0,0,0,,Иә.
Dialogue: 0,1:26:33.14,1:26:34.48,Default,,0,0,0,,Мен… мен жай…—
Dialogue: 0,1:26:34.81,1:26:37.31,Default,,0,0,0,,Ішке кіргіңіз келе ме?
Dialogue: 0,1:26:37.48,1:26:39.42,Default,,0,0,0,,Қар да жауып тұр.
Dialogue: 0,1:26:40.15,1:26:41.98,Default,,0,0,0,,Мен де түней аламын ба?
Dialogue: 0,1:26:42.32,1:26:44.15,Default,,0,0,0,,Иә! Әрине
Dialogue: 0,1:26:44.32,1:26:45.46,Default,,0,0,0,,Ах хехе
Dialogue: 0,1:26:45.66,1:26:46.99,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,1:26:47.09,1:26:48.03,Default,,0,0,0,,Сөмке Рахмет
Dialogue: 0,1:26:48.06,1:26:48.90,Default,,0,0,0,,Иә
Dialogue: 0,1:26:50.59,1:26:51.46,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,1:26:51.56,1:26:52.83,Default,,0,0,0,,Әкем
Dialogue: 0,1:26:57.50,1:26:59.67,Default,,0,0,0,,Апай, сіз бұрын болдыңыз ба?
Dialogue: 0,1:26:59.77,1:27:00.50,Default,,0,0,0,,Уф...
Dialogue: 0,1:27:00.67,1:27:02.44,Default,,0,0,0,,Иә, мен осындамын.
Dialogue: 0,1:27:03.41,1:27:05.01,Default,,0,0,0,,Бұлақ үйдің жас келіншегі
Dialogue: 0,1:27:05.11,1:27:06.01,Default,,0,0,0,,Хмм...
Dialogue: 0,1:27:06.74,1:27:08.51,Default,,0,0,0,,Ақымақ әйеліңді қайтар.
Dialogue: 0,1:27:28.77,1:27:30.70,Default,,0,0,0,,Біртүрлі жер екен.
Dialogue: 0,1:27:30.83,1:27:32.03,Default,,0,0,0,,Иә.
Dialogue: 0,1:27:42.21,1:27:44.88,Default,,0,0,0,,Сіз бұрын Оурей туралы айттыңыз.
Dialogue: 0,1:27:45.01,1:27:45.88,Default,,0,0,0,,Иә
Dialogue: 0,1:27:45.98,1:27:48.72,Default,,0,0,0,,Негізі дауысты бұрын ғана естігенмін.
Dialogue: 0,1:27:48.85,1:27:49.55,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:49.72,1:27:53.16,Default,,0,0,0,,Қателік жасағанда немесе тұтынушыдан ұрысқанда
Dialogue: 0,1:27:53.22,1:27:56.89,Default,,0,0,0,,«Мацуки, қолыңнан келгеннің бәрін істе». «Мацуки жақсы болады».
Dialogue: 0,1:27:56.99,1:27:58.06,Default,,0,0,0,,Ах
Dialogue: 0,1:28:00.53,1:28:01.90,Default,,0,0,0,,Мен үшін.
Dialogue: 0,1:28:02.00,1:28:04.90,Default,,0,0,0,,Мен тумай тұрып қайтыс болған әпкем бар еді.
Dialogue: 0,1:28:05.07,1:28:07.74,Default,,0,0,0,,Бұл менің әпкемнің дауысы сияқты...
Dialogue: 0,1:28:10.34,1:28:12.04,Default,,0,0,0,,Мен сені сағындым
Dialogue: 0,1:28:12.14,1:28:13.21,Default,,0,0,0,,Синдзуки
Dialogue: 0,1:28:20.08,1:28:21.85,Default,,0,0,0,,Енді барайық
Dialogue: 0,1:28:23.42,1:28:24.35,Default,,0,0,0,,Иә
Dialogue: 0,1:28:32.16,1:28:35.60,Default,,0,0,0,,Минеко-чанның котосын қайта тыңдасам ғой.
Dialogue: 0,1:28:39.44,1:28:43.54,Default,,0,0,0,,Окко Бүгін ғибадатхананың максималды қуаты!
Dialogue: 0,1:28:52.38,1:28:54.28,Default,,0,0,0,,Сіз шынымен қоштасып жатырсыз ба?
Dialogue: 0,1:28:54.42,1:28:55.79,Default,,0,0,0,,Қайта кездескенше
Dialogue: 0,1:28:55.95,1:28:58.12,Default,,0,0,0,,Қайта туылу
Dialogue: 0,1:28:58.29,1:29:00.06,Default,,0,0,0,,Олай болса көктемгі дүкенге барыңыз
Dialogue: 0,1:29:00.12,1:29:02.89,Default,,0,0,0,,Ересек адаммен танысыңыз!
Dialogue: 0,1:29:06.46,1:29:07.46,Default,,0,0,0,,Ах
Dialogue: 0,1:29:07.56,1:29:08.30,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,1:29:08.46,1:29:09.97,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:29:19.48,1:29:21.08,Default,,0,0,0,,Ах, бірақ
Dialogue: 0,1:29:21.14,1:29:24.65,Default,,0,0,0,,Қайтадан туған екі адамға қарап, түсіне алар ма екенмін?
Dialogue: 0,1:29:24.81,1:29:25.82,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:29:25.92,1:29:27.28,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:29:27.38,1:29:29.82,Default,,0,0,0,,Хехе, асыға күтемін.
Dialogue: 0,1:29:29.99,1:29:31.99,Default,,0,0,0,,Мен ашық ауада ваннаға арналған пудинг жегім келеді
Dialogue: 0,1:29:32.09,1:29:35.16,Default,,0,0,0,,Мен ыстық бұлаққа барғым келеді!
Dialogue: 0,1:29:36.93,1:29:38.09,Default,,0,0,0,,А...
Dialogue: 0,1:29:38.16,1:29:41.50,Default,,0,0,0,,Осы сәт мәңгілікке созылса екен
Dialogue: 0,1:29:41.63,1:29:42.50,Default,,0,0,0,,Окко
Dialogue: 0,1:29:42.63,1:29:43.67,Default,,0,0,0,,Окко
Dialogue: 0,1:29:49.01,1:29:51.67,Default,,0,0,0,,Миё-чан...
Dialogue: 0,1:30:37.05,1:30:41.56,Default,,0,0,0,,Бүгін тағы да «Ертең кездескенше» деп айтайын
Dialogue: 0,1:30:41.66,1:30:46.13,Default,,0,0,0,,Біз ұстаған қолдар әлі де жылы
Dialogue: 0,1:30:46.23,1:30:54.91,Default,,0,0,0,,Қазір «қош бол» деу тым жалғыздық.
Dialogue: 0,1:31:04.68,1:31:09.09,Default,,0,0,0,,Мигихидари Қайда барамыз?
Dialogue: 0,1:31:09.25,1:31:13.76,Default,,0,0,0,,Мен білмейтін нәрселер көп
Dialogue: 0,1:31:13.92,1:31:22.67,Default,,0,0,0,,Мен сенімен бірге сол жылауық күнді басып өтемін
Dialogue: 0,1:31:22.77,1:31:27.40,Default,,0,0,0,,Түн түскенде аспан ән сала бастайды
Dialogue: 0,1:31:27.50,1:31:35.41,Default,,0,0,0,,Өсімдіктер тербеліп, жаңбыр жауды.
Dialogue: 0,1:31:35.51,1:31:39.95,Default,,0,0,0,,Сол бұрышқа бұрылғаным есіме түсті
Dialogue: 0,1:31:40.08,1:31:44.62,Default,,0,0,0,,Жақын келсең, ыстық. Бұл ыстық.
Dialogue: 0,1:31:44.75,1:31:49.79,Default,,0,0,0,,Жазды түртіп, есіме түсті
Dialogue: 0,1:31:49.89,1:31:53.30,Default,,0,0,0,,жай ғана
Dialogue: 0,1:32:03.47,1:32:07.94,Default,,0,0,0,,Мен жай ғана мені ұстағаныңды қаладым
Dialogue: 0,1:32:08.04,1:32:12.62,Default,,0,0,0,,Бойым өссе де, баламын
Dialogue: 0,1:32:12.72,1:32:21.43,Default,,0,0,0,,Аппақ қол шашымнан ақырын сипап, ғайып болды.
Dialogue: 0,1:32:21.66,1:32:26.16,Default,,0,0,0,,Таң атқанда құстар ән сала бастайды
Dialogue: 0,1:32:26.30,1:32:34.07,Default,,0,0,0,,Жарық бөлшегі ғашықтық киінген
Dialogue: 0,1:32:36.64,1:32:41.18,Default,,0,0,0,,Әлі есімде қалған жел алыста еді
Dialogue: 0,1:32:41.28,1:32:45.68,Default,,0,0,0,,Бір-бірімізге тигенде ыстық болады
Dialogue: 0,1:32:45.85,1:32:50.99,Default,,0,0,0,,Сол жаздың соңы есіме түсті
Dialogue: 0,1:32:51.09,1:32:54.26,Default,,0,0,0,,жай ғана
Dialogue: 0,1:33:13.48,1:33:18.05,Default,,0,0,0,,«Қош бол» Әзірше «қайырлы түн» деп айтыңыз.
Dialogue: 0,1:33:18.18,1:33:22.69,Default,,0,0,0,,Көзіңді жұмып ән айт
Dialogue: 0,1:33:22.79,1:33:27.86,Default,,0,0,0,,Ертең тағы да "қайырлы таң" деймін.
Dialogue: 0,1:33:27.96,1:33:31.39,Default,,0,0,0,,жай ғана
Dialogue: 0,1:33:32.89,1:33:38.89,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
