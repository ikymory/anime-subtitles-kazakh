Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.56,0:00:25.10,Default,,0,0,0,,(Буререширан Гуфтсудо Суикиичи
Dialogue: 0,0:00:25.23,0:00:28.98,Default,,0,0,0,,...
Dialogue: 0,0:00:29.07,0:00:33.40,Default,,0,0,0,,...
Dialogue: 0,0:00:33.53,0:00:35.41,Default,,0,0,0,,Бисоку курсын бітіргендер7)
Dialogue: 0,0:00:39.03,0:00:42.75,Default,,0,0,0,,Бұл Кива университетінің жұмысының бұзылуы.
Dialogue: 0,0:00:42.83,0:00:47.46,Default,,0,0,0,,...
Dialogue: 0,0:00:49.80,0:00:52.71,Default,,0,0,0,,Бұл жас бала
Dialogue: 0,0:00:52.80,0:00:57.64,Default,,0,0,0,,Қолыңызда бөртпе болса, жарайсыз.
Dialogue: 0,0:01:05.35,0:01:08.98,Default,,0,0,0,,Ыстық... белгісі
Dialogue: 0,0:01:09.11,0:01:10.90,Default,,0,0,0,,Бұл тым қатты, Наруто!
Dialogue: 0,0:01:10.98,0:01:14.78,Default,,0,0,0,,Шинчо Жаңа жазғы киім алу қиынға соққанмен, бұл уақытты босқа өткізген сияқты.
Dialogue: 0,0:01:14.86,0:01:17.95,Default,,0,0,0,,Сәттілік! Кездесу нүктесіне жақындап қалдық.
Dialogue: 0,0:01:18.82,0:01:21.12,Default,,0,0,0,,Бирангтың миссиясы...
Dialogue: 0,0:01:21.24,0:01:22.62,Default,,0,0,0,,Раинин, келесі клиентіңіз қандай?
Dialogue: 0,0:01:22.70,0:01:24.45,Default,,0,0,0,,Bip Өте керемет YV 1 PP Кешіріңіз
Dialogue: 0,0:01:24.87,0:01:27.37,Default,,0,0,0,,Цунаде-сама Цунаде-сама осылай деді.
Dialogue: 0,0:01:28.71,0:01:29.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:47.14,0:01:48.94,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:49.02,0:01:52.48,Default,,0,0,0,,Осының бәрін алып жүруге қалай дәтің бар?
Dialogue: 0,0:01:52.82,0:01:57.40,Default,,0,0,0,,Мұның бәрі менің сатып алуым.
Dialogue: 0,0:01:58.66,0:02:01.83,Default,,0,0,0,,Саяхатта жүріп өзіме ұнаған дүниелерді сатып алдым.
Dialogue: 0,0:02:01.95,0:02:04.83,Default,,0,0,0,,Мен білмей тұрып, бұл сомаға қалай жетті? Хаха
Dialogue: 0,0:02:09.00,0:02:13.00,Default,,0,0,0,,Мен ай елінің ханзадасы Мичиру Цукимін.
Dialogue: 0,0:02:13.13,0:02:14.30,Default,,0,0,0,,Сіз...
Dialogue: 0,0:02:14.38,0:02:16.72,Default,,0,0,0,,Жапыраққа тығылған ауылдан келдім.
Dialogue: 0,0:02:16.84,0:02:20.01,Default,,0,0,0,,Мен Какаши Хатаке, капитанмын.
Dialogue: 0,0:02:20.14,0:02:22.05,Default,,0,0,0,,Ол Наруто Узумаки
Dialogue: 0,0:02:22.18,0:02:23.47,Default,,0,0,0,,...
Dialogue: 0,0:02:23.56,0:02:25.02,Default,,0,0,0,,Харуно Сакугукура
Dialogue: 0,0:02:25.14,0:02:26.02,Default,,0,0,0,,...
Dialogue: 0,0:02:26.10,0:02:27.35,Default,,0,0,0,,және Рок Ли
Dialogue: 0,0:02:27.48,0:02:28.39,Default,,0,0,0,,Хатцуцури!
Dialogue: 0,0:02:28.77,0:02:30.10,Default,,0,0,0,,4 немесе одан да көп адам
Dialogue: 0,0:02:30.19,0:02:33.23,Default,,0,0,0,,Қымбатты Киден, үйге қайтқанша мен сені шығарып саламын.
Dialogue: 0,0:02:33.36,0:02:36.94,Default,,0,0,0,,Дұрыс, маған қамқор болыңыз.
Dialogue: 0,0:02:40.36,0:02:42.95,Default,,0,0,0,,Сен сүйкімдісің
Dialogue: 0,0:02:43.03,0:02:46.04,Default,,0,0,0,,Конни сүйкімді, бірақ ол ниндзя ма?
Dialogue: 0,0:02:46.12,0:02:49.12,Default,,0,0,0,,Юшию жас, бірақ тамаша.
Dialogue: 0,0:02:49.21,0:02:53.88,Default,,0,0,0,,Джо Соцу! Танысқаныма қуаныштымын, жас ханым
Dialogue: 0,0:02:53.96,0:02:55.84,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:02:55.92,0:02:57.21,Default,,0,0,0,,Еее хи хи хи хи
Dialogue: 0,0:03:08.85,0:03:11.60,Default,,0,0,0,,Қолыңды қыссаң да, Үлкендерді ұятқа қалдырасың.
Dialogue: 0,0:03:12.06,0:03:13.56,Default,,0,0,0,,Мүмкін оның мақсаты – Эренді жеп қою.
Dialogue: 0,0:03:15.07,0:03:16.57,Default,,0,0,0,,Дахатц!
Dialogue: 0,0:03:17.23,0:03:19.74,Default,,0,0,0,,Не! А? Жау! А?
Dialogue: 0,0:03:20.53,0:03:22.57,Default,,0,0,0,,Мен қазір өлген болармын.
Dialogue: 0,0:03:24.57,0:03:29.87,Default,,0,0,0,,Бабапа, амансың ба? Мұндай адамдар пайдасыз, солай емес пе?
Dialogue: 0,0:03:29.96,0:03:31.33,Default,,0,0,0,,Әсіресе сол аға.
Dialogue: 0,0:03:31.42,0:03:33.42,Default,,0,0,0,,Не болды! Бұл бала...
Dialogue: 0,0:03:35.17,0:03:37.80,Default,,0,0,0,,Бұл менің ұлым Хикару.
Dialogue: 0,0:03:37.92,0:03:40.76,Default,,0,0,0,,Мен қатты толқып тұрмын, мені кешіріңіз.
Dialogue: 0,0:03:41.17,0:03:42.80,Default,,0,0,0,,Танысқаныма қуаныштымын _ Хикару-кун
Dialogue: 0,0:03:44.68,0:03:45.55,Default,,0,0,0,,Фунцуцу
Dialogue: 0,0:03:45.64,0:03:48.14,Default,,0,0,0,,Бұлай әрекет етпе!
Dialogue: 0,0:03:48.27,0:03:50.93,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:03:52.44,0:03:55.94,Default,,0,0,0,,Сабырлы болыңыз, деді Цунаде-сама, солай ма?
Dialogue: 0,0:03:56.27,0:04:01.32,Default,,0,0,0,,Егер ханзада бірдеңе болса, ол халықаралық мәселеге айналар еді.
Dialogue: 0,0:04:22.47,0:04:26.47,Default,,0,0,0,,Бірдеңе дұрыс емес _ Ганата (Цунаде) Ай елінде, Оңтүстік теңіздің арғы жағында Микагаказуки аралы деген жер бар.
Dialogue: 0,0:04:26.55,0:04:29.01,Default,,0,0,0,,Токонацу, мәңгілік жаздың аралы бар.
Dialogue: 0,0:04:29.14,0:04:32.77,Default,,0,0,0,,Ол жерде гүлденген өте бай ел дейді.
Dialogue: 0,0:04:32.85,0:04:34.64,Default,,0,0,0,,Табиғи ресурстарға бай жер.
Dialogue: 0,0:04:34.73,0:04:38.65,Default,,0,0,0,,Туризмнің көрнекті жері - әдемі маржан жағажайы
Dialogue: 0,0:04:38.77,0:04:40.57,Default,,0,0,0,,Қоғамдық құмар ойындары да танымал.
Dialogue: 0,0:04:40.65,0:04:43.15,Default,,0,0,0,,Ниги Тошиджиранурау Бұл жерде адам өте көп сияқты.
Dialogue: 0,0:04:43.28,0:04:45.16,Default,,0,0,0,,Мен де бір рет бардым.
Dialogue: 0,0:04:45.24,0:04:46.99,Default,,0,0,0,,Мен құмар ойындарды ұнатамын.
Dialogue: 0,0:04:47.12,0:04:48.66,Default,,0,0,0,,(Цунаде тамағын тазартады)
Dialogue: 0,0:04:48.78,0:04:50.70,Default,,0,0,0,,Санзоку (бандит) Тория!
Dialogue: 0,0:04:56.75,0:04:58.50,Default,,0,0,0,,Сейя!
Dialogue: 0,0:05:02.84,0:05:04.01,Default,,0,0,0,,Хааааа!
Dialogue: 0,0:05:14.98,0:05:16.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:17.48,0:05:18.81,Default,,0,0,0,,Итецу!
Dialogue: 0,0:05:22.19,0:05:24.28,Default,,0,0,0,,Гейдж Пуншин Дзюцу Учизай Көлеңке Буншин Дзюцу жоқ!
Dialogue: 0,0:05:28.28,0:05:29.57,Default,,0,0,0,,Фаатц
Dialogue: 0,0:05:47.09,0:05:48.43,Default,,0,0,0,,(Шибори үшін енді таңдалған Наку Тайчи
Dialogue: 0,0:05:48.55,0:05:51.76,Default,,0,0,0,,Nmikogogu қабылдау meura, қолында келесі тікен, таңдалған chide жіберіңіз.
Dialogue: 0,0:05:51.89,0:05:54.72,Default,,0,0,0,,Медициналық емдеу нұсқалары
Dialogue: 0,0:05:54.81,0:05:56.77,Default,,0,0,0,,Нанкору Га но Цюки, адам төбесін ұшыру
Dialogue: 0,0:05:56.89,0:05:59.73,Default,,0,0,0,,/2
Dialogue: 0,0:05:59.81,0:06:01.23,Default,,0,0,0,,(
Dialogue: 0,0:06:01.36,0:06:02.86,Default,,0,0,0,,Ноеми
Dialogue: 0,0:06:02.94,0:06:05.07,Default,,0,0,0,,Wackg Со ұзақ уақытқа созылатын сүйікті қоқыстан
Dialogue: 0,0:06:05.19,0:06:06.49,Default,,0,0,0,,Кусуточироки Кугуна /
Dialogue: 0,0:06:06.57,0:06:07.70,Default,,0,0,0,,( (
Dialogue: 0,0:06:07.78,0:06:10.91,Default,,0,0,0,,(
Dialogue: 0,0:06:10.99,0:06:12.70,Default,,0,0,0,,Доми Радан Оку Нара Ге_Гамару 1-сынып
Dialogue: 0,0:06:12.78,0:06:14.87,Default,,0,0,0,,Мылқау кеудеше, оны кесу керек.
Dialogue: 0,0:06:14.95,0:06:16.45,Default,,0,0,0,,Ноширерекогоның Агмирбу /
Dialogue: 0,0:06:16.58,0:06:18.21,Default,,0,0,0,,(Nrumnobluffdav /
Dialogue: 0,0:06:30.89,0:06:31.80,Default,,0,0,0,,Хагукушун
Dialogue: 0,0:06:41.98,0:06:44.27,Default,,0,0,0,,Денкага (Рики Какаши) Айтпақшы, Мәртебелі - Y5 Харириичи.
Dialogue: 0,0:06:44.36,0:06:46.57,Default,,0,0,0,,Болашақта патша мұрагері бола ма?
Dialogue: 0,0:06:46.65,0:06:49.74,Default,,0,0,0,,Әрине, Папава зейнетке шыққаннан кейін.
Dialogue: 0,0:06:49.82,0:06:53.28,Default,,0,0,0,,Бірақ мен әлі де жақсы жүрмін, сондықтан әзірге ештеңе қалмады деп ойлаймын.
Dialogue: 0,0:06:53.78,0:06:56.62,Default,,0,0,0,,Әй, бұл қандай ойын?»
Dialogue: 0,0:06:58.62,0:07:01.17,Default,,0,0,0,,Қызықты ма?
Dialogue: 0,0:07:04.96,0:07:08.84,Default,,0,0,0,,Бұл жігіт менің досым емес.
Dialogue: 0,0:07:10.68,0:07:12.18,Default,,0,0,0,,Кім Хокаге бола алады?
Dialogue: 0,0:07:12.30,0:07:13.93,Default,,0,0,0,,Тұқым қуалайды ма?
Dialogue: 0,0:07:14.01,0:07:16.68,Default,,0,0,0,,Сатоса (Какаши Чикара) Жоқ, менің ауыл бастығым осында ұрпақтан-ұрпаққа келген.
Dialogue: 0,0:07:16.81,0:07:20.85,Default,,0,0,0,,Сенімі берік, келісімді ойлайтындар таңдалады.
Dialogue: 0,0:07:20.98,0:07:24.15,Default,,0,0,0,,Мысалы, бұл бала Нарутоның болашақтағы арманы
Dialogue: 0,0:07:24.23,0:07:26.98,Default,,0,0,0,,Хокаге болу.
Dialogue: 0,0:07:27.11,0:07:28.82,Default,,0,0,0,,Қанша тырыссаң да,
Dialogue: 0,0:07:28.94,0:07:31.49,Default,,0,0,0,,Қандай қиындық көрсең де, төзесің.
Dialogue: 0,0:07:31.57,0:07:33.91,Default,,0,0,0,,Эй, сен кереметсің.
Dialogue: 0,0:07:34.12,0:07:36.99,Default,,0,0,0,,Адамдар мұны әлі де жаттығу деп санайды.
Dialogue: 0,0:07:37.12,0:07:39.37,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:07:39.50,0:07:41.87,Default,,0,0,0,,Сіз ақымақ сияқтысыз, иә?
Dialogue: 0,0:07:44.42,0:07:49.17,Default,,0,0,0,,Сәлем! Сіз нені білдіреді? Сіз нені білдіреді?
Dialogue: 0,0:07:49.67,0:07:52.18,Default,,0,0,0,,Әй, жұрт сөйлеп жатыр...!
Dialogue: 0,0:07:54.97,0:07:57.31,Default,,0,0,0,,Рэй, сен тамаша жауынгер боласың.
Dialogue: 0,0:08:46.35,0:08:47.65,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:00.08,0:09:03.08,Default,,0,0,0,,Енді барлығы келесісін күте алмайды.
Dialogue: 0,0:09:03.20,0:09:07.04,Default,,0,0,0,,Сирек кездесетін қылыш тісті жолбарыспен таныстыру!
Dialogue: 0,0:09:19.89,0:09:21.26,Default,,0,0,0,,Гаоцу!
Dialogue: 0,0:09:27.94,0:09:32.61,Default,,0,0,0,,Қараңызшы, бұл қылыш тісті жолбарыс Чаям!
Dialogue: 0,0:09:33.78,0:09:37.36,Default,,0,0,0,,Ал бұл Чаямның серіктесі Кикки!
Dialogue: 0,0:09:42.08,0:09:44.16,Default,,0,0,0,,(қол шапалақтау және қошемет көрсету)
Dialogue: 0,0:09:44.29,0:09:48.21,Default,,0,0,0,,Осы екі тамаша қойылымды көріңіз!
Dialogue: 0,0:09:53.67,0:09:58.47,Default,,0,0,0,,(қол шапалақтау және қошемет көрсету)
Dialogue: 0,0:10:23.79,0:10:26.16,Default,,0,0,0,,Келесі қадам әлдеқайда қиын болады.
Dialogue: 0,0:10:29.50,0:10:32.50,Default,,0,0,0,,Егер сіз оны алып тастасаңыз, Киккийбаға қиындық туады!
Dialogue: 0,0:10:32.84,0:10:35.51,Default,,0,0,0,,Келіңіздер, көңіл көтерейік! А?
Dialogue: 0,0:10:46.93,0:10:48.31,Default,,0,0,0,,Отсу!
Dialogue: 0,0:10:53.65,0:10:54.94,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:10:55.36,0:10:58.40,Default,,0,0,0,,О! Бұл керемет бала!
Dialogue: 0,0:11:00.91,0:11:03.62,Default,,0,0,0,,Бірақ бұл туралы не деуге болады? Иә!
Dialogue: 0,0:11:07.87,0:11:11.00,Default,,0,0,0,,Ал, балам, сен қалай ойлайсың? Мен мұны істей алсам ше?
Dialogue: 0,0:11:11.08,0:11:13.04,Default,,0,0,0,,Марапат Сыйлық берейік!
Dialogue: 0,0:11:33.65,0:11:34.81,Default,,0,0,0,,Ohtsu!
Dialogue: 0,0:11:34.90,0:11:38.40,Default,,0,0,0,,Ohtsu! Бұл керемет, Хикару!
Dialogue: 0,0:11:44.45,0:11:47.04,Default,,0,0,0,,Ол бала ұзақ ойнайды.
Dialogue: 0,0:11:47.12,0:11:48.08,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:49.20,0:11:52.58,Default,,0,0,0,,Бұл керемет, сіз өте кереметсіз.
Dialogue: 0,0:11:52.67,0:11:54.71,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:11:54.79,0:11:57.67,Default,,0,0,0,,Мен сені бір нәрсемен марапаттауым керек.
Dialogue: 0,0:11:57.75,0:11:59.59,Default,,0,0,0,,Ал, саған не ұнайды?
Dialogue: 0,0:11:59.67,0:12:00.72,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:12:00.80,0:12:01.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:02.68,0:12:05.09,Default,,0,0,0,,А... Жоқ, бұл тым үлкен.
Dialogue: 0,0:12:05.22,0:12:09.93,Default,,0,0,0,,Киёбабоу – жаман адам. Біріншіден, ол маңызды бизнес құралы.
Dialogue: 0,0:12:10.35,0:12:12.14,Default,,0,0,0,,Маған бұл ұнамайды. Ол маған ұнайды.
Dialogue: 0,0:12:12.27,0:12:13.35,Default,,0,0,0,,Сен солай айтсаң да...
Dialogue: 0,0:12:13.44,0:12:14.85,Default,,0,0,0,,Иигошоша? Папаба
Dialogue: 0,0:12:14.94,0:12:19.23,Default,,0,0,0,,Иә, бұл цирк маған да ұнады.
Dialogue: 0,0:12:19.32,0:12:21.86,Default,,0,0,0,,Енді бүкіл циркті Годакадан бастайық!
Dialogue: 0,0:12:21.95,0:12:23.82,Default,,0,0,0,,Эцури!а? Эх...
Dialogue: 0,0:12:27.16,0:12:29.99,Default,,0,0,0,,Аралға келгеннен кейін қолма-қол ақша төлеу дұрыс па?
Dialogue: 0,0:12:42.72,0:12:45.39,Default,,0,0,0,,Ол шынымен цирк сатып алды.
Dialogue: 0,0:12:45.47,0:12:46.55,Default,,0,0,0,,Маджига...
Dialogue: 0,0:12:55.35,0:12:57.19,Default,,0,0,0,,Иә, солай!
Dialogue: 0,0:12:57.31,0:13:01.19,Default,,0,0,0,,Ай елінде спектакль күтуге де үмітім жоқ, жолым болды.
Dialogue: 0,0:13:01.32,0:13:04.74,Default,,0,0,0,,Біз де бар күшімізді саламыз.
Dialogue: 0,0:13:10.70,0:13:11.66,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:13:11.79,0:13:15.67,Default,,0,0,0,,Гаруруру...
Dialogue: 0,0:13:15.75,0:13:16.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:17.88,0:13:19.34,Default,,0,0,0,,Боцу-чан! Ах!!
Dialogue: 0,0:13:19.79,0:13:21.21,Default,,0,0,0,,Гаоцу!
Dialogue: 0,0:13:27.64,0:13:29.14,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:13:29.22,0:13:30.76,Default,,0,0,0,,Боцу-чан Чаям бір
Dialogue: 0,0:13:30.85,0:13:32.60,Default,,0,0,0,,Адамдарға үйрене алмаймын.
Dialogue: 0,0:13:32.68,0:13:34.18,Default,,0,0,0,,Мен әлі де...
Dialogue: 0,0:13:34.31,0:13:37.06,Default,,0,0,0,,Бұл жерден кет! Бұл қауіпті!
Dialogue: 0,0:13:37.19,0:13:39.36,Default,,0,0,0,,Бар... Эй_ Әрине!
Dialogue: 0,0:13:39.44,0:13:42.94,Default,,0,0,0,,Мен оны көпірге салып, ағып кетуді басқарамын, сондықтан иә.
Dialogue: 0,0:13:44.15,0:13:46.40,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:13:52.33,0:13:53.91,Default,,0,0,0,,Эй!?
Dialogue: 0,0:13:54.04,0:13:55.62,Default,,0,0,0,,Ах, чиотсуто...
Dialogue: 0,0:13:57.79,0:14:00.08,Default,,0,0,0,,Тым болмаса рахмет айт!
Dialogue: 0,0:14:20.23,0:14:22.98,Default,,0,0,0,,Желдің әсерінен болса керек.
Dialogue: 0,0:14:23.07,0:14:27.70,Default,,0,0,0,,Икагадан Миказуки аралына баратын кәдімгі қайық әлі келмеген сияқты.
Dialogue: 0,0:14:27.78,0:14:33.03,Default,,0,0,0,,Сондықтан біз мүмкіндігінше тезірек уақытша кеме ұйымдастырамыз. Иә.
Dialogue: 0,0:14:33.12,0:14:36.41,Default,,0,0,0,,Менің де маңызды бір ісім бар деп ойлаймын.
Dialogue: 0,0:14:36.54,0:14:38.66,Default,,0,0,0,,Мүмкіндігінше асығыңыз.
Dialogue: 0,0:14:43.09,0:14:44.88,Default,,0,0,0,,Бабапабабата? иә?
Dialogue: 0,0:14:44.96,0:14:46.38,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:14:46.46,0:14:49.13,Default,,0,0,0,,Бұл Хикарудың анасының орны.
Dialogue: 0,0:14:49.80,0:14:51.18,Default,,0,0,0,,Эцу! Жоқ?
Dialogue: 0,0:15:14.78,0:15:18.00,Default,,0,0,0,,Біраз уақыт өтті, Амайо!
Dialogue: 0,0:15:23.33,0:15:25.71,Default,,0,0,0,,О, жаным!
Dialogue: 0,0:15:27.17,0:15:30.09,Default,,0,0,0,,Хикару Бұл Хикару!
Dialogue: 0,0:15:31.22,0:15:34.14,Default,,0,0,0,,Ах... Хикару!
Dialogue: 0,0:15:34.80,0:15:37.14,Default,,0,0,0,,Ах Хикару...
Dialogue: 0,0:15:37.22,0:15:41.06,Default,,0,0,0,,Иә!?» Бұл Иззу Оссанның әйелі болуы мүмкін бе?
Dialogue: 0,0:15:44.90,0:15:48.15,Default,,0,0,0,,Бұл үлкен соққы, Хикару.
Dialogue: 0,0:15:51.78,0:15:53.32,Default,,0,0,0,,Кім?
Dialogue: 0,0:15:54.07,0:15:57.49,Default,,0,0,0,,Бұл қорқынышты, Амайо, бұл менмін!
Dialogue: 0,0:15:59.33,0:16:01.54,Default,,0,0,0,,Жоқ... Мичиру?
Dialogue: 0,0:16:01.66,0:16:03.08,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:03.17,0:16:07.71,Default,,0,0,0,,Өтірікші, сен мүлде басқа адамсың! Бұл не? Сен семізсің!
Dialogue: 0,0:16:07.84,0:16:10.38,Default,,0,0,0,,Сенің ауырып қалғаның үшін.
Dialogue: 0,0:16:10.51,0:16:13.34,Default,,0,0,0,,Маги Егер сіз мұңды басу үшін тым көп жесеңіз,
Dialogue: 0,0:16:13.43,0:16:15.68,Default,,0,0,0,,Мен мұны түсіндім.
Dialogue: 0,0:16:15.80,0:16:17.43,Default,,0,0,0,,Haah
Dialogue: 0,0:16:19.35,0:16:22.23,Default,,0,0,0,,Маған қайтып келгеніңізді қалаймын.
Dialogue: 0,0:16:22.35,0:16:24.52,Default,,0,0,0,,Мен де жалғызбын, Хикару да...
Dialogue: 0,0:16:24.65,0:16:28.52,Default,,0,0,0,,Бірақ мен сенімен енді араласқым келмейді.
Dialogue: 0,0:16:28.61,0:16:29.65,Default,,0,0,0,,Хикару Даттейчи
Dialogue: 0,0:16:29.73,0:16:34.28,Default,,0,0,0,,Конги Неке шарты болмаса, мен оны қабылдап өсірер едім.
Dialogue: 0,0:16:34.66,0:16:37.95,Default,,0,0,0,,Кира, сен мені неге сонша жек көресің!
Dialogue: 0,0:16:38.03,0:16:42.21,Default,,0,0,0,,Мен саған қалағанның бәрін бердім, солай ма? Әлі де жетпей ме?
Dialogue: 0,0:16:42.29,0:16:44.92,Default,,0,0,0,,Иә, ең бастысы
Dialogue: 0,0:16:45.25,0:16:46.96,Default,,0,0,0,,Эцу! жоқ?
Dialogue: 0,0:16:48.04,0:16:49.96,Default,,0,0,0,,Бұл үлкен сарай! Бұл сарай!
Dialogue: 0,0:16:50.05,0:16:51.76,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:54.30,0:16:56.89,Default,,0,0,0,,Бессо болса, вилла туралы не айтасыз?
Dialogue: 0,0:16:57.01,0:17:00.39,Default,,0,0,0,,Ата-анаңыздың сізбен бірге тұруын сұраңыз.
Dialogue: 0,0:17:00.81,0:17:02.39,Default,,0,0,0,,Тада (үстелді түрту дыбысы)
Dialogue: 0,0:17:07.44,0:17:09.07,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:11.57,0:17:16.20,Default,,0,0,0,,Жаман болма, қайта бірге өмір сүрейік.
Dialogue: 0,0:17:16.28,0:17:18.32,Default,,0,0,0,,Маған не қалайтыныңызды айтыңыз
Dialogue: 0,0:17:18.41,0:17:21.54,Default,,0,0,0,,Тіпті асыл тастар, тіпті қазыналар да...
Dialogue: 0,0:17:21.62,0:17:24.91,Default,,0,0,0,,Дацуко, ай елі, тек сіз үшін!
Dialogue: 0,0:17:26.21,0:17:27.54,Default,,0,0,0,,Ацсу!
Dialogue: 0,0:17:31.71,0:17:34.17,Default,,0,0,0,,Ештеңе өзгермейтін сияқты
Dialogue: 0,0:17:34.26,0:17:39.55,Default,,0,0,0,,Сіз шынымен не маңызды екенін білмейсіз!
Dialogue: 0,0:18:02.29,0:18:07.62,Default,,0,0,0,,Хаа _ Неге деп таң қалдым... Түсінбеймін.
Dialogue: 0,0:18:09.25,0:18:13.13,Default,,0,0,0,,Мичиру мырза, кемені жүзу туралы бізбен кеңесіңіз.
Dialogue: 0,0:18:13.21,0:18:14.51,Default,,0,0,0,,Ничи...
Dialogue: 0,0:18:18.55,0:18:20.47,Default,,0,0,0,,Вакатсу Тадайо
Dialogue: 0,0:18:23.60,0:18:27.60,Default,,0,0,0,,Өйткені, барлық жүкті алып жүру мүмкін емес...
Dialogue: 0,0:18:36.28,0:18:40.20,Default,,0,0,0,,Мен көремін. Ол баланың анасы...
Dialogue: 0,0:18:40.32,0:18:41.37,Default,,0,0,0,,3 жыл бұрын
Dialogue: 0,0:18:41.49,0:18:44.95,Default,,0,0,0,,Мен Изуиссанға ғашық болып қалған сияқтымын, мен шықтым.
Dialogue: 0,0:18:45.04,0:18:47.16,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:18:57.47,0:19:00.01,Default,,0,0,0,,Мен кемеге қараймын.
Dialogue: 0,0:19:00.13,0:19:02.01,Default,,0,0,0,,Сен білмедің бе?
Dialogue: 0,0:19:09.85,0:19:11.90,Default,,0,0,0,,Фааа!
Dialogue: 0,0:19:19.15,0:19:21.20,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:19:21.32,0:19:22.70,Default,,0,0,0,,А?
Dialogue: 0,0:19:24.20,0:19:25.99,Default,,0,0,0,,О, бұл жақсы.
Dialogue: 0,0:19:26.08,0:19:28.79,Default,,0,0,0,,Сіздің талғамыңызға сай келмейді деп ойлаймын.
Dialogue: 0,0:19:38.21,0:19:40.22,Default,,0,0,0,,Менің қызметшім бол.
Dialogue: 0,0:19:40.30,0:19:41.55,Default,,0,0,0,,Не?
Dialogue: 0,0:19:41.63,0:19:45.55,Default,,0,0,0,,Егер мен сенің қызметшің болсам, не қаласаң, соны істейтін едім.
Dialogue: 0,0:19:45.64,0:19:47.52,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:19:48.10,0:19:50.56,Default,,0,0,0,,Бұл ойыншық, бұл ойын
Dialogue: 0,0:19:50.69,0:19:54.19,Default,,0,0,0,,Дұрыс, мен оны саған қашан беремін?
Dialogue: 0,0:19:54.27,0:19:58.98,Default,,0,0,0,,Көрдің бе, мен саған қызметші бола алмаймын!
Dialogue: 0,0:20:00.61,0:20:04.41,Default,,0,0,0,,Адамдарды мазақ етуді доғар!
Dialogue: 0,0:20:18.92,0:20:21.01,Default,,0,0,0,,Мен енді шыдай алмаймын!
Dialogue: 0,0:20:21.09,0:20:25.59,Default,,0,0,0,,Бұл халықаралық мәселе ме, жоқ па бәрібір!
Dialogue: 0,0:20:33.94,0:20:36.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:36.27,0:20:40.07,Default,,0,0,0,,Мен бәрі қалай болса да, Теми қалағандай болады деп ойладым.
Dialogue: 0,0:20:40.15,0:20:42.11,Default,,0,0,0,,Үлкен қате!
Dialogue: 0,0:20:42.19,0:20:46.57,Default,,0,0,0,,Колау Наруто! Сен не істеп жатырсың?
Dialogue: 0,0:20:46.66,0:20:48.45,Default,,0,0,0,,Жоқ, бірақ бұл жігіт...
Dialogue: 0,0:20:48.58,0:20:50.29,Default,,0,0,0,,Ах!!
Dialogue: 0,0:21:10.22,0:21:12.64,Default,,0,0,0,,Ханзада Моцуто Мотоо!
Dialogue: 0,0:21:13.14,0:21:15.06,Default,,0,0,0,,Жақсы сезінемін!
Dialogue: 0,0:21:15.14,0:21:18.52,Default,,0,0,0,,Ұмытпа! Ұмытпа!
Dialogue: 0,0:21:18.98,0:21:22.65,Default,,0,0,0,,Маған ұнамайды! Өйткені орынсыз болса жаман емес!
Dialogue: 0,0:21:22.78,0:21:23.99,Default,,0,0,0,,Бір болса да
Dialogue: 0,0:21:24.07,0:21:27.32,Default,,0,0,0,,Мені жұдырықтай салғаным үшін кешірім сұраңыз.
Dialogue: 0,0:21:27.45,0:21:30.49,Default,,0,0,0,,Маған ұнамайды, ұнамайды, маған ұнамайды! Маған мүлдем ұнамайды!
Dialogue: 0,0:21:30.58,0:21:32.04,Default,,0,0,0,,Мүмкін оның мақсаты – Эренді жеп қою.
Dialogue: 0,0:21:35.00,0:21:37.00,Default,,0,0,0,,Жарайды, мен сені әлі де кешіруім керек.
Dialogue: 0,0:21:37.50,0:21:39.84,Default,,0,0,0,,Ах... Әй, депрессия!
Dialogue: 0,0:22:05.95,0:22:06.99,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:22:12.87,0:22:14.12,Default,,0,0,0,,Хахатцуцу
Dialogue: 0,0:22:24.55,0:22:36.60,Default,,0,0,0,,Гаруруру...
Dialogue: 0,0:22:39.23,0:22:40.77,Default,,0,0,0,,Гаоцу!
Dialogue: 0,0:22:47.74,0:22:49.82,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:22:53.87,0:22:56.25,Default,,0,0,0,,Жаңа ай өтті...
Dialogue: 0,0:23:00.75,0:23:02.25,Default,,0,0,0,,Казе қаға?
Dialogue: 0,0:23:15.76,0:23:17.31,Default,,0,0,0,,
Dialogue: 0,0:23:18.27,0:23:23.44,Default,,0,0,0,,Мәртебелі, палубадағы жүк қауіпті жағдайда тұрған сияқты.
Dialogue: 0,0:23:23.52,0:23:26.28,Default,,0,0,0,,Өтінемін, құтылыңыз.
Dialogue: 0,0:23:26.40,0:23:28.90,Default,,0,0,0,,Сені сыпырып тастаса ысырап болар еді.
Dialogue: 0,0:23:30.15,0:23:32.07,Default,,0,0,0,,Сондықтан мен саған сенемін.
Dialogue: 0,0:23:32.16,0:23:33.62,Default,,0,0,0,,Арнайы жәрдемақы қалай төленеді?
Dialogue: 0,0:23:33.74,0:23:36.74,Default,,0,0,0,,Жәрдемақыдан қиналып жүрген малдарды аяймын.
Dialogue: 0,0:23:36.83,0:23:40.37,Default,,0,0,0,,Олай болса, цирк адамдарымен ынтымақтасайық!
Dialogue: 0,0:23:43.67,0:23:45.04,Default,,0,0,0,,Цуваутсу!
Dialogue: 0,0:23:45.88,0:23:48.34,Default,,0,0,0,,Жүр, кеттік, Наруто.
Dialogue: 0,0:23:48.46,0:23:51.01,Default,,0,0,0,,Itetetete...
Dialogue: 0,0:23:51.51,0:23:54.93,Default,,0,0,0,,Мен көмектесе алмаймын.
Dialogue: 0,0:23:55.01,0:23:57.56,Default,,0,0,0,,Бұл жақсы емес пе? Шынымен емес...
Dialogue: 0,0:23:57.64,0:24:00.52,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:24:00.64,0:24:04.69,Default,,0,0,0,,Мен жануарлардан шаршадым, сондықтан мені жалғыз қалдырыңыз.
Dialogue: 0,0:24:07.48,0:24:10.40,Default,,0,0,0,,Сіз... шындап айтасыз ба?
Dialogue: 0,0:24:10.49,0:24:11.86,Default,,0,0,0,,Не?»
Dialogue: 0,0:24:11.99,0:24:14.32,Default,,0,0,0,,Сыртқа шығу қауіпті болғандықтан...
Dialogue: 0,0:24:15.28,0:24:18.41,Default,,0,0,0,,Сіз шынымен де ең жаман сұмсыз!
Dialogue: 0,0:24:18.49,0:24:20.62,Default,,0,0,0,,Балалар сендер оны мұнда рұқсатсыз әкелдіңдер.
Dialogue: 0,0:24:20.70,0:24:23.92,Default,,0,0,0,,Бірақ сен одан шаршадың, неге оны тастамайсың!
Dialogue: 0,0:24:24.00,0:24:28.25,Default,,0,0,0,,Неге өліп қалмайсыңдар, Оздің үйі шлюха болсын!
Dialogue: 0,0:24:32.84,0:24:36.97,Default,,0,0,0,,Ең болмаса жұдырығымнан жұдырықтай алмаймын.
Dialogue: 0,0:24:37.68,0:24:41.93,Default,,0,0,0,,Жасай бер, тентек, футоныңды басыңа таста!
Dialogue: 0,0:25:05.71,0:25:07.46,Default,,0,0,0,,Мен...
Dialogue: 0,0:25:08.50,0:25:10.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:25:10.80,0:25:12.88,Default,,0,0,0,,Қандай ысырап!
Dialogue: 0,0:25:46.96,0:25:47.96,Default,,0,0,0,,Кики!
Dialogue: 0,0:26:03.02,0:26:06.14,Default,,0,0,0,,Жоқ... енді жоқ...!
Dialogue: 0,0:26:21.78,0:26:24.87,Default,,0,0,0,,Ботшан! Тоқта, Ботчан!
Dialogue: 0,0:26:41.93,0:26:43.01,Default,,0,0,0,,Ол...
Dialogue: 0,0:27:04.33,0:27:05.49,Default,,0,0,0,,Хикару!
Dialogue: 0,0:27:10.67,0:27:12.00,Default,,0,0,0,,Хикару!
Dialogue: 0,0:27:27.35,0:27:28.89,Default,,0,0,0,,Хикару!
Dialogue: 0,0:27:38.28,0:27:40.20,Default,,0,0,0,,Шана жігіт!
Dialogue: 0,0:27:44.95,0:27:46.45,Default,,0,0,0,,Хикару!
Dialogue: 0,0:28:13.48,0:28:14.44,Default,,0,0,0,,О?
Dialogue: 0,0:28:23.07,0:28:25.99,Default,,0,0,0,,О, Боцу-чан! Бұл қауіпті!
Dialogue: 0,0:28:50.77,0:28:52.31,Default,,0,0,0,,Ах... хаба... 1
Dialogue: 0,0:29:01.03,0:29:05.20,Default,,0,0,0,,Бұл өтірік... Анау Чум адамдарға сондай мейірімді.
Dialogue: 0,0:29:05.45,0:29:07.07,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:29:16.96,0:29:20.30,Default,,0,0,0,,Мм... мм...
Dialogue: 0,0:29:21.13,0:29:22.59,Default,,0,0,0,,Кешіріңіз! Эцу...
Dialogue: 0,0:29:22.67,0:29:24.26,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:29:24.34,0:29:28.47,Default,,0,0,0,,Осындай қорқынышты сөздер айтқаным үшін кешірім сұраймын!
Dialogue: 0,0:29:28.55,0:29:30.93,Default,,0,0,0,,Хикару... сен кереметсің
Dialogue: 0,0:29:31.01,0:29:34.52,Default,,0,0,0,,Ол аздап қаншық, бірақ ол әдемі.
Dialogue: 0,0:29:36.48,0:29:39.52,Default,,0,0,0,,Менің ойымша, Кицуто мен Соицу да Хикаруды таныды.
Dialogue: 0,0:29:39.65,0:29:41.69,Default,,0,0,0,,Бұл ұят
Dialogue: 0,0:29:42.73,0:29:44.32,Default,,0,0,0,,I\... 1
Dialogue: 0,0:29:45.99,0:29:47.49,Default,,0,0,0,,Мен де...
Dialogue: 0,0:29:51.33,0:29:53.04,Default,,0,0,0,,Мені де кешіріңіз!
Dialogue: 0,0:29:53.16,0:29:55.16,Default,,0,0,0,,Онии-чанға солай істе
Dialogue: 0,0:29:57.79,0:30:00.88,Default,,0,0,0,,бұған... Кешіріңіз Чиам.
Dialogue: 0,0:30:01.00,0:30:05.05,Default,,0,0,0,,Боцуку Егер серіктесіңізді сіз үшін бірдеңе жасауға мәжбүрлей алмасаңыз, себебі...
Dialogue: 0,0:30:05.17,0:30:09.18,Default,,0,0,0,,Негізі мен жай ғана Ониичиян және Чаяммен дос болғым келді.
Dialogue: 0,0:30:09.30,0:30:12.10,Default,,0,0,0,,Мен барлығы менімен ойнағанын қаладым.
Dialogue: 0,0:30:14.27,0:30:16.85,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:30:17.56,0:30:21.06,Default,,0,0,0,,Бұл не? Бұл туралы.
Dialogue: 0,0:30:21.19,0:30:23.23,Default,,0,0,0,,Достар керемет!
Dialogue: 0,0:30:23.36,0:30:26.36,Default,,0,0,0,,Бұдан былай Иоле екеуің достасыңдар.
Dialogue: 0,0:30:26.86,0:30:28.03,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:30:28.11,0:30:29.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:35.20,0:30:37.54,Default,,0,0,0,,Бұл жігіттер де толқынға айналып барады!
Dialogue: 0,0:30:37.87,0:30:39.17,Default,,0,0,0,,Мен де!
Dialogue: 0,0:30:39.25,0:30:40.88,Default,,0,0,0,,Мен де
Dialogue: 0,0:30:47.22,0:30:48.43,Default,,0,0,0,,Не болды?»
Dialogue: 0,0:30:48.55,0:30:51.43,Default,,0,0,0,,Өйткені аралға біріншісі келді.
Dialogue: 0,0:30:51.55,0:30:55.22,Default,,0,0,0,,Жақында ағаларымызбен қоштасамыз.
Dialogue: 0,0:30:55.56,0:30:57.48,Default,,0,0,0,,...
Dialogue: 0,0:30:59.64,0:31:01.06,Default,,0,0,0,,Онда бұл уәде!
Dialogue: 0,0:31:01.19,0:31:02.23,Default,,0,0,0,,Не?
Dialogue: 0,0:31:02.31,0:31:04.98,Default,,0,0,0,,Мен сенімен достасамын деп уәде беремін!
Dialogue: 0,0:31:05.57,0:31:07.61,Default,,0,0,0,,Мен сені ұмытпаймын
Dialogue: 0,0:31:07.74,0:31:11.87,Default,,0,0,0,,Бізді әрқашан есте сақтаңыз.
Dialogue: 0,0:31:16.50,0:31:17.91,Default,,0,0,0,,Цун!
Dialogue: 0,0:31:20.79,0:31:23.09,Default,,0,0,0,,Чийотсуцутто! Тек екі адам?
Dialogue: 0,0:31:23.17,0:31:25.13,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:31:29.93,0:31:33.85,Default,,0,0,0,,Барлығымыздың достарымыз бар!
Dialogue: 0,0:31:34.10,0:31:35.22,Default,,0,0,0,,Взвод командирі, тіпті біз Әйел Титанын қолға түсірсек те,
Dialogue: 0,0:31:35.31,0:31:36.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:36.47,0:31:37.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:31:38.60,0:31:40.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:44.52,0:31:48.11,Default,,0,0,0,,Хахаха...!
Dialogue: 0,0:31:48.24,0:31:52.45,Default,,0,0,0,,Хахаха...!
Dialogue: 0,0:32:28.19,0:32:29.69,Default,,0,0,0,,Жақсы, көріскенше.
Dialogue: 0,0:32:29.82,0:32:32.45,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:32:32.53,0:32:33.99,Default,,0,0,0,,Секір!!
Dialogue: 0,0:32:46.25,0:32:49.75,Default,,0,0,0,,Табиғатпен қоршалған бай арал
Dialogue: 0,0:32:50.80,0:32:55.18,Default,,0,0,0,,Әдемі маржан жағажайының алдында
Dialogue: 0,0:32:55.26,0:32:59.18,Default,,0,0,0,,Күннің батып бара жатқанын көріп тосттар жасағаннан кейін...
Dialogue: 0,0:33:02.52,0:33:05.81,Default,,0,0,0,,Миказуки казиносына келіңіз!
Dialogue: 0,0:33:05.90,0:33:08.86,Default,,0,0,0,,Бұл біртүрлі. Бұл көше өте ерекше.
Dialogue: 0,0:33:08.98,0:33:11.49,Default,,0,0,0,,Ол жанды болуы керек.
Dialogue: 0,0:33:11.57,0:33:14.11,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:33:44.60,0:33:46.60,Default,,0,0,0,,Менімен амандасатын ешкім жоқ...
Dialogue: 0,0:33:50.27,0:33:52.78,Default,,0,0,0,,Әй, Шаяя Бадаба!
Dialogue: 0,0:33:52.90,0:33:55.15,Default,,0,0,0,,Мынау, Мичиру-доно.
Dialogue: 0,0:33:55.24,0:33:58.74,Default,,0,0,0,,Елдер бойынша саяхатыңыздағы қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:33:59.12,0:34:01.91,Default,,0,0,0,,Хикару-доно да қауіпсіз деп үміттенемін.
Dialogue: 0,0:34:02.04,0:34:04.75,Default,,0,0,0,,Цун рахмет Сиябадаба
Dialogue: 0,0:34:04.83,0:34:08.75,Default,,0,0,0,,Бұдан басқа, қалада біртүрлі нәрсе болып жатыр. Бірдеңе дұрыс емес екенін тексере аласыз ба?
Dialogue: 0,0:34:12.30,0:34:13.63,Default,,0,0,0,,Шайабадаба...
Dialogue: 0,0:34:19.18,0:34:22.60,Default,,0,0,0,,Әке қайда? Мен Ютаканы көре алмайтын сияқтымын.
Dialogue: 0,0:34:24.10,0:34:26.14,Default,,0,0,0,,Патша...
Dialogue: 0,0:34:26.69,0:34:28.02,Default,,0,0,0,,Өлді!
Dialogue: 0,0:34:28.44,0:34:29.40,Default,,0,0,0,,Эцу! жоқ?
Dialogue: 0,0:34:33.61,0:34:35.78,Default,,0,0,0,,Атсу!
Dialogue: 0,0:34:37.24,0:34:40.49,Default,,0,0,0,,Бұдан былай мен патшалық мұрагер боламын.
Dialogue: 0,0:34:40.62,0:34:43.95,Default,,0,0,0,,Сондықтан Кисама ханзада Джаяма.
Dialogue: 0,0:34:46.08,0:34:48.46,Default,,0,0,0,,Өлтір!
Dialogue: 0,0:34:48.71,0:34:50.58,Default,,0,0,0,,Нарутори! Сакурари! Ли!
Dialogue: 0,0:34:53.75,0:34:55.46,Default,,0,0,0,,Хаа!!
Dialogue: 0,0:34:56.38,0:34:58.05,Default,,0,0,0,,Хибяттар!
Dialogue: 0,0:34:58.13,0:34:59.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:02.30,0:35:05.02,Default,,0,0,0,,Мәртебелі, Хикару-кун! Вагон ішінде!
Dialogue: 0,0:35:12.23,0:35:13.61,Default,,0,0,0,,Шығар!
Dialogue: 0,0:35:19.99,0:35:21.49,Default,,0,0,0,,Мені сүйреп апарыңыз!
Dialogue: 0,0:35:29.87,0:35:32.83,Default,,0,0,0,,Егер солай болса, Кирига жоқ!
Dialogue: 0,0:35:34.50,0:35:36.13,Default,,0,0,0,,Жаңадан бастаушы
Dialogue: 0,0:35:37.55,0:35:40.34,Default,,0,0,0,,Уау!!
Dialogue: 0,0:35:43.43,0:35:44.76,Default,,0,0,0,,Колега?!
Dialogue: 0,0:35:44.85,0:35:46.85,Default,,0,0,0,,Капитан Корега!
Dialogue: 0,0:35:47.39,0:35:48.93,Default,,0,0,0,,Ол жігіт сатқын!
Dialogue: 0,0:35:49.02,0:35:51.14,Default,,0,0,0,,Оны түсіріңіз! Түсіріңіз!
Dialogue: 0,0:35:51.23,0:35:52.44,Default,,0,0,0,,Қандай ақымақтық!
Dialogue: 0,0:35:52.73,0:35:54.69,Default,,0,0,0,,Мен қатты күйзелдім!
Dialogue: 0,0:35:54.81,0:35:56.52,Default,,0,0,0,,Оян!
Dialogue: 0,0:35:58.03,0:36:00.28,Default,,0,0,0,,Генкё, министр кінәлі!
Dialogue: 0,0:36:02.99,0:36:05.91,Default,,0,0,0,,Достар арасындағы мағынасыз...
Dialogue: 0,0:36:06.12,0:36:07.45,Default,,0,0,0,,Сәлем Цури! Отцу!?
Dialogue: 0,0:36:08.16,0:36:11.04,Default,,0,0,0,,Кешіріңіз! Сен ше?
Dialogue: 0,0:36:11.12,0:36:13.67,Default,,0,0,0,,Конохада, мен еріп жүруге келісім-шартқа отырдым.
Dialogue: 0,0:36:13.75,0:36:16.04,Default,,0,0,0,,О, бұл сендіреді!
Dialogue: 0,0:36:16.13,0:36:18.05,Default,,0,0,0,,Қалай болғанда да, бұл жер
Dialogue: 0,0:36:18.13,0:36:19.34,Default,,0,0,0,,Арба сұраңыз
Dialogue: 0,0:36:19.42,0:36:20.42,Default,,0,0,0,,Вакатсу Тадата!
Dialogue: 0,0:36:22.59,0:36:23.80,Default,,0,0,0,,Хаацу!
Dialogue: 0,0:36:24.97,0:36:27.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:38.19,0:36:41.11,Default,,0,0,0,,Иә? Ол адамдар кімдер?
Dialogue: 0,0:36:47.08,0:36:48.54,Default,,0,0,0,,Хо...
Dialogue: 0,0:36:48.62,0:36:50.83,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:36:50.91,0:36:52.79,Default,,0,0,0,,Күннің ортасында мұны жасамаңыз
Dialogue: 0,0:36:53.75,0:36:56.08,Default,,0,0,0,,Балалар сендер маған көмектесіп жатырсыңдар!
Dialogue: 0,0:36:56.21,0:36:58.71,Default,,0,0,0,,Жағдайды алдын ала айта алмағаным үшін кешіріңіз!
Dialogue: 0,0:36:58.80,0:36:59.92,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:37:00.00,0:37:03.43,Default,,0,0,0,,Біздің достарымыз тауда. Онда барайық!
Dialogue: 0,0:37:08.26,0:37:11.47,Default,,0,0,0,,Сонда да ешкім жоқ.
Dialogue: 0,0:37:11.60,0:37:15.85,Default,,0,0,0,,Қызық, ай елі осындай ма?
Dialogue: 0,0:37:20.19,0:37:23.78,Default,,0,0,0,,Бұл жоғары мәртебелі арба...
Dialogue: 0,0:37:40.30,0:37:41.38,Default,,0,0,0,,Әке!
Dialogue: 0,0:37:41.46,0:37:42.63,Default,,0,0,0,,Құрметті Джиджи!
Dialogue: 0,0:37:42.71,0:37:45.30,Default,,0,0,0,,Папа Бабапа! Джижи-сама!
Dialogue: 0,0:37:46.01,0:37:48.72,Default,,0,0,0,,Бұл Цзи мырза патша ма?
Dialogue: 0,0:37:51.31,0:37:53.77,Default,,0,0,0,,Болашақ ұлттық саясатқа қатысты
Dialogue: 0,0:37:53.85,0:37:57.23,Default,,0,0,0,,Бас министр Шабадаба және көптеген министрлер мен патша болды
Dialogue: 0,0:37:57.31,0:38:00.52,Default,,0,0,0,,Соқтығысқанымызға көп уақыт болды.
Dialogue: 0,0:38:00.65,0:38:03.82,Default,,0,0,0,,Сонда да патша бір күні түсінетін шығар деп үміттенді.
Dialogue: 0,0:38:03.94,0:38:07.66,Default,,0,0,0,,Олар болады деп күтілген болатын
Dialogue: 0,0:38:07.78,0:38:11.74,Default,,0,0,0,,_
Dialogue: 0,0:38:11.83,0:38:16.46,Default,,0,0,0,,Бақытымызға орай, біз мұны алдын ала түсініп, патшаға кеңес бердік.
Dialogue: 0,0:38:16.54,0:38:20.67,Default,,0,0,0,,Ақыры патша өз министрлерімен не істеу керектігін шешті.
Dialogue: 0,0:38:20.75,0:38:24.55,Default,,0,0,0,,Мен жоғары мәртебелі Мичиру мен Хикаруды бірге аламын.
Dialogue: 0,0:38:24.67,0:38:29.72,Default,,0,0,0,,Мені әртүрлі елдерге барамын деген сылтаумен шетелге жіберді.
Dialogue: 0,0:38:30.01,0:38:31.85,Default,,0,0,0,,біздің орнымыз ба?
Dialogue: 0,0:38:32.35,0:38:36.18,Default,,0,0,0,,Сондықтан... бұл...
Dialogue: 0,0:38:36.31,0:38:40.69,Default,,0,0,0,,Осы арада патша мәселені шешуді көздеді.
Dialogue: 0,0:38:40.77,0:38:42.36,Default,,0,0,0,,Дегенмен, министрлер
Dialogue: 0,0:38:42.44,0:38:47.82,Default,,0,0,0,,Ренобизоку қазіргі ниндзя тайпаларын әкеліп, олардың билігін арттырды.
Dialogue: 0,0:38:47.90,0:38:53.49,Default,,0,0,0,,Күтпеген қарсы шабуыл біздің шегінуге себеп болды.
Dialogue: 0,0:38:53.58,0:38:56.58,Default,,0,0,0,,Бірақ сол кезде патша...
Dialogue: 0,0:38:59.29,0:39:01.42,Default,,0,0,0,,Құрметті Джиджи...
Dialogue: 0,0:39:03.38,0:39:05.46,Default,,0,0,0,,Маған аздап көрсетіңізші.
Dialogue: 0,0:39:07.63,0:39:08.63,Default,,0,0,0,,Ацуши!
Dialogue: 0,0:39:12.26,0:39:15.27,Default,,0,0,0,,Секика Бұл... тасқа айналу!?
Dialogue: 0,0:39:15.39,0:39:20.90,Default,,0,0,0,,Кейбір жау ниндзялары арнайы әдістерді қолданатын көрінеді.
Dialogue: 0,0:39:21.02,0:39:22.90,Default,,0,0,0,,Кенет патша біреу болды
Dialogue: 0,0:39:23.02,0:39:25.44,Default,,0,0,0,,У улы азу тістерінде ұсталады...!
Dialogue: 0,0:39:27.49,0:39:28.44,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:39:28.57,0:39:31.07,Default,,0,0,0,,Мен мұны бәрібір істеймін
Dialogue: 0,0:39:41.88,0:39:46.30,Default,,0,0,0,,Олардың қашып кетуіне қалай дәтің бар!
Dialogue: 0,0:39:46.42,0:39:48.63,Default,,0,0,0,,Боқ, боқ, боқ!
Dialogue: 0,0:39:49.26,0:39:52.39,Default,,0,0,0,,Бұл балалар өте жақсы.
Dialogue: 0,0:39:52.47,0:39:55.10,Default,,0,0,0,,Догоцунда Ишидате!
Dialogue: 0,0:39:55.22,0:39:56.93,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:39:57.06,0:40:00.44,Default,,0,0,0,,Мықтымыз десек те, бізге жау жоқ.
Dialogue: 0,0:40:00.52,0:40:02.35,Default,,0,0,0,,Мен сенен тез құтыламын
Dialogue: 0,0:40:02.60,0:40:05.27,Default,,0,0,0,,Әрине, мен бәріңді сол үшін жіберемін.
Dialogue: 0,0:40:05.36,0:40:08.94,Default,,0,0,0,,Мен сені жоғары жалақыға қабылдаймын!
Dialogue: 0,0:40:09.28,0:40:10.78,Default,,0,0,0,,Хун
Dialogue: 0,0:40:13.45,0:40:14.78,Default,,0,0,0,,Сіз қалай ойлайсыз? Сакура
Dialogue: 0,0:40:14.91,0:40:17.70,Default,,0,0,0,,Петрификацияны жоюда ешқандай проблема жоқ.
Dialogue: 0,0:40:17.79,0:40:21.25,Default,,0,0,0,,Егер ұрыс кезінде сізге шабуыл жасалса немесе соққыға жығылса,
Dialogue: 0,0:40:21.33,0:40:22.96,Default,,0,0,0,,Зугунимен емдеу...
Dialogue: 0,0:40:23.04,0:40:25.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:40:25.25,0:40:29.80,Default,,0,0,0,,Және патша Нанго де Гохайчи
Dialogue: 0,0:40:29.88,0:40:33.09,Default,,0,0,0,,Көңіл-күйі түсіп кеткен шығар...
Dialogue: 0,0:40:38.56,0:40:41.10,Default,,0,0,0,,Мичиру...
Dialogue: 0,0:40:41.18,0:40:42.56,Default,,0,0,0,,Паба-ба-па!
Dialogue: 0,0:40:42.64,0:40:43.94,Default,,0,0,0,,Құрметті Джиджи!
Dialogue: 0,0:40:44.02,0:40:45.19,Default,,0,0,0,,Патша!
Dialogue: 0,0:40:45.31,0:40:49.48,Default,,0,0,0,,Хикару да жақсы болды.
Dialogue: 0,0:40:50.99,0:40:56.66,Default,,0,0,0,,Осыдан кейін мен Мичиру мен Хикаруды көрдім.
Dialogue: 0,0:40:57.53,0:41:00.58,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:41:01.41,0:41:05.58,Default,,0,0,0,,Сонымен, сіз қалай ойлайсыз? Елдің жағдайы қалай?
Dialogue: 0,0:41:05.67,0:41:08.96,Default,,0,0,0,,Кешіріңіз, егер бәрі осылай жалғаса берсе, ақыр соңында
Dialogue: 0,0:41:09.05,0:41:12.01,Default,,0,0,0,,Көтерілісшілердің қолында...
Dialogue: 0,0:41:12.13,0:41:14.93,Default,,0,0,0,,көремін.
Dialogue: 0,0:41:16.01,0:41:21.18,Default,,0,0,0,,Мичиру, қазір бұл ел туралы не ойлайсың?
Dialogue: 0,0:41:21.72,0:41:27.44,Default,,0,0,0,,Бұл бай, әдемі, тамаша ел емес пе?
Dialogue: 0,0:41:27.52,0:41:33.74,Default,,0,0,0,,Бірақ бай болу мені бақытты етпейді деп ойлаймын.
Dialogue: 0,0:41:34.03,0:41:35.36,Default,,0,0,0,,Эцу?»
Dialogue: 0,0:41:38.12,0:41:41.79,Default,,0,0,0,,күлімсіреу қуаныш
Dialogue: 0,0:41:41.87,0:41:45.16,Default,,0,0,0,,Үміт пен арман
Dialogue: 0,0:41:46.37,0:41:52.26,Default,,0,0,0,,Жарайды, мен ынтымақ пен мейірімге толы елді мақсат еттім, бірақ...
Dialogue: 0,0:41:52.38,0:41:56.05,Default,,0,0,0,,Досым деп ойлаған Шабадабаға,
Dialogue: 0,0:41:56.18,0:42:00.60,Default,,0,0,0,,Мені түсіне алмағаныңыз үшін кешіріңіз.
Dialogue: 0,0:42:01.43,0:42:04.39,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды да білмеймін.
Dialogue: 0,0:42:04.52,0:42:06.98,Default,,0,0,0,,Бұл дәл Амайо сияқты.
Dialogue: 0,0:42:07.06,0:42:10.06,Default,,0,0,0,,Біз қалай таныстық? Біз қалай таныстық?
Dialogue: 0,0:42:13.65,0:42:15.36,Default,,0,0,0,,Солай болғай.
Dialogue: 0,0:42:15.45,0:42:18.91,Default,,0,0,0,,Маған маңызды нәрсені түсіне алмайтынымды жиі айтатын.
Dialogue: 0,0:42:18.99,0:42:23.16,Default,,0,0,0,,Бұрынғыдай өткір _ Ол
Dialogue: 0,0:42:23.24,0:42:26.58,Default,,0,0,0,,Бұл Амайоның бөкселеріне жатқызылғанша.
Dialogue: 0,0:42:26.71,0:42:30.46,Default,,0,0,0,,Мен бұл сізге сәйкес келеді деп ойладым, бірақ...
Dialogue: 0,0:42:30.59,0:42:36.76,Default,,0,0,0,,Сен бірінші болып мейіріміңді көрсетеді деп ойламаппын... Ұят болды.
Dialogue: 0,0:42:39.51,0:42:44.52,Default,,0,0,0,,Солай ма? Маңызды ма?
Dialogue: 0,0:42:52.27,0:42:54.15,Default,,0,0,0,,Мичиру
Dialogue: 0,0:42:54.28,0:42:55.78,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:42:56.15,0:42:59.66,Default,,0,0,0,,Соңында... Мені тыңда.
Dialogue: 0,0:43:00.03,0:43:01.45,Default,,0,0,0,,Не?»
Dialogue: 0,0:43:02.33,0:43:07.46,Default,,0,0,0,,Құрметті Джижи! (Патша) Бұл да маңызды...
Dialogue: 0,0:43:07.54,0:43:10.96,Default,,0,0,0,,Бұл жағдайда айтатын жалғыз нәрсе
Dialogue: 0,0:43:11.08,0:43:14.13,Default,,0,0,0,,Кучио: Мұны айтқаным үшін кешіріңіз, бірақ...
Dialogue: 0,0:43:14.25,0:43:15.55,Default,,0,0,0,,Әке!
Dialogue: 0,0:43:15.63,0:43:19.13,Default,,0,0,0,,Сіз патшаның мұрагері боласыз.
Dialogue: 0,0:43:19.80,0:43:21.14,Default,,0,0,0,,Цуууутцу...
Dialogue: 0,0:43:27.39,0:43:29.23,Default,,0,0,0,,Күзетшілер
Dialogue: 0,0:43:32.11,0:43:33.56,Default,,0,0,0,,Иә
Dialogue: 0,0:43:33.82,0:43:38.19,Default,,0,0,0,,Мен бұл аздап созылғанын білемін, бірақ
Dialogue: 0,0:43:38.32,0:43:43.87,Default,,0,0,0,,Бұл менің соңғы тілегім...
Dialogue: 0,0:43:43.99,0:43:45.66,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:43:45.74,0:43:50.50,Default,,0,0,0,,Осы екеуін қорғаңыз...
Dialogue: 0,0:43:50.62,0:43:53.84,Default,,0,0,0,,Өмірің қымбат болса да,
Dialogue: 0,0:43:56.50,0:43:59.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:44:00.42,0:44:04.76,Default,,0,0,0,,Мичиру... Мен оны сұрадым.
Dialogue: 0,0:44:23.36,0:44:27.91,Default,,0,0,0,,Папа!!
Dialogue: 0,0:44:35.79,0:44:39.88,Default,,0,0,0,,Джиги-сама маған әрқашан мейірімді болды.
Dialogue: 0,0:44:40.01,0:44:42.63,Default,,0,0,0,,Мен де осы садақ пен жебені жасау үшін көп еңбек еттім.
Dialogue: 0,0:44:42.72,0:44:46.89,Default,,0,0,0,,Қатты жаттығу жасап, нысананың ортасына тигізу.
Dialogue: 0,0:44:47.01,0:44:49.64,Default,,0,0,0,,Қуанып қалдым.
Dialogue: 0,0:44:51.23,0:44:53.73,Default,,0,0,0,,Мен сені қатты жақсы көремін...
Dialogue: 0,0:44:56.02,0:45:00.69,Default,,0,0,0,,Хикару қарттың айтқанына өкіне ме?
Dialogue: 0,0:45:05.28,0:45:09.66,Default,,0,0,0,,Мен оны қалай да түсінемін.
Dialogue: 0,0:45:09.74,0:45:12.41,Default,,0,0,0,,Менің ойымша, бұл жер туралы.
Dialogue: 0,0:45:16.79,0:45:19.17,Default,,0,0,0,,Мен де, өлген Хокаге Джидотцу-чан.
Dialogue: 0,0:45:19.25,0:45:21.76,Default,,0,0,0,,Ол маған жан-жақты қамқорлық жасады.
Dialogue: 0,0:45:21.88,0:45:26.34,Default,,0,0,0,,Бірақ ауыл, ауылдың бәрі, ал бір адам ортада.
Dialogue: 0,0:45:26.43,0:45:29.43,Default,,0,0,0,,Мен үшін маңызды нәрсені қашан қалдырасың?
Dialogue: 0,0:45:29.56,0:45:32.89,Default,,0,0,0,,Әу бастан мен міндетті түрде Хокаге боламын.
Dialogue: 0,0:45:32.98,0:45:36.10,Default,,0,0,0,,Мен оны осылай ұстауға тырысамын.
Dialogue: 0,0:45:36.19,0:45:39.61,Default,,0,0,0,,Сол асыл затты атаң да бағып-қағады.
Dialogue: 0,0:45:39.73,0:45:44.99,Default,,0,0,0,,Сізді және әкеңізді біреудің қорғағанын қаламайсыз ба?
Dialogue: 0,0:45:45.74,0:45:49.95,Default,,0,0,0,,Маңызды нәрсені қорғаңыз...?
Dialogue: 0,0:46:00.29,0:46:03.05,Default,,0,0,0,,Мен сияқты біреу мұны істей ала ма?
Dialogue: 0,0:46:03.13,0:46:06.18,Default,,0,0,0,,Сіз мұны істей аласыз! Сіз жасай аласыз!
Dialogue: 0,0:46:06.30,0:46:07.72,Default,,0,0,0,,Годе...
Dialogue: 0,0:46:13.85,0:46:17.60,Default,,0,0,0,,Ей, бір күні Хокаге мен Кинг болып қалсақ ше?
Dialogue: 0,0:46:17.69,0:46:19.52,Default,,0,0,0,,Барлық елдермен дос болайық!
Dialogue: 0,0:46:19.65,0:46:20.69,Default,,0,0,0,,Не?
Dialogue: 0,0:46:20.82,0:46:22.82,Default,,0,0,0,,Сонгомен қиындық туындаса ше?
Dialogue: 0,0:46:22.94,0:46:29.37,Default,,0,0,0,,Мен ұшып барамын және сізге кез келген уақытта көмектесемін, сондықтан сіз де маған көмектесе аласыз.
Dialogue: 0,0:46:34.33,0:46:35.62,Default,,0,0,0,,Жаз!
Dialogue: 0,0:46:37.04,0:46:38.04,Default,,0,0,0,,Цун!
Dialogue: 0,0:46:38.37,0:46:40.50,Default,,0,0,0,,Онда бұл уәде!
Dialogue: 0,0:46:46.38,0:46:50.43,Default,,0,0,0,,Біз әрқашан дос боламыз.
Dialogue: 0,0:46:51.68,0:46:54.02,Default,,0,0,0,,Қашанға дейін...
Dialogue: 0,0:46:57.18,0:46:59.44,Default,,0,0,0,,Біздің күшіміз аз.
Dialogue: 0,0:46:59.52,0:47:02.86,Default,,0,0,0,,Министрдің жағына шабуыл жасау үшін тым аз.
Dialogue: 0,0:47:02.98,0:47:07.65,Default,,0,0,0,,Әзірге мен Король мен Хикарудан шетелге эвакуациялауды сұраймын.
Dialogue: 0,0:47:07.74,0:47:13.70,Default,,0,0,0,,Шетелдегі одақтастармен байланысып, олардың күштерін дайындаған дұрыс па?
Dialogue: 0,0:47:26.21,0:47:27.72,Default,,0,0,0,,Мадакагака!?
Dialogue: 0,0:47:30.93,0:47:32.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:36.10,0:47:37.81,Default,,0,0,0,,Капитан Корега!
Dialogue: 0,0:47:38.23,0:47:40.60,Default,,0,0,0,,шығанақтың сыртында Фунаваны күтіп тұрған жер бар.
Dialogue: 0,0:47:40.73,0:47:43.23,Default,,0,0,0,,Цуму Бұл көп еңбек болды.
Dialogue: 0,0:47:45.61,0:47:46.73,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:47:51.24,0:47:52.66,Default,,0,0,0,,Атсуши!
Dialogue: 0,0:47:54.24,0:47:57.83,Default,,0,0,0,,Әке! Барайық!
Dialogue: 0,0:48:12.76,0:48:15.39,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:48:16.60,0:48:17.93,Default,,0,0,0,,Бірінші!
Dialogue: 0,0:48:22.10,0:48:23.94,Default,,0,0,0,,Әй, тұр да, қош айт!
Dialogue: 0,0:48:24.23,0:48:27.57,Default,,0,0,0,,Мен солай істейтінмін!
Dialogue: 0,0:48:45.46,0:48:48.13,Default,,0,0,0,,Ақымақ болмаңдар, балалар
Dialogue: 0,0:48:48.21,0:48:51.05,Default,,0,0,0,,Жағалауда қырағы көз бар.
Dialogue: 0,0:48:51.13,0:48:54.97,Default,,0,0,0,,Сондай-ақ Кисама және басқалардың кемені реттегені анықталды.
Dialogue: 0,0:48:55.85,0:48:59.68,Default,,0,0,0,,А-а... Маған анау жігітті де, анауны да берейін.
Dialogue: 0,0:49:01.64,0:49:04.15,Default,,0,0,0,,Ақымақ болма! Оны саған кім беретінін қараңыз!
Dialogue: 0,0:49:04.85,0:49:05.94,Default,,0,0,0,,Көтеріңіз...
Dialogue: 0,0:49:06.90,0:49:09.48,Default,,0,0,0,,Исей, Козо жақсы жүр, балақай.
Dialogue: 0,0:49:20.79,0:49:22.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:49:23.12,0:49:25.83,Default,,0,0,0,,Сіз қайда көздеп отырсыз!!
Dialogue: 0,0:49:26.67,0:49:29.04,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:49:29.80,0:49:30.92,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:49:31.01,0:49:32.38,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:49:53.49,0:49:55.24,Default,,0,0,0,,Кисама!
Dialogue: 0,0:49:59.16,0:50:01.24,Default,,0,0,0,,Сәлем! Ли мырза!
Dialogue: 0,0:50:01.37,0:50:04.25,Default,,0,0,0,,Танысқаныма қуаныштымын, Наруто-кун!
Dialogue: 0,0:50:08.08,0:50:10.96,Default,,0,0,0,,Антада да... өл!
Dialogue: 0,0:50:15.93,0:50:19.43,Default,,0,0,0,,Коноханың Шиноби... Мен өсек естідім.
Dialogue: 0,0:50:19.55,0:50:22.39,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:50:22.97,0:50:24.48,Default,,0,0,0,,Сіз бірден түсінесіз
Dialogue: 0,0:50:24.56,0:50:25.89,Default,,0,0,0,,Иә
Dialogue: 0,0:50:42.74,0:50:43.79,Default,,0,0,0,,7 2
Dialogue: 0,0:50:51.00,0:50:52.42,Default,,0,0,0,,〆 I/ /
Dialogue: 0,0:50:54.42,0:50:55.97,Default,,0,0,0,,Мигуншин но Хино...
Dialogue: 0,0:50:59.39,0:51:01.68,Default,,0,0,0,,Түсті "'кигуно..." барлығы 7 Gowasen сору
Dialogue: 0,0:51:06.35,0:51:08.85,Default,,0,0,0,,Рунтонгунго қылыш 7/ 2
Dialogue: 0,0:51:09.73,0:51:12.57,Default,,0,0,0,,Innodometsu 7 шамамен.
Dialogue: 0,0:51:13.32,0:51:14.44,Default,,0,0,0,,Гай шешімі!
Dialogue: 0,0:51:14.53,0:51:15.36,Default,,0,0,0,,Футсу!
Dialogue: 0,0:51:20.49,0:51:21.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:23.74,0:51:26.79,Default,,0,0,0,,Бұл пайдасыз... Бұл генджуцу емес.
Dialogue: 0,0:51:27.41,0:51:30.00,Default,,0,0,0,,Дұрыс! Сатсукидің жарылғыш картасы.
Dialogue: 0,0:51:30.62,0:51:33.46,Default,,0,0,0,,Улы, иіссіз улы тұман.
Dialogue: 0,0:51:33.54,0:51:36.21,Default,,0,0,0,,Соны тартсаң, бес сезім мүшелерің бұзылады.
Dialogue: 0,0:51:36.71,0:51:39.97,Default,,0,0,0,,Мен Лебаракуда қанағаттанарлықтай күресе алмаймын!
Dialogue: 0,0:51:47.68,0:51:52.15,Default,,0,0,0,,Бұл кімнің жоғары тұрғаны үшін тартыс сияқты.
Dialogue: 0,0:52:03.20,0:52:05.87,Default,,0,0,0,,Мен сенің серіктесің боламын!
Dialogue: 0,0:52:08.25,0:52:11.75,Default,,0,0,0,,Катаки бұрынғы патша Будда!
Dialogue: 0,0:52:16.13,0:52:18.71,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:52:21.09,0:52:22.51,Default,,0,0,0,,Нуууу!
Dialogue: 0,0:52:22.72,0:52:26.43,Default,,0,0,0,,Сәлем! Маған көмектесші!
Dialogue: 0,0:52:28.06,0:52:29.35,Default,,0,0,0,,Мичиру-доно!
Dialogue: 0,0:52:39.90,0:52:41.03,Default,,0,0,0,,Корега мырза!
Dialogue: 0,0:52:42.03,0:52:44.03,Default,,0,0,0,,Ах! Капитан!
Dialogue: 0,0:52:49.87,0:52:53.87,Default,,0,0,0,,Хмм... Бұл өте өрнек.
Dialogue: 0,0:52:55.79,0:52:57.88,Default,,0,0,0,,өнер деп атауға лайық
Dialogue: 0,0:52:59.88,0:53:02.30,Default,,0,0,0,,Бірақ бұл сәтсіздік.
Dialogue: 0,0:53:08.43,0:53:10.22,Default,,0,0,0,,Капитан Ичи!!
Dialogue: 0,0:53:13.89,0:53:15.90,Default,,0,0,0,,Киссамер!
Dialogue: 0,0:53:33.91,0:53:36.17,Default,,0,0,0,,Фуфуфуфуцу...
Dialogue: 0,0:53:40.42,0:53:44.59,Default,,0,0,0,,Мен бұл сәл қызықтырақ болар деп үміттендім.
Dialogue: 0,0:53:44.72,0:53:46.59,Default,,0,0,0,,Аяқтау уақыты келді ме?
Dialogue: 0,0:53:47.64,0:53:49.01,Default,,0,0,0,,Минерва біз үшін осындай қауіпсіз орын дайындап қойған еді
Dialogue: 0,0:53:50.22,0:53:51.52,Default,,0,0,0,,Бала!
Dialogue: 0,0:53:53.98,0:53:56.31,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:54:08.87,0:54:11.41,Default,,0,0,0,,Цуу!!
Dialogue: 0,0:54:22.05,0:54:22.96,Default,,0,0,0,,Конго!
Dialogue: 0,0:54:51.78,0:54:53.33,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:54:57.50,0:54:59.75,Default,,0,0,0,,Бұл қандай бала?
Dialogue: 0,0:55:13.01,0:55:15.93,Default,,0,0,0,,Конгоу! Каренбана! Мен сені осы жерден алып кетемін!
Dialogue: 0,0:55:29.91,0:55:31.45,Default,,0,0,0,,Мұғалім!
Dialogue: 0,0:55:38.12,0:55:39.54,Default,,0,0,0,,Чикушо...
Dialogue: 0,0:55:45.25,0:55:47.38,Default,,0,0,0,,Капитан...
Dialogue: 0,0:55:50.59,0:55:51.89,Default,,0,0,0,,Папа...
Dialogue: 0,0:55:57.18,0:55:58.93,Default,,0,0,0,,Корега мырза...
Dialogue: 0,0:56:15.62,0:56:21.04,Default,,0,0,0,,Жоқ, жоқ, жоқ! Мен сені көптен бері іздеп жүрмін, Мичиру-доно.
Dialogue: 0,0:56:21.12,0:56:24.59,Default,,0,0,0,,Неліктен "!? Қызық, папа екеуің дос болдыңдар ма?
Dialogue: 0,0:56:24.67,0:56:28.42,Default,,0,0,0,,Бірақ... неге мұндай сұмдық істедің!
Dialogue: 0,0:56:28.51,0:56:31.84,Default,,0,0,0,,Хахахаха _ Достар? Ақымақ болма!
Dialogue: 0,0:56:31.93,0:56:32.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:33.09,0:56:38.47,Default,,0,0,0,,Оядзи, сенің әкең шектен шыққан идеал, ол өзін жарасымды етіп көрсетеді.
Dialogue: 0,0:56:38.60,0:56:41.02,Default,,0,0,0,,Қарттар мен аз қамтылғандарға жәрдемақы
Dialogue: 0,0:56:41.10,0:56:45.98,Default,,0,0,0,,Қарттар үйін саласыз ба? Оны мемлекет қаржысымен қолдамақсыз ба?
Dialogue: 0,0:56:46.11,0:56:49.99,Default,,0,0,0,,Бірақ сіз салық мөлшерлемесін төмендетесіз...
Dialogue: 0,0:56:50.11,0:56:52.95,Default,,0,0,0,,Менің әкем солай істеген...
Dialogue: 0,0:56:53.70,0:56:57.08,Default,,0,0,0,,Мысалы, дәмді нәрсе жасасаңыз,
Dialogue: 0,0:56:57.16,0:56:59.79,Default,,0,0,0,,Маған соншалықты көп жеуге не мүмкіндік береді?
Dialogue: 0,0:57:03.54,0:57:09.63,Default,,0,0,0,,?
Dialogue: 0,0:57:09.71,0:57:13.63,Default,,0,0,0,,Бірақ мұның бәрі халық үшін бе?
Dialogue: 0,0:57:13.72,0:57:18.47,Default,,0,0,0,,Халықтың мүлкін қорғап, өсіремін дейсіз бе?
Dialogue: 0,0:57:18.56,0:57:20.89,Default,,0,0,0,,Әдемі нәрсенің бәріне араласпа!!
Dialogue: 0,0:57:22.35,0:57:25.27,Default,,0,0,0,,Жақсы ма? Бұл дүниеде жалғыз нәрсе маңызды.
Dialogue: 0,0:57:25.35,0:57:28.61,Default,,0,0,0,,Алтын, алтын, алтын!
Dialogue: 0,0:57:28.69,0:57:31.53,Default,,0,0,0,,Ақша - бәрі!
Dialogue: 0,0:57:32.49,0:57:35.91,Default,,0,0,0,,Бұл сіздің бай болуға тырысып жатқаныңызды білдірмейді ме?
Dialogue: 0,0:57:36.11,0:57:38.16,Default,,0,0,0,,Хехехехе...
Dialogue: 0,0:57:38.58,0:57:41.91,Default,,0,0,0,,Мен көбірек алғым келеді.
Dialogue: 0,0:57:42.00,0:57:48.09,Default,,0,0,0,,Менің әмиян семіре бастады, ұйықтар алдындағы денем сияқты!
Dialogue: 0,0:57:50.17,0:57:53.92,Default,,0,0,0,,Оның себебі неде... Әке...
Dialogue: 0,0:57:54.51,0:57:58.39,Default,,0,0,0,,Бірақ ол өлді.
Dialogue: 0,0:57:58.51,0:58:01.52,Default,,0,0,0,,Бұдан былай мен патшамын.
Dialogue: 0,0:58:01.60,0:58:04.23,Default,,0,0,0,,Жоқ, бұл менмін! Мен оған айналамын!!
Dialogue: 0,0:58:05.98,0:58:08.44,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:58:08.69,0:58:10.27,Default,,0,0,0,,Эцу?»
Dialogue: 0,0:58:25.04,0:58:26.37,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:58:26.46,0:58:29.08,Default,,0,0,0,,Біз жоғары дайындықта болдық және жасырын түрде кіре алмадық.
Dialogue: 0,0:58:29.21,0:58:32.34,Default,,0,0,0,,Уақытымыз жоқ екені рас.
Dialogue: 0,0:58:38.64,0:58:42.22,Default,,0,0,0,,Менің ойымша, берілудің қажеті жоқ.
Dialogue: 0,0:58:42.64,0:58:44.73,Default,,0,0,0,,Сіз бұған ризасыз ба?
Dialogue: 0,0:58:44.85,0:58:49.52,Default,,0,0,0,,Бірақ мен не істеуім керек! Бұл... Бұл жай ғана!
Dialogue: 0,0:58:49.60,0:58:53.36,Default,,0,0,0,,Бұл адамдар қанша күшті болса да, пайдасы жоқ!
Dialogue: 0,0:58:59.78,0:59:03.62,Default,,0,0,0,,Ең болмаса Хикару-сама елден қашып кетсін...
Dialogue: 0,0:59:05.00,0:59:08.58,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:59:13.42,0:59:21.26,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:59:23.97,0:59:26.89,Default,,0,0,0,,Кеттік! Көмектесейік!
Dialogue: 0,0:59:26.98,0:59:27.98,Default,,0,0,0,,Сіз, бұл...
Dialogue: 0,0:59:28.10,0:59:30.94,Default,,0,0,0,,Барудан басқа амалымыз жоқ! Дұрыс па?
Dialogue: 0,0:59:31.06,0:59:35.15,Default,,0,0,0,,Бұл мүмкін емес! Мен саған көмектесе алмаймын!
Dialogue: 0,0:59:35.28,0:59:39.95,Default,,0,0,0,,Не болса да... Не болса да, папа, сені өлтіреді!
Dialogue: 0,0:59:56.51,0:59:58.13,Default,,0,0,0,,Хикару
Dialogue: 0,0:59:59.97,1:00:01.38,Default,,0,0,0,,Хикару!
Dialogue: 0,1:00:10.64,1:00:14.94,Default,,0,0,0,,Сен... неге мені әлі күнге дейін тастап жүрсің?
Dialogue: 0,1:00:17.69,1:00:21.40,Default,,0,0,0,,Жай ғана бас тартқан Кагами ме?
Dialogue: 0,1:00:25.33,1:00:31.79,Default,,0,0,0,,Қате... Мен сізді шынымен де керемет деп ойладым.
Dialogue: 0,1:00:31.87,1:00:37.42,Default,,0,0,0,,Оны лақтырып тастау керек! «? Әке және сол азғындық.
Dialogue: 0,1:00:38.42,1:00:41.09,Default,,0,0,0,,Бұл да уәде!
Dialogue: 0,1:00:42.97,1:00:45.51,Default,,0,0,0,,Бәрін тастауым керек пе?
Dialogue: 0,1:00:46.97,1:00:52.10,Default,,0,0,0,,Маңызды... маңызды нәрселер
Dialogue: 0,1:01:17.38,1:01:19.75,Default,,0,0,0,,Мен барамын
Dialogue: 0,1:01:20.38,1:01:24.05,Default,,0,0,0,,Пабаға көмектес!
Dialogue: 0,1:01:26.39,1:01:27.68,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:01:28.14,1:01:29.47,Default,,0,0,0,,Хикару-сама, бұл қатыгез!
Dialogue: 0,1:01:29.56,1:01:32.89,Default,,0,0,0,,Қария! Уайымдама.
Dialogue: 0,1:01:33.02,1:01:39.40,Default,,0,0,0,,Мен Хикаруды еш нәрсеге қарамастан қорғаймын!
Dialogue: 0,1:01:41.86,1:01:42.90,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:01:43.03,1:01:43.99,Default,,0,0,0,,So de gohasu tomo!
Dialogue: 0,1:01:44.78,1:01:48.28,Default,,0,0,0,,Менің де бұрынғы патшаға берген уәдем бар, сондықтан оны орындаймын.
Dialogue: 0,1:01:48.41,1:01:52.16,Default,,0,0,0,,Олардың келбетін үлгілейік
Dialogue: 0,1:02:03.42,1:02:05.47,Default,,0,0,0,,Чаям! Кикки мен!
Dialogue: 0,1:02:08.01,1:02:09.05,Default,,0,0,0,,Хахаха!
Dialogue: 0,1:02:09.14,1:02:13.60,Default,,0,0,0,,Сәлем, Чиям! Сіз кенеттен қалай келдіңіз?
Dialogue: 0,1:02:15.39,1:02:18.52,Default,,0,0,0,,Иә? Барлығы...
Dialogue: 0,1:02:19.61,1:02:21.73,Default,,0,0,0,,Князьдің арбасы бір жаққа кетіп қалды.
Dialogue: 0,1:02:21.82,1:02:24.53,Default,,0,0,0,,Сарайға барғанда біртүрлі екен деп ойладым.
Dialogue: 0,1:02:24.61,1:02:28.45,Default,,0,0,0,,Мені есіктен бұрып жіберді, ақыры солдаттар мені қорқытты.
Dialogue: 0,1:02:28.57,1:02:30.53,Default,,0,0,0,,Жануарларды өлтіретіндей күші бар жалғыз мұнара.
Dialogue: 0,1:02:30.62,1:02:32.83,Default,,0,0,0,,Мен үрейленіп, мына орманға жүгірдім!
Dialogue: 0,1:02:32.95,1:02:36.29,Default,,0,0,0,,Қолма-қол ақшаны алмау - мүлде басқа оқиға!
Dialogue: 0,1:02:36.37,1:02:37.75,Default,,0,0,0,,Сіз бұл аралға бірдеңеден құтылу үшін келдіңіз...
Dialogue: 0,1:02:37.83,1:02:39.17,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:02:39.29,1:02:44.97,Default,,0,0,0,,Енді не болып жатқанын түсіндіріңізші! Эй!
Dialogue: 0,1:02:45.09,1:02:48.93,Default,,0,0,0,,Командир-сан! Ашуыңыз үшін кешірім сұраймын.
Dialogue: 0,1:02:49.01,1:02:52.14,Default,,0,0,0,,Цирктегі әрбір адам да ақша алуы керек.
Dialogue: 0,1:02:52.26,1:02:55.02,Default,,0,0,0,,Қиындыққа тап болдыңыз ғой, солай ма?
Dialogue: 0,1:03:04.86,1:03:11.03,Default,,0,0,0,,Яда яда яда... Яда ойын!!
Dialogue: 0,1:03:15.37,1:03:17.79,Default,,0,0,0,,Шужин Ежелден бері көп адам бір кісідей жиналды
Dialogue: 0,1:03:17.87,1:03:20.00,Default,,0,0,0,,...
Dialogue: 0,1:03:22.46,1:03:23.92,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,1:03:24.46,1:03:29.34,Default,,0,0,0,,Бұл жақсы емес және қиыншылыққа тап боласың, Мичиру Такеши, әйтпесе жалғыз қаласың...
Dialogue: 0,1:03:29.47,1:03:30.64,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:33.72,1:03:36.77,Default,,0,0,0,,Хехехе... көз байлауды шеш.
Dialogue: 0,1:03:45.40,1:03:46.99,Default,,0,0,0,,Yayaure
Dialogue: 0,1:03:53.74,1:03:55.83,Default,,0,0,0,,Өтінемін, тұзаққа түспеңіз!
Dialogue: 0,1:03:55.91,1:03:59.87,Default,,0,0,0,,Бұл қызық емес пе? Хахаха
Dialogue: 0,1:03:59.96,1:04:01.42,Default,,0,0,0,,Таң!
Dialogue: 0,1:04:15.68,1:04:18.48,Default,,0,0,0,,Таң!
Dialogue: 0,1:04:18.56,1:04:20.44,Default,,0,0,0,,Ах...!
Dialogue: 0,1:04:53.09,1:04:56.85,Default,,0,0,0,,(Какучи Нова Мэй Юмеби
Dialogue: 0,1:04:56.93,1:05:01.10,Default,,0,0,0,,Алғы сөз Songobone
Dialogue: 0,1:05:01.18,1:05:06.61,Default,,0,0,0,,Мен қылышқа ғашықпын, бойым аласа, сол 7-ші рет қашып, өзімді...
Dialogue: 0,1:05:08.27,1:05:09.61,Default,,0,0,0,,Папа...
Dialogue: 0,1:05:10.28,1:05:11.32,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:25.33,1:05:31.63,Default,,0,0,0,,(Цирк қойылымы)
Dialogue: 0,1:05:43.89,1:05:46.31,Default,,0,0,0,,Не! Кисама мен басқалары әлі келді ме?
Dialogue: 0,1:05:46.40,1:05:48.15,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,1:05:48.23,1:05:49.65,Default,,0,0,0,,Неге тезірек үйге бармайсың!
Dialogue: 0,1:05:49.94,1:05:52.32,Default,,0,0,0,,Бұл біртүрлі дизайн.
Dialogue: 0,1:05:52.40,1:05:55.61,Default,,0,0,0,,Бізді шақырып, спектакль көруге келдік.
Dialogue: 0,1:05:55.70,1:05:57.66,Default,,0,0,0,,Мен мұны тыңдамаймын.
Dialogue: 0,1:05:57.78,1:06:03.04,Default,,0,0,0,,Бұл шындық болуы мүмкін емес ...
Dialogue: 0,1:06:09.92,1:06:11.42,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:06:11.50,1:06:16.34,Default,,0,0,0,,Йокио, бұл жай ғана ойын-сауық. Zuguni Killing Rec қызықсыз, солай емес пе?
Dialogue: 0,1:06:16.43,1:06:17.39,Default,,0,0,0,,Бір!
Dialogue: 0,1:06:22.06,1:06:23.85,Default,,0,0,0,,Не!? О!
Dialogue: 0,1:06:24.93,1:06:29.02,Default,,0,0,0,,Цирк жігіттері сізді неге кіргізді?
Dialogue: 0,1:06:29.40,1:06:31.98,Default,,0,0,0,,Оларды кері айдап жіберейік
Dialogue: 0,1:06:32.07,1:06:33.03,Default,,0,0,0,,Цуму
Dialogue: 0,1:06:34.36,1:06:35.36,Default,,0,0,0,,Взвод командирі, тіпті біз Әйел Титанын қолға түсірсек те,
Dialogue: 0,1:06:35.45,1:06:39.78,Default,,0,0,0,,Жоқ, күте тұрыңыз! Бұл қызықсыз.
Dialogue: 0,1:06:39.87,1:06:42.37,Default,,0,0,0,,Бұл жігіттің кесірінен...
Dialogue: 0,1:06:51.13,1:06:53.30,Default,,0,0,0,,Не, цирк жігіттері келе жатыр ма?
Dialogue: 0,1:06:53.38,1:06:55.38,Default,,0,0,0,,О, Норука мен барамын
Dialogue: 0,1:07:15.65,1:07:17.40,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,1:07:18.20,1:07:23.08,Default,,0,0,0,,Бұл қулық туралы тек патшаға қызмет еткен біздің адамдар ғана біледі.
Dialogue: 0,1:07:24.74,1:07:26.25,Default,,0,0,0,,Хикару-сама
Dialogue: 0,1:07:27.25,1:07:29.25,Default,,0,0,0,,Мынаны пайдаланыңыз
Dialogue: 0,1:07:29.37,1:07:33.38,Default,,0,0,0,,Мен оны Хикару-сама үшін жасадым. Сізге қандай да бір жолмен көмектесетін хабарлама.
Dialogue: 0,1:07:34.21,1:07:35.21,Default,,0,0,0,,Рахмет
Dialogue: 0,1:07:36.09,1:07:37.13,Default,,0,0,0,,Бару
Dialogue: 0,1:07:38.93,1:07:40.59,Default,,0,0,0,,Бұл Какакаши-сенсэйдің хабары.
Dialogue: 0,1:07:40.72,1:07:43.68,Default,,0,0,0,,Мичиру-сан жоғарғы қабаттағы террассада.
Dialogue: 0,1:07:43.76,1:07:47.27,Default,,0,0,0,,Асықпасақ қауіпті жағдай.
Dialogue: 0,1:07:57.78,1:07:59.28,Default,,0,0,0,,Жас ханым!
Dialogue: 0,1:07:59.78,1:08:00.95,Default,,0,0,0,,Какакаши Сенсэй!
Dialogue: 0,1:08:01.61,1:08:04.41,Default,,0,0,0,,Үй жануарлары дүкенінен ит қашып кетті!
Dialogue: 0,1:08:04.49,1:08:07.37,Default,,0,0,0,,Сәлем! Сәлем! Хай Хай Хай Уау!
Dialogue: 0,1:08:07.45,1:08:12.29,Default,,0,0,0,,Датан Кентай (2 адам) Экспедиция! Экспедиция!
Dialogue: 0,1:08:12.42,1:08:14.21,Default,,0,0,0,,Жақында жасайсыз ба?
Dialogue: 0,1:08:20.80,1:08:24.14,Default,,0,0,0,,Спектакль ақыры шарықтау шегіне жетті.
Dialogue: 0,1:08:25.22,1:08:27.64,Default,,0,0,0,,Баршаңызды хабардар болыңыз...
Dialogue: 0,1:08:29.43,1:08:30.56,Default,,0,0,0,,Ол кім?
Dialogue: 0,1:08:42.95,1:08:44.57,Default,,0,0,0,,Ишидат!!
Dialogue: 0,1:08:44.95,1:08:46.62,Default,,0,0,0,,бұрынғы Вакага!
Dialogue: 0,1:08:52.58,1:08:55.34,Default,,0,0,0,,Кез келген жағдайда сіз бұл жігітке көмектесесіз бе...?
Dialogue: 0,1:08:56.38,1:08:58.25,Default,,0,0,0,,Сәлем! (Солдат) Бере бер бер!
Dialogue: 0,1:08:58.67,1:08:59.88,Default,,0,0,0,,Жүр, жүр!
Dialogue: 0,1:09:00.84,1:09:02.34,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:05.18,1:09:08.56,Default,,0,0,0,,Аа, егер сіз осындай жағдайға тап болсаңыз, көмектеспеуіңіз керек!
Dialogue: 0,1:09:32.71,1:09:37.09,Default,,0,0,0,,Хикару, сен маған сенесің бе?
Dialogue: 0,1:09:37.21,1:09:38.42,Default,,0,0,0,,Цун!
Dialogue: 0,1:09:38.54,1:09:41.17,Default,,0,0,0,,Жарайды! Мен сөз беремін!
Dialogue: 0,1:09:41.26,1:09:45.30,Default,,0,0,0,,Мен сені қорғаймын!
Dialogue: 0,1:09:47.30,1:09:48.22,Default,,0,0,0,,Мен де!
Dialogue: 0,1:09:48.30,1:09:49.64,Default,,0,0,0,,Мен де!
Dialogue: 0,1:09:56.48,1:09:57.56,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:09:58.27,1:10:01.53,Default,,0,0,0,,Жоғарғы террасса патшаның бөлмесі болса керек.
Dialogue: 0,1:10:01.61,1:10:03.82,Default,,0,0,0,,Енді солдаттар аз болғандықтан...
Dialogue: 0,1:10:06.86,1:10:11.91,Default,,0,0,0,,Хехе... Бұл рас. Көшбасшы күткендей. Сіздің оқуыңыз терең.
Dialogue: 0,1:10:12.62,1:10:16.33,Default,,0,0,0,,Сырттағы аласапыранның бұрыс екені көрініп тұр.
Dialogue: 0,1:10:17.25,1:10:20.25,Default,,0,0,0,,Бұл менмін! (Ли) Жоқ, менмін.
Dialogue: 0,1:10:20.34,1:10:21.63,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,1:10:21.75,1:10:22.88,Default,,0,0,0,,Гедзимаю!
Dialogue: 0,1:10:22.96,1:10:26.51,Default,,0,0,0,,Қарыздарымды толық өтеу менің саясатым.
Dialogue: 0,1:10:27.76,1:10:30.01,Default,,0,0,0,,Мен оны сұрадым, Гедзимаю!
Dialogue: 0,1:10:30.39,1:10:32.18,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:10:39.52,1:10:41.65,Default,,0,0,0,,Бұл жолы мен саған оңай соқпаймын!
Dialogue: 0,1:10:45.74,1:10:47.11,Default,,0,0,0,,Қалауыңызша!
Dialogue: 0,1:10:58.04,1:10:59.92,Default,,0,0,0,,А, Сакура-чан!?
Dialogue: 0,1:11:02.50,1:11:04.21,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:11:04.42,1:11:06.17,Default,,0,0,0,,Сіз шулысыз!
Dialogue: 0,1:11:07.22,1:11:10.30,Default,,0,0,0,,Бала болсаң да, хош иістің дәмі нашар!
Dialogue: 0,1:11:10.43,1:11:11.85,Default,,0,0,0,,Гакири?
Dialogue: 0,1:11:11.97,1:11:13.97,Default,,0,0,0,,Сью - менмін!
Dialogue: 0,1:11:14.39,1:11:16.35,Default,,0,0,0,,Сен баласың!?
Dialogue: 0,1:11:22.32,1:11:24.65,Default,,0,0,0,,Мен қазірдің өзінде... 22!
Dialogue: 0,1:11:25.44,1:11:26.65,Default,,0,0,0,,Усорири 2?
Dialogue: 0,1:11:32.78,1:11:33.99,Default,,0,0,0,,Паба-ба-па!
Dialogue: 0,1:11:34.37,1:11:35.83,Default,,0,0,0,,Хикару!
Dialogue: 0,1:11:35.91,1:11:37.00,Default,,0,0,0,,Олар!
Dialogue: 0,1:11:37.12,1:11:39.29,Default,,0,0,0,,Патшаның бөлмесі!
Dialogue: 0,1:11:51.51,1:11:53.05,Default,,0,0,0,,Сенпай!
Dialogue: 0,1:11:54.26,1:11:56.35,Default,,0,0,0,,Теми!
Dialogue: 0,1:12:04.69,1:12:05.86,Default,,0,0,0,,Lowarihabahahaha...
Dialogue: 0,1:12:08.19,1:12:09.65,Default,,0,0,0,,Хикару...
Dialogue: 0,1:12:10.70,1:12:14.16,Default,,0,0,0,,Сіздің стратегияңыз мағынасыз.
Dialogue: 0,1:12:16.91,1:12:18.00,Default,,0,0,0,,Өл!
Dialogue: 0,1:12:22.71,1:12:24.88,Default,,0,0,0,,Чум! Не!?
Dialogue: 0,1:12:27.30,1:12:28.59,Default,,0,0,0,,Чичам!
Dialogue: 0,1:12:35.39,1:12:36.22,Default,,0,0,0,,Ақымақ...
Dialogue: 0,1:12:45.40,1:12:46.73,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,1:12:54.91,1:12:56.08,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,1:12:59.41,1:13:01.96,Default,,0,0,0,,Цуоооооооооо!
Dialogue: 0,1:13:19.60,1:13:21.10,Default,,0,0,0,,Цуоцу!
Dialogue: 0,1:13:24.19,1:13:25.77,Default,,0,0,0,,Бұл тұрарлық!
Dialogue: 0,1:13:38.12,1:13:40.12,Default,,0,0,0,,Шаринган: Шаринганды тым көп пайдаландың ба?
Dialogue: 0,1:13:46.63,1:13:48.54,Default,,0,0,0,,Күмән жоқ, ыңылдап тұрсың.
Dialogue: 0,1:13:56.55,1:13:57.80,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:03.98,1:14:05.31,Default,,0,0,0,,Сонда да сол улы тұман!
Dialogue: 0,1:14:05.98,1:14:09.32,Default,,0,0,0,,Фуфуририфурури... хахахахаха!
Dialogue: 0,1:14:15.57,1:14:17.16,Default,,0,0,0,,Киссамер!
Dialogue: 0,1:14:35.22,1:14:37.43,Default,,0,0,0,,Әке!
Dialogue: 0,1:14:39.18,1:14:40.39,Default,,0,0,0,,Хикару!
Dialogue: 0,1:14:40.85,1:14:43.85,Default,,0,0,0,,Папарири! Папарири!
Dialogue: 0,1:14:55.61,1:14:57.45,Default,,0,0,0,,Буузу
Dialogue: 0,1:14:57.86,1:15:00.07,Default,,0,0,0,,Toriya Arts!!
Dialogue: 0,1:15:02.37,1:15:03.33,Default,,0,0,0,,Сіз?
Dialogue: 0,1:15:03.49,1:15:05.71,Default,,0,0,0,,Маған бұл жігітке тиісуге рұқсат етпе!
Dialogue: 0,1:15:05.79,1:15:06.75,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,1:15:08.62,1:15:09.71,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:15:57.26,1:16:00.09,Default,,0,0,0,,Цуууу!
Dialogue: 0,1:16:07.39,1:16:09.77,Default,,0,0,0,,Наруто нии-чан!
Dialogue: 0,1:16:11.10,1:16:13.31,Default,,0,0,0,,О, хо хо
Dialogue: 0,1:16:18.28,1:16:21.49,Default,,0,0,0,,Уфуфуно_ Кияхаха
Dialogue: 0,1:16:22.74,1:16:24.95,Default,,0,0,0,,Ооо! (Ли) Арх!
Dialogue: 0,1:16:30.46,1:16:32.63,Default,,0,0,0,,Әлі жоқ! (Ли) Ааа!
Dialogue: 0,1:16:45.60,1:16:46.93,Default,,0,0,0,,Иә
Dialogue: 0,1:16:48.14,1:16:49.48,Default,,0,0,0,,Келесі діни қызметкер ме?
Dialogue: 0,1:16:50.35,1:16:54.31,Default,,0,0,0,,А? Эй, эй, не болып жатыр?
Dialogue: 0,1:16:59.32,1:17:01.32,Default,,0,0,0,,Вари Лоли Лоли Ло...
Dialogue: 0,1:17:16.21,1:17:17.17,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:17:18.55,1:17:20.59,Default,,0,0,0,,Набазеба... Набазена?
Dialogue: 0,1:17:22.38,1:17:23.59,Default,,0,0,0,,Уәде...
Dialogue: 0,1:17:24.39,1:17:26.51,Default,,0,0,0,,Уәде...
Dialogue: 0,1:17:27.64,1:17:29.52,Default,,0,0,0,,Уәде бергенше
Dialogue: 0,1:17:30.22,1:17:31.43,Default,,0,0,0,,Қорғау
Dialogue: 0,1:17:32.06,1:17:33.02,Default,,0,0,0,,Қорғау
Dialogue: 0,1:17:33.39,1:17:34.85,Default,,0,0,0,,Қорғаңыз!
Dialogue: 0,1:17:35.19,1:17:40.23,Default,,0,0,0,,Достарыңызды кез келген жағдайда қорғаңыз!
Dialogue: 0,1:17:51.79,1:17:53.08,Default,,0,0,0,,О
Dialogue: 0,1:17:53.21,1:17:54.75,Default,,0,0,0,,О?
Dialogue: 0,1:17:55.21,1:17:59.21,Default,,0,0,0,,О, құла, құла!
Dialogue: 0,1:17:59.46,1:18:01.21,Default,,0,0,0,,Папа бапапа бапа!
Dialogue: 0,1:18:05.13,1:18:06.43,Default,,0,0,0,,Трансмиссия...
Dialogue: 0,1:18:26.07,1:18:28.03,Default,,0,0,0,,Хикару
Dialogue: 0,1:18:45.22,1:18:48.51,Default,,0,0,0,,Қош бол Хикару
Dialogue: 0,1:19:14.87,1:19:17.46,Default,,0,0,0,,Хикару Те!
Dialogue: 0,1:19:17.62,1:19:19.38,Default,,0,0,0,,Берілме!
Dialogue: 0,1:19:30.89,1:19:32.30,Default,,0,0,0,,Алшақтыққа сеніңіз!
Dialogue: 0,1:19:33.18,1:19:34.22,Default,,0,0,0,,Цун
Dialogue: 0,1:19:34.52,1:19:37.98,Default,,0,0,0,,Чимаям Чимаям, маған күшіңізді беріңізші
Dialogue: 0,1:19:38.10,1:19:41.02,Default,,0,0,0,,Мені апарыңыз, әкеме апарыңыз
Dialogue: 0,1:20:19.94,1:20:21.69,Default,,0,0,0,,Хикару?
Dialogue: 0,1:20:27.69,1:20:29.19,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,1:21:00.35,1:21:05.98,Default,,0,0,0,,Цуоцу!
Dialogue: 0,1:21:22.58,1:21:24.42,Default,,0,0,0,,не үшін шайқасып жүрсің?
Dialogue: 0,1:21:32.13,1:21:35.26,Default,,0,0,0,,Қадамыңды қадағалау керек.
Dialogue: 0,1:21:47.48,1:21:50.90,Default,,0,0,0,,Ух... мм
Dialogue: 0,1:21:50.98,1:21:54.61,Default,,0,0,0,,Атсу папа!
Dialogue: 0,1:21:55.41,1:21:58.62,Default,,0,0,0,,Папа... Папа папа!
Dialogue: 0,1:22:01.29,1:22:05.12,Default,,0,0,0,,Депрессия... Иә...
Dialogue: 0,1:22:06.96,1:22:11.17,Default,,0,0,0,,Пухаака! Гехо...
Dialogue: 0,1:22:11.30,1:22:14.76,Default,,0,0,0,,А, мен өлемін деп ойладым.
Dialogue: 0,1:22:14.84,1:22:16.05,Default,,0,0,0,,Паба-ба-па!
Dialogue: 0,1:22:22.35,1:22:24.52,Default,,0,0,0,,Рахмет саған Хикару
Dialogue: 0,1:22:33.94,1:22:39.32,Default,,0,0,0,,(сықырлаған айқай)
Dialogue: 0,1:22:40.20,1:22:41.62,Default,,0,0,0,,Чичам!
Dialogue: 0,1:22:42.16,1:22:45.83,Default,,0,0,0,,Читям! Чаям Чаям...
Dialogue: 0,1:22:51.88,1:22:53.34,Default,,0,0,0,,Уау...
Dialogue: 0,1:22:54.09,1:22:57.97,Default,,0,0,0,,Рахмет Чиам Рахмет
Dialogue: 0,1:22:58.59,1:23:01.01,Default,,0,0,0,,Хахатцуцу
Dialogue: 0,1:23:20.57,1:23:22.28,Default,,0,0,0,,Ки... Кисацума!
Dialogue: 0,1:23:23.83,1:23:25.54,Default,,0,0,0,,Шаяя бадаба!
Dialogue: 0,1:23:26.50,1:23:27.75,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:27.87,1:23:29.71,Default,,0,0,0,,Кисама Жарайсың!
Dialogue: 0,1:23:29.83,1:23:32.38,Default,,0,0,0,,Бұл ол ма? Куродзи Цуконоха.
Dialogue: 0,1:23:35.01,1:23:36.92,Default,,0,0,0,,Таң!
Dialogue: 0,1:23:39.13,1:23:42.05,Default,,0,0,0,,Уау! Депрессия!
Dialogue: 0,1:23:43.64,1:23:46.93,Default,,0,0,0,,Цуоцу!
Dialogue: 0,1:23:56.28,1:23:57.74,Default,,0,0,0,,Наруто нии-чан!
Dialogue: 0,1:23:57.82,1:23:59.45,Default,,0,0,0,,Ухихихихихи
Dialogue: 0,1:24:01.41,1:24:05.41,Default,,0,0,0,,Ишидат Йоши Йоши
Dialogue: 0,1:24:13.13,1:24:15.30,Default,,0,0,0,,Расенған Расенған
Dialogue: 0,1:24:20.80,1:24:22.14,Default,,0,0,0,,Таң!
Dialogue: 0,1:24:22.93,1:24:24.76,Default,,0,0,0,,Наруто нии-чан!
Dialogue: 0,1:24:28.02,1:24:30.64,Default,,0,0,0,,Сіз қателесесіз бе? Ишидат
Dialogue: 0,1:24:30.77,1:24:33.69,Default,,0,0,0,,Бұл Мичиру! Мичиру ойнаймыз!
Dialogue: 0,1:24:35.48,1:24:36.61,Default,,0,0,0,,Ониичаян!
Dialogue: 0,1:24:41.36,1:24:46.74,Default,,0,0,0,,Жоқ! Бұл бала емес. Бұл Мичиру! Мичиру!
Dialogue: 0,1:24:46.83,1:24:49.20,Default,,0,0,0,,Эй, тыңдап тұрсың ба? Ишидат!
Dialogue: 0,1:24:49.29,1:24:51.67,Default,,0,0,0,,Ол емес!
Dialogue: 0,1:24:52.12,1:24:57.05,Default,,0,0,0,,Онги Кисама сен маған қарызыңды ұмыттың ба?
Dialogue: 0,1:24:57.13,1:25:01.30,Default,,0,0,0,,Руро, сен еліңнен қуылып, қаңғып өмір сүрдің.
Dialogue: 0,1:25:01.43,1:25:06.22,Default,,0,0,0,,Мына қыранды мен әдейі жалдағанмын.
Dialogue: 0,1:25:06.31,1:25:09.47,Default,,0,0,0,,Ишидат! Эй! Кисацума!
Dialogue: 0,1:25:09.56,1:25:12.14,Default,,0,0,0,,Алғыссыз бейбақ!
Dialogue: 0,1:25:13.90,1:25:16.06,Default,,0,0,0,,Цуоцу!
Dialogue: 0,1:25:16.15,1:25:17.57,Default,,0,0,0,,Әке!
Dialogue: 0,1:25:19.86,1:25:20.99,Default,,0,0,0,,Очаян?"?
Dialogue: 0,1:25:21.24,1:25:23.82,Default,,0,0,0,,Менің бұйрықтарымды тыңда! Ишидат!
Dialogue: 0,1:25:23.91,1:25:27.08,Default,,0,0,0,,Цурусе!!
Dialogue: 0,1:25:37.17,1:25:40.51,Default,,0,0,0,,Цуоцу!
Dialogue: 0,1:25:41.92,1:25:45.26,Default,,0,0,0,,Цуоцу!
Dialogue: 0,1:25:53.69,1:25:55.19,Default,,0,0,0,,Әке!
Dialogue: 0,1:25:56.86,1:25:58.23,Default,,0,0,0,,Итай!
Dialogue: 0,1:25:58.69,1:26:00.23,Default,,0,0,0,,Паба-ба-па!
Dialogue: 0,1:26:03.11,1:26:06.78,Default,,0,0,0,,Шешейік!
Dialogue: 0,1:26:11.58,1:26:12.58,Default,,0,0,0,,Паба-ба-па!
Dialogue: 0,1:26:12.95,1:26:13.87,Default,,0,0,0,,Очаян!
Dialogue: 0,1:26:16.50,1:26:19.00,Default,,0,0,0,,Әке! Әке!
Dialogue: 0,1:26:29.55,1:26:32.89,Default,,0,0,0,,Чаям! Kikkiiri! Папа!
Dialogue: 0,1:26:33.85,1:26:35.77,Default,,0,0,0,,Қашпа, әке!
Dialogue: 0,1:26:35.89,1:26:38.94,Default,,0,0,0,,Нарутоның үлкен ағасы... Чаямның Киккииганың ағасы
Dialogue: 0,1:26:39.06,1:26:40.40,Default,,0,0,0,,Біз үшін...
Dialogue: 0,1:26:40.48,1:26:43.94,Default,,0,0,0,,Біз Отан үшін күресеміз!
Dialogue: 0,1:26:44.07,1:26:46.57,Default,,0,0,0,,Мен де, әкем де...
Dialogue: 0,1:26:48.57,1:26:51.12,Default,,0,0,0,,Жоғалтпа, өйткені ол өте үлкен!!
Dialogue: 0,1:26:53.12,1:26:56.92,Default,,0,0,0,,Цуоцу!
Dialogue: 0,1:27:25.24,1:27:26.36,Default,,0,0,0,,Торияутцу!
Dialogue: 0,1:27:44.09,1:27:47.09,Default,,0,0,0,,Гай-сенсэй жасады!
Dialogue: 0,1:27:47.17,1:27:51.09,Default,,0,0,0,,Мен маңызды уәдемді орындадым!
Dialogue: 0,1:28:04.82,1:28:06.90,Default,,0,0,0,,Мұғалім, амансың ба?
Dialogue: 0,1:28:07.69,1:28:11.24,Default,,0,0,0,,Жоқ, жоқ, бұл екі апта бойы мүмкін болмауы мүмкін...
Dialogue: 0,1:28:11.32,1:28:14.37,Default,,0,0,0,,Сәлем! Олай болса, мұғалім сауығып кеткенше күте тұрыңыз.
Dialogue: 0,1:28:14.49,1:28:16.12,Default,,0,0,0,,Манкитсу Демалысыңыздан рахат алыңыз!
Dialogue: 0,1:28:16.20,1:28:19.04,Default,,0,0,0,,Ахахаха...
Dialogue: 0,1:28:21.08,1:28:24.00,Default,,0,0,0,,Рахмет саған Наруто-кун
Dialogue: 0,1:28:24.71,1:28:27.67,Default,,0,0,0,,Мен қандай ақымақ едім!
Dialogue: 0,1:28:27.80,1:28:31.55,Default,,0,0,0,,Өзімшіл, аңғал әкең не істемек болды.
Dialogue: 0,1:28:31.68,1:28:35.56,Default,,0,0,0,,Өйткені мен ненің таңданарлық екенін де білмедім.
Dialogue: 0,1:28:35.68,1:28:38.68,Default,,0,0,0,,Патша мұрагері болу деген нені білдіреді?
Dialogue: 0,1:28:38.81,1:28:42.35,Default,,0,0,0,,Ел билеу деген нені білдіреді?
Dialogue: 0,1:28:42.44,1:28:46.57,Default,,0,0,0,,Мен мұны шынымен түсінбеймін және қаншалықты алысқа барарымды білмеймін, бірақ...
Dialogue: 0,1:28:46.69,1:28:49.49,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,1:28:49.57,1:28:51.95,Default,,0,0,0,,Әкем айтқандай...
Dialogue: 0,1:28:53.45,1:28:57.04,Default,,0,0,0,,Дұрыс! Егер сіз қарт болсаңыз, сіз мұны міндетті түрде жасай аласыз.
Dialogue: 0,1:28:59.87,1:29:01.04,Default,,0,0,0,,Рахмет
Dialogue: 0,1:29:02.71,1:29:04.21,Default,,0,0,0,,Мен де көмектесемін!
Dialogue: 0,1:29:04.29,1:29:06.09,Default,,0,0,0,,Өтінемін, Хикару
Dialogue: 0,1:29:06.21,1:29:07.67,Default,,0,0,0,,Цун!
Dialogue: 0,1:29:20.85,1:29:25.31,Default,,0,0,0,,Бүгінгі күнді ұмытпаймын
Dialogue: 0,1:29:27.90,1:29:30.49,Default,,0,0,0,,Оны да ешқашан ұмытпаймын.
Dialogue: 0,1:29:30.57,1:29:34.78,Default,,0,0,0,,Барлығы біз үшін аянбай еңбек етті.
Dialogue: 0,1:29:34.91,1:29:38.54,Default,,0,0,0,,Бәріміз бірге еңбек етіп, аянбай еңбек еттік.
Dialogue: 0,1:29:38.62,1:29:42.87,Default,,0,0,0,,Маңызды нәрсені бірге қорғайық
Dialogue: 0,1:29:46.00,1:29:52.01,Default,,0,0,0,,Мен асыл досымды ешқашан ұмытпаймын...
Dialogue: 0,1:30:16.28,1:30:17.66,Default,,0,0,0,,Косэй, өзіңді жаман сезініп тұрсың ба?
Dialogue: 0,1:30:18.41,1:30:19.95,Default,,0,0,0,,Мен ұмытпаймын
Dialogue: 0,1:30:24.62,1:30:28.00,Default,,0,0,0,,Біздің... маңызды нәрселер
Dialogue: 0,1:30:53.94,1:30:59.70,Default,,0,0,0,,> Өткенде
Dialogue: 0,1:30:59.82,1:31:04.20,Default,,0,0,0,,I
Dialogue: 0,1:31:06.46,1:31:12.63,Default,,0,0,0,,2-ші жолға нұсқау
Dialogue: 0,1:31:12.71,1:31:16.72,Default,,0,0,0,,2 және ку зу ка
Dialogue: 0,1:31:17.68,1:31:26.23,Default,,0,0,0,,Жоғарғы және төменгі талаптар
Dialogue: 0,1:31:26.35,1:31:30.02,Default,,0,0,0,,2
Dialogue: 0,1:31:30.15,1:31:36.15,Default,,0,0,0,,*Ганатакиді ешкім ешқашан сатпаған.
Dialogue: 0,1:31:36.24,1:31:42.62,Default,,0,0,0,,7 Тек ресми мақсаттар үшін
Dialogue: 0,1:31:42.70,1:31:48.71,Default,,0,0,0,,Оны ешкім ешқашан сатқан емес.
Dialogue: 0,1:31:48.83,1:31:57.55,Default,,0,0,0,,7 Kōkō 9 Teji Reba Mashi Udoigaga To
Dialogue: 0,1:32:09.27,1:32:19.57,Default,,0,0,0,,Ка 8 Блуминг Гарезель 2 Сенім жоқ па?
Dialogue: 0,1:32:21.74,1:32:27.91,Default,,0,0,0,,4
Dialogue: 0,1:32:28.04,1:32:32.88,Default,,0,0,0,,2 жол 2
Dialogue: 0,1:32:32.96,1:32:44.60,Default,,0,0,0,,No 2 Лабиринтті қолдану бар.
Dialogue: 0,1:32:45.43,1:32:51.48,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,1:32:51.60,1:32:57.94,Default,,0,0,0,,7 Тек ресми мақсаттар үшін
Dialogue: 0,1:32:58.07,1:33:03.95,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,1:33:04.07,1:33:12.92,Default,,0,0,0,,7 Kōkō 9 Teji Reba Mashi Udoigaga To
Dialogue: 0,1:33:25.01,1:33:31.64,Default,,0,0,0,,A (2 және 2)
Dialogue: 0,1:33:32.77,1:33:35.52,Default,,0,0,0,,А
Dialogue: 0,1:33:35.65,1:33:41.65,Default,,0,0,0,,※
Dialogue: 0,1:33:41.78,1:33:47.45,Default,,0,0,0,,7 Тек ресми мақсаттар үшін
Dialogue: 0,1:33:48.20,1:33:54.17,Default,,0,0,0,,а Шығаратын ештеңе жоқ.
Dialogue: 0,1:33:54.29,1:34:03.09,Default,,0,0,0,,Ою және ою үшін қолданылады
Dialogue: 0,1:34:25.28,1:34:30.12,Default,,0,0,0,,Ел тынышталғанда, мен анамды алып кетейін деп ойлаймын.
Dialogue: 0,1:34:32.04,1:34:36.62,Default,,0,0,0,,Енді мен ненің маңызды екенін білемін
Dialogue: 0,1:34:37.88,1:34:42.13,Default,,0,0,0,,Маңызды болу деген нені білдіреді?
Dialogue: 0,1:34:43.63,1:34:49.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory