Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.10,0:00:05.47,Default,,0,0,0,,<Х... Адамдарды қызықтыратын нәрсе.
Dialogue: 0,0:00:05.47,0:00:09.10,Default,,0,0,0,,Бейблейд ойын ма? Бұл спорт па?
Dialogue: 0,0:00:09.10,0:00:12.41,Default,,0,0,0,,X➡-тің ең үлкен үдеуі
Dialogue: 0,0:00:12.41,0:00:16.38,Default,,0,0,0,,Экстремалды ойын.
Dialogue: 0,0:00:16.38,0:00:20.08,Default,,0,0,0,,X сіздің қолыңызда＞
Dialogue: 0,0:00:20.08,0:00:22.58,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:00:22.58,0:00:28.09,Default,,0,0,0,,Persona Pro командасына көтерілуіңізбен құттықтаймыз!
Dialogue: 0,0:00:28.09,0:00:32.59,Default,,0,0,0,,Жүр, тамақ ішейік! Мен оны аламын!
Dialogue: 0,0:00:32.59,0:00:34.93,Default,,0,0,0,,Бірақ бұл арман сияқты.
Dialogue: 0,0:00:34.93,0:00:37.60,Default,,0,0,0,,Бұл сахнада тұрудың уақыты келді!
Dialogue: 0,0:00:37.60,0:00:42.74,Default,,0,0,0,,X Tower-те, кәсіпқойлар арасындағы кескілескен шайқас орны!
Dialogue: 0,0:00:42.74,0:00:45.07,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:00:45.07,0:00:48.78,Default,,0,0,0,,Бұл ақсақ. Не... не?
Dialogue: 0,0:00:48.78,0:00:51.91,Default,,0,0,0,,Жақсырақ көрінетін дүкен болған жоқ па?
Dialogue: 0,0:00:51.91,0:00:54.42,Default,,0,0,0,,Иісі сіздің киіміңізге керемет.
Dialogue: 0,0:00:54.42,0:00:56.59,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:00:56.59,0:00:59.59,Default,,0,0,0,,Бұл мейрамхана дәмді болу үшін үлкен беделге ие.
Dialogue: 0,0:00:59.59,0:01:06.09,Default,,0,0,0,,Тіпті десертке де бұл үлкен пудинг шықты...
Dialogue: 0,0:01:06.09,0:01:10.93,Default,,0,0,0,,Көп ойыншы жігіт, ол таратылған кезден тым өзгеше емес пе?
Dialogue: 0,0:01:10.93,0:01:12.90,Default,,0,0,0,,Сіз маған аштыңыз, солай емес пе?
Dialogue: 0,0:01:12.90,0:01:14.90,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:01:14.90,0:01:18.57,Default,,0,0,0,,《Бірақ мен оның керемет қылшық екеніне сенімдімін~》
Dialogue: 0,0:01:18.57,0:01:20.58,Default,,0,0,0,,Бұл керемет көрінеді.
Dialogue: 0,0:01:20.58,0:01:23.45,Default,,0,0,0,,《Костюмдер мен шығанақтарды қалауыңызша пайдаланыңыз➡
Dialogue: 0,0:01:23.45,0:01:27.08,Default,,0,0,0,,Ол әсер етуші ретінде де белсенді...
Dialogue: 0,0:01:27.08,0:01:32.09,Default,,0,0,0,,Мен мұны осы командада жасай аламын ба? 》
Dialogue: 0,0:01:32.09,0:01:34.42,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:01:34.42,0:01:37.26,Default,,0,0,0,,Жоқ! Сіз оны жемейсіз бе?
Dialogue: 0,0:01:37.26,0:01:39.73,Default,,0,0,0,,Егер сіз мұны көтерсеңіз.
Dialogue: 0,0:01:41.80,0:01:45.07,Default,,0,0,0,,Дәлірек айтсақ, ол қатты толқыған сияқты...
Dialogue: 0,0:01:45.07,0:01:48.60,Default,,0,0,0,,Біз әлі кәсіпқой емеспіз.
Dialogue: 0,0:01:48.60,0:01:50.74,Default,,0,0,0,,Не? Өйткені➡
Dialogue: 0,0:01:50.74,0:01:52.91,Default,,0,0,0,,Бұл командада ондай жоқ.
Dialogue: 0,0:01:52.91,0:01:56.98,Default,,0,0,0,,Аа, солай. Не... Бұл не?
Dialogue: 0,0:01:56.98,0:02:00.95,Default,,0,0,0,,Кәсіби жүзгіштер үшін өте қажет...
Dialogue: 0,0:02:00.95,0:02:04.75,Default,,0,0,0,,Бұл Bay демеушісі!
Dialogue: 0,0:03:50.06,0:03:54.23,Default,,0,0,0,,Кәсіби жүзгіштер үшін өте қажет...
Dialogue: 0,0:03:54.23,0:03:57.07,Default,,0,0,0,,Бұл Bay демеушісі!
Dialogue: 0,0:03:57.07,0:04:00.10,Default,,0,0,0,,Демеуші?
Dialogue: 0,0:04:00.10,0:04:05.11,Default,,0,0,0,,Сіз мұны білмейсіз бе? Мен көмектесе алмаймын.
Dialogue: 0,0:04:05.11,0:04:10.28,Default,,0,0,0,,Жарайсың ба? Кәсіби пиязшыларға демеуші болуы керек.
Dialogue: 0,0:04:10.28,0:04:14.65,Default,,0,0,0,,Демеуші шұңқырдың шығанағына өтуі үшін ортаны қамтамасыз етеді.
Dialogue: 0,0:04:14.65,0:04:19.19,Default,,0,0,0,,Bladers демеуші компанияның атын тарату үшін жұмыс істейді.
Dialogue: 0,0:04:19.19,0:04:22.76,Default,,0,0,0,,Екі тарап үшін де «жеңіс-жеңіс» шарттық қатынасы.
Dialogue: 0,0:04:22.76,0:04:25.09,Default,,0,0,0,,Бұл Bay демеушісі!
Dialogue: 0,0:04:25.09,0:04:28.96,Default,,0,0,0,,Түсіндім, демеуші болса ғана кәсіпқой бола аласың.
Dialogue: 0,0:04:28.96,0:04:31.10,Default,,0,0,0,,Бұл негіз.
Dialogue: 0,0:04:31.10,0:04:33.60,Default,,0,0,0,,Дұрыс есте сақта. иә!
Dialogue: 0,0:04:36.07,0:04:38.77,Default,,0,0,0,,Маған қабырғаларды беріңіз.
Dialogue: 0,0:04:38.77,0:04:40.78,Default,,0,0,0,,Бұл Қалби!
Dialogue: 0,0:04:40.78,0:04:44.25,Default,,0,0,0,,Сонымен, ертеңнен бастап мен демеуші іздеймін.
Dialogue: 0,0:04:44.25,0:04:46.45,Default,,0,0,0,,Фуфуфуфуфу!
Dialogue: 0,0:04:46.45,0:04:49.28,Default,,0,0,0,,Демеуші болса, тауып алдым!
Dialogue: 0,0:04:49.28,0:04:52.92,Default,,0,0,0,,Шынайы ма? иә! Өте жақсы жағдайлар➡
Dialogue: 0,0:04:52.92,0:04:55.42,Default,,0,0,0,,Ұсыныс алыңыз. Шынайы! ?
Dialogue: 0,0:04:55.42,0:04:57.76,Default,,0,0,0,,Ол менің ертең сұхбатқа келгенімді қалайды!
Dialogue: 0,0:04:57.76,0:05:00.26,Default,,0,0,0,,Иә! Мен оны асыға күтемін!
Dialogue: 0,0:05:00.26,0:05:02.26,Default,,0,0,0,,О!
Dialogue: 0,0:05:02.26,0:05:06.97,Default,,0,0,0,,Bay Sponsor... Бұл керемет компания екеніне сенімдімін.
Dialogue: 0,0:05:10.94,0:05:12.91,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:05:12.91,0:05:17.88,Default,,0,0,0,,Уау, бұл үлкен компания сияқты!
Dialogue: 0,0:05:17.88,0:05:19.92,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:05:19.92,0:05:22.12,Default,,0,0,0,,О, олай емес. иә?
Dialogue: 0,0:05:22.12,0:05:25.59,Default,,0,0,0,,Осы жолмен Осы жолмен.
Dialogue: 0,0:05:25.59,0:05:27.59,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:05:27.59,0:05:30.26,Default,,0,0,0,,Не... не? Бұл ескі ғимарат.
Dialogue: 0,0:05:30.26,0:05:32.26,Default,,0,0,0,,Фуфуфуфу~н.
Dialogue: 0,0:05:32.26,0:05:35.26,Default,,0,0,0,,200 жылдан бері жұмыс істеп келе жатқан суши мейрамханасы!
Dialogue: 0,0:05:35.26,0:05:37.27,Default,,0,0,0,,Суши мейрамханасы! ?
Dialogue: 0,0:05:37.27,0:05:39.43,Default,,0,0,0,,Комаба суши!
Dialogue: 0,0:05:39.43,0:05:43.44,Default,,0,0,0,,Сонда мен жақсы шарттармен ұсыныс күтпедім...
Dialogue: 0,0:05:43.44,0:05:46.44,Default,,0,0,0,,Сіз қызыл бұршақ пастасы кремді суши жей аласыз!
Dialogue: 0,0:05:46.44,0:05:51.78,Default,,0,0,0,,Сіз Anno's Getemono өндірушісісіз бе? Мен солай ойладым.
Dialogue: 0,0:05:51.78,0:05:53.95,Default,,0,0,0,,Эй, сені осында көргеніме қуаныштымын!
Dialogue: 0,0:05:57.25,0:05:59.75,Default,,0,0,0,,Мына жақта, былай!
Dialogue: 0,0:05:59.75,0:06:03.93,Default,,0,0,0,,Қош келдіңіз Team Persona!
Dialogue: 0,0:06:06.09,0:06:10.10,Default,,0,0,0,,Мен Комаба суши компаниясының президентімін!
Dialogue: 0,0:06:10.10,0:06:13.00,Default,,0,0,0,,Бұл Мейко Мейден, хатшы.
Dialogue: 0,0:06:13.00,0:06:17.77,Default,,0,0,0,,Бүгін келгендеріңізге көп рахмет. Мен бұл күнді асыға күтемін...
Dialogue: 0,0:06:17.77,0:06:21.14,Default,,0,0,0,,Тайшо мырза! Сіз сол керемет сушиден ләззат ала аласыз➡
Dialogue: 0,0:06:21.14,0:06:24.75,Default,,0,0,0,,Оны әзірлеген сол! Мен үлкен жанкүйермін!
Dialogue: 0,0:06:24.75,0:06:26.75,Default,,0,0,0,,Бұл... бұл!
Dialogue: 0,0:06:26.75,0:06:29.12,Default,,0,0,0,,Мен үшін ең жақсысы қызыл бұршақ пастасы кремді суши➡
Dialogue: 0,0:06:29.12,0:06:33.49,Default,,0,0,0,,Мен сондай-ақ матча кудзу мочи сушиін және өткен жылғы шектеулі шығарылымдағы шикі ветчина қауын сушиін жақсы көремін!
Dialogue: 0,0:06:33.49,0:06:35.76,Default,,0,0,0,,Тозақ, маған көмектесіңізші!
Dialogue: 0,0:06:35.76,0:06:38.96,Default,,0,0,0,,Сізде осындай құмар жанкүйерлер барына қуаныштымын, Президент мырза.
Dialogue: 0,0:06:38.96,0:06:41.90,Default,,0,0,0,,Хия~ Тез тоқтата аласыз ба~!
Dialogue: 0,0:06:41.90,0:06:46.57,Default,,0,0,0,,Демеуші мен күткендей емес...
Dialogue: 0,0:06:46.57,0:06:51.24,Default,,0,0,0,,Жарайсыңдар, балалар мен сендермен келісім-шартқа отырғаныма қуаныштымын.
Dialogue: 0,0:06:51.24,0:06:55.24,Default,,0,0,0,,Өйткені мен бұрын кәсіпқой қулықшы болуға ұмтылатынмын.
Dialogue: 0,0:06:55.24,0:06:57.91,Default,,0,0,0,,Тайшо мырза? аа.
Dialogue: 0,0:06:57.91,0:07:02.42,Default,,0,0,0,,Ол кезде мен дүкенді жаңа ғана қолға алып, тым бос емес едім.
Dialogue: 0,0:07:02.42,0:07:05.32,Default,,0,0,0,,Басқарма да отқа оранды.
Dialogue: 0,0:07:05.32,0:07:07.76,Default,,0,0,0,,Соның ішінде қызыл бұршақ пастасы кремді суши➡
Dialogue: 0,0:07:07.76,0:07:11.23,Default,,0,0,0,,Сіз түпнұсқа суши әзірлеу үшін көп еңбек еттіңіз...
Dialogue: 0,0:07:11.23,0:07:13.93,Default,,0,0,0,,Менің ойымша, сондықтан нәтиже шықпады.
Dialogue: 0,0:07:13.93,0:07:17.27,Default,,0,0,0,,Бірақ мен бұрыннан шешім қабылдадым.
Dialogue: 0,0:07:17.27,0:07:19.57,Default,,0,0,0,,➡ атынан Bay демеушісі болыңыз
Dialogue: 0,0:07:19.57,0:07:23.27,Default,,0,0,0,,Менің армандарымды жүзеге асыра алатын команда болғанын қалаймын.
Dialogue: 0,0:07:23.27,0:07:27.24,Default,,0,0,0,,Біз сізге үлкен үміт артамыз! Иә, мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:07:27.24,0:07:29.91,Default,,0,0,0,,Дегенмен, қыранның арманы қандай?➡
Dialogue: 0,0:07:29.91,0:07:32.75,Default,,0,0,0,,Бұл тек кәсіби маман болу емес. иә?
Dialogue: 0,0:07:32.75,0:07:35.92,Default,,0,0,0,,Менің арманым – ең мықты кәсіби ойыншы болу.
Dialogue: 0,0:07:35.92,0:07:37.92,Default,,0,0,0,,Яғни ➡
Dialogue: 0,0:07:37.92,0:07:41.82,Default,,0,0,0,,X Tower шыңына көтеріліңіз!
Dialogue: 0,0:07:41.82,0:07:44.43,Default,,0,0,0,,Сондықтан бізге әлсіз жігіттер керек емес!
Dialogue: 0,0:07:44.43,0:07:47.26,Default,,0,0,0,,Иә! Балалар мен сендерді сынап көрейін.
Dialogue: 0,0:07:47.26,0:07:51.23,Default,,0,0,0,,Комаба суши демеуші бола ма, жоқ па➡
Dialogue: 0,0:07:51.23,0:07:54.07,Default,,0,0,0,,Қорытынды наразылық!
Dialogue: 0,0:07:54.07,0:07:56.57,Default,,0,0,0,,Не... не?! ? Эх! ?
Dialogue: 0,0:07:56.57,0:08:00.74,Default,,0,0,0,,Жарайды... Мен осылай кәсіпқой бола аламын деп ойладым...
Dialogue: 0,0:08:00.74,0:08:02.91,Default,,0,0,0,,Тек өту керек, солай ма?
Dialogue: 0,0:08:02.91,0:08:04.91,Default,,0,0,0,,(Кацуми) Бұл не деген сөз өзі…? Бо-бо-бо-бо-бон!
Dialogue: 0,0:08:04.91,0:08:08.72,Default,,0,0,0,,Сынақ өтетін орын алда!
Dialogue: 0,0:08:11.09,0:08:15.46,Default,,0,0,0,,Стадион! Жер асты қоймасы күрделі жөндеуден өтті.
Dialogue: 0,0:08:15.46,0:08:19.06,Default,,0,0,0,,Сіздің арқаңызда тағы да үлкен тапшылыққа тап болдық. Уф...
Dialogue: 0,0:08:19.06,0:08:21.76,Default,,0,0,0,,Тест Бейбатл ма? Тезірек жасайық!
Dialogue: 0,0:08:21.76,0:08:26.40,Default,,0,0,0,,Аа, егер сіз шыңға шыққан болсаңыз, емтиханды тапсырып қойғансыз.
Dialogue: 0,0:08:26.40,0:08:29.40,Default,,0,0,0,,Сынақтың қажеті жоқ, Куросу Экс-кун.
Dialogue: 0,0:08:29.40,0:08:32.34,Default,,0,0,0,,А... неге сіздің шынайы болмысыңыз?
Dialogue: 0,0:08:32.34,0:08:36.41,Default,,0,0,0,,Сіз басқа тарапты міндетті түрде тексеруіңіз керек.
Dialogue: 0,0:08:36.41,0:08:38.91,Default,,0,0,0,,Не? Қазір➡
Dialogue: 0,0:08:38.91,0:08:41.75,Default,,0,0,0,,Казами Құс-күн Жеті түсті Мульти-кун.
Dialogue: 0,0:08:41.75,0:08:45.15,Default,,0,0,0,,Екі адам тапсыратын тесттің мазмұны қандай?
Dialogue: 0,0:08:48.16,0:08:53.56,Default,,0,0,0,,Аидпен Бейбатл өткізіңіз және олардың кем дегенде біреуі жеңуі керек!
Dialogue: 0,0:08:53.56,0:08:55.73,Default,,0,0,0,,Аа...
Dialogue: 0,0:08:55.73,0:08:58.40,Default,,0,0,0,,Хмм, бұл не? Реакция қандай?
Dialogue: 0,0:08:58.40,0:09:00.64,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:09:00.64,0:09:05.11,Default,,0,0,0,,Мен кәсіби маман болуды мақсат еттім. Мен күткендей, мен әуесқойды жеңе алмаймын.
Dialogue: 0,0:09:05.11,0:09:07.54,Default,,0,0,0,,Дұрыс... Иә?
Dialogue: 0,0:09:07.54,0:09:10.75,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:09:12.95,0:09:16.45,Default,,0,0,0,,Олай болса, бастайық па?
Dialogue: 0,0:09:20.36,0:09:23.46,Default,,0,0,0,,Қорытынды наразылық 1 раунд!
Dialogue: 0,0:09:23.46,0:09:25.93,Default,,0,0,0,,Бір минут күтіңіз! Бұл не? Бұл не?
Dialogue: 0,0:09:25.93,0:09:28.13,Default,,0,0,0,,Менің де шайқасқым келеді!
Dialogue: 0,0:09:28.13,0:09:31.00,Default,,0,0,0,,Бір адамды сыртта қалдыру өте қулық!
Dialogue: 0,0:09:31.00,0:09:34.04,Default,,0,0,0,,Бірақ... Бірақ. Сонымен….
Dialogue: 0,0:09:34.04,0:09:38.11,Default,,0,0,0,,Менен кем дегенде 2 рет жеңсең, соның ішінде Экс мырза➡
Dialogue: 0,0:09:38.11,0:09:41.14,Default,,0,0,0,,Өтуге қалай қарайсың?
Dialogue: 0,0:09:41.14,0:09:43.65,Default,,0,0,0,,Хм, егер Аидтер солай айтса...
Dialogue: 0,0:09:43.65,0:09:45.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:45.68,0:09:47.78,Default,,0,0,0,,Алдымен байқап көргіңіз келе ме?
Dialogue: 0,0:09:47.78,0:09:50.42,Default,,0,0,0,,Иә? Бұл жақсы ма? Ілгері жүру!
Dialogue: 0,0:09:50.42,0:09:53.92,Default,,0,0,0,,Неге? Уф….
Dialogue: 0,0:09:53.92,0:09:57.13,Default,,0,0,0,,Қорытынды наразылық 1 раунд!
Dialogue: 0,0:09:57.13,0:10:00.26,Default,,0,0,0,,Kurosu Ex және Meiko Meiden!
Dialogue: 0,0:10:00.26,0:10:04.23,Default,,0,0,0,,Осы Shark Edge сіздің серіктесіңіз болсын.
Dialogue: 0,0:10:08.40,0:10:10.41,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:10:10.41,0:10:13.91,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:10:13.91,0:10:16.41,Default,,0,0,0,,Қой!
Dialogue: 0,0:10:21.38,0:10:23.42,Default,,0,0,0,,Екеуі де жылдам!
Dialogue: 0,0:10:23.42,0:10:27.96,Default,,0,0,0,,Мен Shark Edge-ге келе жатырмын.
Dialogue: 0,0:10:27.96,0:10:29.96,Default,,0,0,0,,Мен оны орнаттым!
Dialogue: 0,0:10:42.14,0:10:44.91,Default,,0,0,0,,Доран семсер аяқталды!
Dialogue: 0,0:10:44.91,0:10:46.91,Default,,0,0,0,,Kurosu Ex жеңісі!
Dialogue: 0,0:10:46.91,0:10:50.61,Default,,0,0,0,,Уау~ Лезде өлтіру!
Dialogue: 0,0:10:50.61,0:10:53.95,Default,,0,0,0,,Бұрыш шабуылдың алдында өзгерді.
Dialogue: 0,0:10:53.95,0:10:56.58,Default,,0,0,0,,Жоқ, ол адам...
Dialogue: 0,0:10:56.58,0:11:00.05,Default,,0,0,0,,Сіздің шеберлігіңіз күткендей, Экс мырза.
Dialogue: 0,0:11:03.76,0:11:06.26,Default,,0,0,0,,Жарайды, мен де істеймін!
Dialogue: 0,0:11:06.26,0:11:08.23,Default,,0,0,0,,Мм... Сәттілік.
Dialogue: 0,0:11:08.23,0:11:14.27,Default,,0,0,0,,2-раунд Казами Құсы Мейко Мейдонға қарсы!
Dialogue: 0,0:11:14.27,0:11:16.30,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:11:16.30,0:11:19.91,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:11:19.91,0:11:24.08,Default,,0,0,0,,Қой!
Dialogue: 0,0:11:24.08,0:11:27.38,Default,,0,0,0,,Жылдам шабуыл! Тозақтың өлшемі!
Dialogue: 0,0:11:30.25,0:11:32.42,Default,,0,0,0,,Жақсы, жүр! !
Dialogue: 0,0:11:37.89,0:11:41.60,Default,,0,0,0,,Тым күшті. Содан мен тепе-теңдікті жоғалттым ...
Dialogue: 0,0:11:41.60,0:11:44.57,Default,,0,0,0,,Барлығын бірден итеріңіз! Тозақтың өлшемі!
Dialogue: 0,0:11:44.57,0:11:46.57,Default,,0,0,0,,Құс мырза.
Dialogue: 0,0:11:46.57,0:11:50.37,Default,,0,0,0,,Онда жүзуге тыйым салынады.
Dialogue: 0,0:11:55.08,0:11:57.08,Default,,0,0,0,,Төмен!
Dialogue: 0,0:11:57.08,0:11:59.68,Default,,0,0,0,,Көк азу!
Dialogue: 0,0:12:03.25,0:12:05.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.25,0:12:08.09,Default,,0,0,0,,Shark Edge Burst Finish.
Dialogue: 0,0:12:08.09,0:12:11.09,Default,,0,0,0,,Мейко Мейконың жеңісі!
Dialogue: 0,0:12:13.09,0:12:17.00,Default,,0,0,0,,Төмен позициядан қарсыластың кеудесіне жасалған тура шабуыл.
Dialogue: 0,0:12:17.00,0:12:21.74,Default,,0,0,0,,Су астында акуладай аңдып, жауды тістейді.
Dialogue: 0,0:12:21.74,0:12:26.44,Default,,0,0,0,,Бұл Shark Edge күші.
Dialogue: 0,0:12:26.44,0:12:31.11,Default,,0,0,0,,《Ол тым күшті... Мынау кім?》
Dialogue: 0,0:12:36.08,0:12:39.39,Default,,0,0,0,,Бұл өтірік, солай ма? Мен Мейденнің соншалықты күшті болғанына сене алар емеспін!
Dialogue: 0,0:12:39.39,0:12:42.72,Default,,0,0,0,,Фофофофо! Бұл дұрыс!
Dialogue: 0,0:12:42.72,0:12:47.06,Default,,0,0,0,,Өйткені, Мейден бұрынғы кәсіпқой қулықшы.
Dialogue: 0,0:12:47.06,0:12:49.06,Default,,0,0,0,,Нашар жұмысыңыз үшін кешірім сұраймыз.
Dialogue: 0,0:12:49.06,0:12:51.43,Default,,0,0,0,,Сондай-ақ… Бұрынғы кәсіпқой! ?
Dialogue: 0,0:12:51.43,0:12:58.01,Default,,0,0,0,,Барлығының шайқас жазбалары мен стилін талдағаннан кейін, менің Экс мырзаға жеңілу ықтималдығым ➡
Dialogue: 0,0:12:58.01,0:13:01.74,Default,,0,0,0,,Консервативті бағалау 96,9% құрайды.
Dialogue: 0,0:13:01.74,0:13:05.38,Default,,0,0,0,,Ал Лорд Бердтен жеңілу ықтималдығы ➡
Dialogue: 0,0:13:05.38,0:13:07.88,Default,,0,0,0,,Ол 0% болды. Не!
Dialogue: 0,0:13:07.88,0:13:11.05,Default,,0,0,0,,Өйткені, мен Экс➡-ге қарсы күрескен кезде
Dialogue: 0,0:13:11.05,0:13:14.76,Default,,0,0,0,,Мен жағдайды бір соққымен реттеуге болатындай етіп реттедім.
Dialogue: 0,0:13:14.76,0:13:17.89,Default,,0,0,0,,Сіз шайқассаңыз да, нәтижесін көре аласыз➡
Dialogue: 0,0:13:17.89,0:13:21.73,Default,,0,0,0,,Жақында аяқталады деп пе едіңіз?
Dialogue: 0,0:13:21.73,0:13:24.90,Default,,0,0,0,,Кух…. Шабуыл бұрышы ➡
Dialogue: 0,0:13:24.90,0:13:27.37,Default,,0,0,0,,Реттелуде... Иә?
Dialogue: 0,0:13:29.40,0:13:31.91,Default,,0,0,0,,Мен бұл жай ғана біреу емес деп ойладым!
Dialogue: 0,0:13:31.91,0:13:34.48,Default,,0,0,0,,Не? Әдейі жеңіліп қалсаңыз➡
Dialogue: 0,0:13:34.48,0:13:38.25,Default,,0,0,0,,Алдыңғысы рұқсатсыз болды! Тағы бір ұрысайық! Тағы бір шайқас!
Dialogue: 0,0:13:38.25,0:13:41.25,Default,,0,0,0,,Міндетті емес.
Dialogue: 0,0:13:41.25,0:13:45.72,Default,,0,0,0,,Комаба суши басқа демеуші компаниялармен салыстырғанда➡
Dialogue: 0,0:13:45.72,0:13:48.72,Default,,0,0,0,,Біз шағын компаниямыз.
Dialogue: 0,0:13:48.72,0:13:53.76,Default,,0,0,0,,X Tower шыңы президенттің көптен күткен тілегі болды.
Dialogue: 0,0:13:53.76,0:13:56.30,Default,,0,0,0,,Егер сіз инвестиция салғыңыз келсе➡
Dialogue: 0,0:13:56.30,0:13:58.93,Default,,0,0,0,,Құнды кадрларды инвестициялау...
Dialogue: 0,0:13:58.93,0:14:04.41,Default,,0,0,0,,Егер сіз міндетті түрде жеңе алатын пышақ болмасаңыз, бұл мағынасыз.
Dialogue: 0,0:14:07.24,0:14:12.71,Default,,0,0,0,,Баршаңызға қатысты мен бар күшімді саламын!
Dialogue: 0,0:14:15.72,0:14:19.09,Default,,0,0,0,,Енді ақтық шайқасқа барайық!
Dialogue: 0,0:14:19.09,0:14:23.06,Default,,0,0,0,,Марути-сама жеңіске жетпесе, сіз өте алмайсыз.
Dialogue: 0,0:14:23.06,0:14:27.46,Default,,0,0,0,,Бұл... бұл жасырын! Бұрынғы кәсіпқоймен бәсекеге түсе алмаймын!
Dialogue: 0,0:14:27.46,0:14:30.40,Default,,0,0,0,,Дөрекі болма, Құс. не! ?
Dialogue: 0,0:14:30.40,0:14:33.90,Default,,0,0,0,,Біз бұдан былай кәсіпқойлармен жұмыс жасайтын боламыз.
Dialogue: 0,0:14:33.90,0:14:36.40,Default,,0,0,0,,Мен бұрынғы кәсіпқойдан жеңіле алмаймын.
Dialogue: 0,0:14:36.40,0:14:40.74,Default,,0,0,0,,А... Бұл өкінішті жаңалық, Мульти мырза.
Dialogue: 0,0:14:40.74,0:14:44.38,Default,,0,0,0,,Біз сіздің алдыңғы сәйкестіктеріңізді де талдаймыз.
Dialogue: 0,0:14:44.38,0:14:49.58,Default,,0,0,0,,Ол бұл жолы түнгі қалқанды қолданады деген болжам ауқымында болды.
Dialogue: 0,0:14:49.58,0:14:53.55,Default,,0,0,0,,Shark Edge-тің Night Shield-тен жеңілу ықтималдығы ➡
Dialogue: 0,0:14:53.55,0:14:56.56,Default,,0,0,0,,0%.
Dialogue: 0,0:14:56.56,0:14:58.73,Default,,0,0,0,,Міне...
Dialogue: 0,0:14:58.73,0:15:01.43,Default,,0,0,0,,Ол бұрынғы кәсіпқой.
Dialogue: 0,0:15:01.43,0:15:04.90,Default,,0,0,0,,Кәсіби болсаң, майданда соғыссаң➡
Dialogue: 0,0:15:04.90,0:15:07.37,Default,,0,0,0,,Үнемі даму керек.
Dialogue: 0,0:15:10.07,0:15:14.58,Default,,0,0,0,,Дамуды жалғастырып келе жатқан мен үшін тамаша шығанақ...
Dialogue: 0,0:15:14.58,0:15:17.48,Default,,0,0,0,,Міне, түнгі найза!
Dialogue: 0,0:15:17.48,0:15:21.05,Default,,0,0,0,,Жаңа шығанақтар әлі бар ма?
Dialogue: 0,0:15:21.05,0:15:23.72,Default,,0,0,0,,Енді қызық болып барады!
Dialogue: 0,0:15:23.72,0:15:28.89,Default,,0,0,0,,3-ші тур Жеті түсті мульти-Мейко Мейденге қарсы!
Dialogue: 0,0:15:28.89,0:15:31.39,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:15:31.39,0:15:34.76,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:15:34.76,0:15:37.27,Default,,0,0,0,,Қой!
Dialogue: 0,0:15:41.57,0:15:43.74,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:43.74,0:15:47.54,Default,,0,0,0,,Осылай еңкейіп... ату сәтсіздігі?
Dialogue: 0,0:15:47.54,0:15:51.21,Default,,0,0,0,,Жоқ, Марути әдейі бұрыштан атып жіберді.
Dialogue: 0,0:15:51.21,0:15:53.21,Default,,0,0,0,,Мақсат бойынша?
Dialogue: 0,0:15:59.55,0:16:04.43,Default,,0,0,0,,Сіз егжей-тегжейлі еліктеу жасап жатырсыз. Бірақ бірдей нәрсе!
Dialogue: 0,0:16:04.43,0:16:08.06,Default,,0,0,0,,Мен оны Көк Азуға да беремін.
Dialogue: 0,0:16:08.06,0:16:10.53,Default,,0,0,0,,Shark Edge шабуылы!
Dialogue: 0,0:16:14.24,0:16:17.24,Default,,0,0,0,,Ах! Не! ? Ха….
Dialogue: 0,0:16:17.24,0:16:20.58,Default,,0,0,0,,Сіз оны соққыға алдыңыз ба? Уақыт өте жақсы болды!
Dialogue: 0,0:16:20.58,0:16:23.21,Default,,0,0,0,,Түнгі Лэнстің бұлдыраған жетекі➡
Dialogue: 0,0:16:23.21,0:16:26.38,Default,,0,0,0,,Мен шабуылдың алдын алдым! Қанекей мынаны істейік!
Dialogue: 0,0:16:26.38,0:16:28.38,Default,,0,0,0,,Бұл бәрі емес!
Dialogue: 0,0:16:28.38,0:16:31.75,Default,,0,0,0,,Мен науаны неге қисайттым?
Dialogue: 0,0:16:31.75,0:16:36.89,Default,,0,0,0,,Биік Түнгі найзаны одан да жоғары еңкейтіңіз!
Dialogue: 0,0:16:36.89,0:16:40.16,Default,,0,0,0,,Сүңгуір Shark Edge-ге жоғарыдан шабуыл жасаңыз!
Dialogue: 0,0:16:43.73,0:16:45.90,Default,,0,0,0,,Енді бұл акулаларды аулау!
Dialogue: 0,0:16:45.90,0:16:49.10,Default,,0,0,0,,Жаңбырлы найза!
Dialogue: 0,0:16:55.88,0:16:58.88,Default,,0,0,0,,Түнгі найза аяқталды!
Dialogue: 0,0:16:58.88,0:17:01.55,Default,,0,0,0,,Жеті түсті көп жеңіс!
Dialogue: 0,0:17:01.55,0:17:03.72,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:17:03.72,0:17:05.75,Default,,0,0,0,,Хмф!
Dialogue: 0,0:17:05.75,0:17:07.72,Default,,0,0,0,,Менің күткенімнен асып түсті➡
Dialogue: 0,0:17:07.72,0:17:11.89,Default,,0,0,0,,Shark Edge-ті жеңудің дәлелденген қабілеті.
Dialogue: 0,0:17:14.26,0:17:17.13,Default,,0,0,0,,Керемет жұмысыңыз үшін рахмет.
Dialogue: 0,0:17:20.77,0:17:22.80,Default,,0,0,0,,Көп ойыншы жеңді...
Dialogue: 0,0:17:22.80,0:17:25.54,Default,,0,0,0,,Сонымен... Мм.
Dialogue: 0,0:17:25.54,0:17:27.54,Default,,0,0,0,,Сіз сынақтан өттіңіз!
Dialogue: 0,0:17:27.54,0:17:29.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:29.91,0:17:31.98,Default,,0,0,0,,Күте тұрыңыз... бұл тітіркендіргіш.
Dialogue: 0,0:17:31.98,0:17:34.72,Default,,0,0,0,,Енді мен ресми түрде кәсіпқоймын!
Dialogue: 0,0:17:34.72,0:17:37.22,Default,,0,0,0,,X Tower шыңына ұмтылыңыз!
Dialogue: 0,0:17:37.22,0:17:39.22,Default,,0,0,0,,Тым толқыдым.
Dialogue: 0,0:17:39.22,0:17:42.19,Default,,0,0,0,,Мм, бұл жастық.
Dialogue: 0,0:17:46.23,0:17:50.06,Default,,0,0,0,,Бүгін үлкен қан кету қызметі! Mega Big Anko Cream Sushi➡
Dialogue: 0,0:17:50.06,0:17:54.04,Default,,0,0,0,,Барлығын жеуге болады! Алақай!
Dialogue: 0,0:17:54.04,0:17:58.21,Default,,0,0,0,,Хмм, міне, солай! Мульча жемеңіз!
Dialogue: 0,0:17:58.21,0:18:01.21,Default,,0,0,0,,Жоқ, менің тілім нәзік...
Dialogue: 0,0:18:01.21,0:18:03.21,Default,,0,0,0,,Не? Сонымен Құс!
Dialogue: 0,0:18:03.21,0:18:05.88,Default,,0,0,0,,Эй, мен қазір аш емеспін!
Dialogue: 0,0:18:05.88,0:18:08.38,Default,,0,0,0,,Мен жасаған сушиді жей алмайсың ба?
Dialogue: 0,0:18:08.38,0:18:10.75,Default,,0,0,0,,Уф... Түсіндім!
Dialogue: 0,0:18:10.75,0:18:12.79,Default,,0,0,0,,Матча кудзу мочи суши жақсырақ болды ма?
Dialogue: 0,0:18:12.79,0:18:14.89,Default,,0,0,0,,Бұл емес!
Dialogue: 0,0:18:14.89,0:18:17.66,Default,,0,0,0,,Біз кәдімгі сушиді де ұсына аламыз.
Dialogue: 0,0:18:19.73,0:18:23.40,Default,,0,0,0,,Демеушілік келісім-шартқа қол қою кезінде тіркелу қажет...
Dialogue: 0,0:18:23.40,0:18:26.53,Default,,0,0,0,,Сіз әлі топ басшысын таңдадыңыз ба?
Dialogue: 0,0:18:26.53,0:18:29.70,Default,,0,0,0,,Ойланып қарасам, әлі шешкен жоқпын.
Dialogue: 0,0:18:29.70,0:18:34.21,Default,,0,0,0,,Топ басшысы? Бұл дұрыс...
Dialogue: 0,0:18:34.21,0:18:38.61,Default,,0,0,0,,Сіз оны Ex-ға қалдыра аласыз деп ойлайсыз ба? Аа...
Dialogue: 0,0:18:38.61,0:18:40.88,Default,,0,0,0,,Сонда? Мен мұны істей алмаймын.
Dialogue: 0,0:18:40.88,0:18:43.38,Default,,0,0,0,,Мен Персонаны насихаттаумен айналысамын.
Dialogue: 0,0:18:43.38,0:18:46.89,Default,,0,0,0,,Сонымен не істеуіміз керек? иә?
Dialogue: 0,0:18:46.89,0:18:49.66,Default,,0,0,0,,Гэез. О?
Dialogue: 0,0:18:56.90,0:18:58.93,Default,,0,0,0,,Мен! ?
Dialogue: 0,0:18:58.93,0:19:01.00,Default,,0,0,0,,Тағы кім бар?
Dialogue: 0,0:19:01.00,0:19:03.57,Default,,0,0,0,,Жоқ, жоқ, жоқ! Менен басқа жұмысқа лайықты адам бар!
Dialogue: 0,0:19:03.57,0:19:06.07,Default,,0,0,0,,Танысқаныма қуаныштымын, Көшбасшы! иә?
Dialogue: 0,0:19:06.07,0:19:10.21,Default,,0,0,0,,«Адамды лауазым жасайды» деген сөз де бар.
Dialogue: 0,0:19:10.21,0:19:13.21,Default,,0,0,0,,Бұл сізге қолайлы болуы мүмкін. Ха!
Dialogue: 0,0:19:13.21,0:19:15.55,Default,,0,0,0,,Енді осылай тіркейік.
Dialogue: 0,0:19:15.55,0:19:17.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:17.55,0:19:20.72,Default,,0,0,0,,Жарайды, тағы да, Persona командасы➡
Dialogue: 0,0:19:20.72,0:19:23.22,Default,,0,0,0,,Демеушісі Комаба Суши➡
Dialogue: 0,0:19:23.22,0:19:26.19,Default,,0,0,0,,X Tower Challenge!
Dialogue: 0,0:19:26.19,0:19:30.56,Default,,0,0,0,,О! Шынайы ма?
Dialogue: 0,0:19:30.56,0:19:34.40,Default,,0,0,0,,Жерасты стадионын өз қалауыңызша пайдалана аласыз.
Dialogue: 0,0:19:34.40,0:19:37.44,Default,,0,0,0,,Тұрғын бөлмелер де бар.
Dialogue: 0,0:19:37.44,0:19:40.54,Default,,0,0,0,,Мен осында тұра аламын ба? Алақай!
Dialogue: 0,0:19:40.54,0:19:44.05,Default,,0,0,0,,Ақыр соңында, бұл шығанақ демеуші!
Dialogue: 0,0:19:44.05,0:19:46.88,Default,,0,0,0,,Фофофофо!
Dialogue: 0,0:19:46.88,0:19:49.42,Default,,0,0,0,,Неліктен? ?
Dialogue: 0,0:19:49.42,0:19:52.39,Default,,0,0,0,,Неліктен Экс екеуміз бір бөлмедеміз?
Dialogue: 0,0:19:52.39,0:19:54.39,Default,,0,0,0,,Және бұл тар!
Dialogue: 0,0:19:54.39,0:19:57.56,Default,,0,0,0,,Менің жүкім көп.
Dialogue: 0,0:19:57.56,0:20:01.23,Default,,0,0,0,,Бұл соңы. рақмет сізге.
Dialogue: 0,0:20:01.23,0:20:04.90,Default,,0,0,0,,Мысалы, маған айтыңызшы!
Dialogue: 0,0:20:04.90,0:20:07.37,Default,,0,0,0,,Үлпілдек. Эй!
Dialogue: 0,0:20:09.37,0:20:11.77,Default,,0,0,0,,Тазалау құралдары осында қол жетімді.
Dialogue: 0,0:20:11.77,0:20:14.31,Default,,0,0,0,,Жоғарыда айтқанымдай, бізде бюджет жоқ➡
Dialogue: 0,0:20:14.31,0:20:17.21,Default,,0,0,0,,Өзіңізге қамқорлық жасаңыз.
Dialogue: 0,0:20:17.21,0:20:19.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:19.21,0:20:23.38,Default,,0,0,0,,Эй, жаңа ірімшік тайяки сушиі дайын!
Dialogue: 0,0:20:23.38,0:20:26.55,Default,,0,0,0,,Жеңдер! Кеттік құс!
Dialogue: 0,0:20:26.55,0:20:28.56,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:20:28.56,0:20:32.36,Default,,0,0,0,,Маған керек емес! !
Dialogue: 0,0:20:36.06,0:20:42.84,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:20:49.41,0:20:52.55,Default,,0,0,0,,Иә? (шу)
Dialogue: 0,0:20:52.55,0:20:55.22,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:20:55.22,0:20:58.55,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:20:58.55,0:21:01.16,Default,,0,0,0,,Қой!
Dialogue: 0,0:21:06.66,0:21:08.56,Default,,0,0,0,,Мен кәсіпқой болдым.
Dialogue: 0,0:21:08.56,0:21:11.07,Default,,0,0,0,,Сіз мәңгілікке ұтыла аласыз ба?
Dialogue: 0,0:21:11.07,0:21:13.73,Default,,0,0,0,,Қой!
Dialogue: 0,0:21:13.73,0:21:15.70,Default,,0,0,0,,Уф! !
Dialogue: 0,0:21:19.71,0:21:22.14,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:21:22.14,0:21:24.04,Default,,0,0,0,,Тағы бір нәрсе...
Dialogue: 0,0:21:24.04,0:21:27.41,Default,,0,0,0,,Үш екі!
Dialogue: 0,0:21:27.41,0:21:30.92,Default,,0,0,0,,Іске қосу құралын ұстау тәсілі дұрыс емес.
Dialogue: 0,0:21:30.92,0:21:33.72,Default,,0,0,0,,Бұл жай ғана соқыр ату емес.
Dialogue: 0,0:21:33.72,0:21:37.63,Default,,0,0,0,,Қараңдар, өзіңді дұрыс ретте. иә?
Dialogue: 0,0:21:39.73,0:21:42.23,Default,,0,0,0,,Менің амалым жоқ, сондықтан мен сенімен бірге боламын!
Dialogue: 0,0:21:42.23,0:21:44.90,Default,,0,0,0,,Көп!
Dialogue: 0,0:21:44.90,0:21:48.74,Default,,0,0,0,,Ах! Екеуі жаттығуда!
Dialogue: 0,0:21:48.74,0:21:50.81,Default,,0,0,0,,Мен де істеймін!
Dialogue: 0,0:21:50.81,0:21:55.04,Default,,0,0,0,,О, жасайық! Шу көбейді.
Dialogue: 0,0:21:55.04,0:21:57.41,Default,,0,0,0,,Онда мен төреші боламын.
Dialogue: 0,0:21:57.41,0:21:59.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:59.58,0:22:02.48,Default,,0,0,0,,Жарайды. Жарайды, маған жаттығуыңның нәтижесін көрсет, Құс.
Dialogue: 0,0:22:02.48,0:22:05.45,Default,,0,0,0,,Егер олар...
Dialogue: 0,0:22:11.39,0:22:18.07,Default,,0,0,0,,Мүмкін олар менің арманымды жүзеге асыра алар.
Dialogue: 0,0:22:18.07,0:22:23.14,Default,,0,0,0,,Жоғарыға барайық!
Dialogue: 0,0:22:30.21,0:22:33.08,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:22:34.58,0:22:40.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory