Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.10,0:00:04.93,Default,,0,0,0,,Х... Адамдарды қызықтыратын нәрсе.
Dialogue: 0,0:00:05.69,0:00:09.01,Default,,0,0,0,,Бейблейд ойын ма? Бұл спорт па?
Dialogue: 0,0:00:10.37,0:00:12.45,Default,,0,0,0,,Х-тің максималды үдеуі
Dialogue: 0,0:00:12.65,0:00:15.61,Default,,0,0,0,,Экстремалды ойын.
Dialogue: 0,0:00:16.98,0:00:19.50,Default,,0,0,0,,X сіздің қолыңызда
Dialogue: 0,0:00:24.81,0:00:27.16,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:00:27.16,0:00:30.31,Default,,0,0,0,,Соңында, Team Persona және Team Zooganic
Dialogue: 0,0:00:30.31,0:00:32.48,Default,,0,0,0,,Шайқас басталды!
Dialogue: 0,0:00:32.48,0:00:34.50,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:34.50,0:00:37.99,Default,,0,0,0,,Team Zooganic командасы Persona командасына ұқсас.
Dialogue: 0,0:00:37.99,0:00:41.49,Default,,0,0,0,,Бұл кәсіпқойға айналған жаңа команда.
Dialogue: 0,0:00:41.49,0:00:45.16,Default,,0,0,0,,Ауада бір күшті күш бар.
Dialogue: 0,0:00:45.16,0:00:49.85,Default,,0,0,0,,Бірінші шайқаста Персонаның жеті түсті көп ойыншысы
Dialogue: 0,0:00:49.85,0:00:53.50,Default,,0,0,0,,Миллиардер Тогуромен күрес...
Dialogue: 0,0:00:53.50,0:00:56.84,Default,,0,0,0,,Шебер көрсеткісін көрсетіңіз!
Dialogue: 0,0:00:56.84,0:01:01.16,Default,,0,0,0,,Миражды қайтару!
Dialogue: 0,0:01:01.16,0:01:05.01,Default,,0,0,0,,Ол тамаша жеңіске жетті.
Dialogue: 0,0:01:05.01,0:01:07.35,Default,,0,0,0,,〓(Ниго) Жеті түсті көп жеңіс.
Dialogue: 0,0:01:07.35,0:01:10.52,Default,,0,0,0,,Келесі, екінші шайқаста
Dialogue: 0,0:01:10.52,0:01:17.99,Default,,0,0,0,,Зуганичтің Чо Пан Казами құсын басып қалды...
Dialogue: 0,0:01:17.99,0:01:28.17,Default,,0,0,0,,Оны үрлейміз, Ринохорн!
Dialogue: 0,0:01:28.17,0:01:31.61,Default,,0,0,0,,Күшіміздегі айырмашылықты көрсетіп, жеңіске жеттік.
Dialogue: 0,0:01:31.61,0:01:35.51,Default,,0,0,0,,Енді біресе, үшінші шайқас аяқталды.
Dialogue: 0,0:01:35.51,0:01:39.50,Default,,0,0,0,,Ол Камен Х-мен бәсекеге түседі.
Dialogue: 0,0:01:39.50,0:01:42.17,Default,,0,0,0,,Он мың аң патшасының ойыншысы!
Dialogue: 0,0:01:42.17,0:01:46.15,Default,,0,0,0,,Бұл бір-бірінің командасын басқаратын екі талантты адамның шайқасы.
Dialogue: 0,0:01:46.15,0:01:49.17,Default,,0,0,0,,Кім жеңеді?
Dialogue: 0,0:01:49.17,0:01:52.02,Default,,0,0,0,,Сіз бұл шайқасты жіберіп алмайсыз!
Dialogue: 0,0:01:54.78,0:01:57.00,On Top,,0,0,0,,Бір уақытта бір қадам
Dialogue: 0,0:01:57.00,0:01:59.94,On Top,,0,0,0,,Қанша уақыт қажет болса да
Dialogue: 0,0:02:03.67,0:02:05.63,On Top,,0,0,0,,Мен көтерілуді жасаймын
Dialogue: 0,0:02:05.63,0:02:08.18,On Top,,0,0,0,,Мен жіберген қателіктерден сабақ ал
Dialogue: 0,0:02:12.26,0:02:18.18,On Top,,0,0,0,,Жүрегіңізді ашыңыз және жаңа әлем ашыңыз
Dialogue: 0,0:02:21.06,0:02:27.40,On Top,,0,0,0,,Мен сені сонда апарамын, енді тұйық жол жоқ
Dialogue: 0,0:02:29.54,0:02:32.36,On Top,,0,0,0,,Мен мұны айтамын, қолымнан ештеңе келмейді.
Dialogue: 0,0:02:32.36,0:02:38.20,On Top,,0,0,0,,Жауап жоқ заманда не ойлайсың?
Dialogue: 0,0:02:38.45,0:02:40.62,On Top,,0,0,0,,Таяқтар мен тастар ешқашан болмайды
Dialogue: 0,0:02:40.62,0:02:42.58,On Top,,0,0,0,,Мына сүйектерді сындыр
Dialogue: 0,0:02:42.58,0:02:44.70,On Top,,0,0,0,,Бір уақытта бір қадам
Dialogue: 0,0:02:44.70,0:02:47.56,On Top,,0,0,0,,Қанша уақыт қажет болса да
Dialogue: 0,0:02:51.09,0:02:53.34,On Top,,0,0,0,,Мен көтерілуді жасаймын
Dialogue: 0,0:02:53.34,0:02:56.07,On Top,,0,0,0,,Мен жіберген қателіктерден сабақ ал
Dialogue: 0,0:02:58.84,0:03:03.32,On Top,,0,0,0,,Ал мен оны саған дәлелдеймін, сен оны дәлелде
Dialogue: 0,0:03:04.06,0:03:07.77,On Top,,0,0,0,,Оны сізге дәлелдеңіз, күмәнсіз дәлелдеңіз
Dialogue: 0,0:03:07.77,0:03:10.23,On Top,,0,0,0,,Маған бір мүмкіндікті бір мүмкіндік беріңіз
Dialogue: 0,0:03:10.23,0:03:13.35,On Top,,0,0,0,,Сондықтан мен сізге дәлелдей аламын
Dialogue: 0,0:03:15.61,0:03:18.62,On Top,,0,0,0,,Сондықтан мен сізге дәлелдей аламын
Dialogue: 0,0:03:26.20,0:03:28.20,Default,,0,0,0,,Маска және Арыстан патша
Dialogue: 0,0:03:28.54,0:03:31.86,Default,,0,0,0,,Үшінші шайқас!
Dialogue: 0,0:03:38.02,0:03:41.54,Default,,0,0,0,,Мен сенің бұл масканың артында не жасырып тұрғаныңды білмеймін.
Dialogue: 0,0:03:41.54,0:03:46.53,Default,,0,0,0,,Кім болсаң да, нәтиже өзгермейді.
Dialogue: 0,0:03:46.53,0:03:50.20,Default,,0,0,0,,Сіз сөйлессеңіз де шайқас басталмайды.
Dialogue: 0,0:03:50.20,0:03:53.85,Default,,0,0,0,,Тез тексеріп көрейік. Мінеки.
Dialogue: 0,0:03:53.85,0:03:55.84,Default,,0,0,0,,Кахахахахахахаха!
Dialogue: 0,0:03:55.84,0:04:00.01,Default,,0,0,0,,Сіз өте сенімді сияқтысыз. Бірақ...
Dialogue: 0,0:04:00.01,0:04:05.88,Default,,0,0,0,,Мен сенің бекіңді, оның ішінде әлгі ақымақ масканы да жыртамын.
Dialogue: 0,0:04:05.88,0:04:08.18,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:04:08.18,0:04:12.69,Default,,0,0,0,,Бұл Камен Х пен Банджу Кинг арасындағы матч!
Dialogue: 0,0:04:12.69,0:04:15.61,Default,,0,0,0,,Сәттілік~ Патша! Өтінемін жеңіңіз!
Dialogue: 0,0:04:15.61,0:04:26.00,Default,,0,0,0,,Персонаны өлтіріңіз!
Dialogue: 0,0:04:26.00,0:04:29.67,Default,,0,0,0,,Соңғы патша шешеді.
Dialogue: 0,0:04:29.67,0:04:32.17,Default,,0,0,0,,Қарапайымырақ қараңыз.
Dialogue: 0,0:04:32.17,0:04:35.04,Default,,0,0,0,,Қараңдар, Тогуро да жейді.
Dialogue: 0,0:04:35.04,0:04:39.11,Default,,0,0,0,,Бұл біздің дебюттік матчымыздың соңы бола ма?
Dialogue: 0,0:04:39.11,0:04:41.52,Default,,0,0,0,,Сізге Ex.
Dialogue: 0,0:04:41.52,0:04:46.87,Default,,0,0,0,,Өтінемін, Ex!
Dialogue: 0,0:04:46.87,0:04:51.43,Default,,0,0,0,,Уф, мен қобалжымаймын.
Dialogue: 0,0:04:51.43,0:04:54.18,Default,,0,0,0,,Мен Экс жақсы деп ойлағым келеді.
Dialogue: 0,0:04:54.18,0:04:57.85,Default,,0,0,0,,Менің қарсыласым ресми кездесулерде жеңілмеген адам.
Dialogue: 0,0:04:57.85,0:05:01.35,Default,,0,0,0,,Биді барлық аңдардың патшасы Леонклав пайдаланды ма?
Dialogue: 0,0:05:01.35,0:05:06.36,Default,,0,0,0,,Иә Бұл кез келген шығанақпен пайдалануға болатын теңдестірілген түрдегі ұяшық.
Dialogue: 0,0:05:06.36,0:05:10.34,Default,,0,0,0,,Бірақ егер он мың аңның патшасы оны қолданса.
Dialogue: 0,0:05:10.34,0:05:14.88,Default,,0,0,0,,Оның қандай күш көрсететінін ешқашан болжай алмайсыз.
Dialogue: 0,0:05:14.88,0:05:17.44,Default,,0,0,0,,Ммм~ Жарайсыңдар!
Dialogue: 0,0:05:17.44,0:05:19.69,Default,,0,0,0,,Бұл қандай шайқас болады?
Dialogue: 0,0:05:19.69,0:05:24.58,Default,,0,0,0,,Тынышталыңыз. Президент толқып кетсе де, ұрыс жоқ
Dialogue: 0,0:05:24.58,0:05:27.68,Default,,0,0,0,,Салдары жоқ. ештеңе! ?
Dialogue: 0,0:05:27.68,0:05:32.85,Default,,0,0,0,,Сіз ешқашан жеңілген емессіз, солай ма?
Dialogue: 0,0:05:32.85,0:05:37.00,Default,,0,0,0,,Олай болса, бүгін сіздің бірінші тәжірибеңіз!
Dialogue: 0,0:05:37.00,0:05:39.02,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:39.02,0:05:42.49,Default,,0,0,0,,E... Бұрынғы сен ол жігітсің...
Dialogue: 0,0:05:42.49,0:05:46.51,Default,,0,0,0,,Куу... Кахахахахахахахаха!
Dialogue: 0,0:05:46.51,0:05:49.67,Default,,0,0,0,,Сәлем, жігіт.
Dialogue: 0,0:05:49.67,0:05:54.54,Default,,0,0,0,,Айқайлайтын қасиеті бар сияқты.
Dialogue: 0,0:05:54.54,0:05:58.59,Default,,0,0,0,,Үшінші шайқас.
Dialogue: 0,0:05:58.59,0:06:04.03,Default,,0,0,0,,Аңдар патшасының құдіретін біл.
Dialogue: 0,0:06:04.03,0:06:06.88,Default,,0,0,0,,Дайын жиынтық.
Dialogue: 0,0:06:06.88,0:06:10.17,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:06:10.17,0:06:12.84,Default,,0,0,0,,Қой!
Dialogue: 0,0:06:12.84,0:06:14.86,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:06:14.86,0:06:22.53,Default,,0,0,0,,Иә! Екі шығанақ босатылды!
Dialogue: 0,0:06:22.53,0:06:24.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:24.52,0:06:27.52,Default,,0,0,0,,Мен бірінші орнатқан Леонклав болды.
Dialogue: 0,0:06:27.52,0:06:31.51,Default,,0,0,0,,Өте қиғаш позициядан шабуыл!
Dialogue: 0,0:06:31.51,0:06:34.85,Default,,0,0,0,,Леонклаудың қатты шабуылы!
Dialogue: 0,0:06:34.85,0:06:37.35,Default,,0,0,0,,Қарғыс атсын... Үздіксіз шабуылдар.
Dialogue: 0,0:06:37.35,0:06:42.02,Default,,0,0,0,,Жедел нысана?
Dialogue: 0,0:06:42.02,0:06:44.00,Default,,0,0,0,,Шыдады.
Dialogue: 0,0:06:44.01,0:06:46.86,Default,,0,0,0,,Дран семсерінен қашу.
Dialogue: 0,0:06:46.86,0:06:49.68,Default,,0,0,0,,Жарайды, біз өзімізді алыстаттық.
Dialogue: 0,0:06:49.68,0:06:52.85,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:06:52.85,0:06:58.50,Default,,0,0,0,,Егер сізде қандай да бір үміттер болса, біз оны орындаймыз!
Dialogue: 0,0:06:58.50,0:07:04.36,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:04.36,0:07:06.51,Default,,0,0,0,,Хун.
Dialogue: 0,0:07:06.51,0:07:12.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:12.17,0:07:15.07,Default,,0,0,0,,Мен Құсты ұмытып кетіппін.
Dialogue: 0,0:07:15.07,0:07:19.67,Default,,0,0,0,,Extreme Dash пайдалана алатын жалғыз адам емес.
Dialogue: 0,0:07:19.67,0:07:26.18,Default,,0,0,0,,Леонклауды тістеп ал!
Dialogue: 0,0:07:26.18,0:07:30.00,Default,,0,0,0,,Керемет! Бұл соншалықты жылдам, мен оны көре алмаймын!
Dialogue: 0,0:07:30.00,0:07:32.52,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:07:32.52,0:07:38.91,Default,,0,0,0,,Аңдар патшасы!
Dialogue: 0,0:07:53.71,0:07:55.69,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:07:55.69,0:08:11.19,Default,,0,0,0,,О, құдайым! Не болып жатыр! ?
Dialogue: 0,0:08:11.19,0:08:13.53,Default,,0,0,0,,Не… не болды?
Dialogue: 0,0:08:13.53,0:08:18.57,Default,,0,0,0,,Сол жерде.
Dialogue: 0,0:08:18.57,0:08:21.84,Default,,0,0,0,,Бір мезгілде үстеме өңдеу. сызу.
Dialogue: 0,0:08:25.84,0:08:28.34,Default,,0,0,0,,Ма... шын ба?
Dialogue: 0,0:08:28.34,0:08:32.03,Default,,0,0,0,,Сенгісіз! Өте жылдам және өте жылдам.
Dialogue: 0,0:08:32.03,0:08:38.94,Default,,0,0,0,,4X жүйесі және нөлдік өту өте жылдам, не болып жатыр! ?
Dialogue: 0,0:08:38.94,0:08:41.69,Default,,0,0,0,,Бұл қандай маска? Корольге тең! ?
Dialogue: 0,0:08:41.69,0:08:43.67,Default,,0,0,0,,Ол соншалықты күшті болды ма?
Dialogue: 0,0:08:43.67,0:08:47.21,Default,,0,0,0,,Кинг сияқты экстремалды сызықшаны қолдануға болады.
Dialogue: 0,0:08:47.21,0:08:49.20,Default,,0,0,0,,Жеделдету де керемет болды.
Dialogue: 0,0:08:49.20,0:08:52.22,Default,,0,0,0,,Сіз олардың жағындасыз ба?
Dialogue: 0,0:08:52.22,0:08:56.72,Default,,0,0,0,,Мен... алмаймын. Әрине, патша жеңеді.
Dialogue: 0,0:08:56.72,0:09:00.26,Default,,0,0,0,,Шынында да патша стилі.
Dialogue: 0,0:09:00.26,0:09:05.88,Default,,0,0,0,,Ол, әрине, бағаланатын адам емес.
Dialogue: 0,0:09:05.88,0:09:11.04,Default,,0,0,0,,Extreme Dash-пен осы уақытқа дейін жеңіске жетті.
Dialogue: 0,0:09:11.04,0:09:19.19,Default,,0,0,0,,Бірақ бұл Кинг үшін мағынасыз болды.
Dialogue: 0,0:09:19.19,0:09:21.20,Default,,0,0,0,,Ex Не болды! ?
Dialogue: 0,0:09:21.20,0:09:24.68,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:09:24.68,0:09:28.20,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:09:28.20,0:09:30.69,Default,,0,0,0,,А... хех хе....
Dialogue: 0,0:09:30.69,0:09:38.51,Default,,0,0,0,,Керемет! Сондықтан мен Бэй ойнауды қоя алмаймын.
Dialogue: 0,0:09:38.51,0:09:42.02,Default,,0,0,0,,О! Үшінші шайқаста тең аяқталды.
Dialogue: 0,0:09:42.02,0:09:45.94,Default,,0,0,0,,Осы жерден біреуіңіз бірінші ұпай алғанша.
Dialogue: 0,0:09:45.94,0:09:47.87,Default,,0,0,0,,Ұрыс жалғасуда!
Dialogue: 0,0:09:47.87,0:09:52.23,Default,,0,0,0,,Сіз мұны әлі де жасайсыз ба? Өйткені ол әлі шешілген жоқ.
Dialogue: 0,0:09:52.23,0:09:57.18,Default,,0,0,0,,Екі пышақ алдыңғы.
Dialogue: 0,0:09:57.18,0:10:01.17,Default,,0,0,0,,Маска киген X Мен мұндай жерге барамын деп ешқашан ойламадым...
Dialogue: 0,0:10:01.17,0:10:05.36,Default,,0,0,0,,Хмф... Бірақ Король болса жақсы.
Dialogue: 0,0:10:05.36,0:10:08.36,Default,,0,0,0,,Хахахатсу Мен мұны тағы бір рет жасай аламын!
Dialogue: 0,0:10:08.36,0:10:11.51,Default,,0,0,0,,Мойындайық, сен мықтысың.
Dialogue: 0,0:10:11.51,0:10:16.53,Default,,0,0,0,,Бірақ патшаның алдында бәрі бас иеді!
Dialogue: 0,0:10:20.82,0:10:24.89,Default,,0,0,0,,Хмм, бұл керемет шайқас болды.
Dialogue: 0,0:10:24.89,0:10:28.98,Default,,0,0,0,,Кингтің экстремалды сызықшасы да жаман емес.
Dialogue: 0,0:10:28.98,0:10:30.98,Default,,0,0,0,,Сіз кімнің жағындасыз?
Dialogue: 0,0:10:30.98,0:10:33.63,Default,,0,0,0,,Сондай-ақ... Әрине Экс-Джага
Dialogue: 0,0:10:33.63,0:10:36.64,Default,,0,0,0,,Мен сені осыншама жерге барады деп ойламаппын.
Dialogue: 0,0:10:36.64,0:10:39.96,Default,,0,0,0,,Бұл Ex.
Dialogue: 0,0:10:39.96,0:10:44.46,Default,,0,0,0,,Джага Шыңға жету үшін қиын жауларды жеңу керек.
Dialogue: 0,0:10:44.46,0:10:48.37,Default,,0,0,0,,Аңдар патшасы біз үшін лайықты қарсылас.
Dialogue: 0,0:10:48.37,0:10:51.97,Default,,0,0,0,,Сіз Ex-ді жеңуіңіз керек!
Dialogue: 0,0:10:51.97,0:10:54.29,Default,,0,0,0,,Күшті шайқас.
Dialogue: 0,0:10:56.46,0:11:00.34,Default,,0,0,0,,Бетперде X Шынымды айтсам, таң қалдым.
Dialogue: 0,0:11:00.34,0:11:03.36,Default,,0,0,0,,Осы уақытқа дейін мені аңдар патшасы жеді.
Dialogue: 0,0:11:03.36,0:11:06.82,Default,,0,0,0,,Стадионда әлі ешкім тұрған жоқ.
Dialogue: 0,0:11:06.82,0:11:09.17,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:11:09.17,0:11:13.71,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:13.71,0:11:15.63,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:15.63,0:11:22.30,Default,,0,0,0,,Не? Менің түсірілім формасы өзгерді.
Dialogue: 0,0:11:22.30,0:11:28.46,Default,,0,0,0,,Патшаның азуы бір емес.
Dialogue: 0,0:11:28.46,0:11:34.61,Default,,0,0,0,,Патша! Бар! Бар!
Dialogue: 0,0:11:34.61,0:11:43.29,Default,,0,0,0,,Кинг нені көздеп отыр?
Dialogue: 0,0:11:43.29,0:11:47.63,Default,,0,0,0,,Кеттік, маска.
Dialogue: 0,0:11:47.63,0:11:50.66,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:11:50.66,0:11:54.47,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:11:54.47,0:12:06.63,Default,,0,0,0,,Қой!
Dialogue: 0,0:12:06.63,0:12:09.30,Default,,0,0,0,,Ах, Леонклау орбитасы!
Dialogue: 0,0:12:09.30,0:12:16.79,Default,,0,0,0,,Енді Леонклавтың ортасын алайық.
Dialogue: 0,0:12:16.79,0:12:19.77,Default,,0,0,0,,Қатты... бұрынғыдан мүлде басқаша!
Dialogue: 0,0:12:19.77,0:12:22.13,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:12:22.13,0:12:25.50,Default,,0,0,0,,Леонклав оның ату тәсіліне байланысты.
Dialogue: 0,0:12:25.50,0:12:27.62,Default,,0,0,0,,сыртқы түрін толығымен өзгертеді.
Dialogue: 0,0:12:27.62,0:12:33.29,Default,,0,0,0,,Бұрынғыдай қиғаш шабуылдарды қолдансаңыз, енді қарсыласқа үлкен соққы беретін шабуылдарға мамандануға болады.
Dialogue: 0,0:12:33.29,0:12:36.96,Default,,0,0,0,,Егер сіз дәл осы жолы ортасына көлденеңінен атсаңыз
Dialogue: 0,0:12:36.96,0:12:40.33,Default,,0,0,0,,Қарсыласпен маневр жасау Қорғаныс маманы болады.
Dialogue: 0,0:12:40.33,0:12:43.88,Default,,0,0,0,,Басқаша айтқанда, Doran Sword сияқты шабуыл түрлері
Dialogue: 0,0:12:43.88,0:12:49.45,Default,,0,0,0,,Кемшіліктердің кемшілігі. Міне бітті!
Dialogue: 0,0:12:49.45,0:12:51.79,Default,,0,0,0,,Бұл мүлдем жұмыс істемейді.
Dialogue: 0,0:12:51.79,0:12:57.66,Default,,0,0,0,,Осылай шабуылды жалғастыра берсең, төзімділігің төмендейді.
Dialogue: 0,0:12:57.66,0:12:59.96,Default,,0,0,0,,Хахахахахахахахаха!
Dialogue: 0,0:12:59.96,0:13:04.85,Default,,0,0,0,,Барлық жағдайларға жауап беріңіз, кейде тек нық тұрыңыз.
Dialogue: 0,0:13:04.85,0:13:09.62,Default,,0,0,0,,Сондықтан сіз Патшалардың Патшасысыз!
Dialogue: 0,0:13:09.62,0:13:12.99,Default,,0,0,0,,Маска, сен айбатты жау едің.
Dialogue: 0,0:13:12.99,0:13:16.03,Default,,0,0,0,,Бірақ қанша адам болса да
Dialogue: 0,0:13:16.03,0:13:23.12,Default,,0,0,0,,Менің патша жолым бөгелмейді!
Dialogue: 0,0:13:23.12,0:13:26.67,Default,,0,0,0,,Кеттік, қамқоршы аң!
Dialogue: 0,0:13:41.96,0:13:46.28,Default,,0,0,0,,Уау! Леонклаудың қуатты есептегіші.
Dialogue: 0,0:13:46.28,0:13:50.45,Default,,0,0,0,,Бұл аяқталды ма? ?
Dialogue: 0,0:13:50.45,0:13:55.95,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:13:55.95,0:13:58.84,Default,,0,0,0,,Дран Қылыш әрең қалды!
Dialogue: 0,0:13:58.84,0:14:00.87,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:14:00.87,0:14:04.93,Default,,0,0,0,,Бірақ сіз шабуыл жасасаңыз да, сізге қайтадан қарсы болады.
Dialogue: 0,0:14:04.93,0:14:08.62,Default,,0,0,0,,Экс бұлай аяқталмайды.
Dialogue: 0,0:14:08.62,0:14:16.29,Default,,0,0,0,,Жоспардың қандай да бір түрі болуы керек.
Dialogue: 0,0:14:16.29,0:14:21.95,Default,,0,0,0,,Хехе, патша жолына кедергі жасама. Күшті.
Dialogue: 0,0:14:21.95,0:14:26.62,Default,,0,0,0,,Дұрыс! Корольдік жолдың алдында бетперде киіп.
Dialogue: 0,0:14:26.62,0:14:29.12,Default,,0,0,0,,Король.
Dialogue: 0,0:14:29.12,0:14:34.61,Default,,0,0,0,,Онда неге ату формасын өзгерттіңіз?
Dialogue: 0,0:14:34.61,0:14:37.78,Default,,0,0,0,,Тогуро айтқандай, неге?
Dialogue: 0,0:14:37.78,0:14:41.77,Default,,0,0,0,,Мүмкін, оны қорғанысқа мамандандырылған етіп, шабуыл түрлеріне қарсы артықшылық береді.
Dialogue: 0,0:14:41.77,0:14:45.29,Default,,0,0,0,,Иә, бірақ... жоқ. иә?
Dialogue: 0,0:14:45.29,0:14:49.62,Default,,0,0,0,,Екі шеткі сызықшаның күші бірдей.
Dialogue: 0,0:14:49.62,0:14:52.11,Default,,0,0,0,,Қайтадан орындаңыз
Dialogue: 0,0:14:52.11,0:14:54.78,Default,,0,0,0,,Тіпті патшаның жеңіске жету мүмкіндігі бар...
Dialogue: 0,0:14:54.78,0:14:56.81,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:14:56.81,0:14:59.32,Default,,0,0,0,,Төтенше сызықты атыс
Dialogue: 0,0:14:59.32,0:15:02.74,Default,,0,0,0,,Екеуміз тең түскендей көрінгенмен.
Dialogue: 0,0:15:02.74,0:15:07.31,Default,,0,0,0,,Патша шамалы айырмашылықты сезініп, тактикасын өзгертуге мәжбүр болды.
Dialogue: 0,0:15:07.31,0:15:16.63,Default,,0,0,0,,Бірақ Экс өзінің Extreme Dash-ке сенді.
Dialogue: 0,0:15:16.63,0:15:22.02,Default,,0,0,0,,Өз жолыммен... Ex!
Dialogue: 0,0:15:22.02,0:15:26.31,Default,,0,0,0,,Енді көзіңді жыпылықтасаң, сағынасың!
Dialogue: 0,0:15:26.31,0:15:36.30,Default,,0,0,0,,Мен саған сен көрмеген нәрсені көрсетемін.
Dialogue: 0,0:15:36.30,0:15:39.31,Default,,0,0,0,,Экстремалды сызықша!
Dialogue: 0,0:15:55.79,0:15:57.96,Default,,0,0,0,,Мен патшамын!
Dialogue: 0,0:15:57.96,0:16:01.33,Default,,0,0,0,,Шыңға жететін адам бол!
Dialogue: 0,0:16:01.33,0:16:04.35,Default,,0,0,0,,Оны қайтар, Леонклау!
Dialogue: 0,0:16:22.30,0:16:24.47,Default,,0,0,0,,Аа….
Dialogue: 0,0:16:24.47,0:16:26.64,Default,,0,0,0,,О...
Dialogue: 0,0:16:26.64,0:16:30.29,Default,,0,0,0,,Дран Қылыш Экстремалды финиш.
Dialogue: 0,0:16:30.29,0:16:33.31,Default,,0,0,0,,Жеңімпаз: Бетперде киген X.
Dialogue: 0,0:16:33.31,0:16:36.93,Default,,0,0,0,,Persona командасы 2-1 есебімен жеңіске жетті.
Dialogue: 0,0:16:36.93,0:16:39.08,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:16:39.08,0:16:41.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:41.60,0:16:44.77,Default,,0,0,0,,Хахахахахаха. жеңіз~!
Dialogue: 0,0:16:44.77,0:16:48.26,Default,,0,0,0,,Иә, иә! Мен жасаймын! Күткендей!
Dialogue: 0,0:16:48.26,0:16:50.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:50.28,0:16:53.76,Default,,0,0,0,,Персона командасын құттықтаймыз!
Dialogue: 0,0:16:53.76,0:16:57.77,Default,,0,0,0,,Команда Zooganic командасын жеңіп, керемет жеңіске жетті!
Dialogue: 0,0:16:57.77,0:17:00.60,Default,,0,0,0,,Hohohohohohohohoho~.
Dialogue: 0,0:17:00.60,0:17:05.26,Default,,0,0,0,,Біз мұны жасадық! Мен дебюттік матчымды жеңдім!
Dialogue: 0,0:17:05.26,0:17:09.76,Default,,0,0,0,,Керемет, сәттілік. Ха~.
Dialogue: 0,0:17:09.76,0:17:14.67,Default,,0,0,0,,Хохо, Мейден де уайымдаған сияқты.
Dialogue: 0,0:17:14.67,0:17:17.25,Default,,0,0,0,,Сонымен, сіз бақыттысыз ба?
Dialogue: 0,0:17:17.25,0:17:20.26,Default,,0,0,0,,Көбірек күліп, бақытты болу керек.
Dialogue: 0,0:17:20.26,0:17:24.33,Default,,0,0,0,,Жоқ... бір жеңіс – бір жеңіс.
Dialogue: 0,0:17:24.33,0:17:27.36,Default,,0,0,0,,Бұл оңай болатын уақыт емес.
Dialogue: 0,0:17:27.36,0:17:29.27,Default,,0,0,0,,Көптеген түзетулер.
Dialogue: 0,0:17:29.27,0:17:32.42,Default,,0,0,0,,Олар қайтып оралғанда, біз дереу шолу жиналысын өткіземіз.
Dialogue: 0,0:17:32.42,0:17:35.44,Default,,0,0,0,,Сонымен... түсіндім...
Dialogue: 0,0:17:35.44,0:17:39.61,Default,,0,0,0,,Осыдан кейін Ичиго оны сізге жібереді!
Dialogue: 0,0:17:39.61,0:17:42.26,Default,,0,0,0,,Олай болса, біз жеңдік!
Dialogue: 0,0:17:42.26,0:17:45.60,Default,,0,0,0,,Persona командасының барлығымен сұхбат.
Dialogue: 0,0:17:45.60,0:17:49.12,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:17:49.12,0:17:52.69,Default,,0,0,0,,О~ Жақсы пікірлеріңіз үшін рахмет.
Dialogue: 0,0:17:52.69,0:17:55.61,Default,,0,0,0,,Сіз кәсіпқой ретінде бірінші матчта жеңіске жеттіңіз!
Dialogue: 0,0:17:55.61,0:17:57.93,Default,,0,0,0,,Маған қазір қандай сезімде екеніңізді айтыңыз.
Dialogue: 0,0:17:57.93,0:18:00.26,Default,,0,0,0,,Көшбасшы Казами Құсы!
Dialogue: 0,0:18:00.26,0:18:02.27,Default,,0,0,0,,Е, мен! ?
Dialogue: 0,0:18:02.27,0:18:07.29,Default,,0,0,0,,Жоқ... у... у... а...
Dialogue: 0,0:18:07.29,0:18:10.69,Default,,0,0,0,,О! Жеңіс қуанышынан қалтырап
Dialogue: 0,0:18:10.69,0:18:13.61,Default,,0,0,0,,Ештеңе айта алмайтын сияқтысың.
Dialogue: 0,0:18:13.61,0:18:16.63,Default,,0,0,0,,Түсіндім, түсіндім! Жоқ, бұл дұрыс емес...
Dialogue: 0,0:18:16.63,0:18:18.78,Default,,0,0,0,,Бұл жеңіс командаға тиесілі.
Dialogue: 0,0:18:18.78,0:18:21.62,Default,,0,0,0,,Бұл нені білдіреді деп ойлайсыңдар?
Dialogue: 0,0:18:21.62,0:18:25.79,Default,,0,0,0,,Сіз нені айтасыз? Жоқ, бұл дегеніміз...
Dialogue: 0,0:18:25.79,0:18:28.96,Default,,0,0,0,,О, түсіндім. Мағынасы жоқ.
Dialogue: 0,0:18:28.96,0:18:32.63,Default,,0,0,0,,Себебі мен жеңіске басынан-ақ сенімді болдым.
Dialogue: 0,0:18:32.63,0:18:35.00,Default,,0,0,0,,Қарсылас күшті болса да
Dialogue: 0,0:18:35.00,0:18:38.30,Default,,0,0,0,,Менің тобым Х мұнарасына жүгіреді
Dialogue: 0,0:18:38.30,0:18:41.77,Default,,0,0,0,,Қабілеті жағынан да, біліктілігі жағынан да озық екені көрініп тұрды.
Dialogue: 0,0:18:41.77,0:18:45.94,Default,,0,0,0,,Жеңіліс менің ойымнан да өткен емес!
Dialogue: 0,0:18:45.94,0:18:49.60,Default,,0,0,0,,Түсіндім, бұл ақымақ сұрақ болды. Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:18:49.60,0:18:52.27,Default,,0,0,0,,Эй, не? неге! ?
Dialogue: 0,0:18:52.27,0:18:54.60,Default,,0,0,0,,Ах.
Dialogue: 0,0:18:54.60,0:18:57.29,Default,,0,0,0,,О! Құстың пікірі
Dialogue: 0,0:18:57.29,0:18:59.94,Default,,0,0,0,,SNS-те де көптеген реакциялар бар.
Dialogue: 0,0:18:59.94,0:19:01.94,Default,,0,0,0,,Уау, рахмет! иә?
Dialogue: 0,0:19:01.94,0:19:03.93,Default,,0,0,0,,Тек аузың жақсы.
Dialogue: 0,0:19:03.93,0:19:07.35,Default,,0,0,0,,Жоқ, басшы осындай тәкаппар болуы керек.
Dialogue: 0,0:19:07.35,0:19:11.27,Default,,0,0,0,,Бұл Казами құсы Үлкен ауыз аңызының басы ма? ?
Dialogue: 0,0:19:11.27,0:19:13.94,Default,,0,0,0,,т.б. Барлығы жақсы уақыт өткізуде.
Dialogue: 0,0:19:13.94,0:19:18.29,Default,,0,0,0,,Е! Құс: Сен желпілдейсің! Ол кәсіпқой.
Dialogue: 0,0:19:18.29,0:19:20.40,Default,,0,0,0,,Сонда сіз қаттырақ болуыңыз керек.
Dialogue: 0,0:19:20.84,0:19:24.26,Default,,0,0,0,,Айтпадым, айтпадым!
Dialogue: 0,0:19:24.26,0:19:27.62,Default,,0,0,0,,Ей, қайталап көрейін... Е! ?
Dialogue: 0,0:19:27.62,0:19:29.64,Default,,0,0,0,,Олай болса барлығына
Dialogue: 0,0:19:29.64,0:19:43.30,Default,,0,0,0,,Persona командасының табысын күтіңіз!
Dialogue: 0,0:19:43.30,0:19:46.44,Default,,0,0,0,,Кинг аузын қағып жатыр.
Dialogue: 0,0:19:46.44,0:19:48.94,Default,,0,0,0,,Сіз жаман нәрсе жедіңіз бе?
Dialogue: 0,0:19:48.94,0:19:52.59,Default,,0,0,0,,Жоқ. Мен ресми матчта бірінші рет жеңілдім.
Dialogue: 0,0:19:52.59,0:19:55.60,Default,,0,0,0,,Мен патша болсам да, көңілім күйзеледі.
Dialogue: 0,0:19:55.60,0:20:00.78,Default,,0,0,0,,Егер сіз...
Dialogue: 0,0:20:00.78,0:20:03.77,Default,,0,0,0,,Бірінші матчта жеңіске жетсем ғой.
Dialogue: 0,0:20:03.77,0:20:10.26,Default,,0,0,0,,Бұл әзіл. бірақ….
Dialogue: 0,0:20:10.26,0:20:13.28,Default,,0,0,0,,Иа…ухахахаха….
Dialogue: 0,0:20:13.28,0:20:15.83,Default,,0,0,0,,Хахахахахахахахахаха!
Dialogue: 0,0:20:15.83,0:20:19.25,Default,,0,0,0,,Мен саған сабақ бере аламын деп ешқашан ойламаппын.
Dialogue: 0,0:20:19.25,0:20:21.77,Default,,0,0,0,,Жоқ, мен қатты әсер алдым. Мен әсер алдым.
Dialogue: 0,0:20:22.17,0:20:24.43,Default,,0,0,0,,Үлкен ауыз да талант.
Dialogue: 0,0:20:24.62,0:20:27.78,Default,,0,0,0,,Сондықтан мен былай дедім...
Dialogue: 0,0:20:27.78,0:20:31.28,Default,,0,0,0,,Дұрыс жауап бере алмаған Құс кінәлі.
Dialogue: 0,0:20:31.28,0:20:34.27,Default,,0,0,0,,Мен қазірден бастап сұхбат алуды үйренуім керек.
Dialogue: 0,0:20:34.27,0:20:36.29,Default,,0,0,0,,Ол көшбасшы.
Dialogue: 0,0:20:36.29,0:20:40.87,Default,,0,0,0,,Бірақ кенеттен сізге микрофон қараса, қобалжуыңыз мүмкін.
Dialogue: 0,0:20:40.87,0:20:43.28,Default,,0,0,0,,Не? Король! ?
Dialogue: 0,0:20:43.28,0:20:49.28,Default,,0,0,0,,Бір нәрсе үшін бе?
Dialogue: 0,0:20:49.28,0:20:52.27,Default,,0,0,0,,Мені оқытты.
Dialogue: 0,0:20:52.27,0:20:58.26,Default,,0,0,0,,Менің патша жолым әлі жарты жолда.
Dialogue: 0,0:20:58.26,0:21:02.83,Default,,0,0,0,,Мен соңғы шайқаста жеңіске жету үшін стратегияны қолдандым, бірақ
Dialogue: 0,0:21:02.83,0:21:06.93,Default,,0,0,0,,Нәтижелеріңізді қорғап қалған сияқтысыз.
Dialogue: 0,0:21:06.93,0:21:10.29,Default,,0,0,0,,Шабуылдаушы сезімдеріңізді итермеңіз.
Dialogue: 0,0:21:10.29,0:21:16.66,Default,,0,0,0,,Сіз де патша жолымен жүретін адамсыз.
Dialogue: 0,0:21:16.66,0:21:20.26,Default,,0,0,0,,Маска, мен тағы да жаттығамын
Dialogue: 0,0:21:20.26,0:21:22.93,Default,,0,0,0,,Мұнараның басына барыңыз.
Dialogue: 0,0:21:22.93,0:21:26.95,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:21:26.95,0:21:35.28,Default,,0,0,0,,Тағы кездесейік.
Dialogue: 0,0:21:35.28,0:21:39.27,Default,,0,0,0,,О!
Dialogue: 0,0:21:39.27,0:21:43.67,Default,,0,0,0,,Мен де! Келесі жолы мен сені жеңетіндей боламын.
Dialogue: 0,0:21:43.67,0:21:46.77,Default,,0,0,0,,Ммм, мүлде мүмкін емес.
Dialogue: 0,0:21:46.77,0:21:51.61,Default,,0,0,0,,Сәлем! Кууу... хахаха.
Dialogue: 0,0:21:51.61,0:21:54.78,Default,,0,0,0,,Мен сені бұл жолы да жеңемін.
Dialogue: 0,0:21:54.78,0:21:57.28,Default,,0,0,0,,Эй, бұл қызық.
Dialogue: 0,0:21:57.28,0:22:09.60,Default,,0,0,0,,Келесі жолы қай шығанақты пайдаланғанымды қалайтыныңызды айтыңыз.
Dialogue: 0,0:22:10.57,0:22:13.41,Default,,0,0,0,,《Патша: Жеңіліс соғысқанның бәріне келеді.
Dialogue: 0,0:22:13.97,0:22:17.50,Default,,0,0,0,,Бірақ шайқассыз жеңіс болмайды.
Dialogue: 0,0:22:20.25,0:22:22.50,Default,,0,0,0,,Мен тағы да патша жолымен жүремін! 》
Dialogue: 0,0:22:31.14,0:22:33.60,On Top,,0,0,0,,Менің барудан қорықпайтынымды білесің
Dialogue: 0,0:22:33.60,0:22:35.56,On Top,,0,0,0,,Дауылға тура секіру
Dialogue: 0,0:22:35.56,0:22:39.90,On Top,,0,0,0,,Артқа отырыңыз, сапардан ләззат алыңыз (Жарайды, жарайды)
Dialogue: 0,0:22:39.90,0:22:41.61,On Top,,0,0,0,,Олардың не айтатыны маған бәрібір
Dialogue: 0,0:22:41.61,0:22:43.61,On Top,,0,0,0,,Мен мұның бәрін өзім үшін қалаймын
Dialogue: 0,0:22:43.61,0:22:44.61,On Top,,0,0,0,,Мені тоқтата алмаймын
Dialogue: 0,0:22:44.61,0:22:46.11,On Top,,0,0,0,,Мұны бәрі білсін
Dialogue: 0,0:22:46.11,0:22:48.03,On Top,,0,0,0,,Мен оны қабылдауға дайынмын
Dialogue: 0,0:22:48.53,0:22:49.74,On Top,,0,0,0,,Біз ерекше бола аламыз
Dialogue: 0,0:22:49.74,0:22:52.41,On Top,,0,0,0,,Немесе сіз қарапайым нәрсені жақсы көресіз бе? иә?
Dialogue: 0,0:22:52.41,0:22:53.66,On Top,,0,0,0,,Бұл менің соңым болуы мүмкін
Dialogue: 0,0:22:53.66,0:22:56.21,On Top,,0,0,0,,Сондықтан Имма сені менің жауым BOOM сияқты жақындатады
Dialogue: 0,0:22:56.21,0:22:57.87,On Top,,0,0,0,,Қалағаныңызша солай сөйлесіңіз
Dialogue: 0,0:22:57.87,0:23:00.04,On Top,,0,0,0,,Бірге өту
Dialogue: 0,0:23:00.04,0:23:01.34,On Top,,0,0,0,,Менің не алғанымды көрсетіңіз
Dialogue: 0,0:23:01.34,0:23:02.21,On Top,,0,0,0,,Төтенше мен
Dialogue: 0,0:23:02.21,0:23:04.84,On Top,,0,0,0,,Бұл маған ұнайтын нәрсе
Dialogue: 0,0:23:04.84,0:23:08.34,On Top,,0,0,0,,Сізбен бірге тұрып, шайқасқа аттаныңыз
Dialogue: 0,0:23:08.34,0:23:12.26,On Top,,0,0,0,,Айнымас сезімдерді қорғау
Dialogue: 0,0:23:12.26,0:23:14.31,On Top,,0,0,0,,Қарамаңдар
Dialogue: 0,0:23:14.31,0:23:16.93,On Top,,0,0,0,,Келесі әлемге
Dialogue: 0,0:23:17.14,0:23:19.27,On Top,,0,0,0,,Үлкейтіңіз, үлкейтіңіз
Dialogue: 0,0:23:19.27,0:23:21.52,On Top,,0,0,0,,Масштабты үлкейту' Мен ұлғайту, масштабтау
Dialogue: 0,0:23:21.52,0:23:23.11,On Top,,0,0,0,,Мен сені үлкейтемін
Dialogue: 0,0:23:23.11,0:23:25.32,On Top,,0,0,0,,Масштабты үлкейту' Мен ұлғайту, масштабтау
Dialogue: 0,0:23:25.32,0:23:26.86,On Top,,0,0,0,,Енді сізді үлкейтіңіз
Dialogue: 0,0:23:26.86,0:23:29.32,On Top,,0,0,0,,Масштабты үлкейту' Мен ұлғайту, масштабтау
Dialogue: 0,0:23:29.32,0:23:30.61,On Top,,0,0,0,,Мен сізді үлкейтемін
Dialogue: 0,0:23:30.61,0:23:32.66,On Top,,0,0,0,,Масштабты масштабтау Көңілді болайық
Dialogue: 0,0:23:32.66,0:23:34.58,On Top,,0,0,0,,Масштабты масштабтау Осы сәт
Dialogue: 0,0:23:34.58,0:23:37.41,On Top,,0,0,0,,Енді менің көз алдымда мен сені артта қалдыра алмаймын
Dialogue: 0,0:23:37.41,0:23:39.41,On Top,,0,0,0,,Мен мұны өз жолыммен істеп жатқанымды білесіз
Dialogue: 0,0:23:39.41,0:23:42.29,On Top,,0,0,0,,'Себебі мен масштабтаймын, масштабтаймын' Мен сізді үлкейтемін
Dialogue: 0,0:23:42.29,0:23:45.05,On Top,,0,0,0,,Енді менің көз алдымда мен сені артта қалдыра алмаймын
Dialogue: 0,0:23:45.05,0:23:47.46,On Top,,0,0,0,,Мен оны шыңға шығарамын
Dialogue: 0,0:23:47.46,0:23:50.84,On Top,,0,0,0,,'Себебі мен масштабтаймын, масштабтаймын' Мен сізді үлкейтемін
Dialogue: 0,0:23:56.93,0:24:00.85,Default,,0,0,0,,Жоқ, Құстың үлкен ауызды қабілеті бар еді.
Dialogue: 0,0:24:00.85,0:24:03.77,Default,,0,0,0,,Сонымен Ичиго-чан мұны өз бетімен жасады!
Dialogue: 0,0:24:03.77,0:24:06.23,Default,,0,0,0,,Егер сіз кәсіпқой болсаңыз, аздап ынталандыру маңызды.
Dialogue: 0,0:24:06.40,0:24:07.90,Default,,0,0,0,,Біз оны жандандыруымыз керек.
Dialogue: 0,0:24:07.94,0:24:10.99,Default,,0,0,0,,Бірақ шектен шығудан сақ болыңыз. Сізге көп кері реакция болады.
Dialogue: 0,0:24:11.19,0:24:13.03,Default,,0,0,0,,Сіз ең көп қуып жүрген шығарсыз.
Dialogue: 0,0:24:13.74,0:24:15.41,Default,,0,0,0,,Келесі жолы Beyblade X
Dialogue: 0,0:24:15.82,0:24:16.70,Default,,0,0,0,,Baycrafter
Dialogue: 0,0:24:17.12,0:24:20.91,Default,,0,0,0,,Казами құсының үлкен аузы туралы аңыз
Dialogue: 0,0:24:21.33,0:24:22.91,Default,,0,0,0,,Жоғары үміт!
Dialogue: 0,0:24:23.00,0:24:24.42,Default,,0,0,0,,Онымен араласпа!
Dialogue: 0,0:24:25.92,0:24:31.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory