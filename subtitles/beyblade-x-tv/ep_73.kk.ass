Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:04.80,Default,,0,0,0,,<X... Бұл мен әлі көрмеген нәрсе.
Dialogue: 0,0:00:04.80,0:00:09.17,Default,,0,0,0,,Максималды жеделдету бар Бейблейд ойынды одан да экстремалды етеді.
Dialogue: 0,0:00:09.17,0:00:12.81,Default,,0,0,0,,Бұл саусақтар жарыққа немесе қараңғыға тиіп тұр ма?
Dialogue: 0,0:00:12.81,0:00:16.48,Default,,0,0,0,,Бұл қолдар жеңісті немесе үмітсіздікті ұстай ма?
Dialogue: 0,0:00:16.48,0:00:19.45,Default,,0,0,0,,X қазірдің өзінде менің алдымда＞
Dialogue: 0,0:00:21.98,0:00:29.99,Default,,0,0,0,,🎙 (Zero Go) Супер саммитте жеңіске жеткен команда - Solidus Tower, Team Zodiac!
Dialogue: 0,0:00:29.99,0:00:33.03,Default,,0,0,0,,Барлық Бладерлерге ескерту!
Dialogue: 0,0:00:33.03,0:00:40.80,Default,,0,0,0,,Варава басқаратын Zodiac командасы супер саммитте жеңіске жетті.
Dialogue: 0,0:00:40.80,0:00:45.47,Default,,0,0,0,,Міне және қазір біз Жұлдызды шайқас жариялаймыз!
Dialogue: 0,0:00:45.47,0:00:47.48,Default,,0,0,0,,Жұлдызды шайқас?
Dialogue: 0,0:00:47.48,0:00:52.48,Default,,0,0,0,,Pro/am түріне қарамастан, X City bladers үшін ақ жұлдыздарды таратыңыз.
Dialogue: 0,0:00:52.48,0:00:56.29,Default,,0,0,0,,Exchange Beybattle➡ арқылы жеңеді
Dialogue: 0,0:00:56.29,0:01:01.69,Default,,0,0,0,,Менің зодиакым 100 дана жинаған командамен күреседі.
Dialogue: 0,0:01:01.69,0:01:04.46,Default,,0,0,0,,Әрине, жеңсең, сен ең мықты боласың.
Dialogue: 0,0:01:04.46,0:01:06.96,Default,,0,0,0,,Әркім тырысуы керек.
Dialogue: 0,0:01:06.96,0:01:11.97,Default,,0,0,0,,Дегенмен Хакусей-рю ешқашан жеңілмейді.
Dialogue: 0,0:01:11.97,0:01:15.17,Default,,0,0,0,,Хакусей стилі! ? Бұл...
Dialogue: 0,0:01:17.64,0:01:23.11,Default,,0,0,0,,Хакубоши Омега Бұл менің анам.
Dialogue: 0,0:03:09.12,0:03:11.42,Default,,0,0,0,,Бұл адам➡
Dialogue: 0,0:03:11.42,0:03:13.62,Default,,0,0,0,,Тенканың анасы. Апыр-ай.
Dialogue: 0,0:03:13.62,0:03:17.59,Default,,0,0,0,,Сіздің анаңыз - Solidus Pro Blader...
Dialogue: 0,0:03:17.59,0:03:19.63,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:03:19.63,0:03:25.93,Default,,0,0,0,,Хакусей Рю X Tower тобына қосылды, яғни кәсіби шебер болады➡
Dialogue: 0,0:03:25.93,0:03:28.44,Default,,0,0,0,,Ештеңеге рұқсат етілмеді.
Dialogue: 0,0:03:28.44,0:03:31.31,Default,,0,0,0,,X Tower ережелерін сақтасаңыз➡
Dialogue: 0,0:03:31.31,0:03:34.48,Default,,0,0,0,,Дәстүрге нұқсан келуі мүмкін.
Dialogue: 0,0:03:37.61,0:03:41.52,Default,,0,0,0,,Бірақ нұсқаушы көмекшісі Омега бұған қарсы болды➡
Dialogue: 0,0:03:41.52,0:03:44.59,Default,,0,0,0,,Ол өзімен бірге бірнеше шәкіртін ертіп кетіп қалды.
Dialogue: 0,0:03:44.59,0:03:49.29,Default,,0,0,0,,Артында қалғандарға қараңғыда шабуыл жасалды➡
Dialogue: 0,0:03:49.29,0:03:53.46,Default,,0,0,0,,Доджодан бірінен соң бірі шығып кетеді➡
Dialogue: 0,0:03:53.46,0:03:58.13,Default,,0,0,0,,Хакусейрю қирап қалды.
Dialogue: 0,0:03:58.13,0:04:01.50,Default,,0,0,0,,Омегалар бұрыннан шығарылған➡
Dialogue: 0,0:04:01.50,0:04:04.81,Default,,0,0,0,,Біреудің алдына қою керек.
Dialogue: 0,0:04:04.81,0:04:06.81,Default,,0,0,0,,Таңдалғаны ➡ болды
Dialogue: 0,0:04:06.81,0:04:11.65,Default,,0,0,0,,Бұл мен, қазіргі нұсқаушы.
Dialogue: 0,0:04:11.65,0:04:13.95,Default,,0,0,0,,Бірақ Омега күшті.
Dialogue: 0,0:04:13.95,0:04:19.32,Default,,0,0,0,,Мен X Tower супер шыңының нағыз чемпионы болдым.
Dialogue: 0,0:04:19.32,0:04:24.16,Default,,0,0,0,,Шынымды айтсам, менің өз күшіммен жеңіске жету мүмкіндігім жоқ.
Dialogue: 0,0:04:24.16,0:04:26.19,Default,,0,0,0,,Маска X….
Dialogue: 0,0:04:26.19,0:04:29.13,Default,,0,0,0,,Жоқ, Kurosu Ex. иә?
Dialogue: 0,0:04:29.13,0:04:32.50,Default,,0,0,0,,Омеганы менімен жеңесің бе?
Dialogue: 0,0:04:32.50,0:04:35.00,Default,,0,0,0,,Жарайды! Дереу жауап!
Dialogue: 0,0:04:35.00,0:04:37.57,Default,,0,0,0,,Күте тұрыңыз! иә? Неліктен?
Dialogue: 0,0:04:37.57,0:04:42.01,Default,,0,0,0,,Бізге жақындаған кездегі мақсатыңыз осы болды ма?
Dialogue: 0,0:04:42.01,0:04:43.98,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:43.98,0:04:45.98,Default,,0,0,0,,Мен Тенканың жағдайын түсіндім.
Dialogue: 0,0:04:45.98,0:04:48.92,Default,,0,0,0,,Бірақ біз Persona командасымыз.
Dialogue: 0,0:04:48.92,0:04:52.12,Default,,0,0,0,,Көп ойыншы болмаса да, мен өз бетімше шешім қабылдай алмаймын.
Dialogue: 0,0:04:52.12,0:04:55.62,Default,,0,0,0,,Мен командадан ештеңе сұрап тұрғандай емеспін.
Dialogue: 0,0:04:55.62,0:04:57.79,Default,,0,0,0,,Бұрын маған бір ғана адам керек.
Dialogue: 0,0:04:57.79,0:05:02.13,Default,,0,0,0,,Жоқ! Сіз бұл жігіттің қамқоршысысыз ба?
Dialogue: 0,0:05:02.13,0:05:04.27,Default,,0,0,0,,Мен Persona көшбасшысымын!
Dialogue: 0,0:05:04.27,0:05:06.27,Default,,0,0,0,,Эй.
Dialogue: 0,0:05:06.27,0:05:10.94,Default,,0,0,0,,Тенка Омега өз қожайынынан күшті қарсылас екенін айтты, солай ма?
Dialogue: 0,0:05:10.94,0:05:13.44,Default,,0,0,0,,Не? О, сөзсіз➡
Dialogue: 0,0:05:13.44,0:05:16.85,Default,,0,0,0,,Ол Джинроға қарағанда күшті. Сіз қалай ойлайсыз? Бұл қызық емес пе?
Dialogue: 0,0:05:16.85,0:05:19.15,Default,,0,0,0,,Иә, иә! Сондықтан күтіңіз!
Dialogue: 0,0:05:19.15,0:05:23.12,Default,,0,0,0,,Біз шыңға ұмтыламыз! Зодиакты жеңсеңіз де➡
Dialogue: 0,0:05:23.12,0:05:25.75,Default,,0,0,0,,Сіз шыңға ресми түрде жете алмайсыз!
Dialogue: 0,0:05:25.75,0:05:27.76,Default,,0,0,0,,Бұл көрмелік матч сияқты!
Dialogue: 0,0:05:27.76,0:05:31.76,Default,,0,0,0,,Бірақ сіз міндетті түрде жақындай аласыз!
Dialogue: 0,0:05:31.76,0:05:34.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:34.46,0:05:37.80,Default,,0,0,0,,Басқа командалар да осылай ойлауы керек.
Dialogue: 0,0:05:37.80,0:05:41.60,Default,,0,0,0,,Zooganic және Yggdrasil міндетті түрде қатысады.
Dialogue: 0,0:05:41.60,0:05:43.61,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:43.61,0:05:47.28,Default,,0,0,0,,Тенка-кун әлі күнге дейін Persona мүшесі ретінде тіркелген.
Dialogue: 0,0:05:47.28,0:05:52.45,Default,,0,0,0,,Менің ойымша, Тенка-саманың күші қазір Марути-сама кеткенде қажет.
Dialogue: 0,0:05:52.45,0:05:55.45,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:05:55.45,0:05:57.45,Default,,0,0,0,,Бұл шешілді.
Dialogue: 0,0:05:57.45,0:05:59.96,Default,,0,0,0,,Сізге күресуге лайықты қарсылас кім?
Dialogue: 0,0:05:59.96,0:06:01.96,Default,,0,0,0,,Мен оны сізге таңдаймын.
Dialogue: 0,0:06:05.13,0:06:07.60,Default,,0,0,0,,Оны асыға күтемін, Құс!
Dialogue: 0,0:06:10.70,0:06:13.27,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:13.27,0:06:17.61,Default,,0,0,0,,Мен оған бірдеңе болды деп ойладым.
Dialogue: 0,0:06:17.61,0:06:19.91,Default,,0,0,0,,Сәлеметсіз бе, бұл жеткізу!
Dialogue: 0,0:06:22.28,0:06:24.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:24.28,0:06:27.12,Default,,0,0,0,,Бұл робот па? көрейік?
Dialogue: 0,0:06:27.12,0:06:29.38,Default,,0,0,0,,Әй, рұқсатсыз маған тиіспе!
Dialogue: 0,0:06:35.52,0:06:37.79,Default,,0,0,0,,О, ұшты!
Dialogue: 0,0:06:37.79,0:06:41.96,Default,,0,0,0,,Танысқаныма қуаныштымын! Мен AI Сангоның көмекшісімін!
Dialogue: 0,0:06:41.96,0:06:44.43,Default,,0,0,0,,Ол сөйледі! О, бұл сүйкімді.
Dialogue: 0,0:06:44.43,0:06:46.64,Default,,0,0,0,,Әй, иә... жоқ, бәрібір.
Dialogue: 0,0:06:48.60,0:06:52.77,Default,,0,0,0,,Портативті 4X жүйесі орналастырылған!
Dialogue: 0,0:06:52.77,0:06:55.98,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:06:55.98,0:07:01.02,Default,,0,0,0,,Құрметті X City Bladers! Сәлем!
Dialogue: 0,0:07:01.02,0:07:05.12,Default,,0,0,0,,Сізге жеткізілген өнімді B4➡ жаңадан әзірлеген
Dialogue: 0,0:07:05.12,0:07:08.56,Default,,0,0,0,,AI көмекшісі. Оның аты Санго!
Dialogue: 0,0:07:08.56,0:07:10.79,Default,,0,0,0,,모Ашық ауада орналастыруға болады➡
Dialogue: 0,0:07:10.79,0:07:13.46,Default,,0,0,0,,Портативті 4X жүйесімен жабдықталған➡
Dialogue: 0,0:07:13.46,0:07:16.93,Default,,0,0,0,,Барлық жұлдызды шайқастарға көмектесу!
Dialogue: 0,0:07:16.93,0:07:19.33,Default,,0,0,0,,Сіз оны Ниго-чаннан кейінгі сіңілім деп айта аласыз➡
Dialogue: 0,0:07:19.33,0:07:21.27,Default,,0,0,0,,Бұл сенуге болатын адам.
Dialogue: 0,0:07:21.27,0:07:23.27,Default,,0,0,0,,Ниго деген кім?
Dialogue: 0,0:07:23.27,0:07:25.44,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:07:25.44,0:07:29.68,Default,,0,0,0,,Олар матч кезінде нәтижелерді хабарлайды.
Dialogue: 0,0:07:29.68,0:07:32.61,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:07:32.61,0:07:35.28,Default,,0,0,0,,О, солай! Ах~!
Dialogue: 0,0:07:35.28,0:07:38.45,Default,,0,0,0,,Енді ақ жұлдыздардың санын тексерейік!
Dialogue: 0,0:07:38.45,0:07:41.22,Default,,0,0,0,,Маған Санго-чан қоңырау шалып, сұраңыз!
Dialogue: 0,0:07:43.46,0:07:45.46,Default,,0,0,0,,Ал, Санго-чан!
Dialogue: 0,0:07:45.46,0:07:48.23,Default,,0,0,0,,Persona командасының қанша жеңісі бар?
Dialogue: 0,0:07:53.80,0:07:58.44,Default,,0,0,0,,Team Persona қазіргі уақытта 3 ақ жұлдызға ие!
Dialogue: 0,0:07:58.44,0:08:00.78,Default,,0,0,0,,Санго-чан ақылды!
Dialogue: 0,0:08:00.78,0:08:04.45,Default,,0,0,0,,Сіз кәсіпқой немесе әуесқой болсаңыз да, X City командасының ➡
Dialogue: 0,0:08:04.45,0:08:06.45,Default,,0,0,0,,Үш ақ жұлдыз таратылды.
Dialogue: 0,0:08:06.45,0:08:10.42,Default,,0,0,0,,Бәс тігу бұл ғаламшарды X City➡-де әртүрлі жерлерде орнатқан
Dialogue: 0,0:08:10.42,0:08:13.25,Default,,0,0,0,,Стадионда жұлдызды шайқас жүріп жатыр!
Dialogue: 0,0:08:13.25,0:08:15.96,Default,,0,0,0,,Жұлдыздар, жарқыра!
Dialogue: 0,0:08:15.96,0:08:18.13,Default,,0,0,0,,Бұл өте керемет трюк.
Dialogue: 0,0:08:18.13,0:08:20.10,Default,,0,0,0,,Ұрысқа бәс тігуге болатын жұлдыздар саны ➡
Dialogue: 0,0:08:20.10,0:08:22.13,Default,,0,0,0,,Кез келген сан жақсы!
Dialogue: 0,0:08:22.13,0:08:25.13,Default,,0,0,0,,Сіз жинаған барлық жұлдыздарға бәс тігіп, өзіңізді үлкен ойынға шақыра аласыз!
Dialogue: 0,0:08:25.13,0:08:29.94,Default,,0,0,0,,Қызықты. Чемпион бәрін жеңеді!
Dialogue: 0,0:08:29.94,0:08:33.61,Default,,0,0,0,,Танымал болудың сыры - басқалардан да жарқырап тұру.
Dialogue: 0,0:08:33.61,0:08:35.61,Default,,0,0,0,,Бұл мен үшін өте қолайлы!
Dialogue: 0,0:08:35.61,0:08:38.78,Default,,0,0,0,,Зона қанша жұлдыз болса, сонша жұмбақ дайындайды!
Dialogue: 0,0:08:38.78,0:08:41.78,Default,,0,0,0,,Дегенмен, сізде 0 ақ жұлдыз болған кезде➡
Dialogue: 0,0:08:41.78,0:08:44.72,Default,,0,0,0,,Бұл команда Жұлдызды шайқастан шығарылады.
Dialogue: 0,0:08:44.72,0:08:47.99,Default,,0,0,0,,Стратегияңызды жоспарлаңыз және күресіңіз!
Dialogue: 0,0:08:47.99,0:08:51.83,Default,,0,0,0,,Соңғы кезеңде көптеген жұлдыздар үшін шайқас болады.
Dialogue: 0,0:08:51.83,0:08:56.60,Default,,0,0,0,,Мұндай жағдайларда бос уақыттың ауысуы жылдамдауы мүмкін.
Dialogue: 0,0:08:56.60,0:08:59.30,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:08:59.30,0:09:03.81,Default,,0,0,0,,Жаңа үміткерлер және шыңға жақын адамдар➡
Dialogue: 0,0:09:03.81,0:09:07.21,Default,,0,0,0,,Сіздің лауазымыңыз маңызды емес!
Dialogue: 0,0:09:07.21,0:09:09.11,Default,,0,0,0,,모Жас-кәріге қарамастан➡
Dialogue: 0,0:09:09.11,0:09:13.38,Default,,0,0,0,,Сіздің X City-дегі барлық командаларға қосылуға құқығыңыз бар!
Dialogue: 0,0:09:13.38,0:09:16.28,Default,,0,0,0,,100 ақ жұлдыз жинаған бірінші топ➡
Dialogue: 0,0:09:16.28,0:09:21.16,Default,,0,0,0,,Slash Tower және Solidus Tower үстінде орналасқан супер шың!
Dialogue: 0,0:09:21.16,0:09:26.13,Default,,0,0,0,,Zodiac командасына қарсы шығу құқығына ие болыңыз!
Dialogue: 0,0:09:26.13,0:09:31.80,Default,,0,0,0,,Барлығың сабанға келіңдер.
Dialogue: 0,0:09:31.80,0:09:36.20,Default,,0,0,0,,Мен сізді Хакусей стиліндегі жүзбен кесуге рұқсат етіңіз!
Dialogue: 0,0:09:38.31,0:09:42.31,Default,,0,0,0,,📱 (Қоңырау үні)
Dialogue: 0,0:09:42.31,0:09:45.48,Default,,0,0,0,,Бұл менмін. Біраз уақыт өтті.
Dialogue: 0,0:09:47.45,0:09:50.65,Default,,0,0,0,,Аа, дұрыс. Сізге көп рахмет.
Dialogue: 0,0:09:55.46,0:09:57.53,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:09:57.53,0:10:02.63,Default,,0,0,0,,Құс мырза Икс мырза, сізге сәттілік тілеймін.
Dialogue: 0,0:10:02.63,0:10:06.23,Default,,0,0,0,,Санго-чан, абай бол.
Dialogue: 0,0:10:09.27,0:10:11.44,Default,,0,0,0,,Екеуі келсе жақсы болар еді.
Dialogue: 0,0:10:11.44,0:10:14.94,Default,,0,0,0,,Дүкен нөмірі бар. Кешіріңіз.
Dialogue: 0,0:10:14.94,0:10:17.45,Default,,0,0,0,,Мульти қайтып келгенде➡ үшін
Dialogue: 0,0:10:17.45,0:10:20.12,Default,,0,0,0,,Жұлдызшаларды алғаныңызға көз жеткізіңіз.
Dialogue: 0,0:10:20.12,0:10:22.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:22.08,0:10:25.79,Default,,0,0,0,,Менің қарсыласым кім болады?
Dialogue: 0,0:10:25.79,0:10:31.13,Default,,0,0,0,,Мен Тенканың кімге телефон соққаны туралы біраз абдырап қалдым.
Dialogue: 0,0:10:31.13,0:10:33.70,Default,,0,0,0,,Эго мырза! Келесі матч басталғалы жатыр!
Dialogue: 0,0:10:33.70,0:10:36.13,Default,,0,0,0,,Маки мырза: Олардың бәрін қуып шығу мүмкін емес!
Dialogue: 0,0:10:36.13,0:10:46.77,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:10:46.77,0:10:48.74,Default,,0,0,0,,Міне.
Dialogue: 0,0:10:53.68,0:10:55.62,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:10:55.62,0:10:59.45,Default,,0,0,0,,Ей, тез шайқасайық! Жұлдызды шайқас!
Dialogue: 0,0:10:59.45,0:11:01.96,Default,,0,0,0,,Асықпа, жақындап қалды.
Dialogue: 0,0:11:14.80,0:11:17.47,Default,,0,0,0,,Не? Бұл.
Dialogue: 0,0:11:27.45,0:11:42.30,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:42.30,0:11:45.47,Default,,0,0,0,,Охохохохо....
Dialogue: 0,0:11:45.47,0:11:49.27,Default,,0,0,0,,Няха ня ха ня ха... о хо хо хо!
Dialogue: 0,0:11:49.27,0:11:53.88,Default,,0,0,0,,Охохохохо....
Dialogue: 0,0:11:53.88,0:11:59.61,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:59.61,0:12:03.62,Default,,0,0,0,,Танысқаныма қуаныштымын. Сіз тұлғасыз ба?
Dialogue: 0,0:12:03.62,0:12:05.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:05.62,0:12:09.96,Default,,0,0,0,,Менің атым Алтын Карла.
Dialogue: 0,0:12:09.96,0:12:14.13,Default,,0,0,0,,Мен Гордиас командасының жетекшісімін.
Dialogue: 0,0:12:17.63,0:12:20.30,Default,,0,0,0,,Міне, осында.
Dialogue: 0,0:12:20.30,0:12:22.37,Default,,0,0,0,,Гордиас командасы.
Dialogue: 0,0:12:22.37,0:12:24.84,Default,,0,0,0,,Жақсы~ Тез шайқасайық!
Dialogue: 0,0:12:24.84,0:12:27.71,Default,,0,0,0,,Бір минут күтіңіз! Мен танитын адам бар!
Dialogue: 0,0:12:29.64,0:12:32.95,Default,,0,0,0,,Не? Солай ма? Мүлдем!
Dialogue: 0,0:12:35.15,0:12:38.92,Default,,0,0,0,,Бұл мен Zonamos House-те көмектескен адам!
Dialogue: 0,0:12:41.56,0:12:43.46,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:12:43.46,0:12:45.63,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:12:45.63,0:12:48.30,Default,,0,0,0,,Дүние таңқаларлықтай кішкентай.
Dialogue: 0,0:12:48.30,0:12:52.17,Default,,0,0,0,,Сәлемдесу. Күрсін.
Dialogue: 0,0:12:52.17,0:12:59.47,Default,,0,0,0,,Менің атым Рей Кувабара, Кинджики отбасының қамқоршысы.
Dialogue: 0,0:12:59.47,0:13:01.94,Default,,0,0,0,,Осы бөлімде көрсеткен көмегіңіз үшін көп рахмет.
Dialogue: 0,0:13:01.94,0:13:06.91,Default,,0,0,0,,Жоқ, жоқ! Сенің суық тимегеніңе қуаныштымын, Рейл!
Dialogue: 0,0:13:06.91,0:13:10.62,Default,,0,0,0,,Құс мырзаның жағдайы жақсы сияқты.
Dialogue: 0,0:13:10.62,0:13:14.62,Default,,0,0,0,,Қарғысқа берілме. Хи хи.
Dialogue: 0,0:13:14.62,0:13:19.13,Default,,0,0,0,,Ахаха... Бұл қарғыс болғаны соншалық оккультизм...
Dialogue: 0,0:13:19.13,0:13:22.96,Default,,0,0,0,,Бұл мен және менің қамқоршым, Рейл➡
Dialogue: 0,0:13:22.96,0:13:26.33,Default,,0,0,0,,Ивао екеуміз сенімен айналысамыз.
Dialogue: 0,0:13:26.33,0:13:28.87,Default,,0,0,0,,Гордиас қандай команда?
Dialogue: 0,0:13:28.87,0:13:31.14,Default,,0,0,0,,Сіз мұны білмейсіз бе?
Dialogue: 0,0:13:31.14,0:13:33.78,Default,,0,0,0,,Өйткені бұл Solidus Tower командасы, солай ма?
Dialogue: 0,0:13:33.78,0:13:36.48,Default,,0,0,0,,Solidus мұнарасының электр станциясы.
Dialogue: 0,0:13:36.48,0:13:40.48,Default,,0,0,0,,Биікке шақыру алыс емес дейді.
Dialogue: 0,0:13:40.48,0:13:42.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:50.29,0:13:53.29,Default,,0,0,0,,Енді қорқып тұрсың ба? Хато.
Dialogue: 0,0:13:53.29,0:13:55.80,Default,,0,0,0,,Жоқ... жоқ, бұл дұрыс емес...
Dialogue: 0,0:13:55.80,0:14:00.30,Default,,0,0,0,,X қаласында жүзушілерге қарсы 100 ақ жұлдыз жинаңыз.
Dialogue: 0,0:14:00.30,0:14:02.84,Default,,0,0,0,,Бұл сіздің қолыңыздан келетін іс емес.
Dialogue: 0,0:14:02.84,0:14:07.88,Default,,0,0,0,,Және 100 ақ жұлдыз алсаңыз да➡
Dialogue: 0,0:14:07.88,0:14:12.55,Default,,0,0,0,,Омега одан әрі күтеді.
Dialogue: 0,0:14:15.32,0:14:18.79,Default,,0,0,0,,Егер бұл сізді қорқытуға жеткілікті болса, суши мейрамханасына оралыңыз.
Dialogue: 0,0:14:18.79,0:14:21.79,Default,,0,0,0,,Кім... қорқу керек!
Dialogue: 0,0:14:21.79,0:14:24.46,Default,,0,0,0,,Күшті және көңілді көрінеді!
Dialogue: 0,0:14:24.46,0:14:26.79,Default,,0,0,0,,Сен де алаңсызсың...
Dialogue: 0,0:14:26.79,0:14:29.36,Default,,0,0,0,,Олай болса, бірінші мен бастайын!
Dialogue: 0,0:14:29.36,0:14:31.90,Default,,0,0,0,,Сәлем X. сурет?
Dialogue: 0,0:14:31.90,0:14:35.60,Default,,0,0,0,,Мен жаңа ғана сіздің маскаңызға араның кіргенін көрдім.
Dialogue: 0,0:14:35.60,0:14:37.61,Default,,0,0,0,,Не, бұл өтірік! ?
Dialogue: 0,0:14:37.61,0:14:39.81,Default,,0,0,0,,Бұл өтірік емес. 🔊 (ара ызылдау)
Dialogue: 0,0:14:39.81,0:14:41.81,Default,,0,0,0,,Дәл осы үшін. 🔊 (ара ызылдау)
Dialogue: 0,0:14:41.81,0:14:44.28,Default,,0,0,0,,🔊 (араның ызылдағаны)
Dialogue: 0,0:14:44.28,0:14:46.95,Default,,0,0,0,,Міне болды! ! Эй!
Dialogue: 0,0:14:46.95,0:14:49.62,Default,,0,0,0,,It's in It's in! Мен шуылдап жатырмын! !
Dialogue: 0,0:14:49.62,0:14:54.12,Default,,0,0,0,,Көмектесіңіз! ! Аралар қара заттарға тартылады! !
Dialogue: 0,0:14:58.56,0:15:00.43,Default,,0,0,0,,Онда барыңыз! !
Dialogue: 0,0:15:00.43,0:15:02.46,Default,,0,0,0,,Ах! !
Dialogue: 0,0:15:02.46,0:15:05.60,Default,,0,0,0,,О, сен... Гику!
Dialogue: 0,0:15:05.60,0:15:08.94,Default,,0,0,0,,Сіз маскалы Х деп айттыңыз ба?
Dialogue: 0,0:15:08.94,0:15:12.51,Default,,0,0,0,,Мен сізді бұрын бір жерде көргендей сезінемін бе?
Dialogue: 0,0:15:12.51,0:15:15.54,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:15:15.54,0:15:18.48,Default,,0,0,0,,Мен бетперде киемін! !
Dialogue: 0,0:15:18.48,0:15:20.45,Default,,0,0,0,,X! ?
Dialogue: 0,0:15:20.45,0:15:22.45,Default,,0,0,0,,Бір адам оқудан шығып қалды.
Dialogue: 0,0:15:22.45,0:15:25.45,Default,,0,0,0,,Ой, эй, не істеп жатырсың!
Dialogue: 0,0:15:25.45,0:15:28.46,Default,,0,0,0,,Егер ол құлап кетсе, оған көмектесу мүмкін емес.
Dialogue: 0,0:15:28.46,0:15:31.99,Default,,0,0,0,,Нанайро Мульти-сан мырза да жоқ сияқты➡
Dialogue: 0,0:15:31.99,0:15:35.26,Default,,0,0,0,,Бұл екі адамдық шайқас екеніне сенімдісіз бе?
Dialogue: 0,0:15:35.26,0:15:37.30,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:15:37.30,0:15:39.27,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:15:39.27,0:15:41.30,Default,,0,0,0,,Сіз Бірінші Бладерсіз.
Dialogue: 0,0:15:41.30,0:15:43.27,Default,,0,0,0,,А... мен?
Dialogue: 0,0:15:43.27,0:15:45.47,Default,,0,0,0,,Бұл менің сынағым.
Dialogue: 0,0:15:45.47,0:15:49.94,Default,,0,0,0,,Сіз Solidus командасына қаншалықты сәйкес келетініңізге таң қалдым.
Dialogue: 0,0:15:49.94,0:15:53.95,Default,,0,0,0,,Мүмкін сіз басынан бастап X-ті қалдыруды жоспарлаған боларсыз...
Dialogue: 0,0:15:53.95,0:15:57.15,Default,,0,0,0,,Құс!
Dialogue: 0,0:15:57.15,0:15:59.42,Default,,0,0,0,,Хина! Іске сәт!
Dialogue: 0,0:16:01.79,0:16:03.79,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ!
Dialogue: 0,0:16:03.79,0:16:07.16,Default,,0,0,0,,Танымал Slash Tower және қуатты Solidus Tower.
Dialogue: 0,0:16:07.16,0:16:09.70,Default,,0,0,0,,Бұл сіздің көзіңізді ала алмайтын ойын.
Dialogue: 0,0:16:09.70,0:16:14.47,Default,,0,0,0,,Хмм, Persona кемшілігі бар, өйткені оған Mask X және Seven Color Multi жоқ.
Dialogue: 0,0:16:14.47,0:16:17.34,Default,,0,0,0,,Бұл жаңадан келген кім?
Dialogue: 0,0:16:17.34,0:16:21.14,Default,,0,0,0,,Дұрыс, Камен С болу керек пе?
Dialogue: 0,0:16:21.14,0:16:24.81,Default,,0,0,0,,Уақыт пісіп қалды. Маған ол енді керек емес.
Dialogue: 0,0:16:24.81,0:16:26.78,Default,,0,0,0,,Санго!
Dialogue: 0,0:16:26.78,0:16:30.18,Default,,0,0,0,,Жұмысты бастаңыз! Деши!
Dialogue: 0,0:16:30.18,0:16:32.45,Default,,0,0,0,,Алтын Санго да келе жатыр.
Dialogue: 0,0:16:36.99,0:16:41.96,Default,,0,0,0,,Мобильді 4X портативті жүйесі!
Dialogue: 0,0:16:44.97,0:16:47.27,Default,,0,0,0,,Бейне таратуды бастаңыз!
Dialogue: 0,0:16:47.27,0:16:50.14,Default,,0,0,0,,Не?
Dialogue: 0,0:16:50.14,0:16:56.21,Default,,0,0,0,,Мен Тенка Хакубошимін, Хакубоши-рю нұсқаушысы орынбасарымын!
Dialogue: 0,0:16:56.21,0:16:58.98,Default,,0,0,0,,Хакусей стилі? Омега емес пе?
Dialogue: 0,0:16:58.98,0:17:02.45,Default,,0,0,0,,Мойынды жуып, күт.
Dialogue: 0,0:17:02.45,0:17:05.65,Default,,0,0,0,,Оны кесуді ұмытпаңыз!
Dialogue: 0,0:17:11.13,0:17:13.10,Default,,0,0,0,,Мыс. жоқ. Не болады?
Dialogue: 0,0:17:13.10,0:17:16.33,Default,,0,0,0,,Екі адамға бола ма?
Dialogue: 0,0:17:16.33,0:17:19.70,Default,,0,0,0,,Тенка-саманың бір ойы бар шығар.
Dialogue: 0,0:17:19.70,0:17:23.70,Default,,0,0,0,,Маска Маска... Менің маскам.
Dialogue: 0,0:17:25.97,0:17:29.48,Default,,0,0,0,,Екі топ жетекшілері де бірінші болып табылады.
Dialogue: 0,0:17:29.48,0:17:31.65,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:17:31.65,0:17:33.61,Default,,0,0,0,,Ах.
Dialogue: 0,0:17:33.61,0:17:36.78,Default,,0,0,0,,Пуф! Барлығына WhatsApp!
Dialogue: 0,0:17:36.78,0:17:41.46,Default,,0,0,0,,Кішкентай! Жұлдызды шайқас ақыры басталды!
Dialogue: 0,0:17:41.46,0:17:45.63,Default,,0,0,0,,Бұл портативті нөлдік режим ең танымал матчтар үшін кедергі болады!
Dialogue: 0,0:17:45.63,0:17:51.53,Default,,0,0,0,,Пон! X Tower тұмары AI портативті құлпынай да қол жетімді болады!
Dialogue: 0,0:17:51.53,0:17:55.77,Default,,0,0,0,,Осы стадионда біз Slash Tower➡ шыңына шығуға тырыстық
Dialogue: 0,0:17:55.77,0:17:58.64,Default,,0,0,0,,Тәжірибелі команда тұлғасы!
Dialogue: 0,0:17:58.64,0:18:02.48,Default,,0,0,0,,және Solidus Tower жоғарғы қабат командасы➡
Dialogue: 0,0:18:02.48,0:18:05.65,Default,,0,0,0,,Гордиас арасындағы шайқас басталғалы тұр!
Dialogue: 0,0:18:05.65,0:18:09.52,Default,,0,0,0,,Танымал командалар арасындағы шайқастар әртүрлі жерлерде басталды!
Dialogue: 0,0:18:09.52,0:18:12.55,Default,,0,0,0,,Әрбір матчтың көрермендері көп!
Dialogue: 0,0:18:12.55,0:18:16.12,Default,,0,0,0,,Және әдетте сіз көре алмайтын жақыннан түсіру тәжірибесін алыңыз➡
Dialogue: 0,0:18:16.12,0:18:20.16,Default,,0,0,0,,Көптеген жанкүйерлер оны асыға күтуде!
Dialogue: 0,0:18:20.16,0:18:23.70,Default,,0,0,0,,Жарайды! Олай болса, шайқас басталсын!
Dialogue: 0,0:18:23.70,0:18:26.70,Default,,0,0,0,,Бәс тігу керек жұлдыздар санын жариялаңыз!
Dialogue: 0,0:18:31.44,0:18:35.94,Default,,0,0,0,,Ал... Ең алдымен, бір бөлік!
Dialogue: 0,0:18:35.94,0:18:37.95,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:18:37.95,0:18:41.62,Default,,0,0,0,,Онда мен де бір бәс тігемін!
Dialogue: 0,0:18:41.62,0:18:46.29,Default,,0,0,0,,Төрт? Әр команда үштен бастау керек емес пе?
Dialogue: 0,0:18:46.29,0:18:49.16,Default,,0,0,0,,Охохо! Сіз байқаған сияқтысыз.
Dialogue: 0,0:18:49.16,0:18:51.66,Default,,0,0,0,,Біз Гордиас командасымыз➡
Dialogue: 0,0:18:51.66,0:18:54.30,Default,,0,0,0,,Мен бір шайқасты аяқтадым.
Dialogue: 0,0:18:54.30,0:18:59.13,Default,,0,0,0,,Шынымды айтсам, мен уақытында үлгеретінімді білмегендіктен қатты асықтым.
Dialogue: 0,0:18:59.13,0:19:02.50,Default,,0,0,0,,Сонда 4 жұлдыз бар ма? Иә.
Dialogue: 0,0:19:02.50,0:19:05.54,Default,,0,0,0,,Сізбен араласатын адамдар - сіз жақсы білетін адамдар.
Dialogue: 0,0:19:05.54,0:19:07.51,Default,,0,0,0,,Сен оны жақсы білесің бе?
Dialogue: 0,0:19:14.15,0:19:18.19,Default,,0,0,0,,Орталық - Ватари-сан! Стоун Монблан!
Dialogue: 0,0:19:18.19,0:19:27.33,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:27.33,0:19:30.46,Default,,0,0,0,,Голем Рокты жазалаңыз!
Dialogue: 0,0:19:30.46,0:19:40.27,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:40.27,0:19:42.28,Default,,0,0,0,,Қосымша түсірілім!
Dialogue: 0,0:19:42.28,0:19:44.81,Default,,0,0,0,,Керемет бұлшықет!
Dialogue: 0,0:19:44.81,0:19:54.46,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:54.46,0:19:59.16,Default,,0,0,0,,Golem Lock Spin Finish! Гого Ивао жеңді!
Dialogue: 0,0:20:07.30,0:20:10.94,Default,,0,0,0,,Бұл өтірік, солай ма? Ишиямадағы Стоун Монблан➡
Dialogue: 0,0:20:10.94,0:20:13.27,Default,,0,0,0,,Айналдыруға сене алар емеспін!
Dialogue: 0,0:20:13.27,0:20:17.45,Default,,0,0,0,,Маған қарамастан, мен Берн мырзамен жақсы қарым-қатынастамын ➡
Dialogue: 0,0:20:17.45,0:20:22.32,Default,,0,0,0,,Такуми Ишиямаға қарсы санкциялар бар ма?
Dialogue: 0,0:20:22.32,0:20:24.65,Default,,0,0,0,,Na…. Ал, 1 жұлдыз➡
Dialogue: 0,0:20:24.65,0:20:29.46,Default,,0,0,0,,Мен сені кешірдім! Охохохохохо!
Dialogue: 0,0:20:29.46,0:20:35.13,Default,,0,0,0,,Өйткені, маған Өлмейтін Күйік-сама сыйы берілді.
Dialogue: 0,0:20:35.13,0:20:37.97,Default,,0,0,0,,Ииназуке дегеніміз не?
Dialogue: 0,0:20:37.97,0:20:40.80,Default,,0,0,0,,Бұл некеге тұруға уәде етілген қарым-қатынас.
Dialogue: 0,0:20:40.80,0:20:44.27,Default,,0,0,0,,Шынымен! ? Бұл ауыр!
Dialogue: 0,0:20:44.27,0:20:46.31,Default,,0,0,0,,Ондай факті жоқ.
Dialogue: 0,0:20:46.31,0:20:49.94,Default,,0,0,0,,Жас келіншек мұны өз бетінше айтып тұр.
Dialogue: 0,0:20:49.94,0:20:53.31,Default,,0,0,0,,Жарайды, өйткені мен шешім қабылдадым!
Dialogue: 0,0:20:53.31,0:20:55.48,Default,,0,0,0,,Жарайды, бастайық.
Dialogue: 0,0:20:55.48,0:20:57.49,Default,,0,0,0,,Т… Мені ешкім қудалап жүрген жоқ еді.
Dialogue: 0,0:20:57.49,0:21:00.79,Default,,0,0,0,,Менің серіктесім...
Dialogue: 0,0:21:02.82,0:21:05.16,Default,,0,0,0,,Тозақ тізбегі Біз міндетті түрде жеңеміз!
Dialogue: 0,0:21:05.16,0:21:07.13,Default,,0,0,0,,Кухихи….
Dialogue: 0,0:21:14.50,0:21:18.47,Default,,0,0,0,,Казами құсы Сіз өміріңіздің соңына дейін осындасыз➡
Dialogue: 0,0:21:18.47,0:21:22.18,Default,,0,0,0,,Бейбаттлде жеңілуді жалғастырыңыз.
Dialogue: 0,0:21:24.31,0:21:28.68,Default,,0,0,0,,Қарғыс деген жоқ!
Dialogue: 0,0:21:28.68,0:21:32.25,Default,,0,0,0,,Тозақ тізбегі! қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:21:32.25,0:21:35.96,Default,,0,0,0,,Сіз кез келген нәрсені оңай жеңе алатын шығанақты таңдадыңыз ба?
Dialogue: 0,0:21:35.96,0:21:39.13,Default,,0,0,0,,Бірақ Гордиастың ең үлкен қасиеті –➡
Dialogue: 0,0:21:39.13,0:21:41.83,Default,,0,0,0,,Bay Sponsor, ол да Алтын Карланың отбасылық үйі.
Dialogue: 0,0:21:41.83,0:21:45.17,Default,,0,0,0,,Gordias Precious Metals Bay ұсынған.
Dialogue: 0,0:21:45.17,0:21:48.20,Default,,0,0,0,,Охохохохохо….
Dialogue: 0,0:21:48.20,0:21:50.10,Default,,0,0,0,,Сіз оны жақсы білетініңізге сенімдімін.
Dialogue: 0,0:21:50.10,0:21:52.61,Default,,0,0,0,,Енді көрсетейін.
Dialogue: 0,0:21:52.61,0:21:54.61,Default,,0,0,0,,Бұл менікі➡
Dialogue: 0,0:21:54.61,0:21:57.41,Default,,0,0,0,,Бұл Crimson Garuda!
Dialogue: 0,0:22:00.28,0:22:02.45,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:22:02.45,0:22:04.62,Default,,0,0,0,,Қып-қызыл Гаруда.
Dialogue: 0,0:22:04.62,0:22:07.99,Default,,0,0,0,,Бұл бала ең соңғы алдыңғы шеп!
Dialogue: 0,0:22:07.99,0:22:10.79,Default,,0,0,0,,Бұл болашақ Бейблейдтердің стандарты болатын Бей!
Dialogue: 0,0:22:13.63,0:22:16.46,Default,,0,0,0,,Жарайды! Екеуі де дайын!
Dialogue: 0,0:22:16.46,0:22:20.30,Default,,0,0,0,,Ниго-чан, қоңырау шал!
Dialogue: 0,0:22:20.30,0:22:22.30,Default,,0,0,0,,Бірінші жиын!
Dialogue: 0,0:22:24.87,0:22:26.87,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:22:26.87,0:22:30.11,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:22:30.11,0:22:33.71,Default,,0,0,0,,Қой!
Dialogue: 0,0:22:35.21,0:22:41.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory