Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.00,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:00:02.00,0:00:04.00,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:00:04.00,0:00:07.51,Default,,0,0,0,,енгізілді енгізілді
Dialogue: 0,0:00:07.51,0:00:10.47,Default,,0,0,0,,100 ұпай, базалар жүктелді! Қош бол үйге жүгіру!
Dialogue: 0,0:00:10.85,0:00:12.45,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:00:12.81,0:00:16.31,Default,,0,0,0,,Сәлем! Ер адам қызықсыз жерде тұра ала ма?
Dialogue: 0,0:00:16.31,0:00:18.45,Default,,0,0,0,,Келесі, келесі! Келесі жолы біз жеңеміз!
Dialogue: 0,0:00:18.45,0:00:20.91,Default,,0,0,0,,Ол үшін не қажет болса да жасаймыз!
Dialogue: 0,0:00:37.51,0:00:39.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:41.81,0:00:46.81,Default,,0,0,0,,Сәлем! Студентті ауыстыру! Алғашқы күннен кешігуге батылдық жетпейді!
Dialogue: 0,0:00:46.81,0:00:48.81,Default,,0,0,0,,Сыныбыңызды және атыңызды айтыңыз!
Dialogue: 0,0:00:49.81,0:00:51.81,Default,,0,0,0,,Менің атым Горда Джордж, үшінші курс студенті!
Dialogue: 0,0:00:51.81,0:00:55.81,Default,,0,0,0,,Мен бұл мектепке бейсболдан елді бағындыру үшін келдім!
Dialogue: 0,0:00:55.81,0:00:57.81,Default,,0,0,0,,Бейсболда елді бағындыру?
Dialogue: 0,0:00:58.81,0:01:02.81,Default,,0,0,0,,Жаз бітті, сен неге жартылай ұйықтап жатырсың?
Dialogue: 0,0:01:07.81,0:01:08.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:01:08.73,0:01:10.73,Default,,0,0,0,,Мен сені бала күнімнен Эйс деп атаған емеспін!
Dialogue: 0,0:01:12.73,0:01:17.73,Default,,0,0,0,,Бұл Года Джордж сізді міндетті түрде Нишиномияға апарады!
Dialogue: 0,0:01:21.73,0:01:23.73,Default,,0,0,0,,Көңіл көтеру жаттығуына сәттілік
Dialogue: 0,0:01:24.73,0:01:26.73,Default,,0,0,0,,Джордж! Бұл мүмкін емес!
Dialogue: 0,0:01:28.73,0:01:32.73,Default,,0,0,0,,Егер сіз мүмкін деп ойласаңыз, мүмкін емес нәрсе де мүмкін болады!
Dialogue: 0,0:01:33.73,0:01:35.73,Default,,0,0,0,,Ей, ойлаудың бір ғана жолы бар!
Dialogue: 0,0:01:38.73,0:01:40.73,Default,,0,0,0,,Джордж!
Dialogue: 0,0:01:41.73,0:01:43.73,Default,,0,0,0,,Джордж!
Dialogue: 0,0:01:44.73,0:01:45.53,Default,,0,0,0,,Джордж!
Dialogue: 0,0:01:45.53,0:01:51.67,Default,,0,0,0,,Келесі жаз ешқашан келмейді
Dialogue: 0,0:01:51.93,0:01:53.47,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:01:53.73,0:02:01.62,Default,,0,0,0,,Мен үшінші курс студентімін.
Dialogue: 0,0:02:01.62,0:02:07.58,Default,,0,0,0,,Иә, мен оны тастадым. Амал жоқ, бәрі мүмкін емес деп айтты.
Dialogue: 0,0:02:07.98,0:02:09.92,Default,,0,0,0,,Сіз байқамадыңыз ба?
Dialogue: 0,0:02:10.28,0:02:11.78,Default,,0,0,0,,Әй, сен нағыз ақымақ екенсің.
Dialogue: 0,0:02:11.92,0:02:12.36,Default,,0,0,0,,Сен ақымақ.
Dialogue: 0,0:02:12.56,0:02:17.84,Default,,0,0,0,,Иә, бұл өте ерекше өзін-өзі таныстыру болды. Сізге көп рахмет, төраға.
Dialogue: 0,0:02:18.18,0:02:19.76,Default,,0,0,0,,Мен не үшінмін?
Dialogue: 0,0:02:21.26,0:02:25.26,Default,,0,0,0,,Мен, Акане Сузумия, сынып өкілі. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:02:31.62,0:02:35.46,Default,,0,0,0,,Сенімен танысқаныма қуаныштымын, Гуда-кун.
Dialogue: 0,0:03:13.14,0:03:15.74,Default,,0,0,0,,Нәзік күлімсіреу
Dialogue: 0,0:03:45.74,0:03:54.52,Default,,0,0,0,,Енді келесі маусымға қолдарыңызды ашыңыз
Dialogue: 0,0:03:54.52,0:04:01.64,Default,,0,0,0,,Кең көк аспанда, бар күш-қуатпен қанат қағып
Dialogue: 0,0:04:36.50,0:04:38.50,Default,,0,0,0,,Сізді ауруханадан шығуыңызбен құттықтаймыз.
Dialogue: 0,0:04:38.50,0:04:42.00,Default,,0,0,0,,Бірақ кешіріңіз.
Dialogue: 0,0:04:42.00,0:04:45.00,Default,,0,0,0,,Мен Харуканы кездестіре алмаймын
Dialogue: 0,0:05:14.82,0:05:15.72,Default,,0,0,0,,Такада-кун
Dialogue: 0,0:05:15.72,0:05:17.20,Default,,0,0,0,,Кеттік
Dialogue: 0,0:05:17.20,0:05:19.20,Default,,0,0,0,,Акане-сан сені алып кетуге келді.
Dialogue: 0,0:05:19.20,0:05:20.20,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:05:20.20,0:05:22.20,Default,,0,0,0,,Жүр, қолшатырымды алшы.
Dialogue: 0,0:05:22.20,0:05:23.20,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:05:23.20,0:05:26.58,Default,,0,0,0,,Сәлем! Мен қолшатырымды ұмытып қалдым!
Dialogue: 0,0:05:26.58,0:05:29.20,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:05:32.50,0:05:35.80,Default,,0,0,0,,Маған ұнады! Акане-сан
Dialogue: 0,0:05:34.80,0:05:36.30,Default,,0,0,0,,Бізге қосылыңыз!
Dialogue: 0,0:05:36.30,0:05:37.30,Default,,0,0,0,,Не?
Dialogue: 0,0:05:37.30,0:05:40.80,Default,,0,0,0,,Ал болашақта менің әйелім бол!
Dialogue: 0,0:05:40.80,0:05:42.80,Default,,0,0,0,,Ұсыныс?
Dialogue: 0,0:05:42.80,0:05:43.80,Default,,0,0,0,,Бұл үйлену туралы ұсыныс!
Dialogue: 0,0:05:43.80,0:05:44.80,Default,,0,0,0,,Кенет...
Dialogue: 0,0:05:44.80,0:05:47.80,Default,,0,0,0,,Әй, алғаш кездескенде не айтасың!
Dialogue: 0,0:05:48.80,0:05:50.80,Default,,0,0,0,,Кездесуге уақыттың қатысы жоқ!
Dialogue: 0,0:05:50.80,0:05:51.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:51.80,0:05:53.80,Default,,0,0,0,,Мен Акадені қуантамын!
Dialogue: 0,0:05:53.80,0:05:54.80,Default,,0,0,0,,Мен уәде беремін!
Dialogue: 0,0:05:54.80,0:05:57.80,Default,,0,0,0,,Бұл сынып бекітілген!
Dialogue: 0,0:05:57.80,0:05:58.80,Default,,0,0,0,,Өзіңізді алдамаңыз!
Dialogue: 0,0:05:58.80,0:06:00.80,Default,,0,0,0,,Мен не нәрсеге қанағаттанбаймын?
Dialogue: 0,0:06:00.80,0:06:02.80,Default,,0,0,0,,Айтыңыз!
Dialogue: 0,0:06:02.80,0:06:04.80,Default,,0,0,0,,Сіз кенеттен осындай бірдеңе айтқыңыз келіп тұр!
Dialogue: 0,0:06:04.80,0:06:05.80,Default,,0,0,0,,Гарн!
Dialogue: 0,0:06:05.80,0:06:07.80,Default,,0,0,0,,Қалжың болса да олай айтпа!
Dialogue: 0,0:06:13.80,0:06:14.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:14.54,0:06:17.10,Default,,0,0,0,,Ха, күттіргенім үшін кешіріңіз, Акане-сан.
Dialogue: 0,0:06:17.10,0:06:17.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:17.60,0:06:21.10,Default,,0,0,0,,Жарайды, бір қолшатыр жеткілікті.
Dialogue: 0,0:06:21.10,0:06:24.10,Default,,0,0,0,,Ал, жарасып, қолшатырдың астында үйге қайтайық.
Dialogue: 0,0:06:24.10,0:06:26.10,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:26.10,0:06:29.10,Default,,0,0,0,,Өйткені маған Аканэ-сан ұнайды.
Dialogue: 0,0:06:29.10,0:06:35.60,Default,,0,0,0,,Уф, мен сені сүйемін деп айту оңай емес деп ойлаймын.
Dialogue: 0,0:06:35.60,0:06:36.60,Default,,0,0,0,,Уф
Dialogue: 0,0:06:37.60,0:06:43.60,Default,,0,0,0,,Не, не, Акане-сан?
Dialogue: 0,0:06:44.54,0:06:46.54,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:06:51.11,0:06:57.21,Default,,0,0,0,,Ақанең екеуміздің бірге болатынымыз тарихта сөзсіз.
Dialogue: 0,0:06:57.21,0:07:01.63,Default,,0,0,0,,Бірақ бұған дейін мәселе оларды бір-бірін қалай тануға болады.
Dialogue: 0,0:07:01.63,0:07:07.23,Default,,0,0,0,,Қандай ашық бас тарту
Dialogue: 0,0:07:07.23,0:07:10.39,Default,,0,0,0,,Жанады, күйеді
Dialogue: 0,0:07:10.39,0:07:13.21,Default,,0,0,0,,Жол неғұрлым тік болса, соғұрлым көп
Dialogue: 0,0:07:13.21,0:07:15.69,Default,,0,0,0,,Бірақ мен не істеуім керек?
Dialogue: 0,0:07:15.69,0:07:18.55,Default,,0,0,0,,Менің басым бейсболға арналды.
Dialogue: 0,0:07:18.55,0:07:20.51,Default,,0,0,0,,Менің ойыма ештеңе келмейді
Dialogue: 0,0:07:20.51,0:07:22.37,Default,,0,0,0,,Сіз көп қиындыққа тап болған сияқтысыз.
Dialogue: 0,0:07:22.37,0:07:27.19,Default,,0,0,0,,Ауа райының бірінші күні ұсыныс жасауға қорықтым.
Dialogue: 0,0:07:27.19,0:07:28.67,Default,,0,0,0,,Горзуки мырза
Dialogue: 0,0:07:28.67,0:07:31.73,Default,,0,0,0,,Бірақ басқа адам – мектептің жұлдызы
Dialogue: 0,0:07:31.73,0:07:33.77,Default,,0,0,0,,Қорғаныс күшті.
Dialogue: 0,0:07:33.77,0:07:36.39,Default,,0,0,0,,Маған жараса, күшімді берем.
Dialogue: 0,0:07:36.39,0:07:37.97,Default,,0,0,0,,Күш
Dialogue: 0,0:07:37.97,0:07:39.67,Default,,0,0,0,,Кел, Гоуда
Dialogue: 0,0:07:39.67,0:07:41.53,Default,,0,0,0,,Сол есікті ашыңыз.
Dialogue: 0,0:07:43.87,0:07:48.09,Default,,0,0,0,,Оны ашсаңыз, сіз жеңілмейтін күшке ие боласыз.
Dialogue: 0,0:07:48.09,0:07:49.79,Default,,0,0,0,,Жеңілмейтін күш
Dialogue: 0,0:07:49.79,0:07:50.79,Default,,0,0,0,,болды
Dialogue: 0,0:07:50.79,0:07:53.79,Default,,0,0,0,,Екінші жақта осындай нәрсе бар
Dialogue: 0,0:07:53.79,0:07:56.79,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:07:56.79,0:08:01.31,Default,,0,0,0,,шықты
Dialogue: 0,0:08:01.31,0:08:04.59,Default,,0,0,0,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:08:04.59,0:08:06.59,Default,,0,0,0,,Бұл алып робот!
Dialogue: 0,0:08:06.59,0:08:08.59,Default,,0,0,0,,Иә, бұл сіздің күшіңіз.
Dialogue: 0,0:08:08.59,0:08:12.59,Default,,0,0,0,,Егер сізде бұл Гордин болса, сіз құдай немесе шайтан бола аласыз.
Dialogue: 0,0:08:12.59,0:08:14.59,Default,,0,0,0,,Тіпті әлемді бұзады!
Dialogue: 0,0:08:14.59,0:08:18.59,Default,,0,0,0,,Agoda George! Саған не керек?
Dialogue: 0,0:08:18.59,0:08:22.59,Default,,0,0,0,,Менің тілегім бір ғана!
Dialogue: 0,0:08:22.59,0:08:25.59,Default,,0,0,0,,Бұл күш сол адамға!
Dialogue: 0,0:08:34.59,0:08:37.59,Default,,0,0,0,,...
Dialogue: 0,0:08:42.59,0:08:44.59,Default,,0,0,0,,Аканесан!
Dialogue: 0,0:08:44.59,0:08:50.51,Default,,0,0,0,,Аканесан! Мен оны жақсы көремін!
Dialogue: 0,0:08:50.51,0:08:54.09,Default,,0,0,0,,Дәрігердің құдіретін еркін қабылдаңыз.
Dialogue: 0,0:08:54.09,0:08:55.05,Default,,0,0,0,,Дәрігер?
Dialogue: 0,0:08:56.35,0:08:57.37,Default,,0,0,0,,Шынында да, ол үйде өте сабырлы.
Dialogue: 0,0:08:57.37,0:08:58.79,Default,,0,0,0,,Сузумия
Dialogue: 0,0:08:58.79,0:08:59.75,Default,,0,0,0,,Иә
Dialogue: 0,0:08:59.75,0:09:02.87,Default,,0,0,0,,Бұл не, сэр?
Dialogue: 0,0:09:02.87,0:09:06.29,Default,,0,0,0,,Жоқ, ауысатын студентті жалғыз қалдырмаңыз.
Dialogue: 0,0:09:06.29,0:09:09.63,Default,,0,0,0,,Бос уақытың болса, мектепті аралап көр.
Dialogue: 0,0:09:09.63,0:09:11.87,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:09:11.87,0:09:15.35,Default,,0,0,0,,Олай болса, Гоуда, менімен бірге жүр.
Dialogue: 0,0:09:15.35,0:09:16.29,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:09:16.29,0:09:20.05,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:09:20.05,0:09:21.51,Default,,0,0,0,,Рахмет сізге доктор.
Dialogue: 0,0:09:21.51,0:09:32.23,Default,,0,0,0,,Есіңде ме, бұл дзюдо залы, ал клубтың нұсқаушы бөлмесі одан тыс жерде?
Dialogue: 0,0:09:32.55,0:09:35.69,Default,,0,0,0,,Әй, анау Акане-сан
Dialogue: 0,0:09:35.69,0:09:36.83,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:09:36.83,0:09:43.33,Default,,0,0,0,,Біреуді жақсы көремін деп айту оңай емес деп ойлаймын.
Dialogue: 0,0:09:43.33,0:09:49.21,Default,,0,0,0,,Дұрыс, жай айтпай-ақ қояйық, мұны іс-әрекетіңмен көрсету керек деген сөз.
Dialogue: 0,0:09:49.45,0:09:50.03,Default,,0,0,0,,Акане-сан
Dialogue: 0,0:09:50.03,0:09:53.23,Default,,0,0,0,,ол тек ерінбейтін адамға ақша төлейтінін айтты.
Dialogue: 0,0:09:53.23,0:09:58.71,Default,,0,0,0,,Гоуда-кун
Dialogue: 0,0:09:58.71,0:10:00.49,Default,,0,0,0,,Мен Аканэ-санды жақсы көремін
Dialogue: 0,0:10:00.49,0:10:05.61,Default,,0,0,0,,Өйткені, бұл итермелейтін адам осындай болуы керек.
Dialogue: 0,0:10:05.61,0:10:08.53,Default,,0,0,0,,Мені қаттырақ ұстаңыз
Dialogue: 0,0:10:08.53,0:10:09.99,Default,,0,0,0,,Акане-сан
Dialogue: 0,0:10:09.99,0:10:12.23,Default,,0,0,0,,үшін осы
Dialogue: 0,0:10:12.23,0:10:12.47,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:10:12.47,0:10:17.11,Default,,0,0,0,,Олай болса, бұл жағу пеші мектептегі саяхаттың соңы.
Dialogue: 0,0:10:17.11,0:10:19.35,Default,,0,0,0,,Содан кейін менің үйірме жұмысым бар.
Dialogue: 0,0:10:19.35,0:10:19.41,Default,,0,0,0,,О?
Dialogue: 0,0:10:20.03,0:10:23.37,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:10:23.37,0:10:25.13,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:10:25.21,0:10:27.09,Default,,0,0,0,,Жоқ, иә, бұл.
Dialogue: 0,0:10:27.09,0:10:28.71,Default,,0,0,0,,Іс жоқ болса, барамын.
Dialogue: 0,0:10:29.08,0:10:34.08,Default,,0,0,0,,Сіз біртүрлі нәрсе айтқаныңыз үшін басқа сыныптағы достарыңыз да сізге көп нәрсені айтып жатыр.
Dialogue: 0,0:10:34.08,0:10:36.08,Default,,0,0,0,,Маған мүлдем бәрібір
Dialogue: 0,0:10:36.08,0:10:38.08,Default,,0,0,0,,Маған көңіл бөледі
Dialogue: 0,0:10:38.08,0:10:40.08,Default,,0,0,0,,Айтқысы келгендер айтсын.
Dialogue: 0,0:10:40.08,0:10:43.08,Default,,0,0,0,,Ең бастысы екі адамның да сезімі.
Dialogue: 0,0:10:43.08,0:10:46.08,Default,,0,0,0,,Иә, мен де барамын.
Dialogue: 0,0:10:46.08,0:10:50.08,Default,,0,0,0,,А, сәл күте тұрыңыз. Әзірше емес. Әлі біткен жоқ.
Dialogue: 0,0:10:50.08,0:10:52.08,Default,,0,0,0,,Жақсы
Dialogue: 0,0:10:53.08,0:10:58.08,Default,,0,0,0,,Ауыстырушы студент ретінде сөйлесетін нәрсені іздеңіз.
Dialogue: 0,0:10:59.08,0:11:02.08,Default,,0,0,0,,Осымен.
Dialogue: 0,0:11:02.08,0:11:06.08,Default,,0,0,0,,Әй, артындағы мына төбе не?
Dialogue: 0,0:11:06.08,0:11:11.08,Default,,0,0,0,,Төбенің басында көптеген ағаштар өсіп тұр.
Dialogue: 0,0:11:11.08,0:11:16.08,Default,,0,0,0,,О, мен тағы не істеп жатырмын?
Dialogue: 0,0:11:16.08,0:11:18.08,Default,,0,0,0,,Хихихи
Dialogue: 0,0:11:18.08,0:11:20.08,Default,,0,0,0,,Кеттік
Dialogue: 0,0:11:20.08,0:11:23.08,Default,,0,0,0,,Қалай болғанда да.
Dialogue: 0,0:11:25.08,0:11:28.08,Default,,0,0,0,,Уваа
Dialogue: 0,0:11:29.08,0:11:33.08,Default,,0,0,0,,Ооо
Dialogue: 0,0:11:33.08,0:11:35.08,Default,,0,0,0,,Ууу
Dialogue: 0,0:11:35.08,0:11:36.08,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:11:36.08,0:11:39.08,Default,,0,0,0,,Әр нәрсенің үстінде болу өзін жақсы сезінеді.
Dialogue: 0,0:11:39.08,0:11:41.08,Default,,0,0,0,,Олай ойламайсың ба, Ақане-сан?
Dialogue: 0,0:11:41.08,0:11:55.08,Default,,0,0,0,,Ах
Dialogue: 0,0:11:55.08,0:12:02.12,Default,,0,0,0,,Бұл
Dialogue: 0,0:12:02.12,0:12:04.12,Default,,0,0,0,,Акане-сан?
Dialogue: 0,0:12:06.12,0:12:08.12,Default,,0,0,0,,О, сигналы келіп жатыр, келіп жатыр
Dialogue: 0,0:12:09.12,0:12:15.12,Default,,0,0,0,,Мойындап, осы ағаштың астына біріккендер жақсы болады дейді.
Dialogue: 0,0:12:16.12,0:12:19.12,Default,,0,0,0,,Мектеп ішінде өсек-аяң өтті
Dialogue: 0,0:12:23.12,0:12:25.09,Default,,0,0,0,,Уау, міне келдік!
Dialogue: 0,0:12:25.09,0:12:27.85,Default,,0,0,0,,Акане-сан, сен мені осыны айту үшін әкелдің!
Dialogue: 0,0:12:27.85,0:12:30.85,Default,,0,0,0,,Басқаша айтқанда, бұдан кейін не болатыны сөзсіз шындық!
Dialogue: 0,0:12:35.19,0:12:38.65,Default,,0,0,0,,Негізі мен сені айтып тұрмын, Гоуда...
Dialogue: 0,0:12:38.65,0:12:40.49,Default,,0,0,0,,Мен сізге айтпай-ақ білемін.
Dialogue: 0,0:12:41.15,0:12:44.53,Default,,0,0,0,,Екеуміз осы жерден бастаймыз!
Dialogue: 0,0:12:44.53,0:12:45.33,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:45.85,0:12:50.09,Default,,0,0,0,,Олай болса, мына ағаштың астында сезімдерімізді тексеруге рұқсат етіңіздер.
Dialogue: 0,0:12:53.17,0:12:54.21,Default,,0,0,0,,Акане-сан
Dialogue: 0,0:12:55.09,0:12:56.89,Default,,0,0,0,,Акане-сан
Dialogue: 0,0:12:56.89,0:13:01.65,Default,,0,0,0,,Уау! Жоқ! Махаббат сынақтарға толы! Айтайын дегенім!
Dialogue: 0,0:13:01.65,0:13:03.19,Default,,0,0,0,,Акане-сан
Dialogue: 0,0:13:03.19,0:13:06.19,Default,,0,0,0,,Е-не!?
Dialogue: 0,0:13:06.19,0:13:08.19,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:08.19,0:13:10.99,Default,,0,0,0,,Гуданың қолын тартыңыз
Dialogue: 0,0:13:10.99,0:13:12.99,Default,,0,0,0,,Гуданың қолын тартыңыз
Dialogue: 0,0:13:12.99,0:13:14.99,Default,,0,0,0,,Гуданың қолын тартыңыз
Dialogue: 0,0:13:14.99,0:13:17.99,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:17.99,0:13:20.73,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:20.74,0:13:22.74,Default,,0,0,0,,Сен неге оларға араласып тұрсың?
Dialogue: 0,0:13:22.74,0:13:28.74,Default,,0,0,0,,Жарайды! Мен Акане Санохпын! Мен біздің махаббатымызды міндетті түрде қорғаймын!
Dialogue: 0,0:13:28.74,0:13:30.74,Default,,0,0,0,,Года-кун!
Dialogue: 0,0:13:38.37,0:13:42.87,Default,,0,0,0,,Жүр, кеттік, Гордин! Өз күшіңізді көрсететін уақыт келді!
Dialogue: 0,0:13:43.61,0:13:45.87,Default,,0,0,0,,Расва Катабалт ашық!
Dialogue: 0,0:13:48.99,0:13:51.99,Default,,0,0,0,,Жеңілмейтін күшті жеңіз!
Dialogue: 0,0:13:53.61,0:13:56.37,Default,,0,0,0,,Зымыран кратері!
Dialogue: 0,0:14:08.37,0:14:10.37,Default,,0,0,0,,Акане-сан!
Dialogue: 0,0:14:11.37,0:14:13.37,Default,,0,0,0,,Гоуда-кун!
Dialogue: 0,0:14:18.37,0:14:20.70,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:20.70,0:14:24.94,Default,,0,0,0,,Міне! Бұл жалғыз! Дұрыс, Ақане-сан!
Dialogue: 0,0:14:27.94,0:14:28.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.04,0:14:41.08,Default,,0,0,0,,Ақан!
Dialogue: 0,0:14:41.09,0:14:44.47,Default,,0,0,0,,Не болды, іңір батқан ба?
Dialogue: 0,0:14:44.47,0:14:48.97,Default,,0,0,0,,Чизуру, сен қазір мені ауыстырасың ба? Лакросс клубы?
Dialogue: 0,0:14:48.97,0:14:54.75,Default,,0,0,0,,Иә, үшінші жыл зейнеткерлікке шыққаннан бері ойыншылар саны азайды, сондықтан біз тіпті команда құра алмаймыз, солай ма?
Dialogue: 0,0:14:54.75,0:14:59.27,Default,,0,0,0,,Мені жалғыз қалдырмаңыз. Демек, бұл да қиын болуы керек, жаттығу.
Dialogue: 0,0:14:59.27,0:15:03.07,Default,,0,0,0,,Не болды? Сіз өзіңізді жақсы сезінбейсіз.
Dialogue: 0,0:15:03.07,0:15:06.09,Default,,0,0,0,,Иә? Иә, шынымен емес.
Dialogue: 0,0:15:06.09,0:15:11.47,Default,,0,0,0,,Ертең Expo фестивалінің атқарушы комитетінің отырысы болады.
Dialogue: 0,0:15:11.47,0:15:15.41,Default,,0,0,0,,Акане әлі D класының жалғыз мүшесі, солай ма?
Dialogue: 0,0:15:15.41,0:15:20.21,Default,,0,0,0,,Менің ойымша, бұл төрағаның орынбасары Такео-кун болар.
Dialogue: 0,0:15:20.21,0:15:23.27,Default,,0,0,0,,Ыстық қанды ауысқан студентке не болды?
Dialogue: 0,0:15:23.27,0:15:25.21,Default,,0,0,0,,О, Года-кун ше?
Dialogue: 0,0:15:25.21,0:15:28.81,Default,,0,0,0,,Сіз маған кенет ұсыныс жасағаныңызды естідім.
Dialogue: 0,0:15:28.81,0:15:34.27,Default,,0,0,0,,О, білесің бе, мен сенің не ойлайтыныңды білмеймін.
Dialogue: 0,0:15:34.27,0:15:36.07,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:15:36.07,0:15:38.07,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:15:38.07,0:15:43.75,Default,,0,0,0,,Иә? Тоқта, мен саған тегін болса да қараудан шаршадым.
Dialogue: 0,0:15:43.75,0:15:49.75,Default,,0,0,0,,Қалжың, бірақ мұндай оғаш адамдармен ара-тұра араласу жақсы емес пе?
Dialogue: 0,0:15:49.75,0:15:52.75,Default,,0,0,0,,Мен бұл басқа біреудің мәселесі деп ойладым.
Dialogue: 0,0:15:52.75,0:15:57.75,Default,,0,0,0,,Бұл қажет емес шығар, бірақ Ақанның тәрелкесінде тым көп нәрсе бар.
Dialogue: 0,0:15:57.75,0:16:03.75,Default,,0,0,0,,Рахмет, Чизуру, бірақ менде бәрі жақсы. Ертең кездескенше.
Dialogue: 0,0:16:06.07,0:16:14.84,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:16:14.84,0:16:18.18,Default,,0,0,0,,Құрметті Акане-сан
Dialogue: 0,0:16:18.18,0:16:21.54,Default,,0,0,0,,Бүгін жақсы көңіл-күймен үйге қайтайық.
Dialogue: 0,0:16:21.54,0:16:25.30,Default,,0,0,0,,Мен Хакушу фестивалінің атқарушы комитетіне қосылғалы жатырмын.
Dialogue: 0,0:16:25.30,0:16:27.88,Default,,0,0,0,,Хакушу фестивалі дегеніміз не?
Dialogue: 0,0:16:27.88,0:16:32.22,Default,,0,0,0,,Мен бос емеспін, себебі мен мектептегі фестиваль комитетіндемін.
Dialogue: 0,0:16:32.22,0:16:33.08,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:16:33.08,0:16:36.76,Default,,0,0,0,,Олай болса мен де сені ертіп барамын.
Dialogue: 0,0:16:36.76,0:16:39.44,Default,,0,0,0,,Ха, Года, сен комитет мүшесі емессің, солай ма?
Dialogue: 0,0:16:39.44,0:16:42.30,Default,,0,0,0,,Мен Акане-санға көмектескім келеді.
Dialogue: 0,0:16:42.30,0:16:43.68,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:16:43.68,0:16:46.10,Default,,0,0,0,,Ұстаудың қажеті жоқ.
Dialogue: 0,0:16:46.10,0:16:50.04,Default,,0,0,0,,Сүйген адамың үшін қолыңнан келгеннің барлығын жасау табиғи нәрсе.
Dialogue: 0,0:16:50.04,0:16:51.30,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:51.30,0:16:53.40,Default,,0,0,0,,Акане-сан
Dialogue: 0,0:16:53.40,0:16:55.64,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:16:55.64,0:17:01.06,Default,,0,0,0,,Акане-сан
Dialogue: 0,0:17:01.06,0:17:03.28,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:17:03.28,0:17:07.00,Default,,0,0,0,,Неліктен? Неге мен атқару комитетінде бола алмаймын?
Dialogue: 0,0:17:07.30,0:17:10.14,Default,,0,0,0,,Жаңа ғана ауыстырсаңыз, не істей аласыз?
Dialogue: 0,0:17:10.14,0:17:12.38,Default,,0,0,0,,Мотивация болғанша ешкімге ұтыла алмайсың
Dialogue: 0,0:17:12.38,0:17:13.36,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:17:13.36,0:17:13.66,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:17:13.66,0:17:15.72,Default,,0,0,0,,Мені Акане-сан сияқты атқару комитетінің мүшесі ет
Dialogue: 0,0:17:15.72,0:17:17.08,Default,,0,0,0,,Егер ол жұмыс істемесе, ол жұмыс істемейді
Dialogue: 0,0:17:17.08,0:17:18.34,Default,,0,0,0,,Неліктен
Dialogue: 0,0:17:18.34,0:17:21.76,Default,,0,0,0,,Өйткені сіз ешқашан жеңе алмайсыз.
Dialogue: 0,0:17:21.76,0:17:24.74,Default,,0,0,0,,Сіз ешқашан жеңе алмайсыз
Dialogue: 0,0:17:24.74,0:17:28.54,Default,,0,0,0,,Жеңіске жетпейді, жеңе алмайды, жеңе алмайды
Dialogue: 0,0:17:28.54,0:17:31.66,Default,,0,0,0,,Олай болса, солай
Dialogue: 0,0:17:32.50,0:17:37.86,Default,,0,0,0,,Қорқынышты Хакурю Хийраги
Dialogue: 0,0:17:37.86,0:17:41.90,Default,,0,0,0,,Атқару комитетінде қандай шайқас жүріп жатыр?
Dialogue: 0,0:17:41.90,0:17:43.48,Default,,0,0,0,,Жоқ, бұған дейін
Dialogue: 0,0:17:43.48,0:17:43.64,Default,,0,0,0,,Мен Акане-санға көмектескім келеді.
Dialogue: 0,0:17:43.64,0:17:45.92,Default,,0,0,0,,Акане-сан сонда төбелесіп жатыр ма?
Dialogue: 0,0:17:45.92,0:17:47.64,Default,,0,0,0,,Ақан жалғыз
Dialogue: 0,0:17:47.64,0:17:49.66,Default,,0,0,0,,Жалғыз
Dialogue: 0,0:17:49.66,0:17:50.92,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:50.92,0:17:53.72,Default,,0,0,0,,Оппозициялық партиялар Хакушу фестиваліне жиналады
Dialogue: 0,0:17:54.13,0:17:57.17,Default,,0,0,0,,Акане-сан мектепті сол адамдардан қорғау үшін күресіп жатыр ма?
Dialogue: 0,0:17:57.17,0:18:01.01,Default,,0,0,0,,Мен мұнда жеңілсем, сыныптағылардың бәрі жеңіледі!
Dialogue: 0,0:18:01.01,0:18:03.01,Default,,0,0,0,,Мен кері шегіне алмаймын!
Dialogue: 0,0:18:03.01,0:18:04.51,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:18:04.51,0:18:08.31,Default,,0,0,0,,Сүйікті Ақанені мұндай майданда жалғыз қалдыра алмаймын!
Dialogue: 0,0:18:08.31,0:18:12.89,Default,,0,0,0,,Адам жеңе алмайтынын білсе де, күресуге тура келетін кездер болады!
Dialogue: 0,0:18:12.89,0:18:15.31,Default,,0,0,0,,Қазір шыдай алмайтын қандай адам?
Dialogue: 0,0:18:15.31,0:18:17.31,Default,,0,0,0,,Дұрыс! Ұрыс!
Dialogue: 0,0:18:17.31,0:18:19.61,Default,,0,0,0,,Махаббат үшін күресетін жауынгер боламын!
Dialogue: 0,0:18:19.61,0:18:21.61,Default,,0,0,0,,Мені күт, Акане-сан!
Dialogue: 0,0:18:24.13,0:18:27.13,Default,,0,0,0,,Эй, бәрі осында ма?
Dialogue: 0,0:18:27.13,0:18:30.13,Default,,0,0,0,,Олай болса, комитетті бастайық!
Dialogue: 0,0:18:30.13,0:18:31.13,Default,,0,0,0,,Маримо?
Dialogue: 0,0:18:31.13,0:18:34.13,Default,,0,0,0,,Жалғастыру атқару комитетінің міндеті емес пе?
Dialogue: 0,0:18:34.13,0:18:38.13,Default,,0,0,0,,Оқушыларыңыздың шынайы мүмкіндіктерін елемеңіз!
Dialogue: 0,0:18:38.13,0:18:42.13,Default,,0,0,0,,Катсуки мырза, мені атыммен атамайсыз ба?
Dialogue: 0,0:18:42.13,0:18:45.13,Default,,0,0,0,,Ой, кешіріңіз, Цзингуджи мырза.
Dialogue: 0,0:18:47.13,0:18:49.13,Default,,0,0,0,,Ол мұны қайтадан істеп жатыр...
Dialogue: 0,0:18:49.13,0:18:51.13,Default,,0,0,0,,Екеуің неге сонша жарысасыңдар?
Dialogue: 0,0:18:51.13,0:18:53.13,Default,,0,0,0,,Маримо-чан, бәрібір ұтыласың...
Dialogue: 0,0:18:53.13,0:18:54.13,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:18:54.13,0:18:55.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:56.13,0:19:00.13,Default,,0,0,0,,Олай болса, Атқару комитетінің төрағасы, өтінемін.
Dialogue: 0,0:19:00.13,0:19:01.13,Default,,0,0,0,,Иә
Dialogue: 0,0:19:02.13,0:19:04.13,Default,,0,0,0,,Мен Чизуру Сакакимін, 3 В сыныбынан.
Dialogue: 0,0:19:04.13,0:19:09.13,Default,,0,0,0,,Біріншіден, мен биылғы Хакушю фестивалінің тақырыбын талқылағым келеді.
Dialogue: 0,0:19:09.13,0:19:11.13,Default,,0,0,0,,Былтырғыдай болуы керек деп ойлаймын.
Dialogue: 0,0:19:11.13,0:19:12.13,Default,,0,0,0,,Келісемін!
Dialogue: 0,0:19:12.13,0:19:15.13,Default,,0,0,0,,Өйткені, бұл 74 жылдық дәстүр.
Dialogue: 0,0:19:15.13,0:19:18.13,Default,,0,0,0,,Мм... басқа пікірлер бар ма?
Dialogue: 0,0:19:21.13,0:19:23.13,Default,,0,0,0,,Бірдей болса да, бәрібір
Dialogue: 0,0:19:23.13,0:19:26.13,Default,,0,0,0,,Бұл бәрібір мектеп фестивалі.
Dialogue: 0,0:19:26.13,0:19:30.13,Default,,0,0,0,,Сүйген адамың үшін қолыңнан келгеннің бәрін жасау табиғи нәрсе!
Dialogue: 0,0:19:30.13,0:19:33.13,Default,,0,0,0,,...
Dialogue: 0,0:19:33.13,0:19:34.13,Default,,0,0,0,,Иә
Dialogue: 0,0:19:34.13,0:19:34.32,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:19:34.32,0:19:36.78,Default,,0,0,0,,Менің бір ұсынысым бар
Dialogue: 0,0:19:36.78,0:19:39.22,Default,,0,0,0,,Гоуда-кун
Dialogue: 0,0:19:39.22,0:19:41.14,Default,,0,0,0,,Бұл қауесет
Dialogue: 0,0:19:41.14,0:19:43.68,Default,,0,0,0,,Акане-сан, мен саған көмектесуге келдім.
Dialogue: 0,0:19:43.68,0:19:45.24,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:19:45.24,0:19:47.26,Default,,0,0,0,,Мен осында болсам, бәрі жақсы
Dialogue: 0,0:19:47.26,0:19:49.50,Default,,0,0,0,,Мика
Dialogue: 0,0:19:49.50,0:19:53.94,Default,,0,0,0,,Сіз атқару комитетінің мүшесі емессіз, сондықтан мені мазаламаңыз.
Dialogue: 0,0:19:53.94,0:19:55.92,Default,,0,0,0,,Белгілі бір себептермен комиссия мүшесі бола алмадым.
Dialogue: 0,0:19:55.92,0:19:58.28,Default,,0,0,0,,Мен де осы мектептің оқушыларының бірімін.
Dialogue: 0,0:19:58.28,0:20:02.22,Default,,0,0,0,,Мектеп фестивалінің сәтті өтуіне мұндағылардың барлығына бірдей тілектеспін.
Dialogue: 0,0:20:02.22,0:20:04.96,Default,,0,0,0,,Түсінгеніңді қалаймын, көзілдірікті қыз
Dialogue: 0,0:20:04.96,0:20:07.88,Default,,0,0,0,,Біраз
Dialogue: 0,0:20:07.88,0:20:11.34,Default,,0,0,0,,Бұл қыз Кацуки-сенсэйдің сыныбының алдыңғы оқушысы болды, солай ма?
Dialogue: 0,0:20:11.34,0:20:12.42,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:20:12.42,0:20:13.38,Default,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:20:13.38,0:20:17.14,Default,,0,0,0,,Мен мұның барлығын сіз жасағаныңызға сене алмаймын.\NГуда
Dialogue: 0,0:20:17.14,0:20:19.16,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:20:19.90,0:20:20.58,Default,,0,0,0,,...
Dialogue: 0,0:20:20.58,0:20:24.44,Default,,0,0,0,,Менің ойымша, олар кемеге күшпен мінген кезде бірдеңе болған болуы керек.
Dialogue: 0,0:20:24.44,0:20:26.74,Default,,0,0,0,,Катсуки мырзаны арандатпаңыз.
Dialogue: 0,0:20:26.74,0:20:28.02,Default,,0,0,0,,Dr.
Dialogue: 0,0:20:28.02,0:20:31.20,Default,,0,0,0,,Мұның бәрі осы Гоуда Джордж шайқасы туралы.
Dialogue: 0,0:20:31.20,0:20:32.20,Default,,0,0,0,,Бұл жай ғана сынап көру үшін болды.
Dialogue: 0,0:20:32.22,0:20:33.22,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:20:33.22,0:20:34.66,Default,,0,0,0,,Бұл шынымен араласуды тым әріге асыру болды
Dialogue: 0,0:20:34.66,0:20:37.16,Default,,0,0,0,,Ал, мен сенен сұрайын.
Dialogue: 0,0:20:37.16,0:20:40.36,Default,,0,0,0,,Сіздің ұсынысыңыз қандай?
Dialogue: 0,0:20:40.36,0:20:41.98,Default,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:20:41.98,0:20:45.84,Default,,0,0,0,,Болашақты қолға алу үшін құрылымдық реформалар туралы айтып берейін.
Dialogue: 0,0:20:45.84,0:20:48.26,Default,,0,0,0,,Қазірдің өзінде реформаланды ма?
Dialogue: 0,0:20:48.26,0:20:51.18,Default,,0,0,0,,Біздің құрылымдық реформамыз нақты қандай?
Dialogue: 0,0:20:51.18,0:20:54.74,Default,,0,0,0,,Оқу фестивалінің орнына жаңа мәдени фестивальді атау туралы ұсыныс
Dialogue: 0,0:20:54.74,0:20:56.42,Default,,0,0,0,,Енді не істеуіміз керек
Dialogue: 0,0:20:56.42,0:20:58.84,Default,,0,0,0,,Әмбебап тақырыпты жақтамау
Dialogue: 0,0:20:58.84,0:21:01.92,Default,,0,0,0,,Бірінші қадам – үйлесімді рухани іргетас құру.
Dialogue: 0,0:21:01.92,0:21:02.92,Default,,0,0,0,,Бұл қажет
Dialogue: 0,0:21:02.92,0:21:04.20,Default,,0,0,0,,үшін келіседі
Dialogue: 0,0:21:04.20,0:21:06.34,Default,,0,0,0,,Әр адам мәйітті жақсы көретін адамның есімін алады.
Dialogue: 0,0:21:06.34,0:21:09.56,Default,,0,0,0,,Бұл мәдени мерекені мәңгілік ету керек.
Dialogue: 0,0:21:09.56,0:21:10.28,Default,,0,0,0,,О
Dialogue: 0,0:21:10.28,0:21:11.08,Default,,0,0,0,,О
Dialogue: 0,0:21:11.08,0:21:12.60,Default,,0,0,0,,Хун
Dialogue: 0,0:21:13.07,0:21:14.33,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:14.69,0:21:15.79,Default,,0,0,0,,Бірақ Гоуда
Dialogue: 0,0:21:15.79,0:21:18.79,Default,,0,0,0,,Осыншама көп айтсаң, тақ есім.
Dialogue: 0,0:21:18.79,0:21:22.79,Default,,0,0,0,,Мен Д сыныбында оқитын Сузумияны ұятқа қалдыруды шештім.
Dialogue: 0,0:21:22.79,0:21:24.79,Default,,0,0,0,,Дегенмен, сіз оны ұсынасыз.
Dialogue: 0,0:21:28.79,0:21:29.75,Default,,0,0,0,,Вакаме мырза
Dialogue: 0,0:21:29.75,0:21:33.25,Default,,0,0,0,,Бұл көздер алаңдаушылықты көрсетеді.
Dialogue: 0,0:21:33.25,0:21:34.61,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:21:34.61,0:21:36.85,Default,,0,0,0,,Менде жеңілмейтін күш бар
Dialogue: 0,0:21:36.85,0:21:39.57,Default,,0,0,0,,Жеңілмейтіндік
Dialogue: 0,0:21:39.57,0:21:41.85,Default,,0,0,0,,Қандай жағымды дыбыс.
Dialogue: 0,0:21:41.85,0:21:44.87,Default,,0,0,0,,Дәл қазір мені Ақане-санға деген махаббатым алаңдатады.
Dialogue: 0,0:21:44.87,0:21:47.31,Default,,0,0,0,,Бұл тамаша сөз емес пе?
Dialogue: 0,0:21:47.31,0:21:49.69,Default,,0,0,0,,Мен күле бастадым.
Dialogue: 0,0:21:49.69,0:21:51.21,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:21:51.21,0:21:53.39,Default,,0,0,0,,Сізге айтайын.
Dialogue: 0,0:21:53.39,0:21:55.27,Default,,0,0,0,,Миссия туралы мәлімдеме
Dialogue: 0,0:21:55.27,0:21:58.83,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:21:58.83,0:22:04.63,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:22:04.66,0:22:06.66,Default,,0,0,0,,Акане фестивалі
Dialogue: 0,0:22:06.66,0:22:07.66,Default,,0,0,0,,Акане фестивалі
Dialogue: 0,0:22:07.66,0:22:12.66,Default,,0,0,0,,Бұл тарихтағы ең ұлы әйел Ақанның тақырыбын ашты.
Dialogue: 0,0:22:12.66,0:22:15.66,Default,,0,0,0,,Акане-сан мен Акане-санға арналған мәдени фестиваль.
Dialogue: 0,0:22:15.66,0:22:18.66,Default,,0,0,0,,Енді сіз оны көре аласыз, солай ма?
Dialogue: 0,0:22:31.66,0:22:33.29,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:22:33.29,0:22:36.41,Default,,0,0,0,,Көктегі Құдай есігінде ойнағың келе ме?
Dialogue: 0,0:22:36.41,0:22:39.77,Default,,0,0,0,,Қалжыңдаудан қорықпа.
Dialogue: 0,0:22:39.77,0:22:41.44,Default,,0,0,0,,Акане фестивалі дегеніміз не?
Dialogue: 0,0:22:41.44,0:22:46.81,Default,,0,0,0,,Ақанең туралы ештеңе білмесем де
Dialogue: 0,0:22:46.81,0:22:48.39,Default,,0,0,0,,Эй!
Dialogue: 0,0:22:48.39,0:22:49.76,Default,,0,0,0,,Өлген
Dialogue: 0,0:22:49.76,0:22:55.91,Default,,0,0,0,,Сакаки мырзаның сөзін аяқтауға рұқсат етсем.
Dialogue: 0,0:22:55.91,0:22:58.77,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:22:58.77,0:23:01.18,Default,,0,0,0,,Жұмақ дәл алдымда
Dialogue: 0,0:23:03.29,0:23:05.68,Default,,0,0,0,,О
Dialogue: 0,0:23:06.32,0:23:07.96,Default,,0,0,0,,Акане-сан!
Dialogue: 0,0:23:07.96,0:23:08.80,Default,,0,0,0,,Па…
Dialogue: 0,0:23:08.80,0:23:09.78,Default,,0,0,0,,Ум...
Dialogue: 0,0:23:10.80,0:23:12.30,Default,,0,0,0,,Ер адамның аты – Ллойд Форджер
Dialogue: 0,0:23:12.30,0:23:13.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:13.96,0:23:18.26,Default,,0,0,0,,Ең нашар…ең нашар…ең нашар!
Dialogue: 0,0:23:20.76,0:23:25.34,Default,,0,0,0,,Ah… aant!
Dialogue: 0,0:23:25.34,0:23:28.06,Default,,0,0,0,,Мен...Мен...
Dialogue: 0,0:23:30.92,0:23:31.42,Default,,0,0,0,,Идиот!
Dialogue: 0,0:23:55.34,0:24:03.74,Default,,0,0,0,,BGM
Dialogue: 0,0:24:03.74,0:24:08.06,Default,,0,0,0,,Ағаштарды сүзіп өткен күн сәулесі толып жатыр
Dialogue: 0,0:24:08.06,0:24:11.86,Default,,0,0,0,,Еңіспен жүгіру
Dialogue: 0,0:24:11.86,0:24:13.32,Default,,0,0,0,,BGM
Dialogue: 0,0:24:13.32,0:24:17.30,Default,,0,0,0,,Біркелкі юбка
Dialogue: 0,0:24:17.30,0:24:20.80,Default,,0,0,0,,Ол тербелсін
Dialogue: 0,0:24:20.80,0:24:22.70,Default,,0,0,0,,BGM
Dialogue: 0,0:24:22.70,0:24:25.20,Default,,0,0,0,,Өзгеретін заттар
Dialogue: 0,0:24:25.20,0:24:25.32,Default,,0,0,0,,BGM
Dialogue: 0,0:24:25.32,0:24:25.34,Default,,0,0,0,,BGM
Dialogue: 0,0:24:25.34,0:24:29.76,Default,,0,0,0,,Оны айтуға қорықтым.
Dialogue: 0,0:24:29.76,0:24:33.68,Default,,0,0,0,,Бірақ бәрі осылай қалса
Dialogue: 0,0:24:33.68,0:24:36.10,Default,,0,0,0,,Жоқ
Dialogue: 0,0:24:36.10,0:24:39.34,Default,,0,0,0,,Мен байқадым
Dialogue: 0,0:24:41.16,0:24:41.36,Default,,0,0,0,,BGM
Dialogue: 0,0:24:41.36,0:24:47.58,Default,,0,0,0,,Қайтадан бастайық
Dialogue: 0,0:24:47.58,0:24:50.36,Default,,0,0,0,,Жаңа мен
Dialogue: 0,0:24:50.36,0:24:52.82,Default,,0,0,0,,Жүр, тауып алайық
Dialogue: 0,0:24:52.82,0:24:55.22,Default,,0,0,0,,Сіз күліп тұрсыз.
Dialogue: 0,0:24:55.22,0:24:55.24,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:24:55.24,0:24:55.30,Default,,0,0,0,,Жақсы
Dialogue: 0,0:24:55.30,0:24:55.32,Default,,0,0,0,,Сізге жақсы cocaine.com. Иә.
Dialogue: 0,0:24:55.32,0:24:59.82,Default,,0,0,0,,Мен білмей тұрып, сен маған бердің.
Dialogue: 0,0:24:59.82,0:25:05.82,Default,,0,0,0,,Қуатыңыз үшін рахмет
Dialogue: 0,0:25:25.32,0:25:26.84,Default,,0,0,0,,Қайталауды сұрау
Dialogue: 0,0:25:26.84,0:25:29.58,Default,,0,0,0,,В класы Чизуру сыныбы, солай ма?
Dialogue: 0,0:25:29.58,0:25:32.00,Default,,0,0,0,,Өйткені Чизуру В сыныбының төрағасы.
Dialogue: 0,0:25:32.00,0:25:34.52,Default,,0,0,0,,Бұрынғыларға қамқорлық жасамасқа амал жоқ.
Dialogue: 0,0:25:34.52,0:25:38.58,Default,,0,0,0,,Келесі Акане маньяктарын күтіңіз
Dialogue: 0,0:25:40.08,0:25:46.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
