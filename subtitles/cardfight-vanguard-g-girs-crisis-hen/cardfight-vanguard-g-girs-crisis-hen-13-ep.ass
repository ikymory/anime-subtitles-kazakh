Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.78,0:01:06.71,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:01:06.71,0:01:09.96,Default,,0,0,0,,Бұл мен үшін бәрі!
Dialogue: 0,0:01:09.96,0:01:13.76,Default,,0,0,0,,Авангардқа шабуыл!!
Dialogue: 0,0:01:16.07,0:01:18.07,Default,,0,0,0,,ﾌｧｲﾅﾙﾀｰﾝ！
Dialogue: 0,0:01:21.64,0:01:25.74,Default,,0,0,0,,Бұл Кай Тошики ме...
Dialogue: 0,0:01:34.74,0:01:38.61,Default,,0,0,0,,Шион Киба Ол жақсы боксшы болуы мүмкін.
Dialogue: 0,0:01:38.61,0:01:40.56,Default,,0,0,0,,Жауапты сезіндіңіз бе?
Dialogue: 0,0:01:40.56,0:01:43.73,Default,,0,0,0,,Егер ол...
Dialogue: 0,0:01:43.73,0:01:45.93,Default,,0,0,0,,Жоқ, егер олар...
Dialogue: 0,0:01:45.93,0:01:50.73,Default,,0,0,0,,Бұл сіздің күткеніңізден де асып түсуі мүмкін.
Dialogue: 0,0:05:11.81,0:05:14.08,Default,,0,0,0,,сұрады Куроно
Dialogue: 0,0:05:14.08,0:05:16.08,Default,,0,0,0,,Шығарыңыз!
Dialogue: 0,0:05:18.10,0:05:20.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:20.75,0:05:22.75,Default,,0,0,0,,Әй, Куроно-сан!
Dialogue: 0,0:05:24.75,0:05:27.89,Default,,0,0,0,,Ламирабидің екі мүшесінің уақыты жақындап қалды.
Dialogue: 0,0:05:27.89,0:05:30.74,Default,,0,0,0,,Иә, бірақ қазір...
Dialogue: 0,0:05:30.74,0:05:33.08,Default,,0,0,0,,Бурбон вискісі—
Dialogue: 0,0:05:33.08,0:05:36.58,Default,,0,0,0,,Иә...｡ Мен бірден барамын.
Dialogue: 0,0:05:38.77,0:05:41.40,Default,,0,0,0,,Жарайсың ба, Куроно-сан және басқалары?
Dialogue: 0,0:05:41.40,0:05:43.74,Default,,0,0,0,,Хехе... Жарайды.
Dialogue: 0,0:05:43.74,0:05:48.11,Default,,0,0,0,,Бірақ егер Шион-сан шешім қабылдаса, ол бітер еді.
Dialogue: 0,0:05:48.11,0:05:50.41,Default,,0,0,0,,Бұл қатты ма~
Dialogue: 0,0:05:54.08,0:05:59.42,Default,,0,0,0,,《Егер мен жеңілсем, G Quest-ті бағындыру туралы арманым осымен аяқталады...
Dialogue: 0,0:05:59.42,0:06:05.06,Default,,0,0,0,,Токоха да, Шион да маған сеніп, аманат етті.
Dialogue: 0,0:06:05.06,0:06:09.28,Default,,0,0,0,,Мен жеңіле алмаймын! команда үшін
Dialogue: 0,0:06:09.28,0:06:11.58,Default,,0,0,0,,Өзім үшін де! 》
Dialogue: 0,0:06:20.29,0:06:22.76,Default,,0,0,0,,Сол бетті таққандықтан бәрін жеп қойды.
Dialogue: 0,0:06:22.76,0:06:24.73,Default,,0,0,0,,Тіпті Камуи-санды ➡ қатыстырыңыз
Dialogue: 0,0:06:24.73,0:06:28.65,Default,,0,0,0,,Осы G квестімен не істегіңіз келеді?
Dialogue: 0,0:06:28.65,0:06:32.24,Default,,0,0,0,,Осы жігіттің күшін пайдаланып, Клейден бірлік алыңыз➡
Dialogue: 0,0:06:32.24,0:06:35.06,Default,,0,0,0,,Біреу сені осы дүниеге шақырғысы келеді.
Dialogue: 0,0:06:35.06,0:06:37.96,Default,,0,0,0,,Мұның бұған қатысы бар ма?
Dialogue: 0,0:06:37.96,0:06:41.96,Default,,0,0,0,,Неліктен маған тәуелділік картасын бердіңіз?
Dialogue: 0,0:06:43.90,0:06:47.97,Default,,0,0,0,,Жекпе-жек адам туралы бәрін көрсетеді.
Dialogue: 0,0:06:47.97,0:06:52.57,Default,,0,0,0,,Сіз дәл қазір осы дүниеде болып жатқан барлық нәрсені білуге ​​қабілеттісіз бе?
Dialogue: 0,0:06:56.73,0:07:00.66,Default,,0,0,0,,Осы жекпе-жекте мұны өзіңіз дәлелдеңіз.
Dialogue: 0,0:07:00.66,0:07:02.93,Default,,0,0,0,,мүлде жойылды.
Dialogue: 0,0:07:02.93,0:07:05.03,Default,,0,0,0,,Өте жақсы, орындаймын!
Dialogue: 0,0:07:07.61,0:07:11.04,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｻﾞ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:07:11.04,0:07:13.04,Default,,0,0,0,,ｸﾛﾉ･ﾄﾞﾗﾝ！
Dialogue: 0,0:07:13.04,0:07:15.58,Default,,0,0,0,,ﾈｵﾝﾒｻｲｱ
Dialogue: 0,0:07:15.58,0:07:19.23,Default,,0,0,0,,ﾗｲﾄﾞ！ ﾀｲﾑﾌﾞﾚｲｸ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:07:19.23,0:07:22.65,Default,,0,0,0,,ﾗｲﾄﾞ ｱｽﾘｰﾌﾟ･ﾒｻｲｱ
Dialogue: 0,0:07:22.65,0:07:25.56,Default,,0,0,0,,ｺｰﾙ ｻｸﾘﾌｧｲｽ･ﾒｻｲｱ
Dialogue: 0,0:07:25.56,0:07:28.08,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:07:28.08,0:07:30.95,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:07:30.95,0:07:34.73,Default,,0,0,0,,Ұйқыдағы Мәсіхпен бірге Авангардқа шабуыл жасаңыз
Dialogue: 0,0:07:34.73,0:07:36.77,Default,,0,0,0,,ﾄﾞﾗｲﾌﾞﾁｪｯｸ
Dialogue: 0,0:07:36.77,0:07:39.14,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:07:39.14,0:07:41.24,Default,,0,0,0,,Барлық әсерлер ұйықтап жатыр.
Dialogue: 0,0:07:46.44,0:07:49.90,Default,,0,0,0,,Сен ғана емес, Ибуки де сенде рақым жоқ.
Dialogue: 0,0:07:49.90,0:07:52.73,Default,,0,0,0,,Әйтпесе мағынасыз ұрыс.
Dialogue: 0,0:07:52.73,0:07:54.75,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:07:54.75,0:07:57.61,Default,,0,0,0,,ﾗｲﾄﾞ！ ﾋｽﾄﾘｰﾒｰｶｰ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:07:57.61,0:07:59.96,Default,,0,0,0,,ｺｰﾙ！
Dialogue: 0,0:07:59.96,0:08:03.06,Default,,0,0,0,,History Maker көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:08:05.25,0:08:09.10,Default,,0,0,0,,Жоғары ағындағы Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:08:09.10,0:08:11.39,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:08:11.39,0:08:14.24,Default,,0,0,0,,ﾗｲﾄﾞ ｱﾛｰｻﾞﾙ･ﾒｻｲｱ
Dialogue: 0,0:08:14.24,0:08:16.77,Default,,0,0,0,,Құрбандық бетті жылжыту➡
Dialogue: 0,0:08:16.77,0:08:20.23,Default,,0,0,0,,Гравитациялық ұңғыма жүргізуші әйелді шақырыңыз
Dialogue: 0,0:08:20.23,0:08:25.12,Default,,0,0,0,,Неон Мессидің Аллозалмен бірге авангардының жарылыс шабуылы
Dialogue: 0,0:08:25.12,0:08:27.20,Default,,0,0,0,,ﾄﾞﾗｲﾌﾞﾁｪｯｸ
Dialogue: 0,0:08:27.20,0:08:29.20,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:08:32.41,0:08:36.41,Default,,0,0,0,,Ауырлық күші бар ұңғымамен жоғары ағынға шабуыл жасау
Dialogue: 0,0:08:42.00,0:08:44.29,Default,,0,0,0,,Зақым 4-1...
Dialogue: 0,0:08:44.29,0:08:46.39,Default,,0,0,0,,Өте керемет...
Dialogue: 0,0:08:46.39,0:08:49.41,Default,,0,0,0,,ﾗｲﾄﾞ！ ｸﾛﾉｼﾞｪｯﾄ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:08:49.41,0:08:51.43,Default,,0,0,0,,ｺｰﾙ！
Dialogue: 0,0:08:51.43,0:08:53.39,Default,,0,0,0,,Кеттік!!
Dialogue: 0,0:08:53.39,0:08:55.90,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ｡ ﾂｲﾝﾄﾞﾗｲﾌﾞ!!
Dialogue: 0,0:08:55.90,0:08:59.70,Default,,0,0,0,,Heal Trigger 1 залалы қалпына келтірілді!
Dialogue: 0,0:09:01.74,0:09:04.92,Default,,0,0,0,,Түтінге қарсы құралмен шабуыл!
Dialogue: 0,0:09:04.92,0:09:08.09,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:09:08.09,0:09:13.09,Default,,0,0,0,,《Шіркін... триггерді басқанмен, қуып жете алмадым》
Dialogue: 0,0:09:16.42,0:09:18.55,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:09:18.55,0:09:23.04,Default,,0,0,0,,Сенемін болашаққа, Қанатымды қағамын
Dialogue: 0,0:09:23.04,0:09:25.04,Default,,0,0,0,,ｵﾙﾀｰｴｺﾞ･ﾒｻｲｱ
Dialogue: 0,0:09:28.73,0:09:30.88,Default,,0,0,0,,Қозғалайық
Dialogue: 0,0:09:30.88,0:09:33.27,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:09:33.27,0:09:37.89,Default,,0,0,0,,Жаратылыс Айдаһар Амнести Мәсіх
Dialogue: 0,0:09:37.89,0:09:42.11,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ﾛｯｸ
Dialogue: 0,0:09:42.11,0:09:46.23,Default,,0,0,0,,Рақымшылық үшін қуат плюс 5000
Dialogue: 0,0:09:46.23,0:09:48.55,Default,,0,0,0,,Құрбандық Мәсіхтің дағдылары
Dialogue: 0,0:09:48.55,0:09:52.12,Default,,0,0,0,,Өзіңізді құлыптаңыз. Қарсы төлем
Dialogue: 0,0:09:52.12,0:09:54.74,Default,,0,0,0,,Рақымшылық үшін қуат плюс 3000
Dialogue: 0,0:09:54.74,0:09:57.29,Default,,0,0,0,,Қамаушы Мәсіхті шақыр
Dialogue: 0,0:09:57.29,0:10:01.31,Default,,0,0,0,,Пауэр Plus 2000 тоқтатушы шеберлігі
Dialogue: 0,0:10:01.31,0:10:03.73,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:10:03.73,0:10:06.25,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:10:06.25,0:10:08.92,Default,,0,0,0,,Қамаушы Мәсіхтің дағдылары
Dialogue: 0,0:10:08.92,0:10:14.22,Default,,0,0,0,,Өзіңізді құлыптаңыз және бір артқы қорғаушыны қарсыластың артқы қатарында бекітіңіз
Dialogue: 0,0:10:19.26,0:10:22.26,Default,,0,0,0,,Оған мүмкіндік берудің де қажеті жоқ сияқты.
Dialogue: 0,0:10:25.39,0:10:30.34,Default,,0,0,0,,Сізден... ештеңе өспейді ➡
Dialogue: 0,0:10:30.34,0:10:32.34,Default,,0,0,0,,Оны сезіну мүмкін емес
Dialogue: 0,0:10:34.38,0:10:37.60,Default,,0,0,0,,Амнистия арқылы Авангардқа шабуыл жасаңыз
Dialogue: 0,0:10:37.60,0:10:40.70,Default,,0,0,0,,Дағдыны белсендіру құлпын ашу
Dialogue: 0,0:10:43.74,0:10:47.14,Default,,0,0,0,,Рақымшылыққа арналған Пауэр Plus 9000
Dialogue: 0,0:10:47.14,0:10:49.89,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾌﾟﾗｽ１
Dialogue: 0,0:10:49.89,0:10:54.60,Default,,0,0,0,,Құлыптан босатылған блокқа 3000 қуат беретін дағды...
Dialogue: 0,0:10:54.60,0:10:57.72,Default,,0,0,0,,Сонымен қатар, егер 3 немесе одан көп болса, Critical Plus 1
Dialogue: 0,0:10:57.72,0:11:01.62,Default,,0,0,0,,Сонымен қатар, құлпы ашылған одақтастар күту күйінде.
Dialogue: 0,0:11:01.62,0:11:05.59,Default,,0,0,0,,ﾎﾜｲﾄﾗｲﾄﾆﾝｸﾞｱﾝﾃﾞｭﾚｲﾄ
Dialogue: 0,0:11:05.59,0:11:07.56,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:11:07.56,0:11:21.61,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:21.61,0:11:24.21,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:11:24.21,0:11:26.91,Default,,0,0,0,,ｹﾞｯﾄ ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:11:26.91,0:11:30.07,Default,,0,0,0,,Билік тұтқындаушы Мәсіхке беріледі
Dialogue: 0,0:11:30.07,0:11:32.22,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:11:32.22,0:11:41.73,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:41.73,0:11:46.72,Default,,0,0,0,,Өз болашағын елестете алмайтындар үшін➡
Dialogue: 0,0:11:46.72,0:11:50.65,Default,,0,0,0,,Менен асып түсетін нәрселер➡
Dialogue: 0,0:11:50.65,0:11:52.75,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:13:40.75,0:13:42.80,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:13:42.80,0:13:45.05,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:13:45.05,0:13:47.42,Default,,0,0,0,,Бұрылыс және аяқтау
Dialogue: 0,0:13:47.42,0:13:49.72,Default,,0,0,0,,(ысқырық)
Dialogue: 0,0:13:49.72,0:13:52.39,Default,,0,0,0,,Сіз мінсіз күзетпен аман қалдыңыз ба?
Dialogue: 0,0:13:52.39,0:13:55.91,Default,,0,0,0,,Бірақ артқы қорғаныс құлыпталған→
Dialogue: 0,0:13:55.91,0:13:58.07,Default,,0,0,0,,Келесі айналым мен қозғала алмаймын.
Dialogue: 0,0:13:58.07,0:14:02.79,Default,,0,0,0,,Куроно соңғы рет Триггердің көмегімен жеңіске жетті, бірақ...
Dialogue: 0,0:14:02.79,0:14:06.89,Default,,0,0,0,,Жел бағытының шамалы айырмашылығы осындай айырмашылықты тудыруы мүмкін.
Dialogue: 0,0:14:06.89,0:14:11.04,Default,,0,0,0,,《Қарғыс атсын, күшті ғой.
Dialogue: 0,0:14:11.04,0:14:13.08,Default,,0,0,0,,Ол айтқандай→
Dialogue: 0,0:14:13.08,0:14:17.40,Default,,0,0,0,,Менде әлі болашағымның бейнесі де жоқ.
Dialogue: 0,0:14:17.40,0:14:21.84,Default,,0,0,0,,Жекпе-жек адамның бәрін көрсетеді
Dialogue: 0,0:14:21.84,0:14:26.24,Default,,0,0,0,,Осы уақытқа дейін не істедің?
Dialogue: 0,0:14:26.24,0:14:31.25,Default,,0,0,0,,Ол мұрны ауыр бортқа келді. Бұл сама ма?
Dialogue: 0,0:14:31.25,0:14:34.40,Default,,0,0,0,,Мен оны жоққа шығара да алмаймын.
Dialogue: 0,0:14:34.40,0:14:37.29,Default,,0,0,0,,Мен оның сүйектері болады деп үміттендім➡
Dialogue: 0,0:14:37.29,0:14:40.61,Default,,0,0,0,,Ол бала ма?
Dialogue: 0,0:14:40.61,0:14:43.73,Default,,0,0,0,,Келісуге болмайды.
Dialogue: 0,0:14:43.73,0:14:46.25,Default,,0,0,0,,Енді босқа уақыт кетпейді.
Dialogue: 0,0:14:46.25,0:14:50.65,Default,,0,0,0,,Бұл басқа қатысушыларға кедергі келтіруі мүмкін
Dialogue: 0,0:14:50.65,0:14:52.59,Default,,0,0,0,,Тәуелді картаны артта қалдырыңыз.
Dialogue: 0,0:14:52.59,0:14:55.39,Default,,0,0,0,,Сен оған лайық емессің... Шу!
Dialogue: 0,0:14:57.52,0:14:59.52,Default,,0,0,0,,Oh, I made you angry.
Dialogue: 0,0:15:01.40,0:15:06.60,Default,,0,0,0,,Тыңдап тыңдасаң, саған не болды?
Dialogue: 0,0:15:06.60,0:15:10.07,Default,,0,0,0,,Бәріне сен кінәлі деп ойлаймын!
Dialogue: 0,0:15:10.07,0:15:12.59,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:15:12.59,0:15:16.58,Default,,0,0,0,,Кеңістік-уақыт айдаһары Хроноскомандалық айдаһар!
Dialogue: 0,0:15:16.58,0:15:21.23,Default,,0,0,0,,Қадаммен жүру дағдысы Палубаның түбіне дейін ауырлық күші!
Dialogue: 0,0:15:21.23,0:15:23.75,Default,,0,0,0,,Мені ескертусіз мәжбүрлеу➡
Dialogue: 0,0:15:23.75,0:15:25.89,Default,,0,0,0,,Оны асыға күтемін➡
Dialogue: 0,0:15:25.89,0:15:30.11,Default,,0,0,0,,Мен қалағандай болмай тұр, бұл жолы неге қайтармайсың?
Dialogue: 0,0:15:30.11,0:15:33.38,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,0:15:33.38,0:15:35.95,Default,,0,0,0,,Do you want me to do something?
Dialogue: 0,0:15:35.95,0:15:38.25,Default,,0,0,0,,Олай болса, дұрыстап түсіндіріңіз!
Dialogue: 0,0:15:40.30,0:15:45.26,Default,,0,0,0,,Қоңырау шалыңыз! Attack Vanguard with the Chronos command!
Dialogue: 0,0:15:45.26,0:15:47.26,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:15:47.26,0:15:50.06,Default,,0,0,0,,Heal Trigger 1 зақымдануды қалпына келтіру
Dialogue: 0,0:15:52.10,0:15:54.55,Default,,0,0,0,,Маған үндеместен картаны жіберіңіз➡
Dialogue: 0,0:15:54.55,0:15:59.30,Default,,0,0,0,,Тіпті квест алданып, алдымнан шықтың➡
Dialogue: 0,0:15:59.30,0:16:01.90,Default,,0,0,0,,Don't always say the important thing...
Dialogue: 0,0:16:04.42,0:16:07.22,Default,,0,0,0,,Үлкендер осылай істей ме?
Dialogue: 0,0:16:13.90,0:16:16.05,Default,,0,0,0,,You don't have any friends!
Dialogue: 0,0:16:16.05,0:16:19.47,Default,,0,0,0,,Мына аңдыушы бейбақ!
Dialogue: 0,0:16:19.47,0:16:22.74,Default,,0,0,0,,Дағдыны белсендіру Артқы қорғанысты палубаның төменгі жағына жылжытыңыз
Dialogue: 0,0:16:22.74,0:16:25.48,Default,,0,0,0,,ｱｯﾌﾟｽﾄﾘｰﾑ！
Dialogue: 0,0:16:25.48,0:16:27.48,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:16:29.43,0:16:31.43,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:16:34.29,0:16:37.42,Default,,0,0,0,,ｽﾀﾝﾄﾞ ｱﾝﾄﾞ ﾄﾞﾛｰ
Dialogue: 0,0:16:37.42,0:16:42.42,Default,,0,0,0,,Don't get carried away, you idiot!
Dialogue: 0,0:16:44.46,0:16:46.56,Default,,0,0,0,,Генерация аймағы шығарылды!
Dialogue: 0,0:16:48.72,0:16:53.79,Default,,0,0,0,,Хаосты кесіп, болашақты ақ қанатпен сыз!
Dialogue: 0,0:16:53.79,0:16:58.29,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:17:06.39,0:17:11.01,Default,,0,0,0,,Genesis Dragon Exelix Messiah
Dialogue: 0,0:17:11.01,0:17:15.56,Default,,0,0,0,,Қара металл Камелеон Нейтрон жұлдызының зеңбірекші ханымын атайды
Dialogue: 0,0:17:15.56,0:17:19.92,Default,,0,0,0,,Skill activation lock
Dialogue: 0,0:17:19.92,0:17:23.77,Default,,0,0,0,,Call Arrester Messiah. Шабуыл
Dialogue: 0,0:17:23.77,0:17:25.82,Default,,0,0,0,,Бұған жол берме!
Dialogue: 0,0:17:25.82,0:17:29.92,Default,,0,0,0,,Қиындығымды білмей... Құлып
Dialogue: 0,0:17:32.10,0:17:36.05,Default,,0,0,0,,Exelix көмегімен Авангардқа шабуыл жасаңыз
Dialogue: 0,0:17:36.05,0:17:39.44,Default,,0,0,0,,Құлыпты ашыңыз және оны қуатқа қосыңыз. Құлыпты ашу
Dialogue: 0,0:17:39.44,0:17:42.06,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ3000
Dialogue: 0,0:17:42.06,0:17:44.41,Default,,0,0,0,,Қарсыластың артқы сақшысының шегінуі
Dialogue: 0,0:17:44.41,0:17:47.43,Default,,0,0,0,,Құлыптан босатылған 3 немесе одан көп бірлік болса➡
Dialogue: 0,0:17:47.43,0:17:50.08,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾌﾟﾗｽ１
Dialogue: 0,0:17:50.08,0:17:53.68,Default,,0,0,0,,Сақтандырушы болу туралы айтатын нәрселер аз емес...
Dialogue: 0,0:17:55.75,0:17:58.87,Default,,0,0,0,,Уау, мен сені қатты ашуландырдым.
Dialogue: 0,0:17:58.87,0:18:01.27,Default,,0,0,0,,Осыны ғана айта аласыз.
Dialogue: 0,0:18:01.27,0:18:04.41,Default,,0,0,0,,Оны сындырыңыз!
Dialogue: 0,0:18:04.41,0:18:07.71,Default,,0,0,0,,Өте жақсы, көріңіз!
Dialogue: 0,0:18:07.71,0:18:10.42,Default,,0,0,0,,Жоқ, бұл балалардың төбелесі.
Dialogue: 0,0:18:10.42,0:18:12.57,Default,,0,0,0,,Ақымақ болған кезде не істейсің?
Dialogue: 0,0:18:12.57,0:18:16.11,Default,,0,0,0,,Бұл екі адам таңқаларлықтай ұқсас...
Dialogue: 0,0:18:16.11,0:18:20.88,Default,,0,0,0,,Бейбітшіліктен шыққан, жаратылыстың нұры!
Dialogue: 0,0:18:20.88,0:18:24.23,Default,,0,0,0,,Өзіңді барлық күнәлардан тазарт!
Dialogue: 0,0:18:24.23,0:18:27.58,Default,,0,0,0,,ｼﾞ･ｱﾎﾟｶﾘﾌﾟｽ！
Dialogue: 0,0:18:27.58,0:18:37.93,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:37.93,0:18:41.53,Default,,0,0,0,,Зақым 5... Оның үстіне тағы екі шабуыл болады!
Dialogue: 0,0:18:46.44,0:18:48.44,Default,,0,0,0,,Босат... техниканы іске қос!
Dialogue: 0,0:18:52.39,0:18:55.23,Default,,0,0,0,,Қандай қызық! Күзетші!
Dialogue: 0,0:18:55.23,0:19:00.57,Default,,0,0,0,,Кел, кел! Қарт адам!
Dialogue: 0,0:19:00.57,0:19:03.40,Default,,0,0,0,,Мен әлі...
Dialogue: 0,0:19:03.40,0:19:05.44,Default,,0,0,0,,Жиырма жаста!
Dialogue: 0,0:19:05.44,0:19:08.06,Default,,0,0,0,,Сол үшін сен қариясың.
Dialogue: 0,0:19:08.06,0:19:13.43,Default,,0,0,0,,Түсіндім... Орта мектеп оқушысының көзқарасы бойынша, біз қазірдің өзінде жақсы қарт адамдармыз ба?
Dialogue: 0,0:19:13.43,0:19:15.40,Default,,0,0,0,,Аузыңды жап, ақымақ!
Dialogue: 0,0:19:15.40,0:19:17.45,Default,,0,0,0,,Сіз де тынышсыз!
Dialogue: 0,0:19:17.45,0:19:21.22,Default,,0,0,0,,Шулы!
Dialogue: 0,0:19:21.22,0:19:24.24,Default,,0,0,0,,Сізде қорғайтын карталар жоқ па?
Dialogue: 0,0:19:24.24,0:19:28.68,Default,,0,0,0,,6-тармақ Мен бұл жерден сауықтыруым керек. Бұл соңы.
Dialogue: 0,0:19:28.68,0:19:30.68,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ！
Dialogue: 0,0:19:38.74,0:19:41.11,Default,,0,0,0,,Өйткені, бұл ➡
Dialogue: 0,0:19:41.11,0:19:43.41,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:19:51.85,0:19:53.85,Default,,0,0,0,,ﾋｰﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:19:57.89,0:20:00.46,Default,,0,0,0,,Мен де...
Dialogue: 0,0:20:00.46,0:20:04.76,Default,,0,0,0,,Мен осы уақытқа дейін ештеңе істемеген сияқтымын.
Dialogue: 0,0:20:04.76,0:20:09.89,Default,,0,0,0,,Ғажайып жауынгерлермен күресіп, достарыңыздың арқасын бақылаңыз➡
Dialogue: 0,0:20:09.89,0:20:13.47,Default,,0,0,0,,Мен мұнда осы жігіттермен келдім!
Dialogue: 0,0:20:13.47,0:20:16.27,Default,,0,0,0,,Барлық G Quest жекпе-жектері!
Dialogue: 0,0:20:18.56,0:20:23.00,Default,,0,0,0,,Оған өз күшімізді көрсетейік!
Dialogue: 0,0:20:23.00,0:20:27.39,Default,,0,0,0,,ｽﾀﾝﾄﾞ ｱﾝﾄﾞ ﾄﾞﾛｰ！
Dialogue: 0,0:20:27.39,0:20:30.07,Default,,0,0,0,,Генерация аймағы шығарылды!
Dialogue: 0,0:20:30.07,0:20:32.13,Default,,0,0,0,,Мен оны тарттым!
Dialogue: 0,0:20:32.13,0:20:34.13,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:20:39.55,0:20:44.91,Default,,0,0,0,,Уақыт-кеңістік айдаһар хроносмандының революциясы!
Dialogue: 0,0:20:44.91,0:20:47.57,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝﾌﾞﾚｲｸ！
Dialogue: 0,0:20:47.57,0:20:50.61,Default,,0,0,0,,Барлық артқы қорғаушыларды палубаның түбіне жылжытыңыз!
Dialogue: 0,0:20:50.61,0:20:54.23,Default,,0,0,0,,Бәрін жоққа айналдыр, бастамасын жарияла!
Dialogue: 0,0:20:54.23,0:20:58.64,Default,,0,0,0,,Сіз шабуыл тигізбесе де, Артқы күзетті жоя аласыз ба?
Dialogue: 0,0:20:58.64,0:21:01.59,Default,,0,0,0,,Бұл хроноскомандтың эволюциясы
Dialogue: 0,0:21:01.59,0:21:04.74,Default,,0,0,0,,Мен саған көрсетемін! Мен қазір!
Dialogue: 0,0:21:04.74,0:21:06.79,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,0:21:06.79,0:21:08.79,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:21:10.73,0:21:12.97,Default,,0,0,0,,Міне! Екі есе сын!
Dialogue: 0,0:21:12.97,0:21:15.27,Default,,0,0,0,,Барлық әсерлер қайта қарау болып табылады!
Dialogue: 0,0:21:19.39,0:21:23.76,Default,,0,0,0,,Шу? не? бұзу? Осындай кездерде
Dialogue: 0,0:21:23.76,0:21:27.40,Default,,0,0,0,,Ей, әлі ерте емес пе?
Dialogue: 0,0:21:27.40,0:21:32.30,Default,,0,0,0,,Өтіңіз! Кәне! Болашаққа шын ниетпен қарайсың!
Dialogue: 0,0:21:32.30,0:21:36.07,Default,,0,0,0,,Сублимация жарылысы!
Dialogue: 0,0:21:36.07,0:21:46.27,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:46.27,0:21:49.77,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:22:01.77,0:22:03.77,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:22:06.30,0:22:08.30,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:46.74,0:22:48.75,Default,,0,0,0,,Маған оны көрсетті.
Dialogue: 0,0:22:48.75,0:22:50.76,Default,,0,0,0,,≪О!
Dialogue: 0,0:22:50.76,0:22:52.77,Default,,0,0,0,,[Майк] Жеңімпаз Синдо Куроно!
Dialogue: 0,0:22:52.77,0:22:54.77,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:22:57.09,0:22:59.06,Default,,0,0,0,,Бұл қызықты болды.
Dialogue: 0,0:22:59.06,0:23:02.81,Default,,0,0,0,,Ол көңілді болып көрінді, бұл Ибуки үшін әдеттен тыс.
Dialogue: 0,0:23:02.81,0:23:05.11,Default,,0,0,0,,Бұл нағыз бастама ма?
Dialogue: 0,0:23:09.10,0:23:13.40,Default,,0,0,0,,《Ойлап қарасам, бұл бұрын болған》
Dialogue: 0,0:23:20.76,0:23:23.43,Default,,0,0,0,,Жоқ, бұл өте керемет.
Dialogue: 0,0:23:23.43,0:23:26.73,Default,,0,0,0,,Бұл біздің филиалдың G Quest бағдарламасындағы бірінші үлкен жетістік.
Dialogue: 0,0:23:28.84,0:23:32.74,Default,,0,0,0,,Әй, балалар, егер келесі филиалда жеңсек➡
Dialogue: 0,0:23:32.74,0:23:36.78,Default,,0,0,0,,50 маркамен сіз ұрпақ шебері бола аласыз.
Dialogue: 0,0:23:36.78,0:23:38.78,Default,,0,0,0,,(қолдау)
Dialogue: 0,0:23:49.06,0:23:52.11,Default,,0,0,0,,Баға да, қуат та жазылмайды.
Dialogue: 0,0:23:52.11,0:23:54.06,Default,,0,0,0,,Оны палубаға қоюға болмайды ма?
Dialogue: 0,0:23:54.06,0:23:56.73,Default,,0,0,0,,Бір күні мен де оны пайдалана аламын ба деп ойлаймын.
Dialogue: 0,0:23:56.73,0:23:59.77,Default,,0,0,0,,Сіз айтқан сөздердің көпшілігі дұрыс.
Dialogue: 0,0:23:59.77,0:24:01.74,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:24:01.74,0:24:04.77,Default,,0,0,0,,Миджин Роуз Оның мақсаты➡
Dialogue: 0,0:24:04.77,0:24:07.07,Default,,0,0,0,,Клей планетасынан бірлік шақырыңыз➡
Dialogue: 0,0:24:07.07,0:24:09.87,Default,,0,0,0,,Оны өз амбицияларыңыздың құралына айналдырыңыз.
Dialogue: 0,0:24:11.98,0:24:14.73,Default,,0,0,0,,Шақырылған бірлік өз еркімен алынады➡
Dialogue: 0,0:24:14.73,0:24:17.40,Default,,0,0,0,,Толығымен оның қуыршағы болыңыз.
Dialogue: 0,0:24:17.40,0:24:21.81,Default,,0,0,0,,Егер бұл күш әлемге жіберілсе, бұл қорқынышты болар еді.
Dialogue: 0,0:24:21.81,0:24:26.06,Default,,0,0,0,,Саз бар. Бірліктер де бар.
Dialogue: 0,0:24:26.06,0:24:28.96,Default,,0,0,0,,Мен мұны осы уақытқа дейін талай рет сезіндім.
Dialogue: 0,0:24:28.96,0:24:30.98,Default,,0,0,0,,Бүгін де...
Dialogue: 0,0:24:30.98,0:24:34.40,Default,,0,0,0,,Авангард менің әлемімді кеңейтті және өте маңызды.
Dialogue: 0,0:24:34.40,0:24:36.42,Default,,0,0,0,,Мен мұны кешіре алмаймын.
Dialogue: 0,0:24:36.42,0:24:40.39,Default,,0,0,0,,Жағымсыз жоспарды жүзеге асыру немесе жою➡
Dialogue: 0,0:24:40.39,0:24:43.11,Default,,0,0,0,,Бұл жауынгерлер жасайтын имидждік күш.
Dialogue: 0,0:24:43.11,0:24:47.08,Default,,0,0,0,,Сондықтан мен достарымды жинап, G жоспарын іске қостым.
Dialogue: 0,0:24:47.08,0:24:51.38,Default,,0,0,0,,Осы G Quest арқылы оның амбицияларын тоқтату.
Dialogue: 0,0:24:51.38,0:24:55.44,Default,,0,0,0,,G жоспары? Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:24:55.44,0:24:57.44,Default,,0,0,0,,Қазір бұл туралы айтуға болмайды
Dialogue: 0,0:24:59.39,0:25:02.76,Default,,0,0,0,,Сендер әлі баласыңдар. Ал сен әлсізсің.
Dialogue: 0,0:25:02.76,0:25:05.10,Default,,0,0,0,,Олай болса, тек күшейу керек, солай ма?
Dialogue: 0,0:25:05.10,0:25:08.75,Default,,0,0,0,,Тәуелді карта бастапқыда Clay құрылғысы болды➡
Dialogue: 0,0:25:08.75,0:25:12.06,Default,,0,0,0,,Бұл дүниеде бар жақсы нәрсе➡
Dialogue: 0,0:25:12.06,0:25:15.07,Default,,0,0,0,,Бұл сіздің Fighter-мен байланысыңыздың дәлелі.
Dialogue: 0,0:25:15.07,0:25:17.09,Default,,0,0,0,,Оның орнына Миоджин➡
Dialogue: 0,0:25:17.09,0:25:19.73,Default,,0,0,0,,Қандай да бір мәжбүрлеу әдісі қолданылып жатқан сияқты.
Dialogue: 0,0:25:19.73,0:25:22.77,Default,,0,0,0,,бізде бар нәрсе
Dialogue: 0,0:25:22.77,0:25:26.40,Default,,0,0,0,,Оны толығымен оятуға тырысыңыз. Болды➡
Dialogue: 0,0:25:26.40,0:25:28.72,Default,,0,0,0,,Оны тоқтататын адам болыңыз
Dialogue: 0,0:25:28.72,0:25:31.41,Default,,0,0,0,,Өсе бер, ақымақ
Dialogue: 0,0:25:31.41,0:25:34.43,Default,,0,0,0,,Сіз де, қария.
Dialogue: 0,0:25:34.43,0:25:36.43,Default,,0,0,0,,Әй
Dialogue: 0,0:25:38.45,0:25:40.73,Default,,0,0,0,,Күте тұрыңыз! Мұны маған неге бердіңіз?
Dialogue: 0,0:25:40.73,0:25:43.75,Default,,0,0,0,,Бұл сіздің әкеңіз еді➡
Dialogue: 0,0:25:43.75,0:25:46.12,Default,,0,0,0,,Себебі мен оны саған қалдырдым.
Dialogue: 0,0:25:46.12,0:25:48.19,Default,,0,0,0,,Менің әкем?
Dialogue: 0,0:25:48.19,0:25:53.79,Default,,0,0,0,,Сол өсиетті орындауға күшің жете ме?
Dialogue: 0,0:27:54.40,0:27:56.40,Default,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:27:58.84,0:28:01.84,Default,,0,0,0,,Менің тілегімді орындаңызшы
Dialogue: 0,0:30:35.76,0:30:39.77,Default,,0,0,0,,Жаңа жыл құтты болсын!
Dialogue: 0,0:30:39.77,0:30:41.88,Default,,0,0,0,,Хаха, бәрі дайын.
Dialogue: 0,0:30:41.88,0:30:43.90,Default,,0,0,0,,Бұл уақыт ерекше, солай емес пе? Бұл жолы →
Dialogue: 0,0:30:43.90,0:30:45.89,Default,,0,0,0,,Біздің бағдарламаға осы уақытқа дейін келген жас әзілкештер →
Dialogue: 0,0:30:45.89,0:30:48.81,Default,,0,0,0,,Мен сізге бірден 12 материалды көрсетемін.
Dialogue: 0,0:30:48.81,0:30:50.93,Default,,0,0,0,,Негізі осы уақытқа дейін жазып отырып қалжыңдап жүрдім →
Dialogue: 0,0:30:50.93,0:30:52.96,Default,,0,0,0,,Маған жарылыс жасауды сұрады, солай ма?
Dialogue: 0,0:30:52.96,0:30:55.26,Default,,0,0,0,,Керемет емес пе? Жаңа жыл сияқты.
Dialogue: 0,0:30:56.76,0:31:02.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory