Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:05.84,0:01:08.23,Default,,0,0,0,,Сізге қандай карта шабуыл жасағанын қалайсыз?
Dialogue: 0,0:01:08.23,0:01:12.68,Default,,0,0,0,,Йо... Түнгі тұманның вампир ханшайымы түнгі раушан, өтінемін.
Dialogue: 0,0:01:12.68,0:01:15.57,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:01:15.57,0:01:20.17,Default,,0,0,0,,Сізге түнгі тұман вампир ханшайымы Nightrose-мен шабуыл жасаңыз!
Dialogue: 0,0:01:20.17,0:01:23.27,Default,,0,0,0,,Аа, ең жақсы
Dialogue: 0,0:01:27.55,0:01:30.48,Default,,0,0,0,,Қойылымның аяқталғанын хабарлайтын Мефистті пайдаланыңыз.
Dialogue: 0,0:01:30.48,0:01:32.48,Default,,0,0,0,,Иә
Dialogue: 0,0:01:32.48,0:01:35.35,Default,,0,0,0,,Ақыр заманның хабаршысы Мефисто...
Dialogue: 0,0:01:35.35,0:01:37.34,Default,,0,0,0,,Мен кептеліп қалдым
Dialogue: 0,0:01:37.34,0:01:40.27,Default,,0,0,0,,Сізге шабуыл
Dialogue: 0,0:01:40.27,0:01:44.15,Default,,0,0,0,,Міне!
Dialogue: 0,0:01:44.15,0:01:46.51,Default,,0,0,0,,Қарқынды!
Dialogue: 0,0:01:46.51,0:01:49.18,Default,,0,0,0,,Сондай-ақ қол жетімді
Dialogue: 0,0:01:49.18,0:01:52.64,Default,,0,0,0,,Уау! Мен... кешіріңіз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:01:52.64,0:01:55.14,Default,,0,0,0,,Иә. Мен шынымен ризамын.
Dialogue: 0,0:01:55.14,0:01:57.17,Default,,0,0,0,,Мен көкке көтеріле алатындай сезінемін
Dialogue: 0,0:01:57.17,0:02:00.90,Default,,0,0,0,,Мен жаңа әлемді көремін...
Dialogue: 0,0:02:00.90,0:02:04.90,Default,,0,0,0,,Қайта келіңіз. Мен күтемін.
Dialogue: 0,0:05:18.83,0:05:20.81,Default,,0,0,0,,А, сіз білесіз➡
Dialogue: 0,0:05:20.81,0:05:23.85,Default,,0,0,0,,Осы маңда танымал торт дүкені бар➡
Dialogue: 0,0:05:23.85,0:05:26.27,Default,,0,0,0,,Балмұздақ шынымен дәмді деп естідім.
Dialogue: 0,0:05:26.27,0:05:28.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:28.20,0:05:30.15,Default,,0,0,0,,Сіз бүгін жұмысыңызды аяқтадыңыз, солай ма?
Dialogue: 0,0:05:30.15,0:05:33.62,Default,,0,0,0,,Қаласаң менімен кел... [ТЕЛ]
Dialogue: 0,0:05:33.62,0:05:36.18,Default,,0,0,0,,Мен бірінші барамын. иә?
Dialogue: 0,0:05:36.18,0:05:38.25,Default,,0,0,0,,Олай болса, еңбектеріңізге рахмет.
Dialogue: 0,0:05:38.25,0:05:41.75,Default,,0,0,0,,А, балмұздақ...
Dialogue: 0,0:05:43.70,0:05:45.70,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:05:51.81,0:05:54.16,Default,,0,0,0,,Олай болса, солай➡
Dialogue: 0,0:05:54.16,0:05:56.86,Default,,0,0,0,,Келесі G квестін Юна-сан шешеді.
Dialogue: 0,0:05:56.86,0:05:59.52,Default,,0,0,0,,Ах. (Шион) филиалының басшысы Рен Сузугамори➡
Dialogue: 0,0:05:59.52,0:06:02.17,Default,,0,0,0,,Ол басқаратын жауынгер қарсыласын ба?
Dialogue: 0,0:06:02.17,0:06:04.49,Default,,0,0,0,,Қаһарлы жау.
Dialogue: 0,0:06:04.49,0:06:07.81,Default,,0,0,0,,Күшті жау... күлесің.
Dialogue: 0,0:06:07.81,0:06:10.53,Default,,0,0,0,,Сіз де
Dialogue: 0,0:06:10.53,0:06:13.20,Default,,0,0,0,,Келесі, егер мен жеңсем, мен ұрпақ шебері боламын.
Dialogue: 0,0:06:13.20,0:06:15.85,Default,,0,0,0,,Біздің мақсатымыз өзгеріссіз қалады
Dialogue: 0,0:06:15.85,0:06:17.87,Default,,0,0,0,,Екі тармақ қалды
Dialogue: 0,0:06:17.87,0:06:21.56,Default,,0,0,0,,Барлық тармақтарды жеңіп, G Quest-ті толығымен жеңіңіз
Dialogue: 0,0:06:21.56,0:06:23.56,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:25.86,0:06:29.23,Default,,0,0,0,,Дағдыны белсендіру. Авангардқа шабуыл
Dialogue: 0,0:06:29.23,0:06:32.85,Default,,0,0,0,,Хмм... Сіз өте жақсы істеп жатырсыз.
Dialogue: 0,0:06:32.85,0:06:36.15,Default,,0,0,0,,Ух... Сәттілік Куми-чан
Dialogue: 0,0:06:36.15,0:06:40.19,Default,,0,0,0,,Не істеу керек, Токоха-чан, біз қатты қысылып қалдық.
Dialogue: 0,0:06:40.19,0:06:42.21,Default,,0,0,0,,Әлсіз болсаң, ұтыласың.
Dialogue: 0,0:06:42.21,0:06:44.50,Default,,0,0,0,,Жеңісті болашақты елестетіңіз!
Dialogue: 0,0:06:44.50,0:06:47.87,Default,,0,0,0,,Жоқ, бұл жағдай өте қиын...
Dialogue: 0,0:06:47.87,0:06:49.90,Default,,0,0,0,,♬~
Dialogue: 0,0:06:49.90,0:06:52.15,Default,,0,0,0,,Ааа, енді ойлап қарасам➡
Dialogue: 0,0:06:52.15,0:06:54.81,Default,,0,0,0,,Сізге талқылау қажет нәрсе жоқ па?
Dialogue: 0,0:06:54.81,0:06:56.81,Default,,0,0,0,,А... иә
Dialogue: 0,0:06:56.81,0:06:59.53,Default,,0,0,0,,Не? не болды?
Dialogue: 0,0:06:59.53,0:07:02.91,Default,,0,0,0,,Білесіз бе, бұл Ам туралы.
Dialogue: 0,0:07:02.91,0:07:04.83,Default,,0,0,0,,Ам-чан? Сіз тіпті ұрысып қалдыңыз ба?
Dialogue: 0,0:07:04.83,0:07:06.87,Default,,0,0,0,,Орындалмады Орындалмады
Dialogue: 0,0:07:06.87,0:07:08.80,Default,,0,0,0,,Біз жақсы доспыз
Dialogue: 0,0:07:08.80,0:07:13.87,Default,,0,0,0,,Ламираби ретінде...
Dialogue: 0,0:07:13.87,0:07:16.03,Default,,0,0,0,,Бірақ бәрі осы
Dialogue: 0,0:07:16.03,0:07:19.51,Default,,0,0,0,,Сізді уайымдағаны осы ма?
Dialogue: 0,0:07:19.51,0:07:23.52,Default,,0,0,0,,Ешқашан бірге тамақ ішуге немесе бірге ойнауға шықпадық.
Dialogue: 0,0:07:23.52,0:07:25.57,Default,,0,0,0,,Ей! Жұмыс аяқталғанда ➡
Dialogue: 0,0:07:25.57,0:07:27.54,Default,,0,0,0,,Мен жақында қайтамын.
Dialogue: 0,0:07:27.54,0:07:29.47,Default,,0,0,0,,Көп сөйле →
Dialogue: 0,0:07:29.47,0:07:32.14,Default,,0,0,0,,Мен Аммен жақсы аралассам деп тілеймін.
Dialogue: 0,0:07:32.14,0:07:35.20,Default,,0,0,0,,Авангард ше? Сіз әрқашан бірге күресесіз, солай ма?
Dialogue: 0,0:07:35.20,0:07:37.13,Default,,0,0,0,,Соңғы кездері мүлде жоқ
Dialogue: 0,0:07:37.13,0:07:39.17,Default,,0,0,0,,Ә? Шынында ма?
Dialogue: 0,0:07:39.17,0:07:42.70,Default,,0,0,0,,Жұмысыма кедергі болмайтындай дәрежеге жеттім➡
Dialogue: 0,0:07:42.70,0:07:44.99,Default,,0,0,0,,Маған бұл енді керек емес.
Dialogue: 0,0:07:44.99,0:07:48.18,Default,,0,0,0,,Сіз, әрине, күштірек болдыңыз.
Dialogue: 0,0:07:48.18,0:07:52.06,Default,,0,0,0,,Мен Ванганы сенен ұзағырақ ойнасам да.
Dialogue: 0,0:07:52.06,0:07:55.20,Default,,0,0,0,,Ол жерде стенд триггері жоқ.
Dialogue: 0,0:07:55.20,0:07:57.32,Default,,0,0,0,,Ахаха, Куми-чан, жіберіп алмаңыз!
Dialogue: 0,0:07:57.32,0:07:59.35,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:07:59.35,0:08:04.53,Default,,0,0,0,,Оны шақырайын десем де жақсы болмайды➡
Dialogue: 0,0:08:04.53,0:08:07.64,Default,,0,0,0,,Оның үстіне Ам соңғы кездері өзін жақсы сезінбейді.
Dialogue: 0,0:08:07.64,0:08:10.70,Default,,0,0,0,,Кейде мен қатты күйзелемін.
Dialogue: 0,0:08:10.70,0:08:14.05,Default,,0,0,0,,Мен де соған алаңдаймын.
Dialogue: 0,0:08:14.05,0:08:16.15,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:08:16.15,0:08:20.81,Default,,0,0,0,,Тату-тәтті жұмыс істеу деген сөз емес.
Dialogue: 0,0:08:20.81,0:08:24.03,Default,,0,0,0,,Иә! Жақында Валентин күні келеді, солай ма?
Dialogue: 0,0:08:24.03,0:08:27.53,Default,,0,0,0,,Досыңызға шоколад сыйласаңыз ше? аа!
Dialogue: 0,0:08:29.53,0:08:31.54,Default,,0,0,0,,Бұл жақсы болуы мүмкін!
Dialogue: 0,0:08:31.54,0:08:34.84,Default,,0,0,0,,Жарайды, қазір барайық! (Куми/Луна) Иә!
Dialogue: 0,0:08:37.69,0:08:40.48,Default,,0,0,0,,Қолмен жасаған дұрыс па?
Dialogue: 0,0:08:40.48,0:08:43.03,Default,,0,0,0,,Иә, алсам қуанар едім.
Dialogue: 0,0:08:43.03,0:08:46.50,Default,,0,0,0,,Олай болса материалдарды, әшекейлерді және т.б.
Dialogue: 0,0:08:46.50,0:08:49.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:55.24,0:08:57.24,Default,,0,0,0,,ｱﾑ？
Dialogue: 0,0:09:02.47,0:09:04.59,Default,,0,0,0,,Біз қайда барамыз?
Dialogue: 0,0:09:04.59,0:09:07.59,Default,,0,0,0,,Бұл сатып алу емес пе? (Куми) Сіз дүкенге жалғыз барасыз ба?
Dialogue: 0,0:09:09.56,0:09:11.56,Default,,0,0,0,,Ах
Dialogue: 0,0:09:13.59,0:09:15.59,Default,,0,0,0,,Уау! (Шырылдау)
Dialogue: 0,0:09:17.56,0:09:19.56,Default,,0,0,0,,Луна? Апыр-ай!
Dialogue: 0,0:09:21.50,0:09:23.50,Default,,0,0,0,,ｱ ｱﾑ
Dialogue: 0,0:09:25.54,0:09:27.81,Default,,0,0,0,,Хори, көмектесіп жібересің бе?
Dialogue: 0,0:09:27.81,0:09:31.90,Default,,0,0,0,,Уф! Бірге ойнайық
Dialogue: 0,0:09:31.90,0:09:34.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:37.47,0:09:41.52,Default,,0,0,0,,Ам-чан, білесің бе, біз қазір бастаймыз.
Dialogue: 0,0:09:41.52,0:09:44.06,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:09:44.06,0:09:46.06,Default,,0,0,0,,Иә
Dialogue: 0,0:09:52.82,0:09:55.35,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:09:55.35,0:09:58.24,Default,,0,0,0,,Бұл күдікті, Токоха-сан.
Dialogue: 0,0:09:58.24,0:10:00.69,Default,,0,0,0,,Сіз кіммен телефон арқылы сөйлесесіз?
Dialogue: 0,0:10:00.69,0:10:03.86,Default,,0,0,0,,Иә?Мүмкін...
Dialogue: 0,0:10:03.86,0:10:06.71,Default,,0,0,0,,Күн? Тх, бұл дұрыс емес!
Dialogue: 0,0:10:06.71,0:10:09.82,Default,,0,0,0,,Аа, дұрыс. Луна!
Dialogue: 0,0:10:09.82,0:10:13.47,Default,,0,0,0,,Сондықтан сіз әрқашан ол телефонды жасырын пайдаландыңыз.
Dialogue: 0,0:10:13.47,0:10:15.54,Default,,0,0,0,,Уф...｡ Дұрыс?
Dialogue: 0,0:10:15.54,0:10:18.14,Default,,0,0,0,,Я~
Dialogue: 0,0:10:18.14,0:10:21.53,Default,,0,0,0,,Жарайды, бәрібір, егер сізде кездесу болса, барыңыз.
Dialogue: 0,0:10:21.53,0:10:25.68,Default,,0,0,0,,Біз үшін алаңдамаңыз. Иә, иә!
Dialogue: 0,0:10:25.68,0:10:29.82,Default,,0,0,0,,Екі жас ше? (Луна) Иә, иә!
Dialogue: 0,0:10:29.82,0:10:33.02,Default,,0,0,0,,Біз үшін уайымдамай, кет.
Dialogue: 0,0:10:33.02,0:10:36.66,Default,,0,0,0,,Иә, иә! Күрсін...
Dialogue: 0,0:10:36.66,0:10:39.50,Default,,0,0,0,,Жақсы, мен сендермен араласамын.
Dialogue: 0,0:10:39.50,0:10:41.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:41.53,0:10:43.57,Default,,0,0,0,,Мені дұрыс түсінгім келмейді.
Dialogue: 0,0:10:43.57,0:10:46.35,Default,,0,0,0,,Бірақ уәделер... Ондай нәрсе жоқ.
Dialogue: 0,0:10:46.35,0:10:48.82,Default,,0,0,0,,Мен жалғыз өзім қыдырғым келді.
Dialogue: 0,0:10:48.82,0:10:50.82,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:10:53.89,0:10:56.39,Default,,0,0,0,,[ｽﾋﾟｰｶ]３ ２ １
Dialogue: 0,0:10:59.97,0:11:03.04,Default,,0,0,0,,Келесі - біртүрлі бет. (Токоха) Иә? Шынайы ма?
Dialogue: 0,0:11:03.04,0:11:05.17,Default,,0,0,0,,Жоқ, жоқ, жоқ...
Dialogue: 0,0:11:05.17,0:11:07.47,Default,,0,0,0,,[ｽﾋﾟｰｶ]３ ２ １
Dialogue: 0,0:11:09.91,0:11:11.91,Default,,0,0,0,,Ихихихи…
Dialogue: 0,0:11:13.98,0:11:16.72,Default,,0,0,0,,А... иә?
Dialogue: 0,0:11:16.72,0:11:21.81,Default,,0,0,0,,Уау~ Эххе...
Dialogue: 0,0:11:21.81,0:11:23.82,Default,,0,0,0,,Сіз соншалықты бақыттысыз ба?
Dialogue: 0,0:11:23.82,0:11:27.31,Default,,0,0,0,,Бұл менің бірінші рет!? Аму және екі ату!
Dialogue: 0,0:11:27.31,0:11:29.83,Default,,0,0,0,,Егер бұл фотосурет болса, сіз оны үнемі түсіресіз.
Dialogue: 0,0:11:29.83,0:11:33.03,Default,,0,0,0,,SNS немесе блогта жариялау
Dialogue: 0,0:11:33.03,0:11:36.17,Default,,0,0,0,,Хехехе, бұл дұрыс емес.
Dialogue: 0,0:11:36.17,0:11:38.17,Default,,0,0,0,,Мен – Фэт Гам. Баршаңызбен танысуға қуаныштымын.
Dialogue: 0,0:11:40.91,0:11:43.91,Default,,0,0,0,,Бұл сүйкімді! Түрлі түстері де бар
Dialogue: 0,0:11:49.02,0:11:51.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:51.03,0:11:55.19,Default,,0,0,0,,Эхехе Гао!
Dialogue: 0,0:11:55.19,0:11:59.66,Default,,0,0,0,,Уфуфуфу Ол саған жарасады, саған жарасады. Хехе
Dialogue: 0,0:11:59.66,0:12:03.63,Default,,0,0,0,,Ақырында мен ештеңе сатып алған жоқпын.
Dialogue: 0,0:12:03.63,0:12:05.68,Default,,0,0,0,,Маған бір ұнады➡
Dialogue: 0,0:12:05.68,0:12:09.32,Default,,0,0,0,,Менде қалта ақшасы көп емес, солай ма?
Dialogue: 0,0:12:09.32,0:12:13.42,Default,,0,0,0,,А, бірақ екеуі де атақты адамдар...
Dialogue: 0,0:12:16.36,0:12:19.03,Default,,0,0,0,,Пұттар туралы не деуге болады? Бұл
Dialogue: 0,0:12:19.03,0:12:21.15,Default,,0,0,0,,Уау Куми-чан, жылдам доп
Dialogue: 0,0:12:21.15,0:12:23.17,Default,,0,0,0,,Мен айтпаймын!
Dialogue: 0,0:12:23.17,0:12:25.19,Default,,0,0,0,,Айтайын дегенім, жарайды!
Dialogue: 0,0:12:25.19,0:12:29.14,Default,,0,0,0,,Барлығы бақытты болса, бізде бұл жақсы.
Dialogue: 0,0:12:29.14,0:12:31.58,Default,,0,0,0,,Әр адамның күлкісі – біздің кепіліміз
Dialogue: 0,0:12:31.58,0:12:34.18,Default,,0,0,0,,Бұл Лами Лабиринт!
Dialogue: 0,0:12:36.16,0:12:38.20,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:12:38.20,0:12:40.65,Default,,0,0,0,,Мен ешкімге айтпаймын, сондықтан айтыңызшы.
Dialogue: 0,0:12:40.65,0:12:42.69,Default,,0,0,0,,Не? сурет? Аа!?
Dialogue: 0,0:12:42.69,0:12:45.36,Default,,0,0,0,,ﾊｳﾏｯﾁ？ ﾀﾞﾒ！
Dialogue: 0,0:12:45.36,0:12:49.23,Default,,0,0,0,,Тынш! Е, айтыңызшы
Dialogue: 0,0:12:49.23,0:12:51.19,Default,,0,0,0,,Жоқ! (Куми) Әйтеуір?
Dialogue: 0,0:12:51.19,0:12:53.15,Default,,0,0,0,,Қалай болғанда да!
Dialogue: 0,0:12:53.15,0:12:56.68,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз, судья!
Dialogue: 0,0:12:56.68,0:12:59.54,Default,,0,0,0,,Жоқ! Сонда ғана.
Dialogue: 0,0:12:59.54,0:13:01.89,Default,,0,0,0,,Хмм!? Жарайды ма!?
Dialogue: 0,0:13:01.89,0:13:05.31,Default,,0,0,0,,Айтыңызшы! Луна! Ахахха!
Dialogue: 0,0:13:05.31,0:13:08.88,Default,,0,0,0,,Мен үрейлендім бе? Қызық! (Ам) Міне!
Dialogue: 0,0:13:08.88,0:13:12.38,Default,,0,0,0,,Уау~ ашуланып кеттім. Эххехе...
Dialogue: 0,0:13:14.68,0:13:19.62,Default,,0,0,0,,Ха~ Қарным ашты... Бірдеңе жегің келе ме?
Dialogue: 0,0:13:19.62,0:13:23.92,Default,,0,0,0,,Хмм...макарон? Ому күріш
Dialogue: 0,0:13:25.85,0:13:29.27,Default,,0,0,0,,Эй, саған қайсысы ұнайды, удон немесе соба?
Dialogue: 0,0:13:29.27,0:13:32.49,Default,,0,0,0,,Сөзсіз соба! Соба кеспесіндегі крокеттер
Dialogue: 0,0:13:32.49,0:13:34.47,Default,,0,0,0,,Бұл сөзсіз
Dialogue: 0,0:13:34.47,0:13:37.17,Default,,0,0,0,,Жоқ... бұл Чикуватен, солай ма?
Dialogue: 0,0:13:37.17,0:13:42.18,Default,,0,0,0,,Иә? Чикува темпура жақсы, бірақ үстіңгі жағы крокет болады.
Dialogue: 0,0:13:42.18,0:13:44.31,Default,,0,0,0,,Чикува темпура қоры
Dialogue: 0,0:13:44.31,0:13:47.48,Default,,0,0,0,,Соба емес, удон.
Dialogue: 0,0:13:47.48,0:13:50.02,Default,,0,0,0,,Иә? Хмм!?
Dialogue: 0,0:13:50.02,0:13:53.66,Default,,0,0,0,,Куми-чан - крокет! Nishi Bakery крокет наны➡
Dialogue: 0,0:13:53.66,0:13:57.03,Default,,0,0,0,,Мен оны жақсы көремін! (Ам) Луна - Чикуватен, солай ма?
Dialogue: 0,0:13:57.03,0:14:00.15,Default,,0,0,0,,Түскі ас қорабымда чикува темпурасы болғаны мені қуантады!
Dialogue: 0,0:14:00.15,0:14:03.17,Default,,0,0,0,,Біз...
Dialogue: 0,0:14:03.17,0:14:05.85,Default,,0,0,0,,《Екі адам: Біреуі жақсы~》
Dialogue: 0,0:14:05.85,0:14:08.97,Default,,0,0,0,,Сіздің артқа шегінуге ниетіңіз жоқ сияқты! Болды
Dialogue: 0,0:14:08.97,0:14:11.19,Default,,0,0,0,,Олай болса менде мұны істеуден басқа амал жоқ.
Dialogue: 0,0:14:11.19,0:14:13.58,Default,,0,0,0,,Иә, шешеміз!
Dialogue: 0,0:14:13.58,0:14:16.88,Default,,0,0,0,,Авангардта! (Луна/Куми) Неге олай!?
Dialogue: 0,0:16:01.85,0:16:03.85,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:16:07.14,0:16:10.01,Default,,0,0,0,,Шабдалы бағы қыз Эльми!
Dialogue: 0,0:16:10.01,0:16:12.86,Default,,0,0,0,,Өлмейтін өлі Грунаш!
Dialogue: 0,0:16:12.86,0:16:15.32,Default,,0,0,0,,ｸﾞﾗﾝﾌﾞﾙｰ
Dialogue: 0,0:16:15.32,0:16:17.85,Default,,0,0,0,,Мен сізге құлау аймағының қорқынышын айтамын➡
Dialogue: 0,0:16:17.85,0:16:20.04,Default,,0,0,0,,Крокет үшін!
Dialogue: 0,0:16:20.04,0:16:23.47,Default,,0,0,0,,ﾗｲﾄﾞ ﾊﾟｰﾃｨﾝｸﾞｼｪｲﾄﾞ！
Dialogue: 0,0:16:23.47,0:16:27.34,Default,,0,0,0,,Таза қанды қыз Катринаға мініңіз!
Dialogue: 0,0:16:27.34,0:16:29.34,Default,,0,0,0,,ｱﾀｯｸ!!
Dialogue: 0,0:16:32.05,0:16:35.85,Default,,0,0,0,,Қарақшы семсерші Колумбқа мініңіз!
Dialogue: 0,0:16:38.04,0:16:40.82,Default,,0,0,0,,Куу~! Не!!
Dialogue: 0,0:16:40.82,0:16:44.81,Default,,0,0,0,,Турия тамаша қыз!
Dialogue: 0,0:16:44.81,0:16:48.75,Default,,0,0,0,,Уау~ Жаңа карталар бірінен соң бірі келеді...
Dialogue: 0,0:16:48.75,0:16:51.15,Default,,0,0,0,,Бұл мен Мисаки-санмен жасаған жаңа палуба.
Dialogue: 0,0:16:51.15,0:16:54.35,Default,,0,0,0,,Токоха-чан, мен байсалдымын! Ол рас болсын!
Dialogue: 0,0:16:54.35,0:16:58.49,Default,,0,0,0,,Крокет бірегей және ерекше. Ең күшті және ең жақсы.
Dialogue: 0,0:16:58.49,0:17:01.54,Default,,0,0,0,,Дүниеде билік ететін абсолютті чемпион!
Dialogue: 0,0:17:01.54,0:17:04.16,Default,,0,0,0,,Мен бұл жекпе-жекте жеңіле алмаймын!!
Dialogue: 0,0:17:04.16,0:17:08.16,Default,,0,0,0,,Эльмидің соққысымен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:11.54,0:17:16.48,Default,,0,0,0,,Түнгі тұманның вампир ханшайымы түнгі раушанға мініңіз!
Dialogue: 0,0:17:16.48,0:17:18.51,Default,,0,0,0,,Негро Рукке қоңырау шалыңыз!
Dialogue: 0,0:17:18.51,0:17:20.81,Default,,0,0,0,,Негр Рукпен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:22.87,0:17:25.00,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:17:25.00,0:17:29.41,Default,,0,0,0,,Соба, удон, ақ күріш, нан... Сондай-ақ карри, макарон➡
Dialogue: 0,0:17:29.41,0:17:32.21,Default,,0,0,0,,Әкемнің түнгі асы... Тағы да!
Dialogue: 0,0:17:35.18,0:17:37.20,Default,,0,0,0,,Кез келген тағаммен жақсы үйлеседі→
Dialogue: 0,0:17:37.20,0:17:39.67,Default,,0,0,0,,Тамақ ішкендерге күлкі мен тоқтық сыйлау →
Dialogue: 0,0:17:39.67,0:17:43.74,Default,,0,0,0,,Бұл крокет!
Dialogue: 0,0:17:43.74,0:17:47.16,Default,,0,0,0,,Көктем гүлі Альборея ханшайымы!
Dialogue: 0,0:17:47.16,0:17:51.33,Default,,0,0,0,,Крокет – құдіретті және ең керемет тағам!
Dialogue: 0,0:17:51.33,0:17:53.31,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:17:53.31,0:17:56.35,Default,,0,0,0,,Қарғыс атсын...! Чикуватенде де солай
Dialogue: 0,0:17:56.35,0:18:00.69,Default,,0,0,0,,Дегенмен, Чикуватен сирек бағаланады➡
Dialogue: 0,0:18:00.69,0:18:03.86,Default,,0,0,0,,Дүкен мәзірінде мұндай атау сирек кездеседі!
Dialogue: 0,0:18:03.86,0:18:07.49,Default,,0,0,0,,Қайғылы, тақсыз император! Бұл Чикуватен!
Dialogue: 0,0:18:07.49,0:18:10.15,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:18:10.15,0:18:13.63,Default,,0,0,0,,Сахна артында қарақшылар патшасы бар барабан жұмыс істейді!
Dialogue: 0,0:18:13.63,0:18:15.85,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:18:15.85,0:18:19.24,Default,,0,0,0,,Шұңқыры бар құлау аймағын шақырыңыз!
Dialogue: 0,0:18:19.24,0:18:22.99,Default,,0,0,0,,Ал Nytosttorm да қуыс!
Dialogue: 0,0:18:22.99,0:18:25.31,Default,,0,0,0,,Бірақ бұл бүгінге дейін!
Dialogue: 0,0:18:25.31,0:18:29.13,Default,,0,0,0,,Абсолютті чемпион атағы Чикуватенге беріледі!
Dialogue: 0,0:18:29.13,0:18:33.69,Default,,0,0,0,,Крокет продиги Токоха Анджо, мен сені жеңемін!
Dialogue: 0,0:18:33.69,0:18:36.99,Default,,0,0,0,,Түнгі дауылдағы авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:36.99,0:18:39.48,Default,,0,0,0,,Луна!? Сен не істеп жатырсың?
Dialogue: 0,0:18:39.48,0:18:42.88,Default,,0,0,0,,Бұл жақсы болмады ма?
Dialogue: 0,0:18:42.88,0:18:45.82,Default,,0,0,0,,Жоқ, бұл жақсы идея болуы мүмкін.
Dialogue: 0,0:18:45.82,0:18:48.03,Default,,0,0,0,,Жүр!
Dialogue: 0,0:18:48.03,0:18:49.99,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ！
Dialogue: 0,0:18:49.99,0:18:52.94,Default,,0,0,0,,Куми-чан!? Алақай!
Dialogue: 0,0:18:52.94,0:18:59.70,Default,,0,0,0,,Мен асқабақ темпурасын жақсы көремін!
Dialogue: 0,0:18:59.70,0:19:02.32,Default,,0,0,0,,Эльмидің күшеюі! Аа!?
Dialogue: 0,0:19:02.32,0:19:04.85,Default,,0,0,0,,Ториямен шабуыл!
Dialogue: 0,0:19:04.85,0:19:06.85,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:19:06.85,0:19:08.86,Default,,0,0,0,,Ей!
Dialogue: 0,0:19:08.86,0:19:12.71,Default,,0,0,0,,Мен де асқабақ сорпасы мен сорпа тортын жақсы көремін!
Dialogue: 0,0:19:12.71,0:19:15.56,Default,,0,0,0,,Жоқ, менің айтып отырғаным бұл емес...
Dialogue: 0,0:19:15.56,0:19:18.36,Default,,0,0,0,,Мен ешқашан серіктесім сатады деп ойламаппын!
Dialogue: 0,0:19:18.36,0:19:20.72,Default,,0,0,0,,Анджо Токоха жеңілді!
Dialogue: 0,0:19:20.72,0:19:23.77,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:19:23.77,0:19:28.71,Default,,0,0,0,,Найроз, тұманды қарақшы патша!
Dialogue: 0,0:19:28.71,0:19:32.58,Default,,0,0,0,,Енді құлау аймағынан қорқудың уақыты келді!
Dialogue: 0,0:19:32.58,0:19:37.85,Default,,0,0,0,,Negro Rook түсіру аймағында жоғары қоңырау шалу үшін қадам жасау дағдыңызды пайдаланыңыз!
Dialogue: 0,0:19:37.85,0:19:41.80,Default,,0,0,0,,Дағды іске қосылды! Теріс шұңқырды қуыс күйге айналдырыңыз!
Dialogue: 0,0:19:41.80,0:19:45.33,Default,,0,0,0,,Біз Чикуватеннің болашағын жасаймыз!
Dialogue: 0,0:19:45.33,0:19:47.86,Default,,0,0,0,,Луна! Бар!
Dialogue: 0,0:19:47.86,0:19:51.53,Default,,0,0,0,,Мен балмұздақты жақсы көремін! сурет!
Dialogue: 0,0:19:51.53,0:19:54.63,Default,,0,0,0,,Negro Rook шеберлігімен қуат плюс 7000!
Dialogue: 0,0:19:57.40,0:19:59.90,Default,,0,0,0,,ｶﾞｰﾄﾞ！ ｲﾝﾀｰｾﾌﾟﾄ！
Dialogue: 0,0:20:01.99,0:20:04.53,Default,,0,0,0,,Ах~｡ Сен де.
Dialogue: 0,0:20:04.53,0:20:07.98,Default,,0,0,0,,Nightrose көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:20:07.98,0:20:14.10,Default,,0,0,0,,Найтроздың шеберлігімен құлау аймағынан, Түнгі дауыл және Томи ағайындарына қоңырау шалыңыз!
Dialogue: 0,0:20:14.10,0:20:16.90,Default,,0,0,0,,Түнгі дауылды өз шеберлігіңмен ойпатқа айналдыр!
Dialogue: 0,0:20:20.21,0:20:22.81,Default,,0,0,0,,Гах...! (А) Түнгі дауыл!
Dialogue: 0,0:20:32.52,0:20:35.21,Default,,0,0,0,,Heal Trigger! Куми-чан?
Dialogue: 0,0:20:35.21,0:20:37.21,Default,,0,0,0,,Токоха-чан Файтин
Dialogue: 0,0:20:39.15,0:20:41.20,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:41.20,0:20:43.20,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:20:48.22,0:20:53.14,Default,,0,0,0,,Ранункулалар гүлдеді!
Dialogue: 0,0:20:53.14,0:20:56.90,Default,,0,0,0,,Міне! Токоха-чанның жаңа G блогы
Dialogue: 0,0:20:56.90,0:21:00.50,Default,,0,0,0,,Гүлденген Ранункулус Ашермен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:21:11.01,0:21:13.55,Default,,0,0,0,,Хаа!!
Dialogue: 0,0:21:13.55,0:21:15.58,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:21:15.58,0:21:22.49,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:22.49,0:21:26.56,Default,,0,0,0,,Мен мұны істемеймін, бірақ әлі біткен жоқпын!
Dialogue: 0,0:21:26.56,0:21:28.56,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:21:32.23,0:21:34.83,Default,,0,0,0,,Иә!!
Dialogue: 0,0:21:39.31,0:21:42.24,Default,,0,0,0,,Орынға тапсырыс беріңіз.
Dialogue: 0,0:21:42.24,0:21:45.04,Default,,0,0,0,,Түсіндім, сатып алуыңызға сәттілік тілейміз.
Dialogue: 0,0:21:45.04,0:21:47.98,Default,,0,0,0,,Луна-чан кеттік
Dialogue: 0,0:21:47.98,0:21:50.03,Default,,0,0,0,,Иә
Dialogue: 0,0:21:50.03,0:21:54.15,Default,,0,0,0,,Күтілгендей, G Quest жеңіліссіз.
Dialogue: 0,0:21:54.15,0:21:58.49,Default,,0,0,0,,Аму-чанның Лунаны бір рет болса да жеңгені мағынасы бар.
Dialogue: 0,0:21:58.49,0:22:02.38,Default,,0,0,0,,Бірақ соңғы кездері Лунамен ұрыспадың ба?
Dialogue: 0,0:22:02.38,0:22:04.98,Default,,0,0,0,,Луна мен сені сағындым.
Dialogue: 0,0:22:04.98,0:22:07.02,Default,,0,0,0,,Өйткені ол маған енді керек емес
Dialogue: 0,0:22:07.02,0:22:09.02,Default,,0,0,0,,Құрғақ...
Dialogue: 0,0:22:09.02,0:22:11.39,Default,,0,0,0,,Бұл жұмыс немесе басқа нәрсе туралы болмауы керек.
Dialogue: 0,0:22:11.39,0:22:14.49,Default,,0,0,0,,Достармен төбелесу қызық, солай ма?
Dialogue: 0,0:22:16.51,0:22:20.01,Default,,0,0,0,,Ам-чан, Луна туралы не ойлайсың?
Dialogue: 0,0:22:22.52,0:22:24.50,Default,,0,0,0,,Ламираби серіктесі
Dialogue: 0,0:22:24.50,0:22:26.50,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:22:26.50,0:22:29.56,Default,,0,0,0,,Мен Лунамен келісемін.
Dialogue: 0,0:22:29.56,0:22:32.64,Default,,0,0,0,,Жұмысына байсалды, еңбекқор➡
Dialogue: 0,0:22:32.64,0:22:35.18,Default,,0,0,0,,Мен де өз сабақтарымда көп жұмыс істеймін.
Dialogue: 0,0:22:35.18,0:22:37.50,Default,,0,0,0,,Менің ойымша, ол жақсы бала.
Dialogue: 0,0:22:37.50,0:22:40.37,Default,,0,0,0,,Луна уайымдады.
Dialogue: 0,0:22:40.37,0:22:43.65,Default,,0,0,0,,Соңғы кездері Ам өзімді жақсы сезінбейді.
Dialogue: 0,0:22:43.65,0:22:46.14,Default,,0,0,0,,Кейде мен қатты күйзелемін.
Dialogue: 0,0:22:46.14,0:22:48.86,Default,,0,0,0,,Луна мұны істеді.
Dialogue: 0,0:22:48.86,0:22:52.25,Default,,0,0,0,,Луна шынымен Аму-чанға қарап тұр.
Dialogue: 0,0:22:52.25,0:22:54.26,Default,,0,0,0,,Тек жұмыс емес→
Dialogue: 0,0:22:54.26,0:22:56.35,Default,,0,0,0,,Мен Ам-чанға жақындағым келеді.
Dialogue: 0,0:22:56.35,0:23:01.15,Default,,0,0,0,,Мен көбірек сөйлеп, ойнағым келеді.
Dialogue: 0,0:23:01.15,0:23:03.87,Default,,0,0,0,,Бірақ бұл Ам-чан➡ дегенді білдірмейді
Dialogue: 0,0:23:03.87,0:23:06.74,Default,,0,0,0,,Бұл менің не істегіңіз келетіні туралы емес.
Dialogue: 0,0:23:06.74,0:23:09.53,Default,,0,0,0,,Мен сенің білгеніңді қалаймын
Dialogue: 0,0:23:09.53,0:23:11.70,Default,,0,0,0,,Сіз ойлағаннан да көп➡
Dialogue: 0,0:23:11.70,0:23:15.13,Default,,0,0,0,,Луна сені жақсы көреді
Dialogue: 0,0:23:15.13,0:23:17.69,Default,,0,0,0,,Солай десең де➡
Dialogue: 0,0:23:17.69,0:23:19.69,Default,,0,0,0,,Ақаулық
Dialogue: 0,0:23:19.69,0:23:21.69,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:23:21.69,0:23:24.26,Default,,0,0,0,,Не айтып тұрсың, бала?
Dialogue: 0,0:23:24.26,0:23:26.35,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:23:26.35,0:23:29.68,Default,,0,0,0,,Адасқаның жақсы...
Dialogue: 0,0:23:29.68,0:23:31.82,Default,,0,0,0,,Токоха-чан
Dialogue: 0,0:23:31.82,0:23:35.67,Default,,0,0,0,,Не… не болды? Сізде соншама көп пе?
Dialogue: 0,0:23:35.67,0:23:40.31,Default,,0,0,0,,Біз 100 000-шы тұтынушы болған сияқтымыз...
Dialogue: 0,0:23:40.31,0:23:42.31,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:23:42.31,0:23:45.87,Default,,0,0,0,,Біз сізге қызмет ету үшін бар күшімізді саламыз!
Dialogue: 0,0:23:45.87,0:23:48.68,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:23:48.68,0:23:52.19,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:23:52.19,0:23:54.69,Default,,0,0,0,,Бұл таңғажайып қуанышты сору.
Dialogue: 0,0:23:54.69,0:23:58.31,Default,,0,0,0,,Жарайды Луна, тез тамақтанайық! сурет?
Dialogue: 0,0:23:58.31,0:24:01.25,Default,,0,0,0,,Мен бүгін ойнап өте қызық болдым➡
Dialogue: 0,0:24:01.25,0:24:03.65,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:24:03.65,0:24:06.37,Default,,0,0,0,,Ой, мынау балмұздақ па? Иә
Dialogue: 0,0:24:06.37,0:24:08.40,Default,,0,0,0,,А, мен!
Dialogue: 0,0:24:08.40,0:24:10.40,Default,,0,0,0,,Бірге тамақтанайық!
Dialogue: 0,0:24:13.51,0:24:16.01,Default,,0,0,0,,Өткен күн үшін кешірім сұраймын. Келесіде үзіліс жасаймын➡
Dialogue: 0,0:24:16.01,0:24:18.41,Default,,0,0,0,,Келіңіздер, Луна айтқан дәмді балмұздақ мейрамханасына барайық.
Dialogue: 0,0:24:18.41,0:24:20.35,Default,,0,0,0,,Иә. Әй, соба.
Dialogue: 0,0:24:20.35,0:24:22.50,Default,,0,0,0,,Бүгін бұл. Чикуватен!
Dialogue: 0,0:24:22.50,0:24:24.50,Default,,0,0,0,,Уфуфуфу
Dialogue: 0,0:24:28.19,0:24:31.03,Default,,0,0,0,,Уау! Тіпті солай➡
Dialogue: 0,0:24:31.03,0:24:34.15,Default,,0,0,0,,Маған айналу доңғалағына билет бергеніңіз қаншалықты жомартсыз.
Dialogue: 0,0:24:34.15,0:24:37.53,Default,,0,0,0,,Өйткені, сіз біздің 100 000-шы тұтынушымызсыз.
Dialogue: 0,0:24:37.53,0:24:41.15,Default,,0,0,0,,Ам-чан үшін өте жаман болған сияқты.
Dialogue: 0,0:24:41.15,0:24:44.21,Default,,0,0,0,,Бір қызығы маған қымбат баға ұнамайды.
Dialogue: 0,0:24:44.21,0:24:46.16,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:24:46.16,0:24:48.19,Default,,0,0,0,,Келесі жолы бірге атқа мінейік.
Dialogue: 0,0:24:48.19,0:24:50.86,Default,,0,0,0,,Қорықпау үшін қолыңды ұстаймын
Dialogue: 0,0:24:50.86,0:24:53.72,Default,,0,0,0,,Мен оны мүлдем жек көремін. Хехе
Dialogue: 0,0:24:53.72,0:24:55.87,Default,,0,0,0,,≪Мама тез
Dialogue: 0,0:24:55.87,0:24:58.99,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:24:58.99,0:25:01.06,Default,,0,0,0,,Дұрыс айтасың — ол әдеттегіден де көп әуре-сарсаңға түсіп жүр.
Dialogue: 0,0:25:01.06,0:25:03.06,Default,,0,0,0,,Үйге қайтайық? иә!
Dialogue: 0,0:25:07.50,0:25:12.08,Default,,0,0,0,,Жел салқын. Қар жауа ма, әлде бірдеңе ме деп ойлаймын.
Dialogue: 0,0:25:12.08,0:25:15.86,Default,,0,0,0,,Мен бұл маусымды жек көремін. иә?
Dialogue: 0,0:25:15.86,0:25:20.36,Default,,0,0,0,,Бұл маған өте жаман нәрсені еске түсіреді, сондықтан мен оған көмектесе алмаймын
Dialogue: 0,0:25:22.33,0:25:25.15,Default,,0,0,0,,Мен бес жасымда
Dialogue: 0,0:25:25.15,0:25:27.15,Default,,0,0,0,,(Тежегіш дыбысы)
Dialogue: 0,0:25:27.15,0:25:29.24,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:25:29.24,0:25:38.24,Default,,0,0,0,,(жедел жәрдем сиренасы)
Dialogue: 0,0:25:40.25,0:25:43.02,Default,,0,0,0,,Ол маңызды адам болды
Dialogue: 0,0:25:43.02,0:25:47.15,Default,,0,0,0,,өте маңызды адам
Dialogue: 0,0:25:47.15,0:25:51.19,Default,,0,0,0,,Сіз мұны іздедіңіз, солай ма?
Dialogue: 0,0:25:51.19,0:25:53.19,Default,,0,0,0,,Иә
Dialogue: 0,0:25:53.19,0:25:55.83,Default,,0,0,0,,Бұл сол адаммен естелік
Dialogue: 0,0:25:55.83,0:25:59.70,Default,,0,0,0,,Және бұл байланыс.
Dialogue: 0,0:25:59.70,0:26:02.85,Default,,0,0,0,,Сол күні мен бәрінен айырылдым
Dialogue: 0,0:26:02.85,0:26:05.86,Default,,0,0,0,,Сондықтан мен бұл маусымды жек көремін
Dialogue: 0,0:26:05.86,0:26:08.16,Default,,0,0,0,,Мен кенеттен күйзеліске түстім...
Dialogue: 0,0:26:10.41,0:26:14.85,Default,,0,0,0,,Бірақ мұны ешкім байқамады.
Dialogue: 0,0:26:14.85,0:26:17.53,Default,,0,0,0,,Ешкім ешқашан
Dialogue: 0,0:26:17.53,0:26:22.52,Default,,0,0,0,,Мен бұл сезімдерді көрсетпеуге тырыстым.
Dialogue: 0,0:26:22.52,0:26:35.82,Default,,0,0,0,,♪♪～
Dialogue: 0,0:30:33.87,0:30:35.87,Default,,0,0,0,,Бүгінгі «сезім» →
Dialogue: 0,0:30:55.90,0:30:57.90,Default,,0,0,0,,Бүгінгі түскі ас→
Dialogue: 0,0:30:59.40,0:31:05.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory