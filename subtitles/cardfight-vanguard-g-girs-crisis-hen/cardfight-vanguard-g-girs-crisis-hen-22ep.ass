Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:10.24,0:01:12.61,Default,,0,0,0,,Ол 3 айға созылды➡
Dialogue: 0,0:01:12.61,0:01:14.59,Default,,0,0,0,,Ұрпақ квесті де ➡
Dialogue: 0,0:01:14.59,0:01:18.23,Default,,0,0,0,,Бүгін біз үлкен финалға жетеміз!
Dialogue: 0,0:01:18.23,0:01:21.95,Default,,0,0,0,,Барлық қатысқан жауынгерлерге➡
Dialogue: 0,0:01:21.95,0:01:23.94,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:01:23.94,0:01:25.94,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:01:25.94,0:01:27.94,Default,,0,0,0,,Ұзақ кескілескен шайқаста жүгіру➡
Dialogue: 0,0:01:27.94,0:01:31.28,Default,,0,0,0,,50 марка алған жауынгерлерге➡
Dialogue: 0,0:01:31.28,0:01:34.70,Default,,0,0,0,,Сізге ұрпақ шебері атағы беріледі.
Dialogue: 0,0:01:34.70,0:01:37.00,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:01:44.61,0:01:49.01,Default,,0,0,0,,Ал барлық қатысушылардың ішінен бірінші шыққан ➡ болды
Dialogue: 0,0:01:49.01,0:01:51.61,Default,,0,0,0,,Барлық квесттерді жеңіп алыңыз➡
Dialogue: 0,0:01:51.61,0:01:55.28,Default,,0,0,0,,Керемет ұпай жинаған жалғыз команда➡
Dialogue: 0,0:01:55.28,0:01:58.40,Default,,0,0,0,,Үшеуін қолданып көріңіз! (қуаныш)
Dialogue: 0,0:01:58.40,0:02:01.24,Default,,0,0,0,,Бұл шынымен де, таңқаларлық болды.
Dialogue: 0,0:02:01.24,0:02:04.44,Default,,0,0,0,,Құттықтаймыз! (Куроно) Рахмет
Dialogue: 0,0:02:04.44,0:02:07.95,Default,,0,0,0,,Бәріңе сәлем! G Quest осылай аяқталады➡
Dialogue: 0,0:02:07.95,0:02:09.97,Default,,0,0,0,,Жалғыз емессің бе?
Dialogue: 0,0:02:09.97,0:02:12.97,Default,,0,0,0,,Сондай-ақ барлық жарыстарда жеңіске жеткен Үштікке➡
Dialogue: 0,0:02:12.97,0:02:17.27,Default,,0,0,0,,Мен сіздің ерекше уақытты көбірек өткізгеніңізді қалаймын.
Dialogue: 0,0:02:17.27,0:02:19.64,Default,,0,0,0,,G Quest Соңғы фестивалі
Dialogue: 0,0:02:19.64,0:02:21.66,Default,,0,0,0,,Үш-үштік →
Dialogue: 0,0:02:21.66,0:02:24.28,Default,,0,0,0,,Промоушн қауымдастығы дайындаған армандар командасы➡
Dialogue: 0,0:02:24.28,0:02:27.27,Default,,0,0,0,,Біз сіздерге арнайы матч дайындадық.
Dialogue: 0,0:02:29.90,0:02:33.94,Default,,0,0,0,,Армандар тобының мүшелері оқиға болатын күнге дейін құпия сақталады.
Dialogue: 0,0:02:33.94,0:02:36.28,Default,,0,0,0,,Іс-шара екі аптадан кейін өтеді
Dialogue: 0,0:02:36.28,0:02:38.96,Default,,0,0,0,,Бұл жылжыту бірлестігінің негізгі кезеңі болады.
Dialogue: 0,0:02:38.96,0:02:41.30,Default,,0,0,0,,Трисли мырза!
Dialogue: 0,0:02:41.30,0:02:43.98,Default,,0,0,0,,Біздің соңғы тапсырма➡
Dialogue: 0,0:02:43.98,0:02:45.98,Default,,0,0,0,,Сіз оны қабылдайсыз ба?
Dialogue: 0,0:02:51.02,0:02:53.33,Default,,0,0,0,,Әрине қабылдаймын.
Dialogue: 0,0:02:53.33,0:02:56.33,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:06:09.24,0:06:12.29,Default,,0,0,0,,Ерте көктемде Токио шығанағында камбала маусымында!
Dialogue: 0,0:06:12.29,0:06:14.64,Default,,0,0,0,,Негізгі мақсат - ақылсыз!
Dialogue: 0,0:06:14.64,0:06:18.28,Default,,0,0,0,,Уылдырық шашу үшін таяз суда жиналатын жерлерін ату.
Dialogue: 0,0:06:18.28,0:06:20.93,Default,,0,0,0,,Бүгін балық аулауға барайық!
Dialogue: 0,0:06:20.93,0:06:23.90,Default,,0,0,0,,Оған мұндай нәрсе қатты ұнайды.
Dialogue: 0,0:06:23.90,0:06:25.94,Default,,0,0,0,,Бұл Драен тармағының қаны ма?
Dialogue: 0,0:06:25.94,0:06:28.57,Default,,0,0,0,,Шион! Мен саған кешкі асқа көп балық аулаймын.
Dialogue: 0,0:06:28.57,0:06:30.61,Default,,0,0,0,,Маған бұл пікір қажет емес.
Dialogue: 0,0:06:30.61,0:06:32.61,Default,,0,0,0,,бастайық.
Dialogue: 0,0:06:32.61,0:06:34.66,Default,,0,0,0,,Балалар, сендер де маған жем беріңдер.
Dialogue: 0,0:06:34.66,0:06:37.66,Default,,0,0,0,,Бұл...?
Dialogue: 0,0:06:41.59,0:06:44.29,Default,,0,0,0,,Хмм... бұл тым ауыр.
Dialogue: 0,0:06:44.29,0:06:46.29,Default,,0,0,0,,ｽﾃﾙｽ･ﾐﾘﾋﾟｰﾄﾞ…
Dialogue: 0,0:06:46.29,0:06:49.59,Default,,0,0,0,,Тым шаш кетпеңіз, оны көп жағыңыз.
Dialogue: 0,0:06:58.24,0:07:00.27,Default,,0,0,0,,Мен оны ұстай алмаймын.
Dialogue: 0,0:07:00.27,0:07:02.26,Default,,0,0,0,,Сіз енді ғана бастайсыз ба?
Dialogue: 0,0:07:02.26,0:07:04.73,Default,,0,0,0,,Күту - камбала балық аулаудың негізі.
Dialogue: 0,0:07:04.73,0:07:06.73,Default,,0,0,0,,Бұл Тайкобо.
Dialogue: 0,0:07:08.91,0:07:12.60,Default,,0,0,0,,Күрсін, бұл бізге жарай ма?
Dialogue: 0,0:07:12.60,0:07:14.97,Default,,0,0,0,,Нақты нәрсе ертең.
Dialogue: 0,0:07:14.97,0:07:17.24,Default,,0,0,0,,Келіңіз, шағымданбаңыз.
Dialogue: 0,0:07:17.24,0:07:20.28,Default,,0,0,0,,Анда-санда ойланбай ойнау жақсы емес пе?
Dialogue: 0,0:07:20.28,0:07:22.93,Default,,0,0,0,,Қазір аралассам да, ол басталмайды.
Dialogue: 0,0:07:22.93,0:07:25.23,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:07:28.95,0:07:30.92,Default,,0,0,0,,((Ибуки: Миоджин Льюс - бұл➡
Dialogue: 0,0:07:30.92,0:07:33.62,Default,,0,0,0,,Осы соңғы кезеңдік жекпе-жекті пайдалану➡
Dialogue: 0,0:07:33.62,0:07:39.03,Default,,0,0,0,,Клейден соңғы бірлікті шақыруға тырысқан шығар.
Dialogue: 0,0:07:39.03,0:07:42.90,Default,,0,0,0,,Соңғы бірлік не екенін қалай білуге болады?
Dialogue: 0,0:07:42.90,0:07:45.60,Default,,0,0,0,,Мен растағанша➡
Dialogue: 0,0:07:45.60,0:07:49.24,Default,,0,0,0,,Барлығы 12 тәуелді карта бар.
Dialogue: 0,0:07:49.24,0:07:51.96,Default,,0,0,0,,Төрт біздің қолымызда
Dialogue: 0,0:07:51.96,0:07:54.58,Default,,0,0,0,,Миджин Роуз астындағы 8 бөлік
Dialogue: 0,0:07:54.58,0:07:57.61,Default,,0,0,0,,Алайда олардың біреуіне қатысты➡
Dialogue: 0,0:07:57.61,0:08:01.28,Default,,0,0,0,,Шақыру G Quest➡ алдында орындалды
Dialogue: 0,0:08:01.28,0:08:03.23,Default,,0,0,0,,Расталған
Dialogue: 0,0:08:03.23,0:08:05.95,Default,,0,0,0,,Миоджин қалған 7 картаның 6-сын алады ➡
Dialogue: 0,0:08:05.95,0:08:08.91,Default,,0,0,0,,Мен оны ояту үшін G Quest қолданбасын қолдандым.
Dialogue: 0,0:08:08.91,0:08:12.94,Default,,0,0,0,,Соңғы кезең – соңғы кезең.
Dialogue: 0,0:08:12.94,0:08:15.61,Default,,0,0,0,,Бірақ дәл сол сәт➡
Dialogue: 0,0:08:15.61,0:08:19.02,Default,,0,0,0,,Бұл оның қайда екенін білуге де мүмкіндік.
Dialogue: 0,0:08:19.02,0:08:23.29,Default,,0,0,0,,Біз сонымен қатар соңғы кезеңдегі жекпе-жекті қолданамыз.
Dialogue: 0,0:08:23.29,0:08:28.96,Default,,0,0,0,,G жоспарына қатысушылардың бар күшімен оның жасырын ұясын ашыңыз.
Dialogue: 0,0:08:28.96,0:08:32.26,Default,,0,0,0,,Беріліс дағдарысы))
Dialogue: 0,0:08:35.78,0:08:37.75,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:37.75,0:08:40.57,Default,,0,0,0,,Мен әркімнің қорытындысын тыңдағым келеді.
Dialogue: 0,0:08:40.57,0:08:45.99,Default,,0,0,0,,Мен бұдан былай бәрін Трислиге сеніп тапсыра аламын ба?
Dialogue: 0,0:08:45.99,0:08:48.06,Default,,0,0,0,,Тәжірибесіз
Dialogue: 0,0:08:48.06,0:08:50.28,Default,,0,0,0,,Тек қабілеттілік тұрғысынан➡
Dialogue: 0,0:08:50.28,0:08:53.92,Default,,0,0,0,,Мұнда жиналғандар әлдеқайда жақсырақ шығар.
Dialogue: 0,0:08:53.92,0:08:55.94,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:55.94,0:08:59.37,Default,,0,0,0,,Сондықтан құмар ойынға тұрарлық
Dialogue: 0,0:08:59.37,0:09:01.59,Default,,0,0,0,,Осы қысқа мерзімде➡
Dialogue: 0,0:09:01.59,0:09:06.03,Default,,0,0,0,,Біз күткен деңгейден жоғары өсімге қол жеткіздік.
Dialogue: 0,0:09:06.03,0:09:10.74,Default,,0,0,0,,Олар оны шындыққа айналдырудың мүмкіндіктері мен ерік-жігерін сезінеді.
Dialogue: 0,0:09:10.74,0:09:13.20,Default,,0,0,0,,Олар мұны істей алады.
Dialogue: 0,0:09:13.20,0:09:17.20,Default,,0,0,0,,Бізде бұрынғыға қарағанда жақсы топтық жұмыс бар.
Dialogue: 0,0:09:19.09,0:09:21.11,Default,,0,0,0,,, үш-үш ➡ үшін
Dialogue: 0,0:09:21.11,0:09:23.78,Default,,0,0,0,,Олардың соңғы кедергіні алуы➡
Dialogue: 0,0:09:23.78,0:09:26.94,Default,,0,0,0,,Соңғы кезеңмен бір уақытта →
Dialogue: 0,0:09:26.94,0:09:29.54,Default,,0,0,0,,Беріліс дағдарысын іске қосыңыз
Dialogue: 0,0:09:36.61,0:09:39.76,Default,,0,0,0,,Бүгін... Мен балық аулауды күтемін.
Dialogue: 0,0:09:39.76,0:09:43.79,Default,,0,0,0,,Өйткені бұл уақыт нағыз толқу
Dialogue: 0,0:09:43.79,0:09:45.77,Default,,0,0,0,,Мен әлі ештеңе айтқан жоқпын.
Dialogue: 0,0:09:45.77,0:09:48.74,Default,,0,0,0,,Бұл ертең туралы...
Dialogue: 0,0:09:48.74,0:09:51.84,Default,,0,0,0,,Не, сен де бос сөз айтасың ба?
Dialogue: 0,0:09:51.84,0:09:55.34,Default,,0,0,0,,Жоқ, бізге бір нәрсе туралы айту керек.
Dialogue: 0,0:09:57.28,0:09:59.28,Default,,0,0,0,,Менің әкем➡
Dialogue: 0,0:09:59.28,0:10:02.69,Default,,0,0,0,,Ол менің төрт жасымда қайтыс болды➡
Dialogue: 0,0:10:02.69,0:10:05.44,Default,,0,0,0,,Ол авангард жауынгері болса керек.
Dialogue: 0,0:10:05.44,0:10:10.45,Default,,0,0,0,,Демек, олардың Миджин Льюеске қатысы бар сияқты.
Dialogue: 0,0:10:10.45,0:10:13.11,Default,,0,0,0,,Мен мұны қалай да білдім.
Dialogue: 0,0:10:13.11,0:10:16.12,Default,,0,0,0,,Менің ойымша, бұл Жұлдыздар қақпасы филиалы кезінде болды.
Dialogue: 0,0:10:16.12,0:10:19.75,Default,,0,0,0,,Менің әкем Миджин➡ зерттеуіне қатысты
Dialogue: 0,0:10:19.75,0:10:23.44,Default,,0,0,0,,Ол сол жерде жол апатына ұшырады.
Dialogue: 0,0:10:23.44,0:10:28.10,Default,,0,0,0,,Бірақ сонда не болды?
Dialogue: 0,0:10:28.10,0:10:30.95,Default,,0,0,0,,Шындықты тек әкем мен Мёджин біледі.
Dialogue: 0,0:10:30.95,0:10:33.54,Default,,0,0,0,,Апат емес, Миджин ➡
Dialogue: 0,0:10:33.54,0:10:35.75,Default,,0,0,0,,Сонымен, Курононың әкесі жойылған болуы мүмкін бе?
Dialogue: 0,0:10:35.75,0:10:37.79,Default,,0,0,0,,ｼｵﾝ！
Dialogue: 0,0:10:37.79,0:10:39.92,Default,,0,0,0,,Дәл Шион айтқандай.
Dialogue: 0,0:10:39.92,0:10:42.44,Default,,0,0,0,,Бастапқы тағдыры➡
Dialogue: 0,0:10:42.44,0:10:46.45,Default,,0,0,0,,Әкем мен Миджиннің арасында болған шығар.
Dialogue: 0,0:10:46.45,0:10:49.42,Default,,0,0,0,,Егер солай болса, мен саған қамқор боламын➡
Dialogue: 0,0:10:49.42,0:10:53.10,Default,,0,0,0,,Біз ата-ана мен бала туралы әңгімеге қатысамыз.
Dialogue: 0,0:10:53.10,0:10:56.42,Default,,0,0,0,,Сонда мен де солаймын.
Dialogue: 0,0:10:56.42,0:11:00.30,Default,,0,0,0,,Кибаны басып алған қылмыскер Эйс➡ артында тұрды
Dialogue: 0,0:11:00.30,0:11:02.36,Default,,0,0,0,,Бұл Миоджин Льюз.
Dialogue: 0,0:11:02.36,0:11:05.08,Default,,0,0,0,,Өз амбицияларын жүзеге асыру үшін қаражат көзі ретінде →
Dialogue: 0,0:11:05.08,0:11:08.12,Default,,0,0,0,,Киба Зайбацу нысанаға алынды.
Dialogue: 0,0:11:08.12,0:11:10.26,Default,,0,0,0,,Сіз мұны қалай білдіңіз? Болды
Dialogue: 0,0:11:10.26,0:11:13.22,Default,,0,0,0,,Әртүрлі нәрселер...
Dialogue: 0,0:11:13.22,0:11:18.45,Default,,0,0,0,,Сондықтан мен қуып жетуім керек нағыз жау – Миджин Рюдзу.
Dialogue: 0,0:11:18.45,0:11:23.90,Default,,0,0,0,,Миоджин біз ойлағаннан да күшті күшке ие.
Dialogue: 0,0:11:23.90,0:11:27.16,Default,,0,0,0,,Және күтпеген жерлерге қол созу
Dialogue: 0,0:11:27.16,0:11:29.26,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:11:34.75,0:11:36.78,Default,,0,0,0,,Эйстің шынайы тұлғасы➡
Dialogue: 0,0:11:36.78,0:11:39.77,Default,,0,0,0,,Бұл Лами Лабиринттегі Аму Чоно болатын.
Dialogue: 0,0:11:39.77,0:11:42.25,Default,,0,0,0,,Бұл өтірік болса керек!? Мен неге...
Dialogue: 0,0:11:42.25,0:11:44.34,Default,,0,0,0,,Бұл өкінішті, бірақ бұл шындық.
Dialogue: 0,0:11:44.34,0:11:48.84,Default,,0,0,0,,Эйс оның жасырын жүзі болғанына еш күмән жоқ.
Dialogue: 0,0:11:50.91,0:11:54.27,Default,,0,0,0,,Луна... Луна бұл туралы біле ме?
Dialogue: 0,0:11:54.27,0:11:56.25,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:11:56.25,0:11:58.69,Default,,0,0,0,,Жоқ, зерттегенімше➡
Dialogue: 0,0:11:58.69,0:12:00.59,Default,,0,0,0,,Ол қылмысқа қатысы жоқ.
Dialogue: 0,0:12:00.59,0:12:06.11,Default,,0,0,0,,Дегенмен, Lamy Labyrinth - промоушн қауымдастығы құрған бөлімше.
Dialogue: 0,0:12:06.11,0:12:08.78,Default,,0,0,0,,Мұның астарында ешқандай ниет жоқ деп ойлаймын.
Dialogue: 0,0:12:08.78,0:12:10.93,Default,,0,0,0,,Бұл не! Ламирабидің екі мүшесі →
Dialogue: 0,0:12:10.93,0:12:13.03,Default,,0,0,0,,Сіз өзіңізді Миджиннің минионы деп айтасыз ба!?
Dialogue: 0,0:12:16.82,0:12:19.07,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:12:19.07,0:12:23.56,Default,,0,0,0,,Луна Амды жақсы көреді және әрқашан көп жұмыс істейді➡
Dialogue: 0,0:12:23.56,0:12:26.60,Default,,0,0,0,,Ам байыпты және ебедейсіз➡
Dialogue: 0,0:12:26.60,0:12:30.40,Default,,0,0,0,,Маған Лунаның сезіміне шыншыл болу қиын...
Dialogue: 0,0:12:32.45,0:12:35.94,Default,,0,0,0,,Кешіріңіз, мен әлі де сене алар емеспін.
Dialogue: 0,0:12:35.94,0:12:38.73,Default,,0,0,0,,Егер Ам шынымен Миджиннің артынан жүрсе➡
Dialogue: 0,0:12:38.73,0:12:41.61,Default,,0,0,0,,Менің ойымша, бірдеңе дұрыс емес.
Dialogue: 0,0:12:41.61,0:12:44.17,Default,,0,0,0,,Мүмкін солай.
Dialogue: 0,0:12:44.17,0:12:47.10,Default,,0,0,0,,Олай болса... Білгім келеді
Dialogue: 0,0:12:47.10,0:12:49.79,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:12:49.79,0:12:53.29,Default,,0,0,0,,Егер Амдар азап шегіп жатса...
Dialogue: 0,0:12:55.28,0:12:59.43,Default,,0,0,0,,Егер Токоха солай деп есептесе, менің ойымша, бұл дұрыс жауап шығар.
Dialogue: 0,0:12:59.43,0:13:03.32,Default,,0,0,0,,Барлығымыздың өз себептеріміз бар.
Dialogue: 0,0:13:03.32,0:13:06.42,Default,,0,0,0,,Бұл енді сіздің проблемаңыз емес, Хроно.
Dialogue: 0,0:13:11.59,0:13:13.69,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:16.97,0:13:20.10,Default,,0,0,0,,Куроно тартып жатыр! сурет? Шынымен!?
Dialogue: 0,0:13:20.10,0:13:22.92,Default,,0,0,0,,Мен не істеуім керек!? Тездетіп, тартыңыз!
Dialogue: 0,0:13:22.92,0:13:26.11,Default,,0,0,0,,Жоқ, күтіңіз, балықтың қозғалысын елестетіңіз.
Dialogue: 0,0:13:26.11,0:13:28.74,Default,,0,0,0,,Қайсысы? Тағы біртүрлі нәрсе
Dialogue: 0,0:13:28.74,0:13:31.08,Default,,0,0,0,,Бұл бірінші рет емес, солай ма?
Dialogue: 0,0:13:31.08,0:13:33.25,Default,,0,0,0,,Өзіңіз ойланыңыз!
Dialogue: 0,0:13:33.25,0:13:35.23,Default,,0,0,0,,Тіпті сен де сондайсың!
Dialogue: 0,0:13:35.23,0:13:37.27,Default,,0,0,0,,Балықтың қозғалысын елестету.
Dialogue: 0,0:13:37.27,0:13:40.57,Default,,0,0,0,,Жоқ, бұл дұрыс. Өйткені сіз бұрын үлкен мәселе болдыңыз ...
Dialogue: 0,0:13:40.57,0:13:43.32,Default,,0,0,0,,Куроно біраз... Сен!
Dialogue: 0,0:13:43.32,0:13:45.32,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:15:28.28,0:15:31.93,Default,,0,0,0,,Қадам күшін өзгерту жылдамдығы 92 пайыз
Dialogue: 0,0:15:31.93,0:15:34.44,Default,,0,0,0,,Бұл шек шығар.
Dialogue: 0,0:15:34.44,0:15:38.26,Default,,0,0,0,,Бұл деңгейде практикалық мәселе жоқ.
Dialogue: 0,0:15:38.26,0:15:41.46,Default,,0,0,0,,Мәселе тасымалдау жылдамдығында...
Dialogue: 0,0:15:41.46,0:15:44.33,Default,,0,0,0,,Қазіргі уақытта мақсатты мән сәл ғана төмендеді.
Dialogue: 0,0:15:44.33,0:15:48.27,Default,,0,0,0,,Тосқауылдың болжамды бұзылуынан негізді анықтауға дейін➡
Dialogue: 0,0:15:48.27,0:15:51.44,Default,,0,0,0,,Біріншіден, сіз оны міндетті түрде тазалай аласыз деп ойлаймын...
Dialogue: 0,0:15:51.44,0:15:54.49,Default,,0,0,0,,Шамамен сол уақытта, Миджиннің жағы →
Dialogue: 0,0:15:54.49,0:15:56.99,Default,,0,0,0,,Соңғы бөлімді шақыруды аяқтаңыз
Dialogue: 0,0:15:59.28,0:16:01.28,Default,,0,0,0,,Кешіріңіз, мен сізді алаңдатамын.
Dialogue: 0,0:16:01.28,0:16:03.23,Default,,0,0,0,,ｸﾘｽﾄﾌｧｰ･ﾛｳ!?
Dialogue: 0,0:16:03.23,0:16:05.45,Default,,0,0,0,,Сіздің Жапонияға келе жатқаныңызды естідім...
Dialogue: 0,0:16:05.45,0:16:08.82,Default,,0,0,0,,Неге мұндасың? Толық мәліметтер кейінірек
Dialogue: 0,0:16:08.82,0:16:10.86,Default,,0,0,0,,Маған сәл тиіп көрейін.
Dialogue: 0,0:16:10.86,0:16:13.44,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:16:13.44,0:16:16.23,Default,,0,0,0,,Хмм, сіз керемет жұмыс жасадыңыз, солай емес пе?
Dialogue: 0,0:16:16.23,0:16:18.78,Default,,0,0,0,,Мен сізге өту балын бере аламын ба?
Dialogue: 0,0:16:18.78,0:16:21.95,Default,,0,0,0,,Бірақ бұл тасымалдау жылдамдығымен.
Dialogue: 0,0:16:21.95,0:16:25.60,Default,,0,0,0,,Сіз және сіздің достарыңыз Миоджин базасын тарылтып жатқанда➡
Dialogue: 0,0:16:25.60,0:16:27.96,Default,,0,0,0,,Миоджин жиналған Қадам күшін➡ пайдаланады
Dialogue: 0,0:16:27.96,0:16:30.66,Default,,0,0,0,,Соңғы бөлімді сәтті шақырады.
Dialogue: 0,0:16:30.66,0:16:32.66,Default,,0,0,0,,(Қате дыбысы)
Dialogue: 0,0:16:34.58,0:16:37.63,Default,,0,0,0,,Мен оны жаңартамын. Бір минут күтіңіз!
Dialogue: 0,0:16:37.63,0:16:42.60,Default,,0,0,0,,Бұл данышпанға қалдырыңыз, Кристофер Лоу.
Dialogue: 0,0:16:42.60,0:16:45.11,Default,,0,0,0,,Қалағаныңды істе!
Dialogue: 0,0:16:45.11,0:16:49.11,Default,,0,0,0,,Тоқта, Асака, бұл...
Dialogue: 0,0:16:49.11,0:16:52.91,Default,,0,0,0,,Әрине, бұл шабуыл бірнеше есе күштірек болар еді...
Dialogue: 0,0:16:52.91,0:16:56.12,Default,,0,0,0,,Жоқ, бұл ондаған есе жылдам.
Dialogue: 0,0:16:56.12,0:16:59.50,Default,,0,0,0,,Мен мұны сендерге қалдыра алмаймын.
Dialogue: 0,0:16:59.50,0:17:01.91,Default,,0,0,0,,Менде де болады.
Dialogue: 0,0:17:01.91,0:17:04.44,Default,,0,0,0,,Жарайды ма? Кейбір жағдайларда ➡
Dialogue: 0,0:17:04.44,0:17:07.63,Default,,0,0,0,,Кеңейтім қауымдастығындағы позиция ғана емес➡
Dialogue: 0,0:17:07.63,0:17:10.23,Default,,0,0,0,,Сіз жеке қауіпке дайын болуыңыз керек.
Dialogue: 0,0:17:10.23,0:17:12.63,Default,,0,0,0,,Сізді бұған дейін қорқытқан.
Dialogue: 0,0:17:12.63,0:17:15.43,Default,,0,0,0,,Сіз таңқаларлық уайымшыл адамсыз.
Dialogue: 0,0:17:18.96,0:17:22.93,Default,,0,0,0,,Промоутер қауымдастығында біз бұл туралы білмесек те➡
Dialogue: 0,0:17:22.93,0:17:25.90,Default,,0,0,0,,Миджиннің амбицияларына қатысы бар болғаны үшін жауапты
Dialogue: 0,0:17:25.90,0:17:27.97,Default,,0,0,0,,Қауіпке қарамастан➡
Dialogue: 0,0:17:27.97,0:17:30.77,Default,,0,0,0,,Біз онымен күресуіміз керек.
Dialogue: 0,0:17:32.74,0:17:34.77,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:34.77,0:17:37.23,Default,,0,0,0,,Мен сенімен төбелесуді ойлайтынмын.
Dialogue: 0,0:17:37.23,0:17:40.28,Default,,0,0,0,,Сіз Vanguard➡ туралы қаншалықты маңызды болсаңыз
Dialogue: 0,0:17:40.28,0:17:43.60,Default,,0,0,0,,Ешкім өз өмірін қатерге тікпейді.
Dialogue: 0,0:17:43.60,0:17:46.00,Default,,0,0,0,,Бұл оқиға болды.
Dialogue: 0,0:17:46.00,0:17:49.30,Default,,0,0,0,,Сіз тым көп сатып алдыңыз. Маған солай көрінеді.
Dialogue: 0,0:18:04.59,0:18:08.97,Default,,0,0,0,,《Соңғы кезеңнің күні соңғы бөлімше шақырылады.
Dialogue: 0,0:18:08.97,0:18:12.16,Default,,0,0,0,,Барлығы дайын
Dialogue: 0,0:18:12.16,0:18:14.66,Default,,0,0,0,,Менен басқа барлық дайындықтар...》
Dialogue: 0,0:18:19.95,0:18:21.95,Default,,0,0,0,,《Сіз бас тартасыз ба?
Dialogue: 0,0:18:21.95,0:18:24.34,Default,,0,0,0,,Мен оны міндетті түрде орындаймын
Dialogue: 0,0:18:24.34,0:18:26.44,Default,,0,0,0,,Менің тілегім》
Dialogue: 0,0:18:26.44,0:18:29.61,Default,,0,0,0,,ｱﾑ！
Dialogue: 0,0:18:29.61,0:18:35.25,Default,,0,0,0,,Ән айтып, билей алатын жанды айқай!
Dialogue: 0,0:18:35.25,0:18:38.67,Default,,0,0,0,,О, сен оны алып тастадың!? Ал...
Dialogue: 0,0:18:38.67,0:18:41.76,Default,,0,0,0,,Рик елес. Эххе
Dialogue: 0,0:18:41.76,0:18:44.44,Default,,0,0,0,,Хехе... Лунатара
Dialogue: 0,0:18:44.44,0:18:46.44,Default,,0,0,0,,Әй, солай ма?
Dialogue: 0,0:18:46.44,0:18:49.44,Default,,0,0,0,,Рахмет. Хехе
Dialogue: 0,0:18:54.62,0:18:57.09,Default,,0,0,0,,Икчибан! (Шион) Менің ойымша, бұл осындай нәрсе.
Dialogue: 0,0:18:57.09,0:18:59.11,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:59.11,0:19:01.11,Default,,0,0,0,,Келген адамдар көп болды➡
Dialogue: 0,0:19:01.11,0:19:03.44,Default,,0,0,0,,Ешқандай балық ауламау да талант.
Dialogue: 0,0:19:03.44,0:19:06.56,Default,,0,0,0,,Шулы. Бұл жай ғана болды. Бұл жай ғана болды.
Dialogue: 0,0:19:06.56,0:19:10.08,Default,,0,0,0,,Бұл үш адамды тамақтандыруға жетеді.
Dialogue: 0,0:19:10.08,0:19:12.49,Default,,0,0,0,,Куфуфу｡ Бұл қуырылған тауық, солай ма?➡
Dialogue: 0,0:19:12.49,0:19:15.46,Default,,0,0,0,,Қайнаған, солай ма? Муниер де жақсы.
Dialogue: 0,0:19:15.46,0:19:19.11,Default,,0,0,0,,Айтпақшы, балалар сендер балықты ұстайсыңдар ма?
Dialogue: 0,0:19:19.11,0:19:21.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:21.11,0:19:24.28,Default,,0,0,0,,О! Күткендей
Dialogue: 0,0:19:24.28,0:19:27.17,Default,,0,0,0,,Негіздерді есте сақтағанша, маңызды емес.
Dialogue: 0,0:19:27.17,0:19:29.17,Default,,0,0,0,,Келіңіздер, көріңіздер.
Dialogue: 0,0:19:31.44,0:19:33.89,Default,,0,0,0,,Мен... Күрішті қайраймын.
Dialogue: 0,0:19:33.89,0:19:35.94,Default,,0,0,0,,Мен мұны жақсы білемін!
Dialogue: 0,0:19:35.94,0:19:49.94,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:49.94,0:19:51.94,Default,,0,0,0,,Итадакимасу!
Dialogue: 0,0:19:57.78,0:20:01.69,Default,,0,0,0,,Авангардқа ұшатын аспанның қасиетті рыцарь Альтомильмен шабуыл жасаңыз
Dialogue: 0,0:20:01.69,0:20:04.41,Default,,0,0,0,,Құмарлық гүлі бар толық күзетші
Dialogue: 0,0:20:04.41,0:20:07.43,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:20:07.43,0:20:09.66,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:20:09.66,0:20:11.76,Default,,0,0,0,,Барлық әсерлер егіз қылышқа беріледі
Dialogue: 0,0:20:13.78,0:20:16.13,Default,,0,0,0,,Авангардқа қос семсермен шабуыл жасаңыз
Dialogue: 0,0:20:16.13,0:20:19.94,Default,,0,0,0,,Димолфорс пен Майрис қызымен күзетші
Dialogue: 0,0:20:19.94,0:20:23.12,Default,,0,0,0,,Сүлейменмен бірге Риа гвардиясына шабуыл жасаңыз
Dialogue: 0,0:20:23.12,0:20:25.08,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:20:25.08,0:20:28.60,Default,,0,0,0,,《Жақсы. Осы айналымда бір ұпай алдым➡
Dialogue: 0,0:20:28.60,0:20:30.90,Default,,0,0,0,,Шион жеңе алмайды.
Dialogue: 0,0:20:30.90,0:20:35.30,Default,,0,0,0,,Осы жерден Токоха келесі бұрылыста Counter Blast қолданбасын пайдалана алмайды➡
Dialogue: 0,0:20:35.30,0:20:38.09,Default,,0,0,0,,Мен ешқандай зиян келтіруге батылым бармадым》
Dialogue: 0,0:20:38.09,0:20:40.96,Default,,0,0,0,,ｽﾀﾝﾄﾞ ｱﾝﾄﾞ ﾄﾞﾛｰ
Dialogue: 0,0:20:40.96,0:20:44.61,Default,,0,0,0,,Айтпақшы, ертең менің қарсыласым кім болады екен.
Dialogue: 0,0:20:44.61,0:20:47.26,Default,,0,0,0,,Ақырында олар маған айтпады.
Dialogue: 0,0:20:47.26,0:20:49.67,Default,,0,0,0,,Өйткені бұл арман командасы.
Dialogue: 0,0:20:49.67,0:20:53.27,Default,,0,0,0,,Қалыпты жиналмайтын мүшелер келуі мүмкін.
Dialogue: 0,0:20:55.27,0:20:58.29,Default,,0,0,0,,Қарсылас кім болса да➡
Dialogue: 0,0:20:58.29,0:21:00.58,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:21:00.58,0:21:02.90,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:21:02.90,0:21:05.62,Default,,0,0,0,,Осыған дайындалдым
Dialogue: 0,0:21:05.62,0:21:09.75,Default,,0,0,0,,Біздің G Quest-ті толық жеңіспен аяқтаңыз
Dialogue: 0,0:21:09.75,0:21:14.35,Default,,0,0,0,,Бұл бізді ақиқатқа апаратын жол екені сөзсіз!
Dialogue: 0,0:21:21.78,0:21:25.07,Default,,0,0,0,,Иә! Міне, үшеуін көріңіз
Dialogue: 0,0:21:25.07,0:21:27.10,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:21:27.10,0:21:29.24,Default,,0,0,0,,Мен сені қолдауға келдім.
Dialogue: 0,0:21:29.24,0:21:32.78,Default,,0,0,0,,Иә, Токоха-чан, уәде бер.
Dialogue: 0,0:21:32.78,0:21:35.25,Default,,0,0,0,,Уау, рахмет саған, Куми-чан
Dialogue: 0,0:21:35.25,0:21:37.45,Default,,0,0,0,,Біз кез келген мүмкіндікпен күресеміз➡
Dialogue: 0,0:21:37.45,0:21:41.44,Default,,0,0,0,,Үшеуміз команданың атын да шеше алмадық...
Dialogue: 0,0:21:41.44,0:21:43.44,Default,,0,0,0,,Куу~
Dialogue: 0,0:21:43.44,0:21:46.54,Default,,0,0,0,,Тыңдаңыз! Ешқандай ұят ұрыс жасамаңыз!
Dialogue: 0,0:21:48.66,0:21:50.66,Default,,0,0,0,,Бұл өте күлкілі!
Dialogue: 0,0:21:52.73,0:21:56.45,Default,,0,0,0,,Авангардты барлық ұрпаққа сүйемін➡
Dialogue: 0,0:21:56.45,0:22:02.96,Default,,0,0,0,,Армандардың соңғы кезеңі қазір ұсынылды!
Dialogue: 0,0:22:02.96,0:22:06.96,Default,,0,0,0,,Әрине, бұл тамаша бастама болады!
Dialogue: 0,0:22:06.96,0:22:10.01,Default,,0,0,0,,Бұл Лами лабиринт!
Dialogue: 0,0:22:10.01,0:22:12.98,Default,,0,0,0,,Луна-чан! (Кай) Ам-чан!
Dialogue: 0,0:22:12.98,0:22:33.78,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:41.25,0:22:43.28,Default,,0,0,0,,Бұлай келгені дұрыс па?
Dialogue: 0,0:22:43.28,0:22:45.28,Default,,0,0,0,,Жақында басталады, солай ма?
Dialogue: 0,0:22:45.28,0:22:49.95,Default,,0,0,0,,Мен дайынмын. Маған сенің айтуың керек емес.
Dialogue: 0,0:22:49.95,0:22:52.99,Default,,0,0,0,,(Юки) Қыз ба? (Миямура) Ұл ба?
Dialogue: 0,0:22:52.99,0:22:54.99,Default,,0,0,0,,Мен де солай ойладым, бірақ бұл шешімді талқылаудың қажеті жоқ
Dialogue: 0,0:23:01.25,0:23:03.25,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:23:06.45,0:23:08.41,Default,,0,0,0,,ｼｽﾃﾑ ｵｰﾙｸﾞﾘｰﾝ
Dialogue: 0,0:23:08.41,0:23:11.88,Default,,0,0,0,,Беріліс дағдарысы басталды!
Dialogue: 0,0:23:11.88,0:23:17.78,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:17.78,0:23:20.75,Default,,0,0,0,,[ｽﾋﾟｰｶ]ｽﾄﾗｲﾄﾞﾌｫｰｽ ｲﾝｼﾞｪｸｼｮﾝ
Dialogue: 0,0:23:20.75,0:23:23.59,Default,,0,0,0,,[ｽﾋﾟｰｶ]ﾋﾞﾙﾄﾞｱｯﾌﾟ ｽﾋﾟｰﾄﾞ
Dialogue: 0,0:23:23.59,0:23:27.46,Default,,0,0,0,,[ｽﾋﾟｰｶ]６… 6.7… ７…
Dialogue: 0,0:23:27.46,0:23:32.56,Default,,0,0,0,,[ｽﾋﾟｰｶ]7.2… 7.8… ８… 8.8…
Dialogue: 0,0:23:32.56,0:23:35.40,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:23:35.40,0:23:43.57,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:43.57,0:23:49.61,Default,,0,0,0,,Хехе... Барлығы осыдан басталады
Dialogue: 0,0:23:49.61,0:23:51.75,Default,,0,0,0,,Жаңа әлем...
Dialogue: 0,0:23:51.75,0:23:57.85,Default,,0,0,0,,Авангард басқаратын кемелді болашақ осында
Dialogue: 0,0:23:59.94,0:24:03.83,Default,,0,0,0,,Неге түсінбедің?
Dialogue: 0,0:24:03.83,0:24:05.93,Default,,0,0,0,,ﾗｲﾌﾞ…
Dialogue: 0,0:24:09.45,0:24:11.74,Default,,0,0,0,,Кешіріңіз, мен шетелде оқып жүрген едім.
Dialogue: 0,0:24:11.74,0:24:15.24,Default,,0,0,0,,Ақырында мен шетелдегі мәселелерді өзіме қалдырдым.
Dialogue: 0,0:24:15.24,0:24:17.44,Default,,0,0,0,,[TEL] (Айчи) Бұл Авангардқа арналған.
Dialogue: 0,0:24:17.44,0:24:19.81,Default,,0,0,0,,Барлық сұрақтар шешілді.
Dialogue: 0,0:24:19.81,0:24:24.62,Default,,0,0,0,,Енді маған рұқсат берсеңіз, барлығын бірден бастаймыз.
Dialogue: 0,0:24:24.62,0:24:26.57,Default,,0,0,0,,Мен де жалғыз емеспін.
Dialogue: 0,0:24:26.57,0:24:29.82,Default,,0,0,0,,Біз мұны істей алдық, өйткені барлығы ынтымақтасады.
Dialogue: 0,0:24:29.82,0:24:32.62,Default,,0,0,0,,Кешіріңіз Рахмет
Dialogue: 0,0:24:35.91,0:24:39.86,Default,,0,0,0,,《Ибуки: Дүние жүзіндегі жауынгерлерден шығатын бейненің күші
Dialogue: 0,0:24:39.86,0:24:43.78,Default,,0,0,0,,Оны Фика➡ арқылы қадамдық күшке айналдырады
Dialogue: 0,0:24:43.78,0:24:49.57,Default,,0,0,0,,Gears арқылы әлемді шарлауды жалғастыру
Dialogue: 0,0:24:49.57,0:24:53.46,Default,,0,0,0,,Беріліс жүйесі тәулігіне 24 сағат жұмыс істейді➡
Dialogue: 0,0:24:53.46,0:24:56.06,Default,,0,0,0,,Тоқтатылмаған》
Dialogue: 0,0:24:56.06,0:24:59.12,Default,,0,0,0,,《Мамору: Басқару жүйесі Миджин➡ бақылауында
Dialogue: 0,0:24:59.12,0:25:01.64,Default,,0,0,0,,Мен оған қол тигізе алмадым.
Dialogue: 0,0:25:01.64,0:25:06.07,Default,,0,0,0,,《Кристофер: Сондықтан біз Gears-ты жоюды шештік》
Dialogue: 0,0:25:06.07,0:25:10.63,Default,,0,0,0,,《Тетсу: қалыпты жағдайда мүмкін емес қадам күшінің үлкен мөлшерін біріктіреді➡
Dialogue: 0,0:25:10.63,0:25:14.40,Default,,0,0,0,,Оны күшейтіп, бірден Gears-қа құйыңыз》
Dialogue: 0,0:25:14.40,0:25:16.62,Default,,0,0,0,,《Асака: шамадан тыс жүктелу салдарынан берілістер істен шықты➡
Dialogue: 0,0:25:16.62,0:25:19.45,Default,,0,0,0,,Толық тоқтаған кезде》
Dialogue: 0,0:25:19.45,0:25:25.08,Default,,0,0,0,,《Ибуки: Шақырылған бірліктердің қадам күшін ғана байқауға болады.
Dialogue: 0,0:25:25.08,0:25:29.65,Default,,0,0,0,,Бұл Миджин Роузының негізі》
Dialogue: 0,0:25:29.65,0:25:59.31,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:59.31,0:26:01.31,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:27:35.91,0:27:42.95,Default,,0,0,0,,Олар G Quest-те толық жеңіске жеткен команда.
Dialogue: 0,0:27:42.95,0:27:46.25,Default,,0,0,0,,Сізге қарсы көптеген жекпе-жектерден өтіңіз➡
Dialogue: 0,0:27:46.25,0:27:49.95,Default,,0,0,0,,Аңыз атына лайық күші бар жауынгерлер
Dialogue: 0,0:27:49.95,0:27:53.34,Default,,0,0,0,,ﾁｰﾑ･ｸｱﾄﾞﾘﾌｫﾘｵ！
Dialogue: 0,0:27:53.34,0:27:55.39,Default,,0,0,0,,ﾁｰﾑＱ４！
Dialogue: 0,0:27:55.39,0:27:57.39,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:30:34.30,0:30:36.80,Default,,0,0,0,,Бұл уақыттың «сезімі» →
Dialogue: 0,0:30:42.81,0:30:46.43,Default,,0,0,0,,...Әр компанияның әдемі қызметкерлеріне →
Dialogue: 0,0:30:46.43,0:30:50.27,Default,,0,0,0,,Маған №1 түскі ас туралы айтты.
Dialogue: 0,0:30:50.27,0:30:53.77,Default,,0,0,0,,Тек әйелдер біле алады →
Dialogue: 0,0:30:56.81,0:31:01.81,Default,,0,0,0,,Мұны көргеннен кейін түскі асқа шыққыңыз келетіні сөзсіз.
Dialogue: 0,0:31:03.31,0:31:09.31,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory