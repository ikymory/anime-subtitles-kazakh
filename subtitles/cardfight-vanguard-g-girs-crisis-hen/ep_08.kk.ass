Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:11.12,0:01:13.72,Default,,0,0,0,,≪Ахахаха. ≪Мен жеңілдім!
Dialogue: 0,0:01:26.60,0:01:28.79,Default,,0,0,0,,ﾌﾝ！
Dialogue: 0,0:01:28.79,0:01:31.29,Default,,0,0,0,,Сіз Эйс есімді адамды білесіз бе?
Dialogue: 0,0:01:33.22,0:01:37.10,Default,,0,0,0,,Эйс? Мен білмеймін
Dialogue: 0,0:01:37.10,0:01:40.06,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:01:40.06,0:01:43.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:43.13,0:01:46.13,Default,,0,0,0,,Эй, жоқ рахмет?
Dialogue: 0,0:01:48.09,0:01:51.18,Default,,0,0,0,,Бұл біздің қанды періште Шима.
Dialogue: 0,0:01:51.18,0:01:53.98,Default,,0,0,0,,Мен сені үйге жібере алмаймын.
Dialogue: 0,0:01:55.90,0:01:58.62,Default,,0,0,0,,Сонымен? Бұл жаман идея
Dialogue: 0,0:01:58.62,0:02:01.74,Default,,0,0,0,,Не төлесең, соны төлейсің.
Dialogue: 0,0:02:01.74,0:02:04.27,Default,,0,0,0,,Егер мен оны ұнатпаймын десем ше?
Dialogue: 0,0:02:04.27,0:02:09.28,Default,,0,0,0,,Хе, бұл жай ғана ауырады.
Dialogue: 0,0:02:09.28,0:02:12.90,Default,,0,0,0,,♬~
Dialogue: 0,0:02:12.90,0:02:15.97,Default,,0,0,0,,Сәлем! Бұл жігіт!
Dialogue: 0,0:02:15.97,0:02:18.27,Default,,0,0,0,,Ей! Теме!
Dialogue: 0,0:02:22.41,0:02:25.91,Default,,0,0,0,,Кусога! Эй!
Dialogue: 0,0:02:33.28,0:02:36.19,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:02:36.19,0:02:39.29,Default,,0,0,0,,Күте тұрыңыз! Ол біздің теңіміз емес.
Dialogue: 0,0:02:42.83,0:02:45.13,Default,,0,0,0,,Мен сенен бір нәрсе істегеніңді қалаймын.
Dialogue: 0,0:06:09.13,0:06:11.13,Default,,0,0,0,,ｼｵﾝ
Dialogue: 0,0:06:13.10,0:06:15.11,Default,,0,0,0,,Мен ағамнан естідім➡
Dialogue: 0,0:06:15.11,0:06:19.24,Default,,0,0,0,,Сізді ұнатпайтын сияқты адамдармен аралассаңыз да...
Dialogue: 0,0:06:19.24,0:06:21.28,Default,,0,0,0,,О, бұл туралы.
Dialogue: 0,0:06:21.28,0:06:23.91,Default,,0,0,0,,Жарайды, проблема жоқ.
Dialogue: 0,0:06:23.91,0:06:25.95,Default,,0,0,0,,Бірақ күндіз мектеп➡
Dialogue: 0,0:06:25.95,0:06:29.60,Default,,0,0,0,,Мен түнде Эйс деген жігіт туралы ақпарат іздеймін.
Dialogue: 0,0:06:29.60,0:06:31.56,Default,,0,0,0,,Сіз дұрыс демалып жатырсыз ба?
Dialogue: 0,0:06:31.56,0:06:33.77,Default,,0,0,0,,Біз ештеңе істей алмаймыз ...
Dialogue: 0,0:06:33.77,0:06:35.93,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:35.93,0:06:40.53,Default,,0,0,0,,Бірақ бұл мен шешуім керек мәселе.
Dialogue: 0,0:06:44.90,0:06:48.11,Default,,0,0,0,,Біздің осында екенімізді ұмытпаңыз
Dialogue: 0,0:06:48.11,0:06:51.11,Default,,0,0,0,,О
Dialogue: 0,0:06:53.11,0:06:55.78,Default,,0,0,0,,Сен өзгердің, Шион.
Dialogue: 0,0:06:55.78,0:06:58.17,Default,,0,0,0,,Достық сияқты негізгі нәрселер ➡
Dialogue: 0,0:06:58.17,0:07:00.12,Default,,0,0,0,,Өзгермесе де...
Dialogue: 0,0:07:00.12,0:07:03.72,Default,,0,0,0,,Оған жақындау қиын.
Dialogue: 0,0:07:11.95,0:07:15.32,Default,,0,0,0,,Бұл керемет, оны ешкім жеңе алмайды.
Dialogue: 0,0:07:15.32,0:07:17.75,Default,,0,0,0,,Мен мұнда басқа дүкеннен арнайы дайындыққа келдім➡
Dialogue: 0,0:07:17.75,0:07:19.82,Default,,0,0,0,,Тым күшті емес пе?
Dialogue: 0,0:07:19.82,0:07:24.32,Default,,0,0,0,,Chrono Dragon Nexus сахнасында Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:07:27.43,0:07:30.15,Default,,0,0,0,,Ух... бұл менің жоғалтым.
Dialogue: 0,0:07:30.15,0:07:32.15,Default,,0,0,0,,Сіздің келесі қарсыласыңыз кім?
Dialogue: 0,0:07:34.09,0:07:37.15,Default,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:07:37.15,0:07:39.25,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:07:45.75,0:07:51.05,Default,,0,0,0,,((Бұл мен елестеткен жаңа мен!
Dialogue: 0,0:07:54.46,0:07:58.46,Default,,0,0,0,,♬~
Dialogue: 0,0:08:04.93,0:08:07.94,Default,,0,0,0,,Мен жеңдім))
Dialogue: 0,0:08:07.94,0:08:20.77,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:20.77,0:08:24.80,Default,,0,0,0,,《Шион өзі жүруі керек жолды анық көреді.
Dialogue: 0,0:08:24.80,0:08:27.10,Default,,0,0,0,,Бұл қазір менде жоқ күш.
Dialogue: 0,0:08:32.58,0:08:38.00,Default,,0,0,0,,《Мен сені кездестіргенде бірдеңе басталды.
Dialogue: 0,0:08:38.00,0:08:41.09,Default,,0,0,0,,Бір нәрсе қозғала бастады...
Dialogue: 0,0:08:41.09,0:08:44.42,Default,,0,0,0,,Солай болды
Dialogue: 0,0:08:44.42,0:08:46.62,Default,,0,0,0,,Егер бұл кездесу →
Dialogue: 0,0:08:46.62,0:08:49.72,Default,,0,0,0,,Егер бұл өсудің дәлелі болса...》
Dialogue: 0,0:08:53.23,0:08:57.64,Default,,0,0,0,,《Одан кейін басқа тәуелді карталарды сол күйінде қалдырыңыз...
Dialogue: 0,0:08:57.64,0:09:00.92,Default,,0,0,0,,Мен өскен жоқпын ба?
Dialogue: 0,0:09:00.92,0:09:05.02,Default,,0,0,0,,Неліктен Ибуки маған Gear хроникасын берді...?
Dialogue: 0,0:09:08.28,0:09:10.73,Default,,0,0,0,,《Мен білмеймін...》
Dialogue: 0,0:09:10.73,0:09:17.24,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:17.24,0:09:19.42,Default,,0,0,0,,《Мектептен кейін→
Dialogue: 0,0:09:19.42,0:09:22.73,Default,,0,0,0,,Шион Эйс➡ туралы ақпарат іздеп жүр
Dialogue: 0,0:09:22.73,0:09:25.15,Default,,0,0,0,,Куроно басқа дүкендерге барады →
Dialogue: 0,0:09:25.15,0:09:27.75,Default,,0,0,0,,Мен арнайы дайындыққа бардым...》
Dialogue: 0,0:09:33.15,0:09:35.65,Default,,0,0,0,,《Мен өзімді артта қалғандай сезінемін...》
Dialogue: 0,0:09:37.61,0:09:39.78,Default,,0,0,0,,《Мен де, G Quest-ке қарай→
Dialogue: 0,0:09:39.78,0:09:42.95,Default,,0,0,0,,Менің ойымша, мен бірдеңе істеуім керек ...
Dialogue: 0,0:09:42.95,0:09:46.83,Default,,0,0,0,,Бірақ... не істеуім керек?
Dialogue: 0,0:09:46.83,0:09:50.44,Default,,0,0,0,,Шион Киба отбасын қалпына келтірумен алға ұмтылуда.
Dialogue: 0,0:09:50.44,0:09:53.24,Default,,0,0,0,,Еш ойланбастан тура алға...
Dialogue: 0,0:09:53.24,0:09:57.50,Default,,0,0,0,,Куроно G Quest-те жеңіске жету үшін көп жұмыс істеуде
Dialogue: 0,0:09:57.50,0:10:01.10,Default,,0,0,0,,Себебі мен жеңуден басқа бірдеңе көретініме сенімдімін.
Dialogue: 0,0:10:03.58,0:10:06.57,Default,,0,0,0,,Сонда мен ше?
Dialogue: 0,0:10:06.57,0:10:09.11,Default,,0,0,0,,Мен?
Dialogue: 0,0:10:09.11,0:10:11.89,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:11.89,0:10:16.11,Default,,0,0,0,,Маған Vanguard ұнайды және оны мәңгі ойнауды жалғастырғым келеді.
Dialogue: 0,0:10:16.11,0:10:18.07,Default,,0,0,0,,Бірақ менің ағам сияқты→
Dialogue: 0,0:10:18.07,0:10:20.40,Default,,0,0,0,,Мен промоутерлік қауымдастықта жұмыс істегім келмейді.
Dialogue: 0,0:10:20.40,0:10:23.45,Default,,0,0,0,,Ағамның жолы бір бөлек...
Dialogue: 0,0:10:23.45,0:10:25.41,Default,,0,0,0,,Қалай болғанда да➡
Dialogue: 0,0:10:25.41,0:10:27.61,Default,,0,0,0,,Мен туралы ешкім білмейтін шетелде!
Dialogue: 0,0:10:27.61,0:10:30.46,Default,,0,0,0,,Мен сонда күшімді сынап көргім келеді.
Dialogue: 0,0:10:30.46,0:10:33.65,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:10:33.65,0:10:35.95,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:10:38.65,0:10:41.25,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:10:47.91,0:10:50.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:50.26,0:10:54.45,Default,,0,0,0,,Не болып жатыр! Әлі қабылдау?
Dialogue: 0,0:10:54.45,0:10:58.56,Default,,0,0,0,,《Түсіндім! Бүгін дүкен турнирі.
Dialogue: 0,0:10:58.56,0:11:02.43,Default,,0,0,0,,Бірақ бір қызық бұл жерде адам көп...》
Dialogue: 0,0:11:02.43,0:11:06.08,Default,,0,0,0,,Кешіріңіз, мен өтіп кетемін...
Dialogue: 0,0:11:06.08,0:11:08.07,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:11:08.07,0:11:10.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.07,0:11:12.29,Default,,0,0,0,,Осы қабылдау парағына қажетті ақпаратты толтырыңыз... (Токоха) Мисаки-сан!
Dialogue: 0,0:11:12.29,0:11:14.27,Default,,0,0,0,,Ах... Токоха-чан
Dialogue: 0,0:11:14.27,0:11:16.76,Default,,0,0,0,,Кешіріңіз, маған да беріңізші!
Dialogue: 0,0:11:16.76,0:11:18.76,Default,,0,0,0,,Иә, дәл қазір
Dialogue: 0,0:11:21.30,0:11:23.33,Default,,0,0,0,,ﾊｲﾊｰｲ！
Dialogue: 0,0:11:23.33,0:11:26.07,Default,,0,0,0,,Барлығы дұрыс қатыса алады➡
Dialogue: 0,0:11:26.07,0:11:28.05,Default,,0,0,0,,Тынышталыңыз!
Dialogue: 0,0:11:28.05,0:11:31.47,Default,,0,0,0,,Келу ретімен сапқа тұрыңыз!
Dialogue: 0,0:11:31.47,0:11:33.96,Default,,0,0,0,,Біріншісі осында!!
Dialogue: 0,0:11:33.96,0:11:35.94,Default,,0,0,0,,Токоха-чан?
Dialogue: 0,0:11:35.94,0:11:37.94,Default,,0,0,0,,Мұны маған қалдырыңыз!
Dialogue: 0,0:11:40.10,0:12:17.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:17.90,0:12:20.15,Default,,0,0,0,,Ха~
Dialogue: 0,0:12:20.15,0:12:23.15,Default,,0,0,0,,Айтпақшы, бұл неліктен болып жатыр?
Dialogue: 0,0:12:25.08,0:12:27.11,Default,,0,0,0,,Шин мырзаның белі тарылып қалды.
Dialogue: 0,0:12:27.11,0:12:30.15,Default,,0,0,0,,Камуиде қызыл нүктелері бар мектептен кейінгі қосымша сабақтар бар
Dialogue: 0,0:12:30.15,0:12:33.77,Default,,0,0,0,,Сондай-ақ, Санва менеджерінің орынбасары да Yabo-да жұмыс істейді.➡
Dialogue: 0,0:12:33.77,0:12:37.44,Default,,0,0,0,,Бірінші дүкен де уақытша жабылды.
Dialogue: 0,0:12:37.44,0:12:40.91,Default,,0,0,0,,Сонымен, сол жерге қатысуы тиіс клиенттер де ➡
Dialogue: 0,0:12:40.91,0:12:43.61,Default,,0,0,0,,Сонымен, сіз осы екінші дүкенге келдіңіз бе?
Dialogue: 0,0:12:43.61,0:12:48.10,Default,,0,0,0,,Рахмет, Токоха-чан, бұл өте пайдалы болды.
Dialogue: 0,0:12:48.10,0:12:51.74,Default,,0,0,0,,Жоқ, мен сізге әрқашан қарыздармын.
Dialogue: 0,0:12:51.74,0:12:53.82,Default,,0,0,0,,Және...
Dialogue: 0,0:12:53.82,0:12:57.62,Default,,0,0,0,,Менің қолымнан келетіні осы
Dialogue: 0,0:13:00.41,0:13:03.61,Default,,0,0,0,,Куроно-кун мен Шион-кун ше?
Dialogue: 0,0:13:03.61,0:13:06.10,Default,,0,0,0,,А, жоқ, олай емес!
Dialogue: 0,0:13:06.10,0:13:08.10,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:10.65,0:13:13.15,Default,,0,0,0,,Ұрыспайсың ба?
Dialogue: 0,0:15:01.11,0:15:05.50,Default,,0,0,0,,Падминидің жарылған Вистерия рыцарымен ринг Мейгасқа шабуыл жасаңыз!
Dialogue: 0,0:15:05.50,0:15:07.49,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:15:07.49,0:15:09.49,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:15:13.26,0:15:15.90,Default,,0,0,0,,Иә, бұл менің қолымнан келеді ➡
Dialogue: 0,0:15:15.90,0:15:18.23,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:15:18.23,0:15:20.27,Default,,0,0,0,,Шион мен Куроно сияқты →
Dialogue: 0,0:15:20.27,0:15:22.64,Default,,0,0,0,,Менің мақсатым жоқ...
Dialogue: 0,0:15:22.64,0:15:25.74,Default,,0,0,0,,Себебі мен не істегім келетінін білмеймін
Dialogue: 0,0:15:27.76,0:15:31.26,Default,,0,0,0,,Сіз өзіңізді артта қалғандай сезінесіз бе? иә
Dialogue: 0,0:15:33.25,0:15:37.28,Default,,0,0,0,,Қараңызшы, бәрібір, бұл кішкентай нәрсе, солай ма?
Dialogue: 0,0:15:37.28,0:15:42.27,Default,,0,0,0,,Керемет, Мисаки-сан, сен әрқашан сабырлысың➡
Dialogue: 0,0:15:42.27,0:15:45.73,Default,,0,0,0,,Мен өз ісімде еш күмәнім жоқ сияқты сезінемін.
Dialogue: 0,0:15:45.73,0:15:48.95,Default,,0,0,0,,Мен де сондай болсам ғой.
Dialogue: 0,0:15:48.95,0:15:53.08,Default,,0,0,0,,Уфуфу Мен онша жақсы адам емеспін.
Dialogue: 0,0:15:53.08,0:15:55.10,Default,,0,0,0,,Және...
Dialogue: 0,0:15:55.10,0:15:59.62,Default,,0,0,0,,Мен бір кездері Токоха-чан сияқты сезімде болдым.
Dialogue: 0,0:15:59.62,0:16:02.22,Default,,0,0,0,,Не? Мисаки-сан да?
Dialogue: 0,0:16:15.44,0:16:19.44,Default,,0,0,0,,Мен екеуінің өз жолына қарай бет алғанын көрдім➡
Dialogue: 0,0:16:19.44,0:16:23.04,Default,,0,0,0,,Мен жалғыз қалғандай болдым.
Dialogue: 0,0:16:25.28,0:16:28.67,Default,,0,0,0,,Күн сайын университет пен дүкен арасында алға-артқа бару
Dialogue: 0,0:16:28.67,0:16:31.26,Default,,0,0,0,,Бірақ шетелге шығу➡
Dialogue: 0,0:16:31.26,0:16:35.56,Default,,0,0,0,,Маған кәсіби маман болу қызық емес.
Dialogue: 0,0:16:37.61,0:16:40.25,Default,,0,0,0,,Тек... солай ма?
Dialogue: 0,0:16:40.25,0:16:44.43,Default,,0,0,0,,Түсіндім, нысананы таба алмаймын.
Dialogue: 0,0:16:44.43,0:16:47.09,Default,,0,0,0,,Мен бірдеңе істеуім керек деп ойлаймын➡
