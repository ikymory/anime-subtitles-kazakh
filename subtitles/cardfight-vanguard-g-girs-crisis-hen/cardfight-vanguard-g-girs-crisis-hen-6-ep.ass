Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:07.10,0:01:09.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:19.13,0:01:21.43,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:04:52.42,0:04:54.52,Default,,0,0,0,,Оны бейнелеу
Dialogue: 0,0:04:59.08,0:05:01.08,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:05:01.08,0:05:03.12,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ！
Dialogue: 0,0:05:03.12,0:05:05.12,Default,,0,0,0,,... (Шион/Кай) Авангард!
Dialogue: 0,0:05:13.18,0:05:15.10,Default,,0,0,0,,ﾌｧｲﾅﾙﾀｰﾝ
Dialogue: 0,0:05:15.10,0:05:19.12,Default,,0,0,0,,Ақырзаманның жалыны бұл дүниедегінің бәрін жалмап кетеді.
Dialogue: 0,0:05:19.12,0:05:21.12,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:05:21.12,0:05:24.17,Default,,0,0,0,,ﾄﾞﾗｺﾞﾆｯｸ･ｵｰﾊﾞｰﾛｰﾄﾞ！
Dialogue: 0,0:05:24.17,0:05:26.17,Default,,0,0,0,,Уау!!
Dialogue: 0,0:05:29.74,0:05:31.75,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:05:31.75,0:05:34.62,Default,,0,0,0,,ЕуроЛиганың жоғары дәрежелі жауынгері күткендей
Dialogue: 0,0:05:34.62,0:05:36.73,Default,,0,0,0,,Кеудеңді қарызға алып, төбелесе алдым➡
Dialogue: 0,0:05:36.73,0:05:38.82,Default,,0,0,0,,Мен шынымен құрметтемін.
Dialogue: 0,0:05:38.82,0:05:40.82,Default,,0,0,0,,Бұл туралы ма?
Dialogue: 0,0:05:44.76,0:05:46.81,Default,,0,0,0,,Тағы да рахмет!
Dialogue: 0,0:05:46.81,0:05:48.85,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:05:48.85,0:05:51.15,Default,,0,0,0,,Соңымен шабуыл
Dialogue: 0,0:05:55.30,0:05:58.29,Default,,0,0,0,,Уау!!
Dialogue: 0,0:05:58.29,0:06:01.68,Default,,0,0,0,,(Сионның ыңырсыуы)
Dialogue: 0,0:06:01.68,0:06:03.68,Default,,0,0,0,,Тағы да рахмет!
Dialogue: 0,0:06:05.90,0:06:09.33,Default,,0,0,0,,Ұлымен шабуыл
Dialogue: 0,0:06:09.33,0:06:12.43,Default,,0,0,0,,Уау!!
Dialogue: 0,0:06:14.41,0:06:16.49,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:06:16.49,0:06:19.79,Default,,0,0,0,,Крестпен шабуыл!
Dialogue: 0,0:06:23.50,0:06:25.45,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:06:25.45,0:06:32.27,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:32.27,0:06:34.57,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ…
Dialogue: 0,0:06:44.95,0:06:47.96,Default,,0,0,0,,《Енді мен барлық 10 ойында жеңілдім...
Dialogue: 0,0:06:47.96,0:06:50.59,Default,,0,0,0,,Бұл қабілет айырмашылығы ма?
Dialogue: 0,0:06:50.59,0:06:54.16,Default,,0,0,0,,Бірақ мен әлі ештеңе істей алмайтыныма сене алмаймын...》
Dialogue: 0,0:06:54.16,0:06:56.16,Default,,0,0,0,,Бәрі бітті ме?
Dialogue: 0,0:07:05.59,0:07:07.66,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:07:07.66,0:07:09.96,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:07:14.40,0:07:16.98,Default,,0,0,0,,Уау! Ах!!
Dialogue: 0,0:07:16.98,0:07:18.98,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:07:21.91,0:07:23.94,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:07:23.94,0:07:26.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:26.08,0:07:31.40,Default,,0,0,0,,G-Ace➡ көмегімен Авангардқа
Dialogue: 0,0:07:31.40,0:07:33.48,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:07:33.48,0:07:42.78,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:56.59,0:08:03.81,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:03.81,0:08:05.81,Default,,0,0,0,,ﾌｧｲﾅﾙﾀｰﾝ
Dialogue: 0,0:08:12.46,0:08:15.63,Default,,0,0,0,,((Эцей: Одан артық жасасаң да, мағынасыз, жалған.
Dialogue: 0,0:08:15.63,0:08:18.26,Default,,0,0,0,,ｴｰｽ！
Dialogue: 0,0:08:18.26,0:08:21.45,Default,,0,0,0,,Сіздей ғашық жеңе алмайды.
Dialogue: 0,0:08:21.45,0:08:23.60,Default,,0,0,0,,Біз мұны осылай аяқтаймыз ба?
Dialogue: 0,0:08:23.60,0:08:26.04,Default,,0,0,0,,Қиба әулетінің абыройы мен мақтанышы туралы!
Dialogue: 0,0:08:26.04,0:08:29.14,Default,,0,0,0,,Және міндетті түрде сіз…))
Dialogue: 0,0:08:31.08,0:08:33.91,Default,,0,0,0,,ﾄﾞﾗｲﾌﾞﾁｪｯｸ
Dialogue: 0,0:08:33.91,0:08:37.11,Default,,0,0,0,,Тағы да…
Dialogue: 0,0:08:37.11,0:08:40.08,Default,,0,0,0,,((Ess: Ар-намыс? Мақтаныш?
Dialogue: 0,0:08:40.08,0:08:42.92,Default,,0,0,0,,Егер ол өліп қалған болса
Dialogue: 0,0:08:42.92,0:08:46.82,Default,,0,0,0,,Көрдім, сен өтірікші →
Dialogue: 0,0:08:46.82,0:08:48.74,Default,,0,0,0,,Сіз тіпті өзіңізге өтірік айтасыз
Dialogue: 0,0:08:48.74,0:08:51.78,Default,,0,0,0,,Бұл нені білдіреді? Мен сөзсіз өтірік айтамын!
Dialogue: 0,0:08:51.78,0:08:55.27,Default,,0,0,0,,Сіз мұны өзіңіз білесіз, солай ма?
Dialogue: 0,0:08:55.27,0:08:58.25,Default,,0,0,0,,Менің өтірікші және жеңілгенім
Dialogue: 0,0:08:58.25,0:09:00.45,Default,,0,0,0,,Не?
Dialogue: 0,0:09:00.45,0:09:05.59,Default,,0,0,0,,Қараңыз, жеңілген - жеңілген ➡
Dialogue: 0,0:09:05.59,0:09:08.33,Default,,0,0,0,,Тіпті лай судан жұтып ал!
Dialogue: 0,0:09:08.33,0:09:10.33,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:14.10,0:09:16.10,Default,,0,0,0,,Өзіңізді алдамаңыз! ))
Dialogue: 0,0:09:23.63,0:09:27.13,Default,,0,0,0,,《Егер мен осында жүре алсам...》
Dialogue: 0,0:09:37.27,0:09:39.66,Default,,0,0,0,,((Күте тұрыңыз, altmail!
Dialogue: 0,0:09:39.66,0:09:42.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:42.41,0:09:44.41,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:44.41,0:09:48.34,Default,,0,0,0,,Сізді одақтастарыңыз да тастап кеткен сияқты.
Dialogue: 0,0:09:48.34,0:09:51.79,Default,,0,0,0,,Бәрін жоғалтсаң да, күресесің бе?
Dialogue: 0,0:09:51.79,0:09:53.74,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:53.74,0:09:56.46,Default,,0,0,0,,Кибаның мұрагері күткендей.
Dialogue: 0,0:09:56.46,0:09:59.11,Default,,0,0,0,,Сізде біліктілік болмаса да➡
Dialogue: 0,0:09:59.11,0:10:02.47,Default,,0,0,0,,Сіздің мақтанышыңыз керемет.
Dialogue: 0,0:10:02.47,0:10:04.62,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:04.62,0:10:07.30,Default,,0,0,0,,Әдеттегідей, сіз →
Dialogue: 0,0:10:07.30,0:10:09.30,Default,,0,0,0,,Әлі де жарымжан))
Dialogue: 0,0:10:11.99,0:10:13.99,Default,,0,0,0,,Эйспен шабуыл
Dialogue: 0,0:10:16.78,0:10:19.78,Default,,0,0,0,,)
Dialogue: 0,0:10:21.82,0:10:24.32,Default,,0,0,0,,Шабуыл! (қалақ) толық қорғаушы
Dialogue: 0,0:10:27.26,0:10:29.44,Default,,0,0,0,,((Өткен даңққа жабысу
Dialogue: 0,0:10:29.44,0:10:31.43,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:10:31.43,0:10:35.95,Default,,0,0,0,,Соған қарамастан мен бәрін түсінуге тырысамын.
Dialogue: 0,0:10:35.95,0:10:39.94,Default,,0,0,0,,Болашақтың есігі жабылса да
Dialogue: 0,0:10:39.94,0:10:42.51,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:10:42.51,0:10:45.61,Default,,0,0,0,,Қайғыдан асқан, аянышты.
Dialogue: 0,0:10:45.61,0:10:48.16,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:10:48.16,0:10:50.16,Default,,0,0,0,,Тыныш! ))
Dialogue: 0,0:10:53.48,0:10:55.48,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:11:00.59,0:11:02.63,Default,,0,0,0,,((А...
Dialogue: 0,0:11:02.63,0:11:04.58,Default,,0,0,0,,Сол жігіт осы сапарға қосыла алмайды!
Dialogue: 0,0:11:04.58,0:11:07.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:07.33,0:11:10.33,Default,,0,0,0,,Кәне... бәрің күтіңдер!
Dialogue: 0,0:11:12.25,0:11:18.99,Default,,0,0,0,,Сонымен... бұл мен бе...
Dialogue: 0,0:11:18.99,0:11:24.29,Default,,0,0,0,,Менде ештеңе жоқ
Dialogue: 0,0:11:27.27,0:11:32.51,Default,,0,0,0,,Уау! ))
Dialogue: 0,0:11:32.51,0:11:34.61,Default,,0,0,0,,Оны бейнелеңіз
Dialogue: 0,0:11:36.58,0:12:02.00,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:02.00,0:12:06.60,Default,,0,0,0,,Оны әлі аяқтауға бола ма?
Dialogue: 0,0:12:16.27,0:12:18.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:34.65,0:12:36.95,Default,,0,0,0,,)
Dialogue: 0,0:12:45.18,0:12:47.18,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:12:49.08,0:12:51.62,Default,,0,0,0,,Мақта кәмпит! (Кал) Якисоба!
Dialogue: 0,0:12:51.62,0:12:53.67,Default,,0,0,0,,Пісірілген бангаро!
Dialogue: 0,0:12:53.67,0:12:56.42,Default,,0,0,0,,Уме~! Дәмді!!
Dialogue: 0,0:12:56.42,0:12:58.44,Default,,0,0,0,,Қуатты толтыру!
Dialogue: 0,0:12:58.44,0:13:01.33,Default,,0,0,0,,Жеңіс біздікі, Үшбірлік Айдаһар!
Dialogue: 0,0:13:01.33,0:13:03.23,Default,,0,0,0,,Әй, сондай сүйкімді...
Dialogue: 0,0:13:03.23,0:13:06.28,Default,,0,0,0,,Бұл нағыз фестиваль. (Токоха) Өйткені, Драен тармағы ➡
Dialogue: 0,0:13:06.28,0:13:09.19,Default,,0,0,0,,Бұл осылай болуы керек! (Шион) Эй
Dialogue: 0,0:13:09.19,0:13:11.49,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:13:15.44,0:13:17.43,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:13:17.43,0:13:21.47,Default,,0,0,0,,Жоқ... Мен атмосфераның әдеттегіден басқаша екенін сеземін...
Dialogue: 0,0:13:21.47,0:13:23.73,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:23.73,0:13:25.82,Default,,0,0,0,,Бұл жерде ештеңе жоқ
Dialogue: 0,0:13:25.82,0:13:27.82,Default,,0,0,0,,Жазбаңызды жылдам аяқтаңыз
Dialogue: 0,0:15:09.77,0:15:14.01,Default,,0,0,0,,≪(Вангаро) Күте тұрыңыз! Draen филиалының ашылу салтанаты G Quest➡
Dialogue: 0,0:15:14.01,0:15:16.01,Default,,0,0,0,,Қанжарды бастайық!
Dialogue: 0,0:15:18.08,0:15:21.62,Default,,0,0,0,,Барлығына! Өтінемін, мені бір апта күтіңіз➡
Dialogue: 0,0:15:21.62,0:15:25.24,Default,,0,0,0,,Кешіріңіз. Бірақ➡
Dialogue: 0,0:15:25.24,0:15:28.29,Default,,0,0,0,,Бұл Драен тарихындағы ең жақсы оқиға болады деп үміттенемін➡
Dialogue: 0,0:15:28.29,0:15:31.18,Default,,0,0,0,,Барлығына уәде беретін қанжар!
Dialogue: 0,0:15:31.18,0:15:36.42,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:15:36.42,0:15:39.42,Default,,0,0,0,,Сонымен! Ережелердің түсіндірмесі ➡
Dialogue: 0,0:15:39.42,0:15:43.26,Default,,0,0,0,,Осы екеуіне қанжар!
Dialogue: 0,0:15:43.26,0:15:47.89,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:15:47.89,0:15:50.75,Default,,0,0,0,,Бұл Лами лабиринт!
Dialogue: 0,0:15:50.75,0:15:53.28,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:15:53.28,0:15:56.59,Default,,0,0,0,,Ол нағыз періште! (Кал) Луна-чан!!
Dialogue: 0,0:15:56.59,0:15:58.79,Default,,0,0,0,,Ам-чан!
Dialogue: 0,0:15:58.79,0:16:01.78,Default,,0,0,0,,Draen Branch G Quest-ке қош келдіңіз
Dialogue: 0,0:16:01.78,0:16:03.78,Default,,0,0,0,,Сен тым ұсқынсыз емессің бе!
Dialogue: 0,0:16:06.28,0:16:08.42,Default,,0,0,0,,Драен филиалының айналасындағы қалада →
Dialogue: 0,0:16:08.42,0:16:11.62,Default,,0,0,0,,Мұнда жасырылған қазына сандығы бар!
Dialogue: 0,0:16:11.62,0:16:14.30,Default,,0,0,0,,«Бірлескен» деп аталатын қала тұрғындарынан➡
Dialogue: 0,0:16:14.30,0:16:16.42,Default,,0,0,0,,Ақпаратты сұрау...
Dialogue: 0,0:16:16.42,0:16:19.31,Default,,0,0,0,,Open the treasure chest and get the treasure!
Dialogue: 0,0:16:19.31,0:16:23.13,Default,,0,0,0,,The team that collects the most treasures wins!
Dialogue: 0,0:16:23.13,0:16:25.60,Default,,0,0,0,,Демек, бұл қазына іздеу ме?
Dialogue: 0,0:16:25.60,0:16:28.02,Default,,0,0,0,,Бірақ бұл G квесті!
Dialogue: 0,0:16:28.02,0:16:30.60,Default,,0,0,0,,There are people all over town who are interfering with everyone's treasure hunt→
Dialogue: 0,0:16:30.60,0:16:32.62,Default,,0,0,0,,Қуғыншы бар, абай болыңыз!
Dialogue: 0,0:16:32.62,0:16:34.67,Default,,0,0,0,,Қуғыншы жақын жерде болғанда➡
Dialogue: 0,0:16:34.67,0:16:36.71,Default,,0,0,0,,Камерадан дабыл естіледі.
Dialogue: 0,0:16:36.71,0:16:38.78,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:16:38.78,0:16:41.90,Default,,0,0,0,,When you are touched, the fight will start forcibly!
Dialogue: 0,0:16:41.90,0:16:45.35,Default,,0,0,0,,If you lose, you'll be sent to the drop zone!
Dialogue: 0,0:16:45.35,0:16:47.94,Default,,0,0,0,,Ро түрмесі!?
Dialogue: 0,0:16:47.94,0:16:51.58,Default,,0,0,0,,While you are caught, your acquired treasure will also be confiscated.
Dialogue: 0,0:16:51.58,0:16:54.93,Default,,0,0,0,,I can't get out unless my friends come to help me!
Dialogue: 0,0:16:54.93,0:16:56.90,Default,,0,0,0,,Бірақ қуғыншыны жеңсеңіз →
Dialogue: 0,0:16:56.90,0:16:59.45,Default,,0,0,0,,Сіз көп қазына ала аласыз!
Dialogue: 0,0:16:59.45,0:17:02.27,Default,,0,0,0,,You might be able to turn a punch into a chance!
Dialogue: 0,0:17:02.27,0:17:04.45,Default,,0,0,0,,You can find the treasure chest steadily→
Dialogue: 0,0:17:04.45,0:17:07.82,Default,,0,0,0,,You can bravely compete with the chaser and aim for a large number of points!
Dialogue: 0,0:17:07.82,0:17:09.83,Default,,0,0,0,,Бұл күлкілі!
Dialogue: 0,0:17:09.83,0:17:14.28,Default,,0,0,0,,Hey, if your friends come to help you, you can get out of the drop zone, right?
Dialogue: 0,0:17:14.28,0:17:18.17,Default,,0,0,0,,Иә! Дегенмен, егер біз Guardian-ды жеңе алсақ.
Dialogue: 0,0:17:18.17,0:17:21.94,Default,,0,0,0,,If you lose, of course you will be imprisoned in the drop zone!
Dialogue: 0,0:17:21.94,0:17:25.04,Default,,0,0,0,,If all members enter, you will be disqualified, so be careful!
Dialogue: 0,0:17:27.08,0:17:30.00,Default,,0,0,0,,Міне қуғыншыларды таныстырамыз!
Dialogue: 0,0:17:30.00,0:17:32.10,Default,,0,0,0,,Кел, қуғыншы әскер!
Dialogue: 0,0:17:35.62,0:17:38.74,Default,,0,0,0,,О...!
Dialogue: 0,0:17:38.74,0:17:41.16,Default,,0,0,0,,О!!
Dialogue: 0,0:17:41.16,0:17:44.58,Default,,0,0,0,,Бұл төсбелгі қуғыншы болғандығының дәлелі!
Dialogue: 0,0:17:44.58,0:17:46.63,Default,,0,0,0,,Баршаңыз!
Dialogue: 0,0:17:46.63,0:17:50.45,Default,,0,0,0,,Қала мен сауда ауданы тұрғындарының ынтымақтастығы арқасында →
Dialogue: 0,0:17:50.45,0:17:53.42,Default,,0,0,0,,Драен тармағына тән квест аяқталды.
Dialogue: 0,0:17:53.42,0:17:55.84,Default,,0,0,0,,Толығырақ бүгін➡
Dialogue: 0,0:17:55.84,0:17:57.77,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:17:57.77,0:18:00.14,Default,,0,0,0,,Бұл өте қиын болды. (Қуаныш)
Dialogue: 0,0:18:00.14,0:18:03.96,Default,,0,0,0,,As an apology for keeping everyone waiting for a week➡
Dialogue: 0,0:18:03.96,0:18:06.10,Default,,0,0,0,,Осы аптаның арнайы қонағы!
Dialogue: 0,0:18:06.10,0:18:09.12,Default,,0,0,0,,Мен бұл адамнан менің супертексерім болуын сұрадым!
Dialogue: 0,0:18:09.12,0:18:11.10,Default,,0,0,0,,(ﾄﾞﾗﾑﾛｰﾙ)
Dialogue: 0,0:18:11.10,0:18:13.62,Default,,0,0,0,,Авангард Еуро лигасының жеңімпазы →
Dialogue: 0,0:18:13.62,0:18:17.66,Default,,0,0,0,,Үздік жауынгер ретінде әлі де белсенді...
Dialogue: 0,0:18:17.66,0:18:19.66,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:18:21.61,0:18:23.63,Default,,0,0,0,,Бұл Тошики Кай!
Dialogue: 0,0:18:23.63,0:18:27.75,Default,,0,0,0,,Егер сіз Кай-санды жеңсеңіз, сізге 10 000 байлық беріледі.
Dialogue: 0,0:18:27.75,0:18:31.79,Default,,0,0,0,,Уф... Мен Кай-санмен төбелескім келеді!!
Dialogue: 0,0:18:31.79,0:18:33.74,Default,,0,0,0,,Бірақ маған түсу аймағы ұнамайды!
Dialogue: 0,0:18:33.74,0:18:35.78,Default,,0,0,0,,Бұл ең жақсы таңдау!
Dialogue: 0,0:18:35.78,0:18:38.78,Default,,0,0,0,,Жеңіске жету дұрыс емес пе? Жанып жатыр!
Dialogue: 0,0:18:38.78,0:18:41.95,Default,,0,0,0,,Ал біз, періштелер ретінде➡
Dialogue: 0,0:18:41.95,0:18:44.95,Default,,0,0,0,,Біз барлығымен ынтымақтасатын боламыз!
Dialogue: 0,0:18:44.95,0:18:47.44,Default,,0,0,0,,Егер сіз бізбен күресіп, жеңсеңіз➡
Dialogue: 0,0:18:47.44,0:18:49.61,Default,,0,0,0,,Біз сізге ерекше сыйлық береміз!
Dialogue: 0,0:18:49.61,0:18:54.30,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:18:54.30,0:18:57.15,Default,,0,0,0,,Мына куртка...
Dialogue: 0,0:18:57.15,0:19:01.45,Default,,0,0,0,,Иә, бұл өте рас...
Dialogue: 0,0:19:01.45,0:19:05.43,Default,,0,0,0,,Барлығы~!! Саған бар жақсылықты тілеймін, Дага!!
Dialogue: 0,0:19:05.43,0:19:07.49,Default,,0,0,0,,ｽﾀﾞﾝﾄﾞｱｯﾌﾟ…
Dialogue: 0,0:19:07.49,0:19:09.49,Default,,0,0,0,,ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:19:12.27,0:19:14.78,Default,,0,0,0,,Мұнда әрқайсысымыз өз бетінше әрекет етейік.
Dialogue: 0,0:19:14.78,0:19:16.74,Default,,0,0,0,,Бұл тиімдірек
Dialogue: 0,0:19:16.74,0:19:20.12,Default,,0,0,0,,Әй, қазынаны жинап, жеңісті мақсат етейік!
Dialogue: 0,0:19:20.12,0:19:22.11,Default,,0,0,0,,ｵｯｹｰ！
Dialogue: 0,0:19:22.11,0:19:24.11,Default,,0,0,0,,Мен бүгін міндетті түрде жеңемін!
Dialogue: 0,0:19:24.11,0:19:26.61,Default,,0,0,0,,О... О
Dialogue: 0,0:19:30.13,0:19:32.27,Default,,0,0,0,,Ол жігітке не болды?
Dialogue: 0,0:19:32.27,0:19:34.45,Default,,0,0,0,,Бірдеңе дұрыс емес, солай емес пе?
Dialogue: 0,0:19:34.45,0:19:57.44,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:57.44,0:20:00.56,Default,,0,0,0,,[Спикер] (Вангаро) Байқап көріңіз! Шақырыңыз!
Dialogue: 0,0:20:00.56,0:20:02.62,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:20:02.62,0:20:04.58,Default,,0,0,0,,Үш айда 10 000 қазына!!
Dialogue: 0,0:20:04.58,0:20:06.62,Default,,0,0,0,,10 000!!
Dialogue: 0,0:20:06.62,0:20:10.99,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:10.99,0:20:12.99,Default,,0,0,0,,Жарайсыңдар! Барайық!
Dialogue: 0,0:20:16.96,0:20:19.13,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:20:19.13,0:20:21.23,Default,,0,0,0,,Иә, кешіріңіз
Dialogue: 0,0:20:23.82,0:20:25.92,Default,,0,0,0,,Міне!
Dialogue: 0,0:20:32.30,0:20:35.35,Default,,0,0,0,,《Онымен көп нәрсе болып жатыр➡
Dialogue: 0,0:20:35.35,0:20:39.25,Default,,0,0,0,,Дегенмен, олар G Quest-ке қатысуда.
Dialogue: 0,0:20:39.25,0:20:41.49,Default,,0,0,0,,Біз үшін Үшті қолданып көріңіз➡
Dialogue: 0,0:20:41.49,0:20:43.49,Default,,0,0,0,,Тіпті мен көп тырысуым керек》
Dialogue: 0,0:20:45.78,0:20:48.43,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:20:48.43,0:20:51.76,Default,,0,0,0,,Наоки Ишида
Dialogue: 0,0:20:51.76,0:20:53.82,Default,,0,0,0,,Синдо Куроно?
Dialogue: 0,0:20:53.82,0:20:55.79,Default,,0,0,0,,Өтінемін, күресіңіз
Dialogue: 0,0:20:55.79,0:20:58.29,Default,,0,0,0,,Сіз өте күштісіз...
Dialogue: 0,0:20:58.29,0:21:00.41,Default,,0,0,0,,Қазірге дейін қанша өмір төгілді деп ойлайсың?
Dialogue: 0,0:21:00.41,0:21:04.94,Default,,0,0,0,,Хабаршы Куми-чан, қазына сандығы қайда екенін айтыңызшы!
Dialogue: 0,0:21:04.94,0:21:08.25,Default,,0,0,0,,Қиық нан бәрін біледі.
Dialogue: 0,0:21:08.25,0:21:10.45,Default,,0,0,0,,Не? Осылардың кез келгені➡
Dialogue: 0,0:21:10.45,0:21:12.40,Default,,0,0,0,,Бұл жерде түсініктеме бар.
Dialogue: 0,0:21:12.40,0:21:15.46,Default,,0,0,0,,Қаншалықты егжей-тегжейлі...
Dialogue: 0,0:21:15.46,0:21:17.96,Default,,0,0,0,,Бірақ егер солай болса...
Dialogue: 0,0:21:17.96,0:21:20.26,Default,,0,0,0,,Ағай, 10 тоқаш крокет!
Dialogue: 0,0:21:20.26,0:21:22.78,Default,,0,0,0,,Осыншама көп жеуге бола ма?
Dialogue: 0,0:21:22.78,0:21:25.25,Default,,0,0,0,,Крокет нанын осы жерден алуға болады!
Dialogue: 0,0:21:25.25,0:21:28.30,Default,,0,0,0,,≪Бұл шынымен де дәмді ме?
Dialogue: 0,0:21:28.30,0:21:30.29,Default,,0,0,0,,Ах, Чизер!!
Dialogue: 0,0:21:30.29,0:21:32.29,Default,,0,0,0,,Бұл Шинго Комой!
Dialogue: 0,0:21:32.29,0:21:36.46,Default,,0,0,0,,Есіңе түскеніне қуаныштымын.
Dialogue: 0,0:21:36.46,0:21:39.43,Default,,0,0,0,,Бір минут күте тұрыңыз, неге дабыл өшпейді?
Dialogue: 0,0:21:39.43,0:21:44.78,Default,,0,0,0,,А, мен оны қосуды ұмытып кетіппін.
Dialogue: 0,0:21:44.78,0:21:47.67,Default,,0,0,0,,Кешіріңіз, мен мұнда емеспін...
Dialogue: 0,0:21:47.67,0:21:51.47,Default,,0,0,0,,Жоқ, бұл сіздің үлкен қазына алу мүмкіндігіңіз!
Dialogue: 0,0:21:53.84,0:21:56.84,Default,,0,0,0,,Мен сізге Нарукамидің шынайы күшін көрсетемін!
Dialogue: 0,0:22:00.95,0:22:03.35,Default,,0,0,0,,Angercharge Dragon шеберлігі іске қосылды!
Dialogue: 0,0:22:03.35,0:22:06.15,Default,,0,0,0,,Сіздің тылдағы сақшыларыңыздың бірі шегінді!!
Dialogue: 0,0:22:08.79,0:22:12.08,Default,,0,0,0,,Гунто Ред Бастер Айдаһардың шекті бұзуы!
Dialogue: 0,0:22:12.08,0:22:15.28,Default,,0,0,0,,Қарсыластың тыл сақшысы шегінген сайын➡
Dialogue: 0,0:22:15.28,0:22:19.42,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ3000 ｸﾘﾃｨｶﾙﾌﾟﾗｽ１
Dialogue: 0,0:22:19.42,0:22:21.45,Default,,0,0,0,,Әрі қарай жүрейік!
Dialogue: 0,0:22:21.45,0:22:23.47,Default,,0,0,0,,Үлкен шеберлігі бар шабуыл өшіргіші→
Dialogue: 0,0:22:23.47,0:22:26.08,Default,,0,0,0,,1 қарсы заряд алдыңғы жағында
Dialogue: 0,0:22:26.08,0:22:29.13,Default,,0,0,0,,1 Guntred Buster шеберлігінің шегінуі.
Dialogue: 0,0:22:29.13,0:22:31.10,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:22:31.10,0:22:34.40,Default,,0,0,0,,Тағы бір тіршілік иесі шегінеді. Көкек...
Dialogue: 0,0:22:38.17,0:22:40.19,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:22:40.19,0:22:43.79,Default,,0,0,0,,Guntle Red Buster Dragon-мен шабуыл!
Dialogue: 0,0:22:46.11,0:22:48.10,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:22:48.10,0:22:50.78,Default,,0,0,0,,Күткендей, Камуи-сан менің ағам.
Dialogue: 0,0:22:50.78,0:22:53.79,Default,,0,0,0,,Бірақ мен жеңілмеймін!
Dialogue: 0,0:22:53.79,0:22:56.42,Default,,0,0,0,,Жарайды, көрейін➡
Dialogue: 0,0:22:56.42,0:22:58.63,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:22:58.63,0:23:01.74,Default,,0,0,0,,)
Dialogue: 0,0:23:01.74,0:23:04.46,Default,,0,0,0,,《Менде ештеңе жоқ
Dialogue: 0,0:23:04.46,0:23:08.10,Default,,0,0,0,,Сондықтан бәрі болашақ бейнемен анықталады.
Dialogue: 0,0:23:08.10,0:23:10.10,Default,,0,0,0,,<<Уау~ Қашып кет~
Dialogue: 0,0:23:15.79,0:23:19.16,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:23:19.16,0:23:21.73,Default,,0,0,0,,ﾌｨﾆｯｼｭﾌﾞﾛｰ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:23:21.73,0:23:24.47,Default,,0,0,0,,Айдаһар соққыларын аяқтау
Dialogue: 0,0:23:24.47,0:23:27.44,Default,,0,0,0,,Бір тылдағы күзетші шегінеді.
Dialogue: 0,0:23:27.44,0:23:29.46,Default,,0,0,0,,Сонымен қатар, Angercharge Dragon дағдылары
Dialogue: 0,0:23:29.46,0:23:31.47,Default,,0,0,0,,Тағы біреуі!
Dialogue: 0,0:23:31.47,0:23:33.46,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:23:33.46,0:23:37.41,Default,,0,0,0,,Бірақ мен бұл жерде ұтыла алмаймын!
Dialogue: 0,0:23:37.41,0:23:39.43,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:23:39.43,0:23:43.12,Default,,0,0,0,,Күзетсіз айдаһармен шабуыл. Күзетші!
Dialogue: 0,0:23:43.12,0:23:47.51,Default,,0,0,0,,Әлі жоқ! Бар! Финдік соққы айдаһар!
Dialogue: 0,0:23:47.51,0:23:50.16,Default,,0,0,0,,Ах... Күзетші жоқ
Dialogue: 0,0:23:50.16,0:23:53.76,Default,,0,0,0,,《Бір карта да маңызды болса, ол бітті》
Dialogue: 0,0:24:04.84,0:24:08.41,Default,,0,0,0,,Қарғыс атқыр, мен оны тарта алмадым. Фу.
Dialogue: 0,0:24:08.41,0:24:11.46,Default,,0,0,0,,Эй, мен өзімді қауіпсіз сезіне аламын ба?
Dialogue: 0,0:24:11.46,0:24:15.50,Default,,0,0,0,,Мен келесі кезекті міндетті түрде шешемін.
Dialogue: 0,0:24:15.50,0:24:17.82,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:24:17.82,0:24:21.42,Default,,0,0,0,,Егер солай болса, сіз өзіңіз үшін маңызды нәрсені қорғай алмайсыз.
Dialogue: 0,0:24:23.44,0:24:26.88,Default,,0,0,0,,Бұл соңы. Өзіңізді дайындаңыз.
Dialogue: 0,0:24:26.88,0:24:31.68,Default,,0,0,0,,Мен Шионды бұл жерде ұстай алмаймын.
Dialogue: 0,0:24:34.09,0:24:36.11,Default,,0,0,0,,Үш-үш➡ үшін
Dialogue: 0,0:24:36.11,0:24:38.44,Default,,0,0,0,,Күресіп жатқан адам үшін!
Dialogue: 0,0:24:38.44,0:24:42.44,Default,,0,0,0,,Мен үш-үштің болашағын өз қолыммен ашамын!
Dialogue: 0,0:24:44.45,0:24:47.12,Default,,0,0,0,,ｸﾛﾉﾄﾞﾗｺﾞﾝ･ﾈｸｽﾃｰｼﾞ！
Dialogue: 0,0:24:47.12,0:24:49.09,Default,,0,0,0,,Сәлем! кел!
Dialogue: 0,0:24:49.09,0:24:51.49,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:24:51.49,0:24:54.09,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:24:54.09,0:24:56.11,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:24:56.11,0:24:59.41,Default,,0,0,0,,Қайтадан тұрыңыз, Chronojet Dragon!
Dialogue: 0,0:24:59.41,0:25:03.12,Default,,0,0,0,,Болашаққа үшеуміз алға ұмтыламыз!
Dialogue: 0,0:25:03.12,0:25:06.09,Default,,0,0,0,,Chronojet Dragon көмегімен шабуыл!
Dialogue: 0,0:25:06.09,0:25:08.77,Default,,0,0,0,,Бұл Ногард.
Dialogue: 0,0:25:08.77,0:25:12.14,Default,,0,0,0,,Болашақты қолға ал, солай ма?
Dialogue: 0,0:25:12.14,0:25:14.43,Default,,0,0,0,,Олай болса, жұлып алайық➡
Dialogue: 0,0:25:14.43,0:25:16.73,Default,,0,0,0,,Өз қолдарымен
Dialogue: 0,0:25:20.15,0:25:22.15,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ…
Dialogue: 0,0:25:26.44,0:25:28.46,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:25:28.46,0:25:30.48,Default,,0,0,0,,Жүгіріп өт!
Dialogue: 0,0:25:30.48,0:25:33.75,Default,,0,0,0,,Біз үшін жаңа әлем ашады!
Dialogue: 0,0:25:33.75,0:25:35.82,Default,,0,0,0,,Гейл рухының шабуылы!
Dialogue: 0,0:25:35.82,0:25:38.82,Default,,0,0,0,,Үздіксіз соққы үзіліс!
Dialogue: 0,0:25:41.49,0:25:43.49,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:25:45.46,0:25:48.51,Default,,0,0,0,,Уф, мен жеңілдім.
Dialogue: 0,0:25:48.51,0:25:50.81,Default,,0,0,0,,Бірақ бұл қызу тартыс болды.
Dialogue: 0,0:25:52.83,0:25:54.83,Default,,0,0,0,,Наоки-сан
Dialogue: 0,0:25:57.45,0:25:59.81,Default,,0,0,0,,Көп нәрсе бар сияқты➡
Dialogue: 0,0:25:59.81,0:26:02.93,Default,,0,0,0,,Сіз оны жеңе аласыз.
Dialogue: 0,0:26:02.93,0:26:06.23,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, барыңды сал
Dialogue: 0,0:26:10.12,0:26:12.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:26:12.07,0:26:14.45,Default,,0,0,0,,Гладиолуспен шабуыл!
Dialogue: 0,0:26:14.45,0:26:17.81,Default,,0,0,0,,Ал... Мен келдім.
Dialogue: 0,0:26:17.81,0:26:19.88,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:26:19.88,0:26:22.78,Default,,0,0,0,,Хитендегі қасиетті рыцарь Альтомайлмен шабуыл!
Dialogue: 0,0:26:22.78,0:26:24.78,Default,,0,0,0,,♬~
Dialogue: 0,0:26:27.18,0:26:29.18,Default,,0,0,0,,ﾄﾗｲｽﾘｰ
Dialogue: 0,0:26:31.42,0:26:35.42,Default,,0,0,0,,Бұл тағдырды жеңуге тырыс...
Dialogue: 0,0:30:33.43,0:30:37.43,Default,,0,0,0,,Бұл жолы біз саябақ ойын алаңының жабдықтары әлеміне енетін боламыз.
Dialogue: 0,0:30:45.04,0:30:47.54,Default,,0,0,0,,Бірде жас кезімде→
Dialogue: 0,0:30:55.92,0:30:58.52,Default,,0,0,0,,Жапонияның жоғарғы жағы→
Dialogue: 0,0:31:00.02,0:31:06.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory