Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:07.43,0:01:10.03,Default,,0,0,0,,Бұл не? (Токоха) Тұйық жол?
Dialogue: 0,0:01:12.02,0:01:14.28,Default,,0,0,0,,Жоқ! (Токоха) Кіретін және шығатын жері бар!!
Dialogue: 0,0:01:14.28,0:01:16.38,Default,,0,0,0,,Уау... уау!!
Dialogue: 0,0:01:19.36,0:01:22.13,Default,,0,0,0,,ﾌﾌﾌ…
Dialogue: 0,0:01:22.13,0:01:24.43,Default,,0,0,0,,ｲｯﾂ ｼｮｰﾀｲﾑ！
Dialogue: 0,0:04:37.44,0:04:39.54,Default,,0,0,0,,Уау!!
Dialogue: 0,0:04:43.01,0:04:48.01,Default,,0,0,0,,Шамасы, бұл Mega Colony әлемін қайта жасайтын орын.
Dialogue: 0,0:04:48.01,0:04:50.03,Default,,0,0,0,,Бұл медаль!
Dialogue: 0,0:04:50.03,0:04:52.60,Default,,0,0,0,,Сол жауынгерлер қайда кетті?
Dialogue: 0,0:04:52.60,0:04:55.14,Default,,0,0,0,,♪♪～
Dialogue: 0,0:04:55.14,0:04:58.37,Default,,0,0,0,,[Баяндамашы] Бұл қылмыстық қоғам, мегаколония басқаратын әлем
Dialogue: 0,0:04:58.37,0:05:01.24,Default,,0,0,0,,[Спикер] Үш үшеу жеңді!
Dialogue: 0,0:05:01.24,0:05:04.30,Default,,0,0,0,,[Сөйлеуші] Бірақ соның айғағы, медаль менің қолымнан алынды.
Dialogue: 0,0:05:04.30,0:05:07.88,Default,,0,0,0,,[Спикер] Біздің трилогиямыз G Quest➡-ді бағындыру
Dialogue: 0,0:05:07.88,0:05:10.20,Default,,0,0,0,,Әлемдік бейбітшілік үшін➡
Dialogue: 0,0:05:10.20,0:05:13.19,Default,,0,0,0,,Күндіз-түні Мегаколониямен күресуді жалғастырыңыз!
Dialogue: 0,0:05:13.19,0:05:15.61,Default,,0,0,0,,[Спикер] Барыңыз! Үшеуін көріңіз!
Dialogue: 0,0:05:15.61,0:05:18.69,Default,,0,0,0,,[Спикер] Үшеуін көріңіз!
Dialogue: 0,0:05:18.69,0:05:20.71,Default,,0,0,0,,Солай ма? иә?
Dialogue: 0,0:05:20.71,0:05:22.77,Default,,0,0,0,,Енді түсіндің бе?
Dialogue: 0,0:05:22.77,0:05:24.83,Default,,0,0,0,,Басқаша айтқанда, бұл ізденіс.
Dialogue: 0,0:05:24.83,0:05:26.83,Default,,0,0,0,,Бұл жеңген медальді қайтару туралы.
Dialogue: 0,0:05:33.21,0:05:35.21,Default,,0,0,0,,Енді ойлап қарасам, жауынгер осылай деді.
Dialogue: 0,0:05:35.21,0:05:38.35,Default,,0,0,0,,Нағыз ізденістің басы немесе бірдеңе...
Dialogue: 0,0:05:38.35,0:05:43.35,Default,,0,0,0,,Жеңімпаз медаль мегалоней көшбасшысының қолында!
Dialogue: 0,0:05:43.35,0:05:46.81,Default,,0,0,0,,Біз оны қайтарғымыз келеді. Бізбен күресетін хайуанаттар бағы!
Dialogue: 0,0:05:46.81,0:05:48.84,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:05:48.84,0:05:52.53,Default,,0,0,0,,Соо! (Токоха) Эй, бұл не!!
Dialogue: 0,0:05:52.53,0:05:57.25,Default,,0,0,0,,[Баяндамашы] Үш кезең бар. Алдымен 100 жауынгерді жеңіңіз!
Dialogue: 0,0:05:57.25,0:06:00.20,Default,,0,0,0,,Хя, 100 адам!? Бұл өтірік...
Dialogue: 0,0:06:00.20,0:06:09.30,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:09.30,0:06:11.35,Default,,0,0,0,,(ﾌﾞｻﾞｰ)
Dialogue: 0,0:06:11.35,0:06:13.20,Default,,0,0,0,,ｽﾞｰ！
Dialogue: 0,0:06:13.20,0:06:15.90,Default,,0,0,0,,Соо! Мен екі рет қана жеңдім →
Dialogue: 0,0:06:15.90,0:06:18.04,Default,,0,0,0,,Мен жеңу тым оңай деп ойладым!
Dialogue: 0,0:06:18.04,0:06:21.22,Default,,0,0,0,,Сонымен, егжей-тегжейлі.
Dialogue: 0,0:06:21.22,0:06:23.73,Default,,0,0,0,,Мен Кристен жеңген болсам да➡
Dialogue: 0,0:06:23.73,0:06:25.73,Default,,0,0,0,,Бірдеңе бұзылған!
Dialogue: 0,0:06:29.55,0:06:31.53,Default,,0,0,0,,Барлығы өте керемет!!
Dialogue: 0,0:06:31.53,0:06:34.44,Default,,0,0,0,,ｽﾞｰ!!
Dialogue: 0,0:06:34.44,0:06:39.08,Default,,0,0,0,,Сіз оларды бір соққымен жеңе алсаңыз да, олардың саны тым көп.
Dialogue: 0,0:06:39.08,0:06:41.88,Default,,0,0,0,,Уақыт жоқ!
Dialogue: 0,0:06:41.88,0:06:43.90,Default,,0,0,0,,Мен бәрін бірден шешемін!
Dialogue: 0,0:06:43.90,0:06:47.28,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:47.28,0:06:49.25,Default,,0,0,0,,ｾ･ﾌｨﾆ
Dialogue: 0,0:06:49.25,0:06:51.35,Default,,0,0,0,,ｽﾞｰ!!
Dialogue: 0,0:06:54.56,0:06:58.06,Default,,0,0,0,,[Майк] Бірінші кезең 1 секунд қалды!
Dialogue: 0,0:07:00.03,0:07:02.01,Default,,0,0,0,,ｸﾞﾚｲﾄ！
Dialogue: 0,0:07:02.01,0:07:05.07,Default,,0,0,0,,Шион керемет! Сіз мені құтқардыңыз!!
Dialogue: 0,0:07:05.07,0:07:07.74,Default,,0,0,0,,Мен оны уақытында жасағаныма қуаныштымын.
Dialogue: 0,0:07:07.74,0:07:10.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:10.89,0:07:13.69,Default,,0,0,0,,Тазалап қойсаң да, не айтасың!!
Dialogue: 0,0:07:18.45,0:07:20.45,Default,,0,0,0,,Сізге тек көңіл көтеру керек!
Dialogue: 0,0:07:23.60,0:07:25.60,Default,,0,0,0,,Уау!!
Dialogue: 0,0:07:28.04,0:07:30.86,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:30.86,0:07:33.58,Default,,0,0,0,,Жарайсың, Трисли
Dialogue: 0,0:07:33.58,0:07:36.45,Default,,0,0,0,,Ұлы басшыға барғыңыз келсе ➡
Dialogue: 0,0:07:36.45,0:07:38.48,Default,,0,0,0,,Сіз бізді жеңесіз!
Dialogue: 0,0:07:38.48,0:07:40.37,Default,,0,0,0,,Неге балалар?
Dialogue: 0,0:07:40.37,0:07:45.29,Default,,0,0,0,,Хехе, мен өткен аптада квестті аяқтадым және барлау алдым.
Dialogue: 0,0:07:45.29,0:07:48.53,Default,,0,0,0,,Біздің жетістіктеріміз өте керемет.
Dialogue: 0,0:07:48.53,0:07:53.95,Default,,0,0,0,,Айтпақшы, біз хайуанаттар бағы үшін сол позаны ойлап таптық.
Dialogue: 0,0:07:53.95,0:07:55.90,Default,,0,0,0,,ｽﾞｰ！
Dialogue: 0,0:07:55.90,0:08:01.29,Default,,0,0,0,,Жарайсыңдар, егер сендер болсаңдар, біз оңай жеңіп, екінші кезеңнен өтер едік.
Dialogue: 0,0:08:01.29,0:08:03.54,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:03.54,0:08:05.54,Default,,0,0,0,,[Спикер] Трисли құбыжықтарды жеңді
Dialogue: 0,0:08:05.54,0:08:09.68,Default,,0,0,0,,[Спикер] Бірақ оған дейін оның жолында жаңа құбыжық, Мега Колония тұр.
Dialogue: 0,0:08:09.68,0:08:14.64,Default,,0,0,0,,[Спикер] Оларды жеңудің жалғыз жолы - карта жауынгері Вангаманға айналу.
Dialogue: 0,0:08:14.64,0:08:17.04,Default,,0,0,0,,[Спикер] Барыңыз! Карта жауынгері Бангаман!
Dialogue: 0,0:08:17.04,0:08:20.41,Default,,0,0,0,,[Сөйлеуші] Өтінемін, карта жауынгері Вангаман!
Dialogue: 0,0:08:20.41,0:08:22.45,Default,,0,0,0,,... Трансформация?
Dialogue: 0,0:08:22.45,0:08:25.23,Default,,0,0,0,,Жоқ, жоқ, не болса да...
Dialogue: 0,0:08:25.23,0:08:27.33,Default,,0,0,0,,Тым ақымақ
Dialogue: 0,0:08:33.74,0:08:36.39,Default,,0,0,0,,Егер сіз мұны істей алмасаңыз, сіз осы жерден дисквалификациясыз.
Dialogue: 0,0:08:36.39,0:08:39.69,Default,,0,0,0,,Әрине, ұтыс ұпайлары жоқ.
Dialogue: 0,0:08:41.91,0:08:44.70,Default,,0,0,0,,Қарғыс атсын, біз бүгін жеңіліп қалдық.
Dialogue: 0,0:08:44.70,0:08:46.72,Default,,0,0,0,,Ол айбатты жау болды.
Dialogue: 0,0:08:46.72,0:08:48.69,Default,,0,0,0,,Келесі жолы ұпай жинап, жеңіңіз.
Dialogue: 0,0:08:48.69,0:08:50.87,Default,,0,0,0,,[Монитор] Бір минут күтіңіздер, балалар!
Dialogue: 0,0:08:50.87,0:08:53.24,Default,,0,0,0,,[Монитор] Сіз тым ерте бас тарттыңыз!
Dialogue: 0,0:08:53.24,0:08:57.53,Default,,0,0,0,,Ия, эй, гепкосерия!
Dialogue: 0,0:08:57.53,0:09:00.53,Default,,0,0,0,,Бізден жеңіліп қалудан қорқасың ба?
Dialogue: 0,0:09:00.53,0:09:03.02,Default,,0,0,0,,Бұл не? Ол жақта бағдаршам бар.
Dialogue: 0,0:09:03.02,0:09:05.20,Default,,0,0,0,,Сигналдың үш түсі
Dialogue: 0,0:09:05.20,0:09:08.86,Default,,0,0,0,,Бұл ұпайларға арналған.
Dialogue: 0,0:09:08.86,0:09:11.53,Default,,0,0,0,,Жеңіске жету үшін➡ жеңу керек
Dialogue: 0,0:09:11.53,0:09:13.55,Default,,0,0,0,,Сызық бар
Dialogue: 0,0:09:13.55,0:09:16.18,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:09:16.18,0:09:18.70,Default,,0,0,0,,Жасайық! (Токоха/Шион) О!
Dialogue: 0,0:09:18.70,0:09:20.79,Default,,0,0,0,,Трансформация!
Dialogue: 0,0:09:20.79,0:09:23.09,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:09:26.21,0:09:28.29,Default,,0,0,0,,[Спикер] Карта жауынгері Вангаман →
Dialogue: 0,0:09:28.29,0:09:32.09,Default,,0,0,0,,Қадам генерациясы небәрі 1 миллисекундта аяқталады.
Dialogue: 0,0:09:34.02,0:09:37.52,Default,,0,0,0,,ｳﾞｧﾝｶﾞﾚｯﾄﾞ！
Dialogue: 0,0:09:37.52,0:09:41.21,Default,,0,0,0,,ｳﾞｧﾝｶﾞｸﾞﾘｰﾝ！
Dialogue: 0,0:09:41.21,0:09:44.73,Default,,0,0,0,,ｳﾞｧﾝｶﾞﾌﾞﾙｰ
Dialogue: 0,0:09:44.73,0:09:46.86,Default,,0,0,0,,Карта жауынгері...
Dialogue: 0,0:09:46.86,0:09:49.88,Default,,0,0,0,,Бангаман! (жарылыс дыбысы)
Dialogue: 0,0:09:49.88,0:09:52.07,Default,,0,0,0,,《Мен үйге барғым келеді》
Dialogue: 0,0:09:52.07,0:09:56.21,Default,,0,0,0,,《Мені өшір, мені қазір өшір》
Dialogue: 0,0:09:56.21,0:09:59.07,Default,,0,0,0,,《Екеуі де жетілмеген》
Dialogue: 0,0:09:59.07,0:10:01.37,Default,,0,0,0,,Кеттік, Бангаман!
Dialogue: 0,0:10:03.53,0:10:05.55,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:10:05.55,0:10:09.42,Default,,0,0,0,,Ұзындығы 10 метр жемістің қандай түрі бар?
Dialogue: 0,0:10:09.42,0:10:12.52,Default,,0,0,0,,Иә? Бұл жұмбақ
Dialogue: 0,0:10:12.52,0:10:15.19,Default,,0,0,0,,Неге!? Трансформацияның мәні неде!?
Dialogue: 0,0:10:15.19,0:10:17.19,Default,,0,0,0,,30 секунд қалды. Аа!?
Dialogue: 0,0:10:17.19,0:10:19.21,Default,,0,0,0,,Ол қазірдің өзінде басталды ма?
Dialogue: 0,0:10:19.21,0:10:21.35,Default,,0,0,0,,Қарғыс атсын, бұл жайсыздық. Бәрі жақсы➡
Dialogue: 0,0:10:21.35,0:10:24.22,Default,,0,0,0,,Жемістің атын айт. Иә. Иә.
Dialogue: 0,0:10:24.22,0:10:28.84,Default,,0,0,0,,ｻﾎﾟｼﾞﾗ ｼﾞｬﾎﾞﾁｶﾊﾞ ﾌﾞｯｼｭｶﾝ ﾊﾟﾗﾐﾂ ｳｽﾞﾍﾞｷｽﾀﾝﾒﾛﾝ
Dialogue: 0,0:10:28.84,0:10:30.71,Default,,0,0,0,,Міне!
Dialogue: 0,0:10:30.71,0:10:34.21,Default,,0,0,0,,Қарбыз Қауын Жақсы, Кабоча жеміс емес!
Dialogue: 0,0:10:34.21,0:10:37.70,Default,,0,0,0,,10 метр Сондай үлкен жеміс...
Dialogue: 0,0:10:37.70,0:10:42.18,Default,,0,0,0,,ﾘﾝｺﾞ ﾐｶﾝ ｲﾁｺﾞ ﾊﾞﾅﾅ ｵﾚﾝｼﾞ
Dialogue: 0,0:10:42.18,0:10:44.74,Default,,0,0,0,,Бұлай болуы мүмкін емес!
Dialogue: 0,0:10:44.74,0:10:47.37,Default,,0,0,0,,Алмұрт Жауабы - алмұрт!
Dialogue: 0,0:10:47.37,0:10:50.56,Default,,0,0,0,,Мұндай үлкен жеміс жоқ!
Dialogue: 0,0:10:50.56,0:10:52.55,Default,,0,0,0,,Жарайды! (Дұрыс жауап беретін топ)
Dialogue: 0,0:10:52.55,0:10:54.53,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:10:54.53,0:10:57.25,Default,,0,0,0,,Енді біздің кезегіміз. Бар, Шион!
Dialogue: 0,0:10:57.25,0:10:59.18,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:10:59.18,0:11:01.64,Default,,0,0,0,,Мәселе
Dialogue: 0,0:11:01.64,0:11:04.19,Default,,0,0,0,,Жауабы Дирихленің арифметикалық қатарлар теоремасы.
Dialogue: 0,0:11:04.19,0:11:06.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:06.19,0:11:09.08,Default,,0,0,0,,Қорқынышты... Не деген сұмдық? Цундере?
Dialogue: 0,0:11:09.08,0:11:11.01,Default,,0,0,0,,Бұл бәрібір французша.
Dialogue: 0,0:11:11.01,0:11:13.03,Default,,0,0,0,,30 секунд қалды
Dialogue: 0,0:11:13.03,0:11:16.04,Default,,0,0,0,,Сәлем! 521!
Dialogue: 0,0:11:16.04,0:11:18.37,Default,,0,0,0,,(Қате жауап сигналы)
Dialogue: 0,0:11:18.37,0:11:20.41,Default,,0,0,0,,Бұл қандай сан?
Dialogue: 0,0:11:20.41,0:11:22.36,Default,,0,0,0,,Оны қайдан алдың?
Dialogue: 0,0:11:22.36,0:11:25.38,Default,,0,0,0,,Бұл менің әкемнің туған күні.
Dialogue: 0,0:11:25.38,0:11:27.35,Default,,0,0,0,,20 секунд қалды
Dialogue: 0,0:11:27.35,0:11:29.35,Default,,0,0,0,,Сәлем! Бәрі жақсы➡
Dialogue: 0,0:11:29.35,0:11:31.75,Default,,0,0,0,,Сандарға жауап бер! (Кал/Кей) О!
Dialogue: 0,0:11:31.75,0:11:34.69,Default,,0,0,0,,3.141592653589793…｡ (Қате жауап сигналы)
Dialogue: 0,0:11:34.69,0:11:36.71,Default,,0,0,0,,Бұл әлі де орындалып жатқан жұмыс!
Dialogue: 0,0:11:36.71,0:11:39.02,Default,,0,0,0,,Мм... 8
Dialogue: 0,0:11:39.02,0:11:41.03,Default,,0,0,0,,(Қате жауап сигналы)
Dialogue: 0,0:11:41.03,0:11:43.03,Default,,0,0,0,,923! Ал, 1 миллион! (Кай) мен сарымсақ жоқ...
Dialogue: 0,0:11:43.03,0:11:45.03,Default,,0,0,0,,Сонда 180 млн? А, түсіндім!
Dialogue: 0,0:11:45.03,0:11:47.05,Default,,0,0,0,,Маршрут... Әйтеуір маршрут! (Қате жауап сигналы)
Dialogue: 0,0:11:47.05,0:11:49.69,Default,,0,0,0,,Қарғыс атсын! Мүмкін емес!
Dialogue: 0,0:11:49.69,0:11:52.02,Default,,0,0,0,,Ондай нөмір жоқ, солай ма?
Dialogue: 0,0:11:52.02,0:11:54.67,Default,,0,0,0,,Иә? Хехе... түсіндім.
Dialogue: 0,0:11:54.67,0:11:57.36,Default,,0,0,0,,Жоқ. Жауап тоғыз!
Dialogue: 0,0:11:57.36,0:12:01.05,Default,,0,0,0,,Бұл 9!
Dialogue: 0,0:12:01.05,0:12:04.42,Default,,0,0,0,,(Қате жауап сигналы)
Dialogue: 0,0:12:04.42,0:12:07.04,Default,,0,0,0,,Жауабы n бүтін сан болсын➡
Dialogue: 0,0:12:07.04,0:12:10.41,Default,,0,0,0,,a және b өзара жай натурал сандар болғанда➡
Dialogue: 0,0:12:10.41,0:12:13.04,Default,,0,0,0,,«an + b» түріндегі жай сандар ➡
Dialogue: 0,0:12:13.04,0:12:16.40,Default,,0,0,0,,Шексіз бар
Dialogue: 0,0:12:16.40,0:12:18.41,Default,,0,0,0,,ﾏｰﾍﾞﾗｽ！
Dialogue: 0,0:12:18.41,0:12:22.10,Default,,0,0,0,,[Майк] Үш екінші кезеңді байқап көріңіз, сонымен қатар әдемі тазаланды!
Dialogue: 0,0:12:22.10,0:12:24.10,Default,,0,0,0,,[Майк] Ақырында, соңғы кезеңге өтейік!
Dialogue: 0,0:12:26.36,0:12:28.36,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:12:28.36,0:12:30.44,Default,,0,0,0,,Бірақ осы аптадағы Ұлы Басты ➡ кім жеңеді
Dialogue: 0,0:12:30.44,0:12:32.44,Default,,0,0,0,,Мүлде мүмкін емес.
Dialogue: 0,0:12:38.03,0:12:40.07,Default,,0,0,0,,Сіз Ұлы Басшысыз ба?
Dialogue: 0,0:12:40.07,0:12:43.07,Default,,0,0,0,,Танысқаныма қуаныштымын, Трисли.
Dialogue: 0,0:12:43.07,0:12:45.67,Default,,0,0,0,,Жоқ, сен...
Dialogue: 0,0:12:48.08,0:12:50.70,Default,,0,0,0,,Бұл... DAIGO-san!?
Dialogue: 0,0:12:50.70,0:12:54.07,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:12:54.07,0:12:56.05,Default,,0,0,0,,DAIGO?
Dialogue: 0,0:12:56.05,0:12:59.37,Default,,0,0,0,,Оның қабілеті де, бар болуы да аңыз деп айтылады➡
Dialogue: 0,0:12:59.37,0:13:01.77,Default,,0,0,0,,Ең күшті класс Авангард жауынгері
Dialogue: 0,0:13:01.77,0:13:05.37,Default,,0,0,0,,Егер сен мені жеңсең, сен шынымен жеңімпазсың.
Dialogue: 0,0:13:10.02,0:13:12.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:12.02,0:13:15.44,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:13:15.44,0:13:18.72,Default,,0,0,0,,Осындай қарапайым тұзаққа түсіп қалу...
Dialogue: 0,0:13:18.72,0:13:21.36,Default,,0,0,0,,Хахаха...!
Dialogue: 0,0:13:21.36,0:13:24.71,Default,,0,0,0,,Менімен бір адам ғана төбелесе алады
Dialogue: 0,0:13:24.71,0:13:29.07,Default,,0,0,0,,Интеллект Физикалық күш Уақыт сәті
Dialogue: 0,0:13:29.07,0:13:32.72,Default,,0,0,0,,Бәрін жеңген сен менің қарсыласымсың.
Dialogue: 0,0:13:32.72,0:13:35.22,Default,,0,0,0,,Тағдырың менімен жекпе-жекке жазылған.
Dialogue: 0,0:13:37.28,0:13:40.38,Default,,0,0,0,,Ұрыс! Синдо Куроно!
Dialogue: 0,0:15:27.35,0:15:30.37,Default,,0,0,0,,DAIGO палубасы Royal Paradine болуы керек.
Dialogue: 0,0:15:30.37,0:15:32.42,Default,,0,0,0,,Неліктен хайуанаттар бағының филиалына қосылдыңыз?
Dialogue: 0,0:15:32.42,0:15:35.04,Default,,0,0,0,,Қалағанымдай, қалағанымдай
Dialogue: 0,0:15:35.04,0:15:37.08,Default,,0,0,0,,Бұл менің стилім
Dialogue: 0,0:15:37.08,0:15:39.03,Default,,0,0,0,,Не?
Dialogue: 0,0:15:39.03,0:15:42.38,Default,,0,0,0,,Кәне, Ванга ойнап көңіл көтерейік.
Dialogue: 0,0:15:42.38,0:15:44.98,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！ ｽﾀﾝﾄﾞｱｯﾌﾟ ｻﾞ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:15:47.02,0:15:49.04,Default,,0,0,0,,ｸﾛﾉ･ﾄﾞﾗﾝ！
Dialogue: 0,0:15:49.04,0:15:52.03,Default,,0,0,0,,Амбросийдің басы туралы аңыз
Dialogue: 0,0:15:52.03,0:15:55.36,Default,,0,0,0,,О~ Бұл қауесет шежіресі ме?
Dialogue: 0,0:15:55.36,0:15:58.40,Default,,0,0,0,,Бұл менің бірінші рет төбелесуім.
Dialogue: 0,0:15:58.40,0:16:00.35,Default,,0,0,0,,Оны асыға күтемін~
Dialogue: 0,0:16:00.35,0:16:03.06,Default,,0,0,0,,Сыбыстардың бәрі рас болды.
Dialogue: 0,0:16:03.06,0:16:05.04,Default,,0,0,0,,Сыбыс?
Dialogue: 0,0:16:05.04,0:16:07.69,Default,,0,0,0,,Бүгінгі Ұлы Басшының рөлі DAIGO ➡ екендігі туралы ақпарат бар
Dialogue: 0,0:16:07.69,0:16:09.85,Default,,0,0,0,,Оның бір бөлігі интернетте тараған.
Dialogue: 0,0:16:09.85,0:16:14.53,Default,,0,0,0,,Мен Куроно-кунды ДАЙГО-санмен төбелесе алғаным үшін қызғанамын.
Dialogue: 0,0:16:14.53,0:16:16.57,Default,,0,0,0,,Иә. Егер бұл орын алса➡
Dialogue: 0,0:16:16.57,0:16:19.37,Default,,0,0,0,,Мен ешқашан жеңілмеймін, Куроно
Dialogue: 0,0:16:21.46,0:16:24.69,Default,,0,0,0,,Болашаққа бағыт бер, дүниені аш!
Dialogue: 0,0:16:24.69,0:16:27.60,Default,,0,0,0,,ﾗｲﾄﾞ！ ｸﾛﾉｼﾞｪｯﾄ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:16:27.60,0:16:30.77,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:16:30.77,0:16:32.87,Default,,0,0,0,,ｱｯﾌﾟｽﾄﾘｰﾑ
Dialogue: 0,0:16:37.29,0:16:41.69,Default,,0,0,0,,Жоқ, бұл қазірдің өзінде 4 зиян.
Dialogue: 0,0:16:41.69,0:16:44.58,Default,,0,0,0,,Куроно әлі де 1 зақым алады
Dialogue: 0,0:16:44.58,0:16:46.60,Default,,0,0,0,,Бірақ шайқас осы жерден басталады
Dialogue: 0,0:16:46.60,0:16:49.20,Default,,0,0,0,,DAIGO-ның қадамы келе жатыр
Dialogue: 0,0:16:49.20,0:16:51.35,Default,,0,0,0,,Киелі орынның қорғаушысы айдаһар!
Dialogue: 0,0:16:51.35,0:16:53.36,Default,,0,0,0,,Қазір маған кел!
Dialogue: 0,0:16:53.36,0:16:55.91,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:16:55.91,0:16:58.81,Default,,0,0,0,,ｻﾝｸﾁｭｱﾘｶﾞｰﾄﾞ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:16:58.81,0:17:01.20,Default,,0,0,0,,Санктуар күзетшісі айдаһар шеберлігін белсендіру
Dialogue: 0,0:17:01.20,0:17:04.57,Default,,0,0,0,,Үміт семсері Rechalle Superior Call
Dialogue: 0,0:17:04.57,0:17:06.59,Default,,0,0,0,,Шеберлікпен сурет салу
Dialogue: 0,0:17:06.59,0:17:10.07,Default,,0,0,0,,Қасиетті күшіңізді қазір босатыңыз
Dialogue: 0,0:17:10.07,0:17:12.21,Default,,0,0,0,,ﾘﾐｯﾄﾌﾞﾚｲｸ！
Dialogue: 0,0:17:12.21,0:17:14.71,Default,,0,0,0,,1 немесе одан төмен сыныптың әрбір бірлігі үшін→
Dialogue: 0,0:17:14.71,0:17:17.85,Default,,0,0,0,,Қуат плюс 3000!
Dialogue: 0,0:17:17.85,0:17:20.37,Default,,0,0,0,,Иә? Үзіліс шектелсін бе?
Dialogue: 0,0:17:20.37,0:17:23.02,Default,,0,0,0,,Сіз қадам баспайсыз ба? неге?
Dialogue: 0,0:17:23.02,0:17:25.54,Default,,0,0,0,,Құны жеткіліксіз.
Dialogue: 0,0:17:25.54,0:17:29.42,Default,,0,0,0,,Бірақ адымдай алмаудың еш айыбы жоқ.
Dialogue: 0,0:17:29.42,0:17:33.35,Default,,0,0,0,,Кезбе рыцарь жүзін шақырыңыз
Dialogue: 0,0:17:33.35,0:17:36.05,Default,,0,0,0,,Қадам - бұл Vanguard туралы бәрі емес
Dialogue: 0,0:17:36.05,0:17:39.97,Default,,0,0,0,,Күресудің жолдары көп, дұрыс жауап жоқ.
Dialogue: 0,0:17:39.97,0:17:42.54,Default,,0,0,0,,Сондықтан «Авангард» өте қызықты!
Dialogue: 0,0:17:42.54,0:17:44.84,Default,,0,0,0,,Жауынгерлік әнмен шабуыл!
Dialogue: 0,0:17:46.91,0:17:51.35,Default,,0,0,0,,Қасиетті күзетші айдаһармен бірге Авангардқа шабуыл жасаңыз
Dialogue: 0,0:17:51.35,0:17:54.87,Default,,0,0,0,,ﾁｪｯｸ･ｻﾞ･ﾄﾞﾗｲﾌﾞﾄﾘｶﾞｰ
Dialogue: 0,0:17:54.87,0:17:56.89,Default,,0,0,0,,ｹﾞｯﾄ ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:17:56.89,0:18:00.36,Default,,0,0,0,,1 зақымдануды қалпына келтіріңіз, Пышаққа қуат беріңіз
Dialogue: 0,0:18:00.36,0:18:06.41,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:06.41,0:18:09.87,Default,,0,0,0,,Иә? Шектеу үзілісінің әсері жойылды.
Dialogue: 0,0:18:09.87,0:18:13.74,Default,,0,0,0,,Жарайды, Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:13.74,0:18:15.74,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:18:20.86,0:18:23.20,Default,,0,0,0,,ｸﾞﾚｲﾄ！
Dialogue: 0,0:18:23.20,0:18:25.53,Default,,0,0,0,,ﾅｲｽｶﾞｰﾄﾞ
Dialogue: 0,0:18:25.53,0:18:28.52,Default,,0,0,0,,《Ол жұмбақ адам.
Dialogue: 0,0:18:28.52,0:18:32.52,Default,,0,0,0,,Жекпе-жек те еркін және күшті.
Dialogue: 0,0:18:32.52,0:18:35.52,Default,,0,0,0,,Түсінетін шығарсыз》
Dialogue: 0,0:18:38.88,0:18:42.30,Default,,0,0,0,,《Егер мен бұл адамды жеңсем, мен оны көре аламын.
Dialogue: 0,0:18:42.30,0:18:44.70,Default,,0,0,0,,Менің түсінуім керек болашақ
Dialogue: 0,0:18:44.70,0:18:47.22,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:18:47.22,0:18:51.19,Default,,0,0,0,,Ғарыштық-уақыт хайуандығы Metallica Phoenix!
Dialogue: 0,0:18:51.19,0:18:55.38,Default,,0,0,0,,Уау! Бұл Gear Chronicle ұсынған G құрылғысы ма?
Dialogue: 0,0:18:55.38,0:18:57.56,Default,,0,0,0,,Chrono Джет-тің қадам жасау шеберлігі➡
Dialogue: 0,0:18:57.56,0:19:00.03,Default,,0,0,0,,Пышақты үрлеңіз!
Dialogue: 0,0:19:00.03,0:19:04.20,Default,,0,0,0,,Қоңырау сағаты Fencer Dragon
Dialogue: 0,0:19:04.20,0:19:06.19,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:19:06.19,0:19:09.21,Default,,0,0,0,,Уақыт секірісі Хроно Дран Кел, Джижи!
Dialogue: 0,0:19:09.21,0:19:11.24,Default,,0,0,0,,ｱﾒｰｼﾞﾝｸﾞ！
Dialogue: 0,0:19:11.24,0:19:13.86,Default,,0,0,0,,Бұл Geacronic-тің уақытты басқару мүмкіндігі ме?
Dialogue: 0,0:19:13.86,0:19:15.88,Default,,0,0,0,,Джиджидің шеберлігі
Dialogue: 0,0:19:15.88,0:19:19.27,Default,,0,0,0,,Жоғары айдаһармен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:19.27,0:19:21.30,Default,,0,0,0,,Элейнмен бірге күзет!
Dialogue: 0,0:19:21.30,0:19:23.26,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:19:23.26,0:19:25.86,Default,,0,0,0,,Сағат қоршаушысы айдаһарымен шабуыл!
Dialogue: 0,0:19:25.86,0:19:28.39,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:19:28.39,0:19:32.86,Default,,0,0,0,,Келіңіздер, маған Gear Chronicl мүмкіндіктерін көбірек көрсетіңіздер!
Dialogue: 0,0:19:32.86,0:19:36.54,Default,,0,0,0,,Metallica Phoenix көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:36.54,0:19:38.59,Default,,0,0,0,,Өлмейтін күш!
Dialogue: 0,0:19:38.59,0:19:40.56,Default,,0,0,0,,Тағдырыңды нұрландыратын нұр!
Dialogue: 0,0:19:40.56,0:19:44.36,Default,,0,0,0,,Қараңғылықты кесіп, Ашық қанатты аспан!
Dialogue: 0,0:19:47.03,0:19:50.37,Default,,0,0,0,,Уақыт секірісі!
Dialogue: 0,0:19:50.37,0:19:52.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:52.38,0:19:55.87,Default,,0,0,0,,7-ші айналымнан кейін зақымдану 2-ден 4-ке дейін.
Dialogue: 0,0:19:55.87,0:19:58.29,Default,,0,0,0,,Хроно басым болып қалады...
Dialogue: 0,0:19:58.29,0:20:01.74,Default,,0,0,0,,Мүмкін Куронодағы жігіт...
Dialogue: 0,0:20:01.74,0:20:04.86,Default,,0,0,0,,Керемет! Бұл керемет Куроно
Dialogue: 0,0:20:04.86,0:20:07.55,Default,,0,0,0,,Мен сондай қызу тартысқа түстім→
Dialogue: 0,0:20:07.55,0:20:09.73,Default,,0,0,0,,Менің де күйіп кетуден басқа амалым жоқ.
Dialogue: 0,0:20:09.73,0:20:12.53,Default,,0,0,0,,Генерация аймағы шығарылды!
Dialogue: 0,0:20:16.88,0:20:19.86,Default,,0,0,0,,Менің тағдырым, менің болашағым!
Dialogue: 0,0:20:19.86,0:20:22.83,Default,,0,0,0,,Бұл менің ойымда!
Dialogue: 0,0:20:22.83,0:20:27.43,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:20:35.39,0:20:37.69,Default,,0,0,0,,ｻﾝｸﾁｭｱﾘｶﾞｰﾄﾞ･ﾚｶﾞﾘｱ！
Dialogue: 0,0:20:39.88,0:20:43.37,Default,,0,0,0,,Санктуарды күзетудің доғалық қадам жасау шеберлігі!
Dialogue: 0,0:20:43.37,0:20:45.37,Default,,0,0,0,,Сатушыға қоңырау шалыңыз!
Dialogue: 0,0:20:45.37,0:20:50.08,Default,,0,0,0,,Rechalle және Sanctuary Guard Regalia үшін Пауэр Plus 3000
Dialogue: 0,0:20:50.08,0:20:52.03,Default,,0,0,0,,Шеберлікпен сурет сал!
Dialogue: 0,0:20:52.03,0:20:54.23,Default,,0,0,0,,Battlesong Angel деп атаңыз!
Dialogue: 0,0:20:54.23,0:20:56.60,Default,,0,0,0,,Регалия дағдылары
Dialogue: 0,0:20:56.60,0:20:59.22,Default,,0,0,0,,Әрбір артқы қорғаушы үшін 1 немесе одан төмен →
Dialogue: 0,0:20:59.22,0:21:02.35,Default,,0,0,0,,Алдыңғы қатардағы барлық блоктар үшін қуат плюс 3000
Dialogue: 0,0:21:02.35,0:21:05.86,Default,,0,0,0,,Не!? Battlesong Angel-пен шабуыл жасаңыз!
Dialogue: 0,0:21:05.86,0:21:08.39,Default,,0,0,0,,ｶﾞｰﾄﾞ！ ｲﾝﾀｰｾﾌﾟﾄ！
Dialogue: 0,0:21:08.39,0:21:12.20,Default,,0,0,0,,Қасиетті күзетші Регалиямен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:21:12.20,0:21:14.20,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:21:14.20,0:21:16.35,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:21:16.35,0:21:19.35,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:21:19.35,0:21:21.37,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:21:21.37,0:21:23.38,Default,,0,0,0,,ｹﾞｯﾄ ﾋｰﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:21:23.38,0:21:25.38,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ！
Dialogue: 0,0:21:27.40,0:21:29.51,Default,,0,0,0,,Нотриггер өте жаман
Dialogue: 0,0:21:29.51,0:21:33.54,Default,,0,0,0,,Жеңілдеп қалуға әлі ерте емес пе?
Dialogue: 0,0:21:33.54,0:21:37.96,Default,,0,0,0,,Қасиетті жерімді үлкен нығметтердің күшімен қорға
Dialogue: 0,0:21:37.96,0:21:40.46,Default,,0,0,0,,ｽﾀｰﾗｲﾄ･ﾎｰﾘﾈｽ！
Dialogue: 0,0:21:49.20,0:21:51.24,Default,,0,0,0,,(ｶﾙ)ﾀﾞﾒｰｼﾞ５…｡ (ｹｲ)ﾀﾞﾒｰｼﾞ５
Dialogue: 0,0:21:51.24,0:21:54.12,Default,,0,0,0,,Курононың жігіті бірден бұрышқа тығылды.
Dialogue: 0,0:21:54.12,0:21:57.23,Default,,0,0,0,,Барлығы бір айналымда аударылды.
Dialogue: 0,0:21:57.23,0:22:00.38,Default,,0,0,0,,Бұл аты аңызға айналған жауынгердің құдіреті...
Dialogue: 0,0:22:00.38,0:22:03.60,Default,,0,0,0,,DAIGO мырза күткендей
Dialogue: 0,0:22:03.60,0:22:06.10,Default,,0,0,0,,Куроно жігіт, жақсысың ба?
Dialogue: 0,0:22:08.52,0:22:12.56,Default,,0,0,0,,《Әдетте мен келесі кезеңге өтіп, жарысатын едім, бірақ →
Dialogue: 0,0:22:12.56,0:22:14.59,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:22:14.59,0:22:20.20,Default,,0,0,0,,Сіз әдеттегідей бірдей әдіспен DAIGO-ны жеңе аласыз ба?
Dialogue: 0,0:22:20.20,0:22:25.04,Default,,0,0,0,,Сонымен, Шион мен Токоха сияқты біз де бірдеңені тартып аламыз ба?
Dialogue: 0,0:22:25.04,0:22:28.19,Default,,0,0,0,,Мен нені таңдаймын және не аламын?
Dialogue: 0,0:22:28.19,0:22:30.38,Default,,0,0,0,,Мен не істеуім керек...》
Dialogue: 0,0:22:30.38,0:22:32.41,Default,,0,0,0,,Мықты болыңыз! Хроно!
Dialogue: 0,0:22:32.41,0:22:34.75,Default,,0,0,0,,Өкінішті көрінбе!
Dialogue: 0,0:22:34.75,0:22:36.90,Default,,0,0,0,,Бұл солтүстік-батырдағы қала ма?
Dialogue: 0,0:22:36.90,0:22:39.20,Default,,0,0,0,,ﾏｰﾍﾞﾗｽ！
Dialogue: 0,0:22:39.20,0:22:41.20,Default,,0,0,0,,Менің стилім сияқты.
Dialogue: 0,0:22:41.20,0:22:45.44,Default,,0,0,0,,Қалағаныңды істе, өзіңе ұнайтын нәрсені істе, логика жоқ
Dialogue: 0,0:22:45.44,0:22:48.04,Default,,0,0,0,,Қалауыңызша...
Dialogue: 0,0:22:59.60,0:23:01.70,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:23:06.36,0:23:09.53,Default,,0,0,0,,Колосстың қатты шабуылы!
Dialogue: 0,0:23:09.53,0:23:12.37,Default,,0,0,0,,Жауап әлі табылған жоқ
Dialogue: 0,0:23:12.37,0:23:14.40,Default,,0,0,0,,Біз жүру керек жол →
Dialogue: 0,0:23:14.40,0:23:16.44,Default,,0,0,0,,Біз түсінуіміз керек болашақ➡
Dialogue: 0,0:23:16.44,0:23:18.37,Default,,0,0,0,,Мен оны әлі көре алмаймын
Dialogue: 0,0:23:18.37,0:23:20.71,Default,,0,0,0,,Бірақ менің ойым бар!
Dialogue: 0,0:23:20.71,0:23:23.08,Default,,0,0,0,,Содан кейін оны орындаңыз!
Dialogue: 0,0:23:23.08,0:23:25.95,Default,,0,0,0,,Кел, Синдо Куроно!
Dialogue: 0,0:23:25.95,0:23:28.57,Default,,0,0,0,,Аспанды өрте! Діріл, Жер!
Dialogue: 0,0:23:28.57,0:23:32.67,Default,,0,0,0,,Барлық қауесетті өртті бомбалау жер сілкінісімен жойыңыз!
Dialogue: 0,0:23:34.72,0:23:36.72,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:23:38.74,0:23:40.71,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ！
Dialogue: 0,0:23:40.71,0:23:42.78,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:23:42.78,0:23:44.83,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ！
Dialogue: 0,0:23:44.83,0:23:47.52,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:23:47.52,0:23:49.92,Default,,0,0,0,,Жүр!
Dialogue: 0,0:23:49.92,0:24:01.63,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:01.63,0:24:05.05,Default,,0,0,0,,[Майк] Синдо жеңді!
Dialogue: 0,0:24:05.05,0:24:07.69,Default,,0,0,0,,[Майк] Аты аңызға айналған DAIGO жауынгерін жеңу→
Dialogue: 0,0:24:07.69,0:24:11.04,Default,,0,0,0,,Командалық үш сериядағы жеңіс!
Dialogue: 0,0:24:11.04,0:24:14.75,Default,,0,0,0,,Иә! Куронодан келген жігіт мұны жасады!
Dialogue: 0,0:24:14.75,0:24:17.03,Default,,0,0,0,,Мен сене алар емеспін.
Dialogue: 0,0:24:17.03,0:24:19.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:21.90,0:24:24.04,Default,,0,0,0,,Бұл жақсы жекпе-жек болды
Dialogue: 0,0:24:24.04,0:24:26.06,Default,,0,0,0,,Ең соңында Кимидің өзі➡
Dialogue: 0,0:24:26.06,0:24:28.19,Default,,0,0,0,,Сіз бір нәрсені байқаған сияқтысыз.
Dialogue: 0,0:24:28.19,0:24:30.36,Default,,0,0,0,,Эй
Dialogue: 0,0:24:30.36,0:24:32.51,Default,,0,0,0,,DAIGO мырза
Dialogue: 0,0:24:32.51,0:24:35.70,Default,,0,0,0,,Жауаптар мен дәлелдеу кейінірек келеді.
Dialogue: 0,0:24:35.70,0:24:38.70,Default,,0,0,0,,Егер сіз іздеген нәрсе бар болса.
Dialogue: 0,0:24:38.70,0:24:40.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:40.71,0:24:44.01,Default,,0,0,0,,Қайда бір жерде тағы ұрысайық, Тілек!
Dialogue: 0,0:24:51.38,0:24:54.94,Default,,0,0,0,,Онда жоқ...｡ (Цунето) Ах!
Dialogue: 0,0:24:54.94,0:24:56.96,Default,,0,0,0,,ДАЙГО-санның қолтаңбасын алуды ұмытып кетіппін!
Dialogue: 0,0:24:56.96,0:24:59.01,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:24:59.01,0:25:03.70,Default,,0,0,0,,Цунето Тадо Өмір бойы надандық... Ах...
Dialogue: 0,0:25:03.70,0:25:06.40,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:25:06.40,0:25:09.52,Default,,0,0,0,,Сол DAIGO-ны жеңу үшін➡
Dialogue: 0,0:25:09.52,0:25:12.02,Default,,0,0,0,,Менің көңілім қалды, бірақ бұл толық жеңіліс.
Dialogue: 0,0:25:12.02,0:25:14.07,Default,,0,0,0,,Сәлем
Dialogue: 0,0:25:14.07,0:25:17.04,Default,,0,0,0,,Мен де қазірден бастап бар күшімді саламын.
Dialogue: 0,0:25:17.04,0:25:19.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:25:19.41,0:25:24.01,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:25:26.05,0:25:43.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:27:16.41,0:27:20.30,Default,,0,0,0,,Мен Кими G Quest-ке қатысады деп ешқашан ойламадым.
Dialogue: 0,0:27:20.30,0:27:22.20,Default,,0,0,0,,Кейінгі ой сияқты
Dialogue: 0,0:27:22.20,0:27:25.70,Default,,0,0,0,,Мен Жапонияға Маморуда➡ келдім
Dialogue: 0,0:27:25.70,0:27:28.69,Default,,0,0,0,,Сізбен кездесу үшін
Dialogue: 0,0:27:28.69,0:27:30.74,Default,,0,0,0,,Сонда бұл рас па?
Dialogue: 0,0:27:30.74,0:27:33.70,Default,,0,0,0,,Фика оны бұрмалаған дегенді білдіреді
Dialogue: 0,0:27:33.70,0:27:36.05,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:27:36.05,0:27:39.92,Default,,0,0,0,,Әзірлеуші ретінде сіз мұны маған рұқсатсыз жасадыңыз...
Dialogue: 0,0:27:39.92,0:27:44.36,Default,,0,0,0,,Оның үстіне, Кимидің электрондық поштасына сәйкес, мәселе тек Фикаға қатысты емес.
Dialogue: 0,0:27:44.36,0:27:47.41,Default,,0,0,0,,Не болып жатыр? осы Жапонияда
Dialogue: 0,0:27:47.41,0:27:50.86,Default,,0,0,0,,Мен оны анықтау үшін сізден көмек алғым келеді.
Dialogue: 0,0:27:50.86,0:27:58.55,Default,,0,0,0,,♪♪～
Dialogue: 0,0:27:58.55,0:28:01.39,Default,,0,0,0,,Барлығын ашатын адам, бәлкім➡
Dialogue: 0,0:28:01.39,0:28:04.39,Default,,0,0,0,,Бұл берілісте
Dialogue: 0,0:30:35.41,0:30:38.38,Default,,0,0,0,,Биыл санаулы күндер қалды
Dialogue: 0,0:30:38.38,0:30:41.05,Default,,0,0,0,,Мен оны киіп жүрмін. Рақмет сізге!
Dialogue: 0,0:30:41.05,0:30:46.04,Default,,0,0,0,,Ойлап қарасаңыз, регби дауылында әзілкеш күтпеген жерден Акутагава жүлдесін жеңіп алды →
Dialogue: 0,0:30:46.04,0:30:48.24,Default,,0,0,0,,Әртүрлі тақырыптар талқыланды
Dialogue: 0,0:30:48.24,0:30:53.08,Default,,0,0,0,,Бұл жолы мен 2015 жылы қызу тақырыпқа айналғаны туралы өзімнің алдын ала түсініктеріммен бөлісемін →
Dialogue: 0,0:30:53.08,0:30:55.45,Default,,0,0,0,,Бірден үлкен тергеу!
Dialogue: 0,0:30:55.45,0:31:00.45,Default,,0,0,0,,Осы жылдың трендтері қаншалықты есіңізде?
Dialogue: 0,0:31:01.95,0:31:07.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory