Dialogue: 0,0:18:20.93,0:18:23.22,Default,,0,0,0,,Тс. Қашып барады.
Dialogue: 0,0:18:24.18,0:18:27.85,Default,,0,0,0,,Дұрыс, енді олар қол жетпейтін жерде.
Dialogue: 0,0:18:27.94,0:18:30.19,Default,,0,0,0,,(Кугисаки) Жақсы істедің. Арқаңнан қағып қояйын.
Dialogue: 0,0:18:30.27,0:18:31.69,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:18:32.94,0:18:35.94,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:18:36.03,0:18:37.86,Default,,0,0,0,,Мүмкін емес. Рақмет.
Dialogue: 0,0:18:37.95,0:18:41.20,Default,,0,0,0,,(Итадори) Ха! (Кугисаки) Уф
Dialogue: 0,0:18:42.28,0:18:44.99,Default,,0,0,0,,Бвах!
Dialogue: 0,0:18:45.08,0:18:47.21,Default,,0,0,0,,Олар бізден озып кету үшін қиып өтті ме?
Dialogue: 0,0:18:47.29,0:18:50.21,Default,,0,0,0,,Олар…
Dialogue: 0,0:18:51.00,0:18:54.50,Default,,0,0,0,,Уф… гүрс…
Dialogue: 0,0:18:54.59,0:18:56.51,Default,,0,0,0,,Кугисаки!
Dialogue: 0,0:18:56.59,0:18:58.22,Default,,0,0,0,,(Каишо) Қорықпа—ағамның қаны менікімен бірдей қасиетке ие емес.
Dialogue: 0,0:18:58.30,0:19:01.97,Default,,0,0,0,,Менікі де емес—
Dialogue: 0,0:19:02.05,0:19:04.60,Default,,0,0,0,,Егер басынан-аяғына дейін соған малынбасаң, өлмейсің.
Dialogue: 0,0:19:04.68,0:19:08.23,Default,,0,0,0,,Дегенмен, жанды қинайтындай ауыр болады.
Dialogue: 0,0:19:08.31,0:19:11.44,Default,,0,0,0,,Біздің сиқырымыз осы жерден басталады.
Dialogue: 0,0:19:13.52,0:19:15.15,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:15.98,0:19:20.16,Default,,0,0,0,,Эрозия және шіру сиқыры
Dialogue: 0,0:19:20.24,0:19:24.33,Default,,0,0,0,,Шіру
Dialogue: 0,0:19:24.41,0:19:26.16,Default,,0,0,0,,Шырышты қабықтар, ашық жаралар—
Dialogue: 0,0:19:27.12,0:19:30.17,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:19:33.92,0:19:35.13,Default,,0,0,0,,Иә
Dialogue: 0,0:19:35.80,0:19:37.13,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:37.21,0:19:39.13,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:19:40.05,0:19:42.14,Default,,0,0,0,,Коррозия кірген жерден басталады.
Dialogue: 0,0:19:42.89,0:19:44.76,Default,,0,0,0,,Сол жақтағы балаға ең көбі 15 минут.
Dialogue: 0,0:19:44.85,0:19:47.14,Default,,0,0,0,,Ал қызға, меніңше, 10 минут.
Dialogue: 0,0:19:48.10,0:19:50.14,Default,,0,0,0,,(Итадори) «Ха! Кугисаки, сол қанға тиме!»
Dialogue: 0,0:19:50.23,0:19:53.06,Default,,0,0,0,,«Мен білмеймін…»
Dialogue: 0,0:19:53.73,0:19:57.69,Default,,0,0,0,,«Ка…»
Dialogue: 0,0:19:57.78,0:20:01.65,Default,,0,0,0,,«Қаш!»
Dialogue: 0,0:20:01.74,0:20:06.16,Default,,0,0,0,,«Арқаңды бұр!»
Dialogue: 0,0:20:07.16,0:20:09.66,Default,,0,0,0,,«Кугисаки, одан да жылдам жүгіресің бе?»
Dialogue: 0,0:20:10.62,0:20:11.66,Default,,0,0,0,,«Мүмкін емес!»
Dialogue: 0,0:20:12.42,0:20:15.67,Default,,0,0,0,,(Итадори) «Һмм…» (Кугисаки) Еһ!
Dialogue: 0,0:20:15.75,0:20:17.67,Default,,0,0,0,,Басталған сәт
Dialogue: 0,0:20:17.75,0:20:21.30,Default,,0,0,0,,Арқамды маған қалдыр.
Dialogue: 0,0:20:21.38,0:20:25.35,Default,,0,0,0,,Сенің үстіңе сенім артамын.
Dialogue: 0,0:20:25.43,0:20:27.68,Default,,0,0,0,,Қандай жылдамдық — үстіне адамды арқалап жүр.
Dialogue: 0,0:20:27.76,0:20:31.94,Default,,0,0,0,,Тс. Қашып барады.
Dialogue: 0,0:20:32.02,0:20:34.44,Default,,0,0,0,,Дұрыс, енді олар қол жетпейтін жерде.
Dialogue: 0,0:20:35.19,0:20:39.23,Default,,0,0,0,,(Кугисаки) Жақсы істедің. Арқаңнан қағып қояйын.
Dialogue: 0,0:20:41.32,0:20:42.74,Default,,0,0,0,,Тағы біреу қаза тапты.
Dialogue: 0,0:20:47.83,0:20:49.37,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:20:49.45,0:20:50.83,Default,,0,0,0,,Мүмкін емес. Рақмет.
Dialogue: 0,0:20:51.91,0:20:53.00,Default,,0,0,0,,Иә
Dialogue: 0,0:20:53.08,0:20:54.33,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:54.96,0:20:55.83,Default,,0,0,0,,Не болды, жігіт?
Dialogue: 0,0:20:56.75,0:21:00.09,Default,,0,0,0,,(Итадори) Ха! (Кугисаки) Уф
Dialogue: 0,0:21:00.17,0:21:04.09,Default,,0,0,0,,Бвах!
Dialogue: 0,0:21:04.18,0:21:08.39,Default,,0,0,0,,Олар бізден озып кету үшін қиып өтті ме?
Dialogue: 0,0:21:08.47,0:21:12.60,Default,,0,0,0,,Олар…
Dialogue: 0,0:21:12.68,0:21:13.85,Default,,0,0,0,,Сен түсінбейсің ғой, иә?
Dialogue: 0,0:21:16.02,0:21:20.48,Default,,0,0,0,,Уф… гүрс…
Dialogue: 0,0:21:20.57,0:21:21.48,Default,,0,0,0,,Егер ол белгілі бір дәрежеде бар күшін салмайтын болса—
Dialogue: 0,0:21:21.99,0:21:23.53,Default,,0,0,0,,О
Dialogue: 0,0:21:23.61,0:21:24.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:25.99,0:21:27.20,Default,,0,0,0,,Кугисаки!
Dialogue: 0,0:21:27.28,0:21:28.53,Default,,0,0,0,,(Каишо) Қорықпа—ағамның қаны менікімен бірдей қасиетке ие емес.
Dialogue: 0,0:21:28.62,0:21:30.99,Default,,0,0,0,,Менікі де емес—
Dialogue: 0,0:21:31.08,0:21:31.91,Default,,0,0,0,,Егер менің шарттарыма келіссең, мен жүрегіңді жазып, қайта тірілтамын.
Dialogue: 0,0:21:32.50,0:21:35.71,Default,,0,0,0,,Егер басынан-аяғына дейін соған малынбасаң, өлмейсің.
Dialogue: 0,0:21:35.79,0:21:38.42,Default,,0,0,0,,Дегенмен, жанды қинайтындай ауыр болады.
Dialogue: 0,0:21:38.50,0:21:43.13,Default,,0,0,0,,Біздің сиқырымыз осы жерден басталады.
Dialogue: 0,0:21:43.21,0:21:47.43,Default,,0,0,0,,Эрозия және шіру сиқыры
Dialogue: 0,0:21:47.51,0:21:53.43,Default,,0,0,0,,Шіру
Dialogue: 0,0:21:53.52,0:21:56.44,Default,,0,0,0,,Шырышты қабықтар, ашық жаралар—
Dialogue: 0,0:21:56.52,0:21:58.94,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:21:59.02,0:22:01.98,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:22:02.07,0:22:06.15,Default,,0,0,0,,Коррозия кірген жерден басталады.
Dialogue: 0,0:22:06.24,0:22:08.45,Default,,0,0,0,,Сол жақтағы балаға ең көбі 15 минут.
Dialogue: 0,0:22:08.53,0:22:10.95,Default,,0,0,0,,Ал қызға, меніңше, 10 минут.
Dialogue: 0,0:22:11.03,0:22:14.37,Default,,0,0,0,,(Итадори) «Ха! Кугисаки, сол қанға тиме!»
Dialogue: 0,0:22:18.92,0:22:21.50,Default,,0,0,0,,Ммм
Dialogue: 0,0:22:21.59,0:22:23.92,Default,,0,0,0,,«Мен білмеймін…»
Dialogue: 0,0:22:24.01,0:22:25.88,Default,,0,0,0,,«Ка…»
Dialogue: 0,0:22:25.97,0:22:27.93,Default,,0,0,0,,«Қаш!»
Dialogue: 0,0:22:28.01,0:22:30.51,Default,,0,0,0,,«Арқаңды бұр!»
Dialogue: 0,0:22:30.60,0:22:32.47,Default,,0,0,0,,«Кугисаки, одан да жылдам жүгіресің бе?»
Dialogue: 0,0:22:32.56,0:22:36.48,Default,,0,0,0,,«Мүмкін емес!»
Dialogue: 0,0:22:36.56,0:22:39.48,Default,,0,0,0,,(Итадори) «Һмм…» (Кугисаки) Еһ!
Dialogue: 0,0:22:44.78,0:22:46.69,Default,,0,0,0,,Арқамды маған қалдыр.
Dialogue: 0,0:22:46.78,0:22:49.16,Default,,0,0,0,,Сенің үстіңе сенім артамын.
Dialogue: 0,0:22:49.16,0:22:49.66,Default,,0,0,0,,Қандай жылдамдық — үстіне адамды арқалап жүр.
Dialogue: 0,0:22:49.45,0:22:51.70,Default,,0,0,0,,Тс. Қашып барады. Дұрыс, енді олар қол жетпейтін жерде.
Dialogue: 0,0:22:51.70,0:22:53.70,Default,,0,0,0,,(Кугисаки) Жақсы істедің. Арқаңнан қағып қояйын. Жарайды, жарайды.
Dialogue: 0,0:22:53.70,0:22:55.37,Default,,0,0,0,,Мүмкін емес. Рақмет.
Dialogue: 0,0:22:55.45,0:22:59.54,Default,,0,0,0,,(Итадори) Ха! (Кугисаки) Уф
Dialogue: 0,0:23:00.12,0:23:01.92,Default,,0,0,0,,Бвах!
Dialogue: 0,0:23:03.42,0:23:04.25,Default,,0,0,0,,Не?
Dialogue: 0,0:23:04.34,0:23:07.22,Default,,0,0,0,,Олар бізден озып кету үшін қиып өтті ме?
Dialogue: 0,0:23:07.30,0:23:09.55,Default,,0,0,0,,Олар…
Dialogue: 0,0:23:09.63,0:23:12.60,Default,,0,0,0,,Уф… гүрс…
Dialogue: 0,0:23:12.68,0:23:15.93,Default,,0,0,0,,Кугисаки!
Dialogue: 0,0:23:16.02,0:23:17.02,Default,,0,0,0,,(Каишо) Қорықпа—ағамның қаны менікімен бірдей қасиетке ие емес.
Dialogue: 0,0:23:17.10,0:23:21.90,Default,,0,0,0,,Менікі де емес—
Dialogue: 0,0:23:22.56,0:23:23.90,Default,,0,0,0,,Егер басынан-аяғына дейін соған малынбасаң, өлмейсің.
Dialogue: 0,0:23:23.98,0:23:25.90,Default,,0,0,0,,Дегенмен, жанды қинайтындай ауыр болады.
Dialogue: 0,0:23:25.98,0:23:29.40,Default,,0,0,0,,Біздің сиқырымыз осы жерден басталады.
Dialogue: 0,0:23:31.03,0:23:32.37,Default,,0,0,0,,Кеттік
