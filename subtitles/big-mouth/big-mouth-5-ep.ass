Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.38,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:07.38,0:00:07.71,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:07.38,0:00:07.71,Default,,0,0,0,,Бұл хост тым жұқа емес пе?
Dialogue: 0,0:00:07.71,0:00:10.13,Default,,0,0,0,,Бұл хост тым жұқа емес пе?
Dialogue: 0,0:00:10.21,0:00:11.92,Default,,0,0,0,,Мен мәселені ести алмаймын!
Dialogue: 0,0:00:12.38,0:00:15.05,Default,,0,0,0,,Оқылған нәрсенің жауабы
Dialogue: 0,0:00:15.14,0:00:17.80,Default,,0,0,0,,Алып кетуді доғарыңыз
Dialogue: 0,0:00:17.89,0:00:19.22,Default,,0,0,0,,«Spankify Radio»
Dialogue: 0,0:00:22.14,0:00:23.31,Default,,0,0,0,,«Лосьон»
Dialogue: 0,0:00:24.73,0:00:25.44,Default,,0,0,0,,Сәлем
Dialogue: 0,0:00:25.52,0:00:26.69,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:00:29.23,0:00:30.57,Default,,0,0,0,,Тың шұлық?
Dialogue: 0,0:00:31.44,0:00:34.11,Default,,0,0,0,,Өйткені резеңке толық созылған.
Dialogue: 0,0:00:34.20,0:00:36.53,Default,,0,0,0,,Мен оларды енді кие алмаймын.
Dialogue: 0,0:00:36.61,0:00:37.16,Default,,0,0,0,,Иә
Dialogue: 0,0:00:37.24,0:00:39.41,Default,,0,0,0,,Маған Киелі кітапты беріңізші, Рабби.
Dialogue: 0,0:00:39.49,0:00:40.04,Default,,0,0,0,,Сәлем
Dialogue: 0,0:00:40.12,0:00:40.91,Default,,0,0,0,,«Бейсбол карталары»
Dialogue: 0,0:00:40.99,0:00:41.95,Default,,0,0,0,,«Спортшы»
Dialogue: 0,0:00:45.67,0:00:49.96,Default,,0,0,0,,Мен Сюзанның суретін басып шығардым.
Dialogue: 0,0:00:50.04,0:00:52.01,Default,,0,0,0,,LinkedIn де өте керемет.
Dialogue: 0,0:00:52.09,0:00:54.09,Default,,0,0,0,,Дикіңізді тез шығарыңыз
Dialogue: 0,0:00:54.17,0:00:56.55,Default,,0,0,0,,Басқаларға көрсету мүмкін емес
Dialogue: 0,0:00:56.63,0:00:58.34,Default,,0,0,0,,Бұл сыпайы.
Dialogue: 0,0:00:58.93,0:01:01.14,Default,,0,0,0,,Иә, көп.
Dialogue: 0,0:01:02.85,0:01:04.52,Default,,0,0,0,,бастайық
Dialogue: 0,0:01:05.02,0:01:09.31,Default,,0,0,0,,Жақсы, зейініңді жинақтап, ойлан.
Dialogue: 0,0:01:09.69,0:01:10.65,Default,,0,0,0,,Қызықты
Dialogue: 0,0:01:10.90,0:01:12.28,Default,,0,0,0,,Ұнады!
Dialogue: 0,0:01:13.28,0:01:14.40,Default,,0,0,0,,Жақсы…
Dialogue: 0,0:01:14.82,0:01:17.49,Default,,0,0,0,,Майлы қызанақ сізді кондитер етті ме?
Dialogue: 0,0:01:17.57,0:01:20.12,Default,,0,0,0,,Түшкіру сияқты
Dialogue: 0,0:01:20.20,0:01:21.99,Default,,0,0,0,,Түшкіру эротикалық ма?
Dialogue: 0,0:01:22.08,0:01:23.75,Default,,0,0,0,,Кез келген нәрсе эротикалық
Dialogue: 0,0:01:23.83,0:01:24.70,Default,,0,0,0,,Тіпті орындық па?
Dialogue: 0,0:01:24.79,0:01:25.83,Default,,0,0,0,,Жоғарыға шығыңыз
Dialogue: 0,0:01:25.91,0:01:26.58,Default,,0,0,0,,Ұшақтар ше?
Dialogue: 0,0:01:26.66,0:01:28.29,Default,,0,0,0,,Бұл ұшатын үлкен серік.
Dialogue: 0,0:01:28.37,0:01:30.17,Default,,0,0,0,,Түймелері бар жейделер ше?
Dialogue: 0,0:01:30.25,0:01:32.67,Default,,0,0,0,,Бұл жарылған клитор.
Dialogue: 0,0:01:32.75,0:01:33.30,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:02:09.79,0:02:13.42,Default,,0,0,0,,Кеудесіне таңғыш байланған сияқты
Dialogue: 0,0:02:13.50,0:02:16.80,Default,,0,0,0,,Гвинея шошқасы, мынау не деген көкірекше?
Dialogue: 0,0:02:16.88,0:02:18.30,Default,,0,0,0,,Бұл жалғыз нұсқа
Dialogue: 0,0:02:18.42,0:02:19.72,Default,,0,0,0,,Оны лақтырыңыз
Dialogue: 0,0:02:19.80,0:02:22.14,Default,,0,0,0,,Гормондар сізге пайдалы ма?
Dialogue: 0,0:02:22.22,0:02:23.10,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:02:23.18,0:02:27.77,Default,,0,0,0,,Ауырады, түкті болады немесе ісінеді.
Dialogue: 0,0:02:27.85,0:02:29.89,Default,,0,0,0,,Мен қазір жылағым келеді
Dialogue: 0,0:02:29.98,0:02:31.40,Default,,0,0,0,,Бітір!
Dialogue: 0,0:02:31.48,0:02:32.81,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:02:32.90,0:02:35.57,Default,,0,0,0,,Бір-бірімізді ренжітуді доғарайық
Dialogue: 0,0:02:35.65,0:02:39.28,Default,,0,0,0,,Мен сені жақсы сезінемін
Dialogue: 0,0:02:39.36,0:02:41.32,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:02:41.41,0:02:43.95,Default,,0,0,0,,Джакузи туралы ұмыттыңыз ба?
Dialogue: 0,0:02:44.03,0:02:45.03,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:02:45.12,0:02:46.58,Default,,0,0,0,,Мен оны үнемі көремін
Dialogue: 0,0:02:46.66,0:02:49.75,Default,,0,0,0,,Романтикалық фильм көргенде қатты толқыдым.
Dialogue: 0,0:02:49.83,0:02:52.75,Default,,0,0,0,,Актердің қимылдары таң қалдырды
Dialogue: 0,0:02:52.83,0:02:55.55,Default,,0,0,0,,Бұл жақсы сезінді, солай емес пе?
Dialogue: 0,0:02:55.63,0:02:59.13,Default,,0,0,0,,Мен ішімнің астынан бірдеңені сездім...
Dialogue: 0,0:02:59.22,0:03:03.30,Default,,0,0,0,,Әлі алда. Мен сенің кисіңді көбірек сезіне аламын.
Dialogue: 0,0:03:03.39,0:03:06.85,Default,,0,0,0,,Жүр, көтерейік.
Dialogue: 0,0:03:06.93,0:03:07.47,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:03:07.56,0:03:08.81,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:09.27,0:03:13.27,Default,,0,0,0,,Енді сіз одан толық ләззат аласыз!
Dialogue: 0,0:03:13.35,0:03:14.61,Default,,0,0,0,,«Бриджтон орта мектебі»
Dialogue: 0,0:03:15.11,0:03:18.57,Default,,0,0,0,,Кітапқа шолулар өмірде пайдалы ма?
Dialogue: 0,0:03:18.65,0:03:22.36,Default,,0,0,0,,НБА ойыншылары эссе жазады деп ойламаймын.
Dialogue: 0,0:03:22.45,0:03:24.70,Default,,0,0,0,,Мен "Абрака күнделікті"
Dialogue: 0,0:03:24.78,0:03:28.04,Default,,0,0,0,,Бірақ бұл атау тарихи фантастика болды, солай емес пе?
Dialogue: 0,0:03:28.12,0:03:31.37,Default,,0,0,0,,Менің тарихи пысығым туралы не айтасыз?
Dialogue: 0,0:03:31.46,0:03:33.83,Default,,0,0,0,,Басқа ештеңе оқымаңыз
Dialogue: 0,0:03:33.92,0:03:37.80,Default,,0,0,0,,Менің кітабымның мазмұнын айтқым келеді ме?
Dialogue: 0,0:03:38.34,0:03:41.38,Default,,0,0,0,,Не? ортағасырлық астрономның әңгімесі
Dialogue: 0,0:03:41.47,0:03:43.22,Default,,0,0,0,,«Күмән Андреас»
Dialogue: 0,0:03:41.47,0:03:43.22,Default,,0,0,0,,Ғаламшарды ашты және Ватиканға шақырылды
Dialogue: 0,0:03:43.22,0:03:45.18,Default,,0,0,0,,Ғаламшарды ашты және Ватиканға шақырылды
Dialogue: 0,0:03:45.26,0:03:47.31,Default,,0,0,0,,Сіз жезөкшені өлтірдіңіз бе?
Dialogue: 0,0:03:47.39,0:03:50.77,Default,,0,0,0,,Жоқ, бірақ жалған куәлік.
Dialogue: 0,0:03:52.23,0:03:54.77,Default,,0,0,0,,О, жақсы...
Dialogue: 0,0:03:55.81,0:03:56.61,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:56.69,0:04:00.28,Default,,0,0,0,,Бұл кітап өте қызықты.
Dialogue: 0,0:04:00.36,0:04:03.99,Default,,0,0,0,,«Гибралтар жартасы» марапаттарға ие болды.
Dialogue: 0,0:04:04.07,0:04:07.12,Default,,0,0,0,,Оқу керек Густаво керемет
Dialogue: 0,0:04:07.70,0:04:09.04,Default,,0,0,0,,Бұл қандай кітап?
Dialogue: 0,0:04:09.87,0:04:11.41,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:11.96,0:04:14.54,Default,,0,0,0,,Испан рыцары Густаво
Dialogue: 0,0:04:14.62,0:04:19.67,Default,,0,0,0,,Бұл Мавриан ханшайымы Фатимаға ғашық болу туралы оқиға.
Dialogue: 0,0:04:19.75,0:04:20.30,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:04:20.38,0:04:24.88,Default,,0,0,0,,Католиктер мен мұсылмандар арасындағы тыйым салынған махаббат
Dialogue: 0,0:04:24.97,0:04:27.85,Default,,0,0,0,,Густаво Фатимаға ғашық
Dialogue: 0,0:04:27.93,0:04:28.47,Default,,0,0,0,,Жетті…
Dialogue: 0,0:04:28.55,0:04:33.98,Default,,0,0,0,,Сол жерде сыған сиқыршысы оған ат болу қабілетін берді.
Dialogue: 0,0:04:34.14,0:04:37.36,Default,,0,0,0,,Олар қорада қорылдап жатыр
Dialogue: 0,0:04:37.44,0:04:40.65,Default,,0,0,0,,Бір-бірімізді сүйсек те, біз ешқашан бірге болмаймыз
Dialogue: 0,0:04:40.73,0:04:41.57,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:41.65,0:04:46.36,Default,,0,0,0,,Субұрқақтың басында отырып, ішімнен отшашулар атқылағандай.
Dialogue: 0,0:04:46.45,0:04:47.95,Default,,0,0,0,,Себебі мен түсінемін
Dialogue: 0,0:04:48.53,0:04:49.49,Default,,0,0,0,,Оқыңыз
Dialogue: 0,0:04:49.58,0:04:51.45,Default,,0,0,0,,Жарайды, мен мұны істеймін.
Dialogue: 0,0:04:51.54,0:04:53.08,Default,,0,0,0,,«Испан мейрамханасы»
Dialogue: 0,0:04:54.41,0:04:55.46,Default,,0,0,0,,Қане тост айтайық
Dialogue: 0,0:04:55.54,0:05:00.25,Default,,0,0,0,,Ең жақсы достары Ник пен Эндрюді кездестірген ұлдары
Dialogue: 0,0:05:00.34,0:05:02.05,Default,,0,0,0,,Ал әйелдерге
Dialogue: 0,0:05:02.13,0:05:06.55,Default,,0,0,0,,Таңғажайып сұлу және нәзік әйелге
Dialogue: 0,0:05:06.97,0:05:07.72,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:10.56,0:05:13.56,Default,,0,0,0,,Неге нан әкелмедің?
Dialogue: 0,0:05:13.64,0:05:14.85,Default,,0,0,0,,Тағы да бар
Dialogue: 0,0:05:14.93,0:05:15.98,Default,,0,0,0,,Сіз оның жағындасыз ба?
Dialogue: 0,0:05:16.06,0:05:18.02,Default,,0,0,0,,Жай даяшы
Dialogue: 0,0:05:18.10,0:05:22.40,Default,,0,0,0,,Мен даяшының көмекшісімін. Мені рұқсатсыз жоғарылатпаңыз.
Dialogue: 0,0:05:22.48,0:05:24.36,Default,,0,0,0,,Бұл дәмді көрінеді
Dialogue: 0,0:05:26.03,0:05:29.87,Default,,0,0,0,,Эллиот әйелінің тамақ әзірлеуін күтіп отыр.
Dialogue: 0,0:05:29.95,0:05:33.33,Default,,0,0,0,,Бұл оған байланысты. Мен оны салқындағанша жеймін.
Dialogue: 0,0:05:33.41,0:05:34.20,Default,,0,0,0,,Бұл сұмдық.
Dialogue: 0,0:05:34.29,0:05:36.62,Default,,0,0,0,,Тамақтан улануды ұмыттыңыз ба?
Dialogue: 0,0:05:36.71,0:05:37.37,Default,,0,0,0,,Соңғы үш күнде, әдеттегідей, әр түнде түн ортасынан кейін бір бет.
Dialogue: 0,0:05:37.46,0:05:40.67,Default,,0,0,0,,Ол кезде де суықтың кесірінен...
Dialogue: 0,0:05:40.75,0:05:42.30,Default,,0,0,0,,Ағып кеткен нәжіс
Dialogue: 0,0:05:42.38,0:05:43.80,Default,,0,0,0,,Төсекте
Dialogue: 0,0:05:43.88,0:05:45.55,Default,,0,0,0,,Тарақ жеуді тоқтатуым керек пе?
Dialogue: 0,0:05:45.63,0:05:49.39,Default,,0,0,0,,Тарақтарға жеңілгеніңізді мойындауға қарсысыз ба?
Dialogue: 0,0:05:49.47,0:05:54.72,Default,,0,0,0,,Оқымайтыныңды білемін, бірақ мен ең жақсы кітапты таптым.
Dialogue: 0,0:05:54.81,0:05:56.98,Default,,0,0,0,,Сыйлық алған тарихи роман.
Dialogue: 0,0:05:57.06,0:05:59.06,Default,,0,0,0,,Мен тарихқа қызықпаймын.
Dialogue: 0,0:05:59.15,0:06:01.44,Default,,0,0,0,,Мен оны өте жақсы көремін
Dialogue: 0,0:06:01.52,0:06:06.19,Default,,0,0,0,,Фатима мен Густаво арасындағы махаббат хикаясы.
Dialogue: 0,0:06:07.78,0:06:10.91,Default,,0,0,0,,Мен қатты бауыр басып қалдым.
Dialogue: 0,0:06:10.99,0:06:12.74,Default,,0,0,0,,Неліктен көзіңді қыстың?
Dialogue: 0,0:06:12.83,0:06:16.25,Default,,0,0,0,,Бұл эротикалық роман. Оқыңыз.
Dialogue: 0,0:06:16.33,0:06:17.37,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:06:17.46,0:06:18.75,Default,,0,0,0,,«Гибралтар жартасы»?
Dialogue: 0,0:06:18.83,0:06:21.42,Default,,0,0,0,,Бірге оқимыз
Dialogue: 0,0:06:21.50,0:06:24.92,Default,,0,0,0,,Біз оқуды бірге өткізетін уақытымызға қосамыз.
Dialogue: 0,0:06:25.00,0:06:29.34,Default,,0,0,0,,Өткен күні мен О.Ж. Симпсонның «Егер мен сені өлтірдім».
Dialogue: 0,0:06:29.43,0:06:31.30,Default,,0,0,0,,Сосын ұрсып қалдық.
Dialogue: 0,0:06:31.39,0:06:33.85,Default,,0,0,0,,Әйелді өлтіру емес, жыныстық қатынас
Dialogue: 0,0:06:33.93,0:06:35.47,Default,,0,0,0,,Әйелінің сүйіктісін де өлтірді.
Dialogue: 0,0:06:35.56,0:06:38.81,Default,,0,0,0,,Даяшы, менікі қайда?
Dialogue: 0,0:06:38.89,0:06:40.90,Default,,0,0,0,,Тарақтар... Дәретхана қайда?
Dialogue: 0,0:06:40.98,0:06:42.73,Default,,0,0,0,,Сіз де нан әкеліңіз.
Dialogue: 0,0:06:42.86,0:06:44.11,Default,,0,0,0,,«Қатарынан 14 күн аралау жоқ»
Dialogue: 0,0:06:44.19,0:06:47.90,Default,,0,0,0,,«Егер олар сенің осы сағатта серуендеп жүргеніңді білсе».
Dialogue: 0,0:06:47.99,0:06:51.03,Default,,0,0,0,,«Мен университеттен шығарамын»
Dialogue: 0,0:06:51.11,0:06:54.03,Default,,0,0,0,,«Бірақ мен мінуге деген құштарлығымды басқара алмаймын».
Dialogue: 0,0:06:54.12,0:06:56.29,Default,,0,0,0,,Фатима, мұнда кел.
Dialogue: 0,0:06:56.37,0:07:01.54,Default,,0,0,0,,Өтінемін, маған тез тиіп, жылы ләззатпен орап алшы.
Dialogue: 0,0:07:02.13,0:07:03.67,Default,,0,0,0,,Түскі ас іштің бе?
Dialogue: 0,0:07:04.59,0:07:05.84,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:07:05.92,0:07:07.38,Default,,0,0,0,,Бұл шынымен де қызықты ма?
Dialogue: 0,0:07:07.46,0:07:10.51,Default,,0,0,0,,Густавоның қимылдарын қадағалау
Dialogue: 0,0:07:10.59,0:07:13.72,Default,,0,0,0,,Дәл осы жерде Фатима астрономия зертханасын салды.
Dialogue: 0,0:07:13.80,0:07:16.35,Default,,0,0,0,,Сіз «Андреасқа күмәндану» кітабын оқыдыңыз ба?
Dialogue: 0,0:07:16.43,0:07:18.43,Default,,0,0,0,,Ол сонымен қатар зертхана салды.
Dialogue: 0,0:07:18.52,0:07:23.02,Default,,0,0,0,,Жұлдыздарға қарап, «әлем үлкен» екенін түсініңіз.
Dialogue: 0,0:07:23.10,0:07:24.23,Default,,0,0,0,,Мен қанша кішкентай болсам да!
Dialogue: 0,0:07:24.31,0:07:26.73,Default,,0,0,0,,Кітапхана, тыныш бол.
Dialogue: 0,0:07:26.82,0:07:28.23,Default,,0,0,0,,Бұл оқуға кедергі.
Dialogue: 0,0:07:28.32,0:07:29.49,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:07:29.57,0:07:32.03,Default,,0,0,0,,Мұғалімнің жылап тұрған түрін көрейік.
Dialogue: 0,0:07:32.11,0:07:34.66,Default,,0,0,0,,«Фатиманың көйлегінен»
Dialogue: 0,0:07:34.74,0:07:37.87,Default,,0,0,0,,«Менің жетілген кеудем толып жатыр...»
Dialogue: 0,0:07:39.87,0:07:43.67,Default,,0,0,0,,Мен айттым ғой, солай ма? Мына көкірекше ұсқынсыз
Dialogue: 0,0:07:43.75,0:07:45.96,Default,,0,0,0,,Ақтау жоқ
Dialogue: 0,0:07:46.04,0:07:48.00,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:49.80,0:07:51.47,Default,,0,0,0,,Сондай-ақ «Гибралтар жартасы»?
Dialogue: 0,0:07:51.55,0:07:53.51,Default,,0,0,0,,Қыздар неге сонша жынды?
Dialogue: 0,0:07:53.59,0:07:56.47,Default,,0,0,0,,Романтика - ең жақсы
Dialogue: 0,0:07:56.55,0:08:00.06,Default,,0,0,0,,Фатима мен Густаво
Dialogue: 0,0:08:00.14,0:08:02.44,Default,,0,0,0,,Сен менің сигімді сүйіп тұрсың ба?
Dialogue: 0,0:08:02.52,0:08:03.39,Default,,0,0,0,,Дикті сүйіңіз бе?
Dialogue: 0,0:08:03.48,0:08:04.31,Default,,0,0,0,,Түсінесің бе?
Dialogue: 0,0:08:04.40,0:08:08.57,Default,,0,0,0,,Егер бұл жыныстық қатынас болса, сіз жыныстық қатынасқа түспейсіз. Мәселе мынада.
Dialogue: 0,0:08:08.65,0:08:10.15,Default,,0,0,0,,Нүкте.
Dialogue: 0,0:08:10.23,0:08:12.15,Default,,0,0,0,,Әлі түсінбедіңіз бе?
Dialogue: 0,0:08:12.24,0:08:13.07,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:08:13.15,0:08:14.57,Default,,0,0,0,,Мен толқып тұрмын.
Dialogue: 0,0:08:14.66,0:08:15.99,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:08:16.07,0:08:19.49,Default,,0,0,0,,Сіз таң қалдыңыз ба? Қыздар да мүйізді болады.
Dialogue: 0,0:08:21.25,0:08:22.41,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:08:22.50,0:08:23.41,Default,,0,0,0,,Әрине
Dialogue: 0,0:08:23.50,0:08:26.29,Default,,0,0,0,,Қыздар лас әзіл айтпайды
Dialogue: 0,0:08:27.84,0:08:31.30,Default,,0,0,0,,Мен кітапқа шолу жазуым керек.
Dialogue: 0,0:08:31.38,0:08:32.84,Default,,0,0,0,,Сол кітапты маған қарызға беріңіз.
Dialogue: 0,0:08:32.92,0:08:37.22,Default,,0,0,0,,Мен не жоспарлап жатқаныңызды білмеймін, бірақ қалағаныңызды жасаңыз.
Dialogue: 0,0:08:37.35,0:08:38.76,Default,,0,0,0,,«Bridgeton Mall»
Dialogue: 0,0:08:38.85,0:08:40.56,Default,,0,0,0,,«Вероника шкафы»
Dialogue: 0,0:08:40.64,0:08:44.73,Default,,0,0,0,,Асықпасаңыз да, сол бюстгалтер жеткілікті.
Dialogue: 0,0:08:44.81,0:08:47.44,Default,,0,0,0,,Шеннонға айтпа.
Dialogue: 0,0:08:47.52,0:08:51.11,Default,,0,0,0,,Кеудесі толымды болғысы келеді.
Dialogue: 0,0:08:51.19,0:08:55.11,Default,,0,0,0,,Анашым, мен сексуалдырақ нәрсе алғым келеді.
Dialogue: 0,0:08:55.20,0:09:01.12,Default,,0,0,0,,Әйелдердің кеудесі апельсин сияқты, тергің келеді.
Dialogue: 0,0:09:01.20,0:09:05.21,Default,,0,0,0,,Сіз кеудешемен үлгілі денеге ие бола алмайсыз.
Dialogue: 0,0:09:05.29,0:09:08.08,Default,,0,0,0,,Қабырғаларды жұлып, анусты ағарту...
Dialogue: 0,0:09:08.17,0:09:11.80,Default,,0,0,0,,Мен жай ғана ересектерге арналған көкірекше алғым келеді
Dialogue: 0,0:09:11.88,0:09:14.17,Default,,0,0,0,,Мен таптым! Мынау
Dialogue: 0,0:09:14.26,0:09:17.13,Default,,0,0,0,,Сатып алмасаң өлесің де.
Dialogue: 0,0:09:17.22,0:09:18.93,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:09:19.01,0:09:21.89,Default,,0,0,0,,Джесси, бұл сізге сәйкес келе ме?
Dialogue: 0,0:09:21.97,0:09:24.18,Default,,0,0,0,,Әрине сізге жарасады!
Dialogue: 0,0:09:24.27,0:09:26.77,Default,,0,0,0,,Сізге арналған көкірекше
Dialogue: 0,0:09:26.85,0:09:27.73,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:09:27.81,0:09:32.28,Default,,0,0,0,,Анамның айтқаны емес пе?
Dialogue: 0,0:09:32.36,0:09:35.74,Default,,0,0,0,,«Әйел ретінде кеудеңізді созыңыз»
Dialogue: 0,0:09:35.82,0:09:39.28,Default,,0,0,0,,Иә, бірақ мына қызыл көкірекше...
Dialogue: 0,0:09:39.41,0:09:41.58,Default,,0,0,0,,Саған әлі ерте.
Dialogue: 0,0:09:41.66,0:09:46.04,Default,,0,0,0,,Сіз адамдарды жыныстық қатынастан қорқытуға тырысасыз ба?
Dialogue: 0,0:09:46.12,0:09:46.75,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:09:46.83,0:09:48.62,Default,,0,0,0,,Сізге кішкентай әйел сияқты қарау керек пе?
Dialogue: 0,0:09:48.71,0:09:50.71,Default,,0,0,0,,Бұл өте ұят.
Dialogue: 0,0:09:50.79,0:09:53.46,Default,,0,0,0,,Сіз патриархатты қолдайсыз ба?
Dialogue: 0,0:09:53.55,0:09:55.80,Default,,0,0,0,,Бұған себеп жоқ, солай ма?
Dialogue: 0,0:09:55.88,0:09:57.05,Default,,0,0,0,,Тоқта
Dialogue: 0,0:09:57.13,0:09:59.14,Default,,0,0,0,,Рузвельт ханым айтты
Dialogue: 0,0:09:59.22,0:10:02.39,Default,,0,0,0,,«Күн сайын сіз қорқатын бір нәрсені жасаңыз»
Dialogue: 0,0:10:02.47,0:10:04.72,Default,,0,0,0,,Мына қызыл көкірекше.
Dialogue: 0,0:10:06.18,0:10:09.19,Default,,0,0,0,,Иә! Мен сене алар емеспін
Dialogue: 0,0:10:09.27,0:10:11.11,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:10:12.15,0:10:13.48,Default,,0,0,0,,Нүктелер
Dialogue: 0,0:10:13.57,0:10:17.99,Default,,0,0,0,,Бұл теңіз шошқасының тезегі емес, балмұздақ болды.
Dialogue: 0,0:10:18.07,0:10:19.24,Default,,0,0,0,,Білмей жедің бе?
Dialogue: 0,0:10:19.32,0:10:22.95,Default,,0,0,0,,Мен бұл өте дәмді тезек деп ойладым.
Dialogue: 0,0:10:23.20,0:10:24.95,Default,,0,0,0,,Сіз көкірекше сатып алдыңыз ба?
Dialogue: 0,0:10:26.54,0:10:29.08,Default,,0,0,0,,«Шарк танкі» мені мазалайды
Dialogue: 0,0:10:29.17,0:10:31.75,Default,,0,0,0,,Жарқыраған дәретхана орындығы менің идеям болды.
Dialogue: 0,0:10:31.83,0:10:32.38,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:10:32.46,0:10:35.63,Default,,0,0,0,,Сөзбен де, сөзбен де айтқан жоқпын.
Dialogue: 0,0:10:35.71,0:10:39.30,Default,,0,0,0,,Сіздің басыңыздан ұрланған зияткерлік меншік
Dialogue: 0,0:10:43.22,0:10:45.14,Default,,0,0,0,,Фатима мен сені қалаймын
Dialogue: 0,0:10:45.22,0:10:48.56,Default,,0,0,0,,Әкем мені көрсе өлтіреді.
Dialogue: 0,0:10:48.64,0:10:51.81,Default,,0,0,0,,Ертеңнен бастап қорқудың қажеті жоқ
Dialogue: 0,0:10:51.90,0:10:54.27,Default,,0,0,0,,Мен сиқыршымен сөйлестім.
Dialogue: 0,0:10:54.36,0:10:57.23,Default,,0,0,0,,Ертең мен жылқы боламын
Dialogue: 0,0:10:57.32,0:11:01.03,Default,,0,0,0,,Бірақ трансформация ауыр емес пе?
Dialogue: 0,0:11:01.11,0:11:02.41,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,0:11:02.49,0:11:05.37,Default,,0,0,0,,Біз ертең білеміз.
Dialogue: 0,0:11:05.45,0:11:06.74,Default,,0,0,0,,Бүгін түнде...
Dialogue: 0,0:11:06.91,0:11:08.08,Default,,0,0,0,,Би билейік
Dialogue: 0,0:11:09.71,0:11:12.29,Default,,0,0,0,,Мен сені Барбара ұстағым келеді
Dialogue: 0,0:11:12.38,0:11:14.04,Default,,0,0,0,,Бірақ сіз алмайсыз.
Dialogue: 0,0:11:14.13,0:11:15.38,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:11:19.05,0:11:23.22,Default,,0,0,0,,Сіз Facebook-те дәретханаға арналған орындық туралы пост жаздыңыз ба?
Dialogue: 0,0:11:23.30,0:11:25.14,Default,,0,0,0,,Кешірім сұраймын
Dialogue: 0,0:11:25.22,0:11:26.85,Default,,0,0,0,,Густаво күтіңіз.
Dialogue: 0,0:11:26.93,0:11:28.68,Default,,0,0,0,,Барбара мен барамын
Dialogue: 0,0:11:28.77,0:11:31.31,Default,,0,0,0,,Себебі мен оны жек көремін.
Dialogue: 0,0:11:32.73,0:11:35.52,Default,,0,0,0,,Адвокат жалдап, сотқа бер!
Dialogue: 0,0:11:35.61,0:11:37.27,Default,,0,0,0,,Бұл оқуға кедергі.
Dialogue: 0,0:11:37.36,0:11:38.94,Default,,0,0,0,,Жарайды, мен ұйықтаймын.
Dialogue: 0,0:11:39.78,0:11:41.15,Default,,0,0,0,,Менің ішім ауырады...
Dialogue: 0,0:11:41.28,0:11:43.95,Default,,0,0,0,,Мен балық жеуім керек еді.
Dialogue: 0,0:11:45.03,0:11:47.28,Default,,0,0,0,,Маған үзіліс беріңіз.
Dialogue: 0,0:11:47.37,0:11:50.33,Default,,0,0,0,,Мен тұрғанымда дәрі алып берші.
Dialogue: 0,0:11:53.33,0:11:56.29,Default,,0,0,0,,Әй, сен кенеттен ынталы оқырман болып кеттің бе?
Dialogue: 0,0:11:56.38,0:11:59.46,Default,,0,0,0,,Бұл нағыз президент пе, әлде...
Dialogue: 0,0:11:59.96,0:12:00.84,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:12:00.92,0:12:02.01,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:12:02.09,0:12:03.38,Default,,0,0,0,,Кітап... Шүкір!
Dialogue: 0,0:12:03.47,0:12:07.10,Default,,0,0,0,,Қыздардың бұл кітапқа ғашық болуына не себеп?
Dialogue: 0,0:12:07.18,0:12:08.97,Default,,0,0,0,,Себебі бұл мені толғандырады
Dialogue: 0,0:12:09.64,0:12:12.77,Default,,0,0,0,,Қыздар да мүйізденіп кетеді.
Dialogue: 0,0:12:14.15,0:12:16.48,Default,,0,0,0,,Ер адам сияқты.
Dialogue: 0,0:12:16.86,0:12:18.48,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:12:18.57,0:12:19.90,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:19.98,0:12:22.74,Default,,0,0,0,,Қыздар да мүйізденіп кетеді
Dialogue: 0,0:12:22.82,0:12:24.07,Default,,0,0,0,,Бұл Декү.
Dialogue: 0,0:12:24.16,0:12:26.24,Default,,0,0,0,,Мен қаттырақпын
Dialogue: 0,0:12:26.32,0:12:27.99,Default,,0,0,0,,Джей жастықпен кондиция жасай алады
Dialogue: 0,0:12:28.08,0:12:30.54,Default,,0,0,0,,Құм салынған дорба жақсы болар еді.
Dialogue: 0,0:12:30.62,0:12:32.00,Default,,0,0,0,,Бұл бірдей болуы мүмкін емес
Dialogue: 0,0:12:32.08,0:12:32.83,Default,,0,0,0,,Бітті.
Dialogue: 0,0:12:32.91,0:12:33.79,Default,,0,0,0,,Ер адам қалыпты емес
Dialogue: 0,0:12:33.87,0:12:35.21,Default,,0,0,0,,Жылыжайға тыйым салынды.
Dialogue: 0,0:12:35.29,0:12:37.46,Default,,0,0,0,,Бірақ Лия солай деді.
Dialogue: 0,0:12:37.54,0:12:39.80,Default,,0,0,0,,Девин де мүйізденіп кетсе ше?
Dialogue: 0,0:12:39.88,0:12:40.42,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:12:41.05,0:12:42.55,Default,,0,0,0,,Сонымен директор туралы не деуге болады?
Dialogue: 0,0:12:42.63,0:12:43.84,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:12:43.92,0:12:44.93,Default,,0,0,0,,Барлық әйелдер
Dialogue: 0,0:12:45.01,0:12:46.84,Default,,0,0,0,,Мисси басқа, солай ма?
Dialogue: 0,0:12:46.93,0:12:49.89,Default,,0,0,0,,Егер сіз осы кітапты оқып жатсаңыз...
Dialogue: 0,0:12:49.97,0:12:52.31,Default,,0,0,0,,Мисси де мүйізді
Dialogue: 0,0:12:52.39,0:12:54.06,Default,,0,0,0,,Сіз осылай айтып тұрсыз, солай ма?
Dialogue: 0,0:12:54.14,0:12:57.15,Default,,0,0,0,,Сонда бұл эротикалық кітап.
Dialogue: 0,0:12:57.23,0:12:59.52,Default,,0,0,0,,Мектепте эротикалық кітаптар болмайды!
Dialogue: 0,0:12:59.61,0:13:00.40,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:13:00.48,0:13:03.69,Default,,0,0,0,,Қыздар мектепте эротикалық кітаптарды оқи алады
Dialogue: 0,0:13:03.78,0:13:09.83,Default,,0,0,0,,23 мұғалімнің оргиясын суреттегенім үшін ғана мені бұзық деп санады.
Dialogue: 0,0:13:09.91,0:13:13.50,Default,,0,0,0,,Мен қосылмадым, бірақ бәрібір.
Dialogue: 0,0:13:13.58,0:13:18.29,Default,,0,0,0,,Тек гуманитарлық және ғылым факультетінің оқытушылары таңдалды.
Dialogue: 0,0:13:18.92,0:13:23.38,Default,,0,0,0,,Айтпақшы, бұл телесериалда көрсетіледі ме?
Dialogue: 0,0:13:23.46,0:13:26.97,Default,,0,0,0,,Камераға тікелей қалай сөйлеу керек
Dialogue: 0,0:13:27.05,0:13:31.31,Default,,0,0,0,,Әңгімені түсіну оңай, себебі сіз негізгі ойларға жете аласыз.
Dialogue: 0,0:13:31.39,0:13:36.10,Default,,0,0,0,,Бірақ бұл жай ғана шегініс. Жақында негізгі оқиғаға қайта ораламыз.
Dialogue: 0,0:13:39.06,0:13:40.77,Default,,0,0,0,,Маған қара
Dialogue: 0,0:13:40.86,0:13:41.40,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:13:41.48,0:13:44.44,Default,,0,0,0,,Фатима сияқты сексуалды
Dialogue: 0,0:13:44.53,0:13:46.03,Default,,0,0,0,,Кітапханада жәндіктер ұяласып жатыр ма? Бұл өте қорқынышты.
Dialogue: 0,0:13:46.11,0:13:47.36,Default,,0,0,0,,Мен білсем де
Dialogue: 0,0:13:47.45,0:13:48.82,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:48.91,0:13:50.28,Default,,0,0,0,,Би билеу туралы.
Dialogue: 0,0:13:52.33,0:13:56.12,Default,,0,0,0,,Есікті ашқанда, әлі көрмеген шытырман оқиға басталады.
Dialogue: 0,0:13:56.21,0:13:57.87,Default,,0,0,0,,Сіз байсалдысыз ба, Джесси?
Dialogue: 0,0:13:57.96,0:14:02.13,Default,,0,0,0,,Шыныаяқтың көлемін сенімділікпен және батылдықпен арттырыңыз
Dialogue: 0,0:14:03.38,0:14:08.93,Default,,0,0,0,,Жүрегімдегі таулар өмірге толқыныс береді.
Dialogue: 0,0:14:09.01,0:14:12.76,Default,,0,0,0,,Әйел жанындағы құмарлық отын жағу
Dialogue: 0,0:14:12.85,0:14:14.10,Default,,0,0,0,,Жасайық
Dialogue: 0,0:14:14.18,0:14:15.43,Default,,0,0,0,,Сексуалды қызыл көкірекше
Dialogue: 0,0:14:15.52,0:14:16.39,Default,,0,0,0,,Сәлем Джесси
Dialogue: 0,0:14:16.93,0:14:18.27,Default,,0,0,0,,Сексуалды қызыл көкірекше
Dialogue: 0,0:14:18.35,0:14:19.14,Default,,0,0,0,,Сәлем қызыл көкірекше
Dialogue: 0,0:14:19.23,0:14:20.06,Default,,0,0,0,,О... дұрыс.
Dialogue: 0,0:14:20.15,0:14:25.36,Default,,0,0,0,,Сізді қызғаныш пен табынушылықтың объектісіне айналдырыңыз
Dialogue: 0,0:14:25.44,0:14:27.28,Default,,0,0,0,,Бұл қоқыс.
Dialogue: 0,0:14:27.36,0:14:30.70,Default,,0,0,0,,Джесси, менде 28 доллар бар, оны алыңыз.
Dialogue: 0,0:14:31.87,0:14:35.04,Default,,0,0,0,,Бонжур Мисс Глейзер
Dialogue: 0,0:14:35.12,0:14:38.83,Default,,0,0,0,,Сіз Кардашьян болуға тырысасыз ба?
Dialogue: 0,0:14:39.75,0:14:44.63,Default,,0,0,0,,Абыройлы ғұмыр кешіңіз, Құлауыңыздан сақтаңыз.
Dialogue: 0,0:14:45.30,0:14:46.05,Default,,0,0,0,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:14:51.34,0:14:53.72,Default,,0,0,0,,Неге жылайсың?
Dialogue: 0,0:14:53.80,0:14:55.72,Default,,0,0,0,,Өйткені бұл өте керемет...
Dialogue: 0,0:14:56.39,0:14:57.93,Default,,0,0,0,,Анам дұрыс айтты
Dialogue: 0,0:14:58.02,0:14:59.52,Default,,0,0,0,,Оны қайталама
Dialogue: 0,0:14:59.60,0:15:01.77,Default,,0,0,0,,Маған әлі ерте екенін айтты.
Dialogue: 0,0:15:01.85,0:15:04.40,Default,,0,0,0,,Шын мәнінде төзгісіз
Dialogue: 0,0:15:04.48,0:15:06.15,Default,,0,0,0,,Бірақ бұл жақсы болды
Dialogue: 0,0:15:06.23,0:15:07.36,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:15:07.44,0:15:12.20,Default,,0,0,0,,Бірақ профессор Райзер, Джей, Лаура...
Dialogue: 0,0:15:12.32,0:15:13.66,Default,,0,0,0,,Мен оны тастағым келеді
Dialogue: 0,0:15:13.74,0:15:16.45,Default,,0,0,0,,Сіз бұл көкірекшені өлтіре аласыз!
Dialogue: 0,0:15:16.66,0:15:18.95,Default,,0,0,0,,Оны сөмкеңізде сақтаңыз
Dialogue: 0,0:15:19.04,0:15:21.67,Default,,0,0,0,,Иә, маған да ұнайды.
Dialogue: 0,0:15:23.17,0:15:26.84,Default,,0,0,0,,Қыздар мұны оқығанда мүйізденіп кетеді.
Dialogue: 0,0:15:26.92,0:15:29.13,Default,,0,0,0,,Оны Джесси де оқыды.
Dialogue: 0,0:15:29.21,0:15:33.59,Default,,0,0,0,,Осылайша мен мүйізденіп, қызыл көкірекше кидім.
Dialogue: 0,0:15:33.68,0:15:36.43,Default,,0,0,0,,Бізге хабарлау үшін
Dialogue: 0,0:15:36.51,0:15:37.51,Default,,0,0,0,,Бұл жай ғана көкірекше
Dialogue: 0,0:15:37.60,0:15:40.77,Default,,0,0,0,,Бұл жай көкірекше емес, бұл сигнал.
Dialogue: 0,0:15:40.85,0:15:43.31,Default,,0,0,0,,Тіпті солай болса да, біз не істеуіміз керек?
Dialogue: 0,0:15:43.40,0:15:45.11,Default,,0,0,0,,Бірақ мен ештеңе істей алмаймын.
Dialogue: 0,0:15:45.19,0:15:50.15,Default,,0,0,0,,Мүйізді босату үшін кеудеге тигізіңіз.
Dialogue: 0,0:15:50.24,0:15:55.20,Default,,0,0,0,,Дикіңізде қызыл көкірекше болса, бұл сіз оған қолыңызды тигізіп жатқаныңызды білдіреді, солай емес пе?
Dialogue: 0,0:15:55.28,0:15:57.49,Default,,0,0,0,,Маған бұл бұзық ұнайды.
Dialogue: 0,0:15:58.58,0:16:01.46,Default,,0,0,0,,Ми Амор керемет
Dialogue: 0,0:16:02.12,0:16:04.67,Default,,0,0,0,,Мен Мартинді қызғанамын.
Dialogue: 0,0:16:04.75,0:16:06.67,Default,,0,0,0,,Muchos Gracias
Dialogue: 0,0:16:06.75,0:16:07.67,Default,,0,0,0,,Марти.
Dialogue: 0,0:16:07.75,0:16:08.84,Default,,0,0,0,,Оған
Dialogue: 0,0:16:08.92,0:16:12.01,Default,,0,0,0,,Мартиге және басқаларға барыңыз.
Dialogue: 0,0:16:16.18,0:16:18.85,Default,,0,0,0,,Тарақтарды тағы жеп жатырсыз ба?
Dialogue: 0,0:16:18.93,0:16:21.27,Default,,0,0,0,,Бұл тамақ қалдықтары. Ол неге ұқсайды?
Dialogue: 0,0:16:21.35,0:16:23.31,Default,,0,0,0,,Мен қызық болдым.
Dialogue: 0,0:16:23.39,0:16:23.94,Default,,0,0,0,,Қый!
Dialogue: 0,0:16:24.02,0:16:25.35,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:16:26.81,0:16:27.73,Default,,0,0,0,,...
Dialogue: 0,0:16:27.82,0:16:31.65,Default,,0,0,0,,Бұған дейін құбырды тазалап алайық. Тарақ бар.
Dialogue: 0,0:16:31.99,0:16:32.74,Default,,0,0,0,,Жетеді
Dialogue: 0,0:16:32.82,0:16:33.61,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:33.70,0:16:37.37,Default,,0,0,0,,Не болды, бұл Густаво емес.
Dialogue: 0,0:16:37.45,0:16:40.04,Default,,0,0,0,,Жылқы емес деп ашуланасың ба?
Dialogue: 0,0:16:40.12,0:16:42.66,Default,,0,0,0,,Бұл жылқы болмағандықтан емес.
Dialogue: 0,0:16:42.75,0:16:47.17,Default,,0,0,0,,Өйткені сен маған қарағанда тарақты жақсы көресің.
Dialogue: 0,0:16:47.25,0:16:50.92,Default,,0,0,0,,Мен екеуіңді де жақсы көремін, бірақ әртүрлі жолмен.
Dialogue: 0,0:16:51.01,0:16:52.09,Default,,0,0,0,,Егер сіз өсек таратсаңыз...
Dialogue: 0,0:16:52.17,0:16:53.97,Default,,0,0,0,,Егер Марти
Dialogue: 0,0:16:54.05,0:16:57.26,Default,,0,0,0,,Анау тарақ жігіт әйелдерді түсінбейді.
Dialogue: 0,0:16:57.34,0:16:58.55,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:16:59.18,0:17:01.72,Default,,0,0,0,,Жылқы болған кезімде де
Dialogue: 0,0:17:01.81,0:17:04.56,Default,,0,0,0,,Ондай дыбыстар да, иістер де болған жоқ.
Dialogue: 0,0:17:04.64,0:17:05.56,Default,,0,0,0,,«Қатарынан 2 күн аралау жоқ»
Dialogue: 0,0:17:06.27,0:17:09.65,Default,,0,0,0,,Сіздің ойларыңыз маған анық жеткізілді.
Dialogue: 0,0:17:09.73,0:17:10.36,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:10.44,0:17:12.07,Default,,0,0,0,,Сигнал алынды
Dialogue: 0,0:17:12.15,0:17:13.86,Default,,0,0,0,,Мен оны әлі жіберген жоқпын.
Dialogue: 0,0:17:13.94,0:17:16.03,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:17:16.11,0:17:18.99,Default,,0,0,0,,Ақымақ, Күнге тым жақынсың.
Dialogue: 0,0:17:19.07,0:17:20.87,Default,,0,0,0,,Бұл үлкен мәселе деп үміттенемін.
Dialogue: 0,0:17:20.95,0:17:26.04,Default,,0,0,0,,Бабундар қызған кезде бөксесін қызылға айналдырып белгі береді.
Dialogue: 0,0:17:26.12,0:17:29.42,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:17:29.50,0:17:33.46,Default,,0,0,0,,Қызыл көкірекше Бұл кітап... сен мүйіздісің, солай ма?
Dialogue: 0,0:17:33.55,0:17:37.43,Default,,0,0,0,,Дос болып кеудеңе тиемін...
Dialogue: 0,0:17:39.76,0:17:42.56,Default,,0,0,0,,Жоқ сияқты.
Dialogue: 0,0:17:42.64,0:17:45.39,Default,,0,0,0,,Саған тиісуімді қалауыңа ешқандай себеп жоқ, солай ма?
Dialogue: 0,0:17:45.48,0:17:47.77,Default,,0,0,0,,Мен мүйізденіп кетсем, біреу...
Dialogue: 0,0:17:47.85,0:17:50.40,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:17:53.65,0:17:55.19,Default,,0,0,0,,Бұл сигнал емес пе?
Dialogue: 0,0:17:55.28,0:17:56.82,Default,,0,0,0,,Джесси күшті.
Dialogue: 0,0:17:56.90,0:17:59.53,Default,,0,0,0,,Бірде «Күмән Андреас» аяқталды
Dialogue: 0,0:17:59.62,0:18:02.99,Default,,0,0,0,,Саған «Гибралтар жартасын» берейін бе?
Dialogue: 0,0:18:03.20,0:18:04.12,Default,,0,0,0,,Мен үшін?
Dialogue: 0,0:18:04.20,0:18:05.75,Default,,0,0,0,,Сізге ұнайды
Dialogue: 0,0:18:05.83,0:18:10.04,Default,,0,0,0,,Сізге телескоптар, компастар және ислам өнері ұнайды, солай ма?
Dialogue: 0,0:18:10.13,0:18:12.25,Default,,0,0,0,,Густаво да сонда.
Dialogue: 0,0:18:14.42,0:18:17.09,Default,,0,0,0,,Әрине оқуға тұрарлық
Dialogue: 0,0:18:17.17,0:18:19.26,Default,,0,0,0,,Сені бәрі жақсы көреді
Dialogue: 0,0:18:19.34,0:18:21.43,Default,,0,0,0,,Мен джаз клубына барамын.
Dialogue: 0,0:18:21.51,0:18:22.89,Default,,0,0,0,,Бұл сигнал ма?
Dialogue: 0,0:18:22.97,0:18:24.68,Default,,0,0,0,,Мен шатасып бара жатырмын
Dialogue: 0,0:18:25.97,0:18:27.98,Default,,0,0,0,,Мені тұншықтырып өлтірді.
Dialogue: 0,0:18:28.06,0:18:31.44,Default,,0,0,0,,Мүйізденген кезде тітіркенесің.
Dialogue: 0,0:18:33.86,0:18:34.57,Default,,0,0,0,,Лия?
Dialogue: 0,0:18:35.03,0:18:37.40,Default,,0,0,0,,«Гибралтар жартасы» туралы...
Dialogue: 0,0:18:37.49,0:18:40.41,Default,,0,0,0,,Маймен тазалау көрінісін оқыдың ба?
Dialogue: 0,0:18:40.49,0:18:42.95,Default,,0,0,0,,Сол көрініс туралы.
Dialogue: 0,0:18:43.03,0:18:47.20,Default,,0,0,0,,«Әйелдер атты сипайды» деген тақырып емес пе?
Dialogue: 0,0:18:47.29,0:18:48.54,Default,,0,0,0,,Қандай қатыгез қимыл…
Dialogue: 0,0:18:48.62,0:18:52.42,Default,,0,0,0,,Қаласаң да қолыңнан келмесе, жарайды.
Dialogue: 0,0:18:52.50,0:18:56.17,Default,,0,0,0,,Жыныстық қатынасқа түспеудің қандай пайдасы бар?
Dialogue: 0,0:18:56.26,0:18:57.59,Default,,0,0,0,,Еркектерден айырмашылығы
Dialogue: 0,0:18:57.67,0:19:01.64,Default,,0,0,0,,Кейде әйелдер жыныстық қатынастың өзінен, кейде қызық болады
Dialogue: 0,0:19:01.97,0:19:07.72,Default,,0,0,0,,Нәрестені жүк көтергіште ұстау Кейде әкеге ашуым келеді
Dialogue: 0,0:19:07.81,0:19:10.19,Default,,0,0,0,,Сәби мен әкеге?
Dialogue: 0,0:19:10.27,0:19:13.27,Default,,0,0,0,,Жоқ, көп нәрсе бар.
Dialogue: 0,0:19:13.36,0:19:15.98,Default,,0,0,0,,Кейде гүлдің иісі шығады
Dialogue: 0,0:19:16.07,0:19:18.53,Default,,0,0,0,,Суши және доктор Дрю...
Dialogue: 0,0:19:18.99,0:19:22.11,Default,,0,0,0,,Басқа да көптеген жұмбақ заттар
Dialogue: 0,0:19:22.20,0:19:24.20,Default,,0,0,0,,«Гибралтар жартасы»
Dialogue: 0,0:19:24.28,0:19:29.33,Default,,0,0,0,,Бұл сексуалды, өйткені оның иісі секс сияқты.
Dialogue: 0,0:19:29.41,0:19:33.13,Default,,0,0,0,,Қызықты ұл мен зерек қыз бірге жұмыс істейді
Dialogue: 0,0:19:33.21,0:19:36.13,Default,,0,0,0,,Адамның ашкөздігінің жұмбағын шешу
Dialogue: 0,0:19:36.21,0:19:38.17,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:19:38.26,0:19:40.42,Default,,0,0,0,,Жоқ, мұның бәрі сіздің арқаңыз.
Dialogue: 0,0:19:40.51,0:19:41.93,Default,,0,0,0,,Жоқ, бұл сізсіз.
Dialogue: 0,0:19:42.01,0:19:44.22,Default,,0,0,0,,Мен саған рахмет айтып түнді өткізгім келеді.
Dialogue: 0,0:19:44.30,0:19:46.05,Default,,0,0,0,,Ендеше бір-бірімізді тексерейік?
Dialogue: 0,0:19:46.14,0:19:48.47,Default,,0,0,0,,Қазір тексеріңіз
Dialogue: 0,0:19:48.56,0:19:50.43,Default,,0,0,0,,Жарайды, сен жаман қызсың.
Dialogue: 0,0:19:51.81,0:19:57.02,Default,,0,0,0,,Балаңыздың жынысы туралы айтып, ашулану қандай?
Dialogue: 0,0:19:57.11,0:20:01.61,Default,,0,0,0,,Үкім шығаруды сізге қалдырамын. Мен жай қарап шығуға келдім.
Dialogue: 0,0:20:03.49,0:20:05.41,Default,,0,0,0,,Джей өте қорқынышты
Dialogue: 0,0:20:05.49,0:20:06.83,Default,,0,0,0,,Тіпті Ұлы науқан кезінде, Лугника патшалығы экспедициялық корпус ұйымдастырған кезде—
Dialogue: 0,0:20:06.91,0:20:08.62,Default,,0,0,0,,сондықтан кенеттен үйімнен айырылып қалсам, біраз қиын болар еді.
Dialogue: 0,0:20:08.70,0:20:10.91,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:20:11.00,0:20:13.67,Default,,0,0,0,,Өйткені бұл маған ұнайды
Dialogue: 0,0:20:13.75,0:20:15.75,Default,,0,0,0,,Мен мұны жақсы деп ойладым.
Dialogue: 0,0:20:15.83,0:20:17.09,Default,,0,0,0,,Сізге ұнайды, солай ма?
Dialogue: 0,0:20:17.17,0:20:20.17,Default,,0,0,0,,Бірақ барлығының реакциясы біртүрлі көрінеді.
Dialogue: 0,0:20:20.26,0:20:22.88,Default,,0,0,0,,Айналаңызда не бар екені маңызды емес
Dialogue: 0,0:20:22.97,0:20:26.89,Default,,0,0,0,,Мүмкін қазір өзіңді танитын кез шығар
Dialogue: 0,0:20:26.97,0:20:28.89,Default,,0,0,0,,Қарау дейсіз бе?
Dialogue: 0,0:20:28.97,0:20:32.23,Default,,0,0,0,,Менікі болғанын көру жақсы.
Dialogue: 0,0:20:32.31,0:20:34.73,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:20:34.81,0:20:35.90,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:20:35.98,0:20:38.15,Default,,0,0,0,,Әрине, Пекорино.
Dialogue: 0,0:20:38.23,0:20:44.57,Default,,0,0,0,,Мен көпіршікті ваннаны қабылдап, доктор Дрюді қарап жатырмын
Dialogue: 0,0:20:46.70,0:20:47.99,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:20:49.28,0:20:49.91,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:49.99,0:20:51.08,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:20:51.16,0:20:54.00,Default,,0,0,0,,Мен сенімен әрқашан кездескім келді.
Dialogue: 0,0:20:54.08,0:20:56.58,Default,,0,0,0,,Солай ма? мен Джессимін
Dialogue: 0,0:20:56.67,0:20:59.38,Default,,0,0,0,,Мен сенің жыныс мүшелеріңмін
Dialogue: 0,0:20:59.46,0:21:00.30,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:21:00.38,0:21:01.63,Default,,0,0,0,,Қарсы болмасаңыз...
Dialogue: 0,0:21:02.71,0:21:03.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:03.97,0:21:05.51,Default,,0,0,0,,Мен оны қайтадан кидім
Dialogue: 0,0:21:05.59,0:21:06.51,Default,,0,0,0,,плюс отбасылық әулеттік қорқыныш, деп ойлаймын
Dialogue: 0,0:21:06.59,0:21:07.47,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:21:07.55,0:21:10.14,Default,,0,0,0,,Мен елестеткеннен басқаша болды.
Dialogue: 0,0:21:10.22,0:21:11.43,Default,,0,0,0,,Мен саған айналаны көрсетейін бе?
Dialogue: 0,0:21:11.52,0:21:12.39,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:21:12.47,0:21:13.31,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:21:13.85,0:21:15.94,Default,,0,0,0,,Біріншіден, жоғарыдағы
Dialogue: 0,0:21:16.02,0:21:17.27,Default,,0,0,0,,Клитор.
Dialogue: 0,0:21:17.35,0:21:18.94,Default,,0,0,0,,Бұл кешке кіретін есік.
Dialogue: 0,0:21:19.02,0:21:20.23,Default,,0,0,0,,Партия?
Dialogue: 0,0:21:20.32,0:21:23.65,Default,,0,0,0,,Сізді жақсы жағдайда ток соққан кезіңіз болды ма?
Dialogue: 0,0:21:23.74,0:21:24.82,Default,,0,0,0,,Соңында соққы алмасқан адамның сен болғаныңа қуаныштымын
Dialogue: 0,0:21:24.90,0:21:26.70,Default,,0,0,0,,Қалай болғанда да, бұл маңызды.
Dialogue: 0,0:21:26.78,0:21:29.24,Default,,0,0,0,,Бұл несеп шығатын өзек.
Dialogue: 0,0:21:29.99,0:21:31.62,Default,,0,0,0,,Екі тесік бар, солай ма?
Dialogue: 0,0:21:31.70,0:21:33.16,Default,,0,0,0,,Егер анусты қоссаңыз, онда 3 болады.
Dialogue: 0,0:21:33.25,0:21:34.25,Default,,0,0,0,,Анус басқаша, солай емес пе?
Dialogue: 0,0:21:34.33,0:21:35.75,Default,,0,0,0,,Мен келісемін, бұл шығу.
Dialogue: 0,0:21:36.71,0:21:37.25,Default,,0,0,0,,Жай әзіл.
Dialogue: 0,0:21:37.33,0:21:37.87,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:21:37.96,0:21:39.96,Default,,0,0,0,,Жақсы бала, сен барабаншысың.
Dialogue: 0,0:21:40.04,0:21:43.51,Default,,0,0,0,,Басқа үлкен жыныс еріндері және
Dialogue: 0,0:21:43.59,0:21:45.22,Default,,0,0,0,,Бұл кіші жыныс еріндері
Dialogue: 0,0:21:45.30,0:21:48.22,Default,,0,0,0,,Ал бұл қынап
Dialogue: 0,0:21:49.14,0:21:52.31,Default,,0,0,0,,Мен бұл әйел жыныс мүшелерінің жалпы термині деп ойладым.
Dialogue: 0,0:21:52.39,0:21:53.56,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:21:53.64,0:21:56.14,Default,,0,0,0,,Газдалған шарап-
Dialogue: 0,0:21:56.23,0:22:00.40,Default,,0,0,0,,Кез келген нәрсені шампан деп атағандай
Dialogue: 0,0:22:00.48,0:22:02.57,Default,,0,0,0,,«Егер біз мас болсақ, біз бірге боламыз!»
Dialogue: 0,0:22:03.82,0:22:05.03,Default,,0,0,0,,Мен қорықпаймын
Dialogue: 0,0:22:06.65,0:22:11.07,Default,,0,0,0,,Әрине, бұл сіздің денеңіздің бір бөлігі. Бұл өте қызық.
Dialogue: 0,0:22:11.41,0:22:12.28,Default,,0,0,0,,Көз қысу
Dialogue: 0,0:22:12.62,0:22:13.79,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:22:14.37,0:22:16.08,Default,,0,0,0,,Мүмкін, солай ма?
Dialogue: 0,0:22:16.16,0:22:16.91,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:22:17.00,0:22:19.21,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:22:19.29,0:22:20.46,Default,,0,0,0,,Мастурбацияны үйрету
Dialogue: 0,0:22:20.54,0:22:21.25,Default,,0,0,0,,Иә.
Dialogue: 0,0:22:21.34,0:22:22.25,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:22:22.34,0:22:23.17,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,0:22:23.25,0:22:25.09,Default,,0,0,0,,Мен сенің мәңгі қалуыңды қалаймын
Dialogue: 0,0:22:25.17,0:22:26.51,Default,,0,0,0,,Мен қалаймын
Dialogue: 0,0:22:27.13,0:22:28.26,Default,,0,0,0,,Қайта келіңіз
Dialogue: 0,0:22:31.09,0:22:32.64,Default,,0,0,0,,Марти! Не деген...
Dialogue: 0,0:22:32.72,0:22:34.47,Default,,0,0,0,,Жылқы Густаво
Dialogue: 0,0:22:34.56,0:22:35.64,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:22:35.72,0:22:37.68,Default,,0,0,0,,Мен сені сүйемін.
Dialogue: 0,0:22:37.77,0:22:39.64,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:22:39.73,0:22:42.23,Default,,0,0,0,,Бұл тамаша Густаво атты жылқы.
Dialogue: 0,0:22:42.31,0:22:46.15,Default,,0,0,0,,Густаво атша киінбейді.
Dialogue: 0,0:22:46.23,0:22:49.03,Default,,0,0,0,,Жарайды, осында кел.
Dialogue: 0,0:22:49.11,0:22:50.82,Default,,0,0,0,,Тарақтарды лақтырып жібердім.
Dialogue: 0,0:22:50.91,0:22:53.41,Default,,0,0,0,,Жарайды, лақтырып жібердің бе?
Dialogue: 0,0:22:55.87,0:22:57.41,Default,,0,0,0,,Қыз мүйізді болса...
Dialogue: 0,0:22:57.50,0:22:58.58,Default,,0,0,0,,Анасы да солай етеді
Dialogue: 0,0:22:58.66,0:23:00.12,Default,,0,0,0,,Менің анам...
Dialogue: 0,0:23:01.00,0:23:04.84,Default,,0,0,0,,Құдай-ау, әкемнің шарлары сондай үлкен.
Dialogue: 0,0:23:06.76,0:23:09.09,Default,,0,0,0,,Қорытынды хабарландыру
Dialogue: 0,0:23:06.76,0:23:09.09,Default,,0,0,0,,〝Оқуға шолу〞
Dialogue: 0,0:23:09.17,0:23:14.47,Default,,0,0,0,,Ник Берчтің «Гибралтар жартасы».
Dialogue: 0,0:23:14.55,0:23:15.39,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:23:15.47,0:23:17.14,Default,,0,0,0,,Сәлеметсіз бе, доктор Раз
Dialogue: 0,0:23:17.22,0:23:21.73,Default,,0,0,0,,``Гибралтар жартасы'' тамаша тарихи роман.
Dialogue: 0,0:23:21.81,0:23:23.48,Default,,0,0,0,,Әдемі және құмар
Dialogue: 0,0:23:23.56,0:23:27.40,Default,,0,0,0,,Бұл тек секс туралы әңгіме емес
Dialogue: 0,0:23:27.48,0:23:31.15,Default,,0,0,0,,Бұл секс туралы меңзейді. Түсінесіз бе?
Dialogue: 0,0:23:31.24,0:23:33.45,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:23:33.53,0:23:37.70,Default,,0,0,0,,Густаво Фатимадан ештеңе алмайды.
Dialogue: 0,0:23:38.79,0:23:40.96,Default,,0,0,0,,Маған оны оқып берейін.
Dialogue: 0,0:23:41.04,0:23:45.04,Default,,0,0,0,,Бұл Густавоның Фатимаға айтқан сөздері.
Dialogue: 0,0:23:45.13,0:23:47.38,Default,,0,0,0,,Барлығы жақсы болса
Dialogue: 0,0:23:47.46,0:23:49.42,Default,,0,0,0,,Қазір оқыңыз!
Dialogue: 0,0:23:51.01,0:23:53.55,Default,,0,0,0,,«Фатима, мен сені жақсы көремін»
Dialogue: 0,0:23:53.64,0:23:56.85,Default,,0,0,0,,«Сенің тамаша миың»
Dialogue: 0,0:23:56.93,0:24:01.56,Default,,0,0,0,,«Сенің сұлулығың мені мас қылып, ақылсыз етеді».
Dialogue: 0,0:24:01.64,0:24:02.52,Default,,0,0,0,,Сенорита
Dialogue: 0,0:24:03.60,0:24:06.73,Default,,0,0,0,,«Сіз оны ешқашан ұстай алмайсыз».
Dialogue: 0,0:24:06.82,0:24:09.90,Default,,0,0,0,,«Сіздің айнымас еркін рухыңыз»
Dialogue: 0,0:24:09.99,0:24:12.03,Default,,0,0,0,,Сақ болыңыз, өйткені сіз тайып кетесіз.
Dialogue: 0,0:24:12.11,0:24:17.33,Default,,0,0,0,,«Сен туралы көптеген жұмбақтар бар, мен оны өмір бойы аша алмаймын».
Dialogue: 0,0:24:18.54,0:24:21.29,Default,,0,0,0,,Міне, балақай.
Dialogue: 0,0:24:21.37,0:24:21.91,Default,,0,0,0,,Сәлем
Dialogue: 0,0:24:22.00,0:24:23.08,Default,,0,0,0,,О, қалайсың?
Dialogue: 0,0:24:23.17,0:24:26.59,Default,,0,0,0,,«Бірақ мұны түсініңіз.»
Dialogue: 0,0:24:26.67,0:24:30.67,Default,,0,0,0,,«Мен сені мәңгілік менікі еткім келеді».
Dialogue: 0,0:24:31.26,0:24:32.13,Default,,0,0,0,,«Мен сені қалаймын»
Dialogue: 0,0:24:33.55,0:24:34.59,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:24:34.68,0:24:37.10,Default,,0,0,0,,Рахмет Густаво... Ник
Dialogue: 0,0:24:37.18,0:24:38.05,Default,,0,0,0,,Gracias
Dialogue: 0,0:24:46.19,0:24:47.44,Default,,0,0,0,,Бұл Киелі кітап, сеньор.
Dialogue: 0,0:24:47.52,0:24:48.44,Default,,0,0,0,,Рахмет
Dialogue: 0,0:24:57.82,0:24:58.70,Default,,0,0,0,,Мисси?
Dialogue: 0,0:24:59.28,0:25:00.33,Default,,0,0,0,,Мен солай ойлаймын
Dialogue: 0,0:25:00.41,0:25:03.04,Default,,0,0,0,,Кин шарлары тұқым қуаламайды.
Dialogue: 0,0:25:03.12,0:25:03.87,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:25:03.96,0:25:08.25,Default,,0,0,0,,Мен олар сөмкелері ілініп жыныстық қатынасқа түсіп жатыр деп ойладым.
Dialogue: 0,0:25:08.34,0:25:11.67,Default,,0,0,0,,Кинтама екеніне таң қалдым.
Dialogue: 0,0:25:11.76,0:25:13.80,Default,,0,0,0,,Мен оны ойымнан шығара алмаймын
Dialogue: 0,0:25:13.88,0:25:16.68,Default,,0,0,0,,Мен ауырып қалдым деп күдіктене бастадым.
Dialogue: 0,0:25:16.76,0:25:20.97,Default,,0,0,0,,Тегіс болғаны сонша, қан тамырлары көрінді.
Dialogue: 0,0:25:21.06,0:25:24.43,Default,,0,0,0,,Менің ойымша, салмақ теріні созады.
Dialogue: 0,0:25:24.52,0:25:29.56,Default,,0,0,0,,Мүмкін сіз оны дәретхананың отырғышына қойған шығарсыз, себебі ол дәрет шығарғанда киіп кетеді?
Dialogue: 0,0:25:29.65,0:25:32.23,Default,,0,0,0,,Жарқыраған дәретхана орындығы осыдан шыққан ба?
Dialogue: 0,0:25:32.32,0:25:35.74,Default,,0,0,0,,Мен балаға идея бердім.
Dialogue: 0,0:25:35.82,0:25:41.16,Default,,0,0,0,,Мен әкеме айта алмаймын, өйткені ол мені үлкен қауын дорбамен ұрып жібереді деп қорқамын.
Dialogue: 0,0:25:42.29,0:25:44.54,Default,,0,0,0,,Не, ұйықтап жатырсың ба?
Dialogue: 0,0:25:44.62,0:25:48.17,Default,,0,0,0,,Әкемнің шарлары допқа толы.
Dialogue: 0,0:25:48.25,0:25:50.00,Default,,0,0,0,,Кинтама бұл...
Dialogue: 0,0:26:07.81,0:26:09.81,Default,,0,0,0,,Жапон субтитрлері Нагиса Исозаки
Dialogue: 0,0:26:11.31,0:26:17.31,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
