Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:08.17,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:08.50,0:00:09.67,Default,,0,0,0,,Барлық көрермендер үшін
Dialogue: 0,0:00:10.05,0:00:11.38,Default,,0,0,0,,Кеуде бұлшықеттері…
Dialogue: 0,0:00:11.76,0:00:13.13,Default,,0,0,0,,Іш бұлшықеттері…
Dialogue: 0,0:00:13.34,0:00:15.05,Default,,0,0,0,,Және әтеш
Dialogue: 0,0:00:15.14,0:00:19.60,Default,,0,0,0,,Дуэйн Джонсон Пол Бунян ретінде жабайы болады
Dialogue: 0,0:00:19.76,0:00:22.56,Default,,0,0,0,,Мен таңертең ағашты кесуім керек.
Dialogue: 0,0:00:25.48,0:00:26.48,Default,,0,0,0,,Бұл ең жақсы
Dialogue: 0,0:00:26.77,0:00:30.11,Default,,0,0,0,,Тоқта, бұл менің эякуляцияны қалайды.
Dialogue: 0,0:00:30.19,0:00:34.82,Default,,0,0,0,,Осы күзде Пол Бунян Нью-Йоркте болады...
Dialogue: 0,0:00:34.90,0:00:36.66,Default,,0,0,0,,Шырынды себіңіз
Dialogue: 0,0:00:36.74,0:00:38.45,Default,,0,0,0,,「ＰＢ：ＮＹＣ」
Dialogue: 0,0:00:38.53,0:00:42.79,Default,,0,0,0,,Бұл өте қызықты көрінеді.
Dialogue: 0,0:00:42.87,0:00:44.21,Default,,0,0,0,,Өйткені бұл фильм.
Dialogue: 0,0:00:44.29,0:00:46.54,Default,,0,0,0,,Мен екі билет сатып аламын.
Dialogue: 0,0:00:46.75,0:00:49.29,Default,,0,0,0,,Мендікін сатып алудың қажеті жоқ.
Dialogue: 0,0:00:49.38,0:00:50.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:00:50.84,0:00:54.22,Default,,0,0,0,,Себебі мен Джессимен кездесе бастадым...
Dialogue: 0,0:00:54.30,0:00:57.72,Default,,0,0,0,,Мен көремін. Сонда сіз қызыңызбен барасыз ба?
Dialogue: 0,0:00:57.80,0:00:59.93,Default,,0,0,0,,Алдын ала қарауды бірге тамашалайық
Dialogue: 0,0:01:00.01,0:01:01.43,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:01:01.51,0:01:03.68,Default,,0,0,0,,Қайта туылу
Dialogue: 0,0:01:05.69,0:01:07.40,Default,,0,0,0,,Режиссер Брайан Сингер ме?
Dialogue: 0,0:01:08.27,0:01:09.56,Default,,0,0,0,,Кеуде бұлшықеттері...
Dialogue: 0,0:01:09.94,0:01:10.94,Default,,0,0,0,,Іш бұлшықеттері…
Dialogue: 0,0:01:11.78,0:01:12.82,Default,,0,0,0,,Және әтеш
Dialogue: 0,0:01:13.36,0:01:14.90,Default,,0,0,0,,Сіз маған қоңырау шалдыңыз ба?
Dialogue: 0,0:01:14.99,0:01:16.40,Default,,0,0,0,,Сізді кім қызықтырады?
Dialogue: 0,0:01:16.57,0:01:18.57,Default,,0,0,0,,Рианна? Сары май жарнамасындағы бала?
Dialogue: 0,0:01:19.70,0:01:21.83,Default,,0,0,0,,Дуэйн Джонсон?
Dialogue: 0,0:01:21.91,0:01:25.54,Default,,0,0,0,,Жоқ, бұл өз алдына бөлек көзге түсетін нәрсе.
Dialogue: 0,0:01:25.62,0:01:28.25,Default,,0,0,0,,Томат қызанақты көргенде де...
Dialogue: 0,0:01:28.33,0:01:31.21,Default,,0,0,0,,Өйткені 2010 жыл шамасында. Немесе...
Dialogue: 0,0:01:31.29,0:01:32.17,Default,,0,0,0,,Мүмкін гей
Dialogue: 0,0:01:32.25,0:01:36.05,Default,,0,0,0,,Ақымақ болма, менің қиялымдағы адам – әйел.
Dialogue: 0,0:01:36.13,0:01:38.05,Default,,0,0,0,,Тексеріп көрейік.
Dialogue: 0,0:01:38.34,0:01:39.59,Default,,0,0,0,,Енді отырыңыз.
Dialogue: 0,0:01:39.76,0:01:40.93,Default,,0,0,0,,Көзілдірікті шешіңіз?
Dialogue: 0,0:01:41.01,0:01:44.64,Default,,0,0,0,,Бұл көз сынағы емес, бұл гей сынағы.
Dialogue: 0,0:01:44.72,0:01:45.52,Default,,0,0,0,,таңдаңыз
Dialogue: 0,0:01:45.60,0:01:46.39,Default,,0,0,0,,№1?
Dialogue: 0,0:01:46.48,0:01:47.35,Default,,0,0,0,,2 саны?
Dialogue: 0,0:01:47.44,0:01:48.90,Default,,0,0,0,,Менің ойымша, №1...
Dialogue: 0,0:01:49.60,0:01:50.40,Default,,0,0,0,,№1?
Dialogue: 0,0:01:50.73,0:01:51.56,Default,,0,0,0,,2 саны?
Dialogue: 0,0:01:51.73,0:01:53.11,Default,,0,0,0,,№ 2
Dialogue: 0,0:01:53.36,0:01:54.23,Default,,0,0,0,,№1?
Dialogue: 0,0:01:54.32,0:01:55.44,Default,,0,0,0,,2 саны?
Dialogue: 0,0:01:55.53,0:01:56.53,Default,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,0:01:57.57,0:01:58.32,Default,,0,0,0,,Мүмкін саны 1
Dialogue: 0,0:01:58.40,0:01:59.41,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:59.49,0:02:00.28,Default,,0,0,0,,№1?
Dialogue: 0,0:02:00.37,0:02:01.32,Default,,0,0,0,,2 саны?
Dialogue: 0,0:02:02.24,0:02:03.20,Default,,0,0,0,,№2, солай ма?
Dialogue: 0,0:02:03.28,0:02:04.83,Default,,0,0,0,,Мүмкін мен гей шығармын
Dialogue: 0,0:02:04.91,0:02:07.25,Default,,0,0,0,,Білу жақсы
Dialogue: 0,0:02:07.33,0:02:09.25,Default,,0,0,0,,Жазба
Dialogue: 0,0:02:09.33,0:02:11.50,Default,,0,0,0,,Жалғыз мүйізді бояды
Dialogue: 0,0:02:11.58,0:02:13.34,Default,,0,0,0,,Бұл сүйкімді хобби
Dialogue: 0,0:02:13.42,0:02:14.88,Default,,0,0,0,,Сіз жыныстық қатынасқа түсетін жер
Dialogue: 0,0:02:48.08,0:02:49.62,Default,,0,0,0,,«Испан мейрамханасы»
Dialogue: 0,0:02:53.17,0:02:55.17,Default,,0,0,0,,Бұл дәмді су...
Dialogue: 0,0:02:55.25,0:02:59.26,Default,,0,0,0,,Кран суы фторланған және дәмді.
Dialogue: 0,0:02:59.67,0:03:00.59,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:03:00.68,0:03:01.59,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:02.76,0:03:04.35,Default,,0,0,0,,Бүгін Эндрю...
Dialogue: 0,0:03:04.43,0:03:05.72,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:03:06.47,0:03:09.93,Default,,0,0,0,,Оның сағыз кәмпиттері қапта еріді.
Dialogue: 0,0:03:11.73,0:03:13.06,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:03:13.15,0:03:14.52,Default,,0,0,0,,Мен тамақтанып отырдым
Dialogue: 0,0:03:16.23,0:03:17.03,Default,,0,0,0,,Дәретхана
Dialogue: 0,0:03:17.11,0:03:18.94,Default,,0,0,0,,Бұл Эль Багно.
Dialogue: 0,0:03:19.24,0:03:20.28,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:03:20.74,0:03:23.28,Default,,0,0,0,,Дәретхана испан тілінде…
Dialogue: 0,0:03:23.36,0:03:24.99,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:03:27.99,0:03:31.25,Default,,0,0,0,,Мен әбден тұншығып қалдым.
Dialogue: 0,0:03:31.33,0:03:35.46,Default,,0,0,0,,Бұрын қызық еді, бірақ неге бұлай?
Dialogue: 0,0:03:35.54,0:03:38.80,Default,,0,0,0,,Біз ғашық бола алмаймыз
Dialogue: 0,0:03:38.88,0:03:40.42,Default,,0,0,0,,Маған ұнаса да?
Dialogue: 0,0:03:40.51,0:03:42.05,Default,,0,0,0,,Дос ретінде
Dialogue: 0,0:03:42.22,0:03:44.80,Default,,0,0,0,,Біз қатты сүйген кезде-
Dialogue: 0,0:03:44.89,0:03:46.97,Default,,0,0,0,,Өзіңізді қалай сезіндіңіз?
Dialogue: 0,0:03:47.06,0:03:47.85,Default,,0,0,0,,Бөлек
Dialogue: 0,0:03:47.93,0:03:49.14,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:03:49.22,0:03:54.65,Default,,0,0,0,,Стэнли Ковальскидің қолына түскендей сезім
Dialogue: 0,0:03:54.73,0:03:56.77,Default,,0,0,0,,Әдемі көрінеді
Dialogue: 0,0:03:56.86,0:04:00.11,Default,,0,0,0,,Сіз қалауды жеңе алмайсыз
Dialogue: 0,0:04:00.19,0:04:02.74,Default,,0,0,0,,Никпен ажырасу
Dialogue: 0,0:04:04.16,0:04:07.37,Default,,0,0,0,,Мен таңертең ағашты кесуім керек.
Dialogue: 0,0:04:07.70,0:04:09.20,Default,,0,0,0,,Жарық сөнеді! Сағат 9:05.
Dialogue: 0,0:04:09.29,0:04:12.50,Default,,0,0,0,,Әке, сізге сұрақ қойсам болады ма?
Dialogue: 0,0:04:12.58,0:04:16.00,Default,,0,0,0,,Жарайды, бірақ шамдар әлі өшірулі.
Dialogue: 0,0:04:17.13,0:04:19.34,Default,,0,0,0,,Әйелдерге неше жасыңызда қызыға бастадыңыз?
Dialogue: 0,0:04:19.42,0:04:21.34,Default,,0,0,0,,Әйел? Мен оны жек көремін!
Dialogue: 0,0:04:21.42,0:04:21.97,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:22.05,0:04:24.63,Default,,0,0,0,,Мен де еркектерді жек көремін, яғни адамдарды жек көремін.
Dialogue: 0,0:04:24.72,0:04:25.80,Default,,0,0,0,,Анам ше?
Dialogue: 0,0:04:25.89,0:04:26.97,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:04:27.05,0:04:28.93,Default,,0,0,0,,Бірақ басқа ештеңе айтпа...
Dialogue: 0,0:04:29.01,0:04:31.43,Default,,0,0,0,,Тағы төрт адам бар.
Dialogue: 0,0:04:31.52,0:04:33.35,Default,,0,0,0,,Терри Брэдшоу
Dialogue: 0,0:04:33.43,0:04:35.94,Default,,0,0,0,,Метро-Солтүстік теміржол кондукторы
Dialogue: 0,0:04:36.02,0:04:37.73,Default,,0,0,0,,Евгений немере ағасы
Dialogue: 0,0:04:38.44,0:04:41.73,Default,,0,0,0,,Барлығы осы. Біз үшеу едік.
Dialogue: 0,0:04:42.11,0:04:43.61,Default,,0,0,0,,Бұл пайдалы болды ма?
Dialogue: 0,0:04:43.70,0:04:44.78,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:44.86,0:04:48.16,Default,,0,0,0,,Мен жатып, хатты оқимын.
Dialogue: 0,0:04:50.83,0:04:51.79,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:04:51.87,0:04:53.29,Default,,0,0,0,,Тамақты қайтарғаным үшін кешіріңіз.
Dialogue: 0,0:04:53.37,0:04:55.92,Default,,0,0,0,,Тилапия - макарон...
Dialogue: 0,0:04:56.00,0:04:57.42,Default,,0,0,0,,Балық
Dialogue: 0,0:04:57.50,0:04:59.04,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:04:59.13,0:05:03.17,Default,,0,0,0,,Ей, біз жақсы дос болдық, солай ма?
Dialogue: 0,0:05:03.34,0:05:03.92,Default,,0,0,0,,Өте
Dialogue: 0,0:05:04.01,0:05:06.51,Default,,0,0,0,,Неге біз қайтадан дос болмаймыз?
Dialogue: 0,0:05:06.59,0:05:09.35,Default,,0,0,0,,Дос болуға келісемін.
Dialogue: 0,0:05:09.43,0:05:12.43,Default,,0,0,0,,Сенің де осындай сезімде болғаныңа қуаныштымын.
Dialogue: 0,0:05:12.89,0:05:15.39,Default,,0,0,0,,Ник, бұл жақсы куртка.
Dialogue: 0,0:05:15.48,0:05:17.15,Default,,0,0,0,,Апайдың тойында киген
Dialogue: 0,0:05:17.23,0:05:19.48,Default,,0,0,0,,Махаббат сапарына бардың ба?
Dialogue: 0,0:05:19.56,0:05:20.27,Default,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:05:20.36,0:05:20.94,Default,,0,0,0,,Иә
Dialogue: 0,0:05:21.02,0:05:23.36,Default,,0,0,0,,Жақында кездескенше, рахмет
Dialogue: 0,0:05:24.78,0:05:28.11,Default,,0,0,0,,Сүйіктіңмен дос болу керемет!
Dialogue: 0,0:05:29.70,0:05:32.45,Default,,0,0,0,,Джадд Бүгінге қандай жоспарларыңыз бар?
Dialogue: 0,0:05:32.54,0:05:33.45,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:05:33.54,0:05:34.79,Default,,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,0:05:34.87,0:05:37.17,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:05:37.42,0:05:39.88,Default,,0,0,0,,Ник Сіздің кездесуіңіз қалай өтті?
Dialogue: 0,0:05:39.96,0:05:42.88,Default,,0,0,0,,Басында ыңғайсыз болды
Dialogue: 0,0:05:42.96,0:05:47.51,Default,,0,0,0,,Мен бақыттымын, өйткені олар мені қайтадан дос болуды өтінді.
Dialogue: 0,0:05:48.89,0:05:50.55,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:05:50.64,0:05:54.72,Default,,0,0,0,,Дос болмай, «қайтайық» солай ма?
Dialogue: 0,0:05:54.81,0:05:55.52,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:05:55.60,0:05:57.52,Default,,0,0,0,,Мен ол ақымақты кешірмеймін.
Dialogue: 0,0:05:57.94,0:06:00.73,Default,,0,0,0,,Ник, сені тастап кетті.
Dialogue: 0,0:06:00.81,0:06:04.94,Default,,0,0,0,,Мен тастап кеткен жоқпын, біз ғашықпыз, бірақ доспыз.
Dialogue: 0,0:06:05.03,0:06:07.40,Default,,0,0,0,,Сізді өте жақсы алдап кетті.
Dialogue: 0,0:06:07.49,0:06:09.41,Default,,0,0,0,,Мен Тайлерге қолданған қозғалыс
Dialogue: 0,0:06:09.49,0:06:12.83,Default,,0,0,0,,Менің бақшамда өзін өртемек болған бала.
Dialogue: 0,0:06:12.91,0:06:15.12,Default,,0,0,0,,Түсіндім, мені тастап кетті.
Dialogue: 0,0:06:15.33,0:06:16.79,Default,,0,0,0,,Барлығы маған күледі
Dialogue: 0,0:06:16.87,0:06:17.87,Default,,0,0,0,,Мен басқашамын.
Dialogue: 0,0:06:17.96,0:06:20.12,Default,,0,0,0,,Әкеммен кездесуге барайық
Dialogue: 0,0:06:20.42,0:06:21.08,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:06:21.17,0:06:22.17,Default,,0,0,0,,Өзін-өзі өртеу
Dialogue: 0,0:06:22.34,0:06:23.25,Default,,0,0,0,,«Айлакер болайық»
Dialogue: 0,0:06:24.71,0:06:26.13,Default,,0,0,0,,Сәлем Мэтью
Dialogue: 0,0:06:26.21,0:06:28.88,Default,,0,0,0,,Бұл біреудің жоғалған заты.
Dialogue: 0,0:06:28.97,0:06:31.55,Default,,0,0,0,,Сізден бірдеңе сұрасам болады ма?
Dialogue: 0,0:06:31.64,0:06:35.47,Default,,0,0,0,,Гей екеніңізді қайдан білдіңіз?
Dialogue: 0,0:06:35.56,0:06:37.39,Default,,0,0,0,,Мен білетін жалғыз гей адам сенсің
Dialogue: 0,0:06:37.48,0:06:40.90,Default,,0,0,0,,Сіз гей екеніңізді білесіз бе?
Dialogue: 0,0:06:40.98,0:06:42.31,Default,,0,0,0,,Неліктен бұл оқиға?
Dialogue: 0,0:06:44.36,0:06:45.82,Default,,0,0,0,,Мен гей болсам ше?
Dialogue: 0,0:06:45.90,0:06:47.49,Default,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:06:47.57,0:06:49.24,Default,,0,0,0,,Иә, білмеймін.
Dialogue: 0,0:06:49.32,0:06:52.62,Default,,0,0,0,,Мен түсінемін, мен әйелдер арасында танымал емеспін.
Dialogue: 0,0:06:52.70,0:06:55.08,Default,,0,0,0,,Эндрю мен саған айтамын...
Dialogue: 0,0:06:55.16,0:06:56.74,Default,,0,0,0,,Мен сені қызықтырмаймын
Dialogue: 0,0:06:56.83,0:06:58.50,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:06:58.58,0:06:59.96,Default,,0,0,0,,Адалдығыңызға рахмет.
Dialogue: 0,0:07:00.04,0:07:00.83,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:00.92,0:07:02.92,Default,,0,0,0,,Міне, бұл тым сыпайылық.
Dialogue: 0,0:07:03.21,0:07:08.63,Default,,0,0,0,,Әуе күштерінде қызмет еткеннен кейін IBM компаниясында менеджер болды.
Dialogue: 0,0:07:08.71,0:07:10.76,Default,,0,0,0,,Спортзалға баратын гей жігітке ұқсайды
Dialogue: 0,0:07:10.84,0:07:13.22,Default,,0,0,0,,Бұл мен үшін тамаша өмір
Dialogue: 0,0:07:13.30,0:07:16.43,Default,,0,0,0,,Сіздің гей болуыңыз мүмкін.
Dialogue: 0,0:07:16.51,0:07:18.64,Default,,0,0,0,,«Мүмкіндік» дегеніміз не?
Dialogue: 0,0:07:18.72,0:07:20.89,Default,,0,0,0,,Мен білмеймін. Мен қазір кетемін.
Dialogue: 0,0:07:20.98,0:07:23.65,Default,,0,0,0,,Сіздің фигураңыз алмұртқа ұқсайды.
Dialogue: 0,0:07:26.40,0:07:27.44,Default,,0,0,0,,«Қайырлы таң»
Dialogue: 0,0:07:27.53,0:07:29.49,Default,,0,0,0,,Лакроссқа кіру сынағы ертең.
Dialogue: 0,0:07:29.57,0:07:33.41,Default,,0,0,0,,Өзімшіл байларға жақсы жаңалық.
Dialogue: 0,0:07:33.49,0:07:39.04,Default,,0,0,0,,Мені қазір ең қызықтыратын тақырып – Ник пен Джесси арасындағы қарым-қатынас.
Dialogue: 0,0:07:39.12,0:07:41.46,Default,,0,0,0,,Қайсысы істеді?
Dialogue: 0,0:07:41.54,0:07:44.33,Default,,0,0,0,,Ник шындықты айтады
Dialogue: 0,0:07:45.75,0:07:50.97,Default,,0,0,0,,Ник, қарапайым тілмен айтқанда, оны кім алды?
Dialogue: 0,0:07:51.63,0:07:54.68,Default,,0,0,0,,Маған «футта» деген сөз ұнамайды
Dialogue: 0,0:07:54.76,0:07:58.39,Default,,0,0,0,,Кімнің кіммен ажырасқаны маңызды емес, солай ма?
Dialogue: 0,0:07:58.47,0:07:59.60,Default,,0,0,0,,Оны бәрі естігісі келеді
Dialogue: 0,0:08:00.35,0:08:01.60,Default,,0,0,0,,Менің айта алатыным
Dialogue: 0,0:08:01.68,0:08:04.73,Default,,0,0,0,,Өйткені Джесси керемет
Dialogue: 0,0:08:04.81,0:08:08.86,Default,,0,0,0,,Мен үшін қоштасу қиын болды.
Dialogue: 0,0:08:09.73,0:08:12.65,Default,,0,0,0,,Бұл таң қалған Ник болды.
Dialogue: 0,0:08:15.32,0:08:16.20,Default,,0,0,0,,«Ашу»
Dialogue: 0,0:08:16.70,0:08:22.71,Default,,0,0,0,,Қолымды төбеңе көтеріп, жүрегіңді жұлып алайын ба?
Dialogue: 0,0:08:22.79,0:08:24.87,Default,,0,0,0,,Мынау!
Dialogue: 0,0:08:24.96,0:08:28.84,Default,,0,0,0,,Ертең мектепте конъюнктивитпен ауыратын науқас сөйлейді.
Dialogue: 0,0:08:29.00,0:08:33.76,Default,,0,0,0,,Енді ойлап қарасам, доптың үстінде тезек бар екен.
Dialogue: 0,0:08:33.84,0:08:38.05,Default,,0,0,0,,Мен жаттықтырушымын. Мен теледидарда болғаныма қуаныштымын!
Dialogue: 0,0:08:41.39,0:08:45.48,Default,,0,0,0,,Әдетте мен бейсболды осы уақытта қараймын.
Dialogue: 0,0:08:45.85,0:08:49.61,Default,,0,0,0,,Бірақ егер сіз гей болсаңыз, қарауыңыз керек...
Dialogue: 0,0:08:49.69,0:08:51.86,Default,,0,0,0,,Бұл гей порносы.
Dialogue: 0,0:08:51.94,0:08:54.53,Default,,0,0,0,,Мен білемін, бірақ бұл қорқынышты.
Dialogue: 0,0:08:54.61,0:08:58.12,Default,,0,0,0,,Алдымен секіргендей сезілмей ме?
Dialogue: 0,0:08:58.20,0:09:01.04,Default,,0,0,0,,Әтешті басын емес, есекке сал.
Dialogue: 0,0:09:02.20,0:09:05.62,Default,,0,0,0,,Мұны жеке браузерде орындаңыз
Dialogue: 0,0:09:05.71,0:09:06.75,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:06.83,0:09:10.17,Default,,0,0,0,,Печенье жеу жеткілікті
Dialogue: 0,0:09:10.25,0:09:11.46,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:09:12.55,0:09:15.47,Default,,0,0,0,,Бұл сіздің саяхатыңыз, есікті өзіңіз ашыңыз.
Dialogue: 0,0:09:16.68,0:09:17.64,Default,,0,0,0,,басыңыз
Dialogue: 0,0:09:17.72,0:09:18.80,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:20.47,0:09:21.39,Default,,0,0,0,,«Сен жалаңаш болғың келе ме?»
Dialogue: 0,0:09:21.97,0:09:22.93,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:23.02,0:09:23.85,Default,,0,0,0,,Не?
Dialogue: 0,0:09:23.93,0:09:24.64,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:09:24.73,0:09:27.14,Default,,0,0,0,,Мен не істеуім керек? Ол жабылмайды.
Dialogue: 0,0:09:27.23,0:09:29.90,Default,,0,0,0,,Үлкейтпе, жабу
Dialogue: 0,0:09:30.06,0:09:31.57,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:09:30.06,0:09:31.57,Default,,0,0,0,,«Вирус анықталды»
Dialogue: 0,0:09:31.65,0:09:35.57,Default,,0,0,0,,Вирус, ұялыңыз.
Dialogue: 0,0:09:31.65,0:09:35.57,Default,,0,0,0,,``Сіз вирус тараттыңыз''
Dialogue: 0,0:09:35.65,0:09:37.57,Default,,0,0,0,,Эндрю, сен не істеп жатырсың?
Dialogue: 0,0:09:37.66,0:09:38.57,Default,,0,0,0,,Ештеңе!
Dialogue: 0,0:09:38.66,0:09:39.37,Default,,0,0,0,,(Үш мүйізді) Құрлықтағыдай еркін қозғала алмайсың. Көресің әлі!
Dialogue: 0,0:09:39.45,0:09:41.83,Default,,0,0,0,,Менің компьютерімде бірдеңе дұрыс емес.
Dialogue: 0,0:09:41.91,0:09:44.54,Default,,0,0,0,,Екі NFL ойыншысы бірге душ қабылдайды
Dialogue: 0,0:09:44.62,0:09:47.25,Default,,0,0,0,,Неліктен Шеннон Шарп араласады?
Dialogue: 0,0:09:47.33,0:09:49.29,Default,,0,0,0,,Соңында 300-ден астам оқ аттым
Dialogue: 0,0:09:49.46,0:09:50.71,Default,,0,0,0,,«Тәжікке жол берілмейді»
Dialogue: 0,0:09:50.79,0:09:53.88,Default,,0,0,0,,Ілмек болған кезде қандай болдыңыз? Мені жылаттың ба?
Dialogue: 0,0:09:53.96,0:09:56.47,Default,,0,0,0,,Бұл ең ауыр тәжірибе болды.
Dialogue: 0,0:09:56.55,0:09:59.43,Default,,0,0,0,,Бірақ бұл дұрыс әрекет болды
Dialogue: 0,0:09:59.51,0:10:00.55,Default,,0,0,0,,Бұл оның әдеті.
Dialogue: 0,0:10:00.64,0:10:01.97,Default,,0,0,0,,Ник Берч!
Dialogue: 0,0:10:07.31,0:10:09.40,Default,,0,0,0,,Бұл батыстық кино сияқты.
Dialogue: 0,0:10:10.23,0:10:12.48,Default,,0,0,0,,Джесси, танысқаныма қуаныштымын.
Dialogue: 0,0:10:12.57,0:10:13.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:13.48,0:10:14.19,Default,,0,0,0,,Не?
Dialogue: 0,0:10:14.28,0:10:16.40,Default,,0,0,0,,Менің көзім зақымданған, мен ештеңе көрмеймін.
Dialogue: 0,0:10:16.49,0:10:18.49,Default,,0,0,0,,Біз дос бола аламыз, солай ма?
Dialogue: 0,0:10:19.66,0:10:20.57,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:10:21.49,0:10:23.58,Default,,0,0,0,,Дос емес
Dialogue: 0,0:10:23.66,0:10:25.83,Default,,0,0,0,,Еске сала кетейін
Dialogue: 0,0:10:25.91,0:10:29.62,Default,,0,0,0,,Айтайыншы, ренжіген мен болдым.
Dialogue: 0,0:10:29.71,0:10:31.00,Default,,0,0,0,,Бұл өзара ерік.
Dialogue: 0,0:10:31.08,0:10:31.79,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:10:31.88,0:10:32.96,Default,,0,0,0,,Атылу
Dialogue: 0,0:10:33.04,0:10:38.38,Default,,0,0,0,,Сол балықтай еріндерді сүйгенде көзім жетті
Dialogue: 0,0:10:38.97,0:10:40.76,Default,,0,0,0,,Маған фактілерді айтыңыз
Dialogue: 0,0:10:40.84,0:10:43.35,Default,,0,0,0,,Сен мені сүйдің
Dialogue: 0,0:10:43.43,0:10:45.14,Default,,0,0,0,,Мен өкінемін.
Dialogue: 0,0:10:45.22,0:10:46.14,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:10:46.22,0:10:50.44,Default,,0,0,0,,Ол жылы хот-дог сияқты болды.
Dialogue: 0,0:10:50.60,0:10:51.40,Default,,0,0,0,,Иә
Dialogue: 0,0:10:51.48,0:10:52.48,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:10:52.56,0:10:56.73,Default,,0,0,0,,Дөрекі қолтырауынның тілі сияқты
Dialogue: 0,0:10:56.82,0:10:58.69,Default,,0,0,0,,Дауысты және анық айтыңыз
Dialogue: 0,0:10:58.78,0:11:04.08,Default,,0,0,0,,Келесі сені сүйетін қызды аяймын.
Dialogue: 0,0:11:04.16,0:11:06.74,Default,,0,0,0,,Қиянат – махаббаттың бір бөлігі
Dialogue: 0,0:11:06.83,0:11:08.66,Default,,0,0,0,,Бірақ келесі жолы жоқ
Dialogue: 0,0:11:08.75,0:11:11.42,Default,,0,0,0,,Мен бәріне айтамын
Dialogue: 0,0:11:11.50,0:11:16.05,Default,,0,0,0,,Сенің сүйісулерің дүниедегі ең жиіркенішті!
Dialogue: 0,0:11:18.76,0:11:21.34,Default,,0,0,0,,Иппикаие, қарғыс атсын!
Dialogue: 0,0:11:21.43,0:11:23.09,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:11:25.43,0:11:28.27,Default,,0,0,0,,Бұл сұмдық пікір.
Dialogue: 0,0:11:28.35,0:11:31.02,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:11:32.56,0:11:34.15,Default,,0,0,0,,Кек алу
Dialogue: 0,0:11:34.77,0:11:36.36,Default,,0,0,0,,Менің жақсы ойым бар.
Dialogue: 0,0:11:36.65,0:11:39.90,Default,,0,0,0,,Бұл балалық, бірақ оңай және жан-жақты.
Dialogue: 0,0:11:39.99,0:11:42.15,Default,,0,0,0,,Сыбыстарды тарату
Dialogue: 0,0:11:42.24,0:11:45.74,Default,,0,0,0,,«Джесси тезек жейді»
Dialogue: 0,0:11:45.83,0:11:47.74,Default,,0,0,0,,Ол тамақ ішпейді
Dialogue: 0,0:11:47.83,0:11:51.58,Default,,0,0,0,,Сіз елестете алатын нәрсе шындық.
Dialogue: 0,0:11:51.66,0:11:54.13,Default,,0,0,0,,Мен олай айтпаймын.
Dialogue: 0,0:11:54.21,0:11:56.96,Default,,0,0,0,,Біз ұрысамыз, бірақ доспыз.
Dialogue: 0,0:11:58.00,0:12:00.38,Default,,0,0,0,,Дос, ғашық болдық.
Dialogue: 0,0:12:00.46,0:12:02.17,Default,,0,0,0,,Бірақ қазір олар жау
Dialogue: 0,0:12:02.26,0:12:04.89,Default,,0,0,0,,Ажырасу туралы сот сияқты естімеңіз.
Dialogue: 0,0:12:04.97,0:12:05.68,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:05.76,0:12:08.01,Default,,0,0,0,,«Мен лесбиянамын» деп айту
Dialogue: 0,0:12:08.10,0:12:11.02,Default,,0,0,0,,Адамдар мені «гей» дейді
Dialogue: 0,0:12:11.10,0:12:13.89,Default,,0,0,0,,Гей болу жаман нәрсе ме?
Dialogue: 0,0:12:13.98,0:12:15.44,Default,,0,0,0,,Гейлерді ұнатасыз ба?
Dialogue: 0,0:12:15.52,0:12:17.69,Default,,0,0,0,,Бұл ешкімге ұнамайды
Dialogue: 0,0:12:17.77,0:12:18.44,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:12:18.52,0:12:23.70,Default,,0,0,0,,Гей болу дұрыс болса, гей екеніңді неге жасырасың?
Dialogue: 0,0:12:23.78,0:12:24.53,Default,,0,0,0,,Өйткені ол басқаша.
Dialogue: 0,0:12:24.61,0:12:25.32,Default,,0,0,0,,Егер сіз гей болсаңыз...
Dialogue: 0,0:12:25.41,0:12:26.62,Default,,0,0,0,,Бұл қорқынышты түс
Dialogue: 0,0:12:26.70,0:12:28.16,Default,,0,0,0,,Ойлан
Dialogue: 0,0:12:28.24,0:12:33.08,Default,,0,0,0,,Əйелдер мəшесін тығып алған жігіттерді сипайды.
Dialogue: 0,0:12:33.16,0:12:36.25,Default,,0,0,0,,Дикіңізді бөтелкеге ​​салмаңыз.
Dialogue: 0,0:12:36.33,0:12:37.88,Default,,0,0,0,,Сіз елестете аласыз...
Dialogue: 0,0:12:37.96,0:12:39.17,Default,,0,0,0,,Мен оны елестетіп тұрған жоқпын.
Dialogue: 0,0:12:39.25,0:12:42.88,Default,,0,0,0,,Қайсысы жақсы, сом немесе гей?
Dialogue: 0,0:12:42.97,0:12:44.26,Default,,0,0,0,,Екеуі де қате
Dialogue: 0,0:12:44.34,0:12:46.80,Default,,0,0,0,,Сіз оны соншалықты жек көресіз, солай ма?
Dialogue: 0,0:12:46.89,0:12:48.10,Default,,0,0,0,,Мен де гейлерді ұнатпаймын
Dialogue: 0,0:12:48.18,0:12:49.68,Default,,0,0,0,,Гей болғанның несі жаман?
Dialogue: 0,0:12:49.76,0:12:52.43,Default,,0,0,0,,Жаман емес, бірақ қиын сияқты.
Dialogue: 0,0:12:52.52,0:12:55.10,Default,,0,0,0,,Гей порносы да үлкен мәселе
Dialogue: 0,0:12:55.19,0:12:55.94,Default,,0,0,0,,Не?
Dialogue: 0,0:12:56.02,0:12:57.31,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:12:57.40,0:13:00.32,Default,,0,0,0,,Жарайды, мен ваннаға барамын.
Dialogue: 0,0:13:00.90,0:13:02.11,Default,,0,0,0,,Мұны істейік
Dialogue: 0,0:13:02.19,0:13:06.03,Default,,0,0,0,,«Джесси иттің шарларына жағылған майды жалайды».
Dialogue: 0,0:13:06.11,0:13:08.66,Default,,0,0,0,,Егер сіз оны бояғыңыз келсе, бұл сіздің шарларыңыз, солай ма?
Dialogue: 0,0:13:09.53,0:13:11.41,Default,,0,0,0,,Бұл жақсырақ.
Dialogue: 0,0:13:12.08,0:13:15.33,Default,,0,0,0,,Сәлеметсіз бе, Герцог Эллингтон
Dialogue: 0,0:13:15.41,0:13:16.58,Default,,0,0,0,,Бұл Эндрю
Dialogue: 0,0:13:16.67,0:13:18.54,Default,,0,0,0,,Сәлем Эндрю
Dialogue: 0,0:13:19.88,0:13:21.75,Default,,0,0,0,,Менің эссенің тақырыбы болғанымды қалайсың ба?
Dialogue: 0,0:13:21.84,0:13:26.38,Default,,0,0,0,,Стиви Уандер мен туралы ән жазды
Dialogue: 0,0:13:26.47,0:13:29.26,Default,,0,0,0,,Өзін соқыр етіп көрсетеді
Dialogue: 0,0:13:29.35,0:13:32.18,Default,,0,0,0,,Бұл ақылсыз қастандық теориясы.
Dialogue: 0,0:13:33.06,0:13:34.77,Default,,0,0,0,,11 қыркүйек терактілер күні.
Dialogue: 0,0:13:34.85,0:13:38.48,Default,,0,0,0,,Неліктен барлық еврейлер үйде болды?
Dialogue: 0,0:13:38.56,0:13:40.61,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:13:40.69,0:13:43.73,Default,,0,0,0,,Сіз елестете алатын нәрсе шындық.
Dialogue: 0,0:13:44.86,0:13:48.78,Default,,0,0,0,,Айтпақшы, мен біраз кеңес алғым келеді.
Dialogue: 0,0:13:48.86,0:13:53.16,Default,,0,0,0,,Мен гей болуы мүмкін деп қорқамын
Dialogue: 0,0:13:53.24,0:13:57.75,Default,,0,0,0,,Көп ақша мен демалыс үйінің болуынан қорқынышты ештеңе жоқ.
Dialogue: 0,0:13:59.12,0:14:01.13,Default,,0,0,0,,Сіз қандай да бір гейлерді білдіңіз бе?
Dialogue: 0,0:14:01.21,0:14:04.59,Default,,0,0,0,,Бұл шоу-бизнес, сондықтан мен әрине сонда болдым.
Dialogue: 0,0:14:04.67,0:14:06.88,Default,,0,0,0,,Бұл гейлердің кездесуі.
Dialogue: 0,0:14:07.01,0:14:12.26,Default,,0,0,0,,Гей болған тарихи атақты адамдармен таныстыру
Dialogue: 0,0:14:12.35,0:14:13.56,Default,,0,0,0,,Сократ
Dialogue: 0,0:14:13.64,0:14:14.60,Default,,0,0,0,,Фредди Меркьюри
Dialogue: 0,0:14:14.68,0:14:18.48,Default,,0,0,0,,Және судья Антонин Скалия
Dialogue: 0,0:14:18.56,0:14:20.86,Default,,0,0,0,,Скалия Жоғарғы Сотта ма?
Dialogue: 0,0:14:20.94,0:14:22.98,Default,,0,0,0,,Бірақ сіз гейлерге қарсы болдыңыз, солай ма?
Dialogue: 0,0:14:23.07,0:14:27.49,Default,,0,0,0,,Мен тірі кезде шыққым келді.
Dialogue: 0,0:14:27.57,0:14:32.49,Default,,0,0,0,,Аруақтың сиқы вегетариандық етке ұқсайды.
Dialogue: 0,0:14:32.58,0:14:33.99,Default,,0,0,0,,Бұл жұмсақ.
Dialogue: 0,0:14:34.08,0:14:35.12,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:14:35.20,0:14:38.12,Default,,0,0,0,,Ежелгі Греция – гейлер жұмағы
Dialogue: 0,0:14:38.54,0:14:39.87,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:14:39.96,0:14:41.96,Default,,0,0,0,,Егер сіз теңіз жағасында тұрсаңыз?
Dialogue: 0,0:14:42.04,0:14:45.17,Default,,0,0,0,,Маған Остин ұнайды, оның ұраны «біртүрлі».
Dialogue: 0,0:14:45.25,0:14:47.34,Default,,0,0,0,,Гейлер ең жақсы
Dialogue: 0,0:14:47.42,0:14:48.84,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:48.92,0:14:50.30,Default,,0,0,0,,Сіз жақсы тыңдадыңыз.
Dialogue: 0,0:14:50.72,0:14:54.39,Default,,0,0,0,,Гейлер әлемі қандай?
Dialogue: 0,0:14:59.39,0:15:04.48,Default,,0,0,0,,Сіз гей болған кезде, күн сайын көз тігеді
Dialogue: 0,0:15:04.98,0:15:07.82,Default,,0,0,0,,Өзіңіздің даралығыңыз бен талантыңыз үшін барлық жерде сүйікті болыңыз
Dialogue: 0,0:15:07.90,0:15:11.32,Default,,0,0,0,,Бірақ Солтүстік Каролина басқа.
Dialogue: 0,0:15:11.41,0:15:14.20,Default,,0,0,0,,Шаруалар, патшайымдар және орта тап бар.
Dialogue: 0,0:15:14.28,0:15:17.04,Default,,0,0,0,,Әлем алуан түрлі
Dialogue: 0,0:15:17.12,0:15:19.79,Default,,0,0,0,,Қатты бөкселеріңізге сәлем
Dialogue: 0,0:15:19.87,0:15:22.92,Default,,0,0,0,,Ал қынаппен қоштасу
Dialogue: 0,0:15:23.00,0:15:25.67,Default,,0,0,0,,Кел, гей бол.
Dialogue: 0,0:15:25.75,0:15:28.67,Default,,0,0,0,,Жарқыраған кемпірқосақ бол
Dialogue: 0,0:15:28.76,0:15:31.76,Default,,0,0,0,,Өзіңіздің жаңа адамыңызбен танысыңыз
Dialogue: 0,0:15:31.84,0:15:34.93,Default,,0,0,0,,ЛГБТ әлемінде
Dialogue: 0,0:15:35.89,0:15:38.43,Default,,0,0,0,,Мен мүлдем геймін
Dialogue: 0,0:15:38.52,0:15:40.85,Default,,0,0,0,,Мен әдемі бұршақпын
Dialogue: 0,0:15:40.94,0:15:43.69,Default,,0,0,0,,Дауыспен айқайлаңыз
Dialogue: 0,0:15:43.77,0:15:45.19,Default,,0,0,0,,Жұрт болайық
Dialogue: 0,0:15:45.27,0:15:48.78,Default,,0,0,0,,Мен бүгін өзімді таптым
Dialogue: 0,0:15:48.86,0:15:50.78,Default,,0,0,0,,Кәне, ән айтайық
Dialogue: 0,0:15:50.86,0:15:54.03,Default,,0,0,0,,Қызғылт жанған мерейтой.
Dialogue: 0,0:15:54.11,0:15:57.03,Default,,0,0,0,,Мен бұрынғыдай емеспін.
Dialogue: 0,0:15:57.12,0:16:01.37,Default,,0,0,0,,Осы біртүрлі өзіме үйреніңіз
Dialogue: 0,0:16:02.46,0:16:06.29,Default,,0,0,0,,Мен геймін~
Dialogue: 0,0:16:06.38,0:16:12.80,Default,,0,0,0,,Ол гей екені анық~
Dialogue: 0,0:16:17.51,0:16:20.43,Default,,0,0,0,,Мэтью Мен геймін
Dialogue: 0,0:16:20.52,0:16:24.35,Default,,0,0,0,,Осы мәлімдемені жасап жатқанда серуендеп жүргеніңізді көру өте жақсы.
Dialogue: 0,0:16:24.44,0:16:26.90,Default,,0,0,0,,Мен мақтаншақ геймін
Dialogue: 0,0:16:26.98,0:16:29.69,Default,,0,0,0,,Келесі кезекте киімімді ауыстыруым керек пе?
Dialogue: 0,0:16:29.78,0:16:32.07,Default,,0,0,0,,Жігіт іздеп жүрсіз бе?
Dialogue: 0,0:16:32.15,0:16:34.86,Default,,0,0,0,,Менің жігітім бар
Dialogue: 0,0:16:34.95,0:16:35.82,Default,,0,0,0,,Қайда?
Dialogue: 0,0:16:35.91,0:16:36.62,Default,,0,0,0,,Жержаңғақ
Dialogue: 0,0:16:37.03,0:16:38.03,Default,,0,0,0,,Кішкентай ит
Dialogue: 0,0:16:38.12,0:16:38.99,Default,,0,0,0,,Кішкентай ит?
Dialogue: 0,0:16:39.08,0:16:40.91,Default,,0,0,0,,Тедди Грэм мырза
Dialogue: 0,0:16:41.00,0:16:41.58,Default,,0,0,0,,Ник?
Dialogue: 0,0:16:41.66,0:16:43.66,Default,,0,0,0,,Иә, балақай
Dialogue: 0,0:16:43.75,0:16:46.54,Default,,0,0,0,,Ник жай ғана дос
Dialogue: 0,0:16:46.63,0:16:49.04,Default,,0,0,0,,Біз әрқашан бірге болсақ та
Dialogue: 0,0:16:49.13,0:16:52.55,Default,,0,0,0,,Бір-біріңді қызғанып, ұрысып...
Dialogue: 0,0:16:52.63,0:16:55.13,Default,,0,0,0,,Биіктік айырмашылығы дұрыс
Dialogue: 0,0:16:55.22,0:16:55.84,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:16:55.93,0:16:58.51,Default,,0,0,0,,Бұл гейлер қоғамында маңызды
Dialogue: 0,0:16:58.60,0:16:59.51,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:16:59.60,0:17:02.10,Default,,0,0,0,,Осы мақсатта алдымен маған өзіңнің Қирктеріңнің егжей-тегжейін айт.
Dialogue: 0,0:17:02.56,0:17:04.85,Default,,0,0,0,,Иә, бұл Ник.
Dialogue: 0,0:17:04.94,0:17:06.69,Default,,0,0,0,,Бұл Ник болатын.
Dialogue: 0,0:17:07.06,0:17:08.48,Default,,0,0,0,,Гей деп жариялау?
Dialogue: 0,0:17:08.56,0:17:11.23,Default,,0,0,0,,Иә, бірақ осы уақытқа дейін қайда болдың?
Dialogue: 0,0:17:11.32,0:17:16.74,Default,,0,0,0,,Джо Уолш Рок-н-ролл Даңқ залында таныстырылды.
Dialogue: 0,0:17:17.20,0:17:21.29,Default,,0,0,0,,Ол бар болғанша, Жартас ешқашан өлмейді.
Dialogue: 0,0:17:21.37,0:17:26.25,Default,,0,0,0,,Аңызға айналған Eagles гитаристі Джо...
Dialogue: 0,0:17:26.33,0:17:27.50,Default,,0,0,0,,Қалғанын елестетіп көріңізші
Dialogue: 0,0:17:27.58,0:17:31.38,Default,,0,0,0,,Бұл сіз айтып отырған гей бала ма?
Dialogue: 0,0:17:31.46,0:17:33.38,Default,,0,0,0,,Мен ең жақын досыма ғашықпын
Dialogue: 0,0:17:33.46,0:17:37.55,Default,,0,0,0,,Идеал, солай ма? Оны ата-анасы да жақсы көреді
Dialogue: 0,0:17:37.63,0:17:41.72,Default,,0,0,0,,Егер ол да гей болса, біз үйлестіре аламыз.
Dialogue: 0,0:17:41.81,0:17:45.06,Default,,0,0,0,,Мен бұл туралы Никтен білуім керек.
Dialogue: 0,0:17:45.14,0:17:50.40,Default,,0,0,0,,Егер сен гей болмасаң, таңның күшті жарығы қатал болар еді.
Dialogue: 0,0:17:50.48,0:17:55.57,Default,,0,0,0,,Бұлай болса, менің жоспарым бұзылады.
Dialogue: 0,0:17:55.65,0:18:00.70,Default,,0,0,0,,Мен жариялау құқығына байланысты сотта қалып қойдым...
Dialogue: 0,0:18:00.78,0:18:05.12,Default,,0,0,0,,Дон Хенли менің туған күніме қоңырау шалуды қойды.
Dialogue: 0,0:18:05.20,0:18:07.66,Default,,0,0,0,,Дос болсақ та
Dialogue: 0,0:18:07.75,0:18:09.17,Default,,0,0,0,,«Туған күніңмен! Ленни Кравиц»
Dialogue: 0,0:18:16.34,0:18:16.97,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:18:17.05,0:18:18.18,Default,,0,0,0,,Джесси!
Dialogue: 0,0:18:18.26,0:18:19.97,Default,,0,0,0,,Сіз мұнда келмейсіз бе?
Dialogue: 0,0:18:20.05,0:18:22.39,Default,,0,0,0,,Рахмет сізге ханым
Dialogue: 0,0:18:22.47,0:18:25.60,Default,,0,0,0,,Жемістерді қайнатқандар бар ма?
Dialogue: 0,0:18:26.39,0:18:27.85,Default,,0,0,0,,Мен бұлай істеуден аулақ боламын.
Dialogue: 0,0:18:27.94,0:18:29.19,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:18:29.27,0:18:32.23,Default,,0,0,0,,Қосыла алмау өте қиын.
Dialogue: 0,0:18:32.31,0:18:35.94,Default,,0,0,0,,Себебі сіз Никтің ерніне тіл тигіздіңіз.
Dialogue: 0,0:18:36.24,0:18:36.82,Default,,0,0,0,,Иә
Dialogue: 0,0:18:36.90,0:18:39.15,Default,,0,0,0,,Сіз ашулы болдыңыз, солай емес пе?
Dialogue: 0,0:18:39.24,0:18:41.16,Default,,0,0,0,,Мен қатты ашуландым.
Dialogue: 0,0:18:41.24,0:18:44.33,Default,,0,0,0,,Біз Ник пен Эндрюден айырылдық.
Dialogue: 0,0:18:44.41,0:18:47.08,Default,,0,0,0,,Бұл дүние ең мықтының аман қалуы.
Dialogue: 0,0:18:47.16,0:18:50.00,Default,,0,0,0,,Мен соншалықты алыс деп ойламадым.
Dialogue: 0,0:18:52.42,0:18:54.96,Default,,0,0,0,,Мен сәбіз жегенді жек көремін.
Dialogue: 0,0:18:55.05,0:18:57.80,Default,,0,0,0,,Тіпті тезек жесе де
Dialogue: 0,0:18:57.88,0:19:00.84,Default,,0,0,0,,Тоқта! Неліктен бұл болды?
Dialogue: 0,0:19:00.93,0:19:03.60,Default,,0,0,0,,Джессимен қарым-қатынасым туралы ойлау
Dialogue: 0,0:19:03.68,0:19:06.14,Default,,0,0,0,,Әйелдер керек пе, күмәнді емес пе?
Dialogue: 0,0:19:06.22,0:19:09.60,Default,,0,0,0,,Маған ана, жезөкше, т.б.
Dialogue: 0,0:19:09.69,0:19:13.06,Default,,0,0,0,,Ер адамдар бір-бірімен жақсы араласады...
Dialogue: 0,0:19:13.15,0:19:16.44,Default,,0,0,0,,Ол еркек болса ше?
Dialogue: 0,0:19:16.53,0:19:18.82,Default,,0,0,0,,Әйелмен дос бола алмайсың ба?
Dialogue: 0,0:19:18.90,0:19:22.61,Default,,0,0,0,,Жоқ, менімен саяхаттағаныңыз қалай?
Dialogue: 0,0:19:22.70,0:19:25.45,Default,,0,0,0,,Лагердегі әйелдерді ұмытыңыз
Dialogue: 0,0:19:25.53,0:19:27.20,Default,,0,0,0,,Мен де...
Dialogue: 0,0:19:27.29,0:19:28.66,Default,,0,0,0,,Сіз мұны істей алмайсыз!
Dialogue: 0,0:19:29.50,0:19:31.50,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:19:31.58,0:19:33.54,Default,,0,0,0,,Оны бақылауға болады.
Dialogue: 0,0:19:42.18,0:19:43.59,Default,,0,0,0,,Ник Бала
Dialogue: 0,0:19:43.68,0:19:46.68,Default,,0,0,0,,Ешкім тыңдамайтын әндер жасап жатырмын.
Dialogue: 0,0:19:48.27,0:19:52.06,Default,,0,0,0,,Өлім қандай қайғылы
Dialogue: 0,0:19:52.14,0:19:54.44,Default,,0,0,0,,Неліктен сіздің бетіңіз қара?
Dialogue: 0,0:19:54.52,0:19:57.36,Default,,0,0,0,,Бұрынғы қызыңызбен дос болдыңыз ба?
Dialogue: 0,0:19:57.44,0:19:58.98,Default,,0,0,0,,Жоқ! Бұл мүмкін емес
Dialogue: 0,0:19:59.07,0:19:59.78,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:19:59.86,0:20:01.70,Default,,0,0,0,,Мен Джессимен тіл табысқым келеді
Dialogue: 0,0:20:01.78,0:20:05.03,Default,,0,0,0,,Балалар, осы аптада сізде проблема бар.
Dialogue: 0,0:20:05.12,0:20:05.66,Default,,0,0,0,,Не?
Dialogue: 0,0:20:05.74,0:20:08.37,Default,,0,0,0,,Эндрю де келді.
Dialogue: 0,0:20:08.45,0:20:11.21,Default,,0,0,0,,Мен гей болуы мүмкін деп ойлаймын
Dialogue: 0,0:20:11.29,0:20:14.63,Default,,0,0,0,,Жоқ, сіз мұны маған айтуыңыз керек еді.
Dialogue: 0,0:20:14.71,0:20:15.33,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:20:15.42,0:20:18.00,Default,,0,0,0,,Мүмкін сіз оны айтуға қорқатын шығарсыз
Dialogue: 0,0:20:18.09,0:20:20.55,Default,,0,0,0,,Себебі сен мені жек көресің
Dialogue: 0,0:20:20.63,0:20:23.30,Default,,0,0,0,,Мен гей болсам да дос болғым келеді
Dialogue: 0,0:20:23.38,0:20:27.47,Default,,0,0,0,,Ол мойындаған соң, сіз оны топтан қуып жібердіңіз.
Dialogue: 0,0:20:27.55,0:20:31.81,Default,,0,0,0,,Ол өте кедей болып, трамвайға секіреді.
Dialogue: 0,0:20:32.23,0:20:34.48,Default,,0,0,0,,Сіз гейлерді қуып жібердіңіз бе?
Dialogue: 0,0:20:34.56,0:20:38.73,Default,,0,0,0,,Жоқ, мен гейлерді қарсы аламын.
Dialogue: 0,0:20:38.82,0:20:40.44,Default,,0,0,0,,Жанкүйерлер санының артуы
Dialogue: 0,0:20:41.49,0:20:43.90,Default,,0,0,0,,Мен сені қумаймын
Dialogue: 0,0:20:43.99,0:20:45.41,Default,,0,0,0,,Бейшара Эндрю
Dialogue: 0,0:20:45.49,0:20:49.16,Default,,0,0,0,,Бұл қазір жақсы ән.
Dialogue: 0,0:20:49.24,0:20:51.70,Default,,0,0,0,,Мен болсам, ренжімей шақырар едім.
Dialogue: 0,0:20:51.79,0:20:54.87,Default,,0,0,0,,«Кедейді» «сүйкімдіге» айналдырыңыз
Dialogue: 0,0:20:55.17,0:20:58.21,Default,,0,0,0,,Әй сүйкімді Дезири!
Dialogue: 0,0:21:00.75,0:21:01.30,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:01.38,0:21:02.13,Default,,0,0,0,,Жоғары
Dialogue: 0,0:21:02.21,0:21:03.26,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:21:03.34,0:21:05.97,Default,,0,0,0,,Мен Дюкпен сөйлестім.
Dialogue: 0,0:21:06.93,0:21:11.10,Default,,0,0,0,,Біз Стиви Уандер туралы сөйлестік пе?
Dialogue: 0,0:21:11.18,0:21:14.48,Default,,0,0,0,,Жоқ, мен сен туралы айтып едім.
Dialogue: 0,0:21:15.44,0:21:17.19,Default,,0,0,0,,Гей болуы мүмкін бе?
Dialogue: 0,0:21:17.27,0:21:21.86,Default,,0,0,0,,Аруақтардың құпиялылық бойынша міндеттемелері жоқ па?
Dialogue: 0,0:21:21.94,0:21:23.78,Default,,0,0,0,,Сіздің гей екеніңіз рас па?
Dialogue: 0,0:21:23.86,0:21:24.86,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:21:24.95,0:21:28.45,Default,,0,0,0,,«PB:NYC» фильмін көргенде мен эрекция аламын
Dialogue: 0,0:21:28.53,0:21:30.41,Default,,0,0,0,,Бұл өте көп.
Dialogue: 0,0:21:30.49,0:21:34.25,Default,,0,0,0,,Мен қыздармен сөйлесе алмаймын, бірақ ұрық тастағым келеді
Dialogue: 0,0:21:34.33,0:21:37.92,Default,,0,0,0,,Себебі мен ешкіммен жақсы араласа алмаймын
Dialogue: 0,0:21:38.00,0:21:41.00,Default,,0,0,0,,Гей болған жақсы болар еді
Dialogue: 0,0:21:41.09,0:21:44.26,Default,,0,0,0,,Бірақ мен бұл туралы айтқанымда түсіне алмадым.
Dialogue: 0,0:21:44.34,0:21:46.80,Default,,0,0,0,,Тексерудің жолы бар ма?
Dialogue: 0,0:21:46.88,0:21:49.51,Default,,0,0,0,,Мен ешқашан еркекті сүйген емеспін...
Dialogue: 0,0:21:59.10,0:22:00.11,Default,,0,0,0,,Мені сүйді
Dialogue: 0,0:22:00.19,0:22:03.40,Default,,0,0,0,,Бұл эксперимент. Мен көмектескім келеді.
Dialogue: 0,0:22:03.48,0:22:04.82,Default,,0,0,0,,Сіз бірдеңе сезіндіңіз бе?
Dialogue: 0,0:22:05.94,0:22:07.15,Default,,0,0,0,,Фунячин
Dialogue: 0,0:22:07.24,0:22:09.53,Default,,0,0,0,,Оны аузына сал
Dialogue: 0,0:22:09.61,0:22:12.53,Default,,0,0,0,,Сені масқара қылайық
Dialogue: 0,0:22:12.62,0:22:14.12,Default,,0,0,0,,Аузыңды жап
Dialogue: 0,0:22:14.20,0:22:16.12,Default,,0,0,0,,Толтырмадым
Dialogue: 0,0:22:16.20,0:22:17.29,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:22:17.37,0:22:18.62,Default,,0,0,0,,Пайдасыз әңгіме
Dialogue: 0,0:22:19.83,0:22:22.25,Default,,0,0,0,,Сонымен, қорытындыға келдіңіз бе?
Dialogue: 0,0:22:22.34,0:22:24.67,Default,,0,0,0,,Шынымды айтсам, бұл жақсы болмады.
Dialogue: 0,0:22:24.76,0:22:26.55,Default,,0,0,0,,Бұл сом балық болғандықтан ба?
Dialogue: 0,0:22:26.63,0:22:31.14,Default,,0,0,0,,Бұл сенің ернің емес, мен ештеңе сезбеймін.
Dialogue: 0,0:22:31.22,0:22:32.51,Default,,0,0,0,,Мүмкін ол гей емес шығар
Dialogue: 0,0:22:32.97,0:22:35.31,Default,,0,0,0,,Бірақ сүйгеніңіз үшін рахмет.
Dialogue: 0,0:22:36.06,0:22:37.35,Default,,0,0,0,,Қош келдіңіз...
Dialogue: 0,0:22:37.43,0:22:39.98,Default,,0,0,0,,Мен бірінші рет сүйген адам екеніңізге сене алар емеспін
Dialogue: 0,0:22:40.06,0:22:41.61,Default,,0,0,0,,Немереме не айтуым керек?
Dialogue: 0,0:22:41.69,0:22:44.73,Default,,0,0,0,,Атаның бірінші сүйгені кім?
Dialogue: 0,0:22:44.82,0:22:47.82,Default,,0,0,0,,Сіз Ник ағаны білесіз, солай ма?
Dialogue: 0,0:22:47.90,0:22:51.03,Default,,0,0,0,,«Жүлдеге ие болыңыз! Кері санақ» фильмінен Ник?
Dialogue: 0,0:22:51.11,0:22:53.95,Default,,0,0,0,,Бұл адамдар мен компьютерлер арасындағы шайқас.
Dialogue: 0,0:22:54.03,0:22:56.95,Default,,0,0,0,,Жүлде – Қытай Корольдігінің Bitcoin.
Dialogue: 0,0:22:57.04,0:23:01.00,Default,,0,0,0,,Отыру керек пе, әлде билеу керек пе?
Dialogue: 0,0:23:01.12,0:23:06.76,Default,,0,0,0,,"Жүлде алыңыз! Кері санақ"
Dialogue: 0,0:23:06.88,0:23:07.76,Default,,0,0,0,,Нихао!
Dialogue: 0,0:23:07.84,0:23:09.26,Default,,0,0,0,,“ＰＢ：ＮＹＣ”
Dialogue: 0,0:23:09.84,0:23:11.22,Default,,0,0,0,,Ол дамымайды.
Dialogue: 0,0:23:11.30,0:23:13.55,Default,,0,0,0,,Асығыңыз, фильм басталады.
Dialogue: 0,0:23:13.64,0:23:17.06,Default,,0,0,0,,Фильм? Дәріхана есептегіші ше?
Dialogue: 0,0:23:17.14,0:23:19.43,Default,,0,0,0,,Қарасам, көз тамшылары да жоқ.
Dialogue: 0,0:23:19.52,0:23:21.60,Default,,0,0,0,,Сондықтан жіп шықпайды.
Dialogue: 0,0:23:21.69,0:23:22.69,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:23:23.15,0:23:23.90,Default,,0,0,0,,Бұл Джесси.
Dialogue: 0,0:23:23.98,0:23:25.11,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:23:25.19,0:23:28.07,Default,,0,0,0,,Жоқ, бұл туралы екеуің сөйлесіңдер.
Dialogue: 0,0:23:28.94,0:23:30.15,Default,,0,0,0,,О, Ник
Dialogue: 0,0:23:30.24,0:23:31.78,Default,,0,0,0,,Бұрынғыдай кішкентай.
Dialogue: 0,0:23:31.86,0:23:33.99,Default,,0,0,0,,Сізде әлі үлкен есек бар.
Dialogue: 0,0:23:34.07,0:23:35.37,Default,,0,0,0,,Иә, бәрі осы.
Dialogue: 0,0:23:35.45,0:23:38.62,Default,,0,0,0,,Достықтан ғашыққа айналдық.
Dialogue: 0,0:23:38.70,0:23:40.21,Default,,0,0,0,,Біз қайтадан дос бола алмаймыз ба?
Dialogue: 0,0:23:40.29,0:23:43.21,Default,,0,0,0,,Сол плакаттың алдына өтіңіз
Dialogue: 0,0:23:43.29,0:23:46.38,Default,,0,0,0,,Бірге шешейік.
Dialogue: 0,0:23:47.05,0:23:47.88,Default,,0,0,0,,Сіз гейсіз бе?
Dialogue: 0,0:23:47.96,0:23:50.47,Default,,0,0,0,,Эндрю дұрыс айтады.
Dialogue: 0,0:23:47.96,0:23:50.47,Default,,0,0,0,,«Жақында Атланта Клаус»
Dialogue: 0,0:23:50.55,0:23:55.72,Default,,0,0,0,,"Дос болайық" деп сұрағанда қуандым.
Dialogue: 0,0:23:55.80,0:23:57.93,Default,,0,0,0,,Бірақ ғашық ретінде ең жаманы
Dialogue: 0,0:23:58.01,0:23:59.39,Default,,0,0,0,,Мүлдем.
Dialogue: 0,0:23:59.47,0:24:01.23,Default,,0,0,0,,Бұл дәріхана емес пе?
Dialogue: 0,0:24:01.31,0:24:05.52,Default,,0,0,0,,Балаларға арналған доп бассейні қайда?
Dialogue: 0,0:24:05.61,0:24:08.53,Default,,0,0,0,,Осындай қорқынышты сөз айтқаным үшін кешірім сұраймын.
Dialogue: 0,0:24:08.61,0:24:11.15,Default,,0,0,0,,Жоқ, өйткені мен өтірік айттым.
Dialogue: 0,0:24:11.24,0:24:13.49,Default,,0,0,0,,Мен тасталды деп айта алмаймын
Dialogue: 0,0:24:13.57,0:24:15.49,Default,,0,0,0,,Екеуі де.
Dialogue: 0,0:24:15.57,0:24:16.87,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:24:17.16,0:24:18.70,Default,,0,0,0,,Бірге тамашалайық
Dialogue: 0,0:24:18.79,0:24:19.91,Default,,0,0,0,,Алдымен барыңыз.
Dialogue: 0,0:24:20.00,0:24:21.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:24:23.25,0:24:28.75,Default,,0,0,0,,Атланта Клаус, маған дәріхана табуға көмектесіңізші.
Dialogue: 0,0:24:28.84,0:24:30.63,Default,,0,0,0,,Рождество мерекесімен!
Dialogue: 0,0:24:30.71,0:24:33.51,Default,,0,0,0,,Сен жақсысың ба, әлде жамансың ба?
Dialogue: 0,0:24:33.59,0:24:35.97,Default,,0,0,0,,Қара Аяз ата, мен мойындаймын.
Dialogue: 0,0:24:36.05,0:24:37.39,Default,,0,0,0,,Мен жаман адаммын
Dialogue: 0,0:24:37.47,0:24:40.60,Default,,0,0,0,,Мен допқа нәжім бердім
Dialogue: 0,0:24:40.68,0:24:43.27,Default,,0,0,0,,Халлилуя!
Dialogue: 0,0:24:43.73,0:24:46.52,Default,,0,0,0,,Эй, мен саған айтамын.
Dialogue: 0,0:24:46.61,0:24:48.65,Default,,0,0,0,,Мен ақыры түсіндім
Dialogue: 0,0:24:48.73,0:24:49.90,Default,,0,0,0,,Гей емес
Dialogue: 0,0:24:49.98,0:24:52.99,Default,,0,0,0,,Бұл өте қиын болды.
Dialogue: 0,0:24:53.07,0:24:58.20,Default,,0,0,0,,Бірақ гейлердің дәрежелері бар және оларды мүлде басқаша деп айтуға болмайды.
Dialogue: 0,0:24:58.28,0:25:00.45,Default,,0,0,0,,Түсіндім, сен ше?
Dialogue: 0,0:25:00.54,0:25:03.29,Default,,0,0,0,,Моллидің гей сынағынан өтті.
Dialogue: 0,0:25:03.37,0:25:05.87,Default,,0,0,0,,Молли гормон ба?
Dialogue: 0,0:25:05.96,0:25:09.17,Default,,0,0,0,,Ол жабайы адам емес пе?
Dialogue: 0,0:25:09.25,0:25:10.88,Default,,0,0,0,,Әсіресе көңіл толқыған кезде
Dialogue: 0,0:25:10.96,0:25:13.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:25:13.09,0:25:16.68,Default,,0,0,0,,Бәрібір қорытынды жасауға асықпаңыз
Dialogue: 0,0:25:16.76,0:25:18.51,Default,,0,0,0,,Әрбір эрекциямен айналысыңыз
Dialogue: 0,0:25:19.18,0:25:23.02,Default,,0,0,0,,Бұл сүйкімді. Мен "PB:NYC" көріп жатырмын
Dialogue: 0,0:25:23.27,0:25:24.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:25:25.23,0:25:26.90,Default,,0,0,0,,Өзіңізді өте гей сезіну
Dialogue: 0,0:25:26.98,0:25:28.15,Default,,0,0,0,,Осы мақсатта алдымен маған өзіңнің Қирктеріңнің егжей-тегжейін айт.
Dialogue: 0,0:25:29.65,0:25:32.65,Default,,0,0,0,,Пол, Қайда бара жатырсың?
Dialogue: 0,0:25:32.73,0:25:35.49,Default,,0,0,0,,Орталық саябақтағы бұта.
Dialogue: 0,0:25:36.40,0:25:38.87,Default,,0,0,0,,Бұл қай жерде? дәріхана?
Dialogue: 0,0:25:38.95,0:25:41.16,Default,,0,0,0,,Орталық саябақтың гейлер бөлімі?
Dialogue: 0,0:25:41.24,0:25:45.37,Default,,0,0,0,,Мен «Ван Хельсинг» DVD дискісін жалға алғым келеді
Dialogue: 0,0:25:48.29,0:25:49.88,Default,,0,0,0,,«Келесі эпизод»
Dialogue: 0,0:25:50.79,0:25:53.92,Default,,0,0,0,,Netflix-те дәріхана бар ма?
Dialogue: 0,0:25:54.01,0:25:56.34,Default,,0,0,0,,Келесіде не көруді жоспарлап отырсыз?
Dialogue: 0,0:25:56.42,0:25:58.39,Default,,0,0,0,,Келесі эпизод?
Dialogue: 0,0:26:50.52,0:26:52.52,Default,,0,0,0,,Жапон субтитрлері Нагиса Исозаки
Dialogue: 0,0:26:54.02,0:27:00.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
