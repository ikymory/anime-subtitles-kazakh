Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:08.21,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:08.67,0:00:09.17,Default,,0,0,0,,〝Бриджтон орта мектебі〞
Dialogue: 0,0:00:09.17,0:00:10.42,Default,,0,0,0,,〝Бриджтон орта мектебі〞
Dialogue: 0,0:00:09.17,0:00:10.42,Default,,0,0,0,,Жыныстық жетілу кезінде гормондар бөліне бастайды.
Dialogue: 0,0:00:10.42,0:00:10.51,Default,,0,0,0,,Жыныстық жетілу кезінде гормондар бөліне бастайды.
Dialogue: 0,0:00:10.51,0:00:12.22,Default,,0,0,0,,Жыныстық жетілу кезінде гормондар бөліне бастайды.
Dialogue: 0,0:00:10.51,0:00:12.22,Default,,0,0,0,,«Әйелдердің ұрпақты болу мүшелері»
Dialogue: 0,0:00:12.22,0:00:12.30,Default,,0,0,0,,«Әйелдердің ұрпақты болу мүшелері»
Dialogue: 0,0:00:12.30,0:00:14.59,Default,,0,0,0,,«Әйелдердің ұрпақты болу мүшелері»
Dialogue: 0,0:00:12.30,0:00:14.59,Default,,0,0,0,,Жыныс мүшелері өзгереді
Dialogue: 0,0:00:14.97,0:00:19.01,Default,,0,0,0,,Әйелдердің маңызды репродуктивті мүшесі болып табылатын жатыр...
Dialogue: 0,0:00:19.10,0:00:22.14,Default,,0,0,0,,Қыздарға арналған бұл қынап, солай ма?
Dialogue: 0,0:00:22.23,0:00:23.98,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,0:00:24.06,0:00:26.77,Default,,0,0,0,,Қынап – жаргон термині ме?
Dialogue: 0,0:00:26.86,0:00:28.73,Default,,0,0,0,,Қынап?
Dialogue: 0,0:00:28.82,0:00:30.36,Default,,0,0,0,,Жоқ, қазір емес.
Dialogue: 0,0:00:30.44,0:00:31.32,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:00:32.94,0:00:34.61,Default,,0,0,0,,Жоғал
Dialogue: 0,0:00:34.70,0:00:37.87,Default,,0,0,0,,Сіз гормондардың елесінсіз
Dialogue: 0,0:00:38.20,0:00:43.20,Default,,0,0,0,,Бірақ сенің сиқырың үлкен екені рас.
Dialogue: 0,0:00:43.33,0:00:44.54,Default,,0,0,0,,Осамаре
Dialogue: 0,0:00:44.66,0:00:46.29,Default,,0,0,0,,«Жұмыртқа» Шығарылған жұмыртқа жатыр түтігінен өтеді...
Dialogue: 0,0:00:46.29,0:00:46.58,Default,,0,0,0,,Шығарылған жұмыртқа жатыр түтігінен өтеді...
Dialogue: 0,0:00:46.58,0:00:48.38,Default,,0,0,0,,Шығарылған жұмыртқа жатыр түтігінен өтеді... «жатыр түтігі»
Dialogue: 0,0:00:48.46,0:00:51.55,Default,,0,0,0,,Егер бұл жатыр түтігі болса, сізді ұрып-соғады.
Dialogue: 0,0:00:51.63,0:00:54.97,Default,,0,0,0,,Мен оны елестете аламын, солай ма?
Dialogue: 0,0:00:55.05,0:00:58.09,Default,,0,0,0,,Бұл – мектеп, бірігіңіздер.
Dialogue: 0,0:00:58.18,0:01:01.68,Default,,0,0,0,,Мені жоғалту үшін не істеу керек?
Dialogue: 0,0:01:02.18,0:01:02.81,Default,,0,0,0,,Мастурбация
Dialogue: 0,0:01:02.89,0:01:04.52,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:01:04.60,0:01:08.86,Default,,0,0,0,,Жуынатын бөлмеге барайық, оны шаң қағазға саламыз.
Dialogue: 0,0:01:09.23,0:01:14.07,Default,,0,0,0,,Еркектер эякуляция жасайды, бірақ бұл драмалық.
Dialogue: 0,0:01:14.15,0:01:16.95,Default,,0,0,0,,Қыздарда тек сөмкелер мен түтіктер бар
Dialogue: 0,0:01:17.03,0:01:18.16,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:01:18.24,0:01:20.70,Default,,0,0,0,,Гендерлік теңдікке қайшы
Dialogue: 0,0:01:20.78,0:01:24.62,Default,,0,0,0,,Әкем әйелдерге декреттік демалыста жеңілдік беретінін айтты.
Dialogue: 0,0:01:24.70,0:01:26.83,Default,,0,0,0,,Жаман адвокат болғанына қарамастан
Dialogue: 0,0:01:26.92,0:01:28.58,Default,,0,0,0,,Бірақ ол бай.
Dialogue: 0,0:01:28.67,0:01:31.34,Default,,0,0,0,,Баламның қасы бай.
Dialogue: 0,0:01:31.42,0:01:32.13,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:01:32.25,0:01:34.67,Default,,0,0,0,,Қараңызшы, мен өз шегіме жеттім.
Dialogue: 0,0:01:34.76,0:01:36.88,Default,,0,0,0,,Мұғалім, бұл әжетхана.
Dialogue: 0,0:01:36.97,0:01:41.10,Default,,0,0,0,,Асығыңыз, шалбарыңызда Поллоктың суреті пайда болды.
Dialogue: 0,0:01:41.18,0:01:43.35,Default,,0,0,0,,Көженің абстрактілі суреті
Dialogue: 0,0:01:43.47,0:01:45.18,Default,,0,0,0,,Жазбалар алу
Dialogue: 0,0:01:45.27,0:01:46.02,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:01:46.10,0:01:47.35,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:01:47.44,0:01:50.52,Default,,0,0,0,,Әлі жоқ. Дәретханадағы конча.
Dialogue: 0,0:02:26.52,0:02:28.35,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:02:28.43,0:02:31.23,Default,,0,0,0,,Тамаша отбасына арналған сарай
Dialogue: 0,0:02:31.31,0:02:35.28,Default,,0,0,0,,Ұлы африкалық герцог Эллингтонның музыкасы
Dialogue: 0,0:02:35.36,0:02:37.86,Default,,0,0,0,,Ол осы үйде қайтыс болды.
Dialogue: 0,0:02:37.99,0:02:40.32,Default,,0,0,0,,Иә, мен қалдықтарды сезінемін.
Dialogue: 0,0:02:40.45,0:02:43.53,Default,,0,0,0,,Иә, мен дәретті жақсы көремін.
Dialogue: 0,0:02:43.62,0:02:47.08,Default,,0,0,0,,Және де осы әйел туралы.
Dialogue: 0,0:02:47.33,0:02:49.91,Default,,0,0,0,,Тамаша ас әзірлеу дағдылары
Dialogue: 0,0:02:50.00,0:02:53.08,Default,,0,0,0,,Анестезиясыз үш баланы дүниеге әкелді.
Dialogue: 0,0:02:53.17,0:02:54.71,Default,,0,0,0,,Ол бірқалыпты шықты.
Dialogue: 0,0:02:54.84,0:02:56.13,Default,,0,0,0,,Эндрю
Dialogue: 0,0:02:56.21,0:02:58.92,Default,,0,0,0,,Уайымдайтын ештеңе жоқ.
Dialogue: 0,0:02:59.01,0:03:00.63,Default,,0,0,0,,Мен өз бөлмеме бара жатырмын.
Dialogue: 0,0:03:00.72,0:03:02.80,Default,,0,0,0,,Сығылған соң
Dialogue: 0,0:03:02.89,0:03:03.80,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:03:04.05,0:03:05.35,Default,,0,0,0,,Мама
Dialogue: 0,0:03:05.93,0:03:07.43,Default,,0,0,0,,Мен оны жегім келеді
Dialogue: 0,0:03:07.52,0:03:08.98,Default,,0,0,0,,Менің досым қарап тұр
Dialogue: 0,0:03:09.06,0:03:11.23,Default,,0,0,0,,Майдың иісі бар
Dialogue: 0,0:03:11.39,0:03:12.48,Default,,0,0,0,,Бұл ауырады
Dialogue: 0,0:03:12.56,0:03:14.06,Default,,0,0,0,,Мен ішке кіргім келеді.
Dialogue: 0,0:03:14.15,0:03:15.69,Default,,0,0,0,,Мен қазір барамын
Dialogue: 0,0:03:15.82,0:03:18.99,Default,,0,0,0,,Мен де сені жақсы көремін, Ник Эндрю.
Dialogue: 0,0:03:19.61,0:03:20.57,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:03:20.70,0:03:23.87,Default,,0,0,0,,Менің баламның ең жақын досы - ең жақсысы
Dialogue: 0,0:03:24.32,0:03:25.99,Default,,0,0,0,,Бұрыштан
Dialogue: 0,0:03:26.12,0:03:30.33,Default,,0,0,0,,Жұма би кеші мен бармаймын
Dialogue: 0,0:03:30.41,0:03:31.50,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:31.62,0:03:34.75,Default,,0,0,0,,Мен қызды шақырып, қабылданбағым келмейді.
Dialogue: 0,0:03:34.88,0:03:37.38,Default,,0,0,0,,Топқа барыңыз
Dialogue: 0,0:03:37.50,0:03:41.13,Default,,0,0,0,,Джей би кешінде «Мен саусақтарыммен ситам» дейді
Dialogue: 0,0:03:41.26,0:03:41.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:42.05,0:03:43.18,Default,,0,0,0,,Саусақтармен камминг
Dialogue: 0,0:03:43.26,0:03:46.05,Default,,0,0,0,,Бұл ер адамдар қолданатын сөз емес.
Dialogue: 0,0:03:46.14,0:03:48.89,Default,,0,0,0,,Сіз мені қате естіген шығарсыз.
Dialogue: 0,0:03:48.97,0:03:51.39,Default,,0,0,0,,Джей әлі сүйген жоқ.
Dialogue: 0,0:03:51.48,0:03:53.73,Default,,0,0,0,,Тіліміз де бар.
Dialogue: 0,0:03:53.81,0:03:57.11,Default,,0,0,0,,Иә, сүйгенімізді айта алу үшін...
Dialogue: 0,0:03:57.19,0:03:59.11,Default,,0,0,0,,Тіліңді салмасаң
Dialogue: 0,0:03:59.19,0:04:01.15,Default,,0,0,0,,Оны жылжытыңыз
Dialogue: 0,0:04:01.24,0:04:03.86,Default,,0,0,0,,оны тілінің астына қойды
Dialogue: 0,0:04:03.95,0:04:06.28,Default,,0,0,0,,Аузыңызда еритін таблетка сияқты
Dialogue: 0,0:04:06.37,0:04:07.24,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:04:07.66,0:04:08.99,Default,,0,0,0,,Біз көп нәрсені білеміз.
Dialogue: 0,0:04:09.08,0:04:10.75,Default,,0,0,0,,Ер адамның әңгімесі
Dialogue: 0,0:04:15.88,0:04:16.83,Default,,0,0,0,,Бұл
Dialogue: 0,0:04:16.96,0:04:17.29,Default,,0,0,0,,``Бұл ауырады, бірақ жұмыс істейді''
Dialogue: 0,0:04:17.29,0:04:18.63,Default,,0,0,0,,``Бұл ауырады, бірақ жұмыс істейді''
Dialogue: 0,0:04:17.29,0:04:18.63,Default,,0,0,0,,Бірақ ол жұмыс істейді.
Dialogue: 0,0:04:22.80,0:04:23.42,Default,,0,0,0,,Не?
Dialogue: 0,0:04:23.55,0:04:24.18,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:04:24.30,0:04:25.51,Default,,0,0,0,,Эй, қарама.
Dialogue: 0,0:04:25.64,0:04:27.51,Default,,0,0,0,,(Хонда мен басқалары күледі)
Dialogue: 0,0:04:29.22,0:04:29.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:29.97,0:04:31.06,Default,,0,0,0,,Не?
Dialogue: 0,0:04:31.14,0:04:32.35,Default,,0,0,0,,Кешірім сұрама
Dialogue: 0,0:04:36.81,0:04:39.98,Default,,0,0,0,,Білесің бе, мен ештеңе көрмедім.
Dialogue: 0,0:04:40.19,0:04:42.94,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:04:43.28,0:04:45.03,Default,,0,0,0,,Иә, қайырлы түн
Dialogue: 0,0:04:49.45,0:04:52.37,Default,,0,0,0,,Сәлеметсіз бе, бұл Гормон-кун.
Dialogue: 0,0:04:52.75,0:04:54.50,Default,,0,0,0,,Күте тұрыңыз, капитан
Dialogue: 0,0:04:54.58,0:04:56.83,Default,,0,0,0,,Ник сонда
Dialogue: 0,0:04:56.96,0:05:00.13,Default,,0,0,0,,Мен досымның қасында олай істей алмаймын.
Dialogue: 0,0:05:00.21,0:05:01.30,Default,,0,0,0,,Қалайсыз, солай ма?
Dialogue: 0,0:05:01.42,0:05:04.38,Default,,0,0,0,,Дұрыс, маған не болды?
Dialogue: 0,0:05:04.47,0:05:08.26,Default,,0,0,0,,Жарайды, сен кәдімгі баласың.
Dialogue: 0,0:05:08.34,0:05:11.06,Default,,0,0,0,,Мысық сағатымен қызғаныш
Dialogue: 0,0:05:11.18,0:05:13.22,Default,,0,0,0,,Әженің сыйлығы
Dialogue: 0,0:05:13.31,0:05:15.06,Default,,0,0,0,,Жабайылар үшін
Dialogue: 0,0:05:15.14,0:05:16.85,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:05:17.81,0:05:19.40,Default,,0,0,0,,Бұл алаңдатады.
Dialogue: 0,0:05:19.52,0:05:23.48,Default,,0,0,0,,Жан-жағыма қарап тұрмын, кім сыққысы келеді?
Dialogue: 0,0:05:23.61,0:05:25.40,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:05:27.28,0:05:27.91,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:27.99,0:05:29.66,Default,,0,0,0,,Әлі де салқын
Dialogue: 0,0:05:29.74,0:05:32.33,Default,,0,0,0,,Әкемнің әріптесін еске түсіріңіз
Dialogue: 0,0:05:32.45,0:05:33.49,Default,,0,0,0,,Сюзан
Dialogue: 0,0:05:34.54,0:05:36.87,Default,,0,0,0,,Жазғы демалыста айтылған
Dialogue: 0,0:05:36.96,0:05:39.83,Default,,0,0,0,,Ерке болып бара жатқанын айтады.
Dialogue: 0,0:05:39.92,0:05:42.25,Default,,0,0,0,,Сол қолдар
Dialogue: 0,0:05:42.34,0:05:44.34,Default,,0,0,0,,Үстіңді шешіп, маған көрсет.
Dialogue: 0,0:05:44.59,0:05:45.34,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:45.42,0:05:46.80,Default,,0,0,0,,Жатыр түтіктері де бар.
Dialogue: 0,0:05:46.88,0:05:48.63,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:05:48.72,0:05:52.76,Default,,0,0,0,,Сюзан, қалыңыз қалай? Кадрлар бөлімінің жұмысы қандай?
Dialogue: 0,0:05:54.31,0:05:55.02,Default,,0,0,0,,шықты
Dialogue: 0,0:05:55.14,0:05:59.69,Default,,0,0,0,,Қайырлы түн ханзада, Нью-Йорк королі
Dialogue: 0,0:05:59.81,0:06:01.11,Default,,0,0,0,,Тазалау туралы не айтуға болады?
Dialogue: 0,0:06:01.23,0:06:03.11,Default,,0,0,0,,Тек ұйықта.
Dialogue: 0,0:06:08.61,0:06:11.16,Default,,0,0,0,,Джейдің үйінде баскетбол бар ма?
Dialogue: 0,0:06:11.24,0:06:12.91,Default,,0,0,0,,Жаман болып қалды
Dialogue: 0,0:06:13.49,0:06:15.29,Default,,0,0,0,,Үй шаруасына арналған
Dialogue: 0,0:06:17.83,0:06:19.87,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:06:19.96,0:06:21.83,Default,,0,0,0,,Дүйсенбі күні мектепте
Dialogue: 0,0:06:22.75,0:06:23.71,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:24.50,0:06:26.01,Default,,0,0,0,,Демалыс күндеріңіз жақсы өтсін
Dialogue: 0,0:06:26.09,0:06:27.01,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:28.13,0:06:29.09,Default,,0,0,0,,О
Dialogue: 0,0:06:29.43,0:06:32.51,Default,,0,0,0,,Сол жақтан түс, бұл тротуар.
Dialogue: 0,0:06:32.60,0:06:33.72,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:06:35.14,0:06:36.39,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:06:42.27,0:06:45.94,Default,,0,0,0,,Не болды? Мен жексенбіге дейін қалуым керек.
Dialogue: 0,0:06:46.03,0:06:48.19,Default,,0,0,0,,Бірақ... бұл ештеңе емес.
Dialogue: 0,0:06:48.32,0:06:48.99,Default,,0,0,0,,Ник
Dialogue: 0,0:06:49.07,0:06:52.91,Default,,0,0,0,,Сіз ата-анаңызбен кез келген нәрсе туралы сөйлесе аласыз.
Dialogue: 0,0:06:53.03,0:06:53.87,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:54.74,0:06:57.04,Default,,0,0,0,,Мен ол жігітті көрдім...
Dialogue: 0,0:06:57.45,0:06:58.79,Default,,0,0,0,,Пенис
Dialogue: 0,0:06:58.91,0:07:01.00,Default,,0,0,0,,Сіз гейсіз бе деп алаңдайсыз ба?
Dialogue: 0,0:07:01.08,0:07:05.59,Default,,0,0,0,,Менің досымның жыныс мүшесіне қол тигізу немесе оны жеңіл сүйу.
Dialogue: 0,0:07:05.67,0:07:08.71,Default,,0,0,0,,Бұл сіздің гей екеніңізді білдірмейді.
Dialogue: 0,0:07:08.80,0:07:11.26,Default,,0,0,0,,Студент кезінде әкем де сонда болған.
Dialogue: 0,0:07:11.38,0:07:13.22,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:07:13.34,0:07:15.26,Default,,0,0,0,,Гей болған дұрыс
Dialogue: 0,0:07:15.35,0:07:16.06,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:07:16.18,0:07:18.89,Default,,0,0,0,,Эндрю жақсы жігіт.
Dialogue: 0,0:07:18.98,0:07:20.85,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:07:21.23,0:07:26.90,Default,,0,0,0,,Эндрюдің жыныс мүшесі менікінен үлкенірек және түкті.
Dialogue: 0,0:07:26.98,0:07:29.90,Default,,0,0,0,,Сіз есейе бастадыңыз.
Dialogue: 0,0:07:30.07,0:07:32.66,Default,,0,0,0,,Оларды екіншілік жыныстық белгілер деп атайды.
Dialogue: 0,0:07:32.78,0:07:35.49,Default,,0,0,0,,Қас қарайды, емізік ұшады.
Dialogue: 0,0:07:35.58,0:07:36.83,Default,,0,0,0,,Емізікшелер.
Dialogue: 0,0:07:36.91,0:07:40.62,Default,,0,0,0,,Жыныс мүшесі де ересек адамдікіне өзгереді.
Dialogue: 0,0:07:41.29,0:07:45.17,Default,,0,0,0,,Сенің әкеңдей кішкентай болса да.
Dialogue: 0,0:07:45.25,0:07:50.63,Default,,0,0,0,,Егер сіз әйелдің денесін және бәрінен бұрын оның ақыл-ойын түсінсеңіз.
Dialogue: 0,0:07:50.72,0:07:52.18,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:07:52.26,0:07:56.97,Default,,0,0,0,,Рас, анамның бұрынғы жігіті үлкен сиқы болған.
Dialogue: 0,0:07:57.05,0:07:59.43,Default,,0,0,0,,Шынымды айтсам, қиын болды.
Dialogue: 0,0:07:59.52,0:08:00.31,Default,,0,0,0,,Жетеді
Dialogue: 0,0:08:00.39,0:08:02.39,Default,,0,0,0,,Әкемдікі тамаша
Dialogue: 0,0:08:02.48,0:08:04.35,Default,,0,0,0,,Бұл тағдыр.
Dialogue: 0,0:08:04.48,0:08:05.94,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:06.02,0:08:09.86,Default,,0,0,0,,Бұл туралы Эндрюдің ата-анасы да айтады.
Dialogue: 0,0:08:10.90,0:08:11.94,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:08:12.36,0:08:15.20,Default,,0,0,0,,Содан кейін оны толығымен төмен түсіріңіз.
Dialogue: 0,0:08:15.32,0:08:18.20,Default,,0,0,0,,Бұл соңғы банан.
Dialogue: 0,0:08:18.28,0:08:20.41,Default,,0,0,0,,Мұғалім маған айтты
Dialogue: 0,0:08:20.50,0:08:22.71,Default,,0,0,0,,Сіз маған кез келген нәрсені айта аласыз
Dialogue: 0,0:08:22.87,0:08:25.63,Default,,0,0,0,,Эндрю, сұрақтарыңыз болса.
Dialogue: 0,0:08:25.71,0:08:27.21,Default,,0,0,0,,Үніңді жап, ұмыт.
Dialogue: 0,0:08:27.29,0:08:28.84,Default,,0,0,0,,Маған банан беріңіз
Dialogue: 0,0:08:28.92,0:08:31.01,Default,,0,0,0,,Дәмі резеңке сияқты
Dialogue: 0,0:08:31.09,0:08:32.88,Default,,0,0,0,,Эротикалық бала
Dialogue: 0,0:08:33.01,0:08:34.43,Default,,0,0,0,,«Жұма күні би»
Dialogue: 0,0:08:39.06,0:08:39.81,Default,,0,0,0,,Сәлем
Dialogue: 0,0:08:39.89,0:08:40.77,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:08:40.85,0:08:41.89,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:08:42.64,0:08:44.56,Default,,0,0,0,,Сәлем балалар
Dialogue: 0,0:08:44.69,0:08:48.31,Default,,0,0,0,,Мен бимен айналысамын.
Dialogue: 0,0:08:48.44,0:08:51.98,Default,,0,0,0,,Мен де саған қамқоршы болып барамын.
Dialogue: 0,0:08:52.07,0:08:55.28,Default,,0,0,0,,Жақсы, мен ұсындым және жасадым.
Dialogue: 0,0:08:55.36,0:09:00.33,Default,,0,0,0,,Тыңдаңыз, биді қазір ұмытып, баскетболға көңіл бөліңіз.
Dialogue: 0,0:09:00.45,0:09:03.16,Default,,0,0,0,,Бұл ән ойналады ма?
Dialogue: 0,0:09:03.29,0:09:05.87,Default,,0,0,0,,Жұма күні Никске қарсы
Dialogue: 0,0:09:05.96,0:09:08.42,Default,,0,0,0,,Порзингис керемет
Dialogue: 0,0:09:08.54,0:09:10.88,Default,,0,0,0,,Бойы ұзын, түсіруде жақсы
Dialogue: 0,0:09:11.25,0:09:12.67,Default,,0,0,0,,Қорғаныс ше?
Dialogue: 0,0:09:12.76,0:09:14.63,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:09:15.22,0:09:17.01,Default,,0,0,0,,Бұл командалық тапсырма.
Dialogue: 0,0:09:17.13,0:09:18.80,Default,,0,0,0,,Жынды болу
Dialogue: 0,0:09:18.89,0:09:21.35,Default,,0,0,0,,Үлкен сиқырлар
Dialogue: 0,0:09:22.18,0:09:25.23,Default,,0,0,0,,Пениске арналған баскетбол ату!
Dialogue: 0,0:09:25.89,0:09:29.11,Default,,0,0,0,,Дик паста дриблинг жабайы болады
Dialogue: 0,0:09:29.23,0:09:31.48,Default,,0,0,0,,Маған тиіспе.
Dialogue: 0,0:09:32.78,0:09:34.28,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:36.70,0:09:39.32,Default,,0,0,0,,Екеуің де жетеді.
Dialogue: 0,0:09:39.41,0:09:41.28,Default,,0,0,0,,Сіз таңғажайып нәрсені көргіңіз келе ме?
Dialogue: 0,0:09:43.33,0:09:45.45,Default,,0,0,0,,Бұл тіпті менің шарларымда да резонанс тудырды.
Dialogue: 0,0:09:45.54,0:09:46.96,Default,,0,0,0,,Би билеуге бола ма?
Dialogue: 0,0:09:48.87,0:09:51.17,Default,,0,0,0,,Ник біртүрлі
Dialogue: 0,0:09:51.25,0:09:52.80,Default,,0,0,0,,Баланы жалғыз қалдырыңыз
Dialogue: 0,0:09:52.88,0:09:55.34,Default,,0,0,0,,Фильмдерден эротикалық көріністерді көру
Dialogue: 0,0:09:55.42,0:09:57.93,Default,,0,0,0,,Ол мастурбация жасап жатқанын көрді ме?
Dialogue: 0,0:09:58.01,0:09:59.51,Default,,0,0,0,,Басталған сәт
Dialogue: 0,0:09:59.59,0:10:03.81,Default,,0,0,0,,Мен сенің ересек екеніңді қызғанамын.
Dialogue: 0,0:10:03.89,0:10:05.14,Default,,0,0,0,,Оны өшіріңіз
Dialogue: 0,0:10:05.22,0:10:08.31,Default,,0,0,0,,Қараңдаршы, жаяу жүргіншілер жолының жиегін аузыммен ұстайын.
Dialogue: 0,0:10:08.39,0:10:10.69,Default,,0,0,0,,Бастың артқы бөлігін кесіңіз
Dialogue: 0,0:10:10.77,0:10:11.48,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:10:11.56,0:10:13.94,Default,,0,0,0,,Мен оны жеймін
Dialogue: 0,0:10:14.03,0:10:17.28,Default,,0,0,0,,Мынау екі қызды сиқытатын көрініс
Dialogue: 0,0:10:17.36,0:10:19.24,Default,,0,0,0,,ЖҚТБ туралы ұмытыңыз.
Dialogue: 0,0:10:20.49,0:10:21.37,Default,,0,0,0,,Эндрю
Dialogue: 0,0:10:21.95,0:10:23.33,Default,,0,0,0,,СПИД-тен қорқады
Dialogue: 0,0:10:24.91,0:10:27.58,Default,,0,0,0,,Герцог Эллингтон
Dialogue: 0,0:10:27.71,0:10:29.83,Default,,0,0,0,,Эй, герцогтың елесі
Dialogue: 0,0:10:29.96,0:10:32.46,Default,,0,0,0,,Сәлем, Ник
Dialogue: 0,0:10:33.21,0:10:34.75,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:10:34.88,0:10:37.42,Default,,0,0,0,,Сөйлесетін адам жоқ
Dialogue: 0,0:10:37.55,0:10:40.93,Default,,0,0,0,,Тірі адам түсіне алмайтын нәрселер бар.
Dialogue: 0,0:10:41.01,0:10:44.14,Default,,0,0,0,,Мен елес болғаныма қуанамын
Dialogue: 0,0:10:44.81,0:10:45.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:46.02,0:10:50.39,Default,,0,0,0,,Менің ең жақын досымның жыныс мүшесі менікінен үлкенірек және түкті.
Dialogue: 0,0:10:51.40,0:10:54.57,Default,,0,0,0,,Білесіз бе, бұл 1938 жыл еді.
Dialogue: 0,0:10:54.65,0:10:58.99,Default,,0,0,0,,Чарли Паркерді көргеннен кейін сенім жоғалды
Dialogue: 0,0:10:59.07,0:11:01.57,Default,,0,0,0,,«Құстан» күткендей
Dialogue: 0,0:11:01.70,0:11:02.57,Default,,0,0,0,,Қай жағынан?
Dialogue: 0,0:11:02.70,0:11:04.66,Default,,0,0,0,,Жүні қауырсынға ұқсайды.
Dialogue: 0,0:11:06.04,0:11:06.66,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:11:06.74,0:11:10.37,Default,,0,0,0,,Мен қайтып оралдым да, актриса Евамен ұйықтадым.
Dialogue: 0,0:11:10.46,0:11:11.67,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:11:12.96,0:11:17.25,Default,,0,0,0,,Әй, баяғыда мен ақ әйелді ұстадым.
Dialogue: 0,0:11:17.38,0:11:18.17,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:11:18.26,0:11:23.01,Default,,0,0,0,,Әдемі әйелдерге зат ретінде қарасаңыз, сенім артады деген сөз.
Dialogue: 0,0:11:23.09,0:11:26.14,Default,,0,0,0,,Мектептегі ең сұлу қызды шақыр?
Dialogue: 0,0:11:26.22,0:11:29.02,Default,,0,0,0,,Иә, біз үшбұрыш аймағын басып жатырмыз.
Dialogue: 0,0:11:29.10,0:11:30.48,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:11:31.52,0:11:33.44,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:11:33.52,0:11:35.82,Default,,0,0,0,,Арзан жеткізуші
Dialogue: 0,0:11:35.90,0:11:37.02,Default,,0,0,0,,Бір ән орындаймыз ба?
Dialogue: 0,0:11:37.11,0:11:38.23,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:11:40.40,0:11:43.74,Default,,0,0,0,,Үшбұрыш аймағындағы шөпке
Dialogue: 0,0:11:43.86,0:11:45.41,Default,,0,0,0,,Бар, балақай
Dialogue: 0,0:11:47.70,0:11:50.08,Default,,0,0,0,,Эй, бұл би туралы.
Dialogue: 0,0:11:50.20,0:11:53.62,Default,,0,0,0,,«Ежелгі Месопотамия түні» деп аталады.
Dialogue: 0,0:11:53.71,0:11:56.00,Default,,0,0,0,,Тарихты оқу үшін де жақсы.
Dialogue: 0,0:11:56.09,0:11:58.09,Default,,0,0,0,,Мисси Сиқырлы амалдарға араласу
Dialogue: 0,0:11:58.17,0:12:02.13,Default,,0,0,0,,Мен сиқырлы амалдарды жақсы көремін. Бұл аудиториямен ауыр бәсеке.
Dialogue: 0,0:12:02.22,0:12:04.97,Default,,0,0,0,,Бұл көңілді деңгей
Dialogue: 0,0:12:05.09,0:12:06.64,Default,,0,0,0,,Жарайды, үндеме.
Dialogue: 0,0:12:06.72,0:12:10.64,Default,,0,0,0,,Эй, аузыңда бірдеңе бар деп ойлаймын.
Dialogue: 0,0:12:13.39,0:12:14.90,Default,,0,0,0,,Бұл сіздің картаңыз ба?
Dialogue: 0,0:12:14.98,0:12:19.19,Default,,0,0,0,,Жарайды, Джей, сен оны қолыңа тығып алғансың.
Dialogue: 0,0:12:19.28,0:12:19.94,Default,,0,0,0,,Оны айтпа
Dialogue: 0,0:12:20.03,0:12:24.78,Default,,0,0,0,,Спойлерлерге алаңдамаңыз, бәрібір мені қызықтырмайды.
Dialogue: 0,0:12:24.91,0:12:26.57,Default,,0,0,0,,Ең нашар тұтынушы.
Dialogue: 0,0:12:26.66,0:12:29.03,Default,,0,0,0,,Ашуланса ақсақ
Dialogue: 0,0:12:29.12,0:12:31.95,Default,,0,0,0,,Үшбұрыш аймағындағы шөпке...
Dialogue: 0,0:12:33.50,0:12:34.33,Default,,0,0,0,,Кеттік
Dialogue: 0,0:12:35.29,0:12:37.00,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:12:37.13,0:12:40.09,Default,,0,0,0,,Ол жоғары сынып оқушыларымен сөйлесуге дайын.
Dialogue: 0,0:12:40.21,0:12:43.30,Default,,0,0,0,,Бұл керемет батылдық.
Dialogue: 0,0:12:43.38,0:12:45.51,Default,,0,0,0,,Кішкентай болса да
Dialogue: 0,0:12:46.05,0:12:50.01,Default,,0,0,0,,Бұзық әйелдің олжасысың, түкіріп кетесің.
Dialogue: 0,0:12:50.10,0:12:51.97,Default,,0,0,0,,Қызықты бала
Dialogue: 0,0:12:52.06,0:12:52.89,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:12:58.06,0:13:00.77,Default,,0,0,0,,Бұзбау Бұзба
Dialogue: 0,0:13:00.86,0:13:03.32,Default,,0,0,0,,Сіз мұны керемет түрде жасай аласыз
Dialogue: 0,0:13:03.57,0:13:05.49,Default,,0,0,0,,Жатыр түтіктері арқылы өтеді...
Dialogue: 0,0:13:05.57,0:13:07.24,Default,,0,0,0,,Мен ішке кіргім келеді.
Dialogue: 0,0:13:07.32,0:13:09.49,Default,,0,0,0,,Жыныс мүшесін жеңіл сүю
Dialogue: 0,0:13:09.58,0:13:11.74,Default,,0,0,0,,Бұл менің шарларымда да резонанс тудырды.
Dialogue: 0,0:13:13.08,0:13:14.33,Default,,0,0,0,,Оливия
Dialogue: 0,0:13:14.41,0:13:17.83,Default,,0,0,0,,Қарсы болмасаң, менімен билеуге барғың келе ме?
Dialogue: 0,0:13:17.96,0:13:20.46,Default,,0,0,0,,Сізбен? Бұл сүйкімді
Dialogue: 0,0:13:20.54,0:13:22.67,Default,,0,0,0,,Иә? Жақсы
Dialogue: 0,0:13:22.76,0:13:24.55,Default,,0,0,0,,Иә, сүйкімді
Dialogue: 0,0:13:24.63,0:13:27.05,Default,,0,0,0,,Иә, сүйкімді.
Dialogue: 0,0:13:27.13,0:13:28.84,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:13:30.22,0:13:31.10,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:13:32.43,0:13:34.93,Default,,0,0,0,,Топпен бару керек.
Dialogue: 0,0:13:35.02,0:13:38.19,Default,,0,0,0,,Уәдеден шығу ең жаман нәрсе.
Dialogue: 0,0:13:38.60,0:13:39.48,Default,,0,0,0,,Оны кінәлаңыз
Dialogue: 0,0:13:39.56,0:13:42.36,Default,,0,0,0,,Сіз Оливияны шақырдыңыз ба?
Dialogue: 0,0:13:42.48,0:13:43.73,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:43.86,0:13:45.07,Default,,0,0,0,,Біз ше?
Dialogue: 0,0:13:45.15,0:13:48.74,Default,,0,0,0,,Мен нақты уәде берген жоқпын.
Dialogue: 0,0:13:48.86,0:13:52.03,Default,,0,0,0,,Ашулан, бұны.
Dialogue: 0,0:13:52.16,0:13:53.24,Default,,0,0,0,,Бок же
Dialogue: 0,0:13:53.33,0:13:55.50,Default,,0,0,0,,Аздап ашулы
Dialogue: 0,0:13:55.62,0:13:57.58,Default,,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 0,0:13:57.71,0:13:59.58,Default,,0,0,0,,Міне.
Dialogue: 0,0:13:59.71,0:14:03.67,Default,,0,0,0,,Менімен араласпа, мен сенің қызың да емеспін.
Dialogue: 0,0:14:03.80,0:14:06.26,Default,,0,0,0,,Мен ашуландым. Тротуар табыңыз.
Dialogue: 0,0:14:06.34,0:14:09.01,Default,,0,0,0,,Барлық тістеріңізді сындырыңыз
Dialogue: 0,0:14:09.09,0:14:10.51,Default,,0,0,0,,Білсін
Dialogue: 0,0:14:13.18,0:14:15.81,Default,,0,0,0,,Бұл ұрыс! Назар аударыңыз!
Dialogue: 0,0:14:15.89,0:14:17.31,Default,,0,0,0,,Бұл ұрыс.
Dialogue: 0,0:14:17.43,0:14:20.15,Default,,0,0,0,,Scoop дуэті бөлініп кетті
Dialogue: 0,0:14:21.40,0:14:24.28,Default,,0,0,0,,Сен... мені сипа.
Dialogue: 0,0:14:29.74,0:14:31.66,Default,,0,0,0,,Карта кептеліп қалды
Dialogue: 0,0:14:32.74,0:14:34.45,Default,,0,0,0,,Бұл сіздің картаңыз ба?
Dialogue: 0,0:14:34.54,0:14:35.91,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:14:37.83,0:14:42.29,Default,,0,0,0,,Ник Эндрюге ыңғайсыз болып көрінеді.
Dialogue: 0,0:14:42.42,0:14:46.38,Default,,0,0,0,,Мен орта мектепте оқып жүргенімде ол бұршақтай болатын.
Dialogue: 0,0:14:46.46,0:14:50.01,Default,,0,0,0,,Менің досым Дондікі - Франкфурт
Dialogue: 0,0:14:50.09,0:14:53.14,Default,,0,0,0,,Оның жүні де үлпілдек еді.
Dialogue: 0,0:14:53.22,0:14:55.10,Default,,0,0,0,,Бұл көруге болатын нәрсе болды.
Dialogue: 0,0:14:55.22,0:14:58.73,Default,,0,0,0,,Дон алаяқтық операция жасап, қашып кетті ме?
Dialogue: 0,0:14:58.81,0:15:01.35,Default,,0,0,0,,Ережелер саңылауларға толы.
Dialogue: 0,0:15:01.44,0:15:05.23,Default,,0,0,0,,Эллиотт, сен ақылды және кереметсің.
Dialogue: 0,0:15:06.11,0:15:07.19,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:15:09.61,0:15:12.87,Default,,0,0,0,,Ғажайып 12 сағат 1 минут
Dialogue: 0,0:15:13.20,0:15:14.20,Default,,0,0,0,,керемет
Dialogue: 0,0:15:14.28,0:15:19.33,Default,,0,0,0,,Менің ұлдарым бұл деңгейге өз бетімен жетуі керек.
Dialogue: 0,0:15:23.96,0:15:25.79,Default,,0,0,0,,Сәлем Ник
Dialogue: 0,0:15:26.17,0:15:26.92,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:27.00,0:15:29.76,Default,,0,0,0,,Не болды? Танысу туралы алаңдайсыз ба?
Dialogue: 0,0:15:29.92,0:15:34.60,Default,,0,0,0,,Эндрю маған кеше қоштасуды айтты.
Dialogue: 0,0:15:35.51,0:15:39.85,Default,,0,0,0,,Мен де саксофон шыбықтарымен төбелестім.
Dialogue: 0,0:15:39.93,0:15:40.85,Default,,0,0,0,,Жылтыр болыңыз.
Dialogue: 0,0:15:40.98,0:15:42.52,Default,,0,0,0,,Татуласу туралы не деуге болады?
Dialogue: 0,0:15:42.60,0:15:47.69,Default,,0,0,0,,Кешірім күту кезінде героиннен қайтыс болды.
Dialogue: 0,0:15:47.78,0:15:49.23,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:15:49.32,0:15:52.15,Default,,0,0,0,,Себебі мен кешірім сұрай алмадым.
Dialogue: 0,0:15:54.66,0:15:56.41,Default,,0,0,0,,«Ежелгі Месопотамия түні»
Dialogue: 0,0:15:57.95,0:15:59.20,Default,,0,0,0,,Сәлем Мисси
Dialogue: 0,0:15:59.83,0:16:02.92,Default,,0,0,0,,Бүгін түнде маған Нанче қоңырау шалыңыз.
Dialogue: 0,0:16:03.00,0:16:05.42,Default,,0,0,0,,Әділет құдайы
Dialogue: 0,0:16:05.50,0:16:06.42,Default,,0,0,0,,Ал балық
Dialogue: 0,0:16:06.54,0:16:10.30,Default,,0,0,0,,Сіз де кіру жарнасын көне стильдегі күміспен төлейсіз бе?
Dialogue: 0,0:16:11.63,0:16:15.97,Default,,0,0,0,,Қола дәуірінің ортасында күміс кен орындары өркендеді.
Dialogue: 0,0:16:16.05,0:16:17.97,Default,,0,0,0,,Күлкілі әзілдер
Dialogue: 0,0:16:18.06,0:16:18.72,Default,,0,0,0,,Ник ше?
Dialogue: 0,0:16:18.85,0:16:21.35,Default,,0,0,0,,Жүр, мен жалғыз келдім.
Dialogue: 0,0:16:21.43,0:16:24.69,Default,,0,0,0,,Уақыттың өзі қымбат.
Dialogue: 0,0:16:24.77,0:16:28.77,Default,,0,0,0,,Ол сізді өмір шындығымен бетпе-бет келуге үйретеді.
Dialogue: 0,0:16:28.86,0:16:30.03,Default,,0,0,0,,Бұл іске араласпа.
Dialogue: 0,0:16:30.15,0:16:33.61,Default,,0,0,0,,Осыдан кейін сусын ішуге барамыз ба?
Dialogue: 0,0:16:33.70,0:16:36.07,Default,,0,0,0,,Әлде бірдеңе жейсің бе?
Dialogue: 0,0:16:36.16,0:16:37.87,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:16:37.95,0:16:40.54,Default,,0,0,0,,Үйде тестке баға қою
Dialogue: 0,0:16:41.37,0:16:44.00,Default,,0,0,0,,Мұғалімдермен жақсы араласпаймын.
Dialogue: 0,0:16:44.08,0:16:45.25,Default,,0,0,0,,Өте ауыр
Dialogue: 0,0:16:45.33,0:16:46.92,Default,,0,0,0,,Шарлар жоқ
Dialogue: 0,0:16:47.00,0:16:50.05,Default,,0,0,0,,Бұл сәл артық.
Dialogue: 0,0:16:50.13,0:16:52.63,Default,,0,0,0,,Мен негізінен келісемін.
Dialogue: 0,0:16:52.76,0:16:54.59,Default,,0,0,0,,Көңілді отырсың ба?
Dialogue: 0,0:16:54.84,0:16:56.76,Default,,0,0,0,,Бүгін түн шынымен...
Dialogue: 0,0:16:56.84,0:16:57.64,Default,,0,0,0,,Күн ыстық
Dialogue: 0,0:16:57.72,0:16:58.47,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:16:58.55,0:17:01.52,Default,,0,0,0,,Шашым жанып тұр, жынды жігіт
Dialogue: 0,0:17:01.60,0:17:03.23,Default,,0,0,0,,Мен Матомамын
Dialogue: 0,0:17:03.31,0:17:04.18,Default,,0,0,0,,Жасайық
Dialogue: 0,0:17:04.27,0:17:06.44,Default,,0,0,0,,Қараңызшы, бұл Мабудачи.
Dialogue: 0,0:17:07.35,0:17:09.23,Default,,0,0,0,,Енді жоқ
Dialogue: 0,0:17:09.31,0:17:12.94,Default,,0,0,0,,Олай болса мен жынды боламын.
Dialogue: 0,0:17:13.03,0:17:14.40,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:17:14.49,0:17:17.87,Default,,0,0,0,,Мен саған мысық қоқыс жәшігіне нәжіс тастауға енді рұқсат бермеймін.
Dialogue: 0,0:17:21.70,0:17:22.66,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:17:22.75,0:17:23.62,Default,,0,0,0,,Енді жұмысқа аттанатын уақыт келді ғой?
Dialogue: 0,0:17:23.70,0:17:25.00,Default,,0,0,0,,Күні
Dialogue: 0,0:17:25.08,0:17:29.29,Default,,0,0,0,,Менің жолдасым мектептегі ең сұлу қыз. Мен күте алмаймын.
Dialogue: 0,0:17:29.38,0:17:33.13,Default,,0,0,0,,Сізге интеллектуалды әңгіме ұнайтын сияқты.
Dialogue: 0,0:17:33.21,0:17:34.42,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:17:34.51,0:17:37.09,Default,,0,0,0,,Эндрю оны көрмеді.
Dialogue: 0,0:17:37.18,0:17:40.97,Default,,0,0,0,,Бұл кездесу, Сұлу әйелдің көзі қорқынышты.
Dialogue: 0,0:17:41.06,0:17:43.89,Default,,0,0,0,,Сізбен сөйлесу қызық болды.
Dialogue: 0,0:17:43.97,0:17:47.73,Default,,0,0,0,,Ыстық жоғарғы сынып оқушысының кездесуі келді.
Dialogue: 0,0:17:47.85,0:17:48.90,Default,,0,0,0,,ұқсайды
Dialogue: 0,0:17:51.02,0:17:52.86,Default,,0,0,0,,Ол жақсы әйел.
Dialogue: 0,0:17:52.94,0:17:56.03,Default,,0,0,0,,Еске түсіре отырып, жастықта ұйықтайық
Dialogue: 0,0:17:56.70,0:17:59.07,Default,,0,0,0,,Оливия, бірдеңе ішкің келе ме?
Dialogue: 0,0:17:59.16,0:18:03.16,Default,,0,0,0,,Менде газдалған су бар. Бұл кокос иісі бар ...
Dialogue: 0,0:18:03.24,0:18:05.29,Default,,0,0,0,,Кешіріңіз, бірақ менің жігітім
Dialogue: 0,0:18:05.41,0:18:08.96,Default,,0,0,0,,Бірақ сен бүгін кешке менімен кездесуге барасың.
Dialogue: 0,0:18:09.08,0:18:12.21,Default,,0,0,0,,･･
Dialogue: 0,0:18:12.29,0:18:14.05,Default,,0,0,0,,Мен балаларды ұнатпаймын.
Dialogue: 0,0:18:14.13,0:18:16.76,Default,,0,0,0,,Ер адам үздік оқушы болуы керек.
Dialogue: 0,0:18:17.17,0:18:20.39,Default,,0,0,0,,Төменгі сынып оқушыларының арасында да үлкендер бар.
Dialogue: 0,0:18:20.51,0:18:25.18,Default,,0,0,0,,Мен байғұс үшін қатты ұяламын.
Dialogue: 0,0:18:25.31,0:18:29.94,Default,,0,0,0,,Эй, қарсы болмасаң, күзгі күн мен түннің теңелу мерекесін өткізгің келе ме?
Dialogue: 0,0:18:30.02,0:18:33.07,Default,,0,0,0,,Сонымен... менімен бірге билеңіз.
Dialogue: 0,0:18:33.15,0:18:34.40,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:18:34.48,0:18:37.07,Default,,0,0,0,,Эй, сен жындысың ба?
Dialogue: 0,0:18:37.15,0:18:38.36,Default,,0,0,0,,Әйелді шақыру
Dialogue: 0,0:18:38.45,0:18:40.11,Default,,0,0,0,,Бірақ бұл Мисси.
Dialogue: 0,0:18:40.20,0:18:43.20,Default,,0,0,0,,Әйел, мен сенімен билегім келеді
Dialogue: 0,0:18:43.33,0:18:44.74,Default,,0,0,0,,Бірақ Ник
Dialogue: 0,0:18:44.83,0:18:48.54,Default,,0,0,0,,Кішкентай жігітті ұмытып, нағыз әйелмен билеңіз.
Dialogue: 0,0:18:48.66,0:18:49.83,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:49.92,0:18:52.50,Default,,0,0,0,,Керемет, мен дайынмын.
Dialogue: 0,0:18:52.58,0:18:55.05,Default,,0,0,0,,Мен әкеммен бірге жаттығамын.
Dialogue: 0,0:18:56.92,0:18:58.80,Default,,0,0,0,,Менің өтінішім бар
Dialogue: 0,0:18:58.88,0:18:59.72,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:18:59.80,0:19:00.72,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:00.80,0:19:02.59,Default,,0,0,0,,Мен оны қолдансам, ол жоғалады ма?
Dialogue: 0,0:19:02.68,0:19:06.18,Default,,0,0,0,,Әй, қалғым келсе, мен қаламын.
Dialogue: 0,0:19:06.35,0:19:08.85,Default,,0,0,0,,Интернетті пайдаланасыз ба?
Dialogue: 0,0:19:08.93,0:19:12.73,Default,,0,0,0,,Маған құпия сөзді айтқан жоқ.
Dialogue: 0,0:19:17.61,0:19:20.61,Default,,0,0,0,,"Күтілгендей" дегенді естігім келмейді
Dialogue: 0,0:19:20.70,0:19:23.28,Default,,0,0,0,,Бірақ мен оны шынымен айтқым келеді.
Dialogue: 0,0:19:23.37,0:19:25.70,Default,,0,0,0,,Құлағыңызды жауып тастай аласыз ба?
Dialogue: 0,0:19:26.54,0:19:28.00,Default,,0,0,0,,Ал… біз Карт Титанмен біріктік ➡
Dialogue: 0,0:19:28.45,0:19:29.62,Default,,0,0,0,,Өзіңізді сергек сезінесіз бе?
Dialogue: 0,0:19:29.71,0:19:32.62,Default,,0,0,0,,Ол тазарақ болды.
Dialogue: 0,0:19:32.71,0:19:33.92,Default,,0,0,0,,Егер сіз тыңдап отырсаңыз
Dialogue: 0,0:19:34.38,0:19:40.13,Default,,0,0,0,,Қызыл көйлек киген ханым
Dialogue: 0,0:19:40.84,0:19:44.51,Default,,0,0,0,,Менімен билеу
Dialogue: 0,0:19:44.60,0:19:45.93,Default,,0,0,0,,Бетіңізді біріктіріңіз
Dialogue: 0,0:19:47.31,0:19:50.35,Default,,0,0,0,,Бірінші рет баламен билеу
Dialogue: 0,0:19:50.43,0:19:52.35,Default,,0,0,0,,Бірақ сіз мұны жақсы білесіз.
Dialogue: 0,0:19:52.44,0:19:54.10,Default,,0,0,0,,Жақсы сезінеді.
Dialogue: 0,0:19:54.65,0:19:56.98,Default,,0,0,0,,Иә, бұл жақсы сезінеді.
Dialogue: 0,0:19:57.15,0:20:00.03,Default,,0,0,0,,Костюміңізді киетін уақыт келді.
Dialogue: 0,0:20:00.40,0:20:05.03,Default,,0,0,0,,Мен ақыры түсіндім
Dialogue: 0,0:20:06.16,0:20:10.04,Default,,0,0,0,,Сен әдемісің
Dialogue: 0,0:20:10.95,0:20:12.96,Default,,0,0,0,,Мен енді ұмытпаймын
Dialogue: 0,0:20:13.04,0:20:14.58,Default,,0,0,0,,Өйткені сен ақылдысың
Dialogue: 0,0:20:15.25,0:20:20.26,Default,,0,0,0,,Бүгін түнде сіз туралы
Dialogue: 0,0:20:20.67,0:20:23.05,Default,,0,0,0,,Мен оған ұнайды деп ойладым.
Dialogue: 0,0:20:23.13,0:20:24.97,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:20:25.05,0:20:26.93,Default,,0,0,0,,Мен ақымақпын
Dialogue: 0,0:20:27.01,0:20:29.89,Default,,0,0,0,,Мынау ақымақ, сен...
Dialogue: 0,0:20:30.18,0:20:33.10,Default,,0,0,0,,Бұл кішкентай, бірақ сүйкімді
Dialogue: 0,0:20:33.31,0:20:36.52,Default,,0,0,0,,Ергежейлі қуыршаққа ұқсайды
Dialogue: 0,0:20:36.69,0:20:37.48,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:37.77,0:20:39.61,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:40.86,0:20:43.32,Default,,0,0,0,,А-ли
Dialogue: 0,0:20:43.40,0:20:45.66,Default,,0,0,0,,Тіл астына қойыңыз
Dialogue: 0,0:20:45.74,0:20:47.16,Default,,0,0,0,,Гю
Dialogue: 0,0:20:47.24,0:20:50.12,Default,,0,0,0,,Құпия сөз туралы кеңес
Dialogue: 0,0:20:58.09,0:20:59.17,Default,,0,0,0,,Тіл
Dialogue: 0,0:21:03.01,0:21:05.97,Default,,0,0,0,,Ніл бойындағы барлық базар саудагерлері
Dialogue: 0,0:21:06.05,0:21:09.76,Default,,0,0,0,,Батыл болыңыз және жамбасыңызбен баяу шеңбер сызыңыз.
Dialogue: 0,0:21:10.97,0:21:11.89,Default,,0,0,0,,Бұл тым қауіпті. Соған қарамастан, шкафта жасырынғаным дұрыс
Dialogue: 0,0:21:13.02,0:21:16.90,Default,,0,0,0,,Күте тұрыңыз, әжетхана алыс, ұстаңыз.
Dialogue: 0,0:21:16.98,0:21:18.40,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:21:18.48,0:21:20.11,Default,,0,0,0,,Содан кейін оны алыңыз.
Dialogue: 0,0:21:20.19,0:21:21.28,Default,,0,0,0,,Оны шығарып көрейік
Dialogue: 0,0:21:23.53,0:21:25.49,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:21:26.66,0:21:27.91,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:21:29.28,0:21:29.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:30.03,0:21:32.45,Default,,0,0,0,,Әлі билеп жатыр... қазірдің өзінде
Dialogue: 0,0:21:35.16,0:21:37.17,Default,,0,0,0,,Сіздің аузыңыз үлкен.
Dialogue: 0,0:21:37.62,0:21:39.08,Default,,0,0,0,,Сіз мені мақтайсыз ба?
Dialogue: 0,0:21:39.17,0:21:40.96,Default,,0,0,0,,Тіл мені таң қалдырды.
Dialogue: 0,0:21:41.04,0:21:42.92,Default,,0,0,0,,Бұл біртүрлі көрінеді.
Dialogue: 0,0:21:43.01,0:21:44.88,Default,,0,0,0,,О, тәңірім
Dialogue: 0,0:21:44.97,0:21:46.47,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:21:47.68,0:21:50.72,Default,,0,0,0,,Аа, көп нәрсе шықты.
Dialogue: 0,0:21:52.22,0:21:53.47,Default,,0,0,0,,Ұялы телефон
Dialogue: 0,0:21:53.89,0:21:54.81,Default,,0,0,0,,Әй...
Dialogue: 0,0:21:58.56,0:22:00.06,Default,,0,0,0,,Көңілді
Dialogue: 0,0:22:00.15,0:22:03.65,Default,,0,0,0,,Жұмыртқаны тез тап. Бұл жатыр түтігі ме?
Dialogue: 0,0:22:03.73,0:22:05.61,Default,,0,0,0,,Әйелдің ішінде, солай ма?
Dialogue: 0,0:22:06.70,0:22:08.70,Default,,0,0,0,,Мұны айту қиын, бірақ...
Dialogue: 0,0:22:08.78,0:22:09.95,Default,,0,0,0,,Тағы да шұлық?
Dialogue: 0,0:22:10.03,0:22:11.78,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:22:12.08,0:22:12.95,Default,,0,0,0,,Бұл дәретхана ыдысы.
Dialogue: 0,0:22:13.04,0:22:15.79,Default,,0,0,0,,Сіз не істеп жатырсыз? Сен тым жындысың.
Dialogue: 0,0:22:15.87,0:22:17.21,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:22:17.29,0:22:20.67,Default,,0,0,0,,Би билеп жүргенде қышыдым.
Dialogue: 0,0:22:20.75,0:22:22.92,Default,,0,0,0,,Маймыл жігіт, бұл ұялы телефон.
Dialogue: 0,0:22:23.00,0:22:23.71,Default,,0,0,0,,Жақсы
Dialogue: 0,0:22:23.80,0:22:24.84,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:22:24.92,0:22:27.51,Default,,0,0,0,,Сол қоңыр жартасқа жүзейік
Dialogue: 0,0:22:27.59,0:22:30.80,Default,,0,0,0,,Мен гей емеспін, бірақ Кинтаманы сағындым.
Dialogue: 0,0:22:31.89,0:22:35.02,Default,,0,0,0,,Эндрюді тексеріңіз.
Dialogue: 0,0:22:35.10,0:22:37.10,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:22:37.18,0:22:39.39,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:22:39.48,0:22:40.60,Default,,0,0,0,,Та-да!
Dialogue: 0,0:22:41.73,0:22:42.86,Default,,0,0,0,,Олай болса, жас ханым.
Dialogue: 0,0:22:42.94,0:22:44.36,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:45.57,0:22:46.69,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:22:51.32,0:22:52.37,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:22:52.49,0:22:53.87,Default,,0,0,0,,Оны шалбарыңызға салыңыз
Dialogue: 0,0:22:53.99,0:22:55.99,Default,,0,0,0,,Сонда сіз дымқылсыз ба?
Dialogue: 0,0:22:56.08,0:22:57.62,Default,,0,0,0,,Жаман болма
Dialogue: 0,0:22:57.70,0:22:58.62,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:22:58.75,0:23:01.96,Default,,0,0,0,,Мен не істедім?
Dialogue: 0,0:23:02.08,0:23:04.29,Default,,0,0,0,,Бұл сенің кінәң емес, бірақ...
Dialogue: 0,0:23:04.42,0:23:05.92,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,0:23:06.80,0:23:09.34,Default,,0,0,0,,Үлкен, шашы бар жігіт
Dialogue: 0,0:23:09.42,0:23:10.22,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:23:10.34,0:23:13.76,Default,,0,0,0,,Менікі олай болмауы мүмкін.
Dialogue: 0,0:23:13.89,0:23:16.89,Default,,0,0,0,,Менікі де жақсы емес.
Dialogue: 0,0:23:16.97,0:23:21.27,Default,,0,0,0,,Мен оны біреудің шалбарында шығарғаныма сенбеймін.
Dialogue: 0,0:23:21.35,0:23:22.69,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:23:22.81,0:23:24.52,Default,,0,0,0,,Мен де
Dialogue: 0,0:23:24.65,0:23:27.44,Default,,0,0,0,,Бұл ұятқа толы.
Dialogue: 0,0:23:27.53,0:23:29.15,Default,,0,0,0,,Шалбар унитазға айналады
Dialogue: 0,0:23:29.24,0:23:32.61,Default,,0,0,0,,Неліктен оны раковинаға жумадың?
Dialogue: 0,0:23:32.70,0:23:35.12,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:23:35.20,0:23:38.62,Default,,0,0,0,,Мен үрейлендім, не істеуім керек?
Dialogue: 0,0:23:42.37,0:23:43.96,Default,,0,0,0,,«Шығу»
Dialogue: 0,0:23:49.92,0:23:52.34,Default,,0,0,0,,Комбинация бір ғана шалбармен оралды
Dialogue: 0,0:23:52.43,0:23:54.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:23:54.89,0:23:57.85,Default,,0,0,0,,Бүгінгі кешкі тамаша кеште... ``Не болды?''
Dialogue: 0,0:23:57.93,0:24:01.39,Default,,0,0,0,,Оның үстіне сен Джессиді сүйдің бе?
Dialogue: 0,0:24:01.48,0:24:06.65,Default,,0,0,0,,Жеке өмірімізді құрметтеуіңізді қалаймын.
Dialogue: 0,0:24:06.73,0:24:08.36,Default,,0,0,0,,Сіз мұны істеп жатырсыз
Dialogue: 0,0:24:08.44,0:24:12.74,Default,,0,0,0,,Ертең біз баскетбол жаттықтырушысы Боро отбасынан хабар таратамыз.
Dialogue: 0,0:24:12.82,0:24:16.41,Default,,0,0,0,,Мен әуежайға жақын қоймада тұрамын.
Dialogue: 0,0:24:21.37,0:24:23.00,Default,,0,0,0,,Сәлем, сәлем.
Dialogue: 0,0:24:23.08,0:24:23.75,Default,,0,0,0,,Кім?
Dialogue: 0,0:24:23.83,0:24:24.88,Default,,0,0,0,,Жарайды, осы барлық жанама дәлелдер үйіліп жатқанда, менде оны мойындаудан басқа амал қалмады деп ойлаймын.
Dialogue: 0,0:24:24.96,0:24:27.88,Default,,0,0,0,,Мен бұл жігітке дымқыл түс көрсін деп келдім.
Dialogue: 0,0:24:31.55,0:24:32.97,Default,,0,0,0,,Жасөспірім пері?
Dialogue: 0,0:24:33.09,0:24:34.68,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:24:34.80,0:24:36.05,Default,,0,0,0,,Ертегі
Dialogue: 0,0:24:36.18,0:24:40.27,Default,,0,0,0,,Бұл Гормон-кун, мені гомо деп атама.
Dialogue: 0,0:24:40.35,0:24:43.77,Default,,0,0,0,,Мен еркектерді мазақтағанды ​​ұнатамын.
Dialogue: 0,0:25:33.32,0:25:35.32,Default,,0,0,0,,Жапон субтитрлері Нагиса Исозаки
Dialogue: 0,0:25:36.82,0:25:42.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
