Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:31.17,0:01:31.85,*Default,NTP,0000,0000,0000,,Бұл қалай өтті?
Dialogue: 0,0:01:32.30,0:01:35.14,*Default,NTP,0000,0000,0000,,Вице-капитан Мацумото, ауытқулар жоқ.
Dialogue: 0,0:01:35.57,0:01:37.83,*Default,NTP,0000,0000,0000,,Бұл маңызды жұмыс, бұрыштарды кеспеңіз.
Dialogue: 0,0:01:39.31,0:01:41.97,*Default,NTP,0000,0000,0000,,Бірақ патша мөрі дегеніміз не?
Dialogue: 0,0:01:43.01,0:01:46.03,*Default,NTP,0000,0000,0000,,Қауіпсіздікке тапсырыс берсем де, мен ерекшелене алмаймын...
Dialogue: 0,0:01:47.19,0:01:49.12,*Default,NTP,0000,0000,0000,,Билік пе, әлде бір нәрсе ме, білмеймін.
Dialogue: 0,0:01:50.49,0:01:52.38,*Default,NTP,0000,0000,0000,,Корольдік отбасына қатысты құпия қазына.
Dialogue: 0,0:01:54.38,0:01:58.58,*Default,NTP,0000,0000,0000,,Корольдік отбасынан басқа ешкімге оның бар екенін көруге тыйым салынды.
Dialogue: 0,0:01:59.02,0:02:00.72,*Default,NTP,0000,0000,0000,,Ешқашан ашылмайтын қазына
Dialogue: 0,0:02:01.80,0:02:04.99,*Default,NTP,0000,0000,0000,,Бізде оны қалай пайдалану керектігін немесе оның қабілеттерін білуге ешқандай мүмкіндік жоқ.
Dialogue: 0,0:02:06.02,0:02:10.15,*Default,NTP,0000,0000,0000,,Сақтау орындарын бірнеше онжылдықтар сайын өзгерту.
Dialogue: 0,0:02:10.64,0:02:13.96,*Default,NTP,0000,0000,0000,,Өзгеріс күші - патша мөрі
Dialogue: 0,0:02:15.99,0:02:16.94,*Default,NTP,0000,0000,0000,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:02:17.29,0:02:19.44,*Default,NTP,0000,0000,0000,,Сондықтан мен де егжей-тегжейлі білмеймін.
Dialogue: 0,0:02:20.70,0:02:24.29,*Default,NTP,0000,0000,0000,,Қалай болғанда да, бұл біздің 10-бөлімге арналған миссиямыз.
Dialogue: 0,0:02:25.47,0:02:27.06,*Default,NTP,0000,0000,0000,,Қауіпсіздікке жол бермеңіз және оны қадағалаңыз
Dialogue: 0,0:02:34.13,0:02:34.53,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:02:35.13,0:02:35.86,*Default,NTP,0000,0000,0000,,Мацумото?
Dialogue: 0,0:02:36.80,0:02:38.22,*Default,NTP,0000,0000,0000,,Әр бөлімде ауытқулар жоқ.
Dialogue: 0,0:02:40.87,0:02:43.05,*Default,NTP,0000,0000,0000,,Жақыннан көргенде бұдан да керемет.
Dialogue: 0,0:02:44.61,0:02:47.29,*Default,NTP,0000,0000,0000,,Өйткені билік безендіруді қажет етеді.
Dialogue: 0,0:02:47.76,0:02:49.23,*Default,NTP,0000,0000,0000,,Сонымен қатар капитанға...
Dialogue: 0,0:02:53.32,0:02:55.56,*Default,NTP,0000,0000,0000,,Осылай айтсаң, ашуланасың.
Dialogue: 0,0:02:59.45,0:03:00.90,*Default,NTP,0000,0000,0000,,Оның орнына сіз...
Dialogue: 0,0:03:01.35,0:03:01.85,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:03:07.09,0:03:07.56,*Default,NTP,0000,0000,0000,,Мацумото
Dialogue: 0,0:03:28.87,0:03:29.33,*Default,NTP,0000,0000,0000,,Вице-капитан
Dialogue: 0,0:03:29.51,0:03:29.94,*Default,NTP,0000,0000,0000,,Қоршау
Dialogue: 0,0:03:42.75,0:03:43.14,*Default,NTP,0000,0000,0000,,Өл
Dialogue: 0,0:03:44.07,0:03:45.27,*Default,NTP,0000,0000,0000,,Гроан Хайнеко
Dialogue: 0,0:04:06.87,0:04:07.73,*Default,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:04:12.57,0:04:12.89,*Default,NTP,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:04:36.67,0:04:38.63,*Default,NTP,0000,0000,0000,,Ол дәл қазір осында—
Dialogue: 0,0:04:47.44,0:04:47.98,*Default,NTP,0000,0000,0000,,Патша мөрі туралы не деуге болады?
Dialogue: 0,0:04:48.37,0:04:48.92,*Default,NTP,0000,0000,0000,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:04:51.18,0:04:51.63,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:04:53.70,0:04:55.47,*Default,NTP,0000,0000,0000,,Сондай ностальгиялық
Dialogue: 0,0:04:56.57,0:04:57.48,*Default,NTP,0000,0000,0000,,Бетіңізді көрсетіңіз
Dialogue: 0,0:04:59.46,0:04:59.88,*Default,NTP,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:05:00.51,0:05:01.03,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:05:11.65,0:05:12.12,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:05:14.50,0:05:15.11,*Default,NTP,0000,0000,0000,,Корольдік мөр
Dialogue: 0,0:05:15.99,0:05:16.86,*Default,NTP,0000,0000,0000,,Өрттің таралуын тоқтату
Dialogue: 0,0:05:17.63,0:05:19.71,*Default,NTP,0000,0000,0000,,Вице-капитан Мацумото, кешіріңіз.
Dialogue: 0,0:05:20.45,0:05:22.85,*Default,NTP,0000,0000,0000,,Көптеген адамдар жарақат алды.
Dialogue: 0,0:05:27.07,0:05:27.66,*Default,NTP,0000,0000,0000,,Вице-капитан?
Dialogue: 0,0:06:24.56,0:06:25.34,*Default,NTP,0000,0000,0000,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:06:27.89,0:06:28.77,*Default,NTP,0000,0000,0000,,...Такуйо
Dialogue: 0,0:06:30.05,0:06:32.63,*Default,NTP,0000,0000,0000,,Менің үйімнің қасында қиындық тудырма.
Dialogue: 0,0:06:49.83,0:06:51.51,*Default,NTP,0000,0000,0000,,Не... бұл не?
Dialogue: 0,0:06:54.25,0:06:54.95,*Default,NTP,0000,0000,0000,,Балалар
Dialogue: 0,0:06:56.26,0:06:57.10,*Default,NTP,0000,0000,0000,,Жасырын маневр
Dialogue: 0,0:07:03.82,0:07:07.44,*Default,NTP,0000,0000,0000,,Күте тұрыңыз! Мен Ичиго Куросакимін, өлім құдайының міндетін атқарушымын.
Dialogue: 0,0:07:11.04,0:07:11.50,*Default,NTP,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:07:17.23,0:07:19.97,*Default,NTP,0000,0000,0000,,Ичиго Куросаки, сен мұнда не істеп жүрсің?
Dialogue: 0,0:07:21.19,0:07:21.91,*Default,NTP,0000,0000,0000,,Сіз...
Dialogue: 0,0:07:27.00,0:07:31.16,*Default,NTP,0000,0000,0000,,Екінші дивизияның командирі және жасырын мобильді бас командир Сайхачи.
Dialogue: 0,0:07:32.62,0:07:35.94,*Default,NTP,0000,0000,0000,,Мен тосқауыл қоюым керек еді.
Dialogue: 0,0:07:38.91,0:07:39.58,*Default,NTP,0000,0000,0000,,Не болды
Dialogue: 0,0:07:41.18,0:07:42.13,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:07:57.26,0:08:01.50,*Default,NTP,0000,0000,0000,,Әдетте актерлік Шинигамиге айтудың еш себебі болмады.
Dialogue: 0,0:08:17.38,0:08:19.57,*Default,NTP,0000,0000,0000,,Осы сияқты кез келген нәрсе
Dialogue: 0,0:08:26.06,0:08:28.20,*Default,NTP,0000,0000,0000,,Егер сіз оны тапсаңыз, бізге дереу хабарлаңыз.
Dialogue: 0,0:08:29.67,0:08:30.27,*Default,NTP,0000,0000,0000,,Күтіңіз... күтіңіз.
Dialogue: 0,0:08:36.92,0:08:37.61,*Default,NTP,0000,0000,0000,,Куросаки
Dialogue: 0,0:08:39.19,0:08:41.19,*Default,NTP,0000,0000,0000,,Ишида, сен мұнда не үшін келдің?
Dialogue: 0,0:08:42.75,0:08:47.35,*Default,NTP,0000,0000,0000,,Менің байқағаным кешеден бері бұл аймаққа тосқауыл қойылған.
Dialogue: 0,0:08:48.36,0:08:50.54,*Default,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:08:53.99,0:08:54.55,*Default,NTP,0000,0000,0000,,Іс жүзінде...
Dialogue: 0,0:08:59.43,0:09:00.35,*Default,NTP,0000,0000,0000,,Жаңбыр жауды ма?
Dialogue: 0,0:09:01.17,0:09:03.94,*Default,NTP,0000,0000,0000,,Жоқ, менің ойымша, ол өзінің реиацусын өшіріп жатқан шығар.
Dialogue: 0,0:09:05.95,0:09:06.55,*Default,NTP,0000,0000,0000,,Рейацу?
Dialogue: 0,0:09:16.44,0:09:16.99,*Default,NTP,0000,0000,0000,,Тосиро! ?
Dialogue: 0,0:09:21.91,0:09:22.50,*Default,NTP,0000,0000,0000,,Тосиро!
Dialogue: 0,0:09:25.93,0:09:27.55,*Default,NTP,0000,0000,0000,,Шөп...?
Dialogue: 0,0:09:49.92,0:09:50.92,*Default,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:09:52.25,0:09:54.66,*Default,NTP,0000,0000,0000,,Біз айналаны мұқият зерттедік, бірақ
Dialogue: 0,0:09:55.33,0:09:57.68,*Default,NTP,0000,0000,0000,,Патша мөрінің ізі табылмады
Dialogue: 0,0:09:58.57,0:10:01.69,*Default,NTP,0000,0000,0000,,Шабуылшы алып кеткен сияқты.
Dialogue: 0,0:10:03.11,0:10:07.65,*Default,NTP,0000,0000,0000,,Сонымен қатар, нысананы қадағалағаны хабарланған эскорт отрядының жетекшісі
Dialogue: 0,0:10:08.26,0:10:10.25,*Default,NTP,0000,0000,0000,,Хицугая 10-дивизияның командирі...
Dialogue: 0,0:10:10.97,0:10:13.67,*Default,NTP,0000,0000,0000,,Оның өз реиатсуын жапқанының ізі де қалмады...
Dialogue: 0,0:10:13.58,0:10:14.41,*Default,NTP,0000,0000,0000,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:10:16.14,0:10:19.83,*Default,NTP,0000,0000,0000,,Капитан Хицугая өзінің міндеттерін тастап жатқанын көрсететін мәлімдемелер жасады...
Dialogue: 0,0:10:20.33,0:10:22.57,*Default,NTP,0000,0000,0000,,Неліктен олай істедің?
Dialogue: 0,0:10:23.54,0:10:25.52,*Default,NTP,0000,0000,0000,,Бұл заңның анық бұзылуы.
Dialogue: 0,0:10:26.05,0:10:27.64,*Default,NTP,0000,0000,0000,,Бірақ мен
Dialogue: 0,0:10:27.66,0:10:28.26,*Default,NTP,0000,0000,0000,,Тоқта
Dialogue: 0,0:10:29.59,0:10:33.08,*Default,NTP,0000,0000,0000,,10-отрядтың барлық мүшелеріне қамауға алу бұйырылды.
Dialogue: 0,0:10:33.77,0:10:37.06,*Default,NTP,0000,0000,0000,,Кейбір жағдайларда жоюға дайын болыңыз.
Dialogue: 0,0:10:38.01,0:10:38.87,*Default,NTP,0000,0000,0000,,Жою!
Dialogue: 0,0:10:39.67,0:10:43.09,*Default,NTP,0000,0000,0000,,Бұл 10-шы бөлімнің өзі талқандалады дегенді білдіре ме?
Dialogue: 0,0:10:43.93,0:10:45.55,*Default,NTP,0000,0000,0000,,Сарбаздардың кінәсі жоқ.
Dialogue: 0,0:10:45.82,0:10:48.66,*Default,NTP,0000,0000,0000,,Барлық жауапкершілік маған, вице-капитанға жүктеледі.
Dialogue: 0,0:10:49.17,0:10:51.45,*Default,NTP,0000,0000,0000,,Мацумото аузыңды бақылаңыз
Dialogue: 0,0:10:53.76,0:10:59.05,*Default,NTP,0000,0000,0000,,Сіздің ойыңызша, лейтенанттың өмірі жауапкершілікті алуға жеткілікті ме?
Dialogue: 0,0:10:59.80,0:11:01.38,*Default,NTP,0000,0000,0000,,Саналы бол
Dialogue: 0,0:11:04.30,0:11:08.30,*Default,NTP,0000,0000,0000,,Алдымен патша мөрін тауып, сол уақытта жинап ал.
Dialogue: 0,0:11:08.74,0:11:12.57,*Default,NTP,0000,0000,0000,,Оқиғаға қатысқан басты адам деп есептелетін 10-дивизияның капитаны
Dialogue: 0,0:11:13.02,0:11:17.49,*Default,NTP,0000,0000,0000,,Тосиро Хицугаяның қамқорлығын қамтамасыз ету - басты міндет.
Dialogue: 0,0:11:18.18,0:11:21.43,*Default,NTP,0000,0000,0000,,Бұл төтенше жағдайдағы арнайы бұйрық
Dialogue: 0,0:11:28.17,0:11:31.01,*Default,NTP,0000,0000,0000,,Қазірден бастап, әзірге
Dialogue: 0,0:11:31.52,0:11:33.54,*Default,NTP,0000,0000,0000,,Казармадағы ұстамдылықты сұрау
Dialogue: 0,0:11:34.76,0:11:38.36,*Default,NTP,0000,0000,0000,,Сонымен қатар, Хицугая 10-шы отряд капитанының тұтқындалуы
Dialogue: 0,0:11:38.82,0:11:40.38,*Default,NTP,0000,0000,0000,,және істі шешкенге дейін.
Dialogue: 0,0:11:40.95,0:11:43.32,*Default,NTP,0000,0000,0000,,Себебі хабар берушінің болуы мүмкін
Dialogue: 0,0:11:43.74,0:11:45.77,*Default,NTP,0000,0000,0000,,Барлық Занпакуто тәркіленеді.
Dialogue: 0,0:11:46.03,0:11:47.46,*Default,NTP,0000,0000,0000,,Неліктен...?
Dialogue: 0,0:11:47.91,0:11:48.48,*Default,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:11:48.92,0:11:50.77,*Default,NTP,0000,0000,0000,,Сіз бізге күмәнданасыз ба?
Dialogue: 0,0:11:51.58,0:11:54.81,*Default,NTP,0000,0000,0000,,Іс шешілгенше осы жерде тыныш күте тұр дейсің бе?
Dialogue: 0,0:11:55.38,0:11:56.38,*Default,NTP,0000,0000,0000,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,0:11:57.49,0:11:58.26,*Default,NTP,0000,0000,0000,,Үстемдік
Dialogue: 0,0:11:59.18,0:12:01.82,*Default,NTP,0000,0000,0000,,Біздің кінәсіз екенімізді дәлелдеуге мүмкіндік беріңіз...
Dialogue: 0,0:12:02.56,0:12:04.02,*Default,NTP,0000,0000,0000,,Бұл қатаң тәртіп.
Dialogue: 0,0:12:04.94,0:12:05.51,*Default,NTP,0000,0000,0000,,Вице-капитан
Dialogue: 0,0:12:06.05,0:12:07.25,*Default,NTP,0000,0000,0000,,Вице-капитан Мацумото
Менің ойымша, бұл
Dialogue: 0,0:12:16.81,0:12:17.54,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:12:30.43,0:12:31.71,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:32.33,0:12:35.52,*Default,NTP,0000,0000,0000,,Сонда сіз әлі ештеңе білмейсіз бе?
Dialogue: 0,0:12:36.32,0:12:37.11,*Default,NTP,0000,0000,0000,,Және де
Dialogue: 0,0:12:38.23,0:12:41.85,*Default,NTP,0000,0000,0000,,Ұрланған патша мөрі соншалықты маңызды.
Dialogue: 0,0:12:42.53,0:12:45.76,*Default,NTP,0000,0000,0000,,Мен капитан Хицугаяның жақында оралатынына сенімдімін.
Dialogue: 0,0:12:47.55,0:12:49.88,*Default,NTP,0000,0000,0000,,Иә, мүлде
Dialogue: 0,0:12:50.11,0:12:52.89,*Default,NTP,0000,0000,0000,,Маған таң қалдым, неге бәрі бірдеңе айтпай жоғалып кетеді.
Dialogue: 0,0:12:54.10,0:12:56.88,*Default,NTP,0000,0000,0000,,Капитан Хицугая Ичимарудан өзгеше.
Dialogue: 0,0:12:59.78,0:13:00.43,*Default,NTP,0000,0000,0000,,Ренжи
Dialogue: 0,0:13:03.33,0:13:05.43,*Default,NTP,0000,0000,0000,,Занпакуто бойынша жұмысқа қабылдау аяқталды
Dialogue: 0,0:13:05.97,0:13:07.77,*Default,NTP,0000,0000,0000,,Енді жадқа көшіңіз
Dialogue: 0,0:13:09.45,0:13:12.16,*Default,NTP,0000,0000,0000,,Әрқайсыңыз қарапайым болып, оқиғаны күтіңіздер.
Dialogue: 0,0:13:13.16,0:13:14.97,*Default,NTP,0000,0000,0000,,Жақында казарманың қақпасы жабылады.
Dialogue: 0,0:13:15.59,0:13:17.81,*Default,NTP,0000,0000,0000,,Вице-капитан Мацумото, бөлмеңізге оралыңыз.
Dialogue: 0,0:13:18.55,0:13:20.20,*Default,NTP,0000,0000,0000,,Вице-капитан Абарай, уақыт келді.
Dialogue: 0,0:13:20.87,0:13:22.33,*Default,NTP,0000,0000,0000,,Жарайды, мен қазір барамын.
Dialogue: 0,0:13:23.12,0:13:23.49,*Default,NTP,0000,0000,0000,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,0:13:24.00,0:13:24.31,*Default,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,0:13:25.94,0:13:26.37,*Default,NTP,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:13:28.21,0:13:31.02,*Default,NTP,0000,0000,0000,,Мен бір нәрсені қарастырғаныңызды қалаймын.
Dialogue: 0,0:13:35.87,0:13:38.55,*Default,NTP,0000,0000,0000,,Бұл капитан қуып келе жатқан адам.
Dialogue: 0,0:13:39.64,0:13:41.95,*Default,NTP,0000,0000,0000,,Менің де капитанмен қарым-қатынасым бар деп ойлаймын.
Dialogue: 0,0:13:43.20,0:13:45.60,*Default,NTP,0000,0000,0000,,Әйтпесе капитан солай болар еді.
Dialogue: 0,0:13:57.60,0:14:01.38,*Default,NTP,0000,0000,0000,,Сіз данышпан бала екенсіз, Тосиро Хицугая деген қауесет бар.
Dialogue: 0,0:14:02.98,0:14:04.34,*Default,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:14:05.65,0:14:09.90,*Default,NTP,0000,0000,0000,,Мен өлім құдайына айналып, Жан қоғамы үшін өз өмірімді қатерге тігемін.
Dialogue: 0,0:14:11.67,0:14:12.54,*Default,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:14:13.30,0:14:13.91,*Default,NTP,0000,0000,0000,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:14:14.58,0:14:17.86,*Default,NTP,0000,0000,0000,,Бұл керемет Тосиро, сен данышпансың.
Dialogue: 0,0:14:18.02,0:14:19.06,*Default,NTP,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:14:19.36,0:14:21.60,*Default,NTP,0000,0000,0000,,Бірақ келесі жолы мен жеңілмеймін
Dialogue: 0,0:14:26.07,0:14:29.86,*Default,NTP,0000,0000,0000,,Тосиро, біз әрқашан доспыз.
Dialogue: 0,0:14:43.47,0:14:44.17,*Default,NTP,0000,0000,0000,,Бұл қайда?
Dialogue: 0,0:14:48.99,0:14:50.95,*Default,NTP,0000,0000,0000,,Куросаки осында
Dialogue: 0,0:14:51.54,0:14:52.23,*Default,NTP,0000,0000,0000,,Бұл менмін
Dialogue: 0,0:14:52.91,0:14:54.66,*Default,NTP,0000,0000,0000,,Мен сенің мұнда не істеп жүргеніңді білмеймін.
Dialogue: 0,0:14:55.23,0:14:57.26,*Default,NTP,0000,0000,0000,,Мен оны жай қалдыра алмаймын.
Dialogue: 0,0:14:57.87,0:15:00.64,*Default,NTP,0000,0000,0000,,Түсіндім, жіберіп алған жоқпын.
Dialogue: 0,0:15:01.99,0:15:04.48,*Default,NTP,0000,0000,0000,,Жасырын операция сізді іздеді.
Dialogue: 0,0:15:06.92,0:15:09.08,*Default,NTP,0000,0000,0000,,Аа, бәрі осы.
Dialogue: 0,0:15:10.36,0:15:11.79,*Default,NTP,0000,0000,0000,,Әй, сен неге тығылып тұрсың?
Dialogue: 0,0:15:14.62,0:15:15.84,*Default,NTP,0000,0000,0000,,Бірдеңе айт
Dialogue: 0,0:15:17.76,0:15:19.38,*Default,NTP,0000,0000,0000,,Оның сізге қатысы жоқ.
Dialogue: 0,0:15:19.76,0:15:21.36,*Default,NTP,0000,0000,0000,,Келіңіздер.
Dialogue: 0,0:15:25.29,0:15:26.70,*Default,NTP,0000,0000,0000,,Жақсы.
Dialogue: 0,0:15:27.66,0:15:28.46,*Default,NTP,0000,0000,0000,,Қайтарыңыз
Dialogue: 0,0:15:29.96,0:15:32.92,*Default,NTP,0000,0000,0000,,Ұрланғаны – патша қазынасы, патша мөрі.
Dialogue: 0,0:15:34.11,0:15:37.56,*Default,NTP,0000,0000,0000,,Бұл сіз сияқты Шинигами агенті қатыса алмайтын нәрсе емес.
Dialogue: 0,0:15:43.94,0:15:45.07,*Default,NTP,0000,0000,0000,,Шынымен
Dialogue: 0,0:15:45.41,0:15:47.69,*Default,NTP,0000,0000,0000,,Сен сондай бейшара бейшарасың.
Dialogue: 0,0:15:50.12,0:15:50.65,*Default,NTP,0000,0000,0000,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:15:51.40,0:15:52.39,*Default,NTP,0000,0000,0000,,Үлкен мәселе емес.
Dialogue: 0,0:15:53.19,0:15:55.23,*Default,NTP,0000,0000,0000,,Кешіріңіз, маған тағы біраз ұйықтауға рұқсат етіңіз.
Dialogue: 0,0:15:59.92,0:16:00.75,*Default,NTP,0000,0000,0000,,Мүлдем
Dialogue: 0,0:16:01.15,0:16:04.45,*Default,NTP,0000,0000,0000,,Мен Инуэге ертең таңертең қоңырау шаламын, сондықтан оған дейін үндемеңіз.
Dialogue: 0,0:16:05.33,0:16:05.60,*Default,NTP,0000,0000,0000,,Таку
Dialogue: 0,0:16:46.15,0:16:47.52,*Default,NTP,0000,0000,0000,,Айналаңа жасырынып жүрме
Dialogue: 0,0:16:48.43,0:16:52.05,*Default,NTP,0000,0000,0000,,Кеткен кезде абыроймен істеу керек.
Dialogue: 0,0:16:52.43,0:16:55.55,*Default,NTP,0000,0000,0000,,Неліктен ұят нәрсе істеп жатқандай әрекет етесің?
Dialogue: 0,0:16:57.70,0:17:00.04,*Default,NTP,0000,0000,0000,,Көмегің үшін рахмет
Dialogue: 0,0:17:02.96,0:17:05.72,*Default,NTP,0000,0000,0000,,Әй, сен неге жалғыз бармақшысың?
Dialogue: 0,0:17:08.38,0:17:10.26,*Default,NTP,0000,0000,0000,,Не туралы көп ойланып отырсың?
Dialogue: 0,0:17:12.11,0:17:12.96,*Default,NTP,0000,0000,0000,,850 жылы адамзат алғаш рет Титаннан өз жерін қайтарып алды
Dialogue: 0,0:17:13.96,0:17:15.71,*Default,NTP,0000,0000,0000,,Оның Құсақаға қатысы бар ма?
Dialogue: 0,0:17:17.79,0:17:18.25,*Default,NTP,0000,0000,0000,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:17:21.06,0:17:23.94,*Default,NTP,0000,0000,0000,,Саған шабуыл жасап, патша мөріңді ұрлаған адам
Dialogue: 0,0:17:24.44,0:17:25.63,*Default,NTP,0000,0000,0000,,Кусака дегеніміз не?
Dialogue: 0,0:17:26.97,0:17:28.64,*Default,NTP,0000,0000,0000,,Бұл өлтірілген адамның аты.
Dialogue: 0,0:17:30.96,0:17:33.18,*Default,NTP,0000,0000,0000,,Өлтірілді ме? кімге?
Dialogue: 0,0:17:34.74,0:17:35.49,*Default,NTP,0000,0000,0000,,Тосиро
Dialogue: 0,0:17:40.91,0:17:41.94,*Default,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:17:42.48,0:17:43.61,*Default,NTP,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:17:44.99,0:17:49.16,*Default,NTP,0000,0000,0000,,Бұл өте тітіркендіргіш. Мені көз алдымда ұрып жатыр. Мен оны қалай жалғыз қалдырамын?
Dialogue: 0,0:17:58.20,0:18:01.32,*Default,NTP,0000,0000,0000,,Жасырын операцияға хабарласуым керек пе, әлде үйге қайтуым керек пе?
Dialogue: 0,0:18:01.60,0:18:02.49,*Default,NTP,0000,0000,0000,,Біреуін таңдаңыз
Dialogue: 0,0:18:12.80,0:18:13.28,*Default,NTP,0000,0000,0000,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:18:24.79,0:18:27.82,*Default,NTP,0000,0000,0000,,Маған Тосиро Хицугаяны беріңізші.
Dialogue: 0,0:18:29.99,0:18:30.70,*Default,NTP,0000,0000,0000,,Не болса да
Dialogue: 0,0:18:31.88,0:18:35.42,*Default,NTP,0000,0000,0000,,Егер бұл кедергі болса, оны алып тастаңыз
Dialogue: 0,0:18:37.63,0:18:37.85,*Default,NTP,0000,0000,0000,,На
Dialogue: 0,0:18:39.26,0:18:41.86,*Default,NTP,0000,0000,0000,,Тосиро, сіз нені айтып тұрсыз?
Dialogue: 0,0:18:51.67,0:18:52.18,*Default,NTP,0000,0000,0000,,Тосиро
Dialogue: 0,0:18:55.09,0:18:55.52,*Default,NTP,0000,0000,0000,,Бұл өте қорқынышты.
Dialogue: 0,0:19:36.59,0:19:37.56,*Default,NTP,0000,0000,0000,,Сонда бұл
Dialogue: 0,0:19:37.84,0:19:38.37,*Default,NTP,0000,0000,0000,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:19:53.05,0:19:56.06,*Default,NTP,0000,0000,0000,,Гецуга Теншо
Dialogue: 0,0:20:08.58,0:20:10.24,*Default,NTP,0000,0000,0000,,Сол шабуылға тойтарыс беру нені білдіреді?
Dialogue: 0,0:20:11.03,0:20:13.04,*Default,NTP,0000,0000,0000,,Бұл адам кім?
Dialogue: 0,0:20:24.63,0:20:25.06,*Default,NTP,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:20:25.50,0:20:26.11,*Default,NTP,0000,0000,0000,,Тосиро
Dialogue: 0,0:20:34.07,0:20:36.01,*Default,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:20:45.03,0:20:47.89,*Default,NTP,0000,0000,0000,,Мықты бол, Ичиго, Ичиго.
Dialogue: 0,0:20:48.52,0:20:50.17,*Default,NTP,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:20:50.78,0:20:52.75,*Default,NTP,0000,0000,0000,,Мен сізге айқайлаймын.
Dialogue: 0,0:20:56.08,0:20:58.51,*Default,NTP,0000,0000,0000,,Оян, қарғыс атқыр Ичиго.
Dialogue: 0,0:20:57.24,0:20:58.05,*Default,NTP,0000,0000,0000,,Сәлем Ренжи
Dialogue: 0,0:20:59.23,0:21:00.62,*Default,NTP,0000,0000,0000,,Ауырады
Dialogue: 0,0:21:02.16,0:21:05.61,*Default,NTP,0000,0000,0000,,Қараңызшы, бұл жылдамырақ. Мені оят.
Dialogue: 0,0:21:05.86,0:21:08.65,*Default,NTP,0000,0000,0000,,Құдай-ау, кенет не істедің?
Dialogue: 0,0:21:09.36,0:21:11.97,*Default,NTP,0000,0000,0000,,Уолли – мәңгілік ессіз қалатын.
Dialogue: 0,0:21:12.45,0:21:13.27,*Default,NTP,0000,0000,0000,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:21:14.92,0:21:16.33,*Default,NTP,0000,0000,0000,,Ичиго, не болды?
Dialogue: 0,0:21:22.45,0:21:23.46,*Default,NTP,0000,0000,0000,,Қарғыс атсын
Dialogue: 0,0:21:25.52,0:21:28.13,*Default,NTP,0000,0000,0000,,Мен қанша уақыт ес-түссіз болдым?
Dialogue: 0,0:21:29.08,0:21:30.87,*Default,NTP,0000,0000,0000,,Тосиро қайда орналасқан?
Dialogue: 0,0:21:31.49,0:21:32.43,*Default,NTP,0000,0000,0000,,Тосиро деген кім?
Dialogue: 0,0:21:32.85,0:21:35.29,*Default,NTP,0000,0000,0000,,Сіз капитан Хицугаямен кездестіңіз бе?
Dialogue: 0,0:21:35.62,0:21:37.03,*Default,NTP,0000,0000,0000,,Қашан және қайда болдың?
Dialogue: 0,0:21:38.46,0:21:39.25,*Default,NTP,0000,0000,0000,,Балалар
Dialogue: 0,0:21:49.02,0:21:51.45,*Default,NTP,0000,0000,0000,,Капитан Хицугаяның хаориі.
Dialogue: 0,0:21:52.58,0:21:53.18,*Default,NTP,0000,0000,0000,,Сол жігіт
Dialogue: 0,0:21:54.20,0:21:56.72,*Default,NTP,0000,0000,0000,,Ичиго, неге мені тоқтатпадың?
Dialogue: 0,0:21:57.60,0:22:00.20,*Default,NTP,0000,0000,0000,,Мен оны тоқтаттым, бірақ ол кетіп қалды.
Dialogue: 0,0:22:00.81,0:22:03.48,*Default,NTP,0000,0000,0000,,Түсінбейтін әйелді қуу.
Dialogue: 0,0:22:04.04,0:22:04.65,*Default,NTP,0000,0000,0000,,қуыршақтай киімінен мүлде алшақ еді—
Dialogue: 0,0:22:05.87,0:22:08.33,*Default,NTP,0000,0000,0000,,Бетперде киген әскер мен сынық жүз сияқты көрінді, бірақ
Dialogue: 0,0:22:09.17,0:22:10.13,*Default,NTP,0000,0000,0000,,Мен шынымен түсінбеймін
Dialogue: 0,0:22:10.62,0:22:12.93,*Default,NTP,0000,0000,0000,,Сонымен капитан Хицугая не деді?
Dialogue: 0,0:22:14.29,0:22:15.60,*Default,NTP,0000,0000,0000,,Сіз ештеңе айтқан жоқсыз ба?
Dialogue: 0,0:22:16.13,0:22:18.59,*Default,NTP,0000,0000,0000,,Жоқ, мен патша мөрін қайтарып аламын.
Dialogue: 0,0:22:19.83,0:22:21.39,*Default,NTP,0000,0000,0000,,Бірақ бұл бәрі емес.
Dialogue: 0,0:22:22.27,0:22:24.36,*Default,NTP,0000,0000,0000,,Менің ойымша... бұл дұрыс.
Dialogue: 0,0:22:25.17,0:22:26.35,*Default,NTP,0000,0000,0000,,Құсақа деген кім?
Dialogue: 0,0:22:27.23,0:22:27.94,*Default,NTP,0000,0000,0000,,Кусака
Dialogue: 0,0:22:28.85,0:22:31.27,*Default,NTP,0000,0000,0000,,Ол өлтірілген адамның аты екенін айтты.
Dialogue: 0,0:22:32.27,0:22:33.46,*Default,NTP,0000,0000,0000,,Сол кездегі жігіт
Dialogue: 0,0:22:39.00,0:22:41.76,*Default,NTP,0000,0000,0000,,Ренжи бір рет жан қоғамына оралды
Dialogue: 0,0:22:41.97,0:22:43.85,*Default,NTP,0000,0000,0000,,Сіз мына төбеге қарап бере аласыз ба?
Dialogue: 0,0:22:44.68,0:22:47.60,*Default,NTP,0000,0000,0000,,Капитанның орынбасары Мацумото шабуылшы екенін айтты
Dialogue: 0,0:22:47.76,0:22:49.54,*Default,NTP,0000,0000,0000,,Бәлкім, мұның бір қатысы бар шығар.
Dialogue: 0,0:22:50.27,0:22:52.04,*Default,NTP,0000,0000,0000,,Жарайды, бірақ мен неге?
Dialogue: 0,0:22:52.48,0:22:56.51,*Default,NTP,0000,0000,0000,,Мен вице-капитан Мацумотомен сұхбаттаса алмаймын деп ойлаймын.
Dialogue: 0,0:22:57.67,0:22:58.17,*Default,NTP,0000,0000,0000,,Және
Dialogue: 0,0:23:02.25,0:23:03.80,*Default,NTP,0000,0000,0000,,Қандай жиіркенішті рөл.
Dialogue: 0,0:23:07.48,0:23:09.21,*Default,NTP,0000,0000,0000,,Бізге екі Шинигами керек емес
Dialogue: 0,0:23:09.23,0:23:10.35,*Default,NTP,0000,0000,0000,,Шешу керек
Dialogue: 0,0:23:10.59,0:23:11.95,*Default,NTP,0000,0000,0000,,Таңдау керек
Dialogue: 0,0:23:12.25,0:23:13.98,*Default,NTP,0000,0000,0000,,Жалғыз Шинигамиге
Dialogue: 0,0:23:14.00,0:23:15.80,*Default,NTP,0000,0000,0000,,Заңды иесі
Dialogue: 0,0:23:16.11,0:23:18.65,*Default,NTP,0000,0000,0000,,Ондай жағдайда мен Хёринмаруды лақтырып жіберемін.
Dialogue: 0,0:23:19.61,0:23:21.06,*Default,NTP,0000,0000,0000,,Бағынбау
Dialogue: 0,0:23:21.63,0:23:22.93,*Default,NTP,0000,0000,0000,,Күмәнданба
Dialogue: 0,0:23:23.32,0:23:27.48,*Default,NTP,0000,0000,0000,,Біздің орталық 46-шы үйдің шешімі абсолютті.
Dialogue: 0,0:23:27.99,0:23:31.65,*Default,NTP,0000,0000,0000,,Тоқта, шөп тәж, шөп тәж маған қымбат...
Dialogue: 0,0:24:03.83,0:24:05.68,*Default,NTP,0000,0000,0000,,Хицугая қалай болды?
Dialogue: 0,0:24:06.14,0:24:07.27,*Default,NTP,0000,0000,0000,,шынымен де
Dialogue: 0,0:24:07.52,0:24:10.32,*Default,NTP,0000,0000,0000,,Готей 13 корпусымен байланыс жоқ сияқты.
Dialogue: 0,0:24:10.76,0:24:13.39,*Default,NTP,0000,0000,0000,,Олар мені ұстап алғанша мені сонда апара аласыз ба?
Dialogue: 0,0:24:14.02,0:24:16.65,*Default,NTP,0000,0000,0000,,Жоқ, күтейік, көрейік.
Dialogue: 0,0:24:17.38,0:24:20.28,*Default,NTP,0000,0000,0000,,Оның құдіреті менімен бірдей болғанша
Dialogue: 0,0:24:20.57,0:24:22.38,*Default,NTP,0000,0000,0000,,Менің орным енді бұл жерде емес.
Dialogue: 0,0:24:22.89,0:24:25.00,*Default,NTP,0000,0000,0000,,Оның маған бағынудан басқа амалы жоқ.
Dialogue: 0,0:24:29.76,0:24:32.81,*Default,NTP,0000,0000,0000,,Капитан Хицугая Мао рухани академиясына келді.
Dialogue: 0,0:24:33.69,0:24:37.17,*Default,NTP,0000,0000,0000,,Мен бұл туралы көп білмеймін, өйткені мені Кучики отбасы қабылдады.
Dialogue: 0,0:24:38.04,0:24:41.43,*Default,NTP,0000,0000,0000,,Біз бір Рюконгай аймағынан болсақ та, мен «Инуцуриде» болдым.
Dialogue: 0,0:24:41.78,0:24:43.75,*Default,NTP,0000,0000,0000,,Капитан Хицугая – «Джунлин Ясу»
Dialogue: 0,0:24:46.24,0:24:49.82,*Default,NTP,0000,0000,0000,,5-ші дивизияның вице-капитан Хинамори екеуіңіз ағайындай өскендеріңізді естідім.
Dialogue: 0,0:24:50.22,0:24:53.36,*Default,NTP,0000,0000,0000,,Сонда Хинамори деген адамнан сұрасаң,
Dialogue: 0,0:24:55.62,0:24:58.31,*Default,NTP,0000,0000,0000,,Өкінішке орай, вице-капитан қазір емделіп жатыр.
Dialogue: 0,0:24:59.40,0:25:02.10,*Default,NTP,0000,0000,0000,,Менің болжамым - капитан Хицугая
Dialogue: 0,0:25:02.37,0:25:05.76,*Default,NTP,0000,0000,0000,,Менің ойымша, ол вице-капитан Хинамориге маңызды ештеңе айтқан жоқ.
Dialogue: 0,0:25:07.43,0:25:09.39,*Default,NTP,0000,0000,0000,,Әсіресе ауырса.
Dialogue: 0,0:25:13.69,0:25:15.70,*Default,NTP,0000,0000,0000,,Мен өзімді сондай адам сияқты сезінемін.
Dialogue: 0,0:25:17.85,0:25:19.21,*Default,NTP,0000,0000,0000,,Сіз мықты адамсыз, солай емес пе?
Dialogue: 0,0:25:19.37,0:25:21.05,*Default,NTP,0000,0000,0000,,Цк, сен мықтысың ба?
Dialogue: 0,0:25:23.51,0:25:26.90,*Default,NTP,0000,0000,0000,,Неліктен шын мықты адам айналасындағылардың бәрін мұңаяды?
Dialogue: 0,0:25:40.33,0:25:42.89,*Default,NTP,0000,0000,0000,,Бұл жерде ары қарай ойлаудың қажеті жоқ.
Dialogue: 0,0:25:43.56,0:25:45.05,*Default,NTP,0000,0000,0000,,Мен оны да қарастырамын.
Dialogue: 0,0:25:45.41,0:25:48.76,*Default,NTP,0000,0000,0000,,Әзірге, барлығыңыз капитан Хицугаяның қайда жүргенін бақылаңыздар.
Dialogue: 0,0:25:55.92,0:25:56.69,*Default,NTP,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:25:57.03,0:25:59.91,*Default,NTP,0000,0000,0000,,Рангику Мацумотомен кездесуге тыйым салынады.
Dialogue: 0,0:25:59.99,0:26:02.87,*Default,NTP,0000,0000,0000,,Жарайды емес пе, сәл сөйлесе тұрыңыз?
Dialogue: 0,0:26:03.18,0:26:04.46,*Default,NTP,0000,0000,0000,,Жоқ, жоқ.
Dialogue: 0,0:26:04.65,0:26:08.57,*Default,NTP,0000,0000,0000,,Бұл бас қолбасшы мен екінші бөлімшенің ара ұсақтағыш командирінің бұйрығы.
Dialogue: 0,0:26:10.31,0:26:12.69,*Default,NTP,0000,0000,0000,,Не? Бұл икемді емес.
Dialogue: 0,0:26:13.26,0:26:14.63,*Default,NTP,0000,0000,0000,,Бұл раккио басы
Dialogue: 0,0:26:14.86,0:26:17.15,*Default,NTP,0000,0000,0000,,Не? Не?
Dialogue: 0,0:26:17.35,0:26:19.23,*Default,NTP,0000,0000,0000,,Сіз жай ғана мені қорладыңыз.
Dialogue: 0,0:26:20.12,0:26:21.02,*Default,NTP,0000,0000,0000,,Менде жоқ.
Dialogue: 0,0:26:21.09,0:26:23.41,*Default,NTP,0000,0000,0000,,Сіз жаңа ғана Rakkyo Head дедіңіз.
Dialogue: 0,0:26:23.78,0:26:24.95,*Default,NTP,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:26:25.38,0:26:26.56,*Default,NTP,0000,0000,0000,,Бұл жанды.
Dialogue: 0,0:26:29.25,0:26:30.24,*Default,NTP,0000,0000,0000,,Капитан Кьёраку
Dialogue: 0,0:26:31.41,0:26:34.30,*Default,NTP,0000,0000,0000,,Мен сізге қосыламын. Бұл жақсы.
Dialogue: 0,0:26:36.79,0:26:39.41,*Default,NTP,0000,0000,0000,,Сіз 8-ші дивизияның капитанына сенбейсіз бе?
Dialogue: 0,0:26:41.28,0:26:41.97,*Default,NTP,0000,0000,0000,,Кусака?
Dialogue: 0,0:26:43.35,0:26:45.69,*Default,NTP,0000,0000,0000,,Мен білмеймін. Мен бұл туралы ешқашан естіген емеспін деп ойлаймын.
Dialogue: 0,0:26:46.94,0:26:47.76,*Default,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:26:48.59,0:26:49.98,*Default,NTP,0000,0000,0000,,Мен капитанның орынбасары болсам да
Dialogue: 0,0:26:50.15,0:26:52.50,*Default,NTP,0000,0000,0000,,Сіз капитан туралы ештеңе білмейсіз.
Dialogue: 0,0:26:57.42,0:26:59.80,*Default,NTP,0000,0000,0000,,Біріншіден, мен түсінбейтін нәрселер бар.
Dialogue: 0,0:27:01.35,0:27:02.31,*Default,NTP,0000,0000,0000,,Капитан Хицугая
Dialogue: 0,0:27:02.66,0:27:05.29,*Default,NTP,0000,0000,0000,,Құсақа деген кісімен қандай қатынастасың?
Dialogue: 0,0:27:05.94,0:27:07.37,*Default,NTP,0000,0000,0000,,Ер адам кім?
Dialogue: 0,0:27:07.89,0:27:09.80,*Default,NTP,0000,0000,0000,,Ер адамның оқиғаға қатысы бар ма?
Dialogue: 0,0:27:10.47,0:27:11.87,*Default,NTP,0000,0000,0000,,Егер бірдеңе болса ше?
Dialogue: 0,0:27:13.11,0:27:14.09,*Default,NTP,0000,0000,0000,,Жұмбақтарға толы.
Dialogue: 0,0:27:14.71,0:27:15.93,*Default,NTP,0000,0000,0000,,Тек оны іздеңіз.
Оны
Dialogue: 0,0:27:16.39,0:27:18.49,*Default,NTP,0000,0000,0000,,арқылы жасауға болады ма?
Dialogue: 0,0:27:19.06,0:27:21.39,*Default,NTP,0000,0000,0000,,Адамның басқа адам туралы бәрін білуі мүмкін емес.
Dialogue: 0,0:27:21.88,0:27:23.29,*Default,NTP,0000,0000,0000,,Іргетас мүмкін емес.
Dialogue: 0,0:27:24.09,0:27:27.34,*Default,NTP,0000,0000,0000,,Бұл біраз уақыт алуы мүмкін, бірақ білмесеңіз, іздеңіз.
Dialogue: 0,0:27:27.78,0:27:29.19,*Default,NTP,0000,0000,0000,,Қарапайым емес пе?
Dialogue: 0,0:27:32.92,0:27:34.02,*Default,NTP,0000,0000,0000,,Бұл не, капитан?
Dialogue: 0,0:27:34.64,0:27:36.22,*Default,NTP,0000,0000,0000,,Нанао-чан күткендей
Dialogue: 0,0:27:36.52,0:27:38.73,*Default,NTP,0000,0000,0000,,Нанао-чанның бұл туралы бірдеңе жасайтынына сенімдімін.
Dialogue: 0,0:27:39.12,0:27:39.62,*Default,NTP,0000,0000,0000,,Оң жақ...
Dialogue: 0,0:27:40.71,0:27:41.04,*Default,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:27:42.25,0:27:43.18,*Default,NTP,0000,0000,0000,,Өтінемін
Dialogue: 0,0:27:45.11,0:27:47.80,*Default,NTP,0000,0000,0000,,Рахмет Нанао, мен саған бір күні рахмет айтамын.
Dialogue: 0,0:27:48.30,0:27:50.04,*Default,NTP,0000,0000,0000,,Маған алғыс айтқыңыз келсе, міне осы.
Dialogue: 0,0:27:51.21,0:27:54.73,*Default,NTP,0000,0000,0000,,Сонымен, капитан сізге көмектесе алады ма?
Dialogue: 0,0:27:55.93,0:27:56.47,*Default,NTP,0000,0000,0000,,Мен де?
Dialogue: 0,0:27:56.76,0:27:57.72,*Default,NTP,0000,0000,0000,,(Джунпей) Бірақ ол мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:28:05.71,0:28:07.26,*Default,NTP,0000,0000,0000,,Және бұл
Dialogue: 0,0:28:15.30,0:28:18.28,*Default,NTP,0000,0000,0000,,Маған бұл дүниеде Рукия мен Ичиго жақындады.
Dialogue: 0,0:28:20.27,0:28:20.84,*Default,NTP,0000,0000,0000,,Жарақат алдыңыз ба?
Dialogue: 0,0:28:22.86,0:28:25.16,*Default,NTP,0000,0000,0000,,Ичигоға келетін болсақ, бұл өте нашар.
Dialogue: 0,0:28:27.47,0:28:30.24,*Default,NTP,0000,0000,0000,,Бірақ сен мұны қалдырып, жоқ болып кеттің.
Dialogue: 0,0:28:33.52,0:28:35.81,*Default,NTP,0000,0000,0000,,Тірі болғаныма қуануым керек пе?
Dialogue: 0,0:28:37.04,0:28:40.31,*Default,NTP,0000,0000,0000,,Әлде хаориді тастап кеткенің үшін саған ашулануым керек пе?
Dialogue: 0,0:28:42.33,0:28:42.87,*Default,NTP,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:28:44.77,0:28:45.77,*Default,NTP,0000,0000,0000,,Мүлдем
Dialogue: 0,0:28:46.62,0:28:48.99,*Default,NTP,0000,0000,0000,,Барлығы соншалықты уайымдаса да
Dialogue: 0,0:28:49.62,0:28:50.94,*Default,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:29:08.83,0:29:10.64,*Default,NTP,0000,0000,0000,,Менің атым Хёринмару
Dialogue: 0,0:29:11.22,0:29:14.45,*Default,NTP,0000,0000,0000,,Бала, мен сенде бар ма?
Dialogue: 0,0:29:14.91,0:29:19.71,*Default,NTP,0000,0000,0000,,Дұрыс, маған ер, Хёринмару.
Dialogue: 0,0:29:32.37,0:29:34.52,*Default,NTP,0000,0000,0000,,Мен мұны істедім, жасадым
Dialogue: 0,0:29:37.72,0:29:38.43,*Default,NTP,0000,0000,0000,,Тосиро
Dialogue: 0,0:29:39.99,0:29:41.56,*Default,NTP,0000,0000,0000,,Қандай кездейсоқтық!
Dialogue: 0,0:29:42.10,0:29:45.06,*Default,NTP,0000,0000,0000,,Бірдей күшке ие болғанымызға қуаныштымын.
Dialogue: 0,0:30:25.53,0:30:27.91,*Default,NTP,0000,0000,0000,,Мен соңғы 50 жылдағы тізімді қарап шықтым.
Dialogue: 0,0:30:28.50,0:30:30.54,*Default,NTP,0000,0000,0000,,Құсақа деген сарбаз жоқ.
Dialogue: 0,0:30:31.31,0:30:34.88,*Default,NTP,0000,0000,0000,,Сонымен, рухани емхана өткенге кетті ме?
Dialogue: 0,0:30:35.08,0:30:37.73,*Default,NTP,0000,0000,0000,,Иә, мұндай атау болған жоқ.
Dialogue: 0,0:30:38.21,0:30:42.25,*Default,NTP,0000,0000,0000,,Алайда капитан Хицугая бітірген жылдың тізімінде жазылған адамдар саны
Dialogue: 0,0:30:42.68,0:30:44.41,*Default,NTP,0000,0000,0000,,Есімдердің саны сәйкес келмейді.
Dialogue: 0,0:30:45.29,0:30:48.50,*Default,NTP,0000,0000,0000,,Коды жоқ студенттер Кита-рю Конгайдан.
Dialogue: 0,0:30:49.22,0:30:52.40,*Default,NTP,0000,0000,0000,,Құсақа тегі аудан тізілімінде көрсетілген.
Dialogue: 0,0:30:53.49,0:30:54.16,*Default,NTP,0000,0000,0000,,болды
Dialogue: 0,0:30:55.83,0:30:58.14,*Default,NTP,0000,0000,0000,,Бұл Содзиро Сокан
Dialogue: 0,0:30:59.13,0:31:00.43,*Default,NTP,0000,0000,0000,,Бұл өте тітіркендіргіш
Dialogue: 0,0:31:01.73,0:31:02.53,*Default,NTP,0000,0000,0000,,Өлім?
Dialogue: 0,0:31:03.04,0:31:04.85,*Default,NTP,0000,0000,0000,,Бұл Рухани Академия тізімінде жоқ.
Dialogue: 0,0:31:05.34,0:31:06.97,*Default,NTP,0000,0000,0000,,Бұл жай ғана олқылық па?
Dialogue: 0,0:31:07.14,0:31:09.90,*Default,NTP,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:31:10.78,0:31:12.41,*Default,NTP,0000,0000,0000,,Әсіресе бұл өлім болса.
Dialogue: 0,0:31:12.68,0:31:15.63,*Default,NTP,0000,0000,0000,,Бірақ енді кем дегенде шабуылдаушы
Dialogue: 0,0:31:15.85,0:31:18.85,*Default,NTP,0000,0000,0000,,Сонымен Содзиро Сокан сызығы жоғалып кетті.
Dialogue: 0,0:31:20.85,0:31:26.07,*Default,NTP,0000,0000,0000,,Рейатсудың жоғалуы расталмайынша, ол өлім ретінде тіркелмейді.
Dialogue: 0,0:31:27.43,0:31:29.27,*Default,NTP,0000,0000,0000,,Менің ойымша, ол өлді.
Dialogue: 0,0:31:29.73,0:31:31.00,*Default,NTP,0000,0000,0000,,Бірақ... не?
Dialogue: 0,0:31:33.03,0:31:34.08,*Default,NTP,0000,0000,0000,,Мен біраз уақыт жүремін.
Dialogue: 0,0:31:34.97,0:31:37.07,*Default,NTP,0000,0000,0000,,Нанао-чан, оның өлімінің себебін анықтаңыз.
Dialogue: 0,0:31:37.99,0:31:38.61,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:32:24.73,0:32:26.64,*Default,NTP,0000,0000,0000,,Әй, бұл кім?
Dialogue: 0,0:32:31.23,0:32:33.72,*Default,NTP,0000,0000,0000,,Егер сіз ештеңе айтпасаңыз, алаңдамайсыз ба?
Dialogue: 0,0:32:34.28,0:32:35.76,*Default,NTP,0000,0000,0000,,Кйораку Шунсуй
Dialogue: 0,0:32:36.09,0:32:39.76,*Default,NTP,0000,0000,0000,,Оның жеңіл жүріс-тұрысы оның ойлылығын жоққа шығарады және
Dialogue: 0,0:32:40.03,0:32:43.77,*Default,NTP,0000,0000,0000,,Ешкім басқалардан артық емес екенін түсінетін өткір ақылға ие болыңыз.
Dialogue: 0,0:32:44.44,0:32:46.80,*Default,NTP,0000,0000,0000,,Өйткені оның иісін сен бірінші сездің ғой.
Dialogue: 0,0:32:47.39,0:32:49.32,*Default,NTP,0000,0000,0000,,Маған комплимент айтқаныңызға қуаныштымын.
Dialogue: 0,0:32:49.35,0:32:53.40,*Default,NTP,0000,0000,0000,,Неліктен бөтен адамдардың орнына өзің туралы айтпайсың?
Dialogue: 0,0:32:53.64,0:32:54.99,*Default,NTP,0000,0000,0000,,Уедди.
Dialogue: 0,0:32:55.11,0:32:58.76,*Default,NTP,0000,0000,0000,,Сізді осы жерде Тосиро Хицугая өлтіреді.
Dialogue: 0,0:33:06.26,0:33:07.32,*Default,NTP,0000,0000,0000,,Бұл Занпакуто
Dialogue: 0,0:33:09.13,0:33:10.52,*Default,NTP,0000,0000,0000,,Маған сенің жүзіңді көрейін
Dialogue: 0,0:33:14.64,0:33:15.27,*Default,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:33:38.13,0:33:40.62,*Default,NTP,0000,0000,0000,,Капитан Хицугая, бұл төтенше жағдай бойынша арнайы бұйрық.
Dialogue: 0,0:33:41.36,0:33:43.73,*Default,NTP,0000,0000,0000,,Тезірек Сейрейтейге оралыңыз.
Dialogue: 0,0:33:50.37,0:33:52.01,*Default,NTP,0000,0000,0000,,Мен орындауға ниетім жоқ.
Dialogue: 0,0:34:00.05,0:34:02.55,*Default,NTP,0000,0000,0000,,Тоқта, бұл опасыздық болып саналады.
Dialogue: 0,0:34:03.02,0:34:05.22,*Default,NTP,0000,0000,0000,,Кира Хисагиге түсіңіз
Dialogue: 0,0:34:05.99,0:34:08.75,*Default,NTP,0000,0000,0000,,Капитан Хицугая, мен сені ұстаймын.
Dialogue: 0,0:34:10.51,0:34:11.21,*Default,NTP,0000,0000,0000,,Мен өлемін
Dialogue: 0,0:34:21.64,0:34:24.33,*Default,NTP,0000,0000,0000,,Алпыс екі жүз қадам құлдық
Dialogue: 0,0:34:59.14,0:35:00.38,*Default,NTP,0000,0000,0000,,Тыныш отырыңыз
Dialogue: 0,0:35:00.51,0:35:03.83,*Default,NTP,0000,0000,0000,,Аязды аспанда отыр, Хёринмару
Dialogue: 0,0:35:23.63,0:35:25.11,*Default,NTP,0000,0000,0000,,Таза ауа тосқауылына дайындық
Dialogue: 0,0:35:25.67,0:35:27.61,*Default,NTP,0000,0000,0000,,Процедураны дереу бастаңыз
Dialogue: 0,0:35:32.27,0:35:33.65,*Default,NTP,0000,0000,0000,,Бұл менің кінәм
Dialogue: 0,0:35:36.91,0:35:38.21,*Default,NTP,0000,0000,0000,,Бұл сіздің кінәңіз емес.
Dialogue: 0,0:35:40.08,0:35:41.20,*Default,NTP,0000,0000,0000,,Капитан Укитаке
Dialogue: 0,0:35:41.72,0:35:43.18,*Default,NTP,0000,0000,0000,,Егер Кйораку өлтірілсе
Dialogue: 0,0:35:43.55,0:35:45.97,*Default,NTP,0000,0000,0000,,Бұл басқа адам оны абайсызда ұстап алғаны үшін бе?
Dialogue: 0,0:35:46.29,0:35:49.05,*Default,NTP,0000,0000,0000,,Оның шынымен де оның қабілетінен асып түсетін қабілеттері болуы керек.
Dialogue: 0,0:35:50.49,0:35:51.15,*Default,NTP,0000,0000,0000,,Бірақ мен осы тасбақамен денемізді алмастырдым
Dialogue: 0,0:35:52.63,0:35:53.19,*Default,NTP,0000,0000,0000,,Мұнда рух бар.
Dialogue: 0,0:35:53.76,0:35:56.75,*Default,NTP,0000,0000,0000,,Тағы айтамын, бұл сенің кінәң емес.
Dialogue: 0,0:36:00.00,0:36:02.13,*Default,NTP,0000,0000,0000,,6-шы отряд қазір оқиға орнын тексеріп жатыр.
Dialogue: 0,0:36:02.94,0:36:04.61,*Default,NTP,0000,0000,0000,,Қылмыскер жақын арада ұсталады.
Dialogue: 0,0:36:24.26,0:36:26.41,*Default,NTP,0000,0000,0000,,Бұл сөзсіз Хёринмару.
Dialogue: 0,0:36:28.53,0:36:30.57,*Default,NTP,0000,0000,0000,,Не? Хиоринмару ше?
Dialogue: 0,0:36:31.73,0:36:32.95,*Default,NTP,0000,0000,0000,,Капитан Хицугая
Dialogue: 0,0:36:35.10,0:36:37.22,*Default,NTP,0000,0000,0000,,Бұл да жақсы идея емес сияқты.
Dialogue: 0,0:36:42.31,0:36:45.30,*Default,NTP,0000,0000,0000,,Есеп Үшінші бөлім Изуру Кира және
Dialogue: 0,0:36:45.61,0:36:48.39,*Default,NTP,0000,0000,0000,,9-дивизия Шухеи Хисаги Капитанның міндетін атқарушы
Dialogue: 0,0:36:48.75,0:36:50.79,*Default,NTP,0000,0000,0000,,Осы дүниеде Тосиро Хицугаямен кездесу
Dialogue: 0,0:36:51.25,0:36:52.74,*Default,NTP,0000,0000,0000,,Маған қарсылық көрсетіліп, жарақат алдым.
Dialogue: 0,0:37:15.68,0:37:16.57,*Default,NTP,0000,0000,0000,,Қарсы алу
Dialogue: 0,0:37:17.14,0:37:19.82,*Default,NTP,0000,0000,0000,,Сонымен Тосиро-кун достарына шабуыл жасады ма?
Dialogue: 0,0:37:20.38,0:37:21.33,*Default,NTP,0000,0000,0000,,Бұл бәрі емес
Dialogue: 0,0:37:21.88,0:37:23.73,*Default,NTP,0000,0000,0000,,Капитан Кьёракуға да шабуыл жасалған сияқты.
Dialogue: 0,0:37:24.89,0:37:25.82,*Default,NTP,0000,0000,0000,,Кьёраку-сан
Dialogue: 0,0:37:27.15,0:37:28.50,*Default,NTP,0000,0000,0000,,Ренжидің әңгімесі бойынша
Dialogue: 0,0:37:28.76,0:37:31.54,*Default,NTP,0000,0000,0000,,Екеуі де Хёринмарудан ауыр жарақат алды.
Dialogue: 0,0:37:34.53,0:37:36.57,*Default,NTP,0000,0000,0000,,Ишида: Рейацумен бірге жүре алмайсың ба?
Dialogue: 0,0:37:37.03,0:37:37.90,*Default,NTP,0000,0000,0000,,Сен жақсысың, солай ма?
Dialogue: 0,0:37:38.63,0:37:39.30,*Default,NTP,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:37:39.77,0:37:41.48,*Default,NTP,0000,0000,0000,,Шүкір, біз қайтадан бірінші шаршыдан бастаймыз.
Dialogue: 0,0:37:47.54,0:37:48.92,*Default,NTP,0000,0000,0000,,Таңертең болды.
Dialogue: 0,0:37:53.12,0:37:54.31,*Default,NTP,0000,0000,0000,,Бұл жаман болды, бәрі.
Dialogue: 0,0:37:54.78,0:37:56.80,*Default,NTP,0000,0000,0000,,Қайтеміз, түстен кейін қайтайық.
Dialogue: 0,0:37:57.99,0:37:58.48,*Default,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:37:58.95,0:38:00.80,*Default,NTP,0000,0000,0000,,Мен болсам, жарайды.
Dialogue: 0,0:38:01.62,0:38:03.29,*Default,NTP,0000,0000,0000,,Жоқ, бұл жақсы болар еді.
Dialogue: 0,0:38:03.96,0:38:06.85,*Default,NTP,0000,0000,0000,,Егер сіз дүрбелең болса да, бұл міндетті түрде сіз оны бірден табасыз дегенді білдірмейді.
Dialogue: 0,0:38:13.20,0:38:16.76,*Default,NTP,0000,0000,0000,,Тосиро Хицугая көтеріліске күдіктенуіне байланысты
Dialogue: 0,0:38:17.14,0:38:20.68,*Default,NTP,0000,0000,0000,,Төтенше жағдайдағы арнайы бұйрықты Готей Даймёға өзгерту
Dialogue: 0,0:38:21.16,0:38:22.73,*Default,NTP,0000,0000,0000,,Сіздің сөзіңізде
Dialogue: 0,0:38:23.28,0:38:25.35,*Default,NTP,0000,0000,0000,,Бұл сәл асығыс емес пе?
Dialogue: 0,0:38:25.55,0:38:26.99,*Default,NTP,0000,0000,0000,,Қарсылық қабылданбады
Dialogue: 0,0:38:28.05,0:38:30.83,*Default,NTP,0000,0000,0000,,Корольдік мөрді іздеу жалғасуда.
Dialogue: 0,0:38:31.18,0:38:35.55,*Default,NTP,0000,0000,0000,,Тосиро Хицугаяға қатысты оның бірінші кезектегі мақсаты - оны ұстау.
Dialogue: 0,0:38:35.86,0:38:38.31,*Default,NTP,0000,0000,0000,,Сол кезде қандай да бір қарсылық болса.
Dialogue: 0,0:38:38.93,0:38:40.24,*Default,NTP,0000,0000,0000,,Орындау
Dialogue: 0,0:38:52.58,0:38:55.66,*Default,NTP,0000,0000,0000,,Ичиго, бұл Ренжиден. Готейге үлкен бұйрық берілді.
Dialogue: 0,0:38:56.71,0:38:57.87,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:38:58.34,0:39:01.61,*Default,NTP,0000,0000,0000,,Капитан Хицугаяға өлім жазасына кесу туралы бұйрық берілді.
Dialogue: 0,0:39:03.32,0:39:05.88,*Default,NTP,0000,0000,0000,,Орындау тәртібі? Не айтқың келеді?
Dialogue: 0,0:39:06.62,0:39:08.22,*Default,NTP,0000,0000,0000,,Уақыт жоқ
Dialogue: 0,0:39:08.42,0:39:10.41,*Default,NTP,0000,0000,0000,,Жеңілдететін мән-жайларға орын жоқ.
Dialogue: 0,0:39:11.59,0:39:12.23,*Default,NTP,0000,0000,0000,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:39:14.26,0:39:17.37,*Default,NTP,0000,0000,0000,,Рукияның тағы да айтары бар. Мен Кусаканы түсінемін.
Dialogue: 0,0:39:17.85,0:39:18.15,*Default,NTP,0000,0000,0000,,Ичиго
Dialogue: 0,0:39:19.28,0:39:19.89,*Default,NTP,0000,0000,0000,,Мен оны естідім.
Dialogue: 0,0:39:21.60,0:39:25.35,*Default,NTP,0000,0000,0000,,Судзиро Сокан, капитан Хицугаяның бұрынғы сыныптасы.
Dialogue: 0,0:39:25.97,0:39:26.89,*Default,NTP,0000,0000,0000,,Ол қайтыс болды
Dialogue: 0,0:39:27.21,0:39:30.61,*Default,NTP,0000,0000,0000,,Капитан Хицугая Мао рухани академиясын бітірейін деп жатыр.
Dialogue: 0,0:39:40.65,0:39:41.40,*Default,NTP,0000,0000,0000,,Темера
Dialogue: 0,0:39:41.82,0:39:42.71,*Default,NTP,0000,0000,0000,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:39:43.09,0:39:45.20,*Default,NTP,0000,0000,0000,,Кедергі болса, құтыл.
Dialogue: 0,0:39:45.99,0:39:47.22,*Default,NTP,0000,0000,0000,,Грим Реапер?
Dialogue: 0,0:39:47.99,0:39:48.53,*Default,NTP,0000,0000,0000,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:39:49.96,0:39:51.98,*Default,NTP,0000,0000,0000,,Ичиго, ол адамның қолынан келеді.
Dialogue: 0,0:39:52.53,0:39:53.85,*Default,NTP,0000,0000,0000,,Бұл ерекше реятсу.
Dialogue: 0,0:39:59.86,0:40:01.50,*Default,NTP,0000,0000,0000,,Бұл Хёринмару
Dialogue: 0,0:40:06.21,0:40:08.71,*Default,NTP,0000,0000,0000,,Бұл керісінше, Кйораку.
Dialogue: 0,0:40:09.68,0:40:13.33,*Default,NTP,0000,0000,0000,,Мен әрқашан еденде жатып, шабуылға ұшырадым.
Dialogue: 0,0:40:20.73,0:40:21.40,*Default,NTP,0000,0000,0000,,Дегенмен
Dialogue: 0,0:40:24.43,0:40:26.26,*Default,NTP,0000,0000,0000,,Мен бір нәрсені түсінбеймін.
Dialogue: 0,0:40:27.07,0:40:30.18,*Default,NTP,0000,0000,0000,,Тергеу Хьёринмару жасаған қылмыстың уақыты мен уақытын анықтады.
Dialogue: 0,0:40:30.87,0:40:33.46,*Default,NTP,0000,0000,0000,,Іздеу тобы Хицугаяға хабарласқан уақыт
Dialogue: 0,0:40:38.61,0:40:40.32,*Default,NTP,0000,0000,0000,,Қалай жүрсең де, осы дүниеге дейін
Dialogue: 0,0:40:40.88,0:40:42.63,*Default,NTP,0000,0000,0000,,Бұл біраз уақыт алуы керек
Dialogue: 0,0:40:43.88,0:40:47.22,*Default,NTP,0000,0000,0000,,Егер екеуі де шынымен Хёринмарудан туындаған болса.
Dialogue: 0,0:40:49.36,0:40:51.03,*Default,NTP,0000,0000,0000,,Аязда отыр
Dialogue: 0,0:40:52.73,0:40:53.82,*Default,NTP,0000,0000,0000,,Хёринмару
Dialogue: 0,0:41:07.67,0:41:08.80,*Default,NTP,0000,0000,0000,,Неліктен Теме?
Dialogue: 0,0:41:09.03,0:41:10.99,*Default,NTP,0000,0000,0000,,Өйткені ол Хёринмарудың иесі.
Dialogue: 0,0:41:14.35,0:41:15.16,*Default,NTP,0000,0000,0000,,Қазір не болып жатыр?
Dialogue: 0,0:41:15.72,0:41:18.35,*Default,NTP,0000,0000,0000,,Егіз Занпакуто дедіңіз бе?
Dialogue: 0,0:41:20.52,0:41:24.20,*Default,NTP,0000,0000,0000,,Занпакуто Шинигамидің өзінен туған.
Dialogue: 0,0:41:24.76,0:41:25.67,*Default,NTP,0000,0000,0000,,Шикай дегеніміз не?
Dialogue: 0,0:41:26.23,0:41:30.87,*Default,NTP,0000,0000,0000,,Бұл Занпакуто мен Шинигами арасындағы жеке келісім-шарт сияқты.
Dialogue: 0,0:41:31.43,0:41:34.86,*Default,NTP,0000,0000,0000,,Бірнеше Шинигамимен келісім-шарт жасау мүмкін емес.
Dialogue: 0,0:41:35.13,0:41:37.49,*Default,NTP,0000,0000,0000,,Бұл Занпакуто емес
Dialogue: 0,0:41:38.17,0:41:41.40,*Default,NTP,0000,0000,0000,,Сонымен, оның жоқтығын дәлелдей аламыз ба?
Dialogue: 0,0:41:42.14,0:41:44.82,*Default,NTP,0000,0000,0000,,Хёринмарудың екі рет өмір сүре алмайтынының дәлелі
Dialogue: 0,0:41:45.38,0:41:46.55,*Default,NTP,0000,0000,0000,,Хёринмару
Dialogue: 0,0:41:47.45,0:41:50.55,*Default,NTP,0000,0000,0000,,Екі әткеншек болса, оның біреуінің иесі
Dialogue: 0,0:41:50.56,0:41:51.71,*Default,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:41:52.25,0:41:55.29,*Default,NTP,0000,0000,0000,,Балалар, маған не үшін келгендеріңізді түсіндім.
Dialogue: 0,0:41:56.69,0:41:59.65,*Default,NTP,0000,0000,0000,,Ұлы Рух кітап дәлізінің ішкі камерасына жасырын кіру және т.б.
Dialogue: 0,0:41:59.93,0:42:02.04,*Default,NTP,0000,0000,0000,,Мен үшін ерекше ештеңе жоқ
Dialogue: 0,0:42:23.45,0:42:24.67,*Default,NTP,0000,0000,0000,,Бұл 'e', 'a' емес.
Dialogue: 0,0:42:26.55,0:42:29.58,*Default,NTP,0000,0000,0000,,Менің атым Содзиро Сокан
Dialogue: 0,0:42:30.32,0:42:31.00,*Default,NTP,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:42:31.56,0:42:34.57,*Default,NTP,0000,0000,0000,,Сейрейтейде, орталық 46-бөлмеде
Dialogue: 0,0:42:35.13,0:42:37.65,*Default,NTP,0000,0000,0000,,Бұл Тосиро Хицугая өлтірген адам.
Dialogue: 0,0:42:43.97,0:42:45.39,*Default,NTP,0000,0000,0000,,Жан қоғамы
Dialogue: 0,0:42:45.51,0:42:48.02,*Default,NTP,0000,0000,0000,,Тосиро Хицугаяны сатқын деп есептеді.
Dialogue: 0,0:42:48.47,0:42:50.32,*Default,NTP,0000,0000,0000,,Қазір қайтатын жер жоқ
Dialogue: 0,0:42:50.79,0:42:53.59,*Default,NTP,0000,0000,0000,,Жалғыз белгісіздік сізде қалды.
Dialogue: 0,0:42:54.15,0:42:55.96,*Default,NTP,0000,0000,0000,,Мен сені өлтіремін, Грим Репер.
Dialogue: 0,0:43:11.13,0:43:12.04,*Default,NTP,0000,0000,0000,,Тосиро
Dialogue: 0,0:43:13.27,0:43:15.04,*Default,NTP,0000,0000,0000,,Шөп тәжі Неліктен?
Dialogue: 0,0:43:18.60,0:43:21.91,*Default,NTP,0000,0000,0000,,Енді 46-бөлменің шешімін хабарлаймын.
Dialogue: 0,0:43:23.29,0:43:27.64,*Default,NTP,0000,0000,0000,,Екі Шинигамиге бір Занпакутоны ұстауға рұқсат етілмейді.
Dialogue: 0,0:43:28.35,0:43:30.66,*Default,NTP,0000,0000,0000,,Сондықтан бұдан былай екі есім де
Dialogue: 0,0:43:31.05,0:43:34.13,*Default,NTP,0000,0000,0000,,Байыпты матчта иесін анықтаңыз
Dialogue: 0,0:43:35.66,0:43:38.49,*Default,NTP,0000,0000,0000,,Бұл екеуміз бір-бірімізді өлтіруіміз керек дегенді білдіре ме?
Dialogue: 0,0:43:39.19,0:43:40.83,*Default,NTP,0000,0000,0000,,Заңды біліктілік
Dialogue: 0,0:43:41.23,0:43:42.61,*Default,NTP,0000,0000,0000,,Ақылға қонымды қабілет
Dialogue: 0,0:43:43.06,0:43:46.26,*Default,NTP,0000,0000,0000,,Міне, бұл Хёринмарудың күштілігі.
Dialogue: 0,0:43:46.90,0:43:48.10,*Default,NTP,0000,0000,0000,,Мұны құрмет деп санаңыз.
Dialogue: 0,0:43:48.74,0:43:49.34,*Default,NTP,0000,0000,0000,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:43:49.90,0:43:53.12,*Default,NTP,0000,0000,0000,,Соканмен жекпе-жекке шыққанша, Хёринмарудан бас тартқаным артық.
Dialogue: 0,0:43:53.77,0:43:54.26,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:43:54.87,0:43:55.52,*Default,NTP,0000,0000,0000,,Рұқсат етілмейді
Dialogue: 0,0:43:55.68,0:43:56.28,*Default,NTP,0000,0000,0000,,Рұқсат етілмейді
Dialogue: 0,0:43:56.84,0:43:59.23,*Default,NTP,0000,0000,0000,,Неліктен бізде бірдей Занпакуто болмайды?
Dialogue: 0,0:43:59.85,0:44:01.26,*Default,NTP,0000,0000,0000,,Бұл ереже.
Dialogue: 0,0:44:01.55,0:44:03.83,*Default,NTP,0000,0000,0000,,Өйткені бұл ежелгі заң.
Dialogue: 0,0:44:04.24,0:44:05.68,*Default,NTP,0000,0000,0000,,Бағынбау
Dialogue: 0,0:44:05.95,0:44:06.82,*Default,NTP,0000,0000,0000,,Қуғын-сүргін
Dialogue: 0,0:44:07.05,0:44:08.27,*Default,NTP,0000,0000,0000,,Күмәнданба
Dialogue: 0,0:44:08.39,0:44:09.46,*Default,NTP,0000,0000,0000,,Рұқсат етілмейді
Dialogue: 0,0:44:09.50,0:44:15.31,*Default,NTP,0000,0000,0000,,Өтінемін, осы жерде қалыңыз.
Dialogue: 0,0:44:21.63,0:44:22.71,*Default,NTP,0000,0000,0000,,Хицугая
Dialogue: 0,0:44:24.27,0:44:24.84,*Default,NTP,0000,0000,0000,,Шөп тәжі
Dialogue: 0,0:44:29.28,0:44:32.23,*Default,NTP,0000,0000,0000,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:44:33.81,0:44:37.42,*Default,NTP,0000,0000,0000,,Hyorinmaru иесі Тосиро Хицугая екені анықталды.
Dialogue: 0,0:44:38.62,0:44:40.43,*Default,NTP,0000,0000,0000,,Шайқас әлі аяқталған жоқ
Dialogue: 0,0:44:41.25,0:44:43.50,*Default,NTP,0000,0000,0000,,Хёринмару менікі.
Dialogue: 0,0:44:44.62,0:44:46.19,*Default,NTP,0000,0000,0000,,Бұл 46-бөлменің шешімі.
Dialogue: 0,0:44:47.89,0:44:49.61,*Default,NTP,0000,0000,0000,,Күте тұрыңыз.
Dialogue: 0,0:44:54.65,0:44:55.12,*Default,NTP,0000,0000,0000,,Шөп тәжі
Dialogue: 0,0:44:56.69,0:44:57.66,*Default,NTP,0000,0000,0000,,Неге мен?
Dialogue: 0,0:44:58.97,0:45:00.76,*Default,NTP,0000,0000,0000,,Өлу керек
Dialogue: 0,0:45:02.07,0:45:02.57,*Default,NTP,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:45:07.35,0:45:11.43,*Default,NTP,0000,0000,0000,,Мен Soul Society үшінмін.
Dialogue: 0,0:45:13.75,0:45:15.09,*Default,NTP,0000,0000,0000,,Шөп тәжі
Dialogue: 0,0:45:39.01,0:45:43.22,*Default,NTP,0000,0000,0000,,Хицугая менімен бірге жүреді, мен оған жол бермеймін.
Dialogue: 0,0:45:43.88,0:45:44.89,*Default,NTP,0000,0000,0000,,Хёринмару
Dialogue: 0,0:45:50.76,0:45:51.30,*Default,NTP,0000,0000,0000,,Ичиго
Dialogue: 0,0:46:01.47,0:46:04.06,*Default,NTP,0000,0000,0000,,Хёринмарудың күші артып келеді
Dialogue: 0,0:46:06.01,0:46:08.68,*Default,NTP,0000,0000,0000,,Уақыт келді. Қалғанын саған қалдырамын.
Dialogue: 0,0:46:08.98,0:46:09.54,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:46:16.82,0:46:18.83,*Default,NTP,0000,0000,0000,,Отыз үш үзілген жол Көк от құлайды
Dialogue: 0,0:46:34.95,0:46:35.42,*Default,NTP,0000,0000,0000,,Зангецу
Dialogue: 0,0:46:35.97,0:46:38.61,*Default,NTP,0000,0000,0000,,Біраз уақыт өтті, Ичиго.
Dialogue: 0,0:46:39.74,0:46:42.10,*Default,NTP,0000,0000,0000,,Қазір бұл не? Бұл иллюзия ма?
Dialogue: 0,0:46:43.14,0:46:44.06,*Default,NTP,0000,0000,0000,,Резонанс
Dialogue: 0,0:46:44.91,0:46:49.42,*Default,NTP,0000,0000,0000,,Занпакутос жаңғырып, дірілдеп, өткенді ашады.
Dialogue: 0,0:46:49.98,0:46:50.40,*Default,NTP,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:46:52.02,0:46:54.03,*Default,NTP,0000,0000,0000,,Бұл даусыз факт.
Dialogue: 0,0:46:54.89,0:46:58.20,*Default,NTP,0000,0000,0000,,Жан қоғамы екі Хёринмарудың болуын жек көреді.
Dialogue: 0,0:46:58.76,0:47:01.92,*Default,NTP,0000,0000,0000,,Сіз бір адамды өлтірдіңіз бе? Неліктен?
Dialogue: 0,0:47:02.53,0:47:04.60,*Default,NTP,0000,0000,0000,,Бұл әдетке айналғандықтан.
Dialogue: 0,0:47:05.56,0:47:09.54,*Default,NTP,0000,0000,0000,,Жан қоғамында бәрінен де асып түсетін заң
Dialogue: 0,0:47:09.80,0:47:12.83,*Default,NTP,0000,0000,0000,,Бұл әлемнің аман қалуы және тепе-теңдігі
Dialogue: 0,0:47:13.14,0:47:16.03,*Default,NTP,0000,0000,0000,,Адамдардың сезімі туралы олар не ойлайды?
Dialogue: 0,0:47:16.51,0:47:18.59,*Default,NTP,0000,0000,0000,,Күлкілі сөздер айтпа
Dialogue: 0,0:47:19.21,0:47:21.48,*Default,NTP,0000,0000,0000,,Біз үшін адамдардың ойы, т.б.
Dialogue: 0,0:47:21.75,0:47:25.67,*Default,NTP,0000,0000,0000,,Дүниеде салыстыруға тұрарлық ештеңе жоқ, елеусіз нәрсе
Dialogue: 0,0:47:26.65,0:47:28.92,*Default,NTP,0000,0000,0000,,Сіздің әлеміңізде бұл басқаша ма?
Dialogue: 0,0:47:30.86,0:47:35.03,*Default,NTP,0000,0000,0000,,Бірақ адамның жүрегі дірілдеп, мазасызданады.
Dialogue: 0,0:47:35.25,0:47:39.29,*Default,NTP,0000,0000,0000,,Жамандыққа түсу де бұлтартпас факт.
Dialogue: 0,0:47:40.29,0:47:41.89,*Default,NTP,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:47:43.54,0:47:44.16,*Default,NTP,0000,0000,0000,,Титанның алдында сарбаздар бірінен соң бірі құлады.
Dialogue: 0,0:47:45.67,0:47:47.37,*Default,NTP,0000,0000,0000,,Тосиро мұны істемейді.
Dialogue: 0,0:47:48.33,0:47:50.15,*Default,NTP,0000,0000,0000,,Неліктен олай ойлайсың?
Dialogue: 0,0:47:50.73,0:47:51.40,*Default,NTP,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:47:52.48,0:47:53.48,*Default,NTP,0000,0000,0000,,Ичиго жоқ
Dialogue: 0,0:47:55.25,0:47:58.85,*Default,NTP,0000,0000,0000,,Қарт менің бетім әлгі жігітпен бірдей еді.
Dialogue: 0,0:48:01.45,0:48:03.26,*Default,NTP,0000,0000,0000,,Анам біраз уақыт қайтыс болды.
Dialogue: 0,0:48:04.06,0:48:07.45,*Default,NTP,0000,0000,0000,,Мен түрлі сезімдерге батып бара жатқандай болдым.
Dialogue: 0,0:48:08.69,0:48:12.18,*Default,NTP,0000,0000,0000,,Бірақ мұның бәрін алып жүру
Dialogue: 0,0:48:12.73,0:48:15.77,*Default,NTP,0000,0000,0000,,Соның бәрін жалғыз өзім көтеруді міндетім деп санадым.
Dialogue: 0,0:48:25.31,0:48:29.50,*Default,NTP,0000,0000,0000,,Сондықтан мен айналамдағылардың барлығын мұңайып отырмын.
Dialogue: 0,0:48:30.42,0:48:32.04,*Default,NTP,0000,0000,0000,,Мен оны мүлде байқамадым
Dialogue: 0,0:48:34.29,0:48:36.70,*Default,NTP,0000,0000,0000,,Тосироның бет-бейнесі ол кезде менімен бірдей болатын.
Dialogue: 0,0:48:41.33,0:48:43.47,*Default,NTP,0000,0000,0000,,Мен бәрін бірге ұстауға тырысамын
Dialogue: 0,0:48:45.46,0:48:45.97,*Default,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:48:49.14,0:48:49.98,*Default,NTP,0000,0000,0000,,Жасы 25-тен 35-ке дейін, және мен айтар едім, ол айтарлықтай бай жігіт.
Dialogue: 0,0:48:50.64,0:48:52.60,*Default,NTP,0000,0000,0000,,Ол не істемекші?
Dialogue: 0,0:48:53.84,0:48:54.65,*Default,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:48:56.81,0:48:59.11,*Default,NTP,0000,0000,0000,,Алға қарасаң тайсалма.
Dialogue: 0,0:49:00.91,0:49:03.38,*Default,NTP,0000,0000,0000,,Ичигоға барыңыз
Dialogue: 0,0:49:17.53,0:49:17.73,*Default,NTP,0000,0000,0000,,қаңтар
Dialogue: 0,0:49:25.10,0:49:25.60,*Default,NTP,0000,0000,0000,,Рукия
Dialogue: 0,0:49:27.17,0:49:28.23,*Default,NTP,0000,0000,0000,,Ичиго, жақсысың ба?
Dialogue: 0,0:49:29.30,0:49:29.78,*Default,NTP,0000,0000,0000,,Шөп тәжі
Dialogue: 0,0:49:30.58,0:49:31.89,*Default,NTP,0000,0000,0000,,Кешіріңіз, мен қашып кеттім.
Dialogue: 0,0:49:32.28,0:49:35.82,*Default,NTP,0000,0000,0000,,Олай болса мына жігіттерді қуып, дереу қуу керек.
Dialogue: 0,0:49:36.78,0:49:37.51,*Default,NTP,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:49:38.60,0:49:40.78,*Default,NTP,0000,0000,0000,,Тосиро не істемекші?
Dialogue: 0,0:49:43.59,0:49:46.35,*Default,NTP,0000,0000,0000,,Соукан-сама шабуыл жасап, әлі тірі ме?
Dialogue: 0,0:49:46.49,0:49:48.06,*Default,NTP,0000,0000,0000,,Қандай қиын жау
Dialogue: 0,0:49:48.49,0:49:49.68,*Default,NTP,0000,0000,0000,,Жеңілу керек
Dialogue: 0,0:49:49.70,0:49:50.29,*Default,NTP,0000,0000,0000,,Әрине
Dialogue: 0,0:49:57.44,0:49:58.32,*Default,NTP,0000,0000,0000,,Мен ол жігітпін
Dialogue: 0,0:49:59.34,0:50:00.90,*Default,NTP,0000,0000,0000,,Мен шынымен де айтуым керек.
Dialogue: 0,0:50:38.84,0:50:40.55,*Default,NTP,0000,0000,0000,,Сіз оны таптыңыз.
Dialogue: 0,0:50:41.41,0:50:43.45,*Default,NTP,0000,0000,0000,,Мен сенің іздегеніңді қаладым.
Dialogue: 0,0:50:44.62,0:50:45.23,*Default,NTP,0000,0000,0000,,Шөп тәжі
Dialogue: 0,0:50:45.99,0:50:49.76,*Default,NTP,0000,0000,0000,,Сондықтан мен Хёринмарумен бірге денеңде тыртық қалдырдым.
Dialogue: 0,0:50:50.86,0:50:53.27,*Default,NTP,0000,0000,0000,,Менің тірі екеніме сенбейсің бе?
Dialogue: 0,0:50:54.19,0:50:55.26,*Default,NTP,0000,0000,0000,,Неге жасырып жатырсың?
Dialogue: 0,0:50:56.44,0:50:57.77,*Default,NTP,0000,0000,0000,,Сәлем Хицугая
Dialogue: 0,0:50:58.41,0:51:02.19,*Default,NTP,0000,0000,0000,,Біз ұзақ жолдан өттік деп ойламайсыз ба?
Dialogue: 0,0:51:02.64,0:51:03.40,*Default,NTP,0000,0000,0000,,Айналма жол?
Dialogue: 0,0:51:04.82,0:51:06.61,*Default,NTP,0000,0000,0000,,Сіз жақсырақ білуіңіз керек
Dialogue: 0,0:51:07.47,0:51:10.23,*Default,NTP,0000,0000,0000,,Готей 13 корпусы қандай орын?
Dialogue: 0,0:51:11.81,0:51:15.12,*Default,NTP,0000,0000,0000,,Сонда да осы уақытқа дейін қалуыңыздың себебі неде?
Dialogue: 0,0:51:16.98,0:51:19.04,*Default,NTP,0000,0000,0000,,Бала күнгі бейкүнә дос?
Dialogue: 0,0:51:19.55,0:51:22.63,*Default,NTP,0000,0000,0000,,Хинаморидің әңгімесі жақсы. Патша мөрі қайда?
Dialogue: 0,0:51:24.56,0:51:26.41,*Default,NTP,0000,0000,0000,,Әрине, бұл жерде.
Dialogue: 0,0:51:27.03,0:51:30.39,*Default,NTP,0000,0000,0000,,Бұл біз армандарымыз үшін қолданатын нәрсе.
Dialogue: 0,0:51:32.83,0:51:33.47,*Default,NTP,0000,0000,0000,,Сіз жақсысыз ба?
Dialogue: 0,0:51:36.07,0:51:37.55,*Default,NTP,0000,0000,0000,,Патша мөрінің күші қандай?
Dialogue: 0,0:51:38.20,0:51:39.50,*Default,NTP,0000,0000,0000,,Неге олай істейсің?
Dialogue: 0,0:51:40.11,0:51:43.22,*Default,NTP,0000,0000,0000,,Дүрбелеңге салынбаңыз, оны жақын арада білесіз.
Dialogue: 0,0:51:44.88,0:51:46.36,*Default,NTP,0000,0000,0000,,Енді кеттік
Dialogue: 0,0:51:56.66,0:51:56.97,*Default,NTP,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:51:58.82,0:52:00.40,*Default,NTP,0000,0000,0000,,Рукия Бұл не?
Dialogue: 0,0:52:01.76,0:52:04.86,*Default,NTP,0000,0000,0000,,Мен білмеймін, бірақ бұл жай ғана реиацу емес.
Dialogue: 0,0:52:05.63,0:52:07.92,*Default,NTP,0000,0000,0000,,Таза және күшті нәрсе...
Dialogue: 0,0:52:09.07,0:52:09.52,*Default,NTP,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:52:12.34,0:52:15.05,*Default,NTP,0000,0000,0000,,Дұрыс, патша мөрінің күші.
Dialogue: 0,0:52:16.34,0:52:17.42,*Default,NTP,0000,0000,0000,,Ол басталады
Dialogue: 0,0:52:17.98,0:52:22.78,*Default,NTP,0000,0000,0000,,Лорд Сокан мен Тосиро Хицугаяның Сейрейтейден кек алуы
Dialogue: 0,0:52:23.38,0:52:24.95,*Default,NTP,0000,0000,0000,,Не! Сейрейтей
Dialogue: 0,0:52:25.65,0:52:27.03,*Default,NTP,0000,0000,0000,,Сіз қауіптісіз
Dialogue: 0,0:52:28.05,0:52:30.94,*Default,NTP,0000,0000,0000,,Ендеше мен не істесем де, мен сені осы жерде өлуіңді сұраймын.
Dialogue: 0,0:52:31.49,0:52:34.38,*Default,NTP,0000,0000,0000,,Мен саған Соқан-саманың жоспарына кедергі келтірмеймін.
Dialogue: 0,0:52:36.63,0:52:37.07,*Default,NTP,0000,0000,0000,,Жалған! ?
Dialogue: 0,0:52:37.47,0:52:39.05,*Default,NTP,0000,0000,0000,,Барыңдар, ақымақтар
Dialogue: 0,0:52:54.18,0:52:54.84,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:52:56.02,0:52:58.92,*Default,NTP,0000,0000,0000,,Биполярлы төбеде патша мөрі болып көрінетін Рейацу пайда болды
Dialogue: 0,0:53:02.66,0:53:03.19,*Default,NTP,0000,0000,0000,,Вице-капитан
Dialogue: 0,0:53:03.82,0:53:05.97,*Default,NTP,0000,0000,0000,,Колла, сендер шығып жатырсыңдар.
Dialogue: 0,0:53:09.63,0:53:10.86,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:53:12.83,0:53:13.39,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:53:15.20,0:53:15.94,*Default,NTP,0000,0000,0000,,Жедел хабаршы
Dialogue: 0,0:53:16.50,0:53:20.06,*Default,NTP,0000,0000,0000,,Осы дүниедегі және Жан қоғамындағы барлық іздеушілерге ескерту
Dialogue: 0,0:53:20.81,0:53:23.82,*Default,NTP,0000,0000,0000,,Биполярлық төбеде капитан Хицугая және
Dialogue: 0,0:53:24.21,0:53:26.76,*Default,NTP,0000,0000,0000,,Мөр басып алушы деп күдіктенген адамның рухани қысымын растаңыз
Dialogue: 0,0:53:27.45,0:53:30.24,*Default,NTP,0000,0000,0000,,Дереу оралыңыз және төтенше қорғанысқа дайындалыңыз.
Dialogue: 0,0:53:30.92,0:53:34.83,*Default,NTP,0000,0000,0000,,Қайталау: Дереу оралыңыз және төтенше қорғанысқа дайындалыңыз.
Dialogue: 0,0:53:36.69,0:53:38.97,*Default,NTP,0000,0000,0000,,Интрузияға оңай рұқсат беру
Dialogue: 0,0:53:40.06,0:53:45.47,*Default,NTP,0000,0000,0000,,Менің ойымша, жау Готей 13-тің қауіпсіздігі әлсіз екенін білді.
Dialogue: 0,0:53:46.10,0:53:46.64,*Default,NTP,0000,0000,0000,,Жау?
Dialogue: 0,0:53:48.17,0:53:50.20,*Default,NTP,0000,0000,0000,,Бұл капитан Хицугая.
Dialogue: 0,0:54:03.48,0:54:04.04,*Default,NTP,0000,0000,0000,,Бірақ істер осылай жалғаса берсе,
Dialogue: 0,0:54:05.12,0:54:07.41,*Default,NTP,0000,0000,0000,,Иә, бұл екі полярлы төбе.
Dialogue: 0,0:54:08.02,0:54:09.77,*Default,NTP,0000,0000,0000,,Бұл патша мөрінің күші
Dialogue: 0,0:54:10.52,0:54:14.39,*Default,NTP,0000,0000,0000,,Корольдік мөр кеңістік пен уақытқа қарамастан пайдаланушының еркіне байланысты.
Dialogue: 0,0:54:14.73,0:54:18.01,*Default,NTP,0000,0000,0000,,Барлық құбылыстарды басқа өлшемге ауыстыруға болады
Dialogue: 0,0:54:18.40,0:54:22.41,*Default,NTP,0000,0000,0000,,Басқаша айтқанда, егер сіз осы күшті пайдалансаңыз, сіз тек қазіргідей қозғала алмайсыз.
Dialogue: 0,0:54:22.74,0:54:25.75,*Default,NTP,0000,0000,0000,,Қарсыластың шабуылын басқа өлшемге ауыстыру
Dialogue: 0,0:54:26.04,0:54:30.48,*Default,NTP,0000,0000,0000,,Сондай-ақ, оның бұрынғы күйінде өлімге әкелетін жарақаттар болуы мүмкін.
Dialogue: 0,0:54:31.78,0:54:34.38,*Default,NTP,0000,0000,0000,,Соукан, онда сен
Dialogue: 0,0:54:35.85,0:54:37.81,*Default,NTP,0000,0000,0000,,Менің жаным жоғалып кете жаздады
Dialogue: 0,0:54:38.18,0:54:42.58,*Default,NTP,0000,0000,0000,,Маған тиген патша мөрінің жарығымен мен бос жерге көшіп, қайта дүниеге келдім.
Dialogue: 0,0:54:43.49,0:54:47.90,*Default,NTP,0000,0000,0000,,Содан бері мен осы патша мөрінің күшін іздеймін.
Dialogue: 0,0:54:48.76,0:54:51.33,*Default,NTP,0000,0000,0000,,Сейрейтейге оралу үшін.
Dialogue: 0,0:54:53.93,0:54:54.51,*Default,NTP,0000,0000,0000,,Тосиро
Dialogue: 0,0:54:57.97,0:55:01.27,*Default,NTP,0000,0000,0000,,Бұны кесіңіз. Сіздің Банкай оны кесіп алады.
Dialogue: 0,0:55:01.81,0:55:04.02,*Default,NTP,0000,0000,0000,,Кесу? король мөрі
Dialogue: 0,0:55:04.31,0:55:08.09,*Default,NTP,0000,0000,0000,,Әй, сонда бәрі тазарады.
Dialogue: 0,0:55:19.29,0:55:21.67,*Default,NTP,0000,0000,0000,,Біз бірінші болған сияқтымыз.
Dialogue: 0,0:55:21.93,0:55:23.36,*Default,NTP,0000,0000,0000,,Дұрыс, Иккаку.
Dialogue: 0,0:55:24.73,0:55:26.94,*Default,NTP,0000,0000,0000,,Капитан Хицугая, не болып жатыр?
Dialogue: 0,0:55:27.10,0:55:28.08,*Default,NTP,0000,0000,0000,,Тоқта, Ренжи
Dialogue: 0,0:55:29.27,0:55:31.58,*Default,NTP,0000,0000,0000,,Енді мұны айтудың мәні неде?
Dialogue: 0,0:55:32.97,0:55:35.39,*Default,NTP,0000,0000,0000,,Арнайы төтенше бұйрық және Император бұйрығымен
Dialogue: 0,0:55:35.97,0:55:38.86,*Default,NTP,0000,0000,0000,,Тосиро Хицугая мен итбалықты басып алу
Dialogue: 0,0:55:39.68,0:55:41.22,*Default,NTP,0000,0000,0000,,Иккаку Мадарама
Dialogue: 0,0:55:41.78,0:55:44.43,*Default,NTP,0000,0000,0000,,Керемет дене күші мен қылыш шеберлігі бар.
Dialogue: 0,0:55:44.58,0:55:47.18,*Default,NTP,0000,0000,0000,,Готей 13 корпусының ең жақсыларының бірі
Dialogue: 0,0:55:47.95,0:55:49.84,*Default,NTP,0000,0000,0000,,Мақтасам да ештеңе шықпайды.
Dialogue: 0,0:55:49.96,0:55:51.97,*Default,NTP,0000,0000,0000,,Бірақ сен менің жауым емессің.
Dialogue: 0,0:55:54.19,0:55:55.45,*Default,NTP,0000,0000,0000,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:56:00.70,0:56:04.04,*Default,NTP,0000,0000,0000,,Бұл жарақат сіздің ауыр екеніңізді білдіреді.
Dialogue: 0,0:56:04.47,0:56:07.73,*Default,NTP,0000,0000,0000,,Капитан Хицугая неге сонша?
Dialogue: 0,0:56:08.51,0:56:09.26,*Default,NTP,0000,0000,0000,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:56:16.78,0:56:17.84,*Default,NTP,0000,0000,0000,,Қандай сан
Dialogue: 0,0:56:20.09,0:56:20.93,*Default,NTP,0000,0000,0000,,Куросаки
Dialogue: 0,0:56:23.59,0:56:26.05,*Default,NTP,0000,0000,0000,,Менің ойымша, ол бірдеңе болған жағдайда сізге хабарлауға уәде берді.
Dialogue: 0,0:56:37.12,0:56:37.69,*Default,NTP,0000,0000,0000,,Қиял
Dialogue: 0,0:56:37.94,0:56:38.56,*Default,NTP,0000,0000,0000,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:56:38.90,0:56:42.25,*Default,NTP,0000,0000,0000,,Менің Джинрей Акуджакудың қатарынан түсірілімдер саны 1200.
Dialogue: 0,0:56:42.98,0:56:46.46,*Default,NTP,0000,0000,0000,,Бослықтың мұндай деңгейімен оны қанша етіп көрсетсең де, пайдасыз.
Dialogue: 0,0:56:47.21,0:56:48.51,*Default,NTP,0000,0000,0000,,Жарайды, Куросаки-кун.
Dialogue: 0,0:56:48.88,0:56:51.34,*Default,NTP,0000,0000,0000,,Теме Ишида, сен жеңсең не істейсің?
Dialogue: 0,0:56:51.78,0:56:54.27,*Default,NTP,0000,0000,0000,,Мен ондай ақымақтық жасамаймын.
Dialogue: 0,0:56:54.85,0:56:55.31,*Default,NTP,0000,0000,0000,,Мен келе жатырмын
Dialogue: 0,0:56:58.79,0:56:59.32,*Default,NTP,0000,0000,0000,,Үлкен
Dialogue: 0,0:57:00.19,0:57:02.05,*Default,NTP,0000,0000,0000,,Ишида Бұл менмін.
Dialogue: 0,0:57:03.74,0:57:05.05,*Default,NTP,0000,0000,0000,,тікелей
Dialogue: 0,0:57:16.38,0:57:17.54,*Default,NTP,0000,0000,0000,,Ичиго қазір үйде.
Dialogue: 0,0:57:18.48,0:57:20.09,*Default,NTP,0000,0000,0000,,Дереу Жан қоғамына барыңыз
Dialogue: 0,0:57:21.31,0:57:23.87,*Default,NTP,0000,0000,0000,,Урахара мырза ашылатын қақпаны дайындап жатыр.
Dialogue: 0,0:57:24.62,0:57:26.29,*Default,NTP,0000,0000,0000,,Оларды бізге қалдырыңыз.
Dialogue: 0,0:57:26.85,0:57:28.03,*Default,NTP,0000,0000,0000,,Тосиро-кунға көмектес
Dialogue: 0,0:57:30.16,0:57:32.96,*Default,NTP,0000,0000,0000,,Ей, балалар, кеттік, Руқия.
Dialogue: 0,0:57:34.16,0:57:35.44,*Default,NTP,0000,0000,0000,,Сау бол, Инуэ
Dialogue: 0,0:57:45.60,0:57:46.32,*Default,NTP,0000,0000,0000,,Осымен
Dialogue: 0,0:57:55.65,0:57:56.28,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:57:56.98,0:57:58.02,*Default,NTP,0000,0000,0000,,Бағыну, Хицугая.
Dialogue: 0,0:57:58.72,0:58:00.04,*Default,NTP,0000,0000,0000,,Менің артымдағы адам да.
Dialogue: 0,0:58:05.02,0:58:06.15,*Default,NTP,0000,0000,0000,,Күлуді тоқтатыңыз
Dialogue: 0,0:58:08.73,0:58:10.97,*Default,NTP,0000,0000,0000,,Бұл адам кім?
Dialogue: 0,0:58:11.56,0:58:14.67,*Default,NTP,0000,0000,0000,,Тосиро, сен не істеп жатырсың?
Dialogue: 0,0:58:15.23,0:58:18.55,*Default,NTP,0000,0000,0000,,Енді мына ақымақтарды еске түсірейік.
Dialogue: 0,0:58:19.14,0:58:22.74,*Default,NTP,0000,0000,0000,,Біздің ренішіміз, біздің қасіретіміз
Dialogue: 0,0:58:25.04,0:58:28.45,*Default,NTP,0000,0000,0000,,Бұл біздің кек алуымыз. Жүр, өлтір, Тосиро.
Dialogue: 0,0:58:30.18,0:58:30.97,*Default,NTP,0000,0000,0000,,Ұстау
Dialogue: 0,0:58:37.42,0:58:39.55,*Default,NTP,0000,0000,0000,,Гецуга Теншо
Dialogue: 0,0:58:47.60,0:58:48.01,*Default,NTP,0000,0000,0000,,Не!
Dialogue: 0,0:58:52.70,0:58:54.22,*Default,NTP,0000,0000,0000,,Тоқта
Dialogue: 0,0:58:54.84,0:58:57.76,*Default,NTP,0000,0000,0000,,Сіздің қолыңыздан келгеннің бәрі күресу.
Dialogue: 0,0:58:58.68,0:59:01.93,*Default,NTP,0000,0000,0000,,Тошироны өлтіруге қалай дәтің бар?
Dialogue: 0,0:59:02.45,0:59:06.13,*Default,NTP,0000,0000,0000,,Олай болса, бұл тапсырыс болғандықтан, сіз маған оңай шабуыл жасай аласыз дегенді білдірмейді.
Dialogue: 0,0:59:06.82,0:59:10.50,*Default,NTP,0000,0000,0000,,Тыныш, бұл гөтейден келген үлкен бұйрық.
Dialogue: 0,0:59:11.39,0:59:15.48,*Default,NTP,0000,0000,0000,,Біз үшін бастықтардың бұйрығына бағыну – бар күш-жігерімізбен орындауға тиісті норма.
Dialogue: 0,0:59:16.06,0:59:18.12,*Default,NTP,0000,0000,0000,,Ол мұны түсінбегенін айтты.
Dialogue: 0,0:59:18.46,0:59:19.41,*Default,NTP,0000,0000,0000,,Сұрақтар қойылмаған
Dialogue: 0,0:59:19.97,0:59:22.21,*Default,NTP,0000,0000,0000,,Одан әрі қарсылық көрсетсең, мен де сені өлтіремін.
Dialogue: 0,0:59:26.94,0:59:27.97,*Default,NTP,0000,0000,0000,,Күтіңіз
Dialogue: 0,0:59:38.45,0:59:41.35,*Default,NTP,0000,0000,0000,,Генрюсай Шигекуни Ямамото, Бас қолбасшы
Dialogue: 0,0:59:50.36,0:59:52.51,*Default,NTP,0000,0000,0000,,Кьёраку Байқадыңыз ба?
Dialogue: 0,0:59:53.60,0:59:54.54,*Default,NTP,0000,0000,0000,,Жақсы.
Dialogue: 0,0:59:55.27,0:59:58.47,*Default,NTP,0000,0000,0000,,Жазықсыз адамды жазалау жаман ой.
Dialogue: 0,1:00:01.74,1:00:05.17,*Default,NTP,0000,0000,0000,,Содзиро Сокан тірі болды ма?
Dialogue: 0,1:00:06.01,1:00:09.44,*Default,NTP,0000,0000,0000,,Мен оны өлтіруім керек еді...?
Dialogue: 0,1:00:13.29,1:00:16.43,*Default,NTP,0000,0000,0000,,Патша мөрі сізге қайтадан өмір сыйлайды
Dialogue: 0,1:00:16.99,1:00:20.65,*Default,NTP,0000,0000,0000,,Қиял патшалығы сені жаңадан көтерді ме?
Dialogue: 0,1:00:22.56,1:00:24.37,*Default,NTP,0000,0000,0000,,Мен қайтып келдім
Dialogue: 0,1:00:25.06,1:00:26.75,*Default,NTP,0000,0000,0000,,Өмірді патша мөрі алады.
Dialogue: 0,1:00:27.31,1:00:31.42,*Default,NTP,0000,0000,0000,,Және сол корольдік мөрді басқаратын Жан қоғамының патшасы ретінде.
Dialogue: 0,1:00:32.30,1:00:35.02,*Default,NTP,0000,0000,0000,,Жан қоғамының патшасы?
Dialogue: 0,1:00:35.57,1:00:36.89,*Default,NTP,0000,0000,0000,,Қандай құрметсіз
Dialogue: 0,1:00:39.02,1:00:42.44,*Default,NTP,0000,0000,0000,,Енді мыналарыңыз тәкаппарсыз.
Dialogue: 0,1:00:43.22,1:00:44.67,*Default,NTP,0000,0000,0000,,Есте сақта
Dialogue: 0,1:00:53.23,1:00:53.64,*Default,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,1:00:54.19,1:00:54.72,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,1:00:57.30,1:00:58.17,*Default,NTP,0000,0000,0000,,Мацумото келме
Dialogue: 0,1:00:59.36,1:01:01.02,*Default,NTP,0000,0000,0000,,Бұл менің күресім
Dialogue: 0,1:01:01.60,1:01:04.34,*Default,NTP,0000,0000,0000,,Нені айтып тұрсың, Тосиро?
Dialogue: 0,1:01:05.97,1:01:10.25,*Default,NTP,0000,0000,0000,,Әу бастан Темеге қосылу ойым болған жоқ.
Dialogue: 0,1:01:11.14,1:01:15.53,*Default,NTP,0000,0000,0000,,Готей 13-ге опасыздық жасамады ма?
Dialogue: 0,1:01:16.08,1:01:18.96,*Default,NTP,0000,0000,0000,,Онда неге бізге пышағыңды бұрдың?
Dialogue: 0,1:01:19.45,1:01:23.23,*Default,NTP,0000,0000,0000,,Мені өлтіресің бе? Мені тағы да өлтіресің бе?
Dialogue: 0,1:01:23.79,1:01:26.97,*Default,NTP,0000,0000,0000,,Менің күнәларымды өтеу ғана.
Dialogue: 0,1:01:27.73,1:01:29.18,*Default,NTP,0000,0000,0000,,Сенің қандай күнәң бар?
Dialogue: 0,1:01:29.73,1:01:31.89,*Default,NTP,0000,0000,0000,,Сіз мені өлтіру арқылы өтей аласыз ба?
Dialogue: 0,1:01:35.15,1:01:37.41,*Default,NTP,0000,0000,0000,,Қарасам, шөптен жасалған тәжі бастапқыда болған
Dialogue: 0,1:01:37.68,1:01:40.41,*Default,NTP,0000,0000,0000,,Жан қоғамына адалдыққа ант берген адам
Dialogue: 0,1:01:41.04,1:01:45.52,*Default,NTP,0000,0000,0000,,Екі бірдей Занпакутос болғандықтан.
Dialogue: 0,1:01:46.08,1:01:48.03,*Default,NTP,0000,0000,0000,,Намысты былай қойғанда, керісінше
Dialogue: 0,1:01:48.37,1:01:51.57,*Default,NTP,0000,0000,0000,,Соңында мені Жан қоғамы тазартты.
Dialogue: 0,1:01:53.47,1:01:56.26,*Default,NTP,0000,0000,0000,,Бәріне кінәлі деп ойлайды.
Dialogue: 0,1:01:57.26,1:01:59.72,*Default,NTP,0000,0000,0000,,Капитан Хицугая тағы да шөп тәжіне қарайды.
Dialogue: 0,1:02:00.09,1:02:03.64,*Default,NTP,0000,0000,0000,,Он үш Готей корпусында болған кезде өлтіру мүмкін емес
Dialogue: 0,1:02:04.76,1:02:05.58,*Default,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,1:02:06.70,1:02:09.09,*Default,NTP,0000,0000,0000,,Сонымен жанданған шатырда
Dialogue: 0,1:02:09.63,1:02:12.52,*Default,NTP,0000,0000,0000,,Ол Готей 13 капитаны лауазымынан бас тартты.
Dialogue: 0,1:02:13.07,1:02:15.18,*Default,NTP,0000,0000,0000,,Мәселені жалғыз шешуге тырысу
Dialogue: 0,1:02:16.14,1:02:20.27,*Default,NTP,0000,0000,0000,,Бұл жолы мені өлім жазасына кесетін болса да
Dialogue: 0,1:02:22.16,1:02:24.13,*Default,NTP,0000,0000,0000,,Сізде мен бармын
Dialogue: 0,1:02:24.82,1:02:25.55,*Default,NTP,0000,0000,0000,,Иә.
Dialogue: 0,1:02:26.62,1:02:30.11,*Default,NTP,0000,0000,0000,,Түсіндім, мен сізді қате бағаладым.
Dialogue: 0,1:02:35.29,1:02:37.38,*Default,NTP,0000,0000,0000,,Сонда мен оны өзім орындай аламын
Dialogue: 0,1:02:39.53,1:02:41.79,*Default,NTP,0000,0000,0000,,Маған Корольдік мөрге жауап беріңіз
Dialogue: 0,1:02:43.03,1:02:43.73,*Default,NTP,0000,0000,0000,,Не
Dialogue: 0,1:02:44.84,1:02:48.44,*Default,NTP,0000,0000,0000,,Банқайдың күшімен патша мөрін боса алмасам да.
Dialogue: 0,1:02:49.88,1:02:51.46,*Default,NTP,0000,0000,0000,,Бірақ қазір мен болсам
Dialogue: 0,1:03:05.31,1:03:07.79,*Default,NTP,0000,0000,0000,,Шөп тәжі!
Dialogue: 0,1:03:09.50,1:03:11.46,*Default,NTP,0000,0000,0000,,Жалғыз жапа шекпе
Dialogue: 0,1:03:12.01,1:03:13.23,*Default,NTP,0000,0000,0000,,Куросаки жолынан кет
Dialogue: 0,1:03:15.09,1:03:17.53,*Default,NTP,0000,0000,0000,,Барлығын жалғыз көтермеңіз.
Dialogue: 0,1:03:17.93,1:03:19.83,*Default,NTP,0000,0000,0000,,Сіздің азап пен шешіміңіз
Dialogue: 0,1:03:20.34,1:03:22.19,*Default,NTP,0000,0000,0000,,Достарыңыз қабылдасын.
Dialogue: 0,1:03:23.15,1:03:25.28,*Default,NTP,0000,0000,0000,,Мен енді капитан емеспін.
Dialogue: 0,1:03:28.71,1:03:30.47,*Default,NTP,0000,0000,0000,,Бәрін өз қолыңмен көтеру арқылы
Dialogue: 0,1:03:31.17,1:03:33.19,*Default,NTP,0000,0000,0000,,Айналаңыздағы адамдар не ойлайды?
Dialogue: 0,1:03:33.82,1:03:35.08,*Default,NTP,0000,0000,0000,,Сіз бұл туралы ойланып көрдіңіз бе?
Dialogue: 0,1:03:41.79,1:03:42.81,*Default,NTP,0000,0000,0000,,Сіз сияқты
Dialogue: 0,1:03:43.40,1:03:46.99,*Default,NTP,0000,0000,0000,,Мен басқаларға сене алмайтын адамдар туралы көп білемін.
Dialogue: 0,1:03:46.89,1:03:47.89,*Default,NTP,0000,0000,0000,,Үлкен аға
Dialogue: 0,1:03:52.94,1:03:53.94,*Default,NTP,0000,0000,0000,,Үлкен аға
Dialogue: 0,1:03:55.11,1:03:57.95,*Default,NTP,0000,0000,0000,,Юуко Нацури Неге сонша асығып тұрсың?
Dialogue: 0,1:04:02.95,1:04:05.81,*Default,NTP,0000,0000,0000,,Казу-нии, сен неге күлесің?
Dialogue: 0,1:04:07.15,1:04:08.31,*Default,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,1:04:16.03,1:04:21.05,*Default,NTP,0000,0000,0000,,Ичиго, сен өз сезіміңді бізбен бөлісе аласың ба?
Dialogue: 0,1:04:22.20,1:04:24.20,*Default,NTP,0000,0000,0000,,Біз отбасымыз, солай ма?
Dialogue: 0,1:04:26.77,1:04:31.13,*Default,NTP,0000,0000,0000,,Қуанышты да, мұңды да өзіңізге жасырмайды.
Dialogue: 0,1:04:32.51,1:04:35.90,*Default,NTP,0000,0000,0000,,Әйтпесе, біз жалғыз болмаймыз ба?
Dialogue: 0,1:04:45.92,1:04:49.77,*Default,NTP,0000,0000,0000,,Бірақ ақырында бұл ең әлсіз болды.
Dialogue: 0,1:04:55.37,1:04:56.08,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,1:04:58.84,1:04:59.86,*Default,NTP,0000,0000,0000,,Капитан Хицугая
Dialogue: 0,1:05:00.11,1:05:00.71,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,1:05:09.45,1:05:10.16,*Default,NTP,0000,0000,0000,,Тосиро
Dialogue: 0,1:05:10.52,1:05:12.85,*Default,NTP,0000,0000,0000,,Дайында, Куросаки, ол келе жатыр.
Dialogue: 0,1:05:35.27,1:05:39.32,*Default,NTP,0000,0000,0000,,Мен оны ақыры түсіндім. Бұл патша мөрінің күші ме?
Dialogue: 0,1:05:49.22,1:05:49.86,*Default,NTP,0000,0000,0000,,Кенпачи
Dialogue: 0,1:06:04.28,1:06:05.14,*Default,NTP,0000,0000,0000,,Бітті ме?
Dialogue: 0,1:06:05.74,1:06:06.55,*Default,NTP,0000,0000,0000,,Мен көрмеймін...
Dialogue: 0,1:06:10.34,1:06:10.75,*Default,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,1:06:19.45,1:06:23.03,*Default,NTP,0000,0000,0000,,Сіздің шабуылдарыңыз маған әсер етпейді.
Dialogue: 0,1:06:26.42,1:06:29.34,*Default,NTP,0000,0000,0000,,Сіз әлі шаршаған жоқсыз ба? Бұл қызық.
Dialogue: 0,1:06:37.10,1:06:38.09,*Default,NTP,0000,0000,0000,,Түсіндім
Dialogue: 0,1:06:38.94,1:06:39.72,*Default,NTP,0000,0000,0000,,Сіз Титантардың бір-бірімен шайқасып жатқанын айтасыз ба?
Dialogue: 0,1:06:47.31,1:06:48.35,*Default,NTP,0000,0000,0000,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,1:07:24.35,1:07:28.15,*Default,NTP,0000,0000,0000,,Ұлы, ұлы күш.
Dialogue: 0,1:07:32.46,1:07:33.00,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,1:07:33.69,1:07:35.71,*Default,NTP,0000,0000,0000,,Бұл шөп тәжі.
Dialogue: 0,1:07:38.70,1:07:40.54,*Default,NTP,0000,0000,0000,,Бұл көрініске не болды?
Dialogue: 0,1:07:41.40,1:07:43.41,*Default,NTP,0000,0000,0000,,Сіз шынымен қашып кеттіңіз бе?
Dialogue: 0,1:07:44.20,1:07:45.41,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:07:46.40,1:07:47.46,*Default,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,1:07:49.34,1:07:49.67,*Default,NTP,0000,0000,0000,,қаңтар
Dialogue: 0,1:07:58.05,1:07:59.57,*Default,NTP,0000,0000,0000,,Ол әлі өзгере ме?
Dialogue: 0,1:08:27.78,1:08:29.26,*Default,NTP,0000,0000,0000,,Қорықпа
Dialogue: 0,1:08:29.95,1:08:31.23,*Default,NTP,0000,0000,0000,,Шегінуге болмайды
Dialogue: 0,1:08:31.78,1:08:35.04,*Default,NTP,0000,0000,0000,,Қылмыскер Содзиро Соканды кесіңіз
Dialogue: 0,1:08:44.63,1:08:45.15,*Default,NTP,0000,0000,0000,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,1:08:45.70,1:08:46.13,*Default,NTP,0000,0000,0000,,Ичиго
Dialogue: 0,1:08:52.14,1:08:52.55,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,1:08:57.75,1:08:59.55,*Default,NTP,0000,0000,0000,,Шашылған Сенбонзакура
Dialogue: 0,1:09:05.00,1:09:07.43,*Default,NTP,0000,0000,0000,,Арқыл Джаомару
Dialogue: 0,1:09:23.03,1:09:24.40,*Default,NTP,0000,0000,0000,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,1:09:39.75,1:09:40.86,*Default,NTP,0000,0000,0000,,Сен шынымен де тамаша ФБР агенті болдың.
Dialogue: 0,1:09:42.02,1:09:43.74,*Default,NTP,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,1:09:44.46,1:09:46.91,*Default,NTP,0000,0000,0000,,Патша мөрі өзінің барлық билігін босатып жіберді ме?
Dialogue: 0,1:09:47.46,1:09:50.71,*Default,NTP,0000,0000,0000,,Жоқ, бұл патша итбалығы жабайы жүгіреді.
Dialogue: 0,1:09:51.26,1:09:51.78,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,1:09:52.90,1:09:56.65,*Default,NTP,0000,0000,0000,,Қараңызшы, рухани қысым күшейіп, таралып жатыр.
Dialogue: 0,1:09:57.20,1:09:59.66,*Default,NTP,0000,0000,0000,,Бұлай жалғаса берсе, Сейрейтейді қамтымақ.
Dialogue: 0,1:09:59.80,1:10:01.92,*Default,NTP,0000,0000,0000,,Ол бәрін жоюы мүмкін
Dialogue: 0,1:10:02.67,1:10:03.71,*Default,NTP,0000,0000,0000,,Жою?
Dialogue: 0,1:10:04.28,1:10:07.42,*Default,NTP,0000,0000,0000,,Рейатсу керемет екені рас, бірақ мұндай нәрсе...
Dialogue: 0,1:10:08.28,1:10:10.21,*Default,NTP,0000,0000,0000,,Патша мөрі дегеніміз не? Шығарылуы бойынша
Dialogue: 0,1:10:10.62,1:10:14.23,*Default,NTP,0000,0000,0000,,Шектеулі орындардағы уақыттық және кеңістіктік өлшемдер
Dialogue: 0,1:10:14.79,1:10:18.64,*Default,NTP,0000,0000,0000,,Бұл барлық құбылыстарды манипуляциялай алатын қасиетті қазына.
Dialogue: 0,1:10:19.49,1:10:22.70,*Default,NTP,0000,0000,0000,,, яғни сол шектеулі аймақта
Dialogue: 0,1:10:23.19,1:10:25.84,*Default,NTP,0000,0000,0000,,Құдайдың күшімен бірдей күшке ие боласыз.
Dialogue: 0,1:10:26.40,1:10:29.10,*Default,NTP,0000,0000,0000,,Өшіру және қайта шығару оңай нәрсе.
Dialogue: 0,1:10:31.24,1:10:34.49,*Default,NTP,0000,0000,0000,,Мен Соуқан қылышпен Банкайды үйренбедім.
Dialogue: 0,1:10:34.67,1:10:37.14,*Default,NTP,0000,0000,0000,,Оны бақылау мүмкін емес, яғни
Dialogue: 0,1:10:37.44,1:10:40.05,*Default,NTP,0000,0000,0000,,Бұл ең қиын жағдай.
Dialogue: 0,1:11:01.80,1:11:02.47,*Default,NTP,0000,0000,0000,,Мацумото
Dialogue: 0,1:11:03.20,1:11:04.00,*Default,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,1:11:08.64,1:11:09.21,*Default,NTP,0000,0000,0000,,Мацумото
Dialogue: 0,1:11:10.84,1:11:14.62,*Default,NTP,0000,0000,0000,,Капитанның арқасын қорғау вице-капитанның міндеті.
Dialogue: 0,1:11:17.30,1:11:19.63,*Default,NTP,0000,0000,0000,,Амансың ба? Рукия
Dialogue: 0,1:11:21.29,1:11:22.02,*Default,NTP,0000,0000,0000,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,1:11:24.13,1:11:26.72,*Default,NTP,0000,0000,0000,,Тосиро, бәрің аман болдыңдар ма?
Dialogue: 0,1:11:28.16,1:11:29.41,*Default,NTP,0000,0000,0000,,Рукия Ичиго
Dialogue: 0,1:11:30.43,1:11:31.45,*Default,NTP,0000,0000,0000,,Ренжи, не болды?
Dialogue: 0,1:11:32.00,1:11:35.24,*Default,NTP,0000,0000,0000,,Не болды? Айналаңызға мұқият қараңыз.
Dialogue: 0,1:11:36.43,1:11:36.63,*Default,NTP,0000,0000,0000,,На
Dialogue: 0,1:11:40.67,1:11:42.55,*Default,NTP,0000,0000,0000,,Ол шөп тәжіндегі құлып деп аталады.
Dialogue: 0,1:11:43.11,1:11:46.92,*Default,NTP,0000,0000,0000,,Қараңызшы, біз сол рухани қабырғаның ішінде қамалып қалдық.
Dialogue: 0,1:11:47.88,1:11:48.81,*Default,NTP,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,1:11:49.18,1:11:50.64,*Default,NTP,0000,0000,0000,,Мен түсіндім бе?
Dialogue: 0,1:11:53.18,1:11:53.63,*Default,NTP,0000,0000,0000,,Ичиго
Dialogue: 0,1:11:54.19,1:11:54.84,*Default,NTP,0000,0000,0000,,Йоруичи-сан
Dialogue: 0,1:11:56.09,1:11:57.76,*Default,NTP,0000,0000,0000,,Жағдайдың мәні бар.
Dialogue: 0,1:11:58.49,1:12:01.75,*Default,NTP,0000,0000,0000,,Бас қолбасшы бұл кеңістіктің кеңеюін басып отыр.
Dialogue: 0,1:12:02.56,1:12:05.05,*Default,NTP,0000,0000,0000,,Осы арада бізге шөп тәжін кесу бұйырылды.
Dialogue: 0,1:12:06.13,1:12:07.17,*Default,NTP,0000,0000,0000,,Бірақ қалай?
Dialogue: 0,1:12:07.73,1:12:09.44,*Default,NTP,0000,0000,0000,,Аяқтарыңызбен өрмелеңіз.
Dialogue: 0,1:12:11.17,1:12:13.85,*Default,NTP,0000,0000,0000,,Ал орталық мұнараны қиюдан басқа амалымыз жоқ.
Dialogue: 0,1:12:16.24,1:12:19.30,*Default,NTP,0000,0000,0000,,Жүр, енді ол қозғалысты тоқтатты.
Dialogue: 0,1:12:20.01,1:12:20.43,*Default,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,1:12:20.91,1:12:23.53,*Default,NTP,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,1:12:24.45,1:12:25.83,*Default,NTP,0000,0000,0000,,Бұл ерекше фестиваль.
Dialogue: 0,1:12:26.38,1:12:28.34,*Default,NTP,0000,0000,0000,,Мен де қосылайын ба?
Dialogue: 0,1:12:28.99,1:12:30.16,*Default,NTP,0000,0000,0000,,Әрине мен де.
Dialogue: 0,1:12:34.39,1:12:35.34,*Default,NTP,0000,0000,0000,,Бұл басталды ма?
Dialogue: 0,1:12:39.63,1:12:40.40,*Default,NTP,0000,0000,0000,,Егер ол жалған болса
Dialogue: 0,1:12:42.53,1:12:44.63,*Default,NTP,0000,0000,0000,,Уайымдама, мұны бізге қалдыр.
Dialogue: 0,1:12:45.97,1:12:46.70,*Default,NTP,0000,0000,0000,,Йоруичи-сан
Dialogue: 0,1:12:47.24,1:12:48.19,*Default,NTP,0000,0000,0000,,Кеттік!
Dialogue: 0,1:12:49.71,1:12:50.37,*Default,NTP,0000,0000,0000,,Шуннан
Dialogue: 0,1:13:08.83,1:13:10.28,*Default,NTP,0000,0000,0000,,Біз шыңға ұмтыламыз
Dialogue: 0,1:13:12.50,1:13:13.04,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,1:13:15.07,1:13:15.64,*Default,NTP,0000,0000,0000,,Ууух!
Dialogue: 0,1:13:34.22,1:13:34.74,*Default,NTP,0000,0000,0000,,Мацумото
Dialogue: 0,1:13:35.29,1:13:35.67,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:13:37.52,1:13:38.44,*Default,NTP,0000,0000,0000,,Көмек сұрау
Dialogue: 0,1:13:39.66,1:13:40.07,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:13:47.87,1:13:48.85,*Default,NTP,0000,0000,0000,,Екіге бөлейік
Dialogue: 0,1:13:49.57,1:13:51.61,*Default,NTP,0000,0000,0000,,Жарайды, кеттік Ренжи Рукия
Dialogue: 0,1:13:53.10,1:13:54.71,*Default,NTP,0000,0000,0000,,Мен тағы да сендермен біргемін.
Dialogue: 0,1:13:55.11,1:13:56.29,*Default,NTP,0000,0000,0000,,Тітіркендіргіш
Dialogue: 0,1:14:02.37,1:14:02.90,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,1:14:07.22,1:14:07.96,*Default,NTP,0000,0000,0000,,Бұл әйел?
Dialogue: 0,1:14:08.22,1:14:08.87,*Default,NTP,0000,0000,0000,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,1:14:09.38,1:14:11.54,*Default,NTP,0000,0000,0000,,Үрген Джаомару
Dialogue: 0,1:14:19.00,1:14:19.64,*Default,NTP,0000,0000,0000,,Ренжи
Dialogue: 0,1:14:24.20,1:14:25.22,*Default,NTP,0000,0000,0000,,Банкай
Dialogue: 0,1:14:28.91,1:14:31.44,*Default,NTP,0000,0000,0000,,Бокуджабимару патша
Dialogue: 0,1:14:35.28,1:14:37.48,*Default,NTP,0000,0000,0000,,Мен жүгірсем де, ол жұмыс істемейді
Dialogue: 0,1:14:38.25,1:14:40.60,*Default,NTP,0000,0000,0000,,Джаомаруды тірек ретінде пайдаланып, жоғарыға шығыңыз.
Dialogue: 0,1:14:40.85,1:14:41.33,*Default,NTP,0000,0000,0000,,Түсіндім
Dialogue: 0,1:14:52.53,1:14:53.01,*Default,NTP,0000,0000,0000,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,1:15:17.66,1:15:19.07,*Default,NTP,0000,0000,0000,,Араны қазір қиратыңыз
Dialogue: 0,1:15:19.62,1:15:20.45,*Default,NTP,0000,0000,0000,,Оны маған қалдырыңыз
Dialogue: 0,1:15:24.60,1:15:27.03,*Default,NTP,0000,0000,0000,,Жауларды құрту, Торғай ара
Dialogue: 0,1:15:28.33,1:15:29.34,*Default,NTP,0000,0000,0000,,Нигеки Кессацу
Dialogue: 0,1:15:34.67,1:15:35.22,*Default,NTP,0000,0000,0000,,Сіз мұны жасадыңыз ба?
Dialogue: 0,1:15:47.92,1:15:49.24,*Default,NTP,0000,0000,0000,,Өте жылдам ойнату
Dialogue: 0,1:15:57.03,1:15:57.51,*Default,NTP,0000,0000,0000,,Мацумото
Dialogue: 0,1:16:07.74,1:16:09.35,*Default,NTP,0000,0000,0000,,Мына құбыжық қозғала ма?
Dialogue: 0,1:16:09.94,1:16:11.42,*Default,NTP,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,1:16:12.48,1:16:13.70,*Default,NTP,0000,0000,0000,,Бұл реятсу
Dialogue: 0,1:16:22.02,1:16:23.04,*Default,NTP,0000,0000,0000,,Бұл қызық.
Dialogue: 0,1:16:28.36,1:16:29.13,*Default,NTP,0000,0000,0000,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,1:16:30.83,1:16:31.94,*Default,NTP,0000,0000,0000,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,1:16:32.96,1:16:33.55,*Default,NTP,0000,0000,0000,,Жоғары қарай асығыңыз
Dialogue: 0,1:16:49.28,1:16:49.68,*Default,NTP,0000,0000,0000,,Қазір
Dialogue: 0,1:17:09.10,1:17:11.37,*Default,NTP,0000,0000,0000,,Олар Ұлы қуысты да басқара ала ма?
Dialogue: 0,1:17:21.38,1:17:22.28,*Default,NTP,0000,0000,0000,,Банкай
Dialogue: 0,1:17:33.07,1:17:33.69,*Default,NTP,0000,0000,0000,,Хайнеко
Dialogue: 0,1:17:37.99,1:17:39.03,*Default,NTP,0000,0000,0000,,Аз ғана уақыт қалды
Dialogue: 0,1:17:39.56,1:17:41.03,*Default,NTP,0000,0000,0000,,Біз бұл жерден қандай да бір жолмен өтуіміз керек.
Dialogue: 0,1:17:43.87,1:17:45.74,*Default,NTP,0000,0000,0000,,Май Соде Шираюки
Dialogue: 0,1:17:46.90,1:17:47.54,*Default,NTP,0000,0000,0000,,Келесі би
Dialogue: 0,1:17:54.71,1:17:55.34,*Default,NTP,0000,0000,0000,,Хакурен
Dialogue: 0,1:18:18.54,1:18:19.22,*Default,NTP,0000,0000,0000,,Рух толқындарын қолдануды да ұмытып кеткенмін
Dialogue: 0,1:18:19.64,1:18:20.15,*Default,NTP,0000,0000,0000,,Ичиго
Dialogue: 0,1:18:21.91,1:18:23.86,*Default,NTP,0000,0000,0000,,Ичиго Мен бұл мұнараны көріп тұрмын.
Dialogue: 0,1:18:26.54,1:18:29.60,*Default,NTP,0000,0000,0000,,Бір сәт болса да осы жерден шыңға жол ашсам
Dialogue: 0,1:18:29.95,1:18:32.26,*Default,NTP,0000,0000,0000,,Тенчейн Зангецу жылдамдығымен оған бірден жете аласыз ба?
Dialogue: 0,1:18:32.83,1:18:33.47,*Default,NTP,0000,0000,0000,,Тіпті қазір де жағдай осылай,
Dialogue: 0,1:18:34.19,1:18:35.20,*Default,NTP,0000,0000,0000,,Мұның бәрі бар
Dialogue: 0,1:18:35.95,1:18:38.90,*Default,NTP,0000,0000,0000,,Менің, Иккаку мен Юмичиканың күшін біріктірсек,
Dialogue: 0,1:18:39.11,1:18:41.50,*Default,NTP,0000,0000,0000,,Сіз тіпті бір сәтте жол жасай алуыңыз керек.
Dialogue: 0,1:18:41.96,1:18:42.41,*Default,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,1:18:42.96,1:18:44.47,*Default,NTP,0000,0000,0000,,Мен бұл туралы естідім
Dialogue: 0,1:18:45.00,1:18:45.88,*Default,NTP,0000,0000,0000,,Бірақ Мацумото
Dialogue: 0,1:18:46.46,1:18:48.87,*Default,NTP,0000,0000,0000,,Кешіріңіз, бірақ мен ғана жол жасай аламын.
Dialogue: 0,1:18:52.30,1:18:53.55,*Default,NTP,0000,0000,0000,,Сіз мұны істегіңіз келе ме? Иккаку
Dialogue: 0,1:18:55.74,1:18:57.15,*Default,NTP,0000,0000,0000,,Капитан Хицугая Мацумото
Dialogue: 0,1:18:57.71,1:18:59.66,*Default,NTP,0000,0000,0000,,Барлығынан құпия сақтаңыз.
Dialogue: 0,1:19:00.41,1:19:01.93,*Default,NTP,0000,0000,0000,,Банкай
Dialogue: 0,1:19:18.06,1:19:20.74,*Default,NTP,0000,0000,0000,,Айдаһар шыңы Хозукимару
Dialogue: 0,1:19:34.68,1:19:36.71,*Default,NTP,0000,0000,0000,,Бірінші би Цукихаку
Dialogue: 0,1:19:50.43,1:19:51.17,*Default,NTP,0000,0000,0000,,Рух толқындарын қолдануды да ұмытып кеткенмін
Dialogue: 0,1:19:52.10,1:19:52.48,*Default,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,1:19:57.15,1:19:57.66,*Default,NTP,0000,0000,0000,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,1:20:11.42,1:20:12.43,*Default,NTP,0000,0000,0000,,Сақтығыңызды түсірмеңіз
Dialogue: 0,1:20:12.98,1:20:13.46,*Default,NTP,0000,0000,0000,,Бякуя
Dialogue: 0,1:20:13.78,1:20:16.57,*Default,NTP,0000,0000,0000,,Сырттағы командирлерді ауыртпалықты көтеруге мәжбүрлейді.
Dialogue: 0,1:20:26.46,1:20:29.28,*Default,NTP,0000,0000,0000,,Ичиго Куросаки, асығыңыз
Dialogue: 0,1:20:31.57,1:20:31.96,*Default,NTP,0000,0000,0000,,Ренжи
Dialogue: 0,1:20:35.37,1:20:38.92,*Default,NTP,0000,0000,0000,,Сенбонзакура Кейгонның көрінісі
Dialogue: 0,1:20:48.25,1:20:50.59,*Default,NTP,0000,0000,0000,,Ұзын сүйекті зеңбірек
Dialogue: 0,1:21:32.70,1:21:35.40,*Default,NTP,0000,0000,0000,,Дайгурэн Хёринмару
Dialogue: 0,1:22:07.73,1:22:09.81,*Default,NTP,0000,0000,0000,,Гецуга Теншо
Dialogue: 0,1:22:21.31,1:22:21.73,*Default,NTP,0000,0000,0000,,Ичиго
Dialogue: 0,1:22:46.84,1:22:48.59,*Default,NTP,0000,0000,0000,,Сен мұны істедің бе, Ичиго?
Dialogue: 0,1:23:17.13,1:23:18.65,*Default,NTP,0000,0000,0000,,Бар, Тосиро
Dialogue: 0,1:23:26.65,1:23:27.55,*Default,NTP,0000,0000,0000,,Хицугая
Dialogue: 0,1:23:29.15,1:23:30.23,*Default,NTP,0000,0000,0000,,Басталған сәт
Dialogue: 0,1:23:34.75,1:23:36.43,*Default,NTP,0000,0000,0000,,Ах, дұрыс.
Dialogue: 0,1:23:57.61,1:23:59.35,*Default,NTP,0000,0000,0000,,Бізге екі Шинигами керек емес
Dialogue: 0,1:24:00.36,1:24:01.66,*Default,NTP,0000,0000,0000,,Таңдау керек
Dialogue: 0,1:24:03.58,1:24:04.15,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,1:24:04.19,1:24:04.85,*Default,NTP,0000,0000,0000,,Рұқсат етілмейді
Dialogue: 0,1:24:04.87,1:24:08.65,*Default,NTP,0000,0000,0000,,Өтінемін, осы жерде қалыңыз.
Dialogue: 0,1:24:08.79,1:24:09.34,*Default,NTP,0000,0000,0000,,Хицугая
Dialogue: 0,1:24:10.58,1:24:12.45,*Default,NTP,0000,0000,0000,,Мен Хёринмаруды қалаймын
Dialogue: 0,1:24:12.59,1:24:13.78,*Default,NTP,0000,0000,0000,,Шөп тәжі Менмін
Dialogue: 0,1:24:42.85,1:24:46.05,*Default,NTP,0000,0000,0000,,Сен данышпансың ғой.
Dialogue: 0,1:24:47.06,1:24:49.97,*Default,NTP,0000,0000,0000,,Сіз мені екі рет өлтірмек болдыңыз.
Dialogue: 0,1:24:53.13,1:24:54.99,*Default,NTP,0000,0000,0000,,Бірақ мен өлген жоқпын.
Dialogue: 0,1:24:56.10,1:24:58.79,*Default,NTP,0000,0000,0000,,Мен, менің болмысым...
Dialogue: 0,1:25:02.21,1:25:02.76,*Default,NTP,0000,0000,0000,,Шөп тәжі
Dialogue: 0,1:25:04.54,1:25:08.07,*Default,NTP,0000,0000,0000,,Біз әрқашан дос болдық...
Dialogue: 0,1:25:11.12,1:25:13.03,*Default,NTP,0000,0000,0000,,Егер мен...
Dialogue: 0,1:25:20.52,1:25:21.81,*Default,NTP,0000,0000,0000,,Мүмкін...
Dialogue: 0,1:25:36.03,1:25:37.44,*Default,NTP,0000,0000,0000,,Біткен сияқты.
Dialogue: 0,1:25:38.24,1:25:38.88,*Default,NTP,0000,0000,0000,,Аға
Dialogue: 0,1:25:44.45,1:25:44.79,*Default,NTP,0000,0000,0000,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,1:25:46.22,1:25:47.64,*Default,NTP,0000,0000,0000,,Кім жеңді?
Dialogue: 0,1:25:48.15,1:25:48.96,*Default,NTP,0000,0000,0000,,Сен ақымақсың.
Dialogue: 0,1:25:51.26,1:25:52.37,*Default,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,1:26:19.15,1:26:21.12,*Default,NTP,0000,0000,0000,,Мұндай кішкентай нәрсе
Dialogue: 0,1:26:33.03,1:26:34.88,*Default,NTP,0000,0000,0000,,Рахмет сізге Куросаки
Dialogue: 0,1:26:37.30,1:26:40.53,*Default,NTP,0000,0000,0000,,Ол өкінбейді деп үміттенемін.
Dialogue: 0,1:26:43.27,1:26:45.43,*Default,NTP,0000,0000,0000,,Ақырында, мен сендермен мәселені шешіп алдым.
Dialogue: 0,1:26:48.61,1:26:49.27,*Default,NTP,0000,0000,0000,,Тірі болсаң
Dialogue: 0,1:26:50.21,1:26:52.19,*Default,NTP,0000,0000,0000,,Әр адамның өзі келіспейтін нәрселері болады.
Dialogue: 0,1:26:53.28,1:26:57.53,*Default,NTP,0000,0000,0000,,Бірақ оны орындау немесе ұстанбау өз еркіңізде.
Dialogue: 0,1:27:00.62,1:27:03.67,*Default,NTP,0000,0000,0000,,Өмірге қайта келген адам мұнда өз шешімімен келген.
Dialogue: 0,1:27:04.70,1:27:06.31,*Default,NTP,0000,0000,0000,,Бұл біреу шешетін ойын емес.
Dialogue: 0,1:27:07.46,1:27:09.44,*Default,NTP,0000,0000,0000,,Мәселені өзім шешу үшін.
Dialogue: 0,1:27:11.34,1:27:14.08,*Default,NTP,0000,0000,0000,,Сондықтан бұл жақсы нәрсе деп ойлаймын.
Dialogue: 0,1:27:15.51,1:27:18.97,*Default,NTP,0000,0000,0000,,Жарайды, саған рахмет, мынау әбігер болды.
Dialogue: 0,1:27:24.98,1:27:26.40,*Default,NTP,0000,0000,0000,,Қайтейік, Тосиро
Dialogue: 0,1:27:33.60,1:27:37.32,*Default,NTP,0000,0000,0000,,Бұл Тосиро емес, капитан Хицугая.
Dialogue: 0,1:27:39.21,1:27:39.94,*Default,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,1:31:57.32,1:31:57.84,*Default,NTP,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,1:31:59.82,1:32:00.33,*Default,NTP,0000,0000,0000,,Мацумото
Dialogue: 0,1:32:02.50,1:32:05.37,*Default,NTP,0000,0000,0000,,Көп нәрсе орындалмай қалды, рахмет.
Dialogue: 0,1:32:06.58,1:32:07.83,*Default,NTP,0000,0000,0000,,Капитан, сіз жаңа ғана не айттыңыз?
Dialogue: 0,1:32:08.19,1:32:10.42,*Default,NTP,0000,0000,0000,,Мен ештеңе айтқан жоқпын. Қазір қайттып келемін.
Dialogue: 0,1:32:11.26,1:32:12.56,*Default,NTP,0000,0000,0000,,Сіз мұны істейсіз бе?
Dialogue: 0,1:32:12.81,1:32:14.58,*Default,NTP,0000,0000,0000,,Бүгін жұмысты доғарайық.
Dialogue: 0,1:32:14.86,1:32:17.53,*Default,NTP,0000,0000,0000,,Сонымен қатар, бұл жерде жақсы ыстық бұлақ бар.
Dialogue: 0,1:32:17.58,1:32:18.70,*Default,NTP,0000,0000,0000,,Тек сіз бара аласыз
Dialogue: 0,1:32:18.75,1:32:21.14,*Default,NTP,0000,0000,0000,,Олай айтпа, иә?
Dialogue: 0,1:32:22.05,1:32:22.35,*Default,NTP,0000,0000,0000,,Colla
Dialogue: 0,1:28:03.12,1:28:06.02,JP_ED,NTP,0000,0000,0000,,Сіз өзгерткен түймені алып тастасаңыз да
Dialogue: 0,1:28:08.32,1:28:12.25,JP_ED,NTP,0000,0000,0000,,Біз үшін ештеңе өзгермейді.
Dialogue: 0,1:28:13.52,1:28:16.71,JP_ED,NTP,0000,0000,0000,,Біз мұнда мәңгілік, тек армандадық
Dialogue: 0,1:28:18.69,1:28:23.10,JP_ED,NTP,0000,0000,0000,,Мен ештеңе істемейтіндей ебедейсіз емеспін.
Dialogue: 0,1:28:23.95,1:28:28.51,JP_ED,NTP,0000,0000,0000,,Осы уақытқа дейін мен жоғалтқан нәрселер
Dialogue: 0,1:28:28.78,1:28:33.60,JP_ED,NTP,0000,0000,0000,,Сіз нені көргіңіз келеді
Dialogue: 0,1:28:33.94,1:28:38.47,JP_ED,NTP,0000,0000,0000,,Егер сіз бәрін ауыстырсаңыз
Dialogue: 0,1:28:38.62,1:28:43.97,JP_ED,NTP,0000,0000,0000,,Мен өзгерте аламын ба деп ойлаймын. Мен өзгере аламын ба деп ойлаймын.
Dialogue: 0,1:28:44.59,1:28:49.28,JP_ED,NTP,0000,0000,0000,,Осы уақытқа дейін сізді жылатып келген нәрселерді ұялшақ сөздермен айтыңыз.
Dialogue: 0,1:28:49.40,1:28:54.74,JP_ED,NTP,0000,0000,0000,,Жүрегімнің қара түнегін сүрт
Dialogue: 0,1:28:54.97,1:28:59.80,JP_ED,NTP,0000,0000,0000,,Бір күні мен сені тастағым келеді, мен сені жақын алғым келеді
Dialogue: 0,1:28:59.88,1:29:08.66,JP_ED,NTP,0000,0000,0000,,Бұл тамырлар арқылы тілек ағады
Dialogue: 0,1:29:15.79,1:29:18.72,JP_ED,NTP,0000,0000,0000,,Айдалада түс көрсем де
Dialogue: 0,1:29:20.96,1:29:24.81,JP_ED,NTP,0000,0000,0000,,Сіз олардың қаншалықты жасырын екенін көре алмайсыз.
Dialogue: 0,1:29:26.27,1:29:29.49,JP_ED,NTP,0000,0000,0000,,Көз жасын төгіп, мәңгілік осында болдық.
Dialogue: 0,1:29:31.31,1:29:35.63,JP_ED,NTP,0000,0000,0000,,Мен өзімді кінәлайтындай әлсіз емеспін.
Dialogue: 0,1:29:36.47,1:29:41.24,JP_ED,NTP,0000,0000,0000,,Осы уақытқа дейін естігендеріңіз
Dialogue: 0,1:29:41.52,1:29:46.46,JP_ED,NTP,0000,0000,0000,,Еске түсіретін ән
Dialogue: 0,1:29:46.79,1:29:51.27,JP_ED,NTP,0000,0000,0000,,Таңға дейін ән айтсам
Dialogue: 0,1:29:51.46,1:29:56.77,JP_ED,NTP,0000,0000,0000,,Мен сені кешіре аламын ба? Қызық, мені кешіре аласың ба?
Dialogue: 0,1:29:57.43,1:30:02.16,JP_ED,NTP,0000,0000,0000,,Бұдан былай мен ән саламын, мұздаған жүрегімді еріт.
Dialogue: 0,1:30:02.31,1:30:07.75,JP_ED,NTP,0000,0000,0000,,Қап-қара дірілдеген түн сүртілді
Dialogue: 0,1:30:08.01,1:30:12.63,JP_ED,NTP,0000,0000,0000,,Түніміз лас болса, мен ешкімге сене алмаймын.
Dialogue: 0,1:30:12.75,1:30:21.30,JP_ED,NTP,0000,0000,0000,,Бұл тыныштықты қалау бұзады
Dialogue: 0,1:30:29.93,1:30:31.75,JP_ED,NTP,0000,0000,0000,,Ұлдар мен қыздар
Dialogue: 0,1:30:32.64,1:30:34.25,JP_ED,NTP,0000,0000,0000,,Жастар Бакусу
Dialogue: 0,1:30:36.45,1:30:39.15,JP_ED,NTP,0000,0000,0000,,Маған сен туралы ойлауға рұқсат ет
Dialogue: 0,1:30:39.28,1:30:43.95,JP_ED,NTP,0000,0000,0000,,Осы уақытқа дейін сізді жылатып келген нәрселерді ұялшақ сөздермен айтыңыз.
Dialogue: 0,1:30:44.11,1:30:49.48,JP_ED,NTP,0000,0000,0000,,Қап-қара жүрегімнің қараңғылығын ақ түске боямын
Dialogue: 0,1:30:49.82,1:30:54.45,JP_ED,NTP,0000,0000,0000,,Бір күні өлемін деп шешсем де, мен сені ұмыта алмаймын.
Dialogue: 0,1:30:54.59,1:31:01.98,JP_ED,NTP,0000,0000,0000,,Осы тамырлар арқылы тілек құлайды.
Dialogue: 0,1:31:07.80,1:31:15.31,JP_ED,NTP,0000,0000,0000,,Жығылып, көз жасын төгу
Dialogue: 0,1:31:15.58,1:31:23.16,JP_ED,NTP,0000,0000,0000,,Таңға дейін билеп, ғашық бол
