Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.08,0:00:08.09,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.91,0:01:29.17,Default,,0,0,0,,～♪
Dialogue: 0,0:01:38.01,0:01:39.30,Default,,0,0,0,,Сәлем, Тим?
Dialogue: 0,0:01:39.39,0:01:43.01,Default,,0,0,0,,Альпака жүнінің қой жүнінен айырмашылығы бар ма?
Dialogue: 0,0:01:43.10,0:01:46.85,Default,,0,0,0,,Хехехе, альпакалардың жүні нәзік.
Dialogue: 0,0:01:47.60,0:01:48.81,Default,,0,0,0,,Оны түртуге болады.
Dialogue: 0,0:01:48.90,0:01:50.73,Default,,0,0,0,,Мен оған қол тигіземін
Dialogue: 0,0:01:50.81,0:01:51.98,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:01:53.90,0:01:55.36,Default,,0,0,0,,Әрине
Dialogue: 0,0:01:57.28,0:01:58.28,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:01:58.36,0:01:59.91,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:01:59.99,0:02:03.37,Default,,0,0,0,,Жоқ, жоқ, бұл не естелік?
Dialogue: 0,0:02:04.45,0:02:08.83,Default,,0,0,0,,Бірақ шындығында ол Тем екеуі соншалықты жақын болды.
Dialogue: 0,0:02:08.92,0:02:11.96,Default,,0,0,0,,Мен Темді жеген қылмыскерді тапқым келеді.
Dialogue: 0,0:02:12.04,0:02:15.76,Default,,0,0,0,,Бірақ бұл жеке міндеттілік сезімі емес...
Dialogue: 0,0:02:15.84,0:02:17.13,Default,,0,0,0,,Мен...
Dialogue: 0,0:02:17.22,0:02:18.80,Default,,0,0,0,,Уау
Dialogue: 0,0:02:21.09,0:02:22.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:23.47,0:02:26.77,Default,,0,0,0,,Ха... бұл үлкен және жаман.
Dialogue: 0,0:02:26.85,0:02:30.48,Default,,0,0,0,,Уф... бұл кім! Эй
Dialogue: 0,0:02:30.56,0:02:31.86,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:02:31.94,0:02:33.48,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:02:33.57,0:02:35.15,Default,,0,0,0,,Гах...
Dialogue: 0,0:02:37.24,0:02:38.95,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:39.03,0:02:41.24,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:02:42.57,0:02:46.91,Default,,0,0,0,,Иә? Не... не болып жатыр?
Dialogue: 0,0:02:47.66,0:02:49.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:50.00,0:02:51.58,Default,,0,0,0,,（）
Dialogue: 0,0:02:51.67,0:02:55.00,Default,,0,0,0,,Жоқ, суық тиіп қалдым, мұрным істемейді.
Dialogue: 0,0:02:55.50,0:02:59.30,Default,,0,0,0,,Сіз Тимді өлтірген кінәлісіз.
Dialogue: 0,0:02:59.88,0:03:04.39,Default,,0,0,0,,Уф... у...
Dialogue: 0,0:03:07.35,0:03:09.52,Default,,0,0,0,,Ой... сен мені қорқытпақшысың ба?
Dialogue: 0,0:03:10.06,0:03:12.56,Default,,0,0,0,,Енді иіскеуді доғар.
Dialogue: 0,0:03:14.48,0:03:17.28,Default,,0,0,0,,Өз күшіңізді көрсетуді ұнататын сияқтысыз.
Dialogue: 0,0:03:19.44,0:03:20.61,Default,,0,0,0,,Етқоректі жануар ретінде...
Dialogue: 0,0:03:20.70,0:03:22.28,Default,,0,0,0,,Гррр…
Dialogue: 0,0:03:22.36,0:03:25.12,Default,,0,0,0,,Ah... uh...
Dialogue: 0,0:03:26.20,0:03:29.00,Default,,0,0,0,,Альпакалардың нәзік пальтолары бар.
Dialogue: 0,0:03:29.79,0:03:31.37,Default,,0,0,0,,Оны түртуге болады.
Dialogue: 0,0:03:32.17,0:03:33.63,Default,,0,0,0,,Тем
Dialogue: 0,0:03:33.71,0:03:36.63,Default,,0,0,0,,Екеуміз жақын болғанымызға өкінемін.
Dialogue: 0,0:03:37.88,0:03:42.26,Default,,0,0,0,,Шөпқоректілер бізді жыртқыштарға жақындатады.
Dialogue: 0,0:03:42.93,0:03:45.85,Default,,0,0,0,,Бұл өте ерекше нәрсе.
Dialogue: 0,0:03:46.85,0:03:50.18,Default,,0,0,0,,Бұл біз ет жейтіндер үшін ұмытатын ең маңызды нәрсе.
Dialogue: 0,0:03:50.27,0:03:54.06,Default,,0,0,0,,Жануардың үнемі өлім аузында болуы қандай сезімде болады?
Dialogue: 0,0:03:54.60,0:03:56.15,Default,,0,0,0,,Білмесем де
Dialogue: 0,0:03:57.40,0:04:01.53,Default,,0,0,0,,Дұрыс, Хару-чан қатал.
Dialogue: 0,0:04:02.32,0:04:05.32,Default,,0,0,0,,Бірақ қазір аздап түсіндім.
Dialogue: 0,0:04:05.41,0:04:10.20,Default,,0,0,0,,Мен шөпқоректілердің барлығын өтеу үшін бірдеңе істеймін.
Dialogue: 0,0:04:10.79,0:04:11.62,Default,,0,0,0,,(шағу дыбысы)
Dialogue: 0,0:04:11.70,0:04:16.17,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:04:17.04,0:04:19.30,Default,,0,0,0,,Ол туралы мәліметтерді табыңыз.
Dialogue: 0,0:04:19.38,0:04:21.97,Default,,0,0,0,,Дәмі бойынша Түрту арқылы
Dialogue: 0,0:04:22.72,0:04:24.47,Default,,0,0,0,,Тіс сауыты ше?
Dialogue: 0,0:04:24.55,0:04:26.64,Default,,0,0,0,,Еттің дәмін көре аласыз ба?
Dialogue: 0,0:04:27.72,0:04:29.51,Default,,0,0,0,,Мені бер
Dialogue: 0,0:04:29.60,0:04:30.56,Default,,0,0,0,,Беріңіз!
Dialogue: 0,0:04:30.64,0:04:32.14,Default,,0,0,0,,Сілекей
Dialogue: 0,0:04:32.23,0:04:33.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:33.14,0:04:35.06,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:35.65,0:04:36.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:36.77,0:04:38.48,Default,,0,0,0,,Бұл не екенін білесің бе?
Dialogue: 0,0:04:38.56,0:04:39.40,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:39.48,0:04:42.69,Default,,0,0,0,,（）
Dialogue: 0,0:04:44.11,0:04:46.28,Default,,0,0,0,,Өз санаңызды нақтылаңыз
Dialogue: 0,0:04:47.12,0:04:50.83,Default,,0,0,0,,Бұл дәмді жақсы есте сақтаңыз.
Dialogue: 0,0:04:52.95,0:04:55.08,Default,,0,0,0,,...Шынымен айтайын дегенім.
Dialogue: 0,0:04:55.16,0:04:57.17,Default,,0,0,0,,Егер солай болса, дәл қазір
Dialogue: 0,0:04:57.75,0:05:01.25,Default,,0,0,0,,Мен Хару-чанмен бірінші сүйісуім керек еді.
Dialogue: 0,0:05:02.01,0:05:04.26,Default,,0,0,0,,(Ойынның дыбыс әсерлері)
Dialogue: 0,0:05:04.34,0:05:06.51,Default,,0,0,0,,Уау, рас па?
Dialogue: 0,0:05:06.59,0:05:07.97,Default,,0,0,0,,Бұл қорлау
Dialogue: 0,0:05:08.05,0:05:09.05,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:05:09.14,0:05:09.89,Default,,0,0,0,,Сол құйрықтың соққыларына абай болу керек.
Dialogue: 0,0:05:09.89,0:05:11.43,Default,,0,0,0,,Сол құйрықтан келетін соққыларға абай болу керек.
Dialogue: 0,0:05:09.89,0:05:11.43,Default,,0,0,0,,(Ойынның дыбыс әсерлері)
Dialogue: 0,0:05:11.43,0:05:12.27,Default,,0,0,0,,Сол құйрықтың соққыларына абай болу керек.
Dialogue: 0,0:05:13.27,0:05:14.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:14.77,0:05:17.15,Default,,0,0,0,,Бұл Джектің ұялы телефоны емес пе?
Dialogue: 0,0:05:17.23,0:05:20.82,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:05:25.15,0:05:26.49,Default,,0,0,0,,Сәлеметсіз бе, Легоси?
Dialogue: 0,0:05:26.57,0:05:30.49,Default,,0,0,0,,(Легошидің күрсінуі)
Dialogue: 0,0:05:31.83,0:05:33.75,Default,,0,0,0,,Оған бар күшімді салуым керек.
Dialogue: 0,0:05:33.83,0:05:36.96,Default,,0,0,0,,Бұл Легосидің мұрны нашар сезінгендегі ырылдауы.
Dialogue: 0,0:05:37.50,0:05:39.42,Default,,0,0,0,,Бұл ұлпаларды сұрайтын SOS ме?
Dialogue: 0,0:05:39.50,0:05:40.79,Default,,0,0,0,,Не, түсіндің бе?
Dialogue: 0,0:05:40.88,0:05:42.55,Default,,0,0,0,,Біз бір-бірімізді бұрыннан танимыз.
Dialogue: 0,0:05:46.47,0:05:49.01,Default,,0,0,0,,Легоси, сәлем
Dialogue: 0,0:05:50.89,0:05:53.43,Default,,0,0,0,,Не болды? Жауап беру.
Dialogue: 0,0:05:53.51,0:05:55.35,Default,,0,0,0,,Легоши? Эй
Dialogue: 0,0:05:55.43,0:05:57.19,Default,,0,0,0,,(жел диірменінің айналу дыбысы)
Dialogue: 0,0:05:57.19,0:06:00.15,Default,,0,0,0,,(Жел диірменінің айналу дыбысы)
Dialogue: 0,0:05:57.19,0:06:00.15,Default,,0,0,0,,Иә? Бұл дыбыс...
Dialogue: 0,0:06:04.73,0:06:06.15,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:06:06.24,0:06:08.49,Default,,0,0,0,,Мен Легоси үшін не істей аламын
Dialogue: 0,0:06:08.99,0:06:11.37,Default,,0,0,0,,Қартайған сайын ол жоғалады.
Dialogue: 0,0:06:12.20,0:06:14.08,Default,,0,0,0,,Шын мәнінде, барлық уақытта
Dialogue: 0,0:06:14.74,0:06:16.87,Default,,0,0,0,,Мен бұл туралы білемін
Dialogue: 0,0:06:18.71,0:06:21.54,Default,,0,0,0,,Мен сізге орынды айтып үлгермедім.
Dialogue: 0,0:06:22.25,0:06:25.34,Default,,0,0,0,,Ол мені көргенде үрейленбейді деп үміттенемін.
Dialogue: 0,0:06:25.42,0:06:28.55,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:28.63,0:06:29.55,Default,,0,0,0,,(бір нәрсені құлатқан дыбыс)
Dialogue: 0,0:06:29.63,0:06:32.26,Default,,0,0,0,,(Джектің ауыр тыныс алуы)
Dialogue: 0,0:06:32.35,0:06:33.51,Default,,0,0,0,,Легоши…
Dialogue: 0,0:06:34.31,0:06:35.72,Default,,0,0,0,,Эй...
Dialogue: 0,0:06:35.81,0:06:38.43,Default,,0,0,0,,О, Джек, рахмет.
Dialogue: 0,0:06:38.52,0:06:41.98,Default,,0,0,0,,Бұл... Жоқ, өлме, Легоси.
Dialogue: 0,0:06:42.06,0:06:43.02,Default,,0,0,0,,Сіз мені түсінесіз бе?
Dialogue: 0,0:06:43.11,0:06:46.69,Default,,0,0,0,,А, түсіндім, түсіндім, мені шеше аласың ба?
Dialogue: 0,0:06:46.78,0:06:48.57,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:06:48.65,0:06:51.24,Default,,0,0,0,,Хмм... Қызық, бұл кім?
Dialogue: 0,0:06:55.08,0:06:56.45,Default,,0,0,0,,Ум...
Dialogue: 0,0:06:57.04,0:06:59.96,Default,,0,0,0,,Мен мектепке біраз уақыт келе алмаймын.
Dialogue: 0,0:07:00.04,0:07:00.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:00.96,0:07:03.67,Default,,0,0,0,,Ата-анамның үйіндегі атам құлап қалды, мен оған қарауға бардым.
Dialogue: 0,0:07:03.75,0:07:04.92,Default,,0,0,0,,Мұғалімге айтыңыз
Dialogue: 0,0:07:05.00,0:07:07.42,Default,,0,0,0,,Иә? неге?
Dialogue: 0,0:07:07.51,0:07:09.22,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:07:09.30,0:07:11.76,Default,,0,0,0,,Математика оқулығы мен Кородан алдым
Dialogue: 0,0:07:11.84,0:07:15.47,Default,,0,0,0,,Мен оны сыныптағы партаның үстіне қалдырдым, қайтарып бере аласыз ба?
Dialogue: 0,0:07:17.14,0:07:19.35,Default,,0,0,0,,Осы екі хабарламаны қабылдаңыз.
Dialogue: 0,0:07:19.43,0:07:22.35,Default,,0,0,0,,Мен сені көргенде әйтеуір бір жақсырақ болдым.
Dialogue: 0,0:07:23.06,0:07:25.94,Default,,0,0,0,,Әй, медициналық кабинетке барайық.
Dialogue: 0,0:07:26.02,0:07:28.78,Default,,0,0,0,,Дәрігерге қаралу керек.
Dialogue: 0,0:07:28.86,0:07:29.99,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:30.07,0:07:33.53,Default,,0,0,0,,Мектепте қалсаң, келесі жолы сені өлтіреді.
Dialogue: 0,0:07:33.61,0:07:37.16,Default,,0,0,0,,А... сонда қайда бара жатырсың?
Dialogue: 0,0:07:40.91,0:07:43.75,Default,,0,0,0,,Джекке білудің қажеті жоқ.
Dialogue: 0,0:07:43.83,0:07:47.42,Default,,0,0,0,,Мен міндетті түрде қайтамын.
Dialogue: 0,0:07:48.09,0:07:49.88,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:51.80,0:07:54.05,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:55.55,0:07:57.05,Default,,0,0,0,,Легоши бұл...
Dialogue: 0,0:07:58.22,0:08:02.77,Default,,0,0,0,,Менің кеткеніме бірнеше ай болды.
Dialogue: 0,0:08:04.19,0:08:07.57,Default,,0,0,0,,Сіз қайтып келмейсіз.
Dialogue: 0,0:08:11.03,0:08:14.03,Default,,0,0,0,,Сіз әрқашан ебедейсіз болдыңыз ...
Dialogue: 0,0:08:14.74,0:08:18.53,Default,,0,0,0,,Мен қалыпты бақытқа үміттендім.
Dialogue: 0,0:08:20.20,0:08:23.54,Default,,0,0,0,,Бұл қашан болды?
Dialogue: 0,0:08:24.58,0:08:29.21,Default,,0,0,0,,Күшті болған сайын бақытсыз боласың.
Dialogue: 0,0:08:30.67,0:08:33.63,Default,,0,0,0,,Мен енді қарай алмаймын
Dialogue: 0,0:08:33.72,0:08:35.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:36.18,0:08:42.56,Default,,0,0,0,,Осы кезде Джек өзін сондай жарқын әрі алыс сезінді.
Dialogue: 0,0:08:43.85,0:08:47.02,Default,,0,0,0,,Мынау алтын шашы бар жігіт достарын ойлап жылайды.
Dialogue: 0,0:08:47.02,0:08:48.23,Default,,0,0,0,,Мынау алтын шашы бар жігіт достарын ойлап жылайды.
Dialogue: 0,0:08:47.02,0:08:48.23,Default,,0,0,0,,♪～
Dialogue: 0,0:08:48.23,0:08:48.81,Default,,0,0,0,,♪～
Dialogue: 0,0:08:48.81,0:08:51.53,Default,,0,0,0,,♪～
Dialogue: 0,0:08:48.81,0:08:51.53,Default,,0,0,0,,Мен үнсіз қара қызыл массамын.
Dialogue: 0,0:08:51.53,0:08:52.07,Default,,0,0,0,,♪～
Dialogue: 0,0:08:52.07,0:08:53.03,Default,,0,0,0,,♪～
Dialogue: 0,0:08:52.07,0:08:53.03,Default,,0,0,0,,Олар енді жаратылысқа ұқсамайды.
Dialogue: 0,0:08:53.03,0:08:54.40,Default,,0,0,0,,Олар енді жаратылысқа да ұқсамайды.
Dialogue: 0,0:08:55.66,0:08:57.32,Default,,0,0,0,,Менің күшім
Dialogue: 0,0:08:58.45,0:09:01.16,Default,,0,0,0,,Бұл сізді бақытты ету үшін емес.
Dialogue: 0,0:09:01.95,0:09:03.37,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:09:10.25,0:09:12.13,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:09:12.21,0:09:13.51,Default,,0,0,0,,Легоши…
Dialogue: 0,0:09:15.26,0:09:20.18,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:09:23.52,0:09:26.56,Default,,0,0,0,,Ол мен сенім арта алатын жалғыз ересек адам.
Dialogue: 0,0:09:27.14,0:09:29.81,Default,,0,0,0,,Маған дәл қазір кеңес керек.
Dialogue: 0,0:09:30.44,0:09:33.86,Default,,0,0,0,,Тілекпен жабылған осы «артқы нарықты» сақтаушыға
Dialogue: 0,0:09:33.94,0:09:35.61,Default,,0,0,0,,Бір сөз жеткілікті
Dialogue: 0,0:09:38.86,0:09:40.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:41.33,0:09:43.83,Default,,0,0,0,,Ал... сіз бамбук сатасыз ба?
Dialogue: 0,0:09:43.91,0:09:45.58,Default,,0,0,0,,Қанша бума?
Dialogue: 0,0:09:45.66,0:09:47.96,Default,,0,0,0,,А... жоқ... у...
Dialogue: 0,0:09:48.04,0:09:49.92,Default,,0,0,0,,Мен ақымақпын.
Dialogue: 0,0:09:50.71,0:09:54.09,Default,,0,0,0,,Тұтынушы? Не болды?
Dialogue: 0,0:09:54.63,0:09:56.22,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:54.63,0:09:56.22,Default,,0,0,0,,～♪
Dialogue: 0,0:09:56.22,0:09:56.30,Default,,0,0,0,,～♪
Dialogue: 0,0:09:56.30,0:09:58.93,Default,,0,0,0,,～♪
Dialogue: 0,0:09:56.30,0:09:58.93,Default,,0,0,0,,Кеңес алғыңыз келетіні анық.
Dialogue: 0,0:09:58.93,0:09:59.01,Default,,0,0,0,,～♪
Dialogue: 0,0:09:59.01,0:10:00.64,Default,,0,0,0,,～♪
Dialogue: 0,0:09:59.01,0:10:00.64,Default,,0,0,0,,Мен жай ғана демалатын жер іздеп жүрмін.
Dialogue: 0,0:10:00.64,0:10:03.14,Default,,0,0,0,,Мен жай ғана демалатын жер іздеп жүрмін.
Dialogue: 0,0:10:03.22,0:10:06.14,Default,,0,0,0,,Апай, алдымен осыған тапсырыс беріңіз.
Dialogue: 0,0:10:06.23,0:10:07.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:09.10,0:10:12.44,Default,,0,0,0,,50 кг үлкен бамбук және 5 байлам Нарихира бамбук
Dialogue: 0,0:10:12.52,0:10:17.11,Default,,0,0,0,,Сондай-ақ, мен өткен күні 30 кг кептірілген Окаме бамбукына тапсырыс бердім.
Dialogue: 0,0:10:17.19,0:10:21.20,Default,,0,0,0,,Иә, иә, сен жақсы тамақтаныпсың, Гухин-сан.
Dialogue: 0,0:10:21.28,0:10:23.03,Default,,0,0,0,,Бүгін бәрін үйге апарасың ба?
Dialogue: 0,0:10:23.70,0:10:25.12,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,0:10:25.91,0:10:29.00,Default,,0,0,0,,Хехе, бұл сенсің ғой.
Dialogue: 0,0:10:29.08,0:10:31.71,Default,,0,0,0,,Жарақаттан басқа, сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:10:33.63,0:10:37.97,Default,,0,0,0,,Қалағаным ақыл-кеңес те, жүрегіме орын да емес.
Dialogue: 0,0:10:39.30,0:10:40.18,Default,,0,0,0,,Гохин мырза
Dialogue: 0,0:10:41.14,0:10:42.80,Default,,0,0,0,,Мені өзіңе шәкірт ет
Dialogue: 0,0:10:44.26,0:10:45.22,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:10:46.35,0:10:47.77,Default,,0,0,0,,Мен тағы келемін
Dialogue: 0,0:11:03.62,0:11:04.66,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:04.74,0:11:09.04,Default,,0,0,0,,Шөпқоректі оқушыны жеп қойды. Бұл жыртқыш аңдар жасырынған мектеп пе?
Dialogue: 0,0:11:09.12,0:11:12.25,Default,,0,0,0,,Бұл сіз де болған драма үйірмесінде.
Dialogue: 0,0:11:12.33,0:11:15.09,Default,,0,0,0,,Бұл оқиға болды...
Dialogue: 0,0:11:15.17,0:11:18.38,Default,,0,0,0,,Сізде бақытсыздықты тудыратын конституция бар.
Dialogue: 0,0:11:18.46,0:11:22.13,Default,,0,0,0,,Бүгін маған шабуыл жасаған адам міндетті түрде кінәлі.
Dialogue: 0,0:11:22.80,0:11:24.60,Default,,0,0,0,,Оның үстіне ол ақылсыз күшті болды.
Dialogue: 0,0:11:25.26,0:11:28.02,Default,,0,0,0,,Оны осылай жалғыз қалдыру өте қауіпті.
Dialogue: 0,0:11:31.10,0:11:31.94,Default,,0,0,0,,...және?
Dialogue: 0,0:11:32.02,0:11:34.11,Default,,0,0,0,,Е... жоқ, бұл...
Dialogue: 0,0:11:34.19,0:11:35.61,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:35.69,0:11:37.61,Default,,0,0,0,,Мен күштірек болғым келеді
Dialogue: 0,0:11:37.69,0:11:39.28,Default,,0,0,0,,Маған күресуді үйретші...
Dialogue: 0,0:11:39.36,0:11:40.28,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:11:40.36,0:11:41.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:41.49,0:11:43.74,Default,,0,0,0,,Мен ұмытып кеткен шығармын
Dialogue: 0,0:11:43.82,0:11:46.99,Default,,0,0,0,,Менің негізгі жұмысым - бэк-рыноктағы психосоматикалық дәрігер.
Dialogue: 0,0:11:47.58,0:11:50.91,Default,,0,0,0,,Күлкілі бомба алып жүрсеңіз, жұмыс істеу қиын болар еді.
Dialogue: 0,0:11:52.42,0:11:53.71,Default,,0,0,0,,Бомба?
Dialogue: 0,0:11:53.79,0:11:57.21,Default,,0,0,0,,Жоқ, мен кенеттен бұлай айқайламаймын.
Dialogue: 0,0:11:57.29,0:12:00.34,Default,,0,0,0,,Сіз бастығын жеңген Шиши тобы
Dialogue: 0,0:12:00.42,0:12:03.05,Default,,0,0,0,,Енді олар астыртын нарықта өз билігін нығайтып жатыр.
Dialogue: 0,0:12:03.13,0:12:04.22,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:12:04.30,0:12:06.80,Default,,0,0,0,,Мұндай жағдайда сіздің жаттығуларыңыз үшін,
Dialogue: 0,0:12:06.89,0:12:09.43,Default,,0,0,0,,Осы жерден келе жатқанда ұсталған күні.
Dialogue: 0,0:12:09.52,0:12:11.89,Default,,0,0,0,,Бір соққы оны орындамайды.
Dialogue: 0,0:12:12.73,0:12:14.60,Default,,0,0,0,,Олар сізді қалай пісірсе де
Dialogue: 0,0:12:14.69,0:12:16.15,Default,,0,0,0,,Мен мұны білмеймін, бірақ
Dialogue: 0,0:12:16.77,0:12:20.28,Default,,0,0,0,,Мен сенің одан әрі тереңдеп, менің жағдайымды нашарлатуыңды қаламаймын.
Dialogue: 0,0:12:20.36,0:12:21.74,Default,,0,0,0,,Бамбук шайын ішіп, үйге қайт.
Dialogue: 0,0:12:21.82,0:12:25.11,Default,,0,0,0,,Аа, мен кішкентай кезімнен әлсіз болдым, сондықтан бәрі жақсы.
Dialogue: 0,0:12:25.20,0:12:27.49,Default,,0,0,0,,Ол бар күшін салып сытылып шығады.
Dialogue: 0,0:12:27.58,0:12:30.37,Default,,0,0,0,,Бұл әнді қалай жасыра аласыз?
Dialogue: 0,0:12:30.45,0:12:33.54,Default,,0,0,0,,Мм... онда мен мұнда жұмысшы болып жұмыс істеймін.
Dialogue: 0,0:12:33.62,0:12:34.83,Default,,0,0,0,,(Цубаки) Шынын айтсам, мен оның бармағанын қалаймын.
Dialogue: 0,0:12:35.37,0:12:36.54,Default,,0,0,0,,Мен біраз үзіліс жасаймын...
Dialogue: 0,0:12:36.63,0:12:38.75,Default,,0,0,0,,Төтенше!
Dialogue: 0,0:12:38.84,0:12:40.55,Default,,0,0,0,,Жұмыс қиын кезде
Dialogue: 0,0:12:40.63,0:12:43.26,Default,,0,0,0,,Оқуды бітіру үшін кредиттерім жеткіліксіз болса не істеуім керек?
Dialogue: 0,0:12:44.26,0:12:47.85,Default,,0,0,0,,Сонымен, сіз ештеңені өзгерте алмайсыз ба?
Dialogue: 0,0:12:48.55,0:12:52.43,Default,,0,0,0,,Мен енді қараушы болғым келмейді.
Dialogue: 0,0:12:52.52,0:12:53.43,Default,,0,0,0,,(Гухиннің тілін шертеді)
Dialogue: 0,0:12:53.52,0:12:54.77,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:12:55.39,0:12:58.52,Default,,0,0,0,,Сіз өте сөйлейтін болып кеттіңіз.
Dialogue: 0,0:12:58.61,0:13:02.03,Default,,0,0,0,,Әй, бірақ мен бұл жасыл иісті жек көрмеймін.
Dialogue: 0,0:13:02.11,0:13:03.11,Default,,0,0,0,,Ал, тынышталып, отырыңыз.
Dialogue: 0,0:13:03.19,0:13:04.74,Default,,0,0,0,,Маған тамаша ой келді.
Dialogue: 0,0:13:05.32,0:13:07.11,Default,,0,0,0,,Не? Қандай тамаша идея
Dialogue: 0,0:13:07.78,0:13:08.70,Default,,0,0,0,,А...
Dialogue: 0,0:13:09.87,0:13:12.41,Default,,0,0,0,,А... не... не істеуді жоспарлап отырсың?
Dialogue: 0,0:13:12.50,0:13:15.71,Default,,0,0,0,,Егер сіз шындап менің қол астында жаттығыңыз келсе, табандылығыңызды көрсетіңіз.
Dialogue: 0,0:13:15.71,0:13:16.42,Default,,0,0,0,,Егер сіз менің қол астында жаттығуға шындап ниет білдірсеңіз, жігеріңізді көрсетіңіз.
Dialogue: 0,0:13:15.71,0:13:16.42,Default,,0,0,0,,А... а
Dialogue: 0,0:13:16.42,0:13:16.50,Default,,0,0,0,,А... а
Dialogue: 0,0:13:16.50,0:13:17.04,Default,,0,0,0,,А... а
Dialogue: 0,0:13:16.50,0:13:17.04,Default,,0,0,0,,Бұл жер асты әлемінің ережелері.
Dialogue: 0,0:13:17.04,0:13:18.17,Default,,0,0,0,,Бұл жер асты әлемінің ережелері.
Dialogue: 0,0:13:18.17,0:13:19.08,Default,,0,0,0,,Бұл жер асты әлемінің ережелері.
Dialogue: 0,0:13:18.17,0:13:19.08,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:19.17,0:13:21.21,Default,,0,0,0,,Нашар қозғалмаңыз
Dialogue: 0,0:13:21.30,0:13:24.17,Default,,0,0,0,,Мұны ант қабылдау рәсімі деп түсініңіз.
Dialogue: 0,0:13:24.26,0:13:27.72,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:28.59,0:13:30.39,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:31.01,0:13:32.97,Default,,0,0,0,,Бүгін болды ма?
Dialogue: 0,0:13:33.68,0:13:35.68,Default,,0,0,0,,Менің соңғы сәттерім
Dialogue: 0,0:13:35.77,0:13:40.52,Default,,0,0,0,,(Сахналық музыка)
Dialogue: 0,0:13:40.61,0:13:42.86,Default,,0,0,0,,(Қонақтар айқайлайды)
Dialogue: 0,0:13:49.87,0:13:50.91,Default,,0,0,0,,Мұнда-
Dialogue: 0,0:13:51.58,0:13:53.79,Default,,0,0,0,,Биші киімін шешкен сайын
Dialogue: 0,0:13:53.87,0:13:57.62,Default,,0,0,0,,Жыртқыш қонақтардың арылдаған дауыстары жаңғырық.
Dialogue: 0,0:14:03.67,0:14:05.55,Default,,0,0,0,,О Космо
Dialogue: 0,0:14:05.63,0:14:07.72,Default,,0,0,0,,(аудиторияның қол шапалақтауы)
Dialogue: 0,0:14:07.80,0:14:08.76,Default,,0,0,0,,Не?
Dialogue: 0,0:14:08.84,0:14:10.59,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:14:10.68,0:14:13.31,Default,,0,0,0,,Бүгін де сені бәрі іздейді.
Dialogue: 0,0:14:14.06,0:14:17.27,Default,,0,0,0,,Тәбет пен жыныстық құмарлықты бір уақытта ынталандыруға болады.
Dialogue: 0,0:14:17.35,0:14:19.60,Default,,0,0,0,,Мен жай ғана ыңғайлы шоу іздеп жүрмін.
Dialogue: 0,0:14:19.69,0:14:22.44,Default,,0,0,0,,Хехе, жағдайың жақсы ғой, солай ма?
Dialogue: 0,0:14:22.52,0:14:23.65,Default,,0,0,0,,Тіпті күш жұмсамай-ақ
Dialogue: 0,0:14:23.73,0:14:26.82,Default,,0,0,0,,Сіз шөпқоректі болғандықтан ғана сізге көп көңіл бөлінеді.
Dialogue: 0,0:14:26.90,0:14:30.03,Default,,0,0,0,,Етқоректі бидің орнын ауыстыратындар көп.
Dialogue: 0,0:14:30.11,0:14:31.57,Default,,0,0,0,,Осылай жүре берсең, жұмыстан қуылады.
Dialogue: 0,0:14:32.74,0:14:34.24,Default,,0,0,0,,Hmph… Иесі
Dialogue: 0,0:14:34.33,0:14:35.70,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:14:35.79,0:14:37.79,Default,,0,0,0,,А... жоқ, бұл...
Dialogue: 0,0:14:37.87,0:14:41.96,Default,,0,0,0,,Көрермендер торды алып тастауды сұрай берді.
Dialogue: 0,0:14:42.04,0:14:43.63,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:14:43.71,0:14:46.55,Default,,0,0,0,,Иә... жақсы, тоқтайық.
Dialogue: 0,0:14:46.63,0:14:48.47,Default,,0,0,0,,Сонымен қатар, қисынсыз тұтынушыға
Dialogue: 0,0:14:48.55,0:14:51.84,Default,,0,0,0,,Бидің жегенін көргім келмейді.
Dialogue: 0,0:14:52.80,0:14:54.56,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:14:54.64,0:14:58.52,Default,,0,0,0,,Үлкен құс - Космо-чан, артқы базардағы жалғыз шөпқоректі биші.
Dialogue: 0,0:14:59.35,0:15:02.69,Default,,0,0,0,,Барлығыңыз, тырнақтарыңыз бен тістеріңізді жасырып, ләззат алыңыз.
Dialogue: 0,0:15:05.48,0:15:09.28,Default,,0,0,0,,Артқы нарықтағы шөпқоректілер өлімнің алдыңғы қатарында.
Dialogue: 0,0:15:10.82,0:15:13.32,Default,,0,0,0,,Сонда да бұл қалада адамдар бар
Dialogue: 0,0:15:13.41,0:15:16.49,Default,,0,0,0,,Өйткені мен өзім бола аламын
Dialogue: 0,0:15:18.00,0:15:21.79,Default,,0,0,0,,Етқоректілердің барлық ақшасын қазір сығып ал
Dialogue: 0,0:15:21.87,0:15:25.04,Default,,0,0,0,,Өлсем, жегенше жеп, өлемін.
Dialogue: 0,0:15:25.75,0:15:30.84,Default,,0,0,0,,Жүріңдер, аңдар, біз күте алмаймыз.
Dialogue: 0,0:15:31.51,0:15:36.31,Default,,0,0,0,,Матадан өтпейтін аналық шөпқоректілер. Табиғи иісі
Dialogue: 0,0:15:37.22,0:15:38.31,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:15:37.22,0:15:38.31,Default,,0,0,0,,Тамаққа кесілген еттен гөрі.
Dialogue: 0,0:15:38.31,0:15:40.18,Default,,0,0,0,,Жеуге туралған еттен артық
Dialogue: 0,0:15:40.27,0:15:44.36,Default,,0,0,0,,Интенсивті балғын және тәтті
Dialogue: 0,0:15:45.61,0:15:49.15,Default,,0,0,0,,Тәбет Жыныстық құмарлықтың хаосы
Dialogue: 0,0:15:49.23,0:15:51.20,Default,,0,0,0,,(қатты тыныс алу және жұтыну дыбысы)
Dialogue: 0,0:15:49.23,0:15:51.20,Default,,0,0,0,,Мен оны араластырамын.
Dialogue: 0,0:15:51.20,0:15:52.11,Default,,0,0,0,,Мен оны араластырамын.
Dialogue: 0,0:15:59.58,0:16:02.29,Default,,0,0,0,,Сіз тордағыларсыз
Dialogue: 0,0:16:02.29,0:16:03.50,Default,,0,0,0,,Сіз тордағыларсыз
Dialogue: 0,0:16:02.29,0:16:03.50,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:16:03.50,0:16:03.58,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:16:03.58,0:16:06.46,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:16:03.58,0:16:06.46,Default,,0,0,0,,Мен мұнда билеушімін.
Dialogue: 0,0:16:08.63,0:16:10.67,Default,,0,0,0,,А...
Dialogue: 0,0:16:14.22,0:16:15.59,Default,,0,0,0,,(Қонақтар еңіреп)
Dialogue: 0,0:16:16.39,0:16:18.14,Default,,0,0,0,,А... а... а?
Dialogue: 0,0:16:18.22,0:16:20.77,Default,,0,0,0,,(Жолбарыстың үруі)
Dialogue: 0,0:16:21.48,0:16:25.27,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:25.35,0:16:27.77,Default,,0,0,0,,Бұл кім? Менде болған қадам
Dialogue: 0,0:16:27.86,0:16:30.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:30.23,0:16:32.03,Default,,0,0,0,,Бүгін болды ма?
Dialogue: 0,0:16:32.11,0:16:33.70,Default,,0,0,0,,Менің соңғы сәтім болды
Dialogue: 0,0:16:34.28,0:16:35.57,Default,,0,0,0,,(Жолбарыстың үруі)
Dialogue: 0,0:16:35.66,0:16:36.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:36.91,0:16:37.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:37.83,0:16:38.78,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:38.87,0:16:40.91,Default,,0,0,0,,Уф... не?
Dialogue: 0,0:16:41.00,0:16:43.58,Default,,0,0,0,,Бұл өте қызықты бола бастады, солай емес пе?
Dialogue: 0,0:16:44.29,0:16:47.46,Default,,0,0,0,,Бірақ сахна – киелі жер.
Dialogue: 0,0:16:47.54,0:16:48.50,Default,,0,0,0,,Е...
Dialogue: 0,0:16:48.59,0:16:50.88,Default,,0,0,0,,Сахнаға кедергі келтіретін дөрекі адамдарға
Dialogue: 0,0:16:50.88,0:16:51.38,Default,,0,0,0,,Сахнаны бұзатын дөрекі адамдарға
Dialogue: 0,0:16:50.88,0:16:51.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:51.38,0:16:51.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:51.46,0:16:52.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:51.46,0:16:52.30,Default,,0,0,0,,Сахнаға шығуға жарамды емес
Dialogue: 0,0:16:52.30,0:16:53.84,Default,,0,0,0,,Сахнаға шығуға жарамды емес
Dialogue: 0,0:16:54.80,0:16:59.01,Default,,0,0,0,,Әдепті білмейтін қонақтарды жазалаймыз.
Dialogue: 0,0:16:59.10,0:17:01.93,Default,,0,0,0,,Уф... аааааа...
Dialogue: 0,0:17:01.93,0:17:02.60,Default,,0,0,0,,Уф... аааааа...
Dialogue: 0,0:17:01.93,0:17:02.60,Default,,0,0,0,,Рас, бұл Шиши-гуми.
Dialogue: 0,0:17:02.60,0:17:02.68,Default,,0,0,0,,Рас, бұл Шиши-гуми.
Dialogue: 0,0:17:02.68,0:17:03.93,Default,,0,0,0,,Рас, бұл Шиши-гуми.
Dialogue: 0,0:17:02.68,0:17:03.93,Default,,0,0,0,,Ей, тыныш бол, а...
Dialogue: 0,0:17:03.93,0:17:04.81,Default,,0,0,0,,Ей, тыныш бол, а...
Dialogue: 0,0:17:04.89,0:17:05.48,Default,,0,0,0,,Ах... (Шиши В тобы) Ой!
Dialogue: 0,0:17:05.48,0:17:05.98,Default,,0,0,0,,Ахх... (Шиши В тобы) Ой!
Dialogue: 0,0:17:05.48,0:17:05.98,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:05.98,0:17:06.06,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:06.06,0:17:08.15,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:06.06,0:17:08.15,Default,,0,0,0,,Амансың ба? Ах...
Dialogue: 0,0:17:10.07,0:17:13.19,Default,,0,0,0,,Неліктен бұл жерде шөпқоректілер кездеседі?
Dialogue: 0,0:17:14.53,0:17:17.45,Default,,0,0,0,,Менің ең жек көретінім
Dialogue: 0,0:17:17.53,0:17:20.91,Default,,0,0,0,,Мен мені жегім келетін жыртқыш емеспін
Dialogue: 0,0:17:20.99,0:17:23.87,Default,,0,0,0,,Мені шын аяйтын ет жейтін тұтынушымен.
Dialogue: 0,0:17:23.95,0:17:26.67,Default,,0,0,0,,Бізді көруге келген шөпқоректі қонақтар.
Dialogue: 0,0:17:27.21,0:17:29.54,Default,,0,0,0,,Ойсыз қалсаң, сені де жейді.
Dialogue: 0,0:17:29.63,0:17:31.71,Default,,0,0,0,,Бала үйіне барып ұйықтауы керек.
Dialogue: 0,0:17:31.80,0:17:32.63,Default,,0,0,0,,Босс
Dialogue: 0,0:17:32.71,0:17:33.76,Default,,0,0,0,,Не?
Dialogue: 0,0:17:33.84,0:17:35.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:38.51,0:17:40.22,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:40.30,0:17:43.43,Default,,0,0,0,,Шиши-гумиден бәрі келмесе...
Dialogue: 0,0:17:43.52,0:17:45.93,Default,,0,0,0,,Әлсізге көмектесіп, күштінің көңілін қалдыр
Dialogue: 0,0:17:46.02,0:17:48.02,Default,,0,0,0,,Бұл қазіргі Шиши-гуми.
Dialogue: 0,0:17:48.77,0:17:51.44,Default,,0,0,0,,Сен реніштен істедің бе?
Dialogue: 0,0:17:51.52,0:17:55.69,Default,,0,0,0,,Сен сияқты жыртқыштар қайда барсаң да бар.
Dialogue: 0,0:17:56.49,0:18:00.20,Default,,0,0,0,,Сіз Шиши-гумидің бастығысыз ба?
Dialogue: 0,0:18:00.82,0:18:03.33,Default,,0,0,0,,Мен саған үйге қайт дедім, әпке.
Dialogue: 0,0:18:03.41,0:18:04.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:05.08,0:18:08.08,Default,,0,0,0,,Артқы базар – менің үйім
Dialogue: 0,0:18:08.71,0:18:12.25,Default,,0,0,0,,Шөпқоректілерге қамқорлық жасаңыз.
Dialogue: 0,0:18:13.21,0:18:14.38,Default,,0,0,0,,(Шишигумидің сөйлейтін дауысы)
Dialogue: 0,0:18:14.46,0:18:15.59,Default,,0,0,0,,Пухат
Dialogue: 0,0:18:15.67,0:18:18.72,Default,,0,0,0,,Уау, саке дәмді екен.
Dialogue: 0,0:18:18.80,0:18:22.68,Default,,0,0,0,,Маған қайтадан оққағар болып жұмыс істеуді сұрады.
Dialogue: 0,0:18:22.76,0:18:26.77,Default,,0,0,0,,Бұл иесінің денесі кішкентай, бірақ кең жүзді.
Dialogue: 0,0:18:26.85,0:18:30.65,Default,,0,0,0,,Бастық болса, Шиши-гумидің күші тез кеңейеді.
Dialogue: 0,0:18:30.73,0:18:34.40,Default,,0,0,0,,Біздің реформа ең дұрыс іс болды.
Dialogue: 0,0:18:34.48,0:18:37.82,Default,,0,0,0,,Мен болмасам, бұл топ баяғыда жаншып кетер еді.
Dialogue: 0,0:18:37.90,0:18:39.32,Default,,0,0,0,,Хахаха
Dialogue: 0,0:18:39.40,0:18:42.37,Default,,0,0,0,,Сіз дөрекі сөздер айтасыз.
Dialogue: 0,0:18:42.45,0:18:46.70,Default,,0,0,0,,Жоқ, бірақ мен мұндай дәмді тағамды жегеніме біраз болды.
Dialogue: 0,0:18:46.79,0:18:48.79,Default,,0,0,0,,Сәлем, бастық
Dialogue: 0,0:18:49.33,0:18:52.04,Default,,0,0,0,,Мен ет жеуге оң көзқарас танытпаймын.
Dialogue: 0,0:18:52.13,0:18:56.26,Default,,0,0,0,,Енді осы жерге аяқ басқан соң, қалаға кірсең, қаланың соңынан еріп кетесің.
Dialogue: 0,0:18:56.34,0:18:57.63,Default,,0,0,0,,Осымен
Dialogue: 0,0:19:08.43,0:19:10.48,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:19:10.56,0:19:13.27,Default,,0,0,0,,Иә? Қазір жақсысың ба, бастық?
Dialogue: 0,0:19:13.36,0:19:16.28,Default,,0,0,0,,Оны асқазанның көлемімен салыстырмаңыз.
Dialogue: 0,0:19:16.36,0:19:17.23,Default,,0,0,0,,Қалағаныңды же.
Dialogue: 0,0:19:18.86,0:19:20.36,Default,,0,0,0,,Маған сенуге болады, бастық.
Dialogue: 0,0:19:20.45,0:19:22.20,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:19:23.57,0:19:26.29,Default,,0,0,0,,(құсу дыбысы)
Dialogue: 0,0:19:28.12,0:19:29.12,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:19:29.71,0:19:31.75,Default,,0,0,0,,Мұның бәрі...
Dialogue: 0,0:19:31.83,0:19:35.34,Default,,0,0,0,,Менің денем оны мүлдем көтере алмайтыны таң қалдырады.
Dialogue: 0,0:19:36.04,0:19:40.30,Default,,0,0,0,,Әзірше мен оны энергетикалық сусындармен толтырып жатырмын...
Dialogue: 0,0:19:41.30,0:19:42.34,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:43.72,0:19:44.89,Default,,0,0,0,,Босс
Dialogue: 0,0:19:45.47,0:19:48.93,Default,,0,0,0,,Бұл не, Ибуки, қағып сосын аш?
Dialogue: 0,0:19:49.02,0:19:49.89,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:19:51.19,0:19:52.73,Default,,0,0,0,,Бозғылт көрінеді
Dialogue: 0,0:19:52.81,0:19:54.52,Default,,0,0,0,,Мен мұнымен жақсымын.
Dialogue: 0,0:19:55.02,0:19:56.32,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:19:57.40,0:20:00.44,Default,,0,0,0,,Барған сайын арықтайсың.
Dialogue: 0,0:20:01.24,0:20:05.32,Default,,0,0,0,,Нашар Менің әлсіреп бара жатқанымды байқадың ба?
Dialogue: 0,0:20:05.95,0:20:09.24,Default,,0,0,0,,Мен сені жоғарылатуды ұсынғанмын.
Dialogue: 0,0:20:09.33,0:20:11.62,Default,,0,0,0,,Мен жауапкершілікті сезінемін
Dialogue: 0,0:20:11.71,0:20:13.75,Default,,0,0,0,,Не... нені айтасыз?
Dialogue: 0,0:20:14.67,0:20:18.88,Default,,0,0,0,,Көкөністерді бірінші рет сатып алдым, сондықтан мен біраз қобалжыдым.
Dialogue: 0,0:20:18.96,0:20:20.88,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:20:20.96,0:20:23.93,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:20:25.14,0:20:27.14,Default,,0,0,0,,Одан әрі өзіңізді кесіп алмаңыз.
Dialogue: 0,0:20:27.80,0:20:31.56,Default,,0,0,0,,Сіз енді тек Шиши-гумидің бастығы емессіз.
Dialogue: 0,0:20:33.10,0:20:35.40,Default,,0,0,0,,Оңай өлсем қиын болар еді
Dialogue: 0,0:20:35.90,0:20:36.73,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:20:37.65,0:20:40.61,Default,,0,0,0,,Жас бастық біздің кесірімізден әлсіреп барады.
Dialogue: 0,0:20:40.69,0:20:43.07,Default,,0,0,0,,Шынымды айтсам, қарауға шыдамаймын.
Dialogue: 0,0:20:43.74,0:20:45.66,Default,,0,0,0,,Дене – капитал
Dialogue: 0,0:20:45.74,0:20:47.78,Default,,0,0,0,,Аздап тамақтаныңыз
Dialogue: 0,0:20:48.83,0:20:51.66,Default,,0,0,0,,Менің көкөністерге байғұс жабысқанымды қараңыз
Dialogue: 0,0:20:52.50,0:20:54.41,Default,,0,0,0,,Жүрегіңізде күлімсіреу ниетіңіз бар ма?
Dialogue: 0,0:20:54.50,0:20:56.00,Default,,0,0,0,,ше? Атап айтқанда, ақыр соңында
Dialogue: 0,0:20:56.08,0:20:58.17,Default,,0,0,0,,Жоқ, сен...
Dialogue: 0,0:21:01.05,0:21:04.55,Default,,0,0,0,,Бастық Қонаққа жас қасқыр келді.
Dialogue: 0,0:21:05.43,0:21:07.05,Default,,0,0,0,,Маған бастықпен кездесуге рұқсат етіңіз
Dialogue: 0,0:21:07.80,0:21:09.30,Default,,0,0,0,,Қасқыр…
Dialogue: 0,0:21:12.43,0:21:13.77,Default,,0,0,0,,Са...
Dialogue: 0,0:21:13.85,0:21:16.40,Default,,0,0,0,,Маған тисең, мен сені тістеймін.
Dialogue: 0,0:21:17.10,0:21:19.40,Default,,0,0,0,,Бәрібір кездесуге рұқсат етіңіз.
Dialogue: 0,0:21:22.03,0:21:28.03,Default,,0,0,0,,♪～
Dialogue: 0,0:22:42.31,0:22:48.32,Default,,0,0,0,,～♪
