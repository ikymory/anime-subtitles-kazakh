Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:08.04,Default,,0,0,0,,♪～
Dialogue: 0,0:01:22.33,0:01:28.33,Default,,0,0,0,,～♪
Dialogue: 0,0:01:44.31,0:01:46.31,Default,,0,0,0,,Қайсарлық таусылғанда
Dialogue: 0,0:01:46.39,0:01:50.27,Default,,0,0,0,,Өйткені, менің ішімдегі нәрсе Шиши-гумиден шыққан арыстан.
Dialogue: 0,0:01:50.36,0:01:52.40,Default,,0,0,0,,Тек осылай
Dialogue: 0,0:01:52.48,0:01:55.94,Default,,0,0,0,,Мен сенімен қарым-қатынасымды реттей алмаймын.
Dialogue: 0,0:01:57.86,0:01:58.86,Default,,0,0,0,,Босс
Dialogue: 0,0:01:58.95,0:01:59.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:00.66,0:02:03.41,Default,,0,0,0,,Мен сенімен өткен күндерім жайлы болды дедім.
Dialogue: 0,0:02:03.49,0:02:05.29,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:05.37,0:02:08.67,Default,,0,0,0,,Мен шынымен «бақытты» болдым
Dialogue: 0,0:02:09.42,0:02:10.54,Default,,0,0,0,,Луис…
Dialogue: 0,0:02:10.63,0:02:12.71,Default,,0,0,0,,Сіз мені құтқардыңыз
Dialogue: 0,0:02:18.05,0:02:19.09,Default,,0,0,0,,(Мылтық көрсету дыбысы)
Dialogue: 0,0:02:20.22,0:02:21.05,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:21.14,0:02:23.43,Default,,0,0,0,,Егер сіз шешпесеңіз
Dialogue: 0,0:02:23.51,0:02:25.31,Default,,0,0,0,,Мен оны жеймін.
Dialogue: 0,0:02:26.10,0:02:28.35,Default,,0,0,0,,Дауыс шыққан жаққа қарай ату.
Dialogue: 0,0:02:28.43,0:02:30.44,Default,,0,0,0,,Хмм... Бұл мүмкін емес, Ибуки.
Dialogue: 0,0:02:31.02,0:02:33.15,Default,,0,0,0,,Мен сені ата алмаймын.
Dialogue: 0,0:02:33.23,0:02:34.57,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:35.15,0:02:36.48,Default,,0,0,0,,Ийда…
Dialogue: 0,0:02:38.49,0:02:40.16,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:02:41.49,0:02:44.28,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:02:47.08,0:02:48.58,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:02:51.88,0:02:53.46,Default,,0,0,0,,Ибуки?
Dialogue: 0,0:02:54.59,0:02:55.92,Default,,0,0,0,,Ибуки?
Dialogue: 0,0:02:56.55,0:02:58.63,Default,,0,0,0,,Эй, көзіңді аш.
Dialogue: 0,0:02:58.72,0:03:01.38,Default,,0,0,0,,Бұл арыстан, өлме.
Dialogue: 0,0:03:01.47,0:03:02.76,Default,,0,0,0,,Ибуки!
Dialogue: 0,0:03:03.80,0:03:05.10,Default,,0,0,0,,Бұл тегін
Dialogue: 0,0:03:05.76,0:03:08.27,Default,,0,0,0,,Мен бастықты қорғай алдым.
Dialogue: 0,0:03:10.14,0:03:11.60,Default,,0,0,0,,Неге...
Dialogue: 0,0:03:12.77,0:03:13.94,Default,,0,0,0,,Ибуки
Dialogue: 0,0:03:14.02,0:03:17.03,Default,,0,0,0,,Мен сені түсіргеніме өкінбеймін.
Dialogue: 0,0:03:17.11,0:03:19.40,Default,,0,0,0,,Сіз уәде бердіңіз.
Dialogue: 0,0:03:19.49,0:03:20.70,Default,,0,0,0,,Тіпті ұйықтап қалғаннан кейін де, кем дегенде—
Dialogue: 0,0:03:20.78,0:03:24.24,Default,,0,0,0,,Біртүрлі сезініп, бастықты жей жаздаған кезде
Dialogue: 0,0:03:24.32,0:03:26.53,Default,,0,0,0,,Мені ойланбастан атып жіберіңізші
Dialogue: 0,0:03:26.62,0:03:29.95,Default,,0,0,0,,Бұл жігіт жынды болып, мені жеуге тырыспады.
Dialogue: 0,0:03:30.04,0:03:32.67,Default,,0,0,0,,Себебі мен топтан кетемін дедім.
Dialogue: 0,0:03:33.92,0:03:36.42,Default,,0,0,0,,Соңына дейін Шиши-гуми арыстаны болып
Dialogue: 0,0:03:36.50,0:03:39.46,Default,,0,0,0,,Менің бастықпен бетпе-бет келуден басқа амалым жоқ шығар.
Dialogue: 0,0:03:41.84,0:03:45.14,Default,,0,0,0,,"Урайчиге" енді қайтып келмеңіз.
Dialogue: 0,0:03:45.93,0:03:50.85,Default,,0,0,0,,Мен сені осы жерде өлтірсем, Ибукидің өлімі бекер болады.
Dialogue: 0,0:03:58.19,0:04:00.15,Default,,0,0,0,,Біз не істеуіміз керек? Легоши-кун
Dialogue: 0,0:04:00.24,0:04:02.40,Default,,0,0,0,,Әлгі әдемі жігіт қазірдің өзінде...
Dialogue: 0,0:04:02.49,0:04:04.28,Default,,0,0,0,,Менің ішімде.
Dialogue: 0,0:04:04.36,0:04:06.95,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:04:08.20,0:04:14.79,Default,,0,0,0,,（）
Dialogue: 0,0:04:14.87,0:04:16.92,Default,,0,0,0,,2 километр 100 метр қашықтықта
Dialogue: 0,0:04:17.00,0:04:18.46,Default,,0,0,0,,Эстакада астындағы қоқыс үйіндісі.
Dialogue: 0,0:04:18.54,0:04:19.92,Default,,0,0,0,,(Пинаның ыңырсыуы)
Dialogue: 0,0:04:20.00,0:04:22.88,Default,,0,0,0,,Және сол қолында кесілген
Dialogue: 0,0:04:23.55,0:04:24.63,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:25.22,0:04:29.18,Default,,0,0,0,,Сіз мені алдау үшін оған Пинаның қанын құйған шығарсыз.
Dialogue: 0,0:04:29.26,0:04:31.56,Default,,0,0,0,,Салмасы тым тәтті.
Dialogue: 0,0:04:31.64,0:04:36.81,Default,,0,0,0,,Менің ішімдегі хош иіс сақтау орны мен қорғағым келетін жануарларға арналған.
Dialogue: 0,0:04:38.98,0:04:42.86,Default,,0,0,0,,Екеуміз де шөпқоректілерге қызығатын жыртқышпыз.
Dialogue: 0,0:04:42.94,0:04:44.20,Default,,0,0,0,,Олар ұқсас.
Dialogue: 0,0:04:44.28,0:04:46.66,Default,,0,0,0,,Мұны бірге жасамаңыз!
Dialogue: 0,0:04:51.54,0:04:53.20,Default,,0,0,0,,Легоши-кун...
Dialogue: 0,0:04:53.29,0:04:56.04,Default,,0,0,0,,Шөпқоректілерді қорғайсың ба, әлде жейсің бе
Dialogue: 0,0:04:56.12,0:04:58.54,Default,,0,0,0,,Біздің жыртқыштардың күші
Dialogue: 0,0:04:58.63,0:05:00.75,Default,,0,0,0,,Өйткені, бұл жалғыздықтың орнына.
Dialogue: 0,0:05:00.84,0:05:02.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:02.92,0:05:04.38,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:05:04.47,0:05:06.55,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:05:04.47,0:05:06.55,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:05:06.55,0:05:06.63,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:05:06.63,0:05:09.93,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:05:06.63,0:05:09.93,Default,,0,0,0,,Сенің етің мен қаның менің жалғыздығымды толтырады.
Dialogue: 0,0:05:09.93,0:05:10.89,Default,,0,0,0,,Сенің етің мен қаның менің жалғыздығымды толтырады.
Dialogue: 0,0:05:11.89,0:05:15.35,Default,,0,0,0,,Лиздің жалғыздығы және менің эго
Dialogue: 0,0:05:16.14,0:05:18.02,Default,,0,0,0,,Менің эгомды тамақтандырмаңыз
Dialogue: 0,0:05:18.90,0:05:20.27,Default,,0,0,0,,Уф... Гах...
Dialogue: 0,0:05:20.36,0:05:23.86,Default,,0,0,0,,Бұл өте қиын емес пе?
Dialogue: 0,0:05:26.61,0:05:29.87,Default,,0,0,0,,Кез келген жағдайда... сізде де ет бар ма?
Dialogue: 0,0:05:29.95,0:05:34.08,Default,,0,0,0,,Сіз ешқашан түсіне алмайсыз, Лиз.
Dialogue: 0,0:05:34.16,0:05:36.75,Default,,0,0,0,,Бір ғана нәрсе маңызды
Dialogue: 0,0:05:37.33,0:05:39.33,Default,,0,0,0,,Өмірді құрметтеу
Dialogue: 0,0:05:41.59,0:05:42.92,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:05:47.30,0:05:50.34,Default,,0,0,0,,А... аа... хмм...
Dialogue: 0,0:05:50.43,0:05:51.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:53.77,0:05:56.14,Default,,0,0,0,,Уф! Арх...
Dialogue: 0,0:06:00.06,0:06:02.65,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:03.94,0:06:05.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:06.03,0:06:07.28,Default,,0,0,0,,Уау, аа... хмм...
Dialogue: 0,0:06:07.36,0:06:09.16,Default,,0,0,0,,Қарғыс атсын... Вау Уау...
Dialogue: 0,0:06:09.24,0:06:09.95,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:06:09.95,0:06:13.03,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:06:09.95,0:06:13.03,Default,,0,0,0,,Мен және Тим арасындағы шынайы достық
Dialogue: 0,0:06:13.03,0:06:13.12,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:06:13.12,0:06:15.08,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:06:13.12,0:06:15.08,Default,,0,0,0,,Мен үшінші тұлғаның қорлауына шыдай алмаймын.
Dialogue: 0,0:06:15.08,0:06:17.33,Default,,0,0,0,,Мен үшінші тұлғаның қорлауына шыдай алмаймын.
Dialogue: 0,0:06:17.41,0:06:19.58,Default,,0,0,0,,Темді сіз «өлгенше жеп қойдыңыз».
Dialogue: 0,0:06:19.67,0:06:21.79,Default,,0,0,0,,Сіз бәрін жойдыңыз.
Dialogue: 0,0:06:21.88,0:06:24.80,Default,,0,0,0,,Тем, бәрі жақсы.
Dialogue: 0,0:06:24.88,0:06:25.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:25.92,0:06:28.34,Default,,0,0,0,,Мен оның аузын жауып тастаймын.
Dialogue: 0,0:06:28.42,0:06:30.01,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:06:30.09,0:06:32.60,Default,,0,0,0,,Ааа... (шапалақ дыбысы)
Dialogue: 0,0:06:32.68,0:06:35.47,Default,,0,0,0,,Легоши... Легоши!
Dialogue: 0,0:06:35.56,0:06:37.35,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:06:37.43,0:06:40.73,Default,,0,0,0,,Дұрыс, бұл сезім
Dialogue: 0,0:06:40.81,0:06:43.19,Default,,0,0,0,,Өлім алдында тұрған тірі заттар
Dialogue: 0,0:06:43.27,0:06:46.53,Default,,0,0,0,,Сұйық тәрізді қою болады.
Dialogue: 0,0:06:46.61,0:06:48.07,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:06:50.45,0:06:51.78,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:06:54.62,0:06:57.66,Default,,0,0,0,,Бірақ сен де қаталсың.
Dialogue: 0,0:07:00.00,0:07:01.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:01.12,0:07:03.25,Default,,0,0,0,,Легоши?
Dialogue: 0,0:07:03.33,0:07:04.71,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:07:04.79,0:07:07.34,Default,,0,0,0,,Хаха... сен тірі ме едің?
Dialogue: 0,0:07:07.42,0:07:09.26,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:09.34,0:07:12.84,Default,,0,0,0,,Мен... Енді уайымдаудың не керегі бар? Ах...
Dialogue: 0,0:07:12.93,0:07:16.47,Default,,0,0,0,,Хаха, бұл рас.
Dialogue: 0,0:07:17.31,0:07:21.52,Default,,0,0,0,,Бірақ мен сізге мынаны айтуым керек.
Dialogue: 0,0:07:22.23,0:07:24.81,Default,,0,0,0,,Мен бұл туралы нақты білемін.
Dialogue: 0,0:07:24.90,0:07:25.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:25.82,0:07:30.82,Default,,0,0,0,,Темді жесем, достық жоқ.
Dialogue: 0,0:07:31.61,0:07:35.83,Default,,0,0,0,,Бұл мен үшін біржақты өлтіру болды.
Dialogue: 0,0:07:35.91,0:07:39.33,Default,,0,0,0,,Лиз... Лиз! Бір минут күте тұрыңыз...
Dialogue: 0,0:07:39.41,0:07:41.37,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:07:41.46,0:07:43.75,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:07:43.83,0:07:45.75,Default,,0,0,0,,Сол оқиға...
Dialogue: 0,0:07:45.84,0:07:48.09,Default,,0,0,0,,Сондай-ақ... толығырақ айтып беріңізші
Dialogue: 0,0:07:48.17,0:07:51.72,Default,,0,0,0,,ше? Енді бір-бірімізді өлтіреміз
Dialogue: 0,0:07:51.80,0:07:53.63,Default,,0,0,0,,Мен білемін, бірақ... хмм...
Dialogue: 0,0:07:53.72,0:07:56.26,Default,,0,0,0,,Дәл қазір мен Лиздің әңгімесін тыңдағанды жөн көремін.
Dialogue: 0,0:07:57.18,0:07:58.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:02.39,0:08:03.27,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:04.23,0:08:06.31,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:07.06,0:08:09.61,Default,,0,0,0,,Бірақ мен біреумен сөйлескім келді.
Dialogue: 0,0:08:10.15,0:08:12.78,Default,,0,0,0,,Уақытша тоқтату бар ма?
Dialogue: 0,0:08:13.53,0:08:16.82,Default,,0,0,0,,Қатар жатқан құбыжықтар
Dialogue: 0,0:08:16.91,0:08:18.37,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,0:08:18.45,0:08:21.62,Default,,0,0,0,,Құбыжықтар... біз бе?
Dialogue: 0,0:08:22.33,0:08:25.00,Default,,0,0,0,,Тем маған сол түні айтты.
Dialogue: 0,0:08:26.04,0:08:30.17,Default,,0,0,0,,«Сендер жыртқыштардың бәрі құбыжықтарсыңдар!»
Dialogue: 0,0:08:31.13,0:08:33.34,Default,,0,0,0,,Бір қызығы, мен шошыған жоқпын.
Dialogue: 0,0:08:33.42,0:08:39.10,Default,,0,0,0,,Бұл менің шынайы болмысымды көрген сөздердің құшағында болды.
Dialogue: 0,0:08:39.18,0:08:41.35,Default,,0,0,0,,Өйткені мен өте бақытты болдым
Dialogue: 0,0:08:41.43,0:08:47.52,Default,,0,0,0,,Темді жегендегі естелік әдемі естелікке айналды.
Dialogue: 0,0:08:48.86,0:08:53.32,Default,,0,0,0,,Жыртқыштардың мәні - құбыжықтар, Легоси-кун.
Dialogue: 0,0:08:54.11,0:08:57.57,Default,,0,0,0,,Себебі мен қайғылымын.
Dialogue: 0,0:08:58.20,0:09:01.62,Default,,0,0,0,,Тимнің жүзі мен дауысы әлі есімде жоқ болса да.
Dialogue: 0,0:09:02.29,0:09:03.91,Default,,0,0,0,,Дәмі мен иісі
Dialogue: 0,0:09:04.00,0:09:07.42,Default,,0,0,0,,Менің есімде әлі анық сақталған
Dialogue: 0,0:09:08.63,0:09:13.09,Default,,0,0,0,,Мен Лиз сияқты болған шығармын.
Dialogue: 0,0:09:13.17,0:09:15.68,Default,,0,0,0,,Айналамдағылардың көмегінсіз мен...
Dialogue: 0,0:09:16.38,0:09:21.01,Default,,0,0,0,,Ол Хару-чанды қатты жақсы көргендіктен, оны жеп қойған шығар.
Dialogue: 0,0:09:23.35,0:09:28.23,Default,,0,0,0,,А... енді жыртқыштың жастық шағы.
Dialogue: 0,0:09:29.23,0:09:30.06,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:30.73,0:09:33.65,Default,,0,0,0,,Мен енді өз сенімімді өзгерте алмаймын
Dialogue: 0,0:09:35.11,0:09:35.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:36.03,0:09:37.24,Default,,0,0,0,,Жақында қайта бастаймыз.
Dialogue: 0,0:09:38.45,0:09:41.78,Default,,0,0,0,,Жыртқыштардың тырнақтары мен азу тістері болады
Dialogue: 0,0:09:41.87,0:09:44.37,Default,,0,0,0,,олжадан басқа ештеңе емес.
Dialogue: 0,0:09:44.45,0:09:45.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:45.37,0:09:48.67,Default,,0,0,0,,Мен де сенің дәміңді ұмытпаймын.
Dialogue: 0,0:09:49.25,0:09:51.67,Default,,0,0,0,,Жоқ, Лиз.
Dialogue: 0,0:09:52.21,0:09:57.30,Default,,0,0,0,,Біздің тырнақтарымыз бен тістеріміз біз үшін маңызды нәрсені қорғауға арналған.
Dialogue: 0,0:09:57.97,0:09:58.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:59.72,0:10:01.60,Default,,0,0,0,,Уа, ау, ау... (түскен дыбыс)
Dialogue: 0,0:10:01.68,0:10:03.06,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:10:03.14,0:10:04.93,Default,,0,0,0,,(шарбақ қағу дыбысы)
Dialogue: 0,0:10:05.02,0:10:06.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:07.39,0:10:10.94,Default,,0,0,0,,(Луидің ауыр тыныс алуы)
Dialogue: 0,0:10:11.02,0:10:13.44,Default,,0,0,0,,Мен өте көңілді жүрмін.
Dialogue: 0,0:10:14.53,0:10:15.69,Default,,0,0,0,,Луи-сенпай?
Dialogue: 0,0:10:15.78,0:10:16.82,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:18.32,0:10:20.99,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:10:21.53,0:10:24.83,Default,,0,0,0,,Сойысты көре алмадым ғой.
Dialogue: 0,0:10:24.91,0:10:26.58,Default,,0,0,0,,Шулы!
Dialogue: 0,0:10:26.66,0:10:29.00,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:10:29.08,0:10:30.21,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:31.00,0:10:32.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:38.59,0:10:40.80,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:10:51.81,0:10:54.57,Default,,0,0,0,,(Пинаның ыңырануы)
Dialogue: 0,0:10:55.57,0:10:57.86,Default,,0,0,0,,Ха... мен жасадым
Dialogue: 0,0:10:58.40,0:10:59.36,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:59.45,0:11:00.70,Default,,0,0,0,,Қыз құлаудан басқа
Dialogue: 0,0:11:00.78,0:11:03.70,Default,,0,0,0,,Мен бұл мүйіздің пайдалы болатын күні келеді деп ойламаппын.
Dialogue: 0,0:11:04.37,0:11:05.79,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:11:08.33,0:11:10.92,Default,,0,0,0,,Сен келдің, Луи-сенпай.
Dialogue: 0,0:11:12.04,0:11:13.71,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:14.50,0:11:17.88,Default,,0,0,0,,Ақырында, мен жаңа жыл кешін осылай өткізе алғаныма сене алар емеспін.
Dialogue: 0,0:11:19.17,0:11:20.34,Default,,0,0,0,,А... бірақ...
Dialogue: 0,0:11:20.42,0:11:22.59,Default,,0,0,0,,Неліктен әлі шешілмеді? Мен қайтуым керек.
Dialogue: 0,0:11:22.68,0:11:24.18,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:11:24.26,0:11:27.68,Default,,0,0,0,,Мәміле қандай? Бүкіл денең тозған емес пе?
Dialogue: 0,0:11:27.77,0:11:29.93,Default,,0,0,0,,Ол үшін де, мен үшін де.
Dialogue: 0,0:11:30.02,0:11:33.02,Default,,0,0,0,,Жеңіс немесе жеңілу енді маңызды емес.
Dialogue: 0,0:11:33.77,0:11:36.27,Default,,0,0,0,,Екеуміз де жыртқыш ретінде өмір сүреміз.
Dialogue: 0,0:11:36.36,0:11:38.78,Default,,0,0,0,,Менің ойымша, сіз олар бір-бірімен соқтығысады деп айта аласыз ...
Dialogue: 0,0:11:39.78,0:11:43.16,Default,,0,0,0,,Мен онымен соңына дейін қарсы тұруым керек...
Dialogue: 0,0:11:44.16,0:11:48.04,Default,,0,0,0,,Мен ашуыма жауаптымын.
Dialogue: 0,0:11:48.12,0:11:49.54,Default,,0,0,0,,Жауапкершілік…
Dialogue: 0,0:11:50.70,0:11:53.87,Default,,0,0,0,,Неліктен күшіңізге жауапкершілік алмайсыз?
Dialogue: 0,0:11:55.58,0:11:59.13,Default,,0,0,0,,Бұл сөздерді қашанға дейін есте сақтайсыз?
Dialogue: 0,0:12:00.46,0:12:01.63,Default,,0,0,0,,Луи Сенпай
Dialogue: 0,0:12:02.51,0:12:08.26,Default,,0,0,0,,Сенің кесіріңнен құбыжық болмадым.
Dialogue: 0,0:12:08.35,0:12:11.52,Default,,0,0,0,,Луи, сен мені құтқардың.
Dialogue: 0,0:12:13.35,0:12:16.98,Default,,0,0,0,,Бөлінбе, өзіңді сақта
Dialogue: 0,0:12:17.06,0:12:18.77,Default,,0,0,0,,Себебі
Dialogue: 0,0:12:18.86,0:12:21.74,Default,,0,0,0,,Сен оны дәлелдеу үшін өлесің бе?
Dialogue: 0,0:12:21.82,0:12:23.57,Default,,0,0,0,,Шынайы сезімдеріңізді жасырыңыз
Dialogue: 0,0:12:23.65,0:12:27.07,Default,,0,0,0,,«Өмірлерін жыртқыш ретінде бәсекелесу» дегеніміз не?
Dialogue: 0,0:12:27.16,0:12:29.16,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:12:29.24,0:12:30.54,Default,,0,0,0,,Жүрегіңді қатайт
Dialogue: 0,0:12:31.37,0:12:33.08,Default,,0,0,0,,Сіз жыртқышсыз ба?
Dialogue: 0,0:12:33.16,0:12:36.42,Default,,0,0,0,,Менің денем күшті болғандықтан, өмір сүруге деген жігерім тым әлсіз.
Dialogue: 0,0:12:37.08,0:12:40.50,Default,,0,0,0,,Сонша өлгің келсе, өзің өл.
Dialogue: 0,0:12:42.17,0:12:44.47,Default,,0,0,0,,Луи...
Dialogue: 0,0:12:44.55,0:12:46.64,Default,,0,0,0,,(Луидің айқайы)
Dialogue: 0,0:12:46.72,0:12:49.56,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,0:12:49.64,0:12:53.52,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:12:53.60,0:12:54.69,Default,,0,0,0,,Не?
Dialogue: 0,0:12:54.77,0:12:57.15,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:12:57.23,0:12:59.90,Default,,0,0,0,,Кейінірек, кейінірек, жылы...
Dialogue: 0,0:12:59.98,0:13:00.82,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:00.90,0:13:02.07,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:13:02.15,0:13:03.86,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:03.94,0:13:06.82,Default,,0,0,0,,Ах... Мм... Мен...
Dialogue: 0,0:13:06.91,0:13:08.99,Default,,0,0,0,,(Луидің айқайы)
Dialogue: 0,0:13:09.07,0:13:10.70,Default,,0,0,0,,Мен осында тағы біраз уақыт боламын.
Dialogue: 0,0:13:10.78,0:13:14.83,Default,,0,0,0,,(Луидің айқайы)
Dialogue: 0,0:13:17.75,0:13:21.67,Default,,0,0,0,,Менің жылауым бірінші рет есімде.
Dialogue: 0,0:13:22.63,0:13:25.34,Default,,0,0,0,,Бұл соншалықты тоқтаусыз ба?
Dialogue: 0,0:13:25.42,0:13:28.64,Default,,0,0,0,,Жылау қолайлы орта емес еді.
Dialogue: 0,0:13:28.72,0:13:32.43,Default,,0,0,0,,Күшті болу, аман қалу
Dialogue: 0,0:13:32.52,0:13:34.35,Default,,0,0,0,,Қайталанатын күнәлар
Dialogue: 0,0:13:34.43,0:13:35.94,Default,,0,0,0,,Соңында...
Dialogue: 0,0:13:36.56,0:13:39.44,Default,,0,0,0,,Асыл адамымды құрбан еттім.
Dialogue: 0,0:13:40.65,0:13:43.40,Default,,0,0,0,,Өйткені мен өте әлсізмін
Dialogue: 0,0:13:45.95,0:13:47.53,Default,,0,0,0,,Легоши
Dialogue: 0,0:13:48.36,0:13:49.95,Default,,0,0,0,,Сен мықтысың
Dialogue: 0,0:13:50.57,0:13:53.20,Default,,0,0,0,,Сіз Лизбен бір мәселені шешетін боласыз.
Dialogue: 0,0:13:53.29,0:13:56.00,Default,,0,0,0,,Менің оны тоқтатуға құқығым жоқ
Dialogue: 0,0:13:56.71,0:13:58.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:58.21,0:13:59.67,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:59.75,0:14:00.88,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:00.96,0:14:04.09,Default,,0,0,0,,Осындай басың айналса, өлетін шығарсың.
Dialogue: 0,0:14:04.17,0:14:06.97,Default,,0,0,0,,Мен оны енді көргім келмейді
Dialogue: 0,0:14:07.05,0:14:09.51,Default,,0,0,0,,Аяулы дос қайтыс болғанда
Dialogue: 0,0:14:10.30,0:14:11.89,Default,,0,0,0,,Мен де баламын
Dialogue: 0,0:14:11.97,0:14:14.77,Default,,0,0,0,,Артқы базарда сол торда әлі жылап отыр
Dialogue: 0,0:14:15.64,0:14:17.69,Default,,0,0,0,,Мен сені босатамын
Dialogue: 0,0:14:18.64,0:14:20.69,Default,,0,0,0,,Сіз енді боссыз
Dialogue: 0,0:14:21.23,0:14:22.52,Default,,0,0,0,,Мен әлсіз емеспін
Dialogue: 0,0:14:23.69,0:14:24.61,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:25.19,0:14:26.74,Default,,0,0,0,,Легоши жеңіз
Dialogue: 0,0:14:26.82,0:14:28.61,Default,,0,0,0,,Күресуге күш жинаңыз
Dialogue: 0,0:14:28.70,0:14:29.91,Default,,0,0,0,,Не... не?
Dialogue: 0,0:14:30.53,0:14:32.58,Default,,0,0,0,,Мен сенің өлгеніңді көргім келмейді
Dialogue: 0,0:14:32.66,0:14:34.45,Default,,0,0,0,,Ұрыс алдында тез тамақтаныңыз
Dialogue: 0,0:14:34.54,0:14:37.37,Default,,0,0,0,,Әй... Ет жемей-ақ күшейгім келеді.
Dialogue: 0,0:14:37.45,0:14:38.46,Default,,0,0,0,,Мен жаттығып жүрмін.
Dialogue: 0,0:14:38.54,0:14:41.38,Default,,0,0,0,,Сіз шектеулер бар екенін білесіз.
Dialogue: 0,0:14:41.46,0:14:43.21,Default,,0,0,0,,Көптеген шағымдар бар.
Dialogue: 0,0:14:43.79,0:14:45.17,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:45.25,0:14:46.84,Default,,0,0,0,,Мен сенің сілекейіңді ағызамын
Dialogue: 0,0:14:49.72,0:14:51.64,Default,,0,0,0,,Бұл нөмір...
Dialogue: 0,0:14:51.72,0:14:53.39,Default,,0,0,0,,Бұл менің қарғысым
Dialogue: 0,0:14:55.06,0:14:58.31,Default,,0,0,0,,Қарғысты бұз, Легоши.
Dialogue: 0,0:15:00.19,0:15:02.44,Default,,0,0,0,,Бұл сұмдық, Луи-сенпай.
Dialogue: 0,0:15:02.52,0:15:06.73,Default,,0,0,0,,Бірақ Луи-сенпай ақыры әшкерелеген әлсіздік
Dialogue: 0,0:15:07.28,0:15:09.49,Default,,0,0,0,,Мен мұны қабылдауым керек...
Dialogue: 0,0:15:13.07,0:15:18.25,Default,,0,0,0,,«Сіз сұрағаныңыз үшін жедім» деген сылтау.
Dialogue: 0,0:15:18.33,0:15:21.33,Default,,0,0,0,,Мен қаламаймын, Луи-сенпай.
Dialogue: 0,0:15:22.29,0:15:24.50,Default,,0,0,0,,Етпен барлық байланысты кесіңіз
Dialogue: 0,0:15:24.59,0:15:30.97,Default,,0,0,0,,Мен зиянсыз қасқырға айналу жолын тұрақты түрде жасап келе жатқаныма сенемін.
Dialogue: 0,0:15:31.68,0:15:33.64,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,0:15:33.72,0:15:34.72,Default,,0,0,0,,(қабылдау дыбысы)
Dialogue: 0,0:15:35.43,0:15:38.77,Default,,0,0,0,,Мен Луи-сенпайды жегім келеді, сондықтан жеймін.
Dialogue: 0,0:15:39.35,0:15:41.39,Default,,0,0,0,,Бұл жағдайда дұрыс па?
Dialogue: 0,0:15:42.44,0:15:46.82,Default,,0,0,0,,Осымен келісе алсаңыз.
Dialogue: 0,0:15:47.94,0:15:49.32,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:15:49.40,0:15:51.78,Default,,0,0,0,,Оны ешқашан ысырап етпеңіз
Dialogue: 0,0:15:55.32,0:16:02.33,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:05.92,0:16:07.71,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:16:07.80,0:16:12.88,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:12.97,0:16:15.47,Default,,0,0,0,,Содан кейін... содан кейін...
Dialogue: 0,0:16:15.55,0:16:17.18,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:16:19.89,0:16:23.02,Default,,0,0,0,,Сіз не қажет болса да жасайсыз.
Dialogue: 0,0:16:23.10,0:16:26.65,Default,,0,0,0,,Сіз оны шынымен жедіңіз бе? Әлгі Луи-сенпай?
Dialogue: 0,0:16:27.36,0:16:29.15,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:16:29.23,0:16:32.40,Default,,0,0,0,,Луи-сенпай екеуің өте жақын едіңдер, солай емес пе?
Dialogue: 0,0:16:33.11,0:16:36.66,Default,,0,0,0,,Бірақ қазір сен мен сияқтысың.
Dialogue: 0,0:16:37.28,0:16:40.20,Default,,0,0,0,,Луи-сенпай да көкте осылай деді.
Dialogue: 0,0:16:40.29,0:16:41.70,Default,,0,0,0,,Не болды? Егер айтатын сөзің болса, мен тыңдап тұрмын
Dialogue: 0,0:16:41.79,0:16:44.83,Default,,0,0,0,,Луи-сенпай осында.
Dialogue: 0,0:16:44.92,0:16:46.42,Default,,0,0,0,,Және…
Dialogue: 0,0:16:47.00,0:16:47.96,Default,,0,0,0,,Менің ішімде!
Dialogue: 0,0:16:48.04,0:16:51.01,Default,,0,0,0,,Жүр! легоши
Dialogue: 0,0:16:52.46,0:16:55.18,Default,,0,0,0,,Луи-сенпай, сенің бір бөлігің
Dialogue: 0,0:16:55.26,0:16:57.05,Default,,0,0,0,,Ол дененің ішінде толып жатқаны сөзсіз.
Dialogue: 0,0:16:57.97,0:16:59.72,Default,,0,0,0,,Бұл тыйым салынған сиқыр сияқты
Dialogue: 0,0:16:59.81,0:17:03.52,Default,,0,0,0,,Мен бұл сиқырды бүгін кешке қолдана аламын.
Dialogue: 0,0:17:04.14,0:17:05.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:05.56,0:17:07.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:14.15,0:17:15.24,Default,,0,0,0,,Легоши
Dialogue: 0,0:17:16.86,0:17:18.62,Default,,0,0,0,,Батыр бол
Dialogue: 0,0:17:25.66,0:17:28.83,Default,,0,0,0,,Етқоректілер мен шөпқоректілердің арасындағы байланыс
Dialogue: 0,0:17:29.79,0:17:32.88,Default,,0,0,0,,Менің достығым жауапсыз болды
Dialogue: 0,0:17:34.42,0:17:39.01,Default,,0,0,0,,Сондықтан мен оны кез келген ойдан күшті деп ойладым.
Dialogue: 0,0:17:39.76,0:17:40.60,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:17:41.76,0:17:47.85,Default,,0,0,0,,Біз жесек те, жесек те, бұл екеуінің арасындағы байланыс күшейе түседі...
Dialogue: 0,0:17:49.02,0:17:50.06,Default,,0,0,0,,Тем
Dialogue: 0,0:17:50.65,0:17:52.98,Default,,0,0,0,,Тіпті сен менімен сөйлескенде
Dialogue: 0,0:17:53.07,0:17:55.86,Default,,0,0,0,,Өлімнің қасында тұрғанымда да сол күлкіңді көрсеттің.
Dialogue: 0,0:17:56.90,0:18:02.83,Default,,0,0,0,,Егер мен оған ең болмағанда оның тірі кезінде айтқанымда, бірдеңе өзгерер ме еді?
Dialogue: 0,0:18:07.41,0:18:11.04,Default,,0,0,0,,«Рахмет, Тим.»
Dialogue: 0,0:18:14.55,0:18:20.55,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:18:25.85,0:18:26.68,Default,,0,0,0,,Эй
Dialogue: 0,0:18:27.60,0:18:29.65,Default,,0,0,0,,Лиз... Лиз!
Dialogue: 0,0:18:29.73,0:18:31.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:31.19,0:18:33.36,Default,,0,0,0,,Жыл таңы атқан сияқты.
Dialogue: 0,0:18:34.02,0:18:37.15,Default,,0,0,0,,Жаңа жыл құтты болсын
Dialogue: 0,0:18:37.24,0:18:39.70,Default,,0,0,0,,Дуэль кезінде не айтасыз?
Dialogue: 0,0:18:42.41,0:18:46.08,Default,,0,0,0,,Аха... Ахахахаха...
Dialogue: 0,0:18:46.16,0:18:49.16,Default,,0,0,0,,Сен жеңдің, Легоси-кун.
Dialogue: 0,0:18:49.25,0:18:50.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:50.96,0:18:56.67,Default,,0,0,0,,Бір жылдан бері жаралы жүрегім бүгін түнде қайта тіріледі.
Dialogue: 0,0:18:57.46,0:18:59.59,Default,,0,0,0,,Ет жесең де
Dialogue: 0,0:18:59.68,0:19:03.18,Default,,0,0,0,,Осындай әдемі көзі бар адам бар ма?
Dialogue: 0,0:19:03.26,0:19:06.60,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:07.22,0:19:10.85,Default,,0,0,0,,Етқоректілер мен шөпқоректілердің арасындағы шынайы достық
Dialogue: 0,0:19:11.85,0:19:12.69,Default,,0,0,0,,Сәлем Лиз
Dialogue: 0,0:19:13.94,0:19:18.65,Default,,0,0,0,,Осындай жағдайда қандай сөздер айтуым керек?
Dialogue: 0,0:19:19.32,0:19:24.12,Default,,0,0,0,,Мәжбүрлі сөздер Басқа адамды қорқытатын сөздер...
Dialogue: 0,0:19:25.08,0:19:26.49,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:26.58,0:19:31.12,Default,,0,0,0,,Етқоректілерге енді сөздермен бетпе-бет келуге болмайды
Dialogue: 0,0:19:31.21,0:19:34.54,Default,,0,0,0,,Сіздің істегеніңіз кешірілмейді.
Dialogue: 0,0:19:35.42,0:19:38.38,Default,,0,0,0,,Сенің жалғыздығыңды байқай алмадым.
Dialogue: 0,0:19:38.46,0:19:40.01,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:40.63,0:19:42.05,Default,,0,0,0,,Луи-сенпай...
Dialogue: 0,0:19:42.13,0:19:42.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:43.05,0:19:45.35,Default,,0,0,0,,Аға
Dialogue: 0,0:19:45.43,0:19:47.06,Default,,0,0,0,,Ауруханаға асығыңыз...
Dialogue: 0,0:19:47.14,0:19:48.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:48.68,0:19:51.77,Default,,0,0,0,,Сонымен қатар, сыпайылық ретінде мынаны айтайын.
Dialogue: 0,0:19:53.44,0:19:54.77,Default,,0,0,0,,Луи Сенпай
Dialogue: 0,0:19:56.11,0:19:57.69,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:19:58.61,0:20:01.53,Default,,0,0,0,,Өмірімдегі алғашқы және соңғы етім сен болғаныңа қуанамын.
Dialogue: 0,0:20:03.86,0:20:05.12,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,0:20:05.74,0:20:09.58,Default,,0,0,0,,Мен араласқан етқоректілер
Dialogue: 0,0:20:09.66,0:20:13.87,Default,,0,0,0,,Сен менің өміріме осылай араласа бересің.
Dialogue: 0,0:20:13.96,0:20:15.50,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,0:20:17.04,0:20:18.34,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:18.42,0:20:20.71,Default,,0,0,0,,Бетіңізді дұрыстап сүртіңіз және күліңіз
Dialogue: 0,0:20:20.80,0:20:22.26,Default,,0,0,0,,Ол бұзақыға ұқсайды.
Dialogue: 0,0:20:22.34,0:20:24.51,Default,,0,0,0,,Хмм... аа... кешіріңіз.
Dialogue: 0,0:20:28.01,0:20:31.48,Default,,0,0,0,,Жегендердің әлсіздігі мен азабы
Dialogue: 0,0:20:32.56,0:20:35.73,Default,,0,0,0,,Етқоректілердің азуының қарғысы
Dialogue: 0,0:20:36.40,0:20:39.61,Default,,0,0,0,,Оны тек жыртқыштардың азу тістері шеше алды.
Dialogue: 0,0:20:40.65,0:20:42.15,Default,,0,0,0,,Бұл тісте...
Dialogue: 0,0:20:42.82,0:20:44.53,Default,,0,0,0,,Менің қарғысым ақыры жойылды.
Dialogue: 0,0:20:44.53,0:20:47.37,Default,,0,0,0,,Менің қарғысым ақыры жойылды.
Dialogue: 0,0:20:44.53,0:20:47.37,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:20:47.37,0:20:51.54,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:20:57.79,0:21:03.80,Default,,0,0,0,,♪～
Dialogue: 0,0:21:06.84,0:21:12.06,Default,,0,0,0,,Осыдан кейін Луи-сенпай ауруханаға жеткізіліп, аман қалды.
Dialogue: 0,0:21:12.93,0:21:16.73,Default,,0,0,0,,Лиз екеумізді өлтіруші ретінде қамауға алды.
Dialogue: 0,0:21:17.60,0:21:18.44,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:19.15,0:21:22.99,Default,,0,0,0,,Барлығының айғақтарының арқасында мен босатылдым.
Dialogue: 0,0:21:24.78,0:21:27.45,Default,,0,0,0,,Соттылығым бар өмірім
Dialogue: 0,0:21:27.53,0:21:30.53,Default,,0,0,0,,Бұл қиын болатын сияқты.
Dialogue: 0,0:21:31.66,0:21:35.62,Default,,0,0,0,,Хару-чанмен кездесу, Луи-сенпаймен кездесу
Dialogue: 0,0:21:35.71,0:21:40.34,Default,,0,0,0,,Өзіме таққан байларым – қазынам.
Dialogue: 0,0:21:41.96,0:21:44.21,Default,,0,0,0,,Хару-чан, көріп тұрсың ба.
Dialogue: 0,0:21:44.30,0:21:45.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:48.68,0:21:51.64,Default,,0,0,0,,Мен мектепті тастаймын.
Dialogue: 0,0:21:51.72,0:21:53.72,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:21:54.81,0:21:57.23,Default,,0,0,0,,Мен... Аударма... Эй...
Dialogue: 0,0:21:57.31,0:21:58.15,Default,,0,0,0,,Хаа…
Dialogue: 0,0:21:59.06,0:22:01.36,Default,,0,0,0,,Бұл өте жаман.
Dialogue: 0,0:22:01.44,0:22:03.57,Default,,0,0,0,,Бетімде тыртық көбейіп барады.
Dialogue: 0,0:22:04.28,0:22:06.65,Default,,0,0,0,,Сіз маған жұмыстан шығу себебін де айтпайсыз.
Dialogue: 0,0:22:06.74,0:22:09.87,Default,,0,0,0,,Ум... уһ, кешіріңіз.
Dialogue: 0,0:22:09.95,0:22:11.87,Default,,0,0,0,,Бұл қазірдің өзінде...
Dialogue: 0,0:22:11.95,0:22:15.33,Default,,0,0,0,,Мен сені уайымдаудан шаршадым, Легоши.
Dialogue: 0,0:22:15.41,0:22:16.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:18.25,0:22:21.63,Default,,0,0,0,,Бірақ мен өмірімді осылай өткіземін.
Dialogue: 0,0:22:22.21,0:22:25.38,Default,,0,0,0,,Құйрығымды бұлғап, бөтен болып өмір сүре аламын.
Dialogue: 0,0:22:26.72,0:22:28.84,Default,,0,0,0,,Дүниеде әлі де көп нәрсе бар
Dialogue: 0,0:22:28.93,0:22:30.34,Default,,0,0,0,,Үйренетін нәрселер өте көп
Dialogue: 0,0:22:30.34,0:22:31.68,Default,,0,0,0,,Үйренетін нәрселер өте көп
Dialogue: 0,0:22:30.34,0:22:31.68,Default,,0,0,0,,Хаа…
Dialogue: 0,0:22:32.76,0:22:34.77,Default,,0,0,0,,Менің өмір жолымды табайық
Dialogue: 0,0:22:34.85,0:22:37.23,Default,,0,0,0,,Мен жігіт тауып аламын
Dialogue: 0,0:22:37.31,0:22:39.60,Default,,0,0,0,,Не, күте тұр... дұрыс.
Dialogue: 0,0:22:39.69,0:22:41.35,Default,,0,0,0,,''Дұрыс''
Dialogue: 0,0:22:41.44,0:22:43.23,Default,,0,0,0,,Сонымен не істеуіміз керек? Легоши-кун
Dialogue: 0,0:22:43.32,0:22:43.77,Default,,0,0,0,,Хмм... ``Мен не істеуім керек?''...
Dialogue: 0,0:22:43.77,0:22:45.19,Default,,0,0,0,,Хмм... ``Мен не істеуім керек?''... ~♪
Dialogue: 0,0:22:45.19,0:22:45.28,Default,,0,0,0,,～♪
Dialogue: 0,0:22:45.28,0:22:47.32,Default,,0,0,0,,~♪ Мен бұл туралы қазірден бастап ақырын ойлайтын боламын.
Dialogue: 0,0:22:47.32,0:22:47.40,Default,,0,0,0,,～♪
Dialogue: 0,0:22:47.40,0:22:49.78,Default,,0,0,0,,～♪ ``Ойлау''...
Dialogue: 0,0:22:51.28,0:22:57.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory