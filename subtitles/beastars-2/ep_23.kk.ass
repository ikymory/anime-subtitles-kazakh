Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.08,0:00:08.09,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.91,0:01:29.17,Default,,0,0,0,,～♪
Dialogue: 0,0:01:32.92,0:01:36.72,Default,,0,0,0,,（）
Dialogue: 0,0:01:36.80,0:01:37.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:37.84,0:01:42.47,Default,,0,0,0,,Үлпілдек көбелекте өмірдің иісі бар
Dialogue: 0,0:01:44.39,0:01:46.98,Default,,0,0,0,,Маған сөйлеңдер, жәндіктер.
Dialogue: 0,0:01:47.94,0:01:50.23,Default,,0,0,0,,Бізге сіздің көмегіңіз қажет.
Dialogue: 0,0:01:57.82,0:02:00.03,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:02:00.12,0:02:01.16,Default,,0,0,0,,Иә
Dialogue: 0,0:02:01.24,0:02:03.95,Default,,0,0,0,,Мен оны тірідей жеймін
Dialogue: 0,0:02:04.54,0:02:05.62,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:06.83,0:02:10.58,Default,,0,0,0,,Хаа... Мен қобалжыдым.
Dialogue: 0,0:02:11.38,0:02:14.05,Default,,0,0,0,,Гохин мырзаның жәндіктерді жеу тәжірибесі жоқ...
Dialogue: 0,0:02:14.13,0:02:15.84,Default,,0,0,0,,Жоқ, олай емеспін.
Dialogue: 0,0:02:15.92,0:02:18.55,Default,,0,0,0,,Пандалар ақуызға қызықпайды.
Dialogue: 0,0:02:19.59,0:02:23.22,Default,,0,0,0,,Жәндіктерді жеу тірі жәндіктерге ұқсайды.
Dialogue: 0,0:02:23.97,0:02:25.81,Default,,0,0,0,,Әркім одан аулақ болғысы келеді
Dialogue: 0,0:02:25.89,0:02:29.77,Default,,0,0,0,,Мен оны кінәлі сезінбей жегім келмейді.
Dialogue: 0,0:02:32.27,0:02:34.98,Default,,0,0,0,,Өмірді жеу…
Dialogue: 0,0:02:36.73,0:02:38.44,Default,,0,0,0,,Қылмыс
Dialogue: 0,0:02:41.36,0:02:43.62,Default,,0,0,0,,Бұл менмендік.
Dialogue: 0,0:02:44.87,0:02:47.29,Default,,0,0,0,,Қатты өмір сүрсем де
Dialogue: 0,0:02:47.37,0:02:49.37,Default,,0,0,0,,Егер жәндік болса, оны жеуге болады.
Dialogue: 0,0:02:49.46,0:02:51.46,Default,,0,0,0,,Мен неге ойлаймын
Dialogue: 0,0:02:51.54,0:02:52.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:52.46,0:02:54.79,Default,,0,0,0,,Қазір не айтып тұрсың?
Dialogue: 0,0:02:54.88,0:02:57.92,Default,,0,0,0,,Басында тәкаппар адам болсаң керек.
Dialogue: 0,0:02:58.01,0:02:59.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:59.09,0:03:03.51,Default,,0,0,0,,Қыз болсам да, Кешіре алмаған адамды ұрамын.
Dialogue: 0,0:03:03.60,0:03:05.68,Default,,0,0,0,,Айналадағыларға әділеттілік сезімін таңу
Dialogue: 0,0:03:05.76,0:03:09.39,Default,,0,0,0,,Қоянның бөксесін мәңгілікке қуу...
Dialogue: 0,0:03:09.48,0:03:13.56,Default,,0,0,0,,Сөзбен айтсам, мен азапты адаммын ба?
Dialogue: 0,0:03:13.65,0:03:14.81,Default,,0,0,0,,Бірақ бұл жақсы.
Dialogue: 0,0:03:14.90,0:03:16.07,Default,,0,0,0,,Е...
Dialogue: 0,0:03:16.15,0:03:20.24,Default,,0,0,0,,Сіздің жауынгерлік рухыңыз тек жыртқыштарға ғана тән.
Dialogue: 0,0:03:20.32,0:03:22.78,Default,,0,0,0,,Біреу үшін ғана өседі
Dialogue: 0,0:03:24.74,0:03:26.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:26.66,0:03:30.12,Default,,0,0,0,,Иә, оған көмектесу мүмкін емес.
Dialogue: 0,0:03:35.08,0:03:37.05,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:03:37.71,0:03:39.09,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,0:03:39.67,0:03:42.01,Default,,0,0,0,,Өмірді алудың мәні
Dialogue: 0,0:03:42.09,0:03:43.80,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:03:46.14,0:03:47.47,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:03:50.73,0:03:53.81,Default,,0,0,0,,Хмм... Мен күткеннен де серпімді.
Dialogue: 0,0:03:53.90,0:03:57.40,Default,,0,0,0,,Бұл сыртқы тері ме?
Dialogue: 0,0:03:57.48,0:04:00.07,Default,,0,0,0,,А... аяғым тіліммен қозғалады.
Dialogue: 0,0:04:00.15,0:04:00.99,Default,,0,0,0,,Уау Уау...
Dialogue: 0,0:04:03.11,0:04:07.03,Default,,0,0,0,,Ащы мен тұзды...
Dialogue: 0,0:04:07.12,0:04:09.66,Default,,0,0,0,,Шөп және жер иісі
Dialogue: 0,0:04:09.74,0:04:11.75,Default,,0,0,0,,Желдің иісі
Dialogue: 0,0:04:11.83,0:04:14.42,Default,,0,0,0,,Концентрленген және күрделі…
Dialogue: 0,0:04:14.50,0:04:16.38,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:17.42,0:04:18.92,Default,,0,0,0,,Өмірдің дәмі!
Dialogue: 0,0:04:20.09,0:04:21.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:21.84,0:04:22.72,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:04:23.88,0:04:26.22,Default,,0,0,0,,Сіз мені түкіргіңіз келе ме?
Dialogue: 0,0:04:26.30,0:04:28.64,Default,,0,0,0,,Көбелек...
Dialogue: 0,0:04:28.72,0:04:31.10,Default,,0,0,0,,Бұл сен кінәлі
Dialogue: 0,0:04:31.18,0:04:35.06,Default,,0,0,0,,Дернәсілден өсу мүмкін болмаса да.
Dialogue: 0,0:04:36.56,0:04:38.90,Default,,0,0,0,,Мен... Кешіріңіз.
Dialogue: 0,0:04:39.82,0:04:43.32,Default,,0,0,0,,Мен сені... менсінбеген шығармын.
Dialogue: 0,0:04:43.40,0:04:48.03,Default,,0,0,0,,Мен күшті болғым келді, сондықтан өмірді кемсіттім.
Dialogue: 0,0:04:48.12,0:04:50.62,Default,,0,0,0,,Маған қарғыс айтуыңызды өтінемін
Dialogue: 0,0:04:50.70,0:04:52.83,Default,,0,0,0,,Кез келген жазаны қабылдаңыз
Dialogue: 0,0:04:52.91,0:04:55.04,Default,,0,0,0,,Бұл қабылданбайды
Dialogue: 0,0:04:55.12,0:05:01.34,Default,,0,0,0,,Құрметсіздік Кемсіту Жаза Кешіру…
Dialogue: 0,0:05:01.42,0:05:06.30,Default,,0,0,0,,Мұндай сөздер бізге жәндіктер үшін мағынасыз.
Dialogue: 0,0:05:07.22,0:05:11.35,Default,,0,0,0,,Бізде сендер сияқты тілек жоқ.
Dialogue: 0,0:05:11.43,0:05:14.81,Default,,0,0,0,,Бір ғана нәрсе маңызды
Dialogue: 0,0:05:14.89,0:05:16.94,Default,,0,0,0,,Өмірді құрметтеу
Dialogue: 0,0:05:18.23,0:05:21.52,Default,,0,0,0,,Өмірді құрметтеу...
Dialogue: 0,0:05:22.28,0:05:27.20,Default,,0,0,0,,Тамақтану басқа адамды түсіну және құрметтеу дегенді білдіреді.
Dialogue: 0,0:05:27.28,0:05:31.03,Default,,0,0,0,,Бірегей жанды қабылдау
Dialogue: 0,0:05:32.79,0:05:36.46,Default,,0,0,0,,(Легошидің жылауы)
Dialogue: 0,0:05:36.54,0:05:38.46,Default,,0,0,0,,Көз жасы...
Dialogue: 0,0:05:38.54,0:05:41.00,Default,,0,0,0,,Көз жасын төкпейміз
Dialogue: 0,0:05:41.67,0:05:45.05,Default,,0,0,0,,Мен де... Мен жәндік болып туғым келді.
Dialogue: 0,0:05:46.38,0:05:49.09,Default,,0,0,0,,Қасқыр болып туған
Dialogue: 0,0:05:49.84,0:05:51.93,Default,,0,0,0,,Себебі мен ойға толымын
Dialogue: 0,0:05:52.01,0:05:54.27,Default,,0,0,0,,Тірі болғанның жаны ауырады.
Dialogue: 0,0:05:54.35,0:05:56.02,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:05:56.10,0:05:58.39,Default,,0,0,0,,Жәндіктер де айтарлықтай қиын.
Dialogue: 0,0:05:58.48,0:06:01.19,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:06:01.27,0:06:02.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:02.52,0:06:04.78,Default,,0,0,0,,Мен уақытты жақсы өткіздім
Dialogue: 0,0:06:05.36,0:06:08.49,Default,,0,0,0,,Қош бол, күшті жаратылыс.
Dialogue: 0,0:06:08.57,0:06:10.07,Default,,0,0,0,,Шынайы өмір сүр
Dialogue: 0,0:06:11.20,0:06:13.58,Default,,0,0,0,,Мен ет пен қан сияқтымын
Dialogue: 0,0:06:19.54,0:06:21.25,Default,,0,0,0,,О, ояусың ба?
Dialogue: 0,0:06:21.33,0:06:22.71,Default,,0,0,0,,Енді бұл – қабілетке қарсы қабілет, техникаға қарсы техника, рухқа қарсы рух!
Dialogue: 0,0:06:22.79,0:06:26.09,Default,,0,0,0,,Мен дернәсілді жегенде есінен танып қалдым.
Dialogue: 0,0:06:26.17,0:06:28.76,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл тәуелділік пе?
Dialogue: 0,0:06:28.84,0:06:32.10,Default,,0,0,0,,Жоқ, жоқ... осының бәрі...
Dialogue: 0,0:06:32.18,0:06:33.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:34.47,0:06:37.35,Default,,0,0,0,,Бұл түс сияқты болды
Dialogue: 0,0:06:37.43,0:06:39.64,Default,,0,0,0,,Мен шынымен жақсы сөздер естігендей болдым.
Dialogue: 0,0:06:40.65,0:06:41.65,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:06:41.73,0:06:43.94,Default,,0,0,0,,Ал, бетіңізге қараңыз.
Dialogue: 0,0:06:44.48,0:06:46.03,Default,,0,0,0,,Сіз өте жақсы көрінесіз.
Dialogue: 0,0:06:46.11,0:06:47.94,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:06:48.57,0:06:51.99,Default,,0,0,0,,Иә? А... шаш...
Dialogue: 0,0:06:53.28,0:06:54.53,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:55.28,0:06:57.66,Default,,0,0,0,,Хмм... у...
Dialogue: 0,0:06:57.75,0:07:01.21,Default,,0,0,0,,Мен Луи-сенпайға барып, шешімімді білдіргім келеді.
Dialogue: 0,0:07:02.13,0:07:03.50,Default,,0,0,0,,Егер бұл орын алса, сіз білесіз.
Dialogue: 0,0:07:03.58,0:07:05.46,Default,,0,0,0,,Хмм…
Dialogue: 0,0:07:05.55,0:07:06.38,Default,,0,0,0,,А... (Гухин тілін шертеді)
Dialogue: 0,0:07:06.46,0:07:07.59,Default,,0,0,0,,Бұл жалғыз нұсқа
Dialogue: 0,0:07:07.67,0:07:09.09,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:07:09.17,0:07:10.01,Default,,0,0,0,,А...
Dialogue: 0,0:07:13.97,0:07:17.14,Default,,0,0,0,,Тұз тұзды
Dialogue: 0,0:07:17.22,0:07:20.02,Default,,0,0,0,,Қант тәтті
Dialogue: 0,0:07:20.10,0:07:22.52,Default,,0,0,0,,Сірке суы қышқыл
Dialogue: 0,0:07:23.35,0:07:25.31,Default,,0,0,0,,Дәм қайта келеді
Dialogue: 0,0:07:25.40,0:07:27.78,Default,,0,0,0,,Лиз, менің қарным ашты.
Dialogue: 0,0:07:27.86,0:07:30.82,Default,,0,0,0,,Мен бүгін сенімдімін, сондықтан оны асыға күтіңіздер.
Dialogue: 0,0:07:30.90,0:07:32.95,Default,,0,0,0,,Иә? Бірдеңе Лиз... (Аю В) Иә?
Dialogue: 0,0:07:33.03,0:07:35.87,Default,,0,0,0,,Соңғы аптада денеңіз өсті ме?
Dialogue: 0,0:07:35.95,0:07:37.58,Default,,0,0,0,,Сіз дәрі қабылдайсыз ба?
Dialogue: 0,0:07:37.66,0:07:39.66,Default,,0,0,0,,Менің ойымша, сіз ішіп отырсыз.
Dialogue: 0,0:07:39.75,0:07:43.37,Default,,0,0,0,,Дәрі-дәрмек жинадым, бұл жай ғана вегетациялық кезең.
Dialogue: 0,0:07:43.46,0:07:44.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:44.38,0:07:46.38,Default,,0,0,0,,Не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:48.00,0:07:48.63,Default,,0,0,0,,(құбырдың құлаған дыбысы)
Dialogue: 0,0:07:48.63,0:07:49.09,Default,,0,0,0,,(құбырдың құлаған дыбысы)
Dialogue: 0,0:07:48.63,0:07:49.09,Default,,0,0,0,,Менің жан дүнием қозғалады
Dialogue: 0,0:07:49.09,0:07:51.34,Default,,0,0,0,,Менің жан дүнием қозғалады
Dialogue: 0,0:07:51.42,0:07:54.89,Default,,0,0,0,,Мен саған қандай болсам, солай қараймын.
Dialogue: 0,0:07:54.97,0:07:56.35,Default,,0,0,0,,Легоши-кун
Dialogue: 0,0:07:56.43,0:07:57.89,Default,,0,0,0,,Ммм
Dialogue: 0,0:07:57.97,0:08:00.10,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:08:03.64,0:08:04.85,Default,,0,0,0,,Босс
Dialogue: 0,0:08:04.94,0:08:08.69,Default,,0,0,0,,Мүйізді бас және жалды бас
Dialogue: 0,0:08:08.77,0:08:11.28,Default,,0,0,0,,Сіздің ойыңызша, таксидермия қайсысына тұрарлық?
Dialogue: 0,0:08:11.90,0:08:13.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:13.11,0:08:14.74,Default,,0,0,0,,Біз астыртын ұйымбыз.
Dialogue: 0,0:08:14.82,0:08:18.20,Default,,0,0,0,,Сіз жасырынған жеріңізді медальдармен безендіргіңіз келеді, солай ма?
Dialogue: 0,0:08:18.28,0:08:20.75,Default,,0,0,0,,Мысалы, жау бастықтың басы
Dialogue: 0,0:08:20.83,0:08:22.54,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:08:22.62,0:08:24.83,Default,,0,0,0,,Қызық, мұндай кішкентай басты интерьерді безендіруге бола ма?
Dialogue: 0,0:08:24.92,0:08:25.75,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:25.83,0:08:28.25,Default,,0,0,0,,Бұл әзіл емес
Dialogue: 0,0:08:28.34,0:08:30.84,Default,,0,0,0,,Бізді қауіп төндіретін ұйым.
Dialogue: 0,0:08:30.92,0:08:32.63,Default,,0,0,0,,Бастықтың басына келсең...
Dialogue: 0,0:08:32.72,0:08:34.18,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:08:34.26,0:08:37.14,Default,,0,0,0,,Оның орнына сені өлтіру керек, Ибуки.
Dialogue: 0,0:08:38.26,0:08:40.10,Default,,0,0,0,,Мен өлсем ше?
Dialogue: 0,0:08:40.18,0:08:43.94,Default,,0,0,0,,Қол астындағы қызметкер бастықты жеп қойды деген қауесет тез тарады.
Dialogue: 0,0:08:45.02,0:08:48.06,Default,,0,0,0,,Мұндай жақсы толқынға міну босқа кетті.
Dialogue: 0,0:08:48.15,0:08:49.61,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:49.69,0:08:51.07,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:08:51.15,0:08:53.40,Default,,0,0,0,,Мен өзімді қуана құрбан етемін, бастық.
Dialogue: 0,0:08:57.11,0:08:59.37,Default,,0,0,0,,Мен біраз уақыт ваннаға барамын.
Dialogue: 0,0:08:59.45,0:09:00.62,Default,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:09:00.70,0:09:02.91,Default,,0,0,0,,Әй, екі виски тастары.
Dialogue: 0,0:09:03.00,0:09:05.16,Default,,0,0,0,,Эй, мен күшті алкогольді ұнатпаймын.
Dialogue: 0,0:09:05.25,0:09:06.79,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:09:06.87,0:09:08.54,Default,,0,0,0,,Олай болса, тәтті коктейль.
Dialogue: 0,0:09:08.63,0:09:09.84,Default,,0,0,0,,Аты жоқ.
Dialogue: 0,0:09:10.71,0:09:12.67,Default,,0,0,0,,Ыстық сумен араластырылған қара өрік шарабы
Dialogue: 0,0:09:17.59,0:09:20.30,Default,,0,0,0,,Бастықтың ішімдігі әлсіз болды ма?
Dialogue: 0,0:09:20.89,0:09:24.23,Default,,0,0,0,,Сіз мені кешіре аласыз деп ойлаймын.
Dialogue: 0,0:09:25.85,0:09:27.65,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:37.86,0:09:40.58,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:09:40.66,0:09:41.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:42.79,0:09:46.29,Default,,0,0,0,,Өтінемін, айқайлама, Луи-сенпай.
Dialogue: 0,0:09:54.96,0:09:58.09,Default,,0,0,0,,Мұның әртүрлі себептері бар.
Dialogue: 0,0:09:58.18,0:10:00.05,Default,,0,0,0,,А... мен мұны түсіндірмес бұрын.
Dialogue: 0,0:10:00.14,0:10:02.22,Default,,0,0,0,,Қарапайым тілмен айтқанда, бұл Легоши.
Dialogue: 0,0:10:02.31,0:10:04.43,Default,,0,0,0,,...Түсіндің бе? Хахаха
Dialogue: 0,0:10:04.52,0:10:06.81,Default,,0,0,0,,Мына кроссовка жаман емес пе?
Dialogue: 0,0:10:06.89,0:10:08.44,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:10:08.52,0:10:11.15,Default,,0,0,0,,Мен оны өлтірмесем, ақымақ бола беретін адам ма?
Dialogue: 0,0:10:11.23,0:10:11.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:11.73,0:10:12.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:11.73,0:10:12.36,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:10:12.36,0:10:13.15,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:10:13.23,0:10:15.11,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:16.94,0:10:19.70,Default,,0,0,0,,Бастықты қандай да бір үлкен әйел нысанаға алады.
Dialogue: 0,0:10:19.78,0:10:22.20,Default,,0,0,0,,Мен сені кездестірдім, бірақ...
Dialogue: 0,0:10:22.78,0:10:24.12,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:10:24.20,0:10:27.25,Default,,0,0,0,,Мен Луи-сенпайдың ашулы атмосферасын шынымен сезінемін.
Dialogue: 0,0:10:27.33,0:10:31.33,Default,,0,0,0,,Бұл ақымақ киімнің мақсаты не?
Dialogue: 0,0:10:31.42,0:10:34.21,Default,,0,0,0,,Мен сені ренжітейін бе, ақымақ?
Dialogue: 0,0:10:34.30,0:10:36.34,Default,,0,0,0,,Бастық да 18-де ер адам.
Dialogue: 0,0:10:36.42,0:10:39.97,Default,,0,0,0,,Мен сіздің жеке өміріңізге араласпаймын, бірақ шынымды айтсам...
Dialogue: 0,0:10:40.05,0:10:42.80,Default,,0,0,0,,Бұл әйел өте ұсқынсыз.
Dialogue: 0,0:10:42.89,0:10:45.64,Default,,0,0,0,,Бұл жағдайда не істеу керек
Dialogue: 0,0:10:46.85,0:10:48.81,Default,,0,0,0,,Ибуки ха
Dialogue: 0,0:10:49.44,0:10:50.52,Default,,0,0,0,,Оны алып тастаңыз
Dialogue: 0,0:10:50.60,0:10:52.10,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:10:52.19,0:10:55.69,Default,,0,0,0,,Соққы аймағы күткендей кең.
Dialogue: 0,0:10:56.40,0:10:58.40,Default,,0,0,0,,Сенпай мен бақыттымын
Dialogue: 0,0:10:58.49,0:10:59.70,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:11:03.49,0:11:05.28,Default,,0,0,0,,Сөзге тікелей көшейік.
Dialogue: 0,0:11:05.37,0:11:06.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:06.29,0:11:08.75,Default,,0,0,0,,Сіз қылмыскерді білесіз.
Dialogue: 0,0:11:08.83,0:11:10.58,Default,,0,0,0,,Сіз айтып отырғаныңыз осы емес пе?
Dialogue: 0,0:11:10.67,0:11:13.54,Default,,0,0,0,,Ах... мм... бұл Лиз еді.
Dialogue: 0,0:11:13.63,0:11:18.26,Default,,0,0,0,,Қарасам, қоңыр аю...
Dialogue: 0,0:11:18.34,0:11:20.05,Default,,0,0,0,,Сен сол тұмарға ұқсайсың.
Dialogue: 0,0:11:20.13,0:11:22.39,Default,,0,0,0,,Сізде тыныш мектеп өмірі болды ма?
Dialogue: 0,0:11:22.47,0:11:24.55,Default,,0,0,0,,Дұрыс. Сен мені кешіре алмайсың.
Dialogue: 0,0:11:25.26,0:11:27.26,Default,,0,0,0,,Сондықтан мен дуэльге шығамын.
Dialogue: 0,0:11:27.35,0:11:30.10,Default,,0,0,0,,ше? Жоқ, полиция, оларды тапсырыңыз.
Dialogue: 0,0:11:30.18,0:11:32.94,Default,,0,0,0,,Бұл мен және оның арасындағы ұрыс.
Dialogue: 0,0:11:33.02,0:11:34.61,Default,,0,0,0,,Луи Сенпай
Dialogue: 0,0:11:34.69,0:11:36.86,Default,,0,0,0,,Онда болыңыз.
Dialogue: 0,0:11:42.11,0:11:42.95,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:11:43.03,0:11:44.12,Default,,0,0,0,,А...
Dialogue: 0,0:11:44.20,0:11:46.78,Default,,0,0,0,,Мен үшін сенің өміріңді қалай өткізетінің маңызды емес.
Dialogue: 0,0:11:47.41,0:11:49.41,Default,,0,0,0,,Сенің енді маған қатысың жоқ.
Dialogue: 0,0:11:50.37,0:11:51.50,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:51.58,0:11:55.63,Default,,0,0,0,,Мен енді сізден қоғамдық қоғамға қайта келуіңізді сұрамаймын.
Dialogue: 0,0:11:55.71,0:11:59.30,Default,,0,0,0,,Мен оны мен құрметтейтін Луи-сенпай көрсе екен деймін.
Dialogue: 0,0:11:59.38,0:12:01.05,Default,,0,0,0,,Менің өмір жолым
Dialogue: 0,0:12:01.13,0:12:03.72,Default,,0,0,0,,Ал... Мен өліп жатқан шығармын.
Dialogue: 0,0:12:04.72,0:12:07.85,Default,,0,0,0,,Сенің арқаңда осы уақытқа дейін келдім.
Dialogue: 0,0:12:08.97,0:12:13.06,Default,,0,0,0,,Бұл менің соңғы сәтім болса, соған куә болғаныңызды қалаймын.
Dialogue: 0,0:12:15.02,0:12:15.86,Default,,0,0,0,,Менің тамырларым жарылып кетеді?
Dialogue: 0,0:12:16.86,0:12:18.73,Default,,0,0,0,,Жоқ, сіз...
Dialogue: 0,0:12:18.82,0:12:21.69,Default,,0,0,0,,Бұл бет әлпет, ә...
Dialogue: 0,0:12:21.78,0:12:23.40,Default,,0,0,0,,Мен күлдім мен күлдім.
Dialogue: 0,0:12:23.49,0:12:24.32,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:12:24.41,0:12:25.78,Default,,0,0,0,,Жарайды деп есептелді
Dialogue: 0,0:12:28.33,0:12:32.29,Default,,0,0,0,,Жаңа жыл түні сағат 23:00-де Ғасра эстакадасының астында
Dialogue: 0,0:12:32.37,0:12:33.21,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:12:33.29,0:12:35.75,Default,,0,0,0,,Эй Корра, бармайық.
Dialogue: 0,0:12:36.63,0:12:37.46,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:12:38.17,0:12:39.75,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:12:39.84,0:12:41.13,Default,,0,0,0,,Босс
Dialogue: 0,0:12:41.88,0:12:43.88,Default,,0,0,0,,Бұл үлкен әйел қайда?
Dialogue: 0,0:12:43.97,0:12:45.43,Default,,0,0,0,,Хутта
Dialogue: 0,0:12:45.51,0:12:48.60,Default,,0,0,0,,Мм... Менің ойымша, бұл дұрыс.
Dialogue: 0,0:12:50.47,0:12:52.18,Default,,0,0,0,,Кім барады?
Dialogue: 0,0:12:52.89,0:12:54.31,Default,,0,0,0,,Ақымақ жігіт
Dialogue: 0,0:13:00.19,0:13:01.94,Default,,0,0,0,,（）
Dialogue: 0,0:13:02.69,0:13:06.45,Default,,0,0,0,,Бұл сенің иісің ғой, Пина-кун.
Dialogue: 0,0:13:07.95,0:13:09.62,Default,,0,0,0,,Бүгін түнде дуэль бар ма?
Dialogue: 0,0:13:09.70,0:13:11.74,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:13:11.83,0:13:13.75,Default,,0,0,0,,Сіз мені қолдауға келесіз бе?
Dialogue: 0,0:13:13.83,0:13:15.16,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:15.25,0:13:17.21,Default,,0,0,0,,Сонда бұл не үшін?
Dialogue: 0,0:13:17.88,0:13:19.79,Default,,0,0,0,,Легоши-сенпайға жеңіліп қалсаңыз
Dialogue: 0,0:13:19.88,0:13:22.34,Default,,0,0,0,,Өйткені біз енді ешқашан кездеспеуіміз мүмкін
Dialogue: 0,0:13:22.42,0:13:24.84,Default,,0,0,0,,Мен мұны болашақта анықтама ретінде сұрағым келді.
Dialogue: 0,0:13:25.97,0:13:30.30,Default,,0,0,0,,Досым, мен ет жейтіндерді жиі көре алмаймын.
Dialogue: 0,0:13:31.60,0:13:36.02,Default,,0,0,0,,Сіз бұрын Тем мырзаны жеуді жоспарлағансыз ба?
Dialogue: 0,0:13:36.10,0:13:39.52,Default,,0,0,0,,Әлде сіз импульсивті тамақтандыңыз ба?
Dialogue: 0,0:13:39.61,0:13:43.32,Default,,0,0,0,,Хмм... Солай деп ойлаймын.
Dialogue: 0,0:13:43.40,0:13:45.82,Default,,0,0,0,,Мен бұл туралы айтқым келмейді.
Dialogue: 0,0:13:46.74,0:13:48.20,Default,,0,0,0,,Пина-кун
Dialogue: 0,0:13:48.28,0:13:49.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:49.53,0:13:50.53,Default,,0,0,0,,Вуайеризм
Dialogue: 0,0:13:50.62,0:13:52.03,Default,,0,0,0,,Бұл қылмыс
Dialogue: 0,0:13:52.12,0:13:52.95,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:54.41,0:13:56.62,Default,,0,0,0,,«Мені өлтір!»
Dialogue: 0,0:13:56.71,0:13:59.58,Default,,0,0,0,,«Мен сенен қорықпаймын».
Dialogue: 0,0:13:59.67,0:14:01.09,Default,,0,0,0,,Бұл сөздер...
Dialogue: 0,0:14:01.17,0:14:02.71,Default,,0,0,0,,(Пинаның үрейлі дауысы)
Dialogue: 0,0:14:02.80,0:14:04.67,Default,,0,0,0,,Сіз мұны шынымен айтқыңыз келді, солай емес пе?
Dialogue: 0,0:14:04.76,0:14:07.76,Default,,0,0,0,,(Пинаның үрейлі дауысы)
Dialogue: 0,0:14:16.06,0:14:19.10,Default,,0,0,0,,Бұл қалатын нәрсе ме?
Dialogue: 0,0:14:19.19,0:14:24.02,Default,,0,0,0,,Бет таңбаларының өзгеруі сол адамның өміріндегі бетбұрысты білдіреді.
Dialogue: 0,0:14:24.82,0:14:26.61,Default,,0,0,0,,Жеңіңіз немесе жеңіліңіз
Dialogue: 0,0:14:26.69,0:14:28.28,Default,,0,0,0,,Сол шайқастан
Dialogue: 0,0:14:28.36,0:14:31.45,Default,,0,0,0,,Сіздің өміріңіз түбегейлі өзгеруі мүмкін.
Dialogue: 0,0:14:32.28,0:14:36.16,Default,,0,0,0,,Өмір де, өлім де қатал.
Dialogue: 0,0:14:36.79,0:14:41.08,Default,,0,0,0,,Ет пен шөпқоректі, Екі ауруды да ойлап.
Dialogue: 0,0:14:41.17,0:14:45.17,Default,,0,0,0,,Міне, ол күшті болды, бір бөлек жыртқыш.
Dialogue: 0,0:14:46.01,0:14:47.34,Default,,0,0,0,,Өзіңізге сенімді болыңыз
Dialogue: 0,0:14:51.55,0:14:52.60,Default,,0,0,0,,Гохин мырза
Dialogue: 0,0:14:53.85,0:14:55.35,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:03.36,0:15:08.57,Default,,0,0,0,,Қазір ойлап қарасам, әр Жаңа жыл түні Джекпен бірге өтті.
Dialogue: 0,0:15:09.86,0:15:14.12,Default,,0,0,0,,Егер мен бүгін түнде өлсем, Джек қайғыруы мүмкін.
Dialogue: 0,0:15:14.20,0:15:16.33,Default,,0,0,0,,Бірдеңе болса жылап жіберуім мүмкін
Dialogue: 0,0:15:16.41,0:15:18.87,Default,,0,0,0,,701-бөлмедегі жігіттер де.
Dialogue: 0,0:15:18.95,0:15:21.42,Default,,0,0,0,,Барлығы да драма үйірмесіне қатысады
Dialogue: 0,0:15:22.33,0:15:23.79,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:24.42,0:15:27.84,Default,,0,0,0,,Соңғы бір жылда өзіме ұнайтын көптеген адамдарды кездестірдім.
Dialogue: 0,0:15:30.67,0:15:33.59,Default,,0,0,0,,Мен Хару-чанның мұңайып тұрғанын елестеткім келмейді.
Dialogue: 0,0:15:34.72,0:15:37.43,Default,,0,0,0,,Жасымнан өтіп кетсем
Dialogue: 0,0:15:38.64,0:15:40.39,Default,,0,0,0,,Даусыңды тыңдайық
Dialogue: 0,0:15:45.40,0:15:46.48,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:52.45,0:15:53.28,Default,,0,0,0,,Босс
Dialogue: 0,0:15:53.36,0:15:54.99,Default,,0,0,0,,Бұл толық ай
Dialogue: 0,0:15:55.07,0:15:57.24,Default,,0,0,0,,Толық ай...
Dialogue: 0,0:15:57.33,0:15:59.33,Default,,0,0,0,,Бұл сәттілік пе, әлде жамандық па?
Dialogue: 0,0:15:59.41,0:16:01.25,Default,,0,0,0,,Мен жақсы екеніне сенімдімін.
Dialogue: 0,0:16:01.33,0:16:04.08,Default,,0,0,0,,Біз қаскөйлерді бірден өлтіреміз.
Dialogue: 0,0:16:04.17,0:16:06.50,Default,,0,0,0,,Бұл бірден өлтіру емес еді.
Dialogue: 0,0:16:06.59,0:16:07.75,Default,,0,0,0,,Ах... бірақ
Dialogue: 0,0:16:07.84,0:16:11.88,Default,,0,0,0,,Бастықтың бетіндегі тыртық менің абайсыздығымнан екені анық.
Dialogue: 0,0:16:11.97,0:16:13.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:13.22,0:16:14.80,Default,,0,0,0,,О? жиіркенішті
Dialogue: 0,0:16:14.89,0:16:17.51,Default,,0,0,0,,Хехехе Хидена
Dialogue: 0,0:16:18.39,0:16:20.22,Default,,0,0,0,,Келесіде солай айтсаң, атып саламын.
Dialogue: 0,0:16:20.31,0:16:23.52,Default,,0,0,0,,(Еркін күлкі)
Dialogue: 0,0:16:23.60,0:16:26.06,Default,,0,0,0,,Шишигуми өзгерді
Dialogue: 0,0:16:26.69,0:16:31.15,Default,,0,0,0,,Жыртқыштар қорғайтын бірдеңесі болған кезде күшті болады.
Dialogue: 0,0:16:32.53,0:16:35.95,Default,,0,0,0,,Мұны ешкім білмеді.
Dialogue: 0,0:16:36.57,0:16:41.37,Default,,0,0,0,,Денем күшті болғандықтан, жүрегім терең, достарыма қамқормын.
Dialogue: 0,0:16:42.79,0:16:47.84,Default,,0,0,0,,Етке құмар болғандықтан, оның бетінде үнемі аздап ауырған көрініс бар.
Dialogue: 0,0:16:49.21,0:16:52.72,Default,,0,0,0,,Мен жыртқыштарды жақсы көремін
Dialogue: 0,0:16:53.38,0:16:55.68,Default,,0,0,0,,Осындай уақытта қалай түсіне аласыз?
Dialogue: 0,0:16:56.72,0:17:00.89,Default,,0,0,0,,Содан бері көп уақыт өткен шығар...
Dialogue: 0,0:17:01.52,0:17:05.64,Default,,0,0,0,,Өйткені ол... сол ақымақ сонда болды.
Dialogue: 0,0:17:09.44,0:17:11.61,Default,,0,0,0,,Мен Ибукимін
Dialogue: 0,0:17:12.94,0:17:14.24,Default,,0,0,0,,Шишигумиден кету
Dialogue: 0,0:17:14.32,0:17:16.53,Default,,0,0,0,,ше? Ол шығады ма?
Dialogue: 0,0:17:17.24,0:17:18.57,Default,,0,0,0,,Не болды, бастық?
Dialogue: 0,0:17:18.66,0:17:20.03,Default,,0,0,0,,Мен сені көруге баруым керек.
Dialogue: 0,0:17:20.12,0:17:21.04,Default,,0,0,0,,Қазір
Dialogue: 0,0:17:21.12,0:17:23.16,Default,,0,0,0,,Сізді жақсы көретін адам өлуі мүмкін.
Dialogue: 0,0:17:23.25,0:17:25.58,Default,,0,0,0,,Сондықтан топтан шығудың қажеті жоқ.
Dialogue: 0,0:17:25.66,0:17:26.87,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:17:26.96,0:17:30.84,Default,,0,0,0,,«Артқы базарға» қашқан мен оның қайсарлығына куә бола алмаймын.
Dialogue: 0,0:17:30.92,0:17:35.22,Default,,0,0,0,,Бұл Шиши-гумиден маңыздырақ па?
Dialogue: 0,0:17:35.30,0:17:37.13,Default,,0,0,0,,Салыстыру мүмкін емес
Dialogue: 0,0:17:37.22,0:17:40.39,Default,,0,0,0,,Бірақ мен кетуім керек.
Dialogue: 0,0:17:40.47,0:17:42.51,Default,,0,0,0,,Мен қашып жүрген нәрсеге
Dialogue: 0,0:17:42.60,0:17:44.93,Default,,0,0,0,,Ол маған қарсы тұруға тырысады.
Dialogue: 0,0:17:46.35,0:17:48.65,Default,,0,0,0,,Ол тым керемет
Dialogue: 0,0:17:49.56,0:17:50.73,Default,,0,0,0,,зұлым қылмыстарды болдырмау үшін, бірақ —
Dialogue: 0,0:17:50.81,0:17:52.07,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:52.15,0:17:56.28,Default,,0,0,0,,Сіз досыңызды қалауыңыз бойынша құтқарып, кейін қайтып оралуды жоспарлап отырсыз ба?
Dialogue: 0,0:17:56.36,0:17:58.53,Default,,0,0,0,,Сіз түсіндім деп жатырсыз, солай емес пе?
Dialogue: 0,0:17:59.49,0:18:01.20,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:02.95,0:18:07.12,Default,,0,0,0,,Ибуки, сен сондай үлкен болдың ба?
Dialogue: 0,0:18:07.83,0:18:12.09,Default,,0,0,0,,Маған қамқорлық жасау үшін ылғи еңкейетін едің.
Dialogue: 0,0:18:19.97,0:18:23.10,Default,,0,0,0,,Кішкене көлікпен жүргіңіз келе ме?
Dialogue: 0,0:18:33.86,0:18:37.53,Default,,0,0,0,,Сізді күтуге мәжбүрлегенім үшін кешіріңіз.
Dialogue: 0,0:18:37.61,0:18:39.45,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:39.53,0:18:41.45,Default,,0,0,0,,Уақыт тамаша.
Dialogue: 0,0:18:41.53,0:18:44.45,Default,,0,0,0,,Сіз тіпті осындай сәттерде өте байсалдысыз.
Dialogue: 0,0:18:44.54,0:18:47.87,Default,,0,0,0,,Жоқ, жарайды... Оны бастаған менмін.
Dialogue: 0,0:18:47.96,0:18:51.75,Default,,0,0,0,,Луи-сенпай келмеді.
Dialogue: 0,0:18:51.83,0:18:53.96,Default,,0,0,0,,...және қашан бастау керек?
Dialogue: 0,0:18:54.04,0:18:55.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:55.09,0:18:58.47,Default,,0,0,0,,Мен старттық гонгты осында дайындадым.
Dialogue: 0,0:18:58.55,0:19:01.47,Default,,0,0,0,,Байқамасаң мағынасыз.
Dialogue: 0,0:19:01.55,0:19:02.93,Default,,0,0,0,,Гонг?
Dialogue: 0,0:19:03.68,0:19:06.35,Default,,0,0,0,,Сіздің ашу-ызаңыздың өшуі...
Dialogue: 0,0:19:06.43,0:19:07.27,Default,,0,0,0,,（）
Dialogue: 0,0:19:07.35,0:19:08.85,Default,,0,0,0,,Егер баспасаңыз
Dialogue: 0,0:19:08.93,0:19:11.06,Default,,0,0,0,,（）
Dialogue: 0,0:19:08.93,0:19:11.06,Default,,0,0,0,,Күрделі қақтығыс бола алмаймын деп ойлаңыз.
Dialogue: 0,0:19:11.06,0:19:11.94,Default,,0,0,0,,Күрделі қақтығыс бола алмаймын деп ойлаңыз.
Dialogue: 0,0:19:12.02,0:19:13.11,Default,,0,0,0,,Қанның иісі...
Dialogue: 0,0:19:13.11,0:19:14.11,Default,,0,0,0,,Қанның иісі...
Dialogue: 0,0:19:13.11,0:19:14.11,Default,,0,0,0,,(сыдырманың ашылған дыбысы)
Dialogue: 0,0:19:16.69,0:19:19.36,Default,,0,0,0,,Бір қуыршақ Биггорн
Dialogue: 0,0:19:20.57,0:19:23.07,Default,,0,0,0,,Мен күткендей қарным ашты.
Dialogue: 0,0:19:25.24,0:19:26.45,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:19:27.20,0:19:29.16,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:19:38.76,0:19:41.22,Default,,0,0,0,,Шынымды айтсам, сәл таң қалсаңыз.
Dialogue: 0,0:19:41.30,0:19:43.76,Default,,0,0,0,,Мен сені дірілдеп, шегініп кетесің деп ойладым.
Dialogue: 0,0:19:44.80,0:19:47.43,Default,,0,0,0,,Бастық қабағын да татырмады.
Dialogue: 0,0:19:48.02,0:19:51.44,Default,,0,0,0,,Бастық Сіздей күшті аң жоқ.
Dialogue: 0,0:19:52.39,0:19:53.60,Default,,0,0,0,,Мен бұрыннан…
Dialogue: 0,0:19:53.69,0:19:56.15,Default,,0,0,0,,Мен сізден басқа ешкімді бастық деп санай алмаймын.
Dialogue: 0,0:19:57.52,0:19:59.40,Default,,0,0,0,,Күшті аң?
Dialogue: 0,0:19:59.48,0:20:03.28,Default,,0,0,0,,...Арыстан маған бұл сөзді айтса, мен мүлдем қуанбаймын.
Dialogue: 0,0:20:03.99,0:20:06.58,Default,,0,0,0,,Арыстанның күші – қару ғана.
Dialogue: 0,0:20:07.20,0:20:08.91,Default,,0,0,0,,Мен сені кездестіргенге дейін
Dialogue: 0,0:20:08.99,0:20:12.54,Default,,0,0,0,,Мен тіпті сол қарумен өзімді жараладым.
Dialogue: 0,0:20:13.21,0:20:14.04,Default,,0,0,0,,Ибуки
Dialogue: 0,0:20:14.12,0:20:17.09,Default,,0,0,0,,Аңдар патшасының рөлін ойнай бер
Dialogue: 0,0:20:17.17,0:20:21.17,Default,,0,0,0,,Бұл жыртқыштың «бақыты».
Dialogue: 0,0:20:23.51,0:20:26.18,Default,,0,0,0,,Мен кейіптей беремін
Dialogue: 0,0:20:26.26,0:20:29.14,Default,,0,0,0,,Айналаңыздағылардың қорқынышты көзқарасы арқылы үлкейген.
Dialogue: 0,0:20:29.22,0:20:31.68,Default,,0,0,0,,Ақырында бұл тіпті мен үшін де тым көп болды.
Dialogue: 0,0:20:31.77,0:20:35.10,Default,,0,0,0,,Үлкен қара кесекке айналды
Dialogue: 0,0:20:36.56,0:20:42.07,Default,,0,0,0,,Сол кезде маған қараған түрің біртүрлі еді.
Dialogue: 0,0:20:42.90,0:20:44.49,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:20:45.03,0:20:47.91,Default,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,0:20:49.49,0:20:53.96,Default,,0,0,0,,Сізбен өткен күндерім менің 35 жылдық өмірімдегі ең қолайлы күн болды.
Dialogue: 0,0:20:54.71,0:20:56.54,Default,,0,0,0,,Біртекті емес өмір сүру дегеніміз не?
Dialogue: 0,0:20:56.63,0:20:57.79,Default,,0,0,0,,Хаха
Dialogue: 0,0:20:57.88,0:20:59.04,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:59.13,0:21:02.97,Default,,0,0,0,,Менің ондай күндерде өмір сүруім маған сәйкес келмейді.
Dialogue: 0,0:21:05.43,0:21:10.18,Default,,0,0,0,,Менің орным мына туннель сияқты қараңғы.
Dialogue: 0,0:21:11.52,0:21:14.23,Default,,0,0,0,,Мұнда өмір сүруге кепілдік жоқ.
Dialogue: 0,0:21:16.23,0:21:19.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:22.03,0:21:28.03,Default,,0,0,0,,♪～
Dialogue: 0,0:22:42.23,0:22:48.24,Default,,0,0,0,,～♪
