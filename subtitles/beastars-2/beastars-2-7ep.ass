Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.09,0:00:18.10,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.92,0:01:39.18,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.31,0:01:45.93,Default,,0,0,0,,Менің жаттығуларым алға жылжуы керек.
Dialogue: 0,0:01:47.48,0:01:50.10,Default,,0,0,0,,Неліктен иегіме күш сала алмаймын?
Dialogue: 0,0:01:55.49,0:01:56.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:57.20,0:02:00.28,Default,,0,0,0,,Бірақ бұл мүмкіндік емес пе?
Dialogue: 0,0:02:06.37,0:02:09.62,Default,,0,0,0,,Менде қылмыскердің сілекейі туралы мәлімет бар.
Dialogue: 0,0:02:12.96,0:02:15.92,Default,,0,0,0,,Хмм... жоқ.
Dialogue: 0,0:02:16.55,0:02:18.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:19.55,0:02:21.47,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:02:22.47,0:02:24.22,Default,,0,0,0,,Жоқ, бұл да...
Dialogue: 0,0:02:25.64,0:02:27.68,Default,,0,0,0,,Бұл да басқа
Dialogue: 0,0:02:30.65,0:02:31.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:32.19,0:02:35.15,Default,,0,0,0,,Мені бір қолмен айналдырған сол күш
Dialogue: 0,0:02:37.65,0:02:40.49,Default,,0,0,0,,Бұл мен үшін хабар
Dialogue: 0,0:02:41.41,0:02:43.70,Default,,0,0,0,,«Темді жеген мен болдым».
Dialogue: 0,0:02:43.78,0:02:45.91,Default,,0,0,0,,«Егер сіз ары қарай іздегіңіз келсе»
Dialogue: 0,0:02:45.99,0:02:47.87,Default,,0,0,0,,«Мен сені өлтіремін»
Dialogue: 0,0:02:50.46,0:02:52.54,Default,,0,0,0,,Иә, сәттілік
Dialogue: 0,0:02:53.33,0:02:55.59,Default,,0,0,0,,Баяу дем шығару
Dialogue: 0,0:02:56.17,0:02:57.92,Default,,0,0,0,,Иә 20 секунд ұстап тұрыңыз
Dialogue: 0,0:02:58.01,0:02:58.84,Default,,0,0,0,,Мүмкін емес Мүмкін емес Мүмкін емес...
Dialogue: 0,0:02:58.92,0:03:00.09,Default,,0,0,0,,Бұл мүмкін емес, мүмкін емес, мүмкін емес.
Dialogue: 0,0:03:00.17,0:03:01.51,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:03:01.59,0:03:02.43,Default,,0,0,0,,Тағы біраз
Dialogue: 0,0:03:02.51,0:03:04.18,Default,,0,0,0,,Баяу дем шығарыңыз
Dialogue: 0,0:03:04.85,0:03:07.43,Default,,0,0,0,,Өйткені, бізге бұл жерде жабылатын перде керек.
Dialogue: 0,0:03:07.52,0:03:10.06,Default,,0,0,0,,Кесу таяқшасымен жүзімнен тығылып қалмай ма?
Dialogue: 0,0:03:10.14,0:03:11.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:11.31,0:03:12.44,Default,,0,0,0,,Ах... Күмбез-сенпай (Күмбез) Не?
Dialogue: 0,0:03:12.44,0:03:13.40,Default,,0,0,0,,Ах... Күмбез-сенпай (Күмбез) Не?
Dialogue: 0,0:03:12.44,0:03:13.40,Default,,0,0,0,,Иә, онда қолтықтарыңызды созыңыз.
Dialogue: 0,0:03:13.40,0:03:13.48,Default,,0,0,0,,Иә, онда қолтықтарыңызды созыңыз.
Dialogue: 0,0:03:13.48,0:03:15.40,Default,,0,0,0,,Иә, онда қолтықтарыңызды созыңыз.
Dialogue: 0,0:03:13.48,0:03:15.40,Default,,0,0,0,,Сол Пина-кунның назар аударатын орны
Dialogue: 0,0:03:15.48,0:03:17.86,Default,,0,0,0,,Менің ойымша, бір қызыл сүзгіні қолданған дұрыс.
Dialogue: 0,0:03:17.94,0:03:20.32,Default,,0,0,0,,Ах~ Хмм...
Dialogue: 0,0:03:20.40,0:03:21.86,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:21.95,0:03:24.07,Default,,0,0,0,,Менің денем таза аппақ
Dialogue: 0,0:03:24.16,0:03:27.04,Default,,0,0,0,,Сіздің өңіңіз жақсы көрінеді, сондықтан менің ойымша, бұл жақсы.
Dialogue: 0,0:03:27.12,0:03:28.87,Default,,0,0,0,,Денені тексеру? Неге ондай істегіңіз келеді?
Dialogue: 0,0:03:29.70,0:03:30.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:31.79,0:03:33.67,Default,,0,0,0,,Жоқ... О, жоқ.
Dialogue: 0,0:03:33.75,0:03:36.09,Default,,0,0,0,,Е... Мен... Жоқ, жоқ, жоқ, жоқ...
Dialogue: 0,0:03:36.17,0:03:38.50,Default,,0,0,0,,Чи... чичичи... жоқ!
Dialogue: 0,0:03:38.59,0:03:42.09,Default,,0,0,0,,Ой... қолым... қолым...
Dialogue: 0,0:03:45.43,0:03:46.80,Default,,0,0,0,,Шөпқоректілер азайды
Dialogue: 0,0:03:46.89,0:03:48.85,Default,,0,0,0,,А... Мен... жоқпын.
Dialogue: 0,0:03:48.93,0:03:50.56,Default,,0,0,0,,Мен... Сабыр ет, Тао.
Dialogue: 0,0:03:50.64,0:03:52.19,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:03:52.27,0:03:53.56,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек?
Dialogue: 0,0:03:53.65,0:03:55.15,Default,,0,0,0,,Кяаа...
Dialogue: 0,0:03:55.23,0:03:56.27,Default,,0,0,0,,Ми... мими... сіз оны көрдіңіз.
Dialogue: 0,0:03:56.27,0:03:56.61,Default,,0,0,0,,Ми... мими... сіз оны көрдіңіз.
Dialogue: 0,0:03:56.27,0:03:56.61,Default,,0,0,0,,Эй... тоқта!
Dialogue: 0,0:03:56.61,0:03:56.69,Default,,0,0,0,,Эй... тоқта!
Dialogue: 0,0:03:56.69,0:03:58.48,Default,,0,0,0,,Эй... тоқта!
Dialogue: 0,0:03:56.69,0:03:58.48,Default,,0,0,0,,Бұл әдейі емес, маған сеніңіз.
Dialogue: 0,0:03:58.57,0:03:59.78,Default,,0,0,0,,Тынышталыңыз Ах... мен...
Dialogue: 0,0:03:59.86,0:04:01.69,Default,,0,0,0,,Барлығы қорқады, өйткені мен...
Dialogue: 0,0:04:01.78,0:04:03.53,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:04:03.61,0:04:05.74,Default,,0,0,0,,Уф, менің қолым... менің қолым...
Dialogue: 0,0:04:05.82,0:04:08.91,Default,,0,0,0,,Әйтеуір, бәріңіз Миллетті емханаға апарыңыз.
Dialogue: 0,0:04:08.99,0:04:13.12,Default,,0,0,0,,Шындығында, өзін ұстайтын жыртқыш аң
Dialogue: 0,0:04:13.21,0:04:16.67,Default,,0,0,0,,Шөпқоректінің аяқ-қолы түсіп қалатындай жара салуға болмайды.
Dialogue: 0,0:04:16.75,0:04:18.54,Default,,0,0,0,,Сирек емес
Dialogue: 0,0:04:19.25,0:04:23.55,Default,,0,0,0,,Дегенмен, тігу технологиясы да сәйкесінше дамыды.
Dialogue: 0,0:04:23.63,0:04:26.34,Default,,0,0,0,,Асықсаң, Кибі қолы да қосылсын.
Dialogue: 0,0:04:27.14,0:04:28.05,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:28.72,0:04:30.35,Default,,0,0,0,,Тары №!
Dialogue: 0,0:04:30.43,0:04:32.43,Default,,0,0,0,,Маған тиіспе
Dialogue: 0,0:04:32.52,0:04:33.98,Default,,0,0,0,,Ет жегенге қол тигізбеу
Dialogue: 0,0:04:34.06,0:04:35.90,Default,,0,0,0,,Екіншісі де ыдырап қалады.
Dialogue: 0,0:04:35.98,0:04:37.48,Default,,0,0,0,,Маған сен, тары.
Dialogue: 0,0:04:37.56,0:04:39.73,Default,,0,0,0,,Мұны күшті жыртқыштарға қалдырыңыз.
Dialogue: 0,0:04:39.82,0:04:41.61,Default,,0,0,0,,Бұл мүмкін емес, балам...
Dialogue: 0,0:04:41.69,0:04:42.99,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:04:43.07,0:04:44.65,Default,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:04:45.45,0:04:47.82,Default,,0,0,0,,Тары Бірақ...
Dialogue: 0,0:04:47.91,0:04:50.29,Default,,0,0,0,,Легоши?
Dialogue: 0,0:04:50.37,0:04:51.66,Default,,0,0,0,,Легоши жақсы.
Dialogue: 0,0:04:51.74,0:04:54.83,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:04:56.17,0:04:57.21,Default,,0,0,0,,Кеттік
Dialogue: 0,0:04:57.29,0:04:59.09,Default,,0,0,0,,Хмм... жарайды ма? Мен ұстаймын, иә
Dialogue: 0,0:04:59.17,0:05:00.04,Default,,0,0,0,,Себебі ол шайқалады
Dialogue: 0,0:05:00.13,0:05:01.67,Default,,0,0,0,,Хмм... Уф...
Dialogue: 0,0:05:02.34,0:05:05.63,Default,,0,0,0,,Жарайды, мен емханаға барамын.
Dialogue: 0,0:05:05.72,0:05:07.51,Default,,0,0,0,,Қалғаны үшін рахмет.
Dialogue: 0,0:05:07.59,0:05:08.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:08.85,0:05:10.56,Default,,0,0,0,,Сізге де қару қажет
Dialogue: 0,0:05:11.22,0:05:13.27,Default,,0,0,0,,Біреу оны өзіңізбен бірге алып кетіңіз.
Dialogue: 0,0:05:18.77,0:05:19.61,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:20.36,0:05:21.69,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:05:23.36,0:05:26.65,Default,,0,0,0,,Көрінбейтін етіп орап ал, сонда бәрі жақсы болады.
Dialogue: 0,0:05:27.86,0:05:29.20,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:29.28,0:05:30.66,Default,,0,0,0,,Кеттік
Dialogue: 0,0:05:32.20,0:05:32.87,Default,,0,0,0,,Тары... Ах...
Dialogue: 0,0:05:32.87,0:05:33.87,Default,,0,0,0,,Тары... Ах...
Dialogue: 0,0:05:32.87,0:05:33.87,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:33.95,0:05:36.21,Default,,0,0,0,,Бүгінгі клуб іс-шаралары тоқтатылды.
Dialogue: 0,0:05:36.29,0:05:36.96,Default,,0,0,0,,Тыңдаңыздар, ренжімеңіздер.
Dialogue: 0,0:05:36.96,0:05:38.33,Default,,0,0,0,,Тыңдаңыздар, ренжімеңіздер.
Dialogue: 0,0:05:36.96,0:05:38.33,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:05:38.33,0:05:39.25,Default,,0,0,0,,Тыңдаңыздар, ренжімеңіздер.
Dialogue: 0,0:05:45.63,0:05:49.26,Default,,0,0,0,,Мені ауруханаға апарып жатыр ма?
Dialogue: 0,0:05:49.34,0:05:50.76,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:05:51.55,0:05:53.85,Default,,0,0,0,,Ауруханадан шықсаң, Әлішейх, сусын ішейік.
Dialogue: 0,0:05:53.93,0:05:55.22,Default,,0,0,0,,Сен сияқты — олардың әрқайсысы.
Dialogue: 0,0:05:58.85,0:06:03.02,Default,,0,0,0,,Ах... Киби Бұл... ауырды.
Dialogue: 0,0:06:03.11,0:06:06.19,Default,,0,0,0,,Мен не істеуім керек? Ол аяқтады.
Dialogue: 0,0:06:07.53,0:06:10.74,Default,,0,0,0,,Мұның әдейі емес екенін бәрі біледі.
Dialogue: 0,0:06:10.82,0:06:12.74,Default,,0,0,0,,Қажет болса, куәлік беремін.
Dialogue: 0,0:06:12.83,0:06:15.16,Default,,0,0,0,,Жоқ... бұл дұрыс емес.
Dialogue: 0,0:06:16.08,0:06:18.41,Default,,0,0,0,,Қолыңызды жұлып алу сезімінен де артық
Dialogue: 0,0:06:18.50,0:06:20.67,Default,,0,0,0,,Барлығының көздері маған үрейлене қарайды
Dialogue: 0,0:06:21.25,0:06:23.09,Default,,0,0,0,,Барлығының сенгеніне сенімдімін.
Dialogue: 0,0:06:23.67,0:06:25.30,Default,,0,0,0,,Сол оқиға...
Dialogue: 0,0:06:25.38,0:06:28.38,Default,,0,0,0,,Те... Темуді жеген мен едім.
Dialogue: 0,0:06:28.47,0:06:29.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:31.22,0:06:32.14,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:06:32.22,0:06:33.68,Default,,0,0,0,,Жоқ! Бұл басқаша
Dialogue: 0,0:06:34.64,0:06:38.81,Default,,0,0,0,,Мен барлығын қорқытып алмас үшін сабырлы болуға тырыстым.
Dialogue: 0,0:06:38.89,0:06:40.14,Default,,0,0,0,,Бірақ бұл мүмкін емес.
Dialogue: 0,0:06:40.23,0:06:44.07,Default,,0,0,0,,Досыңның қолын жұлып алсаң да, өзіңді еркін ұстай алмайсың.
Dialogue: 0,0:06:44.15,0:06:45.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:45.23,0:06:46.53,Default,,0,0,0,,Тіпті мен және Аоба
Dialogue: 0,0:06:47.40,0:06:51.78,Default,,0,0,0,,Мен шабуыл жасадым деп, терлеуді тоқтата алмадым.
Dialogue: 0,0:06:52.32,0:06:53.66,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:55.87,0:06:57.66,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:07:00.08,0:07:01.83,Default,,0,0,0,,Менің формамда қан бар.
Dialogue: 0,0:07:01.92,0:07:03.84,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:07:03.92,0:07:06.13,Default,,0,0,0,,А... бұл рас.
Dialogue: 0,0:07:07.42,0:07:10.30,Default,,0,0,0,,Мынаны орамалға қарағанда жуған дұрыс сияқты.
Dialogue: 0,0:07:10.38,0:07:11.22,Default,,0,0,0,,Иә
Dialogue: 0,0:07:11.30,0:07:12.97,Default,,0,0,0,,Бұл жағы...
Dialogue: 0,0:07:14.22,0:07:17.68,Default,,0,0,0,,Сол күні Темді жеген сен едің ғой?
Dialogue: 0,0:07:17.77,0:07:18.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:21.10,0:07:23.15,Default,,0,0,0,,Бұл жерде енді алдаудың қажеті жоқ.
Dialogue: 0,0:07:23.23,0:07:24.40,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:24.98,0:07:26.61,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:28.69,0:07:32.24,Default,,0,0,0,,Сол терең сүйіс шешуші фактор болды ма?
Dialogue: 0,0:07:33.07,0:07:35.87,Default,,0,0,0,,Бұл сізді іздеудің жалғыз жолы болды.
Dialogue: 0,0:07:36.45,0:07:38.12,Default,,0,0,0,,Мен кешірім сұрамаймын.
Dialogue: 0,0:07:38.87,0:07:42.71,Default,,0,0,0,,Мен сені кесіп тастайды деп ешқашан ойламаппын.
Dialogue: 0,0:07:43.54,0:07:46.38,Default,,0,0,0,,Мен Тимді жегенім де менің қиялымнан шықты.
Dialogue: 0,0:07:47.25,0:07:49.26,Default,,0,0,0,,Жаңа ғана қате болды.
Dialogue: 0,0:07:50.01,0:07:52.30,Default,,0,0,0,,Егер сіз жай ғана «тамақ өлтіруді» елемесеңіз
Dialogue: 0,0:07:52.38,0:07:53.93,Default,,0,0,0,,Сіз солай ойладыңыз ба?
Dialogue: 0,0:07:54.01,0:07:57.26,Default,,0,0,0,,Хмм... солай емес пе?
Dialogue: 0,0:07:57.35,0:07:58.56,Default,,0,0,0,,Ийда…
Dialogue: 0,0:07:59.27,0:08:02.81,Default,,0,0,0,,Мен қазірден бастап аузымды жабуым керек.
Dialogue: 0,0:08:02.89,0:08:04.73,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:05.44,0:08:08.15,Default,,0,0,0,,Ақымақ болма… Мен сенің бәрін көріп тұрмын
Dialogue: 0,0:08:08.73,0:08:11.49,Default,,0,0,0,,Тырнақ өспейді, шаш тұрмайды
Dialogue: 0,0:08:11.57,0:08:15.11,Default,,0,0,0,,Жеңіске жету мүмкіндігі нөлге тең бе?
Dialogue: 0,0:08:16.37,0:08:17.45,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:08:17.53,0:08:20.08,Default,,0,0,0,,А, мен бұдан былай күте алмаймын.
Dialogue: 0,0:08:20.16,0:08:21.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:24.25,0:08:27.50,Default,,0,0,0,,Қибі-сенпайдың жүгімен еріксіз тастым.
Dialogue: 0,0:08:28.34,0:08:30.25,Default,,0,0,0,,О, құдайым.
Dialogue: 0,0:08:31.71,0:08:33.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:33.26,0:08:36.05,Default,,0,0,0,,Бұл Пина, драма үйірмесінің бірінші курс студенті (есіктің ашылған дыбысы)
Dialogue: 0,0:08:36.14,0:08:38.39,Default,,0,0,0,,Мынау Кибі-сенпайдың сөмкесі.
Dialogue: 0,0:08:38.47,0:08:40.43,Default,,0,0,0,,Оны сол жерде қалдырыңыз Иә
Dialogue: 0,0:08:40.52,0:08:42.93,Default,,0,0,0,,Жарайды, сондықтан шу шығармаңыз.
Dialogue: 0,0:08:43.02,0:08:44.69,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:44.77,0:08:47.27,Default,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:08:49.90,0:08:52.32,Default,,0,0,0,,Тапсырманы орындау
Dialogue: 0,0:08:54.90,0:08:59.08,Default,,0,0,0,,Бұл жөндеу құны емес пе?
Dialogue: 0,0:08:59.16,0:09:00.54,Default,,0,0,0,,Мен үндемеймін.
Dialogue: 0,0:09:00.62,0:09:02.37,Default,,0,0,0,,Эй... Эй, күте тұр!
Dialogue: 0,0:09:03.33,0:09:05.08,Default,,0,0,0,,Сіз ештеңе естіген жоқсыз, солай ма?
Dialogue: 0,0:09:05.16,0:09:06.42,Default,,0,0,0,,Тыңдамағаныңды айт
Dialogue: 0,0:09:06.50,0:09:08.46,Default,,0,0,0,,Мм! Ах...
Dialogue: 0,0:09:08.54,0:09:09.38,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:09.46,0:09:12.38,Default,,0,0,0,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:09:13.01,0:09:17.05,Default,,0,0,0,,Кісі өлтіру ісі бойынша кінәлі Лиз-сенпай болды.
Dialogue: 0,0:09:17.13,0:09:19.26,Default,,0,0,0,,Маған қатысы жоқ
Dialogue: 0,0:09:20.43,0:09:23.81,Default,,0,0,0,,...Сен олай айтпадың деп ойладым.
Dialogue: 0,0:09:23.89,0:09:27.02,Default,,0,0,0,,Мен өзім араласу үшін келдім.
Dialogue: 0,0:09:28.06,0:09:32.28,Default,,0,0,0,,Етқоректілердің ұтымдылығын не бұзуы немесе сақтауы мүмкін?
Dialogue: 0,0:09:33.61,0:09:35.82,Default,,0,0,0,,Бұл шөпқоректі жануар.
Dialogue: 0,0:09:43.04,0:09:45.04,Default,,0,0,0,,Кяапина-кун
Dialogue: 0,0:09:45.12,0:09:46.62,Default,,0,0,0,,Пина-кун (Б студент қыз) Мына жаққа қара.
Dialogue: 0,0:09:46.71,0:09:48.17,Default,,0,0,0,,Көз қысу
Dialogue: 0,0:09:48.25,0:09:50.29,Default,,0,0,0,,иә... иә (студент қыздардың қошеметі)
Dialogue: 0,0:09:51.88,0:09:55.97,Default,,0,0,0,,Жарайды, мен жай ғана бейбіт талқылауды қалаймын.
Dialogue: 0,0:09:57.30,0:10:01.01,Default,,0,0,0,,Өтінемін, маған олай қарап тұрғандай қарама.
Dialogue: 0,0:10:01.10,0:10:02.31,Default,,0,0,0,,Лиз-сенпай
Dialogue: 0,0:10:02.39,0:10:03.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:04.02,0:10:05.60,Default,,0,0,0,,Мен ренжідім.
Dialogue: 0,0:10:05.68,0:10:07.27,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:10:07.35,0:10:11.11,Default,,0,0,0,,Менің қылмысымды екі студент ашты.
Dialogue: 0,0:10:11.77,0:10:14.78,Default,,0,0,0,,Қоңыр аюдың өзін қауіпсіз сезінуінің бір ғана жолы бар.
Dialogue: 0,0:10:14.86,0:10:16.94,Default,,0,0,0,,Менің сенен құтылудан басқа амалым жоқ.
Dialogue: 0,0:10:17.03,0:10:18.20,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:10:18.28,0:10:20.82,Default,,0,0,0,,Маған зиян келтіруді ұсынбаймын.
Dialogue: 0,0:10:21.41,0:10:24.33,Default,,0,0,0,,Шөпқоректі театр клубының мүшесі екі рет өлтірілсе ше?
Dialogue: 0,0:10:24.41,0:10:27.37,Default,,0,0,0,,Күтілгендей, полиция да мұқият тексереді.
Dialogue: 0,0:10:27.46,0:10:28.79,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:28.87,0:10:32.54,Default,,0,0,0,,Бар болғаны зерттеуіңізді драма үйірмесінің ет жейтін мүшелеріне бағыттау керек.
Dialogue: 0,0:10:32.63,0:10:34.88,Default,,0,0,0,,Мұны тіпті бастауыш сынып оқушылары да орындай алады
Dialogue: 0,0:10:34.96,0:10:36.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:36.13,0:10:37.72,Default,,0,0,0,,О, менің...
Dialogue: 0,0:10:37.80,0:10:39.09,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:10:40.80,0:10:44.06,Default,,0,0,0,,Мен дірілдеген жоқпын.
Dialogue: 0,0:10:44.68,0:10:48.39,Default,,0,0,0,,Мазасыз жағдай екеумізде.
Dialogue: 0,0:10:49.44,0:10:52.48,Default,,0,0,0,,Әзірше әділдік бүгін жеңіске жетті.
Dialogue: 0,0:10:52.56,0:10:53.40,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:54.77,0:10:57.36,Default,,0,0,0,,Ұйқысыз түн болсын
Dialogue: 0,0:10:58.53,0:11:00.45,Default,,0,0,0,,Кеттік, Легоши-сенпай.
Dialogue: 0,0:11:00.53,0:11:01.36,Default,,0,0,0,,Е... а...
Dialogue: 0,0:11:02.66,0:11:03.74,Default,,0,0,0,,Иә
Dialogue: 0,0:11:05.99,0:11:07.91,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:11:08.58,0:11:12.38,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:14.09,0:11:17.17,Default,,0,0,0,,Мектеп неге кенеттен жабылды?
Dialogue: 0,0:11:17.25,0:11:19.97,Default,,0,0,0,,Олар үнемі қызметкерлер жиналыстарын өткізетін сияқты.
Dialogue: 0,0:11:20.05,0:11:21.51,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:21.59,0:11:24.26,Default,,0,0,0,,...Менің айтайын дегенім, үй тапсырмасының көлемі тым қатал.
Dialogue: 0,0:11:24.35,0:11:26.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:27.68,0:11:29.60,Default,,0,0,0,,Төтенше жағдайдағы байланыс
Dialogue: 0,0:11:29.68,0:11:31.19,Default,,0,0,0,,Е... Е!
Dialogue: 0,0:11:31.98,0:11:35.77,Default,,0,0,0,,«Келесі жылдан бастап, біздің мектеп, Черритон академиясы»
Dialogue: 0,0:11:35.86,0:11:38.28,Default,,0,0,0,,«Етқоректі және шөпқоректілер класына бөлінеді»...
Dialogue: 0,0:11:38.94,0:11:40.86,Default,,0,0,0,,«Толығымен бөлек мектеп»?
Dialogue: 0,0:11:40.95,0:11:41.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:42.70,0:11:46.53,Default,,0,0,0,,Келесі айдан бастап драма үйірмесі де жұмысын тоқтатады.
Dialogue: 0,0:11:46.62,0:11:49.62,Default,,0,0,0,,Бұл етқоректі-шөпқоректілерді біріктіретін мектеп.
Dialogue: 0,0:11:49.70,0:11:51.29,Default,,0,0,0,,Қазір азайып барады.
Dialogue: 0,0:11:51.37,0:11:52.79,Default,,0,0,0,,тым кеш болды.
Dialogue: 0,0:11:52.87,0:11:55.50,Default,,0,0,0,,Менің анам да мектепке шағым түсірді.
Dialogue: 0,0:11:55.58,0:11:57.63,Default,,0,0,0,,Шөпқоректі туыстарының бәрі де солай емес пе?
Dialogue: 0,0:11:58.59,0:12:02.17,Default,,0,0,0,,«Мен аштыққа ұшыраған сыныптастарыммен сабаққа қатыса алмаймын».
Dialogue: 0,0:12:03.18,0:12:08.81,Default,,0,0,0,,Мен сияқты жыртқыштың пікір айтуға құқығы жоқ шығар...
Dialogue: 0,0:12:11.14,0:12:12.44,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:12.52,0:12:15.90,Default,,0,0,0,,Жоқ, жоқ, мен драма үйірмесіндегі ең позитивті адаммын.
Dialogue: 0,0:12:15.98,0:12:18.19,Default,,0,0,0,,Қараңғы түскенде не істеуім керек?
Dialogue: 0,0:12:18.27,0:12:19.90,Default,,0,0,0,,Билл...
Dialogue: 0,0:12:22.11,0:12:24.41,Default,,0,0,0,,Бұл не, Элс?
Dialogue: 0,0:12:24.49,0:12:26.57,Default,,0,0,0,,Мен таң қалдым хахаха
Dialogue: 0,0:12:26.66,0:12:28.41,Default,,0,0,0,,Үйірме жұмыстарына бірге барғыңыз келе ме?
Dialogue: 0,0:12:28.49,0:12:30.45,Default,,0,0,0,,Сіз естідіңіз бе? Үйірме жұмыстары...
Dialogue: 0,0:12:30.54,0:12:31.66,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:12:32.96,0:12:35.58,Default,,0,0,0,,Осы айдың соңында іс-шаралар тоқтатылады ма?
Dialogue: 0,0:12:35.67,0:12:38.38,Default,,0,0,0,,Мен оның кенеттен болғанына таң қалдым.
Dialogue: 0,0:12:38.46,0:12:41.01,Default,,0,0,0,,Жақсы, бірақ...
Dialogue: 0,0:12:41.09,0:12:42.26,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:12:42.34,0:12:44.68,Default,,0,0,0,,А... көмектесе алмаймыз ба?
Dialogue: 0,0:12:44.76,0:12:46.72,Default,,0,0,0,,Елдер қуансын
Dialogue: 0,0:12:46.80,0:12:49.93,Default,,0,0,0,,Сіздің қауіпсіздігіңіз қамтамасыз етіледі.
Dialogue: 0,0:12:50.01,0:12:51.72,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:12:54.10,0:12:55.44,Default,,0,0,0,,Әй... әйтеуір
Dialogue: 0,0:12:56.23,0:12:58.81,Default,,0,0,0,,Мұны қай ауызда айтады?
Dialogue: 0,0:12:58.90,0:13:00.19,Default,,0,0,0,,E… Els?
Dialogue: 0,0:13:00.27,0:13:03.11,Default,,0,0,0,,Мен Биллдің қауіпсіздік туралы айтқанын қаламаймын.
Dialogue: 0,0:13:04.03,0:13:05.49,Default,,0,0,0,,«Урайчи» деп аталатын жерде
Dialogue: 0,0:13:05.57,0:13:07.16,Default,,0,0,0,,Мен шөпқоректілерден жасырын ет сатып алып жесем де.
Dialogue: 0,0:13:07.16,0:13:08.20,Default,,0,0,0,,Мен шөпқоректілерден жасырын ет сатып алып жесем де.
Dialogue: 0,0:13:07.16,0:13:08.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:08.28,0:13:10.08,Default,,0,0,0,,А... неге олай істедің?
Dialogue: 0,0:13:10.74,0:13:13.00,Default,,0,0,0,,Бөлім ішінде қауесеттер таралып үлгерді.
Dialogue: 0,0:13:13.66,0:13:15.25,Default,,0,0,0,,Сіз ет жеп көрдіңіз бе?
Dialogue: 0,0:13:15.33,0:13:18.17,Default,,0,0,0,,«Егер Эльс Местра болса, мен оны шынымен де ұстай аламын».
Dialogue: 0,0:13:18.25,0:13:19.71,Default,,0,0,0,,Менің киім ауыстыратын бөлмеде айтқаным
Dialogue: 0,0:13:19.79,0:13:23.55,Default,,0,0,0,,Сіздің барлық бұзақылықтарыңыз әшкере болады.
Dialogue: 0,0:13:23.63,0:13:24.47,Default,,0,0,0,,Е...
Dialogue: 0,0:13:24.55,0:13:26.97,Default,,0,0,0,,Дегенмен, біз оны жеңдік.
Dialogue: 0,0:13:27.05,0:13:28.89,Default,,0,0,0,,Жабайы жүрме, шөпқоректілер қорқады.
Dialogue: 0,0:13:28.97,0:13:30.93,Default,,0,0,0,,Бұл ұсынылған манга
Dialogue: 0,0:13:31.01,0:13:32.06,Default,,0,0,0,,Адамның жаман және жақсы жақтары
Dialogue: 0,0:13:32.06,0:13:33.97,Default,,0,0,0,,Адамның жаман және жақсы жақтары
Dialogue: 0,0:13:32.06,0:13:33.97,Default,,0,0,0,,Етқоректілерді шөпқоректілермен қоршап, қорғаңыз!
Dialogue: 0,0:13:34.06,0:13:36.02,Default,,0,0,0,,Барлығы көзге түседі...
Dialogue: 0,0:13:36.73,0:13:38.60,Default,,0,0,0,,Бұл клуб әрекеті!
Dialogue: 0,0:13:38.69,0:13:40.15,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:13:40.23,0:13:42.19,Default,,0,0,0,,Неліктен мұндай уақытта?
Dialogue: 0,0:13:42.27,0:13:44.65,Default,,0,0,0,,Шығару оңай болды...
Dialogue: 0,0:13:44.74,0:13:47.11,Default,,0,0,0,,Аа, бұл жеткілікті Эльс
Dialogue: 0,0:13:47.20,0:13:49.20,Default,,0,0,0,,Сен маған айқайлауға үйренбегенсің ғой?
Dialogue: 0,0:13:49.78,0:13:52.83,Default,,0,0,0,,Кешіріңіз, бұл менің кінәм болды.
Dialogue: 0,0:13:52.91,0:13:54.20,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:13:55.75,0:13:57.29,Default,,0,0,0,,Қарсылық білдірейік
Dialogue: 0,0:13:57.37,0:13:59.75,Default,,0,0,0,,Мен де үйірме жұмыстарын жалғастырғым келеді.
Dialogue: 0,0:13:59.83,0:14:01.71,Default,,0,0,0,,Дайындық залына барайық
Dialogue: 0,0:14:02.29,0:14:05.30,Default,,0,0,0,,Бірақ, бұл оңай емес.
Dialogue: 0,0:14:06.05,0:14:07.38,Default,,0,0,0,,Бүгінгі хабарламаға қатысты.
Dialogue: 0,0:14:07.47,0:14:08.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:09.64,0:14:11.68,Default,,0,0,0,,Әй, екеуі де баяу болды.
Dialogue: 0,0:14:11.76,0:14:13.39,Default,,0,0,0,,Қазір барлығы осында
Dialogue: 0,0:14:13.47,0:14:14.39,Default,,0,0,0,,Сонымен... бұл
Dialogue: 0,0:14:14.47,0:14:16.48,Default,,0,0,0,,Мен үйірме жұмыстарын жалғастыру керек деп ойлаймын.
Dialogue: 0,0:14:16.56,0:14:17.56,Default,,0,0,0,,О
Dialogue: 0,0:14:18.31,0:14:21.06,Default,,0,0,0,,Жарайды, бұл жерден не істеу керек деген сұрақ туындайды.
Dialogue: 0,0:14:21.15,0:14:23.11,Default,,0,0,0,,(мүшелердің сөйлейтін дыбыстары)
Dialogue: 0,0:14:23.19,0:14:24.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:24.53,0:14:27.19,Default,,0,0,0,,(мүшелердің сөйлейтін дыбыстары)
Dialogue: 0,0:14:27.28,0:14:29.03,Default,,0,0,0,,Елспен ұрысып қалдыңыз ба?
Dialogue: 0,0:14:29.11,0:14:30.41,Default,,0,0,0,,Қарғыс атсын, ақымақ
Dialogue: 0,0:14:32.24,0:14:34.20,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:14:36.16,0:14:38.96,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:14:39.83,0:14:42.46,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:14:42.54,0:14:44.21,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:44.30,0:14:45.30,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:45.96,0:14:47.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:47.80,0:14:49.84,Default,,0,0,0,,Мен төзімдісін сатып алдым.
Dialogue: 0,0:14:50.43,0:14:52.72,Default,,0,0,0,,Ұйқысыз түн болсын
Dialogue: 0,0:14:53.30,0:14:57.02,Default,,0,0,0,,Пина-кун, сен айтпасаң да
Dialogue: 0,0:14:57.10,0:15:02.31,Default,,0,0,0,,Мен көптен бері тыныш ұйықтай алмадым.
Dialogue: 0,0:15:02.90,0:15:05.11,Default,,0,0,0,,Амансың ба? Ах...
Dialogue: 0,0:15:05.19,0:15:07.07,Default,,0,0,0,,Лиз - ауыр жанама әсер.
Dialogue: 0,0:15:07.15,0:15:10.49,Default,,0,0,0,,Уф... Чикушо соғып жатыр.
Dialogue: 0,0:15:10.57,0:15:12.74,Default,,0,0,0,,Сабырлы бол, сабырлы бол
Dialogue: 0,0:15:12.82,0:15:14.83,Default,,0,0,0,,Біз үлкен аюмыз...
Dialogue: 0,0:15:15.58,0:15:18.75,Default,,0,0,0,,Биіктігі 2 метрден асатын аюлар
Dialogue: 0,0:15:18.83,0:15:23.08,Default,,0,0,0,,Бұлшықет атрофиясын тудыратын препараттарды қабылдау үшін қажет
Dialogue: 0,0:15:23.17,0:15:26.71,Default,,0,0,0,,Өйткені аюлар тұқымдасының басым күші қауіп төндіреді.
Dialogue: 0,0:15:26.80,0:15:28.84,Default,,0,0,0,,Ірі жазатайым оқиғаларды болдырмау үшін.
Dialogue: 0,0:15:28.92,0:15:30.09,Default,,0,0,0,,Бұл жаман нәрсе емес
Dialogue: 0,0:15:31.47,0:15:32.51,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:15:33.26,0:15:37.22,Default,,0,0,0,,Әр түнде есірткі қабылдауға мәжбүрлеуді қорлау болмайды...
Dialogue: 0,0:15:53.41,0:15:58.12,Default,,0,0,0,,Бұл симптомды басатын жалғыз нәрсе бал.
Dialogue: 0,0:15:59.33,0:16:00.70,Default,,0,0,0,,Ммм
Dialogue: 0,0:16:00.79,0:16:03.29,Default,,0,0,0,,Лиз мені үнемі жұбатады.
Dialogue: 0,0:16:03.37,0:16:05.17,Default,,0,0,0,,Лиз жаңғақты жарып жіберді.
Dialogue: 0,0:16:05.25,0:16:07.54,Default,,0,0,0,,Эй, Лиз мейірімді болғандықтан...
Dialogue: 0,0:16:07.54,0:16:07.92,Default,,0,0,0,,Эй, Лиз мейірімді болғандықтан...
Dialogue: 0,0:16:07.54,0:16:07.92,Default,,0,0,0,,Не? Лиз заттарды бөлуге шебер, солай емес пе?
Dialogue: 0,0:16:07.92,0:16:08.00,Default,,0,0,0,,Не? Лиз заттарды бөлуге шебер, солай емес пе?
Dialogue: 0,0:16:08.00,0:16:09.96,Default,,0,0,0,,Не? Лиз заттарды бөлуге шебер, солай емес пе?
Dialogue: 0,0:16:08.00,0:16:09.96,Default,,0,0,0,,Барлығының көз алдында мен кіммін
Dialogue: 0,0:16:09.96,0:16:10.05,Default,,0,0,0,,Не? Лиз заттарды бөлуге шебер, солай емес пе?
Dialogue: 0,0:16:10.05,0:16:11.38,Default,,0,0,0,,Не? Лиз заттарды бөлуге шебер, солай емес пе?
Dialogue: 0,0:16:10.05,0:16:11.38,Default,,0,0,0,,Балды жақсы көретін нәзік және үлкен аю.
Dialogue: 0,0:16:11.38,0:16:13.59,Default,,0,0,0,,Балды жақсы көретін нәзік және үлкен аю.
Dialogue: 0,0:16:14.59,0:16:18.06,Default,,0,0,0,,Менің кім екенімді ешкім білмеді.
Dialogue: 0,0:16:18.97,0:16:20.47,Default,,0,0,0,,Тек бір...
Dialogue: 0,0:16:21.27,0:16:22.94,Default,,0,0,0,,Ол жігіттен басқа
Dialogue: 0,0:16:25.81,0:16:28.36,Default,,0,0,0,,Лизде қорқынышты нәрсе бар.
Dialogue: 0,0:16:28.44,0:16:29.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:29.73,0:16:31.53,Default,,0,0,0,,Тем не деді?
Dialogue: 0,0:16:32.19,0:16:33.07,Default,,0,0,0,,Иә
Dialogue: 0,0:16:33.15,0:16:37.32,Default,,0,0,0,,Қайта қарағанымда оның шынымен де үлкен екенін түсіндім.
Dialogue: 0,0:16:37.91,0:16:40.49,Default,,0,0,0,,Ой... біртүрлі айттым ба? Кешіріңіз
Dialogue: 0,0:16:40.58,0:16:43.66,Default,,0,0,0,,Мен таң қалдым, себебі бұл сөзді бірінші рет естіп тұрмын.
Dialogue: 0,0:16:43.75,0:16:45.54,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:16:45.62,0:16:47.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:47.25,0:16:50.75,Default,,0,0,0,,А... жоқ, кешіріңіз, мен дұрыс айтпаған шығармын.
Dialogue: 0,0:16:51.30,0:16:54.93,Default,,0,0,0,,Мен әр адамның жанды екенін көргенде, сіздің жүзіңіздегі өрнектерге қызығамын.
Dialogue: 0,0:16:59.10,0:17:03.02,Default,,0,0,0,,Жоғары деңгейдегі перспектива шынымен қауіпті ме?
Dialogue: 0,0:17:03.93,0:17:05.73,Default,,0,0,0,,Сіз әрқашан не туралы ойлайсыз?
Dialogue: 0,0:17:06.35,0:17:09.57,Default,,0,0,0,,Балдан тәтті сөздер
Dialogue: 0,0:17:09.65,0:17:12.99,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:13.07,0:17:17.32,Default,,0,0,0,,Мен кенеттен енді жеңілдеп қалдым.
Dialogue: 0,0:17:17.41,0:17:20.53,Default,,0,0,0,,А... бірдеңе уайымдап жүрсе, сұрайын деп едім.
Dialogue: 0,0:17:20.62,0:17:22.24,Default,,0,0,0,,Сыртта шырын ішкіңіз келе ме?
Dialogue: 0,0:17:22.33,0:17:23.91,Default,,0,0,0,,Е... бұл жақсы.
Dialogue: 0,0:17:24.00,0:17:25.41,Default,,0,0,0,,Сіз маған жаңа ғана айттыңыз...
Dialogue: 0,0:17:25.50,0:17:28.42,Default,,0,0,0,,Мен қорқамын дедім, бірақ жаман сөз деп айтпадым.
Dialogue: 0,0:17:30.63,0:17:33.55,Default,,0,0,0,,Тем көргенін айтатын адам еді.
Dialogue: 0,0:17:34.17,0:17:35.97,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:36.05,0:17:39.64,Default,,0,0,0,,Мен аюлардың осылай есірткі қабылдағанын білмедім.
Dialogue: 0,0:17:39.72,0:17:41.22,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:17:41.31,0:17:46.02,Default,,0,0,0,,Осы уақытқа дейін мен отбасымнан басқа ешкімге дәрі туралы айтқан емеспін.
Dialogue: 0,0:17:46.10,0:17:49.31,Default,,0,0,0,,Шөпқоректі жануарға сыр бермейік.
Dialogue: 0,0:17:49.40,0:17:50.36,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:50.44,0:17:52.48,Default,,0,0,0,,Оны жай айту оңай емес пе?
Dialogue: 0,0:17:52.57,0:17:53.44,Default,,0,0,0,,Төтенше
Dialogue: 0,0:17:53.53,0:17:57.78,Default,,0,0,0,,Мен оның шын мәнінде адамдық күшке ие екенін білгенде, ол оны дәрімен басып тастады.
Dialogue: 0,0:17:57.86,0:17:59.57,Default,,0,0,0,,Барлығы тартады
Dialogue: 0,0:17:59.66,0:18:01.37,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:01.95,0:18:04.62,Default,,0,0,0,,Лиздің мейірімді екенін бәрі біледі.
Dialogue: 0,0:18:04.70,0:18:06.08,Default,,0,0,0,,Ешқандай проблема жоқ.
Dialogue: 0,0:18:06.16,0:18:07.00,Default,,0,0,0,,Түрлі?
Dialogue: 0,0:18:07.08,0:18:08.71,Default,,0,0,0,,Хаа…
Dialogue: 0,0:18:08.79,0:18:11.79,Default,,0,0,0,,Нағыз мен мейірімді емес
Dialogue: 0,0:18:12.34,0:18:16.30,Default,,0,0,0,,Мен мейірімділіктің не екенін түсінбеймін.
Dialogue: 0,0:18:16.38,0:18:17.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:17.67,0:18:18.88,Default,,0,0,0,,Әй, эй
Dialogue: 0,0:18:18.97,0:18:22.47,Default,,0,0,0,,Сіз менімен бұрын сөйлескенде, сіз өзіңізді жеңіл сезінетінін айттыңыз.
Dialogue: 0,0:18:22.55,0:18:25.27,Default,,0,0,0,,Енді үйірме жұмыстарынан тыс уақытта жиі кездесейік.
Dialogue: 0,0:18:25.35,0:18:27.35,Default,,0,0,0,,Жанама әсерлер толығымен жойылуы мүмкін.
Dialogue: 0,0:18:29.44,0:18:31.77,Default,,0,0,0,,Тимнің ұсынысы дұрыс болды.
Dialogue: 0,0:18:32.36,0:18:34.27,Default,,0,0,0,,Тиммен бірнеше күн бос әңгіме айтсам да.
Dialogue: 0,0:18:34.27,0:18:35.65,Default,,0,0,0,,Тиммен бірнеше күн бос сөз сөйлесе де.
Dialogue: 0,0:18:34.27,0:18:35.65,Default,,0,0,0,,(Темнің дауысы және Лиздің күлкісі)
Dialogue: 0,0:18:35.65,0:18:35.73,Default,,0,0,0,,(Темнің дауысы және Лиздің күлкісі)
Dialogue: 0,0:18:35.73,0:18:38.36,Default,,0,0,0,,(Темнің дауысы және Лиздің күлкісі)
Dialogue: 0,0:18:35.73,0:18:38.36,Default,,0,0,0,,Менің бал тұтынуым азайды.
Dialogue: 0,0:18:39.74,0:18:41.45,Default,,0,0,0,,Мұның бәрі оның арқасында.
Dialogue: 0,0:18:41.53,0:18:44.16,Default,,0,0,0,,Дәрі қабылдау да көңіл күйді түсірмейді.
Dialogue: 0,0:18:46.16,0:18:47.20,Default,,0,0,0,,Бұл…
Dialogue: 0,0:18:47.79,0:18:50.54,Default,,0,0,0,,Бұл маған қазір керек пе?
Dialogue: 0,0:18:51.79,0:18:54.25,Default,,0,0,0,,Мен жақынырақ болғым келеді
Dialogue: 0,0:18:54.34,0:18:56.00,Default,,0,0,0,,Темаға дейінгі қашықтық
Dialogue: 0,0:18:56.09,0:18:57.76,Default,,0,0,0,,Өзіңізге адал болыңыз
Dialogue: 0,0:19:04.97,0:19:06.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:06.60,0:19:09.89,Default,,0,0,0,,Бүгін Лизге бірдеңе болды ма?
Dialogue: 0,0:19:09.98,0:19:11.94,Default,,0,0,0,,Менің денем ісіп кетті...
Dialogue: 0,0:19:12.02,0:19:12.98,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:19:13.06,0:19:15.27,Default,,0,0,0,,Мен алғаш рет дәрі-дәрмектен бас тартуға тырыстым.
Dialogue: 0,0:19:15.36,0:19:17.19,Default,,0,0,0,,Не істеп жатырсың?
Dialogue: 0,0:19:17.28,0:19:18.36,Default,,0,0,0,,Бұл жаман болар еді.
Dialogue: 0,0:19:18.44,0:19:21.36,Default,,0,0,0,,Маған бұл енді керек емес.
Dialogue: 0,0:19:22.95,0:19:24.03,Default,,0,0,0,,Неге қашып бара жатырсың?
Dialogue: 0,0:19:24.12,0:19:25.12,Default,,0,0,0,,Уау
Dialogue: 0,0:19:25.20,0:19:26.12,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:26.20,0:19:28.04,Default,,0,0,0,,Ха ха ха... Уф!
Dialogue: 0,0:19:29.91,0:19:31.83,Default,,0,0,0,,Күту.
Dialogue: 0,0:19:31.92,0:19:35.42,Default,,0,0,0,,Тем, мен сенің нағыз мені көргім келді.
Dialogue: 0,0:19:41.51,0:19:42.89,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:42.97,0:19:44.97,Default,,0,0,0,,Біз бір-бірімізді түсінуіміз керек, солай ма? біз
Dialogue: 0,0:19:45.64,0:19:47.26,Default,,0,0,0,,Бұл солай болуы керек пе?
Dialogue: 0,0:19:48.22,0:19:51.77,Default,,0,0,0,,Етқоректілердің бәрі - құбыжықтар!
Dialogue: 0,0:19:52.90,0:19:56.06,Default,,0,0,0,,Темнің сөзі де, көзі де соны айтты.
Dialogue: 0,0:19:56.15,0:19:58.90,Default,,0,0,0,,Ең әдемі нәрсе
Dialogue: 0,0:19:58.98,0:20:01.03,Default,,0,0,0,,Нағыз достық сияқты
Dialogue: 0,0:20:01.70,0:20:02.78,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:03.41,0:20:05.66,Default,,0,0,0,,Енді ештеңені жасырудың қажеті жоқ
Dialogue: 0,0:20:06.53,0:20:08.29,Default,,0,0,0,,Біз ең жақсы достармыз
Dialogue: 0,0:20:08.37,0:20:09.75,Default,,0,0,0,,А...
Dialogue: 0,0:20:10.54,0:20:12.25,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:20:12.33,0:20:14.21,Default,,0,0,0,,Осыншама адамдық күш
Dialogue: 0,0:20:14.71,0:20:17.09,Default,,0,0,0,,Сіздің керемет даралығыңыз
Dialogue: 0,0:20:18.92,0:20:22.26,Default,,0,0,0,,Мен сен туралы бәрін қабылдаймын, Лиз.
Dialogue: 0,0:20:23.38,0:20:25.59,Default,,0,0,0,,Енді азап шегудің қажеті жоқ
Dialogue: 0,0:20:27.01,0:20:28.39,Default,,0,0,0,,Тем…
Dialogue: 0,0:20:40.94,0:20:42.19,Default,,0,0,0,,Тем
Dialogue: 0,0:20:47.37,0:20:48.62,Default,,0,0,0,,Тем?
Dialogue: 0,0:20:49.66,0:20:53.29,Default,,0,0,0,,Қан мен ет кесектері әр жерде шашыранды.
Dialogue: 0,0:20:53.87,0:20:56.38,Default,,0,0,0,,Шарасыз қарсылықтың іздері
Dialogue: 0,0:20:57.13,0:20:59.84,Default,,0,0,0,,Тіпті менің Теммен болған естеліктерім
Dialogue: 0,0:20:59.92,0:21:02.38,Default,,0,0,0,,Барлығы иллюзияға айналады
Dialogue: 0,0:21:02.46,0:21:05.63,Default,,0,0,0,,Кез келген жағдайда аулақ болу керек
Dialogue: 0,0:21:06.64,0:21:09.43,Default,,0,0,0,,Текстура түсі…
Dialogue: 0,0:21:09.51,0:21:13.02,Default,,0,0,0,,Жылу дәмі…
Dialogue: 0,0:21:13.10,0:21:17.23,Default,,0,0,0,,Менің жарқын жастық шағым туралы
Dialogue: 0,0:21:18.98,0:21:20.94,Default,,0,0,0,,Өлгенше ұмытпа
Dialogue: 0,0:21:20.94,0:21:21.44,Default,,0,0,0,,Өлгенше ұмытпа
Dialogue: 0,0:21:20.94,0:21:21.44,Default,,0,0,0,,Ах~ Дәмді Әдеттегідей рахмет
Dialogue: 0,0:21:21.44,0:21:22.07,Default,,0,0,0,,Ах~ Дәмді Әдеттегідей рахмет
Dialogue: 0,0:21:22.07,0:21:23.94,Default,,0,0,0,,Ах~ Дәмді Әдеттегідей рахмет
Dialogue: 0,0:21:22.07,0:21:23.94,Default,,0,0,0,,Менің қазынам
Dialogue: 0,0:21:23.94,0:21:24.90,Default,,0,0,0,,Ах~ Дәмді Әдеттегідей рахмет
Dialogue: 0,0:21:32.04,0:21:38.04,Default,,0,0,0,,♪～
Dialogue: 0,0:22:52.32,0:22:58.33,Default,,0,0,0,,～♪
