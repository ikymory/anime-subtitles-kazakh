Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.09,0:00:18.10,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.92,0:01:39.18,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.10,0:01:44.10,Default,,0,0,0,,Хмм…
Dialogue: 0,0:01:45.39,0:01:48.90,Default,,0,0,0,,Шиши-гуми табысы шарықтау шегіне жақындады.
Dialogue: 0,0:01:48.98,0:01:52.61,Default,,0,0,0,,Иә, шөпқоректілердің арқасында.
Dialogue: 0,0:01:53.11,0:01:57.03,Default,,0,0,0,,Алайда, дәріханашы біртүрлі әрекет жасады.
Dialogue: 0,0:01:58.11,0:01:58.99,Default,,0,0,0,,Не?
Dialogue: 0,0:01:59.86,0:02:04.20,Default,,0,0,0,,«Құбыжық дәрінің» шикізаты болып табылатын піл сүйегі енді жоқ.
Dialogue: 0,0:02:04.29,0:02:06.58,Default,,0,0,0,,Бұл топ үшін маңызды табыс көзі емес пе?
Dialogue: 0,0:02:06.66,0:02:07.83,Default,,0,0,0,,Иә
Dialogue: 0,0:02:07.91,0:02:10.29,Default,,0,0,0,,Қону кезінде жойылған болуы мүмкін.
Dialogue: 0,0:02:11.88,0:02:13.00,Default,,0,0,0,,Егер біз Бастың кім екенін нақты анықтап, оны өлтіруді жүзеге асырмасақ, біз оған жеңілеміз.
Dialogue: 0,0:02:13.59,0:02:14.75,Default,,0,0,0,,Иә
Dialogue: 0,0:02:22.22,0:02:25.14,Default,,0,0,0,,Менің ішімдегі иіс сақтау орны
Dialogue: 0,0:02:26.52,0:02:31.98,Default,,0,0,0,,Мен 17 жыл бойы иіскеген сансыз иіс деректерінің ішінде
Dialogue: 0,0:02:32.06,0:02:34.82,Default,,0,0,0,,Біз қорғағымыз келетін жануарлардың иісі туралы деректер ғана бар.
Dialogue: 0,0:02:34.90,0:02:36.86,Default,,0,0,0,,Бірінен соң бірі артады
Dialogue: 0,0:02:38.57,0:02:42.99,Default,,0,0,0,,Бұл әлі де шығарудың ең оңай деңгейінде.
Dialogue: 0,0:02:43.49,0:02:45.49,Default,,0,0,0,,Луи-сенпайдың иісі
Dialogue: 0,0:02:46.33,0:02:48.12,Default,,0,0,0,,（）
Dialogue: 0,0:02:49.04,0:02:49.87,Default,,0,0,0,,Rohan-нан басқа тағы бірнеше адамға айтқансың—
Dialogue: 0,0:02:49.96,0:02:50.96,Default,,0,0,0,,Ах
Dialogue: 0,0:02:51.83,0:02:54.67,Default,,0,0,0,,Жұмыс істеп жүріп өз әлеміңізге кірмеңіз
Dialogue: 0,0:02:54.75,0:02:56.38,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:02:57.55,0:03:01.13,Default,,0,0,0,,Бұл жігіттер бүгінде қарақұйрық етіне құмар.
Dialogue: 0,0:03:02.76,0:03:06.51,Default,,0,0,0,,Сол тербеліс мас қимылы емес.
Dialogue: 0,0:03:06.60,0:03:08.85,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:03:08.93,0:03:10.73,Default,,0,0,0,,Сіз мұны өзіңіз жасай алатын сияқтысыз.
Dialogue: 0,0:03:10.81,0:03:11.85,Default,,0,0,0,,Иә
Dialogue: 0,0:03:11.94,0:03:13.23,Default,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:03:15.32,0:03:16.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:18.23,0:03:21.57,Default,,0,0,0,,Хаа... аа...
Dialogue: 0,0:03:21.65,0:03:22.95,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:23.03,0:03:24.37,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:03:24.45,0:03:26.24,Default,,0,0,0,,Сол ессіз тұмсықты кигенде
Dialogue: 0,0:03:26.33,0:03:27.20,Default,,0,0,0,,Не?!
Dialogue: 0,0:03:27.95,0:03:32.42,Default,,0,0,0,,Мұнда Гохин-санның әрбір нәсілге арналған стратегияның тікелей әдісі
Dialogue: 0,0:03:33.17,0:03:36.00,Default,,0,0,0,,Тек басқа адамға науқас ретінде қарау.
Dialogue: 0,0:03:36.09,0:03:38.34,Default,,0,0,0,,Алдымен көзбен жақсы байланыста болу керек
Dialogue: 0,0:03:39.13,0:03:41.26,Default,,0,0,0,,Барыстан қашсаң, қуып жете алмайсың.
Dialogue: 0,0:03:41.34,0:03:43.30,Default,,0,0,0,,Көлік жүргізудің алдын алу
Dialogue: 0,0:03:44.01,0:03:48.51,Default,,0,0,0,,Екі жануарға қарсы тұрғанда қорғаныс аймағын кеңейту үшін үлкен денені пайдаланыңыз.
Dialogue: 0,0:03:49.35,0:03:51.14,Default,,0,0,0,,Құстарда не қорқынышты?
Dialogue: 0,0:03:51.23,0:03:54.56,Default,,0,0,0,,Айқайлап құлағың жарылып кеткеннен гөрі
Dialogue: 0,0:03:55.10,0:03:58.48,Default,,0,0,0,,Дауысыңызды жұдырықпен жұлып алыңыз
Dialogue: 0,0:03:59.11,0:04:01.69,Default,,0,0,0,,Ешқашан бірінші қадамды бермеңіз
Dialogue: 0,0:04:06.45,0:04:09.70,Default,,0,0,0,,Маған Гохин-санның арнайы ұйықтататын дәрілерін беріңізші.
Dialogue: 0,0:04:12.00,0:04:13.58,Default,,0,0,0,,Бір қадам жоғары
Dialogue: 0,0:04:18.13,0:04:21.26,Default,,0,0,0,,Хмм, жасайық, Легоши.
Dialogue: 0,0:04:21.34,0:04:22.42,Default,,0,0,0,,Жаттығуға да болады.
Dialogue: 0,0:04:22.51,0:04:25.93,Default,,0,0,0,,Менің жұмысым жеңілдеді, мен бір оқпен екі құсты өлтіремін.
Dialogue: 0,0:04:26.01,0:04:27.55,Default,,0,0,0,,Мен бүгін жақсы саке іше аламын...
Dialogue: 0,0:04:27.64,0:04:28.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:28.55,0:04:30.31,Default,,0,0,0,,Хмм... у...
Dialogue: 0,0:04:30.39,0:04:31.64,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:04:32.23,0:04:33.69,Default,,0,0,0,,Әлі де жеткіліксіз
Dialogue: 0,0:04:34.23,0:04:36.81,Default,,0,0,0,,Бұл деңгейде сіз қоңыр аюды жеңе алмайсыз.
Dialogue: 0,0:04:36.90,0:04:38.61,Default,,0,0,0,,Ей, артық етпе.
Dialogue: 0,0:04:38.69,0:04:39.82,Default,,0,0,0,,Менің денем біртүрлі әрекет етеді.
Dialogue: 0,0:04:40.57,0:04:44.15,Default,,0,0,0,,Сіз мұндай жалаң жаттығу әдістерімен өспейсіз.
Dialogue: 0,0:04:45.49,0:04:48.57,Default,,0,0,0,,Себебі кінәлі қоңыр аю болды.
Dialogue: 0,0:04:48.66,0:04:50.83,Default,,0,0,0,,Легоши одақтастарын жасаңыз
Dialogue: 0,0:04:51.37,0:04:53.91,Default,,0,0,0,,Бұлай жалғаса берсе, ол қысымның әсерінен құлайды.
Dialogue: 0,0:04:54.71,0:04:57.96,Default,,0,0,0,,Бұл қысыммен езілетін уақыт емес.
Dialogue: 0,0:04:58.04,0:05:02.05,Default,,0,0,0,,Тіпті менің рухани одақтасым болды.
Dialogue: 0,0:05:02.67,0:05:05.01,Default,,0,0,0,,Луи-сенпай, қазір қайдасың?
Dialogue: 0,0:05:05.01,0:05:06.18,Default,,0,0,0,,Луи-сенпай, қазір қайдасың?
Dialogue: 0,0:05:06.26,0:05:08.22,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:09.68,0:05:11.22,Default,,0,0,0,,Профессор Гохин
Dialogue: 0,0:05:11.31,0:05:12.35,Default,,0,0,0,,О
Dialogue: 0,0:05:16.73,0:05:20.27,Default,,0,0,0,,Бұл жыртқыштық инстинкті басатын музыка.
Dialogue: 0,0:05:20.36,0:05:22.36,Default,,0,0,0,,Ұйықтағанда міндетті түрде тыңдаңыз
Dialogue: 0,0:05:22.44,0:05:23.28,Default,,0,0,0,,Иә
Dialogue: 0,0:05:24.32,0:05:26.90,Default,,0,0,0,,Шынымен... Мен...
Dialogue: 0,0:05:26.99,0:05:29.03,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:05:29.12,0:05:30.91,Default,,0,0,0,,Өзіңізге сенімді болыңыз
Dialogue: 0,0:05:30.99,0:05:32.45,Default,,0,0,0,,Егер сізде тағы бір мәселе туындаса, кез келген уақытта маған келіңіз.
Dialogue: 0,0:05:33.16,0:05:34.12,Default,,0,0,0,,Иә
Dialogue: 0,0:05:34.20,0:05:36.83,Default,,0,0,0,,(Сүйек сынуының дыбысы)
Dialogue: 0,0:05:39.33,0:05:42.34,Default,,0,0,0,,Бұл науқас екі күзенді өлтірді.
Dialogue: 0,0:05:42.42,0:05:45.09,Default,,0,0,0,,Ол да сол кезде абдырап қалған.
Dialogue: 0,0:05:45.92,0:05:47.72,Default,,0,0,0,,Мен жақсы реабилитациядан өттім.
Dialogue: 0,0:05:50.01,0:05:51.60,Default,,0,0,0,,Гухин мырза?
Dialogue: 0,0:05:51.68,0:05:53.77,Default,,0,0,0,,«Ет» науқастары
Dialogue: 0,0:05:53.85,0:05:55.93,Default,,0,0,0,,Сен мені полицияға мүлдем апармадың.
Dialogue: 0,0:05:56.64,0:05:57.73,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:57.81,0:05:59.77,Default,,0,0,0,,Бұл өте жаман...
Dialogue: 0,0:06:00.98,0:06:02.19,Default,,0,0,0,,Легоши
Dialogue: 0,0:06:02.73,0:06:06.03,Default,,0,0,0,,Мен панда болып туылдым.
Dialogue: 0,0:06:06.11,0:06:08.36,Default,,0,0,0,,Тек ет жегім келмейді.
Dialogue: 0,0:06:09.28,0:06:12.12,Default,,0,0,0,,Мен өзімнің әділдігімнен өтіп жатырмын
Dialogue: 0,0:06:12.78,0:06:17.46,Default,,0,0,0,,Әлем жазалау арқылы бейбітшілік орнату үшін қарапайым емес.
Dialogue: 0,0:06:18.62,0:06:22.17,Default,,0,0,0,,Кез келген жыртқыш адамға байланысты қалпына келеді.
Dialogue: 0,0:06:23.34,0:06:26.17,Default,,0,0,0,,Мен саған иығымды бергім келеді.
Dialogue: 0,0:06:30.13,0:06:33.26,Default,,0,0,0,,Бүгін жұмыс күні, солай ма? Мектеп ше?
Dialogue: 0,0:06:34.31,0:06:36.81,Default,,0,0,0,,А... Мен үзіліс жасаймын...
Dialogue: 0,0:06:36.89,0:06:37.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:38.73,0:06:41.06,Default,,0,0,0,,Мен мектептен шеттетілдім...
Dialogue: 0,0:06:41.15,0:06:42.31,Default,,0,0,0,,Әрине
Dialogue: 0,0:06:43.06,0:06:45.11,Default,,0,0,0,,Ах... мен...
Dialogue: 0,0:06:46.19,0:06:48.99,Default,,0,0,0,,Негізі мен саған қонаққа келмеуім керек еді.
Dialogue: 0,0:06:49.53,0:06:52.82,Default,,0,0,0,,Ах... Кешіріңіз, мен мұндай гүл шоғын елестете алмаймын...
Dialogue: 0,0:06:52.91,0:06:55.08,Default,,0,0,0,,Мұнда кел, иә...
Dialogue: 0,0:06:56.16,0:06:57.25,Default,,0,0,0,,Дао
Dialogue: 0,0:06:58.29,0:06:59.71,Default,,0,0,0,,Менің оң қолымды түртіңіз
Dialogue: 0,0:06:59.79,0:07:02.46,Default,,0,0,0,,Е, мұны істеу мүмкін емес.
Dialogue: 0,0:07:02.54,0:07:03.79,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:07:03.88,0:07:05.71,Default,,0,0,0,,Мен енді шөпқоректілерге тиіспеймін.
Dialogue: 0,0:07:05.80,0:07:06.88,Default,,0,0,0,,Мен де
Dialogue: 0,0:07:06.96,0:07:10.51,Default,,0,0,0,,Мен бұдан былай жыртқыштардан қорқуды қаламаймын.
Dialogue: 0,0:07:20.98,0:07:22.40,Default,,0,0,0,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,0:07:22.48,0:07:23.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:26.90,0:07:27.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:33.78,0:07:35.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:37.91,0:07:39.50,Default,,0,0,0,,Эхехехехехехе
Dialogue: 0,0:07:39.58,0:07:41.62,Default,,0,0,0,,Ма... шын айтасыз ба?
Dialogue: 0,0:07:41.71,0:07:44.08,Default,,0,0,0,,А... Мен бақытты болуым керек пе?
Dialogue: 0,0:07:44.17,0:07:47.38,Default,,0,0,0,,Хехехехехехехе
Dialogue: 0,0:07:48.05,0:07:50.09,Default,,0,0,0,,Мен де зардап шектім
Dialogue: 0,0:07:50.17,0:07:52.59,Default,,0,0,0,,Тіпті Тао да қатты ренжіді, солай емес пе?
Dialogue: 0,0:07:52.68,0:07:53.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:57.35,0:08:00.89,Default,,0,0,0,,Маған қонаққа келгеніңіз үшін рахмет.
Dialogue: 0,0:08:00.98,0:08:07.98,Default,,0,0,0,,(Таоның жылағаны)
Dialogue: 0,0:08:10.57,0:08:16.70,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:08:17.45,0:08:19.33,Default,,0,0,0,,Ішінде ұстағаныңыз бар ма?
Dialogue: 0,0:08:19.41,0:08:20.29,Default,,0,0,0,,Иә
Dialogue: 0,0:08:20.37,0:08:22.96,Default,,0,0,0,,Бірақ мен сіз Шираны кесіп өтуді жоспарлап отырғаныңызға сенімдімін.
Dialogue: 0,0:08:23.04,0:08:26.17,Default,,0,0,0,,Піл сүйегін басқа дос алып, онымен бірге қашып кетті.
Dialogue: 0,0:08:33.55,0:08:34.97,Default,,0,0,0,,Босс
Dialogue: 0,0:08:35.05,0:08:35.89,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:08:35.97,0:08:38.93,Default,,0,0,0,,Біздің асыл етіміз
Dialogue: 0,0:08:39.01,0:08:42.14,Default,,0,0,0,,Үндемей тамақ ішпе.
Dialogue: 0,0:08:45.81,0:08:48.44,Default,,0,0,0,,Не... Легоши?
Dialogue: 0,0:08:50.98,0:08:52.40,Default,,0,0,0,,Бастық?
Dialogue: 0,0:08:52.49,0:08:53.82,Default,,0,0,0,,Тұр!
Dialogue: 0,0:08:53.90,0:08:54.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:55.53,0:08:58.74,Default,,0,0,0,,Сыртқы түрін өзгертсеңіз де, оңай айта аласыз
Dialogue: 0,0:08:58.82,0:09:02.45,Default,,0,0,0,,Мен осындай жерде кездескім келетін соңғы адам
Dialogue: 0,0:09:02.54,0:09:03.62,Default,,0,0,0,,Неге...
Dialogue: 0,0:09:03.70,0:09:06.75,Default,,0,0,0,,Бұл не... арман?
Dialogue: 0,0:09:07.42,0:09:11.30,Default,,0,0,0,,Шиши-гуми бастық? Луи-сенпай?
Dialogue: 0,0:09:11.92,0:09:13.59,Default,,0,0,0,,Менің серіктесім қайда кетті?
Dialogue: 0,0:09:13.67,0:09:15.88,Default,,0,0,0,,Ух... сондықтан маған сеніңіз.
Dialogue: 0,0:09:15.97,0:09:19.05,Default,,0,0,0,,Мен Кот-д'Ивуар туралы ештеңе білмеймін, ал қашып кеткен адам туралы ештеңе білмеймін ...
Dialogue: 0,0:09:19.14,0:09:21.06,Default,,0,0,0,,Дәмді ет жеуге соншалық, ұмытып кеттің бе?
Dialogue: 0,0:09:21.14,0:09:22.85,Default,,0,0,0,,Мен ет жемеймін.
Dialogue: 0,0:09:22.93,0:09:25.77,Default,,0,0,0,,Бұл жұдырықтан қан кеткен мұрын, сондықтан...
Dialogue: 0,0:09:25.85,0:09:26.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.77,0:09:28.81,Default,,0,0,0,,Мынау не жігіт...
Dialogue: 0,0:09:28.90,0:09:30.69,Default,,0,0,0,,Атмосфераны оқы
Dialogue: 0,0:09:30.77,0:09:32.19,Default,,0,0,0,,Менің құйрығым
Dialogue: 0,0:09:32.28,0:09:35.28,Default,,0,0,0,,Ха, бұл жағдайда неге құйрығыңды бұлғап тұрсың?
Dialogue: 0,0:09:36.07,0:09:39.74,Default,,0,0,0,,Мен Луи-сенпайды көп уақыттан кейін көргеніме қуаныштымын.
Dialogue: 0,0:09:39.82,0:09:43.33,Default,,0,0,0,,Бірақ қазір уақыт емес...
Dialogue: 0,0:09:44.70,0:09:46.87,Default,,0,0,0,,Бастыққа асықпа
Dialogue: 0,0:09:46.96,0:09:50.21,Default,,0,0,0,,Уау... у...
Dialogue: 0,0:09:50.29,0:09:51.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:51.67,0:09:54.30,Default,,0,0,0,,Мектепте әділдік жасағанда
Dialogue: 0,0:09:54.38,0:09:57.51,Default,,0,0,0,,«Артқы базарда» жасырын ет жеп жүргенін білмедім.
Dialogue: 0,0:09:57.59,0:09:59.97,Default,,0,0,0,,Уф! Ааааааа...
Dialogue: 0,0:10:00.05,0:10:02.01,Default,,0,0,0,,Мен ақымақпын
Dialogue: 0,0:10:02.10,0:10:03.97,Default,,0,0,0,,Барлық жерде тым тәтті
Dialogue: 0,0:10:03.97,0:10:04.60,Default,,0,0,0,,Барлық жерде тым тәтті
Dialogue: 0,0:10:03.97,0:10:04.60,Default,,0,0,0,,Сәлем! Уау
Dialogue: 0,0:10:04.60,0:10:04.68,Default,,0,0,0,,Сәлем! Уау
Dialogue: 0,0:10:04.68,0:10:05.18,Default,,0,0,0,,Сәлем! Уау
Dialogue: 0,0:10:04.68,0:10:05.18,Default,,0,0,0,,Бұл жыртқыштың жалғыз шынайы ар-ұжданы.
Dialogue: 0,0:10:05.18,0:10:05.27,Default,,0,0,0,,Бұл жыртқыштың жалғыз шынайы ар-ұжданы.
Dialogue: 0,0:10:05.27,0:10:06.81,Default,,0,0,0,,Бұл жыртқыштың жалғыз шынайы ар-ұжданы.
Dialogue: 0,0:10:05.27,0:10:06.81,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:06.81,0:10:08.27,Default,,0,0,0,,Бұл жыртқыштың жалғыз шынайы ар-ұжданы.
Dialogue: 0,0:10:08.35,0:10:11.65,Default,,0,0,0,,Жүрегімнің бір жерінде, Мен әрқашан сенетінмін
Dialogue: 0,0:10:12.52,0:10:16.90,Default,,0,0,0,,Менімен танысқаныңызға қуаныштысыз ба? Соғұрлым құйрығыңды шайқасаң
Dialogue: 0,0:10:16.99,0:10:20.53,Default,,0,0,0,,Мен бұл дүниеде ең жек көретін нәрсе
Dialogue: 0,0:10:20.62,0:10:22.74,Default,,0,0,0,,Сен сияқты өтірікші.
Dialogue: 0,0:10:22.83,0:10:24.08,Default,,0,0,0,,Жетеді
Dialogue: 0,0:10:26.70,0:10:28.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:30.42,0:10:33.34,Default,,0,0,0,,Мен сіздің шынайы болмысыңызды тікелей ашамын.
Dialogue: 0,0:10:34.13,0:10:36.55,Default,,0,0,0,,Жүр, көрсетші.
Dialogue: 0,0:10:36.63,0:10:40.43,Default,,0,0,0,,Менің көз алдымда шындықты айт
Dialogue: 0,0:10:46.93,0:10:48.60,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:10:48.68,0:10:50.14,Default,,0,0,0,,Неше жаста?
Dialogue: 0,0:10:50.23,0:10:52.40,Default,,0,0,0,,Есімі Хару...
Dialogue: 0,0:10:52.48,0:10:54.86,Default,,0,0,0,,27 Мен түнде жұмыс істеймін.
Dialogue: 0,0:10:55.61,0:10:56.57,Default,,0,0,0,,А... бұрын...
Dialogue: 0,0:10:56.65,0:10:59.61,Default,,0,0,0,,Жағдайға байланысты денем қозып кетті.
Dialogue: 0,0:10:59.70,0:11:01.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:01.11,0:11:03.95,Default,,0,0,0,,Масохистік қожайын? (Легошидің жөтелі)
Dialogue: 0,0:11:04.03,0:11:06.33,Default,,0,0,0,,Сіз біртүрлі адамсыз.
Dialogue: 0,0:11:06.41,0:11:08.20,Default,,0,0,0,,Жо... жиі айтылады.
Dialogue: 0,0:11:09.08,0:11:13.25,Default,,0,0,0,,Бұл өте қауіпті жағдай емес пе?
Dialogue: 0,0:11:13.33,0:11:16.80,Default,,0,0,0,,Луи-сенпай, мені шақырғанда не ойладыңыз?
Dialogue: 0,0:11:19.09,0:11:21.72,Default,,0,0,0,,Харуо, ойланбастан тамақтан.
Dialogue: 0,0:11:22.64,0:11:24.89,Default,,0,0,0,,Иә, бұл кері нарық.
Dialogue: 0,0:11:24.97,0:11:26.51,Default,,0,0,0,,Қалағаныңызша жеңіз
Dialogue: 0,0:11:26.60,0:11:27.56,Default,,0,0,0,,Ұялмаңыз
Dialogue: 0,0:11:27.64,0:11:28.47,Default,,0,0,0,,Жеуге болмайды
Dialogue: 0,0:11:28.56,0:11:29.98,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:30.06,0:11:33.31,Default,,0,0,0,,Кешіріңіз, мен тамаша түлкімін.
Dialogue: 0,0:11:33.40,0:11:35.61,Default,,0,0,0,,Мен тек қуырылған тофу жей аламын.
Dialogue: 0,0:11:35.69,0:11:39.69,Default,,0,0,0,,Қанша өтірік айтасың, қарғыс атқыр қасқыр?
Dialogue: 0,0:11:39.78,0:11:41.74,Default,,0,0,0,,Көптеген түлкілер жегіш келеді.
Dialogue: 0,0:11:41.82,0:11:45.53,Default,,0,0,0,,Хахаха мен түсінбедім.
Dialogue: 0,0:11:46.20,0:11:48.99,Default,,0,0,0,,Көріп отырғаныңыздай, біздің бастығымыз
Dialogue: 0,0:11:49.08,0:11:52.25,Default,,0,0,0,,Жас, әдемі, марал
Dialogue: 0,0:11:52.33,0:11:55.00,Default,,0,0,0,,Адамдар ет жегенді ұнатады.
Dialogue: 0,0:11:55.08,0:11:56.04,Default,,0,0,0,,О
Dialogue: 0,0:11:58.00,0:12:00.55,Default,,0,0,0,,Каннибализм - ең жақсысы.
Dialogue: 0,0:12:03.68,0:12:06.05,Default,,0,0,0,,О, бұл үлкен тістеу.
Dialogue: 0,0:12:06.14,0:12:07.72,Default,,0,0,0,,Бастық күткендей.
Dialogue: 0,0:12:07.81,0:12:09.81,Default,,0,0,0,,Менің рухым бөлек.
Dialogue: 0,0:12:09.89,0:12:13.98,Default,,0,0,0,,Әділ болып көрінетіндей болсаң.
Dialogue: 0,0:12:14.06,0:12:15.31,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:16.06,0:12:16.65,Default,,0,0,0,,Сіз мені соттай аласыз
Dialogue: 0,0:12:16.65,0:12:18.19,Default,,0,0,0,,Сіз мені соттай аласыз
Dialogue: 0,0:12:16.65,0:12:18.19,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:12:18.27,0:12:22.99,Default,,0,0,0,,(Шиши тобының күлкісі)
Dialogue: 0,0:12:23.07,0:12:26.16,Default,,0,0,0,,Бір-біріңді дұрыс түсінбедіңдер, Легоши.
Dialogue: 0,0:12:27.78,0:12:28.78,Default,,0,0,0,,Эй
Dialogue: 0,0:12:29.66,0:12:32.08,Default,,0,0,0,,Мені бұрынғыдай ұр
Dialogue: 0,0:12:32.16,0:12:33.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:33.79,0:12:35.67,Default,,0,0,0,,Не істеп жатырсың, Сенпай?
Dialogue: 0,0:12:37.33,0:12:39.00,Default,,0,0,0,,Тірі болғаныңызға рахмет
Dialogue: 0,0:12:39.09,0:12:41.01,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:12:41.09,0:12:42.26,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:12:44.26,0:12:48.43,Default,,0,0,0,,Еттің иісі жоқ... мына ақымақ кенжеден.
Dialogue: 0,0:12:49.56,0:12:51.72,Default,,0,0,0,,Мен сені арғы базарда жасырын ет жеп жүр деп ойладым.
Dialogue: 0,0:12:51.72,0:12:52.89,Default,,0,0,0,,Мен сені арғы базарда жасырын ет жеп жүр деп ойладым.
Dialogue: 0,0:12:51.72,0:12:52.89,Default,,0,0,0,,Уф... сен...
Dialogue: 0,0:12:52.89,0:12:53.52,Default,,0,0,0,,Уф... сен...
Dialogue: 0,0:12:53.60,0:12:57.02,Default,,0,0,0,,Тек мектеп сабынының иісі шығады.
Dialogue: 0,0:12:57.10,0:12:59.32,Default,,0,0,0,,Сәлем! Уайымдама, бұл жиіркенішті
Dialogue: 0,0:12:59.40,0:13:01.78,Default,,0,0,0,,Уф... ақымақ! үзіліс
Dialogue: 0,0:13:01.86,0:13:03.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:04.90,0:13:07.11,Default,,0,0,0,,Менімен сөйлесіңізші, Луи-сенпай.
Dialogue: 0,0:13:07.20,0:13:09.20,Default,,0,0,0,,Жарайды, мен кеттім. Қош бол.
Dialogue: 0,0:13:09.28,0:13:12.04,Default,,0,0,0,,Мен бұл жігіттің тітіркендіргіш екенін қатты сезіндім.
Dialogue: 0,0:13:12.12,0:13:13.79,Default,,0,0,0,,Бірден тіріл
Dialogue: 0,0:13:14.62,0:13:19.21,Default,,0,0,0,,Сіз мені ақымақ күштеріңізбен үнемі күшпен басып отырсаңыз да.
Dialogue: 0,0:13:19.29,0:13:21.34,Default,,0,0,0,,Адам ес-түссіз...
Dialogue: 0,0:13:23.13,0:13:26.34,Default,,0,0,0,,Өрнек неғұрлым кінәсіз болса, соғұрлым көп
Dialogue: 0,0:13:26.43,0:13:29.51,Default,,0,0,0,,Мен дәрменсіздіктің бас айналуын сезінемін.
Dialogue: 0,0:13:31.31,0:13:33.56,Default,,0,0,0,,Сен де енді түсіндің.
Dialogue: 0,0:13:33.64,0:13:37.14,Default,,0,0,0,,Мен қазір Шиши-гумимен олардың бастығы ретінде жұмыс істеймін.
Dialogue: 0,0:13:38.15,0:13:39.90,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:13:39.98,0:13:41.98,Default,,0,0,0,,Бұл менің кінәм, солай ма?
Dialogue: 0,0:13:42.78,0:13:44.40,Default,,0,0,0,,Мен қатыстым, солай ма?
Dialogue: 0,0:13:44.49,0:13:46.40,Default,,0,0,0,,Өйткені мен... мені мазақ етпе!
Dialogue: 0,0:13:46.49,0:13:48.91,Default,,0,0,0,,Өмірімді сен сияқты біреу басқаратынына шыдай алмаймын.
Dialogue: 0,0:13:49.95,0:13:52.99,Default,,0,0,0,,Мен сіз Харуды Шиши-гумиден құтқарғаныңызды білемін.
Dialogue: 0,0:13:53.49,0:13:56.33,Default,,0,0,0,,Мен оның құрбаны болған жоқпын.
Dialogue: 0,0:13:56.41,0:13:58.46,Default,,0,0,0,,Мен бұл жолды өзім таңдадым.
Dialogue: 0,0:13:58.54,0:14:01.29,Default,,0,0,0,,(Шиши тобының күлкісі)
Dialogue: 0,0:14:01.38,0:14:03.25,Default,,0,0,0,,Басқа ескертуде.
Dialogue: 0,0:14:03.34,0:14:05.09,Default,,0,0,0,,Харуды жиі ұстайтын қол
Dialogue: 0,0:14:05.17,0:14:06.38,Default,,0,0,0,,Сен маған тидің, иә?
Dialogue: 0,0:14:06.47,0:14:07.68,Default,,0,0,0,,Бұл... бұл... құшақтау ма?
Dialogue: 0,0:14:07.76,0:14:09.01,Default,,0,0,0,,(кекірген дауыс)
Dialogue: 0,0:14:09.09,0:14:10.72,Default,,0,0,0,,Жоқ...жоқ.
Dialogue: 0,0:14:10.80,0:14:14.56,Default,,0,0,0,,...Менің айтайын дегенім, біз тіпті кездеспейтін шығармыз.
Dialogue: 0,0:14:14.64,0:14:17.02,Default,,0,0,0,,А? Сіз тастап кеттіңіз бе?
Dialogue: 0,0:14:17.10,0:14:19.81,Default,,0,0,0,,Жоқ, жақсы...
Dialogue: 0,0:14:19.90,0:14:22.40,Default,,0,0,0,,А... Мені тастап кеткен болар.
Dialogue: 0,0:14:22.48,0:14:25.03,Default,,0,0,0,,Жоқ, мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:14:25.73,0:14:26.99,Default,,0,0,0,,О, расымен бе?
Dialogue: 0,0:14:27.53,0:14:30.66,Default,,0,0,0,,Хару-чан сенің қайтуыңды күтіп отыр.
Dialogue: 0,0:14:31.32,0:14:32.16,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:33.99,0:14:38.71,Default,,0,0,0,,Мен мықты болу үшін қазір артқы нарықта дәрігердің қол астында жаттығып жатырмын.
Dialogue: 0,0:14:40.88,0:14:43.21,Default,,0,0,0,,Сіз қандай да бір жаттығу жасадыңыз ба?
Dialogue: 0,0:14:43.29,0:14:45.67,Default,,0,0,0,,Мен денем тым үлкен болып кетті деп ойладым.
Dialogue: 0,0:14:45.75,0:14:47.26,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:47.84,0:14:51.80,Default,,0,0,0,,Бірақ сіз қанша жаттығу жасасаңыз да,
Dialogue: 0,0:14:51.89,0:14:56.27,Default,,0,0,0,,Қыздармен бір-бірін түсіну әрқашан қиын.
Dialogue: 0,0:14:58.64,0:14:59.98,Default,,0,0,0,,Луи Сенпай
Dialogue: 0,0:15:02.02,0:15:06.28,Default,,0,0,0,,Өтінемін, қазір менімен қашасың ба?
Dialogue: 0,0:15:08.82,0:15:10.20,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:15:10.28,0:15:12.53,Default,,0,0,0,,Мен қазір керекпін
Dialogue: 0,0:15:12.62,0:15:14.58,Default,,0,0,0,,Шиши-гуми, мені бәрі жақсы көреді.
Dialogue: 0,0:15:14.66,0:15:15.66,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:16.33,0:15:17.91,Default,,0,0,0,,Мені алдап жатыр.
Dialogue: 0,0:15:18.00,0:15:20.04,Default,,0,0,0,,Бұлай жалғаса берсе, Луи-сенпайдың жүрегінің түбіне жетеді.
Dialogue: 0,0:15:20.12,0:15:21.54,Default,,0,0,0,,Мен олардан жұқтырдым
Dialogue: 0,0:15:22.25,0:15:25.46,Default,,0,0,0,,Мен... Мен бұған назар аудара алмаймын.
Dialogue: 0,0:15:27.42,0:15:29.88,Default,,0,0,0,,Сізде бұрынғыдай әділеттілік сезімі бар.
Dialogue: 0,0:15:32.34,0:15:36.06,Default,,0,0,0,,Өмір сүру – алдау екені рас.
Dialogue: 0,0:15:37.01,0:15:38.14,Default,,0,0,0,,Бірақ білесің бе—
Dialogue: 0,0:15:38.77,0:15:41.44,Default,,0,0,0,,Қызығушылық қатынасы ретінде басталса да
Dialogue: 0,0:15:45.27,0:15:49.19,Default,,0,0,0,,Енді бұл менің отбасым
Dialogue: 0,0:15:53.41,0:15:56.62,Default,,0,0,0,,Бәрі де сен сияқты бейқам.
Dialogue: 0,0:15:56.70,0:16:01.33,Default,,0,0,0,,Шөпқоректі басы бар Шиши-гуми дөңгелек пішінге айналған болуы керек.
Dialogue: 0,0:16:02.62,0:16:04.46,Default,,0,0,0,,Ол боялмаған.
Dialogue: 0,0:16:04.54,0:16:06.92,Default,,0,0,0,,Мен осы жағындамын.
Dialogue: 0,0:16:07.59,0:16:09.92,Default,,0,0,0,,Өйткені сатушыда шөпқоректі жануар бар
Dialogue: 0,0:16:10.01,0:16:12.93,Default,,0,0,0,,Жүрегі құтқарылатын кедейлер көп.
Dialogue: 0,0:16:13.51,0:16:16.55,Default,,0,0,0,,Бұл жерде мен ғана істей алатын нәрсе бар.
Dialogue: 0,0:16:17.72,0:16:18.56,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:19.22,0:16:21.77,Default,,0,0,0,,Сіз тек жарыққа қарай алға ұмтыласыз.
Dialogue: 0,0:16:21.85,0:16:23.06,Default,,0,0,0,,Батыр бол
Dialogue: 0,0:16:23.14,0:16:26.40,Default,,0,0,0,,Күшті болып, үстірт қоғамды басқар
Dialogue: 0,0:16:26.48,0:16:27.77,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:16:29.48,0:16:31.24,Default,,0,0,0,,Өйткені, сіз...
Dialogue: 0,0:16:32.07,0:16:33.65,Default,,0,0,0,,Қай жерде жүрсең де жұлдызсың.
Dialogue: 0,0:16:37.32,0:16:38.33,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:39.12,0:16:40.66,Default,,0,0,0,,Мен бас тартамын!
Dialogue: 0,0:16:40.74,0:16:41.66,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:44.62,0:16:45.50,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:16:45.58,0:16:49.71,Default,,0,0,0,,Өз сенімін ақтайтын басқа хайуан жоқ.
Dialogue: 0,0:16:50.84,0:16:53.26,Default,,0,0,0,,Күшті болуға деген сенім
Dialogue: 0,0:16:53.97,0:16:57.76,Default,,0,0,0,,Сізде менде жоқ нәрсе бар.
Dialogue: 0,0:16:58.60,0:17:02.02,Default,,0,0,0,,Бұл дүниеде өте қажет нәрсе
Dialogue: 0,0:17:03.77,0:17:06.44,Default,,0,0,0,,Шөпқоректілердің қадір-қасиеті
Dialogue: 0,0:17:06.52,0:17:08.11,Default,,0,0,0,,Мен сені өлтіремін. Атпа!
Dialogue: 0,0:17:08.94,0:17:10.77,Default,,0,0,0,,Луи-сенпай...
Dialogue: 0,0:17:10.86,0:17:13.24,Default,,0,0,0,,Сіз шынымен де таңданасыз, солай емес пе?
Dialogue: 0,0:17:13.32,0:17:16.11,Default,,0,0,0,,Мен сені кепілге алайын деген ниетім болмаса да.
Dialogue: 0,0:17:16.20,0:17:18.91,Default,,0,0,0,,Айтар сөзің болса, айт.
Dialogue: 0,0:17:18.99,0:17:20.49,Default,,0,0,0,,Ал, қысқаша.
Dialogue: 0,0:17:21.37,0:17:24.91,Default,,0,0,0,,Драма үйірмесінде болған кісі өлтіру оқиғасының кінәсі. Мен түссіндім.
Dialogue: 0,0:17:25.00,0:17:26.17,Default,,0,0,0,,Не?
Dialogue: 0,0:17:26.87,0:17:28.54,Default,,0,0,0,,Мен де оны ұстау үшін.
Dialogue: 0,0:17:28.63,0:17:30.63,Default,,0,0,0,,Мен қазір көп нәрсені істеп жатырмын.
Dialogue: 0,0:17:30.71,0:17:35.09,Default,,0,0,0,,Енді... сен мектепке қазір керексің.
Dialogue: 0,0:17:35.17,0:17:38.05,Default,,0,0,0,,Сенің күшің – тектілігің
Dialogue: 0,0:17:38.14,0:17:40.05,Default,,0,0,0,,Маған керек
Dialogue: 0,0:17:40.14,0:17:41.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:43.72,0:17:46.19,Default,,0,0,0,,Қап, мен секірдім.
Dialogue: 0,0:17:46.27,0:17:48.06,Default,,0,0,0,,(Шишигумидің ізі)
Dialogue: 0,0:17:48.98,0:17:49.98,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:59.57,0:18:01.41,Default,,0,0,0,,Барлығына...
Dialogue: 0,0:18:01.49,0:18:05.04,Default,,0,0,0,,Луи-сенпай туралы ештеңе айтпағаным дұрыс шығар.
Dialogue: 0,0:18:06.16,0:18:08.29,Default,,0,0,0,,Барлығы, тыңдаңдар (бәрі) Иә?
Dialogue: 0,0:18:08.87,0:18:11.59,Default,,0,0,0,,Тарының саусақтары енді қозғала алады
Dialogue: 0,0:18:11.67,0:18:13.80,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:13.88,0:18:16.01,Default,,0,0,0,,Легоши-кун маған қонаққа келгенде
Dialogue: 0,0:18:16.09,0:18:17.76,Default,,0,0,0,,Ол әлі қозғалған жоқ, солай ма?
Dialogue: 0,0:18:17.84,0:18:21.26,Default,,0,0,0,,Иә, Кибидің тынымсыз еңбегі өз жемісін берді.
Dialogue: 0,0:18:22.30,0:18:24.47,Default,,0,0,0,,Мүмкін мен де сізге баруым керек.
Dialogue: 0,0:18:24.56,0:18:27.10,Default,,0,0,0,,Иә, сенің бақытты болатыныңа сенімдімін.
Dialogue: 0,0:18:27.18,0:18:30.60,Default,,0,0,0,,«Мүмкін мен сізге баруым керек.»
Dialogue: 0,0:18:30.69,0:18:34.94,Default,,0,0,0,,Сіз қалайша қалыпты әрекет ете аласыз?
Dialogue: 0,0:18:35.03,0:18:40.41,Default,,0,0,0,,Бірде досын жеген адам қалай ештеңе болмағандай әрекет ете алады?
Dialogue: 0,0:18:41.24,0:18:45.62,Default,,0,0,0,,Бірақ Тао мектептен шеттетілді...
Dialogue: 0,0:18:45.70,0:18:49.41,Default,,0,0,0,,Басқа жолы бар ма деп ойлаймын.
Dialogue: 0,0:18:49.50,0:18:50.62,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:18:50.71,0:18:51.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:51.71,0:18:55.59,Default,,0,0,0,,Бұл әдейі болмаса да, Тао Кибиге зиянын тигізді.
Dialogue: 0,0:18:55.67,0:18:56.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:56.59,0:19:01.26,Default,,0,0,0,,Шөпқоректі жануарларды күтуге салғырт қараудың күнәсі үлкен.
Dialogue: 0,0:19:01.34,0:19:03.43,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:19:03.51,0:19:07.85,Default,,0,0,0,,Тимді жеген жігіт не деді!
Dialogue: 0,0:19:07.93,0:19:09.27,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:09.77,0:19:11.06,Default,,0,0,0,,Сіз өзіңізбен сөйлесесіз бе?
Dialogue: 0,0:19:11.15,0:19:12.65,Default,,0,0,0,,Легоши?
Dialogue: 0,0:19:14.06,0:19:15.98,Default,,0,0,0,,Айтшы, Лиз.
Dialogue: 0,0:19:17.36,0:19:19.32,Default,,0,0,0,,Даоның күнәсі қанша?
Dialogue: 0,0:19:19.40,0:19:20.90,Default,,0,0,0,,Тоқта, Легоши.
Dialogue: 0,0:19:20.99,0:19:23.41,Default,,0,0,0,,Тоқта, барлығы қарап тұр.
Dialogue: 0,0:19:23.49,0:19:27.16,Default,,0,0,0,,Маған бәрібір, ыңғайсыз сенсің.
Dialogue: 0,0:19:27.24,0:19:31.25,Default,,0,0,0,,Эмоционалды бақылау – жыртқыштардың негізі
Dialogue: 0,0:19:31.33,0:19:32.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:32.46,0:19:35.88,Default,,0,0,0,,Сенің жаның менен төмен.
Dialogue: 0,0:19:38.84,0:19:42.13,Default,,0,0,0,,(Легошидің ырылдауы)
Dialogue: 0,0:19:42.22,0:19:45.39,Default,,0,0,0,,Жарайды, ауырады, ауырады
Dialogue: 0,0:19:45.47,0:19:47.39,Default,,0,0,0,,Бұл қорқынышты~
Dialogue: 0,0:19:48.97,0:19:51.89,Default,,0,0,0,,Мен жабдықтың дауысын көрсетуге тырыстым.
Dialogue: 0,0:19:53.19,0:19:57.02,Default,,0,0,0,,Мықты болшы, Легоши-сенпай.
Dialogue: 0,0:19:57.11,0:20:00.11,Default,,0,0,0,,Сіз зиянды одан әрі тарата алмайсыз.
Dialogue: 0,0:20:00.19,0:20:01.99,Default,,0,0,0,,Пина-кун...
Dialogue: 0,0:20:02.07,0:20:04.41,Default,,0,0,0,,Дұрыс? Лиз-сенпай
Dialogue: 0,0:20:07.33,0:20:08.41,Default,,0,0,0,,Өтінемін…
Dialogue: 0,0:20:08.99,0:20:10.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:10.08,0:20:11.00,Default,,0,0,0,,Иә
Dialogue: 0,0:20:11.08,0:20:11.91,Default,,0,0,0,,...және?
Dialogue: 0,0:20:12.00,0:20:13.21,Default,,0,0,0,,Мен сізге өтемақы төлеймін.
Dialogue: 0,0:20:13.29,0:20:14.92,Default,,0,0,0,,Иә, айттым.
Dialogue: 0,0:20:15.00,0:20:17.25,Default,,0,0,0,,Шешімі ~
Dialogue: 0,0:20:17.34,0:20:19.50,Default,,0,0,0,,Барлығымыз қазір жаттығу жасайық.
Dialogue: 0,0:20:20.80,0:20:22.63,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:20:22.72,0:20:24.97,Default,,0,0,0,,(мүшелердің сөйлейтін дыбыстары)
Dialogue: 0,0:20:26.39,0:20:27.26,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:20:28.06,0:20:30.64,Default,,0,0,0,,Сіз қалайша сабырлы бола аласыз?
Dialogue: 0,0:20:31.31,0:20:33.19,Default,,0,0,0,,Ол тіпті достарын жеді
Dialogue: 0,0:20:35.15,0:20:40.44,Default,,0,0,0,,Бұрын ол екеуміздің арамызда қалың қабырға болатын...
Dialogue: 0,0:20:40.53,0:20:42.65,Default,,0,0,0,,Мен үлкен айырмашылықты сезіндім
Dialogue: 0,0:20:42.74,0:20:46.16,Default,,0,0,0,,А... қыз бен қыз емес сияқты ма?
Dialogue: 0,0:20:46.24,0:20:47.91,Default,,0,0,0,,Бұл – жеңіске арналған тұрып қошемет!
Dialogue: 0,0:20:47.99,0:20:51.87,Default,,0,0,0,,Аа... Бірақ сіз менің ізбасарларыма сене аласыз.
Dialogue: 0,0:20:51.95,0:20:53.79,Default,,0,0,0,,Шынымды айтсам, маған үзіліс беріңізші.
Dialogue: 0,0:20:53.87,0:20:56.21,Default,,0,0,0,,Кешіріңіз, кешіріңіз, шынымен...
Dialogue: 0,0:20:56.29,0:20:59.25,Default,,0,0,0,,Сенің ашуланғаныңды түсінуге болады.
Dialogue: 0,0:21:00.34,0:21:04.51,Default,,0,0,0,,Лиз «жақсы аю» рөлін ойнауға дағдыланған шығар.
Dialogue: 0,0:21:04.59,0:21:07.18,Default,,0,0,0,,Бір мағынада сіз жыртқышқа мүлдем қарама-қайшысыз.
Dialogue: 0,0:21:08.43,0:21:09.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:10.14,0:21:14.18,Default,,0,0,0,,Бірақ бұл сізге жақсы емес пе?
Dialogue: 0,0:21:17.15,0:21:20.77,Default,,0,0,0,,(Лиздің күрсінуі)
Dialogue: 0,0:21:22.03,0:21:26.41,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:21:32.04,0:21:38.04,Default,,0,0,0,,♪～
Dialogue: 0,0:22:52.32,0:22:58.33,Default,,0,0,0,,～♪
Dialogue: 0,0:22:59.83,0:23:05.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory