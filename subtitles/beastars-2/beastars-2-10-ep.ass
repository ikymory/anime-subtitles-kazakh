Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.09,0:00:18.10,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.92,0:01:39.18,Default,,0,0,0,,～♪
Dialogue: 0,0:01:46.85,0:01:49.44,Default,,0,0,0,,Жаз қызанақ үшін ең жақсы маусым болып саналады, бірақ
Dialogue: 0,0:01:50.10,0:01:53.61,Default,,0,0,0,,Негізі күзден қыстың басына дейін ең дәмді.
Dialogue: 0,0:01:58.11,0:01:58.99,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:59.07,0:02:00.70,Default,,0,0,0,,Иә? (Аю В) Не?
Dialogue: 0,0:02:00.78,0:02:02.66,Default,,0,0,0,,Бұл біраз уақыт алуы мүмкін
Dialogue: 0,0:02:02.74,0:02:03.99,Default,,0,0,0,,А... мен күтемін.
Dialogue: 0,0:02:04.08,0:02:05.37,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:02:05.45,0:02:07.12,Default,,0,0,0,,Эххе
Dialogue: 0,0:02:07.21,0:02:09.04,Default,,0,0,0,,Маған тамақ пісірген ұнайды
Dialogue: 0,0:02:10.00,0:02:11.71,Default,,0,0,0,,Осылайша, кейде менің бөлмедегі достарым
Dialogue: 0,0:02:11.79,0:02:13.75,Default,,0,0,0,,Тамақты ұсыну
Dialogue: 0,0:02:13.84,0:02:17.67,Default,,0,0,0,,Мен тамақ жасағанда өзімді тыныш сезінемін.
Dialogue: 0,0:02:24.06,0:02:25.64,Default,,0,0,0,,Иә, ләззат алыңыз.
Dialogue: 0,0:02:25.72,0:02:29.06,Default,,0,0,0,,Ооо, итадагымасу
Dialogue: 0,0:02:30.48,0:02:33.94,Default,,0,0,0,,Лиздің тамағы дәмді ғой, хаха
Dialogue: 0,0:02:34.02,0:02:38.19,Default,,0,0,0,,Бірақ ол әрқашан дәмді, иә?
Dialogue: 0,0:02:38.28,0:02:40.45,Default,,0,0,0,,А... Мен тағы да жасадым.
Dialogue: 0,0:02:41.16,0:02:42.66,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:02:43.74,0:02:45.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:45.70,0:02:49.62,Default,,0,0,0,,Сол түннен бері дәм сезуден айырылдым.
Dialogue: 0,0:02:50.67,0:02:54.34,Default,,0,0,0,,Мен келісіммен альпака темесін жедім.
Dialogue: 0,0:02:55.17,0:02:58.76,Default,,0,0,0,,Шөпқоректі жануармен шынайы достық орнатқан жалғыз аю.
Dialogue: 0,0:03:04.30,0:03:08.60,Default,,0,0,0,,Ингредиенттер маған берілгендей...
Dialogue: 0,0:03:08.68,0:03:11.44,Default,,0,0,0,,Бейбітшілікте бірге балқыған
Dialogue: 0,0:03:12.40,0:03:14.36,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:03:14.44,0:03:17.48,Default,,0,0,0,,Әдемі болып, естеліктерім
Dialogue: 0,0:03:18.15,0:03:20.19,Default,,0,0,0,,Темнің дәмін ұмытпа
Dialogue: 0,0:03:20.28,0:03:22.86,Default,,0,0,0,,Біз ең жақсы достармыз
Dialogue: 0,0:03:22.95,0:03:25.24,Default,,0,0,0,,Теммен болған түннен естелік
Dialogue: 0,0:03:25.33,0:03:27.12,Default,,0,0,0,,Өйткені әдемі қайта тірілесің
Dialogue: 0,0:03:27.20,0:03:30.83,Default,,0,0,0,,Мен сен туралы бәрін қабылдаймын, Лиз.
Dialogue: 0,0:03:39.21,0:03:41.84,Default,,0,0,0,,Ас – өмірдің қуанышы.
Dialogue: 0,0:03:42.38,0:03:45.43,Default,,0,0,0,,Тем Менің аузыма кіргенде
Dialogue: 0,0:03:45.51,0:03:46.97,Default,,0,0,0,,Сіз күлдіңіз ғой, солай ма?
Dialogue: 0,0:03:47.06,0:03:47.89,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:49.52,0:03:53.19,Default,,0,0,0,,Сол күні Темді жеген сен едің ғой?
Dialogue: 0,0:03:53.27,0:03:58.23,Default,,0,0,0,,Мен өмір сүргенше, мен «жеу мен өлтірудің» алдын аламын.
Dialogue: 0,0:03:58.32,0:04:01.19,Default,,0,0,0,,Мен де Темнің үлесін жоямын.
Dialogue: 0,0:04:01.28,0:04:02.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:03.45,0:04:06.57,Default,,0,0,0,,Әшкерелеген... ол
Dialogue: 0,0:04:06.66,0:04:08.03,Default,,0,0,0,,ластанған
Dialogue: 0,0:04:08.12,0:04:12.46,Default,,0,0,0,,Тем екеуміздің достық, жастық шағым...
Dialogue: 0,0:04:13.12,0:04:15.00,Default,,0,0,0,,Дыбысты өшіру керек
Dialogue: 0,0:04:15.08,0:04:17.92,Default,,0,0,0,,Әлгі тітіркендіргіш қой мен азғын қасқыр
Dialogue: 0,0:04:21.05,0:04:23.01,Default,,0,0,0,,Не болды, Рюзаки?
Dialogue: 0,0:04:23.76,0:04:25.80,Default,,0,0,0,,Мен Луи-сенпайды да кездестірдім.
Dialogue: 0,0:04:25.89,0:04:29.72,Default,,0,0,0,,Маған Лизмен қалай әрекет ету керектігін ойлайтын кез келді.
Dialogue: 0,0:04:29.81,0:04:34.60,Default,,0,0,0,,Кеше түнде мен Хару-чан туралы жаман түс көрдім.
Dialogue: 0,0:04:34.69,0:04:36.98,Default,,0,0,0,,Түптеп келгенде, ол тілекке толы
Dialogue: 0,0:04:37.69,0:04:39.36,Default,,0,0,0,,Бұл бірінші рет емес.
Dialogue: 0,0:04:39.44,0:04:42.11,Default,,0,0,0,,Жағдайлар мен түрлері көбейіп бара жатқандай сезінемін.
Dialogue: 0,0:04:42.19,0:04:45.11,Default,,0,0,0,,Хмм... бұл өте графикалық.
Dialogue: 0,0:04:45.20,0:04:48.03,Default,,0,0,0,,Қалау массасы!
Dialogue: 0,0:04:48.74,0:04:50.08,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:04:50.16,0:04:53.16,Default,,0,0,0,,Менің басым қайда жасалған?
Dialogue: 0,0:04:53.25,0:04:56.04,Default,,0,0,0,,Денемнің еш жерінде жоқ
Dialogue: 0,0:04:56.12,0:04:58.17,Default,,0,0,0,,Жұмсақ...
Dialogue: 0,0:04:58.25,0:04:59.29,Default,,0,0,0,,Rohan-нан басқа тағы бірнеше адамға айтқансың—
Dialogue: 0,0:04:59.38,0:05:00.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:00.38,0:05:02.17,Default,,0,0,0,,Қолдарың тентек, Легоси-кун.
Dialogue: 0,0:05:02.26,0:05:04.09,Default,,0,0,0,,Уау, бұл шын ба?
Dialogue: 0,0:05:04.80,0:05:06.34,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:05:06.43,0:05:09.14,Default,,0,0,0,,А... бұл сирек... бұл сирек 2-сынып кабинеті
Dialogue: 0,0:05:09.22,0:05:11.06,Default,,0,0,0,,Хехехе, осында.
Dialogue: 0,0:05:11.14,0:05:13.06,Default,,0,0,0,,Сабақ аяқталды, солай ма?
Dialogue: 0,0:05:13.14,0:05:14.93,Default,,0,0,0,,Мен де сенің жүзіңді көргім келді
Dialogue: 0,0:05:15.02,0:05:16.94,Default,,0,0,0,,Мен дұрыс сөйлескім келді.
Dialogue: 0,0:05:17.02,0:05:18.40,Default,,0,0,0,,Осыдан кейін боссың ба?
Dialogue: 0,0:05:18.90,0:05:20.02,Default,,0,0,0,,Иә
Dialogue: 0,0:05:20.11,0:05:21.86,Default,,0,0,0,,Эй... сәл қозғалайық.
Dialogue: 0,0:05:21.94,0:05:22.78,Default,,0,0,0,,Иә
Dialogue: 0,0:05:25.82,0:05:27.24,Default,,0,0,0,,Иә
Dialogue: 0,0:05:27.32,0:05:28.61,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:30.58,0:05:34.95,Default,,0,0,0,,Сен, Легоши, өзіңе ант бересің бе?
Dialogue: 0,0:05:35.04,0:05:36.50,Default,,0,0,0,,Өте мейірімді
Dialogue: 0,0:05:36.58,0:05:39.46,Default,,0,0,0,,Хару-чан, сабақта көңілді жүрсің бе?
Dialogue: 0,0:05:39.54,0:05:42.09,Default,,0,0,0,,Хмм, ерекше ештеңе жоқ па? Қалыпты
Dialogue: 0,0:05:42.17,0:05:43.88,Default,,0,0,0,,Менен кіші болсаң да
Dialogue: 0,0:05:43.96,0:05:47.30,Default,,0,0,0,,Біртүрлі, өйткені сен кейде әкеңе ұқсайсың.
Dialogue: 0,0:05:48.59,0:05:51.18,Default,,0,0,0,,Луи мүлде қарама-қарсы және бұзылған брат болды.
Dialogue: 0,0:05:52.43,0:05:56.56,Default,,0,0,0,,Тұрақсыз болса да, ол да күшті, арамза...
Dialogue: 0,0:05:56.64,0:05:59.15,Default,,0,0,0,,Ол әрқашан жалғыз болып көрінетін
Dialogue: 0,0:05:59.73,0:06:01.81,Default,,0,0,0,,Бүгін ауа-райы жақсы.
Dialogue: 0,0:06:03.02,0:06:04.19,Default,,0,0,0,,Легоси-кун, иә?
Dialogue: 0,0:06:04.86,0:06:06.36,Default,,0,0,0,,А... Маған ұнады
Dialogue: 0,0:06:06.44,0:06:07.86,Default,,0,0,0,,Не? Мен оны жақсы көремін
Dialogue: 0,0:06:07.95,0:06:10.49,Default,,0,0,0,,А-а, өтірік... Шынымен бе?
Dialogue: 0,0:06:10.57,0:06:11.53,Default,,0,0,0,,Иә
Dialogue: 0,0:06:11.62,0:06:14.29,Default,,0,0,0,,Маған бұл туралы бірінші рет дұрыс айтылғандай сезінемін.
Dialogue: 0,0:06:14.37,0:06:15.87,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:06:15.95,0:06:21.75,Default,,0,0,0,,Күшті, жұмсақ, үлкен және сенімді
Dialogue: 0,0:06:22.59,0:06:23.71,Default,,0,0,0,,Оны түсініп-ақ болмайды.
Dialogue: 0,0:06:24.30,0:06:26.92,Default,,0,0,0,,Легоши маған қаншалықты ұнаса, соғұрлым оны ұнатамын.
Dialogue: 0,0:06:27.47,0:06:28.88,Default,,0,0,0,,Мен Луи үшін алаңдаймын.
Dialogue: 0,0:06:30.47,0:06:32.05,Default,,0,0,0,,А... Ха!
Dialogue: 0,0:06:32.14,0:06:35.06,Default,,0,0,0,,А... Мен оны дәл қазір біртүрлі етіп айтқан шығармын.
Dialogue: 0,0:06:35.14,0:06:36.10,Default,,0,0,0,,О... жоқ.
Dialogue: 0,0:06:36.18,0:06:37.98,Default,,0,0,0,,Бұл менің өкінгенім емес.
Dialogue: 0,0:06:38.06,0:06:39.94,Default,,0,0,0,,Ах, Легоси-кун, мені тыңда.
Dialogue: 0,0:06:40.02,0:06:42.11,Default,,0,0,0,,А... мен және Луис бітті.
Dialogue: 0,0:06:42.19,0:06:44.07,Default,,0,0,0,,Бұл махаббат емес
Dialogue: 0,0:06:45.07,0:06:48.03,Default,,0,0,0,,Бірақ мен уайымдадым.
Dialogue: 0,0:06:48.57,0:06:51.61,Default,,0,0,0,,Жауап жоқ, телефон қоңыраулары жоқ
Dialogue: 0,0:06:55.58,0:07:00.79,Default,,0,0,0,,Шөпқоректілер мен жыртқыштар арасында байланыс жоғалуының ауырлығы мүлде басқаша.
Dialogue: 0,0:07:01.67,0:07:05.21,Default,,0,0,0,,Мүмкін сізге қауіп төніп тұрған шығар.
Dialogue: 0,0:07:05.29,0:07:06.84,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:07:06.92,0:07:08.26,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:07:08.34,0:07:09.38,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:07:09.47,0:07:10.51,Default,,0,0,0,,Бұл көңілсіз...
Dialogue: 0,0:07:10.59,0:07:16.10,Default,,0,0,0,,Мен... мен сені құшақтағым келеді... Оны қайтарғым келеді.
Dialogue: 0,0:07:17.56,0:07:20.18,Default,,0,0,0,,Түсімде мен сені бар күшіммен құшақтаймын
Dialogue: 0,0:07:20.18,0:07:23.35,Default,,0,0,0,,Түсімде мен сені бар күшіммен құшақтаймын
Dialogue: 0,0:07:20.18,0:07:23.35,Default,,0,0,0,,(Харудың айқайы)
Dialogue: 0,0:07:23.35,0:07:23.44,Default,,0,0,0,,(Харудың айқайы)
Dialogue: 0,0:07:23.44,0:07:25.82,Default,,0,0,0,,(Харудың айқайы)
Dialogue: 0,0:07:23.44,0:07:25.82,Default,,0,0,0,,Сіз мен қалағандай...
Dialogue: 0,0:07:25.90,0:07:27.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:27.98,0:07:29.36,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:07:30.15,0:07:30.99,Default,,0,0,0,,Бұл кішкентай.
Dialogue: 0,0:07:31.07,0:07:32.78,Default,,0,0,0,,Бұл дене өлшемі менің өмірімнің кілті.
Dialogue: 0,0:07:32.78,0:07:34.28,Default,,0,0,0,,Бұл дене өлшемі менің өмірімнің кілті.
Dialogue: 0,0:07:32.78,0:07:34.28,Default,,0,0,0,,Жарайды, алдымен осыны оқимын, бітірген соң екіншісін де оқимыз ба?
Dialogue: 0,0:07:34.28,0:07:35.74,Default,,0,0,0,,Бұл дене өлшемі менің өмірімнің кілті.
Dialogue: 0,0:07:36.49,0:07:39.62,Default,,0,0,0,,Саған шабуыл жасаған күннен бастап мен
Dialogue: 0,0:07:39.70,0:07:43.75,Default,,0,0,0,,Мен сіз бен менің арамыздағы физикалық айырмашылықтармен бетпе-бет келемін.
Dialogue: 0,0:07:43.83,0:07:45.08,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:45.17,0:07:47.00,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:07:47.09,0:07:49.05,Default,,0,0,0,,Бір жануардың да бақытсыз болуына жол бермеймін.
Dialogue: 0,0:07:50.30,0:07:52.30,Default,,0,0,0,,Легоши-кун?
Dialogue: 0,0:07:53.13,0:07:55.05,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:07:55.14,0:07:59.85,Default,,0,0,0,,А... Сен несің, біртүрлі бала?
Dialogue: 0,0:08:02.64,0:08:07.15,Default,,0,0,0,,Мен бәрін өз қолыммен шешемін, сосын сені құшақтаймын
Dialogue: 0,0:08:12.78,0:08:16.07,Default,,0,0,0,,Бүгінгі бұрышта бір нәрсенің иісі шығып тұр.
Dialogue: 0,0:08:16.78,0:08:19.12,Default,,0,0,0,,Бал қосылған балауыз
Dialogue: 0,0:08:19.20,0:08:20.20,Default,,0,0,0,,Жылтыр береді.
Dialogue: 0,0:08:20.29,0:08:21.95,Default,,0,0,0,,А...
Dialogue: 0,0:08:22.04,0:08:23.87,Default,,0,0,0,,Маған бұл өте ұнайды
Dialogue: 0,0:08:23.96,0:08:25.33,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:25.42,0:08:27.71,Default,,0,0,0,,Пина-кун, сен драма үйірмесіне қатысасың, солай ма?
Dialogue: 0,0:08:27.79,0:08:28.84,Default,,0,0,0,,Бұл көңілді ме?
Dialogue: 0,0:08:28.92,0:08:31.84,Default,,0,0,0,,Жыл басындағы қойылымда маған үлкен рөл берілді.
Dialogue: 0,0:08:31.92,0:08:34.18,Default,,0,0,0,,Хмм... мені көруге келе аласыз ба?
Dialogue: 0,0:08:34.26,0:08:36.72,Default,,0,0,0,,Го Го қандай рөл атқарады?
Dialogue: 0,0:08:36.80,0:08:41.31,Default,,0,0,0,,Жанын Қасқыр алған сұлу баланың рөлі
Dialogue: 0,0:08:41.39,0:08:43.64,Default,,0,0,0,,Өйткені мен ақырында өлемін
Dialogue: 0,0:08:43.73,0:08:45.14,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:08:45.23,0:08:48.02,Default,,0,0,0,,Иә, сен өлесің.
Dialogue: 0,0:08:49.23,0:08:51.32,Default,,0,0,0,,Арыстан-чан... иә?
Dialogue: 0,0:08:51.40,0:08:54.99,Default,,0,0,0,,Мен шынымен өлсем, сен қайғырасың ба?
Dialogue: 0,0:08:55.07,0:08:56.32,Default,,0,0,0,,Ой… бұл қорқынышты!
Dialogue: 0,0:08:56.41,0:08:59.41,Default,,0,0,0,,Мен күлетін шығармын
Dialogue: 0,0:08:59.49,0:09:02.08,Default,,0,0,0,,Риона деген кім?
Dialogue: 0,0:09:02.16,0:09:03.37,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:03.45,0:09:04.87,Default,,0,0,0,,Жарайды... у...
Dialogue: 0,0:09:04.96,0:09:07.75,Default,,0,0,0,,Әйелдің аты араласып кетеді, сенің жаназаң ше?
Dialogue: 0,0:09:07.83,0:09:08.92,Default,,0,0,0,,Ешкім келмейді, солай ма?
Dialogue: 0,0:09:09.00,0:09:10.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:12.17,0:09:13.55,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:09:13.63,0:09:15.88,Default,,0,0,0,,Мен мұны қайтадан жасадым
Dialogue: 0,0:09:16.55,0:09:20.35,Default,,0,0,0,,Қыздар сөздерімен мені өлтірмекші болады.
Dialogue: 0,0:09:21.72,0:09:24.02,Default,,0,0,0,,Мықты бол, мен.
Dialogue: 0,0:09:24.10,0:09:26.60,Default,,0,0,0,,Мен соңғы кездері ессіз әрекет жасап жүрмін.
Dialogue: 0,0:09:26.69,0:09:30.61,Default,,0,0,0,,Бірақ соңында әдемі өлетін рөл?
Dialogue: 0,0:09:30.69,0:09:33.44,Default,,0,0,0,,Қазір мен үшін тамаша емес пе?
Dialogue: 0,0:09:33.53,0:09:34.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:38.78,0:09:44.33,Default,,0,0,0,,Мен бүгінгі жаттығуды асыға күтемін, Пина-кун.
Dialogue: 0,0:09:46.79,0:09:48.96,Default,,0,0,0,,Ах... хаха
Dialogue: 0,0:09:49.04,0:09:51.21,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:09:51.29,0:09:54.17,Default,,0,0,0,,Кісі өлтірушілер де дәретханаға барады ма?
Dialogue: 0,0:09:54.26,0:09:55.09,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:09:55.17,0:09:56.42,Default,,0,0,0,,Ура!
Dialogue: 0,0:09:56.51,0:09:57.63,Default,,0,0,0,,Ах
Dialogue: 0,0:09:58.80,0:10:00.01,Default,,0,0,0,,Легоши-кунға
Dialogue: 0,0:10:00.09,0:10:03.47,Default,,0,0,0,,Маған енді араласпауымды айта аласыз ба?
Dialogue: 0,0:10:04.39,0:10:05.85,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:05.93,0:10:08.48,Default,,0,0,0,,Балалар, мені жалғыз қалдырсаңдаршы
Dialogue: 0,0:10:08.56,0:10:12.52,Default,,0,0,0,,Уақытымды жүрегімдегі Тем туралы естеліктермен тыныш өткізе аламын.
Dialogue: 0,0:10:13.32,0:10:17.90,Default,,0,0,0,,Бірақ егер сіз менің Теммен достығымды бұзсаңыз.
Dialogue: 0,0:10:17.99,0:10:20.74,Default,,0,0,0,,Мен Легоси-кунның аузын жауып тастаймын.
Dialogue: 0,0:10:20.82,0:10:23.74,Default,,0,0,0,,Мен де сені жеуім мүмкін.
Dialogue: 0,0:10:24.45,0:10:26.87,Default,,0,0,0,,Басынан
Dialogue: 0,0:10:27.46,0:10:28.37,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:28.46,0:10:31.25,Default,,0,0,0,,Олай істеуді тоқтатқан дұрыс емес пе?
Dialogue: 0,0:10:31.33,0:10:34.46,Default,,0,0,0,,Бұл бұрыштың ыңғайсыздық тудыратыны анық және дәмі жақсы емес...
Dialogue: 0,0:10:34.55,0:10:35.38,Default,,0,0,0,,Уф
Dialogue: 0,0:10:35.46,0:10:37.42,Default,,0,0,0,,А... аа...
Dialogue: 0,0:10:37.51,0:10:41.43,Default,,0,0,0,,Жоқ, жоқ... а...
Dialogue: 0,0:10:47.68,0:10:52.65,Default,,0,0,0,,(сорғыш саусақтардың дыбысы)
Dialogue: 0,0:10:54.40,0:10:56.82,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:10:57.69,0:11:01.82,Default,,0,0,0,,Саусақтарымнан жақсы иіс шыққаны сонша, мен...
Dialogue: 0,0:11:01.91,0:11:02.99,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:03.91,0:11:04.87,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:11:04.95,0:11:07.04,Default,,0,0,0,,Ха… га…
Dialogue: 0,0:11:07.12,0:11:08.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:09.75,0:11:13.04,Default,,0,0,0,,Саусақтар… Бар…
Dialogue: 0,0:11:14.59,0:11:16.30,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:16.38,0:11:17.51,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:11:18.71,0:11:22.76,Default,,0,0,0,,Жуынатын бөлменің еденінде босаңсып, жеңілдеп қалдым...
Dialogue: 0,0:11:23.64,0:11:27.72,Default,,0,0,0,,Мен өмір сүргім келеді.
Dialogue: 0,0:11:30.10,0:11:32.31,Default,,0,0,0,,«Мен бүгін түнде-»
Dialogue: 0,0:11:32.40,0:11:36.77,Default,,0,0,0,,«Адлер, сенің жаныңды аулауға келген өлім құдайы»
Dialogue: 0,0:11:36.86,0:11:39.99,Default,,0,0,0,,«Егер айтатын соңғы сөздер болса»
Dialogue: 0,0:11:40.07,0:11:43.16,Default,,0,0,0,,«Мен оны осы ораққа саламын»
Dialogue: 0,0:11:43.24,0:11:46.08,Default,,0,0,0,,Менде сүйкімді нәрсе бар.
Dialogue: 0,0:11:46.16,0:11:48.04,Default,,0,0,0,,Бір нәрсе жақсырақ сезіледі.
Dialogue: 0,0:11:49.29,0:11:50.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:57.59,0:11:59.96,Default,,0,0,0,,«Егер сен өміріңді сұрасаң»
Dialogue: 0,0:12:00.05,0:12:02.84,Default,,0,0,0,,«Сендер өлім құдайлары ризасыңдар ма?»
Dialogue: 0,0:12:02.93,0:12:04.26,Default,,0,0,0,,«Не?»
Dialogue: 0,0:12:05.22,0:12:08.43,Default,,0,0,0,,«Менің өмірім түкке тұрғысыз».
Dialogue: 0,0:12:08.51,0:12:10.81,Default,,0,0,0,,«Бірақ бұл тек менікі».
Dialogue: 0,0:12:10.89,0:12:13.77,Default,,0,0,0,,Жарайды, жарайды, сценарий есімде.
Dialogue: 0,0:12:14.90,0:12:19.23,Default,,0,0,0,,«Менің өлімнен қорқу тек менікі».
Dialogue: 0,0:12:19.32,0:12:20.57,Default,,0,0,0,,О...
Dialogue: 0,0:12:21.65,0:12:23.61,Default,,0,0,0,,«Өсиет емес»
Dialogue: 0,0:12:23.70,0:12:26.53,Default,,0,0,0,,«Егер бұл сенің жүрегіңнің айқайы болса, оны тыңдауға рұқсат ет».
Dialogue: 0,0:12:27.45,0:12:29.16,Default,,0,0,0,,«Мені өлтір!»
Dialogue: 0,0:12:29.24,0:12:31.87,Default,,0,0,0,,«Мен сенен қорықпаймын».
Dialogue: 0,0:12:33.58,0:12:35.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:35.79,0:12:37.54,Default,,0,0,0,,Ой, уау, жақсысың ба?
Dialogue: 0,0:12:37.63,0:12:39.42,Default,,0,0,0,,А...біреу маған шүберек әкелсін.
Dialogue: 0,0:12:39.50,0:12:41.59,Default,,0,0,0,,Кешіріңіз, жаттығуды әзірге тоқтату керек.
Dialogue: 0,0:12:41.59,0:12:41.96,Default,,0,0,0,,Кешіріңіз, жаттығуды әзірге тоқтату керек.
Dialogue: 0,0:12:41.59,0:12:41.96,Default,,0,0,0,,А, мен шүберек әкелемін.
Dialogue: 0,0:12:41.96,0:12:42.47,Default,,0,0,0,,А, мен саған шүберек әкелемін.
Dialogue: 0,0:12:42.47,0:12:42.72,Default,,0,0,0,,А, мен саған шүберек әкелемін.
Dialogue: 0,0:12:42.47,0:12:42.72,Default,,0,0,0,,Пина-кун, не болды?
Dialogue: 0,0:12:42.72,0:12:42.80,Default,,0,0,0,,Пина-кун, не болды?
Dialogue: 0,0:12:42.80,0:12:44.43,Default,,0,0,0,,Пина-кун, не болды?
Dialogue: 0,0:12:42.80,0:12:44.43,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:44.43,0:12:45.38,Default,,0,0,0,,Пина-кун, не болды?
Dialogue: 0,0:12:45.47,0:12:49.01,Default,,0,0,0,,Аа... не? Ха
Dialogue: 0,0:12:57.06,0:12:58.73,Default,,0,0,0,,Сіз оны дұрыс көрдіңіз бе?
Dialogue: 0,0:12:58.81,0:13:02.74,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:13:02.82,0:13:07.70,Default,,0,0,0,,Иә, айтар ештеңе қалмаған сияқты.
Dialogue: 0,0:13:09.99,0:13:10.95,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:13:12.50,0:13:16.46,Default,,0,0,0,,Тегін, бүгіннен бастап мылтықты ала аласыз.
Dialogue: 0,0:13:16.54,0:13:18.04,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:13:18.13,0:13:20.54,Default,,0,0,0,,Тек мені атып таста.
Dialogue: 0,0:13:20.63,0:13:25.17,Default,,0,0,0,,Мен жынды болып, бастықты жей жаздаймын
Dialogue: 0,0:13:25.26,0:13:29.01,Default,,0,0,0,,Бастық екеуміз жай ғана арыстан мен киік болып кеткенімізде
Dialogue: 0,0:13:29.09,0:13:31.60,Default,,0,0,0,,Мені атып тастаудан тартынба.
Dialogue: 0,0:13:31.68,0:13:33.31,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:34.18,0:13:37.14,Default,,0,0,0,,Түсіндім... хехехе
Dialogue: 0,0:13:37.23,0:13:40.77,Default,,0,0,0,,Жұмыс орнында нағыз шиеленіс бар.
Dialogue: 0,0:13:40.86,0:13:43.57,Default,,0,0,0,,Біз бір-біріміз сияқты дайын емеспіз.
Dialogue: 0,0:13:44.57,0:13:46.24,Default,,0,0,0,,Жаман емес, солай ма?
Dialogue: 0,0:13:46.82,0:13:51.20,Default,,0,0,0,,Сол бастықтың қасында өмірімізді толықтай өткізейік.
Dialogue: 0,0:13:55.29,0:13:56.46,Default,,0,0,0,,Бұл болды ма? Шш!
Dialogue: 0,0:13:56.54,0:13:57.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:58.62,0:14:02.42,Default,,0,0,0,,Сіз клубтық іс-шараларды өткізіп, «артқы нарыққа» бара жатқанда
Dialogue: 0,0:14:02.50,0:14:06.42,Default,,0,0,0,,Жарайды, мен оны өз жолыммен шештім, уайымдамаңыз.
Dialogue: 0,0:14:06.51,0:14:07.93,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:08.63,0:14:10.22,Default,,0,0,0,,Ол қауіпті.
Dialogue: 0,0:14:10.30,0:14:12.89,Default,,0,0,0,,Біз біреуге шабуыл жасамас бұрын бірдеңе істеуіміз керек.
Dialogue: 0,0:14:12.97,0:14:15.06,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:14:15.14,0:14:17.23,Default,,0,0,0,,Сондықтан мен стратегияны ойладым.
Dialogue: 0,0:14:17.31,0:14:18.81,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:14:18.89,0:14:20.81,Default,,0,0,0,,Алдаушы тергеу сияқты ма?
Dialogue: 0,0:14:20.90,0:14:21.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:22.02,0:14:24.28,Default,,0,0,0,,Мен дәмді көрінемін, солай емес пе?
Dialogue: 0,0:14:24.36,0:14:27.19,Default,,0,0,0,,Мен Лизді шақырамын, сондықтан Легоси-сенпай...
Dialogue: 0,0:14:27.28,0:14:29.15,Default,,0,0,0,,Уа, ау... Жоқ, жоқ, жоқ.
Dialogue: 0,0:14:29.24,0:14:30.11,Default,,0,0,0,,Тым қауіпті
Dialogue: 0,0:14:30.20,0:14:31.53,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,0:14:31.62,0:14:33.66,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:14:33.74,0:14:34.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:35.08,0:14:37.33,Default,,0,0,0,,Мен оны жазып қойғанмын.
Dialogue: 0,0:14:37.41,0:14:38.58,Default,,0,0,0,,Не!
Dialogue: 0,0:14:40.17,0:14:41.67,Default,,0,0,0,,Бос шашпен жабылған жатақхананың едені
Dialogue: 0,0:14:41.75,0:14:43.67,Default,,0,0,0,,Кілем сияқты. Кешіріңіз.
Dialogue: 0,0:14:43.75,0:14:45.30,Default,,0,0,0,,Лас... о...
Dialogue: 0,0:14:45.38,0:14:46.71,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:46.80,0:14:48.05,Default,,0,0,0,,Сіз қайтып келген жоқсыз ба?
Dialogue: 0,0:14:48.13,0:14:50.05,Default,,0,0,0,,Хаха мен... Мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:14:50.13,0:14:51.89,Default,,0,0,0,,Жоқ, сіз өте асығыссыз.
Dialogue: 0,0:14:51.97,0:14:53.47,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:14:53.55,0:14:55.51,Default,,0,0,0,,Жаңа жыл құтты болсын
Dialogue: 0,0:14:59.52,0:15:01.19,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:01.27,0:15:02.81,Default,,0,0,0,,А-а... Мен оны дер кезінде жасадым.
Dialogue: 0,0:15:04.86,0:15:08.53,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:15:08.61,0:15:10.11,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:15:10.20,0:15:13.24,Default,,0,0,0,,Сіз мені Пина-кунның атын пайдаланып шақыруға қалай батылыңыз бар?
Dialogue: 0,0:15:13.32,0:15:15.87,Default,,0,0,0,,Ол таңқаларлық қорқақ.
Dialogue: 0,0:15:16.45,0:15:20.12,Default,,0,0,0,,Сен мені жеңе аламын деп ойладың ба? Легоши-кун
Dialogue: 0,0:15:20.83,0:15:24.71,Default,,0,0,0,,Уф... Жыртқыш сияқты маған қарап атымды атама.
Dialogue: 0,0:15:24.79,0:15:26.30,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін
Dialogue: 0,0:15:26.38,0:15:28.76,Default,,0,0,0,,Мына сұр қасқыр
Dialogue: 0,0:15:28.84,0:15:31.84,Default,,0,0,0,,Өйткені оның басқа жыртқыштардан айырмашылығы бар.
Dialogue: 0,0:15:31.93,0:15:35.47,Default,,0,0,0,,Сіз мені жақсы білесіз.
Dialogue: 0,0:15:35.55,0:15:40.10,Default,,0,0,0,,Мен сенімен диалогтан гөрі жыртқыштық арқылы байланысқанды жақсы көремін, Легоши-кун.
Dialogue: 0,0:15:40.18,0:15:42.94,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:15:43.02,0:15:44.61,Default,,0,0,0,,Бал...
Dialogue: 0,0:15:44.69,0:15:45.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:45.77,0:15:47.15,Default,,0,0,0,,Тек осы бас ауруы...
Dialogue: 0,0:15:50.24,0:15:52.07,Default,,0,0,0,,Мен аюлар отбасының жағдайын білемін.
Dialogue: 0,0:15:52.15,0:15:53.57,Default,,0,0,0,,Немесе… оны қайтарыңыз.
Dialogue: 0,0:15:53.66,0:15:57.58,Default,,0,0,0,,Жаман бас... бас...
Dialogue: 0,0:15:57.66,0:16:00.04,Default,,0,0,0,,Ол бұзылғалы тұр.
Dialogue: 0,0:16:00.12,0:16:01.87,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:16:01.96,0:16:03.67,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:16:03.75,0:16:08.71,Default,,0,0,0,,Қуатты бақылайтын дәрілердің ауыр жанама әсерлері
Dialogue: 0,0:16:09.34,0:16:10.88,Default,,0,0,0,,Күйзеліс
Dialogue: 0,0:16:11.55,0:16:13.34,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:16:13.43,0:16:15.39,Default,,0,0,0,,Сен маған сол көздеріңмен ұнайсың.
Dialogue: 0,0:16:15.39,0:16:15.84,Default,,0,0,0,,Сен маған сол көздеріңмен ұнайсың.
Dialogue: 0,0:16:15.39,0:16:15.84,Default,,0,0,0,,Ш… Шынында да.
Dialogue: 0,0:16:15.84,0:16:17.14,Default,,0,0,0,,Ш… Шынында да.
Dialogue: 0,0:16:18.89,0:16:22.31,Default,,0,0,0,,Маған барлық аңдарыңды көрсет
Dialogue: 0,0:16:23.31,0:16:25.31,Default,,0,0,0,,Менің шынайы тұлғам қандай?
Dialogue: 0,0:16:26.06,0:16:28.57,Default,,0,0,0,,Мені ешкім қабылдамайды
Dialogue: 0,0:16:34.70,0:16:36.74,Default,,0,0,0,,Хэхехехехе...
Dialogue: 0,0:16:36.82,0:16:39.24,Default,,0,0,0,,Тырнақтар да, тістер де...
Dialogue: 0,0:16:39.33,0:16:42.62,Default,,0,0,0,,Біз шынымен қорқынышты жаратылыстармыз.
Dialogue: 0,0:16:43.50,0:16:45.92,Default,,0,0,0,,Сондықтан мен оны жасыруым керек.
Dialogue: 0,0:16:47.08,0:16:48.88,Default,,0,0,0,,Эй, Легоши-кун
Dialogue: 0,0:16:48.96,0:16:51.51,Default,,0,0,0,,Сіз түсінесіз деп ойламайсыз ба?
Dialogue: 0,0:16:51.59,0:16:52.88,Default,,0,0,0,,Менің жалғыздығым
Dialogue: 0,0:17:00.51,0:17:02.47,Default,,0,0,0,,Уау, көру қиын...
Dialogue: 0,0:17:05.73,0:17:10.02,Default,,0,0,0,,Бұл ас бәрінен бұрын қасиетті іс.
Dialogue: 0,0:17:10.11,0:17:12.78,Default,,0,0,0,,Ешкім байқамайтын жерге
Dialogue: 0,0:17:12.86,0:17:15.49,Default,,0,0,0,,(Легошидің ыңырсыуы)
Dialogue: 0,0:17:23.50,0:17:24.87,Default,,0,0,0,,Хаа... міне.
Dialogue: 0,0:17:24.96,0:17:27.67,Default,,0,0,0,,Бұл сіз қалағаныңызша қан кете аласыз дегенді білдіре ме?
Dialogue: 0,0:17:29.08,0:17:32.17,Default,,0,0,0,,Бір рет тірі ет жейсің
Dialogue: 0,0:17:32.25,0:17:35.22,Default,,0,0,0,,Кінә мен аштықтан өзіне зиян келтіру
Dialogue: 0,0:17:36.09,0:17:38.39,Default,,0,0,0,,Бұл мұңды орта мектеп өмірі.
Dialogue: 0,0:17:39.22,0:17:41.35,Default,,0,0,0,,Жастық шағыңызды өзіңізбен бірге қалпына келтіру
Dialogue: 0,0:17:44.02,0:17:47.90,Default,,0,0,0,,Кел, жастық шағыңның рахатын көр.
Dialogue: 0,0:17:48.44,0:17:50.77,Default,,0,0,0,,Дегенмен, ескі жаралар кесіледі.
Dialogue: 0,0:17:51.40,0:17:52.82,Default,,0,0,0,,Темнің жастығын қайтар!
Dialogue: 0,0:17:52.90,0:17:54.07,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:17:55.36,0:17:57.36,Default,,0,0,0,,Бұл ескі жара емес.
Dialogue: 0,0:17:57.45,0:17:58.16,Default,,0,0,0,,Менің қымбат естеліктерімді ұстама
Dialogue: 0,0:17:58.16,0:17:59.91,Default,,0,0,0,,Менің қымбат естеліктерімді ұстама
Dialogue: 0,0:17:58.16,0:17:59.91,Default,,0,0,0,,Уф Уау Уау
Dialogue: 0,0:17:59.99,0:18:01.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:02.87,0:18:04.50,Default,,0,0,0,,Тек Тем мені қабылдады.
Dialogue: 0,0:18:04.58,0:18:07.75,Default,,0,0,0,,Жоқ! сен тимді жедің
Dialogue: 0,0:18:07.83,0:18:11.13,Default,,0,0,0,,Тем екеуміз нәсілден асып, дос болдық.
Dialogue: 0,0:18:11.21,0:18:13.50,Default,,0,0,0,,Сіз Темді жедіңіз
Dialogue: 0,0:18:13.59,0:18:16.01,Default,,0,0,0,,Жыртқыштық нәсілдік кедергілерді бұзатын жалғыз нәрсе.
Dialogue: 0,0:18:16.09,0:18:17.01,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:17.09,0:18:19.13,Default,,0,0,0,,Нәсілдік кедергілерді кім бұза алады?
Dialogue: 0,0:18:20.05,0:18:21.14,Default,,0,0,0,,Тек махаббат
Dialogue: 0,0:18:23.10,0:18:24.39,Default,,0,0,0,,Махаббат?
Dialogue: 0,0:18:25.35,0:18:27.98,Default,,0,0,0,,Біз үшін ондай нәрсе жоқ.
Dialogue: 0,0:18:28.56,0:18:31.11,Default,,0,0,0,,Жек көрушілік пен жалғыздық
Dialogue: 0,0:18:31.19,0:18:33.57,Default,,0,0,0,,Тырнақтар мен азу тістермен не алуға болады?
Dialogue: 0,0:18:36.99,0:18:39.91,Default,,0,0,0,,Бұлай жалғаса берсе, еден құлап қалады.
Dialogue: 0,0:18:39.99,0:18:42.91,Default,,0,0,0,,Маған көбірек тиюге рұқсат етіңіз
Dialogue: 0,0:18:46.66,0:18:47.91,Default,,0,0,0,,(айнаның сынған дыбысы)
Dialogue: 0,0:18:48.00,0:18:48.83,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:49.92,0:18:52.79,Default,,0,0,0,,Сіз бәрібір шөпқоректілердің жұмсақ етін ғана жейсіз.
Dialogue: 0,0:18:52.88,0:18:54.88,Default,,0,0,0,,Сіз басқа адамды түсінемін деп ойлайсыз, солай ма?
Dialogue: 0,0:18:54.96,0:18:58.38,Default,,0,0,0,,Жыртқыштың еті мен қанын же!
Dialogue: 0,0:18:58.47,0:19:00.34,Default,,0,0,0,,Оның қолына қара!
Dialogue: 0,0:19:00.43,0:19:03.01,Default,,0,0,0,,Қасқырдың етін жеп көріңіз.
Dialogue: 0,0:19:03.10,0:19:05.47,Default,,0,0,0,,Мен сенің иегіңді қайтадан жарамсыз етемін.
Dialogue: 0,0:19:06.14,0:19:08.48,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:19:11.85,0:19:13.52,Default,,0,0,0,,Лиз, тоқтат.
Dialogue: 0,0:19:15.44,0:19:18.11,Default,,0,0,0,,А... Апай, кешіріңіз.
Dialogue: 0,0:19:18.19,0:19:19.36,Default,,0,0,0,,Оны әлі де пайдалануда
Dialogue: 0,0:19:19.44,0:19:21.70,Default,,0,0,0,,Не? Кешіріңіз
Dialogue: 0,0:19:21.78,0:19:24.45,Default,,0,0,0,,Мен жақында шығамын, күте тұрыңыз.
Dialogue: 0,0:19:24.53,0:19:27.54,Default,,0,0,0,,Мен енді ештеңе істей алмаймын.
Dialogue: 0,0:19:27.62,0:19:29.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:29.87,0:19:31.37,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:31.46,0:19:32.37,Default,,0,0,0,,Аа...
Dialogue: 0,0:19:33.83,0:19:37.75,Default,,0,0,0,,Әзірге едендегі қанды жуып алайық.
Dialogue: 0,0:19:37.84,0:19:40.22,Default,,0,0,0,,Ю... Еден тоз-тоз.
Dialogue: 0,0:19:40.80,0:19:42.26,Default,,0,0,0,,Мұнымен не істеуім керек?
Dialogue: 0,0:19:42.34,0:19:44.80,Default,,0,0,0,,Апай байқамай қашу.
Dialogue: 0,0:19:44.89,0:19:46.93,Default,,0,0,0,,Білмейтіндей кейіп таныту
Dialogue: 0,0:19:48.89,0:19:50.60,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:51.23,0:19:53.98,Default,,0,0,0,,Жай ғана жауыз болсаң ғой.
Dialogue: 0,0:19:54.06,0:19:56.90,Default,,0,0,0,,Мен сені одан бетер жек көруім мүмкін
Dialogue: 0,0:19:57.61,0:20:01.57,Default,,0,0,0,,Бір жыл бұрын мен болсам, осылай ажырасатын едім.
Dialogue: 0,0:20:01.65,0:20:04.41,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:20:04.49,0:20:05.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:05.49,0:20:07.41,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:20:08.24,0:20:11.87,Default,,0,0,0,,Мен сені ешқашан кешіре алмаймын.
Dialogue: 0,0:20:13.08,0:20:15.79,Default,,0,0,0,,(Екі айқайлау)
Dialogue: 0,0:20:15.88,0:20:17.13,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:17.21,0:20:18.46,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:20:18.55,0:20:20.88,Default,,0,0,0,,Әзірше осы, Легоси-кун.
Dialogue: 0,0:20:22.22,0:20:25.22,Default,,0,0,0,,Есеп айырысу Жаңа жыл қарсаңында
Dialogue: 0,0:20:25.30,0:20:26.60,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:28.93,0:20:32.27,Default,,0,0,0,,Жаңа жыл түні... Жарайды.
Dialogue: 0,0:20:32.85,0:20:36.23,Default,,0,0,0,,Мен сені сыпайы түрде өлтіруге дайынмын
Dialogue: 0,0:20:36.31,0:20:39.57,Default,,0,0,0,,Етқоректі деп шешейік
Dialogue: 0,0:20:43.20,0:20:45.32,Default,,0,0,0,,Керемет емес пе? Түсіну оңай.
Dialogue: 0,0:20:46.07,0:20:49.53,Default,,0,0,0,,Эй, мен оны бірден полицияға беруім керек.
Dialogue: 0,0:20:49.62,0:20:52.25,Default,,0,0,0,,Ал... жарайды, сізге ұқсайды.
Dialogue: 0,0:20:52.33,0:20:53.75,Default,,0,0,0,,Хахахахахахахаха...
Dialogue: 0,0:20:53.83,0:20:56.08,Default,,0,0,0,,Гухин мырзаның саясаты туралы бұрын естігенмін.
Dialogue: 0,0:20:56.17,0:20:57.67,Default,,0,0,0,,Тек басқару
Dialogue: 0,0:20:58.63,0:21:02.21,Default,,0,0,0,,Мен де бір шөпқоректі жеп қала жаздадым.
Dialogue: 0,0:21:03.05,0:21:05.18,Default,,0,0,0,,Жазалаудан гөрі
Dialogue: 0,0:21:05.26,0:21:08.22,Default,,0,0,0,,Мен онымен өзім кездескім келеді.
Dialogue: 0,0:21:09.14,0:21:12.14,Default,,0,0,0,,Хаа... Бірақ қазір онсыз да тоз-тоз болып кетті.
Dialogue: 0,0:21:12.22,0:21:14.31,Default,,0,0,0,,Жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:21:14.98,0:21:17.73,Default,,0,0,0,,Дәл қазір күшейіп кетсем екен
Dialogue: 0,0:21:18.52,0:21:20.02,Default,,0,0,0,,Бір нәрсе айтыңыз...
Dialogue: 0,0:21:20.11,0:21:22.65,Default,,0,0,0,,Мұндай жәндіктер туралы жақсы әңгімелер жоқ.
Dialogue: 0,0:21:24.24,0:21:25.95,Default,,0,0,0,,Жоқ... иә?
Dialogue: 0,0:21:27.16,0:21:29.16,Default,,0,0,0,,Бір ғана
Dialogue: 0,0:21:29.24,0:21:30.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:32.04,0:21:38.04,Default,,0,0,0,,♪～
Dialogue: 0,0:22:52.32,0:22:58.33,Default,,0,0,0,,～♪
Dialogue: 0,0:22:59.83,0:23:05.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory