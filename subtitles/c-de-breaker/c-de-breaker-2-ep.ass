Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.81,0:00:11.80,JP-SUB,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:00:34.87,0:00:38.75,OP JP,,0,0,0,,Неліктен жұмбақ шешу керек
Dialogue: 0,0:00:39.04,0:00:42.15,OP JP,,0,0,0,,Соңғы бөлім
Dialogue: 0,0:00:42.30,0:00:46.15,OP JP,,0,0,0,,Сіз іздеген жерде емес
Dialogue: 0,0:00:46.48,0:00:49.43,OP JP,,0,0,0,,Қорқыныш сезіміне бой алдыру
Dialogue: 0,0:00:49.56,0:00:53.09,OP JP,,0,0,0,,Айнымас жойылуға
Dialogue: 0,0:00:53.29,0:00:56.74,OP JP,,0,0,0,,Сенімсіз өзін-өзі бағалау
Dialogue: 0,0:00:57.11,0:01:00.59,OP JP,,0,0,0,,тірі қал Мен жете алмаймын
Dialogue: 0,0:01:00.87,0:01:06.56,OP JP,,0,0,0,,Жасырын естеліктердің кейінгі бейнесінде
Dialogue: 0,0:01:07.06,0:01:11.23,OP JP,,0,0,0,,Шексіз ҚАРА ҰЯТТЫ босатыңыз
Dialogue: 0,0:01:11.48,0:01:14.96,OP JP,,0,0,0,,Осы нәзік дүниенің соңы
Dialogue: 0,0:01:15.13,0:01:19.31,OP JP,,0,0,0,,Ұмытқан тынысым - үнсіздік
Dialogue: 0,0:01:19.31,0:01:22.96,OP JP,,0,0,0,,Көз алдымда арам тарады
Dialogue: 0,0:01:22.96,0:01:26.04,OP JP,,0,0,0,,Қараңғыда жерленген
Dialogue: 0,0:01:26.19,0:01:29.28,OP JP,,0,0,0,,Тексерілді, біз білеміз
Dialogue: 0,0:01:29.80,0:01:35.69,OP JP,,0,0,0,,Өтпелі екпінділікте
Dialogue: 0,0:01:36.16,0:01:40.34,OP JP,,0,0,0,,Еркін қараңыз
Dialogue: 0,0:02:00.64,0:02:03.33,JP-SUB,,0,0,0,,Әке Ана Менмін
Dialogue: 0,0:02:03.75,0:02:05.69,JP-SUB,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:02:06.78,0:02:07.70,JP-SUB,,0,0,0,,Әке
Dialogue: 0,0:02:07.85,0:02:10.38,JP-SUB,,0,0,0,,Сакура-кун, өзіңді жақсы сезінесің.
Dialogue: 0,0:02:11.23,0:02:13.19,JP-SUB,,0,0,0,,Мұның бәрі Юки Чанның мейірбикелік қамқорлығының арқасында.
Dialogue: 0,0:02:13.29,0:02:16.37,JP-SUB,,0,0,0,,Эх, Юки-чан, Сакура-кюн үшін.
Dialogue: 0,0:02:16.55,0:02:18.44,JP-SUB,,0,0,0,,Сіз кез келген нәрсені жасай аласыз.
Dialogue: 0,0:02:19.03,0:02:21.67,JP-SUB,,0,0,0,,Анашым, мен қандаймын?
Dialogue: 0,0:02:22.81,0:02:23.98,JP-SUB,,0,0,0,,есімде жоқ
Dialogue: 0,0:02:24.25,0:02:24.87,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:02:30.64,0:02:31.56,JP-SUB,,0,0,0,,Солай ма?
Dialogue: 0,0:02:32.18,0:02:33.25,JP-SUB,,0,0,0,,Қақпа алдында
Dialogue: 0,0:02:33.80,0:02:36.28,JP-SUB,,0,0,0,,Дайсуке-сан маған тауып берді.
Dialogue: 0,0:02:36.63,0:02:37.45,JP-SUB,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:02:37.97,0:02:39.51,JP-SUB,,0,0,0,,Менің денем толығымен суық.
Dialogue: 0,0:02:40.03,0:02:43.07,JP-SUB,,0,0,0,,Эй, бірақ мен сенің жақсы сезініп жатқаныңа қуаныштымын.
Dialogue: 0,0:02:43.69,0:02:47.27,JP-SUB,,0,0,0,,Әке, ана, уайымдағаныңыз үшін кешіріңіз.
Dialogue: 0,0:02:48.01,0:02:49.16,JP-SUB,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:50.67,0:02:52.74,JP-SUB,,0,0,0,,Сакура-чан, бетіңді көтер
Dialogue: 0,0:02:53.53,0:02:56.49,JP-SUB,,0,0,0,,Анам мен әкем, Сакура-чан аман деп үміттенемін.
Dialogue: 0,0:02:56.49,0:02:57.63,JP-SUB,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:02:58.45,0:02:59.69,JP-SUB,,0,0,0,,Иә, Сакура-кюн
Dialogue: 0,0:03:00.04,0:03:01.91,JP-SUB,,0,0,0,,Бұл мені ең бақытты етеді.
Dialogue: 0,0:03:04.37,0:03:09.79,JP-SUB,,0,0,0,,Иә, бірақ шие гүлдерін кім әкелді?
Dialogue: 0,0:03:10.43,0:03:12.00,JP-SUB,,0,0,0,,Менде түсінік жоқ.
Dialogue: 0,0:03:14.46,0:03:14.95,JP-SUB,,0,0,0,,Не болды?
Dialogue: 0,0:03:22.09,0:03:23.68,JP-SUB,,0,0,0,,Зұлымдарды соттау
Dialogue: 0,0:03:24.03,0:03:27.16,JP-SUB,,0,0,0,,Иә Бұл рұқсат етілген бе?
Dialogue: 0,0:03:33.42,0:03:34.91,JP-SUB,,0,0,0,,Кек, не болса да.
Dialogue: 0,0:03:36.13,0:03:39.06,JP-SUB,,0,0,0,,Бұл қабылданбайды.
Dialogue: 0,0:03:39.66,0:03:41.13,JP-SUB,,0,0,0,,Папа солай ойлайды.
Dialogue: 0,0:03:49.40,0:03:51.69,JP-SUB,,0,0,0,,Тіпті күйген қалдық жоқ па?
Dialogue: 0,0:03:56.88,0:03:57.93,JP-SUB,,0,0,0,,Жану
Dialogue: 0,0:04:01.23,0:04:04.74,JP-SUB,,0,0,0,,Ол мені өлтірмек болды.
Dialogue: 0,0:04:12.22,0:04:15.23,JP-SUB,,0,0,0,,Бірақ мені неге сағындың?
Dialogue: 0,0:04:39.61,0:04:41.47,JP-SUB,,0,0,0,,Сакура Қайырлы таң
Dialogue: 0,0:04:41.89,0:04:43.98,JP-SUB,,0,0,0,,Аа, қайырлы таң Аоба
Dialogue: 0,0:04:44.50,0:04:46.89,JP-SUB,,0,0,0,,Кел, саған көрсететін бір нәрсем бар.
Dialogue: 0,0:04:52.63,0:04:56.01,JP-SUB,,0,0,0,,Не болды? Көңіл-күйіңіз нашар.
Dialogue: 0,0:04:56.91,0:04:59.62,JP-SUB,,0,0,0,,Оками, сен менімен не істемексің?
Dialogue: 0,0:05:00.73,0:05:02.52,JP-SUB,,0,0,0,,Мен шие гүлдерін тыңдап жүрмін
Dialogue: 0,0:05:05.11,0:05:07.72,JP-SUB,,0,0,0,,Огами-кунға қанша көңіл бөлсем де,
Dialogue: 0,0:05:08.24,0:05:10.58,JP-SUB,,0,0,0,,Ең жақын досыңызды елемеу - қорқынышты.
Dialogue: 0,0:05:11.05,0:05:13.58,JP-SUB,,0,0,0,,Кешіріңіз Аоба
Dialogue: 0,0:05:13.68,0:05:14.78,JP-SUB,,0,0,0,,Менің айтқым келгені бұл емес
Dialogue: 0,0:05:16.09,0:05:18.26,JP-SUB,,0,0,0,,Не болды? Мен сенімен сөйлесемін.
Dialogue: 0,0:05:18.83,0:05:20.39,JP-SUB,,0,0,0,,Өйткені, бұл Огами-кун туралы.
Dialogue: 0,0:05:22.48,0:05:25.29,JP-SUB,,0,0,0,,Негізі кеше түнде саябақта.
Dialogue: 0,0:05:25.56,0:05:28.84,JP-SUB,,0,0,0,,Не болды, Такацу-сан, бұл құпия ма?
Dialogue: 0,0:05:31.30,0:05:34.16,JP-SUB,,0,0,0,,Енді мені қорқытпа, Огами-кун.
Dialogue: 0,0:05:34.31,0:05:35.23,JP-SUB,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:35.63,0:05:36.87,JP-SUB,,0,0,0,,Бұл көңілді көрінді
Dialogue: 0,0:05:37.32,0:05:38.81,JP-SUB,,0,0,0,,Маған да айтыңызшы.
Dialogue: 0,0:05:40.38,0:05:42.07,JP-SUB,,0,0,0,,Жоқ, түсінемін.
Dialogue: 0,0:05:42.17,0:05:44.50,JP-SUB,,0,0,0,,Огами-кун, мен Сакураға қызықпын.
Dialogue: 0,0:05:44.63,0:05:46.50,JP-SUB,,0,0,0,,Иә, неге?
Dialogue: 0,0:05:46.71,0:05:49.62,JP-SUB,,0,0,0,,Оның диалогқа түсуі ең жақсы дәлел
Dialogue: 0,0:05:55.49,0:05:56.53,JP-SUB,,0,0,0,,Тоқта
Dialogue: 0,0:05:57.90,0:05:59.59,JP-SUB,,0,0,0,,Аоба Бұл жігітке тиіспе
Dialogue: 0,0:06:00.19,0:06:00.98,JP-SUB,,0,0,0,,Сакура
Dialogue: 0,0:06:01.58,0:06:02.84,JP-SUB,,0,0,0,,Окамиге тиіспеңіз
Dialogue: 0,0:06:02.94,0:06:03.81,JP-SUB,,0,0,0,,Сіз күйіп қаласыз.
Dialogue: 0,0:06:04.36,0:06:06.50,JP-SUB,,0,0,0,,Не, кенет махаббат үшбұрышы?
Dialogue: 0,0:06:06.50,0:06:08.24,JP-SUB,,0,0,0,,Сакуракоджи мырза, сіз қызғанасыз ба?
Dialogue: 0,0:06:09.38,0:06:13.28,JP-SUB,,0,0,0,,Огами: Сакуракоджи-сан ғана емес, Ао-о-чан да.
Dialogue: 0,0:06:13.28,0:06:15.02,JP-SUB,,0,0,0,,Таңертеңнен бері бейберекет көрініс болды ма?
Dialogue: 0,0:06:15.52,0:06:17.58,JP-SUB,,0,0,0,,Шие гүлін көргенде не айтасың?
Dialogue: 0,0:06:17.96,0:06:19.67,JP-SUB,,0,0,0,,Бар болғаны иығымдағы қолмен
Dialogue: 0,0:06:20.37,0:06:21.41,JP-SUB,,0,0,0,,Олай емес
Dialogue: 0,0:06:21.61,0:06:25.16,JP-SUB,,0,0,0,,Сакуракоджи мырза, сіз не туралы айтып отырсыз?
Dialogue: 0,0:06:25.79,0:06:27.67,JP-SUB,,0,0,0,,Маған да хабарлаңыз.
Dialogue: 0,0:06:29.41,0:06:30.36,JP-SUB,,0,0,0,,Бұл жігіт
Dialogue: 0,0:06:32.60,0:06:36.35,JP-SUB,,0,0,0,,Бұл жігіт, мен сөйлеспеу үшін мені бақылап тұру үшін.
Dialogue: 0,0:06:37.42,0:06:41.12,JP-SUB,,0,0,0,,Біреуге айтсам, мені де, басқаларды да өртеп жібереді.
Dialogue: 0,0:06:42.64,0:06:45.10,JP-SUB,,0,0,0,,Қараңдаршы, қашаннан бері шу шығарып жүрсің?
Dialogue: 0,0:06:45.10,0:06:46.49,JP-SUB,,0,0,0,,Сабақ басталады
Dialogue: 0,0:06:52.18,0:06:54.37,JP-SUB,,0,0,0,,Эй, Сакуракоджи, тез орныңа отыр.
Dialogue: 0,0:06:56.75,0:06:57.47,JP-SUB,,0,0,0,,Мұғалім
Dialogue: 0,0:06:57.85,0:06:58.47,JP-SUB,,0,0,0,,Не болды?
Dialogue: 0,0:07:00.71,0:07:03.19,JP-SUB,,0,0,0,,Буггарати? Меніңше, ол Неаполитандық бандит болған, иә?
Dialogue: 0,0:07:18.60,0:07:20.07,JP-SUB,,0,0,0,,Сакура
Dialogue: 0,0:07:22.01,0:07:23.99,JP-SUB,,0,0,0,,Мені енді артымда қалдырма.
Dialogue: 0,0:07:25.11,0:07:25.81,JP-SUB,,0,0,0,,Аоба
Dialogue: 0,0:07:28.29,0:07:30.73,JP-SUB,,0,0,0,,Мен сенімен бірге болғым келмейді.
Dialogue: 0,0:07:33.94,0:07:35.23,JP-SUB,,0,0,0,,Аздап шие гүлі
Dialogue: 0,0:07:51.21,0:07:55.09,JP-SUB,,0,0,0,,Олар күткендей мені бақылап отыр.
Dialogue: 0,0:07:55.19,0:08:00.53,JP-SUB,,0,0,0,,Сакура Мен мұндай жерде тамақтанып қойғанмын.
Dialogue: 0,0:08:00.78,0:08:01.65,JP-SUB,,0,0,0,,Бірге тамақтанайық
Dialogue: 0,0:08:02.42,0:08:03.19,JP-SUB,,0,0,0,,Аоба
Dialogue: 0,0:08:08.16,0:08:10.25,JP-SUB,,0,0,0,,Аоба, менен аулақ жүрші.
Dialogue: 0,0:08:11.07,0:08:13.33,JP-SUB,,0,0,0,,Не, Сакура, мені тастап кетші.
Dialogue: 0,0:08:13.33,0:08:14.60,JP-SUB,,0,0,0,,Жарайды, кет.
Dialogue: 0,0:08:15.14,0:08:17.33,JP-SUB,,0,0,0,,Өте жаман емес
Dialogue: 0,0:08:18.42,0:08:21.48,JP-SUB,,0,0,0,,Кешіріңіз, мен олай айтқым келген жоқ.
Dialogue: 0,0:08:27.30,0:08:30.25,JP-SUB,,0,0,0,,Огами-кунға көңіл бөлгеніңіз жақсы болды.
Dialogue: 0,0:08:31.42,0:08:33.24,JP-SUB,,0,0,0,,Менен неге қашып жүрсің?
Dialogue: 0,0:08:33.59,0:08:35.25,JP-SUB,,0,0,0,,Жоқ, солай.
Dialogue: 0,0:08:35.25,0:08:36.59,JP-SUB,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:08:37.04,0:08:40.35,JP-SUB,,0,0,0,,Аоба №, Аоба
Dialogue: 0,0:08:50.61,0:08:51.90,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:08:56.05,0:08:58.19,JP-SUB,,0,0,0,,Қалайсың, Сакуракоджи мырза?
Dialogue: 0,0:08:59.09,0:09:03.51,JP-SUB,,0,0,0,,Огами…кун, біз жалғыз сөйлесуіміз керек.
Dialogue: 0,0:09:04.33,0:09:06.67,JP-SUB,,0,0,0,,Бүгін сабақтан кейін менімен үйге келе аласыз ба?
Dialogue: 0,0:09:07.16,0:09:08.46,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:09:08.46,0:09:10.22,JP-SUB,,0,0,0,,Сакура өте агрессивті
Dialogue: 0,0:09:10.37,0:09:11.46,JP-SUB,,0,0,0,,Мектептен кейінгі күн.
Dialogue: 0,0:09:11.66,0:09:14.82,JP-SUB,,0,0,0,,Сакуракоджи мырза, бұл жігіттің несі жақсы?
Dialogue: 0,0:09:15.41,0:09:17.03,JP-SUB,,0,0,0,,Жақсы, мен қуанар едім.
Dialogue: 0,0:09:27.87,0:09:31.64,JP-SUB,,0,0,0,,Аоба, мен сенімен жұмысым біткен соң сөйлесемін, күте тұрыңыз.
Dialogue: 0,0:09:32.29,0:09:33.11,JP-SUB,,0,0,0,,Сакура
Dialogue: 0,0:09:39.27,0:09:43.95,JP-SUB,,0,0,0,,Жарайды, түсіндім. Кет, Сакура.
Dialogue: 0,0:09:44.69,0:09:48.87,JP-SUB,,0,0,0,,Мияу Мяу Мяу Мару Барлығының достары
Dialogue: 0,0:09:49.61,0:09:53.74,JP-SUB,,0,0,0,,Мейірімді мысық одақтасы
Dialogue: 0,0:09:54.31,0:09:58.54,JP-SUB,,0,0,0,,Өшіп бара жатқан өмір
Dialogue: 0,0:10:00.18,0:10:05.05,JP-SUB,,0,0,0,,Жоқ, мен мұны тағы бір рет жасай аламын.
Dialogue: 0,0:10:05.92,0:10:07.46,JP-SUB,,0,0,0,,Ньянмару енді жоқ
Dialogue: 0,0:10:07.86,0:10:08.53,JP-SUB,,0,0,0,,Кеттік
Dialogue: 0,0:10:09.80,0:10:12.03,JP-SUB,,0,0,0,,Тұтынушы, мынаны әкеліңіз.
Dialogue: 0,0:10:12.26,0:10:13.77,JP-SUB,,0,0,0,,Қажет емес, ағама беремін.
Dialogue: 0,0:10:15.69,0:10:18.12,JP-SUB,,0,0,0,,Мен Ньянмаруды сақтап қалдым.
Dialogue: 0,0:10:19.32,0:10:22.77,JP-SUB,,0,0,0,,Ал, егер ол жанып кетсе, оның түсі қандай болар еді?
Dialogue: 0,0:10:23.29,0:10:24.53,JP-SUB,,0,0,0,,E Moe
Dialogue: 0,0:10:25.93,0:10:29.85,JP-SUB,,0,0,0,,Көк - ең жақсы. Көгілдір от - ең әдемі.
Dialogue: 0,0:10:35.15,0:10:37.73,JP-SUB,,0,0,0,,Сізге соншалықты сақ болудың қажеті жоқ.
Dialogue: 0,0:10:38.43,0:10:41.48,JP-SUB,,0,0,0,,Сіз дабыл тудыратын бірдеңе жасағаныңызды білетін сияқтысыз.
Dialogue: 0,0:10:43.32,0:10:45.34,JP-SUB,,0,0,0,,Айтпақшы, әңгіме дегеніміз не?
Dialogue: 0,0:10:48.07,0:10:52.20,JP-SUB,,0,0,0,,Мияу Мяу Мяу Мару Барлығының достары
Dialogue: 0,0:10:52.92,0:10:56.94,JP-SUB,,0,0,0,,Мейірімді мысық одақтасы
Dialogue: 0,0:11:12.06,0:11:12.75,JP-SUB,,0,0,0,,Ньянмару
Dialogue: 0,0:11:16.55,0:11:18.00,JP-SUB,,0,0,0,,Nyanmaru
Dialogue: 0,0:11:19.71,0:11:21.62,JP-SUB,,0,0,0,,Nyanmaru Nyanmaru
Dialogue: 0,0:11:28.06,0:11:28.53,JP-SUB,,0,0,0,,Anyan
Dialogue: 0,0:11:29.16,0:11:33.16,JP-SUB,,0,0,0,,Work Code: Breaker
Dialogue: 0,0:11:33.55,0:11:34.72,JP-SUB,,0,0,0,,Code Zero Three
Dialogue: 0,0:11:36.01,0:11:37.43,JP-SUB,,0,0,0,,Тенпойн Юки
Dialogue: 0,0:11:43.77,0:11:47.67,JP-SUB,,0,0,0,,You can't do anything suspicious here.
Dialogue: 0,0:11:48.32,0:11:50.33,JP-SUB,,0,0,0,,Көп көзбен
Dialogue: 0,0:11:55.48,0:11:56.17,JP-SUB,,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:11:56.74,0:11:59.28,JP-SUB,,0,0,0,,You killed the G Falcon guys.
Dialogue: 0,0:11:59.78,0:12:01.49,JP-SUB,,0,0,0,,Сол көк жалынды пайдаланыңыз
Dialogue: 0,0:12:03.53,0:12:04.13,JP-SUB,,0,0,0,,Even if hidden
Dialogue: 0,0:12:04.13,0:12:04.87,JP-SUB,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:12:06.96,0:12:09.82,JP-SUB,,0,0,0,,I killed him, but what is that?
Dialogue: 0,0:12:10.51,0:12:12.60,JP-SUB,,0,0,0,,I'm not hiding anything.
Dialogue: 0,0:12:15.33,0:12:18.57,JP-SUB,,0,0,0,,Do you know what you're talking about?
Dialogue: 0,0:12:21.10,0:12:22.19,JP-SUB,,0,0,0,,It's a part-time job.
Dialogue: 0,0:12:23.14,0:12:25.87,JP-SUB,,0,0,0,,Ал мұндай қоқысты тастаудың несі жаман?
Dialogue: 0,0:12:26.64,0:12:27.31,JP-SUB,,0,0,0,,Қоқыс?
Dialogue: 0,0:12:27.69,0:12:30.89,JP-SUB,,0,0,0,,Ондай адамдар болғаннан пайда жоқ.
Dialogue: 0,0:12:31.34,0:12:32.66,JP-SUB,,0,0,0,,Is that why you killed him?
Dialogue: 0,0:12:33.35,0:12:34.94,JP-SUB,,0,0,0,,They are murderers.
Dialogue: 0,0:12:35.19,0:12:37.45,JP-SUB,,0,0,0,,Сондықтан мені өлтірдің
Dialogue: 0,0:12:37.85,0:12:39.79,JP-SUB,,0,0,0,,Сіз әділдіктің батыры болуға тырысасыз ба?
Dialogue: 0,0:12:40.49,0:12:42.15,JP-SUB,,0,0,0,,Мен зұлыммын.
Dialogue: 0,0:12:43.37,0:12:44.64,JP-SUB,,0,0,0,,More than anyone else
Dialogue: 0,0:12:45.43,0:12:46.10,JP-SUB,,0,0,0,,Хмм, осылайша бәрі жоспар бойынша жүреді.
Dialogue: 0,0:12:47.47,0:12:49.96,JP-SUB,,0,0,0,,If you think so, surrender to the police.
Dialogue: 0,0:12:50.06,0:12:51.22,JP-SUB,,0,0,0,,Күнәларыңды өте
Dialogue: 0,0:12:51.85,0:12:52.49,JP-SUB,,0,0,0,,Түзетулер енгізу
Dialogue: 0,0:12:52.86,0:12:55.62,JP-SUB,,0,0,0,,Иә, өзіңізді тапсырсаңыз, қылмысыңыз азаяды.
Dialogue: 0,0:12:59.85,0:13:00.92,JP-SUB,,0,0,0,,Қылмыс жеңілдей ме?
Dialogue: 0,0:13:01.36,0:13:03.45,JP-SUB,,0,0,0,,Не қызық? Бұл неге күлкілі?
Dialogue: 0,0:13:08.03,0:13:10.63,JP-SUB,,0,0,0,,Оками, сен
Dialogue: 0,0:13:11.06,0:13:13.84,JP-SUB,,0,0,0,,Сіз шынымен не істегеніңізді білесіз бе?
Dialogue: 0,0:13:15.11,0:13:18.54,JP-SUB,,0,0,0,,You're killing people.
Dialogue: 0,0:13:23.14,0:13:25.30,JP-SUB,,0,0,0,,Әңгіме аяқталды ма?
Dialogue: 0,0:13:28.48,0:13:30.05,JP-SUB,,0,0,0,,Онда мен барамын.
Dialogue: 0,0:13:31.36,0:13:33.65,JP-SUB,,0,0,0,,Оками, сен
Dialogue: 0,0:13:34.72,0:13:35.65,JP-SUB,,0,0,0,,Мұны орындаңыз
Dialogue: 0,0:13:36.68,0:13:37.65,JP-SUB,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:13:38.99,0:13:40.96,JP-SUB,,0,0,0,,Сіз ештеңе сезбеймін дейсіз бе?
Dialogue: 0,0:13:42.35,0:13:43.57,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:13:46.20,0:13:48.02,JP-SUB,,0,0,0,,Таку-чан, не болды?
Dialogue: 0,0:13:48.71,0:13:51.30,JP-SUB,,0,0,0,,Кешіріңіз, мен тым қатты сөйледім.
Dialogue: 0,0:13:53.76,0:13:55.52,JP-SUB,,0,0,0,,Өтінемін, жыламашы, өтінемін
Dialogue: 0,0:13:57.58,0:13:58.90,JP-SUB,,0,0,0,,Мен мұны іздедім, солай ма?
Dialogue: 0,0:14:03.55,0:14:04.94,JP-SUB,,0,0,0,,Рахмет
Dialogue: 0,0:14:07.03,0:14:10.81,JP-SUB,,0,0,0,,Қарашы, Таку-чан, сенің осындай мейірімді үлкен аға болғаныңа қуаныштымын.
Dialogue: 0,0:14:13.19,0:14:15.53,JP-SUB,,0,0,0,,Сен кімсің...
Dialogue: 0,0:14:17.39,0:14:20.08,JP-SUB,,0,0,0,,Оками Қандай себеп болса да
Dialogue: 0,0:14:20.20,0:14:23.08,JP-SUB,,0,0,0,,Адамдарды соттауға және өлтіруге мүмкіндік жоқ.
Dialogue: 0,0:14:27.43,0:14:29.82,JP-SUB,,0,0,0,,Күте тұрыңыз, сізді заң бойынша үнсіз соттайды.
Dialogue: 0,0:14:30.81,0:14:32.21,JP-SUB,,0,0,0,,Заң бойынша үкім шығару?
Dialogue: 0,0:14:33.57,0:14:34.77,JP-SUB,,0,0,0,,Сырттан қараған адамға бұл қызғаныштың өзі сияқты көрінуі тиіс.
Dialogue: 0,0:14:35.79,0:14:38.47,JP-SUB,,0,0,0,,Өйткені заң адамдарды соттайды.
Dialogue: 0,0:14:39.49,0:14:41.18,JP-SUB,,0,0,0,,Мен жоқ адаммын
Dialogue: 0,0:14:43.99,0:14:45.68,JP-SUB,,0,0,0,,Мені заң бойынша соттай алмаймын
Dialogue: 0,0:14:48.88,0:14:53.08,JP-SUB,,0,0,0,,Мен сені осы адамдармен бірге өртеп жіберсем де
Dialogue: 0,0:14:53.48,0:14:55.02,JP-SUB,,0,0,0,,Мен ешқашан сотталмаймын
Dialogue: 0,0:14:58.58,0:15:00.52,JP-SUB,,0,0,0,,Барлық куәларды жою
Dialogue: 0,0:15:00.91,0:15:03.25,JP-SUB,,0,0,0,,Сакуракоджи Сакураны өртеп жіберу
Dialogue: 0,0:15:03.60,0:15:05.39,JP-SUB,,0,0,0,,Не айту керек
Dialogue: 0,0:15:06.63,0:15:08.39,JP-SUB,,0,0,0,,Қарап тұрған көп адамның алдында
Dialogue: 0,0:15:10.41,0:15:11.70,JP-SUB,,0,0,0,,Неге мені өртеп жібере аласың?
Dialogue: 0,0:15:12.69,0:15:14.11,JP-SUB,,0,0,0,,Неліктен оны өртеп жіберуге болады?
Dialogue: 0,0:15:16.07,0:15:17.29,JP-SUB,,0,0,0,,Тоқта
Dialogue: 0,0:15:21.49,0:15:22.11,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:15:22.11,0:15:23.31,JP-SUB,,0,0,0,,Аздап жанып тұр.
Dialogue: 0,0:15:23.31,0:15:24.50,JP-SUB,,0,0,0,,Менің сөмкем жанып жатыр
Dialogue: 0,0:15:52.26,0:15:53.31,JP-SUB,,0,0,0,,Өртену
Dialogue: 0,0:15:54.60,0:15:57.26,JP-SUB,,0,0,0,,Тоқта
Dialogue: 0,0:16:01.56,0:16:02.48,JP-SUB,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:16:07.50,0:16:08.52,JP-SUB,,0,0,0,,Қызықты
Dialogue: 0,0:16:13.96,0:16:14.80,JP-SUB,,0,0,0,,Не істеу керек
Dialogue: 0,0:16:15.67,0:16:18.38,JP-SUB,,0,0,0,,Мен бүгін күні бойы оны бақылап отырдым, бұған еш күмәнім жоқ.
Dialogue: 0,0:16:18.86,0:16:20.20,JP-SUB,,0,0,0,,Сіз сирек кездесетін түрсіз.
Dialogue: 0,0:16:22.29,0:16:23.60,JP-SUB,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:16:25.39,0:16:28.03,JP-SUB,,0,0,0,,Сіз кеше біреуді оңай өлтірдіңіз.
Dialogue: 0,0:16:28.95,0:16:31.11,JP-SUB,,0,0,0,,Бүгін мені өлтірмек болды деп ойладым.
Dialogue: 0,0:16:31.36,0:16:32.57,JP-SUB,,0,0,0,,Ол бақылап отырды
Dialogue: 0,0:16:33.72,0:16:35.56,JP-SUB,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:16:37.20,0:16:38.09,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:16:38.44,0:16:39.73,JP-SUB,,0,0,0,,Сізбен де солай.
Dialogue: 0,0:16:41.08,0:16:42.84,JP-SUB,,0,0,0,,Үйсіз қартты өлтіріңіз
Dialogue: 0,0:16:43.04,0:16:44.21,JP-SUB,,0,0,0,,Өкініш жоқ.
Dialogue: 0,0:16:45.10,0:16:47.06,JP-SUB,,0,0,0,,Сонымен қатар, басқа үйсіз адамдарға зиян келтіру
Dialogue: 0,0:16:47.59,0:16:49.92,JP-SUB,,0,0,0,,G Итті де жаралаған сұңқар жігіттер
Dialogue: 0,0:16:50.64,0:16:53.15,JP-SUB,,0,0,0,,Сіз өлуге лайық деп ойлаған болуыңыз керек.
Dialogue: 0,0:16:54.05,0:16:55.32,JP-SUB,,0,0,0,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:16:55.71,0:16:57.65,JP-SUB,,0,0,0,,Өлтіруге лайық адамдар
Dialogue: 0,0:16:58.70,0:17:01.83,JP-SUB,,0,0,0,,Мұндай зиянкестерді жою – менің қосымша жұмысым.
Dialogue: 0,0:17:02.42,0:17:05.26,JP-SUB,,0,0,0,,Заңмен бағаланбайтын зұлымдықты соттайтын зұлымдық
Dialogue: 0,0:17:07.97,0:17:09.93,JP-SUB,,0,0,0,,Жоқтар
Dialogue: 0,0:17:10.55,0:17:11.70,JP-SUB,,0,0,0,,Код: ажыратқыш
Dialogue: 0,0:17:13.21,0:17:15.03,JP-SUB,,0,0,0,,Код: ажыратқыш…
Dialogue: 0,0:17:15.57,0:17:18.58,JP-SUB,,0,0,0,,Сенде де бар, өлгеніңді қалайсың.
Dialogue: 0,0:17:19.52,0:17:21.46,JP-SUB,,0,0,0,,Жарайды, шынын айт.
Dialogue: 0,0:17:21.69,0:17:23.63,JP-SUB,,0,0,0,,Өлгенін қалайтын адамды атаңыз
Dialogue: 0,0:17:25.59,0:17:26.38,JP-SUB,,0,0,0,,Тоқта
Dialogue: 0,0:17:27.75,0:17:30.24,JP-SUB,,0,0,0,,Бұған рұқсат етілмейді
Dialogue: 0,0:17:31.48,0:17:32.67,JP-SUB,,0,0,0,,Мені өлтірме
Dialogue: 0,0:17:33.32,0:17:35.95,JP-SUB,,0,0,0,,Кім болсаң да, оны ешқашан жасамау керек.
Dialogue: 0,0:17:38.31,0:17:40.08,JP-SUB,,0,0,0,,Неге олай істеп жатырсың?
Dialogue: 0,0:17:44.53,0:17:45.77,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:17:53.75,0:17:54.54,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:17:56.13,0:17:59.61,JP-SUB,,0,0,0,,Егер сен мені қадағалайтын болсаң, қалағаныңды істе.
Dialogue: 0,0:18:00.01,0:18:02.20,JP-SUB,,0,0,0,,Бірақ мен де сені қадағалаймын.
Dialogue: 0,0:18:02.57,0:18:04.63,JP-SUB,,0,0,0,,Сакуракоджи Сакура атымен ант етемін
Dialogue: 0,0:18:05.01,0:18:06.95,JP-SUB,,0,0,0,,Енді ешкімді өлтіруге жол берме
Dialogue: 0,0:18:07.05,0:18:08.49,JP-SUB,,0,0,0,,Өз ізіңмен жүр
Dialogue: 0,0:18:09.11,0:18:10.15,JP-SUB,,0,0,0,,О, Құдай-ай…➡
Dialogue: 0,0:18:15.47,0:18:16.52,JP-SUB,,0,0,0,,Неге күлу керек
Dialogue: 0,0:18:17.24,0:18:18.01,JP-SUB,,0,0,0,,Қызықты
Dialogue: 0,0:18:18.45,0:18:20.24,JP-SUB,,0,0,0,,Сіз шынымен қызықсыз.
Dialogue: 0,0:18:22.65,0:18:23.55,JP-SUB,,0,0,0,,Жарайды.
Dialogue: 0,0:18:24.77,0:18:27.15,JP-SUB,,0,0,0,,Мұны есте сақтаңыз
Dialogue: 0,0:18:27.95,0:18:30.01,JP-SUB,,0,0,0,,Мен туралы біреуге айтсаң
Dialogue: 0,0:18:30.43,0:18:31.48,JP-SUB,,0,0,0,,Тек сіз емес
Dialogue: 0,0:18:31.68,0:18:34.26,JP-SUB,,0,0,0,,Өзіңіз естіген адамды және айналаңыздағылардың бәрін тастаңыз.
Dialogue: 0,0:18:34.83,0:18:36.99,JP-SUB,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:18:47.73,0:18:48.55,JP-SUB,,0,0,0,,Тоқта
Dialogue: 0,0:18:49.77,0:18:50.55,JP-SUB,,0,0,0,,Тоқта
Dialogue: 0,0:18:52.01,0:18:52.73,JP-SUB,,0,0,0,,Тоқта
Dialogue: 0,0:18:57.62,0:19:00.18,JP-SUB,,0,0,0,,Кез келген уақытта, кез келген жерде, кез келген
Dialogue: 0,0:19:00.56,0:19:01.55,JP-SUB,,0,0,0,,Ерекшеліктер жоқ
Dialogue: 0,0:19:03.69,0:19:05.38,JP-SUB,,0,0,0,,Әрқашан күйіп кетіңіз
Dialogue: 0,0:19:18.70,0:19:21.06,JP-SUB,,0,0,0,,Сакура-чан, бірдеңе болды ма?
Dialogue: 0,0:19:21.61,0:19:23.65,JP-SUB,,0,0,0,,Сіз маған ештеңе айтпайсыз
Dialogue: 0,0:19:30.61,0:19:33.09,JP-SUB,,0,0,0,,Сіз мені тоқтата алмайсыз
Dialogue: 0,0:19:36.92,0:19:37.69,JP-SUB,,0,0,0,,Бұл көздер
Dialogue: 0,0:19:38.41,0:19:40.82,JP-SUB,,0,0,0,,Біреуді ойланбастан өлтіргенде
Dialogue: 0,0:19:40.94,0:19:41.54,JP-SUB,,0,0,0,,Бұл көздер
Dialogue: 0,0:19:42.86,0:19:43.63,JP-SUB,,0,0,0,,Ұлы Құдайдың көзі
Dialogue: 0,0:19:44.45,0:19:46.81,JP-SUB,,0,0,0,,Қоқысқа келгенде, Зиянкестерді жоюға келгенде.
Dialogue: 0,0:19:47.90,0:19:50.61,JP-SUB,,0,0,0,,Сонда да солай болды ма?
Dialogue: 0,0:19:51.66,0:19:53.92,JP-SUB,,0,0,0,,Ол сені сол суық көздерімен өлтірді ме?
Dialogue: 0,0:19:55.58,0:19:56.03,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:19:57.37,0:19:58.03,JP-SUB,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:19:58.84,0:20:00.68,JP-SUB,,0,0,0,,Сенің көздерің қандай еді?
Dialogue: 0,0:20:13.33,0:20:14.32,JP-SUB,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:20:14.99,0:20:15.69,JP-SUB,,0,0,0,,Огами Нөл
Dialogue: 0,0:20:16.41,0:20:18.50,JP-SUB,,0,0,0,,Жоспарларыңызға осындай адамдарды енгізіңіз.
Dialogue: 0,0:20:19.12,0:20:23.17,JP-SUB,,0,0,0,,Қолдану қиын, бірақ меңгергенде тиімділігі жоғары
Dialogue: 0,0:20:24.17,0:20:26.97,JP-SUB,,0,0,0,,Мен оны сақтандырамын.
Dialogue: 0,0:20:28.07,0:20:32.52,JP-SUB,,0,0,0,,Ол бақылаудан шығып кетсе, дұрыс жұмыс істеуге арналған.
Dialogue: 0,0:20:37.84,0:20:38.38,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:20:39.13,0:20:41.07,JP-SUB,,0,0,0,,Сакуракоджи Сакураға қатысты.
Dialogue: 0,0:20:41.71,0:20:44.70,JP-SUB,,0,0,0,,А, мен одан құтылуға тырысуды қойдым.
Dialogue: 0,0:20:45.59,0:20:47.43,JP-SUB,,0,0,0,,Бұл сирек кездесетін түр, оны өлтіру ұят болады.
Dialogue: 0,0:20:47.95,0:20:49.02,JP-SUB,,0,0,0,,Сирек кездесетін түр ме?
Dialogue: 0,0:20:49.69,0:20:51.03,JP-SUB,,0,0,0,,Жоқ, анау бала...
Dialogue: 0,0:20:51.58,0:20:52.47,JP-SUB,,0,0,0,,Күмән жоқ
Dialogue: 0,0:20:53.72,0:20:54.74,JP-SUB,,0,0,0,,Сол әйел
Dialogue: 0,0:20:55.48,0:20:56.20,JP-SUB,,0,0,0,,Ол жанбайды
Dialogue: 0,0:20:57.30,0:20:58.44,JP-SUB,,0,0,0,,Тіпті менің жалыным
Dialogue: 0,0:21:00.85,0:21:03.29,ED JP-B,,0,0,0,,Сен де бір күні түсінерсің
Dialogue: 0,0:21:03.29,0:21:05.70,ED JP-B,,0,0,0,,Ақ қарға қайда барады
Dialogue: 0,0:21:05.70,0:21:08.38,ED JP-B,,0,0,0,,Ешкімді танымай ұшамыз
Dialogue: 0,0:21:08.38,0:21:11.02,ED JP-B,,0,0,0,,Жанды қала
Dialogue: 0,0:21:21.80,0:21:25.93,ED JP-G,,0,0,0,,Тек өмір сүруге себеп іздеу
Dialogue: 0,0:21:25.93,0:21:28.14,ED JP-G,,0,0,0,,Менің бос өзім
Dialogue: 0,0:21:28.14,0:21:31.12,ED JP-G,,0,0,0,,Өйткені бұл ұят
Dialogue: 0,0:21:31.40,0:21:36.24,ED JP-G,,0,0,0,,Біз әлем белгілеген ережелерді ұстанамыз
Dialogue: 0,0:21:36.24,0:21:40.92,ED JP-G,,0,0,0,,Жай ғана беріліңіз және күліңіз.
Dialogue: 0,0:21:41.93,0:21:46.38,ED JP-B,,0,0,0,,Жалаңаш болып, ішкі түйсігіңмен жүр
Dialogue: 0,0:21:46.56,0:21:50.61,ED JP-B,,0,0,0,,Көзімнен қашқан шындық
Dialogue: 0,0:21:50.66,0:21:53.07,ED JP-B,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:21:53.07,0:21:55.18,ED JP-B,,0,0,0,,Шешім қабылданды
Dialogue: 0,0:21:55.18,0:22:00.05,ED JP-B,,0,0,0,,Қара киімдеріңді тастап, тұрыңдар.
Dialogue: 0,0:22:00.30,0:22:02.54,ED JP-B,,0,0,0,,Таза тілек
Dialogue: 0,0:22:02.54,0:22:06.57,ED JP-B,,0,0,0,,Қанатымыз енді жоғалды
Dialogue: 0,0:22:06.57,0:22:09.50,ED JP-B,,0,0,0,,Оны сілкіп таста да, қанатыңды ат
Dialogue: 0,0:22:09.50,0:22:11.86,ED JP-B,,0,0,0,,Қорықпа
Dialogue: 0,0:22:11.98,0:22:17.33,ED JP-B,,0,0,0,,Жауап қараңғылықтан тыс болса
Dialogue: 0,0:22:37.76,0:22:40.02,JP-SUB,,0,0,0,,Неге шықтың?
Dialogue: 0,0:22:40.59,0:22:41.91,JP-SUB,,0,0,0,,Бұлтқа тығылса да
Dialogue: 0,0:22:42.78,0:22:44.99,JP-SUB,,0,0,0,,Бұл дүниені аяқтау үшін
Dialogue: 0,0:22:46.68,0:22:48.20,JP-SUB,,0,0,0,,Сіз адамдарды өлтіре бересіз бе?
Dialogue: 0,0:22:48.74,0:22:51.85,JP-SUB,,0,0,0,,Мен сізге сене алар емеспін, жарты күндік студент, келу туралы бастама көтерді.
Dialogue: 0,0:22:52.02,0:22:53.32,JP-SUB,,0,0,0,,Сіз есейдіңіз.
Dialogue: 0,0:22:56.60,0:22:57.09,JP-SUB,,0,0,0,,Бірақ
Dialogue: 0,0:22:57.62,0:23:00.20,JP-SUB,,0,0,0,,Огами-кун бірінші келеді деп ойладым.
Dialogue: 0,0:23:00.20,0:23:01.29,JP-SUB,,0,0,0,,Алдымен күту
Dialogue: 0,0:23:07.31,0:23:09.32,JP-SUB,,0,0,0,,Сен мені соттайсың ба?
Dialogue: 0,0:23:09.72,0:23:10.54,JP-SUB,,0,0,0,,Юки-кун
Dialogue: 0,0:23:13.30,0:23:14.24,JP-SUB,,0,0,0,,Көзге көз
Dialogue: 0,0:23:15.71,0:23:16.88,JP-SUB,,0,0,0,,Тіске арналған тіс
Dialogue: 0,0:23:18.67,0:23:21.25,JP-SUB,,0,0,0,,Жамандыққа ашу реквиемі
Dialogue: 0,0:23:25.20,0:23:27.56,JP-SUB,,0,0,0,,Келесі код: Breaker 3-эпизод
Dialogue: 0,0:23:28.29,0:23:29.30,JP-SUB,,0,0,0,,Ашулы Юуки
Dialogue: 0,0:23:29.45,0:23:30.62,JP-SUB,,0,0,0,,Балғамен ойылған
Dialogue: 0,0:23:32.04,0:23:32.86,JP-SUB,,0,0,0,,Алаяқтар
Dialogue: 0,0:23:33.33,0:23:34.52,JP-SUB,,0,0,0,,Сіздің денеңіз
Dialogue: 0,0:23:35.15,0:23:37.71,JP-SUB,,0,0,0,,Бір шаң да қалдырмай, өртеп жібер
Dialogue: 0,0:23:39.21,0:23:45.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory