Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:00.78,JP-SUB,,0,0,0,,Ньянмару
Dialogue: 0,0:00:00.00,0:00:01.02,JP-SUB,,0,0,0,,Мияуды қорғау
Dialogue: 0,0:00:00.00,0:00:01.32,JP-SUB,,0,0,0,,Барлығы осы.
Dialogue: 0,0:00:00.00,0:00:01.80,JP-SUB,,0,0,0,,Ньянмару барлығы туралы айтып жатыр.
Dialogue: 0,0:00:23.33,0:00:27.21,OP JP,,0,0,0,,Неліктен жұмбақ шешу керек
Dialogue: 0,0:00:27.50,0:00:30.61,OP JP,,0,0,0,,Соңғы бөлім
Dialogue: 0,0:00:30.76,0:00:34.61,OP JP,,0,0,0,,Сіз іздеген жерде емес
Dialogue: 0,0:00:34.94,0:00:37.89,OP JP,,0,0,0,,Қорқынышпен қозғалу
Dialogue: 0,0:00:38.02,0:00:41.55,OP JP,,0,0,0,,Айнымас жойылуға
Dialogue: 0,0:00:41.75,0:00:45.20,OP JP,,0,0,0,,Сенімсіз өзін-өзі бағалау
Dialogue: 0,0:00:45.57,0:00:49.05,OP JP,,0,0,0,,тірі қал Мен жете алмаймын
Dialogue: 0,0:00:49.33,0:00:55.02,OP JP,,0,0,0,,Жасырын естеліктердің кейінгі бейнесінде
Dialogue: 0,0:00:55.52,0:00:59.69,OP JP,,0,0,0,,Шексіз ҚАРА ҰЯТТЫ босатыңыз
Dialogue: 0,0:00:59.94,0:01:03.42,OP JP,,0,0,0,,Осы нәзік дүниенің соңы
Dialogue: 0,0:01:03.59,0:01:07.77,OP JP,,0,0,0,,Ұмытқан тынысым - үнсіздік
Dialogue: 0,0:01:07.77,0:01:11.42,OP JP,,0,0,0,,Көз алдымда арам тарады
Dialogue: 0,0:01:11.42,0:01:14.50,OP JP,,0,0,0,,Қараңғыда жерленген
Dialogue: 0,0:01:14.65,0:01:17.74,OP JP,,0,0,0,,Тексерілді, біз білеміз
Dialogue: 0,0:01:18.26,0:01:24.15,OP JP,,0,0,0,,Өтпелі екпінділікте
Dialogue: 0,0:01:24.62,0:01:28.80,OP JP,,0,0,0,,Еркін қараңыз
Dialogue: 0,0:01:42.43,0:01:46.13,T-JP-SUB,,0,0,0,,Мияу Мяу Мару Барлығының Мияу Мару
Dialogue: 0,0:01:45.57,0:01:47.05,JP-SUB,,0,0,0,,Өмірге қауіп төндіретін жарақаттар жоқ
Dialogue: 0,0:01:47.93,0:01:49.07,JP-SUB,,0,0,0,,бұл дұрыс
Dialogue: 0,0:01:48.69,0:01:52.81,T-JP-SUB,,0,0,0,,Мейірімді мысық одақтасы
Dialogue: 0,0:01:54.45,0:01:56.47,JP-SUB,,0,0,0,,Кодты бұзушылар табиғаттан тыс күштерді пайдаланады, бірақ
Dialogue: 0,0:01:56.99,0:01:58.79,JP-SUB,,0,0,0,,Егер сіз оны көп пайдалансаңыз, сіздің күштеріңіз жоғалады.
Dialogue: 0,0:01:59.31,0:02:01.13,JP-SUB,,0,0,0,,Менің денем де өзгереді.
Dialogue: 0,0:02:01.51,0:02:02.57,JP-SUB,,0,0,0,,Бұл жоғалды
Dialogue: 0,0:02:03.11,0:02:05.87,JP-SUB,,0,0,0,,Өйткені соңғы шебер тым көп қуат пайдаланған.
Dialogue: 0,0:02:06.37,0:02:08.29,JP-SUB,,0,0,0,,Уақыт таяп қалғанын білдім.
Dialogue: 0,0:02:11.67,0:02:12.45,JP-SUB,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:02:13.07,0:02:15.01,JP-SUB,,0,0,0,,Қалпына келтіру үшін бір күн қажет.
Dialogue: 0,0:02:15.41,0:02:16.27,JP-SUB,,0,0,0,,Мен жақсы боламын
Dialogue: 0,0:02:17.51,0:02:18.57,JP-SUB,,0,0,0,,Солай ма?
Dialogue: 0,0:02:19.17,0:02:21.25,JP-SUB,,0,0,0,,Хмм, жақсы.
Dialogue: 0,0:02:22.11,0:02:24.65,JP-SUB,,0,0,0,,Өйткені Хейке Сенпай тағдыр мен тағдыр туралы айтады.
Dialogue: 0,0:02:24.85,0:02:26.23,JP-SUB,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:02:26.93,0:02:29.81,JP-SUB,,0,0,0,,Қысқасы, қарны ашқан сияқты.
Dialogue: 0,0:02:34.53,0:02:36.27,JP-SUB,,0,0,0,,Сонда да мен таң қаламын.
Dialogue: 0,0:02:36.99,0:02:39.27,JP-SUB,,0,0,0,,Менің ағам кодты бұзушы болды.
Dialogue: 0,0:02:39.91,0:02:42.71,JP-SUB,,0,0,0,,Оның үстіне мұғалімнің өзі дос болған.
Dialogue: 0,0:02:43.05,0:02:44.95,JP-SUB,,0,0,0,,Және Юки-кун
Dialogue: 0,0:02:45.65,0:02:46.73,JP-SUB,,0,0,0,,Ол біреу
Dialogue: 0,0:02:47.35,0:02:49.27,JP-SUB,,0,0,0,,Мен Едемнің агентімін
Dialogue: 0,0:02:49.95,0:02:52.65,JP-SUB,,0,0,0,,Менің жұмысым код ажыратқыштарды қолдау
Dialogue: 0,0:02:52.95,0:02:53.75,JP-SUB,,0,0,0,,Қолдау
Dialogue: 0,0:02:54.17,0:02:56.49,JP-SUB,,0,0,0,,Огами-кун – нөлдік алты код
Dialogue: 0,0:02:56.93,0:02:59.73,JP-SUB,,0,0,0,,Ол арамыздағы ең төмен.
Dialogue: 0,0:03:00.33,0:03:03.95,JP-SUB,,0,0,0,,Сондықтан бізде арнайы көмекші қызметкерлер бар.
Dialogue: 0,0:03:04.31,0:03:07.11,JP-SUB,,0,0,0,,Оками - ең төменгі
Dialogue: 0,0:03:08.79,0:03:12.03,JP-SUB,,0,0,0,,Сол менсінбейтін Оками - ең төменгісі.
Dialogue: 0,0:03:12.43,0:03:14.35,JP-SUB,,0,0,0,,Юки-кунда нөл үш коды бар
Dialogue: 0,0:03:14.93,0:03:17.17,JP-SUB,,0,0,0,,Ол дыбыстың табиғаттан тыс қабілетін пайдаланады.
Dialogue: 0,0:03:17.91,0:03:21.41,JP-SUB,,0,0,0,,Мен бүгін жоқпын, бірақ Токи-кун нөл төртінші код.
Dialogue: 0,0:03:23.77,0:03:25.41,JP-SUB,,0,0,0,,Тіпті Nyanmaru жапсырмасын жапсаңыз да
Dialogue: 0,0:03:25.41,0:03:27.95,JP-SUB,,0,0,0,,Огами-кунның жағдайы жақсармайды.
Dialogue: 0,0:03:28.29,0:03:30.35,JP-SUB,,0,0,0,,Маған Ньянмару ұнайды
Dialogue: 0,0:03:30.91,0:03:31.51,JP-SUB,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:03:31.79,0:03:34.21,JP-SUB,,0,0,0,,No6 Жоғалған дәмдеуіш пальма
Dialogue: 0,0:03:35.35,0:03:37.07,JP-SUB,,0,0,0,,Қайырлы таң, өзімді жақсы сезінемін.
Dialogue: 0,0:03:38.33,0:03:40.13,JP-SUB,,0,0,0,,Ол – Бостандық
Dialogue: 0,0:03:43.47,0:03:46.59,JP-SUB,,0,0,0,,Юки-кун Оками үшін алаңдайды.
Dialogue: 0,0:03:47.71,0:03:50.55,JP-SUB,,0,0,0,,Сонда Хайке Сенпай қандай сан?
Dialogue: 0,0:03:50.89,0:03:52.99,JP-SUB,,0,0,0,,Мен нөлді екі кодтаймын
Dialogue: 0,0:03:53.37,0:03:55.23,JP-SUB,,0,0,0,,Кодты ажыратқыш және бір уақытта
Dialogue: 0,0:03:55.51,0:03:57.33,JP-SUB,,0,0,0,,Ол бәрін соттайды.
Dialogue: 0,0:03:58.05,0:03:59.63,JP-SUB,,0,0,0,,Ұпайлар шегеріледі.
Dialogue: 0,0:04:00.77,0:04:01.89,JP-SUB,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:03.13,0:04:04.15,JP-SUB,,0,0,0,,білдіреді
Dialogue: 0,0:04:04.89,0:04:07.53,JP-SUB,,0,0,0,,Сонымен бесінші адам және одан кейінгі бірінші тұлға бар.
Dialogue: 0,0:04:09.07,0:04:12.33,JP-SUB,,0,0,0,,Сіз бес кодты кездестірген болуыңыз керек.
Dialogue: 0,0:04:14.01,0:04:15.43,JP-SUB,,0,0,0,,Мүмкін велосипед?
Dialogue: 0,0:04:18.63,0:04:20.85,JP-SUB,,0,0,0,,Ичибан мырза?
Dialogue: 0,0:04:20.85,0:04:21.99,JP-SUB,,0,0,0,,Олай болса
Dialogue: 0,0:04:22.77,0:04:24.75,JP-SUB,,0,0,0,,Бізге тағы да шабуыл жасалса, қиын болар еді.
Dialogue: 0,0:04:25.13,0:04:27.47,JP-SUB,,0,0,0,,Мен қожайынымды қорғау үшін қозғалуым керек.
Dialogue: 0,0:04:27.77,0:04:29.91,JP-SUB,,0,0,0,,О, бұл рас.
Dialogue: 0,0:04:30.95,0:04:34.07,JP-SUB,,0,0,0,,Сіз де сол адамның әрекеті деп ойлайсыз.
Dialogue: 0,0:04:35.89,0:04:39.19,JP-SUB,,0,0,0,,Шебердің үйі белгілі болуы мүмкін
Dialogue: 0,0:04:40.25,0:04:41.51,JP-SUB,,0,0,0,,Баратын жеріңді ойлау керек
Dialogue: 0,0:04:42.59,0:04:44.33,JP-SUB,,0,0,0,,Менің үйіме келемін деп неге айтпайсың?
Dialogue: 0,0:04:45.59,0:04:47.35,JP-SUB,,0,0,0,,Жоқ, бұл өте қауіпті.
Dialogue: 0,0:04:48.47,0:04:51.77,JP-SUB,,0,0,0,,Сакуракоджи отбасы қандай үй болды?
Dialogue: 0,0:04:51.99,0:04:53.43,JP-SUB,,0,0,0,,Мұғалімді білесің бе?
Dialogue: 0,0:04:58.01,0:05:00.77,JP-SUB,,0,0,0,,Қош келдіңіз, Сакура ханым.
Dialogue: 0,0:05:01.37,0:05:03.55,JP-SUB,,0,0,0,,Хмм, мен қазір үйдемін.
Dialogue: 0,0:05:05.01,0:05:09.35,JP-SUB,,0,0,0,,Онизакура-гуми Жапонияның жетекші және күшті рыцарлық ұйымы
Dialogue: 0,0:05:10.07,0:05:13.05,JP-SUB,,0,0,0,,Және бастық Цуёси Сакуракоджидің қызы
Dialogue: 0,0:05:14.05,0:05:15.93,JP-SUB,,0,0,0,,Бұл Сакуракоджи Сакура-сан.
Dialogue: 0,0:05:17.83,0:05:20.53,JP-SUB,,0,0,0,,Сакура ханым, бұл адамдар
Dialogue: 0,0:05:21.11,0:05:25.99,JP-SUB,,0,0,0,,Мм, Сенпай-сан мен менің сынып жетекшім дос.
Dialogue: 0,0:05:26.21,0:05:27.07,JP-SUB,,0,0,0,,Жарай бер, жарай бер — сен ауаны тұншықтырып жатырсың, шетке жыл.
Dialogue: 0,0:05:27.31,0:05:29.71,JP-SUB,,0,0,0,,Қош келдіңіз, Сакура-кюн.
Dialogue: 0,0:05:29.89,0:05:30.67,JP-SUB,,0,0,0,,Апа
Dialogue: 0,0:05:31.35,0:05:33.27,JP-SUB,,0,0,0,,Сакура-чан қайта қош келдіңіз
Dialogue: 0,0:05:33.27,0:05:34.45,JP-SUB,,0,0,0,,Бастық
Dialogue: 0,0:05:35.61,0:05:37.31,JP-SUB,,0,0,0,,Не болды?
Dialogue: 0,0:05:38.53,0:05:39.53,JP-SUB,,0,0,0,,Сенің әкең Эден мектебінің түлегі ғой, иә?
Dialogue: 0,0:05:40.47,0:05:43.07,JP-SUB,,0,0,0,,Ол барлық сыныптастары үшін күресті.
Dialogue: 0,0:05:43.55,0:05:46.85,JP-SUB,,0,0,0,,Сен сауығып кеткенше мен саған қамқор болғым келеді.
Dialogue: 0,0:05:47.49,0:05:49.29,JP-SUB,,0,0,0,,Сіз қымбатты доссыз, солай емес пе?
Dialogue: 0,0:05:49.83,0:05:52.15,JP-SUB,,0,0,0,,Жақсы, қонақ бөлмесін пайдаланыңыз.
Dialogue: 0,0:05:52.57,0:05:54.81,JP-SUB,,0,0,0,,Рахмет, анашым.
Dialogue: 0,0:05:56.59,0:05:58.73,JP-SUB,,0,0,0,,Нян барлығы үшін күресті
Dialogue: 0,0:05:58.89,0:05:59.73,JP-SUB,,0,0,0,,Сондықтан
Dialogue: 0,0:06:01.53,0:06:02.49,JP-SUB,,0,0,0,,Ньянмару
Dialogue: 0,0:06:04.01,0:06:07.03,JP-SUB,,0,0,0,,Иә, менің досым қонаққа келеді.
Dialogue: 0,0:06:07.23,0:06:07.89,JP-SUB,,0,0,0,,Жарай бер, жарай бер — сен ауаны тұншықтырып жатырсың, шетке жыл.
Dialogue: 0,0:06:08.43,0:06:10.17,JP-SUB,,0,0,0,,Мен сені қонақ бөлмесінде күтемін.
Dialogue: 0,0:06:11.43,0:06:13.49,JP-SUB,,0,0,0,,Сакура-кюн қайтып келді
Dialogue: 0,0:06:13.93,0:06:14.61,JP-SUB,,0,0,0,,Міне
Dialogue: 0,0:06:14.97,0:06:17.47,JP-SUB,,0,0,0,,Дос деген кім?
Dialogue: 0,0:06:17.95,0:06:19.81,JP-SUB,,0,0,0,,Сіз Токикун айттыңыз.
Dialogue: 0,0:06:19.81,0:06:20.55,JP-SUB,,0,0,0,,Токи-кун
Dialogue: 0,0:06:21.39,0:06:24.19,JP-SUB,,0,0,0,,Неліктен тіпті Юки мен Хейке де бар?
Dialogue: 0,0:06:26.45,0:06:27.25,JP-SUB,,0,0,0,,Иә…♡
Dialogue: 0,0:06:27.51,0:06:29.41,JP-SUB,,0,0,0,,Тоқта, жібер.
Dialogue: 0,0:06:29.73,0:06:31.27,JP-SUB,,0,0,0,,Төрт санын тап
Dialogue: 0,0:06:31.75,0:06:35.41,JP-SUB,,0,0,0,,Токи-кун? Ол қандай көрінеді?
Dialogue: 0,0:06:36.59,0:06:38.01,JP-SUB,,0,0,0,,Жоғалған, солай ма?
Dialogue: 0,0:06:38.77,0:06:39.95,JP-SUB,,0,0,0,,кішірек
Dialogue: 0,0:06:40.79,0:06:43.15,JP-SUB,,0,0,0,,Жоғалған пішіндер әр адамға қарай өзгереді.
Dialogue: 0,0:06:43.53,0:06:47.25,JP-SUB,,0,0,0,,Токи мырза бала болғаннан кейін жоғалады.
Dialogue: 0,0:06:48.25,0:06:51.29,JP-SUB,,0,0,0,,Lost кішірейгені туралы не деуге болады?
Dialogue: 0,0:06:53.15,0:06:53.83,JP-SUB,,0,0,0,,Екінші бомба!
Dialogue: 0,0:06:54.41,0:06:58.59,JP-SUB,,0,0,0,,Бұл, сөзсіз, шынайы достың оюы.
Dialogue: 0,0:07:02.27,0:07:03.25,JP-SUB,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:09.49,0:07:12.35,JP-SUB,,0,0,0,,Үлкен залда кеш болып жатыр, дереу келіңіз.
Dialogue: 0,0:07:12.85,0:07:13.95,JP-SUB,,0,0,0,,...
Dialogue: 0,0:07:22.65,0:07:24.89,JP-SUB,,0,0,0,,-да Эден менімен байланысқа шықты.
Dialogue: 0,0:07:25.43,0:07:28.31,JP-SUB,,0,0,0,,Олар Оками адасып кетті деді, мен көмектесуге келдім.
Dialogue: 0,0:07:28.95,0:07:31.29,JP-SUB,,0,0,0,,Токи-кун да жоғалған жоқ па?
Dialogue: 0,0:07:32.87,0:07:34.57,JP-SUB,,0,0,0,,Сіз Эйденге айттыңыз ба?
Dialogue: 0,0:07:34.93,0:07:35.99,JP-SUB,,0,0,0,,Жоғалған туралы
Dialogue: 0,0:07:38.63,0:07:42.27,JP-SUB,,0,0,0,,Сіз маған айтқан жоқсыз.
Dialogue: 0,0:07:42.27,0:07:44.27,JP-SUB,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:07:46.47,0:07:48.89,JP-SUB,,0,0,0,,Жоқ, оған стикер салмаңыз.
Dialogue: 0,0:07:48.89,0:07:50.69,JP-SUB,,0,0,0,,Бұл №4 көңіл-күйіңізді көтереді
Dialogue: 0,0:07:50.69,0:07:51.67,JP-SUB,,0,0,0,,Сіз шығасыз ба?
Dialogue: 0,0:07:52.99,0:07:54.75,JP-SUB,,0,0,0,,Барлығы жақсы араласады.
Dialogue: 0,0:07:55.29,0:07:58.99,JP-SUB,,0,0,0,,Олай болса, Сакура-кённың достарын қарсы алыңыздар.
Dialogue: 0,0:07:58.99,0:08:00.09,JP-SUB,,0,0,0,,Бұл мереке
Dialogue: 0,0:08:00.89,0:08:03.21,JP-SUB,,0,0,0,,Әпке, мен аламын.
Dialogue: 0,0:08:14.23,0:08:16.29,JP-SUB,,0,0,0,,Бұл не, Сакураджи-сан?
Dialogue: 0,0:08:17.03,0:08:18.19,JP-SUB,,0,0,0,,A №
Dialogue: 0,0:08:22.35,0:08:24.99,JP-SUB,,0,0,0,,Неліктен Хайке-сенпай толық емес жұмыс күнімен жұмыс істейді?
Dialogue: 0,0:08:25.43,0:08:27.77,JP-SUB,,0,0,0,,Енді неге?
Dialogue: 0,0:08:30.07,0:08:31.41,JP-SUB,,0,0,0,,Огами-кун не істеп жатыр?
Dialogue: 0,0:08:35.29,0:08:36.89,JP-SUB,,0,0,0,,Жамандықты жою
Dialogue: 0,0:08:39.25,0:08:40.49,JP-SUB,,0,0,0,,Солай ма?
Dialogue: 0,0:08:43.33,0:08:44.51,JP-SUB,,0,0,0,,Жану
Dialogue: 0,0:08:45.55,0:08:47.03,JP-SUB,,0,0,0,,Ауырдым
Dialogue: 0,0:08:48.41,0:08:48.95,JP-SUB,,0,0,0,,Жалғыз
Dialogue: 0,0:08:52.03,0:08:54.05,JP-SUB,,0,0,0,,Сакура-чан
Dialogue: 0,0:08:54.21,0:08:55.61,JP-SUB,,0,0,0,,Ішімдік ішу
Dialogue: 0,0:08:57.05,0:08:59.65,JP-SUB,,0,0,0,,Токи-кун, кәмелетке толмағандар ішуге болмайды.
Dialogue: 0,0:08:59.79,0:09:01.77,JP-SUB,,0,0,0,,Бұл алкоголь емес.
Dialogue: 0,0:09:01.77,0:09:02.87,JP-SUB,,0,0,0,,Бұл шырын.
Dialogue: 0,0:09:02.87,0:09:04.05,JP-SUB,,0,0,0,,Мүмкін сіз мас шығарсыз
Dialogue: 0,0:09:04.51,0:09:07.33,JP-SUB,,0,0,0,,Аға, бұл Жоғалғанға байланысты.
Dialogue: 0,0:09:07.33,0:09:08.99,JP-SUB,,0,0,0,,Шырын мені мас етеді
Dialogue: 0,0:09:09.75,0:09:10.47,JP-SUB,,0,0,0,,Солай ма?
Dialogue: 0,0:09:10.89,0:09:13.69,JP-SUB,,0,0,0,,Токи-кун, ұпайлар шегеріледі.
Dialogue: 0,0:09:15.03,0:09:16.25,JP-SUB,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:16.67,0:09:17.97,JP-SUB,,0,0,0,,Хайке
Dialogue: 0,0:09:18.67,0:09:20.59,JP-SUB,,0,0,0,,Менің қасым жоқ болса да
Dialogue: 0,0:09:22.15,0:09:23.55,JP-SUB,,0,0,0,,Қас жоқ
Dialogue: 0,0:09:23.55,0:09:24.31,JP-SUB,,0,0,0,,Токи-кун
Dialogue: 0,0:09:24.69,0:09:28.61,JP-SUB,,0,0,0,,Мен сені жазалауым керек сияқты.
Dialogue: 0,0:09:29.13,0:09:31.59,JP-SUB,,0,0,0,,Жоқ, онша байыпты болудың қажеті жоқ.
Dialogue: 0,0:09:31.89,0:09:34.55,JP-SUB,,0,0,0,,Алтыншы санын жасырғаныңыз үшін рахмет.
Dialogue: 0,0:09:35.39,0:09:36.91,JP-SUB,,0,0,0,,Бұл үлкен мәселе емес
Dialogue: 0,0:09:37.29,0:09:40.45,JP-SUB,,0,0,0,,Сыныптастарыңызды қорғағаны үшін қарызыңызды өтеудің қажеті жоқ.
Dialogue: 0,0:09:40.87,0:09:41.85,JP-SUB,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:09:43.17,0:09:45.17,JP-SUB,,0,0,0,,Оками де, Токи-кун да қысылып қалды.
Dialogue: 0,0:09:45.53,0:09:46.89,JP-SUB,,0,0,0,,Мен бар күшімді салуым керек
Dialogue: 0,0:09:49.19,0:09:52.57,JP-SUB,,0,0,0,,Енді бәрі күресе алмайтындықтан, Ньянмару мұны жасайды.
Dialogue: 0,0:09:53.13,0:09:54.15,JP-SUB,,0,0,0,,Ньянмаруя
Dialogue: 0,0:09:58.03,0:10:00.97,JP-SUB,,0,0,0,,Жібер, қой
Dialogue: 0,0:10:05.45,0:10:08.77,JP-SUB,,0,0,0,,Ванна мен тамақ Сакуракоджи-сан, рахмет.
Dialogue: 0,0:10:09.03,0:10:09.63,JP-SUB,,0,0,0,,Жоқ
Dialogue: 0,0:10:09.89,0:10:12.77,JP-SUB,,0,0,0,,Сізге үлкен қонақжайлық көрсете алмағаным үшін кешіріңіз.
Dialogue: 0,0:10:16.43,0:10:18.93,JP-SUB,,0,0,0,,Мен Ньянмаруды қорғадым.
Dialogue: 0,0:10:22.63,0:10:24.21,JP-SUB,,0,0,0,,Бұл бейкүнә бұлт.
Dialogue: 0,0:10:25.05,0:10:26.69,JP-SUB,,0,0,0,,Оқуға не кедергі?
Dialogue: 0,0:10:27.05,0:10:29.29,JP-SUB,,0,0,0,,Сіз бозарған жүзбен сағат ұстайсыз ба?
Dialogue: 0,0:10:29.75,0:10:32.67,JP-SUB,,0,0,0,,Осындай кезде адасып қалғанына Токикун кінәлі.
Dialogue: 0,0:10:35.65,0:10:36.27,JP-SUB,,0,0,0,,Токи-кун
Dialogue: 0,0:10:36.77,0:10:40.37,JP-SUB,,0,0,0,,Мен бүгін болған оқиғаны толығымен көрдім.
Dialogue: 0,0:10:41.43,0:10:44.19,JP-SUB,,0,0,0,,Олар екі топқа бөлінді.
Dialogue: 0,0:10:44.89,0:10:49.13,JP-SUB,,0,0,0,,Огами-кунға шабуыл жасайтын топ және Сакуракоджи-санға шабуыл жасайтын команда
Dialogue: 0,0:10:50.23,0:10:53.51,JP-SUB,,0,0,0,,Хитоми неге бұлай жасады деп ойлайсың?
Dialogue: 0,0:10:54.13,0:10:56.09,JP-SUB,,0,0,0,,Сакура-чан да нысанаға алынды ма?
Dialogue: 0,0:10:56.55,0:10:58.41,JP-SUB,,0,0,0,,Сакуракоджи мырза сирек кездесетін түр.
Dialogue: 0,0:10:58.75,0:11:01.61,JP-SUB,,0,0,0,,Хитомиді қызықтырғаны таңқаларлық емес.
Dialogue: 0,0:11:03.09,0:11:03.75,JP-SUB,,0,0,0,,Дегенмен
Dialogue: 0,0:11:05.89,0:11:10.41,JP-SUB,,0,0,0,,Сакуракоджи-санды да ұрлағыңыз келсе, оңайырақ жол болуы керек.
Dialogue: 0,0:11:11.05,0:11:14.39,JP-SUB,,0,0,0,,Мен Огами-кун болған кезде, олардың неліктен мұны орнатуға баратындарын түсінбеймін.
Dialogue: 0,0:11:15.61,0:11:18.01,JP-SUB,,0,0,0,,Екінші жағынан, егер мақсат Огами-кунға шабуыл жасау болса, онда
Dialogue: 0,0:11:18.33,0:11:20.33,JP-SUB,,0,0,0,,Күшті екіге бөлуді түсінбеймін.
Dialogue: 0,0:11:20.99,0:11:21.93,JP-SUB,,0,0,0,,Әрине
Dialogue: 0,0:11:22.51,0:11:25.67,JP-SUB,,0,0,0,,Соңында мен Окамиден айырылдым.
Dialogue: 0,0:11:26.35,0:11:27.53,JP-SUB,,0,0,0,,Жаңа ғана жоғалтып алдым
Dialogue: 0,0:11:28.25,0:11:29.19,JP-SUB,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:31.37,0:11:33.41,JP-SUB,,0,0,0,,Немесе басқа мақсат үшін
Dialogue: 0,0:11:43.57,0:11:44.71,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:11:45.57,0:11:46.95,JP-SUB,,0,0,0,,Ұстаз ояусыз ба?
Dialogue: 0,0:11:47.73,0:11:48.27,JP-SUB,,0,0,0,,Қанда
Dialogue: 0,0:11:48.91,0:11:50.61,JP-SUB,,0,0,0,,Бұл Сакуракоджи мырзаның үйі ме?
Dialogue: 0,0:11:51.23,0:11:52.55,JP-SUB,,0,0,0,,Мүмкін, саған кішкене сабақ беруім керек шығар.
Dialogue: 0,0:11:54.45,0:11:55.53,JP-SUB,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:56.41,0:11:59.35,JP-SUB,,0,0,0,,Егер біз сол адамдардың бізге шабуыл жасауының алдын алсақ,
Dialogue: 0,0:12:00.79,0:12:01.89,JP-SUB,,0,0,0,,Ешқашан кешірім сұрама
Dialogue: 0,0:12:02.91,0:12:04.11,JP-SUB,,0,0,0,,Мен де бейқам болдым.
Dialogue: 0,0:12:04.95,0:12:05.41,JP-SUB,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:12:06.21,0:12:09.11,JP-SUB,,0,0,0,,Бұл адамдар жоғалған агенттер.
Dialogue: 0,0:12:10.07,0:12:10.79,JP-SUB,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:12:11.25,0:12:14.57,JP-SUB,,0,0,0,,A. Оны табиғаттан тыс күштер басқарды.
Dialogue: 0,0:12:16.77,0:12:18.01,JP-SUB,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:12:18.87,0:12:19.85,JP-SUB,,0,0,0,,Күмән жоқ
Dialogue: 0,0:12:20.61,0:12:22.39,JP-SUB,,0,0,0,,Жау бұрынғы кодты бұзушы
Dialogue: 0,0:12:23.03,0:12:25.31,JP-SUB,,0,0,0,,Код 01 Адамдарға қарау.
Dialogue: 0,0:12:42.41,0:12:42.95,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:12:43.49,0:12:44.55,JP-SUB,,0,0,0,,05 коды
Dialogue: 0,0:12:45.05,0:12:47.55,JP-SUB,,0,0,0,,Дереу Сакуракоджи Сакураның үйіне барыңыз.
Dialogue: 0,0:12:47.77,0:12:48.21,JP-SUB,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:12:48.65,0:12:51.29,JP-SUB,,0,0,0,,Юки мен Токи сонда бармай ма?
Dialogue: 0,0:12:51.61,0:12:53.87,JP-SUB,,0,0,0,,Код 04 Уақыт жоғалды
Dialogue: 0,0:12:54.31,0:12:55.35,JP-SUB,,0,0,0,,Пайдасыз
Dialogue: 0,0:12:56.97,0:12:57.65,JP-SUB,,0,0,0,,Түсінікті
Dialogue: 0,0:13:00.81,0:13:02.79,JP-SUB,,0,0,0,,Код ажыратқыштары барлығы бірге
Dialogue: 0,0:13:03.05,0:13:04.25,JP-SUB,,0,0,0,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:13:18.23,0:13:19.87,JP-SUB,,0,0,0,,Сіз қылышқа қызығасыз ба?
Dialogue: 0,0:13:21.03,0:13:23.55,JP-SUB,,0,0,0,,Сіздің денеңіздің жағдайы жақсарған сияқты.
Dialogue: 0,0:13:23.73,0:13:24.43,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:13:32.51,0:13:34.15,JP-SUB,,0,0,0,,Мынаны сізге беруге рұқсат етіңіз.
Dialogue: 0,0:13:39.03,0:13:42.05,JP-SUB,,0,0,0,,Сіз өлімді тым көп көрдіңіз.
Dialogue: 0,0:13:44.99,0:13:45.95,JP-SUB,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:13:47.03,0:13:48.99,JP-SUB,,0,0,0,,Өйткені мен осындай дүниеде өмір сүрдім.
Dialogue: 0,0:13:50.17,0:13:53.53,JP-SUB,,0,0,0,,Біреудің өмірін аяқтау қорқынышын жоғалттыңыз.
Dialogue: 0,0:13:54.15,0:13:57.59,JP-SUB,,0,0,0,,Бұл сіздің де өмірге деген қызығушылығыңызды жоғалтқаныңызды білдіреді.
Dialogue: 0,0:14:00.67,0:14:02.45,JP-SUB,,0,0,0,,Сакура жақсы қыз
Dialogue: 0,0:14:03.03,0:14:04.97,JP-SUB,,0,0,0,,Шие гүліне бірдеңе болып қалса
Dialogue: 0,0:14:05.83,0:14:07.09,JP-SUB,,0,0,0,,Бұл тегін емес.
Dialogue: 0,0:14:07.47,0:14:08.29,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:14:18.45,0:14:18.99,JP-SUB,,0,0,0,,Барлығы
Dialogue: 0,0:14:27.13,0:14:28.05,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:14:28.33,0:14:29.19,JP-SUB,,0,0,0,,Сакура-чан
Dialogue: 0,0:14:36.25,0:14:38.21,JP-SUB,,0,0,0,,Мен Ньянмаруды қорғадым.
Dialogue: 0,0:14:45.95,0:14:47.37,JP-SUB,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:14:47.65,0:14:49.75,JP-SUB,,0,0,0,,Бұл Сакуракоджи мырзаға тиетін шығар.
Dialogue: 0,0:14:50.71,0:14:54.15,JP-SUB,,0,0,0,,Солай болса да, сенің құдіретің осылай болды ма екен?
Dialogue: 0,0:14:54.65,0:14:55.53,JP-SUB,,0,0,0,,Шулы
Dialogue: 0,0:14:56.13,0:14:58.93,JP-SUB,,0,0,0,,Ал, ұйықтап кетші котенка.
Dialogue: 0,0:15:03.23,0:15:03.85,JP-SUB,,0,0,0,,Юки
Dialogue: 0,0:15:10.01,0:15:12.21,JP-SUB,,0,0,0,,Жаңа ғана жоғалдым
Dialogue: 0,0:15:12.71,0:15:15.03,JP-SUB,,0,0,0,,Саған сабақ берген адам ретінде менің көңілім қалды.
Dialogue: 0,0:15:18.31,0:15:19.11,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:15:24.59,0:15:26.39,JP-SUB,,0,0,0,,Сакуракоджи мырзаны босатыңыз.
Dialogue: 0,0:15:26.55,0:15:27.33,JP-SUB,,0,0,0,,Хитоми мырза
Dialogue: 0,0:15:28.97,0:15:30.83,JP-SUB,,0,0,0,,Сіз мені атып тастай аласыз ба?
Dialogue: 0,0:15:48.61,0:15:50.77,JP-SUB,,0,0,0,,Хитоми...
Dialogue: 0,0:15:57.95,0:16:00.95,JP-SUB,,0,0,0,,Сіз қылышта өте шебер болдыңыз.
Dialogue: 0,0:16:01.33,0:16:03.03,JP-SUB,,0,0,0,,Мен қазірден бастап сонда боламын.
Dialogue: 0,0:16:03.67,0:16:04.51,JP-SUB,,0,0,0,,Дегенмен
Dialogue: 0,0:16:14.83,0:16:17.51,JP-SUB,,0,0,0,,Сен мені жеңе алмайсың, Огами-кун.
Dialogue: 0,0:16:18.77,0:16:20.77,JP-SUB,,0,0,0,,Маза берсеңіз, сау болыңыз.
Dialogue: 0,0:16:23.81,0:16:24.85,JP-SUB,,0,0,0,,Би
Dialogue: 0,0:16:32.99,0:16:36.57,JP-SUB,,0,0,0,,Ей, Токи-кун, сен Жоғалған жерден оралдың.
Dialogue: 0,0:16:44.23,0:16:46.67,JP-SUB,,0,0,0,,Кодты ажыратқыштар осында
Dialogue: 0,0:16:47.53,0:16:49.43,JP-SUB,,0,0,0,,Әй, ол әлі жоғалған шығар.
Dialogue: 0,0:16:49.73,0:16:50.45,JP-SUB,,0,0,0,,Артқа қалыңыз.
Dialogue: 0,0:16:50.79,0:16:52.31,JP-SUB,,0,0,0,,Бұл менің олжағым.
Dialogue: 0,0:16:57.11,0:16:58.45,JP-SUB,,0,0,0,,Неге зұлымдыққа түстің?
Dialogue: 0,0:16:59.95,0:17:01.35,JP-SUB,,0,0,0,,Мақсаты не?
Dialogue: 0,0:17:03.07,0:17:04.21,JP-SUB,,0,0,0,,Бұл кек.
Dialogue: 0,0:17:05.95,0:17:06.73,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:17:07.43,0:17:09.23,JP-SUB,,0,0,0,,Едемнен кек алу
Dialogue: 0,0:17:10.75,0:17:12.03,JP-SUB,,0,0,0,,Не өзгерді?
Dialogue: 0,0:17:12.37,0:17:15.59,JP-SUB,,0,0,0,,Бұрын кек алуды жек көрсең де.
Dialogue: 0,0:17:20.01,0:17:21.29,JP-SUB,,0,0,0,,Сіз таныссыз ба?
Dialogue: 0,0:17:22.51,0:17:24.43,JP-SUB,,0,0,0,,Жамандыққа түссең
Dialogue: 0,0:17:26.13,0:17:27.73,JP-SUB,,0,0,0,,Мен оны кесіп тастаймын.
Dialogue: 0,0:17:29.17,0:17:32.99,JP-SUB,,0,0,0,,Едемде адам қалай итке ұқсайды?
Dialogue: 0,0:17:33.65,0:17:34.99,JP-SUB,,0,0,0,,Едем маңызды емес
Dialogue: 0,0:17:35.15,0:17:37.51,JP-SUB,,0,0,0,,Мен өз еркіммен әрекет етіп жатырмын.
Dialogue: 0,0:17:38.11,0:17:40.29,JP-SUB,,0,0,0,,Едем жаңа ғана қозғалған шығар.
Dialogue: 0,0:17:46.77,0:17:47.53,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:17:48.05,0:17:50.79,JP-SUB,,0,0,0,,Өзіңіздің еркіндігіңізден асып кетпеңіз.
Dialogue: 0,0:17:59.07,0:18:01.41,JP-SUB,,0,0,0,,Қолдарыңыз қалтаңызда әлі бар ма?
Dialogue: 0,0:18:03.73,0:18:05.83,JP-SUB,,0,0,0,,Сен жақсысың, Токикун.
Dialogue: 0,0:18:14.43,0:18:15.25,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:18:15.87,0:18:19.65,JP-SUB,,0,0,0,,Түсіндім, 24 сағат болды.
Dialogue: 0,0:18:20.29,0:18:21.09,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:18:21.93,0:18:24.77,JP-SUB,,0,0,0,,Едемнің қандай кек екенін білмеймін.
Dialogue: 0,0:18:25.37,0:18:27.67,JP-SUB,,0,0,0,,Сіздің істеп жатқаныңыз қоқыстан басқа ештеңе емес.
Dialogue: 0,0:18:28.03,0:18:31.15,JP-SUB,,0,0,0,,Түзу сызықта ешқандай айырмашылық жоқ.
Dialogue: 0,0:18:31.37,0:18:32.35,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:18:34.07,0:18:35.15,JP-SUB,,0,0,0,,Көзге көз
Dialogue: 0,0:18:35.99,0:18:37.07,JP-SUB,,0,0,0,,Тіске арналған тіс
Dialogue: 0,0:18:37.99,0:18:39.43,JP-SUB,,0,0,0,,Жамандыққа зұлымдық
Dialogue: 0,0:18:43.89,0:18:46.01,JP-SUB,,0,0,0,,Жылау
Dialogue: 0,0:18:46.25,0:18:47.23,JP-SUB,,0,0,0,,Бұл пайдасыз.
Dialogue: 0,0:18:47.73,0:18:49.77,JP-SUB,,0,0,0,,Менің ток соғу алдында
Dialogue: 0,0:18:55.81,0:18:57.45,JP-SUB,,0,0,0,,Токикун Оками
Dialogue: 0,0:18:58.71,0:18:59.71,JP-SUB,,0,0,0,,Енді
Dialogue: 0,0:19:04.01,0:19:06.55,JP-SUB,,0,0,0,,Сіз мені жеңе аласыз деп ойлайсыз ба?
Dialogue: 0,0:19:07.35,0:19:09.57,JP-SUB,,0,0,0,,Сіз тырыспайынша білмейсіз
Dialogue: 0,0:19:11.97,0:19:13.03,JP-SUB,,0,0,0,,Осымен
Dialogue: 0,0:19:13.27,0:19:15.51,JP-SUB,,0,0,0,,Түпнұсқа коды 01 адам қарайды
Dialogue: 0,0:19:16.29,0:19:18.53,JP-SUB,,0,0,0,,Біз сирек кездесетін түрлерді бере алмаймыз.
Dialogue: 0,0:19:19.89,0:19:21.81,JP-SUB,,0,0,0,,Бұл ностальгиялық есім.
Dialogue: 0,0:19:22.65,0:19:24.57,JP-SUB,,0,0,0,,Код 01...?
Dialogue: 0,0:19:26.39,0:19:28.37,JP-SUB,,0,0,0,,Неліктен мені бұлай атады
Dialogue: 0,0:19:33.63,0:19:35.71,JP-SUB,,0,0,0,,Көп уақыттан кейін көрсетемін.
Dialogue: 0,0:19:42.31,0:19:43.41,JP-SUB,,0,0,0,,Қандай құдірет!
Dialogue: 0,0:19:48.37,0:19:50.63,JP-SUB,,0,0,0,,Жолда тұрғандарға өлім
Dialogue: 0,0:19:52.07,0:19:54.51,JP-SUB,,0,0,0,,Қош бол кодты бұзушы
Dialogue: 0,0:19:55.55,0:19:56.21,JP-SUB,,0,0,0,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:19:58.67,0:19:59.39,JP-SUB,,0,0,0,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:20:00.81,0:20:02.57,JP-SUB,,0,0,0,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:20:07.09,0:20:08.09,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:20:16.69,0:20:17.65,JP-SUB,,0,0,0,,Сакуракюн
Dialogue: 0,0:20:24.99,0:20:25.59,JP-SUB,,0,0,0,,Не
Dialogue: 0,0:20:26.05,0:20:28.01,JP-SUB,,0,0,0,,Бұл керемет, Сакура-чан.
Dialogue: 0,0:20:28.51,0:20:29.63,JP-SUB,,0,0,0,,Соншама?
Dialogue: 0,0:20:31.25,0:20:32.17,JP-SUB,,0,0,0,,Сакура-чан
Dialogue: 0,0:20:32.89,0:20:34.89,JP-SUB,,0,0,0,,Керемет деген не?
Dialogue: 0,0:20:35.13,0:20:36.57,JP-SUB,,0,0,0,,Адамдарды мазақ ету
Dialogue: 0,0:20:36.73,0:20:38.05,JP-SUB,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:20:38.29,0:20:39.77,JP-SUB,,0,0,0,,Неге сонша абайсыз?
Dialogue: 0,0:20:40.15,0:20:41.23,JP-SUB,,0,0,0,,Артқа тұрыңыз.
Dialogue: 0,0:20:42.15,0:20:44.03,JP-SUB,,0,0,0,,Мен қызықты нәрселерді көрдім.
Dialogue: 0,0:20:44.87,0:20:47.05,JP-SUB,,0,0,0,,Мен бұл жолы сирек кездесетін түрлерден бас тартамын деп ойлаймын.
Dialogue: 0,0:20:47.89,0:20:49.25,JP-SUB,,0,0,0,,Үйге кететін уақыт келді.
Dialogue: 0,0:20:49.47,0:20:50.41,JP-SUB,,0,0,0,,Өміріме қауіп төндірушілер болуы мүмкін.
Dialogue: 0,0:20:51.43,0:20:54.25,JP-SUB,,0,0,0,,Бүгін маған енді сенімен ұрысудың қажеті жоқ.
Dialogue: 0,0:20:55.47,0:20:59.25,JP-SUB,,0,0,0,,Сіз кодты бұзушылар осында жиналғанда,
Dialogue: 0,0:20:59.67,0:21:01.55,JP-SUB,,0,0,0,,Ешқашан жеңген де, жеңілген де болған емес.
Dialogue: 0,0:21:02.13,0:21:03.45,JP-SUB,,0,0,0,,Бізді бірге жинаңыз
Dialogue: 0,0:21:04.17,0:21:04.87,JP-SUB,,0,0,0,,Мүмкін емес
Dialogue: 0,0:21:07.87,0:21:08.71,JP-SUB,,0,0,0,,Код 02
Dialogue: 0,0:21:09.09,0:21:11.51,JP-SUB,,0,0,0,,Премьер-министрді табиғаттан тыс адам ұрлап әкетті.
Dialogue: 0,0:21:11.85,0:21:13.19,JP-SUB,,0,0,0,,Қылмыскер қудаланады.
Dialogue: 0,0:21:13.63,0:21:15.09,JP-SUB,,0,0,0,,Бізге қосылыңыз, асығыңыз!
Dialogue: 0,0:21:19.09,0:21:20.33,JP-SUB,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:21:21.03,0:21:21.79,JP-SUB,,0,0,0,,Қайырлы түн
Dialogue: 0,0:21:22.17,0:21:23.63,JP-SUB,,0,0,0,,Кодты ажыратқыш
Dialogue: 0,0:21:24.91,0:21:26.11,JP-SUB,,0,0,0,,Ақымақ
Dialogue: 0,0:21:27.03,0:21:28.09,JP-SUB,,0,0,0,,Премьер-министр
Dialogue: 0,0:21:29.99,0:21:31.13,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:21:32.27,0:21:34.39,JP-SUB,,0,0,0,,Премьер-министрді ұрлау деген нені білдіреді?
Dialogue: 0,0:21:34.91,0:21:36.19,JP-SUB,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:21:36.81,0:21:38.13,JP-SUB,,0,0,0,,01 коды
Dialogue: 0,0:21:40.85,0:21:43.29,ED JP-B,,0,0,0,,Сен де бір күні түсінесің
Dialogue: 0,0:21:43.29,0:21:45.70,ED JP-B,,0,0,0,,Ақ қарға қайда барады
Dialogue: 0,0:21:45.70,0:21:48.38,ED JP-B,,0,0,0,,Ешкімді танымай ұшамыз
Dialogue: 0,0:21:48.38,0:21:51.02,ED JP-B,,0,0,0,,Жанды қала
Dialogue: 0,0:22:01.80,0:22:05.93,ED JP-G,,0,0,0,,Тек өмір сүруге себеп іздеу
Dialogue: 0,0:22:05.93,0:22:08.14,ED JP-G,,0,0,0,,Менің бос өзім
Dialogue: 0,0:22:08.14,0:22:11.12,ED JP-G,,0,0,0,,Өйткені бұл ұят
Dialogue: 0,0:22:11.40,0:22:16.24,ED JP-G,,0,0,0,,Біз әлем белгілеген ережелерді ұстанамыз
Dialogue: 0,0:22:16.24,0:22:20.92,ED JP-G,,0,0,0,,Жай ғана беріліңіз және күліңіз.
Dialogue: 0,0:22:21.93,0:22:26.38,ED JP-B,,0,0,0,,Жалаңаш болып, ішкі түйсігіңмен жүр
Dialogue: 0,0:22:26.56,0:22:30.61,ED JP-B,,0,0,0,,Көзден жасырылған шындық
Dialogue: 0,0:22:30.66,0:22:33.07,ED JP-B,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:22:33.07,0:22:35.18,ED JP-B,,0,0,0,,Шешім қабылданды
Dialogue: 0,0:22:35.18,0:22:40.05,ED JP-B,,0,0,0,,Қара киімдеріңді тастап, тұрыңдар.
Dialogue: 0,0:22:40.30,0:22:42.54,ED JP-B,,0,0,0,,Таза тілек
Dialogue: 0,0:22:42.54,0:22:46.57,ED JP-B,,0,0,0,,Қанаттарымыз енді жоғалды
Dialogue: 0,0:22:46.57,0:22:49.50,ED JP-B,,0,0,0,,Оны сілкіп таста да, қанатыңды ат
Dialogue: 0,0:22:49.50,0:22:51.86,ED JP-B,,0,0,0,,Қорықпа
Dialogue: 0,0:22:51.98,0:22:57.33,ED JP-B,,0,0,0,,Жауап қараңғылықтан тыс болса
Dialogue: 0,0:23:13.23,0:23:17.27,JP-SUB,,0,0,0,,Жоқ, Жоғалғанға дейін өзімді жақсы сезінбедім.
Dialogue: 0,0:23:21.49,0:23:23.27,JP-SUB,,0,0,0,,Мен оңай жеңілдім.
Dialogue: 0,0:23:25.69,0:23:28.29,JP-SUB,,0,0,0,,Келесі Code Breaker 8-эпизод
Dialogue: 0,0:23:28.83,0:23:30.79,JP-SUB,,0,0,0,,Патша және солдат сөздері
Dialogue: 0,0:23:31.85,0:23:34.59,JP-SUB,,0,0,0,,Жамандыққа түскендерді, Өртеп жіберемін.
Dialogue: 0,0:23:35.07,0:23:37.75,JP-SUB,,0,0,0,,Бұрынғы достар болса да
Dialogue: 0,0:23:39.25,0:23:45.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory