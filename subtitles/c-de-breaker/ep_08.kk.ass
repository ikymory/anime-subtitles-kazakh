Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.52,0:00:15.40,OP JP,,0,0,0,,Неліктен жұмбақ шешу керек
Dialogue: 0,0:00:15.69,0:00:18.80,OP JP,,0,0,0,,Соңғы бөлім
Dialogue: 0,0:00:18.95,0:00:22.80,OP JP,,0,0,0,,Сіз іздеген жерде емес
Dialogue: 0,0:00:23.13,0:00:26.08,OP JP,,0,0,0,,Қорқыныш сезіміне бой алдыру
Dialogue: 0,0:00:26.21,0:00:29.74,OP JP,,0,0,0,,Айнымас жойылуға
Dialogue: 0,0:00:29.94,0:00:33.39,OP JP,,0,0,0,,Сенімсіз өзін-өзі бағалау
Dialogue: 0,0:00:33.76,0:00:37.24,OP JP,,0,0,0,,тірі қал Мен жете алмаймын
Dialogue: 0,0:00:37.52,0:00:43.21,OP JP,,0,0,0,,Жасырын естеліктердің кейінгі бейнесінде
Dialogue: 0,0:00:43.71,0:00:47.88,OP JP,,0,0,0,,Шексіз ҚАРА ҰЯТТЫ босатыңыз
Dialogue: 0,0:00:48.13,0:00:51.61,OP JP,,0,0,0,,Осы нәзік дүниенің соңы
Dialogue: 0,0:00:51.78,0:00:55.96,OP JP,,0,0,0,,Ұмытқан тынысым - үнсіздік
Dialogue: 0,0:00:55.96,0:00:59.61,OP JP,,0,0,0,,Көз алдымда арам тарады
Dialogue: 0,0:00:59.61,0:01:02.69,OP JP,,0,0,0,,Қараңғыда жерленген
Dialogue: 0,0:01:02.84,0:01:05.93,OP JP,,0,0,0,,Тексерілді, біз білеміз
Dialogue: 0,0:01:06.45,0:01:12.34,OP JP,,0,0,0,,Өтпелі екпінділікте
Dialogue: 0,0:01:12.81,0:01:16.99,OP JP,,0,0,0,,Еркін қараңыз
Dialogue: 0,0:01:32.42,0:01:33.56,JP-SUB,,0,0,0,,Премьер-министрді ұрлау
Dialogue: 0,0:01:33.88,0:01:36.02,JP-SUB,,0,0,0,,Қарғыс атсын, мен алдадым.
Dialogue: 0,0:01:36.88,0:01:38.40,JP-SUB,,0,0,0,,Бізді осында жинаңыз
Dialogue: 0,0:01:38.64,0:01:40.80,JP-SUB,,0,0,0,,Осы мүмкіндік кезінде олар шабуыл жасаса ше?
Dialogue: 0,0:01:41.28,0:01:42.62,JP-SUB,,0,0,0,,Жақсылап дайындалыңыз
Dialogue: 0,0:01:43.24,0:01:45.58,JP-SUB,,0,0,0,,Қазір саған көмектесуге барсам да, уақытында үлгере алмаймын.
Dialogue: 0,0:01:47.38,0:01:49.92,JP-SUB,,0,0,0,,Мұндай адамға көмектесудің қажеті жоқ.
Dialogue: 0,0:01:50.04,0:01:51.64,JP-SUB,,0,0,0,,Не айтып тұрсың, Токи-кун?
Dialogue: 0,0:01:52.14,0:01:53.92,JP-SUB,,0,0,0,,Премьер-министр Токидің әкесі.
Dialogue: 0,0:01:54.42,0:01:56.06,JP-SUB,,0,0,0,,Неге аздап уайымдамайсың?
Dialogue: 0,0:01:56.36,0:01:57.16,JP-SUB,,0,0,0,,Әке
Dialogue: 0,0:01:57.66,0:01:59.36,JP-SUB,,0,0,0,,Сонда бәрі жақсы емес пе?
Dialogue: 0,0:02:00.40,0:02:01.74,JP-SUB,,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,0:02:02.82,0:02:03.96,JP-SUB,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:02:04.56,0:02:07.50,JP-SUB,,0,0,0,,Бұл күн емес.
Dialogue: 0,0:02:08.36,0:02:10.56,JP-SUB,,0,0,0,,Осы сағатта кездесуге барасыз ба?
Dialogue: 0,0:02:10.88,0:02:13.30,JP-SUB,,0,0,0,,Сіз нақты не ойлап отырсыз?
Dialogue: 0,0:02:13.80,0:02:18.04,JP-SUB,,0,0,0,,Оның өз ойлары бар екеніне сенімдімін. Жарайды.
Dialogue: 0,0:02:18.48,0:02:19.72,JP-SUB,,0,0,0,,Мен қайтамын.
Dialogue: 0,0:02:20.76,0:02:24.02,JP-SUB,,0,0,0,,Одан гөрі қазірден бастап не істейтініміз туралы.
Dialogue: 0,0:02:24.30,0:02:25.58,JP-SUB,,0,0,0,,Сіз Хитоми мырза туралы айтып отырсыз ба?
Dialogue: 0,0:02:27.34,0:02:28.06,JP-SUB,,0,0,0,,Ол
Dialogue: 0,0:02:28.22,0:02:31.68,JP-SUB,,0,0,0,,Не ойлайтынын білмейтін адамды көрмегелі көп болды.
Dialogue: 0,0:02:32.88,0:02:34.34,JP-SUB,,0,0,0,,Мысық сөйледі
Dialogue: 0,0:02:34.74,0:02:37.64,JP-SUB,,0,0,0,,Аа, Юкикун да адасып қалды.
Dialogue: 0,0:02:37.94,0:02:38.96,JP-SUB,,0,0,0,,Юуки-кун
Dialogue: 0,0:02:42.44,0:02:44.48,JP-SUB,,0,0,0,,Жеңілсем мысық боламын ба?
Dialogue: 0,0:02:44.92,0:02:47.28,JP-SUB,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:02:47.76,0:02:49.34,JP-SUB,,0,0,0,,Айтпақшы, Сакуракоджи мырза
Dialogue: 0,0:02:49.84,0:02:53.04,JP-SUB,,0,0,0,,Хитоми шабуылынан кейін сіздің денеңізде ақау бар ма?
Dialogue: 0,0:02:55.18,0:02:56.20,JP-SUB,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:02:56.66,0:02:58.02,JP-SUB,,0,0,0,,Солай ма?
Dialogue: 0,0:02:58.72,0:02:59.48,JP-SUB,,0,0,0,,Мүлдем
Dialogue: 0,0:03:00.06,0:03:02.30,JP-SUB,,0,0,0,,Өзіңді әшкерелеу ақымақтық.
Dialogue: 0,0:03:03.14,0:03:04.26,JP-SUB,,0,0,0,,Ақымақ деген не?
Dialogue: 0,0:03:04.52,0:03:06.22,JP-SUB,,0,0,0,,Ол өлуі мүмкін еді.
Dialogue: 0,0:03:07.80,0:03:11.18,JP-SUB,,0,0,0,,Мен ешкімнің өлгенін қаламаймын
Dialogue: 0,0:03:11.76,0:03:13.00,JP-SUB,,0,0,0,,Тағы да солай ма?
Dialogue: 0,0:03:13.76,0:03:14.82,JP-SUB,,0,0,0,,Неге сонша?
Dialogue: 0,0:03:14.82,0:03:15.70,JP-SUB,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:03:18.68,0:03:21.74,JP-SUB,,0,0,0,,Мен біреудің өлгенін қаламаймын.
Dialogue: 0,0:03:34.38,0:03:35.76,JP-SUB,,0,0,0,,Бәрің жақсысыңдар ма?
Dialogue: 0,0:03:36.10,0:03:37.06,JP-SUB,,0,0,0,,Бастық
Dialogue: 0,0:03:37.18,0:03:40.34,JP-SUB,,0,0,0,,Онизакур тобында бұлай өлетін ешкім жоқ.
Dialogue: 0,0:03:40.44,0:03:41.60,JP-SUB,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:41.84,0:03:43.06,JP-SUB,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:03:43.46,0:03:44.28,JP-SUB,,0,0,0,,Барлығы
Dialogue: 0,0:03:45.00,0:03:46.78,JP-SUB,,0,0,0,,Әйтеуір, анау ұзын шашты жігіт
Dialogue: 0,0:03:47.34,0:03:49.02,JP-SUB,,0,0,0,,Біртүрлі айлаларды қолдану
Dialogue: 0,0:03:49.70,0:03:51.46,JP-SUB,,0,0,0,,Сен кімсің?
Dialogue: 0,0:03:53.90,0:03:57.04,JP-SUB,,0,0,0,,Хитоми - электр қуаты бар экстрасенс.
Dialogue: 0,0:03:57.88,0:04:00.48,JP-SUB,,0,0,0,,Кеше мектепте пайда болған өлі заттар
Dialogue: 0,0:04:00.98,0:04:03.90,JP-SUB,,0,0,0,,Хитоми олардың денелерін бақылап отырды.
Dialogue: 0,0:04:04.72,0:04:08.44,JP-SUB,,0,0,0,,Ол да бұрынғы кодты бұзушы
Dialogue: 0,0:04:09.40,0:04:13.38,JP-SUB,,0,0,0,,Ол үш жыл бұрын көзден ғайып болды.
Dialogue: 0,0:04:13.56,0:04:14.30,JP-SUB,,0,0,0,,Өзің бар
Dialogue: 0,0:04:14.66,0:04:16.74,JP-SUB,,0,0,0,,Премьер-министр сіздің бұрынғы бастығыңыз емес пе?
Dialogue: 0,0:04:17.42,0:04:18.60,JP-SUB,,0,0,0,,Неліктен адам ұрлау керек?
Dialogue: 0,0:04:19.26,0:04:20.20,JP-SUB,,0,0,0,,Кек
Dialogue: 0,0:04:22.10,0:04:23.94,JP-SUB,,0,0,0,,Мен оның кек айтқанына сенімдімін.
Dialogue: 0,0:04:24.32,0:04:25.84,JP-SUB,,0,0,0,,Премьер-министрге өшпенділік танытқандықтан ба?
Dialogue: 0,0:04:26.16,0:04:29.12,JP-SUB,,0,0,0,,Хитоми кек сақтаса да
Dialogue: 0,0:04:29.42,0:04:30.94,JP-SUB,,0,0,0,,Егер сіз оны тазалағыңыз келсе
Dialogue: 0,0:04:30.94,0:04:33.22,JP-SUB,,0,0,0,,Оны тез өлтіріңіз.
Dialogue: 0,0:04:33.62,0:04:35.12,JP-SUB,,0,0,0,,Ұрлаусыз
Dialogue: 0,0:04:35.36,0:04:36.62,JP-SUB,,0,0,0,,Басқа мақсаттар
Dialogue: 0,0:04:37.34,0:04:38.18,JP-SUB,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:04:39.38,0:04:42.90,JP-SUB,,0,0,0,,Хитоми мырза не істемекші?
Dialogue: 0,0:04:43.88,0:04:44.70,JP-SUB,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:04:45.78,0:04:49.50,JP-SUB,,0,0,0,,Бірақ егер ол полиция бастықтары мен бандиттерді пайдаланса,
Dialogue: 0,0:04:49.50,0:04:52.08,JP-SUB,,0,0,0,,Мен олардың бірдеңе дайындап жатқанына сенімдімін.
Dialogue: 0,0:04:52.98,0:04:56.18,JP-SUB,,0,0,0,,Премьер-министрді ұрлау соңғы нүкте болуы мүмкін.
Dialogue: 0,0:04:56.74,0:04:57.60,JP-SUB,,0,0,0,,Кира мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:04:58.92,0:05:00.88,JP-SUB,,0,0,0,,Хитоми неге маған опасыздық жасады?
Dialogue: 0,0:05:01.50,0:05:02.22,JP-SUB,,0,0,0,,Ханзада сарайы
Dialogue: 0,0:05:02.94,0:05:07.18,JP-SUB,,0,0,0,,Мен осындай нәрсені жасайтын адаммен кездескім келеді.
Dialogue: 0,0:05:07.82,0:05:10.42,JP-SUB,,0,0,0,,Біз білетін бірінші нөмір енді бұл жерде жоқ.
Dialogue: 0,0:05:15.44,0:05:18.56,JP-SUB,,0,0,0,,Барлығы Хитоми-ден туралы айтып жатыр.
Dialogue: 0,0:05:19.40,0:05:22.36,JP-SUB,,0,0,0,,Хитомиді бәрі құрметтейді
Dialogue: 0,0:05:22.84,0:05:24.58,JP-SUB,,0,0,0,,Кодты бұзушылардың көшбасшысы болды
Dialogue: 0,0:05:26.24,0:05:27.44,JP-SUB,,0,0,0,,Өткеннің қандай болғанына қарамастан
Dialogue: 0,0:05:30.00,0:05:31.50,JP-SUB,,0,0,0,,Жамандыққа түскендер
Dialogue: 0,0:05:31.92,0:05:33.44,JP-SUB,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 0,0:05:33.90,0:05:36.68,JP-SUB,,0,0,0,,Бұрынғы жолдас болса да
Dialogue: 0,0:05:46.64,0:05:47.32,JP-SUB,,0,0,0,,Әпке
Dialogue: 0,0:05:48.70,0:05:50.20,JP-SUB,,0,0,0,,Бүгін мұнда ешкім жоқ
Dialogue: 0,0:05:52.64,0:05:53.34,JP-SUB,,0,0,0,,Әпке
Dialogue: 0,0:05:56.40,0:05:57.28,JP-SUB,,0,0,0,,Жақсы болды.
Dialogue: 0,0:06:02.92,0:06:04.86,JP-SUB,,0,0,0,,Жарайды, уақыт.
Dialogue: 0,0:06:06.26,0:06:08.02,JP-SUB,,0,0,0,,Сіз мұнда уайымдағандықтан келдіңіз.
Dialogue: 0,0:06:08.64,0:06:09.40,JP-SUB,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:06:10.60,0:06:12.70,JP-SUB,,0,0,0,,Мен есімде қалғаныма сене алар емеспін
Dialogue: 0,0:06:14.28,0:06:15.50,JP-SUB,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:15.82,0:06:18.20,JP-SUB,,0,0,0,,Ал сен кімсің?
Dialogue: 0,0:06:19.82,0:06:23.84,JP-SUB,,0,0,0,,Иә, ертең мен әкеммен дүкен аралауға барамын.
Dialogue: 0,0:06:24.54,0:06:26.16,JP-SUB,,0,0,0,,С-Сіздерге не керек, жігіттер?
Dialogue: 0,0:06:28.90,0:06:30.54,JP-SUB,,0,0,0,,Мен сені міндетті түрде құтқарамын.
Dialogue: 0,0:06:31.20,0:06:32.90,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:06:33.70,0:06:34.82,JP-SUB,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:06:47.30,0:06:50.58,JP-SUB,,0,0,0,,Мен біреудің өлгенін қаламаймын.
Dialogue: 0,0:06:54.76,0:06:56.02,JP-SUB,,0,0,0,,Неге сонша?
Dialogue: 0,0:06:57.16,0:06:58.72,JP-SUB,,0,0,0,,Тағдыр ма деп ойлаймын
Dialogue: 0,0:06:59.78,0:07:03.02,JP-SUB,,0,0,0,,Аа, мен қорыққандай болып шықты.
Dialogue: 0,0:07:06.80,0:07:07.40,JP-SUB,,0,0,0,,Бірақ
Dialogue: 0,0:07:08.34,0:07:10.44,JP-SUB,,0,0,0,,Ештеңе болмасын.
Dialogue: 0,0:07:10.66,0:07:12.80,JP-SUB,,0,0,0,,Сакура-чан біздің қызымыз
Dialogue: 0,0:07:13.48,0:07:14.10,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:07:20.44,0:07:23.08,JP-SUB,,0,0,0,,Бастық, дәрігер келді.
Dialogue: 0,0:07:23.36,0:07:24.66,JP-SUB,,0,0,0,,(Джозеф) Бұл Спидвагон қорының геликоптері.
Dialogue: 0,0:07:25.18,0:07:26.14,JP-SUB,,0,0,0,,Сәлем беруім керек.
Dialogue: 0,0:07:50.44,0:07:53.74,JP-SUB,,0,0,0,,Бұл
Dialogue: 0,0:07:54.28,0:07:56.98,JP-SUB,,0,0,0,,Әке, дәрігер
Dialogue: 0,0:07:57.68,0:07:59.76,JP-SUB,,0,0,0,,Сол Оками
Dialogue: 0,0:08:00.52,0:08:02.02,JP-SUB,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:03.54,0:08:06.28,JP-SUB,,0,0,0,,А, сен альбомды қарап отырсың.
Dialogue: 0,0:08:06.92,0:08:08.20,JP-SUB,,0,0,0,,Сондай ностальгиялық
Dialogue: 0,0:08:09.54,0:08:10.88,JP-SUB,,0,0,0,,Бұл не?
Dialogue: 0,0:08:11.70,0:08:12.42,JP-SUB,,0,0,0,,Саусақтар айқастырылды
Dialogue: 0,0:08:13.62,0:08:14.64,JP-SUB,,0,0,0,,Саусақ кесу емес
Dialogue: 0,0:08:15.18,0:08:17.28,JP-SUB,,0,0,0,,Саусақтарыңызды кесу азапты емес пе?
Dialogue: 0,0:08:17.60,0:08:19.40,JP-SUB,,0,0,0,,Одан гөрі топтастыру жақсы.
Dialogue: 0,0:08:20.52,0:08:23.14,JP-SUB,,0,0,0,,Саусақтарыңызды осылай ұстау арқылы
Dialogue: 0,0:08:23.32,0:08:24.92,JP-SUB,,0,0,0,,Бір-бірінің энергиясын алмастыру
Dialogue: 0,0:08:24.92,0:08:26.36,JP-SUB,,0,0,0,,Бұл қол алысу тәсілі.
Dialogue: 0,0:08:28.04,0:08:29.16,JP-SUB,,0,0,0,,Бала кезінен
Dialogue: 0,0:08:29.40,0:08:30.74,JP-SUB,,0,0,0,,Әке мен Ана
Dialogue: 0,0:08:31.04,0:08:32.36,JP-SUB,,0,0,0,,Үйдегілердің бәрі және мен
Dialogue: 0,0:08:32.56,0:08:35.30,JP-SUB,,0,0,0,,Саусақтарымызды талай рет түйістіріп, бір-бірімізбен қоштастық.
Dialogue: 0,0:08:36.16,0:08:38.02,JP-SUB,,0,0,0,,Бұл Сакуракоджи отбасының жолы.
Dialogue: 0,0:08:44.14,0:08:45.04,JP-SUB,,0,0,0,,Солай ма?
Dialogue: 0,0:08:45.88,0:08:48.26,JP-SUB,,0,0,0,,Сіз өз отбасыңызды жақсы көресіз.
Dialogue: 0,0:08:48.96,0:08:51.52,JP-SUB,,0,0,0,,Сіз де, ата-анаңыз да
Dialogue: 0,0:08:53.74,0:08:54.62,JP-SUB,,0,0,0,,Сол себепті
Dialogue: 0,0:08:54.88,0:08:56.68,JP-SUB,,0,0,0,,Менде туған кездегі фотолар жоқ.
Dialogue: 0,0:08:57.96,0:09:01.60,JP-SUB,,0,0,0,,Сіз оны суретке түсіре алмайтындай қатыгез болды ма?
Dialogue: 0,0:09:03.76,0:09:05.66,JP-SUB,,0,0,0,,О, әрине.
Dialogue: 0,0:09:06.30,0:09:08.28,JP-SUB,,0,0,0,,Өйткені мен асырап алған баламын.
Dialogue: 0,0:09:16.52,0:09:17.30,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:09:19.72,0:09:21.02,JP-SUB,,0,0,0,,Менің ойымша, бұл жақсы
Dialogue: 0,0:09:23.60,0:09:26.90,JP-SUB,,0,0,0,,Сакура біздің биологиялық қызымыз емес.
Dialogue: 0,0:09:28.60,0:09:31.78,JP-SUB,,0,0,0,,Баяғыда ол басты қақпаның алдына қойылған.
Dialogue: 0,0:09:32.50,0:09:35.06,JP-SUB,,0,0,0,,Қанға шомылған сұмдық күйде
Dialogue: 0,0:09:35.74,0:09:36.42,JP-SUB,,0,0,0,,Қанның қайтарылуы
Dialogue: 0,0:09:36.76,0:09:39.44,JP-SUB,,0,0,0,,Иә, бақытымызға орай, зардап шеккендер жоқ.
Dialogue: 0,0:09:42.26,0:09:45.68,JP-SUB,,0,0,0,,Бірақ ол көп мөлшерде қанға шомылды.
Dialogue: 0,0:09:48.10,0:09:49.80,JP-SUB,,0,0,0,,Сол қорқынышты көрініс
Dialogue: 0,0:09:50.48,0:09:53.46,JP-SUB,,0,0,0,,Сіз қорқынышты оқиғаны бастан өткерген болуыңыз керек.
Dialogue: 0,0:09:53.86,0:09:55.10,JP-SUB,,0,0,0,,Соған әкелді
Dialogue: 0,0:09:55.52,0:10:00.08,JP-SUB,,0,0,0,,Сакура адамдардың өлімін жоққа шығару үшін келген болуы мүмкін.
Dialogue: 0,0:10:04.20,0:10:06.02,JP-SUB,,0,0,0,,Сол күннен бері мен шие гүлі болдым
Dialogue: 0,0:10:06.84,0:10:09.84,JP-SUB,,0,0,0,,Қайтадан апат болатын күн келе ме деп қорқамын.
Dialogue: 0,0:10:10.06,0:10:11.26,JP-SUB,,0,0,0,,Мені алаңдатты
Dialogue: 0,0:10:11.64,0:10:13.86,JP-SUB,,0,0,0,,Мүмкін болса, мен сенің бақытты өмір сүргеніңді қалаймын.
Dialogue: 0,0:10:14.80,0:10:17.46,JP-SUB,,0,0,0,,Бірақ олай емес сияқты.
Dialogue: 0,0:10:19.82,0:10:23.60,JP-SUB,,0,0,0,,Шынымды айтсам, мен сіздің күштеріңізді білмеймін.
Dialogue: 0,0:10:24.32,0:10:26.28,JP-SUB,,0,0,0,,Бірақ мен сенің шие гүлдерін қорғағаныңды қалаймын.
Dialogue: 0,0:10:26.66,0:10:28.90,JP-SUB,,0,0,0,,Сол баланы апаттан құтқаруыңды қалаймын.
Dialogue: 0,0:10:29.20,0:10:29.68,JP-SUB,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:10:41.42,0:10:42.92,JP-SUB,,0,0,0,,Донай шиден No5
Dialogue: 0,0:10:44.76,0:10:46.54,JP-SUB,,0,0,0,,Мен Хитоми-сан туралы ойладым.
Dialogue: 0,0:10:47.62,0:10:49.52,JP-SUB,,0,0,0,,Біз жақсы дос болдық, бесінші нөмір.
Dialogue: 0,0:10:49.88,0:10:50.78,JP-SUB,,0,0,0,,Юки - бұл
Dialogue: 0,0:10:51.32,0:10:54.36,JP-SUB,,0,0,0,,Маған не қаласа, соны істе деді.
Dialogue: 0,0:10:54.62,0:10:57.26,JP-SUB,,0,0,0,,Бұл оған сенімді болғанын білдірсе керек.
Dialogue: 0,0:10:57.98,0:10:59.54,JP-SUB,,0,0,0,,Солай ма?
Dialogue: 0,0:11:00.20,0:11:03.58,JP-SUB,,0,0,0,,Хитоми мырза мұны әрқашан анық айтудың қажеті жоқ.
Dialogue: 0,0:11:03.62,0:11:04.82,JP-SUB,,0,0,0,,Мұны түсіну қиын.
Dialogue: 0,0:11:05.42,0:11:06.84,JP-SUB,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:11:07.58,0:11:09.46,JP-SUB,,0,0,0,,Бес саны туралы бірдеңе айттыңыз ба?
Dialogue: 0,0:11:11.36,0:11:15.32,JP-SUB,,0,0,0,,Кішкентай кезімде отбасым апаттан қайтыс болды.
Dialogue: 0,0:11:16.28,0:11:19.06,JP-SUB,,0,0,0,,Бір ғана адамның аман қалғаны ауыр болды.
Dialogue: 0,0:11:19.88,0:11:21.24,JP-SUB,,0,0,0,,Дөрекі болған кездер болды.
Dialogue: 0,0:11:21.84,0:11:24.60,JP-SUB,,0,0,0,,Бірақ мен Хитоми мырзамен кездескенімде ол маған айтты
Dialogue: 0,0:11:24.88,0:11:25.40,JP-SUB,,0,0,0,,Көрініс
Dialogue: 0,0:11:26.36,0:11:29.10,JP-SUB,,0,0,0,,«Егер менде дөрекі болуға уақытым болса, мен төсекке жатуым керек еді».
Dialogue: 0,0:11:29.92,0:11:30.40,JP-SUB,,0,0,0,,Ханя
Dialogue: 0,0:11:31.06,0:11:35.32,JP-SUB,,0,0,0,,Хитоми мырза бос еместігі сонша, ұйықтауға уақыты жоқ деп шағымданды.
Dialogue: 0,0:11:36.24,0:11:38.28,JP-SUB,,0,0,0,,Мен өзімді дөрекі сезінгенім сонша, ұйықтау уақытымды қысқартты.
Dialogue: 0,0:11:38.82,0:11:40.14,JP-SUB,,0,0,0,,Мен бұған сенбеймін
Dialogue: 0,0:11:42.96,0:11:45.36,JP-SUB,,0,0,0,,Мұны естігенде тітіркендіретін нәрсе бар ма?
Dialogue: 0,0:11:45.36,0:11:47.10,JP-SUB,,0,0,0,,Бұл күлкілі болып барады.
Dialogue: 0,0:11:47.60,0:11:49.64,JP-SUB,,0,0,0,,Бұл ең ықтимал сияқты.
Dialogue: 0,0:11:50.68,0:11:53.14,JP-SUB,,0,0,0,,Оның қаншалықты өзгеше екені таңқаларлық.
Dialogue: 0,0:11:54.06,0:11:54.88,JP-SUB,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:07.64,0:12:08.34,JP-SUB,,0,0,0,,(Серо) Бастамас бұрын мен бұл жай ғана әуесқой деңгейде болады деп уайымдадым—
Dialogue: 0,0:12:09.88,0:12:10.94,JP-SUB,,0,0,0,,Мен ұйықтап қалдым
Dialogue: 0,0:12:14.62,0:12:16.72,JP-SUB,,0,0,0,,Барлығына қиындық туғыздым.
Dialogue: 0,0:12:18.24,0:12:20.10,JP-SUB,,0,0,0,,Менің үйіме келу туралы не айтасыз?
Dialogue: 0,0:12:22.42,0:12:24.04,JP-SUB,,0,0,0,,Менің ақымақ
Dialogue: 0,0:12:24.04,0:12:25.64,JP-SUB,,0,0,0,,Жақсырақ жол бар
Dialogue: 0,0:12:25.90,0:12:28.10,JP-SUB,,0,0,0,,Бұл мүлдем қызықсыз.
Dialogue: 0,0:12:28.90,0:12:29.62,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:12:30.20,0:12:31.86,JP-SUB,,0,0,0,,Нені сирек кездесетін түр деп атауға болады
Dialogue: 0,0:12:32.12,0:12:33.46,JP-SUB,,0,0,0,,Басқа адамдар сияқты депрессияға ұшырайсыз ба?
Dialogue: 0,0:12:33.80,0:12:34.60,JP-SUB,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,0:12:36.46,0:12:37.68,JP-SUB,,0,0,0,,депрессия және т.б.
Dialogue: 0,0:12:38.06,0:12:39.28,JP-SUB,,0,0,0,,Күлкілі
Dialogue: 0,0:12:39.66,0:12:40.78,JP-SUB,,0,0,0,,Бастапқыда
Dialogue: 0,0:12:41.14,0:12:43.26,JP-SUB,,0,0,0,,Себебі мен адасып қалдым.
Dialogue: 0,0:12:44.18,0:12:45.98,JP-SUB,,0,0,0,,Мен өзімді төмен сезінсем жақсы.
Dialogue: 0,0:12:47.02,0:12:49.98,JP-SUB,,0,0,0,,Сакуракоджи мырзаға не үшін алаңдау керек?
Dialogue: 0,0:12:51.12,0:12:52.90,JP-SUB,,0,0,0,,О, сен сондай бастық екенсің.
Dialogue: 0,0:12:53.82,0:12:55.76,JP-SUB,,0,0,0,,Көбінесе күйзеліске ұшырасаңыз
Dialogue: 0,0:12:56.68,0:13:00.18,JP-SUB,,0,0,0,,Сізге сенгісі келетін адамдарды мазақ етесіз.
Dialogue: 0,0:13:01.32,0:13:03.82,JP-SUB,,0,0,0,,Бала дұрыс айтады, Сакура ханым.
Dialogue: 0,0:13:04.14,0:13:07.54,JP-SUB,,0,0,0,,Сакура ханым, мұндай жарақат жоқ.
Dialogue: 0,0:13:07.92,0:13:09.88,JP-SUB,,0,0,0,,Зұлым адамның қуғанына сәттілік.
Dialogue: 0,0:13:10.04,0:13:13.16,JP-SUB,,0,0,0,,Мені үйге әкелмегенің жаман.
Dialogue: 0,0:13:13.74,0:13:14.44,JP-SUB,,0,0,0,,Барлығы
Dialogue: 0,0:13:15.04,0:13:17.88,JP-SUB,,0,0,0,,Келесі жолы әлгі бейбақ келсе, мен одан кек аламын.
Dialogue: 0,0:13:18.84,0:13:19.60,JP-SUB,,0,0,0,,Сүйясен
Dialogue: 0,0:13:20.22,0:13:21.72,JP-SUB,,0,0,0,,Менің табаным болса да
Dialogue: 0,0:13:22.02,0:13:24.36,JP-SUB,,0,0,0,,Мен Сакура мисске қауіп төндірдім.
Dialogue: 0,0:13:24.82,0:13:26.76,JP-SUB,,0,0,0,,Сіздің қауіпсіз болғаныңызға өте қуаныштымын.
Dialogue: 0,0:13:27.56,0:13:29.28,JP-SUB,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:13:29.64,0:13:32.62,JP-SUB,,0,0,0,,Мен осылай қарасам, бәрі уайымдайды.
Dialogue: 0,0:13:33.98,0:13:34.60,JP-SUB,,0,0,0,,Ессіздік
Dialogue: 0,0:13:34.84,0:13:36.60,JP-SUB,,0,0,0,,Тренингтен кем болған мен едім.
Dialogue: 0,0:13:37.18,0:13:40.48,JP-SUB,,0,0,0,,Осындай сұлудың қолына түсу – надандықтың шыңы.
Dialogue: 0,0:13:40.90,0:13:43.20,JP-SUB,,0,0,0,,Дайсуке-сан, мені үйретші.
Dialogue: 0,0:13:43.44,0:13:44.78,JP-SUB,,0,0,0,,Дәл солай, ол жоғалады.
Dialogue: 0,0:13:50.74,0:13:53.16,JP-SUB,,0,0,0,,Біз де солай жасайтынбыз.
Dialogue: 0,0:13:53.54,0:13:54.60,JP-SUB,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:54.88,0:13:56.76,JP-SUB,,0,0,0,,Хитоми-санға назар аудару
Dialogue: 0,0:13:57.18,0:14:00.40,JP-SUB,,0,0,0,,Мен сол кездегідей қайтадан бірге төбелескім келеді.
Dialogue: 0,0:14:00.92,0:14:02.04,JP-SUB,,0,0,0,,Мен күресе аламын
Dialogue: 0,0:14:02.92,0:14:05.72,JP-SUB,,0,0,0,,Ханзада таңдануға сене ме?
Dialogue: 0,0:14:06.08,0:14:06.88,JP-SUB,,0,0,0,,Ол тез.
Dialogue: 0,0:14:07.26,0:14:08.84,JP-SUB,,0,0,0,,Оның себебі бар
Dialogue: 0,0:14:09.12,0:14:09.94,JP-SUB,,0,0,0,,Сейана
Dialogue: 0,0:14:10.34,0:14:13.00,JP-SUB,,0,0,0,,No1 дәл қазір ол басқа адам сияқты болды.
Dialogue: 0,0:14:13.74,0:14:14.66,JP-SUB,,0,0,0,,Бірдеңе болды.
Dialogue: 0,0:14:15.48,0:14:16.16,JP-SUB,,0,0,0,,Барлығы
Dialogue: 0,0:14:17.64,0:14:18.60,JP-SUB,,0,0,0,,Бұл қоқыс
Dialogue: 0,0:14:19.70,0:14:22.10,JP-SUB,,0,0,0,,Хитомиге бірдеңе болды ма маған бәрібір.
Dialogue: 0,0:14:22.70,0:14:23.32,JP-SUB,,0,0,0,,Токи мырза
Dialogue: 0,0:14:23.92,0:14:28.26,JP-SUB,,0,0,0,,Бұл өте тітіркендіргіш, мен оған бір соққы бермесем, оны тоқтата алмаймын.
Dialogue: 0,0:14:29.02,0:14:30.08,JP-SUB,,0,0,0,,Бұл гравюра
Dialogue: 0,0:14:30.48,0:14:32.64,JP-SUB,,0,0,0,,Мен әлгі бейбақты есін жиамын.
Dialogue: 0,0:14:40.72,0:14:42.18,JP-SUB,,0,0,0,,Егер сіз мұны шешсеңіз, бәрі.
Dialogue: 0,0:14:42.44,0:14:45.54,JP-SUB,,0,0,0,,Хитоми мен премьер-министрдің тұрған жерін бөлек іздеп көрейік.
Dialogue: 0,0:14:46.50,0:14:48.92,JP-SUB,,0,0,0,,Барайық уақыт!
Dialogue: 0,0:15:21.20,0:15:22.68,JP-SUB,,0,0,0,,Керемет ештеңе жоқ.
Dialogue: 0,0:15:23.54,0:15:26.06,JP-SUB,,0,0,0,,Артында қалған заттарды Еден басқарады.
Dialogue: 0,0:15:26.62,0:15:29.74,JP-SUB,,0,0,0,,Менің ойымша, ештеңе қалмады.
Dialogue: 0,0:15:34.44,0:15:35.12,JP-SUB,,0,0,0,,Бұл не, Юки?
Dialogue: 0,0:15:37.28,0:15:39.68,JP-SUB,,0,0,0,,Жоқ, мұнда да түсінік жоқ.
Dialogue: 0,0:15:41.60,0:15:42.22,JP-SUB,,0,0,0,,Түсіндім
Dialogue: 0,0:15:44.16,0:15:44.74,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:15:45.38,0:15:47.74,JP-SUB,,0,0,0,,Хитоми-доно премьер-министрді неліктен ұрлады?
Dialogue: 0,0:15:48.86,0:15:50.32,JP-SUB,,0,0,0,,Егер сіз біреуді бұрыннан танитын болсаңыз
Dialogue: 0,0:15:50.64,0:15:52.74,JP-SUB,,0,0,0,,Ойға бір нәрсе келеді ме?
Dialogue: 0,0:15:53.50,0:15:54.18,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:15:55.26,0:15:56.62,JP-SUB,,0,0,0,,Сіз Хитоми-ден туралы айтып отырсыз ба?
Dialogue: 0,0:15:56.62,0:15:57.88,JP-SUB,,0,0,0,,Оның саған еш қатысы жоқ.
Dialogue: 0,0:16:00.86,0:16:01.60,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:16:15.94,0:16:16.50,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:16:17.76,0:16:18.80,JP-SUB,,0,0,0,,Сол жерде
Dialogue: 0,0:16:18.88,0:16:19.56,JP-SUB,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:16:19.56,0:16:20.62,JP-SUB,,0,0,0,,Кой Кой
Dialogue: 0,0:16:22.02,0:16:22.58,JP-SUB,,0,0,0,,Өтінемін
Dialogue: 0,0:16:26.08,0:16:28.38,JP-SUB,,0,0,0,,Отырыңызшы, Канда мырза.
Dialogue: 0,0:16:32.20,0:16:33.32,JP-SUB,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:33.72,0:16:36.44,JP-SUB,,0,0,0,,Сирек кездесетін түрлердің күші сен ойлағаннан да көп.
Dialogue: 0,0:16:37.08,0:16:39.10,JP-SUB,,0,0,0,,Сакуракоджи-сан – сирек кездесетін түр
Dialogue: 0,0:16:39.56,0:16:41.96,JP-SUB,,0,0,0,,Маған неге алдын ала айтпадың?
Dialogue: 0,0:16:42.54,0:16:45.30,JP-SUB,,0,0,0,,Сіз бастапқыда Хитомиге бағынышты болдыңыз.
Dialogue: 0,0:16:45.88,0:16:48.74,JP-SUB,,0,0,0,,Мен ақпараттың ағып кету қаупінен аулақ болғым келді.
Dialogue: 0,0:16:50.20,0:16:52.02,JP-SUB,,0,0,0,,Өйткені менің Хитоми екеуіңе қатысым бар.
Dialogue: 0,0:16:52.44,0:16:53.84,JP-SUB,,0,0,0,,Қарым-қатынастағы сәйкессіздіктер
Dialogue: 0,0:16:54.14,0:16:57.42,JP-SUB,,0,0,0,,Огами Сакуракоджи Сакураны өртеп өлтірмек болды.
Dialogue: 0,0:16:57.64,0:16:59.20,JP-SUB,,0,0,0,,Біз де қате есептедік.
Dialogue: 0,0:16:59.82,0:17:01.74,JP-SUB,,0,0,0,,Бұл сирек кездесетін түр.
Dialogue: 0,0:17:02.06,0:17:05.54,JP-SUB,,0,0,0,,Оками сізге зиян тигізеді деп уайымдаудың қажеті жоқ деп ойладым.
Dialogue: 0,0:17:06.50,0:17:08.32,JP-SUB,,0,0,0,,Маған күмәндандың ба?
Dialogue: 0,0:17:09.08,0:17:11.90,JP-SUB,,0,0,0,,Хитомимен сөйлесіп жатқаныңызды білу үшін мен сізді бақылаймын.
Dialogue: 0,0:17:12.20,0:17:14.20,JP-SUB,,0,0,0,,Бұл біздің жұмысымыз болды.
Dialogue: 0,0:17:14.70,0:17:17.24,JP-SUB,,0,0,0,,Хитоми менімен байланысады деп ойладым.
Dialogue: 0,0:17:17.72,0:17:19.22,JP-SUB,,0,0,0,,Мен қателескен шығармын.
Dialogue: 0,0:17:20.02,0:17:23.50,JP-SUB,,0,0,0,,Мен Ogami Zero агентімін.
Dialogue: 0,0:17:24.00,0:17:25.56,JP-SUB,,0,0,0,,Оның адамдардың көруіне еш қатысы жоқ.
Dialogue: 0,0:17:25.84,0:17:28.30,JP-SUB,,0,0,0,,Олай болса, Хитомиден құтыла аламыз ба?
Dialogue: 0,0:17:32.60,0:17:33.34,JP-SUB,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:17:34.98,0:17:36.88,JP-SUB,,0,0,0,,Агенттің мақтанышы туралы
Dialogue: 0,0:17:39.00,0:17:40.72,JP-SUB,,0,0,0,,Хитоми іздеген әлем
Dialogue: 0,0:17:41.50,0:17:43.52,JP-SUB,,0,0,0,,Премьер-министр қалаған әлем
Dialogue: 0,0:17:45.32,0:17:46.48,JP-SUB,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:47.66,0:17:50.10,JP-SUB,,0,0,0,,Түсіндім, Эйс.
Dialogue: 0,0:18:01.66,0:18:04.04,JP-SUB,,0,0,0,,Сіз бұл адам туралы қандай да бір түсінік алдыңыз ба?
Dialogue: 0,0:18:04.78,0:18:07.02,JP-SUB,,0,0,0,,Жоқ, мен ештеңе таба алмаймын.
Dialogue: 0,0:18:07.38,0:18:10.22,JP-SUB,,0,0,0,,Полиция бастығы мен якуза жігіттерін өлтірген кім?
Dialogue: 0,0:18:10.22,0:18:11.74,JP-SUB,,0,0,0,,Сен өшпенділікпен шықтың.
Dialogue: 0,0:18:12.16,0:18:12.86,JP-SUB,,0,0,0,,Ресми резиденция болып табылады
Dialogue: 0,0:18:13.42,0:18:15.18,JP-SUB,,0,0,0,,Сіз құтқару үшін жұмыс істеп жатырсыз ба?
Dialogue: 0,0:18:16.12,0:18:17.28,JP-SUB,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:18:20.98,0:18:21.44,JP-SUB,,0,0,0,,Хайке
Dialogue: 0,0:18:22.48,0:18:24.96,JP-SUB,,0,0,0,,Бұл сіз үшін өте немқұрайлы, солай емес пе?
Dialogue: 0,0:18:25.86,0:18:26.58,JP-SUB,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:18:27.62,0:18:29.64,JP-SUB,,0,0,0,,Код ажыратқыштарды жинау арқылы
Dialogue: 0,0:18:30.22,0:18:33.08,JP-SUB,,0,0,0,,Ол премьер-министрдің штаты қысқа болатынын білуі керек еді.
Dialogue: 0,0:18:33.82,0:18:36.48,JP-SUB,,0,0,0,,Саған телефон соққан мен емес едім.
Dialogue: 0,0:18:37.08,0:18:37.78,JP-SUB,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:38.48,0:18:42.06,JP-SUB,,0,0,0,,Юкиді жылжыту сіздің шешіміңіз болуы мүмкін.
Dialogue: 0,0:18:43.46,0:18:45.38,JP-SUB,,0,0,0,,Сіз маған күмәнданасыз ба?
Dialogue: 0,0:18:48.50,0:18:52.10,JP-SUB,,0,0,0,,Басыңызды мен күткеннен де көп пайдаланасыз.
Dialogue: 0,0:18:55.16,0:18:57.14,JP-SUB,,0,0,0,,Елестетейік
Dialogue: 0,0:18:57.54,0:18:58.32,JP-SUB,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:19:00.32,0:19:00.96,JP-SUB,,0,0,0,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:19:05.62,0:19:07.08,JP-SUB,,0,0,0,,Бұл басталды.
Dialogue: 0,0:19:07.08,0:19:07.78,JP-SUB,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:19:08.54,0:19:09.90,JP-SUB,,0,0,0,,Хитоми жоспары
Dialogue: 0,0:19:10.54,0:19:12.02,JP-SUB,,0,0,0,,Бұл бастама
Dialogue: 0,0:19:35.22,0:19:35.92,JP-SUB,,0,0,0,,№ 5
Dialogue: 0,0:19:38.12,0:19:39.38,JP-SUB,,0,0,0,,Ол қайтадан жарылып жатыр.
Dialogue: 0,0:19:40.70,0:19:41.98,JP-SUB,,0,0,0,,Өте жақсы
Dialogue: 0,0:19:42.26,0:19:44.12,JP-SUB,,0,0,0,,Көлеңкелі табиғаттан тыс қабілет күткендей
Dialogue: 0,0:19:44.80,0:19:46.16,JP-SUB,,0,0,0,,Код ажыратқыштың ішінде
Dialogue: 0,0:19:46.16,0:19:49.34,JP-SUB,,0,0,0,,Тек өмірді барлық шабуылдардан қорғайды
Dialogue: 0,0:19:49.34,0:19:51.34,JP-SUB,,0,0,0,,Қара қамқоршы құдай
Dialogue: 0,0:19:51.90,0:19:53.58,JP-SUB,,0,0,0,,Сіз нені айтып тұрсыз, Хайке?
Dialogue: 0,0:19:53.90,0:19:55.00,JP-SUB,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:19:55.10,0:19:57.84,JP-SUB,,0,0,0,,Хитомиге арналған жоспар басталды.
Dialogue: 0,0:19:58.36,0:19:59.98,JP-SUB,,0,0,0,,Сонымен ханзада
Dialogue: 0,0:20:00.76,0:20:03.50,JP-SUB,,0,0,0,,Сізден осы жерден кетуді сұрайды.
Dialogue: 0,0:20:03.50,0:20:04.02,JP-SUB,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:20:04.02,0:20:06.24,JP-SUB,,0,0,0,,Біз қанша қорғансақ та
Dialogue: 0,0:20:06.40,0:20:10.80,JP-SUB,,0,0,0,,Сіздің қазіргі күйіңізде сіз менің шабуылымнан құтыла алмайсыз.
Dialogue: 0,0:20:13.60,0:20:17.02,JP-SUB,,0,0,0,,№ 5
Dialogue: 0,0:20:23.08,0:20:24.68,JP-SUB,,0,0,0,,Өрт?
Dialogue: 0,0:20:27.68,0:20:30.42,JP-SUB,,0,0,0,,Оками, не болды?
Dialogue: 0,0:20:34.06,0:20:35.06,JP-SUB,,0,0,0,,Хайке Сенпай
Dialogue: 0,0:20:35.94,0:20:37.10,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:20:37.82,0:20:39.82,JP-SUB,,0,0,0,,Огами-кун сені іздеді.
Dialogue: 0,0:20:40.44,0:20:41.10,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:20:41.80,0:20:44.60,JP-SUB,,0,0,0,,Сізді адамдар нысанаға алады.
Dialogue: 0,0:20:45.50,0:20:47.94,JP-SUB,,0,0,0,,Менімен бірге келіңізші.
Dialogue: 0,0:20:49.50,0:20:50.52,JP-SUB,,0,0,0,,Эй-эй, эй-эй
Dialogue: 0,0:20:52.16,0:20:53.74,JP-SUB,,0,0,0,,Бұл құпия база.
Dialogue: 0,0:20:54.52,0:20:57.28,JP-SUB,,0,0,0,,О, бұл кодты бұзушының құпия базасы ма?
Dialogue: 0,0:20:57.66,0:20:59.04,JP-SUB,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:21:00.88,0:21:01.74,JP-SUB,,0,0,0,,Қараңғы, солай емес пе?
Dialogue: 0,0:21:02.62,0:21:03.98,JP-SUB,,0,0,0,,Жарық жоқ па?
Dialogue: 0,0:21:20.90,0:21:22.08,JP-SUB,,0,0,0,,Премьер-министр Фудзивара
Dialogue: 0,0:21:22.34,0:21:24.42,JP-SUB,,0,0,0,,Нені айтып тұрсың, Хейке-сенпай?
Dialogue: 0,0:21:25.84,0:21:28.34,JP-SUB,,0,0,0,,Уәде бойынша мен сендерге сирек кездесетін түрді әкелдім.
Dialogue: 0,0:21:28.72,0:21:29.48,JP-SUB,,0,0,0,,Эйс
Dialogue: 0,0:21:30.42,0:21:33.46,JP-SUB,,0,0,0,,Енді сіз мені өз тобыңызға қоса аласыз.
Dialogue: 0,0:21:36.60,0:21:38.92,JP-SUB,,0,0,0,,Не айтып тұрсың, Хейке-сенпай?
Dialogue: 0,0:21:38.92,0:21:39.82,JP-SUB,,0,0,0,,Бұл жігіт
Dialogue: 0,0:21:40.54,0:21:42.80,JP-SUB,,0,0,0,,Мен кодты бұзушыға опасыздық жасадым
Dialogue: 0,0:21:42.98,0:21:44.82,JP-SUB,,0,0,0,,Адамдардың алдында тұруды жөн көрдім.
Dialogue: 0,0:21:45.30,0:21:47.56,JP-SUB,,0,0,0,,Сол мақсатқа сен де сыйсың.
Dialogue: 0,0:21:48.28,0:21:50.34,JP-SUB,,0,0,0,,Мені кепілге алуыңызды өтінемін.
Dialogue: 0,0:21:50.70,0:21:52.54,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:21:56.06,0:21:58.50,ED JP-B,,0,0,0,,Сен де бір күні түсінесің
Dialogue: 0,0:21:58.50,0:22:00.91,ED JP-B,,0,0,0,,Ақ қарға қайда барады
Dialogue: 0,0:22:00.91,0:22:03.59,ED JP-B,,0,0,0,,Ешкімді танымай ұшамыз
Dialogue: 0,0:22:03.59,0:22:06.23,ED JP-B,,0,0,0,,Гүлденген қала
Dialogue: 0,0:22:17.01,0:22:21.14,ED JP-G,,0,0,0,,Тек өмір сүруге себеп іздеу
Dialogue: 0,0:22:21.14,0:22:23.35,ED JP-G,,0,0,0,,Менің бос өзім
Dialogue: 0,0:22:23.35,0:22:26.33,ED JP-G,,0,0,0,,Өйткені бұл ұят
Dialogue: 0,0:22:26.61,0:22:31.45,ED JP-G,,0,0,0,,Біз әлем белгілеген ережелерді ұстанамыз
Dialogue: 0,0:22:31.45,0:22:36.13,ED JP-G,,0,0,0,,Жай ғана беріліңіз және күліңіз.
Dialogue: 0,0:22:37.14,0:22:41.59,ED JP-B,,0,0,0,,Жалаңаш, Түйсіктерім мені алып кеткендей
Dialogue: 0,0:22:41.77,0:22:45.82,ED JP-B,,0,0,0,,Көзімнен қашқан шындық
Dialogue: 0,0:22:45.87,0:22:48.28,ED JP-B,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:22:48.28,0:22:50.39,ED JP-B,,0,0,0,,Шешім қабылданды
Dialogue: 0,0:22:50.39,0:22:55.26,ED JP-B,,0,0,0,,Қара киімдеріңді тастап, тұрыңдар.
Dialogue: 0,0:22:55.51,0:22:57.75,ED JP-B,,0,0,0,,Таза тілек
Dialogue: 0,0:22:57.75,0:23:01.78,ED JP-B,,0,0,0,,Қанатымыз енді жоғалды
Dialogue: 0,0:23:01.78,0:23:04.71,ED JP-B,,0,0,0,,Оны сілкіп таста да, қанатыңды ат
Dialogue: 0,0:23:04.71,0:23:07.07,ED JP-B,,0,0,0,,Қорықпа
Dialogue: 0,0:23:07.19,0:23:12.54,ED JP-B,,0,0,0,,Жауап қараңғылықтан тыс болса
Dialogue: 0,0:23:25.80,0:23:27.08,JP-SUB,,0,0,0,,Қайғы оғы
Dialogue: 0,0:23:27.08,0:23:28.36,JP-SUB,,0,0,0,,Күлдіргі шам
Dialogue: 0,0:23:28.52,0:23:30.60,JP-SUB,,0,0,0,,Және қызаруға жеткілікті шешім қабылдады
Dialogue: 0,0:23:31.18,0:23:33.44,JP-SUB,,0,0,0,,Келесі Code Breaker 9-эпизод
Dialogue: 0,0:23:33.44,0:23:34.58,JP-SUB,,0,0,0,,Тоқтатылған уақыт
Dialogue: 0,0:23:35.18,0:23:36.08,JP-SUB,,0,0,0,,Көк жалын
Dialogue: 0,0:23:36.32,0:23:37.88,JP-SUB,,0,0,0,,Сатқындықтың қараңғылығын нұрландыр
Dialogue: 0,0:23:39.38,0:23:45.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory