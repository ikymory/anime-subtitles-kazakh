Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.76,0:00:15.64,OP JP,,0,0,0,,Неліктен жұмбақ шешу керек
Dialogue: 0,0:00:15.93,0:00:19.04,OP JP,,0,0,0,,Соңғы бөлім
Dialogue: 0,0:00:19.19,0:00:23.04,OP JP,,0,0,0,,Сіз іздеген жерде емес
Dialogue: 0,0:00:23.37,0:00:26.32,OP JP,,0,0,0,,Қорқыныш сезіміне бой алдыру
Dialogue: 0,0:00:26.45,0:00:29.98,OP JP,,0,0,0,,Айнымас жойылуға
Dialogue: 0,0:00:30.18,0:00:33.63,OP JP,,0,0,0,,Сенімсіз өзін-өзі бағалау
Dialogue: 0,0:00:34.00,0:00:37.48,OP JP,,0,0,0,,тірі қал Мен жете алмаймын
Dialogue: 0,0:00:37.76,0:00:43.45,OP JP,,0,0,0,,Жасырын естеліктердің кейінгі бейнесінде
Dialogue: 0,0:00:43.95,0:00:48.12,OP JP,,0,0,0,,Шексіз ҚАРА ҰЯТТЫ босатыңыз
Dialogue: 0,0:00:48.37,0:00:51.85,OP JP,,0,0,0,,Осы нәзік дүниенің соңы
Dialogue: 0,0:00:52.02,0:00:56.20,OP JP,,0,0,0,,Ұмытқан тынысым - үнсіздік
Dialogue: 0,0:00:56.20,0:00:59.85,OP JP,,0,0,0,,Көз алдымда арам тарады
Dialogue: 0,0:00:59.85,0:01:02.93,OP JP,,0,0,0,,Қараңғыда жерленген
Dialogue: 0,0:01:03.08,0:01:06.17,OP JP,,0,0,0,,Тексерілді, біз білеміз
Dialogue: 0,0:01:06.69,0:01:12.58,OP JP,,0,0,0,,Өтпелі екпінділікте
Dialogue: 0,0:01:13.05,0:01:17.23,OP JP,,0,0,0,,Еркін қараңыз
Dialogue: 0,0:01:33.00,0:01:33.64,JP-SUB,,0,0,0,,Жарылыс
Dialogue: 0,0:01:33.98,0:01:34.88,JP-SUB,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:01:35.34,0:01:37.02,JP-SUB,,0,0,0,,Мен әлі егжей-тегжейлі білмеймін.
Dialogue: 0,0:01:37.92,0:01:39.58,JP-SUB,,0,0,0,,Токионың бірнеше жерінде ғана.
Dialogue: 0,0:01:39.88,0:01:42.58,JP-SUB,,0,0,0,,Күшті жарылғыш заттар қолданылған сияқты.
Dialogue: 0,0:01:43.60,0:01:44.30,JP-SUB,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:01:44.72,0:01:45.42,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:01:46.44,0:01:48.72,JP-SUB,,0,0,0,,Күтілгендей, Хитоми мырза
Dialogue: 0,0:01:48.82,0:01:49.34,JP-SUB,,0,0,0,,Қанда
Dialogue: 0,0:01:49.80,0:01:50.16,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:01:51.08,0:01:52.64,JP-SUB,,0,0,0,,Мен адамдарды қарауды доғарамын.
Dialogue: 0,0:01:53.04,0:01:53.64,JP-SUB,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:01:54.56,0:01:54.92,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:01:58.40,0:02:01.36,JP-SUB,,0,0,0,,Премьер-министрді ұрлап кеткеннен кейін келесі қадам бомбалау бола ма?
Dialogue: 0,0:02:02.42,0:02:03.10,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:02:03.86,0:02:05.42,JP-SUB,,0,0,0,,Жарылыс салдарынан зардап шеккендер
Dialogue: 0,0:02:05.60,0:02:07.48,JP-SUB,,0,0,0,,Тіпті қазір расталған болса да
Dialogue: 0,0:02:07.48,0:02:08.76,JP-SUB,,0,0,0,,Он екі өлі
Dialogue: 0,0:02:09.04,0:02:10.86,JP-SUB,,0,0,0,,Жиырма төрт адам ауыр жарақат алды
Dialogue: 0,0:02:11.24,0:02:13.32,JP-SUB,,0,0,0,,Төрт адам із-түзсіз жоғалған.
Dialogue: 0,0:02:13.74,0:02:14.94,JP-SUB,,0,0,0,,Жарылыстар тізбегі
Dialogue: 0,0:02:15.16,0:02:17.06,JP-SUB,,0,0,0,,Бұл үйге қайтып келе жатқан қарбалас уақытта болған болуы мүмкін.
Dialogue: 0,0:02:17.24,0:02:21.12,JP-SUB,,0,0,0,,Болашақта құрбандар саны артады деп күтілуде
Dialogue: 0,0:02:22.32,0:02:24.36,JP-SUB,,0,0,0,,Иә, құрбандық.
Dialogue: 0,0:02:25.26,0:02:27.94,JP-SUB,,0,0,0,,Сұмдық болып жатқан жоқ па?
Dialogue: 0,0:02:28.62,0:02:31.04,JP-SUB,,0,0,0,,Өзгенің уайымы өзіңдікінен маңыздырақ.
Dialogue: 0,0:02:31.48,0:02:32.88,JP-SUB,,0,0,0,,Сізге ұқсайды.
Dialogue: 0,0:02:35.82,0:02:37.10,JP-SUB,,0,0,0,,Көңілді сияқты
Dialogue: 0,0:02:37.36,0:02:38.46,JP-SUB,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:02:38.74,0:02:42.12,JP-SUB,,0,0,0,,Бұл Сакуракоджи мырзаның ерекшеліктері туралы әңгіме.
Dialogue: 0,0:02:44.80,0:02:45.90,JP-SUB,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:02:46.18,0:02:48.16,JP-SUB,,0,0,0,,Мені шынымен де осында әкелетініңізге сене алар емеспін.
Dialogue: 0,0:02:49.66,0:02:52.58,JP-SUB,,0,0,0,,Менің міндетім – Эйстің өтінішіне жауап беру.
Dialogue: 0,0:02:53.32,0:02:55.24,JP-SUB,,0,0,0,,Көптен бері солай болған шығар.
Dialogue: 0,0:02:57.78,0:03:00.00,JP-SUB,,0,0,0,,Сіз әрқашан қорғалғансыз.
Dialogue: 0,0:03:00.30,0:03:01.04,JP-SUB,,0,0,0,,Escort
Dialogue: 0,0:03:01.16,0:03:02.60,JP-SUB,,0,0,0,,First Heike
Dialogue: 0,0:03:03.10,0:03:06.30,JP-SUB,,0,0,0,,Жақында сізді қорғау үшін
Dialogue: 0,0:03:06.38,0:03:09.36,JP-SUB,,0,0,0,,Огами-кун сол мектепке ауыстырылды.
Dialogue: 0,0:03:10.00,0:03:10.92,JP-SUB,,0,0,0,,Okami
Dialogue: 0,0:03:11.36,0:03:14.74,JP-SUB,,0,0,0,,Огами-кун білмеген сияқты.
Dialogue: 0,0:03:15.34,0:03:16.58,JP-SUB,,0,0,0,,Солай емес пе, Премьер-министр?
Dialogue: 0,0:03:18.02,0:03:21.64,JP-SUB,,0,0,0,,Барлығы менің жоспарларыма кедергі жасау үшін
Dialogue: 0,0:03:22.22,0:03:24.06,JP-SUB,,0,0,0,,It was quite easy to turn by hand, but
Dialogue: 0,0:03:24.06,0:03:25.56,JP-SUB,,0,0,0,,Бұл менің жеңісім.
Dialogue: 0,0:03:25.90,0:03:26.56,JP-SUB,,0,0,0,,Planning
Dialogue: 0,0:03:27.00,0:03:28.12,JP-SUB,,0,0,0,,Барлық жерде міндетті түрде өмір сүруге құқығы жоқ адамдар бар,
Dialogue: 0,0:03:32.70,0:03:34.60,JP-SUB,,0,0,0,,Менімен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:03:40.06,0:03:41.34,JP-SUB,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:03:42.00,0:03:43.72,JP-SUB,,0,0,0,,Өйткені сіз сирек кездесетін түрсіз.
Dialogue: 0,0:03:44.68,0:03:46.34,JP-SUB,,0,0,0,,Сіз үзілген кезде қиындық тудырады.
Dialogue: 0,0:03:46.46,0:03:48.64,JP-SUB,,0,0,0,,Мен оны осында сақтағым келді.
Dialogue: 0,0:03:49.38,0:03:52.90,JP-SUB,,0,0,0,,You just have to watch without interfering with the plan.
Dialogue: 0,0:03:53.00,0:03:53.84,JP-SUB,,0,0,0,,Planning
Dialogue: 0,0:03:54.34,0:03:55.94,JP-SUB,,0,0,0,,Бұл жарылыс болған жоқ
Dialogue: 0,0:03:56.82,0:03:57.72,JP-SUB,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:59.00,0:04:00.84,JP-SUB,,0,0,0,,Why such a thing?
Dialogue: 0,0:04:01.98,0:04:04.96,JP-SUB,,0,0,0,,Код ажыратқышты сақтау үшін
Dialogue: 0,0:04:05.74,0:04:06.96,JP-SUB,,0,0,0,,Do you believe?
Dialogue: 0,0:04:10.40,0:04:12.36,JP-SUB,,0,0,0,,Қандай да бір себеп болуы керек.
Dialogue: 0,0:04:13.30,0:04:16.78,JP-SUB,,0,0,0,,Мен сенің мейірімділігіңді бәрінен де жақсы түсінемін.
Dialogue: 0,0:04:19.62,0:04:20.44,JP-SUB,,0,0,0,,Mr. Hitomi
Dialogue: 0,0:04:29.98,0:04:31.56,JP-SUB,,0,0,0,,Бұл Қанда шебері.
Dialogue: 0,0:04:31.80,0:04:33.30,JP-SUB,,0,0,0,,Жұмбақ жіберушіден
Dialogue: 0,0:04:33.44,0:04:35.68,JP-SUB,,0,0,0,,There was an email suggesting Mr. Hitomi's whereabouts.
Dialogue: 0,0:04:36.68,0:04:38.66,JP-SUB,,0,0,0,,Е, тіпті шебердің орнында.
Dialogue: 0,0:04:39.50,0:04:40.54,JP-SUB,,0,0,0,,By the way, Ace
Dialogue: 0,0:04:41.02,0:04:42.54,JP-SUB,,0,0,0,,Токиода бомба қойылған
Dialogue: 0,0:04:42.80,0:04:44.74,JP-SUB,,0,0,0,,Бұл соңы емес, солай ма?
Dialogue: 0,0:04:46.04,0:04:48.04,JP-SUB,,0,0,0,,Нақты іс басталғалы тұр, солай ма?
Dialogue: 0,0:04:48.60,0:04:50.36,JP-SUB,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:04:51.62,0:04:54.58,JP-SUB,,0,0,0,,Looks like you were sniffing around a lot, Heike.
Dialogue: 0,0:04:54.96,0:04:58.00,JP-SUB,,0,0,0,,I'm a bad listener.
Dialogue: 0,0:04:58.00,0:04:58.76,JP-SUB,,0,0,0,,Heike
Dialogue: 0,0:04:59.06,0:05:02.56,JP-SUB,,0,0,0,,I don't trust you 100%.
Dialogue: 0,0:05:04.86,0:05:07.48,JP-SUB,,0,0,0,,Finding this hideout without difficulty
Dialogue: 0,0:05:07.60,0:05:09.22,JP-SUB,,0,0,0,,How do you call it a trick?
Dialogue: 0,0:05:09.88,0:05:13.28,JP-SUB,,0,0,0,,Бәлкім, біраздан бері ол мені бақылап жүрген шығар.
Dialogue: 0,0:05:14.80,0:05:18.26,JP-SUB,,0,0,0,,Бұл жер менің ақпараттық желімде байқалды.
Dialogue: 0,0:05:19.24,0:05:22.08,JP-SUB,,0,0,0,,Сіз бір бұрышқа қысылып қалдыңыз.
Dialogue: 0,0:05:22.48,0:05:23.82,JP-SUB,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:05:24.08,0:05:27.30,JP-SUB,,0,0,0,,Бірақ мен сіздің шындықты түсіндім
Dialogue: 0,0:05:28.42,0:05:30.56,JP-SUB,,0,0,0,,Едемнің кептеліп қалуына жол беру ұят болар еді.
Dialogue: 0,0:05:31.08,0:05:32.50,JP-SUB,,0,0,0,,Мен ынтымақтасқым келеді.
Dialogue: 0,0:05:33.32,0:05:35.82,JP-SUB,,0,0,0,,Сондықтан Сакуракоджи-санды ұрлап кеттік.
Dialogue: 0,0:05:35.96,0:05:38.58,JP-SUB,,0,0,0,,Ол Хачиодзи Нагиді қан мерекесі ретінде белгіледі.
Dialogue: 0,0:05:39.88,0:05:40.78,JP-SUB,,0,0,0,,Ханзада сарайы
Dialogue: 0,0:05:41.64,0:05:45.92,JP-SUB,,0,0,0,,Кодты бұзушыны бәрінен де жоғары бағалаған сен ханзаданы таңдадың.
Dialogue: 0,0:05:46.54,0:05:47.56,JP-SUB,,0,0,0,,Неліктен?
Dialogue: 0,0:05:47.76,0:05:51.92,JP-SUB,,0,0,0,,Себебі мен сіздің ашуыңыз бен мұңыңызды басқалардан жақсы түсінемін.
Dialogue: 0,0:05:57.12,0:05:58.56,JP-SUB,,0,0,0,,Неліктен князь сарайы?
Dialogue: 0,0:05:58.90,0:05:59.84,JP-SUB,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:06:01.78,0:06:06.16,JP-SUB,,0,0,0,,Сіз жоқ нәрсе болу қандай сезім екенін білмейсіз.
Dialogue: 0,0:06:08.02,0:06:08.60,JP-SUB,,0,0,0,,Эйс
Dialogue: 0,0:06:09.28,0:06:11.40,JP-SUB,,0,0,0,,Таңқаларлық емес, сену мүмкін емес.
Dialogue: 0,0:06:12.04,0:06:12.74,JP-SUB,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:06:14.70,0:06:16.22,JP-SUB,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз
Dialogue: 0,0:06:16.48,0:06:19.68,JP-SUB,,0,0,0,,Бірақ біртүрлі әрекет жасасаң, мен сені өлтіремін.
Dialogue: 0,0:06:21.14,0:06:23.24,JP-SUB,,0,0,0,,Біз сіздің үміттеріңізді ақтауға тырысамыз.
Dialogue: 0,0:06:23.56,0:06:24.82,JP-SUB,,0,0,0,,О, келдің бе?
Dialogue: 0,0:06:25.74,0:06:29.26,JP-SUB,,0,0,0,,Канда келсе, Огами-кун да жақында келеді.
Dialogue: 0,0:06:30.72,0:06:33.38,JP-SUB,,0,0,0,,Соқтығыс әлі де болмай ма?
Dialogue: 0,0:06:36.30,0:06:37.60,JP-SUB,,0,0,0,,Бірден, Хайке
Dialogue: 0,0:06:38.16,0:06:39.54,JP-SUB,,0,0,0,,Сіз жұмыс істейсіз бе?
Dialogue: 0,0:06:44.54,0:06:46.38,JP-SUB,,0,0,0,,Хитоми мырза осында
Dialogue: 0,0:06:49.40,0:06:51.84,JP-SUB,,0,0,0,,Мен сені адамдарға қарауды тоқтатамын. Бұл жақсы.
Dialogue: 0,0:06:53.30,0:06:55.12,JP-SUB,,0,0,0,,Кешіріңіз, ұстаз.
Dialogue: 0,0:07:07.30,0:07:10.38,JP-SUB,,0,0,0,,Хейке мырза, сіз мұнда не үшін келдіңіз?
Dialogue: 0,0:07:11.38,0:07:15.34,JP-SUB,,0,0,0,,Мен сені бір рет байлап алғым келді.
Dialogue: 0,0:07:23.04,0:07:23.76,JP-SUB,,0,0,0,,Түсінемін
Dialogue: 0,0:07:24.10,0:07:26.68,JP-SUB,,0,0,0,,Огами-кун, сен Сакура-кюнмен бірге емес пе едің?
Dialogue: 0,0:07:27.42,0:07:28.66,JP-SUB,,0,0,0,,Мен әлі үйде емеспін.
Dialogue: 0,0:07:29.64,0:07:30.84,JP-SUB,,0,0,0,,Менің ұялы телефоным да жұмыс істемейді.
Dialogue: 0,0:07:31.10,0:07:32.60,JP-SUB,,0,0,0,,Бірдеңе болды ма деп ойлаймын.
Dialogue: 0,0:07:34.00,0:07:37.14,JP-SUB,,0,0,0,,Түсіндім, ойыма келгеннің бәрін іздеймін.
Dialogue: 0,0:07:37.56,0:07:39.28,JP-SUB,,0,0,0,,Егер мен бірдеңе білсем, мен сізге хабарласамын.
Dialogue: 0,0:07:39.28,0:07:40.20,JP-SUB,,0,0,0,,№ 6
Dialogue: 0,0:07:43.84,0:07:45.42,JP-SUB,,0,0,0,,Екінші нөмір маған опасыздық жасады
Dialogue: 0,0:07:59.28,0:08:00.00,JP-SUB,,0,0,0,,№ 6
Dialogue: 0,0:08:08.98,0:08:13.22,JP-SUB,,0,0,0,,Сәлем Юки-кун
Dialogue: 0,0:08:13.98,0:08:15.72,JP-SUB,,0,0,0,,Бес санымен не істедің?
Dialogue: 0,0:08:16.36,0:08:18.36,JP-SUB,,0,0,0,,Енді сіз нені айтасыз?
Dialogue: 0,0:08:18.48,0:08:20.94,JP-SUB,,0,0,0,,Ақымақ, мен бәрін көрдім.
Dialogue: 0,0:08:21.20,0:08:22.52,JP-SUB,,0,0,0,,Мен Гобанға шабуыл жасағанда
Dialogue: 0,0:08:23.12,0:08:26.36,JP-SUB,,0,0,0,,Түсіндім, мен бұған немқұрайлы қарадым.
Dialogue: 0,0:08:26.86,0:08:28.40,JP-SUB,,0,0,0,,Сіз нені айтып тұрсыз, Хайке?
Dialogue: 0,0:08:28.96,0:08:30.74,JP-SUB,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:08:35.08,0:08:36.80,JP-SUB,,0,0,0,,Мұның мағынасы осы.
Dialogue: 0,0:08:36.80,0:08:39.64,JP-SUB,,0,0,0,,Сіз маған №2 опасыздық жасадыңыз
Dialogue: 0,0:08:44.52,0:08:47.44,JP-SUB,,0,0,0,,Дыбыстың табиғаттан тыс күшінің көрінбейтіндігі алаңдатады.
Dialogue: 0,0:08:47.62,0:08:50.00,JP-SUB,,0,0,0,,Тура жол жүрудің ерекшеліктерін түсінсеңіз
Dialogue: 0,0:08:50.00,0:08:52.30,JP-SUB,,0,0,0,,Алдын алу қиын емес
Dialogue: 0,0:08:53.36,0:08:54.32,JP-SUB,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:08:58.08,0:08:58.82,JP-SUB,,0,0,0,,Қашуға болмайды
Dialogue: 0,0:08:59.12,0:09:00.88,JP-SUB,,0,0,0,,Сіз одан аулақ болатыныңызға сенімдісіз, солай ма?
Dialogue: 0,0:09:37.08,0:09:39.24,JP-SUB,,0,0,0,,Мейірім жоқ, Огами-кун.
Dialogue: 0,0:09:39.68,0:09:40.92,JP-SUB,,0,0,0,,Жолда тұрғандарға
Dialogue: 0,0:09:41.22,0:09:42.66,JP-SUB,,0,0,0,,Мейірім қажет емес
Dialogue: 0,0:09:43.84,0:09:46.34,JP-SUB,,0,0,0,,Сіз бұл саясатты ұстана аласыз ба?
Dialogue: 0,0:09:46.76,0:09:47.16,JP-SUB,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:47.28,0:09:48.66,JP-SUB,,0,0,0,,No6 Одан құтыл.
Dialogue: 0,0:09:52.70,0:09:54.62,JP-SUB,,0,0,0,,Тек жоғары көтеріліңіз, №6
Dialogue: 0,0:09:57.00,0:09:58.62,JP-SUB,,0,0,0,,Мен екіншісін жеңдім.
Dialogue: 0,0:10:13.04,0:10:14.36,JP-SUB,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:14.52,0:10:17.30,JP-SUB,,0,0,0,,Өзіңізден бастайық.
Dialogue: 0,0:10:30.92,0:10:33.32,JP-SUB,,0,0,0,,Канда: Хитоми сонда емес пе еді?
Dialogue: 0,0:10:40.54,0:10:41.90,JP-SUB,,0,0,0,,Мен ешқашан біреуді көремін деп ойламадым.
Dialogue: 0,0:10:42.30,0:10:43.40,JP-SUB,,0,0,0,,Керемет жауап
Dialogue: 0,0:10:44.34,0:10:45.14,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:10:46.06,0:10:47.00,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:10:47.22,0:10:48.04,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:10:48.36,0:10:50.14,JP-SUB,,0,0,0,,Канда мырзаны айла-шарғы жасауда.
Dialogue: 0,0:10:50.84,0:10:52.64,JP-SUB,,0,0,0,,Мен саған көмектесуім керек.
Dialogue: 0,0:10:54.44,0:10:56.08,JP-SUB,,0,0,0,,Күтілгендей, электр тогының соғуы миға командалар жібереді.
Dialogue: 0,0:10:56.42,0:10:57.76,JP-SUB,,0,0,0,,Ол бақылауда.
Dialogue: 0,0:10:58.12,0:10:59.68,JP-SUB,,0,0,0,,Бұл ерекше ештеңе емес.
Dialogue: 0,0:11:00.14,0:11:02.46,JP-SUB,,0,0,0,,Мәйіттерді манипуляциялаудан әлдеқайда оңай
Dialogue: 0,0:11:04.78,0:11:05.68,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:11:12.12,0:11:12.82,JP-SUB,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:11:13.78,0:11:16.24,JP-SUB,,0,0,0,,Кешіріңіз, ұстаз.
Dialogue: 0,0:11:16.90,0:11:17.78,JP-SUB,,0,0,0,,Хитоми мырзаға
Dialogue: 0,0:11:21.00,0:11:21.62,JP-SUB,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:11:22.94,0:11:25.04,JP-SUB,,0,0,0,,Ұстаз, қашыңыз.
Dialogue: 0,0:11:26.62,0:11:27.28,JP-SUB,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:11:30.48,0:11:31.12,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:11:31.32,0:11:32.30,JP-SUB,,0,0,0,,Қанша ату қалды?
Dialogue: 0,0:11:33.70,0:11:36.32,JP-SUB,,0,0,0,,Мен барлық оқтарды ұстаймын.
Dialogue: 0,0:11:37.32,0:11:38.66,JP-SUB,,0,0,0,,Оны тез ұрыңыз
Dialogue: 0,0:11:39.44,0:11:41.30,JP-SUB,,0,0,0,,Бұл керемет, Огами-кун.
Dialogue: 0,0:11:41.74,0:11:46.38,JP-SUB,,0,0,0,,Бірақ білесің бе, мен сенен осында құтылуды ойлап жүрмін.
Dialogue: 0,0:11:48.88,0:11:52.12,JP-SUB,,0,0,0,,Қандаға: «Соңғы оқпен өз басыңды ұр».
Dialogue: 0,0:11:52.12,0:11:53.56,JP-SUB,,0,0,0,,Директивалар шығарылды
Dialogue: 0,0:11:54.48,0:11:55.38,JP-SUB,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:11:55.90,0:11:57.60,JP-SUB,,0,0,0,,Егер сіз оқтан жалтарсаңыз
Dialogue: 0,0:11:57.84,0:11:59.50,JP-SUB,,0,0,0,,Канда мылтығын атуды жалғастырды.
Dialogue: 0,0:11:59.50,0:12:01.74,JP-SUB,,0,0,0,,Соңғы оқпен өзіңізді өлтіріңіз
Dialogue: 0,0:12:02.24,0:12:04.44,JP-SUB,,0,0,0,,Бірақ оқты тістеп алсаң
Dialogue: 0,0:12:04.44,0:12:06.90,JP-SUB,,0,0,0,,Содан кейін Канданың басқаруы жоғалады.
Dialogue: 0,0:12:07.04,0:12:08.60,JP-SUB,,0,0,0,,Канда өлуі керек емес
Dialogue: 0,0:12:08.76,0:12:09.64,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:12:11.52,0:12:12.36,JP-SUB,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:12:12.76,0:12:14.78,JP-SUB,,0,0,0,,Қанданы жалғыз қалдыра аламыз ба?
Dialogue: 0,0:12:15.36,0:12:16.44,JP-SUB,,0,0,0,,Бұл қорқақ.
Dialogue: 0,0:12:17.38,0:12:18.46,JP-SUB,,0,0,0,,Бұл тым жасырын.
Dialogue: 0,0:12:18.66,0:12:19.94,JP-SUB,,0,0,0,,Хитоми-сенпай-доно
Dialogue: 0,0:12:21.82,0:12:24.18,JP-SUB,,0,0,0,,Сен мейірімді баласың.
Dialogue: 0,0:12:24.40,0:12:25.54,JP-SUB,,0,0,0,,Хитоми-сенпай-доно,
Dialogue: 0,0:12:25.78,0:12:28.38,JP-SUB,,0,0,0,,Қанда Сенсей және Огамимен дос болсам да.
Dialogue: 0,0:12:28.74,0:12:30.36,JP-SUB,,0,0,0,,Неліктен мұндай қорқынышты оқиға болды?
Dialogue: 0,0:12:32.08,0:12:33.76,JP-SUB,,0,0,0,,Мен мұндай нәрсені кешіре алмаймын.
Dialogue: 0,0:12:33.90,0:12:34.74,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:12:35.36,0:12:36.56,JP-SUB,,0,0,0,,Өз-өзіне қол жұмсамау
Dialogue: 0,0:12:37.72,0:12:39.08,JP-SUB,,0,0,0,,Осы қолмен аяқтаңыз
Dialogue: 0,0:12:39.96,0:12:40.84,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:12:41.48,0:12:42.04,JP-SUB,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:12:44.84,0:12:47.22,JP-SUB,,0,0,0,,Жүзін өзіне қаратқан жауға қарсы
Dialogue: 0,0:12:47.22,0:12:50.04,JP-SUB,,0,0,0,,Еш ойланбастан қарсы шабуыл жасап, оларды жойыңыз.
Dialogue: 0,0:12:50.62,0:12:52.74,JP-SUB,,0,0,0,,Сен өзгерген жоқсың, Огами-кун.
Dialogue: 0,0:12:53.44,0:12:55.18,JP-SUB,,0,0,0,,Бірақ мұны істеуге бола ма?
Dialogue: 0,0:12:57.42,0:12:58.42,JP-SUB,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:12:58.88,0:13:01.04,JP-SUB,,0,0,0,,Кешіріңіз...мүлдем емес.
Dialogue: 0,0:13:09.70,0:13:11.84,JP-SUB,,0,0,0,,Оками, күте тұрыңыз.
Dialogue: 0,0:13:12.12,0:13:13.88,JP-SUB,,0,0,0,,Тоқта, Огами
Dialogue: 0,0:13:24.22,0:13:26.80,JP-SUB,,0,0,0,,Өлтірме.
Dialogue: 0,0:13:33.36,0:13:34.12,JP-SUB,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:13:46.72,0:13:47.72,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:13:49.50,0:13:50.74,JP-SUB,,0,0,0,,Титан туралы сөйлесіп отырдық, иә?
Dialogue: 0,0:13:54.68,0:13:56.08,JP-SUB,,0,0,0,,Сіз арқанды алыңыз
Dialogue: 0,0:13:58.38,0:13:59.38,JP-SUB,,0,0,0,,Мен...
Dialogue: 0,0:14:00.42,0:14:01.58,JP-SUB,,0,0,0,,Канда мырза
Dialogue: 0,0:14:01.92,0:14:03.60,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:14:04.12,0:14:05.24,JP-SUB,,0,0,0,,Жақсы нәрсе.
Dialogue: 0,0:14:05.42,0:14:06.88,JP-SUB,,0,0,0,,Қалыпты күйге оралды.
Dialogue: 0,0:14:07.58,0:14:08.12,JP-SUB,,0,0,0,,Жақсы
Dialogue: 0,0:14:08.56,0:14:12.70,JP-SUB,,0,0,0,,Сенсейдің шарасыз ойлары Хитоми-сенпайдың табиғаттан тыс қабілетін жеңді.
Dialogue: 0,0:14:12.70,0:14:14.46,JP-SUB,,0,0,0,,Бұл өте сирек кездесетін түр.
Dialogue: 0,0:14:16.24,0:14:19.10,JP-SUB,,0,0,0,,Сіз көптеген жолдармен кедергі жасайтын сияқтысыз.
Dialogue: 0,0:14:20.32,0:14:22.50,JP-SUB,,0,0,0,,Сіз бұл жолы күшікті кепілге алуды жоспарлап отырсыз ба?
Dialogue: 0,0:14:27.82,0:14:28.26,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:14:28.68,0:14:29.86,JP-SUB,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:14:30.58,0:14:31.64,JP-SUB,,0,0,0,,Неліктен не?
Dialogue: 0,0:14:32.30,0:14:35.56,JP-SUB,,0,0,0,,Бұрын сіз мұндай нәрсені жасайтын адам емес едіңіз.
Dialogue: 0,0:14:36.60,0:14:37.30,JP-SUB,,0,0,0,,Неліктен?
Dialogue: 0,0:14:38.54,0:14:41.44,JP-SUB,,0,0,0,,Осы бөлмедегі сағатқа қарасаңыз да, айта алмайсыз ба?
Dialogue: 0,0:14:43.26,0:14:45.76,JP-SUB,,0,0,0,,Ойланып қарасақ, бұл бөлме
Dialogue: 0,0:14:46.38,0:14:47.80,JP-SUB,,0,0,0,,Тек тоқтатылған сағаттар
Dialogue: 0,0:14:49.06,0:14:52.52,JP-SUB,,0,0,0,,Бұл кодты бұзушылардың өлі уақыты.
Dialogue: 0,0:14:56.74,0:14:58.32,JP-SUB,,0,0,0,,6:23
Dialogue: 0,0:14:58.84,0:15:01.58,JP-SUB,,0,0,0,,Ескі кодекс 03 алып жүру кезінде қайтыс болды
Dialogue: 0,0:15:02.34,0:15:03.96,JP-SUB,,0,0,0,,22:47
Dialogue: 0,0:15:04.58,0:15:07.08,JP-SUB,,0,0,0,,Ескі код 06 зұлымдықты соттаған кезде
Dialogue: 0,0:15:07.54,0:15:09.20,JP-SUB,,0,0,0,,Кенеттен болған жазатайым оқиғадан қайтыс болу
Dialogue: 0,0:15:11.00,0:15:12.50,JP-SUB,,0,0,0,,Жоқтарға
Dialogue: 0,0:15:12.84,0:15:16.52,JP-SUB,,0,0,0,,Маған тіпті қабір белгісін қоюға да рұқсат жоқ, тым болмаса
Dialogue: 0,0:15:17.94,0:15:21.58,JP-SUB,,0,0,0,,Олардың барлығы заң бойынша сотталмайтын зұлымдықты үкім етіп өлді.
Dialogue: 0,0:15:22.08,0:15:23.32,JP-SUB,,0,0,0,,Ешкім білмей-ақ
Dialogue: 0,0:15:24.08,0:15:25.38,JP-SUB,,0,0,0,,Хитоми-сенпай-доно
Dialogue: 0,0:15:26.54,0:15:29.64,JP-SUB,,0,0,0,,Мұндайды тоқтату керек.
Dialogue: 0,0:15:30.48,0:15:31.44,JP-SUB,,0,0,0,,Бұл адам
Dialogue: 0,0:15:31.82,0:15:33.44,JP-SUB,,0,0,0,,Менің қайтыс болған жолдастарым үшін
Dialogue: 0,0:15:33.56,0:15:34.60,JP-SUB,,0,0,0,,Жалғыз
Dialogue: 0,0:15:35.68,0:15:38.40,JP-SUB,,0,0,0,,Оларға бұйрық берген Премьер-Министр болды.
Dialogue: 0,0:15:38.64,0:15:40.10,JP-SUB,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:15:40.62,0:15:42.94,JP-SUB,,0,0,0,,Мен премьер-министрдің жауапкершілікті өз мойнына алып, өлгенін қалаймын.
Dialogue: 0,0:15:43.84,0:15:44.64,JP-SUB,,0,0,0,,№.
Dialogue: 0,0:15:45.04,0:15:46.38,JP-SUB,,0,0,0,,Премьер-министрді өлтіру, т.б.
Dialogue: 0,0:15:46.38,0:15:48.98,JP-SUB,,0,0,0,,Мұны істеудің қажеті жоқ.
Dialogue: 0,0:15:49.46,0:15:51.46,JP-SUB,,0,0,0,,Ештеңе болмайды
Dialogue: 0,0:15:52.22,0:15:56.44,JP-SUB,,0,0,0,,Мен премьер-министрдің ең жақсы рөлін ойнап өлгенін қалаймын.
Dialogue: 0,0:15:56.88,0:15:58.30,JP-SUB,,0,0,0,,Ең жақсы рөл?
Dialogue: 0,0:16:04.36,0:16:06.34,JP-SUB,,0,0,0,,Жаңа ғана жарылыс болды.
Dialogue: 0,0:16:06.60,0:16:07.70,JP-SUB,,0,0,0,,Бұл көп түтін.
Dialogue: 0,0:16:08.16,0:16:09.54,T-JP-SUB,,0,0,0,,Көптеген адамдар құлады...
Dialogue: 0,0:16:08.96,0:16:12.02,JP-SUB,,0,0,0,,Премьер-министр өлім жазасына кесілгенге дейін көптеген адамдар өледі.
Dialogue: 0,0:16:10.82,0:16:12.36,T-JP-SUB,,0,0,0,,Бұл қорқынышты жағдай.
Dialogue: 0,0:16:13.14,0:16:15.02,JP-SUB,,0,0,0,,Халық қорқады
Dialogue: 0,0:16:15.64,0:16:17.88,JP-SUB,,0,0,0,,Соңында, негізгі оқиға.
Dialogue: 0,0:16:18.32,0:16:19.64,JP-SUB,,0,0,0,,Премьер-министрмен
Dialogue: 0,0:16:19.64,0:16:23.40,JP-SUB,,0,0,0,,Жапонияда тағы көптеген адамдар өледі.
Dialogue: 0,0:16:23.88,0:16:25.00,JP-SUB,,0,0,0,,Не болды?
Dialogue: 0,0:16:25.00,0:16:26.00,JP-SUB,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:16:27.06,0:16:28.92,JP-SUB,,0,0,0,,Неге олай істейсің?
Dialogue: 0,0:16:31.06,0:16:33.54,JP-SUB,,0,0,0,,Тіпті жазықсыз адамдарды өлтіру
Dialogue: 0,0:16:34.68,0:16:36.04,JP-SUB,,0,0,0,,Есте сақта
Dialogue: 0,0:16:36.68,0:16:40.10,JP-SUB,,0,0,0,,Осы елдің халқының жадында қорқынышты сақтаңыз
Dialogue: 0,0:16:42.44,0:16:43.92,JP-SUB,,0,0,0,,Премьер-министр Фудзиварамен
Dialogue: 0,0:16:44.46,0:16:47.22,JP-SUB,,0,0,0,,Көптеген азаматтардың өлім жазасына кесілгені туралы шындық
Dialogue: 0,0:16:52.02,0:16:53.78,JP-SUB,,0,0,0,,Сіз мұны түсінуіңіз керек
Dialogue: 0,0:16:54.14,0:16:57.58,JP-SUB,,0,0,0,,Уақытша бейбітшілік әлемінде өмір сүретіндер құрылған.
Dialogue: 0,0:16:59.48,0:17:02.44,JP-SUB,,0,0,0,,Бұл құрылған уақытша тыныштық.
Dialogue: 0,0:17:03.20,0:17:04.90,JP-SUB,,0,0,0,,Балама көмектесіңізші
Dialogue: 0,0:17:05.36,0:17:05.98,JP-SUB,,0,0,0,,Мен ондай адамды білмеймін.
Dialogue: 0,0:17:06.12,0:17:08.94,JP-SUB,,0,0,0,,Бейбітшілікке батқандар қорқынышты жібереді
Dialogue: 0,0:17:09.26,0:17:12.00,JP-SUB,,0,0,0,,Ал сен оны шын жүрегіңмен тілейсің.
Dialogue: 0,0:17:12.70,0:17:16.24,JP-SUB,,0,0,0,,Осындай жауыздық жасаған адамды өлтіретін болмыс.
Dialogue: 0,0:17:17.34,0:17:18.76,JP-SUB,,0,0,0,,Кез келген жолмен
Dialogue: 0,0:17:19.06,0:17:21.14,JP-SUB,,0,0,0,,Жамандықты жоятын абсолютті болмыс
Dialogue: 0,0:17:22.30,0:17:22.72,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:17:23.72,0:17:25.24,JP-SUB,,0,0,0,,Кодты ажыратқыш
Dialogue: 0,0:17:25.98,0:17:28.16,JP-SUB,,0,0,0,,Содан кейін кодты ажыратқыш жойылады
Dialogue: 0,0:17:28.16,0:17:31.06,JP-SUB,,0,0,0,,Ешкім білмей өлудің қажеті жоқ
Dialogue: 0,0:17:32.44,0:17:34.42,JP-SUB,,0,0,0,,Кодты ажыратқыштар үшін
Dialogue: 0,0:17:36.12,0:17:36.84,JP-SUB,,0,0,0,,«Осы баланың Қвиркі болмаса да—»
Dialogue: 0,0:17:36.84,0:17:38.00,JP-SUB,,0,0,0,,Барлығы орындалған кезде
Dialogue: 0,0:17:38.90,0:17:41.92,JP-SUB,,0,0,0,,Өзіңізді әділдікті бұзушы ретінде көрсетіңіз
Dialogue: 0,0:17:42.20,0:17:44.18,JP-SUB,,0,0,0,,Жамандықты ашық соттау дегенді білдіре ме?
Dialogue: 0,0:17:46.26,0:17:47.06,JP-SUB,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:48.60,0:17:51.70,JP-SUB,,0,0,0,,Едемнің иті ыңғайсыз екені рас.
Dialogue: 0,0:17:52.18,0:17:52.78,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:17:53.36,0:17:55.38,JP-SUB,,0,0,0,,Ашық қозғала білу жаман емес.
Dialogue: 0,0:17:55.90,0:17:57.20,JP-SUB,,0,0,0,,Егер сіз сонша шу шығарсаңыз
Dialogue: 0,0:17:57.96,0:17:59.52,JP-SUB,,0,0,0,,Едемді де қарастыруға болады
Dialogue: 0,0:18:00.52,0:18:01.76,JP-SUB,,0,0,0,,Бірге ше?
Dialogue: 0,0:18:01.90,0:18:02.84,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:18:03.02,0:18:04.30,JP-SUB,,0,0,0,,Бірақ ұмытпаңыз
Dialogue: 0,0:18:05.00,0:18:06.94,JP-SUB,,0,0,0,,Жамандықты соттайтын кодты бұзушы
Dialogue: 0,0:18:07.16,0:18:08.66,JP-SUB,,0,0,0,,Өйткені, бұл кісі өлтіру.
Dialogue: 0,0:18:09.00,0:18:11.30,JP-SUB,,0,0,0,,Марапаттаудың қажеті жоқ...
Dialogue: 0,0:18:25.32,0:18:26.64,JP-SUB,,0,0,0,,Неге екенін білмеймін
Dialogue: 0,0:18:27.24,0:18:28.14,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:18:28.84,0:18:30.60,JP-SUB,,0,0,0,,Түсінбейтін сенсің.
Dialogue: 0,0:18:31.30,0:18:34.72,JP-SUB,,0,0,0,,Жазықсыз адамдарды өлтіру және осындай оқиғаларды тудыру
Dialogue: 0,0:18:35.24,0:18:39.36,JP-SUB,,0,0,0,,Жазықсыз адамдар өлгенде ең қатты жек көрдің.
Dialogue: 0,0:18:48.08,0:18:50.12,JP-SUB,,0,0,0,,Бұл туралы ма, Юки-кун?
Dialogue: 0,0:18:50.48,0:18:52.04,JP-SUB,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:18:52.04,0:18:53.58,JP-SUB,,0,0,0,,Әлі көп жол бар
Dialogue: 0,0:18:53.98,0:18:56.44,JP-SUB,,0,0,0,,Күтілгендей, бұл 2 саны.
Dialogue: 0,0:18:57.22,0:18:59.54,JP-SUB,,0,0,0,,Өзгеріс жоқ, Огами-кун.
Dialogue: 0,0:19:00.02,0:19:02.38,JP-SUB,,0,0,0,,Бірақ енді артқа жол жоқ.
Dialogue: 0,0:19:03.08,0:19:07.18,JP-SUB,,0,0,0,,Қазір кодты бұзушы болмысқа айналатын кез.
Dialogue: 0,0:19:09.02,0:19:13.02,JP-SUB,,0,0,0,,Ешкім білмей, оңаша өлетін мен емеспін.
Dialogue: 0,0:19:13.48,0:19:15.66,JP-SUB,,0,0,0,,Барлығы қалаған нәрсеге айналыңыз
Dialogue: 0,0:19:16.18,0:19:17.78,JP-SUB,,0,0,0,,Халықтың қорқынышын құрбан ет
Dialogue: 0,0:19:18.34,0:19:21.44,JP-SUB,,0,0,0,,Мен Eden кодты ажыратқышты босатамын
Dialogue: 0,0:19:21.70,0:19:23.28,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:19:23.28,0:19:24.60,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:19:29.10,0:19:30.08,JP-SUB,,0,0,0,,Юкихина
Dialogue: 0,0:19:30.74,0:19:33.40,JP-SUB,,0,0,0,,Қанша уақыт өтсе де шықпайды деп ойласаңыз
Dialogue: 0,0:19:33.90,0:19:36.06,JP-SUB,,0,0,0,,Сіз не істеп жатырсыз? Хитоми
Dialogue: 0,0:19:36.44,0:19:38.52,JP-SUB,,0,0,0,,Бірінші барғаныңызға қуаныштымын.
Dialogue: 0,0:19:39.22,0:19:43.06,JP-SUB,,0,0,0,,Бұлай жасайтын уақыт емес.
Dialogue: 0,0:19:43.60,0:19:45.44,JP-SUB,,0,0,0,,Түсіндім, Юкихина.
Dialogue: 0,0:19:51.34,0:19:52.10,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:19:53.32,0:19:56.42,JP-SUB,,0,0,0,,Сенің отың менің мұзымды еріте алмайды
Dialogue: 0,0:19:56.84,0:19:58.26,JP-SUB,,0,0,0,,Олай болса, Юкихина
Dialogue: 0,0:19:58.64,0:19:59.96,JP-SUB,,0,0,0,,Мен алға барамын.
Dialogue: 0,0:20:00.34,0:20:01.40,JP-SUB,,0,0,0,,Хитоми мырза
Dialogue: 0,0:20:01.50,0:20:02.52,JP-SUB,,0,0,0,,Тоқта, адамдарға қара.
Dialogue: 0,0:20:06.70,0:20:07.52,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:20:07.98,0:20:08.68,JP-SUB,,0,0,0,,Бітті
Dialogue: 0,0:20:11.74,0:20:12.86,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:20:18.22,0:20:20.48,JP-SUB,,0,0,0,,Не істеп жатырсың, Огами?
Dialogue: 0,0:20:20.72,0:20:23.38,JP-SUB,,0,0,0,,Сен Сакура-чанға қауіп төндірдің.
Dialogue: 0,0:20:24.00,0:20:24.82,JP-SUB,,0,0,0,,Токикун
Dialogue: 0,0:20:25.08,0:20:26.88,JP-SUB,,0,0,0,,Сәлем Сакура-чан
Dialogue: 0,0:20:27.28,0:20:29.54,JP-SUB,,0,0,0,,Шинучимен таныстыру
Dialogue: 0,0:20:30.10,0:20:33.68,JP-SUB,,0,0,0,,Өйткені, батыр кеш шығуы керек.
Dialogue: 0,0:20:38.28,0:20:39.20,JP-SUB,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:20:39.46,0:20:40.28,JP-SUB,,0,0,0,,Премьер-министрді қайтару
Dialogue: 0,0:20:46.44,0:20:47.82,JP-SUB,,0,0,0,,Маған бір нәрсе айтайын.
Dialogue: 0,0:20:48.34,0:20:50.92,JP-SUB,,0,0,0,,Бұл ғимаратқа да бомба қойылған.
Dialogue: 0,0:20:51.28,0:20:53.58,JP-SUB,,0,0,0,,Тез қашып кеткеніңіз жақсы.
Dialogue: 0,0:20:54.24,0:20:54.82,JP-SUB,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:20:59.66,0:21:00.32,JP-SUB,,0,0,0,,Күтіңіз.
Dialogue: 0,0:21:00.58,0:21:02.22,JP-SUB,,0,0,0,,Бірінші министр Папаны қайтарыңыз.
Dialogue: 0,0:21:02.98,0:21:04.38,JP-SUB,,0,0,0,,Иә…♡
Dialogue: 0,0:21:04.48,0:21:05.96,JP-SUB,,0,0,0,,Қауіпті Сакура-чан
Dialogue: 0,0:21:12.62,0:21:13.76,JP-SUB,,0,0,0,,Олардың не екені туралы түрлі қауесеттер бар, бірақ мен нақты анықтадым.
Dialogue: 0,0:21:14.22,0:21:16.44,JP-SUB,,0,0,0,,Юки-кун, мен шайқасты саған тапсырамын.
Dialogue: 0,0:21:17.78,0:21:20.34,JP-SUB,,0,0,0,,Сәлем №2
Dialogue: 0,0:21:29.46,0:21:33.26,JP-SUB,,0,0,0,,Эй, сенен менің артымнан ереді деп ешқашан күтпедім.
Dialogue: 0,0:21:33.46,0:21:34.90,JP-SUB,,0,0,0,,Премьер-министр сені өлтіруге жол бермейді.
Dialogue: 0,0:21:35.04,0:21:38.58,JP-SUB,,0,0,0,,Мен де сенің бұдан былай адамдарды өлтіруіңе жол бермеймін.
Dialogue: 0,0:21:41.74,0:21:42.66,JP-SUB,,0,0,0,,Бұл адам
Dialogue: 0,0:21:42.82,0:21:43.98,JP-SUB,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:21:45.82,0:21:48.58,JP-SUB,,0,0,0,,Өткенде нақты не болды?
Dialogue: 0,0:21:55.81,0:21:58.25,ED JP-B,,0,0,0,,Сен де бір күні түсінесің
Dialogue: 0,0:21:58.25,0:22:00.66,ED JP-B,,0,0,0,,Ақ қарға қайда барады
Dialogue: 0,0:22:00.66,0:22:03.34,ED JP-B,,0,0,0,,Ешкімді танымай ұшамыз
Dialogue: 0,0:22:03.34,0:22:05.98,ED JP-B,,0,0,0,,Гүлденген қала
Dialogue: 0,0:22:16.76,0:22:20.89,ED JP-G,,0,0,0,,Тек өмір сүруге себеп іздеу
Dialogue: 0,0:22:20.89,0:22:23.10,ED JP-G,,0,0,0,,Менің бос өзім
Dialogue: 0,0:22:23.10,0:22:26.08,ED JP-G,,0,0,0,,Өйткені бұл ұят
Dialogue: 0,0:22:26.36,0:22:31.20,ED JP-G,,0,0,0,,Біз әлем белгілеген ережелерді ұстанамыз
Dialogue: 0,0:22:31.20,0:22:35.88,ED JP-G,,0,0,0,,Өзіңізді жіберіп, күліңіз.
Dialogue: 0,0:22:36.89,0:22:41.34,ED JP-B,,0,0,0,,Жалаңаш болып, ішкі түйсігіңмен жүр
Dialogue: 0,0:22:41.52,0:22:45.57,ED JP-B,,0,0,0,,Көзден жасырылған шындық
Dialogue: 0,0:22:45.62,0:22:48.03,ED JP-B,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:22:48.03,0:22:50.14,ED JP-B,,0,0,0,,Шешім қабылданды
Dialogue: 0,0:22:50.14,0:22:55.01,ED JP-B,,0,0,0,,Қара киімдеріңді тастап, тұрыңдар.
Dialogue: 0,0:22:55.26,0:22:57.50,ED JP-B,,0,0,0,,Таза тілек
Dialogue: 0,0:22:57.50,0:23:01.53,ED JP-B,,0,0,0,,Қанатымыз енді жоғалды
Dialogue: 0,0:23:01.53,0:23:04.46,ED JP-B,,0,0,0,,Оны сілкіп таста да, қанатыңды ат
Dialogue: 0,0:23:04.46,0:23:06.82,ED JP-B,,0,0,0,,Қорықпа
Dialogue: 0,0:23:06.94,0:23:12.29,ED JP-B,,0,0,0,,Жауап қараңғылықтан тыс болса
Dialogue: 0,0:23:25.56,0:23:26.28,JP-SUB,,0,0,0,,Сол күні
Dialogue: 0,0:23:26.90,0:23:29.62,JP-SUB,,0,0,0,,Қалада түнде қан мен түтіннің иісіне тұншығып
Dialogue: 0,0:23:30.22,0:23:31.80,JP-SUB,,0,0,0,,Мен сені кездестірдім
Dialogue: 0,0:23:33.14,0:23:35.48,JP-SUB,,0,0,0,,Келесі Code Breaker 10-эпизод
Dialogue: 0,0:23:36.22,0:23:37.40,JP-SUB,,0,0,0,,Адамдар көрген дүние
Dialogue: 0,0:23:38.90,0:23:44.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory