Dialogue: 0,0:18:36.74,0:18:39.63,Default,,0,0,0,,() ((Қасиетті Рыцарь Қолбасшысы➡
Dialogue: 0,0:18:39.63,0:18:42.48,Default,,0,0,0,,Бізде сөйлесетін маңызды нәрсе бар сияқты)) (Диан)((Мүмкін➡
Dialogue: 0,0:18:42.48,0:18:44.55,Default,,0,0,0,,Тролль патшайымы өткен күнгі оқиғаға қатысты➡
Dialogue: 0,0:18:44.55,0:18:47.13,Default,,0,0,0,,Маған арнайы сыйлық бересіз бе? ))
