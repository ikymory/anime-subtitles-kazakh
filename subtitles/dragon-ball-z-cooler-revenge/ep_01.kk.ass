Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 10,0:00:06.62,0:00:11.29,Default,,0,0,0,,Бұл бәрін өзгертеді.➡
Dialogue: 10,0:00:11.29,0:00:14.33,Default,,0,0,0,,Бұл менің тағдырым.➡
Dialogue: 10,0:00:14.33,0:00:18.00,Default,,0,0,0,,Какароттың тағдыры.➡
Dialogue: 10,0:00:18.00,0:00:23.97,Default,,0,0,0,,Сіздің де тағдырыңыз
Dialogue: 10,0:00:28.64,0:00:32.68,Default,,0,0,0,,〈Фриза және Вегета планетасы➡
Dialogue: 10,0:00:32.68,0:00:37.35,Default,,0,0,0,,Мен олардың барлық Сайяндарды өлтірмек болғанын білдім➡
Dialogue: 10,0:00:37.35,0:00:41.32,Default,,0,0,0,,Сон Гокудың әкесі Бардок ➡
Dialogue: 10,0:00:41.32,0:00:47.93,Default,,0,0,0,,Ол Фриезамен күресуге батылы барған жалғыз адам болды.
Dialogue: 10,0:00:52.70,0:00:55.00,Default,,0,0,0,,〈Дәл сол кезде➡
Dialogue: 10,0:00:55.00,0:01:01.94,Default,,0,0,0,,Төмен дәрежелі жауынгер ретінде дүниеге келген Сон Гоку мінген ғарыш аппараты➡
Dialogue: 10,0:01:01.94,0:01:06.95,Default,,0,0,0,,Ол Жерге қарай ұшырылды〉
Dialogue: 10,0:01:10.95,0:01:13.99,Default,,0,0,0,,Бұл соңы!
Dialogue: 10,0:01:13.99,0:01:15.99,Default,,0,0,0,,Хмм. Ха!
Dialogue: 10,0:01:18.96,0:01:20.56,Default,,0,0,0,,Қай сату кассасынан—
Dialogue: 10,0:01:36.01,0:01:39.98,Default,,0,0,0,,Сайяндардың ақыры осымен аяқталды.
Dialogue: 10,0:01:39.98,0:01:44.02,Default,,0,0,0,,Ах. Фриза-самадан күткендей.
Dialogue: 10,0:01:44.02,0:01:48.99,Default,,0,0,0,,Иә? Не? Сол капсула. Мониторды тексеріңіз.
Dialogue: 10,0:01:48.99,0:01:51.99,Default,,0,0,0,,(пернетақтаны соғу дыбысы)
Dialogue: 10,0:01:54.03,0:01:57.93,Default,,0,0,0,,Әй, сен Сайянның баласы емессің бе?
Dialogue: 10,0:01:57.93,0:02:01.30,Default,,0,0,0,,Ол алыстағы Жер деп аталатын ғаламшарға бет алып барады.
Dialogue: 10,0:02:01.30,0:02:02.97,Default,,0,0,0,,Оны атып тастаңыз ба? (Табақша) А
Dialogue: 10,0:02:02.97,0:02:04.97,Default,,0,0,0,,≪(Қарға) Мені жайына қалдыр. (Табақша) А.
Dialogue: 10,0:02:08.31,0:02:10.61,Default,,0,0,0,,Бұл Фризаға тағайындалған аймақ.➡
Dialogue: 10,0:02:10.61,0:02:14.91,Default,,0,0,0,,Өзің сепкен тұқым. Өздері орып алсын.
Dialogue: 10,0:02:16.95,0:02:19.62,Default,,0,0,0,,Біз бүгін 7 жұлдыз аламыз➡
Dialogue: 10,0:02:19.62,0:02:21.92,Default,,0,0,0,,Басылуы керек
Dialogue: 10,0:02:24.66,0:02:31.00,Default,,0,0,0,,Бірақ сәби болса да, бір Сайянды қашып жіберді.➡
Dialogue: 10,0:02:31.00,0:02:33.00,Default,,0,0,0,,Сайяндарды жойыңыз➡
Dialogue: 10,0:02:33.00,0:02:35.97,Default,,0,0,0,,Бұл аймақты жаулап алу жоспары кейінге қалдырылды➡
Dialogue: 10,0:02:35.97,0:02:39.97,Default,,0,0,0,,Мұның бәрі Фризаның менмендігінің кесірінен.
Dialogue: 10,0:02:43.68,0:02:47.98,Default,,0,0,0,,Фриза әлі тәтті
Dialogue: 10,0:03:11.64,0:03:14.94,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 10,0:03:14.94,0:03:23.32,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:03:23.32,0:03:25.62,Default,,0,0,0,,♬ Бұлт арасынан жарқырап
Dialogue: 10,0:03:25.62,0:03:27.99,Default,,0,0,0,,♬ Ұшып кету (ұшып кету)
Dialogue: 10,0:03:27.99,0:03:35.33,Default,,0,0,0,,♬ Денеңізге тарайтын панорама
Dialogue: 10,0:03:35.33,0:03:40.67,Default,,0,0,0,,♬ Жер бетінен тепкеннен кейін ашуланады (ашулы)
Dialogue: 10,0:03:40.67,0:03:47.64,Default,,0,0,0,,♬ Жанартауды жарып жіберіңіз
Dialogue: 10,0:03:47.64,0:03:53.98,Default,,0,0,0,,♬ Еріп жатқан Солтүстік полюске
Dialogue: 10,0:03:53.98,0:03:57.02,Default,,0,0,0,,♬ Егер динозаврлар болса
Dialogue: 10,0:03:57.02,0:04:02.96,Default,,0,0,0,,♬ Мен доп тебуге дайындалғым келеді.
Dialogue: 10,0:04:02.96,0:04:06.63,Default,,0,0,0,,♬ ЧА-ЛА БАСЫ-ЧА-ЛА
Dialogue: 10,0:04:06.63,0:04:15.63,Default,,0,0,0,,♬ Қандай жағдай болмасын, көңіл-күйім жақсы сияқты
Dialogue: 10,0:04:15.63,0:04:18.94,Default,,0,0,0,,♬ ЧА-ЛА БАСЫ-ЧА-ЛА
Dialogue: 10,0:04:18.94,0:04:24.98,Default,,0,0,0,,♬ Менің жүрегімді елжірететіндей шу шығаратын рух шары...
Dialogue: 10,0:04:24.98,0:04:28.65,Default,,0,0,0,,♬ ЧА-ЛА БАСЫ-ЧА-ЛА
Dialogue: 10,0:04:28.65,0:04:37.66,Default,,0,0,0,,♬ Жалаң баспен арманыңды толтыра аласың
Dialogue: 10,0:04:37.66,0:04:41.33,Default,,0,0,0,,♬ ЧА-ЛА БАСЫ-ЧА-ЛА
Dialogue: 10,0:04:41.33,0:04:48.00,Default,,0,0,0,,♬ Smile Ultra Z көмегімен бүгін мен де өте қуаныштымын
Dialogue: 10,0:04:48.00,0:04:49.67,Default,,0,0,0,,♬ Жарқырау!
Dialogue: 10,0:04:49.67,0:04:56.64,Default,,0,0,0,,～♬
Dialogue: 10,0:05:07.62,0:05:09.96,Default,,0,0,0,,Ах. Ухьяхья!
Dialogue: 10,0:05:09.96,0:05:12.96,Default,,0,0,0,,Гоку. Жаттығуларыңызды соған қалдырыңыз.
Dialogue: 10,0:05:12.96,0:05:17.93,Default,,0,0,0,,Жоқ, ата. Әзірше емес. Ха!
Dialogue: 10,0:05:19.97,0:05:23.64,Default,,0,0,0,,《Гокудың жігіті Намек планетасынан қайтып келді➡
Dialogue: 10,0:05:23.64,0:05:25.94,Default,,0,0,0,,Мен одан да күшті болдым》
Dialogue: 10,0:05:33.98,0:05:38.95,Default,,0,0,0,,Міне, міне, осылай болды.
Dialogue: 10,0:05:41.62,0:05:44.99,Default,,0,0,0,,Гохан-чан. Сіз қолыңыздан келгеннің бәрін істеп жатырсыз.
Dialogue: 10,0:05:44.99,0:05:47.96,Default,,0,0,0,,А, сен тағы да осындасың.➡
Dialogue: 10,0:05:47.96,0:05:51.00,Default,,0,0,0,,Жоқ, Гохан-чан қазір... ≪(Гоку) Жоғары Айдаһар.➡
Dialogue: 10,0:05:51.00,0:05:54.30,Default,,0,0,0,,Гоханның үй тапсырмасына кедергі жасама.
Dialogue: 10,0:05:54.30,0:06:00.94,Default,,0,0,0,,Иә? Бұл Гоку мені үй тапсырмасымен мазаламауы керек.
Dialogue: 10,0:06:00.94,0:06:06.58,Default,,0,0,0,,Гоку, сенің қызбаң бар ма? (Гоку) Эй, менде қызба жоқ.
Dialogue: 10,0:06:06.58,0:06:10.25,Default,,0,0,0,,Жоқ. Гоку, өзіңізді нашар сезініп тұрған шығарсыз.
Dialogue: 10,0:06:10.25,0:06:13.92,Default,,0,0,0,,Бұлай жасамаңыз. Гохан. Тез жасаңыз.
Dialogue: 10,0:06:13.92,0:06:18.29,Default,,0,0,0,,Бұл біртүрлі. Гоку саған сабақ оқы деп жатыр.➡
Dialogue: 10,0:06:18.29,0:06:20.96,Default,,0,0,0,,Мен бұрын ешқашан мұндай нәрсені айтқан емеспін.
Dialogue: 10,0:06:20.96,0:06:22.53,Default,,0,0,0,,Иә? Ах
Dialogue: 10,0:06:24.30,0:06:30.64,Default,,0,0,0,,А, менің ойымша, Гоку тым көп төбелескеннен есінен танып қалды...
Dialogue: 10,0:06:30.64,0:06:35.61,Default,,0,0,0,,Иә? Бұл дұрыс. Бұл басқаша емес.
Dialogue: 10,0:06:35.61,0:06:39.98,Default,,0,0,0,,(Гокудың гуілдеуі)
Dialogue: 10,0:06:39.98,0:06:42.95,Default,,0,0,0,,Ақырында, Гоку...
Dialogue: 10,0:06:42.95,0:06:45.98,Default,,0,0,0,,(Гокудың гуілдеуі)
Dialogue: 10,0:06:45.98,0:06:48.99,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 10,0:06:48.99,0:06:50.99,Default,,0,0,0,,Гохан. Үй тапсырмасын орындауға барынша тырысыңыз.
Dialogue: 10,0:06:50.99,0:06:55.63,Default,,0,0,0,,Гоку, мықты бол.
Dialogue: 10,0:06:55.63,0:06:57.33,Default,,0,0,0,,Гоку! (ызылдаған)
Dialogue: 10,0:06:57.33,0:06:58.93,Default,,0,0,0,,О.
Dialogue: 10,0:06:58.93,0:07:02.27,Default,,0,0,0,,Гохан. Осыны тез бітіріп, кемпингке барайық.
Dialogue: 10,0:07:02.27,0:07:04.57,Default,,0,0,0,,Иә? Чичи не істеп жатыр?
Dialogue: 10,0:07:04.57,0:07:07.94,Default,,0,0,0,,Хаха. Осыны меңзеп тұрсың ба?
Dialogue: 10,0:07:07.94,0:07:09.91,Default,,0,0,0,,Мен уайымдағаным үшін ақымақ болдым.
Dialogue: 10,0:07:09.91,0:07:14.95,Default,,0,0,0,,Иә? Гохан. Тез жасаңыз. Барлығын күтіп ұстау жаман.
Dialogue: 10,0:07:14.95,0:07:17.62,Default,,0,0,0,,Барлығы? ≪(Крин) Хи хи хи...
Dialogue: 10,0:07:17.62,0:07:19.28,Default,,0,0,0,,А? (Оолон) Хехехе...
Dialogue: 10,0:07:19.28,0:07:20.92,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 10,0:07:20.92,0:07:23.96,Default,,0,0,0,,Қазірдің өзінде! Гоку. Иә?
Dialogue: 10,0:07:23.96,0:07:25.96,Default,,0,0,0,,Қайсысы маңыздырақ: кемпинг немесе оқу?
Dialogue: 10,0:07:25.96,0:07:28.96,Default,,0,0,0,,Ки... Шешілді, солай ма?
Dialogue: 10,0:07:28.96,0:07:32.30,Default,,0,0,0,,Мм. Иә иә.
Dialogue: 10,0:07:32.30,0:07:34.60,Default,,0,0,0,,Дұрыс, бұл кемпинг. (Тч) Да...
Dialogue: 10,0:07:34.60,0:07:36.20,Default,,0,0,0,,Ах...
Dialogue: 10,0:07:49.65,0:07:53.32,Default,,0,0,0,,Не! Бізде, Фризада, даңқ қаны бар➡
Dialogue: 10,0:07:53.32,0:07:56.29,Default,,0,0,0,,Төменгі өмір Сайян өлтірді ме?
Dialogue: 10,0:07:56.29,0:08:00.93,Default,,0,0,0,,бұл... Иә. Сену қиын.➡
Dialogue: 10,0:08:00.93,0:08:03.93,Default,,0,0,0,,Жерден келген Сон Гоку атты Сайян.
Dialogue: 10,0:08:05.60,0:08:07.90,Default,,0,0,0,,Сен ақымақ Фриза
Dialogue: 10,0:08:07.90,0:08:12.50,Default,,0,0,0,,Қанша тәтті болса да, маймыл сияқты
Dialogue: 10,0:08:17.28,0:08:21.58,Default,,0,0,0,,《Ха. Бұл супер Сайян емес》
Dialogue: 10,0:08:21.58,0:08:23.62,Default,,0,0,0,,Оңтүстік.
Dialogue: 10,0:08:23.62,0:08:27.92,Default,,0,0,0,,Бірден Жерге аттаныңыз. Сайяндарды құрту➡
Dialogue: 10,0:08:27.92,0:08:30.22,Default,,0,0,0,,Бұл планетаны толығымен жойыңыз
Dialogue: 10,0:08:32.62,0:08:34.93,Default,,0,0,0,,Осы планета сияқты
Dialogue: 10,0:08:46.94,0:08:49.98,Default,,0,0,0,,Хмм, иісі жақсы.
Dialogue: 10,0:08:49.98,0:08:53.65,Default,,0,0,0,,Өйткені, кемпингке келетін болсақ, карри ең жақсы.
Dialogue: 10,0:08:53.65,0:08:56.95,Default,,0,0,0,,Енді Гоку әкелетін балықты грильдеу ғана қалды.
Dialogue: 10,0:08:56.95,0:08:59.95,Default,,0,0,0,,Гохан. Мен сенен оны өртеуіңді сұраймын. Иә.
Dialogue: 10,0:09:02.89,0:09:05.89,Default,,0,0,0,,Жақсы жаңалық. Бұл. Ха.
Dialogue: 10,0:09:07.93,0:09:10.93,Default,,0,0,0,,Татата…｡ Та!
Dialogue: 10,0:09:14.90,0:09:18.90,Default,,0,0,0,,Иә? Хаха. Хаха
Dialogue: 10,0:09:31.95,0:09:34.92,Default,,0,0,0,,Сәлем. Мен мұнымен ғана шыға аламын➡
Dialogue: 10,0:09:34.92,0:09:37.96,Default,,0,0,0,,Тіпті Улонгтың үлкен іші де жақсы.
Dialogue: 10,0:09:37.96,0:09:39.96,Default,,0,0,0,,Иә! Иә?
Dialogue: 10,0:09:42.93,0:09:45.96,Default,,0,0,0,,Иә, Криллин-сан. Иә?
Dialogue: 10,0:09:45.96,0:09:48.97,Default,,0,0,0,,О, оны сонда қалдырыңыз.
Dialogue: 10,0:09:48.97,0:09:52.94,Default,,0,0,0,,Иә? Не? (Хайард Айдаһар) Паопао…
Dialogue: 10,0:09:52.94,0:09:55.64,Default,,0,0,0,,Сәлем. Не...?
Dialogue: 10,0:09:55.64,0:10:07.99,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:10:07.99,0:10:09.99,Default,,0,0,0,,Гохан! Уау
Dialogue: 10,0:10:09.99,0:10:11.99,Default,,0,0,0,,Ах. Cli...
Dialogue: 10,0:10:13.96,0:10:15.96,Default,,0,0,0,,Ах!
Dialogue: 10,0:10:18.00,0:10:20.00,Default,,0,0,0,,мырза...
Dialogue: 10,0:10:21.00,0:10:22.97,Default,,0,0,0,,Жақсы! Жоқ... (Хайард Айдаһар) Паопао...
Dialogue: 10,0:10:22.97,0:10:26.34,Default,,0,0,0,,Иә. Бұл жігіт супер Сайян ба?
Dialogue: 10,0:10:26.34,0:10:30.31,Default,,0,0,0,,Сәлем. Жауынгерлік қуаты бар болғаны 50.
Dialogue: 10,0:10:30.31,0:10:32.98,Default,,0,0,0,,Доренің құйрығынан ұстап тұрғанын есептесек те➡
Dialogue: 10,0:10:32.98,0:10:37.02,Default,,0,0,0,,Бұл аянышты сандар. (Дор) Қараңызшы. Қараңыз. Қараңыз.
Dialogue: 10,0:10:37.02,0:10:39.02,Default,,0,0,0,,Бұл жігіттер Хамонның қағидаларын біледі
Dialogue: 10,0:10:39.02,0:10:41.02,Default,,0,0,0,,Қараңыз. Уау...
Dialogue: 10,0:10:41.02,0:10:44.99,Default,,0,0,0,,Енді қашайық. иә? Эй, эй. Кәне. Тоқта.
Dialogue: 10,0:10:44.99,0:10:47.03,Default,,0,0,0,,≪ Сәлем! Уф
Dialogue: 10,0:10:47.03,0:10:50.03,Default,,0,0,0,,Иә?
Dialogue: 10,0:10:50.03,0:10:52.33,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 10,0:10:52.33,0:10:56.03,Default,,0,0,0,,Ола Сон Гоку. Ола Гоханды босатыңыз.
Dialogue: 10,0:10:56.03,0:11:00.64,Default,,0,0,0,,Сон Гоку? Сонда сіз Фриза-самасыз.
Dialogue: 10,0:11:00.64,0:11:03.21,Default,,0,0,0,,Мен көремін. Бұл жігіт.
Dialogue: 10,0:11:04.98,0:11:07.98,Default,,0,0,0,,Бұл үлкен жауынгерлік күш емес.
Dialogue: 10,0:11:07.98,0:11:11.95,Default,,0,0,0,,Бұл сіздің жауынгерлік күшіңізді бірден арттыруы мүмкін.
Dialogue: 10,0:11:11.95,0:11:14.99,Default,,0,0,0,,Тек жасап көріңіз, сонда түсінесіз.
Dialogue: 10,0:11:14.99,0:11:17.99,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 10,0:11:17.99,0:11:20.96,Default,,0,0,0,,Coola брондалған эскадрильясы (Нейс Доре) Ха!
Dialogue: 10,0:11:20.96,0:11:22.63,Default,,0,0,0,,Нвааах!
Dialogue: 10,0:11:22.63,0:11:24.33,Default,,0,0,0,,Гохан. Криллин.
Dialogue: 10,0:11:24.33,0:11:26.00,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 10,0:11:26.00,0:11:28.00,Default,,0,0,0,,Әке!
Dialogue: 10,0:11:28.00,0:11:29.97,Default,,0,0,0,,Чи! (Дор) Уау!
Dialogue: 10,0:11:29.97,0:11:31.97,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 10,0:11:34.34,0:11:37.01,Default,,0,0,0,,Сәлем! (Дор) Эй!
Dialogue: 10,0:11:37.01,0:11:40.98,Default,,0,0,0,,Ta! Криллин-сан. Криллин-сан
Dialogue: 10,0:11:40.98,0:11:45.02,Default,,0,0,0,,Хмм. Сіз өте жақсы істеп жатырсыз, солай емес пе?
Dialogue: 10,0:11:45.02,0:11:47.02,Default,,0,0,0,,Ха!
Dialogue: 10,0:11:47.02,0:11:49.02,Default,,0,0,0,,Сәлем! (Жақсы) Ки!
Dialogue: 10,0:11:49.02,0:11:50.99,Default,,0,0,0,,Сәлем! Уф
Dialogue: 10,0:11:50.99,0:11:54.03,Default,,0,0,0,,Ta! Уф. Гах...
Dialogue: 10,0:11:54.03,0:11:57.33,Default,,0,0,0,,Хэхехе…｡ Уау
Dialogue: 10,0:11:57.33,0:11:59.97,Default,,0,0,0,,Маймыл!
Dialogue: 10,0:11:59.97,0:12:03.97,Default,,0,0,0,,Уау! Ақымақ!
Dialogue: 10,0:12:03.97,0:12:05.94,Default,,0,0,0,,Чи! Уф
Dialogue: 10,0:12:09.98,0:12:13.98,Default,,0,0,0,,Мықты ұстамағаныңыз үшін... Ой.➡
Dialogue: 10,0:12:13.98,0:12:15.95,Default,,0,0,0,,Уау
Dialogue: 10,0:12:17.95,0:12:21.95,Default,,0,0,0,,Ах. Сіз мені шошыттыңыз. ау.
Dialogue: 10,0:12:25.96,0:12:27.96,Default,,0,0,0,,Иә? (Табақша Жақсы Доре) Ах
Dialogue: 10,0:12:27.96,0:12:29.96,Default,,0,0,0,,Ку... Құла мырза
Dialogue: 10,0:12:34.00,0:12:35.97,Default,,0,0,0,,Ах
Dialogue: 10,0:12:40.01,0:12:43.01,Default,,0,0,0,,Фу... Фриза?
Dialogue: 10,0:12:45.68,0:12:49.95,Default,,0,0,0,,≪ Әке! Иә? Келме, Гохан!
Dialogue: 10,0:12:54.02,0:12:56.99,Default,,0,0,0,,Барлық Сайяндарды өлтіріңіз
Dialogue: 10,0:12:56.99,0:12:58.96,Default,,0,0,0,,Уау. Уф.
Dialogue: 10,0:12:58.96,0:13:00.96,Default,,0,0,0,,Әке. Апыр-ай.
Dialogue: 10,0:13:02.93,0:13:04.93,Default,,0,0,0,,Құт
Dialogue: 10,0:13:18.98,0:13:20.98,Default,,0,0,0,,Құт
Dialogue: 10,0:13:27.99,0:13:29.99,Default,,0,0,0,,Tsk
Dialogue: 10,0:13:37.00,0:13:40.30,Default,,0,0,0,,《Сол позициядан маған кері қайтару техникасын лақтырасың деп күтпедім.➡
Dialogue: 10,0:13:40.30,0:13:43.67,Default,,0,0,0,,Ол Фризаны жеңуі мүмкін еді.
Dialogue: 10,0:13:43.67,0:13:47.01,Default,,0,0,0,,≪(Суса) Сен күткендей, Қуула-сама. Сіз тамаша жұмыс жасадыңыз.
Dialogue: 10,0:13:47.01,0:13:50.01,Default,,0,0,0,,Осымен бүкіл Сайяндар бұл дүниеден ғайып болды.➡
Dialogue: 10,0:13:50.01,0:13:52.01,Default,,0,0,0,,Сонымен...
Dialogue: 10,0:13:52.01,0:13:54.68,Default,,0,0,0,,Сен ақымақ. (Дор) Иә?
Dialogue: 10,0:13:54.68,0:13:57.02,Default,,0,0,0,,Менің жойқын сәулелеріме шомылып жатқанда➡
Dialogue: 10,0:13:57.02,0:14:00.62,Default,,0,0,0,,Сіз маған қарсы көптеген цигон оқтарын аттыңыз.
Dialogue: 10,0:14:00.62,0:14:03.96,Default,,0,0,0,,Ах...｡ (Қарға) Ол тірі.
Dialogue: 10,0:14:03.96,0:14:06.96,Default,,0,0,0,,Оны бірден табыңыз. (Дор Нейс Созер) Ха!
Dialogue: 10,0:14:11.93,0:14:13.97,Default,,0,0,0,,Ха...
Dialogue: 10,0:14:13.97,0:14:16.97,Default,,0,0,0,,Ах. Қарғыс атқыр...
Dialogue: 10,0:14:16.97,0:14:23.94,Default,,0,0,0,,Ахх. Әке. Әке! әке!
Dialogue: 10,0:14:26.98,0:14:30.95,Default,,0,0,0,,Боқ. Скаутердің ешқандай реакциясы жоқ.
Dialogue: 10,0:14:30.95,0:14:34.62,Default,,0,0,0,,Сен қайда бардың? (Дор) Иә? Мен сене алар емеспін.➡
Dialogue: 10,0:14:34.62,0:14:38.92,Default,,0,0,0,,Маған Кулла-саманың жойқын сәулесі түскенде аман қалу мүмкін емес.
Dialogue: 10,0:14:40.96,0:14:42.99,Default,,0,0,0,,Ах...
Dialogue: 10,0:14:42.99,0:14:46.00,Default,,0,0,0,,Ахаха! Ақырында байқадыңыз ба?
Dialogue: 10,0:14:46.00,0:14:49.97,Default,,0,0,0,,Жоғары Айдаһар. Улонг. Ал Гохан және басқалары ше?
Dialogue: 10,0:14:56.01,0:15:02.95,Default,,0,0,0,,Әке. Әке. Әке...
Dialogue: 10,0:15:02.95,0:15:05.95,Default,,0,0,0,,Ах. Бар... Гохан. Әке.
Dialogue: 10,0:15:05.95,0:15:08.92,Default,,0,0,0,,Уф. Уф... Менің денем...
Dialogue: 10,0:15:08.92,0:15:12.92,Default,,0,0,0,,≪(Соққы дыбыс) Ах. Не?
Dialogue: 10,0:15:15.26,0:15:16.86,Default,,0,0,0,,Ах!
Dialogue: 10,0:15:23.27,0:15:27.31,Default,,0,0,0,,Қараңдар! Тірі болсаң шық, Саян.
Dialogue: 10,0:15:27.31,0:15:31.98,Default,,0,0,0,,Хахаха...Егер сен шықпасаң, мен бүкіл планетаны ұшырып жіберемін.
Dialogue: 10,0:15:31.98,0:15:40.99,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:15:40.99,0:15:42.99,Default,,0,0,0,,Боқ...｡ Ах, а...
Dialogue: 10,0:15:47.96,0:15:49.99,Default,,0,0,0,,Гохан.
Dialogue: 10,0:15:49.99,0:15:53.00,Default,,0,0,0,,Хехе...
Dialogue: 10,0:15:53.00,0:16:11.95,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:16:11.95,0:16:14.62,Default,,0,0,0,,Егер сіз осыдан аман қалсаңыз, сіз құбыжықсыз.
Dialogue: 10,0:16:14.62,0:16:16.96,Default,,0,0,0,,Бірақ тым жарқыраған.➡
Dialogue: 10,0:16:16.96,0:16:20.26,Default,,0,0,0,,Осымен мәйітті табу қиын болады.
Dialogue: 10,0:16:20.26,0:16:22.63,Default,,0,0,0,,≪(Кура) Ол әлі өлген жоқ.➡
Dialogue: 10,0:16:22.63,0:16:26.60,Default,,0,0,0,,Оны не болса да тауып, алдыма алып кел.➡
Dialogue: 10,0:16:26.60,0:16:28.60,Default,,0,0,0,,Бүкіл планетаны жою оңай болар еді, бірақ➡
Dialogue: 10,0:16:28.60,0:16:31.97,Default,,0,0,0,,Менің мақтанышым үшін кешіріңіз.
Dialogue: 10,0:16:31.97,0:16:36.98,Default,,0,0,0,,Мен мұны ағамның жауынан кек алу үшін емес, намысымызға кір келтіру үшін істедім➡
Dialogue: 10,0:16:36.98,0:16:39.61,Default,,0,0,0,,Сайяндарды өлтіру➡
Dialogue: 10,0:16:39.61,0:16:42.91,Default,,0,0,0,,Біз осы уақытқа дейін жеттік. Түсінесіз бе? (Табақша Доре Нейс) Хаха
Dialogue: 10,0:16:50.29,0:16:51.89,Default,,0,0,0,,Кеттік. (Урон) Ух... Иә.
Dialogue: 10,0:16:53.96,0:16:57.93,Default,,0,0,0,,Пао...｡ Ааааа!
Dialogue: 10,0:16:57.93,0:16:59.90,Default,,0,0,0,,Не болды! (Оолон) Уф
Dialogue: 10,0:16:59.90,0:17:02.60,Default,,0,0,0,,Гоханның иісін сезе аласыз ба? (Хайард Айдаһар) Пао
Dialogue: 10,0:17:02.60,0:17:05.94,Default,,0,0,0,,Мына жартастың астында. Гохан. Гохан.
Dialogue: 10,0:17:05.94,0:17:07.61,Default,,0,0,0,,≪ Krillin-san
Dialogue: 10,0:17:07.61,0:17:11.61,Default,,0,0,0,,Гохан. Сенімен бәрі жақсы ма? ≪ Иә. Бірақ әкем
Dialogue: 10,0:17:11.61,0:17:14.95,Default,,0,0,0,,Гоку бірдей ме? ≪ Иә. Бұл қорқынышты жара.
Dialogue: 10,0:17:14.95,0:17:17.95,Default,,0,0,0,,Жарайды. Мен тасты дәл қазір жылжытамын.
Dialogue: 10,0:17:17.95,0:17:19.62,Default,,0,0,0,,≪ Krillin-san. Барлаушыға➡
Dialogue: 10,0:17:19.62,0:17:21.92,Default,,0,0,0,,Анықталмау үшін абай болыңыз
Dialogue: 10,0:17:21.92,0:17:24.96,Default,,0,0,0,,Мен білемін. Басқа жануарларды сұраңыз.
Dialogue: 10,0:17:24.96,0:17:27.63,Default,,0,0,0,,Жақсы жұмыс. (Хайард Айдаһар) Пао
Dialogue: 10,0:17:27.63,0:17:31.93,Default,,0,0,0,,Ах... криллин. Жарайды.
Dialogue: 10,0:17:31.93,0:17:35.60,Default,,0,0,0,,Одан да жануарлар.
Dialogue: 10,0:17:35.60,0:17:38.64,Default,,0,0,0,,Улонг пен оның достары қазір көмектесіп жатыр. Уайымдама.
Dialogue: 10,0:17:38.64,0:17:42.31,Default,,0,0,0,,Киіз үй…
Dialogue: 10,0:17:42.31,0:17:47.98,Default,,0,0,0,,Кеттік. Хахаха... Эх! Криллин!
Dialogue: 10,0:17:47.98,0:17:49.65,Default,,0,0,0,,Ах. иә!
Dialogue: 10,0:17:49.65,0:17:51.95,Default,,0,0,0,,Көмектесіңіз! (Крин) Ха!
Dialogue: 10,0:17:54.99,0:17:57.89,Default,,0,0,0,,Мен құтқарылдым. (Таза) Мен оны қойдым.
Dialogue: 10,0:17:57.89,0:17:59.89,Default,,0,0,0,,Міне болды. Ахахах...
Dialogue: 10,0:18:01.93,0:18:05.23,Default,,0,0,0,,Уау. Не? Иә?➡
Dialogue: 10,0:18:05.23,0:18:09.60,Default,,0,0,0,,Сіздің қазіргі реакцияңыз сол бейбақ. Мені қорқыту.
Dialogue: 10,0:18:09.60,0:18:13.94,Default,,0,0,0,,Қарғыс атсын... Олар қазір байқаған болар.➡
Dialogue: 10,0:18:13.94,0:18:16.24,Default,,0,0,0,,Бұл жерден тез қозғалуымыз керек.➡
Dialogue: 10,0:18:16.24,0:18:19.94,Default,,0,0,0,,Гохан. Мен Гокуды көретін боламын, сондықтан Карин-саманың орнына барыңыз➡
Dialogue: 10,0:18:19.94,0:18:22.95,Default,,0,0,0,,Маған сензу бұршақтарын алып беріңізші. Иә.
Dialogue: 10,0:18:22.95,0:18:27.92,Default,,0,0,0,,Бірақ сіз би әдістерін пайдалана алмайсыз. Иә, түсінемін.
Dialogue: 10,0:18:27.92,0:18:29.95,Default,,0,0,0,,Мен Жоғарғы Айдаһардан сұрауым керек пе?
Dialogue: 10,0:18:29.95,0:18:33.63,Default,,0,0,0,,Пао. (Крин) Жақсы бала, Гохан. өтінемін
Dialogue: 10,0:18:33.63,0:18:35.96,Default,,0,0,0,,Иә. (Таза) Мүмкіндігінше жоғары ұшыңыз.➡
Dialogue: 10,0:18:35.96,0:18:37.93,Default,,0,0,0,,Олардың сізді табуына жол бермеңіз. Иә.
Dialogue: 10,0:18:37.93,0:18:41.30,Default,,0,0,0,,Біз тағы да осы жерде тығылып жатырмыз.
Dialogue: 10,0:18:41.30,0:18:42.90,Default,,0,0,0,,Иә
Dialogue: 10,0:18:45.97,0:18:48.94,Default,,0,0,0,,Тексеру. Осымен түн аяқталады.
Dialogue: 10,0:18:51.98,0:18:57.95,Default,,0,0,0,,Дұрыс. Сіз байқаған жоқсыз. Бар. Жоғары айдаһар!
Dialogue: 10,0:19:01.22,0:19:03.82,Default,,0,0,0,,Жылдам жылдам. Бұл солай.
Dialogue: 10,0:19:12.23,0:19:14.83,Default,,0,0,0,,Өтінемін, Гохан.
Dialogue: 10,0:19:17.94,0:19:20.94,Default,,0,0,0,,Айдаһарды жалдаңыз. Сәттілік
Dialogue: 10,0:19:23.91,0:19:29.95,Default,,0,0,0,,А, мен оны көріп тұрмын. Кішкене ғана.
Dialogue: 10,0:19:29.95,0:19:31.95,Default,,0,0,0,,Айдаһарды жалдаңыз Сәттілік
Dialogue: 10,0:19:36.95,0:19:40.96,Default,,0,0,0,,Рахмет, Жоғары Айдаһар. Мен сонда боламын, күте тұрыңыз.
Dialogue: 10,0:19:40.96,0:19:42.96,Default,,0,0,0,,Пао!
Dialogue: 10,0:19:42.96,0:19:44.93,Default,,0,0,0,,Сәттілік...
Dialogue: 10,0:19:46.96,0:19:50.97,Default,,0,0,0,,《Әке, күте тұрыңыз. Міне таяп қалды.》
Dialogue: 10,0:19:56.97,0:20:00.98,Default,,0,0,0,,Жарайды. Мен оны көре аламын.
Dialogue: 10,0:20:00.98,0:20:11.99,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:20:11.99,0:20:16.33,Default,,0,0,0,,Құрметті Қарин. Құрметті Карин, сіз осындасыз ба?
Dialogue: 10,0:20:16.33,0:20:20.00,Default,,0,0,0,,Ах. (Қарин) А. Бұл Гокудың ізденісі ме?
Dialogue: 10,0:20:20.00,0:20:23.97,Default,,0,0,0,,Иә. Умм, менімен Сензу бұршақтарымен бөліскеніңді қалаймын.
Dialogue: 10,0:20:23.97,0:20:27.00,Default,,0,0,0,,Сіз Карин мұнарасына жарты жолда көтерілдіңіз.
Dialogue: 10,0:20:27.00,0:20:31.01,Default,,0,0,0,,Алдама, алдама. Тек қайталап көріңіз.
Dialogue: 10,0:20:31.01,0:20:33.98,Default,,0,0,0,,Әй, бірақ әкем ауыр жарақат алды.
Dialogue: 10,0:20:33.98,0:20:40.02,Default,,0,0,0,,А, мен түсіндім. Мен қайтадан көтерілемін.
Dialogue: 10,0:20:40.02,0:20:42.02,Default,,0,0,0,,Хэхехе... ≪(Яджироба) Бұл бала.
Dialogue: 10,0:20:42.02,0:20:43.99,Default,,0,0,0,,Иә? (Яджироба) Мұны өзіңізбен бірге алыңыз.
Dialogue: 10,0:20:43.99,0:20:46.66,Default,,0,0,0,,А, бұл
Dialogue: 10,0:20:46.66,0:20:49.03,Default,,0,0,0,,Менің ойымша, бұл сензу бұршақтары болуы керек.
Dialogue: 10,0:20:49.03,0:20:52.03,Default,,0,0,0,,Яджиробе. (Яджиробе) Ондай ауыр сөздер айтпа➡
Dialogue: 10,0:20:52.03,0:20:54.00,Default,,0,0,0,,Қыңыр қария. (Қарин) Не?! ➡
Dialogue: 10,0:20:54.00,0:20:57.03,Default,,0,0,0,,Менің тамағымды рұқсатсыз жедің.
Dialogue: 10,0:20:57.03,0:20:58.97,Default,,0,0,0,,Бұл мен оның арасында ешқандай байланыс жоқ.
Dialogue: 10,0:20:58.97,0:21:00.94,Default,,0,0,0,,Мынау. Ах...
Dialogue: 10,0:21:00.94,0:21:05.98,Default,,0,0,0,,Аа, шыншылдығың үшін мен саған ерекше кешірім беремін.
Dialogue: 10,0:21:05.98,0:21:08.98,Default,,0,0,0,,Мен мұны әу бастан ойладым.
Dialogue: 10,0:21:08.98,0:21:13.32,Default,,0,0,0,,Бұл шулы. Сізге көп рахмет.
Dialogue: 10,0:21:13.32,0:21:16.99,Default,,0,0,0,,Мен бұл жақсылықты ешқашан ұмытпаймын.
Dialogue: 10,0:21:16.99,0:21:18.99,Default,,0,0,0,,Иә. Бұл күлкілі.
Dialogue: 10,0:21:18.99,0:21:20.96,Default,,0,0,0,,Сәлем. (Қарин) А.
Dialogue: 10,0:21:20.96,0:21:24.00,Default,,0,0,0,,Балам, мынаны да ал. (Қарин) Жарайды.
Dialogue: 10,0:21:24.00,0:21:28.00,Default,,0,0,0,,Иә? Ах. Рақмет сізге.
Dialogue: 10,0:21:28.00,0:21:30.97,Default,,0,0,0,,Мен бірде-бір рет қолданып көрмедім.
Dialogue: 10,0:21:30.97,0:21:35.97,Default,,0,0,0,,Біраз емес пе? А, онда.
Dialogue: 10,0:21:40.34,0:21:43.95,Default,,0,0,0,,Жоғары Айдаһар! (Хайард Айдаһар) Пао!
Dialogue: 10,0:21:45.65,0:21:49.02,Default,,0,0,0,,Күткеніңізге рахмет. Іске сәт. Тезірек әкеңе бар.
Dialogue: 10,0:21:49.02,0:21:52.69,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Жоғары Айдаһар. (Жоғары айдаһар) Пао!
Dialogue: 10,0:21:52.69,0:21:57.86,Default,,0,0,0,,Хмм. Гоку да жақсы ұл туды.
Dialogue: 10,0:22:03.65,0:22:06.96,Default,,0,0,0,,Айдаһарды жалдаңыз Сәттілік
Dialogue: 10,0:22:06.96,0:22:12.00,Default,,0,0,0,,Ах...｡ Ах. Ах. Ах.
Dialogue: 10,0:22:12.00,0:22:16.97,Default,,0,0,0,,Гоку. Гоку! Гоку!
Dialogue: 10,0:22:16.97,0:22:21.01,Default,,0,0,0,,Га. Жарайды. Ол әлі тірі.
Dialogue: 10,0:22:21.01,0:22:26.01,Default,,0,0,0,,Ах. Хахаха…｡ Гоку. Гохан жақында оралады.➡
Dialogue: 10,0:22:26.01,0:22:28.98,Default,,0,0,0,,Сәттілік. Ах.
Dialogue: 10,0:22:32.65,0:22:34.25,Default,,0,0,0,,《Гохан. Асығыңыз》
Dialogue: 10,0:22:36.02,0:22:41.03,Default,,0,0,0,,Сәлем. Таң болды. (Жақсы) Сіз шынымен тірісіз бе?➡
Dialogue: 10,0:22:41.03,0:22:42.63,Default,,0,0,0,,Бәрі құлаған жоқ па?
Dialogue: 10,0:22:44.33,0:22:49.97,Default,,0,0,0,,Жоғары Айдаһар. Жақында. Пао Пао...
Dialogue: 10,0:22:49.97,0:22:54.64,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе. Тағы бір дем. (Жоғары айдаһар) Пао...
Dialogue: 10,0:22:54.64,0:22:59.91,Default,,0,0,0,,Аа, дұрыс. Мынаны же.
Dialogue: 10,0:23:04.95,0:23:09.99,Default,,0,0,0,,Пао! Апыр-ай! Апыр-ай! Апыр-ай!
Dialogue: 10,0:23:09.99,0:23:14.66,Default,,0,0,0,,Жылдам жылдам. Пао!
Dialogue: 10,0:23:14.66,0:23:16.33,Default,,0,0,0,,болды
Dialogue: 10,0:23:16.33,0:23:21.00,Default,,0,0,0,,Жақсы, жақсы. Dragon жалдаңыз! Хахаха...
Dialogue: 10,0:23:21.00,0:23:23.97,Default,,0,0,0,,≪(Созер) Бала. Ол әлі тірі ме еді?
Dialogue: 10,0:23:23.97,0:23:27.97,Default,,0,0,0,,Жоқ. Сензу бұршақтары менің күшімді арттырды.
Dialogue: 10,0:23:30.01,0:23:32.01,Default,,0,0,0,,Чи!
Dialogue: 10,0:23:32.01,0:23:34.98,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 10,0:23:37.01,0:23:40.02,Default,,0,0,0,,Уау.
Dialogue: 10,0:23:40.02,0:23:43.32,Default,,0,0,0,,Уау! (Хайард Айдаһар) Пао!
Dialogue: 10,0:23:43.32,0:23:47.02,Default,,0,0,0,,Жоғары Айдаһар! Ки! Жабыңыз!
Dialogue: 10,0:23:47.02,0:23:48.96,Default,,0,0,0,,Уау! (Табақша) Ия!
Dialogue: 10,0:23:48.96,0:23:50.63,Default,,0,0,0,,Мм. Ах...
Dialogue: 10,0:23:50.63,0:23:55.97,Default,,0,0,0,,Хэхехе…｡ Ааа…｡ Ааа
Dialogue: 10,0:23:55.97,0:23:58.97,Default,,0,0,0,,Иә? Бұл балада бірдеңе бар.➡
Dialogue: 10,0:23:58.97,0:24:01.94,Default,,0,0,0,,Қараңдаршы, бұл не? Маған сол бейбақты беріңіз.
Dialogue: 10,0:24:01.94,0:24:04.98,Default,,0,0,0,,Ахх... Тексеріңіз. Мен көмектесе алмаймын.
Dialogue: 10,0:24:04.98,0:24:10.95,Default,,0,0,0,,Мен сені осылай өлтіремін. Ааа...
Dialogue: 10,0:24:12.95,0:24:15.99,Default,,0,0,0,,Ах! (Жақсы) Доре!
Dialogue: 10,0:24:15.99,0:24:17.99,Default,,0,0,0,,Бұл кім?
Dialogue: 10,0:24:21.96,0:24:24.33,Default,,0,0,0,,Намекян
Dialogue: 10,0:24:24.33,0:24:27.67,Default,,0,0,0,,Тексеру. Тағы бір оғаш жігіт пайда болды.
Dialogue: 10,0:24:27.67,0:24:30.00,Default,,0,0,0,,Гохан! Сензу бұршақтарын тез жеткізіңіз!
Dialogue: 10,0:24:30.00,0:24:32.34,Default,,0,0,0,,Пи... Пикколо-сан
Dialogue: 10,0:24:32.34,0:24:35.01,Default,,0,0,0,,Сіз... Сюй мырза
Dialogue: 10,0:24:35.01,0:24:38.31,Default,,0,0,0,,көремін. Сіз мұны аздап жасай алатын сияқтысыз.
Dialogue: 10,0:24:38.31,0:24:41.91,Default,,0,0,0,,Жай қалжың. Апыр-ай!
Dialogue: 10,0:24:44.01,0:24:47.02,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 10,0:24:47.02,0:24:50.99,Default,,0,0,0,,Уа. Уа…. Уа!
Dialogue: 10,0:24:51.96,0:24:53.96,Default,,0,0,0,,Бейбақ! Алақай!
Dialogue: 10,0:24:53.96,0:24:56.56,Default,,0,0,0,,Уау! (Пиколо) Гохан, не істеп жатырсың!
Dialogue: 10,0:24:58.63,0:25:00.97,Default,,0,0,0,,Тез жүр!
Dialogue: 10,0:25:00.97,0:25:03.60,Default,,0,0,0,,Иә. Рахмет, Пикколо-сан.
Dialogue: 10,0:25:03.60,0:25:06.94,Default,,0,0,0,,Бейбақ. Мен оның қашып кетуіне рұқсат беруім керек пе?
Dialogue: 10,0:25:06.94,0:25:08.94,Default,,0,0,0,,Сәлем! Алақай!
Dialogue: 10,0:25:10.61,0:25:12.21,Default,,0,0,0,,Ха! (Жақсы) Қалпақ
Dialogue: 10,0:25:13.98,0:25:15.98,Default,,0,0,0,,Ке. Ақымақ.
Dialogue: 10,0:25:18.32,0:25:20.99,Default,,0,0,0,,Доре Бұл сіздің артыңызда! (Жақсы) Не! Ах
Dialogue: 10,0:25:20.99,0:25:22.99,Default,,0,0,0,,Уф! Уф
Dialogue: 10,0:25:27.96,0:25:30.96,Default,,0,0,0,,Уау. Ха!
Dialogue: 10,0:25:35.67,0:25:37.27,Default,,0,0,0,,Ах, сонда ол ма еді?
Dialogue: 10,0:25:38.97,0:25:45.01,Default,,0,0,0,,Уа. Ах. Мынадай нәрсе. Уф. Апыр-ай. Апыр-ай! ➡
Dialogue: 10,0:25:45.01,0:25:47.98,Default,,0,0,0,,Уау!
Dialogue: 10,0:25:49.95,0:25:54.92,Default,,0,0,0,,Доре! Сәлем! Шах!
Dialogue: 10,0:25:57.96,0:26:00.62,Default,,0,0,0,,Оңтүстік! (Табақша)
Dialogue: 10,0:26:00.62,0:26:02.26,Default,,0,0,0,,Жеңдер!
Dialogue: 10,0:26:02.26,0:26:06.93,Default,,0,0,0,,Уау! Ах!
Dialogue: 10,0:26:06.93,0:26:11.97,Default,,0,0,0,,Жарайды, Найз. Қалғанын саған қалдырамын. Бала. Сізге қашып кетуге рұқсат етемін бе?
Dialogue: 10,0:26:11.97,0:26:15.94,Default,,0,0,0,,Хи хи хи... Бұл сенің де соңы.➡
Dialogue: 10,0:26:15.94,0:26:18.98,Default,,0,0,0,,Енді бізге неше секунд қалды?
Dialogue: 10,0:26:18.98,0:26:24.95,Default,,0,0,0,,Келіңіздер. (Жақсы)...Гах! Ах!
Dialogue: 10,0:26:30.99,0:26:32.99,Default,,0,0,0,,Иә?
Dialogue: 10,0:26:32.99,0:26:34.96,Default,,0,0,0,,Иә! Ха!
Dialogue: 10,0:26:34.96,0:26:39.00,Default,,0,0,0,,Сәлем! (Табақша) Сен…｡ Ааааааааааааааааааа.➡
Dialogue: 10,0:26:39.00,0:26:42.00,Default,,0,0,0,,Қарғыс атсын! Та!
Dialogue: 10,0:26:48.94,0:26:51.91,Default,,0,0,0,,Уф. Алақай!
Dialogue: 10,0:26:54.95,0:26:57.55,Default,,0,0,0,,Хахаха...
Dialogue: 10,0:27:01.62,0:27:03.89,Default,,0,0,0,,Уф. Ах.
Dialogue: 10,0:27:05.96,0:27:08.26,Default,,0,0,0,,Ал егер Цуки Кира болса, онда Цуки Нианы өлтіреді
Dialogue: 10,0:27:08.26,0:27:11.86,Default,,0,0,0,,Иә. Алақай!
Dialogue: 10,0:27:15.97,0:27:18.97,Default,,0,0,0,,Ах. О?
Dialogue: 10,0:27:18.97,0:27:22.94,Default,,0,0,0,,Хахаха...｡ Өл.
Dialogue: 10,0:27:29.98,0:27:32.95,Default,,0,0,0,,Сәлем! (Пиколо) Ой
Dialogue: 10,0:27:32.95,0:27:34.95,Default,,0,0,0,,Не…｡ О!
Dialogue: 10,0:27:37.99,0:27:39.99,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 10,0:27:39.99,0:27:42.96,Default,,0,0,0,,≪(Кура) Оңтүстік! Баланы қуу керек.
Dialogue: 10,0:27:42.96,0:27:48.97,Default,,0,0,0,,Қарғыс атсын! Апыр-ай! Гах...｡ Ой
Dialogue: 10,0:27:50.93,0:27:57.27,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:27:57.27,0:28:02.88,Default,,0,0,0,,Уа. Фриза... Уау!
Dialogue: 10,0:28:04.62,0:28:06.92,Default,,0,0,0,,Гоханның жігіті баяу.
Dialogue: 10,0:28:08.92,0:28:10.95,Default,,0,0,0,,Гоку. Іске сәт.
Dialogue: 10,0:28:10.95,0:28:14.96,Default,,0,0,0,,≪ Криллин-сан! (Таза) Иә? Гохан!
Dialogue: 10,0:28:14.96,0:28:17.29,Default,,0,0,0,,Әке. Жоғары Айдаһар туралы не деуге болады?
Dialogue: 10,0:28:17.29,0:28:19.63,Default,,0,0,0,,А, олар мені байқады➡
Dialogue: 10,0:28:19.63,0:28:23.60,Default,,0,0,0,,Осылайша ол жойылды. Бірақ сензу бұршақтары осында.
Dialogue: 10,0:28:23.60,0:28:26.64,Default,,0,0,0,,Сен жақсы жұмыс істедің. Гоку қазір жақсы.
Dialogue: 10,0:28:26.64,0:28:29.64,Default,,0,0,0,,Бар... Гохан. Кешіріңіз.
Dialogue: 10,0:28:29.64,0:28:32.98,Default,,0,0,0,,Мен бірден Жоғары Айдаһарды іздеймін.
Dialogue: 10,0:28:32.98,0:28:34.98,Default,,0,0,0,,Жақсы. Қалғанын маған қалдыр.
Dialogue: 10,0:28:34.98,0:28:38.32,Default,,0,0,0,,Ах!
Dialogue: 10,0:28:38.32,0:28:40.98,Default,,0,0,0,,Хаха. Сіз осындай жерде болуды жек көрдіңіз бе?
Dialogue: 10,0:28:40.98,0:28:45.29,Default,,0,0,0,,Жоқ. Ол қосылды. Жоқ...
Dialogue: 10,0:28:45.29,0:28:51.60,Default,,0,0,0,,Қарғыс атсын. Мен сонда болдым. Сен бейбақ! Келмесең
Dialogue: 10,0:28:51.60,0:28:53.90,Default,,0,0,0,,Хаха...
Dialogue: 10,0:28:53.90,0:28:58.27,Default,,0,0,0,,Қарғыс атсын... Әзірге?
Dialogue: 10,0:28:58.27,0:28:59.94,Default,,0,0,0,,《Қарғыс атсын...》
Dialogue: 10,0:28:59.94,0:29:01.61,Default,,0,0,0,,Ах
Dialogue: 10,0:29:01.61,0:29:04.91,Default,,0,0,0,,《Бала. Мынаны да алыңыз》
Dialogue: 10,0:29:04.91,0:29:07.95,Default,,0,0,0,,болды. Әкесі: Иә.
Dialogue: 10,0:29:07.95,0:29:10.95,Default,,0,0,0,,Ах. Гохан. Бұл...
Dialogue: 10,0:29:10.95,0:29:13.92,Default,,0,0,0,,Жай ғана жеп қойыңыз.
Dialogue: 10,0:29:13.92,0:29:16.92,Default,,0,0,0,,Tsk! (Крин) Ах! Уау
Dialogue: 10,0:29:18.96,0:29:20.96,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 10,0:29:20.96,0:29:23.93,Default,,0,0,0,,Хе. Шах!
Dialogue: 10,0:29:23.93,0:29:26.63,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 10,0:29:26.63,0:29:28.90,Default,,0,0,0,,Чи! (Крин) О. Ахх.
Dialogue: 10,0:29:30.97,0:29:36.31,Default,,0,0,0,,Криллин-сан! Жарайды... Таа!
Dialogue: 10,0:29:36.31,0:29:37.91,Default,,0,0,0,,Уау. (саус) брат!
Dialogue: 10,0:29:39.98,0:29:47.62,Default,,0,0,0,,Иә. Қандай бейкүнә адам. Жарайды онда. Қалған қоқыстардан арылайық.
Dialogue: 10,0:29:47.62,0:29:49.92,Default,,0,0,0,,Бұл кішкентай ғана нәрсе.
Dialogue: 10,0:29:58.00,0:30:02.00,Default,,0,0,0,,Иә? Не? Бұл реакция.➡
Dialogue: 10,0:30:02.00,0:30:03.97,Default,,0,0,0,,Қуат жылдам өсуде
Dialogue: 10,0:30:05.67,0:30:07.34,Default,,0,0,0,,Бұл өте ақымақ.➡
Dialogue: 10,0:30:07.34,0:30:11.01,Default,,0,0,0,,Бұл жігіт ол жерде болмауы керек еді.➡
Dialogue: 10,0:30:11.01,0:30:13.01,Default,,0,0,0,,(Гиран) Қалай болғанда да, Курокири-сан, комиссия үшін саған сенемін.
Dialogue: 10,0:30:14.98,0:30:16.98,Default,,0,0,0,,Ах
Dialogue: 10,0:30:20.02,0:30:22.02,Default,,0,0,0,,Га
Dialogue: 10,0:30:26.99,0:30:31.70,Default,,0,0,0,,Бар... Гоку. Ах.
Dialogue: 10,0:30:31.70,0:30:33.33,Default,,0,0,0,,Криллин
Dialogue: 10,0:30:33.33,0:30:37.67,Default,,0,0,0,,О... о... әке.
Dialogue: 10,0:30:37.67,0:30:39.37,Default,,0,0,0,,Гохан
Dialogue: 10,0:30:39.37,0:30:40.94,Default,,0,0,0,,Сен, неге!
Dialogue: 10,0:30:44.01,0:30:46.71,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 10,0:30:46.71,0:30:51.95,Default,,0,0,0,,Сізбен бәсекелестік жоқ. Енді өз планетаңызға оралыңыз.
Dialogue: 10,0:30:51.95,0:30:55.99,Default,,0,0,0,,≪(Кура) О. Ақыры шықтың. Сен Сайян.
Dialogue: 10,0:30:55.99,0:30:57.99,Default,,0,0,0,,Құрметті Кула
Dialogue: 10,0:30:57.99,0:30:59.59,Default,,0,0,0,,Иә?
Dialogue: 10,0:31:01.33,0:31:03.96,Default,,0,0,0,,Бұл сіздің достарыңыздың бірі ме?
Dialogue: 10,0:31:03.96,0:31:06.00,Default,,0,0,0,,Ах. Пикколо
Dialogue: 10,0:31:06.00,0:31:09.00,Default,,0,0,0,,Хахаха... Сен ақымақсың.
Dialogue: 10,0:31:09.00,0:31:11.97,Default,,0,0,0,,Менің ішімнен шықты.➡
Dialogue: 10,0:31:11.97,0:31:16.64,Default,,0,0,0,,Сол Намекиан сенің братыңды қорғай алса екен➡
Dialogue: 10,0:31:16.64,0:31:19.31,Default,,0,0,0,,Бұл менің басымнан өтпегенін қалаймын.
Dialogue: 10,0:31:19.31,0:31:20.98,Default,,0,0,0,,Қабылдау
Dialogue: 10,0:31:20.98,0:31:23.98,Default,,0,0,0,,Ах!
Dialogue: 10,0:31:23.98,0:31:25.98,Default,,0,0,0,,Уау. Ах.
Dialogue: 10,0:31:32.99,0:31:34.99,Default,,0,0,0,,Ах...
Dialogue: 10,0:31:39.03,0:31:42.00,Default,,0,0,0,,Хун
Dialogue: 10,0:31:42.00,0:31:44.00,Default,,0,0,0,,Құт
Dialogue: 10,0:31:44.00,0:31:46.37,Default,,0,0,0,,Эй!
Dialogue: 10,0:31:46.37,0:31:49.94,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 10,0:31:49.94,0:31:55.28,Default,,0,0,0,,Сіз... Тіпті Ола үшін Пикколо
Dialogue: 10,0:31:55.28,0:32:00.98,Default,,0,0,0,,Хмм. Тек төбелесу үшін ғана туған Сайандарда мұндай сезім бар ма?
Dialogue: 10,0:32:00.98,0:32:04.66,Default,,0,0,0,,Ола - жер бетінде өскен Сайян!
Dialogue: 10,0:32:04.66,0:32:06.99,Default,,0,0,0,,Уау!
Dialogue: 10,0:32:06.99,0:32:09.96,Default,,0,0,0,,Хмм. Ол кездегі бала ма?
Dialogue: 10,0:32:09.96,0:32:11.96,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 10,0:32:13.63,0:32:18.24,Default,,0,0,0,,Келіңіздер. Маған супер Сайянның күшін көрсетіңіз.
Dialogue: 10,0:32:19.97,0:32:22.97,Default,,0,0,0,,Мен сені кешірмеймін! Апыр-ай!
Dialogue: 10,0:32:27.98,0:32:32.98,Default,,0,0,0,,Уау! Дада...! Әке!
Dialogue: 10,0:32:36.02,0:32:38.99,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 10,0:32:38.99,0:32:43.03,Default,,0,0,0,,Мен ағама ұқсамаймын. Апыр-ай.
Dialogue: 10,0:32:43.03,0:32:55.94,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:32:55.94,0:32:59.98,Default,,0,0,0,,Уау. Апыр-ай!
Dialogue: 10,0:32:59.98,0:33:04.95,Default,,0,0,0,,Қарғыс атсын...｡ Бұл...
Dialogue: 10,0:33:04.95,0:33:16.96,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:33:16.96,0:33:19.00,Default,,0,0,0,,О
Dialogue: 10,0:33:19.00,0:33:21.00,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 10,0:33:24.97,0:33:28.01,Default,,0,0,0,,Мм. Бұлай етпе.➡
Dialogue: 10,0:33:28.01,0:33:31.31,Default,,0,0,0,,Бар болғаны інімді жеңдіңіз.➡
Dialogue: 10,0:33:31.31,0:33:36.68,Default,,0,0,0,,Бірақ енді нағыз тозақ келді. Мына тозақты қараңыз➡
Dialogue: 10,0:33:36.68,0:33:41.32,Default,,0,0,0,,Қанша жыласаң да аямаймын.➡
Dialogue: 10,0:33:41.32,0:33:43.92,Default,,0,0,0,,Мен сені жыртып тастамайынша емес
Dialogue: 10,0:33:45.99,0:33:50.93,Default,,0,0,0,,Хмм. Тағы да. Иә?
Dialogue: 10,0:33:50.93,0:33:56.97,Default,,0,0,0,,Мен ағамнан да көп өзгере аламын.
Dialogue: 10,0:33:56.97,0:33:58.64,Default,,0,0,0,,Не!
Dialogue: 10,0:33:58.64,0:34:03.64,Default,,0,0,0,,Өзіңізді құрметтеңіз. Сіз менің түбегейлі өзгерісімді көре аласыз➡
Dialogue: 10,0:34:03.64,0:34:06.98,Default,,0,0,0,,Сіз бірінші және соңғысыз!
Dialogue: 10,0:34:06.98,0:34:12.95,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:34:12.95,0:34:14.99,Default,,0,0,0,,Ах!
Dialogue: 10,0:34:14.99,0:34:18.99,Default,,0,0,0,,Ааа!
Dialogue: 10,0:34:18.99,0:34:20.96,Default,,0,0,0,,Ах. Қарғыс атқыр...
Dialogue: 10,0:34:20.96,0:34:36.01,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:34:36.01,0:34:38.01,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 10,0:34:38.01,0:34:40.61,Default,,0,0,0,,Ол Фризаға қарағанда ғажайып.
Dialogue: 10,0:34:42.35,0:34:48.92,Default,,0,0,0,,Хаха...
Dialogue: 10,0:34:48.92,0:34:52.52,Default,,0,0,0,,бастайық
Dialogue: 10,0:34:55.27,0:34:57.24,Default,,0,0,0,,Құт
Dialogue: 10,0:35:00.91,0:35:02.51,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 10,0:35:05.58,0:35:07.55,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 10,0:35:09.62,0:35:11.62,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 10,0:35:15.93,0:35:19.56,Default,,0,0,0,,Уф...｡ Уау!
Dialogue: 10,0:35:22.63,0:35:26.57,Default,,0,0,0,,Хмм. Хахаха...
Dialogue: 10,0:35:39.22,0:35:42.55,Default,,0,0,0,,Хмм. Сайян күткендей.
Dialogue: 10,0:35:54.93,0:35:56.50,Default,,0,0,0,,Уау
Dialogue: 10,0:35:59.60,0:36:01.57,Default,,0,0,0,,Уау.
Dialogue: 10,0:36:04.54,0:36:07.61,Default,,0,0,0,,Уф. Апыр-ай.
Dialogue: 10,0:36:07.61,0:36:13.25,Default,,0,0,0,,Не болды? Супер Сайянның күші осындай ма?
Dialogue: 10,0:36:13.25,0:36:16.62,Default,,0,0,0,,Құт. Құт. Ха!
Dialogue: 10,0:36:16.62,0:36:25.56,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:36:25.56,0:36:29.63,Default,,0,0,0,,Уф! Апыр-ай!
Dialogue: 10,0:36:29.63,0:36:32.60,Default,,0,0,0,,Уау. Ааа...
Dialogue: 10,0:36:36.64,0:36:38.54,Default,,0,0,0,,Ах!
Dialogue: 10,0:36:38.54,0:36:54.59,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:36:54.59,0:36:59.56,Default,,0,0,0,,Мм. Хахаха... Сізге ұнайды.
Dialogue: 10,0:37:03.60,0:37:05.60,Default,,0,0,0,,Уф
Dialogue: 10,0:37:07.57,0:37:09.27,Default,,0,0,0,,Иә?
Dialogue: 10,0:37:09.27,0:37:11.54,Default,,0,0,0,,Ха!
Dialogue: 10,0:37:19.58,0:37:23.62,Default,,0,0,0,,Не! Апыр-ай! Апыр-ай!
Dialogue: 10,0:37:23.62,0:37:26.59,Default,,0,0,0,,Уау! Ах
Dialogue: 10,0:37:28.59,0:37:36.27,Default,,0,0,0,,Уау! Апыр-ай! Ах...
Dialogue: 10,0:37:36.27,0:37:38.50,Default,,0,0,0,,Мм. Қызықсыз.➡
Dialogue: 10,0:37:38.50,0:37:42.51,Default,,0,0,0,,Өйткені, Супер Сайандар аңызға айналған жандар болған.
Dialogue: 10,0:37:44.24,0:37:49.55,Default,,0,0,0,,Мен сені осы жұлдызмен бірге ғаламның шаңына айналдырамын.➡
Dialogue: 10,0:37:49.55,0:37:52.58,Default,,0,0,0,,Бұл дүниеде маған тең келетін ешкім жоқ.
Dialogue: 10,0:37:54.85,0:37:57.45,Default,,0,0,0,,Мен әлемдегі ең күштімін!
Dialogue: 10,0:38:05.56,0:38:09.57,Default,,0,0,0,,Уф... Не... не болып жатыр? Ах...
Dialogue: 10,0:38:09.57,0:38:16.54,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 10,0:38:16.54,0:38:19.58,Default,,0,0,0,,《Гоку...》
Dialogue: 10,0:38:19.58,0:38:22.21,Default,,0,0,0,,《О... әке》
Dialogue: 10,0:38:22.21,0:38:25.52,Default,,0,0,0,,Ku… криллин. Гохан
Dialogue: 10,0:38:27.55,0:38:29.55,Default,,0,0,0,,Пикколо
Dialogue: 10,0:38:36.56,0:38:48.17,Default,,0,0,0,,Ах... Ми... Барлығы, кешіріңіздер. Мен үшін.
Dialogue: 10,0:38:52.54,0:38:56.58,Default,,0,0,0,,Хаха...
Dialogue: 10,0:38:56.58,0:38:59.58,Default,,0,0,0,,Ха!
Dialogue: 10,0:38:59.58,0:39:01.55,Default,,0,0,0,,Иә?
Dialogue: 10,0:39:15.53,0:39:19.54,Default,,0,0,0,,Не... не? не болды
Dialogue: 10,0:39:21.57,0:39:24.54,Default,,0,0,0,,Ах, бұл өзгеріс.
Dialogue: 10,0:39:27.91,0:39:31.48,Default,,0,0,0,,Цк. Аяқтаңыз!
Dialogue: 10,0:39:33.28,0:39:34.95,Default,,0,0,0,,Қазіргі жағдайда оның барар жері жоқ.
Dialogue: 10,0:39:34.95,0:39:37.22,Default,,0,0,0,,Сіз бұл планетаны бүлдіріп жатырсыз
Dialogue: 10,0:39:38.92,0:39:40.59,Default,,0,0,0,,А...
Dialogue: 10,0:39:40.59,0:39:44.56,Default,,0,0,0,,Балалар, сендер өздеріңді қанағаттандыру үшін қанша планетаны жоюларың керек?
Dialogue: 10,0:39:44.56,0:39:47.56,Default,,0,0,0,,Қарғыс атсын, ақымақ!
Dialogue: 10,0:39:50.60,0:39:55.27,Default,,0,0,0,,Қайта кешірім сұрасаң да кешірмеймін, қоқыс!
Dialogue: 10,0:39:55.27,0:39:56.94,Default,,0,0,0,,Уф
Dialogue: 10,0:39:56.94,0:39:59.54,Default,,0,0,0,,Сәлем! (Қарға) Уау. Апыр-ай.
Dialogue: 10,0:40:02.61,0:40:05.58,Default,,0,0,0,,Уа. ау. Ой.➡
Dialogue: 10,0:40:05.58,0:40:12.32,Default,,0,0,0,,Хэхехе…｡➡
Dialogue: 10,0:40:12.32,0:40:15.99,Default,,0,0,0,,Мен көремін. Менің інім маған тең келмейді.➡
Dialogue: 10,0:40:15.99,0:40:19.56,Default,,0,0,0,,Бірақ... Ия!
Dialogue: 10,0:40:23.60,0:40:25.20,Default,,0,0,0,,Иә?
Dialogue: 10,0:40:28.67,0:40:30.34,Default,,0,0,0,,Уа.
Dialogue: 10,0:40:30.34,0:40:36.68,Default,,0,0,0,,Хахаха... Сақтықты түсірдің. Мен саған ағамнан ерекшемін дедім.➡
Dialogue: 10,0:40:36.68,0:40:40.65,Default,,0,0,0,,Бұл планета түгел жоғалып кетуі керек!
Dialogue: 10,0:40:47.59,0:40:51.56,Default,,0,0,0,,Ха!
Dialogue: 10,0:40:51.56,0:40:57.60,Default,,0,0,0,,Уау. Апыр-ай!
Dialogue: 10,0:40:57.60,0:41:00.57,Default,,0,0,0,,Хахаха...｡ Ақымақ.➡
Dialogue: 10,0:41:00.57,0:41:05.58,Default,,0,0,0,,Мен жақсы жұмыс жасадым деп айтқым келеді, бірақ мен әлемдегі ең күштімін!
Dialogue: 10,0:41:09.31,0:41:14.65,Default,,0,0,0,,Уау. Мен... оның бұл жерге түсуіне жол бермеймін.
Dialogue: 10,0:41:14.65,0:41:21.59,Default,,0,0,0,,Уау. Қарғыс атсын. Апыр-ай! Уау
Dialogue: 10,0:41:23.66,0:41:28.63,Default,,0,0,0,,Хахаха... Бұл планетаның соңы.➡
Dialogue: 10,0:41:28.63,0:41:31.60,Default,,0,0,0,,Сайяндардың бәрі де бұл дүниеден ғайып болды.➡
Dialogue: 10,0:41:31.60,0:41:35.61,Default,,0,0,0,,Хаха...
Dialogue: 10,0:41:38.24,0:41:39.94,Default,,0,0,0,,Ах
Dialogue: 10,0:41:39.94,0:41:43.58,Default,,0,0,0,,Ах. Қарғыс атсын. Апыр-ай.
Dialogue: 10,0:41:43.58,0:41:49.55,Default,,0,0,0,,Ха!
Dialogue: 10,0:41:54.59,0:41:57.56,Default,,0,0,0,,Уф. Не! ➡
Dialogue: 10,0:41:57.56,0:42:02.57,Default,,0,0,0,,Ах. Уф. Апыр-ай!
Dialogue: 10,0:42:05.60,0:42:10.64,Default,,0,0,0,,Ах...｡ Мен бұл деңгейде жеңілемін бе?➡
Dialogue: 10,0:42:10.64,0:42:13.61,Default,,0,0,0,,Уф. Уф. Уф!
Dialogue: 10,0:42:22.65,0:42:24.22,Default,,0,0,0,,Не!
Dialogue: 10,0:42:28.59,0:42:31.59,Default,,0,0,0,,Уау!
Dialogue: 10,0:42:33.93,0:42:38.20,Default,,0,0,0,,《Кула-сама. Мен сені атып тастайын ба?》
Dialogue: 10,0:42:38.20,0:42:39.90,Default,,0,0,0,,《Оны жай қалдыр.➡
Dialogue: 10,0:42:39.90,0:42:44.54,Default,,0,0,0,,Өзің сепкен тұқым. Өздері орып алсын.➡
Dialogue: 10,0:42:44.54,0:42:49.21,Default,,0,0,0,,Фриза әлі тәтті》
Dialogue: 10,0:42:49.21,0:42:53.55,Default,,0,0,0,,《Ах! Сол кезде түсіріп алсам ғой.➡
Dialogue: 10,0:42:53.55,0:43:00.59,Default,,0,0,0,,Тәтті болған жалғыз Фриза емес еді. Апыр-ай! 》
Dialogue: 10,0:43:42.93,0:43:48.57,Default,,0,0,0,,Сәлем… барлығына. О... мен жасадым.
Dialogue: 10,0:43:48.57,0:43:50.54,Default,,0,0,0,,Өтінемін... Гоку
Dialogue: 10,0:43:52.24,0:43:53.91,Default,,0,0,0,,Әкем
Dialogue: 10,0:43:53.91,0:43:57.58,Default,,0,0,0,,Балалар... Айдаһарды да жалдаңдар. Пао
Dialogue: 10,0:43:57.58,0:43:59.28,Default,,0,0,0,,Иә... жақсы.
Dialogue: 10,0:43:59.28,0:44:04.62,Default,,0,0,0,,Иә. Бірақ Пикколо-сан еш жерден табылмайды.
Dialogue: 10,0:44:04.62,0:44:08.59,Default,,0,0,0,,Бұл ол туралы. Ол қайтадан шығады.
Dialogue: 10,0:44:08.59,0:44:14.63,Default,,0,0,0,,Дұрыс. Иә? Ах
Dialogue: 10,0:44:14.63,0:44:19.60,Default,,0,0,0,,Пикколо мырза. Ахх. (Крин) Ахх.
Dialogue: 10,0:44:19.60,0:44:24.64,Default,,0,0,0,,Хаха...
Dialogue: 10,0:44:24.64,0:44:27.61,Default,,0,0,0,,Ах…｡ Ах…
Dialogue: 10,0:44:27.61,0:44:30.58,Default,,0,0,0,,Хаха...
Dialogue: 10,0:44:32.58,0:44:34.58,Default,,0,0,0,,Ал енді—
Dialogue: 10,0:44:36.62,0:44:38.62,Default,,0,0,0,,Га. Ах...
Dialogue: 10,0:44:42.59,0:44:44.16,Default,,0,0,0,,Ах!
Dialogue: 10,0:44:47.23,0:44:49.23,Default,,0,0,0,,Пикколо мырза
Dialogue: 10,0:44:51.90,0:44:53.47,Default,,0,0,0,,Пикколо мырза
Dialogue: 10,0:44:56.54,0:45:02.55,Default,,0,0,0,,Әй, Пикколо!
Dialogue: 10,0:45:11.22,0:45:15.53,Default,,0,0,0,,≪ Пикколо мырза!
Dialogue: 10,0:45:18.96,0:45:20.63,Default,,0,0,0,,Хун
Dialogue: 10,0:45:20.63,0:45:37.58,Default,,0,0,0,,♬ КӨМЕК КӨМЕК……
Dialogue: 10,0:45:39.58,0:45:42.55,Default,,0,0,0,,♬ Бірінен соң бірі келеді
Dialogue: 10,0:45:42.55,0:45:45.52,Default,,0,0,0,,♬ КӨМЕК КӨМЕК……
Dialogue: 10,0:45:45.52,0:45:54.53,Default,,0,0,0,,♬ Қарсыласудың шексіз саяхаты
Dialogue: 10,0:45:54.53,0:45:57.60,Default,,0,0,0,,♬ Ол барған сайын қызады
Dialogue: 10,0:45:57.60,0:46:00.57,Default,,0,0,0,,♬ КӨМЕК КӨМЕК……
Dialogue: 10,0:46:00.57,0:46:09.21,Default,,0,0,0,,♬ Кеудемдегі ашудың қаны
Dialogue: 10,0:46:09.21,0:46:13.25,Default,,0,0,0,,♬ Біз жер бетінде өстік
Dialogue: 10,0:46:13.25,0:46:16.59,Default,,0,0,0,,♬ Саған сенген кезім
Dialogue: 10,0:46:16.59,0:46:24.26,Default,,0,0,0,,♬ Жоғалтқан күлкіңді қайтар!
Dialogue: 10,0:46:24.26,0:46:25.96,Default,,0,0,0,,♬ Тобикикири Тобикикири
Dialogue: 10,0:46:25.96,0:46:27.63,Default,,0,0,0,,♬ Мықты болыңыз
Dialogue: 10,0:46:27.63,0:46:29.63,Default,,0,0,0,,♬ Тобикикири Тобикикири
Dialogue: 10,0:46:29.63,0:46:31.60,Default,,0,0,0,,♬ Мені ұр!
Dialogue: 10,0:46:31.60,0:46:33.57,Default,,0,0,0,,♬ Қазір! Оян!
Dialogue: 10,0:46:33.57,0:46:39.24,Default,,0,0,0,,♬ Ең күшті жел
Dialogue: 10,0:46:39.24,0:46:40.91,Default,,0,0,0,,♬ Тобикикири Тобикикири
Dialogue: 10,0:46:40.91,0:46:42.91,Default,,0,0,0,,♬ Күшті!
Dialogue: 10,0:46:42.91,0:46:44.58,Default,,0,0,0,,♬ Тобикикири Тобикикири
Dialogue: 10,0:46:44.58,0:46:46.55,Default,,0,0,0,,♬ Оны нокаутқа түсіріңіз!
Dialogue: 10,0:46:46.55,0:46:51.52,Default,,0,0,0,,♬ Қазір! Байқап көріңіз! ең күшті күш
Dialogue: 0,0:46:53.02,0:46:59.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory