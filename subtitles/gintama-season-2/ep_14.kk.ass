Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.95,0:00:06.63,Default,,0,0,0,,♪~
Dialogue: 0,0:01:43.35,0:01:50.31,Default,,0,0,0,,(Қаданың күлуі)
Dialogue: 0,0:01:55.11,0:01:56.74,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:01:58.28,0:02:00.74,Default,,0,0,0,,Динг немесе жарты...
Dialogue: 0,0:02:01.24,0:02:02.99,Default,,0,0,0,,Содан кейін... Динг
Dialogue: 0,0:02:04.83,0:02:07.50,Default,,0,0,0,,Хахаха...жартысы.
Dialogue: 0,0:02:08.16,0:02:10.88,Default,,0,0,0,,Иә, мен жеңілдім.
Dialogue: 0,0:02:11.00,0:02:13.04,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:02:13.17,0:02:15.76,Default,,0,0,0,,Харусаме 4-ші дивизия командирі туралы айтатын болсақ...
Dialogue: 0,0:02:15.88,0:02:20.34,Default,,0,0,0,,Оны бір кездері қараңғыда жайнайтын жалғыз гүл деп атаған.
Dialogue: 0,0:02:20.47,0:02:24.39,Default,,0,0,0,,Фракциялық қақтығыс салдарынан орнын жоғалтып, ұйымның ақшасын алып қашып кеткен.
Dialogue: 0,0:02:24.51,0:02:27.56,Default,,0,0,0,,Қайда жоғалып кетті деп ойладым...
Dialogue: 0,0:02:27.85,0:02:30.56,Default,,0,0,0,,Мен сенің осылай болып қайтып келетініңді ешқашан күтпедім.
Dialogue: 0,0:02:31.02,0:02:32.31,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:02:32.44,0:02:35.65,Default,,0,0,0,,Әбу Усағи ана түлкіні осылай ұнатады деп ойламаппын.
Dialogue: 0,0:02:35.90,0:02:37.94,Default,,0,0,0,,Бас бала түсінбейді
Dialogue: 0,0:02:38.07,0:02:39.82,Default,,0,0,0,,Дүниедегі барлық нәрсе алақанның көлеміндей
Dialogue: 0,0:02:39.95,0:02:42.37,Default,,0,0,0,,Біз жинақы дәуірге аяқ бастық.
Dialogue: 0,0:02:42.49,0:02:45.74,Default,,0,0,0,,Әйелдің қолынан келетінінен көп нәрсеге ие болғаны дұрыс.
Dialogue: 0,0:02:45.87,0:02:47.20,Default,,0,0,0,,DS туралы? (Әбу қоян) Ня
Dialogue: 0,0:02:47.33,0:02:48.66,Default,,0,0,0,,Mega Drive туралы
Dialogue: 0,0:02:48.96,0:02:50.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:50.16,0:02:51.54,Default,,0,0,0,,Мен барлық жерден іздегенім таңқаларлық емес...
Dialogue: 0,0:02:51.67,0:02:53.38,Default,,0,0,0,,Сондықтан мен оны таба алмаймын.
Dialogue: 0,0:02:53.50,0:02:56.00,Default,,0,0,0,,Өйткені, бұл Абу Усагидің сүйікті Mega Drive.
Dialogue: 0,0:02:56.71,0:02:59.17,Default,,0,0,0,,Бірақ оларға да орын жоқ сияқты.
Dialogue: 0,0:02:59.30,0:03:01.51,Default,,0,0,0,,Бұл оған да тым көп болды.
Dialogue: 0,0:03:01.89,0:03:03.22,Default,,0,0,0,,Ол тесілді ме?
Dialogue: 0,0:03:03.80,0:03:06.64,Default,,0,0,0,,Ей, біртүрлі болжам жасауды доғар.
Dialogue: 0,0:03:06.97,0:03:08.77,Default,,0,0,0,,Ол ақымақ басшы емес.
Dialogue: 0,0:03:08.89,0:03:11.23,Default,,0,0,0,,Мұндай жеке сезімдерді жұмысқа тартуға болады ма?
Dialogue: 0,0:03:11.35,0:03:12.98,Default,,0,0,0,,Иә, иә (Әбу Усаги) Біріншіден, бұл жігіт...
Dialogue: 0,0:03:13.10,0:03:15.52,Default,,0,0,0,,Аты мен атын өзгертіп, Жерге қашты.
Dialogue: 0,0:03:15.65,0:03:16.94,Default,,0,0,0,,Түсіндім...
Dialogue: 0,0:03:17.07,0:03:18.03,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:03:18.11,0:03:20.32,Default,,0,0,0,,Жалпы айтқанда, мен Sega жанкүйері емеспін, мен Nintendo жанкүйерімін.
Dialogue: 0,0:03:20.45,0:03:21.95,Default,,0,0,0,,Эй, тыңдап тұрмын! ?
Dialogue: 0,0:03:22.07,0:03:23.24,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:23.36,0:03:25.66,Default,,0,0,0,,Тацура жігіттері топтық тактикада жақсы...
Dialogue: 0,0:03:25.78,0:03:27.49,Default,,0,0,0,,Мен оны байқап көргім келді, бірақ...
Dialogue: 0,0:03:27.62,0:03:31.08,Default,,0,0,0,,Саши — Ятодан қалыспайтын сарбаздар тобы.
Dialogue: 0,0:03:31.21,0:03:33.21,Default,,0,0,0,,Нәтижелер көрінеді.
Dialogue: 0,0:03:33.83,0:03:37.46,Default,,0,0,0,,Оның орнына олар несиені қайтадан алды.
Dialogue: 0,0:03:37.59,0:03:41.17,Default,,0,0,0,,Мен шынымен баруым керек деп ойлаймын, рахмет сізге.
Dialogue: 0,0:03:49.31,0:03:50.93,Default,,0,0,0,,Самурайларға
Dialogue: 0,0:04:00.11,0:04:01.40,Default,,0,0,0,,Синсуке Такасуги?
Dialogue: 0,0:04:01.78,0:04:03.03,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:04:03.15,0:04:08.49,Default,,0,0,0,,Ол бұрын бізбен келісім жасаған Онихайтай деп аталатын қарулы топтың басшысы.
Dialogue: 0,0:04:09.08,0:04:10.50,Default,,0,0,0,,Мүмкін Жерде?
Dialogue: 0,0:04:10.58,0:04:12.25,Default,,0,0,0,,Самурай?
Dialogue: 0,0:04:12.37,0:04:16.08,Default,,0,0,0,,Ел ашылғанда бір ғана сынық таяқпен соңына дейін қарсылық көрсеткен деседі.
Dialogue: 0,0:04:16.21,0:04:18.13,Default,,0,0,0,,Варварлықтардың қалдықтары
Dialogue: 0,0:04:18.50,0:04:19.75,Default,,0,0,0,,Я~
Dialogue: 0,0:04:19.88,0:04:21.76,Default,,0,0,0,,Идиот... жоқ
Dialogue: 0,0:04:21.88,0:04:23.80,Default,,0,0,0,,Менің ақымақ адмиралымның менің атымды есіне алғанына сене алар емеспін...
Dialogue: 0,0:04:23.93,0:04:25.76,Default,,0,0,0,,Бұл үлкен құрмет болса керек.
Dialogue: 0,0:04:26.09,0:04:29.39,Default,,0,0,0,,Бұл өзара мүдделердің функциясы болғанымен.
Dialogue: 0,0:04:29.51,0:04:31.27,Default,,0,0,0,,Шынымен пайдалы адам
Dialogue: 0,0:04:31.39,0:04:34.44,Default,,0,0,0,,Жердегі Эдодағы Харусаманың белсенді күші...
Dialogue: 0,0:04:34.56,0:04:37.06,Default,,0,0,0,,Олар бар деп айтуға болады
Dialogue: 0,0:04:37.19,0:04:41.15,Default,,0,0,0,,Бұл жолы ұрғашы түлкіні аулаған олардың жұмысы болды.
Dialogue: 0,0:04:41.65,0:04:43.19,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:04:43.32,0:04:46.36,Default,,0,0,0,,Дегенмен, мені біраз ойландыратын нәрсе бар.
Dialogue: 0,0:04:46.49,0:04:47.70,Default,,0,0,0,,Егер сіз оларды тыңдасаңыз...
Dialogue: 0,0:04:47.82,0:04:51.91,Default,,0,0,0,,Бұл Эдо үкіметін құлатпақ болған лаңкестер туралы әңгіме емес пе?
Dialogue: 0,0:04:52.00,0:04:53.58,Default,,0,0,0,,— қарамастан
Dialogue: 0,0:04:53.71,0:04:57.58,Default,,0,0,0,,Біз орталық үкіметпен жасырын келісім жасау үшін Эдоға барғанда...
Dialogue: 0,0:04:57.71,0:05:01.42,Default,,0,0,0,,Ол үкіметтің иттерін тартуды өз мойнына алды.
Dialogue: 0,0:05:01.96,0:05:04.63,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:05:05.01,0:05:07.22,Default,,0,0,0,,Бұл қарапайым, солай емес пе?
Dialogue: 0,0:05:08.72,0:05:11.60,Default,,0,0,0,,Бұл екі тарап екінші тарапты пайдаланатын қарым-қатынас.
Dialogue: 0,0:05:11.72,0:05:12.97,Default,,0,0,0,,Вермишельді пайдалану -
Dialogue: 0,0:05:13.10,0:05:16.44,Default,,0,0,0,,Менің ойымша, олар сегунатқа жақындап, орталыққа бірден шабуыл жасауды жоспарлап отыр.
Dialogue: 0,0:05:16.69,0:05:18.73,Default,,0,0,0,,О, дұрыс! ?
Dialogue: 0,0:05:19.69,0:05:21.15,Default,,0,0,0,,Жоқ, дұрыс айтасыз!
Dialogue: 0,0:05:21.27,0:05:23.78,Default,,0,0,0,,Олар соншалықты үлкен нәрсе жасады ...
Dialogue: 0,0:05:23.90,0:05:26.07,Default,,0,0,0,,Жоқ, мен де байқадым.
Dialogue: 0,0:05:26.20,0:05:29.20,Default,,0,0,0,,Әй... Ақырында солай болған шығар. Шүкір~!
Dialogue: 0,0:05:29.82,0:05:32.16,Default,,0,0,0,,Ақырында, ресурстары мол жер...
Dialogue: 0,0:05:32.29,0:05:34.54,Default,,0,0,0,,Маған оны жеу құқығы берілген болса да...
Dialogue: 0,0:05:34.66,0:05:38.08,Default,,0,0,0,,Егер бұл орын алса, бизнес өседі.
Dialogue: 0,0:05:38.71,0:05:40.54,Default,,0,0,0,,Мына Такасуги жігіті...
Dialogue: 0,0:05:40.67,0:05:42.92,Default,,0,0,0,,Тендоушу мен ақсақалдарымызды жауға айналдыру...
Dialogue: 0,0:05:43.05,0:05:44.80,Default,,0,0,0,,Мен жеңе аламын деп ойламаймын, бірақ...
Dialogue: 0,0:05:44.92,0:05:47.34,Default,,0,0,0,,Менің бетім толығымен жойылатынына күмәнім жоқ.
Dialogue: 0,0:05:47.43,0:05:49.14,Default,,0,0,0,,Жақсы... егер бұл орын алса...
Dialogue: 0,0:05:49.26,0:05:52.01,Default,,0,0,0,,Сенат ұрысатын мен бе?
Dialogue: 0,0:05:53.10,0:05:55.89,Default,,0,0,0,,Иә, бар күшіңізді салыңыз.
Dialogue: 0,0:05:56.02,0:05:57.60,Default,,0,0,0,,Тамақ бергеніңізге рахмет~
Dialogue: 0,0:05:58.23,0:05:59.90,Default,,0,0,0,,Ал... күте тұр, Камуи!
Dialogue: 0,0:06:00.02,0:06:02.86,Default,,0,0,0,,Мен сені неге шақырдым деп ойлайсың? ?
Dialogue: 0,0:06:02.98,0:06:04.78,Default,,0,0,0,,Маған кешкі ас сатып алмадың ба?
Dialogue: 0,0:06:04.86,0:06:06.99,Default,,0,0,0,,Жоқ! Балалар, 7-ші дивизион...
Dialogue: 0,0:06:07.11,0:06:10.20,Default,,0,0,0,,Ұйымды тазалау және реттеу сіздің жұмысыңыздың бір бөлігі болуы мүмкін!
Dialogue: 0,0:06:12.03,0:06:13.95,Default,,0,0,0,,Басқаша айтқанда, біз не істеуіміз керек?
Dialogue: 0,0:06:15.58,0:06:18.33,Default,,0,0,0,,Қолдануды аяқтаған құралдарды орнына қойыңыз.
Dialogue: 0,0:06:19.33,0:06:20.63,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:06:20.75,0:06:23.59,Default,,0,0,0,,Оны құрал ретінде де қолдануға болмайды, бұл жай ғана безендіру!
Dialogue: 0,0:06:24.34,0:06:25.88,Default,,0,0,0,,Мына шошқаны тазалау керек
Dialogue: 0,0:06:26.01,0:06:28.59,Default,,0,0,0,,Бұл жерде тұру әлдеқайда жақсырақ.
Dialogue: 0,0:06:29.09,0:06:31.51,Default,,0,0,0,,Бәлкім, сол төртаяқты тіршілік иесі
Dialogue: 0,0:06:31.64,0:06:34.10,Default,,0,0,0,,Татулассақ ше? Командир Кору
Dialogue: 0,0:06:34.35,0:06:35.81,Default,,0,0,0,,Құдайдың құдіреті
Dialogue: 0,0:06:35.93,0:06:37.89,Default,,0,0,0,,Біз қазірдің өзінде 12-ші дивизияның командиріміз...
Dialogue: 0,0:06:38.02,0:06:40.06,Default,,0,0,0,,Барлығы Темидің жағында.
Dialogue: 0,0:06:40.19,0:06:43.36,Default,,0,0,0,,Мен сені алып жүруге әрқашан дайынмын.
Dialogue: 0,0:06:43.48,0:06:47.65,Default,,0,0,0,,Әлгі ақымақ адмирал аға мемлекет қайраткерлерінің қуыршағы.
Dialogue: 0,0:06:47.78,0:06:50.28,Default,,0,0,0,,Өзіңізді сақтаудан басқа ештеңені ойламаңыз.
Dialogue: 0,0:06:50.40,0:06:54.66,Default,,0,0,0,,Мен зорлық-зомбылық танытатын адаммен жұмыс істегенімді қалаймын.
Dialogue: 0,0:06:54.78,0:06:58.70,Default,,0,0,0,,Олай болса, өзің генерал, Короның күйеуі бол.
Dialogue: 0,0:06:58.83,0:07:02.50,Default,,0,0,0,,Жоқ, мен ойланбастан жабайы болып бара жатырмын.
Dialogue: 0,0:07:02.63,0:07:05.13,Default,,0,0,0,,Біздің басшыда да солай.
Dialogue: 0,0:07:05.25,0:07:07.96,Default,,0,0,0,,Ал мен бір көзіме патч тағып жүрмін...
Dialogue: 0,0:07:08.09,0:07:11.18,Default,,0,0,0,,Сіздің бір қолыңыз ілулі, сондықтан ол сізге қарамай, капитан.
Dialogue: 0,0:07:11.30,0:07:13.34,Default,,0,0,0,,Жарайды, тек капитан ғана жарасады.
Dialogue: 0,0:07:13.47,0:07:15.39,Default,,0,0,0,,Сіз капитанды көздегеніңіз анық.
Dialogue: 0,0:07:15.51,0:07:16.85,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:07:16.97,0:07:19.31,Default,,0,0,0,,Мен әрқашан сенің күшің боламын.
Dialogue: 0,0:07:19.43,0:07:22.15,Default,,0,0,0,,Әлгі Бақасүгі жігітті өлтіргің келсе, мен саған қол ұшын созамын.
Dialogue: 0,0:07:22.27,0:07:23.77,Default,,0,0,0,,Қажетсіз қимылдарды жасамаңыз
Dialogue: 0,0:07:24.56,0:07:27.36,Default,,0,0,0,,Ақыры мен тағы бір самураймен кездестім.
Dialogue: 0,0:07:27.48,0:07:30.86,Default,,0,0,0,,Абу Усаги Кішкентай шабақ пен Такасугиді бөлу
Dialogue: 0,0:07:30.99,0:07:33.70,Default,,0,0,0,,Сіз әскери кемемен әскерлерді жоясыз.
Dialogue: 0,0:07:33.82,0:07:36.12,Default,,0,0,0,,Командир Кору, егер көмектескіңіз келсе, көмектесіңіз.
Dialogue: 0,0:07:36.24,0:07:38.16,Default,,0,0,0,,Ка~ Қайтадан басталды...
Dialogue: 0,0:07:39.12,0:07:43.42,Default,,0,0,0,,Кешіріңіз, бірақ менің көңіл көтеруіме ешкімнің араласуына жол бермеймін.
Dialogue: 0,0:07:48.25,0:07:50.26,Default,,0,0,0,,Мен ғарышта жақсы емеспін.
Dialogue: 0,0:07:50.97,0:07:52.97,Default,,0,0,0,,Ол жақта, бірде тас қараңғы...
Dialogue: 0,0:07:53.09,0:07:55.85,Default,,0,0,0,,Сіз алға немесе артқа жылжып жатырсыз ба?
Dialogue: 0,0:07:55.97,0:07:57.76,Default,,0,0,0,,Сіз түсінбейсіз, солай ма?
Dialogue: 0,0:07:58.47,0:08:02.52,Default,,0,0,0,,Шинсуке мырза, біз дұрыс алға жылжып жатырмыз ба?
Dialogue: 0,0:08:03.64,0:08:05.81,Default,,0,0,0,,Бұлай айтқаным үшін кешіріңіз...
Dialogue: 0,0:08:06.19,0:08:08.27,Default,,0,0,0,,Мен соңғы кездері аздап мазасызданып жүрмін...
Dialogue: 0,0:08:08.90,0:08:11.28,Default,,0,0,0,,Алдында ма, артында ма бәрібір.
Dialogue: 0,0:08:11.40,0:08:15.28,Default,,0,0,0,,Барар жеріңді көрмей қалсаң, менің арқамды ізде.
Dialogue: 0,0:08:16.07,0:08:19.08,Default,,0,0,0,,Жердің тереңінен бе, бұлттардың үстінен бе...
Dialogue: 0,0:08:19.20,0:08:22.33,Default,,0,0,0,,Мен сені қалаған жерге міндетті түрде апарамын.
Dialogue: 0,0:08:22.46,0:08:25.67,Default,,0,0,0,,Маған сенсеңіз, уайымдайтын ештеңе жоқ
Dialogue: 0,0:08:25.79,0:08:27.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:27.13,0:08:31.05,Default,,0,0,0,,Ши... Шинсуке-сама! Мен... Өмір бойы сенің соңынан еремін!
Dialogue: 0,0:08:31.13,0:08:33.55,Default,,0,0,0,,Біздің мақсатымыз бір
Dialogue: 0,0:08:33.67,0:08:35.38,Default,,0,0,0,,Бірге барайық
Dialogue: 0,0:08:35.51,0:08:38.05,Default,,0,0,0,,Енді осы жерге қол қойыңыз.
Dialogue: 0,0:08:38.80,0:08:43.68,Default,,0,0,0,,Оэдо жастарының салауатты дамуы туралы заң жобасына қарсылық білдіріңіз!
Dialogue: 0,0:08:43.81,0:08:47.23,Default,,0,0,0,,Егер сіздің сөзіңізді басқаруға уақытыңыз болса, жүрегіңізді басқаруды үйреніңіз!
Dialogue: 0,0:08:47.36,0:08:50.36,Default,,0,0,0,,Лоликондар манга немесе аниме болмағаннан бері бар!
Dialogue: 0,0:08:50.48,0:08:53.49,Default,,0,0,0,,Бір-бірімізбен бетпе-бет келіп, тәртіпті жүректі дамыту маңызды емес пе?
Dialogue: 0,0:08:53.61,0:08:56.53,Default,,0,0,0,,Айтпақшы, мен лоликон емеспін, мен феминистпін.
Dialogue: 0,0:08:57.53,0:08:59.45,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:59.70,0:09:03.41,Default,,0,0,0,,Уф Мансай-сенпай, Шинсуке-сама ше?
Dialogue: 0,0:09:03.54,0:09:07.04,Default,,0,0,0,,Мен аналық кемеде қалдым, өйткені адмиралдың жұмысы бар еді.
Dialogue: 0,0:09:07.17,0:09:09.46,Default,,0,0,0,,Алдымен Эдоға оралуымыз керек.
Dialogue: 0,0:09:09.75,0:09:10.96,Default,,0,0,0,,Қолданылуы неде?
Dialogue: 0,0:09:11.42,0:09:13.97,Default,,0,0,0,,Менде ештеңе жоқ.
Dialogue: 0,0:09:14.30,0:09:16.84,Default,,0,0,0,,Менде жағымсыз сезім бар.
Dialogue: 0,0:09:16.97,0:09:20.35,Default,,0,0,0,,Менің ойымша, Харусаммен бірігу қате болды.
Dialogue: 0,0:09:21.14,0:09:23.10,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:09:23.22,0:09:26.77,Default,,0,0,0,,Сегунатты жеңіп, әлемді қалпына келтіріңіз
Dialogue: 0,0:09:26.89,0:09:28.85,Default,,0,0,0,,Нуши де мұнымен келісер еді.
Dialogue: 0,0:09:29.15,0:09:32.23,Default,,0,0,0,,Бірақ екінші тарап өте нашар болды...
Dialogue: 0,0:09:32.36,0:09:34.32,Default,,0,0,0,,Бастапқыда біз, жын сарбаздары...
Dialogue: 0,0:09:34.44,0:09:36.61,Default,,0,0,0,,Галактикадағы ең үлкен қылмыс синдикаты.
Dialogue: 0,0:09:36.74,0:09:39.03,Default,,0,0,0,,Тепе-теңдік болмады.
Dialogue: 0,0:09:39.16,0:09:42.62,Default,,0,0,0,,Мен оны білмей тұрып, мен қолданылу орнына қолданылып жүрдім.
Dialogue: 0,0:09:42.99,0:09:44.45,Default,,0,0,0,,Ағымдағы жағдайға қарасаңыз...
Dialogue: 0,0:09:44.58,0:09:48.37,Default,,0,0,0,,Сегунат пен сегунаттың істеп жатқан істерінің арасында үлкен айырмашылық жоқ, бұл құдайларға жағымпазданады.
Dialogue: 0,0:09:49.33,0:09:52.84,Default,,0,0,0,,Ал енді сегунат пен Харусамның қарым-қатынасы бар...
Dialogue: 0,0:09:52.96,0:09:55.88,Default,,0,0,0,,Біздің бар болуымыз кедергіден басқа ештеңе емес.
Dialogue: 0,0:09:57.09,0:09:58.88,Default,,0,0,0,,Мүмкін Синсуке-сама...
Dialogue: 0,0:09:59.59,0:10:02.93,Default,,0,0,0,,Қысқасы, Синсуке сізді уайымдады ма?
Dialogue: 0,0:10:03.06,0:10:07.35,Default,,0,0,0,,Жарайды, ол адам сегунатты жоймайынша жойылмайды.
Dialogue: 0,0:10:07.48,0:10:09.77,Default,,0,0,0,,Сіз бұл антты ұмыттыңыз ба?
Dialogue: 0,0:10:11.36,0:10:13.73,Default,,0,0,0,,Мен оны жойып жіберемін.
Dialogue: 0,0:10:14.90,0:10:19.24,Default,,0,0,0,,Оэдо жастарының салауатты дамуы туралы бұйрыққа түзетулер енгізу туралы заң жобасы
Dialogue: 0,0:10:19.32,0:10:21.16,Default,,0,0,0,,Сіз қанша адамның естеліктерін басып алдыңыз?
Dialogue: 0,0:10:21.28,0:10:23.16,Default,,0,0,0,,Үзіліс! Сіз бұзыңыз!
Dialogue: 0,0:10:23.62,0:10:27.16,Default,,0,0,0,,Ванки шебері, алда көктемгі жаңбыр жауатын кеме бар!
Dialogue: 0,0:10:27.87,0:10:31.00,Default,,0,0,0,,Не! ? Мен бұл шынымен біз боламыз деп ойладым ...
Dialogue: 0,0:10:31.13,0:10:34.42,Default,,0,0,0,,Ши... Шинсуке-сама~!
Dialogue: 0,0:10:35.09,0:10:36.76,Default,,0,0,0,,Ей, біз тағы кездестік.
Dialogue: 0,0:10:38.76,0:10:40.84,Default,,0,0,0,,Тіке айтқаным үшін кешіріңіз, бірақ...
Dialogue: 0,0:10:40.97,0:10:43.80,Default,,0,0,0,,Қандай уақытты айтсаңыз да, мен оны айтамын, себебі таң қалатыныңызға сенімдімін.
Dialogue: 0,0:10:44.22,0:10:45.14,Default,,0,0,0,,Мен сені өлуге рұқсат етемін
Dialogue: 0,0:10:45.64,0:10:47.85,Default,,0,0,0,,Мен таң қалған жоқпын.
Dialogue: 0,0:10:47.98,0:10:51.15,Default,,0,0,0,,Біз алғаш танысқаннан бері осылай жазылды.
Dialogue: 0,0:10:51.65,0:10:53.65,Default,,0,0,0,,Бұл жақсы болжам.
Dialogue: 0,0:10:53.77,0:10:56.48,Default,,0,0,0,,Негізі, мен бұрын самурай көргендіктен...
Dialogue: 0,0:10:56.61,0:10:58.90,Default,,0,0,0,,Мен осылай араласуға құмар болдым.
Dialogue: 0,0:10:59.57,0:11:02.03,Default,,0,0,0,,Неліктен? Бұл әлсіз, бірақ сізден ...
Dialogue: 0,0:11:02.16,0:11:04.49,Default,,0,0,0,,Дәл сол самурайдың иісі шықты.
Dialogue: 0,0:11:04.62,0:11:05.99,Default,,0,0,0,,Қандай кездейсоқтық.
Dialogue: 0,0:11:06.12,0:11:10.04,Default,,0,0,0,,Мен де сол ақымақ күміс самурайды өлтіргім келді.
Dialogue: 0,0:11:10.37,0:11:11.37,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:11.50,0:11:15.04,Default,,0,0,0,,Болжауға шебер болудың орнына, сіз табиғаттан тыс күштерді де пайдалана алатын сияқтысыз.
Dialogue: 0,0:11:15.71,0:11:18.55,Default,,0,0,0,,Сол көзде құпия бар ма? (Такасуги) Иә
Dialogue: 0,0:11:18.92,0:11:20.13,Default,,0,0,0,,Камуи
Dialogue: 0,0:11:23.22,0:11:25.47,Default,,0,0,0,,Мен саған араласпа дедім.
Dialogue: 0,0:11:25.55,0:11:27.77,Default,,0,0,0,,Әй, жолыма кедергі болма.
Dialogue: 0,0:11:33.56,0:11:35.40,Default,,0,0,0,,Иә? (Куру) Камуи...
Dialogue: 0,0:11:35.82,0:11:37.86,Default,,0,0,0,,Біз өлтіруге келген сенсің.
Dialogue: 0,0:11:41.90,0:11:44.20,Default,,0,0,0,,Мен оны қай жерде және қалай қате естідім?
Dialogue: 0,0:11:44.66,0:11:48.20,Default,,0,0,0,,Жау мырза, сіз осындай үлкен отбасыңыз бар дедіңіз бе?
Dialogue: 0,0:11:48.74,0:11:50.96,Default,,0,0,0,,Түнгі қоянның қаны тым қауіпті.
Dialogue: 0,0:11:51.46,0:11:54.96,Default,,0,0,0,,Өткір кескен жүзді жек көреді, құдайдың құдіреті.
Dialogue: 0,0:11:55.29,0:11:59.26,Default,,0,0,0,,Мына жігіт жынды екен. Мен ақымақ адмирал алады деп күтпедім.
Dialogue: 0,0:11:59.38,0:12:02.05,Default,,0,0,0,,Сен ақымақ, оның орнына мені өлтіруің керек еді.
Dialogue: 0,0:12:02.17,0:12:04.97,Default,,0,0,0,,Ендеше тыныш өл.
Dialogue: 0,0:12:05.97,0:12:07.39,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:12:13.69,0:12:17.44,Default,,0,0,0,,Вице-капитан Жын сарбаздарының артында Харусаме флоты тұр!
Dialogue: 0,0:12:17.57,0:12:19.94,Default,,0,0,0,,Бұл командир Корудың 8-ші дивизиясы.
Dialogue: 0,0:12:20.07,0:12:22.78,Default,,0,0,0,,Бұл адмиралдың жеке флотының бөлімшесі сияқты!
Dialogue: 0,0:12:23.57,0:12:24.74,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:12:24.86,0:12:27.74,Default,,0,0,0,,Біз бұрмаланған сияқтымыз.
Dialogue: 0,0:12:29.99,0:12:31.50,Default,,0,0,0,,Уф... не болып жатыр! ?
Dialogue: 0,0:12:32.04,0:12:33.91,Default,,0,0,0,,Харусам бір-біріне оқ жаудырып жатыр! ?
Dialogue: 0,0:12:34.04,0:12:36.63,Default,,0,0,0,,Уайымдайтын ештеңе жоқ, бәріңіз.
Dialogue: 0,0:12:36.75,0:12:38.84,Default,,0,0,0,,Барлығы солай болуы керек
Dialogue: 0,0:12:38.96,0:12:40.00,Default,,0,0,0,,Такеичи Сенпай...
Dialogue: 0,0:12:40.75,0:12:42.51,Default,,0,0,0,,Бұл Харусам 7-ші дивизиясы.
Dialogue: 0,0:12:42.63,0:12:47.01,Default,,0,0,0,,Харусаме тайпасының түнгі қояндардың элитасымен ең күшті бірлігі.
Dialogue: 0,0:12:47.55,0:12:52.02,Default,,0,0,0,,Олардың көшбасшысы, Харусаменің жауынгерлік өнер дивизиясының командирі Камуиденнің ұлылығы...
Dialogue: 0,0:12:52.14,0:12:54.77,Default,,0,0,0,,Енді адмиралдан асып түседі.
Dialogue: 0,0:12:54.89,0:12:57.52,Default,,0,0,0,,Енді он екінші дивизия командирі кезінде адмирал жойылды...
Dialogue: 0,0:12:57.65,0:13:00.52,Default,,0,0,0,,Камуиденді басып алу қозғалысы бар.
Dialogue: 0,0:13:00.61,0:13:03.24,Default,,0,0,0,,Оның орындалып жатқаны...
Dialogue: 0,0:13:03.36,0:13:04.82,Default,,0,0,0,,Сол адмирал Уцуке
Dialogue: 0,0:13:04.95,0:13:09.53,Default,,0,0,0,,Сіз позицияңызға қауіп төндіретін 7-дивизияны өлтірмексіз бе?
Dialogue: 0,0:13:09.62,0:13:11.49,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:13:11.62,0:13:16.75,Default,,0,0,0,,Біз ең күшті ақ әскерлері бар 7-ші дивизияны кемеге итеріп жібердік және...
Dialogue: 0,0:13:16.87,0:13:19.04,Default,,0,0,0,,Бұл сізді оқшаулау үшін жем.
Dialogue: 0,0:13:19.42,0:13:22.55,Default,,0,0,0,,Сізді тағы да Харусам жігіттері пайдаланады ма?
Dialogue: 0,0:13:23.05,0:13:28.72,Default,,0,0,0,,Дәл осындай қабілетсіз адмирал сияқты ер адамдар бізге оңай қол жеткізе алады.
Dialogue: 0,0:13:29.97,0:13:34.06,Default,,0,0,0,,Бірақ мен өзімді қорғау үшін тістерімді сындырамын деп ешқашан ойламадым...
Dialogue: 0,0:13:34.64,0:13:36.23,Default,,0,0,0,,Ісінген тін –
Dialogue: 0,0:13:36.35,0:13:39.73,Default,,0,0,0,,Бұл олардың ақымақтығын арттырып тұрған жоқ па...
Dialogue: 0,0:13:39.86,0:13:43.40,Default,,0,0,0,,Гахахаха! Такасуги-доно, сен керемет жұмыс жасадың!
Dialogue: 0,0:13:43.53,0:13:46.90,Default,,0,0,0,,Енді менің кекімді алатын бүлікшілер кетті.
Dialogue: 0,0:13:47.03,0:13:49.91,Default,,0,0,0,,Корудың жұмысы да тамаша болды.
Dialogue: 0,0:13:50.28,0:13:52.74,Default,,0,0,0,,Жоқ, мен ақымақпын...
Dialogue: 0,0:13:52.87,0:13:56.91,Default,,0,0,0,,Мен ақымақ адмиралдың қол астындағы 12-дивизияның командирі ретіндегі міндетімді орындағанға дейін.
Dialogue: 0,0:13:57.46,0:13:59.33,Default,,0,0,0,,Көтерілісшілердің қарым-қатынасына қарасаңыз...
Dialogue: 0,0:13:59.46,0:14:02.04,Default,,0,0,0,,Қамуиға байланғандар да оянып кетті...
Dialogue: 0,0:14:02.17,0:14:04.80,Default,,0,0,0,,Адмиралға деген адалдығыңызды жаңартыңыз
Dialogue: 0,0:14:04.92,0:14:06.92,Default,,0,0,0,,Мен бұл аздап босқа кеткендей болдым.
Dialogue: 0,0:14:07.59,0:14:08.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:09.22,0:14:10.43,Default,,0,0,0,,Бұ… бұл керемет арқа сындыратын қадам.
Dialogue: 0,0:14:10.55,0:14:13.89,Default,,0,0,0,,Тіпті пілге де улы жебелердің көп ұшырағаны сонша, ол әп-сәтте бұлыңғыр болып кетті...
Dialogue: 0,0:14:14.64,0:14:18.94,Default,,0,0,0,,Менің соққымды алғаннан кейін де соңына дейін күлдіңіз.
Dialogue: 0,0:14:19.48,0:14:24.36,Default,,0,0,0,,Бұл жарақаттан олардың 20-дан астам әскері өледі деп ойлау.
Dialogue: 0,0:14:24.90,0:14:27.24,Default,,0,0,0,,Оны аулау салдарынан келтірілген зияннан да көп...
Dialogue: 0,0:14:27.36,0:14:30.95,Default,,0,0,0,,Менің ойымша, оның жоғалуынан келтірілген зиян одан да көп.
Dialogue: 0,0:14:31.20,0:14:32.24,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:14:32.37,0:14:35.83,Default,,0,0,0,,Жын сарбаздары бос тесікті толтыратын шығар.
Dialogue: 0,0:14:36.16,0:14:39.50,Default,,0,0,0,,Ха, кешіріңіз, бірақ мен бұлай істеуден аулақ боламын.
Dialogue: 0,0:14:39.62,0:14:42.84,Default,,0,0,0,,Тауықтың аузы бол, бірақ сиырдың аузы болма.
Dialogue: 0,0:14:42.96,0:14:44.38,Default,,0,0,0,,Қарақшылар мен ірі басшылардан-
Dialogue: 0,0:14:44.50,0:14:47.17,Default,,0,0,0,,Ояма Дайшо орындасам, маған оңай болар еді.
Dialogue: 0,0:14:47.97,0:14:52.43,Default,,0,0,0,,Оның үстіне мен бұл жын солдаттың атын тастай алмаймын...
Dialogue: 0,0:14:52.93,0:14:54.39,Default,,0,0,0,,Сонда марапат...
Dialogue: 0,0:14:54.51,0:14:55.93,Default,,0,0,0,,Маған ештеңе керек емес
Dialogue: 0,0:14:56.06,0:14:59.60,Default,,0,0,0,,Әдеттегідей жалғастырайық.
Dialogue: 0,0:15:00.39,0:15:01.90,Default,,0,0,0,,сарайдың ар жағында бір жерде қабырғаның құлаған дыбысын естідім.
Dialogue: 0,0:15:02.02,0:15:03.44,Default,,0,0,0,,Ол Камуиден артық――
Dialogue: 0,0:15:03.56,0:15:05.94,Default,,0,0,0,,Себебі мен оның не жоспарлап отырғанын білмеймін, мен жалғыз қасқырмын.
Dialogue: 0,0:15:06.44,0:15:09.45,Default,,0,0,0,,Білемін, енді ешқашан қойылым болмайды.
Dialogue: 0,0:15:09.53,0:15:11.45,Default,,0,0,0,,(айналған тостаған дыбысы)
Dialogue: 0,0:15:11.53,0:15:16.08,Default,,0,0,0,,Динг немесе жарты... Динг немесе жарты...
Dialogue: 0,0:15:16.20,0:15:17.37,Default,,0,0,0,,Уфуфуфуфу…
Dialogue: 0,0:15:18.12,0:15:18.95,Default,,0,0,0,,Жартысы
Dialogue: 0,0:15:19.83,0:15:21.71,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,0:15:21.83,0:15:23.96,Default,,0,0,0,,Өте жаман.
Dialogue: 0,0:15:24.67,0:15:27.46,Default,,0,0,0,,Ендеше, енді сенің өлетін кезің.
Dialogue: 0,0:15:28.13,0:15:32.47,Default,,0,0,0,,Бұл қарғыс. Жеңілгендер әрқашан бақытсыз болады.
Dialogue: 0,0:15:33.05,0:15:34.97,Default,,0,0,0,,Мен де жеңілдім, сондықтан оған еш күмәнім жоқ
Dialogue: 0,0:15:35.89,0:15:40.48,Default,,0,0,0,,Әй, мен сені өлтірсем де өлмейсің. Құбыжық жорғалап жүр.
Dialogue: 0,0:15:40.98,0:15:43.31,Default,,0,0,0,,Оны бағып-қағып, аман сақтап қалу үшін барын салған...
Dialogue: 0,0:15:43.44,0:15:47.48,Default,,0,0,0,,Өзгелерге үлгі болу үшін ел алдында жазалау емес пе?
Dialogue: 0,0:15:47.61,0:15:48.69,Default,,0,0,0,,Күні қашан?
Dialogue: 0,0:15:48.82,0:15:49.99,Default,,0,0,0,,3 күннен кейін
Dialogue: 0,0:15:50.07,0:15:53.99,Default,,0,0,0,,3 күн... Кім бірінші өледі, сен бе, мен бе?
Dialogue: 0,0:15:54.53,0:15:56.58,Default,,0,0,0,,Сен де мұны білмейсің бе?
Dialogue: 0,0:15:57.20,0:16:01.00,Default,,0,0,0,,Мұндағы адамдардың барлығы тек өздерін ғана ойлайды.
Dialogue: 0,0:16:01.46,0:16:03.04,Default,,0,0,0,,Қанша өтінсем де...
Dialogue: 0,0:16:03.17,0:16:06.59,Default,,0,0,0,,Қанша пайдалансаң, соғұрлым көп пайдалансаң, одан да арыласың.
Dialogue: 0,0:16:06.71,0:16:08.00,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:08.50,0:16:10.88,Default,,0,0,0,,Сіз оны қолданасыз ба, қолданбасаңыз да.
Dialogue: 0,0:16:11.01,0:16:14.13,Default,,0,0,0,,Мұндай түкке тұрғысыз серіктес болу қызықсыз.
Dialogue: 0,0:16:14.55,0:16:15.97,Default,,0,0,0,,Егер сіз осындай жерде болсаңыз...
Dialogue: 0,0:16:16.10,0:16:20.39,Default,,0,0,0,,Тіпті өскен тамаша азу тістері де шіріп кетеді.
Dialogue: 0,0:16:21.73,0:16:24.40,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:16:25.56,0:16:27.44,Default,,0,0,0,,Теми сияқты.
Dialogue: 0,0:16:27.86,0:16:30.28,Default,,0,0,0,,Тұрақсыз қалған үлкен азулар...
Dialogue: 0,0:16:30.40,0:16:33.65,Default,,0,0,0,,Мен оны жабыстыратын жер іздеп, кезіп жүрмін.
Dialogue: 0,0:16:34.82,0:16:38.66,Default,,0,0,0,,Бірақ бұл тозығы жеткен кемемен ешқайда бара алмайсың.
Dialogue: 0,0:16:39.41,0:16:40.91,Default,,0,0,0,,Егер сіз бәрібір мінетін болсаңыз...
Dialogue: 0,0:16:41.04,0:16:44.46,Default,,0,0,0,,Мен сен сияқты біреудің кемесіне мінсем ғой.
Dialogue: 0,0:16:45.96,0:16:48.92,Default,,0,0,0,,Көріскенше, ғарышкер
Dialogue: 0,0:16:50.50,0:16:53.55,Default,,0,0,0,,Мен бұл адмирал 7-ші дивизияны басқарады деп ешқашан күтпедім...
Dialogue: 0,0:16:53.67,0:16:55.68,Default,,0,0,0,,Сенат билігін қарызға алдың ба?
Dialogue: 0,0:16:55.80,0:16:59.64,Default,,0,0,0,,Жоқ, онихейтайлық Такасуги данышпан екен деген қауесет бар.
Dialogue: 0,0:16:59.76,0:17:01.52,Default,,0,0,0,,Бұл жай ғана әзіл емес пе?
Dialogue: 0,0:17:01.64,0:17:04.85,Default,,0,0,0,,Көктемгі жаңбыр үшін қаншама ерлік жасағандар...
Dialogue: 0,0:17:04.98,0:17:07.06,Default,,0,0,0,,Көктемгі жаңбырға кім көшіп барады?
Dialogue: 0,0:17:07.19,0:17:08.90,Default,,0,0,0,,Бір адам емес.
Dialogue: 0,0:17:09.02,0:17:11.57,Default,,0,0,0,,Жолыңызға кедергі келтірген кез келген адамды тепкілеңіз
Dialogue: 0,0:17:11.69,0:17:13.82,Default,,0,0,0,,Вермишель осындай болады.
Dialogue: 0,0:17:15.65,0:17:17.82,Default,,0,0,0,,Адамдар, жақсылап қараңыздар!
Dialogue: 0,0:17:18.41,0:17:20.70,Default,,0,0,0,,Бұл сатқынның соңы.
Dialogue: 0,0:17:20.83,0:17:23.04,Default,,0,0,0,,Менің жауым – қарт...
Dialogue: 0,0:17:23.16,0:17:26.58,Default,,0,0,0,,Аға мемлекет қайраткерінің өшін алу вермишельдің кек алуымен бірдей.
Dialogue: 0,0:17:26.92,0:17:32.25,Default,,0,0,0,,Егер бұл заң еленбесе, тіпті темір әскері де төбелеске айналады.
Dialogue: 0,0:17:32.38,0:17:34.09,Default,,0,0,0,,Ке, сен мұны жиі айтасың.
Dialogue: 0,0:17:34.63,0:17:37.84,Default,,0,0,0,,Камуи, айтар сөзің бар ма?
Dialogue: 0,0:17:38.26,0:17:40.14,Default,,0,0,0,,Олай болса, маған біреуін алуға бола ма?
Dialogue: 0,0:17:40.26,0:17:41.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:42.26,0:17:43.35,Default,,0,0,0,,Адмирал Идиот~
Dialogue: 0,0:17:43.43,0:17:45.35,Default,,0,0,0,,Өлтір! Өлтір!
Dialogue: 0,0:17:45.85,0:17:49.65,Default,,0,0,0,,Ал, күте тұр, ақымақ... Идиот адмирал.
Dialogue: 0,0:17:49.77,0:17:52.78,Default,,0,0,0,,Маған мұны істеуге рұқсат бере алмайсыз ба? (Идиот) Иә?
Dialogue: 0,0:17:53.07,0:17:57.32,Default,,0,0,0,,Өкінішке орай, мен Саши сайысына келісе алмадым...
Dialogue: 0,0:17:57.45,0:17:59.78,Default,,0,0,0,,Мен кем дегенде қамқоршы ретінде қызмет етуім керек.
Dialogue: 0,0:18:00.03,0:18:03.29,Default,,0,0,0,,Егер мен белгі берсем, Такасугиді де өлтір.
Dialogue: 0,0:18:05.83,0:18:08.75,Default,,0,0,0,,Мен осы тозығы жеткен кемеге отырдым...
Dialogue: 0,0:18:08.87,0:18:10.29,Default,,0,0,0,,Бұл жай ғана сәттілік болды.
Dialogue: 0,0:18:10.75,0:18:12.13,Default,,0,0,0,,Бір-бірін…
Dialogue: 0,0:18:12.71,0:18:16.80,Default,,0,0,0,,Сен екеуміз бір жерге бара жатырмыз ба? Жердің төбелесшісі
Dialogue: 0,0:18:17.30,0:18:18.68,Default,,0,0,0,,Саана
Dialogue: 0,0:18:18.80,0:18:21.80,Default,,0,0,0,,Кем дегенде туристік мақсатта емес.
Dialogue: 0,0:18:23.10,0:18:25.81,Default,,0,0,0,,Бұл көрікті жерлер, бұл тозаққа саяхат.
Dialogue: 0,0:18:25.89,0:18:28.81,Default,,0,0,0,,Куфуфуфуфу... Айырмашылығы жоқ.
Dialogue: 0,0:18:38.57,0:18:39.61,Default,,0,0,0,,Иә
Dialogue: 0,0:18:41.32,0:18:44.08,Default,,0,0,0,,Ең болмаса тозақта ұйықта
Dialogue: 0,0:18:44.20,0:18:46.58,Default,,0,0,0,,Тозған кеменің матростары
Dialogue: 0,0:18:47.41,0:18:48.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:48.87,0:18:49.71,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:18:50.29,0:18:51.50,Default,,0,0,0,,Гах...
Dialogue: 0,0:18:54.09,0:18:55.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:58.76,0:19:00.38,Default,,0,0,0,,Ыстық йото
Dialogue: 0,0:19:00.47,0:19:03.10,Default,,0,0,0,,Не... Не?! ?
Dialogue: 0,0:19:03.43,0:19:07.27,Default,,0,0,0,,Сол үшін айттым ғой, солай ма? Бұл қарғысқа ұшыраған сиқыр
Dialogue: 0,0:19:07.39,0:19:09.73,Default,,0,0,0,,Кім бірінші өледі дедім...
Dialogue: 0,0:19:09.85,0:19:11.60,Default,,0,0,0,,Екеуің бірге өлесіңдер ме?
Dialogue: 0,0:19:12.35,0:19:14.27,Default,,0,0,0,,Егер бәрібір билейтін болсаң...
Dialogue: 0,0:19:14.40,0:19:18.61,Default,,0,0,0,,Ақымақпен билегеннен гөрі күлкілі ақымақпен билеу қызық болар еді.
Dialogue: 0,0:19:19.70,0:19:24.37,Default,,0,0,0,,Хехехе... Самурайлар шынымен де қызық емес пе?
Dialogue: 0,0:19:24.45,0:19:27.87,Default,,0,0,0,,Такасуги~! Сіз қазірдің өзінде қолданылған құралдарсыз!
Dialogue: 0,0:19:28.00,0:19:30.37,Default,,0,0,0,,Ол сені ғаламда шаңға айналдырады!
Dialogue: 0,0:19:31.17,0:19:33.38,Default,,0,0,0,,Уақытты босқа кетіру.
Dialogue: 0,0:19:33.79,0:19:37.38,Default,,0,0,0,,Мен саған айттым, мен сенің қамқорлығыңды аламын.
Dialogue: 0,0:19:37.50,0:19:41.88,Default,,0,0,0,,Бұл түрмеде мен жалғыз жазалаушымын.
Dialogue: 0,0:19:42.18,0:19:45.43,Default,,0,0,0,,Бұл бүкіл Темераның басын кесу алаңы.
Dialogue: 0,0:19:46.26,0:19:47.89,Default,,0,0,0,,(Аспандағы болмыстардың шуы)
Dialogue: 0,0:19:47.97,0:19:49.68,Default,,0,0,0,,(Рониндердің айқайы)
Dialogue: 0,0:19:52.19,0:19:55.52,Default,,0,0,0,,Шинсуке-сама! Джой Роши осындай!
Dialogue: 0,0:19:55.65,0:19:57.57,Default,,0,0,0,,Сондай-ақ, бала өмір бойы сенің соңынан ереді!
Dialogue: 0,0:19:57.86,0:19:58.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:59.03,0:20:02.99,Default,,0,0,0,,Сенің есі дұрыс па? Сіз бұл қозғалыспен Харусамді жеңу мүмкіндігіңіз бар деп ойлайсыз! ?
Dialogue: 0,0:20:03.11,0:20:04.74,Default,,0,0,0,,Оның орнына, қазір сіз жасай алатын нәрсе ...
Dialogue: 0,0:20:04.87,0:20:06.95,Default,,0,0,0,,Оэдо жастардың денсаулығы... Гува
Dialogue: 0,0:20:07.49,0:20:10.08,Default,,0,0,0,,Ақыл-есі дұрыс болғанша...
Dialogue: 0,0:20:10.20,0:20:13.83,Default,,0,0,0,,Хмф! Әлеммен күресу жақсы емес.
Dialogue: 0,0:20:13.92,0:20:18.75,Default,,0,0,0,,Мен, маймылдар! Сен не істеп жатырсың? Оны құрт!
Dialogue: 0,0:20:19.25,0:20:20.01,Default,,0,0,0,,Не! ?
Dialogue: 0,0:20:22.38,0:20:26.85,Default,,0,0,0,,Не болып жатыр? Мен уайымдап, қайықпен жүзуге тырыстым...
Dialogue: 0,0:20:26.97,0:20:29.06,Default,,0,0,0,,Сіз әдеттегіден гөрі қобалжыдыңыз, солай емес пе?
Dialogue: 0,0:20:29.18,0:20:30.60,Default,,0,0,0,,Сатто Кодоккой
Dialogue: 0,0:20:30.89,0:20:34.60,Default,,0,0,0,,Жетінші бөлім! Ақымақ! Неге олар әлі тірі...! ?
Dialogue: 0,0:20:34.94,0:20:37.02,Default,,0,0,0,,Адмирал Бұл қиын!
Dialogue: 0,0:20:37.15,0:20:38.77,Default,,0,0,0,,7-дивизияның қайтып оралғаны туралы естідім.
Dialogue: 0,0:20:38.90,0:20:42.07,Default,,0,0,0,,Он екі бөлімнің мүшелері бірінен соң бірі келе бастады!
Dialogue: 0,0:20:42.19,0:20:44.40,Default,,0,0,0,,Немесе... жағдай толығымен өзгерді...
Dialogue: 0,0:20:44.53,0:20:46.62,Default,,0,0,0,,Иә? Адмирал~! ?
Dialogue: 0,0:20:47.78,0:20:50.74,Default,,0,0,0,,Ой... Мен Камуи Такасугимін, мен сені кешірмеймін!
Dialogue: 0,0:20:50.87,0:20:53.58,Default,,0,0,0,,Не... Адмирал, сен өзің қашпақсың ба?
Dialogue: 0,0:20:53.71,0:20:55.79,Default,,0,0,0,,Мені де алыңыз, ақымақ адмирал!
Dialogue: 0,0:20:55.92,0:20:57.46,Default,,0,0,0,,Ах, сен айттың ғой!
Dialogue: 0,0:20:57.58,0:21:00.30,Default,,0,0,0,,Мен сізді осы уақытқа дейін ести алмаймын деп жүрдім, бірақ ақыры айттыңыз!
Dialogue: 0,0:21:00.42,0:21:02.26,Default,,0,0,0,,Сіз де өлім жазасына кесіледі!
Dialogue: 0,0:21:02.34,0:21:04.51,Default,,0,0,0,,Кемені тез қалдырыңыз! Сен не істеп жатырсың!
Dialogue: 0,0:21:04.63,0:21:05.63,Default,,0,0,0,,Шулы!
Dialogue: 0,0:21:05.76,0:21:08.05,Default,,0,0,0,,Мен мұны тек қол астындағыларға жасағанмын, сондықтан түсінбеймін!
Dialogue: 0,0:21:08.18,0:21:10.85,Default,,0,0,0,,Сізде ілмек бар! Капитан әшкереленуі керек!
Dialogue: 0,0:21:10.97,0:21:12.39,Default,,0,0,0,,Сіз де адмирал болуыңыз керек!
Dialogue: 0,0:21:12.52,0:21:14.39,Default,,0,0,0,,Иә? Эй, бұл не! ?
Dialogue: 0,0:21:14.85,0:21:16.90,Default,,0,0,0,,Уа! Немесе… Камуи! ?
Dialogue: 0,0:21:17.02,0:21:19.73,Default,,0,0,0,,Бұл Камуи емес, ақымақ адмирал.
Dialogue: 0,0:21:19.86,0:21:22.03,Default,,0,0,0,,Бүгіннен бастап мен ақымақ адмиралмын!
Dialogue: 0,0:21:29.45,0:21:31.41,Default,,0,0,0,,Менің қарызым көп.
Dialogue: 0,0:21:31.91,0:21:35.87,Default,,0,0,0,,Сенімен біраз уақытқа төбелесуді тоқтатудан басқа амалым жоқ.
Dialogue: 0,0:21:36.00,0:21:38.92,Default,,0,0,0,,Сонымен қатар, сізбен тозаққа саяхат жасау қызықты болар еді.
Dialogue: 0,0:21:39.33,0:21:41.21,Default,,0,0,0,,Ху (Камуи) Ал...
Dialogue: 0,0:21:41.34,0:21:42.92,Default,,0,0,0,,Неден бастау керек?
Dialogue: 0,0:21:43.38,0:21:46.30,Default,,0,0,0,,Бұл Самурай жұлдызы ма?
Dialogue: 0,0:21:47.84,0:21:52.56,Default,,0,0,0,,Динг немесе жарты... Динг немесе жарты...
Dialogue: 0,0:21:54.81,0:21:55.93,Default,,0,0,0,,Динг
Dialogue: 0,0:21:56.98,0:21:59.90,Default,,0,0,0,,Өте өкінішті, жартылай нашар
Dialogue: 0,0:22:10.95,0:22:16.96,Default,,0,0,0,,♪~
Dialogue: 0,0:23:41.29,0:23:42.75,Default,,0,0,0,,Келесі жолы «Зауытқа саяхат және т.б.»
Dialogue: 0,0:23:42.87,0:23:45.42,Default,,0,0,0,,«Шынымды айтсам, бірде-бір нәрсе есімде жоқ».
