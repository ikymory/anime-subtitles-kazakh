Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.25,0:00:05.04,Default,,0,0,0,,Наказаки: Бала болып кеткен сияқтысың.
Dialogue: 0,0:00:05.29,0:00:06.54,Default,,0,0,0,,А... қайдан істедің?
Dialogue: 0,0:00:06.67,0:00:07.96,Default,,0,0,0,,Бұл еркек пе, әлде әйел ме?
Dialogue: 0,0:00:08.09,0:00:09.59,Default,,0,0,0,,Ой... қыз ғой.
Dialogue: 0,0:00:09.71,0:00:11.30,Default,,0,0,0,,Олай болса, тамақ ішейік.
Dialogue: 0,0:00:11.42,0:00:13.05,Default,,0,0,0,,Өтінемін... кешіріңіз.
Dialogue: 0,0:00:13.51,0:00:16.93,Default,,0,0,0,,Әйелдер ерлерге қарағанда әлдеқайда тез тәуелсіз болады.
Dialogue: 0,0:00:17.05,0:00:20.31,Default,,0,0,0,,Көп ұзамай менімен сөйлесуді доғарарсың.
Dialogue: 0,0:00:20.39,0:00:22.31,Default,,0,0,0,,А... Фуко олай істемейді!
Dialogue: 0,0:00:22.81,0:00:25.56,Default,,0,0,0,,Мен сені Жапониядағы ең жақсы әкенің баласы етіп тәрбиелейтініме сенімдімін!
Dialogue: 0,0:00:25.65,0:00:27.40,Default,,0,0,0,,Ах, бұл рух.
Dialogue: 0,0:00:27.52,0:00:28.57,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:00:29.07,0:00:31.07,Default,,0,0,0,,Мен саған онша ақша бере алмаймын.
Dialogue: 0,0:00:31.32,0:00:33.45,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:00:33.74,0:00:36.11,Default,,0,0,0,,Мен тек жақсы коньки беремін.
Dialogue: 0,0:00:36.24,0:00:37.45,Default,,0,0,0,,Ішкіңіз келсе...
Dialogue: 0,0:00:37.57,0:00:40.29,Default,,0,0,0,,Арнайы сүт ішемін деп айтпа.
Dialogue: 0,0:00:40.41,0:00:42.45,Default,,0,0,0,,Ах... Рахмет!
Dialogue: 0,0:00:43.04,0:00:48.67,Default,,0,0,0,,♪~
Dialogue: 0,0:02:29.64,0:02:31.98,Default,,0,0,0,,Сіз айтқаныңыз емес пе?
Dialogue: 0,0:02:32.11,0:02:34.02,Default,,0,0,0,,Менің іш киімім және сенің әкеңнің іш киімі...
Dialogue: 0,0:02:34.15,0:02:35.57,Default,,0,0,0,,Бөлек жуыңыз!
Dialogue: 0,0:02:35.90,0:02:37.94,Default,,0,0,0,,Кешіріңіз, жас ханым.
Dialogue: 0,0:02:38.19,0:02:40.45,Default,,0,0,0,,Курико өзі жуады!
Dialogue: 0,0:02:41.24,0:02:43.32,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,0:02:45.33,0:02:46.87,Default,,0,0,0,,А... мырза.
Dialogue: 0,0:02:47.00,0:02:50.04,Default,,0,0,0,,Кешіріңіз, мен оны жақында қайтадан жуамын.
Dialogue: 0,0:02:50.16,0:02:54.09,Default,,0,0,0,,Иә? Эй, сен жаңа үй күтушісің. Сіз оны қалай атайсыз?
Dialogue: 0,0:02:54.63,0:02:58.59,Default,,0,0,0,,Ичихара... Сіздің фамилияңыз Хаято ма? Эцуко?
Dialogue: 0,0:02:58.84,0:03:01.34,Default,,0,0,0,,Бұл Эцуко емес, Эзурако.
Dialogue: 0,0:03:01.63,0:03:04.30,Default,,0,0,0,,Бір жерден көрген қулық.
Dialogue: 0,0:03:04.43,0:03:06.35,Default,,0,0,0,,Бұл «Цура» емес, Эзурако.
Dialogue: 0,0:03:06.43,0:03:11.69,Default,,0,0,0,,Жақсы. Қазірден бастап абай болыңыз. Курико екеуміз бөлек кір жуамыз.
Dialogue: 0,0:03:11.81,0:03:13.94,Default,,0,0,0,,Тамақтану уақытын мүмкіндігінше шатастыруға тырысыңыз.
Dialogue: 0,0:03:14.06,0:03:15.73,Default,,0,0,0,,Бұл «Зура» емес, Эзурако
Dialogue: 0,0:03:15.86,0:03:18.19,Default,,0,0,0,,Менің қызым айтқандай істе.
Dialogue: 0,0:03:18.32,0:03:20.61,Default,,0,0,0,,Түсіндім, Эзрако.
Dialogue: 0,0:03:20.74,0:03:23.11,Default,,0,0,0,,Бұл «Эзрако» емес, Катсура (Мацудайра) иә?
Dialogue: 0,0:03:24.91,0:03:26.62,Default,,0,0,0,,О, бұл дұрыс емес, Эзрако.
Dialogue: 0,0:03:26.74,0:03:29.25,Default,,0,0,0,,Жарайды, түсінсең, бара бер.
Dialogue: 0,0:03:29.37,0:03:31.12,Default,,0,0,0,,Кеттік...
Dialogue: 0,0:03:32.71,0:03:36.04,Default,,0,0,0,,Ұлттық полиция агенттігінің комиссары Мацудайра Катакуритора
Dialogue: 0,0:03:36.17,0:03:41.72,Default,,0,0,0,,Эдоның қауіпсіздігіне қауіп төндіретін адамдар «Жойылатын Құдай» ретінде қорқатын адам.
Dialogue: 0,0:03:41.84,0:03:45.14,Default,,0,0,0,,Біз Джой Рошидің ең үлкен және ең күшті жауымыз.
Dialogue: 0,0:03:45.26,0:03:49.18,Default,,0,0,0,,Жаудың қалтасына кіріп, жанжал шығарамын деп бір апта.
Dialogue: 0,0:03:49.31,0:03:50.85,Default,,0,0,0,,Менің кеудеме келіп-кететін нәрсе...
Dialogue: 0,0:03:50.98,0:03:53.27,Default,,0,0,0,,Пайдалы ақпарат әлі қолжетімді емес.
Dialogue: 0,0:03:53.39,0:03:56.90,Default,,0,0,0,,Бұл тітіркенуден гөрі жалғыздық сезімі болды.
Dialogue: 0,0:03:57.02,0:04:00.24,Default,,0,0,0,,Отбасында әке осылай болуы керек пе?
Dialogue: 0,0:04:00.65,0:04:03.24,Default,,0,0,0,,Олай болса, әке дегеніміз не? Ер деген не?
Dialogue: 0,0:04:03.53,0:04:06.28,Default,,0,0,0,,Қандай мақсатпен және кімді қорғау керек...
Dialogue: 0,0:04:06.41,0:04:09.12,Default,,0,0,0,,Сіз әлі де ұрысып жатырсыз ба?
Dialogue: 0,0:04:10.54,0:04:12.08,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:04:12.58,0:04:14.46,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:04:15.25,0:04:16.46,Default,,0,0,0,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:04:16.71,0:04:19.96,Default,,0,0,0,,Не істеп жатырсың, Эзрако-сан?
Dialogue: 0,0:04:20.09,0:04:22.22,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:04:22.97,0:04:24.55,Default,,0,0,0,,Үй қызметкері болып жұмыс істеу...
Dialogue: 0,0:04:24.68,0:04:27.10,Default,,0,0,0,,Тақтаға қадағалап қарау стилі жабысып қалды
Dialogue: 0,0:04:27.43,0:04:29.64,Default,,0,0,0,,Сіз шынымен тақтадасыз.
Dialogue: 0,0:04:29.76,0:04:31.89,Default,,0,0,0,,Егер сізді мазалаған болса, кез келген уақытта маған хабарлаңыз.
Dialogue: 0,0:04:32.02,0:04:33.52,Default,,0,0,0,,Басқа граффити қабырға нұсқалары -
Dialogue: 0,0:04:33.64,0:04:36.90,Default,,0,0,0,,Жүректің қабырғасы А.Т. Өріс нұсқасы да қол жетімді.
Dialogue: 0,0:04:37.02,0:04:38.19,Default,,0,0,0,,Олай болса, алыңыз.
Dialogue: 0,0:04:38.31,0:04:40.36,Default,,0,0,0,,Біраздан бері дірілдеп, тітіркендіреді.
Dialogue: 0,0:04:40.82,0:04:44.86,Default,,0,0,0,,Мм... өткен күні ол кенет айғайлай бастады...
Dialogue: 0,0:04:44.99,0:04:46.86,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:47.16,0:04:48.62,Default,,0,0,0,,Жоқ, маған бәрібір.
Dialogue: 0,0:04:48.74,0:04:50.20,Default,,0,0,0,,Мен оны алуыңызды өтіндім.
Dialogue: 0,0:04:50.33,0:04:51.87,Default,,0,0,0,,Сіз оны алдаймын деп ойладыңыз ба?
Dialogue: 0,0:04:52.50,0:04:54.87,Default,,0,0,0,,Мм... кешірім сұрау дегенді қалай түсінесіңдер?
Dialogue: 0,0:04:55.29,0:04:57.54,Default,,0,0,0,,Ертең біз Оэдо Хиллзді жалға береміз...
Dialogue: 0,0:04:57.67,0:05:01.25,Default,,0,0,0,,Менің досым менің туған күнімді өткізіп жатыр.
Dialogue: 0,0:05:02.01,0:05:04.76,Default,,0,0,0,,Қарсы болмасаңыз, Эзрако да келе ала ма?
Dialogue: 0,0:05:05.05,0:05:06.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:06.88,0:05:09.39,Default,,0,0,0,,А, сонда күйеуің де осында ма?
Dialogue: 0,0:05:09.51,0:05:11.01,Default,,0,0,0,,Мен сізге қоңырау шалуға мүмкіндік жоқ!
Dialogue: 0,0:05:11.51,0:05:15.48,Default,,0,0,0,,Оның үстіне мен оны шақырсам да келер жолы жоқ.
Dialogue: 0,0:05:15.60,0:05:18.10,Default,,0,0,0,,Жақында ол кісінің туған күні...
Dialogue: 0,0:05:18.23,0:05:20.57,Default,,0,0,0,,Мен сенімдімін... әдеттегідей...
Dialogue: 0,0:05:20.69,0:05:24.03,Default,,0,0,0,,Әйелдер тойлайтынына сенімдімін.
Dialogue: 0,0:05:24.57,0:05:28.11,Default,,0,0,0,,Әрқашан... Мен әрқашан бұл жұмыс сияқты себептер келтіремін ...
Dialogue: 0,0:05:28.24,0:05:31.28,Default,,0,0,0,,Отбасыңызбен ешқашан бетпе-бет келмеңіз.
Dialogue: 0,0:05:32.12,0:05:33.79,Default,,0,0,0,,Мен сондай жаман адаммын.
Dialogue: 0,0:05:34.16,0:05:37.29,Default,,0,0,0,,Мен оның әкем екенін мойындамаймын.
Dialogue: 0,0:05:37.58,0:05:39.00,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:05:39.13,0:05:40.25,Default,,0,0,0,,О, Хиёри, қандай кездейсоқ кездесу.
Dialogue: 0,0:05:40.38,0:05:44.05,Default,,0,0,0,,Мен өзімнің ең үлкен жауым, ата-анам және олардың балалары туралы алаңдай бастадым ...
Dialogue: 0,0:05:44.46,0:05:47.05,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:05:44.46,0:05:47.97,Default,,0,0,0,,Мацудайраның қызы жау емес сияқты.
Dialogue: 0,0:05:48.09,0:05:50.80,Default,,0,0,0,,Ақкөңіл қыз еді деуге болады, бірақ...
Dialogue: 0,0:05:51.14,0:05:53.39,Default,,0,0,0,,Хатшы! Бұл басқаша!
Dialogue: 0,0:05:51.14,0:05:53.85,Default,,0,0,0,,Бір отбасы, бір орында тұра алмайтын кішкентай адам...
Dialogue: 0,0:05:53.97,0:05:58.10,Default,,0,0,0,,Мен осы уақытқа дейін қылышпен күресіп келдім деп ойлағым келмейді.
Dialogue: 0,0:05:58.52,0:05:59.44,Default,,0,0,0,,Күйеуі
Dialogue: 0,0:05:59.98,0:06:02.57,Default,,0,0,0,,Ертең Курико-саманың туған күні.
Dialogue: 0,0:06:02.69,0:06:04.19,Default,,0,0,0,,Ондай жерде ұйықтама...
Dialogue: 0,0:06:04.28,0:06:06.19,Default,,0,0,0,,Ах~ құсқым келеді~
Dialogue: 0,0:06:06.61,0:06:09.32,Default,,0,0,0,,Мен сені келерсің деп үміттенген едім, Курико-сама.
Dialogue: 0,0:06:10.03,0:06:13.20,Default,,0,0,0,,Эй, сен Куриконың туған күніне барасың ба?
Dialogue: 0,0:06:13.41,0:06:14.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:15.16,0:06:16.95,Default,,0,0,0,,Оны маған беріңіз.
Dialogue: 0,0:06:17.29,0:06:20.96,Default,,0,0,0,,Мен оны саған бергенімнен әлдеқайда бақытты боларсың.
Dialogue: 0,0:06:21.67,0:06:25.59,Default,,0,0,0,,Осылайша сіз адамдардың ақымақтығын, әлсіздігін және қулығын көресіз ...
Dialogue: 0,0:06:25.71,0:06:28.51,Default,,0,0,0,,Сіз өзіңізді оқытып жатырмын дейсіз бе?
Dialogue: 0,0:06:28.63,0:06:31.22,Default,,0,0,0,,Бұл әкенің рөлі деп айтасыз ба?
Dialogue: 0,0:06:31.51,0:06:33.60,Default,,0,0,0,,Эзрако-сан, сен асыра айтып тұрсың!
Dialogue: 0,0:06:33.72,0:06:36.10,Default,,0,0,0,,Неліктен біраз уақыттан бері кептеліп қалдың?
Dialogue: 0,0:06:36.22,0:06:38.60,Default,,0,0,0,,Жарайды Наказаки (Наказаки) Иә?
Dialogue: 0,0:06:39.98,0:06:43.11,Default,,0,0,0,,Үй қызметкері айтқандай, маған ұнайды.
Dialogue: 0,0:06:43.19,0:06:47.11,Default,,0,0,0,,Бірақ мен соншалықты үлкен әке емеспін.
Dialogue: 0,0:06:47.24,0:06:50.49,Default,,0,0,0,,Ер – жігіттер, сендер ойлағандай...
Dialogue: 0,0:06:50.61,0:06:53.45,Default,,0,0,0,,Жасы ұлғайған тамақ сізді ақылды етпейді.
Dialogue: 0,0:06:53.57,0:06:56.12,Default,,0,0,0,,Идиоттар – ақымақ
Dialogue: 0,0:06:56.45,0:06:59.16,Default,,0,0,0,,Мен қанша жаста болсам да, ең маңызды қызымның алдында...
Dialogue: 0,0:06:59.29,0:07:02.71,Default,,0,0,0,,Мен әрең көремін немесе сөйлеймін.
Dialogue: 0,0:07:02.83,0:07:06.13,Default,,0,0,0,,Аңғал бала болу оңай.
Dialogue: 0,0:07:07.42,0:07:09.38,Default,,0,0,0,,Мұны сұрама...
Dialogue: 0,0:07:09.84,0:07:12.14,Default,,0,0,0,,Мен одан да көп түсінбеймін.
Dialogue: 0,0:07:12.64,0:07:16.14,Default,,0,0,0,,Өзінің ақымақтығын ашық айтатын адам...
Dialogue: 0,0:07:16.56,0:07:22.15,Default,,0,0,0,,Ол шынымен үлкен бе, ақымақ па, кәрі ме, кінәсіз бе...
Dialogue: 0,0:07:19.02,0:07:20.06,Default,,0,0,0,,Ана-
Dialogue: 0,0:07:20.18,0:07:22.15,Default,,0,0,0,,Кешір мені~
Dialogue: 0,0:07:22.48,0:07:25.65,Default,,0,0,0,,Ал одан да түсініксізі...
Dialogue: 0,0:07:26.02,0:07:27.65,Default,,0,0,0,,Сіздің жеке әрекеттеріңіз.
Dialogue: 0,0:07:28.65,0:07:30.40,Default,,0,0,0,,Мм... Кешіріңіз.
Dialogue: 0,0:07:30.53,0:07:32.86,Default,,0,0,0,,Мен саған салтанатты киіммен кел дедім.
Dialogue: 0,0:07:33.57,0:07:36.24,Default,,0,0,0,,Сондықтан мен мұнда ресми киіммен келдім.
Dialogue: 0,0:07:36.49,0:07:39.20,Default,,0,0,0,,Жоқ, тек сол жағы ресми түрде киінген.
Dialogue: 0,0:07:39.33,0:07:41.37,Default,,0,0,0,,...Менің айтайын дегенім, бұл жай ғана дудл, солай ма?
Dialogue: 0,0:07:41.58,0:07:44.33,Default,,0,0,0,,О, сен смокинг кие алмадың ба?
Dialogue: 0,0:07:44.46,0:07:46.88,Default,,0,0,0,,Жарайды, көйлек нұсқасы да бар.
Dialogue: 0,0:07:47.21,0:07:50.84,Default,,0,0,0,,Мм... Маған күдікті адамдарды кіргізбеу керектігін айтты.
Dialogue: 0,0:07:50.92,0:07:52.88,Default,,0,0,0,,Не күдікті?
Dialogue: 0,0:07:53.01,0:07:53.84,Default,,0,0,0,,Бүкіл дене
Dialogue: 0,0:07:54.22,0:07:56.68,Default,,0,0,0,,Сіз адамдарды мазақ етесіз бе?
Dialogue: 0,0:07:56.80,0:07:59.64,Default,,0,0,0,,Атақты адамдар шынымен де керемет пе? сыпайы болу
Dialogue: 0,0:07:59.77,0:08:01.48,Default,,0,0,0,,Туған күн деп ән айтып жатқанда...
Dialogue: 0,0:08:01.60,0:08:03.06,Default,,0,0,0,,Олар жабайы кеш немесе бір нәрсе өткізіп жатыр!
Dialogue: 0,0:08:03.19,0:08:05.10,Default,,0,0,0,,Сіз шектен шыққан нәрсе айтып тұрсыз ба? ?
Dialogue: 0,0:08:05.40,0:08:08.48,Default,,0,0,0,,Осылай бетперде киіп, таяқпен бір-бірін түрлі заттармен қағу...
Dialogue: 0,0:08:08.61,0:08:10.65,Default,,0,0,0,,Бір-бірінің үстіне ірімшік сеуіп, бірін-бірі тесеміз.
Dialogue: 0,0:08:10.78,0:08:12.74,Default,,0,0,0,,Сіз сондай ұятсыз жиналыс өткізіп жатырсыз!
Dialogue: 0,0:08:12.86,0:08:15.11,Default,,0,0,0,,Бұл жай ғана ірімшік фондю жеу!
Dialogue: 0,0:08:15.36,0:08:18.12,Default,,0,0,0,,Сырттай телефон осындай жерде қатты...
Dialogue: 0,0:08:18.24,0:08:19.24,Default,,0,0,0,,Ұят болды!
Dialogue: 0,0:08:19.79,0:08:22.66,Default,,0,0,0,,Сіз ірімшік фондюі туралы тентек ойларыңыздан ұятсыз!
Dialogue: 0,0:08:22.79,0:08:24.96,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:08:25.92,0:08:28.09,Default,,0,0,0,,Ол кісі менің танысым.
Dialogue: 0,0:08:28.21,0:08:29.38,Default,,0,0,0,,Ах, Наказаки мырза
Dialogue: 0,0:08:29.84,0:08:32.34,Default,,0,0,0,,Директор бармайды, оның орнына...
Dialogue: 0,0:08:32.47,0:08:35.13,Default,,0,0,0,,Түсіндім... неге келмейсің?
Dialogue: 0,0:08:35.26,0:08:37.30,Default,,0,0,0,,Әй, Эзрако-сан! Наказаки мырза!
Dialogue: 0,0:08:37.43,0:08:38.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:38.22,0:08:39.89,Default,,0,0,0,,Келгеніңізге рахмет!
Dialogue: 0,0:08:40.18,0:08:43.43,Default,,0,0,0,,Мен өте қуаныштымын. Тез ішке кір!
Dialogue: 0,0:08:45.94,0:08:46.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:47.19,0:08:48.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:52.19,0:08:54.32,Default,,0,0,0,,Бұл не! Не болып жатыр! ?
Dialogue: 0,0:08:54.74,0:08:56.07,Default,,0,0,0,,Жүйенің дұрыс жұмыс істемеуі! ?
Dialogue: 0,0:08:56.53,0:08:57.57,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:59.20,0:09:00.33,Default,,0,0,0,,(Әйелдердің айқайы)
Dialogue: 0,0:09:00.41,0:09:02.08,Default,,0,0,0,,(Шақырылған қонақтардың шуы)
Dialogue: 0,0:09:03.75,0:09:04.58,Default,,0,0,0,,Терроризм
Dialogue: 0,0:09:04.66,0:09:07.33,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:09:07.46,0:09:08.79,Default,,0,0,0,,Иә
Dialogue: 0,0:09:08.92,0:09:11.09,Default,,0,0,0,,Мацудайра Катакури Тора.
Dialogue: 0,0:09:11.30,0:09:14.34,Default,,0,0,0,,Қызыңыздың өмірі біздің қолымызда.
Dialogue: 0,0:09:14.55,0:09:16.59,Default,,0,0,0,,Бұл Оэдо Хиллс қазірдің өзінде...
Dialogue: 0,0:09:16.72,0:09:18.84,Default,,0,0,0,,Біз, Blues партиясы, бақылауды өз қолымызға алдық.
Dialogue: 0,0:09:19.10,0:09:22.85,Default,,0,0,0,,Қызымның өмірін қаласаң, үндемей, талабымызды орында.
Dialogue: 0,0:09:23.22,0:09:24.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:25.10,0:09:26.52,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:09:26.64,0:09:28.02,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:09:28.15,0:09:28.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:29.19,0:09:32.48,Default,,0,0,0,,Бұл біртүрлі. Оның иісі сөзсіз...
Dialogue: 0,0:09:34.15,0:09:34.99,Default,,0,0,0,,Ии!
Dialogue: 0,0:09:38.32,0:09:41.24,Default,,0,0,0,,Маған демалып, нәжіс шығаруға рұқсат ете аласыз ба?
Dialogue: 0,0:09:42.91,0:09:43.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:44.37,0:09:45.58,Default,,0,0,0,,Иә? (Наказаки) Не?
Dialogue: 0,0:09:45.71,0:09:47.12,Default,,0,0,0,,Бұл не? (Наказаки) Иә?
Dialogue: 0,0:09:50.38,0:09:52.04,Default,,0,0,0,,Эй... Хатшы! ?
Dialogue: 0,0:09:53.21,0:09:54.30,Default,,0,0,0,,Келдіңіз бе?
Dialogue: 0,0:09:54.84,0:09:59.18,Default,,0,0,0,,Не істеп жатырсың?! ? Дәл сол жерде!
Dialogue: 0,0:09:57.76,0:09:59.18,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:09:59.68,0:10:01.85,Default,,0,0,0,,Эзрако, рахмет.
Dialogue: 0,0:10:01.97,0:10:05.85,Default,,0,0,0,,Теменің арқасында пойыздан қалып қоймаған сияқтымын.
Dialogue: 0,0:10:06.56,0:10:08.94,Default,,0,0,0,,Не... қайда барасың, директор?
Dialogue: 0,0:10:09.60,0:10:13.44,Default,,0,0,0,,Бұрын труси жууға арналған кішкене арқасы жоқ еді.
Dialogue: 0,0:10:14.15,0:10:15.94,Default,,0,0,0,,That back is unmistakable-
Dialogue: 0,0:10:16.40,0:10:21.03,Default,,0,0,0,,Бұл біз «Жоятын Құдай» ретінде қорқатын алып тұлға еді.
Dialogue: 0,0:10:23.03,0:10:24.33,Default,,0,0,0,,Кепілге алынған адам-
Dialogue: 0,0:10:24.45,0:10:27.71,Default,,0,0,0,,Курико-чан атақты сегунаттың ауыр салмақтағы ұлдарымен
Dialogue: 0,0:10:28.16,0:10:29.42,Default,,0,0,0,,Apparently, Takeru Suto is...
Dialogue: 0,0:10:29.54,0:10:31.25,Default,,0,0,0,,Get information on celebrity parties.
Dialogue: 0,0:10:31.38,0:10:33.59,Default,,0,0,0,,Бұл біраз бұрын жоспарланған сияқты.
Dialogue: 0,0:10:33.71,0:10:37.84,Default,,0,0,0,,Мен сенімдімін... Мен бұған дейін Тоцуанға қастандық жасамақ болғанмын.
Dialogue: 0,0:10:37.97,0:10:40.05,Default,,0,0,0,,Members were arrested.
Dialogue: 0,0:10:40.18,0:10:42.01,Default,,0,0,0,,Release of the member at that time
Dialogue: 0,0:10:42.14,0:10:44.35,Default,,0,0,0,,And he's demanding Totsuan's head.
Dialogue: 0,0:10:45.06,0:10:49.60,Default,,0,0,0,,Егер талаптарым орындалмаса, мен әрбір 30 минут сайын бір кепілді өлтіремін...
Dialogue: 0,0:10:49.89,0:10:53.81,Default,,0,0,0,,Мен олармен келіссөз жүргіземін және мүмкіндігінше көп уақыт сатып аламын.
Dialogue: 0,0:10:53.94,0:10:56.44,Default,,0,0,0,,Осы уақытта, балалар, кіру жолын іздеу керек.
Dialogue: 0,0:10:56.57,0:10:57.61,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:57.74,0:10:58.69,Default,,0,0,0,,Содан кейін Ямадзаки
Dialogue: 0,0:10:59.32,0:11:01.07,Default,,0,0,0,,Тоцуанмен хабарластыңыз ба?
Dialogue: 0,0:11:01.20,0:11:03.07,Default,,0,0,0,,That's what I've been talking about...
Dialogue: 0,0:11:03.66,0:11:05.95,Default,,0,0,0,,That damn old man...
Dialogue: 0,0:11:06.24,0:11:08.20,Default,,0,0,0,,What are you doing at a time like this?
Dialogue: 0,0:11:08.58,0:11:10.71,Default,,0,0,0,,Сәлеметсіз бе, Анон Чан?
Dialogue: 0,0:11:10.92,0:11:14.59,Default,,0,0,0,,Кешіріңіз, мен бүгін сенімен бірге жүре алмаймын деп ойлаймын.
Dialogue: 0,0:11:14.71,0:11:17.42,Default,,0,0,0,,Енді? Inside the duct... No, no, no, no...
Dialogue: 0,0:11:17.55,0:11:20.01,Default,,0,0,0,,I didn't get a job at Duskin.
Dialogue: 0,0:11:20.13,0:11:23.89,Default,,0,0,0,,Мен ақша беретін жалғыз адам - ​​Аон Чан.
Dialogue: 0,0:11:24.01,0:11:24.97,Default,,0,0,0,,(Қоңырауды күту рингтоны)
Dialogue: 0,0:11:25.10,0:11:27.18,Default,,0,0,0,,Ah, sorry, I got a call again.
Dialogue: 0,0:11:27.31,0:11:30.06,Default,,0,0,0,,Мен осындай немқұрайлы бағыныңқы болғаныма өкінемін.
Dialogue: 0,0:11:30.18,0:11:31.73,Default,,0,0,0,,Олай болса~
Dialogue: 0,0:11:32.06,0:11:34.11,Default,,0,0,0,,Ah, it's finally here! Амансың ба, директор? ?
Dialogue: 0,0:11:34.23,0:11:36.77,Default,,0,0,0,,How many times have you called me? Эй!
Dialogue: 0,0:11:37.02,0:11:41.03,Default,,0,0,0,,Лаңкестердің үйін кездейсоқ шақырмаңыз.
Dialogue: 0,0:11:41.15,0:11:43.91,Default,,0,0,0,,Сіз Аон Чан екеуміздің қарым-қатынасымызды қорқытқыңыз келе ме?
Dialogue: 0,0:11:44.03,0:11:46.12,Default,,0,0,0,,Лаңкестің үйінен үй иесін шақырған адамға -
Dialogue: 0,0:11:46.24,0:11:47.24,Default,,0,0,0,,I don't want you to tell me!
Dialogue: 0,0:11:47.70,0:11:50.66,Default,,0,0,0,,Шабада қалдырған әйелдерді мұңайтпа.
Dialogue: 0,0:11:50.79,0:11:52.96,Default,,0,0,0,,Мен жай ғана өз істерімді реттеп жатыр едім.
Dialogue: 0,0:11:53.08,0:11:56.21,Default,,0,0,0,,Адам өлгенде таза ақ өлім киімін киеді.
Dialogue: 0,0:11:56.34,0:11:58.63,Default,,0,0,0,,Мен тағы 50 адамға қоңырау шалғанша күте тұрыңыз.
Dialogue: 0,0:11:58.75,0:12:01.51,Default,,0,0,0,,Сіз енді кірді кетіре алмайсыз, ол тас қараңғы!
Dialogue: 0,0:12:02.30,0:12:05.14,Default,,0,0,0,,Хиджиката-сан және басқалары жақында келеді.
Dialogue: 0,0:12:05.26,0:12:07.56,Default,,0,0,0,,Тым асықпаңыз!
Dialogue: 0,0:12:07.68,0:12:09.56,Default,,0,0,0,,Жоқ, күтудің қажеті жоқ шығар.
Dialogue: 0,0:12:09.68,0:12:10.52,Default,,0,0,0,,Эзрако-сан?
Dialogue: 0,0:12:11.43,0:12:15.23,Default,,0,0,0,,Күзет жүйесі қолданылып жатқан сияқты және ғимаратқа жақындау оңай емес.
Dialogue: 0,0:12:15.35,0:12:18.23,Default,,0,0,0,,Ах... Сонда біз де осында болсақ...
Dialogue: 0,0:12:18.36,0:12:20.57,Default,,0,0,0,,Мен бұл көліктің радарын бұзамын.
Dialogue: 0,0:12:20.69,0:12:22.49,Default,,0,0,0,,Мен механизм орнаттым
Dialogue: 0,0:12:22.61,0:12:23.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:23.95,0:12:27.16,Default,,0,0,0,,Also, Lord Matsudaira, your present.
Dialogue: 0,0:12:29.37,0:12:30.49,Default,,0,0,0,,Сіз…
Dialogue: 0,0:12:30.62,0:12:34.50,Default,,0,0,0,,Менің бір танысым бар, ол Эдодағы ең жақсы инженер-механик.
Dialogue: 0,0:12:34.62,0:12:37.17,Default,,0,0,0,,Кепілге алынғандарды жазалау 3 сағаттан кейін басталады.
Dialogue: 0,0:12:37.25,0:12:41.38,Default,,0,0,0,,In short, while my neck is connected...
Dialogue: 0,0:12:41.51,0:12:44.18,Default,,0,0,0,,Сондықтан олардың бастарын алу керек, солай ма?
Dialogue: 0,0:12:44.47,0:12:45.43,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:12:45.55,0:12:46.72,Default,,0,0,0,,Эзурако-сан!
Dialogue: 0,0:12:46.84,0:12:48.93,Default,,0,0,0,,But even if I face it blindly...
Dialogue: 0,0:12:49.05,0:12:50.93,Default,,0,0,0,,Жалғыз жеңу мүмкіндігі жоқ.
Dialogue: 0,0:12:51.06,0:12:52.48,Default,,0,0,0,,Мен ынтымақтасамын.
Dialogue: 0,0:12:52.56,0:12:53.43,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:12:53.77,0:12:54.85,Default,,0,0,0,,Бакуго-кунға қарсы қандай жоспары барын сұрамақ едім.
Dialogue: 0,0:12:55.81,0:12:58.11,Default,,0,0,0,,I thought it was weird, but...
Dialogue: 0,0:12:58.23,0:13:00.44,Default,,0,0,0,,Ей, сен жай ғана үй қызметкері емессің.
Dialogue: 0,0:13:00.98,0:13:04.74,Default,,0,0,0,,Жай ғана үй қызметкері... Қарағанды ​​ұнатады.
Dialogue: 0,0:13:06.24,0:13:07.95,Default,,0,0,0,,What about negotiations?
Dialogue: 0,0:13:08.41,0:13:11.45,Default,,0,0,0,,Шығаруға рұқсат алу үшін кемінде бір күн қажет.
Dialogue: 0,0:13:11.70,0:13:13.75,Default,,0,0,0,,Бұл уақытты сатып алудың түсінікті тәсілі.
Dialogue: 0,0:13:13.87,0:13:17.25,Default,,0,0,0,,Оларға орындау уақыты бір минутқа да кешіктірілмейтінін айтыңыз.
Dialogue: 0,0:13:17.37,0:13:18.21,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.50,0:13:21.00,Default,,0,0,0,,Сондай-ақ мынаны қосыңыз:
Dialogue: 0,0:13:21.13,0:13:24.38,Default,,0,0,0,,Мен Лорд Мацудайраның басын алдым, сондықтан бәрі жақсы.
Dialogue: 0,0:13:25.01,0:13:28.34,Default,,0,0,0,,Нақтырақ айтсам, менде...
Dialogue: 0,0:13:28.47,0:13:32.26,Default,,0,0,0,,Ол қызын құтқару үшін кемеге жалғыз келді.
Dialogue: 0,0:13:32.89,0:13:35.39,Default,,0,0,0,,Ku... There's no way he's coming!
Dialogue: 0,0:13:35.52,0:13:39.02,Default,,0,0,0,,Ол адам... мен үшін осындай жерде...
Dialogue: 0,0:13:39.56,0:13:42.15,Default,,0,0,0,,Мен сізді шу шығармай, бірден кездесуге рұқсат етемін.
Dialogue: 0,0:13:42.40,0:13:45.40,Default,,0,0,0,,Decorate with a bright red ribbon
Dialogue: 0,0:13:47.15,0:13:49.45,Default,,0,0,0,,Listen, they're barricaded in...
Dialogue: 0,0:13:49.57,0:13:51.66,Default,,0,0,0,,Бұл жоғарғы қабаттағы негізгі басқару бөлмесі.
Dialogue: 0,0:13:52.24,0:13:53.95,Default,,0,0,0,,You are on the 9th floor.
Dialogue: 0,0:13:54.08,0:13:56.66,Default,,0,0,0,,10-қабаттан бастап ауыр күзетшілер бар.
Dialogue: 0,0:13:57.04,0:14:00.08,Default,,0,0,0,,This mark on the 9th floor is me...
Dialogue: 0,0:14:00.21,0:14:03.17,Default,,0,0,0,,...Why is this mark anyway?
Dialogue: 0,0:14:03.30,0:14:06.67,Default,,0,0,0,,Мені қате түсінбеңіз, бұл жұмсақ балмұздақтың жоғарғы бөлігі.
Dialogue: 0,0:14:06.80,0:14:09.93,Default,,0,0,0,,Ал 10-қабаттағы үш белгі – жау.
Dialogue: 0,0:14:10.01,0:14:13.31,Default,,0,0,0,,Why does she have a cone and I don't?
Dialogue: 0,0:14:13.43,0:14:15.22,Default,,0,0,0,,Дос пен дұшпан бірдей болса, оларды ажырату қиын.
Dialogue: 0,0:14:15.35,0:14:16.81,Default,,0,0,0,,Маған да сал! Мен кіммін?
Dialogue: 0,0:14:16.93,0:14:19.98,Default,,0,0,0,,Мен конустағы кремнің соңғы бөлігін шайқағанды ​​жақсы көремін.
Dialogue: 0,0:14:20.10,0:14:23.23,Default,,0,0,0,,Жарайды, жүгеріден жүгері толтырылғанын қалайсыз, солай ма?
Dialogue: 0,0:14:23.36,0:14:24.57,Default,,0,0,0,,Бұл конус емес.
Dialogue: 0,0:14:24.69,0:14:27.19,Default,,0,0,0,,Мен жаңа ғана тітіркендім, мойындаймын.
Dialogue: 0,0:14:27.28,0:14:29.20,Default,,0,0,0,,Жоқ, екеуі де жақсы!
Dialogue: 0,0:14:29.32,0:14:30.70,Default,,0,0,0,,Мүмкіндігінше
Dialogue: 0,0:14:30.82,0:14:34.12,Default,,0,0,0,,Осы жұмсақ балмұздақпен жанаспастан 50-ші қабатқа ұмтылыңыз.
Dialogue: 0,0:14:34.24,0:14:35.24,Default,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,0:14:35.70,0:14:37.45,Default,,0,0,0,,Клин... болып табылатын жоғарғы бөлік.
Dialogue: 0,0:14:37.58,0:14:39.62,Default,,0,0,0,,Ол оңға және солға жылжып жатқан шығар.
Dialogue: 0,0:14:39.75,0:14:42.13,Default,,0,0,0,,Бұл крин – жаудың қарап тұрған бағыты.
Dialogue: 0,0:14:42.25,0:14:45.34,Default,,0,0,0,,Осы үш Клин бір бағытта Клинге айналғанда...
Dialogue: 0,0:14:45.46,0:14:48.01,Default,,0,0,0,,Бұрылыңыз және қарсы бағытта өтіңіз...
Dialogue: 0,0:14:48.13,0:14:50.47,Default,,0,0,0,,Хмм, бұл түсініксіз! Қандай себеппен?
Dialogue: 0,0:14:50.59,0:14:53.39,Default,,0,0,0,,Сіз осындай маңызды дисплейді көрсету үшін Klin пайдаланасыз ба?
Dialogue: 0,0:14:53.51,0:14:55.10,Default,,0,0,0,,Иә? Бір минут күте тұрыңыз
Dialogue: 0,0:14:53.51,0:14:55.10,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:14:55.43,0:14:57.47,Default,,0,0,0,,Жоғарыдан жұмсақ балмұздақ түседі!
Dialogue: 0,0:14:57.73,0:15:00.23,Default,,0,0,0,,Не! ? Бұл соншалықты сыңғыр емес пе!
Dialogue: 0,0:15:00.48,0:15:01.48,Default,,0,0,0,,Сіз дүрбелеңдесіз бе?
Dialogue: 0,0:15:02.10,0:15:04.15,Default,,0,0,0,,10-қабатта болса да... Түспеймін!
Dialogue: 0,0:15:04.27,0:15:06.57,Default,,0,0,0,,Директордың 9-қабатта екенін байқаймын деп ойламаппын...! ?
Dialogue: 0,0:15:06.65,0:15:07.74,Default,,0,0,0,,Тез тығыл!
Dialogue: 0,0:15:08.74,0:15:09.74,Default,,0,0,0,,Жаман!
Dialogue: 0,0:15:09.86,0:15:11.45,Default,,0,0,0,,Иә! ? Эй... сәл күте тұрыңыз!
Dialogue: 0,0:15:11.57,0:15:13.49,Default,,0,0,0,,Ол жұмсақ және жүгері болып екіге бөлінді!
Dialogue: 0,0:15:14.07,0:15:15.58,Default,,0,0,0,,Оқиға орнында не болып жатыр?
Dialogue: 0,0:15:15.83,0:15:18.04,Default,,0,0,0,,Бір адам жүгіріп түсіп, бір жаққа қарай бет алды.
Dialogue: 0,0:15:18.16,0:15:20.12,Default,,0,0,0,,Бірақ лифтте әлі де біраз бағдарламалық құрал қалды...
Dialogue: 0,0:15:20.25,0:15:21.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:21.79,0:15:23.42,Default,,0,0,0,,Сіз жаңа ғана нәжіс жібердіңіз!
Dialogue: 0,0:15:24.17,0:15:25.54,Default,,0,0,0,,Шамасы, жұмсақ балмұздақ...
Dialogue: 0,0:15:25.67,0:15:28.63,Default,,0,0,0,,Тезек пен адам бір мезгілде жазылған сияқты.
Dialogue: 0,0:15:28.76,0:15:31.26,Default,,0,0,0,,Неліктен нәжіс тіпті көрсетіледі?
Dialogue: 0,0:15:31.38,0:15:34.30,Default,,0,0,0,,Неліктен маған адам сияқты қарамайды?
Dialogue: 0,0:15:35.01,0:15:37.64,Default,,0,0,0,,Мен дәретхананы табу үшін лифтпен түстім, бірақ...
Dialogue: 0,0:15:37.77,0:15:40.94,Default,,0,0,0,,Мен оған қарсы тұра алмаймын және мен ұшқындап жатырмын! Мен мұны істеген сияқтымын
Dialogue: 0,0:15:41.06,0:15:41.81,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:15:42.39,0:15:44.94,Default,,0,0,0,,Бұрынғы конус дәретханада дымқылданып барады.
Dialogue: 0,0:15:45.06,0:15:46.82,Default,,0,0,0,,Бөксіңізді жуып жатырсыз ба?
Dialogue: 0,0:15:46.94,0:15:48.57,Default,,0,0,0,,Жоқ, сен жылап тұрған жоқсың ба?
Dialogue: 0,0:15:48.94,0:15:52.49,Default,,0,0,0,,Күте тұрыңыз, мен жоғарыда көптеген жаулар бар екенін көрдім, бірақ бұл...
Dialogue: 0,0:15:52.61,0:15:54.99,Default,,0,0,0,,Бұл тезектен басқа ештеңе емес!
Dialogue: 0,0:15:55.12,0:15:56.95,Default,,0,0,0,,Енді қайсысы тезек, қайсысы адам?
Dialogue: 0,0:15:57.08,0:15:58.70,Default,,0,0,0,,Мен абдырай бастадым
Dialogue: 0,0:15:59.08,0:16:02.87,Default,,0,0,0,,Қазынаны талқандағанда су құбырлары да бүлінген шығар.
Dialogue: 0,0:16:03.00,0:16:06.25,Default,,0,0,0,,Сонымен, олар өздерінің қорын қосса да, бұдан былай оны төге алмады.
Dialogue: 0,0:16:06.38,0:16:08.21,Default,,0,0,0,,Солай болса да, бұл тым көп! ?
Dialogue: 0,0:16:08.30,0:16:11.38,Default,,0,0,0,,Бірақ сіз бұл жағдайды пайдалана аласыз. Қараңдар!
Dialogue: 0,0:16:11.51,0:16:12.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.63,0:16:13.93,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:16:14.34,0:16:17.47,Default,,0,0,0,,Олардың бәрі таза қора іздеп жоғарыдан түсіп жатыр.
Dialogue: 0,0:16:17.60,0:16:19.68,Default,,0,0,0,,Балалар, сендер дәрет шығарғыларың келе ме?
Dialogue: 0,0:16:20.35,0:16:22.14,Default,,0,0,0,,Олар баспалдақты пайдаланады
Dialogue: 0,0:16:22.27,0:16:24.44,Default,,0,0,0,,Енді лифтпен бірден көтерілуге болады.
Dialogue: 0,0:16:24.56,0:16:26.15,Default,,0,0,0,,Бір минут күтіңіз! ?
Dialogue: 0,0:16:26.27,0:16:28.11,Default,,0,0,0,,Бұрынғы ісінген конус керемет жылдамдықпен қозғалды.
Dialogue: 0,0:16:28.23,0:16:29.69,Default,,0,0,0,,Мен лифтке бара жатырмын!
Dialogue: 0,0:16:30.32,0:16:31.82,Default,,0,0,0,,Сіз мұны шынымен сезіндіңіз бе? ?
Dialogue: 0,0:16:31.94,0:16:35.32,Default,,0,0,0,,Жоқ, мен ренжіп, шалбарымды шешіп алдым, бірақ...
Dialogue: 0,0:16:35.45,0:16:37.78,Default,,0,0,0,,Мен дәлелдерді тыныштандыру және жою үшін келдім.
Dialogue: 0,0:16:38.37,0:16:40.49,Default,,0,0,0,,Лорд Мацудайра, тез жүріңіз!
Dialogue: 0,0:16:40.74,0:16:41.70,Default,,0,0,0,,Шинохара-сан…
Dialogue: 0,0:16:42.37,0:16:43.75,Default,,0,0,0,,А... бұл!
Dialogue: 0,0:16:43.87,0:16:46.17,Default,,0,0,0,,Лифт астына жабысып қалды!
Dialogue: 0,0:16:46.58,0:16:48.71,Default,,0,0,0,,Шалбар деген не деген құмар
Dialogue: 0,0:16:48.84,0:16:50.80,Default,,0,0,0,,Білгіңіз келмейтініне сенімдісіз бе?
Dialogue: 0,0:16:50.92,0:16:53.67,Default,,0,0,0,,Хатшы! Төменде конус жігіт бар!
Dialogue: 0,0:16:53.80,0:16:55.09,Default,,0,0,0,,Бұл қайсысы, директор?
Dialogue: 0,0:16:56.47,0:16:59.18,Default,,0,0,0,,Ах! Конус өзінің өткір ұшын...
Dialogue: 0,0:16:59.30,0:17:00.43,Default,,0,0,0,,Еденді бұзып өтуге тырысу!
Dialogue: 0,0:17:00.56,0:17:02.73,Default,,0,0,0,,Жоқ... Бұл ұшты ұшы қандай? ?
Dialogue: 0,0:17:02.81,0:17:04.60,Default,,0,0,0,,Бұл сенсордың сипаттамасы ғана! ?
Dialogue: 0,0:17:04.73,0:17:07.23,Default,,0,0,0,,Ах! Менің нәжіме кіріп кетті!
Dialogue: 0,0:17:07.35,0:17:09.82,Default,,0,0,0,,Бұл бастық па? ? Бұл нәжіс пе? ?
Dialogue: 0,0:17:09.94,0:17:11.07,Default,,0,0,0,,Бұл қайсысы?
Dialogue: 0,0:17:11.19,0:17:14.24,Default,,0,0,0,,Жүгері жігіт лорд Мацудайраны сүйреп түсірмекші!
Dialogue: 0,0:17:16.32,0:17:18.49,Default,,0,0,0,,Ах! Қиын жағдайда көмектесіңіз!
Dialogue: 0,0:17:18.62,0:17:21.79,Default,,0,0,0,,Неге! ? Поп неге қолын созып жатыр! ?
Dialogue: 0,0:17:21.91,0:17:25.33,Default,,0,0,0,,Мүмкін бұл лорд Мацудайра болған шығар...
Dialogue: 0,0:17:25.41,0:17:28.50,Default,,0,0,0,,Ах, тамырлар ақыры көнді де, жүгері құлады, тек жүгері!
Dialogue: 0,0:17:28.63,0:17:30.25,Default,,0,0,0,,Болды, шалбар неге кір?
Dialogue: 0,0:17:30.38,0:17:31.96,Default,,0,0,0,,Сіз мені қорғауға тырысып жатырсыз ба?
Dialogue: 0,0:17:32.05,0:17:35.30,Default,,0,0,0,,Нашар! Жұмсақ балмұздақ командасы біртүрлі нәрсені байқаған сияқты!
Dialogue: 0,0:17:35.38,0:17:38.47,Default,,0,0,0,,Жоғарғы қабатқа көтерілсеңіз, ара ұясын табасыз!
Dialogue: 0,0:17:39.14,0:17:42.31,Default,,0,0,0,,Екіге бөл! Не айтқың келеді! ?
Dialogue: 0,0:17:42.43,0:17:45.64,Default,,0,0,0,,Нәжістің екеуі де қазір дербес жұмыс істейді!
Dialogue: 0,0:17:45.93,0:17:49.81,Default,,0,0,0,,Лорд Мацудайраны жіберіп алу үшін олардың барлығын өз қолыңызға алуды жоспарлап отырсыз ба?
Dialogue: 0,0:17:49.94,0:17:52.23,Default,,0,0,0,,Бұл тек тезегі бар шалбар! ?
Dialogue: 0,0:17:52.36,0:17:54.15,Default,,0,0,0,,Неліктен серіктес ретінде әрекет етесіз?
Dialogue: 0,0:17:54.53,0:17:55.36,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:17:55.49,0:17:57.07,Default,,0,0,0,,Шалбарды мүлде елемей жұмсақ балмұздақ дайындайтын топ.
Dialogue: 0,0:17:57.20,0:17:58.20,Default,,0,0,0,,Біз 50-қабатқа бара жатырмыз!
Dialogue: 0,0:17:58.32,0:18:01.41,Default,,0,0,0,,Дұрыс! Бұл егеуқұйрықтардың толық қапшығы!
Dialogue: 0,0:18:03.37,0:18:05.04,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:18:05.75,0:18:06.54,Default,,0,0,0,,О...
Dialogue: 0,0:18:07.83,0:18:09.04,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:18:11.00,0:18:11.92,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:18:12.00,0:18:13.88,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,0:18:14.38,0:18:16.88,Default,,0,0,0,,Жұмсақ балмұздақтар бірінен соң бірі жоғалып барады!
Dialogue: 0,0:18:17.17,0:18:19.89,Default,,0,0,0,,Әйтеуір, бұл тезек – бұрыс...!
Dialogue: 0,0:18:20.34,0:18:25.18,Default,,0,0,0,,♪ хм/сағ хм/сағ хм/сағ
Dialogue: 0,0:18:25.31,0:18:28.81,Default,,0,0,0,,♪Хмф Хмф Хмф Хмф
Dialogue: 0,0:18:29.44,0:18:33.32,Default,,0,0,0,,Туған күнің құтты болсын
Dialogue: 0,0:18:33.40,0:18:37.82,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,0:18:38.15,0:18:41.78,Default,,0,0,0,,Мен лаңкестерді өлтірген бір адам екеніне сене алмадым...
Dialogue: 0,0:18:41.91,0:18:46.08,Default,,0,0,0,,Жоқ, бізде әлі де соңғы конус бар.
Dialogue: 0,0:18:49.21,0:18:51.04,Default,,0,0,0,,Мен жаман нәрсе жасадым.
Dialogue: 0,0:18:51.17,0:18:55.84,Default,,0,0,0,,Сіздің қымбат шалбарыңыз бен әскерлеріңіз қазір жоғалып кетті.
Dialogue: 0,0:18:56.34,0:18:58.97,Default,,0,0,0,,Жоқ... Рахмет айтамын.
Dialogue: 0,0:18:59.05,0:19:00.97,Default,,0,0,0,,Саған рахмет, ұстамадым.
Dialogue: 0,0:19:03.51,0:19:07.98,Default,,0,0,0,,Сіз әкелік рөліңізден гөрі полиция қызметкерінің рөлін таңдайсыз ба?
Dialogue: 0,0:19:08.35,0:19:10.89,Default,,0,0,0,,Жоқ, қызын қалқан етіп пайдаланғаны рас...
Dialogue: 0,0:19:11.02,0:19:14.94,Default,,0,0,0,,Өзін жақсы көретін адам - әке болу сәтсіздігі.
Dialogue: 0,0:19:15.48,0:19:17.78,Default,,0,0,0,,Бірақ қызымды ренжіткен бейбаққа...
Dialogue: 0,0:19:17.90,0:19:20.78,Default,,0,0,0,,Жұдырық көтере алмайтындар...
Dialogue: 0,0:19:20.90,0:19:23.49,Default,,0,0,0,,Әкесі былай тұрсын, Хань да емес.
Dialogue: 0,0:19:24.49,0:19:27.49,Default,,0,0,0,,Әкенің рөлі қандай екенін білсем ғой.
Dialogue: 0,0:19:27.83,0:19:30.33,Default,,0,0,0,,Қақау болса бала жақсы өседі.
Dialogue: 0,0:19:30.46,0:19:33.54,Default,,0,0,0,,Үйге ақша салған соң, басқа ештеңе қажет емес.
Dialogue: 0,0:19:33.67,0:19:35.17,Default,,0,0,0,,Сіз не істей алатыныңызды айта отырып...
Dialogue: 0,0:19:35.29,0:19:38.42,Default,,0,0,0,,Жақсылық жасасаң, мен сені барынша мақтаймын.
Dialogue: 0,0:19:38.55,0:19:41.55,Default,,0,0,0,,Тәртіпсіздік жасасаң, қатты ұрысамын...
Dialogue: 0,0:19:41.68,0:19:43.26,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:19:44.89,0:19:49.18,Default,,0,0,0,,Бұл данышпан Ұлттық полиция агенттігінің комиссары.
Dialogue: 0,0:19:49.31,0:19:53.27,Default,,0,0,0,,Менің жұмысым осы Эдоның сұм қарт адамы болу.
Dialogue: 0,0:19:54.65,0:19:56.77,Default,,0,0,0,,А... міне, солай!
Dialogue: 0,0:19:56.90,0:19:59.65,Default,,0,0,0,,Менің… менің шалбарым әлі киімде!
Dialogue: 0,0:20:01.53,0:20:04.70,Default,,0,0,0,,Бұрын ашылғаны менің шалбарым болды.
Dialogue: 0,0:20:04.82,0:20:06.66,Default,,0,0,0,,Әке ретінде айтайын.
Dialogue: 0,0:20:11.54,0:20:13.42,Default,,0,0,0,,Жәй шалбар...
Dialogue: 0,0:20:17.21,0:20:20.17,Default,,0,0,0,,Өздеріңізді жуыңыз!
Dialogue: 0,0:20:25.89,0:20:27.47,Default,,0,0,0,,Қандай ысырап (Хиджиката) Угга
Dialogue: 0,0:20:28.10,0:20:30.97,Default,,0,0,0,,Бұл ұпай жинаудың тамаша мүмкіндігі болды.
Dialogue: 0,0:20:31.43,0:20:33.23,Default,,0,0,0,,Сіз мұнымен ешнәрсе есіңізде қалмайды.
Dialogue: 0,0:20:33.69,0:20:36.56,Default,,0,0,0,,Мен бұрыннан келе жатқан жаман қарт болғаным жақсы.
Dialogue: 0,0:20:36.69,0:20:38.94,Default,,0,0,0,,Өйткені бұл оңай...
Dialogue: 0,0:20:39.61,0:20:40.48,Default,,0,0,0,,Ал, аш.
Dialogue: 0,0:20:41.07,0:20:43.20,Default,,0,0,0,,Бұл сіздің сыйлығыңыз емес.
Dialogue: 0,0:20:43.32,0:20:46.11,Default,,0,0,0,,Мен мұны қызымның бөлмесін жинап жүріп тауып алдым.
Dialogue: 0,0:20:48.95,0:20:53.12,Default,,0,0,0,,Сен келгенде оны саған бермек болған шығар.
Dialogue: 0,0:20:54.58,0:20:58.38,Default,,0,0,0,,Уайымдама, мен саған сыйлығыңды қалдырдым.
Dialogue: 0,0:20:58.63,0:21:01.30,Default,,0,0,0,,Сіз өзіңізді қауіпсіз сезіне аласыз ба?
Dialogue: 0,0:21:01.42,0:21:04.63,Default,,0,0,0,,Қызымның бөлмесіне рұқсатсыз кірген үй қызметкері...
Dialogue: 0,0:21:04.76,0:21:06.89,Default,,0,0,0,,Мен бүгін жұмыстан шығарылдым.
Dialogue: 0,0:21:06.97,0:21:08.39,Default,,0,0,0,,Наказаки! (Наказаки) Иә!
Dialogue: 0,0:21:08.72,0:21:11.64,Default,,0,0,0,,Шіріген үй қызметкерін канализацияға тастаңыз.
Dialogue: 0,0:21:12.18,0:21:13.35,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:21:13.48,0:21:15.81,Default,,0,0,0,,Мен оны полицейлер көрмейтін дренажға лақтырып жіберемін.
Dialogue: 0,0:21:15.94,0:21:17.27,Default,,0,0,0,,Ақылсыз ештеңе айтпа.
Dialogue: 0,0:21:17.40,0:21:18.40,Default,,0,0,0,,Мені ал! (Наказаки) Иә!
Dialogue: 0,0:21:18.81,0:21:22.65,Default,,0,0,0,,Келесі кездескенімізде, мен серік болудан құтыла алмаймын, Катсура.
Dialogue: 0,0:21:23.99,0:21:26.41,Default,,0,0,0,,Хмф, мен мұны қалаймын.
Dialogue: 0,0:21:27.70,0:21:30.91,Default,,0,0,0,,Ұлттық полиция агенттігінің комиссары Катакури Тора Матсудайра…
Dialogue: 0,0:21:31.62,0:21:35.41,Default,,0,0,0,,Біз Джой Рошидің ең үлкен және ең күшті жауымыз.
Dialogue: 0,0:21:36.46,0:21:38.88,Default,,0,0,0,,Күйеуім, тоқташы.
Dialogue: 0,0:21:38.13,0:21:42.75,Default,,0,0,0,,«Маған үйде орын қажет емес, әлем менің үйім».
Dialogue: 0,0:21:39.00,0:21:41.25,Default,,0,0,0,,Мен кір жуамын.
Dialogue: 0,0:21:41.38,0:21:44.55,Default,,0,0,0,,Жарайды, мен мұны істеймін.
Dialogue: 0,0:21:42.88,0:21:46.43,Default,,0,0,0,,Өтірік, ол бүгін тағы да майданға аттанып жатыр.
Dialogue: 0,0:21:44.67,0:21:46.43,Default,,0,0,0,,Ах, Курико-сама
Dialogue: 0,0:21:46.97,0:21:49.43,Default,,0,0,0,,Жақсы, сүйкімді шаш қыстырғыш
Dialogue: 0,0:21:49.68,0:21:53.27,Default,,0,0,0,,Бірақ мен оны өз көзіммен көрдім.
Dialogue: 0,0:21:53.39,0:21:58.52,Default,,0,0,0,,Екеуі бір-біріне қарама-қарсы тұрса да, әке мен бала арасындағы байланыс сөзсіз байланысты.
Dialogue: 0,0:21:59.44,0:22:02.94,Default,,0,0,0,,Ал дүниедегі боқ атаның қадірі.
Dialogue: 0,0:22:03.48,0:22:05.44,Default,,0,0,0,,Мацудайра Катакури Тора
Dialogue: 0,0:22:05.90,0:22:09.28,Default,,0,0,0,,Екінші тарап үшін кемшілік жоқ
Dialogue: 0,0:22:10.53,0:22:16.54,Default,,0,0,0,,♪~
Dialogue: 0,0:23:41.41,0:23:45.38,Default,,0,0,0,,Келесі жолы «Көк және қызыл экстази»
Dialogue: 0,0:23:46.88,0:23:52.88,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory