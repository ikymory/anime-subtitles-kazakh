Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.87,0:00:07.00,Default,,0,0,0,,Әр адамның жүрегінде жұлдыз бар
Dialogue: 0,0:00:17.85,0:00:19.81,Default,,0,0,0,,-Ах! -(Мамору) Иә?
Dialogue: 0,0:00:19.89,0:00:22.39,Default,,0,0,0,,Сондай-ақ аққан жұлдыз
Dialogue: 0,0:00:23.14,0:00:24.39,Default,,0,0,0,,Сіз тілек айттыңыз ба?
Dialogue: 0,0:00:24.48,0:00:25.65,Default,,0,0,0,,Буу!
Dialogue: 0,0:00:25.73,0:00:31.28,Default,,0,0,0,,Мамо-чан әрқашан жанымда болады деп сенемін.
Dialogue: 0,0:00:32.53,0:00:34.57,Default,,0,0,0,,Енді қайтеміз?
Dialogue: 0,0:00:35.45,0:00:36.41,Default,,0,0,0,,Иә
Dialogue: 0,0:00:42.25,0:00:45.29,Default,,0,0,0,,Тағы бір метеорлық жауын
Dialogue: 0,0:00:45.37,0:00:48.33,Default,,0,0,0,,Соңғы уақытта, күн сайын
Dialogue: 0,0:00:54.67,0:00:56.47,Default,,0,0,0,,Әдемі жарық
Dialogue: 0,0:00:56.55,0:00:58.39,Default,,0,0,0,,Бұл күміс ай кристалы.
Dialogue: 0,0:00:58.47,0:01:00.14,Default,,0,0,0,,Алтын кристалды жарық
Dialogue: 0,0:01:00.89,0:01:03.48,Default,,0,0,0,,Галактиканың шыңында тұрған жеңімпазға —
Dialogue: 0,0:01:03.56,0:01:05.64,Default,,0,0,0,,Бұл жарасымды жылтыр.
Dialogue: 0,0:01:05.73,0:01:09.90,Default,,0,0,0,,Бұл жарқырау жақын арада қолжетімді болады
Dialogue: 0,0:01:12.69,0:01:18.99,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:01:39.26,0:01:42.60,Default,,0,0,0,,Кешіріңіз, мен шыншыл емеспін.
Dialogue: 0,0:01:42.68,0:01:46.23,Default,,0,0,0,,Түсінде айтуға болады
Dialogue: 0,0:01:46.31,0:01:49.40,Default,,0,0,0,,Ойлау тізбегі қысқа тұйықталу шегінде
Dialogue: 0,0:01:49.48,0:01:52.07,Default,,0,0,0,,Мен сені дәл қазір көргім келеді
Dialogue: 0,0:01:52.90,0:01:56.24,Default,,0,0,0,,Жылағыңыз келетін ай сәулесі
Dialogue: 0,0:01:56.32,0:01:59.49,Default,,0,0,0,,Түн жарымда да телефон соға алмаймын
Dialogue: 0,0:01:59.57,0:02:02.62,Default,,0,0,0,,Мен таза болғандықтан, мен не істеуім керек?
Dialogue: 0,0:02:02.70,0:02:06.58,Default,,0,0,0,,Жүрек - калейдоскоп
Dialogue: 0,0:02:06.66,0:02:13.38,Default,,0,0,0,,Ай сәулесінің жетегінде
Dialogue: 0,0:02:13.46,0:02:20.14,Default,,0,0,0,,Көп рет кездесіңіз
Dialogue: 0,0:02:20.22,0:02:23.56,Default,,0,0,0,,Шоқжұлдыздарды жыпылықтап санау
Dialogue: 0,0:02:23.64,0:02:26.93,Default,,0,0,0,,Махаббат тағдырын болжау
Dialogue: 0,0:02:27.02,0:02:30.23,Default,,0,0,0,,Бір жерде туған
Dialogue: 0,0:02:30.31,0:02:33.69,Default,,0,0,0,,Ғажайып романс
Dialogue: 0,0:02:33.77,0:02:40.16,Default,,0,0,0,,Мен ғажайып романтикаға сенемін
Dialogue: 0,0:02:45.54,0:02:46.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:46.95,0:02:53.84,Default,,0,0,0,,(оятар дыбысы)
Dialogue: 0,0:02:55.42,0:02:56.25,Default,,0,0,0,,Аа...
Dialogue: 0,0:02:57.51,0:02:59.59,Default,,0,0,0,,Жылағаннан пайда жоқ
Dialogue: 0,0:03:02.80,0:03:04.93,Default,,0,0,0,,Чибиусачан
Dialogue: 0,0:03:05.01,0:03:07.60,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:03:07.68,0:03:09.60,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:03:09.68,0:03:11.44,Default,,0,0,0,,Хотару-чан хехе...
Dialogue: 0,0:03:11.52,0:03:13.06,Default,,0,0,0,,Мен кетемін.
Dialogue: 0,0:03:13.15,0:03:14.98,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:15.06,0:03:17.57,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:03:17.65,0:03:18.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:18.94,0:03:22.57,Default,,0,0,0,,Сосын сол кезде Кюсуке мен Момо-чан...
Dialogue: 0,0:03:22.66,0:03:24.32,Default,,0,0,0,,Өтірік! Шынымен бе?
Dialogue: 0,0:03:24.41,0:03:26.24,Default,,0,0,0,,-Шынымен, шынымен -Біз жақсы араласамыз.
Dialogue: 0,0:03:26.33,0:03:28.91,Default,,0,0,0,,Таңертеңнен бері қол ұстасып келеміз.
Dialogue: 0,0:03:29.00,0:03:29.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:29.91,0:03:34.21,Default,,0,0,0,,Иә? Мамо-чанның қолын ұстасам қалай?
Dialogue: 0,0:03:34.29,0:03:35.96,Default,,0,0,0,,-Хмф! -Ах!
Dialogue: 0,0:03:36.04,0:03:37.88,Default,,0,0,0,,Қоян ақымақ!
Dialogue: 0,0:03:42.97,0:03:44.26,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:03:44.34,0:03:45.35,Default,,0,0,0,,О!
Dialogue: 0,0:03:45.43,0:03:48.64,Default,,0,0,0,,Қайырлы таң Усаги, бүгін дене шынықтыру волейболы.
Dialogue: 0,0:03:48.72,0:03:50.27,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:03:50.35,0:03:51.56,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:03:51.64,0:03:54.56,Default,,0,0,0,,Ағылшын тілі мен математикаға дұрыс дайындалдың ба?
Dialogue: 0,0:03:54.65,0:03:55.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:01.24,0:04:05.03,Default,,0,0,0,,Таңертең ояну соншалықты шаршайды.
Dialogue: 0,0:04:05.11,0:04:08.24,Default,,0,0,0,,Аа, қайырлы таң, Мичиру-сенпай.
Dialogue: 0,0:04:08.33,0:04:09.83,Default,,0,0,0,,Қайырлы таң Кайу-сан
Dialogue: 0,0:04:09.91,0:04:11.25,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:11.33,0:04:12.62,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:04:12.71,0:04:15.12,Default,,0,0,0,,Мичиру Көңілді көрінеді
Dialogue: 0,0:04:15.21,0:04:17.13,Default,,0,0,0,,Көңілді
Dialogue: 0,0:04:17.21,0:04:22.26,Default,,0,0,0,,Дүние жүзін аралап, балаларды тәрбиелеп, қазір орта мектепте оқисыз ба?
Dialogue: 0,0:04:22.34,0:04:26.09,Default,,0,0,0,,Біз тағы да жастық шағымыздан ләззат аламыз.
Dialogue: 0,0:04:26.18,0:04:29.51,Default,,0,0,0,,Ах~ Мектеп өмірі мені қатты қызықтырады
Dialogue: 0,0:04:29.60,0:04:31.77,Default,,0,0,0,,Қазір туралы Сецуна...
Dialogue: 0,0:04:33.43,0:04:34.85,Default,,0,0,0,,Уф... мен өлемін.
Dialogue: 0,0:04:34.94,0:04:36.27,Default,,0,0,0,,-Не айтып тұрсың! -(Балалар) Ауырып тұр!
Dialogue: 0,0:04:36.35,0:04:37.86,Default,,0,0,0,,Осыншама зиянмен
Dialogue: 0,0:04:37.94,0:04:40.19,Default,,0,0,0,,Сыныпқа тез оралу
Dialogue: 0,0:04:40.28,0:04:41.99,Default,,0,0,0,,Мұғалім Сецуна!
Dialogue: 0,0:04:42.07,0:04:42.86,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:04:42.94,0:04:44.57,Default,,0,0,0,,-Тағы жараланған адам? -Хехе...
Dialogue: 0,0:04:44.65,0:04:46.24,Default,,0,0,0,,Мұғалім Сецуна!
Dialogue: 0,0:04:46.32,0:04:49.49,Default,,0,0,0,,Сецуна-сенсэй маған оның Хотару-чанның анасы екенін айтқан кезде
Dialogue: 0,0:04:49.58,0:04:51.49,Default,,0,0,0,,Барлығы қызғаншақ
Dialogue: 0,0:04:51.58,0:04:53.37,Default,,0,0,0,,Ал, хехехе...
Dialogue: 0,0:04:58.00,0:04:59.54,Default,,0,0,0,,-Ах... -(Минако) Фуфуфуфу...
Dialogue: 0,0:05:04.63,0:05:05.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:08.30,0:05:09.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:12.14,0:05:13.73,Default,,0,0,0,,Мамо-чанды шығарып салу?
Dialogue: 0,0:05:13.81,0:05:16.35,Default,,0,0,0,,...бүгін болды ма?
Dialogue: 0,0:05:16.44,0:05:18.73,Default,,0,0,0,,Сонда ол депрессияға ұшырады ма?
Dialogue: 0,0:05:18.81,0:05:23.61,Default,,0,0,0,,Маморудың Америка Құрама Штаттарында шетелде оқу туралы шешімі шынымен кенеттен қабылданған шешім болды.
Dialogue: 0,0:05:23.69,0:05:28.49,Default,,0,0,0,,Қояндар да шынымен бұзылған балалар. Бір-бірімізді енді көрмейтін сияқтымыз.
Dialogue: 0,0:05:28.57,0:05:29.74,Default,,0,0,0,,Не?
Dialogue: 0,0:05:29.82,0:05:32.95,Default,,0,0,0,,Мен «Үш жарық» фильмінің жазбасын көруді ойладым.
Dialogue: 0,0:05:33.04,0:05:35.00,Default,,0,0,0,,Тағы бір жаңа кумир?
Dialogue: 0,0:05:35.08,0:05:36.04,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:05:36.12,0:05:39.63,Default,,0,0,0,,Бұл үш адамнан тұратын «Үш жарық» тобы қазір менің сүйікті тобым!
Dialogue: 0,0:05:39.71,0:05:42.71,Default,,0,0,0,,Қыз сияқты сүйкімді түнгі аспан
Dialogue: 0,0:05:42.80,0:05:44.55,Default,,0,0,0,,Ересектерге арналған ауа жарығы
Dialogue: 0,0:05:44.63,0:05:48.89,Default,,0,0,0,,Ең танымал крутой жігіт Хикару Хошино
Dialogue: 0,0:05:48.97,0:05:52.89,Default,,0,0,0,,Мен жаңа ғана дебют жасадым және ақыры фан-клуб аштым.
Dialogue: 0,0:05:52.97,0:05:55.14,Default,,0,0,0,,Әрине мүшелік саны 1 цифр
Dialogue: 0,0:05:55.22,0:05:59.98,Default,,0,0,0,,Ол әдемі, әнді де жақсы айтады, билейді де.
Dialogue: 0,0:06:00.06,0:06:02.27,Default,,0,0,0,,Әрине, менде CD бар.
Dialogue: 0,0:06:02.36,0:06:06.65,Default,,0,0,0,,Ах! Қызық, олар жақында концерт қоя ма?
Dialogue: 0,0:06:06.74,0:06:08.07,Default,,0,0,0,,О, мына балалар.
Dialogue: 0,0:06:08.15,0:06:09.66,Default,,0,0,0,,- Иә? -(Минако) Is Мичиру a fan too?
Dialogue: 0,0:06:09.74,0:06:12.20,Default,,0,0,0,,Келесі жолы Fantastic халықаралық музыка фестивалінде
Dialogue: 0,0:06:12.28,0:06:13.83,Default,,0,0,0,,Бұл менің алғашқы тікелей шоуым.
Dialogue: 0,0:06:13.91,0:06:16.58,Default,,0,0,0,,Иә? неге? Неліктен?
Dialogue: 0,0:06:16.66,0:06:20.21,Default,,0,0,0,,Мичиру туралы фан-клубта жоқ қандай да бір ақпаратты білесіз бе?
Dialogue: 0,0:06:20.29,0:06:24.09,Default,,0,0,0,,Мен олармен бірге сол музыкалық фестивальде боламын.
Dialogue: 0,0:06:24.17,0:06:26.88,Default,,0,0,0,,Бұл құрылғы түрленіп, көптеген табақшалармен резонансқа түсіп
Dialogue: 0,0:06:26.96,0:06:30.59,Default,,0,0,0,,Жарайды! Мичирудан билеттерді алыңыз
Dialogue: 0,0:06:30.68,0:06:34.01,Default,,0,0,0,,Барлығымыз «Үш жарық» концертіне барайық!
Dialogue: 0,0:06:34.10,0:06:35.14,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:06:35.22,0:06:36.89,Default,,0,0,0,,Мина тыныш
Dialogue: 0,0:06:36.97,0:06:38.52,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:06:38.60,0:06:41.31,Default,,0,0,0,,Біз бұл тыныштықты қалпына келтірдік.
Dialogue: 0,0:06:41.40,0:06:45.23,Default,,0,0,0,,Сіз орта мектептегі өмірден ләззат алуыңыз керек!
Dialogue: 0,0:06:45.32,0:06:50.74,Default,,0,0,0,,(Ұшақ дыбысы)
Dialogue: 0,0:06:50.82,0:06:53.03,Default,,0,0,0,,Сіз бұл жерде қанша уақыт болдыңыз?
Dialogue: 0,0:06:53.12,0:06:56.79,Default,,0,0,0,,Бір жыл ғана болды, бірақ сәл ұзағырақ болуы мүмкін.
Dialogue: 0,0:06:57.87,0:06:59.29,Default,,0,0,0,,Бір жыл?
Dialogue: 0,0:06:59.37,0:07:03.88,Default,,0,0,0,,Егер сіздің дипломдық жұмысыңыз таңдалса, Америкада шетелде оқуыңызға болады.
Dialogue: 0,0:07:03.96,0:07:05.96,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:07:06.05,0:07:09.42,Default,,0,0,0,,Мен одан сайын бақытты болуым керек.
Dialogue: 0,0:07:11.88,0:07:13.47,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:13.55,0:07:18.31,Default,,0,0,0,,Мен сені бүгін күлімдеп шығарып салуды жоспарлап едім.
Dialogue: 0,0:07:19.35,0:07:20.73,Default,,0,0,0,,Қоян...
Dialogue: 0,0:07:21.81,0:07:25.15,Default,,0,0,0,,Мен хат жазамын және электрондық поштаны жіберемін.
Dialogue: 0,0:07:25.23,0:07:28.11,Default,,0,0,0,,Усамо, маған көп хат жаз.
Dialogue: 0,0:07:29.19,0:07:33.57,Default,,0,0,0,,Көп жазыңыз және көп хат жіберіңіз
Dialogue: 0,0:07:33.66,0:07:34.62,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:36.74,0:07:38.70,Default,,0,0,0,,Ара-тұра оралыңыз.
Dialogue: 0,0:07:38.79,0:07:40.62,Default,,0,0,0,,Мен міндетті түрде қайтамын
Dialogue: 0,0:07:40.71,0:07:44.08,Default,,0,0,0,,Борттағы жолаушыларға арналған ақпарат
Dialogue: 0,0:07:45.08,0:07:47.59,Default,,0,0,0,,16-рейс жақында Лос-Анджелеске аттанады...
Dialogue: 0,0:07:47.67,0:07:49.05,Default,,0,0,0,,-(Мамору) АҚШ -Иә?
Dialogue: 0,0:07:50.76,0:07:52.05,Default,,0,0,0,,Қазіргі
Dialogue: 0,0:07:52.13,0:07:53.72,Default,,0,0,0,,Оны ашып көріңіз.
Dialogue: 0,0:07:57.97,0:08:00.06,Default,,0,0,0,,Мамо-чан бұл...
Dialogue: 0,0:08:00.98,0:08:03.94,Default,,0,0,0,,Мен бақыттымын! Рахмет Мамо Чан!
Dialogue: 0,0:08:04.02,0:08:05.61,Default,,0,0,0,,Мен оны киіп көрсем болады ма?
Dialogue: 0,0:08:14.99,0:08:15.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:17.16,0:08:18.62,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:08:23.08,0:08:25.37,Default,,0,0,0,,Қоян Мен қайтып келгенде...
Dialogue: 0,0:08:44.69,0:08:45.90,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:08:54.53,0:08:55.45,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:56.86,0:08:58.45,Default,,0,0,0,,Бұл қандай ойын-сауық?
Dialogue: 0,0:08:58.53,0:08:59.74,Default,,0,0,0,,Үш шам!
Dialogue: 0,0:08:59.83,0:09:00.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:00.66,0:09:02.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:02.16,0:09:03.08,Default,,0,0,0,,Хошино!
Dialogue: 0,0:09:03.16,0:09:04.83,Default,,0,0,0,,- (Female) Atmosphere! -(Әйел) Ятен!
Dialogue: 0,0:09:04.91,0:09:06.42,Default,,0,0,0,,- (Әйел) Ах! -(Ер) Иә?
Dialogue: 0,0:09:06.50,0:09:08.88,Default,,0,0,0,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,0:09:10.29,0:09:12.13,Default,,0,0,0,,Бір минут, Ұсуке.
Dialogue: 0,0:09:14.09,0:09:16.13,Default,,0,0,0,,Османт хош иісі
Dialogue: 0,0:09:18.64,0:09:21.60,Default,,0,0,0,,Біраз уақыттан кейін Джубанға жетеміз.
Dialogue: 0,0:09:23.14,0:09:25.31,Default,,0,0,0,,Мен түсуім керек.
Dialogue: 0,0:09:25.39,0:09:26.81,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:09:28.06,0:09:31.11,Default,,0,0,0,,Маған жібергеніңіз үшін рахмет айтқым келді...
Dialogue: 0,0:09:31.19,0:09:35.28,Default,,0,0,0,,Уф... Хошино: Менің қолым кедергі болып тұр.
Dialogue: 0,0:09:36.07,0:09:38.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:38.32,0:09:42.70,Default,,0,0,0,,(оятар дыбысы)
Dialogue: 0,0:09:45.04,0:09:46.37,Default,,0,0,0,,Қоян!
Dialogue: 0,0:09:46.46,0:09:48.17,Default,,0,0,0,,Кешегі күн қалай өтті?
Dialogue: 0,0:09:48.25,0:09:52.88,Default,,0,0,0,,Мамо-чанмен қоштасу сүйісін бөлістіңіз бе?
Dialogue: 0,0:09:52.96,0:09:55.09,Default,,0,0,0,,Иә? Қоян?
Dialogue: 0,0:09:55.17,0:09:59.89,Default,,0,0,0,,Ах! Менің сол жақ саусағымда сақина бар!
Dialogue: 0,0:09:59.97,0:10:02.01,Default,,0,0,0,,Мамо-чаннан алдың ба?
Dialogue: 0,0:10:02.10,0:10:03.47,Default,,0,0,0,,​​Керемет тамаша!
Dialogue: 0,0:10:03.56,0:10:04.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.47,0:10:08.98,Default,,0,0,0,,Иә, Мамо-чан маған бұл сақинаны сыйлады.
Dialogue: 0,0:10:09.06,0:10:12.90,Default,,0,0,0,,Ұшаққа мініп, Америкаға аман-есен жеттім.
Dialogue: 0,0:10:14.73,0:10:19.36,Default,,0,0,0,,Жарайды, мен 30 ғасырға оралуды ойлап отырмын.
Dialogue: 0,0:10:19.45,0:10:22.03,Default,,0,0,0,,Маған қызғылт ай хрусталы көрінді.
Dialogue: 0,0:10:22.70,0:10:25.54,Default,,0,0,0,,Теңізші Серес пен Элиостың кездесуі
Dialogue: 0,0:10:26.45,0:10:30.12,Default,,0,0,0,,Осы жолы анама бәрін айтып беруді ойлап жүрмін.
Dialogue: 0,0:10:30.21,0:10:31.04,Default,,0,0,0,,Қалай болғанда да —
Dialogue: 0,0:10:31.13,0:10:34.55,Default,,0,0,0,,Мен Кішкентай ханымның іс-әрекеті туралы есеп бергім келеді.
Dialogue: 0,0:10:34.63,0:10:37.80,Default,,0,0,0,,Король де, Королева да уайымдағанына сенімдімін.
Dialogue: 0,0:10:37.88,0:10:39.63,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:10:39.72,0:10:41.51,Default,,0,0,0,,Мен сенің бақытты болатыныңа сенімдімін.
Dialogue: 0,0:10:41.59,0:10:44.51,Default,,0,0,0,,Чибиуса-чан, сен шынымен үйге барасың ба?
Dialogue: 0,0:10:44.60,0:10:45.77,Default,,0,0,0,,Жалықтырғыш
Dialogue: 0,0:10:46.85,0:10:49.81,Default,,0,0,0,,Мен жақында қайтамын. Мені күт.
Dialogue: 0,0:10:57.53,0:11:01.41,Default,,0,0,0,,Мамору-сан мен Чибиуса кенет жоғалып кетті.
Dialogue: 0,0:11:01.49,0:11:03.99,Default,,0,0,0,,Мен өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:11:04.08,0:11:05.58,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:11:05.66,0:11:09.04,Default,,0,0,0,,Мен Чибиусаның жақында оралатынына сенімдімін.
Dialogue: 0,0:11:09.12,0:11:12.71,Default,,0,0,0,,Мамо-чан да маған хаттар мен электрондық хаттар жібереді.
Dialogue: 0,0:11:12.79,0:11:16.09,Default,,0,0,0,,Ол анда-санда қайтатынын айтты.
Dialogue: 0,0:11:16.17,0:11:17.76,Default,,0,0,0,,Қоян?
Dialogue: 0,0:11:18.42,0:11:25.22,Default,,0,0,0,,Косэй тағы да күйреуге ұшырайды.
Dialogue: 0,0:11:31.06,0:11:37.15,Default,,0,0,0,,Ватару!
Dialogue: 0,0:11:37.23,0:11:38.40,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:11:38.48,0:11:39.82,Default,,0,0,0,,- (Көрермендер) Мичиру! -(Көрермендер) Харука!
Dialogue: 0,0:11:39.90,0:11:42.66,Default,,0,0,0,,Харука-сан, жоқ, бұл тамаша.
Dialogue: 0,0:11:44.32,0:11:46.91,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:46.99,0:11:48.16,Default,,0,0,0,,Үш шам!?
Dialogue: 0,0:11:48.24,0:11:49.12,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:11:49.20,0:11:52.16,Default,,0,0,0,,Мен екі адаммен бірлескен жұмысты естімеппін.
Dialogue: 0,0:11:52.25,0:11:56.29,Default,,0,0,0,,Бұл Үш шам. Мен техноны ұнатамын.
Dialogue: 0,0:11:56.38,0:11:57.21,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:57.29,0:12:00.80,Default,,0,0,0,,Әй, соншалықты алыс, мен сенің жүзіңді анық көре алмаймын.
Dialogue: 0,0:12:01.88,0:12:03.13,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:12:03.22,0:12:05.80,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:12:05.89,0:12:07.05,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:07.14,0:12:11.06,Default,,0,0,0,,Мичиру Кайоу керемет болды
Dialogue: 0,0:12:11.14,0:12:12.60,Default,,0,0,0,,Ауа жарығы
Dialogue: 0,0:12:12.69,0:12:16.23,Default,,0,0,0,,Бұл Йотенко. Менде сіздің барлық компакт-дискілеріңіз бар.
Dialogue: 0,0:12:17.48,0:12:18.52,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:19.98,0:12:20.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:21.03,0:12:25.20,Default,,0,0,0,,Бұл Хикару Хошино. Маған сенің жүгіруің ұнайды.
Dialogue: 0,0:12:25.28,0:12:29.08,Default,,0,0,0,,Жел сияқты оның менімен бірдей қасиеті бар.
Dialogue: 0,0:12:29.16,0:12:31.08,Default,,0,0,0,,Қол алысыңыз
Dialogue: 0,0:12:35.50,0:12:38.00,Default,,0,0,0,,Құрметті үш шам, өтінемін
Dialogue: 0,0:12:38.09,0:12:39.71,Default,,0,0,0,,Харука?
Dialogue: 0,0:12:39.80,0:12:45.01,Default,,0,0,0,,Жұлдыз жарығы. Олар кім?
Dialogue: 0,0:12:45.72,0:12:49.81,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:49.89,0:12:51.72,Default,,0,0,0,,- Чуу Чуу - Фуфуфуфу…
Dialogue: 0,0:12:51.81,0:12:53.35,Default,,0,0,0,,Хокс та керемет болды.
Dialogue: 0,0:12:53.43,0:12:58.48,Default,,0,0,0,,Ең жоғарғы жұлдызды матрос кристалына ие болғандар
Dialogue: 0,0:12:58.56,0:12:59.73,Default,,0,0,0,,Бұл тым қауіпті. Соған қарамастан, шкафта жасырынғаным дұрыс
Dialogue: 0,0:12:59.82,0:13:00.90,Default,,0,0,0,,Мен оны сезінемін!
Dialogue: 0,0:13:00.98,0:13:04.86,Default,,0,0,0,,Сенгісіз! Мұнда олардың 10-ы бар.
Dialogue: 0,0:13:05.95,0:13:08.91,Default,,0,0,0,,Галаксия ханым риза болады.
Dialogue: 0,0:13:09.87,0:13:11.66,Default,,0,0,0,,Сол теңізші Кристал
Dialogue: 0,0:13:11.74,0:13:14.91,Default,,0,0,0,,Мен мына теңізші темір тышқанды алдым!
Dialogue: 0,0:13:19.42,0:13:21.30,Default,,0,0,0,,Эвакуация жолын көру үшін осы жерді басыңыз
Dialogue: 0,0:13:21.38,0:13:22.63,Default,,0,0,0,,Нұсқауларды орындаңыз
Dialogue: 0,0:13:22.71,0:13:23.71,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:13:23.80,0:13:25.26,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:13:25.34,0:13:26.43,Default,,0,0,0,,Не?
Dialogue: 0,0:13:26.51,0:13:27.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:27.84,0:13:32.47,Default,,0,0,0,,Хехехе... Ақыры тауып алдың, сондықтан қашып кетуіне жол бересің!
Dialogue: 0,0:13:32.56,0:13:33.72,Default,,0,0,0,,Шайнау
Dialogue: 0,0:13:33.81,0:13:34.98,Default,,0,0,0,,Жау?
Dialogue: 0,0:13:36.48,0:13:38.94,Default,,0,0,0,,Венераның кристалдық күші!
Dialogue: 0,0:13:39.02,0:13:41.69,Default,,0,0,0,,Меркурийдің кристалдық қуаты!
Dialogue: 0,0:13:41.77,0:13:44.49,Default,,0,0,0,,Юпитердің кристалдық күші!
Dialogue: 0,0:13:44.57,0:13:47.15,Default,,0,0,0,,Марстың кристалдық күші!
Dialogue: 0,0:13:47.24,0:13:48.66,Default,,0,0,0,,Макияж!
Dialogue: 0,0:14:10.05,0:14:13.35,Default,,0,0,0,,Күміс айдың кристалдық күші!
Dialogue: 0,0:14:13.43,0:14:15.52,Default,,0,0,0,,Макияж!
Dialogue: 0,0:14:41.75,0:14:44.92,Default,,0,0,0,,Мәңгілік теңізші Меркурий!
Dialogue: 0,0:14:45.00,0:14:47.42,Default,,0,0,0,,Мәңгілік теңізші Марс!
Dialogue: 0,0:14:48.09,0:14:50.63,Default,,0,0,0,,Мәңгілік теңізші Юпитер!
Dialogue: 0,0:14:50.72,0:14:53.18,Default,,0,0,0,,Мәңгілік теңізші Венера!
Dialogue: 0,0:14:53.26,0:14:57.68,Default,,0,0,0,,Және Мәңгілік Сейлор Мун!
Dialogue: 0,0:14:57.77,0:14:59.44,Default,,0,0,0,,Міне, келдік!
Dialogue: 0,0:14:59.52,0:15:02.77,Default,,0,0,0,,Мен сендерді күттім, матрос солдаттар.
Dialogue: 0,0:15:02.86,0:15:06.98,Default,,0,0,0,,Galactica Crunch!
Dialogue: 0,0:15:13.03,0:15:16.49,Default,,0,0,0,,Ғарыштық турбуленттілік!
Dialogue: 0,0:15:20.79,0:15:24.38,Default,,0,0,0,,Суасты қайықтары Violon Tide!
Dialogue: 0,0:15:29.17,0:15:30.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:30.76,0:15:31.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:35.97,0:15:39.98,Default,,0,0,0,,Жұлдызды сезімтал тозақ!
Dialogue: 0,0:15:42.35,0:15:43.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:43.31,0:15:47.23,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:15:47.32,0:15:48.73,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:51.49,0:15:52.86,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:16:01.41,0:16:03.12,Default,,0,0,0,,Бұл үшеуі кім?
Dialogue: 0,0:16:08.00,0:16:10.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:10.26,0:16:13.72,Default,,0,0,0,,(оятар дыбысы)
Dialogue: 0,0:16:13.80,0:16:15.22,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:16:16.72,0:16:20.72,Default,,0,0,0,,Қызық, қазір Мамо-чанның үйінде түскі ас уақыты болды ма?
Dialogue: 0,0:16:21.35,0:16:22.56,Default,,0,0,0,,Кеттік
Dialogue: 0,0:16:22.64,0:16:23.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:26.23,0:16:27.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:29.78,0:16:31.78,Default,,0,0,0,,Оның келуі мүмкін емес.
Dialogue: 0,0:16:31.86,0:16:35.53,Default,,0,0,0,,Мен хат жазамын және электрондық поштаны жіберемін.
Dialogue: 0,0:16:39.16,0:16:41.41,Default,,0,0,0,,Мамо-чан, қалайсың?
Dialogue: 0,0:16:41.50,0:16:44.54,Default,,0,0,0,,Неліктен маған хат немесе электрондық хат жібермедің?
Dialogue: 0,0:16:44.62,0:16:46.88,Default,,0,0,0,,Қоян ашуланады
Dialogue: 0,0:17:10.73,0:17:11.65,Default,,0,0,0,,Уау
Dialogue: 0,0:17:14.15,0:17:14.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:22.75,0:17:23.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:30.71,0:17:36.26,Default,,0,0,0,,Енді мен кір жуып болған соң, мен супермаркетке барамын деп ойлаймын.
Dialogue: 0,0:17:36.34,0:17:37.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.68,0:17:43.56,Default,,0,0,0,,Бұл кесе кімдікі болды?
Dialogue: 0,0:17:49.90,0:17:51.19,Default,,0,0,0,,Чиби…
Dialogue: 0,0:17:51.27,0:17:52.11,Default,,0,0,0,,Чиби?
Dialogue: 0,0:17:53.57,0:17:55.32,Default,,0,0,0,,Чиби Чиби
Dialogue: 0,0:18:00.32,0:18:02.95,Default,,0,0,0,,Тағы бір жаңа жау пайда болған сияқты.
Dialogue: 0,0:18:03.66,0:18:04.91,Default,,0,0,0,,Біз туралы
Dialogue: 0,0:18:05.00,0:18:07.58,Default,,0,0,0,,Олар «матростар» деп аталды.
Dialogue: 0,0:18:07.66,0:18:11.29,Default,,0,0,0,,Және «матрос кристалына ие болғандар»
Dialogue: 0,0:18:11.38,0:18:13.96,Default,,0,0,0,,Ғалам кең
Dialogue: 0,0:18:14.05,0:18:15.59,Default,,0,0,0,,Басқа планетадан?
Dialogue: 0,0:18:15.67,0:18:17.76,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:18:17.84,0:18:19.51,Default,,0,0,0,,Қосымша
Dialogue: 0,0:18:19.59,0:18:21.26,Default,,0,0,0,,Үш шам
Dialogue: 0,0:18:22.81,0:18:25.93,Default,,0,0,0,,Айдол болудағы мақсат не екенін білмеймін.
Dialogue: 0,0:18:26.02,0:18:29.73,Default,,0,0,0,,Бұл үш адам күн жүйесінен емес.
Dialogue: 0,0:18:29.81,0:18:32.02,Default,,0,0,0,,Мен жұлдыздардың күшін сезіндім
Dialogue: 0,0:18:36.74,0:18:38.40,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:18:39.95,0:18:41.87,Default,,0,0,0,,Иә? кімдікі аяқ киім?
Dialogue: 0,0:18:41.95,0:18:43.70,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:18:43.78,0:18:44.70,Default,,0,0,0,,...жоқ
Dialogue: 0,0:18:47.83,0:18:49.71,Default,,0,0,0,,Бұл кім? бұл бала
Dialogue: 0,0:18:49.79,0:18:51.17,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:18:51.25,0:18:54.25,Default,,0,0,0,,Менің кішкентай әпкем Чиби-Чиби-чанды ұмыттың ба?
Dialogue: 0,0:18:54.34,0:18:55.34,Default,,0,0,0,,...Не болды?
Dialogue: 0,0:18:56.96,0:18:58.47,Default,,0,0,0,,Ээээх!
Dialogue: 0,0:19:02.39,0:19:04.26,Default,,0,0,0,,Ол Усагидің әпкесі ме?
Dialogue: 0,0:19:04.35,0:19:05.26,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:05.35,0:19:07.06,Default,,0,0,0,,Чибиусаның әпкесі?
Dialogue: 0,0:19:07.14,0:19:08.10,Default,,0,0,0,,...мүмкін
Dialogue: 0,0:19:08.18,0:19:11.19,Default,,0,0,0,,...Бұл Усагидің екінші баласы ма?
Dialogue: 0,0:19:11.27,0:19:13.36,Default,,0,0,0,,Ал, мен білмеймін!
Dialogue: 0,0:19:13.44,0:19:14.86,Default,,0,0,0,,Хё~
Dialogue: 0,0:19:14.94,0:19:18.03,Default,,0,0,0,,Сонымен, сіздің атыңыз «Чиби Чиби»?
Dialogue: 0,0:19:18.11,0:19:19.28,Default,,0,0,0,,...
Dialogue: 0,0:19:19.36,0:19:20.53,Default,,0,0,0,,Манекко!
Dialogue: 0,0:19:20.61,0:19:21.70,Default,,0,0,0,,Манекко!
Dialogue: 0,0:19:21.78,0:19:23.70,Default,,0,0,0,,Не, сен баласың ба?
Dialogue: 0,0:19:23.78,0:19:25.70,Default,,0,0,0,,Не, сен баласың ба?
Dialogue: 0,0:19:25.78,0:19:27.04,Default,,0,0,0,,Мукер!
Dialogue: 0,0:19:27.12,0:19:31.12,Default,,0,0,0,,Әйтеуір, не естісем де солай.
Dialogue: 0,0:19:31.21,0:19:33.08,Default,,0,0,0,,... дұрыс па?
Dialogue: 0,0:19:35.17,0:19:36.71,Default,,0,0,0,,(Изуку) Эндеворға келгенде сен сәл қаталсың ғой, Тодороки?
Dialogue: 0,0:19:36.80,0:19:40.67,Default,,0,0,0,,Чибиусаның сіңлісі Мамо-чан екеуміздің екіншісіміз дегенді білдіреді...
Dialogue: 0,0:19:40.76,0:19:41.72,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:41.80,0:19:43.05,Default,,0,0,0,,-Усаги-чан -Иә?
Dialogue: 0,0:19:46.01,0:19:46.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:47.72,0:19:49.31,Default,,0,0,0,,Сіз бірге ұйықтайсыз ба?
Dialogue: 0,0:19:49.39,0:19:52.94,Default,,0,0,0,,Иә? Не? Сен не істеп жатырсың?
Dialogue: 0,0:19:56.36,0:20:00.94,Default,,0,0,0,,Жақсы иіс, хош иісті зат? Сіз оны анамның бөлмесінен әкелдіңіз бе?
Dialogue: 0,0:20:03.78,0:20:05.70,Default,,0,0,0,,А, бұл
Dialogue: 0,0:20:05.78,0:20:09.62,Default,,0,0,0,,Мен бұл иісті бұрын бір жерден естігенмін...
Dialogue: 0,0:20:11.20,0:20:14.08,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:20:14.17,0:20:15.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:17.54,0:20:19.17,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:20:19.25,0:20:21.13,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:23.93,0:20:24.80,Default,,0,0,0,,Әуе поштасы!
Dialogue: 0,0:20:24.89,0:20:27.51,Default,,0,0,0,,Америкадан! Мамо-чан?
Dialogue: 0,0:20:27.60,0:20:28.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:29.77,0:20:31.68,Default,,0,0,0,,Күннің батуы картасы?
Dialogue: 0,0:20:33.73,0:20:37.77,Default,,0,0,0,,Карточкада ештеңе жазылмаған! Хат, мекен-жай жоқ
Dialogue: 0,0:20:37.86,0:20:39.48,Default,,0,0,0,,О!
Dialogue: 0,0:20:39.57,0:20:41.49,Default,,0,0,0,,Қазірдің өзінде! Мамочантара
Dialogue: 0,0:20:42.32,0:20:43.49,Default,,0,0,0,,Бірақ мен бақыттымын
Dialogue: 0,0:20:43.57,0:20:47.49,Default,,0,0,0,,Менде бір жақсылық болатындай сезім бар, хехе
Dialogue: 0,0:20:48.24,0:20:49.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:49.66,0:20:51.83,Default,,0,0,0,,Не? Сол тобыр
Dialogue: 0,0:20:51.91,0:20:54.83,Default,,0,0,0,,Қоян! Үлкен жаңалық! Үлкен жаңалық!
Dialogue: 0,0:20:55.54,0:21:01.55,Default,,0,0,0,,Сол үш шам біздің мектепке көшті.
Dialogue: 0,0:21:03.26,0:21:05.34,Default,,0,0,0,,Ауа жарығы
Dialogue: 0,0:21:05.43,0:21:07.93,Default,,0,0,0,,Менің хоббиім өлең жаттау және компьютер.
Dialogue: 0,0:21:08.01,0:21:12.18,Default,,0,0,0,,Түнгі аспан жарығы Менің хоббиім - фотосурет. Танысқаныма қуаныштымын!
Dialogue: 0,0:21:12.27,0:21:16.44,Default,,0,0,0,,Хикару Хошино Мен американдық футбол клубына қосылуды ойлап жүрмін.
Dialogue: 0,0:21:16.52,0:21:19.73,Default,,0,0,0,,Мен бұл үшеуіне сенбеймін...
Dialogue: 0,0:21:19.82,0:21:22.44,Default,,0,0,0,,Бір сынып!? Бақытты!
Dialogue: 0,0:21:22.53,0:21:23.44,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:25.95,0:21:27.74,Default,,0,0,0,,Ах... Танысқаныма қуаныштымын.
Dialogue: 0,0:21:27.82,0:21:32.62,Default,,0,0,0,,... Танысқаныма қуаныштымын, мен Усаги Цукиномын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:21:32.70,0:21:35.75,Default,,0,0,0,,Менің атым Минако Айно. Сізбен танысқаныма қуаныштымын!
Dialogue: 0,0:21:38.71,0:21:41.42,Default,,0,0,0,,Сіз қандай әтір қолданасыз?
Dialogue: 0,0:21:41.50,0:21:42.42,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:21:42.50,0:21:43.76,Default,,0,0,0,,Мен де
Dialogue: 0,0:21:43.84,0:21:46.22,Default,,0,0,0,,Бірақ мен енді білдім
Dialogue: 0,0:21:46.30,0:21:47.68,Default,,0,0,0,,Жақынбаңыз
Dialogue: 0,0:21:47.76,0:21:50.18,Default,,0,0,0,,Tsk! Мен кешігіп қалдым.
Dialogue: 0,0:21:50.26,0:21:54.68,Default,,0,0,0,,Неліктен мұндай қарапайым орта мектепке бару керек? Жеке мектепке барыңыз.
Dialogue: 0,0:21:55.48,0:21:58.94,Default,,0,0,0,,Бізбен байланысуға тырысып жатқаныңызға сенімдісіз бе?
Dialogue: 0,0:21:59.02,0:22:01.19,Default,,0,0,0,,О? Ал қояндар ше?
Dialogue: 0,0:22:01.27,0:22:05.24,Default,,0,0,0,,Төбеде мен махаббат хатын жазып жатырмын
Dialogue: 0,0:22:05.32,0:22:08.91,Default,,0,0,0,,Ал... «Маған бұл өте ұнады».
Dialogue: 0,0:22:08.99,0:22:11.83,Default,,0,0,0,,«Оқушы дәптеріңізге салып, бойтұмар ретінде қолданыңыз».
Dialogue: 0,0:22:11.91,0:22:15.83,Default,,0,0,0,,«Келесі жолы сенің өміріңді тыңдауға рұқсат етемін».
Dialogue: 0,0:22:15.91,0:22:18.96,Default,,0,0,0,,Мен енді шыдай алмаймын. Тоқтайық.
Dialogue: 0,0:22:19.04,0:22:22.13,Default,,0,0,0,,Мектепте ойнаудан шаршадым.
Dialogue: 0,0:22:22.21,0:22:24.42,Default,,0,0,0,,Оқу қызық!
Dialogue: 0,0:22:24.50,0:22:27.22,Default,,0,0,0,,Бұл жай ғана атмосфера.
Dialogue: 0,0:22:27.30,0:22:28.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:28.26,0:22:29.68,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:22:29.76,0:22:32.26,Default,,0,0,0,,Иә! Үш шам
Dialogue: 0,0:22:32.35,0:22:33.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:33.26,0:22:34.77,Default,,0,0,0,,«Сүйікті Мамо-чанға»
Dialogue: 0,0:22:34.85,0:22:37.39,Default,,0,0,0,,«Тамаша күн бату картасы үшін рахмет».
Dialogue: 0,0:22:37.48,0:22:39.27,Default,,0,0,0,,-Ия! -(Ятен) Сұмдық кейіпкерлер
Dialogue: 0,0:22:39.35,0:22:40.19,Default,,0,0,0,,Даа!
Dialogue: 0,0:22:40.27,0:22:42.44,Default,,0,0,0,,Жаман қолжазба үшін кешірім сұраймыз.
Dialogue: 0,0:22:42.52,0:22:43.94,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:22:45.11,0:22:45.94,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:22:46.03,0:22:49.32,Default,,0,0,0,,Күткендей, мен өз сыныбымдағы ұлдардан мүлдем басқашамын.
Dialogue: 0,0:22:49.40,0:22:52.24,Default,,0,0,0,,Өте керемет!
Dialogue: 0,0:22:53.16,0:22:56.91,Default,,0,0,0,,Бұл жақсы сақина. Ол саған берді ме?
Dialogue: 0,0:22:57.00,0:22:59.87,Default,,0,0,0,,Не? Иә жақсы
Dialogue: 0,0:22:59.96,0:23:01.92,Default,,0,0,0,,Усаги Цукино деп айттыңыз ба?
Dialogue: 0,0:23:02.00,0:23:04.42,Default,,0,0,0,,Ол қазір қайда?
Dialogue: 0,0:23:04.50,0:23:08.67,Default,,0,0,0,,Мамо-чан қазір Америкада...
Dialogue: 0,0:23:09.51,0:23:10.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:11.38,0:23:14.47,Default,,0,0,0,,Ауырды, басым жарылғандай...
Dialogue: 0,0:23:15.35,0:23:16.97,Default,,0,0,0,,Қоянға жақындамаңыз!
Dialogue: 0,0:23:19.43,0:23:20.56,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:23:20.64,0:23:22.56,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:23:22.65,0:23:23.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:24.44,0:23:29.86,Default,,0,0,0,,Жарайды, менің басым аздап ауырып тұр, жаңа ғана сөйлесіп тұрдық.
Dialogue: 0,0:23:29.95,0:23:31.11,Default,,0,0,0,,Бұл солтүстік-батырдағы қала ма?
Dialogue: 0,0:23:32.74,0:23:36.24,Default,,0,0,0,,Мына үш адам менен бірдеңе сұрап тұр ма?
Dialogue: 0,0:23:36.33,0:23:37.87,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:23:37.95,0:23:41.54,Default,,0,0,0,,Мамо-чан туралы ойлағанымда, кенет...
Dialogue: 0,0:23:41.62,0:23:44.75,Default,,0,0,0,,О, шындап айтсам, мен көптен бері №1 болдым.
Dialogue: 0,0:23:47.46,0:23:48.42,Default,,0,0,0,,О!
Dialogue: 0,0:23:48.51,0:23:50.76,Default,,0,0,0,,Бұл пұт Мизуно-санды басып озып, бірінші орында тұр.
Dialogue: 0,0:23:50.84,0:23:53.05,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:23:53.14,0:23:54.51,Default,,0,0,0,,Хмм!
Dialogue: 0,0:23:57.51,0:23:58.35,Default,,0,0,0,,Даа!
Dialogue: 0,0:23:58.43,0:24:00.02,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:24:00.10,0:24:02.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:24:03.98,0:24:07.15,Default,,0,0,0,,Менің ойымша, олар бізге қарсы шығуға тырысады.
Dialogue: 0,0:24:07.23,0:24:08.57,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:24:13.36,0:24:14.91,Default,,0,0,0,,Жағымсыз түстер
Dialogue: 0,0:24:16.37,0:24:18.54,Default,,0,0,0,,Өзіңізге қолайлы түсті тапсаңыз ше?
Dialogue: 0,0:24:18.62,0:24:21.45,Default,,0,0,0,,Ятен-кун, сен де модель болып жұмыс істейсің бе?
Dialogue: 0,0:24:21.54,0:24:23.37,Default,,0,0,0,,Келесі жолы маған макияжыңды үйрет.
Dialogue: 0,0:24:23.46,0:24:24.42,Default,,0,0,0,,- (Ятен) Жарайды - (Оқушы) Яй!
Dialogue: 0,0:24:25.50,0:24:28.46,Default,,0,0,0,,Харука Жұмбақ жігіттер
Dialogue: 0,0:24:28.55,0:24:31.13,Default,,0,0,0,,Оны сүртіп алайық.
Dialogue: 0,0:24:31.21,0:24:32.55,Default,,0,0,0,,Бұл көз ауыртады.
Dialogue: 0,0:24:32.63,0:24:35.09,Default,,0,0,0,,Мичиру Мен қорқамын
Dialogue: 0,0:24:35.18,0:24:36.64,Default,,0,0,0,,О? Шындық деген не?
Dialogue: 0,0:24:36.72,0:24:40.18,Default,,0,0,0,,Тайки-кун, сен бау-бақша үйірмесіне қосылдың.
Dialogue: 0,0:24:40.27,0:24:44.06,Default,,0,0,0,,Өсімдіктерді жақсы көретін жаман адамдар жоқ.
Dialogue: 0,0:24:44.14,0:24:45.02,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:24:45.10,0:24:49.11,Default,,0,0,0,,Сол салқын адамдар жаман адамдарға ұқсамайды.
Dialogue: 0,0:24:49.19,0:24:52.44,Default,,0,0,0,,Мен түсіндім, бірақ сендер...
Dialogue: 0,0:24:52.53,0:24:56.41,Default,,0,0,0,,Әрине, барлау бейбітшілік үшін қажет!
Dialogue: 0,0:24:57.07,0:25:01.12,Default,,0,0,0,,Өйткені, бейбітшілікті ойласаң, концерттен қалыс қалмайды.
Dialogue: 0,0:25:01.20,0:25:02.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:02.12,0:25:07.79,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:25:08.50,0:25:13.55,Default,,0,0,0,,Келесіде Three Lights тобының дебюттік сингл «Nagareboshi e»
Dialogue: 0,0:25:13.63,0:25:14.97,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:25:16.13,0:25:20.18,Default,,0,0,0,,Сен әрқашан жарқырап жүрдің
Dialogue: 0,0:25:20.26,0:25:25.69,Default,,0,0,0,,Бір күлкі, кішкентай жұлдыз
Dialogue: 0,0:25:25.77,0:25:31.90,Default,,0,0,0,,Мен мәңгілік жұлдызды жақсы көрдім (жұлдыз жарығы)
Dialogue: 0,0:25:31.98,0:25:35.90,Default,,0,0,0,,Мен сенің иісіңді мәңгі іздедім
Dialogue: 0,0:25:35.99,0:25:39.66,Default,,0,0,0,,Менің дауысым, мен сені сүйемін
Dialogue: 0,0:25:39.74,0:25:43.66,Default,,0,0,0,,Ай сәулесі ханшайымы қазір қайдасың?
Dialogue: 0,0:25:43.75,0:25:47.75,Default,,0,0,0,,Менің ханшайымым
Dialogue: 0,0:25:47.83,0:25:49.25,Default,,0,0,0,,- (Хошино және т.б.) Жауап... - (Минако) Усаги?
Dialogue: 0,0:25:50.13,0:25:54.01,Default,,0,0,0,,Мен ол адаммен жай ғана көз түйістіргендей болдым.
Dialogue: 0,0:25:54.88,0:25:57.01,Default,,0,0,0,,Қандай мұңды ән
Dialogue: 0,0:25:57.09,0:25:59.59,Default,,0,0,0,,Маған жауап беріңіз
Dialogue: 0,0:25:59.68,0:26:04.22,Default,,0,0,0,,Мен үшін ақырын жауап беріңіз
Dialogue: 0,0:26:08.23,0:26:11.27,Default,,0,0,0,,Әуе поштасы! Мамо-чан?
Dialogue: 0,0:26:14.90,0:26:17.57,Default,,0,0,0,,Енді бұл жұлдызды карта.
Dialogue: 0,0:26:20.37,0:26:23.29,Default,,0,0,0,,Бозғылт қызғылт сары жұлдыз
Dialogue: 0,0:26:23.37,0:26:25.83,Default,,0,0,0,,Жұлдыз қалай аталады?
Dialogue: 0,0:26:25.91,0:26:27.08,Default,,0,0,0,,Бұл жасанды серік.
Dialogue: 0,0:26:27.16,0:26:28.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:30.71,0:26:31.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:33.84,0:26:37.47,Default,,0,0,0,,Ху~ Солай жарқырап тұрған сияқты.
Dialogue: 0,0:26:38.13,0:26:39.55,Default,,0,0,0,,Сізге жұлдыздар ұнайды ма?
Dialogue: 0,0:26:39.63,0:26:40.84,Default,,0,0,0,,Иә
Dialogue: 0,0:26:41.55,0:26:42.47,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:26:42.55,0:26:43.72,Default,,0,0,0,,А...
Dialogue: 0,0:26:43.81,0:26:47.02,Default,,0,0,0,,Бұл қиын. Олар тіпті мектепте шу шығарды.
Dialogue: 0,0:26:47.10,0:26:49.02,Default,,0,0,0,,Сырттан жасырынуға болмайды!
Dialogue: 0,0:26:49.10,0:26:50.73,Default,,0,0,0,,МинаП Кешіріңіз
Dialogue: 0,0:26:51.56,0:26:53.65,Default,,0,0,0,,Пұттар шынымен бос емес.
Dialogue: 0,0:26:53.73,0:26:56.23,Default,,0,0,0,,Мектеп Мектепке келуге уақытыңыз жоқ па?
Dialogue: 0,0:26:56.32,0:26:59.20,Default,,0,0,0,,Бізге тек ән айта білу керек
Dialogue: 0,0:27:00.49,0:27:06.95,Default,,0,0,0,,Мен сені бұрын бір жерде кездестірген сияқтымын...
Dialogue: 0,0:27:08.75,0:27:12.42,Default,,0,0,0,,Ба... ақымақ! Бұлай болуы мүмкін емес пе?
Dialogue: 0,0:27:12.50,0:27:14.42,Default,,0,0,0,,Сондай атақты адаммен
Dialogue: 0,0:27:14.50,0:27:16.42,Default,,0,0,0,,А... бұл менмін.
Dialogue: 0,0:27:16.50,0:27:19.26,Default,,0,0,0,,Three Lights тобының дебюттік жалғыз әні
Dialogue: 0,0:27:19.34,0:27:21.22,Default,,0,0,0,,Маған қатты ұнайды
Dialogue: 0,0:27:21.30,0:27:27.56,Default,,0,0,0,,Жүрегімнің түбінде сақталған өте мұңды, әдемі ән.
Dialogue: 0,0:27:27.64,0:27:29.39,Default,,0,0,0,,Бұлай айтқаныңызға сене алар емеспін.
Dialogue: 0,0:27:29.48,0:27:31.10,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:27:31.77,0:27:36.44,Default,,0,0,0,,Осы әнді айтқымыз келгендіктен әнші болдық.
Dialogue: 0,0:27:43.03,0:27:48.95,Default,,0,0,0,,Сіздің хош иісіңіз мәңгі
Dialogue: 0,0:27:49.04,0:27:54.46,Default,,0,0,0,,Менің дауысым, маған жет
Dialogue: 0,0:27:55.75,0:27:59.96,Default,,0,0,0,,Хошино-кун, сен кімге арнап ән айтасың?
Dialogue: 0,0:28:00.97,0:28:07.76,Default,,0,0,0,,Менің ханшайымым
Dialogue: 0,0:28:07.85,0:28:09.02,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:28:09.10,0:28:10.89,Default,,0,0,0,,-(Атмосфера) Ааа... -(Ами) Қандай дауыс
Dialogue: 0,0:28:10.98,0:28:12.14,Default,,0,0,0,,Дауыс өзгертуші екен ғой
Dialogue: 0,0:28:12.98,0:28:17.40,Default,,0,0,0,,Мен сол үш адамның бойынан жұлдыздардың құдіретін сезіндім.
Dialogue: 0,0:28:18.19,0:28:20.49,Default,,0,0,0,,қазір сеземін
Dialogue: 0,0:28:21.32,0:28:23.70,Default,,0,0,0,,Бұл адамды қоршап тұрған жұлдыздардың аурасы
Dialogue: 0,0:28:24.57,0:28:27.20,Default,,0,0,0,,Ал сіз ше...
Dialogue: 0,0:28:27.28,0:28:28.66,Default,,0,0,0,,Ақымақ Хошино!
Dialogue: 0,0:28:28.74,0:28:30.62,Default,,0,0,0,,Сен өз күшіңді қорғансыз пайдаландың.
Dialogue: 0,0:28:31.50,0:28:33.12,Default,,0,0,0,,Олар мұны сезді.
Dialogue: 0,0:28:33.21,0:28:34.08,Default,,0,0,0,,-(Хошино) Ух... -Ах!
Dialogue: 0,0:28:34.87,0:28:36.71,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:28:36.79,0:28:39.30,Default,,0,0,0,,Мен Сейлор Алюминий Сиренмін
Dialogue: 0,0:28:39.38,0:28:41.76,Default,,0,0,0,,Теңізші алюминий сиренасы!?
Dialogue: 0,0:28:42.92,0:28:45.76,Default,,0,0,0,,Галактика толқыны!
Dialogue: 0,0:28:48.93,0:28:52.27,Default,,0,0,0,,Меркурий Су Рапсодиясы!
Dialogue: 0,0:28:52.93,0:28:56.90,Default,,0,0,0,,Юпитер еменінің эволюциясы!
Dialogue: 0,0:28:58.69,0:29:00.19,Default,,0,0,0,,Хехе, мен істеймін.
Dialogue: 0,0:29:00.28,0:29:02.03,Default,,0,0,0,,Сен Темера шақырған жаусың ба?
Dialogue: 0,0:29:02.11,0:29:04.82,Default,,0,0,0,,Қояннан аулақ болыңыз! Мен олардың бәрін бірден аяқтаймын.
Dialogue: 0,0:29:04.90,0:29:07.45,Default,,0,0,0,,Жоқ! Бұл адамдар жау емес.
Dialogue: 0,0:29:07.53,0:29:10.08,Default,,0,0,0,,Хошино-кунды қоршаған аура бізбен бірдей.
Dialogue: 0,0:29:10.79,0:29:14.33,Default,,0,0,0,,Жұлдыздар қорғап, Жарқырап тұрмын мақтанышпен
Dialogue: 0,0:29:14.41,0:29:17.29,Default,,0,0,0,,Күміс айдың кристалдық күші!
Dialogue: 0,0:29:17.38,0:29:19.54,Default,,0,0,0,,Макияж!
Dialogue: 0,0:29:28.72,0:29:30.10,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:29:31.43,0:29:32.35,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:29:32.43,0:29:34.10,Default,,0,0,0,,Меркурий! Юпитер!
Dialogue: 0,0:29:36.94,0:29:41.44,Default,,0,0,0,,Ғарыштық турбуленттілік!
Dialogue: 0,0:29:43.82,0:29:44.94,Default,,0,0,0,,Ол кері қайтты!?
Dialogue: 0,0:29:45.03,0:29:45.86,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:29:45.95,0:29:49.45,Default,,0,0,0,,Мен де матрос кристалы бар матрос жауынгермін
Dialogue: 0,0:29:49.53,0:29:50.37,Default,,0,0,0,,Не!?
Dialogue: 0,0:29:50.45,0:29:53.79,Default,,0,0,0,,Мен Ironmouth сияқты қателеспеймін.
Dialogue: 0,0:29:53.87,0:29:57.37,Default,,0,0,0,,Мен Галаксия-сама үшін теңізші кристалын аламын.
Dialogue: 0,0:29:57.46,0:30:00.25,Default,,0,0,0,,Жұлдызды бал айы...
Dialogue: 0,0:30:01.13,0:30:03.13,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:30:04.88,0:30:05.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:05.88,0:30:07.55,Default,,0,0,0,,-Юпитер! -(Венера) Меркурий!
Dialogue: 0,0:30:11.72,0:30:14.14,Default,,0,0,0,,Мен теңізші кристалын алдым.
Dialogue: 0,0:30:14.85,0:30:16.89,Default,,0,0,0,,Жауынгер Жұлдыз Күші!
Dialogue: 0,0:30:16.98,0:30:19.02,Default,,0,0,0,,Жаратушы Жұлдыз Күші!
Dialogue: 0,0:30:19.10,0:30:21.40,Default,,0,0,0,,Емші жұлдыз күші!
Dialogue: 0,0:30:21.48,0:30:23.15,Default,,0,0,0,,Макияж!
Dialogue: 0,0:30:46.59,0:30:50.64,Default,,0,0,0,,Жұлдыздық күрделі ұстара!
Dialogue: 0,0:30:52.39,0:30:57.14,Default,,0,0,0,,Жұлдызды жұмсақ жатыр!
Dialogue: 0,0:30:57.23,0:30:58.89,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:31:00.27,0:31:01.44,Default,,0,0,0,,Балалар!
Dialogue: 0,0:31:01.52,0:31:02.52,Default,,0,0,0,,Бұл неге ұқсайды?
Dialogue: 0,0:31:02.61,0:31:04.90,Default,,0,0,0,,Жұлдыздар қай жерде ағып жатыр
Dialogue: 0,0:31:04.98,0:31:06.78,Default,,0,0,0,,Жеңілмейтін үш жарық бар
Dialogue: 0,0:31:07.69,0:31:09.61,Default,,0,0,0,,Теңізші жұлдызды жауынгер
Dialogue: 0,0:31:09.70,0:31:11.78,Default,,0,0,0,,Теңізші жұлдыз жасаушы
Dialogue: 0,0:31:11.87,0:31:13.53,Default,,0,0,0,,Теңізші жұлдызды емші
Dialogue: 0,0:31:13.62,0:31:16.91,Default,,0,0,0,,Sailor Starlights осында!
Dialogue: 0,0:31:17.00,0:31:17.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:19.41,0:31:22.04,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:31:24.88,0:31:27.17,Default,,0,0,0,,Меркурий! Юпитер!
Dialogue: 0,0:31:27.26,0:31:29.05,Default,,0,0,0,,Sailor Starlights?
Dialogue: 0,0:31:29.13,0:31:31.13,Default,,0,0,0,,Теңізші Сенши? Сондай ақымақ!
Dialogue: 0,0:31:31.22,0:31:33.64,Default,,0,0,0,,Түсіндім, сендер жасырдыңдар.
Dialogue: 0,0:31:33.72,0:31:36.10,Default,,0,0,0,,Бізге екеуін қайтарыңыз! Екеуің қайдасыңдар?
Dialogue: 0,0:31:36.18,0:31:38.60,Default,,0,0,0,,Меркурий Юпитер
Dialogue: 0,0:31:38.68,0:31:40.35,Default,,0,0,0,,Мықты бол!
Dialogue: 0,0:31:40.44,0:31:41.52,Default,,0,0,0,,Венера! (соққы дыбысы)
Dialogue: 0,0:31:41.60,0:31:42.85,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:31:42.94,0:31:43.90,Default,,0,0,0,,Меркурий және
Dialogue: 0,0:31:43.98,0:31:46.07,Default,,0,0,0,,Юпитердің денесі жойылды
Dialogue: 0,0:31:46.15,0:31:50.36,Default,,0,0,0,,Олардың күшінің қайнар көзі, теңізші хрусталы ұрланған.
Dialogue: 0,0:31:50.45,0:31:53.36,Default,,0,0,0,,Мәйіт жойылды!?
Dialogue: 0,0:31:53.45,0:31:55.24,Default,,0,0,0,,Теңізші Кристал
Dialogue: 0,0:31:55.33,0:31:57.49,Default,,0,0,0,,Оны матрос жауынгердің жүрегі деуге болады.
Dialogue: 0,0:31:57.58,0:31:59.12,Default,,0,0,0,,Теңізші Кристал...
Dialogue: 0,0:31:59.20,0:32:00.12,Default,,0,0,0,,Тоналды ма?
Dialogue: 0,0:32:00.20,0:32:02.58,Default,,0,0,0,,Сейлор Мун Біз...
Dialogue: 0,0:32:02.67,0:32:04.71,Default,,0,0,0,,Жақын келме!
Dialogue: 0,0:32:04.79,0:32:08.21,Default,,0,0,0,,Маған жақындағың келсе, алдымен менің тосқауылымды кесіп өт!
Dialogue: 0,0:32:08.30,0:32:10.42,Default,,0,0,0,,Сіз кімсіз және сіздің мақсатыңыз қандай?
Dialogue: 0,0:32:10.51,0:32:13.68,Default,,0,0,0,,Мен сіздің сезіміңізді толық түсінемін.
Dialogue: 0,0:32:13.76,0:32:18.06,Default,,0,0,0,,Бірақ менің салқынқандылығым жоғалып, жүрегім қазіргідей тәртіпсіз болса,
Dialogue: 0,0:32:18.14,0:32:21.14,Default,,0,0,0,,Көлеңке Галактика, оны Сейлор Галаксия басқарады,
Dialogue: 0,0:32:21.23,0:32:22.06,Default,,0,0,0,,Жеңіске жету мүмкін емес
Dialogue: 0,0:32:22.14,0:32:24.27,Default,,0,0,0,,Теңізші Галаксия?
Dialogue: 0,0:32:24.35,0:32:25.81,Default,,0,0,0,,Көлеңке Галактика?
Dialogue: 0,0:32:25.90,0:32:28.44,Default,,0,0,0,,Олар аяусыз шабуыл жасайды
Dialogue: 0,0:32:28.52,0:32:31.32,Default,,0,0,0,,Біз үшін алаңдауға уақыт жоқ.
Dialogue: 0,0:32:32.24,0:32:34.57,Default,,0,0,0,,Шынайы күресіңіз! Әйтпесе...
Dialogue: 0,0:32:36.70,0:32:37.83,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:32:37.91,0:32:40.95,Default,,0,0,0,,Меркурий мен Юпитер шынымен...
Dialogue: 0,0:32:44.58,0:32:46.92,Default,,0,0,0,,Теңізші жұлдыз шамдары
Dialogue: 0,0:32:47.00,0:32:50.17,Default,,0,0,0,,Үш шамның үшеуі - теңізші Сенши
Dialogue: 0,0:32:50.25,0:32:54.13,Default,,0,0,0,,Концерт өтетін орын және бүгін бізге шабуыл жасаған жігіттер.
Dialogue: 0,0:32:54.22,0:32:56.47,Default,,0,0,0,,Өзін теңізші жауынгер деп атады
Dialogue: 0,0:32:56.55,0:32:59.18,Default,,0,0,0,,Матрос Сенши матрос Кристалмен
Dialogue: 0,0:32:59.26,0:33:03.56,Default,,0,0,0,,Және олар біздің Теңізші Кристалдың артынан келді.
Dialogue: 0,0:33:03.64,0:33:06.98,Default,,0,0,0,,Теңізші Галаксия басқаратын көлеңкелі Галактика
Dialogue: 0,0:33:07.06,0:33:08.69,Default,,0,0,0,,Бұл жаңа жау
Dialogue: 0,0:33:08.77,0:33:12.15,Default,,0,0,0,,Сонда келесі жау матрос Сенши болады ма?
Dialogue: 0,0:33:12.24,0:33:16.66,Default,,0,0,0,,Теңізші жұлдыз шамдары Бұл үш жау ма?
Dialogue: 0,0:33:17.45,0:33:21.04,Default,,0,0,0,,Жоқ. Алюминий сиренасы маған шабуыл жасаған кезде—
Dialogue: 0,0:33:21.12,0:33:23.37,Default,,0,0,0,,Үшеуің мені күзеттіңдер.
Dialogue: 0,0:33:24.12,0:33:26.54,Default,,0,0,0,,Мені бәрі қорғап тұрғандай
Dialogue: 0,0:33:26.62,0:33:28.21,Default,,0,0,0,,Көлеңке Галактика
Dialogue: 0,0:33:28.29,0:33:30.21,Default,,0,0,0,,Меркурий мен Юпитер сол жерде.
Dialogue: 0,0:33:30.29,0:33:31.80,Default,,0,0,0,,Мен оның сонда тірі екеніне сенімдімін.
Dialogue: 0,0:33:32.46,0:33:34.72,Default,,0,0,0,,Меркурий Юпитер
Dialogue: 0,0:33:34.80,0:33:38.05,Default,,0,0,0,,Шынында да, ол менің көз алдымда жарылып кетті...
Dialogue: 0,0:33:38.14,0:33:40.64,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:33:40.72,0:33:42.81,Default,,0,0,0,,Олар бұл планетаны қашан басып алды?
Dialogue: 0,0:33:42.89,0:33:46.10,Default,,0,0,0,,Өлі айдан кейін сырттан келген зиянкестер...
Dialogue: 0,0:33:46.19,0:33:48.81,Default,,0,0,0,,Өткен айда үлкен метеорлық жауын болды.
Dialogue: 0,0:33:48.90,0:33:51.11,Default,,0,0,0,,Стрелец Метеорлық жауын?
Dialogue: 0,0:33:51.19,0:33:56.07,Default,,0,0,0,,Жалғыз зиянкес - бұл метеориттік жауын, ал басқа жалғыз бұзушы - басқа дүниенің жолы.
Dialogue: 0,0:33:56.15,0:34:00.32,Default,,0,0,0,,Кеңістік-уақыттың бұрмалануы жоқ, басқа өлшемнен келетін зиянкестер жоқ.
Dialogue: 0,0:34:00.41,0:34:04.20,Default,,0,0,0,,Сонда әлгі метеориттік жауын - бұл шабуылдаушы.
Dialogue: 0,0:34:04.29,0:34:08.08,Default,,0,0,0,,Олар бұл жерге жұлдыз болып келді.
Dialogue: 0,0:34:08.88,0:34:11.96,Default,,0,0,0,,Онда мен саған қоян жіберемін.
Dialogue: 0,0:34:12.04,0:34:14.21,Default,,0,0,0,,Егер бірдеңе болса, мен сізге хабарласамын.
Dialogue: 0,0:34:16.63,0:34:19.55,Default,,0,0,0,,Мен үшеуіңді бақылауды жалғастырамын.
Dialogue: 0,0:34:19.64,0:34:22.39,Default,,0,0,0,,Мен Лунамен және басқалармен басып кіру жолын зерттеймін.
Dialogue: 0,0:34:22.47,0:34:25.77,Default,,0,0,0,,Мина Мен ертең Джубан орта мектебіне барамын.
Dialogue: 0,0:34:25.85,0:34:28.10,Default,,0,0,0,,Екеуің Үш шамға хабарласасыңдар.
Dialogue: 0,0:34:28.19,0:34:29.94,Default,,0,0,0,,- (Минако) Иә? -Шщ!
Dialogue: 0,0:34:30.02,0:34:33.94,Default,,0,0,0,,Бұл үшеуінің шынымен де Теңізші Сенши екенін тексеріңіз.
Dialogue: 0,0:34:34.03,0:34:37.61,Default,,0,0,0,,Егер сіздің жауыңыз болса, не істер едіңіз?
Dialogue: 0,0:34:37.70,0:34:40.11,Default,,0,0,0,,«Отсыз түтін болмайды»
Dialogue: 0,0:34:40.20,0:34:42.83,Default,,0,0,0,,«Үш жарық болса, ұрыс бар».
Dialogue: 0,0:34:42.91,0:34:44.45,Default,,0,0,0,,Жау болса, соғыс.
Dialogue: 0,0:34:44.54,0:34:46.91,Default,,0,0,0,,Shadow Galactica орнын табыңыз
Dialogue: 0,0:34:47.00,0:34:49.62,Default,,0,0,0,,Меркурий мен Юпитер өлген жоқ.
Dialogue: 0,0:34:49.71,0:34:51.17,Default,,0,0,0,,Мен сондамын
Dialogue: 0,0:34:51.25,0:34:54.71,Default,,0,0,0,,Кристалды қалпына келтіріп, екеуін құтқарыңыз
Dialogue: 0,0:34:54.80,0:34:57.80,Default,,0,0,0,,Ал қоян мен мына планетаны қорға.
Dialogue: 0,0:35:00.59,0:35:02.22,Default,,0,0,0,,Сен нағыз бас аурусың.
Dialogue: 0,0:35:02.30,0:35:06.68,Default,,0,0,0,,Алдымнан тұман тұрғандай, алға басуға қорқамын.
Dialogue: 0,0:35:06.77,0:35:08.89,Default,,0,0,0,,Неліктен олай сезінесіз?
Dialogue: 0,0:35:08.98,0:35:12.36,Default,,0,0,0,,Әй, мен уәдемді есіме түсірдім.
Dialogue: 0,0:35:12.44,0:35:13.52,Default,,0,0,0,,Қоян?
Dialogue: 0,0:35:13.61,0:35:16.11,Default,,0,0,0,,Мамо-чанның достарымен танысыңыз
Dialogue: 0,0:35:16.19,0:35:18.19,Default,,0,0,0,,Егер бірдеңе болса, маған хабарласыңыз.
Dialogue: 0,0:35:19.70,0:35:23.57,Default,,0,0,0,,Не? Мамору-сенпайдың американдық телефон нөмірі ме?
Dialogue: 0,0:35:23.66,0:35:25.70,Default,,0,0,0,,Мен тыңдамадым.
Dialogue: 0,0:35:25.79,0:35:30.04,Default,,0,0,0,,Менің ағам хабарласпайды.
Dialogue: 0,0:35:30.12,0:35:32.79,Default,,0,0,0,,Усаги-сенпай хат алады, солай ма?
Dialogue: 0,0:35:32.88,0:35:33.92,Default,,0,0,0,,-(Асанума) Анау... -Ол жерде жазылмаған.
Dialogue: 0,0:35:34.00,0:35:34.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:34.92,0:35:38.80,Default,,0,0,0,,Мамо-чанның әуе поштасында жай ғана карта бар.
Dialogue: 0,0:35:38.88,0:35:40.59,Default,,0,0,0,,Әріптер жоқ
Dialogue: 0,0:35:40.68,0:35:45.85,Default,,0,0,0,,Хабарлар, мекенжайлар, ұялы телефондар, тіпті жіберушінің аты...
Dialogue: 0,0:35:45.93,0:35:49.10,Default,,0,0,0,,Мен ертең аға досымнан сұраймын!
Dialogue: 0,0:35:49.18,0:35:51.44,Default,,0,0,0,,Сізге хабарласатынына сенімдімін.
Dialogue: 0,0:35:51.52,0:35:53.60,Default,,0,0,0,,-Рахмет Асанума-кун -(Асанума) Жоқ, жоқ.
Dialogue: 0,0:35:53.69,0:35:55.73,Default,,0,0,0,,- (Асанума) Бәрі жақсы - Усаги...
Dialogue: 0,0:35:56.44,0:35:58.65,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:35:58.73,0:36:02.91,Default,,0,0,0,,Мамо-чанның бөлмесіне қоңырау шалсам да, оның жауап беруі мүмкін емес еді.
Dialogue: 0,0:36:03.82,0:36:07.20,Default,,0,0,0,,Мен маңызды нәрсені ұмытып қалдым.
Dialogue: 0,0:36:07.29,0:36:11.21,Default,,0,0,0,,Бірақ есіме түсіруге тырысқан сайын абдырап қалдым...
Dialogue: 0,0:36:11.29,0:36:12.71,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:36:12.79,0:36:16.46,Default,,0,0,0,,Мен жүре бастасам, бәрі кетіп қалған сияқты.
Dialogue: 0,0:36:22.76,0:36:25.60,Default,,0,0,0,,Мені жұбатасыз ба? Чиби Чиби
Dialogue: 0,0:36:30.93,0:36:33.60,Default,,0,0,0,,Мамо-чан, мен сенімен танысқым келеді
Dialogue: 0,0:36:34.48,0:36:38.90,Default,,0,0,0,,Қазір мені құшақтап, атымды Мамо-чан деп ата!
Dialogue: 0,0:36:38.98,0:36:41.57,Default,,0,0,0,,Шынайы күресіңіз! Әйтпесе...
Dialogue: 0,0:36:41.65,0:36:43.74,Default,,0,0,0,,Егер сіз мұны жақсы орындамасаңыз
Dialogue: 0,0:36:44.57,0:36:45.82,Default,,0,0,0,,Бірақ мен оны сезінемін.
Dialogue: 0,0:36:46.53,0:36:51.12,Default,,0,0,0,,Мамо-чан және басқалары мен үшін таптырмас.
Dialogue: 0,0:36:51.20,0:36:56.58,Default,,0,0,0,,Дәл қазір Юпитер мен Меркурий үшін де сондай алаңдаушылық бар.
Dialogue: 0,0:36:56.67,0:36:57.96,Default,,0,0,0,,Мамо-чанға...
Dialogue: 0,0:36:58.92,0:37:00.21,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:37:00.30,0:37:02.72,Default,,0,0,0,,Ах! Хошино-кун
Dialogue: 0,0:37:04.76,0:37:06.80,Default,,0,0,0,,Ал сендер ше...
Dialogue: 0,0:37:08.47,0:37:12.93,Default,,0,0,0,,Менің денем... қозғалмайды. Картада бірдеңе бар ма?
Dialogue: 0,0:37:13.02,0:37:13.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:37:13.94,0:37:16.44,Default,,0,0,0,,Есте сақта! Менің уақытым жоқ
Dialogue: 0,0:37:16.52,0:37:19.61,Default,,0,0,0,,Егер күшің жетпесе, бұл шайқаста жеңілесің.
Dialogue: 0,0:37:19.69,0:37:22.36,Default,,0,0,0,,Юпитер мен Меркурийге не болғанын есіңізде ме?
Dialogue: 0,0:37:22.44,0:37:24.20,Default,,0,0,0,,Сіздің Мамору...
Dialogue: 0,0:37:24.86,0:37:25.95,Default,,0,0,0,,Мамо-чан...
Dialogue: 0,0:37:27.16,0:37:30.12,Default,,0,0,0,,Иә! Мен одан арғысын көргім келмейді!
Dialogue: 0,0:37:37.75,0:37:38.58,Default,,0,0,0,,Ханзада?
Dialogue: 0,0:37:39.84,0:37:43.59,Default,,0,0,0,,Кешіріңіз, мен сізді азапқа түсіргім келмеді...
Dialogue: 0,0:37:46.68,0:37:47.72,Default,,0,0,0,,- Ха! -Бұл!
Dialogue: 0,0:37:48.43,0:37:51.14,Default,,0,0,0,,Бұл теңізші Галаксия
Dialogue: 0,0:37:51.22,0:37:52.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:37:54.56,0:37:55.60,Default,,0,0,0,,Қоян!
Dialogue: 0,0:38:02.36,0:38:04.36,Default,,0,0,0,,Теңізші Галаксия...
Dialogue: 0,0:38:04.44,0:38:05.61,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:38:05.70,0:38:07.74,Default,,0,0,0,,Сіздің Маморуыңыз... Сіздің Маморуыңыз...
Dialogue: 0,0:38:07.82,0:38:09.12,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:38:09.78,0:38:15.50,Default,,0,0,0,,Құлағымда жаңғырған әлгі бәсең дауыс, мені сорып алғандай көздер
Dialogue: 0,0:38:16.12,0:38:17.50,Default,,0,0,0,,есімде
Dialogue: 0,0:38:17.58,0:38:20.50,Default,,0,0,0,,Мамо-чанға ұқсас
Dialogue: 0,0:38:23.25,0:38:25.46,Default,,0,0,0,,Сен неге ол қызды ойлайсың?
Dialogue: 0,0:38:27.26,0:38:30.22,Default,,0,0,0,,Ол сол адамға ұқсайды.
Dialogue: 0,0:38:33.47,0:38:34.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:34.77,0:38:35.93,Default,,0,0,0,,Мамо-чан?
Dialogue: 0,0:38:37.44,0:38:40.44,Default,,0,0,0,,Бұл хат шынымен Мамо-чаннан ма?
Dialogue: 0,0:38:41.65,0:38:43.07,Default,,0,0,0,,Галактика
Dialogue: 0,0:38:44.57,0:38:47.49,Default,,0,0,0,,Көлеңке Галактика
Dialogue: 0,0:38:48.45,0:38:49.53,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:38:50.20,0:38:53.83,Default,,0,0,0,,Галаксия-сама Теңізші темір тышқанның артынан
Dialogue: 0,0:38:53.91,0:38:58.25,Default,,0,0,0,,Теңізші Алюминий Сиреннің қателігін кешіріңіз.
Dialogue: 0,0:38:58.33,0:39:01.50,Default,,0,0,0,,Барлығы менің жауапкершілігімде.
Dialogue: 0,0:39:01.58,0:39:07.30,Default,,0,0,0,,Дегенмен мен сізді екі матрос кристалын алғаныңыз үшін мақтаймын және оларды жіберемін.
Dialogue: 0,0:39:07.38,0:39:08.22,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:39:08.30,0:39:12.72,Default,,0,0,0,,Сізге ең жоғарғы шыңы ұнайды деп үміттенемін.
Dialogue: 0,0:39:12.80,0:39:16.22,Default,,0,0,0,,Қалған кристалдардың барлығын қолдарыңызға алуды ұмытпаңыз!
Dialogue: 0,0:39:16.31,0:39:19.56,Default,,0,0,0,,Жеңілмейтін матрос кристалын ұстаған кезде
Dialogue: 0,0:39:19.64,0:39:21.56,Default,,0,0,0,,Адам боп нәзік жұлдызды тұқымға
Dialogue: 0,0:39:21.65,0:39:23.19,Default,,0,0,0,,Жабысу нені білдіреді?
Dialogue: 0,0:39:23.27,0:39:24.98,Default,,0,0,0,,Құрметті Галактика
Dialogue: 0,0:39:25.07,0:39:27.69,Default,,0,0,0,,Теңізші Үшінші жауынгерді жандандырады
Dialogue: 0,0:39:27.78,0:39:29.61,Default,,0,0,0,,Мына қызыл тырнақ
Dialogue: 0,0:39:29.70,0:39:33.70,Default,,0,0,0,,Сейлор Мунды әдемі сахнаға сүйреп шығарайық
Dialogue: 0,0:39:35.70,0:39:38.62,Default,,0,0,0,,Мен оны қазір тоқтата алмайтын шығармын
Dialogue: 0,0:39:38.70,0:39:40.37,Default,,0,0,0,,Өрт сөндіруші
Dialogue: 0,0:39:40.46,0:39:43.75,Default,,0,0,0,,Рей-чан саған жақсы көрінеді.
Dialogue: 0,0:39:43.83,0:39:45.96,Default,,0,0,0,,Менің формасым өте жарасады!
Dialogue: 0,0:39:46.05,0:39:47.09,Default,,0,0,0,,Қояндар ше?
Dialogue: 0,0:39:47.17,0:39:49.17,Default,,0,0,0,,Нару-чанмен және басқалармен түскі ас.
Dialogue: 0,0:39:49.26,0:39:51.97,Default,,0,0,0,,Біраз болса да жақсы болып көрінуге болатын сияқты.
Dialogue: 0,0:39:52.05,0:39:54.60,Default,,0,0,0,,...Ал өсек-айдолдар кімдер?
Dialogue: 0,0:39:57.01,0:39:57.81,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:39:57.89,0:40:00.56,Default,,0,0,0,,Үш шамның супер құпия жазбасы
Dialogue: 0,0:40:00.64,0:40:03.19,Default,,0,0,0,,Үш өлшемнен ән мәтініне дейін
Dialogue: 0,0:40:03.27,0:40:07.02,Default,,0,0,0,,Түскі үзілісте үшеуміз бас ғимараттың төбесінде боламыз.
Dialogue: 0,0:40:07.11,0:40:09.44,Default,,0,0,0,,Бұл өте құпия деректер.
Dialogue: 0,0:40:09.53,0:40:10.82,Default,,0,0,0,,Енді кеттік!
Dialogue: 0,0:40:11.65,0:40:12.49,Default,,0,0,0,,...және?
Dialogue: 0,0:40:12.57,0:40:16.45,Default,,0,0,0,,О! Неге мұнда ешкім жоқ?
Dialogue: 0,0:40:16.53,0:40:20.20,Default,,0,0,0,,Ал, түскі үзіліс енді басталды, күтейік.
Dialogue: 0,0:40:20.29,0:40:23.46,Default,,0,0,0,,Қарғыс атсын! Қарным ашты, тез кел!
Dialogue: 0,0:40:24.63,0:40:27.71,Default,,0,0,0,,Егер мен де Джубан орта мектебінде болсам
Dialogue: 0,0:40:27.80,0:40:30.97,Default,,0,0,0,,Мен мектептегі өмірімді барлығымен бірге өткізе алар едім.
Dialogue: 0,0:40:31.05,0:40:33.26,Default,,0,0,0,,Не? кенеттен
Dialogue: 0,0:40:34.55,0:40:35.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:35.64,0:40:39.06,Default,,0,0,0,,Бұл карта бүгін таңертең таротта пайда болды.
Dialogue: 0,0:40:39.14,0:40:40.43,Default,,0,0,0,,«Өлім Құдайы»
Dialogue: 0,0:40:40.52,0:40:44.69,Default,,0,0,0,,Түсіндім, бұл менің бұрын өткізген шайқастарымнан бөлек.
Dialogue: 0,0:40:44.77,0:40:46.69,Default,,0,0,0,,Менде бұл жолы қайтып келе алмайтындай сезім бар...
Dialogue: 0,0:40:46.77,0:40:47.65,Default,,0,0,0,,Тоқта
Dialogue: 0,0:40:47.73,0:40:51.78,Default,,0,0,0,,Осы екеуін құтқарамын деп ант еттің.
Dialogue: 0,0:40:51.86,0:40:57.07,Default,,0,0,0,,Біз әрқашан бірдейміз, достарымызға көмектесеміз және жақындарымызды қорғаймыз.
Dialogue: 0,0:40:57.16,0:40:59.54,Default,,0,0,0,,Бұл жолы да дәл солай және...
Dialogue: 0,0:41:00.20,0:41:03.16,Default,,0,0,0,,Мен мұнда міндетті түрде тірі ораламын.
Dialogue: 0,0:41:03.25,0:41:08.17,Default,,0,0,0,,Олай болса, орта мектеп өміріне оралыңыз және осы жолы жігітті алыңыз!
Dialogue: 0,0:41:09.00,0:41:10.80,Default,,0,0,0,,Өйткені, бұл ер адам.
Dialogue: 0,0:41:10.88,0:41:13.88,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезімде де жалғыз істей алмадым.
Dialogue: 0,0:41:13.97,0:41:15.18,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:41:15.26,0:41:18.35,Default,,0,0,0,,Үш жарық сияқты керемет сүйіктілерді жасаңыз
Dialogue: 0,0:41:18.43,0:41:20.97,Default,,0,0,0,,Осымен мен көп кездесулерге бардым.
Dialogue: 0,0:41:21.06,0:41:25.69,Default,,0,0,0,,Қарапайым орта мектептің қызы бол. Бұл ақыр соңында жалғыз нұсқа.
Dialogue: 0,0:41:25.77,0:41:26.85,Default,,0,0,0,,Өтірікке толы
Dialogue: 0,0:41:29.11,0:41:31.78,Default,,0,0,0,,Өз шешімін жасап қойған адамдар болса да
Dialogue: 0,0:41:32.40,0:41:35.53,Default,,0,0,0,,Мен сол адам үшін өмір сүруді шешсем де.
Dialogue: 0,0:41:35.61,0:41:37.24,Default,,0,0,0,,Фу…
Dialogue: 0,0:41:37.32,0:41:39.74,Default,,0,0,0,,Олар білсе, көмектесу мүмкін емес.
Dialogue: 0,0:41:39.83,0:41:42.87,Default,,0,0,0,,Иә, көп уақыттың ортасында жүргеніме көп болды.
Dialogue: 0,0:41:42.95,0:41:45.50,Default,,0,0,0,,Жанын берген бір ғана адам бар.
Dialogue: 0,0:41:45.58,0:41:46.75,Default,,0,0,0,,Мина
Dialogue: 0,0:41:48.33,0:41:49.46,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:41:49.54,0:41:53.26,Default,,0,0,0,,Сондықтан еркектерді шақырмаймыз.
Dialogue: 0,0:41:54.22,0:41:55.63,Default,,0,0,0,,Жаман ба?
Dialogue: 0,0:41:55.72,0:41:59.05,Default,,0,0,0,,Ия... нағыз теңізші-жауынгер болатыны осы
Dialogue: 0,0:41:59.14,0:42:00.93,Default,,0,0,0,,Балалар, сендер ше?
Dialogue: 0,0:42:01.01,0:42:03.64,Default,,0,0,0,,Егер біз жалған болсақ ше?
Dialogue: 0,0:42:03.72,0:42:06.39,Default,,0,0,0,,Біздің жауымыз тең!
Dialogue: 0,0:42:06.48,0:42:08.52,Default,,0,0,0,,Венераның кристалдық күші!
Dialogue: 0,0:42:08.60,0:42:10.90,Default,,0,0,0,,Марстың кристалдық күші!
Dialogue: 0,0:42:10.98,0:42:13.15,Default,,0,0,0,,Макияж!
Dialogue: 0,0:42:13.94,0:42:17.20,Default,,0,0,0,,Біз алаламай ұрыспақ ниетіміз жоқ.
Dialogue: 0,0:42:17.28,0:42:19.16,Default,,0,0,0,,Мен жай ғана сендердің кім екендеріңді білгім келеді.
Dialogue: 0,0:42:20.12,0:42:21.91,Default,,0,0,0,,Егер сіз өзіңізді матрос жауынгер десеңіз
Dialogue: 0,0:42:21.99,0:42:24.41,Default,,0,0,0,,Сол сияқты мен де көз алдыңда түрленіп көрейін.
Dialogue: 0,0:42:24.50,0:42:25.91,Default,,0,0,0,,Жүр, асығыңыз!
Dialogue: 0,0:42:27.71,0:42:29.29,Default,,0,0,0,,Жауынгер Жұлдыз Күші!
Dialogue: 0,0:42:29.38,0:42:31.00,Default,,0,0,0,,Жаратушы Жұлдыз Күші!
Dialogue: 0,0:42:31.09,0:42:32.54,Default,,0,0,0,,Емші жұлдыз күші!
Dialogue: 0,0:42:32.63,0:42:34.17,Default,,0,0,0,,Макияж!
Dialogue: 0,0:42:37.59,0:42:40.18,Default,,0,0,0,,Жұлдыздардың күшін сезіну
Dialogue: 0,0:42:40.26,0:42:44.18,Default,,0,0,0,,Бұл сөзсіз жұлдыздық күші бар кристалл.
Dialogue: 0,0:42:44.27,0:42:48.81,Default,,0,0,0,,Әрине, біз сияқты теңізші макияж!
Dialogue: 0,0:42:48.89,0:42:54.02,Default,,0,0,0,,Біз және біздің жаудың матрос жауынгерлері жай ғана аты-жөнімізді айтатын үміткерлер емеспіз.
Dialogue: 0,0:42:54.11,0:42:56.86,Default,,0,0,0,,Өйткені, егер сіз нағыз теңізші жауынгер болсаңыз...
Dialogue: 0,0:42:56.94,0:42:59.15,Default,,0,0,0,,Балалар сендер қайдан келдіңдер?
Dialogue: 0,0:42:59.24,0:43:00.61,Default,,0,0,0,,Теңізші Марс
Dialogue: 0,0:43:01.66,0:43:04.08,Default,,0,0,0,,«Өлім Құдайынан» кейінгі келесі карта
Dialogue: 0,0:43:05.87,0:43:07.20,Default,,0,0,0,,Галактика?
Dialogue: 0,0:43:09.29,0:43:11.33,Default,,0,0,0,,Sailor Starlights…
Dialogue: 0,0:43:11.42,0:43:12.42,Default,,0,0,0,,Осы галактикада
Dialogue: 0,0:43:12.50,0:43:15.17,Default,,0,0,0,,Бізден басқа да теңізші жауынгерлер бар.
Dialogue: 0,0:43:15.80,0:43:16.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:43:16.88,0:43:19.47,Default,,0,0,0,,Қандай адастыратын энергия ағыны.
Dialogue: 0,0:43:19.55,0:43:21.68,Default,,0,0,0,,Бұл түстен кейінгі бағыт
Dialogue: 0,0:43:21.76,0:43:23.85,Default,,0,0,0,,Хикава храмының айналасында!?
Dialogue: 0,0:43:25.43,0:43:27.81,Default,,0,0,0,,Жұлдызды тұқымның жарығы
Dialogue: 0,0:43:27.89,0:43:29.48,Default,,0,0,0,,Мен мұны бірден білдім.
Dialogue: 0,0:43:29.56,0:43:31.69,Default,,0,0,0,,Кездейсоқ көріну туралы не айтасыз?
Dialogue: 0,0:43:35.77,0:43:38.65,Default,,0,0,0,,Көптен бері көрмедім, Фобос Димос
Dialogue: 0,0:43:38.74,0:43:40.11,Default,,0,0,0,,Қызыл қарға
Dialogue: 0,0:43:40.20,0:43:42.36,Default,,0,0,0,,Менің туған планетам Коронистен
Dialogue: 0,0:43:42.45,0:43:47.29,Default,,0,0,0,,Галактикадағы ең жарқыраған күн жүйесінде Марс ханшайымы ретінде таңдалды.
Dialogue: 0,0:43:47.37,0:43:49.75,Default,,0,0,0,,Оған атымен бірдей жұлдыз берілді.
Dialogue: 0,0:43:49.83,0:43:53.50,Default,,0,0,0,,Ханшайымның серіктесі болған бақытты егіздер
Dialogue: 0,0:43:53.58,0:43:57.34,Default,,0,0,0,,Бұрын екеуіміз де армандайтын стажер едік.
Dialogue: 0,0:43:57.42,0:44:00.42,Default,,0,0,0,,Галактикада өмір сүретін әрбір адамның жұлдызды тұқымы бар.
Dialogue: 0,0:44:00.51,0:44:03.30,Default,,0,0,0,,Олардың арасынан таңдалған жұлдызды тұқымдар
Dialogue: 0,0:44:03.39,0:44:08.06,Default,,0,0,0,,Теңізші кристалдарына ие болғандар өздерін Сейлор Сенши деп атай алады.
Dialogue: 0,0:44:08.14,0:44:11.27,Default,,0,0,0,,Мен матрос Қызыл тырнақпын, матрос Сенши!
Dialogue: 0,0:44:11.35,0:44:13.02,Default,,0,0,0,,Теңізші Сенши!?
Dialogue: 0,0:44:13.65,0:44:16.07,Default,,0,0,0,,Кім өзін Коронис планетасында теңізші Сенши деп атай алады?
Dialogue: 0,0:44:16.15,0:44:17.78,Default,,0,0,0,,Тек матрос Коронис!
Dialogue: 0,0:44:18.44,0:44:21.40,Default,,0,0,0,,Галактика торнадо!
Dialogue: 0,0:44:24.28,0:44:25.62,Default,,0,0,0,,Бұл қандай күш?
Dialogue: 0,0:44:25.70,0:44:27.99,Default,,0,0,0,,Хахаха... Иә.
Dialogue: 0,0:44:28.08,0:44:29.54,Default,,0,0,0,,Мен Галактикаданмын.
Dialogue: 0,0:44:29.62,0:44:32.41,Default,,0,0,0,,Теңізші Кристалдың күшін алды.
Dialogue: 0,0:44:32.50,0:44:34.50,Default,,0,0,0,,Күн жүйесінің жауынгер-матростары туралы.
Dialogue: 0,0:44:34.58,0:44:35.96,Default,,0,0,0,,Кристалдардың орнына
Dialogue: 0,0:44:36.04,0:44:39.51,Default,,0,0,0,,Сен маған өз жұлдызым болады деп уәде бердің.
Dialogue: 0,0:44:39.59,0:44:44.43,Default,,0,0,0,,Мен Галаксия-самаға адал болуға ант беретін теңізші анимаматына айналдым.
Dialogue: 0,0:44:44.51,0:44:46.72,Default,,0,0,0,,Біздің ғаламшарымыз және достарымыз...
Dialogue: 0,0:44:46.80,0:44:48.68,Default,,0,0,0,,Теңізші Корониске опасыздық жасадың ба!?
Dialogue: 0,0:44:48.76,0:44:51.60,Default,,0,0,0,,Менің достарым да, матрос Коронис те кетті!
Dialogue: 0,0:44:51.68,0:44:53.56,Default,,0,0,0,,Біздің ғаламшарымыз енді жоқ!
Dialogue: 0,0:44:54.44,0:44:55.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:58.02,0:44:59.65,Default,,0,0,0,,Фобос! Димос!
Dialogue: 0,0:44:59.73,0:45:03.90,Default,,0,0,0,,Марс жалынының снайпері!
Dialogue: 0,0:45:05.61,0:45:06.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:45:07.70,0:45:09.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:09.28,0:45:10.95,Default,,0,0,0,,Уф!Уф...
Dialogue: 0,0:45:11.04,0:45:12.66,Default,,0,0,0,,- (Венера) Марс! - Ой!
Dialogue: 0,0:45:12.75,0:45:16.71,Default,,0,0,0,,Егер сіз қозғалсаңыз, сіз аз уақытта Фобос пен Деймос сияқты боласыз.
Dialogue: 0,0:45:16.79,0:45:18.79,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:45:19.80,0:45:22.21,Default,,0,0,0,,Қарғыс атсын, Сейлор Мун!
Dialogue: 0,0:45:22.30,0:45:23.55,Default,,0,0,0,,Ха!
Dialogue: 0,0:45:23.63,0:45:24.47,Default,,0,0,0,,Венера!?
Dialogue: 0,0:45:26.43,0:45:29.85,Default,,0,0,0,,Хехе... Мен Марс ханшайымынан бастайын деп ойлаймын.
Dialogue: 0,0:45:29.93,0:45:32.68,Default,,0,0,0,,Әлде Венера ханшайымынан ма?
Dialogue: 0,0:45:32.77,0:45:33.85,Default,,0,0,0,,Бұл Музан мырза…
Dialogue: 0,0:45:33.93,0:45:35.10,Default,,0,0,0,,Бірінші сен бар!
Dialogue: 0,0:45:37.19,0:45:40.90,Default,,0,0,0,,Жұлдызды бал айы...
Dialogue: 0,0:45:42.19,0:45:45.53,Default,,0,0,0,,Терапиялық поцелу!
Dialogue: 0,0:45:47.78,0:45:48.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:49.07,0:45:50.74,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:45:52.16,0:45:53.16,Default,,0,0,0,,Сейлор Мун!
Dialogue: 0,0:45:56.71,0:45:59.88,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:46:03.26,0:46:08.30,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:46:09.22,0:46:11.56,Default,,0,0,0,,Венера Марс
Dialogue: 0,0:46:12.18,0:46:14.22,Default,,0,0,0,,Юпитер Меркурий
Dialogue: 0,0:46:15.68,0:46:17.35,Default,,0,0,0,,Мамо-чан
Dialogue: 0,0:46:20.94,0:46:22.94,Default,,0,0,0,,Сейлор Мун!
Dialogue: 0,0:46:24.40,0:46:28.95,Default,,0,0,0,,(орын музыкасы)
Dialogue: 0,0:46:29.03,0:46:30.12,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:46:30.20,0:46:32.24,Default,,0,0,0,,Кішкентай ханымдарға сәлем!
Dialogue: 0,0:46:32.33,0:46:34.58,Default,,0,0,0,,Қош келдіңіз ханшайым
Dialogue: 0,0:46:34.66,0:46:37.50,Default,,0,0,0,,Сіз бүгінгі кештің кейіпкерісіз.
Dialogue: 0,0:46:37.58,0:46:39.83,Default,,0,0,0,,Қош келдіңіз, сүйкімді ханшайым
Dialogue: 0,0:46:40.83,0:46:43.67,Default,,0,0,0,,Әке мен анаға рахмет
Dialogue: 0,0:46:43.75,0:46:46.63,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:46:46.72,0:46:49.72,Default,,0,0,0,,Найзағай бұлты? Осы уақытқа дейін күн ашық болды
Dialogue: 0,0:46:51.43,0:46:53.81,Default,,0,0,0,,30 ғасырға оралғаннан кейін
Dialogue: 0,0:46:53.89,0:46:55.97,Default,,0,0,0,,Аспан әлдеқайда тұрақсыз.
Dialogue: 0,0:46:56.60,0:46:57.48,Default,,0,0,0,,Иә.
Dialogue: 0,0:46:57.56,0:47:00.31,Default,,0,0,0,,Мына гүлді Плутонға апарыңыз.
Dialogue: 0,0:47:00.98,0:47:03.32,Default,,0,0,0,,Бір нәрсе өзгерді ме деп сұрайық.
Dialogue: 0,0:47:04.61,0:47:06.82,Default,,0,0,0,,Кеңістік-уақыт бұрмалана бастады ма?
Dialogue: 0,0:47:06.90,0:47:09.82,Default,,0,0,0,,Өткенде біртүрлі оқиға болды.
Dialogue: 0,0:47:09.91,0:47:13.45,Default,,0,0,0,,Осылай жалғаса берсе, тарих өзгеруі мүмкін.
Dialogue: 0,0:47:14.16,0:47:16.25,Default,,0,0,0,,Өткенде не болды?
Dialogue: 0,0:47:16.33,0:47:17.16,Default,,0,0,0,,Бұл... (шу)
Dialogue: 0,0:47:17.25,0:47:18.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:18.16,0:47:19.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:21.04,0:47:22.79,Default,,0,0,0,,Өткен қашан?
Dialogue: 0,0:47:22.88,0:47:25.13,Default,,0,0,0,,Сейлор Мунға және басқаларға бірдеңе болды ма?
Dialogue: 0,0:47:25.21,0:47:27.88,Default,,0,0,0,,Мен қайтуым керек! Барлығына
Dialogue: 0,0:47:29.13,0:47:30.51,Default,,0,0,0,,Кішкентай ханым
Dialogue: 0,0:47:30.59,0:47:32.64,Default,,0,0,0,,Менің жаттығуым аяқталды.
Dialogue: 0,0:47:32.72,0:47:36.10,Default,,0,0,0,,Кеңістік-уақыт кілті Плутонға қайтарылды.
Dialogue: 0,0:47:36.18,0:47:40.39,Default,,0,0,0,,Бұл жерден көп нәрсені үйрену керек.
Dialogue: 0,0:47:40.48,0:47:41.27,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:47:41.35,0:47:44.11,Default,,0,0,0,,Енді ұйықтаңыз.
Dialogue: 0,0:47:44.94,0:47:46.98,Default,,0,0,0,,Иә, анашым
Dialogue: 0,0:47:47.07,0:47:50.90,Default,,0,0,0,,Ендеше... өткенге орала алмаймыз ба?
Dialogue: 0,0:47:50.99,0:47:52.82,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:47:53.70,0:47:56.79,Default,,0,0,0,,Мен барлығына қайта оралғым келеді.
Dialogue: 0,0:47:56.87,0:47:58.54,Default,,0,0,0,,Кішкентай ханым
Dialogue: 0,0:47:58.62,0:48:00.54,Default,,0,0,0,,Мен қайтқым келеді!
Dialogue: 0,0:48:01.21,0:48:03.38,Default,,0,0,0,,Қане сарайымызға қайтайық.
Dialogue: 0,0:48:03.46,0:48:06.55,Default,,0,0,0,,Ал күн жүйесіне қалқан орнатайық.
Dialogue: 0,0:48:06.63,0:48:10.01,Default,,0,0,0,,Sailor Power Guardian күшін алыңыз
Dialogue: 0,0:48:10.09,0:48:13.05,Default,,0,0,0,,Бұл келесі зиянкестердің алдын алудың жалғыз жолы.
Dialogue: 0,0:48:13.14,0:48:16.64,Default,,0,0,0,,Ал енді Сейлор Старлайтсты ынтымақтастыққа шақырайық.
Dialogue: 0,0:48:16.72,0:48:19.81,Default,,0,0,0,,Галактиканың түкпір-түкпірінен теңізшілер жауынгерлері туралы мәліметтер жинаңыз
Dialogue: 0,0:48:19.89,0:48:22.06,Default,,0,0,0,,Не болып жатқанын табыңыз
Dialogue: 0,0:48:22.69,0:48:24.19,Default,,0,0,0,,Келесі шайқас
Dialogue: 0,0:48:24.27,0:48:26.65,Default,,0,0,0,,Бұл деңгейде біз жалғыз емес сияқтымыз.
Dialogue: 0,0:48:27.27,0:48:29.28,Default,,0,0,0,,Луна Артемида
Dialogue: 0,0:48:29.36,0:48:32.36,Default,,0,0,0,,Мен Ханшайым мен Хотарудан біраз уақыт сұраймын.
Dialogue: 0,0:48:32.45,0:48:33.41,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:48:38.70,0:48:40.25,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:48:40.33,0:48:42.66,Default,,0,0,0,,Менің ойымша, сіз жақында оянасыз.
Dialogue: 0,0:48:42.75,0:48:44.67,Default,,0,0,0,,Мен не болды деп қатты таң қалдым.
Dialogue: 0,0:48:44.75,0:48:46.46,Default,,0,0,0,,Егер сіз кенеттен құлап қалсаңыз
Dialogue: 0,0:48:46.54,0:48:48.21,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:48:48.88,0:48:49.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:51.97,0:48:55.43,Default,,0,0,0,,Ал, Чиби Чиби, сен осында болдың.
Dialogue: 0,0:48:55.51,0:48:56.68,Default,,0,0,0,,Сізде тамақ бар ма?
Dialogue: 0,0:48:56.76,0:48:58.26,Default,,0,0,0,,Тамақтану~
Dialogue: 0,0:48:58.35,0:48:59.22,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:48:59.31,0:49:01.52,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:49:01.60,0:49:02.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:06.69,0:49:08.57,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:49:08.65,0:49:10.36,Default,,0,0,0,,Әуежайда Мамо-чан...
Dialogue: 0,0:49:10.44,0:49:12.36,Default,,0,0,0,,Менің алдымда...
Dialogue: 0,0:49:13.57,0:49:17.99,Default,,0,0,0,,Мен өз естеліктеріме сенгім келмейді...
Dialogue: 0,0:49:19.53,0:49:21.62,Default,,0,0,0,,Ол Мамо-чанға күлді...
Dialogue: 0,0:49:22.50,0:49:23.91,Default,,0,0,0,,Венера мен Марс...
Dialogue: 0,0:49:24.83,0:49:26.88,Default,,0,0,0,,Бұл Галактика, солай ма?
Dialogue: 0,0:49:26.96,0:49:31.13,Default,,0,0,0,,Иә, мен сендердің ең күшті жауларың болғанына сенімдімін.
Dialogue: 0,0:49:31.21,0:49:35.34,Default,,0,0,0,,Қайдасың? Галаксия да теңізші Сенши ме?
Dialogue: 0,0:49:35.43,0:49:40.10,Default,,0,0,0,,Теңізші Сенши болсаң да, неге бізді шайқасқа шақырасың?
Dialogue: 0,0:49:40.18,0:49:45.35,Default,,0,0,0,,Бұл тек сендер емес, олар бүкіл галактика бойынша Сейлор Сеншиге шабуыл жасап жатыр.
Dialogue: 0,0:49:45.44,0:49:46.44,Default,,0,0,0,,Ах… Эх…
Dialogue: 0,0:49:46.52,0:49:49.69,Default,,0,0,0,,Теңізші жауынгерлердің шыңына жету
Dialogue: 0,0:49:49.77,0:49:52.28,Default,,0,0,0,,Барлық галактикадан келген матрос Сенши?
Dialogue: 0,0:49:52.36,0:49:56.45,Default,,0,0,0,,Галактикада бізден басқа Теңізші Сенши бар ма?
Dialogue: 0,0:49:56.53,0:50:02.70,Default,,0,0,0,,Біздің планетамыз бен ханшайымымызға Галаксия шабуыл жасады.
Dialogue: 0,0:50:02.79,0:50:04.58,Default,,0,0,0,,Шабуыл жасау...
Dialogue: 0,0:50:05.83,0:50:06.67,Default,,0,0,0,,Үйрет бізге.
Dialogue: 0,0:50:06.75,0:50:12.17,Default,,0,0,0,,Мамо-чан мен Венераның денелері жойылды деген нені білдіреді?
Dialogue: 0,0:50:13.13,0:50:14.84,Default,,0,0,0,,«Өлім» адам ретінде
Dialogue: 0,0:50:16.13,0:50:17.13,Default,,0,0,0,,«Өлім»?
Dialogue: 0,0:50:17.76,0:50:19.01,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:50:19.68,0:50:22.60,Default,,0,0,0,,Сейлор Мунның денесі ғана өлді
Dialogue: 0,0:50:23.22,0:50:27.06,Default,,0,0,0,,Сейлор Сенши туралы бәрі Сейлор Кристалында.
Dialogue: 0,0:50:27.14,0:50:30.36,Default,,0,0,0,,Белгісіз хрусталь теңізші кристалы ешқашан жоғалып кетпейді!
Dialogue: 0,0:50:30.98,0:50:32.52,Default,,0,0,0,,Сондықтан Галактика
Dialogue: 0,0:50:32.61,0:50:34.86,Default,,0,0,0,,Олар теңізші кристалын көздеп отыр.
Dialogue: 0,0:50:34.94,0:50:36.40,Default,,0,0,0,,Үшеуі де!
Dialogue: 0,0:50:37.07,0:50:40.20,Default,,0,0,0,,Артық емес, бүгін үйге қайт.
Dialogue: 0,0:50:40.28,0:50:45.70,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:50:50.46,0:50:52.04,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,0:50:53.84,0:50:55.38,Default,,0,0,0,,Галактика бар.
Dialogue: 0,0:50:55.46,0:50:56.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:56.97,0:50:58.76,Default,,0,0,0,,Үлкен отты жұлдыз
Dialogue: 0,0:50:59.72,0:51:04.06,Default,,0,0,0,,Бұл галактика ма? Галактиканың орталығы?
Dialogue: 0,0:51:05.14,0:51:08.98,Default,,0,0,0,,Менің осы уақытқа дейін алған карталарым Мамо-чан емес еді.
Dialogue: 0,0:51:09.06,0:51:11.73,Default,,0,0,0,,Мұның бәрі Хошино-кун болды ма?
Dialogue: 0,0:51:11.81,0:51:13.90,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:51:13.98,0:51:16.86,Default,,0,0,0,,Шынында да османттың иісі бар еді.
Dialogue: 0,0:51:16.94,0:51:18.99,Default,,0,0,0,,Ал әлгі хош иісті зат ...
Dialogue: 0,0:51:19.07,0:51:20.99,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:51:21.78,0:51:23.24,Default,,0,0,0,,Сабаққа қатысу
Dialogue: 0,0:51:23.33,0:51:24.87,Default,,0,0,0,,- (Мұғалім) Айкава - (Айкава) Иә.
Dialogue: 0,0:51:24.95,0:51:25.99,Default,,0,0,0,,Айно
Dialogue: 0,0:51:26.62,0:51:27.58,Default,,0,0,0,,Иә? Айно
Dialogue: 0,0:51:27.66,0:51:30.79,Default,,0,0,0,,А... иә... мен кеттім.
Dialogue: 0,0:51:30.87,0:51:31.88,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:51:31.96,0:51:33.04,Default,,0,0,0,,- (Мұғалім) Иида - (Иида) Иә.
Dialogue: 0,0:51:33.84,0:51:38.47,Default,,0,0,0,,МинаП Ами-чан Мако-чан Рей-чан
Dialogue: 0,0:51:38.55,0:51:41.97,Default,,0,0,0,,Жарайды, бұл кенеттен болды, бірақ мен ауысатын студентті таныстырып жатырмын.
Dialogue: 0,0:51:42.05,0:51:45.06,Default,,0,0,0,,Нянко Сузу танысқаныма қуаныштымын
Dialogue: 0,0:51:45.72,0:51:47.22,Default,,0,0,0,,Студентті ауыстыру?
Dialogue: 0,0:51:50.89,0:51:52.31,Default,,0,0,0,,-Эй эй -Иә?
Dialogue: 0,0:51:52.40,0:51:55.02,Default,,0,0,0,,Мына тоқаш тәрізді бас өте сүйкімді!
Dialogue: 0,0:51:55.11,0:51:57.57,Default,,0,0,0,,Келесі жолы оны қалай байлау керектігін айт, Усаги-чан.
Dialogue: 0,0:51:57.65,0:51:59.15,Default,,0,0,0,,Ә? Иә.
Dialogue: 0,0:51:59.24,0:52:01.24,Default,,0,0,0,,Шулы мияу
Dialogue: 0,0:52:01.32,0:52:02.41,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:52:02.49,0:52:05.78,Default,,0,0,0,,Бұл үш адам, Үш жарық, өте танымал пұттар.
Dialogue: 0,0:52:05.87,0:52:06.91,Default,,0,0,0,,Хмм.
Dialogue: 0,0:52:06.99,0:52:07.99,Default,,0,0,0,,Эй, Сузу-сан
Dialogue: 0,0:52:08.08,0:52:10.16,Default,,0,0,0,,“Нянко” – сүйкімді есім.
Dialogue: 0,0:52:10.25,0:52:11.75,Default,,0,0,0,,-Тың! -(Студент) Гаан...
Dialogue: 0,0:52:11.83,0:52:13.12,Default,,0,0,0,,Сузу-сан…
Dialogue: 0,0:52:13.21,0:52:18.09,Default,,0,0,0,,Мен ғой, тек қыздар бір-біріне сене алады деп сенемін.
Dialogue: 0,0:52:18.17,0:52:21.09,Default,,0,0,0,,Мені «Нянко-чан» деп атаңыз
Dialogue: 0,0:52:21.17,0:52:22.97,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:52:24.89,0:52:26.47,Default,,0,0,0,,Бұл ауысатын студент
Dialogue: 0,0:52:26.56,0:52:28.97,Default,,0,0,0,,Бөтен феромондардың сізді толтыруына мүмкіндік беру
Dialogue: 0,0:52:29.60,0:52:32.23,Default,,0,0,0,,Біз де басқалардың атынан сөйлей алмаймыз.
Dialogue: 0,0:52:32.31,0:52:33.19,Default,,0,0,0,,Осы балаға не болған екен…
Dialogue: 0,0:52:33.27,0:52:34.10,Default,,0,0,0,,Иә
Dialogue: 0,0:52:34.19,0:52:35.48,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:52:48.91,0:52:50.54,Default,,0,0,0,,Мен оны сағындым
Dialogue: 0,0:52:50.62,0:52:54.08,Default,,0,0,0,,Мен тағы да осы Харон сарайына келетін күннің келетініне сене алар емеспін.
Dialogue: 0,0:52:54.79,0:52:57.50,Default,,0,0,0,,Патшайым Серенити осы күн жүйесін басқарады.
Dialogue: 0,0:52:57.59,0:53:00.17,Default,,0,0,0,,Біз туылғанда бізге берген қамал
Dialogue: 0,0:53:00.26,0:53:02.05,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:53:02.13,0:53:03.18,Default,,0,0,0,,Плутон ханшайымы
Dialogue: 0,0:53:03.26,0:53:04.72,Default,,0,0,0,,Қорғаушы Плутон
Dialogue: 0,0:53:04.80,0:53:06.05,Default,,0,0,0,,Уран ханшайымынан
Dialogue: 0,0:53:06.14,0:53:07.30,Default,,0,0,0,,Байланыс бар
Dialogue: 0,0:53:07.39,0:53:10.27,Default,,0,0,0,,Плутон, дереу қалқаныңды дайында.
Dialogue: 0,0:53:10.35,0:53:12.73,Default,,0,0,0,,Күте тұрыңыз, мен метеор деректерін тексергім келеді.
Dialogue: 0,0:53:12.81,0:53:13.94,Default,,0,0,0,,Метеор?
Dialogue: 0,0:53:14.02,0:53:16.35,Default,,0,0,0,,Жер бетінде жаңбыр жауып тұрған бұл қалыпты емес нәрсе ...
Dialogue: 0,0:53:16.44,0:53:18.61,Default,,0,0,0,,Альфа Стрелец метеорлық жауын
Dialogue: 0,0:53:18.69,0:53:23.40,Default,,0,0,0,,Барлық метеорлар күн жүйесінен қашу жылдамдығынан асып түседі.
Dialogue: 0,0:53:23.49,0:53:27.99,Default,,0,0,0,,Бұл жұлдыздардың күші біздің Күн жүйесінде табылған ештеңеге ұқсамайды.
Dialogue: 0,0:53:28.07,0:53:29.20,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:53:29.28,0:53:33.08,Default,,0,0,0,,Алыстағы жұлдыздардан шыққан жұлдыздар?
Dialogue: 0,0:53:33.16,0:53:34.37,Default,,0,0,0,,Бұл...
Dialogue: 0,0:53:34.46,0:53:37.83,Default,,0,0,0,,Ол метеориттік жауын ретінде жасырынып, Жерге кірді.
Dialogue: 0,0:53:37.92,0:53:38.96,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:53:39.04,0:53:42.34,Default,,0,0,0,,Shadow Galactica сарбаздары қайдан келеді?
Dialogue: 0,0:53:42.42,0:53:44.05,Default,,0,0,0,,Галактика
Dialogue: 0,0:53:44.13,0:53:45.22,Default,,0,0,0,,Галактикадан...
Dialogue: 0,0:53:45.30,0:53:47.22,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:53:47.30,0:53:48.22,Default,,0,0,0,,Кім?
Dialogue: 0,0:53:50.56,0:53:51.39,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:53:52.02,0:53:52.85,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:53:52.93,0:53:53.89,Default,,0,0,0,,Плутонның қамқоршысы!
Dialogue: 0,0:53:54.52,0:53:56.85,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:53:57.69,0:53:58.77,Default,,0,0,0,,Плутон!
Dialogue: 0,0:53:59.69,0:54:00.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:54:01.52,0:54:02.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:03.86,0:54:05.40,Default,,0,0,0,,Өрт сөндіруші!
Dialogue: 0,0:54:07.95,0:54:10.28,Default,,0,0,0,,«Өлім» адам ретінде
Dialogue: 0,0:54:11.53,0:54:12.54,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:54:14.16,0:54:15.58,Default,,0,0,0,,Мамо-чан?
Dialogue: 0,0:54:17.25,0:54:19.17,Default,,0,0,0,,Ами-чан Мако-чан
Dialogue: 0,0:54:20.00,0:54:22.25,Default,,0,0,0,,Рей-чан Мина П...
Dialogue: 0,0:54:23.30,0:54:25.38,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:54:25.47,0:54:27.47,Default,,0,0,0,,Тек дене жойылады
Dialogue: 0,0:54:27.55,0:54:31.60,Default,,0,0,0,,Сейлор Сенши туралы бәрі Сейлор Кристалында.
Dialogue: 0,0:54:31.68,0:54:36.10,Default,,0,0,0,,Дене біз үшін маңызды емес пе еді?
Dialogue: 0,0:54:37.19,0:54:38.52,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:54:38.60,0:54:41.98,Default,,0,0,0,,Бұдан былай бізге не болады?
Dialogue: 0,0:54:43.82,0:54:44.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:54:45.74,0:54:46.57,Default,,0,0,0,,Луна!
Dialogue: 0,0:54:46.65,0:54:48.20,Default,,0,0,0,,Бұл тым қауіпті. Соған қарамастан, шкафта жасырынғаным дұрыс
Dialogue: 0,0:54:48.28,0:54:50.82,Default,,0,0,0,,Бірақ неге мұндай жерде?
Dialogue: 0,0:54:50.91,0:54:53.41,Default,,0,0,0,,Бізбен бірдей күшке ие біреу?
Dialogue: 0,0:54:57.25,0:54:59.37,Default,,0,0,0,,Қоян! Нян
Dialogue: 0,0:54:59.46,0:55:00.54,Default,,0,0,0,,Нянко-чан
Dialogue: 0,0:55:00.63,0:55:04.75,Default,,0,0,0,,Эй, мен бүгін Усаги-чанның үйіне барғым келеді.
Dialogue: 0,0:55:04.84,0:55:07.63,Default,,0,0,0,,Торғай-чан кешкі асқа жарайды.
Dialogue: 0,0:55:07.72,0:55:08.84,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:55:08.93,0:55:10.89,Default,,0,0,0,,Луна! Артемида!
Dialogue: 0,0:55:10.97,0:55:13.64,Default,,0,0,0,,Маған шынайы болмысыңызды көрсетіңіз! Бұл құбыжық мысық!
Dialogue: 0,0:55:13.72,0:55:14.56,Default,,0,0,0,,Мияу?
Dialogue: 0,0:55:18.73,0:55:21.10,Default,,0,0,0,,Маған хош иісті зат түтіндісін берейін.
Dialogue: 0,0:55:25.23,0:55:26.40,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:55:27.94,0:55:30.82,Default,,0,0,0,,Жоқ! Жоқ, жоқ, жоқ!
Dialogue: 0,0:55:30.91,0:55:32.62,Default,,0,0,0,,- (Fireball) Жарайды - Иә?
Dialogue: 0,0:55:32.70,0:55:36.41,Default,,0,0,0,,Бұл адамдар менің қымбатты достарым.
Dialogue: 0,0:55:41.08,0:55:42.83,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:55:42.92,0:55:44.34,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:55:45.42,0:55:47.55,Default,,0,0,0,,Мен сенің осыншама жақын болғаныңа сене алар емеспін
Dialogue: 0,0:55:48.47,0:55:53.05,Default,,0,0,0,,Мен сені мәңгілік іздедім, ханшайымым.
Dialogue: 0,0:55:53.14,0:55:58.56,Default,,0,0,0,,Жұлдызды дала, атмосфера, түнгі аспан, Ақыры кездестік
Dialogue: 0,0:55:59.27,0:56:03.61,Default,,0,0,0,,Мен сенің жүрегіңдегі дауыстарды естідім
Dialogue: 0,0:56:04.69,0:56:07.57,Default,,0,0,0,,Саған келуді талай рет ойладым.
Dialogue: 0,0:56:07.65,0:56:12.66,Default,,0,0,0,,Бірақ менің денемнің қалпына келуі мен күткеннен ұзағырақ болды.
Dialogue: 0,0:56:13.37,0:56:16.70,Default,,0,0,0,,Чиби Чиби-чан маған көмектесті
Dialogue: 0,0:56:16.79,0:56:20.41,Default,,0,0,0,,Ол маған үшеуіңіз туралы да айтты.
Dialogue: 0,0:56:20.50,0:56:22.46,Default,,0,0,0,,Сондай-ақ Сейлор Мун туралы
Dialogue: 0,0:56:22.54,0:56:24.83,Default,,0,0,0,,Сіз мені әрқашан қорғадыңыз.
Dialogue: 0,0:56:24.92,0:56:26.54,Default,,0,0,0,,Сіз...
Dialogue: 0,0:56:26.63,0:56:30.38,Default,,0,0,0,,Мен сенің емдік күшіңді сезіндім
Dialogue: 0,0:56:30.47,0:56:33.30,Default,,0,0,0,,Сіз де матрос жауынгерсіз бе?
Dialogue: 0,0:56:33.39,0:56:35.01,Default,,0,0,0,,Чиби Чиби-чан
Dialogue: 0,0:56:35.10,0:56:36.30,Default,,0,0,0,,Иә
Dialogue: 0,0:56:36.39,0:56:40.81,Default,,0,0,0,,Чиби Чиби кристалдық күші! Татуласу!
Dialogue: 0,0:56:45.36,0:56:47.07,Default,,0,0,0,,Теңізші Сенши!?
Dialogue: 0,0:56:47.15,0:56:49.19,Default,,0,0,0,,Сатқын пайда болды!
Dialogue: 0,0:56:49.28,0:56:50.57,Default,,0,0,0,,Не!?
Dialogue: 0,0:56:50.65,0:56:53.95,Default,,0,0,0,,Мен құбыжық мысық болсам, сендер де...
Dialogue: 0,0:56:55.41,0:56:56.83,Default,,0,0,0,,Құбыжық мысық!
Dialogue: 0,0:56:59.37,0:57:00.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:57:00.29,0:57:02.21,Default,,0,0,0,,-Уф... -Аа!
Dialogue: 0,0:57:02.29,0:57:04.29,Default,,0,0,0,,Луна! Артемида!
Dialogue: 0,0:57:06.33,0:57:08.25,Default,,0,0,0,,Цк... қашып кетуге жол бермеймін!
Dialogue: 0,0:57:08.34,0:57:10.51,Default,,0,0,0,,Мысық! Жоқ, жау!?
Dialogue: 0,0:57:10.59,0:57:13.63,Default,,0,0,0,,Күміс айдың кристалдық күші!
Dialogue: 0,0:57:13.72,0:57:15.59,Default,,0,0,0,,Макияж!
Dialogue: 0,0:57:19.10,0:57:21.93,Default,,0,0,0,,Галактика қуыршақ!
Dialogue: 0,0:57:24.44,0:57:25.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:25.35,0:57:26.94,Default,,0,0,0,,Сейлор Мун!
Dialogue: 0,0:57:27.90,0:57:30.82,Default,,0,0,0,,Uuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuckveyy]
Dialogue: 0,0:57:30.90,0:57:32.07,Default,,0,0,0,,Ханшайым, егер кездейсоқ
Dialogue: 0,0:57:32.15,0:57:34.99,Default,,0,0,0,,Ал, өзімді таныстырып өтейін.
Dialogue: 0,0:57:35.07,0:57:37.07,Default,,0,0,0,,Мен Теңізші Тин Мысықпын
Dialogue: 0,0:57:37.16,0:57:39.91,Default,,0,0,0,,Күтілгендей! Бөтен Мау
Dialogue: 0,0:57:39.99,0:57:42.41,Default,,0,0,0,,Қасиетті Теңізші жауынгердің атын айтуға қалай батылы барады?
Dialogue: 0,0:57:42.50,0:57:46.46,Default,,0,0,0,,Мауымның жалғыз батыры, Теңізші Маудың мақтанышы
Dialogue: 0,0:57:46.54,0:57:48.17,Default,,0,0,0,,Жарақатқа әкелетін нәрсені жасау
Dialogue: 0,0:57:48.25,0:57:50.50,Default,,0,0,0,,Бейбітшілікті сүйетін Мау келімсектері
Dialogue: 0,0:57:50.59,0:57:52.92,Default,,0,0,0,,Өзіңізді белгісіз адамдарға сатасыз ба?
Dialogue: 0,0:57:53.01,0:57:54.67,Default,,0,0,0,,Мен ештеңе білмесем де
Dialogue: 0,0:57:54.76,0:57:58.85,Default,,0,0,0,,Бәрің Мау планетасын тастап кеткен сатқын емессіңдер ме?
Dialogue: 0,0:57:58.93,0:58:00.18,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:58:00.26,0:58:02.35,Default,,0,0,0,,Мау планетасы енді жоқ.
Dialogue: 0,0:58:02.43,0:58:05.10,Default,,0,0,0,,Shadow Galactica мені өлім планетасына айналдырды
Dialogue: 0,0:58:05.19,0:58:07.77,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:58:07.85,0:58:09.15,Default,,0,0,0,,Шулы!
Dialogue: 0,0:58:09.23,0:58:11.94,Default,,0,0,0,,Мен бұл шайқастан аман өтемін
Dialogue: 0,0:58:12.03,0:58:15.78,Default,,0,0,0,,Осы білезікті шешіп, түпнұсқа, мінсіз денеңізді алыңыз.
Dialogue: 0,0:58:15.86,0:58:19.49,Default,,0,0,0,,Содан кейін мен Галаксия-самадан теңізші кристалын алдым.
Dialogue: 0,0:58:19.57,0:58:21.78,Default,,0,0,0,,Нағыз теңізші жауынгер бол!
Dialogue: 0,0:58:21.87,0:58:24.29,Default,,0,0,0,,Луна мен Артемида мау бөтен адамдары ма?
Dialogue: 0,0:58:24.37,0:58:28.79,Default,,0,0,0,,Олар алыстағы туған қалаларын тастап, біз үшін Күн жүйесіне аттанды.
Dialogue: 0,0:58:29.67,0:58:30.54,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:58:30.63,0:58:32.38,Default,,0,0,0,,Біз бір планетадан болсақ та!
Dialogue: 0,0:58:32.46,0:58:33.30,Default,,0,0,0,,Диана!
Dialogue: 0,0:58:33.38,0:58:34.30,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:58:35.05,0:58:36.30,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:58:36.38,0:58:40.30,Default,,0,0,0,,Ах! Папа мама мама
Dialogue: 0,0:58:40.39,0:58:41.51,Default,,0,0,0,,Диана!
Dialogue: 0,0:58:41.60,0:58:43.10,Default,,0,0,0,,Диана!
Dialogue: 0,0:58:45.98,0:58:48.27,Default,,0,0,0,,Диана қайда?
Dialogue: 0,0:58:49.81,0:58:51.65,Default,,0,0,0,,Диана
Dialogue: 0,0:58:51.73,0:58:53.15,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:58:53.23,0:58:54.28,Default,,0,0,0,,Сөйлей алмаймын!?
Dialogue: 0,0:58:56.44,0:58:58.24,Default,,0,0,0,,Оян! Нянко-чан
Dialogue: 0,0:58:58.32,0:58:59.91,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:59:05.75,0:59:06.62,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:59:06.70,0:59:07.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:08.41,0:59:09.67,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:59:09.75,0:59:11.42,Default,,0,0,0,,Луна! Артемида!
Dialogue: 0,0:59:15.05,0:59:16.17,Default,,0,0,0,,Барлығың, берік болыңдар!
Dialogue: 0,0:59:16.26,0:59:17.72,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:59:17.80,0:59:21.09,Default,,0,0,0,,Мен әрқашан бәрін осы тағдырға сүйреймін.
Dialogue: 0,0:59:21.18,0:59:24.85,Default,,0,0,0,,Ақымақ! Мен өз бетіммен секіріп жатқаныма сене алар емеспін
Dialogue: 0,0:59:24.93,0:59:27.06,Default,,0,0,0,,Жұлдыздық күрделі ұстара!
Dialogue: 0,0:59:29.31,0:59:30.73,Default,,0,0,0,,Жұлдызды шамдар
Dialogue: 0,0:59:30.81,0:59:32.61,Default,,0,0,0,,Чиби Чиби!?
Dialogue: 0,0:59:34.15,0:59:37.11,Default,,0,0,0,,Біздің үйде әлі де тыныс бар
Dialogue: 0,0:59:43.07,0:59:44.49,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:59:46.45,0:59:47.70,Default,,0,0,0,,Мен отты шармын
Dialogue: 0,0:59:48.50,0:59:51.46,Default,,0,0,0,,Кинмоку планетасындағы Тангей патшалығының бірінші ханшайымы
Dialogue: 0,0:59:52.67,0:59:54.71,Default,,0,0,0,,Менің атым отты шар.
Dialogue: 0,0:59:54.79,0:59:58.92,Default,,0,0,0,,Бұл адамдардың дөрекілігі үшін кешірім сұраймын.
Dialogue: 0,0:59:59.01,1:00:02.47,Default,,0,0,0,,Үшеуіңіз де жұлдыздар жүйеміздің қорғаушыларысыздар.
Dialogue: 0,1:00:03.34,1:00:05.51,Default,,0,0,0,,Танысқаныма қуаныштымын Сейлор Мун
Dialogue: 0,1:00:05.60,1:00:09.48,Default,,0,0,0,,Күміс мыңжылдықтың келесі патшайымы жоқ
Dialogue: 0,1:00:09.56,1:00:11.60,Default,,0,0,0,,Жаңа Патшайым Серенити
Dialogue: 0,1:00:11.69,1:00:13.48,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,1:00:14.69,1:00:18.23,Default,,0,0,0,,Күн жүйесінің күшті және әдемі қамқоршы жауынгерлері
Dialogue: 0,1:00:18.32,1:00:21.49,Default,,0,0,0,,Галактикаға шашыраңқы матрос-жауынгерлердің арманы.
Dialogue: 0,1:00:21.57,1:00:25.53,Default,,0,0,0,,Келесі патша мен патшайымның тамашалығын көрсететін сол сәт
Dialogue: 0,1:00:25.62,1:00:27.49,Default,,0,0,0,,Сол жұлдыз сәулесінің күші
Dialogue: 0,1:00:27.58,1:00:30.71,Default,,0,0,0,,Бүкіл галактикада, уақыт пен кеңістікте таралады.
Dialogue: 0,1:00:30.79,1:00:36.13,Default,,0,0,0,,Бұл мен бұрын-соңды көрмеген күшті және ыстық күн жүйесінен келген хабар болды.
Dialogue: 0,1:00:38.76,1:00:42.38,Default,,0,0,0,,Мен сенімен әрқашан кездескім келген
Dialogue: 0,1:00:44.76,1:00:46.89,Default,,0,0,0,,Бұл адамдардың да жұлдызды тұқымдары.
Dialogue: 0,1:00:46.97,1:00:48.64,Default,,0,0,0,,Теңізші Кристал сияқты
Dialogue: 0,1:00:48.72,1:00:50.60,Default,,0,0,0,,Күш пен жарқырау
Dialogue: 0,1:00:50.68,1:00:53.31,Default,,0,0,0,,-Хехе... -(Отты шар) Аман-есен болғаныңызға қуаныштымын.
Dialogue: 0,1:00:53.39,1:00:55.36,Default,,0,0,0,,Ханшайым
Dialogue: 0,1:00:55.44,1:00:58.19,Default,,0,0,0,,Жау сөзін аяқтай алмай қашып кетті.
Dialogue: 0,1:00:58.27,1:01:01.36,Default,,0,0,0,,Тіпті жүрек те реттелмеген сияқты.
Dialogue: 0,1:01:02.15,1:01:05.82,Default,,0,0,0,,Сейлор Мун, осы галактиканы құтқарыңыз.
Dialogue: 0,1:01:06.82,1:01:11.25,Default,,0,0,0,,Қазір матрос Галаксия галактикадағы жұлдыздарға шабуыл жасайды.
Dialogue: 0,1:01:11.33,1:01:14.75,Default,,0,0,0,,Теңізші Сенши теңізшілер кристалдарын тартып алды.
Dialogue: 0,1:01:14.83,1:01:17.96,Default,,0,0,0,,Жұлдыздар бірінен соң бірі жойылды
Dialogue: 0,1:01:18.04,1:01:19.63,Default,,0,0,0,,Ал Галактика
Dialogue: 0,1:01:19.71,1:01:25.68,Default,,0,0,0,,Бірінен соң бірі атаққұмар, билігі бар жастарды шығарып, өзіне бағынышты етті.
Dialogue: 0,1:01:25.76,1:01:29.39,Default,,0,0,0,,«Көлеңке Галактика» деп аталатын империя құрылды.
Dialogue: 0,1:01:29.47,1:01:32.73,Default,,0,0,0,,Осы уақытқа дейін сізге шабуыл жасағандар
Dialogue: 0,1:01:32.81,1:01:35.85,Default,,0,0,0,,Нағыз теңізші жауынгерлердің бәрі бірдей бола бермейді.
Dialogue: 0,1:01:35.94,1:01:40.11,Default,,0,0,0,,Галаксияның білезігі басқарылады және пайдаланылады.
Dialogue: 0,1:01:40.19,1:01:41.61,Default,,0,0,0,,Тек жазықсыз адамдар
Dialogue: 0,1:01:42.28,1:01:46.53,Default,,0,0,0,,Білезік құдіретінен жаншылып, жанын қиғандар...
Dialogue: 0,1:01:47.87,1:01:50.28,Default,,0,0,0,,Галактиканың түкпір-түкпірінен келген матростар жауынгерлері
Dialogue: 0,1:01:50.37,1:01:53.66,Default,,0,0,0,,Үй планетасына шабуыл жасалды және Галаксия өз өмірін жоғалтты?
Dialogue: 0,1:01:54.71,1:01:56.67,Default,,0,0,0,,Теңізші Галаксия
Dialogue: 0,1:01:56.75,1:01:59.88,Default,,0,0,0,,Бұл жойқын жауынгер
Dialogue: 0,1:02:01.00,1:02:02.96,Default,,0,0,0,,Жұлдыз оған шабуыл жасады
Dialogue: 0,1:02:03.05,1:02:08.26,Default,,0,0,0,,Барлық тірі және жансыз адамдар жойылып, өлім жұлдызына айналады.
Dialogue: 0,1:02:08.34,1:02:11.18,Default,,0,0,0,,Ол кісі де... дәл менің алдымда...
Dialogue: 0,1:02:11.89,1:02:12.93,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,1:02:13.02,1:02:14.89,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:02:15.73,1:02:19.90,Default,,0,0,0,,Бірақ көптеген жұлдыздарға шабуыл жасаған нәрсе болды
Dialogue: 0,1:02:19.98,1:02:23.36,Default,,0,0,0,,Күн жүйесіне қалай жетуге болатыны туралы аз ғана зерттеу
Dialogue: 0,1:02:24.07,1:02:27.99,Default,,0,0,0,,Галаксияның түпкі мақсаты, әрине, сіз.
Dialogue: 0,1:02:28.66,1:02:30.95,Default,,0,0,0,,Неге мен?
Dialogue: 0,1:02:31.03,1:02:32.41,Default,,0,0,0,,Бұл...
Dialogue: 0,1:02:32.49,1:02:36.83,Default,,0,0,0,,Сізде теңізші Кристал галактикасындағы ең күшті күш бар
Dialogue: 0,1:02:36.91,1:02:39.67,Default,,0,0,0,,Өйткені мен күміс ай хрусталы бар жауынгермін
Dialogue: 0,1:02:40.46,1:02:42.50,Default,,0,0,0,,Қорқынышты әйел!
Dialogue: 0,1:02:43.30,1:02:48.22,Default,,0,0,0,,Фантомдық күміс кристалы және сіздің қатысуыңыз тарихты өзгертеді!
Dialogue: 0,1:02:49.51,1:02:51.89,Default,,0,0,0,,Барлығына мен кінәлімін
Dialogue: 0,1:02:52.60,1:02:56.35,Default,,0,0,0,,Менде бар күштің арқасында мен бәрін тартамын.
Dialogue: 0,1:02:58.06,1:03:00.23,Default,,0,0,0,,Галактика қайда орналасқан?
Dialogue: 0,1:03:01.02,1:03:04.36,Default,,0,0,0,,Менің жақын адамдарымның кристалдарын да алып кетті.
Dialogue: 0,1:03:05.03,1:03:07.82,Default,,0,0,0,,Мен досымның кристалын қайтаруым керек.
Dialogue: 0,1:03:07.90,1:03:10.99,Default,,0,0,0,,Менің кетуім керек! Галактикаға
Dialogue: 0,1:03:13.91,1:03:15.75,Default,,0,0,0,,Маған жол көрсетуге рұқсат етіңіз.
Dialogue: 0,1:03:15.83,1:03:17.21,Default,,0,0,0,,Ханшайым!
Dialogue: 0,1:03:17.29,1:03:21.58,Default,,0,0,0,,Бұл галактиканы тек сіз, Сейлор Мун, құтқара аласыз.
Dialogue: 0,1:03:24.63,1:03:29.13,Default,,0,0,0,,Галактика галактиканың орталығында орналасқан.
Dialogue: 0,1:03:29.84,1:03:35.85,Default,,0,0,0,,Ватару!
Dialogue: 0,1:03:39.06,1:03:40.14,Default,,0,0,0,,Галактикада
Dialogue: 0,1:03:40.23,1:03:43.77,Default,,0,0,0,,Осы Күн жүйесі сияқты көптеген жұлдыз жүйелері бар.
Dialogue: 0,1:03:43.86,1:03:46.82,Default,,0,0,0,,Күн жүйесі ерекше орын алады
Dialogue: 0,1:03:46.90,1:03:51.78,Default,,0,0,0,,Ешбір жұлдыз жүйесі мұндай теңдестірілген және аяқталған түрде өспеген.
Dialogue: 0,1:03:51.86,1:03:53.16,Default,,0,0,0,,Өсу?
Dialogue: 0,1:03:53.24,1:03:57.04,Default,,0,0,0,,Барлық жұлдыздар жұлдыз тұқымдарынан өседі.
Dialogue: 0,1:03:57.12,1:03:58.41,Default,,0,0,0,,Жұлдыздар ғана емес
Dialogue: 0,1:03:58.50,1:04:02.54,Default,,0,0,0,,Барлық тірі заттар жұлдыз тұқымынан өседі.
Dialogue: 0,1:04:03.17,1:04:05.25,Default,,0,0,0,,Біз, матрос Сенши, әрине...
Dialogue: 0,1:04:05.34,1:04:08.17,Default,,0,0,0,,Жұлдыз тұқымынан өскен.
Dialogue: 0,1:04:09.42,1:04:12.97,Default,,0,0,0,,Теңізші Кристал ерекше жұлдызды тұқым ретінде дүниеге келген.
Dialogue: 0,1:04:13.05,1:04:15.22,Default,,0,0,0,,Таңдалған жұлдызға ұшу
Dialogue: 0,1:04:15.30,1:04:19.77,Default,,0,0,0,,Ақырында, сіз қорғаушы жауынгер болып, сол планетаны қорғайсыз.
Dialogue: 0,1:04:20.52,1:04:24.36,Default,,0,0,0,,Ең бірінші шабуыл жасаған ғаламшар – Темір ауыз жұлдызы Шу.
Dialogue: 0,1:04:24.44,1:04:26.15,Default,,0,0,0,,Теңізші Чу
Dialogue: 0,1:04:26.23,1:04:29.03,Default,,0,0,0,,Алюминий сиренасының жұлдызы - су перісі жұлдызы
Dialogue: 0,1:04:29.11,1:04:31.11,Default,,0,0,0,,Теңізші су перісі
Dialogue: 0,1:04:31.20,1:04:34.12,Default,,0,0,0,,Теңізші Коронис - Коронис жұлдызы.
Dialogue: 0,1:04:34.20,1:04:36.95,Default,,0,0,0,,Теңізші Мау - Мау жұлдызы.
Dialogue: 0,1:04:37.03,1:04:41.37,Default,,0,0,0,,Ал Күн жүйесіндегі Меркурий теңізші Меркурий.
Dialogue: 0,1:04:41.46,1:04:44.00,Default,,0,0,0,,Венера теңізші Венера
Dialogue: 0,1:04:44.08,1:04:46.50,Default,,0,0,0,,Марс - теңізші Марс
Dialogue: 0,1:04:46.59,1:04:49.17,Default,,0,0,0,,Юпитер - теңізші Юпитер
Dialogue: 0,1:04:49.26,1:04:53.18,Default,,0,0,0,,Ал жер - мен және Мамо-чан
Dialogue: 0,1:04:58.97,1:05:00.27,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:05:08.48,1:05:11.28,Default,,0,0,0,,Жарайды, енді жыламаймын.
Dialogue: 0,1:05:12.61,1:05:15.70,Default,,0,0,0,,Галаксиямен шайқас күтіп тұр.
Dialogue: 0,1:05:15.78,1:05:18.95,Default,,0,0,0,,Сіз әрқашан...
Dialogue: 0,1:05:19.66,1:05:22.79,Default,,0,0,0,,Осындай ауыр қанаттарды арқама көтеріп жүрдім бе деп.
Dialogue: 0,1:05:26.46,1:05:27.71,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,1:05:30.46,1:05:35.59,Default,,0,0,0,,Сізді галактикада қандай шайқас күтіп тұрса да, біз сенің жаныңда сенің күшің боламыз.
Dialogue: 0,1:05:37.01,1:05:38.51,Default,,0,0,0,,Рахмет
Dialogue: 0,1:05:39.35,1:05:42.31,Default,,0,0,0,,Мен Теңізші Сенши болмасам
Dialogue: 0,1:05:42.39,1:05:45.81,Default,,0,0,0,,Осылайша достарыңыздан көмек сұрауға болады.
Dialogue: 0,1:05:45.90,1:05:48.61,Default,,0,0,0,,Екеуміз ешқашан кездеспедік пе деп ойлаймын
Dialogue: 0,1:05:48.69,1:05:51.03,Default,,0,0,0,,Белгісіз Кристалл Сейлор Кристалл
Dialogue: 0,1:05:51.11,1:05:52.32,Default,,0,0,0,,Бұл жоғалып кетпейді!
Dialogue: 0,1:05:53.36,1:05:56.16,Default,,0,0,0,,Тәнім мәңгілікке жоғалып кетпесе екен
Dialogue: 0,1:06:06.79,1:06:09.71,Default,,0,0,0,,Қайтадан туылғанымды қалаймын
Dialogue: 0,1:06:14.30,1:06:15.80,Default,,0,0,0,,Мен оны сізге жіберемін.
Dialogue: 0,1:06:15.88,1:06:17.68,Default,,0,0,0,,-Жарайды -...Боу!
Dialogue: 0,1:06:17.76,1:06:20.93,Default,,0,0,0,,Үйге бірге бара аламыз. Рақмет сізге.
Dialogue: 0,1:06:22.81,1:06:29.15,Default,,0,0,0,,Галакси Ичи, басқа статус, мүмкін жауапсыз махаббат Хошино
Dialogue: 0,1:06:33.86,1:06:36.11,Default,,0,0,0,,-Ах! -Иә? Ах!
Dialogue: 0,1:06:37.78,1:06:38.78,Default,,0,0,0,,Әткеншек!
Dialogue: 0,1:06:38.86,1:06:42.45,Default,,0,0,0,,Чиби Чиби, үйге бармасаң, мама уайымдайды.
Dialogue: 0,1:06:42.54,1:06:44.79,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,1:06:46.87,1:06:50.92,Default,,0,0,0,,Сіз біртүрлі баласыз.
Dialogue: 0,1:06:51.00,1:06:53.67,Default,,0,0,0,,Сіз маған ештеңе айтқан жоқсыз.
Dialogue: 0,1:06:54.30,1:06:59.18,Default,,0,0,0,,Бірақ мен өзімді біртүрлі сағыныш сезінемін, мен сені жек көре алмаймын деп жеңілдеп қалдым.
Dialogue: 0,1:06:59.26,1:07:01.60,Default,,0,0,0,,Чиби Чиби де теңізші жауынгер болған
Dialogue: 0,1:07:01.68,1:07:03.72,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:07:03.81,1:07:07.69,Default,,0,0,0,,Ол қайдан пайда болды? Сен кімсің?
Dialogue: 0,1:07:08.52,1:07:10.15,Default,,0,0,0,,Мен менмін
Dialogue: 0,1:07:10.23,1:07:12.15,Default,,0,0,0,,Иә? Мұнда!
Dialogue: 0,1:07:12.23,1:07:16.40,Default,,0,0,0,,Сіз мені қате түсіндіңіз. Маған дұрыс жауап беріңіз! Чиби Чиби
Dialogue: 0,1:07:18.20,1:07:19.07,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:19.82,1:07:20.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:24.95,1:07:25.87,Default,,0,0,0,,Кім?
Dialogue: 0,1:07:27.46,1:07:28.41,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:37.30,1:07:38.22,Default,,0,0,0,,Рахмет
Dialogue: 0,1:07:39.13,1:07:41.47,Default,,0,0,0,,Әрқашан достарың көп болады.
Dialogue: 0,1:07:43.05,1:07:47.18,Default,,0,0,0,,Сол ерекше матрос хрусталы мені өзіне тарта ма деп ойлаймын.
Dialogue: 0,1:07:48.68,1:07:49.52,Default,,0,0,0,,Ха!
Dialogue: 0,1:07:50.23,1:07:51.52,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:07:53.77,1:07:56.90,Default,,0,0,0,,Кім? Қандай күш...
Dialogue: 0,1:08:02.62,1:08:07.87,Default,,0,0,0,,Дауыл? Бұл күшті күш бұрынғы жаулардан ерекшеленеді!
Dialogue: 0,1:08:07.95,1:08:12.50,Default,,0,0,0,,Теңізші Галаксия - жойылу жауынгері
Dialogue: 0,1:08:12.58,1:08:13.50,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,1:08:18.51,1:08:21.09,Default,,0,0,0,,Қаланы шарпыды
Dialogue: 0,1:08:21.76,1:08:24.01,Default,,0,0,0,,Мен жалғыз өмір сүре алмаймын.
Dialogue: 0,1:08:24.09,1:08:25.85,Default,,0,0,0,,Бұрынғы жаулармен салыстыруға болмайды
Dialogue: 0,1:08:26.51,1:08:29.23,Default,,0,0,0,,Уран! Нептун! Плутон!
Dialogue: 0,1:08:29.31,1:08:33.31,Default,,0,0,0,,Жау пайда болды. Маған күш-қуатыңызды беріңізші!
Dialogue: 0,1:08:35.86,1:08:37.02,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:08:37.11,1:08:39.49,Default,,0,0,0,,Бұл галлюцинация
Dialogue: 0,1:08:39.57,1:08:41.49,Default,,0,0,0,,Үшеуіңіз аман болатыныңызға сенімдімін.
Dialogue: 0,1:08:42.28,1:08:46.53,Default,,0,0,0,,Кристалды қалпына келтіріп, барлығын бастапқы, қауіпсіз күйіне қайтарыңыз.
Dialogue: 0,1:08:47.54,1:08:52.96,Default,,0,0,0,,Біз тезірек бірігіп, осы планетаны қорғауымыз керек.
Dialogue: 0,1:08:53.62,1:08:55.29,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,1:08:56.04,1:08:56.96,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:57.04,1:09:00.21,Default,,0,0,0,,Менің серігімнің денесі шынымен қалпына келе ме?
Dialogue: 0,1:09:01.84,1:09:05.80,Default,,0,0,0,,Өйткені біз әрқашан бір боламыз
Dialogue: 0,1:09:05.89,1:09:07.18,Default,,0,0,0,,Болашаққа дейін...
Dialogue: 0,1:09:08.51,1:09:12.69,Default,,0,0,0,,Болашақ сіз шынымен «болашақ» деп білесіз бе?
Dialogue: 0,1:09:15.52,1:09:16.90,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:09:26.53,1:09:29.62,Default,,0,0,0,,Не болды? Бұл соңы ма?
Dialogue: 0,1:09:29.70,1:09:32.50,Default,,0,0,0,,Егер бұл орын алса, бұл планета ұшып кетеді.
Dialogue: 0,1:09:38.25,1:09:39.13,Default,,0,0,0,,Уф...
Dialogue: 0,1:09:51.85,1:09:53.89,Default,,0,0,0,,Сейлор Мун! Чиби Чиби!
Dialogue: 0,1:09:57.10,1:09:58.52,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,1:09:58.61,1:10:01.57,Default,,0,0,0,,Сізге шабуыл жасады ма? Жау кім?
Dialogue: 0,1:10:01.65,1:10:03.03,Default,,0,0,0,,Жоқ
Dialogue: 0,1:10:03.94,1:10:06.78,Default,,0,0,0,,Қала қалыпты жағдайға оралды
Dialogue: 0,1:10:06.86,1:10:11.49,Default,,0,0,0,,Трансформациясыз қандай қалпына келтіруші күш...
Dialogue: 0,1:10:11.58,1:10:14.62,Default,,0,0,0,,Галактикамен тең жағдайда күресе алады
Dialogue: 0,1:10:14.71,1:10:18.92,Default,,0,0,0,,Бұл күміс ай кристалының күші ме?
Dialogue: 0,1:10:24.47,1:10:27.34,Default,,0,0,0,,Жұлдыздардың қай жерде туатынын білесің бе?
Dialogue: 0,1:10:27.43,1:10:32.60,Default,,0,0,0,,Күшті жұлдыздар да, жарық та, күш те сол жерден туады.
Dialogue: 0,1:10:32.68,1:10:37.14,Default,,0,0,0,,Қайда? Бұл менің қолыма тисе, мен жұлдыздарды еркін басқара аламын дегенді білдіре ме?
Dialogue: 0,1:10:37.23,1:10:42.61,Default,,0,0,0,,Егер мен ғаламды басқара алсам, ол менікі. Бұл өмірмен қош бол.
Dialogue: 0,1:10:42.69,1:10:43.57,Default,,0,0,0,,Әй?
Dialogue: 0,1:10:44.74,1:10:48.41,Default,,0,0,0,,Қоқыс өлгенше арамза болып қалады.
Dialogue: 0,1:10:50.95,1:10:53.24,Default,,0,0,0,,Қайда барсам да, қоқыс болады
Dialogue: 0,1:10:53.33,1:10:55.29,Default,,0,0,0,,Жұлдызшаларды ғана қоқысқа тастаңыз
Dialogue: 0,1:10:55.37,1:10:57.79,Default,,0,0,0,,Бұл да менің планетам емес еді.
Dialogue: 0,1:10:59.50,1:11:01.79,Default,,0,0,0,,Менің бұл құдіретім мол
Dialogue: 0,1:11:03.92,1:11:06.80,Default,,0,0,0,,Мен Құдайдың таңдаған адамымын
Dialogue: 0,1:11:09.30,1:11:11.35,Default,,0,0,0,,Бір жерде болуы керек
Dialogue: 0,1:11:11.43,1:11:14.14,Default,,0,0,0,,Маған көбірек күш беріңіз -
Dialogue: 0,1:11:14.22,1:11:18.56,Default,,0,0,0,,Маған лайық жарқыраған жұлдыз
Dialogue: 0,1:11:18.64,1:11:20.56,Default,,0,0,0,,Жұлдыздар қай жерде туады?
Dialogue: 0,1:11:20.65,1:11:22.82,Default,,0,0,0,,О, мен білемін.
Dialogue: 0,1:11:22.90,1:11:24.86,Default,,0,0,0,,Галактика үйі
Dialogue: 0,1:11:24.94,1:11:29.36,Default,,0,0,0,,Жұлдыздардың тұқымдары бұлақ болып шығатын жер
Dialogue: 0,1:11:29.45,1:11:35.33,Default,,0,0,0,,Стрелец Нөл жұлдыз Бұл галактиканың орталығы
Dialogue: 0,1:11:36.54,1:11:41.33,Default,,0,0,0,,Келіңдер, қымбатты балаларым.
Dialogue: 0,1:11:41.42,1:11:46.88,Default,,0,0,0,,Мен саған сен іздеген нағыз жұлдыздың қай жерде орналасқанын көрсетемін.
Dialogue: 0,1:11:46.96,1:11:49.72,Default,,0,0,0,,Бұл хаос бәрі
Dialogue: 0,1:11:49.80,1:11:50.72,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:54.68,1:11:55.76,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,1:11:58.43,1:12:02.23,Default,,0,0,0,,Мен жер іздеп қаңғып жүрген кезім
Dialogue: 0,1:12:02.31,1:12:03.86,Default,,0,0,0,,Бұл қызықсыз түс пе?
Dialogue: 0,1:12:05.02,1:12:08.07,Default,,0,0,0,,Жақында Сейлор Мун осында болады
Dialogue: 0,1:12:08.15,1:12:11.66,Default,,0,0,0,,Мені Хаос шақырғандай.
Dialogue: 0,1:12:12.36,1:12:14.83,Default,,0,0,0,,Тез кел Сейлор Мун
Dialogue: 0,1:12:14.91,1:12:18.50,Default,,0,0,0,,Сенің және менің шынайы күшімді босату үшін
Dialogue: 0,1:12:18.58,1:12:20.16,Default,,0,0,0,,Құрметті Галактика
Dialogue: 0,1:12:20.25,1:12:22.75,Default,,0,0,0,,Тинянконың жандануы
Dialogue: 0,1:12:23.75,1:12:26.67,Default,,0,0,0,,Кешіріңіз, Галаксия-сама.
Dialogue: 0,1:12:26.75,1:12:30.59,Default,,0,0,0,,Тағы бір рет! Тағы бір мүмкіндік!
Dialogue: 0,1:12:31.22,1:12:33.89,Default,,0,0,0,,Ұят болып қайттың ба?
Dialogue: 0,1:12:33.97,1:12:34.85,Default,,0,0,0,,Ха!
Dialogue: 0,1:12:34.93,1:12:37.85,Default,,0,0,0,,Қоқыс жұлдыз бола алмайды
Dialogue: 0,1:12:37.93,1:12:39.48,Default,,0,0,0,,Құрметті Галактика!
Dialogue: 0,1:12:51.53,1:12:53.74,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:12:56.87,1:12:58.33,Default,,0,0,0,,Судың дыбысы?
Dialogue: 0,1:12:59.20,1:13:03.04,Default,,0,0,0,,Бұл Стрелец нөл жұлдызының галактика қазаны
Dialogue: 0,1:13:06.29,1:13:08.21,Default,,0,0,0,,Сіздің зиратыңыз
Dialogue: 0,1:13:08.30,1:13:10.42,Default,,0,0,0,,- Ха! -Қоян
Dialogue: 0,1:13:15.97,1:13:18.64,Default,,0,0,0,,Мен оған сүйреп апарады деп ойладым.
Dialogue: 0,1:13:18.72,1:13:21.02,Default,,0,0,0,,Сол қараңғы санаға
Dialogue: 0,1:13:21.93,1:13:25.69,Default,,0,0,0,,Галактика қазаны Бұл не?
Dialogue: 0,1:13:27.36,1:13:31.69,Default,,0,0,0,,Ах... Чиби Чиби, сен маған көмектестің.
Dialogue: 0,1:13:32.86,1:13:34.95,Default,,0,0,0,,Мен мұны әрқашан сезіндім
Dialogue: 0,1:13:35.03,1:13:38.45,Default,,0,0,0,,Қолымды тартатын жұмсақ әрі жылы қол
Dialogue: 0,1:13:38.53,1:13:40.91,Default,,0,0,0,,Рахмет Чиби Чиби
Dialogue: 0,1:13:40.99,1:13:44.25,Default,,0,0,0,,Ол шынымен де жұмбақ және сенімді бала.
Dialogue: 0,1:13:44.33,1:13:46.71,Default,,0,0,0,,Теңізші Сенши болғандықтан ба?
Dialogue: 0,1:13:47.63,1:13:49.21,Default,,0,0,0,,Біз доспыз ба?
Dialogue: 0,1:13:50.30,1:13:51.38,Default,,0,0,0,,Чиби Чиби
Dialogue: 0,1:13:51.46,1:13:54.97,Default,,0,0,0,,Барлығы мені болашақтан маған көмектесу үшін жіберді
Dialogue: 0,1:13:55.05,1:13:56.51,Default,,0,0,0,,Мүмкін періште
Dialogue: 0,1:13:58.14,1:13:58.97,Default,,0,0,0,,Иә
Dialogue: 0,1:13:59.93,1:14:03.85,Default,,0,0,0,,Мен оянсам, достарым үнемі маған қарап тұрады.
Dialogue: 0,1:14:03.93,1:14:05.60,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,1:14:05.69,1:14:07.19,Default,,0,0,0,,Кез келген уақытта
Dialogue: 0,1:14:07.27,1:14:10.90,Default,,0,0,0,,Менің достарым мені өмірлерімен қорғайды.
Dialogue: 0,1:14:10.98,1:14:12.28,Default,,0,0,0,,Тіпті егер солай болса да
Dialogue: 0,1:14:12.36,1:14:14.49,Default,,0,0,0,,Менде күміс ай кристалы бар
Dialogue: 0,1:14:14.57,1:14:16.86,Default,,0,0,0,,Жауынгер болғандықтан болса да
Dialogue: 0,1:14:16.95,1:14:18.62,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,1:14:19.28,1:14:23.33,Default,,0,0,0,,«Мен» қандай болса да, бәрібір мен екенін мойындауым керек.
Dialogue: 0,1:14:23.41,1:14:27.88,Default,,0,0,0,,Мен «мен» болғандықтан ғана мен істей алатын нәрселер бар.
Dialogue: 0,1:14:28.71,1:14:29.75,Default,,0,0,0,,Біз
Dialogue: 0,1:14:29.84,1:14:33.38,Default,,0,0,0,,Теңізші Кристал құндылығы бар жалғыз нәрсе емес.
Dialogue: 0,1:14:33.46,1:14:35.51,Default,,0,0,0,,Бұл дене де «біз».
Dialogue: 0,1:14:36.13,1:14:40.68,Default,,0,0,0,,Біздің денеміз бір-біріне қарап, бір-бірін шақырады, қол ұстайды.
Dialogue: 0,1:14:40.76,1:14:42.72,Default,,0,0,0,,Қуат күшейе ме?
Dialogue: 0,1:14:43.56,1:14:45.14,Default,,0,0,0,,Менде бұл дене бар
Dialogue: 0,1:14:45.23,1:14:47.94,Default,,0,0,0,,Алғаш рет біздің билік біртұтас бола алады.
Dialogue: 0,1:14:49.06,1:14:51.19,Default,,0,0,0,,Бұл Сейлор Сенши
Dialogue: 0,1:14:52.15,1:14:55.32,Default,,0,0,0,,Менің серігімнің денесі шынымен қалпына келе ме?
Dialogue: 0,1:14:55.40,1:14:58.91,Default,,0,0,0,,Сіз білетін болашақ шынымен келе ме?
Dialogue: 0,1:14:59.57,1:15:00.57,Default,,0,0,0,,Ха...
Dialogue: 0,1:15:01.74,1:15:05.12,Default,,0,0,0,,Мен бәрінің өлмегеніне сенемін.
Dialogue: 0,1:15:05.20,1:15:08.67,Default,,0,0,0,,Біздің болашағымыз міндетті түрде келеді.
Dialogue: 0,1:15:08.75,1:15:13.67,Default,,0,0,0,,Мен тыныштықты қалпына келтіру үшін қолымдағының бәрін пайдаланамын.
Dialogue: 0,1:15:14.42,1:15:15.42,Default,,0,0,0,,Майюри сол жарыққа тартылып бара жатқандай болды
Dialogue: 0,1:15:16.42,1:15:22.35,Default,,0,0,0,,Теңізші Галаксия, сіз кімсіз? Бұл ұрысты не үшін бастадыңыз?
Dialogue: 0,1:15:25.10,1:15:27.68,Default,,0,0,0,,Мен тезірек баруым керек.
Dialogue: 0,1:15:28.39,1:15:30.69,Default,,0,0,0,,Галактикаға
Dialogue: 0,1:15:32.36,1:15:35.98,Default,,0,0,0,,Айдың гүлі, желге мін
Dialogue: 0,1:15:36.07,1:15:39.66,Default,,0,0,0,,Мен бұл сезімнің сізге жеткізілгенін қалаймын
Dialogue: 0,1:15:39.74,1:15:43.37,Default,,0,0,0,,Айдың гүлдері Күлгін
Dialogue: 0,1:15:43.45,1:15:47.37,Default,,0,0,0,,Түнде террасада ант ішу
Dialogue: 0,1:16:05.68,1:16:12.69,Default,,0,0,0,,Тәтті сөздер көп, бірақ
Dialogue: 0,1:16:12.77,1:16:19.78,Default,,0,0,0,,«Баласың ғой» дейсің.
Dialogue: 0,1:16:19.86,1:16:23.78,Default,,0,0,0,,Қате жаса немесе түсінгендей кейіп таныт
Dialogue: 0,1:16:23.87,1:16:27.45,Default,,0,0,0,,Мен жараланғанда көз жасымды төгемін
Dialogue: 0,1:16:27.54,1:16:31.37,Default,,0,0,0,,Енді тоқтаған дұрыс
Dialogue: 0,1:16:31.46,1:16:35.04,Default,,0,0,0,,Бейбітшілік қоңырауын қайта соқайық
Dialogue: 0,1:16:35.13,1:16:38.76,Default,,0,0,0,,Айдың гүлі, желмен билейді
Dialogue: 0,1:16:38.84,1:16:42.43,Default,,0,0,0,,Осы тілегімнің орындалғанын қалаймын.
Dialogue: 0,1:16:42.51,1:16:46.14,Default,,0,0,0,,Айдың гүлдері Күлгін
Dialogue: 0,1:16:46.22,1:16:49.85,Default,,0,0,0,,Қараңғылықты нұрландырып, гүлдейді
Dialogue: 0,1:16:49.93,1:16:53.56,Default,,0,0,0,,Мен және сен
Dialogue: 0,1:16:53.65,1:16:57.27,Default,,0,0,0,,Қайта туылатын жер
Dialogue: 0,1:16:57.36,1:17:03.11,Default,,0,0,0,,Менің болашағымды айт
Dialogue: 0,1:17:15.79,1:17:18.00,Default,,0,0,0,,Менде жоқ нәрсені сұрап жүргенімді білдім.
Dialogue: 0,1:17:18.09,1:17:21.72,Default,,0,0,0,,Бірақ қазір менің маңызды достарым мен жақындарым бар.
Dialogue: 0,1:17:21.80,1:17:24.89,Default,,0,0,0,,Сондықтан мен енді берілмеймін
Dialogue: 0,1:17:24.97,1:17:26.76,Default,,0,0,0,,Мен оны барлығымен бірге көргім келеді, өйткені болашақ бар
Dialogue: 0,1:17:26.85,1:17:29.77,Default,,0,0,0,,Енді бірге барайық...
Dialogue: 0,1:17:47.16,1:17:54.16,Default,,0,0,0,,Аян сияқты арман оқиғасы
Dialogue: 0,1:17:54.25,1:18:01.25,Default,,0,0,0,,Бұл шындық болғандықтан, ауырсыну бүршік жарады
Dialogue: 0,1:18:01.34,1:18:05.30,Default,,0,0,0,,Тіпті тағдырды өзгертуге болады
Dialogue: 0,1:18:05.38,1:18:08.97,Default,,0,0,0,,Махаббат менің жүрегімде
Dialogue: 0,1:18:09.05,1:18:12.89,Default,,0,0,0,,Тіпті негізсіз сенім
Dialogue: 0,1:18:12.97,1:18:17.02,Default,,0,0,0,,Енді гауһар жарқырап тұр
Dialogue: 0,1:18:18.52,1:18:22.11,Default,,0,0,0,,Айдың гүлі, желге мін
Dialogue: 0,1:18:22.19,1:18:25.82,Default,,0,0,0,,Мен бұл сезімнің сізге жеткізілгенін қалаймын
Dialogue: 0,1:18:25.90,1:18:29.53,Default,,0,0,0,,Айдың гүлдері Күлгін
Dialogue: 0,1:18:29.62,1:18:33.16,Default,,0,0,0,,Түнде террасада ант ішу
Dialogue: 0,1:18:33.25,1:18:36.92,Default,,0,0,0,,Айдың гүлі, желмен билейді
Dialogue: 0,1:18:37.00,1:18:40.59,Default,,0,0,0,,Осы тілегімнің орындалғанын қалаймын.
Dialogue: 0,1:18:40.67,1:18:44.26,Default,,0,0,0,,Айдың гүлдері Күлгін
Dialogue: 0,1:18:44.34,1:18:47.97,Default,,0,0,0,,Қараңғылықты нұрландырып, гүлдейді
Dialogue: 0,1:18:48.05,1:18:51.68,Default,,0,0,0,,Мен және сен
Dialogue: 0,1:18:51.76,1:18:55.31,Default,,0,0,0,,Қайта туылатын жер
Dialogue: 0,1:18:55.39,1:18:59.02,Default,,0,0,0,,Реинкарнация ғаламы
Dialogue: 0,1:18:59.10,1:19:05.24,Default,,0,0,0,,LetMeKnowMyNewFuture
Dialogue: 0,1:19:30.05,1:19:32.51,Default,,0,0,0,,Тез кел Сейлор Мун
Dialogue: 0,1:19:33.14,1:19:35.64,Default,,0,0,0,,Мені одан сайын қаттырақ ұр
Dialogue: 0,1:19:35.72,1:19:37.89,Default,,0,0,0,,Мен сенен көбірек аламын.
Dialogue: 0,1:19:38.89,1:19:42.36,Default,,0,0,0,,Ал сенің соңғы бөлігің қалды
Dialogue: 0,1:19:43.61,1:19:46.36,Default,,0,0,0,,Мен сізге шындықты айтайын
Dialogue: 0,1:19:47.86,1:19:53.86,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory