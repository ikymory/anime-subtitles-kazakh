Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.57,0:00:43.75,Default,,0,0,0,,Жақсы сезіледі, тезірек кел.
Dialogue: 0,0:00:44.85,0:00:47.01,Default,,0,0,0,,Қараңдар, мен сені шақырып жатырмын.
Dialogue: 0,0:00:47.01,0:00:48.02,Default,,0,0,0,,Мен емес
Dialogue: 0,0:00:48.02,0:00:51.11,Default,,0,0,0,,Бұл сенсің. Қарашы, мен саған қарап тұрмын.
Dialogue: 0,0:00:51.11,0:00:52.42,Default,,0,0,0,,Қараңыз, міне осы ғой?
Dialogue: 0,0:00:56.78,0:00:59.07,Default,,0,0,0,,Ах~ мен өзімнен оздым.
Dialogue: 0,0:00:59.07,0:01:00.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:01.46,0:01:02.55,Default,,0,0,0,,Жеңіл
Dialogue: 0,0:01:02.55,0:01:03.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:03.31,0:01:06.83,Default,,0,0,0,,Бұл қорқыныш сезімі күңгірт адамдар ойнайтын ойын.
Dialogue: 0,0:01:07.43,0:01:10.58,Default,,0,0,0,,Секірсең де ештеңе өзгермейді.
Dialogue: 0,0:01:11.23,0:01:12.74,Default,,0,0,0,,Иә, мен мұндайды жасамаймын...
Dialogue: 0,0:01:12.74,0:01:13.84,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,0:01:17.93,0:01:18.72,Default,,0,0,0,,Яббе
Dialogue: 0,0:01:18.72,0:01:19.59,Default,,0,0,0,,Гааах!
Dialogue: 0,0:01:19.59,0:01:20.24,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:01:20.24,0:01:21.30,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:38.33,0:01:39.61,Default,,0,0,0,,Мен жай ғана жеңіске жету мақсатымен келдім—
Dialogue: 0,0:01:39.61,0:01:42.56,Default,,0,0,0,,Түпнұсқа дүние... солай емес пе?
Dialogue: 0,0:01:42.56,0:01:43.87,Default,,0,0,0,,Енді үйге бара аласың ба?
Dialogue: 0,0:01:48.04,0:01:51.38,Default,,0,0,0,,Уау, сен жан-жақты талантсың.
Dialogue: 0,0:01:51.38,0:01:52.88,Default,,0,0,0,,Онша емес.
Dialogue: 0,0:01:53.36,0:01:57.38,Default,,0,0,0,,Бұл жай ғана ыңғайлы, оның әлемді өзгертуге күші жоқ.
Dialogue: 0,0:01:57.97,0:01:59.01,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:02:00.04,0:02:03.10,Default,,0,0,0,,Бірақ бұл шын мәнінде әділетсіз дүние, солай емес пе?
Dialogue: 0,0:02:03.10,0:02:06.65,Default,,0,0,0,,Бұл аралда өтемақы қажет етпейтін адамдар бар сияқты.
Dialogue: 0,0:02:06.65,0:02:10.92,Default,,0,0,0,,«Осы дүниеден» таңдалып, артықшылық берілгендер бар екені рас.
Dialogue: 0,0:02:11.80,0:02:13.18,Default,,0,0,0,,Жоспар орындалып жатыр ма?
Dialogue: 0,0:02:13.18,0:02:17.45,Default,,0,0,0,,Ой... Әй, кесектер орнына түсе бастады.
Dialogue: 0,0:02:17.45,0:02:19.96,Default,,0,0,0,,Мен ненің маңызды екенін әлі білмеймін.
Dialogue: 0,0:02:19.96,0:02:20.91,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:02:21.60,0:02:24.91,Default,,0,0,0,,Құтқарушы бір күні пайда болуы керек.
Dialogue: 0,0:02:29.20,0:02:31.28,Default,,0,0,0,,Хмм, дәмді!
Dialogue: 0,0:02:31.28,0:02:33.28,Default,,0,0,0,,Ащы екен, эй, су ал.
Dialogue: 0,0:02:33.28,0:02:37.01,Default,,0,0,0,,Ал, егер менде мұндай қабілет болса, мен қазірдің өзінде үйге бара алмаймын ба?
Dialogue: 0,0:02:37.01,0:02:39.17,Default,,0,0,0,,Бір сәт үйге қайтуға мүмкіндік болды.
Dialogue: 0,0:02:39.68,0:02:42.30,Default,,0,0,0,,Бірақ бұл менің күшім ме, білмеймін.
Dialogue: 0,0:02:42.30,0:02:45.05,Default,,0,0,0,,Бұл жауапсыздық.
Dialogue: 0,0:02:45.05,0:02:47.06,Default,,0,0,0,,Сіз мұны істедіңіз, солай ма? Бұл
Dialogue: 0,0:02:47.06,0:02:48.55,Default,,0,0,0,,«Бұзу» дегенді қалай түсінесіңдер?
Dialogue: 0,0:02:50.55,0:02:53.44,Default,,0,0,0,,Сіз бұл Радждхани дедіңіз. Келіңіздер, көріңіздер.
Dialogue: 0,0:02:54.45,0:02:56.40,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:02:56.40,0:02:59.05,Default,,0,0,0,,Мен тіпті ештеңе істеп жатқанымды сезбеймін.
Dialogue: 0,0:02:59.05,0:03:02.40,Default,,0,0,0,,Ха, сен шынымен де пайдасызсың.
Dialogue: 0,0:03:02.40,0:03:05.76,Default,,0,0,0,,Бәрінің басына бәле бар, түзу ал, маскүнем.
Dialogue: 0,0:03:08.27,0:03:11.29,Default,,0,0,0,,Бірақ бұл шынымен де түпнұсқа дүние ме?
Dialogue: 0,0:03:11.29,0:03:13.00,Default,,0,0,0,,Хмм, мен білмеймін.
Dialogue: 0,0:03:13.38,0:03:15.60,Default,,0,0,0,,Бұл шын мәнінде «жеңіл» емес еді.
Dialogue: 0,0:03:16.61,0:03:18.63,Default,,0,0,0,,Мен Радждханиден ертең оны қарап шығуын өтінемін бе?
Dialogue: 0,0:03:20.11,0:03:21.13,Default,,0,0,0,,Әлгі маймыл...
Dialogue: 0,0:03:21.45,0:03:22.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:22.19,0:03:23.04,Default,,0,0,0,,Барлық мектеп оқушылары, кітаптан жалыққан
Dialogue: 0,0:03:23.75,0:03:25.64,Default,,0,0,0,,Әй, бәрі кешкі асқа келеді ме?
Dialogue: 0,0:03:25.64,0:03:26.32,Default,,0,0,0,,Tsk
Dialogue: 0,0:03:37.44,0:03:39.28,Default,,0,0,0,,Ол әлі ашулы.
Dialogue: 0,0:03:39.65,0:03:43.07,Default,,0,0,0,,Кешірім сұраймын, бірақ мен үшін сені кешіру қиын.
Dialogue: 0,0:03:44.16,0:03:45.53,Default,,0,0,0,,Бұл бала.
Dialogue: 0,0:03:47.95,0:03:50.56,Default,,0,0,0,,Мұны әкелу капканың міндеті ме?
Dialogue: 0,0:03:50.56,0:03:53.29,Default,,0,0,0,,Сіз өзіңіздің қабілеттеріңізді пайдалана білдіңіз. Бұл не?
Dialogue: 0,0:03:53.69,0:03:57.40,Default,,0,0,0,,Жоқ, бұл... бұл үлкен қабілет емес.
Dialogue: 0,0:03:57.40,0:04:00.26,Default,,0,0,0,,Иә, білудің қажеті жоқ.
Dialogue: 0,0:04:00.26,0:04:01.30,Default,,0,0,0,,Иә, Нагара
Dialogue: 0,0:04:01.30,0:04:04.12,Default,,0,0,0,,Бір кезде тағы бірге бейсбол ойнаймыз ба?
Dialogue: 0,0:04:04.12,0:04:06.78,Default,,0,0,0,,Е, кенет не болды?
Dialogue: 0,0:04:06.78,0:04:09.44,Default,,0,0,0,,Оқта-текте жаттығу жасамасаң, жаның пысып қалады.
Dialogue: 0,0:04:09.44,0:04:11.16,Default,,0,0,0,,Эй, менімен жүр.
Dialogue: 0,0:04:11.16,0:04:13.82,Default,,0,0,0,,Я, таң қаларлықтай бұл бейсбол клубы болды.
Dialogue: 0,0:04:13.82,0:04:15.06,Default,,0,0,0,,есімде жоқ.
Dialogue: 0,0:04:15.06,0:04:17.89,Default,,0,0,0,,Ақымақ! Мен оны ешқашан ұмытпаймын!
Dialogue: 0,0:04:17.89,0:04:21.91,Default,,0,0,0,,Литлдің соңғы турнирі, мен сенің қатарынан үш қателігің үшін жеңілдім.
Dialogue: 0,0:04:21.91,0:04:23.80,Default,,0,0,0,,Сонымен... солай ма?
Dialogue: 0,0:04:23.80,0:04:26.20,Default,,0,0,0,,Онсыз біз бүкіл елді нысанаға алар едік.
Dialogue: 0,0:04:26.63,0:04:27.85,Default,,0,0,0,,Иә
Dialogue: 0,0:04:28.45,0:04:30.36,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,0:04:31.96,0:04:35.00,Default,,0,0,0,,Эйс бар, солай ма? Онымен мұны істеу керек, солай ма?
Dialogue: 0,0:04:35.00,0:04:38.62,Default,,0,0,0,,Амал жоқ, мүмкін емес Сіз оның жаттығуды жек көретінін білесіз бе?
Dialogue: 0,0:04:38.62,0:04:41.94,Default,,0,0,0,,Жақында ол қызды алды, сондықтан ол бос емес.
Dialogue: 0,0:04:41.94,0:04:43.46,Default,,0,0,0,,О, анау әйел.
Dialogue: 0,0:04:44.15,0:04:46.72,Default,,0,0,0,,Танымал болған жақсы
Dialogue: 0,0:04:47.09,0:04:49.97,Default,,0,0,0,,Иә, Эйстің қабілеттері туралы бірдеңе білесіз бе?
Dialogue: 0,0:04:49.97,0:04:51.34,Default,,0,0,0,,Оны қолданба — нағыз атыңды айт.
Dialogue: 0,0:04:51.34,0:04:52.13,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:52.13,0:04:54.19,Default,,0,0,0,,Су дәмді.
Dialogue: 0,0:04:54.19,0:04:55.86,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:04:55.86,0:04:56.98,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:04:56.98,0:05:01.41,Default,,0,0,0,,Судың кез келген түрін дәмді етіп ішуге болатыны таң қалдырады.
Dialogue: 0,0:05:01.41,0:05:06.24,Default,,0,0,0,,Мен лайлы су ішіп, көңілім түсіп кеткені сонша.
Dialogue: 0,0:05:06.24,0:05:10.37,Default,,0,0,0,,Эй, егер жаттығуға баратын болсаң, бейсбол ойнайтын жер бар ма?
Dialogue: 0,0:05:10.37,0:05:14.39,Default,,0,0,0,,Шындығында, олар дәл осы жерден бейсбол алаңын салған.
Dialogue: 0,0:05:14.39,0:05:15.81,Default,,0,0,0,,Эй, сен бе?
Dialogue: 0,0:05:15.81,0:05:16.77,Default,,0,0,0,,О
Dialogue: 0,0:05:16.77,0:05:18.00,Default,,0,0,0,,Ха? Эээ!
Dialogue: 0,0:05:26.63,0:05:29.13,Default,,0,0,0,,Иә? не? Маймыл?
Dialogue: 0,0:05:33.92,0:05:35.68,Default,,0,0,0,,Бұл керемет, ауысатын студент!
Dialogue: 0,0:05:35.68,0:05:36.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:36.14,0:05:39.23,Default,,0,0,0,,«Рок монстры» сол стероидтерден асып түсті!
Dialogue: 0,0:05:39.52,0:05:40.98,Default,,0,0,0,,Иә? Бұл кім?
Dialogue: 0,0:05:40.98,0:05:42.91,Default,,0,0,0,,Бұл стероидты маймыл!
Dialogue: 0,0:05:42.91,0:05:46.08,Default,,0,0,0,,Маймыл лигасының үй-рейс рекордын 8 рет жаңартты!
Dialogue: 0,0:05:46.08,0:05:48.11,Default,,0,0,0,,No. Маймылдар лигасы дегеніміз не?
Dialogue: 0,0:05:48.11,0:05:50.54,Default,,0,0,0,,Иә? Сіз білмейсіз бе?
Dialogue: 0,0:05:50.54,0:05:55.64,Default,,0,0,0,,А, түсіндім... Көрмедім, кешіріңіз, кешіріңіз.
Dialogue: 0,0:05:58.56,0:05:59.98,Default,,0,0,0,,Маймылдар лигасы…
Dialogue: 0,0:06:00.41,0:06:03.35,Default,,0,0,0,,Бұл «осы әлем» Маймыл тауы
Dialogue: 0,0:06:03.35,0:06:06.63,Default,,0,0,0,,Доп пен доп Бейсбол ережесі қайта қарала бастады.
Dialogue: 0,0:06:06.63,0:06:09.51,Default,,0,0,0,,Бұл ұлы маймылдардың бейсбол лигасы.
Dialogue: 0,0:06:10.59,0:06:16.24,Default,,0,0,0,,Маймылдар лигасында бәрі бірдей көрінетін және бірдей көрінетін аты жоқ маймылдардың арасында,
Dialogue: 0,0:06:16.24,0:06:18.69,Default,,0,0,0,,Көптеген атақты спортшылар дүниеге келді
Dialogue: 0,0:06:18.69,0:06:22.80,Default,,0,0,0,,Үйден жүгіруден бұрын-соңды болмаған рекорд – бір жылда 80 үй жүгірісін құрады
Dialogue: 0,0:06:22.80,0:06:25.85,Default,,0,0,0,,Аңызға айналған «Үй рейтингі» стероидты маймыл
Dialogue: 0,0:06:25.85,0:06:30.47,Default,,0,0,0,,Оның жалпы соққының орташа көрсеткіші «соғу құдайы» Маймыл өзенінен 2 ринге асып түседі.
Dialogue: 0,0:06:30.47,0:06:33.60,Default,,0,0,0,,«Ғажайып соғу машинасы» Жоғарғы маймыл
Dialogue: 0,0:06:33.60,0:06:37.11,Default,,0,0,0,,Маймыл мырза, тарихтағы ең күшті Bigfoot аулаушы
Dialogue: 0,0:06:37.11,0:06:40.90,Default,,0,0,0,,Кейінірек ол менеджер ретінде көптеген лига чемпионаттарының рекордын жаңартты.
Dialogue: 0,0:06:40.90,0:06:43.42,Default,,0,0,0,,Аңызға айналған V10-ға қол жеткізіңіз!
Dialogue: 0,0:06:43.69,0:06:46.42,Default,,0,0,0,,Содан кейін М лигасының алтын ғасыры болды.
Dialogue: 0,0:06:46.42,0:06:50.06,Default,,0,0,0,,Бұрынғы аңыздарды бірінен соң бірін бұзатын ғажайып маймыл.
Dialogue: 0,0:06:50.06,0:06:52.58,Default,,0,0,0,,«Құбыжық» көк маймыл пайда болады.
Dialogue: 0,0:06:52.58,0:06:55.46,Default,,0,0,0,,Лигадағы көгілдір жүнді жалғыз төбет.
Dialogue: 0,0:06:55.46,0:06:58.62,Default,,0,0,0,,Қатты кемсітушілік пен айлакер қуғын-сүргінге ұшырағанына қарамастан
Dialogue: 0,0:06:58.62,0:07:02.30,Default,,0,0,0,,Оны өзінің асқан талантымен жеңіп, ақыры батыр атанды.
Dialogue: 0,0:07:02.30,0:07:04.94,Default,,0,0,0,,Маймылдар үшін үміт символы бол!
Dialogue: 0,0:07:05.38,0:07:08.48,Default,,0,0,0,,«Патша».
Dialogue: 0,0:07:08.48,0:07:11.28,Default,,0,0,0,,Жарқанатты да, жүректі де бұзады, зейнетке шығуға мәжбүр етеді
Dialogue: 0,0:07:11.28,0:07:15.23,Default,,0,0,0,,Ал күшті қолымен ол әлсіз «Маймыл және клуб» командасын басқарды.
Dialogue: 0,0:07:15.23,0:07:18.06,Default,,0,0,0,,«Үлкен аяқты» тоқтату V11
Dialogue: 0,0:07:18.06,0:07:22.07,Default,,0,0,0,,Халық жаңа пальто түсін қабылдайды және Маймыл көк дәуірі басталады.
Dialogue: 0,0:07:22.07,0:07:24.96,Default,,0,0,0,,Бұған ешкім күмәнданбады, бірақ...
Dialogue: 0,0:07:24.96,0:07:31.34,Default,,0,0,0,,Бұл трагедия, тамаша ойын әрекеті, «маймылды өлтіру оқиғасы» орын алады!
Dialogue: 0,0:07:31.62,0:07:33.80,Default,,0,0,0,,Көргім келеді Маймылдарды көргім келеді!
Dialogue: 0,0:07:33.80,0:07:35.47,Default,,0,0,0,,Иә? Осылайша?
Dialogue: 0,0:07:35.47,0:07:37.16,Default,,0,0,0,,Менің де маймылдарды көргім келеді!
Dialogue: 0,0:07:37.16,0:07:38.88,Default,,0,0,0,,Дұрыс! Бұл маймыл! Бұл маймыл!
Dialogue: 0,0:07:38.88,0:07:39.81,Default,,0,0,0,,Мен маймыл ұстағым келеді!
Dialogue: 0,0:07:40.16,0:07:41.28,Default,,0,0,0,,Оны қайдан көруге болады?
Dialogue: 0,0:07:43.44,0:07:44.31,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:07:44.63,0:07:46.12,Default,,0,0,0,,А? қайда?
Dialogue: 0,0:07:46.12,0:07:47.54,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:07:47.54,0:07:49.34,Default,,0,0,0,,Эй, осында ма?
Dialogue: 0,0:07:49.34,0:07:49.94,Default,,0,0,0,,Иә
Dialogue: 0,0:07:50.38,0:07:54.64,Default,,0,0,0,,Мұнда, бірақ бұл жай ғана осы жерде күте аласыз дегенді білдірмейді.
Dialogue: 0,0:07:54.64,0:07:57.32,Default,,0,0,0,,Белгілі бір құралды қолданбайынша, оны көре алмайсыз.
Dialogue: 0,0:07:57.69,0:07:58.54,Default,,0,0,0,,Құралдар?
Dialogue: 0,0:07:58.54,0:07:59.83,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:08:00.32,0:08:01.83,Default,,0,0,0,,Ой, маймыл?
Dialogue: 0,0:08:01.83,0:08:05.71,Default,,0,0,0,,Дұрыс, маймылдарды көру үшін осыны пайдалану керек.
Dialogue: 0,0:08:06.38,0:08:08.59,Default,,0,0,0,,«Маймыл алушы» Оны сізге қарызға бергенімді қалайсыз ба?
Dialogue: 0,0:08:10.22,0:08:10.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:16.42,0:08:18.97,Default,,0,0,0,,Ей, мұнда ақша көп!
Dialogue: 0,0:08:18.97,0:08:22.60,Default,,0,0,0,,Әңгіме ақшада емес, мен сендерді ұнатпаймын.
Dialogue: 0,0:08:22.60,0:08:27.10,Default,,0,0,0,,Әлгі қарғыс атқан әйел, менде болса болды, менің сүйікті маймылымды көрер едім!
Dialogue: 0,0:08:27.10,0:08:30.99,Default,,0,0,0,,Не істеу керек? ұрлау? қорқыту? соққы? алдау?
Dialogue: 0,0:08:30.99,0:08:32.28,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:32.28,0:08:33.68,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:08:33.68,0:08:37.24,Default,,0,0,0,,Ей, балалар, ең алдымен маймылдар туралы қайдан білесіңдер?
Dialogue: 0,0:08:37.84,0:08:41.20,Default,,0,0,0,,Мен оны естігенде Кейппен бейсбол ойнап жаттым.
Dialogue: 0,0:08:41.80,0:08:42.62,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:42.62,0:08:43.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:43.66,0:08:45.66,Default,,0,0,0,,Маймылдарды көре алатыныңызға сенімдісіз бе?
Dialogue: 0,0:08:45.66,0:08:47.64,Default,,0,0,0,,Не? Сіз маған күмәнданасыз ба?
Dialogue: 0,0:08:47.64,0:08:50.48,Default,,0,0,0,,Жоқ... жоқ, олай емес.
Dialogue: 0,0:08:50.48,0:08:54.80,Default,,0,0,0,,Дұрыс, бір қарағанда кәдімгі жарық сияқты көрінеді.
Dialogue: 0,0:08:54.80,0:08:59.68,Default,,0,0,0,,Бірақ егер сіз оны денеңізге осылай қолдансаңыз, сіз маймылдарды көре аласыз.
Dialogue: 0,0:08:59.68,0:09:02.52,Default,,0,0,0,,Дәлірек айтсақ, бұл маймылдар бар әлем.
Dialogue: 0,0:09:02.52,0:09:03.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:03.97,0:09:06.66,Default,,0,0,0,,Бірақ, менің ойымша, Нагара жақсы.
Dialogue: 0,0:09:06.66,0:09:09.31,Default,,0,0,0,,Ах, менің бұрынғы командаласым Йошими.
Dialogue: 0,0:09:09.72,0:09:10.81,Default,,0,0,0,,Маған қарызға бере аласыз ба?
Dialogue: 0,0:09:12.32,0:09:13.83,Default,,0,0,0,,Coil, біз не істеп жатқанымызды соншалықты терең зерттеген… Ақыры ол қабілетті ғой
Dialogue: 0,0:09:13.83,0:09:15.62,Default,,0,0,0,,Мен жаттығуға қиындықты мойынсұндым.
Dialogue: 0,0:09:15.62,0:09:18.95,Default,,0,0,0,,Менімен жарысып, жеңсең, мен саған мынаны қарызға беремін.
Dialogue: 0,0:09:20.08,0:09:21.20,Default,,0,0,0,,1 иннинг матч
Dialogue: 0,0:09:21.75,0:09:26.83,Default,,0,0,0,,Менің лақтырған допты бір адамның да алдынан ұшырып жібере алсаңдар, сендер жеңесіңдер. Бұл туралы ше?
Dialogue: 0,0:09:26.83,0:09:28.07,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:09:28.07,0:09:29.46,Default,,0,0,0,,Мен бұл шайқаста жеңдім!
Dialogue: 0,0:09:30.26,0:09:32.56,Default,,0,0,0,,Я, мен келуім керек.
Dialogue: 0,0:09:32.56,0:09:36.09,Default,,0,0,0,,Бірақ тегін ештеңе жоқ; алмасу шарттары бар.
Dialogue: 0,0:09:36.58,0:09:38.57,Default,,0,0,0,,Егер сіз жоғалтсаңыз...
Dialogue: 0,0:09:42.77,0:09:44.97,Default,,0,0,0,,Иә? А, бұл біраз...
Dialogue: 0,0:09:44.97,0:09:45.93,Default,,0,0,0,,Шешілді.
Dialogue: 0,0:09:51.51,0:09:53.31,Default,,0,0,0,,Әлі көп жол бар!
Dialogue: 0,0:09:53.31,0:09:55.36,Default,,0,0,0,,Қолтығы тәтті, басы төмен!
Dialogue: 0,0:10:00.06,0:10:01.88,Default,,0,0,0,,Менің ұрғым келмейді.
Dialogue: 0,0:10:01.88,0:10:03.74,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:10:03.74,0:10:05.99,Default,,0,0,0,,Бұл шынымен де керемет пе? Ace дегеніміз не?
Dialogue: 0,0:10:05.99,0:10:07.99,Default,,0,0,0,,Иә, ол данышпан.
Dialogue: 0,0:10:07.99,0:10:10.37,Default,,0,0,0,,Біз қазірдің өзінде кәсіпқойлардан естіп жатырмыз.
Dialogue: 0,0:10:10.37,0:10:12.37,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,0:10:12.37,0:10:13.09,Default,,0,0,0,,Эй!
Dialogue: 0,0:10:13.09,0:10:15.54,Default,,0,0,0,,Мен тырыспай тұрып ұтылып қалсам не істеуім керек?
Dialogue: 0,0:10:15.54,0:10:18.91,Default,,0,0,0,,Жеңіске деген жігермен жүр! Өзіңізге сенбесеңіз не істейсіз?
Dialogue: 0,0:10:23.35,0:10:25.72,Default,,0,0,0,,Мен өзімнен ешқашан ештеңе күтпедім.
Dialogue: 0,0:10:28.20,0:10:29.10,Default,,0,0,0,,Маған...
Dialogue: 0,0:10:30.32,0:10:33.24,Default,,0,0,0,,Сіз шайқаста не болатынын ешқашан білмейсіз.
Dialogue: 0,0:10:33.24,0:10:35.36,Default,,0,0,0,,Ғажайыптарға сеніңіз және бар күшіңізді салыңыз
Dialogue: 0,0:10:36.67,0:10:39.37,Default,,0,0,0,,Айтпақшы, айырбас шарттары қандай болды?
Dialogue: 0,0:10:39.37,0:10:41.66,Default,,0,0,0,,Жоқ, бұл үлкен мәселе емес.
Dialogue: 0,0:10:44.15,0:10:47.68,Default,,0,0,0,,Менімен бейсбол ойнамайсың ба? Егер менде болсаң, мен жеңіске жететін едім.
Dialogue: 0,0:10:47.68,0:10:49.62,Default,,0,0,0,,Маған маймылдар қызық емес.
Dialogue: 0,0:10:49.62,0:10:51.47,Default,,0,0,0,,Анау таз жігіт те бар.
Dialogue: 0,0:10:51.47,0:10:55.50,Default,,0,0,0,,Маған «Маймыл алу» жұмбақ құралы өте қызық.
Dialogue: 0,0:10:55.98,0:11:00.01,Default,,0,0,0,,Егер мұндай нәрсе бар болса, әлемге көзқарасымыз қайтадан өзгерер еді.
Dialogue: 0,0:11:00.52,0:11:02.12,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:11:02.12,0:11:05.92,Default,,0,0,0,,Егер Нагара өз мүмкіндіктерін пайдаланса, ол дереу үйіне оралуы мүмкін.
Dialogue: 0,0:11:05.92,0:11:09.77,Default,,0,0,0,,Хмм... Менің ойымша, бұл оңай емес.
Dialogue: 0,0:11:11.77,0:11:15.49,Default,,0,0,0,,Биылғы жыл Көк үшін ең жақсы маусым болды.
Dialogue: 0,0:11:15.49,0:11:17.71,Default,,0,0,0,,Барлық ойындар толық жеңіске жетті.
Dialogue: 0,0:11:17.71,0:11:21.91,Default,,0,0,0,,Команда V2-ге 32 жеңіспен жетті, бұл лигадағы ең көп жеңіс.
Dialogue: 0,0:11:21.91,0:11:24.01,Default,,0,0,0,,Ал маусымның соңғы ойынында
Dialogue: 0,0:11:24.01,0:11:28.04,Default,,0,0,0,,Жетілу Мен тамаша ойынға жетуге тырыстым.
Dialogue: 0,0:11:28.57,0:11:29.72,Default,,0,0,0,,16-дан 0-ге дейін
Dialogue: 0,0:11:29.72,0:11:32.96,Default,,0,0,0,,«Маймыл мен шаянның» соңғы эпизоды
Dialogue: 0,0:11:32.96,0:11:34.40,Default,,0,0,0,,9-шы иннингтің төменгі бөлігі, 2 шығу
Dialogue: 0,0:11:34.40,0:11:37.64,Default,,0,0,0,,Көк 80 алаңда осы уақытқа дейін 26 соққыға ие болды.
Dialogue: 0,0:11:37.64,0:11:40.73,Default,,0,0,0,,Соңғы шайқас көзді ашып-жұмғанша екі соққы алды.
Dialogue: 0,0:11:40.73,0:11:44.17,Default,,0,0,0,,Толық стадионда «тағы бір алаңға» шақырулар көтерілді.
Dialogue: 0,0:11:44.17,0:11:46.18,Default,,0,0,0,,Біртүрлі атмосферамен қоршалған
Dialogue: 0,0:11:46.18,0:11:51.15,Default,,0,0,0,,Ондағы барлық маймылдар Көктің әрбір қимылын бақылап отырды!
Dialogue: 0,0:11:51.15,0:11:55.69,Default,,0,0,0,,Мінсіз ойынның жетістігіне ешкім күмән келтірген жоқ.
Dialogue: 0,0:11:55.69,0:11:58.80,Default,,0,0,0,,Иә, әрине, алаңдатарлық белгілер болды.
Dialogue: 0,0:11:58.80,0:12:02.65,Default,,0,0,0,,Енді ойлап қарасам, мен ғана сыймаған маймыл болдым.
Dialogue: 0,0:12:02.65,0:12:04.24,Default,,0,0,0,,Басқа алаң төрешісінің болуы
Dialogue: 0,0:12:04.93,0:12:06.52,Default,,0,0,0,,Ал дүниенің ауытқуы
Dialogue: 0,0:12:07.36,0:12:10.68,Default,,0,0,0,,81 Шар Көктің құрметіне сөйле
Dialogue: 0,0:12:10.68,0:12:12.82,Default,,0,0,0,,Бұл оның кінәсі емес.
Dialogue: 0,0:12:12.82,0:12:14.50,Default,,0,0,0,,Дүниенің өзі қозғалды.
Dialogue: 0,0:12:14.80,0:12:17.80,Default,,0,0,0,,Жоқ, қателессем де, мен Көкке жақпаймын.
Dialogue: 0,0:12:17.80,0:12:19.37,Default,,0,0,0,,Иә, болды
Dialogue: 0,0:12:19.37,0:12:23.76,Default,,0,0,0,,Бұл дүниенің өзі сәл ғана жылжыды. Бұл рас!
Dialogue: 0,0:12:26.18,0:12:29.58,Default,,0,0,0,,Доп соққы аймағынан сәл шығып кеткендей болды.
Dialogue: 0,0:12:29.58,0:12:32.14,Default,,0,0,0,,Соққы немесе доп ретінде қабылдауға болатын допты төреші
Dialogue: 0,0:12:32.14,0:12:36.60,Default,,0,0,0,,Әлемде сол стадионда бұл шешімді қабылдайтын бір ғана алаң төрешісі бар.
Dialogue: 0,0:12:36.60,0:12:38.94,Default,,0,0,0,,Дүние арасына мінбеген маймыл еді!
Dialogue: 0,0:12:44.55,0:12:46.69,Default,,0,0,0,,Көрермендер бір ауыздан орындарынан тұрады
Dialogue: 0,0:12:46.69,0:12:50.07,Default,,0,0,0,,Шашыңызды қатты тырнаңыз және бар күшіңізбен аяғыңызды таптаңыз.
Dialogue: 0,0:12:50.07,0:12:52.32,Default,,0,0,0,,Қатты гуілдер Қатты гуілдер!
Dialogue: 0,0:12:52.32,0:12:54.91,Default,,0,0,0,,Ойын төрешісі бейнебаянға қатысты сұраудан үзілді-кесілді бас тартады
Dialogue: 0,0:12:55.29,0:12:57.64,Default,,0,0,0,,Көк те өз наразылығын білдіріп, төрешіге жақындайды.
Dialogue: 0,0:12:57.64,0:12:58.92,Default,,0,0,0,,«Бұл ереуіл!»
Dialogue: 0,0:12:59.60,0:13:01.55,Default,,0,0,0,,Төреші ақырын басын шайқайды.
Dialogue: 0,0:13:01.55,0:13:02.83,Default,,0,0,0,,«Ей, есі дұрыс па?
Dialogue: 0,0:13:02.83,0:13:05.54,Default,,0,0,0,,Бұл бір доп тамаша ойын! »
Dialogue: 0,0:13:06.18,0:13:08.80,Default,,0,0,0,,Алаңның төрешісі: «Мен бұл туралы білемін» деді.
Dialogue: 0,0:13:08.80,0:13:10.17,Default,,0,0,0,,«Жоқ, мен түсінбеймін!
Dialogue: 0,0:13:10.17,0:13:12.64,Default,,0,0,0,,Неліктен бұл допты соққы ретінде қабылдамайсың?
Dialogue: 0,0:13:12.64,0:13:14.75,Default,,0,0,0,,Ойынның нәтижесі шешілді!
Dialogue: 0,0:13:14.75,0:13:18.51,Default,,0,0,0,,Оның үстіне бұл ойын тек жекпе-жек ойыны; шайқастың ұрысуға ерік-жігері жоқ.
Dialogue: 0,0:13:18.51,0:13:22.32,Default,,0,0,0,,Бірақ бұл соққы доп. Бұл допты қай жолмен ұстағаныңыз маңызды емес.
Dialogue: 0,0:13:22.32,0:13:23.92,Default,,0,0,0,,Неліктен ереуіл жасамасқа?
Dialogue: 0,0:13:23.92,0:13:25.96,Default,,0,0,0,,Мұның мәні неде!
Dialogue: 0,0:13:25.96,0:13:30.03,Default,,0,0,0,,Ең бастысы, бұл аудиторияның үміті Үміттің лебізін ести алмайсыз ба?
Dialogue: 0,0:13:30.03,0:13:33.95,Default,,0,0,0,,Көрдіңіз бе, бұл олардың қалаған соңы емес! »
Dialogue: 0,0:13:34.35,0:13:36.46,Default,,0,0,0,,«Мен де бұл туралы білемін».
Dialogue: 0,0:13:37.40,0:13:38.87,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:13:39.23,0:13:42.86,Default,,0,0,0,,«Көрермендердің қалауы ойынға ешқандай қатысы жоқ.
Dialogue: 0,0:13:42.86,0:13:45.52,Default,,0,0,0,,Стадион бар, оның ішінде ережелер бар.
Dialogue: 0,0:13:45.52,0:13:48.88,Default,,0,0,0,,Бұл жерде қандай себеп болса да әділдік болуы керек».
Dialogue: 0,0:13:50.02,0:13:51.14,Default,,0,0,0,,«Бұл дұрыс емес!
Dialogue: 0,0:13:51.42,0:13:53.10,Default,,0,0,0,,Бұл бейсбол шоуы.
Dialogue: 0,0:13:53.10,0:13:56.05,Default,,0,0,0,,Маған бәрінің үміті, арманы бар.
Dialogue: 0,0:13:56.05,0:13:59.02,Default,,0,0,0,,Бұл керемет Маймылдар лигасы менің мойнымда.
Dialogue: 0,0:13:59.02,0:14:01.40,Default,,0,0,0,,Бұл жерде мен ережемін!
Dialogue: 0,0:14:02.38,0:14:04.20,Default,,0,0,0,,Енді сот шешімін бұзыңыз! »
Dialogue: 0,0:14:04.20,0:14:07.07,Default,,0,0,0,,Көктің үлкен қолдары дірілдеп қалды.
Dialogue: 0,0:14:07.07,0:14:08.65,Default,,0,0,0,,«Мен мұны істей алмаймын».
Dialogue: 0,0:14:09.28,0:14:11.20,Default,,0,0,0,,Төреші мүлде тайсалмады.
Dialogue: 0,0:14:11.20,0:14:14.41,Default,,0,0,0,,«Осы уақытта, осы жерде, мен ережемін».
Dialogue: 0,0:14:15.92,0:14:19.79,Default,,0,0,0,,Оны Көк те білді, экрандағы бейнені қайталау
Dialogue: 0,0:14:20.55,0:14:26.80,Default,,0,0,0,,Шындығында, әлем ауысуына байланысты доп соққы аймағынан 1 микрон ғана шықты.
Dialogue: 0,0:14:26.80,0:14:30.80,Default,,0,0,0,,Бірақ Көк бұл шешімді қабылдай алмады.
Dialogue: 0,0:14:31.36,0:14:34.51,Default,,0,0,0,,Ойын қайта басталғаннан кейін Көк 81-ші допты шығарады.
Dialogue: 0,0:14:34.51,0:14:39.18,Default,,0,0,0,,3 допты дәл сол доппен бірдей жылдамдықпен, дәл бірдей бағытқа лақтыр.
Dialogue: 0,0:14:39.18,0:14:40.16,Default,,0,0,0,,«Төрт доп»
Dialogue: 0,0:14:41.21,0:14:44.05,Default,,0,0,0,,Қолғапты қорғанға соғып, ойыннан бас тартады
Dialogue: 0,0:14:44.05,0:14:47.27,Default,,0,0,0,,Толқылған көрермендерді тәртіпсіздікке итермелеу
Dialogue: 0,0:14:47.27,0:14:50.71,Default,,0,0,0,,Көпшілік алаңға шығып, бірден төрешіге шабуыл жасады!
Dialogue: 0,0:14:52.32,0:14:55.68,Default,,0,0,0,,Соққы оның басына тиген кезде алаң төрешісі шошып кетті.
Dialogue: 0,0:14:55.68,0:14:58.53,Default,,0,0,0,,Оның денесін тобырға айналдырған топ жарып жіберді.
Dialogue: 0,0:14:59.02,0:15:02.58,Default,,0,0,0,,Еті мен қаны аяқ астында тапталған тозған, арық дене.
Dialogue: 0,0:15:02.58,0:15:05.72,Default,,0,0,0,,Үстіне түкіріп, қорлап, өлді.
Dialogue: 0,0:15:10.34,0:15:12.34,Default,,0,0,0,,Маймыл... өлді.
Dialogue: 0,0:15:12.76,0:15:14.19,Default,,0,0,0,,Бұл жай бейсбол.
Dialogue: 0,0:15:15.13,0:15:19.04,Default,,0,0,0,,Көк сол бір допқа барлығының үмітін арқалады.
Dialogue: 0,0:15:19.04,0:15:20.61,Default,,0,0,0,,Қандай керемет маймыл
Dialogue: 0,0:15:20.61,0:15:23.85,Default,,0,0,0,,Дұрыс, ол ең жақсы құмыра болды.
Dialogue: 0,0:15:23.85,0:15:25.73,Default,,0,0,0,,Жоқ, бұл алаңға төреші.
Dialogue: 0,0:15:25.73,0:15:26.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:28.74,0:15:31.11,Default,,0,0,0,,Дүниені бағындырды
Dialogue: 0,0:15:31.49,0:15:32.97,Default,,0,0,0,,Бұл асыра сілтеу.
Dialogue: 0,0:15:32.97,0:15:34.94,Default,,0,0,0,,Нагара ештеңе сезбей ме?
Dialogue: 0,0:15:36.25,0:15:37.99,Default,,0,0,0,,Сіз ашуланбайсыз ба?
Dialogue: 0,0:15:41.98,0:15:43.20,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:15:50.36,0:15:53.34,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:15:55.34,0:15:57.72,Default,,0,0,0,,Сол маймыл өлтірілуге ​​лайық еді.
Dialogue: 0,0:15:58.53,0:16:00.60,Default,,0,0,0,,Қарапайым адамдар данышпандарды өлтіреді
Dialogue: 0,0:16:00.60,0:16:03.73,Default,,0,0,0,,Не деген надан ақымақтар талантты құртатын дүние...
Dialogue: 0,0:16:05.84,0:16:06.86,Default,,0,0,0,,Бұзушылық!
Dialogue: 0,0:16:10.04,0:16:12.56,Default,,0,0,0,,Бұл өрескел, бірақ әдемі пішін
Dialogue: 0,0:16:12.56,0:16:15.33,Default,,0,0,0,,Сіз енді ешқашан найзағай шапшаңдығын көрмейсіз.
Dialogue: 0,0:16:17.44,0:16:19.09,Default,,0,0,0,,Екі ұр!
Dialogue: 0,0:16:22.94,0:16:25.33,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:16:26.56,0:16:27.46,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:16:28.17,0:16:29.20,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:16:33.72,0:16:35.37,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:16:43.52,0:16:45.25,Default,,0,0,0,,Екі ұр!
Dialogue: 0,0:16:47.55,0:16:50.11,Default,,0,0,0,,Әй, қалай? менің добым
Dialogue: 0,0:16:50.56,0:16:54.40,Default,,0,0,0,,Иә, бұл таңқаларлық. Мен оны мүлде соға алатындай сезінбеймін.
Dialogue: 0,0:16:54.40,0:16:56.11,Default,,0,0,0,,Сен мені ұрмайсың, солай ма?
Dialogue: 0,0:16:56.99,0:16:58.32,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:17:05.00,0:17:06.46,Default,,0,0,0,,Мен неге...
Dialogue: 0,0:17:08.54,0:17:10.08,Default,,0,0,0,,Доп... Доп
Dialogue: 0,0:17:10.08,0:17:11.81,Default,,0,0,0,,Бұл аздап қауіпті!
Dialogue: 0,0:17:11.81,0:17:14.88,Default,,0,0,0,,Дұрыс! Бұл қауіпті доп! Шығу!
Dialogue: 0,0:17:14.88,0:17:16.40,Default,,0,0,0,,Бұл ол!
Dialogue: 0,0:17:16.40,0:17:17.97,Default,,0,0,0,,Бұл күлкілі
Dialogue: 0,0:17:17.97,0:17:19.28,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:17:19.28,0:17:22.47,Default,,0,0,0,,Маймылға бейсбол берген мен болдым.
Dialogue: 0,0:17:25.55,0:17:27.23,Default,,0,0,0,,Мен ерекшемін
Dialogue: 0,0:17:28.80,0:17:33.85,Default,,0,0,0,,Егер жоғалтсаңыз, бізді мүмкіндігінше тезірек бастапқы әлемге қайтарыңыз.
Dialogue: 0,0:17:33.85,0:17:38.49,Default,,0,0,0,,Маған мұны істеу мүмкін емес деп айтпаңыз, мен сізді «құтқарушы» деп естідім, солай ма?
Dialogue: 0,0:17:39.16,0:17:41.67,Default,,0,0,0,,Не? Жоқ, мен сондаймын...
Dialogue: 0,0:17:41.67,0:17:44.72,Default,,0,0,0,,Қазір саған қарап жүрегім айныды.
Dialogue: 0,0:17:44.72,0:17:47.49,Default,,0,0,0,,Сіз сияқты біреудің таңдалатынына сене алмаймын.
Dialogue: 0,0:17:49.10,0:17:51.29,Default,,0,0,0,,Бұл дүние дұрыс емес
Dialogue: 0,0:17:51.29,0:17:54.48,Default,,0,0,0,,Мені дұрыс бағалаған әлемге оралу.
Dialogue: 0,0:17:54.48,0:17:57.10,Default,,0,0,0,,Сенің күшің сол үшін.
Dialogue: 0,0:17:57.83,0:17:59.51,Default,,0,0,0,,Мен… мен жай…—
Dialogue: 0,0:17:59.90,0:18:02.39,Default,,0,0,0,,Жаса, өлсең де істе
Dialogue: 0,0:18:04.71,0:18:07.14,Default,,0,0,0,,А... Са... Маймыл?
Dialogue: 0,0:18:09.14,0:18:11.02,Default,,0,0,0,,Бір қолды маймыл...
Dialogue: 0,0:18:12.06,0:18:16.03,Default,,0,0,0,,Оның бір қолы бар екенін қайдан білдің? Сіз төрешіні көре аласыз ба?
Dialogue: 0,0:18:27.44,0:18:31.73,Default,,0,0,0,,Сіз шынымен де бейсбол ойыншысы болғыңыз келді, солай ма?
Dialogue: 0,0:18:31.73,0:18:34.22,Default,,0,0,0,,Бірақ бұл мүмкін емес еді.
Dialogue: 0,0:18:35.11,0:18:41.52,Default,,0,0,0,,Бірақ сіз бейсболдың қатыгез теңдігіне тартылғандықтан төреші болдыңыз.
Dialogue: 0,0:18:43.68,0:18:48.18,Default,,0,0,0,,Сіз мені қорғадыңыз. Сіз сонда болдыңыз.
Dialogue: 0,0:18:49.73,0:18:52.09,Default,,0,0,0,,Қаза болған алаң төрешісі емес...
Dialogue: 0,0:18:52.09,0:18:52.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:52.95,0:18:54.72,Default,,0,0,0,,Мені өлтірген бейсбол болды.
Dialogue: 0,0:18:54.72,0:18:56.11,Default,,0,0,0,,А? Не айтып тұрсың...
Dialogue: 0,0:18:56.11,0:18:56.86,Default,,0,0,0,,Мен оны өз көзіммен көрдім
Dialogue: 0,0:18:58.06,0:19:01.36,Default,,0,0,0,,Менің ойымша, ол мұны дұрыс жасай алады.
Dialogue: 0,0:19:02.34,0:19:03.11,Default,,0,0,0,,Қоқыс
Dialogue: 0,0:19:03.49,0:19:04.87,Default,,0,0,0,,Қызып кету
Dialogue: 0,0:19:06.32,0:19:07.37,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:10.29,0:19:11.37,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:15.38,0:19:17.88,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:19:17.88,0:19:20.01,Default,,0,0,0,,О, ақымақ!
Dialogue: 0,0:19:22.26,0:19:23.78,Default,,0,0,0,,Керемет Нагара!
Dialogue: 0,0:19:23.78,0:19:24.94,Default,,0,0,0,,Мен оны қарап шықтым.
Dialogue: 0,0:19:24.94,0:19:28.21,Default,,0,0,0,,Бұл көңілсіз болды, бірақ бұл жақсы тербеліс болды.
Dialogue: 0,0:19:28.21,0:19:28.97,Default,,0,0,0,,Иә
Dialogue: 0,0:19:28.97,0:19:32.08,Default,,0,0,0,,Ой, маймылдарды көре алмайсың.
Dialogue: 0,0:19:32.08,0:19:32.89,Default,,0,0,0,,Хой
Dialogue: 0,0:19:32.89,0:19:34.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:34.08,0:19:35.97,Default,,0,0,0,,Иә? Сіз қандай да бір жолмен кептеліп қалдыңыз ба?
Dialogue: 0,0:19:36.87,0:19:37.97,Default,,0,0,0,,Не?
Dialogue: 0,0:19:37.97,0:19:39.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:39.19,0:19:40.64,Default,,0,0,0,,Бұл мысықтың ісі емес.
Dialogue: 0,0:19:40.64,0:19:41.92,Default,,0,0,0,,Шаштың қандай түрі бар?
Dialogue: 0,0:19:41.92,0:19:43.43,Default,,0,0,0,,Біз қашан жиналдық?
Dialogue: 0,0:19:43.43,0:19:45.45,Default,,0,0,0,,Мені жұбатасыз ба?
Dialogue: 0,0:19:49.39,0:19:52.21,Default,,0,0,0,,Менің аралдағы өмірім бүгін біте ме?
Dialogue: 0,0:19:52.21,0:19:53.99,Default,,0,0,0,,Мен өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:19:53.99,0:19:55.64,Default,,0,0,0,,Жақсы... бұл дұрыс.
Dialogue: 0,0:19:56.25,0:20:00.79,Default,,0,0,0,,Мен әрқашан бейсболды тастағым келетін.
Dialogue: 0,0:20:01.83,0:20:07.22,Default,,0,0,0,,Төбеде істеуге талантым жетпейтінін мен ғана білемін.
Dialogue: 0,0:20:07.63,0:20:12.59,Default,,0,0,0,,Соған қарамастан біз мұны істеп көңілді болатынбыз. Бұл маймылдарды көргендей.
Dialogue: 0,0:20:12.59,0:20:18.56,Default,,0,0,0,,Сіз мұны білмей тұрып, сіздің талантыңыз бар ма, жоқ па, әлде жоғары оқу орнына түскіңіз келеді.
Dialogue: 0,0:20:18.56,0:20:21.89,Default,,0,0,0,,Осы сияқты қажетсіз нәрселерге алаңдау
Dialogue: 0,0:20:22.60,0:20:27.62,Default,,0,0,0,,Алайда мен маймыл ойынын тамашалағанда бір орында тұра алмадым.
Dialogue: 0,0:20:28.08,0:20:31.89,Default,,0,0,0,,Мен оны жақсы айта алмаймын, бірақ менің ойымша, бұл бір нәрсе...
Dialogue: 0,0:20:31.89,0:20:35.10,Default,,0,0,0,,«Бейсбол ойна!» деп ойладым.
Dialogue: 0,0:20:35.10,0:20:39.21,Default,,0,0,0,,Мен мұны байқасам, жер бітті.
Dialogue: 0,0:20:39.21,0:20:44.53,Default,,0,0,0,,Біртүрлі, сенде талант жоқ, бірақ сен бейсболды ғана ойлайсың.
Dialogue: 0,0:20:46.57,0:20:48.03,Default,,0,0,0,,Бұл таңқаларлық емес.
Dialogue: 0,0:20:49.12,0:20:50.55,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:20:50.55,0:20:51.25,Default,,0,0,0,,Иә
Dialogue: 0,0:20:58.44,0:20:59.19,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:20:59.73,0:21:01.96,Default,,0,0,0,,Жоспар ойдағыдай орындалып жатыр ма?
Dialogue: 0,0:21:01.96,0:21:04.96,Default,,0,0,0,,Бұл керемет қабілет.
Dialogue: 0,0:21:04.96,0:21:06.44,Default,,0,0,0,,Сіз кез келген жерге бара аласыз
Dialogue: 0,0:21:06.44,0:21:09.56,Default,,0,0,0,,Шынымен бе? Мен олай көрмеймін, бірақ...
Dialogue: 0,0:21:09.56,0:21:10.62,Default,,0,0,0,,Өтірік емес
Dialogue: 0,0:21:10.62,0:21:14.17,Default,,0,0,0,,Бірақ бұл әркім ойлағаннан сәл өзгеше болуы мүмкін.
Dialogue: 0,0:21:15.46,0:21:19.05,Default,,0,0,0,,Нагара енді "Warp" мүмкіндігін басқара алады
Dialogue: 0,0:21:19.05,0:21:21.25,Default,,0,0,0,,Бұл жермен қоштасатын кез келді.
Dialogue: 0,0:21:21.61,0:21:23.97,Default,,0,0,0,,Енді бастапқы әлемге оралайық!
Dialogue: 0,0:21:26.80,0:21:29.02,Default,,0,0,0,,Келіңіздер, жасаңыздар.
Dialogue: 0,0:21:29.02,0:21:30.78,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:21:38.05,0:21:39.65,Default,,0,0,0,,Е, бұл қайда?
Dialogue: 0,0:21:39.65,0:21:41.65,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:21:44.11,0:21:45.50,Default,,0,0,0,,Бұл да басқа...
Dialogue: 0,0:21:57.30,0:21:58.90,Default,,0,0,0,,Сіз әлі мектептесіз бе?
Dialogue: 0,0:21:58.90,0:22:00.80,Default,,0,0,0,,Сіз қашан келесіз?
Dialogue: 0,0:22:00.80,0:22:02.56,Default,,0,0,0,,Мақтансаң болды!
Dialogue: 0,0:22:02.56,0:22:04.48,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:22:05.65,0:22:06.92,Default,,0,0,0,,Мен үйге бара алмаймын
Dialogue: 0,0:22:06.92,0:22:08.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:08.01,0:22:10.18,Default,,0,0,0,,Дәлірек айтқанда, бастапқы әлем.
Dialogue: 0,0:22:10.18,0:22:12.93,Default,,0,0,0,,Мен барғым келген жерге бара алмаймын
Dialogue: 0,0:22:14.41,0:22:16.43,Default,,0,0,0,,Әлгі жігіт шынымен ақымақ.
Dialogue: 0,0:22:16.43,0:22:18.43,Default,,0,0,0,,О, шындап...
Dialogue: 0,0:22:18.43,0:22:20.44,Default,,0,0,0,,Жоғалтады деп күтілуде
Dialogue: 0,0:22:19.10,0:22:20.44,Default,,0,0,0,,Боқ
Dialogue: 0,0:22:20.44,0:22:22.74,Default,,0,0,0,,Енді бұл түсінікті.
Dialogue: 0,0:22:22.74,0:22:26.82,Default,,0,0,0,,Нагараның басқа «бұл әлемге» саяхаттау мүмкіндігі бар.
Dialogue: 0,0:22:27.34,0:22:29.44,Default,,0,0,0,,Бірақ сіз баратын жерді таңдай алмайсыз
Dialogue: 0,0:22:29.44,0:22:34.31,Default,,0,0,0,,Өйткені менің ойымша, осы уақытқа дейін әлем Нагара қалағандай емес.
Dialogue: 0,0:22:36.31,0:22:39.21,Default,,0,0,0,,Эй, мынаны қарашы.
Dialogue: 0,0:22:42.24,0:22:44.71,Default,,0,0,0,,А... Аки-сенсэй?
Dialogue: 0,0:22:45.71,0:22:46.68,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:22:46.68,0:22:48.15,Default,,0,0,0,,Бізден басқа кім адасқан?
Dialogue: 0,0:22:48.15,0:22:49.22,Default,,0,0,0,,Ол маған көмектесуге келді!
Dialogue: 0,0:22:49.22,0:22:50.97,Default,,0,0,0,,Тынышыңдар, құрттар!
Dialogue: 0,0:23:02.20,0:23:04.62,Default,,0,0,0,,Ойын бүгін аяқталады
Dialogue: 0,0:23:08.64,0:23:14.72,Default,,0,0,0,,Енді көзіміз түйіскен сәттен бастап
Dialogue: 0,0:23:14.72,0:23:20.11,Default,,0,0,0,,Жүктелген Барлығы кешірілді
Dialogue: 0,0:23:20.11,0:23:24.10,Default,,0,0,0,,«Сіз осында қала аласыз.»
Dialogue: 0,0:23:24.10,0:23:30.50,Default,,0,0,0,,Ұзын дәліз, Құдай ЖОҚ
Dialogue: 0,0:23:30.50,0:23:35.72,Default,,0,0,0,,Жеті түсті қолшатыр сөздер естіледі
Dialogue: 0,0:23:35.72,0:23:39.15,Default,,0,0,0,,«Сіз осында қала аласыз.»
Dialogue: 0,0:23:39.15,0:23:43.31,Default,,0,0,0,,Мен сені қатты жақсы көремін, жек көремін
Dialogue: 0,0:23:43.31,0:23:49.41,Default,,0,0,0,,Махаббаттың мәнін білмей
Dialogue: 0,0:23:49.41,0:23:54.74,Default,,0,0,0,,Батып бара жатқан күнге шомылған дүниенің шетінде
Dialogue: 0,0:23:54.74,0:23:59.85,Default,,0,0,0,,Қол ұстасып
Dialogue: 0,0:23:59.85,0:24:04.62,Default,,0,0,0,,Егер сіз 2000 жарық жылы пойызда қайғыны жеңсеңіз
Dialogue: 0,0:24:04.62,0:24:10.30,Default,,0,0,0,,Бала қызды кездестіреді
Dialogue: 0,0:24:10.30,0:24:14.88,Default,,0,0,0,,Жақсысы мен жаманы бар сұлу жалғыз адамдар
Dialogue: 0,0:24:14.88,0:24:20.12,Default,,0,0,0,,Бала қызбен танысады
Dialogue: 0,0:24:20.12,0:24:28.99,Default,,0,0,0,,ҚОШТАСТЫРМА
Dialogue: 0,0:24:30.49,0:24:35.49,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
