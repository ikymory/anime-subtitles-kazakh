Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.12,0:00:08.98,Default,,0,0,0,,Отыр
Dialogue: 0,0:00:09.37,0:00:10.38,Default,,0,0,0,,Шекеханд
Dialogue: 0,0:00:11.50,0:00:12.24,Default,,0,0,0,,Бан
Dialogue: 0,0:00:13.60,0:00:15.42,Default,,0,0,0,,Өлген адам болып көріну
Dialogue: 0,0:00:15.42,0:00:16.09,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:00:16.72,0:00:17.98,Default,,0,0,0,,Міне.
Dialogue: 0,0:00:19.30,0:00:20.85,Default,,0,0,0,,Бұл біраз...
Dialogue: 0,0:00:20.85,0:00:22.78,Default,,0,0,0,,Ит болса да
Dialogue: 0,0:00:22.78,0:00:24.60,Default,,0,0,0,,Ертеде біз адам едік.
Dialogue: 0,0:00:24.60,0:00:26.64,Default,,0,0,0,,Енді бұл ит, солай ма?
Dialogue: 0,0:00:26.64,0:00:27.60,Default,,0,0,0,,Тамақ дайын.
Dialogue: 0,0:00:38.22,0:00:40.55,Default,,0,0,0,,Жоқ, бұл сирек.
Dialogue: 0,0:00:41.18,0:00:44.10,Default,,0,0,0,,Ген ақымақ болғандықтан, бұрынғы әдеті үшін оны өзімен бірге ала келген.
Dialogue: 0,0:00:44.54,0:00:49.12,Default,,0,0,0,,Нозоми... Ол қыз неге менімен келмеді?
Dialogue: 0,0:00:49.12,0:00:50.11,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:00:50.11,0:00:52.72,Default,,0,0,0,,Біреумен ұрысып қалған жоқсың ба?
Dialogue: 0,0:00:59.25,0:01:01.62,Default,,0,0,0,,Эй, маған бір қызық айтшы.
Dialogue: 0,0:01:02.02,0:01:03.83,Default,,0,0,0,,Бұл ит үшін мүмкін емес.
Dialogue: 0,0:01:03.83,0:01:05.30,Default,,0,0,0,,өшпенділік
Dialogue: 0,0:01:05.30,0:01:07.36,Default,,0,0,0,,Олай болса айтшы, сен неге ит болдың.
Dialogue: 0,0:01:08.23,0:01:10.85,Default,,0,0,0,,Неге ит болдың?
Dialogue: 0,0:01:10.85,0:01:12.78,Default,,0,0,0,,Неге...
Dialogue: 0,0:01:12.78,0:01:14.27,Default,,0,0,0,,Иә? Ұмытып қалдыңыз ба?
Dialogue: 0,0:01:15.14,0:01:18.17,Default,,0,0,0,,Бұл көп уақыт бұрын болды.
Dialogue: 0,0:01:18.17,0:01:21.48,Default,,0,0,0,,Есте сақтау жеткілікті, солай ма?
Dialogue: 0,0:01:23.72,0:01:25.89,Default,,0,0,0,,Менің есімде қалғаны…
Dialogue: 0,0:01:27.26,0:01:31.09,Default,,0,0,0,,Иә... бұл баяғыда болды
Dialogue: 0,0:01:31.09,0:01:32.77,Default,,0,0,0,,5000 жыл бұрын
Dialogue: 0,0:01:35.80,0:01:40.28,Default,,0,0,0,,Ол кезде мен өте бұралған бала едім.
Dialogue: 0,0:01:43.55,0:01:48.29,Default,,0,0,0,,Бірақ... маған қарап күлген біреу болды.
Dialogue: 0,0:01:53.65,0:01:56.60,Default,,0,0,0,,Оның ерекше қабілеттері болды
Dialogue: 0,0:02:01.55,0:02:04.45,Default,,0,0,0,,Бұл барлық нәрсені басқаратын күш
Dialogue: 0,0:02:06.26,0:02:07.62,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:02:09.81,0:02:11.77,Default,,0,0,0,,Ол баршаның үміті
Dialogue: 0,0:02:12.77,0:02:15.27,Default,,0,0,0,,Барлық таңдаулар сеніп тапсырылған ұйым.
Dialogue: 0,0:02:16.31,0:02:18.66,Default,,0,0,0,,Ол әлемдегі барлық нәрсе болды
Dialogue: 0,0:02:20.93,0:02:24.88,Default,,0,0,0,,Бірақ бақытты кездер ұзаққа бармады.
Dialogue: 0,0:02:29.66,0:02:32.54,Default,,0,0,0,,Тосын оба
Dialogue: 0,0:02:33.07,0:02:34.79,Default,,0,0,0,,Жара ісікке айналады.
Dialogue: 0,0:02:35.54,0:02:37.55,Default,,0,0,0,,Күннен күнге үлкейе берді.
Dialogue: 0,0:02:39.17,0:02:45.30,Default,,0,0,0,,Тіпті оның барлық нәрсеге құдіреті де оны емдей алмады.
Dialogue: 0,0:02:47.47,0:02:48.79,Default,,0,0,0,,Сәлем Ямабико
Dialogue: 0,0:02:50.26,0:02:51.98,Default,,0,0,0,,Мен неге ұқсаймын?
Dialogue: 0,0:02:51.98,0:02:53.62,Default,,0,0,0,,Шынымды айтсам
Dialogue: 0,0:02:54.65,0:02:58.10,Default,,0,0,0,,Менің шашым мөлдір, қар сияқты.
Dialogue: 0,0:02:58.10,0:02:59.11,Default,,0,0,0,,Сонда?
Dialogue: 0,0:02:59.92,0:03:00.94,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:03:01.76,0:03:04.12,Default,,0,0,0,,Ернім көктей көкшіл
Dialogue: 0,0:03:04.41,0:03:05.12,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:03:06.02,0:03:07.12,Default,,0,0,0,,Көздер...
Dialogue: 0,0:03:08.99,0:03:11.52,Default,,0,0,0,,Мен өзімді бұрынғыдан да мейірімді сезінемін.
Dialogue: 0,0:03:14.43,0:03:16.00,Default,,0,0,0,,Қарамаңдар
Dialogue: 0,0:03:16.55,0:03:17.30,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:18.74,0:03:21.60,Default,,0,0,0,,Өтінемін, мен мұқият қарағым келеді.
Dialogue: 0,0:03:25.28,0:03:27.65,Default,,0,0,0,,Иә, бұл рас.
Dialogue: 0,0:03:27.65,0:03:30.70,Default,,0,0,0,,Бұрынғыдан әлдеқайда жақсы және табиғи.
Dialogue: 0,0:03:30.70,0:03:32.44,Default,,0,0,0,,Бұл нағыз мен
Dialogue: 0,0:03:35.19,0:03:38.31,Default,,0,0,0,,Бірақ бәрі бірдей олай ойламайды.
Dialogue: 0,0:03:50.22,0:03:55.88,Default,,0,0,0,,Мен... ол үшін бәрін жасайтын едім.
Dialogue: 0,0:03:56.73,0:03:59.10,Default,,0,0,0,,Мен кез келген нәрсе болуым керек еді.
Dialogue: 0,0:04:02.45,0:04:05.63,Default,,0,0,0,,Иә... бәрібір...
Dialogue: 0,0:04:07.59,0:04:09.76,Default,,0,0,0,,Ол ешқашан берілмеді
Dialogue: 0,0:04:10.36,0:04:14.27,Default,,0,0,0,,Мен барлығына көмектесе алатыныма сендім және обамен күресемін.
Dialogue: 0,0:04:15.20,0:04:20.10,Default,,0,0,0,,Күннен күнге мен оған олай қарай алмай қалдым.
Dialogue: 0,0:04:20.10,0:04:22.00,Default,,0,0,0,,Ауырсынды ма?
Dialogue: 0,0:04:22.00,0:04:23.65,Default,,0,0,0,,Жоқ, керісінше.
Dialogue: 0,0:04:25.03,0:04:28.41,Default,,0,0,0,,Тікелей қарауға тым жарық болды.
Dialogue: 0,0:04:28.41,0:04:30.83,Default,,0,0,0,,Куу Мен айтайын~
Dialogue: 0,0:04:34.58,0:04:36.58,Default,,0,0,0,,Бұл қорқынышты ауру болды.
Dialogue: 0,0:04:37.17,0:04:40.25,Default,,0,0,0,,Ісік ақырында бүкіл денеге таралады
Dialogue: 0,0:04:40.25,0:04:42.62,Default,,0,0,0,,Адам кейпін сақтай алмайды
Dialogue: 0,0:04:44.14,0:04:45.72,Default,,0,0,0,,Соңында...
Dialogue: 0,0:04:46.13,0:04:47.40,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:04:47.40,0:04:49.49,Default,,0,0,0,,Өзіңізді сөйлеуге мәжбүрлеудің қажеті жоқ
Dialogue: 0,0:04:49.49,0:04:50.47,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:50.99,0:04:52.72,Default,,0,0,0,,Мені тыңдауларыңызды қалаймын.
Dialogue: 0,0:04:53.75,0:04:57.85,Default,,0,0,0,,Ол кезде бәрінің жүрегінде әлі үміт бар еді.
Dialogue: 0,0:04:58.40,0:05:01.80,Default,,0,0,0,,Мен оның мені құтқаратынына сендім.
Dialogue: 0,0:05:02.77,0:05:04.47,Default,,0,0,0,,Ол керемет адам еді.
Dialogue: 0,0:05:05.34,0:05:05.86,Default,,0,0,0,,О
Dialogue: 0,0:05:06.74,0:05:12.87,Default,,0,0,0,,Ол көп дүниелерді көрді, бірақ ол мұндай күшке ие болған алғашқы адам болды.
Dialogue: 0,0:05:14.46,0:05:19.10,Default,,0,0,0,,Until then, I had been wandering around the world aimlessly.
Dialogue: 0,0:05:19.10,0:05:24.38,Default,,0,0,0,,Бұл менің сыныптастарыммен бірге болғаннан әлдеқайда ыңғайлы болды.
Dialogue: 0,0:05:28.87,0:05:32.65,Default,,0,0,0,,Күндерді ауыртпай, қуанышсыз өткізу
Dialogue: 0,0:05:32.65,0:05:34.14,Default,,0,0,0,,Тірі кезінде
Dialogue: 0,0:05:47.61,0:05:49.68,Default,,0,0,0,,Бұл жаңа айдың түні еді
Dialogue: 0,0:05:59.25,0:06:00.67,Default,,0,0,0,,Мен оны кездестірдім
Dialogue: 0,0:06:08.97,0:06:10.68,Default,,0,0,0,,Маған атыңды айт
Dialogue: 0,0:06:11.62,0:06:13.43,Default,,0,0,0,,Я… Ямабико
Dialogue: 0,0:06:14.33,0:06:15.59,Default,,0,0,0,,Мен жаңғырықпын
Dialogue: 0,0:06:28.45,0:06:32.70,Default,,0,0,0,,Кодама мұндағының бәрін өз қалауы бойынша басқара алатын.
Dialogue: 0,0:06:33.46,0:06:36.30,Default,,0,0,0,,Everyone calls that power "M"
Dialogue: 0,0:06:36.30,0:06:38.94,Default,,0,0,0,,Мен оған құдайдай табындым.
Dialogue: 0,0:06:57.10,0:06:59.05,Default,,0,0,0,,Бұл жалпы мәселе.
Dialogue: 0,0:07:01.77,0:07:04.36,Default,,0,0,0,,Қанша уақыт өтсе де мен әлі бұзылған баламын
Dialogue: 0,0:07:07.36,0:07:09.03,Default,,0,0,0,,Ол енді келмейді
Dialogue: 0,0:07:12.80,0:07:13.86,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:07:14.28,0:07:16.95,Default,,0,0,0,,Ұзақ уақыттан кейін төсекте жақсы демалдыңыз ба?
Dialogue: 0,0:07:16.95,0:07:18.13,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:07:18.13,0:07:21.00,Default,,0,0,0,,Әй, сенің де қабілетің бар ма?
Dialogue: 0,0:07:22.02,0:07:24.75,Default,,0,0,0,,Мен... жай ғана үйсіз адаммын.
Dialogue: 0,0:07:25.32,0:07:27.00,Default,,0,0,0,,Саяхатшы?
Dialogue: 0,0:07:27.00,0:07:28.00,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:07:28.00,0:07:29.92,Default,,0,0,0,,Менің қоятын жерім жоқ.
Dialogue: 0,0:07:31.05,0:07:34.39,Default,,0,0,0,,Осы уақытқа дейін көптеген жерлерді араладық.
Dialogue: 0,0:07:35.42,0:07:38.14,Default,,0,0,0,,Ақырында мен бұл жерді таптым
Dialogue: 0,0:07:38.53,0:07:41.95,Default,,0,0,0,,Бұл өте сабырлы, мейірімді дүние.
Dialogue: 0,0:07:41.95,0:07:43.72,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:44.49,0:07:45.56,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:07:46.23,0:07:49.10,Default,,0,0,0,,Әй, сен неге жалғызсың?
Dialogue: 0,0:07:49.10,0:07:51.55,Default,,0,0,0,,Сен жалғыз келген сияқты емессің, солай ма?
Dialogue: 0,0:07:51.55,0:07:52.85,Default,,0,0,0,,Шынымен бе? Оған екеуі неге керек болды?
Dialogue: 0,0:07:52.85,0:07:53.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:53.53,0:07:58.11,Default,,0,0,0,,Менде құнды ештеңе жоқ, саған пайдалы болатын қабілетім жоқ.
Dialogue: 0,0:07:59.64,0:08:01.25,Default,,0,0,0,,Кофуку, Хиёри-чанды ластан тазала.
Dialogue: 0,0:08:02.41,0:08:03.79,Default,,0,0,0,,Олай болса тыңдауға рұқсат етіңіз.
Dialogue: 0,0:08:05.79,0:08:08.84,Default,,0,0,0,,Осы уақытқа дейін көрген дүние
Dialogue: 0,0:08:10.18,0:08:12.08,Default,,0,0,0,,Бұл туралы айтудың қажеті жоқ
Dialogue: 0,0:08:12.78,0:08:14.09,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:08:14.55,0:08:17.05,Default,,0,0,0,,Төтенше мағынасыз болу дұрыс.
Dialogue: 0,0:08:17.05,0:08:19.40,Default,,0,0,0,,Барлығы ақпаратқа құштар.
Dialogue: 0,0:08:19.40,0:08:23.25,Default,,0,0,0,,Иә, онда кешкі астан кейін бәрі естісін.
Dialogue: 0,0:08:23.25,0:08:24.98,Default,,0,0,0,,О... Эй, мұны істе...
Dialogue: 0,0:08:26.33,0:08:29.36,Default,,0,0,0,,Сәл ерте, бірақ бүгін түн деп атайық.
Dialogue: 0,0:08:29.82,0:08:31.21,Default,,0,0,0,,Бұл толған ай түні
Dialogue: 0,0:08:33.95,0:08:35.61,Default,,0,0,0,,Ал, мен оны асыға күтемін.
Dialogue: 0,0:08:36.03,0:08:36.82,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:08:42.52,0:08:44.00,Default,,0,0,0,,Барлығы, кешкі ас!
Dialogue: 0,0:08:45.55,0:08:47.25,Default,,0,0,0,,Мені мазақ ет
Dialogue: 0,0:08:47.86,0:08:52.68,Default,,0,0,0,,Оның мейірімділігі маған қорқынышты көрінді.
Dialogue: 0,0:08:57.18,0:08:58.78,Default,,0,0,0,,Олар өтірікшілер.
Dialogue: 0,0:09:03.36,0:09:05.75,Default,,0,0,0,,Мен бәрібір ештеңеге сенбесем де.
Dialogue: 0,0:09:14.06,0:09:14.66,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:18.68,0:09:20.80,Default,,0,0,0,,Дәмі бұрынғыдай емес, солай емес пе?
Dialogue: 0,0:09:21.52,0:09:23.38,Default,,0,0,0,,Келіңіздер, күн ыстық.
Dialogue: 0,0:09:26.95,0:09:28.00,Default,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:09:28.00,0:09:29.14,Default,,0,0,0,,Ұстамаңыз
Dialogue: 0,0:09:29.14,0:09:30.53,Default,,0,0,0,,Мен мұның қажеті жоқ дедім!
Dialogue: 0,0:09:35.94,0:09:36.91,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:09:38.23,0:09:38.73,Default,,0,0,0,,Қат!
Dialogue: 0,0:09:39.68,0:09:43.29,Default,,0,0,0,,Боқ, боқ, боқ, бейбақ!
Dialogue: 0,0:09:54.87,0:09:55.73,Default,,0,0,0,,Орындалды
Dialogue: 0,0:09:56.87,0:09:59.15,Default,,0,0,0,,Жарайды, сенің мысық тілің бар, солай ма?
Dialogue: 0,0:10:01.28,0:10:03.20,Default,,0,0,0,,Иә, дәл
Dialogue: 0,0:10:03.20,0:10:04.90,Default,,0,0,0,,Міне, ішіңіз.
Dialogue: 0,0:10:04.90,0:10:05.57,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:10:05.57,0:10:06.46,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:10:17.53,0:10:18.06,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:19.69,0:10:20.91,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:10:26.08,0:10:27.64,Default,,0,0,0,,Тым тұзды
Dialogue: 0,0:10:30.09,0:10:33.65,Default,,0,0,0,,Иә, мен тұзды тым көп қостым деп ойлаймын.
Dialogue: 0,0:10:34.60,0:10:37.20,Default,,0,0,0,,Тұзды сорпаны бірінші рет ішіп отырмын.
Dialogue: 0,0:10:37.20,0:10:38.15,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:10:38.97,0:10:41.53,Default,,0,0,0,,Иә, келесі жолы мұқият боламын.
Dialogue: 0,0:10:42.51,0:10:45.53,Default,,0,0,0,,Мен өзімнен ұялып, көңілім қалды.
Dialogue: 0,0:10:47.02,0:10:48.79,Default,,0,0,0,,Мен аздап бақытты болдым.
Dialogue: 0,0:10:50.07,0:10:52.38,Default,,0,0,0,,Сіз таңқаларлық оңайсыз.
Dialogue: 0,0:10:53.44,0:10:55.90,Default,,0,0,0,,Бірақ мен аздап түсіндім деп ойлаймын.
Dialogue: 0,0:10:55.90,0:10:56.80,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:56.80,0:10:58.30,Default,,0,0,0,,А, сәл ғана!
Dialogue: 0,0:11:01.43,0:11:04.15,Default,,0,0,0,,Мен мұны істемеуім керек еді. Бұл сәтсіздік болды.
Dialogue: 0,0:11:04.15,0:11:05.15,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:05.15,0:11:09.15,Default,,0,0,0,,А, менде өкініштен басқа ештеңе жоқ сияқты.
Dialogue: 0,0:11:09.15,0:11:12.20,Default,,0,0,0,,Мен өмірімнің көп бөлігін осымен өткіземін.
Dialogue: 0,0:11:12.20,0:11:15.10,Default,,0,0,0,,Және тағы да өкінесің.
Dialogue: 0,0:11:15.10,0:11:18.30,Default,,0,0,0,,Уау, сен өкінген данышпансың!
Dialogue: 0,0:11:18.30,0:11:20.90,Default,,0,0,0,,Өкінбейсіз бе?
Dialogue: 0,0:11:20.90,0:11:24.55,Default,,0,0,0,,Мысалы, «осы әлемге» ағып кету туралы
Dialogue: 0,0:11:24.55,0:11:25.90,Default,,0,0,0,,Мен жасамаймын
Dialogue: 0,0:11:25.90,0:11:27.25,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:27.25,0:11:30.83,Default,,0,0,0,,Өйткені менің таңдауым болмады.
Dialogue: 0,0:11:30.83,0:11:35.04,Default,,0,0,0,,Әдеттегідей мектепке барыңыз, әдеттегідей сабақ алыңыз.
Dialogue: 0,0:11:35.58,0:11:37.04,Default,,0,0,0,,Мен мұны білмей тұрып, осында болдым.
Dialogue: 0,0:11:38.46,0:11:41.80,Default,,0,0,0,,Өкінгім келсе де, өкіне алмаймын.
Dialogue: 0,0:11:41.80,0:11:42.76,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:11:45.69,0:11:48.78,Default,,0,0,0,,Біз тек алға жылжи аламыз.
Dialogue: 0,0:11:52.21,0:11:53.60,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:53.60,0:11:59.02,Default,,0,0,0,,Бұл менің ұзақ сапарымның соңы екеніне сендім.
Dialogue: 0,0:11:59.36,0:12:02.53,Default,,0,0,0,,Ол күндер мәңгілікке жалғасады деп ойладым.
Dialogue: 0,0:12:03.52,0:12:07.04,Default,,0,0,0,,Мен бұл мәңгілікке созылады деп ойладым...
Dialogue: 0,0:12:09.80,0:12:11.75,Default,,0,0,0,,Сіз мұнда қанша уақыт болдыңыз?
Dialogue: 0,0:12:11.75,0:12:14.00,Default,,0,0,0,,Құстар шулағандықтан таптым.
Dialogue: 0,0:12:14.00,0:12:15.57,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:12:22.84,0:12:24.57,Default,,0,0,0,,Маған атыңды айт
Dialogue: 0,0:12:37.55,0:12:41.55,Default,,0,0,0,,Сен... сондай ұсқынсызсың
Dialogue: 0,0:12:49.54,0:12:51.65,Default,,0,0,0,,Барлығы бұл туралы айтып жатыр
Dialogue: 0,0:12:51.65,0:12:54.96,Default,,0,0,0,,Індеттің себебі сол адам шығар.
Dialogue: 0,0:12:55.50,0:12:57.00,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:12:57.65,0:12:59.95,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:12:59.95,0:13:04.32,Default,,0,0,0,,Мүмкін болса, оны тастағым келмейді.
Dialogue: 0,0:13:06.25,0:13:10.35,Default,,0,0,0,,Ол маған қарап: ``Мен ұсқынсызмын'' деді.
Dialogue: 0,0:13:10.35,0:13:11.89,Default,,0,0,0,,Мен ойланбастан айттым.
Dialogue: 0,0:13:12.85,0:13:14.78,Default,,0,0,0,,Сен маған шындықты айттың.
Dialogue: 0,0:13:15.68,0:13:16.85,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:13:16.85,0:13:21.19,Default,,0,0,0,,Егер мен бұл ісіктің себебін таба алсам, мен онымен бірдеңе істей аламын деп ойлаймын.
Dialogue: 0,0:13:22.05,0:13:23.95,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:23.95,0:13:26.45,Default,,0,0,0,,Мен не істеуім керек деп ойлайсыз?
Dialogue: 0,0:13:27.95,0:13:29.20,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:32.78,0:13:35.33,Default,,0,0,0,,Сіздің ойыңыз дұрыс деп ойлаймын.
Dialogue: 0,0:13:36.44,0:13:39.83,Default,,0,0,0,,Шынымен бе? Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:13:40.30,0:13:43.21,Default,,0,0,0,,Әрине, сіз әрқашан дұрыссыз
Dialogue: 0,0:13:43.75,0:13:44.74,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:13:47.81,0:13:51.09,Default,,0,0,0,,Мен... Мен онша жақсы адам емеспін.
Dialogue: 0,0:13:52.50,0:13:56.87,Default,,0,0,0,,Ол сізге сәл ұқсайды, мұнда жаңа.
Dialogue: 0,0:13:59.63,0:14:02.06,Default,,0,0,0,,Мен басқа жаққа қарап тұрдым
Dialogue: 0,0:14:02.52,0:14:04.32,Default,,0,0,0,,Оның қателіктерінен
Dialogue: 0,0:14:05.89,0:14:10.36,Default,,0,0,0,,Мен оның таңдауын түзетуім керек еді.
Dialogue: 0,0:14:11.59,0:14:13.55,Default,,0,0,0,,Бірақ алмады
Dialogue: 0,0:14:13.55,0:14:14.43,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:15.37,0:14:16.58,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:14:17.05,0:14:18.96,Default,,0,0,0,,Себебі мен оған сендім
Dialogue: 0,0:14:20.19,0:14:22.46,Default,,0,0,0,,өзіне қарағанда
Dialogue: 0,0:14:27.48,0:14:28.84,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:14:29.22,0:14:30.84,Default,,0,0,0,,Ертең менімен кездесуге келіңіз
Dialogue: 0,0:14:31.41,0:14:33.22,Default,,0,0,0,,Мен де кеше де солай дедім.
Dialogue: 0,0:14:33.80,0:14:34.71,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:39.11,0:14:40.46,Default,,0,0,0,,Затқа айналды
Dialogue: 0,0:14:42.12,0:14:45.55,Default,,0,0,0,,Сіз маған жай ғана айтқаныңыздың өзінде.
Dialogue: 0,0:14:45.55,0:14:47.11,Default,,0,0,0,,Маған көрсет, әлі жоқ...
Dialogue: 0,0:14:47.11,0:14:48.70,Default,,0,0,0,,(Субару) Қабыл ал! (Шаттер дыбысы)
Dialogue: 0,0:14:48.70,0:14:50.86,Default,,0,0,0,,Ол мұнда болмаса...
Dialogue: 0,0:14:51.63,0:14:53.70,Default,,0,0,0,,Ол ауруды өзімен бірге ала келді.
Dialogue: 0,0:14:53.70,0:14:55.73,Default,,0,0,0,,Егер мен оны өлтірген болсам...
Dialogue: 0,0:15:03.61,0:15:06.50,Default,,0,0,0,,Мен сені «шіркін» деп атадым.
Dialogue: 0,0:15:06.50,0:15:07.63,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:15:08.53,0:15:11.40,Default,,0,0,0,,Мен оны әдемі деп ойладым.
Dialogue: 0,0:15:11.40,0:15:13.75,Default,,0,0,0,,Неге өтірік айттың?
Dialogue: 0,0:15:13.75,0:15:15.95,Default,,0,0,0,,Мен сізге ұнағаныңызды қалаймын
Dialogue: 0,0:15:15.95,0:15:18.60,Default,,0,0,0,,Сіз күткендей риза болдыңыз.
Dialogue: 0,0:15:18.60,0:15:20.89,Default,,0,0,0,,Адамның жүрегі қандай деп ойлайсың?
Dialogue: 0,0:15:21.24,0:15:23.90,Default,,0,0,0,,Бұл жиі айтылады.
Dialogue: 0,0:15:23.90,0:15:26.85,Default,,0,0,0,,Сіз бұл ісіктің себебісіз бе?
Dialogue: 0,0:15:26.85,0:15:28.40,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:15:28.93,0:15:31.32,Default,,0,0,0,,Мен оны осында әкелдім.
Dialogue: 0,0:15:31.32,0:15:35.20,Default,,0,0,0,,Олай болса, стратегияны айтып беріңізші.
Dialogue: 0,0:15:35.20,0:15:37.45,Default,,0,0,0,,Ісік емделетін болуы керек
Dialogue: 0,0:15:37.45,0:15:40.24,Default,,0,0,0,,Біреудің жарасын емдей алмайсың
Dialogue: 0,0:15:42.39,0:15:44.80,Default,,0,0,0,,Тіпті сіз де білуіңіз керек.
Dialogue: 0,0:15:44.80,0:15:46.96,Default,,0,0,0,,Бұл тек мен емес
Dialogue: 0,0:15:48.66,0:15:50.96,Default,,0,0,0,,Жетер, кеттік.
Dialogue: 0,0:15:50.96,0:15:52.72,Default,,0,0,0,,Себебі менің уақытым жоқ
Dialogue: 0,0:15:52.72,0:15:54.09,Default,,0,0,0,,Эй, күт!
Dialogue: 0,0:15:55.13,0:15:57.47,Default,,0,0,0,,Мен саған мынаны беремін, жарай ма?
Dialogue: 0,0:16:00.95,0:16:01.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:01.95,0:16:03.35,Default,,0,0,0,,Бұл әдемі, солай емес пе?
Dialogue: 0,0:16:03.35,0:16:06.61,Default,,0,0,0,,Бұл сіз 100 адамды өлтірсеңіз алатын нәрсе.
Dialogue: 0,0:16:07.48,0:16:10.95,Default,,0,0,0,,Мынау мың адам, мынау он мың адам
Dialogue: 0,0:16:10.95,0:16:12.86,Default,,0,0,0,,Әй, әдемі емес пе?
Dialogue: 0,0:16:14.00,0:16:15.70,Default,,0,0,0,,Жарайды, міне, гострайтингі тапсырысы формасы.
Dialogue: 0,0:16:15.70,0:16:18.80,Default,,0,0,0,,Кешіріңіз, бұл әрқашан солай.
Dialogue: 0,0:16:18.80,0:16:21.00,Default,,0,0,0,,Мен әрқашан қателесемін.
Dialogue: 0,0:16:21.00,0:16:23.70,Default,,0,0,0,,Ақыр аяғында сені жек көреді.
Dialogue: 0,0:16:23.70,0:16:26.88,Default,,0,0,0,,Мен не істерімді білмеймін!
Dialogue: 0,0:16:26.88,0:16:29.45,Default,,0,0,0,,Енді бізге жақындама
Dialogue: 0,0:16:29.45,0:16:31.76,Default,,0,0,0,,А, өтінемін, сонша қорықпа...
Dialogue: 0,0:16:32.14,0:16:33.76,Default,,0,0,0,,Өтінемін, бізден жоғал!
Dialogue: 0,0:16:39.15,0:16:41.60,Default,,0,0,0,,Қат! Бұл әрқашан мен!
Dialogue: 0,0:16:42.06,0:16:44.10,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:16:45.10,0:16:47.48,Default,,0,0,0,,Ямабико ауырып қалмады ма?
Dialogue: 0,0:16:48.01,0:16:52.48,Default,,0,0,0,,А, мен мұны бәрінен де жек көрдім.
Dialogue: 0,0:16:53.19,0:16:58.42,Default,,0,0,0,,Ол оба емес, басқа «осы дүние» әкелдім деді.
Dialogue: 0,0:16:59.28,0:17:02.74,Default,,0,0,0,,Эмоциялық жаралар ісікке айналып, заттайтын дүние
Dialogue: 0,0:17:03.23,0:17:06.90,Default,,0,0,0,,Ол бұл дүниені «Жарық өнер» деп атады.
Dialogue: 0,0:17:06.90,0:17:10.20,Default,,0,0,0,,Иә, бұл менің өнерім.
Dialogue: 0,0:17:10.20,0:17:12.50,Default,,0,0,0,,Мен көбірек жинағым келеді.
Dialogue: 0,0:17:13.21,0:17:16.06,Default,,0,0,0,,Қарашы, сен маған тиіс, жақында.
Dialogue: 0,0:17:17.83,0:17:20.05,Default,,0,0,0,,Эй, сен білгің келмейді ме?
Dialogue: 0,0:17:20.05,0:17:22.46,Default,,0,0,0,,Неге жалғыз сен ауырмайды?
Dialogue: 0,0:17:23.71,0:17:25.60,Default,,0,0,0,,Ах, сонда ол ма еді?
Dialogue: 0,0:17:25.60,0:17:30.31,Default,,0,0,0,,Себебі «бұл әлем» сіз жасаған дүние.
Dialogue: 0,0:17:32.08,0:17:34.57,Default,,0,0,0,,Мен мұны сен айтпай тұрып түсінбедім.
Dialogue: 0,0:17:35.67,0:17:38.78,Default,,0,0,0,,Жүрегіңіздің ішкі дүниесін заттандыратын күш
Dialogue: 0,0:17:45.54,0:17:48.04,Default,,0,0,0,,Бұл менің қабілетім болды.
Dialogue: 0,0:17:49.12,0:17:53.95,Default,,0,0,0,,Мен мұны білмей тұрып, өз қабығыма жабылдым.
Dialogue: 0,0:17:53.95,0:17:57.45,Default,,0,0,0,,Сондықтан мен ғана обадан зардап шекпегенмін.
Dialogue: 0,0:17:57.45,0:18:01.80,Default,,0,0,0,,Шекара ішінде жаңғырық күші мағынасыз болды.
Dialogue: 0,0:18:02.16,0:18:07.70,Default,,0,0,0,,Жараның себебі «осы дүниеден» тыс болып жатқан оқиғаларда жатыр.
Dialogue: 0,0:18:07.70,0:18:11.15,Default,,0,0,0,,Балалар сендер шешулерің керек еді.
Dialogue: 0,0:18:11.15,0:18:12.31,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:18:12.69,0:18:15.05,Default,,0,0,0,,Тек өзіңді өзгерту керек.
Dialogue: 0,0:18:15.05,0:18:19.12,Default,,0,0,0,,Мен қабығымнан шығып, сыртқа секіруім керек еді.
Dialogue: 0,0:18:20.15,0:18:22.55,Default,,0,0,0,,Бірақ қазірдің өзінде кеш
Dialogue: 0,0:18:22.55,0:18:24.06,Default,,0,0,0,,Мен үйге барамын.
Dialogue: 0,0:18:31.20,0:18:34.25,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды түсіндім.
Dialogue: 0,0:18:34.25,0:18:38.21,Default,,0,0,0,,Бірақ, қолымыздан келмеді, кесілген өзіміз.
Dialogue: 0,0:18:38.65,0:18:40.90,Default,,0,0,0,,Бізде таңдау жоқ.
Dialogue: 0,0:18:40.90,0:18:43.47,Default,,0,0,0,,Сіз де естідіңіз бе? Маған дауысыңды бер
Dialogue: 0,0:18:44.13,0:18:45.97,Default,,0,0,0,,Сен кімсің!
Dialogue: 0,0:18:46.35,0:18:47.95,Default,,0,0,0,,Камадо, тұр…
Dialogue: 0,0:18:47.95,0:18:50.23,Default,,0,0,0,,Біз бұрын кездессек те.
Dialogue: 0,0:18:50.85,0:18:52.85,Default,,0,0,0,,Сіз оны көруіңіз керек еді.
Dialogue: 0,0:18:52.85,0:18:57.05,Default,,0,0,0,,Көп жерде, бір рет емес, көп рет.
Dialogue: 0,0:18:59.13,0:19:01.36,Default,,0,0,0,,Сіз қалай ойлайсыз? Жақсы қыз, жақсы қыз.
Dialogue: 0,0:19:02.14,0:19:04.87,Default,,0,0,0,,Кішкене батылдық болса ғой
Dialogue: 0,0:19:05.76,0:19:08.80,Default,,0,0,0,,Мен ол баланы құтқара алар едім.
Dialogue: 0,0:19:08.80,0:19:11.50,Default,,0,0,0,,Ол күтіп тұрды.
Dialogue: 0,0:19:11.50,0:19:15.75,Default,,0,0,0,,Өте жұмсақ және таңқаларлық қызықсыз
Dialogue: 0,0:19:15.75,0:19:19.25,Default,,0,0,0,,«Бұл әлем» сізсіз.
Dialogue: 0,0:19:19.25,0:19:20.77,Default,,0,0,0,,Олай болса сау болыңыз
Dialogue: 0,0:19:21.94,0:19:23.13,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:19:23.54,0:19:25.14,Default,,0,0,0,,Сіз бұлай айтқан жоқсыз.
Dialogue: 0,0:19:25.62,0:19:28.14,Default,,0,0,0,,Менің атым «Соғыс»
Dialogue: 0,0:19:30.69,0:19:33.15,Default,,0,0,0,,Мен саған осылай тез ұшыңдар дедім.
Dialogue: 0,0:19:34.06,0:19:35.65,Default,,0,0,0,,Жаман нәрсе жасады
Dialogue: 0,0:19:36.75,0:19:39.00,Default,,0,0,0,,Егер мен саған көмектеспесем
Dialogue: 0,0:19:39.00,0:19:42.54,Default,,0,0,0,,Бұл бала қандай да бір алыс әлемге ұшуы керек еді.
Dialogue: 0,0:19:43.71,0:19:47.05,Default,,0,0,0,,Мен бұл балаға көмектесіп жатырмын деп ойладым.
Dialogue: 0,0:19:47.05,0:19:49.41,Default,,0,0,0,,Негізі мен сені мазалап жүр едім.
Dialogue: 0,0:19:50.15,0:19:51.55,Default,,0,0,0,,Ямабико
Dialogue: 0,0:19:51.55,0:19:52.47,Default,,0,0,0,,Не?
Dialogue: 0,0:19:53.21,0:19:55.75,Default,,0,0,0,,Менің айтқанымды тыңдайсың ба?
Dialogue: 0,0:19:55.75,0:19:56.92,Default,,0,0,0,,Әрине.
Dialogue: 0,0:19:57.35,0:20:01.42,Default,,0,0,0,,Бір күні мен берген уәдемді орындаймын.
Dialogue: 0,0:20:01.85,0:20:04.08,Default,,0,0,0,,Сіз бұл жерден ұшып кетесіз
Dialogue: 0,0:20:05.13,0:20:07.18,Default,,0,0,0,,Бұл шынайы дүние емес
Dialogue: 0,0:20:11.80,0:20:12.86,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:20:15.31,0:20:18.02,Default,,0,0,0,,Эй, сен мұны істей аласың.
Dialogue: 0,0:20:19.15,0:20:20.90,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:20:22.87,0:20:24.57,Default,,0,0,0,,Өйткені сіз...
Dialogue: 0,0:20:31.80,0:20:33.30,Default,,0,0,0,,Және…
Dialogue: 0,0:20:33.30,0:20:36.81,Default,,0,0,0,,Орманда бір ғана ит қалды.
Dialogue: 0,0:20:39.66,0:20:41.59,Default,,0,0,0,,Ол дұрыс айтты
Dialogue: 0,0:20:42.13,0:20:44.59,Default,,0,0,0,,Менде көптеген мүмкіндіктер болды.
Dialogue: 0,0:20:45.12,0:20:47.02,Default,,0,0,0,,Оны құтқаруға мүмкіндік бар ма?
Dialogue: 0,0:20:48.12,0:20:51.22,Default,,0,0,0,,Соның бәріне көз жұмды
Dialogue: 0,0:20:51.22,0:20:53.25,Default,,0,0,0,,Оның тілегі
Dialogue: 0,0:20:53.25,0:20:58.23,Default,,0,0,0,,Мен жай ғана сенің менімен бірге сыртқы әлемді аралауыңды қаладым.
Dialogue: 0,0:20:59.73,0:21:02.85,Default,,0,0,0,,Ол мені күтіп отыр
Dialogue: 0,0:21:02.85,0:21:06.74,Default,,0,0,0,,Бірақ мен жауап бере алмадым.
Dialogue: 0,0:21:08.97,0:21:10.70,Default,,0,0,0,,Созып барады.
Dialogue: 0,0:21:11.59,0:21:13.09,Default,,0,0,0,,Ямабико
Dialogue: 0,0:21:13.09,0:21:14.42,Default,,0,0,0,,Не?
Dialogue: 0,0:21:14.42,0:21:15.76,Default,,0,0,0,,Мен сенімен ұйықтай аламын ба?
Dialogue: 0,0:21:24.01,0:21:25.01,Default,,0,0,0,,Эй
Dialogue: 0,0:21:25.30,0:21:26.76,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:21:29.92,0:21:31.75,Default,,0,0,0,,Ендеше бірге серуендейміз
Dialogue: 0,0:21:31.75,0:21:36.20,Default,,0,0,0,,Бірде сен маған қаңқаға толы жол туралы айттың.
Dialogue: 0,0:21:36.20,0:21:38.22,Default,,0,0,0,,Балмұздақ жеу кезінде
Dialogue: 0,0:21:38.90,0:21:39.52,Default,,0,0,0,,О
Dialogue: 0,0:21:41.00,0:21:42.27,Default,,0,0,0,,Екі адам
Dialogue: 0,0:21:54.88,0:21:56.21,Default,,0,0,0,,Сіз ұйықтамайсыз ба?
Dialogue: 0,0:21:56.92,0:21:59.32,Default,,0,0,0,,Иә, мен көп нәрсе туралы ойладым.
Dialogue: 0,0:22:00.67,0:22:04.30,Default,,0,0,0,,Неліктен мен ол кезде олай жасадым?
Dialogue: 0,0:22:04.30,0:22:06.55,Default,,0,0,0,,О, менің ойымша, жоқ.
Dialogue: 0,0:22:06.55,0:22:10.23,Default,,0,0,0,,Мен жай ғана осындай нәрселерді ойлап жүрдім... Менің қолымнан ештеңе келмейді.
Dialogue: 0,0:22:10.23,0:22:11.85,Default,,0,0,0,,Мен енді ұйықтай алмаймын
Dialogue: 0,0:22:12.75,0:22:16.06,Default,,0,0,0,,Мен жай ғана жарық алғым келді
Dialogue: 0,0:22:17.07,0:22:19.31,Default,,0,0,0,,Жарықты жоғалтып алудан қорқу
Dialogue: 0,0:22:19.69,0:22:21.62,Default,,0,0,0,,Қадамды соңына дейін жасай алмады
Dialogue: 0,0:22:23.69,0:22:25.66,Default,,0,0,0,,Бірақ мен ақыры секіріп үлгердім.
Dialogue: 0,0:22:32.45,0:22:33.84,Default,,0,0,0,,Оған 5000 жыл қажет болды
Dialogue: 0,0:22:35.74,0:22:37.33,Default,,0,0,0,,Мен де істей аламын ба?
Dialogue: 0,0:22:37.92,0:22:38.83,Default,,0,0,0,,О
Dialogue: 0,0:22:39.33,0:22:40.19,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:22:47.63,0:22:49.76,Default,,0,0,0,,Бұл сирек кездеседі. Біраз уақыт өтті.
Dialogue: 0,0:22:51.05,0:22:51.92,Default,,0,0,0,,Мен жай ғана жағдайды біраз бақылап тұрамын.
Dialogue: 0,0:22:52.70,0:22:54.55,Default,,0,0,0,,Бұл тек белгіленген уақыт.
Dialogue: 0,0:22:54.55,0:22:58.18,Default,,0,0,0,,Иә? Танысқан күннен бері екі апта күттім.
Dialogue: 0,0:22:59.52,0:23:01.31,Default,,0,0,0,,Иә? Бұл орынсыз
Dialogue: 0,0:23:01.78,0:23:03.75,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,0:23:03.75,0:23:07.13,Default,,0,0,0,,Екеуміз үшін уақыт ағымы әртүрлі болса керек.
Dialogue: 0,0:23:09.99,0:23:11.32,Default,,0,0,0,,Бар болғаны
Dialogue: 0,0:23:12.25,0:23:12.91,Default,,0,0,0,,Иә
Dialogue: 0,0:23:16.69,0:23:19.45,Default,,0,0,0,,Бұл аралда болды.
Dialogue: 0,0:23:19.45,0:23:23.27,Default,,0,0,0,,Бірақ бұл соғысты кім жүргізді?
Dialogue: 0,0:23:23.27,0:23:25.93,Default,,0,0,0,,Ол құдайды өлтіруді көздеді.
Dialogue: 0,0:23:26.71,0:23:28.74,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:23:28.74,0:23:29.34,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:23:30.29,0:23:32.09,Default,,0,0,0,,Мен сені өлтірсем де
Dialogue: 0,0:23:32.47,0:23:34.31,Default,,0,0,0,,Бұл бірдеңені өзгерте ме?
Dialogue: 0,0:23:35.81,0:23:40.81,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
