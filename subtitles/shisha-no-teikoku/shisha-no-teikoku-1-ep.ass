Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:27.56,0:00:31.57,Default,,0,0,0,,Алдымен мен өз жұмысымды түсіндіруім керек.
Dialogue: 0,0:00:33.32,0:00:39.12,Default,,0,0,0,,Бізге ең алдымен керек нәрсе – мәйіт.
Dialogue: 0,0:00:52.63,0:00:54.63,Default,,0,0,0,,Адам қайтыс болғанда —
Dialogue: 0,0:00:54.76,0:01:00.22,Default,,0,0,0,,Дене салмағының тірі кезімен салыстырғанда шамамен 21 грамға азайғаны расталды.
Dialogue: 0,0:01:02.31,0:01:04.43,Default,,0,0,0,,Бұл рухани элементтердің салмағы
Dialogue: 0,0:01:04.85,0:01:07.15,Default,,0,0,0,,Жанның салмағы деп аталады.
Dialogue: 0,0:01:09.81,0:01:12.61,Default,,0,0,0,,Біз жансыз денеміз
Dialogue: 0,0:01:12.73,0:01:15.11,Default,,0,0,0,,Псевдорухани элементтерді орнату арқылы—
Dialogue: 0,0:01:15.24,0:01:17.28,Default,,0,0,0,,Өлгендерді тірілт
Dialogue: 0,0:01:18.49,0:01:21.62,Default,,0,0,0,,Бірақ бұл жалған жан
Dialogue: 0,0:01:27.46,0:01:29.17,Default,,0,0,0,,Доктор Виктор Франкенштейн...
Dialogue: 0,0:01:29.29,0:01:31.63,Default,,0,0,0,,Тіркелген алғашқы мәйіт
Dialogue: 0,0:01:32.38,0:01:33.71,Default,,0,0,0,,«Бір»
Dialogue: 0,0:01:34.51,0:01:38.18,Default,,0,0,0,,Сөз сөйлеп, махаббат іздейді —
Dialogue: 0,0:01:38.30,0:01:40.30,Default,,0,0,0,,Оның тіпті адам өлтіру ниеті болғаны айтылады.
Dialogue: 0,0:01:41.93,0:01:44.14,Default,,0,0,0,,Және үмітсіздіктің соңында -
Dialogue: 0,0:01:44.27,0:01:46.39,Default,,0,0,0,,Өзін өзі жасаған технология—
Dialogue: 0,0:01:46.52,0:01:50.27,Default,,0,0,0,,«Виктордың естелігімен» бірге жоғалып кетті
Dialogue: 0,0:01:53.69,0:01:57.53,Default,,0,0,0,,Бізге жалғызды көшіру қалды.
Dialogue: 0,0:01:57.65,0:02:02.16,Default,,0,0,0,,Оның жаны да, тілі де жоқ, алпауыт.
Dialogue: 0,0:02:04.20,0:02:06.20,Default,,0,0,0,,Бірдің жаны болса —
Dialogue: 0,0:02:07.71,0:02:09.41,Default,,0,0,0,,Бос денеде—
Dialogue: 0,0:02:09.54,0:02:13.04,Default,,0,0,0,,21 грамм жанды қайтара алсам...
Dialogue: 0,0:02:14.05,0:02:16.34,Default,,0,0,0,,Қайтадан жоғалған -
Dialogue: 0,0:02:16.97,0:02:18.88,Default,,0,0,0,,Ол қайтып келеді?
Dialogue: 0,0:02:27.81,0:02:28.98,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:02:37.24,0:02:38.24,Default,,0,0,0,,Ах
Dialogue: 0,0:02:51.17,0:02:55.63,Default,,0,0,0,,Сіз мені көре аласыз ба? менің кім екенімді білесің бе?
Dialogue: 0,0:03:00.80,0:03:02.26,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:07.52,0:03:08.64,Default,,0,0,0,,Жаяу
Dialogue: 0,0:03:15.36,0:03:18.07,Default,,0,0,0,,А... тоқта.
Dialogue: 0,0:03:21.11,0:03:24.03,Default,,0,0,0,,Қуат жүйесі Мәселе жоқ
Dialogue: 0,0:03:27.41,0:03:28.24,Default,,0,0,0,,Қолдарыңызды алыңыздар
Dialogue: 0,0:03:30.16,0:03:31.33,Default,,0,0,0,,Қаламды алыңыз
Dialogue: 0,0:03:48.72,0:03:51.56,Default,,0,0,0,,Әрбір сөз бен іс-әрекетті жазып алыңыз
Dialogue: 0,0:03:53.27,0:03:56.40,Default,,0,0,0,,Бұл сіздің жаныңызға айналады деп үміттенемін
Dialogue: 0,0:03:58.52,0:04:01.07,Default,,0,0,0,,Жұмаға қош келдіңіз
Dialogue: 0,0:04:09.12,0:04:12.83,Default,,0,0,0,,Бүгінгі таңда 20-ғасыр қол жетерліктей.
Dialogue: 0,0:04:13.41,0:04:17.67,Default,,0,0,0,,Мәйіт технологиясы ел тағдырын өз қолында ұстады.
Dialogue: 0,0:04:20.55,0:04:23.42,Default,,0,0,0,,Доктор Виктор Франкенштейн...
Dialogue: 0,0:04:23.55,0:04:26.84,Default,,0,0,0,,100 жыл бұрын өлгендердің сәтті қайта тірілуі —
Dialogue: 0,0:04:28.64,0:04:33.48,Default,,0,0,0,,Адамдар өлгендердің қайта тірілуінен қорқады және жек көреді.
Dialogue: 0,0:04:33.60,0:04:38.31,Default,,0,0,0,,Мәйіт технологиясын ешқашан мойындауға тырыспаған.
Dialogue: 0,0:04:41.69,0:04:43.95,Default,,0,0,0,,Мәйітті бірінші қабылдаған адам:
Dialogue: 0,0:04:44.07,0:04:45.95,Default,,0,0,0,,Олар әйелдер болды.
Dialogue: 0,0:04:47.37,0:04:49.49,Default,,0,0,0,,Мәйіт солдат болса...
Dialogue: 0,0:04:49.62,0:04:54.12,Default,,0,0,0,,Ұлыңызды немесе күйеуіңізді соғыста жоғалтып алмау
Dialogue: 0,0:04:56.42,0:04:58.54,Default,,0,0,0,,Мәйіт технологиясын әскери қолдану
Dialogue: 0,0:04:59.88,0:05:01.92,Default,,0,0,0,,Әлем мұны байқады
Dialogue: 0,0:05:02.05,0:05:05.51,Default,,0,0,0,,Біз мәйіт технологиясын жасау үшін көп жұмыс жасадық.
Dialogue: 0,0:05:10.26,0:05:12.22,Default,,0,0,0,,Құрылған әскери техника:
Dialogue: 0,0:05:12.35,0:05:14.02,Default,,0,0,0,,Азаматтық мақсатқа бағытталды -
Dialogue: 0,0:05:14.35,0:05:17.27,Default,,0,0,0,,Адамдардың өмірін мәңгілікке өзгертті
Dialogue: 0,0:05:19.90,0:05:22.07,Default,,0,0,0,,Талдау мекемесінде бірнеше рет—
Dialogue: 0,0:05:22.19,0:05:23.94,Default,,0,0,0,,Модельдеу—
Dialogue: 0,0:05:24.07,0:05:26.70,Default,,0,0,0,,Перфокартада жазылған псевдорухани элемент:
Dialogue: 0,0:05:26.82,0:05:28.95,Default,,0,0,0,,«Некропалым» деп аталады—
Dialogue: 0,0:05:29.57,0:05:31.45,Default,,0,0,0,,Жаттықтырушы немесе батлер —
Dialogue: 0,0:05:31.58,0:05:33.20,Default,,0,0,0,,Зауыт жұмысшысы ретінде—
Dialogue: 0,0:05:33.54,0:05:37.29,Default,,0,0,0,,Оларды оңтайландыру және бейімдеу
Dialogue: 0,0:05:44.21,0:05:47.47,Default,,0,0,0,,Жер өлексеге толы.
Dialogue: 0,0:05:47.59,0:05:50.26,Default,,0,0,0,,Әлемдік экономиканы қазір өліктер басқарады.
Dialogue: 0,0:05:50.39,0:05:54.10,Default,,0,0,0,,Мені қолдады десем, артық айтқандық емес.
Dialogue: 0,0:05:57.69,0:06:01.56,Default,,0,0,0,,Лондон мұнарасы, бұрынғы террор сарайы
Dialogue: 0,0:06:04.40,0:06:06.57,Default,,0,0,0,,Мұнда мәйіт инженерлері —
Dialogue: 0,0:06:07.03,0:06:09.53,Default,,0,0,0,,Некрозды күн сайын жақсарту—
Dialogue: 0,0:06:09.66,0:06:13.70,Default,,0,0,0,,Дүние жүзіндегі мәйіттердің мазмұнын үнемі жаңартып отыру
Dialogue: 0,0:06:14.91,0:06:18.92,Default,,0,0,0,,Керемет есептеу қуаты бар аналитикалық қозғалтқыш—
Dialogue: 0,0:06:19.04,0:06:21.71,Default,,0,0,0,,Чарльз Бэббидж
Dialogue: 0,0:06:27.34,0:06:30.93,Default,,0,0,0,,Бұл мәйіттің оқиғасы.
Dialogue: 0,0:06:50.45,0:06:54.45,Default,,0,0,0,,(Уотсонның ұйқысы)
Dialogue: 0,0:06:55.24,0:06:57.12,Default,,0,0,0,,Кембридж қозғалтқышына—
Dialogue: 0,0:06:57.37,0:07:01.17,Default,,0,0,0,,Кеңейтілген Эдинбург тілінің қос агенттік рух элементін талдау
Dialogue: 0,0:07:01.71,0:07:04.84,Default,,0,0,0,,Сіз аз уақыттың ішінде көп нәрсеге қол жеткіздіңіз.
Dialogue: 0,0:07:05.67,0:07:07.67,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:10.76,0:07:16.01,Default,,0,0,0,,Бірақ сіз білетін шығарсыз, рухани элементтерді талдау мемлекеттік құпия болып табылады.
Dialogue: 0,0:07:17.01,0:07:18.81,Default,,0,0,0,,Мен мұның ауыр қылмыс екенін білсем де...
Dialogue: 0,0:07:20.52,0:07:23.56,Default,,0,0,0,,Қауіпті көпірден өткеннен кейін не істегіңіз келеді?
Dialogue: 0,0:07:25.61,0:07:28.28,Default,,0,0,0,,Қайтыс болған отбасы жоқтау айтады.
Dialogue: 0,0:07:28.48,0:07:32.32,Default,,0,0,0,,Марқұмның жақын досы мәйітті ұрлағанын білсем ше?
Dialogue: 0,0:07:33.91,0:07:36.87,Default,,0,0,0,,Өсекшілер де үндемейді.
Dialogue: 0,0:07:37.83,0:07:42.58,Default,,0,0,0,,Лондон университетінің үздік медицина студентінің ерекше махаббаты
Dialogue: 0,0:07:43.29,0:07:47.92,Default,,0,0,0,,Мәйіттерді рұқсатсыз тірілту үшін заңсыз некробағдарламаларды орнату
Dialogue: 0,0:07:48.05,0:07:49.59,Default,,0,0,0,,Түрмеден құтылу мүмкін емес
Dialogue: 0,0:07:53.68,0:07:57.56,Default,,0,0,0,,Иә, сен оны ұстайды деп ойламадың ба?
Dialogue: 0,0:07:58.93,0:08:01.77,Default,,0,0,0,,Хмм, жарайды.
Dialogue: 0,0:08:02.60,0:08:07.11,Default,,0,0,0,,Жертөледе шіріп кетуге соншама талант пен құштарлық...
Dialogue: 0,0:08:07.19,0:08:10.15,Default,,0,0,0,,Менің патшайым белгісіз емес
Dialogue: 0,0:08:13.36,0:08:15.87,Default,,0,0,0,,Кел, мәміле жасайық
Dialogue: 0,0:08:16.91,0:08:18.99,Default,,0,0,0,,Менің атым М
Dialogue: 0,0:08:19.12,0:08:21.91,Default,,0,0,0,,Британ империясы үшін жұмыс
Dialogue: 0,0:08:22.79,0:08:24.96,Default,,0,0,0,,Джон Уотсон
Dialogue: 0,0:09:01.91,0:09:02.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:08.21,0:09:12.34,Default,,0,0,0,,Американың бұрынғы президенті Улисс С. Грант
Dialogue: 0,0:09:13.26,0:09:18.26,Default,,0,0,0,,Сіз Азамат соғысы кезінде өсірген техникаларыңызды насихаттап жүрсіз бе?
Dialogue: 0,0:09:21.43,0:09:23.47,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:09:26.64,0:09:29.23,Default,,0,0,0,,Не... не? Қазіргісі
Dialogue: 0,0:09:29.36,0:09:30.86,Default,,0,0,0,,Не жарылды?
Dialogue: 0,0:09:30.98,0:09:32.69,Default,,0,0,0,,Б-бірақ… сәби аман.
Dialogue: 0,0:09:34.11,0:09:35.36,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:09:36.78,0:09:39.28,Default,,0,0,0,,(Тодороки) Алда не күтіп тұрғанын біртүрлі ұмытып кетіппін
Dialogue: 0,0:09:39.91,0:09:42.03,Default,,0,0,0,,Алаңдама, оқушы
Dialogue: 0,0:09:42.45,0:09:44.37,Default,,0,0,0,,Әй, не істеп жатырсың!
Dialogue: 0,0:09:45.37,0:09:48.00,Default,,0,0,0,,Майданға кіре берісте өлгің келмейді.
Dialogue: 0,0:09:48.08,0:09:49.58,Default,,0,0,0,,Ах... (жарылыс дыбысы)
Dialogue: 0,0:09:49.71,0:09:51.59,Default,,0,0,0,,Кеттік, а
Dialogue: 0,0:09:51.96,0:09:53.25,Default,,0,0,0,,Га
Dialogue: 0,0:09:57.17,0:09:58.13,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:58.55,0:10:02.72,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:10:02.85,0:10:04.93,Default,,0,0,0,,Ха (жылқының көрісі)
Dialogue: 0,0:10:06.02,0:10:07.23,Default,,0,0,0,,О!
Dialogue: 0,0:10:07.98,0:10:09.73,Default,,0,0,0,,Оны шайқаңыз! Ол жарылып кетеді!
Dialogue: 0,0:10:09.85,0:10:11.69,Default,,0,0,0,,Уф
Dialogue: 0,0:10:11.81,0:10:14.32,Default,,0,0,0,,жұма! Бірдеңе істе!
Dialogue: 0,0:10:17.74,0:10:20.11,Default,,0,0,0,,Уф, қарғыс атсын
Dialogue: 0,0:10:24.12,0:10:25.70,Default,,0,0,0,,Бұл не? Сол жігіттер
Dialogue: 0,0:10:26.29,0:10:28.41,Default,,0,0,0,,Бұл ресейлік мәйіт бомбасы.
Dialogue: 0,0:10:28.71,0:10:30.71,Default,,0,0,0,,Біз бомбаларды жүк ретінде алып жүрмейміз.
Dialogue: 0,0:10:31.17,0:10:33.46,Default,,0,0,0,,Мәйіттің өзі бомба
Dialogue: 0,0:10:33.75,0:10:37.05,Default,,0,0,0,,Майды глицеринге дейін ыдыратты ма?
Dialogue: 0,0:10:37.17,0:10:38.22,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:10:38.63,0:10:42.01,Default,,0,0,0,,Егер сізді қызықтырса, сізге жаңа адам келеді.
Dialogue: 0,0:10:43.18,0:10:44.10,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:44.22,0:10:46.47,Default,,0,0,0,,Ішке кіріп, ұстаңыз.
Dialogue: 0,0:10:47.73,0:10:49.27,Default,,0,0,0,,Уау
Dialogue: 0,0:10:49.39,0:10:51.65,Default,,0,0,0,,Орыстар да шарасыз сияқты. Апыр-ай.
Dialogue: 0,0:10:51.94,0:10:53.65,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:10:54.02,0:10:55.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:55.40,0:10:56.90,Default,,0,0,0,,Уау
Dialogue: 0,0:10:57.78,0:10:58.99,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:59.11,0:11:01.03,Default,,0,0,0,,Неліктен атылады? Уау
Dialogue: 0,0:11:01.66,0:11:05.03,Default,,0,0,0,,Қазына іздеп жүрген жалғыз біз емес екенбіз.
Dialogue: 0,0:11:05.66,0:11:08.70,Default,,0,0,0,,Жұма, сөмкеңдегі мылтықты шығар.
Dialogue: 0,0:11:12.92,0:11:14.09,Default,,0,0,0,,Уф
Dialogue: 0,0:11:14.34,0:11:15.17,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:20.26,0:11:22.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:24.39,0:11:25.22,Default,,0,0,0,,Уф
Dialogue: 0,0:11:25.60,0:11:26.64,Default,,0,0,0,,Тез тартыңыз!
Dialogue: 0,0:11:26.97,0:11:28.89,Default,,0,0,0,,Жұма Мына жігітті атып таста!
Dialogue: 0,0:11:31.44,0:11:35.40,Default,,0,0,0,,Жұма, қолыңдағы мылтықпен мына жігітті басынан атып таста!
Dialogue: 0,0:11:40.82,0:11:42.07,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:11:52.21,0:11:54.71,Default,,0,0,0,,Уф, сен табандысың.
Dialogue: 0,0:11:54.83,0:11:56.54,Default,,0,0,0,,Мені ауыстырыңыз.
Dialogue: 0,0:11:56.67,0:11:57.96,Default,,0,0,0,,«Ауыстыру»?
Dialogue: 0,0:11:58.09,0:12:00.01,Default,,0,0,0,,Осы жерде отырыңыз және тізгінді ұстаңыз.
Dialogue: 0,0:12:01.17,0:12:03.09,Default,,0,0,0,,Оңай болмаңыз
Dialogue: 0,0:12:07.22,0:12:08.22,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:11.48,0:12:13.35,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:12:20.36,0:12:23.32,Default,,0,0,0,,Фу~ Сен тазаладың ба?
Dialogue: 0,0:12:23.74,0:12:25.95,Default,,0,0,0,,Сіз Барнабисіз бе?
Dialogue: 0,0:12:26.07,0:12:28.28,Default,,0,0,0,,Капитан Фредерик Бернаби
Dialogue: 0,0:12:28.41,0:12:30.41,Default,,0,0,0,,Уолсингем ұйымдастырған нұсқаулық
Dialogue: 0,0:12:30.54,0:12:32.37,Default,,0,0,0,,Жоқ, жетекші ме?
Dialogue: 0,0:12:32.50,0:12:34.54,Default,,0,0,0,,Екеуі де әртүрлі, солай ма?
Dialogue: 0,0:12:34.87,0:12:37.88,Default,,0,0,0,,Бұл ақымақ студент мәйіт маньяктарына арналған бойтұмар.
Dialogue: 0,0:12:38.42,0:12:39.25,Default,,0,0,0,,Уф
Dialogue: 0,0:12:39.38,0:12:41.67,Default,,0,0,0,,Иә, бұл дұрыс емес.
Dialogue: 0,0:12:41.80,0:12:45.55,Default,,0,0,0,,Өзімнен бұрынғы адам сияқты, ең жаманы, мәйітті үйге апарып тастаймын.
Dialogue: 0,0:12:45.68,0:12:48.30,Default,,0,0,0,,Өлі болса да елге еңбек ететін заман.
Dialogue: 0,0:12:48.43,0:12:50.85,Default,,0,0,0,,Алдыңғы? Не айтқың келеді?
Dialogue: 0,0:12:50.97,0:12:52.22,Default,,0,0,0,,Бомба жарған
Dialogue: 0,0:12:53.23,0:12:55.19,Default,,0,0,0,,Сондықтан сізді жіберді.
Dialogue: 0,0:12:55.31,0:12:57.98,Default,,0,0,0,,Менен сұрамадың. (Барнаби) Сен маған айтуды ұмытып кетіпсің.
Dialogue: 0,0:12:58.11,0:13:00.48,Default,,0,0,0,,Бұл бақытсыздық болды.
Dialogue: 0,0:13:01.69,0:13:04.32,Default,,0,0,0,,Жолыңыз болды деп үміттенемін.
Dialogue: 0,0:13:04.99,0:13:08.82,Default,,0,0,0,,О, иә, менің әдемі екенімді жазыңызшы.
Dialogue: 0,0:13:08.95,0:13:11.20,Default,,0,0,0,,Жұма күні жазудың қажеті жоқ
Dialogue: 0,0:13:11.87,0:13:14.41,Default,,0,0,0,,Жүр, мен өз жұмысымды жасайын.
Dialogue: 0,0:13:14.54,0:13:17.12,Default,,0,0,0,,Сіз кедергісіз, солай емес пе?
Dialogue: 0,0:13:24.63,0:13:28.84,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:13:30.97,0:13:32.64,Default,,0,0,0,,Күткендей, сарбаздар көп.
Dialogue: 0,0:13:33.56,0:13:37.56,Default,,0,0,0,,Ескі Кришна қозғалтқышындағы Карабиньери қозғалтқышы?
Dialogue: 0,0:13:38.15,0:13:38.60,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:38.60,0:13:39.69,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:38.60,0:13:39.69,Default,,0,0,0,,Ауғанстанға жіберемін.
Dialogue: 0,0:13:39.69,0:13:40.65,Default,,0,0,0,,Ауғанстанға жіберемін.
Dialogue: 0,0:13:41.48,0:13:44.94,Default,,0,0,0,,Бұдан былай көп адам өледі.
Dialogue: 0,0:13:45.07,0:13:48.36,Default,,0,0,0,,Бұл сіз үшін, мәйіт инженері үшін қызықты орын болуы мүмкін.
Dialogue: 0,0:13:48.49,0:13:50.32,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:13:52.74,0:13:55.00,Default,,0,0,0,,Мұны жасамаңыз. Қажет емес.
Dialogue: 0,0:13:55.45,0:13:59.54,Default,,0,0,0,,Эй, менің саған бір нәрсем бар.
Dialogue: 0,0:13:59.75,0:14:01.59,Default,,0,0,0,,О... не?
Dialogue: 0,0:14:01.71,0:14:03.34,Default,,0,0,0,,Уолсингемнен.
Dialogue: 0,0:14:03.46,0:14:04.55,Default,,0,0,0,,Бұл жеке куәлік пе?
Dialogue: 0,0:14:04.80,0:14:06.67,Default,,0,0,0,,Жалғандық үшін
Dialogue: 0,0:14:09.47,0:14:12.35,Default,,0,0,0,,Медицина ғылымдарының докторы әскери дәрігер болуы керек.
Dialogue: 0,0:14:12.93,0:14:15.68,Default,,0,0,0,,Мен әлі оқуды бітірген жоқпын.
Dialogue: 0,0:14:16.85,0:14:18.35,Default,,0,0,0,,А, мына жігіт.
Dialogue: 0,0:14:19.90,0:14:23.23,Default,,0,0,0,,Алексей Федорович Карамазов
Dialogue: 0,0:14:24.44,0:14:27.11,Default,,0,0,0,,Ресей императорлық армиясының капеллан...
Dialogue: 0,0:14:27.44,0:14:28.86,Default,,0,0,0,,Романовтар әулетінен—
Dialogue: 0,0:14:28.99,0:14:32.37,Default,,0,0,0,,Ол доктор Франкенштейн деген адам, солай емес пе?
Dialogue: 0,0:14:32.74,0:14:34.24,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:34.37,0:14:37.62,Default,,0,0,0,,3 ай бұрын Әлгі мәйіт инженері...
Dialogue: 0,0:14:38.54,0:14:42.33,Default,,0,0,0,,Қарулы мәйіттер тобын басқарып, ол көтеріліс жасады —
Dialogue: 0,0:14:42.46,0:14:45.55,Default,,0,0,0,,Ауғанстанның ішкі аймақтарында хабарсыз кеткен
Dialogue: 0,0:14:46.26,0:14:47.09,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:14:47.72,0:14:51.47,Default,,0,0,0,,Мәйіттерге бағынышты болған жаңа патшалық құру
Dialogue: 0,0:14:52.34,0:14:54.10,Default,,0,0,0,,Бас бостандығынан айырудан босатудың орнына -
Dialogue: 0,0:14:54.22,0:14:57.68,Default,,0,0,0,,Соғыс кезінде Ауғанстанға ену —
Dialogue: 0,0:14:57.81,0:15:00.77,Default,,0,0,0,,Сол патшалық туралы біраз зерттеу жасаңыз.
Dialogue: 0,0:15:03.90,0:15:05.44,Default,,0,0,0,,Карамазов —
Dialogue: 0,0:15:05.57,0:15:07.28,Default,,0,0,0,,Доктор Виктор Франкенштейн —
Dialogue: 0,0:15:07.40,0:15:10.91,Default,,0,0,0,,Жоғалған зерттеу дәптерін алып жүру
Dialogue: 0,0:15:11.03,0:15:12.74,Default,,0,0,0,,«Виктордың жазбалары»
Dialogue: 0,0:15:13.49,0:15:17.70,Default,,0,0,0,,Жан алып, сөйлеген жалғыз өлік.
Dialogue: 0,0:15:18.54,0:15:21.62,Default,,0,0,0,,The One жасаған технология осында
Dialogue: 0,0:15:22.42,0:15:26.34,Default,,0,0,0,,Ресей императорына тікелей бағынатын Үшінші хатшылық та жұмыс істей бастады.
Dialogue: 0,0:15:27.50,0:15:29.26,Default,,0,0,0,,Керемет ойын
Dialogue: 0,0:15:29.38,0:15:32.30,Default,,0,0,0,,Ресей империясына және Карамазовқа —
Dialogue: 0,0:15:32.43,0:15:35.60,Default,,0,0,0,,Біз олардың әлемді басып алуына жол бере алмаймыз.
Dialogue: 0,0:15:36.47,0:15:39.43,Default,,0,0,0,,Мәйіттер патшалығындағы жағдайды зерттеу және—
Dialogue: 0,0:15:39.56,0:15:41.10,Default,,0,0,0,,Виктор жазбаларын қамтамасыз ету
Dialogue: 0,0:15:41.81,0:15:44.48,Default,,0,0,0,,Бұл сіздің міндетіңіз.
Dialogue: 0,0:15:51.82,0:15:55.82,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:56.74,0:15:58.87,Default,,0,0,0,,Мен өте кеш келдім.
Dialogue: 0,0:15:58.99,0:16:00.70,Default,,0,0,0,,Мен сені өлді деп ойладым.
Dialogue: 0,0:16:01.00,0:16:03.33,Default,,0,0,0,,Хмм... көп нәрсе болды.
Dialogue: 0,0:16:03.79,0:16:08.25,Default,,0,0,0,,Англияда біз адамдарды ұқыптылыққа үйретпейтін сияқтымыз.
Dialogue: 0,0:16:08.96,0:16:11.51,Default,,0,0,0,,Ол әлі тәкаппар бала.
Dialogue: 0,0:16:13.22,0:16:16.80,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Николай Красоткин.
Dialogue: 0,0:16:17.01,0:16:19.68,Default,,0,0,0,,Бұл Уотсон. Джон Уотсон.
Dialogue: 0,0:16:19.81,0:16:22.02,Default,,0,0,0,,Досыңды рұқсатсыз өлікке айналдырдың.
Dialogue: 0,0:16:22.56,0:16:24.02,Default,,0,0,0,,Ол ақылсыз инженер.
Dialogue: 0,0:16:25.35,0:16:27.48,Default,,0,0,0,,Жағдайларды былай қойғанда...
Dialogue: 0,0:16:27.61,0:16:31.24,Default,,0,0,0,,Мен сізге үлкен үміт артамын, доктор Уотсон.
Dialogue: 0,0:16:31.65,0:16:33.03,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:16:34.49,0:16:36.41,Default,,0,0,0,,Ол орыс, солай ма?
Dialogue: 0,0:16:36.53,0:16:39.03,Default,,0,0,0,,Бомбейде достарың сені өлтіре жаздады.
Dialogue: 0,0:16:39.16,0:16:42.25,Default,,0,0,0,,Уайымдама, ол серіктес.
Dialogue: 0,0:16:42.37,0:16:43.91,Default,,0,0,0,,Ол гид.
Dialogue: 0,0:16:44.04,0:16:46.75,Default,,0,0,0,,Маған сене аласыз ба? Эй Барнаби!
Dialogue: 0,0:16:47.13,0:16:49.88,Default,,0,0,0,,Карамазов өз жазбаларынан үйренген жаңа тәсілдер
Dialogue: 0,0:16:50.00,0:16:51.01,Default,,0,0,0,,На
Dialogue: 0,0:16:51.51,0:16:53.13,Default,,0,0,0,,Оны көргің келмей ме?
Dialogue: 0,0:17:03.85,0:17:06.06,Default,,0,0,0,,Жұмаға барайық
Dialogue: 0,0:17:17.61,0:17:18.87,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:17:19.99,0:17:22.54,Default,,0,0,0,,Сіз де жазбаларды бақылап отырсыз, солай ма?
Dialogue: 0,0:17:22.87,0:17:25.46,Default,,0,0,0,,Неліктен бірлескен операцияларды орындаймыз?
Dialogue: 0,0:17:25.58,0:17:29.29,Default,,0,0,0,,Уайымдама, мен саған жазбаларды беремін.
Dialogue: 0,0:17:30.29,0:17:33.80,Default,,0,0,0,,Біз Карамазовты қамауда ұстауды қамтамасыз ете алатын болсақ...
Dialogue: 0,0:17:33.92,0:17:35.59,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:17:36.30,0:17:41.51,Default,,0,0,0,,Қарасам, Ресей империясының іші де аласапыран.
Dialogue: 0,0:17:42.10,0:17:45.81,Default,,0,0,0,,Қажетті нәтиже басқаша болса, процесс те басқаша болады.
Dialogue: 0,0:17:46.14,0:17:48.31,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:17:50.31,0:17:52.19,Default,,0,0,0,,Ал, жол ұзақ.
Dialogue: 0,0:17:53.07,0:17:55.99,Default,,0,0,0,,Агенттер бір-бірімен жақсы тіл табысуы керек.
Dialogue: 0,0:18:01.91,0:18:06.91,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:10.92,0:18:13.17,Default,,0,0,0,,Жарайды, қайта жүктеп көріңіз.
Dialogue: 0,0:18:25.39,0:18:27.77,Default,,0,0,0,,Бұл өте батыл.
Dialogue: 0,0:18:28.23,0:18:29.48,Default,,0,0,0,,Өзін-өзі қорғау шаралары
Dialogue: 0,0:18:30.27,0:18:34.40,Default,,0,0,0,,Олардың танымдық қабілеттері адамнан төмен болғанымен, оларда еш кідіріс жоқ.
Dialogue: 0,0:18:35.32,0:18:38.74,Default,,0,0,0,,Оққа сен емессің деп үміттенемін.
Dialogue: 0,0:18:39.15,0:18:40.32,Default,,0,0,0,,Иә
Dialogue: 0,0:18:40.70,0:18:43.62,Default,,0,0,0,,Ол Алексей Карамазовпен бір қаладан.
Dialogue: 0,0:18:44.49,0:18:46.95,Default,,0,0,0,,Берілген материалға сәйкес
Dialogue: 0,0:18:48.21,0:18:52.71,Default,,0,0,0,,Мәйіттерге әскери тәжірибе жасау кезінде дәптерді ұрлаған.
Dialogue: 0,0:18:53.17,0:18:55.46,Default,,0,0,0,,Кейбір сынақ тақырыптарымен бірге.
Dialogue: 0,0:18:56.13,0:18:59.47,Default,,0,0,0,,Сіз «Бірді» қайта жасай алдыңыз ба?
Dialogue: 0,0:18:59.68,0:19:01.26,Default,,0,0,0,,Жаднамада не бар...
Dialogue: 0,0:19:01.39,0:19:05.35,Default,,0,0,0,,Жоқ, мен жазбаларды талдауды аяқтадым деп ойладым.
Dialogue: 0,0:19:06.10,0:19:07.64,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:19:07.77,0:19:13.02,Default,,0,0,0,,Сіз ежелгі Ассасин ордені сияқты өлтірушілер тобын құруды жоспарлап отырсыз ба?
Dialogue: 0,0:19:13.65,0:19:15.77,Default,,0,0,0,,Ұлылардан осындай күмән...
Dialogue: 0,0:19:15.90,0:19:19.36,Default,,0,0,0,,Біз бұл мәселені жасырын түрде аяқтауға тырысамыз.
Dialogue: 0,0:19:19.86,0:19:21.70,Default,,0,0,0,,Бірақ сендер үшін
Dialogue: 0,0:19:21.82,0:19:24.87,Default,,0,0,0,,Мен Карамазовты өлуге жол бере алмаймын.
Dialogue: 0,0:19:25.99,0:19:30.00,Default,,0,0,0,,Адам сүйегі қалмаған таулардың тереңінде не істеп жүрсің?
Dialogue: 0,0:19:30.37,0:19:34.04,Default,,0,0,0,,Ұлттық мүддеге сай болса, оны қайтару керек.
Dialogue: 0,0:19:35.13,0:19:39.21,Default,,0,0,0,,Ол қазір Кабулдың солтүстігінде, Көкше алқабында.
Dialogue: 0,0:19:39.72,0:19:44.22,Default,,0,0,0,,Егер сіз соншалықты көп білсеңіз, бізбен бірігудің не қажеті бар?
Dialogue: 0,0:19:44.97,0:19:48.27,Default,,0,0,0,,Өйткені сен бізге керексің
Dialogue: 0,0:19:49.06,0:19:50.77,Default,,0,0,0,,Доктор Уотсон
Dialogue: 0,0:19:51.23,0:19:52.48,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:19:53.31,0:19:56.23,Default,,0,0,0,,Мәйіт технологиясымен таныс адам.
Dialogue: 0,0:19:57.15,0:19:58.94,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:20:02.11,0:20:03.66,Default,,0,0,0,,Ат!
Dialogue: 0,0:20:10.75,0:20:12.16,Default,,0,0,0,,Ат!
Dialogue: 0,0:20:15.17,0:20:18.80,Default,,0,0,0,,Егер сіз ату алдында жауды көбірек тартпасаңыз, уақытыңызды босқа өткізесіз.
Dialogue: 0,0:20:18.96,0:20:21.09,Default,,0,0,0,,Мен сені атуға рұқсат етемін.
Dialogue: 0,0:20:21.92,0:20:24.09,Default,,0,0,0,,А... аа
Dialogue: 0,0:20:25.01,0:20:27.76,Default,,0,0,0,,Көп өлген солдаттардың алдында —
Dialogue: 0,0:20:28.76,0:20:31.56,Default,,0,0,0,,Өзін-өзі ұстауды күту қатыгездік.
Dialogue: 0,0:20:34.06,0:20:37.36,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:20:37.44,0:20:41.07,Default,,0,0,0,,Жеңіс пен жеңілісті, т.б. болжауды бір ғана формуламен жасауға болады
Dialogue: 0,0:20:42.32,0:20:44.82,Default,,0,0,0,,Нақты ұрыс қай жерде қажет?
Dialogue: 0,0:20:45.41,0:20:48.95,Default,,0,0,0,,Онда бұл жай ғана ойын
Dialogue: 0,0:20:49.24,0:20:52.54,Default,,0,0,0,,Адамдарға әңгімелер керек.
Dialogue: 0,0:20:52.66,0:20:56.21,Default,,0,0,0,,Қаныңды қайнатып, етіңді тербететін сөздермен безендірілген.
Dialogue: 0,0:20:56.75,0:20:58.21,Default,,0,0,0,,Әңгіме.
Dialogue: 0,0:20:58.84,0:21:02.21,Default,,0,0,0,,Сіздің пікіріңіз көпшілікке түсініксіз.
Dialogue: 0,0:21:03.01,0:21:05.80,Default,,0,0,0,,Түсінбеген нәрсені қабылдай алмайсың
Dialogue: 0,0:21:06.09,0:21:09.85,Default,,0,0,0,,Қол тигізіп, көруге болатын нәрселерден басқа.
Dialogue: 0,0:21:11.35,0:21:15.10,Default,,0,0,0,,Әңгімелер біздің ақымақтығымыздан туады -
Dialogue: 0,0:21:15.23,0:21:17.69,Default,,0,0,0,,оны растауды жалғастырады
Dialogue: 0,0:21:19.11,0:21:22.40,Default,,0,0,0,,Бұл нәтиже...
Dialogue: 0,0:21:27.49,0:21:29.16,Default,,0,0,0,,Мен аздап жеңіл жүре алатын сияқтымын.
Dialogue: 0,0:21:31.03,0:21:34.96,Default,,0,0,0,,Сақтанбаңыз, жау сізді осы жерден көреді.
Dialogue: 0,0:21:35.54,0:21:38.67,Default,,0,0,0,,Ойдан тыс қалсаң, шынымен өлесің.
Dialogue: 0,0:21:41.38,0:21:42.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:43.88,0:21:45.97,Default,,0,0,0,,О, бұл жаман! Құтылып кету!
Dialogue: 0,0:21:51.31,0:21:52.60,Default,,0,0,0,,Бұл жігіт біраз уақыттан кейін бірінші рет көңілді жекпе-жек болатын сияқты.
Dialogue: 0,0:21:52.60,0:21:54.89,Default,,0,0,0,,Бұл жігіт біраз уақыттан кейін бірінші рет көңілді жекпе-жек болатын сияқты.
Dialogue: 0,0:21:52.60,0:21:54.89,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:57.44,0:21:59.56,Default,,0,0,0,,Артында қалуыңызды өтінемін
Dialogue: 0,0:21:59.90,0:22:01.77,Default,,0,0,0,,Жұма, мылтығыңызды дайындаңыз.
Dialogue: 0,0:22:03.98,0:22:05.53,Default,,0,0,0,,Ооо (мәйіт солдат) Ооо!
Dialogue: 0,0:22:14.75,0:22:16.75,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:22:18.58,0:22:21.46,Default,,0,0,0,,(Өлі солдаттың мұңы)
Dialogue: 0,0:22:21.59,0:22:23.46,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:22:23.59,0:22:26.26,Default,,0,0,0,,Қарсыласыңыздың қимылдарын болжаңыз
Dialogue: 0,0:22:26.38,0:22:28.26,Default,,0,0,0,,Бұл жігіт шынымен өлі ме?
Dialogue: 0,0:22:28.88,0:22:30.09,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:22:30.26,0:22:31.09,Default,,0,0,0,,Жалтардым!?
Dialogue: 0,0:22:32.26,0:22:35.39,Default,,0,0,0,,(Өлген сарбаздың айқайы)
Dialogue: 0,0:22:35.52,0:22:36.43,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:22:36.52,0:22:37.73,Default,,0,0,0,,Уау
Dialogue: 0,0:22:38.77,0:22:42.81,Default,,0,0,0,,Сіздің еліңіз мұны жүзеге асырды ма?
Dialogue: 0,0:22:43.02,0:22:44.94,Default,,0,0,0,,Доктор Уотсон
Dialogue: 0,0:22:45.65,0:22:48.99,Default,,0,0,0,,Бұл Карамазов жасаған некрокиім.
Dialogue: 0,0:22:49.28,0:22:50.32,Default,,0,0,0,,Га
Dialogue: 0,0:22:51.03,0:22:51.95,Default,,0,0,0,,Уф
Dialogue: 0,0:22:52.99,0:22:54.03,Default,,0,0,0,,Ептілік—
Dialogue: 0,0:22:54.16,0:22:57.41,Default,,0,0,0,,Әр буынның қимылдары байланыстырылатын атлетикалық қабілет
Dialogue: 0,0:22:57.87,0:22:59.41,Default,,0,0,0,,Жағдайды түсіну—
Dialogue: 0,0:22:59.54,0:23:02.25,Default,,0,0,0,,Оңтайлыны таңдау үшін алға қарау мүмкіндігі
Dialogue: 0,0:23:03.13,0:23:05.67,Default,,0,0,0,,Олардың барлығы бұрынғы мәйіттерден ерекшеленеді.
Dialogue: 0,0:23:06.84,0:23:08.92,Default,,0,0,0,,Олардың адам өлтіру ниеті бар
Dialogue: 0,0:23:09.30,0:23:10.63,Default,,0,0,0,,Кісі өлтіру ниеті сезімі
Dialogue: 0,0:23:10.63,0:23:11.51,Default,,0,0,0,,Адам өлтіру ниетінің сезімі
Dialogue: 0,0:23:10.63,0:23:11.51,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:23:12.09,0:23:12.93,Default,,0,0,0,,Иә
Dialogue: 0,0:23:17.77,0:23:22.35,Default,,0,0,0,,Виктордың біз мақсат етіп отырған технологиясы сонда.
Dialogue: 0,0:23:24.48,0:23:25.69,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:23:27.03,0:23:28.49,Default,,0,0,0,,Кесу жоқ
Dialogue: 0,0:23:29.36,0:23:30.36,Default,,0,0,0,,Ах
Dialogue: 0,0:23:44.38,0:23:45.67,Default,,0,0,0,,Га
Dialogue: 0,0:23:47.13,0:23:47.96,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:23:48.76,0:23:49.71,Default,,0,0,0,,Ха ха
Dialogue: 0,0:23:58.47,0:23:59.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:08.73,0:24:09.99,Default,,0,0,0,,О...
Dialogue: 0,0:24:10.15,0:24:11.19,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:24:13.03,0:24:14.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:14.16,0:24:15.28,Default,,0,0,0,,Уотсон!
Dialogue: 0,0:24:15.37,0:24:17.37,Default,,0,0,0,,Асығыңыз! Бұл ғашық болу жағдайы ма?
Dialogue: 0,0:24:17.49,0:24:19.24,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,0:24:24.42,0:24:28.25,Default,,0,0,0,,Хмм, бұл жалғыз жол ма?
Dialogue: 0,0:24:28.38,0:24:29.21,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:24:30.26,0:24:31.46,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:24:32.30,0:24:35.14,Default,,0,0,0,,Сіз бұл әйелдің көмегін босқа жібергіңіз келе ме?
Dialogue: 0,0:24:35.68,0:24:37.14,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:24:38.51,0:24:41.52,Default,,0,0,0,,Барнаби (Барнаби) Мен сенің еркіңді тыңдамаймын.
Dialogue: 0,0:24:43.10,0:24:44.60,Default,,0,0,0,,Бұл жаңа модель —
Dialogue: 0,0:24:45.44,0:24:46.98,Default,,0,0,0,,Сіз оны ұстай алмайсыз ба?
Dialogue: 0,0:24:47.40,0:24:48.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:49.19,0:24:53.57,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:25:21.01,0:25:23.23,Default,,0,0,0,,Орнатушының қуат көзі
Dialogue: 0,0:25:26.35,0:25:28.44,Default,,0,0,0,,Мен сезінген кісі өлтіру ниеті:
Dialogue: 0,0:25:29.06,0:25:31.57,Default,,0,0,0,,Бұл мәйіттің өзі өлтіру ниеті ме?
Dialogue: 0,0:25:32.36,0:25:33.82,Default,,0,0,0,,Немесе—
Dialogue: 0,0:25:33.94,0:25:38.03,Default,,0,0,0,,Бұл орнатылған бағдарламаның нұсқасы ғана ма?
Dialogue: 0,0:25:39.16,0:25:41.03,Default,,0,0,0,,Сөздер бар ма?
Dialogue: 0,0:25:41.45,0:25:43.20,Default,,0,0,0,,Жан қайда?
Dialogue: 0,0:25:44.66,0:25:46.33,Default,,0,0,0,,Іске қосу (баспа машинкада теру дыбысы)
Dialogue: 0,0:25:48.67,0:25:50.13,Default,,0,0,0,,Жоғалып кетті…
Dialogue: 0,0:25:55.26,0:25:57.22,Default,,0,0,0,,Ойды басқару жүйесіне жүктеменің артуы
Dialogue: 0,0:26:03.01,0:26:04.89,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:26:07.10,0:26:09.27,Default,,0,0,0,,Иә, бұл көздер.
Dialogue: 0,0:26:10.31,0:26:11.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:12.36,0:26:14.40,Default,,0,0,0,,Уа...
Dialogue: 0,0:26:14.48,0:26:16.03,Default,,0,0,0,,Ахх...
Dialogue: 0,0:26:16.49,0:26:17.74,Default,,0,0,0,,Сіз сөйлей аласыз ба?
Dialogue: 0,0:26:21.45,0:26:23.66,Default,,0,0,0,,Жұма шығысын көбейтіңіз (басу машинкасының соғу дыбысы)
Dialogue: 0,0:26:25.87,0:26:27.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:27.41,0:26:30.96,Default,,0,0,0,,Сенің атың кім? Айтыңызшы, бұл сіздің атыңыз!
Dialogue: 0,0:26:31.08,0:26:32.88,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:26:33.96,0:26:35.67,Default,,0,0,0,,Жоғалып кетті…
Dialogue: 0,0:26:37.17,0:26:39.26,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:26:42.05,0:26:45.39,Default,,0,0,0,,Ууу ааа... Ууу...
Dialogue: 0,0:26:46.64,0:26:48.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:52.86,0:26:56.57,Default,,0,0,0,,Эксперимент жұма күні жойылды
Dialogue: 0,0:27:09.83,0:27:13.08,Default,,0,0,0,,Мәйіттің атын неге сұрайсың?
Dialogue: 0,0:27:13.75,0:27:14.71,Default,,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:27:15.63,0:27:18.26,Default,,0,0,0,,Оның досыңмен қандай да бір қатысы бар деп ойлайсың ба?
Dialogue: 0,0:27:20.05,0:27:22.59,Default,,0,0,0,,Асыл жабайы 007 (Асыл жабайы 007)
Dialogue: 0,0:27:23.47,0:27:27.81,Default,,0,0,0,,Бұл Уолсингемнің меншігі ретінде жұма күні тіркелген атауы.
Dialogue: 0,0:27:28.64,0:27:31.77,Default,,0,0,0,,Әрбір мәйітте сәйкестендіру нөмірі болуы керек.
Dialogue: 0,0:27:31.90,0:27:35.65,Default,,0,0,0,,Белгі ретінде сәйкестік Аты артта қалды
Dialogue: 0,0:27:36.19,0:27:40.40,Default,,0,0,0,,Идентификаторды талдасаңыз да, сіз тек негізгі өнімділікті білесіз.
Dialogue: 0,0:27:41.03,0:27:45.08,Default,,0,0,0,,Мәйіттерге атау керек емес, сөйлемейді.
Dialogue: 0,0:27:46.08,0:27:49.50,Default,,0,0,0,,Жазбаларды не үшін сұрап тұрсыз?
Dialogue: 0,0:27:53.63,0:27:55.59,Default,,0,0,0,,Техник деген осындай емес пе?
Dialogue: 0,0:27:56.21,0:27:59.30,Default,,0,0,0,,Сізде жағдай басқаша болмауы керек.
Dialogue: 0,0:28:01.72,0:28:05.10,Default,,0,0,0,,Жаңашылдық олардың инстинкті сияқты.
Dialogue: 0,0:28:07.47,0:28:11.35,Default,,0,0,0,,Егер мен бұл айырмашылықты жасаған болсам, оңайырақ болар еді.
Dialogue: 0,0:28:15.81,0:28:16.86,Default,,0,0,0,,Иә
Dialogue: 0,0:28:17.44,0:28:18.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:29.37,0:28:30.66,Default,,0,0,0,,(сіріңкені соққан дыбыс)
Dialogue: 0,0:28:39.00,0:28:42.63,Default,,0,0,0,,Жазба нақты болуы мүмкін, жұма.
Dialogue: 0,0:28:44.09,0:28:47.22,Default,,0,0,0,,Мен сіздің теорияңызды дәлелдей аламын.
Dialogue: 0,0:28:51.73,0:28:53.52,Default,,0,0,0,,Сіздің атыңыз доктор Уотсон, солай ма?
Dialogue: 0,0:28:53.98,0:28:56.40,Default,,0,0,0,,Ах (Хадары) Бұл Хадары.
Dialogue: 0,0:28:56.52,0:28:59.36,Default,,0,0,0,,Мен президент Гранттың хатшысымын.
Dialogue: 0,0:29:00.11,0:29:02.57,Default,,0,0,0,,Бұрын біз қауіпті жерде болдық.
Dialogue: 0,0:29:03.57,0:29:06.53,Default,,0,0,0,,Сэр Грант қауіпті жақсы көреді.
Dialogue: 0,0:29:06.78,0:29:07.95,Default,,0,0,0,,Ах
Dialogue: 0,0:29:15.21,0:29:16.67,Default,,0,0,0,,Жан болды ма?
Dialogue: 0,0:29:18.13,0:29:21.71,Default,,0,0,0,,Бұрынғы мәйіт тірі адам сияқты қозғалды.
Dialogue: 0,0:29:21.84,0:29:23.84,Default,,0,0,0,,Ақыл-ойды сақтайды
Dialogue: 0,0:29:23.97,0:29:25.01,Default,,0,0,0,,Жан туралы не деуге болады?
Dialogue: 0,0:29:26.09,0:29:30.18,Default,,0,0,0,,Менің бір досым ой тілден бұрын тұрады деп айтатын.
Dialogue: 0,0:29:31.35,0:29:35.35,Default,,0,0,0,,Ал әлгі мәйіт сөйлеуге тырысты.
Dialogue: 0,0:29:36.23,0:29:41.69,Default,,0,0,0,,Басқаша айтқанда, біздің ойымыздың астарында жан жасырынған жоқ па?
Dialogue: 0,0:29:42.69,0:29:45.49,Default,,0,0,0,,Бұл жай ғана гипотеза, бірақ...
Dialogue: 0,0:29:45.61,0:29:47.70,Default,,0,0,0,,Мен оны міндетті түрде дәлелдеймін.
Dialogue: 0,0:29:49.37,0:29:53.37,Default,,0,0,0,,Қызық, сенің жаның тілей ме?
Dialogue: 0,0:29:55.41,0:29:59.50,Default,,0,0,0,,Менде жан сезімі жоқ.
Dialogue: 0,0:30:00.79,0:30:03.34,Default,,0,0,0,,Мен оның қандай екенін білмеймін
Dialogue: 0,0:30:05.05,0:30:07.38,Default,,0,0,0,,Мүмкін мен бұл жігітке жақын шығармын.
Dialogue: 0,0:30:12.06,0:30:14.47,Default,,0,0,0,,Бір күні, бір жерде
Dialogue: 0,0:30:20.86,0:30:21.94,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:30:21.94,0:30:24.03,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:30:21.94,0:30:24.03,Default,,0,0,0,,Иә? Уф
Dialogue: 0,0:30:25.82,0:30:27.40,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:30:28.07,0:30:31.83,Default,,0,0,0,,Ондай әйел саған ауыр жүк.
Dialogue: 0,0:30:31.99,0:30:33.58,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:32:35.87,0:32:38.70,Default,,0,0,0,,Неліктен Карамазов өлі жауынгерлерді ұрлады?
Dialogue: 0,0:32:38.83,0:32:40.29,Default,,0,0,0,,Сіз көтеріліске шықтыңыз ба?
Dialogue: 0,0:32:41.41,0:32:45.92,Default,,0,0,0,,Жаңа мәйітке қарағанда, Бірдің қайта пайда болуы дәл бұрышта болуы керек еді.
Dialogue: 0,0:32:47.84,0:32:49.88,Default,,0,0,0,,Себеп болуы керек пе?
Dialogue: 0,0:32:50.34,0:32:52.92,Default,,0,0,0,,Кем дегенде мағынасы бар.
Dialogue: 0,0:32:54.43,0:32:57.76,Default,,0,0,0,,Сіздің міндетіңіз - жазбаларды қорғау.
Dialogue: 0,0:32:57.89,0:33:01.60,Default,,0,0,0,,Бұл оқиғаның себебін немесе себебін білу туралы болмауы керек.
Dialogue: 0,0:33:03.06,0:33:05.44,Default,,0,0,0,,Алеша оқиғасына қатысты—
Dialogue: 0,0:33:05.56,0:33:07.61,Default,,0,0,0,,Сіз оны тікелей сұрауыңыз керек.
Dialogue: 0,0:33:09.48,0:33:10.82,Default,,0,0,0,,Біз келдік.
Dialogue: 0,0:33:10.94,0:33:12.11,Default,,0,0,0,,Ах
Dialogue: 0,0:33:29.04,0:33:31.09,Default,,0,0,0,,Әйел мен баланың мәйіті?
Dialogue: 0,0:33:41.31,0:33:42.52,Default,,0,0,0,,Га
Dialogue: 0,0:33:44.77,0:33:48.35,Default,,0,0,0,,Біз сізді күттік, доктор Уотсон.
Dialogue: 0,0:33:48.94,0:33:51.27,Default,,0,0,0,,Алексей Карамазов
Dialogue: 0,0:33:56.45,0:33:59.45,Default,,0,0,0,,Сәттілік тілеймін, Алеша
Dialogue: 0,0:34:00.16,0:34:03.04,Default,,0,0,0,,Еңбегіңізге рахмет, Коля.
Dialogue: 0,0:34:03.41,0:34:04.95,Default,,0,0,0,,Уақытында жасағаныңызға қуаныштымын.
Dialogue: 0,0:34:05.54,0:34:08.50,Default,,0,0,0,,Егер миссия бізді...
Dialogue: 0,0:34:08.62,0:34:11.63,Default,,0,0,0,,Маған оңайырақ жол көрсетсеңіз екен.
Dialogue: 0,0:34:12.13,0:34:15.42,Default,,0,0,0,,Британ империясы бұл жағдайды өте байыппен қабылдайды.
Dialogue: 0,0:34:16.88,0:34:19.13,Default,,0,0,0,,Мақсатыңызды айтыңыз.
Dialogue: 0,0:34:20.47,0:34:21.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:23.85,0:34:27.39,Default,,0,0,0,,Оны мен және Николай ашты.
Dialogue: 0,0:34:27.52,0:34:31.31,Default,,0,0,0,,Арктикалық шеңбердегі аралда миссиямен барды
Dialogue: 0,0:34:33.15,0:34:34.90,Default,,0,0,0,,Доктор Уотсон
Dialogue: 0,0:34:35.94,0:34:39.28,Default,,0,0,0,,Жазбаларды не үшін сұрап тұрсыз?
Dialogue: 0,0:34:39.86,0:34:43.74,Default,,0,0,0,,Бірді қайта шығару? Әлде бұл мемлекеттік тапсырыс па?
Dialogue: 0,0:34:44.16,0:34:47.21,Default,,0,0,0,,Мәйіт технологиясын зерттеу үшін ешқандай себеп қажет емес
Dialogue: 0,0:34:47.96,0:34:50.37,Default,,0,0,0,,Иә, мен де болдым...
Dialogue: 0,0:34:50.50,0:34:55.05,Default,,0,0,0,,«Бірді» қайта шығару үшін мәйіттерге тәжірибелер қайталанды.
Dialogue: 0,0:34:55.51,0:34:57.59,Default,,0,0,0,,Үйілген сансыз мәйіттер —
Dialogue: 0,0:34:57.72,0:35:00.18,Default,,0,0,0,,Жарығынан айырылған сансыз көздер
Dialogue: 0,0:35:00.30,0:35:02.85,Default,,0,0,0,,Мен өзімнің сол көздерден шағылысқанымды байқаған кезде —
Dialogue: 0,0:35:03.22,0:35:05.72,Default,,0,0,0,,Мен өзіме келдім
Dialogue: 0,0:35:06.39,0:35:10.23,Default,,0,0,0,,Мен не іздедім?
Dialogue: 0,0:35:13.48,0:35:15.40,Default,,0,0,0,,Қайта тыңдаңыз
Dialogue: 0,0:35:15.61,0:35:18.86,Default,,0,0,0,,Жазбаларды не үшін сұрап тұрсыз?
Dialogue: 0,0:35:19.86,0:35:23.78,Default,,0,0,0,,Мәйіт технологиясын жетілдіру Бірді көбейту
Dialogue: 0,0:35:25.03,0:35:28.87,Default,,0,0,0,,Бұл тыйым салынған нәрсені жасауды білдірсе де?
Dialogue: 0,0:35:29.29,0:35:32.92,Default,,0,0,0,,Тіпті қарсы көрсетілімдер де сайып келгенде әдеттегідей болады.
Dialogue: 0,0:35:34.54,0:35:37.63,Default,,0,0,0,,Шын мәнінде, мәйіттер қазір өмірдің бір бөлігі болып табылады.
Dialogue: 0,0:35:37.84,0:35:39.67,Default,,0,0,0,,(Танжиро) Ал, баста! (Үшеуі) Бар күшіңді сал!
Dialogue: 0,0:35:40.17,0:35:42.09,Default,,0,0,0,,Технология дүниеге келген кезде...
Dialogue: 0,0:35:42.22,0:35:45.30,Default,,0,0,0,,Басқа біреуге ыңғайлы болу үшін тоқтату мүмкін емес
Dialogue: 0,0:35:45.43,0:35:48.85,Default,,0,0,0,,Сол себепті Николай екеуміз материалдарды жойдық...
Dialogue: 0,0:35:48.98,0:35:51.77,Default,,0,0,0,,Маңызды бөліктерді қайта жазу
Dialogue: 0,0:35:53.56,0:35:57.86,Default,,0,0,0,,Империя ұрыс алаңына мәйіттің жаңа түрін енгізді.
Dialogue: 0,0:35:58.03,0:36:01.24,Default,,0,0,0,,Әлем жылдам қайта құрылады
Dialogue: 0,0:36:02.16,0:36:04.20,Default,,0,0,0,,Ұлыбритания үндемейді
Dialogue: 0,0:36:05.49,0:36:06.95,Default,,0,0,0,,Жаднама қайда?
Dialogue: 0,0:36:08.20,0:36:12.71,Default,,0,0,0,,Жазбаларды сұрасаңыз, оларды жоюға уәде беріңіз.
Dialogue: 0,0:36:13.08,0:36:14.21,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:36:14.33,0:36:16.13,Default,,0,0,0,,Себеп қажет емес
Dialogue: 0,0:36:16.25,0:36:19.46,Default,,0,0,0,,Осы уақытқа дейін жинаған көп сөздер...
Dialogue: 0,0:36:20.26,0:36:22.47,Default,,0,0,0,,Өз әңгімеңізді өзіңіз шешесіз
Dialogue: 0,0:36:31.14,0:36:35.15,Default,,0,0,0,,(Барнабидің ұйқысы)
Dialogue: 0,0:36:44.16,0:36:45.24,Default,,0,0,0,,жұма
Dialogue: 0,0:36:49.79,0:36:53.79,Default,,0,0,0,,(жазу дыбысы)
Dialogue: 0,0:37:09.72,0:37:11.10,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:37:11.22,0:37:14.89,Default,,0,0,0,,Жазбаларды бақылап отыруыңыздың себебі ол.
Dialogue: 0,0:37:15.90,0:37:18.69,Default,,0,0,0,,Сіз оған зат ретінде қарамайсыз.
Dialogue: 0,0:37:22.49,0:37:23.69,Default,,0,0,0,,Доктор Уотсон
Dialogue: 0,0:37:24.20,0:37:27.20,Default,,0,0,0,,Жазба жазу техникасынан тыс шындық —
Dialogue: 0,0:37:27.49,0:37:29.70,Default,,0,0,0,,Сіз оны алып жүруге дайынсыз ба?
Dialogue: 0,0:37:31.12,0:37:33.79,Default,,0,0,0,,Бізді қандай шындық күтіп тұрғанына қарамастан—
Dialogue: 0,0:37:34.16,0:37:36.08,Default,,0,0,0,,Жазбаны алуды ұмытпаңыз
Dialogue: 0,0:37:36.79,0:37:38.21,Default,,0,0,0,,Иә
Dialogue: 0,0:37:39.09,0:37:44.67,Default,,0,0,0,,Бұл сапарда сіз ойлап тапқан сөздер.
Dialogue: 0,0:37:46.18,0:37:48.34,Default,,0,0,0,,Сізбен сөйлескеніме қуаныштымын
Dialogue: 0,0:37:48.84,0:37:50.35,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:37:50.47,0:37:52.68,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:38:14.75,0:38:18.29,Default,,0,0,0,,Хмм... ой-а
Dialogue: 0,0:38:21.13,0:38:23.17,Default,,0,0,0,,Га
Dialogue: 0,0:38:24.34,0:38:26.13,Default,,0,0,0,,Жұма маған еріңіз
Dialogue: 0,0:38:27.38,0:38:29.39,Default,,0,0,0,,(музыкалық қораптың үні)
Dialogue: 0,0:38:45.48,0:38:47.36,Default,,0,0,0,,(музыкалық қораптың үні)
Dialogue: 0,0:38:47.36,0:38:49.49,Default,,0,0,0,,(музыкалық қораптың үні)
Dialogue: 0,0:38:47.36,0:38:49.49,Default,,0,0,0,,(Фушигиро) Тек теңсіз шындық қана—
Dialogue: 0,0:38:50.61,0:38:53.58,Default,,0,0,0,,Көз жұмып қарауға болмайды.
Dialogue: 0,0:38:53.95,0:38:55.45,Default,,0,0,0,,Ах... (Карамазов) Бұл...
Dialogue: 0,0:38:55.58,0:38:58.58,Default,,0,0,0,,Бұл сіз сұраған жаңа мәйіт технологиясы.
Dialogue: 0,0:38:58.71,0:38:59.83,Default,,0,0,0,,Га
Dialogue: 0,0:39:00.58,0:39:01.58,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:39:01.71,0:39:04.21,Default,,0,0,0,,Арх!
Dialogue: 0,0:39:04.34,0:39:07.17,Default,,0,0,0,,Николай! Мен оны қазір шешемін
Dialogue: 0,0:39:07.26,0:39:09.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:09.43,0:39:12.64,Default,,0,0,0,,Шыу!
Dialogue: 0,0:39:12.76,0:39:16.81,Default,,0,0,0,,Ах! Уф! Уау!
Dialogue: 0,0:39:16.93,0:39:21.40,Default,,0,0,0,,(Николайдың ыңырануы)
Dialogue: 0,0:39:21.81,0:39:24.23,Default,,0,0,0,,Бұл не екенін білесің бе?
Dialogue: 0,0:39:25.61,0:39:27.19,Default,,0,0,0,,Қазір...
Dialogue: 0,0:39:27.32,0:39:29.45,Default,,0,0,0,,Менің...
Dialogue: 0,0:39:30.45,0:39:32.74,Default,,0,0,0,,Сізге...
Dialogue: 0,0:39:32.87,0:39:35.95,Default,,0,0,0,,Миссия...
Dialogue: 0,0:39:36.62,0:39:38.66,Default,,0,0,0,,Соңы…
Dialogue: 0,0:39:41.71,0:39:46.34,Default,,0,0,0,,Бұл... тірі адамға жалған рухани элемент жазу сияқты...
Dialogue: 0,0:39:46.96,0:39:48.76,Default,,0,0,0,,Мүмкін емес болуы керек
Dialogue: 0,0:39:50.47,0:39:51.59,Default,,0,0,0,,Құт
Dialogue: 0,0:39:52.80,0:39:53.64,Default,,0,0,0,,Апиын?
Dialogue: 0,0:39:54.85,0:39:57.56,Default,,0,0,0,,Өзгертілген музыка да маңызды.
Dialogue: 0,0:39:57.77,0:40:01.52,Default,,0,0,0,,Бұлыңғыр және өзгерген сананы жасанды түрде жасау —
Dialogue: 0,0:40:01.64,0:40:03.56,Default,,0,0,0,,Псевдо-спирт элементімен түзетіңіз
Dialogue: 0,0:40:04.77,0:40:06.82,Default,,0,0,0,,Бұл жадынамада сипатталған әдіс.
Dialogue: 0,0:40:07.32,0:40:10.82,Default,,0,0,0,,Ол ақылсыз. Ол жай ғана қанішер!
Dialogue: 0,0:40:11.07,0:40:13.11,Default,,0,0,0,,Сізге де солай!
Dialogue: 0,0:40:13.45,0:40:16.53,Default,,0,0,0,,Хайбер асуында тірі адамды кесіп тастады.
Dialogue: 0,0:40:16.66,0:40:18.54,Default,,0,0,0,,Бұл Николайдан еш айырмашылығы жоқ болмыс
Dialogue: 0,0:40:18.70,0:40:19.79,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:40:25.84,0:40:27.25,Default,,0,0,0,,Фу
Dialogue: 0,0:40:28.09,0:40:31.67,Default,,0,0,0,,Тәжірибе материалы ретінде ағамды да пайдаландым.
Dialogue: 0,0:40:33.05,0:40:35.80,Default,,0,0,0,,Сен екеуміз ұқсаспыз.
Dialogue: 0,0:40:35.93,0:40:37.93,Default,,0,0,0,,Біртұтастың репродукциясын іздеу кезінде—
Dialogue: 0,0:40:38.76,0:40:42.44,Default,,0,0,0,,Тіпті сіздің жақын адамдарыңыз да сіздің мақсатыңыз үшін құрал ретінде пайдаланылды.
Dialogue: 0,0:40:44.02,0:40:46.40,Default,,0,0,0,,Хаха...
Dialogue: 0,0:40:46.52,0:40:49.65,Default,,0,0,0,,Николайдың жаны қайда...
Dialogue: 0,0:40:50.99,0:40:53.07,Default,,0,0,0,,Жан жоқ
Dialogue: 0,0:40:53.36,0:40:57.28,Default,,0,0,0,,Болашақта өлімді қайта жазу
Dialogue: 0,0:40:58.99,0:41:02.83,Default,,0,0,0,,Түсіндіңіз бе? Бұл технологияның ақымақтығы
Dialogue: 0,0:41:03.16,0:41:04.71,Default,,0,0,0,,Я...
Dialogue: 0,0:41:05.75,0:41:08.84,Default,,0,0,0,,Тек технология жетілмеген.
Dialogue: 0,0:41:09.00,0:41:09.84,Default,,0,0,0,,Уф
Dialogue: 0,0:41:11.05,0:41:13.42,Default,,0,0,0,,Неліктен ары қарай қозғалмадың?
Dialogue: 0,0:41:15.13,0:41:17.05,Default,,0,0,0,,Егер сіз ойланбастан жалғастырсаңыз—
Dialogue: 0,0:41:17.18,0:41:20.35,Default,,0,0,0,,Жан сол жерде болуы мүмкін!
Dialogue: 0,0:41:22.56,0:41:25.02,Default,,0,0,0,,Жақын адамының есебінен —
Dialogue: 0,0:41:25.81,0:41:28.81,Default,,0,0,0,,Сіз ешқашан болмаған нәрсені не істей аласыз?
Dialogue: 0,0:41:29.69,0:41:32.65,Default,,0,0,0,,Айтқан сенсің!
Dialogue: 0,0:41:42.08,0:41:43.58,Default,,0,0,0,,Я...
Dialogue: 0,0:41:46.29,0:41:48.08,Default,,0,0,0,,Біреуге өзіңізді қалай сезінетініңізді айту -
Dialogue: 0,0:41:49.63,0:41:52.42,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:41:55.80,0:41:57.76,Default,,0,0,0,,Ха... ха
Dialogue: 0,0:42:00.22,0:42:02.93,Default,,0,0,0,,Мені кешіріңіз, Николай.
Dialogue: 0,0:42:04.93,0:42:06.23,Default,,0,0,0,,Аға
Dialogue: 0,0:42:08.81,0:42:11.40,Default,,0,0,0,,Бұл жалғыз жол болды
Dialogue: 0,0:42:11.61,0:42:13.61,Default,,0,0,0,,Райден Нет AB Гранд Чемпионаты
Dialogue: 0,0:42:13.73,0:42:15.65,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:42:18.11,0:42:22.20,Default,,0,0,0,,Қолжазба қазір Жапонияда.
Dialogue: 0,0:42:23.24,0:42:26.96,Default,,0,0,0,,Егер сіз әрі қарай жүргіңіз келсе, алға қарай жүріңіз.
Dialogue: 0,0:42:27.08,0:42:29.71,Default,,0,0,0,,Уф, ха... а...
Dialogue: 0,0:42:29.83,0:42:32.92,Default,,0,0,0,,Бірақ мен ноталарға тап болған кезде...
Dialogue: 0,0:42:33.05,0:42:36.92,Default,,0,0,0,,Менің сөздерімді тағы да есте сақтағаныңызды қалаймын.
Dialogue: 0,0:42:39.01,0:42:41.22,Default,,0,0,0,,Біз—
Dialogue: 0,0:42:41.35,0:42:44.47,Default,,0,0,0,,Жазбаларымды жойғым келеді.
Dialogue: 0,0:42:46.73,0:42:48.81,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:42:48.89,0:42:51.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:16.51,0:43:19.88,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:43:20.01,0:43:22.05,Default,,0,0,0,,Николай мен Карамазовқа —
Dialogue: 0,0:43:22.18,0:43:24.89,Default,,0,0,0,,Ресейден кісі өлтіру туралы бұйрық келді.
Dialogue: 0,0:43:25.72,0:43:28.23,Default,,0,0,0,,Аз ғана уақыт қалды
Dialogue: 0,0:43:28.35,0:43:30.85,Default,,0,0,0,,Мәйіт инженері ретінде сіздің парасаттылығыңыз үшін...
Dialogue: 0,0:43:31.10,0:43:33.31,Default,,0,0,0,,Менде ілуден басқа амал қалмады.
Dialogue: 0,0:43:35.69,0:43:37.61,Default,,0,0,0,,Карамазов —
Dialogue: 0,0:43:38.82,0:43:41.86,Default,,0,0,0,,Жазбаларыңызды неге өзіңіз жоймадыңыз?
Dialogue: 0,0:43:42.95,0:43:46.16,Default,,0,0,0,,Жұманы бұза алмайтындай.
Dialogue: 0,0:43:47.16,0:43:49.08,Default,,0,0,0,,Мен Жапонияға барамын
Dialogue: 0,0:43:50.08,0:43:52.46,Default,,0,0,0,,Уолсингемге не айтасыз?
Dialogue: 0,0:43:52.83,0:43:55.04,Default,,0,0,0,,Ескертпелерді орындауды жалғастырыңыз
Dialogue: 0,0:43:56.75,0:43:59.30,Default,,0,0,0,,Ха, жетеді.
Dialogue: 0,0:44:00.17,0:44:02.76,Default,,0,0,0,,Маған мұндай нәрсені көрсеткенде мен білмедім деп айта алмаймын.
Dialogue: 0,0:44:04.09,0:44:05.55,Default,,0,0,0,,Мен алмаймын
Dialogue: 0,0:44:06.60,0:44:08.77,Default,,0,0,0,,Ол үнемі өзіне ұнамайтын сөздерді айтатын, бірақ...
Dialogue: 0,0:44:08.89,0:44:10.93,Default,,0,0,0,,Біз бірге ішімдік іштік
Dialogue: 0,0:44:11.02,0:44:13.85,Default,,0,0,0,,Бір-бірімізге ақымақ сөздер айтып күлдік.
Dialogue: 0,0:44:14.40,0:44:16.86,Default,,0,0,0,,Мен оны жойып жіберемін.
Dialogue: 0,0:44:18.61,0:44:19.90,Default,,0,0,0,,Құт
Dialogue: 0,0:44:27.91,0:44:31.25,Default,,0,0,0,,Жапонияға барайық
Dialogue: 0,0:45:23.55,0:45:26.47,Default,,0,0,0,,Бүгінгі -
Dialogue: 0,0:45:26.68,0:45:32.35,Default,,0,0,0,,Бірінші түйін
Dialogue: 0,0:45:35.98,0:45:37.65,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:45:40.15,0:45:42.15,Default,,0,0,0,,Сіз Ұлыбританиядансыз ба?
Dialogue: 0,0:45:42.48,0:45:47.87,Default,,0,0,0,,Орыс-түрік соғысы кезінде Сенда Британ империясына қарыз болды.
Dialogue: 0,0:45:48.74,0:45:50.58,Default,,0,0,0,,Бұрын жіберілген әскери атташе –
Dialogue: 0,0:45:50.70,0:45:55.21,Default,,0,0,0,,Мен Плевна бекінісінің алынуын Ресей жағынан бақылап отырдым.
Dialogue: 0,0:45:56.08,0:46:00.75,Default,,0,0,0,,Британ империясының Плевнаға кіргені туралы ешқандай дәлел жоқ.
Dialogue: 0,0:46:01.04,0:46:02.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:03.42,0:46:05.67,Default,,0,0,0,,Оны осылай қалдырамыз ба?
Dialogue: 0,0:46:05.80,0:46:06.97,Default,,0,0,0,,Ах
Dialogue: 0,0:46:07.09,0:46:09.93,Default,,0,0,0,,артта қалды артта қалды
Dialogue: 0,0:46:10.05,0:46:10.85,Default,,0,0,0,,О...
Dialogue: 0,0:46:11.76,0:46:13.02,Default,,0,0,0,,қалды
Dialogue: 0,0:46:13.43,0:46:15.60,Default,,0,0,0,,Ұрыс болып жатыр, о...
Dialogue: 0,0:46:19.48,0:46:22.90,Default,,0,0,0,,Николай Красоткин жолдастың өтініші бойынша —
Dialogue: 0,0:46:23.40,0:46:25.65,Default,,0,0,0,,Сыртқы істер министрлігі жіберген
Dialogue: 0,0:46:26.61,0:46:29.57,Default,,0,0,0,,Жапон императорлық армиясына жатады
Dialogue: 0,0:46:29.70,0:46:32.16,Default,,0,0,0,,Менің атым Сейго Ямазава.
Dialogue: 0,0:46:33.16,0:46:37.12,Default,,0,0,0,,Сіздің жолдастарыңыз сыртта күтіп тұр. Өтінемін, осында кел.
Dialogue: 0,0:46:46.17,0:46:48.43,Default,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 0,0:46:48.55,0:46:50.59,Default,,0,0,0,,Жасырын тергеу
Dialogue: 0,0:46:50.93,0:46:52.60,Default,,0,0,0,,Егін жинау деңгейі қандай?
Dialogue: 0,0:46:52.85,0:46:56.48,Default,,0,0,0,,Мен бірден ұсталғандықтан емес.
Dialogue: 0,0:46:56.60,0:47:00.60,Default,,0,0,0,,Ха, олай киінуден ұялмайсың ба?
Dialogue: 0,0:47:01.48,0:47:03.65,Default,,0,0,0,,Бұл іш киім емес, сондықтан ұят жоқ.
Dialogue: 0,0:47:03.77,0:47:05.36,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:47:05.48,0:47:08.20,Default,,0,0,0,,Егер сізге ұнаса, жақсы.
Dialogue: 0,0:47:12.24,0:47:13.37,Default,,0,0,0,,Жазбалар жоқ па?
Dialogue: 0,0:47:13.62,0:47:15.66,Default,,0,0,0,,Ресейдегі бұрынғы министр
Dialogue: 0,0:47:15.79,0:47:18.00,Default,,0,0,0,,Қарамазов мырза өз жазбаларын маған сеніп тапсырды.
Dialogue: 0,0:47:18.12,0:47:20.25,Default,,0,0,0,,Мен оны үйге қайтқанша ұстаймын, бірақ...
Dialogue: 0,0:47:20.96,0:47:23.96,Default,,0,0,0,,Osato Chemical компаниясымен байланыс туралы соңғы ақпарат...
Dialogue: 0,0:47:24.09,0:47:26.00,Default,,0,0,0,,Мен сізден әлі хабар алған жоқпын.
Dialogue: 0,0:47:26.21,0:47:27.05,Default,,0,0,0,,Иә
Dialogue: 0,0:47:27.17,0:47:29.09,Default,,0,0,0,,Osato Chemical дегеніміз не?
Dialogue: 0,0:47:29.22,0:47:31.64,Default,,0,0,0,,Мәйіт технологиясын дамытуға арналған -
Dialogue: 0,0:47:31.76,0:47:34.47,Default,,0,0,0,,Бұл бұрынғы үкіметке қарасты акционерлік қоғам.
Dialogue: 0,0:47:34.60,0:47:38.14,Default,,0,0,0,,Белгілі бір сәттен бастап барлық бизнес мәліметтері құпия сақталды.
Dialogue: 0,0:47:38.77,0:47:42.23,Default,,0,0,0,,Егер бұл жазбаларды алған уақытпен сәйкес келсе ше?
Dialogue: 0,0:47:42.69,0:47:45.65,Default,,0,0,0,,Жаңа үкіметтен билікті қайтарып алу -
Dialogue: 0,0:47:45.77,0:47:49.57,Default,,0,0,0,,Сондай-ақ олар мәйіттің жаңа түрін жасауды жоспарлап отырған бөлім бар.
Dialogue: 0,0:47:50.82,0:47:52.78,Default,,0,0,0,,Жағымсыз иіс шыға бастады.
Dialogue: 0,0:47:52.91,0:47:55.16,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:47:55.83,0:47:56.08,Default,,0,0,0,,Қайда бара жатырсың~?
Dialogue: 0,0:47:56.08,0:47:59.12,Default,,0,0,0,,Қайда бара жатырсың~?
Dialogue: 0,0:47:56.08,0:47:59.12,Default,,0,0,0,,Бұл қызықтырақ көрінеді.
Dialogue: 0,0:48:02.67,0:48:04.04,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:48:04.33,0:48:07.38,Default,,0,0,0,,Бұл жұмыс оңай емес, білесің бе!
Dialogue: 0,0:48:07.50,0:48:08.59,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:48:16.76,0:48:18.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:48:18.89,0:48:21.35,Default,,0,0,0,,Доктор Уотсон Жапония болған.
Dialogue: 0,0:48:22.69,0:48:24.90,Default,,0,0,0,,Капитан Барнаби менімен бірге.
Dialogue: 0,0:48:30.74,0:48:33.07,Default,,0,0,0,,Сіз оны болжап көрдіңіз бе?
Dialogue: 0,0:48:34.07,0:48:37.78,Default,,0,0,0,,Менің жұмысым – алға қарау.
Dialogue: 0,0:48:38.33,0:48:40.79,Default,,0,0,0,,(айқай)
Dialogue: 0,0:49:08.65,0:49:11.57,Default,,0,0,0,,Айналадағы күзет негізінен ұйқыға қойылды.
Dialogue: 0,0:49:12.03,0:49:13.78,Default,,0,0,0,,Біраз уақыт жақсы болады.
Dialogue: 0,0:49:13.90,0:49:17.07,Default,,0,0,0,,Екінші ғылыми ғимаратта рұқсатсыз кіру іздері бар.
Dialogue: 0,0:49:19.12,0:49:19.95,Default,,0,0,0,,Сіз алдыңғы тұтынушысыз ба?
Dialogue: 0,0:49:21.04,0:49:23.96,Default,,0,0,0,,23 минут бұрын. Бұл мүмкін.
Dialogue: 0,0:49:30.59,0:49:31.88,Default,,0,0,0,,Хмм?
Dialogue: 0,0:49:35.13,0:49:36.39,Default,,0,0,0,,Қауіпсіздік көрінбейді -
Dialogue: 0,0:49:36.84,0:49:40.76,Default,,0,0,0,,Тірілер өлтірілуде. Қалай қарасаң да, бұл қақпан.
Dialogue: 0,0:49:41.01,0:49:41.93,Default,,0,0,0,,Қайтып оралғыңыз келе ме?
Dialogue: 0,0:49:42.06,0:49:44.69,Default,,0,0,0,,Жоқ, шақыруды қабылдаңыз.
Dialogue: 0,0:49:49.02,0:49:51.82,Default,,0,0,0,,Қарусыз адамға шабуыл жасау дегеніміз не?
Dialogue: 0,0:49:55.49,0:49:58.82,Default,,0,0,0,,Естеліктердің керемет сүйкімділігі бар сияқты.
Dialogue: 0,0:49:59.07,0:50:01.58,Default,,0,0,0,,(есікке соғылған дыбыс)
Dialogue: 0,0:50:07.62,0:50:09.88,Default,,0,0,0,,Бұл адамдар сіздің бұрынғы тұтынушыларыңыз ба?
Dialogue: 0,0:50:10.13,0:50:13.09,Default,,0,0,0,,А, бұл Уолсингемнің агенті.
Dialogue: 0,0:50:13.21,0:50:14.63,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:50:15.47,0:50:17.51,Default,,0,0,0,,Жаднамадан кейін біреу келе жатқан сияқты...
Dialogue: 0,0:50:17.63,0:50:20.43,Default,,0,0,0,,Бізден және Ұлыбританиядан басқа адамдар бар сияқты.
Dialogue: 0,0:50:38.86,0:50:41.03,Default,,0,0,0,,Бұл қандай дақтар?
Dialogue: 0,0:50:41.78,0:50:44.41,Default,,0,0,0,,Олар ауруды тірілерге енгізген болуы керек.
Dialogue: 0,0:50:44.79,0:50:49.21,Default,,0,0,0,,Мидың жұмысында сәйкессіздік болған кезде мен жалған рухани элементтерді жаздым.
Dialogue: 0,0:50:49.46,0:50:52.71,Default,,0,0,0,,Бактерияларды тарататын биологиялық қару ма?
Dialogue: 0,0:50:53.38,0:50:56.21,Default,,0,0,0,,Tsk, сіз оны ақымақ жолмен пайдаланып жатырсыз.
Dialogue: 0,0:50:57.17,0:50:59.51,Default,,0,0,0,,Жазбаларымды тез жойып жіберемін.
Dialogue: 0,0:51:00.09,0:51:01.76,Default,,0,0,0,,Өлім саны артады
Dialogue: 0,0:51:21.91,0:51:22.74,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:51:23.83,0:51:25.62,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:51:36.17,0:51:39.93,Default,,0,0,0,,Жоқ, мен сізді шебер ретінде көрдім.
Dialogue: 0,0:51:40.05,0:51:42.34,Default,,0,0,0,,Мүсекең сияқты бірдеңе болса керек.
Dialogue: 0,0:51:43.39,0:51:46.89,Default,,0,0,0,,Мусо дегеннің не екенін білмеймін, бірақ мен соны қалаймын!
Dialogue: 0,0:51:47.02,0:51:48.60,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:51:52.69,0:51:53.73,Default,,0,0,0,,Уф
Dialogue: 0,0:52:01.78,0:52:02.86,Default,,0,0,0,,Ха (Ямазава) Артқа тұрыңыз.
Dialogue: 0,0:52:07.49,0:52:08.62,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:52:15.25,0:52:16.21,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:52:16.80,0:52:17.63,Default,,0,0,0,,Хехе
Dialogue: 0,0:52:18.71,0:52:20.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:22.43,0:52:23.09,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:52:23.39,0:52:24.89,Default,,0,0,0,,Келесі аптаның қолжазбасын аяқтауға тек екі бет қана қалды.
Dialogue: 0,0:52:26.93,0:52:28.72,Default,,0,0,0,,Често!
Dialogue: 0,0:52:32.81,0:52:33.85,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:52:34.23,0:52:35.86,Default,,0,0,0,,Уф
Dialogue: 0,0:52:37.57,0:52:39.07,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:52:42.20,0:52:44.41,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:52:46.03,0:52:47.95,Default,,0,0,0,,Уотсон! Бұл жақсы!
Dialogue: 0,0:52:48.08,0:52:50.25,Default,,0,0,0,,Жазбаларыңызды тез жойыңыз!
Dialogue: 0,0:52:51.29,0:52:53.67,Default,,0,0,0,,Ооо хмф
Dialogue: 0,0:52:55.67,0:52:57.67,Default,,0,0,0,,Уотсон! Ха, аа!
Dialogue: 0,0:52:58.59,0:52:59.80,Default,,0,0,0,,Уф!
Dialogue: 0,0:53:00.13,0:53:02.26,Default,,0,0,0,,Киеееее!
Dialogue: 0,0:53:03.97,0:53:04.80,Default,,0,0,0,,Жүр!
Dialogue: 0,0:53:06.01,0:53:07.89,Default,,0,0,0,,Жазбаларыңызды жойыңыз!
Dialogue: 0,0:53:08.10,0:53:09.06,Default,,0,0,0,,Қалғандары жақсы ілгерілеп жатыр ма екен?
Dialogue: 0,0:53:10.47,0:53:11.64,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:53:14.31,0:53:15.31,Default,,0,0,0,,(жалюздерден өткен дыбыс)
Dialogue: 0,0:53:16.77,0:53:18.57,Default,,0,0,0,,Жұмаға барайық
Dialogue: 0,0:53:23.53,0:53:24.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:53:31.49,0:53:34.92,Default,,0,0,0,,Жұма Виктор жазбаларын табыңыз
Dialogue: 0,0:53:59.94,0:54:00.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:54:02.11,0:54:03.94,Default,,0,0,0,,Виктор жазбалары
Dialogue: 0,0:54:16.54,0:54:18.50,Default,,0,0,0,,Сөздердің алдында ой келеді.
Dialogue: 0,0:54:20.96,0:54:23.88,Default,,0,0,0,,Сөз болса, жүрек бар.
Dialogue: 0,0:54:24.76,0:54:26.05,Default,,0,0,0,,Жан бар
Dialogue: 0,0:54:30.05,0:54:34.18,Default,,0,0,0,,21 грамм жанды дәлелде.
Dialogue: 0,0:54:37.27,0:54:40.48,Default,,0,0,0,,Менің қалағаным...
Dialogue: 0,0:54:42.32,0:54:46.95,Default,,0,0,0,,Біз жазбаларды жойғымыз келеді.
Dialogue: 0,0:54:52.37,0:54:55.20,Default,,0,0,0,,Жұма Виктордың жазбаларын талда.
Dialogue: 0,0:55:01.67,0:55:04.34,Default,,0,0,0,,(Төтенше қоңырау дыбысы)
Dialogue: 0,0:55:11.18,0:55:13.35,Default,,0,0,0,,(Өлгендердің ыңырануы)
Dialogue: 0,0:55:16.52,0:55:18.60,Default,,0,0,0,,Уотсон! Сен не істеп жатырсың!
Dialogue: 0,0:55:19.10,0:55:22.36,Default,,0,0,0,,Бұл кодтың бір түрі ме?
Dialogue: 0,0:55:23.61,0:55:26.61,Default,,0,0,0,,Жанның көбеюі туралы сипаттама қайда!?
Dialogue: 0,0:55:31.03,0:55:31.87,Default,,0,0,0,,Уотсон!
Dialogue: 0,0:55:32.37,0:55:33.37,Default,,0,0,0,,(Өлгендердің мұңы)
Dialogue: 0,0:55:33.45,0:55:35.12,Default,,0,0,0,,Тез аяқтаңыз!
Dialogue: 0,0:55:47.63,0:55:48.67,Default,,0,0,0,,Уотсон!
Dialogue: 0,0:55:55.85,0:55:57.14,Default,,0,0,0,,Га
Dialogue: 0,0:55:57.64,0:55:59.27,Default,,0,0,0,,Ол аяқталды ма?
Dialogue: 0,0:55:59.60,0:56:00.77,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:56:03.98,0:56:05.48,Default,,0,0,0,,А...
Dialogue: 0,0:56:05.61,0:56:07.61,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:56:17.74,0:56:19.75,Default,,0,0,0,,Мәйіт қозғалмай қалды.
Dialogue: 0,0:56:20.04,0:56:22.04,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:56:22.17,0:56:23.00,Default,,0,0,0,,жұма
Dialogue: 0,0:56:26.54,0:56:29.30,Default,,0,0,0,,Толқын болды, әзірше сыртқа шығайық.
Dialogue: 0,0:56:30.51,0:56:32.68,Default,,0,0,0,,Не болды! жұма!
Dialogue: 0,0:56:34.26,0:56:35.10,Default,,0,0,0,,Га
Dialogue: 0,0:56:36.18,0:56:37.47,Default,,0,0,0,,А...
Dialogue: 0,0:56:38.56,0:56:40.60,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,0:56:40.73,0:56:44.73,Default,,0,0,0,,(Жұма күнгі ыңырсы)
Dialogue: 0,0:56:46.69,0:56:47.61,Default,,0,0,0,,жұма!
Dialogue: 0,0:56:48.98,0:56:51.15,Default,,0,0,0,,Уотсон Қашайық!
Dialogue: 0,0:56:52.70,0:56:54.36,Default,,0,0,0,,Кабельді тексеру жолын пайдаланыңыз
Dialogue: 0,0:56:54.86,0:56:56.57,Default,,0,0,0,,Маған жұма күні жауап беріңіз!
Dialogue: 0,0:56:57.24,0:56:58.33,Default,,0,0,0,,Ах
Dialogue: 0,0:56:59.04,0:57:00.83,Default,,0,0,0,,Хмм
Dialogue: 0,0:57:02.00,0:57:03.62,Default,,0,0,0,,Мені ести алатыныңды айт!
Dialogue: 0,0:57:05.88,0:57:07.84,Default,,0,0,0,,Уотсон! Сен не істеп жатырсың!
Dialogue: 0,0:57:07.96,0:57:11.09,Default,,0,0,0,,A… a a…
Dialogue: 0,0:57:11.34,0:57:14.09,Default,,0,0,0,,Мен мұндамын Мен мұндамын!
Dialogue: 0,0:57:14.34,0:57:18.10,Default,,0,0,0,,А аа… аа… ааа
Dialogue: 0,0:57:18.76,0:57:20.31,Default,,0,0,0,,Сәлем Уотсон!
Dialogue: 0,0:57:22.85,0:57:23.69,Default,,0,0,0,,жұма!
Dialogue: 0,0:57:23.81,0:57:26.10,Default,,0,0,0,,Не болды? Мықты болыңыз!
Dialogue: 0,0:57:28.69,0:57:30.15,Default,,0,0,0,,Не істеу керек Шығарыңыз!
Dialogue: 0,0:57:31.40,0:57:33.19,Default,,0,0,0,,Ноталардың жойылуы не болды?
Dialogue: 0,0:57:33.32,0:57:35.36,Default,,0,0,0,,Жұма жазбаларды талдады!
Dialogue: 0,0:57:35.49,0:57:37.07,Default,,0,0,0,,Мен сөйлесуге тырысамын
Dialogue: 0,0:57:37.20,0:57:39.12,Default,,0,0,0,,Менің жаным оралған шығар!
Dialogue: 0,0:57:39.53,0:57:42.41,Default,,0,0,0,,Бұл маған жаңарту қатесі сияқты.
Dialogue: 0,0:57:42.75,0:57:44.79,Default,,0,0,0,,Ол жерден кет! Жоқ!
Dialogue: 0,0:57:45.17,0:57:47.21,Default,,0,0,0,,Карамазов сізге не деді?
Dialogue: 0,0:57:47.33,0:57:49.04,Default,,0,0,0,,Маған ұмыттың деп айтпа
Dialogue: 0,0:57:49.59,0:57:53.30,Default,,0,0,0,,Сен сол Николайдың және басқалардың өмірін құртуды жоспарлап отырсың ба!
Dialogue: 0,0:57:53.38,0:57:54.88,Default,,0,0,0,,Ха...
Dialogue: 0,0:57:55.13,0:57:57.30,Default,,0,0,0,,Сіз тек көргіңіз келетін нәрсені көресіз!
Dialogue: 0,0:57:57.68,0:58:00.56,Default,,0,0,0,,Жолдан кет! Бұл дүниеде мұндай нәрселер болмауы керек!
Dialogue: 0,0:58:00.93,0:58:02.10,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:58:02.22,0:58:05.14,Default,,0,0,0,,Жұманың рухы сонда!
Dialogue: 0,0:58:07.69,0:58:10.40,Default,,0,0,0,,Бұл жанның көбеюі болса...
Dialogue: 0,0:58:11.73,0:58:13.07,Default,,0,0,0,,Мені енді қинамаңыз!
Dialogue: 0,0:58:13.15,0:58:14.57,Default,,0,0,0,,Уа, ау, ау
Dialogue: 0,0:58:14.86,0:58:15.99,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:58:16.86,0:58:18.03,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:58:26.79,0:58:30.34,Default,,0,0,0,,Жұма... Естелік...
Dialogue: 0,0:58:31.34,0:58:32.92,Default,,0,0,0,,Мені қорға...
Dialogue: 0,0:58:33.05,0:58:34.55,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:58:36.55,0:58:39.26,Default,,0,0,0,,Ақымақ адамдар
Dialogue: 0,0:58:39.39,0:58:43.31,Default,,0,0,0,,Неліктен Виктордың технологиясын іздеуге бардың ба?
Dialogue: 0,0:58:43.31,0:58:43.72,Default,,0,0,0,,Неліктен Виктордың технологиясын іздеуге бардың ба?
Dialogue: 0,0:58:43.31,0:58:43.72,Default,,0,0,0,,(Талдау қозғалтқышының іске қосылу дыбысы)
Dialogue: 0,0:58:43.72,0:58:45.68,Default,,0,0,0,,(Талдау қозғалтқышының іске қосылу дыбысы)
Dialogue: 0,0:58:48.60,0:58:50.52,Default,,0,0,0,,U… aa…
Dialogue: 0,0:58:50.65,0:58:52.82,Default,,0,0,0,,Менмен, арманшыл
Dialogue: 0,0:58:53.36,0:58:55.32,Default,,0,0,0,,Сондықтан көру өрісі тар.
Dialogue: 0,0:58:56.61,0:58:57.74,Default,,0,0,0,,Сіз—
Dialogue: 0,0:58:57.86,0:58:59.91,Default,,0,0,0,,Виктор Франкенштейнге
Dialogue: 0,0:59:00.03,0:59:01.74,Default,,0,0,0,,Осы бөлікті өткізіп жіберсең де болады.
Dialogue: 0,0:59:01.87,0:59:02.70,Default,,0,0,0,,Га
Dialogue: 0,0:59:04.12,0:59:05.62,Default,,0,0,0,,Бір…
Dialogue: 0,0:59:07.75,0:59:11.13,Default,,0,0,0,,Аты жоқ.
Dialogue: 0,0:59:11.63,0:59:13.92,Default,,0,0,0,,100 жыл бойы I—
Dialogue: 0,0:59:14.05,0:59:18.59,Default,,0,0,0,,Өйткені ол ешқашан шақырылмаған жалғыз адам болды.
Dialogue: 0,0:59:22.35,0:59:25.06,Default,,0,0,0,,Хмм қызық
Dialogue: 0,0:59:25.64,0:59:28.56,Default,,0,0,0,,Сіздің шеберіңіз Виктордың техникасы...
Dialogue: 0,0:59:28.69,0:59:32.86,Default,,0,0,0,,Мен сені өмірге қайтарамын деп ойлайтын сияқтысың.
Dialogue: 0,0:59:34.82,0:59:37.03,Default,,0,0,0,,Маған жазбаларымды қайтарыңыз...
Dialogue: 0,0:59:37.94,0:59:43.66,Default,,0,0,0,,Сіз Виктор сияқты жолмен жүресіз бе?
Dialogue: 0,0:59:46.58,0:59:48.08,Default,,0,0,0,,Кеттік
Dialogue: 0,0:59:51.96,0:59:54.17,Default,,0,0,0,,Немесе... қайтарыңыз...
Dialogue: 0,0:59:54.29,0:59:55.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:56.17,0:59:58.97,Default,,0,0,0,,Ууууу... ку...
Dialogue: 0,0:59:59.26,1:00:00.38,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:06.22,1:00:07.27,Default,,0,0,0,,жұма
Dialogue: 0,1:00:10.69,1:00:15.06,Default,,0,0,0,,Сіздің теорияңыз дұрыс болды ма?
Dialogue: 0,1:00:20.70,1:00:24.03,Default,,0,0,0,,Уәде... Орындай алмадым...
Dialogue: 0,1:00:25.41,1:00:26.62,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,1:00:29.25,1:00:33.50,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,1:00:39.09,1:00:44.09,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:00:44.72,1:00:47.51,Default,,0,0,0,,Мен ақыры өлетін сияқтымын.
Dialogue: 0,1:00:48.72,1:00:50.52,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:00:51.52,1:00:54.56,Default,,0,0,0,,Тоқта, зерттеуімізді жалғастырайық.
Dialogue: 0,1:00:54.69,1:00:57.61,Default,,0,0,0,,Жоғалған 21 грамм жанның бар болуы...
Dialogue: 0,1:00:57.73,1:00:59.98,Default,,0,0,0,,Сенсіз дәлелдей алмаймын.
Dialogue: 0,1:01:01.53,1:01:03.78,Default,,0,0,0,,Бұл бөлме сізге арналған.
Dialogue: 0,1:01:05.45,1:01:07.37,Default,,0,0,0,,Сіз басшылыққа аласыз.
Dialogue: 0,1:01:09.49,1:01:13.62,Default,,0,0,0,,Менің қабірімді жарып, мәйітті пайдалан.
Dialogue: 0,1:01:13.79,1:01:14.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:16.17,1:01:20.00,Default,,0,0,0,,Егер мен жанды сезсем, мен сигнал жіберемін.
Dialogue: 0,1:01:22.51,1:01:24.18,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:01:24.38,1:01:25.68,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:27.14,1:01:30.31,Default,,0,0,0,,Сонымен біздің теориямыз дәлелденді.
Dialogue: 0,1:01:32.39,1:01:33.94,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,1:01:43.15,1:01:47.45,Default,,0,0,0,,Уәдеңде тұрмағаның үшін бәрі өлді.
Dialogue: 0,1:01:48.03,1:01:52.20,Default,,0,0,0,,Адамның жанын азат ете білу қызық...
Dialogue: 0,1:01:52.58,1:01:55.71,Default,,0,0,0,,Мен оның қарсы екенін білсем де, оны жібере алмаймын
Dialogue: 0,1:01:55.92,1:01:57.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:58.46,1:02:01.21,Default,,0,0,0,,Нені қайтаруға болмайды—
Dialogue: 0,1:02:01.34,1:02:04.51,Default,,0,0,0,,Қалпына келтіру мүмкін емес түрде жойылды
Dialogue: 0,1:02:05.22,1:02:08.26,Default,,0,0,0,,Ешкім құрастыра алмайтын өрнек
Dialogue: 0,1:02:08.80,1:02:12.22,Default,,0,0,0,,Жанды құрайтын шебер құрастырылған матаға —
Dialogue: 0,1:02:12.60,1:02:15.23,Default,,0,0,0,,Мен оған саусағымды дөрекі тығып алдым.
Dialogue: 0,1:02:15.56,1:02:18.06,Default,,0,0,0,,Аа
Dialogue: 0,1:02:20.11,1:02:21.02,Default,,0,0,0,,Га
Dialogue: 0,1:02:21.61,1:02:24.40,Default,,0,0,0,,жұма! Сол сияқты...
Dialogue: 0,1:02:24.65,1:02:27.78,Default,,0,0,0,,Доктор Уотсон, бұл жерде қауіпті.
Dialogue: 0,1:02:28.45,1:02:29.24,Default,,0,0,0,,жұма! Жұма!!
Dialogue: 0,1:02:29.24,1:02:30.91,Default,,0,0,0,,жұма! Жұма!!
Dialogue: 0,1:02:29.24,1:02:30.91,Default,,0,0,0,,Доктор Уотсон
Dialogue: 0,1:02:30.91,1:02:31.16,Default,,0,0,0,,жұма! Жұма!!
Dialogue: 0,1:02:31.45,1:02:32.58,Default,,0,0,0,,Уау
Dialogue: 0,1:02:32.70,1:02:37.71,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:02:42.84,1:02:44.42,Default,,0,0,0,,Доктор Уотсон
Dialogue: 0,1:02:45.47,1:02:47.05,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:02:49.18,1:02:50.68,Default,,0,0,0,,Оянба
Dialogue: 0,1:02:51.64,1:02:53.85,Default,,0,0,0,,Егер әлі де демалу керек болса
Dialogue: 0,1:02:55.85,1:02:57.31,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:02:57.85,1:02:59.69,Default,,0,0,0,,Ричмондтың ішінде.
Dialogue: 0,1:03:01.81,1:03:05.36,Default,,0,0,0,,Біз қазір штаттарға бара жатырмыз.
Dialogue: 0,1:03:06.24,1:03:10.16,Default,,0,0,0,,Сіз де ескертпелерді орындадыңыз ба?
Dialogue: 0,1:03:12.45,1:03:14.37,Default,,0,0,0,,Сізден кешірім сұраймын
Dialogue: 0,1:03:15.66,1:03:19.17,Default,,0,0,0,,Мен оны тоқтату үшін күшті дәрі қолдандым.
Dialogue: 0,1:03:19.50,1:03:22.96,Default,,0,0,0,,Менің күшім оны тоқтата алмады.
Dialogue: 0,1:03:24.05,1:03:24.96,Default,,0,0,0,,Мен енді сол қателігімді қайталамаймын.
Dialogue: 0,1:03:25.38,1:03:28.22,Default,,0,0,0,,Хмм... Барнаби ше?
Dialogue: 0,1:03:29.76,1:03:33.60,Default,,0,0,0,,Уайымдама, ол да бортта.
Dialogue: 0,1:03:34.22,1:03:36.52,Default,,0,0,0,,Ямазава мырза да қауіпсіз.
Dialogue: 0,1:03:37.18,1:03:39.69,Default,,0,0,0,,Ол Жапониядан болса да.
Dialogue: 0,1:03:40.31,1:03:41.48,Default,,0,0,0,,Мен...
Dialogue: 0,1:03:42.06,1:03:45.44,Default,,0,0,0,,Кеме дәрігері тырысқақпен ауырғанын айтты.
Dialogue: 0,1:03:46.36,1:03:50.49,Default,,0,0,0,,Инфекция көзі Osato Chemical компаниясының жаңа мәйіті ме?
Dialogue: 0,1:03:52.20,1:03:54.37,Default,,0,0,0,,Инфекциядан сақ болыңыз
Dialogue: 0,1:03:55.74,1:03:57.91,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,1:03:59.37,1:04:02.21,Default,,0,0,0,,Біраз уақыттан кейін қозғала аласыз.
Dialogue: 0,1:04:02.88,1:04:04.88,Default,,0,0,0,,Қазір жақсылап демалыңыз.
Dialogue: 0,1:04:08.46,1:04:11.55,Default,,0,0,0,,Рахмет Хадари
Dialogue: 0,1:04:26.23,1:04:29.15,Default,,0,0,0,,Бірдің адамға өшпенділігі бар.
Dialogue: 0,1:04:30.78,1:04:35.87,Default,,0,0,0,,Адамның қалауымен жаратылған және өзімшіл түрде лақтырылған.
Dialogue: 0,1:04:36.62,1:04:39.70,Default,,0,0,0,,Егер сен жәй мәйіт болсаң, оны сезбес едің.
Dialogue: 0,1:04:39.83,1:04:43.29,Default,,0,0,0,,Жек көрушілік пен жалғыздық оны жетелейді
Dialogue: 0,1:04:44.17,1:04:47.30,Default,,0,0,0,,Ол аналитикалық қозғалтқыш пен жазу кітапшасын пайдаланады—
Dialogue: 0,1:04:47.42,1:04:49.30,Default,,0,0,0,,Азия Еуропа елдерінде—
Dialogue: 0,1:04:49.71,1:04:52.88,Default,,0,0,0,,Кең көлемді мәйіттерді ұрлау оқиғасы орын алуда.
Dialogue: 0,1:04:53.80,1:04:56.30,Default,,0,0,0,,Қолында Виктордың жазбалары бар Біреуге...
Dialogue: 0,1:04:56.64,1:05:01.31,Default,,0,0,0,,Біз қауіпті технологияның шексіз таралуына жол бере алмаймыз.
Dialogue: 0,1:05:02.48,1:05:04.02,Default,,0,0,0,,Доктор Уотсонға
Dialogue: 0,1:05:04.15,1:05:07.52,Default,,0,0,0,,Мен оның қуыршағын жөндеуге сендіргім келеді.
Dialogue: 0,1:05:07.86,1:05:10.03,Default,,0,0,0,,Жұманы қалай түзетуге болады?
Dialogue: 0,1:05:11.86,1:05:15.41,Default,,0,0,0,,Бұл Osato Chemical компаниясынан алынған жазу шары.
Dialogue: 0,1:05:15.91,1:05:18.62,Default,,0,0,0,,Бірдің ізі осында қалады...
Dialogue: 0,1:05:18.74,1:05:21.33,Default,,0,0,0,,Мен доктор Уотсонның талдауын қалаймын.
Dialogue: 0,1:05:24.50,1:05:26.50,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге кеңес бере алмаймын.
Dialogue: 0,1:05:26.50,1:05:27.63,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге кеңес бере алмаймын.
Dialogue: 0,1:05:26.50,1:05:27.63,Default,,0,0,0,,
Dialogue: 0,1:05:27.75,1:05:30.46,Default,,0,0,0,,Адамнан тікелей сұраңыз.
Dialogue: 0,1:05:30.59,1:05:31.76,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:05:35.09,1:05:39.06,Default,,0,0,0,,Бірақ, жақсы, мен сенің көмегің үшін өтеймін.
Dialogue: 0,1:05:40.51,1:05:43.35,Default,,0,0,0,,Эй, мына жігітті маған берші.
Dialogue: 0,1:05:44.89,1:05:47.77,Default,,0,0,0,,Дәрігерді орналастыруға болады деп ойлайсыз ба?
Dialogue: 0,1:05:49.61,1:05:52.23,Default,,0,0,0,,Тезірек, қарт қашып кетеді.
Dialogue: 0,1:05:58.32,1:06:01.99,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:06:03.66,1:06:07.00,Default,,0,0,0,,Сіздің Жапонияда көрген көзқарасыңыз шынайы болды
Dialogue: 0,1:06:07.54,1:06:10.54,Default,,0,0,0,,A a… aa…
Dialogue: 0,1:06:11.50,1:06:14.59,Default,,0,0,0,,Жазбаларды талдау сәтті болуы керек.
Dialogue: 0,1:06:15.47,1:06:16.80,Default,,0,0,0,,Бірақ—
Dialogue: 0,1:06:17.43,1:06:21.01,Default,,0,0,0,,Содан бері Necroware қаншалықты жетілдірілгеніне қарамастан...
Dialogue: 0,1:06:21.47,1:06:23.52,Default,,0,0,0,,Түпнұсқаны қайтармайсыз.
Dialogue: 0,1:06:23.68,1:06:26.77,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:06:27.90,1:06:30.06,Default,,0,0,0,,Мен не істеймін -
Dialogue: 0,1:06:30.36,1:06:33.15,Default,,0,0,0,,Бұл сізді азапқа салып жатқан жоқ па?
Dialogue: 0,1:06:47.46,1:06:49.63,Default,,0,0,0,,Сіздің жұма күні қандай?
Dialogue: 0,1:06:49.75,1:06:52.59,Default,,0,0,0,,Сіз доссыз ба? Бұл эксперименттік тақырып па?
Dialogue: 0,1:06:53.59,1:06:56.17,Default,,0,0,0,,Алексей мен Николай дұрыс айтты ма?
Dialogue: 0,1:06:56.30,1:06:57.93,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:06:58.59,1:07:02.43,Default,,0,0,0,,Бірақ олар өз өмірлерін қатерге тігіп, шабуыл жасады!
Dialogue: 0,1:07:03.01,1:07:06.43,Default,,0,0,0,,Бірақ сен қандайсың! Не істедің!
Dialogue: 0,1:07:06.73,1:07:07.56,Default,,0,0,0,,Уф
Dialogue: 0,1:07:08.89,1:07:13.27,Default,,0,0,0,,Өлген адамдар туралы алаңдауды доғарыңыз.
Dialogue: 0,1:07:30.08,1:07:32.50,Default,,0,0,0,,Пол Бунян
Dialogue: 0,1:07:32.71,1:07:37.59,Default,,0,0,0,,Ол сегіз негізгі талдау қозғалтқышында рөл атқарады.
Dialogue: 0,1:07:38.67,1:07:44.97,Default,,0,0,0,,Сіздің механикалық миыңыз бумен және электрмен ойлайды —
Dialogue: 0,1:07:45.10,1:07:49.23,Default,,0,0,0,,Шамадан тыс орнатылған мәйіттердің сөздеріне әуестенді —
Dialogue: 0,1:07:49.35,1:07:52.02,Default,,0,0,0,,Біркелкі емес армандау
Dialogue: 0,1:07:53.61,1:07:55.73,Default,,0,0,0,,Оян
Dialogue: 0,1:07:56.19,1:08:00.03,Default,,0,0,0,,Менің сөздерімді барлық өлгендерге жеткізіңіз -
Dialogue: 0,1:08:00.45,1:08:03.45,Default,,0,0,0,,Өйткені мен бір кездері адам болғанмын...
Dialogue: 0,1:08:03.57,1:08:05.87,Default,,0,0,0,,Шығарылым
Dialogue: 0,1:08:17.00,1:08:18.88,Default,,0,0,0,,Ах
Dialogue: 0,1:08:19.13,1:08:20.63,Default,,0,0,0,,Ах
Dialogue: 0,1:08:26.35,1:08:28.10,Default,,0,0,0,,A… a…
Dialogue: 0,1:08:29.89,1:08:31.81,Default,,0,0,0,,Мен уақытында үлгермеген сияқтымын.
Dialogue: 0,1:08:33.48,1:08:34.85,Default,,0,0,0,,Бұл жерде қауіпті
Dialogue: 0,1:08:35.36,1:08:37.02,Default,,0,0,0,,Қашып кетуге дайындалу
Dialogue: 0,1:08:37.98,1:08:39.94,Default,,0,0,0,,A a… a…
Dialogue: 0,1:08:40.07,1:08:41.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:08:42.15,1:08:43.70,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,1:08:44.16,1:08:46.78,Default,,0,0,0,,Ах... уф
Dialogue: 0,1:08:54.38,1:08:55.71,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,1:08:56.42,1:09:00.42,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:09:19.69,1:09:24.24,Default,,0,0,0,,Бұл жерде емес пе? Оны қайда жасырдың?
Dialogue: 0,1:09:30.87,1:09:34.71,Default,,0,0,0,,Пол Бунянды да The One қабылдады.
Dialogue: 0,1:09:37.79,1:09:40.71,Default,,0,0,0,,Дыбыс толқындарының диапазоны Бірдің бақылауында.
Dialogue: 0,1:09:40.84,1:09:42.09,Default,,0,0,0,,Дыбыс толқындары?
Dialogue: 0,1:09:43.34,1:09:47.26,Default,,0,0,0,,What's going on with this? Қарғыс атсын!
Dialogue: 0,1:09:47.80,1:09:49.81,Default,,0,0,0,,Шынымен осындай азғырумен құпия мәліметтерді ағызып жіберемін деп ойлайсың ба?
Dialogue: 0,1:09:49.89,1:09:52.56,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:09:56.27,1:09:57.23,Default,,0,0,0,,Уф
Dialogue: 0,1:09:57.35,1:09:59.19,Default,,0,0,0,,Бірліктің мақсаты қандай?
Dialogue: 0,1:09:59.32,1:10:02.03,Default,,0,0,0,,Адамдардан кек, мәртебелі мәртебелі...
Dialogue: 0,1:10:02.15,1:10:05.86,Default,,0,0,0,,Маған Бір нәрсе іздеп жүрген сияқты.
Dialogue: 0,1:10:05.99,1:10:07.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:10:09.53,1:10:10.37,Default,,0,0,0,,Ай! (Кугисаки) Бұл не өзі?
Dialogue: 0,1:10:11.12,1:10:13.04,Default,,0,0,0,,Я...
Dialogue: 0,1:10:14.04,1:10:14.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:18.75,1:10:20.17,Default,,0,0,0,,(шу)
Dialogue: 0,1:10:20.63,1:10:23.92,Default,,0,0,0,,Бұл жауап және мен қалаған жауап—
Dialogue: 0,1:10:24.05,1:10:26.68,Default,,0,0,0,,Сіздің жауабыңыз да бар шығар.
Dialogue: 0,1:10:28.09,1:10:29.60,Default,,0,0,0,,Егер жабайы бола бастаса, оны қолданыңыз.
Dialogue: 0,1:10:30.22,1:10:32.10,Default,,0,0,0,,Because my Пауэр can't stop it
Dialogue: 0,1:10:39.52,1:10:40.65,Default,,0,0,0,,Келіңіз
Dialogue: 0,1:10:42.90,1:10:46.36,Default,,0,0,0,,Мемлекеттер Бірден бір қадам алда.
Dialogue: 0,1:10:46.74,1:10:52.12,Default,,0,0,0,,Ұлыбритания Египет Үндістан Ауғанстан Жапония
Dialogue: 0,1:10:53.54,1:10:57.54,Default,,0,0,0,,Мен оның іздерін және жазбаларын бүкіл әлемнен іздедім, бірақ...
Dialogue: 0,1:10:57.67,1:10:59.12,Default,,0,0,0,,Түсіру мүмкін болмады
Dialogue: 0,1:11:00.92,1:11:02.63,Default,,0,0,0,,Доктор Уотсон
Dialogue: 0,1:11:03.21,1:11:04.76,Default,,0,0,0,,Тек сіздің еркіңіз
Dialogue: 0,1:11:04.88,1:11:07.51,Default,,0,0,0,,I found The One and my notes.
Dialogue: 0,1:11:07.68,1:11:09.13,Default,,0,0,0,,Ах
Dialogue: 0,1:11:09.26,1:11:11.64,Default,,0,0,0,,Сіз өрт ұрысыз ба?
Dialogue: 0,1:11:14.47,1:11:15.89,Default,,0,0,0,,Я...
Dialogue: 0,1:11:16.31,1:11:19.40,Default,,0,0,0,,Өліге қарағанда, тірілер өз қалағанын істемейді.
Dialogue: 0,1:11:20.31,1:11:21.86,Default,,0,0,0,,Бірақ Хадари
Dialogue: 0,1:11:22.52,1:11:24.65,Default,,0,0,0,,Сіз басқаша болуыңыз керек.
Dialogue: 0,1:11:24.78,1:11:27.36,Default,,0,0,0,,Оны осында әкеліңіз.
Dialogue: 0,1:11:36.75,1:11:39.00,Default,,0,0,0,,Уау, о
Dialogue: 0,1:11:41.25,1:11:43.29,Default,,0,0,0,,Жан 21 грамм
Dialogue: 0,1:11:43.42,1:11:46.13,Default,,0,0,0,,Сонда бұл массаның көзі неде?
Dialogue: 0,1:11:46.55,1:11:49.34,Default,,0,0,0,,Сіз жауапқа жақындадыңыз.
Dialogue: 0,1:11:50.88,1:11:52.43,Default,,0,0,0,,Маған жан керек
Dialogue: 0,1:11:53.85,1:11:55.64,Default,,0,0,0,,Көз жасын төгу үшін
Dialogue: 0,1:11:55.72,1:11:59.06,Default,,0,0,0,,Жанның мұң мен мұңды сезгенін қалаймын
Dialogue: 0,1:12:01.60,1:12:03.77,Default,,0,0,0,,Мені өзіңізбен бірге алып кетіңізші.
Dialogue: 0,1:12:07.19,1:12:08.57,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:12:09.70,1:12:12.49,Default,,0,0,0,,Ей, енді мен қарызымды төледім.
Dialogue: 0,1:12:13.53,1:12:15.58,Default,,0,0,0,,Ах… Уг
Dialogue: 0,1:12:17.20,1:12:18.04,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,1:12:18.41,1:12:20.21,Default,,0,0,0,,Don't let me escape! (Хадары) Күте тұрыңыз.
Dialogue: 0,1:12:21.87,1:12:23.21,Default,,0,0,0,,Хадары!
Dialogue: 0,1:12:23.33,1:12:27.59,Default,,0,0,0,,Қуыршақтар армандай алмайды!
Dialogue: 0,1:12:29.09,1:12:30.26,Default,,0,0,0,,Га
Dialogue: 0,1:12:45.31,1:12:48.19,Default,,0,0,0,,Хадари Сіз мәйіттерді басқара аласыз ба?
Dialogue: 0,1:12:49.19,1:12:51.20,Default,,0,0,0,,Арнайы сөздер арқылы
Dialogue: 0,1:12:52.32,1:12:54.45,Default,,0,0,0,,Бұл дыбыс толқындарының шынайы табиғаты ма?
Dialogue: 0,1:12:55.16,1:12:59.20,Default,,0,0,0,,Некробағдарламаларды талдау агенттігі Тіпті қоғамда да—
Dialogue: 0,1:12:59.33,1:13:01.83,Default,,0,0,0,,Күрделі үлгі болуы керек:
Dialogue: 0,1:13:01.96,1:13:03.71,Default,,0,0,0,,Қауіпсіздік тесігі бар
Dialogue: 0,1:13:04.58,1:13:07.71,Default,,0,0,0,,Сіз және Біреу сонда шабуыл жасай аласыз.
Dialogue: 0,1:13:08.17,1:13:10.21,Default,,0,0,0,,Бұл Бірді тоқтатпайды ма?
Dialogue: 0,1:13:10.96,1:13:12.67,Default,,0,0,0,,Пол Бунян сол жерде.
Dialogue: 0,1:13:12.80,1:13:15.05,Default,,0,0,0,,Менің ойымша, ол енді жоқ.
Dialogue: 0,1:13:15.18,1:13:16.35,Default,,0,0,0,,Әй?
Dialogue: 0,1:13:18.18,1:13:19.47,Default,,0,0,0,,Доктор Уотсон
Dialogue: 0,1:13:19.89,1:13:22.89,Default,,0,0,0,,Менің қауіпсіз үйім маяк астында.
Dialogue: 0,1:13:23.31,1:13:25.85,Default,,0,0,0,,Ендеше өз қалпымызды қалпына келтірейік.
Dialogue: 0,1:13:29.57,1:13:30.23,Default,,0,0,0,,Ах
Dialogue: 0,1:13:33.24,1:13:34.57,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,1:13:36.70,1:13:38.20,Default,,0,0,0,,Уф...
Dialogue: 0,1:13:44.12,1:13:46.92,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:13:47.42,1:13:49.42,Default,,0,0,0,,Ааа!
Dialogue: 0,1:13:49.88,1:13:51.46,Default,,0,0,0,,Әй, жұма!
Dialogue: 0,1:13:54.76,1:13:56.22,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,1:14:06.15,1:14:09.44,Default,,0,0,0,,Алексейдің айтқаны осы еді...
Dialogue: 0,1:14:11.32,1:14:14.19,Default,,0,0,0,,Beyond the notes... reality...
Dialogue: 0,1:14:16.91,1:14:19.62,Default,,0,0,0,,Доктор Уотсон медицинаны қолданады
Dialogue: 0,1:14:22.83,1:14:24.41,Default,,0,0,0,,Бұрын! (Хадары) А.
Dialogue: 0,1:14:24.91,1:14:27.58,Default,,0,0,0,,Олар өте көп. Сіз олардан құтыла аласыз ба!?
Dialogue: 0,1:14:32.75,1:14:33.59,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:14:48.02,1:14:51.44,Default,,0,0,0,,А... (Жұма ыңырсып)
Dialogue: 0,1:14:51.73,1:14:54.03,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,1:14:56.40,1:14:59.49,Default,,0,0,0,,Ааа ааа
Dialogue: 0,1:14:59.87,1:15:03.95,Default,,0,0,0,,Уф, жұма, тоқтат!
Dialogue: 0,1:15:07.92,1:15:09.12,Default,,0,0,0,,Ah...
Dialogue: 0,1:15:09.71,1:15:10.63,Default,,0,0,0,,Тез кел
Dialogue: 0,1:15:15.55,1:15:17.05,Default,,0,0,0,,Алға
Dialogue: 0,1:15:18.51,1:15:19.89,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,1:15:20.22,1:15:22.14,Default,,0,0,0,,Мен саған осы жерден біраз уақыт сатып аламын.
Dialogue: 0,1:15:22.26,1:15:22.72,Default,,0,0,0,,Міне... а
Dialogue: 0,1:15:22.72,1:15:23.76,Default,,0,0,0,,Міне... а
Dialogue: 0,1:15:22.72,1:15:23.76,Default,,0,0,0,,Ууу
Dialogue: 0,1:15:27.94,1:15:29.44,Default,,0,0,0,,Я...
Dialogue: 0,1:15:29.52,1:15:30.73,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:15:32.02,1:15:34.98,Default,,0,0,0,,Бұл жағдайға мен себепкер болған сияқтымын.
Dialogue: 0,1:15:34.98,1:15:35.86,Default,,0,0,0,,Бұл жағдайға мен себепкер болған сияқтымын.
Dialogue: 0,1:15:34.98,1:15:35.86,Default,,0,0,0,,Тез жүр!
Dialogue: 0,1:15:35.86,1:15:35.98,Default,,0,0,0,,Тез жүр!
Dialogue: 0,1:15:35.98,1:15:36.15,Default,,0,0,0,,Тез жүр!
Dialogue: 0,1:15:35.98,1:15:36.15,Default,,0,0,0,,Балалар, сендерді артта қалдырмаңдар!
Dialogue: 0,1:15:36.15,1:15:37.65,Default,,0,0,0,,Балалар, сендерді артта қалдырмаңдар!
Dialogue: 0,1:15:37.82,1:15:41.45,Default,,0,0,0,,Мұны бізге қалдырып, қауіпсіз үйге асығыңыз.
Dialogue: 0,1:15:42.28,1:15:44.99,Default,,0,0,0,,Алексей: «Дайынсың ба?
Dialogue: 0,1:15:46.08,1:15:47.62,Default,,0,0,0,,Мені қандай шындық күтіп тұрса да, мен алға ұмтыламын.
Dialogue: 0,1:15:47.62,1:15:48.96,Default,,0,0,0,,Мені қандай шындық күтіп тұрса да, мен алға ұмтыламын.
Dialogue: 0,1:15:47.62,1:15:48.96,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:15:48.96,1:15:49.41,Default,,0,0,0,,Мені қандай шындық күтіп тұрса да, мен алға ұмтыламын.
Dialogue: 0,1:15:50.25,1:15:52.38,Default,,0,0,0,,Осы сөздің мағынасын білсем ғой...
Dialogue: 0,1:15:54.84,1:15:56.80,Default,,0,0,0,,Хадари өтінемін!
Dialogue: 0,1:15:56.92,1:15:57.76,Default,,0,0,0,,Га
Dialogue: 0,1:16:02.43,1:16:03.80,Default,,0,0,0,,Сен…
Dialogue: 0,1:16:06.27,1:16:09.81,Default,,0,0,0,,Мен механикалық қуыршақпын
Dialogue: 0,1:16:11.94,1:16:13.52,Default,,0,0,0,,Енді не істеу керек:
Dialogue: 0,1:16:13.65,1:16:15.52,Default,,0,0,0,,Бірдің қайда екенін табыңыз.
Dialogue: 0,1:16:16.53,1:16:18.53,Default,,0,0,0,,Жақында жетеміз.
Dialogue: 0,1:16:19.86,1:16:21.61,Default,,0,0,0,,Бірден кейін
Dialogue: 0,1:16:22.86,1:16:25.66,Default,,0,0,0,,Жан сырыңды айт
Dialogue: 0,1:16:26.29,1:16:27.66,Default,,0,0,0,,Мен ғой, мен…-сан ба?
Dialogue: 0,1:16:49.39,1:16:51.94,Default,,0,0,0,,Мен Виктордың дәптерін алған кезде...
Dialogue: 0,1:16:52.39,1:16:55.65,Default,,0,0,0,,Мен саған берген уәдемді орындаймын деп ойладым.
Dialogue: 0,1:16:56.06,1:16:59.65,Default,,0,0,0,,(Жұма күнгі ыңырсы)
Dialogue: 0,1:17:03.45,1:17:05.49,Default,,0,0,0,,Қандай жағдай болмасын—
Dialogue: 0,1:17:07.45,1:17:09.75,Default,,0,0,0,,Мен уәдемді орындағым келді
Dialogue: 0,1:17:11.37,1:17:15.38,Default,,0,0,0,,(Жұма күнгі ыңырсы)
Dialogue: 0,1:17:21.51,1:17:24.43,Default,,0,0,0,,(Жұма күнгі ырылдау)
Dialogue: 0,1:17:26.18,1:17:30.10,Default,,0,0,0,,Жұма, қазір не көріп отырсың?
Dialogue: 0,1:17:32.73,1:17:33.56,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:17:33.69,1:17:36.44,Default,,0,0,0,,Сенің жаның қайда?
Dialogue: 0,1:17:37.36,1:17:37.77,Default,,0,0,0,,жұма!
Dialogue: 0,1:17:37.77,1:17:38.90,Default,,0,0,0,,жұма!
Dialogue: 0,1:17:37.77,1:17:38.90,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:17:39.73,1:17:40.69,Default,,0,0,0,,Мен...
Dialogue: 0,1:17:42.53,1:17:44.45,Default,,0,0,0,,Мен сені қайта көргім келді!
Dialogue: 0,1:17:45.11,1:17:46.70,Default,,0,0,0,,Мен сенің естігеніңді қаладым!
Dialogue: 0,1:17:47.32,1:17:49.83,Default,,0,0,0,,Сөзіңізді жалғастырыңыз!
Dialogue: 0,1:17:50.41,1:17:51.70,Default,,0,0,0,,Уф
Dialogue: 0,1:17:53.00,1:17:53.96,Default,,0,0,0,,Бұл – иллюзия сиқыры.
Dialogue: 0,1:17:56.29,1:17:58.46,Default,,0,0,0,,Оны неге сонда қалдырдың?
Dialogue: 0,1:17:59.29,1:18:01.46,Default,,0,0,0,,Неге қайтып келмейсің?
Dialogue: 0,1:18:05.22,1:18:06.34,Default,,0,0,0,,Га
Dialogue: 0,1:18:09.97,1:18:10.64,Default,,0,0,0,,Ха...
Dialogue: 0,1:18:10.64,1:18:11.18,Default,,0,0,0,,Ха...
Dialogue: 0,1:18:10.64,1:18:11.18,Default,,0,0,0,,(дыбыс толқындары арқылы пайда болатын дыбыс)
Dialogue: 0,1:18:11.18,1:18:11.89,Default,,0,0,0,,(дыбыс толқындары арқылы пайда болатын дыбыс)
Dialogue: 0,1:18:11.89,1:18:12.72,Default,,0,0,0,,(дыбыс толқындары тудыратын дыбыс)
Dialogue: 0,1:18:11.89,1:18:12.72,Default,,0,0,0,,жұма
Dialogue: 0,1:18:14.06,1:18:16.65,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:19.23,1:18:23.49,Default,,0,0,0,,Сіз мені түсінесіз бе? жұма!
Dialogue: 0,1:18:32.08,1:18:33.25,Default,,0,0,0,,Га
Dialogue: 0,1:18:34.87,1:18:36.00,Default,,0,0,0,,H… A…
Dialogue: 0,1:18:38.58,1:18:41.38,Default,,0,0,0,,Ақыр соңында… сіз…
Dialogue: 0,1:18:41.84,1:18:43.26,Default,,0,0,0,,Сіз сондасыз.
Dialogue: 0,1:18:44.72,1:18:47.26,Default,,0,0,0,,(дыбыс толқындары арқылы пайда болатын дыбыс)
Dialogue: 0,1:18:47.55,1:18:51.56,Default,,0,0,0,,(Жұма күнгі ырылдау)
Dialogue: 0,1:18:59.86,1:19:00.52,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:01.15,1:19:04.19,Default,,0,0,0,,Ол түкіріп жатқан бұл қан не?
Dialogue: 0,1:19:07.24,1:19:08.45,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:19:16.33,1:19:19.25,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,1:20:33.57,1:20:34.62,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:20:38.91,1:20:39.83,Default,,0,0,0,,Осымен
Dialogue: 0,1:20:41.37,1:20:42.96,Default,,0,0,0,,Жаднама алайық
Dialogue: 0,1:20:44.63,1:20:48.34,Default,,0,0,0,,Хмм, бұл мен күткеннен жылдамырақ болды.
Dialogue: 0,1:20:48.42,1:20:49.46,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,1:20:50.38,1:20:51.22,Default,,0,0,0,,(таяқтың дыбысы)
Dialogue: 0,1:20:59.56,1:21:00.89,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:21:08.86,1:21:11.53,Default,,0,0,0,,Сағындым сені, Жалғыз.
Dialogue: 0,1:21:13.15,1:21:15.87,Default,,0,0,0,,Уолсингем М?
Dialogue: 0,1:21:16.70,1:21:21.04,Default,,0,0,0,,Жазба сіздің тілегіңізді орындамаған сияқты.
Dialogue: 0,1:21:21.20,1:21:23.83,Default,,0,0,0,,Дүние жүзіндегі аналитикалық институттарды пайдалану —
Dialogue: 0,1:21:24.12,1:21:26.29,Default,,0,0,0,,Мәйітті жабайы жіберу —
Dialogue: 0,1:21:26.59,1:21:28.04,Default,,0,0,0,,Сіз не іздедіңіз?
Dialogue: 0,1:21:31.63,1:21:34.13,Default,,0,0,0,,Хмм, жарайды.
Dialogue: 0,1:21:34.26,1:21:38.85,Default,,0,0,0,,Осы жазбамен және сізбен менің тілегім орындалады.
Dialogue: 0,1:21:40.52,1:21:43.44,Default,,0,0,0,,Дәптермен не істейсің?
Dialogue: 0,1:21:44.77,1:21:47.02,Default,,0,0,0,,Адамзаттың кемелділігіне қарай -
Dialogue: 0,1:21:47.15,1:21:49.94,Default,,0,0,0,,Жанжалсыз әлемге жетелеу
Dialogue: 0,1:21:50.57,1:21:51.99,Default,,0,0,0,,Сол менмендік сені құртады.
Dialogue: 0,1:21:51.99,1:21:53.95,Default,,0,0,0,,Сол менмендік сені құртады.
Dialogue: 0,1:21:51.99,1:21:53.95,Default,,0,0,0,,(Бірнеше қадам)
Dialogue: 0,1:21:55.28,1:21:56.20,Default,,0,0,0,,Хун
Dialogue: 0,1:21:56.99,1:21:58.20,Default,,0,0,0,,Мені ал
Dialogue: 0,1:22:13.26,1:22:14.55,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:22:27.31,1:22:28.44,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:22:31.82,1:22:33.19,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:22:33.99,1:22:35.95,Default,,0,0,0,,Мен қателестім
Dialogue: 0,1:22:36.07,1:22:37.16,Default,,0,0,0,,Уф
Dialogue: 0,1:22:38.07,1:22:39.57,Default,,0,0,0,,«Кешіріңіз» деген не?
Dialogue: 0,1:22:40.28,1:22:42.16,Default,,0,0,0,,Енді кешірім сұраудың мәні неде?
Dialogue: 0,1:22:42.29,1:22:45.25,Default,,0,0,0,,Егер сіз жазбаларыңызды жойған болсаңыз...
Dialogue: 0,1:22:45.37,1:22:47.37,Default,,0,0,0,,Бұл болған жоқ!
Dialogue: 0,1:22:49.00,1:22:51.21,Default,,0,0,0,,Әйелдер, балалар және қарттар —
Dialogue: 0,1:22:51.88,1:22:53.13,Default,,0,0,0,,Барлығы өлді!
Dialogue: 0,1:22:53.96,1:22:57.88,Default,,0,0,0,,Сіздің қалауыңыз бойынша...
Dialogue: 0,1:22:59.14,1:23:00.35,Default,,0,0,0,,Боқ...
Dialogue: 0,1:23:01.76,1:23:03.39,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,1:23:05.10,1:23:07.35,Default,,0,0,0,,Мен өзімді кінәсіз деп санамаймын
Dialogue: 0,1:23:08.27,1:23:10.61,Default,,0,0,0,,Мені өлтіргенім жақсы деп ойласаң, солай істе.
Dialogue: 0,1:23:13.48,1:23:16.70,Default,,0,0,0,,Тек рұқсат етілген жағдайда
Dialogue: 0,1:23:17.40,1:23:20.28,Default,,0,0,0,,Алексейге және басқаларға берген уәдемді орындау мүмкіндігі.
Dialogue: 0,1:23:21.28,1:23:25.50,Default,,0,0,0,,Маған бұл тәртіпсіздікті тоқтатуға мәжбүр ет, Барнаби!
Dialogue: 0,1:23:30.83,1:23:35.21,Default,,0,0,0,,Мен оның қайда екенін де білмеймін, мұны қалай істей аламын?
Dialogue: 0,1:23:35.34,1:23:37.26,Default,,0,0,0,,Жұма (есіктің ашылған дыбысы)
Dialogue: 0,1:23:37.72,1:23:40.43,Default,,0,0,0,,Оны әкеліп, Барнабиге көрсет.
Dialogue: 0,1:23:42.85,1:23:44.97,Default,,0,0,0,,Ах (Хадары) Ах...
Dialogue: 0,1:23:47.02,1:23:49.64,Default,,0,0,0,,Бұл Бірден шақыру хаты.
Dialogue: 0,1:23:56.36,1:23:57.32,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,1:23:58.07,1:24:00.24,Default,,0,0,0,,Ах, жазу шары—
Dialogue: 0,1:24:00.36,1:24:03.12,Default,,0,0,0,,Шифрланған кодпен тікелей жіберілді
Dialogue: 0,1:24:04.62,1:24:08.00,Default,,0,0,0,,Біреуі Лондон мұнарасына тасымалданады.
Dialogue: 0,1:24:08.66,1:24:11.37,Default,,0,0,0,,М өз ноталарының күшін пайдаланады...
Dialogue: 0,1:24:11.50,1:24:13.96,Default,,0,0,0,,Қорқынышты нәрсені жоспарлау
Dialogue: 0,1:24:14.46,1:24:16.25,Default,,0,0,0,,Мүмкін Чарльз Бэббидж—
Dialogue: 0,1:24:16.38,1:24:18.01,Default,,0,0,0,,Бірді талдау керек
Dialogue: 0,1:24:22.39,1:24:26.35,Default,,0,0,0,,Мен ешқашан Уолсингеммен айналысуым керек деп ойламадым.
Dialogue: 0,1:24:27.35,1:24:28.52,Default,,0,0,0,,Қолдар бар ма?
Dialogue: 0,1:24:29.39,1:24:32.15,Default,,0,0,0,,Байланыс үшін мамандандырылған жұманы пайдалану —
Dialogue: 0,1:24:32.27,1:24:35.11,Default,,0,0,0,,Талдау механизмінде логикалық лабиринт құру
Dialogue: 0,1:24:35.65,1:24:37.28,Default,,0,0,0,,Қоршау сақинасын жасаңыз -
Dialogue: 0,1:24:37.40,1:24:39.65,Default,,0,0,0,,Әуеннің таралуын қамтитын
Dialogue: 0,1:24:40.65,1:24:42.70,Default,,0,0,0,,Ол үшін оны қашықтан орындау мүмкін емес.
Dialogue: 0,1:24:44.16,1:24:45.20,Default,,0,0,0,,Кіргіңіз келе ме?
Dialogue: 0,1:24:46.24,1:24:49.29,Default,,0,0,0,,Барнаби, маған күшіңді берші.
Dialogue: 0,1:24:50.37,1:24:51.62,Default,,0,0,0,,Иә
Dialogue: 0,1:24:52.71,1:24:55.09,Default,,0,0,0,,Менің айтқым келгені осы еді.
Dialogue: 0,1:24:59.09,1:25:00.51,Default,,0,0,0,,Рахмет
Dialogue: 0,1:25:01.01,1:25:05.01,Default,,0,0,0,,(лифт жұмысының дыбысы)
Dialogue: 0,1:25:09.93,1:25:11.48,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:25:11.81,1:25:15.27,Default,,0,0,0,,Бұл сіздің әкеңіз салған жерасты тәжірибелік нысаны.
Dialogue: 0,1:25:15.40,1:25:16.94,Default,,0,0,0,,Әке?
Dialogue: 0,1:25:19.73,1:25:20.86,Default,,0,0,0,,Ах
Dialogue: 0,1:25:22.78,1:25:25.28,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:25:26.03,1:25:28.03,Default,,0,0,0,,...
Dialogue: 0,1:25:29.08,1:25:33.16,Default,,0,0,0,,Президенттің бұйрығымен Англиядан жасырын түрде тұтқынға алынды.
Dialogue: 0,1:25:33.29,1:25:35.71,Default,,0,0,0,,Әкем нені өзгертті
Dialogue: 0,1:25:36.88,1:25:39.17,Default,,0,0,0,,Осы заманауи кемемен —
Dialogue: 0,1:25:39.30,1:25:43.09,Default,,0,0,0,,Менің ойымша, мен бірдеңе болмай тұрып The Ones-ты қуып жете аламын.
Dialogue: 0,1:25:45.80,1:25:46.93,Default,,0,0,0,,Сіз қазір кетесіз бе?
Dialogue: 0,1:25:48.43,1:25:52.68,Default,,0,0,0,,Жақында рух әлемімен байланыс құрылғысы аяқталатын сияқты...
Dialogue: 0,1:25:52.81,1:25:54.69,Default,,0,0,0,,Неге қарамайсың?
Dialogue: 0,1:25:56.40,1:25:58.94,Default,,0,0,0,,Осы сапардан қайтқанда міндетті түрде
Dialogue: 0,1:26:00.15,1:26:01.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:26:02.53,1:26:06.24,Default,,0,0,0,,Хадари: Мен үкімет туралы үндемеймін.
Dialogue: 0,1:26:06.36,1:26:09.95,Default,,0,0,0,,Бар күш-жігеріңізбен сенетін нәрсені жасаңыз
Dialogue: 0,1:26:17.29,1:26:18.96,Default,,0,0,0,,Томас Эдисон
Dialogue: 0,1:26:19.88,1:26:22.26,Default,,0,0,0,,Сенің әкең біледі ме?
Dialogue: 0,1:26:22.38,1:26:24.80,Default,,0,0,0,,Сіз не іздеп жүрсіз?
Dialogue: 0,1:26:25.34,1:26:26.51,Default,,0,0,0,,Иә
Dialogue: 0,1:26:26.63,1:26:30.26,Default,,0,0,0,,Бірақ әкем шуды құптамайды.
Dialogue: 0,1:26:30.81,1:26:32.10,Default,,0,0,0,,Шу?
Dialogue: 0,1:26:32.68,1:26:34.85,Default,,0,0,0,,Жан массасының қайнар көзі?
Dialogue: 0,1:26:35.56,1:26:41.02,Default,,0,0,0,,Ниет салмағы, ой салмағы, ой салмағы
Dialogue: 0,1:26:42.07,1:26:44.15,Default,,0,0,0,,Осыдан туындаған сезімдер:
Dialogue: 0,1:26:44.28,1:26:48.24,Default,,0,0,0,,Мен оны шу ретінде қабылдамау үшін жаратылғанмын.
Dialogue: 0,1:26:48.91,1:26:53.62,Default,,0,0,0,,Мүмкін мен сенің мұңыңды, қиналғаныңды көргім келмеді.
Dialogue: 0,1:26:54.33,1:26:57.92,Default,,0,0,0,,Бірақ мен осыны білгім келеді.
Dialogue: 0,1:26:59.38,1:27:00.25,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,1:27:03.92,1:27:06.01,Default,,0,0,0,,Бұл сәтсіздік.
Dialogue: 0,1:27:32.16,1:27:33.91,Default,,0,0,0,,Бұл жұмыс оңай емес, білесің бе!
Dialogue: 0,1:27:34.04,1:27:37.16,Default,,0,0,0,,Мидағы ақпаратты талдаумен қатар—
Dialogue: 0,1:27:37.87,1:27:40.42,Default,,0,0,0,,Жазбаларды талдау аяқталды.
Dialogue: 0,1:27:41.25,1:27:44.96,Default,,0,0,0,,Бар болғаны шығару кодын енгізсеңіз болғаны.
Dialogue: 0,1:27:45.96,1:27:48.01,Default,,0,0,0,,Виктордың миы
Dialogue: 0,1:27:49.68,1:27:52.05,Default,,0,0,0,,Ол сонда болды ма?
Dialogue: 0,1:27:52.80,1:27:54.97,Default,,0,0,0,,Сені мәйіт өлтіреді ме?
Dialogue: 0,1:27:55.10,1:27:57.56,Default,,0,0,0,,Адамдар бір-бірін өлтіре ме?
Dialogue: 0,1:27:57.89,1:28:01.56,Default,,0,0,0,,Бұлай жалғаса берсе, адамзат жойылады.
Dialogue: 0,1:28:02.02,1:28:05.28,Default,,0,0,0,,Мен адамзатты жойылудан сақтаймын.
Dialogue: 0,1:28:06.11,1:28:09.57,Default,,0,0,0,,Адамзат жаңа кезеңге көтеріледі
Dialogue: 0,1:28:23.79,1:28:26.05,Default,,0,0,0,,Чарльз Бэббидж!
Dialogue: 0,1:28:26.67,1:28:31.80,Default,,0,0,0,,Бүкіл адамзатты құтқаруға жетеле!
Dialogue: 0,1:28:49.65,1:28:51.03,Default,,0,0,0,,Уа-уай-ау
Dialogue: 0,1:28:52.86,1:28:53.70,Default,,0,0,0,,Ой
Dialogue: 0,1:29:01.25,1:29:02.12,Default,,0,0,0,,Ах!
Dialogue: 0,1:29:09.26,1:29:10.67,Default,,0,0,0,,Сіз тұтқынға түскен сияқтысыз.
Dialogue: 0,1:29:10.84,1:29:13.80,Default,,0,0,0,,Мені қарсы алғаныңызға рахмет.
Dialogue: 0,1:29:14.59,1:29:18.22,Default,,0,0,0,,Мен ең қысқа қашықтыққа барамын, бірақ бұл таңқаларлық болуы мүмкін.
Dialogue: 0,1:29:18.77,1:29:20.31,Default,,0,0,0,,Мен мұны сізге қалдырамын
Dialogue: 0,1:29:23.73,1:29:25.40,Default,,0,0,0,,Дайын
Dialogue: 0,1:29:25.52,1:29:27.94,Default,,0,0,0,,Мен оны жұма күні сұрадым.
Dialogue: 0,1:29:29.61,1:29:30.99,Default,,0,0,0,,Мен бетке шығамын
Dialogue: 0,1:29:39.29,1:29:41.29,Default,,0,0,0,,Ол қазірдің өзінде басталды ма?
Dialogue: 0,1:29:45.08,1:29:47.04,Default,,0,0,0,,Санның үлкен қорғанысы.
Dialogue: 0,1:29:49.25,1:29:51.76,Default,,0,0,0,,Объективті Сатқынның қақпасы
Dialogue: 0,1:29:52.47,1:29:54.26,Default,,0,0,0,,Мәжбүрлеп жарып өту!
Dialogue: 0,1:29:59.89,1:30:00.72,Default,,0,0,0,,Хун
Dialogue: 0,1:30:04.10,1:30:06.77,Default,,0,0,0,,(Әскерлер арасындағы сыбыр)
Dialogue: 0,1:30:15.53,1:30:19.62,Default,,0,0,0,,Бұрынғы билеушілер де қақтығыссыз әлемге ұмтылды.
Dialogue: 0,1:30:20.33,1:30:24.62,Default,,0,0,0,,Елінің халқын қорғау үшін шайқас батпағына аттанды.
Dialogue: 0,1:30:25.25,1:30:27.42,Default,,0,0,0,,Хамф!
Dialogue: 0,1:30:28.21,1:30:31.63,Default,,0,0,0,,Өз тыныштығы үшін басқа елге басып кіру
Dialogue: 0,1:30:32.26,1:30:36.05,Default,,0,0,0,,Қорғау күші мен тартып алу күшін ажырата алмайды
Dialogue: 0,1:30:36.13,1:30:38.93,Default,,0,0,0,,Оның қате екенін түсінсеңіз де, оны тоқтата алмайсыз
Dialogue: 0,1:30:39.43,1:30:41.47,Default,,0,0,0,,Адам деген осындай
Dialogue: 0,1:30:41.76,1:30:42.85,Default,,0,0,0,,Алға!
Dialogue: 0,1:30:43.14,1:30:44.60,Default,,0,0,0,,А, сен ше?
Dialogue: 0,1:30:45.35,1:30:47.40,Default,,0,0,0,,Лондон мұнарасының қуатын тоқтату
Dialogue: 0,1:30:47.81,1:30:49.90,Default,,0,0,0,,Сіз мұны жалғыз жасай алмайсыз! Ах
Dialogue: 0,1:30:50.48,1:30:54.53,Default,,0,0,0,,Сіздің жіңішке қолдарыңызбен салыстырғанда олар үлкен.
Dialogue: 0,1:30:54.78,1:30:57.61,Default,,0,0,0,,Бар, егер жоспарыңды орындасаң...
Dialogue: 0,1:30:57.74,1:30:59.95,Default,,0,0,0,,Сіз әлемді құтқара аласыз, солай ма?
Dialogue: 0,1:31:04.87,1:31:06.04,Default,,0,0,0,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,1:31:12.09,1:31:13.42,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,1:31:13.55,1:31:14.51,Default,,0,0,0,,На
Dialogue: 0,1:31:16.80,1:31:20.68,Default,,0,0,0,,Осындай кезде мен сенің түсінгеніңді қалаймын.
Dialogue: 0,1:31:21.05,1:31:23.26,Default,,0,0,0,,Эмоциялар
Dialogue: 0,1:31:29.31,1:31:31.52,Default,,0,0,0,,Үмітсіздік?
Dialogue: 0,1:31:32.11,1:31:33.65,Default,,0,0,0,,Нұсқаулық
Dialogue: 0,1:31:34.40,1:31:37.82,Default,,0,0,0,,Барлығының үмітсіздік сезінуіне мүмкіндік бермейтін нәрсе:
Dialogue: 0,1:31:38.20,1:31:41.12,Default,,0,0,0,,Бақыттың бір түсінігі.
Dialogue: 0,1:31:42.78,1:31:47.62,Default,,0,0,0,,Енді бір-бірін ұрыс-керіс, жек көру немесе өлтіру болмайды.
Dialogue: 0,1:31:48.21,1:31:51.67,Default,,0,0,0,,Қақтығыстар туралы білу қабілеті де жойылады.
Dialogue: 0,1:31:52.88,1:31:55.42,Default,,0,0,0,,М Алексейдің техникасына негізделген.
Dialogue: 0,1:31:55.96,1:31:58.34,Default,,0,0,0,,Адамдардың еркін тартып алуға тырысу
Dialogue: 0,1:31:59.47,1:32:02.26,Default,,0,0,0,,Мен мұндай дүниені қаламаймын
Dialogue: 0,1:32:03.10,1:32:07.02,Default,,0,0,0,,Қуанышты бағдарламамен емес, жаныммен білгім келеді.
Dialogue: 0,1:32:07.81,1:32:08.35,Default,,0,0,0,,Өйткені қайғы мен қасірет бар -
Dialogue: 0,1:32:08.35,1:32:10.35,Default,,0,0,0,,Өйткені қайғы мен қайғы бар
Dialogue: 0,1:32:08.35,1:32:10.35,Default,,0,0,0,,(Барнабидің айқайы)
Dialogue: 0,1:32:10.35,1:32:10.48,Default,,0,0,0,,(Барнабидің айқайы)
Dialogue: 0,1:32:10.48,1:32:12.44,Default,,0,0,0,,(Барнабидің айқайы)
Dialogue: 0,1:32:10.48,1:32:12.44,Default,,0,0,0,,Сіз қуанышты сезінесіз бе?
Dialogue: 0,1:32:15.27,1:32:16.19,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:32:16.78,1:32:18.03,Default,,0,0,0,,Кеттік
Dialogue: 0,1:32:30.25,1:32:32.42,Default,,0,0,0,,Жақында адамзаттың қалауы бойынша —
Dialogue: 0,1:32:32.54,1:32:37.05,Default,,0,0,0,,Ақырғы әлемге жете алмау
Dialogue: 0,1:32:38.67,1:32:41.68,Default,,0,0,0,,Әрбір жанда—
Dialogue: 0,1:32:41.80,1:32:44.51,Default,,0,0,0,,Мен анықтаймын
Dialogue: 0,1:32:44.68,1:32:49.02,Default,,0,0,0,,Жан дүниесі таза, күлімсіреген нәзік
Dialogue: 0,1:32:50.06,1:32:55.23,Default,,0,0,0,,Мәйіттің жаны мен еркі болмауы керек.
Dialogue: 0,1:32:56.23,1:33:01.53,Default,,0,0,0,,М Сен өзіңді құдіретті етіп көрсететін ақымақ адамсың.
Dialogue: 0,1:33:01.99,1:33:05.28,Default,,0,0,0,,Виктор Франкенштейн сияқты
Dialogue: 0,1:33:06.53,1:33:09.87,Default,,0,0,0,,Уайымдама, мен де сенің жаныңды пайдаланамын.
Dialogue: 0,1:33:10.00,1:33:12.33,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:33:12.67,1:33:15.79,Default,,0,0,0,,М! Чарльз Бэббиджді тоқтатыңыз!
Dialogue: 0,1:33:20.92,1:33:23.80,Default,,0,0,0,,Көптен бері көрмегелі, Джон Уотсон
Dialogue: 0,1:33:25.97,1:33:29.43,Default,,0,0,0,,Мен сіздің талантыңыз бен құмарлығыңызға тәнтімін.
Dialogue: 0,1:33:29.89,1:33:31.56,Default,,0,0,0,,Карамазовты қуып жету —
Dialogue: 0,1:33:31.64,1:33:32.56,Default,,0,0,0,,Жазбаны табыңыз—
Dialogue: 0,1:33:32.56,1:33:33.81,Default,,0,0,0,,Жазбаны табыңыз—
Dialogue: 0,1:33:32.56,1:33:33.81,Default,,0,0,0,,Ах
Dialogue: 0,1:33:33.94,1:33:37.23,Default,,0,0,0,,Ақырында, біз осы нүктеге жеттік.
Dialogue: 0,1:33:38.15,1:33:38.98,Default,,0,0,0,,Бірақ—
Dialogue: 0,1:33:39.78,1:33:42.32,Default,,0,0,0,,Сіздің миссияңыз аяқталды.
Dialogue: 0,1:33:43.32,1:33:46.28,Default,,0,0,0,,Сіздің схемаларыңыз осы жерде аяқталады.
Dialogue: 0,1:33:47.07,1:33:48.62,Default,,0,0,0,,Бұл – тұзақ екенінің дәлелі.
Dialogue: 0,1:33:53.71,1:33:56.50,Default,,0,0,0,,M Сіз қателесесіз!
Dialogue: 0,1:33:57.67,1:33:58.84,Default,,0,0,0,,Дұрыс емес пе?
Dialogue: 0,1:33:59.46,1:34:01.05,Default,,0,0,0,,Не дұрыс емес -
Dialogue: 0,1:34:01.17,1:34:03.80,Default,,0,0,0,,Төбелескен ақымақсың.
Dialogue: 0,1:34:04.34,1:34:06.97,Default,,0,0,0,,Адамдардың өз еркімен жасаған заттарды не істейміз?
Dialogue: 0,1:34:07.80,1:34:11.39,Default,,0,0,0,,Тіпті барлық сұлулық пен әсемдік жоғалып кетсе де—
Dialogue: 0,1:34:11.64,1:34:14.10,Default,,0,0,0,,Оны түсіну қабілеті де жойылады.
Dialogue: 0,1:34:14.23,1:34:16.35,Default,,0,0,0,,Мәселе неде?
Dialogue: 0,1:34:18.77,1:34:22.78,Default,,0,0,0,,Бұдан былай адамзат өзінің адамгершілікке жатпайтын әрекеттерін тоқтата алмайды.
Dialogue: 0,1:34:22.90,1:34:25.86,Default,,0,0,0,,Мен оны қай жолмен жоя аламын?
Dialogue: 0,1:34:26.78,1:34:30.66,Default,,0,0,0,,Біз мұны осы жерде және қазір Джон Уотсонмен аяқтауымыз керек
Dialogue: 0,1:34:31.08,1:34:33.16,Default,,0,0,0,,Сізде дүниеде бәрі бар —
Dialogue: 0,1:34:33.29,1:34:35.54,Default,,0,0,0,,Мен түсіндім деп ойлаймын!
Dialogue: 0,1:34:40.54,1:34:43.67,Default,,0,0,0,,Болашақты жасайтын сұлулық немесе асқақтық емес.
Dialogue: 0,1:34:44.34,1:34:45.84,Default,,0,0,0,,Біреуге арналған ойлар мен сөздер—
Dialogue: 0,1:34:46.88,1:34:49.10,Default,,0,0,0,,Оны жүзеге асыруға тырысу -
Dialogue: 0,1:34:49.18,1:34:50.55,Default,,0,0,0,,Пауэр of will!
Dialogue: 0,1:34:50.68,1:34:52.43,Default,,0,0,0,,Иә! (M) Wow
Dialogue: 0,1:34:57.19,1:35:00.36,Default,,0,0,0,,Бір тоқтады, енді мен кете аламын!
Dialogue: 0,1:35:03.03,1:35:04.78,Default,,0,0,0,,Жұма Торды конфигурациялаңыз
Dialogue: 0,1:35:06.99,1:35:10.53,Default,,0,0,0,,Толық ашық шығыс, дыбыс толқындарын басыңыз!
Dialogue: 0,1:35:13.95,1:35:16.12,Default,,0,0,0,,Хадари Лилит
Dialogue: 0,1:35:16.25,1:35:20.13,Default,,0,0,0,,Мен сіздің не іздеп жатқаныңызды білемін.
Dialogue: 0,1:35:21.13,1:35:22.17,Default,,0,0,0,,Қарсылық көрсетпеу
Dialogue: 0,1:35:24.63,1:35:27.09,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:35:29.43,1:35:32.68,Default,,0,0,0,,(Фушигиро) Тек теңсіз шындық қана—
Dialogue: 0,1:35:33.56,1:35:35.35,Default,,0,0,0,,Абайлаңыз, ол сіздің артыңызда.
Dialogue: 0,1:35:35.77,1:35:36.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:39.65,1:35:41.65,Default,,0,0,0,,Менің жолыма кедергі болма!
Dialogue: 0,1:35:41.77,1:35:42.82,Default,,0,0,0,,Тоқта! (Хадары) А.
Dialogue: 0,1:35:42.82,1:35:43.65,Default,,0,0,0,,Тоқта! (Хадары) А.
Dialogue: 0,1:35:42.82,1:35:43.65,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:35:43.77,1:35:45.07,Default,,0,0,0,,Уау
Dialogue: 0,1:35:46.15,1:35:46.99,Default,,0,0,0,,Хадары!
Dialogue: 0,1:35:54.16,1:35:57.12,Default,,0,0,0,,(Таяқ пен аяқ дыбысы)
Dialogue: 0,1:35:59.50,1:36:03.38,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Қалғанын өз қолыма аламын.
Dialogue: 0,1:36:04.09,1:36:06.34,Default,,0,0,0,,Бір!
Dialogue: 0,1:36:16.68,1:36:19.06,Default,,0,0,0,,Жұма Офлайн режимге өтіңіз!
Dialogue: 0,1:36:19.14,1:36:21.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:23.11,1:36:26.15,Default,,0,0,0,,Мен сенің еркіңе сендім
Dialogue: 0,1:36:27.61,1:36:30.24,Default,,0,0,0,,Джон Уотсон
Dialogue: 0,1:36:30.36,1:36:31.53,Default,,0,0,0,,Ах
Dialogue: 0,1:36:32.70,1:36:34.28,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,1:36:39.37,1:36:44.63,Default,,0,0,0,,Дәптер іздедің, жан іздедің.
Dialogue: 0,1:36:44.63,1:36:44.79,Default,,0,0,0,,Дәптер іздедің, жан іздедің.
Dialogue: 0,1:36:44.63,1:36:44.79,Default,,0,0,0,,Уф
Dialogue: 0,1:36:44.79,1:36:45.71,Default,,0,0,0,,Уф
Dialogue: 0,1:36:46.30,1:36:48.63,Default,,0,0,0,,Ал тағдыр бұрылады -
Dialogue: 0,1:36:48.76,1:36:51.26,Default,,0,0,0,,Мұнда келді
Dialogue: 0,1:36:54.97,1:36:59.81,Default,,0,0,0,,Екі жан сауыты бар
Dialogue: 0,1:36:59.98,1:37:03.69,Default,,0,0,0,,Өзіңізді алдамаңыз! Бәрі сен ойлағандай болды!?
Dialogue: 0,1:37:06.23,1:37:07.32,Default,,0,0,0,,Ах
Dialogue: 0,1:37:08.40,1:37:09.86,Default,,0,0,0,,Уақыт келді
Dialogue: 0,1:37:10.28,1:37:11.28,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:37:19.58,1:37:24.92,Default,,0,0,0,,Жан қайда және қалай дүниеге келген?
Dialogue: 0,1:37:26.04,1:37:27.42,Default,,0,0,0,,Ай! (Кугисаки) Бұл не өзі?
Dialogue: 0,1:37:28.09,1:37:29.42,Default,,0,0,0,,Әй
Dialogue: 0,1:37:30.46,1:37:34.80,Default,,0,0,0,,Виктор мөрлеген тыйым салынған техниканың мәні...
Dialogue: 0,1:37:34.93,1:37:38.81,Default,,0,0,0,,Ол сол жанды жасаудан тұрады.
Dialogue: 0,1:37:49.57,1:37:52.65,Default,,0,0,0,,Маған өмірді көрсетейін...
Dialogue: 0,1:37:52.78,1:37:56.57,Default,,0,0,0,,Жанның дүниеге келген сәті
Dialogue: 0,1:37:56.91,1:38:00.74,Default,,0,0,0,,(құбыр органының өнімділігі)
Dialogue: 0,1:38:10.67,1:38:12.72,Default,,0,0,0,,Виктор Франкенштейн
Dialogue: 0,1:38:13.51,1:38:17.01,Default,,0,0,0,,Сенің санаңның тұңғиығында мөрленген...
Dialogue: 0,1:38:17.14,1:38:19.64,Default,,0,0,0,,Келінімнің жаны
Dialogue: 0,1:38:19.76,1:38:22.10,Default,,0,0,0,,Мен оны қайтарып аламын.
Dialogue: 0,1:38:27.94,1:38:28.86,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:38:37.32,1:38:39.95,Default,,0,0,0,,жұма! Хадари!
Dialogue: 0,1:38:40.08,1:38:41.58,Default,,0,0,0,,Қазір көмектесіңіз...
Dialogue: 0,1:38:43.04,1:38:45.66,Default,,0,0,0,,Өлгендердің сөздерін түсініңіз—
Dialogue: 0,1:38:46.37,1:38:51.05,Default,,0,0,0,,Дүние жүзіндегі мәйіттермен байланысты үлкен аналитикалық мекеме —
Dialogue: 0,1:38:52.13,1:38:54.67,Default,,0,0,0,,Енді сол сананың өзі
Dialogue: 0,1:38:57.34,1:39:01.06,Default,,0,0,0,,Енді перфокарталарға сөздерді жазбаңыз—
Dialogue: 0,1:39:01.18,1:39:02.31,Default,,0,0,0,,Кабельге қосылған
Dialogue: 0,1:39:02.31,1:39:03.14,Default,,0,0,0,,Кабельге қосылған
Dialogue: 0,1:39:02.31,1:39:03.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:03.47,1:39:06.89,Default,,0,0,0,,Орнатудың қажеті жоқ
Dialogue: 0,1:39:08.90,1:39:11.61,Default,,0,0,0,,Біздің көріп тұрғанымыз –
Dialogue: 0,1:39:11.73,1:39:15.11,Default,,0,0,0,,Өйткені ол заттанған сөздің өзі.
Dialogue: 0,1:39:15.36,1:39:17.82,Default,,0,0,0,,Ук ку ку куу
Dialogue: 0,1:39:20.53,1:39:23.08,Default,,0,0,0,,Сөз сананы тудырады—
Dialogue: 0,1:39:23.79,1:39:27.71,Default,,0,0,0,,Сана мәйіттен аналитикалық қозғалтқыш арқылы беріледі—
Dialogue: 0,1:39:28.54,1:39:31.96,Default,,0,0,0,,Келіннің санасын өру
Dialogue: 0,1:39:33.59,1:39:37.51,Default,,0,0,0,,Барлық ниеттер бір ерікке айналады -
Dialogue: 0,1:39:37.93,1:39:42.05,Default,,0,0,0,,Бір ерік барлық еріктерге айналады -
Dialogue: 0,1:39:42.43,1:39:45.47,Default,,0,0,0,,Бүкіл адамзат бір-
Dialogue: 0,1:39:46.02,1:39:48.89,Default,,0,0,0,,Бір ғана жанға айналу
Dialogue: 0,1:39:49.81,1:39:51.81,Default,,0,0,0,,Хадари Лилит
Dialogue: 0,1:39:53.11,1:39:55.03,Default,,0,0,0,,Сізге арналған жан
Dialogue: 0,1:39:55.11,1:39:58.70,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:40:01.24,1:40:04.58,Default,,0,0,0,,Қалыңдықтың жанын құрайтын элементтер:
Dialogue: 0,1:40:04.79,1:40:06.33,Default,,0,0,0,,Босатылған
Dialogue: 0,1:40:07.62,1:40:08.46,Default,,0,0,0,,Уф
Dialogue: 0,1:40:09.16,1:40:13.25,Default,,0,0,0,,Менің жоғалған қалыңдығымның сауыты бол -
Dialogue: 0,1:40:13.38,1:40:14.92,Default,,0,0,0,,Жан ал!
Dialogue: 0,1:40:24.10,1:40:26.01,Default,,0,0,0,,Мен оны сезінемін
Dialogue: 0,1:40:26.14,1:40:28.31,Default,,0,0,0,,Сіздің қатысуыңыз
Dialogue: 0,1:40:29.06,1:40:31.94,Default,,0,0,0,,Жан жылуы
Dialogue: 0,1:40:33.36,1:40:37.03,Default,,0,0,0,,Ол сонда.
Dialogue: 0,1:40:37.36,1:40:38.69,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:40:38.82,1:40:40.70,Default,,0,0,0,,Хадари қалаған нәрсе —
Dialogue: 0,1:40:40.82,1:40:42.70,Default,,0,0,0,,Менің қуанышым мен қайғым
Dialogue: 0,1:40:43.24,1:40:45.41,Default,,0,0,0,,Оны сезетін жан.
Dialogue: 0,1:40:46.79,1:40:49.41,Default,,0,0,0,,Бұл сенің қалыңдығыңның жаны емес!
Dialogue: 0,1:40:50.96,1:40:52.29,Default,,0,0,0,,Өкінішті
Dialogue: 0,1:40:53.92,1:40:58.17,Default,,0,0,0,,Түсінесіз деп ойладым.
Dialogue: 0,1:40:58.80,1:41:04.09,Default,,0,0,0,,Жанымды басқалардан артық аңсаған сен болсаң,
Dialogue: 0,1:41:06.51,1:41:08.60,Default,,0,0,0,,Алайда —
Dialogue: 0,1:41:09.48,1:41:12.44,Default,,0,0,0,,Бұл дене жақсы ұсталған.
Dialogue: 0,1:41:12.85,1:41:14.31,Default,,0,0,0,,Ах
Dialogue: 0,1:41:17.07,1:41:19.86,Default,,0,0,0,,Менің ыдысыма өте ыңғайлы.
Dialogue: 0,1:41:27.41,1:41:31.37,Default,,0,0,0,,Кел, оян.
Dialogue: 0,1:41:32.46,1:41:34.25,Default,,0,0,0,,Менің қалыңдығым
Dialogue: 0,1:41:55.44,1:41:57.65,Default,,0,0,0,,Ах, уау, уф!
Dialogue: 0,1:41:58.07,1:42:01.86,Default,,0,0,0,,(Барнаби ыңырсып)
Dialogue: 0,1:42:15.62,1:42:19.55,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,1:42:20.34,1:42:22.97,Default,,0,0,0,,Менің кім екенімді білесің бе?
Dialogue: 0,1:42:25.09,1:42:28.85,Default,,0,0,0,,Маған қайта күліңіз
Dialogue: 0,1:42:32.06,1:42:33.06,Default,,0,0,0,,Иә
Dialogue: 0,1:42:33.60,1:42:35.35,Default,,0,0,0,,Уф...
Dialogue: 0,1:42:35.56,1:42:36.85,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,1:42:48.16,1:42:49.70,Default,,0,0,0,,Уотсон!
Dialogue: 0,1:42:50.95,1:42:53.37,Default,,0,0,0,,Қалғанын сұрадым!
Dialogue: 0,1:42:57.58,1:42:58.75,Default,,0,0,0,,Ха, аа
Dialogue: 0,1:43:00.13,1:43:01.67,Default,,0,0,0,,Ах!
Dialogue: 0,1:43:10.80,1:43:13.89,Default,,0,0,0,,Пайдасыз... заттар...
Dialogue: 0,1:43:24.78,1:43:27.95,Default,,0,0,0,,Жұма Логикалық лабиринтті іске қосыңыз
Dialogue: 0,1:43:28.03,1:43:31.70,Default,,0,0,0,,Дәптеріңе Жалғыздың жаны мен мәйіттің сөзін құлыптап ал!
Dialogue: 0,1:43:39.71,1:43:40.67,Default,,0,0,0,,Бұл...
Dialogue: 0,1:43:44.00,1:43:46.30,Default,,0,0,0,,Бұл біздің еркіміз!
Dialogue: 0,1:43:46.72,1:43:50.14,Default,,0,0,0,,А... мүмкін емес...
Dialogue: 0,1:44:08.07,1:44:09.61,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:44:14.62,1:44:19.46,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:44:22.50,1:44:25.09,Default,,0,0,0,,Уф...
Dialogue: 0,1:44:33.05,1:44:34.39,Default,,0,0,0,,Ах...
Dialogue: 0,1:44:36.01,1:44:36.85,Default,,0,0,0,,Уф
Dialogue: 0,1:44:39.10,1:44:42.35,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:44:47.61,1:44:51.61,Default,,0,0,0,,Гуаааа!
Dialogue: 0,1:45:03.63,1:45:05.34,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:11.84,1:45:13.30,Default,,0,0,0,,Фу…
Dialogue: 0,1:45:21.69,1:45:24.15,Default,,0,0,0,,Уф...
Dialogue: 0,1:45:25.23,1:45:26.31,Default,,0,0,0,,Га
Dialogue: 0,1:45:31.82,1:45:33.82,Default,,0,0,0,,Доктор Уотсон
Dialogue: 0,1:45:35.49,1:45:37.08,Default,,0,0,0,,Ханд Хадари
Dialogue: 0,1:45:37.78,1:45:39.41,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,1:47:24.52,1:47:28.90,Default,,0,0,0,,Келінінің сөзі ойыма келді.
Dialogue: 0,1:47:29.77,1:47:33.90,Default,,0,0,0,,Қайғы, ашу және қуаныш
Dialogue: 0,1:47:35.32,1:47:40.12,Default,,0,0,0,,Қайта алмаймын деп қорқып кеттім.
Dialogue: 0,1:47:42.66,1:47:44.83,Default,,0,0,0,,Оның жаны жоқ болуы керек
Dialogue: 0,1:47:47.33,1:47:49.17,Default,,0,0,0,,Сенің жаның бар
Dialogue: 0,1:47:49.62,1:47:50.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:47:51.96,1:47:55.96,Default,,0,0,0,,Менің тіпті көз жасым да жоқ.
Dialogue: 0,1:47:56.34,1:47:57.17,Default,,0,0,0,,Хадары
Dialogue: 0,1:47:58.13,1:48:00.18,Default,,0,0,0,,Маған сенің осы жағың ұнады.
Dialogue: 0,1:48:00.51,1:48:01.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:48:06.06,1:48:07.31,Default,,0,0,0,,Ах
Dialogue: 0,1:48:10.06,1:48:11.31,Default,,0,0,0,,Иә
Dialogue: 0,1:48:17.28,1:48:21.57,Default,,0,0,0,,Менің жаным болса, оның да жаны бар.
Dialogue: 0,1:48:24.99,1:48:26.49,Default,,0,0,0,,Берілме
Dialogue: 0,1:48:27.04,1:48:28.12,Default,,0,0,0,,Иә
Dialogue: 0,1:48:29.75,1:48:32.79,Default,,0,0,0,,Рахмет сізге Хадари
Dialogue: 0,1:48:34.46,1:48:35.30,Default,,0,0,0,,Ах
Dialogue: 0,1:48:35.42,1:48:37.88,Default,,0,0,0,,бітті хаха
Dialogue: 0,1:48:38.76,1:48:40.51,Default,,0,0,0,,Әйтеуір, қайтып келдім.
Dialogue: 0,1:48:40.63,1:48:43.85,Default,,0,0,0,,А... не істейсің?
Dialogue: 0,1:48:44.60,1:48:46.77,Default,,0,0,0,,Мен саяхатқа шығамын
Dialogue: 0,1:48:47.06,1:48:49.81,Default,,0,0,0,,Сондықтан мен сізге шындықты айтпаймын.
Dialogue: 0,1:48:50.69,1:48:53.27,Default,,0,0,0,,Мен үшін қажет емес нәрселерді білмегенім жақсы.
Dialogue: 0,1:48:53.56,1:48:55.32,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,1:48:55.73,1:48:59.53,Default,,0,0,0,,Бұл бәрібір басыңа сыйып кететін әңгіме емес.
Dialogue: 0,1:48:59.65,1:49:01.86,Default,,0,0,0,,Әй, мен құрметтімін.
Dialogue: 0,1:49:01.99,1:49:03.28,Default,,0,0,0,,Иә
Dialogue: 0,1:49:08.58,1:49:09.91,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,1:49:47.08,1:49:51.29,Default,,0,0,0,,Ең алдымен бізге қажет—
Dialogue: 0,1:49:52.71,1:49:54.00,Default,,0,0,0,,Мәйіт.
Dialogue: 0,1:49:59.13,1:50:01.38,Default,,0,0,0,,Адам қайтыс болғанда —
Dialogue: 0,1:50:01.59,1:50:03.43,Default,,0,0,0,,Оның тірі кезімен салыстырғанда—
Dialogue: 0,1:50:03.55,1:50:08.01,Default,,0,0,0,,Дене салмағы шамамен 21 грамға төмендейтіні расталды.
Dialogue: 0,1:50:10.06,1:50:11.52,Default,,0,0,0,,Бұл рухани элементтердің салмағы
Dialogue: 0,1:50:12.77,1:50:14.52,Default,,0,0,0,,Жанның салмағы деп аталады.
Dialogue: 0,1:50:18.77,1:50:21.78,Default,,0,0,0,,Сен маған айтқаннан бері...
Dialogue: 0,1:50:22.32,1:50:24.28,Default,,0,0,0,,Бұл саяхат басталды.
Dialogue: 0,1:50:31.16,1:50:35.42,Default,,0,0,0,,Сіздің сөздеріңіз есімде
Dialogue: 0,1:50:38.04,1:50:40.80,Default,,0,0,0,,Маған жазған сөздеріңіз ұнады.
Dialogue: 0,1:50:43.76,1:50:47.76,Default,,0,0,0,,Сенің сөздерің менің ішімде жиналды...
Dialogue: 0,1:50:50.01,1:50:50.43,Default,,0,0,0,,Осы жолда маған бағыт-бағдар беріп, қолдау көрсеттің.
Dialogue: 0,1:50:50.43,1:50:55.06,Default,,0,0,0,,Осы жолда маған бағыт-бағдар беріп, қолдау көрсеттің.
Dialogue: 0,1:50:50.43,1:50:55.06,Default,,0,0,0,,(музыкалық қораптың үні)
Dialogue: 0,1:51:01.90,1:51:03.57,Default,,0,0,0,,Саяхат кезінде—
Dialogue: 0,1:51:04.69,1:51:06.82,Default,,0,0,0,,Мен айтқан сөздер:
Dialogue: 0,1:51:08.70,1:51:14.08,Default,,0,0,0,,Бұл сізге бірдеңе әкеледі ме?
Dialogue: 0,1:51:17.29,1:51:18.58,Default,,0,0,0,,жұма
Dialogue: 0,1:51:19.42,1:51:20.75,Default,,0,0,0,,Маған —
Dialogue: 0,1:51:24.13,1:51:26.47,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,1:51:31.76,1:51:33.56,Default,,0,0,0,,Даусыңыз...
Dialogue: 0,1:51:34.93,1:51:36.64,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,1:51:41.11,1:51:42.61,Default,,0,0,0,,Егер ол орындалса...
Dialogue: 0,1:51:46.49,1:51:48.11,Default,,0,0,0,,жұма
Dialogue: 0,1:51:50.57,1:51:52.12,Default,,0,0,0,,Басын кесіп тастағаныма қарамастан…
Dialogue: 0,1:51:56.00,1:51:57.29,Default,,0,0,0,,Сізге...
Dialogue: 0,1:52:05.42,1:52:10.43,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:56:30.19,1:56:35.19,Default,,0,0,0,,~♪
Dialogue: 0,1:56:37.03,1:56:42.03,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:57:05.81,1:57:07.56,Default,,0,0,0,,«Доктор Уотсон»
Dialogue: 0,1:57:08.22,1:57:10.73,Default,,0,0,0,,Менің қаламым осылай жазады
Dialogue: 0,1:57:11.73,1:57:15.69,Default,,0,0,0,,Ол бұл жазықта көрінбейді.
Dialogue: 0,1:57:17.19,1:57:21.61,Default,,0,0,0,,Ол жазбаны басына мөрлеп қойды —
Dialogue: 0,1:57:21.99,1:57:24.87,Default,,0,0,0,,Сөздердің басқа көкжиегіне кетті
Dialogue: 0,1:57:26.28,1:57:30.46,Default,,0,0,0,,Сол саяхат күндерін еске түсіру.
Dialogue: 0,1:57:32.08,1:57:35.46,Default,,0,0,0,,сұраймын
Dialogue: 0,1:57:36.00,1:57:38.63,Default,,0,0,0,,Менде сана бар ма?
Dialogue: 0,1:57:39.67,1:57:43.01,Default,,0,0,0,,Мен жауап беремін
Dialogue: 0,1:57:43.63,1:57:47.01,Default,,0,0,0,,Бұл сана қашан пайда болды?
Dialogue: 0,1:57:47.31,1:57:49.72,Default,,0,0,0,,Осыдан туындайтын нәрсе ме?
Dialogue: 0,1:57:50.89,1:57:54.90,Default,,0,0,0,,Мен әлі көп нәрсені түсінбеймін.
Dialogue: 0,1:57:57.32,1:57:59.03,Default,,0,0,0,,Доктор Уотсон
Dialogue: 0,1:57:59.69,1:58:01.57,Default,,0,0,0,,Мен әлі білмеймін...
Dialogue: 0,1:58:01.69,1:58:03.11,Default,,0,0,0,,Саған айтар сөзім бар...
Dialogue: 0,1:58:03.24,1:58:04.70,Default,,0,0,0,,Көп
Dialogue: 0,1:58:05.45,1:58:10.16,Default,,0,0,0,,Мен мұнда материалданған ақпарат ретінде отырмын.
Dialogue: 0,1:58:11.54,1:58:16.04,Default,,0,0,0,,Енді... менің қазір бар болу себебім...
Dialogue: 0,1:58:16.54,1:58:18.17,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,1:58:20.09,1:58:21.80,Default,,0,0,0,,Егер ол орындалса —
Dialogue: 0,1:58:22.13,1:58:24.34,Default,,0,0,0,,Кем дегенде бір сөз айтыңыз—
Dialogue: 0,1:58:24.55,1:58:26.64,Default,,0,0,0,,Мені тыңдауларыңызды қалаймын
Dialogue: 0,1:58:28.05,1:58:30.52,Default,,0,0,0,,Бұл сөз материалды...
Dialogue: 0,1:58:31.10,1:58:33.56,Default,,0,0,0,,Сіз қалдырған оқиғаға
Dialogue: 0,1:58:33.77,1:58:36.65,Default,,0,0,0,,Жаңа өмір әкелсін
Dialogue: 0,1:58:38.56,1:58:39.94,Default,,0,0,0,,Рахмет
Dialogue: 0,1:58:40.78,1:58:45.78,Default,,0,0,0,,~♪
Dialogue: 0,1:58:55.46,1:58:56.67,Default,,0,0,0,,Уф
Dialogue: 0,1:58:56.79,1:59:00.38,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:59:04.88,1:59:06.84,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,1:59:07.09,1:59:09.01,Default,,0,0,0,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,1:59:10.14,1:59:11.06,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,1:59:11.68,1:59:13.06,Default,,0,0,0,,Уотсон мырза
Dialogue: 0,1:59:13.18,1:59:14.73,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Холмс.
Dialogue: 0,1:59:14.85,1:59:15.89,Default,,0,0,0,,Йо (қамшылау дыбысы)
Dialogue: 0,1:59:28.41,1:59:31.08,Default,,0,0,0,,Оның жағдайы қалай? Хадари
Dialogue: 0,1:59:31.20,1:59:32.58,Default,,0,0,0,,Ой
Dialogue: 0,1:59:32.70,1:59:35.37,Default,,0,0,0,,Бұл қазір Ирен Адлер болды ма?
Dialogue: 0,1:59:35.50,1:59:36.87,Default,,0,0,0,,Иә
Dialogue: 0,1:59:37.87,1:59:39.04,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,1:59:40.00,1:59:42.21,Default,,0,0,0,,Егер ол жаңа серіктес болса...
Dialogue: 0,1:59:42.34,1:59:44.63,Default,,0,0,0,,Лондонды айналып жүгіру
Dialogue: 0,1:59:54.02,1:59:55.43,Default,,0,0,0,,Иә
Dialogue: 0,1:59:56.93,2:00:02.93,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory