Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.29,0:00:08.29,Default,,0,0,0,,Біз періштелер...
Dialogue: 0,0:00:09.42,0:00:14.18,Default,,0,0,0,,Жоқ, қанатын алып жерге түскен бұрынғы періште
Dialogue: 0,0:00:14.26,0:00:18.26,Default,,0,0,0,,Бұдан былай көктегі нағыз періште арқылы
Dialogue: 0,0:00:18.35,0:00:21.35,Default,,0,0,0,,Олар бірінен соң бірі өлтіріледі.
Dialogue: 0,0:00:23.31,0:00:24.52,Default,,0,0,0,,Бұл күлкілі!
Dialogue: 0,0:00:24.60,0:00:29.44,Default,,0,0,0,,Егер жазалаушы періште болса, оның бізді өлтіруі болмашы еді.
Dialogue: 0,0:00:29.52,0:00:31.19,Default,,0,0,0,,Тек кернейді үрлеңіз
Dialogue: 0,0:00:31.28,0:00:34.65,Default,,0,0,0,,Физикалық жолмен өлтіруге ешқандай себеп жоқ.
Dialogue: 0,0:00:34.74,0:00:36.99,Default,,0,0,0,,Бұл періштелерді тазарту ретінде жасырылды
Dialogue: 0,0:00:37.07,0:00:40.66,Default,,0,0,0,,Бұл осы адамдардың бірі жасаған сериялық кісі өлтіру ісі.
Dialogue: 0,0:00:41.49,0:00:43.00,Default,,0,0,0,,«Періште орындаушы⸺»
Dialogue: 0,0:00:43.08,0:00:45.83,Default,,0,0,0,,«Бұл сөздің шын мағынасында сені өлтіреді».
Dialogue: 0,0:00:46.92,0:00:48.04,Default,,0,0,0,,«V»
Dialogue: 0,0:00:48.13,0:00:50.30,Default,,0,0,0,,Бұл жай ғана күлкілі емес пе?
Dialogue: 0,0:00:51.50,0:00:54.72,Default,,0,0,0,,Бізде достарымызды өлтіруге ешқандай себеп жоқ.
Dialogue: 0,0:00:54.80,0:00:58.80,Default,,0,0,0,,Одақтастарыңды өлтірудің мәні неде?
Dialogue: 0,0:00:59.39,0:01:00.85,Default,,0,0,0,,Көшбасшылар не ойлайды?
Dialogue: 0,0:01:00.93,0:01:03.60,Default,,0,0,0,,Көшбасшы (актер) жетекші
Dialogue: 0,0:01:04.23,0:01:05.60,Default,,0,0,0,,Көшбасшы
Dialogue: 0,0:01:07.23,0:01:08.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:09.61,0:01:14.19,Default,,0,0,0,,Адамды аңсап, жерге түскен біздер
Dialogue: 0,0:01:14.28,0:01:15.78,Default,,0,0,0,,Бұл жаза ма?
Dialogue: 0,0:01:16.61,0:01:20.62,Default,,0,0,0,,Бізді тазарту үшін көктен жіберілген періште бар.
Dialogue: 0,0:01:20.70,0:01:23.24,Default,,0,0,0,,Сол жердегі періште
Dialogue: 0,0:01:23.33,0:01:25.54,Default,,0,0,0,,«ерекше қабілеті бар адам» деп аталады
Dialogue: 0,0:01:26.25,0:01:27.54,Default,,0,0,0,,Ерекше қабілеті бар адам?
Dialogue: 0,0:01:27.62,0:01:31.34,Default,,0,0,0,,Хмм... Әй, табиғаттан тыс жаратылыс деген не?
Dialogue: 0,0:01:31.42,0:01:33.34,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:01:37.43,0:01:38.72,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:01:40.09,0:01:41.18,Default,,0,0,0,,Эй, мен сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:01:42.06,0:01:43.39,Default,,0,0,0,,Мұндағы барлық тұтынушылар
Dialogue: 0,0:01:43.47,0:01:46.06,Default,,0,0,0,,Сіз бұл спектакльді көру үшін ақша төлейсіз, солай ма?
Dialogue: 0,0:01:46.14,0:01:50.15,Default,,0,0,0,,Сізге соққы сызығы соншалықты айқын болған оқиғаны көрсеткенде неге ашуланбайсыз?
Dialogue: 0,0:01:50.23,0:01:51.11,Default,,0,0,0,,Эй
Dialogue: 0,0:01:52.77,0:01:54.40,Default,,0,0,0,,Сол адам кінәлі!
Dialogue: 0,0:01:54.48,0:01:57.36,Default,,0,0,0,,Алғашқы 5 минутта түсінесіз... О, жоқ!
Dialogue: 0,0:01:57.45,0:01:59.41,Default,,0,0,0,,Қазіргі жағдайда оның барар жері жоқ.
Dialogue: 0,0:02:00.12,0:02:01.57,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:02:01.66,0:02:05.87,Default,,0,0,0,,Неліктен бәрі үнсіз қойылымды осылай қарайды?
Dialogue: 0,0:02:05.95,0:02:07.41,Default,,0,0,0,,Өте көңілсіз
Dialogue: 0,0:02:08.37,0:02:10.29,Default,,0,0,0,,Ең болмағанда—
Dialogue: 0,0:02:11.25,0:02:13.34,Default,,0,0,0,,Бәріне де
Dialogue: 0,0:02:13.42,0:02:16.80,Default,,0,0,0,,Мен ғана түсінбейтін нәрсе бар
Dialogue: 0,0:02:16.88,0:02:18.97,Default,,0,0,0,,Білмеймін... Мен қорқамын
Dialogue: 0,0:02:19.93,0:02:22.89,Default,,0,0,0,,Дүниедегі адамдардың бәрі құбыжық сияқты
Dialogue: 0,0:02:22.97,0:02:25.43,Default,,0,0,0,,Бұл мен ғана түсінбейтін құбыжық.
Dialogue: 0,0:02:27.98,0:02:32.11,Default,,0,0,0,,Мен жалғызбын, құбыжықтар әлемінде өмір сүремін
Dialogue: 0,0:02:34.23,0:02:37.74,Default,,0,0,0,,Енді 15 минуттық үзіліс жасаймыз.
Dialogue: 0,0:02:37.82,0:02:41.61,Default,,0,0,0,,Спектакльдің екінші жартысы 18:20-да басталады.
Dialogue: 0,0:02:43.16,0:02:44.16,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:02:44.24,0:02:45.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:46.24,0:02:49.87,Default,,0,0,0,,Мен сені қанағаттандыратын жауап беремін.
Dialogue: 0,0:02:51.33,0:02:53.17,Default,,0,0,0,,Сіздің ата-анаңыз
Dialogue: 0,0:02:53.25,0:02:55.96,Default,,0,0,0,,Сіз өзіңіздің талантыңыз туралы бірдеңе айттыңыз ба?
Dialogue: 0,0:02:56.05,0:02:57.96,Default,,0,0,0,,Дарындылық?
Dialogue: 0,0:02:58.05,0:03:01.13,Default,,0,0,0,,Ондай нәрсе болса, мен жұмыста көп қиналмас едім.
Dialogue: 0,0:03:01.22,0:03:05.14,Default,,0,0,0,,Жоқ, сізде ерекше талант бар.
Dialogue: 0,0:03:05.22,0:03:06.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:06.14,0:03:08.31,Default,,0,0,0,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:03:08.39,0:03:11.39,Default,,0,0,0,,Бұл белде бір кездері қылыш болған.
Dialogue: 0,0:03:11.48,0:03:13.35,Default,,0,0,0,,Тіпті мемлекеттік қызметкер
Dialogue: 0,0:03:13.44,0:03:16.02,Default,,0,0,0,,«Бес қылыш» атты қылышшы болған.
Dialogue: 0,0:03:18.03,0:03:21.11,Default,,0,0,0,,Менің қылышым – ұлттық қауіпсіздік үшін.
Dialogue: 0,0:03:21.20,0:03:23.28,Default,,0,0,0,,Мен шындап солай ойладым.
Dialogue: 0,0:03:23.36,0:03:25.12,Default,,0,0,0,,Сондықтан мен біреуді өлтірдім
Dialogue: 0,0:03:25.87,0:03:28.20,Default,,0,0,0,,Қастандық жасау өте оңай болды
Dialogue: 0,0:03:28.29,0:03:31.37,Default,,0,0,0,,Мені қорқытқан келесі тапсырма біреуді өлтіру болды.
Dialogue: 0,0:03:31.46,0:03:34.25,Default,,0,0,0,,Сол кезде мен оны асыға күтетінмін
Dialogue: 0,0:03:34.96,0:03:38.55,Default,,0,0,0,,Ел үшін өлтіресің бе, әлде бір сәтке өлтіресің бе?
Dialogue: 0,0:03:38.63,0:03:41.30,Default,,0,0,0,,Мен енді ішкі ойларымды көре алмаймын.
Dialogue: 0,0:03:42.93,0:03:47.01,Default,,0,0,0,,Сол сәттен бастап мен енді ешқашан қылыш ұстамаймын деп шештім.
Dialogue: 0,0:03:47.10,0:03:50.18,Default,,0,0,0,,Мен бір рет қандай жұмыс жасадым?
Dialogue: 0,0:03:50.27,0:03:53.06,Default,,0,0,0,,Оны ешкім түсінген жоқ
Dialogue: 0,0:03:53.14,0:03:56.73,Default,,0,0,0,,Сіз пьесадағы қылмыскерді ертерек таптың.
Dialogue: 0,0:03:56.81,0:04:01.74,Default,,0,0,0,,Сол кезде қылмыскерді болжай алатын жалғыз сіз болған шығарсыз.
Dialogue: 0,0:04:01.82,0:04:04.28,Default,,0,0,0,,Сценарийді оқымағанымда мен де түсінбес едім.
Dialogue: 0,0:04:04.36,0:04:05.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:05.78,0:04:09.29,Default,,0,0,0,,Айналаңыздағы адамдарды ақымақ деп ойладыңыз ба?
Dialogue: 0,0:04:09.95,0:04:13.58,Default,,0,0,0,,Негізі ол ештеңе түсінбейтін ақымақ деп ойлаймын.
Dialogue: 0,0:04:16.83,0:04:18.00,Default,,0,0,0,,Харизма!
Dialogue: 0,0:04:18.09,0:04:20.59,Default,,0,0,0,,Тыңда, жақсылап есте сақта.
Dialogue: 0,0:04:20.67,0:04:24.93,Default,,0,0,0,,Сен ерекшесің, ал басқа адамдар ақымақ.
Dialogue: 0,0:04:25.01,0:04:26.93,Default,,0,0,0,,Жибрилді Мәстер ретінде толық бағындырғаның…
Dialogue: 0,0:04:27.01,0:04:31.68,Default,,0,0,0,,Сіз жалғызсыз, өйткені сізде ерекше талант бар.
Dialogue: 0,0:04:31.77,0:04:33.31,Default,,0,0,0,,Арнайы?
Dialogue: 0,0:04:34.02,0:04:37.02,Default,,0,0,0,,Күшті басқару керек
Dialogue: 0,0:04:37.11,0:04:40.78,Default,,0,0,0,,Талантыңнан көз жұмсаң
Dialogue: 0,0:04:40.86,0:04:45.99,Default,,0,0,0,,Қан төгуді көздеп билікті қолына ұстатқан мен сияқты.
Dialogue: 0,0:04:46.07,0:04:50.45,Default,,0,0,0,,Мен жалғыз ғана ерекшемін. Бұл қалай болуы мүмкін?
Dialogue: 0,0:04:50.54,0:04:52.70,Default,,0,0,0,,Қалада қаншама адам болса да
Dialogue: 0,0:04:56.46,0:04:57.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:57.54,0:04:58.96,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:04:59.04,0:05:02.88,Default,,0,0,0,,Себебі сізде табиғаттан тыс күштер бар.
Dialogue: 0,0:05:02.96,0:05:03.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:04.05,0:05:07.43,Default,,0,0,0,,Сіздің ерекше болуыңыздың себебі, сізде табиғаттан тыс күштер бар.
Dialogue: 0,0:05:08.30,0:05:09.85,Default,,0,0,0,,Ерекше қабілет?
Dialogue: 0,0:05:09.93,0:05:14.68,Default,,0,0,0,,Ол құдірет – шындықты бір көзбен көру қабілеті.
Dialogue: 0,0:05:15.35,0:05:20.36,Default,,0,0,0,,Бұл әлемде табиғаттан тыс күштерге ие адамдар өте аз.
Dialogue: 0,0:05:21.19,0:05:24.32,Default,,0,0,0,,Басқа адамдар сенің көзіңе құбыжық сияқты көрінеді
Dialogue: 0,0:05:25.03,0:05:26.99,Default,,0,0,0,,Бұл сіздің ерекше қабілетіңіздің арқасында.
Dialogue: 0,0:05:27.61,0:05:31.12,Default,,0,0,0,,Сіз бұл қуатты басқаруыңыз керек.
Dialogue: 0,0:05:31.20,0:05:32.99,Default,,0,0,0,,Енді мен сізге қалай болатынын көрсетемін.
Dialogue: 0,0:05:33.79,0:05:36.16,Default,,0,0,0,,«Бірдеңе» арқылы
Dialogue: 0,0:05:36.25,0:05:39.50,Default,,0,0,0,,Сіз ерекше қабілеттерді еркін белсендіре аласыз.
Dialogue: 0,0:05:39.58,0:05:40.92,Default,,0,0,0,,«Бірдеңе»?
Dialogue: 0,0:05:42.17,0:05:43.63,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:05:43.71,0:05:45.47,Default,,0,0,0,,Көзілдірік?
Dialogue: 0,0:05:45.55,0:05:47.22,Default,,0,0,0,,Бұл Киото астанасында
Dialogue: 0,0:05:47.30,0:05:52.01,Default,,0,0,0,,Бұл асыл текті біреудің маған берген оюы.
Dialogue: 0,0:05:52.10,0:05:55.43,Default,,0,0,0,,Мұны киген кезде, сіздің ерекше қабілетіңіз іске қосылады.
Dialogue: 0,0:05:55.52,0:05:58.69,Default,,0,0,0,,Сіз шындықты бірден көре аласыз
Dialogue: 0,0:05:58.77,0:06:00.90,Default,,0,0,0,,Керісінше, қолданбаған кезде
Dialogue: 0,0:06:00.98,0:06:03.65,Default,,0,0,0,,Сіз енді басқалардың ақымақтығына мән бермейсіз.
Dialogue: 0,0:06:04.23,0:06:06.24,Default,,0,0,0,,Мен мұны саған беремін
Dialogue: 0,0:06:08.45,0:06:11.74,Default,,0,0,0,,Қалай қарасаң да, бұл арзан көзілдірік...
Dialogue: 0,0:06:11.82,0:06:13.03,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:06:13.12,0:06:16.25,Default,,0,0,0,,Бұл жергілікті құрылыс дүкенінде мені мәжбүрлеп алған сатылмаған зат.
Dialogue: 0,0:06:17.21,0:06:18.04,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:18.12,0:06:19.58,Default,,0,0,0,,Ештеңе өзгермейді...
Dialogue: 0,0:06:19.67,0:06:21.29,Default,,0,0,0,,Үзіліс! (Ранпо) Уф!
Dialogue: 0,0:06:21.38,0:06:24.71,Default,,0,0,0,,Tattotto... О!
Dialogue: 0,0:06:24.80,0:06:27.05,Default,,0,0,0,,Сол көзілдірікпен табиғаттан тыс қабілеттеріңізді басқарыңыз.
Dialogue: 0,0:06:30.43,0:06:32.01,Default,,0,0,0,,Әртүрлі қабілеттерді бақылау?
Dialogue: 0,0:06:32.55,0:06:36.31,Default,,0,0,0,,Иә, өзіңіздің ерекше күштеріңізбен шындықты жыртыңыз.
Dialogue: 0,0:06:36.39,0:06:39.98,Default,,0,0,0,,Қараңғыда жасырылған зұлымдықты сүртетін ерекше қабілеті бар детектив
Dialogue: 0,0:06:41.23,0:06:43.94,Default,,0,0,0,,Бүгіннен бастап сіз әлемдегі ең ұлы детективсіз.
Dialogue: 0,0:06:44.02,0:06:45.82,Default,,0,0,0,,Керемет детектив?
Dialogue: 0,0:06:45.90,0:06:48.90,Default,,0,0,0,,Қазір бәрі түсінікті емес пе?
Dialogue: 0,0:06:49.36,0:06:52.07,Default,,0,0,0,,Дүние қорқынышты, бірақ ештеңе жоқ
Dialogue: 0,0:06:52.16,0:06:54.78,Default,,0,0,0,,Басқа адамдар құбыжық емес
Dialogue: 0,0:06:54.87,0:06:58.04,Default,,0,0,0,,Тек сенен де ақымақ әрі ақымақ.
Dialogue: 0,0:06:58.12,0:06:59.12,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:59.21,0:07:02.38,Default,,0,0,0,,Ешкімнің сізге деген жаман ниеті жоқ.
Dialogue: 0,0:07:02.46,0:07:04.29,Default,,0,0,0,,Барлығы ақымақ
Dialogue: 0,0:07:04.38,0:07:07.00,Default,,0,0,0,,Ол затты көрмейтін бала.
Dialogue: 0,0:07:07.09,0:07:08.30,Default,,0,0,0,,Осанаго?
Dialogue: 0,0:07:08.38,0:07:10.76,Default,,0,0,0,,Барлығы жай ғана ақымақ және ақымақ па?
Dialogue: 0,0:07:10.84,0:07:11.76,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:11.84,0:07:15.18,Default,,0,0,0,,Сіз шынымен ештеңе білмейсіз бе?
Dialogue: 0,0:07:15.26,0:07:16.39,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:07:17.52,0:07:19.81,Default,,0,0,0,,Бірақ... (Фукузава) Эдогава Ранпо!
Dialogue: 0,0:07:21.19,0:07:23.48,Default,,0,0,0,,Көзілдірік сізді қабылдады.
Dialogue: 0,0:07:23.56,0:07:26.02,Default,,0,0,0,,Жүрегіңізді ашсаңыз болғаны.
Dialogue: 0,0:07:26.52,0:07:28.69,Default,,0,0,0,,Жүрегіңді аш...
Dialogue: 0,0:07:30.86,0:07:33.53,Default,,0,0,0,,Бұл қорқынышты әлем...
Dialogue: 0,0:07:33.61,0:07:36.28,Default,,0,0,0,,Ол кезде, сол кезде, сол кезде...
Dialogue: 0,0:07:36.87,0:07:38.49,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:07:38.95,0:07:41.37,Default,,0,0,0,,Осы уақытқа дейінгі барлық азаптар
Dialogue: 0,0:07:41.46,0:07:46.79,Default,,0,0,0,,Бұл мәселе менің ішімде емес, айналамда болды дегенді білдіре ме?
Dialogue: 0,0:07:49.84,0:07:52.01,Default,,0,0,0,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:07:52.63,0:07:55.30,Default,,0,0,0,,Ештеңені түсінбейтін бала.
Dialogue: 0,0:07:55.39,0:07:59.43,Default,,0,0,0,,Басы жоқ бала біреуді жек көре ме?
Dialogue: 0,0:08:00.43,0:08:01.85,Default,,0,0,0,,(Кения) Бірақ білесің бе, біз оны Саторудың аурухана шығындарын жабуға көмектеседі деп ойладық➡
Dialogue: 0,0:08:08.57,0:08:11.94,Default,,0,0,0,,Мені ешкім жек көрмейтін.
Dialogue: 0,0:08:13.53,0:08:15.87,Default,,0,0,0,,Фуфуфуфуфухуху…
Dialogue: 0,0:08:16.37,0:08:18.16,Default,,0,0,0,,Ахахахха!
Dialogue: 0,0:08:18.24,0:08:20.08,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:08:20.16,0:08:21.04,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:08:23.71,0:08:26.67,Default,,0,0,0,,Түсіндім! Олардың барлығы жас балалар ма?
Dialogue: 0,0:08:26.75,0:08:29.38,Default,,0,0,0,,Дүние мүлде жиіркенішті емес
Dialogue: 0,0:08:29.46,0:08:32.34,Default,,0,0,0,,Тек салтанатты түрде ақымақ және ақымақ.
Dialogue: 0,0:08:32.42,0:08:36.18,Default,,0,0,0,,Егер бұл ақымақ бала болса, оны қорғау керек.
Dialogue: 0,0:08:36.26,0:08:37.60,Default,,0,0,0,,Сәлем Ранпо
Dialogue: 0,0:08:37.68,0:08:39.18,Default,,0,0,0,,Менің бір ісім бар
Dialogue: 0,0:08:39.85,0:08:42.27,Default,,0,0,0,,Ағай алдымен орнына оралды.
Dialogue: 0,0:08:42.35,0:08:44.94,Default,,0,0,0,,Біз әлі де кісі өлтірудің алдын алуымыз мүмкін.
Dialogue: 0,0:08:45.02,0:08:46.06,Default,,0,0,0,,Не?
Dialogue: 0,0:08:46.15,0:08:50.86,Default,,0,0,0,,Басқаша айтқанда, хабарлама орындалып, кісі өлтіру жасалды.
Dialogue: 0,0:08:50.94,0:08:53.03,Default,,0,0,0,,Оны керісінше қолданыңыз.
Dialogue: 0,0:08:53.11,0:08:54.90,Default,,0,0,0,,Бұл жамандықтың белгісі сияқты
Dialogue: 0,0:08:54.99,0:08:57.24,Default,,0,0,0,,Мен оны көріп тұрмын
Dialogue: 0,0:08:57.32,0:09:00.24,Default,,0,0,0,,Жаудың барлық мақсаттары мен жоспарлары
Dialogue: 0,0:09:00.33,0:09:05.08,Default,,0,0,0,,Сондықтан мен қария көрермендердің қимыл-қозғалысын бақылап отырса деймін.
Dialogue: 0,0:09:06.79,0:09:07.79,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:08.42,0:09:10.00,Default,,0,0,0,,Бірақ сақ болыңыз.
Dialogue: 0,0:09:10.09,0:09:11.59,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:11.67,0:09:14.67,Default,,0,0,0,,Өйткені мен ақымақ адамдарды қорғаймын⸺
Dialogue: 0,0:09:14.76,0:09:17.97,Default,,0,0,0,,Өйткені ол әлемдегі ең жақсы детектив!
Dialogue: 0,0:09:18.05,0:09:23.06,Default,,0,0,0,,♪~
Dialogue: 0,0:10:42.97,0:10:47.98,Default,,0,0,0,,~♪
Dialogue: 0,0:10:52.52,0:10:55.44,Default,,0,0,0,,Бізді кешіріңіз, Галоның соғыс періштесі
Dialogue: 0,0:10:55.52,0:10:58.65,Default,,0,0,0,,Әйтпесе, төменгі әлемде өзіңізді көрсетіңіз.
Dialogue: 0,0:10:58.74,0:11:01.28,Default,,0,0,0,,Мен өз өмірімді бағаламаймын.
Dialogue: 0,0:11:01.95,0:11:05.99,Default,,0,0,0,,Мені соттайтын болсаң, алдымен кеудемді тесіп ал.
Dialogue: 0,0:11:06.91,0:11:07.95,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:11:08.04,0:11:12.04,Default,,0,0,0,,Менің достарым бір-бірін адам бойындағы ұсқынсыздықтан жек көреді.
Dialogue: 0,0:11:12.12,0:11:13.54,Default,,0,0,0,,Маған көрсеткіңіз келеді, солай ма?
Dialogue: 0,0:11:13.63,0:11:17.34,Default,,0,0,0,,Онда мен оны әшкерелеймін! Сенің күнәң!
Dialogue: 0,0:11:17.96,0:11:18.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:30.64,0:11:32.81,Default,,0,0,0,,Керемет (Фукузава) Ах!
Dialogue: 0,0:11:32.90,0:11:35.15,Default,,0,0,0,,Сценарийде мұндай бағыт жоқ.
Dialogue: 0,0:11:40.49,0:11:41.82,Default,,0,0,0,,Нағыз қан...
Dialogue: 0,0:11:41.90,0:11:42.91,Default,,0,0,0,,Бұл жедел жәрдем!
Dialogue: 0,0:11:42.99,0:11:46.83,Default,,0,0,0,,Сыртта полицияға хабарлаңыз және театрды жауып тастаңыз!
Dialogue: 0,0:11:47.74,0:11:51.37,Default,,0,0,0,,Өлді ме? Бірақ өлтіретін қару қайда?
Dialogue: 0,0:11:52.79,0:11:54.38,Default,,0,0,0,,Адам өлтіру қаруы жоқ па?
Dialogue: 0,0:11:54.46,0:11:57.38,Default,,0,0,0,,Жоқ... періштені өлтіру?
Dialogue: 0,0:11:58.38,0:11:59.38,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:00.55,0:12:01.97,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:03.63,0:12:05.80,Default,,0,0,0,,Токио! Токио!
Dialogue: 0,0:12:05.89,0:12:07.89,Default,,0,0,0,,Шынымен өлді!
Dialogue: 0,0:12:07.97,0:12:09.64,Default,,0,0,0,,Өлді... (аудитория) Кісі өлтіру!
Dialogue: 0,0:12:09.72,0:12:11.56,Default,,0,0,0,,Орныңыздан кетпеңіз!
Dialogue: 0,0:12:11.64,0:12:15.77,Default,,0,0,0,,Қашқандар кісі өлтірді деп күдіктенуі мүмкін
Dialogue: 0,0:12:15.86,0:12:18.73,Default,,0,0,0,,… …
Dialogue: 0,0:12:19.90,0:12:23.57,Default,,0,0,0,,Сондықтан мен қария көрермендердің қимыл-қозғалысын бақылап отырса деймін.
Dialogue: 0,0:12:23.65,0:12:26.03,Default,,0,0,0,,Бұл қашып кеткен адам күдікті дегенді білдіре ме?
Dialogue: 0,0:12:34.71,0:12:36.58,Default,,0,0,0,,Ранпо қайда кетті?
Dialogue: 0,0:12:37.29,0:12:40.13,Default,,0,0,0,,Инспектор, бір аудитория жоғалып кетті.
Dialogue: 0,0:12:40.21,0:12:41.21,Default,,0,0,0,,Не?
Dialogue: 0,0:12:41.88,0:12:43.34,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:12:44.68,0:12:47.01,Default,,0,0,0,,Мынау оққағар мұғалім
Dialogue: 0,0:12:47.09,0:12:48.22,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:12:48.30,0:12:50.43,Default,,0,0,0,,Көрермендер қашып кетті деп естідім?
Dialogue: 0,0:12:50.51,0:12:51.35,Default,,0,0,0,,Иә
Dialogue: 0,0:12:51.43,0:12:55.60,Default,,0,0,0,,Театрды тосқауыл қоюда ебедейсіздік болған жоқ деп ойлаймын.
Dialogue: 0,0:12:55.69,0:12:56.81,Default,,0,0,0,,1 адам жоғалып кетті
Dialogue: 0,0:12:56.90,0:12:59.52,Default,,0,0,0,,Адамның сыртқы түрі мен отырған орны қандай?
Dialogue: 0,0:12:59.61,0:13:03.69,Default,,0,0,0,,Алдыңғы қатардағы орындық, ашық қоңыр костюм және дөңгелек қалпақ
Dialogue: 0,0:13:03.78,0:13:06.20,Default,,0,0,0,,Орта жастағы джентльмен тәрізді адам.
Dialogue: 0,0:13:06.28,0:13:08.37,Default,,0,0,0,,Оның қолында ағаш таяғы бар болса керек.
Dialogue: 0,0:13:09.53,0:13:10.78,Default,,0,0,0,,Біз қашып кете аламыз. Бұл оңай болады.
Dialogue: 0,0:13:11.37,0:13:13.75,Default,,0,0,0,,Джентльмен орнынан қашан шықты?
Dialogue: 0,0:13:13.83,0:13:15.16,Default,,0,0,0,,Қойылым басында
Dialogue: 0,0:13:15.25,0:13:18.29,Default,,0,0,0,,Оның өз орнында болғанын растаймыз...
Dialogue: 0,0:13:18.38,0:13:21.30,Default,,0,0,0,,Мен ғимаратты іздеймін.
Dialogue: 0,0:13:21.38,0:13:23.09,Default,,0,0,0,,А, оққағар?
Dialogue: 0,0:13:23.17,0:13:26.63,Default,,0,0,0,,Бұл менің кінәм. Мен орнаттым.
Dialogue: 0,0:13:26.72,0:13:30.35,Default,,0,0,0,,Ранпо - өзін-өзі қорғау қабілеті жоқ жай ғана бала.
Dialogue: 0,0:13:31.47,0:13:34.39,Default,,0,0,0,,Детектив қаншалықты тамаша болса да,
Dialogue: 0,0:13:34.48,0:13:39.19,Default,,0,0,0,,Егер қылмыскер сізге қарсы шығып, сізге шабуыл жасаса, жеңу мүмкіндігі жоқ.
Dialogue: 0,0:13:40.11,0:13:42.98,Default,,0,0,0,,Сіз өз күшіңізді жалғыз жұмсай алмайсыз.
Dialogue: 0,0:13:43.61,0:13:45.95,Default,,0,0,0,,Ранпоның қалқаны болыңыз және зұлымдықты тойтарыңыз
Dialogue: 0,0:13:46.03,0:13:49.91,Default,,0,0,0,,Бізге қауіпсіз ой қорыта алатын орта керек.
Dialogue: 0,0:13:59.50,0:14:01.42,Default,,0,0,0,,Фукузава мырза (Фукузава) Иә?
Dialogue: 0,0:14:04.76,0:14:06.34,Default,,0,0,0,,Кешіріңіз, мен асығып тұрмын.
Dialogue: 0,0:14:07.01,0:14:09.09,Default,,0,0,0,,Менде Ранпо-куннан хабар бар.
Dialogue: 0,0:14:09.18,0:14:10.72,Default,,0,0,0,,Не?
Dialogue: 0,0:14:10.80,0:14:12.97,Default,,0,0,0,,Ранпо-кун осылай деді.
Dialogue: 0,0:14:13.06,0:14:14.81,Default,,0,0,0,,«Екі кінәлі бар»
Dialogue: 0,0:14:15.39,0:14:18.85,Default,,0,0,0,,Бұл іс қылмыстың екі түрінен тұрады.
Dialogue: 0,0:14:18.94,0:14:20.86,Default,,0,0,0,,Мысалы, асшаяндар мен теңіз басы.
Dialogue: 0,0:14:21.61,0:14:25.03,Default,,0,0,0,,Оңай ұсталатын асшаяндарға қанағаттануға болмайды.
Dialogue: 0,0:14:25.11,0:14:26.74,Default,,0,0,0,,Асшаяндар өте дәмді.
Dialogue: 0,0:14:26.82,0:14:29.86,Default,,0,0,0,,Бірақ егер сіз теңіз қарағайын ұстағыңыз келсе
Dialogue: 0,0:14:29.95,0:14:33.58,Default,,0,0,0,,Бұл үшін асшаяндарды пайдаланудан басқа амалым жоқ.
Dialogue: 0,0:14:34.12,0:14:36.00,Default,,0,0,0,,Түсіну қиын…
Dialogue: 0,0:14:36.62,0:14:38.04,Default,,0,0,0,,Ранпо қайда орналасқан?
Dialogue: 0,0:14:38.12,0:14:41.54,Default,,0,0,0,,Ал, мен қазір қайда екенімді білмеймін.
Dialogue: 0,0:14:42.00,0:14:43.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:43.34,0:14:45.75,Default,,0,0,0,,Мураками өлтірілсе де неге күлесің?
Dialogue: 0,0:14:45.84,0:14:49.76,Default,,0,0,0,,Мен Ранпо-куннан оқиға туралы шындықтың бір бөлігін естідім.
Dialogue: 0,0:14:51.43,0:14:53.10,Default,,0,0,0,,Сәлем, Фукузава мырза
Dialogue: 0,0:14:53.18,0:14:55.10,Default,,0,0,0,,Бұл бала кім?
Dialogue: 0,0:14:55.18,0:14:58.56,Default,,0,0,0,,Оның тамаша детектив екеніне күмән жоқ.
Dialogue: 0,0:14:58.64,0:15:01.15,Default,,0,0,0,,Мүмкін ол айтқандай
Dialogue: 0,0:15:01.23,0:15:03.61,Default,,0,0,0,,Сіз шынымен де табиғаттан тыс күшке ие адамсыз ба?
Dialogue: 0,0:15:04.44,0:15:06.19,Default,,0,0,0,,Не болды
Dialogue: 0,0:15:06.28,0:15:08.57,Default,,0,0,0,,Оқиғаны тек ол ғана біледі
Dialogue: 0,0:15:09.15,0:15:12.91,Default,,0,0,0,,«Мен бәрін шешемін, сондықтан аудиторияға асығыңыз».
Dialogue: 0,0:15:12.99,0:15:14.45,Default,,0,0,0,,Сонымен
Dialogue: 0,0:15:20.50,0:15:22.46,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,0:15:22.54,0:15:24.79,Default,,0,0,0,,Ахахахха!
Dialogue: 0,0:15:24.88,0:15:26.92,Default,,0,0,0,,Мен осы пьесаның соңында көрінемін
Dialogue: 0,0:15:27.00,0:15:30.72,Default,,0,0,0,,Барлық жұмбақтарды шешуге арналған Deus ex machina!
Dialogue: 0,0:15:30.80,0:15:34.93,Default,,0,0,0,,Басқаша айтқанда, ол табиғаттан тыс күштерге ие және керемет детектив.
Dialogue: 0,0:15:35.01,0:15:38.60,Default,,0,0,0,,Енді шешу бөліміне көшейік.
Dialogue: 0,0:15:38.68,0:15:42.90,Default,,0,0,0,,Мен бұрын біреудің сыбырлағанын естідім.
Dialogue: 0,0:15:42.98,0:15:44.23,Default,,0,0,0,,Кейбіреулеріңіз
Dialogue: 0,0:15:44.31,0:15:47.61,Default,,0,0,0,,Өздерін періште өлтірді деп ойлайтындар аз емес сияқты.
Dialogue: 0,0:15:47.69,0:15:50.53,Default,,0,0,0,,Осы орайда мен мынаны айтқым келеді
Dialogue: 0,0:15:50.61,0:15:52.28,Default,,0,0,0,,Періште...
Dialogue: 0,0:15:52.36,0:15:53.49,Default,,0,0,0,,Иә
Dialogue: 0,0:15:54.20,0:15:57.62,Default,,0,0,0,,Періштелер сендерсіңдер, көрермендер.
Dialogue: 0,0:15:57.70,0:16:01.62,Default,,0,0,0,,Бұл оқиға мен пьеса бір-бірімен тығыз байланысты.
Dialogue: 0,0:16:01.71,0:16:04.54,Default,,0,0,0,,Бұл пьеса оқиғаның кері көрінісі.
Dialogue: 0,0:16:04.63,0:16:09.46,Default,,0,0,0,,Періштелер мен адамдар қарама-қарсы, ал үкім шығаратындар мен сотталғандар керісінше.
Dialogue: 0,0:16:10.01,0:16:12.13,Default,,0,0,0,,Ол жерде бос орын бар, солай ма?
Dialogue: 0,0:16:13.22,0:16:17.68,Default,,0,0,0,,Қалалық полиция жоғалып кеткен мырзаны шабуылдаушы деп ойлап отыр.
Dialogue: 0,0:16:17.76,0:16:20.77,Default,,0,0,0,,Бірақ бұл оқиға керісінше.
Dialogue: 0,0:16:20.85,0:16:25.52,Default,,0,0,0,,Эго мен эго құрылымы ауыстырылады, ал жәбірленуші мен қылмыскер керісінше.
Dialogue: 0,0:16:25.60,0:16:27.86,Default,,0,0,0,,Демек, ол қылмыскер емес
Dialogue: 0,0:16:29.27,0:16:30.82,Default,,0,0,0,,Мен құрбанмын
Dialogue: 0,0:16:30.90,0:16:35.11,Default,,0,0,0,,Ал жәбірленуші басынан бері осында болды.
Dialogue: 0,0:16:35.20,0:16:36.53,Default,,0,0,0,,(саусақтарды сермеу дыбысы)
Dialogue: 0,0:16:37.07,0:16:38.37,Default,,0,0,0,,(қосқышты басқан дыбыс)
Dialogue: 0,0:16:39.37,0:16:41.37,Default,,0,0,0,,Бұл кері қайтару!
Dialogue: 0,0:16:47.84,0:16:50.46,Default,,0,0,0,,Қылмыскер қазір құрбан болды.
Dialogue: 0,0:16:51.26,0:16:54.26,Default,,0,0,0,,Жүріңіз, полиция қызметкері, жұмыс уақыты келді.
Dialogue: 0,0:16:55.18,0:16:58.72,Default,,0,0,0,,Сіз жай ғана ес-түссіз жатырсыз, сондықтан алаңдаудың қажеті жоқ.
Dialogue: 0,0:17:00.01,0:17:01.68,Default,,0,0,0,,Енді...
Dialogue: 0,0:17:01.77,0:17:03.68,Default,,0,0,0,,Мұндағы табиғи сұрақ
Dialogue: 0,0:17:04.39,0:17:05.98,Default,,0,0,0,,Бұл қария кім?
Dialogue: 0,0:17:06.06,0:17:09.11,Default,,0,0,0,,Неліктен оны ұрлау керек болды?
Dialogue: 0,0:17:09.19,0:17:10.44,Default,,0,0,0,,Әрине
Dialogue: 0,0:17:10.52,0:17:13.03,Default,,0,0,0,,Қылмыскерден сұрау арқылы нені білуге болады
Dialogue: 0,0:17:13.74,0:17:18.12,Default,,0,0,0,,Кісі өлтіру оқиғалары бірінші кезекте ешқашан болған емес.
Dialogue: 0,0:17:18.20,0:17:20.87,Default,,0,0,0,,Кел, өзіңді көрсет!
Dialogue: 0,0:17:20.95,0:17:22.95,Default,,0,0,0,,Құлаған адам!
Dialogue: 0,0:17:28.17,0:17:29.17,Default,,0,0,0,,Не?
Dialogue: 0,0:17:32.21,0:17:33.55,Default,,0,0,0,,Сіз мұны қашан түсіндіңіз?
Dialogue: 0,0:17:33.63,0:17:35.63,Default,,0,0,0,,Басынан бастап
Dialogue: 0,0:17:35.72,0:17:37.63,Default,,0,0,0,,Мен сені киім ауыстыратын бөлмеде кездестіргенімде⸺
Dialogue: 0,0:17:37.72,0:17:41.39,Default,,0,0,0,,Сен бозарып, суды көп іштің.
Dialogue: 0,0:17:41.47,0:17:44.14,Default,,0,0,0,,Себебі, мен біраз бұрын қан алдым.
Dialogue: 0,0:17:44.85,0:17:48.40,Default,,0,0,0,,Қанды көріп үйренген мамандарды алдау мақсатында оққағар, қалалық полиция қызметкері.
Dialogue: 0,0:17:48.48,0:17:51.40,Default,,0,0,0,,Адамның жаңа қанын қолдану қажет болды
Dialogue: 0,0:17:51.48,0:17:55.15,Default,,0,0,0,,Импульс жиілігін жасырған нәрсе пьесаларда қолданылатын силикон резеңке орамасы болды.
Dialogue: 0,0:17:57.78,0:18:02.41,Default,,0,0,0,,Бұл пьесаны орындау үшін сценарий авторының ынтымақтастығы қажет.
Dialogue: 0,0:18:02.49,0:18:04.37,Default,,0,0,0,,Ол да сыбайлас.
Dialogue: 0,0:18:04.45,0:18:08.50,Default,,0,0,0,,Иә, мен сценарийшімен бірге жоспарладым.
Dialogue: 0,0:18:08.58,0:18:11.38,Default,,0,0,0,,Болмауы тиіс ерекше қабілеттері бар адам
Dialogue: 0,0:18:11.46,0:18:13.46,Default,,0,0,0,,Детектив ретінде көріне ме?
Dialogue: 0,0:18:13.55,0:18:16.34,Default,,0,0,0,,Детектив емес, керемет детектив!
Dialogue: 0,0:18:16.42,0:18:18.26,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:18.34,0:18:21.18,Default,,0,0,0,,Жоқ, мен актермін.
Dialogue: 0,0:18:21.26,0:18:26.10,Default,,0,0,0,,Өзің болмайтын нәрсеге айнал, жоқ өмірді баста
Dialogue: 0,0:18:26.18,0:18:28.77,Default,,0,0,0,,Адам болудың нені білдіретінін ашу туралы.
Dialogue: 0,0:18:28.85,0:18:30.31,Default,,0,0,0,,Бұл менің жұмысым.
Dialogue: 0,0:18:30.40,0:18:34.19,Default,,0,0,0,,Сіз өзіңіздің өмір салтыңызды көрсететін болсаңыз, аулақ болмайтын нәрселер бар.
Dialogue: 0,0:18:34.27,0:18:35.82,Default,,0,0,0,,Бұл «өлім»
Dialogue: 0,0:18:35.90,0:18:38.65,Default,,0,0,0,,Мен үшін ең басты жұмыс
Dialogue: 0,0:18:38.74,0:18:40.86,Default,,0,0,0,,Бұл нағыз өлімді сахналау болды.
Dialogue: 0,0:18:41.45,0:18:44.58,Default,,0,0,0,,Мен үшін театрды меңгеру деген осы.
Dialogue: 0,0:18:45.24,0:18:48.16,Default,,0,0,0,,Мен өлімді ойнаған алғашқы актер болдым.
Dialogue: 0,0:18:48.25,0:18:49.33,Default,,0,0,0,,Сонымен, сен сол аралда не істеп жүрдің?
Dialogue: 0,0:18:49.41,0:18:53.50,Default,,0,0,0,,Мен оны осында келгендердің бәрі көрсін деп едім.
Dialogue: 0,0:18:55.05,0:18:56.55,Default,,0,0,0,,Қандай сараң.
Dialogue: 0,0:18:57.80,0:18:59.76,Default,,0,0,0,,Бұл менің өмір жолым
Dialogue: 0,0:19:00.55,0:19:02.22,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:19:02.30,0:19:06.35,Default,,0,0,0,,Менің ойымша, бұл тамаша. Менің ойымша, мұны ешкім жасай алмайды.
Dialogue: 0,0:19:06.85,0:19:08.56,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:19:08.64,0:19:12.02,Default,,0,0,0,,Аудиториядағы әрбір адамның жүзіне қараңыз.
Dialogue: 0,0:19:14.90,0:19:18.49,Default,,0,0,0,,Мұнда келген адамдарға екі ортақ нәрсе бар.
Dialogue: 0,0:19:19.24,0:19:22.95,Default,,0,0,0,,Біріншісі, сіздің театр ұжымыңыздың пьесаларын көруге келгенім ұнады.
Dialogue: 0,0:19:23.45,0:19:24.70,Default,,0,0,0,,The other thing is
Dialogue: 0,0:19:24.78,0:19:28.16,Default,,0,0,0,,Менің көз алдымда біреудің өлгенін көре білу
Dialogue: 0,0:19:28.79,0:19:30.62,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:19:30.71,0:19:33.96,Default,,0,0,0,,Тұтынушыны осылай көрсету өте қиын...
Dialogue: 0,0:19:34.04,0:19:34.92,Default,,0,0,0,,Ha
Dialogue: 0,0:19:35.67,0:19:38.63,Default,,0,0,0,,Театрды меңгеру дегенді білдіреді деп ойлаймын.
Dialogue: 0,0:19:48.02,0:19:49.52,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:19:50.73,0:19:52.48,Default,,0,0,0,,Мен жай ғана
Dialogue: 0,0:19:52.56,0:19:55.15,Default,,0,0,0,,Сіз оны өзіңіз үшін ойнадыңыз ба?
Dialogue: 0,0:20:07.03,0:20:08.58,Default,,0,0,0,,Ранпо!
Dialogue: 0,0:20:08.66,0:20:11.12,Default,,0,0,0,,Мына көзілдірік ғажап екен, ағай.
Dialogue: 0,0:20:11.21,0:20:13.33,Default,,0,0,0,,Міне...
Dialogue: 0,0:20:13.42,0:20:15.92,Default,,0,0,0,,Егер менде осы көзілдірік және менің ерекше қабілетім болса,
Dialogue: 0,0:20:16.00,0:20:18.88,Default,,0,0,0,,Біз бара жатқан жерде жау жоқ.
Dialogue: 0,0:20:18.96,0:20:21.13,Default,,0,0,0,,Ұстаздар, еңбектеріңіз үшін рахмет!
Dialogue: 0,0:20:21.22,0:20:22.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:22.59,0:20:25.18,Default,,0,0,0,,Мен секіруші мұғалімді көргеннен бері
Dialogue: 0,0:20:25.26,0:20:28.68,Default,,0,0,0,,Мен сіздің мәселені шешетініңізге сенімді болдым.
Dialogue: 0,0:20:28.76,0:20:32.81,Default,,0,0,0,,Әй... Мен сенің мұндай құпия қаруың бар екенін білмедім.
Dialogue: 0,0:20:32.89,0:20:34.10,Default,,0,0,0,,Бұл туралы...
Dialogue: 0,0:20:34.81,0:20:36.48,Default,,0,0,0,,Бұдан былай ұстаздар
Dialogue: 0,0:20:36.56,0:20:40.48,Default,,0,0,0,,Менің ойымша, мен полиция бөлімшесінде істің қаралу схемасын түсіндіруді сұрайды.
Dialogue: 0,0:20:40.57,0:20:43.07,Default,,0,0,0,,Жарайды, бірақ мен оны жазбаға жаза аламын ба?
Dialogue: 0,0:20:43.15,0:20:45.49,Default,,0,0,0,,Ақиқатты көрген себебім
Dialogue: 0,0:20:45.57,0:20:47.91,Default,,0,0,0,,Өйткені менде ерекше қабілет болды.
Dialogue: 0,0:20:47.99,0:20:48.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:48.91,0:20:51.66,Default,,0,0,0,,Ерекше қабілеті бар адам? Бұл спектакльде пайда болды ма?
Dialogue: 0,0:20:51.75,0:20:55.62,Default,,0,0,0,,Не! Жас детективтің табиғаттан тыс күштері бар ма?
Dialogue: 0,0:20:55.71,0:20:59.25,Default,,0,0,0,,Дұрыс, оқиғаның шындығын көре алатын ерекше қабілеті бар адам.
Dialogue: 0,0:20:59.34,0:21:01.55,Default,,0,0,0,,Ұлы детектив Эдогава Ранпоға сәлем айтыңыз!
Dialogue: 0,0:21:01.63,0:21:02.63,Default,,0,0,0,,Күтіңіз, күтіңіз
Dialogue: 0,0:21:02.71,0:21:04.01,Default,,0,0,0,,Офицер
Dialogue: 0,0:21:04.09,0:21:07.22,Default,,0,0,0,,Сұрақты мен шешемін.
Dialogue: 0,0:21:07.30,0:21:10.10,Default,,0,0,0,,Ранпо шындықты үйренбеген зерттеуден шаршады.
Dialogue: 0,0:21:10.18,0:21:12.43,Default,,0,0,0,,Не? Менде бәрі жақсы
Dialogue: 0,0:21:12.52,0:21:13.52,Default,,0,0,0,,Бұл жолы сіз
Dialogue: 0,0:21:13.60,0:21:16.94,Default,,0,0,0,,Мен жаңа ғана шындықты бақылау және дедукция арқылы аштым.
Dialogue: 0,0:21:17.02,0:21:19.06,Default,,0,0,0,,Мен басқа қабілет пайдаланған сияқты емеспін...
Dialogue: 0,0:21:19.90,0:21:21.27,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:21:21.36,0:21:22.94,Default,,0,0,0,,Мен саған табиғаттан тыс күштерім бар екенін айттым.
Dialogue: 0,0:21:23.03,0:21:23.94,Default,,0,0,0,,Ағай
Dialogue: 0,0:21:24.03,0:21:25.53,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:25.61,0:21:28.07,Default,,0,0,0,,Эй, мен тіпті табиғаттан тыс күшке ие адам емеспін.
Dialogue: 0,0:21:28.16,0:21:30.49,Default,,0,0,0,,Оқиғаның шындығын бір сәтте көре аласыз деп ойлайсыз ба?
Dialogue: 0,0:21:30.58,0:21:32.20,Default,,0,0,0,,Бұл мүмкін емес деп ойлаймын!
Dialogue: 0,0:21:32.83,0:21:34.54,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:21:34.62,0:21:36.79,Default,,0,0,0,,Полиция маған дәл қазір айтады
Dialogue: 0,0:21:36.87,0:21:38.50,Default,,0,0,0,,Күнжітті ұнтақтап алған дұрыс.
Dialogue: 0,0:21:39.17,0:21:41.96,Default,,0,0,0,,Өйткені, менде істерді шешудің табиғаттан тыс қабілеті бар.
Dialogue: 0,0:21:42.05,0:21:45.38,Default,,0,0,0,,Бұл полиция жұмысын алып тастайтын құдайға ұқсайтын күш.
Dialogue: 0,0:21:45.47,0:21:46.30,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:46.38,0:21:49.14,Default,,0,0,0,,Полиция көлігінде жүру қызық.
Dialogue: 0,0:21:49.85,0:21:52.35,Default,,0,0,0,,Ағамның қасында болсам көп уақыт кетеді.
Dialogue: 0,0:21:52.43,0:21:55.06,Default,,0,0,0,,Бірінші өзім барамын.
Dialogue: 0,0:21:55.56,0:21:56.98,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:21:57.06,0:22:00.36,Default,,0,0,0,,Кейінгі процедураларға қатысты Эгава ханыммен кеңесіңіз
Dialogue: 0,0:22:00.44,0:22:01.98,Default,,0,0,0,,Алға.
Dialogue: 0,0:22:02.73,0:22:04.57,Default,,0,0,0,,Полиция қызметкері, Ранподан сұраңыз.
Dialogue: 0,0:22:04.65,0:22:06.74,Default,,0,0,0,,Кашикомаришита!
Dialogue: 0,0:22:06.82,0:22:07.78,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:22:12.99,0:22:15.16,Default,,0,0,0,,Фукузава мырза! (Фукузава) Иә?
Dialogue: 0,0:22:15.25,0:22:17.00,Default,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:22:17.08,0:22:19.17,Default,,0,0,0,,Тоттотто... АЙТАТ!
Dialogue: 0,0:22:22.29,0:22:23.13,Default,,0,0,0,,Ахаха
Dialogue: 0,0:22:24.17,0:22:26.72,Default,,0,0,0,,«Фукузава мырза»…
Dialogue: 0,0:22:28.76,0:22:30.51,Default,,0,0,0,,Сәл қарсы боласыз ба?
Dialogue: 0,0:22:30.59,0:22:32.01,Default,,0,0,0,,Фукузава мырза
Dialogue: 0,0:22:32.10,0:22:33.72,Default,,0,0,0,,Мен сізден сұрайын дегенім бар.
Dialogue: 0,0:22:34.39,0:22:37.52,Default,,0,0,0,,Байланып, есінен танып қалған адам кім болды?
Dialogue: 0,0:22:37.60,0:22:38.44,Default,,0,0,0,,О
Dialogue: 0,0:22:38.52,0:22:40.52,Default,,0,0,0,,Сол джентльмен осы жоспардың бір бөлігі.
Dialogue: 0,0:22:40.60,0:22:43.02,Default,,0,0,0,,Бұл басқа мақсат деп естідім.
Dialogue: 0,0:22:43.82,0:22:44.86,Default,,0,0,0,,«Мен тыңдаймын»?
Dialogue: 0,0:22:44.94,0:22:49.53,Default,,0,0,0,,Бұл оқиға сценарист Курахашимен бірге жоспарланған.
Dialogue: 0,0:22:49.61,0:22:52.49,Default,,0,0,0,,Бұл жерде бір мақсат болған сияқты.
Dialogue: 0,0:22:53.12,0:22:56.83,Default,,0,0,0,,Костюмдегі әлгі джентльмен сирек көрінетін адам.
Dialogue: 0,0:22:56.91,0:23:00.12,Default,,0,0,0,,Оны қолға түсіру де олардың мақсаттарының бірі болды.
Dialogue: 0,0:23:00.87,0:23:02.54,Default,,0,0,0,,Фукузава мырза!
Dialogue: 0,0:23:02.63,0:23:04.96,Default,,0,0,0,,Күдікті барлық уақытта сонда болды ма?
Dialogue: 0,0:23:05.05,0:23:06.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:23:06.88,0:23:09.26,Default,,0,0,0,,Сценарист өз бөлмесінде өлтірілді
Dialogue: 0,0:23:09.34,0:23:10.38,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:23:10.47,0:23:11.72,Default,,0,0,0,,Бұл...
Dialogue: 0,0:23:12.30,0:23:15.18,Default,,0,0,0,,Оқиға орнында ешқандай ұрыс белгілері байқалмаған сияқты.
Dialogue: 0,0:23:15.26,0:23:16.93,Default,,0,0,0,,Менің жабық бөлмемде
Dialogue: 0,0:23:17.02,0:23:20.60,Default,,0,0,0,,Арқамнан ішіме дейін пышақпен...
Dialogue: 0,0:23:23.98,0:23:25.86,Default,,0,0,0,,Бөлмедегі құпия кісі өлтіру?
Dialogue: 0,0:23:26.36,0:23:28.61,Default,,0,0,0,,Не болып жатыр...
Dialogue: 0,0:23:31.15,0:23:33.53,Default,,0,0,0,,Офицер, келуге қанша уақыт қажет?
Dialogue: 0,0:23:34.62,0:23:35.74,Default,,0,0,0,,Бірден
Dialogue: 0,0:23:38.58,0:23:40.21,Default,,0,0,0,,Хмм.
Dialogue: 0,0:23:41.71,0:23:47.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory