Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.46,0:00:05.79,Default,,0,0,0,,Өлім – конвульсия
Dialogue: 0,0:00:05.88,0:00:07.09,Default,,0,0,0,,Кісі өлтіру
Dialogue: 0,0:00:07.79,0:00:10.55,Default,,0,0,0,,Бұл әлсіздерге табыну
Dialogue: 0,0:00:11.26,0:00:15.84,Default,,0,0,0,,Мен кісі өлтіру періштесімін, қылмыс патшасымын
Dialogue: 0,0:00:15.93,0:00:18.35,Default,,0,0,0,,Жатқан жеріңіз жайлы болсын!
Dialogue: 0,0:00:21.02,0:00:26.02,Default,,0,0,0,,♪~
Dialogue: 0,0:01:45.98,0:01:50.98,Default,,0,0,0,,~♪
Dialogue: 0,0:01:51.06,0:01:54.07,Default,,0,0,0,,(киімделген аяқ ізі)
Dialogue: 0,0:02:02.49,0:02:06.20,Default,,0,0,0,,Тыңда, мен сені бұл жерден міндетті түрде алып кетемін.
Dialogue: 0,0:02:11.63,0:02:14.50,Default,,0,0,0,,Тыңдайсыз ба? Куникида
Dialogue: 0,0:02:14.96,0:02:17.72,Default,,0,0,0,,Жарайды, Ранпо-сан.
Dialogue: 0,0:02:17.80,0:02:20.43,Default,,0,0,0,,Күдіктінің ұсталуы заңды.
Dialogue: 0,0:02:20.51,0:02:22.89,Default,,0,0,0,,Сіздің айыпыңыз кісі өлтіру.
Dialogue: 0,0:02:23.81,0:02:26.52,Default,,0,0,0,,Қыз гранатаны өз қолымен жарып жіберді.
Dialogue: 0,0:02:26.60,0:02:27.85,Default,,0,0,0,,Бұл сіздің дәлеліңіз.
Dialogue: 0,0:02:29.77,0:02:34.23,Default,,0,0,0,,Бірақ куәгерлер жоқ, дәлелдерді жау жойып жіберді.
Dialogue: 0,0:02:34.32,0:02:38.70,Default,,0,0,0,,Гранаттың детектив агенттігінің үлгі нөміріне сәйкес келетінін ескеріңіз.
Dialogue: 0,0:02:39.28,0:02:41.32,Default,,0,0,0,,Сіз ренжіп қалдыңыз
Dialogue: 0,0:02:41.82,0:02:46.83,Default,,0,0,0,,Бұл егеуқұйрықтар стратегиясының бір бөлігінен гөрі кездейсоқ қудалау.
Dialogue: 0,0:02:47.79,0:02:49.33,Default,,0,0,0,,Мен...
Dialogue: 0,0:02:49.41,0:02:52.08,Default,,0,0,0,,Сіз айыпты кінәлі деп қабылдайсыз ба?
Dialogue: 0,0:02:53.29,0:02:55.75,Default,,0,0,0,,Сіз өз күресіңіз туралы білесіз бе?
Dialogue: 0,0:02:55.84,0:02:58.38,Default,,0,0,0,,Мен сені ақтаймын
Dialogue: 0,0:02:58.46,0:03:02.76,Default,,0,0,0,,Тышқанда дәлелдемелерді жоюдың маманы болып табылатын «жасырғыш» болуы керек.
Dialogue: 0,0:03:02.84,0:03:05.05,Default,,0,0,0,,Оны ұстаңыз
Dialogue: 0,0:03:05.14,0:03:07.10,Default,,0,0,0,,Ешкімнің шағымдануына жол бермеңіз
Dialogue: 0,0:03:07.18,0:03:10.18,Default,,0,0,0,,Детективке де, президентке де.
Dialogue: 0,0:03:10.27,0:03:12.85,Default,,0,0,0,,Ранпо-сан, сен неге сонша...
Dialogue: 0,0:03:14.65,0:03:16.07,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:03:16.15,0:03:19.36,Default,,0,0,0,,Жын Федордың тұзағын бұзсам ғой.
Dialogue: 0,0:03:20.15,0:03:22.49,Default,,0,0,0,,Қыз өлген жоқ
Dialogue: 0,0:03:27.87,0:03:30.50,Default,,0,0,0,,Хмм, қиын.
Dialogue: 0,0:03:31.58,0:03:34.58,Default,,0,0,0,,Осы «білім алыбы» Поды санамалау нені білдіреді?
Dialogue: 0,0:03:34.67,0:03:37.34,Default,,0,0,0,,Қиыр Шығыстың құпиясы
Dialogue: 0,0:03:37.42,0:03:39.34,Default,,0,0,0,,Бірақ бұл жұмыстың құпиясы
Dialogue: 0,0:03:39.42,0:03:41.97,Default,,0,0,0,,Мен бірінші болатыныма сенімдімін!
Dialogue: 0,0:03:42.05,0:03:43.68,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:03:43.76,0:03:45.35,Default,,0,0,0,,Иә? О, жоқ!
Dialogue: 0,0:03:51.68,0:03:52.69,Default,,0,0,0,,Кю
Dialogue: 0,0:03:54.31,0:03:56.52,Default,,0,0,0,,По мырза, қандай таңғаларлық сәйкестік.
Dialogue: 0,0:03:56.61,0:03:58.40,Default,,0,0,0,,Ра... Ранпо-кун?
Dialogue: 0,0:03:58.48,0:03:59.94,Default,,0,0,0,,Сен мұндай жерде не істеп жүрсің?
Dialogue: 0,0:04:00.99,0:04:02.95,Default,,0,0,0,,А, жиналыс па?
Dialogue: 0,0:04:03.53,0:04:05.24,Default,,0,0,0,,Қорытынды
Dialogue: 0,0:04:05.95,0:04:09.91,Default,,0,0,0,,Белгілі бір затты аукционға қою және оны алу.
Dialogue: 0,0:04:09.99,0:04:12.87,Default,,0,0,0,,Ранпо-кун, сен мұнда не істеп жүрсің?
Dialogue: 0,0:04:12.96,0:04:16.17,Default,,0,0,0,,Дәлірек айтсақ... бұл қандай көрініс?
Dialogue: 0,0:04:16.25,0:04:19.34,Default,,0,0,0,,Ақырында кірісетін біреу пайда болды ма?
Dialogue: 0,0:04:20.13,0:04:24.18,Default,,0,0,0,,«Канибализм» оқиғасы кезінде президенттің бұйрығын орындамау.
Dialogue: 0,0:04:24.63,0:04:28.35,Default,,0,0,0,,Мен сатушыға көмектесуге мәжбүр болдым, бірақ мен қашып кеттім.
Dialogue: 0,0:04:28.43,0:04:31.14,Default,,0,0,0,,Одан да жақсырақ жерде кездестік.
Dialogue: 0,0:04:31.22,0:04:33.39,Default,,0,0,0,,Кішкене көмек! Гаа!
Dialogue: 0,0:04:33.48,0:04:36.48,Default,,0,0,0,,Ранпо-кун! Менің де кездесетін адамым бар...
Dialogue: 0,0:04:36.56,0:04:37.52,Default,,0,0,0,,Я!
Dialogue: 0,0:04:37.61,0:04:39.73,Default,,0,0,0,,Карл ішке кірді!
Dialogue: 0,0:04:40.98,0:04:42.61,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:42.69,0:04:44.86,Default,,0,0,0,,Жаудың жасырын жойғышы
Dialogue: 0,0:04:44.95,0:04:48.28,Default,,0,0,0,,Бұл оның осы обсерваторияда пайда болатынын білдіре ме?
Dialogue: 0,0:04:48.37,0:04:49.37,Default,,0,0,0,,Иә
Dialogue: 0,0:04:49.45,0:04:52.45,Default,,0,0,0,,Ондай жағдайда Ранпо-кун менімен бірге іздеу керек...
Dialogue: 0,0:04:52.54,0:04:54.08,Default,,0,0,0,,Менің бетім жарылып кетті
Dialogue: 0,0:04:54.62,0:04:58.42,Default,,0,0,0,,Жасырын жоюшы - Федордың серіктесі және одақтасы.
Dialogue: 0,0:04:58.50,0:05:01.05,Default,,0,0,0,,Ақпаратты манипуляциялаудың маманы.
Dialogue: 0,0:05:01.13,0:05:04.01,Default,,0,0,0,,Менің де жоспарым бар...
Dialogue: 0,0:05:04.09,0:05:07.59,Default,,0,0,0,,Ранпо-кун менен көмек сұрағанда, мен бас тартуым қиынға соғады.
Dialogue: 0,0:05:07.68,0:05:09.85,Default,,0,0,0,,Ондецуя туралы не білеміз
Dialogue: 0,0:05:09.93,0:05:11.85,Default,,0,0,0,,Мен сізге берген фотосурет.
Dialogue: 0,0:05:13.93,0:05:16.64,Default,,0,0,0,,Достарыңыз көп емес сияқты.
Dialogue: 0,0:05:16.73,0:05:18.52,Default,,0,0,0,,Сіз басқа адамдар туралы айта алмайсыз.
Dialogue: 0,0:05:19.11,0:05:20.61,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:05:20.69,0:05:24.36,Default,,0,0,0,,Неліктен бұл жерде жасырын жоюшы пайда болады деп ойладыңыз?
Dialogue: 0,0:05:24.44,0:05:27.24,Default,,0,0,0,,Ұсталған табиғаттан тыс тіршілік иесі құсады.
Dialogue: 0,0:05:27.32,0:05:28.32,Default,,0,0,0,,Бірақ
Dialogue: 0,0:05:29.74,0:05:31.83,Default,,0,0,0,,Бұл жақсы жағдайда көрінетін кішкентай зат болды.
Dialogue: 0,0:05:31.91,0:05:34.16,Default,,0,0,0,,Бұл өтірік әзіл болды ма?
Dialogue: 0,0:05:35.79,0:05:37.62,Default,,0,0,0,,Мерзім аяқталды.
Dialogue: 0,0:05:37.71,0:05:39.96,Default,,0,0,0,,Ол көрінбейді.
Dialogue: 0,0:05:40.04,0:05:43.46,Default,,0,0,0,,Хмм, мен зеріктім, По. Маған бір қызық айтыңызшы.
Dialogue: 0,0:05:43.55,0:05:44.80,Default,,0,0,0,,Мучабури!
Dialogue: 0,0:05:44.88,0:05:45.84,Default,,0,0,0,,Ах
Dialogue: 0,0:05:45.92,0:05:50.85,Default,,0,0,0,,Мен бұрын шешпек болған жұмбақ оқиға ше?
Dialogue: 0,0:05:50.93,0:05:53.06,Default,,0,0,0,,Дәл қазір дүниедегі ең қиыншылықты тудыратын нәрсе...
Dialogue: 0,0:05:53.14,0:05:55.39,Default,,0,0,0,,Жоқ! Жұмбақ?
Dialogue: 0,0:05:55.48,0:05:58.35,Default,,0,0,0,,Маңайдағы балалармен ойнау әлдеқайда мағыналы
Dialogue: 0,0:05:58.44,0:05:59.52,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:05:59.60,0:06:02.69,Default,,0,0,0,,Бұл автор өлтірілді!
Dialogue: 0,0:06:02.77,0:06:06.74,Default,,0,0,0,,Бұл менің романымдағыдай өлтіру әдісі.
Dialogue: 0,0:06:06.82,0:06:07.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:08.74,0:06:12.28,Default,,0,0,0,,Романның үш оқиғасына дейін журналда жарияланған.
Dialogue: 0,0:06:12.91,0:06:16.29,Default,,0,0,0,,Қорытынды және шешуші тарау болып табылатын 4-ші эпизодтың қолжазбасы
Dialogue: 0,0:06:16.37,0:06:19.29,Default,,0,0,0,,Өлім аяқталғаннан кейін бірден орын алды
Dialogue: 0,0:06:19.37,0:06:24.30,Default,,0,0,0,,Ал кісі өлтіргеннен кейін қылмыскер оқиға орнынан төртінші эпизодты ұрлады.
Dialogue: 0,0:06:24.38,0:06:25.67,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:06:25.76,0:06:27.17,Default,,0,0,0,,Төртінші эпизодта
Dialogue: 0,0:06:27.26,0:06:31.68,Default,,0,0,0,,Өлтіруден кейінгі қулық пен шындық жазылғандықтан...
Dialogue: 0,0:06:31.76,0:06:34.18,Default,,0,0,0,,Қайтыс болған адам «Киндайчи» деген лақап аты бар адам.
Dialogue: 0,0:06:34.26,0:06:35.89,Default,,0,0,0,,Жұмбақ жазушы болу
Dialogue: 0,0:06:35.97,0:06:39.52,Default,,0,0,0,,Оның шебер де атақты жазушысы үшін дүние дүр сілкінді.
Dialogue: 0,0:06:39.60,0:06:42.11,Default,,0,0,0,,Бүкіл саламен 3-ші эпизодқа дейін қайта оқыңыз
Dialogue: 0,0:06:42.19,0:06:44.86,Default,,0,0,0,,Жұмбақ шешуге тырысып, бірақ толығымен жеңілді
Dialogue: 0,0:06:44.94,0:06:47.57,Default,,0,0,0,,Мен де тырысамын, бірақ бұл өте...
Dialogue: 0,0:06:47.65,0:06:48.99,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:49.07,0:06:51.82,Default,,0,0,0,,Ранпо-кун!? (Ранпо) Сенің де бос уақытың көп.
Dialogue: 0,0:06:51.91,0:06:54.20,Default,,0,0,0,,Басқа қабатта күту керек емес пе?
Dialogue: 0,0:06:54.28,0:06:57.50,Default,,0,0,0,,Мен жасырын жойғышты ала алмайтын 8 соққылық трюк ойлап таптым.
Dialogue: 0,0:06:57.58,0:07:00.42,Default,,0,0,0,,Қазір, осы жерде және қазір, романдағы кінәліні тап.
Dialogue: 0,0:07:00.50,0:07:03.08,Default,,0,0,0,,Ах! Әй... мен тоқтаймын!
Dialogue: 0,0:07:03.17,0:07:05.00,Default,,0,0,0,,Кінәлі ертең бәрібір белгілі болады.
Dialogue: 0,0:07:05.09,0:07:07.05,Default,,0,0,0,,Ертең? неге?
Dialogue: 0,0:07:07.13,0:07:10.51,Default,,0,0,0,,Қылмыскердің екі мақсаты болған: кек пен ақша.
Dialogue: 0,0:07:10.59,0:07:14.55,Default,,0,0,0,,Қылмыскерге төртінші эпизодтың мазмұны аяқталмай тұрып айтылды.
Dialogue: 0,0:07:14.64,0:07:17.56,Default,,0,0,0,,Басқаша айтқанда, ол жәбірленушіге біршама жақын.
Dialogue: 0,0:07:18.10,0:07:20.31,Default,,0,0,0,,Кісі өлтіру ниеті осыдан шыққан.
Dialogue: 0,0:07:20.39,0:07:24.15,Default,,0,0,0,,Олай болса, неге қолжазбаны аяқтағаннан кейін оны бірден өлтірдің?
Dialogue: 0,0:07:24.23,0:07:26.11,Default,,0,0,0,,Өйткені мен аяқталуын күттім.
Dialogue: 0,0:07:26.19,0:07:29.32,Default,,0,0,0,,Бұл кісі өлтіру туралы әлем неғұрлым қатты толқса, соғұрлым ол одан сайын толқуда.
Dialogue: 0,0:07:29.40,0:07:31.53,Default,,0,0,0,,Қолжазбалардың жоғары бағасы
Dialogue: 0,0:07:31.61,0:07:33.20,Default,,0,0,0,,Ол оны сатпақ болды.
Dialogue: 0,0:07:33.28,0:07:35.53,Default,,0,0,0,,Оны сату керек емес пе?
Dialogue: 0,0:07:35.62,0:07:37.95,Default,,0,0,0,,Мен оны сатамын, дәлірек айтсам, мен оны саттым.
Dialogue: 0,0:07:38.04,0:07:39.79,Default,,0,0,0,,Кімге? (Ранпо) Саған
Dialogue: 0,0:07:41.91,0:07:44.29,Default,,0,0,0,,Маған сіздің тамаша көмекшіңіз айтты
Dialogue: 0,0:07:44.75,0:07:47.84,Default,,0,0,0,,Мереке күндері көп жиналатын ұсақ жануарлар қауіпті және қиын.
Dialogue: 0,0:07:47.92,0:07:51.05,Default,,0,0,0,,Сонда да мен сені кездесу үшін әкелдім.
Dialogue: 0,0:07:51.13,0:07:53.63,Default,,0,0,0,,Демек, біз бір-бірімізді танымаймыз.
Dialogue: 0,0:07:53.72,0:07:55.68,Default,,0,0,0,,Сіз «аукцион» дедіңіз
Dialogue: 0,0:07:55.76,0:07:59.14,Default,,0,0,0,,Жер асты аукционы – дүрбелең тудырған 4-ші эпизодты сатуға ең жақсы орын
Dialogue: 0,0:07:59.22,0:08:01.23,Default,,0,0,0,,Жалғастырғыңыз келе ме?
Dialogue: 0,0:08:03.06,0:08:04.48,Default,,0,0,0,,Я...
Dialogue: 0,0:08:04.56,0:08:07.73,Default,,0,0,0,,Уф... Мен жұмбақты өз бетімше шешкім келді.
Dialogue: 0,0:08:08.40,0:08:13.03,Default,,0,0,0,,Бірақ полиция қолжазбаны сатып алса, шындық баспасөзде ашылады.
Dialogue: 0,0:08:13.11,0:08:17.20,Default,,0,0,0,,Бұл тамаша дәлел. Оны бірден полицияға тапсырсаңыз, сізге алғыс хат беріледі.
Dialogue: 0,0:08:17.28,0:08:18.78,Default,,0,0,0,,Біз осылай істейміз.
Dialogue: 0,0:08:18.87,0:08:21.70,Default,,0,0,0,,Бұл кем дегенде 20 миллион иенге сатып алу болды.
Dialogue: 0,0:08:21.79,0:08:22.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:22.96,0:08:24.96,Default,,0,0,0,,Бұл не? сол бет
Dialogue: 0,0:08:25.04,0:08:28.21,Default,,0,0,0,,Шебер сәулетші атағы одақта үшінші орында.
Dialogue: 0,0:08:28.29,0:08:31.34,Default,,0,0,0,,Бұл келесі күні төлегеніңізді ұмытатын сома.
Dialogue: 0,0:08:31.42,0:08:32.97,Default,,0,0,0,,Сен ақымақ емессің бе!?
Dialogue: 0,0:08:33.05,0:08:37.05,Default,,0,0,0,,Мен Ранпо-кунның таң қалдырған асыл лебізін көрдім, сондықтан мен қара түстім.
Dialogue: 0,0:08:37.14,0:08:40.14,Default,,0,0,0,,Олай болса, мен оны тезірек алуым керек.
Dialogue: 0,0:08:40.22,0:08:44.31,Default,,0,0,0,,Ұстаушының белгісі «қызыл конверт» болды...
Dialogue: 0,0:08:44.39,0:08:47.10,Default,,0,0,0,,Қызыл конверт сол жерде.
Dialogue: 0,0:08:47.19,0:08:48.98,Default,,0,0,0,,О, мен білмей тұрып
Dialogue: 0,0:09:07.79,0:09:10.13,Default,,0,0,0,,Қазіргі адамның бет-бейнесі
Dialogue: 0,0:09:11.42,0:09:12.63,Default,,0,0,0,,Жасырын жоюшы
Dialogue: 0,0:09:13.46,0:09:15.22,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:09:15.30,0:09:19.26,Default,,0,0,0,,Бұл жұмбақты күлкі ету өте қиын.
Dialogue: 0,0:09:22.93,0:09:24.52,Default,,0,0,0,,Лезде өлім
Dialogue: 0,0:09:24.98,0:09:29.23,Default,,0,0,0,,Бұл суицид болуы мүмкін бе? Немесе тінтуірдің дыбысын өшіру керек пе?
Dialogue: 0,0:09:29.31,0:09:31.23,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:09:31.32,0:09:32.32,Default,,0,0,0,,Ах
Dialogue: 0,0:09:33.86,0:09:35.82,Default,,0,0,0,,Қалалық полиция! Мәйітке тиіспе!
Dialogue: 0,0:09:36.45,0:09:37.86,Default,,0,0,0,,Балалар...
Dialogue: 0,0:09:37.95,0:09:39.37,Default,,0,0,0,,Сәлем! (Минура) Уау!
Dialogue: 0,0:09:39.45,0:09:40.45,Default,,0,0,0,,Ранпо-кун?
Dialogue: 0,0:09:40.53,0:09:41.91,Default,,0,0,0,,Минура мырза!
Dialogue: 0,0:09:41.99,0:09:43.24,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:09:43.33,0:09:46.12,Default,,0,0,0,,... Жібер, детектив! Құтылып кету!
Dialogue: 0,0:09:46.21,0:09:48.21,Default,,0,0,0,,Сіз ең жақсысыз! (Минура) Тоқта! Қықылдамаңыз!
Dialogue: 0,0:09:48.29,0:09:49.71,Default,,0,0,0,,Бұл менің жеңісім!
Dialogue: 0,0:09:49.79,0:09:53.30,Default,,0,0,0,,Ми... Минура-санға көмектесіңізші!
Dialogue: 0,0:09:53.38,0:09:56.55,Default,,0,0,0,,Мм, Ранпо-кунның кенет қуанған себебі...
Dialogue: 0,0:09:56.63,0:09:57.63,Default,,0,0,0,,Ум...
Dialogue: 0,0:09:57.72,0:10:00.39,Default,,0,0,0,,Полиция тым ерте келді
Dialogue: 0,0:10:00.47,0:10:04.52,Default,,0,0,0,,Біз жерге қарай жүгіргенімізде, бір уақытта полиция да келді.
Dialogue: 0,0:10:04.60,0:10:05.60,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:05.68,0:10:09.65,Default,,0,0,0,,Өйткені қылмыскер бұл туралы алдын ала хабарлаған.
Dialogue: 0,0:10:09.73,0:10:14.36,Default,,0,0,0,,Қалалық полиция оқиға орнын жауып, мәйітке қол тигізбеу үшін.
Dialogue: 0,0:10:14.44,0:10:19.36,Default,,0,0,0,,Сонда егеуқұйрықтар тобы өзін-өзі өлтірудің орнына оны үндемеуге итермеледі ме?
Dialogue: 0,0:10:19.45,0:10:20.78,Default,,0,0,0,,Екеуі де әртүрлі.
Dialogue: 0,0:10:20.87,0:10:22.03,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:10:22.12,0:10:24.49,Default,,0,0,0,,Бұл жәбірленушінің аяқ киімі.
Dialogue: 0,0:10:24.58,0:10:26.29,Default,,0,0,0,,Мен құлап бара жатқанда құлап қалды.
Dialogue: 0,0:10:26.91,0:10:30.17,Default,,0,0,0,,Мен оны терезеден көрдім, ол аяқ киім киіп алған.
Dialogue: 0,0:10:30.79,0:10:33.46,Default,,0,0,0,,Сіз оны сол сәтте байқадыңыз ба?
Dialogue: 0,0:10:33.54,0:10:37.51,Default,,0,0,0,,Табанының тозғанына қарағанда, бұл менің көп қолданылған сүйікті аяқ киімім.
Dialogue: 0,0:10:37.59,0:10:39.05,Default,,0,0,0,,Оңай шешілмейді
Dialogue: 0,0:10:39.13,0:10:41.59,Default,,0,0,0,,Бірақ ол неге ауада құлап кетті?
Dialogue: 0,0:10:42.30,0:10:44.81,Default,,0,0,0,,Түсіндім! (Минура) Эй, түсіндір!
Dialogue: 0,0:10:45.39,0:10:49.06,Default,,0,0,0,,Бұл аяқ киім өлген адамның сүйікті туфлиі емес.
Dialogue: 0,0:10:49.14,0:10:51.56,Default,,0,0,0,,Оны итеріп жіберер алдында ғана кигізді.
Dialogue: 0,0:10:52.27,0:10:56.53,Default,,0,0,0,,Себебі Ранпо-кун менің аяқ киімімнің іздерін біледі.
Dialogue: 0,0:10:57.28,0:10:59.49,Default,,0,0,0,,Мен мұнда Жасырын жоюшының анықтамалары үшін келдім.
Dialogue: 0,0:10:59.57,0:11:01.45,Default,,0,0,0,,Мен тасталған шахтадағы жасырынуға бардым.
Dialogue: 0,0:11:01.53,0:11:05.41,Default,,0,0,0,,Әрине, менің жердегі барлық аяқ киім ізі есімде.
Dialogue: 0,0:11:05.49,0:11:07.12,Default,,0,0,0,,Бұл аяқ киім үлгілері туралы не деуге болады?
Dialogue: 0,0:11:07.20,0:11:08.62,Default,,0,0,0,,Әрине болды
Dialogue: 0,0:11:08.70,0:11:11.71,Default,,0,0,0,,Сонымен, бұл бет жалған ба, әлде қармақ па?
Dialogue: 0,0:11:11.79,0:11:13.63,Default,,0,0,0,,Дұрыс (Минура) Иә?
Dialogue: 0,0:11:13.71,0:11:16.05,Default,,0,0,0,,Мәйіттің бетін алдын ала ұрып тастаңыз.
Dialogue: 0,0:11:16.13,0:11:19.92,Default,,0,0,0,,Түсіру үшін оның үстіне жалған бет қойыңыз.
Dialogue: 0,0:11:20.01,0:11:22.93,Default,,0,0,0,,Балық аулау жіпін жалған тұлғаның айналасына іліңіз.
Dialogue: 0,0:11:23.01,0:11:26.89,Default,,0,0,0,,Құлап жатқанда тек бет ұсталатындай етіп ұзындықты реттеңіз.
Dialogue: 0,0:11:33.60,0:11:35.31,Default,,0,0,0,,Егер ол жерге тиіп кетсе
Dialogue: 0,0:11:35.40,0:11:38.40,Default,,0,0,0,,Білмеймін, алдын ала бетін жаншып алды.
Dialogue: 0,0:11:38.48,0:11:39.86,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:11:39.94,0:11:43.49,Default,,0,0,0,,Жасырын жойғыштың өзі оны жасыру үшін түсірді.
Dialogue: 0,0:11:43.57,0:11:44.62,Default,,0,0,0,,Ниа, бізге тез арада мұндадан кету керек.
Dialogue: 0,0:11:44.70,0:11:48.70,Default,,0,0,0,,Енді қылмыскерді анықтадық, болды.
Dialogue: 0,0:11:49.20,0:11:51.54,Default,,0,0,0,,Ол құбыжық па?
Dialogue: 0,0:11:51.62,0:11:53.87,Default,,0,0,0,,Аукционда қашу қаражатын алу
Dialogue: 0,0:11:53.96,0:11:57.13,Default,,0,0,0,,Ал детективтік агенттік тартылған жағдай ұтымды жағдай болып табылады.
Dialogue: 0,0:11:57.21,0:11:59.38,Default,,0,0,0,,Тек аяқ киім тозғандықтан!
Dialogue: 0,0:11:59.46,0:12:03.05,Default,,0,0,0,,Тіпті бет-әлпетін жасыру қиын болды.
Dialogue: 0,0:12:03.13,0:12:05.14,Default,,0,0,0,,Бұл жағдай...
Dialogue: 0,0:12:05.80,0:12:07.56,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:12:07.64,0:12:09.85,Default,,0,0,0,,Барлығы ойлағандай болды!
Dialogue: 0,0:12:11.27,0:12:13.06,Default,,0,0,0,,Хэхе хехе...
Dialogue: 0,0:12:16.52,0:12:17.52,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:12:19.73,0:12:22.61,Default,,0,0,0,,Тіпті солтүстіктің шайтандары да қорқатын ерекше қабілеттер
Dialogue: 0,0:12:22.70,0:12:26.03,Default,,0,0,0,,Детектив, анықтаудың жетілмегендігін есте сақта!
Dialogue: 0,0:12:26.12,0:12:27.32,Default,,0,0,0,,Ерекше қабілет!
Dialogue: 0,0:12:48.72,0:12:50.51,Default,,0,0,0,,Міне, ақыры келді!
Dialogue: 0,0:12:50.60,0:12:53.68,Default,,0,0,0,,«Супер шегерім» шындықты әп-сәтте анықтайтын кез келді!
Dialogue: 0,0:12:54.48,0:12:56.40,Default,,0,0,0,,Сіз детективтің жанкүйерісіз бе?
Dialogue: 0,0:12:56.48,0:12:57.48,Default,,0,0,0,,Қарсылас!
Dialogue: 0,0:13:11.62,0:13:13.50,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:13:13.58,0:13:15.29,Default,,0,0,0,,О? Енді ше?
Dialogue: 0,0:13:20.34,0:13:22.42,Default,,0,0,0,,Мен ештеңе түсінбеймін
Dialogue: 0,0:13:23.71,0:13:25.01,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:13:25.63,0:13:27.72,Default,,0,0,0,,Детектив дүкені
Dialogue: 0,0:13:27.80,0:13:32.10,Default,,0,0,0,,Төменгі гиена, сен мені ешқашан ұстай алмайсың.
Dialogue: 0,0:13:32.18,0:13:37.81,Default,,0,0,0,,Өйткені менің ерекше қабілетім қылмыстың дәлелдерін өшіру қабілеті.
Dialogue: 0,0:13:37.90,0:13:42.02,Default,,0,0,0,,Аспан қақпалары жабылды, енді ешқашан ашылмайды.
Dialogue: 0,0:13:42.11,0:13:45.78,Default,,0,0,0,,Мен қателеспес детектив өлтірушімін
Dialogue: 0,0:13:45.86,0:13:48.41,Default,,0,0,0,,Қызметкерлерді жалған айыптаулардан тазарту мүмкін емес.
Dialogue: 0,0:13:49.32,0:13:50.37,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:13:50.99,0:13:54.54,Default,,0,0,0,,Федорды неліктен әдейі ұстағанын айт.
Dialogue: 0,0:13:54.62,0:13:57.33,Default,,0,0,0,,Сіз тіпті оларды сөйлете алмайсыз.
Dialogue: 0,0:14:24.36,0:14:27.32,Default,,0,0,0,,Танысқаныма қуаныштымын, Мушитаро-сан
Dialogue: 0,0:14:27.40,0:14:29.49,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:14:29.57,0:14:32.24,Default,,0,0,0,,Мен сені босатуға келгенмін.
Dialogue: 0,0:14:32.83,0:14:35.12,Default,,0,0,0,,Қылмыс белгілерін өшіру мүмкіндігі
Dialogue: 0,0:14:35.20,0:14:37.87,Default,,0,0,0,,Сол ғажайып қабілетпен ақша табу
Dialogue: 0,0:14:37.96,0:14:41.38,Default,,0,0,0,,Қылмыстық ұйым сізді тұтқынға алды.
Dialogue: 0,0:14:42.04,0:14:44.09,Default,,0,0,0,,Бүгінге дейін
Dialogue: 0,0:14:44.71,0:14:47.51,Default,,0,0,0,,Бостандық құны аз
Dialogue: 0,0:14:47.59,0:14:51.05,Default,,0,0,0,,Біздің операцияға бір-ақ рет қатысуыңызды қалаймыз.
Dialogue: 0,0:14:51.14,0:14:54.89,Default,,0,0,0,,Тиран мен шайтан болса, шайтанмен мәміле жаса
Dialogue: 0,0:14:54.97,0:14:56.72,Default,,0,0,0,,Бұл менің табиғатым
Dialogue: 0,0:14:57.39,0:14:59.35,Default,,0,0,0,,Мен мінген оқиға
Dialogue: 0,0:15:00.94,0:15:03.15,Default,,0,0,0,,Бірақ шарттар бар.
Dialogue: 0,0:15:03.23,0:15:07.53,Default,,0,0,0,,Бір нәрсе: мен сахнаға шықпаймын.
Dialogue: 0,0:15:07.61,0:15:09.70,Default,,0,0,0,,Тек басқа қабілетті пайдаланыңыз.
Dialogue: 0,0:15:09.78,0:15:13.78,Default,,0,0,0,,Бір нәрсе: кеңсе үстелін дайындаңыз.
Dialogue: 0,0:15:13.87,0:15:17.45,Default,,0,0,0,,Егер сізде оккульттік ғылым мен ежелгі алхимия кітапханасы болса, одан да жақсы.
Dialogue: 0,0:15:17.54,0:15:21.25,Default,,0,0,0,,Бір ыдыс – күміс немесе ақ фарфор
Dialogue: 0,0:15:21.33,0:15:24.17,Default,,0,0,0,,Киіміңізде әрқашан желім болсын
Dialogue: 0,0:15:24.25,0:15:27.21,Default,,0,0,0,,Бұл жақсы. Тағы бірдеме?
Dialogue: 0,0:15:27.30,0:15:30.76,Default,,0,0,0,,Иә, бұл ең маңыздысы
Dialogue: 0,0:15:30.84,0:15:34.26,Default,,0,0,0,,Операциядан кейін мен ұйымнан қашып кеттім.
Dialogue: 0,0:15:34.35,0:15:36.51,Default,,0,0,0,,Шетелге ұшу мүмкіндігі болуы керек
Dialogue: 0,0:15:36.60,0:15:39.60,Default,,0,0,0,,Алайда операциядан кейін бір аптадан кейін
Dialogue: 0,0:15:39.68,0:15:43.44,Default,,0,0,0,,Бір апта? Бір күндік келісімдер де мүмкін.
Dialogue: 0,0:15:43.90,0:15:45.98,Default,,0,0,0,,Аяқталмаған іс
Dialogue: 0,0:15:46.07,0:15:48.53,Default,,0,0,0,,Өлім мен күнә туралы уәде
Dialogue: 0,0:15:48.61,0:15:51.07,Default,,0,0,0,,Сол бір аптада
Dialogue: 0,0:15:51.15,0:15:53.78,Default,,0,0,0,,Мына қолдары бар адам
Dialogue: 0,0:15:53.86,0:15:56.20,Default,,0,0,0,,Дегенмен, егер Аномальды Титанға жолығып қалсақ, керемет болар еді…
Dialogue: 0,0:15:57.62,0:15:59.66,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:16:09.55,0:16:14.43,Default,,0,0,0,,Ранпо-кун мәйітті көрген соң үндемеді.
Dialogue: 0,0:16:14.51,0:16:19.22,Default,,0,0,0,,Әй, әдетте мен қатты күліп, кінәліге нұсқайтын едім.
Dialogue: 0,0:16:19.31,0:16:20.98,Default,,0,0,0,,Ранпо-кун үшін
Dialogue: 0,0:16:21.06,0:16:23.77,Default,,0,0,0,,Сіздің детективті болмысыңыз – жан дүниеңіздің тірегі
Dialogue: 0,0:16:23.85,0:16:26.19,Default,,0,0,0,,Егер ол сынған болса ше?
Dialogue: 0,0:16:26.27,0:16:28.57,Default,,0,0,0,,Ешқашан қалпына келмеу мүмкіндігі бар...
Dialogue: 0,0:16:31.78,0:16:33.57,Default,,0,0,0,,Ранпо-кун, уайымдама...
Dialogue: 0,0:16:33.65,0:16:34.66,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:35.11,0:16:36.45,Default,,0,0,0,,Берейік!
Dialogue: 0,0:16:36.53,0:16:37.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:37.45,0:16:40.87,Default,,0,0,0,,Олай болса, мен компанияға қайтайын, рахмет.
Dialogue: 0,0:16:41.62,0:16:43.58,Default,,0,0,0,,Ранпо-кун?
Dialogue: 0,0:16:43.66,0:16:45.58,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:16:45.67,0:16:47.84,Default,,0,0,0,,Менің жеңісім анық
Dialogue: 0,0:16:47.92,0:16:52.84,Default,,0,0,0,,Детективтердің мендегі суреті мен ұйымдағы бетімді өзгерткенге дейінгі сурет.
Dialogue: 0,0:16:52.92,0:16:56.09,Default,,0,0,0,,Басқаша айтқанда, маған қарасаң да, мені танымайсың.
Dialogue: 0,0:16:56.18,0:16:59.76,Default,,0,0,0,,Кісі өлтіру кішкентай саусағыңызды бүгу сияқты оңай
Dialogue: 0,0:17:00.64,0:17:04.77,Default,,0,0,0,,Мен оны өткен күні өлтіргенімде...
Dialogue: 0,0:17:04.85,0:17:07.48,Default,,0,0,0,,Муши-кун, мен.
Dialogue: 0,0:17:08.02,0:17:10.52,Default,,0,0,0,,Соңғы жұмбақты жазғым келеді.
Dialogue: 0,0:17:10.61,0:17:12.23,Default,,0,0,0,,(Мушитароның күлкісі)
Dialogue: 0,0:17:17.74,0:17:20.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:21.74,0:17:22.75,Default,,0,0,0,,Сол кезде мен өзімді жеңілген адам ретінде өмір сүруді бастадым.
Dialogue: 0,0:17:23.75,0:17:25.75,Default,,0,0,0,,Тізерлеп отырыңыз, детектив!
Dialogue: 0,0:17:25.83,0:17:27.42,Default,,0,0,0,,Мен қылмыстың патшасымын!
Dialogue: 0,0:17:27.50,0:17:32.21,Default,,0,0,0,,Мені ешкім күнә жасап, тәубеге келтіре алмайды!
Dialogue: 0,0:17:32.30,0:17:33.88,Default,,0,0,0,,Эй, жақсысың ба? (Мушитаро) Уау!
Dialogue: 0,0:17:35.88,0:17:38.26,Default,,0,0,0,,Детектив мекемесі? Неге мұнда...
Dialogue: 0,0:17:38.34,0:17:40.60,Default,,0,0,0,,Сіз байқадыңыз ба? Мүмкін емес
Dialogue: 0,0:17:40.68,0:17:43.18,Default,,0,0,0,,Сіз такси тұрағы қай жерде екенін білмейсіз бе?
Dialogue: 0,0:17:43.27,0:17:44.98,Default,,0,0,0,,ше? такси?
Dialogue: 0,0:17:45.06,0:17:49.02,Default,,0,0,0,,Мен таксиге отырып кеңсеге қайтуды ойладым.
Dialogue: 0,0:17:49.10,0:17:51.44,Default,,0,0,0,,Оқиғаға байланысты басты көше жабылды.
Dialogue: 0,0:17:51.98,0:17:55.94,Default,,0,0,0,,Сондықтан мен осы аллеядан такси іздеймін деп ойладым.
Dialogue: 0,0:17:56.03,0:17:58.11,Default,,0,0,0,,Мен сөйлесетін жалғыз адам сенсің
Dialogue: 0,0:17:58.57,0:18:02.20,Default,,0,0,0,,Мына кісі мені танымай ма?
Dialogue: 0,0:18:02.28,0:18:07.16,Default,,0,0,0,,Үлкен көше жабық екені рас, сондықтан такси табудың жалғыз жолы осы.
Dialogue: 0,0:18:07.25,0:18:09.63,Default,,0,0,0,,Қандай күлкілі!
Dialogue: 0,0:18:09.71,0:18:11.79,Default,,0,0,0,,Детектив істі тастап, үйіне қайтып бара жатыр
Dialogue: 0,0:18:11.88,0:18:14.71,Default,,0,0,0,,Қарастырылып отырған қылмыскермен сөйлесу!
Dialogue: 0,0:18:15.17,0:18:18.13,Default,,0,0,0,,Өкінішке орай, қай жерге отырарымды білмеймін.
Dialogue: 0,0:18:18.22,0:18:20.93,Default,,0,0,0,,Хмм, онда жоқ, мен осында күтемін.
Dialogue: 0,0:18:21.01,0:18:22.68,Default,,0,0,0,,Сен қалсаң!?
Dialogue: 0,0:18:22.76,0:18:24.93,Default,,0,0,0,,Бұл қашқынмен кездесу орны.
Dialogue: 0,0:18:25.02,0:18:28.44,Default,,0,0,0,,Осы жылдамдықпен бұл жігіт сіздің көлігіңізді көре алады.
Dialogue: 0,0:18:28.52,0:18:32.86,Default,,0,0,0,,Мінсіз қашу уайымның ізін қалдырмауы керек.
Dialogue: 0,0:18:32.94,0:18:36.24,Default,,0,0,0,,5 минуттық жерде вокзал бар. Картаны сызайық.
Dialogue: 0,0:18:36.32,0:18:38.20,Default,,0,0,0,,Жоқ! Жаяу жүрудің өзі азап
Dialogue: 0,0:18:38.28,0:18:39.91,Default,,0,0,0,,Жиііііііі!
Dialogue: 0,0:18:39.99,0:18:41.49,Default,,0,0,0,,Олай болса мұны істейік
Dialogue: 0,0:18:41.57,0:18:44.62,Default,,0,0,0,,Жақын жерде сізді вокзалға апаратын аялдама бар.
Dialogue: 0,0:18:44.70,0:18:45.70,Default,,0,0,0,,Егер сіз оны мінсеңіз...
Dialogue: 0,0:18:45.79,0:18:48.21,Default,,0,0,0,,Автобустар мен пойыздар - бұл әбігер!
Dialogue: 0,0:18:48.29,0:18:50.79,Default,,0,0,0,,Негізі мен пойызда жүруді білмеймін.
Dialogue: 0,0:18:50.87,0:18:52.58,Default,,0,0,0,,Бастауыш сынып оқушылары!
Dialogue: 0,0:18:52.67,0:18:53.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:53.96,0:18:57.01,Default,,0,0,0,,Менің жаяу жүруім қиынға соғады, маған сіздің арқаңызға мінуге рұқсат етіңіз.
Dialogue: 0,0:18:57.09,0:18:59.72,Default,,0,0,0,,Бұл адамдарға жасалған өтініш емес.
Dialogue: 0,0:18:59.80,0:19:02.22,Default,,0,0,0,,Мен мұны компаниядағы жаңа қызметкерлерге бірнеше рет жасадым.
Dialogue: 0,0:19:02.30,0:19:05.01,Default,,0,0,0,,Мен ешкіммен араласпау керек адаммын.
Dialogue: 0,0:19:05.10,0:19:07.47,Default,,0,0,0,,Сіз қатыстыңыз ба?
Dialogue: 0,0:19:12.69,0:19:15.15,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:19:15.23,0:19:16.23,Default,,0,0,0,,Ах
Dialogue: 0,0:19:17.23,0:19:19.74,Default,,0,0,0,,Күткеніңізге рахмет, Мушитаро мырза.
Dialogue: 0,0:19:19.82,0:19:22.07,Default,,0,0,0,,Келдіңіз бе?
Dialogue: 0,0:19:22.16,0:19:26.83,Default,,0,0,0,,Кешіріңіз, бірақ менің іскер серіктесім осында. Кешіріңіз.
Dialogue: 0,0:19:26.91,0:19:29.41,Default,,0,0,0,,Ерм... (Ранпо) Ранпо
Dialogue: 0,0:19:29.50,0:19:32.21,Default,,0,0,0,,Олай болса, Ранпо-кун, мен саған сәттілік тілеймін.
Dialogue: 0,0:19:39.63,0:19:43.47,Default,,0,0,0,,Менің көлігімді біреу көрді ме? Жарайды.
Dialogue: 0,0:19:44.47,0:19:45.97,Default,,0,0,0,,Бұл үлкен мәселе емес...
Dialogue: 0,0:19:44.97,0:19:46.05,Default,,0,0,0,,Жүргізуші, детективке барыңыз!
Dialogue: 0,0:19:46.05,0:19:47.06,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:46.05,0:19:47.06,Default,,0,0,0,,Жүргізуші, детективке барыңыз!
Dialogue: 0,0:19:47.14,0:19:49.02,Default,,0,0,0,,На на на на… (Ранпо) Жақсысың ба?
Dialogue: 0,0:19:49.10,0:19:52.35,Default,,0,0,0,,Сіз не істеп жатырсыз? Бұл менің жеке көлігім!
Dialogue: 0,0:19:52.44,0:19:55.11,Default,,0,0,0,,Ыстық, солай емес пе? Кондиционерді қосыңыз.
Dialogue: 0,0:19:55.19,0:19:56.15,Default,,0,0,0,,бұл бұлыңғыр кадрлардан оны анықтау қиын болар еді.
Dialogue: 0,0:19:56.23,0:19:57.61,Default,,0,0,0,,Жақсы идея бар
Dialogue: 0,0:19:57.69,0:20:00.99,Default,,0,0,0,,Маған мінгізсең, мен жауап беремін.
Dialogue: 0,0:20:01.07,0:20:03.86,Default,,0,0,0,,Жұмыс таба алмай қиналсаңыз, біз сізді жұмыспен таныстырамыз.
Dialogue: 0,0:20:03.95,0:20:05.12,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:20:06.07,0:20:08.33,Default,,0,0,0,,Жарайды... уф!
Dialogue: 0,0:20:09.66,0:20:13.62,Default,,0,0,0,,Оны да қуып шығудан басқа амалым жоқ! Бірақ...
Dialogue: 0,0:20:13.71,0:20:18.59,Default,,0,0,0,,Менімен жолығу бақыты бұйырған детективтің одан әрі күдіктенуіне жол бере алмаймын.
Dialogue: 0,0:20:19.21,0:20:23.84,Default,,0,0,0,,Оны вокзалға апарыңыз, мен оған такси апарамын.
Dialogue: 0,0:20:23.93,0:20:25.05,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:20:29.01,0:20:31.68,Default,,0,0,0,,Айтпақшы, сен онда не істеп жүрсің?
Dialogue: 0,0:20:31.77,0:20:33.60,Default,,0,0,0,,Сіз детективсіз бе?
Dialogue: 0,0:20:35.65,0:20:38.94,Default,,0,0,0,,Түсіндім, бұл қанды оқиға.
Dialogue: 0,0:20:39.02,0:20:41.99,Default,,0,0,0,,Менен алыс дүние.
Dialogue: 0,0:20:42.07,0:20:44.20,Default,,0,0,0,,Кінәліге бір ғана белгі бар.
Dialogue: 0,0:20:44.28,0:20:48.99,Default,,0,0,0,,Қылмыскер жәбірленушімен аяқ киім ауыстырған, сондықтан қазір қылмыскерде кішкентай аяқ киім бар.
Dialogue: 0,0:20:50.87,0:20:53.79,Default,,0,0,0,,Мен бұл жағдайды түсіну неге қиын екенін түсінемін.
Dialogue: 0,0:20:53.87,0:20:57.17,Default,,0,0,0,,Өйткені кінәлі – шындықты иілу қабілеті бар адам.
Dialogue: 0,0:20:57.25,0:20:59.50,Default,,0,0,0,,Бұл жігіт қазірдің өзінде алыс...
Dialogue: 0,0:20:59.59,0:21:02.05,Default,,0,0,0,,Менің пайымдауым – бұл әдістеме.
Dialogue: 0,0:21:02.13,0:21:06.22,Default,,0,0,0,,Бұл табиғаттан тыс қабілет болмағандықтан, ол шындықты өзгертуге сәйкес келмейді.
Dialogue: 0,0:21:06.30,0:21:08.14,Default,,0,0,0,,Хмф, дұрыс.
Dialogue: 0,0:21:08.22,0:21:11.26,Default,,0,0,0,,Міне, мен оны осы жолы шеше алдым.
Dialogue: 0,0:21:11.35,0:21:13.02,Default,,0,0,0,,Жоқ! Мүмкін емес!
Dialogue: 0,0:21:14.14,0:21:15.64,Default,,0,0,0,,Сізді қызықтырады ма?
Dialogue: 0,0:21:15.73,0:21:18.61,Default,,0,0,0,,Бұл өте қызықты ойын-сауық.
Dialogue: 0,0:21:18.69,0:21:23.24,Default,,0,0,0,,Мен кездейсоқ кездестірген детективтен кісі өлтіру құпиясының шешімін тыңдау.
Dialogue: 0,0:21:23.32,0:21:26.28,Default,,0,0,0,,Олай болса, көліктегі сыпайылық туралы арнайы сабақ өтейік.
Dialogue: 0,0:21:26.82,0:21:29.24,Default,,0,0,0,,Кілт қызыл конверт
Dialogue: 0,0:21:29.32,0:21:32.79,Default,,0,0,0,,Ол мені өлді деп ойлағанымды қалады.
Dialogue: 0,0:21:32.87,0:21:36.58,Default,,0,0,0,,Сондықтан мен досым Поға көзім түсті.
Dialogue: 0,0:21:36.67,0:21:39.08,Default,,0,0,0,,Оның қолжазбаны сатып алғанына көз жеткізіңіз
Dialogue: 0,0:21:39.17,0:21:42.71,Default,,0,0,0,,Конвертті алған сәт
Dialogue: 0,0:21:42.80,0:21:45.42,Default,,0,0,0,,Ауыстырушы төмен итерілді
Dialogue: 0,0:21:45.51,0:21:48.89,Default,,0,0,0,,Барлығы сізге сол сәтті көрсету үшін
Dialogue: 0,0:21:50.22,0:21:52.35,Default,,0,0,0,,Енді кінәлі
Dialogue: 0,0:21:52.43,0:21:56.98,Default,,0,0,0,,Конвертті қайдан алдың... қолжазбаны?
Dialogue: 0,0:21:57.06,0:21:59.35,Default,,0,0,0,,Жауабы қарапайым
Dialogue: 0,0:21:59.44,0:22:01.36,Default,,0,0,0,,Оны өлтіріп, ұрлап кетті.
Dialogue: 0,0:22:02.36,0:22:04.65,Default,,0,0,0,,Автордың өзінен.
Dialogue: 0,0:23:33.66,0:23:38.66,Default,,0,0,0,,~♪
Dialogue: 0,0:23:40.16,0:23:46.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory