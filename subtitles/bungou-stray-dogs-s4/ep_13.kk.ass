Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:04.87,Default,,0,0,0,,Оны тапқан бойда шабуыл жасаңыз.
Dialogue: 0,0:00:04.96,0:00:09.46,Default,,0,0,0,,Осы екеуіне шабуыл жасаған адам казиноның қарызын алып тастайды.
Dialogue: 0,0:00:10.13,0:00:11.67,Default,,0,0,0,,Егер жарақат алса, $10 000
Dialogue: 0,0:00:12.22,0:00:14.18,Default,,0,0,0,,1 миллион доллар, егер мені өлтірсең.
Dialogue: 0,0:00:14.97,0:00:15.80,Default,,0,0,0,,Ha
Dialogue: 0,0:00:16.55,0:00:18.14,Default,,0,0,0,,Балалар
Dialogue: 0,0:00:18.89,0:00:20.68,Default,,0,0,0,,Сен сонша өлгің келе ме?
Dialogue: 0,0:00:21.31,0:00:23.69,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:00:23.77,0:00:28.77,Default,,0,0,0,,♪~
Dialogue: 0,0:01:48.73,0:01:53.73,Default,,0,0,0,,~♪
Dialogue: 0,0:01:54.53,0:01:56.11,Default,,0,0,0,,Тачихара (Тачихара) Иә!
Dialogue: 0,0:01:56.19,0:01:59.86,Default,,0,0,0,,Біз, полиция, қандай жағдай болса да азаматтарға зиян тигізбейміз.
Dialogue: 0,0:01:59.95,0:02:02.33,Default,,0,0,0,,және мақсатқа жету
Dialogue: 0,0:02:02.41,0:02:03.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:05.12,0:02:05.95,Default,,0,0,0,,Аһ!
Dialogue: 0,0:02:06.04,0:02:07.08,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:02:15.34,0:02:16.88,Default,,0,0,0,,Сәлем әже
Dialogue: 0,0:02:16.97,0:02:18.26,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:02:18.34,0:02:19.68,Default,,0,0,0,,Екі адам келген шығар.
Dialogue: 0,0:02:19.76,0:02:21.30,Default,,0,0,0,,О?
Dialogue: 0,0:02:21.39,0:02:23.05,Default,,0,0,0,,Сәлем! (Ер тұтынушылар) Иә?
Dialogue: 0,0:02:23.51,0:02:24.35,Default,,0,0,0,,Мына жігітке қараңдаршы
Dialogue: 0,0:02:26.64,0:02:28.48,Default,,0,0,0,,Сіз төменге жүгірдіңіз бе?
Dialogue: 0,0:02:28.56,0:02:30.44,Default,,0,0,0,,Асығыңыз! Бұл жігіттер төменгі сыныптағылар.
Dialogue: 0,0:02:31.31,0:02:32.61,Default,,0,0,0,,Қол астындағыларға хабарлаңыз.
Dialogue: 0,0:02:32.69,0:02:33.82,Default,,0,0,0,,О!
Dialogue: 0,0:02:35.40,0:02:37.24,Default,,0,0,0,,Жау түбінде!
Dialogue: 0,0:02:37.32,0:02:39.45,Default,,0,0,0,,Жүлде менікі!
Dialogue: 0,0:02:40.45,0:02:41.91,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:02:47.37,0:02:50.75,Default,,0,0,0,,Не? Әже, бұл тыйым салынған аймақ.
Dialogue: 0,0:02:50.83,0:02:53.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:53.54,0:02:55.71,Default,,0,0,0,,Кешкі асқа қайнатылған камбала бар ма?
Dialogue: 0,0:02:55.80,0:02:58.46,Default,,0,0,0,,Неліктен мұндай төмен деңгейге жеттіңіз?
Dialogue: 0,0:02:58.55,0:03:01.05,Default,,0,0,0,,О, не болып жатыр?
Dialogue: 0,0:03:01.80,0:03:04.60,Default,,0,0,0,,А, есімде.
Dialogue: 0,0:03:04.68,0:03:06.68,Default,,0,0,0,,Менің есімде!
Dialogue: 0,0:03:07.77,0:03:08.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:12.35,0:03:15.48,Default,,0,0,0,,Мен бір қылмыскерді ұру үшін келдім.
Dialogue: 0,0:03:15.57,0:03:16.86,Default,,0,0,0,,Умм
Dialogue: 0,0:03:18.74,0:03:20.49,Default,,0,0,0,,Мен қазір кете аламын ба?
Dialogue: 0,0:03:20.57,0:03:22.53,Default,,0,0,0,,Какакака!
Dialogue: 0,0:03:22.61,0:03:25.87,Default,,0,0,0,,Осы жолмен келесі жәрдемақы кешіне қатысыңыз.
Dialogue: 0,0:03:25.95,0:03:27.70,Default,,0,0,0,,Маған демалыс беріңізші!
Dialogue: 0,0:03:29.00,0:03:30.91,Default,,0,0,0,,Мен, Джоэстар, бұл жақсылықты ешқашан ұмытпаймын
Dialogue: 0,0:03:31.00,0:03:34.33,Default,,0,0,0,,Менің табиғаттан тыс күшім – жасымды басқару қабілеті.
Dialogue: 0,0:03:34.42,0:03:37.92,Default,,0,0,0,,Енді саңырау болмас бұрын тыңдаңыз
Dialogue: 0,0:03:38.00,0:03:41.97,Default,,0,0,0,,Алда тұрған орталық байланыс терминалын қалай бақылауға аламыз?
Dialogue: 0,0:03:42.05,0:03:45.35,Default,,0,0,0,,Уайымдама, мен сені өлтірмеймін
Dialogue: 0,0:03:45.43,0:03:49.10,Default,,0,0,0,,Буындарым қатты ауырса тоқтаймын.
Dialogue: 0,0:03:49.18,0:03:53.14,Default,,0,0,0,,Бұл иттің ең қорқынышты табиғаттан тыс қабілеті.
Dialogue: 0,0:03:53.23,0:03:56.69,Default,,0,0,0,,Масуараоның да денесі мен ойы болаттай.
Dialogue: 0,0:03:56.77,0:04:00.40,Default,,0,0,0,,Қартаю мен инфантилизация азаптарына шыдай алмаймын.
Dialogue: 0,0:04:00.49,0:04:02.65,Default,,0,0,0,,Бұл не екенін білесің бе?
Dialogue: 0,0:04:02.74,0:04:05.62,Default,,0,0,0,,Терминалды басқару бұл...
Dialogue: 0,0:04:05.70,0:04:10.62,Default,,0,0,0,,Жалғыз нұсқа - оны менеджер кілтімен қайта іске қосу...
Dialogue: 0,0:04:12.79,0:04:13.79,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:15.12,0:04:18.04,Default,,0,0,0,,Жақында қауіпсіздік те болады.
Dialogue: 0,0:04:18.13,0:04:20.67,Default,,0,0,0,,Осы жерден тоқтату керек.
Dialogue: 0,0:04:20.76,0:04:21.71,Default,,0,0,0,,Акико ше?
Dialogue: 0,0:04:24.09,0:04:26.22,Default,,0,0,0,,Патшаның басын алыңыз
Dialogue: 0,0:04:26.30,0:04:29.22,Default,,0,0,0,,Сигма күштірек пе, өйткені оның есте сақтау қабілеті жоқ па?
Dialogue: 0,0:04:29.31,0:04:32.68,Default,,0,0,0,,Бұл жағдайда сіз жиі баратын дүкендегі даяшы әйел ең жақсысы.
Dialogue: 0,0:04:32.77,0:04:35.65,Default,,0,0,0,,менің тапсырысымды үнемі ұмытады
Dialogue: 0,0:04:35.73,0:04:38.40,Default,,0,0,0,,Сигманың шешімі қаншалықты терең болса да,
Dialogue: 0,0:04:38.48,0:04:41.57,Default,,0,0,0,,Күйі аңшы иттікінен тым бөлек.
Dialogue: 0,0:04:41.65,0:04:43.03,Default,,0,0,0,,Іс?
Dialogue: 0,0:04:43.11,0:04:46.57,Default,,0,0,0,,Сабаққа келетін болсақ, бұл жай ит емес.
Dialogue: 0,0:04:46.66,0:04:51.04,Default,,0,0,0,,Тіпті сен де, мен де Сигмадан төменміз.
Dialogue: 0,0:04:51.12,0:04:55.33,Default,,0,0,0,,Мұң музыкасы Сигманың қанында өтеді.
Dialogue: 0,0:04:55.42,0:04:58.04,Default,,0,0,0,,Ол – түпкілікті шетелдік
Dialogue: 0,0:04:58.13,0:05:02.46,Default,,0,0,0,,Ол үшін Sky Casino өзімен бірдей жалғыз нәрсе.
Dialogue: 0,0:05:02.55,0:05:04.47,Default,,0,0,0,,Сондықтан мен оны жоғалтып алмаймын.
Dialogue: 0,0:05:04.55,0:05:05.97,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:06.05,0:05:09.22,Default,,0,0,0,,Иә, Sigma 3 жыл бұрын
Dialogue: 0,0:05:09.30,0:05:12.47,Default,,0,0,0,,Кітапқа жазу арқылы жасалған
Dialogue: 0,0:05:12.56,0:05:14.73,Default,,0,0,0,,Кенеттен жоқтан
Dialogue: 0,0:05:14.81,0:05:15.81,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:05:16.60,0:05:19.73,Default,,0,0,0,,Осындай нәрсені шынымен адам деп атауға бола ма?
Dialogue: 0,0:05:22.61,0:05:25.03,Default,,0,0,0,,Үй алғыңыз келмейді ме?
Dialogue: 0,0:05:25.90,0:05:28.91,Default,,0,0,0,,Ол өзіне ат қойды
Dialogue: 0,0:05:28.99,0:05:30.03,Default,,0,0,0,,«Сигма»
Dialogue: 0,0:05:30.83,0:05:33.62,Default,,0,0,0,,Ол ақыры үйіне баратын орынды тапты.
Dialogue: 0,0:05:33.70,0:05:35.50,Default,,0,0,0,,Тек Tenku казиносы
Dialogue: 0,0:05:36.66,0:05:39.21,Default,,0,0,0,,Қайырлы күн, менеджер мырза.
Dialogue: 0,0:05:39.29,0:05:41.88,Default,,0,0,0,,Сіз берілуге ​​дайынсыз ба?
Dialogue: 0,0:05:43.25,0:05:45.38,Default,,0,0,0,,Орындалмады
Dialogue: 0,0:05:45.47,0:05:46.92,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:05:47.01,0:05:49.47,Default,,0,0,0,,Көп күтпеңіз
Dialogue: 0,0:05:49.55,0:05:53.14,Default,,0,0,0,,Өйткені, біз ол жерде байланыс құралдарын жоймақпыз.
Dialogue: 0,0:05:53.22,0:05:55.89,Default,,0,0,0,,Біз әлемді құтқаруымыз керек
Dialogue: 0,0:05:55.98,0:05:58.90,Default,,0,0,0,,Бұл құрылғы жай ғана терминал.
Dialogue: 0,0:05:58.98,0:06:01.36,Default,,0,0,0,,Басқару элементін осы перне арқылы ауыстырмасаңыз
Dialogue: 0,0:06:01.44,0:06:03.86,Default,,0,0,0,,Детонация сигналын тоқтату мүмкін емес
Dialogue: 0,0:06:03.94,0:06:06.99,Default,,0,0,0,,Өйткені, таңдау жоқ.
Dialogue: 0,0:06:07.49,0:06:10.37,Default,,0,0,0,,Мені қате түсінбе, мен саған кілтті беремін.
Dialogue: 0,0:06:12.70,0:06:14.37,Default,,0,0,0,,Сізге шындықты айту үшін
Dialogue: 0,0:06:14.45,0:06:16.95,Default,,0,0,0,,Дәл қазір жылап, қашып кеткім келді.
Dialogue: 0,0:06:17.62,0:06:20.63,Default,,0,0,0,,Бірақ егер біз иттерді тоқтатпасақ, казино бұзылады.
Dialogue: 0,0:06:21.58,0:06:24.09,Default,,0,0,0,,Жау – Жапониядағы ең күшті арнайы жасақ.
Dialogue: 0,0:06:24.55,0:06:27.05,Default,,0,0,0,,Мен қарапайым адаммын
Dialogue: 0,0:06:27.51,0:06:28.34,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:06:31.43,0:06:32.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:32.35,0:06:33.51,Default,,0,0,0,,Салво!
Dialogue: 0,0:06:34.18,0:06:35.85,Default,,0,0,0,,Сіз міндетті түрде жеңесіз!
Dialogue: 0,0:06:38.81,0:06:41.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:43.19,0:06:44.02,Default,,0,0,0,,Ах
Dialogue: 0,0:06:44.11,0:06:45.53,Default,,0,0,0,,Киока-чан!
Dialogue: 0,0:06:46.44,0:06:48.19,Default,,0,0,0,,Төменнен шайқас дыбыстары
Dialogue: 0,0:06:48.28,0:06:50.61,Default,,0,0,0,,Бұл басталды. Бұл ит болуы керек.
Dialogue: 0,0:06:51.41,0:06:53.49,Default,,0,0,0,,Күтілгеннен әлдеқайда жылдам
Dialogue: 0,0:06:53.57,0:06:57.12,Default,,0,0,0,,Тезірек шайқасқа қосылмасақ, Дазай-санның жоспары...
Dialogue: 0,0:06:57.20,0:06:58.75,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:07:01.08,0:07:02.17,Default,,0,0,0,,Тырнақтарыңыз болса
Dialogue: 0,0:07:02.25,0:07:04.38,Default,,0,0,0,,Сыртқы қабырға бойымен төменгі қабатқа дейін бару керек.
Dialogue: 0,0:07:05.59,0:07:06.75,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:07:07.21,0:07:08.88,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:07:15.64,0:07:17.81,Default,,0,0,0,,Ақымақ! Сіз оны жалаң қолыңызбен ойнайсыз ба?
Dialogue: 0,0:07:18.60,0:07:22.52,Default,,0,0,0,,Жоқ, иттің денесі қанша көп болса да, ол онша ұзаққа бармайды.
Dialogue: 0,0:07:23.60,0:07:24.61,Default,,0,0,0,,Tsk
Dialogue: 0,0:07:28.15,0:07:29.24,Default,,0,0,0,,Не!?
Dialogue: 0,0:07:30.03,0:07:32.78,Default,,0,0,0,,Ас пісіретін пышақ? Сіз оны ас үйден ұрладыңыз ба?
Dialogue: 0,0:07:33.66,0:07:34.49,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:34.57,0:07:37.29,Default,,0,0,0,,Әлі жоқ! Жаңа мұнараны іске қоссаңыз...
Dialogue: 0,0:07:39.70,0:07:41.00,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:07:41.08,0:07:44.21,Default,,0,0,0,,Басынан бастап жеңіске жету мүмкіндігіңіз жоқ.
Dialogue: 0,0:07:44.88,0:07:46.59,Default,,0,0,0,,That's right.
Dialogue: 0,0:07:46.67,0:07:50.21,Default,,0,0,0,,Расында да, өздеріңіз көріп отырғандай, мен осындай дәрежедегі адаммын.
Dialogue: 0,0:07:50.72,0:07:51.55,Default,,0,0,0,,Бірақ
Dialogue: 0,0:07:51.63,0:07:53.93,Default,,0,0,0,,Осы уақытқа дейін бәрі жоспарланғандай болды!
Dialogue: 0,0:07:54.47,0:07:55.68,Default,,0,0,0,,Бағытталған резонанстық зеңбірек
Dialogue: 0,0:07:56.14,0:07:57.14,Default,,0,0,0,,Арх! (Йоко) Ах!
Dialogue: 0,0:07:57.89,0:07:59.10,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:07:59.18,0:08:01.23,Default,,0,0,0,,Ггаааах!
Dialogue: 0,0:08:01.31,0:08:03.64,Default,,0,0,0,,Бір саусағыңызды қозғалта алмайсыз, солай ма?
Dialogue: 0,0:08:03.73,0:08:05.27,Default,,0,0,0,,Құлаққа түсетін дыбыстық толқындар
Dialogue: 0,0:08:05.35,0:08:08.48,Default,,0,0,0,,Бұл мида көбік резонансын тудыратындықтан.
Dialogue: 0,0:08:08.57,0:08:11.65,Default,,0,0,0,,Сонымен қатар, бұл бес есе өнімділігі бар өзгертілген мылтық.
Dialogue: 0,0:08:11.74,0:08:14.03,Default,,0,0,0,,Сіз бұл итті көрдіңіз бе?
Dialogue: 0,0:08:14.91,0:08:17.74,Default,,0,0,0,,Осы жағдайға әкелген барлық нәрсе – «ойдың күші»!
Dialogue: 0,0:08:20.91,0:08:24.04,Default,,0,0,0,,Ақымақ! неге тұр
Dialogue: 0,0:08:24.12,0:08:25.25,Default,,0,0,0,,Тіпті ит
Dialogue: 0,0:08:26.08,0:08:28.38,Default,,0,0,0,,Бұл миыңызды қыруға жеткілікті.
Dialogue: 0,0:08:28.46,0:08:30.30,Default,,0,0,0,,Ойдың күші ме?
Dialogue: 0,0:08:30.38,0:08:31.21,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:31.67,0:08:34.68,Default,,0,0,0,,Олай болса, себебін сұраймын.
Dialogue: 0,0:08:34.76,0:08:37.35,Default,,0,0,0,,Ойдың күші сонда
Dialogue: 0,0:08:37.43,0:08:38.39,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:39.26,0:08:41.02,Default,,0,0,0,,Жалғыз болсаңыз
Dialogue: 0,0:08:41.10,0:08:42.02,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:42.52,0:08:44.10,Default,,0,0,0,,Мына жігіттің құлағы жара
Dialogue: 0,0:08:44.64,0:08:46.85,Default,,0,0,0,,Мен құлаған сәтте,
Dialogue: 0,0:08:46.94,0:08:48.98,Default,,0,0,0,,Құлақ арнаңызды ойып алыңыз
Dialogue: 0,0:08:49.07,0:08:51.48,Default,,0,0,0,,Дыбыс толқындарының басып кіруіне тосқауыл қойдыңыз ба?
Dialogue: 0,0:08:51.57,0:08:54.32,Default,,0,0,0,,Мен сендерге бір қызық оқиғаны айтып беремін.
Dialogue: 0,0:08:54.99,0:08:57.20,Default,,0,0,0,,Иттің өте физикалық қабілеті
Dialogue: 0,0:08:57.28,0:09:00.49,Default,,0,0,0,,Бұл табиғаттан тыс инженердің денені өзгертуінің нәтижесі.
Dialogue: 0,0:09:00.58,0:09:02.45,Default,,0,0,0,,Дегенмен, адам емес хирургия
Dialogue: 0,0:09:02.54,0:09:06.29,Default,,0,0,0,,Егер сіз тіпті бір айлық жөндеу операциясын елемейтін болсаңыз
Dialogue: 0,0:09:06.37,0:09:08.92,Default,,0,0,0,,Whole body rots and dies
Dialogue: 0,0:09:09.00,0:09:11.88,Default,,0,0,0,,Why did you go to such lengths...
Dialogue: 0,0:09:11.96,0:09:14.22,Default,,0,0,0,,The embodiment of order in this country
Dialogue: 0,0:09:14.30,0:09:19.22,Default,,0,0,0,,Тәртіп болмаса, зорлық-зомбылыққа шебер адамдар халықтан жоғары көтеріледі.
Dialogue: 0,0:09:19.30,0:09:21.85,Default,,0,0,0,,Бұл дүние ақымақ
Dialogue: 0,0:09:22.39,0:09:26.31,Default,,0,0,0,,Сондықтан иттердің зорлық-зомбылығы барынша зор.
Dialogue: 0,0:09:26.39,0:09:29.61,Default,,0,0,0,,Қоғамның құлы болып, Тәртіптің жалыны болса да
Dialogue: 0,0:09:29.69,0:09:32.32,Default,,0,0,0,,Өзіңді күйдіргің келсе де!
Dialogue: 0,0:09:35.70,0:09:39.12,Default,,0,0,0,,My final advice is to surrender.
Dialogue: 0,0:09:39.20,0:09:40.49,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:09:40.58,0:09:44.37,Default,,0,0,0,,Қарапайым адамдар да үмітсіз болса, еңсере алмайтын қабырғалар бар...
Dialogue: 0,0:09:44.45,0:09:45.79,Default,,0,0,0,,Мүмкін, мен кенеттен үйленуге ұсыныс жасағандықтан шығар—
Dialogue: 0,0:09:45.87,0:09:49.00,Default,,0,0,0,,Қарапайым халықтың шарасыздығы қорқынышты екені сөзсіз.
Dialogue: 0,0:09:49.08,0:09:50.29,Default,,0,0,0,,Картоп Келесі не болады?
Dialogue: 0,0:09:50.88,0:09:51.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:51.88,0:09:53.00,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:09:53.09,0:09:56.72,Default,,0,0,0,,Қарапайым адамның шарасыздығымен, Қабырғаның ар жағында не жатыр
Dialogue: 0,0:09:56.80,0:10:00.05,Default,,0,0,0,,Шарасыз данышпанмен кездесу.
Dialogue: 0,0:10:00.14,0:10:04.18,Default,,0,0,0,,Бұл шарасыздық салыстырмалы түрде мағынасыз дүние.
Dialogue: 0,0:10:04.77,0:10:06.93,Default,,0,0,0,,Біздің әлемге қош келдіңіз
Dialogue: 0,0:10:07.44,0:10:08.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:11.77,0:10:16.07,Default,,0,0,0,,Түсіндім, жеңуге мүмкіндігім жоқ.
Dialogue: 0,0:10:16.15,0:10:18.53,Default,,0,0,0,,Мен және казино бұзылды.
Dialogue: 0,0:10:18.61,0:10:19.82,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:10:19.91,0:10:22.33,Default,,0,0,0,,Save even just one side!
Dialogue: 0,0:10:22.41,0:10:23.49,Default,,0,0,0,,Не!?
Dialogue: 0,0:10:24.99,0:10:28.66,Default,,0,0,0,,Сіз казиноны қорғау үшін мені өлімге апаруға дайынсыз ба?
Dialogue: 0,0:10:34.00,0:10:35.46,Default,,0,0,0,,Хамф!
Dialogue: 0,0:10:35.55,0:10:36.84,Default,,0,0,0,,Егер қарсы болмасаңыз, жол көрсетейін
Dialogue: 0,0:10:36.92,0:10:40.68,Default,,0,0,0,,Мына кісі, мұндай билікті қайдан алды...
Dialogue: 0,0:10:40.76,0:10:42.39,Default,,0,0,0,,Is it impossible to capture alive?
Dialogue: 0,0:10:49.48,0:10:50.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:01.70,0:11:03.12,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:11:05.24,0:11:09.12,Default,,0,0,0,,Бұл казиноның негізі, қуат қорабының үстінде.
Dialogue: 0,0:11:09.21,0:11:11.54,Default,,0,0,0,,Құлап қалсаң, бұл жолы бітті.
Dialogue: 0,0:11:12.00,0:11:14.04,Default,,0,0,0,,Сіз детективті агенттіксіз
Dialogue: 0,0:11:14.13,0:11:15.92,Default,,0,0,0,,Маған неге көмектестің?
Dialogue: 0,0:11:16.00,0:11:18.63,Default,,0,0,0,,Неліктен? Ол қазірдің өзінде шешілді, солай ма?
Dialogue: 0,0:11:18.71,0:11:22.18,Default,,0,0,0,,Детективті құтқарудың жалғыз жолы - бетті алу.
Dialogue: 0,0:11:22.72,0:11:25.60,Default,,0,0,0,,And you know where it is
Dialogue: 0,0:11:25.68,0:11:28.56,Default,,0,0,0,,Білсең де айтамын деп ойлайсың ба?
Dialogue: 0,0:11:28.64,0:11:30.10,Default,,0,0,0,,Бұл Койл деген жігіт шын мәнінде пайдалы ма?
Dialogue: 0,0:11:31.39,0:11:33.44,Default,,0,0,0,,Егер мен өзімнің ерекше қабілетімді пайдалансам
Dialogue: 0,0:11:33.52,0:11:36.32,Default,,0,0,0,,Сізден парақ туралы естеліктерді оқи алады
Dialogue: 0,0:11:36.40,0:11:39.15,Default,,0,0,0,,Бұл адам арнайы істер бөлімінен...
Dialogue: 0,0:11:39.24,0:11:42.82,Default,,0,0,0,,Кешіріңіз, бірақ мен сіздің табиғаттан тыс қабілеттеріңізге қарсы шара қолдандым.
Dialogue: 0,0:11:42.91,0:11:46.66,Default,,0,0,0,,Содан кейін ол сөйлескісі келгенше оны ренжітіңіз.
Dialogue: 0,0:11:47.28,0:11:51.00,Default,,0,0,0,,Директор Танедаға пышақ сұққан адамға ешнәрсе істеу ойым жоқ.
Dialogue: 0,0:11:51.08,0:11:52.58,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:54.29,0:11:56.29,Default,,0,0,0,,Мен сені пышақтаймын деген жоқпын.
Dialogue: 0,0:11:56.88,0:11:59.21,Default,,0,0,0,,Бұл жай ғана қауіп болды.
Dialogue: 0,0:12:00.76,0:12:03.72,Default,,0,0,0,,Менен не сұра, мен шаршадым.
Dialogue: 0,0:12:03.80,0:12:08.06,Default,,0,0,0,,Өйткені, біз не үшін дүниеге келдік?
Dialogue: 0,0:12:08.14,0:12:10.47,Default,,0,0,0,,Мен соңына дейін түсінбедім.
Dialogue: 0,0:12:12.27,0:12:15.15,Default,,0,0,0,,Атсуши-кун, бұл сенің соңғы тапсырмаң.
Dialogue: 0,0:12:15.23,0:12:17.90,Default,,0,0,0,,Сигманы жерге жіберіңіз.
Dialogue: 0,0:12:17.98,0:12:19.11,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:21.32,0:12:22.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:22.90,0:12:23.90,Default,,0,0,0,,Міне!
Dialogue: 0,0:12:24.82,0:12:25.99,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:12:26.95,0:12:29.95,Default,,0,0,0,,Бұл дұрыс уақыт па, Федор?
Dialogue: 0,0:12:35.88,0:12:37.46,Default,,0,0,0,,Атсуши-кун, абай бол!
Dialogue: 0,0:12:38.17,0:12:41.42,Default,,0,0,0,,Ол достарын құтқару үшін сені өлтіруге дайын.
Dialogue: 0,0:12:42.30,0:12:43.63,Default,,0,0,0,,Кінәлі
Dialogue: 0,0:12:45.26,0:12:46.64,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:12:54.23,0:12:55.98,Default,,0,0,0,,Сигма-сан, берік бол!
Dialogue: 0,0:12:56.60,0:12:58.36,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:12:58.44,0:13:01.65,Default,,0,0,0,,Әйтеуір менде оның осылай аяқталатыны сезілді.
Dialogue: 0,0:13:01.73,0:13:03.57,Default,,0,0,0,,Бұл жебе аса бағалы — олардың тек біреуі ғана бар.
Dialogue: 0,0:13:04.86,0:13:06.74,Default,,0,0,0,,Күнәларыңды өте
Dialogue: 0,0:13:17.42,0:13:19.79,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:19.88,0:13:22.55,Default,,0,0,0,,Жібер, сен де өлесің.
Dialogue: 0,0:13:22.63,0:13:23.63,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:24.30,0:13:27.76,Default,,0,0,0,,Мен не үшін туғанымды білмедім.
Dialogue: 0,0:13:27.84,0:13:31.85,Default,,0,0,0,,Ешкім соңғы сөздерімен өлмеуі керек!
Dialogue: 0,0:13:33.68,0:13:35.60,Default,,0,0,0,,Иә
Dialogue: 0,0:13:35.68,0:13:38.56,Default,,0,0,0,,Сіз өте мейірімдісіз.
Dialogue: 0,0:13:39.31,0:13:40.31,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:13:40.40,0:13:41.23,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:41.32,0:13:44.57,Default,,0,0,0,,Мен қолымнан келгенін қарапайым адам сияқты жасадым.
Dialogue: 0,0:13:44.65,0:13:46.90,Default,,0,0,0,,Ах! Ооо!
Dialogue: 0,0:13:46.99,0:13:47.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:53.12,0:13:55.37,Default,,0,0,0,,Lucy, please look below.
Dialogue: 0,0:13:55.45,0:13:56.29,Default,,0,0,0,,Не?
Dialogue: 0,0:13:56.37,0:13:57.21,Default,,0,0,0,,Мистер Джоэстар, шынымен онда біреу тұра ма?
Dialogue: 0,0:13:59.33,0:14:00.21,Default,,0,0,0,,Міне!
Dialogue: 0,0:14:00.29,0:14:03.67,Default,,0,0,0,,Арқанды немесе ұстап алуға болатын нәрсені лақтырыңыз.
Dialogue: 0,0:14:03.75,0:14:05.63,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:14:05.71,0:14:06.88,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:14:06.97,0:14:09.47,Default,,0,0,0,,Жоқ. Жол бар ма?
Dialogue: 0,0:14:10.14,0:14:12.05,Default,,0,0,0,,Құлап қалсаң, сүйекті жина!
Dialogue: 0,0:14:13.14,0:14:15.14,Default,,0,0,0,,Ацуши!
Dialogue: 0,0:14:15.22,0:14:16.64,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:14:18.48,0:14:19.77,Default,,0,0,0,,Аудару!
Dialogue: 0,0:14:24.69,0:14:26.57,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,0:14:26.65,0:14:28.70,Default,,0,0,0,,Ататата…
Dialogue: 0,0:14:28.78,0:14:30.16,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:30.24,0:14:32.16,Default,,0,0,0,,Әйтеуір келген сияқты.
Dialogue: 0,0:14:32.24,0:14:34.87,Default,,0,0,0,,Рахмет, бұл пайдалы... Ха!
Dialogue: 0,0:14:34.95,0:14:35.83,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:14:40.33,0:14:41.83,Default,,0,0,0,,Неліктен ол?
Dialogue: 0,0:14:41.92,0:14:42.75,Default,,0,0,0,,Ах
Dialogue: 0,0:14:43.63,0:14:45.50,Default,,0,0,0,,Жіңішке қанды жіп?
Dialogue: 0,0:14:45.59,0:14:49.76,Default,,0,0,0,,Сіз мұны маған байланыстырдыңыз ба және онымен бірге жіберілді ме?
Dialogue: 0,0:14:50.63,0:14:52.05,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:14:52.14,0:14:53.68,Default,,0,0,0,,Жоқ, бітті.
Dialogue: 0,0:14:53.76,0:14:56.72,Default,,0,0,0,,Менің патшалығыма қош келдіңіз
Dialogue: 0,0:15:02.52,0:15:06.23,Default,,0,0,0,,Осы бөлмеде болғанша, Аннаға зиян тигізе алмайсың.
Dialogue: 0,0:15:15.33,0:15:18.00,Default,,0,0,0,,Иә! Ақыры оны ұстап алдым
Dialogue: 0,0:15:18.08,0:15:19.29,Default,,0,0,0,,Сіз жеңдіңіз!
Dialogue: 0,0:15:19.37,0:15:21.75,Default,,0,0,0,,Жоқ, бұл біздің шығын.
Dialogue: 0,0:15:22.33,0:15:24.34,Default,,0,0,0,,Мен Сигманың өлуіне жол бердім.
Dialogue: 0,0:15:25.09,0:15:27.71,Default,,0,0,0,,Енді беттің орнын қадағалау мүмкін емес.
Dialogue: 0,0:15:27.80,0:15:28.80,Default,,0,0,0,,Сонымен қатар…
Dialogue: 0,0:15:29.88,0:15:33.26,Default,,0,0,0,,Сигманың құтқарылуына аңшы ит куә болды.
Dialogue: 0,0:15:34.26,0:15:37.60,Default,,0,0,0,,Иттің көзінше, детектив агенттік басқа лаңкестерге көмектесуде
Dialogue: 0,0:15:37.68,0:15:39.22,Default,,0,0,0,,It must have looked like...
Dialogue: 0,0:15:39.85,0:15:43.60,Default,,0,0,0,,Барлығы Федордың жоспары бойынша болған шығар.
Dialogue: 0,0:15:44.98,0:15:46.32,Default,,0,0,0,,Толық жеңілу
Dialogue: 0,0:15:48.78,0:15:50.28,Default,,0,0,0,,Қандай жігіт
Dialogue: 0,0:15:50.78,0:15:52.61,Default,,0,0,0,,I haven't done anything
Dialogue: 0,0:15:53.20,0:15:55.74,Default,,0,0,0,,Мен жай ғана осында отырып дұға еттім.
Dialogue: 0,0:15:56.37,0:15:58.91,Default,,0,0,0,,Prayer leads to God
Dialogue: 0,0:15:59.45,0:16:02.62,Default,,0,0,0,,Тіпті монета бомбасының шабуылы да алдамшы ма?
Dialogue: 0,0:16:02.71,0:16:07.04,Default,,0,0,0,,Аспандағы казиноға ит пен детективті бір уақытта шақыру
Dialogue: 0,0:16:07.84,0:16:08.96,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:16:09.05,0:16:10.76,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:12.01,0:16:14.64,Default,,0,0,0,,Isn't that more beautiful?
Dialogue: 0,0:16:15.09,0:16:18.39,Default,,0,0,0,,We must collect information on terrorists.
Dialogue: 0,0:16:18.47,0:16:19.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.81,0:16:22.02,Default,,0,0,0,,Не?
Dialogue: 0,0:16:28.32,0:16:31.19,Default,,0,0,0,,Бұны көрген сенің жүрегің мейірімді деп ойлаймын.
Dialogue: 0,0:16:31.28,0:16:33.32,Default,,0,0,0,,Оқиғаның шындығын айтайын.
Dialogue: 0,0:16:33.40,0:16:34.15,Default,,0,0,0,,Detective agency!?
Dialogue: 0,0:16:34.15,0:16:35.24,Default,,0,0,0,,Террористік шабуылдар сериясының ұйымдастырушылары ерекше қабілеті бар бес адам болды.
Dialogue: 0,0:16:34.15,0:16:35.24,Default,,0,0,0,,Детектив агенттігі!?
Dialogue: 0,0:16:35.24,0:16:37.32,Default,,0,0,0,,Террористік шабуылдарды ұйымдастырушылар ерекше қабілеті бар бес адам болды.
Dialogue: 0,0:16:37.41,0:16:39.08,Default,,0,0,0,,Бұл Тэнцзиннің бес құлдырауы.
Dialogue: 0,0:16:39.16,0:16:43.25,Default,,0,0,0,,Олар Бет деп аталатын шындықты өзгертетін құрылғыны ұрлады.
Dialogue: 0,0:16:43.33,0:16:45.04,Default,,0,0,0,,Қылмысты анықтау органына мәжбүрлегеннен кейін...
Dialogue: 0,0:16:46.83,0:16:48.04,Default,,0,0,0,,сіз өзіңізсіз
Dialogue: 0,0:16:48.13,0:16:51.71,Default,,0,0,0,,Мен оның интрига жібін өткізіп жатқанына сенімдімін.
Dialogue: 0,0:16:51.80,0:16:55.01,Default,,0,0,0,,God loves perfection and harmony
Dialogue: 0,0:16:55.09,0:16:58.51,Default,,0,0,0,,Сондықтан мен Құдайдың еркіне бағынамын
Dialogue: 0,0:16:58.60,0:17:01.77,Default,,0,0,0,,I added a line to the page.
Dialogue: 0,0:17:04.56,0:17:06.40,Default,,0,0,0,,Тачихара Бірдеңе таптың ба?
Dialogue: 0,0:17:06.90,0:17:09.40,Default,,0,0,0,,Ал жоспарлаудың соңғы кезеңдерінде
Dialogue: 0,0:17:09.48,0:17:12.23,Default,,0,0,0,,Парақшаға ұлттардың жойылуы туралы жазамын.
Dialogue: 0,0:17:13.15,0:17:15.45,Default,,0,0,0,,Жоғарыда келтірілген дүниежүзілік терроризмнің толық көрінісі...
Dialogue: 0,0:17:15.53,0:17:17.61,Default,,0,0,0,,Тачихара! ше?
Dialogue: 0,0:17:17.70,0:17:18.95,Default,,0,0,0,,Бұл Шехер астрономиялық басқармасы—
Dialogue: 0,0:17:19.74,0:17:23.20,Default,,0,0,0,,Бұл тергеуді бұзуға бағытталған әдеттегі жалған ақпарат.
Dialogue: 0,0:17:24.29,0:17:28.00,Default,,0,0,0,,Бұл детективтің кінәсіздігіне нұқсан келтіретін модификация ма?
Dialogue: 0,0:17:28.08,0:17:28.92,Default,,0,0,0,,Иә
Dialogue: 0,0:17:29.00,0:17:32.84,Default,,0,0,0,,Дүние жүзіндегі барлық полиция және тергеу агенттіктері
Dialogue: 0,0:17:32.92,0:17:37.18,Default,,0,0,0,,Детективті құлатқан нағыз кінәлі бар.Дәлелді алсақ та
Dialogue: 0,0:17:37.26,0:17:39.85,Default,,0,0,0,,Мұқият қарастырмау
Dialogue: 0,0:17:39.93,0:17:42.35,Default,,0,0,0,,Мен парақта осылай жаздым
Dialogue: 0,0:17:42.81,0:17:46.81,Default,,0,0,0,,Басқаша айтқанда, иттерді сіздің жағыңызға әкелу стратегиясы
Dialogue: 0,0:17:46.89,0:17:49.73,Default,,0,0,0,,Басынан бастап мүмкін емес
Dialogue: 0,0:17:49.81,0:17:52.78,Default,,0,0,0,,Infiltrate the Port Mafia again?
Dialogue: 0,0:17:52.86,0:17:55.53,Default,,0,0,0,,Hmm, I made contact with the ground.
Dialogue: 0,0:17:56.20,0:18:00.45,Default,,0,0,0,,Детективтік агенттік монета бомбасы оқиғасының шекарасын толығымен кесіп өтті.
Dialogue: 0,0:18:00.53,0:18:04.12,Default,,0,0,0,,Бұл мәселе енді бір елдегі қылмыстық іспен шектелмейді.
Dialogue: 0,0:18:04.91,0:18:06.66,Default,,0,0,0,,The world is starting to move
Dialogue: 0,0:18:07.54,0:18:11.38,Default,,0,0,0,,Бірақ біз оларды ұстауымыз керек.
Dialogue: 0,0:18:11.46,0:18:14.55,Default,,0,0,0,,Тачихара, тағы да мафияға еніп кет.
Dialogue: 0,0:18:14.63,0:18:19.30,Default,,0,0,0,,Қашып кеткен қалған екі детектив қызметкерінің қайда тығылғанын табыңыз.
Dialogue: 0,0:18:23.06,0:18:24.31,Default,,0,0,0,,Құлықсыз ба?
Dialogue: 0,0:18:24.39,0:18:26.56,Default,,0,0,0,,Жоқ, жақында ғана.
Dialogue: 0,0:18:26.64,0:18:30.23,Default,,0,0,0,,Мафия ретінде әрекет ету мені біртүрлі тітіркендіреді.
Dialogue: 0,0:18:30.31,0:18:33.19,Default,,0,0,0,,Какакака сен бе?
Dialogue: 0,0:18:33.27,0:18:38.24,Default,,0,0,0,,Сіз жасырын тергеу жүргізу үшін туған ерекше қабілетсіз адамсыз.
Dialogue: 0,0:18:38.82,0:18:42.32,Default,,0,0,0,,Біз детективті қорғайтын мафия мүшелерін жойған кезде де.
Dialogue: 0,0:18:42.41,0:18:43.70,Default,,0,0,0,,Сіз мұны істеген жоқсыз ба?
Dialogue: 0,0:18:46.37,0:18:47.66,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:48.37,0:18:50.42,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:18:52.42,0:18:53.50,Default,,0,0,0,,Тачихара
Dialogue: 0,0:18:53.59,0:18:55.75,Default,,0,0,0,,Сізде де жақсы болдыңыз ба?
Dialogue: 0,0:18:55.84,0:18:57.80,Default,,0,0,0,,Ішіңе пышақ сұққанын естідім.
Dialogue: 0,0:18:57.88,0:19:00.38,Default,,0,0,0,,Жарақаттар мен күткеннен де жеңіл болды.
Dialogue: 0,0:19:00.47,0:19:02.47,Default,,0,0,0,,Біз сияқты.
Dialogue: 0,0:19:02.55,0:19:07.52,Default,,0,0,0,,Әй, мен де.Қансырап жатқанына қарамастан, жараларым жеңіл.
Dialogue: 0,0:19:07.60,0:19:12.02,Default,,0,0,0,,Орындау үшін шабуыл жасағандай.
Dialogue: 0,0:19:12.48,0:19:16.28,Default,,0,0,0,,Жаудың айласынан аман қалсақ, бір-бірімізге қамқор бола алмаймыз!
Dialogue: 0,0:19:16.36,0:19:17.36,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:19:18.03,0:19:20.90,Default,,0,0,0,,Та... Тачихара~!
Dialogue: 0,0:19:20.99,0:19:22.53,Default,,0,0,0,,Әй, қария
Dialogue: 0,0:19:23.99,0:19:27.16,Default,,0,0,0,,Қалай ойлайсың, мен Порт мафиясына лайықпын ба?
Dialogue: 0,0:19:30.83,0:19:32.62,Default,,0,0,0,,(Хироцу мен Джиннің күлкісі)
Dialogue: 0,0:19:32.71,0:19:34.21,Default,,0,0,0,,Ah Itata
Dialogue: 0,0:19:36.55,0:19:39.55,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:19:39.63,0:19:42.47,Default,,0,0,0,,Құдай туралы ештеңе білмейсің.
Dialogue: 0,0:19:44.47,0:19:46.01,Default,,0,0,0,,Тыңдап көрейік
Dialogue: 0,0:19:46.10,0:19:48.85,Default,,0,0,0,,Кемелдік пен үйлесімділік?
Dialogue: 0,0:19:48.93,0:19:53.02,Default,,0,0,0,,Құдай сіздің кеуектеріңіз сияқты мұндай нәрселерге мән бермейді.
Dialogue: 0,0:19:53.81,0:19:56.48,Default,,0,0,0,,Оның сататыны – кездейсоқтық пен абсурдтық.
Dialogue: 0,0:19:57.07,0:19:59.28,Default,,0,0,0,,Мен оны талай рет көрдім.
Dialogue: 0,0:19:59.36,0:20:02.99,Default,,0,0,0,,Мыңдаған құдайлық арифметикалық схемалар
Dialogue: 0,0:20:03.07,0:20:06.03,Default,,0,0,0,,Міне, біз осы жердеміз
Dialogue: 0,0:20:06.53,0:20:08.49,Default,,0,0,0,,Бұл жердің шетіндегі түрме.
Dialogue: 0,0:20:08.95,0:20:11.33,Default,,0,0,0,,Әлемді айналдыратын нәрсе
Dialogue: 0,0:20:11.41,0:20:14.96,Default,,0,0,0,,Күтпеген жағдайдың дауылында айғайлап, жүгіру
Dialogue: 0,0:20:15.04,0:20:17.29,Default,,0,0,0,,Қан төккендер
Dialogue: 0,0:20:17.38,0:20:19.71,Default,,0,0,0,,Сол жанның күші алдында
Dialogue: 0,0:20:20.21,0:20:23.18,Default,,0,0,0,,Сен екеуміздің бір орында тұрудан басқа амалымыз жоқ.
Dialogue: 0,0:20:24.55,0:20:27.22,Default,,0,0,0,,Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:20:34.02,0:20:37.98,Default,,0,0,0,,Ақылсыздық, қызу қандылық, айуандық
Dialogue: 0,0:20:38.77,0:20:40.19,Default,,0,0,0,,Порт мафиясындағы барлық адамдар
Dialogue: 0,0:20:40.28,0:20:43.20,Default,,0,0,0,,Мен сізден үлгі алуым керек.
Dialogue: 0,0:20:43.28,0:20:46.32,Default,,0,0,0,,Не? Бұл сезім
Dialogue: 0,0:20:46.41,0:20:50.91,Default,,0,0,0,,Мен ағамның жауын жеңу үшін порт мафиясына еніп кеттім.
Dialogue: 0,0:20:54.54,0:20:57.46,Default,,0,0,0,,Ағам менен артық болса да,
Dialogue: 0,0:20:58.09,0:21:00.67,Default,,0,0,0,,Мен үлкен ағама қарсы болмаған адам болғым келді.
Dialogue: 0,0:21:01.71,0:21:02.63,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:21:03.72,0:21:05.63,Default,,0,0,0,,Менің әйел дәрігерім бар...
Dialogue: 0,0:21:05.72,0:21:07.05,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:10.68,0:21:15.69,Default,,0,0,0,,♪~
Dialogue: 0,0:21:17.77,0:21:19.06,Default,,0,0,0,,Тачихара
Dialogue: 0,0:21:23.86,0:21:25.40,Default,,0,0,0,,Менің ағам туралы
Dialogue: 0,0:21:26.24,0:21:27.78,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:21:28.62,0:21:30.91,Default,,0,0,0,,Қарғыс атқан детектив агенттігі
Dialogue: 0,0:21:30.99,0:21:32.83,Default,,0,0,0,,Зорлықшыл террорист
Dialogue: 0,0:21:33.45,0:21:35.83,Default,,0,0,0,,Бұл не деген жігіттер?
Dialogue: 0,0:21:36.54,0:21:39.04,Default,,0,0,0,,Детективтік агенттік ешқашан берілмейді
Dialogue: 0,0:21:39.13,0:21:41.67,Default,,0,0,0,,Ұйымның кінәсіздігін дәлелдеу
Dialogue: 0,0:21:41.75,0:21:44.67,Default,,0,0,0,,Мен өмірімді тастап, күресемін
Dialogue: 0,0:21:44.76,0:21:48.80,Default,,0,0,0,,Жанын қиғандар үшін сотталу мүмкін емес.
Dialogue: 0,0:21:48.89,0:21:51.22,Default,,0,0,0,,Кінәсіздік немесе өлім
Dialogue: 0,0:21:51.30,0:21:54.89,Default,,0,0,0,,Әлем оларды кінәлі деп санайды.
Dialogue: 0,0:21:54.98,0:21:58.40,Default,,0,0,0,,...бірақ мен олай ойламаймын.
Dialogue: 0,0:21:58.48,0:22:01.27,Default,,0,0,0,,Ең болмағанда бастық
Dialogue: 0,0:22:01.36,0:22:03.98,Default,,0,0,0,,Мен детективті кінәсіз деп ойладым.
Dialogue: 0,0:22:04.07,0:22:05.82,Default,,0,0,0,,Сол бастық интуиция мен эмоцияға негізделген.
Dialogue: 0,0:22:05.90,0:22:08.41,Default,,0,0,0,,Мен детектив агенттігіне сенбеймін деп ойлаймын.
Dialogue: 0,0:22:09.24,0:22:11.16,Default,,0,0,0,,Ей, екеуің де.
Dialogue: 0,0:22:11.24,0:22:13.83,Default,,0,0,0,,Детектив туралы не ойлайсыз?
Dialogue: 0,0:22:13.91,0:22:14.91,Default,,0,0,0,,Олар шынымен
Dialogue: 0,0:22:15.00,0:22:16.71,Default,,0,0,0,,Сіз мені террорист деп ойлайсыз ба?
Dialogue: 0,0:22:17.21,0:22:19.83,Default,,0,0,0,,Басыңыздан соққы алдыңыз ба? Тачихара
Dialogue: 0,0:22:20.96,0:22:22.38,Default,,0,0,0,,Порт мафиясындағы кез келген адам
Dialogue: 0,0:22:22.46,0:22:24.92,Default,,0,0,0,,Әрине түсіну керек.
Dialogue: 0,0:22:25.67,0:22:27.30,Default,,0,0,0,,Сәлем? Күміс (күміс) Иә
Dialogue: 0,0:22:27.97,0:22:29.97,Default,,0,0,0,,Бұл туралы ойланудың қажеті жоқ.
Dialogue: 0,0:22:30.39,0:22:32.35,Default,,0,0,0,,Детективтік агенттік лаңкестерге және т.б.
Dialogue: 0,0:22:32.43,0:22:33.93,Default,,0,0,0,,Мүлде мүмкін емес
Dialogue: 0,0:22:34.97,0:22:35.97,Default,,0,0,0,,Тачихара
Dialogue: 0,0:22:36.06,0:22:38.06,Default,,0,0,0,,Егер сіз де порт мафиясы болсаңыз
Dialogue: 0,0:22:38.14,0:22:40.48,Default,,0,0,0,,Әрине түсінесіз.
Dialogue: 0,0:22:41.81,0:22:43.52,Default,,0,0,0,,Иә.
Dialogue: 0,0:22:44.07,0:22:46.53,Default,,0,0,0,,Қалай ойласаң да, анық, солай емес пе?
Dialogue: 0,0:22:48.99,0:22:51.20,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:22:52.57,0:22:55.70,Default,,0,0,0,,Қарулы Детектив Агенттігінің террорист болуы мүмкін емес.
Dialogue: 0,0:22:55.79,0:22:58.41,Default,,0,0,0,,Үкімет қате кінәлі.
Dialogue: 0,0:22:58.50,0:23:01.67,Default,,0,0,0,,Біз үкіметті сендіруіміз керек!
Dialogue: 0,0:23:03.25,0:23:04.92,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:23:05.00,0:23:07.63,Default,,0,0,0,,Адам күнәкар және ақымақ
Dialogue: 0,0:23:08.30,0:23:10.34,Default,,0,0,0,,Бірақ сіз көбірек ойлайсыз
Dialogue: 0,0:23:11.51,0:23:14.10,Default,,0,0,0,,Болмыс емес, қызықсыз
Dialogue: 0,0:23:24.36,0:23:26.40,Default,,0,0,0,,Бұл баратын жер ме?
Dialogue: 0,0:23:28.19,0:23:29.11,Default,,0,0,0,,Не?
Dialogue: 0,0:23:29.61,0:23:30.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:30.53,0:23:31.95,Default,,0,0,0,,Сендер тым талапшылсыңдар — менің кимоном мүлдем кір емес.
Dialogue: 0,0:23:32.03,0:23:33.95,Default,,0,0,0,,Хехехе ахахахха!
Dialogue: 0,0:23:34.03,0:23:37.95,Default,,0,0,0,,Енді қайта тірілу сиқырының уақыты келді!
Dialogue: 0,0:23:38.66,0:23:40.41,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:23:41.91,0:23:47.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory