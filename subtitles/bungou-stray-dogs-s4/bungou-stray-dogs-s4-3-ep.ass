Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.12,0:00:05.29,Default,,0,0,0,,Канагава Коки осы жерді басыңыз
Dialogue: 0,0:00:05.38,0:00:07.25,Default,,0,0,0,,205 Гентай
Dialogue: 0,0:00:07.34,0:00:10.42,Default,,0,0,0,,Еркек орта жастағы Эгоуға құрметпен қарау
Dialogue: 0,0:00:10.51,0:00:11.72,Default,,0,0,0,,(Радионы ажырату дыбысы)
Dialogue: 0,0:00:11.80,0:00:14.59,Default,,0,0,0,,Офицер, келуге қанша уақыт қажет?
Dialogue: 0,0:00:15.55,0:00:16.68,Default,,0,0,0,,Бірден
Dialogue: 0,0:00:16.76,0:00:18.18,Default,,0,0,0,,Хмм.
Dialogue: 0,0:00:18.93,0:00:20.68,Default,,0,0,0,,Соған қарамастан бұл тамаша жұмыс болды.
Dialogue: 0,0:00:20.77,0:00:23.14,Default,,0,0,0,,Нағыз кішкентай детектив
Dialogue: 0,0:00:23.23,0:00:28.19,Default,,0,0,0,,Олар оққағар Фукузава-сенсеймен бірге тамаша детектив дуэтін құрады.
Dialogue: 0,0:00:28.27,0:00:29.48,Default,,0,0,0,,Бірақ бұл адам
Dialogue: 0,0:00:29.57,0:00:32.19,Default,,0,0,0,,Менің ойымша, сіз менімен бірлескіңіз келмейді.
Dialogue: 0,0:00:32.28,0:00:34.70,Default,,0,0,0,,О? Солай ма?
Dialogue: 0,0:00:34.78,0:00:37.16,Default,,0,0,0,,Ол адам басқа адамдардан қорқады.
Dialogue: 0,0:00:37.82,0:00:39.74,Default,,0,0,0,,Мен жаңа танысқан профессор Фукузава туралы.
Dialogue: 0,0:00:39.83,0:00:43.54,Default,,0,0,0,,Осыншама нәрсені көре білу - бұл шынымен де ерекше қабілеттерге ие адам.
Dialogue: 0,0:00:43.62,0:00:47.63,Default,,0,0,0,,«Шындықты көру қабілетіне» сенімдісіз бе?
Dialogue: 0,0:00:47.71,0:00:51.88,Default,,0,0,0,,Бірақ сен шынымен сенбейсің, солай ма?
Dialogue: 0,0:00:54.42,0:00:55.76,Default,,0,0,0,,Өйткені қазір
Dialogue: 0,0:00:55.84,0:00:59.43,Default,,0,0,0,,Сіз «мен жаңа кездескен Фукузава мырза туралы» айттыңыз ба?
Dialogue: 0,0:00:59.51,0:01:03.89,Default,,0,0,0,,Фукузава мырза екеуміз бүгін таңертең президентті өлтіру ісі бойынша бірінші рет кездестік.
Dialogue: 0,0:01:03.98,0:01:07.15,Default,,0,0,0,,Мен оны білу үшін штабқа хабарластым.
Dialogue: 0,0:01:07.23,0:01:09.36,Default,,0,0,0,,Себебі мен өз қабілетімді білгім келді
Dialogue: 0,0:01:09.44,0:01:12.23,Default,,0,0,0,,Ой, күткендей.
Dialogue: 0,0:01:12.78,0:01:15.15,Default,,0,0,0,,О, ыңғайсыздық үшін кешіріңіз.
Dialogue: 0,0:01:15.24,0:01:18.49,Default,,0,0,0,,Мені күдіктене беруінің себебі – мен ашулымын.
Dialogue: 0,0:01:18.57,0:01:21.16,Default,,0,0,0,,Мен табиғаттан тыс күштердің бар екенін дәлелдеймін бе?
Dialogue: 0,0:01:21.79,0:01:23.70,Default,,0,0,0,,Бұл жақсы нәрсе.
Dialogue: 0,0:01:23.79,0:01:27.12,Default,,0,0,0,,Мен табиғаттан тыс детективтің шегерімдерін арнайы орындықтан тамашалай алатыныма сене алар емеспін.
Dialogue: 0,0:01:27.67,0:01:31.29,Default,,0,0,0,,Бұл көлік полиция бөлімшесіне бара жатқан жоқ.
Dialogue: 0,0:01:32.55,0:01:36.13,Default,,0,0,0,,Бірінші айтуым керек еді, кешіріңіз.
Dialogue: 0,0:01:36.22,0:01:39.72,Default,,0,0,0,,Кетер алдында маған бір оқиға болды деп радио қоңырау шалды.
Dialogue: 0,0:01:40.26,0:01:43.56,Default,,0,0,0,,Оқиға орнына тамаша детективті әкеліңіз.
Dialogue: 0,0:01:43.64,0:01:44.68,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:44.77,0:01:46.23,Default,,0,0,0,,Бірақ қазір
Dialogue: 0,0:01:46.31,0:01:49.60,Default,,0,0,0,,Менің ойымша, бұл басқа қабілеттерді пайдалану сияқты емес, солай ма?
Dialogue: 0,0:01:49.69,0:01:55.03,Default,,0,0,0,,Полиция бөлімшесі бекет бағытында, сондықтан сіз басқа жерге бара жатқаныңызды оңай айта аласыз.
Dialogue: 0,0:01:55.11,0:01:56.40,Default,,0,0,0,,Ендеше мұны істейік.
Dialogue: 0,0:01:56.86,0:02:00.91,Default,,0,0,0,,Полиция қызметкері осы істің құпиясы туралы сұрақтар қояды.
Dialogue: 0,0:02:00.99,0:02:04.37,Default,,0,0,0,,Жауапта тұрып қалсам, полиция жеңеді.
Dialogue: 0,0:02:04.45,0:02:07.71,Default,,0,0,0,,Жұмбақ таусылған болса, мен жеңемін. Сіз қалай ойлайсыз?
Dialogue: 0,0:02:07.79,0:02:09.21,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:09.92,0:02:13.13,Default,,0,0,0,,Менің ойымша, мұны бәрі естігісі келді.
Dialogue: 0,0:02:13.21,0:02:16.30,Default,,0,0,0,,Сахнада түсірілген костюм киген джентльмен болды, солай ма?
Dialogue: 0,0:02:17.17,0:02:20.72,Default,,0,0,0,,Ол қалай ұсталып, сонда әкелінді?
Dialogue: 0,0:02:21.72,0:02:22.80,Default,,0,0,0,,Бұл кілем.
Dialogue: 0,0:02:23.35,0:02:24.60,Default,,0,0,0,,Кілем?
Dialogue: 0,0:02:24.68,0:02:27.81,Default,,0,0,0,,Залда ұзын кілем болды, солай ма?
Dialogue: 0,0:02:27.89,0:02:31.77,Default,,0,0,0,,Абыр-сабырдан кейін бір кілем жоқ.
Dialogue: 0,0:02:31.86,0:02:34.94,Default,,0,0,0,,Оның үстіне кілем қай жерден
Dialogue: 0,0:02:35.02,0:02:37.74,Default,,0,0,0,,Әлсіз біртүрлі иіс шықты.
Dialogue: 0,0:02:37.82,0:02:39.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:39.20,0:02:42.99,Default,,0,0,0,,Бояудан немесе пластиктен шыққан оғаш иіс...
Dialogue: 0,0:02:43.53,0:02:46.12,Default,,0,0,0,,Органикалық еріткіш? (Ранпо) Иә, солай.
Dialogue: 0,0:02:46.20,0:02:47.16,Default,,0,0,0,,Бірдей иіс
Dialogue: 0,0:02:47.25,0:02:50.00,Default,,0,0,0,,Мен де байланған костюм киген адамнан біраз естідім.
Dialogue: 0,0:02:50.08,0:02:52.50,Default,,0,0,0,,Басқаша айтқанда, кінәлі сол костюмдегі мырза болды.
Dialogue: 0,0:02:52.58,0:02:56.46,Default,,0,0,0,,Мен оны кілемге орап, сол жаққа апардым.
Dialogue: 0,0:02:56.55,0:03:01.55,Default,,0,0,0,,Костюмдегі джентльменді нокаутқа түсіру үшін органикалық еріткіш қолданылды.
Dialogue: 0,0:03:01.63,0:03:03.47,Default,,0,0,0,,Әрине, оқиғадан кейінгі кезең
Dialogue: 0,0:03:03.55,0:03:06.85,Default,,0,0,0,,Әртістер мен қалалық полицияның арасында көп келіспеушілік болды.
Dialogue: 0,0:03:06.93,0:03:09.39,Default,,0,0,0,,Кілем көтерген бір адам өтсе де
Dialogue: 0,0:03:09.48,0:03:12.65,Default,,0,0,0,,Ешқандай назар аудармаған шығар, бірақ...
Dialogue: 0,0:03:13.19,0:03:18.23,Default,,0,0,0,,Олай болса да, оны көтерген адам, әрине, сыбайлас болған сценарист болды, солай ма?
Dialogue: 0,0:03:18.32,0:03:20.32,Default,,0,0,0,,Мен сценарист емеспін.
Dialogue: 0,0:03:20.82,0:03:22.70,Default,,0,0,0,,Сценарист шығар
Dialogue: 0,0:03:22.78,0:03:26.87,Default,,0,0,0,,Менің ойымша, ол спектакль басталмай жатып өлтірілді.
Dialogue: 0,0:03:26.95,0:03:29.45,Default,,0,0,0,,Менен басқаның бәрі ақымақ, ақымақ.
Dialogue: 0,0:03:29.54,0:03:31.41,Default,,0,0,0,,Өйткені олар сүйкімді адамдар
Dialogue: 0,0:03:31.50,0:03:34.25,Default,,0,0,0,,Мен сізге көмектескім келді.
Dialogue: 0,0:03:34.33,0:03:38.05,Default,,0,0,0,,Оқиға туралы білмей тұрып өлетін адамдар маған бәрібір...
Dialogue: 0,0:03:38.13,0:03:43.05,Default,,0,0,0,,Бірақ ол неліктен бір адамды ұрлау үшін сонша барады?
Dialogue: 0,0:03:43.13,0:03:45.14,Default,,0,0,0,,Ұрлау үшін бе?
Dialogue: 0,0:03:45.22,0:03:47.10,Default,,0,0,0,,Бұл үлкен жоспар
Dialogue: 0,0:03:47.18,0:03:51.27,Default,,0,0,0,,Ол костюмдегі джентльменді ұрлау үшін ғана жиналды.
Dialogue: 0,0:03:51.35,0:03:54.52,Default,,0,0,0,,Бұл үлкен және күрделі тұзақ болды.
Dialogue: 0,0:03:54.60,0:04:00.32,Default,,0,0,0,,Сценарист те, басты рөлдегі актер Мураками де осы мақсатта пешка ретінде пайдаланылды.
Dialogue: 0,0:04:00.40,0:04:04.82,Default,,0,0,0,,Сіз қалай ойлайсыз? Менің табиғаттан тыс күштерім бар екеніне енді сендіңіз бе?
Dialogue: 0,0:04:05.37,0:04:07.12,Default,,0,0,0,,бірақ манга суретшісінің үйіне алты минут ерте бару—
Dialogue: 0,0:04:07.20,0:04:11.45,Default,,0,0,0,,Жүр, мына көлік қайда бара жатқанын айт.
Dialogue: 0,0:04:11.96,0:04:16.83,Default,,0,0,0,,Кейқан мырзаның киімінен органикалық еріткіштердің иісі бар.
Dialogue: 0,0:04:17.38,0:04:18.25,Default,,0,0,0,,Иә
Dialogue: 0,0:04:20.00,0:04:25.01,Default,,0,0,0,,♪~
Dialogue: 0,0:05:44.92,0:05:49.93,Default,,0,0,0,,~♪
Dialogue: 0,0:05:50.80,0:05:52.26,Default,,0,0,0,,Неліктен мен сізбен байланыса алмаймын?
Dialogue: 0,0:05:52.35,0:05:55.60,Default,,0,0,0,,Мен сізден полиция бөлімшесіне келгеніңізді әлі естіген жоқпын.
Dialogue: 0,0:05:55.68,0:05:58.23,Default,,0,0,0,,Мен тіпті полиция көлігіне радио арқылы қосыла алмаймын.
Dialogue: 0,0:05:59.40,0:06:01.11,Default,,0,0,0,,Сценарист өлтірілді
Dialogue: 0,0:06:06.90,0:06:10.62,Default,,0,0,0,,Егер Эгава ханымның Ранподан естіген оқиғасынан қорытынды шығарсақ,
Dialogue: 0,0:06:10.70,0:06:12.70,Default,,0,0,0,,Іс әлі аяқталған жоқ.
Dialogue: 0,0:06:13.83,0:06:17.41,Default,,0,0,0,,Бұл іс қылмыстың екі түрінен тұрады.
Dialogue: 0,0:06:17.50,0:06:19.50,Default,,0,0,0,,Мысалы, бұл асшаяндар мен теңіз балықтары болар еді.
Dialogue: 0,0:06:20.08,0:06:22.00,Default,,0,0,0,,Нағыз кінәлі әлі де бар
Dialogue: 0,0:06:22.09,0:06:26.13,Default,,0,0,0,,Оңай ауланған асшаяндарға қанағаттануға болмайды.
Dialogue: 0,0:06:26.21,0:06:28.93,Default,,0,0,0,,Эби актер Муракамиді меңзесе керек.
Dialogue: 0,0:06:29.01,0:06:31.80,Default,,0,0,0,,Бірақ егер сіз теңіз қарағайын ұстағыңыз келсе
Dialogue: 0,0:06:31.89,0:06:34.76,Default,,0,0,0,,Менің бұл үшін асшаяндарды пайдаланудан басқа амалым жоқ.
Dialogue: 0,0:06:35.64,0:06:38.77,Default,,0,0,0,,Басқаша айтқанда, актер Мураками мен сценарист Курахашиді пайдаланып,
Dialogue: 0,0:06:38.85,0:06:42.23,Default,,0,0,0,,Одан да үлкен оқиғаны жоспарлап отырған нағыз кінәлі бар.
Dialogue: 0,0:06:42.31,0:06:45.02,Default,,0,0,0,,Ранпо оны әшкерелеуді көздейді.
Dialogue: 0,0:06:45.90,0:06:48.53,Default,,0,0,0,,Ранпомен бірге полиция бөліміне барған полиция қызметкерінің аты кім?
Dialogue: 0,0:06:48.61,0:06:50.70,Default,,0,0,0,,Бұл бас констебль Митамура.
Dialogue: 0,0:06:50.78,0:06:53.32,Default,,0,0,0,,Ұялы телефон да өшірілген
Dialogue: 0,0:06:56.66,0:06:59.16,Default,,0,0,0,,Ранпоға не болды?
Dialogue: 0,0:07:05.88,0:07:07.71,Default,,0,0,0,,Ранпо қайда кетті?
Dialogue: 0,0:07:10.59,0:07:11.59,Default,,0,0,0,,Я...
Dialogue: 0,0:07:14.51,0:07:15.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:22.56,0:07:24.23,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:24.31,0:07:26.44,Default,,0,0,0,,Кейін кездескенше.
Dialogue: 0,0:07:26.52,0:07:28.44,Default,,0,0,0,,Татто... Айтат!
Dialogue: 0,0:07:31.28,0:07:32.28,Default,,0,0,0,,Ахаха
Dialogue: 0,0:07:32.36,0:07:34.37,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:07:35.53,0:07:36.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:37.41,0:07:40.37,Default,,0,0,0,,Жоқ... Мүмкін емес.
Dialogue: 0,0:07:40.45,0:07:42.92,Default,,0,0,0,,Осындай ерекше қабілеті бар адам
Dialogue: 0,0:07:43.00,0:07:47.75,Default,,0,0,0,,Біздің тергеу тізімімізде ұсталмай тұрып, оның болуы мүмкін емес.
Dialogue: 0,0:07:47.84,0:07:51.22,Default,,0,0,0,,Бұл кеме жасаушы компанияның кеңсесі.
Dialogue: 0,0:07:51.30,0:07:54.64,Default,,0,0,0,,Жарайды, бұл қабықша компания деп аталады.
Dialogue: 0,0:07:57.18,0:07:59.10,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:07:59.18,0:08:01.56,Default,,0,0,0,,Мылтық? (Митамура) А...
Dialogue: 0,0:08:03.27,0:08:05.44,Default,,0,0,0,,Мен сені атпаймын.
Dialogue: 0,0:08:05.98,0:08:08.77,Default,,0,0,0,,Менің айтқанымды орындасаң.
Dialogue: 0,0:08:21.87,0:08:22.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:24.83,0:08:25.88,Default,,0,0,0,,Сол таяқ.
Dialogue: 0,0:08:32.51,0:08:34.05,Default,,0,0,0,,Бұл дайындалған таяқ па?
Dialogue: 0,0:08:38.85,0:08:39.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.89,0:08:48.61,Default,,0,0,0,,Бұл... Мен бұл мырза екеніне сене алар емеспін.
Dialogue: 0,0:08:52.19,0:08:54.15,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:08:54.74,0:08:56.74,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:09:00.24,0:09:01.58,Default,,0,0,0,,Сіз өз ойыңызды өзгерттіңіз бе?
Dialogue: 0,0:09:02.37,0:09:04.25,Default,,0,0,0,,Менің бір өтінішім бар.
Dialogue: 0,0:09:06.08,0:09:07.54,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:09:07.63,0:09:09.79,Default,,0,0,0,,Қайда? мұнда
Dialogue: 0,0:09:10.25,0:09:14.51,Default,,0,0,0,,Демек, бұл біздің қолайлы базаларымыздың бірі.
Dialogue: 0,0:09:15.05,0:09:16.30,Default,,0,0,0,,Біз?
Dialogue: 0,0:09:16.38,0:09:19.26,Default,,0,0,0,,Әрине, мен қалалық полицияны айтып отырған жоқпын.
Dialogue: 0,0:09:21.35,0:09:25.10,Default,,0,0,0,,Ауданды қарумен күзетіп тұрған төрт кәсіби сарбаз.
Dialogue: 0,0:09:25.94,0:09:28.85,Default,,0,0,0,,Жоқ... 5 адам бар.
Dialogue: 0,0:09:29.36,0:09:32.61,Default,,0,0,0,,Керемет. Сіз қайдан білдіңіз?
Dialogue: 0,0:09:32.69,0:09:35.44,Default,,0,0,0,,Бұл менің ерекше қабілетім.
Dialogue: 0,0:09:35.53,0:09:40.24,Default,,0,0,0,,Бірақ олардың сені ренжітетін ниеті жоқ.
Dialogue: 0,0:09:40.91,0:09:44.45,Default,,0,0,0,,Бастапқыда осында әкелінуі тиіс нысана.
Dialogue: 0,0:09:45.00,0:09:47.92,Default,,0,0,0,,Сахнада көрермендерге өнер көрсеттіңіз.
Dialogue: 0,0:09:48.00,0:09:51.63,Default,,0,0,0,,Сол мырзаны бақылауға дайындалған күштермен.
Dialogue: 0,0:09:52.34,0:09:55.46,Default,,0,0,0,,Ақырында әлгі мырза қашып құтылды.
Dialogue: 0,0:09:55.55,0:09:58.68,Default,,0,0,0,,Сонымен? Мені мұнда неге әкелдің?
Dialogue: 0,0:09:58.76,0:10:02.43,Default,,0,0,0,,Бұл жолғы театрдың қойылымы өте ауқымды болды.
Dialogue: 0,0:10:02.51,0:10:06.23,Default,,0,0,0,,Оны жойған «жоғарғы адамдар» ашуланды.
Dialogue: 0,0:10:07.02,0:10:09.40,Default,,0,0,0,,Олар: «Бұзған жігітті ұстаңдар», - деді.
Dialogue: 0,0:10:09.48,0:10:11.31,Default,,0,0,0,,Менің айтып тұрғаным осы.
Dialogue: 0,0:10:11.40,0:10:13.44,Default,,0,0,0,,Неліктен шындықты аштың?
Dialogue: 0,0:10:13.52,0:10:17.49,Default,,0,0,0,,Ақпаратты қайдан алдың? Маған білдір.
Dialogue: 0,0:10:17.57,0:10:21.45,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, біз жоғарыдағы нұсқауларға үміттене алмаймыз.
Dialogue: 0,0:10:21.53,0:10:24.49,Default,,0,0,0,,Мен сені ренжітуім керек.
Dialogue: 0,0:10:24.58,0:10:26.29,Default,,0,0,0,,Сізге бұл ұнамайды, солай ма?
Dialogue: 0,0:10:27.04,0:10:29.08,Default,,0,0,0,,Сондықтан менің бір ұсынысым бар.
Dialogue: 0,0:10:29.17,0:10:34.50,Default,,0,0,0,,Табиғаттан тыс күштері бар ұлы детектив, бізбен жұмыс істегіңіз келе ме?
Dialogue: 0,0:10:35.25,0:10:37.59,Default,,0,0,0,,Біз ұмтылысы бар адамдармыз.
Dialogue: 0,0:10:37.67,0:10:41.64,Default,,0,0,0,,Бұл елді зұлым адамдардан тазартқысы келетіндер.
Dialogue: 0,0:10:42.93,0:10:47.48,Default,,0,0,0,,Егер сіз ерекше қабілеттерге ие тамаша адам болсаңыз, сізді қуантады.
Dialogue: 0,0:10:47.56,0:10:48.81,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:50.98,0:10:52.61,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:10:53.15,0:10:56.98,Default,,0,0,0,,Әңгіме ұзақ және қызықсыз болғандықтан, мен оны мүлдем тыңдамадым.
Dialogue: 0,0:10:58.19,0:11:00.74,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:01.99,0:11:04.33,Default,,0,0,0,,Тергеу изоляторы қаншалықты ыңғайлы?
Dialogue: 0,0:11:05.08,0:11:08.45,Default,,0,0,0,,Жаман емес, кондиционер жұмыс істеп тұр.
Dialogue: 0,0:11:08.95,0:11:11.62,Default,,0,0,0,,Мен жалықтым десем, мынаны берді.
Dialogue: 0,0:11:11.71,0:11:14.88,Default,,0,0,0,,«Тәубе ету» дегенді білдірсе керек.
Dialogue: 0,0:11:14.96,0:11:16.92,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:11:17.96,0:11:19.42,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:11:19.92,0:11:23.72,Default,,0,0,0,,Бұл ұлттық ұйым пайдаланатын жад құрылғысы.
Dialogue: 0,0:11:24.26,0:11:27.31,Default,,0,0,0,,Куәгерді қорғау бағдарламасымен қорғалатын адамдар
Dialogue: 0,0:11:27.39,0:11:30.69,Default,,0,0,0,,Қорғау органдарымен ақпарат алмасуға арналған құрылғылар
Dialogue: 0,0:11:30.77,0:11:34.86,Default,,0,0,0,,Қылмыстық ұйымдар нысанаға алған маңызды тұлғаларға тиесілі заттар
Dialogue: 0,0:11:35.98,0:11:39.74,Default,,0,0,0,,Ал мұндай маңызды адамдарға ортақ нәрсе бар.
Dialogue: 0,0:11:39.82,0:11:42.41,Default,,0,0,0,,Олардың барлығының ерекше қабілеттері бар.
Dialogue: 0,0:11:42.49,0:11:44.62,Default,,0,0,0,,Егер сіз өзіңіз сияқты жақсы болсаңыз,
Dialogue: 0,0:11:44.70,0:11:48.45,Default,,0,0,0,,Сіз сыртқы ұйымнан сұрау алған кезде әрекет еткен болуыңыз мүмкін.
Dialogue: 0,0:11:48.54,0:11:52.04,Default,,0,0,0,,Жақында сізге табиғаттан тыс күші бар адамды ұстау туралы өтініш келді ме?
Dialogue: 0,0:11:52.62,0:11:54.92,Default,,0,0,0,,Клиент туралы айту мүмкін емес
Dialogue: 0,0:11:55.00,0:11:56.59,Default,,0,0,0,,Сұраныс болуы міндетті емес
Dialogue: 0,0:11:56.67,0:11:59.09,Default,,0,0,0,,Жақында осы салада
Dialogue: 0,0:11:59.17,0:12:03.68,Default,,0,0,0,,Сіз табиғаттан тыс күшке ие адамды тірідей ұстау туралы өтініш туралы естідіңіз бе?
Dialogue: 0,0:12:03.76,0:12:08.26,Default,,0,0,0,,Клиент өзін «V» деп атай алады.
Dialogue: 0,0:12:10.64,0:12:13.14,Default,,0,0,0,,Мен олар туралы айтқым келмейді.
Dialogue: 0,0:12:14.44,0:12:17.02,Default,,0,0,0,,Олардың мақсаты не екенін білесіз бе?
Dialogue: 0,0:12:17.11,0:12:17.98,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:18.07,0:12:18.98,Default,,0,0,0,,Бұл жақсы себеп.
Dialogue: 0,0:12:20.15,0:12:26.32,Default,,0,0,0,,Ақша үшін өлтіру Мені жек көретіндіктен өлтіру Мен мұны түсінемін.
Dialogue: 0,0:12:26.41,0:12:32.66,Default,,0,0,0,,Бірақ олар жақсы мақсат үшін өлтіреді, мен олармен ешнәрсе істегім келмейді.
Dialogue: 0,0:12:32.75,0:12:35.88,Default,,0,0,0,,Біз жақсы мақсат үшін өлтірудің түбіне жеткенде
Dialogue: 0,0:12:35.96,0:12:37.96,Default,,0,0,0,,Әрқашан соңында
Dialogue: 0,0:12:38.04,0:12:42.26,Default,,0,0,0,,Сіз кез келген адамды өлтіруге болатын деңгейге жетесіз.
Dialogue: 0,0:12:57.48,0:13:00.82,Default,,0,0,0,,Мен саған оларға қарсы шық деп тұрған жоқпын.
Dialogue: 0,0:13:00.90,0:13:04.24,Default,,0,0,0,,Сол жігіттер бір танысын ұрлап кеткен.
Dialogue: 0,0:13:04.32,0:13:06.78,Default,,0,0,0,,Қамаудың қай жерде екенін түсіндіңіз бе?
Dialogue: 0,0:13:06.86,0:13:09.45,Default,,0,0,0,,Оқытуға себеп жоқ
Dialogue: 0,0:13:09.53,0:13:11.33,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:12.24,0:13:16.50,Default,,0,0,0,,Бірақ саған айту керек болса, сен бүгін таңертең хатшыңды атып өлтірдің.
Dialogue: 0,0:13:16.58,0:13:21.46,Default,,0,0,0,,Төбелес нәтижесінде болған жазатайым оқиға Сіз бұл өзін-өзі қорғау деп куәлік бере аласыз.
Dialogue: 0,0:13:22.63,0:13:25.09,Default,,0,0,0,,Сіз бұл жерден тез арада кетесіз.
Dialogue: 0,0:13:27.18,0:13:28.18,Default,,0,0,0,,Иә
Dialogue: 0,0:13:34.27,0:13:35.68,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:13:36.14,0:13:39.65,Default,,0,0,0,,Әділдікке деген опасыздық сияқты.
Dialogue: 0,0:13:39.73,0:13:42.02,Default,,0,0,0,,Мен сені бизнеспен айналыспайтын түрі деп ойладым.
Dialogue: 0,0:13:42.78,0:13:45.32,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:13:45.90,0:13:47.24,Default,,0,0,0,,Мен
Dialogue: 0,0:13:47.32,0:13:50.28,Default,,0,0,0,,Мен өлтіру жұмысын әрқашан жалғыз орындадым.
Dialogue: 0,0:13:51.03,0:13:54.41,Default,,0,0,0,,Мен ешқашан досты да, бастықты да қалаған емеспін.
Dialogue: 0,0:13:54.50,0:13:55.58,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:55.66,0:13:58.04,Default,,0,0,0,,Сіздей жекпе-жек шебері
Dialogue: 0,0:13:58.12,0:14:01.09,Default,,0,0,0,,Бұл сіздің принциптеріңізге нұқсан келтіретін болса да, сіз мені құтқаруға тырысып жатырсыз.
Dialogue: 0,0:14:01.17,0:14:03.67,Default,,0,0,0,,Сол бағыныңқы адам бақытты адам.
Dialogue: 0,0:14:03.75,0:14:06.59,Default,,0,0,0,,Мен аздап қызғаншақпын
Dialogue: 0,0:14:06.67,0:14:10.01,Default,,0,0,0,,Жоқ, бағыныңқысы емес.
Dialogue: 0,0:14:10.89,0:14:15.18,Default,,0,0,0,,Мен олардың сауда үшін пайдаланатын кейбір ғимараттары туралы естідім.
Dialogue: 0,0:14:16.68,0:14:18.27,Default,,0,0,0,,Сіз келісімді қабылдайсыз ба?
Dialogue: 0,0:14:18.89,0:14:22.31,Default,,0,0,0,,Егер сіз кеткіңіз келсе, әрқашан өз бетіңізше кете аласыз.
Dialogue: 0,0:14:22.40,0:14:25.48,Default,,0,0,0,,Ұсынылған баға сәйкес емес...
Dialogue: 0,0:14:25.99,0:14:29.28,Default,,0,0,0,,Бұл мекемедегі тамақ нашар.
Dialogue: 0,0:14:30.03,0:14:33.95,Default,,0,0,0,,Егер сіз осы жердегі адамдарға құрметпен қарайтын болсаңыз, маған бір нәрсені бұрып жібере аласыз ба?
Dialogue: 0,0:14:34.54,0:14:35.95,Default,,0,0,0,,Үміт бар ма?
Dialogue: 0,0:14:40.33,0:14:41.46,Default,,0,0,0,,Карри
Dialogue: 0,0:14:46.88,0:14:48.72,Default,,0,0,0,,Сіз сенімдісіз бе? Детектив
Dialogue: 0,0:14:49.26,0:14:52.30,Default,,0,0,0,,Біздің ұйым күшті және мінсіз.
Dialogue: 0,0:14:52.89,0:14:55.35,Default,,0,0,0,,Сол секіруші мұғаліммен бірігудің орнына
Dialogue: 0,0:14:55.43,0:14:58.39,Default,,0,0,0,,Менің ойымша, бұл әлдеқайда мағыналы.
Dialogue: 0,0:14:58.48,0:15:00.31,Default,,0,0,0,,Мо
Dialogue: 0,0:15:00.39,0:15:04.86,Default,,0,0,0,,Мені қызықтырмайтын оқиғаларға араласпаймын.
Dialogue: 0,0:15:04.94,0:15:07.78,Default,,0,0,0,,Бәрі де сиырдың бақырғанындай естіледі
Dialogue: 0,0:15:07.86,0:15:09.99,Default,,0,0,0,,Му му
Dialogue: 0,0:15:10.57,0:15:14.37,Default,,0,0,0,,Мен келіссөз жүргізуші болғаным үшін өте бақыттымын.
Dialogue: 0,0:15:14.45,0:15:16.58,Default,,0,0,0,,Басқалар сені аяғыңнан алып кетер еді.
Dialogue: 0,0:15:16.66,0:15:19.12,Default,,0,0,0,,Арамен кесіп тастаса, таң қалмас еді.
Dialogue: 0,0:15:19.20,0:15:21.62,Default,,0,0,0,,Қайтадан жылады.
Dialogue: 0,0:15:21.71,0:15:22.96,Default,,0,0,0,,Мо!
Dialogue: 0,0:15:24.00,0:15:27.71,Default,,0,0,0,,Ақыр соңында, бұл жігітсіз сөйлесуге болмайды, солай ма?
Dialogue: 0,0:15:28.63,0:15:32.13,Default,,0,0,0,,Табиғаттан тыс қабілетпен шындықты көре білу қаншалықты дәрежеде?
Dialogue: 0,0:15:32.22,0:15:35.47,Default,,0,0,0,,Бір оқты да тоқтата алмайтын әлсіз күш.
Dialogue: 0,0:15:35.97,0:15:38.14,Default,,0,0,0,,Сонда да мен басқа адамға осылай қарадым.
Dialogue: 0,0:15:38.22,0:15:41.69,Default,,0,0,0,,Барлығы біздің басты мақсатымыз үшін.
Dialogue: 0,0:15:41.77,0:15:46.94,Default,,0,0,0,,Осы елдің омыртқасын шірітетін паразиттерді жоямын.
Dialogue: 0,0:15:47.02,0:15:48.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:48.98,0:15:53.45,Default,,0,0,0,,Буй табиғаттан тыс қабілетке ие адамдарды жою үшін құрылған адамдар ұйымы ма?
Dialogue: 0,0:15:55.70,0:15:58.08,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:15:59.66,0:16:01.83,Default,,0,0,0,,Менің болжауымша, кейінірек⸺
Dialogue: 0,0:16:01.91,0:16:03.17,Default,,0,0,0,,3 секунд
Dialogue: 0,0:16:03.25,0:16:04.21,Default,,0,0,0,,Ha
Dialogue: 0,0:16:04.29,0:16:06.00,Default,,0,0,0,,2 (Жалдамалы) Гааа!
Dialogue: 0,0:16:06.84,0:16:08.38,Default,,0,0,0,,1
Dialogue: 0,0:16:14.76,0:16:16.93,Default,,0,0,0,,Бір күзетшіні сырттан шығарды.
Dialogue: 0,0:16:17.01,0:16:18.68,Default,,0,0,0,,Тағы нешеу?
Dialogue: 0,0:16:18.76,0:16:20.18,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:16:20.27,0:16:22.02,Default,,0,0,0,,4 адам
Dialogue: 0,0:16:22.10,0:16:24.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:34.41,0:16:36.20,Default,,0,0,0,,Иә! (Жалдамалы) Уау!
Dialogue: 0,0:16:38.91,0:16:40.49,Default,,0,0,0,,Тағы бір адам
Dialogue: 0,0:16:49.25,0:16:50.55,Default,,0,0,0,,Ғажайыптар!
Dialogue: 0,0:16:51.51,0:16:52.72,Default,,0,0,0,,Гах...!
Dialogue: 0,0:17:07.31,0:17:10.02,Default,,0,0,0,,Сіз жарақат алдыңыз ба? (Ранпо) Иә!
Dialogue: 0,0:17:11.28,0:17:13.90,Default,,0,0,0,,Бұл мен күткеннен де көп болды.
Dialogue: 0,0:17:13.99,0:17:16.61,Default,,0,0,0,,Есептерім бойынша уақытында жасаймын...
Dialogue: 0,0:17:28.54,0:17:29.59,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:17:29.67,0:17:32.05,Default,,0,0,0,,Не есептеледі!
Dialogue: 0,0:17:32.13,0:17:33.55,Default,,0,0,0,,Мен секірген кезде
Dialogue: 0,0:17:33.63,0:17:36.68,Default,,0,0,0,,Сіздің алдыңызда көргеніңіз - мылтық аузы!
Dialogue: 0,0:17:36.76,0:17:38.84,Default,,0,0,0,,Өйткені ол міндетті түрде келеді...
Dialogue: 0,0:17:38.93,0:17:41.31,Default,,0,0,0,,Күш-қуатыңды көрсетуге болмайды.
Dialogue: 0,0:17:41.85,0:17:44.73,Default,,0,0,0,,Қиын жауларға қарсы тұру үшін миыңызды пайдаланған дұрыс.
Dialogue: 0,0:17:45.52,0:17:50.52,Default,,0,0,0,,Бірақ өз өміріңді сызып тастауды доғар!
Dialogue: 0,0:17:54.86,0:17:57.82,Default,,0,0,0,,Сен әлі баласың.
Dialogue: 0,0:18:02.16,0:18:04.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:04.50,0:18:06.41,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:06.91,0:18:11.50,Default,,0,0,0,,Кешіріңіз... Кешіріңіз, кешіріңіз!
Dialogue: 0,0:18:11.59,0:18:14.71,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:18:14.80,0:18:18.59,Default,,0,0,0,,Кешіріңіз, кешіріңіз, кешіріңіз, кешіріңіз
Dialogue: 0,0:18:18.68,0:18:20.93,Default,,0,0,0,,Кешіріңіз! кешіріңіз!
Dialogue: 0,0:18:21.01,0:18:22.35,Default,,0,0,0,,Я...
Dialogue: 0,0:18:35.11,0:18:38.57,Default,,0,0,0,,Сержант Митамура қамауда болған кезде өлтірілді.
Dialogue: 0,0:18:38.65,0:18:40.53,Default,,0,0,0,,Бұл үнсіздік.
Dialogue: 0,0:18:42.12,0:18:44.95,Default,,0,0,0,,Іс әлі жалғасып жатыр ма?
Dialogue: 0,0:18:45.04,0:18:50.04,Default,,0,0,0,,Бірақ бұл оқиғаға нағыз кінәлі Буй кім?
Dialogue: 0,0:18:52.92,0:18:54.67,Default,,0,0,0,,«буй» емес
Dialogue: 0,0:18:54.75,0:18:57.71,Default,,0,0,0,,Бұл «бес» дегенмен.
Dialogue: 0,0:19:01.51,0:19:03.80,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:05.14,0:19:06.39,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:06.47,0:19:07.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:08.43,0:19:13.65,Default,,0,0,0,,Күні кешеге дейін көрген пейзажда басқа нәрсе бар деп ойладым.
Dialogue: 0,0:19:14.48,0:19:15.48,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:16.36,0:19:17.94,Default,,0,0,0,,Себебі мен түсінемін
Dialogue: 0,0:19:19.15,0:19:21.16,Default,,0,0,0,,Сізде табиғаттан тыс күштер бар дейсіз бе?
Dialogue: 0,0:19:22.53,0:19:23.95,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:19:24.74,0:19:27.41,Default,,0,0,0,,Маңыздысы...
Dialogue: 0,0:19:33.38,0:19:34.92,Default,,0,0,0,,​​Карри?
Dialogue: 0,0:19:39.34,0:19:40.63,Default,,0,0,0,,Ащы
Dialogue: 0,0:19:40.72,0:19:43.30,Default,,0,0,0,,Бірақ бұл жақсы
Dialogue: 0,0:21:04.55,0:21:09.55,Default,,0,0,0,,~♪
Dialogue: 0,0:21:19.98,0:21:22.65,Default,,0,0,0,,Міне (Ранпо) Мен солай ойлаймын.
Dialogue: 0,0:21:24.03,0:21:26.03,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:33.83,0:21:37.04,Default,,0,0,0,,Bankodo-ға қош келдіңіз
Dialogue: 0,0:21:40.04,0:21:41.04,Default,,0,0,0,,О
Dialogue: 0,0:21:41.13,0:21:45.26,Default,,0,0,0,,Мен жоғалтқан таяқ осы ма?
Dialogue: 0,0:21:45.34,0:21:48.55,Default,,0,0,0,,Мен сен туралы өсек естідім,
Dialogue: 0,0:21:48.64,0:21:52.51,Default,,0,0,0,,Мен сіздің өтінішіңізді қанағаттандыруды өтінуге келдім.
Dialogue: 0,0:21:53.18,0:21:56.81,Default,,0,0,0,,Бұл формальды. Ал, отырыңыз.
Dialogue: 0,0:21:56.89,0:21:58.02,Default,,0,0,0,,Га
Dialogue: 0,0:22:00.61,0:22:04.07,Default,,0,0,0,,Өтірік Мен оны сол кезде түсінбедім
Dialogue: 0,0:22:04.15,0:22:06.19,Default,,0,0,0,,Бұл адам сондай...
Dialogue: 0,0:22:06.28,0:22:08.95,Default,,0,0,0,,Сол бөлім құтқарылды, монах.
Dialogue: 0,0:22:09.03,0:22:10.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:10.37,0:22:13.99,Default,,0,0,0,,Сіз театр тұзағын басынан көрдіңіз.
Dialogue: 0,0:22:14.08,0:22:17.12,Default,,0,0,0,,Сонда да мен тұзаққа түсуге батылым бардым.
Dialogue: 0,0:22:17.21,0:22:21.29,Default,,0,0,0,,Жауды әшкерелеп, оны ұстап алайық
Dialogue: 0,0:22:21.38,0:22:22.63,Default,,0,0,0,,Иә
Dialogue: 0,0:22:22.71,0:22:25.71,Default,,0,0,0,,Қарақұйрық қашып кеткен сияқты.
Dialogue: 0,0:22:25.80,0:22:27.72,Default,,0,0,0,,Менің сізге өтінішім бар.
Dialogue: 0,0:22:28.30,0:22:30.05,Default,,0,0,0,,Білетініңізге сенімдімін.
Dialogue: 0,0:22:30.14,0:22:34.31,Default,,0,0,0,,Бұл Эдогава Ранпо табиғаттан тыс детектив ретінде өзін таныта бастады.
Dialogue: 0,0:22:34.81,0:22:36.18,Default,,0,0,0,,Бірақ бастапқыда
Dialogue: 0,0:22:36.27,0:22:38.98,Default,,0,0,0,,Ерекше қабілеті бар адам тақтайшаны көпшілік алдында ұстайды.
Dialogue: 0,0:22:39.06,0:22:40.06,Default,,0,0,0,,Әлем заңдары
Dialogue: 0,0:22:40.73,0:22:43.27,Default,,0,0,0,,Сондықтан мен сізден көмек сұраймын...
Dialogue: 0,0:22:43.36,0:22:47.36,Default,,0,0,0,,Иә, «ерекше қабілеттерді тәжірибеде қабылдау»?
Dialogue: 0,0:22:47.44,0:22:50.95,Default,,0,0,0,,Сіз компанияны ашқыңыз келеді.
Dialogue: 0,0:22:51.41,0:22:52.37,Default,,0,0,0,,Иә
Dialogue: 0,0:22:53.12,0:22:55.33,Default,,0,0,0,,Арнайы қабілеттер бөлімінен рұқсатты қалай алуға болады
Dialogue: 0,0:22:55.41,0:22:58.83,Default,,0,0,0,,Бұл жер туралы бәрін біледі екенсің, сенің көмегіңмен
Dialogue: 0,0:22:58.91,0:23:00.79,Default,,0,0,0,,Бұл өте қажет.
Dialogue: 0,0:23:01.63,0:23:03.63,Default,,0,0,0,,Нацумэ Сосекидоно
Dialogue: 0,0:23:05.71,0:23:08.26,Default,,0,0,0,,Бұл оңай жол емес.
Dialogue: 0,0:23:09.59,0:23:13.47,Default,,0,0,0,,Бірақ бірдеңе болатын шығар.
Dialogue: 0,0:23:14.05,0:23:16.18,Default,,0,0,0,,Егер сіз
Dialogue: 0,0:23:17.68,0:23:23.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory