Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.00,0:00:12.84,Default,,0,0,0,,Дыбыстан жылдам мерген? Бірақ атыс дыбысы шыққан жоқ.
Dialogue: 0,0:00:15.14,0:00:17.93,Default,,0,0,0,,Ақымақ болма, Детектив!
Dialogue: 0,0:00:19.72,0:00:22.64,Default,,0,0,0,,Мен оны бастықтың бұйрығымен алуға келдім.
Dialogue: 0,0:00:24.73,0:00:27.19,Default,,0,0,0,,Қараңызшы, бұл атыс.
Dialogue: 0,0:00:27.27,0:00:28.90,Default,,0,0,0,,Гравитациялық манипуляция!
Dialogue: 0,0:00:36.45,0:00:37.32,Default,,0,0,0,,Құдай-ай.
Dialogue: 0,0:00:42.37,0:00:43.66,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:00:43.75,0:00:46.62,Default,,0,0,0,,Сіздің қазіргі детективтік агенттікте әріптестер бар ма?
Dialogue: 0,0:00:46.71,0:00:51.71,Default,,0,0,0,,♪~
Dialogue: 0,0:02:11.67,0:02:16.67,Default,,0,0,0,,~♪
Dialogue: 0,0:02:20.76,0:02:23.60,Default,,0,0,0,,Мен ешқашан Порт мафиясынан көмек күткен емеспін.
Dialogue: 0,0:02:23.68,0:02:25.81,Default,,0,0,0,,Анықтама? Ақымақ болма
Dialogue: 0,0:02:25.89,0:02:28.81,Default,,0,0,0,,Компания президенті бастықпен мәміле жасады.
Dialogue: 0,0:02:29.44,0:02:33.23,Default,,0,0,0,,Құтқару бағасы – бір қызметкердің мафияға ауысуы.
Dialogue: 0,0:02:33.73,0:02:36.94,Default,,0,0,0,,Қолдануға оңай табиғаттан тыс қылмыскерлер қабылданады.
Dialogue: 0,0:02:37.03,0:02:38.03,Default,,0,0,0,,Президент?
Dialogue: 0,0:02:38.57,0:02:42.62,Default,,0,0,0,,Жоқ, бірақ бәрі осылай жалғаса берсе, бәрімізді қамауға аламыз.
Dialogue: 0,0:02:42.70,0:02:44.45,Default,,0,0,0,,Йосано мырза да өлтірілді.
Dialogue: 0,0:02:44.53,0:02:45.87,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:02:45.95,0:02:49.54,Default,,0,0,0,,Жалғыз идеализм өмірді сақтай алмайды
Dialogue: 0,0:02:49.62,0:02:51.12,Default,,0,0,0,,Шыншыл болыңыз
Dialogue: 0,0:02:52.21,0:02:54.25,Default,,0,0,0,,Қызық, басынан ұрып қалды ма?
Dialogue: 0,0:02:54.34,0:02:56.59,Default,,0,0,0,,Дене кесілгендіктен болуы мүмкін бе?
Dialogue: 0,0:02:56.67,0:02:59.47,Default,,0,0,0,,Дене? О, дәптер дейсің бе?
Dialogue: 0,0:03:00.30,0:03:02.80,Default,,0,0,0,,Куникида мырза, идеалист
Dialogue: 0,0:03:02.89,0:03:07.35,Default,,0,0,0,,Енді жеңілдедің бе?
Dialogue: 0,0:03:07.43,0:03:09.10,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:03:09.18,0:03:12.15,Default,,0,0,0,,Дос өлсе, идеал жоғалады.
Dialogue: 0,0:03:12.23,0:03:14.27,Default,,0,0,0,,Мен сол күнді күтіп жүрмін бе?
Dialogue: 0,0:03:14.36,0:03:16.98,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:03:20.90,0:03:21.78,Default,,0,0,0,,Егер қарсы болмасаңыз, жол көрсетейін
Dialogue: 0,0:03:26.62,0:03:27.62,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:03:27.70,0:03:28.87,Default,,0,0,0,,Мен қайықты тексеріп бітірдім.
Dialogue: 0,0:03:31.16,0:03:32.50,Default,,0,0,0,,Нашар! Әлгі бейбақ
Dialogue: 0,0:03:32.58,0:03:34.38,Default,,0,0,0,,Мен роторды кесіп тастаймын!
Dialogue: 0,0:03:36.63,0:03:38.09,Default,,0,0,0,,Танизаки
Dialogue: 0,0:03:40.59,0:03:43.47,Default,,0,0,0,,Нағыз қылмыскерді міндетті түрде әшкерелеңіз!
Dialogue: 0,0:03:43.55,0:03:45.55,Default,,0,0,0,,Зұлымдықты дереу жою
Dialogue: 0,0:03:46.26,0:03:47.93,Default,,0,0,0,,Мен оны сұрадым (Танизаки) Ах!
Dialogue: 0,0:03:48.01,0:03:49.14,Default,,0,0,0,,Қарда өрік гүлдейді!
Dialogue: 0,0:03:49.97,0:03:50.89,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:03:54.02,0:03:57.19,Default,,0,0,0,,Ақымақ, мен бұл биіктікте де өлмеймін.
Dialogue: 0,0:03:57.27,0:03:59.69,Default,,0,0,0,,Қылышыңызды қайтадан көтеріп, тікұшақты қуыңыз
Dialogue: 0,0:03:59.78,0:04:01.86,Default,,0,0,0,,Сен ақымақсың
Dialogue: 0,0:04:01.95,0:04:04.36,Default,,0,0,0,,Мен ешкімге менің кестемді бұзуға жол бермеймін!
Dialogue: 0,0:04:04.45,0:04:08.41,Default,,0,0,0,,Сіздің идеалдарыңыз шар сияқты үлкен және биік.
Dialogue: 0,0:04:08.49,0:04:12.87,Default,,0,0,0,,Алайда, шардың жанармайы таусылып, жерге түседі.
Dialogue: 0,0:04:12.96,0:04:16.83,Default,,0,0,0,,Менің атым Доппо Куникида, менің идеалдарым ешқашан құламайды!
Dialogue: 0,0:04:16.92,0:04:20.80,Default,,0,0,0,,Бұл өмірді мәңгі ұшатын отын ретінде пайдаланыңыз!
Dialogue: 0,0:04:30.35,0:04:32.48,Default,,0,0,0,,Куникида мырза!
Dialogue: 0,0:04:39.07,0:04:42.99,Default,,0,0,0,,(Қабырға сағатының сигналы)
Dialogue: 0,0:04:51.87,0:04:53.04,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:55.16,0:04:57.08,Default,,0,0,0,,Киока-чан, жақсысың ба?
Dialogue: 0,0:04:58.29,0:04:59.59,Default,,0,0,0,,Мен аздап шаршадым
Dialogue: 0,0:05:00.17,0:05:01.46,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:01.55,0:05:04.09,Default,,0,0,0,,Екі күн бойы ішпей, қозғалмай тығылдым.
Dialogue: 0,0:05:04.76,0:05:07.09,Default,,0,0,0,,Су мен тағамды іздеу
Dialogue: 0,0:05:07.18,0:05:08.64,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:05:08.72,0:05:12.35,Default,,0,0,0,,Оқиға орнында тексергендердің айтқанын естідім.
Dialogue: 0,0:05:12.43,0:05:14.64,Default,,0,0,0,,Президент қамауға алынды.
Dialogue: 0,0:05:14.73,0:05:19.06,Default,,0,0,0,,Сондай-ақ, қашып жүрген Куникида-сан өзін жарып жіберді, оның өмірі мен өлімі белгісіз.
Dialogue: 0,0:05:21.52,0:05:23.53,Default,,0,0,0,,Неге осындай болды…
Dialogue: 0,0:05:25.32,0:05:28.99,Default,,0,0,0,,Дәл қазір өмір сүру - басымдық
Dialogue: 0,0:05:29.07,0:05:31.16,Default,,0,0,0,,Қандай қорқынышты оқиға.
Dialogue: 0,0:05:31.24,0:05:35.29,Default,,0,0,0,,Үкімет бекіткен детективтік компания перде артында террористік ұйым болып табыла ма?
Dialogue: 0,0:05:35.37,0:05:37.54,Default,,0,0,0,,Бұл адам сенгісіз оқиға.
Dialogue: 0,0:05:37.62,0:05:41.42,Default,,0,0,0,,Қылмыстың бейнежазбалары бар және көптеген куәгерлер бар.
Dialogue: 0,0:05:42.05,0:05:44.05,Default,,0,0,0,,Олардың бұрын шешкен істері
Dialogue: 0,0:05:44.13,0:05:47.30,Default,,0,0,0,,Өздігінен жазылып, орындалу мүмкіндігі жоғары.
Dialogue: 0,0:05:48.76,0:05:52.51,Default,,0,0,0,,Бетіңізді жасырыңыз және алдымен қашу қаражатын қорғаңыз.
Dialogue: 0,0:05:53.06,0:05:55.06,Default,,0,0,0,,Содан кейін пойызбен қашыңыз
Dialogue: 0,0:05:55.14,0:05:57.73,Default,,0,0,0,,Қаш... сосын ше?
Dialogue: 0,0:05:58.52,0:05:59.94,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:06:00.02,0:06:04.65,Default,,0,0,0,,Нағыз қылмыскер Тенжин мен Богиняның жоспары ауқымды және мінсіз.
Dialogue: 0,0:06:05.19,0:06:09.61,Default,,0,0,0,,Біз қылмысты дәлелдеу былай тұрсын, оқиғаның толық суретін де білмейміз.
Dialogue: 0,0:06:09.70,0:06:11.74,Default,,0,0,0,,Шынында да, иә.
Dialogue: 0,0:06:11.82,0:06:16.83,Default,,0,0,0,,Егер бұл аспан мен адамның бес құлдырауының артында тұрған қастандық болса, оған Федордың қатысы болуы керек.
Dialogue: 0,0:06:17.71,0:06:21.04,Default,,0,0,0,,Екеуміздің мұндай құбыжықты жеңу мүмкін емес...
Dialogue: 0,0:06:22.59,0:06:25.13,Default,,0,0,0,,«Жолбарыс күшті, ал сен әлсізсің».
Dialogue: 0,0:06:25.88,0:06:29.01,Default,,0,0,0,,Детектив қызметі маған бірнеше рет көмектесті.
Dialogue: 0,0:06:29.84,0:06:32.64,Default,,0,0,0,,Бірақ мен детективке көмектесе алмаймын.
Dialogue: 0,0:06:32.72,0:06:34.85,Default,,0,0,0,,Сіз бұл деңгейден бас тартасыз ба?
Dialogue: 0,0:06:34.93,0:06:35.97,Default,,0,0,0,,Ах
Dialogue: 0,0:06:41.31,0:06:42.69,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:06:47.15,0:06:48.15,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:48.90,0:06:52.62,Default,,0,0,0,,Бұл жағдайда Дазай-сан не істер еді?
Dialogue: 0,0:06:54.37,0:06:55.49,Default,,0,0,0,,Харизма!
Dialogue: 0,0:06:55.58,0:06:59.08,Default,,0,0,0,,Детектив агенттігінің кінәсіздігін дәлелдейтін бір ғана анықтама бар.
Dialogue: 0,0:07:04.09,0:07:05.63,Default,,0,0,0,,Мушитаро Огури?
Dialogue: 0,0:07:05.71,0:07:09.63,Default,,0,0,0,,Иә, мен Ранпоға оқиғаның алдында ескерттім.
Dialogue: 0,0:07:09.72,0:07:14.89,Default,,0,0,0,,Ол бұл жоспар туралы білген және мен оның нағыз кінәлі тұлғаны білетініне сенімдімін.
Dialogue: 0,0:07:14.97,0:07:18.60,Default,,0,0,0,,Мүмкін детективті қалпына келтірудің бір жолы бар шығар...
Dialogue: 0,0:07:18.68,0:07:23.06,Default,,0,0,0,,Бірақ қазір ол жоқ, оны қалай табамын?
Dialogue: 0,0:07:23.15,0:07:25.02,Default,,0,0,0,,Бір жолы бар
Dialogue: 0,0:07:25.11,0:07:26.69,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:07:26.77,0:07:28.19,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:07:29.57,0:07:31.90,Default,,0,0,0,,Фрэнсистің Құдайдың көзі?
Dialogue: 0,0:07:34.20,0:07:37.58,Default,,0,0,0,,Бірақ жақсы ма? Ол кісі бұрынғы жау
Dialogue: 0,0:07:37.66,0:07:40.04,Default,,0,0,0,,Олар бізді полицияға сатуы мүмкін
Dialogue: 0,0:07:40.12,0:07:42.62,Default,,0,0,0,,Мен бәрібір тыңдаймын дедім.
Dialogue: 0,0:07:45.84,0:07:49.71,Default,,0,0,0,,«Каннибализмде» Дазай-сан оны сәтті ынтымақтастыққа шақырды.
Dialogue: 0,0:07:49.80,0:07:52.47,Default,,0,0,0,,Бізде де жақсылық жасаудан басқа амал жоқ.
Dialogue: 0,0:07:57.43,0:07:58.51,Default,,0,0,0,,Ах
Dialogue: 0,0:07:59.56,0:08:01.23,Default,,0,0,0,,Бұл қанның иісі.
Dialogue: 0,0:08:05.90,0:08:07.65,Default,,0,0,0,,Амансың ба!?
Dialogue: 0,0:08:07.73,0:08:09.44,Default,,0,0,0,,Егер мені өлтірсең, сен де менің сияқты қарғыс атқан жанға айналасың.
Dialogue: 0,0:08:09.53,0:08:12.40,Default,,0,0,0,,Менде бәрі жақсы, тезірек
Dialogue: 0,0:08:12.49,0:08:14.41,Default,,0,0,0,,Фрэнсис...
Dialogue: 0,0:08:14.49,0:08:15.91,Default,,0,0,0,,Дос қызды сұрау
Dialogue: 0,0:08:22.21,0:08:25.75,Default,,0,0,0,,Сіз дініңізді біршама өзгерттіңіз, пастор.
Dialogue: 0,0:08:25.83,0:08:29.05,Default,,0,0,0,,Менің сүйікті ханшайымым үшін
Dialogue: 0,0:08:29.13,0:08:30.63,Default,,0,0,0,,Нысанаға өлім
Dialogue: 0,0:08:30.71,0:08:32.80,Default,,0,0,0,,Сіз Маргарет туралы айтып отырсыз ба?
Dialogue: 0,0:08:32.88,0:08:35.93,Default,,0,0,0,,Бәрін ұмытсам да, оны құтқарғым келеді.
Dialogue: 0,0:08:36.01,0:08:37.89,Default,,0,0,0,,Бұл бір жылататын әңгіме.
Dialogue: 0,0:08:37.97,0:08:41.52,Default,,0,0,0,,Әйтсе де, менің бетімді ұмытудың бұл ақымақтығы
Dialogue: 0,0:08:41.60,0:08:43.10,Default,,0,0,0,,Сіз өлуге лайықсыз!
Dialogue: 0,0:08:43.73,0:08:46.60,Default,,0,0,0,,Денеңізді күшейтіңіз! 50 000 доллар!
Dialogue: 0,0:09:03.87,0:09:05.62,Default,,0,0,0,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:09:07.00,0:09:11.05,Default,,0,0,0,,Күшті Бұрынғы кәсіподақ басшысы күткендей
Dialogue: 0,0:09:11.13,0:09:14.63,Default,,0,0,0,,Бірақ өлтіруші қазір неліктен осында?
Dialogue: 0,0:09:15.47,0:09:17.64,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:20.68,0:09:22.06,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:22.14,0:09:25.73,Default,,0,0,0,,Порт-мафия жасырынатын жерде тұрудың жайлылығы қандай?
Dialogue: 0,0:09:25.81,0:09:30.02,Default,,0,0,0,,Сіз иттерден бір аптаға жуық жасырынуыңыз керек.
Dialogue: 0,0:09:30.11,0:09:31.19,Default,,0,0,0,,Мори мырза
Dialogue: 0,0:09:31.27,0:09:34.90,Default,,0,0,0,,Куникида жарылғаннан кейін оның қауіпсіз екенін білесіз бе?
Dialogue: 0,0:09:34.99,0:09:39.37,Default,,0,0,0,,Өкінішке орай, менің білгенім Дазай-кунның әңгімесі болды.
Dialogue: 0,0:09:41.53,0:09:46.29,Default,,0,0,0,,Дазай-кунды барымта алдында ит иттер тұтқындаған.
Dialogue: 0,0:09:46.37,0:09:50.04,Default,,0,0,0,,Әскери полициядан Әділет және қоғамдық қауіпсіздік министрлігіне ауыстырылған қызметкерлер
Dialogue: 0,0:09:50.13,0:09:54.17,Default,,0,0,0,,Алда не күтіп тұрғаны белгісіз...
Dialogue: 0,0:09:54.26,0:09:56.67,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:09:57.88,0:09:59.89,Default,,0,0,0,,Детективті кінәсіз деп айтасыз ба?
Dialogue: 0,0:09:59.97,0:10:01.39,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:10:01.47,0:10:02.85,Default,,0,0,0,,Олай болса, теледидарда.
Dialogue: 0,0:10:02.93,0:10:05.22,Default,,0,0,0,,Кепілге алынған адамды өлтірген видео қандай?
Dialogue: 0,0:10:05.31,0:10:08.69,Default,,0,0,0,,Мен алданып қалдым. Ұйымдастырушы - Тенжин Гошу.
Dialogue: 0,0:10:09.31,0:10:11.73,Default,,0,0,0,,Бұл қастандыққа Федордың да қатысы бар екені...
Dialogue: 0,0:10:21.95,0:10:25.54,Default,,0,0,0,,Егер оқиға рас болса,
Dialogue: 0,0:10:25.62,0:10:27.62,Default,,0,0,0,,Детектив жұмысы аяқталды.
Dialogue: 0,0:10:27.71,0:10:30.37,Default,,0,0,0,,Федорды жеңу мүмкін емес.
Dialogue: 0,0:10:30.46,0:10:31.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:31.92,0:10:35.46,Default,,0,0,0,,Қазір ол Еуропадағы табиғаттан тыс түрмеде.
Dialogue: 0,0:10:35.55,0:10:38.30,Default,,0,0,0,,«Мерсо» түрмесінде
Dialogue: 0,0:10:39.05,0:10:41.76,Default,,0,0,0,,Мерсоның өмір сүруінің өзі мемлекеттік құпия болып табылады.
Dialogue: 0,0:10:41.84,0:10:45.22,Default,,0,0,0,,Нақты орналасқан жерді еуропалық үкіметтің ең жоғары деңгейлері ғана біледі.
Dialogue: 0,0:10:45.85,0:10:50.69,Default,,0,0,0,,Әрине, қол жеткізу мүмкін емес; бұл әлемдегі ең қауіпсіз баспана, былайша айтқанда.
Dialogue: 0,0:10:51.40,0:10:52.40,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:10:52.48,0:10:55.07,Default,,0,0,0,,«Құдайдың көзі» детектив мекемесі пайдаланған кезде
Dialogue: 0,0:10:55.15,0:10:56.90,Default,,0,0,0,,Бұл біраз қиындық туғызады.
Dialogue: 0,0:10:56.98,0:11:00.20,Default,,0,0,0,,Мен иесін алып тастауым керек пе?
Dialogue: 0,0:11:01.82,0:11:02.82,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:02.91,0:11:06.04,Default,,0,0,0,,Егер ол түрмеде болса, ол сыртта нұсқау бере алмайды.
Dialogue: 0,0:11:06.12,0:11:09.29,Default,,0,0,0,,Мұндай жұмыс оның ең жақсысы.
Dialogue: 0,0:11:10.92,0:11:12.25,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:11:12.33,0:11:14.71,Default,,0,0,0,,Оны жеңу мүмкін емес
Dialogue: 0,0:11:14.79,0:11:16.21,Default,,0,0,0,,Мысалы,
Dialogue: 0,0:11:16.30,0:11:19.67,Default,,0,0,0,,Тек ол шахматтағыдай фигураларды қозғалыста ұстай алады.
Dialogue: 0,0:11:19.76,0:11:21.55,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:11:23.89,0:11:25.01,Default,,0,0,0,,Spell Bullet!
Dialogue: 0,0:11:27.01,0:11:30.14,Default,,0,0,0,,Субұрқақ ішке кіргенде қан құйдың ба?
Dialogue: 0,0:11:30.23,0:11:32.85,Default,,0,0,0,,Денеңізді нығайтуға тым кеш
Dialogue: 0,0:11:32.94,0:11:34.15,Default,,0,0,0,,Өлген
Dialogue: 0,0:11:35.19,0:11:36.61,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:38.03,0:11:40.28,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:11:41.40,0:11:44.66,Default,,0,0,0,,Енді сіз Құдайдың көздерін пайдалана алмайсыз.
Dialogue: 0,0:11:44.74,0:11:48.08,Default,,0,0,0,,Менде тамаша жоспар болса да...
Dialogue: 0,0:11:48.83,0:11:51.54,Default,,0,0,0,,Кемелділік қызықсыз, солай емес пе?
Dialogue: 0,0:11:51.62,0:11:52.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:56.59,0:11:58.38,Default,,0,0,0,,Жаңа тұтқын?
Dialogue: 0,0:12:05.09,0:12:09.14,Default,,0,0,0,,Қан оқтарын сұйылту және еріту үшін су шашыратқышты іске қосты.
Dialogue: 0,0:12:09.22,0:12:10.60,Default,,0,0,0,,Киока-чан
Dialogue: 0,0:12:10.68,0:12:12.64,Default,,0,0,0,,Сіз мұны істедіңіз бе?
Dialogue: 0,0:12:12.73,0:12:15.56,Default,,0,0,0,,Бірақ қан талмасының болғанын қайдан білдің?
Dialogue: 0,0:12:15.65,0:12:19.28,Default,,0,0,0,,Мен баспалдақтың астында болған кезде дисплейде ескерту хабары пайда болды.
Dialogue: 0,0:12:20.61,0:12:24.36,Default,,0,0,0,,Қастандық жойылды, Маджин мырза.
Dialogue: 0,0:12:26.70,0:12:28.62,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:12:28.70,0:12:32.37,Default,,0,0,0,,Сіз детективті құтқару үшін әдейі тұтқындалдыңыз, солай ма?
Dialogue: 0,0:12:32.46,0:12:37.00,Default,,0,0,0,,Сіздің айла-тәсіліңізді көрудің жалғыз жолы - осында отыру.
Dialogue: 0,0:12:37.08,0:12:40.88,Default,,0,0,0,,Осындай жерде шахмат серіктесімен бата алу.
Dialogue: 0,0:12:45.63,0:12:49.18,Default,,0,0,0,,Директор Танеда 40 сағаттан кейін оянады деп күтілуде.
Dialogue: 0,0:12:49.72,0:12:52.68,Default,,0,0,0,,Операция сәтті өтсе...
Dialogue: 0,0:12:52.77,0:12:56.65,Default,,0,0,0,,Чикушо Неліктен директор тағы да жаумен оңаша қалды?
Dialogue: 0,0:12:57.19,0:13:00.36,Default,,0,0,0,,Ескортпен кездессек, бұл болмайды...
Dialogue: 0,0:13:00.44,0:13:03.53,Default,,0,0,0,,Өйткені кінәлінің жағдайы солай болды.
Dialogue: 0,0:13:03.61,0:13:05.57,Default,,0,0,0,,Бір-бірімен оңаша кездесу
Dialogue: 0,0:13:05.65,0:13:07.95,Default,,0,0,0,,Тұзақ ұсынысы дегенді қалай түсінесіңдер?
Dialogue: 0,0:13:08.03,0:13:09.58,Default,,0,0,0,,Ақпарат үшін
Dialogue: 0,0:13:09.66,0:13:11.58,Default,,0,0,0,,Директордың ерекше қабілеттері
Dialogue: 0,0:13:11.66,0:13:15.46,Default,,0,0,0,,Жақын жерде белсендірілген ерекше қабілеттердің мазмұнын түсіну қабілеті.
Dialogue: 0,0:13:15.54,0:13:20.54,Default,,0,0,0,,Сондықтан, директор өзінің табиғаттан тыс күштері бар көптеген адамдарды өлтіргеніне сенімді болды.
Dialogue: 0,0:13:20.63,0:13:21.84,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:23.09,0:13:25.55,Default,,0,0,0,,Кінәлі тәкаппаррақ болды.
Dialogue: 0,0:13:27.80,0:13:31.18,Default,,0,0,0,,Мен директордан сұраймын. Мен сайтқа жауапты боламын.
Dialogue: 0,0:13:31.26,0:13:34.14,Default,,0,0,0,,Мен оянғанша қасымда болсаң жақсы болар еді...
Dialogue: 0,0:13:34.23,0:13:38.19,Default,,0,0,0,,Жоқ, мен директормен жақсы қарым-қатынаста емеспін.
Dialogue: 0,0:13:39.15,0:13:42.15,Default,,0,0,0,,Комиссар адам өмірін санмен қарастырады.
Dialogue: 0,0:13:42.23,0:13:45.86,Default,,0,0,0,,100 адамды құтқару үшін бір адамды құрбан ет
Dialogue: 0,0:13:47.15,0:13:49.20,Default,,0,0,0,,Маған бұл ұнамады.
Dialogue: 0,0:13:50.41,0:13:53.24,Default,,0,0,0,,Тенжин Госейді тапсаңыз, өлтіріңіз.
Dialogue: 0,0:13:53.33,0:13:55.75,Default,,0,0,0,,Бірақ заң...
Dialogue: 0,0:13:55.83,0:13:56.71,Default,,0,0,0,,Анго
Dialogue: 0,0:13:56.79,0:13:58.92,Default,,0,0,0,,Арнайы істер бөлімінің міндеті қандай?
Dialogue: 0,0:13:59.92,0:14:01.13,Default,,0,0,0,,Бейбітшілік және
Dialogue: 0,0:14:01.21,0:14:06.17,Default,,0,0,0,,Бейбітшілік бақытын көп адам көрсін.
Dialogue: 0,0:14:06.26,0:14:09.34,Default,,0,0,0,,Заңды білесің бе? Бейбітшілік үшін
Dialogue: 0,0:14:09.43,0:14:12.05,Default,,0,0,0,,Жақсы адам болсаң да
Dialogue: 0,0:14:13.01,0:14:14.81,Default,,0,0,0,,Біреу өлсін
Dialogue: 0,0:14:14.89,0:14:17.89,Default,,0,0,0,,Мен ештеңе түсінбедім
Dialogue: 0,0:14:17.98,0:14:21.86,Default,,0,0,0,,Директор бейбітшілік үшін өлуге дайын адамдар үшін дейді.
Dialogue: 0,0:14:21.94,0:14:24.98,Default,,0,0,0,,Режиссердің өз өмірін қосқанда
Dialogue: 0,0:14:25.57,0:14:29.24,Default,,0,0,0,,Директор оянғанда, істің шешімі туралы баяндайды.
Dialogue: 0,0:14:29.32,0:14:31.03,Default,,0,0,0,,Кінәлі
Dialogue: 0,0:14:31.78,0:14:33.70,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:14:33.78,0:14:37.62,Default,,0,0,0,,Қызықты проблемалық кеңес беру кездесуі
Dialogue: 0,0:14:37.71,0:14:40.33,Default,,0,0,0,,Сонымен, мен, Федор, жүргізуші боламын.
Dialogue: 0,0:14:40.42,0:14:42.67,Default,,0,0,0,,Иә, күтіңіз, күте тұрыңыз.
Dialogue: 0,0:14:42.75,0:14:44.38,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:14:44.46,0:14:45.84,Default,,0,0,0,,Не?
Dialogue: 0,0:14:45.92,0:14:47.17,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:14:47.26,0:14:50.38,Default,,0,0,0,,А... менімен кеңесіңізші.
Dialogue: 0,0:14:50.47,0:14:52.89,Default,,0,0,0,,Жылдам түсінгеніңіз үшін рахмет.
Dialogue: 0,0:14:52.97,0:14:57.60,Default,,0,0,0,,Туа біткен интеллектіміздің арқасында біз басқа адамдардың ойын оқи аламыз.
Dialogue: 0,0:14:57.68,0:15:02.40,Default,,0,0,0,,Демек, басқалармен кеңесу әрекетін жасауға болмайды.
Dialogue: 0,0:15:02.48,0:15:06.40,Default,,0,0,0,,Басқа адамның миы сіздікі сияқты болмаса.
Dialogue: 0,0:15:06.48,0:15:10.78,Default,,0,0,0,,Сондықтан, осы мүмкіндікті пайдаланып, өз уайымымызбен бөлісу идеясы.
Dialogue: 0,0:15:10.86,0:15:13.07,Default,,0,0,0,,Олай болса, алдымен сен.
Dialogue: 0,0:15:13.16,0:15:14.12,Default,,0,0,0,,Сонымен
Dialogue: 0,0:15:14.20,0:15:18.08,Default,,0,0,0,,Менің қарамағындағылар әрқашан нұсқауларды күтеді және тәуелсіздікке ие болмайды.
Dialogue: 0,0:15:18.16,0:15:21.83,Default,,0,0,0,,Мен қалай өз бетімен әрекет ететін тамаша бағынушы бола аламын?
Dialogue: 0,0:15:21.92,0:15:24.71,Default,,0,0,0,,Күнде ештеңе істемей, жай ғана отыра берсең, жалқау болсаң
Dialogue: 0,0:15:24.79,0:15:28.71,Default,,0,0,0,,Іс бұрынғыдай болмайды деп ойлайтын бағыныштыларым өз бетінше күш салады.
Dialogue: 0,0:15:28.80,0:15:30.59,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:30.67,0:15:32.22,Default,,0,0,0,,Келесі мен
Dialogue: 0,0:15:32.30,0:15:33.30,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:15:33.39,0:15:37.47,Default,,0,0,0,,Мен кофеханадағы даяшы әйелді баурап алайын десем де, ол мені иландырмайды.
Dialogue: 0,0:15:37.56,0:15:39.52,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:15:39.60,0:15:43.65,Default,,0,0,0,,Жұмысыңыз бен үйіңізден айырылсаңыз, отбасыңызды алдап, ажырасуға мәжбүрлеңіз.
Dialogue: 0,0:15:43.73,0:15:46.23,Default,,0,0,0,,Мен саған арғы жағынан жабысамын
Dialogue: 0,0:15:46.90,0:15:48.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:48.19,0:15:50.19,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:15:52.45,0:15:55.12,Default,,0,0,0,,Енді бір уақытта сұрақтар қояйық.
Dialogue: 0,0:15:55.20,0:15:56.62,Default,,0,0,0,,...
Dialogue: 0,0:15:56.70,0:15:58.04,Default,,0,0,0,,Сіздің (Дазай) сіздің
Dialogue: 0,0:15:58.87,0:16:01.75,Default,,0,0,0,,Мен сыртқы тараптармен қалай байланысу керектігін білгім келеді
Dialogue: 0,0:16:02.46,0:16:04.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:04.17,0:16:08.21,Default,,0,0,0,,Әрине, егер сіз басқа адамнан бұрын байланыс құралдарын анықтасаңыз.
Dialogue: 0,0:16:08.30,0:16:12.76,Default,,0,0,0,,Сырттағы достардан байланыс құралдарын ажыратуды сұраңыз.
Dialogue: 0,0:16:12.84,0:16:13.97,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:16:14.05,0:16:15.64,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:16:15.72,0:16:18.72,Default,,0,0,0,,Менің байланыс құралдарым арқылы көре алмайсың.
Dialogue: 0,0:16:18.81,0:16:20.77,Default,,0,0,0,,Мен оны қарап шығамын
Dialogue: 0,0:16:20.85,0:16:22.94,Default,,0,0,0,,Мен сол үшін келдім
Dialogue: 0,0:16:23.98,0:16:25.44,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:25.52,0:16:28.82,Default,,0,0,0,,Кінәсіздікті дәлелдейтін жалғыз дәлел
Dialogue: 0,0:16:28.90,0:16:31.65,Default,,0,0,0,,Мушитару деген адам.
Dialogue: 0,0:16:31.74,0:16:33.57,Default,,0,0,0,,Бұл Мушитаро.
Dialogue: 0,0:16:33.65,0:16:37.37,Default,,0,0,0,,Оны таситын көлік жолдан табылды.
Dialogue: 0,0:16:37.87,0:16:40.87,Default,,0,0,0,,Көлікте полиция қызметкерінің мәйіті ғана қалды.
Dialogue: 0,0:16:40.95,0:16:42.71,Default,,0,0,0,,Мушитароның қанының ізі жоқ
Dialogue: 0,0:16:42.79,0:16:45.62,Default,,0,0,0,,Жау шапқан болар
Dialogue: 0,0:16:45.71,0:16:49.25,Default,,0,0,0,,Оны іздеу үшін Құдайдың көздері?
Dialogue: 0,0:16:51.26,0:16:54.30,Default,,0,0,0,,Қарсы емеспін, әрине тегін емес.
Dialogue: 0,0:16:54.38,0:16:55.80,Default,,0,0,0,,Қандай шарттар бар?
Dialogue: 0,0:16:55.88,0:16:59.10,Default,,0,0,0,,Негізі мен Маргаретті тірілткім келеді.
Dialogue: 0,0:16:59.18,0:17:02.27,Default,,0,0,0,,Маргарет... сіздің бағыныштыңыз ба?
Dialogue: 0,0:17:02.35,0:17:05.02,Default,,0,0,0,,Ол қазір комада жатыр.
Dialogue: 0,0:17:05.10,0:17:08.11,Default,,0,0,0,,Оны детективтік агенттіктің әйел дәрігерінің ерекше қабілетімен жандандырыңыз.
Dialogue: 0,0:17:08.69,0:17:09.82,Default,,0,0,0,,Йосано мырзаға?
Dialogue: 0,0:17:09.90,0:17:11.36,Default,,0,0,0,,Маргарет,
Dialogue: 0,0:17:11.44,0:17:14.07,Default,,0,0,0,,Натаниелді өлтіре алатын жалғыз адам.
Dialogue: 0,0:17:15.40,0:17:17.53,Default,,0,0,0,,Сіз шабуылды бұрын көрдіңіз.
Dialogue: 0,0:17:17.61,0:17:20.53,Default,,0,0,0,,Натаниэль тышқанның пешкасына айналды.
Dialogue: 0,0:17:20.62,0:17:23.20,Default,,0,0,0,,Бірақ тек оның есінде
Dialogue: 0,0:17:23.29,0:17:25.41,Default,,0,0,0,,Оны құтқаруға деген құштарлық
Dialogue: 0,0:17:25.50,0:17:28.88,Default,,0,0,0,,Сіз оны түсініксіз қылмыс жасауға итермелеп жатырсыз.
Dialogue: 0,0:17:28.96,0:17:30.63,Default,,0,0,0,,Оны пайдаланыңыз
Dialogue: 0,0:17:30.71,0:17:33.63,Default,,0,0,0,,Бірақ Маргарет ауыр жарақат алды.
Dialogue: 0,0:17:33.71,0:17:36.76,Default,,0,0,0,,Натаниелді қорғау үшін өз өмірін қатерге тіккендіктен бе?
Dialogue: 0,0:17:36.88,0:17:38.18,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:38.26,0:17:42.39,Default,,0,0,0,,Сіз бірін-бірі құтқармақ болған екі адамды бір-бірін өлтіруге мәжбүрледіңіз бе?
Dialogue: 0,0:17:42.47,0:17:43.89,Default,,0,0,0,,Өте рахмет. Енді барамын.
Dialogue: 0,0:17:43.97,0:17:45.89,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:17:45.98,0:17:48.44,Default,,0,0,0,,Сіз Моби Дикті көшеге түсіріп жібердіңіз
Dialogue: 0,0:17:48.52,0:17:50.94,Default,,0,0,0,,Жүздеген мың адамның өмірін қимақ болды.
Dialogue: 0,0:17:51.02,0:17:52.44,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:17:52.52,0:17:54.99,Default,,0,0,0,,Сіз қате адаммен транзакция жасаған болуыңыз мүмкін.
Dialogue: 0,0:17:56.90,0:17:57.91,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:17:57.99,0:18:01.83,Default,,0,0,0,,Мен осылай мәміле жасасам, президент мені сөгетін сияқты.
Dialogue: 0,0:18:01.91,0:18:03.87,Default,,0,0,0,,Келіссөздер бұзылды ма?
Dialogue: 0,0:18:03.95,0:18:04.95,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:05.04,0:18:08.67,Default,,0,0,0,,Бірақ мен кетпес бұрын сізге бір нәрсе көрсеткім келеді.
Dialogue: 0,0:18:13.38,0:18:16.34,Default,,0,0,0,,Мен сізді Маргаретпен таныстыруға рұқсат етіңіз.
Dialogue: 0,0:18:20.97,0:18:22.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:23.31,0:18:24.72,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:18:24.81,0:18:26.93,Default,,0,0,0,,Гильдия банкрот болған кезде
Dialogue: 0,0:18:27.02,0:18:31.61,Default,,0,0,0,,Мені санитарлық талаптарға сай келмейтін қара дəрігерлерге қаратуға жібергендіктен, белгілерім нашарлады.
Dialogue: 0,0:18:32.36,0:18:35.61,Default,,0,0,0,,Ол бірінші кезекте гильдияның қауіпті миссиясына ерікті болды.
Dialogue: 0,0:18:35.69,0:18:38.82,Default,,0,0,0,,Сыйлықпен отбасын қалпына келтіру.
Dialogue: 0,0:18:38.90,0:18:42.49,Default,,0,0,0,,Бұл енді өткінші арман, бірақ...
Dialogue: 0,0:18:42.57,0:18:45.99,Default,,0,0,0,,Егер ол қазір сөйлесе алатын болса, ол осылай айтар еді
Dialogue: 0,0:18:46.08,0:18:48.41,Default,,0,0,0,,Бұл өмірді қолдау жүйесін дереу өшіріңіз.
Dialogue: 0,0:18:48.50,0:18:52.96,Default,,0,0,0,,Барлық медициналық шығындарды менің туған еліме аударуды сұраймын.
Dialogue: 0,0:19:03.72,0:19:06.56,Default,,0,0,0,,Got it, let's make a deal.
Dialogue: 0,0:19:10.10,0:19:11.73,Default,,0,0,0,,Бұл шынымен де жақсы болды ма?
Dialogue: 0,0:19:12.23,0:19:13.90,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:13.98,0:19:15.77,Default,,0,0,0,,Біреудің қиналып жатқанын көргенде
Dialogue: 0,0:19:16.78,0:19:19.36,Default,,0,0,0,,Everyone looks like their old selves
Dialogue: 0,0:19:21.66,0:19:22.95,Default,,0,0,0,,Мен оны жалғыз қалдыра алмаймын
Dialogue: 0,0:19:37.71,0:19:40.26,Default,,0,0,0,,You think that's fine.
Dialogue: 0,0:19:41.05,0:19:42.13,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:43.26,0:19:46.39,Default,,0,0,0,,Йосано мырза мен оның достары аман деп үміттенемін...
Dialogue: 0,0:19:46.47,0:19:48.10,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,0:19:48.18,0:19:52.14,Default,,0,0,0,,Детективтің кінәсіздігін дәлелдеуге көмектесе аласыз ба?
Dialogue: 0,0:19:52.23,0:19:55.15,Default,,0,0,0,,Иә, Фукузава мырзамен мәміле
Dialogue: 0,0:19:55.23,0:19:58.82,Default,,0,0,0,,Біреуіңіздің мафияға ауысқаныңызға айырбас.
Dialogue: 0,0:19:58.90,0:20:01.36,Default,,0,0,0,,Just to keep you safe.
Dialogue: 0,0:20:01.45,0:20:03.45,Default,,0,0,0,,Бір қызметкердің ауысуы?
Dialogue: 0,0:20:03.53,0:20:06.03,Default,,0,0,0,,Мені күлдірмеңіз! мақсатың не
Dialogue: 0,0:20:06.12,0:20:08.87,Default,,0,0,0,,All you have to do is get me!
Dialogue: 0,0:20:09.83,0:20:12.50,Default,,0,0,0,,Иә, бірақ бұл не?
Dialogue: 0,0:20:12.58,0:20:15.50,Default,,0,0,0,,Lord Fukuzawa made the deal knowing this.
Dialogue: 0,0:20:15.58,0:20:17.92,Default,,0,0,0,,Президенттің бұлай айтуы мүмкін емес.
Dialogue: 0,0:20:20.34,0:20:24.13,Default,,0,0,0,,Мен детектив қызметкерлерін қорғауға қатысты мәселені алдым.
Dialogue: 0,0:20:24.84,0:20:26.80,Default,,0,0,0,,But to attack that hound
Dialogue: 0,0:20:26.89,0:20:30.14,Default,,0,0,0,,Олар Порт мафиясының бір бөлігі болса да, бұл өте зорлық-зомбылық әрекеті, солай емес пе?
Dialogue: 0,0:20:30.22,0:20:31.73,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:20:31.81,0:20:36.15,Default,,0,0,0,,Порт мафиясына бір детектив қызметкерін ауыстыру
Dialogue: 0,0:20:36.23,0:20:39.15,Default,,0,0,0,,Бұл кенеттен төлеуге болмайтын баға.
Dialogue: 0,0:20:40.44,0:20:41.82,Default,,0,0,0,,Шарттар қолданылады.
Dialogue: 0,0:20:41.90,0:20:43.78,Default,,0,0,0,,Йосано-кун, таңдама.
Dialogue: 0,0:20:43.86,0:20:45.91,Default,,0,0,0,,Ол сіздің көмекшіңіз бе?
Dialogue: 0,0:20:46.78,0:20:48.37,Default,,0,0,0,,Қайта шыдай алмаймын
Dialogue: 0,0:20:50.08,0:20:51.20,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:20:51.29,0:20:54.62,Default,,0,0,0,,Лорд Фукузава сізді ұсына алатынын айтты.
Dialogue: 0,0:20:54.71,0:20:55.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:59.96,0:21:00.96,Default,,0,0,0,,Босс
Dialogue: 0,0:21:01.05,0:21:03.22,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:21:03.30,0:21:05.84,Default,,0,0,0,,Бұл радио кіреберісте.
Dialogue: 0,0:21:05.93,0:21:08.51,Default,,0,0,0,,How are you doing? ескі спорт
Dialogue: 0,0:21:08.60,0:21:11.60,Default,,0,0,0,,Менің уақытым жоқ, сондықтан қысқаша айтайын.
Dialogue: 0,0:21:11.68,0:21:14.02,Default,,0,0,0,,Мен саған Риканто баласын жібердім.
Dialogue: 0,0:21:14.10,0:21:17.06,Default,,0,0,0,,Recanto? Бұл Атсуши.
Dialogue: 0,0:21:17.15,0:21:18.65,Default,,0,0,0,,Ол тірі болды.
Dialogue: 0,0:21:18.73,0:21:20.15,Default,,0,0,0,,Why does the boy come?
Dialogue: 0,0:21:20.23,0:21:23.90,Default,,0,0,0,,Бұл мәміле. Мен үшін емдік күштеріңізді пайдаланыңыз.
Dialogue: 0,0:21:23.99,0:21:27.66,Default,,0,0,0,,Оның орнына мен сізге детектив қызметінің жандануына әкелетін ақпарат беремін.
Dialogue: 0,0:21:27.74,0:21:30.37,Default,,0,0,0,,20 минуттан кейін 5-ші көшеде кездесіңіз.
Dialogue: 0,0:21:30.45,0:21:31.62,Default,,0,0,0,,(Радионы ажырату дыбысы)
Dialogue: 0,0:21:31.70,0:21:34.00,Default,,0,0,0,,Бұл детективтік агенттіктің қайта жандануының белгісі.
Dialogue: 0,0:21:34.08,0:21:35.37,Default,,0,0,0,,Енді үміт бар...
Dialogue: 0,0:21:35.46,0:21:37.33,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:21:37.42,0:21:40.38,Default,,0,0,0,,Бұл жасырынған жерді ол қалай ашты?
Dialogue: 0,0:21:40.88,0:21:43.67,Default,,0,0,0,,Бұл Құдайдың көзі сияқты...
Dialogue: 0,0:21:43.76,0:21:44.97,Default,,0,0,0,,(Изуку) Қалай болғанда да, мен...
Dialogue: 0,0:21:45.05,0:21:47.47,Default,,0,0,0,,Осы жасырынған жерді таба алсаңыз
Dialogue: 0,0:21:47.55,0:21:50.72,Default,,0,0,0,,Сізге детективтік агенттікпен емес, әскери полициямен жұмыс істеу керек шығар.
Dialogue: 0,0:21:50.80,0:21:52.68,Default,,0,0,0,,Әлсіреген детектив мекемесінен
Dialogue: 0,0:21:52.76,0:21:56.69,Default,,0,0,0,,Өзіңнің жақсылығыңды күшті итке сату тиімдірек.
Dialogue: 0,0:21:56.77,0:21:58.90,Default,,0,0,0,,Мен білетін Фрэнсис
Dialogue: 0,0:21:58.98,0:22:02.90,Default,,0,0,0,,Күшті жаққа, жеңіске жетуге болатын жағына шыққан адам.
Dialogue: 0,0:22:04.36,0:22:05.65,Default,,0,0,0,,Бұл транзакция
Dialogue: 0,0:22:06.45,0:22:08.16,Default,,0,0,0,,Бұл қақпан емес пе?
Dialogue: 0,0:23:34.12,0:23:38.83,Default,,0,0,0,,~♪
Dialogue: 0,0:23:40.33,0:23:46.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory