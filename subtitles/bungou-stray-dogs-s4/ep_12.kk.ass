Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.72,0:00:18.56,Default,,0,0,0,,О
Dialogue: 0,0:00:18.64,0:00:20.85,Default,,0,0,0,,Бүгін мен оны шешуім керек.
Dialogue: 0,0:00:20.93,0:00:23.35,Default,,0,0,0,,(Йоконың айқайы)
Dialogue: 0,0:00:23.44,0:00:24.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:24.69,0:00:27.69,Default,,0,0,0,,А... бейбақ! Не қарап тұрсың?
Dialogue: 0,0:00:27.77,0:00:30.19,Default,,0,0,0,,Мен сені өлтіремін! Уф
Dialogue: 0,0:00:30.28,0:00:32.90,Default,,0,0,0,,Сәлем Тачихара-кун, жақсы жер.
Dialogue: 0,0:00:32.99,0:00:36.28,Default,,0,0,0,,Акико ақыры Джиллетті мойындауға мәжбүр етті.
Dialogue: 0,0:00:36.74,0:00:40.33,Default,,0,0,0,,Ә!? Әлемдегі 17 зұлым адамның бірі
Dialogue: 0,0:00:40.41,0:00:41.91,Default,,0,0,0,,Джек Гиллетт!?
Dialogue: 0,0:00:42.00,0:00:44.46,Default,,0,0,0,,Бөліп алсаң да сынбайтын жалғыз ол.
Dialogue: 0,0:00:44.54,0:00:46.12,Default,,0,0,0,,Мен бұл ойыншық деп ойладым
Dialogue: 0,0:00:46.96,0:00:49.25,Default,,0,0,0,,Ол жарты жылда ғана бұзылды!
Dialogue: 0,0:00:49.34,0:00:52.51,Default,,0,0,0,,Менің жанашырлығым Джиллетке барады.
Dialogue: 0,0:00:53.17,0:00:54.97,Default,,0,0,0,,Әйтеуір, Тачихара-кун
Dialogue: 0,0:00:55.05,0:00:58.60,Default,,0,0,0,,Ұзақ мерзімді инфильтрация миссиясы Еңбекқорлығыңыз үшін рахмет.
Dialogue: 0,0:00:58.68,0:01:00.56,Default,,0,0,0,,Енді келесі тапсырма...
Dialogue: 0,0:01:01.43,0:01:02.85,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз.
Dialogue: 0,0:01:02.93,0:01:05.52,Default,,0,0,0,,Арбаға міну! Маған апарыңыз!
Dialogue: 0,0:01:06.56,0:01:09.23,Default,,0,0,0,,Алдымен тергеу жағдайын қорытындылайық.
Dialogue: 0,0:01:09.94,0:01:12.86,Default,,0,0,0,,Тенжин Госей зорлық-зомбылық террористік ұйымы
Dialogue: 0,0:01:12.94,0:01:15.70,Default,,0,0,0,,Төрт күн бұрын барымта кезінде шынайы тұлға анықталды.
Dialogue: 0,0:01:15.78,0:01:18.36,Default,,0,0,0,,Бұл Қарулы Детектив Агенттігі болып шықты.
Dialogue: 0,0:01:18.45,0:01:22.87,Default,,0,0,0,,Детектив агенттігінің көру туралы ақпараты...
Dialogue: 0,0:01:22.95,0:01:25.08,Default,,0,0,0,,Соңғы рет көру болды
Dialogue: 0,0:01:25.16,0:01:27.12,Default,,0,0,0,,Екі күн бұрын банкке шабуыл болды.
Dialogue: 0,0:01:27.21,0:01:29.63,Default,,0,0,0,,Банкті тонау нені білдіреді?
Dialogue: 0,0:01:29.71,0:01:31.71,Default,,0,0,0,,Жексұрын... Арх!
Dialogue: 0,0:01:31.80,0:01:33.88,Default,,0,0,0,,Жиналыс кезінде бұлшық ет жаттығулары жоқ
Dialogue: 0,0:01:33.96,0:01:36.84,Default,,0,0,0,,Ау, жүк дұрыс.
Dialogue: 0,0:01:37.43,0:01:40.39,Default,,0,0,0,,Неліктен көру туралы ақпарат тоқтады?
Dialogue: 0,0:01:40.47,0:01:42.68,Default,,0,0,0,,Түсінген шығар.
Dialogue: 0,0:01:42.76,0:01:46.43,Default,,0,0,0,,Қашқынның бәрінен де нені қалайды
Dialogue: 0,0:01:46.52,0:01:49.44,Default,,0,0,0,,База және басқару мұнарасы
Dialogue: 0,0:01:51.19,0:01:52.90,Default,,0,0,0,,Бұл операцияның мақсаты
Dialogue: 0,0:01:52.98,0:01:55.11,Default,,0,0,0,,Артқы бетті жазу алдында терроризмнің алдын алу
Dialogue: 0,0:01:55.19,0:01:56.82,Default,,0,0,0,,және бетті қайтару
Dialogue: 0,0:01:57.90,0:02:00.07,Default,,0,0,0,,Алайда іздеуде жүрген детектив органы болып табылады
Dialogue: 0,0:02:00.16,0:02:02.62,Default,,0,0,0,,Қоғамдық орындарда қозғала алмайды
Dialogue: 0,0:02:02.70,0:02:04.54,Default,,0,0,0,,Сонымен оның ерекше қабілеті бар.
Dialogue: 0,0:02:04.62,0:02:06.04,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:02:06.12,0:02:07.25,Default,,0,0,0,,Люсидің «Анна бөлмесінде»
Dialogue: 0,0:02:07.33,0:02:09.29,Default,,0,0,0,,Екеуіңіз сақталып, тасымалдансаңыз
Dialogue: 0,0:02:09.37,0:02:11.54,Default,,0,0,0,,Байқамай ішке кіруге болады
Dialogue: 0,0:02:11.63,0:02:14.96,Default,,0,0,0,,Демек, ол бұл операцияның жүрегі.
Dialogue: 0,0:02:15.05,0:02:17.05,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:02:17.13,0:02:18.59,Default,,0,0,0,,Жүр, мысық мысық
Dialogue: 0,0:02:18.68,0:02:22.05,Default,,0,0,0,,Бұл құлақтар алғыс сөздерді естігісі келеді.
Dialogue: 0,0:02:22.97,0:02:23.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:24.06,0:02:25.97,Default,,0,0,0,,Хмм... неге кешірім сұрайсың?
Dialogue: 0,0:02:26.52,0:02:28.27,Default,,0,0,0,,Мен сізді қатыстырдым
Dialogue: 0,0:02:28.35,0:02:31.98,Default,,0,0,0,,Қазір бізбен ынтымақтасу ауыр қылмыс.
Dialogue: 0,0:02:32.52,0:02:35.65,Default,,0,0,0,,Мен саған өте алмайтын үлкен қарызым бар.
Dialogue: 0,0:02:35.73,0:02:37.15,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:02:37.24,0:02:38.95,Default,,0,0,0,,Өтелмейтін үлкен қарыз
Dialogue: 0,0:02:39.03,0:02:41.07,Default,,0,0,0,,Мен оны қазір қайтарып жатқан адаммын, солай ма?
Dialogue: 0,0:02:41.16,0:02:42.91,Default,,0,0,0,,Не? (Люси) Иә?
Dialogue: 0,0:02:46.83,0:02:48.75,Default,,0,0,0,,Ешбірі Ешбірі Қазір!
Dialogue: 0,0:02:48.83,0:02:50.46,Default,,0,0,0,,Мүлдем жоқ! Өтінемін ұмыт!
Dialogue: 0,0:02:50.54,0:02:52.29,Default,,0,0,0,,Уақыт келді (Люси) Уф!
Dialogue: 0,0:02:53.42,0:02:55.46,Default,,0,0,0,,
Dialogue: 0,0:02:55.55,0:02:56.55,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:03:09.23,0:03:11.35,Default,,0,0,0,,Ұшу терминалына
Dialogue: 0,0:03:11.90,0:03:15.40,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:17.07,0:03:18.07,Default,,0,0,0,,Ах
Dialogue: 0,0:03:22.03,0:03:24.45,Default,,0,0,0,,Мен айтқанша ешкімді кіргізбе.
Dialogue: 0,0:03:24.53,0:03:25.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:31.21,0:03:34.88,Default,,0,0,0,,Дайын болуың керек, Фукузава.
Dialogue: 0,0:03:34.96,0:03:36.46,Default,,0,0,0,,О
Dialogue: 0,0:03:38.05,0:03:39.71,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:03:39.80,0:03:42.93,Default,,0,0,0,,Біздің кездесуіміз ішімдік ішу жарысы болып шешілді.
Dialogue: 0,0:03:43.01,0:03:45.80,Default,,0,0,0,,Әдеттегідей, Геничиро.
Dialogue: 0,0:03:47.85,0:03:51.56,Default,,0,0,0,,Не? Сіз әлі әйел алған жоқсыз ба?
Dialogue: 0,0:03:51.64,0:03:53.14,Default,,0,0,0,,Мен жұмыстан бос емеспін.
Dialogue: 0,0:03:53.65,0:03:55.31,Default,,0,0,0,,Пак Ненжинме
Dialogue: 0,0:03:55.40,0:03:58.44,Default,,0,0,0,,Иә, бірақ сіз президент емессіз.
Dialogue: 0,0:04:01.90,0:04:03.74,Default,,0,0,0,,Содан кейін сізге
Dialogue: 0,0:04:03.82,0:04:05.45,Default,,0,0,0,,Жауапты
Dialogue: 0,0:04:07.49,0:04:10.04,Default,,0,0,0,,Қол астындағыларыңыз өздерін тапсырсын.
Dialogue: 0,0:04:10.12,0:04:13.16,Default,,0,0,0,,Содан кейін істің құзыреті прокуратураға беріледі.
Dialogue: 0,0:04:13.25,0:04:15.71,Default,,0,0,0,,Енді иттердің нысанасы емес
Dialogue: 0,0:04:15.79,0:04:17.29,Default,,0,0,0,,Бірақ бұл нысана болғанша
Dialogue: 0,0:04:17.38,0:04:20.17,Default,,0,0,0,,Ит барлық жауларды шайнап тастайды.
Dialogue: 0,0:04:20.25,0:04:23.01,Default,,0,0,0,,Мен сіздің назарыңызды бағалаймын, бірақ
Dialogue: 0,0:04:23.68,0:04:24.93,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:04:25.01,0:04:28.10,Default,,0,0,0,,Мен сенімен кейде байыпты сөйлесемін.
Dialogue: 0,0:04:28.18,0:04:29.85,Default,,0,0,0,,Қызықты болуы мүмкін
Dialogue: 0,0:04:30.64,0:04:31.64,Default,,0,0,0,,Хмф!
Dialogue: 0,0:04:38.73,0:04:40.11,Default,,0,0,0,,Неге тоқтадың?
Dialogue: 0,0:04:40.19,0:04:42.57,Default,,0,0,0,,Алданба, Фукузава
Dialogue: 0,0:04:43.07,0:04:45.36,Default,,0,0,0,,Қол кісенді әдейі кесіп алған соң
Dialogue: 0,0:04:45.45,0:04:48.66,Default,,0,0,0,,Ол қылышты қылышсыз ұрлауды көздесе керек.
Dialogue: 0,0:04:49.70,0:04:51.16,Default,,0,0,0,,Ол оқылды ма?
Dialogue: 0,0:04:51.79,0:04:54.08,Default,,0,0,0,,Фукузава, міне, мәміле.
Dialogue: 0,0:04:54.58,0:04:57.79,Default,,0,0,0,,Қол астыңдағы Куникидаға не болғанын білгің келмей ме?
Dialogue: 0,0:04:58.88,0:05:01.46,Default,,0,0,0,,Куникида тікұшақтан құлап, өзін жарып жіберді.
Dialogue: 0,0:05:01.55,0:05:04.55,Default,,0,0,0,,Бірақ мен алда не болатынын білемін
Dialogue: 0,0:05:07.01,0:05:08.39,Default,,0,0,0,,Not necessary
Dialogue: 0,0:05:09.14,0:05:10.85,Default,,0,0,0,,Куникида тірі
Dialogue: 0,0:05:11.76,0:05:13.64,Default,,0,0,0,,Егер мен өлсем
Dialogue: 0,0:05:14.31,0:05:17.31,Default,,0,0,0,,Мен мұны сезіну мүмкін емес.
Dialogue: 0,0:05:17.94,0:05:19.65,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:21.19,0:05:22.86,Default,,0,0,0,,Қаншалықты жақсы
Dialogue: 0,0:05:22.94,0:05:26.24,Default,,0,0,0,,Әлгі жалғыз қасқыр өзгерді.
Dialogue: 0,0:05:26.32,0:05:27.99,Default,,0,0,0,,Шашың байланған екен.
Dialogue: 0,0:05:28.07,0:05:30.24,Default,,0,0,0,,Сенің мықты болуың мүмкін емес.
Dialogue: 0,0:05:31.08,0:05:32.12,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:05:32.20,0:05:34.87,Default,,0,0,0,,Сіз сенімдісіз бе? сенің күшің бәрібір
Dialogue: 0,0:05:34.95,0:05:38.71,Default,,0,0,0,,Бұл көптеген қабанды жеңетін күш.
Dialogue: 0,0:05:38.79,0:05:42.00,Default,,0,0,0,,Бірақ иттің домені - тергеу және қамауға алу.
Dialogue: 0,0:05:42.09,0:05:43.09,Default,,0,0,0,,Басқаша айтқанда?
Dialogue: 0,0:05:43.17,0:05:46.42,Default,,0,0,0,,Сондықтан мен ең үлкен итмін.
Dialogue: 0,0:05:46.51,0:05:47.93,Default,,0,0,0,,Сіз?
Dialogue: 0,0:05:49.09,0:05:51.18,Default,,0,0,0,,Ху (Джоно) Мен сені дәл қазір өлтіргім келеді!
Dialogue: 0,0:05:51.68,0:05:52.85,Default,,0,0,0,,Тапсырысыңыз ше?
Dialogue: 0,0:05:52.93,0:05:55.35,Default,,0,0,0,,Café latte (Tetsugu) Соя соусы латте
Dialogue: 0,0:05:55.43,0:05:58.14,Default,,0,0,0,,Қабылданды... Соя соусы?
Dialogue: 0,0:05:58.23,0:06:00.15,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:06:00.23,0:06:01.56,Default,,0,0,0,,Олай болса бұл ойын.
Dialogue: 0,0:06:01.65,0:06:05.07,Default,,0,0,0,,Детективтің қайда екенін бірінші кім анықтайды?
Dialogue: 0,0:06:05.15,0:06:06.53,Default,,0,0,0,,Қалаған орын
Dialogue: 0,0:06:08.28,0:06:11.37,Default,,0,0,0,,Сіз екі полиция қызметкерісіз бе?
Dialogue: 0,0:06:11.45,0:06:14.58,Default,,0,0,0,,Иә, мен істі қараудың ортасында болдым.
Dialogue: 0,0:06:14.66,0:06:16.87,Default,,0,0,0,,Аа, оқиға туралы айтсақ, дүкен меңгерушісі.
Dialogue: 0,0:06:16.95,0:06:20.92,Default,,0,0,0,,Қарулы Детектив Агенттігі, ең көп айтылатын зорлық-зомбылық террористік ұйымы
Dialogue: 0,0:06:21.00,0:06:23.84,Default,,0,0,0,,Бұл дүкеннің дәл үстінде болғанға ұқсайды.
Dialogue: 0,0:06:23.92,0:06:27.55,Default,,0,0,0,,Иә, мен оны кейде осы дүкенде көретінмін.
Dialogue: 0,0:06:28.01,0:06:30.01,Default,,0,0,0,,Бұл қорқынышты оқиға.
Dialogue: 0,0:06:30.51,0:06:31.76,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:32.39,0:06:34.64,Default,,0,0,0,,Мына қыз дүкенде жұмысшы әйел емес пе?
Dialogue: 0,0:06:34.72,0:06:37.89,Default,,0,0,0,,Иә, мен бүгін демалыстамын.
Dialogue: 0,0:06:39.02,0:06:40.52,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:06:41.06,0:06:45.27,Default,,0,0,0,,Біздегі мәліметтерге қарағанда, ол детективтік агенттікке өте жақын.
Dialogue: 0,0:06:46.65,0:06:49.24,Default,,0,0,0,,Адам қашуға көмектесті деген болжам бар.
Dialogue: 0,0:06:49.32,0:06:51.41,Default,,0,0,0,,Жай қызметшілерге сенсең де
Dialogue: 0,0:06:51.49,0:06:54.03,Default,,0,0,0,,Оның пайдасы жоқ.
Dialogue: 0,0:06:55.16,0:06:56.62,Default,,0,0,0,,Wonderful
Dialogue: 0,0:06:56.70,0:06:59.66,Default,,0,0,0,,Мен дәмді кофе дайындайтын адамдарды құрметтеймін.
Dialogue: 0,0:06:59.75,0:07:03.33,Default,,0,0,0,,Мен оны өзіме тиесілі коммерциялық нысанға ауыстырғым келеді.
Dialogue: 0,0:07:04.13,0:07:06.63,Default,,0,0,0,,Бірақ жалғыз мәселе
Dialogue: 0,0:07:06.71,0:07:10.30,Default,,0,0,0,,Сіз лас өтірікшісіз.
Dialogue: 0,0:07:10.38,0:07:11.93,Default,,0,0,0,,Өтірік?
Dialogue: 0,0:07:12.01,0:07:14.22,Default,,0,0,0,,Тыныс алу дыбысынан білемін.
Dialogue: 0,0:07:14.30,0:07:15.85,Default,,0,0,0,,Жаңа айттыңыз
Dialogue: 0,0:07:15.93,0:07:19.85,Default,,0,0,0,,Детективтік агенттік жай қызметшілерге сенбейтінін айтты.
Dialogue: 0,0:07:19.93,0:07:21.77,Default,,0,0,0,,Бірақ бұл өтірік
Dialogue: 0,0:07:21.85,0:07:24.48,Default,,0,0,0,,Сіз оның ерекше қабілеттерін білесіз.
Dialogue: 0,0:07:24.56,0:07:27.86,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:07:27.94,0:07:31.45,Default,,0,0,0,,I heard you buy half a year's worth of beans in bulk.
Dialogue: 0,0:07:31.53,0:07:35.66,Default,,0,0,0,,However, the aroma of this coffee is really fresh.
Dialogue: 0,0:07:35.74,0:07:36.95,Default,,0,0,0,,Аударма: Xianyu Experience Blackfeather | Авторлары: Xiao Wu, Cuo Nan | Тексерген: Kuma Star's Wayward Sheep
Dialogue: 0,0:07:37.49,0:07:40.41,Default,,0,0,0,,Өйткені біз түгендеуді оның бөлмесінде сақтаймыз.
Dialogue: 0,0:07:40.91,0:07:43.46,Default,,0,0,0,,Төтенше кеңістік уақытты баяулатуы мүмкін.
Dialogue: 0,0:07:43.54,0:07:46.38,Default,,0,0,0,,Үлкен мөлшердегі бұршақты жаңа күйде сақтайды
Dialogue: 0,0:07:48.17,0:07:49.63,Default,,0,0,0,,Әлі де жалғастырғыңыз келе ме?
Dialogue: 0,0:07:50.17,0:07:51.42,Default,,0,0,0,,Жаңа айттыңыз
Dialogue: 0,0:07:51.51,0:07:54.55,Default,,0,0,0,,Lucy said she took a day off just for today.
Dialogue: 0,0:07:54.64,0:07:56.14,Default,,0,0,0,,Бұл да өтірік
Dialogue: 0,0:07:56.68,0:07:59.06,Default,,0,0,0,,Ол мерзімсіз демалысқа шықты
Dialogue: 0,0:07:59.14,0:08:01.64,Default,,0,0,0,,Өйткені мен қайтып орала алатынымды білмеймін
Dialogue: 0,0:08:01.73,0:08:04.31,Default,,0,0,0,,Бірақ сен оны жібердің
Dialogue: 0,0:08:04.40,0:08:06.65,Default,,0,0,0,,Себебі мен түсінемін.
Dialogue: 0,0:08:06.73,0:08:10.61,Default,,0,0,0,,She is the only one who can save the detective agency.
Dialogue: 0,0:08:10.69,0:08:13.07,Default,,0,0,0,,Ал, мен қиналып қалдым.
Dialogue: 0,0:08:13.15,0:08:16.32,Default,,0,0,0,,Your crime is being an accessory after the fact to terrorism.
Dialogue: 0,0:08:16.41,0:08:19.37,Default,,0,0,0,,Оның үстіне, оның тұрған жерін жасырсаңыз
Dialogue: 0,0:08:19.45,0:08:22.54,Default,,0,0,0,,You'll never be able to make coffee again.
Dialogue: 0,0:08:23.37,0:08:25.58,Default,,0,0,0,,Ой! Атататата!
Dialogue: 0,0:08:25.67,0:08:27.21,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:27.29,0:08:28.84,Default,,0,0,0,,Басқа адамға әдейі немқұрайлы қарау
Dialogue: 0,0:08:28.92,0:08:31.46,Default,,0,0,0,,Enjoying your impatience is your bad habit.
Dialogue: 0,0:08:31.55,0:08:32.88,Default,,0,0,0,,Хмф!
Dialogue: 0,0:08:32.97,0:08:34.05,Default,,0,0,0,,Менеджер
Dialogue: 0,0:08:34.72,0:08:37.18,Default,,0,0,0,,Мен маңызды қайырымды адамның ақысын төлегім келеді
Dialogue: 0,0:08:37.26,0:08:39.14,Default,,0,0,0,,Бұл ой күнә ма?
Dialogue: 0,0:08:40.18,0:08:41.64,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:08:41.72,0:08:43.89,Default,,0,0,0,,Оның қазір қайда екенін айтсам
Dialogue: 0,0:08:43.98,0:08:46.15,Default,,0,0,0,,Ол ешқандай айыптауларға кінәлі емес.
Dialogue: 0,0:08:47.06,0:08:49.36,Default,,0,0,0,,Бізде мұндай өкілеттік бар.
Dialogue: 0,0:08:49.44,0:08:52.69,Default,,0,0,0,,And this is the world where a girl's innocence is rewarded.
Dialogue: 0,0:08:52.78,0:08:55.03,Default,,0,0,0,,Әлемді біз қорғауымыз керек
Dialogue: 0,0:08:55.86,0:08:59.70,Default,,0,0,0,,Мен құтқарғым келетін Люси ғана емес.
Dialogue: 0,0:08:59.78,0:09:01.66,Default,,0,0,0,,Детектив агенттігі.
Dialogue: 0,0:09:02.33,0:09:06.83,Default,,0,0,0,,I promise that they will receive a fair trial.
Dialogue: 0,0:09:06.92,0:09:08.17,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:09:08.25,0:09:10.38,Default,,0,0,0,,Бұл бәрінен кейін болды ма?
Dialogue: 0,0:09:11.38,0:09:13.59,Default,,0,0,0,,Мен қылышымда ант етемін
Dialogue: 0,0:09:14.17,0:09:17.64,Default,,0,0,0,,If you keep your promise, I'll punish your belly.
Dialogue: 0,0:09:19.55,0:09:20.60,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:09:21.56,0:09:23.27,Default,,0,0,0,,деді Люси Чан
Dialogue: 0,0:09:23.35,0:09:27.35,Default,,0,0,0,,I don't care if the rest of my life is ruined
Dialogue: 0,0:09:28.98,0:09:32.48,Default,,0,0,0,,Оның өмірін құтқарыңыз
Dialogue: 0,0:09:35.07,0:09:36.15,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:09:37.53,0:09:39.12,Default,,0,0,0,,Ол қайда кетті?
Dialogue: 0,0:09:39.87,0:09:41.91,Default,,0,0,0,,Tenku казиносы
Dialogue: 0,0:09:43.41,0:09:45.87,Default,,0,0,0,,Бұл ақымақ ғимарат.
Dialogue: 0,0:09:46.37,0:09:49.08,Default,,0,0,0,,Азаматтық ойын-сауық нысандары тек атымен
Dialogue: 0,0:09:49.17,0:09:51.84,Default,,0,0,0,,Шындығында, мақсаты жеңіске жеткен халықты бақылап, қорқыту болды.
Dialogue: 0,0:09:51.92,0:09:53.80,Default,,0,0,0,,Бұл жай ғана өсек.
Dialogue: 0,0:09:53.88,0:09:56.42,Default,,0,0,0,,Бұл жерде терроризм орын алса ше?
Dialogue: 0,0:09:56.51,0:09:59.76,Default,,0,0,0,,Бұл физикалық және саяси жағынан ең нашар.
Dialogue: 0,0:10:07.94,0:10:09.73,Default,,0,0,0,,Менеджер Бұл қиын.
Dialogue: 0,0:10:10.77,0:10:11.94,Default,,0,0,0,,Террорист?
Dialogue: 0,0:10:12.52,0:10:15.90,Default,,0,0,0,,Хмм, бұл нысанға террористер кіріп кетті.
Dialogue: 0,0:10:16.44,0:10:17.49,Default,,0,0,0,,Дәлелдер де бар
Dialogue: 0,0:10:17.57,0:10:19.07,Default,,0,0,0,,L-дің ізбасары… Мен әлі де L-пен күресіп жатырмын,
Dialogue: 0,0:10:19.16,0:10:20.70,Default,,0,0,0,,Мұны басқарыңыз
Dialogue: 0,0:10:21.66,0:10:23.74,Default,,0,0,0,,Ол террористердің серіктесі.
Dialogue: 0,0:10:23.83,0:10:27.91,Default,,0,0,0,,Мен экипажды өзімнің ғарыштық қабілеттеріммен әкелдім.
Dialogue: 0,0:10:28.00,0:10:29.71,Default,,0,0,0,,Олай болса, казино ішіне іздеу тобын жіберіңіз.
Dialogue: 0,0:10:29.79,0:10:30.71,Default,,0,0,0,,Бұл пайдасыз
Dialogue: 0,0:10:31.25,0:10:33.79,Default,,0,0,0,,Адамның өзі де ішкі кеңістікте тығыла алады.
Dialogue: 0,0:10:33.88,0:10:35.59,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:10:35.67,0:10:37.13,Default,,0,0,0,,Казиноны құлыптаңыз
Dialogue: 0,0:10:37.21,0:10:39.34,Default,,0,0,0,,Бас тарту (Йоко) Не?
Dialogue: 0,0:10:39.43,0:10:42.30,Default,,0,0,0,,Эй, сен қазір жағдайдың қандай екенін білесің бе?
Dialogue: 0,0:10:43.43,0:10:45.39,Default,,0,0,0,,Әрине, мен білемін
Dialogue: 0,0:10:48.81,0:10:50.98,Default,,0,0,0,,Бұл мылтық бағытты резонанстық зеңбірек деп аталады.
Dialogue: 0,0:10:51.94,0:10:54.52,Default,,0,0,0,,Бұл табиғаттан тыс қабілеті бар адамдарға арналған мылтық.
Dialogue: 0,0:10:54.61,0:10:56.82,Default,,0,0,0,,Дыбыс толқындары миды тікелей шайқайды
Dialogue: 0,0:10:56.90,0:11:00.86,Default,,0,0,0,,Сәулеленудің 1 секундында сана жоғалады, 10 секундта өмір жоғалады.
Dialogue: 0,0:11:00.95,0:11:02.82,Default,,0,0,0,,Сіз оны қолданып көргіңіз келе ме?
Dialogue: 0,0:11:03.53,0:11:05.37,Default,,0,0,0,,Сіз үкіметті қорғайсыз ба?
Dialogue: 0,0:11:05.45,0:11:06.58,Default,,0,0,0,,Үкімет?
Dialogue: 0,0:11:07.20,0:11:08.37,Default,,0,0,0,,Бұл казино
Dialogue: 0,0:11:08.45,0:11:12.12,Default,,0,0,0,,Халықаралық құқық бойынша кез келген мемлекеттің полиция билігі қолданылмайды.
Dialogue: 0,0:11:12.21,0:11:16.05,Default,,0,0,0,,Тәуелсіз ел, былайша айтқанда, заң менмін.
Dialogue: 0,0:11:16.13,0:11:18.55,Default,,0,0,0,,Тұтынушы ретінде ақшаны тастап, үйге қайтсаңыз жақсы.
Dialogue: 0,0:11:18.63,0:11:20.63,Default,,0,0,0,,Әйтпесе жоғалады.
Dialogue: 0,0:11:21.76,0:11:23.80,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:11:23.89,0:11:27.06,Default,,0,0,0,,Сен маған жоғалып кет дедің бе?
Dialogue: 0,0:11:27.14,0:11:29.64,Default,,0,0,0,,Уа, бұл қауіпті.
Dialogue: 0,0:11:30.43,0:11:31.89,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:11:31.98,0:11:33.65,Default,,0,0,0,,Мұндағы қауіпсіздік мінсіз!
Dialogue: 0,0:11:35.15,0:11:36.32,Default,,0,0,0,,Абай бол, ДжоДжо!
Dialogue: 0,0:11:36.40,0:11:39.07,Default,,0,0,0,,Қону алаңын біреу жарып жіберді!
Dialogue: 0,0:11:39.15,0:11:40.44,Default,,0,0,0,,Ах!?
Dialogue: 0,0:11:40.53,0:11:42.78,Default,,0,0,0,,Кааккакака!
Dialogue: 0,0:11:42.86,0:11:45.66,Default,,0,0,0,,Енді бұл казинодан ешкім шыға алмайды!
Dialogue: 0,0:11:45.74,0:11:49.20,Default,,0,0,0,,Енді казиноларды бөлек зерттейік!
Dialogue: 0,0:11:49.29,0:11:51.91,Default,,0,0,0,,Детективтің келесі қадамын оқи аласыз.
Dialogue: 0,0:11:52.50,0:11:53.96,Default,,0,0,0,,Үйсу
Dialogue: 0,0:11:55.71,0:11:57.09,Default,,0,0,0,,Жарылыс?
Dialogue: 0,0:11:57.17,0:11:58.80,Default,,0,0,0,,Сіз террорист екеніңізге сенімдісіз бе?
Dialogue: 0,0:11:58.88,0:11:59.88,Default,,0,0,0,,Біртүрлі. Шынында да, бәрі біртүрлі.
Dialogue: 0,0:11:59.96,0:12:00.92,Default,,0,0,0,,Ах
Dialogue: 0,0:12:01.47,0:12:04.39,Default,,0,0,0,,Ең бірінші алдын алатын нәрсе - тұтынушылардың дүрбелеңі.
Dialogue: 0,0:12:04.47,0:12:07.64,Default,,0,0,0,,Оларға электр қуатын дұрыс бөлудің салдарынан болған апат екенін айтып, қонақүй бөлмесіне апарыңыз.
Dialogue: 0,0:12:08.26,0:12:11.39,Default,,0,0,0,,A4098 тұтынушы нөмірі бар Лазар тұрақсыз.
Dialogue: 0,0:12:11.48,0:12:13.14,Default,,0,0,0,,Эксклюзивті қауіпсіздікті жіберіңіз
Dialogue: 0,0:12:13.94,0:12:17.86,Default,,0,0,0,,Созылмалы жүрек ауруы бар E2988 үшін медициналық қызметкерлер раундтар жасауы керек.
Dialogue: 0,0:12:18.61,0:12:19.90,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:12:19.98,0:12:23.61,Default,,0,0,0,,Ол барлық тұтынушыларының аты-жөні мен сипаттамаларын әп-сәтте жаттап алатын сияқты.
Dialogue: 0,0:12:23.70,0:12:24.74,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:12:24.82,0:12:27.83,Default,,0,0,0,,Казино менеджері болу үшін туған адам
Dialogue: 0,0:12:28.58,0:12:31.62,Default,,0,0,0,,Бұл деңгейде сіз келесі аптада ұмытып кететін шағын мәселе.
Dialogue: 0,0:12:32.37,0:12:33.66,Default,,0,0,0,,Түсінсеңіз
Dialogue: 0,0:12:34.92,0:12:36.13,Default,,0,0,0,,Онымен айналысайық.
Dialogue: 0,0:12:36.21,0:12:37.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:43.72,0:12:46.76,Default,,0,0,0,,Уф... Иә~!
Dialogue: 0,0:12:46.84,0:12:50.22,Default,,0,0,0,,Бұл ең нашар жағдай сценарийі. Мен иттерден құтыла алмадым.
Dialogue: 0,0:12:50.31,0:12:53.06,Default,,0,0,0,,Жарылыс олардың жұмысы болса керек.
Dialogue: 0,0:12:53.14,0:12:56.02,Default,,0,0,0,,Олай болса, казиноны мұқият зерттеңіз.
Dialogue: 0,0:12:56.10,0:12:59.57,Default,,0,0,0,,Егер олар бұл казиноның не екенін білсе...
Dialogue: 0,0:13:02.61,0:13:04.32,Default,,0,0,0,,Ал қылмыскерлердің өлімі тоқтағаннан кейін, біз кісі өлтірулердің қалай жасалып жатқанын көре алмаймыз.
Dialogue: 0,0:13:05.86,0:13:09.49,Default,,0,0,0,,Бұл қабатта да дәлел жоқ...
Dialogue: 0,0:13:09.58,0:13:10.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:12.04,0:13:13.29,Default,,0,0,0,,Не?
Dialogue: 0,0:13:15.96,0:13:17.17,Default,,0,0,0,,Монеталар?
Dialogue: 0,0:13:17.25,0:13:18.08,Default,,0,0,0,,Ha
Dialogue: 0,0:13:23.17,0:13:24.59,Default,,0,0,0,,Детектив агенттігі
Dialogue: 0,0:13:25.38,0:13:27.55,Default,,0,0,0,,Бұл бөлме олардың жасырынатын жері.
Dialogue: 0,0:13:33.43,0:13:35.77,Default,,0,0,0,,Ешкімнен белгі жоқ
Dialogue: 0,0:13:35.85,0:13:39.10,Default,,0,0,0,,Менің жақындағанымды байқадыңыз ба және ғарыш кеңістігіне қашып кеттіңіз бе?
Dialogue: 0,0:13:39.19,0:13:40.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:42.94,0:13:44.44,Default,,0,0,0,,Кілемдегі сызаттар?
Dialogue: 0,0:13:45.36,0:13:46.78,Default,,0,0,0,,Еденнің астында бірдеңе бар
Dialogue: 0,0:13:51.53,0:13:52.91,Default,,0,0,0,,О, сен келдің бе? Мен мүлде байқамаппын
Dialogue: 0,0:13:55.29,0:13:56.75,Default,,0,0,0,,Металл операциялары
Dialogue: 0,0:14:10.68,0:14:13.14,Default,,0,0,0,,Дүние жүзіндегі валюталар?
Dialogue: 0,0:14:13.22,0:14:14.77,Default,,0,0,0,,Тек монеталар
Dialogue: 0,0:14:15.43,0:14:17.23,Default,,0,0,0,,Неге... неге!
Dialogue: 0,0:14:17.73,0:14:20.40,Default,,0,0,0,,Ит неліктен ол затты тауып отыр?
Dialogue: 0,0:14:20.48,0:14:21.48,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:21.56,0:14:25.44,Default,,0,0,0,,Сіз жай ғана кездейсоқ бөлмеге кірдім дейсіз бе?
Dialogue: 0,0:14:25.53,0:14:27.53,Default,,0,0,0,,Бірақ қазір әзілдесу уақыты емес қой, профессор?
Dialogue: 0,0:14:27.61,0:14:29.49,Default,,0,0,0,,Олардың байланыстары мен қарулары
Dialogue: 0,0:14:29.57,0:14:32.99,Default,,0,0,0,,Жиналыстан кейін тұрақты қонақтар сияқты тәркіленді.
Dialogue: 0,0:14:33.08,0:14:33.99,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:14:34.08,0:14:37.12,Default,,0,0,0,,Мені қазір өлтірсең, құпия қорғалады.
Dialogue: 0,0:14:38.16,0:14:39.62,Default,,0,0,0,,Сигма мырза
Dialogue: 0,0:14:40.08,0:14:43.17,Default,,0,0,0,,Сізге әріптес ретінде кеңес беруге рұқсат етіңіз
Dialogue: 0,0:14:43.25,0:14:46.88,Default,,0,0,0,,Иттер мені жоспарымның ортасында тапса ше?
Dialogue: 0,0:14:46.96,0:14:48.88,Default,,0,0,0,,Бәрін тастап, қаш
Dialogue: 0,0:14:49.38,0:14:52.22,Default,,0,0,0,,You have no chance of winning.
Dialogue: 0,0:14:53.22,0:14:54.35,Default,,0,0,0,,Мен оны тастауым керек пе?
Dialogue: 0,0:14:54.43,0:14:56.31,Default,,0,0,0,,Бұл казино?
Dialogue: 0,0:14:56.81,0:14:58.06,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:14:58.14,0:15:01.06,Default,,0,0,0,,Is this coin hollow?
Dialogue: 0,0:15:01.15,0:15:04.36,Default,,0,0,0,,No, there's something in the cavity.
Dialogue: 0,0:15:04.44,0:15:06.69,Default,,0,0,0,,Металл құрылымда бірдеңе араласып кеткен...
Dialogue: 0,0:15:06.78,0:15:07.78,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:18.66,0:15:20.00,Default,,0,0,0,,(♪ «Twinkle, Twinkle, Little Star» әніне варияциялар»)
Dialogue: 0,0:15:20.87,0:15:23.21,Default,,0,0,0,,Бұл қашықтықта лезде өлім сөзсіз.
Dialogue: 0,0:15:23.88,0:15:26.59,Default,,0,0,0,,High explosives disguised as coins
Dialogue: 0,0:15:26.67,0:15:31.68,Default,,0,0,0,,Аспан мен адамзаттың бес құлдырауынан кейін келесі жаһандық терроризмнің орталығын құрайтын қатыгез қару.
Dialogue: 0,0:15:32.22,0:15:35.18,Default,,0,0,0,,Енді мен соны көргенде, мен сені үйге тірідей жібере алмаймын...
Dialogue: 0,0:15:35.26,0:15:36.56,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:15:37.14,0:15:39.06,Default,,0,0,0,,It was a close call.
Dialogue: 0,0:15:39.14,0:15:40.02,Default,,0,0,0,,Не!?
Dialogue: 0,0:15:40.10,0:15:42.94,Default,,0,0,0,,Металды ерекше қабілетіңмен тоқтатқаның жақсы болды.
Dialogue: 0,0:15:43.02,0:15:45.69,Default,,0,0,0,,I was knocked over by the blast.
Dialogue: 0,0:15:45.77,0:15:48.73,Default,,0,0,0,,Барлық монеталар сейфтік бомбалар ма?
Dialogue: 0,0:15:48.82,0:15:50.49,Default,,0,0,0,,I failed to finish it!?
Dialogue: 0,0:15:50.57,0:15:52.49,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:15:52.57,0:15:56.20,Default,,0,0,0,,No... there's still one last trump card.
Dialogue: 0,0:15:56.87,0:16:01.21,Default,,0,0,0,,Бірақ егер сіз оны пайдалансаңыз, бұл казиноға үлкен зиян келтіреді.
Dialogue: 0,0:16:02.79,0:16:04.92,Default,,0,0,0,,You have no chance of winning.
Dialogue: 0,0:16:05.71,0:16:07.80,Default,,0,0,0,,Бұл дұрыс болуы мүмкін.
Dialogue: 0,0:16:07.88,0:16:10.97,Default,,0,0,0,,I am a group of superhumans.
Dialogue: 0,0:16:11.05,0:16:14.09,Default,,0,0,0,,The man with the least fighting ability
Dialogue: 0,0:16:14.18,0:16:17.26,Default,,0,0,0,,Казинодан басқа ештеңесі жоқ қарапайым адам.
Dialogue: 0,0:16:18.22,0:16:19.52,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:16:19.60,0:16:23.39,Default,,0,0,0,,Ол барлық тұтынушыларының аты-жөні мен сипаттамаларын әп-сәтте жаттап алатын сияқты.
Dialogue: 0,0:16:23.48,0:16:24.52,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:16:24.60,0:16:27.69,Default,,0,0,0,,A man born to be a casino manager
Dialogue: 0,0:16:28.48,0:16:30.57,Default,,0,0,0,,Everyone misunderstands
Dialogue: 0,0:16:30.65,0:16:32.40,Default,,0,0,0,,Менің талантым жоқ
Dialogue: 0,0:16:33.49,0:16:35.86,Default,,0,0,0,,Customer profile and casino knowledge
Dialogue: 0,0:16:35.95,0:16:39.87,Default,,0,0,0,,Мен ұйқымды қысқартып, амалсыз жаттап жатырмын.
Dialogue: 0,0:16:39.95,0:16:42.54,Default,,0,0,0,,Себебі мен казинодан айырылғым келмеді
Dialogue: 0,0:16:43.41,0:16:45.96,Default,,0,0,0,,Сондықтан, мен!
Dialogue: 0,0:16:47.04,0:16:49.63,Default,,0,0,0,,Ха... бұл өтірік, солай ма?
Dialogue: 0,0:16:51.00,0:16:52.63,Default,,0,0,0,,Ұшқышсыз ұшақ?
Dialogue: 0,0:16:58.72,0:17:00.01,Default,,0,0,0,,Тым үлкен
Dialogue: 0,0:17:00.10,0:17:02.85,Default,,0,0,0,,My metal manipulation can't stop it.
Dialogue: 0,0:17:03.43,0:17:05.19,Default,,0,0,0,,Артқа тұрыңыз!
Dialogue: 0,0:17:05.27,0:17:07.23,Default,,0,0,0,,Сендер әлсіздер
Dialogue: 0,0:17:08.48,0:17:09.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:12.94,0:17:13.78,Default,,0,0,0,,Иә
Dialogue: 0,0:17:23.16,0:17:24.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:24.08,0:17:25.96,Default,,0,0,0,,Какакака
Dialogue: 0,0:17:26.42,0:17:30.42,Default,,0,0,0,,Сіз мені сумо жарысына шақыратын ақымақ ұшақсыз.
Dialogue: 0,0:17:30.50,0:17:32.13,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:17:32.21,0:17:33.80,Default,,0,0,0,,(sound of coin falling)
Dialogue: 0,0:17:35.13,0:17:36.30,Default,,0,0,0,,Бұл Декү.
Dialogue: 0,0:17:36.84,0:17:38.72,Default,,0,0,0,,Сіз соншалықты алысқа барасыз ба?
Dialogue: 0,0:17:38.80,0:17:39.93,Default,,0,0,0,,Тачихара!
Dialogue: 0,0:17:40.01,0:17:41.47,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:17:44.31,0:17:45.93,Default,,0,0,0,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,0:17:46.02,0:17:50.11,Default,,0,0,0,,(Йоконың күш дауысы)
Dialogue: 0,0:17:50.19,0:17:53.07,Default,,0,0,0,,Гааааааааа!
Dialogue: 0,0:17:57.65,0:17:58.66,Default,,0,0,0,,Не?
Dialogue: 0,0:17:58.74,0:18:00.24,Default,,0,0,0,,Тағы бір жарылыс?
Dialogue: 0,0:18:03.66,0:18:07.00,Default,,0,0,0,,көремін. Монета бомбасы?
Dialogue: 0,0:18:07.08,0:18:09.21,Default,,0,0,0,,Мені азғыратын зұлымдық
Dialogue: 0,0:18:10.00,0:18:13.09,Default,,0,0,0,,Тиындарды клиент казинодан шығарды.
Dialogue: 0,0:18:13.17,0:18:16.42,Default,,0,0,0,,Сонымен қатар, ол экономикалық тарату арқылы бүкіл әлемге тарағаннан кейін.
Dialogue: 0,0:18:16.51,0:18:18.22,Default,,0,0,0,,Барлығын бірден жару
Dialogue: 0,0:18:18.84,0:18:21.80,Default,,0,0,0,,Демек, бұл казиноның өзі террорист.
Dialogue: 0,0:18:21.89,0:18:23.26,Default,,0,0,0,,Сол менеджер
Dialogue: 0,0:18:23.35,0:18:26.48,Default,,0,0,0,,Бізді тез қуып шығудың себебі осы ма?
Dialogue: 0,0:18:26.56,0:18:27.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:28.64,0:18:31.15,Default,,0,0,0,,Бұл детонация сигналының көзі.
Dialogue: 0,0:18:32.19,0:18:35.90,Default,,0,0,0,,Биік биіктіктегі сигналдар бүкіл әлемге жетеді
Dialogue: 0,0:18:35.98,0:18:37.82,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:18:37.90,0:18:39.74,Default,,0,0,0,,Орталық байланыс бөлмесін ұрлау
Dialogue: 0,0:18:39.82,0:18:42.28,Default,,0,0,0,,Казинодағы қастандықты бүкіл әлемге ашу
Dialogue: 0,0:18:42.37,0:18:44.58,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:49.33,0:18:50.83,Default,,0,0,0,,Балалар
Dialogue: 0,0:18:50.92,0:18:53.34,Default,,0,0,0,,Менімен шынымен билегің келе ме?
Dialogue: 0,0:18:54.09,0:18:55.05,Default,,0,0,0,,Ах
Dialogue: 0,0:18:55.13,0:18:56.80,Default,,0,0,0,,Жауынгерлік дыбыстар
Dialogue: 0,0:18:58.05,0:18:59.47,Default,,0,0,0,,Иттер қозғала бастады.
Dialogue: 0,0:19:00.63,0:19:03.72,Default,,0,0,0,,Бұл Тенжин Госейдің келесі жоспары.
Dialogue: 0,0:19:04.30,0:19:07.47,Default,,0,0,0,,Бұл бүкіл адамзатты бей-берекет өлтіретін жаһандық терроризм.
Dialogue: 0,0:19:07.93,0:19:11.15,Default,,0,0,0,,Бірақ нақты мақсат - пайда болатын дүрбелең.
Dialogue: 0,0:19:11.69,0:19:16.15,Default,,0,0,0,,Ұлттық несиенің негізін құрайтын ақша адамдарды өлтіреді.
Dialogue: 0,0:19:16.23,0:19:21.07,Default,,0,0,0,,Экономикалық күйзеліс қана емес, тіпті келесі дүниежүзілік соғыс болуы мүмкін.
Dialogue: 0,0:19:21.16,0:19:24.91,Default,,0,0,0,,Артқы бетті пайдаланбас бұрын Тенжин Госей осылай жоспарлайды.
Dialogue: 0,0:19:24.99,0:19:28.58,Default,,0,0,0,,Жаһандық терроризм... күмәнсіз.
Dialogue: 0,0:19:29.50,0:19:31.79,Default,,0,0,0,,Бұл терроризмді тоқтатудың алғашқы қадамы ретінде
Dialogue: 0,0:19:31.87,0:19:34.38,Default,,0,0,0,,Иттерге тиын бомбасын тауып беруін сұраңыз.
Dialogue: 0,0:19:34.46,0:19:36.84,Default,,0,0,0,,Байланыс бөлмесін басқару
Dialogue: 0,0:19:36.92,0:19:41.18,Default,,0,0,0,,Иттермен бірге күресеміз, терроризмді бірге тоқтатамыз.
Dialogue: 0,0:19:41.26,0:19:43.43,Default,,0,0,0,,Террорист емес екеніңізді дәлелдеңіз
Dialogue: 0,0:19:44.05,0:19:47.18,Default,,0,0,0,,Ал парақтың қайда екенін білетін бес құдайдың бірі.
Dialogue: 0,0:19:47.26,0:19:49.64,Default,,0,0,0,,Secure Sigma
Dialogue: 0,0:19:50.14,0:19:52.48,Default,,0,0,0,,Бұл Дазай-санның жоспары.
Dialogue: 0,0:19:53.90,0:19:56.40,Default,,0,0,0,,Бұл иттің жауынгерлік күші
Dialogue: 0,0:19:56.90,0:19:59.11,Default,,0,0,0,,Дарындылықтың айырмашылығы осы ма?
Dialogue: 0,0:19:59.69,0:20:04.03,Default,,0,0,0,,Бірақ қарапайым адамдарда қарапайым адамдар ғана жасай алатын күрес әдісі бар.
Dialogue: 0,0:20:04.11,0:20:05.12,Default,,0,0,0,,…Иә!
Dialogue: 0,0:20:07.41,0:20:10.54,Default,,0,0,0,,Неліктен казиноның қамқоршысы ретінде Sigma-ны таңдадыңыз?
Dialogue: 0,0:20:10.62,0:20:12.66,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:12.75,0:20:14.50,Default,,0,0,0,,Сіз мені алдамақшысыз ба?
Dialogue: 0,0:20:14.58,0:20:17.34,Default,,0,0,0,,Негізі мен Сигма деген адамды қазып алдым.
Dialogue: 0,0:20:17.42,0:20:20.05,Default,,0,0,0,,Маған қызықты болды.
Dialogue: 0,0:20:20.13,0:20:22.17,Default,,0,0,0,,Оның өмірі үш жыл бұрын болған
Dialogue: 0,0:20:22.26,0:20:25.59,Default,,0,0,0,,Еуропалық полицияның қамауға алу жазбасынан басталады
Dialogue: 0,0:20:26.85,0:20:28.56,Default,,0,0,0,,Оның өткені жоқ.
Dialogue: 0,0:20:29.43,0:20:31.68,Default,,0,0,0,,Ортасынан басталатын сияқты⸺
Dialogue: 0,0:20:31.77,0:20:33.81,Default,,0,0,0,,Ол романдағы адам сияқты.
Dialogue: 0,0:20:34.98,0:20:37.31,Default,,0,0,0,,Бар білгенім басқа қабілет болды.
Dialogue: 0,0:20:37.40,0:20:38.40,Default,,0,0,0,,Түрту арқылы
Dialogue: 0,0:20:38.48,0:20:42.49,Default,,0,0,0,,Сіз және басқа адам білгісі келетін ақпаратпен алмасу мүмкіндігі
Dialogue: 0,0:20:42.99,0:20:44.99,Default,,0,0,0,,Осы қабілеті бар директор Танедадан.
Dialogue: 0,0:20:45.07,0:20:47.41,Default,,0,0,0,,Парақтан алынған ақпарат
Dialogue: 0,0:20:47.49,0:20:50.95,Default,,0,0,0,,Бірақ оған тек сол сәт керек
Dialogue: 0,0:20:51.50,0:20:54.41,Default,,0,0,0,,Неліктен казиноны оған сеніп тапсырдың?
Dialogue: 0,0:20:54.50,0:20:56.42,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:20:56.92,0:20:58.67,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:20:58.75,0:21:01.25,Default,,0,0,0,,Біріншіден, ол террорист емес.
Dialogue: 0,0:21:01.34,0:21:05.26,Default,,0,0,0,,Tenku казиносы 13 жыл бұрын жеңіске жеткен елдердің жасырын жиналысында құрылған.
Dialogue: 0,0:21:05.34,0:21:07.89,Default,,0,0,0,,Мекеме туралы шешім қабылданды деп айтылады.
Dialogue: 0,0:21:07.97,0:21:11.77,Default,,0,0,0,,Бірақ бірде-бір барлау органында ешқандай ақпарат болған жоқ.
Dialogue: 0,0:21:11.85,0:21:13.56,Default,,0,0,0,,Сонда мен түсіндім
Dialogue: 0,0:21:14.06,0:21:17.77,Default,,0,0,0,,Sky Casino 13 жыл бұрын салынған жоқ.
Dialogue: 0,0:21:18.44,0:21:20.07,Default,,0,0,0,,8 күн бұрын
Dialogue: 0,0:21:20.82,0:21:22.73,Default,,0,0,0,,8 күн бұрын бетте жарияланған
Dialogue: 0,0:21:22.82,0:21:24.82,Default,,0,0,0,,Бір сәтте пайда болды
Dialogue: 0,0:21:24.90,0:21:27.53,Default,,0,0,0,,13 жылдық тарихпен қатар.
Dialogue: 0,0:21:29.03,0:21:30.87,Default,,0,0,0,,Бірінші сұраққа қайта оралайық.
Dialogue: 0,0:21:30.95,0:21:33.91,Default,,0,0,0,,Неліктен Sigma-ны казиноға орналастырдыңыз?
Dialogue: 0,0:21:34.00,0:21:36.54,Default,,0,0,0,,Өйткені ол ең күшті
Dialogue: 0,0:21:36.62,0:21:37.75,Default,,0,0,0,,Күшті?
Dialogue: 0,0:21:37.83,0:21:41.00,Default,,0,0,0,,Бұл дүниеде кім мықты деп ойлайсың?
Dialogue: 0,0:21:41.63,0:21:44.26,Default,,0,0,0,,Ерекше қабілеті бар адам? Билік пе?
Dialogue: 0,0:21:44.34,0:21:45.97,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:21:46.47,0:21:51.35,Default,,0,0,0,,Ең күштілер - басқа ештеңесі жоқтар.
Dialogue: 0,0:21:51.43,0:21:52.68,Default,,0,0,0,,Иә
Dialogue: 0,0:21:52.76,0:21:56.14,Default,,0,0,0,,Сигманың өткен «Мені» жоқ
Dialogue: 0,0:21:56.23,0:21:58.77,Default,,0,0,0,,Амнезия бар.
Dialogue: 0,0:22:02.69,0:22:04.03,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:22:04.11,0:22:06.49,Default,,0,0,0,,Маған қарсы мылтық қолданудың мәні жоқ.
Dialogue: 0,0:22:06.57,0:22:08.32,Default,,0,0,0,,Жабу Бір рет жабылады
Dialogue: 0,0:22:08.41,0:22:09.82,Default,,0,0,0,,(кету)
Dialogue: 0,0:22:09.91,0:22:11.20,Default,,0,0,0,,(Йоконың жөтелі)
Dialogue: 0,0:22:11.28,0:22:12.70,Default,,0,0,0,,Акико-сан!
Dialogue: 0,0:22:13.24,0:22:14.58,Default,,0,0,0,,Амансың ба!?
Dialogue: 0,0:22:15.45,0:22:16.46,Default,,0,0,0,,Тачихара
Dialogue: 0,0:22:17.91,0:22:22.21,Default,,0,0,0,,Әділдік одақтасы жарақат алғанына қарамастан әлемді құтқаруға барады.
Dialogue: 0,0:22:22.29,0:22:25.21,Default,,0,0,0,,Сурет тартымды бола бастады деп ойламайсыз ба?
Dialogue: 0,0:22:25.67,0:22:27.76,Default,,0,0,0,,Ұшақты тоқтату кезіндегі сызаттар
Dialogue: 0,0:22:27.84,0:22:29.05,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:22:29.13,0:22:30.89,Default,,0,0,0,,Дәл қазір бұл қандай шу болды?
Dialogue: 0,0:22:30.97,0:22:31.89,Default,,0,0,0,,Күзетші құлап қалды.
Dialogue: 0,0:22:31.97,0:22:33.64,Default,,0,0,0,,Яби
Dialogue: 0,0:22:34.97,0:22:36.93,Default,,0,0,0,,Өзімді жаңарғандай сезінемін, өзімді жаңарғандай сезінемін! Хехехехе
Dialogue: 0,0:22:37.02,0:22:39.56,Default,,0,0,0,,Уайымдама, біз полициямыз.
Dialogue: 0,0:22:40.06,0:22:41.94,Default,,0,0,0,,Қазіргі уақытта терроризмге қатысты тергеу жүргізілуде.
Dialogue: 0,0:22:42.02,0:22:44.19,Default,,0,0,0,,Бұл қабат қауіпсіз
Dialogue: 0,0:22:44.27,0:22:45.90,Default,,0,0,0,,Олай болса, уайымдамаңыз.
Dialogue: 0,0:22:45.98,0:22:47.19,Default,,0,0,0,,(Пышақтың шаншу дыбысы)
Dialogue: 0,0:22:48.65,0:22:49.57,Default,,0,0,0,,Не?
Dialogue: 0,0:22:52.70,0:22:53.70,Default,,0,0,0,,Тачихара!
Dialogue: 0,0:22:55.54,0:22:57.70,Default,,0,0,0,,Енді жоғалтудың қарызы кетті!
Dialogue: 0,0:22:57.79,0:22:59.33,Default,,0,0,0,,Күте тұрыңыз, сіз!
Dialogue: 0,0:23:00.21,0:23:02.42,Default,,0,0,0,,Шабуылдың қайталануы
Dialogue: 0,0:23:02.88,0:23:05.17,Default,,0,0,0,,Осы екеуін тапқан бойда оларға шабуыл жасаңыз.
Dialogue: 0,0:23:05.25,0:23:07.42,Default,,0,0,0,,Кінәлі емес
Dialogue: 0,0:23:07.51,0:23:10.43,Default,,0,0,0,,Шабуылдаушы казиноның қарызын алып тастайды.
Dialogue: 0,0:23:10.88,0:23:14.43,Default,,0,0,0,,жарақат алған жағдайда 10 000 доллар, өлтірілсе 1 миллион доллар.
Dialogue: 0,0:23:14.51,0:23:15.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:17.81,0:23:18.64,Default,,0,0,0,,Ha
Dialogue: 0,0:23:19.98,0:23:22.10,Default,,0,0,0,,Сигма өзінің кім екенін білмейді
Dialogue: 0,0:23:22.19,0:23:23.98,Default,,0,0,0,,Мен баспана іздедім
Dialogue: 0,0:23:24.06,0:23:26.11,Default,,0,0,0,,Бұл казино
Dialogue: 0,0:23:26.19,0:23:29.07,Default,,0,0,0,,Сондықтан казиноны қорғау үшін,
Dialogue: 0,0:23:29.15,0:23:32.99,Default,,0,0,0,,Тозақтың қайсарлығы иттерді де күйдіреді.
Dialogue: 0,0:23:34.28,0:23:36.95,Default,,0,0,0,,Бұл дүниедегі ең қорқынышты нәрсе
Dialogue: 0,0:23:37.83,0:23:40.96,Default,,0,0,0,,Ол шарасыз қарапайым адам.
Dialogue: 0,0:23:42.46,0:23:48.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory