Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:09.95,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:25.75,0:00:28.25,Default,,0,0,0,,8-миссияның оққағары Дачун
Dialogue: 0,0:00:32.16,0:00:33.41,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:00:33.54,0:00:36.08,Default,,0,0,0,,қауырсындары бар, жұмсақ
Dialogue: 0,0:00:36.20,0:00:38.25,Default,,0,0,0,,Оны лақтырайық
Dialogue: 0,0:00:38.54,0:00:40.70,Default,,0,0,0,,Сіз сонша биікте ұша аласыз.
Dialogue: 0,0:00:40.83,0:00:43.25,Default,,0,0,0,,Ұшып бара жатыр, қарашы!
Dialogue: 0,0:00:43.37,0:00:46.79,Default,,0,0,0,,Міне, қайтып кел.
Dialogue: 0,0:00:49.83,0:00:50.66,Default,,0,0,0,,Не болды?
Dialogue: 0,0:00:50.79,0:00:53.45,Default,,0,0,0,,Мені біреу бақылап тұрғандай сезінемін.
Dialogue: 0,0:00:53.70,0:00:56.41,Default,,0,0,0,,Онда ешкім жоқ, бұл менің қиялым ғана
Dialogue: 0,0:01:02.91,0:01:05.12,Default,,0,0,0,,Қандай тамаша көрініс
Dialogue: 0,0:01:06.16,0:01:08.87,Default,,0,0,0,,Мақсат сұлу әйелді табу емес.
Dialogue: 0,0:01:09.25,0:01:12.91,Default,,0,0,0,,Яхта жағаға келді. Мақсат қандай көрінеді?
Dialogue: 0,0:01:29.91,0:01:35.08,Default,,0,0,0,,Күйеуіңді ақымақпен көрсең...
Dialogue: 0,0:01:35.91,0:01:37.91,Default,,0,0,0,,Бір ғана іс бар
Dialogue: 0,0:01:44.37,0:01:47.16,Default,,0,0,0,,Тілектеріңді орындаймын.
Dialogue: 0,0:01:48.12,0:01:52.04,Default,,0,0,0,,Сондай-ақ, осы қабылдау бөлмесі туралы бірдеңе жасаңыз.
Dialogue: 0,0:01:57.50,0:02:01.04,Default,,0,0,0,,Бұл ол болуы керек. Біз твиттер жазып жатырмыз.
Dialogue: 0,0:02:05.20,0:02:07.20,Default,,0,0,0,,Негізгі тұлға кім?
Dialogue: 0,0:02:10.25,0:02:12.75,Default,,0,0,0,,Тітіркендіргіш жәндіктерден арыл.
Dialogue: 0,0:02:15.00,0:02:18.33,Default,,0,0,0,,Кокос шырыны көп
Dialogue: 0,0:02:25.12,0:02:27.95,Default,,0,0,0,,Менің кокос жаңғағы ше?
Dialogue: 0,0:02:28.62,0:02:31.45,Default,,0,0,0,,Маған кокос жаңғағын қайтарыңыз
Dialogue: 0,0:02:34.08,0:02:36.33,Default,,0,0,0,,Менің сендермен ойнауға уақытым жоқ.
Dialogue: 0,0:02:41.54,0:02:43.54,Default,,0,0,0,,Қарама, полиция шақыр
Dialogue: 0,0:02:43.66,0:02:45.20,Default,,0,0,0,,Ол кокос ұры.
Dialogue: 0,0:02:45.20,0:02:47.04,Default,,0,0,0,,Ол кокос ұры.
Dialogue: 0,0:02:45.20,0:02:47.04,Default,,0,0,0,,«Жеті»
Dialogue: 0,0:03:21.79,0:03:23.41,Default,,0,0,0,,Оққағар Хо Да Чун
Dialogue: 0,0:03:33.25,0:03:37.87,Default,,0,0,0,,Шаянға айналу жақсы идея емес сияқты.
Dialogue: 0,0:03:40.58,0:03:41.91,Default,,0,0,0,,Сіз өлтірушісіз бе?
Dialogue: 0,0:03:45.87,0:03:48.62,Default,,0,0,0,,Моншада ойнайтын сары үйрек?
Dialogue: 0,0:03:54.25,0:03:56.75,Default,,0,0,0,,Эй, көңілді жүрсің бе?
Dialogue: 0,0:03:58.66,0:04:00.75,Default,,0,0,0,,Менімен ойнағың келе ме?
Dialogue: 0,0:04:04.16,0:04:05.37,Default,,0,0,0,,Қызықты
Dialogue: 0,0:04:06.04,0:04:09.54,Default,,0,0,0,,Ол серпімді, сондықтан ол сынбайтын сияқты.
Dialogue: 0,0:04:11.54,0:04:14.70,Default,,0,0,0,,Ол резеңкеге ұқсайды. Оны шайнау дұрыс па?
Dialogue: 0,0:04:15.20,0:04:16.33,Default,,0,0,0,,Шайнау?
Dialogue: 0,0:04:19.95,0:04:21.16,Default,,0,0,0,,Не...
Dialogue: 0,0:04:29.41,0:04:33.04,Default,,0,0,0,,Миссияда ойнай алмайсыз.
Dialogue: 0,0:04:38.75,0:04:40.41,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:04:40.95,0:04:42.37,Default,,0,0,0,,Тез кетейік.
Dialogue: 0,0:04:51.83,0:04:54.33,Default,,0,0,0,,Келесі жолы қаша алмайсың.
Dialogue: 0,0:04:51.83,0:04:54.33,Default,,0,0,0,,XX кесу
Dialogue: 0,0:05:21.45,0:05:23.87,Default,,0,0,0,,Мен оны теңізде ағыздым.
Dialogue: 0,0:05:24.00,0:05:26.66,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:05:30.87,0:05:32.16,Default,,0,0,0,,Қайшы жоғалып кетті
Dialogue: 0,0:05:36.54,0:05:39.33,Default,,0,0,0,,Сәлеметсіз бе, мен жүзуге келдім.
Dialogue: 0,0:05:39.45,0:05:41.87,Default,,0,0,0,,Сіз купальник сатасыз ба?
Dialogue: 0,0:05:42.00,0:05:46.00,Default,,0,0,0,,Оны тартпаңыз, өйткені ол өздігінен көтеріледі.
Dialogue: 0,0:05:46.29,0:05:49.25,Default,,0,0,0,,Каккари мырза, мені жайына қалдырыңыз.
Dialogue: 0,0:05:49.70,0:05:52.37,Default,,0,0,0,,Хо Да-Чун, толық емес күзетші.
Dialogue: 0,0:05:52.50,0:05:55.33,Default,,0,0,0,,Оққағар шені 1736-шы
Dialogue: 0,0:05:55.66,0:05:59.00,Default,,0,0,0,,Оққағарларды даярлайтын мектепті бітірген, қатты цигон мамандығы бойынша
Dialogue: 0,0:05:59.37,0:06:03.79,Default,,0,0,0,,Полиция күзет бөлімінің тіркеу нөмірі 9527
Dialogue: 0,0:06:05.12,0:06:06.79,Default,,0,0,0,,Мен жеңілуге шыдай алмаймын
Dialogue: 0,0:06:10.41,0:06:11.66,Default,,0,0,0,,Мен «жетімін»
Dialogue: 0,0:06:11.79,0:06:15.04,Default,,0,0,0,,Ассасин дәрежесі 12324-ші
Dialogue: 0,0:06:15.16,0:06:18.00,Default,,0,0,0,,Daibo сұлулық салонындағы шаштараз
Dialogue: 0,0:06:18.12,0:06:19.87,Default,,0,0,0,,Сусабынның құрамына 15 юань Cut 10 юань кіреді
Dialogue: 0,0:06:20.00,0:06:22.54,Default,,0,0,0,,Екі рет пайдаланыңыз, біреуін тегін алыңыз
Dialogue: 0,0:06:23.75,0:06:24.79,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:06:25.16,0:06:26.29,Default,,0,0,0,,Ол кісі өлтіруші болса да...
Dialogue: 0,0:06:26.41,0:06:29.58,Default,,0,0,0,,Өз тұлғасын таныту
Dialogue: 0,0:06:32.00,0:06:35.95,Default,,0,0,0,,Шынында да, өлтірушілер оққағарлардан ерекшеленеді.
Dialogue: 0,0:06:36.87,0:06:40.45,Default,,0,0,0,,Әйтеуір, негізі бет, мен сені өлтіремін.
Dialogue: 0,0:06:40.79,0:06:43.75,Default,,0,0,0,,Жеті арнайы «бөлу»
Dialogue: 0,0:06:47.41,0:06:49.20,Default,,0,0,0,,Таң қалмаңыз
Dialogue: 0,0:06:58.95,0:07:01.16,Default,,0,0,0,,Сүлгіңіз бар ма?
Dialogue: 0,0:07:01.87,0:07:04.41,Default,,0,0,0,,Аяқтаған соң, менің кезегім.
Dialogue: 0,0:07:05.20,0:07:06.33,Default,,0,0,0,,Менде мылтық бар
Dialogue: 0,0:07:07.12,0:07:09.20,Default,,0,0,0,,Әрине бұл оққағар.
Dialogue: 0,0:07:09.50,0:07:12.25,Default,,0,0,0,,Тоқта, маған қарама.
Dialogue: 0,0:07:14.87,0:07:19.50,Default,,0,0,0,,Мен оқтан жалтарамын. Маған тиеді ме?
Dialogue: 0,0:07:20.12,0:07:22.50,Default,,0,0,0,,Ерлер сияқты күресейік
Dialogue: 0,0:07:23.04,0:07:24.08,Default,,0,0,0,,Еркек пе?
Dialogue: 0,0:07:24.54,0:07:26.33,Default,,0,0,0,,«Голливуд стиліндегі шайқас»
Dialogue: 0,0:07:28.41,0:07:29.79,Default,,0,0,0,,Голливуд фильмдерінде -
Dialogue: 0,0:07:29.91,0:07:32.54,Default,,0,0,0,,Бір-бірімен жұдырықтасады.
Dialogue: 0,0:07:32.66,0:07:35.16,Default,,0,0,0,,Сіз менің соққымды қайтарасыз
Dialogue: 0,0:07:35.29,0:07:37.29,Default,,0,0,0,,Кім бірінші құласа, сол жеңіледі
Dialogue: 0,0:07:39.04,0:07:40.41,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:41.62,0:07:43.08,Default,,0,0,0,,Бұл қалыптан тыс Титан емес
Dialogue: 0,0:07:44.37,0:07:47.25,Default,,0,0,0,,Ұшатын тауық, қайда барасың?
Dialogue: 0,0:07:48.08,0:07:50.58,Default,,0,0,0,,Жүгірме, күт.
Dialogue: 0,0:08:08.50,0:08:10.29,Default,,0,0,0,,Жолбарыстың позициясы
Dialogue: 0,0:08:25.54,0:08:27.70,Default,,0,0,0,,Тырна биі
Dialogue: 0,0:08:28.12,0:08:29.08,Default,,0,0,0,,Жыланның шабуылы
Dialogue: 0,0:08:32.83,0:08:35.16,Default,,0,0,0,,Өлмейтін қыздық
Dialogue: 0,0:08:40.12,0:08:42.45,Default,,0,0,0,,Болат сияқты қатты
Dialogue: 0,0:08:54.41,0:08:57.33,Default,,0,0,0,,Негіз бет жігіт, өзіңді дайында.
Dialogue: 0,0:09:11.83,0:09:12.95,Default,,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,0:09:16.08,0:09:17.12,Default,,0,0,0,,Бірақ аталған адам өз келісімін берді
Dialogue: 0,0:09:19.37,0:09:24.70,Default,,0,0,0,,«Голливуд стиліндегі шайқаста» тек семіз көк тауық жеңіледі.
Dialogue: 0,0:09:25.54,0:09:26.83,Default,,0,0,0,,Сіз мұны әлі де жасайсыз ба?
Dialogue: 0,0:09:27.33,0:09:29.79,Default,,0,0,0,,Менімен жарысатын адамды бірінші рет кездестіруім.
Dialogue: 0,0:09:30.37,0:09:33.00,Default,,0,0,0,,Қалай қарасаң да әлсіз көрінеді
Dialogue: 0,0:09:33.79,0:09:36.00,Default,,0,0,0,,Соңына дейін күресу әдептілік
Dialogue: 0,0:09:49.87,0:09:51.08,Default,,0,0,0,,Оққағар, кел
Dialogue: 0,0:09:55.75,0:09:57.70,Default,,0,0,0,,Мен бұл мүмкіндікті жіберіп алмаймын
Dialogue: 0,0:09:58.66,0:10:01.79,Default,,0,0,0,,Мына жерде жалаңаш әдемі әйел бар.
Dialogue: 0,0:10:03.29,0:10:04.54,Default,,0,0,0,,Әй, сен ұрысың.
Dialogue: 0,0:10:08.00,0:10:09.79,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:10:12.25,0:10:14.54,Default,,0,0,0,,7 күн Хакожиме
Dialogue: 0,0:10:15.00,0:10:18.16,Default,,0,0,0,,Сіз мені кір қолмен өлтірмек болдыңыз.
Dialogue: 0,0:10:19.25,0:10:20.54,Default,,0,0,0,,өлтіруші үшін-
Dialogue: 0,0:10:20.66,0:10:23.70,Default,,0,0,0,,Бұл әдеттегі әдіс.
Dialogue: 0,0:10:24.16,0:10:27.87,Default,,0,0,0,,Менің қауырсынды қатайтуым шын махаббатпен бірдей
Dialogue: 0,0:10:28.00,0:10:29.37,Default,,0,0,0,,Ешқашан тайынбаңыз
Dialogue: 0,0:10:30.08,0:10:32.66,Default,,0,0,0,,Махаббат уақытша
Dialogue: 0,0:10:43.41,0:10:45.45,Default,,0,0,0,,Өз табандылығыңызды тексеріңіз
Dialogue: 0,0:11:26.54,0:11:27.79,Default,,0,0,0,,Өлмейтін қыздық?
Dialogue: 0,0:11:30.45,0:11:33.41,Default,,0,0,0,,Қандай кездейсоқтық. Сіз де серуендейсіз бе?
Dialogue: 0,0:11:41.83,0:11:44.50,Default,,0,0,0,,Айналмалы қалқан
Dialogue: 0,0:11:49.16,0:11:50.62,Default,,0,0,0,,Келесі жолы дайын болыңыз.
Dialogue: 0,0:11:51.70,0:11:56.45,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:11:57.95,0:12:02.29,Default,,0,0,0,,Мына қырылған бейбақ туралы бірдеңе істегеніңді қалаймын.
Dialogue: 0,0:12:02.83,0:12:05.58,Default,,0,0,0,,Жарайды, мен тапсырамын.
Dialogue: 0,0:12:05.79,0:12:07.12,Default,,0,0,0,,Мені тастап кетіңізші.
Dialogue: 0,0:12:07.58,0:12:08.87,Default,,0,0,0,,Мен қалаймын
Dialogue: 0,0:12:09.00,0:12:11.70,Default,,0,0,0,,Бұл техниканың аты айтып тұрғандай
Dialogue: 0,0:12:11.83,0:12:14.41,Default,,0,0,0,,7 күн ішінде күшін жою мүмкін емес
Dialogue: 0,0:12:14.83,0:12:16.33,Default,,0,0,0,,Тағы 4 күн шыдамдылық
Dialogue: 0,0:12:16.45,0:12:18.50,Default,,0,0,0,,Ақымақ трюктерді ойлап табу
Dialogue: 0,0:12:18.62,0:12:21.41,Default,,0,0,0,,Бұл туралы кім ойлады?
Dialogue: 0,0:12:22.50,0:12:24.70,Default,,0,0,0,,Оған көмектесу мүмкін емес, сөйлесейік.
Dialogue: 0,0:12:25.29,0:12:28.25,Default,,0,0,0,,Сен неге өлтірушісің? Бұл құпия бизнес.
Dialogue: 0,0:12:31.16,0:12:35.83,Default,,0,0,0,,Мен көп ақша табуға болатынын естідім.
Dialogue: 0,0:12:35.95,0:12:38.12,Default,,0,0,0,,Байға ұқсамайды.
Dialogue: 0,0:12:38.25,0:12:40.50,Default,,0,0,0,,Неліктен оққағар болдыңыз?
Dialogue: 0,0:12:40.62,0:12:42.45,Default,,0,0,0,,Адамдарды қорғау
Dialogue: 0,0:12:42.87,0:12:45.16,Default,,0,0,0,,Дәл осындай себеп полиция бөлімшесін тіркеуге де қатысты.
Dialogue: 0,0:12:45.87,0:12:48.12,Default,,0,0,0,,Кейбір адамдарға көмек керек
Dialogue: 0,0:12:48.58,0:12:51.37,Default,,0,0,0,,Құрметті мамандық сияқты.
Dialogue: 0,0:12:51.50,0:12:52.87,Default,,0,0,0,,Сіз айына қанша ақша таба аласыз?
Dialogue: 0,0:12:53.70,0:12:57.41,Default,,0,0,0,,Эй, төбесінде бірдеңе ұшып жатыр.
Dialogue: 0,0:13:03.08,0:13:05.00,Default,,0,0,0,,Зымыранға ұқсайды
Dialogue: 0,0:13:05.66,0:13:07.45,Default,,0,0,0,,Қашпасам қауіпті емес пе?
Dialogue: 0,0:13:33.91,0:13:37.41,Default,,0,0,0,,Мен бұл аралды қорғауға міндеттімін.
Dialogue: 0,0:13:40.58,0:13:41.66,Default,,0,0,0,,Өлмейтін Важра
Dialogue: 0,0:13:41.79,0:13:45.20,Default,,0,0,0,,Менің міндетім – барлығын қорғау.
Dialogue: 0,0:13:46.70,0:13:52.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory