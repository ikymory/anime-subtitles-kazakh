Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:09.95,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:26.08,0:00:28.95,Default,,0,0,0,,Миссия 10 мың сиқырлы қылыш
Dialogue: 0,0:00:34.37,0:00:36.25,Default,,0,0,0,,Бұл қауіпті миссия.
Dialogue: 0,0:00:36.41,0:00:38.37,Default,,0,0,0,,Өтемақы қосыңыз
Dialogue: 0,0:00:39.75,0:00:42.16,Default,,0,0,0,,Мен бұл тапсырмадан бас тартамын.
Dialogue: 0,0:00:43.83,0:00:48.08,Default,,0,0,0,,Daibo Сіз әдетте шешесіз.
Dialogue: 0,0:00:48.95,0:00:52.45,Default,,0,0,0,,Бұл жолы мен бас тарта алмаймын.
Dialogue: 0,0:00:52.87,0:00:54.66,Default,,0,0,0,,Маған шешім қабылдауға рұқсат етіңіз
Dialogue: 0,0:00:57.70,0:00:59.95,Default,,0,0,0,,Өлуің мүмкін.
Dialogue: 0,0:01:00.08,0:01:02.08,Default,,0,0,0,,Жауыңның күшін білесің.
Dialogue: 0,0:01:02.87,0:01:06.04,Default,,0,0,0,,Сіз тырыспайынша білмейсіз
Dialogue: 0,0:01:11.66,0:01:13.16,Default,,0,0,0,,Қырғауыл патшасын шақыру
Dialogue: 0,0:01:13.29,0:01:15.29,Default,,0,0,0,,Көк әтеш қалай жеңеді?
Dialogue: 0,0:01:15.54,0:01:17.12,Default,,0,0,0,,Сіз тырыспайынша білмейсіз
Dialogue: 0,0:01:17.37,0:01:20.45,Default,,0,0,0,,Дафеи мен Жеті ұқсас
Dialogue: 0,0:01:22.50,0:01:25.12,Default,,0,0,0,,Өлімге дайын болсаңыз, қалағаныңызды жасаңыз.
Dialogue: 0,0:01:25.37,0:01:28.08,Default,,0,0,0,,Қарусыз қалай ұрыспақсың?
Dialogue: 0,0:01:28.29,0:01:31.20,Default,,0,0,0,,Бұл менің жадым жоғалтқанға дейін қолданатын қылыш.
Dialogue: 0,0:01:31.58,0:01:35.37,Default,,0,0,0,,Есіңізде жоқ шығар...
Dialogue: 0,0:01:35.50,0:01:38.58,Default,,0,0,0,,Бала кезімізде дос болдық.
Dialogue: 0,0:01:38.70,0:01:41.75,Default,,0,0,0,,Мен саған өтірік айттым
Dialogue: 0,0:01:44.45,0:01:47.95,Default,,0,0,0,,Мен оны екі жыл бұрын теңізде тапқан кезде...
Dialogue: 0,0:01:49.16,0:01:51.62,Default,,0,0,0,,Сіз өліп жатырсыз
Dialogue: 0,0:01:52.33,0:01:55.20,Default,,0,0,0,,Талантты дәрігер менің өмірімді сақтап қалды, бірақ...
Dialogue: 0,0:01:56.75,0:01:58.16,Default,,0,0,0,,Сол кезде мен емделушілерге қомақты қаржы төледім.
Dialogue: 0,0:01:58.16,0:02:00.04,Default,,0,0,0,,Сол кезде мен емделушілерге қомақты қаржы төледім.
Dialogue: 0,0:01:58.16,0:02:00.04,Default,,0,0,0,,〝Медициналық шығындар 1 миллион иен〞
Dialogue: 0,0:02:00.45,0:02:03.87,Default,,0,0,0,,Мен сені ақша табу үшін өлтіруші еттім.
Dialogue: 0,0:02:04.45,0:02:08.41,Default,,0,0,0,,«Жеті» деп атаған мен едім
Dialogue: 0,0:02:09.41,0:02:12.91,Default,,0,0,0,,Ол кетті. Мені естімедің бе?
Dialogue: 0,0:02:14.87,0:02:18.95,Default,,0,0,0,,Сяо Фэй, қайда бара жатырсың?
Dialogue: 0,0:02:20.50,0:02:23.87,Default,,0,0,0,,Сен қайтып келсең, аяғыңды сындырамын.
Dialogue: 0,0:02:56.41,0:03:00.16,Default,,0,0,0,,Неліктен тозған? Оған көмектесу мүмкін емес
Dialogue: 0,0:03:00.29,0:03:02.58,Default,,0,0,0,,Көзілдірікті жеңу үшін жеткілікті
Dialogue: 0,0:03:20.50,0:03:23.95,Default,,0,0,0,,Дайбо маған ауыр қаруды алуға мәжбүр етті.
Dialogue: 0,0:03:48.79,0:03:50.95,Default,,0,0,0,,Көлік аяғыңыздың астында тұрып шабуылдан қашыңыз
Dialogue: 0,0:03:51.29,0:03:52.50,Default,,0,0,0,,Және бірден
Dialogue: 0,0:03:53.62,0:03:57.25,Default,,0,0,0,,Бұл біртүрлі кездейсоқтық. Он үш. Бұл биіктерден көрінетін нәрсе ме?
Dialogue: 0,0:03:58.50,0:04:02.50,Default,,0,0,0,,Менің деректерім бойынша, сіз он үш өлтірушісіз.
Dialogue: 0,0:04:02.62,0:04:05.58,Default,,0,0,0,,Сутанның отаны доктор Ченді өлтірді
Dialogue: 0,0:04:07.54,0:04:09.37,Default,,0,0,0,,Біз жаумыз
Dialogue: 0,0:04:09.75,0:04:12.16,Default,,0,0,0,,Сутан ханзаданың басы ақшаға айналады
Dialogue: 0,0:04:12.75,0:04:14.16,Default,,0,0,0,,Керемет олжа!
Dialogue: 0,0:04:15.04,0:04:17.29,Default,,0,0,0,,Оның қалай жасалғанын көрейік
Dialogue: 0,0:04:17.91,0:04:19.00,Default,,0,0,0,,Тауық ұшып келеді
Dialogue: 0,0:04:20.25,0:04:21.16,Default,,0,0,0,,Бұл баланың қулығы
Dialogue: 0,0:04:26.16,0:04:28.70,Default,,0,0,0,,Трансформация
Dialogue: 0,0:04:37.62,0:04:39.00,Default,,0,0,0,,Бұлшық ет тауық еті
Dialogue: 0,0:04:42.12,0:04:43.37,Default,,0,0,0,,10-деңгейдегі қорғаныс қалқаны
Dialogue: 0,0:04:53.29,0:04:55.87,Default,,0,0,0,,Қабілетсіз төменгі тіршілік иелері.
Dialogue: 0,0:04:56.70,0:04:58.62,Default,,0,0,0,,Гимнастика ағайынды құпия техникасы
Dialogue: 0,0:04:59.00,0:05:01.95,Default,,0,0,0,,Жай тұрып, шабуыл жасамаңыз.
Dialogue: 0,0:05:09.54,0:05:12.20,Default,,0,0,0,,Менсіз қайтып келмейсің.
Dialogue: 0,0:05:12.33,0:05:14.75,Default,,0,0,0,,Қанаттарым есуден сал болып қалды.
Dialogue: 0,0:05:15.66,0:05:19.29,Default,,0,0,0,,Гимнастика ағайынды құпия әдіс «Найзағайдың улы айдаһары»
Dialogue: 0,0:05:38.04,0:05:41.00,Default,,0,0,0,,Тіпті қорғаныс қалқаны да оны болдырмайды.
Dialogue: 0,0:05:41.25,0:05:42.66,Default,,0,0,0,,Соңғы қозғалысты қолданыңыз
Dialogue: 0,0:05:57.45,0:05:58.87,Default,,0,0,0,,Толық ұрыс режимі
Dialogue: 0,0:06:14.54,0:06:17.95,Default,,0,0,0,,Мен соңғы қаруды қолдандым.
Dialogue: 0,0:06:18.54,0:06:22.16,Default,,0,0,0,,Мен толық қорғалған болсам да, іш киімім көрінеді.
Dialogue: 0,0:06:24.33,0:06:27.58,Default,,0,0,0,,Қарулы костюммен дене қимылдарын басқару...
Dialogue: 0,0:06:28.04,0:06:29.50,Default,,0,0,0,,Тезірек реакция
Dialogue: 0,0:06:40.37,0:06:42.50,Default,,0,0,0,,Бұл әділетсіздік емес пе?
Dialogue: 0,0:06:42.62,0:06:45.08,Default,,0,0,0,,Біздің қаруымыздан мүлде басқаша.
Dialogue: 0,0:06:57.58,0:07:00.04,Default,,0,0,0,,Жамбасымның ауырғаны қандай
Dialogue: 0,0:07:00.62,0:07:02.50,Default,,0,0,0,,Біз әлі шыңға жеттік пе?
Dialogue: 0,0:07:14.37,0:07:17.83,Default,,0,0,0,,Бұл жігітті өлтіре алатын жалғыз адам менмін.
Dialogue: 0,0:07:19.00,0:07:20.66,Default,,0,0,0,,Екеуміз бірге өлейік
Dialogue: 0,0:07:23.29,0:07:24.79,Default,,0,0,0,,Өрік гүлін қорғау
Dialogue: 0,0:07:31.12,0:07:32.87,Default,,0,0,0,,Мұның алдын алуға бола ма?
Dialogue: 0,0:07:40.54,0:07:41.29,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:07:53.16,0:07:54.54,Default,,0,0,0,,Жеті...
Dialogue: 0,0:07:55.20,0:07:57.16,Default,,0,0,0,,мені итеріп жіберді
Dialogue: 0,0:07:59.25,0:08:00.41,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:08:11.45,0:08:14.83,Default,,0,0,0,,Дачунның ерекше дағдыларын мұра етті.
Dialogue: 0,0:08:19.20,0:08:21.29,Default,,0,0,0,,«7 күндік Хакожиме» фильмінің үзіндісі
Dialogue: 0,0:08:23.91,0:08:25.58,Default,,0,0,0,,Он үш!
Dialogue: 0,0:08:26.12,0:08:27.58,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:29.29,0:08:30.66,Default,,0,0,0,,Уақыт, тоқта!
Dialogue: 0,0:08:33.00,0:08:35.45,Default,,0,0,0,,Ей, мен денемді қозғалта алмаймын.
Dialogue: 0,0:08:37.83,0:08:41.08,Default,,0,0,0,,Көзілдірік киген жігіт қыңыр.
Dialogue: 0,0:08:41.83,0:08:46.12,Default,,0,0,0,,Бірақ сіз маңызды нәрсені ұмытып қалдыңыз.
Dialogue: 0,0:08:47.00,0:08:50.45,Default,,0,0,0,,Концентрат! Қайшыны ақылмен тартыңыз
Dialogue: 0,0:08:51.37,0:08:52.91,Default,,0,0,0,,Қайшы сынған болуы керек.
Dialogue: 0,0:08:54.25,0:08:54.91,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:15.20,0:09:19.50,Default,,0,0,0,,Мен Daibo сұлулық салонында шаштаразмын.
Dialogue: 0,0:09:28.04,0:09:30.83,Default,,0,0,0,,Тозаққа кет, көзілдірік.
Dialogue: 0,0:09:48.62,0:09:52.87,Default,,0,0,0,,...
Dialogue: 0,0:09:53.41,0:09:54.08,Default,,0,0,0,,Мен не істеймін?
Dialogue: 0,0:10:07.12,0:10:08.08,Default,,0,0,0,,Жеті…
Dialogue: 0,0:10:32.75,0:10:34.29,Default,,0,0,0,,Мен өлемін деп ойладым
Dialogue: 0,0:10:37.00,0:10:41.54,Default,,0,0,0,,...
Dialogue: 0,0:10:41.66,0:10:43.41,Default,,0,0,0,,Бұл соңғы соққы
Dialogue: 0,0:10:53.41,0:10:55.87,Default,,0,0,0,,Мен тауықтардың патшасымын
Dialogue: 0,0:10:56.12,0:10:58.66,Default,,0,0,0,,Адамдар мені «Тауық патшасы» деп атайды
Dialogue: 0,0:11:01.20,0:11:03.83,Default,,0,0,0,,Баспалдақпен көтерілу қиын болды.
Dialogue: 0,0:11:04.50,0:11:06.41,Default,,0,0,0,,Мен туралы естіген жоқсың ба?
Dialogue: 0,0:11:06.79,0:11:09.58,Default,,0,0,0,,Бұл менің досым.
Dialogue: 0,0:11:12.20,0:11:14.33,Default,,0,0,0,,Мазасыз адам пайда болды
Dialogue: 0,0:11:15.62,0:11:16.87,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:11:17.45,0:11:20.45,Default,,0,0,0,,...
Dialogue: 0,0:11:32.87,0:11:37.62,Default,,0,0,0,,...
Dialogue: 0,0:11:38.37,0:11:40.00,Default,,0,0,0,,Код атауы «Жеті»
Dialogue: 0,0:11:40.83,0:11:42.25,Default,,0,0,0,,Әйелге не үшін көмектесу керек?
Dialogue: 0,0:11:43.08,0:11:44.95,Default,,0,0,0,,Сіз қастандық ұйымына опасыздық жасайсыз ба?
Dialogue: 0,0:11:45.33,0:11:48.45,Default,,0,0,0,,...
Dialogue: 0,0:11:48.95,0:11:50.87,Default,,0,0,0,,Бұдан былай сен жаусың.
Dialogue: 0,0:11:52.83,0:11:54.95,Default,,0,0,0,,Мен бұл жігітті өзіммен бірге алып кетемін.
Dialogue: 0,0:11:55.08,0:11:57.66,Default,,0,0,0,,Мені тоқтатуға тырысыңыз
Dialogue: 0,0:12:49.58,0:12:52.25,Default,,0,0,0,,Екеуің мен ойлағаннан да қайсар екенсіңдер.
Dialogue: 0,0:13:15.37,0:13:16.50,Default,,0,0,0,,Жеті
Dialogue: 0,0:13:23.41,0:13:25.62,Default,,0,0,0,,Мен бұл жігітті өзіммен бірге алып кетемін.
Dialogue: 0,0:13:25.75,0:13:28.08,Default,,0,0,0,,Мені тоқтатуға тырысыңыз
Dialogue: 0,0:13:28.79,0:13:32.83,Default,,0,0,0,,...
Dialogue: 0,0:14:03.58,0:14:05.20,Default,,0,0,0,,20-деңгей Энергия қалқаны
Dialogue: 0,0:14:21.16,0:14:21.75,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:14:22.41,0:14:23.08,Default,,0,0,0,,Бітті
Dialogue: 0,0:14:29.37,0:14:32.54,Default,,0,0,0,,...
Dialogue: 0,0:14:45.91,0:14:47.70,Default,,0,0,0,,Бұл аралды жойыңыз
Dialogue: 0,0:15:12.75,0:15:14.75,Default,,0,0,0,,Мен қайтамын!
Dialogue: 0,0:15:25.58,0:15:27.45,Default,,0,0,0,,Жеті Жарайсыңдар
Dialogue: 0,0:15:28.95,0:15:30.54,Default,,0,0,0,,Жақындаған жағдайда өлтіріңіз
Dialogue: 0,0:15:31.04,0:15:34.29,Default,,0,0,0,,Мен Генбудың көлеңкелі өлтірушісімін...
Dialogue: 0,0:15:34.75,0:15:35.33,Default,,0,0,0,,Жеті!
Dialogue: 0,0:15:38.91,0:15:40.91,Default,,0,0,0,,Ұстаз, қарап отырсыз ба?
Dialogue: 0,0:15:38.91,0:15:40.91,Default,,0,0,0,,...
Dialogue: 0,0:15:40.91,0:15:42.62,Default,,0,0,0,,...
Dialogue: 0,0:15:43.00,0:15:45.33,Default,,0,0,0,,Оны өлтіріп, маған қылышты әкел.
Dialogue: 0,0:15:47.16,0:15:48.75,Default,,0,0,0,,Ол әлі тірі ме?
Dialogue: 0,0:15:51.66,0:15:54.12,Default,,0,0,0,,«Операция кезінде»
Dialogue: 0,0:15:54.25,0:15:57.00,Default,,0,0,0,,«Дайбо сұлулық салоны»
Dialogue: 0,0:15:57.12,0:16:01.91,Default,,0,0,0,,...
Dialogue: 0,0:16:02.16,0:16:04.33,Default,,0,0,0,,Бүгін кешке балық сорпасы.
Dialogue: 0,0:16:04.45,0:16:08.33,Default,,0,0,0,,Сяофэй Севен басқа адамға айнала ма?
Dialogue: 0,0:16:09.08,0:16:12.04,Default,,0,0,0,,Осы аралдың тыныштығы үшін оны өлтіріңіз.
Dialogue: 0,0:16:13.45,0:16:16.70,Default,,0,0,0,,Ол менің құтқарушым, оның мені өлтіруіне жол бермеймін.
Dialogue: 0,0:16:17.58,0:16:20.29,Default,,0,0,0,,Сіз бұл қорқынышты көріністі көрмедіңіз бе?
Dialogue: 0,0:16:34.25,0:16:38.20,Default,,0,0,0,,Бүгін аптаның қай күні? Клиенттер өте көп
Dialogue: 0,0:16:38.33,0:16:40.41,Default,,0,0,0,,Сіз кімнен қиып аласыз?
Dialogue: 0,0:16:40.66,0:16:41.54,Default,,0,0,0,,Жеті!
Dialogue: 0,0:16:41.66,0:16:43.08,Default,,0,0,0,,Және біз бастаймыз
Dialogue: 0,0:16:43.37,0:16:44.41,Default,,0,0,0,,Жеті
Dialogue: 0,0:16:46.91,0:16:49.00,Default,,0,0,0,,Менің қайшым қайда?
Dialogue: 0,0:16:51.37,0:16:54.12,Default,,0,0,0,,Өйткені ол жыртылған күйде еді...
Dialogue: 0,0:16:54.66,0:16:58.20,Default,,0,0,0,,Дәл сол нәрсе Тензан қара болаттан жасалған.
Dialogue: 0,0:17:00.79,0:17:02.79,Default,,0,0,0,,Сосын ішіп алайық.
Dialogue: 0,0:17:09.12,0:17:11.45,Default,,0,0,0,,«Луочжи бастауыш мектебі»
Dialogue: 0,0:17:13.08,0:17:14.25,Default,,0,0,0,,Қуануға әлі ерте...
Dialogue: 0,0:17:14.37,0:17:15.25,Default,,0,0,0,,«Жағалау күзеті»
Dialogue: 0,0:17:15.37,0:17:16.91,Default,,0,0,0,,«Иттер штабы»
Dialogue: 0,0:17:17.04,0:17:20.75,Default,,0,0,0,,Жеті оқиғасы енді ғана басталды...
Dialogue: 0,0:17:23.00,0:17:25.25,Default,,0,0,0,,«Дайбо сұлулық салоны»
Dialogue: 0,0:17:28.91,0:17:30.75,Default,,0,0,0,,Жеті, кеттік.
Dialogue: 0,0:17:31.83,0:17:34.12,Default,,0,0,0,,Бұл тапсырманы маған қалдырыңыз.
Dialogue: 0,0:19:34.08,0:19:37.08,Default,,0,0,0,,Жапон субтитрлері Ри Инагаки
Dialogue: 0,0:19:38.58,0:19:44.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory