Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.37,0:00:09.95,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:26.12,0:00:28.79,Default,,0,0,0,,1-миссия Зұлымдарды өлтіріп, көп ақша табыңыз
Dialogue: 0,0:00:34.50,0:00:35.79,Default,,0,0,0,,«Жеті»
Dialogue: 0,0:00:42.20,0:00:44.58,Default,,0,0,0,,«Нысана»
Dialogue: 0,0:01:20.25,0:01:23.37,Default,,0,0,0,,Күтілгендей, ол әлемдегі ең жақсы өлтіруші.
Dialogue: 0,0:01:23.62,0:01:25.41,Default,,0,0,0,,100 миллион юань. Алыңыз.
Dialogue: 0,0:01:32.83,0:01:36.45,Default,,0,0,0,,Егер мен сені өлтірсем, мен саған 100 миллион иенден астам сыйақы беремін.
Dialogue: 0,0:01:47.41,0:01:49.50,Default,,0,0,0,,Біз өте баймыз.
Dialogue: 0,0:01:49.62,0:01:51.54,Default,,0,0,0,,«Бастауыш мектеп»
Dialogue: 0,0:01:51.79,0:01:52.75,Default,,0,0,0,,Маған біреуін беріңіз
Dialogue: 0,0:01:52.87,0:01:54.95,Default,,0,0,0,,Oh, what about spices?
Dialogue: 0,0:01:55.41,0:01:57.50,Default,,0,0,0,,Асқазанды көбірек қосыңыз
Dialogue: 0,0:02:05.83,0:02:08.58,Default,,0,0,0,,〝Seven beef offal stew〞
Dialogue: 0,0:02:13.33,0:02:14.33,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:02:15.29,0:02:19.95,Default,,0,0,0,,Мен әдеттегідей серуендегенімді қалаймын, бірақ бұл тым көп.
Dialogue: 0,0:02:20.70,0:02:22.08,Default,,0,0,0,,Тіпті құйрығын да же
Dialogue: 0,0:02:23.83,0:02:26.29,Default,,0,0,0,,Жеті ішімдікті қайнатпа.
Dialogue: 0,0:02:27.12,0:02:28.58,Default,,0,0,0,,Become an assassin
Dialogue: 0,0:02:28.70,0:02:30.95,Default,,0,0,0,,Жоғары табыс және икемді жүйе
Dialogue: 0,0:02:31.08,0:02:32.91,Default,,0,0,0,,Bonus Overseas work available
Dialogue: 0,0:02:33.04,0:02:35.04,Default,,0,0,0,,Керемет жұмыс, солай ма?
Dialogue: 0,0:02:35.79,0:02:38.16,Default,,0,0,0,,Азық-түлік дүңгіршектері үшін де солай істеңіз.
Dialogue: 0,0:02:42.83,0:02:45.79,Default,,0,0,0,,Don't you want to know about the past?
Dialogue: 0,0:02:47.91,0:02:50.12,Default,,0,0,0,,Сіз өлтірушімен туыссыз ба?
Dialogue: 0,0:02:50.45,0:02:51.45,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:02:52.58,0:02:56.66,Default,,0,0,0,,Бірақ ақша тапсаң, Сутанға баруға болады.
Dialogue: 0,0:02:57.45,0:03:00.66,Default,,0,0,0,,Олар мақтанатын ғылым мен техника болса...
Dialogue: 0,0:03:01.16,0:03:04.50,Default,,0,0,0,,Мен сіздің естеліктеріңізді қалпына келтіруім керек.
Dialogue: 0,0:03:05.20,0:03:06.79,Default,,0,0,0,,How much does it cost?
Dialogue: 0,0:03:10.25,0:03:11.62,Default,,0,0,0,,1 миллион юань
Dialogue: 0,0:03:32.16,0:03:34.91,Default,,0,0,0,,Ассасиндер бұрыннан бар.
Dialogue: 0,0:03:32.16,0:03:34.91,Default,,0,0,0,,«Нысана»
Dialogue: 0,0:03:35.04,0:03:37.16,Default,,0,0,0,,Адам бар жерде өшпенділік бар
Dialogue: 0,0:03:37.29,0:03:39.91,Default,,0,0,0,,Кек бар жерде қастандық бар
Dialogue: 0,0:03:40.04,0:03:41.41,Default,,0,0,0,,Екі түрі бар
Dialogue: 0,0:03:41.54,0:03:45.16,Default,,0,0,0,,Біреуі – ұйымда жұмыс істейтін мемлекеттік қызметкер.
Dialogue: 0,0:03:45.29,0:03:47.33,Default,,0,0,0,,Барлау агенті деп аталады
Dialogue: 0,0:03:47.45,0:03:50.08,Default,,0,0,0,,Екіншісі – фрилансер
Dialogue: 0,0:03:47.45,0:03:50.08,Default,,0,0,0,,«Нысана»
Dialogue: 0,0:03:50.20,0:03:51.87,Default,,0,0,0,,Көпшілігі жалғызбастылар
Dialogue: 0,0:03:52.58,0:03:57.29,Default,,0,0,0,,Егер сіз бірінші дәрежелі болсаңыз, сыйақы жоғары, бірақ сәтсіздікке жол берілмейді.
Dialogue: 0,0:03:57.41,0:04:00.04,Default,,0,0,0,,Ал өлтіруші болу – құпия іс.
Dialogue: 0,0:04:00.25,0:04:01.79,Default,,0,0,0,,Сізге шынайы болмысыңызды жасыратын бет керек.
Dialogue: 0,0:04:01.79,0:04:03.29,Default,,0,0,0,,Сізге шынайы болмысыңызды жасыратын бет керек.
Dialogue: 0,0:04:01.79,0:04:03.29,Default,,0,0,0,,Шаштараз
Dialogue: 0,0:04:03.70,0:04:05.54,Default,,0,0,0,,Маған сыра беріңіз
Dialogue: 0,0:04:06.91,0:04:11.91,Default,,0,0,0,,Қайшыны қолдану арқылы сіз өлтіруші бола аласыз ба?
Dialogue: 0,0:04:13.45,0:04:14.75,Default,,0,0,0,,Соданы тастаңыз
Dialogue: 0,0:04:15.62,0:04:19.70,Default,,0,0,0,,Жады жоқ, отбасы жоқ, сезім жоқ, ақша жоқ
Dialogue: 0,0:04:19.95,0:04:22.50,Default,,0,0,0,,Сіз тамаша өлтірушісіз.
Dialogue: 0,0:04:23.54,0:04:26.62,Default,,0,0,0,,Ассасиндерге арналған апаттық курс
Dialogue: 0,0:04:28.08,0:04:31.37,Default,,0,0,0,,Сіз таяқшаларыңызды еденге тастадыңыз.
Dialogue: 0,0:04:32.41,0:04:35.25,Default,,0,0,0,,Ассасиннің маңызды қабілеті 1 Инфильтрация
Dialogue: 0,0:04:35.87,0:04:38.00,Default,,0,0,0,,Менің соңғы өнертабысым.
Dialogue: 0,0:04:38.12,0:04:41.08,Default,,0,0,0,,Оның аты «біртүрлі жұмыртқа»
Dialogue: 0,0:04:41.37,0:04:47.04,Default,,0,0,0,,Алдымен, кім болғың келетінін елестетіп, жұмыртқаны жарып ал...
Dialogue: 0,0:04:47.16,0:04:50.12,Default,,0,0,0,,Еш уақытта түрлендіруге болады
Dialogue: 0,0:04:50.25,0:04:54.37,Default,,0,0,0,,Алайда қабілеттер мен қасиеттерді меңгеру мүмкін емес.
Dialogue: 0,0:04:54.50,0:04:56.08,Default,,0,0,0,,Қандай керемет өнертабыс!
Dialogue: 0,0:04:56.66,0:05:00.12,Default,,0,0,0,,Ұялма, мақтаған дұрыс.
Dialogue: 0,0:05:00.54,0:05:03.83,Default,,0,0,0,,Онда өзіңіз өлтіруші болыңыз.
Dialogue: 0,0:05:04.45,0:05:08.87,Default,,0,0,0,,Жадыңды қалпына келтіру үшін, алғыссыз.
Dialogue: 0,0:05:09.00,0:05:12.37,Default,,0,0,0,,Сіз үй сатып алып, қымбат көлік мінгіңіз келе ме?
Dialogue: 0,0:05:12.62,0:05:14.70,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:05:21.91,0:05:22.95,Default,,0,0,0,,Бұл өрескел.
Dialogue: 0,0:05:23.29,0:05:27.70,Default,,0,0,0,,Ассасиннің маңызды қабілеті 2 Бір соққымен өлтіру
Dialogue: 0,0:05:37.12,0:05:38.37,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:05:43.33,0:05:44.12,Default,,0,0,0,,Ой
Dialogue: 0,0:05:45.91,0:05:47.04,Default,,0,0,0,,Егер солай істесем…
Dialogue: 0,0:05:47.16,0:05:50.25,Default,,0,0,0,,Қайнаған кезде тефтели қалқып шығады.
Dialogue: 0,0:05:50.37,0:05:52.41,Default,,0,0,0,,Ең жақсысы сол кезде
Dialogue: 0,0:05:56.54,0:06:00.25,Default,,0,0,0,,Ассасиннің маңызды қабілеті 3 Қашу
Dialogue: 0,0:06:00.66,0:06:03.25,Default,,0,0,0,,Жоғары жылдамдықты ұшатын тауық!
Dialogue: 0,0:06:03.79,0:06:07.16,Default,,0,0,0,,Сяо Фэй - тауық, бірақ ол ұша алады.
Dialogue: 0,0:06:07.29,0:06:09.58,Default,,0,0,0,,Семіз бе?
Dialogue: 0,0:06:11.95,0:06:13.79,Default,,0,0,0,,Шалбар шешіледі
Dialogue: 0,0:06:15.58,0:06:16.70,Default,,0,0,0,,Жоқ, жасама!
Dialogue: 0,0:06:16.83,0:06:17.66,Default,,0,0,0,,Шебер бол
Dialogue: 0,0:06:17.79,0:06:19.87,Default,,0,0,0,,Менің шалбарым шешіліп жатыр!
Dialogue: 0,0:06:20.00,0:06:23.41,Default,,0,0,0,,Ассасиннің маңызды қабілеті 4 Қатыгездік
Dialogue: 0,0:06:41.83,0:06:44.33,Default,,0,0,0,,Бұл! Қан шығып жатыр
Dialogue: 0,0:06:44.45,0:06:46.00,Default,,0,0,0,,Мен мұнымен біттім.
Dialogue: 0,0:06:46.16,0:06:47.41,Default,,0,0,0,,Эй, күте тұрыңыз
Dialogue: 0,0:06:47.91,0:06:52.08,Default,,0,0,0,,Жарайды, сен енді кәсіби өлтірушісің.
Dialogue: 0,0:06:47.91,0:06:52.08,Default,,0,0,0,,«Диплом»
Dialogue: 0,0:06:53.08,0:06:56.95,Default,,0,0,0,,Бұл нәрселерден маңыздысы - нақты шайқас.
Dialogue: 0,0:06:57.25,0:06:58.37,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:06:58.91,0:07:01.04,Default,,0,0,0,,Қабылдау өтіп жатыр.
Dialogue: 0,0:07:01.16,0:07:04.70,Default,,0,0,0,,Барып қалыңдықтың шашын ал.
Dialogue: 0,0:07:05.58,0:07:07.41,Default,,0,0,0,,Ерекше күн болса да
Dialogue: 0,0:07:07.54,0:07:10.70,Default,,0,0,0,,Күйеу жігіттің бұрынғы қызының өтініші бойынша сыйақы 500 юань.
Dialogue: 0,0:07:10.83,0:07:12.70,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:07:13.20,0:07:14.08,Default,,0,0,0,,Тек шаш
Dialogue: 0,0:07:14.08,0:07:14.83,Default,,0,0,0,,Бұл жай ғана шаш.
Dialogue: 0,0:07:14.08,0:07:14.83,Default,,0,0,0,,Ассасиндерге арналған практикалық шайқас
Dialogue: 0,0:07:14.83,0:07:15.08,Default,,0,0,0,,Ассасиндерге арналған практикалық күрес
Dialogue: 0,0:07:15.08,0:07:16.41,Default,,0,0,0,,Ассасиндерге арналған практикалық күрес
Dialogue: 0,0:07:15.08,0:07:16.41,Default,,0,0,0,,Тез өседі
Dialogue: 0,0:07:16.79,0:07:20.16,Default,,0,0,0,,Чен және Ли отбасыларының қабылдауына қош келдіңіздер.
Dialogue: 0,0:07:20.91,0:07:23.33,Default,,0,0,0,,Қандай сүйкімді жұп.
Dialogue: 0,0:07:23.45,0:07:27.91,Default,,0,0,0,,Бір қызығы, олар балалық шақтағы достар және бір-бірінің алғашқы махаббаттары.
Dialogue: 0,0:07:28.04,0:07:32.54,Default,,0,0,0,,Бірге өткізген әдемі сәттерді қараңыз
Dialogue: 0,0:07:35.45,0:07:39.00,Default,,0,0,0,,Бұл тіпті қызық емес. Грильде пісірілген шошқа етін жейміз бе?
Dialogue: 0,0:07:39.66,0:07:40.75,Default,,0,0,0,,«Жеті»
Dialogue: 0,0:07:49.08,0:07:49.95,Default,,0,0,0,,Өмірге қайта оралыңыз!
Dialogue: 0,0:08:02.83,0:08:04.54,Default,,0,0,0,,«2-сынып 5»
Dialogue: 0,0:08:05.04,0:08:06.62,Default,,0,0,0,,«Кіші орта мектеп 2 курс 7 сынып»
Dialogue: 0,0:08:07.04,0:08:08.58,Default,,0,0,0,,«Орта мектептің 25 сыныбы»
Dialogue: 0,0:08:09.08,0:08:10.58,Default,,0,0,0,,«География»
Dialogue: 0,0:08:15.62,0:08:17.62,Default,,0,0,0,,Неліктен есіңізде жоқ?
Dialogue: 0,0:08:19.00,0:08:20.25,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:08:20.25,0:08:21.66,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:08:20.25,0:08:21.66,Default,,0,0,0,,〝Кіру рәсімі〞
Dialogue: 0,0:08:24.41,0:08:25.50,Default,,0,0,0,,«Ән сайысы»
Dialogue: 0,0:08:33.62,0:08:39.12,Default,,0,0,0,,Осы екі балалық досты бәрі қызғанады...
Dialogue: 0,0:08:39.91,0:08:43.45,Default,,0,0,0,,Есте сақтау жақсы, солай емес пе?
Dialogue: 0,0:08:46.12,0:08:48.00,Default,,0,0,0,,Жоқ, мен қателесіппін.
Dialogue: 0,0:09:00.87,0:09:01.79,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:09:01.91,0:09:03.25,Default,,0,0,0,,Қаш!
Dialogue: 0,0:09:12.62,0:09:14.29,Default,,0,0,0,,Менің артымнан ермеңіз
Dialogue: 0,0:09:14.41,0:09:15.91,Default,,0,0,0,,Екіге бөлейік
Dialogue: 0,0:09:30.91,0:09:32.66,Default,,0,0,0,,Сен Сутаннан келдің бе?
Dialogue: 0,0:09:32.79,0:09:35.04,Default,,0,0,0,,Сутан роботы
Dialogue: 0,0:09:35.16,0:09:39.54,Default,,0,0,0,,Арнайы шеберлік: Ресурстарды зерттеу Жауынгерлік қабілет: 750 Естеліктерді қалпына келтіру техникасы бар екені рас па?
Dialogue: 0,0:09:39.54,0:09:40.20,Default,,0,0,0,,Есте сақтауды қалпына келтіру технологиясы бар екені рас па?
Dialogue: 0,0:09:40.87,0:09:45.70,Default,,0,0,0,,Мен роботпын, менің естеліктерім имплантацияланды.
Dialogue: 0,0:09:45.83,0:09:50.29,Default,,0,0,0,,Бірақ деректер технологияның бар екенін көрсетеді.
Dialogue: 0,0:09:51.87,0:09:54.83,Default,,0,0,0,,Бұл сіздің пәрмен тақтасы ма?
Dialogue: 0,0:09:55.50,0:09:57.50,Default,,0,0,0,,Ах, бұл мені құтқарды.
Dialogue: 0,0:09:57.87,0:09:59.54,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:09:59.66,0:10:01.66,Default,,0,0,0,,Күндізгі жарық?
Dialogue: 0,0:10:01.79,0:10:07.00,Default,,0,0,0,,Мәліметтер бойынша, сол командалық тақтайшаны ұстап тұрған адам біздің жауымыз.
Dialogue: 0,0:10:07.79,0:10:09.04,Default,,0,0,0,,Жою
Dialogue: 0,0:10:13.20,0:10:15.00,Default,,0,0,0,,Көліксіз қалай қайтамын? Құдай-ай!
Dialogue: 0,0:10:15.25,0:10:18.41,Default,,0,0,0,,Мүлікке зиян келтіру. 500 юань айыппұл төлеңіз.
Dialogue: 0,0:10:31.91,0:10:34.75,Default,,0,0,0,,Зейінді жинақта, қайшыны ақылмен басқар.
Dialogue: 0,0:11:14.50,0:11:16.16,Default,,0,0,0,,Бұл менің жоғалтуым
Dialogue: 0,0:11:26.95,0:11:28.95,Default,,0,0,0,,Күте тұрыңыз, айтыңыз.
Dialogue: 0,0:11:29.08,0:11:31.41,Default,,0,0,0,,Неге мені өлтірмексің?
Dialogue: 0,0:11:33.08,0:11:34.95,Default,,0,0,0,,Деректерге сәйкес…
Dialogue: 0,0:11:42.70,0:11:46.75,Default,,0,0,0,,Қат! Мен сөйлеп болған соң мені өлтір.
Dialogue: 0,0:11:58.25,0:12:00.54,Default,,0,0,0,,Неліктен қастандық ұйымының планшеті?
Dialogue: 0,0:12:03.41,0:12:05.20,Default,,0,0,0,,Қастандық ұйымының командалық картасы?
Dialogue: 0,0:12:05.87,0:12:07.79,Default,,0,0,0,,Сіз бұл туралы айтып отырсыз ба?
Dialogue: 0,0:12:09.41,0:12:10.41,Default,,0,0,0,,Мойындау
Dialogue: 0,0:12:10.54,0:12:14.66,Default,,0,0,0,,Миссияның сәтсіздігі Өзін-өзі жоюды бастау
Dialogue: 0,0:12:14.95,0:12:15.54,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:12:19.41,0:12:20.16,Default,,0,0,0,,Пәрмен тақтасы бұл...
Dialogue: 0,0:12:37.45,0:12:39.54,Default,,0,0,0,,Эй, оян
Dialogue: 0,0:12:41.75,0:12:46.25,Default,,0,0,0,,Мен шашымды қырқыңыз дедім, бірақ жарылыс жасадыңыз ба?
Dialogue: 0,0:12:46.54,0:12:48.79,Default,,0,0,0,,Миссия сәтсіз аяқталды, бұл соңғы манту.
Dialogue: 0,0:12:50.04,0:12:51.58,Default,,0,0,0,,Ендеше, солай істеуге болады.
Dialogue: 0,0:12:54.04,0:12:56.66,Default,,0,0,0,,Бұл дәмді. Бұл сіздің аш болғаныңыз үшін бе?
Dialogue: 0,0:13:01.41,0:13:04.79,Default,,0,0,0,,Дайбо Қастандық ұйымы дегеніміз не?
Dialogue: 0,0:13:05.12,0:13:09.41,Default,,0,0,0,,Бұл жұмбақ ұйым және олар сирек кездеседі.
Dialogue: 0,0:13:09.83,0:13:11.83,Default,,0,0,0,,Іздеудің қажеті жоқ
Dialogue: 0,0:13:12.50,0:13:17.04,Default,,0,0,0,,Бірақ егер сіз ең жақсы 100 өлтірушілер қатарында болсаңыз, бұл басқа әңгіме.
Dialogue: 0,0:13:17.66,0:13:20.70,Default,,0,0,0,,Ұйымға баруға тырысу -
Dialogue: 0,0:13:21.33,0:13:24.00,Default,,0,0,0,,Әр жерден пайда болады
Dialogue: 0,0:13:24.29,0:13:25.70,Default,,0,0,0,,«Жеті»
Dialogue: 0,0:13:30.20,0:13:33.83,Default,,0,0,0,,Мен сізді менеджер деп шештім.
Dialogue: 0,0:13:34.00,0:13:35.54,Default,,0,0,0,,7 Дәреже 17369-шы
Dialogue: 0,0:13:34.00,0:13:35.54,Default,,0,0,0,,Мен үздік 100-ге кіремін
Dialogue: 0,0:13:35.54,0:13:35.66,Default,,0,0,0,,Мен үздік 100-ге кіремін
Dialogue: 0,0:13:35.66,0:13:37.04,Default,,0,0,0,,Мен үздік 100-ге кіремін
Dialogue: 0,0:13:35.66,0:13:37.04,Default,,0,0,0,,Шаштараз мамандығы бойынша қайшы
Dialogue: 0,0:13:37.54,0:13:39.58,Default,,0,0,0,,Мен сені надан жақсы көремін
Dialogue: 0,0:13:37.54,0:13:39.58,Default,,0,0,0,,Дайбо
Dialogue: 0,0:13:40.00,0:13:42.75,Default,,0,0,0,,Төменде менің сұлулық салоным бар.
Dialogue: 0,0:13:40.00,0:13:42.75,Default,,0,0,0,,Сұлулық салонының менеджері Арнайы дағдылар Бутавизияларды ойлап табу
Dialogue: 0,0:13:43.20,0:13:46.66,Default,,0,0,0,,Мұны біздің амалдар базамызға айналдырайық.
Dialogue: 0,0:13:43.20,0:13:46.66,Default,,0,0,0,,〝Daibo сұлулық салоны〞
Dialogue: 0,0:13:47.37,0:13:48.62,Default,,0,0,0,,төртінші матчқа жетті, үш кездесуден кейін екі жақ та бір жеңіс, бір жеңіліс және бір теңдікпен
Dialogue: 0,0:13:53.45,0:13:56.37,Default,,0,0,0,,Жаңа қайшылар жасады
Dialogue: 0,0:13:56.87,0:13:58.79,Default,,0,0,0,,Қиылмайтын нәрсе жоқ.
Dialogue: 0,0:14:01.12,0:14:02.70,Default,,0,0,0,,Біздің сөзіміз
Dialogue: 0,0:14:06.83,0:14:10.54,Default,,0,0,0,,«Жамандарды өлтіріп, көп ақша табыңыз»
Dialogue: 0,0:14:10.66,0:14:14.58,Default,,0,0,0,,«Қолдарыңды көтеріп, қылышыңды түсір»
Dialogue: 0,0:14:17.12,0:14:20.62,Default,,0,0,0,,Жас ханым, шашыңызды жуған жоқсыз ба?
Dialogue: 0,0:14:21.50,0:14:24.25,Default,,0,0,0,,Арнайы қызмет кіреді.
Dialogue: 0,0:14:27.04,0:14:27.95,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:14:29.45,0:14:35.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory