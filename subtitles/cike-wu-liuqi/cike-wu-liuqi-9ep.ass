Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:09.95,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:26.37,0:00:30.37,Default,,0,0,0,,Миссия 9 Арал дағдарысы
Dialogue: 0,0:00:41.20,0:00:42.00,Default,,0,0,0,,Өлмейтін Ваджра
Dialogue: 0,0:01:51.29,0:01:56.08,Default,,0,0,0,,Мен саған Жетіні құтқар дедім, сен неге оққағарсың?
Dialogue: 0,0:01:59.20,0:02:00.33,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:02:00.45,0:02:03.12,Default,,0,0,0,,Күшті босқа жұмсау
Dialogue: 0,0:02:04.33,0:02:07.20,Default,,0,0,0,,Жеті, тез қаш.
Dialogue: 0,0:02:07.87,0:02:10.79,Default,,0,0,0,,Сутандарға араласпа
Dialogue: 0,0:02:27.33,0:02:29.37,Default,,0,0,0,,Бұл сіздің әрекетіңіз болды ма?
Dialogue: 0,0:02:42.41,0:02:46.08,Default,,0,0,0,,Сырт көзге алданып қалмаңыз
Dialogue: 0,0:02:47.50,0:02:49.75,Default,,0,0,0,,Неліктен аралға шабуыл жасау керек?
Dialogue: 0,0:02:51.54,0:02:53.95,Default,,0,0,0,,Сіз бұның алдын алдыңыз ба?
Dialogue: 0,0:02:54.25,0:02:55.75,Default,,0,0,0,,«Бетті тану»
Dialogue: 0,0:02:57.45,0:02:59.04,Default,,0,0,0,,«100% ұқсастық өлтіруші»
Dialogue: 0,0:03:38.45,0:03:40.12,Default,,0,0,0,,Ханзада Сутанның арнайы техникасы
Dialogue: 0,0:03:40.12,0:03:41.45,Default,,0,0,0,,Ханзада Сутанның арнайы техникасы
Dialogue: 0,0:03:40.12,0:03:41.45,Default,,0,0,0,,Ісімізді аяқтайық
Dialogue: 0,0:03:41.45,0:03:41.54,Default,,0,0,0,,Ханзада Сутанның арнайы техникасы
Dialogue: 0,0:03:50.45,0:03:52.70,Default,,0,0,0,,Мына үлкен тастың астында.
Dialogue: 0,0:04:20.12,0:04:24.70,Default,,0,0,0,,Сол тасты жылжытсаңыз, бұл арал суға батады.
Dialogue: 0,0:04:25.25,0:04:27.91,Default,,0,0,0,,Алдымен мен шалбарымды киюім керек.
Dialogue: 0,0:04:29.87,0:04:30.83,Default,,0,0,0,,Шығу
Dialogue: 0,0:04:36.87,0:04:38.41,Default,,0,0,0,,Барлығың мұқият тыңдаңдар.
Dialogue: 0,0:04:38.87,0:04:40.00,Default,,0,0,0,,Мен Сутан ханзадамын
Dialogue: 0,0:04:41.20,0:04:43.87,Default,,0,0,0,,Еліміздің технологиялық дамуы үшін -
Dialogue: 0,0:04:44.08,0:04:47.50,Default,,0,0,0,,Арал астында ұйықтап жатқан энергетикалық тасты алыңыз
Dialogue: 0,0:04:48.04,0:04:50.04,Default,,0,0,0,,Бұл арал бастапқыда...
Dialogue: 0,0:04:50.16,0:04:54.33,Default,,0,0,0,,Материалдар бір-бірімен тартылып, тастың күшімен жасалған.
Dialogue: 0,0:04:54.79,0:04:58.33,Default,,0,0,0,,Егер тастар таусылса, бұл арал суға батады.
Dialogue: 0,0:04:58.91,0:05:01.08,Default,,0,0,0,,Өлгің келмесе, аралдан кет.
Dialogue: 0,0:05:08.45,0:05:10.20,Default,,0,0,0,,Оны қазірдің өзінде ұмытыңыз
Dialogue: 0,0:05:10.50,0:05:13.20,Default,,0,0,0,,Сіз олардың күшін білмейсіз
Dialogue: 0,0:05:13.70,0:05:16.00,Default,,0,0,0,,Шындықты айтатын кез келді
Dialogue: 0,0:05:16.25,0:05:19.00,Default,,0,0,0,,Бұл дүние үш негізгі күштен тұрады.
Dialogue: 0,0:05:19.12,0:05:20.87,Default,,0,0,0,,Кунг-фу патшалығы Сюаньву
Dialogue: 0,0:05:21.00,0:05:22.83,Default,,0,0,0,,Жетілдірілген технология сутан
Dialogue: 0,0:05:23.08,0:05:25.79,Default,,0,0,0,,Ал біз, қарапайым адамдар
Dialogue: 0,0:05:26.16,0:05:30.16,Default,,0,0,0,,Сутандар әлсіз көрінуі мүмкін, бірақ олар ақылды.
Dialogue: 0,0:05:30.29,0:05:35.45,Default,,0,0,0,,Ол жоғары өнімді қаруды ойлап тапты және технология ең күшті деп есептейді.
Dialogue: 0,0:05:35.58,0:05:38.70,Default,,0,0,0,,Олардың бас жауы – Кун-фудың Сюаньву елі.
Dialogue: 0,0:05:38.83,0:05:41.00,Default,,0,0,0,,Қарулы күштер және ғылым мен техника
Dialogue: 0,0:05:41.54,0:05:45.33,Default,,0,0,0,,Кім күшті деген талас бұрыннан бар.
Dialogue: 0,0:05:46.04,0:05:48.66,Default,,0,0,0,,Біз жай ғана шеттен қарап отырамыз
Dialogue: 0,0:05:48.79,0:05:51.08,Default,,0,0,0,,Лайықты қарсылас емес
Dialogue: 0,0:05:51.45,0:05:55.41,Default,,0,0,0,,Егер қайтып оралсаң, сені өлтіреді.
Dialogue: 0,0:06:01.12,0:06:02.95,Default,,0,0,0,,Менің барлық мүлкім
Dialogue: 0,0:06:03.54,0:06:07.62,Default,,0,0,0,,Бұл ақшаны басқыншыларды өлтіру үшін пайдаланыңыз.
Dialogue: 0,0:06:08.41,0:06:11.29,Default,,0,0,0,,Шотта 3243 юань бар.
Dialogue: 0,0:06:12.16,0:06:15.37,Default,,0,0,0,,Құпия сөз – 123456
Dialogue: 0,0:06:18.12,0:06:19.08,Default,,0,0,0,,Аралдың жартысы менің территориям.
Dialogue: 0,0:06:19.08,0:06:21.29,Default,,0,0,0,,Аралдың жартысы менің территориям.
Dialogue: 0,0:06:19.08,0:06:21.29,Default,,0,0,0,,Мияу Мияу
Dialogue: 0,0:06:21.41,0:06:22.37,Default,,0,0,0,,Cat Boss Technique Catherine Claw
Dialogue: 0,0:06:22.37,0:06:25.12,Default,,0,0,0,,Cat Boss Technique Catherine Claw
Dialogue: 0,0:06:22.37,0:06:25.12,Default,,0,0,0,,Рұқсатсыз кірсе, қиындық тудырар еді.
Dialogue: 0,0:06:25.12,0:06:25.75,Default,,0,0,0,,Cat Boss техникасы Кэтрин Клау
Dialogue: 0,0:06:32.50,0:06:35.12,Default,,0,0,0,,Тырнақтарды кесу уақыты келді
Dialogue: 0,0:06:48.70,0:06:49.87,Default,,0,0,0,,Мияу
Dialogue: 0,0:06:50.41,0:06:51.45,Default,,0,0,0,,Ақылды
Dialogue: 0,0:06:57.91,0:06:58.12,Default,,0,0,0,,Миаоды ренжіткендер тыңдасын.
Dialogue: 0,0:06:58.12,0:07:00.91,Default,,0,0,0,,Миаоды ренжіткендер тыңдасын.
Dialogue: 0,0:06:58.12,0:07:00.91,Default,,0,0,0,,Rock'n'Roll Mad One
Dialogue: 0,0:07:19.54,0:07:20.20,Default,,0,0,0,,Бұл шу.
Dialogue: 0,0:07:21.87,0:07:24.62,Default,,0,0,0,,«Қарама-қарсы фазалық дыбыс толқынының генерациясы»
Dialogue: 0,0:07:35.33,0:07:37.12,Default,,0,0,0,,Тәртіп қажет.
Dialogue: 0,0:07:37.37,0:07:39.45,Default,,0,0,0,,Маған шеберді шақырыңыз
Dialogue: 0,0:07:47.95,0:07:51.37,Default,,0,0,0,,Блять сендерге, басқыншылар!
Dialogue: 0,0:07:58.20,0:07:59.29,Default,,0,0,0,,Чен ағай
Dialogue: 0,0:07:59.41,0:08:01.91,Default,,0,0,0,,Тауық аралының жағалау күзеті жауынгерлік қабілеті 45
Dialogue: 0,0:08:06.12,0:08:07.79,Default,,0,0,0,,Өл, үй жануарлары.
Dialogue: 0,0:08:09.45,0:08:10.37,Default,,0,0,0,,Мияу
Dialogue: 0,0:08:10.50,0:08:11.45,Default,,0,0,0,,Ақылды
Dialogue: 0,0:08:11.58,0:08:14.37,Default,,0,0,0,,Сәлеметсіз бе, көзілдірік мырза
Dialogue: 0,0:08:14.91,0:08:17.04,Default,,0,0,0,,Жетіні көрдіңіз бе?
Dialogue: 0,0:08:17.16,0:08:20.54,Default,,0,0,0,,Байланған шашы үш талға бөлінген адам.
Dialogue: 0,0:08:21.70,0:08:22.16,Default,,0,0,0,,Мен саған бір сыр айтайын
Dialogue: 0,0:08:22.16,0:08:23.95,Default,,0,0,0,,Мен саған бір сыр айтайын
Dialogue: 0,0:08:22.16,0:08:23.95,Default,,0,0,0,,Кора, ерекше қабілеті бар қыз
Dialogue: 0,0:08:24.16,0:08:25.08,Default,,0,0,0,,«Қауіпсіздік»
Dialogue: 0,0:08:25.91,0:08:29.83,Default,,0,0,0,,Сіз білесіз бе? Бұл аралда...
Dialogue: 0,0:08:37.95,0:08:38.66,Default,,0,0,0,,«Мен сені сүйемін»
Dialogue: 0,0:08:42.41,0:08:45.08,Default,,0,0,0,,Мен сүйген адам менің жігітім
Dialogue: 0,0:08:45.29,0:08:47.91,Default,,0,0,0,,Мен үшін аралды қиратпа
Dialogue: 0,0:09:05.58,0:09:07.50,Default,,0,0,0,,Әйелдер қиындық тудыратын жаратылыс
Dialogue: 0,0:09:09.70,0:09:13.91,Default,,0,0,0,,Жаңа айтқаныңыз сексистік және мисогинистік.
Dialogue: 0,0:09:14.50,0:09:17.54,Default,,0,0,0,,«Тазалау комитеті» атауымен -
Dialogue: 0,0:09:18.04,0:09:20.25,Default,,0,0,0,,Мен сені аралдан қуып жіберемін.
Dialogue: 0,0:09:30.66,0:09:32.83,Default,,0,0,0,,Төраға Чианг
Dialogue: 0,0:09:33.25,0:09:36.20,Default,,0,0,0,,Төмен адам мұндай күшті рухтарды қалай басқара алады?
Dialogue: 0,0:10:05.37,0:10:06.16,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:10:12.04,0:10:13.45,Default,,0,0,0,,Қазір кешіріңіз
Dialogue: 0,0:10:15.41,0:10:16.62,Default,,0,0,0,,Мен де
Dialogue: 0,0:10:17.83,0:10:22.45,Default,,0,0,0,,Күткендей, жаудың шабуылын байыппен қабылдау қиын.
Dialogue: 0,0:10:28.50,0:10:29.41,Default,,0,0,0,,Басқарылатын ракета.
Dialogue: 0,0:10:32.16,0:10:34.20,Default,,0,0,0,,Мен сені өзіммен бірге алып кетемін
Dialogue: 0,0:10:34.50,0:10:36.00,Default,,0,0,0,,Ең жоғары деңгейлі кедергі
Dialogue: 0,0:10:37.50,0:10:38.33,Default,,0,0,0,,Тосқауыл?
Dialogue: 0,0:10:39.70,0:10:43.79,Default,,0,0,0,,Ақырында мен аралдағы әйелді қорғай алмадым.
Dialogue: 0,0:11:04.75,0:11:05.33,Default,,0,0,0,,«Жеті»
Dialogue: 0,0:11:16.16,0:11:17.25,Default,,0,0,0,,Төраға Чианг
Dialogue: 0,0:11:17.50,0:11:20.54,Default,,0,0,0,,Бұл жаста қауіпті еліктеушілік жасамаңыз.
Dialogue: 0,0:11:20.66,0:11:21.12,Default,,0,0,0,,7 Дәреже 17369-шы
Dialogue: 0,0:11:21.12,0:11:22.20,Default,,0,0,0,,7 17369-шы дәреже
Dialogue: 0,0:11:21.12,0:11:22.20,Default,,0,0,0,,Мен бұл жігітті жеңемін.
Dialogue: 0,0:11:22.20,0:11:22.33,Default,,0,0,0,,Мен бұл жігітті жеңемін.
Dialogue: 0,0:11:22.33,0:11:23.45,Default,,0,0,0,,Мен бұл жігітті жеңемін.
Dialogue: 0,0:11:22.33,0:11:23.45,Default,,0,0,0,,Шаштараз мамандығы бойынша қайшы
Dialogue: 0,0:11:24.37,0:11:26.29,Default,,0,0,0,,Сыйақы 88 юань.
Dialogue: 0,0:11:26.83,0:11:28.79,Default,,0,0,0,,Осы жерде демалыңыз.
Dialogue: 0,0:11:29.04,0:11:31.75,Default,,0,0,0,,Қалғанын маған қалдырыңыз.
Dialogue: 0,0:13:55.12,0:13:58.12,Default,,0,0,0,,Жапон субтитрлері Тецуко Икегая
