Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.10,0:00:03.07,Default,,0000,0000,0000,,〈Бүгін түнде
Dialogue: 0,0:00:01.10,0:00:03.07,Default,,0000,0000,0000,,Супер эго қос қасиеті>
Dialogue: 0,0:00:12.11,0:00:16.08,Default,,0000,0000,0000,,<Теледидар аниме де 2022 жылдан бастап көрсетіледі→
Dialogue: 0,0:00:16.08,0:00:20.12,Default,,0000,0000,0000,,Танымал «Көк жартастың» театрландырылған нұсқасы
Dialogue: 0,0:00:16.08,0:00:20.12,Default,,0000,0000,0000,,Теледидардан бірінші рет көрсетілді! 〉
Dialogue: 0,0:00:20.12,0:00:23.09,Default,,0000,0000,0000,,Микадж
Dialogue: 0,0:00:20.12,0:00:23.09,Default,,0000,0000,0000,,Арыстан
Dialogue: 0,0:00:20.12,0:00:23.09,Default,,0000,0000,0000,,Кеттік, Наги!
Dialogue: 0,0:00:20.12,0:00:23.09,Default,,0000,0000,0000,,Иса Босс.
Dialogue: 0,0:00:23.09,0:00:27.09,Default,,0000,0000,0000,,<Данышпан шабуылшы Сейширо Наги көзқарасынан алынған
Dialogue: 0,0:00:23.09,0:00:27.09,Default,,0000,0000,0000,,Театрландырылған нұсқа →
Dialogue: 0,0:00:27.09,0:00:32.10,Default,,0000,0000,0000,,Көрермендер саны: 1,32 миллион адам
Dialogue: 0,0:00:27.09,0:00:32.10,Default,,0000,0000,0000,,Кассадан түскен табыс 1,8 миллиард иен! 〉
Dialogue: 0,0:00:32.10,0:00:36.10,Default,,0000,0000,0000,,Мен сені тапқан кезде
Dialogue: 0,0:00:32.10,0:00:36.10,Default,,0000,0000,0000,,Менің арманым басталды!
Dialogue: 0,0:00:36.10,0:00:39.11,Default,,0000,0000,0000,,Менің ойымша, бұл дәл қазір қызық болуы мүмкін.
Dialogue: 0,0:00:39.11,0:00:41.17,Default,,0000,0000,0000,,Исаги
Dialogue: 0,0:00:39.11,0:00:41.17,Default,,0000,0000,0000,,Йоичи
Dialogue: 0,0:00:39.11,0:00:41.17,Default,,0000,0000,0000,,Шу шығар, данышпан...
Dialogue: 0,0:00:41.17,0:00:43.14,Default,,0000,0000,0000,,〈Ал негізгі оқиға аяқталғаннан кейін⤵️
Dialogue: 0,0:00:45.08,0:00:47.08,Default,,0000,0000,0000,,Оны жіберіп алмаңыз! 〉
Dialogue: 0,0:00:48.08,0:00:50.12,Default,,0000,0000,0000,,<Сонымен қатар түн ортасынан бастап→
Dialogue: 0,0:00:50.12,0:00:55.09,Default,,0000,0000,0000,,Телехикаяның екінші маусымы
Dialogue: 0,0:00:50.12,0:00:55.09,Default,,0000,0000,0000,,Жапонияның жиырма жасында
Dialogue: 0,0:00:50.12,0:00:55.09,Default,,0000,0000,0000,,«Blue Rock VS. U-20 JAPAN» басталды>
Dialogue: 0,0:00:55.09,0:00:59.09,Default,,0000,0000,0000,,Мен әлемдегі ең үздік шабуылшы боламын! !
Dialogue: 0,0:01:29.09,0:01:33.06,Default,,0000,0000,0000,,(Сейширо Наги)
Dialogue: 0,0:01:29.09,0:01:33.06,Default,,0000,0000,0000,,<Неге бәрің де көп жұмыс істейсіңдер? 〉
Dialogue: 0,0:01:35.06,0:01:40.07,Default,,0000,0000,0000,,<Оқу, үйірме жұмыстары, махаббат...>
Dialogue: 0,0:01:40.07,0:01:45.07,Default,,0000,0000,0000,,<Жеңіңіз немесе жеңіліңіз
Dialogue: 0,0:01:40.07,0:01:45.07,Default,,0000,0000,0000,,Басқалардан бағалауды сұрау...>
Dialogue: 0,0:01:46.07,0:01:51.08,Default,,0000,0000,0000,,〈Ерекше жас, ерекше болмыс〉
Dialogue: 0,0:01:51.08,0:01:56.05,Default,,0000,0000,0000,,<Мен бұл туралы шынымен түсінбеймін және ешқашан ойлаған да емеспін>
Dialogue: 0,0:01:56.05,0:01:59.09,Default,,0000,0000,0000,,<Болашақтың армандары...>
Dialogue: 0,0:01:59.09,0:02:01.05,Default,,0000,0000,0000,,Ақаулық.
Dialogue: 0,0:02:02.09,0:02:04.09,Default,,0000,0000,0000,,(Ойын дыбысы)
Dialogue: 0,0:02:04.09,0:02:08.06,Default,,0000,0000,0000,,〈Бұдан былай да
Dialogue: 0,0:02:04.09,0:02:08.06,Default,,0000,0000,0000,,Ойын ойнап, жалқау өмір сүргім келеді
Dialogue: 0,0:02:10.10,0:02:12.07,Default,,0000,0000,0000,,Микадж
Dialogue: 0,0:02:10.10,0:02:12.07,Default,,0000,0000,0000,,Арыстан
Dialogue: 0,0:02:10.10,0:02:12.07,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:02:13.07,0:02:16.07,Default,,0000,0000,0000,,《Жоқ! Үзіліс》
Dialogue: 0,0:02:16.07,0:02:30.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:30.08,0:02:32.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:32.09,0:02:35.09,Default,,0000,0000,0000,,Уа, сен әлі тірісің.
Dialogue: 0,0:02:35.09,0:02:38.09,Default,,0000,0000,0000,,Эй... сен кереметсің!
Dialogue: 0,0:02:35.09,0:02:38.09,Default,,0000,0000,0000,,Футбол клубы?
Dialogue: 0,0:02:38.09,0:02:40.06,Default,,0000,0000,0000,,Ах... өлді.
Dialogue: 0,0:02:40.06,0:02:44.06,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:02:40.06,0:02:44.06,Default,,0000,0000,0000,,Менімен футбол ойнайсың ба?
Dialogue: 0,0:02:44.06,0:02:46.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:46.07,0:02:51.10,Default,,0000,0000,0000,,Әй, ол байдың баласы.
Dialogue: 0,0:02:46.07,0:02:51.10,Default,,0000,0000,0000,,Маған ақшаны беріңіз.
Dialogue: 0,0:02:51.10,0:02:53.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:53.11,0:02:57.11,Default,,0000,0000,0000,,Мен футбол ойнамаймын.
Dialogue: 0,0:02:53.11,0:02:57.11,Default,,0000,0000,0000,,Мен де ешқашан спортпен айналысқан емеспін.
Dialogue: 0,0:02:57.11,0:03:00.08,Default,,0000,0000,0000,,Мен өмір бойы жалқау болғым келеді.
Dialogue: 0,0:03:00.08,0:03:02.12,Default,,0000,0000,0000,,Маған ақшаны беріңіз.
Dialogue: 0,0:03:02.12,0:03:06.12,Default,,0000,0000,0000,,Жоқ, жоқ... ертедегі қақпан
Dialogue: 0,0:03:02.12,0:03:06.12,Default,,0000,0000,0000,,Сіз дарынды екенсіз.
Dialogue: 0,0:03:06.12,0:03:08.09,Default,,0000,0000,0000,,Менімен футбол ойнайық.
Dialogue: 0,0:03:08.09,0:03:12.09,Default,,0000,0000,0000,,Мен қиындықты жек көремін.
Dialogue: 0,0:03:08.09,0:03:12.09,Default,,0000,0000,0000,,Менің жұмыс істегім келмейді.
Dialogue: 0,0:03:14.09,0:03:16.06,Default,,0000,0000,0000,,Хэхе….
Dialogue: 0,0:03:17.10,0:03:21.10,Default,,0000,0000,0000,,Қызық! Сіз бұрынғыдай қала аласыз!
Dialogue: 0,0:03:21.10,0:03:25.07,Default,,0000,0000,0000,,《Бұл адам несіне қатты толқып отыр? 》
Dialogue: 0,0:03:25.07,0:03:28.07,Default,,0000,0000,0000,,Футбол ойнайық! Хехе!
Dialogue: 0,0:03:29.11,0:03:31.08,Default,,0000,0000,0000,,《Маған...? 》
Dialogue: 0,0:03:31.08,0:03:37.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:47.09,0:03:52.10,Default,,0000,0000,0000,,(оятар қоңырауы)
Dialogue: 0,0:03:52.10,0:03:54.17,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:03:54.17,0:03:56.14,Default,,0000,0000,0000,,(оятар қоңырауы)
Dialogue: 0,0:04:05.08,0:04:07.08,Default,,0000,0000,0000,,Қайырлы таң, Чоки.
Dialogue: 0,0:04:07.08,0:04:09.12,Default,,0000,0000,0000,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:04:09.12,0:04:11.08,Default,,0000,0000,0000,,《Аа... оян》
Dialogue: 0,0:04:18.09,0:04:21.09,Default,,0000,0000,0000,,《Неге?
Dialogue: 0,0:04:18.09,0:04:21.09,Default,,0000,0000,0000,,Адамдар аш бола ма? 》
Dialogue: 0,0:04:21.09,0:04:24.06,Default,,0000,0000,0000,,《Мен аз жеу керек емес》
Dialogue: 0,0:04:25.10,0:04:28.07,Default,,0000,0000,0000,,《Тамақ ішпесем, жылтыратудың қажеті жоқ》
Dialogue: 0,0:04:28.07,0:04:32.07,Default,,0000,0000,0000,,《Мектеп жоқ
Dialogue: 0,0:04:28.07,0:04:32.07,Default,,0000,0000,0000,,Мен мәңгілік ойындар ойнай аламын》
Dialogue: 0,0:04:33.07,0:04:36.08,Default,,0000,0000,0000,,《Өмір сүру қиын》
Dialogue: 0,0:04:36.08,0:04:38.04,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:39.08,0:04:43.08,Default,,0000,0000,0000,,Олай болса, мен барайын. дана.
Dialogue: 0,0:04:53.06,0:04:56.06,Default,,0000,0000,0000,,Наги!
Dialogue: 0,0:04:53.06,0:04:56.06,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:04:56.06,0:05:00.07,Default,,0000,0000,0000,,Ио, Наги! Бұл адам жақсы. менің қызметшім.
Dialogue: 0,0:05:00.07,0:05:04.07,Default,,0000,0000,0000,,Осыны ескеріңіз.
Dialogue: 0,0:05:04.07,0:05:07.07,Default,,0000,0000,0000,,Кәне, бүгіннен бастап бірге футбол ойнайық!
Dialogue: 0,0:05:07.07,0:05:09.11,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:05:09.11,0:05:13.08,Default,,0000,0000,0000,,Сіз маған өткен күні уәде берген едіңіз!
Dialogue: 0,0:05:09.11,0:05:13.08,Default,,0000,0000,0000,,О... сен бе?
Dialogue: 0,0:05:13.08,0:05:17.08,Default,,0000,0000,0000,,Мен қалаған нәрсе болды
Dialogue: 0,0:05:13.08,0:05:17.08,Default,,0000,0000,0000,,Менде бәрін алу философиясы бар.
Dialogue: 0,0:05:17.08,0:05:20.09,Default,,0000,0000,0000,,
Dialogue: 0,0:05:17.08,0:05:20.09,Default,,0000,0000,0000,,Сен менің серіктесімсің...
Dialogue: 0,0:05:20.09,0:05:23.06,Default,,0000,0000,0000,,Әй, эй...! Эй Наги!
Dialogue: 0,0:05:27.09,0:05:30.10,Default,,0000,0000,0000,,Оря. Хесшо. Өл.
Dialogue: 0,0:05:30.10,0:05:32.07,Default,,0000,0000,0000,,Уф...!
Dialogue: 0,0:05:32.07,0:05:35.07,Default,,0000,0000,0000,,Мен оны таптым. Футбол ойнайық!
Dialogue: 0,0:05:35.07,0:05:38.07,Default,,0000,0000,0000,,Жарайды... сен сондай табандысың.
Dialogue: 0,0:05:38.07,0:05:43.08,Default,,0000,0000,0000,,Сен менімен әлемнің ең жақсысы болуың керек.
Dialogue: 0,0:05:38.07,0:05:43.08,Default,,0000,0000,0000,,Тағдыр солай.
Dialogue: 0,0:05:43.08,0:05:46.08,Default,,0000,0000,0000,,Мен сені тапқаныма мақтан!
Dialogue: 0,0:05:46.08,0:05:48.08,Default,,0000,0000,0000,,Ақаулық.
Dialogue: 0,0:05:48.08,0:05:52.09,Default,,0000,0000,0000,,Дәлірек айтқанда
Dialogue: 0,0:05:48.08,0:05:52.09,Default,,0000,0000,0000,,Неліктен футбол ойнағың келеді?
Dialogue: 0,0:05:52.09,0:05:55.05,Default,,0000,0000,0000,,Рей Микадждің бұл өмірі...
Dialogue: 0,0:05:57.09,0:06:03.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:03.06,0:06:06.07,Default,,0000,0000,0000,,Мен жалықтым. Бұл қызықсыз.
Dialogue: 0,0:06:06.07,0:06:09.10,Default,,0000,0000,0000,,Жалқаулыққа толы болды.
Dialogue: 0,0:06:09.10,0:06:12.11,Default,,0000,0000,0000,,Мен қалағанның бәрін алдым.
Dialogue: 0,0:06:12.11,0:06:17.11,Default,,0000,0000,0000,,Бірақ онда
Dialogue: 0,0:06:12.11,0:06:17.11,Default,,0000,0000,0000,,Мен қалағанымды таба алмадым.
Dialogue: 0,0:06:17.11,0:06:22.08,Default,,0000,0000,0000,,Мен өзіме ғана арналған қайталанбас қазына алғым келді.
Dialogue: 0,0:06:25.08,0:06:31.09,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:31.09,0:06:34.09,Default,,0000,0000,0000,,«(қуаныш)»
Dialogue: 0,0:06:34.09,0:06:38.10,Default,,0000,0000,0000,,Міне... Мен мұны қалаймын!
Dialogue: 0,0:06:38.10,0:06:42.10,Default,,0000,0000,0000,,Жоқ. Бас тарту.
Dialogue: 0,0:06:38.10,0:06:42.10,Default,,0000,0000,0000,,Сен менің мұрагерімсің.
Dialogue: 0,0:06:42.10,0:06:44.10,Default,,0000,0000,0000,,Дұрыс, Рей патша.
Dialogue: 0,0:06:44.10,0:06:46.07,Default,,0000,0000,0000,,Мен мұны сен үшін айтып отырмын.
Dialogue: 0,0:06:48.07,0:06:52.08,Default,,0000,0000,0000,,Бірақ мен сені тапқанда...
Dialogue: 0,0:06:54.08,0:06:58.08,Default,,0000,0000,0000,,Менің арманым басталды!
Dialogue: 0,0:06:59.09,0:07:03.09,Default,,0000,0000,0000,,Ақаулық.
Dialogue: 0,0:06:59.09,0:07:03.09,Default,,0000,0000,0000,,Сіз тым көп аниме көрмейсіз бе?
Dialogue: 0,0:07:03.09,0:07:07.09,Default,,0000,0000,0000,,Ал мен футбол ойнамаймын.
Dialogue: 0,0:07:03.09,0:07:07.09,Default,,0000,0000,0000,,Ережелерді де дұрыс білмеймін...
Dialogue: 0,0:07:07.09,0:07:12.10,Default,,0000,0000,0000,,Жарайды! сен
Dialogue: 0,0:07:07.09,0:07:12.10,Default,,0000,0000,0000,,Менің айтқанымды орындаңыз.
Dialogue: 0,0:07:12.10,0:07:16.10,Default,,0000,0000,0000,,Енді ұлттық үстемдікке машықтанайық!
Dialogue: 0,0:07:16.10,0:07:19.11,Default,,0000,0000,0000,,Танысқаныма қуаныштымын, Наги! Мені бастық деп шақыр.
Dialogue: 0,0:07:19.11,0:07:22.07,Default,,0000,0000,0000,,Бірақ Рейу
Dialogue: 0,0:07:19.11,0:07:22.07,Default,,0000,0000,0000,,Бұл бірінші кезекте футбол клубы емес пе?
Dialogue: 0,0:07:24.08,0:07:28.08,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:07:24.08,0:07:28.08,Default,,0000,0000,0000,,Қош келдіңіз капитан Рейо!
Dialogue: 0,0:07:28.08,0:07:30.08,Default,,0000,0000,0000,,Айқай... неге?
Dialogue: 0,0:07:30.08,0:07:34.09,Default,,0000,0000,0000,,Бұл байланыс. Бұл байланыс.
Dialogue: 0,0:07:30.08,0:07:34.09,Default,,0000,0000,0000,,Нені пайдалануға болады Жай ғана пайдаланыңыз.
Dialogue: 0,0:07:34.09,0:07:38.09,Default,,0000,0000,0000,,Елді түгел араласаң
Dialogue: 0,0:07:34.09,0:07:38.09,Default,,0000,0000,0000,,Сіз пұттарыңызбен кешке қатыса аласыз! ?
Dialogue: 0,0:07:38.09,0:07:41.09,Default,,0000,0000,0000,,Егер сіз жеңсеңіз
Dialogue: 0,0:07:38.09,0:07:41.09,Default,,0000,0000,0000,,Актрисамен ойын-сауық саябағы! ?
Dialogue: 0,0:07:41.09,0:07:47.07,Default,,0000,0000,0000,,А, осындай нәрсе.
Dialogue: 0,0:07:41.09,0:07:47.07,Default,,0000,0000,0000,,Пауэр, Mikage корпорациясының мұрагері.
Dialogue: 0,0:07:47.07,0:07:49.07,Default,,0000,0000,0000,,Ах! Бұл анық.
Dialogue: 0,0:07:49.07,0:07:53.07,Default,,0000,0000,0000,,Әлі жоқ
Dialogue: 0,0:07:49.07,0:07:53.07,Default,,0000,0000,0000,,Сегіз
Dialogue: 0,0:07:49.07,0:07:53.07,Default,,0000,0000,0000,,Аймақтық алдын ала жарыста тек 8 үздік →
Dialogue: 0,0:07:53.07,0:07:57.08,Default,,0000,0000,0000,,Енді мен осында болғандықтан, республикалық байқауға қатысу маңызды!
Dialogue: 0,0:07:57.08,0:08:00.08,Default,,0000,0000,0000,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:08:00.08,0:08:04.08,Default,,0000,0000,0000,,Әй... Әй, бұл қиын!
Dialogue: 0,0:08:00.08,0:08:04.08,Default,,0000,0000,0000,,Маған жаңа ғана жаттығу матчына өтінім келді...
Dialogue: 0,0:08:04.08,0:08:07.09,Default,,0000,0000,0000,,Не, бірден?
Dialogue: 0,0:08:04.08,0:08:07.09,Default,,0000,0000,0000,,Жақсы. қайда? қайда?
Dialogue: 0,0:08:07.09,0:08:09.09,Default,,0000,0000,0000,,Бұл...→
Dialogue: 0,0:08:09.09,0:08:14.06,Default,,0000,0000,0000,,Дадада
Dialogue: 0,0:08:09.09,0:08:14.06,Default,,0000,0000,0000,,Дада орта мектебі, республикалық жарыстарға үнемі қатысатын өте күшті мектеп!
Dialogue: 0,0:08:14.06,0:08:18.06,Default,,0000,0000,0000,,Э…?—
Dialogue: 0,0:08:14.06,0:08:18.06,Default,,0000,0000,0000,,Неліктен бұл жерде атақты мектеп бар?
Dialogue: 0,0:08:18.06,0:08:21.07,Default,,0000,0000,0000,,Бұл да капитан Рейо ма?
Dialogue: 0,0:08:18.06,0:08:21.07,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:08:22.07,0:08:25.07,Default,,0000,0000,0000,,Бұл сенің әкеңнің ақшасы.
Dialogue: 0,0:08:25.07,0:08:28.07,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:25.07,0:08:28.07,Default,,0000,0000,0000,,Хабар.
Dialogue: 0,0:08:28.07,0:08:33.08,Default,,0000,0000,0000,,«Егер менің ұлым
Dialogue: 0,0:08:28.07,0:08:33.08,Default,,0000,0000,0000,,Осыншама жеңіске жету заңды емес пе? ”→
Dialogue: 0,0:08:33.08,0:08:36.08,Default,,0000,0000,0000,,«Армандарыңа сыйлық».
Dialogue: 0,0:08:36.08,0:08:38.08,Default,,0000,0000,0000,,Меніңше...
Dialogue: 0,0:08:38.08,0:08:40.09,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:08:40.09,0:08:44.09,Default,,0000,0000,0000,,Сыйлық қандай? Ақымақ болма.
Dialogue: 0,0:08:44.09,0:08:47.06,Default,,0000,0000,0000,,Сіз оларды жаншып, бас тартуға тырысасыз.
Dialogue: 0,0:08:49.06,0:08:52.06,Default,,0000,0000,0000,,Бұл біздің арманымыздағы дебюттік матч.
Dialogue: 0,0:08:52.06,0:08:55.07,Default,,0000,0000,0000,,Наги Маған талантыңды бер.
Dialogue: 0,0:08:55.07,0:08:57.07,Default,,0000,0000,0000,,Рей патша….
Dialogue: 0,0:08:58.07,0:09:00.07,Default,,0000,0000,0000,,Ауырды.
Dialogue: 0,0:08:58.07,0:09:00.07,Default,,0000,0000,0000,,Сіздің жауабыңыз қандай?
Dialogue: 0,0:09:00.07,0:09:03.08,Default,,0000,0000,0000,,Ауырды.
Dialogue: 0,0:09:00.07,0:09:03.08,Default,,0000,0000,0000,,емес.
Dialogue: 0,0:09:06.08,0:09:10.08,Default,,0000,0000,0000,,Намеока
Dialogue: 0,0:09:06.08,0:09:10.08,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:06.08,0:09:10.08,Default,,0000,0000,0000,,Сен неге сонша әлсізсің?
Dialogue: 0,0:09:06.08,0:09:10.08,Default,,0000,0000,0000,,Мен мұны істеуім керек.
Dialogue: 0,0:09:12.08,0:09:14.09,Default,,0000,0000,0000,,(тілді шертеді)
Dialogue: 0,0:09:14.09,0:09:19.06,Default,,0000,0000,0000,,Аңғал Бонбонның арманы
Dialogue: 0,0:09:14.09,0:09:19.06,Default,,0000,0000,0000,,Мен оны бөлшектеп тастаймын.
Dialogue: 0,0:09:19.06,0:09:22.09,Default,,0000,0000,0000,,Құрметпен, қорапты ұлым.
Dialogue: 0,0:09:22.09,0:09:26.07,Default,,0000,0000,0000,,Уайымдама, ақымақ футбол миы.
Dialogue: 0,0:09:26.07,0:09:29.10,Default,,0000,0000,0000,,Кішкентай ыдысыңда мен туралы айтпа.
Dialogue: 0,0:09:29.10,0:09:31.10,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:09:31.10,0:09:35.07,Default,,0000,0000,0000,,Балалар әлі
Dialogue: 0,0:09:31.10,0:09:35.07,Default,,0000,0000,0000,,Мен нағыз данышпандарды білмеймін.
Dialogue: 0,0:09:35.07,0:09:38.08,Default,,0000,0000,0000,,Бухахахаха...!
Dialogue: 0,0:09:38.08,0:09:43.12,Default,,0000,0000,0000,,Жылыжайда өскенім өзіме деген сенімділік сезімін оятты.
Dialogue: 0,0:09:38.08,0:09:43.12,Default,,0000,0000,0000,,Бұл өте көп!
Dialogue: 0,0:09:43.12,0:09:49.09,Default,,0000,0000,0000,,Мен сені құрту үшін бар күшімді саламын.
Dialogue: 0,0:09:43.12,0:09:49.09,Default,,0000,0000,0000,,Нағыз данышпан.
Dialogue: 0,0:09:49.09,0:09:51.09,Default,,0000,0000,0000,,
Dialogue: 0,0:09:53.09,0:10:03.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:10:03.10,0:10:06.11,Default,,0000,0000,0000,,《Бұл жігіт... шынымен де данышпан ба? ? 》
Dialogue: 0,0:10:06.11,0:10:09.11,Default,,0000,0000,0000,,Не... не істеп жатырсың!
Dialogue: 0,0:10:06.11,0:10:09.11,Default,,0000,0000,0000,,Тоқтатыңыз, бұл бонбон!
Dialogue: 0,0:10:09.11,0:10:11.08,Default,,0000,0000,0000,,Оны ұсақтаңыз!
Dialogue: 0,0:10:12.08,0:10:14.08,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:10:14.08,0:10:17.08,Default,,0000,0000,0000,,Футбол туралы не деуге болады?
Dialogue: 0,0:10:14.08,0:10:17.08,Default,,0000,0000,0000,,Ережелерді де дұрыс білмеймін...
Dialogue: 0,0:10:17.08,0:10:21.12,Default,,0000,0000,0000,,Жарайды! сен
Dialogue: 0,0:10:17.08,0:10:21.12,Default,,0000,0000,0000,,Менің айтқанымды орындаңыз.
Dialogue: 0,0:10:21.12,0:10:24.09,Default,,0000,0000,0000,,Мен сенің әлемдегі ең жақсы екеніңді дәлелдеймін.
Dialogue: 0,0:10:24.09,0:10:27.09,Default,,0000,0000,0000,,Наги, сен...
Dialogue: 0,0:10:29.10,0:10:34.07,Default,,0000,0000,0000,,(Рей патшаның дауысы)
Dialogue: 0,0:10:29.10,0:10:34.07,Default,,0000,0000,0000,,Маған ғана сеніп, футбол ойна!
Dialogue: 0,0:10:36.10,0:10:38.10,Default,,0000,0000,0000,,Иса Босс.
Dialogue: 0,0:10:38.10,0:10:40.07,Default,,0000,0000,0000,,Данышпан бол.
Dialogue: 0,0:10:43.11,0:10:45.08,Default,,0000,0000,0000,,О!
Dialogue: 0,0:10:45.08,0:10:47.08,Default,,0000,0000,0000,,Алаңдамаңыз!
Dialogue: 0,0:10:47.08,0:10:50.08,Default,,0000,0000,0000,,Тепе-теңдікті жоғалтсаңыз, ату мүмкін емес.
Dialogue: 0,0:10:50.08,0:10:52.08,Default,,0000,0000,0000,,Соңы!
Dialogue: 0,0:10:52.08,0:10:55.09,Default,,0000,0000,0000,,《Не? Не айтып тұрсың, мына жігіт?
Dialogue: 0,0:10:57.12,0:10:59.09,Default,,0000,0000,0000,,《Мен оны толық түсіндім》
Dialogue: 0,0:11:00.06,0:11:03.06,Default,,0000,0000,0000,,《Аа...? Скорпион тұзағы! ? 》
Dialogue: 0,0:11:05.06,0:11:07.07,Default,,0000,0000,0000,,《Рулет волейболы...! ? 》
Dialogue: 0,0:11:07.07,0:11:12.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:12.10,0:11:14.07,Default,,0000,0000,0000,,
Dialogue: 0,0:11:15.07,0:11:20.08,Default,,0000,0000,0000,,《Бұл мүмкін емес...
Dialogue: 0,0:11:15.07,0:11:20.08,Default,,0000,0000,0000,,Не! ? Бұл жаратылыс
Dialogue: 0,0:11:21.08,0:11:23.08,Default,,0000,0000,0000,,Наги!
Dialogue: 0,0:11:21.08,0:11:23.08,Default,,0000,0000,0000,,Наиш!
Dialogue: 0,0:11:23.08,0:11:25.08,Default,,0000,0000,0000,,Тейери
Dialogue: 0,0:11:23.08,0:11:25.08,Default,,0000,0000,0000,,Бұл кезектен тыс есеп.
Dialogue: 0,0:11:25.08,0:11:28.09,Default,,0000,0000,0000,,Мен Даданың жаттығу матчын көруге келдім →
Dialogue: 0,0:11:28.09,0:11:32.16,Default,,0000,0000,0000,,Жарысқа түсетін мектепке
Dialogue: 0,0:11:28.09,0:11:32.16,Default,,0000,0000,0000,,Біз екі стандартты емес адамды таптық!
Dialogue: 0,0:11:32.16,0:11:34.06,Default,,0000,0000,0000,,Эго
Dialogue: 0,0:11:32.16,0:11:34.06,Default,,0000,0000,0000,,Ешін-сан!
Dialogue: 0,0:11:34.06,0:11:38.06,Default,,0000,0000,0000,,Мен бұл екеуін Көк жартасқа шақырамын.
Dialogue: 0,0:11:40.07,0:11:44.07,Default,,0000,0000,0000,,Кеттік, Наги! Бірге әлемдегі бірінші нөмірге жетейік!
Dialogue: 0,0:11:45.07,0:11:48.07,Default,,0000,0000,0000,,《Аа, қандай қиын》
Dialogue: 0,0:11:52.08,0:11:55.08,Default,,0000,0000,0000,,Мұқият қараңдар!
Dialogue: 0,0:11:52.08,0:11:55.08,Default,,0000,0000,0000,,А, мен өлемін.
Dialogue: 0,0:11:55.08,0:12:03.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:03.09,0:12:06.09,Default,,0000,0000,0000,,Біз тамақ ішеміз бе?
Dialogue: 0,0:12:03.09,0:12:06.09,Default,,0000,0000,0000,,Е-е, ас қорыту азабы.
Dialogue: 0,0:12:10.06,0:12:13.07,Default,,0000,0000,0000,,(Ойын дыбысы)
Dialogue: 0,0:12:10.06,0:12:13.07,Default,,0000,0000,0000,,Сәлем! Мұны қалай істеу керектігін айтыңыз.
Dialogue: 0,0:12:13.07,0:12:17.07,Default,,0000,0000,0000,,А... жел жақсы сезіледі.
Dialogue: 0,0:12:23.08,0:12:28.08,Default,,0000,0000,0000,,Эй, мен шаршадым, Рей патша.
Dialogue: 0,0:12:23.08,0:12:28.08,Default,,0000,0000,0000,,Тезірек үйге қайтайық.
Dialogue: 0,0:12:28.08,0:12:33.09,Default,,0000,0000,0000,,Иә, иә, түсіндім.
Dialogue: 0,0:12:28.08,0:12:33.09,Default,,0000,0000,0000,,Соңғы 10 тапсырманы орындауға рұқсат етіңіз, Наги.
Dialogue: 0,0:12:33.09,0:12:36.06,Default,,0000,0000,0000,,Е, қарным ашты...
Dialogue: 0,0:12:37.09,0:12:40.06,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет, Бочама Рейо.
Dialogue: 0,0:12:40.06,0:12:43.06,Default,,0000,0000,0000,,Сау болыңыз. ше?
Dialogue: 0,0:12:45.06,0:12:49.07,Default,,0000,0000,0000,,Жапония футбол одағынан
Dialogue: 0,0:12:45.06,0:12:49.07,Default,,0000,0000,0000,,Сіздің хатыңыз келді.
Dialogue: 0,0:12:49.07,0:12:51.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:51.07,0:12:53.07,Default,,0000,0000,0000,,А, бұл маған да келді.
Dialogue: 0,0:12:56.08,0:12:59.08,Default,,0000,0000,0000,,Күшейтуге тағайындалған ойыншы ретінде таңдалды...! ?
Dialogue: 0,0:12:59.08,0:13:02.08,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:12:59.08,0:13:02.08,Default,,0000,0000,0000,,Кенеттен Жапония құрамасының оқу-жаттығу жиыны болды ма?
Dialogue: 0,0:13:02.08,0:13:05.08,Default,,0000,0000,0000,,Маған оқу-жаттығу жиындары ұнамайды.
Dialogue: 0,0:13:05.08,0:13:08.09,Default,,0000,0000,0000,,Мен ойын ойнағым келеді немесе ұйықтағым келеді.
Dialogue: 0,0:13:08.09,0:13:11.09,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Бұл үлкен мүмкіндік!
Dialogue: 0,0:13:11.09,0:13:14.06,Default,,0000,0000,0000,,Осы жерде шағымдансаңыз
Dialogue: 0,0:13:11.09,0:13:14.06,Default,,0000,0000,0000,,Өкілге тез жетіңіз!
Dialogue: 0,0:13:14.06,0:13:16.10,Default,,0000,0000,0000,,Жаттығу жасайық, Наги!
Dialogue: 0,0:13:16.10,0:13:20.10,Default,,0000,0000,0000,,Жарайды... менің аяғым сынды.
Dialogue: 0,0:13:20.10,0:13:23.07,Default,,0000,0000,0000,,Жасуша өлі. Жүрегім тоқтады.
Dialogue: 0,0:13:23.07,0:13:26.07,Default,,0000,0000,0000,,Сіз зомбисіз бе?
Dialogue: 0,0:13:23.07,0:13:26.07,Default,,0000,0000,0000,,Өлілердің Нагиі.
Dialogue: 0,0:13:26.07,0:13:29.07,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:13:35.08,0:13:38.08,Default,,0000,0000,0000,,А, оңай. Рео лимузині.
Dialogue: 0,0:13:38.08,0:13:41.09,Default,,0000,0000,0000,,Иә. Мен де бүгін қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:13:42.09,0:13:44.12,Default,,0000,0000,0000,,Рейу біртүрлі, солай емес пе?
Dialogue: 0,0:13:44.12,0:13:48.09,Default,,0000,0000,0000,,Не? сол. Сіз маған айттыңыз ба деп ойлаймын.
Dialogue: 0,0:13:48.09,0:13:52.10,Default,,0000,0000,0000,,Өйткені сен менімен біргесің.
Dialogue: 0,0:13:48.09,0:13:52.10,Default,,0000,0000,0000,,Өйткені бұл қиындық тудырмайды.
Dialogue: 0,0:13:52.10,0:13:55.10,Default,,0000,0000,0000,,Хаха... Толықтай қабылданады.
Dialogue: 0,0:13:55.10,0:13:59.10,Default,,0000,0000,0000,,Жарайды, сенімен бірге болу қызық.
Dialogue: 0,0:13:59.10,0:14:03.11,Default,,0000,0000,0000,,Сіз ше? Сіз көңіл көтере бастадыңыз ба?
Dialogue: 0,0:14:03.11,0:14:05.08,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:14:05.08,0:14:09.08,Default,,0000,0000,0000,,Менің футбол ойнағым келмейді, бірақ→
Dialogue: 0,0:14:09.08,0:14:12.08,Default,,0000,0000,0000,,Рей патшамен бірге болу
Dialogue: 0,0:14:09.08,0:14:12.08,Default,,0000,0000,0000,,Ештеңе етпейді, өйткені бұл қиындық тудырмайды.
Dialogue: 0,0:14:12.08,0:14:15.09,Default,,0000,0000,0000,,Бұл қызық деп айт!
Dialogue: 0,0:14:19.12,0:14:22.09,Default,,0000,0000,0000,,Sae
Dialogue: 0,0:14:19.12,0:14:22.09,Default,,0000,0000,0000,,Қарсылас – Сае Итоси бастаған 20 жасқа дейінгі Жапония құрамасы.
Dialogue: 0,0:14:23.10,0:14:26.10,Default,,0000,0000,0000,,Жеңілсең, Көк жартас жоғалады.
Dialogue: 0,0:14:26.10,0:14:30.10,Default,,0000,0000,0000,,Олардың арасына кіріңіз
Dialogue: 0,0:14:26.10,0:14:30.10,Default,,0000,0000,0000,,Ең бастысы - өз өміріңізді қалай насихаттауға болады!
Dialogue: 0,0:14:32.10,0:14:34.11,Default,,0000,0000,0000,,Қарға
Dialogue: 0,0:14:32.10,0:14:34.11,Default,,0000,0000,0000,,Табито
Dialogue: 0,0:14:32.10,0:14:34.11,Default,,0000,0000,0000,,Сіз А тобының саңылауысыз.
Dialogue: 0,0:14:34.11,0:14:37.11,Default,,0000,0000,0000,,Бұлай жалғаса берсе, біз ештеңе істей алмай қаламыз!
Dialogue: 0,0:14:37.11,0:14:39.11,Default,,0000,0000,0000,,<Осыдан кейін түн ортасынан бастап →
Dialogue: 0,0:14:39.11,0:14:44.08,Default,,0000,0000,0000,,Телехикаяның екінші маусымы
Dialogue: 0,0:14:39.11,0:14:44.08,Default,,0000,0000,0000,,«Blue Rock VS. U-20 JAPAN» басталуы>
Dialogue: 0,0:14:44.08,0:14:48.09,Default,,0000,0000,0000,,Мен әлемдегі ең үздік шабуылшы боламын! !
Dialogue: 0,0:14:57.10,0:14:59.10,Default,,0000,0000,0000,,Көрінбейтін белгілері жоқ, біртіндеп өршіп бара жатқан ауру сияқты—
Dialogue: 0,0:14:57.10,0:14:59.10,Default,,0000,0000,0000,,Жұмыс іздеу?
Dialogue: 0,0:14:59.10,0:15:01.10,Default,,0000,0000,0000,,Үлкен ағам сені қорғап қалар еді,
Dialogue: 0,0:14:59.10,0:15:01.10,Default,,0000,0000,0000,,Бұл қандай адам?
Dialogue: 0,0:15:01.10,0:15:05.10,Default,,0000,0000,0000,,Екеумізге бәрін тепкілеу қызық!
Dialogue: 0,0:15:05.10,0:15:08.11,Default,,0000,0000,0000,,Бірақ менен артық біреу болса ше?
Dialogue: 0,0:15:05.10,0:15:08.11,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:15:08.11,0:15:11.08,Default,,0000,0000,0000,,Онымен біріккен дұрыс емес пе?
Dialogue: 0,0:15:11.08,0:15:14.08,Default,,0000,0000,0000,,Ха! Бұлай істеме, бұл сондай ақымақтық.
Dialogue: 0,0:15:14.08,0:15:17.08,Default,,0000,0000,0000,,Ал... мен мұны істей алар едім.
Dialogue: 0,0:15:19.15,0:15:21.15,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:15:23.09,0:15:25.09,Default,,0000,0000,0000,,Өте көп!
Dialogue: 0,0:15:33.07,0:15:36.07,Default,,0000,0000,0000,,Олардың барлығы жоғары мектеп деңгейіндегі атақты жігіттер!
Dialogue: 0,0:15:36.07,0:15:41.07,Default,,0000,0000,0000,,Жоқ... Неден басталады? бұл.
Dialogue: 0,0:15:36.07,0:15:41.07,Default,,0000,0000,0000,,Айқай...
Dialogue: 0,0:15:53.09,0:15:55.12,Default,,0000,0000,0000,,О!
Dialogue: 0,0:15:55.12,0:16:01.09,Default,,0000,0000,0000,,Он сегізге толмаған
Dialogue: 0,0:15:55.12,0:16:01.09,Default,,0000,0000,0000,,(Есік ашылу дыбысы)
Dialogue: 0,0:15:55.12,0:16:01.09,Default,,0000,0000,0000,,Оны U-18 құрамасына қосады деген қауесет бар.
Dialogue: 0,0:15:55.12,0:16:01.09,Default,,0000,0000,0000,,Кира
Dialogue: 0,0:15:55.12,0:16:01.09,Default,,0000,0000,0000,,Жапон футбол әлемінің қазынасы, Риосуке Кира да!
Dialogue: 0,0:16:01.09,0:16:04.06,Default,,0000,0000,0000,,Хмм. Әлгі кәдімгі кішкентай жігіт.
Dialogue: 0,0:16:09.07,0:16:13.11,Default,,0000,0000,0000,,Жоқ, қара шаш емес.
Dialogue: 0,0:16:09.07,0:16:13.11,Default,,0000,0000,0000,,Үлкен әдемі жігіт.
Dialogue: 0,0:16:13.11,0:16:15.11,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:16:15.11,0:16:18.08,Default,,0000,0000,0000,,Е-а-а-а.
Dialogue: 0,0:16:18.08,0:16:22.11,Default,,0000,0000,0000,,Құтты болсын, таланттың асыл тастары.
Dialogue: 0,0:16:22.11,0:16:28.09,Default,,0000,0000,0000,,Сіз менің жеке пікірім мен теріс пікірім бойынша таңдалды.
Dialogue: 0,0:16:22.11,0:16:28.09,Default,,0000,0000,0000,,18 жасқа толмаған 300 ереуілші.
Dialogue: 0,0:16:28.09,0:16:30.09,Default,,0000,0000,0000,,Ал мен Ешин Цзинпачимін.
Dialogue: 0,0:16:30.09,0:16:35.06,Default,,0000,0000,0000,,Жапонияға әлем чемпионатында жеңіске жетуге көмектесу
Dialogue: 0,0:16:30.09,0:16:35.06,Default,,0000,0000,0000,,Ол жалдамалы адам.
Dialogue: 0,0:16:36.06,0:16:38.06,Default,,0000,0000,0000,,
Dialogue: 0,0:16:38.06,0:16:40.10,Default,,0000,0000,0000,,Не? Сол жігіт.
Dialogue: 0,0:16:40.10,0:16:42.07,Default,,0000,0000,0000,,Қарапайым болайық.
Dialogue: 0,0:16:42.07,0:16:47.07,Default,,0000,0000,0000,,Жапон футболы әлемнің үздік футболшысы болу үшін не қажет
Dialogue: 0,0:16:42.07,0:16:47.07,Default,,0000,0000,0000,,Бір ғана нәрсе.
Dialogue: 0,0:16:47.07,0:16:50.08,Default,,0000,0000,0000,,Революциялық ереуілші дүниеге келді.
Dialogue: 0,0:16:50.08,0:16:56.08,Default,,0000,0000,0000,,Мен осы 300 адамның ішіндемін.
Dialogue: 0,0:16:50.08,0:16:56.08,Default,,0000,0000,0000,,Әлемдегі ең үздік шабуылшыны жасау үшін эксперимент жүргізіңіз.
Dialogue: 0,0:16:56.08,0:17:01.09,Default,,0000,0000,0000,,Бұл Көк жартасқа арналған қондырғы.
Dialogue: 0,0:17:01.09,0:17:04.09,Default,,0000,0000,0000,,Бүгіннен бастап осында бірге тұрасың→
Dialogue: 0,0:17:04.09,0:17:08.09,Default,,0000,0000,0000,,Менің арнайы жоғарғы оқуым
Dialogue: 0,0:17:04.09,0:17:08.09,Default,,0000,0000,0000,,Орындаңыз.
Dialogue: 0,0:17:08.09,0:17:13.07,Default,,0000,0000,0000,,Мен үйге бара алмаймын
Dialogue: 0,0:17:08.09,0:17:13.07,Default,,0000,0000,0000,,Сізден бұрынғы футбол өміріңізден бас тарту сұралады.
Dialogue: 0,0:17:13.07,0:17:15.07,Default,,0000,0000,0000,,Бірақ мен растаймын.
Dialogue: 0,0:17:15.07,0:17:21.07,Default,,0000,0000,0000,,Мұнда аман қалу
Dialogue: 0,0:17:15.07,0:17:21.07,Default,,0000,0000,0000,,299 адамды жойғаннан кейін соңғы адам → қалды
Dialogue: 0,0:17:21.07,0:17:24.08,Default,,0000,0000,0000,,Әлемдегі ең үздік шабуылшы бол.
Dialogue: 0,0:17:24.08,0:17:27.08,Default,,0000,0000,0000,,Мұның бәрі түсіндіру үшін. сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:17:27.08,0:17:31.12,Default,,0000,0000,0000,,
Dialogue: 0,0:17:31.12,0:17:34.12,Default,,0000,0000,0000,,Ха! О, менің...
Dialogue: 0,0:17:34.12,0:17:38.09,Default,,0000,0000,0000,,Әлем кубогы... Сен әлемдегі ең жақсысың, Наги!
Dialogue: 0,0:17:38.09,0:17:41.09,Default,,0000,0000,0000,,Біз Отоишиден ақпарат алу үстіндеміз.
Dialogue: 0,0:17:38.09,0:17:41.09,Default,,0000,0000,0000,,Мен үйге бара жатырмын.
Dialogue: 0,0:17:41.09,0:17:46.10,Default,,0000,0000,0000,,Ауырған сияқты.
Dialogue: 0,0:17:41.09,0:17:46.10,Default,,0000,0000,0000,,Мен үшін бұл мүмкін емес, себебі менде мотивация жоқ.
Dialogue: 0,0:17:46.10,0:17:50.10,Default,,0000,0000,0000,,Тоқта, күт... күт!
Dialogue: 0,0:17:46.10,0:17:50.10,Default,,0000,0000,0000,,Біз мұны істей аламыз!
Dialogue: 0,0:17:50.10,0:17:52.10,Default,,0000,0000,0000,,Әзірге тек қатысыңыз...
Dialogue: 0,0:17:52.10,0:17:55.11,Default,,0000,0000,0000,,«Біз»? Сен не туралы айтып тұрсың? Король Линг.
Dialogue: 0,0:17:55.11,0:17:58.08,Default,,0000,0000,0000,,Титанның алдында сарбаздар бірінен соң бірі құлады.
Dialogue: 0,0:17:55.11,0:17:58.08,Default,,0000,0000,0000,,«Соңғысына дейін күресемін» дедім.
Dialogue: 0,0:17:58.08,0:18:00.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:00.08,0:18:06.09,Default,,0000,0000,0000,,Егер сіз әлемдегі ең үлкен эгоист болмасаңыз
Dialogue: 0,0:18:00.08,0:18:06.09,Default,,0000,0000,0000,,Сіз әлемдегі ең үздік шабуылшы бола алмайсыз.
Dialogue: 0,0:18:06.09,0:18:09.09,Default,,0000,0000,0000,,Елестет. Кезең – әлем чемпионатының финалы.
Dialogue: 0,0:18:09.09,0:18:13.09,Default,,0000,0000,0000,,80 000 адамнан тұратын үлкен аудитория.
Dialogue: 0,0:18:09.09,0:18:13.09,Default,,0000,0000,0000,,Сіз сол алаңдасыз.
Dialogue: 0,0:18:13.09,0:18:17.10,Default,,0000,0000,0000,,Ұпай 0-0.
Dialogue: 0,0:18:13.09,0:18:17.10,Default,,0000,0000,0000,,Екінші таймның қосымша уақыты.
Dialogue: 0,0:18:17.10,0:18:21.07,Default,,0000,0000,0000,,Соңғы ойын
Dialogue: 0,0:18:17.10,0:18:21.07,Default,,0000,0000,0000,,Сіз одақтастың пасына тайып кеттіңіз...
Dialogue: 0,0:18:25.10,0:18:28.11,Default,,0000,0000,0000,,Қақпашымен жеке-жеке.
Dialogue: 0,0:18:28.11,0:18:30.11,Default,,0000,0000,0000,,Оң жақта 6 метр жерде бір одақтас бар.
Dialogue: 0,0:18:30.11,0:18:34.08,Default,,0000,0000,0000,,Маған рұқсат берсеңіз
Dialogue: 0,0:18:30.11,0:18:34.08,Default,,0000,0000,0000,,Міндетті түрде бір ұпай жинауға болатын жағдай.
Dialogue: 0,0:18:34.08,0:18:38.08,Default,,0000,0000,0000,,Бүкіл халықтың үміті: Жеңіс басына күн туды
Dialogue: 0,0:18:34.08,0:18:38.08,Default,,0000,0000,0000,,Мұндай жағдайда...→
Dialogue: 0,0:18:38.08,0:18:41.09,Default,,0000,0000,0000,,Еш ойланбастан атыңыз.
Dialogue: 0,0:18:41.09,0:18:45.09,Default,,0000,0000,0000,,Тек осындай ессіз эгоистер→
Dialogue: 0,0:18:45.09,0:18:48.09,Default,,0000,0000,0000,,Осы жерден жалғастырыңыз.
Dialogue: 0,0:18:49.06,0:18:55.07,Default,,0000,0000,0000,,Парасаттылықтан бас тарту.
Dialogue: 0,0:18:49.06,0:18:55.07,Default,,0000,0000,0000,,Алаңда сен жұлдызсың.
Dialogue: 0,0:18:55.07,0:19:01.07,Default,,0000,0000,0000,,Мақсатыңызды ең үлкен қуанышқа айналдырыңыз.
Dialogue: 0,0:18:55.07,0:19:01.07,Default,,0000,0000,0000,,Тек осы сәтпен өмір сүр!
Dialogue: 0,0:19:01.07,0:19:04.08,Default,,0000,0000,0000,,Бұл шабуылшы, солай ма?
Dialogue: 0,0:19:07.15,0:19:09.15,Default,,0000,0000,0000,,⚟ (аяқ дыбысы)
Dialogue: 0,0:19:11.08,0:19:13.05,Default,,0000,0000,0000,,《Сол кішкентай жігіт...》
Dialogue: 0,0:19:16.09,0:19:18.09,Default,,0000,0000,0000,,Киёши-кун….
Dialogue: 0,0:19:18.09,0:19:21.09,Default,,0000,0000,0000,,Мен барамын, қарғыс атсын!
Dialogue: 0,0:19:18.09,0:19:21.09,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:21.09,0:19:32.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:32.07,0:19:34.07,Default,,0000,0000,0000,,Хэхехе...
Dialogue: 0,0:19:35.07,0:19:40.08,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:19:35.07,0:19:40.08,Default,,0000,0000,0000,,Екеуің ғана қалдыңдар.
Dialogue: 0,0:19:40.08,0:19:42.15,Default,,0000,0000,0000,,Кеттік! Кеттік, Наги.
Dialogue: 0,0:19:42.15,0:19:46.08,Default,,0000,0000,0000,,Жоқ, мен бармаймын. Бұл бір қиындық сияқты.
Dialogue: 0,0:19:46.08,0:19:48.09,Default,,0000,0000,0000,,Сәлем! Мен осы уақытқа дейін келдім ...
Dialogue: 0,0:19:48.09,0:19:52.09,Default,,0000,0000,0000,,Мүмкін көк жартас маған жараспайтын шығар→
Dialogue: 0,0:19:52.09,0:19:55.06,Default,,0000,0000,0000,,Сенің жалығып, бірден үйге қайтқың келетініне сенімдімін.
Dialogue: 0,0:19:55.06,0:19:59.06,Default,,0000,0000,0000,,О... Менің әңгімем қызықсыз болды ма?
Dialogue: 0,0:19:59.06,0:20:02.07,Default,,0000,0000,0000,,Иә. Өйткені...
Dialogue: 0,0:20:04.10,0:20:10.08,Default,,0000,0000,0000,,Әлем чемпионатының жеңіс мақсаты қандай?
Dialogue: 0,0:20:04.10,0:20:10.08,Default,,0000,0000,0000,,Маған елестету оңай болды.
Dialogue: 0,0:20:10.08,0:20:12.08,Default,,0000,0000,0000,,《Аа...》
Dialogue: 0,0:20:12.08,0:20:17.08,Default,,0000,0000,0000,,Сіз өзіңіздің эгоыңызды әлі түсінбейсіз.
Dialogue: 0,0:20:17.08,0:20:22.09,Default,,0000,0000,0000,,Өзің сияқты данышпанмын
Dialogue: 0,0:20:17.08,0:20:22.09,Default,,0000,0000,0000,,Дүниеде көп.
Dialogue: 0,0:20:22.09,0:20:26.09,Default,,0000,0000,0000,,Ұрыссыз өс
Dialogue: 0,0:20:22.09,0:20:26.09,Default,,0000,0000,0000,,Мен жәй ғана зардап шекпей өмір сүргім келеді →
Dialogue: 0,0:20:26.09,0:20:29.06,Default,,0000,0000,0000,,Мен өзін-өзі санайтын адамдарға қызықпаймын.
Dialogue: 0,0:20:29.06,0:20:33.07,Default,,0000,0000,0000,,Шіріп кетсін. Жарқыңызшы.
Dialogue: 0,0:20:36.07,0:20:39.07,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:20:36.07,0:20:39.07,Default,,0000,0000,0000,,Ақымақ болма! !
Dialogue: 0,0:20:39.07,0:20:42.11,Default,,0000,0000,0000,,Наги солай
Dialogue: 0,0:20:39.07,0:20:42.11,Default,,0000,0000,0000,,Мына жақтан көріп жүрген данышпандарға ұқсамайды!
Dialogue: 0,0:20:42.11,0:20:44.08,Default,,0000,0000,0000,,Король Рей...?
Dialogue: 0,0:20:44.08,0:20:47.08,Default,,0000,0000,0000,,Егер екеуміз ғана болсақ... біз мұны істей аламыз!
Dialogue: 0,0:20:47.08,0:20:51.08,Default,,0000,0000,0000,,Не? Бұл дұрыс.
Dialogue: 0,0:20:47.08,0:20:51.08,Default,,0000,0000,0000,,Дүниеде ең жақсы екі адам жоқ.
Dialogue: 0,0:20:52.08,0:20:57.09,Default,,0000,0000,0000,,Олай болса мына жігітті әлемдегі ең үздік шабуылшы етейік.
Dialogue: 0,0:20:52.08,0:20:57.09,Default,,0000,0000,0000,,Бұл менің эгоім!
Dialogue: 0,0:20:57.09,0:20:59.09,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:21:00.09,0:21:03.10,Default,,0000,0000,0000,,Күте тұрыңыз, Рей патша. Мен мұны істегім келмейді...
Dialogue: 0,0:21:03.10,0:21:07.10,Default,,0000,0000,0000,,Шулы, үндеме. Маған сеніңіз, Наги.
Dialogue: 0,0:21:07.10,0:21:13.11,Default,,0000,0000,0000,,Ұйқы мен ойыннан да өмір қызық
Dialogue: 0,0:21:07.10,0:21:13.11,Default,,0000,0000,0000,,Мен сені алып кетемін!
Dialogue: 0,0:21:13.11,0:21:16.07,Default,,0000,0000,0000,,Мен сені жалықтырмаймын!
Dialogue: 0,0:21:19.08,0:21:22.08,Default,,0000,0000,0000,,Маған бір ғана уәде бер.
Dialogue: 0,0:21:22.08,0:21:29.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:29.09,0:21:32.09,Default,,0000,0000,0000,,Менімен соңына дейін бол.
Dialogue: 0,0:21:32.09,0:21:35.09,Default,,0000,0000,0000,,Ха... Бұл не?
Dialogue: 0,0:21:32.09,0:21:35.09,Default,,0000,0000,0000,,Сіздің эго?
Dialogue: 0,0:21:36.09,0:21:38.10,Default,,0000,0000,0000,,Бұл уәде, Рей патша.
Dialogue: 0,0:21:38.10,0:21:41.07,Default,,0000,0000,0000,,Ах, Наги, мен уәде беремін.
Dialogue: 0,0:21:45.07,0:21:49.07,Default,,0000,0000,0000,,А... бастайық.
Dialogue: 0,0:21:49.07,0:21:53.08,Default,,0000,0000,0000,,Футбол үшін әлемдегі ең ыстық жер.
Dialogue: 0,0:21:53.08,0:21:58.05,Default,,0000,0000,0000,,Бұл... Көк жартас.
Dialogue: 0,0:22:01.09,0:22:04.09,Default,,0000,0000,0000,,Смартфонымды алып кетті...
Dialogue: 0,0:22:04.09,0:22:07.09,Default,,0000,0000,0000,,Әзірше ойыннан бас тарт, Наги.
Dialogue: 0,0:22:11.06,0:22:16.07,Default,,0000,0000,0000,,Ой...
Dialogue: 0,0:22:11.06,0:22:16.07,Default,,0000,0000,0000,,Сіз данышпан дуэт емессіз бе?
Dialogue: 0,0:22:16.07,0:22:20.07,Default,,0000,0000,0000,,Мен бұл уақыттан ұтылдым, бірақ бұл сақамды түсіргендіктен болды.
Dialogue: 0,0:22:20.07,0:22:24.08,Default,,0000,0000,0000,,Шынайы қорытынды осында шешіледі.
Dialogue: 0,0:22:24.08,0:22:27.08,Default,,0000,0000,0000,,Who?
Dialogue: 0,0:22:24.08,0:22:27.08,Default,,0000,0000,0000,,Жоқ, есімде жоқ.
Dialogue: 0,0:22:27.08,0:22:32.08,Default,,0000,0000,0000,,Балалар, дебюттік матчта керемет жеңіске жеттіңіздер.
Dialogue: 0,0:22:27.08,0:22:32.08,Default,,0000,0000,0000,,Ол нағыз күшті мектептің эйсе!
Dialogue: 0,0:22:32.08,0:22:34.09,Default,,0000,0000,0000,,Неге ұмыттың!
Dialogue: 0,0:22:35.09,0:22:40.09,Default,,0000,0000,0000,,Мен Бонбонның арманын бұзамын!
Dialogue: 0,0:22:40.09,0:22:43.06,Default,,0000,0000,0000,,А, менің ойымша, бірдеңе болды...
Dialogue: 0,0:22:43.06,0:22:46.10,Default,,0000,0000,0000,,Сәлем Наги! Бұл жерде біртүрлі нәрсе бар.
Dialogue: 0,0:22:46.10,0:22:49.07,Default,,0000,0000,0000,,Қанжар аяқтары
Dialogue: 0,0:22:46.10,0:22:49.07,Default,,0000,0000,0000,,Уау! Жоғарғы және төменгі аяқтары бар құбыжық!
Dialogue: 0,0:22:49.07,0:22:51.07,Default,,0000,0000,0000,,Цуруги
Dialogue: 0,0:22:49.07,0:22:51.07,Default,,0000,0000,0000,,Уф... Уф...!
Dialogue: 0,0:22:51.07,0:22:55.11,Default,,0000,0000,0000,,Маған біреу көмектессін! Тұншығып жатыр!
Dialogue: 0,0:22:55.11,0:22:58.08,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:22:55.11,0:22:58.08,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:22:58.08,0:23:00.08,Default,,0000,0000,0000,,(қатты тыныс алу)
Dialogue: 0,0:23:00.08,0:23:03.08,Default,,0000,0000,0000,,Жоқ, бұл түбіт, солай емес пе?
Dialogue: 0,0:23:03.08,0:23:06.08,Default,,0000,0000,0000,,Аа... Аа, бұл рас.
Dialogue: 0,0:23:07.09,0:23:09.09,Default,,0000,0000,0000,,Мен мұны білдім.
Dialogue: 0,0:23:09.09,0:23:13.06,Default,,0000,0000,0000,,Бұл жақсы щетка болды.
Dialogue: 0,0:23:09.09,0:23:13.06,Default,,0000,0000,0000,,Бұл алдын ала шығарылым.
Dialogue: 0,0:23:17.10,0:23:21.10,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:23:17.10,0:23:21.10,Default,,0000,0000,0000,,Поо...! Бұл сөзсіз өтірік.
Dialogue: 0,0:23:17.10,0:23:21.10,Default,,0000,0000,0000,,Ағылшын тілі Бұл беспорядок.
Dialogue: 0,0:23:22.07,0:23:27.14,Default,,0000,0000,0000,,«Эй, эй, сен өзгеріп біттің бе?
Dialogue: 0,0:23:22.07,0:23:27.14,Default,,0000,0000,0000,,Дарынның асыл тастарысыңдар».
Dialogue: 0,0:23:27.14,0:23:32.08,Default,,0000,0000,0000,,«Қазір бір бөлмеде отырған мүшелер
Dialogue: 0,0:23:27.14,0:23:32.08,Default,,0000,0000,0000,,Біз бір-бірімізді жетілдіретін бөлмелес және қарсыласпыз».
Dialogue: 0,0:23:32.08,0:23:34.08,Default,,0000,0000,0000,,«Сіздің қабілеттеріңіз→
Dialogue: 0,0:23:34.08,0:23:38.08,Default,,0000,0000,0000,,Ол менің жеке пікіріме және теріс пікірге негізделген.
Dialogue: 0,0:23:34.08,0:23:38.08,Default,,0000,0000,0000,,Реттеу.
Dialogue: 0,0:23:38.08,0:23:41.09,Default,,0000,0000,0000,,«Бұл формадағы нөмір».
Dialogue: 0,0:23:41.09,0:23:43.05,Default,,0000,0000,0000,,Иә. Өте төмен...
Dialogue: 0,0:23:44.09,0:23:46.09,Default,,0000,0000,0000,,《Осы бөлмеде кімнің рейтингі жоғары...》
Dialogue: 0,0:23:46.09,0:23:49.06,Default,,0000,0000,0000,,“241”….
Dialogue: 0,0:23:46.09,0:23:49.06,Default,,0000,0000,0000,,《Сол жігіт》
Dialogue: 0,0:23:49.06,0:23:51.06,Default,,0000,0000,0000,,«Рейтинг – →
Dialogue: 0,0:23:51.06,0:23:54.10,Default,,0000,0000,0000,,Жаттығулар мен ойындардың нәтижелері
Dialogue: 0,0:23:51.06,0:23:54.10,Default,,0000,0000,0000,,«Жоғары және төмен».
Dialogue: 0,0:23:54.10,0:23:57.10,Default,,0000,0000,0000,,«Ал үздік 5 адам сөзсіз → болады
Dialogue: 0,0:23:57.10,0:24:04.11,Default,,0000,0000,0000,,Жиырмаға дейін
Dialogue: 0,0:23:57.10,0:24:04.11,Default,,0000,0000,0000,,6 айдан кейін өтетін турнир: U-20 әлем чемпионаты
Dialogue: 0,0:23:57.10,0:24:04.11,Default,,0000,0000,0000,,Ол тіркелген шабуылшы ойыншысы болуы керек.
Dialogue: 0,0:24:06.08,0:24:08.08,Default,,0000,0000,0000,,Ха... Шынайы ма?
Dialogue: 0,0:24:08.08,0:24:13.12,Default,,0000,0000,0000,,«Айтпақшы
Dialogue: 0,0:24:08.08,0:24:13.12,Default,,0000,0000,0000,,Көк жартаста кім жеңілсе, бұдан былай →
Dialogue: 0,0:24:13.12,0:24:17.09,Default,,0000,0000,0000,,Сіз өмір бойы Жапония құрамасына қосылу құқығынан айырыласыз».
Dialogue: 0,0:24:18.09,0:24:22.09,Default,,0000,0000,0000,,«Мұнда жеңу үшін сізге қажет нәрсе - бұл эго».
Dialogue: 0,0:24:22.09,0:24:24.10,Default,,0000,0000,0000,,«Енді біз оны өлшеу үшін сынақ жүргіземіз.»
Dialogue: 0,0:24:25.10,0:24:28.10,Default,,0000,0000,0000,,Енді киска ойнайтын кез келді.
Dialogue: 0,0:24:28.10,0:24:30.10,Default,,0000,0000,0000,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:24:31.10,0:24:33.10,Default,,0000,0000,0000,,«Уақыт – 136 секунд»
Dialogue: 0,0:24:33.10,0:24:36.11,Default,,0000,0000,0000,,«Доп соққан адам адам болады →
Dialogue: 0,0:24:36.11,0:24:40.08,Default,,0000,0000,0000,,Уақыт біткен кезде адам болған адам
Dialogue: 0,0:24:36.11,0:24:40.08,Default,,0000,0000,0000,,Мен рок-офф жігітпін».
Dialogue: 0,0:24:40.08,0:24:42.08,Default,,0000,0000,0000,,«Сонымен қатар, қолдар рұқсат етілмейді».
Dialogue: 0,0:24:48.12,0:24:50.09,Default,,0000,0000,0000,,Мен жігітпін...
Dialogue: 0,0:24:53.06,0:24:55.09,Default,,0000,0000,0000,,Ха ха. Бұл ең жақсы.
Dialogue: 0,0:24:55.09,0:25:00.07,Default,,0000,0000,0000,,Соңғы беске дейін аман қалсаңыз
Dialogue: 0,0:24:55.09,0:25:00.07,Default,,0000,0000,0000,,U-20 Жапония өкілі.
Dialogue: 0,0:25:00.07,0:25:03.10,Default,,0000,0000,0000,,Мұндай мүмкіндік ешқашан келмейді.
Dialogue: 0,0:25:03.10,0:25:05.07,Default,,0000,0000,0000,,О, бас кейіпкердің конституциясы.
Dialogue: 0,0:25:06.10,0:25:08.11,Default,,0000,0000,0000,,Сен ақымақ...
Dialogue: 0,0:25:08.11,0:25:12.08,Default,,0000,0000,0000,,Жігіттер, осы жерде маған жеңіліп, үйге қайтыңдар!
Dialogue: 0,0:25:12.08,0:25:17.08,Default,,0000,0000,0000,,Әй! Біреуіміз құлап қалсын
Dialogue: 0,0:25:12.08,0:25:17.08,Default,,0000,0000,0000,,Айырып тастаймын, данышпан қос!
Dialogue: 0,0:25:17.08,0:25:20.09,Default,,0000,0000,0000,,Байқап көріңіз. Сүйіктім!
Dialogue: 0,0:25:20.09,0:25:23.09,Default,,0000,0000,0000,,Эй, Рейу, сен әдейі жеңілмейсің бе?
Dialogue: 0,0:25:23.09,0:25:26.09,Default,,0000,0000,0000,,Осындай біреумен бе?
Dialogue: 0,0:25:23.09,0:25:26.09,Default,,0000,0000,0000,,Бұл қиынырақ болар еді.
Dialogue: 0,0:25:26.09,0:25:28.06,Default,,0000,0000,0000,,Иә өлтіру.
Dialogue: 0,0:25:29.06,0:25:33.06,Default,,0000,0000,0000,,Тенжо Тенка... Юи жалғыз!
Dialogue: 0,0:25:34.07,0:25:36.07,Default,,0000,0000,0000,,Ха! ? Бұл жалғыз.
Dialogue: 0,0:25:37.07,0:25:39.07,Default,,0000,0000,0000,,《Жарылғыш үдеу...! 》
Dialogue: 0,0:25:40.11,0:25:44.08,Default,,0000,0000,0000,,Өкінішке орай, мен жеңдім.
Dialogue: 0,0:25:40.11,0:25:44.08,Default,,0000,0000,0000,,Көрермендер.
Dialogue: 0,0:25:48.08,0:25:50.08,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:25:50.08,0:25:53.08,Default,,0000,0000,0000,,Кім адам болып шықты, сол жеңіледі.
Dialogue: 0,0:25:50.08,0:25:53.08,Default,,0000,0000,0000,,Мен солай ойлаймын!
Dialogue: 0,0:25:53.08,0:25:56.09,Default,,0000,0000,0000,,Иә! ? О... бұл?
Dialogue: 0,0:25:56.09,0:25:59.09,Default,,0000,0000,0000,,Иә, иә. Мен білдім. Мен білдім.
Dialogue: 0,0:25:59.09,0:26:02.06,Default,,0000,0000,0000,,Хахахаха...!
Dialogue: 0,0:25:59.09,0:26:02.06,Default,,0000,0000,0000,,Ережені түсінбейді!
Dialogue: 0,0:26:02.06,0:26:06.06,Default,,0000,0000,0000,,Тым ақымақ! Табиғи мемориалды ақымақ!
Dialogue: 0,0:26:02.06,0:26:06.06,Default,,0000,0000,0000,,Хахаха...!
Dialogue: 0,0:26:06.06,0:26:09.07,Default,,0000,0000,0000,,Білемін деген сылтаумен
Dialogue: 0,0:26:06.06,0:26:09.07,Default,,0000,0000,0000,,Күрделі сөздерді қолдануды ұнатады...
Dialogue: 0,0:26:09.07,0:26:11.10,Default,,0000,0000,0000,,Иә. Ақымақ көрінеді.
Dialogue: 0,0:26:11.10,0:26:15.11,Default,,0000,0000,0000,,Ақымақ ақымақ деу жақсы... ақымақ!
Dialogue: 0,0:26:15.11,0:26:17.11,Default,,0000,0000,0000,,Жоқ... Мен ашуландым.
Dialogue: 0,0:26:17.11,0:26:20.08,Default,,0000,0000,0000,,Коби
Dialogue: 0,0:26:17.11,0:26:20.08,Default,,0000,0000,0000,,Жеміс піскен сайын, басымды иемін...→
Dialogue: 0,0:26:20.08,0:26:22.08,Default,,0000,0000,0000,,Бұл шегіртке ме?
Dialogue: 0,0:26:24.08,0:26:27.09,Default,,0000,0000,0000,,Бұл Инахо...!
Dialogue: 0,0:26:24.08,0:26:27.09,Default,,0000,0000,0000,,Бұл мақсат.
Dialogue: 0,0:26:31.09,0:26:35.09,Default,,0000,0000,0000,,Гяхаха! Наиш!
Dialogue: 0,0:26:31.09,0:26:35.09,Default,,0000,0000,0000,,Ақылсыз соққы!
Dialogue: 0,0:26:35.09,0:26:37.06,Default,,0000,0000,0000,,Сәлем! Мені ақымақ деме!
Dialogue: 0,0:26:37.06,0:26:40.07,Default,,0000,0000,0000,,Мен Кенджу Зантецу жасаймын...
Dialogue: 0,0:26:42.07,0:26:44.07,Default,,0000,0000,0000,,Мен жігітпін бе...?
Dialogue: 0,0:26:45.10,0:26:48.11,Default,,0000,0000,0000,,Ах... қандай қиыншылық.
Dialogue: 0,0:26:48.11,0:26:50.08,Default,,0000,0000,0000,,Наги...?
Dialogue: 0,0:26:50.08,0:26:52.08,Default,,0000,0000,0000,,Ха... Ақыры байсалды боласың ба?
Dialogue: 0,0:26:52.08,0:26:54.08,Default,,0000,0000,0000,,Мені енді ақымақ деме.
Dialogue: 0,0:26:56.08,0:26:59.08,Default,,0000,0000,0000,,Кез келген адам жақсы, солай ма? Король Линг.
Dialogue: 0,0:26:59.08,0:27:05.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:27:06.09,0:27:09.06,Default,,0000,0000,0000,,Содан кейін ештеңе жасамаңыз.
Dialogue: 0,0:27:09.06,0:27:11.06,Default,,0000,0000,0000,,Бұлай жалғаса берсе, мен жеңіліп, үйге қайтамын.
Dialogue: 0,0:27:11.06,0:27:15.07,Default,,0000,0000,0000,,Гяхаха! Не? Бұл жігіт!
Dialogue: 0,0:27:11.06,0:27:15.07,Default,,0000,0000,0000,,Мен мұны істегім келмейді!
Dialogue: 0,0:27:15.07,0:27:18.07,Default,,0000,0000,0000,,Хаа…. Ол қиын бала.
Dialogue: 0,0:27:22.07,0:27:26.11,Default,,0000,0000,0000,,Иә. Мен Король Рей осылай жасайды деп ойладым.
Dialogue: 0,0:27:22.07,0:27:26.11,Default,,0000,0000,0000,,Тағы да рахмет.
Dialogue: 0,0:27:26.11,0:27:29.21,Default,,0000,0000,0000,,《Мен көп күте алмаймын》
Dialogue: 0,0:27:29.21,0:27:31.22,Default,,0000,0000,0000,,⚟Жүгір!
Dialogue: 0,0:27:29.21,0:27:31.22,Default,,0000,0000,0000,,⚟Сәлем! Мұнда жиналмаңдар!
Dialogue: 0,0:27:31.22,0:27:33.08,Default,,0000,0000,0000,,⚟Шашырау, ақымақ!
Dialogue: 0,0:27:31.22,0:27:33.08,Default,,0000,0000,0000,,⚟Уау...!
Dialogue: 0,0:27:33.08,0:27:35.12,Default,,0000,0000,0000,,Шаа!
Dialogue: 0,0:27:33.08,0:27:35.12,Default,,0000,0000,0000,,Мына жігіт асығыс!
Dialogue: 0,0:27:35.12,0:27:37.09,Default,,0000,0000,0000,,Сабыр етіңіз.
Dialogue: 0,0:27:37.09,0:27:39.09,Default,,0000,0000,0000,,《Тығыздық дәл жоспарланғандай》
Dialogue: 0,0:27:40.13,0:27:42.13,Default,,0000,0000,0000,,《Секіріп, қашқан жер→
Dialogue: 0,0:27:42.13,0:27:44.10,Default,,0000,0000,0000,,Кіріңіз! 》
Dialogue: 0,0:27:46.10,0:27:48.07,Default,,0000,0000,0000,,Рей патша күткендей. Керемет~
Dialogue: 0,0:27:48.07,0:27:50.07,Default,,0000,0000,0000,,Уши!
Dialogue: 0,0:27:48.07,0:27:50.07,Default,,0000,0000,0000,,Мога...!
Dialogue: 0,0:27:52.10,0:27:54.11,Default,,0000,0000,0000,,Бұл тағы сенсің, Барса!
Dialogue: 0,0:27:55.11,0:27:58.11,Default,,0000,0000,0000,,көремін. Ал, мен жеңсем →
Dialogue: 0,0:27:58.11,0:28:01.08,Default,,0000,0000,0000,,Балалар сендер ақымақсыңдар!
Dialogue: 0,0:28:03.08,0:28:05.08,Default,,0000,0000,0000,,Мен ұрып-соғуға шыдай алмаймын!
Dialogue: 0,0:28:03.08,0:28:05.08,Default,,0000,0000,0000,,Dash Dash!
Dialogue: 0,0:28:07.09,0:28:10.12,Default,,0000,0000,0000,,《Жалғанды ​​ат! ? Ха! ? 》
Dialogue: 0,0:28:10.12,0:28:12.09,Default,,0000,0000,0000,,《Бұл қабырға...》
Dialogue: 0,0:28:12.09,0:28:18.10,Default,,0000,0000,0000,,Тамақтанбай же... Біреу оқ тиді!
Dialogue: 0,0:28:18.10,0:28:20.07,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:28:18.10,0:28:20.07,Default,,0000,0000,0000,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:28:21.07,0:28:23.07,Default,,0000,0000,0000,,《Аа...! 》
Dialogue: 0,0:28:24.10,0:28:26.07,Default,,0000,0000,0000,,《Жоқ... Қарғыс атсын...! 》
Dialogue: 0,0:28:26.07,0:28:36.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:28:36.11,0:28:38.08,Default,,0000,0000,0000,,О... бұл жақсы емес.
Dialogue: 0,0:28:40.09,0:28:42.09,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:28:44.09,0:28:48.06,Default,,0000,0000,0000,,Рей патшаның кеткені мені мазалайды.
Dialogue: 0,0:28:50.10,0:28:53.10,Default,,0000,0000,0000,,Уәде бермедің бе?
Dialogue: 0,0:28:53.10,0:28:55.07,Default,,0000,0000,0000,,Біз біргеміз.
Dialogue: 0,0:28:57.07,0:28:59.07,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:28:57.07,0:28:59.07,Default,,0000,0000,0000,,Жақсы...!
Dialogue: 0,0:28:59.07,0:29:01.07,Default,,0000,0000,0000,,Уайымдама...!
Dialogue: 0,0:29:02.11,0:29:04.08,Default,,0000,0000,0000,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:29:08.08,0:29:11.08,Default,,0000,0000,0000,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:29:12.08,0:29:16.05,Default,,0000,0000,0000,,А... Мен әлі үйге бара алмаймын.
Dialogue: 0,0:29:17.09,0:29:21.09,Default,,0000,0000,0000,,Наги Теми Корат!
Dialogue: 0,0:29:17.09,0:29:21.09,Default,,0000,0000,0000,,Сіз қайту үшін себеп табуға тырыстыңыз!
Dialogue: 0,0:29:21.09,0:29:23.06,Default,,0000,0000,0000,,Ой, өзімді ұстап қалдым ба?
Dialogue: 0,0:29:23.06,0:29:27.07,Default,,0000,0000,0000,,Егер ол жалтарса
Dialogue: 0,0:29:23.06,0:29:27.07,Default,,0000,0000,0000,,Мен қатты жұмыс істегендей болып үйге қайтсам екен.
Dialogue: 0,0:29:27.07,0:29:30.07,Default,,0000,0000,0000,,Бұл бейшара адам...
Dialogue: 0,0:29:31.07,0:29:35.17,Default,,0000,0000,0000,,Бірақ жақсы... Рахмет, Наги!
Dialogue: 0,0:29:35.17,0:29:38.14,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:29:35.17,0:29:38.14,Default,,0000,0000,0000,,Бұл ештеңе емес!
Dialogue: 0,0:29:44.08,0:29:46.08,Default,,0000,0000,0000,,Бұл керемет болды!
Dialogue: 0,0:29:46.08,0:29:52.09,Default,,0000,0000,0000,,Атап айтқанда, олардың үшеуі - Сейширо Наги, Рейо Микаге және Кенджу Зантецу.
Dialogue: 0,0:29:46.08,0:29:52.09,Default,,0000,0000,0000,,Мүмкін супер жоғары мектеп деңгейі!
Dialogue: 0,0:29:52.09,0:29:57.10,Default,,0000,0000,0000,,Бұл бастамасы ғана.
Dialogue: 0,0:29:52.09,0:29:57.10,Default,,0000,0000,0000,,Бұл жай ғана жатақханаға кіру сынағы...
Dialogue: 0,0:29:57.10,0:30:00.10,Default,,0000,0000,0000,,Нағыз өмір сүру осы жерден басталады.
Dialogue: 0,0:30:00.10,0:30:04.07,Default,,0000,0000,0000,,Бір-біріңмен жарысыңдар, дарынның асыл тастары.
Dialogue: 0,0:30:22.12,0:30:27.13,Default,,0000,0000,0000,,20 жасқа дейінгі Жапония құрамасына қарсы тұрақты ойын өткізді
Dialogue: 0,0:30:22.12,0:30:27.13,Default,,0000,0000,0000,,Сынақ.
Dialogue: 0,0:30:27.13,0:30:29.13,Default,,0000,0000,0000,,Мен әлемдегі ең үздік шабуылшы боламын! !
Dialogue: 0,0:30:29.13,0:30:31.13,Default,,0000,0000,0000,,<Осыдан кейін түн ортасынан бастап→
Dialogue: 0,0:30:31.13,0:30:35.13,Default,,0000,0000,0000,,Телехикаяның екінші маусымы
Dialogue: 0,0:30:31.13,0:30:35.13,Default,,0000,0000,0000,,«Blue Rock VS. U-20 JAPAN» басталуы>
Dialogue: 0,0:30:41.14,0:30:43.14,Default,,0000,0000,0000,,«Негізгі таңдау – →
Dialogue: 0,0:30:43.14,0:30:47.11,Default,,0000,0000,0000,,Бұл V-Z командалары арасындағы айналым бойынша лига матчы.
Dialogue: 0,0:30:47.11,0:30:49.15,Default,,0000,0000,0000,,«Үздік 2 топ жарылады»
Dialogue: 0,0:30:49.15,0:30:51.12,Default,,0000,0000,0000,,«Төменгі үш команда жойылды.»
Dialogue: 0,0:30:51.12,0:30:53.12,Default,,0000,0000,0000,,«Ерекшелік ретінде→
Dialogue: 0,0:30:53.12,0:30:57.16,Default,,0000,0000,0000,,Әр команданың ең көп ұпай жинаған ойыншысы
Dialogue: 0,0:30:53.12,0:30:57.16,Default,,0000,0000,0000,,Мен жеңемін».
Dialogue: 0,0:30:57.16,0:30:59.16,Default,,0000,0000,0000,,«Сонымен қатар, мақсат →
Dialogue: 0,0:30:59.16,0:31:01.13,Default,,0000,0000,0000,,Ұпай бонусы беріледі.”
Dialogue: 0,0:31:01.13,0:31:04.13,Default,,0000,0000,0000,,Мен көремін. Басқаша айтқанда, 10 гол →
Dialogue: 0,0:31:04.13,0:31:08.17,Default,,0000,0000,0000,,Бір күндік саяхат билеті
Dialogue: 0,0:31:04.13,0:31:08.17,Default,,0000,0000,0000,,Сіз маған бұл жерден кетіңіз деп жатырсыз.
Dialogue: 0,0:31:08.17,0:31:11.14,Default,,0000,0000,0000,,Барка. Мүлдем емес.
Dialogue: 0,0:31:11.14,0:31:14.17,Default,,0000,0000,0000,,Біріншіден, 5 командадан тұратын раундтық лига матчы →
Dialogue: 0,0:31:14.17,0:31:17.14,Default,,0000,0000,0000,,Бұл 11 адам
Dialogue: 0,0:31:14.17,0:31:17.14,Default,,0000,0000,0000,,Жеңіске жету үшін бар күшіңізді салу керек.
Dialogue: 0,0:31:17.14,0:31:20.11,Default,,0000,0000,0000,,Танысқаныма қуаныштымын, V тобы.
Dialogue: 0,0:31:17.14,0:31:20.11,Default,,0000,0000,0000,,Айқай.
Dialogue: 0,0:31:20.11,0:31:24.12,Default,,0000,0000,0000,,«Сәлеметсіз бе, таланттың асыл тастары».
Dialogue: 0,0:31:24.12,0:31:28.15,Default,,0000,0000,0000,,«Жақында балалар, V командасы мен Y командасы.
Dialogue: 0,0:31:24.12,0:31:28.15,Default,,0000,0000,0000,,Басталуы».
Dialogue: 0,0:31:28.15,0:31:31.16,Default,,0000,0000,0000,,Менің мақсатым немесе команданың жеңісі→
Dialogue: 0,0:31:31.16,0:31:37.13,Default,,0000,0000,0000,,Бастапқы таңдауда
Dialogue: 0,0:31:31.16,0:31:37.13,Default,,0000,0000,0000,,Мұндай шабуылшының тағдыры сыналады.
Dialogue: 0,0:31:37.13,0:31:41.13,Default,,0000,0000,0000,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:31:37.13,0:31:41.13,Default,,0000,0000,0000,,Бұл футболды нөлден бастау үшін күрес.
Dialogue: 0,0:31:52.11,0:31:54.11,Default,,0000,0000,0000,,Кеттік, Наги.
Dialogue: 0,0:31:54.11,0:31:56.11,Default,,0000,0000,0000,,《Қалай құтылсам болады...》
Dialogue: 0,0:31:58.15,0:32:00.15,Default,,0000,0000,0000,,
Dialogue: 0,0:32:00.15,0:32:02.12,Default,,0000,0000,0000,,《Аңыз басталады! 》
Dialogue: 0,0:32:02.12,0:32:05.16,Default,,0000,0000,0000,,《Мен сізге Рейо Микадждың ерекшеліктерін көрсетемін! 》
Dialogue: 0,0:32:05.16,0:32:08.13,Default,,0000,0000,0000,,《Қалай күрессең де,
Dialogue: 0,0:32:05.16,0:32:08.13,Default,,0000,0000,0000,,Бір сәтте...! 》
Dialogue: 0,0:32:10.13,0:32:14.10,Default,,0000,0000,0000,,Ол ешқандай қосымша күш бола алмайды.
Dialogue: 0,0:32:10.13,0:32:14.10,Default,,0000,0000,0000,,Не...! ? Сен не істеп жатырсың...! Сіз мен жағындасыз! ?
Dialogue: 0,0:32:14.10,0:32:18.14,Default,,0000,0000,0000,,Ең көп бомбардир жеңеді.
Dialogue: 0,0:32:14.10,0:32:18.14,Default,,0000,0000,0000,,Бұл команданың жеңісіне еш қатысы жоқ.
Dialogue: 0,0:32:18.14,0:32:20.24,Default,,0000,0000,0000,,Ең күшті шабуылшы ол...!
Dialogue: 0,0:32:20.24,0:32:23.11,Default,,0000,0000,0000,,⚞Бұл менмін!
Dialogue: 0,0:32:20.24,0:32:23.11,Default,,0000,0000,0000,,⚞Бірінші нөмір - мен!
Dialogue: 0,0:32:23.11,0:32:26.11,Default,,0000,0000,0000,,《Жоқ...! Солай ма? 》
Dialogue: 0,0:32:26.11,0:32:29.11,Default,,0000,0000,0000,,《Шабуылшы ретіндегі эго
Dialogue: 0,0:32:26.11,0:32:29.11,Default,,0000,0000,0000,,Соқтығысу арқылы →
Dialogue: 0,0:32:29.11,0:32:31.12,Default,,0000,0000,0000,,Ең күшті жеке қабілеттеріңізді тексеру...》
Dialogue: 0,0:32:31.12,0:32:34.12,Default,,0000,0000,0000,,《Алғашқы сұрыптаудың мәні осында...! 》
Dialogue: 0,0:32:35.12,0:32:38.09,Default,,0000,0000,0000,,Қызықты
Dialogue: 0,0:32:35.12,0:32:38.09,Default,,0000,0000,0000,,Бұл қызық, Көк рок!
Dialogue: 0,0:32:40.12,0:32:42.13,Default,,0000,0000,0000,,Итадакимасу.
Dialogue: 0,0:32:42.13,0:32:44.10,Default,,0000,0000,0000,,Мен қоян-қолтық ұрысты ұнатпаймын.
Dialogue: 0,0:32:45.10,0:32:47.10,Default,,0000,0000,0000,,《Алыстан →
Dialogue: 0,0:32:47.10,0:32:49.13,Default,,0000,0000,0000,,Сіз тоқаштағы допты көздедіңіз бе? ? 》
Dialogue: 0,0:32:49.13,0:32:52.14,Default,,0000,0000,0000,,《Мынау Бангс-кун керемет! 》
Dialogue: 0,0:32:52.14,0:32:54.14,Default,,0000,0000,0000,,《Бірақ...→
Dialogue: 0,0:32:54.14,0:32:57.14,Default,,0000,0000,0000,,Мен аң аулауда өте таланттымын! 》
Dialogue: 0,0:32:57.14,0:33:00.11,Default,,0000,0000,0000,,Ха! Мен оны қайтарамын!
Dialogue: 0,0:33:00.11,0:33:02.11,Default,,0000,0000,0000,,Қайтарыңыз!
Dialogue: 0,0:33:02.11,0:33:04.12,Default,,0000,0000,0000,,Сәлем...! Ақымақ Зантецу!
Dialogue: 0,0:33:04.12,0:33:06.08,Default,,0000,0000,0000,,Сіз әлі де солай айтасыз ба? Рей Микадж!
Dialogue: 0,0:33:07.12,0:33:10.12,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:33:07.12,0:33:10.12,Default,,0000,0000,0000,,《Мына жігіт... Ол сондай ақымақ, өте жылдам! 》
Dialogue: 0,0:33:10.12,0:33:12.12,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:33:12.12,0:33:14.13,Default,,0000,0000,0000,,
Dialogue: 0,0:33:15.09,0:33:19.10,Default,,0000,0000,0000,,《Жылдам ақылды поза》
Dialogue: 0,0:33:19.10,0:33:21.10,Default,,0000,0000,0000,,Нико
Dialogue: 0,0:33:19.10,0:33:21.10,Default,,0000,0000,0000,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:33:22.10,0:33:26.10,Default,,0000,0000,0000,,Эй, сәлем. Мен күзетшімін бе?
Dialogue: 0,0:33:22.10,0:33:26.10,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:33:35.11,0:33:39.12,Default,,0000,0000,0000,,Қияметсіз...!
Dialogue: 0,0:33:35.11,0:33:39.12,Default,,0000,0000,0000,,Ха! Хет-трик, мен жеңемін!
Dialogue: 0,0:33:39.12,0:33:42.12,Default,,0000,0000,0000,,...Неге демалып жатырсың, Наги!
Dialogue: 0,0:33:42.12,0:33:46.12,Default,,0000,0000,0000,,Қараңдаршы, бұл гамакқа ұқсайды.
Dialogue: 0,0:33:42.12,0:33:46.12,Default,,0000,0000,0000,,Бұл жақсы сезінеді.
Dialogue: 0,0:33:46.12,0:33:49.09,Default,,0000,0000,0000,,Менің командам жеңді, солай ма?
Dialogue: 0,0:33:49.09,0:33:51.13,Default,,0000,0000,0000,,Құттықтаймыз Рейу.
Dialogue: 0,0:33:51.13,0:33:54.10,Default,,0000,0000,0000,,Жоқ, менің айтқым келгені бұл емес...
Dialogue: 0,0:33:54.10,0:33:58.14,Default,,0000,0000,0000,,А... Дұрыс, Наги! Смартфон алғыңыз келе ме?
Dialogue: 0,0:33:58.14,0:34:02.14,Default,,0000,0000,0000,,Иә? күріш торты. Мен ойындар ойнағым келеді.
Dialogue: 0,0:34:02.14,0:34:04.14,Default,,0000,0000,0000,,Олай болса 3 ұпай алыңыз!
Dialogue: 0,0:34:04.14,0:34:07.15,Default,,0000,0000,0000,,Смартфоныңызды мақсатты бонуспен қайтарыңыз!
Dialogue: 0,0:34:08.15,0:34:11.12,Default,,0000,0000,0000,,Иә? Ондай нәрсе бар ма? Содан кейін...
Dialogue: 0,0:34:12.15,0:34:14.12,Default,,0000,0000,0000,,Дұрыс, Наги...
Dialogue: 0,0:34:14.12,0:34:17.12,Default,,0000,0000,0000,,Қалғанын саған қалдырамын, данышпан!
Dialogue: 0,0:34:18.16,0:34:21.13,Default,,0000,0000,0000,,Мен келдім.
Dialogue: 0,0:34:18.16,0:34:21.13,Default,,0000,0000,0000,,Артық емес.
Dialogue: 0,0:34:21.13,0:34:23.13,Default,,0000,0000,0000,,Шешуші менмін!
Dialogue: 0,0:34:23.13,0:34:27.10,Default,,0000,0000,0000,,Смартфон ойындары... тағы 3 ұпай.
Dialogue: 0,0:34:30.13,0:34:32.14,Default,,0000,0000,0000,,Жақсы! Ол тоқтады!
Dialogue: 0,0:34:32.14,0:34:34.11,Default,,0000,0000,0000,,Сіз қорқасыз ба? Сен сондай бәлеқойсың!
Dialogue: 0,0:34:35.14,0:34:37.14,Default,,0000,0000,0000,,Гамак, өтінемін.
Dialogue: 0,0:34:37.14,0:34:43.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:34:43.15,0:34:46.15,Default,,0000,0000,0000,,《Ха! ? Велосипед атылды...! ? 》
Dialogue: 0,0:34:46.15,0:34:48.15,Default,,0000,0000,0000,,《Не? Бұл...》
Dialogue: 0,0:34:48.15,0:34:50.12,Default,,0000,0000,0000,,
Dialogue: 0,0:34:52.16,0:34:55.13,Default,,0000,0000,0000,,《Не? Ағымдағы реакция...》
Dialogue: 0,0:34:55.13,0:34:57.13,Default,,0000,0000,0000,,《Бұл алдау ма? 》
Dialogue: 0,0:34:57.13,0:35:01.13,Default,,0000,0000,0000,,《Бұл данышпан Сейширо Наги...》
Dialogue: 0,0:35:01.13,0:35:06.14,Default,,0000,0000,0000,,《Ақылға қонымсыз және қатыгез
Dialogue: 0,0:35:01.13,0:35:06.14,Default,,0000,0000,0000,,Мазасыз эгоист...! 》
Dialogue: 0,0:35:07.14,0:35:12.11,Default,,0000,0000,0000,,Смартфон ойындары... тағы 2 ұпай.
Dialogue: 0,0:35:17.15,0:35:22.12,Default,,0000,0000,0000,,<Наги Сейширо стилі
Dialogue: 0,0:35:17.15,0:35:22.12,Default,,0000,0000,0000,,Денені ауыртпалықсыз жуу әдісі>
Dialogue: 0,0:35:22.12,0:35:25.12,Default,,0000,0000,0000,,<Бүкіл денеңізді бірден көбіктендіріңіз→
Dialogue: 0,0:35:25.12,0:35:28.13,Default,,0000,0000,0000,,Барлығы бірден →
Dialogue: 0,0:35:28.13,0:35:30.13,Default,,0000,0000,0000,,Иә Аяқтау>
Dialogue: 0,0:35:32.10,0:35:38.10,Default,,0000,0000,0000,,《Аа... Мен смартфонымды аман-есен қайтардым.
Dialogue: 0,0:35:32.10,0:35:38.10,Default,,0000,0000,0000,,Қалғаны жақсы.》
Dialogue: 0,0:35:38.10,0:35:40.10,Default,,0000,0000,0000,,《Иә》
Dialogue: 0,0:35:43.14,0:35:46.11,Default,,0000,0000,0000,,Ваннада тістеріңізді тазаламаңыз. Бұл қауіпті.
Dialogue: 0,0:35:46.11,0:35:48.11,Default,,0000,0000,0000,,Ах... Аа, кешіріңіз.
Dialogue: 0,0:35:48.11,0:35:50.11,Default,,0000,0000,0000,,Бұл менің отбасымның өсиеті.
Dialogue: 0,0:35:50.11,0:35:55.12,Default,,0000,0000,0000,,Салтанатты оқиғаларды ұмытсаңыз да
Dialogue: 0,0:35:50.11,0:35:55.12,Default,,0000,0000,0000,,Тістерді тазалауды ұмытпаңыз.
Dialogue: 0,0:35:55.12,0:35:57.12,Default,,0000,0000,0000,,Не? Бұл ақымақ дәйексөз сияқты.
Dialogue: 0,0:35:57.12,0:36:00.12,Default,,0000,0000,0000,,Өйткені менің отбасы мүшелерім тіс дәрігері.
Dialogue: 0,0:36:00.12,0:36:03.19,Default,,0000,0000,0000,,Иә. Мен ақылды отбасынан шыққанмын.
Dialogue: 0,0:36:03.19,0:36:07.13,Default,,0000,0000,0000,,Ах. Менен басқаның бәрі ақылды.
Dialogue: 0,0:36:07.13,0:36:12.10,Default,,0000,0000,0000,,Демек, сіз мутантсыз ба?
Dialogue: 0,0:36:07.13,0:36:12.10,Default,,0000,0000,0000,,Сізді отбасыңыз ақымақ деп өсірдіңіз бе?
Dialogue: 0,0:36:12.10,0:36:16.14,Default,,0000,0000,0000,,Жоқ Менің отбасым маған мейірімді.
Dialogue: 0,0:36:16.14,0:36:21.11,Default,,0000,0000,0000,,Нағыз дана адамдар
Dialogue: 0,0:36:16.14,0:36:21.11,Default,,0000,0000,0000,,Оның ақымақты ешқашан ақымақ демейтін мейірімділігі бар.
Dialogue: 0,0:36:21.11,0:36:24.12,Default,,0000,0000,0000,,Не? Бұл шынымен әйгілі дәйексөз сияқты.
Dialogue: 0,0:36:24.12,0:36:26.12,Default,,0000,0000,0000,,Бұл менің сөздерім.
Dialogue: 0,0:36:26.12,0:36:31.12,Default,,0000,0000,0000,,Дұрыс айтасыз.
Dialogue: 0,0:36:26.12,0:36:31.12,Default,,0000,0000,0000,,Айналамдағылардың бәрі мені мазақ етті.
Dialogue: 0,0:36:31.12,0:36:33.12,Default,,0000,0000,0000,,Барқа!
Dialogue: 0,0:36:35.09,0:36:38.13,Default,,0000,0000,0000,,(Зантецу дауысы)
Dialogue: 0,0:36:35.09,0:36:38.13,Default,,0000,0000,0000,,Бірақ мен жылдам екенімді байқадым →
Dialogue: 0,0:36:38.13,0:36:41.13,Default,,0000,0000,0000,,Спорт арқылы күн көремін деп шештім.
Dialogue: 0,0:36:41.13,0:36:45.10,Default,,0000,0000,0000,,Белсенді футбол ойнаңыз және кәсіби маман болыңыз →
Dialogue: 0,0:36:45.10,0:36:48.21,Default,,0000,0000,0000,,Әлемнің үздік шабуылшысы болыңыз →
Dialogue: 0,0:36:48.21,0:36:52.11,Default,,0000,0000,0000,,Әлемдегі ең құрметті ақымақ бол.
Dialogue: 0,0:36:52.11,0:36:54.11,Default,,0000,0000,0000,,Бұл менің арманым.
Dialogue: 0,0:36:55.11,0:36:59.08,Default,,0000,0000,0000,,Иә. Сіз кереметсіз.
Dialogue: 0,0:37:00.12,0:37:03.12,Default,,0000,0000,0000,,Сейширо Наги, сен неге футбол ойнайсың?
Dialogue: 0,0:37:03.12,0:37:08.13,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:37:03.12,0:37:08.13,Default,,0000,0000,0000,,Мен Рей патшаның соңынан ердім→
Dialogue: 0,0:37:08.13,0:37:11.13,Default,,0000,0000,0000,,Менде сен сияқты тамаша арман жоқ.
Dialogue: 0,0:37:11.13,0:37:15.10,Default,,0000,0000,0000,,Сіз мені аңдып жүргеніңізді айттыңыз...
Dialogue: 0,0:37:11.13,0:37:15.10,Default,,0000,0000,0000,,Ондай жігіттің несі жақсы?
Dialogue: 0,0:37:16.17,0:37:18.14,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:37:18.14,0:37:20.14,Default,,0000,0000,0000,,Мүмкін бұл менің бірінші рет келуімнен шығар.
Dialogue: 0,0:37:20.14,0:37:25.11,Default,,0000,0000,0000,,Мен сияқты бейшара адамға
Dialogue: 0,0:37:20.14,0:37:25.11,Default,,0000,0000,0000,,Маған қызығушылық танытқан адам.
Dialogue: 0,0:37:29.15,0:37:32.15,Default,,0000,0000,0000,,Сіз біртүрлі адамсыз.
Dialogue: 0,0:37:32.15,0:37:34.15,Default,,0000,0000,0000,,Иә. Жиі айтатын.
Dialogue: 0,0:37:34.15,0:37:38.12,Default,,0000,0000,0000,,Бірақ ол жаман адам емес.
Dialogue: 0,0:37:38.12,0:37:40.12,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:37:40.12,0:37:45.13,Default,,0000,0000,0000,,Ойлау қабілетіңіз нашар болса
Dialogue: 0,0:37:40.12,0:37:45.13,Default,,0000,0000,0000,,Неге Рей патшаның айтқанын тыңдамайсың?
Dialogue: 0,0:37:45.13,0:37:48.10,Default,,0000,0000,0000,,Рейу Ол шынымен де ақылды.
Dialogue: 0,0:37:51.14,0:37:55.14,Default,,0000,0000,0000,,Қарсылас – Сае Итоси бастаған 20 жасқа дейінгі Жапония ұлттық құрамасы.
Dialogue: 0,0:37:56.14,0:37:59.14,Default,,0000,0000,0000,,Жеңілсең, Көк жартас жоғалады.
Dialogue: 0,0:37:59.14,0:38:03.15,Default,,0000,0000,0000,,Олардың арасына кіріңіз
Dialogue: 0,0:37:59.14,0:38:03.15,Default,,0000,0000,0000,,Ең бастысы - өз өміріңізді қалай насихаттауға болады!
Dialogue: 0,0:38:05.12,0:38:07.15,Default,,0000,0000,0000,,Сіз А командасының саңылауысыз.
Dialogue: 0,0:38:07.15,0:38:10.12,Default,,0000,0000,0000,,Бұлай жалғаса берсе, біз ештеңе істей алмай қаламыз!
Dialogue: 0,0:38:10.12,0:38:12.19,Default,,0000,0000,0000,,<Осыдан кейін түн ортасынан бастап →
Dialogue: 0,0:38:12.19,0:38:17.13,Default,,0000,0000,0000,,Телехикаяның екінші маусымы
Dialogue: 0,0:38:12.19,0:38:17.13,Default,,0000,0000,0000,,«Blue Rock VS. U-20 JAPAN» басталуы>
Dialogue: 0,0:38:17.13,0:38:20.10,Default,,0000,0000,0000,,Мен әлемдегі ең үздік шабуылшы боламын! !
Dialogue: 0,0:38:22.10,0:38:26.10,Default,,0000,0000,0000,,(Зантецу)
Dialogue: 0,0:38:22.10,0:38:26.10,Default,,0000,0000,0000,,《Мына жігіт солай айтса, неге байқамайсың?》
Dialogue: 0,0:38:26.10,0:38:28.11,Default,,0000,0000,0000,,Крокодил
Dialogue: 0,0:38:26.10,0:38:28.11,Default,,0000,0000,0000,,(Кейсуке Ванима)
Dialogue: 0,0:38:26.10,0:38:28.11,Default,,0000,0000,0000,,Бұған жол берме!
Dialogue: 0,0:38:30.11,0:38:33.11,Default,,0000,0000,0000,,《Кәне, Рейо Микадж, көріңіз! 》
Dialogue: 0,0:38:34.11,0:38:36.11,Default,,0000,0000,0000,,Дәл осында!
Dialogue: 0,0:38:36.11,0:38:39.08,Default,,0000,0000,0000,,Осымен матчты шеш, Зантецу!
Dialogue: 0,0:38:41.12,0:38:43.09,Default,,0000,0000,0000,,Алға, тіс дәрігері.
Dialogue: 0,0:38:44.12,0:38:49.09,Default,,0000,0000,0000,,《Мазақ еткен
Dialogue: 0,0:38:44.12,0:38:49.09,Default,,0000,0000,0000,,Мен жай ғана жүгіре берген күндер→
Dialogue: 0,0:38:49.09,0:38:53.10,Default,,0000,0000,0000,,Бұл бекер емес шығар.
Dialogue: 0,0:38:53.10,0:38:56.17,Default,,0000,0000,0000,,《Біреу маған керемет екенімді айтты→
Dialogue: 0,0:38:56.17,0:39:00.14,Default,,0000,0000,0000,,Менің оны қалай қолданатынымды түсінетін адам бар...》
Dialogue: 0,0:39:00.14,0:39:02.11,Default,,0000,0000,0000,,Көк жартас дегеніміз не→
Dialogue: 0,0:39:02.11,0:39:05.11,Default,,0000,0000,0000,,Көңілді! !
Dialogue: 0,0:39:05.11,0:39:08.11,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:39:05.11,0:39:08.11,Default,,0000,0000,0000,,Хмм! ? Вани Вани дүрбелеңі!
Dialogue: 0,0:39:08.11,0:39:10.11,Default,,0000,0000,0000,,Гэе... Мен?
Dialogue: 0,0:39:10.11,0:39:13.08,Default,,0000,0000,0000,,А, күн ыстық болып барады...
Dialogue: 0,0:39:16.12,0:39:18.09,Default,,0000,0000,0000,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:39:22.13,0:39:24.10,Default,,0000,0000,0000,,
Dialogue: 0,0:39:24.10,0:39:27.10,Default,,0000,0000,0000,,《Көк рок... бұл өте қиын》
Dialogue: 0,0:39:39.11,0:39:42.11,Default,,0000,0000,0000,,Оңай жеңіс! X командасы да маңызды емес!
Dialogue: 0,0:39:42.11,0:39:44.12,Default,,0000,0000,0000,,Шеш, Наги!
Dialogue: 0,0:39:44.12,0:39:46.08,Default,,0000,0000,0000,,Иса Иса.
Dialogue: 0,0:39:48.12,0:39:50.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:39:51.09,0:39:53.09,Default,,0000,0000,0000,,Кешіріңіз, Наги! Мен күзетімді түсірдім!
Dialogue: 0,0:39:53.09,0:39:56.09,Default,,0000,0000,0000,,Бару
Dialogue: 0,0:39:53.09,0:39:56.09,Default,,0000,0000,0000,,Жарайды. Қайтарыңыз, король Мару.
Dialogue: 0,0:39:59.10,0:40:02.10,Default,,0000,0000,0000,,«Оны қайтаруыңызды өтінемін».
Dialogue: 0,0:40:02.10,0:40:04.07,Default,,0000,0000,0000,,Нұсқау күтіп тұрған құл.
Dialogue: 0,0:40:05.10,0:40:07.07,Default,,0000,0000,0000,,Құл?
Dialogue: 0,0:40:08.11,0:40:11.11,Default,,0000,0000,0000,,Зантецу мен сені шымшып аламын!
Dialogue: 0,0:40:08.11,0:40:11.11,Default,,0000,0000,0000,,Жарайды, секс техникасы!
Dialogue: 0,0:40:15.11,0:40:18.12,Default,,0000,0000,0000,,《Қәлемет! Сіз соған мақсат қойдыңыз ба? ? 》
Dialogue: 0,0:40:18.12,0:40:22.19,Default,,0000,0000,0000,,《Біз ауысқанда туылғанбыз
Dialogue: 0,0:40:18.12,0:40:22.19,Default,,0000,0000,0000,,Бір сәттік кеңістік》
Dialogue: 0,0:40:22.19,0:40:26.09,Default,,0000,0000,0000,,《Сізде жақсы түсінік пен футбол IQ болуы керек.
Dialogue: 0,0:40:22.19,0:40:26.09,Default,,0000,0000,0000,,Сіз көздеуге болмайтын соқыр нүктелер! 》
Dialogue: 0,0:40:26.09,0:40:30.09,Default,,0000,0000,0000,,《Бұл жігіт...
Dialogue: 0,0:40:26.09,0:40:30.09,Default,,0000,0000,0000,,Тек өзімшіл ойыншы болмаңыз! 》
Dialogue: 0,0:40:31.10,0:40:33.10,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:40:37.13,0:40:40.10,Default,,0000,0000,0000,,Бұл оңай жеңіс пе? Сендер.
Dialogue: 0,0:40:41.11,0:40:45.11,Default,,0000,0000,0000,,Мен құл емеспін.
Dialogue: 0,0:40:41.11,0:40:45.11,Default,,0000,0000,0000,,Мен Рейудың серіктесімін.
Dialogue: 0,0:40:45.11,0:40:47.11,Default,,0000,0000,0000,,
Dialogue: 0,0:40:48.11,0:40:51.08,Default,,0000,0000,0000,,《Иә... біз ең мықты серіктеспіз! 》
Dialogue: 0,0:40:53.08,0:40:55.09,Default,,0000,0000,0000,,
Dialogue: 0,0:40:55.09,0:40:59.09,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:40:55.09,0:40:59.09,Default,,0000,0000,0000,,Осындай қызықсыз гол соққаныңызға көңіліңіз тола ма?
Dialogue: 0,0:40:59.09,0:41:04.09,Default,,0000,0000,0000,,Бөлек. Мақсат - бұл мақсат, солай ма?
Dialogue: 0,0:40:59.09,0:41:04.09,Default,,0000,0000,0000,,Қызықты ма, жоқ па бәрібір.
Dialogue: 0,0:41:04.09,0:41:07.10,Default,,0000,0000,0000,,Бұл қызметшінің ойы, қоқыс.
Dialogue: 0,0:41:07.10,0:41:10.10,Default,,0000,0000,0000,,Не? сол. Бұл нені білдіреді?
Dialogue: 0,0:41:10.10,0:41:12.10,Default,,0000,0000,0000,,Сіздің барлық мақсаттарыңыз →
Dialogue: 0,0:41:12.10,0:41:17.14,Default,,0000,0000,0000,,Сол күлгін шашты шебер басқарады
Dialogue: 0,0:41:12.10,0:41:17.14,Default,,0000,0000,0000,,Бұл құлдық мақсат.
Dialogue: 0,0:41:17.14,0:41:20.11,Default,,0000,0000,0000,,Теңіз анемоны жалғыз өмір сүре алмайды.
Dialogue: 0,0:41:24.11,0:41:26.12,Default,,0000,0000,0000,,Жарайсың ба? құл адам.
Dialogue: 0,0:41:26.12,0:41:29.09,Default,,0000,0000,0000,,Әлемнің үздік ойыншысы атанатын шабуылшы...
Dialogue: 0,0:41:34.12,0:41:37.09,Default,,0000,0000,0000,,Өлгенше жалғыз боламын!
Dialogue: 0,0:41:38.10,0:41:40.10,Default,,0000,0000,0000,,
Dialogue: 0,0:41:42.13,0:41:45.10,Default,,0000,0000,0000,,Мен біреуге бағынғанды жөн көремін...→
Dialogue: 0,0:41:45.10,0:41:48.14,Default,,0000,0000,0000,,Өлген жақсы.
Dialogue: 0,0:41:48.14,0:41:52.11,Default,,0000,0000,0000,,《Құл...? Мен? 》
Dialogue: 0,0:41:53.11,0:41:55.11,Default,,0000,0000,0000,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:41:55.11,0:41:59.12,Default,,0000,0000,0000,,Бір адам қандай ұлы болса да
Dialogue: 0,0:41:55.11,0:41:59.12,Default,,0000,0000,0000,,Билікті қудалау ұйымдары күйреді.
Dialogue: 0,0:41:59.12,0:42:03.12,Default,,0000,0000,0000,,Енді тағы бір ұпай алыңыз.
Dialogue: 0,0:41:59.12,0:42:03.12,Default,,0000,0000,0000,,Осы сәйкестікті жабу керек пе?
Dialogue: 0,0:42:03.12,0:42:05.09,Default,,0000,0000,0000,,
Dialogue: 0,0:42:06.12,0:42:08.13,Default,,0000,0000,0000,,Не... Эй, Наги!
Dialogue: 0,0:42:08.13,0:42:10.13,Default,,0000,0000,0000,,Нада Теми...!
Dialogue: 0,0:42:13.10,0:42:15.10,Default,,0000,0000,0000,,Құл Кеттік.
Dialogue: 0,0:42:16.13,0:42:18.10,Default,,0000,0000,0000,,Ха... Уау...
Dialogue: 0,0:42:18.10,0:42:20.10,Default,,0000,0000,0000,,《Маған көрсетші, данышпан! 》
Dialogue: 0,0:42:25.11,0:42:29.11,Default,,0000,0000,0000,,《Мына жігіт...!
Dialogue: 0,0:42:25.11,0:42:29.11,Default,,0000,0000,0000,,Өкше
Dialogue: 0,0:42:25.11,0:42:29.11,Default,,0000,0000,0000,,Өзін көрсету үшін өкшелі қақпан! ? 》
Dialogue: 0,0:42:30.11,0:42:34.12,Default,,0000,0000,0000,,Әлі де... қызықсыз ба?
Dialogue: 0,0:42:34.12,0:42:37.09,Default,,0000,0000,0000,,Қарғыс атсын...! өлтіру...!
Dialogue: 0,0:42:38.12,0:42:40.12,Default,,0000,0000,0000,,Сәлем! Бұзақылық! PK!
Dialogue: 0,0:42:40.12,0:42:42.13,Default,,0000,0000,0000,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:42:40.12,0:42:42.13,Default,,0000,0000,0000,,Ахх.
Dialogue: 0,0:42:42.13,0:42:46.13,Default,,0000,0000,0000,,Құлға айналдыру
Dialogue: 0,0:42:42.13,0:42:46.13,Default,,0000,0000,0000,,Сіз Корольдің құқығынан айырылдыңыз.
Dialogue: 0,0:42:51.10,0:42:53.10,Default,,0000,0000,0000,,
Dialogue: 0,0:42:55.11,0:42:58.11,Default,,0000,0000,0000,,
Dialogue: 0,0:42:58.11,0:43:02.11,Default,,0000,0000,0000,,
Dialogue: 0,0:42:58.11,0:43:02.11,Default,,0000,0000,0000,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:42:58.11,0:43:02.11,Default,,0000,0000,0000,,«Көк рок ойыны 5, ойын 8, ойынның соңы»
Dialogue: 0,0:43:02.11,0:43:06.08,Default,,0000,0000,0000,,«V командасы 5-тен 2-ге дейін жеңеді.»
Dialogue: 0,0:43:07.12,0:43:11.09,Default,,0000,0000,0000,,Эй, эй, Наги! Жалқау адам үшін
Dialogue: 0,0:43:07.12,0:43:11.09,Default,,0000,0000,0000,,Бұл күшті мақсат!
Dialogue: 0,0:43:11.09,0:43:14.12,Default,,0000,0000,0000,,Мен үшін?
Dialogue: 0,0:43:11.09,0:43:14.12,Default,,0000,0000,0000,,Не? Әсіресе.
Dialogue: 0,0:43:14.12,0:43:16.09,Default,,0000,0000,0000,,Жақсы жұмыс.
Dialogue: 0,0:43:17.09,0:43:20.10,Default,,0000,0000,0000,,Несі қиын...
Dialogue: 0,0:43:20.10,0:43:24.10,Default,,0000,0000,0000,,Сен сондай эгоистсің, солай емес пе?
Dialogue: 0,0:43:24.10,0:43:28.11,Default,,0000,0000,0000,,Келесі кездескенде мен сені құлыным етем...
Dialogue: 0,0:43:24.10,0:43:28.11,Default,,0000,0000,0000,,Бейбақ!
Dialogue: 0,0:43:35.08,0:43:39.12,Default,,0000,0000,0000,,20 жасқа дейінгі Жапония құрамасына қарсы тұрақты ойын өткізді
Dialogue: 0,0:43:35.08,0:43:39.12,Default,,0000,0000,0000,,Сынақ.
Dialogue: 0,0:43:39.12,0:43:42.09,Default,,0000,0000,0000,,Мен әлемдегі ең үздік шабуылшы боламын! !
Dialogue: 0,0:43:42.09,0:43:44.15,Default,,0000,0000,0000,,<Осыдан кейін түн ортасынан бастап →
Dialogue: 0,0:43:44.15,0:43:48.13,Default,,0000,0000,0000,,Телехикаяның екінші маусымы
Dialogue: 0,0:43:44.15,0:43:48.13,Default,,0000,0000,0000,,«Blue Rock VS. U-20 JAPAN» басталуы>
Dialogue: 0,0:43:50.09,0:43:53.10,Default,,0000,0000,0000,,Куон
Dialogue: 0,0:43:50.09,0:43:53.10,Default,,0000,0000,0000,,Менің келесі қарсыласым - Ватару Куон.
Dialogue: 0,0:43:53.10,0:43:55.13,Default,,0000,0000,0000,,Мәміле жасағыңыз келе ме?
Dialogue: 0,0:43:55.13,0:43:57.10,Default,,0000,0000,0000,,《Хаа... шаршадым...》
Dialogue: 0,0:43:57.10,0:44:02.11,Default,,0000,0000,0000,,《Неге?
Dialogue: 0,0:43:57.10,0:44:02.11,Default,,0000,0000,0000,,Сіз көп жұмыс істеген болуыңыз керек...》
Dialogue: 0,0:44:02.11,0:44:05.11,Default,,0000,0000,0000,,《Жоқ.
Dialogue: 0,0:44:02.11,0:44:05.11,Default,,0000,0000,0000,,Ойлаудың өзі азап...》
Dialogue: 0,0:44:05.11,0:44:10.11,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:44:05.11,0:44:10.11,Default,,0000,0000,0000,,Мен сізге келесі жарысқа қатысатын Z командасы туралы ақпарат беремін→
Dialogue: 0,0:44:10.11,0:44:13.08,Default,,0000,0000,0000,,Оны 0 ұпайға дейін сақтаңыз және ұтып алыңыз.
Dialogue: 0,0:44:13.08,0:44:15.09,Default,,0000,0000,0000,,Атап айтқанда….
Dialogue: 0,0:44:15.09,0:44:19.12,Default,,0000,0000,0000,,《Бұл не? Бұл адам.
Dialogue: 0,0:44:15.09,0:44:19.12,Default,,0000,0000,0000,,Мен біраз уақыттан бері үмітсіз болдым...》
Dialogue: 0,0:44:19.12,0:44:22.19,Default,,0000,0000,0000,,Әй, қалай? Менімен бірге болғың келе ме?
Dialogue: 0,0:44:22.19,0:44:24.09,Default,,0000,0000,0000,,Бас тарту.
Dialogue: 0,0:44:22.19,0:44:24.09,Default,,0000,0000,0000,,Бұл өте қиын.
Dialogue: 0,0:44:24.09,0:44:26.06,Default,,0000,0000,0000,,Бұл қызықсыз.
Dialogue: 0,0:44:24.09,0:44:26.06,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:44:26.06,0:44:30.07,Default,,0000,0000,0000,,Бұл жеткілікті, Рей патша. Бұл әңгіме өте қиын.
Dialogue: 0,0:44:30.07,0:44:33.10,Default,,0000,0000,0000,,Бл…ээ…!!
Dialogue: 0,0:44:30.07,0:44:33.10,Default,,0000,0000,0000,,Жарайды, шайнаудың өзі азап...
Dialogue: 0,0:44:33.10,0:44:36.07,Default,,0000,0000,0000,,Үйге қайтайық. Мені арқама көтеріп апарыңыз.
Dialogue: 0,0:44:36.07,0:44:40.08,Default,,0000,0000,0000,,Наги! Өйткені сіз жегіңіз келеді
Dialogue: 0,0:44:36.07,0:44:40.08,Default,,0000,0000,0000,,Мен сені осында әкелдім.
Dialogue: 0,0:44:40.08,0:44:43.08,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:44:40.08,0:44:43.08,Default,,0000,0000,0000,,Ол тітіркендіреді...
Dialogue: 0,0:44:43.08,0:44:45.08,Default,,0000,0000,0000,,Бұл стейк ысырап емес пе?
Dialogue: 0,0:44:45.08,0:44:48.09,Default,,0000,0000,0000,,А-а... Бірақ қалғанын жесем ше?
Dialogue: 0,0:44:45.08,0:44:48.09,Default,,0000,0000,0000,,Менің ойымша, бұл ақымақ көрінеді...
Dialogue: 0,0:44:48.09,0:44:50.09,Default,,0000,0000,0000,,Күте тұрыңыз! Тағы біраз сөйлесейік...
Dialogue: 0,0:44:50.09,0:44:53.09,Default,,0000,0000,0000,,Сәлем Рейу
Dialogue: 0,0:44:50.09,0:44:53.09,Default,,0000,0000,0000,,Бұл адам неге сонша үмітсіз?
Dialogue: 0,0:44:53.09,0:44:55.09,Default,,0000,0000,0000,,Бұл жеңу туралы.
Dialogue: 0,0:44:55.09,0:44:59.06,Default,,0000,0000,0000,,Хмм…. Қатты тырыспасаң, жеңе алмайсың →
Dialogue: 0,0:44:59.06,0:45:02.07,Default,,0000,0000,0000,,Әлсіз жігіттер қиындық тудырады.
Dialogue: 0,0:45:03.10,0:45:06.10,Default,,0000,0000,0000,,Мен болсам, тоқтар едім...
Dialogue: 0,0:45:06.10,0:45:11.08,Default,,0000,0000,0000,,Ей, Рейо, жеңілсем де, бәрібір мұны істегім келеді.
Dialogue: 0,0:45:06.10,0:45:11.08,Default,,0000,0000,0000,,Футбол қызықты ма?
Dialogue: 0,0:45:11.08,0:45:13.08,Default,,0000,0000,0000,,Эй... күте тұрыңыз.
Dialogue: 0,0:45:15.08,0:45:17.08,Default,,0000,0000,0000,,Не? сен.
Dialogue: 0,0:45:17.08,0:45:19.05,Default,,0000,0000,0000,,Футбол ойнамаңыз!
Dialogue: 0,0:45:24.09,0:45:26.06,Default,,0000,0000,0000,,《Ол кезде...》
Dialogue: 0,0:45:30.09,0:45:32.06,Default,,0000,0000,0000,,Сонда бұл кім? Теми.
Dialogue: 0,0:45:33.06,0:45:36.10,Default,,0000,0000,0000,,Исаги
Dialogue: 0,0:45:33.06,0:45:36.10,Default,,0000,0000,0000,,Йоичи
Dialogue: 0,0:45:33.06,0:45:36.10,Default,,0000,0000,0000,,Z командасы Киёшиичи.
Dialogue: 0,0:45:36.10,0:45:38.07,Default,,0000,0000,0000,,Мен сені жеңе алатын адаммын!
Dialogue: 0,0:45:43.11,0:45:45.08,Default,,0000,0000,0000,,(Ойын дыбысы)
Dialogue: 0,0:45:45.08,0:45:48.08,Default,,0000,0000,0000,,Баратын уақыт болды, Наги.
Dialogue: 0,0:45:45.08,0:45:48.08,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:45:49.08,0:45:53.05,Default,,0000,0000,0000,,《Көк жартасқа келген соң...
Dialogue: 0,0:45:49.08,0:45:53.05,Default,,0000,0000,0000,,Мен біртүрлімін.
Dialogue: 0,0:45:55.09,0:45:58.06,Default,,0000,0000,0000,,《Неге?
Dialogue: 0,0:45:55.09,0:45:58.06,Default,,0000,0000,0000,,Сіз сонша еңбек еткен боларсыз...? 》
Dialogue: 0,0:45:59.12,0:46:04.09,Default,,0000,0000,0000,,《Рей патшамен бірге мені мазақ еткендіктен бе?
Dialogue: 0,0:45:59.12,0:46:04.09,Default,,0000,0000,0000,,Себебі ол мені ашуландырды...? 》
Dialogue: 0,0:46:05.10,0:46:07.10,Default,,0000,0000,0000,,Бұл матч финалдық матч.
Dialogue: 0,0:46:07.10,0:46:10.10,Default,,0000,0000,0000,,Біз барлық жеңістерге қол жеткіздік.
Dialogue: 0,0:46:07.10,0:46:10.10,Default,,0000,0000,0000,,Мен лига матчынан өтуді шештім →
Dialogue: 0,0:46:10.10,0:46:14.10,Default,,0000,0000,0000,,Z тобының балалары
Dialogue: 0,0:46:10.10,0:46:14.10,Default,,0000,0000,0000,,Тірі қалу осы сәйкестікке байланысты.
Dialogue: 0,0:46:14.10,0:46:17.11,Default,,0000,0000,0000,,Әрине жеңу үшін бар күшімді саламын.
Dialogue: 0,0:46:17.11,0:46:20.08,Default,,0000,0000,0000,,Жарайды. ``Жең, Кабутомуши''... Дұрыс.
Dialogue: 0,0:46:20.08,0:46:23.11,Default,,0000,0000,0000,,Дулыға
Dialogue: 0,0:46:20.08,0:46:23.11,Default,,0000,0000,0000,,«Жеңіске жет, дулығаңды қа!»
Dialogue: 0,0:46:23.11,0:46:26.08,Default,,0000,0000,0000,,《Ой, мен абдырап қалдым...》
Dialogue: 0,0:46:26.08,0:46:29.09,Default,,0000,0000,0000,,Содан кейін, бірінші таңдау, соңғы шайқас!
Dialogue: 0,0:46:29.09,0:46:32.12,Default,,0000,0000,0000,,Қоңызды жеңіңіз
Dialogue: 0,0:46:29.09,0:46:32.12,Default,,0000,0000,0000,,Жеңіске жет, Қоңыз!
Dialogue: 0,0:46:32.12,0:46:34.09,Default,,0000,0000,0000,,《Мазасыз》
Dialogue: 0,0:46:42.10,0:46:46.10,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:46:42.10,0:46:46.10,Default,,0000,0000,0000,,Сіз ең әлсіз бізді, ең күштіні жеңеді деп ойлайсыз ба?
Dialogue: 0,0:46:46.10,0:46:48.11,Default,,0000,0000,0000,,Байқап көріңіз, Z тобы.
Dialogue: 0,0:46:48.11,0:46:51.11,Default,,0000,0000,0000,,Ондай нәрсе бар ма? 10 адам?
Dialogue: 0,0:46:51.11,0:46:54.08,Default,,0000,0000,0000,,Сол сатқын бұрышта.
Dialogue: 0,0:46:54.08,0:46:56.08,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:46:56.08,0:47:00.08,Default,,0000,0000,0000,,Біз жеңеміз. Қазіргі уақытта біз ең көп бомбардирміз.
Dialogue: 0,0:46:56.08,0:47:00.08,Default,,0000,0000,0000,,Тек ол ғана өмір сүре алады.
Dialogue: 0,0:47:00.08,0:47:02.09,Default,,0000,0000,0000,,Сіз бұрыштарды кесуге тырысып жатырсыз.
Dialogue: 0,0:47:02.09,0:47:04.05,Default,,0000,0000,0000,,
Dialogue: 0,0:47:06.09,0:47:10.06,Default,,0000,0000,0000,,Ең төменгі рейтингі бар Z командасын қараңыз!
Dialogue: 0,0:47:13.06,0:47:16.10,Default,,0000,0000,0000,,Зантецу! Маған қаруыңды көрсет!
Dialogue: 0,0:47:16.10,0:47:18.07,Default,,0000,0000,0000,,Менің қаруым...
Dialogue: 0,0:47:18.07,0:47:21.10,Default,,0000,0000,0000,,Менің микротолқынды пештегі иек!
Dialogue: 0,0:47:21.10,0:47:24.07,Default,,0000,0000,0000,,《Бірақ бірдеңе кедергі болса...→
Dialogue: 0,0:47:24.07,0:47:26.08,Default,,0000,0000,0000,,Нагиге! 》
Dialogue: 0,0:47:27.08,0:47:30.08,Default,,0000,0000,0000,,《Әлі бәрі
Dialogue: 0,0:47:27.08,0:47:30.08,Default,,0000,0000,0000,,Менің ойымша, сіз футболды ұнатасыз...》
Dialogue: 0,0:47:30.08,0:47:32.08,Default,,0000,0000,0000,,Игагури!
Dialogue: 0,0:47:30.08,0:47:32.08,Default,,0000,0000,0000,,Гримм
Dialogue: 0,0:47:30.08,0:47:32.08,Default,,0000,0000,0000,,Шаа!
Dialogue: 0,0:47:32.08,0:47:35.09,Default,,0000,0000,0000,,Урааа! Киёсиді алыңыз!
Dialogue: 0,0:47:35.09,0:47:37.09,Default,,0000,0000,0000,,《Үмітсіз болдым...》
Dialogue: 0,0:47:37.09,0:47:39.09,Default,,0000,0000,0000,,Бачира
Dialogue: 0,0:47:37.09,0:47:39.09,Default,,0000,0000,0000,,Ара музыкасы!
Dialogue: 0,0:47:39.09,0:47:41.09,Default,,0000,0000,0000,,Айнала
Dialogue: 0,0:47:39.09,0:47:41.09,Default,,0000,0000,0000,,Иә! Мен кетемін!
Dialogue: 0,0:47:41.09,0:47:45.10,Default,,0000,0000,0000,,《Мына жігіттер үшін
Dialogue: 0,0:47:41.09,0:47:45.10,Default,,0000,0000,0000,,Футбол дегеніміз не? 》
Dialogue: 0,0:47:45.10,0:47:48.10,Default,,0000,0000,0000,,《Арман? Өмірдің өзі? 》
Dialogue: 0,0:47:48.10,0:47:53.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:47:53.07,0:47:55.07,Default,,0000,0000,0000,,Гагамару
Dialogue: 0,0:47:53.07,0:47:55.07,Default,,0000,0000,0000,,Алға, Гагамару!
Dialogue: 0,0:47:55.07,0:48:00.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:48:00.08,0:48:02.08,Default,,0000,0000,0000,,О, қандай ұят!
Dialogue: 0,0:48:02.08,0:48:04.08,Default,,0000,0000,0000,,Моккай!
Dialogue: 0,0:48:06.08,0:48:10.09,Default,,0000,0000,0000,,Аа... Керемет! Қызық!
Dialogue: 0,0:48:10.09,0:48:13.09,Default,,0000,0000,0000,,Сәлем Наги! Қазір жасайық!
Dialogue: 0,0:48:13.09,0:48:15.09,Default,,0000,0000,0000,,Иә? Бұл өте қиын.
Dialogue: 0,0:48:15.09,0:48:20.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:48:20.10,0:48:24.07,Default,,0000,0000,0000,,《Мен үшін футбол деген не? 》
Dialogue: 0,0:48:24.07,0:48:27.07,Default,,0000,0000,0000,,《Рей патшаның қызметшісі? Уақытты өлтіру? 》
Dialogue: 0,0:48:27.07,0:48:29.07,Default,,0000,0000,0000,,《Мен мүлде түсінбеймін》
Dialogue: 0,0:48:29.07,0:48:31.07,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:48:37.08,0:48:39.05,Default,,0000,0000,0000,,
Dialogue: 0,0:48:43.09,0:48:46.06,Default,,0000,0000,0000,,Бұл оңай. Неліктен мұндай нәрсені алып тастайсыз?
Dialogue: 0,0:48:48.13,0:48:51.06,Default,,0000,0000,0000,,Керемет гол Наги! Дәл сурет сияқты!
Dialogue: 0,0:48:51.06,0:48:54.06,Default,,0000,0000,0000,,Рейу Мен жай ғана босаңсуыма болады ма?
Dialogue: 0,0:48:54.06,0:48:57.07,Default,,0000,0000,0000,,Әлі жоқ. Тағы 5 ұпай алсам екен.
Dialogue: 0,0:48:57.07,0:48:59.07,Default,,0000,0000,0000,,Иә... 4 ұпай жеткілікті ме?
Dialogue: 0,0:49:02.11,0:49:04.11,Default,,0000,0000,0000,,Бір ғана ұпай алынды!
Dialogue: 0,0:49:04.11,0:49:07.08,Default,,0000,0000,0000,,Шабуыл жасайық! Намузо!
Dialogue: 0,0:49:04.11,0:49:07.08,Default,,0000,0000,0000,,Раичи
Dialogue: 0,0:49:04.11,0:49:07.08,Default,,0000,0000,0000,,Джинго
Dialogue: 0,0:49:04.11,0:49:07.08,Default,,0000,0000,0000,,Бізде мұны істеуден басқа амал жоқ!
Dialogue: 0,0:49:07.08,0:49:09.08,Default,,0000,0000,0000,,
Dialogue: 0,0:49:07.08,0:49:09.08,Default,,0000,0000,0000,,Кунигами
Dialogue: 0,0:49:07.08,0:49:09.08,Default,,0000,0000,0000,,Ұлттық Құдай!
Dialogue: 0,0:49:09.08,0:49:11.05,Default,,0000,0000,0000,,Көрінбейтін белгілері жоқ, біртіндеп өршіп бара жатқан ауру сияқты—
Dialogue: 0,0:49:14.08,0:49:17.09,Default,,0000,0000,0000,,Сіз әлі де ауқымнан тыссыз ба?
Dialogue: 0,0:49:17.09,0:49:19.09,Default,,0000,0000,0000,,Кунигами Кинни-кун!
Dialogue: 0,0:49:19.09,0:49:21.09,Default,,0000,0000,0000,,Қарғыс атсын...! Күте тұрыңыз, мені жіберіңіз!
Dialogue: 0,0:49:21.09,0:49:23.09,Default,,0000,0000,0000,,Кеттік, Наги!
Dialogue: 0,0:49:23.09,0:49:25.10,Default,,0000,0000,0000,,Бұрынғыдай траектория...!
Dialogue: 0,0:49:25.10,0:49:27.10,Default,,0000,0000,0000,,Тоқта! Раиичи Игагури!
Dialogue: 0,0:49:27.10,0:49:30.10,Default,,0000,0000,0000,,Мен оны аламын!
Dialogue: 0,0:49:27.10,0:49:30.10,Default,,0000,0000,0000,,Дәл солай!
Dialogue: 0,0:49:30.10,0:49:34.10,Default,,0000,0000,0000,,《Шабуылшы деген не... Гол деген не? 》
Dialogue: 0,0:49:34.10,0:49:37.11,Default,,0000,0000,0000,,《Жеңіс шынымен маңызды ма? 》
Dialogue: 0,0:49:37.11,0:49:40.08,Default,,0000,0000,0000,,《Ойлау азап болса да, мен әлі де ойлаймын》
Dialogue: 0,0:49:41.08,0:49:43.08,Default,,0000,0000,0000,,
Dialogue: 0,0:49:44.08,0:49:48.09,Default,,0000,0000,0000,,Шынайы ма?
Dialogue: 0,0:49:44.08,0:49:48.09,Default,,0000,0000,0000,,Не... бұл не? Бұл.
Dialogue: 0,0:49:48.09,0:49:50.09,Default,,0000,0000,0000,,Бұл тұрарлық емес!
Dialogue: 0,0:49:50.09,0:49:53.12,Default,,0000,0000,0000,,《Мен қазір біраз оғашпын.》
Dialogue: 0,0:49:53.12,0:49:58.10,Default,,0000,0000,0000,,Нарухая
Dialogue: 0,0:49:53.12,0:49:58.10,Default,,0000,0000,0000,,Жоқ... 2-0!
Dialogue: 0,0:49:53.12,0:49:58.10,Default,,0000,0000,0000,,Енді жоспарды орындау мүмкін емес!
Dialogue: 0,0:49:58.10,0:50:00.10,Default,,0000,0000,0000,,
Dialogue: 0,0:50:00.10,0:50:02.17,Default,,0000,0000,0000,,Жыртылу
Dialogue: 0,0:50:00.10,0:50:02.17,Default,,0000,0000,0000,,Бар, ұсақта!
Dialogue: 0,0:50:00.10,0:50:02.17,Default,,0000,0000,0000,,Гиома
Dialogue: 0,0:50:00.10,0:50:02.17,Default,,0000,0000,0000,,О!
Dialogue: 0,0:50:02.17,0:50:04.13,Default,,0000,0000,0000,,⚞Бүйір жағында! Алыңыз!
Dialogue: 0,0:50:07.10,0:50:09.07,Default,,0000,0000,0000,,Керемет Зантецу!
Dialogue: 0,0:50:09.07,0:50:11.11,Default,,0000,0000,0000,,Мен аламын! Наги өтеді!
Dialogue: 0,0:50:11.11,0:50:13.08,Default,,0000,0000,0000,,Қияметсіз...! Мен де барамын!
Dialogue: 0,0:50:13.08,0:50:15.15,Default,,0000,0000,0000,,Егер...→
Dialogue: 0,0:50:15.15,0:50:18.08,Default,,0000,0000,0000,,Зантецу! Бұл сіздің территорияңыз.
Dialogue: 0,0:50:18.08,0:50:20.08,Default,,0000,0000,0000,,Қайт, Нарихая!
Dialogue: 0,0:50:20.08,0:50:22.09,Default,,0000,0000,0000,,Иә... Бұл менікі →
Dialogue: 0,0:50:22.09,0:50:24.09,Default,,0000,0000,0000,,Территория!
Dialogue: 0,0:50:25.09,0:50:29.09,Default,,0000,0000,0000,,
Dialogue: 0,0:50:25.09,0:50:29.09,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:50:29.09,0:50:32.06,Default,,0000,0000,0000,,Рей патша
Dialogue: 0,0:50:29.09,0:50:32.06,Default,,0000,0000,0000,,Территория деген нені білдіреді?
Dialogue: 0,0:50:32.06,0:50:36.07,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:50:32.06,0:50:36.07,Default,,0000,0000,0000,,Күні
Dialogue: 0,0:50:32.06,0:50:36.07,Default,,0000,0000,0000,,Сәнді көзілдірік кию сізді ақылды етпейді.
Dialogue: 0,0:50:36.07,0:50:38.07,Default,,0000,0000,0000,,Бака Зантецу.
Dialogue: 0,0:50:39.07,0:50:43.11,Default,,0000,0000,0000,,Мен әлі де кете аламын...
Dialogue: 0,0:50:39.07,0:50:43.11,Default,,0000,0000,0000,,Наму Ами… Будданың жақын көрінісі….
Dialogue: 0,0:50:43.11,0:50:45.08,Default,,0000,0000,0000,,Хэхе….
Dialogue: 0,0:50:45.08,0:50:49.08,Default,,0000,0000,0000,,Иә, иә, соңы бітті.
Dialogue: 0,0:50:45.08,0:50:49.08,Default,,0000,0000,0000,,Соңында барлық командалар бірдей!
Dialogue: 0,0:50:49.08,0:50:51.08,Default,,0000,0000,0000,,Бае~!
Dialogue: 0,0:50:51.08,0:50:54.08,Default,,0000,0000,0000,,《Мына жігіттер бірдей ме》
Dialogue: 0,0:50:54.08,0:50:57.09,Default,,0000,0000,0000,,《Бұл не...?
Dialogue: 0,0:50:54.08,0:50:57.09,Default,,0000,0000,0000,,Мен әлі абдырап жүрмін》
Dialogue: 0,0:50:59.09,0:51:03.09,Default,,0000,0000,0000,,Лайк басыңыз! Көңілді болып барады!
Dialogue: 0,0:51:06.10,0:51:09.10,Default,,0000,0000,0000,,Не? Сол жігіт.
Dialogue: 0,0:51:06.10,0:51:09.10,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:51:09.10,0:51:12.10,Default,,0000,0000,0000,,Хараку...? Сіз не айттыңыз? сен.
Dialogue: 0,0:51:12.10,0:51:16.11,Default,,0000,0000,0000,,Не? Өйткені
Dialogue: 0,0:51:12.10,0:51:16.11,Default,,0000,0000,0000,,Бұл шынымен де ғажап емес пе? Сол үш адам!
Dialogue: 0,0:51:16.11,0:51:18.07,Default,,0000,0000,0000,,Агару Агару!
Dialogue: 0,0:51:18.07,0:51:21.08,Default,,0000,0000,0000,,Иә? Қазірдің өзінде 3-0, солай ма?
Dialogue: 0,0:51:18.07,0:51:21.08,Default,,0000,0000,0000,,Осылай істей берсең...
Dialogue: 0,0:51:21.08,0:51:24.08,Default,,0000,0000,0000,,А... Киёши: қорқып тұрсың ба?
Dialogue: 0,0:51:26.08,0:51:29.09,Default,,0000,0000,0000,,Шынында да, олардың мақсаты
Dialogue: 0,0:51:26.08,0:51:29.09,Default,,0000,0000,0000,,Бұл өте ерекше.
Dialogue: 0,0:51:29.09,0:51:32.09,Default,,0000,0000,0000,,
Dialogue: 0,0:51:29.09,0:51:32.09,Default,,0000,0000,0000,,Бұл оңай болар еді.
Dialogue: 0,0:51:32.09,0:51:34.09,Default,,0000,0000,0000,,Бұл да...→
Dialogue: 0,0:51:34.09,0:51:37.06,Default,,0000,0000,0000,,Бұл өте ерекше болады деп үміттенемін!
Dialogue: 0,0:51:39.10,0:51:44.10,Default,,0000,0000,0000,,Қару, теңдеу, т.б.
Dialogue: 0,0:51:39.10,0:51:44.10,Default,,0000,0000,0000,,max→ қолдансаңыз да бұл мүмкін емес
Dialogue: 0,0:51:44.10,0:51:49.07,Default,,0000,0000,0000,,Осы жігіттерден гол соққанда
Dialogue: 0,0:51:44.10,0:51:49.07,Default,,0000,0000,0000,,Сіз өз шектеулеріңізден асып жатырсыз, солай ма?
Dialogue: 0,0:51:49.07,0:51:51.07,Default,,0000,0000,0000,,дейді ішімдегі құбыжық.
Dialogue: 0,0:51:51.07,0:51:56.08,Default,,0000,0000,0000,,``Егер сіз шарасыз жағдайда болсаңыз, бұл қорқатын жер емес.
Dialogue: 0,0:51:51.07,0:51:56.08,Default,,0000,0000,0000,,Қызықты жер»!
Dialogue: 0,0:51:57.08,0:52:00.08,Default,,0000,0000,0000,,Бұл қызық. Кел, Хачираку Кай!
Dialogue: 0,0:52:00.08,0:52:02.05,Default,,0000,0000,0000,,Айо. Соқыңыз!
Dialogue: 0,0:52:03.09,0:52:06.09,Default,,0000,0000,0000,,《Ой... өте жылдам қайшы! 》
Dialogue: 0,0:52:06.09,0:52:08.09,Default,,0000,0000,0000,,《Ол сол жаққа ұқсайды, бірақ бұл оң! 》
Dialogue: 0,0:52:08.09,0:52:10.09,Default,,0000,0000,0000,,《Аа...》
Dialogue: 0,0:52:11.09,0:52:13.06,Default,,0000,0000,0000,,《Рулетканы айналдыру! ? 》
Dialogue: 0,0:52:13.06,0:52:15.10,Default,,0000,0000,0000,,Зантецу!
Dialogue: 0,0:52:15.10,0:52:17.07,Default,,0000,0000,0000,,Саған шаш еткізуге рұқсат етемін бе?
Dialogue: 0,0:52:17.07,0:52:19.07,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:52:17.07,0:52:19.07,Default,,0000,0000,0000,,Жылдамдық көзілдірігі! Олай болса...
Dialogue: 0,0:52:21.07,0:52:24.07,Default,,0000,0000,0000,,《Цикл?
Dialogue: 0,0:52:21.07,0:52:24.07,Default,,0000,0000,0000,,Егер сіз мұнымен жақсы болсаңыз, менде өз үлесім бар.
Dialogue: 0,0:52:25.11,0:52:27.08,Default,,0000,0000,0000,,《Сыртта? Сол жақ?》
Dialogue: 0,0:52:27.08,0:52:29.08,Default,,0000,0000,0000,,《Дұрыс! ? 》
Dialogue: 0,0:52:27.08,0:52:29.08,Default,,0000,0000,0000,,Қат!
Dialogue: 0,0:52:29.08,0:52:31.08,Default,,0000,0000,0000,,《Әуе серпімділігі! ? 》
Dialogue: 0,0:52:31.08,0:52:34.08,Default,,0000,0000,0000,,Орындалды! Ойға бір сурет келеді.
Dialogue: 0,0:52:34.08,0:52:37.09,Default,,0000,0000,0000,,《Уау... Бұл не?
Dialogue: 0,0:52:37.09,0:52:39.09,Default,,0000,0000,0000,,Кешіріңіз! Құдай-ау, мен кеттім!
Dialogue: 0,0:52:39.09,0:52:42.13,Default,,0000,0000,0000,,Мақсатқа жету үшін небәрі 3 адам қалды!
Dialogue: 0,0:52:42.13,0:52:44.09,Default,,0000,0000,0000,,Барлығын бірден үш адаммен қиратыңыз!
Dialogue: 0,0:52:44.09,0:52:47.10,Default,,0000,0000,0000,,Лайк басыңыз!
Dialogue: 0,0:52:44.09,0:52:47.10,Default,,0000,0000,0000,,Қалай болғанда да, біз →
Dialogue: 0,0:52:47.10,0:52:50.10,Default,,0000,0000,0000,,Әлемнің үздік шабуылшысы болу
Dialogue: 0,0:52:47.10,0:52:50.10,Default,,0000,0000,0000,,Мен осындамын!
Dialogue: 0,0:52:50.10,0:52:54.07,Default,,0000,0000,0000,,Балалар мен сендерді жеңе алуым керек.
Dialogue: 0,0:52:50.10,0:52:54.07,Default,,0000,0000,0000,,Бұрын Страйкер болатын!
Dialogue: 0,0:52:56.11,0:52:58.11,Default,,0000,0000,0000,,Тағы үшеуі бар...
Dialogue: 0,0:52:58.11,0:53:01.08,Default,,0000,0000,0000,,2… 1….
Dialogue: 0,0:53:01.08,0:53:07.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:53:07.12,0:53:09.09,Default,,0000,0000,0000,,Қайырлы күн!
Dialogue: 0,0:53:10.09,0:53:12.09,Default,,0000,0000,0000,,Қандай әзіл...!
Dialogue: 0,0:53:14.09,0:53:16.09,Default,,0000,0000,0000,,
Dialogue: 0,0:53:17.13,0:53:19.10,Default,,0000,0000,0000,,Уау! Туған күнің құтты болсын! !
Dialogue: 0,0:53:19.10,0:53:21.10,Default,,0000,0000,0000,,Лабона! ?
Dialogue: 0,0:53:19.10,0:53:21.10,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:53:21.10,0:53:25.10,Default,,0000,0000,0000,,Көрдіңіз бе? Менің ерекше мақсатым!
Dialogue: 0,0:53:25.10,0:53:28.07,Default,,0000,0000,0000,,Қараңызшы, қызық бола бастады, солай емес пе?
Dialogue: 0,0:53:28.07,0:53:30.11,Default,,0000,0000,0000,,《«Көңіл көтеру»...? 》
Dialogue: 0,0:53:30.11,0:53:34.08,Default,,0000,0000,0000,,《Мен мұны ешқашан қызық деп ойламаппын...》
Dialogue: 0,0:53:35.08,0:53:39.08,Default,,0000,0000,0000,,Олар... күйзеліп жатыр ма?
Dialogue: 0,0:53:39.08,0:53:42.09,Default,,0000,0000,0000,,«Біз оны жеңдік».
Dialogue: 0,0:53:39.08,0:53:42.09,Default,,0000,0000,0000,,Бака Зантецу.
Dialogue: 0,0:53:42.09,0:53:45.12,Default,,0000,0000,0000,,Бұл қызық. Мен оны толығымен жоямын.
Dialogue: 0,0:53:45.12,0:53:47.09,Default,,0000,0000,0000,,Иә~ Бұл азап...
Dialogue: 0,0:53:47.09,0:53:50.06,Default,,0000,0000,0000,,Кеттік! Тағы бір нүкте!
Dialogue: 0,0:53:47.09,0:53:50.06,Default,,0000,0000,0000,,О!
Dialogue: 0,0:53:50.06,0:53:54.10,Default,,0000,0000,0000,,Неге сонша толқыдың? Сол жігіттер.
Dialogue: 0,0:53:54.10,0:53:56.07,Default,,0000,0000,0000,,Қазір ғана өлім аузында тұрсам да.
Dialogue: 0,0:53:56.07,0:53:58.07,Default,,0000,0000,0000,,Иә? Рейоу сен ашулысың ба?
Dialogue: 0,0:53:58.07,0:54:00.10,Default,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:53:58.07,0:54:00.10,Default,,0000,0000,0000,,
Dialogue: 0,0:54:00.10,0:54:06.11,Default,,0000,0000,0000,,Дегенмен, жарты жыл бойы футбол ойнаған Наги екеуміздің жеңілмеген рекордымыз бар.
Dialogue: 0,0:54:00.10,0:54:06.11,Default,,0000,0000,0000,,Мен жәй ғана жарақат алғым келмейді.
Dialogue: 0,0:54:06.11,0:54:09.08,Default,,0000,0000,0000,,Раиичи! Рейоны жеке бақылаңыз!
Dialogue: 0,0:54:09.08,0:54:11.08,Default,,0000,0000,0000,,Ха! ? Бұл не!
Dialogue: 0,0:54:11.08,0:54:14.08,Default,,0000,0000,0000,,Сіз және сіздің үлкен дене бітіміңіз менің арамызда қалды!
Dialogue: 0,0:54:14.08,0:54:17.09,Default,,0000,0000,0000,,Менің сексуалды футболым
Dialogue: 0,0:54:14.08,0:54:17.09,Default,,0000,0000,0000,,Бұл мүмкін емес позиция емес пе?
Dialogue: 0,0:54:17.09,0:54:19.09,Default,,0000,0000,0000,,Мен мұны істеймін, қарғыс атсын!
Dialogue: 0,0:54:19.09,0:54:21.09,Default,,0000,0000,0000,,Оның орнына, егер сіз жоғалтсаңыз→
Dialogue: 0,0:54:21.09,0:54:24.06,Default,,0000,0000,0000,,Мен өз отбасымды аңдып, өлтіремін.
Dialogue: 0,0:54:21.09,0:54:24.06,Default,,0000,0000,0000,,Балалар!
Dialogue: 0,0:54:24.06,0:54:28.10,Default,,0000,0000,0000,,Түбірлері бар түрі танымал емес. Кесілген тістер.
Dialogue: 0,0:54:28.10,0:54:30.07,Default,,0000,0000,0000,,Make noise!
Dialogue: 0,0:54:30.07,0:54:33.10,Default,,0000,0000,0000,,Осындай ойында... Қорғаушы ретінде...→
Dialogue: 0,0:54:33.10,0:54:36.07,Default,,0000,0000,0000,,Мен футбол өмірімнің аяқталуын күте алмаймын!
Dialogue: 0,0:54:38.11,0:54:41.08,Default,,0000,0000,0000,,《Мүмкін бұл жігіттер білетін шығар》
Dialogue: 0,0:54:44.08,0:54:47.08,Default,,0000,0000,0000,,Зантецу!
Dialogue: 0,0:54:44.08,0:54:47.08,Default,,0000,0000,0000,,Оны маған қалдырыңыз.
Dialogue: 0,0:54:47.08,0:54:50.09,Default,,0000,0000,0000,,《Менің шатасуымның шынайы табиғаты》
Dialogue: 0,0:54:51.15,0:54:53.16,Default,,0000,0000,0000,,Жарайды, рұқсатты өткізіп алдыңыз!
Dialogue: 0,0:54:57.06,0:55:00.13,Default,,0000,0000,0000,,《Ыстық болу себебі...》
Dialogue: 0,0:55:00.13,0:55:02.07,Default,,0000,0000,0000,,Аһ...!
Dialogue: 0,0:55:00.13,0:55:02.07,Default,,0000,0000,0000,,Иемон
Dialogue: 0,0:55:00.13,0:55:02.07,Default,,0000,0000,0000,,Окухито
Dialogue: 0,0:55:00.13,0:55:02.07,Default,,0000,0000,0000,,Игагури! ?
Dialogue: 0,0:55:02.07,0:55:05.07,Default,,0000,0000,0000,,Мен оны тоқтаттым! !
Dialogue: 0,0:55:08.07,0:55:11.07,Default,,0000,0000,0000,,Цк... тоқта!
Dialogue: 0,0:55:08.07,0:55:11.07,Default,,0000,0000,0000,,Олардың атыс алаңына басып кіруіне жол берме!
Dialogue: 0,0:55:13.08,0:55:15.08,Default,,0000,0000,0000,,өту, Кунигами!
Dialogue: 0,0:55:16.08,0:55:18.08,Default,,0000,0000,0000,,Қорықпа, Кунигами! Ұрыс! !
Dialogue: 0,0:55:18.08,0:55:21.08,Default,,0000,0000,0000,,Сіз суперқаһарман боласыз! ?
Dialogue: 0,0:55:21.08,0:55:34.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:55:34.10,0:55:36.10,Default,,0000,0000,0000,,
Dialogue: 0,0:55:36.10,0:55:39.07,Default,,0000,0000,0000,,Жарайды! !
Dialogue: 0,0:55:41.10,0:55:43.07,Default,,0000,0000,0000,,
Dialogue: 0,0:55:45.08,0:55:47.08,Default,,0000,0000,0000,,Дереу... Гагамару!
Dialogue: 0,0:55:47.08,0:55:59.19,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:55:59.19,0:56:02.09,Default,,0000,0000,0000,,Не істеп жатырсың?
Dialogue: 0,0:55:59.19,0:56:02.09,Default,,0000,0000,0000,,Тез оралыңыз!
Dialogue: 0,0:56:02.09,0:56:04.09,Default,,0000,0000,0000,,Қарғыс атсын... Кешіріңіз!
Dialogue: 0,0:56:04.09,0:56:06.10,Default,,0000,0000,0000,,《Білгім келеді...》
Dialogue: 0,0:56:07.10,0:56:09.10,Default,,0000,0000,0000,,Футбол ойнамаңыз!
Dialogue: 0,0:56:09.10,0:56:15.07,Default,,0000,0000,0000,,《Көк жартасқа жиналды
Dialogue: 0,0:56:09.10,0:56:15.07,Default,,0000,0000,0000,,Ереуілшілердің эгосы》
Dialogue: 0,0:56:18.11,0:56:23.08,Default,,0000,0000,0000,,Дәл мен ойлағандай
Dialogue: 0,0:56:18.11,0:56:23.08,Default,,0000,0000,0000,,Бұл шайқас болды, Ешін-сан.
Dialogue: 0,0:56:23.08,0:56:25.08,Default,,0000,0000,0000,,Иә, ыстық.
Dialogue: 0,0:56:25.08,0:56:28.08,Default,,0000,0000,0000,,Жең немесе жеңіл, тірі немесе өл.
Dialogue: 0,0:56:28.08,0:56:34.09,Default,,0000,0000,0000,,Өлім сызығын сол төтенше күйде өткен сайын
Dialogue: 0,0:56:28.08,0:56:34.09,Default,,0000,0000,0000,,Шабуылшы оятуға мәжбүр.
Dialogue: 0,0:56:34.09,0:56:37.09,Default,,0000,0000,0000,,Менің көргім келгені осы болды.
Dialogue: 0,0:56:37.09,0:56:40.10,Default,,0000,0000,0000,,Анри-чан Айтпақшы
Dialogue: 0,0:56:37.09,0:56:40.10,Default,,0000,0000,0000,,Оянудың не екенін білесің бе?
Dialogue: 0,0:56:40.10,0:56:42.10,Default,,0000,0000,0000,,Не? Ерм...→
Dialogue: 0,0:56:42.10,0:56:45.07,Default,,0000,0000,0000,,Қарапайым адамдар суперадамға айналады
Dialogue: 0,0:56:42.10,0:56:45.07,Default,,0000,0000,0000,,Сіз бұл туралы айтып отырсыз, солай ма?
Dialogue: 0,0:56:45.07,0:56:47.10,Default,,0000,0000,0000,,Супер Сай... бір нәрсе.
Dialogue: 0,0:56:47.10,0:56:50.11,Default,,0000,0000,0000,,Иә, мүлде емес.
Dialogue: 0,0:56:50.11,0:56:54.08,Default,,0000,0000,0000,,Бұл әлі табысқа жете алмаған адамдарға арналған.
Dialogue: 0,0:56:50.11,0:56:54.08,Default,,0000,0000,0000,,Бұл жай ғана адамдар армандайтын ақымақ адасу.
Dialogue: 0,0:56:54.08,0:56:56.08,Default,,0000,0000,0000,,Бах...!
Dialogue: 0,0:56:56.08,0:57:01.08,Default,,0000,0000,0000,,Ояну дегеніміз не?
Dialogue: 0,0:56:56.08,0:57:01.08,Default,,0000,0000,0000,,Ойлар мен тәжірибелердің жинақталуынан туындайтын жұмбақ.
Dialogue: 0,0:57:01.08,0:57:06.09,Default,,0000,0000,0000,,Қайталанатын сәтсіздіктерден және сынақ пен қателіктен кейін
Dialogue: 0,0:57:01.08,0:57:06.09,Default,,0000,0000,0000,,Төтенше жағдайға тап болған кезде әлі де жеңіске ұмтылу →
Dialogue: 0,0:57:06.09,0:57:11.09,Default,,0000,0000,0000,,Бір кездері бөлек болған жетістік бөліктері енді бір-бірімен түйіседі
Dialogue: 0,0:57:06.09,0:57:11.09,Default,,0000,0000,0000,,Эго гүлдейді.
Dialogue: 0,0:57:11.09,0:57:14.10,Default,,0000,0000,0000,,Басқаша айтқанда, ояту дегеніміз не→
Dialogue: 0,0:57:14.10,0:57:17.07,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:57:14.10,0:57:17.07,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:57:14.10,0:57:17.07,Default,,0000,0000,0000,,Бұл сіз өзіңіз туралы білетін сәт.
Dialogue: 0,0:57:18.10,0:57:20.07,Default,,0000,0000,0000,,Бұл мүлдем жақсы емес.
Dialogue: 0,0:57:20.07,0:57:23.07,Default,,0000,0000,0000,,Ол сондай стильді еді
Dialogue: 0,0:57:20.07,0:57:23.07,Default,,0000,0000,0000,,Неге атпадың?
Dialogue: 0,0:57:23.07,0:57:26.08,Default,,0000,0000,0000,,Сен, ысырап көп.
Dialogue: 0,0:57:30.08,0:57:36.09,Default,,0000,0000,0000,,Неге бас тартпайсың?
Dialogue: 0,0:57:30.08,0:57:36.09,Default,,0000,0000,0000,,Неліктен сіз әлі де жолдасыз?
Dialogue: 0,0:57:36.09,0:57:41.09,Default,,0000,0000,0000,,Эй, айтшы.
Dialogue: 0,0:57:36.09,0:57:41.09,Default,,0000,0000,0000,,Сізді сонша итермелейтін не?
Dialogue: 0,0:57:42.13,0:57:47.10,Default,,0000,0000,0000,,Шу шығар, данышпан...
Dialogue: 0,0:57:42.13,0:57:47.10,Default,,0000,0000,0000,,Енді бұл жақсы жер!
Dialogue: 0,0:57:50.10,0:57:53.10,Default,,0000,0000,0000,,Иә... ашуландым...
Dialogue: 0,0:57:53.10,0:57:56.11,Default,,0000,0000,0000,,Не? Сол жаратылыс.
Dialogue: 0,0:57:56.11,0:57:59.08,Default,,0000,0000,0000,,Жүр, қыз! БУТЧИГИР!
Dialogue: 0,0:58:03.08,0:58:07.08,Default,,0000,0000,0000,,Байқап көр, қыз. Мен жылдамырақпын.
Dialogue: 0,0:58:07.08,0:58:09.09,Default,,0000,0000,0000,,Сіз жас келіншек емессіз.
Dialogue: 0,0:58:10.09,0:58:12.09,Default,,0000,0000,0000,,Эй Дон, менімен бірге!
Dialogue: 0,0:58:12.09,0:58:18.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:58:18.06,0:58:22.07,Default,,0000,0000,0000,,《Е...
Dialogue: 0,0:58:18.06,0:58:22.07,Default,,0000,0000,0000,,Zantetsu ең жоғары жылдамдықтан жеңілді》
Dialogue: 0,0:58:24.07,0:58:26.07,Default,,0000,0000,0000,,Алыс жүріңдер, баяу адамдар!
Dialogue: 0,0:58:29.07,0:58:31.07,Default,,0000,0000,0000,,
Dialogue: 0,0:58:32.11,0:58:35.08,Default,,0000,0000,0000,,Ик! (Адамдар айқайлап жатыр)
Dialogue: 0,0:58:32.11,0:58:35.08,Default,,0000,0000,0000,,Ша! Мен жеттім!
Dialogue: 0,0:58:37.08,0:58:39.08,Default,,0000,0000,0000,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:58:39.08,0:58:43.05,Default,,0000,0000,0000,,10 қарсыласынан жеңілу?
Dialogue: 0,0:58:39.08,0:58:43.05,Default,,0000,0000,0000,,Ұялмайсың ба, сегізаяқ?
Dialogue: 0,0:58:45.09,0:58:48.06,Default,,0000,0000,0000,,Үніңді жап, қоқыс...!
Dialogue: 0,0:58:49.09,0:58:51.09,Default,,0000,0000,0000,,《Рей патша асығып жатыр》
Dialogue: 0,0:58:55.10,0:58:58.10,Default,,0000,0000,0000,,Мен мұндай жерде жеңілуге шыдай алмаймын...
Dialogue: 0,0:58:58.10,0:59:02.11,Default,,0000,0000,0000,,Біз... Мен және Наги ең күштіміз!
Dialogue: 0,0:59:02.11,0:59:04.07,Default,,0000,0000,0000,,
Dialogue: 0,0:59:08.08,0:59:13.08,Default,,0000,0000,0000,,Сіз жоғалтудан қорқасыз ба?
Dialogue: 0,0:59:08.08,0:59:13.08,Default,,0000,0000,0000,,Жеңілмейтін жылыжай өсімі!
Dialogue: 0,0:59:13.08,0:59:18.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:59:18.09,0:59:22.09,Default,,0000,0000,0000,,Бірінші рет жеңіліс
Dialogue: 0,0:59:18.09,0:59:22.09,Default,,0000,0000,0000,,Мен оны алып кетемін!
Dialogue: 0,0:59:25.09,0:59:27.10,Default,,0000,0000,0000,,Қияметсіз...!
Dialogue: 0,0:59:27.10,0:59:32.07,Default,,0000,0000,0000,,《Біз... Наги екеуміз жеңілеміз...! ? 》
Dialogue: 0,0:59:34.10,0:59:37.11,Default,,0000,0000,0000,,《Рей патшаның да түрі бар...》
Dialogue: 0,0:59:49.12,0:59:51.12,Default,,0000,0000,0000,,Оны маған беріңіз! Король Линг!
Dialogue: 0,0:59:51.12,0:59:53.09,Default,,0000,0000,0000,,Наги...!
Dialogue: 0,0:59:57.09,1:00:02.07,Default,,0000,0000,0000,,《Иә? Мен тағы да бар күшімді саламын...
Dialogue: 0,1:00:02.07,1:00:05.10,Default,,0000,0000,0000,,《Себебі мен жеңілетінімді бірінші рет сезіндім бе? 》
Dialogue: 0,1:00:05.10,1:00:11.07,Default,,0000,0000,0000,,《Бұны қиын деп ойлағандар
Dialogue: 0,1:00:05.10,1:00:11.07,Default,,0000,0000,0000,,Керемет көрінгендіктен...? 》
Dialogue: 0,1:00:11.07,1:00:14.08,Default,,0000,0000,0000,,《Бұл қиын болуы керек...》
Dialogue: 0,1:00:15.08,1:00:20.08,Default,,0000,0000,0000,,Рейу... Мен тырысамын.
Dialogue: 0,1:00:21.08,1:00:23.05,Default,,0000,0000,0000,,Наги...?
Dialogue: 0,1:00:24.09,1:00:28.09,Default,,0000,0000,0000,,Кенеттен не болды?
Dialogue: 0,1:00:24.09,1:00:28.09,Default,,0000,0000,0000,,Бұл жігіттің дриблинг сияқты қаруы бар ма? ?
Dialogue: 0,1:00:28.09,1:00:32.06,Default,,0000,0000,0000,,《Дене бастың алдында жүгіреді》
Dialogue: 0,1:00:36.07,1:00:39.10,Default,,0000,0000,0000,,《Қарғыс атсын... Көзіңді төбеңнен алып, беліңді кесіп ал! ? 》
Dialogue: 0,1:00:39.10,1:00:42.07,Default,,0000,0000,0000,,Өтінемін, Имамура!
Dialogue: 0,1:00:39.10,1:00:42.07,Default,,0000,0000,0000,,Жарайды, маған ер!
Dialogue: 0,1:00:42.07,1:00:46.04,Default,,0000,0000,0000,,《Ақыл денеге қарағанда тездетеді》
Dialogue: 0,1:00:51.08,1:00:53.05,Default,,0000,0000,0000,,《Сен маған қарамайсың...》
Dialogue: 0,1:00:57.09,1:01:01.09,Default,,0000,0000,0000,,《Мен бұл қызығушылықты растағым келеді》
Dialogue: 0,1:01:01.09,1:01:04.09,Default,,0000,0000,0000,,Түсірілім келе жатыр! Кіріңіз!
Dialogue: 0,1:01:01.09,1:01:04.09,Default,,0000,0000,0000,,Блок!
Dialogue: 0,1:01:05.09,1:01:10.10,Default,,0000,0000,0000,,《Мен футбол ойнаймын...→
Dialogue: 0,1:01:10.10,1:01:12.10,Default,,0000,0000,0000,,Мен сені сынағым келеді! 》
Dialogue: 0,1:01:12.10,1:01:17.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:01:17.07,1:01:19.08,Default,,0000,0000,0000,,
Dialogue: 0,1:01:19.08,1:01:25.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:01:25.08,1:01:30.09,Default,,0000,0000,0000,,《Маған не болды... Қызып бара жатырмын》
Dialogue: 0,1:01:30.09,1:01:34.09,Default,,0000,0000,0000,,Наги! сен….
Dialogue: 0,1:01:30.09,1:01:34.09,Default,,0000,0000,0000,,Сәлем, Рей патша.
Dialogue: 0,1:01:34.09,1:01:38.06,Default,,0000,0000,0000,,Футбол қызық емес пе?
Dialogue: 0,1:01:41.10,1:01:43.07,Default,,0000,0000,0000,,Тағы қанша ұпай аламын?
Dialogue: 0,1:01:44.10,1:01:49.11,Default,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,1:01:44.10,1:01:49.11,Default,,0000,0000,0000,,15 минутта жағдайды өзгертпесек, бәрі бітеді!
Dialogue: 0,1:01:49.11,1:01:52.11,Default,,0000,0000,0000,,Өлгенше шабуылда! Бір-біріңді атып тастаңдар, ақымақ!
Dialogue: 0,1:01:52.11,1:01:55.11,Default,,0000,0000,0000,,Балалар, сендер шабуылшыларсыңдар!
Dialogue: 0,1:02:00.12,1:02:03.09,Default,,0000,0000,0000,,Ол әлі өлмеген сияқты...
Dialogue: 0,1:02:03.09,1:02:05.09,Default,,0000,0000,0000,,Тағы бір мәселе, Наги.
Dialogue: 0,1:02:05.09,1:02:08.12,Default,,0000,0000,0000,,Егер бізге тағы бір ұпай керек болса, біз жеңе аламыз...
Dialogue: 0,1:02:08.12,1:02:11.09,Default,,0000,0000,0000,,Жарайсың бастық.
Dialogue: 0,1:02:11.09,1:02:13.06,Default,,0000,0000,0000,,
Dialogue: 0,1:02:20.10,1:02:23.07,Default,,0000,0000,0000,,Мен аламын, жас ханым.
Dialogue: 0,1:02:26.11,1:02:28.08,Default,,0000,0000,0000,,Бұл тәтті, данышпан.
Dialogue: 0,1:02:28.08,1:02:31.11,Default,,0000,0000,0000,,Егер ұрлағың келсе, мына жер!
Dialogue: 0,1:02:31.11,1:02:35.08,Default,,0000,0000,0000,,《Бұл жігіт... бұрынғыдан өзгерек! 》
Dialogue: 0,1:02:35.08,1:02:37.12,Default,,0000,0000,0000,,Бар, ұсақта!
Dialogue: 0,1:02:37.12,1:02:41.09,Default,,0000,0000,0000,,Жақсы бала, Киёши.
Dialogue: 0,1:02:37.12,1:02:41.09,Default,,0000,0000,0000,,Мен оны кейін шешемін.
Dialogue: 0,1:02:44.09,1:02:46.10,Default,,0000,0000,0000,,Апарып бара жатып тайып кеттім
Dialogue: 0,1:02:44.09,1:02:46.10,Default,,0000,0000,0000,,Хабарлама!
Dialogue: 0,1:02:46.10,1:02:48.10,Default,,0000,0000,0000,,Уша Итадаки!
Dialogue: 0,1:02:49.10,1:02:51.07,Default,,0000,0000,0000,,Қат! Әй...!
Dialogue: 0,1:02:53.10,1:02:55.17,Default,,0000,0000,0000,,Жоқ, біз әлі де шабуылдап, оны жойып жібереміз!
Dialogue: 0,1:02:55.17,1:02:58.17,Default,,0000,0000,0000,,Толқынды шабуыл! ?
Dialogue: 0,1:02:55.17,1:02:58.17,Default,,0000,0000,0000,,Хаа!
Dialogue: 0,1:03:00.11,1:03:02.11,Default,,0000,0000,0000,,Оқу
Dialogue: 0,1:03:00.11,1:03:02.11,Default,,0000,0000,0000,,Болжағандай!
Dialogue: 0,1:03:02.11,1:03:04.08,Default,,0000,0000,0000,,
Dialogue: 0,1:03:06.12,1:03:08.08,Default,,0000,0000,0000,,Уррр!
Dialogue: 0,1:03:09.09,1:03:13.12,Default,,0000,0000,0000,,《Бұл шындап күрескендердің құмарлығы...》
Dialogue: 0,1:03:13.12,1:03:15.09,Default,,0000,0000,0000,,《Бұл футбол...! 》
Dialogue: 0,1:03:16.09,1:03:19.06,Default,,0000,0000,0000,,Қарсылас – Сае Итоси бастаған 20 жасқа дейінгі Жапония құрамасы.
Dialogue: 0,1:03:20.06,1:03:23.10,Default,,0000,0000,0000,,Жеңілсең, Көк жартас жоғалады.
Dialogue: 0,1:03:23.10,1:03:27.07,Default,,0000,0000,0000,,Олардың арасына кіріңіз
Dialogue: 0,1:03:23.10,1:03:27.07,Default,,0000,0000,0000,,Ең бастысы - өз өміріңізді қалай насихаттауға болады!
Dialogue: 0,1:03:28.10,1:03:30.11,Default,,0000,0000,0000,,Сіз А тобының саңылауысыз.
Dialogue: 0,1:03:30.11,1:03:33.11,Default,,0000,0000,0000,,Осы қарқынмен біз ештеңе істей алмай қаламыз!
Dialogue: 0,1:03:33.11,1:03:35.11,Default,,0000,0000,0000,,<Осыдан кейін түн ортасынан бастап→
Dialogue: 0,1:03:35.11,1:03:40.08,Default,,0000,0000,0000,,Телехикаяның екінші маусымы
Dialogue: 0,1:03:35.11,1:03:40.08,Default,,0000,0000,0000,,«Blue Rock VS. U-20 JAPAN» басталуы>
Dialogue: 0,1:03:40.08,1:03:43.05,Default,,0000,0000,0000,,Мен әлемдегі ең үздік шабуылшы боламын! !
Dialogue: 0,1:03:45.05,1:03:52.06,Default,,0000,0000,0000,,《Егер мен дәл қазір осы ашу-ызада гол соқсам...
Dialogue: 0,1:03:45.05,1:03:52.06,Default,,0000,0000,0000,,Маған бұл қаншалықты жақсы әсер етеді...》
Dialogue: 0,1:03:54.06,1:03:56.07,Default,,0000,0000,0000,,
Dialogue: 0,1:03:56.07,1:03:58.07,Default,,0000,0000,0000,,Зантецу! есептегіш!
Dialogue: 0,1:03:58.07,1:04:00.04,Default,,0000,0000,0000,,Мен сені тоқтатамын!
Dialogue: 0,1:04:00.04,1:04:02.04,Default,,0000,0000,0000,,Өкінішті, қызыл шашты қыз.
Dialogue: 0,1:04:02.04,1:04:06.01,Default,,0000,0000,0000,,Дәл қазір... мұнда оянған данышпан бар!
Dialogue: 0,1:04:06.01,1:04:09.01,Default,,0000,0000,0000,,Жақсы Зантецу. Мен оны жиі көретінмін.
Dialogue: 0,1:04:09.01,1:04:11.01,Default,,0000,0000,0000,,Мен де осында деп ойладым...
Dialogue: 0,1:04:14.05,1:04:17.05,Default,,0000,0000,0000,,《Бұл тағы да осы жігіт...! 》
Dialogue: 0,1:04:17.05,1:04:21.02,Default,,0000,0000,0000,,Енді алаңдағы әлсіз жер
Dialogue: 0,1:04:17.05,1:04:21.02,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:04:22.06,1:04:24.03,Default,,0000,0000,0000,,Мен сені жиі көремін.
Dialogue: 0,1:04:24.03,1:04:26.03,Default,,0000,0000,0000,,Мен сенің қашып кетуіңе жол бермеймін!
Dialogue: 0,1:04:26.03,1:04:30.03,Default,,0000,0000,0000,,《Бір тиіп тұрған көзімді бағала
Dialogue: 0,1:04:26.03,1:04:30.03,Default,,0000,0000,0000,,Қорғауға ниетіңіз бар ма...》
Dialogue: 0,1:04:30.03,1:04:34.04,Default,,0000,0000,0000,,《Оңға ма, солға ма? А, енді не істеуім керек? 》
Dialogue: 0,1:04:35.04,1:04:38.01,Default,,0000,0000,0000,,《Импровизация! реакция...! 》
Dialogue: 0,1:04:39.04,1:04:41.04,Default,,0000,0000,0000,,《Тұзақ...! ? 》
Dialogue: 0,1:04:41.04,1:04:45.01,Default,,0000,0000,0000,,《Ой, уау... Мен жасадым, Сенатора! 》
Dialogue: 0,1:04:47.02,1:04:49.02,Default,,0000,0000,0000,,Жоқ! Тоқта!
Dialogue: 0,1:04:47.02,1:04:49.02,Default,,0000,0000,0000,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,1:04:52.02,1:04:56.06,Default,,0000,0000,0000,,《Уау, мен...! Мен мұны істей алдым》
Dialogue: 0,1:04:56.06,1:04:58.06,Default,,0000,0000,0000,,《Супер сезім...》
Dialogue: 0,1:05:02.03,1:05:05.03,Default,,0000,0000,0000,,
Dialogue: 0,1:05:02.03,1:05:05.03,Default,,0000,0000,0000,,«Z командасының бұзылуы»
Dialogue: 0,1:05:05.03,1:05:09.04,Default,,0000,0000,0000,,«Зияндық теріс қылық салдарынан
Dialogue: 0,1:05:05.03,1:05:09.04,Default,,0000,0000,0000,,Ұпай алу мүмкіндігін блоктау ретінде қарастырылады →
Dialogue: 0,1:05:09.04,1:05:13.04,Default,,0000,0000,0000,,Ватару Куон қызыл қағаз алды! »
Dialogue: 0,1:05:13.04,1:05:17.05,Default,,0000,0000,0000,,Куон, сен не істеп жатырсың...?
Dialogue: 0,1:05:17.05,1:05:19.05,Default,,0000,0000,0000,,А-а... шіркін.
Dialogue: 0,1:05:19.05,1:05:23.05,Default,,0000,0000,0000,,Енді балалар, әлі де күресуге болады.
Dialogue: 0,1:05:23.05,1:05:26.06,Default,,0000,0000,0000,,Ақымақ болма!
Dialogue: 0,1:05:23.05,1:05:26.06,Default,,0000,0000,0000,,Сабыр ет, Рейу!
Dialogue: 0,1:05:26.06,1:05:28.02,Default,,0000,0000,0000,,Амансың ба? тыныш!
Dialogue: 0,1:05:28.02,1:05:30.03,Default,,0000,0000,0000,,Рейу... Менде бәрі жақсы.
Dialogue: 0,1:05:33.03,1:05:37.03,Default,,0000,0000,0000,,...Сендер міндетті түрде жеңесіңдер.
Dialogue: 0,1:05:37.03,1:05:41.07,Default,,0000,0000,0000,,Сізді әлемдегі ең үздік шабуылшы ететін не?
Dialogue: 0,1:05:37.03,1:05:41.07,Default,,0000,0000,0000,,Өйткені бұл менмін.
Dialogue: 0,1:05:41.07,1:05:44.04,Default,,0000,0000,0000,,Ақымақ болма, Куон.
Dialogue: 0,1:05:41.07,1:05:44.04,Default,,0000,0000,0000,,Бұл анық.
Dialogue: 0,1:05:45.07,1:05:50.05,Default,,0000,0000,0000,,Біз жеңеміз!
Dialogue: 0,1:05:45.07,1:05:50.05,Default,,0000,0000,0000,,Осымен аяқталуы мүмкін бе?
Dialogue: 0,1:05:51.05,1:05:54.05,Default,,0000,0000,0000,,《Яғни... Мен ғажап болғым келеді, солай емес пе? 》
Dialogue: 0,1:05:54.05,1:05:59.06,Default,,0000,0000,0000,,《Мен оны ешқашан елестеткен емеспін
Dialogue: 0,1:05:54.05,1:05:59.06,Default,,0000,0000,0000,,Барған сайын толып жатыр...》
Dialogue: 0,1:05:59.06,1:06:02.06,Default,,0000,0000,0000,,《Бұл біртүрлі сезім, бірақ қызық》
Dialogue: 0,1:06:02.06,1:06:06.06,Default,,0000,0000,0000,,《Футбол мені қыздырады》
Dialogue: 0,1:06:06.06,1:06:09.07,Default,,0000,0000,0000,,《Мен өзгеремін》
Dialogue: 0,1:06:09.07,1:06:13.04,Default,,0000,0000,0000,,《Бұдан ары мені қандай адам күтіп тұр екен...》
Dialogue: 0,1:06:14.14,1:06:18.11,Default,,0000,0000,0000,,《Мен жауап алғым келеді...》
Dialogue: 0,1:06:21.04,1:06:24.05,Default,,0000,0000,0000,,Алдағы Эльдий әскері
Dialogue: 0,1:06:21.04,1:06:24.05,Default,,0000,0000,0000,,Наги ренжідіңіз бе?
Dialogue: 0,1:06:21.04,1:06:24.05,Default,,0000,0000,0000,,Иә, жақсы.
Dialogue: 0,1:06:24.05,1:06:26.12,Default,,0000,0000,0000,,Үш минут қалды...
Dialogue: 0,1:06:26.12,1:06:29.05,Default,,0000,0000,0000,,Эй Рейо, мен сені қалай қорғаймын?
Dialogue: 0,1:06:26.12,1:06:29.05,Default,,0000,0000,0000,,Допты айналдырып, уақытты сатып алыңыз!
Dialogue: 0,1:06:29.05,1:06:32.02,Default,,0000,0000,0000,,ше? Балалар, не айтып тұрсыңдар?
Dialogue: 0,1:06:33.06,1:06:36.06,Default,,0000,0000,0000,,«Күштеу» жалғыз нұсқа.
Dialogue: 0,1:06:36.06,1:06:40.06,Default,,0000,0000,0000,,Бұл жігіттермен тең түсу жеңіліспен бірдей!
Dialogue: 0,1:06:40.06,1:06:42.06,Default,,0000,0000,0000,,Тағы бір нүкте.
Dialogue: 0,1:06:42.06,1:06:44.03,Default,,0000,0000,0000,,Тағы бір нүкте...
Dialogue: 0,1:06:46.04,1:06:48.04,Default,,0000,0000,0000,,
Dialogue: 0,1:06:48.04,1:06:51.04,Default,,0000,0000,0000,,Тәртіпсіздік жасамаңыздар, балалар!
Dialogue: 0,1:06:48.04,1:06:51.04,Default,,0000,0000,0000,,Өлімге дейін қорғау! Өлімге дейін қорғау!
Dialogue: 0,1:06:55.04,1:06:57.05,Default,,0000,0000,0000,,《Міне, Рей патша, мұнда кел》
Dialogue: 0,1:06:57.05,1:06:59.05,Default,,0000,0000,0000,,《Оны маған бер! 》
Dialogue: 0,1:06:59.05,1:07:05.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:07:05.05,1:07:07.06,Default,,0000,0000,0000,,《Не... оны өзіңіз мақсат еттіңіз бе? 》
Dialogue: 0,1:07:07.06,1:07:11.06,Default,,0000,0000,0000,,《Бұл не...?
Dialogue: 0,1:07:07.06,1:07:11.06,Default,,0000,0000,0000,,Сайып келгенде, Рейо да «мен»...》
Dialogue: 0,1:07:15.03,1:07:17.03,Default,,0000,0000,0000,,Міне келдік!
Dialogue: 0,1:07:17.03,1:07:19.03,Default,,0000,0000,0000,,Менің аумағым!
Dialogue: 0,1:07:19.03,1:07:23.04,Default,,0000,0000,0000,,Қайдан келдің...! ?
Dialogue: 0,1:07:19.03,1:07:23.04,Default,,0000,0000,0000,,Қабырға қорғанысынан!
Dialogue: 0,1:07:23.04,1:07:25.04,Default,,0000,0000,0000,,Допты ал!
Dialogue: 0,1:07:23.04,1:07:25.04,Default,,0000,0000,0000,,Алдымен оны түртіңіз!
Dialogue: 0,1:07:25.04,1:07:27.04,Default,,0000,0000,0000,,《Келді...》
Dialogue: 0,1:07:27.04,1:07:30.05,Default,,0000,0000,0000,,Тағы бір нүкте...
Dialogue: 0,1:07:30.05,1:07:37.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:07:37.05,1:07:39.02,Default,,0000,0000,0000,,《Жеңді》
Dialogue: 0,1:07:41.06,1:07:43.03,Default,,0000,0000,0000,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,1:07:52.03,1:07:54.04,Default,,0000,0000,0000,,Мен оны көріп тұрмын...!
Dialogue: 0,1:07:54.04,1:07:57.01,Default,,0000,0000,0000,,Енді бұл сіздің соңғы мүмкіндігіңіз!
Dialogue: 0,1:07:59.04,1:08:08.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:08:08.05,1:08:10.02,Default,,0000,0000,0000,,《Жоқ! Шынымен, не? Бұл жігіттер》
Dialogue: 0,1:08:11.02,1:08:13.02,Default,,0000,0000,0000,,Хираку осы жолмен!
Dialogue: 0,1:08:14.06,1:08:17.06,Default,,0000,0000,0000,,《Аяқпен... Жарып өт! 》
Dialogue: 0,1:08:17.06,1:08:23.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:08:23.03,1:08:26.04,Default,,0000,0000,0000,,Адамдардың санын көбейтіңіз!
Dialogue: 0,1:08:23.03,1:08:26.04,Default,,0000,0000,0000,,Эй, эй!
Dialogue: 0,1:08:26.04,1:08:28.04,Default,,0000,0000,0000,,Ұсақталған!
Dialogue: 0,1:08:29.04,1:08:31.04,Default,,0000,0000,0000,,Бір-екі мұқаба!
Dialogue: 0,1:08:31.04,1:08:34.04,Default,,0000,0000,0000,,《Ортасына қарай кесіңіз! ? 》
Dialogue: 0,1:08:35.01,1:08:37.05,Default,,0000,0000,0000,,Ол жігіт...!
Dialogue: 0,1:08:37.05,1:08:40.05,Default,,0000,0000,0000,,Жүр! !
Dialogue: 0,1:08:40.05,1:08:45.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:08:45.05,1:08:47.02,Default,,0000,0000,0000,,《Ең қауіпті бөлігі...! 》
Dialogue: 0,1:08:48.02,1:08:50.03,Default,,0000,0000,0000,,Ортаны атуға рұқсат бермеймін!
Dialogue: 0,1:08:50.03,1:08:52.03,Default,,0000,0000,0000,,Сыртқа шыққанда бітеді!
Dialogue: 0,1:08:53.03,1:08:55.03,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:08:55.03,1:08:58.03,Default,,0000,0000,0000,,Сіз маған шешім қабылдауды айтып тұрсыз! Мен сені өлтіремін!
Dialogue: 0,1:08:58.03,1:09:00.04,Default,,0000,0000,0000,,Жүр!
Dialogue: 0,1:09:00.04,1:09:06.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:09:06.08,1:09:08.04,Default,,0000,0000,0000,,《Ең қауіптісі! 》
Dialogue: 0,1:09:08.04,1:09:10.05,Default,,0000,0000,0000,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,1:09:08.04,1:09:10.05,Default,,0000,0000,0000,,Оны маған беріңіз!
Dialogue: 0,1:09:10.05,1:09:14.05,Default,,0000,0000,0000,,Орталықтандырудан сақ болыңыз!
Dialogue: 0,1:09:10.05,1:09:14.05,Default,,0000,0000,0000,,Атпа! Оны сындырыңыз!
Dialogue: 0,1:09:14.05,1:09:16.05,Default,,0000,0000,0000,,《Міне... Эгоист! 》
Dialogue: 0,1:09:21.06,1:09:24.06,Default,,0000,0000,0000,,Керемет, Хачираку.
Dialogue: 0,1:09:32.03,1:09:35.04,Default,,0000,0000,0000,,Мен сені жиі көремін.
Dialogue: 0,1:09:38.07,1:09:43.08,Default,,0000,0000,0000,,Енді сен ең жақсысың
Dialogue: 0,1:09:38.07,1:09:43.08,Default,,0000,0000,0000,,Сіз бұл салада қауіпті адамсыз.
Dialogue: 0,1:09:44.05,1:09:47.05,Default,,0000,0000,0000,,《Мына жігіт допқа бірінші тиеді...》
Dialogue: 0,1:09:47.05,1:09:51.05,Default,,0000,0000,0000,,《Бірақ бұл жігіт түсірілім алдында
Dialogue: 0,1:09:47.05,1:09:51.05,Default,,0000,0000,0000,,Бір тұзақ жасауды ұмытпаңыз→
Dialogue: 0,1:09:51.05,1:09:54.06,Default,,0000,0000,0000,,Допты оңай атуға болатын жерге қойыңыз》
Dialogue: 0,1:09:54.06,1:09:56.06,Default,,0000,0000,0000,,《Оны мақсат етіп, ұрла! 》
Dialogue: 0,1:09:56.06,1:09:58.06,Default,,0000,0000,0000,,《Сосын тағы →
Dialogue: 0,1:09:58.06,1:10:02.03,Default,,0000,0000,0000,,Есептегішті соғыңыз
Dialogue: 0,1:09:58.06,1:10:02.03,Default,,0000,0000,0000,,Менің мақсатыммен аяқталады...》
Dialogue: 0,1:10:03.07,1:10:06.07,Default,,0000,0000,0000,,《Кел, Киёшичи》
Dialogue: 0,1:10:06.07,1:10:11.04,Default,,0000,0000,0000,,《Мен сіздің футболыңыз туралымын
Dialogue: 0,1:10:06.07,1:10:11.04,Default,,0000,0000,0000,,Жылуды түгел жұтамын...! 》
Dialogue: 0,1:10:13.04,1:10:17.05,Default,,0000,0000,0000,,Сен мені жеңе алмайсың.
Dialogue: 0,1:10:17.05,1:10:24.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:10:24.05,1:10:28.06,Default,,0000,0000,0000,,《Маған ұнамайды! Мен...》
Dialogue: 0,1:10:28.06,1:10:34.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:10:53.02,1:10:55.02,Default,,0000,0000,0000,,Тікелей….
Dialogue: 0,1:11:11.03,1:11:16.04,Default,,0000,0000,0000,,《Мен оны сол кезде көрдім.》
Dialogue: 0,1:11:16.04,1:11:18.04,Default,,0000,0000,0000,,《Жарық...》
Dialogue: 0,1:11:18.04,1:11:21.04,Default,,0000,0000,0000,,Ик! (Адамдар айқайлап жатыр)
Dialogue: 0,1:11:21.04,1:11:25.01,Default,,0000,0000,0000,,《Адамның қайта туатын сәті》
Dialogue: 0,1:11:25.01,1:11:27.02,Default,,0000,0000,0000,,
Dialogue: 0,1:11:28.05,1:11:31.02,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,1:11:31.02,1:11:34.02,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,1:11:34.02,1:11:37.03,Default,,0000,0000,0000,,Король Рей! Әлі уақыт бар.
Dialogue: 0,1:11:37.03,1:11:39.03,Default,,0000,0000,0000,,Егер тағы екі ұпай алсақ...
Dialogue: 0,1:11:39.03,1:11:41.03,Default,,0000,0000,0000,,Наги….
Dialogue: 0,1:11:41.03,1:11:44.03,Default,,0000,0000,0000,,
Dialogue: 0,1:11:44.03,1:11:46.04,Default,,0000,0000,0000,,«Ойын аяқталды»
Dialogue: 0,1:11:46.04,1:11:49.04,Default,,0000,0000,0000,,«Z командасы 5-4 жеңеді!»
Dialogue: 0,1:11:49.04,1:11:51.04,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:11:51.04,1:11:54.04,Default,,0000,0000,0000,,《Әй...》
Dialogue: 0,1:11:54.04,1:11:56.01,Default,,0000,0000,0000,,《Ол жоғалады...》
Dialogue: 0,1:11:56.01,1:12:00.02,Default,,0000,0000,0000,,《Бұл ыстық уақыт аяқталады...》
Dialogue: 0,1:12:00.02,1:12:03.02,Default,,0000,0000,0000,,《Мен де қайта туа алар едім...》
Dialogue: 0,1:12:03.02,1:12:06.06,Default,,0000,0000,0000,,《Қызғанымның себебі→
Dialogue: 0,1:12:06.06,1:12:10.03,Default,,0000,0000,0000,,Мақсаттар мен құмарлық→
Dialogue: 0,1:12:10.03,1:12:16.03,Default,,0000,0000,0000,,Бәрін ол ұрлаған... Киёшиичи》
Dialogue: 0,1:12:18.07,1:12:20.07,Default,,0000,0000,0000,,Король Рей….
Dialogue: 0,1:12:20.07,1:12:24.07,Default,,0000,0000,0000,,Егер шындап төбелессең, жеңілесің.
Dialogue: 0,1:12:20.07,1:12:24.07,Default,,0000,0000,0000,,Мен осылай сезінемін...
Dialogue: 0,1:12:24.07,1:12:32.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:12:32.05,1:12:34.05,Default,,0000,0000,0000,,Бұл көңілсіз...
Dialogue: 0,1:12:54.87,1:12:59.88,Default,,0000,0000,0000,,20 жасқа дейінгі Жапония құрамасына қарсы тұрақты ойын өткізді
Dialogue: 0,1:12:54.87,1:12:59.88,Default,,0000,0000,0000,,Сынақ.
Dialogue: 0,1:12:59.88,1:13:01.88,Default,,0000,0000,0000,,Мен әлемдегі ең үздік шабуылшы боламын! !
Dialogue: 0,1:13:01.88,1:13:03.91,Default,,0000,0000,0000,,<Осыдан кейін түн ортасынан бастап →
Dialogue: 0,1:13:03.91,1:13:07.88,Default,,0000,0000,0000,,Телехикаяның екінші маусымы
Dialogue: 0,1:13:03.91,1:13:07.88,Default,,0000,0000,0000,,«Blue Rock VS. U-20 JAPAN» басталуы>
Dialogue: 0,1:13:09.89,1:13:12.89,Default,,0000,0000,0000,,
Dialogue: 0,1:13:12.89,1:13:14.86,Default,,0000,0000,0000,,«Уақытыңызды бөлгеніңізге рахмет →
Dialogue: 0,1:13:14.86,1:13:18.86,Default,,0000,0000,0000,,Көк жартастың негізгі таңдауы
Dialogue: 0,1:13:14.86,1:13:18.86,Default,,0000,0000,0000,,Барлық ғимараттар аяқталды».
Dialogue: 0,1:13:18.86,1:13:22.90,Default,,0000,0000,0000,,«Тазалаған адам
Dialogue: 0,1:13:18.86,1:13:22.90,Default,,0000,0000,0000,,Бірден жаттығу костюмін киіңіз→
Dialogue: 0,1:13:22.90,1:13:25.87,Default,,0000,0000,0000,,Әр ғимараттың жертөлесінің орталық бөлігіне жиналыңыз».
Dialogue: 0,1:13:25.87,1:13:28.87,Default,,0000,0000,0000,,«Қосымша таңдауды бастау»
Dialogue: 0,1:13:28.87,1:13:31.87,Default,,0000,0000,0000,,Қызық болып барады.
Dialogue: 0,1:13:31.87,1:13:35.84,Default,,0000,0000,0000,,Данышпан өзінің эгосын оянған сияқты.
Dialogue: 0,1:13:39.88,1:13:41.88,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,1:13:39.88,1:13:41.88,Default,,0000,0000,0000,,О!
Dialogue: 0,1:13:42.89,1:13:44.95,Default,,0000,0000,0000,,Ой! Жарайсың Наги!
Dialogue: 0,1:13:44.95,1:13:49.93,Default,,0000,0000,0000,,Бірінші
Dialogue: 0,1:13:44.95,1:13:49.93,Default,,0000,0000,0000,,1-кезеңнен сәтті өттіңіз.
Dialogue: 0,1:13:44.95,1:13:49.93,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,1:13:50.89,1:13:52.90,Default,,0000,0000,0000,,Хэхе!
Dialogue: 0,1:13:52.90,1:13:55.90,Default,,0000,0000,0000,,Екінші
Dialogue: 0,1:13:52.90,1:13:55.90,Default,,0000,0000,0000,,2-кезеңде үш адамнан тұратын топ бар ма?
Dialogue: 0,1:13:55.90,1:13:57.90,Default,,0000,0000,0000,,Сонымен қатар кіммен кездескіңіз келеді?
Dialogue: 0,1:13:57.90,1:14:01.90,Default,,0000,0000,0000,,Ал...
Dialogue: 0,1:13:57.90,1:14:01.90,Default,,0000,0000,0000,,Мен топтасқым келетін адам келгенше күтемін.
Dialogue: 0,1:14:01.90,1:14:04.87,Default,,0000,0000,0000,,О? Жарайды, бірақ бұл Зантецу ма?
Dialogue: 0,1:14:04.87,1:14:06.88,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,1:14:06.88,1:14:09.91,Default,,0000,0000,0000,,《Рей-о десем, ашуланасың ба...》
Dialogue: 0,1:14:09.91,1:14:11.88,Default,,0000,0000,0000,,Келгенде айтамын.
Dialogue: 0,1:14:09.91,1:14:11.88,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,1:14:16.89,1:14:18.89,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,1:14:18.89,1:14:20.89,Default,,0000,0000,0000,,Әй, Киёши!
Dialogue: 0,1:14:18.89,1:14:20.89,Default,,0000,0000,0000,,Уа...
Dialogue: 0,1:14:21.89,1:14:23.93,Default,,0000,0000,0000,,Ара музыкасы!
Dialogue: 0,1:14:23.93,1:14:25.96,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:14:25.96,1:14:28.96,Default,,0000,0000,0000,,Мен сені бірден кездестірдім!
Dialogue: 0,1:14:25.96,1:14:28.96,Default,,0000,0000,0000,,Жақсы жұмыс! Тазалауыңызбен құттықтаймыз.
Dialogue: 0,1:14:31.90,1:14:33.90,Default,,0000,0000,0000,,А, Наги?
Dialogue: 0,1:14:35.90,1:14:38.91,Default,,0000,0000,0000,,Эй, Киёшичи, бізбен бірге болғың келе ме?
Dialogue: 0,1:14:38.91,1:14:41.91,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:14:38.91,1:14:41.91,Default,,0000,0000,0000,,Біздің командаға қосылыңыз.
Dialogue: 0,1:14:44.91,1:14:48.88,Default,,0000,0000,0000,,Эй, сәлем Наги
Dialogue: 0,1:14:44.91,1:14:48.88,Default,,0000,0000,0000,,Бұл сіз бірге болғыңыз келген жігіт пе еді?
Dialogue: 0,1:14:48.88,1:14:52.89,Default,,0000,0000,0000,,Иә. Өйткені сол ойында
Dialogue: 0,1:14:48.88,1:14:52.89,Default,,0000,0000,0000,,Ең таңғаларлығы осы болды.
Dialogue: 0,1:14:52.89,1:14:55.89,Default,,0000,0000,0000,,Мен бұл жігітпен футбол ойнағым келеді.
Dialogue: 0,1:14:57.89,1:15:00.90,Default,,0000,0000,0000,,...Себебі.
Dialogue: 0,1:14:57.89,1:15:00.90,Default,,0000,0000,0000,,Біз не істеуіміз керек? Сен сонда барасың ба?
Dialogue: 0,1:15:00.90,1:15:04.90,Default,,0000,0000,0000,,Сіз баратын жол жоқ.
Dialogue: 0,1:15:00.90,1:15:04.90,Default,,0000,0000,0000,,Мен Хачиракумен топтасамын.
Dialogue: 0,1:15:06.87,1:15:09.87,Default,,0000,0000,0000,,Кешіріңіз, Наги.
Dialogue: 0,1:15:06.87,1:15:09.87,Default,,0000,0000,0000,,Онда жалғыз бара алмайсың.
Dialogue: 0,1:15:09.87,1:15:13.84,Default,,0000,0000,0000,,...Дұрыс.
Dialogue: 0,1:15:09.87,1:15:13.84,Default,,0000,0000,0000,,көремін. Сонда...
Dialogue: 0,1:15:15.88,1:15:18.88,Default,,0000,0000,0000,,Мен Киёши командасына қосыламын.
Dialogue: 0,1:15:18.88,1:15:20.88,Default,,0000,0000,0000,,Аа...! ?
Dialogue: 0,1:15:20.88,1:15:22.89,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:15:20.88,1:15:22.89,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:15:22.89,1:15:24.89,Default,,0000,0000,0000,,Жақсы, солай ма?
Dialogue: 0,1:15:24.89,1:15:27.89,Default,,0000,0000,0000,,Не...не туралы айтып тұрсың, Наги?
Dialogue: 0,1:15:27.89,1:15:31.89,Default,,0000,0000,0000,,Сіз... менімен бірігуіңіз керек, солай ма?
Dialogue: 0,1:15:31.89,1:15:34.86,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,1:15:31.89,1:15:34.86,Default,,0000,0000,0000,,Маған не болады? ?
Dialogue: 0,1:15:35.90,1:15:37.87,Default,,0000,0000,0000,,《Бұл бетті жасама》
Dialogue: 0,1:15:37.87,1:15:42.87,Default,,0000,0000,0000,,Рейо Сіз маған футболды үйреттіңіз.
Dialogue: 0,1:15:42.87,1:15:46.88,Default,,0000,0000,0000,,Сен екеуміз әлемнің ең жақсысы боламыз.
Dialogue: 0,1:15:42.87,1:15:46.88,Default,,0000,0000,0000,,Бұл мүлдем дұрыс.
Dialogue: 0,1:15:47.88,1:15:49.88,Default,,0000,0000,0000,,Бірақ біз жеңіліп қалдық.
Dialogue: 0,1:15:49.88,1:15:51.88,Default,,0000,0000,0000,,Біз ең мықты емес едік...
Dialogue: 0,1:15:53.88,1:15:56.89,Default,,0000,0000,0000,,《Маған Рей патшамен болған ұнайды...》
Dialogue: 0,1:15:56.89,1:16:01.86,Default,,0000,0000,0000,,《Бұл қиындық емес.
Dialogue: 0,1:15:56.89,1:16:01.86,Default,,0000,0000,0000,,Бұл ыңғайлы және көңілді...》
Dialogue: 0,1:16:02.86,1:16:07.86,Default,,0000,0000,0000,,《Бірақ Рей патша оны маған көрсетті.
Dialogue: 0,1:16:02.86,1:16:07.86,Default,,0000,0000,0000,,Дүниедегі ең жақсы арман-→
Dialogue: 0,1:16:07.86,1:16:10.87,Default,,0000,0000,0000,,Әрине, дәл сол сәтте
Dialogue: 0,1:16:07.86,1:16:10.87,Default,,0000,0000,0000,,Бірде бітті》
Dialogue: 0,1:16:13.87,1:16:18.87,Default,,0000,0000,0000,,Мен бұл өкініштің шын мәнін алғаш рет сезіндім.
Dialogue: 0,1:16:13.87,1:16:18.87,Default,,0000,0000,0000,,Білу →
Dialogue: 0,1:16:18.87,1:16:21.88,Default,,0000,0000,0000,,Мен бұл жігітпен футбол ойнағым келеді.
Dialogue: 0,1:16:22.88,1:16:26.85,Default,,0000,0000,0000,,《Тағы да сенімен бірге әлемнің ең жақсысы болуды армандау》
Dialogue: 0,1:16:30.89,1:16:32.89,Default,,0000,0000,0000,,Мен бар күшімді салғым келеді.
Dialogue: 0,1:16:32.89,1:16:47.87,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:16:47.87,1:16:50.87,Default,,0000,0000,0000,,Ах... Қарғыс атсын...!
Dialogue: 0,1:16:52.87,1:16:56.88,Default,,0000,0000,0000,,Бұл не? Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,1:16:57.88,1:16:59.95,Default,,0000,0000,0000,,Не істеу керек? Тазалық.
Dialogue: 0,1:16:59.95,1:17:03.95,Default,,0000,0000,0000,,《Мені таңда. эгоист》
Dialogue: 0,1:17:04.89,1:17:06.86,Default,,0000,0000,0000,,Кел, Наги!
Dialogue: 0,1:17:06.86,1:17:17.90,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:17:17.90,1:17:21.87,Default,,0000,0000,0000,,Көріскенше, Рей патша. Мен сыртта күтемін.
Dialogue: 0,1:17:25.87,1:17:29.88,Default,,0000,0000,0000,,Танысқаныма қуаныштымын! Нагичи.
Dialogue: 0,1:17:25.87,1:17:29.88,Default,,0000,0000,0000,,Иә. сізбен танысқаныма қуаныштымын.
Dialogue: 0,1:17:29.88,1:17:32.91,Default,,0000,0000,0000,,Ол аздап көңілсіз көрінді.
Dialogue: 0,1:17:32.91,1:17:35.88,Default,,0000,0000,0000,,Сіз таңқаларлықтай салқын жансыз ба?
Dialogue: 0,1:17:35.88,1:17:39.89,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:17:35.88,1:17:39.89,Default,,0000,0000,0000,,Жалғыз емеспін десем, өтірік айтқан болар едім...
Dialogue: 0,1:17:40.89,1:17:43.86,Default,,0000,0000,0000,,《Мен Король Реймен қайта кездесетініме сенімдімін》
Dialogue: 0,1:17:44.89,1:17:47.90,Default,,0000,0000,0000,,Бұл қызықтырақ болды.
Dialogue: 0,1:17:47.90,1:17:50.90,Default,,0000,0000,0000,,Сол эгомен жүру дұрыс емес пе?
Dialogue: 0,1:17:51.90,1:17:54.90,Default,,0000,0000,0000,,Көк жартас деген осы емес пе?
Dialogue: 0,1:17:54.90,1:17:57.91,Default,,0000,0000,0000,,《Біз қазір жақсы емеспіз》
Dialogue: 0,1:17:59.88,1:18:02.91,Default,,0000,0000,0000,,Наги танысқаныма қуаныштымын.
Dialogue: 0,1:18:02.91,1:18:04.88,Default,,0000,0000,0000,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,1:18:05.88,1:18:10.89,Default,,0000,0000,0000,,《Мен өзгергім келеді, күштірек және қайта кездескім келеді》
Dialogue: 0,1:18:18.89,1:18:20.90,Default,,0000,0000,0000,,《Мен...→
Dialogue: 0,1:18:20.90,1:18:22.90,Default,,0000,0000,0000,,Менің өмірім →
Dialogue: 0,1:18:22.90,1:18:27.87,Default,,0000,0000,0000,,Мен қалағанның бәрі
Dialogue: 0,1:18:22.90,1:18:27.87,Default,,0000,0000,0000,,Мен міндетті түрде түсіндім...》
Dialogue: 0,1:18:28.90,1:18:31.91,Default,,0000,0000,0000,,《Сонымен мен сенімдімін...→
Dialogue: 0,1:18:31.91,1:18:33.88,Default,,0000,0000,0000,,Сол данышпан...→
Dialogue: 0,1:18:33.88,1:18:37.88,Default,,0000,0000,0000,,Өмірімде бірінші рет
Dialogue: 0,1:18:33.88,1:18:37.88,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,1:18:33.88,1:18:37.88,Default,,0000,0000,0000,,Бұл мен ала алмаған қазына...》
Dialogue: 0,1:18:40.88,1:18:43.89,Default,,0000,0000,0000,,Ақымақ….
Dialogue: 0,1:18:44.92,1:18:46.89,Default,,0000,0000,0000,,《Бірақ Наги…》
Dialogue: 0,1:18:46.89,1:18:50.86,Default,,0000,0000,0000,,《Шын мәнінде мен
Dialogue: 0,1:18:46.89,1:18:50.86,Default,,0000,0000,0000,,Сол кезде мен түсіндім...》
Dialogue: 0,1:18:51.89,1:18:55.90,Default,,0000,0000,0000,,《Футболға қызығады
Dialogue: 0,1:18:51.89,1:18:55.90,Default,,0000,0000,0000,,Сіз қызып бара жатырсыз》
Dialogue: 0,1:18:55.90,1:18:58.90,Default,,0000,0000,0000,,《Сіз өзіңіздің талантыңызды түсінесіз》
Dialogue: 0,1:18:58.90,1:19:04.87,Default,,0000,0000,0000,,《Сосын мен Киёшиден жеңіліп қалдым.
Dialogue: 0,1:18:58.90,1:19:04.87,Default,,0000,0000,0000,,Өкініш алған саған қарап, мен...
Dialogue: 0,1:19:05.97,1:19:07.94,Default,,0000,0000,0000,,Бұл көңілсіз...
Dialogue: 0,1:19:11.88,1:19:13.85,Default,,0000,0000,0000,,және тек үшеуміз – анам, әкем және мен – бірге өмір сүремін…
Dialogue: 0,1:19:11.88,1:19:13.85,Default,,0000,0000,0000,,《Шынында мен бақытты болдым》
Dialogue: 0,1:19:15.88,1:19:19.89,Default,,0000,0000,0000,,《Бірақ сені өзгерткен мен емеспін》
Dialogue: 0,1:19:23.89,1:19:28.86,Default,,0000,0000,0000,,《Егер сіз мұны мойындасаңыз
Dialogue: 0,1:19:23.89,1:19:28.86,Default,,0000,0000,0000,,Мен сенің жаныңда бола алмайтын сияқтымын...》
Dialogue: 0,1:19:29.90,1:19:34.87,Default,,0000,0000,0000,,《Мені өз сезімдерім қозғайды.
Dialogue: 0,1:19:29.90,1:19:34.87,Default,,0000,0000,0000,,Көзін жұмып, қақпағын жапты.
Dialogue: 0,1:19:36.87,1:19:38.87,Default,,0000,0000,0000,,Мен бұл жігітпен футбол ойнағым келеді.
Dialogue: 0,1:19:38.87,1:19:41.88,Default,,0000,0000,0000,,《Көзіңді балаша жылтыр→
Dialogue: 0,1:19:41.88,1:19:44.88,Default,,0000,0000,0000,,Өзгеруге және алға жылжуға тырысатын сізге →
Dialogue: 0,1:19:44.88,1:19:48.88,Default,,0000,0000,0000,,Мен... айта алмадым...》
Dialogue: 0,1:19:48.88,1:19:53.86,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:19:53.86,1:19:56.86,Default,,0000,0000,0000,,Жарайсың, Наги! Кәне!
Dialogue: 0,1:19:58.86,1:20:00.90,Default,,0000,0000,0000,,Арманымыздан асып тағы кездесейік.
Dialogue: 0,1:20:00.90,1:20:13.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:20:13.88,1:20:15.88,Default,,0000,0000,0000,,《Айтсаңыз →
Dialogue: 0,1:20:15.88,1:20:18.85,Default,,0000,0000,0000,,Сіз
Dialogue: 0,1:20:15.88,1:20:18.85,Default,,0000,0000,0000,,Мен ешқашан қайтып келмейтіндей сезінемін...
Dialogue: 0,1:20:19.88,1:20:24.89,Default,,0000,0000,0000,,《Екеуміздің арманымыз
Dialogue: 0,1:20:19.88,1:20:24.89,Default,,0000,0000,0000,,Мен ол жоғалып бара жатқандай сезінемін...》
Dialogue: 0,1:20:25.89,1:20:30.89,Default,,0000,0000,0000,,《Мен қорқамын, жалғызбын және әлсізмін...》
Dialogue: 0,1:20:30.89,1:20:32.86,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:20:32.86,1:20:36.90,Default,,0000,0000,0000,,《Адамдар өзгереді→
Dialogue: 0,1:20:36.90,1:20:39.87,Default,,0000,0000,0000,,Мен оның соншалықты қатыгез екеніне сене алар емеспін...→
Dialogue: 0,1:20:39.87,1:20:41.87,Default,,0000,0000,0000,,Мен білгім келмеді...》
Dialogue: 0,1:20:48.88,1:20:51.88,Default,,0000,0000,0000,,《Бұл жігіт шынымен алдайды...》
Dialogue: 0,1:20:55.88,1:20:58.92,Default,,0000,0000,0000,,Ара музыкасы! тыныш! Өтінемін, тоқтатыңыз!
Dialogue: 0,1:20:58.92,1:21:02.89,Default,,0000,0000,0000,,Кел, алдамшы құбыжық!
Dialogue: 0,1:21:02.89,1:21:06.90,Default,,0000,0000,0000,,Демек, бітті деген сөз.
Dialogue: 0,1:21:02.89,1:21:06.90,Default,,0000,0000,0000,,Жылы әуесқой.
Dialogue: 0,1:21:06.90,1:21:14.90,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:21:14.90,1:21:18.87,Default,,0000,0000,0000,,《Dribling Kick Soccer IQ...》
Dialogue: 0,1:21:18.87,1:21:22.88,Default,,0000,0000,0000,,《Барлық параметрлер
Dialogue: 0,1:21:18.87,1:21:22.88,Default,,0000,0000,0000,,Бұл 100-ден 200 ұпай! 》
Dialogue: 0,1:21:22.88,1:21:24.91,Default,,0000,0000,0000,,《Бұл адам адамгершілікке жатпайды! 》
Dialogue: 0,1:21:24.91,1:21:31.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:21:31.89,1:21:35.92,Default,,0000,0000,0000,,
Dialogue: 0,1:21:35.92,1:21:39.90,Default,,0000,0000,0000,,Үшінші
Dialogue: 0,1:21:35.92,1:21:39.90,Default,,0000,0000,0000,,«3-кезең
Dialogue: 0,1:21:35.92,1:21:39.90,Default,,0000,0000,0000,,3v3 бәсекелестік шайқасы»
Dialogue: 0,1:21:39.90,1:21:42.86,Default,,0000,0000,0000,,«Қызыл командасы 5-2 жеңді»
Dialogue: 0,1:21:43.87,1:21:45.87,Default,,0000,0000,0000,,《Мен жеңілдім...》
Dialogue: 0,1:21:45.87,1:21:47.87,Default,,0000,0000,0000,,Токимицу
Dialogue: 0,1:21:45.87,1:21:47.87,Default,,0000,0000,0000,,Аоши
Dialogue: 0,1:21:45.87,1:21:47.87,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,1:21:45.87,1:21:47.87,Default,,0000,0000,0000,,Қызықты қызықты!
Dialogue: 0,1:21:47.87,1:21:50.87,Default,,0000,0000,0000,,Арюу
Dialogue: 0,1:21:47.87,1:21:50.87,Default,,0000,0000,0000,,Не істеу керек? Токимицу Рин.
Dialogue: 0,1:21:50.87,1:21:52.84,Default,,0000,0000,0000,,Ереже: жеңсең, бір адамды алып кетесің.
Dialogue: 0,1:21:53.88,1:21:56.88,Default,,0000,0000,0000,,Кез келген адам жақсы. Не болса да солай.
Dialogue: 0,1:21:56.88,1:22:00.88,Default,,0000,0000,0000,,《Киёшимен командалассам да жеңілдім...》
Dialogue: 0,1:22:00.88,1:22:04.89,Default,,0000,0000,0000,,Олай болса, Ант-кун!
Dialogue: 0,1:22:00.88,1:22:04.89,Default,,0000,0000,0000,,Менің ойымша, ол жақсы.
Dialogue: 0,1:22:04.89,1:22:08.89,Default,,0000,0000,0000,,Хм, бұл қандай кездейсоқтық.
Dialogue: 0,1:22:04.89,1:22:08.89,Default,,0000,0000,0000,,Мен де оны қалаймын.
Dialogue: 0,1:22:09.89,1:22:11.89,Default,,0000,0000,0000,,Кел →
Dialogue: 0,1:22:11.89,1:22:13.86,Default,,0000,0000,0000,,Хачираку Кай.
Dialogue: 0,1:22:15.90,1:22:17.87,Default,,0000,0000,0000,,Келесіге тез өтейік.
Dialogue: 0,1:22:17.87,1:22:20.87,Default,,0000,0000,0000,,Бұл туралы алаңдамаңыз.
Dialogue: 0,1:22:20.87,1:22:23.87,Default,,0000,0000,0000,,Сенің болашағың менің қолымда.
Dialogue: 0,1:22:25.87,1:22:27.88,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,1:22:27.88,1:22:31.88,Default,,0000,0000,0000,,Мен Киёшимен соңына дейін боламын
Dialogue: 0,1:22:27.88,1:22:31.88,Default,,0000,0000,0000,,Мен барғым келді, бірақ...
Dialogue: 0,1:22:31.88,1:22:33.88,Default,,0000,0000,0000,,Ара музыкасы….
Dialogue: 0,1:22:35.88,1:22:37.89,Default,,0000,0000,0000,,Бұл уәде, Рей патша.
Dialogue: 0,1:22:37.89,1:22:40.86,Default,,0000,0000,0000,,Ах, Наги, мен уәде беремін.
Dialogue: 0,1:22:41.86,1:22:44.86,Default,,0000,0000,0000,,Мен барамын. Бұл ереже.
Dialogue: 0,1:22:46.90,1:22:49.86,Default,,0000,0000,0000,,Бірақ мен күтпеймін, Киёши.
Dialogue: 0,1:22:50.87,1:22:53.87,Default,,0000,0000,0000,,Мені қаласаң, келіп ал.
Dialogue: 0,1:22:56.87,1:22:58.87,Default,,0000,0000,0000,,《Ей Рейо, мені тыңда》
Dialogue: 0,1:22:58.87,1:23:03.85,Default,,0000,0000,0000,,《Менен де, Киёшиден де жақсы біреу бар.》
Dialogue: 0,1:23:04.88,1:23:07.88,Default,,0000,0000,0000,,《Жағдай өте нашар》
Dialogue: 0,1:23:07.88,1:23:09.88,Default,,0000,0000,0000,,《Ары қарай, жеңілсең, бітті...》
Dialogue: 0,1:23:09.88,1:23:13.86,Default,,0000,0000,0000,,《Бірақ... Неге... 》
Dialogue: 0,1:23:13.86,1:23:16.86,Default,,0000,0000,0000,,《Мен қазір өте көңілді болуы мүмкін》
Dialogue: 0,1:23:16.86,1:23:20.90,Default,,0000,0000,0000,,《Мен
Dialogue: 0,1:23:16.86,1:23:20.90,Default,,0000,0000,0000,,Мен заттардың тез өзгеріп жатқанын көріп тұрмын》
Dialogue: 0,1:23:20.90,1:23:23.87,Default,,0000,0000,0000,,《Мен әлі үйге барғым келмейді》
Dialogue: 0,1:23:23.87,1:23:25.87,Default,,0000,0000,0000,,《Мен көбірек футбол ойнағым келеді...》
Dialogue: 0,1:23:25.87,1:23:27.87,Default,,0000,0000,0000,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,1:23:28.87,1:23:30.87,Default,,0000,0000,0000,,《Мен жеңгім келеді》
Dialogue: 0,1:23:30.87,1:23:32.84,Default,,0000,0000,0000,,《Мен күшті болғым келеді》
Dialogue: 0,1:23:33.91,1:23:38.91,Default,,0000,0000,0000,,《Мен осылай өмір сүргеніме сене алмаймын.
Dialogue: 0,1:23:33.91,1:23:38.91,Default,,0000,0000,0000,,Мен Көк жартасқа келгенше білмедім...》
Dialogue: 0,1:23:39.88,1:23:43.89,Default,,0000,0000,0000,,《Егер мен сені кездестірмесем, оны ала алмас едім...》
Dialogue: 0,1:23:46.89,1:23:49.86,Default,,0000,0000,0000,,《Ей, Рейо, егер біз тағы кездессек...》
Dialogue: 0,1:23:51.89,1:23:54.86,Default,,0000,0000,0000,,《Мен айтқым келетін нәрселер өте көп》
Dialogue: 0,1:23:54.86,1:24:00.87,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:24:00.87,1:24:03.87,Default,,0000,0000,0000,,《Көп нәрсе өзгерді...》
Dialogue: 0,1:24:05.87,1:24:07.84,Default,,0000,0000,0000,,《Қызықты, солай емес пе?》
Dialogue: 0,1:24:11.88,1:24:14.88,Default,,0000,0000,0000,,Қарсылас – Сае Итоси бастаған 20 жасқа дейінгі Жапония ұлттық құрамасы.
Dialogue: 0,1:24:15.92,1:24:18.89,Default,,0000,0000,0000,,Жеңілсең, Көк жартас жоғалады.
Dialogue: 0,1:24:18.89,1:24:23.89,Default,,0000,0000,0000,,Олардың арасына кіріңіз
Dialogue: 0,1:24:18.89,1:24:23.89,Default,,0000,0000,0000,,Ең бастысы - өз өміріңізді қалай насихаттауға болады!
Dialogue: 0,1:24:23.89,1:24:26.90,Default,,0000,0000,0000,,Сіз А командасының саңылауысыз.
Dialogue: 0,1:24:26.90,1:24:29.90,Default,,0000,0000,0000,,Бұлай жалғаса берсе, біз ештеңе істей алмай қаламыз!
Dialogue: 0,1:24:29.90,1:24:31.93,Default,,0000,0000,0000,,<Осыдан кейін түн ортасынан бастап →
Dialogue: 0,1:24:31.93,1:24:36.91,Default,,0000,0000,0000,,Телехикаяның екінші маусымы
Dialogue: 0,1:24:31.93,1:24:36.91,Default,,0000,0000,0000,,«Blue Rock VS. U-20 JAPAN» басталуы>
Dialogue: 0,1:24:36.91,1:24:39.87,Default,,0000,0000,0000,,Мен әлемдегі ең үздік шабуылшы боламын! !
Dialogue: 0,1:24:41.88,1:24:59.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:24:59.89,1:25:17.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:25:17.88,1:25:20.88,Default,,0000,0000,0000,,Балалар, сендермен бірге жасаймыз деп шешілді.
Dialogue: 0,1:25:20.88,1:25:24.92,Default,,0000,0000,0000,,Сол себепті, И
Dialogue: 0,1:25:20.88,1:25:24.92,Default,,0000,0000,0000,,Себебі мен осы балалармен бірге болдым.
Dialogue: 0,1:25:24.92,1:25:26.89,Default,,0000,0000,0000,,Тыңдаңыз, Рей патша!
Dialogue: 0,1:25:24.92,1:25:26.89,Default,,0000,0000,0000,,(қол шапалақтау дыбысы)
Dialogue: 0,1:25:26.89,1:25:28.89,Default,,0000,0000,0000,,Сен екеуміз жау болып кеттік, Наги...
Dialogue: 0,1:25:28.89,1:25:31.89,Default,,0000,0000,0000,,Мені таңдамаған сен→
Dialogue: 0,1:25:31.89,1:25:33.90,Default,,0000,0000,0000,,Мен сені осы жерде талқандаймын.
Dialogue: 0,1:25:33.90,1:25:40.87,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:25:40.87,1:26:02.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:26:02.89,1:26:24.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:26:24.88,1:26:27.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:26:27.88,1:26:31.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:26:31.89,1:26:38.86,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:26:40.86,1:26:44.90,Default,,0000,0000,0000,,«Мм...
Dialogue: 0,1:26:40.86,1:26:44.90,Default,,0000,0000,0000,,Ал, неше түрлі...→
Dialogue: 0,1:26:44.90,1:26:46.87,Default,,0000,0000,0000,,Жоспарлар өзгерді».
Dialogue: 0,1:26:46.87,1:26:49.87,Default,,0000,0000,0000,,«Шамасы, жапон футболындағы үлкен атаулар →
Dialogue: 0,1:26:49.87,1:26:53.88,Default,,0000,0000,0000,,Бұл көк құлып
Dialogue: 0,1:26:49.87,1:26:53.88,Default,,0000,0000,0000,,Олар оны бірден жойғысы келетін сияқты».
Dialogue: 0,1:26:53.88,1:26:57.88,Default,,0000,0000,0000,,«Сондай батылдық
Dialogue: 0,1:26:53.88,1:26:57.88,Default,,0000,0000,0000,,Мен шағым бердім».
Dialogue: 0,1:26:57.88,1:27:01.88,Default,,0000,0000,0000,,«Сонымен, келесі таңдау үш аптадан кейін болады.»
Dialogue: 0,1:27:01.88,1:27:05.92,Default,,0000,0000,0000,,«Көк жартастың аман қалуы үшін шайқас...»
Dialogue: 0,1:27:05.92,1:27:10.89,Default,,0000,0000,0000,,«U-20 Жапония құрамасы Blue Rock Elevenге қарсы
Dialogue: 0,1:27:05.92,1:27:10.89,Default,,0000,0000,0000,,Бұл ерекше үлкен матч».
Dialogue: 0,1:27:11.89,1:27:13.90,Default,,0000,0000,0000,,«Егер бұл матчты жеңсек →
Dialogue: 0,1:27:13.90,1:27:18.87,Default,,0000,0000,0000,,Біз, Көк жартас,
Dialogue: 0,1:27:13.90,1:27:18.87,Default,,0000,0000,0000,,Сіз U-20 Жапония құрамасына қатыса аласыз.
Dialogue: 0,1:27:23.87,1:27:47.86,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:27:50.90,1:27:56.90,Default,,0000,0000,0000,,<Данышпан деген не?
Dialogue: 0,1:27:50.90,1:27:56.90,Default,,0000,0000,0000,,Ешқашан данышпан бола алмайтын жаратылыс.
Dialogue: 0,1:27:56.90,1:28:00.91,Default,,0000,0000,0000,,〈Оны табатын адам болса ғана.''
Dialogue: 0,1:27:56.90,1:28:00.91,Default,,0000,0000,0000,,оның сұлбасын құрайды〉
Dialogue: 0,1:28:04.88,1:28:07.88,Default,,0000,0000,0000,,Тыңдаңдар, таланттың асыл тастары.
Dialogue: 0,1:28:07.88,1:28:10.89,Default,,0000,0000,0000,,Әлем сені әлі танымайды.
Dialogue: 0,1:28:11.89,1:28:14.89,Default,,0000,0000,0000,,Осы 90 минутта тағдырыңызды өзгертіңіз.
Dialogue: 0,1:28:14.89,1:28:18.89,Default,,0000,0000,0000,,Бүгін әлемге өз эгоыңызды ойып алыңыз!
Dialogue: 0,1:28:18.89,1:28:21.90,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,1:28:18.89,1:28:21.90,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:28:26.90,1:28:28.90,Default,,0000,0000,0000,,Кеттік, Наги.
Dialogue: 0,1:28:28.90,1:28:30.91,Default,,0000,0000,0000,,Енді жүр.
Dialogue: 0,1:28:32.91,1:28:34.91,Default,,0000,0000,0000,,Наги.
Dialogue: 0,1:28:42.88,1:28:45.89,Default,,0000,0000,0000,,Маған данышпандығыңызды көрсетіңіз.
Dialogue: 0,1:28:45.89,1:28:47.89,Default,,0000,0000,0000,,Иә….
Dialogue: 0,1:28:47.89,1:28:49.89,Default,,0000,0000,0000,,Күтіңіз.
Dialogue: 0,1:28:49.89,1:28:51.89,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:28:51.89,1:29:00.94,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:29:00.94,1:29:05.87,Default,,0000,0000,0000,,⚟ (қуаныш)
Dialogue: 0,1:29:05.87,1:29:14.88,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:29:14.88,1:29:16.88,Default,,0000,0000,0000,,Бұл әлем...
Dialogue: 0,1:29:16.88,1:29:21.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:29:21.89,1:29:24.96,Default,,0000,0000,0000,,《Тағдырға шақыру...》
Dialogue: 0,1:29:24.96,1:29:26.89,Default,,0000,0000,0000,,《Біздің бастамамыз...》
Dialogue: 0,1:29:26.89,1:29:33.90,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:29:33.90,1:29:36.90,Default,,0000,0000,0000,,《Мені бақылаңыз, Рей патша》
Dialogue: 0,1:29:36.90,1:29:38.87,Default,,0000,0000,0000,,《Менің қызбам...→
Dialogue: 0,1:29:38.87,1:29:40.88,Default,,0000,0000,0000,,Менің эго...》
Dialogue: 0,1:29:40.88,1:29:45.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:29:49.88,1:29:51.89,Default,,0000,0000,0000,,《Танысқаныма қуаныштымын Жапония》
Dialogue: 0,1:29:51.89,1:29:56.89,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,1:29:56.89,1:30:00.86,Default,,0000,0000,0000,,Мен Сейширо Нагимін.
Dialogue: 0,1:30:27.86,1:30:31.86,Default,,0000,0000,0000,,Екінші іріктеуден өткен 35 адам
Dialogue: 0,1:30:27.86,1:30:31.86,Default,,0000,0000,0000,,Бәрі дайын, Ешін-сан.
Dialogue: 0,1:30:31.86,1:30:33.86,Default,,0000,0000,0000,,Ах... Бастапқы жоспардан өзгергенімен →
Dialogue: 0,1:30:33.86,1:30:38.87,Default,,0000,0000,0000,,Мен бұл балалармен жапон футболын жоямын.
Dialogue: 0,1:30:33.86,1:30:38.87,Default,,0000,0000,0000,,Эгоист ұжымды дамыту.
Dialogue: 0,1:30:38.87,1:30:43.84,Default,,0000,0000,0000,,Үш апта қалды...
Dialogue: 0,1:30:38.87,1:30:43.84,Default,,0000,0000,0000,,Біз барлық 35 мүшені тағы да растаймыз.
Dialogue: 0,1:30:52.85,1:30:54.85,Default,,0000,0000,0000,,рейтингте 1 орын →
Dialogue: 0,1:30:54.85,1:30:56.85,Default,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,1:30:54.85,1:30:56.85,Default,,0000,0000,0000,,Оны жеу үшін дамуды жалғастырыңыз
Dialogue: 0,1:30:54.85,1:30:56.85,Default,,0000,0000,0000,,Киёшиичи….
Dialogue: 0,1:30:56.85,1:30:58.85,Default,,0000,0000,0000,,Олар ұжымның өзегі болып табылады.
Dialogue: 0,1:30:56.85,1:30:58.85,Default,,0000,0000,0000,,Мүмкін сияқты.
Dialogue: 0,1:31:07.86,1:31:09.90,Default,,0000,0000,0000,,Эгосы оянған данышпан→
Dialogue: 0,1:31:09.90,1:31:11.87,Default,,0000,0000,0000,,Диктатор патша жеңді ме?
Dialogue: 0,1:31:11.87,1:31:13.87,Default,,0000,0000,0000,,Жеке дағдыға көңіл бөлетіндер→
Dialogue: 0,1:31:13.87,1:31:15.87,Default,,0000,0000,0000,,Командаға не қосу керек
Dialogue: 0,1:31:13.87,1:31:15.87,Default,,0000,0000,0000,,Бұл қиын көрінеді.
Dialogue: 0,1:31:24.88,1:31:27.88,Default,,0000,0000,0000,,Қарға саяхатшы және Отоя Кагета
Dialogue: 0,1:31:24.88,1:31:27.88,Default,,0000,0000,0000,,Бұл негізгі таңдаудан алынған тег пе?
Dialogue: 0,1:31:27.88,1:31:30.89,Default,,0000,0000,0000,,Айтарлықтай тұрақтылықпен
Dialogue: 0,1:31:27.88,1:31:30.89,Default,,0000,0000,0000,,Біз жеңіп жатырмыз.
Dialogue: 0,1:31:39.86,1:31:41.86,Default,,0000,0000,0000,,Бұл өрескел, бірақ→
Dialogue: 0,1:31:41.86,1:31:43.87,Default,,0000,0000,0000,,Өсуге әлі де орын бар
Dialogue: 0,1:31:41.86,1:31:43.87,Default,,0000,0000,0000,,Ықтимал мүше.
Dialogue: 0,1:31:51.87,1:31:54.88,Default,,0000,0000,0000,,Өзіңіздің әлсіз жақтарыңызды мойындаңыз
Dialogue: 0,1:31:51.87,1:31:54.88,Default,,0000,0000,0000,,Қару-жарақтарыңызды жетілдіріп, жеңіске жеттіңіздер ме?
Dialogue: 0,1:32:03.89,1:32:05.85,Default,,0000,0000,0000,,Бұл өте белсенді команда...
Dialogue: 0,1:32:06.89,1:32:08.86,Default,,0000,0000,0000,,Соңғы….
Dialogue: 0,1:32:15.86,1:32:17.87,Default,,0000,0000,0000,,Сондай-ақ біршама
Dialogue: 0,1:32:15.86,1:32:17.87,Default,,0000,0000,0000,,Олар бірегей мүшелер.
Dialogue: 0,1:32:17.87,1:32:19.87,Default,,0000,0000,0000,,Рюсей
Dialogue: 0,1:32:17.87,1:32:19.87,Default,,0000,0000,0000,,Әсіресе Шидо Рюсей-кун...
Dialogue: 0,1:32:19.87,1:32:21.90,Default,,0000,0000,0000,,Мінез-құлқында проблемалар болса да→
Dialogue: 0,1:32:21.90,1:32:24.91,Default,,0000,0000,0000,,Тек өз мақсаттарыңызға берік болыңыз
Dialogue: 0,1:32:21.90,1:32:24.91,Default,,0000,0000,0000,,Эго шынайы болды.
Dialogue: 0,1:32:24.91,1:32:26.87,Default,,0000,0000,0000,,35-тен астам адам. Осыдан →
Dialogue: 0,1:32:26.87,1:32:29.88,Default,,0000,0000,0000,,Sae
Dialogue: 0,1:32:26.87,1:32:29.88,Default,,0000,0000,0000,,Сае Итоши басқарған
Dialogue: 0,1:32:26.87,1:32:29.88,Default,,0000,0000,0000,,20 жасқа дейінгі Жапония құрамасына қарсы шығу→
Dialogue: 0,1:32:29.88,1:32:31.88,Default,,0000,0000,0000,,Он бір таңдау….
Dialogue: 0,1:32:31.88,1:32:33.88,Default,,0000,0000,0000,,Олар жеңе ала ма? Ешин мырза.
Dialogue: 0,1:32:33.88,1:32:38.85,Default,,0000,0000,0000,,Бұл ақымақ сұрақ.
Dialogue: 0,1:32:33.88,1:32:38.85,Default,,0000,0000,0000,,Заманды өзгертетін біз, Көк жартас.
Dialogue: 0,1:32:44.86,1:32:47.83,Default,,0000,0000,0000,,Қарсылас – Сае Итоси бастаған 20 жасқа дейінгі Жапония құрамасы.
Dialogue: 0,1:32:48.86,1:32:51.87,Default,,0000,0000,0000,,Жеңілсең, Көк жартас жоғалады.
Dialogue: 0,1:32:51.87,1:32:56.87,Default,,0000,0000,0000,,Олардың арасына кіріңіз
Dialogue: 0,1:32:51.87,1:32:56.87,Default,,0000,0000,0000,,Ең бастысы, сіз өз өміріңізді қалай алға жылжыта аласыз!
Dialogue: 0,1:32:56.87,1:32:59.84,Default,,0000,0000,0000,,Сіз А тобының саңылауысыз.
Dialogue: 0,1:32:59.84,1:33:02.88,Default,,0000,0000,0000,,Бұлай жалғаса берсе, біз ештеңе істей алмай қаламыз!
Dialogue: 0,1:33:02.88,1:33:06.88,Default,,0000,0000,0000,,〈Телехикая 2 маусым
Dialogue: 0,1:33:02.88,1:33:06.88,Default,,0000,0000,0000,,“Blue Rock VS. U-20 JAPANIA”〉
Dialogue: 0,1:33:06.88,1:33:08.85,Default,,0000,0000,0000,,〈Бірінші рет дәл осыдан кейін болады! 〉
Dialogue: 0,1:33:09.85,1:33:12.85,Default,,0000,0000,0000,,Мен әлемдегі ең үздік шабуылшы боламын! !
