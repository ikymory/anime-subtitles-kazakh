Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.03,0:00:43.73,Default,,0,0,0,,Иә? Бұл кобра қайда барады?
Dialogue: 0,0:00:47.24,0:00:50.45,Default,,0,0,0,,Осы жерге дейін кел де, менің үйімнің жанынан өт.
Dialogue: 0,0:00:50.45,0:00:53.75,Default,,0,0,0,,Мен бұны жұлып аламын.
Dialogue: 0,0:01:01.86,0:01:06.76,Default,,0,0,0,,Бетіңізді мүлде көрсетпеңіз.
Dialogue: 0,0:01:06.76,0:01:11.86,Default,,0,0,0,,Бірақ, кешіріңіз, сіз өзіңіздің жаман аузыңызға бірдеңе жасай алмайсыз ба?
Dialogue: 0,0:01:21.74,0:01:25.95,Default,,0,0,0,,Эй Джим, бұл дүкен әлі жұмысын тоқтатқан жоқ па?
Dialogue: 0,0:01:25.95,0:01:28.85,Default,,0,0,0,,Эй, Кобра, бұл дұрыс емес.
Dialogue: 0,0:01:30.79,0:01:34.66,Default,,0,0,0,,Мартини, оны кептіріңіз.
Dialogue: 0,0:01:34.66,0:01:37.96,Default,,0,0,0,,Кобра, сені біреу күтіп тұр.
Dialogue: 0,0:01:40.00,0:01:42.00,Default,,0,0,0,,Менің саған бір қатысым бар сияқты.
Dialogue: 0,0:01:42.00,0:01:45.80,Default,,0,0,0,,Мен осында соңғы аптада күтіп жүрмін.
Dialogue: 0,0:01:50.24,0:01:52.24,Default,,0,0,0,,Мына алаяқ
Dialogue: 0,0:01:54.41,0:01:56.41,Default,,0,0,0,,Мен сені бір жерде кездестірдім бе?
Dialogue: 0,0:01:58.31,0:02:02.75,Default,,0,0,0,,Сендей сұлуды ұмытуым мүмкін емес.
Dialogue: 0,0:02:02.75,0:02:05.65,Default,,0,0,0,,Жоқ, бұл біздің бірінші кездесуіміз, Кобра мырза.
Dialogue: 0,0:02:05.65,0:02:08.36,Default,,0,0,0,,Менің атым Элизабет Такер
Dialogue: 0,0:02:08.36,0:02:11.39,Default,,0,0,0,,Негізі мен сізден көмек сұрағым келеді.
Dialogue: 0,0:02:11.39,0:02:14.80,Default,,0,0,0,,Сондықтан мені осылай күтті.
Dialogue: 0,0:02:14.80,0:02:17.20,Default,,0,0,0,,Менің көмегім?
Dialogue: 0,0:02:17.20,0:02:20.54,Default,,0,0,0,,Өкінішке орай, біз қазір жабықпыз.
Dialogue: 0,0:02:20.54,0:02:23.57,Default,,0,0,0,,Дегенмен, артқы жағындағы найзағайды түсіргіңіз келсе.
Dialogue: 0,0:02:23.57,0:02:25.97,Default,,0,0,0,,Мен саған кез келген көмекті беремін.
Dialogue: 0,0:02:28.84,0:02:34.95,Default,,0,0,0,,Жоқ, менің ұсынысымнан бас тарта алмайсың.
Dialogue: 0,0:02:34.95,0:02:37.19,Default,,0,0,0,,Менің сол көзіме қара
Dialogue: 0,0:02:37.19,0:02:39.89,Default,,0,0,0,,Көзге мұқият қараңыз.
Dialogue: 0,0:02:41.89,0:02:45.29,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:02:45.29,0:02:47.30,Default,,0,0,0,,Маған көмектесші, Кобра
Dialogue: 0,0:02:47.30,0:02:50.00,Default,,0,0,0,,Мені бұл жерден кетіріңіз
Dialogue: 0,0:02:50.00,0:02:51.93,Default,,0,0,0,,Құпия!
Dialogue: 0,0:02:51.93,0:02:56.77,Default,,0,0,0,,Менің сол көзім - ғарыштық түрме.
Dialogue: 0,0:02:56.77,0:03:01.61,Default,,0,0,0,,Оны бұл жерден менен басқа ешкім шығара алмайды.
Dialogue: 0,0:03:01.61,0:03:04.05,Default,,0,0,0,,Сіз қалай ойлайсыз? сенің ең қымбат адамың
Dialogue: 0,0:03:04.05,0:03:07.05,Default,,0,0,0,,Мен өлгенше мені осында қалдыруға болады.
Dialogue: 0,0:03:07.05,0:03:09.18,Default,,0,0,0,,Енді түсіндің.
Dialogue: 0,0:03:09.18,0:03:12.58,Default,,0,0,0,,Менің ұсынысымнан бас тарта алмайсың
Dialogue: 0,0:03:15.59,0:03:20.49,Default,,0,0,0,,Мен сені Назкаға ертіп барамын.
Dialogue: 0,0:03:24.43,0:03:27.07,Default,,0,0,0,,Егер сізге қазірден бастап сұлу әйел жақындаса
Dialogue: 0,0:03:27.07,0:03:30.07,Default,,0,0,0,,Мен қатты айқайлап, қашып кетемін.
Dialogue: 0,0:05:16.41,0:05:20.38,Default,,0,0,0,,Дұрыс, мен сені қалған үш адаммен таныстырамын.
Dialogue: 0,0:05:20.38,0:05:22.85,Default,,0,0,0,,Әдетте «көз» деп аталады
Dialogue: 0,0:05:22.85,0:05:27.06,Default,,0,0,0,,Қараңғыда да бір шаштың түсін ажыратуға болады.
Dialogue: 0,0:05:27.06,0:05:31.79,Default,,0,0,0,,Оның «құлақтары» бар, тіпті бір шақырым жерде маса қанатының дыбысын да жібермейді.
Dialogue: 0,0:05:31.79,0:05:35.66,Default,,0,0,0,,«Мұрын» Оның иіс сезу қабілеті иттікінен жақсы.
Dialogue: 0,0:05:35.66,0:05:38.30,Default,,0,0,0,,Бұл жігіт керемет
Dialogue: 0,0:05:38.30,0:05:42.30,Default,,0,0,0,,Сонда мен ақылды сөйлейтінмін бе?
Dialogue: 0,0:05:42.30,0:05:45.77,Default,,0,0,0,,Бұл мүшеде мен іздеген нәрсе бар.
Dialogue: 0,0:05:45.77,0:05:48.51,Default,,0,0,0,,Мен оларды табу үшін жинадым.
Dialogue: 0,0:05:48.51,0:05:52.51,Default,,0,0,0,,Демек, сен солардың бірісің, айтпақшы, сен.
Dialogue: 0,0:05:52.51,0:05:56.62,Default,,0,0,0,,Сіз мандрадо деген өсімдік туралы естідіңіз бе?
Dialogue: 0,0:05:56.62,0:05:58.55,Default,,0,0,0,,Мандрад?
Dialogue: 0,0:05:58.55,0:06:03.39,Default,,0,0,0,,Бұл біз іздеп жатқан нәрсе
Dialogue: 0,0:06:03.39,0:06:07.83,Default,,0,0,0,,Мандрадо Өйткені гүл адамның бетіне ұқсайды
Dialogue: 0,0:06:07.83,0:06:10.17,Default,,0,0,0,,Адам бетінің шөптері деп те аталады
Dialogue: 0,0:06:10.17,0:06:12.10,Default,,0,0,0,,Оның дәмі нашар.
Dialogue: 0,0:06:12.10,0:06:15.37,Default,,0,0,0,,Сонымен, сіз осындай нәрсені іздегенде не істейсіз?
Dialogue: 0,0:06:15.37,0:06:20.21,Default,,0,0,0,,Аузыңыздың ішіне мұқият қараңыз.
Dialogue: 0,0:06:20.21,0:06:23.98,Default,,0,0,0,,Иә, бұл тіс.
Dialogue: 0,0:06:23.98,0:06:26.05,Default,,0,0,0,,Бұл гауһар тас
Dialogue: 0,0:06:26.05,0:06:29.52,Default,,0,0,0,,Бағасы жоқ, бұл нағыз гауһар тас
Dialogue: 0,0:06:29.52,0:06:32.42,Default,,0,0,0,,Не? Мандрадо
Dialogue: 0,0:06:32.42,0:06:37.09,Default,,0,0,0,,Ағаш әлі жас болған кезде осындай алмас тістерді қосыңыз.
Dialogue: 0,0:06:37.09,0:06:39.03,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:06:39.03,0:06:42.90,Default,,0,0,0,,Мандрадо тұқымдары тек аналық ағаш өскеннен кейін ғана өндіріледі.
Dialogue: 0,0:06:42.90,0:06:45.80,Default,,0,0,0,,Ал ата-ана болу үшін 100 жыл қажет.
Dialogue: 0,0:06:52.98,0:06:55.44,Default,,0,0,0,,Бірақ егер біреу ата-аналық ағашты тауып алса ше?
Dialogue: 0,0:06:55.44,0:07:00.42,Default,,0,0,0,,Сіз не болады деп ойлайсыз? Егер сіз тұқым тапсаңыз, ол жас ағашқа айналады
Dialogue: 0,0:07:00.42,0:07:04.69,Default,,0,0,0,,Иә, ол адам үлкен байлық таба алады.
Dialogue: 0,0:07:04.69,0:07:08.22,Default,,0,0,0,,Ал бір ай бұрын, менің күйеуім, зерттеуші,
Dialogue: 0,0:07:08.22,0:07:12.69,Default,,0,0,0,,Мен Наскадағы ата-ана ағашын таптым.
Dialogue: 0,0:07:12.69,0:07:14.63,Default,,0,0,0,,Қараңдаршы, солай.
Dialogue: 0,0:07:14.63,0:07:17.23,Default,,0,0,0,,Бұл Мандрадоның ата-аналық ағашы.
Dialogue: 0,0:07:28.91,0:07:32.38,Default,,0,0,0,,Бұл ата-аналық ағаштың жасы 2000 жылдан астам деп есептеледі.
Dialogue: 0,0:07:32.38,0:07:36.15,Default,,0,0,0,,Диаметрі 600 метрден әлдеқайда жоғары.
Dialogue: 0,0:07:36.15,0:07:39.05,Default,,0,0,0,,Мандрадо тұқымын діңнің астында сақтайды.
Dialogue: 0,0:07:39.05,0:07:42.92,Default,,0,0,0,,Басқаша айтқанда, осы судың үстінде жайылған үлкен тамырдың ортасында.
Dialogue: 0,0:07:42.92,0:07:44.89,Default,,0,0,0,,Тағады дейді
Dialogue: 0,0:07:44.89,0:07:48.56,Default,,0,0,0,,Осы түбір арқылы өтіп, шамамен 300 метрге кіріңіз.
Dialogue: 0,0:07:48.56,0:07:51.10,Default,,0,0,0,,Тұқымдар бар.
Dialogue: 0,0:07:51.10,0:07:54.07,Default,,0,0,0,,Сіз сол тұқымға құпияларды айырбастап жатырсыз.
Dialogue: 0,0:07:54.07,0:07:56.07,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:56.07,0:07:59.17,Default,,0,0,0,,Ал, мен біраз уақытқа барайын.
Dialogue: 0,0:08:03.55,0:08:06.85,Default,,0,0,0,,А? Эй, бұл пикник емес.
Dialogue: 0,0:08:06.85,0:08:10.65,Default,,0,0,0,,Жалғыз маған көп, бірақ кедергі болады.
Dialogue: 0,0:08:10.65,0:08:13.99,Default,,0,0,0,,Жоқ, мен сені менімен бірге жіберемін.
Dialogue: 0,0:08:13.99,0:08:17.99,Default,,0,0,0,,Олардың қабілеттеріне сенуге болады.
Dialogue: 0,0:08:17.99,0:08:20.83,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:20.83,0:08:26.43,Default,,0,0,0,,Жарайды, олай болса барлығы, себеттер мен қолшатырларды ұмытпаңдар.
Dialogue: 0,0:08:32.34,0:08:36.11,Default,,0,0,0,,Бірақ бұл қорқынышты жер.
Dialogue: 0,0:08:36.11,0:08:40.31,Default,,0,0,0,,Көздер, тік алға, о, білемін.
Dialogue: 0,0:08:42.28,0:08:44.28,Default,,0,0,0,,Бұл өте күрделі.
Dialogue: 0,0:08:46.19,0:08:49.69,Default,,0,0,0,,Балықтың иісі бар. Өлімнің иісі бар.
Dialogue: 0,0:08:49.69,0:08:53.46,Default,,0,0,0,,Мені көре алмағаныңызға қуаныштымын
Dialogue: 0,0:08:53.46,0:08:56.16,Default,,0,0,0,,Бұл аймақ адам сүйегіне толы.
Dialogue: 0,0:08:58.30,0:09:01.30,Default,,0,0,0,,Адам мәйіті?
Dialogue: 0,0:09:03.81,0:09:09.31,Default,,0,0,0,,Кобра, бұл жұмысқа неліктен төртеуміз таңдалды деп ойлайсың?
Dialogue: 0,0:09:09.31,0:09:11.61,Default,,0,0,0,,Өйткені төртеуі де сымбатты.
Dialogue: 0,0:09:13.65,0:09:15.68,Default,,0,0,0,,Осы Мандрадо ата-аналық ағашын енгізіңіз.
Dialogue: 0,0:09:15.68,0:09:18.89,Default,,0,0,0,,Ешкім тірі оралмады дейді.
Dialogue: 0,0:09:18.89,0:09:21.32,Default,,0,0,0,,Ол әйелде біздің қабілеттеріміз бар.
Dialogue: 0,0:09:21.32,0:09:26.96,Default,,0,0,0,,Өлмейтін кобра деген сенің күшіңе бәс тігемін.
Dialogue: 0,0:09:26.96,0:09:31.80,Default,,0,0,0,,Алайда бұл ата-ана ағашын ашқан әйелдің күйеуі бар.
Dialogue: 0,0:09:31.80,0:09:35.04,Default,,0,0,0,,Көшеттерді осы жерден тірідей қайтарған шығар.
Dialogue: 0,0:09:35.04,0:09:37.51,Default,,0,0,0,,Жарайды, бірақ Якко-сан
Dialogue: 0,0:09:37.51,0:09:41.04,Default,,0,0,0,,Ол кезде есінен танып қалған сияқты.
Dialogue: 0,0:09:41.04,0:09:43.04,Default,,0,0,0,,(Юки) Қыз ба? (Миямура) Ұл ба?
Dialogue: 0,0:09:45.38,0:09:50.29,Default,,0,0,0,,Эй, саған бірдеңе керек болса, маған айтасың.
Dialogue: 0,0:09:50.29,0:09:53.66,Default,,0,0,0,,Олар кездескісі келеді.
Dialogue: 0,0:09:53.66,0:09:55.66,Default,,0,0,0,,...Таку қазірдің өзінде
Dialogue: 0,0:09:59.76,0:10:02.66,Default,,0,0,0,,Осы жерден су тереңдей түседі.
Dialogue: 0,0:10:02.66,0:10:04.96,Default,,0,0,0,,Жаяу жүру мүмкін емес.
Dialogue: 0,0:10:10.21,0:10:12.91,Default,,0,0,0,,Үндетпе Алда төбе
Dialogue: 0,0:10:12.91,0:10:15.61,Default,,0,0,0,,Батпақтан шыға алатын сияқтымыз.
Dialogue: 0,0:10:24.42,0:10:26.35,Default,,0,0,0,,Тезірек жүгір!
Dialogue: 0,0:10:26.35,0:10:28.35,Default,,0,0,0,,Құлағыңызға не болды?
Dialogue: 0,0:10:36.57,0:10:39.17,Default,,0,0,0,,Ой, бұл реактивті пиранья.
Dialogue: 0,0:11:02.72,0:11:05.42,Default,,0,0,0,,Боқ, ағашқа жүгір.
Dialogue: 0,0:11:15.24,0:11:17.81,Default,,0,0,0,,Екеуің жақсысыңдар.
Dialogue: 0,0:11:17.81,0:11:19.81,Default,,0,0,0,,Эй, мұрның ше?
Dialogue: 0,0:11:24.01,0:11:26.08,Default,,0,0,0,,Ол қайдан шыққан?
Dialogue: 0,0:11:26.08,0:11:29.32,Default,,0,0,0,,Мұрын? Бұл кездейсоқ блеф пе?
Dialogue: 0,0:11:29.32,0:11:31.25,Default,,0,0,0,,Тез қашпасаң, жем боласың.
Dialogue: 0,0:11:31.25,0:11:36.66,Default,,0,0,0,,Дөрекі болма, сен сияқты менің иіс сезуім оған кедергі бола алмайды.
Dialogue: 0,0:11:36.66,0:11:38.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:41.50,0:11:43.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:08.06,0:12:10.26,Default,,0,0,0,,Қазір жүгіріңіз!
Dialogue: 0,0:12:31.61,0:12:35.32,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:12:35.32,0:12:40.02,Default,,0,0,0,,Бұл мен естіген психомылтық па? Сізге рахмет, мен құтқарылдым.
Dialogue: 0,0:12:42.56,0:12:45.36,Default,,0,0,0,,Мұрын... Мұрын күт!
Dialogue: 0,0:12:45.36,0:12:47.66,Default,,0,0,0,,Жалғыз жүрмеңіз.
Dialogue: 0,0:12:59.54,0:13:02.14,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:13:05.21,0:13:08.21,Default,,0,0,0,,Құлақ Бұл саңырауқұлақ.
Dialogue: 0,0:13:16.49,0:13:20.96,Default,,0,0,0,,Қарғыс атсын, бұл саңырауқұлақ жарылғыш сияқты.
Dialogue: 0,0:13:20.96,0:13:23.66,Default,,0,0,0,,Бұл табиғи мина алаңы сияқты.
Dialogue: 0,0:13:25.70,0:13:27.64,Default,,0,0,0,,Мен қозғала алмаймын.
Dialogue: 0,0:13:27.64,0:13:30.64,Default,,0,0,0,,Ол тіпті шөпте жасырылған болуы мүмкін.
Dialogue: 0,0:13:32.61,0:13:35.98,Default,,0,0,0,,Алдымен барыңыз.
Dialogue: 0,0:13:35.98,0:13:37.98,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:41.75,0:13:44.25,Default,,0,0,0,,Жақсысың ба, Кобра?
Dialogue: 0,0:13:46.29,0:13:51.39,Default,,0,0,0,,Егер шахта болса, мен сізге хабарлаймын. Естен кетпеңіз.
Dialogue: 0,0:13:59.83,0:14:04.34,Default,,0,0,0,,Хмм... Мина алаңын тазалаған сияқтымыз.
Dialogue: 0,0:14:04.34,0:14:07.54,Default,,0,0,0,,Мен ойладым, енді тікенді ме?
Dialogue: 0,0:14:07.54,0:14:12.01,Default,,0,0,0,,Уф... Не болды, күйеу? Әрі қарай жүрейік
Dialogue: 0,0:14:12.01,0:14:14.01,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:17.82,0:14:22.12,Default,,0,0,0,,Ей, сен жәндіктерден қорықпайсың.
Dialogue: 0,0:14:22.12,0:14:24.72,Default,,0,0,0,,А... Мен жәндіктерден қорқамын ба?
Dialogue: 0,0:14:27.10,0:14:29.80,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:14:29.80,0:14:32.33,Default,,0,0,0,,Бұл күлкілі. Барайық.
Dialogue: 0,0:14:32.33,0:14:34.27,Default,,0,0,0,,Хе хе хе хе хе
Dialogue: 0,0:14:34.27,0:14:37.47,Default,,0,0,0,,Біз бұл ағаштың ортасына жақын болуымыз керек.
Dialogue: 0,0:14:41.68,0:14:44.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:44.35,0:14:47.65,Default,,0,0,0,,Көздеріңе не болды?
Dialogue: 0,0:14:47.65,0:14:49.72,Default,,0,0,0,,Бұл жігіттер бұтақ емес.
Dialogue: 0,0:14:49.72,0:14:52.42,Default,,0,0,0,,Бұл жәндіктердің алып аяғы.
Dialogue: 0,0:14:52.42,0:14:55.12,Default,,0,0,0,,Шүкір, жегенге шыдай алмаймын.
Dialogue: 0,0:15:01.46,0:15:04.20,Default,,0,0,0,,Оның жақсы көруі кінәлі.
Dialogue: 0,0:15:04.20,0:15:07.77,Default,,0,0,0,,Кішкентай жәндікке көңілім ауып кеткені сонша, үлкенін көре алмадым.
Dialogue: 0,0:15:07.77,0:15:10.74,Default,,0,0,0,,Жоқ, алдыңдағы қабырғаға қара.
Dialogue: 0,0:15:10.74,0:15:12.74,Default,,0,0,0,,Сіз шыбықты боласыз.
Dialogue: 0,0:15:37.90,0:15:41.24,Default,,0,0,0,,Мен мұны істедім. Мен оны істедім.
Dialogue: 0,0:15:41.24,0:15:44.17,Default,,0,0,0,,Мандрад тұқымдары.
Dialogue: 0,0:15:44.17,0:15:46.57,Default,,0,0,0,,Мұнда қараңыз.
Dialogue: 0,0:15:46.57,0:15:49.88,Default,,0,0,0,,Мандра көшеттері гүлдейді.
Dialogue: 0,0:15:49.88,0:15:54.88,Default,,0,0,0,,Мен олардың барлығын санай алмаймын. Олардың барлығы гауһар тастар.
Dialogue: 0,0:15:58.62,0:16:01.32,Default,,0,0,0,,Бұл Мандорадо тұқымы ма?
Dialogue: 0,0:16:13.57,0:16:17.47,Default,,0,0,0,,Бұл жарамен сенің мақтанған мылтығың да шықпайды.
Dialogue: 0,0:16:19.71,0:16:22.54,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:22.54,0:16:25.11,Default,,0,0,0,,Сен де жақсысың.
Dialogue: 0,0:16:25.11,0:16:29.02,Default,,0,0,0,,Ойлан, Алдыңда осындай қазына.
Dialogue: 0,0:16:29.02,0:16:33.32,Default,,0,0,0,,Еңбегінің ақысын ғана алатын ақымақтар қайда?
Dialogue: 0,0:16:35.76,0:16:39.39,Default,,0,0,0,,Бұл жігіттердің барлығы менікі.
Dialogue: 0,0:16:39.39,0:16:41.89,Default,,0,0,0,,Оны ешкімге берме...
Dialogue: 0,0:16:44.23,0:16:47.94,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:47.94,0:16:51.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:56.58,0:16:58.78,Default,,0,0,0,,Құлағыңызда не болды?
Dialogue: 0,0:17:20.57,0:17:22.57,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:17:26.24,0:17:31.24,Default,,0,0,0,,Мандорадо адамда паразит болып, гүлдей ме?
Dialogue: 0,0:17:34.98,0:17:40.15,Default,,0,0,0,,Сонда барлық гүлдер осында гүлдейді
Dialogue: 0,0:17:40.15,0:17:42.85,Default,,0,0,0,,Тұқым жинауға келгендерді иемдену...
Dialogue: 0,0:18:05.41,0:18:07.75,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:18:07.75,0:18:10.75,Default,,0,0,0,,Қалған үшеуі өлген сияқты.
Dialogue: 0,0:18:18.39,0:18:22.26,Default,,0,0,0,,Енді мен сендерге тұқымдарды беремін.
Dialogue: 0,0:18:22.26,0:18:28.07,Default,,0,0,0,,Сіз неге еліктеп жатырсыз? Тұқымдарды құпияға айырбастау керек.
Dialogue: 0,0:18:28.07,0:18:31.67,Default,,0,0,0,,Сіз өте жақсы адамсыз.
Dialogue: 0,0:18:31.67,0:18:35.54,Default,,0,0,0,,Шамасы, сіз бұрын айтқаныңыз.
Dialogue: 0,0:18:35.54,0:18:38.58,Default,,0,0,0,,Сіз ата-аналық ағаштың қайда екенін білесіз.
Dialogue: 0,0:18:38.58,0:18:42.62,Default,,0,0,0,,Сіз ондай адамға өмір сүруге мүмкіндік бересіз бе?
Dialogue: 0,0:18:42.62,0:18:48.32,Default,,0,0,0,,Оның үстіне бұл көзге кіргендер енді ешқашан шыға алмайды.
Dialogue: 0,0:18:50.26,0:18:52.46,Default,,0,0,0,,Мен өлмегенше
Dialogue: 0,0:18:55.46,0:18:57.93,Default,,0,0,0,,Мен сені осы жерде өлуге рұқсат етемін.
Dialogue: 0,0:18:57.93,0:19:00.73,Default,,0,0,0,,Енді маған тұқымдарды беріңдер.
Dialogue: 0,0:19:06.57,0:19:10.47,Default,,0,0,0,,Алмаздар сиқырлы көрінеді.
Dialogue: 0,0:19:16.08,0:19:19.18,Default,,0,0,0,,Оның сүйкімділігімен баурап алғандар...
Dialogue: 0,0:19:28.66,0:19:30.76,Default,,0,0,0,,Мен ұзақ өмір сүрмеймін
Dialogue: 0,0:19:39.11,0:19:41.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:57.43,0:20:00.70,Default,,0,0,0,,Сізге гауһар тас ұнайды, солай ма?
Dialogue: 0,0:20:00.70,0:20:03.10,Default,,0,0,0,,Оны тозаққа апарыңыз
Dialogue: 0,0:20:26.82,0:20:28.82,Default,,0,0,0,,Құпия
Dialogue: 0,0:20:33.56,0:20:35.50,Default,,0,0,0,,Кобра, жақсысың ба?
Dialogue: 0,0:20:35.50,0:20:38.40,Default,,0,0,0,,Әй, мен әйтеуір тірімін.
Dialogue: 0,0:20:38.40,0:20:44.11,Default,,0,0,0,,А... ол ше? Мандрадо - қорқынышты өсімдік
Dialogue: 0,0:20:44.11,0:20:47.81,Default,,0,0,0,,Өсімдіктер жануарларды жемістерімен, жаңғақтарымен тартады.
Dialogue: 0,0:20:47.81,0:20:51.31,Default,,0,0,0,,Тұқым басқа жерге апарылсын;
Dialogue: 0,0:20:51.31,0:20:55.18,Default,,0,0,0,,Мандралар көбею үшін адамның ашкөздігін пайдаланады.
Dialogue: 0,0:20:55.18,0:20:58.42,Default,,0,0,0,,Адамның ашкөздігі бізді Мандрад тұқымын іздеуге мәжбүр етеді.
Dialogue: 0,0:20:58.42,0:21:02.52,Default,,0,0,0,,Түр адамда паразит болып, гүлдейді.
Dialogue: 0,0:21:31.42,0:21:35.99,Default,,0,0,0,,Ал Мандрад ақыры бір жерге жуынып қалды.
Dialogue: 0,0:21:35.99,0:21:39.99,Default,,0,0,0,,Гүлді көргендер тұқымды да іздейді.
Dialogue: 0,0:23:13.79,0:23:15.79,Default,,0,0,0,,Мен қалтадан ақша табуға тырысамын.
Dialogue: 0,0:23:15.79,0:23:20.83,Default,,0,0,0,,Жылдамдық пен төзімділік шегін сынап, метеор жарысына қатысуды шештім.
Dialogue: 0,0:23:20.83,0:23:23.16,Default,,0,0,0,,Сосын, тіпті мұнда, қалада
Dialogue: 0,0:23:23.16,0:23:26.53,Default,,0,0,0,,Қауіпті адам өзінің жылдамдығын шектеп жүгіріп келе жатты.
Dialogue: 0,0:23:26.53,0:23:30.40,Default,,0,0,0,,Өтінемін, менің кездесуіме кедергі жасамаңыз.
Dialogue: 0,0:23:30.40,0:23:34.18,Default,,0,0,0,,Әйтеуір, Памела, көз жасыңа не себеп?
Dialogue: 0,0:23:34.18,0:23:36.84,Default,,0,0,0,,Маған қарсы болмасаңыз, маған хабарлаңыз.
Dialogue: 0,0:23:36.84,0:23:38.85,Default,,0,0,0,,Келесі КОБРА АНИМАЦИЯ
Dialogue: 0,0:23:38.85,0:23:41.15,Default,,0,0,0,,«Қара оқ» Құрметпен
Dialogue: 0,0:23:42.65,0:23:48.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory