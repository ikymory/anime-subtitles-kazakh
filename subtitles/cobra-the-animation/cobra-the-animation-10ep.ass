Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:03:19.18,0:03:22.68,Default,,0,0,0,,Кеш емес пе?
Dialogue: 0,0:03:24.69,0:03:29.19,Default,,0,0,0,,Бізді осында әкелген клиент әлі келмеді ме?
Dialogue: 0,0:03:29.19,0:03:32.69,Default,,0,0,0,,Дүрбелеңге түспеңіз
Dialogue: 0,0:03:32.69,0:03:35.60,Default,,0,0,0,,Әлде сізді тойға шақырды ма?
Dialogue: 0,0:03:35.60,0:03:41.20,Default,,0,0,0,,Не? Фуфуфу…
Dialogue: 0,0:03:41.20,0:03:43.14,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:43.14,0:03:48.08,Default,,0,0,0,,Хехе...
Dialogue: 0,0:03:48.08,0:03:50.21,Default,,0,0,0,,Ойлан
Dialogue: 0,0:03:50.21,0:03:54.08,Default,,0,0,0,,Бұл хабарламаны бізге жіберген бұл жігіт кім?
Dialogue: 0,0:03:54.08,0:03:57.02,Default,,0,0,0,,«Осындай бір нұсқаулық болса болғаны».
Dialogue: 0,0:03:57.02,0:04:00.02,Default,,0,0,0,,«Жердің шетіне жеттік, бізге не болды?».
Dialogue: 0,0:04:00.02,0:04:05.16,Default,,0,0,0,,«Ойбай, сен туылғаннан бері біртүрлі қылатынсың ғой?
Dialogue: 0,0:04:05.16,0:04:07.10,Default,,0,0,0,,«Көбінесе сен ақымақ болғандықтан, мен де...»
Dialogue: 0,0:04:07.10,0:04:11.67,Default,,0,0,0,,"Бұл не деген жігіт...!" "Тоқта! Сен қанішерсің!"
Dialogue: 0,0:04:11.67,0:04:14.57,Default,,0,0,0,,«Тыныш!» «Не!»
Dialogue: 0,0:04:14.57,0:04:17.17,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:04:17.17,0:04:21.04,Default,,0,0,0,,Гид бойынша біздің мақсатымыз Шива қамалын қайтарып алу.
Dialogue: 0,0:04:21.04,0:04:26.18,Default,,0,0,0,,Шива руын хаос әскері талқандағаннан бері жиырма жыл өтті.
Dialogue: 0,0:04:26.18,0:04:30.05,Default,,0,0,0,,Бұл планета қазір хаос армиясына тиесілі.
Dialogue: 0,0:04:30.05,0:04:32.05,Default,,0,0,0,,Бірақ бұл шынымен мүмкін бе?
Dialogue: 0,0:04:32.05,0:04:35.69,Default,,0,0,0,,Сіз хаос армиясына қарсы соғыс бастауды жоспарлап отырсыз ба?
Dialogue: 0,0:04:35.69,0:04:38.59,Default,,0,0,0,,Хаос адамы рухани өмір формасы болып табылады.
Dialogue: 0,0:04:38.59,0:04:42.56,Default,,0,0,0,,Барлық сарбаздар көсемнің еркі бойынша қозғалады.
Dialogue: 0,0:04:42.56,0:04:46.70,Default,,0,0,0,,Бұл аналық ара мен жұмысшы ара арасындағы қарым-қатынас сияқты.
Dialogue: 0,0:04:46.70,0:04:52.21,Default,,0,0,0,,Бірақ егер патша өлсе, бұл планетадағы хаос әскерлерінің барлығы күйреді.
Dialogue: 0,0:04:52.21,0:04:55.11,Default,,0,0,0,,Бұл бірнеше элиталық.
Dialogue: 0,0:04:55.11,0:04:58.65,Default,,0,0,0,,Қамалға тыныш жақындап, патшаның басын тырнап ал!
Dialogue: 0,0:04:58.65,0:05:01.55,Default,,0,0,0,,Бұл оңай, тіпті баланың қолынан келеді
Dialogue: 0,0:05:01.55,0:05:04.15,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:04.15,0:05:09.15,Default,,0,0,0,,Үйге тірі оралуыңызға кепілдік жоқ.
Dialogue: 0,0:07:13.65,0:07:16.15,Default,,0,0,0,,Шақыруда не болды
Dialogue: 0,0:07:16.15,0:07:20.02,Default,,0,0,0,,Қайта алу жоспары және күрек картасы
Dialogue: 0,0:07:20.02,0:07:22.02,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:07:22.02,0:07:26.16,Default,,0,0,0,,Шеба сарайының бұрынғы қожасы Шеба патшаның эмблемасы
Dialogue: 0,0:07:26.16,0:07:31.03,Default,,0,0,0,,Найзаның ұшы немесе күрек күш пен әділетті білдіреді.
Dialogue: 0,0:07:31.03,0:07:35.17,Default,,0,0,0,,Корольдің рыцарлар ордені «Күрек рыцарлары» деп аталды.
Dialogue: 0,0:07:35.17,0:07:40.68,Default,,0,0,0,,Біз сондай-ақ қамалды қайтарып алу және Шеба патшаның даңқын қалпына келтіру үшін таңдалған еріктілерміз.
Dialogue: 0,0:07:40.68,0:07:42.61,Default,,0,0,0,,Ол күрек рыцарлары деп аталады.
Dialogue: 0,0:07:42.61,0:07:46.18,Default,,0,0,0,,-де? қанша адам таңдалды
Dialogue: 0,0:07:46.18,0:07:49.08,Default,,0,0,0,,13 адам Сен қайдан білесің?
Dialogue: 0,0:07:49.08,0:07:53.08,Default,,0,0,0,,Қараңызшы, оны клиент жазған шығар.
Dialogue: 0,0:07:55.69,0:07:58.59,Default,,0,0,0,,Мен алтымын
Dialogue: 0,0:07:58.59,0:08:00.53,Default,,0,0,0,,Мен төртпін.
Dialogue: 0,0:08:00.53,0:08:03.50,Default,,0,0,0,,«Мен жетімін» «Сегіз»
Dialogue: 0,0:08:03.50,0:08:07.64,Default,,0,0,0,,«Шақыру келгенге дейін біз бөлек дене болдық».
Dialogue: 0,0:08:07.64,0:08:10.54,Default,,0,0,0,,Он үш
Dialogue: 0,0:08:10.54,0:08:13.14,Default,,0,0,0,,Бес екі
Dialogue: 0,0:08:13.14,0:08:15.08,Default,,0,0,0,,Мен Джекпін
Dialogue: 0,0:08:15.08,0:08:19.58,Default,,0,0,0,,Бізге ат керек емес, бір-бірімізді осылай атайық.
Dialogue: 0,0:08:34.53,0:08:36.67,Default,,0,0,0,,Мен ханшайыммын
Dialogue: 0,0:08:36.67,0:08:41.17,Default,,0,0,0,,Бұл жоспар ашылған сияқты.
Dialogue: 0,0:08:41.17,0:08:44.67,Default,,0,0,0,,Сыртта бейберекет сарбаздар болды.
Dialogue: 0,0:08:44.67,0:08:47.18,Default,,0,0,0,,Оның тоғыз картасы болды.
Dialogue: 0,0:08:47.18,0:08:50.08,Default,,0,0,0,,Не? Ол қазірдің өзінде өлді
Dialogue: 0,0:08:50.08,0:08:53.68,Default,,0,0,0,,Жас ханым, сіз мұны істедім дейсіз бе?
Dialogue: 0,0:08:53.68,0:09:01.49,Default,,0,0,0,,Сыртқы түріне қарап баға берме. Мен кәсіби өлтірушімін.
Dialogue: 0,0:09:01.49,0:09:05.99,Default,,0,0,0,,Жалаң қолмен өлтірудің 99 әдісін білемін.
Dialogue: 0,0:09:15.64,0:09:17.64,Default,,0,0,0,,(балға ату дыбысы)
Dialogue: 0,0:09:30.15,0:09:33.05,Default,,0,0,0,,Бұл хаос солдаты.
Dialogue: 0,0:09:33.05,0:09:35.66,Default,,0,0,0,,Ка~! Сіз шпионсыз ба?
Dialogue: 0,0:09:35.66,0:09:42.53,Default,,0,0,0,,Хаос сарбаздары рухани өмір формалары, олардың денелері жай ғана ыдыстар.
Dialogue: 0,0:09:42.53,0:09:44.53,Default,,0,0,0,,(балға ату дыбысы)
Dialogue: 0,0:09:48.17,0:09:51.17,Default,,0,0,0,,Бұл негізгі бөлім.
Dialogue: 0,0:09:53.68,0:09:56.58,Default,,0,0,0,,Тағы екі жауынгер қалды.
Dialogue: 0,0:09:56.58,0:09:59.48,Default,,0,0,0,,Жоқ, мұнда басқа адам бар.
Dialogue: 0,0:09:59.48,0:10:01.48,Default,,0,0,0,,Не? не?
Dialogue: 0,0:10:06.62,0:10:10.13,Default,,0,0,0,,Мен оның хаос солдаты екенін анық көріп тұрмын.
Dialogue: 0,0:10:10.13,0:10:13.03,Default,,0,0,0,,Хаос сарбаздарын иісінен тануға болады.
Dialogue: 0,0:10:13.03,0:10:16.63,Default,,0,0,0,,Олар оны ақыл-ойды сақтау саласын айналдыру үшін пайдаланады.
Dialogue: 0,0:10:16.63,0:10:19.53,Default,,0,0,0,,Майдың иісі бар.
Dialogue: 0,0:10:19.53,0:10:22.14,Default,,0,0,0,,-де? сен
Dialogue: 0,0:10:22.14,0:10:28.01,Default,,0,0,0,,Хмм, иісі жақсы. Бұл Паруре.
Dialogue: 0,0:10:28.01,0:10:35.15,Default,,0,0,0,,Күшті және сезімтал, бұл сіз үшін тамаша парфюмерия.
Dialogue: 0,0:10:35.15,0:10:37.65,Default,,0,0,0,,Эй, сен ол жерде қанша уақыт болдың?
Dialogue: 0,0:10:37.65,0:10:40.16,Default,,0,0,0,,Біраз уақыттан бері
Dialogue: 0,0:10:40.16,0:10:45.66,Default,,0,0,0,,Бұл патшайым емес пе еді? Сыртқа шыққыңыз келе ме? Бұл жерде ыстық
Dialogue: 0,0:10:45.66,0:10:48.16,Default,,0,0,0,,Егер сіз кездесуді сұрасаңыз, мен одан бас тартамын.
Dialogue: 0,0:10:48.16,0:10:51.07,Default,,0,0,0,,Күні? Амал жоқ
Dialogue: 0,0:10:51.07,0:10:54.04,Default,,0,0,0,,Мен сені күзетші болуды өтінемін деп ойлаймын.
Dialogue: 0,0:10:54.04,0:10:57.04,Default,,0,0,0,,Өйткені, сыртта шу.
Dialogue: 0,0:11:04.11,0:11:06.61,Default,,0,0,0,,Хаос әскерінің механикалық аңы.
Dialogue: 0,0:11:06.61,0:11:11.11,Default,,0,0,0,,Не? Үлкен санмен қоршалған
Dialogue: 0,0:11:13.12,0:11:15.06,Default,,0,0,0,,Қызықты
Dialogue: 0,0:11:15.06,0:11:18.63,Default,,0,0,0,,Эй, эй…
Dialogue: 0,0:11:18.63,0:11:20.63,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:11:32.14,0:11:34.14,Default,,0,0,0,,Механикалық аң!
Dialogue: 0,0:12:06.61,0:12:08.61,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:12:10.48,0:12:13.11,Default,,0,0,0,,"Сен еркексің! Ұрыс!"
Dialogue: 0,0:12:13.11,0:12:15.61,Default,,0,0,0,,«Сен қашып бара жатырсың!»
Dialogue: 0,0:12:28.60,0:12:32.13,Default,,0,0,0,,«Не... аа...»
Dialogue: 0,0:12:32.13,0:12:34.07,Default,,0,0,0,,"Уау! Бұл жарғанат!"
Dialogue: 0,0:12:34.07,0:12:37.07,Default,,0,0,0,,"Жоқ! Жоқ...!"
Dialogue: 0,0:12:39.01,0:12:41.14,Default,,0,0,0,,«Кя...!»
Dialogue: 0,0:12:41.14,0:12:46.14,Default,,0,0,0,,Ақымақ ерікті сарбаздар оның жарғанат екенін көріп таң қалды.
Dialogue: 0,0:12:48.02,0:12:51.15,Default,,0,0,0,,Қайда бара жатырсың? Оның артында жартас бар!
Dialogue: 0,0:12:51.15,0:12:53.65,Default,,0,0,0,,Асығыңыз! Уақыт келді!
Dialogue: 0,0:12:56.66,0:12:59.16,Default,,0,0,0,,Уақыт? Сағат неше болды?
Dialogue: 0,0:12:59.16,0:13:01.16,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:38.70,0:13:40.64,Default,,0,0,0,,Уақыт келді, келе жатыр
Dialogue: 0,0:13:40.64,0:13:42.57,Default,,0,0,0,,Не келе жатыр?
Dialogue: 0,0:13:42.57,0:13:44.57,Default,,0,0,0,,Міне
Dialogue: 0,0:13:44.57,0:13:48.21,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:13:48.21,0:13:50.21,Default,,0,0,0,,Барлығың, ұшыңдар!
Dialogue: 0,0:13:54.08,0:13:56.65,Default,,0,0,0,,«Мен ұша алсам да, астындағы ештеңені көре алмас едім!»
Dialogue: 0,0:13:56.65,0:13:59.15,Default,,0,0,0,,Ендеше, өз-өзіңе сиқыршы.
Dialogue: 0,0:14:08.16,0:14:10.67,Default,,0,0,0,,«Ауырып тұр...»
Dialogue: 0,0:14:10.67,0:14:12.60,Default,,0,0,0,,«Бұл қайда?»
Dialogue: 0,0:14:12.60,0:14:15.54,Default,,0,0,0,,"Біз өлдік пе? Бұл аспан ба?"
Dialogue: 0,0:14:15.54,0:14:19.17,Default,,0,0,0,,«Ақымақ болма, қасымда болсаң бұл жер тозақ».
Dialogue: 0,0:14:19.17,0:14:23.68,Default,,0,0,0,,Жоқ, ол пойызда.
Dialogue: 0,0:14:23.68,0:14:28.18,Default,,0,0,0,,Британдық пойыз сияқты уақытында.
Dialogue: 0,0:14:28.18,0:14:30.69,Default,,0,0,0,,Сонда бұл төртеуі ғана аман қалды ма?
Dialogue: 0,0:14:30.69,0:14:34.56,Default,,0,0,0,,«Біз бесеуміз, бұл Рокуденашиді бізбен араластырмаңыздар!»
Dialogue: 0,0:14:34.56,0:14:37.19,Default,,0,0,0,,«Мен де кешірім сұраймын!»
Dialogue: 0,0:14:37.19,0:14:39.13,Default,,0,0,0,,Мен полицияның ФБР агентімен байланыста болғанымды білуін де қаламайым
Dialogue: 0,0:14:39.13,0:14:44.07,Default,,0,0,0,,Тіпті бес адам болса да, Шиба қамалын қайтару мүмкін емес еді.
Dialogue: 0,0:14:44.07,0:14:46.70,Default,,0,0,0,,Сіз қорқасыз ба? не?
Dialogue: 0,0:14:46.70,0:14:49.20,Default,,0,0,0,,Жалғыз болсам да істеймін.
Dialogue: 0,0:14:49.20,0:14:53.71,Default,,0,0,0,,Жоспар жақсы жазылған. Бұл адам санымен жасауға болады.
Dialogue: 0,0:14:53.71,0:14:57.71,Default,,0,0,0,,-де? сенуге болады ма
Dialogue: 0,0:14:59.51,0:15:03.51,Default,,0,0,0,,Мен сіздің картаңызды әлі көрген жоқпын.
Dialogue: 0,0:15:05.65,0:15:08.56,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:15:08.56,0:15:10.53,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:10.53,0:15:12.53,Default,,0,0,0,,Мен Эйспін
Dialogue: 0,0:15:32.68,0:15:36.18,Default,,0,0,0,,Мен - козирмін!
Dialogue: 0,0:15:40.56,0:16:00.64,Default,,0,0,0,,(ыңылдаған дауыс)
Dialogue: 0,0:16:00.64,0:16:13.65,Default,,0,0,0,,(ыңылдаған дауыс)
Dialogue: 0,0:16:13.65,0:16:17.53,Default,,0,0,0,,Патша…
Dialogue: 0,0:16:17.53,0:16:20.16,Default,,0,0,0,,Патша
Dialogue: 0,0:16:20.16,0:16:24.03,Default,,0,0,0,,(ыңылдаған дауыс)
Dialogue: 0,0:16:24.03,0:16:26.67,Default,,0,0,0,,Патша…
Dialogue: 0,0:16:26.67,0:16:43.68,Default,,0,0,0,,(ыңылдаған дауыс)
Dialogue: 0,0:16:43.68,0:16:45.68,Default,,0,0,0,,Патша
Dialogue: 0,0:16:51.56,0:16:55.20,Default,,0,0,0,,Сіз тағы да әдеттегі қорқынышты түс көрдіңіз.
Dialogue: 0,0:16:55.20,0:16:58.70,Default,,0,0,0,,Сіздің өткен өміріңізде нақты не болды?
Dialogue: 0,0:17:00.64,0:17:05.64,Default,,0,0,0,,Ештеңе есіңде жоқ.
Dialogue: 0,0:17:07.51,0:17:15.15,Default,,0,0,0,,Сондай-ақ сіздің денеңіздегі бұл татуировкасы туралы.
Dialogue: 0,0:17:15.15,0:17:19.65,Default,,0,0,0,,Бірақ күте тұрыңыз, бір күні мен сіздің естеліктеріңізді қалпына келтіремін.
Dialogue: 0,0:17:19.65,0:17:24.53,Default,,0,0,0,,Ал мен сені сол қорқыныштан босатамын.
Dialogue: 0,0:17:24.53,0:17:29.53,Default,,0,0,0,,≪Патша... Патша
Dialogue: 0,0:17:31.67,0:17:35.17,Default,,0,0,0,,Нені шулатып тұрсың, патша?
Dialogue: 0,0:17:35.17,0:17:39.67,Default,,0,0,0,,Хэхехе... Бұл тағы да әдеттегі ұстама ма?
Dialogue: 0,0:17:39.67,0:17:43.18,Default,,0,0,0,,Сіз сияқты ержүрек Гизара жауынгері
Dialogue: 0,0:17:43.18,0:17:47.68,Default,,0,0,0,,Әр түнде сәбидей түс көрсем ғой.
Dialogue: 0,0:17:47.68,0:17:50.18,Default,,0,0,0,,Сен менің ақша ағашымсың
Dialogue: 0,0:17:50.18,0:17:54.06,Default,,0,0,0,,Маған әлі де көбірек ақша табу керек.
Dialogue: 0,0:17:54.06,0:17:59.06,Default,,0,0,0,,Мықты болыңыз, патша.
Dialogue: 0,0:18:02.63,0:18:05.13,Default,,0,0,0,,Эрис, сіздің рөліңіз қандай?
Dialogue: 0,0:18:05.13,0:18:09.00,Default,,0,0,0,,Бұл Кингтің психикалық тұрақтылығын сақтау туралы.
Dialogue: 0,0:18:09.00,0:18:14.14,Default,,0,0,0,,Егер мұны істей алмасаң, мен сені бірден құл базарына сатамын.
Dialogue: 0,0:18:14.14,0:18:16.64,Default,,0,0,0,,Менікі де емес—
Dialogue: 0,0:18:37.17,0:18:39.10,Default,,0,0,0,,Жоспар бойынша
Dialogue: 0,0:18:39.10,0:18:44.04,Default,,0,0,0,,Шива қамалын қайтару жоспарына жиналған 13-ші адам, соңғы адам.
Dialogue: 0,0:18:44.04,0:18:46.67,Default,,0,0,0,,Сіз осы Гизара қаласындасыз ба?
Dialogue: 0,0:18:46.67,0:18:49.58,Default,,0,0,0,,Адам – жол көрсетуші.
Dialogue: 0,0:18:49.58,0:18:53.55,Default,,0,0,0,,Қамалдың саңылауын тек ол ғана біледі.
Dialogue: 0,0:18:53.55,0:18:56.18,Default,,0,0,0,,«Хаос әскері орналасқан жердің ортасы арқылы».
Dialogue: 0,0:18:56.18,0:18:58.62,Default,,0,0,0,,«Қамалға бару мүмкін емес».
Dialogue: 0,0:18:58.62,0:19:02.12,Default,,0,0,0,,Шива қамалына бару үшін ол маған өте қажет.
Dialogue: 0,0:19:02.12,0:19:04.06,Default,,0,0,0,,«Бұл кім?»
Dialogue: 0,0:19:04.06,0:19:05.99,Default,,0,0,0,,Саана
Dialogue: 0,0:19:05.99,0:19:09.63,Default,,0,0,0,,Оны мұнда Король деп атайды.
Dialogue: 0,0:19:09.63,0:19:13.63,Default,,0,0,0,,Оның денесінде қара әйелдің татуировкасы бар көрінеді.
Dialogue: 0,0:19:37.66,0:19:42.16,Default,,0,0,0,,Бұл құл саудагер Саардың үйі.
Dialogue: 0,0:19:51.17,0:19:53.67,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:20:00.62,0:20:05.62,Default,,0,0,0,,Бұл көркем аймақ. Мен саған дүкен ашпа дедім ғой!
Dialogue: 0,0:20:27.14,0:20:30.04,Default,,0,0,0,,Хаос сарбаздары?
Dialogue: 0,0:20:30.04,0:20:32.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:34.65,0:20:37.15,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:20:40.52,0:20:45.66,Default,,0,0,0,,Бұл порт қаласы хаос әскерінің бақылауында.
Dialogue: 0,0:20:45.66,0:20:50.16,Default,,0,0,0,,Сақ болмасаң, ұсталып, солардың құлы боласың.
Dialogue: 0,0:20:50.16,0:20:53.07,Default,,0,0,0,,О, соны есіме түсірейін.
Dialogue: 0,0:20:53.07,0:20:55.07,Default,,0,0,0,,Түннің осы уақытында қайда барасың?
Dialogue: 0,0:20:57.97,0:20:59.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:02.11,0:21:05.98,Default,,0,0,0,,Түсіндім, патша зынданда.
Dialogue: 0,0:21:05.98,0:21:08.98,Default,,0,0,0,,Зынданда? Бұл құл саудагері Саардың сарайы.
Dialogue: 0,0:21:08.98,0:21:12.98,Default,,0,0,0,,Ол жекпе-жек спортының құлы ретінде түрмеде ұсталады.
Dialogue: 0,0:21:15.12,0:21:17.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:17.06,0:21:20.56,Default,,0,0,0,,Мен тағы бір қызықты нәрсе таптым.
Dialogue: 0,0:21:23.00,0:21:27.13,Default,,0,0,0,,Бетіңізді өзгерттіңіз бе?
Dialogue: 0,0:21:27.13,0:21:29.64,Default,,0,0,0,,Сен сол қарақшысың, Кобра.
Dialogue: 0,0:21:29.64,0:21:31.57,Default,,0,0,0,,«Кобра?»
Dialogue: 0,0:21:31.57,0:21:37.57,Default,,0,0,0,,Бұл дүниеде сол қолына мылтық таққан адамдар ғана бар.
Dialogue: 0,0:21:41.65,0:21:46.52,Default,,0,0,0,,-де? Менің қолтаңбамды қалайсыз ба?
Dialogue: 0,0:21:46.52,0:21:52.16,Default,,0,0,0,,Сіз өлтіруші бұқаны білесіз бе? Ол сыйлы аңшы
Dialogue: 0,0:21:52.16,0:21:57.97,Default,,0,0,0,,Менің ең жақын досымды сен өлтірдің.
Dialogue: 0,0:21:57.97,0:22:01.97,Default,,0,0,0,,Мен жауларымды жеңемін
Dialogue: 0,0:22:09.11,0:22:11.05,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:22:11.05,0:22:13.61,Default,,0,0,0,,Сырт келбетіңізге қарамастан, сіз достарыңызға қамқорсыз.
Dialogue: 0,0:22:13.61,0:22:15.55,Default,,0,0,0,,Не?
Dialogue: 0,0:22:15.55,0:22:18.49,Default,,0,0,0,,Жанжал жұмыстан кейін болады, солай ма?
Dialogue: 0,0:22:18.49,0:22:22.12,Default,,0,0,0,,«Иә, біздің мақсатымыз Шива қамалын қайтарып алу».
Dialogue: 0,0:22:22.12,0:22:24.63,Default,,0,0,0,,«Дұрыс, менің достарымды бөлуге уақытым жоқ».
Dialogue: 0,0:22:24.63,0:22:26.56,Default,,0,0,0,,Шулы! TV Yarrow!
Dialogue: 0,0:22:26.56,0:22:29.13,Default,,0,0,0,,Сіз әрқашан Гарга Пипимен күресетін адамсыз!
Dialogue: 0,0:22:29.13,0:22:31.63,Default,,0,0,0,,«Не?»
Dialogue: 0,0:22:33.63,0:22:36.54,Default,,0,0,0,,Жарайды, бұл жұмыс аяқталғаннан кейін.
Dialogue: 0,0:22:36.54,0:22:40.54,Default,,0,0,0,,Ол кезде дайын болыңыз.
Dialogue: 0,0:23:00.66,0:23:05.17,Default,,0,0,0,,Не істеу керек? Ғимаратқа кіру оңай
Dialogue: 0,0:23:05.17,0:23:08.07,Default,,0,0,0,,Құлды өзіңмен бірге алып шығу қиын.
Dialogue: 0,0:23:08.07,0:23:13.04,Default,,0,0,0,,Отшашуды атқызу және әбігердің астынан құтылу.
Dialogue: 0,0:23:13.04,0:23:17.54,Default,,0,0,0,,Уақытты реттеңіз. Сағат 9-да бастаңыз.
Dialogue: 0,0:23:20.65,0:23:22.65,Default,,0,0,0,,Сағат 9.
Dialogue: 0,0:26:10.02,0:26:12.02,Default,,0,0,0,,<Шива қамалын қайтарып алу жоспары бойынша>
Dialogue: 0,0:26:12.02,0:26:16.16,Default,,0,0,0,,<Соңғы қалғаны осы Гизара деген қалада дейді>
Dialogue: 0,0:26:16.16,0:26:19.06,Default,,0,0,0,,<Ол қамалдың саңылауын білетін жалғыз адам сияқты>
Dialogue: 0,0:26:19.06,0:26:21.03,Default,,0,0,0,,<Маған не болды>
Dialogue: 0,0:26:21.03,0:26:24.03,Default,,0,0,0,,＜Мен оған қарсы күресуім керек болды＞
Dialogue: 0,0:26:24.03,0:26:28.17,Default,,0,0,0,,<Осы арада, достарым, әлде сені Джек патшайым Жеті деп айту керек пе>
Dialogue: 0,0:26:28.17,0:26:30.67,Default,,0,0,0,,<Сонымен қатар, мм... сегіз болды ма? ＞
Dialogue: 0,0:26:30.67,0:26:33.17,Default,,0,0,0,,<Барлығы жақсы өтсін>
Dialogue: 0,0:26:33.17,0:26:35.17,Default,,0,0,0,,<Келесі «КОБРА АНИМАЦИЯ»…>
Dialogue: 0,0:32:07.17,0:32:10.68,Default,,0,0,0,,)
Dialogue: 0,0:32:10.68,0:32:14.68,Default,,0,0,0,,)
Dialogue: 0,0:32:26.13,0:32:30.63,Default,,0,0,0,,)
Dialogue: 0,0:32:30.63,0:32:33.13,Default,,0,0,0,,сағат 9?
Dialogue: 0,0:32:46.11,0:32:51.11,Default,,0,0,0,,Патшаның зынданда тұтқынға алынғанын айттыңыз.
Dialogue: 0,0:32:53.02,0:32:56.66,Default,,0,0,0,,(Қыңқыл) Бірақ қазір менде қорқыныштың бір ұшқыны да жоқ
Dialogue: 0,0:32:56.66,0:33:15.61,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:33:15.61,0:33:18.11,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:33:40.63,0:33:42.57,Default,,0,0,0,,«Мистер Кинг»
Dialogue: 0,0:33:42.57,0:33:47.14,Default,,0,0,0,,«Кинг мырза, сіз осындасыз ба?
Dialogue: 0,0:33:47.14,0:33:51.01,Default,,0,0,0,,«Мм... сен бұл Кинг деген жігітті танымайсың ба?
Dialogue: 0,0:33:51.01,0:33:53.01,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:33:53.01,0:33:56.65,Default,,0,0,0,,«О, мен білмеймін деп ойлаймын».
Dialogue: 0,0:33:56.65,0:33:58.59,Default,,0,0,0,,≪Кім?
Dialogue: 0,0:33:58.59,0:34:00.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:00.52,0:34:05.16,Default,,0,0,0,,Балалар, Патшаны неге іздеп жүрсіңдер?
Dialogue: 0,0:34:05.16,0:34:07.09,Default,,0,0,0,,Өйткені біз доспыз
Dialogue: 0,0:34:07.09,0:34:10.03,Default,,0,0,0,,Мен оны осы түрмеден құтқаруға келдім.
Dialogue: 0,0:34:10.03,0:34:16.10,Default,,0,0,0,,Бұл өтірік. Король сіз туралы білмейді.
Dialogue: 0,0:34:16.10,0:34:20.97,Default,,0,0,0,,Бірақ сіз оны білетін сияқтысыз.
Dialogue: 0,0:34:20.97,0:34:26.11,Default,,0,0,0,,Кингтің әйелі бар деп естідім, бірақ сізге ұқсайды.
Dialogue: 0,0:34:26.11,0:34:29.02,Default,,0,0,0,,Кинг қазір қайда?
Dialogue: 0,0:34:29.02,0:34:30.98,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:34:30.98,0:34:32.99,Default,,0,0,0,,Енді ештеңені жоғалтпау үшін
Dialogue: 0,0:34:32.99,0:34:37.12,Default,,0,0,0,,Кинг қасымда болмаса, қашпайды.
Dialogue: 0,0:34:37.12,0:34:40.63,Default,,0,0,0,,«Кобра, мен камера есігін ашатын құралды таптым».
Dialogue: 0,0:34:40.63,0:34:42.56,Default,,0,0,0,,«Бұл электронды құлып».
Dialogue: 0,0:34:42.56,0:34:45.13,Default,,0,0,0,,Оны ашуға бола ма? Жеті
Dialogue: 0,0:34:45.13,0:34:47.63,Default,,0,0,0,,«Менің жұмысым сейфтерді бұзу».
Dialogue: 0,0:34:47.63,0:34:51.63,Default,,0,0,0,,«Сен ақымақ». «Ауызыңды жап!»
Dialogue: 0,0:34:55.14,0:34:58.65,Default,,0,0,0,,Кішкентай қыз, мен сені бұл жерден алып кетемін.
Dialogue: 0,0:34:58.65,0:35:01.15,Default,,0,0,0,,Сен шықсаң, мені Патшаға апар.
Dialogue: 0,0:35:01.15,0:35:05.65,Default,,0,0,0,,Мен жас келіншек емеспін. Менің атым Эрис.
Dialogue: 0,0:35:05.65,0:35:07.65,Default,,0,0,0,,«Бинго»
Dialogue: 0,0:35:12.53,0:35:15.10,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:35:15.10,0:35:17.03,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:35:17.03,0:35:18.97,Default,,0,0,0,,«Сіз тағы да ебедейсіз болдыңыз».
Dialogue: 0,0:35:18.97,0:35:21.60,Default,,0,0,0,,«Сіз қате есік аштыңыз!»
Dialogue: 0,0:35:21.60,0:35:23.54,Default,,0,0,0,,«О...»
Dialogue: 0,0:35:23.54,0:35:27.04,Default,,0,0,0,,Ауырды... Ауырды...
Dialogue: 0,0:35:51.13,0:35:54.03,Default,,0,0,0,,«Жоғалып кетті»
Dialogue: 0,0:35:54.03,0:35:58.64,Default,,0,0,0,,Зола бөтен адам өлгенде, оның денесі жоғалады.
Dialogue: 0,0:35:58.64,0:36:03.14,Default,,0,0,0,,≪Жоқ. 23! № 22!
Dialogue: 0,0:36:03.14,0:36:07.65,Default,,0,0,0,,Жасыру! Қоңырау шалыңыз! Саңырау солдаттар келе жатыр!
Dialogue: 0,0:36:07.65,0:36:12.52,Default,,0,0,0,,Бұл жақсы емес. Құлдардың саны бір адамға азайды. Олар күдікті болады.
Dialogue: 0,0:36:12.52,0:36:14.52,Default,,0,0,0,,«Не істейсің, Кобра?»
Dialogue: 0,0:36:14.52,0:36:16.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:16.46,0:36:19.59,Default,,0,0,0,,№ 18! (айқай)
Dialogue: 0,0:36:19.59,0:36:22.50,Default,,0,0,0,,№ 17! (айқай)
Dialogue: 0,0:36:22.50,0:36:26.00,Default,,0,0,0,,№ 16! (айқай)
Dialogue: 0,0:36:30.10,0:36:33.01,Default,,0,0,0,,№ 11
Dialogue: 0,0:36:33.01,0:36:35.98,Default,,0,0,0,,№ 11! Не болды, №11!
Dialogue: 0,0:36:35.98,0:36:40.11,Default,,0,0,0,,Мен сізді естимін. Менің құлағым жақсы.
Dialogue: 0,0:36:40.11,0:36:45.11,Default,,0,0,0,,No11 Сыртқа шық, бұл ойын.
Dialogue: 0,0:36:47.62,0:36:51.49,Default,,0,0,0,,«Сәйкестік пе?» «Сіріңке дегенді қалай түсінесіңдер?»
Dialogue: 0,0:36:51.49,0:37:04.07,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:37:04.07,0:37:11.65,Default,,0,0,0,,"Көк бұрыш Герудо бөтен! Құмды тозақта өмір сүретін күшті адам!"
Dialogue: 0,0:37:11.65,0:37:14.55,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:37:14.55,0:37:21.09,Default,,0,0,0,,"Қызыл бұрышта бірінші көріну! Зола Алиен!"
Dialogue: 0,0:37:21.09,0:37:24.59,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:37:24.59,0:37:28.09,Default,,0,0,0,,Бұл құл Зола бөтен емес.
Dialogue: 0,0:37:28.09,0:37:34.09,Default,,0,0,0,,Бұл біртүрлі. Бұл жерлік. Ондай нәрсе болды ма?
Dialogue: 0,0:37:35.97,0:37:40.97,Default,,0,0,0,,Жер адамы болғаны дұрыс емес пе?
Dialogue: 0,0:37:44.11,0:37:48.62,Default,,0,0,0,,Кейде жердегілердің қызыл қанын көргім келеді.
Dialogue: 0,0:37:48.62,0:37:51.12,Default,,0,0,0,,«Сәйкестік басталады!»
Dialogue: 0,0:38:05.63,0:38:09.13,Default,,0,0,0,,Мен сенің отбасыңа еш реніш білдірмеймін.
Dialogue: 0,0:38:19.51,0:38:24.45,Default,,0,0,0,,О, неткен құдірет! Мен оның жер адамы екеніне сене алар емеспін.
Dialogue: 0,0:38:24.45,0:38:29.95,Default,,0,0,0,,Хахаха... мына жігіт жер қазушы екен.
Dialogue: 0,0:38:35.96,0:38:39.46,Default,,0,0,0,,Өлтір! Жаса!
Dialogue: 0,0:38:41.60,0:38:47.11,Default,,0,0,0,,Ол енді күресе алмайды. Оны өлтірудің қажеті жоқ.
Dialogue: 0,0:38:47.11,0:38:50.11,Default,,0,0,0,,Жеңілгендерді тастаңыз
Dialogue: 0,0:39:15.64,0:39:21.51,Default,,0,0,0,,Хахаха... Бірақ бұл жолғы қарсыласым айбатты қарсылас.
Dialogue: 0,0:39:21.51,0:39:25.51,Default,,0,0,0,,Хехехе... Қызық, жеңе аламын ба?
Dialogue: 0,0:39:41.16,0:39:47.67,Default,,0,0,0,,«Көк бұрыш Изараның кейіпкері!»
Dialogue: 0,0:39:47.67,0:39:50.17,Default,,0,0,0,,«Жеңілмейтін күрес патшасы»
Dialogue: 0,0:39:50.17,0:39:53.67,Default,,0,0,0,,«Патша!»
Dialogue: 0,0:39:53.67,0:39:56.18,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:39:56.18,0:39:59.08,Default,,0,0,0,,«Бұл энергияны визуализациялау алаңы».
Dialogue: 0,0:39:59.08,0:40:03.68,Default,,0,0,0,,«Осы екі адамның жауынгерлік рухының соқтығысқанын көруге болады!».
Dialogue: 0,0:40:03.68,0:40:07.55,Default,,0,0,0,,Хахаха... бұл көруге болатын нәрсе
Dialogue: 0,0:40:07.55,0:40:14.19,Default,,0,0,0,,Қорқынышты күшке ие жер адамы және жеңілмейтін жауынгер патша.
Dialogue: 0,0:40:14.19,0:40:20.00,Default,,0,0,0,,Осы екі құлдың жеңімпазына бостандық беріледі!
Dialogue: 0,0:40:20.00,0:40:24.64,Default,,0,0,0,,Келіңіздер, бәріңіз! Ақшаңызды екі адамға тігіңіз!
Dialogue: 0,0:40:24.64,0:40:27.14,Default,,0,0,0,,Ең жақсы шайқас бүгін түнде басталады!
Dialogue: 0,0:40:27.14,0:40:33.01,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:40:33.01,0:40:35.65,Default,,0,0,0,,《Бұл өте қызықты》
Dialogue: 0,0:40:35.65,0:40:39.15,Default,,0,0,0,,《10 минут бұрын》
Dialogue: 0,0:40:39.15,0:40:42.06,Default,,0,0,0,,Оған дейін мен сені тым болмаса көңіл көтеремін.
Dialogue: 0,0:40:42.06,0:40:44.56,Default,,0,0,0,,«Сәйкестік басталады!»
Dialogue: 0,0:41:04.68,0:41:08.18,Default,,0,0,0,,Бұл өте жылдам болды.
Dialogue: 0,0:41:08.18,0:41:11.68,Default,,0,0,0,,Саале, маған уәде бер, мені босат.
Dialogue: 0,0:41:11.68,0:41:15.56,Default,,0,0,0,,Ол бұлай сезінбейді.
Dialogue: 0,0:41:15.56,0:41:22.56,Default,,0,0,0,,Үйің – сен үшін өлгенше күресетін ойыншық солдат.
Dialogue: 0,0:41:25.13,0:41:30.00,Default,,0,0,0,,Міне, осының бәрі жылыну үшін.
Dialogue: 0,0:41:30.00,0:41:32.50,Default,,0,0,0,,Нақты көрсетілімге барайық.
Dialogue: 0,0:42:15.48,0:42:19.62,Default,,0,0,0,,Тоқта, мен сені бұл жерден алып кетуге келдім.
Dialogue: 0,0:42:19.62,0:42:22.12,Default,,0,0,0,,Не? не үшін
Dialogue: 0,0:42:22.12,0:42:24.62,Default,,0,0,0,,Шива қамалын қайтарып алу.
Dialogue: 0,0:42:24.62,0:42:26.56,Default,,0,0,0,,Шива сарайы…
Dialogue: 0,0:42:26.56,0:42:28.49,Default,,0,0,0,,Саған сенуге бола ма?
Dialogue: 0,0:42:28.49,0:42:33.99,Default,,0,0,0,,Әйтпесе үйің мәңгі құл болып қалады.
Dialogue: 0,0:42:40.64,0:42:43.54,Default,,0,0,0,,Жарайды, мен саған сенемін.
Dialogue: 0,0:42:43.54,0:42:47.15,Default,,0,0,0,,Бірақ бұл жерден қалай құтыламыз?
Dialogue: 0,0:42:47.15,0:42:51.15,Default,,0,0,0,,Жақында достарыңыз қиындық тудыра бастайды.
Dialogue: 0,0:42:56.16,0:42:59.66,Default,,0,0,0,,Оған дейін бұрыштарды кеспеңіз
Dialogue: 0,0:43:09.17,0:43:12.07,Default,,0,0,0,,Екі адамның жылдам қозғалғаны сонша, мен оларды көрмеймін.
Dialogue: 0,0:43:12.07,0:43:15.07,Default,,0,0,0,,Кім жеңді?
Dialogue: 0,0:43:33.13,0:43:36.63,Default,,0,0,0,,Сағат 9...
Dialogue: 0,0:43:39.00,0:43:41.00,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:43:47.64,0:43:50.64,Default,,0,0,0,,Отшашуды бастау уақыты.
Dialogue: 0,0:44:17.10,0:44:19.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:50.00,0:44:54.64,Default,,0,0,0,,Не... бұл не деген шу!
Dialogue: 0,0:44:54.64,0:44:56.58,Default,,0,0,0,,Енді патша! Қанекей жүгірейік!
Dialogue: 0,0:44:56.58,0:44:58.51,Default,,0,0,0,,Қайдан!
Dialogue: 0,0:44:58.51,0:45:00.51,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:45:34.11,0:45:37.62,Default,,0,0,0,,Ах! О, менің...
Dialogue: 0,0:45:37.62,0:45:40.12,Default,,0,0,0,,Екеуің кетіңдер!
Dialogue: 0,0:45:54.07,0:45:56.00,Default,,0,0,0,,«Кобра!»
Dialogue: 0,0:45:56.00,0:46:00.01,Default,,0,0,0,,"Кобра! Мына жерде! Шығудың жолы бар!"
Dialogue: 0,0:46:00.01,0:46:04.01,Default,,0,0,0,,Кеш аяқталды. Кеттік.
Dialogue: 0,0:46:06.65,0:46:11.15,Default,,0,0,0,,Патша! тез! Мұнда!
Dialogue: 0,0:46:20.59,0:46:24.46,Default,,0,0,0,,Зынданда жасырын шығу бар.
Dialogue: 0,0:46:24.46,0:46:28.46,Default,,0,0,0,,Менің қашып кетуіме жол берме! Оны қу!
Dialogue: 0,0:46:39.61,0:46:42.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:44.48,0:46:49.48,Default,,0,0,0,,Бұл... сүңгуір қайық.
Dialogue: 0,0:46:55.09,0:46:58.00,Default,,0,0,0,,Асығыңыз! Оны ашыңыз!
Dialogue: 0,0:46:58.00,0:47:01.50,Default,,0,0,0,,Міне! Тез жүріңіз!
Dialogue: 0,0:47:04.64,0:47:07.54,Default,,0,0,0,,Сегіз! Сен не істеп жатырсың? Асықшы!
Dialogue: 0,0:47:07.54,0:47:09.51,Default,,0,0,0,,«Бұл мен емес!»
Dialogue: 0,0:47:09.51,0:47:12.14,Default,,0,0,0,,"Тоқта! Немен ойнайсың?"
Dialogue: 0,0:47:12.14,0:47:15.64,Default,,0,0,0,,"Күте тұрыңыз! Жақын жерде қалды."
Dialogue: 0,0:47:30.10,0:47:32.03,Default,,0,0,0,,Балалар...
Dialogue: 0,0:47:32.03,0:47:37.97,Default,,0,0,0,,О... тоқта! Түрмеге қайт! Тоқта!
Dialogue: 0,0:47:37.97,0:47:43.47,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:47:48.11,0:47:51.61,Default,,0,0,0,,Бұл құл сатушының соңғы сәті.
Dialogue: 0,0:48:05.53,0:48:09.50,Default,,0,0,0,,Енді, король, рульді қайда алу керек?
Dialogue: 0,0:48:09.50,0:48:14.14,Default,,0,0,0,,Қамалға жету үшін сіз саңылау білуіңіз керек, солай ма?
Dialogue: 0,0:48:14.14,0:48:16.08,Default,,0,0,0,,Құлып көлде жүзіп тұр
Dialogue: 0,0:48:16.08,0:48:20.58,Default,,0,0,0,,Ал көлге апаратын жер асты кәріз жүйесі бар.
Dialogue: 0,0:48:20.58,0:48:24.45,Default,,0,0,0,,Сол су жолымен өтсеңіз, Шива қамалына жете аласыз.
Dialogue: 0,0:48:24.45,0:48:28.45,Default,,0,0,0,,Бұл Шива сарайы ма? Балалар, сол сарайға баруды жоспарлап отырсыздар ма?
Dialogue: 0,0:48:28.45,0:48:33.09,Default,,0,0,0,,Ол жер қазір хаос әскерінің қамалы. Ол не үшін?
Dialogue: 0,0:48:33.09,0:48:36.00,Default,,0,0,0,,Шива қамалын хаос әскерінен қайтарып алу.
Dialogue: 0,0:48:36.00,0:48:40.97,Default,,0,0,0,,Қайта алу? Қайта алу туралы не деуге болады? Мен сені күлдіремін
Dialogue: 0,0:48:40.97,0:48:45.10,Default,,0,0,0,,Біз қамалды құтқаратын ерікті әскерміз бе?
Dialogue: 0,0:48:45.10,0:48:47.61,Default,,0,0,0,,Мына әйелді қарашы, өлтіруші екен.
Dialogue: 0,0:48:47.61,0:48:52.11,Default,,0,0,0,,Ол туғаннан биік өкшелі туфли, автоматы бар сияқты.
Dialogue: 0,0:48:52.11,0:48:55.01,Default,,0,0,0,,Сейф-крекердің иесі
Dialogue: 0,0:48:55.01,0:48:58.62,Default,,0,0,0,,Және қалаған сый
Dialogue: 0,0:48:58.62,0:49:02.12,Default,,0,0,0,,Не керек, мен бомба жасаушымын.
Dialogue: 0,0:49:02.12,0:49:06.99,Default,,0,0,0,,Бұл ерікті күштер ме? Адал болайық.
Dialogue: 0,0:49:06.99,0:49:13.13,Default,,0,0,0,,Біз бәріміз қамалдың қазынасын іздейміз.
Dialogue: 0,0:49:13.13,0:49:20.13,Default,,0,0,0,,Менің ойымда Шива қамалында жасырылған тау қазынасы болды.
Dialogue: 0,0:49:37.16,0:49:40.16,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:49:48.17,0:49:51.67,Default,,0,0,0,,«Шива сарайы, өте жақын».
Dialogue: 0,0:49:51.67,0:49:58.18,Default,,0,0,0,,Жоқ, бұл Шинкиро. Нағыз Шива сарайы алыс.
Dialogue: 0,0:49:58.18,0:50:01.68,Default,,0,0,0,,Шиба сарайы адамдарды осылай шақырады.
Dialogue: 0,0:50:01.68,0:50:07.19,Default,,0,0,0,,Бір кездері әдемі болып көрінген бұл көрініс қазір қорқынышты иллюзияға айналды.
Dialogue: 0,0:50:07.19,0:50:12.06,Default,,0,0,0,,Джек! Дұрыс айтасыз, біз таңдадық.
Dialogue: 0,0:50:12.06,0:50:14.06,Default,,0,0,0,,Бұл жоспардың клиенті
Dialogue: 0,0:50:14.06,0:50:18.56,Default,,0,0,0,,Біздің әр қабілетімізді есептеп, бірге жинады.
Dialogue: 0,0:50:22.13,0:50:25.04,Default,,0,0,0,,Қазынаны ұрлау
Dialogue: 0,0:50:25.04,0:50:29.64,Default,,0,0,0,,Сарбаздарды өлтіру, қабырғаларды жару және сейфтерді бұзу.
Dialogue: 0,0:50:29.64,0:50:35.51,Default,,0,0,0,,Сонымен, Кобра, сенің рөлің қандай? Неліктен ол таңдалды?
Dialogue: 0,0:50:35.51,0:50:38.01,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:50:45.66,0:50:51.16,Default,,0,0,0,,Мен ол сарайда бір рет болдым.
Dialogue: 0,0:52:29.13,0:52:33.63,Default,,0,0,0,,<Ақыры Шива қамалына апаратын жерасты канализациясына жеттік>
Dialogue: 0,0:52:33.63,0:52:37.14,Default,,0,0,0,,＜Алайда, кіреберіс мықтап жабылды＞
Dialogue: 0,0:52:37.14,0:52:40.04,Default,,0,0,0,,<Оны ашу үшін хаос әскері толық күшінде.>
Dialogue: 0,0:52:40.04,0:52:44.01,Default,,0,0,0,,<Жалғыз жол - Сардора храмына жасырын кіру>
Dialogue: 0,0:52:44.01,0:52:46.15,Default,,0,0,0,,<Біз жасырын түрде кіріп алдық>
Dialogue: 0,0:52:46.15,0:52:49.05,Default,,0,0,0,,<Мен күдікті рәсім жасалып жатқан жерге тап болдым.>
Dialogue: 0,0:52:49.05,0:52:52.02,Default,,0,0,0,,<Олар мұнда не істеп жүр>
Dialogue: 0,0:52:52.02,0:52:54.02,Default,,0,0,0,,<Келесі «КОБРА АНИМАЦИЯ»…>
Dialogue: 0,0:55:35.61,0:55:39.49,Default,,0,0,0,,«Шива сарайы» Жоқ, бұл Шинкиро.
Dialogue: 0,0:55:39.49,0:55:43.12,Default,,0,0,0,,Шиба сарайы адамдарды осылай шақырады.
Dialogue: 0,0:55:43.12,0:55:45.06,Default,,0,0,0,,Бізді таңдадық
Dialogue: 0,0:55:45.06,0:55:46.99,Default,,0,0,0,,Бұл жоспардың клиенті
Dialogue: 0,0:55:46.99,0:55:53.13,Default,,0,0,0,,Әр қабілетімізді есептеп, бізді жинады.
Dialogue: 0,0:55:53.13,0:55:56.03,Default,,0,0,0,,Қазынаны ұрлау
Dialogue: 0,0:55:56.03,0:56:03.64,Default,,0,0,0,,Сонымен, Кобра, сенің рөлің қандай? Неліктен ол таңдалды?
Dialogue: 0,0:56:03.64,0:56:09.64,Default,,0,0,0,,Мен ол сарайда бір рет болғанмын.
Dialogue: 0,0:58:08.13,0:58:11.64,Default,,0,0,0,,Біз жерге жақындап келе жатырмыз.
Dialogue: 0,0:58:11.64,0:58:14.64,Default,,0,0,0,,Судың тереңдігі азайып барады.
Dialogue: 0,0:58:22.65,0:58:28.15,Default,,0,0,0,,Қараңдаршы, бұл орман. Бұл Сардора, Шиваның ұлы күші.
Dialogue: 0,0:58:30.16,0:58:33.66,Default,,0,0,0,,Осы орманның арғы жағында Сардора храмы орналасқан.
Dialogue: 0,0:58:33.66,0:58:39.46,Default,,0,0,0,,Шива қамалына апаратын жерасты канализациялары ғибадатхананың астында.
Dialogue: 0,0:58:39.46,0:58:43.10,Default,,0,0,0,,Бұл орман ертегі орманы деп аталады.
Dialogue: 0,0:58:43.10,0:58:48.97,Default,,0,0,0,,Сардораның ең әдемі жері. Мен осында тудым.
Dialogue: 0,0:58:48.97,0:58:50.98,Default,,0,0,0,,(балға ату дыбысы)
Dialogue: 0,0:58:50.98,0:58:56.62,Default,,0,0,0,,Бұл өткен күн. Енді бұл жер.
Dialogue: 0,0:58:56.62,0:59:01.12,Default,,0,0,0,,Бұл хаос күштері басып алған ұрыс алаңы екенін ұмытпаңыз.
Dialogue: 0,0:59:01.12,0:59:05.62,Default,,0,0,0,,Ертегі орманы? Маған құбыжықтың үйі сияқты көрінеді.
Dialogue: 0,0:59:05.62,0:59:07.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:10.13,0:59:13.63,Default,,0,0,0,,Цк, бұл қандай жер.
Dialogue: 0,0:59:13.63,0:59:16.13,Default,,0,0,0,,Кобра, сен не істеп жатырсың?
Dialogue: 0,0:59:16.13,0:59:18.07,Default,,0,0,0,,Балық аулау
Dialogue: 0,0:59:18.07,0:59:20.64,Default,,0,0,0,,Бұл жақсы сезім.
Dialogue: 0,0:59:20.64,0:59:24.14,Default,,0,0,0,,Мұнда лагерьде серуендеп келмеңіз.
Dialogue: 0,0:59:24.14,0:59:27.14,Default,,0,0,0,,Біз соғысуға келдік.
Dialogue: 0,0:59:29.01,0:59:31.01,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:59:38.09,0:59:40.03,Default,,0,0,0,,Не? Бұл жігіт
Dialogue: 0,0:59:40.03,0:59:43.60,Default,,0,0,0,,Абайлаңыз, бұл кеменің айналасында тағы бірнеше адам бар.
Dialogue: 0,0:59:43.60,0:59:45.53,Default,,0,0,0,,Хаос сарбаздары! асылу!
Dialogue: 0,0:59:45.53,0:59:48.47,Default,,0,0,0,,Ол хаос солдаты емес, ол одақтас!
Dialogue: 0,0:59:48.47,0:59:53.11,Default,,0,0,0,,Осы орманда хаос сарбаздарына қарсы күресіп жатқан бөренелер, партизандар.
Dialogue: 0,0:59:53.11,0:59:55.11,Default,,0,0,0,,Не?
Dialogue: 0,1:00:00.98,1:00:11.98,Default,,0,0,0,,(Лог пен Элиза арасындағы әңгіме)
Dialogue: 0,1:00:14.49,1:00:18.13,Default,,0,0,0,,Эй, сен бақаның аяғын жеп көрдің бе?
Dialogue: 0,1:00:18.13,1:00:20.07,Default,,0,0,0,,Жарай ма?
Dialogue: 0,1:00:20.07,1:00:24.00,Default,,0,0,0,,«Ой, сенің француз тағамын жеп көргеніңе таң қалдым».
Dialogue: 0,1:00:24.00,1:00:28.64,Default,,0,0,0,,Шулы, үндеме! Монитор Yarrow - бұл сәтсіздік!
Dialogue: 0,1:00:28.64,1:00:32.51,Default,,0,0,0,,"Айттым ғой! Сен мені де осыны айтуға мәжбүрлейсің!"
Dialogue: 0,1:00:32.51,1:00:36.45,Default,,0,0,0,,«Жоқ… күте тұрыңыз…»
Dialogue: 0,1:00:36.45,1:00:39.08,Default,,0,0,0,,Бұл жігіт! Сіз мұны істеуге дайынсыз ба?
Dialogue: 0,1:00:39.08,1:00:41.99,Default,,0,0,0,,Ауырды, бейбақ! «Монитор дегеніміз не?»
Dialogue: 0,1:00:41.99,1:00:44.96,Default,,0,0,0,,«Мен оны тоқтаттым.» Шулы!
Dialogue: 0,1:00:44.96,1:00:47.59,Default,,0,0,0,,Кобра Бұл жаман.
Dialogue: 0,1:00:47.59,1:00:51.10,Default,,0,0,0,,Жер асты канализациясының кіреберісі жабық сияқты.
Dialogue: 0,1:00:51.10,1:00:54.00,Default,,0,0,0,,Не? Сонымен не істеуім керек?
Dialogue: 0,1:00:54.00,1:00:57.97,Default,,0,0,0,,Жер асты канализациясының есігі Салдора ғибадатханасының астында.
Dialogue: 0,1:00:57.97,1:01:00.61,Default,,0,0,0,,Ол жерге барып, есікті ашсаңыз болғаны.
Dialogue: 0,1:01:00.61,1:01:06.11,Default,,0,0,0,,Сіз хаос әскері басып алған Сардора қаласына барасыз ба?
Dialogue: 0,1:01:06.11,1:01:10.62,Default,,0,0,0,,Өлтіретін сияқтысың. Бұл ақылсыз.
Dialogue: 0,1:01:10.62,1:01:12.55,Default,,0,0,0,,Мен барамын
Dialogue: 0,1:01:12.55,1:01:15.12,Default,,0,0,0,,Эй
Dialogue: 0,1:01:15.12,1:01:20.12,Default,,0,0,0,,Еріске қалдырайық, оның ерекше қабілеті бар.
Dialogue: 0,1:01:37.44,1:01:41.58,Default,,0,0,0,,Күте тұрыңыз! Эллис!
Dialogue: 0,1:01:41.58,1:01:46.08,Default,,0,0,0,,Мен ғибадатханаға барып, есікті ашамын.
Dialogue: 0,1:01:46.08,1:01:49.96,Default,,0,0,0,,Таң атқанша күтіңіз!
Dialogue: 0,1:01:49.96,1:01:53.96,Default,,0,0,0,,Уайымдама, ол жасайды.
Dialogue: 0,1:01:53.96,1:02:02.10,Default,,0,0,0,,20 жыл бұрын жадымнан айырылып, осы орманда қыдырдым.
Dialogue: 0,1:02:02.10,1:02:08.60,Default,,0,0,0,,Ол мені құтқарды, сол пері.
Dialogue: 0,1:02:23.12,1:02:26.63,Default,,0,0,0,,«Кобра, ұйықтап жатырсың ба?»
Dialogue: 0,1:02:26.63,1:02:29.13,Default,,0,0,0,,Не болды? Сегіз
Dialogue: 0,1:02:29.13,1:02:35.93,Default,,0,0,0,,"Менің атым Джуди. Эй, Кобра, менімен бірге болғың келе ме?"
Dialogue: 0,1:02:35.93,1:02:38.94,Default,,0,0,0,,«Бұл Джек - нағыз жауыз».
Dialogue: 0,1:02:38.94,1:02:41.57,Default,,0,0,0,,«Бұл әйел кәсіби өлтіруші».
Dialogue: 0,1:02:41.57,1:02:46.44,Default,,0,0,0,,«Сонымен қатар, есте сақтау қабілетінен айырылған сұмдық алпауыт пен анау пері».
Dialogue: 0,1:02:46.44,1:02:49.08,Default,,0,0,0,,«Мен бәріне сене алмаймын».
Dialogue: 0,1:02:49.08,1:02:52.58,Default,,0,0,0,,«Мен сенетін жалғыз адам - ​​сен, Кобра».
Dialogue: 0,1:02:52.58,1:02:55.49,Default,,0,0,0,,Сенің серігің болуы керек, Жеті.
Dialogue: 0,1:02:55.49,1:03:00.46,Default,,0,0,0,,"Мф, Фрэнк, бұл адам жақсы емес. Ол сөйлейтін ақымақ."
Dialogue: 0,1:03:00.46,1:03:04.10,Default,,0,0,0,,«Мен саған бұл жігіттің ақымақ екенін көрсетемін».
Dialogue: 0,1:03:04.10,1:03:07.97,Default,,0,0,0,,«Бұл бір жыл бұрын, екеуміз тірі болған кезде».
Dialogue: 0,1:03:07.97,1:03:12.60,Default,,0,0,0,,«Фрэнк екеуміз Чикагодағы банкті тонадық».
Dialogue: 0,1:03:12.60,1:03:14.54,Default,,0,0,0,,)
Dialogue: 0,1:03:14.54,1:03:16.47,Default,,0,0,0,,)
Dialogue: 0,1:03:16.47,1:03:20.11,Default,,0,0,0,,)
Dialogue: 0,1:03:20.11,1:03:22.05,Default,,0,0,0,,)
Dialogue: 0,1:03:22.05,1:03:24.98,Default,,0,0,0,,)
Dialogue: 0,1:03:24.98,1:03:28.62,Default,,0,0,0,,)
Dialogue: 0,1:03:28.62,1:03:31.52,Default,,0,0,0,,)
Dialogue: 0,1:03:31.52,1:03:34.43,Default,,0,0,0,,)
Dialogue: 0,1:03:34.43,1:03:37.06,Default,,0,0,0,,) ()
Dialogue: 0,1:03:37.06,1:03:39.56,Default,,0,0,0,,)
Dialogue: 0,1:03:39.56,1:03:43.06,Default,,0,0,0,,)
Dialogue: 0,1:03:45.07,1:03:49.57,Default,,0,0,0,,«Сонымен екеуі де жарылып кетті».
Dialogue: 0,1:03:49.57,1:03:54.45,Default,,0,0,0,,«Егер мен Шива сарайының қазынасын алсам, мен бұл ақшаны шынайы денеге ие болу үшін пайдаланамын».
Dialogue: 0,1:03:54.45,1:03:59.58,Default,,0,0,0,,«Ақшаң болса, адамның әйел денесін де алуға болады».
Dialogue: 0,1:03:59.58,1:04:03.09,Default,,0,0,0,,«Және сенімен…»
Dialogue: 0,1:04:03.09,1:04:08.96,Default,,0,0,0,,«Кобра, менің бастапқы денемді қара».
Dialogue: 0,1:04:08.96,1:04:11.60,Default,,0,0,0,,Ақшаны алған кезде
Dialogue: 0,1:04:11.60,1:04:14.50,Default,,0,0,0,,Бұған дейін теледидарды түске өзгертіңіз.
Dialogue: 0,1:04:14.50,1:04:19.50,Default,,0,0,0,,"Не?! Маған ең маңызды нәрсе!"
Dialogue: 0,1:04:28.05,1:04:31.05,Default,,0,0,0,,《Орман монахтары》
Dialogue: 0,1:04:43.53,1:04:46.03,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:04:51.07,1:04:53.07,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:54.94,1:04:57.58,Default,,0,0,0,,Не болды? Король!
Dialogue: 0,1:04:57.58,1:04:59.51,Default,,0,0,0,,Эллис тұтқынға алынды!
Dialogue: 0,1:04:59.51,1:05:05.51,Default,,0,0,0,,Патша! Барма! Король! Жалғыз барма!
Dialogue: 0,1:05:09.59,1:05:13.09,Default,,0,0,0,,Король ғибадатханаға бара жатыр! Маған жазыл!
Dialogue: 0,1:05:13.09,1:05:17.60,Default,,0,0,0,,Кобра! Ханшайым! Сүңгуір қайықтың бортына келіңіз!
Dialogue: 0,1:05:17.60,1:05:20.60,Default,,0,0,0,,Ғибадатхананың астында кездесейік!
Dialogue: 0,1:05:41.62,1:05:43.62,Default,,0,0,0,,«Бұл ғибадатхана».
Dialogue: 0,1:05:47.13,1:05:51.63,Default,,0,0,0,,"Бұл қауіпті. Механикалық аң бар. Оған кездейсоқ жақындауға болмайды."
Dialogue: 0,1:05:51.63,1:05:55.13,Default,,0,0,0,,Мұнда келгенде шу шығармаңыз. Мүмкіндігінше тезірек көлікке отырыңыз.
Dialogue: 0,1:05:55.13,1:05:58.04,Default,,0,0,0,,Су тасқынын ашайық, әлі емес.
Dialogue: 0,1:05:58.04,1:06:03.01,Default,,0,0,0,,Мен оларды іздемейінше, Кинг пен Эллистің қайда екенін білмеймін.
Dialogue: 0,1:06:03.01,1:06:08.15,Default,,0,0,0,,Хмф, сіз сыйлықтың басшысысыз. Сіз қашаннан бері достарыңызды осылай ойлай бастадыңыз?
Dialogue: 0,1:06:08.15,1:06:13.02,Default,,0,0,0,,Біз шлюзден өтіп, су жолына кірдік, бірақ ол жерден қайда барамыз?
Dialogue: 0,1:06:13.02,1:06:16.02,Default,,0,0,0,,Шива қамалының орнын тек патша біледі.
Dialogue: 0,1:06:16.02,1:06:20.16,Default,,0,0,0,,Түсіндім, ол сізге керек пе?
Dialogue: 0,1:06:20.16,1:06:25.03,Default,,0,0,0,,Екеуіңді бөліп, іздейік. 30 минуттан кейін осында тағы кездесейік.
Dialogue: 0,1:06:25.03,1:06:27.03,Default,,0,0,0,,Мұқият кобра
Dialogue: 0,1:06:27.03,1:06:30.17,Default,,0,0,0,,Ол бұл сіз екеніңізді түсінбей, сізді атып тастауы мүмкін.
Dialogue: 0,1:06:30.17,1:06:37.61,Default,,0,0,0,,Құпия сөзді айтыңыз: «90 60 90»
Dialogue: 0,1:06:37.61,1:06:39.54,Default,,0,0,0,,Не? Бұл дұрыс
Dialogue: 0,1:06:39.54,1:06:44.48,Default,,0,0,0,,Сіз білмейсіз бе? Марин Монро үш өлшемді
Dialogue: 0,1:06:44.48,1:06:47.98,Default,,0,0,0,,Монроның үш өлшемі?
Dialogue: 0,1:07:11.14,1:07:15.01,Default,,0,0,0,,Кешіріңіз, мен сізге киім-кешек беруіңізді сұраймын.
Dialogue: 0,1:07:15.01,1:07:18.51,Default,,0,0,0,,А? Не? Мынау
Dialogue: 0,1:07:24.16,1:07:31.16,Default,,0,0,0,,Мен әлгі механикалық аңның осындай нәрсені жасай алатынына таң қалдым ...
Dialogue: 0,1:07:33.16,1:07:35.60,Default,,0,0,0,,Патша!
Dialogue: 0,1:07:35.60,1:07:38.10,Default,,0,0,0,,«Мұндай жерде не істеп жүрсің?»
Dialogue: 0,1:07:38.10,1:07:40.61,Default,,0,0,0,,"Айттың ғой! Екеуіңді тап!"
Dialogue: 0,1:07:40.61,1:07:43.51,Default,,0,0,0,,«Онша шуламаңдар, мен туа біткен сымбаттымын».
Dialogue: 0,1:07:43.51,1:07:46.48,Default,,0,0,0,,«Мұны оларға қалдыру керек».
Dialogue: 0,1:07:46.48,1:07:50.62,Default,,0,0,0,,«Е, сен сондай ақымақсың».
Dialogue: 0,1:07:50.62,1:07:53.52,Default,,0,0,0,,≪90 ≪60
Dialogue: 0,1:07:53.52,1:07:58.49,Default,,0,0,0,,"Аа... Құпия сөз осы. Жасыңыз нешеде? Монро үш өлшемді."
Dialogue: 0,1:07:58.49,1:08:00.63,Default,,0,0,0,,«Сіз мұны білмейсіз!»
Dialogue: 0,1:08:00.63,1:08:02.56,Default,,0,0,0,,Не болды? Жамбастары
Dialogue: 0,1:08:02.56,1:08:06.50,Default,,0,0,0,,«Ахаха... мен 87-демін.»
Dialogue: 0,1:08:06.50,1:08:09.63,Default,,0,0,0,,Корольді ғибадатханаға кіргізді.
Dialogue: 0,1:08:09.63,1:08:11.57,Default,,0,0,0,,Эрис түсінбейді.
Dialogue: 0,1:08:11.57,1:08:15.57,Default,,0,0,0,,Жарайды, ғибадатхана! Мынаны киейік
Dialogue: 0,1:08:24.65,1:08:27.15,Default,,0,0,0,,«Сәлем»
Dialogue: 0,1:08:29.52,1:08:32.16,Default,,0,0,0,,«Ей, ақымақ, сен не істеп жатырсың?»
Dialogue: 0,1:08:32.16,1:08:36.66,Default,,0,0,0,,«Ой, мен сен күдіктенбеу үшін жай сәлем айтқан жоқпын».
Dialogue: 0,1:08:39.96,1:08:44.46,Default,,0,0,0,,Мен жарықты көремін. Артқы жағында бірдеңе болып жатыр.
Dialogue: 0,1:08:54.11,1:08:56.11,Default,,0,0,0,,Эллис…
Dialogue: 0,1:09:04.12,1:09:11.00,Default,,0,0,0,,Бізге даңқ пен өркендеуді, қараңғы тәңірімізді, ұлы тәңірімізді әкел.
Dialogue: 0,1:09:11.00,1:09:14.63,Default,,0,0,0,,Мына қызды құрбандыққа шал
Dialogue: 0,1:09:14.63,1:09:19.14,Default,,0,0,0,,Бұл «құрбандық». Мен мұндай нәрсені бірінші рет көруім.
Dialogue: 0,1:09:19.14,1:09:23.01,Default,,0,0,0,,Мен де қызды бірінші рет көріп тұрмын.
Dialogue: 0,1:09:23.01,1:09:26.64,Default,,0,0,0,,Жеті сегіз, олардың назарын аударыңыз.
Dialogue: 0,1:09:26.64,1:09:30.14,Default,,0,0,0,,"Не? Қалай?"
Dialogue: 0,1:09:32.15,1:09:38.59,Default,,0,0,0,,Тәңірім, қараңғылық Құдайым, өзіңді таныт.
Dialogue: 0,1:09:38.59,1:09:43.46,Default,,0,0,0,,(теледидар дыбысы)
Dialogue: 0,1:09:43.46,1:09:46.46,Default,,0,0,0,,«Мен бұл жұмыс істей ме?»
Dialogue: 0,1:09:46.46,1:09:51.10,Default,,0,0,0,,(теледидар дыбысы)
Dialogue: 0,1:09:51.10,1:09:54.61,Default,,0,0,0,,«Олар өтіп бара жатқан сияқты».
Dialogue: 0,1:09:54.61,1:09:58.11,Default,,0,0,0,,"Уау! Мына жақта келе жатыр!"
Dialogue: 0,1:10:28.14,1:10:30.64,Default,,0,0,0,,Эллис, ауырып қалдың ба?
Dialogue: 0,1:10:30.64,1:10:32.58,Default,,0,0,0,,Кобра…
Dialogue: 0,1:10:32.58,1:10:36.45,Default,,0,0,0,,"Түсіндім! Монахтар жойылды!"
Dialogue: 0,1:10:36.45,1:10:40.45,Default,,0,0,0,,Кобра, қарашы, бұл су жолының есігі.
Dialogue: 0,1:10:40.45,1:10:44.09,Default,,0,0,0,,Бұл жер асты кәріз есігіне қосылған.
Dialogue: 0,1:10:44.09,1:10:46.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:10:46.02,1:10:48.96,Default,,0,0,0,,Сонда мына нәрсені ашсаң, су жолы да ашылады ма?
Dialogue: 0,1:10:48.96,1:10:51.96,Default,,0,0,0,,"Мен таң қалдым. Бұл қызық қулық".
Dialogue: 0,1:10:51.96,1:10:56.60,Default,,0,0,0,,«Бұл құлыпты ашу үшін сізге тірі адам керек сияқты».
Dialogue: 0,1:10:56.60,1:10:59.50,Default,,0,0,0,,«Сондықтан оларға құрбандық қажет болды».
Dialogue: 0,1:10:59.50,1:11:01.47,Default,,0,0,0,,Бұл біз бар дегенді білдіреді
Dialogue: 0,1:11:01.47,1:11:04.48,Default,,0,0,0,,Есікті ашуыма бөгет болдыңыз.
Dialogue: 0,1:11:04.48,1:11:09.11,Default,,0,0,0,,Бұл «құрбандық». Кобра, өтінемін, менің үйімді құрбандыққа айналдыр.
Dialogue: 0,1:11:09.11,1:11:13.62,Default,,0,0,0,,Бұл мүмкін емес, өйткені мен қыз емеспін.
Dialogue: 0,1:11:13.62,1:11:16.12,Default,,0,0,0,,«Қыздық маңызды емес».
Dialogue: 0,1:11:16.12,1:11:19.62,Default,,0,0,0,,«Қан. Бұл затты ашу үшін қан керек».
Dialogue: 0,1:11:19.62,1:11:24.13,Default,,0,0,0,,Мен жұмыс біткенше күтемін деп ойладым, бірақ мүмкін болады.
Dialogue: 0,1:11:24.13,1:11:28.63,Default,,0,0,0,,Мен осы жерде өлуім керек сияқты.
Dialogue: 0,1:11:28.63,1:11:33.14,Default,,0,0,0,,Нигганың кек алуы? Мен сізге бұл үлгі емес екенін айттым.
Dialogue: 0,1:11:33.14,1:11:36.64,Default,,0,0,0,,Екеуің де тоқтаңдар! Ақымақ ақша!
Dialogue: 0,1:11:49.59,1:11:51.52,Default,,0,0,0,,Архиепископ Энгола
Dialogue: 0,1:11:51.52,1:11:55.09,Default,,0,0,0,,Адам болғанына қарамастан Хаос армиясының мүшесі болған зұлым адам.
Dialogue: 0,1:11:55.09,1:11:59.96,Default,,0,0,0,,Сізге рахмет айтқанымды қалайсыз ба, әлде кешірім сұрағанымды қалайсыз ба?
Dialogue: 0,1:11:59.96,1:12:03.96,Default,,0,0,0,,Тоқта, бұл менің ісім емес.
Dialogue: 0,1:12:06.60,1:12:09.10,Default,,0,0,0,,"Қараңдар! Қан!"
Dialogue: 0,1:12:13.11,1:12:16.61,Default,,0,0,0,,«Есік құлпы ашылған!»
Dialogue: 0,1:12:16.61,1:12:19.12,Default,,0,0,0,,Біз мұны жасадық! есік ашылады
Dialogue: 0,1:12:19.12,1:12:22.02,Default,,0,0,0,,«Бірақ мені бір нәрсе қызықтырады». «Не?»
Dialogue: 0,1:12:22.02,1:12:25.99,Default,,0,0,0,,«Архиепископ жаңа ғана Құдай өзін көрсетеді деп айтты».
Dialogue: 0,1:12:25.99,1:12:30.13,Default,,0,0,0,,«Ей, ақымақ, құдай бар ма?»
Dialogue: 0,1:12:30.13,1:12:33.13,Default,,0,0,0,,«О, міне, сен».
Dialogue: 0,1:12:42.07,1:12:44.07,Default,,0,0,0,,Патша!
Dialogue: 0,1:12:46.58,1:12:49.08,Default,,0,0,0,,Жат!
Dialogue: 0,1:12:54.09,1:12:56.99,Default,,0,0,0,,Не?
Dialogue: 0,1:12:56.99,1:13:01.99,Default,,0,0,0,,Ол энергия иесі. Мылтық жарамсыз. Жүгіріп кету!
Dialogue: 0,1:13:06.10,1:13:10.10,Default,,0,0,0,,Жер асты! Патшайым жертөледе болуы керек!
Dialogue: 0,1:13:15.61,1:13:18.11,Default,,0,0,0,,Жүгір!
Dialogue: 0,1:13:26.12,1:13:31.62,Default,,0,0,0,,Су тасқыны ашылады...
Dialogue: 0,1:13:34.93,1:13:37.56,Default,,0,0,0,,"Мынаны бұрын көрдіңіз бе? Айдаһар ғой!"
Dialogue: 0,1:13:37.56,1:13:39.50,Default,,0,0,0,,Сонымен не болды!
Dialogue: 0,1:13:39.50,1:13:42.07,Default,,0,0,0,,«Айдаһар неге мұндай жерде!»
Dialogue: 0,1:13:42.07,1:13:45.07,Default,,0,0,0,,Сонымен не керек?
Dialogue: 0,1:14:16.60,1:14:19.10,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,1:14:26.61,1:14:30.11,Default,,0,0,0,,Кобра! Мұнда!
Dialogue: 0,1:14:37.05,1:14:39.05,Default,,0,0,0,,Патша!
Dialogue: 0,1:14:49.07,1:14:51.00,Default,,0,0,0,,Сүңгу, толық жылдамдық алға!
Dialogue: 0,1:14:51.00,1:14:54.94,Default,,0,0,0,,Эллис, асығыңыз!
Dialogue: 0,1:14:54.94,1:14:56.94,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:59.08,1:15:01.58,Default,,0,0,0,,Оны ұстап ал да, кеттік!
Dialogue: 0,1:15:01.58,1:15:03.58,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:15:07.08,1:15:10.58,Default,,0,0,0,,Кобра қозғалмайды.
Dialogue: 0,1:15:12.59,1:15:16.09,Default,,0,0,0,,Боқ, механикалық аң?
Dialogue: 0,1:15:19.10,1:15:23.10,Default,,0,0,0,,Партизандар! Сен маған көмектесуге келдің.
Dialogue: 0,1:15:50.06,1:15:52.63,Default,,0,0,0,,Су беті жарқырап барады.
Dialogue: 0,1:15:52.63,1:15:55.13,Default,,0,0,0,,Мен көлге бардым.
Dialogue: 0,1:15:55.13,1:16:00.64,Default,,0,0,0,,Патша! Тұрақты! Король!
Dialogue: 0,1:16:00.64,1:16:09.14,Default,,0,0,0,,Кобра Мен айтқандай істе, ол жерде сарай бар.
Dialogue: 0,1:16:16.65,1:16:21.65,Default,,0,0,0,,Көлге ұқсайды, бірақ бәрі тұман, сондықтан ештеңе көрінбейді.
Dialogue: 0,1:16:32.67,1:16:36.11,Default,,0,0,0,,Жағаға тиген сияқты. Жарайды, қарап көрейік.
Dialogue: 0,1:16:36.11,1:16:40.98,Default,,0,0,0,,Патша Егер сіз дұрыс болсаңыз, онда осы жерде...
Dialogue: 0,1:16:40.98,1:16:44.62,Default,,0,0,0,,Кобра... «Мен есінен танып қалдым».
Dialogue: 0,1:16:44.62,1:16:47.12,Default,,0,0,0,,«Кинг күткендей, бұл жара...»
Dialogue: 0,1:16:47.12,1:16:52.12,Default,,0,0,0,,Корольді бақылаңыз, мен сыртта не болып жатқанын тексеремін.
Dialogue: 0,1:16:57.13,1:17:01.00,Default,,0,0,0,,Ромила... Ромила... өтінемін өлме.
Dialogue: 0,1:17:01.00,1:17:05.00,Default,,0,0,0,,Патша Сіз нені айтасыз? Бірдеңе есіңе түсті ме?
Dialogue: 0,1:17:05.00,1:17:07.50,Default,,0,0,0,,Сіздің жадыңыз қалпына келді ме?
Dialogue: 0,1:17:09.64,1:17:13.14,Default,,0,0,0,,Сол кезде қамал...
Dialogue: 0,1:18:48.11,1:18:50.04,Default,,0,0,0,,<Шиба қамалының мақсаты осы жерде>
Dialogue: 0,1:18:50.04,1:18:53.61,Default,,0,0,0,,<Кинг өзінің өткенін есіне түсіре бастаған сияқты>
Dialogue: 0,1:18:53.61,1:18:56.51,Default,,0,0,0,,<Ол да бірге өткен мұңды есіне алды.>
Dialogue: 0,1:18:56.51,1:19:00.48,Default,,0,0,0,,＜Сүйікті әйелім Ромила менің көз алдымда өлтірілді＞
Dialogue: 0,1:19:00.48,1:19:05.12,Default,,0,0,0,,<Ал сол қолында мылтық ұстаған жігіттің ісі екен>
Dialogue: 0,1:19:05.12,1:19:08.63,Default,,0,0,0,,<Е! Эх! Шива қамалын қалпына келтіру үшін әлі көп жол бар.
Dialogue: 0,1:19:08.63,1:19:11.13,Default,,0,0,0,,＜Бір-екі дүрбелең болатын сияқты.＞
Dialogue: 0,1:19:11.13,1:19:13.13,Default,,0,0,0,,<Келесі «КОБРА АНИМАЦИЯ»…>
Dialogue: 0,1:21:54.12,1:21:57.66,Default,,0,0,0,,Ромила... Ромила... өтінемін өлме.
Dialogue: 0,1:21:57.66,1:22:02.17,Default,,0,0,0,,Король, жадыңызды қалпына келтірдіңіз бе?
Dialogue: 0,1:22:02.17,1:22:04.67,Default,,0,0,0,,Ол кезде қамал...
Dialogue: 0,1:22:20.55,1:22:25.55,Default,,0,0,0,,Қамал хаос флотымен қоршалған.
Dialogue: 0,1:22:53.52,1:22:56.65,Default,,0,0,0,,)
Dialogue: 0,1:22:56.65,1:23:00.65,Default,,0,0,0,,)
Dialogue: 0,1:23:15.04,1:23:18.54,Default,,0,0,0,,)
Dialogue: 0,1:23:57.15,1:23:59.65,Default,,0,0,0,,)
Dialogue: 0,1:24:16.53,1:24:20.03,Default,,0,0,0,,)
Dialogue: 0,1:24:38.69,1:24:44.56,Default,,0,0,0,,Патша Сіз Шебаның Ұлы патшасы болдыңыз ба?
Dialogue: 0,1:24:44.56,1:24:52.20,Default,,0,0,0,,Сол кезде әйелімнің көлеңкесін денеме жағып жіберді.
Dialogue: 0,1:24:52.20,1:24:54.64,Default,,0,0,0,,Сол қолына мылтық таққан адам
Dialogue: 0,1:24:54.64,1:25:00.14,Default,,0,0,0,,Бұл дүниеде мұндай адам бір ғана.
Dialogue: 0,1:25:00.14,1:25:03.14,Default,,0,0,0,,Кобра
Dialogue: 0,1:25:05.02,1:25:11.16,Default,,0,0,0,,Иә? Қараңдар, тұман басылып жатыр.
Dialogue: 0,1:25:11.16,1:25:13.16,Default,,0,0,0,,Шива сарайы!
Dialogue: 0,1:27:15.01,1:27:18.02,Default,,0,0,0,,Хэхе... мұнда ешкім жоқ.
Dialogue: 0,1:27:18.02,1:27:22.15,Default,,0,0,0,,Мұнда бәрі қорқатын бірде-бір хаос әскері жоқ.
Dialogue: 0,1:27:22.15,1:27:25.66,Default,,0,0,0,,Эй, Зекро
Dialogue: 0,1:27:25.66,1:27:29.53,Default,,0,0,0,,Шамасы, хаос армиясы футбол ойындарына да барады.
Dialogue: 0,1:27:29.53,1:27:32.03,Default,,0,0,0,,Не?
Dialogue: 0,1:27:37.67,1:27:44.17,Default,,0,0,0,,Не болды? Барлығы сондай көңілсіз көрінеді. Олар жерлеуден қайтып келе жатыр ма?
Dialogue: 0,1:27:47.18,1:27:53.05,Default,,0,0,0,,Кобра, сіз бұл сарайда бұрын болғаныңызды айттыңыз.
Dialogue: 0,1:27:53.05,1:27:55.99,Default,,0,0,0,,Бұл қамалға шабуыл жасалғанда хаос әскері
Dialogue: 0,1:27:55.99,1:27:59.62,Default,,0,0,0,,Көп шетелдік әскерді жалдаған деп естідім.
Dialogue: 0,1:27:59.62,1:28:02.13,Default,,0,0,0,,Әй, түсіндім.
Dialogue: 0,1:28:02.13,1:28:06.00,Default,,0,0,0,,-де? Мен сондай солдат болдым ба?
Dialogue: 0,1:28:06.00,1:28:08.50,Default,,0,0,0,,Кобра
Dialogue: 0,1:28:12.64,1:28:17.51,Default,,0,0,0,,Сіз бұл бетті танисыз ба?
Dialogue: 0,1:28:17.51,1:28:19.51,Default,,0,0,0,,Ху Аруса
Dialogue: 0,1:28:19.51,1:28:23.15,Default,,0,0,0,,Күткендей... сен ол кездегі адамсың!
Dialogue: 0,1:28:23.15,1:28:25.15,Default,,0,0,0,,Тоқта, патша!
Dialogue: 0,1:28:31.66,1:28:33.66,Default,,0,0,0,,Ауырды!
Dialogue: 0,1:28:42.17,1:28:47.17,Default,,0,0,0,,Бұл құбыжық! Ол мені осы жерге дейін қуды!
Dialogue: 0,1:28:51.68,1:28:55.68,Default,,0,0,0,,Патша! Кобраға көмектес!
Dialogue: 0,1:28:58.12,1:29:01.62,Default,,0,0,0,,Кобра сені құтқарды!
Dialogue: 0,1:29:11.13,1:29:14.63,Default,,0,0,0,,Не болды? кобра өлді
Dialogue: 0,1:29:14.63,1:29:18.63,Default,,0,0,0,,Сіздің жауыңыз, солай ма? Сіз бақытты емессіз бе?
Dialogue: 0,1:29:29.15,1:29:31.65,Default,,0,0,0,,Оқ жаудырыңдар! Бүйіріне нысана ал!
Dialogue: 0,1:29:31.65,1:29:34.65,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:29:43.16,1:29:45.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:45.66,1:29:49.66,Default,,0,0,0,,Бұл хаос әскерінің анасы.
Dialogue: 0,1:30:02.61,1:30:06.61,Default,,0,0,0,,Түсіндім, міне, осы.
Dialogue: 0,1:30:22.63,1:30:26.13,Default,,0,0,0,,"Ой? Ия! Ашық!"
Dialogue: 0,1:30:50.16,1:30:52.66,Default,,0,0,0,,О...
Dialogue: 0,1:30:58.97,1:31:01.97,Default,,0,0,0,,«Уау...»
Dialogue: 0,1:31:17.12,1:31:21.99,Default,,0,0,0,,«Бұл ақша!» Алақай! Бұл қазына!
Dialogue: 0,1:31:21.99,1:31:25.00,Default,,0,0,0,,"Мына жігітке қараңдар! Ол жасады!"
Dialogue: 0,1:31:25.00,1:31:29.13,Default,,0,0,0,,«Мен жасадым!» «Бұл қазына!»
Dialogue: 0,1:31:29.13,1:31:33.00,Default,,0,0,0,,«Ғажайып!» «Ахаха...»
Dialogue: 0,1:31:33.00,1:31:36.01,Default,,0,0,0,,«Мұның бәрі біздікі!»
Dialogue: 0,1:31:36.01,1:31:39.64,Default,,0,0,0,,«Хахаха...!»
Dialogue: 0,1:31:39.64,1:31:44.15,Default,,0,0,0,,Олардың бәрі біздікі! Хахаха...!
Dialogue: 0,1:31:44.15,1:31:49.02,Default,,0,0,0,,«Кя!» «Хахаха...!»
Dialogue: 0,1:31:49.02,1:31:52.02,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:32:04.17,1:32:07.07,Default,,0,0,0,,Бұл менікі
Dialogue: 0,1:32:07.07,1:32:10.67,Default,,0,0,0,,Эй, сен мұның бәрін өзіңе қалдыруды жоспарлап жүрсің бе?
Dialogue: 0,1:32:10.67,1:32:16.18,Default,,0,0,0,,Бұл қызық, байқап көріңіз! Мұндай мылтық маған жұмыс істей ме?
Dialogue: 0,1:32:16.18,1:32:20.05,Default,,0,0,0,,Бұл мылтықпен олай істей алмайсың.
Dialogue: 0,1:32:20.05,1:32:24.05,Default,,0,0,0,,Бұл мылтық ше?
Dialogue: 0,1:32:41.20,1:32:43.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:17.67,1:33:23.55,Default,,0,0,0,,Не дейсің, ол кезде...
Dialogue: 0,1:33:23.55,1:33:26.18,Default,,0,0,0,,Бұл сіз болдыңыз ба?
Dialogue: 0,1:33:26.18,1:33:31.69,Default,,0,0,0,,Ал, келесі жолы мен сенің дұрыс өлуіңді қадағалаймын.
Dialogue: 0,1:33:31.69,1:33:34.19,Default,,0,0,0,,Сіз кімсіз!
Dialogue: 0,1:33:34.19,1:33:36.69,Default,,0,0,0,,Мен?
Dialogue: 0,1:33:36.69,1:33:39.20,Default,,0,0,0,,Мен...
Dialogue: 0,1:33:39.20,1:33:41.20,Default,,0,0,0,,Хаос солдаты
Dialogue: 0,1:33:48.71,1:33:51.21,Default,,0,0,0,,Кобра!
Dialogue: 0,1:34:00.65,1:34:03.55,Default,,0,0,0,,Королева хаос солдаты ма?
Dialogue: 0,1:34:03.55,1:34:11.16,Default,,0,0,0,,Иә, ол қамалды қайтарып алудың жоспарын ойлап тапты.
Dialogue: 0,1:34:11.16,1:34:16.16,Default,,0,0,0,,Ол өтініш формасын жіберіп, бізді жинады.
Dialogue: 0,1:34:18.03,1:34:22.67,Default,,0,0,0,,Бұл әйел клиент.
Dialogue: 0,1:34:22.67,1:34:26.54,Default,,0,0,0,,Мен неге хаос солдатымын?
Dialogue: 0,1:34:26.54,1:34:30.18,Default,,0,0,0,,Хун, мен сенен сұрадым.
Dialogue: 0,1:34:30.18,1:34:32.12,Default,,0,0,0,,)
Dialogue: 0,1:34:32.12,1:34:35.69,Default,,0,0,0,,)
Dialogue: 0,1:34:35.69,1:34:39.19,Default,,0,0,0,,() ((Де? Сіз))
Dialogue: 0,1:34:39.19,1:34:45.06,Default,,0,0,0,,)
Dialogue: 0,1:34:45.06,1:34:51.70,Default,,0,0,0,,)
Dialogue: 0,1:34:51.70,1:34:53.64,Default,,0,0,0,,Паруре
Dialogue: 0,1:34:53.64,1:34:59.14,Default,,0,0,0,,Бұл Жан Пол Гарлен жасаған ең хош иісті парфюмерия.
Dialogue: 0,1:34:59.14,1:35:03.01,Default,,0,0,0,,Майдың иісін осылай жасырдың.
Dialogue: 0,1:35:03.01,1:35:07.65,Default,,0,0,0,,Бірақ неге бұл өтінішті жібердім дедің?
Dialogue: 0,1:35:07.65,1:35:11.52,Default,,0,0,0,,Сол конвертте мен алдым
Dialogue: 0,1:35:11.52,1:35:16.16,Default,,0,0,0,,Парураның әлсіз иісі қалды.
Dialogue: 0,1:35:16.16,1:35:22.16,Default,,0,0,0,,Күткендей, Кобра, сен оны басынан-ақ білдің.
Dialogue: 0,1:35:34.54,1:35:40.68,Default,,0,0,0,,Сіздің қалауыңыз болды ма? Қызықты, қызықты жеке тұлға.
Dialogue: 0,1:35:40.68,1:35:44.19,Default,,0,0,0,,Рухани таза жандар менің нәсілімнен.
Dialogue: 0,1:35:44.19,1:35:51.06,Default,,0,0,0,,Адам сияқты қалауы бар даралардың туылуы мүмкін бе?
Dialogue: 0,1:35:51.06,1:35:53.63,Default,,0,0,0,,Менімен ассимиляция
Dialogue: 0,1:35:53.63,1:35:58.50,Default,,0,0,0,,Сол біліміңізді менімен бөлісіңіз!
Dialogue: 0,1:35:58.50,1:36:02.64,Default,,0,0,0,,Тоқта! Мен ассимиляция жасағым келмейді!
Dialogue: 0,1:36:02.64,1:36:05.14,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,1:36:05.14,1:36:09.64,Default,,0,0,0,,Көмектесіңіз! Кобра!
Dialogue: 0,1:36:25.53,1:36:28.16,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,1:36:28.16,1:36:33.67,Default,,0,0,0,,Ол хаос әскерінің басшысы. Бұл сарайда ол жалғыз.
Dialogue: 0,1:36:33.67,1:36:38.17,Default,,0,0,0,,Бұл жігіт мұндағы барлық хаос сарбаздарын басқарады.
Dialogue: 0,1:36:38.17,1:36:40.11,Default,,0,0,0,,Хаха...
Dialogue: 0,1:36:40.11,1:36:44.68,Default,,0,0,0,,Менің нәсілім туралы көп білетін сияқтысың.
Dialogue: 0,1:36:44.68,1:36:49.55,Default,,0,0,0,,Жарайды, мен сенің үйіңді көруім керек.
Dialogue: 0,1:36:49.55,1:36:51.55,Default,,0,0,0,,Не?
Dialogue: 0,1:36:51.55,1:36:56.63,Default,,0,0,0,,Мен жоқта кешірім сұраймын, бірақ маған ананың іші көрсетілді.
Dialogue: 0,1:36:56.63,1:36:59.53,Default,,0,0,0,,Оның әдемі интерьері болды.
Dialogue: 0,1:36:59.53,1:37:02.50,Default,,0,0,0,,Олай болса мен сізге тағы бір құпияны айтайын.
Dialogue: 0,1:37:02.50,1:37:07.64,Default,,0,0,0,,Біздің нәсіл басқа тіршілік формаларының өмірлік энергиясын сіңіреді.
Dialogue: 0,1:37:07.64,1:37:12.14,Default,,0,0,0,,Сол білімді үйрен!
Dialogue: 0,1:37:12.14,1:37:15.65,Default,,0,0,0,,Сонда сен бізді жейсің бе?
Dialogue: 0,1:37:15.65,1:37:20.15,Default,,0,0,0,,Менің тамақ ішуге уақытым жоқ. Уақыт таяп қалды.
Dialogue: 0,1:37:20.15,1:37:23.65,Default,,0,0,0,,Уақыт ше? Бұл не?
Dialogue: 0,1:37:23.65,1:37:27.15,Default,,0,0,0,,Сіздің үйіңіздің жоғалатын уақыты келді.
Dialogue: 0,1:37:48.68,1:37:56.12,Default,,0,0,0,,Хаос адамдар Рухты сақтау сферасынсыз басқа планеталарда өмір сүре алмайды.
Dialogue: 0,1:37:56.12,1:37:59.62,Default,,0,0,0,,Тіпті бастықтың өзі де ерекшелік емес.
Dialogue: 0,1:37:59.62,1:38:02.53,Default,,0,0,0,,Аналық кеме ішіндегі өріс генераторы
Dialogue: 0,1:38:02.53,1:38:09.13,Default,,0,0,0,,Мен оны қорғау үшін оны қоршап қойдым.
Dialogue: 0,1:38:09.13,1:38:13.00,Default,,0,0,0,,Аналық ара өлсе, жұмысшы аралар да өледі.
Dialogue: 0,1:38:13.00,1:38:15.00,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,1:38:15.00,1:38:19.14,Default,,0,0,0,,Қазіргі уақытта бұл планетадағы барлық хаос сарбаздары жерге құлап жатыр.
Dialogue: 0,1:38:19.14,1:38:22.05,Default,,0,0,0,,Сұлу Сардора өмірге қайта оралады!
Dialogue: 0,1:38:22.05,1:38:24.01,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,1:38:24.01,1:38:28.15,Default,,0,0,0,,Патша, сен тағы патшасың.
Dialogue: 0,1:38:28.15,1:38:33.66,Default,,0,0,0,,Кобра, сенің мұнда не үшін келгеніңді әлі естіген жоқпын.
Dialogue: 0,1:38:33.66,1:38:36.16,Default,,0,0,0,,Мен бе?
Dialogue: 0,1:38:36.16,1:38:40.03,Default,,0,0,0,,Қазына
Dialogue: 0,1:38:40.03,1:38:44.03,Default,,0,0,0,,Бұл жақсы рубин. Сіз онымен арал сатып ала аласыз.
Dialogue: 0,1:38:44.03,1:38:46.03,Default,,0,0,0,,Мен аламын.
Dialogue: 0,1:38:57.48,1:39:03.98,Default,,0,0,0,,Бұл ұшатын қайық сәл дірілдеп тұр, бірақ мен оның әйтеуір ұшатынына сенімдімін.
Dialogue: 0,1:39:26.51,1:39:31.65,Default,,0,0,0,,«Енді мен бұл жігітпен ақыры ажыраса аламын».
Dialogue: 0,1:39:31.65,1:39:36.15,Default,,0,0,0,,Сіз Фрэнкті жақсы көрдіңіз, солай ма?
Dialogue: 0,1:39:43.16,1:39:48.03,Default,,0,0,0,,Онымен тірі денені ал.
Dialogue: 0,1:39:48.03,1:39:53.03,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,1:39:55.10,1:40:01.61,Default,,0,0,0,,Бейшара Джек, ол көп қазына алғысы келді.
Dialogue: 0,1:40:01.61,1:40:05.48,Default,,0,0,0,,Бұл...
Dialogue: 0,1:40:05.48,1:40:08.12,Default,,0,0,0,,Кобраның іздеген кітабы
Dialogue: 0,1:40:08.12,1:40:11.62,Default,,0,0,0,,Джек Кобраны өзінің жауы деп ойлады.
Dialogue: 0,1:40:11.62,1:40:13.56,Default,,0,0,0,,Бұл бет...
Dialogue: 0,1:40:13.56,1:40:20.56,Default,,0,0,0,,Кобра пластикалық ота жасатқан көрінеді. Бұл оның бетін өзгерткенге дейінгі Кобра.
Dialogue: 0,1:40:35.65,1:40:38.15,Default,,0,0,0,,)
Dialogue: 0,1:40:38.15,1:40:40.65,Default,,0,0,0,,)
