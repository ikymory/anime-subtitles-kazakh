Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.71,0:00:03.42,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:00:03.58,0:00:05.75,Default,,0,0,0,,Ол Мобиустағы ең керемет жігіт.
Dialogue: 0,0:00:07.00,0:00:09.96,Default,,0,0,0,,Бірақ алдымен бірдеңе айтуым керек.
Dialogue: 0,0:00:10.34,0:00:12.63,Default,,0,0,0,,Мен қазір MAX ашуланып тұрмын
Dialogue: 0,0:00:12.76,0:00:13.97,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:00:15.43,0:00:17.39,Default,,0,0,0,,Сол күні бұзық Изуру Минезавамен
Dialogue: 0,0:00:17.51,0:00:18.93,Default,,0,0,0,,Ұрыс кезінде――
Dialogue: 0,0:00:19.10,0:00:21.73,Default,,0,0,0,,Өйткені мен төбелесе алмадым.
Dialogue: 0,0:00:23.23,0:00:24.60,Default,,0,0,0,,Содан бері бір ай өтті
Dialogue: 0,0:00:25.31,0:00:27.44,Default,,0,0,0,,μ әлі ұйықтап жатыр...
Dialogue: 0,0:00:29.98,0:00:31.90,Default,,0,0,0,,Тіпті музыканттар да жарқылдап қозғала алмайды.
Dialogue: 0,0:00:33.32,0:00:35.36,Default,,0,0,0,,Сол қаскөйлер қазір бізге телефон соғып жатыр...
Dialogue: 0,0:00:35.49,0:00:38.16,Default,,0,0,0,,Мен сені мазақ етіп жатыр деп ойладым...
Dialogue: 0,0:00:40.20,0:00:42.45,Default,,0,0,0,,Біздің әділеттілік енді...
Dialogue: 0,0:00:42.58,0:00:44.75,Default,,0,0,0,,Бұзылады
Dialogue: 0,0:00:45.17,0:00:50.17,Default,,0,0,0,,♪～
Dialogue: 0,0:02:09.21,0:02:14.21,Default,,0,0,0,,～♪
Dialogue: 0,0:02:16.26,0:02:18.17,Default,,0,0,0,,Дағдарыс нүктесінің сол күнінен бастап
Dialogue: 0,0:02:18.30,0:02:19.88,Default,,0,0,0,,Үш аптадан кейін де...
Dialogue: 0,0:02:20.51,0:02:24.35,Default,,0,0,0,,Мобиустың әлі де соғыстан қалған тыртықтары болды.
Dialogue: 0,0:02:24.43,0:02:25.18,Default,,0,0,0,,Қызық екен!
Dialogue: 0,0:02:25.18,0:02:26.43,Default,,0,0,0,,Қызық екен!
Dialogue: 0,0:02:25.18,0:02:26.43,Default,,0,0,0,,Бірақ мұндай кезде де...
Dialogue: 0,0:02:26.43,0:02:27.89,Default,,0,0,0,,Бірақ мұндай кезде де...
Dialogue: 0,0:02:28.02,0:02:30.85,Default,,0,0,0,,Менің тамашалығымның шегі жоқ...
Dialogue: 0,0:02:31.19,0:02:32.81,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:02:33.27,0:02:35.19,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:02:35.36,0:02:37.61,Default,,0,0,0,,ИкеП мырза
Dialogue: 0,0:02:37.74,0:02:40.86,Default,,0,0,0,,Мені ұста~ Маған тұрмысқа шық~
Dialogue: 0,0:02:41.32,0:02:42.53,Default,,0,0,0,,Хехе
Dialogue: 0,0:02:42.66,0:02:45.58,Default,,0,0,0,,Кя! Ахх...
Dialogue: 0,0:02:46.24,0:02:47.70,Default,,0,0,0,,Әйелдер үшін-
Dialogue: 0,0:02:47.83,0:02:50.87,Default,,0,0,0,,Мен қараңғылықты нұрландыратын полярлық жұлдызмын.
Dialogue: 0,0:02:51.00,0:02:54.00,Default,,0,0,0,,Бұл мен қалаған экстаз...
Dialogue: 0,0:02:54.25,0:02:55.71,Default,,0,0,0,,Үлкен рахат!
Dialogue: 0,0:02:56.75,0:02:58.46,Default,,0,0,0,,Хаха!
Dialogue: 0,0:02:58.76,0:03:02.05,Default,,0,0,0,,Бұл Мебиустағы барлық әйелдерді жоғалтқанмен бірдей.
Dialogue: 0,0:03:02.18,0:03:03.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:02.18,0:03:03.18,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:03:03.18,0:03:03.64,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:03:03.64,0:03:06.18,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:03:03.64,0:03:06.18,Default,,0,0,0,,Енді мен өз дауысымды естігім келеді, котенканың махаббат қоңырауы.
Dialogue: 0,0:03:06.18,0:03:07.89,Default,,0,0,0,,Енді мен өз дауысымды естігім келеді, котенканың махаббат қоңырауы.
Dialogue: 0,0:03:08.14,0:03:10.23,Default,,0,0,0,,Да~кара~ра~!
Dialogue: 0,0:03:10.35,0:03:12.73,Default,,0,0,0,,μ қанша уақыт ұйықтайды?
Dialogue: 0,0:03:12.85,0:03:14.65,Default,,0,0,0,,Құрылыс мүлде алға баспайды.
Dialogue: 0,0:03:14.77,0:03:16.82,Default,,0,0,0,,Өмірдің бұл түрі өз шегіне жетті!
Dialogue: 0,0:03:16.94,0:03:19.57,Default,,0,0,0,,Оны мүмкіндігінше тезірек бастапқы теңіз параизосына қайтарыңыз.
Dialogue: 0,0:03:20.11,0:03:22.11,Default,,0,0,0,,Менен де күткендей, Ұйқыдағы ару
Dialogue: 0,0:03:22.24,0:03:23.99,Default,,0,0,0,,Оянғанша білмейсің
Dialogue: 0,0:03:24.12,0:03:25.53,Default,,0,0,0,,Пайдасыз!
Dialogue: 0,0:03:25.83,0:03:28.33,Default,,0,0,0,,Шынында да, сіз жай ғана бет екенсіз.
Dialogue: 0,0:03:28.45,0:03:30.62,Default,,0,0,0,,Ей, әй, мені көп мақтама.
Dialogue: 0,0:03:30.75,0:03:32.37,Default,,0,0,0,,Хмм... га...
Dialogue: 0,0:03:33.04,0:03:33.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:34.21,0:03:37.71,Default,,0,0,0,,Күлсінген бақыт кетеді дейді.
Dialogue: 0,0:03:37.84,0:03:39.09,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:03:39.80,0:03:42.55,Default,,0,0,0,,Мен тағы неден қаша аламын?
Dialogue: 0,0:03:45.47,0:03:46.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:47.35,0:03:48.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:48.60,0:03:50.39,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:50.52,0:03:53.19,Default,,0,0,0,,Кәдімгі шай жапырақтары қоймада жоқ...
Dialogue: 0,0:03:53.77,0:03:55.48,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:03:58.44,0:04:00.57,Default,,0,0,0,,Бұл Мобиус, солай ма?
Dialogue: 0,0:04:01.11,0:04:02.07,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:02.20,0:04:04.70,Default,,0,0,0,,Себебі μ күші әлсірейді, солай ма?
Dialogue: 0,0:04:04.86,0:04:06.49,Default,,0,0,0,,μ ұйықтап кеткеннен кейін
Dialogue: 0,0:04:06.62,0:04:08.33,Default,,0,0,0,,Баяғыда емес пе?
Dialogue: 0,0:04:08.45,0:04:10.04,Default,,0,0,0,,Сонымен, Мобиусты сақтау үшін
Dialogue: 0,0:04:10.16,0:04:12.96,Default,,0,0,0,,Мына жерде бір мәселе бар сияқты.
Dialogue: 0,0:04:13.29,0:04:14.71,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:14.83,0:04:17.00,Default,,0,0,0,,NPC ғимараттарды жөндеуде.
Dialogue: 0,0:04:17.13,0:04:18.34,Default,,0,0,0,,Соған байланысты ма?
Dialogue: 0,0:04:18.75,0:04:21.46,Default,,0,0,0,,Иә, тіршілік әрекетіне қажет емес заттар
Dialogue: 0,0:04:21.59,0:04:24.05,Default,,0,0,0,,Барған сайын кейінге шегерілетін сияқты.
Dialogue: 0,0:04:24.22,0:04:27.76,Default,,0,0,0,,Менің сүйікті дүкенім де жабылды.
Dialogue: 0,0:04:28.51,0:04:32.98,Default,,0,0,0,,Әлі де біраз нәрселер қалды, бірақ... хмм...
Dialogue: 0,0:04:37.23,0:04:38.65,Default,,0,0,0,,Жүріңдер, асығып кетейік.
Dialogue: 0,0:04:39.32,0:04:41.53,Default,,0,0,0,,Сүйкімді де, дәмді де
Dialogue: 0,0:04:41.65,0:04:43.61,Default,,0,0,0,,Егер бәрі жоғалып кетсе...
Dialogue: 0,0:04:43.95,0:04:44.86,Default,,0,0,0,,Мен әлсіз ештеңе айтып тұрған жоқпын!
Dialogue: 0,0:04:44.86,0:04:46.07,Default,,0,0,0,,Мен әлсіз ештеңе айтып тұрған жоқпын!
Dialogue: 0,0:04:44.86,0:04:46.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:46.20,0:04:49.37,Default,,0,0,0,,Менің қазіргі өмірімнен бас тарту ойым жоқ!
Dialogue: 0,0:04:49.49,0:04:52.04,Default,,0,0,0,,Мебиусқа не үшін келді деп ойлайсың?
Dialogue: 0,0:04:52.41,0:04:53.45,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:04:53.58,0:04:56.21,Default,,0,0,0,,Маған тезірек ояну үшін μ керек...
Dialogue: 0,0:04:56.33,0:04:57.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:57.79,0:05:00.88,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:05:01.38,0:05:03.88,Default,,0,0,0,,Жаман болғаны рас...
Dialogue: 0,0:05:05.01,0:05:05.84,Default,,0,0,0,,Не!
Dialogue: 0,0:05:08.26,0:05:08.80,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:05:08.80,0:05:09.64,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:05:08.80,0:05:09.64,Default,,0,0,0,,Сәлем, Минезава-кун~
Dialogue: 0,0:05:09.64,0:05:09.93,Default,,0,0,0,,Сәлем, Минезава-кун~
Dialogue: 0,0:05:09.93,0:05:10.85,Default,,0,0,0,,Сәлем, Минезава-кун~
Dialogue: 0,0:05:09.93,0:05:10.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:12.89,0:05:14.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:14.43,0:05:15.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:16.06,0:05:17.48,Default,,0,0,0,,А, бұл
Dialogue: 0,0:05:17.60,0:05:19.56,Default,,0,0,0,,Мен мұны жасадым, жеп қойыңыз.
Dialogue: 0,0:05:19.69,0:05:21.15,Default,,0,0,0,,Жоқ, бұл маған қажет емес.
Dialogue: 0,0:05:21.27,0:05:22.11,Default,,0,0,0,,А...
Dialogue: 0,0:05:22.23,0:05:23.82,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:05:23.94,0:05:26.57,Default,,0,0,0,,Сіз дөрекі адамсыз, Минезава.
Dialogue: 0,0:05:26.70,0:05:30.24,Default,,0,0,0,,Ханымның ойы торға қамалып, сыйлықты қабылдамай қойды.
Dialogue: 0,0:05:30.37,0:05:32.79,Default,,0,0,0,,Әйелдерді ренжіту қызық па?
Dialogue: 0,0:05:34.62,0:05:36.62,Default,,0,0,0,,Эй... сәл күте тұрыңыз!
Dialogue: 0,0:05:36.75,0:05:37.96,Default,,0,0,0,,О...
Dialogue: 0,0:05:38.54,0:05:40.00,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:05:41.17,0:05:43.46,Default,,0,0,0,,Мынау өте қорқынышты...
Dialogue: 0,0:05:43.59,0:05:44.59,Default,,0,0,0,,Сәлем? (Оқушылар қыздар) Уау~
Dialogue: 0,0:05:44.71,0:05:46.22,Default,,0,0,0,,Керемет (IkeP) Иә?
Dialogue: 0,0:05:46.34,0:05:49.22,Default,,0,0,0,,Түсіндім, салқынқандылық шыдамайды.
Dialogue: 0,0:05:49.34,0:05:51.14,Default,,0,0,0,,Ах... Ой...
Dialogue: 0,0:05:51.26,0:05:53.97,Default,,0,0,0,,Минезава-кун, күте тұрыңыз~
Dialogue: 0,0:05:54.10,0:05:55.43,Default,,0,0,0,,Хаха ахаха…
Dialogue: 0,0:05:55.56,0:05:56.98,Default,,0,0,0,,Минезава-кун~ (Студент қыз) Күтіңіз~
Dialogue: 0,0:05:57.10,0:05:57.94,Default,,0,0,0,,Ай жарығы қайтадан жарқыраған сәтте дейік
Dialogue: 0,0:05:58.94,0:06:00.77,Default,,0,0,0,,Изуру Минезава…
Dialogue: 0,0:06:00.90,0:06:04.03,Default,,0,0,0,,Мен оны көргеннен бастап жек көрдім.
Dialogue: 0,0:06:04.15,0:06:06.57,Default,,0,0,0,,Сол әдемі жүз мен суық көздер...
Dialogue: 0,0:06:07.28,0:06:09.03,Default,,0,0,0,,Мен оны шындықта қалдырдым.
Dialogue: 0,0:06:09.16,0:06:11.57,Default,,0,0,0,,Жағымсыз нәрселерді есіме түсіреді
Dialogue: 0,0:06:13.45,0:06:15.45,Default,,0,0,0,,Мебиустан кез келген нәрсені алуға болады
Dialogue: 0,0:06:16.79,0:06:19.25,Default,,0,0,0,,Мен шындықта бола алмадым
Dialogue: 0,0:06:20.63,0:06:23.34,Default,,0,0,0,,Мен шындықта жоғалтқан өзім
Dialogue: 0,0:06:24.67,0:06:27.88,Default,,0,0,0,,Үнсіздікті қаласаң, үндеме...
Dialogue: 0,0:06:29.22,0:06:31.22,Default,,0,0,0,,Билікті қаласаң, билік...
Dialogue: 0,0:06:33.85,0:06:35.26,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:06:35.39,0:06:36.18,Default,,0,0,0,,(Студент қыздардың шуы)
Dialogue: 0,0:06:36.18,0:06:37.18,Default,,0,0,0,,(Студент қыздардың шуы)
Dialogue: 0,0:06:36.18,0:06:37.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:38.02,0:06:39.44,Default,,0,0,0,,ИкеП мырза~
Dialogue: 0,0:06:39.56,0:06:41.73,Default,,0,0,0,,Мен нені қатты қаладым
Dialogue: 0,0:06:41.85,0:06:43.65,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:06:43.77,0:06:45.94,Default,,0,0,0,,Талант Әдемі тұлға
Dialogue: 0,0:06:46.07,0:06:47.94,Default,,0,0,0,,Әйелдердің көзқарасы
Dialogue: 0,0:06:48.07,0:06:50.57,Default,,0,0,0,,Мұндай жұмақ жоқ
Dialogue: 0,0:06:50.70,0:06:53.32,Default,,0,0,0,,Мебиус – әділет!
Dialogue: 0,0:06:54.62,0:06:57.08,Default,,0,0,0,,Рицу-сенпай, таптым.
Dialogue: 0,0:06:58.04,0:06:59.37,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:06:59.50,0:07:00.83,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:00.96,0:07:03.38,Default,,0,0,0,,Мобиусты көп нәрсемен араластырып жатыр.
Dialogue: 0,0:07:03.50,0:07:05.25,Default,,0,0,0,,Білмеймін деп тұрсың ба?
Dialogue: 0,0:07:05.38,0:07:08.09,Default,,0,0,0,,Қараңыз, өйткені μ онда жоқ.
Dialogue: 0,0:07:08.21,0:07:10.13,Default,,0,0,0,,Бұл кешегі ұрыс кезіндегі жарақат.
Dialogue: 0,0:07:10.26,0:07:12.09,Default,,0,0,0,,Ол әлі жазылмаған.
Dialogue: 0,0:07:14.01,0:07:15.43,Default,,0,0,0,,Әй, Сенпай
Dialogue: 0,0:07:15.93,0:07:18.89,Default,,0,0,0,,Неліктен шындыққа оралғыңыз келеді?
Dialogue: 0,0:07:19.43,0:07:22.60,Default,,0,0,0,,μ-мен күресудің қажеттілігі қайда?
Dialogue: 0,0:07:23.44,0:07:25.52,Default,,0,0,0,,Басқа қаскөйлер не ойлайды?
Dialogue: 0,0:07:25.65,0:07:28.86,Default,,0,0,0,,Әйтеуір, түсіну қиын емес.
Dialogue: 0,0:07:28.99,0:07:31.99,Default,,0,0,0,,Мен үшін бұлай айту біртүрлі, бірақ...
Dialogue: 0,0:07:32.11,0:07:34.82,Default,,0,0,0,,Бірақ Рицу-сенпай...
Dialogue: 0,0:07:35.16,0:07:39.04,Default,,0,0,0,,Мен кім екенімді есіме түсіре алмаймын.
Dialogue: 0,0:07:39.25,0:07:41.46,Default,,0,0,0,,Сіз білуіңіз керек.
Dialogue: 0,0:07:41.58,0:07:43.21,Default,,0,0,0,,Шындығында, біз
Dialogue: 0,0:07:43.33,0:07:47.21,Default,,0,0,0,,Мен өте жағымсыз өмір сүріп жатырмын.
Dialogue: 0,0:07:47.80,0:07:50.97,Default,,0,0,0,,Шындыққа оралу қиынға соғудың қажеті жоқ, солай ма?
Dialogue: 0,0:07:53.80,0:07:56.26,Default,,0,0,0,,Мен біраз уақыт бұрын уайымдадым.
Dialogue: 0,0:07:56.39,0:07:57.85,Default,,0,0,0,,Шынымды айтсам
Dialogue: 0,0:07:58.10,0:07:59.47,Default,,0,0,0,,Бірақ сол күні...
Dialogue: 0,0:07:59.68,0:08:01.85,Default,,0,0,0,,Мен мұны жақсы түсіндіре алмаймын, бірақ...
Dialogue: 0,0:08:01.98,0:08:03.44,Default,,0,0,0,,Мен сезіндім...
Dialogue: 0,0:08:04.31,0:08:06.61,Default,,0,0,0,,Өйткені, мұндай нәрсе басқа...
Dialogue: 0,0:08:07.82,0:08:11.53,Default,,0,0,0,,Сонымен қатар, үйге келу клубындағы барлығына қараңыз.
Dialogue: 0,0:08:11.65,0:08:14.66,Default,,0,0,0,,Мен бұл адамдар неге үйлеріне қайтқысы келді деп ойладым.
Dialogue: 0,0:08:15.24,0:08:16.95,Default,,0,0,0,,Сіз сияқты.
Dialogue: 0,0:08:17.91,0:08:19.37,Default,,0,0,0,,Мүмкін сондықтан болар
Dialogue: 0,0:08:21.25,0:08:22.08,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:08:22.50,0:08:26.00,Default,,0,0,0,,Менің ағам біртүрлі екен ғой.
Dialogue: 0,0:08:26.13,0:08:27.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:27.38,0:08:28.29,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:08:28.67,0:08:31.67,Default,,0,0,0,,Маған да үйге келу клубына қатысуға рұқсат етіңіз.
Dialogue: 0,0:08:31.80,0:08:33.26,Default,,0,0,0,,Менеджер
Dialogue: 0,0:08:33.55,0:08:37.43,Default,,0,0,0,,Иә? Минезава жақын арада екінші орында ма?
Dialogue: 0,0:08:38.01,0:08:41.64,Default,,0,0,0,,Журналдарды ретке келтірген μ-нің күші болды ма?
Dialogue: 0,0:08:41.77,0:08:43.39,Default,,0,0,0,,Уф... шіркін!
Dialogue: 0,0:08:43.52,0:08:45.35,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:08:46.10,0:08:47.31,Default,,0,0,0,,Маған барлық жаңа туындыларды беріңіз.
Dialogue: 0,0:08:47.48,0:08:49.52,Default,,0,0,0,,Иә, мен үйдемін.
Dialogue: 0,0:08:49.65,0:08:51.98,Default,,0,0,0,,Хмм, тағы біраз...
Dialogue: 0,0:08:53.95,0:08:54.99,Default,,0,0,0,,Күйіп (оқушы қыз) Ах!
Dialogue: 0,0:08:55.11,0:08:57.24,Default,,0,0,0,,Әй...
Dialogue: 0,0:08:58.16,0:09:01.79,Default,,0,0,0,,Күткендей, Гайя мені әлі тастаған жоқ.
Dialogue: 0,0:09:01.91,0:09:03.91,Default,,0,0,0,,Егер сіз осы дүкеннің қара халатын кисеңіз,
Dialogue: 0,0:09:04.04,0:09:05.96,Default,,0,0,0,,Тақты өлгенше қорғай алады
Dialogue: 0,0:09:06.08,0:09:07.58,Default,,0,0,0,,ИкеП мырза~
Dialogue: 0,0:09:07.71,0:09:08.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:08.00,0:09:08.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:08.00,0:09:08.71,Default,,0,0,0,,А? (IkeP) Ах...
Dialogue: 0,0:09:08.71,0:09:09.21,Default,,0,0,0,,А? (IkeP) Ах...
Dialogue: 0,0:09:10.21,0:09:12.13,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:09:12.26,0:09:13.80,Default,,0,0,0,,Уау, донкуса!
Dialogue: 0,0:09:13.92,0:09:16.84,Default,,0,0,0,,Хе, қызық~ Суретке түсейік
Dialogue: 0,0:09:16.97,0:09:19.47,Default,,0,0,0,,(оқушы қыздардың мектептегі дауыстары)
Dialogue: 0,0:09:19.93,0:09:20.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:21.01,0:09:24.77,Default,,0,0,0,,(мазақ еткен дауыс)
Dialogue: 0,0:09:31.40,0:09:32.94,Default,,0,0,0,,Хехе...
Dialogue: 0,0:09:33.07,0:09:34.53,Default,,0,0,0,,Тоқта! (Оқушылар қыздар) Ах!
Dialogue: 0,0:09:34.65,0:09:35.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:36.15,0:09:37.15,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:37.95,0:09:39.95,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:41.74,0:09:43.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:43.70,0:09:45.04,Default,,0,0,0,,Аххх (керемет P) Уау
Dialogue: 0,0:09:45.16,0:09:48.67,Default,,0,0,0,,Ерекше жабайы IkeP де тамаша.
Dialogue: 0,0:09:48.92,0:09:50.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:50.13,0:09:52.25,Default,,0,0,0,,Роза мен Лили бірдей емес пе?
Dialogue: 0,0:09:52.42,0:09:55.88,Default,,0,0,0,,Иә, қазір екеуміз де Изуру-самамен айналысамыз.
Dialogue: 0,0:09:56.01,0:09:57.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:57.38,0:10:01.22,Default,,0,0,0,,Изуру мырза, сіз соңғы кездері қыздар арасында танымал болдыңыз.
Dialogue: 0,0:10:01.35,0:10:03.47,Default,,0,0,0,,Бірақ Айрис...
Dialogue: 0,0:10:03.60,0:10:06.81,Default,,0,0,0,,Уайымдамаңыз, ИкеП мырза сізге берілген.
Dialogue: 0,0:10:08.85,0:10:10.77,Default,,0,0,0,,Эй, түсіндің бе?
Dialogue: 0,0:10:10.90,0:10:11.19,Default,,0,0,0,,Ең тітіркендіргіш адам...
Dialogue: 0,0:10:11.19,0:10:12.40,Default,,0,0,0,,Ең тітіркендіргіш адам...
Dialogue: 0,0:10:11.19,0:10:12.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:12.40,0:10:12.86,Default,,0,0,0,,Ең тітіркендіргіш адам...
Dialogue: 0,0:10:12.98,0:10:16.24,Default,,0,0,0,,Ең маңыздысы тапталса ше?
Dialogue: 0,0:10:16.36,0:10:20.74,Default,,0,0,0,,Ашу, жек көру... ондай деңгейде емес.
Dialogue: 0,0:10:20.87,0:10:22.95,Default,,0,0,0,,Изуру Минезава!
Dialogue: 0,0:10:26.58,0:10:29.00,Default,,0,0,0,,Содан бері бір апта өтті.
Dialogue: 0,0:10:29.12,0:10:30.83,Default,,0,0,0,,μ әлі оянған жоқ...
Dialogue: 0,0:10:30.96,0:10:32.08,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:10:30.96,0:10:32.08,Default,,0,0,0,,Жағдай барған сайын нашарлай берді.
Dialogue: 0,0:10:32.08,0:10:32.88,Default,,0,0,0,,Жағдай барған сайын нашарлай берді.
Dialogue: 0,0:10:33.00,0:10:34.88,Default,,0,0,0,,Ах~ Наруко-сенпайдан
Dialogue: 0,0:10:35.00,0:10:38.38,Default,,0,0,0,,«В тобын сатып алу, қазірден оралайық.»
Dialogue: 0,0:10:38.51,0:10:41.39,Default,,0,0,0,,Сұрағыңыз келетін тағы бір нәрсе бар ма?
Dialogue: 0,0:10:41.51,0:10:42.80,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:10:42.93,0:10:45.60,Default,,0,0,0,,Оған тезірек оралуын айт.
Dialogue: 0,0:10:49.06,0:10:51.60,Default,,0,0,0,,Тезірек оралыңыз.
Dialogue: 0,0:10:51.73,0:10:53.69,Default,,0,0,0,,Сіз тым көп сатып алдыңыз ба?
Dialogue: 0,0:10:54.19,0:10:56.94,Default,,0,0,0,,Бала бар екен, дұрыс емес пе?
Dialogue: 0,0:10:58.78,0:10:59.99,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:00.45,0:11:02.41,Default,,0,0,0,,Мен екінші орында болсам ше?
Dialogue: 0,0:11:02.57,0:11:03.99,Default,,0,0,0,,Бакуго-кунға қарсы қандай жоспары барын сұрамақ едім.
Dialogue: 0,0:11:04.62,0:11:06.66,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:11:06.79,0:11:10.00,Default,,0,0,0,,Ол Мобиустағы ең керемет жігіт...
Dialogue: 0,0:11:10.29,0:11:12.58,Default,,0,0,0,,(Тәтті Р ызылдаған)
Dialogue: 0,0:11:12.71,0:11:13.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:13.96,0:11:15.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:15.59,0:11:18.13,Default,,0,0,0,,Біртүрлі екен, қызық, не болып жатыр?
Dialogue: 0,0:11:18.26,0:11:19.59,Default,,0,0,0,,(сыдырманың сынған дыбысы)
Dialogue: 0,0:11:23.97,0:11:26.56,Default,,0,0,0,,Иә, ол ақаулы өнім болуы керек.
Dialogue: 0,0:11:27.01,0:11:29.52,Default,,0,0,0,,Хмм, осымен барайық.
Dialogue: 0,0:11:29.81,0:11:32.60,Default,,0,0,0,,Гуннунну...
Dialogue: 0,0:11:32.73,0:11:33.73,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:11:35.44,0:11:37.94,Default,,0,0,0,,Ай!
Dialogue: 0,0:11:38.07,0:11:41.53,Default,,0,0,0,,Өтірік? Бұл мүмкін емес!
Dialogue: 0,0:11:41.82,0:11:43.03,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:11:43.16,0:11:45.12,Default,,0,0,0,,Бұл картаны пайдалану мүмкін емес
Dialogue: 0,0:11:45.24,0:11:46.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:46.87,0:11:48.20,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:11:48.91,0:11:49.91,Default,,0,0,0,,(картаны оқу құрылғысының қате дыбысы)
Dialogue: 0,0:11:50.04,0:11:52.25,Default,,0,0,0,,Кешіріңіз, бірақ бұл да...
Dialogue: 0,0:11:52.37,0:11:53.46,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:11:54.21,0:11:56.29,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:11:59.34,0:12:00.42,Default,,0,0,0,,(картаны оқу құрылғысының қате дыбысы)
Dialogue: 0,0:12:00.55,0:12:03.72,Default,,0,0,0,,(Картаны оқу құрылғысының қате дыбысы)
Dialogue: 0,0:12:03.84,0:12:05.34,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:05.47,0:12:07.47,Default,,0,0,0,,Барлығын пайдалануға болмайды.
Dialogue: 0,0:12:07.60,0:12:09.64,Default,,0,0,0,,Не? Сіз оны пайдалана алмайсыз
Dialogue: 0,0:12:10.14,0:12:11.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:11.85,0:12:13.98,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:12:14.10,0:12:15.10,Default,,0,0,0,,​​О?
Dialogue: 0,0:12:15.23,0:12:17.52,Default,,0,0,0,,(Қонақтардың мазақ еткен дауыстары)
Dialogue: 0,0:12:17.69,0:12:18.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:19.86,0:12:21.28,Default,,0,0,0,,Тосизо!
Dialogue: 0,0:12:21.40,0:12:22.53,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:12:22.65,0:12:24.66,Default,,0,0,0,,Жас ханым, жер бетінде не болып жатыр...ха...
Dialogue: 0,0:12:24.78,0:12:25.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:26.16,0:12:28.03,Default,,0,0,0,,Мен не істеуім керек? Тосизо
Dialogue: 0,0:12:28.16,0:12:31.16,Default,,0,0,0,,Ақша... Менде ақша жоқ.
Dialogue: 0,0:12:31.29,0:12:33.96,Default,,0,0,0,,Ақшаң жоқ болса, сені қуып жібереді.
Dialogue: 0,0:12:34.08,0:12:34.71,Default,,0,0,0,,Ханым... сенімді болыңыз.
Dialogue: 0,0:12:34.71,0:12:36.71,Default,,0,0,0,,Ханым... сенімді болыңыз.
Dialogue: 0,0:12:34.71,0:12:36.71,Default,,0,0,0,,(Мирейдің айқайы)
Dialogue: 0,0:12:36.71,0:12:37.71,Default,,0,0,0,,Ханым... сенімді болыңыз.
Dialogue: 0,0:12:37.96,0:12:39.38,Default,,0,0,0,,Бұл әлемде-
Dialogue: 0,0:12:39.50,0:12:42.88,Default,,0,0,0,,Қандай жағдай болса да, мен сенің жаныңда боламын.
Dialogue: 0,0:12:43.01,0:12:45.68,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:12:45.80,0:12:49.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:50.76,0:12:53.18,Default,,0,0,0,,Құтқарушыға рахмет
Dialogue: 0,0:12:53.68,0:12:54.56,Default,,0,0,0,,Хехе...
Dialogue: 0,0:12:54.64,0:12:55.27,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:12:55.27,0:12:56.27,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:12:55.27,0:12:56.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:57.98,0:13:00.98,Default,,0,0,0,,Бір жерден құтқаруға шақырған дауыс естіледі...
Dialogue: 0,0:13:03.40,0:13:06.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:10.08,0:13:13.75,Default,,0,0,0,,Егер μ осылай оянбаса
Dialogue: 0,0:13:14.50,0:13:16.75,Default,,0,0,0,,Біз не боламыз?
Dialogue: 0,0:13:18.33,0:13:21.25,Default,,0,0,0,,Бір ай бойы ұйықтап қалды
Dialogue: 0,0:13:21.63,0:13:25.26,Default,,0,0,0,,Әзірге Мобиус әлі де сақталған.
Dialogue: 0,0:13:25.51,0:13:28.80,Default,,0,0,0,,Қазір μ туралы ештеңе істей алмаймыз.
Dialogue: 0,0:13:28.93,0:13:30.43,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:13:30.68,0:13:33.18,Default,,0,0,0,,Сіз жай ғана бірдеңені айттыңыз...
Dialogue: 0,0:13:33.31,0:13:36.31,Default,,0,0,0,,Сіз μ-ді монополиялауға тырыспайсыз, солай ма?
Dialogue: 0,0:13:36.52,0:13:37.60,Default,,0,0,0,,Жеңіл
Dialogue: 0,0:13:37.73,0:13:38.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:39.06,0:13:40.56,Default,,0,0,0,,Ұрысты тоқтатыңыз!
Dialogue: 0,0:13:40.94,0:13:44.19,Default,,0,0,0,,Бұлай жалғаса берсе, Мобиус жоғалып кетуі мүмкін!
Dialogue: 0,0:13:44.32,0:13:45.32,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:13:45.61,0:13:46.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:47.24,0:13:50.57,Default,,0,0,0,,Сіз шайтанның қараңғылығына қашан жұтылатынын білмейсіз.
Dialogue: 0,0:13:50.70,0:13:53.29,Default,,0,0,0,,Помпидің алаңдауы табиғи нәрсе.
Dialogue: 0,0:13:54.04,0:13:56.25,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:13:56.46,0:13:58.75,Default,,0,0,0,,Мен? Міне, мен
Dialogue: 0,0:13:58.87,0:14:00.21,Default,,0,0,0,,Өйткені бұл Гайя.
Dialogue: 0,0:14:00.58,0:14:03.42,Default,,0,0,0,,Мм... еркектер шынымен ақымақ.
Dialogue: 0,0:14:03.55,0:14:04.38,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:14:04.51,0:14:07.68,Default,,0,0,0,,Бұл жерде қалудың қажеті жоқ.
Dialogue: 0,0:14:08.26,0:14:09.34,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:14:09.34,0:14:09.76,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:14:09.34,0:14:09.76,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:09.76,0:14:09.89,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:09.89,0:14:10.76,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:09.89,0:14:10.76,Default,,0,0,0,,Мені күтіп тұрған котенкаға барыңыз
Dialogue: 0,0:14:10.76,0:14:12.89,Default,,0,0,0,,Мені күтіп тұрған котенкаға барыңыз
Dialogue: 0,0:14:13.89,0:14:15.31,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:14:18.77,0:14:22.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:22.61,0:14:25.90,Default,,0,0,0,,Чикусо Бұл жалғаса берсе...
Dialogue: 0,0:14:27.82,0:14:30.41,Default,,0,0,0,,Сонда да мен тоқтай алмаймын
Dialogue: 0,0:14:31.32,0:14:32.87,Default,,0,0,0,,Егер сіз мұнда жарқырай алмасаңыз, Мобиусқа келудің қажеті жоқ.
Dialogue: 0,0:14:32.87,0:14:34.74,Default,,0,0,0,,Бұл жерде жарқырай алмасаң, Мобиусқа келудің мәні жоқ.
Dialogue: 0,0:14:32.87,0:14:34.74,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:14:34.74,0:14:34.87,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:14:34.87,0:14:36.62,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:14:34.87,0:14:36.62,Default,,0,0,0,,Әй... Әй!
Dialogue: 0,0:14:36.75,0:14:39.33,Default,,0,0,0,,Қызық екен!
Dialogue: 0,0:14:39.67,0:14:41.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:41.58,0:14:42.54,Default,,0,0,0,,Эй, Изуру-сама~
Dialogue: 0,0:14:42.54,0:14:43.54,Default,,0,0,0,,Эй, Изуру-сама~
Dialogue: 0,0:14:42.54,0:14:43.54,Default,,0,0,0,,Не!
Dialogue: 0,0:14:43.67,0:14:44.88,Default,,0,0,0,,Изрун
Dialogue: 0,0:14:45.00,0:14:46.51,Default,,0,0,0,,Шынайы өтірік пе?
Dialogue: 0,0:14:46.84,0:14:49.47,Default,,0,0,0,,Ирис Изуру-самаға арналған~
Dialogue: 0,0:14:49.59,0:14:51.34,Default,,0,0,0,,Қандай асыл иіс~
Dialogue: 0,0:14:51.47,0:14:53.30,Default,,0,0,0,,Тұрмысқа шық~ (Роза) А!
Dialogue: 0,0:14:53.43,0:14:55.64,Default,,0,0,0,,Кет, менің маңызды бір ісім бар.
Dialogue: 0,0:14:55.76,0:14:57.81,Default,,0,0,0,,Күтіңіз~
Dialogue: 0,0:14:57.93,0:14:59.64,Default,,0,0,0,,Мынау әдемі!
Dialogue: 0,0:14:59.77,0:15:00.77,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:15:01.85,0:15:03.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:08.99,0:15:12.53,Default,,0,0,0,,Иә? Мен Изуру мырзаны таба алмай жатырмын.
Dialogue: 0,0:15:12.66,0:15:15.91,Default,,0,0,0,,Кункун... Ол жақын жерде болуы керек.
Dialogue: 0,0:15:16.04,0:15:19.12,Default,,0,0,0,,Мен бүгін сол теріні сипағым келеді.
Dialogue: 0,0:15:19.25,0:15:20.92,Default,,0,0,0,,Хехе…
Dialogue: 0,0:15:25.34,0:15:26.09,Default,,0,0,0,,Минезава!
Dialogue: 0,0:15:26.09,0:15:27.09,Default,,0,0,0,,Минезава!
Dialogue: 0,0:15:26.09,0:15:27.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:31.88,0:15:34.47,Default,,0,0,0,,Менің сүйікті дүкеніме қош келдіңіз!
Dialogue: 0,0:15:34.60,0:15:36.81,Default,,0,0,0,,Әдемі киімдеріңді жөндегенімді қалайсың ба?
Dialogue: 0,0:15:36.93,0:15:40.39,Default,,0,0,0,,Жоқ... менің іздегенім бұл жерде жоқ.
Dialogue: 0,0:15:40.52,0:15:44.06,Default,,0,0,0,,Солай ма? Мияби қаласындағы ең әдемі адам
Dialogue: 0,0:15:44.44,0:15:48.03,Default,,0,0,0,,Өзіңізді қалай сезінесіз? Ештеңе жасамай-ақ әйелдер арасында танымал болу!
Dialogue: 0,0:15:49.99,0:15:50.99,Default,,0,0,0,,Кешіріңіз, бірақ асығыңыз.
Dialogue: 0,0:15:51.28,0:15:53.07,Default,,0,0,0,,Маған қара!
Dialogue: 0,0:15:53.53,0:15:54.99,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:56.49,0:15:57.70,Default,,0,0,0,,Мен сен оны жеңдің бе деп сұрап тұрмын!
Dialogue: 0,0:15:57.91,0:16:00.37,Default,,0,0,0,,Қатты! Изуру-сама және ИкеП-сама
Dialogue: 0,0:16:00.50,0:16:02.96,Default,,0,0,0,,Олар біз үшін төбелесіп жатыр!
Dialogue: 0,0:16:03.08,0:16:05.50,Default,,0,0,0,,Жүзің – асыл қазына
Dialogue: 0,0:16:05.63,0:16:08.34,Default,,0,0,0,,Жылтыратпаған әшекей тек тас екенін түсінгенде
Dialogue: 0,0:16:08.46,0:16:11.01,Default,,0,0,0,,Әйелдер де оянады
Dialogue: 0,0:16:12.34,0:16:15.43,Default,,0,0,0,,Ugggggggg...
Dialogue: 0,0:16:22.43,0:16:23.27,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:16:23.52,0:16:26.36,Default,,0,0,0,,Біз күнәкармыз...
Dialogue: 0,0:16:26.48,0:16:27.48,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:30.03,0:16:31.03,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:16:31.65,0:16:33.45,Default,,0,0,0,,Сен үшін уайымдайтын уақытым жоқ.
Dialogue: 0,0:16:33.57,0:16:35.45,Default,,0,0,0,,Не!
Dialogue: 0,0:16:41.12,0:16:42.33,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:46.38,0:16:47.71,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:16:47.84,0:16:50.92,Default,,0,0,0,,Эй, сен неге үйге барғың келеді?
Dialogue: 0,0:16:51.34,0:16:53.38,Default,,0,0,0,,Сол бетті μ-нің күшімен алыңыз.
Dialogue: 0,0:16:53.63,0:16:55.26,Default,,0,0,0,,Оны барынша пайдаланыңыз -
Dialogue: 0,0:16:55.38,0:16:58.22,Default,,0,0,0,,Көңілді де қызық өмір сүрсе жақсы болар еді.
Dialogue: 0,0:16:58.85,0:17:01.06,Default,,0,0,0,,Бұл бет табиғи
Dialogue: 0,0:17:01.18,0:17:03.31,Default,,0,0,0,,Иә? Өтірікші!
Dialogue: 0,0:17:03.43,0:17:07.23,Default,,0,0,0,,Біздің Мебиусқа ондай біреудің келуі мүмкін емес!
Dialogue: 0,0:17:08.02,0:17:10.73,Default,,0,0,0,,Сіз бұл бетті қалайсыз ба?
Dialogue: 0,0:17:10.86,0:17:13.40,Default,,0,0,0,,Мен сізге кез келген уақытта осындай нәрсені беремін.
Dialogue: 0,0:17:13.65,0:17:17.16,Default,,0,0,0,,Қарғыс атқыр, өзіңді ақымақ қылдың!
Dialogue: 0,0:17:23.16,0:17:24.00,Default,,0,0,0,,Ал Спидвагон мен басқалар
Dialogue: 0,0:17:29.71,0:17:31.17,Default,,0,0,0,,Ох… ол маған ашулы қарап тұр
Dialogue: 0,0:17:31.67,0:17:34.67,Default,,0,0,0,,(μ ұйқысы)
Dialogue: 0,0:17:38.09,0:17:39.30,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:17:42.31,0:17:43.52,Default,,0,0,0,,Зұлым…
Dialogue: 0,0:17:48.69,0:17:49.94,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:17:50.73,0:17:53.44,Default,,0,0,0,,Ерте тұру μ
Dialogue: 0,0:17:53.94,0:17:58.11,Default,,0,0,0,,Мен оған көбірек тозақ көрсетуім керек...
Dialogue: 0,0:17:58.24,0:18:01.62,Default,,0,0,0,,Хаха...
Dialogue: 0,0:18:01.74,0:18:05.41,Default,,0,0,0,,Хахаха! Зама Миягаре Изуру Минезава!
Dialogue: 0,0:18:05.54,0:18:07.29,Default,,0,0,0,,А... А-а!
Dialogue: 0,0:18:09.96,0:18:13.50,Default,,0,0,0,,Мм... әдемі жүзің бұзылып қалды.
Dialogue: 0,0:18:13.63,0:18:15.67,Default,,0,0,0,,Шок? Кола!
Dialogue: 0,0:18:16.63,0:18:17.88,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:22.89,0:18:24.10,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:18:24.68,0:18:27.14,Default,,0,0,0,,Фуфуфуфу… (IkeP) Бұл не?
Dialogue: 0,0:18:27.27,0:18:28.73,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:28.85,0:18:32.65,Default,,0,0,0,,Маңыздысы – қазіргі сәт.
Dialogue: 0,0:18:32.90,0:18:34.57,Default,,0,0,0,,Хаха...
Dialogue: 0,0:18:34.69,0:18:35.53,Default,,0,0,0,,Фуфуфу... (IkeP) Қазір!
Dialogue: 0,0:18:35.65,0:18:37.53,Default,,0,0,0,,Хехе...
Dialogue: 0,0:18:38.90,0:18:41.78,Default,,0,0,0,,Тоқта... Тоқта! Эй!
Dialogue: 0,0:18:41.91,0:18:43.66,Default,,0,0,0,,Ох… ол маған ашулы қарап тұр
Dialogue: 0,0:18:43.78,0:18:45.70,Default,,0,0,0,,Хехе...
Dialogue: 0,0:18:45.99,0:18:49.16,Default,,0,0,0,,Бұл менің шын жүзім
Dialogue: 0,0:18:49.75,0:18:53.21,Default,,0,0,0,,Бұл тыртық маған бірінші түскен.
Dialogue: 0,0:18:53.34,0:18:55.59,Default,,0,0,0,,Мен өзім болуым үшін...
Dialogue: 0,0:18:55.71,0:18:57.42,Default,,0,0,0,,Айғақ!
Dialogue: 0,0:18:57.55,0:18:58.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:01.68,0:19:04.93,Default,,0,0,0,,Мен бұл жараны μ аяғанына сенімдімін.
Dialogue: 0,0:19:05.68,0:19:07.31,Default,,0,0,0,,Менің бетім де солай
Dialogue: 0,0:19:07.43,0:19:10.77,Default,,0,0,0,,Қанша зиян келтірсеңіз де, ол тез қалпына келеді.
Dialogue: 0,0:19:11.44,0:19:15.40,Default,,0,0,0,,Тілегім осы тыртықтың өзі болса да
Dialogue: 0,0:19:16.65,0:19:18.90,Default,,0,0,0,,Бұл қалыпты емес...
Dialogue: 0,0:19:19.82,0:19:22.41,Default,,0,0,0,,Осындай бетпен шындыққа қайта оралғыңыз келе ме?
Dialogue: 0,0:19:22.53,0:19:24.12,Default,,0,0,0,,Не болды...
Dialogue: 0,0:19:24.91,0:19:27.45,Default,,0,0,0,,Сондықтан мен үйге бара жатырмын
Dialogue: 0,0:19:27.79,0:19:30.62,Default,,0,0,0,,Мен ешкім емес екенімді ойып алдым.
Dialogue: 0,0:19:30.75,0:19:33.63,Default,,0,0,0,,Өзіңнің шынайы болмысыңды қайтару
Dialogue: 0,0:19:33.88,0:19:36.17,Default,,0,0,0,,Менің шынайы тұлғам...
Dialogue: 0,0:19:36.30,0:19:37.59,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:19:37.71,0:19:39.34,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:19:41.43,0:19:45.39,Default,,0,0,0,,Мен мұның шындық емес екенін білемін!
Dialogue: 0,0:19:45.51,0:19:48.47,Default,,0,0,0,,Несі дұрыс, несі жалған
Dialogue: 0,0:19:48.81,0:19:52.44,Default,,0,0,0,,Бірақ бұл жерде болмаса, мен...
Dialogue: 0,0:19:52.98,0:19:54.86,Default,,0,0,0,,Біз...
Dialogue: 0,0:19:54.98,0:19:55.98,Default,,0,0,0,,Сондықтан!
Dialogue: 0,0:19:56.44,0:19:59.44,Default,,0,0,0,,Мебиус – менің әділдігім!
Dialogue: 0,0:20:03.82,0:20:05.32,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:20:08.41,0:20:09.79,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:10.00,0:20:11.75,Default,,0,0,0,,Сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:20:13.25,0:20:14.25,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:20:15.17,0:20:17.29,Default,,0,0,0,,Сіз оны қайдан сатып алатынымды білесіз бе?
Dialogue: 0,0:20:20.67,0:20:22.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:27.26,0:20:28.47,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:28.60,0:20:30.72,Default,,0,0,0,,Ах, хехе! Хехе...
Dialogue: 0,0:20:32.06,0:20:34.65,Default,,0,0,0,,Бізде әділдік бар
Dialogue: 0,0:20:35.98,0:20:39.65,Default,,0,0,0,,Олардың да бас тарта алмайтын нәрсе бар екеніне сенімдімін.
Dialogue: 0,0:20:41.57,0:20:43.61,Default,,0,0,0,,Мүмкін сіз айтқандай шығар.
Dialogue: 0,0:20:43.74,0:20:44.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:45.16,0:20:46.49,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:20:46.62,0:20:48.83,Default,,0,0,0,,Эй, өтінемін, маған сеніңіз.
Dialogue: 0,0:20:49.62,0:20:51.91,Default,,0,0,0,,Бұған күмән жоқ па...
Dialogue: 0,0:20:52.45,0:20:53.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:55.42,0:20:58.25,Default,,0,0,0,,Үйге қайту клубының іс-шаралары басталды.
Dialogue: 0,0:20:59.59,0:21:02.71,Default,,0,0,0,,Барлығын күткенім үшін кешіріңіз.
Dialogue: 0,0:21:02.84,0:21:04.93,Default,,0,0,0,,Мен сені бірден жолға саламын.
Dialogue: 0,0:21:16.44,0:21:20.32,Default,,0,0,0,,Жақсы μ Шынымен...
Dialogue: 0,0:21:20.44,0:21:22.65,Default,,0,0,0,,Мен күтуден қатты шаршадым.
Dialogue: 0,0:21:23.94,0:21:25.45,Default,,0,0,0,,Біз қазірдің өзінде-
Dialogue: 0,0:21:25.57,0:21:28.91,Default,,0,0,0,,Біз μ күшінсіз өмір сүре алмаймыз.
Dialogue: 0,0:21:29.62,0:21:32.74,Default,,0,0,0,,Түпнұсқа дүниеге оралу өлумен бірдей...
Dialogue: 0,0:21:32.87,0:21:33.87,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:21:34.00,0:21:35.71,Default,,0,0,0,,Артқа жол жоқ...
Dialogue: 0,0:21:35.83,0:21:38.29,Default,,0,0,0,,Менің олай істеуге ниетім жоқ.
Dialogue: 0,0:21:39.21,0:21:43.01,Default,,0,0,0,,Барлық музыканттар бүгін кешке шақырылды.
Dialogue: 0,0:21:43.13,0:21:45.42,Default,,0,0,0,,Мүмкін μ де бар шығар...
Dialogue: 0,0:21:46.05,0:21:47.84,Default,,0,0,0,,Көрнекті мұнара...
Dialogue: 0,0:21:49.59,0:21:51.14,Default,,0,0,0,,Алаяқтар...
Dialogue: 0,0:21:51.35,0:21:55.93,Default,,0,0,0,,Мен міндетті түрде әділеттілігімді еске саламын.
Dialogue: 0,0:21:56.52,0:22:01.52,Default,,0,0,0,,♪～
Dialogue: 0,0:23:21.90,0:23:26.90,Default,,0,0,0,,～♪
Dialogue: 0,0:23:28.40,0:23:34.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory