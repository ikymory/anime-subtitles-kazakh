Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.25,0:00:02.92,Default,,0,0,0,,Бұл қиын болды, солай емес пе?
Dialogue: 0,0:00:03.46,0:00:05.29,Default,,0,0,0,,Жоқ, мәртебелі Дзен...
Dialogue: 0,0:00:05.42,0:00:07.96,Default,,0,0,0,,Өйткені Ракусуд бекінісіндегілердің бәрі мен үшін болды.
Dialogue: 0,0:00:08.09,0:00:11.38,Default,,0,0,0,,Бірақ сіз жақсы жұмыс жасадыңыз. Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:00:12.22,0:00:14.18,Default,,0,0,0,,Бүгін демалуға болады.
Dialogue: 0,0:00:14.97,0:00:16.93,Default,,0,0,0,,Дегенмен, бәрінің әлі де жұмысы бар...
Dialogue: 0,0:00:17.06,0:00:18.72,Default,,0,0,0,,Демалу да маңызды
Dialogue: 0,0:00:18.81,0:00:21.14,Default,,0,0,0,,А... солай ма?
Dialogue: 0,0:00:21.68,0:00:23.44,Default,,0,0,0,,Алдымен кешіріңіз.
Dialogue: 0,0:00:23.85,0:00:24.94,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:00:25.06,0:00:26.31,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:00:27.02,0:00:29.32,Default,,0,0,0,,Сен қолыңнан келгеннің бәрін істеп жатырсың, Шираюки-кун.
Dialogue: 0,0:00:29.44,0:00:30.11,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:30.74,0:00:33.45,Default,,0,0,0,,Айтпақшы, сен білесің бе, Шираюки-кун?
Dialogue: 0,0:00:34.11,0:00:34.82,Default,,0,0,0,,Не
Dialogue: 0,0:00:35.45,0:00:36.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:37.03,0:00:39.08,Default,,0,0,0,,Бұл Мәртебелі Изана туралы.
Dialogue: 0,0:00:45.50,0:00:49.92,Default,,0,0,0,,Жалғыз кездесудің жетегінде, Жеткен жолым
Dialogue: 0,0:00:51.84,0:00:53.72,Default,,0,0,0,,Бұл мен таңдаған жер
Dialogue: 0,0:00:55.05,0:00:57.01,Default,,0,0,0,,Менің тілегім орындалады...
Dialogue: 0,0:00:59.35,0:01:04.35,Default,,0,0,0,,♪~
Dialogue: 0,0:02:23.68,0:02:28.69,Default,,0,0,0,,~♪
Dialogue: 0,0:02:33.78,0:02:38.15,Default,,0,0,0,,Бүгін мен Рюмен бірге емдік шөп бақшасына бардым, содан кейін емдік күнтізбені ұйымдастырдым...
Dialogue: 0,0:02:39.49,0:02:40.32,Default,,0,0,0,,Иә? Зен
Dialogue: 0,0:02:41.07,0:02:43.28,Default,,0,0,0,,Қайырлы таң Шираюки...
Dialogue: 0,0:02:43.99,0:02:45.37,Default,,0,0,0,,Сен
Dialogue: 0,0:02:47.50,0:02:52.42,Default,,0,0,0,,«Кларин патшалығы, Вистал сарайы, сот дәріханасының шәкірті»
Dialogue: 0,0:02:54.13,0:02:55.88,Default,,0,0,0,,Бұл сіздің жеке куәлігіңіз бе?
Dialogue: 0,0:02:56.05,0:02:58.17,Default,,0,0,0,,Ол мен Люкседте болған кезде аяқталды.
Dialogue: 0,0:02:58.72,0:02:59.97,Default,,0,0,0,,Бұл форма да
Dialogue: 0,0:03:00.34,0:03:03.05,Default,,0,0,0,,Ойлап қарасам, олар да қамалға көшіп кеткен шығар.
Dialogue: 0,0:03:03.43,0:03:06.47,Default,,0,0,0,,Иә, мен қазірден бастап көбірек тырысуым керек.
Dialogue: 0,0:03:06.85,0:03:09.02,Default,,0,0,0,,Менің оқуым да, жұмысым да көп.
Dialogue: 0,0:03:09.14,0:03:10.14,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:10.35,0:03:13.48,Default,,0,0,0,,Мен де біраз уақыт Раксед қарақшыларымен айналысамын.
Dialogue: 0,0:03:14.36,0:03:17.44,Default,,0,0,0,,Келесі кездескенше біраз уақыт керек сияқты.
Dialogue: 0,0:03:17.57,0:03:20.24,Default,,0,0,0,,Иә? Мен түсінемін.
Dialogue: 0,0:03:22.07,0:03:23.32,Default,,0,0,0,,Шираюки
Dialogue: 0,0:03:24.08,0:03:25.12,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:03:25.24,0:03:26.45,Default,,0,0,0,,Эй... эй! (Шираюки) Иә?
Dialogue: 0,0:03:26.58,0:03:28.29,Default,,0,0,0,,Жомарт бола алмайсың ба?
Dialogue: 0,0:03:28.66,0:03:31.87,Default,,0,0,0,,Не? Қалай өкінесің?
Dialogue: 0,0:03:32.00,0:03:34.59,Default,,0,0,0,,Қалай… қалай?
Dialogue: 0,0:03:37.01,0:03:38.05,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:03:39.05,0:03:40.34,Default,,0,0,0,,Көріскенше, Шираюки
Dialogue: 0,0:03:41.55,0:03:42.26,Default,,0,0,0,,Иә
Dialogue: 0,0:03:48.06,0:03:51.31,Default,,0,0,0,,Бұл топтың тергеу есебін күтуде.
Dialogue: 0,0:03:51.64,0:03:53.77,Default,,0,0,0,,Фортпен байланыс жүйесі қалай қайта жазылады?
Dialogue: 0,0:03:53.90,0:03:54.81,Default,,0,0,0,,Мен оны айналдырдым.
Dialogue: 0,0:03:54.94,0:03:57.98,Default,,0,0,0,,Олай болса, мұрағатқа көшейік.
Dialogue: 0,0:03:58.82,0:04:01.78,Default,,0,0,0,,Енді бекіністегі сарбаздар үшін қиын болады.
Dialogue: 0,0:04:01.90,0:04:03.36,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:04:04.20,0:04:05.91,Default,,0,0,0,,Мен сені бос ұстаймын
Dialogue: 0,0:04:06.74,0:04:09.16,Default,,0,0,0,,Ол үшін алдымен жүйені дайындау керек...
Dialogue: 0,0:04:10.54,0:04:11.54,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:04:11.66,0:04:13.25,Default,,0,0,0,,Күзетшілердің орналасуы өзгерді.
Dialogue: 0,0:04:14.46,0:04:16.59,Default,,0,0,0,,Ойланып қарасақ, олар өте көп.
Dialogue: 0,0:04:16.71,0:04:18.67,Default,,0,0,0,,Мен мұндай хабарлама алған жоқпын.
Dialogue: 0,0:04:20.72,0:04:22.93,Default,,0,0,0,,Эй Зен, қайда бара жатырсың?
Dialogue: 0,0:04:23.76,0:04:26.80,Default,,0,0,0,,
Dialogue: 0,0:04:27.06,0:04:29.93,Default,,0,0,0,,Шеберлердің қолы бос емес, менің бос уақытым жоқ.
Dialogue: 0,0:04:30.60,0:04:34.81,Default,,0,0,0,,Әрекет ету ауқымы анықталды, және ұстауға қару жоқ.
Dialogue: 0,0:04:43.28,0:04:43.95,Default,,0,0,0,,Жоғары мәртебелі Дзен
Dialogue: 0,0:04:44.70,0:04:46.74,Default,,0,0,0,,Осы тармақтан тыс жеткізу мүмкін емес.
Dialogue: 0,0:04:47.12,0:04:47.78,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:04:49.24,0:04:50.29,Default,,0,0,0,,Мен жауап бере алмаймын.
Dialogue: 0,0:04:52.54,0:04:53.54,Default,,0,0,0,,Не болды, қарт әже?
Dialogue: 0,0:04:55.71,0:04:57.09,Default,,0,0,0,,Түсіндім, қолайсыздықтар үшін кешірім сұраймын.
Dialogue: 0,0:04:57.21,0:05:00.17,Default,,0,0,0,,Ағаштар Мицухиде Дайын бол.
Dialogue: 0,0:05:01.71,0:05:03.72,Default,,0,0,0,,Бұл қоңырау шалғанша күтуім керек дегенді білдіре ме?
Dialogue: 0,0:05:07.51,0:05:09.60,Default,,0,0,0,,Оби, шық, сенде 10 секунд бар.
Dialogue: 0,0:05:13.85,0:05:16.06,Default,,0,0,0,,Бұл мүлдем өрескел.
Dialogue: 0,0:05:16.44,0:05:18.90,Default,,0,0,0,,Тыңдашы, біраз уақытқа, сен... Иә?
Dialogue: 0,0:05:19.61,0:05:20.90,Default,,0,0,0,,Жара
Dialogue: 0,0:05:21.03,0:05:23.36,Default,,0,0,0,,О, бұл ма? Бұрынғыдай болған...
Dialogue: 0,0:05:23.57,0:05:25.49,Default,,0,0,0,,Кешіріңіз, мәртебелі Дзен.
Dialogue: 0,0:05:26.82,0:05:27.78,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:05:28.45,0:05:30.91,Default,,0,0,0,,Маған мүмкіндігінше тезірек беріңізші.
Dialogue: 0,0:05:38.84,0:05:41.46,Default,,0,0,0,,Кешіріңіз, Оби, тыртық туралы кейінірек айтамыз.
Dialogue: 0,0:05:42.55,0:05:44.51,Default,,0,0,0,,Әзірше бетіңізді көрсетіңіз.
Dialogue: 0,0:05:44.63,0:05:46.51,Default,,0,0,0,,Не? Содан кейін бөлмеңізде күтіңіз
Dialogue: 0,0:05:46.63,0:05:47.47,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:05:48.30,0:05:48.97,Default,,0,0,0,,Иә
Dialogue: 0,0:05:54.89,0:05:55.94,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:05:56.06,0:05:57.65,Default,,0,0,0,,Кешіріңіз (Шираюки) Иә?
Dialogue: 0,0:05:58.44,0:06:00.65,Default,,0,0,0,,Жоғары мәртебелі Шираюки-доно қоңырау шалып жатыр.
Dialogue: 0,0:06:00.86,0:06:02.86,Default,,0,0,0,,Иә, қазір
Dialogue: 0,0:06:03.11,0:06:04.99,Default,,0,0,0,,Кайой бөлмесіне келіңіз.
Dialogue: 0,0:06:05.11,0:06:08.70,Default,,0,0,0,,Не? Гүл әні кезінде
Dialogue: 0,0:06:16.16,0:06:17.54,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:17.71,0:06:19.17,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:22.34,0:06:23.30,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:06:27.68,0:06:29.34,Default,,0,0,0,,Сәлем аға
Dialogue: 0,0:06:30.55,0:06:33.35,Default,,0,0,0,,Біраз болды, ағайын.
Dialogue: 0,0:06:37.77,0:06:41.94,Default,,0,0,0,,Мицухиде мен ағаштар да жақсы қарым-қатынаста, солай емес пе?
Dialogue: 0,0:06:42.57,0:06:43.77,Default,,0,0,0,,«Алдау?» Оны алдау үшін не істемексің?
Dialogue: 0,0:06:44.44,0:06:46.49,Default,,0,0,0,,Менен қайтып келгеніңді неге жасырасың?
Dialogue: 0,0:06:46.94,0:06:50.32,Default,,0,0,0,,Хаха Қашан байқайсыз деп едім.
Dialogue: 0,0:06:50.99,0:06:54.91,Default,,0,0,0,,Мен сарайға қаншалықты көңіл бөлетініңді білгім келеді.
Dialogue: 0,0:06:55.54,0:06:57.04,Default,,0,0,0,,Осы жерде күтіңіз
Dialogue: 0,0:06:57.25,0:06:59.12,Default,,0,0,0,,Сіз шу шығармайсыз деп үміттенемін.
Dialogue: 0,0:06:59.37,0:07:00.67,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:03.75,0:07:06.13,Default,,0,0,0,,Не... не? Не болып жатыр?
Dialogue: 0,0:07:07.47,0:07:09.97,Default,,0,0,0,,Сіз Люкске дейін бардыңыз ба? Зен
Dialogue: 0,0:07:10.09,0:07:10.76,Default,,0,0,0,,Иә
Dialogue: 0,0:07:10.89,0:07:11.55,Default,,0,0,0,,Зен?
Dialogue: 0,0:07:12.01,0:07:13.89,Default,,0,0,0,,Есепті де көрдім.
Dialogue: 0,0:07:14.14,0:07:17.06,Default,,0,0,0,,Қамалдағы сарбаздар қарақшылардың кесірінен құлады.
Dialogue: 0,0:07:17.73,0:07:20.81,Default,,0,0,0,,Қозғала алмау қиын болса керек.
Dialogue: 0,0:07:21.40,0:07:23.15,Default,,0,0,0,,Дзенмен қалай сөйлесуге болады...
Dialogue: 0,0:07:23.61,0:07:26.90,Default,,0,0,0,,Екінші ханзададан жоғары мәртебеге ие біреуді айтсақ...
Dialogue: 0,0:07:29.32,0:07:31.53,Default,,0,0,0,,Клариннің бірінші князі
Dialogue: 0,0:07:31.91,0:07:34.16,Default,,0,0,0,,Сіз және сарай фармацевт...
Dialogue: 0,0:07:34.28,0:07:38.62,Default,,0,0,0,,Тағы бір қызметші бар деді, бірақ оны өзіңізбен бірге алып келмеген шығарсыз.
Dialogue: 0,0:07:38.91,0:07:41.87,Default,,0,0,0,,Ал, ол кісі жаңа, солай
Dialogue: 0,0:07:43.13,0:07:44.79,Default,,0,0,0,,Бетінде тыртық бар адам?
Dialogue: 0,0:07:46.13,0:07:49.42,Default,,0,0,0,,Мен оны Футейноядан деп ойладым, бірақ сенікі.
Dialogue: 0,0:07:51.09,0:07:55.55,Default,,0,0,0,,-де... бекіністегілерді жазалау туралы хабарланбаған сияқты.
Dialogue: 0,0:07:56.51,0:07:58.18,Default,,0,0,0,,Жоюға болмайды
Dialogue: 0,0:07:58.52,0:07:59.18,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:07:59.89,0:08:03.60,Default,,0,0,0,,Оларға айналаны патрульдеу және қорғау міндеті қойылады.
Dialogue: 0,0:08:04.11,0:08:07.82,Default,,0,0,0,,Осы оқиғаға байланысты мен біраз уақыт қызметімді орындай алмадым.
Dialogue: 0,0:08:08.19,0:08:10.65,Default,,0,0,0,,Біз оралуымызды бұдан былай кейінге қалдыра алмаймыз.
Dialogue: 0,0:08:11.78,0:08:12.86,Default,,0,0,0,,Зен
Dialogue: 0,0:08:13.36,0:08:17.45,Default,,0,0,0,,Лаксды келесі алты айға сіздің юрисдикцияңыздан алып тастаймыз ба?
Dialogue: 0,0:08:17.74,0:08:18.62,Default,,0,0,0,,Ах...!
Dialogue: 0,0:08:20.00,0:08:24.46,Default,,0,0,0,,Бұл қарақшылардың ісі болса да, қамал жүйесі кінәлі.
Dialogue: 0,0:08:24.71,0:08:27.13,Default,,0,0,0,,Егер сарбаздар кінәсіз болса...
Dialogue: 0,0:08:27.84,0:08:29.67,Default,,0,0,0,,Сіз жазаға тартыласыз.
Dialogue: 0,0:08:32.76,0:08:35.64,Default,,0,0,0,,Бұл солдаттар жауапкершілікті сезінетін жаза ма?
Dialogue: 0,0:08:36.14,0:08:38.22,Default,,0,0,0,,Маған Дзенге жауап беру қиынға соғады.
Dialogue: 0,0:08:38.89,0:08:41.02,Default,,0,0,0,,Өйткені сен тым өзімшілсің...
Dialogue: 0,0:08:41.14,0:08:44.81,Default,,0,0,0,,Сіз оларды мұндай нәрсе үшін кінәлағыңыз келмейді, солай ма?
Dialogue: 0,0:08:47.02,0:08:48.27,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:48.48,0:08:49.23,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:49.86,0:08:51.32,Default,,0,0,0,,Енді келесі.
Dialogue: 0,0:08:54.24,0:08:56.24,Default,,0,0,0,,Не? Мен сені күтуге мәжбүр еттім.
Dialogue: 0,0:08:56.37,0:08:57.12,Default,,0,0,0,,Шираюки
Dialogue: 0,0:08:57.95,0:09:00.08,Default,,0,0,0,,Дзен, сендер орныңнан тұра аласыңдар.
Dialogue: 0,0:09:01.00,0:09:02.75,Default,,0,0,0,,Бос емессіз бе?
Dialogue: 0,0:09:03.58,0:09:04.96,Default,,0,0,0,,Аға
Dialogue: 0,0:09:05.67,0:09:06.54,Default,,0,0,0,,Зен
Dialogue: 0,0:09:07.59,0:09:09.09,Default,,0,0,0,,Сонымен, біз мұны істейміз.
Dialogue: 0,0:09:09.96,0:09:11.17,Default,,0,0,0,,Шираюки Матана
Dialogue: 0,0:09:25.69,0:09:28.02,Default,,0,0,0,,Мен сені көруге барамын.
Dialogue: 0,0:09:30.11,0:09:31.03,Default,,0,0,0,,Зен?
Dialogue: 0,0:09:37.32,0:09:39.20,Default,,0,0,0,,Кешіріңіз, аға.
Dialogue: 0,0:09:39.66,0:09:42.16,Default,,0,0,0,,Мицухиде Кеттік, ағаштар!
Dialogue: 0,0:09:47.58,0:09:52.38,Default,,0,0,0,,А... бұл Лорд Зеннің ағасы, солай ма?
Dialogue: 0,0:09:52.51,0:09:54.55,Default,,0,0,0,,Оны қалай атасаң, сергітеді.
Dialogue: 0,0:09:55.05,0:09:59.05,Default,,0,0,0,,Маған жоғарыда айтылған Luxd туралы қоңырау шалудың себебі осы ма?
Dialogue: 0,0:09:59.18,0:10:00.30,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:10:02.93,0:10:05.56,Default,,0,0,0,,Олай болса, бөтен адам неге мені ұнатады...
Dialogue: 0,0:10:06.39,0:10:09.65,Default,,0,0,0,,Сіз Дзеннің досы және сүйіктісі сияқтысыз.
Dialogue: 0,0:10:10.56,0:10:14.03,Default,,0,0,0,,Корольдік отбасының мүшесі Зеннің досы бар және оны сарайына орналастырады.
Dialogue: 0,0:10:15.07,0:10:18.28,Default,,0,0,0,,Мұны естігендердің бәрі қызық болады.
Dialogue: 0,0:10:19.07,0:10:20.99,Default,,0,0,0,,Мен де оны асыға күтемін.
Dialogue: 0,0:10:22.45,0:10:26.54,Default,,0,0,0,,Сізде Зенге қажет нәрсе бар шығар.
Dialogue: 0,0:10:31.63,0:10:34.67,Default,,0,0,0,,Адамның көзіне көрінетін нәрсе бар ма?
Dialogue: 0,0:10:35.01,0:10:36.84,Default,,0,0,0,,Мен бұған жауап бере алмаймын.
Dialogue: 0,0:10:39.47,0:10:40.64,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:41.68,0:10:44.85,Default,,0,0,0,,Сізді тежеу ​​қателік болды. Артқа тұруға болады.
Dialogue: 0,0:10:45.77,0:10:46.43,Default,,0,0,0,,Иә
Dialogue: 0,0:10:49.15,0:10:51.73,Default,,0,0,0,,Егер сіздің айтқаныңыз кішіпейілділік болмаса...
Dialogue: 0,0:10:52.23,0:10:57.53,Default,,0,0,0,,Өз сарайына жат елден ерекше қызыл шашты қызды шақырғанына қуанады.
Dialogue: 0,0:10:58.32,0:11:00.57,Default,,0,0,0,,Құнсыз ханзада дайын.
Dialogue: 0,0:11:11.29,0:11:12.04,Default,,0,0,0,,Не?
Dialogue: 0,0:11:12.50,0:11:13.71,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:11:14.67,0:11:18.84,Default,,0,0,0,,Изана-сама, Шираюкиге қоңырау шалыңыз, не болып жатыр деп ойлаймын.
Dialogue: 0,0:11:22.68,0:11:26.43,Default,,0,0,0,,Сіз мұны естідіңіз бе? Ол мен Дзеннің ағасымын дейді.
Dialogue: 0,0:11:27.10,0:11:30.02,Default,,0,0,0,,Бұл аздап қызықты болды.
Dialogue: 0,0:11:32.81,0:11:36.53,Default,,0,0,0,,Енді барлығын бірден аяқтайық.
Dialogue: 0,0:11:49.38,0:11:53.34,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:11:53.47,0:11:56.51,Default,,0,0,0,,Аа, мен үйге барғым келеді.
Dialogue: 0,0:11:57.39,0:11:59.98,Default,,0,0,0,,Келген бойда не айтып тұрсың?
Dialogue: 0,0:12:00.10,0:12:02.27,Default,,0,0,0,,Мен келгендіктен айтып отырмын!
Dialogue: 0,0:12:07.52,0:12:08.44,Default,,0,0,0,,Бүгін, Изана-сама...
Dialogue: 0,0:12:08.57,0:12:12.07,Default,,0,0,0,,Достығымыз тереңдей түссін деп мені әдейі шақырды.
Dialogue: 0,0:12:12.53,0:12:15.32,Default,,0,0,0,,Сонымен қатар, бұл елдер арасындағы маңызды оқиға.
Dialogue: 0,0:12:15.45,0:12:18.99,Default,,0,0,0,,Мен білемін, бірақ қазір неге мен ғана?
Dialogue: 0,0:12:19.16,0:12:21.58,Default,,0,0,0,,Уф! Ауырды...
Dialogue: 0,0:12:21.71,0:12:22.67,Default,,0,0,0,,Сіз өзіңізді ауырып жатырсыз ба?
Dialogue: 0,0:12:22.79,0:12:23.87,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:24.25,0:12:25.08,Default,,0,0,0,,Ах
Dialogue: 0,0:12:35.34,0:12:37.10,Default,,0,0,0,,Clarines-ке қош келдіңіз
Dialogue: 0,0:12:38.01,0:12:40.64,Default,,0,0,0,,Мен Зен Вистериямын, екінші ханзада.
Dialogue: 0,0:12:41.02,0:12:42.39,Default,,0,0,0,,Сізбен алғаш рет кездескеніме қуаныштымын
Dialogue: 0,0:12:42.69,0:12:45.31,Default,,0,0,0,,А... а, мынау.
Dialogue: 0,0:12:45.65,0:12:49.78,Default,,0,0,0,,Бұл Танбарундық Радж Шехназад. Сізбен танысқаным мақтаныш.
Dialogue: 0,0:12:50.65,0:12:51.74,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:12:58.28,0:13:02.20,Default,,0,0,0,,Лорд Изана ханзада Раджды шақырады деп ешқашан күтпедім.
Dialogue: 0,0:13:02.58,0:13:05.54,Default,,0,0,0,,Мен өзімді қаланың қызына үйлендірейін деп жатырмын.
Dialogue: 0,0:13:05.67,0:13:07.46,Default,,0,0,0,,Мен сізге уланған алманы жеткізіп беремін.
Dialogue: 0,0:13:07.58,0:13:09.92,Default,,0,0,0,,Ол үмітсіз ханзада.
Dialogue: 0,0:13:10.05,0:13:12.59,Default,,0,0,0,,Хаха, бұл қатыгездік.
Dialogue: 0,0:13:14.43,0:13:17.39,Default,,0,0,0,,Шираюкиді шақырғаннан кейін. Мен қызықпын.
Dialogue: 0,0:13:17.93,0:13:21.39,Default,,0,0,0,,Ах, Дзен де бірдеңе болуы керек деді.
Dialogue: 0,0:13:23.35,0:13:25.81,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:13:30.86,0:13:35.07,Default,,0,0,0,,Бұл Изана Вистария. Қош келдіңіз, Раджи-доно.
Dialogue: 0,0:13:35.70,0:13:39.45,Default,,0,0,0,,Біз осылай кездесе алғандықтан, ресми болмайық.
Dialogue: 0,0:13:39.58,0:13:41.58,Default,,0,0,0,,Иә... Енді бақшаға барайық.
Dialogue: 0,0:13:56.01,0:13:56.84,Default,,0,0,0,,Саған бәрібір?
Dialogue: 0,0:13:56.97,0:13:57.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:59.05,0:14:00.68,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:14:00.80,0:14:03.39,Default,,0,0,0,,Мен күзетші жұмысымнан қашып кеттім.
Dialogue: 0,0:14:03.81,0:14:07.64,Default,,0,0,0,,Мастерлер біраз уақыттан бері біртүрлі әрекет етіп жүр.
Dialogue: 0,0:14:07.81,0:14:10.36,Default,,0,0,0,,Таңбарундық екенсің.
Dialogue: 0,0:14:10.69,0:14:12.98,Default,,0,0,0,,Бірдеңе дұрыс емес пе? Ханзада Раджиге
Dialogue: 0,0:14:14.65,0:14:18.45,Default,,0,0,0,,Міне, сондықтан мен сізді алып кетуге келдім, жас ханым.
Dialogue: 0,0:14:19.07,0:14:19.74,Default,,0,0,0,,Га
Dialogue: 0,0:14:19.87,0:14:21.62,Default,,0,0,0,,Барлаушыларға барайық.
Dialogue: 0,0:14:21.74,0:14:22.66,Default,,0,0,0,,Не, күте тұр... күте тұр...
Dialogue: 0,0:14:37.93,0:14:39.64,Default,,0,0,0,,Бұл қандай жағдай?
Dialogue: 0,0:14:40.09,0:14:41.05,Default,,0,0,0,,Тамақтанғыңыз келе ме?
Dialogue: 0,0:14:46.68,0:14:48.27,Default,,0,0,0,,Аа, түсіндім.
Dialogue: 0,0:14:48.39,0:14:52.27,Default,,0,0,0,,Жоғары мәртебелі Дзен, жаңа қызметші тағайындағаныңызды естідім.
Dialogue: 0,0:14:52.40,0:14:53.57,Default,,0,0,0,,Маркиз Харука?
Dialogue: 0,0:14:54.44,0:14:56.57,Default,,0,0,0,,Сенің ағаң осылай деді ме? Иә.
Dialogue: 0,0:14:57.24,0:15:01.07,Default,,0,0,0,,Ол өте епті және шебер, қызық жігіт сияқты.
Dialogue: 0,0:15:01.20,0:15:04.45,Default,,0,0,0,,Оны бірден қолдануға болатын болса, жақсы.
Dialogue: 0,0:15:04.58,0:15:05.79,Default,,0,0,0,,Жоғары мәртебелілердің қасындағыларға...
Dialogue: 0,0:15:06.37,0:15:08.91,Default,,0,0,0,,Айналаңыздағыларға бей-жай қарай алмайсыз.
Dialogue: 0,0:15:09.62,0:15:10.42,Default,,0,0,0,,Зен
Dialogue: 0,0:15:12.13,0:15:13.04,Default,,0,0,0,,Мен бәрібір жақсы боламын. Бар күшімді саламын
Dialogue: 0,0:15:13.29,0:15:16.55,Default,,0,0,0,,Мен онымен кездескенде екеуің не туралы сөйлестіңдер?
Dialogue: 0,0:15:17.21,0:15:19.01,Default,,0,0,0,,Бұл кездейсоқтық болды, бірақ
Dialogue: 0,0:15:19.13,0:15:21.51,Default,,0,0,0,,Иә, біз жаңа ғана кездестік.
Dialogue: 0,0:15:22.05,0:15:23.39,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:23.97,0:15:25.31,Default,,0,0,0,,Иә, Раджи-доно, иә?
Dialogue: 0,0:15:25.43,0:15:29.06,Default,,0,0,0,,Сіз таңдаған және назар аударған қызыл шашты ...
Dialogue: 0,0:15:30.23,0:15:31.69,Default,,0,0,0,,(Раджидің тұншыққан дауысы)
Dialogue: 0,0:15:32.35,0:15:36.48,Default,,0,0,0,,Ол қазір осы сарайда, есімі есіңізде ме?
Dialogue: 0,0:15:36.61,0:15:40.78,Default,,0,0,0,,Әй, қызыл шашты қыз?
Dialogue: 0,0:15:41.74,0:15:43.49,Default,,0,0,0,,Мен тым болмаса атын айта аламын.
Dialogue: 0,0:15:44.53,0:15:46.91,Default,,0,0,0,,Бұл Шираюки-доно болатын.
Dialogue: 0,0:15:51.21,0:15:52.83,Default,,0,0,0,,Бұл жаман үрдіс.
Dialogue: 0,0:15:53.29,0:15:56.71,Default,,0,0,0,,Мен қызыңыздан сізді тастап кеткенін естідім...
Dialogue: 0,0:15:56.88,0:15:59.42,Default,,0,0,0,,Өкінетін болсаң, мен саған дастархан жайып беремін.
Dialogue: 0,0:15:59.55,0:16:00.42,Default,,0,0,0,,Аға
Dialogue: 0,0:16:01.38,0:16:03.68,Default,,0,0,0,,Қанша уайымдасаң да тым көп.
Dialogue: 0,0:16:03.80,0:16:06.10,Default,,0,0,0,,Шынымен бе? Бұл жақсы мүмкіндік емес пе?
Dialogue: 0,0:16:06.72,0:16:09.93,Default,,0,0,0,,Мүмкін ол да өз еліне қайтқысы келетін шығар?
Dialogue: 0,0:16:10.39,0:16:11.06,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:16:14.02,0:16:17.82,Default,,0,0,0,,Әй, эй, әзіл сияқты бірдеңе айтып тұрсың.
Dialogue: 0,0:16:19.36,0:16:20.53,Default,,0,0,0,,Жас ханым?
Dialogue: 0,0:16:22.82,0:16:26.12,Default,,0,0,0,,Аа, кешіріңіз, үзілістен кейін қайтуым керек.
Dialogue: 0,0:16:30.66,0:16:34.12,Default,,0,0,0,,Саған Кларинстан кетуді бұйырды ма?
Dialogue: 0,0:16:35.33,0:16:37.38,Default,,0,0,0,,Өйткені бұл жерде қажет емес.
Dialogue: 0,0:16:44.64,0:16:46.01,Default,,0,0,0,,Раджи-доно, не?
Dialogue: 0,0:16:46.39,0:16:51.68,Default,,0,0,0,,Ах... Аа, кешіріңіз, бірақ Изана-доно, мен одан аулақ боламын.
Dialogue: 0,0:16:52.52,0:16:56.02,Default,,0,0,0,,Мені Шираюки-доно қалдырмағаны сөзсіз.
Dialogue: 0,0:16:56.15,0:16:58.77,Default,,0,0,0,,Ол басқа елде тұрғысы келгендіктен елін тастап кетті...
Dialogue: 0,0:16:58.90,0:17:01.32,Default,,0,0,0,,Себебі сен мені өз еркіңмен жібердің.
Dialogue: 0,0:17:01.94,0:17:03.57,Default,,0,0,0,,Амал жоқ, өкініш т.б.
Dialogue: 0,0:17:04.82,0:17:06.82,Default,,0,0,0,,Кездеспеуіміздің себебі бар ма?
Dialogue: 0,0:17:10.33,0:17:11.16,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:17:11.83,0:17:15.46,Default,,0,0,0,,Егер сіз ақымақтығыңыздың көпшілікке мәлім болғанын қаламасаңыз...
Dialogue: 0,0:17:15.79,0:17:17.54,Default,,0,0,0,,Шираюкимен енді ешқашан айналыспау.
Dialogue: 0,0:17:17.67,0:17:21.30,Default,,0,0,0,,Шираюкидің атын бұл ауызбен ешқашан атамаймын деп ант ет.
Dialogue: 0,0:17:24.42,0:17:25.76,Default,,0,0,0,,Мен... Түсіндім, ант етемін!
Dialogue: 0,0:17:26.30,0:17:27.14,Default,,0,0,0,,Мен жаңа ғана ант бердім!
Dialogue: 0,0:17:27.51,0:17:28.60,Default,,0,0,0,,
Dialogue: 0,0:17:29.55,0:17:31.31,Default,,0,0,0,,Шираюки-доно...
Dialogue: 0,0:17:32.43,0:17:36.44,Default,,0,0,0,,Мен Зен-дононы өзінің күйеу жігіті деп санайтынын естідім.
Dialogue: 0,0:17:45.82,0:17:47.53,Default,,0,0,0,,Не? мм... иә?
Dialogue: 0,0:17:48.41,0:17:49.83,Default,,0,0,0,,<Мен оны «Спайс» деп атаймын➡
Dialogue: 0,0:17:50.70,0:17:51.49,Default,,0,0,0,,Зен-доно, қайда бара жатырсың?
Dialogue: 0,0:17:52.87,0:17:54.91,Default,,0,0,0,,Мен... Жаңа айтқаным
Dialogue: 0,0:17:55.16,0:17:56.83,Default,,0,0,0,,Мен есінен танып қалатын сияқтымын
Dialogue: 0,0:17:58.71,0:18:00.96,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:01.25,0:18:04.72,Default,,0,0,0,,Күте тұрыңыз, бұл жай ғана жағдай емес пе?
Dialogue: 0,0:18:04.84,0:18:05.84,Default,,0,0,0,,Қайда!
Dialogue: 0,0:18:06.09,0:18:08.68,Default,,0,0,0,,Мен тым көп сөйлеген шығармын, бірақ...
Dialogue: 0,0:18:09.05,0:18:11.31,Default,,0,0,0,,Қай жол Бір оқиға емес пе?
Dialogue: 0,0:18:11.43,0:18:12.43,Default,,0,0,0,,Дәл солай ма?
Dialogue: 0,0:18:12.68,0:18:15.43,Default,,0,0,0,,Шираюки-доно екеуің ғашықсыңдар ма?
Dialogue: 0,0:18:17.31,0:18:17.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:19.40,0:18:22.11,Default,,0,0,0,,Бұл солай емес пе?
Dialogue: 0,0:18:22.23,0:18:22.90,Default,,0,0,0,,Біраз ұят қой, иә?
Dialogue: 0,0:18:23.53,0:18:26.03,Default,,0,0,0,,Бұл мәселе. Неге сен?
Dialogue: 0,0:18:26.15,0:18:27.20,Default,,0,0,0,,Бұл емес...
Dialogue: 0,0:18:27.40,0:18:30.82,Default,,0,0,0,,Шираюки-доно сені тастап кетпейтініне кепілдік жоқ па?
Dialogue: 0,0:18:33.95,0:18:37.21,Default,,0,0,0,,Шираюки-доно улы алма оқиғасы туралы біледі.
Dialogue: 0,0:18:37.33,0:18:38.87,Default,,0,0,0,,Көзге көрінетін жерде болуы керек
Dialogue: 0,0:18:41.29,0:18:43.63,Default,,0,0,0,,Егер Зен-доно бұлай сезінбесе...
Dialogue: 0,0:18:45.17,0:18:48.22,Default,,0,0,0,,Мен Шираюки-дононы қарсы аламын.
Dialogue: 0,0:18:50.80,0:18:51.47,Default,,0,0,0,,Не...?
Dialogue: 0,0:18:52.47,0:18:55.64,Default,,0,0,0,,Бұл Изана-доно үшін ыңғайлырақ болар деп ойламайсыз ба?
Dialogue: 0,0:18:55.77,0:18:58.85,Default,,0,0,0,,Әрине, Шираюки-доно менің сарайымда сыпайы болады...
Dialogue: 0,0:18:59.35,0:19:00.44,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:19:03.94,0:19:05.32,Default,,0,0,0,,Лорд Зен! Әңгіме әлі...
Dialogue: 0,0:19:05.53,0:19:09.36,Default,,0,0,0,,Шираюки қазір осы сарайда екенін айтайын...
Dialogue: 0,0:19:09.74,0:19:11.28,Default,,0,0,0,,Сол күні не болғанын жасырмаймын.
Dialogue: 0,0:19:12.70,0:19:14.70,Default,,0,0,0,,Жарайды, бұдан былай мен...
Dialogue: 0,0:19:14.83,0:19:17.37,Default,,0,0,0,,Сіздің Шираюки бола алатыныңызға кепілдік жоқ.
Dialogue: 0,0:19:19.25,0:19:20.42,Default,,0,0,0,,Тыңда, Раджи.
Dialogue: 0,0:19:20.71,0:19:24.25,Default,,0,0,0,,Бұл уәде етілген жоқ, сондықтан солай болғанын қалаймын.
Dialogue: 0,0:19:25.75,0:19:27.51,Default,,0,0,0,,Сондықтан адамдар қозғалады
Dialogue: 0,0:19:33.18,0:19:34.85,Default,,0,0,0,,Аа, мәртебелі Дзен.
Dialogue: 0,0:19:35.51,0:19:37.06,Default,,0,0,0,,Бұл шынымен де жай кездейсоқтық па деп ойлайсың ба?
Dialogue: 0,0:19:37.18,0:19:40.98,Default,,0,0,0,,Раджи-доно екеуміз сөйлесе алмай қалдық.
Dialogue: 0,0:19:41.94,0:19:42.60,Default,,0,0,0,,Аға
Dialogue: 0,0:19:43.56,0:19:46.40,Default,,0,0,0,,Шираюкимен құда түсуді ойламаймын...
Dialogue: 0,0:19:47.15,0:19:48.61,Default,,0,0,0,,Тіпті қолданылмайды
Dialogue: 0,0:19:55.16,0:20:00.66,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:20:02.96,0:20:04.13,Default,,0,0,0,,Алдын ала кешіріңіз.
Dialogue: 0,0:20:04.92,0:20:06.17,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:20:17.60,0:20:19.18,Default,,0,0,0,,Енді бітті
Dialogue: 0,0:20:20.68,0:20:21.89,Default,,0,0,0,,Ханзада Раджи
Dialogue: 0,0:20:23.27,0:20:25.11,Default,,0,0,0,,Мен сонда қанша уақыт боламын деп ойлаймын
Dialogue: 0,0:20:26.19,0:20:29.53,Default,,0,0,0,,Мен кеткенде біреу мені олармен бірге жүруімді сұраса, мен не істеуім керек?
Dialogue: 0,0:20:33.20,0:20:34.66,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:20:40.62,0:20:41.66,Default,,0,0,0,,Зен
Dialogue: 0,0:20:45.38,0:20:46.33,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:50.55,0:20:52.01,Default,,0,0,0,,Мен жауап бере алмаймын
Dialogue: 0,0:20:54.05,0:20:58.01,Default,,0,0,0,,Дзенге жақын болғандықтан, мен болашақта не істей аламын деп ойлаймын.
Dialogue: 0,0:20:58.47,0:21:01.98,Default,,0,0,0,,Менің қазір осында болуымның мәні
Dialogue: 0,0:21:06.98,0:21:09.11,Default,,0,0,0,,Құнсыз ханзада дайын.
Dialogue: 0,0:21:09.98,0:21:15.70,Default,,0,0,0,,Сол кездегідей мен ештеңеге жауап бере алмаймын.
Dialogue: 0,0:21:18.37,0:21:19.03,Default,,0,0,0,,Ах
Dialogue: 0,0:21:20.54,0:21:21.20,Default,,0,0,0,,Шираюки
Dialogue: 0,0:21:23.04,0:21:25.92,Default,,0,0,0,,Сіз баруды шешкен жер...
Dialogue: 0,0:21:27.79,0:21:30.63,Default,,0,0,0,,Менің бұл елде болуымның мәні
Dialogue: 0,0:21:31.46,0:21:36.13,Default,,0,0,0,,Мен Дзеннің бұл елде қалай өмір сүретінін көргім келеді.
Dialogue: 0,0:21:36.68,0:21:39.85,Default,,0,0,0,,Бұл орындалатын жер мен баруды шешкен жер.
Dialogue: 0,0:21:41.81,0:21:45.35,Default,,0,0,0,,Мен сізді сол жерде көрсем, риза болар едім.
Dialogue: 0,0:21:46.27,0:21:47.10,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:22:01.66,0:22:03.54,Default,,0,0,0,,(Ақшақардың ауыр тыныс алуы)
Dialogue: 0,0:22:05.62,0:22:09.25,Default,,0,0,0,,(Шираюкидің ентігуі)
Dialogue: 0,0:22:16.13,0:22:17.13,Default,,0,0,0,,Зен…
Dialogue: 0,0:22:25.23,0:22:30.23,Default,,0,0,0,,♪~
Dialogue: 0,0:23:48.81,0:23:53.81,Default,,0,0,0,,~♪
Dialogue: 0,0:23:55.82,0:23:57.90,Default,,0,0,0,,Шираюки Не болды?
Dialogue: 0,0:23:57.98,0:24:01.03,Default,,0,0,0,,Қалай ойлайсың, ханшайым? Сіз оны жек көресіз бе?
Dialogue: 0,0:24:01.15,0:24:04.16,Default,,0,0,0,,Менің алдымда әрқашан ағам болатын.
Dialogue: 0,0:24:04.24,0:24:05.91,Default,,0,0,0,,Сіз өзіңіздің шынайы әлеуетіңізді көрсетіп жатырсыз.
Dialogue: 0,0:24:05.99,0:24:08.79,Default,,0,0,0,,Әрқашан одақтас болады.
Dialogue: 0,0:24:10.29,0:24:16.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
