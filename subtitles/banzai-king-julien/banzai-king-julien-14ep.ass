Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:41.24,0:00:44.50,Default,,0,0,0,,Бұл күн осы айда тағы да келді.
Dialogue: 0,0:00:44.62,0:00:48.67,Default,,0,0,0,,Бізде бар нәрседен бір нәрсе...
Dialogue: 0,0:00:48.79,0:00:52.84,Default,,0,0,0,,Оны аспан құдайы Франкке ұсынайық.
Dialogue: 0,0:00:53.92,0:00:55.93,Default,,0,0,0,,Мен сенімен танысқым келеді.
Dialogue: 0,0:00:56.05,0:00:58.72,Default,,0,0,0,,Мен оның бар екенін растағым келеді
Dialogue: 0,0:00:58.85,0:01:01.39,Default,,0,0,0,,Мен оны ешқашан көрген емеспін
Dialogue: 0,0:01:03.10,0:01:06.81,Default,,0,0,0,,Қазір алға шығып, сыйлығыңызды ұсыныңыз.
Dialogue: 0,0:01:06.94,0:01:09.23,Default,,0,0,0,,Фрэнк! Фрэнк!
Dialogue: 0,0:01:12.07,0:01:15.61,Default,,0,0,0,,Фрэнк Бұл сүйкімді қоян.
Dialogue: 0,0:01:15.74,0:01:18.99,Default,,0,0,0,,Неге оны алу үшін осында келмейсің?
Dialogue: 0,0:01:19.12,0:01:20.08,Default,,0,0,0,,Жүр.
Dialogue: 0,0:01:23.37,0:01:25.79,Default,,0,0,0,,Қараңызшы, бұл тот басқан банка.
Dialogue: 0,0:01:26.04,0:01:27.17,Default,,0,0,0,,Қызықсыз заттар
Dialogue: 0,0:01:27.29,0:01:31.29,Default,,0,0,0,,Бұл тот басқан банка. Сіз оны қалайсыз.
Dialogue: 0,0:01:31.92,0:01:36.13,Default,,0,0,0,,Қазір келіп алмасаң, бермеймін.
Dialogue: 0,0:01:36.59,0:01:39.55,Default,,0,0,0,,Келіңізші, өтінемін.
Dialogue: 0,0:01:41.43,0:01:44.27,Default,,0,0,0,,Патша, сізді бірдеңе уайымдап тұр ма?
Dialogue: 0,0:01:44.39,0:01:48.60,Default,,0,0,0,,Мен сіздің эмоцияларыңызды жасыруға шебер екеніңізді түсінемін.
Dialogue: 0,0:01:48.73,0:01:51.11,Default,,0,0,0,,Фрэнктің болуы
Dialogue: 0,0:01:51.23,0:01:55.36,Default,,0,0,0,,Бөксенің түбінде, Мен күдіктене бастадым.
Dialogue: 0,0:01:56.24,0:01:57.49,Default,,0,0,0,,Кешіріңіз, бес порция алайын ба?
Dialogue: 0,0:01:57.61,0:02:00.41,Default,,0,0,0,,Король, шегініңіз.
Dialogue: 0,0:02:00.53,0:02:03.33,Default,,0,0,0,,Бірақ бұл туралы ойланыңыз.
Dialogue: 0,0:02:03.45,0:02:08.33,Default,,0,0,0,,Мен Фрэнкке ай сайын сыйлықтар ұсынсам да.
Dialogue: 0,0:02:08.46,0:02:10.96,Default,,0,0,0,,Ол қабылдамайды
Dialogue: 0,0:02:11.08,0:02:12.50,Default,,0,0,0,,Және Фосса.
Dialogue: 0,0:02:12.63,0:02:15.38,Default,,0,0,0,,Егер Фрэнк бар болса
Dialogue: 0,0:02:15.51,0:02:19.26,Default,,0,0,0,,Ол бізді қорғайды.
Dialogue: 0,0:02:19.38,0:02:22.26,Default,,0,0,0,,Ал егер бар болса...
Dialogue: 0,0:02:22.39,0:02:26.85,Default,,0,0,0,,Неліктен Фрэнк мұндай адамның өмір сүруіне рұқсат берді?
Dialogue: 0,0:02:27.89,0:02:30.73,Default,,0,0,0,,Ол жұмбақтарға толы.
Dialogue: 0,0:02:31.10,0:02:33.57,Default,,0,0,0,,Фрэнк жоқ.
Dialogue: 0,0:02:36.86,0:02:38.78,Default,,0,0,0,,Сіз Фрэнкке бардыңыз.
Dialogue: 0,0:02:38.90,0:02:43.41,Default,,0,0,0,,Мен Фрэнктің бар екендігінің дәлелін көрмейінше сенбеймін.
Dialogue: 0,0:02:43.53,0:02:46.91,Default,,0,0,0,,Фрэнк! Фрэнк!
Dialogue: 0,0:02:48.37,0:02:51.67,Default,,0,0,0,,Бұл Фрэнк Джулиан.
Dialogue: 0,0:02:51.79,0:02:57.09,Default,,0,0,0,,Мен жауап бере алмайтын себебім бар ма, білмеймін, мүмкін демалыста шығарсың.
Dialogue: 0,0:02:57.21,0:03:02.59,Default,,0,0,0,,Егер сіз сонда болсаңыз, маған белгі беріңіз.
Dialogue: 0,0:03:05.39,0:03:07.47,Default,,0,0,0,,Фрэнк әлі жоқ
Dialogue: 0,0:03:18.40,0:03:21.70,Default,,0,0,0,,Морт, үйге қайт, маған сенің құшағың керек емес.
Dialogue: 0,0:03:25.07,0:03:28.33,Default,,0,0,0,,Мен Фрэнкпін
Dialogue: 0,0:03:28.45,0:03:29.58,Default,,0,0,0,,Қай Франк?
Dialogue: 0,0:03:29.83,0:03:32.08,Default,,0,0,0,,Бұл Франк, аспан құдайы.
Dialogue: 0,0:03:32.25,0:03:35.96,Default,,0,0,0,,Егер Фрэнк шынымен бар болса...
Dialogue: 0,0:03:36.09,0:03:40.01,Default,,0,0,0,,Ол биік және жылтыр болуы керек.
Dialogue: 0,0:03:41.09,0:03:45.47,Default,,0,0,0,,Сіз Фрэнк болмасаңыз, мұны істей алар ма едіңіз?
Dialogue: 0,0:03:45.60,0:03:47.01,Default,,0,0,0,,Үлкен мәселе емес
Dialogue: 0,0:03:47.14,0:03:49.81,Default,,0,0,0,,Мұны істей алатын тағы төрт адам бар.
Dialogue: 0,0:03:49.93,0:03:51.14,Default,,0,0,0,,Дәлел емес
Dialogue: 0,0:03:52.27,0:03:54.35,Default,,0,0,0,,Егер бұл шынымен Фрэнк болса
Dialogue: 0,0:03:54.48,0:03:59.69,Default,,0,0,0,,Жарқыраған жүрекпен менің атымды аспанға жаза аласың ба?
Dialogue: 0,0:04:00.74,0:04:01.65,Default,,0,0,0,,«Джулиан»
Dialogue: 0,0:04:03.36,0:04:04.82,Default,,0,0,0,,Мен әлі де сене алар емеспін
Dialogue: 0,0:04:04.95,0:04:07.16,Default,,0,0,0,,Жұмыртқаны аузыңнан шығара аласың ба?
Dialogue: 0,0:04:11.83,0:04:16.54,Default,,0,0,0,,Сіз кокос жаңғағы крем-брюле жасай аласыз ба?
Dialogue: 0,0:04:19.50,0:04:20.84,Default,,0,0,0,,Нашар көрінеді
Dialogue: 0,0:04:20.96,0:04:23.51,Default,,0,0,0,,Қалай болғанда да, мен Фрэнкпін.
Dialogue: 0,0:04:23.63,0:04:27.14,Default,,0,0,0,,Мен мұнда өзімнің бар екенімді дәлелдеу үшін келген жоқпын.
Dialogue: 0,0:04:27.26,0:04:31.06,Default,,0,0,0,,Бұл нағыз Фрэнк айтатын жол.
Dialogue: 0,0:04:31.18,0:04:33.85,Default,,0,0,0,,Фрэнк! Бұл шынымен сен бе?
Dialogue: 0,0:04:35.10,0:04:38.19,Default,,0,0,0,,Сізге күмәнданғаным үшін кешіріңіз.
Dialogue: 0,0:04:38.31,0:04:41.03,Default,,0,0,0,,Қоянды алғаны үшін де кешірім сұра.
Dialogue: 0,0:04:45.61,0:04:49.12,Default,,0,0,0,,Морис өте терең ән айтады...
Dialogue: 0,0:04:49.28,0:04:50.33,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:04:50.45,0:04:53.71,Default,,0,0,0,,Ол Франк сияқты нәрсе жоқ деп бастады.
Dialogue: 0,0:04:55.16,0:04:59.25,Default,,0,0,0,,Сондықтан мен байланыстарымды патша ретінде пайдалануды шештім.
Dialogue: 0,0:04:59.38,0:05:01.13,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:05:05.26,0:05:06.68,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:05:09.93,0:05:13.18,Default,,0,0,0,,Мен Фрэнкпін, аспан құдайы.
Dialogue: 0,0:05:13.60,0:05:16.02,Default,,0,0,0,,үшінңызбен танысқаныма қуаныштымын.
Dialogue: 0,0:05:16.14,0:05:19.11,Default,,0,0,0,,Фрэнк!
Dialogue: 0,0:05:19.69,0:05:22.53,Default,,0,0,0,,Сәлем Машикула
Dialogue: 0,0:05:23.48,0:05:24.24,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:24.36,0:05:27.03,Default,,0,0,0,,Фрэнк «сәлем» дейді ме?
Dialogue: 0,0:05:33.54,0:05:36.37,Default,,0,0,0,,Бұл шынымен Фрэнк пе?
Dialogue: 0,0:05:36.87,0:05:41.29,Default,,0,0,0,,Морис, егер мен Фрэнк болмасам
Dialogue: 0,0:05:41.42,0:05:44.30,Default,,0,0,0,,Мен сенің сырыңды неге білемін деп ойлайсың?
Dialogue: 0,0:05:44.59,0:05:48.55,Default,,0,0,0,,Мен сенің бөксеңмен не істегеніңді білемін.
Dialogue: 0,0:05:48.72,0:05:51.64,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:05:51.76,0:05:54.14,Default,,0,0,0,,Патша креслосында
Dialogue: 0,0:05:54.52,0:05:58.64,Default,,0,0,0,,Патша, келесі жолы мені тыңда.
Dialogue: 0,0:05:59.40,0:06:01.77,Default,,0,0,0,,Мені кешіріңіз, Фрэнк.
Dialogue: 0,0:06:01.90,0:06:06.15,Default,,0,0,0,,Сіз мұны істедіңіз бе? Бұл жанама поцелу болды.
Dialogue: 0,0:06:06.90,0:06:10.95,Default,,0,0,0,,Бұл сіздің Фрэнк екеніңіздің дәлелі емес.
Dialogue: 0,0:06:11.07,0:06:13.33,Default,,0,0,0,,Дұрыс, Кловер.
Dialogue: 0,0:06:13.45,0:06:16.58,Default,,0,0,0,,Мен сізді өте талантты деп естідім.
Dialogue: 0,0:06:16.87,0:06:22.59,Default,,0,0,0,,Күн сайын таңертеңгі күрес жаттығуларыңызға қатысқан адамнан.
Dialogue: 0,0:06:22.71,0:06:27.01,Default,,0,0,0,,Роза әже? Мен қазірдің өзінде өлдім
Dialogue: 0,0:06:27.13,0:06:29.43,Default,,0,0,0,,Мен бұл туралы кеше айттым.
Dialogue: 0,0:06:29.55,0:06:33.47,Default,,0,0,0,,Маған «кішкентай роди-санға» хабар беріңізші.
Dialogue: 0,0:06:33.60,0:06:35.52,Default,,0,0,0,,Бұл сұралды
Dialogue: 0,0:06:36.39,0:06:39.64,Default,,0,0,0,,Бұл тек әжелер қолданатын лақап ат.
Dialogue: 0,0:06:39.77,0:06:44.07,Default,,0,0,0,,Сіз не айттыңыз? Мерикен қаптың естелігі қайда?
Dialogue: 0,0:06:44.19,0:06:49.70,Default,,0,0,0,,«Ұрыс кезінде міндетті түрде қарсыласыңыздың көзі мен мұрнын көздеңіз».
Dialogue: 0,0:06:50.32,0:06:52.16,Default,,0,0,0,,Мен солай істеймін, әже.
Dialogue: 0,0:06:52.16,0:06:53.12,Default,,0,0,0,,Мен осылай істеп жатырмын, әже `` Кішкентай төбелес жігітке''
Dialogue: 0,0:06:53.12,0:06:54.12,Default,,0,0,0,,``Кішкентай бұзық жігітке''
Dialogue: 0,0:06:54.41,0:06:55.49,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:06:55.62,0:06:57.33,Default,,0,0,0,,Тағы кімде күмән бар?
Dialogue: 0,0:07:01.33,0:07:05.92,Default,,0,0,0,,үшін келіседі, бүгін шынымен де тамаша күн.
Dialogue: 0,0:07:06.30,0:07:10.72,Default,,0,0,0,,Мен Фрэнк жоқ деп ойлай бастадым.
Dialogue: 0,0:07:10.84,0:07:15.68,Default,,0,0,0,,Мен оның шын екенін біліп, бізді бақылап тұрдым.
Dialogue: 0,0:07:19.10,0:07:22.56,Default,,0,0,0,,Айтпақшы, бәріңізге айтарым маңызды.
Dialogue: 0,0:07:22.69,0:07:23.90,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:07:24.02,0:07:28.53,Default,,0,0,0,,Мен неге келдім деп ойлайсың
Dialogue: 0,0:07:28.65,0:07:31.53,Default,,0,0,0,,Мен аспан құдайына көтерілемін бе?
Dialogue: 0,0:07:31.65,0:07:34.07,Default,,0,0,0,,Сіз үлкен күшке ие бола аласыз ба?
Dialogue: 0,0:07:34.20,0:07:38.74,Default,,0,0,0,,Ойлану арқылы ғана жарылып кететін күш.
Dialogue: 0,0:07:38.87,0:07:40.87,Default,,0,0,0,,Қолдарыңыз қатып қалды ма?
Dialogue: 0,0:07:41.00,0:07:43.50,Default,,0,0,0,,үшін таң қалады.
Dialogue: 0,0:07:43.67,0:07:48.42,Default,,0,0,0,,"Патшаның қолы керемет! Бұл өте қорқынышты!"
Dialogue: 0,0:07:48.55,0:07:49.51,Default,,0,0,0,,Әрі қарай жалғастыр.
Dialogue: 0,0:07:49.63,0:07:55.34,Default,,0,0,0,,Мен жанартау құдайы Ларриге келдім.
Dialogue: 0,0:07:55.47,0:07:58.31,Default,,0,0,0,,үшінна ашуланады
Dialogue: 0,0:07:58.43,0:08:01.56,Default,,0,0,0,,Мадагаскарды жойғысы келеді.
Dialogue: 0,0:08:01.68,0:08:03.85,Default,,0,0,0,,Ұнамаса...
Dialogue: 0,0:08:04.35,0:08:07.73,Default,,0,0,0,,Патша құрбандық ретінде өзін кратерге лақтырды.
Dialogue: 0,0:08:08.02,0:08:09.36,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:09.48,0:08:10.19,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:08:10.32,0:08:11.57,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,0:08:15.91,0:08:17.41,Default,,0,0,0,,Ал енді, жебе, қай адамды қалайсың?
Dialogue: 0,0:08:17.53,0:08:20.37,Default,,0,0,0,,Көпшіліктен жасырылған
Dialogue: 0,0:08:20.50,0:08:21.37,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:08:21.50,0:08:23.50,Default,,0,0,0,,Патша, сіз сондасыз ба?
Dialogue: 0,0:08:23.62,0:08:28.71,Default,,0,0,0,,Мен сені құрбан ету үшін емес, сені өлшеу үшін келдім.
Dialogue: 0,0:08:30.09,0:08:36.05,Default,,0,0,0,,Мұнда тек Морт бар, мен кішкентаймын және тітіркендіргішпін.
Dialogue: 0,0:08:37.85,0:08:41.31,Default,,0,0,0,,Машикураға патша жоқ екенін айт.
Dialogue: 0,0:08:41.43,0:08:43.31,Default,,0,0,0,,Басқа нәрсені іздеңіз
Dialogue: 0,0:08:45.02,0:08:48.56,Default,,0,0,0,,Король Бұл жай ғана түсінбеушілік шығар.
Dialogue: 0,0:08:48.69,0:08:51.65,Default,,0,0,0,,Фрэнкпен сөйлесу
Dialogue: 0,0:08:51.78,0:08:53.19,Default,,0,0,0,,Сабырлы болыңыз.
Dialogue: 0,0:08:53.32,0:08:57.07,Default,,0,0,0,,Дұрыс, сабырмен сөйлесейік.
Dialogue: 0,0:08:57.20,0:08:59.08,Default,,0,0,0,,Сонда сіз мұны істей аласыз
Dialogue: 0,0:09:02.37,0:09:05.16,Default,,0,0,0,,Жарайды, сабыр сақта.
Dialogue: 0,0:09:09.42,0:09:12.05,Default,,0,0,0,,Сәлем Фрэнк
Dialogue: 0,0:09:12.46,0:09:17.34,Default,,0,0,0,,Бұл менің өзімді кратерге лақтырғаным туралы оқиға...
Dialogue: 0,0:09:18.80,0:09:20.18,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:20.30,0:09:23.77,Default,,0,0,0,,Патшаны жанартауға лақтырмаңыз
Dialogue: 0,0:09:24.06,0:09:25.81,Default,,0,0,0,,Дамар!
Dialogue: 0,0:09:26.31,0:09:28.56,Default,,0,0,0,,Алдымен тізерлеп отырыңыз.
Dialogue: 0,0:09:31.11,0:09:32.65,Default,,0,0,0,,Джулиан
Dialogue: 0,0:09:34.11,0:09:35.07,Default,,0,0,0,,Карл?
Dialogue: 0,0:09:35.19,0:09:38.95,Default,,0,0,0,,Мен аспан құдайын қалай ойнадым?
Dialogue: 0,0:09:39.07,0:09:41.16,Default,,0,0,0,,Чонси көзге жауапты.
Dialogue: 0,0:09:41.28,0:09:43.29,Default,,0,0,0,,Дұрыс, Чонси.
Dialogue: 0,0:09:43.41,0:09:47.25,Default,,0,0,0,,Аспан құдайы болып көріну? Ол ең жаман жігіт
Dialogue: 0,0:09:47.37,0:09:53.13,Default,,0,0,0,,Неліктен олардың мұндай күрделі шараларды қабылдағанын білгіңіз келеді.
Dialogue: 0,0:09:53.25,0:09:54.13,Default,,0,0,0,,Бөлек
Dialogue: 0,0:09:54.26,0:09:55.51,Default,,0,0,0,,Мен сізге айтамын
Dialogue: 0,0:09:55.63,0:09:59.47,Default,,0,0,0,,Тілек тастар толтырылған шар...
Dialogue: 0,0:09:59.59,0:10:01.68,Default,,0,0,0,,үшін жаншылған кезде басталды.
Dialogue: 0,0:10:02.76,0:10:05.43,Default,,0,0,0,,Мен ес жидым...
Dialogue: 0,0:10:05.56,0:10:10.15,Default,,0,0,0,,үшінның тілегін оқыдым.
Dialogue: 0,0:10:13.11,0:10:14.98,Default,,0,0,0,,Бұл жігіт қорқынышты
Dialogue: 0,0:10:17.99,0:10:23.53,Default,,0,0,0,,Содан кейін мен Фрэнкке деген сенімімді пайдалану идеясын алдым...
Dialogue: 0,0:10:23.87,0:10:29.33,Default,,0,0,0,,Мен өзімді Фрэнк, бәрін білуші, құдіретті Құдай деп көрсеттім.
Dialogue: 0,0:10:29.46,0:10:34.00,Default,,0,0,0,,Оның нағыз Фрэнк екеніне сену үшін...
Dialogue: 0,0:10:34.71,0:10:38.63,Default,,0,0,0,,Чонси ақпарат жинады.
Dialogue: 0,0:10:44.10,0:10:48.02,Default,,0,0,0,,Сенің сенімің бұлдыр болды...
Dialogue: 0,0:10:48.14,0:10:50.31,Default,,0,0,0,,Бұл менің жоспарыма көмектесті.
Dialogue: 0,0:10:50.69,0:10:54.40,Default,,0,0,0,,Бұл торттағы глазурь болды.
Dialogue: 0,0:10:54.65,0:10:59.15,Default,,0,0,0,,Бірақ бұл мәре сәтсіз аяқталды.
Dialogue: 0,0:10:59.28,0:11:01.49,Default,,0,0,0,,Төменгі бөлігін ғана жеңіз
Dialogue: 0,0:11:01.61,0:11:04.37,Default,,0,0,0,,Сіздің жоспарыңыз осы жерде аяқталады.
Dialogue: 0,0:11:04.49,0:11:06.24,Default,,0,0,0,,үшінн көпшілікке айтыңыз
Dialogue: 0,0:11:08.25,0:11:09.41,Default,,0,0,0,,Өз қалауыңыз бойынша
Dialogue: 0,0:11:09.54,0:11:12.58,Default,,0,0,0,,Маған ешкім сенбейді
Dialogue: 0,0:11:14.00,0:11:16.55,Default,,0,0,0,,Ақымақ, мен патшамын.
Dialogue: 0,0:11:16.71,0:11:20.17,Default,,0,0,0,,Заң патшаның айтқанына сенуіңді талап етеді.
Dialogue: 0,0:11:20.30,0:11:21.80,Default,,0,0,0,,Шешім жоқ
Dialogue: 0,0:11:22.47,0:11:24.10,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:11:24.89,0:11:26.51,Default,,0,0,0,,Жауапты адамды атаңыз
Dialogue: 0,0:11:26.64,0:11:31.81,Default,,0,0,0,,Сізге Құдіреті шексіз Құдайдан артық біреу сенеді деп ойлайсыз ба?
Dialogue: 0,0:11:32.23,0:11:35.19,Default,,0,0,0,,Халық қолында құрбан бол
Dialogue: 0,0:11:37.19,0:11:40.53,Default,,0,0,0,,Керемет мен данышпанмын!
Dialogue: 0,0:11:41.24,0:11:45.74,Default,,0,0,0,,Менімен ұрысқан соң ғана айт.
Dialogue: 0,0:11:52.04,0:11:53.25,Default,,0,0,0,,Беде!
Dialogue: 0,0:11:53.58,0:11:55.88,Default,,0,0,0,,Қоңырау шалыңыз...
Dialogue: 0,0:11:57.92,0:12:00.59,Default,,0,0,0,,Джулиан, қорқып тұрсың ба?
Dialogue: 0,0:12:00.71,0:12:03.55,Default,,0,0,0,,Мен сені енді ренжітпеймін
Dialogue: 0,0:12:03.68,0:12:06.30,Default,,0,0,0,,Кейінірек үшін сақтау
Dialogue: 0,0:12:06.64,0:12:08.60,Default,,0,0,0,,Король қашып кет!
Dialogue: 0,0:12:18.19,0:12:19.19,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:12:21.49,0:12:24.07,Default,,0,0,0,,Сіз не істеп жатырсыз? Мені ұста!
Dialogue: 0,0:12:24.20,0:12:25.66,Default,,0,0,0,,Мені тыңда.
Dialogue: 0,0:12:25.78,0:12:26.66,Default,,0,0,0,,Қысқаша
Dialogue: 0,0:12:26.78,0:12:28.66,Default,,0,0,0,,Бұл өкінішті жаңалық.
Dialogue: 0,0:12:28.78,0:12:32.50,Default,,0,0,0,,Франк – Карл жасаған робот.
Dialogue: 0,0:12:32.62,0:12:35.83,Default,,0,0,0,,Оның мақсаты – мені құрту.
Dialogue: 0,0:12:35.96,0:12:40.75,Default,,0,0,0,,Ендеше бәріміз бірге оны тоқтатуға тырысайық.
Dialogue: 0,0:12:40.88,0:12:42.34,Default,,0,0,0,,Жоспарларыңыз бар ма?
Dialogue: 0,0:12:42.47,0:12:44.38,Default,,0,0,0,,Менің аяғымды біреу ұстады
Dialogue: 0,0:12:44.51,0:12:48.55,Default,,0,0,0,,Корольді кратерге лақтырсаң, Фрэнк сені мақтайды.
Dialogue: 0,0:12:48.68,0:12:49.76,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:12:49.89,0:12:52.98,Default,,0,0,0,,Мен сізге Карлдың Фрэнк екенін айттым.
Dialogue: 0,0:12:53.10,0:12:55.39,Default,,0,0,0,,Аузыңызды таспамен жабыңыз
Dialogue: 0,0:12:55.52,0:12:58.98,Default,,0,0,0,,Құрбандықтың айғайын есту қызық болар еді.
Dialogue: 0,0:13:05.03,0:13:07.74,Default,,0,0,0,,Не болды, Рюзаки?
Dialogue: 0,0:13:07.87,0:13:12.87,Default,,0,0,0,,Жасанды болса да Алланы жеңу мүмкін емес.
Dialogue: 0,0:13:13.00,0:13:15.71,Default,,0,0,0,,Патша менің құдайым
Dialogue: 0,0:13:16.08,0:13:18.17,Default,,0,0,0,,Енді мұны жасамаңыз.
Dialogue: 0,0:13:18.71,0:13:20.59,Default,,0,0,0,,Күте тұрыңыз, дәл солай!
Dialogue: 0,0:13:20.96,0:13:21.80,Default,,0,0,0,,Тимо
Dialogue: 0,0:13:22.88,0:13:26.38,Default,,0,0,0,,Бір сағатта құдай жасау
Dialogue: 0,0:13:34.68,0:13:37.90,Default,,0,0,0,,Бұл жанартау құдайы Ларри.
Dialogue: 0,0:13:42.02,0:13:44.74,Default,,0,0,0,,Егер мен Құдай болсам
Dialogue: 0,0:13:44.86,0:13:48.57,Default,,0,0,0,,Мынадай шығар
Dialogue: 0,0:13:48.70,0:13:50.12,Default,,0,0,0,,Сіз билей аласыз ба?
Dialogue: 0,0:13:50.45,0:13:52.03,Default,,0,0,0,,Бұл маңызды ма?
Dialogue: 0,0:13:55.00,0:13:57.87,Default,,0,0,0,,Би – менің өмірім, маңызды.
Dialogue: 0,0:13:58.21,0:14:01.13,Default,,0,0,0,,Айтпақшы, кіреберіс қайда?
Dialogue: 0,0:14:04.30,0:14:05.46,Default,,0,0,0,,Жасауды ұмытып қалдым
Dialogue: 0,0:14:05.92,0:14:10.43,Default,,0,0,0,,Ішке кіре алмасақ, қалай соғысамыз?
Dialogue: 0,0:14:11.05,0:14:13.39,Default,,0,0,0,,Құлақ арқылы енгізу
Dialogue: 0,0:14:13.51,0:14:17.56,Default,,0,0,0,,Мұндай кішкентай тесікке Морттан басқа кім сыйды?
Dialogue: 0,0:14:19.31,0:14:20.27,Default,,0,0,0,,Мұнай
Dialogue: 0,0:14:20.40,0:14:21.73,Default,,0,0,0,,Морт, кел.
Dialogue: 0,0:14:25.86,0:14:27.61,Default,,0,0,0,,Орнына сырғытыңыз
Dialogue: 0,0:14:27.74,0:14:30.03,Default,,0,0,0,,Мен мұны істеп жатырмын
Dialogue: 0,0:14:30.16,0:14:32.41,Default,,0,0,0,,Жолдан кет, мен істеймін.
Dialogue: 0,0:14:35.87,0:14:37.75,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:14:37.87,0:14:40.62,Default,,0,0,0,,Робот сіздің миыңызға қосылған
Dialogue: 0,0:14:40.75,0:14:42.92,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені жасай аласыз.
Dialogue: 0,0:14:44.92,0:14:46.09,Default,,0,0,0,,«Нысана»
Dialogue: 0,0:14:46.71,0:14:48.76,Default,,0,0,0,,Фут~!
Dialogue: 0,0:14:50.89,0:14:54.81,Default,,0,0,0,,Морт, мені жерге қойшы.
Dialogue: 0,0:14:54.93,0:14:56.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:57.27,0:14:58.56,Default,,0,0,0,,Итергіштерді тұтандырыңыз
Dialogue: 0,0:15:02.77,0:15:04.06,Default,,0,0,0,,Келесі тест
Dialogue: 0,0:15:08.15,0:15:10.28,Default,,0,0,0,,Робот робот
Dialogue: 0,0:15:12.78,0:15:15.08,Default,,0,0,0,,Мен роботпын
Dialogue: 0,0:15:18.45,0:15:22.12,Default,,0,0,0,,Дұрыс істе, жау ақылды арамза.
Dialogue: 0,0:15:22.25,0:15:23.33,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:29.26,0:15:32.38,Default,,0,0,0,,Эй Морт, кеттік.
Dialogue: 0,0:15:33.76,0:15:39.48,Default,,0,0,0,,Өйткені қорқақ патша өзінің патшалық міндеттерінен қашып кетті.
Dialogue: 0,0:15:39.60,0:15:42.85,Default,,0,0,0,,Менің бұл екеуін алудан басқа амалым қалмады...
Dialogue: 0,0:15:42.98,0:15:46.57,Default,,0,0,0,,Менің ағам Ларриге арналған
Dialogue: 0,0:15:50.28,0:15:51.90,Default,,0,0,0,,Сіздің кезегіңіз, Морт.
Dialogue: 0,0:15:52.03,0:15:54.66,Default,,0,0,0,,Жолдардың сценарийін оқыңыз.
Dialogue: 0,0:15:54.78,0:15:57.95,Default,,0,0,0,,«Мені кіргіз!»
Dialogue: 0,0:15:58.08,0:15:59.45,Default,,0,0,0,,Сіздің кезегіңіз.
Dialogue: 0,0:15:59.58,0:16:00.83,Default,,0,0,0,,Иә
Dialogue: 0,0:16:01.83,0:16:03.46,Default,,0,0,0,,Сабыр сақта… Тек сабыр сақтасаң болғаны!
Dialogue: 0,0:16:03.58,0:16:09.25,Default,,0,0,0,,Күте тұрыңыз, Фрэнк, мені құрбан ет!
Dialogue: 0,0:16:11.05,0:16:13.63,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,0:16:13.76,0:16:15.68,Default,,0,0,0,,Сіз қанша жүрдіңіз?
Dialogue: 0,0:16:15.80,0:16:20.35,Default,,0,0,0,,Менің қорқынышты күшімді қараңыз.
Dialogue: 0,0:16:20.47,0:16:23.64,Default,,0,0,0,,Аспан құдайы Фрэнк бұл...
Dialogue: 0,0:16:23.94,0:16:26.73,Default,,0,0,0,,Күте тұрыңыз, Фрэнк, жоқ, Карл.
Dialogue: 0,0:16:26.86,0:16:29.61,Default,,0,0,0,,Патша, келдің бе?
Dialogue: 0,0:16:29.73,0:16:34.70,Default,,0,0,0,,Сен осындасың ба? Адамдарды тастап кетуге жол жоқ.
Dialogue: 0,0:16:34.82,0:16:40.49,Default,,0,0,0,,Мен ұлы патша болғандықтан, өзімді құрбан етемін.
Dialogue: 0,0:16:42.50,0:16:47.08,Default,,0,0,0,,Чонси Сіз күткен сәт келді.
Dialogue: 0,0:16:47.21,0:16:49.55,Default,,0,0,0,,Жеңіс жақын
Dialogue: 0,0:16:52.30,0:16:56.43,Default,,0,0,0,,Әлі ауырмайды, сондықтан жақсы. Кейінірек...
Dialogue: 0,0:16:56.80,0:16:58.68,Default,,0,0,0,,«Оны кейінірек сақтау»
Dialogue: 0,0:16:58.80,0:17:00.31,Default,,0,0,0,,Мен оны естуден шаршадым.
Dialogue: 0,0:17:02.93,0:17:04.73,Default,,0,0,0,,Ол көңілді жігіт.
Dialogue: 0,0:17:04.85,0:17:08.15,Default,,0,0,0,,Сен өлсең, мен ең сорлы адам боламын.
Dialogue: 0,0:17:08.27,0:17:11.23,Default,,0,0,0,,Ондай жақсы сөздер айтпа...
Dialogue: 0,0:17:11.40,0:17:12.99,Default,,0,0,0,,«Мені кіргіз!»
Dialogue: 0,0:17:14.70,0:17:17.57,Default,,0,0,0,,Сіз естіген жоқсыз ба?
Dialogue: 0,0:17:17.70,0:17:20.99,Default,,0,0,0,,«Мені кіргіз!»
Dialogue: 0,0:17:21.12,0:17:23.62,Default,,0,0,0,,Бір рет айтсаң, естисің.
Dialogue: 0,0:17:23.75,0:17:25.75,Default,,0,0,0,,Морт, сен не істеп жатырсың?
Dialogue: 0,0:17:25.87,0:17:27.92,Default,,0,0,0,,Мен тағы да айтамын
Dialogue: 0,0:17:28.04,0:17:31.17,Default,,0,0,0,,Тыңда, енді...
Dialogue: 0,0:17:31.30,0:17:35.76,Default,,0,0,0,,«Мені кіргізіңіз.»
Dialogue: 0,0:17:35.92,0:17:39.76,Default,,0,0,0,,«Мені кіргізіңіз.» Бәсекелестік қайда?
Dialogue: 0,0:17:39.89,0:17:41.47,Default,,0,0,0,,Патшаның белгісі!
Dialogue: 0,0:17:47.14,0:17:48.60,Default,,0,0,0,,Джулиан
Dialogue: 0,0:17:48.73,0:17:50.61,Default,,0,0,0,,Мені досыммен таныстыр
Dialogue: 0,0:17:50.73,0:17:53.65,Default,,0,0,0,,Ол ма? Мен оны бұрын ешқашан көрген емеспін
Dialogue: 0,0:17:53.78,0:17:55.28,Default,,0,0,0,,Фрэнк
Dialogue: 0,0:17:55.40,0:17:58.41,Default,,0,0,0,,Сен өз ағаңды танымайсың ба?
Dialogue: 0,0:17:59.03,0:18:01.41,Default,,0,0,0,,Фрэнк пен Ларри?
Dialogue: 0,0:18:02.45,0:18:06.37,Default,,0,0,0,,Ларри, келгеніңізге рахмет.
Dialogue: 0,0:18:06.50,0:18:09.50,Default,,0,0,0,,Мен өзімді лақтырып жібере жаздадым.
Dialogue: 0,0:18:09.63,0:18:13.80,Default,,0,0,0,,Бұған дейін бірдеңе айтқыңыз келеді ме?
Dialogue: 0,0:18:14.55,0:18:15.67,Default,,0,0,0,,Ештеңе емес пе?
Dialogue: 0,0:18:15.80,0:18:18.55,Default,,0,0,0,,Менің айтқым келгені...
Dialogue: 0,0:18:20.14,0:18:21.35,Default,,0,0,0,,«Мен...»
Dialogue: 0,0:18:23.81,0:18:27.73,Default,,0,0,0,,«Фрэнк өтірікші» немесе «Патшаны өлтірме»
Dialogue: 0,0:18:27.85,0:18:29.73,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:30.02,0:18:31.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:31.15,0:18:35.73,Default,,0,0,0,,Фрэнк өтірікші, патшаны өлтірме.
Dialogue: 0,0:18:36.28,0:18:39.28,Default,,0,0,0,,Франк - өзін кратерге лақтырған адам.
Dialogue: 0,0:18:41.16,0:18:45.16,Default,,0,0,0,,Митинг Біз не істей алатынымызды көрсетейік
Dialogue: 0,0:18:45.29,0:18:47.04,Default,,0,0,0,,Бірақ мен сізге ескертуге рұқсат етіңіз.
Dialogue: 0,0:18:47.16,0:18:51.67,Default,,0,0,0,,Фрэнкті ренжітетіндер осыдан зардап шегеді.
Dialogue: 0,0:18:54.29,0:18:56.17,Default,,0,0,0,,Тіпті осында!
Dialogue: 0,0:18:57.51,0:18:59.13,Default,,0,0,0,,Бірдей қару ма?
Dialogue: 0,0:18:59.26,0:19:01.51,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:19:08.52,0:19:11.65,Default,,0,0,0,,Түйме түймесі Мен оны басқанды жақсы көремін.
Dialogue: 0,0:19:29.83,0:19:31.12,Default,,0,0,0,,Шайқаңыз!
Dialogue: 0,0:19:34.21,0:19:38.51,Default,,0,0,0,,Балалар, қазір ойнайтын уақыт емес.
Dialogue: 0,0:19:50.18,0:19:52.06,Default,,0,0,0,,Қару-жарақпен мақтану жеткілікті
Dialogue: 0,0:19:52.39,0:19:54.02,Default,,0,0,0,,Бұл күш жарысы.
Dialogue: 0,0:19:54.65,0:19:55.61,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:08.83,0:20:11.21,Default,,0,0,0,,Сіз маған тең келмейді
Dialogue: 0,0:20:11.33,0:20:13.25,Default,,0,0,0,,Ешкім сізді тоқтата алмайды
Dialogue: 0,0:20:16.00,0:20:16.96,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:20:17.09,0:20:17.84,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:20:17.96,0:20:20.26,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:20.38,0:20:23.59,Default,,0,0,0,,Ал, Джулиан қайда?
Dialogue: 0,0:20:24.64,0:20:27.22,Default,,0,0,0,,Лава табаныңызды күйдіреді.
Dialogue: 0,0:20:27.35,0:20:28.18,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:20:28.31,0:20:32.10,Default,,0,0,0,,Аяқ жоқ!
Dialogue: 0,0:20:32.81,0:20:38.77,Default,,0,0,0,,Патшаға көмектескің келсе, алдымен мені жең.
Dialogue: 0,0:20:38.90,0:20:40.90,Default,,0,0,0,,Сол қылмыскер... қайтыс болды ма?
Dialogue: 0,0:20:42.03,0:20:42.69,Default,,0,0,0,,Йосе
Dialogue: 0,0:20:53.04,0:20:57.29,Default,,0,0,0,,Король Джулиен үшін кек!
Dialogue: 0,0:20:57.42,0:20:58.42,Default,,0,0,0,,Фрэнк!
Dialogue: 0,0:21:00.55,0:21:02.80,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:05.38,0:21:09.39,Default,,0,0,0,,Джулиан Бұл жолы сіз жеңген сияқтысыз.
Dialogue: 0,0:21:09.51,0:21:13.18,Default,,0,0,0,,Айтайын дегенім, қанша тырыссам да жеңемін.
Dialogue: 0,0:21:13.64,0:21:19.23,Default,,0,0,0,,Мен әлі шешкен жоқпын. Мен оны кейінге сақтаймын.
Dialogue: 0,0:21:19.36,0:21:21.82,Default,,0,0,0,,Баяу дауыс болса, мен де істей аламын.
Dialogue: 0,0:21:21.94,0:21:24.74,Default,,0,0,0,,«Кейін емес, қазір жасаңыз»
Dialogue: 0,0:21:26.86,0:21:27.70,Default,,0,0,0,,Тұттым сені!
Dialogue: 0,0:21:33.00,0:21:34.96,Default,,0,0,0,,Король, жақсысың ба?
Dialogue: 0,0:21:35.50,0:21:36.42,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:37.21,0:21:38.42,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:38.54,0:21:39.38,Default,,0,0,0,,Морт?
Dialogue: 0,0:21:40.00,0:21:44.92,Default,,0,0,0,,Ларри, мені магма сарайына апар.
Dialogue: 0,0:21:50.64,0:21:51.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:52.01,0:21:55.64,Default,,0,0,0,,Карл кетті, құрбандық қажет емес.
Dialogue: 0,0:21:55.77,0:21:59.48,Default,,0,0,0,,Фрэнк шынайы емес еді.
Dialogue: 0,0:22:00.02,0:22:05.49,Default,,0,0,0,,Күте тұрыңыз, мен бөксемнің ішінде бірдеңені ыстық сезінемін.
Dialogue: 0,0:22:06.74,0:22:07.61,Default,,0,0,0,,Өрт!
Dialogue: 0,0:22:07.74,0:22:09.87,Default,,0,0,0,,Жерде домалап жүру
Dialogue: 0,0:22:15.20,0:22:18.42,Default,,0,0,0,,Жаңбыр отты сөндірді.
Dialogue: 0,0:22:21.00,0:22:22.63,Default,,0,0,0,,Мен бұны ешқашан күткен емеспін...
Dialogue: 0,0:22:22.88,0:22:25.80,Default,,0,0,0,,Жоқ, мен Фрэнк деп айта алмаймын.
Dialogue: 0,0:22:25.92,0:22:31.85,Default,,0,0,0,,Егер Фрэнк бар болса, ол Морт туралы бірдеңе істеу керек.
Dialogue: 0,0:22:37.23,0:22:40.27,Default,,0,0,0,,Өйткені, Фрэнк жұмбақтарға толы.
Dialogue: 0,0:23:06.17,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Акико Комори
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
