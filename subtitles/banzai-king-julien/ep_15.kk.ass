Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:40.79,0:00:43.66,Default,,0,0,0,,«Ылғалды клуб»
Dialogue: 0,0:00:46.83,0:00:49.13,Default,,0,0,0,,Балалар, жақындаңдар
Dialogue: 0,0:00:49.25,0:00:51.67,Default,,0,0,0,,Бұл Морис ағай туралы әңгіме.
Dialogue: 0,0:00:52.46,0:00:55.84,Default,,0,0,0,,Бір кездері Мадагаскар деген жерде...
Dialogue: 0,0:00:55.97,0:00:59.22,Default,,0,0,0,,Король Юлиан XIII болған.
Dialogue: 0,0:00:59.35,0:01:02.64,Default,,0,0,0,,Оның белгілі бір мәселесі болды.
Dialogue: 0,0:01:02.77,0:01:05.02,Default,,0,0,0,,Артында қалдыратын мұра жоқ!
Dialogue: 0,0:01:05.56,0:01:07.48,Default,,0,0,0,,Өлген соң ұмытыласың.
Dialogue: 0,0:01:07.60,0:01:09.40,Default,,0,0,0,,«Сіз кімсіз?» «Мен білмеймін.»
Dialogue: 0,0:01:09.52,0:01:11.02,Default,,0,0,0,,«Мен оны бұрын ешқашан көрген емеспін»
Dialogue: 0,0:01:11.15,0:01:12.78,Default,,0,0,0,,«Бірақ әдемі».
Dialogue: 0,0:01:12.90,0:01:14.03,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:01:14.15,0:01:15.11,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:01:15.24,0:01:18.07,Default,,0,0,0,,Көптеген мұралар бар.
Dialogue: 0,0:01:18.20,0:01:18.95,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:01:19.53,0:01:20.28,Default,,0,0,0,,Батут
Dialogue: 0,0:01:20.41,0:01:22.37,Default,,0,0,0,,Патшалықтың көңілін көтерді
Dialogue: 0,0:01:22.49,0:01:26.58,Default,,0,0,0,,Менің мұрам циркпен бірдей ме?
Dialogue: 0,0:01:26.71,0:01:31.50,Default,,0,0,0,,Жарайды, патша өлсе де, аяғы өмір сүре береді.
Dialogue: 0,0:01:31.63,0:01:33.80,Default,,0,0,0,,Мен де дисплей қорабын жасадым.
Dialogue: 0,0:01:33.92,0:01:35.13,Default,,0,0,0,,Морт, келме.
Dialogue: 0,0:01:36.09,0:01:38.84,Default,,0,0,0,,Жәшік ішіндегі мата барқыт па?
Dialogue: 0,0:01:38.97,0:01:40.09,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:01:40.22,0:01:41.81,Default,,0,0,0,,Бірақ бұл қорқынышты
Dialogue: 0,0:01:44.02,0:01:46.77,Default,,0,0,0,,Жақсы патша мұра қалдырады.
Dialogue: 0,0:01:46.89,0:01:51.73,Default,,0,0,0,,Мысалы, «Julien Cleanse» - жақсы иісі бар сабын.
Dialogue: 0,0:01:53.19,0:01:56.19,Default,,0,0,0,,Еттің иісі? Таконың иісі?
Dialogue: 0,0:01:57.45,0:01:58.32,Default,,0,0,0,,Тако.
Dialogue: 0,0:01:58.66,0:02:00.07,Default,,0,0,0,,Қорқынышты мұра
Dialogue: 0,0:02:00.20,0:02:01.78,Default,,0,0,0,,Әлі де мұра
Dialogue: 0,0:02:01.91,0:02:03.58,Default,,0,0,0,,Бүгіннен бастап-
Dialogue: 0,0:02:03.70,0:02:07.83,Default,,0,0,0,,«Жылжымайтын мүлікті жоспарлауды» жүзеге асыру туралы шешім қабылдау
Dialogue: 0,0:02:07.96,0:02:12.42,Default,,0,0,0,,Егер KJ Seal мұрасы ұмытылмас әсер қалдырса...
Dialogue: 0,0:02:12.54,0:02:15.21,Default,,0,0,0,,Ешқашан ұмытылмайды
Dialogue: 0,0:02:15.34,0:02:18.59,Default,,0,0,0,,Барлығына орын жасаңыз
Dialogue: 0,0:02:18.72,0:02:21.89,Default,,0,0,0,,Мазасыз жігіттер жоқ.
Dialogue: 0,0:02:22.01,0:02:25.85,Default,,0,0,0,,Көптен күткен аурухананы саласыз ба?
Dialogue: 0,0:02:25.97,0:02:28.73,Default,,0,0,0,,Дұрыс, үйірме аш.
Dialogue: 0,0:02:28.85,0:02:30.90,Default,,0,0,0,,«Ылғалды клуб»
Dialogue: 0,0:02:31.15,0:02:33.57,Default,,0,0,0,,«Ылғалды клуб»
Dialogue: 0,0:02:34.07,0:02:35.44,Default,,0,0,0,,Ылғалды клуб?
Dialogue: 0,0:02:35.57,0:02:37.90,Default,,0,0,0,,Иә, отшашуды көрдіңіз бе?
Dialogue: 0,0:02:38.03,0:02:42.12,Default,,0,0,0,,Мұра дегеніміз не? Бұл бәріне пайдалы нәрсе емес пе?
Dialogue: 0,0:02:42.82,0:02:47.41,Default,,0,0,0,,KJ Seiji музыкасына бөксеңізді шайқаңыз.
Dialogue: 0,0:02:47.54,0:02:51.79,Default,,0,0,0,,KJ белгісі бар тағамды жеу пайдалы болады.
Dialogue: 0,0:02:51.92,0:02:54.96,Default,,0,0,0,,Спортпен шұғылданыңыз, дұрыс тамақтаныңыз және қайтадан жаттығу жасаңыз...
Dialogue: 0,0:02:55.09,0:02:57.38,Default,,0,0,0,,Ұлттық қазына сапасында бірдеңе жасаңыз
Dialogue: 0,0:02:57.59,0:03:02.43,Default,,0,0,0,,Бұл сіз Робпен жұмыс істеген кезде ойлап тапқан идея болды, солай ма?
Dialogue: 0,0:03:02.80,0:03:04.26,Default,,0,0,0,,Мен қыздарды жақсы көремін (LLTLL)
Dialogue: 0,0:03:04.64,0:03:09.39,Default,,0,0,0,,Бірақ Роб дәл қазір қорқынышты, сондықтан мен бұл идеяны ұрлап алдым.
Dialogue: 0,0:03:09.52,0:03:10.73,Default,,0,0,0,,Бұл заңды.
Dialogue: 0,0:03:12.15,0:03:12.81,Default,,0,0,0,,Келесі!
Dialogue: 0,0:03:14.19,0:03:18.78,Default,,0,0,0,,Вилли, мен тұтынушыларды қалай тарту керектігін білгім келеді.
Dialogue: 0,0:03:18.90,0:03:19.78,Default,,0,0,0,,Ләззат алайық
Dialogue: 0,0:03:20.49,0:03:21.78,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:21.91,0:03:24.32,Default,,0,0,0,,Мен күлкілі әңгіме жасаймын
Dialogue: 0,0:03:24.45,0:03:27.66,Default,,0,0,0,,Жақсы, күлкі - ең жақсы сыйлық.
Dialogue: 0,0:03:27.87,0:03:32.29,Default,,0,0,0,,Манго жеу үшін неше қолтырауын қажет?
Dialogue: 0,0:03:33.96,0:03:35.88,Default,,0,0,0,,Бұл күлкілі!
Dialogue: 0,0:03:36.63,0:03:38.05,Default,,0,0,0,,Қандай данышпан.
Dialogue: 0,0:03:38.17,0:03:40.55,Default,,0,0,0,,Мен сізге әзірге түйіндемені айтқан жоқпын.
Dialogue: 0,0:03:40.67,0:03:41.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:41.72,0:03:44.68,Default,,0,0,0,,Персонал сызығы Moist Next сияқты емес!
Dialogue: 0,0:03:46.01,0:03:46.72,Default,,0,0,0,,Патша…
Dialogue: 0,0:03:46.85,0:03:48.72,Default,,0,0,0,,бастайық.
Dialogue: 0,0:03:48.85,0:03:52.73,Default,,0,0,0,,Жарайды, мен саған нақты нәрсені көрсетемін.
Dialogue: 0,0:03:52.98,0:03:53.65,Default,,0,0,0,,Тодд!
Dialogue: 0,0:03:54.77,0:03:56.52,Default,,0,0,0,,Шық!
Dialogue: 0,0:03:56.65,0:04:00.61,Default,,0,0,0,,Жетер, мен Тоддты құрметтеймін.
Dialogue: 0,0:04:00.74,0:04:04.28,Default,,0,0,0,,Анам ылғалдандырғышқа ұқсамайды Келесі!
Dialogue: 0,0:04:04.41,0:04:09.29,Default,,0,0,0,,Тед және оның музыкалық құйрығымен таныстыру
Dialogue: 0,0:04:20.51,0:04:22.01,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:22.13,0:04:24.80,Default,,0,0,0,,Мен сізге көп су құймаңыз дедім.
Dialogue: 0,0:04:24.93,0:04:27.47,Default,,0,0,0,,Тезірек құйрығыңызды сулаңыз!
Dialogue: 0,0:04:30.14,0:04:31.89,Default,,0,0,0,,Ылғалдандырғыш сияқты емес!
Dialogue: 0,0:04:32.39,0:04:34.35,Default,,0,0,0,,Кептірсеңіз жақсы.
Dialogue: 0,0:04:34.48,0:04:37.27,Default,,0,0,0,,Қолдарың неге үлкен емес?
Dialogue: 0,0:04:37.52,0:04:38.36,Default,,0,0,0,,Беде
Dialogue: 0,0:04:38.98,0:04:40.44,Default,,0,0,0,,...
Dialogue: 0,0:04:40.57,0:04:43.32,Default,,0,0,0,,Бұл әуесқойлық емес, мұра.
Dialogue: 0,0:04:43.44,0:04:45.78,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:04:45.91,0:04:49.20,Default,,0,0,0,,Клубтарға жұлдыздар керек
Dialogue: 0,0:04:49.33,0:04:50.83,Default,,0,0,0,,Сонымен клуб...
Dialogue: 0,0:04:50.95,0:04:53.37,Default,,0,0,0,,Мен біртүрлімін бе?
Dialogue: 0,0:04:54.46,0:04:57.00,Default,,0,0,0,,Өйткені мен өте ақылсызмын
Dialogue: 0,0:04:57.13,0:04:58.13,Default,,0,0,0,,Ылғалды!
Dialogue: 0,0:04:58.25,0:05:00.50,Default,,0,0,0,,Сізге
Dialogue: 0,0:05:01.46,0:05:02.67,Default,,0,0,0,,Бұл дауыс...
Dialogue: 0,0:05:02.80,0:05:07.22,Default,,0,0,0,,Екі періште дауыс ұштарын ысқылағандай.
Dialogue: 0,0:05:07.34,0:05:08.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:08.14,0:05:11.14,Default,,0,0,0,,Мен сенің махаббатыңды алғым келеді
Dialogue: 0,0:05:11.26,0:05:12.93,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:05:13.27,0:05:14.02,Default,,0,0,0,,Морт?
Dialogue: 0,0:05:14.14,0:05:16.48,Default,,0,0,0,,Аяқтарың еріп жатыр
Dialogue: 0,0:05:16.81,0:05:18.90,Default,,0,0,0,,Би
Dialogue: 0,0:05:19.94,0:05:22.94,Default,,0,0,0,,Бөкседе ұшқындар атылды
Dialogue: 0,0:05:23.07,0:05:26.20,Default,,0,0,0,,Сондықтан мен секіремін, ән айтамын, айқайлаймын
Dialogue: 0,0:05:27.07,0:05:28.78,Default,,0,0,0,,Морт...
Dialogue: 0,0:05:28.91,0:05:30.41,Default,,0,0,0,,Ылғал тәрізді
Dialogue: 0,0:05:31.33,0:05:33.08,Default,,0,0,0,,Оны бәрі жақсы көреді
Dialogue: 0,0:05:33.20,0:05:34.41,Default,,0,0,0,,Музыканы тоқтату
Dialogue: 0,0:05:35.66,0:05:37.37,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:05:37.50,0:05:38.46,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:05:38.58,0:05:40.67,Default,,0,0,0,,Мұндай кездерде бұл қалыпты жағдай, солай емес пе?
Dialogue: 0,0:05:40.79,0:05:42.67,Default,,0,0,0,,Морт
Dialogue: 0,0:05:43.42,0:05:45.01,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:05:45.13,0:05:49.59,Default,,0,0,0,,Жұлдызға жарқыраған атау керек
Dialogue: 0,0:05:49.72,0:05:51.60,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:05:51.72,0:05:56.23,Default,,0,0,0,,"Назар аудар! Маған қара! Өтінемін"
Dialogue: 0,0:05:56.64,0:05:59.77,Default,,0,0,0,,Мен сенің атыңды ойлап таптым-
Dialogue: 0,0:06:00.10,0:06:00.86,Default,,0,0,0,,«Шошқа еті»
Dialogue: 0,0:06:00.98,0:06:04.23,Default,,0,0,0,,Иә! Бұл лас шошқа еті.
Dialogue: 0,0:06:05.32,0:06:06.99,Default,,0,0,0,,Киінетін бөлмеде дайындал.
Dialogue: 0,0:06:07.11,0:06:11.57,Default,,0,0,0,,Біз ашқанша дәмді шошқа етін аламыз.
Dialogue: 0,0:06:12.33,0:06:13.87,Default,,0,0,0,,Ауызша сөз таралады―
Dialogue: 0,0:06:13.99,0:06:18.66,Default,,0,0,0,,Клуб Мадагаскардағы танымал мекемеге айналды.
Dialogue: 0,0:06:30.22,0:06:33.14,Default,,0,0,0,,Қонақтарды бірінші дәрежелі шоу қызықтырады
Dialogue: 0,0:06:38.94,0:06:42.73,Default,,0,0,0,,Бірақ барлығының шынымен де қалайтыны...
Dialogue: 0,0:06:43.15,0:06:44.11,Default,,0,0,0,,Шошқа еті
Dialogue: 0,0:06:44.90,0:06:47.15,Default,,0,0,0,,үлкен үлкен махаббат саусақтары
Dialogue: 0,0:06:47.28,0:06:49.90,Default,,0,0,0,,Аяғыңызды сүйсеңіз, қызғылт
Dialogue: 0,0:06:50.03,0:06:52.12,Default,,0,0,0,,Тіпті жүгері менің сүйікті тағамым.
Dialogue: 0,0:06:52.24,0:06:54.66,Default,,0,0,0,,Сасық саусақтар жақсы
Dialogue: 0,0:06:54.78,0:06:57.12,Default,,0,0,0,,үлкен үлкен махаббат саусақтары
Dialogue: 0,0:06:57.25,0:06:59.54,Default,,0,0,0,,Аяғыңызды сүйсеңіз, қызғылт
Dialogue: 0,0:06:59.66,0:07:02.08,Default,,0,0,0,,Көзімді жұмсам да ұйықтай алмаймын
Dialogue: 0,0:07:02.21,0:07:05.29,Default,,0,0,0,,Өйткені аяғың қағып жатыр
Dialogue: 0,0:07:06.80,0:07:07.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:09.30,0:07:12.18,Default,,0,0,0,,Етке толтыру
Dialogue: 0,0:07:12.30,0:07:16.51,Default,,0,0,0,,Қонақтар Морттың талантына баурап алды.
Dialogue: 0,0:07:16.64,0:07:19.48,Default,,0,0,0,,Кинг мұрасы сәтті болды, бірақ...
Dialogue: 0,0:07:19.60,0:07:22.81,Default,,0,0,0,,Өкінішке орай, бұл ұзаққа созылмады.
Dialogue: 0,0:07:22.94,0:07:25.61,Default,,0,0,0,,Түсіп мені тұмсығыңмен ұр.
Dialogue: 0,0:07:27.57,0:07:29.15,Default,,0,0,0,,...
Dialogue: 0,0:07:29.28,0:07:33.53,Default,,0,0,0,,Суретшілерге тыныштық керек!
Dialogue: 0,0:07:40.37,0:07:42.96,Default,,0,0,0,,Танымалдығыңызды қазір ләззат алыңыз
Dialogue: 0,0:07:43.08,0:07:45.17,Default,,0,0,0,,Ол жақын арада жоғалады
Dialogue: 0,0:07:45.29,0:07:46.96,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:07:47.09,0:07:51.09,Default,,0,0,0,,Бұл құпия сурет. Артында тас баспалдақ бар.
Dialogue: 0,0:07:51.22,0:07:54.18,Default,,0,0,0,,Жер асты қорымына дейін жалғасады
Dialogue: 0,0:07:54.30,0:07:56.14,Default,,0,0,0,,Ешкімге айтпа
Dialogue: 0,0:07:56.43,0:07:57.51,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:57.64,0:08:00.64,Default,,0,0,0,,Патша сізді пайдаланып жатыр.
Dialogue: 0,0:08:00.77,0:08:02.06,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:08:02.44,0:08:07.57,Default,,0,0,0,,Ол өзімшіл, жолына түскендерге аямайды.
Dialogue: 0,0:08:07.69,0:08:10.74,Default,,0,0,0,,Менің патшам туралы жаман сөз айтпа
Dialogue: 0,0:08:10.86,0:08:12.53,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:08:12.65,0:08:14.03,Default,,0,0,0,,Оны осылай атаңыз.
Dialogue: 0,0:08:14.20,0:08:18.12,Default,,0,0,0,,«Клуб ылғалды құбыжық»
Dialogue: 0,0:08:19.16,0:08:20.37,Default,,0,0,0,,Керемет емес
Dialogue: 0,0:08:20.79,0:08:22.29,Default,,0,0,0,,Бірақ оны қазір анаға көрсетпе.
Dialogue: 0,0:08:27.67,0:08:29.21,Default,,0,0,0,,Бәріне сәлем
Dialogue: 0,0:08:29.34,0:08:32.51,Default,,0,0,0,,Бұл менің досым Король Джулиен.
Dialogue: 0,0:08:32.76,0:08:34.34,Default,,0,0,0,,Патшаның сәлемі
Dialogue: 0,0:08:34.47,0:08:37.26,Default,,0,0,0,,«Патшаның бұған уақыты жоқ».
Dialogue: 0,0:08:37.39,0:08:40.64,Default,,0,0,0,,«Семіз Морис жасай берсін».
Dialogue: 0,0:08:44.10,0:08:47.56,Default,,0,0,0,,Менде ананастың басы бар.
Dialogue: 0,0:08:47.69,0:08:49.98,Default,,0,0,0,,Сізді күлдіреді.
Dialogue: 0,0:08:50.11,0:08:53.69,Default,,0,0,0,,Күлетіні маған ұқсайтын қуыршақ.
Dialogue: 0,0:08:53.82,0:08:57.62,Default,,0,0,0,,Кингтің кезегі, бірақ Морт жоқ
Dialogue: 0,0:08:57.95,0:09:03.00,Default,,0,0,0,,Менің мұрамды бұзсаң, боссың...
Dialogue: 0,0:09:03.12,0:09:05.00,Default,,0,0,0,,Шошқа еті! шошқа еті!
Dialogue: 0,0:09:07.88,0:09:09.84,Default,,0,0,0,,Сіздің кезегіңіз. Не істеу керек?
Dialogue: 0,0:09:09.96,0:09:12.26,Default,,0,0,0,,Мен сізге не істеу керектігін айтамын
Dialogue: 0,0:09:12.38,0:09:16.43,Default,,0,0,0,,Ән айту, би билеу кәсіби деңгейдегі балаларды шығарады.
Dialogue: 0,0:09:16.55,0:09:17.47,Default,,0,0,0,,Тодд!
Dialogue: 0,0:09:17.97,0:09:21.39,Default,,0,0,0,,Бірінші дәрежелі дағдыларыңызды көрсетіңіз
Dialogue: 0,0:09:21.51,0:09:25.48,Default,,0,0,0,,Кловер, кел, анау ананы тоқтат...
Dialogue: 0,0:09:25.81,0:09:28.52,Default,,0,0,0,,Патша, мен сені іздедім.
Dialogue: 0,0:09:28.65,0:09:31.57,Default,,0,0,0,,Құттықтаймыз! Жүр, мұнда кел.
Dialogue: 0,0:09:32.15,0:09:33.48,Default,,0,0,0,,Баршаңызға қайырлы кеш
Dialogue: 0,0:09:33.82,0:09:38.41,Default,,0,0,0,,Бүгін түнде шошқа етінің орнына менің балам беріледі.
Dialogue: 0,0:09:40.37,0:09:43.29,Default,,0,0,0,,Мен ерке баламын
Dialogue: 0,0:09:43.58,0:09:44.58,Default,,0,0,0,,Анашым!
Dialogue: 0,0:09:45.16,0:09:46.08,Default,,0,0,0,,Тодд!
Dialogue: 0,0:09:46.29,0:09:49.50,Default,,0,0,0,,Балам! Асыраушы болса да
Dialogue: 0,0:09:54.09,0:09:56.01,Default,,0,0,0,,Үңгірден шығыңыз
Dialogue: 0,0:09:56.42,0:10:01.39,Default,,0,0,0,,Әйтпесе, құбыжық бәріңді өлтіреді.
Dialogue: 0,0:10:03.51,0:10:06.18,Default,,0,0,0,,Егер сіз клубтан шықсаңыз...
Dialogue: 0,0:10:06.31,0:10:08.56,Default,,0,0,0,,Ешқандай апат болған жоқ
Dialogue: 0,0:10:08.69,0:10:13.73,Default,,0,0,0,,Бірақ клуб корольдің мұрасы және ол оңайлықпен жойылмайды.
Dialogue: 0,0:10:13.86,0:10:17.36,Default,,0,0,0,,Тіпті қорқынышты нәрсе болса да
Dialogue: 0,0:10:17.49,0:10:18.99,Default,,0,0,0,,Енді жалғастырыңыз.
Dialogue: 0,0:10:20.53,0:10:23.58,Default,,0,0,0,,Менің клубым бұзылды.
Dialogue: 0,0:10:23.70,0:10:25.20,Default,,0,0,0,,Жақсырақ, Тодд.
Dialogue: 0,0:10:25.70,0:10:28.37,Default,,0,0,0,,Бейшараның сүйегі сынған.
Dialogue: 0,0:10:28.50,0:10:29.62,Default,,0,0,0,,Ал, көзіңді жұм.
Dialogue: 0,0:10:29.75,0:10:31.21,Default,,0,0,0,,Сіз абдырап қалдыңыз.
Dialogue: 0,0:10:31.33,0:10:33.46,Default,,0,0,0,,Заңгермен сөйлесу
Dialogue: 0,0:10:33.71,0:10:35.21,Default,,0,0,0,,Тэмми Мен не айтайын...
Dialogue: 0,0:10:35.34,0:10:36.63,Default,,0,0,0,,Мен сөйлеймін
Dialogue: 0,0:10:36.88,0:10:38.63,Default,,0,0,0,,Үстіңе тас құласа...
Dialogue: 0,0:10:38.76,0:10:41.76,Default,,0,0,0,,Сахна кері серпілгенде бұзылмады.
Dialogue: 0,0:10:42.01,0:10:42.97,Default,,0,0,0,,Патша!
Dialogue: 0,0:10:43.10,0:10:46.97,Default,,0,0,0,,Мен байсалды емеспін. Тоддқа біраз ем беріңіз...
Dialogue: 0,0:10:47.10,0:10:50.06,Default,,0,0,0,,Өзіңізді патшалықтағы ең жақсы дәрігер ретінде көрсетіңіз
Dialogue: 0,0:10:50.19,0:10:51.73,Default,,0,0,0,,Себебі мен сені құрметтеймін.
Dialogue: 0,0:10:52.98,0:10:55.32,Default,,0,0,0,,Патшалықта дәрігерлер жоқ.
Dialogue: 0,0:10:55.44,0:10:56.90,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:10:57.03,0:10:59.70,Default,,0,0,0,,Бала сені алдайды.
Dialogue: 0,0:11:00.11,0:11:02.24,Default,,0,0,0,,Дәрігер жақында келеді.
Dialogue: 0,0:11:02.82,0:11:06.41,Default,,0,0,0,,Мен құбыжық пен Мортты іздедім.
Dialogue: 0,0:11:06.66,0:11:08.66,Default,,0,0,0,,Бейшара Морт
Dialogue: 0,0:11:09.21,0:11:11.25,Default,,0,0,0,,Оны құбыжық жеп қойды
Dialogue: 0,0:11:12.50,0:11:13.25,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:11:13.63,0:11:14.34,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:11:14.46,0:11:18.88,Default,,0,0,0,,Құбыжықтың не жейтінін білу сенің міндетің.
Dialogue: 0,0:11:18.96,0:11:19.97,Default,,0,0,0,,Жер
Dialogue: 0,0:11:20.09,0:11:23.39,Default,,0,0,0,,Роб Кингтен кек алуға келді ме?
Dialogue: 0,0:11:23.51,0:11:26.89,Default,,0,0,0,,Ақымақ Роб құбыжыққа ұқсамайды.
Dialogue: 0,0:11:27.31,0:11:28.18,Default,,0,0,0,,Маска...
Dialogue: 0,0:11:28.47,0:11:33.35,Default,,0,0,0,,Роб бетперде кимейді, сондықтан құбыжық Роб емес.
Dialogue: 0,0:11:33.48,0:11:35.48,Default,,0,0,0,,Джиги Брондауымнан қалай бас тартуға болады?
Dialogue: 0,0:11:36.77,0:11:37.65,Default,,0,0,0,,Барлығы
Dialogue: 0,0:11:44.57,0:11:46.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:46.58,0:11:49.79,Default,,0,0,0,,Клубты мұраға алуға болмайды
Dialogue: 0,0:11:49.91,0:11:50.91,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:51.04,0:11:54.54,Default,,0,0,0,,Сіз клубтар қазір өлді деп ойлайсыз, солай ма?
Dialogue: 0,0:11:54.75,0:11:56.21,Default,,0,0,0,,Дұрыс емес.
Dialogue: 0,0:11:56.34,0:12:01.47,Default,,0,0,0,,Алға қарай білу қабілеті бар, армандарынан ешқашан бас тартпайтындар...
Dialogue: 0,0:12:01.59,0:12:04.34,Default,,0,0,0,,Мұндай қиыншылықтан көңілім түсе алмаймын.
Dialogue: 0,0:12:04.47,0:12:05.26,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:12:06.39,0:12:07.47,Default,,0,0,0,,Үлкен мәселе емес
Dialogue: 0,0:12:07.97,0:12:10.31,Default,,0,0,0,,Қайтару матчтарына рұқсат етілмейді.
Dialogue: 0,0:12:10.77,0:12:12.14,Default,,0,0,0,,Мен жынды болдым
Dialogue: 0,0:12:12.27,0:12:13.14,Default,,0,0,0,,Бұл тыныштандыратын дәрі.
Dialogue: 0,0:12:13.27,0:12:15.40,Default,,0,0,0,,Джижи Дәріні түсіретін жебе
Dialogue: 0,0:12:15.52,0:12:19.53,Default,,0,0,0,,Дәрі-дәрмекті және жебелерді кеш аяқталғанша сақтаңыз.
Dialogue: 0,0:12:19.65,0:12:22.40,Default,,0,0,0,,Бұл апаттан не үйрендік
Dialogue: 0,0:12:22.53,0:12:24.53,Default,,0,0,0,,Бас тарту маңызды ма?
Dialogue: 0,0:12:24.66,0:12:26.16,Default,,0,0,0,,Иә... жоқ!
Dialogue: 0,0:12:26.57,0:12:30.20,Default,,0,0,0,,Түбі сау болса, ойың болса...
Dialogue: 0,0:12:30.33,0:12:32.96,Default,,0,0,0,,Үміт бар.
Dialogue: 0,0:12:33.46,0:12:37.75,Default,,0,0,0,,Мен клубты тастамаймын. Құбыжықты блять.
Dialogue: 0,0:12:38.17,0:12:40.05,Default,,0,0,0,,Джиджи, жарнамалау.
Dialogue: 0,0:12:40.17,0:12:42.47,Default,,0,0,0,,«Клуб үлкейеді»
Dialogue: 0,0:12:42.59,0:12:44.68,Default,,0,0,0,,«Барлығыңыз келіңіздер»
Dialogue: 0,0:12:45.05,0:12:45.72,Default,,0,0,0,,Беде
Dialogue: 0,0:12:45.84,0:12:46.59,Default,,0,0,0,,Иә
Dialogue: 0,0:12:46.72,0:12:50.51,Default,,0,0,0,,Құбыжық қайта пайда болған жағдайда дайын болғым келеді.
Dialogue: 0,0:12:50.64,0:12:54.23,Default,,0,0,0,,Сізді де қорқытатын тұзақ қойыңыз.
Dialogue: 0,0:12:54.35,0:12:56.02,Default,,0,0,0,,Ол өте қауіпті.
Dialogue: 0,0:12:56.15,0:12:57.90,Default,,0,0,0,,Барынша тырысыңыз
Dialogue: 0,0:12:58.02,0:13:00.15,Default,,0,0,0,,Мен осындай нәрсені армандадым
Dialogue: 0,0:13:00.40,0:13:02.15,Default,,0,0,0,,Оның шындыққа айналатынына сене алмаймын
Dialogue: 0,0:13:02.53,0:13:06.07,Default,,0,0,0,,Мен тірі алаяқты қолданғым келеді.
Dialogue: 0,0:13:06.20,0:13:09.70,Default,,0,0,0,,Алаяқтар туралы айтатын болсақ, бұл әдетте Морт.
Dialogue: 0,0:13:09.83,0:13:11.16,Default,,0,0,0,,Себебі мен оны жей алдым...
Dialogue: 0,0:13:11.29,0:13:11.95,Default,,0,0,0,,Белгісіз
Dialogue: 0,0:13:12.08,0:13:15.75,Default,,0,0,0,,Қармақ болып, сахнада тұрамын.
Dialogue: 0,0:13:16.21,0:13:16.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:16.92,0:13:18.38,Default,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:13:18.50,0:13:20.50,Default,,0,0,0,,Мен рұқсат сұраймын.
Dialogue: 0,0:13:20.63,0:13:22.21,Default,,0,0,0,,Мен тәуекелдерді түсінемін.
Dialogue: 0,0:13:22.34,0:13:24.92,Default,,0,0,0,,Мен шешіп қойдым, бітті.
Dialogue: 0,0:13:38.65,0:13:42.19,Default,,0,0,0,,Ал кеттік, клуб балалары!
Dialogue: 0,0:13:42.94,0:13:45.11,Default,,0,0,0,,Біз өлмейміз!
Dialogue: 0,0:13:47.66,0:13:50.32,Default,,0,0,0,,Денем қызып барады.
Dialogue: 0,0:13:50.45,0:13:53.74,Default,,0,0,0,,Бүгінгі кеш өте қызықты болады.
Dialogue: 0,0:13:53.87,0:13:55.96,Default,,0,0,0,,Мен мұны тағы бір рет айтамын ...
Dialogue: 0,0:13:56.29,0:13:59.46,Default,,0,0,0,,Патшаның алаяқ болғаны жақсы емес.
Dialogue: 0,0:13:59.58,0:14:01.17,Default,,0,0,0,,Мазасыздықтар қабылданбады
Dialogue: 0,0:14:01.29,0:14:05.34,Default,,0,0,0,,Мен мұқият тұзақ құрдым.
Dialogue: 0,0:14:05.46,0:14:08.01,Default,,0,0,0,,Үлкен тас Көп жыландар
Dialogue: 0,0:14:08.13,0:14:11.47,Default,,0,0,0,,Пышақ отын ағызатын қаһарлы құс қышқылды бассейні
Dialogue: 0,0:14:11.60,0:14:13.89,Default,,0,0,0,,Қорқынышты заттардың жиынтығы.
Dialogue: 0,0:14:14.01,0:14:17.73,Default,,0,0,0,,Егер сіз тұзаққа түспесеңіз -
Dialogue: 0,0:14:17.85,0:14:20.98,Default,,0,0,0,,Дәретханада акула да бар.
Dialogue: 0,0:14:23.86,0:14:26.69,Default,,0,0,0,,Дәретханада акула бар! О, құдайым
Dialogue: 0,0:14:27.11,0:14:31.62,Default,,0,0,0,,Кловер, сен шынымен ақылсыз тұзақ құрдың.
Dialogue: 0,0:14:32.53,0:14:35.24,Default,,0,0,0,,Тапсырма орындалды
Dialogue: 0,0:14:35.37,0:14:40.08,Default,,0,0,0,,Бүгін түнгі орындар сатылды. Біздің қалай өткенімізді білгіңіз келе ме?
Dialogue: 0,0:14:40.96,0:14:42.13,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:14:42.96,0:14:45.09,Default,,0,0,0,,Онда мен ұйықтайын.
Dialogue: 0,0:14:46.01,0:14:47.67,Default,,0,0,0,,Бүгін кешке толы.
Dialogue: 0,0:14:47.97,0:14:50.01,Default,,0,0,0,,Көрмені бастайық
Dialogue: 0,0:14:57.60,0:15:01.23,Default,,0,0,0,,Сюзи апа теңізді көру үшін теңізге барды.
Dialogue: 0,0:15:01.35,0:15:02.77,Default,,0,0,0,,Теңіз салқын болды
Dialogue: 0,0:15:02.90,0:15:03.73,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:07.03,0:15:09.07,Default,,0,0,0,,Мадагаскардағы барлық адамдар
Dialogue: 0,0:15:09.32,0:15:13.32,Default,,0,0,0,,Таңқаларлықтай керемет адам пайда болады.
Dialogue: 0,0:15:13.66,0:15:15.49,Default,,0,0,0,,Король Джульен!
Dialogue: 0,0:15:22.42,0:15:23.13,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:23.75,0:15:25.92,Default,,0,0,0,,«Ылғалды клуб» -
Dialogue: 0,0:15:26.05,0:15:30.01,Default,,0,0,0,,Бала кезімнен бала арманы.
Dialogue: 0,0:15:30.13,0:15:32.51,Default,,0,0,0,,Құбыжық қақпанға түсе ме?
Dialogue: 0,0:15:33.01,0:15:36.06,Default,,0,0,0,,Ол көрінбейтін болып қалмаса.
Dialogue: 0,0:15:36.18,0:15:36.85,Default,,0,0,0,,Бұл танымал ма?
Dialogue: 0,0:15:38.64,0:15:40.18,Default,,0,0,0,,Ток сөніп қалса ше?
Dialogue: 0,0:15:41.19,0:15:41.94,Default,,0,0,0,,Қараңғы!
Dialogue: 0,0:15:42.06,0:15:43.27,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:15:46.86,0:15:49.99,Default,,0,0,0,,Сіздің сусыныңызда қышқыл бар!
Dialogue: 0,0:15:50.36,0:15:53.74,Default,,0,0,0,,Бетімді құс жеп жатқан сияқты!
Dialogue: 0,0:15:53.86,0:15:55.03,Default,,0,0,0,,Барлығы өледі...
Dialogue: 0,0:15:55.87,0:15:57.58,Default,,0,0,0,,Барлығың тынышталыңдар.
Dialogue: 0,0:16:05.75,0:16:07.84,Default,,0,0,0,,Король... жоқ!
Dialogue: 0,0:16:08.71,0:16:12.05,Default,,0,0,0,,Содан бері Кингті ешкім көрмеді.
Dialogue: 0,0:16:12.17,0:16:13.30,Default,,0,0,0,,Мені шабуылдады дегені —
Dialogue: 0,0:16:15.30,0:16:16.60,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:16:16.72,0:16:21.43,Default,,0,0,0,,Дайынсың ба? Бұл оқиғалардың керемет бұрылысы болады
Dialogue: 0,0:16:24.06,0:16:25.56,Default,,0,0,0,,Король қауіпсіз
Dialogue: 0,0:16:25.69,0:16:28.27,Default,,0,0,0,,Шамдарды өшіру күтпеген жағдай.
Dialogue: 0,0:16:28.48,0:16:30.44,Default,,0,0,0,,Күту керек
Dialogue: 0,0:16:33.49,0:16:35.61,Default,,0,0,0,,Кешіріңіз, мен жыламаймын.
Dialogue: 0,0:16:35.95,0:16:38.16,Default,,0,0,0,,Король кетті
Dialogue: 0,0:16:38.28,0:16:41.04,Default,,0,0,0,,Менің дауысымды енді естімейсің бе?
Dialogue: 0,0:16:42.66,0:16:45.75,Default,,0,0,0,,«Су сырғанағына барайық»
Dialogue: 0,0:16:46.13,0:16:47.58,Default,,0,0,0,,Бұрынғы дауыс...
Dialogue: 0,0:16:47.71,0:16:49.50,Default,,0,0,0,,​​Маған көмектес!
Dialogue: 0,0:16:56.39,0:16:58.18,Default,,0,0,0,,​​Маған көмектес!
Dialogue: 0,0:16:58.30,0:16:59.26,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:00.72,0:17:01.47,Default,,0,0,0,,Морт!
Dialogue: 0,0:17:01.60,0:17:03.14,Default,,0,0,0,,Ол жеді ме?
Dialogue: 0,0:17:03.68,0:17:05.48,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:05.60,0:17:06.27,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:06.52,0:17:07.60,Default,,0,0,0,,Ол құбыжық.
Dialogue: 0,0:17:07.73,0:17:12.03,Default,,0,0,0,,Мен сені шошқа етін жейтін адам деп ойладым...
Dialogue: 0,0:17:13.57,0:17:15.45,Default,,0,0,0,,Менің патшам қайда?
Dialogue: 0,0:17:15.57,0:17:18.45,Default,,0,0,0,,Құбыжық сені қайда апарды?
Dialogue: 0,0:17:18.57,0:17:19.24,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:17:19.37,0:17:22.83,Default,,0,0,0,,Ойлан, Морт патша қауіпті.
Dialogue: 0,0:17:22.95,0:17:26.96,Default,,0,0,0,,Құбыжық сол құпия суреттен шыққан дейді.
Dialogue: 0,0:17:27.08,0:17:31.96,Default,,0,0,0,,Артыңызда сізді жерасты зиратына апаратын баспалдақтар бар.
Dialogue: 0,0:17:32.67,0:17:34.13,Default,,0,0,0,,Бұл түсініксіз, солай емес пе?
Dialogue: 0,0:17:46.39,0:17:47.10,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:17:47.39,0:17:49.69,Default,,0,0,0,,Көріп отырғаныңыздай.
Dialogue: 0,0:17:50.98,0:17:53.11,Default,,0,0,0,,Сіз мені түсінесіз, солай ма?
Dialogue: 0,0:17:54.49,0:17:58.74,Default,,0,0,0,,Мынау көрші тұратын сұмдық жігіт емес пе?
Dialogue: 0,0:17:58.86,0:18:01.12,Default,,0,0,0,,Өзімшіл ақымақ!
Dialogue: 0,0:18:01.24,0:18:05.41,Default,,0,0,0,,Бұл Роб «Партия жануары» МакТод.
Dialogue: 0,0:18:05.54,0:18:09.67,Default,,0,0,0,,Біз жақын дос едік, бірақ сен мені тастадың.
Dialogue: 0,0:18:09.79,0:18:12.25,Default,,0,0,0,,Мен сені қайта көргім келмеді, бірақ...
Dialogue: 0,0:18:12.63,0:18:16.30,Default,,0,0,0,,Екі адамдық клубты рұқсатсыз бастадыңыз.
Dialogue: 0,0:18:16.42,0:18:19.51,Default,,0,0,0,,Себебі сен жиіркеніштісің, заң бойынша сен менікісің.
Dialogue: 0,0:18:19.64,0:18:20.97,Default,,0,0,0,,Мұндай заң жоқ.
Dialogue: 0,0:18:21.10,0:18:22.26,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:18:22.39,0:18:27.27,Default,,0,0,0,,Клуб - сіздің мұраңыз. Бұл тек сенікі емес.
Dialogue: 0,0:18:27.39,0:18:29.90,Default,,0,0,0,,Достық үзілді...
Dialogue: 0,0:18:30.02,0:18:32.52,Default,,0,0,0,,Өзімшіл болғандықтан.
Dialogue: 0,0:18:32.90,0:18:36.53,Default,,0,0,0,,Бірақ сіздің ойларыңыз менікі.
Dialogue: 0,0:18:37.95,0:18:39.70,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:18:39.95,0:18:42.87,Default,,0,0,0,,Сәлеметсіз бе, король Джулиен
Dialogue: 0,0:18:43.16,0:18:46.62,Default,,0,0,0,,Сізді үңгірде тағы көргеніме қуаныштымын!
Dialogue: 0,0:18:49.08,0:18:50.54,Default,,0,0,0,,Роб Сіз не істейсіз?
Dialogue: 0,0:18:50.67,0:18:53.42,Default,,0,0,0,,Менің жоспарымды тағы да ұмытпа.
Dialogue: 0,0:18:53.54,0:18:58.13,Default,,0,0,0,,Өз ойларыңызды менімен ауыстырыңыз.
Dialogue: 0,0:18:59.05,0:19:04.35,Default,,0,0,0,,Сіз құбыжық болдым деп ойласаңыз, енді не істеу керек? Ми алмасу?
Dialogue: 0,0:19:04.89,0:19:07.39,Default,,0,0,0,,Робқа қатты ұқсайды
Dialogue: 0,0:19:08.52,0:19:11.27,Default,,0,0,0,,Бұлай болса, екеуміз де өлеміз.
Dialogue: 0,0:19:11.90,0:19:14.31,Default,,0,0,0,,Сіздің ойыңыз кері.
Dialogue: 0,0:19:14.65,0:19:17.65,Default,,0,0,0,,«Сәтсіздіктен қорықпа» - менің ұраным
Dialogue: 0,0:19:21.78,0:19:26.41,Default,,0,0,0,,Роб, сен бұл клубты қалайсың ба?
Dialogue: 0,0:19:26.62,0:19:28.25,Default,,0,0,0,,Мен сізге купон беремін.
Dialogue: 0,0:19:28.37,0:19:31.96,Default,,0,0,0,,Мен сенің жүрегіңді қалаймын
Dialogue: 0,0:19:39.63,0:19:40.30,Default,,0,0,0,,Патша!
Dialogue: 0,0:19:49.14,0:19:49.81,Default,,0,0,0,,Патша!
Dialogue: 0,0:19:51.44,0:19:52.56,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:19:53.06,0:19:53.98,Default,,0,0,0,,Жер бетінде не?
Dialogue: 0,0:19:54.10,0:19:57.57,Default,,0,0,0,,Кингтің жүрегі Роббқа қарай жылжиды
Dialogue: 0,0:19:57.90,0:20:00.24,Default,,0,0,0,,Операция сәтті өтті.
Dialogue: 0,0:20:01.40,0:20:05.57,Default,,0,0,0,,Патшаның жүрегі жоқ көкөніске айналуы жақсы.
Dialogue: 0,0:20:05.70,0:20:09.12,Default,,0,0,0,,Уайымдама, мен суаруды жалғастырамын.
Dialogue: 0,0:20:10.91,0:20:14.08,Default,,0,0,0,,Морт! Менің аузыма шаш салма
Dialogue: 0,0:20:14.33,0:20:16.08,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:20:19.59,0:20:21.88,Default,,0,0,0,,Бұл Роб болды ма?
Dialogue: 0,0:20:22.01,0:20:24.64,Default,,0,0,0,,А, мен күткендей.
Dialogue: 0,0:20:24.76,0:20:25.51,Default,,0,0,0,,Қай жағынан?
Dialogue: 0,0:20:25.76,0:20:28.26,Default,,0,0,0,,Бұл екеуі не істейді?
Dialogue: 0,0:20:28.39,0:20:29.35,Default,,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,0:20:29.81,0:20:30.64,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:20:31.02,0:20:31.93,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:20:36.40,0:20:38.07,Default,,0,0,0,,Ертегіні айтып бер
Dialogue: 0,0:20:38.32,0:20:39.15,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:20:39.27,0:20:40.53,Default,,0,0,0,,Операция кезінде -
Dialogue: 0,0:20:40.98,0:20:46.70,Default,,0,0,0,,Біз бір сәт ой алмастық, мен Роббтың қайғысын түсіндім.
Dialogue: 0,0:20:47.62,0:20:50.54,Default,,0,0,0,,Менің миым қуырылғандықтан болар...
Dialogue: 0,0:20:50.66,0:20:55.25,Default,,0,0,0,,Сонда да Робтың айтқаны дұрыс болды.
Dialogue: 0,0:20:55.37,0:20:57.88,Default,,0,0,0,,Мен өзімшіл болдым
Dialogue: 0,0:20:58.21,0:21:01.09,Default,,0,0,0,,Және бәрін ренжітіңіз
Dialogue: 0,0:21:01.21,0:21:04.55,Default,,0,0,0,,Мен еншіммен ешкімді ренжіткім келмейді.
Dialogue: 0,0:21:05.09,0:21:09.81,Default,,0,0,0,,«Club Moist» өз есігін жабуға шешім қабылдады.
Dialogue: 0,0:21:10.93,0:21:14.39,Default,,0,0,0,,Оның орнына «Клуб ылғалды ауруханасы» салынады
Dialogue: 0,0:21:14.52,0:21:15.81,Default,,0,0,0,,Жақсы идея, солай ма?
Dialogue: 0,0:21:15.94,0:21:18.73,Default,,0,0,0,,Аурухана? Бұл кімнің идеясы болды?
Dialogue: 0,0:21:18.90,0:21:21.23,Default,,0,0,0,,Кенет маған бір ой келді.
Dialogue: 0,0:21:21.36,0:21:25.03,Default,,0,0,0,,Менің басымда Құдай айқайлап тұрғандай болды.
Dialogue: 0,0:21:25.32,0:21:27.78,Default,,0,0,0,,Бірақ дәрігер жоқ
Dialogue: 0,0:21:27.91,0:21:29.83,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:21:30.24,0:21:34.12,Default,,0,0,0,,Мен? Мүмкін үңгірдің сыртында...
Dialogue: 0,0:21:34.25,0:21:38.50,Default,,0,0,0,,Бұл менің заңгер болып жұмыс істей алатынымды білдіре ме?
Dialogue: 0,0:21:40.29,0:21:44.72,Default,,0,0,0,,Мен ше? Менің жұмысым бар ма?
Dialogue: 0,0:21:45.47,0:21:49.93,Default,,0,0,0,,Пластикалық хирургия және қоғамшылдық туралы білімді пайдалану―
Dialogue: 0,0:21:50.05,0:21:52.51,Default,,0,0,0,,Құбыжық медбике ше?
Dialogue: 0,0:21:52.64,0:21:55.85,Default,,0,0,0,,Бұл мен үшін өте қолайлы, менің ең жақын досым.
Dialogue: 0,0:21:55.98,0:21:56.94,Default,,0,0,0,,Би
Dialogue: 0,0:22:06.45,0:22:07.57,Default,,0,0,0,,Сәлем Роб
Dialogue: 0,0:22:08.45,0:22:09.74,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:22:11.07,0:22:14.66,Default,,0,0,0,,Осылайша патшалықтың бірінші ауруханасы...
Dialogue: 0,0:22:14.79,0:22:16.96,Default,,0,0,0,,Корольдің мұрасы болды
Dialogue: 0,0:22:17.08,0:22:20.96,Default,,0,0,0,,Бақытты аяқталулар шынымен де бар
Dialogue: 0,0:22:21.08,0:22:23.30,Default,,0,0,0,,Бір ән есімде
Dialogue: 0,0:22:24.00,0:22:25.80,Default,,0,0,0,,Мұра…
Dialogue: 0,0:22:27.38,0:22:28.63,Default,,0,0,0,,Кешіріңіз, бірақ-
Dialogue: 0,0:22:28.76,0:22:33.01,Default,,0,0,0,,Бұл аурухана, сондықтан қатаң ережелер бар.
Dialogue: 0,0:22:33.14,0:22:37.68,Default,,0,0,0,,Ең бастысы «үңгірлерде ән айтуға болмайды»
Dialogue: 0,0:22:37.81,0:22:40.19,Default,,0,0,0,,Мен қалғандарын ұмыттым.
Dialogue: 0,0:23:06.13,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Михо Ичихара
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
