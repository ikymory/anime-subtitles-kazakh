Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:45.58,0:00:48.75,Default,,0,0,0,,Жаңбырлы маусымға қош келдіңіздер
Dialogue: 0,0:00:49.04,0:00:51.05,Default,,0,0,0,,Ылғалды мереке!
Dialogue: 0,0:00:52.67,0:00:55.47,Default,,0,0,0,,Шелекті жоғары ұстаңыз
Dialogue: 0,0:00:55.59,0:01:00.72,Default,,0,0,0,,Жаңбыр құдайы Кевин сізге су береді.
Dialogue: 0,0:01:00.85,0:01:03.98,Default,,0,0,0,,Сусыз барлығы не болар еді?
Dialogue: 0,0:01:04.48,0:01:06.60,Default,,0,0,0,,Ол құрғап барады!
Dialogue: 0,0:01:06.73,0:01:07.98,Default,,0,0,0,,бұл дұрыс
Dialogue: 0,0:01:08.10,0:01:12.11,Default,,0,0,0,,Жаңбыр бишісі - патша Джульен!
Dialogue: 0,0:01:14.19,0:01:15.49,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:01:15.82,0:01:18.95,Default,,0,0,0,,Сол аяқты оң аяқтың үстіне қою... секіру арқылы өзгерту
Dialogue: 0,0:01:19.07,0:01:21.28,Default,,0,0,0,,Жоқ. Бұған дейін өткізіп жіберу керек пе?
Dialogue: 0,0:01:21.41,0:01:23.66,Default,,0,0,0,,Мен есімде жоқ
Dialogue: 0,0:01:23.79,0:01:25.87,Default,,0,0,0,,Мен еркін билегім келеді
Dialogue: 0,0:01:26.00,0:01:30.50,Default,,0,0,0,,Ережені сақтамасаң, жаңбыр жаумайды.
Dialogue: 0,0:01:30.63,0:01:31.54,Default,,0,0,0,,Ахсо
Dialogue: 0,0:01:31.67,0:01:35.67,Default,,0,0,0,,Бірақ мен жалғыз қалғым келмейді. Мен дос алғым келеді.
Dialogue: 0,0:01:35.80,0:01:38.05,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:01:38.18,0:01:39.51,Default,,0,0,0,,Радио кассеталық ойнатқыш
Dialogue: 0,0:01:44.93,0:01:47.56,Default,,0,0,0,,Кевин не болды?
Dialogue: 0,0:01:47.69,0:01:50.31,Default,,0,0,0,,Сізге арналған би
Dialogue: 0,0:01:51.31,0:01:53.69,Default,,0,0,0,,Мен қатты барамын
Dialogue: 0,0:01:53.94,0:01:55.69,Default,,0,0,0,,Маған көбірек жаңбыр беріңіз
Dialogue: 0,0:01:59.45,0:02:00.16,Default,,0,0,0,,Не?
Dialogue: 0,0:02:02.28,0:02:03.87,Default,,0,0,0,,Сиқырлы бумбокс!
Dialogue: 0,0:02:03.99,0:02:07.71,Default,,0,0,0,,Не болды, менің жақын досым?
Dialogue: 0,0:02:07.83,0:02:08.92,Default,,0,0,0,,Морис!
Dialogue: 0,0:02:09.46,0:02:13.63,Default,,0,0,0,,Дыбыс жоқ, радио кассета ойнатқышы жұмыс істемейді.
Dialogue: 0,0:02:18.09,0:02:21.14,Default,,0,0,0,,Өкінішке орай жаңбыр бірінші жауады.
Dialogue: 0,0:02:21.26,0:02:21.97,Default,,0,0,0,,Жаңбыр жауып тұр ма?
Dialogue: 0,0:02:22.47,0:02:25.39,Default,,0,0,0,,Бумбокс өлді.
Dialogue: 0,0:02:25.52,0:02:27.73,Default,,0,0,0,,Мен ұйықтай алмаймын
Dialogue: 0,0:02:27.85,0:02:31.60,Default,,0,0,0,,Басқаша айтқанда, енді ешкім ұйықтай алмайды.
Dialogue: 0,0:02:32.86,0:02:36.44,Default,,0,0,0,,Бірақ мен Құдайға би ұсынуым керек
Dialogue: 0,0:02:36.57,0:02:40.32,Default,,0,0,0,,Ендеше, құдай, бумбоксты қайтар.
Dialogue: 0,0:02:40.45,0:02:41.87,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:02:41.99,0:02:43.37,Default,,0,0,0,,Пайдасыз
Dialogue: 0,0:02:43.45,0:02:47.58,Default,,0,0,0,,Басқа биші іздеңіз, Кевин!
Dialogue: 0,0:02:47.70,0:02:49.08,Default,,0,0,0,,Қош бол
Dialogue: 0,0:02:50.54,0:02:51.79,Default,,0,0,0,,Бұл әдейі.
Dialogue: 0,0:02:52.00,0:02:55.21,Default,,0,0,0,,Патша билемесе, жаңбыр жаумайды
Dialogue: 0,0:02:55.34,0:02:58.63,Default,,0,0,0,,Менің ішкі мүшелерім құрғап қалды.
Dialogue: 0,0:02:58.76,0:03:03.76,Default,,0,0,0,,Теріңді іш, Қолтық терді шелекке жина
Dialogue: 0,0:03:03.89,0:03:05.39,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:03:05.51,0:03:07.85,Default,,0,0,0,,Мен жақында ораламын
Dialogue: 0,0:03:08.22,0:03:09.56,Default,,0,0,0,,Уақыт бөлу
Dialogue: 0,0:03:10.18,0:03:14.86,Default,,0,0,0,,Кешіріңіз, Құдай және бәрі.
Dialogue: 0,0:03:14.98,0:03:20.24,Default,,0,0,0,,Жердегі және аспандағы қиыншылықтар бір-біріне сәйкес келеді...
Dialogue: 0,0:03:20.36,0:03:24.16,Default,,0,0,0,,Оның орнына мен саған комедия беремін.
Dialogue: 0,0:03:24.28,0:03:26.41,Default,,0,0,0,,Ол сені күлдіреді
Dialogue: 0,0:03:26.53,0:03:30.29,Default,,0,0,0,,Сонымен... бәрі, сен қайдансың?
Dialogue: 0,0:03:30.41,0:03:32.42,Default,,0,0,0,,Мадагаскар!
Dialogue: 0,0:03:32.67,0:03:34.83,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:39.01,0:03:41.13,Default,,0,0,0,,Өлгенімді қалаймын
Dialogue: 0,0:03:42.18,0:03:44.89,Default,,0,0,0,,Жоқ, мен өле алмаймын, өйткені мен үлкен жігітпін.
Dialogue: 0,0:03:45.01,0:03:49.81,Default,,0,0,0,,Мен сені ешқашан ұмытпаймын, сиқырлы бумбокс-кун
Dialogue: 0,0:03:49.93,0:03:53.06,Default,,0,0,0,,Қош бол, қоқыс.
Dialogue: 0,0:03:53.35,0:03:54.44,Default,,0,0,0,,Бұл!
Dialogue: 0,0:03:55.52,0:03:59.19,Default,,0,0,0,,Бумбокс-кун, сен әлі елес болдың ба?
Dialogue: 0,0:03:59.53,0:04:01.11,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:04:01.24,0:04:05.95,Default,,0,0,0,,Радиокассеталық елестерге еліктеу жақсы емес.
Dialogue: 0,0:04:07.95,0:04:11.33,Default,,0,0,0,,Жай ғана жауап беріңіз, бұл дөрекі.
Dialogue: 0,0:04:11.70,0:04:13.29,Default,,0,0,0,,Ханшайым, егер кездейсоқ
Dialogue: 0,0:04:13.41,0:04:17.00,Default,,0,0,0,,Иә, өмір қиын.
Dialogue: 0,0:04:18.67,0:04:20.21,Default,,0,0,0,,Өмір емес пе?
Dialogue: 0,0:04:20.96,0:04:23.47,Default,,0,0,0,,Бұл жерде жүргенде абай болыңыз
Dialogue: 0,0:04:23.59,0:04:25.97,Default,,0,0,0,,Жарқыраған киім киетін шығар.
Dialogue: 0,0:04:26.22,0:04:29.22,Default,,0,0,0,,Бұл дауысты естігеніме қанша жыл болды!
Dialogue: 0,0:04:29.35,0:04:30.89,Default,,0,0,0,,Көздің ара қашықтығы
Dialogue: 0,0:04:31.02,0:04:35.48,Default,,0,0,0,,Күмәнсіз, патша қанының иісі бар.
Dialogue: 0,0:04:35.60,0:04:37.81,Default,,0,0,0,,Король Джульен, солай ма?
Dialogue: 0,0:04:38.02,0:04:41.15,Default,,0,0,0,,Иә, бұл анық.
Dialogue: 0,0:04:41.48,0:04:42.53,Default,,0,0,0,,Бұл Тимо.
Dialogue: 0,0:04:43.24,0:04:45.70,Default,,0,0,0,,Тимо... бұл сенің атың ба?
Dialogue: 0,0:04:45.95,0:04:50.20,Default,,0,0,0,,Неден бастау керек? Мынау, анау, анау ма?
Dialogue: 0,0:04:52.58,0:04:55.75,Default,,0,0,0,,Мен тенрекпін
Dialogue: 0,0:04:56.46,0:05:00.50,Default,,0,0,0,,Айтпақшы, мен мұны сақтай аламын.
Dialogue: 0,0:05:06.51,0:05:08.43,Default,,0,0,0,,Бұл бала батареямен жұмыс істейді.
Dialogue: 0,0:05:08.55,0:05:11.68,Default,,0,0,0,,Не, сен бала едің бе?
Dialogue: 0,0:05:12.39,0:05:14.81,Default,,0,0,0,,Осыны ауыстырсаңыз...
Dialogue: 0,0:05:19.31,0:05:21.57,Default,,0,0,0,,Бұл керемет! Бұл керемет!
Dialogue: 0,0:05:21.90,0:05:25.99,Default,,0,0,0,,Мақтау үшін рахмет... Ой, ұмытып кетіппін.
Dialogue: 0,0:05:26.32,0:05:29.07,Default,,0,0,0,,Бұл менің зертханам.
Dialogue: 0,0:05:30.45,0:05:31.78,Default,,0,0,0,,Сіз біртүрлі екенсіз.
Dialogue: 0,0:05:32.33,0:05:35.46,Default,,0,0,0,,Ғалымдар осындай.
Dialogue: 0,0:05:35.58,0:05:37.04,Default,,0,0,0,,«Кагакуша»?
Dialogue: 0,0:05:37.33,0:05:41.29,Default,,0,0,0,,Өлгендерді тірілттің. Сіз құдайлардың бірісіз бе?
Dialogue: 0,0:05:41.42,0:05:43.21,Default,,0,0,0,,Ол салыстырмалы түрде қысқа.
Dialogue: 0,0:05:43.34,0:05:46.80,Default,,0,0,0,,Мен құдаймын ба? Жоқ, қазірдің өзінде
Dialogue: 0,0:05:47.30,0:05:48.63,Default,,0,0,0,,Менің мұрным қайтадан шырылдады.
Dialogue: 0,0:05:48.76,0:05:51.51,Default,,0,0,0,,Мен құдай емес, ғалыммын.
Dialogue: 0,0:05:51.64,0:05:56.98,Default,,0,0,0,,Сіз радио кассеталық ойнатқышты жандандыруға немесе жасауға немесе кез келген нәрсені жасауға болады.
Dialogue: 0,0:05:57.23,0:05:58.60,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:06:01.73,0:06:05.19,Default,,0,0,0,,Сол құпияны көбірек айтыңыз.
Dialogue: 0,0:06:05.32,0:06:07.11,Default,,0,0,0,,Жаңбыр жаумайды
Dialogue: 0,0:06:07.24,0:06:08.91,Default,,0,0,0,,Бітті.
Dialogue: 0,0:06:09.16,0:06:11.66,Default,,0,0,0,,Соңында, кеттік!
Dialogue: 0,0:06:13.37,0:06:14.79,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:17.04,0:06:20.75,Default,,0,0,0,,Бұл 10 минуттық үзіліс. үшін сол қалпында қалады.
Dialogue: 0,0:06:20.88,0:06:22.21,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:06:22.29,0:06:24.00,Default,,0,0,0,,Хироко, неге осындай жағдайға жеттік?
Dialogue: 0,0:06:24.13,0:06:28.13,Default,,0,0,0,,Патша билемесе, Құдай кетеді.
Dialogue: 0,0:06:28.47,0:06:30.76,Default,,0,0,0,,Маған неге қоңырау шалмайсың?
Dialogue: 0,0:06:30.89,0:06:35.64,Default,,0,0,0,,Кингті жалғыз қалдыру өте қауіпті.
Dialogue: 0,0:06:36.02,0:06:38.02,Default,,0,0,0,,Мені кінәлама
Dialogue: 0,0:06:38.14,0:06:42.44,Default,,0,0,0,,Бұл тіл сенің қайда болғаныңды біледі
Dialogue: 0,0:06:43.44,0:06:48.82,Default,,0,0,0,,«Жауынгер ханшайым Тайсандер бір мүйізге жақындады».
Dialogue: 0,0:06:48.95,0:06:52.28,Default,,0,0,0,,«Сосын сұлу аң айтты».
Dialogue: 0,0:06:52.41,0:06:54.74,Default,,0,0,0,,«Мен жалғыз мүйізді емеспін»
Dialogue: 0,0:06:54.87,0:06:59.12,Default,,0,0,0,,«Бұл сиқырлы ханзада Норге».
Dialogue: 0,0:06:59.25,0:07:02.96,Default,,0,0,0,,«Мүйізді сүй! Менің жүрегім сенікі»
Dialogue: 0,0:07:03.58,0:07:07.34,Default,,0,0,0,,Менің жеке өміріме үңілме
Dialogue: 0,0:07:07.46,0:07:12.30,Default,,0,0,0,,Патша қайда? Денем құрғап қалды
Dialogue: 0,0:07:12.43,0:07:15.93,Default,,0,0,0,,Менің ішкі ағзаларым құрғап, сынып кетейін деп тұрмын.
Dialogue: 0,0:07:17.77,0:07:20.06,Default,,0,0,0,,үшін өледі!
Dialogue: 0,0:07:20.18,0:07:22.52,Default,,0,0,0,,үшінң тынышталыңдар.
Dialogue: 0,0:07:22.65,0:07:25.27,Default,,0,0,0,,Не болды, халқым?
Dialogue: 0,0:07:26.02,0:07:29.07,Default,,0,0,0,,Біреу өлгендей болды.
Dialogue: 0,0:07:31.36,0:07:33.53,Default,,0,0,0,,Ә… шын мәнінде
Dialogue: 0,0:07:34.57,0:07:35.37,Default,,0,0,0,,Патша!
Dialogue: 0,0:07:35.49,0:07:36.24,Default,,0,0,0,,Мен қайтып келдім!
Dialogue: 0,0:07:36.37,0:07:39.16,Default,,0,0,0,,Boombox қайта тіріледі
Dialogue: 0,0:07:39.29,0:07:43.83,Default,,0,0,0,,Әлде бұл зомби ме? Сіз жейсіз!
Dialogue: 0,0:07:44.83,0:07:47.17,Default,,0,0,0,,Құдай түсті, солай ма?
Dialogue: 0,0:07:47.30,0:07:51.26,Default,,0,0,0,,Морис Мен ештеңе түсінбеймін.
Dialogue: 0,0:07:51.38,0:07:52.88,Default,,0,0,0,,Құдайдың қатысы жоқ
Dialogue: 0,0:07:53.47,0:07:57.68,Default,,0,0,0,,Халқым, Көрдім болашақты.
Dialogue: 0,0:07:57.81,0:08:01.35,Default,,0,0,0,,Кагаку деп аталатын болашақ!
Dialogue: 0,0:08:05.23,0:08:09.78,Default,,0,0,0,,Рәсімге талғампаз құдайларды қалдыр.
Dialogue: 0,0:08:09.90,0:08:15.20,Default,,0,0,0,,Енді бізде сиқырлы құрал бар
Dialogue: 0,0:08:15.32,0:08:17.87,Default,,0,0,0,,Осы тенректің арқасында.
Dialogue: 0,0:08:18.53,0:08:21.45,Default,,0,0,0,,Бұл Тимо, Кагаку сиқыршысы.
Dialogue: 0,0:08:21.58,0:08:24.42,Default,,0,0,0,,Бұл сиқыр емес, бұл ғылым.
Dialogue: 0,0:08:24.54,0:08:27.38,Default,,0,0,0,,Кагаку сиқыршысына ду қол шапалақтау!
Dialogue: 0,0:08:28.79,0:08:33.72,Default,,0,0,0,,Сиқыр - бұл қиял. Мен қобалжып, қобалжыдым.
Dialogue: 0,0:08:35.59,0:08:41.72,Default,,0,0,0,,Патшалыққа ақымақ құралдардан гөрі жаңбыр көбірек қажет.
Dialogue: 0,0:08:43.06,0:08:44.60,Default,,0,0,0,,Бұл ең жақсы!
Dialogue: 0,0:08:44.73,0:08:49.77,Default,,0,0,0,,Фарт сияқты, ауа жылы, иіссіз.
Dialogue: 0,0:08:52.15,0:08:57.32,Default,,0,0,0,,Кагаку желі менің денеме енеді.
Dialogue: 0,0:08:58.82,0:09:03.00,Default,,0,0,0,,Халық бақытты. Сіз қалай ойлайсыз? Масикура
Dialogue: 0,0:09:10.96,0:09:12.30,Default,,0,0,0,,Бұл Кагаку!
Dialogue: 0,0:09:12.42,0:09:13.55,Default,,0,0,0,,Кагаку
Dialogue: 0,0:09:16.72,0:09:17.68,Default,,0,0,0,,Кагаку
Dialogue: 0,0:09:19.43,0:09:20.22,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:09:28.10,0:09:29.15,Default,,0,0,0,,Кагаку
Dialogue: 0,0:09:33.28,0:09:35.86,Default,,0,0,0,,Бұл прогресс
Dialogue: 0,0:09:36.07,0:09:38.07,Default,,0,0,0,,Аяқ~
Dialogue: 0,0:09:41.58,0:09:45.75,Default,,0,0,0,,Сиқырлы көпіршік таяқшасы тоқтады.
Dialogue: 0,0:09:47.83,0:09:51.38,Default,,0,0,0,,Қорықпа, мойыныңа қоңырау тақамын.
Dialogue: 0,0:09:51.50,0:09:53.34,Default,,0,0,0,,Менің саған айтар сөзім бар.
Dialogue: 0,0:09:56.01,0:09:57.38,Default,,0,0,0,,Сиқыр жойылды
Dialogue: 0,0:09:57.51,0:10:00.97,Default,,0,0,0,,Мұнда «Kagaku пайдаланушысы» аталады.
Dialogue: 0,0:10:01.39,0:10:06.06,Default,,0,0,0,,Бұл Кагаку сиқыршысы туралы. Түсінесіз бе?
Dialogue: 0,0:10:06.18,0:10:08.48,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:10:08.60,0:10:12.52,Default,,0,0,0,,Сіз бұған көңілі толмайтын сияқтысыз.
Dialogue: 0,0:10:12.90,0:10:17.15,Default,,0,0,0,,Себебі мен маңызды рәсімнен бас тарттым.
Dialogue: 0,0:10:17.28,0:10:20.32,Default,,0,0,0,,Жаңбыр патшалық үшін өте маңызды.
Dialogue: 0,0:10:20.45,0:10:24.66,Default,,0,0,0,,Жоқ, ең бастысы - кішкене күріш төсеніші.
Dialogue: 0,0:10:26.87,0:10:28.16,Default,,0,0,0,,Тимо!
Dialogue: 0,0:10:28.62,0:10:33.29,Default,,0,0,0,,Машикура табиғаттан тыс күштерге ие бұрынғы кеңесші.
Dialogue: 0,0:10:33.42,0:10:35.67,Default,,0,0,0,,Мен осылай жұмыстан шығарылдым ба?
Dialogue: 0,0:10:35.80,0:10:39.38,Default,,0,0,0,,Керісінше, мен сізге мүмкіндік бергім келеді.
Dialogue: 0,0:10:39.51,0:10:42.72,Default,,0,0,0,,Сіз патша отбасынан тыс әлемді көре аласыз.
Dialogue: 0,0:10:42.85,0:10:44.85,Default,,0,0,0,,Қарастыру, сыпайылық қажет емес
Dialogue: 0,0:10:44.97,0:10:48.56,Default,,0,0,0,,Патша әулеті маған ұрпақтан-ұрпаққа сенді.
Dialogue: 0,0:10:48.68,0:10:52.02,Default,,0,0,0,,Табиғат құдайларына табындым.
Dialogue: 0,0:10:52.15,0:10:54.44,Default,,0,0,0,,Нәтижелерді қараңыз.
Dialogue: 0,0:10:54.57,0:10:57.07,Default,,0,0,0,,үшін «табиғи өліммен» қайтыс болды
Dialogue: 0,0:10:57.19,0:11:00.40,Default,,0,0,0,,Тимоның Кагакусы пайдалы
Dialogue: 0,0:11:00.53,0:11:03.87,Default,,0,0,0,,Панини деп аталатын нан жасауға да болады.
Dialogue: 0,0:11:03.99,0:11:07.83,Default,,0,0,0,,Сіз өкінесіз, король Джулиен.
Dialogue: 0,0:11:08.70,0:11:10.29,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:11:10.92,0:11:14.88,Default,,0,0,0,,Бұлбұл таяқшасына сиқырлау.
Dialogue: 0,0:11:16.09,0:11:17.96,Default,,0,0,0,,Зарядтайық
Dialogue: 0,0:11:18.09,0:11:21.13,Default,,0,0,0,,Мен мұны сізге қалдырамын. Бұл сиқырлы қулық па?
Dialogue: 0,0:11:21.63,0:11:22.43,Default,,0,0,0,,Сиқыр?
Dialogue: 0,0:11:22.55,0:11:23.30,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:11:23.76,0:11:26.22,Default,,0,0,0,,Джумон? Сиқыр?
Dialogue: 0,0:11:26.35,0:11:27.56,Default,,0,0,0,,үшін әртүрлі
Dialogue: 0,0:11:27.68,0:11:29.68,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:11:30.89,0:11:32.02,Default,,0,0,0,,Менің досым
Dialogue: 0,0:11:32.14,0:11:36.48,Default,,0,0,0,,Кагакуша сонда болса, қорқатын ештеңе жоқ.
Dialogue: 0,0:11:37.44,0:11:38.53,Default,,0,0,0,,Мәңгі
Dialogue: 0,0:11:51.00,0:11:55.71,Default,,0,0,0,,Мен патша отбасына ұзақ жылдар қызмет етсем де.
Dialogue: 0,0:11:55.84,0:11:56.84,Default,,0,0,0,,Көп емес.
Dialogue: 0,0:11:56.96,0:11:58.50,Default,,0,0,0,,Э… иә, мен жақсымын
Dialogue: 0,0:11:58.63,0:12:02.68,Default,,0,0,0,,Морт Бұдан былай... баратын жер жоқ.
Dialogue: 0,0:12:02.80,0:12:06.64,Default,,0,0,0,,Онда менің үйіме кел.
Dialogue: 0,0:12:06.76,0:12:08.14,Default,,0,0,0,,Мен бұлай істеуден аулақпын.
Dialogue: 0,0:12:08.26,0:12:12.02,Default,,0,0,0,,Сіз жұмыстан шығарылдыңыз, солай ма? Басқа баратын жеріңіз бар ма?
Dialogue: 0,0:12:12.89,0:12:15.19,Default,,0,0,0,,Мен мұны өсек-аяң арқылы естідім.
Dialogue: 0,0:12:15.44,0:12:18.61,Default,,0,0,0,,Ал, бірнеше күн тұрайық.
Dialogue: 0,0:12:18.86,0:12:21.03,Default,,0,0,0,,Ия, мен түнеп жатырмын.
Dialogue: 0,0:12:21.15,0:12:24.07,Default,,0,0,0,,Бірақ сенің бір бөлмелесің бар, солай ма?
Dialogue: 0,0:12:24.20,0:12:28.28,Default,,0,0,0,,Бұл менің арманымдағы ауруымның кесірінен пайда болды.
Dialogue: 0,0:12:28.41,0:12:29.66,Default,,0,0,0,,«Арманды құшақтау ауруы»?
Dialogue: 0,0:12:29.79,0:12:32.12,Default,,0,0,0,,Ұйқыда серуендеу сияқты нәрсе
Dialogue: 0,0:12:32.25,0:12:34.83,Default,,0,0,0,,Ұйықтап жатқанда құшақтау
Dialogue: 0,0:12:34.96,0:12:36.88,Default,,0,0,0,,Түн қорқынышты...
Dialogue: 0,0:12:37.13,0:12:39.96,Default,,0,0,0,,Мен құшақтағым келеді
Dialogue: 0,0:12:40.63,0:12:43.09,Default,,0,0,0,,Бірнеше күннен кейін...
Dialogue: 0,0:12:43.22,0:12:47.43,Default,,0,0,0,,Кагаку сиқыры мен құралдары өмірді өзгертті.
Dialogue: 0,0:12:47.72,0:12:51.06,Default,,0,0,0,,Маған енді Құдай керек емес
Dialogue: 0,0:12:51.18,0:12:53.02,Default,,0,0,0,,Кагаку бар
Dialogue: 0,0:12:54.35,0:12:59.02,Default,,0,0,0,,Құдайдың манго шығаруын күтпе
Dialogue: 0,0:12:59.15,0:13:01.48,Default,,0,0,0,,Кагаку сені алып жүреді
Dialogue: 0,0:13:01.61,0:13:03.57,Default,,0,0,0,,Мен Кагакуды жақсы көремін!
Dialogue: 0,0:13:04.36,0:13:06.32,Default,,0,0,0,,Күтудің қажеті жоқ
Dialogue: 0,0:13:06.99,0:13:08.78,Default,,0,0,0,,Патша көзқарасы
Dialogue: 0,0:13:14.66,0:13:17.17,Default,,0,0,0,,Кагаку ең күшті
Dialogue: 0,0:13:17.29,0:13:21.55,Default,,0,0,0,,Құдай Кевин осындай нәрсені жасай ала ма?
Dialogue: 0,0:13:21.67,0:13:22.88,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:28.34,0:13:32.39,Default,,0,0,0,,Блендер тоқтады, мен смузиді іше алмаймын.
Dialogue: 0,0:13:32.64,0:13:34.06,Default,,0,0,0,,Тамақ туралы не айтасыз?
Dialogue: 0,0:13:34.18,0:13:35.48,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:13:36.44,0:13:37.90,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:38.02,0:13:40.19,Default,,0,0,0,,Мен түсіндім деп ойлайсыз ба?
Dialogue: 0,0:13:40.31,0:13:41.27,Default,,0,0,0,,Kagaku пайдаланушысы!
Dialogue: 0,0:13:43.11,0:13:45.36,Default,,0,0,0,,Сиқырға қатысты мәселе бар.
Dialogue: 0,0:13:45.49,0:13:47.57,Default,,0,0,0,,Өз жалақыңызға жұмыс жасаңыз
Dialogue: 0,0:13:47.70,0:13:51.95,Default,,0,0,0,,Сіз жалақы алдыңыз ба? Жарайды... мен алған жоқпын.
Dialogue: 0,0:13:52.08,0:13:52.99,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:13:53.12,0:13:54.45,Default,,0,0,0,,Кинг күткендей.
Dialogue: 0,0:13:54.58,0:13:55.50,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:13:57.54,0:13:58.87,Default,,0,0,0,,Бұл тым көп күш.
Dialogue: 0,0:13:59.00,0:14:01.04,Default,,0,0,0,,ше? Денрёку...?
Dialogue: 0,0:14:01.25,0:14:02.42,Default,,0,0,0,,Сиқырды шамадан тыс қолдану
Dialogue: 0,0:14:02.55,0:14:06.84,Default,,0,0,0,,Себеп «дөрекі» ме? Жоқ, бұл бұзушы.
Dialogue: 0,0:14:08.47,0:14:10.68,Default,,0,0,0,,Мен институтқа баруым керек.
Dialogue: 0,0:14:11.05,0:14:14.64,Default,,0,0,0,,Кловерді оққағарыңызға қосыңыз.
Dialogue: 0,0:14:14.77,0:14:16.56,Default,,0,0,0,,Маңызды отбасы
Dialogue: 0,0:14:16.68,0:14:18.60,Default,,0,0,0,,Мен әрқашан інім болғанын қалайтынмын.
Dialogue: 0,0:14:18.73,0:14:20.19,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:14:20.31,0:14:21.52,Default,,0,0,0,,Аузыңды жап
Dialogue: 0,0:14:21.65,0:14:24.48,Default,,0,0,0,,Өмірімді өзгертті
Dialogue: 0,0:14:24.61,0:14:27.24,Default,,0,0,0,,Өйткені сіз...
Dialogue: 0,0:14:27.70,0:14:28.61,Default,,0,0,0,,Сиқыршы?
Dialogue: 0,0:14:29.07,0:14:29.91,Default,,0,0,0,,Ертегі?
Dialogue: 0,0:14:30.28,0:14:33.91,Default,,0,0,0,,Мен таң қалдым, арқам қатты.
Dialogue: 0,0:14:34.03,0:14:38.25,Default,,0,0,0,,Көз жасынан жасалған лосьонды қолдану керек пе?
Dialogue: 0,0:14:38.37,0:14:41.21,Default,,0,0,0,,Ол тайғақ болмайды.
Dialogue: 0,0:14:41.33,0:14:43.92,Default,,0,0,0,,Солай ма? Бейшара
Dialogue: 0,0:14:44.04,0:14:46.59,Default,,0,0,0,,Жарайды, ешкімге айтпаймын.
Dialogue: 0,0:14:46.71,0:14:48.55,Default,,0,0,0,,Мен шомыламын
Dialogue: 0,0:14:48.67,0:14:49.68,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:14:54.43,0:14:55.64,Default,,0,0,0,,Су жоқ
Dialogue: 0,0:14:55.76,0:14:59.10,Default,,0,0,0,,Өйткені сен менің кеңесімді тыңдамайсың.
Dialogue: 0,0:14:59.23,0:15:01.02,Default,,0,0,0,,Егер сіз тыңдаған болсаңыз...
Dialogue: 0,0:15:01.85,0:15:03.77,Default,,0,0,0,,Өте қызық
Dialogue: 0,0:15:03.90,0:15:06.07,Default,,0,0,0,,Біз әпкелерміз.
Dialogue: 0,0:15:06.19,0:15:07.07,Default,,0,0,0,,Сіз ер адамсыз ба?
Dialogue: 0,0:15:07.19,0:15:10.07,Default,,0,0,0,,Мен енді жалғыз емеспін
Dialogue: 0,0:15:10.20,0:15:13.07,Default,,0,0,0,,Мәңгілік бірге өмір сүрейік
Dialogue: 0,0:15:14.58,0:15:18.04,Default,,0,0,0,,Сіз Кагакуға барлық мәліметтерді айта алатындай ақылдысыз.
Dialogue: 0,0:15:18.16,0:15:20.25,Default,,0,0,0,,Кейде бір нәрсе дұрыс емес болады
Dialogue: 0,0:15:20.37,0:15:24.42,Default,,0,0,0,,Мысалы, мен сіздің денеңіздің иісін сезсем...
Dialogue: 0,0:15:24.54,0:15:27.76,Default,,0,0,0,,Мен сенің жігітің жоқ екенін білемін, бұл жақсы нәрсе.
Dialogue: 0,0:15:28.38,0:15:31.76,Default,,0,0,0,,Жаман нәрсе – оны айту
Dialogue: 0,0:15:32.09,0:15:33.39,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:35.76,0:15:36.89,Default,,0,0,0,,Қаш!
Dialogue: 0,0:15:44.94,0:15:45.86,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:15:46.19,0:15:47.65,Default,,0,0,0,,Бітті.
Dialogue: 0,0:15:48.11,0:15:49.99,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:15:51.36,0:15:55.37,Default,,0,0,0,,Кагакусыз жақсы екеніңізді хабарлаңыз.
Dialogue: 0,0:15:55.49,0:15:59.08,Default,,0,0,0,,Мен енді шоколадты жей алмаймын.
Dialogue: 0,0:15:59.20,0:16:01.25,Default,,0,0,0,,Киімдегі әжімдерді қалай кетіруге болады?
Dialogue: 0,0:16:01.37,0:16:02.71,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:16:02.83,0:16:05.83,Default,,0,0,0,,Шоколадты фондю білмейсіз бе?
Dialogue: 0,0:16:05.96,0:16:08.75,Default,,0,0,0,,Сіз кез келген нәрсені жақсырақ жасай аласыз.
Dialogue: 0,0:16:09.88,0:16:10.76,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:16:10.88,0:16:11.63,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:16:12.17,0:16:13.01,Default,,0,0,0,,Тимо ше?
Dialogue: 0,0:16:13.13,0:16:17.30,Default,,0,0,0,,Кагаку жоғалып кетті. Мен онсызда қиналып жүрмін.
Dialogue: 0,0:16:17.51,0:16:23.02,Default,,0,0,0,,Зертханадағы машиналар жанып, от жақындап келеді.
Dialogue: 0,0:16:23.35,0:16:26.19,Default,,0,0,0,,Kagaku құралдары қауіпсіз бе?
Dialogue: 0,0:16:26.31,0:16:27.02,Default,,0,0,0,,Патша!
Dialogue: 0,0:16:27.15,0:16:30.40,Default,,0,0,0,,Білемін, ел шоколадтан бұрын келеді.
Dialogue: 0,0:16:30.53,0:16:33.61,Default,,0,0,0,,Корольдік су ыдысына!
Dialogue: 0,0:16:35.32,0:16:36.03,Default,,0,0,0,,Қара
Dialogue: 0,0:16:36.45,0:16:37.87,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:16:37.99,0:16:40.12,Default,,0,0,0,,Корольдік монша!
Dialogue: 0,0:16:42.58,0:16:44.87,Default,,0,0,0,,Мен онсыз да басқара аламын.
Dialogue: 0,0:16:45.58,0:16:47.50,Default,,0,0,0,,Уайымдама, келесі жолы...
Dialogue: 0,0:16:47.63,0:16:48.96,Default,,0,0,0,,Артық емес
Dialogue: 0,0:16:49.71,0:16:52.01,Default,,0,0,0,,Өрт қазірдің өзінде бар.
Dialogue: 0,0:16:52.13,0:16:54.30,Default,,0,0,0,,Ағаш жанып кетсе...
Dialogue: 0,0:16:54.43,0:16:57.05,Default,,0,0,0,,Сабыр ет, Кловер.
Dialogue: 0,0:16:57.18,0:16:59.26,Default,,0,0,0,,Бұл тропикалық орман
Dialogue: 0,0:16:59.39,0:17:02.35,Default,,0,0,0,,Жақын арада жаңбыр жауады.
Dialogue: 0,0:17:02.47,0:17:04.27,Default,,0,0,0,,От жаңбырмен жеңіледі
Dialogue: 0,0:17:04.39,0:17:08.02,Default,,0,0,0,,Мен билемеймін, сондықтан түспеймін.
Dialogue: 0,0:17:08.15,0:17:10.48,Default,,0,0,0,,Бұл би жаңбырдан болды ма?
Dialogue: 0,0:17:10.61,0:17:12.61,Default,,0,0,0,,Сіз білесіз
Dialogue: 0,0:17:12.74,0:17:15.03,Default,,0,0,0,,Өткенді ұмыттым
Dialogue: 0,0:17:15.15,0:17:16.11,Default,,0,0,0,,Кеше
Dialogue: 0,0:17:16.24,0:17:20.99,Default,,0,0,0,,Менің бумбоксым өліп қалды, мен шошып кеттім.
Dialogue: 0,0:17:21.12,0:17:23.75,Default,,0,0,0,,Махаббатты білмейтіндер түсінбейді
Dialogue: 0,0:17:23.87,0:17:25.04,Default,,0,0,0,,Әлі уақытында
Dialogue: 0,0:17:26.17,0:17:27.58,Default,,0,0,0,,５ ６ ７ ８…
Dialogue: 0,0:17:31.09,0:17:33.21,Default,,0,0,0,,Секіріңіз және қолыңызды көтеріңіз...
Dialogue: 0,0:17:35.38,0:17:36.93,Default,,0,0,0,,Неліктен жаңбыр жаумайды?
Dialogue: 0,0:17:37.05,0:17:39.60,Default,,0,0,0,,Себебі мен Кагакуды таңдадым.
Dialogue: 0,0:17:39.72,0:17:44.93,Default,,0,0,0,,Жаңбыр құдайы ашуланды ма? Ол соншалықты терең
Dialogue: 0,0:17:45.35,0:17:47.73,Default,,0,0,0,,Құрал-сайман беру арқылы көңіл-күйіңізді көтересіз бе?
Dialogue: 0,0:17:48.02,0:17:51.90,Default,,0,0,0,,Неге Машикурадан көмек сұрамайсың?
Dialogue: 0,0:17:55.07,0:17:56.36,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:17:57.53,0:18:00.41,Default,,0,0,0,,Иә, хабарлама болды.
Dialogue: 0,0:18:00.53,0:18:03.45,Default,,0,0,0,,Мен осында қалғаным жақсы емес.
Dialogue: 0,0:18:03.58,0:18:07.79,Default,,0,0,0,,Менің шашымды өріп жіберсеңіз ғой.
Dialogue: 0,0:18:07.92,0:18:09.63,Default,,0,0,0,,Бұл ұзындық...
Dialogue: 0,0:18:12.17,0:18:13.84,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:18:13.96,0:18:17.13,Default,,0,0,0,,Мен оны жұмбақ бухтадан таптым.
Dialogue: 0,0:18:17.26,0:18:18.93,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:19.05,0:18:21.76,Default,,0,0,0,,Жақсы, кездескенше.
Dialogue: 0,0:18:22.72,0:18:25.39,Default,,0,0,0,,Жоқ, мен сені жібермеймін.
Dialogue: 0,0:18:25.52,0:18:27.68,Default,,0,0,0,,Содан кейін мұны орындаңыз
Dialogue: 0,0:18:30.31,0:18:32.23,Default,,0,0,0,,Жалдау ақысын қайтарудың қажеті жоқ
Dialogue: 0,0:18:36.90,0:18:39.74,Default,,0,0,0,,Король, сен мұнда не істеп жүрсің?
Dialogue: 0,0:18:39.86,0:18:40.86,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:18:40.99,0:18:44.12,Default,,0,0,0,,Айтарыңыз бар.
Dialogue: 0,0:18:44.24,0:18:45.33,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:18:45.45,0:18:47.66,Default,,0,0,0,,Яғни...
Dialogue: 0,0:18:47.79,0:18:50.92,Default,,0,0,0,,Кешіріңіз, қайта оралыңыз.
Dialogue: 0,0:18:51.25,0:18:51.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:52.04,0:18:53.38,Default,,0,0,0,,Мен ештеңе айтқан жоқпын
Dialogue: 0,0:18:53.50,0:18:54.17,Default,,0,0,0,,Патша!
Dialogue: 0,0:18:54.29,0:18:55.46,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:18:55.59,0:19:00.09,Default,,0,0,0,,Рәсімді күлкіге айналдырғаны үшін менің кінәм болды. Қайтып келіңізші.
Dialogue: 0,0:19:00.22,0:19:03.18,Default,,0,0,0,,Эй, сен кешірім сұрап тұрсың.
Dialogue: 0,0:19:05.14,0:19:09.39,Default,,0,0,0,,Өкінішке орай, маған бұл жер ұнайды...
Dialogue: 0,0:19:09.85,0:19:11.52,Default,,0,0,0,,Сәлем
Dialogue: 0,0:19:12.48,0:19:13.94,Default,,0,0,0,,Иә, бұл—
Dialogue: 0,0:19:14.57,0:19:15.94,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:19:16.90,0:19:19.40,Default,,0,0,0,,Корольдік отбасынан тыс әлем
Dialogue: 0,0:19:19.65,0:19:22.95,Default,,0,0,0,,Маған көмектесіңізші, өрт шығып жатыр.
Dialogue: 0,0:19:23.07,0:19:24.58,Default,,0,0,0,,тым кеш
Dialogue: 0,0:19:24.78,0:19:26.95,Default,,0,0,0,,Уақыт өтті
Dialogue: 0,0:19:27.08,0:19:30.08,Default,,0,0,0,,Құдайды құрметтеу керек дедім
Dialogue: 0,0:19:30.21,0:19:33.67,Default,,0,0,0,,Патшалық Кагакудың кесірінен жойылды.
Dialogue: 0,0:19:33.79,0:19:35.38,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:19:35.71,0:19:39.51,Default,,0,0,0,,Ғылым шлангты жасады.
Dialogue: 0,0:19:39.92,0:19:43.22,Default,,0,0,0,,Бұл суды көп өндіретін құрал.
Dialogue: 0,0:19:43.34,0:19:44.43,Default,,0,0,0,,Өрт!
Dialogue: 0,0:19:45.89,0:19:50.06,Default,,0,0,0,,Шланг болса да, бірінші орында су жоқ
Dialogue: 0,0:19:50.18,0:19:51.19,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:52.52,0:19:54.27,Default,,0,0,0,,Берілмеңіз
Dialogue: 0,0:19:54.40,0:19:57.94,Default,,0,0,0,,Құдай оны қолдануға жарамды етеді
Dialogue: 0,0:20:05.49,0:20:06.24,Default,,0,0,0,,Бұл өрт.
Dialogue: 0,0:20:06.37,0:20:08.74,Default,,0,0,0,,Бұл дүниенің ақыры
Dialogue: 0,0:20:11.66,0:20:14.75,Default,,0,0,0,,Табиғат әрқашан жасырады
Dialogue: 0,0:20:14.88,0:20:18.50,Default,,0,0,0,,Бірақ Құдай белгі қалдырады
Dialogue: 0,0:20:20.59,0:20:23.47,Default,,0,0,0,,Жәндіктердің саңғырығымен жабылған
Dialogue: 0,0:20:23.59,0:20:25.84,Default,,0,0,0,,Мен қазғым келеді
Dialogue: 0,0:20:25.97,0:20:29.47,Default,,0,0,0,,Осы жерді қазсаң, су шығуы керек.
Dialogue: 0,0:20:30.10,0:20:31.35,Default,,0,0,0,,Осымен.
Dialogue: 0,0:20:31.48,0:20:35.73,Default,,0,0,0,,Кагаку мен Құдай күш біріктірсе...
Dialogue: 0,0:20:35.85,0:20:38.32,Default,,0,0,0,,Сонда сіз патшалықты сақтай аласыз ба?
Dialogue: 0,0:20:39.23,0:20:40.36,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:20:50.83,0:20:52.29,Default,,0,0,0,,Жарайды, жүр.
Dialogue: 0,0:21:09.55,0:21:11.31,Default,,0,0,0,,Жаңбыр жаудырайық
Dialogue: 0,0:21:15.69,0:21:17.31,Default,,0,0,0,,Түтік бітеліп қалған
Dialogue: 0,0:21:17.44,0:21:18.77,Default,,0,0,0,,Бекітілген болуы керек
Dialogue: 0,0:21:18.86,0:21:20.48,Default,,0,0,0,,Мен оны түзетемін
Dialogue: 0,0:21:21.23,0:21:21.98,Default,,0,0,0,,Шындық
Dialogue: 0,0:21:22.11,0:21:22.99,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:21:23.11,0:21:25.49,Default,,0,0,0,,Жаңбыр биі
Dialogue: 0,0:21:25.61,0:21:26.99,Default,,0,0,0,,Маған музыканы беріңіз
Dialogue: 0,0:22:02.98,0:22:04.11,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:22:04.23,0:22:07.57,Default,,0,0,0,,Патша жаңбыр жаудырды
Dialogue: 0,0:22:07.86,0:22:11.20,Default,,0,0,0,,Тимо мен Масикулаға рахмет
Dialogue: 0,0:22:11.33,0:22:15.66,Default,,0,0,0,,Би билеген мен болдым. Ол қиын.
Dialogue: 0,0:22:15.79,0:22:16.71,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:22:16.83,0:22:20.92,Default,,0,0,0,,Радио кассета ойнатқышының жаңғырған даусын тыңдайық
Dialogue: 0,0:22:23.21,0:22:25.42,Default,,0,0,0,,Бұл дымқыл мереке.
Dialogue: 0,0:22:26.38,0:22:28.63,Default,,0,0,0,,Дондон иісі
Dialogue: 0,0:22:34.51,0:22:35.72,Default,,0,0,0,,Сәлем
Dialogue: 0,0:23:06.00,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Akira Horiike
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
