Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:52.34,0:00:53.05,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:00:55.34,0:00:56.84,Default,,0,0,0,,Бұл бір нәрсе үшін бе?
Dialogue: 0,0:00:56.97,0:00:58.93,Default,,0,0,0,,Иә, Морис.
Dialogue: 0,0:00:59.05,0:01:03.35,Default,,0,0,0,,Ол әдемі және ақылды ханзада болғаннан бері...
Dialogue: 0,0:01:03.48,0:01:07.81,Default,,0,0,0,,Көргенімше, оны өз патшалығыма айналдыру менің арманым еді.
Dialogue: 0,0:01:07.94,0:01:10.02,Default,,0,0,0,,Менің де түс көретінмін.
Dialogue: 0,0:01:10.32,0:01:12.19,Default,,0,0,0,,Бір күні мен жоғарылатамын...
Dialogue: 0,0:01:12.32,0:01:13.36,Default,,0,0,0,,Дамаре
Dialogue: 0,0:01:13.86,0:01:15.74,Default,,0,0,0,,Маған сенің әңгімең керек емес.
Dialogue: 0,0:01:16.15,0:01:17.45,Default,,0,0,0,,Менің әңгімем
Dialogue: 0,0:01:17.57,0:01:21.74,Default,,0,0,0,,Аспанға қарасаң, біртүрлі нәрсені байқайсың, солай ма?
Dialogue: 0,0:01:22.54,0:01:26.54,Default,,0,0,0,,Ашық түнгі аспандағы жұлдыздарды көремін
Dialogue: 0,0:01:28.46,0:01:29.25,Default,,0,0,0,,осы портта бір жерде жасырынып, бізді бақылап отыр.
Dialogue: 0,0:01:29.38,0:01:30.04,Default,,0,0,0,,Ай?
Dialogue: 0,0:01:30.17,0:01:32.13,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:01:32.92,0:01:38.64,Default,,0,0,0,,Айға қарасам, айды көремін, бірақ ол патшалыққа жатпайды.
Dialogue: 0,0:01:38.76,0:01:40.26,Default,,0,0,0,,Бірдеңе істеу керек
Dialogue: 0,0:01:40.39,0:01:45.02,Default,,0,0,0,,Айға барып, патшалығыңды белгіле.
Dialogue: 0,0:01:45.14,0:01:48.06,Default,,0,0,0,,Сонымен, айдың бәрі жартасты...
Dialogue: 0,0:01:48.19,0:01:50.65,Default,,0,0,0,,Бөксені ысқылаңыз
Dialogue: 0,0:01:51.56,0:01:53.23,Default,,0,0,0,,Әлі де менің соңымнан келесің бе?
Dialogue: 0,0:01:53.36,0:01:56.24,Default,,0,0,0,,Кенеттен шықпаңыз, қорқынышты.
Dialogue: 0,0:01:56.36,0:01:57.53,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:01:57.65,0:02:01.95,Default,,0,0,0,,Алдымен қолтырауындар айға лазерлік қару орнатты...
Dialogue: 0,0:02:02.08,0:02:06.25,Default,,0,0,0,,Мадагаскарды қоса, әлемді билей алады
Dialogue: 0,0:02:08.04,0:02:09.46,Default,,0,0,0,,Жоғары бес
Dialogue: 0,0:02:13.25,0:02:16.59,Default,,0,0,0,,Кловердің адасуы рас болса...
Dialogue: 0,0:02:16.71,0:02:19.26,Default,,0,0,0,,Ғарыштық қолтырауындар басқарады
Dialogue: 0,0:02:19.38,0:02:21.26,Default,,0,0,0,,Бір ғана нәрсе істеу керек
Dialogue: 0,0:02:21.39,0:02:22.14,Default,,0,0,0,,Тоқта
Dialogue: 0,0:02:22.26,0:02:24.56,Default,,0,0,0,,Морис, айға барайық.
Dialogue: 0,0:02:24.68,0:02:26.56,Default,,0,0,0,,Ал… біз Карт Титанмен біріктік ➡
Dialogue: 0,0:02:27.52,0:02:31.65,Default,,0,0,0,,Тимо Оларға айға бара алмайтынын түсіндір.
Dialogue: 0,0:02:31.77,0:02:34.40,Default,,0,0,0,,Бұл жақсы, бірақ сен өтірікші боласың.
Dialogue: 0,0:02:35.69,0:02:39.99,Default,,0,0,0,,Біз айға бара аламыз, мен көмектесемін.
Dialogue: 0,0:02:40.11,0:02:42.57,Default,,0,0,0,,Жүрегім дүрсілдеп, терлеймін
Dialogue: 0,0:02:42.70,0:02:44.70,Default,,0,0,0,,Махаббат деген осындай ма?
Dialogue: 0,0:02:44.83,0:02:45.95,Default,,0,0,0,,Жоқ, шындап.
Dialogue: 0,0:02:46.08,0:02:49.66,Default,,0,0,0,,Айға лазерлік қару қоя аласыз ба?
Dialogue: 0,0:02:49.79,0:02:50.79,Default,,0,0,0,,Жеңілмейтін!
Dialogue: 0,0:02:53.92,0:02:56.09,Default,,0,0,0,,Айтайын дегенім... тамаша.
Dialogue: 0,0:02:56.21,0:03:00.05,Default,,0,0,0,,...
Dialogue: 0,0:03:00.17,0:03:01.59,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:03:01.72,0:03:04.01,Default,,0,0,0,,Менің үйім – ескі ғарыш кемесі
Dialogue: 0,0:03:04.14,0:03:07.31,Default,,0,0,0,,Сіздің үйіңіз айға барады ма?
Dialogue: 0,0:03:07.43,0:03:09.93,Default,,0,0,0,,Жоқ, себебі оның ішінде жиһаз бар.
Dialogue: 0,0:03:10.06,0:03:13.94,Default,,0,0,0,,Бірақ басқа ғарыш кемелері де бар.
Dialogue: 0,0:03:17.15,0:03:18.86,Default,,0,0,0,,Менің ойымша, бұл жақында жұмыс істейді
Dialogue: 0,0:03:18.99,0:03:19.94,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:03:20.40,0:03:23.87,Default,,0,0,0,,Мен ғарышқа ұшуға жаттығамын.
Dialogue: 0,0:03:25.12,0:03:28.41,Default,,0,0,0,,...
Dialogue: 0,0:03:32.79,0:03:34.54,Default,,0,0,0,,Менің халқым
Dialogue: 0,0:03:34.67,0:03:38.84,Default,,0,0,0,,―
Dialogue: 0,0:03:38.96,0:03:41.84,Default,,0,0,0,,Өйткені бұл өте керемет
Dialogue: 0,0:03:42.97,0:03:45.76,Default,,0,0,0,,Ауа-райы тамаша, құрал-жабдықтар тамаша жағдайда.
Dialogue: 0,0:03:45.89,0:03:47.89,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:03:48.01,0:03:50.81,Default,,0,0,0,,Мына нәрсені аспанға ұшырайық!
Dialogue: 0,0:03:52.98,0:03:56.27,Default,,0,0,0,,...
Dialogue: 0,0:03:57.32,0:04:02.07,Default,,0,0,0,,...
Dialogue: 0,0:04:02.99,0:04:07.66,Default,,0,0,0,,...
Dialogue: 0,0:04:07.78,0:04:08.70,Default,,0,0,0,,Оны артқа қалдырайық
Dialogue: 0,0:04:08.83,0:04:10.75,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:04:10.87,0:04:11.66,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:12.54,0:04:14.42,Default,,0,0,0,,Бұл төтенше жағдай ма?
Dialogue: 0,0:04:14.50,0:04:15.88,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:04:16.75,0:04:17.75,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:04:17.88,0:04:22.13,Default,,0,0,0,,...
Dialogue: 0,0:04:23.42,0:04:24.22,Default,,0,0,0,,Ум...
Dialogue: 0,0:04:25.47,0:04:28.35,Default,,0,0,0,,Қықылдаған елес! Басқа
Dialogue: 0,0:04:29.47,0:04:31.89,Default,,0,0,0,,Онда... Фосса болды.
Dialogue: 0,0:04:32.23,0:04:33.73,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:35.14,0:04:38.98,Default,,0,0,0,,Үш бас! Бір емес, бір...
Dialogue: 0,0:04:39.90,0:04:41.19,Default,,0,0,0,,Үлкен бас!
Dialogue: 0,0:04:42.57,0:04:45.78,Default,,0,0,0,,Басы әдеттен тыс үлкен шұңқыр?
Dialogue: 0,0:04:46.16,0:04:48.53,Default,,0,0,0,,Бұл қауіпті. Бұл рас сияқты.
Dialogue: 0,0:04:48.66,0:04:50.70,Default,,0,0,0,,Қазір қайту
Dialogue: 0,0:04:52.70,0:04:54.41,Default,,0,0,0,,Төтенше жағдай қайда?
Dialogue: 0,0:04:54.54,0:05:00.25,Default,,0,0,0,,...
Dialogue: 0,0:05:00.84,0:05:03.21,Default,,0,0,0,,Ол қайтып келмей тұрып, жарықтандырыңыз.
Dialogue: 0,0:05:06.43,0:05:09.60,Default,,0,0,0,,...
Dialogue: 0,0:05:09.72,0:05:12.97,Default,,0,0,0,,Менің уақытым жоқ. Мен ғарыш кемесіне түсуім керек.
Dialogue: 0,0:05:14.89,0:05:16.94,Default,,0,0,0,,Ғарыш кемесінен басқару бөлмесіне дейін
Dialogue: 0,0:05:17.56,0:05:20.40,Default,,0,0,0,,Бұл ғарыш кемесі, мені естіп тұрсың ба?
Dialogue: 0,0:05:20.48,0:05:22.32,Default,,0,0,0,,Мен сізді анық естимін
Dialogue: 0,0:05:22.44,0:05:23.86,Default,,0,0,0,,Іске қосуға санаулы күндер қалды...
Dialogue: 0,0:05:23.99,0:05:25.99,Default,,0,0,0,,5 секунд… 4 секунд…
Dialogue: 0,0:05:26.28,0:05:29.45,Default,,0,0,0,,３… ２… １
Dialogue: 0,0:05:34.58,0:05:37.42,Default,,0,0,0,,Сіз артта қалдыңыз.
Dialogue: 0,0:05:46.88,0:05:51.64,Default,,0,0,0,,Морис Бұл салмақсыз. Тәжірибе жасап көрейік.
Dialogue: 0,0:05:53.64,0:05:56.73,Default,,0,0,0,,Біртүрлі ән айтып тұр
Dialogue: 0,0:05:57.73,0:06:00.69,Default,,0,0,0,,Бұл диспетчерлік пункт, жағдай туралы есеп беру.
Dialogue: 0,0:06:01.65,0:06:02.32,Default,,0,0,0,,осы портта бір жерде жасырынып, бізді бақылап отыр.
Dialogue: 0,0:06:02.69,0:06:04.44,Default,,0,0,0,,Мүмкін кеңістікте
Dialogue: 0,0:06:04.57,0:06:09.32,Default,,0,0,0,,Бұл C L O... Беде Сіз нені айтасыз?
Dialogue: 0,0:06:09.45,0:06:10.87,Default,,0,0,0,,Неліктен артта қалды?
Dialogue: 0,0:06:11.53,0:06:15.08,Default,,0,0,0,,Тимо желге алаңдап, күте алмады.
Dialogue: 0,0:06:15.33,0:06:16.62,Default,,0,0,0,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,0:06:17.12,0:06:18.41,Default,,0,0,0,,Бұл жақсы сылтау.
Dialogue: 0,0:06:18.54,0:06:19.75,Default,,0,0,0,,Мен оны естимін.
Dialogue: 0,0:06:19.87,0:06:21.21,Default,,0,0,0,,Мен сізді естимін
Dialogue: 0,0:06:21.33,0:06:22.42,Default,,0,0,0,,Сәлем Кловер
Dialogue: 0,0:06:23.46,0:06:25.96,Default,,0,0,0,,Қалай болғанда да, мен қазір салмақсызмын...
Dialogue: 0,0:06:27.01,0:06:29.18,Default,,0,0,0,,Жақсы айқай? Жаман айқай?
Dialogue: 0,0:06:30.72,0:06:31.51,Default,,0,0,0,,Морис!
Dialogue: 0,0:06:35.77,0:06:37.14,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:06:37.98,0:06:39.44,Default,,0,0,0,,Сіз мені ести аласыз ба?
Dialogue: 0,0:06:39.56,0:06:41.60,Default,,0,0,0,,Бірдеңе дұрыс емес
Dialogue: 0,0:06:42.23,0:06:43.31,Default,,0,0,0,,Екеуің қайдасыңдар?
Dialogue: 0,0:06:44.61,0:06:47.74,Default,,0,0,0,,Менің патшама не істедің?
Dialogue: 0,0:06:47.86,0:06:49.36,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:06:49.82,0:06:52.74,Default,,0,0,0,,Түсіндім, сен де сәтсіздікке ұшырайсың.
Dialogue: 0,0:06:55.20,0:06:59.58,Default,,0,0,0,,Енді ұрысуға болмайды! Мен ғаламның патшасын табуым керек
Dialogue: 0,0:06:59.71,0:07:01.17,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:07:01.37,0:07:03.63,Default,,0,0,0,,Морт сізге айтып береді.
Dialogue: 0,0:07:07.38,0:07:08.05,Default,,0,0,0,,Патша
Dialogue: 0,0:07:09.80,0:07:10.97,Default,,0,0,0,,Король?
Dialogue: 0,0:07:11.68,0:07:13.80,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:14.47,0:07:15.81,Default,,0,0,0,,Мықты
Dialogue: 0,0:07:17.60,0:07:18.47,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:07:24.81,0:07:27.94,Default,,0,0,0,,Сенің қолыңнан келеді, Морис, бұл жай тіл.
Dialogue: 0,0:07:28.07,0:07:30.28,Default,,0,0,0,,Ешкім қарап тұрған жоқ
Dialogue: 0,0:07:32.74,0:07:33.95,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:34.07,0:07:35.28,Default,,0,0,0,,Көмектесуге тырысу
Dialogue: 0,0:07:35.41,0:07:37.12,Default,,0,0,0,,Темекі шегу тілі?
Dialogue: 0,0:07:38.58,0:07:43.17,Default,,0,0,0,,Тіпті медициналық тұрғыдан алғанда, бұл өте жиіркенішті.
Dialogue: 0,0:07:43.29,0:07:44.42,Default,,0,0,0,,Күте тұрыңыз, бұл қайда?
Dialogue: 0,0:07:45.63,0:07:48.05,Default,,0,0,0,,Морис Мен мұны істедім.
Dialogue: 0,0:07:49.17,0:07:50.55,Default,,0,0,0,,Айға келді
Dialogue: 0,0:07:50.67,0:07:52.26,Default,,0,0,0,,Зерттеп көрейік
Dialogue: 0,0:07:52.38,0:07:55.72,Default,,0,0,0,,Оны ашпаңыз! Мен дем ала алмайтын шығармын
Dialogue: 0,0:07:55.85,0:08:00.02,Default,,0,0,0,,Не? Мен есікті аштым, оны естімедім.
Dialogue: 0,0:08:00.27,0:08:01.81,Default,,0,0,0,,Тартыңыз!
Dialogue: 0,0:08:01.93,0:08:03.23,Default,,0,0,0,,Сіз нені жабасыз?
Dialogue: 0,0:08:06.48,0:08:09.40,Default,,0,0,0,,Оны итеріп тастау ақылға қонымды ма?
Dialogue: 0,0:08:09.53,0:08:11.99,Default,,0,0,0,,Мен дем ала алмайтын шығармын
Dialogue: 0,0:08:14.07,0:08:15.82,Default,,0,0,0,,Мен дем ала алмаймын...
Dialogue: 0,0:08:17.20,0:08:19.45,Default,,0,0,0,,Ауа жоқ...
Dialogue: 0,0:08:23.21,0:08:24.46,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:08:24.71,0:08:28.29,Default,,0,0,0,,Жарайды, өліп қалмас үшін дем аламын.
Dialogue: 0,0:08:29.09,0:08:30.96,Default,,0,0,0,,Не? Сіз қалай білесіз?
Dialogue: 0,0:08:31.09,0:08:35.55,Default,,0,0,0,,Өйткені бұл ай емес. Ай сонда.
Dialogue: 0,0:08:36.14,0:08:39.81,Default,,0,0,0,,Иә, мен не болғанын білемін.
Dialogue: 0,0:08:39.93,0:08:41.14,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:08:41.27,0:08:43.18,Default,,0,0,0,,Айдың үстінде ұшу-
Dialogue: 0,0:08:43.31,0:08:47.02,Default,,0,0,0,,Біз Марсқа бірінші рет келдік!
Dialogue: 0,0:08:47.69,0:08:48.86,Default,,0,0,0,,Жоғары бес!
Dialogue: 0,0:08:49.52,0:08:51.73,Default,,0,0,0,,Лемурдың бір кішкентай қадамы
Dialogue: 0,0:08:51.86,0:08:55.78,Default,,0,0,0,,Бұл мүмкін емес деген адам тозаққа түсуі керек.
Dialogue: 0,0:08:56.66,0:09:01.74,Default,,0,0,0,,Ақсақ лазерлерді жасайтын қолтырауындар жеңіледі.
Dialogue: 0,0:09:02.58,0:09:05.04,Default,,0,0,0,,Өз патшалығыңызды белгілеңіз
Dialogue: 0,0:09:05.41,0:09:06.42,Default,,0,0,0,,Мен олай істеуден аулақпын.
Dialogue: 0,0:09:06.58,0:09:07.46,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:09:16.05,0:09:20.30,Default,,0,0,0,,Маған бұл біздің планета екенін көрсетуге көмектесемін.
Dialogue: 0,0:09:26.94,0:09:29.06,Default,,0,0,0,,Сіздің бөкселеріңіз ұнайды
Dialogue: 0,0:09:31.90,0:09:34.24,Default,,0,0,0,,Осы сияқты... сезім?
Dialogue: 0,0:09:35.49,0:09:36.20,Default,,0,0,0,,Морис
Dialogue: 0,0:09:36.86,0:09:39.53,Default,,0,0,0,,Сіз мені естисіз бе? жауап беру
Dialogue: 0,0:09:40.45,0:09:44.08,Default,,0,0,0,,Мен есептеулерде қателескен сияқтымын.
Dialogue: 0,0:09:44.33,0:09:47.37,Default,,0,0,0,,Мен бұдан артық өкіне алмадым.
Dialogue: 0,0:09:47.62,0:09:50.63,Default,,0,0,0,,Рефлексия жеткіліксіз!
Dialogue: 0,0:09:58.43,0:09:59.59,Default,,0,0,0,,Тірі!
Dialogue: 0,0:09:59.93,0:10:02.81,Default,,0,0,0,,Мен ғарышқа шыға алмадым.
Dialogue: 0,0:10:02.93,0:10:05.43,Default,,0,0,0,,Бірақ мен тірімін, иә
Dialogue: 0,0:10:05.56,0:10:07.94,Default,,0,0,0,,Триангуляция арқылы орынды табу
Dialogue: 0,0:10:08.06,0:10:10.94,Default,,0,0,0,,Мен сенің жүзіңді үшбұрышқа айналдырамын!
Dialogue: 0,0:10:12.69,0:10:14.73,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:10:15.11,0:10:15.94,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:16.07,0:10:19.57,Default,,0,0,0,,Біз халқымыздың үмітін ақтауымыз керек.
Dialogue: 0,0:10:24.04,0:10:25.29,Default,,0,0,0,,Культ жетекшісін табынатын ізбасардың сезімі
Dialogue: 0,0:10:25.45,0:10:27.12,Default,,0,0,0,,Келіңіздер, шетелдіктерді іздейік
Dialogue: 0,0:10:27.79,0:10:32.00,Default,,0,0,0,,Мен марсиялықтарға өзімнің патша екенімді білуім керек.
Dialogue: 0,0:10:32.13,0:10:34.71,Default,,0,0,0,,Марс қызыл болуы керек
Dialogue: 0,0:10:34.84,0:10:37.09,Default,,0,0,0,,Әлі де Мадагаскардасыз ба?
Dialogue: 0,0:10:44.31,0:10:46.43,Default,,0,0,0,,4 минуттан кейін
Dialogue: 0,0:10:55.36,0:10:58.28,Default,,0,0,0,,Оның шабуылға ниеті жоқ сияқты.
Dialogue: 0,0:11:00.99,0:11:02.20,Default,,0,0,0,,Станислав
Dialogue: 0,0:11:02.32,0:11:07.04,Default,,0,0,0,,Сіз біртүрлі ғарыш тілінде сөйлеп жатырсыз, яғни...
Dialogue: 0,0:11:08.50,0:11:10.83,Default,,0,0,0,,Бұл кеңістік, сіз жоғалтасыз.
Dialogue: 0,0:11:12.25,0:11:13.29,Default,,0,0,0,,Сіздің атыңыз?
Dialogue: 0,0:11:13.42,0:11:14.92,Default,,0,0,0,,Станислав
Dialogue: 0,0:11:15.04,0:11:18.76,Default,,0,0,0,,Сәлеметсіз бе, мен Джулиен корольмін.
Dialogue: 0,0:11:18.88,0:11:22.43,Default,,0,0,0,,Бұл менің досым Морис.
Dialogue: 0,0:11:22.55,0:11:26.60,Default,,0,0,0,,Мен Марста болғаныма өте қуаныштымын.
Dialogue: 0,0:11:30.77,0:11:34.11,Default,,0,0,0,,Ол менің Марс патшасымен кездесуімді қалайды.
Dialogue: 0,0:11:34.36,0:11:36.40,Default,,0,0,0,,Бұл Марс емес.
Dialogue: 0,0:11:36.52,0:11:39.07,Default,,0,0,0,,Мені патшаға апарыңыз.
Dialogue: 0,0:11:43.74,0:11:46.45,Default,,0,0,0,,Бұл Марс өнерінің бір бөлігі.
Dialogue: 0,0:11:58.88,0:12:02.13,Default,,0,0,0,,Өнер туындыларынан ләззат алсам да...
Dialogue: 0,0:12:02.26,0:12:04.59,Default,,0,0,0,,Бөтен шу - кедергі
Dialogue: 0,0:12:04.72,0:12:05.80,Default,,0,0,0,,Қате түсінбе.
Dialogue: 0,0:12:07.05,0:12:08.18,Default,,0,0,0,,Жоспар
Dialogue: 0,0:12:08.47,0:12:12.23,Default,,0,0,0,,Ол әдемі, шашты әйел.
Dialogue: 0,0:12:12.35,0:12:14.31,Default,,0,0,0,,Дәл сіз сияқты
Dialogue: 0,0:12:14.94,0:12:16.48,Default,,0,0,0,,Комплимент айтпау
Dialogue: 0,0:12:17.11,0:12:20.86,Default,,0,0,0,,Марсиялықтар сұлулық байқауларында жеңіске жете алмайды.
Dialogue: 0,0:12:20.99,0:12:23.20,Default,,0,0,0,,Бұл Марс емес.
Dialogue: 0,0:12:23.32,0:12:24.95,Default,,0,0,0,,Егер бұл Марс болмаса...
Dialogue: 0,0:12:25.07,0:12:28.41,Default,,0,0,0,,Неліктен бұл Марс әскері мұнда?
Dialogue: 0,0:12:33.00,0:12:35.67,Default,,0,0,0,,Қозғалмасаң, білмейсің
Dialogue: 0,0:12:40.00,0:12:41.34,Default,,0,0,0,,Ол қозғалды
Dialogue: 0,0:12:44.43,0:12:45.80,Default,,0,0,0,,Қайта жылжытылды
Dialogue: 0,0:12:46.05,0:12:47.85,Default,,0,0,0,,Тыныш патша
Dialogue: 0,0:12:49.56,0:12:51.81,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:12:58.23,0:12:59.36,Default,,0,0,0,,Артық емес
Dialogue: 0,0:13:01.40,0:13:02.28,Default,,0,0,0,,Жан-Пьер Польнарефф
Dialogue: 0,0:13:09.99,0:13:10.70,Default,,0,0,0,,Король?
Dialogue: 0,0:13:13.12,0:13:14.62,Default,,0,0,0,,Сәлем Король
Dialogue: 0,0:13:15.58,0:13:18.63,Default,,0,0,0,,Патша жоқ, Марс Кловер
Dialogue: 0,0:13:19.21,0:13:21.00,Default,,0,0,0,,Жер беде
Dialogue: 0,0:13:21.13,0:13:23.51,Default,,0,0,0,,Ұлы патша!
Dialogue: 0,0:13:24.05,0:13:27.68,Default,,0,0,0,,Мадагаскарда бірінші шимпанзе табылды
Dialogue: 0,0:13:30.35,0:13:33.47,Default,,0,0,0,,Шимпан бла «марсиандық» дегенді білдіреді ме?
Dialogue: 0,0:13:33.77,0:13:37.73,Default,,0,0,0,,Шимпанзелер – маймылдар. Олар Мадагаскарда тұрмайды.
Dialogue: 0,0:13:37.85,0:13:38.90,Default,,0,0,0,,Сонда ол ше?
Dialogue: 0,0:13:39.19,0:13:40.31,Default,,0,0,0,,Міне.
Dialogue: 0,0:13:41.15,0:13:44.82,Default,,0,0,0,,Ресей ғарыштық бағдарламасына қатысқан болуы мүмкін.
Dialogue: 0,0:13:44.94,0:13:47.53,Default,,0,0,0,,Иә! анасы Ресей
Dialogue: 0,0:13:49.24,0:13:50.20,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:13:50.49,0:13:52.66,Default,,0,0,0,,Бұл Марс емес пе?
Dialogue: 0,0:13:53.08,0:13:54.87,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:13:56.58,0:13:58.08,Default,,0,0,0,,Қалай болғанда да, Ах!
Dialogue: 0,0:13:58.33,0:14:00.42,Default,,0,0,0,,Халықтың көңілі қалды.
Dialogue: 0,0:14:00.67,0:14:02.46,Default,,0,0,0,,Міндетті емес
Dialogue: 0,0:14:02.59,0:14:05.17,Default,,0,0,0,,Бұл нағыз ғарыштық маймыл.
Dialogue: 0,0:14:05.30,0:14:09.34,Default,,0,0,0,,Егер ол менде болса, мен айға бара алатыныма сенімдімін.
Dialogue: 0,0:14:09.64,0:14:10.39,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:14:10.51,0:14:12.93,Default,,0,0,0,,Бұл менің өмірімдегі ең жақсы күн
Dialogue: 0,0:14:13.18,0:14:14.93,Default,,0,0,0,,Король бақытты!
Dialogue: 0,0:14:20.65,0:14:21.31,Default,,0,0,0,,``Қош келдіңіз, король Джульен!''
Dialogue: 0,0:14:21.31,0:14:23.36,Default,,0,0,0,,``Қош келдіңіз, король Джульен!''
Dialogue: 0,0:14:21.31,0:14:23.36,Default,,0,0,0,,Сәлем халқым
Dialogue: 0,0:14:23.36,0:14:23.48,Default,,0,0,0,,``Қош келдіңіз, король Джульен!''
Dialogue: 0,0:14:23.48,0:14:27.07,Default,,0,0,0,,``Қош келдіңіз, король Джульен!''
Dialogue: 0,0:14:23.48,0:14:27.07,Default,,0,0,0,,Мені лайықты қарсы алғаныңыз үшін рахмет.
Dialogue: 0,0:14:30.03,0:14:33.78,Default,,0,0,0,,Жаман және жақсы жаңалық бар.
Dialogue: 0,0:14:33.91,0:14:36.50,Default,,0,0,0,,Бір жаманы, мен айға бара алмадым.
Dialogue: 0,0:14:38.04,0:14:41.58,Default,,0,0,0,,Сонда қолтырауын алдымен Айға барады...
Dialogue: 0,0:14:41.71,0:14:43.96,Default,,0,0,0,,Біз лазерлік қаруды орнатамыз.
Dialogue: 0,0:14:44.21,0:14:47.13,Default,,0,0,0,,үшінна лазер беріледі!
Dialogue: 0,0:14:48.67,0:14:49.88,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:14:50.18,0:14:53.97,Default,,0,0,0,,Сұлу да талантты патша жаңа идеяны ойлап тапты.
Dialogue: 0,0:14:54.10,0:14:58.93,Default,,0,0,0,,Мына ғарыш маймылынан айға баруға көмектесуін сұрайық.
Dialogue: 0,0:14:59.06,0:15:02.56,Default,,0,0,0,,Мен бұл қозғалатын бөксемен ант етемін
Dialogue: 0,0:15:07.36,0:15:12.03,Default,,0,0,0,,Көріп отырғаныңыздай, мен шешімін білмеймін.
Dialogue: 0,0:15:15.58,0:15:17.87,Default,,0,0,0,,Шешілген сияқты.
Dialogue: 0,0:15:18.33,0:15:20.71,Default,,0,0,0,,Керемет Сіз оны қайдан үйрендіңіз?
Dialogue: 0,0:15:20.83,0:15:21.58,Default,,0,0,0,,Жоспар
Dialogue: 0,0:15:21.71,0:15:23.63,Default,,0,0,0,,Сіз ақылды анасыз, солай емес пе?
Dialogue: 0,0:15:23.75,0:15:27.67,Default,,0,0,0,,Бұл керемет есеп. Маған көбірек көрсет.
Dialogue: 0,0:15:28.17,0:15:29.34,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:15:29.47,0:15:30.51,Default,,0,0,0,,Керемет
Dialogue: 0,0:15:30.63,0:15:32.93,Default,,0,0,0,,Тез мініңіз
Dialogue: 0,0:15:33.05,0:15:34.01,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:15:34.14,0:15:37.35,Default,,0,0,0,,Станислав Мен айға бара аламын.
Dialogue: 0,0:15:37.51,0:15:39.06,Default,,0,0,0,,Ай? ай?
Dialogue: 0,0:15:39.18,0:15:41.39,Default,,0,0,0,,Басқа үй үй!
Dialogue: 0,0:15:41.52,0:15:45.23,Default,,0,0,0,,Иә, ай сіздің жаңа үйіңіз болады.
Dialogue: 0,0:15:48.11,0:15:51.95,Default,,0,0,0,,Айға барғысы келмей ме?
Dialogue: 0,0:15:52.07,0:15:55.74,Default,,0,0,0,,Не? Мен барғым келетініне сенімдімін
Dialogue: 0,0:15:58.83,0:16:00.41,Default,,0,0,0,,Бұл рух.
Dialogue: 0,0:16:00.54,0:16:02.62,Default,,0,0,0,,Басқа ана ана!
Dialogue: 0,0:16:02.75,0:16:06.21,Default,,0,0,0,,Иә, сіздің анаңыздың проблемасы проблема.
Dialogue: 0,0:16:06.34,0:16:09.55,Default,,0,0,0,,Маманнан кеңес алуға болады.
Dialogue: 0,0:16:09.67,0:16:11.09,Default,,0,0,0,,Анашым!
Dialogue: 0,0:16:11.67,0:16:15.47,Default,,0,0,0,,Өз еліңізде «ана» деген не? Мүмкін мен Ресейге қайтқым келеді
Dialogue: 0,0:16:18.18,0:16:19.52,Default,,0,0,0,,Ана Ресей
Dialogue: 0,0:16:20.18,0:16:23.56,Default,,0,0,0,,Ресейдің құмды жағажайларын сағындың ба?
Dialogue: 0,0:16:23.69,0:16:27.06,Default,,0,0,0,,Жолың болды, үйіңе апарамыз.
Dialogue: 0,0:16:27.94,0:16:28.86,Default,,0,0,0,,Сен бұны істей аласың ба?
Dialogue: 0,0:16:28.98,0:16:29.73,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:29.86,0:16:31.78,Default,,0,0,0,,Мен сені Ресейге қайтарамын
Dialogue: 0,0:16:34.32,0:16:38.58,Default,,0,0,0,,Станислав, сен бізді оқыттың...
Dialogue: 0,0:16:38.70,0:16:41.75,Default,,0,0,0,,Егер сіз маған ғарышқа ұшу туралы үйретсеңіз...
Dialogue: 0,0:16:41.87,0:16:44.50,Default,,0,0,0,,Және лазерлік қаруды орнату.
Dialogue: 0,0:16:44.62,0:16:48.09,Default,,0,0,0,,Лазер туралы айтпаңыз, бұл қорқынышты.
Dialogue: 0,0:16:48.46,0:16:53.17,Default,,0,0,0,,Мені айға апарсаң, мен сені Ресейге қайтарамын.
Dialogue: 0,0:16:54.13,0:16:54.93,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:16:56.39,0:16:57.68,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:17:00.76,0:17:01.64,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:17:02.02,0:17:06.31,Default,,0,0,0,,Кәне, бәріміз, қиын жаттығуды бастайық.
Dialogue: 0,0:17:06.60,0:17:08.02,Default,,0,0,0,,Бұл жолы нақты
Dialogue: 0,0:17:27.04,0:17:28.63,Default,,0,0,0,,Оған қанша уақыт қажет болды?
Dialogue: 0,0:17:29.29,0:17:32.05,Default,,0,0,0,,Бұл жаңа рекорд екені сөзсіз.
Dialogue: 0,0:17:32.50,0:17:33.30,Default,,0,0,0,,4 секунд
Dialogue: 0,0:17:34.17,0:17:37.18,Default,,0,0,0,,Иә! Бұл өздігінен жаңа
Dialogue: 0,0:17:56.20,0:17:57.78,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:18:00.53,0:18:01.95,Default,,0,0,0,,Ештеңе шықпайды
Dialogue: 0,0:18:15.59,0:18:18.88,Default,,0,0,0,,Баяу қозғалыстағы көрініс
Dialogue: 0,0:18:19.01,0:18:22.22,Default,,0,0,0,,Бұл ғарышкерлер үшін ең маңызды дағды.
Dialogue: 0,0:18:22.81,0:18:23.76,Default,,0,0,0,,Сіз бара аласыз.
Dialogue: 0,0:18:28.19,0:18:29.52,Default,,0,0,0,,А... Патша?
Dialogue: 0,0:18:29.90,0:18:32.36,Default,,0,0,0,,Іс жүзінде мәселе бар
Dialogue: 0,0:18:32.48,0:18:37.53,Default,,0,0,0,,Айға барсақ, Ресейге бара алмаймыз, өйткені отын жетпейді.
Dialogue: 0,0:18:37.65,0:18:40.03,Default,,0,0,0,,Бұл сыртқы келбетіңізге кедергі келтіре ме?
Dialogue: 0,0:18:40.16,0:18:44.49,Default,,0,0,0,,Станиславқа қайтып оралуға болмайтынын түсіндіріңіз...
Dialogue: 0,0:18:45.74,0:18:49.71,Default,,0,0,0,,Бірақ мен уәде бердім, үйге қайтқым келеді.
Dialogue: 0,0:18:49.83,0:18:50.62,Default,,0,0,0,,Тіпті проблема бар ма?
Dialogue: 0,0:18:50.75,0:18:52.63,Default,,0,0,0,,Жарайды, мен бірден барамын.
Dialogue: 0,0:18:53.29,0:18:55.09,Default,,0,0,0,,Халқым...
Dialogue: 0,0:18:55.88,0:18:58.51,Default,,0,0,0,,Айға баруды асыға күтемін
Dialogue: 0,0:18:59.80,0:19:01.18,Default,,0,0,0,,Ел үміті.
Dialogue: 0,0:19:01.30,0:19:04.30,Default,,0,0,0,,Жарайды, мен Станиславқа айтуым керек.
Dialogue: 0,0:19:04.56,0:19:07.85,Default,,0,0,0,,Мен айдан қайтқанда, сөйлесу керек.
Dialogue: 0,0:19:07.98,0:19:11.81,Default,,0,0,0,,Ол кезде сіз Ресейді ұмытып кетесіз.
Dialogue: 0,0:19:16.02,0:19:17.53,Default,,0,0,0,,Халқым
Dialogue: 0,0:19:17.65,0:19:20.78,Default,,0,0,0,,Бүгін біз айға аттанамыз.
Dialogue: 0,0:19:21.16,0:19:26.16,Default,,0,0,0,,Бөксеге ант етемін, Айға жетемін.
Dialogue: 0,0:19:26.29,0:19:29.75,Default,,0,0,0,,Өйткені ол нағыз ғарыш маймылымен бірге келеді.
Dialogue: 0,0:19:29.87,0:19:30.87,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:19:31.00,0:19:33.79,Default,,0,0,0,,Станиславты үйге әкелетін отын...
Dialogue: 0,0:19:33.92,0:19:36.67,Default,,0,0,0,,Жетпейді деген қауесеттер рас!
Dialogue: 0,0:19:39.42,0:19:42.18,Default,,0,0,0,,Сіз бір нәрсені жасыра алмайсыз.
Dialogue: 0,0:19:42.30,0:19:44.64,Default,,0,0,0,,Ана? ана?
Dialogue: 0,0:19:46.97,0:19:49.06,Default,,0,0,0,,Анашым! ана!
Dialogue: 0,0:19:49.18,0:19:50.39,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:19:51.81,0:19:54.02,Default,,0,0,0,,Бұл өте күшті, солай емес пе?
Dialogue: 0,0:19:58.98,0:20:01.20,Default,,0,0,0,,Сәлем бәріңе!
Dialogue: 0,0:20:01.32,0:20:04.45,Default,,0,0,0,,Сіз менің үйімді көре аласыз
Dialogue: 0,0:20:04.57,0:20:06.20,Default,,0,0,0,,Бірдеңе істеу керек
Dialogue: 0,0:20:06.28,0:20:06.95,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:20:07.03,0:20:08.99,Default,,0,0,0,,Жоқ, айтамын.
Dialogue: 0,0:20:09.12,0:20:12.37,Default,,0,0,0,,Себебі ол мені құрметтейді...
Dialogue: 0,0:20:12.50,0:20:15.33,Default,,0,0,0,,Ол патшаның жүзін көтереді.
Dialogue: 0,0:20:17.96,0:20:21.09,Default,,0,0,0,,Бұл патшаның жүзін ерекше көрсетпейді. Бұл Тамма.
Dialogue: 0,0:20:23.68,0:20:24.76,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:25.93,0:20:29.60,Default,,0,0,0,,Үйге баруды асыға күттің.
Dialogue: 0,0:20:29.72,0:20:31.23,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:31.35,0:20:33.94,Default,,0,0,0,,Ұлы Ресеймен салыстырғанда-
Dialogue: 0,0:20:34.06,0:20:37.52,Default,,0,0,0,,Мадагаскар қызықсыз, солай емес пе?
Dialogue: 0,0:20:42.28,0:20:44.74,Default,,0,0,0,,Бірақ оны Ресейге қайтару мүмкін емес.
Dialogue: 0,0:20:44.86,0:20:47.74,Default,,0,0,0,,Айды алу үшін
Dialogue: 0,0:20:47.87,0:20:50.37,Default,,0,0,0,,Үлкен лазер де!
Dialogue: 0,0:20:50.79,0:20:51.95,Default,,0,0,0,,Бұл үлкен арман, бірақ...
Dialogue: 0,0:20:52.08,0:20:56.67,Default,,0,0,0,,Ғажайыптар жасау үшін үлкен армандау керек.
Dialogue: 0,0:20:56.92,0:21:00.75,Default,,0,0,0,,Айдағы лемурды елестетіңіз
Dialogue: 0,0:21:00.88,0:21:02.76,Default,,0,0,0,,Бұл ғажайып, солай емес пе?
Dialogue: 0,0:21:02.97,0:21:06.01,Default,,0,0,0,,Сондықтан түсініңіз.
Dialogue: 0,0:21:11.18,0:21:12.77,Default,,0,0,0,,Бұл бетті жасамаңыз
Dialogue: 0,0:21:13.14,0:21:15.39,Default,,0,0,0,,Тілегің орындалса...
Dialogue: 0,0:21:15.52,0:21:19.23,Default,,0,0,0,,Менің тілектерім орындалмайды
Dialogue: 0,0:21:23.57,0:21:28.53,Default,,0,0,0,,５… ４… ３… ２… １
Dialogue: 0,0:21:33.87,0:21:38.58,Default,,0,0,0,,Оны үйге әкелу үшін армандарыңнан бас тарттыңдар.
Dialogue: 0,0:21:38.71,0:21:39.38,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:21:39.54,0:21:43.46,Default,,0,0,0,,Ресейде климат қаншалықты еркін және жақсы болса да...
Dialogue: 0,0:21:43.59,0:21:47.84,Default,,0,0,0,,Мен болсам, осында қайтып оралғым келеді.
Dialogue: 0,0:21:56.48,0:22:01.48,Default,,0,0,0,,Айда лазерлік қарумен қолтырауын сенен қалай озып кете алады?
Dialogue: 0,0:22:01.61,0:22:03.36,Default,,0,0,0,,Жарайды Кловер
Dialogue: 0,0:22:03.48,0:22:08.82,Default,,0,0,0,,Қолтырауын қай әлемде Айға бара алады?
Dialogue: 0,0:22:09.74,0:22:12.20,Default,,0,0,0,,Лазерлер одан да қиын.
Dialogue: 0,0:22:14.12,0:22:17.37,Default,,0,0,0,,Айға лазерлік қару орнаттық.
Dialogue: 0,0:22:17.50,0:22:20.25,Default,,0,0,0,,Ол дұрыс жұмыс істейді
Dialogue: 0,0:22:20.38,0:22:22.79,Default,,0,0,0,,Жерге оралу...
Dialogue: 0,0:22:23.21,0:22:26.30,Default,,0,0,0,,Үйге қалай жетуім керек?
Dialogue: 0,0:22:27.92,0:22:30.22,Default,,0,0,0,,Жоқ, ол бұзылған.
Dialogue: 0,0:22:32.60,0:22:34.14,Default,,0,0,0,,Қарым-қатынас жасау мүмкін емес
Dialogue: 0,0:22:34.85,0:22:35.77,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:22:36.10,0:22:37.56,Default,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:23:06.13,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Михо Ичихара
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
