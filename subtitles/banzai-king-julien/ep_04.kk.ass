Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:47.13,0:00:49.42,Default,,0,0,0,,Тамағым кепті.
Dialogue: 0,0:00:49.59,0:00:52.17,Default,,0,0,0,,Патша суды қалайды.
Dialogue: 0,0:00:52.30,0:00:55.30,Default,,0,0,0,,Морис! маған сусын бер
Dialogue: 0,0:00:56.09,0:00:58.93,Default,,0,0,0,,Қолтығым неге терлейді?
Dialogue: 0,0:01:02.35,0:01:05.39,Default,,0,0,0,,Сіз кімсіз және неге менің жатын бөлмемдесіз?
Dialogue: 0,0:01:05.69,0:01:07.73,Default,,0,0,0,,Бүркіт Сәлем
Dialogue: 0,0:01:07.85,0:01:09.69,Default,,0,0,0,,Патшаны қорқытпа
Dialogue: 0,0:01:10.11,0:01:15.74,Default,,0,0,0,,Патшаның асыл көзі шаршап, тамыры шығып кетті.
Dialogue: 0,0:01:16.15,0:01:20.70,Default,,0,0,0,,Мүмкін, кешкі ойын-сауықты қысқарту керек шығар.
Dialogue: 0,0:01:20.83,0:01:24.91,Default,,0,0,0,,Король Джульен! Король Джулиен!
Dialogue: 0,0:01:25.04,0:01:27.21,Default,,0,0,0,,Морис, дереу кел.
Dialogue: 0,0:01:27.33,0:01:30.71,Default,,0,0,0,,Иә, иә, мен су әкелдім.
Dialogue: 0,0:01:33.71,0:01:35.01,Default,,0,0,0,,Су емес!
Dialogue: 0,0:01:35.13,0:01:37.30,Default,,0,0,0,,Бұл дәмді болды.
Dialogue: 0,0:01:37.43,0:01:40.14,Default,,0,0,0,,Неліктен барлығы ішке қарайды?
Dialogue: 0,0:01:43.18,0:01:45.14,Default,,0,0,0,,Юбе туралы не есте қалды?
Dialogue: 0,0:01:45.27,0:01:48.10,Default,,0,0,0,,Патшаның еске алатын уақыты жоқ.
Dialogue: 0,0:01:48.23,0:01:49.98,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:01:50.11,0:01:54.48,Default,,0,0,0,,Патша үлкен той жасады.
Dialogue: 0,0:01:58.07,0:01:59.70,Default,,0,0,0,,үшін тыңдайды
Dialogue: 0,0:01:59.82,0:02:01.91,Default,,0,0,0,,«Патша» десеңіз…
Dialogue: 0,0:02:02.03,0:02:02.91,Default,,0,0,0,,Джулиан!
Dialogue: 0,0:02:03.03,0:02:04.12,Default,,0,0,0,,– Патша! - Джулиан!
Dialogue: 0,0:02:04.24,0:02:06.00,Default,,0,0,0,,- Патша! - Джулиан!
Dialogue: 0,0:02:06.12,0:02:10.21,Default,,0,0,0,,Мен лемур патшасымын, қолымнан бәрі келеді.
Dialogue: 0,0:02:20.18,0:02:21.80,Default,,0,0,0,,Осыдан кейін?
Dialogue: 0,0:02:21.93,0:02:26.18,Default,,0,0,0,,Бұл қызықты уақыт болды деп ойлаймын, бірақ есімде жоқ.
Dialogue: 0,0:02:26.31,0:02:28.85,Default,,0,0,0,,Осы уақытқа дейін бұл жақсы.
Dialogue: 0,0:02:28.98,0:02:33.23,Default,,0,0,0,,Патша той-думанын тоқтатқан жоқ, қимылдата берді.
Dialogue: 0,0:02:34.65,0:02:37.90,Default,,0,0,0,,Мен сені жақсы көремін, халқым.
Dialogue: 0,0:02:38.11,0:02:42.07,Default,,0,0,0,,Дороти еденді құшақтап жатыр ма?
Dialogue: 0,0:02:42.45,0:02:46.87,Default,,0,0,0,,Масикура, денеңді көбірек сырғыт.
Dialogue: 0,0:02:47.25,0:02:49.16,Default,,0,0,0,,Мен ілгекті тым көп шешіп алдым
Dialogue: 0,0:02:53.67,0:02:55.63,Default,,0,0,0,,Сен мен жағындасың, Гектор.
Dialogue: 0,0:02:56.05,0:02:58.13,Default,,0,0,0,,Маған сеніңіз Тед
Dialogue: 0,0:02:58.55,0:03:02.30,Default,,0,0,0,,Уақытың болса тыңдаймын, Вилли.
Dialogue: 0,0:03:02.76,0:03:06.06,Default,,0,0,0,,Біз Морт ағайындымыз
Dialogue: 0,0:03:06.18,0:03:07.89,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:03:08.64,0:03:13.40,Default,,0,0,0,,Барлық мәселелер мен даулар...
Dialogue: 0,0:03:13.52,0:03:16.19,Default,,0,0,0,,Мен оны шешемін
Dialogue: 0,0:03:16.32,0:03:17.98,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:03:18.28,0:03:21.70,Default,,0,0,0,,Әрқашан қош келдіңіз
Dialogue: 0,0:03:25.16,0:03:29.75,Default,,0,0,0,,Сондықтан бәрі бізге кеңес сұрайды.
Dialogue: 0,0:03:30.04,0:03:32.92,Default,,0,0,0,,Менің жүрегім үлкен болғандықтан.
Dialogue: 0,0:03:33.04,0:03:36.50,Default,,0,0,0,,Менің жоқ екенімді айт
Dialogue: 0,0:03:36.63,0:03:37.92,Default,,0,0,0,,Қаралған
Dialogue: 0,0:03:38.34,0:03:40.76,Default,,0,0,0,,Олай болса, декларациядан бас тартыңыз.
Dialogue: 0,0:03:40.88,0:03:43.26,Default,,0,0,0,,Кингтің алғашқы мәлімдемесі
Dialogue: 0,0:03:43.38,0:03:45.97,Default,,0,0,0,,Бас тартсаңыз, сенімділік жоғалады...
Dialogue: 0,0:03:46.10,0:03:49.43,Default,,0,0,0,,Тәртіпсіздік басталды! терезеден алыс
Dialogue: 0,0:03:54.35,0:03:57.98,Default,,0,0,0,,Онда тұрма, аздап үрейлен.
Dialogue: 0,0:03:58.11,0:03:59.65,Default,,0,0,0,,Тәртіпсіздік емес
Dialogue: 0,0:03:59.98,0:04:02.36,Default,,0,0,0,,Өйткені бәрі бірге жиналды...
Dialogue: 0,0:04:04.41,0:04:05.41,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:05.53,0:04:07.91,Default,,0,0,0,,Байқамай аузым тайып кетті
Dialogue: 0,0:04:08.03,0:04:12.29,Default,,0,0,0,,Мен бәріне көмектесемін дедім, бірақ қателесіппін.
Dialogue: 0,0:04:12.41,0:04:14.71,Default,,0,0,0,,Патша бәріне уәде берді.
Dialogue: 0,0:04:14.83,0:04:15.83,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:15.96,0:04:19.75,Default,,0,0,0,,Өйткені бәрі уайымдап, шағымданды.
Dialogue: 0,0:04:19.88,0:04:22.80,Default,,0,0,0,,Жасыру мүмкін емес
Dialogue: 0,0:04:23.22,0:04:26.14,Default,,0,0,0,,үшінна уәде етілгендей көмектесіңіз
Dialogue: 0,0:04:26.26,0:04:27.80,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:04:27.97,0:04:31.72,Default,,0,0,0,,Арман мен үмітке толы жүзге қарашы.
Dialogue: 0,0:04:31.85,0:04:34.69,Default,,0,0,0,,Лемурлардың бір шоғыры ғана
Dialogue: 0,0:04:34.81,0:04:36.94,Default,,0,0,0,,Бірге бірігу қауіпті
Dialogue: 0,0:04:37.06,0:04:38.82,Default,,0,0,0,,Сіз тым көп ойлап отырсыз.
Dialogue: 0,0:04:38.94,0:04:42.24,Default,,0,0,0,,Тек тым көп ойлау
Dialogue: 0,0:04:42.36,0:04:45.15,Default,,0,0,0,,Мен олай ойламаймын...
Dialogue: 0,0:04:45.66,0:04:48.57,Default,,0,0,0,,Құйрықтың бұлдырылуы. Бұл қауіпті.
Dialogue: 0,0:04:48.70,0:04:49.83,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:49.95,0:04:52.58,Default,,0,0,0,,Бақылау пунктін құру
Dialogue: 0,0:04:53.33,0:04:57.17,Default,,0,0,0,,Құйрығыңмен жүр-
Dialogue: 0,0:04:57.29,0:04:58.58,Default,,0,0,0,,Нантоканы жасаңыз
Dialogue: 0,0:04:58.71,0:04:59.46,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:05:00.50,0:05:02.92,Default,,0,0,0,,Мен бірінші нөмірлі патшамен сөйлесемін ...
Dialogue: 0,0:05:03.05,0:05:04.47,Default,,0,0,0,,Уайымдама, солай ма?
Dialogue: 0,0:05:04.59,0:05:06.68,Default,,0,0,0,,Бар
Dialogue: 0,0:05:06.80,0:05:09.60,Default,,0,0,0,,Мен патшаның мені жақын ұстауын қалаймын.
Dialogue: 0,0:05:09.72,0:05:13.77,Default,,0,0,0,,Кловерге күдікті адамды табуға көмектесіңіз
Dialogue: 0,0:05:13.89,0:05:14.77,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:05:15.10,0:05:19.11,Default,,0,0,0,,Патшаға Ая мен Шииді табыңыз!
Dialogue: 0,0:05:19.23,0:05:21.36,Default,,0,0,0,,Мына бала түсінеді ме?
Dialogue: 0,0:05:25.57,0:05:26.57,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:05:30.83,0:05:32.58,Default,,0,0,0,,Қолдарыңызды жайыңыз
Dialogue: 0,0:05:38.50,0:05:39.46,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:39.58,0:05:41.00,Default,,0,0,0,,Бұл сыйлық
Dialogue: 0,0:05:41.13,0:05:44.26,Default,,0,0,0,,Кингтің бананға деген құмарлығы әйгілі.
Dialogue: 0,0:05:45.01,0:05:46.34,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:05:46.47,0:05:47.76,Default,,0,0,0,,Мен ойлағандай
Dialogue: 0,0:05:48.26,0:05:49.30,Default,,0,0,0,,Морт!
Dialogue: 0,0:05:49.43,0:05:50.34,Default,,0,0,0,,Сіз оны оқыдыңыз ба?
Dialogue: 0,0:05:50.47,0:05:52.31,Default,,0,0,0,,4-қадам Бастау
Dialogue: 0,0:05:52.43,0:05:55.10,Default,,0,0,0,,Резеңке қолғап кию керек
Dialogue: 0,0:05:56.02,0:05:58.60,Default,,0,0,0,,Олай болса бастайық
Dialogue: 0,0:05:58.73,0:06:02.90,Default,,0,0,0,,Маған қиналған Мористі әкеліңіз
Dialogue: 0,0:06:03.69,0:06:06.74,Default,,0,0,0,,Бұл Абнер мен Бекка.
Dialogue: 0,0:06:06.86,0:06:09.74,Default,,0,0,0,,Менің не істегенімді қалайсың?
Dialogue: 0,0:06:09.86,0:06:11.41,Default,,0,0,0,,Су ішетін фонтан.
Dialogue: 0,0:06:11.53,0:06:12.74,Default,,0,0,0,,Сасық
Dialogue: 0,0:06:12.87,0:06:15.50,Default,,0,0,0,,Мен іше алмаймын және жүзе алмаймын.
Dialogue: 0,0:06:15.62,0:06:17.04,Default,,0,0,0,,Ол лас.
Dialogue: 0,0:06:17.29,0:06:20.33,Default,,0,0,0,,Мен күн сайын фонтанға барамын.
Dialogue: 0,0:06:20.46,0:06:24.88,Default,,0,0,0,,Суы таза, салқын, дәмді.
Dialogue: 0,0:06:25.00,0:06:26.51,Default,,0,0,0,,Тыныс алу
Dialogue: 0,0:06:27.30,0:06:28.63,Default,,0,0,0,,Бұл жалбыздың иісі.
Dialogue: 0,0:06:31.34,0:06:34.89,Default,,0,0,0,,Бұл патшаның су ішетін фонтаны
Dialogue: 0,0:06:35.01,0:06:37.52,Default,,0,0,0,,Екі адам не айтып тұр?
Dialogue: 0,0:06:37.64,0:06:39.60,Default,,0,0,0,,Ауылдың су бұрқағы
Dialogue: 0,0:06:40.23,0:06:45.19,Default,,0,0,0,,Суы бұлтты, өлген жәндіктерге толы кім?
Dialogue: 0,0:06:46.78,0:06:50.15,Default,,0,0,0,,Мен бұл ішімдікті жақсы білемін.
Dialogue: 0,0:06:50.28,0:06:50.99,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:51.11,0:06:52.28,Default,,0,0,0,,Жөндеу?
Dialogue: 0,0:06:52.41,0:06:55.33,Default,,0,0,0,,Король Джулиан XIII
Dialogue: 0,0:06:55.45,0:07:01.29,Default,,0,0,0,,Сіз ішуге және жүзуге болатын көңілді суару шұңқыры.
Dialogue: 0,0:07:01.46,0:07:03.96,Default,,0,0,0,,Қайта жасау туралы мәлімдеме
Dialogue: 0,0:07:04.13,0:07:04.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:05.04,0:07:05.80,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:07:06.05,0:07:09.13,Default,,0,0,0,,Құрылысты ерекше күні бастаңыз
Dialogue: 0,0:07:09.26,0:07:12.26,Default,,0,0,0,,Бұл «бір күні»
Dialogue: 0,0:07:12.39,0:07:14.47,Default,,0,0,0,,Сәлем Король
Dialogue: 0,0:07:14.97,0:07:17.31,Default,,0,0,0,,Уәде беру оңай.
Dialogue: 0,0:07:17.43,0:07:19.31,Default,,0,0,0,,Сіз оны қорғауыңыз керек.
Dialogue: 0,0:07:19.48,0:07:21.39,Default,,0,0,0,,Мен бұл туралы кейінірек ойланамын.
Dialogue: 0,0:07:21.52,0:07:22.48,Default,,0,0,0,,Келесі!
Dialogue: 0,0:07:22.60,0:07:24.98,Default,,0,0,0,,Ағашта жаман геккон бар...
Dialogue: 0,0:07:25.15,0:07:28.48,Default,,0,0,0,,«Бұл манго емес» Бұл...
Dialogue: 0,0:07:28.65,0:07:32.16,Default,,0,0,0,,Мен көбірек құпиялылықты қалаймын
Dialogue: 0,0:07:32.28,0:07:38.24,Default,,0,0,0,,Түні бойы сөйлесеміз, сөйлесеміз.
Dialogue: 0,0:07:39.33,0:07:41.75,Default,,0,0,0,,Сонымен қатар, әлі де айтатын нәрсе бар...
Dialogue: 0,0:07:42.29,0:07:45.42,Default,,0,0,0,,Сіз бастағаныңызға қанша уақыт болды?
Dialogue: 0,0:07:45.54,0:07:46.96,Default,,0,0,0,,20 минут
Dialogue: 0,0:07:48.13,0:07:51.42,Default,,0,0,0,,Басқалардың уайымы қызықсыз!
Dialogue: 0,0:07:51.59,0:07:52.76,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:07:52.88,0:07:58.26,Default,,0,0,0,,Жарайды, менің де әңгімемнің ортасында ұйқым қашады.
Dialogue: 0,0:07:58.39,0:07:59.89,Default,,0,0,0,,, келесі
Dialogue: 0,0:08:00.02,0:08:02.35,Default,,0,0,0,,Мен енді мұны істей алмаймын, Морис.
Dialogue: 0,0:08:02.52,0:08:05.61,Default,,0,0,0,,Қанша сұрасаң да солай
Dialogue: 0,0:08:05.73,0:08:10.36,Default,,0,0,0,,Мен «Патша» немесе «Патша» дегеннен басқа ештеңе естімеймін.
Dialogue: 0,0:08:10.49,0:08:14.16,Default,,0,0,0,,үшінның деңгейі менен төмен.
Dialogue: 0,0:08:14.28,0:08:17.62,Default,,0,0,0,,Біз өз деңгейімізді төмендетуіміз керек.
Dialogue: 0,0:08:17.99,0:08:21.29,Default,,0,0,0,,Ауылды өз көзімізбен көрейік
Dialogue: 0,0:08:21.41,0:08:24.79,Default,,0,0,0,,Алдымен су ішетін фонтанға барайық.
Dialogue: 0,0:08:25.33,0:08:26.50,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:08:26.63,0:08:29.00,Default,,0,0,0,,Мен онсызда қиындыққа тап болар едім
Dialogue: 0,0:08:33.51,0:08:36.30,Default,,0,0,0,,Қараңызшы, оның орнын басқан патша бар.
Dialogue: 0,0:08:36.43,0:08:39.39,Default,,0,0,0,,Қайсысы нақты екенін айта аласыз ба?
Dialogue: 0,0:08:39.51,0:08:41.56,Default,,0,0,0,,Ол сөйлеп тұр.
Dialogue: 0,0:08:41.68,0:08:44.85,Default,,0,0,0,,Әрине... жоқ!
Dialogue: 0,0:08:47.06,0:08:48.69,Default,,0,0,0,,Сыртқа шығып кеткеніме сене алар емеспін
Dialogue: 0,0:08:48.86,0:08:49.82,Default,,0,0,0,,Қазірдің өзінде шықты
Dialogue: 0,0:08:49.94,0:08:51.48,Default,,0,0,0,,Бұл жалған...
Dialogue: 0,0:08:51.61,0:08:53.15,Default,,0,0,0,,Король Джулиен?
Dialogue: 0,0:08:57.28,0:08:59.58,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:09:01.29,0:09:04.41,Default,,0,0,0,,Морттың көзінен қалай өтуге болады...
Dialogue: 0,0:09:04.54,0:09:07.75,Default,,0,0,0,,Сізге бетперде керек.
Dialogue: 0,0:09:08.88,0:09:12.42,Default,,0,0,0,,Банан? Бұл жабысқақ және жиіркенішті.
Dialogue: 0,0:09:13.38,0:09:16.97,Default,,0,0,0,,Күте тұрыңыз, мен бананды ұнатпағаныммен танымалмын.
Dialogue: 0,0:09:17.09,0:09:20.60,Default,,0,0,0,,Егер сіз мұны өзіңізбен бірге алып жүрсеңіз...
Dialogue: 0,0:09:20.72,0:09:22.85,Default,,0,0,0,,Адамдар мені мен деп ойлауына жол берме
Dialogue: 0,0:09:22.97,0:09:24.10,Default,,0,0,0,,Қалталар ше?
Dialogue: 0,0:09:24.23,0:09:26.10,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:26.27,0:09:28.10,Default,,0,0,0,,Өтірік айтудың қажеті жоқ
Dialogue: 0,0:09:28.81,0:09:29.94,Default,,0,0,0,,Тоқта
Dialogue: 0,0:09:31.73,0:09:34.86,Default,,0,0,0,,Эй Морт... Жоқ, мистер.
Dialogue: 0,0:09:34.99,0:09:35.82,Default,,0,0,0,,Король?
Dialogue: 0,0:09:35.95,0:09:37.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:37.57,0:09:41.99,Default,,0,0,0,,Ол сенің сүйікті Патшаңа ұқсайды...
Dialogue: 0,0:09:42.12,0:09:43.20,Default,,0,0,0,,Иә, мен оны жақсы көремін.
Dialogue: 0,0:09:43.33,0:09:48.12,Default,,0,0,0,,Сенде тәж жоқ, сенде банан бар, солай ма?
Dialogue: 0,0:09:49.33,0:09:52.30,Default,,0,0,0,,Король банан сияқты үлкен.
Dialogue: 0,0:09:52.42,0:09:55.34,Default,,0,0,0,,Бананды жек көретін патшаны қорға
Dialogue: 0,0:09:55.46,0:09:56.55,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:09:57.59,0:09:58.80,Default,,0,0,0,,Король?
Dialogue: 0,0:10:00.85,0:10:02.97,Default,,0,0,0,,Бірдеңе айт
Dialogue: 0,0:10:06.31,0:10:10.15,Default,,0,0,0,,Патшаның үндемеу себебі...
Dialogue: 0,0:10:10.27,0:10:12.73,Default,,0,0,0,,Басқалардың айтқанын тыңдау керек пе?
Dialogue: 0,0:10:13.57,0:10:15.32,Default,,0,0,0,,Ал мен үшін ол аса маңызды емес.
Dialogue: 0,0:10:15.44,0:10:17.70,Default,,0,0,0,,Сіз осылай айтасыз.
Dialogue: 0,0:10:17.82,0:10:20.62,Default,,0,0,0,,Тезірек ойлану керек еді
Dialogue: 0,0:10:20.74,0:10:22.58,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:23.95,0:10:25.49,Default,,0,0,0,,Мүмкін мен бара аламын.
Dialogue: 0,0:10:25.62,0:10:26.33,Default,,0,0,0,,Келесі!
Dialogue: 0,0:10:33.34,0:10:36.42,Default,,0,0,0,,Сәлеметсіз бе, бананды маймыл мырза
Dialogue: 0,0:10:36.55,0:10:38.51,Default,,0,0,0,,Бұл жерде отырма
Dialogue: 0,0:10:38.63,0:10:40.84,Default,,0,0,0,,Сіздің атыңыз кім? Банан мырза
Dialogue: 0,0:10:40.97,0:10:43.43,Default,,0,0,0,,Аты? Бұл дұрыс
Dialogue: 0,0:10:43.55,0:10:46.27,Default,,0,0,0,,Бұл банан микрофоны.
Dialogue: 0,0:10:46.39,0:10:52.36,Default,,0,0,0,,Егер сіз мұнда су ішуге немесе жүзуге келсеңіз, мұны істей алмайсыз.
Dialogue: 0,0:10:53.02,0:10:54.90,Default,,0,0,0,,Мен патшаның оны түзететінін естідім.
Dialogue: 0,0:10:55.02,0:10:56.53,Default,,0,0,0,,«Бір күні»
Dialogue: 0,0:10:56.65,0:10:58.94,Default,,0,0,0,,Алдыңғы патша да солай айтқан.
Dialogue: 0,0:10:59.32,0:11:00.24,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:11:00.40,0:11:04.70,Default,,0,0,0,,...
Dialogue: 0,0:11:09.79,0:11:12.71,Default,,0,0,0,,“”
Dialogue: 0,0:11:12.83,0:11:16.38,Default,,0,0,0,,Енді әрекет ету уақыты
Dialogue: 0,0:11:25.43,0:11:27.06,Default,,0,0,0,,Мәселе мынада
Dialogue: 0,0:11:28.18,0:11:29.35,Default,,0,0,0,,Мен кептеліп қалдым
Dialogue: 0,0:11:33.65,0:11:35.90,Default,,0,0,0,,Онда көтерілме
Dialogue: 0,0:11:36.02,0:11:38.48,Default,,0,0,0,,Иә, түс.
Dialogue: 0,0:11:38.78,0:11:41.36,Default,,0,0,0,,Сіз әлі де сенесіз бе?
Dialogue: 0,0:11:41.49,0:11:47.41,Default,,0,0,0,,“”
Dialogue: 0,0:11:48.66,0:11:51.71,Default,,0,0,0,,Онда қолтырауын өмір сүреді.
Dialogue: 0,0:11:52.12,0:11:54.21,Default,,0,0,0,,Қош бол, Майк
Dialogue: 0,0:12:35.79,0:12:39.75,Default,,0,0,0,,...
Dialogue: 0,0:12:39.88,0:12:43.47,Default,,0,0,0,,Иә, патшаның пайдасы жоқ.
Dialogue: 0,0:12:43.59,0:12:45.38,Default,,0,0,0,,Оны кім жөндеді?
Dialogue: 0,0:12:45.51,0:12:46.93,Default,,0,0,0,,Майк
Dialogue: 0,0:12:47.05,0:12:51.85,Default,,0,0,0,,үшінна! Майк ішетін фонтанды жөндеді.
Dialogue: 0,0:12:54.77,0:12:57.98,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,0:12:58.11,0:13:00.61,Default,,0,0,0,,Майк үшін мүмкін емес ештеңе жоқ
Dialogue: 0,0:13:00.77,0:13:01.94,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:13:02.07,0:13:03.32,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:13:03.44,0:13:05.03,Default,,0,0,0,,Сұрақтарға жауап беріңіз
Dialogue: 0,0:13:05.15,0:13:07.16,Default,,0,0,0,,Сөйлемесең жарайды.
Dialogue: 0,0:13:07.28,0:13:09.70,Default,,0,0,0,,Сіз ауырасыз
Dialogue: 0,0:13:09.83,0:13:11.99,Default,,0,0,0,,Сіз шалбар киіп жүрсіз бе?
Dialogue: 0,0:13:12.16,0:13:14.83,Default,,0,0,0,,Тәкі мен оны ағызып жіберемін.
Dialogue: 0,0:13:14.96,0:13:17.92,Default,,0,0,0,,Не? Мен үйге бара жатырмын.
Dialogue: 0,0:13:18.17,0:13:22.84,Default,,0,0,0,,･
Dialogue: 0,0:13:22.96,0:13:25.97,Default,,0,0,0,,Маған алаңдаған ұнайды
Dialogue: 0,0:13:26.97,0:13:29.68,Default,,0,0,0,,Енді анықтап көрейік.
Dialogue: 0,0:13:31.22,0:13:32.72,Default,,0,0,0,,Жарайды, міне, гострайтингі тапсырысы формасы.
Dialogue: 0,0:13:36.48,0:13:38.48,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:13:38.60,0:13:41.90,Default,,0,0,0,,Морт! 1 адамға арналған ақпарат
Dialogue: 0,0:13:44.15,0:13:47.36,Default,,0,0,0,,Мен іші-сыртын тексеремін.
Dialogue: 0,0:13:50.37,0:13:54.62,Default,,0,0,0,,10 …
Dialogue: 0,0:13:54.75,0:13:56.08,Default,,0,0,0,,Жетеді
Dialogue: 0,0:13:56.21,0:13:57.96,Default,,0,0,0,,Әрі қарай...
Dialogue: 0,0:13:58.08,0:13:59.96,Default,,0,0,0,,Сіз қалай ойлайсыз? патша
Dialogue: 0,0:14:00.88,0:14:06.05,Default,,0,0,0,,Король жақсы ма? Тірі емес сияқты
Dialogue: 0,0:14:08.55,0:14:11.14,Default,,0,0,0,,Түсінемін, бұл тамаша.
Dialogue: 0,0:14:11.55,0:14:12.89,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:14:13.06,0:14:15.31,Default,,0,0,0,,Егер сіз патша болсаңыз ше?
Dialogue: 0,0:14:15.68,0:14:21.52,Default,,0,0,0,,Мен болсам, «Өткенді ұмытып, бүгінмен өмір сүр» дер едім.
Dialogue: 0,0:14:21.81,0:14:25.03,Default,,0,0,0,,Бұл жақсы кеңес, мен оны қолданамын.
Dialogue: 0,0:14:25.15,0:14:28.95,Default,,0,0,0,,Кетеріңізде өзіңізбен бірге сувенир личи алыңыз.
Dialogue: 0,0:14:30.57,0:14:32.74,Default,,0,0,0,,Жақсы топтық жұмыс.
Dialogue: 0,0:14:32.87,0:14:34.74,Default,,0,0,0,,Міне осылай.
Dialogue: 0,0:14:36.04,0:14:37.04,Default,,0,0,0,,Келесі!
Dialogue: 0,0:14:41.13,0:14:42.04,Default,,0,0,0,,Бітті
Dialogue: 0,0:14:42.17,0:14:42.88,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:14:43.00,0:14:44.96,Default,,0,0,0,,үшін зерттелді
Dialogue: 0,0:14:47.38,0:14:49.59,Default,,0,0,0,,Халықтың жартысы да келмеді
Dialogue: 0,0:14:49.72,0:14:52.01,Default,,0,0,0,,Морис Бұл не?
Dialogue: 0,0:14:52.26,0:14:56.85,Default,,0,0,0,,Король Джулиен кетіп бара жатқанын айтады...
Dialogue: 0,0:14:56.97,0:14:58.77,Default,,0,0,0,,Жалғыз шығасыз ба?
Dialogue: 0,0:14:58.89,0:15:00.48,Default,,0,0,0,,сәтті алданды
Dialogue: 0,0:15:01.02,0:15:03.61,Default,,0,0,0,,Оның жалған екенін ешкім байқамады ма?
Dialogue: 0,0:15:03.90,0:15:05.73,Default,,0,0,0,,Ешкім соншалықты ақымақ емес.
Dialogue: 0,0:15:06.23,0:15:09.24,Default,,0,0,0,,Бүгінгі патшаның аяқтары біртүрлі.
Dialogue: 0,0:15:09.49,0:15:13.32,Default,,0,0,0,,Құйрық белгісі осыған қатысты болды.
Dialogue: 0,0:15:13.45,0:15:18.70,Default,,0,0,0,,Сіз нені айтасыз? үшін риза болып үйлеріне қайтты.
Dialogue: 0,0:15:18.83,0:15:23.50,Default,,0,0,0,,Мен сенің жолдың жартысы ғана екенін көріп тұрмын. Ал қалғандары ше?
Dialogue: 0,0:15:23.63,0:15:27.59,Default,,0,0,0,,Бұл туралы Кингке неге айтпадың?
Dialogue: 0,0:15:27.71,0:15:32.01,Default,,0,0,0,,Мен бұл туралы айттым, олар бір күні түзетеміз деді.
Dialogue: 0,0:15:32.30,0:15:35.80,Default,,0,0,0,,Қарапайым адамдар мұңаяды
Dialogue: 0,0:15:35.93,0:15:40.14,Default,,0,0,0,,Мен сені құшақтап алғым келеді, бірақ бәрі сондай лас сияқты.
Dialogue: 0,0:15:42.06,0:15:44.61,Default,,0,0,0,,Бұл микрофонның идеясы бар.
Dialogue: 0,0:15:44.73,0:15:48.44,Default,,0,0,0,,Мен айтсам, Патша тыңдайды.
Dialogue: 0,0:15:48.57,0:15:50.49,Default,,0,0,0,,Неге сұрап тұрсыз?
Dialogue: 0,0:15:50.61,0:15:52.03,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:15:52.61,0:15:54.78,Default,,0,0,0,,Бұл маңызды емес
Dialogue: 0,0:15:54.91,0:16:00.50,Default,,0,0,0,,Мәселе мынада, Дэм Кинг бәріне мән бермейді.
Dialogue: 0,0:16:02.41,0:16:07.00,Default,,0,0,0,,Бұл қорқынышты емес пе? Сен қазір тұруың керек
Dialogue: 0,0:16:07.13,0:16:11.67,Default,,0,0,0,,Әңгіме жеткілікті, әрекет жасайық.
Dialogue: 0,0:16:13.93,0:16:16.76,Default,,0,0,0,,Майк – нағыз көшбасшы
Dialogue: 0,0:16:16.89,0:16:19.06,Default,,0,0,0,,«Лемурлар одағы»
Dialogue: 0,0:16:19.18,0:16:22.39,Default,,0,0,0,,«Лемурды азат ету армиясы» жақсы
Dialogue: 0,0:16:22.52,0:16:26.31,Default,,0,0,0,,Оны «Лемур одағының азат ету армиясы» деп атаймыз
Dialogue: 0,0:16:26.44,0:16:29.82,Default,,0,0,0,,қысқаша «LALA». Егер ол ұзақ болса, бұл уақытты босқа өткізу.
Dialogue: 0,0:16:29.94,0:16:34.53,Default,,0,0,0,,Дамекинг пен Мориске революция жариялайық.
Dialogue: 0,0:16:34.66,0:16:37.99,Default,,0,0,0,,Оны елемеуге болмайды. Сіз қалай ойлайсыз?
Dialogue: 0,0:16:38.12,0:16:41.45,Default,,0,0,0,,Лала! Лала!
Dialogue: 0,0:16:57.43,0:16:59.93,Default,,0,0,0,,Мен патшаны іздеймін.
Dialogue: 0,0:17:02.43,0:17:03.89,Default,,0,0,0,,Бұл дауыс ше?
Dialogue: 0,0:17:04.60,0:17:09.57,Default,,0,0,0,,Бұл саяси демонстрация. Бұл дұшпандық топ.
Dialogue: 0,0:17:14.61,0:17:17.16,Default,,0,0,0,,үшін, жоспарды түсіндіңдер ме?
Dialogue: 0,0:17:17.28,0:17:19.32,Default,,0,0,0,,5 минуттан кейін қайтып келмесең...
Dialogue: 0,0:17:24.08,0:17:27.42,Default,,0,0,0,,Мен ауыр жарақат алсам да жақсымын.
Dialogue: 0,0:17:31.25,0:17:33.17,Default,,0,0,0,,Жарайды, ұшайық.
Dialogue: 0,0:17:33.42,0:17:36.59,Default,,0,0,0,,Осы жолы дұрыс көздеңіз.
Dialogue: 0,0:17:36.72,0:17:40.10,Default,,0,0,0,,Маған қалдырыңыз. Мен қажетті есептеулерді жасадым.
Dialogue: 0,0:17:40.22,0:17:42.60,Default,,0,0,0,,Уақыт дұрыс болса...
Dialogue: 0,0:17:46.44,0:17:47.27,Default,,0,0,0,,Тағы бір рет пе?
Dialogue: 0,0:17:47.39,0:17:49.35,Default,,0,0,0,,Лала! Лала!
Dialogue: 0,0:17:49.48,0:17:53.86,Default,,0,0,0,,Бұл жолы жақсы өтеді деп үміттенемін.
Dialogue: 0,0:17:54.78,0:17:57.95,Default,,0,0,0,,Уайымдама, бұл жолы...
Dialogue: 0,0:17:59.57,0:18:01.78,Default,,0,0,0,,Мен өкіне бастадым.
Dialogue: 0,0:18:01.91,0:18:04.91,Default,,0,0,0,,Өзіңізді кінәламаңыз
Dialogue: 0,0:18:05.04,0:18:09.25,Default,,0,0,0,,Бұл жаттығу емес, бұл нағыз төтенше жағдай.
Dialogue: 0,0:18:10.38,0:18:11.63,Default,,0,0,0,,Сіз кімге айтып тұрсыз?
Dialogue: 0,0:18:11.75,0:18:13.63,Default,,0,0,0,,Көрінбейтін дос?
Dialogue: 0,0:18:13.75,0:18:15.01,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:18:15.13,0:18:19.26,Default,,0,0,0,,Менде осындай жағдайларға үлкен дайындық бар.
Dialogue: 0,0:18:28.94,0:18:31.65,Default,,0,0,0,,Дүние бітті, жалған!
Dialogue: 0,0:18:31.98,0:18:35.19,Default,,0,0,0,,Лала! Лала!
Dialogue: 0,0:18:39.99,0:18:40.70,Default,,0,0,0,,Қый!
Dialogue: 0,0:18:40.82,0:18:42.99,Default,,0,0,0,,Жалған заттармен күреспе
Dialogue: 0,0:18:43.12,0:18:45.95,Default,,0,0,0,,КИНГ Бұл үлкен мәселе.
Dialogue: 0,0:18:46.08,0:18:50.71,Default,,0,0,0,,Ашулы халық бүлік шығарды, солай ма?
Dialogue: 0,0:18:50.83,0:18:53.29,Default,,0,0,0,,Бұл өте егжей-тегжейлі.
Dialogue: 0,0:18:53.75,0:18:56.21,Default,,0,0,0,,Патша көтеріліс жасады ма?
Dialogue: 0,0:18:56.34,0:19:01.30,Default,,0,0,0,,Жоқ, банан Майк әділдік үшін...
Dialogue: 0,0:19:01.97,0:19:06.39,Default,,0,0,0,,Сонда мен өзіме қарсы шығып жатырмын ба?
Dialogue: 0,0:19:07.43,0:19:09.56,Default,,0,0,0,,Жалғыз әрекет еткендіктен бе?
Dialogue: 0,0:19:09.69,0:19:10.35,Default,,0,0,0,,Иә
Dialogue: 0,0:19:10.44,0:19:11.56,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:19:11.69,0:19:15.44,Default,,0,0,0,,Майкты тыңдаңыз, сонда түсінесіз.
Dialogue: 0,0:19:15.57,0:19:17.03,Default,,0,0,0,,Патша қорқынышты
Dialogue: 0,0:19:18.53,0:19:21.66,Default,,0,0,0,,Мен онымен сабырмен айналысамын.
Dialogue: 0,0:19:21.78,0:19:23.62,Default,,0,0,0,,Зорлық-зомбылықтан аулақ болу керек
Dialogue: 0,0:19:23.74,0:19:29.33,Default,,0,0,0,,Алдымен бірінші адамды ұрып-соғып, мысалға келтір.
Dialogue: 0,0:19:30.00,0:19:33.38,Default,,0,0,0,,Жалғандыққа жол берілмейді
Dialogue: 0,0:19:33.50,0:19:37.00,Default,,0,0,0,,Бұл менің кінәм, Морис бұл туралы бірдеңе жасайды.
Dialogue: 0,0:19:37.13,0:19:38.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:38.63,0:19:41.97,Default,,0,0,0,,Өзіңізді тазалаңыз
Dialogue: 0,0:19:42.09,0:19:43.97,Default,,0,0,0,,Шық
Dialogue: 0,0:19:45.14,0:19:46.64,Default,,0,0,0,,ұялшақ адам
Dialogue: 0,0:19:47.06,0:19:49.68,Default,,0,0,0,,Күте тұрыңдар, менің субъектілерім.
Dialogue: 0,0:19:49.81,0:19:52.23,Default,,0,0,0,,Басыңызды салқын ұстаңыз
Dialogue: 0,0:19:52.35,0:19:53.65,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:53.77,0:19:54.44,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:54.56,0:19:58.69,Default,,0,0,0,,Бұл патшаның бұйрығы, басыңды салқындат.
Dialogue: 0,0:19:58.82,0:20:00.61,Default,,0,0,0,,Мен бағынуым керек пе?
Dialogue: 0,0:20:00.74,0:20:03.07,Default,,0,0,0,,Бүгін «шешім күні» болды
Dialogue: 0,0:20:03.20,0:20:05.82,Default,,0,0,0,,Оны «төбелес күні» етпеңіз
Dialogue: 0,0:20:05.95,0:20:09.45,Default,,0,0,0,,Кешіріңіз, бұл жақсы сөз болды.
Dialogue: 0,0:20:09.75,0:20:10.91,Default,,0,0,0,,Мен айтқым келді...
Dialogue: 0,0:20:11.04,0:20:16.96,Default,,0,0,0,,Бастапқыда сіздің мәселеңіз қызықсыз болып көрінді.
Dialogue: 0,0:20:17.09,0:20:19.09,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:20:19.21,0:20:24.13,Default,,0,0,0,,Бірақ патша өз халқын түсінуі керек
Dialogue: 0,0:20:24.26,0:20:28.39,Default,,0,0,0,,Әр адамның мәселесі маңызды екенін білдім.
Dialogue: 0,0:20:28.51,0:20:29.39,Default,,0,0,0,,үшінна емес
Dialogue: 0,0:20:29.68,0:20:32.39,Default,,0,0,0,,Осылайша ол бәрін шешеді
Dialogue: 0,0:20:32.52,0:20:36.65,Default,,0,0,0,,Еңбек пен табандылықты қажет етсе де
Dialogue: 0,0:20:36.77,0:20:38.65,Default,,0,0,0,,Міне, мен жек көретін екі нәрсе.
Dialogue: 0,0:20:38.77,0:20:40.86,Default,,0,0,0,,Банан микрофоны туралы не деуге болады?
Dialogue: 0,0:20:43.11,0:20:47.20,Default,,0,0,0,,Түсіндім, бәріне мойындатайық.
Dialogue: 0,0:20:47.41,0:20:48.91,Default,,0,0,0,,Майк -
Dialogue: 0,0:20:49.24,0:20:51.33,Default,,0,0,0,,Ол шарлатан.
Dialogue: 0,0:20:53.21,0:20:58.17,Default,,0,0,0,,Патша өз халқын ойламағандай етіп көрсетуге тырысты.
Dialogue: 0,0:20:58.29,0:21:02.13,Default,,0,0,0,,Бірақ мен барлығына мән беремін.
Dialogue: 0,0:21:02.67,0:21:04.47,Default,,0,0,0,,Микрофон қайда?
Dialogue: 0,0:21:05.38,0:21:10.51,Default,,0,0,0,,Мен енді саған бәрібір емеспін деп айту
Dialogue: 0,0:21:10.64,0:21:12.31,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:12.43,0:21:15.56,Default,,0,0,0,,Алданғаныма сене алар емеспін.
Dialogue: 0,0:21:15.69,0:21:19.31,Default,,0,0,0,,Жақсы жаңалық, бүгіннен бастап...
Dialogue: 0,0:21:19.44,0:21:24.07,Default,,0,0,0,,Әркімнің айтқанын тыңдап, әрекет жасайтын патша бол.
Dialogue: 0,0:21:24.19,0:21:25.49,Default,,0,0,0,,Әрекет патшасы
Dialogue: 0,0:21:25.70,0:21:28.91,Default,,0,0,0,,Егер сіз өз ойыңызды өзгертпесеңіз.
Dialogue: 0,0:21:29.24,0:21:31.03,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:21:31.16,0:21:36.67,Default,,0,0,0,,Әрекет жасайтын патша ретінде мен бірінші істі жасауға бел будым.
Dialogue: 0,0:21:38.04,0:21:40.71,Default,,0,0,0,,Той уақыты келді!
Dialogue: 0,0:21:43.21,0:21:46.84,Default,,0,0,0,,Король Джульен Оны шешпеңіз
Dialogue: 0,0:21:46.97,0:21:48.64,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,0:21:48.76,0:21:51.51,Default,,0,0,0,,Сіз не үшін тұрсыз?
Dialogue: 0,0:21:51.64,0:21:55.31,Default,,0,0,0,,Мен бұл джунглиді жандандырамын.
Dialogue: 0,0:22:03.98,0:22:05.40,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:22:06.45,0:22:07.49,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:22:07.61,0:22:09.20,Default,,0,0,0,,Майк
Dialogue: 0,0:22:09.32,0:22:11.20,Default,,0,0,0,,Өзіңізді...
Dialogue: 0,0:22:11.33,0:22:13.62,Default,,0,0,0,,Микрофон орнын реттеңіз
Dialogue: 0,0:22:13.74,0:22:16.00,Default,,0,0,0,,Дұрыс, не істеуіміз керек?
Dialogue: 0,0:22:16.12,0:22:19.88,Default,,0,0,0,,Екі адам әскер құрып, қараңғылық жамылғысымен қозғалады.
Dialogue: 0,0:22:20.00,0:22:22.79,Default,,0,0,0,,Зұлым патшаны жеңу
Dialogue: 0,0:22:22.92,0:22:23.96,Default,,0,0,0,,Сіз бұл туралы өзіңіз ойладыңыз ба?
Dialogue: 0,0:22:24.09,0:22:24.80,Default,,0,0,0,,Иә
Dialogue: 0,0:22:24.92,0:22:26.59,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:22:26.72,0:22:28.05,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:22:28.18,0:22:29.38,Default,,0,0,0,,Меніңше… біз істеп қойған сияқтымыз, иә?
Dialogue: 0,0:22:29.51,0:22:33.60,Default,,0,0,0,,Король Джулиенді тағынан түсіріңіз
Dialogue: 0,0:22:34.10,0:22:38.69,Default,,0,0,0,,Лала! Лала!
Dialogue: 0,0:22:38.85,0:22:40.31,Default,,0,0,0,,Лала дегеніміз не?
Dialogue: 0,0:23:06.42,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Акико Комори
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
