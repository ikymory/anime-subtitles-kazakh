Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:45.46,0:00:48.17,Default,,0,0,0,,King Тапсырмалар тізімінде ақау бар.
Dialogue: 0,0:00:48.29,0:00:50.25,Default,,0,0,0,,Мәселе неде?
Dialogue: 0,0:00:53.47,0:00:57.72,Default,,0,0,0,,Аяқталмаған жұмыс көп сияқты.
Dialogue: 0,0:00:58.05,0:01:01.06,Default,,0,0,0,,Қылмыстың өсуіне және тұрғын үй тапшылығына қарсы шаралар...
Dialogue: 0,0:01:01.18,0:01:05.56,Default,,0,0,0,,Ол баяу жұмысшы, бірақ мен оны кешіремін.
Dialogue: 0,0:01:05.69,0:01:07.10,Default,,0,0,0,,Бұл сіздің жұмысыңыз
Dialogue: 0,0:01:09.40,0:01:10.48,Default,,0,0,0,,Сәлем
Dialogue: 0,0:01:11.23,0:01:13.49,Default,,0,0,0,,Неліктен Морт балық аулау жолында?
Dialogue: 0,0:01:13.61,0:01:16.32,Default,,0,0,0,,Неліктен? Осы себепті
Dialogue: 0,0:01:16.45,0:01:18.57,Default,,0,0,0,,«Сиқырлы дәм: Король бұршақтары»
Dialogue: 0,0:01:18.70,0:01:20.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:20.62,0:01:24.58,Default,,0,0,0,,«Патша» сөзін көрмейсің бе? Бұл мен.
Dialogue: 0,0:01:24.70,0:01:26.54,Default,,0,0,0,,«Сиқыр» – менің қалауым
Dialogue: 0,0:01:26.66,0:01:28.83,Default,,0,0,0,,Патша, мен демалсам болады ма?
Dialogue: 0,0:01:28.96,0:01:33.25,Default,,0,0,0,,Жіп қазып, ішім жарылып кетердей.
Dialogue: 0,0:01:33.38,0:01:36.22,Default,,0,0,0,,Менің сиқырлы бұршақтарымды алдың ба?
Dialogue: 0,0:01:37.63,0:01:38.43,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:01:39.14,0:01:42.60,Default,,0,0,0,,Бұл патшаның жұмысынан маңыздырақ, солай ма?
Dialogue: 0,0:01:46.56,0:01:47.81,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:01:49.77,0:01:50.44,Default,,0,0,0,,Морт!
Dialogue: 0,0:01:50.56,0:01:51.69,Default,,0,0,0,,Менің бұршақтарым!
Dialogue: 0,0:02:01.12,0:02:02.45,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:02:02.58,0:02:05.04,Default,,0,0,0,,Қолтырауынның асқазанында аздап еріген
Dialogue: 0,0:02:05.04,0:02:05.66,Default,,0,0,0,,Қолтырауынның асқазанында аздап еріген
Dialogue: 0,0:02:05.04,0:02:05.66,Default,,0,0,0,,«Кофені қалай дайындау керек»
Dialogue: 0,0:02:05.66,0:02:06.45,Default,,0,0,0,,«Кофені қалай дайындау керек»
Dialogue: 0,0:02:06.58,0:02:08.50,Default,,0,0,0,,«Сиқырлы дәм: Король бұршақтары»
Dialogue: 0,0:02:10.96,0:02:14.50,Default,,0,0,0,,Сиқыр? Бұл жай бұршаққа ұқсайды
Dialogue: 0,0:02:14.63,0:02:17.88,Default,,0,0,0,,Бұл сиқырлы бұршақ екені анық
Dialogue: 0,0:02:18.01,0:02:20.51,Default,,0,0,0,,Мені теңіз құдайы жіберді
Dialogue: 0,0:02:20.64,0:02:21.51,Default,,0,0,0,,Патша…
Dialogue: 0,0:02:24.31,0:02:26.39,Default,,0,0,0,,Күте тұрыңыз, бірдеңе болады.
Dialogue: 0,0:02:30.94,0:02:32.56,Default,,0,0,0,,Тамақтағы заттар
Dialogue: 0,0:02:37.90,0:02:40.41,Default,,0,0,0,,Ешқандай сиқыр жоқ сияқты.
Dialogue: 0,0:02:40.53,0:02:42.28,Default,,0,0,0,,Патша, мынаны қараңыз.
Dialogue: 0,0:02:42.87,0:02:44.37,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:44.49,0:02:47.16,Default,,0,0,0,,Түсінбегендерің қорқынышты
Dialogue: 0,0:02:47.29,0:02:48.96,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:49.08,0:02:52.25,Default,,0,0,0,,Сиқыр бұршақтарда...
Dialogue: 0,0:02:52.38,0:02:55.13,Default,,0,0,0,,Оны сығу үшін осы құралды пайдаланыңыз.
Dialogue: 0,0:02:55.25,0:02:57.30,Default,,0,0,0,,Бұл мен бұрын-соңды көрмеген құрал.
Dialogue: 0,0:02:57.55,0:03:00.22,Default,,0,0,0,,Мен біреуді білемін.
Dialogue: 0,0:03:01.05,0:03:04.14,Default,,0,0,0,,Тимо, маған кагакуыңа көмектес.
Dialogue: 0,0:03:04.97,0:03:07.89,Default,,0,0,0,,Мен бұршақ құралын алғым келеді.
Dialogue: 0,0:03:08.60,0:03:11.19,Default,,0,0,0,,Басты кейіпкерге қарсы шыға алмайды
Dialogue: 0,0:03:13.23,0:03:17.73,Default,,0,0,0,,Сөмкедегі нұсқаулар түсініксіз және мағынасыз.
Dialogue: 0,0:03:19.24,0:03:22.70,Default,,0,0,0,,Бірақ сіз мұны жасай аласыз. Егер ол жұмыс істемесе, ол жарылып кетеді.
Dialogue: 0,0:03:22.91,0:03:25.03,Default,,0,0,0,,Сәтіңізді Құдайға тапсырыңыз
Dialogue: 0,0:03:29.95,0:03:34.13,Default,,0,0,0,,Бұл сиқырдың шыққан дыбысы.
Dialogue: 0,0:03:34.50,0:03:36.21,Default,,0,0,0,,Бұл қандай сиқыр?
Dialogue: 0,0:03:36.34,0:03:39.26,Default,,0,0,0,,Сіз ұша аласыз ба? Сіздің аяқтарыңыз күшейе ме?
Dialogue: 0,0:03:47.56,0:03:49.27,Default,,0,0,0,,Менің тілім өртеніп кетті!
Dialogue: 0,0:03:49.39,0:03:50.06,Default,,0,0,0,,Мұнда
Dialogue: 0,0:03:54.27,0:03:55.90,Default,,0,0,0,,Мен ештеңе көре алмаймын
Dialogue: 0,0:03:57.07,0:03:57.77,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:03:57.90,0:03:59.28,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:03:59.40,0:04:00.40,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:04:01.61,0:04:04.70,Default,,0,0,0,,Өзгеріс жоқ. Машина бұзылған.
Dialogue: 0,0:04:04.82,0:04:08.08,Default,,0,0,0,,Мен соманы көбірек реттеуім керек.
Dialogue: 0,0:04:08.20,0:04:09.16,Default,,0,0,0,,«Көбірек»?
Dialogue: 0,0:04:12.12,0:04:13.71,Default,,0,0,0,,А, бұл ыстық!
Dialogue: 0,0:04:16.00,0:04:18.59,Default,,0,0,0,,Мен оны іштім, кел, сиқыр.
Dialogue: 0,0:04:18.71,0:04:23.38,Default,,0,0,0,,Көп болмаса да, маған аздап көрсетуге болады.
Dialogue: 0,0:04:26.43,0:04:29.14,Default,,0,0,0,,Құдай мені мазақ етеді
Dialogue: 0,0:04:31.02,0:04:32.68,Default,,0,0,0,,Оны жайына қалдырайық
Dialogue: 0,0:04:32.81,0:04:37.31,Default,,0,0,0,,Мен Патшаның қайғырғанын қаламаймын, онда мен...
Dialogue: 0,0:04:38.06,0:04:40.44,Default,,0,0,0,,Жылама, мен де...
Dialogue: 0,0:04:43.07,0:04:46.61,Default,,0,0,0,,Жылама, патша сені қаламайды.
Dialogue: 0,0:04:47.87,0:04:48.53,Default,,0,0,0,,Король?
Dialogue: 0,0:04:49.99,0:04:50.87,Default,,0,0,0,,Ол ұшып бара жатты
Dialogue: 0,0:04:56.54,0:04:57.88,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:04:58.00,0:05:02.17,Default,,0,0,0,,Менің басымның анық болғаны сонша, би кешіндей
Dialogue: 0,0:05:03.34,0:05:05.43,Default,,0,0,0,,Жаңғырық та анық
Dialogue: 0,0:05:06.22,0:05:09.60,Default,,0,0,0,,Сен менің бумбоксымды ұрладың, Вилли.
Dialogue: 0,0:05:10.01,0:05:13.56,Default,,0,0,0,,Сіз нені айтасыз? мен мұнда емеспін
Dialogue: 0,0:05:13.68,0:05:14.98,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:05:15.10,0:05:16.06,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:05:17.60,0:05:19.44,Default,,0,0,0,,Эй, эй, тоқта
Dialogue: 0,0:05:20.52,0:05:22.57,Default,,0,0,0,,Қылмысты көбейту шешімі
Dialogue: 0,0:05:23.11,0:05:27.24,Default,,0,0,0,,LALA-ның жаңа жасырын баспанасы.
Dialogue: 0,0:05:27.82,0:05:29.28,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:05:29.82,0:05:32.24,Default,,0,0,0,,Ал қалған бөліктер ше?
Dialogue: 0,0:05:35.66,0:05:37.04,Default,,0,0,0,,Тұрғын үй тапшылығын шешу
Dialogue: 0,0:05:38.50,0:05:39.42,Default,,0,0,0,,Белгілі!
Dialogue: 0,0:05:39.54,0:05:40.84,Default,,0,0,0,,Мынаны лақтырып жіберейік
Dialogue: 0,0:05:46.47,0:05:47.97,Default,,0,0,0,,Оны неге маған ішуге мәжбүрледің?
Dialogue: 0,0:05:48.09,0:05:50.72,Default,,0,0,0,,Сіз оны тоқтата аламын деп ойлайсыз ба?
Dialogue: 0,0:05:50.85,0:05:52.85,Default,,0,0,0,,Балалар, келдіңдер ме?
Dialogue: 0,0:05:53.89,0:05:56.10,Default,,0,0,0,,Мен сені көптен бері іздеп жүрмін.
Dialogue: 0,0:05:56.56,0:05:57.94,Default,,0,0,0,,Сіз оқып жатырсыз ба?
Dialogue: 0,0:05:58.19,0:06:02.73,Default,,0,0,0,,Лемур патшалығының тарихы қорқынышты.
Dialogue: 0,0:06:02.86,0:06:04.94,Default,,0,0,0,,Біраз ұйықтауға болады ма?
Dialogue: 0,0:06:05.07,0:06:08.20,Default,,0,0,0,,Сіз ұйықтамай-ақ кез келген нәрсені жасай аласыз
Dialogue: 0,0:06:09.57,0:06:14.33,Default,,0,0,0,,Мен барлық жұмыс тізімдерімді тастадым.
Dialogue: 0,0:06:14.45,0:06:19.08,Default,,0,0,0,,Мен де бос уақытымда рок-опера түсірдім.
Dialogue: 0,0:06:22.79,0:06:27.09,Default,,0,0,0,,1 актінің соңы «Қайғы ананасы»
Dialogue: 0,0:06:27.22,0:06:30.51,Default,,0,0,0,,Патша қандай керемет
Dialogue: 0,0:06:30.76,0:06:33.55,Default,,0,0,0,,Мұның бәрі кофенің арқасында.
Dialogue: 0,0:06:33.68,0:06:36.14,Default,,0,0,0,,Ол менің ішімде жасырылды.
Dialogue: 0,0:06:36.27,0:06:39.64,Default,,0,0,0,,Оның патшалық қабілетін көрсетеді
Dialogue: 0,0:06:39.77,0:06:41.19,Default,,0,0,0,,Мен оны жай ғана аршып алдым.
Dialogue: 0,0:06:41.31,0:06:46.15,Default,,0,0,0,,Ішсем, түнде жұмыс істей аламын, қылмыс болмайды.
Dialogue: 0,0:06:46.28,0:06:49.07,Default,,0,0,0,,Сіз керемет данышпансыз.
Dialogue: 0,0:06:49.40,0:06:52.37,Default,,0,0,0,,Мен жақсы нәрсе ойладым~
Dialogue: 0,0:06:57.87,0:06:59.91,Default,,0,0,0,,үшінң тыңдаңдар.
Dialogue: 0,0:07:00.04,0:07:02.67,Default,,0,0,0,,Король Джулиен қайтыс болды
Dialogue: 0,0:07:04.54,0:07:06.00,Default,,0,0,0,,Зомбилер!
Dialogue: 0,0:07:07.51,0:07:10.17,Default,,0,0,0,,Бұл мысал ғана. Мұқият қараңыз.
Dialogue: 0,0:07:11.47,0:07:13.26,Default,,0,0,0,,Мен жаңамын
Dialogue: 0,0:07:13.39,0:07:16.97,Default,,0,0,0,,Оны менімен бірге ингредиент ретінде сэндвич ретінде қарастырыңыз.
Dialogue: 0,0:07:17.10,0:07:20.48,Default,,0,0,0,,Мен оны жегім келеді. Бұл дәмді көрінеді.
Dialogue: 0,0:07:21.73,0:07:25.86,Default,,0,0,0,,Жаңа адам болуға көмектесетін сусын бар.
Dialogue: 0,0:07:25.98,0:07:30.78,Default,,0,0,0,,Мен сене алар емеспін. Ол қандай сусын?
Dialogue: 0,0:07:30.90,0:07:33.03,Default,,0,0,0,,Сиқырлы бұршақпен жасалған
Dialogue: 0,0:07:33.16,0:07:34.37,Default,,0,0,0,,Сенді
Dialogue: 0,0:07:35.66,0:07:36.95,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:07:37.08,0:07:39.04,Default,,0,0,0,,Қоңыр Джульен
Dialogue: 0,0:07:40.29,0:07:41.00,Default,,0,0,0,,Ішуші ме?
Dialogue: 0,0:07:43.21,0:07:45.13,Default,,0,0,0,,Бұл әлі беде ме?
Dialogue: 0,0:07:45.25,0:07:46.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:49.01,0:07:50.26,Default,,0,0,0,,Ачичи!
Dialogue: 0,0:07:50.59,0:07:52.05,Default,,0,0,0,,Бірақ дәмді
Dialogue: 0,0:07:54.59,0:07:55.64,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:07:55.76,0:07:59.47,Default,,0,0,0,,Күте тұрыңыз, тағы 5. Иә, ішіп, содан кейін жауап беріңіз.
Dialogue: 0,0:07:59.64,0:08:01.02,Default,,0,0,0,,Жүр, ішіп ал.
Dialogue: 0,0:08:01.52,0:08:02.73,Default,,0,0,0,,Атап айтқанда, ештеңе жоқ
Dialogue: 0,0:08:03.64,0:08:05.15,Default,,0,0,0,,Өзгеріс жоқ
Dialogue: 0,0:08:05.73,0:08:06.90,Default,,0,0,0,,ештеңе
Dialogue: 0,0:08:09.61,0:08:11.90,Default,,0,0,0,,Жарайды, атайық.
Dialogue: 0,0:08:17.24,0:08:19.87,Default,,0,0,0,,«Қоңыр Джулиан»
Dialogue: 0,0:08:21.58,0:08:27.13,Default,,0,0,0,,Барлық адамдар қуатқа толып, ұйықтамай жұмыс істейді.
Dialogue: 0,0:08:27.25,0:08:30.46,Default,,0,0,0,,Ұйықтамаған дұрыс па?
Dialogue: 0,0:08:30.59,0:08:34.88,Default,,0,0,0,,Браун Джульенді инъекциялау арқылы бұл туралы ойланыңыз.
Dialogue: 0,0:08:39.47,0:08:41.47,Default,,0,0,0,,Дәмі Фоссаның кекірігі сияқты.
Dialogue: 0,0:08:41.60,0:08:43.31,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:08:53.40,0:08:54.32,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:54.45,0:08:55.86,Default,,0,0,0,,Сіз не білесіз?
Dialogue: 0,0:08:56.20,0:08:59.41,Default,,0,0,0,,Менің ішімдік ішу жақсы емес.
Dialogue: 0,0:09:00.08,0:09:02.58,Default,,0,0,0,,Шайнамай жұту
Dialogue: 0,0:09:05.96,0:09:07.58,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:09:07.71,0:09:11.25,Default,,0,0,0,,Браун Джульеннің арқасында мен оны іше алдым.
Dialogue: 0,0:09:12.26,0:09:16.13,Default,,0,0,0,,Бұл ел тәулігіне 24 сағат қозғала береді.
Dialogue: 0,0:09:16.30,0:09:21.60,Default,,0,0,0,,Ұйқысыз жеміс жинап, үй салып, Фоссадан қаш.
Dialogue: 0,0:09:21.72,0:09:24.39,Default,,0,0,0,,Егер сізде әлі уақыт болса...
Dialogue: 0,0:09:25.31,0:09:28.52,Default,,0,0,0,,Бұл кеш!
Dialogue: 0,0:09:30.90,0:09:33.28,Default,,0,0,0,,24 сағаттан кейін
Dialogue: 0,0:09:43.66,0:09:45.83,Default,,0,0,0,,Біз елді қорғауымыз керек
Dialogue: 0,0:09:45.96,0:09:50.04,Default,,0,0,0,,Қоңыр Джульеннің белгісіз әсерлері бар және дәмі қорқынышты.
Dialogue: 0,0:09:50.17,0:09:51.42,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:09:51.54,0:09:57.22,Default,,0,0,0,,Енді мен Джунглидің тереңін көре аламын
Dialogue: 0,0:09:57.34,0:09:59.01,Default,,0,0,0,,Менің көзім қорқынышты
Dialogue: 0,0:09:59.18,0:10:01.80,Default,,0,0,0,,3 күннен кейін
Dialogue: 0,0:10:13.57,0:10:18.20,Default,,0,0,0,,Мен біреу тілімді қимылдатып, сөйлеп тұрғандай сезінемін.
Dialogue: 0,0:10:19.07,0:10:20.03,Default,,0,0,0,,Жоқ, бұл қате.
Dialogue: 0,0:10:20.32,0:10:24.70,Default,,0,0,0,,5 күннен кейін
Dialogue: 0,0:10:29.75,0:10:32.04,Default,,0,0,0,,Толтырмас бұрын толтырыңыз
Dialogue: 0,0:10:32.17,0:10:35.25,Default,,0,0,0,,Маған кофе беріңіз! Қалталарыңызды іздеңіз
Dialogue: 0,0:10:35.38,0:10:37.55,Default,,0,0,0,,Лемурлардың қалтасы жоқ
Dialogue: 0,0:10:37.92,0:10:38.92,Default,,0,0,0,,Бірақ анықтап көрейік
Dialogue: 0,0:10:40.68,0:10:42.18,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,0:10:42.30,0:10:44.31,Default,,0,0,0,,Бұл бәрінен кейін болды.
Dialogue: 0,0:10:44.43,0:10:48.23,Default,,0,0,0,,Бұл елді ақылды Фосса басқарады.
Dialogue: 0,0:10:48.35,0:10:50.52,Default,,0,0,0,,Король де азғырылды...
Dialogue: 0,0:10:50.90,0:10:51.56,Default,,0,0,0,,Не?
Dialogue: 0,0:10:51.69,0:10:54.61,Default,,0,0,0,,Боқтамай, жұмысыңды істе.
Dialogue: 0,0:10:54.73,0:10:57.86,Default,,0,0,0,,Бұл бос сөз емес, бұл шындық
Dialogue: 0,0:10:57.99,0:10:59.57,Default,,0,0,0,,Ешқандай дәлел болмаса да
Dialogue: 0,0:11:00.70,0:11:02.53,Default,,0,0,0,,Бұршақ жоқ, солай ма?
Dialogue: 0,0:11:03.20,0:11:05.03,Default,,0,0,0,,Енді кетті
Dialogue: 0,0:11:05.16,0:11:06.33,Default,,0,0,0,,Енді жоқ па?
Dialogue: 0,0:11:06.45,0:11:12.29,Default,,0,0,0,,Сол кофеқұмарлар мені естісе, жабайы болады.
Dialogue: 0,0:11:12.42,0:11:13.42,Default,,0,0,0,,Даусыңызды бәсеңдетіңіз
Dialogue: 0,0:11:14.63,0:11:15.96,Default,,0,0,0,,Король Джулиен
Dialogue: 0,0:11:18.46,0:11:19.42,Default,,0,0,0,,Патша!
Dialogue: 0,0:11:23.68,0:11:25.72,Default,,0,0,0,,Кинг жақсы
Dialogue: 0,0:11:27.81,0:11:28.72,Default,,0,0,0,,Морт?
Dialogue: 0,0:11:28.85,0:11:32.85,Default,,0,0,0,,Кофенің әсері адамнан адамға әр түрлі болады.
Dialogue: 0,0:11:32.98,0:11:37.53,Default,,0,0,0,,Менің жағдайымда мен кенеттен ақылды болып кеткен сияқтымын.
Dialogue: 0,0:11:38.36,0:11:42.36,Default,,0,0,0,,Мен келісемін. Мен кофе ішуді тоқтатуым керек.
Dialogue: 0,0:11:42.49,0:11:46.74,Default,,0,0,0,,Патша оны менен сұраса, қиналып қалар едім, өйткені ол менде жоқ.
Dialogue: 0,0:11:46.87,0:11:48.16,Default,,0,0,0,,Не?
Dialogue: 0,0:11:49.62,0:11:51.58,Default,,0,0,0,,Мен өзімді ұмытып бара жатқандай сезінемін
Dialogue: 0,0:11:51.71,0:11:56.88,Default,,0,0,0,,Себебі кофенің жетіспеушілігі миға қан ағымын азайтады.
Dialogue: 0,0:11:57.63,0:11:59.63,Default,,0,0,0,,Менің миым құрғап барады
Dialogue: 0,0:11:59.76,0:12:03.22,Default,,0,0,0,,Ондай ми ел басқара алмайды.
Dialogue: 0,0:12:03.63,0:12:07.35,Default,,0,0,0,,Кофе болмаса, не істеуім керек?
Dialogue: 0,0:12:07.47,0:12:09.39,Default,,0,0,0,,Патша қатты
Dialogue: 0,0:12:09.52,0:12:11.81,Default,,0,0,0,,Кофе жоқ па?
Dialogue: 0,0:12:11.93,0:12:15.06,Default,,0,0,0,,Олар мұның бәрін өздеріне сақтауға тырысады.
Dialogue: 0,0:12:15.19,0:12:17.65,Default,,0,0,0,,Елді жеңейік
Dialogue: 0,0:12:19.19,0:12:20.78,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:12:20.90,0:12:24.03,Default,,0,0,0,,үшін шеңберге түседі
Dialogue: 0,0:12:25.24,0:12:26.62,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:12:26.99,0:12:29.66,Default,,0,0,0,,Күш қолдану – бұл...
Dialogue: 0,0:12:29.79,0:12:32.16,Default,,0,0,0,,Оны кейінірек сақтау үшін сақтаңыз
Dialogue: 0,0:12:33.87,0:12:35.83,Default,,0,0,0,,Сәлем Карл
Dialogue: 0,0:12:36.13,0:12:39.38,Default,,0,0,0,,Король Джульен, мені есіңде ме?
Dialogue: 0,0:12:39.50,0:12:41.80,Default,,0,0,0,,Егер олар бас дұшпан болса, бұл табиғи нәрсе.
Dialogue: 0,0:12:41.92,0:12:44.72,Default,,0,0,0,,Сен менің жауымсың ба?
Dialogue: 0,0:12:44.84,0:12:49.39,Default,,0,0,0,,Кім жаман жоспар құрып, менен жеңілді?
Dialogue: 0,0:12:49.51,0:12:51.47,Default,,0,0,0,,Сол себепті біз ант жауымыз.
Dialogue: 0,0:12:52.60,0:12:54.81,Default,,0,0,0,,Шулы Неге келдің?
Dialogue: 0,0:12:54.94,0:12:59.57,Default,,0,0,0,,Сізді жеңу үшін бұл жоспар жақсы жүріп жатыр.
Dialogue: 0,0:12:59.98,0:13:00.90,Default,,0,0,0,,Жоспар қандай?
Dialogue: 0,0:13:01.03,0:13:04.03,Default,,0,0,0,,Лемур патшалығын жаулап алу
Dialogue: 0,0:13:04.90,0:13:08.49,Default,,0,0,0,,Тек кофе пайдаланыңыз
Dialogue: 0,0:13:08.62,0:13:10.37,Default,,0,0,0,,Соңғы уақыттан бері...
Dialogue: 0,0:13:10.49,0:13:13.70,Default,,0,0,0,,Мені Чонси бақылап отырды.
Dialogue: 0,0:13:13.83,0:13:20.34,Default,,0,0,0,,Сіз жұмбақ бухта жақсы дем алып жатқан сияқтысыз.
Dialogue: 0,0:13:21.92,0:13:24.84,Default,,0,0,0,,Аа, мен бұлғаққа жиі барамын.
Dialogue: 0,0:13:24.97,0:13:29.14,Default,,0,0,0,,Сонымен мен қолтырауынды айлар бойы жаттықтырдым.
Dialogue: 0,0:13:29.26,0:13:33.43,Default,,0,0,0,,Бухтаға бір қап кофе дәндері әкелінді.
Dialogue: 0,0:13:33.56,0:13:38.35,Default,,0,0,0,,«Патша» сөзі сіздің назарыңызды жақсы аударды.
Dialogue: 0,0:13:39.19,0:13:44.86,Default,,0,0,0,,Бұл ойластырылған жоспар болды, бірақ мағынасы жоқ сияқты.
Dialogue: 0,0:13:45.19,0:13:45.99,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:13:46.11,0:13:48.24,Default,,0,0,0,,Жоқ, бұл сәтті болды.
Dialogue: 0,0:13:48.36,0:13:52.62,Default,,0,0,0,,Қазір патшалық кофеге құмар
Dialogue: 0,0:13:52.74,0:13:56.75,Default,,0,0,0,,үшін менің кофемді қалайды
Dialogue: 0,0:13:58.17,0:13:59.71,Default,,0,0,0,,Ішіңдер, ақымақтар.
Dialogue: 0,0:14:06.59,0:14:07.63,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:14:07.76,0:14:11.14,Default,,0,0,0,,Мені патша етіңіз
Dialogue: 0,0:14:11.26,0:14:18.06,Default,,0,0,0,,Егер солай істесең, мен саған қанша қаласаң, сонша кофе аламын деп уәде беремін.
Dialogue: 0,0:14:18.35,0:14:20.90,Default,,0,0,0,,Сіз қалай ойлайсыз? Джулиан
Dialogue: 0,0:14:21.27,0:14:21.94,Default,,0,0,0,,Эй
Dialogue: 0,0:14:23.11,0:14:24.36,Default,,0,0,0,,Мен ұйықтамаймын.
Dialogue: 0,0:14:24.57,0:14:28.70,Default,,0,0,0,,Өкінішке орай, сіз бұл жолы да жоғалтасыз.
Dialogue: 0,0:14:28.82,0:14:34.74,Default,,0,0,0,,Менің сүйікті адамдарымның маған кофені таңдауы мүмкін емес.
Dialogue: 0,0:14:35.37,0:14:36.20,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:14:43.21,0:14:45.25,Default,,0,0,0,,Мені қуып жібер
Dialogue: 0,0:14:45.80,0:14:47.21,Default,,0,0,0,,Сіз кофе таңдадыңыз ба?
Dialogue: 0,0:14:47.34,0:14:49.51,Default,,0,0,0,,Естеріңізде болсын, азаматтар.
Dialogue: 0,0:14:49.63,0:14:51.59,Default,,0,0,0,,Сіз менің артымнан ердіңіз.
Dialogue: 0,0:14:51.72,0:14:52.80,Default,,0,0,0,,Әлде айтайын ба...
Dialogue: 0,0:14:52.93,0:14:54.10,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:14:57.22,0:14:59.10,Default,,0,0,0,,Доктор Морт, сіз де?
Dialogue: 0,0:14:59.23,0:15:05.19,Default,,0,0,0,,Қанша ақылды болсаң да, мен сені жақсы көремін.
Dialogue: 0,0:15:05.32,0:15:07.74,Default,,0,0,0,,Рахмет сізге доктор Морт
Dialogue: 0,0:15:07.86,0:15:11.70,Default,,0,0,0,,Сіздің британдық акцентіңіз тыныштандырады.
Dialogue: 0,0:15:11.82,0:15:13.99,Default,,0,0,0,,Мен де
Dialogue: 0,0:15:14.12,0:15:15.28,Default,,0,0,0,,Мүлдем басқа
Dialogue: 0,0:15:15.41,0:15:19.46,Default,,0,0,0,,үшінн жақсы сезінетін нәрсе бар.
Dialogue: 0,0:15:22.12,0:15:23.13,Default,,0,0,0,,Қоңыр Джульен?
Dialogue: 0,0:15:23.25,0:15:27.42,Default,,0,0,0,,Бұршақтардың жерін сүзіп жасап көрдім.
Dialogue: 0,0:15:27.80,0:15:32.80,Default,,0,0,0,,Саңырауқұлақ тәрізді дәм мен аяқтың иісі дәмді.
Dialogue: 0,0:15:34.76,0:15:36.22,Default,,0,0,0,,Мынадай
Dialogue: 0,0:15:37.35,0:15:38.77,Default,,0,0,0,,Айға бара алады
Dialogue: 0,0:15:39.06,0:15:41.44,Default,,0,0,0,,Мынау! Міне осы!
Dialogue: 0,0:15:42.10,0:15:43.94,Default,,0,0,0,,Біз өз патшалығымызды қайтаруымыз керек.
Dialogue: 0,0:15:44.06,0:15:47.23,Default,,0,0,0,,Карл бұршақтарының көзін табыңыз
Dialogue: 0,0:15:47.36,0:15:51.07,Default,,0,0,0,,Патша Орналасқан жеріңіз есіңізде ме?
Dialogue: 0,0:15:53.66,0:15:55.24,Default,,0,0,0,,Кофе!
Dialogue: 0,0:15:56.33,0:15:59.37,Default,,0,0,0,,Менің ағам кофе қайнатып жатқанда...
Dialogue: 0,0:15:59.50,0:16:02.46,Default,,0,0,0,,Карл менің жатын бөлмемде шағымданды.
Dialogue: 0,0:16:02.58,0:16:05.33,Default,,0,0,0,,Бұршақтардың шыққан жері
Dialogue: 0,0:16:05.79,0:16:08.13,Default,,0,0,0,,Менің жатын бөлмем? Бұл кішкентай
Dialogue: 0,0:16:08.75,0:16:11.42,Default,,0,0,0,,Карлдың отбасы жасайды.
Dialogue: 0,0:16:11.55,0:16:17.10,Default,,0,0,0,,Бұл елде бұршақты көп мөлшерде өсіруге болатын бір ғана жер бар.
Dialogue: 0,0:16:19.26,0:16:21.31,Default,,0,0,0,,Карлдың кофе фермасы
Dialogue: 0,0:16:21.43,0:16:26.94,Default,,0,0,0,,Жұмыс істейтін қағаз тышқан ақымақ және қатыгез.
Dialogue: 0,0:16:27.06,0:16:30.19,Default,,0,0,0,,Бұл оңай, өйткені сен бұрын маған ұқсассың.
Dialogue: 0,0:16:30.78,0:16:31.78,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:16:32.03,0:16:33.53,Default,,0,0,0,,Карлдың үйі
Dialogue: 0,0:16:33.95,0:16:35.49,Default,,0,0,0,,үшін тізерлеп отырады
Dialogue: 0,0:16:38.99,0:16:41.50,Default,,0,0,0,,Біздің міндетіміз анық.
Dialogue: 0,0:16:42.66,0:16:43.46,Default,,0,0,0,,Ой
Dialogue: 0,0:16:43.58,0:16:48.50,Default,,0,0,0,,Оның кофесі арқылы елдің үстемдігін тоқтатыңыз.
Dialogue: 0,0:16:48.63,0:16:51.96,Default,,0,0,0,,Менің кофеммен ереже
Dialogue: 0,0:16:52.09,0:16:54.34,Default,,0,0,0,,Сіз ішуді тоқтата аласыз.
Dialogue: 0,0:16:58.22,0:17:00.22,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:17:00.35,0:17:03.06,Default,,0,0,0,,Осы шайқаста жеңіске жетуге үміттену
Dialogue: 0,0:17:05.27,0:17:09.36,Default,,0,0,0,,Мен осы жерде қоштасамын. Іске сәт!
Dialogue: 0,0:17:11.03,0:17:14.61,Default,,0,0,0,,Ол ақырында көмектесті, король.
Dialogue: 0,0:17:19.16,0:17:20.12,Default,,0,0,0,,Түсіңіз
Dialogue: 0,0:17:22.54,0:17:24.25,Default,,0,0,0,,Мен тыңдамадым.
Dialogue: 0,0:17:24.37,0:17:29.92,Default,,0,0,0,,Бұрынғыдай қоқыстан сығады деп ойладым.
Dialogue: 0,0:17:30.59,0:17:33.05,Default,,0,0,0,,Жақсы көретін біреу бар.
Dialogue: 0,0:17:33.17,0:17:37.30,Default,,0,0,0,,Мынаны жеп, сүйектен жел соғуын жасайық.
Dialogue: 0,0:17:37.93,0:17:42.64,Default,,0,0,0,,Жақсы, бірақ сен мені жемес бұрын менің сұрағым бар.
Dialogue: 0,0:17:43.22,0:17:46.23,Default,,0,0,0,,Сіздің қазіргі жұмыс орныңызға көңіліңіз тола ма?
Dialogue: 0,0:17:47.48,0:17:48.19,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:17:49.56,0:17:52.86,Default,,0,0,0,,Бұл күрделі кілт, ол оңай ашылмайды.
Dialogue: 0,0:17:52.98,0:17:54.99,Default,,0,0,0,,Менде тамаша идея бар.
Dialogue: 0,0:17:56.70,0:17:57.82,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:17:57.99,0:18:00.37,Default,,0,0,0,,Бұл Карлға сыйлық.
Dialogue: 0,0:18:00.49,0:18:01.49,Default,,0,0,0,,Бұл жақсы идея ма?
Dialogue: 0,0:18:02.03,0:18:07.29,Default,,0,0,0,,«Төтенше жағдай болмаса, есікті ашпаңыз» деген бұйрық берілген.
Dialogue: 0,0:18:07.83,0:18:11.09,Default,,0,0,0,,Дұрыс, онда бұл шұғыл.
Dialogue: 0,0:18:11.21,0:18:12.13,Default,,0,0,0,,Дегенмен, Титан аумағына әрбір шығу
Dialogue: 0,0:18:16.88,0:18:18.26,Default,,0,0,0,,Ешкім
Dialogue: 0,0:18:18.47,0:18:19.34,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:20.55,0:18:24.10,Default,,0,0,0,,Балалар, мұнда келдіңдер...
Dialogue: 0,0:18:24.22,0:18:27.73,Default,,0,0,0,,Сіз мені болжау мүмкін емес деп ойладыңыз ба?
Dialogue: 0,0:18:29.81,0:18:30.48,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:18:32.27,0:18:33.86,Default,,0,0,0,,Жаса!
Dialogue: 0,0:18:53.34,0:18:56.84,Default,,0,0,0,,Бұл өз жоғалтқаның үшін шапалақ.
Dialogue: 0,0:18:56.96,0:19:00.13,Default,,0,0,0,,Себебі сіз жеңілдіңіз.
Dialogue: 0,0:19:00.26,0:19:03.39,Default,,0,0,0,,Мен сіз басқа нұсқаны ойламайсыз деп ойладым ба?
Dialogue: 0,0:19:06.43,0:19:07.93,Default,,0,0,0,,«Жарайды».
Dialogue: 0,0:19:11.44,0:19:14.44,Default,,0,0,0,,Бітті, бұрынғы патша.
Dialogue: 0,0:19:14.57,0:19:19.82,Default,,0,0,0,,Оның бойында патшалық қасиеттер болса да, халықтың көңілінен шыға алмады.
Dialogue: 0,0:19:19.95,0:19:24.41,Default,,0,0,0,,Мен патшамын, бұл жолы шарлар құламайды...
Dialogue: 0,0:19:27.95,0:19:31.17,Default,,0,0,0,,Чонси, мықты бол.
Dialogue: 0,0:19:31.83,0:19:33.83,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:19:34.38,0:19:39.13,Default,,0,0,0,,Кофе плантацияларында жұмыс істейтін кәсіподақ мүшелері.
Dialogue: 0,0:19:39.26,0:19:41.97,Default,,0,0,0,,Қазір ереуілге шығыңыз
Dialogue: 0,0:19:42.09,0:19:45.68,Default,,0,0,0,,Жалақы деген нәрсені сұраңыз
Dialogue: 0,0:19:45.80,0:19:50.85,Default,,0,0,0,,Мен зейнеткерлікке шыққанда, мені теңізге батыруды тоқтатуын сұраймын.
Dialogue: 0,0:19:52.19,0:19:53.02,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:19:53.35,0:19:56.36,Default,,0,0,0,,Айлығың болса, бізге де бер.
Dialogue: 0,0:19:56.48,0:19:59.03,Default,,0,0,0,,Жұмыс істеу үшін тым шулы
Dialogue: 0,0:19:59.15,0:20:02.49,Default,,0,0,0,,Мен сізге жоғары жалақы төлейтін едім.
Dialogue: 0,0:20:02.61,0:20:03.95,Default,,0,0,0,,Сіз акцияларды да сатып ала аласыз
Dialogue: 0,0:20:04.66,0:20:08.16,Default,,0,0,0,,Мен сенің мына сұмдықты жинап алсаңшы.
Dialogue: 0,0:20:14.33,0:20:15.88,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:20:16.00,0:20:17.13,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:17.25,0:20:19.67,Default,,0,0,0,,Доктор Морт қайда?
Dialogue: 0,0:20:20.13,0:20:21.51,Default,,0,0,0,,Жақын жерде болуы керек
Dialogue: 0,0:20:21.63,0:20:24.72,Default,,0,0,0,,А, мен сенің қасыңдамын.
Dialogue: 0,0:20:25.59,0:20:29.47,Default,,0,0,0,,Кофенің әсері жойылған сайын
Dialogue: 0,0:20:29.60,0:20:32.94,Default,,0,0,0,,Менің ойымда көп нәрсе бар.
Dialogue: 0,0:20:33.06,0:20:34.69,Default,,0,0,0,,«Аяқ!»
Dialogue: 0,0:20:35.02,0:20:37.02,Default,,0,0,0,,Ол Киригумо-суги деп аталатын өте жеңіл ағаш түрінен жасалған
Dialogue: 0,0:20:37.40,0:20:38.77,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:20:38.90,0:20:41.53,Default,,0,0,0,,Ереуілдер туралы не деуге болады?
Dialogue: 0,0:20:41.65,0:20:46.11,Default,,0,0,0,,Олар акцияларды түсінеді деп ойлайсыз ба?
Dialogue: 0,0:20:46.74,0:20:51.91,Default,,0,0,0,,Нан бос күн жасағанда, мен оңай айналдырдым.
Dialogue: 0,0:20:52.29,0:20:55.08,Default,,0,0,0,,Жолдан кет, патшаны өртеп жіберемін.
Dialogue: 0,0:20:59.84,0:21:02.09,Default,,0,0,0,,Енді мына қаруды ал.
Dialogue: 0,0:21:03.26,0:21:05.63,Default,,0,0,0,,Егер сіз оны қоймасаңыз, мен сізді өлтіремін.
Dialogue: 0,0:21:06.84,0:21:10.26,Default,,0,0,0,,Сіз не істеу керектігін білесіз.
Dialogue: 0,0:21:10.39,0:21:13.23,Default,,0,0,0,,Жоқ, мен сені сүйемін, патша.
Dialogue: 0,0:21:13.35,0:21:16.19,Default,,0,0,0,,Бұл туралы уайымдамаңыз, тек атыңыз.
Dialogue: 0,0:21:22.19,0:21:24.99,Default,,0,0,0,,Қоштасу доктор Морт
Dialogue: 0,0:21:29.53,0:21:32.87,Default,,0,0,0,,Менің ата-анамның кофе фермасы!
Dialogue: 0,0:21:33.16,0:21:37.04,Default,,0,0,0,,Ағамды демалыстан келгенде өлтіреді.
Dialogue: 0,0:21:37.17,0:21:38.42,Default,,0,0,0,,Доктор Морт
Dialogue: 0,0:21:38.54,0:21:41.25,Default,,0,0,0,,Жоқ. Әсері өткеннен кейін...
Dialogue: 0,0:21:41.38,0:21:42.88,Default,,0,0,0,,Сен тағы да ақымақсың ба?
Dialogue: 0,0:21:43.34,0:21:45.09,Default,,0,0,0,,Мен бұрын ақымақ болғанмын
Dialogue: 0,0:21:46.01,0:21:47.80,Default,,0,0,0,,Жеміс қақпағы!
Dialogue: 0,0:21:49.05,0:21:53.10,Default,,0,0,0,,Триггерді тарту дұрыс шешім болды.
Dialogue: 0,0:21:53.22,0:21:55.10,Default,,0,0,0,,Кофесіз жасауға болады
Dialogue: 0,0:21:55.23,0:21:59.77,Default,,0,0,0,,Бұл бас ауруымен не істей аламын? Мен де тоқаш жегім келеді
Dialogue: 0,0:22:00.15,0:22:05.28,Default,,0,0,0,,Карл, сіздің жоспарыңыз тағы да орындалмай қалған сияқты.
Dialogue: 0,0:22:05.40,0:22:09.36,Default,,0,0,0,,О, сен шынымен жақсы бәсекелессің.
Dialogue: 0,0:22:10.16,0:22:14.20,Default,,0,0,0,,Бірақ басқа да жаман жоспарлар бар.
Dialogue: 0,0:22:14.33,0:22:18.75,Default,,0,0,0,,Сондай-ақ, бұл қаруды зарядтау үшін көп уақыт қажет.
Dialogue: 0,0:22:19.37,0:22:24.88,Default,,0,0,0,,Тағы бір қимыл, бұл басқа қимыл, сіз бұл туралы ойламайсыз деп ойладым ба?
Dialogue: 0,0:22:25.84,0:22:28.76,Default,,0,0,0,,Әлі біткен жоқ, Джулиан.
Dialogue: 0,0:22:29.01,0:22:31.34,Default,,0,0,0,,Ұрысты кейінге қалдырыңыз
Dialogue: 0,0:22:32.89,0:22:34.35,Default,,0,0,0,,Аяқтар!
Dialogue: 0,0:22:35.06,0:22:37.35,Default,,0,0,0,,Мен доктор Мортты сағындым.
Dialogue: 0,0:23:06.00,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Кайо Уэда
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
