Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:40.70,0:00:42.50,Default,,0,0,0,,Король: Кешіріңіз, бірақ-
Dialogue: 0,0:00:42.62,0:00:43.91,Default,,0,0,0,,​​Есіңіз дұрыс па?
Dialogue: 0,0:00:44.04,0:00:47.63,Default,,0,0,0,,Менің есінен танып қалған кезім – кеште
Dialogue: 0,0:00:48.92,0:00:50.38,Default,,0,0,0,,Қазір қалыпты жағдай.
Dialogue: 0,0:00:50.50,0:00:53.05,Default,,0,0,0,,Сонда мен жұмыстан шығарылдым ба?
Dialogue: 0,0:00:53.26,0:00:56.18,Default,,0,0,0,,Мен сізге үзіліс жасауыңызды айтып тұрмын.
Dialogue: 0,0:00:56.30,0:01:00.60,Default,,0,0,0,,Менің ойымның күштілігі сонша, тұншығып жатырмын
Dialogue: 0,0:01:00.72,0:01:02.22,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:01:02.35,0:01:04.60,Default,,0,0,0,,Мысалы:
Dialogue: 0,0:01:05.10,0:01:06.14,Default,,0,0,0,,Түртті!
Dialogue: 0,0:01:07.94,0:01:10.73,Default,,0,0,0,,〝Шарон мен Панчо үйленуіңізбен құттықтаймыз〞
Dialogue: 0,0:01:10.82,0:01:14.61,Default,,0,0,0,,Ішіп ал, желдей ұшып кетесің.
Dialogue: 0,0:01:14.74,0:01:15.78,Default,,0,0,0,,Бұл бомба!
Dialogue: 0,0:01:16.15,0:01:17.66,Default,,0,0,0,,Сусындар!
Dialogue: 0,0:01:20.20,0:01:21.37,Default,,0,0,0,,Төгілді
Dialogue: 0,0:01:22.24,0:01:23.83,Default,,0,0,0,,Бұл қандай да бір қауіпті!
Dialogue: 0,0:01:24.62,0:01:26.50,Default,,0,0,0,,Қазір қауіпсіз.
Dialogue: 0,0:01:26.92,0:01:30.29,Default,,0,0,0,,Мен кейбір қателіктер жібердім, бірақ мен оны әрқашан айтамын.
Dialogue: 0,0:01:30.42,0:01:33.84,Default,,0,0,0,,«Омлет жасау үшін сүйек сынуы керек».
Dialogue: 0,0:01:33.96,0:01:35.51,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:01:35.63,0:01:37.26,Default,,0,0,0,,Айтсам ғой.
Dialogue: 0,0:01:37.38,0:01:40.76,Default,,0,0,0,,«Аяғы жоқ тауық» сияқты кезбеңдер
Dialogue: 0,0:01:40.89,0:01:42.64,Default,,0,0,0,,«Басы жоқ тауық»
Dialogue: 0,0:01:43.35,0:01:46.18,Default,,0,0,0,,Бассыз жүре алмайсың, солай ма?
Dialogue: 0,0:01:46.31,0:01:47.69,Default,,0,0,0,,Аяғың жоқ болса ше?
Dialogue: 0,0:01:47.81,0:01:51.36,Default,,0,0,0,,Мен тауық емеспін, сондықтан білмеймін.
Dialogue: 0,0:01:51.48,0:01:54.28,Default,,0,0,0,,Ана мен әке, ұрыспаңдар.
Dialogue: 0,0:01:56.49,0:01:58.32,Default,,0,0,0,,Сізге демалыс керек
Dialogue: 0,0:01:58.45,0:02:00.41,Default,,0,0,0,,Демалыс?
Dialogue: 0,0:02:00.87,0:02:02.83,Default,,0,0,0,,Қайда? Сіздің багажыңыз ше?
Dialogue: 0,0:02:03.58,0:02:04.49,Default,,0,0,0,,Моги мырза шынымен де әсерлі адам, білесің бе
Dialogue: 0,0:02:05.12,0:02:09.92,Default,,0,0,0,,Мен сенің мерекелерің мен өсек-аяңдарыңды реттеймін.
Dialogue: 0,0:02:10.04,0:02:11.92,Default,,0,0,0,,Джиги, сені көргеніме қуаныштымын.
Dialogue: 0,0:02:12.04,0:02:14.80,Default,,0,0,0,,Ол демалмаса жарылып кетеді.
Dialogue: 0,0:02:14.92,0:02:18.01,Default,,0,0,0,,Оны ең жақсы мерекеге айналдырыңыз
Dialogue: 0,0:02:18.13,0:02:20.97,Default,,0,0,0,,Маған демалыс керек емес
Dialogue: 0,0:02:22.47,0:02:25.60,Default,,0,0,0,,Мен мұндай жауапты естімеймін.
Dialogue: 0,0:02:25.85,0:02:28.64,Default,,0,0,0,,Джиги Оны курортқа апарыңыз
Dialogue: 0,0:02:28.89,0:02:32.48,Default,,0,0,0,,Сізге үзіліс беру үшін заң шығарыңыз
Dialogue: 0,0:02:32.61,0:02:34.65,Default,,0,0,0,,«Келісемін!» «Мен де!»
Dialogue: 0,0:02:34.77,0:02:36.40,Default,,0,0,0,,«Жақсы заң»
Dialogue: 0,0:02:36.53,0:02:40.82,Default,,0,0,0,,Шешілді! Қазір заң қабылданды
Dialogue: 0,0:02:40.95,0:02:43.24,Default,,0,0,0,,Маған да жұмыс істейтін Кинг ұнайды.
Dialogue: 0,0:02:43.37,0:02:45.87,Default,,0,0,0,,Мортты да өзіңізбен бірге алыңыз.
Dialogue: 0,0:02:45.99,0:02:49.12,Default,,0,0,0,,Патша болу жалғыздық
Dialogue: 0,0:02:51.33,0:02:54.71,Default,,0,0,0,,Бұл жаттығу емес, шұғыл демалыс!
Dialogue: 0,0:02:56.30,0:02:57.67,Default,,0,0,0,,Ақыры шығарылды
Dialogue: 0,0:02:57.80,0:03:00.80,Default,,0,0,0,,Кловерге демалыс керек
Dialogue: 0,0:03:01.05,0:03:04.76,Default,,0,0,0,,Сіз нақты мағынасын түсінбейсіз
Dialogue: 0,0:03:04.89,0:03:07.60,Default,,0,0,0,,Бұл демалыс маған арналған.
Dialogue: 0,0:03:07.72,0:03:08.47,Default,,0,0,0,,Корольдікі?
Dialogue: 0,0:03:08.60,0:03:11.77,Default,,0,0,0,,Ол үнемі менің соңымнан жүреді
Dialogue: 0,0:03:11.90,0:03:15.32,Default,,0,0,0,,Патшаның қауіпсіздігін қорғау.
Dialogue: 0,0:03:15.94,0:03:18.19,Default,,0,0,0,,Бедемен бірдей нәрсе
Dialogue: 0,0:03:18.32,0:03:21.45,Default,,0,0,0,,Сізді ол басқарады ма?
Dialogue: 0,0:03:21.57,0:03:22.66,Default,,0,0,0,,Не ол?
Dialogue: 0,0:03:22.78,0:03:26.62,Default,,0,0,0,,Бұл Кловердің қуыршағы, солай ма?
Dialogue: 0,0:03:26.74,0:03:28.16,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:03:28.29,0:03:29.79,Default,,0,0,0,,Осымен
Dialogue: 0,0:03:30.12,0:03:33.00,Default,,0,0,0,,Сіз өзіңізге қамқорлық жасай аласыз
Dialogue: 0,0:03:33.12,0:03:34.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:34.63,0:03:39.09,Default,,0,0,0,,Жұмбақ бухтада таңғажайып нәрсені іздеуге барыңыз
Dialogue: 0,0:03:39.76,0:03:41.59,Default,,0,0,0,,Өз қауіпсіздігіңіз үшін -
Dialogue: 0,0:03:41.72,0:03:44.47,Default,,0,0,0,,Қарауыл капитанының орынбасары
Dialogue: 0,0:03:44.84,0:03:46.80,Default,,0,0,0,,Пайда болды
Dialogue: 0,0:03:47.64,0:03:49.06,Default,,0,0,0,,Найза жоқ
Dialogue: 0,0:03:49.18,0:03:51.68,Default,,0,0,0,,Менде бар деп ойладым.
Dialogue: 0,0:03:56.15,0:03:58.61,Default,,0,0,0,,Ең жақсысы емес пе? беде
Dialogue: 0,0:03:58.73,0:04:01.15,Default,,0,0,0,,Жұмыс істей алмасаңыз...
Dialogue: 0,0:04:01.28,0:04:05.95,Default,,0,0,0,,Мен ойнаудан гөрі жазуға назар аударғым келеді.
Dialogue: 0,0:04:06.07,0:04:07.49,Default,,0,0,0,,Сіз не жазып жатырсыз?
Dialogue: 0,0:04:07.62,0:04:08.53,Default,,0,0,0,,Бөлек
Dialogue: 0,0:04:09.16,0:04:10.62,Default,,0,0,0,,Эй, көрсетші
Dialogue: 0,0:04:11.58,0:04:12.29,Default,,0,0,0,,Бұл қандай жаман иіс?
Dialogue: 0,0:04:12.41,0:04:13.58,Default,,0,0,0,,Тоқта
Dialogue: 0,0:04:13.87,0:04:15.96,Default,,0,0,0,,Сен жібермесең, тастаймын.
Dialogue: 0,0:04:16.21,0:04:17.42,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:04:19.67,0:04:21.13,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:04:21.84,0:04:23.80,Default,,0,0,0,,Өте мачо
Dialogue: 0,0:04:24.13,0:04:25.26,Default,,0,0,0,,Норге
Dialogue: 0,0:04:25.34,0:04:26.01,Default,,0,0,0,,Кім?
Dialogue: 0,0:04:26.30,0:04:28.10,Default,,0,0,0,,Норге Даттеба
Dialogue: 0,0:04:28.22,0:04:33.18,Default,,0,0,0,,Менің романымдағы кейіпкердің ғашығы.
Dialogue: 0,0:04:33.31,0:04:35.81,Default,,0,0,0,,Ержүрек жауынгер және күшті...
Dialogue: 0,0:04:36.69,0:04:41.03,Default,,0,0,0,,Біз лимбо би сайысын өткіземіз.
Dialogue: 0,0:04:42.11,0:04:45.91,Default,,0,0,0,,Ысқырма, мен аузыңа саламын
Dialogue: 0,0:04:46.45,0:04:49.49,Default,,0,0,0,,Кешіріңіз, мен сізді қызықтырғым келді.
Dialogue: 0,0:04:50.45,0:04:53.37,Default,,0,0,0,,Лимбоны қолданып көргіңіз келе ме?
Dialogue: 0,0:04:53.50,0:04:57.71,Default,,0,0,0,,Тозақтың тереңіндей аласа болса да, мен одан өтемін.
Dialogue: 0,0:04:58.54,0:05:01.71,Default,,0,0,0,,Жақсы, Кловер, біз де барайық.
Dialogue: 0,0:05:05.43,0:05:08.39,Default,,0,0,0,,Күдікті жігіт, қауіпті!
Dialogue: 0,0:05:08.64,0:05:10.97,Default,,0,0,0,,Мүмкін мен келгеніме қуаныштымын
Dialogue: 0,0:05:11.56,0:05:14.52,Default,,0,0,0,,Айтайын, Кловердің өкілі.
Dialogue: 0,0:05:14.64,0:05:19.69,Default,,0,0,0,,Мен жабайы жылқымын, нұсқау берсең де, түсінбеймін.
Dialogue: 0,0:05:19.81,0:05:23.82,Default,,0,0,0,,Мен де ат тілін түсінбеймін.
Dialogue: 0,0:05:25.74,0:05:27.70,Default,,0,0,0,,Сіз түсінбейсіз, солай ма?
Dialogue: 0,0:05:27.82,0:05:31.87,Default,,0,0,0,,Ат тілінде сөйлей алсам да, нұсқау бермеймін.
Dialogue: 0,0:05:31.99,0:05:33.87,Default,,0,0,0,,Қазір ішіңіз!
Dialogue: 0,0:05:36.04,0:05:38.50,Default,,0,0,0,,Үйде дайындалған смузи
Dialogue: 0,0:05:40.54,0:05:43.76,Default,,0,0,0,,Бұл дәмді, бірақ мен сізді тыңдамаймын.
Dialogue: 0,0:05:44.84,0:05:46.38,Default,,0,0,0,,Құрамында имбирь бар ма?
Dialogue: 0,0:05:46.51,0:05:47.84,Default,,0,0,0,,Мен күш-қуатты сезінемін
Dialogue: 0,0:05:48.80,0:05:50.76,Default,,0,0,0,,Иә. Бұл мен Окаға… яғни, Кёма-санға берген уәдем.
Dialogue: 0,0:05:50.89,0:05:53.60,Default,,0,0,0,,Смузиден ләззат алыңыз.
Dialogue: 0,0:05:53.72,0:05:57.35,Default,,0,0,0,,Сіз менің жүрегімді басқаруға тырысып жатырсыз.
Dialogue: 0,0:05:58.06,0:05:59.35,Default,,0,0,0,,Мен ол қолды жемеймін
Dialogue: 0,0:05:59.73,0:06:01.90,Default,,0,0,0,,Тез жарылуы керек
Dialogue: 0,0:06:02.02,0:06:05.78,Default,,0,0,0,,Оны сүртетін сен бе? беде жоқ
Dialogue: 0,0:06:05.90,0:06:08.15,Default,,0,0,0,,Жаңа шериф-
Dialogue: 0,0:06:08.28,0:06:12.74,Default,,0,0,0,,Төгілген заттарды және нәжістерді тазалаңыз.
Dialogue: 0,0:06:12.87,0:06:16.62,Default,,0,0,0,,Ал, мен біраз уақытқа шығамын.
Dialogue: 0,0:06:16.75,0:06:17.91,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:06:18.04,0:06:19.08,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:20.25,0:06:22.25,Default,,0,0,0,,Оны тоқтатпайсың ба?
Dialogue: 0,0:06:22.38,0:06:25.00,Default,,0,0,0,,Жалғыз кету қауіпті.
Dialogue: 0,0:06:25.34,0:06:28.59,Default,,0,0,0,,Жарайды, бәрі ойдағыдай өтеді.
Dialogue: 0,0:06:28.72,0:06:30.89,Default,,0,0,0,,Смузи сияқты
Dialogue: 0,0:06:33.97,0:06:36.85,Default,,0,0,0,,Қызықты Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,0:06:36.97,0:06:39.35,Default,,0,0,0,,Бұл жақсы болмады.
Dialogue: 0,0:06:39.73,0:06:43.65,Default,,0,0,0,,Маған еркіндік бересің бе?
Dialogue: 0,0:06:43.94,0:06:48.32,Default,,0,0,0,,Нағыз Корольдің жанында болу ғана қанағаттанарлық.
Dialogue: 0,0:06:48.44,0:06:50.53,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:06:50.66,0:06:52.24,Default,,0,0,0,,Мистер Столкер
Dialogue: 0,0:06:52.82,0:06:58.41,Default,,0,0,0,,Нағыз Патшамен бірге болғың келсе, менімен келе аласың.
Dialogue: 0,0:06:59.71,0:07:01.17,Default,,0,0,0,,Тым жақын
Dialogue: 0,0:07:03.75,0:07:06.21,Default,,0,0,0,,Клеверді «тым көп жейді» дейді.
Dialogue: 0,0:07:06.71,0:07:09.76,Default,,0,0,0,,Мен бүгін диетадан үзіліс аламын.
Dialogue: 0,0:07:10.34,0:07:12.47,Default,,0,0,0,,Патша, жақсысың ба?
Dialogue: 0,0:07:13.34,0:07:15.30,Default,,0,0,0,,Тез орындаңыз
Dialogue: 0,0:07:17.64,0:07:21.52,Default,,0,0,0,,Бұл қиын! Мен патшаны өлтірдім
Dialogue: 0,0:07:24.44,0:07:25.90,Default,,0,0,0,,Енді де!
Dialogue: 0,0:07:26.94,0:07:28.07,Default,,0,0,0,,Келесі мен
Dialogue: 0,0:07:30.53,0:07:32.91,Default,,0,0,0,,Мына жартастың астында не бар?
Dialogue: 0,0:07:33.99,0:07:35.07,Default,,0,0,0,,Барып көрейік
Dialogue: 0,0:07:45.59,0:07:47.21,Default,,0,0,0,,Ештеңе жоқ па?
Dialogue: 0,0:07:52.22,0:07:54.55,Default,,0,0,0,,Маған осындай нәрсе жасауға рұқсат бергеніңізге сене алар емеспін...
Dialogue: 0,0:07:54.68,0:07:58.10,Default,,0,0,0,,Сіз ең жақсы күзетшісіз.
Dialogue: 0,0:07:58.22,0:08:01.06,Default,,0,0,0,,Бірақ бұл аздап қауіпті болды.
Dialogue: 0,0:08:01.18,0:08:04.60,Default,,0,0,0,,Иә, менің де жүрегім дүрсілдеп тұр.
Dialogue: 0,0:08:04.73,0:08:05.73,Default,,0,0,0,,Көрдің бе?
Dialogue: 0,0:08:15.11,0:08:16.82,Default,,0,0,0,,Лемур.
Dialogue: 0,0:08:16.95,0:08:19.83,Default,,0,0,0,,Ах, бірақ мен классификацияға қызықпаймын.
Dialogue: 0,0:08:19.95,0:08:22.50,Default,,0,0,0,,Біз бәріміз ғаламның балаларымыз
Dialogue: 0,0:08:32.05,0:08:35.26,Default,,0,0,0,,Мен жіберсем, тағы шабуыл жасайсың ба?
Dialogue: 0,0:08:36.43,0:08:37.72,Default,,0,0,0,,Қазір емес
Dialogue: 0,0:08:37.85,0:08:41.31,Default,,0,0,0,,Бірақ бұл мәңгілік бола ма, жоқ па, білмеймін.
Dialogue: 0,0:08:43.94,0:08:44.77,Default,,0,0,0,,Норге?
Dialogue: 0,0:08:44.89,0:08:48.27,Default,,0,0,0,,Менің шашым өте әдемі
Dialogue: 0,0:08:48.40,0:08:52.03,Default,,0,0,0,,Мен құмырсқадан жасалған шаюды қолданамын.
Dialogue: 0,0:08:52.15,0:08:54.07,Default,,0,0,0,,Дәл сіз сияқты
Dialogue: 0,0:08:57.82,0:08:58.82,Default,,0,0,0,,Біреумен
Dialogue: 0,0:08:59.37,0:09:02.83,Default,,0,0,0,,Ол ерекше адам болуы керек.
Dialogue: 0,0:09:02.95,0:09:04.83,Default,,0,0,0,,Айтпақшы, менің атым...
Dialogue: 0,0:09:07.88,0:09:10.88,Default,,0,0,0,,Бірақ мені Сэйдж деп атаңыз.
Dialogue: 0,0:09:11.30,0:09:12.42,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:09:12.55,0:09:16.26,Default,,0,0,0,,Мен дүниенің бір бөлігін ғана сезіндім
Dialogue: 0,0:09:18.43,0:09:19.10,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:09:19.60,0:09:20.76,Default,,0,0,0,,Сіздің арманыңыз бар ма?
Dialogue: 0,0:09:20.89,0:09:24.60,Default,,0,0,0,,Бұл сіздің сұрағыңызға жауап бермейді.
Dialogue: 0,0:09:25.14,0:09:26.35,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:09:26.48,0:09:33.28,Default,,0,0,0,,Сіз ешқашан жалғыз емессіз, тек сіздің арманыңыз шындықты жеңсе.
Dialogue: 0,0:09:33.78,0:09:35.36,Default,,0,0,0,,Көзіңді аш
Dialogue: 0,0:09:35.65,0:09:38.03,Default,,0,0,0,,Болашаққа қарау
Dialogue: 0,0:09:38.16,0:09:42.74,Default,,0,0,0,,«Қош бол» өткен күннің айнасында жазылған
Dialogue: 0,0:09:42.87,0:09:44.37,Default,,0,0,0,,Сіз осында тұрасыз ба?
Dialogue: 0,0:09:47.87,0:09:50.13,Default,,0,0,0,,Мен нашар демалыста болдым.
Dialogue: 0,0:09:50.25,0:09:54.17,Default,,0,0,0,,Басқалар сияқты ойнау қорқынышты.
Dialogue: 0,0:09:54.30,0:09:58.72,Default,,0,0,0,,Мерекелер билеушілердің бізді бағындыратын құралы.
Dialogue: 0,0:09:58.84,0:10:01.18,Default,,0,0,0,,Біреу сені бірінші рет ұнатады
Dialogue: 0,0:10:01.30,0:10:02.26,Default,,0,0,0,,I-
Dialogue: 0,0:10:02.39,0:10:06.48,Default,,0,0,0,,Жапырақ тамшыларындағы шағылысуыма жиі қараймын.
Dialogue: 0,0:10:06.81,0:10:10.31,Default,,0,0,0,,Мен сол жапырақтармен ағаш отырғыздым.
Dialogue: 0,0:10:10.73,0:10:12.86,Default,,0,0,0,,Өмірдің байланысы
Dialogue: 0,0:10:14.40,0:10:17.65,Default,,0,0,0,,Сіздің достарыңыз сізді іздеп жатыр ма?
Dialogue: 0,0:10:18.15,0:10:19.66,Default,,0,0,0,,Лимбо!
Dialogue: 0,0:10:24.66,0:10:26.66,Default,,0,0,0,,Го Морт
Dialogue: 0,0:10:26.79,0:10:29.00,Default,,0,0,0,,Көктемгі демалыс ең жақсы!
Dialogue: 0,0:10:30.37,0:10:32.54,Default,,0,0,0,,Ешкім байқамайды
Dialogue: 0,0:10:32.67,0:10:35.05,Default,,0,0,0,,Маған осы жерді көрсете аласыз ба?
Dialogue: 0,0:10:35.17,0:10:36.09,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:10:36.80,0:10:38.17,Default,,0,0,0,,Менің сүйікті сөзім
Dialogue: 0,0:10:38.30,0:10:39.59,Default,,0,0,0,,Мен де
Dialogue: 0,0:10:40.05,0:10:42.01,Default,,0,0,0,,«Маған қалдырыңыз»
Dialogue: 0,0:10:42.47,0:10:45.43,Default,,0,0,0,,Менің де белімде жазылған.
Dialogue: 0,0:10:46.10,0:10:48.68,Default,,0,0,0,,Және оны өшіру мүмкін емес.
Dialogue: 0,0:10:49.27,0:10:51.94,Default,,0,0,0,,Мен бұл сусынға бірінші рет келіп отырмын.
Dialogue: 0,0:10:52.06,0:10:54.11,Default,,0,0,0,,Беде жақындамасын
Dialogue: 0,0:10:54.23,0:10:56.69,Default,,0,0,0,,Қауіпті немесе бір нәрсе
Dialogue: 0,0:10:56.82,0:10:58.32,Default,,0,0,0,,Сіз тым көп уайымдайсыз
Dialogue: 0,0:11:01.24,0:11:02.28,Default,,0,0,0,,Фосса?
Dialogue: 0,0:11:02.41,0:11:03.91,Default,,0,0,0,,Бұл әлі де қауіпті
Dialogue: 0,0:11:04.03,0:11:05.16,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:11:05.28,0:11:08.62,Default,,0,0,0,,Мені қорғау сенің міндетің. Одан құтыл.
Dialogue: 0,0:11:08.75,0:11:12.25,Default,,0,0,0,,Сен бедеден күштісің
Dialogue: 0,0:11:12.38,0:11:13.21,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:11:13.33,0:11:14.46,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:11:14.59,0:11:17.88,Default,,0,0,0,,Жарайды, сөздер өздігінен шықты.
Dialogue: 0,0:11:18.01,0:11:21.26,Default,,0,0,0,,Бірдеңе істемесең, жейсің.
Dialogue: 0,0:11:21.38,0:11:23.80,Default,,0,0,0,,Тренинг нәтижелерін көрсетіңіз
Dialogue: 0,0:11:23.93,0:11:26.47,Default,,0,0,0,,Иә, мен жаттықтым.
Dialogue: 0,0:11:27.01,0:11:29.98,Default,,0,0,0,,Тед, мені ұрып көріңіз.
Dialogue: 0,0:11:30.52,0:11:32.10,Default,,0,0,0,,Майор аман-есен!
Dialogue: 0,0:11:34.02,0:11:37.48,Default,,0,0,0,,Ей, ақымақтар, түсіңдер!
Dialogue: 0,0:11:37.61,0:11:40.86,Default,,0,0,0,,Мен гвардия капитанының орынбасарымын.
Dialogue: 0,0:11:40.99,0:11:44.41,Default,,0,0,0,,Бұл жерден кет, бұзақы.
Dialogue: 0,0:11:44.53,0:11:46.12,Default,,0,0,0,,Беде жоқ па?
Dialogue: 0,0:11:46.24,0:11:46.91,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:11:46.99,0:11:47.99,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:48.12,0:11:53.67,Default,,0,0,0,,Достарымның дәмді бөксесін қорғайтын менмін.
Dialogue: 0,0:11:54.08,0:11:56.09,Default,,0,0,0,,Керемет! Жоқ, күте тұрыңыз
Dialogue: 0,0:11:56.21,0:11:58.25,Default,,0,0,0,,Жаман бейбақ
Dialogue: 0,0:11:58.38,0:11:59.96,Default,,0,0,0,,Майор аман-есен!
Dialogue: 0,0:12:04.68,0:12:08.68,Default,,0,0,0,,Жақсы, мен кішкентай болады деп ойладым.
Dialogue: 0,0:12:09.01,0:12:12.06,Default,,0,0,0,,Әйтеуір, кішкене ғана болды.
Dialogue: 0,0:12:15.23,0:12:17.44,Default,,0,0,0,,Беде жоқ па?
Dialogue: 0,0:12:19.32,0:12:20.57,Default,,0,0,0,,Фосса шабуылы!
Dialogue: 0,0:12:25.91,0:12:28.33,Default,,0,0,0,,Көктемгі демалыс!
Dialogue: 0,0:12:30.04,0:12:33.37,Default,,0,0,0,,Кітаптан да жақсы, солай ма? Беде?
Dialogue: 0,0:12:34.42,0:12:36.08,Default,,0,0,0,,Көктемгі демалыс!
Dialogue: 0,0:12:36.21,0:12:38.67,Default,,0,0,0,,Көктемгі демалыс көңілді!
Dialogue: 0,0:12:44.72,0:12:45.80,Default,,0,0,0,,Дәмді
Dialogue: 0,0:12:45.93,0:12:49.81,Default,,0,0,0,,Өз зәріңді ішуден шаршасаң, оны іш.
Dialogue: 0,0:12:49.93,0:12:52.89,Default,,0,0,0,,Сіздің өміріңіз тамаша
Dialogue: 0,0:12:53.02,0:12:55.60,Default,,0,0,0,,Күшті және күшті өмір сүру
Dialogue: 0,0:12:55.73,0:12:58.86,Default,,0,0,0,,Табиғатқа қарсы күрес және аң аулау
Dialogue: 0,0:12:59.48,0:13:04.82,Default,,0,0,0,,Бірақ нағыз Данышпан соғысуға және өлтіруге шебер...
Dialogue: 0,0:13:04.95,0:13:06.78,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:13:06.95,0:13:08.12,Default,,0,0,0,,Бірақ ол күшті
Dialogue: 0,0:13:08.24,0:13:10.16,Default,,0,0,0,,Мұғалімнен үйренген
Dialogue: 0,0:13:10.28,0:13:13.37,Default,,0,0,0,,Шабуыл адамдарды көріксіз етеді
Dialogue: 0,0:13:13.50,0:13:17.79,Default,,0,0,0,,Зорлық-зомбылықсыз өмір лосось сияқты әдемі
Dialogue: 0,0:13:18.29,0:13:19.59,Default,,0,0,0,,Қашан қауіпті?
Dialogue: 0,0:13:19.71,0:13:24.34,Default,,0,0,0,,Қауіп-қорқыныш пен уайымға қарама-қайшы
Dialogue: 0,0:13:24.84,0:13:28.76,Default,,0,0,0,,Қайта салқын тұра аласыз ба?
Dialogue: 0,0:13:28.89,0:13:30.80,Default,,0,0,0,,Шашыңызды жайып жіберіңіз
Dialogue: 0,0:13:31.97,0:13:33.52,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:13:35.27,0:13:36.39,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:13:36.52,0:13:39.40,Default,,0,0,0,,Мүмкін болса, сөйлеме
Dialogue: 0,0:13:39.77,0:13:41.07,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:41.19,0:13:44.82,Default,,0,0,0,,Бірде мен үш жыл үндемей қалдым.
Dialogue: 0,0:13:44.94,0:13:48.24,Default,,0,0,0,,Зауытпен ұрысып қалдым да қалдым.
Dialogue: 0,0:13:48.57,0:13:49.32,Default,,0,0,0,,Не?
Dialogue: 0,0:13:49.45,0:13:50.12,Default,,0,0,0,,Бөлек
Dialogue: 0,0:13:50.24,0:13:54.95,Default,,0,0,0,,Тек шындыққа қарап, өзіңізді депрессияға ұшыратыңыз.
Dialogue: 0,0:13:57.67,0:13:58.54,Default,,0,0,0,,Енді
Dialogue: 0,0:13:58.67,0:14:00.67,Default,,0,0,0,,Норгейді қорғау
Dialogue: 0,0:14:00.79,0:14:01.54,Default,,0,0,0,,Норге?
Dialogue: 0,0:14:01.67,0:14:03.71,Default,,0,0,0,,Мен Садж дедім.
Dialogue: 0,0:14:18.19,0:14:19.94,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:14:21.23,0:14:22.98,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:23.57,0:14:28.61,Default,,0,0,0,,Кешіріңіз, жылан сізді ашуландырды.
Dialogue: 0,0:14:28.74,0:14:29.86,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:30.78,0:14:32.37,Default,,0,0,0,,Бұл күшті, солай емес пе?
Dialogue: 0,0:14:33.62,0:14:36.33,Default,,0,0,0,,Мен қызып бара жатқандай сезінемін.
Dialogue: 0,0:14:41.71,0:14:43.71,Default,,0,0,0,,Өте шебер.
Dialogue: 0,0:14:43.84,0:14:45.84,Default,,0,0,0,,Қарап көріңіз.
Dialogue: 0,0:14:45.96,0:14:50.55,Default,,0,0,0,,Король бикини кисе, күлкілі емес пе?
Dialogue: 0,0:14:51.26,0:14:53.68,Default,,0,0,0,,А, бұл қызық.
Dialogue: 0,0:14:55.18,0:14:56.27,Default,,0,0,0,,Қазір қайту
Dialogue: 0,0:14:57.31,0:14:59.85,Default,,0,0,0,,Маған көмектес, Тед - ең жаман.
Dialogue: 0,0:14:59.98,0:15:02.52,Default,,0,0,0,,Кловерге демалуға кім рұқсат берді?
Dialogue: 0,0:15:02.65,0:15:04.36,Default,,0,0,0,,Король
Dialogue: 0,0:15:04.48,0:15:06.40,Default,,0,0,0,,Тед дегеніміз не?
Dialogue: 0,0:15:06.53,0:15:12.03,Default,,0,0,0,,Кловерсіз мен тек қауіпті ойнаймын.
Dialogue: 0,0:15:12.16,0:15:14.49,Default,,0,0,0,,Бізге берік адам керек.
Dialogue: 0,0:15:14.62,0:15:17.29,Default,,0,0,0,,Тед тым бос-
Dialogue: 0,0:15:17.41,0:15:19.83,Default,,0,0,0,,Бұл ірімшік сияқты
Dialogue: 0,0:15:19.96,0:15:23.46,Default,,0,0,0,,Кловер ертең қайтады.
Dialogue: 0,0:15:23.58,0:15:26.63,Default,,0,0,0,,Керемет, Тед Фоссаға барады...
Dialogue: 0,0:15:26.75,0:15:30.05,Default,,0,0,0,,Кловер маған демалыста екенін айтты.
Dialogue: 0,0:15:30.17,0:15:31.09,Default,,0,0,0,,Не?
Dialogue: 0,0:15:31.34,0:15:34.30,Default,,0,0,0,,Мен сен туралы бәрін білгім келеді
Dialogue: 0,0:15:34.80,0:15:38.27,Default,,0,0,0,,Маған жасырын армандарыңды айт
Dialogue: 0,0:15:38.81,0:15:41.56,Default,,0,0,0,,Мен Чоумен бір сағат сөйлестім.
Dialogue: 0,0:15:41.69,0:15:44.48,Default,,0,0,0,,Үйренетін нәрсе көп.
Dialogue: 0,0:15:45.02,0:15:48.40,Default,,0,0,0,,Рахмет, сен ақылдысың.
Dialogue: 0,0:15:48.86,0:15:53.70,Default,,0,0,0,,Мен мұны сен Чомен сөйлесіп тұрғанда таптым.
Dialogue: 0,0:15:53.82,0:15:55.91,Default,,0,0,0,,Фосса ізі
Dialogue: 0,0:16:02.71,0:16:04.04,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:16:04.17,0:16:05.63,Default,,0,0,0,,Ауылға қарай бет алды
Dialogue: 0,0:16:05.75,0:16:07.75,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:16:07.88,0:16:12.80,Default,,0,0,0,,Мен жоқта патшалыққа қауіп төнсе қауіпті болар еді.
Dialogue: 0,0:16:13.13,0:16:14.64,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:16:14.76,0:16:15.43,Default,,0,0,0,,«Қауіп»
Dialogue: 0,0:16:15.55,0:16:18.76,Default,,0,0,0,,Бұл тұзақ
Dialogue: 0,0:16:18.89,0:16:23.60,Default,,0,0,0,,Бәрімізді тағдыр басқарады.
Dialogue: 0,0:16:23.73,0:16:25.44,Default,,0,0,0,,Жай қуыршақ
Dialogue: 0,0:16:25.56,0:16:26.69,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:26.81,0:16:31.40,Default,,0,0,0,,Менің романымда сіз батыл және күштісіз...
Dialogue: 0,0:16:31.53,0:16:34.95,Default,,0,0,0,,Ол ер мінезді және мейірімді болуы керек.
Dialogue: 0,0:16:35.07,0:16:37.16,Default,,0,0,0,,Бұлшықеттер не үшін қажет?
Dialogue: 0,0:16:37.28,0:16:40.70,Default,,0,0,0,,Еш нәрсе күшпен шешілмейді
Dialogue: 0,0:16:42.50,0:16:46.58,Default,,0,0,0,,Иә, бірақ мен оны сипау жақсы сезінеді.
Dialogue: 0,0:16:50.09,0:16:51.84,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:16:54.88,0:16:58.30,Default,,0,0,0,,Джиги, оян, оян.
Dialogue: 0,0:16:58.47,0:17:00.51,Default,,0,0,0,,Өлме
Dialogue: 0,0:17:03.27,0:17:06.69,Default,,0,0,0,,Көктемгі демалыс! Демалыс тамаша!
Dialogue: 0,0:17:06.81,0:17:09.31,Default,,0,0,0,,Біз өлмейміз
Dialogue: 0,0:17:11.86,0:17:14.28,Default,,0,0,0,,Мен ойнадым, үйге қайтайық.
Dialogue: 0,0:17:14.53,0:17:16.20,Default,,0,0,0,,Кловер жарай ма?
Dialogue: 0,0:17:16.74,0:17:17.95,Default,,0,0,0,,Беде?
Dialogue: 0,0:17:21.41,0:17:25.12,Default,,0,0,0,,Вице-капитан кіреді.
Dialogue: 0,0:17:26.96,0:17:28.63,Default,,0,0,0,,Көңіл-күйіңіз жақсы ма?
Dialogue: 0,0:17:28.75,0:17:30.67,Default,,0,0,0,,Сіз оны Фоссаға бердіңіз бе?
Dialogue: 0,0:17:33.42,0:17:35.05,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:17:35.17,0:17:38.09,Default,,0,0,0,,Сіз мені жұмыстан шығарғыңыз келе ме?
Dialogue: 0,0:17:41.26,0:17:42.18,Default,,0,0,0,,Боқ
Dialogue: 0,0:17:42.31,0:17:43.81,Default,,0,0,0,,Король...
Dialogue: 0,0:17:44.22,0:17:48.31,Default,,0,0,0,,Егер сіз кеңесші болсаңыз, жақсырақ әрекет етіңіз.
Dialogue: 0,0:17:48.44,0:17:51.61,Default,,0,0,0,,Оған иығыңызды қойып, жұбатыңыз.
Dialogue: 0,0:17:51.73,0:17:54.28,Default,,0,0,0,,Мен сені кінәлап отырған жоқпын.
Dialogue: 0,0:17:54.40,0:17:58.61,Default,,0,0,0,,Мен жай ғана жақсы жұмыс істеуге тырыстым.
Dialogue: 0,0:18:00.99,0:18:02.99,Default,,0,0,0,,Жақсы иіс шығады.
Dialogue: 0,0:18:09.29,0:18:09.96,Default,,0,0,0,,Патша
Dialogue: 0,0:18:15.51,0:18:17.80,Default,,0,0,0,,Беде жоғалып кетті
Dialogue: 0,0:18:18.93,0:18:20.01,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:18:20.14,0:18:23.10,Default,,0,0,0,,Мен беде жоқ екенін білсем де...
Dialogue: 0,0:18:23.22,0:18:27.81,Default,,0,0,0,,Фосса шабуылдамауы мүмкін.
Dialogue: 0,0:18:30.48,0:18:32.06,Default,,0,0,0,,Дүрбелеңге салынбаңыз
Dialogue: 0,0:18:32.19,0:18:36.24,Default,,0,0,0,,Фосса келген сияқты, бірақ мен әлі білмеймін.
Dialogue: 0,0:18:39.45,0:18:41.70,Default,,0,0,0,,Фосса, Тедке барыңыз.
Dialogue: 0,0:18:41.82,0:18:44.37,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:18:44.58,0:18:45.62,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:18:45.74,0:18:48.00,Default,,0,0,0,,Бір нәрсені тез орындаңыз
Dialogue: 0,0:18:49.00,0:18:51.46,Default,,0,0,0,,Мен тағы да бар күшімді саламын
Dialogue: 0,0:18:56.26,0:18:58.47,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:19:02.05,0:19:05.76,Default,,0,0,0,,Неліктен Фосса шаршағанша күту керек?
Dialogue: 0,0:19:07.35,0:19:09.89,Default,,0,0,0,,Патшалық сізге байланысты
Dialogue: 0,0:19:10.02,0:19:12.77,Default,,0,0,0,,Соғыспасаң өлесің.
Dialogue: 0,0:19:12.90,0:19:16.19,Default,,0,0,0,,Мен, барлығы, әсіресе мен.
Dialogue: 0,0:19:16.32,0:19:19.70,Default,,0,0,0,,Жақсы жүріп жатқан сияқты...
Dialogue: 0,0:19:19.82,0:19:21.57,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:23.53,0:19:27.37,Default,,0,0,0,,Егер бұл күтпеген шабуыл болса, мен сені жеңе аламын.
Dialogue: 0,0:19:30.04,0:19:30.87,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:19:33.67,0:19:36.84,Default,,0,0,0,,Мен құтқарылдым, тағы біраз...
Dialogue: 0,0:19:37.42,0:19:39.26,Default,,0,0,0,,Чиби қайтадан
Dialogue: 0,0:19:54.31,0:19:55.15,Default,,0,0,0,,Шалфей?
Dialogue: 0,0:19:55.52,0:19:57.98,Default,,0,0,0,,Біз қалай қоштасқанбыз...
Dialogue: 0,0:19:58.28,0:20:01.03,Default,,0,0,0,,Бұл өте жақсы болмады.
Dialogue: 0,0:20:04.16,0:20:06.16,Default,,0,0,0,,Мен қорқынышты нәрсе айттым, бірақ...
Dialogue: 0,0:20:06.41,0:20:07.78,Default,,0,0,0,,Маңызды емес
Dialogue: 0,0:20:09.37,0:20:13.08,Default,,0,0,0,,Мен саған зорлық көрсету үшін келдім.
Dialogue: 0,0:20:15.29,0:20:16.25,Default,,0,0,0,,Кейінірек -
Dialogue: 0,0:20:16.88,0:20:18.30,Default,,0,0,0,,талқылайық
Dialogue: 0,0:20:25.80,0:20:26.76,Default,,0,0,0,,Ынтымақтастық
Dialogue: 0,0:20:42.78,0:20:44.20,Default,,0,0,0,,Біздің жеңіс
Dialogue: 0,0:20:44.32,0:20:47.07,Default,,0,0,0,,Мен зәрімді сүрткен жоқпын.
Dialogue: 0,0:20:47.66,0:20:48.78,Default,,0,0,0,,Үрлеу
Dialogue: 0,0:20:48.91,0:20:52.83,Default,,0,0,0,,Мен әдетте мұндай сөздерді айтпаймын, бірақ...
Dialogue: 0,0:20:52.96,0:20:54.41,Default,,0,0,0,,Эй, көрдің бе?
Dialogue: 0,0:20:54.54,0:20:58.09,Default,,0,0,0,,Себебі мен демалыс сұрадым.
Dialogue: 0,0:20:58.21,0:20:59.71,Default,,0,0,0,,Король демалуымды өтінді...
Dialogue: 0,0:20:59.84,0:21:02.01,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:02.13,0:21:03.34,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:21:03.72,0:21:07.43,Default,,0,0,0,,Айту қиын, бірақ сен...
Dialogue: 0,0:21:07.84,0:21:09.51,Default,,0,0,0,,Өте дарынды
Dialogue: 0,0:21:09.64,0:21:11.60,Default,,0,0,0,,Айтуға оңай сияқты.
Dialogue: 0,0:21:12.43,0:21:17.81,Default,,0,0,0,,Егер оны тоқтататын ешкім болмаса, оны жіберу қызық емес
Dialogue: 0,0:21:17.94,0:21:22.44,Default,,0,0,0,,Сіз тамаша тығынсыз.
Dialogue: 0,0:21:23.24,0:21:24.03,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:24.15,0:21:27.41,Default,,0,0,0,,Мынау мачо жігіт кім?
Dialogue: 0,0:21:30.58,0:21:31.87,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:21:35.16,0:21:37.12,Default,,0,0,0,,Мен оны есімде сақтайтын сияқтымын
Dialogue: 0,0:21:37.50,0:21:41.67,Default,,0,0,0,,Осы екеуі болмағанда барлығы не болар еді?
Dialogue: 0,0:21:41.80,0:21:43.30,Default,,0,0,0,,Бәлкім, солай шығар
Dialogue: 0,0:21:43.84,0:21:46.01,Default,,0,0,0,,"Жаман! Бұл Фосса."
Dialogue: 0,0:21:46.13,0:21:49.93,Default,,0,0,0,,«Неге беде жоқ?»
Dialogue: 0,0:21:50.64,0:21:51.43,Default,,0,0,0,,«Неге?»
Dialogue: 0,0:21:51.56,0:21:52.60,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:21:54.56,0:21:55.23,Default,,0,0,0,,Бір нәрсе сияқты
Dialogue: 0,0:21:57.39,0:21:58.31,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:21:58.52,0:22:02.73,Default,,0,0,0,,Көңілді болыңыз! Көптеген батуттар бар.
Dialogue: 0,0:22:02.86,0:22:05.49,Default,,0,0,0,,Мен қызыммен әлі ұрысып жатырмын, сондықтан...
Dialogue: 0,0:22:05.61,0:22:09.11,Default,,0,0,0,,Мен дұрыстап қоштасуға келдім.
Dialogue: 0,0:22:09.24,0:22:11.12,Default,,0,0,0,,Бұл Саджға ұқсамады.
Dialogue: 0,0:22:11.24,0:22:13.04,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:22:13.58,0:22:14.75,Default,,0,0,0,,О.
Dialogue: 0,0:22:16.75,0:22:19.42,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:22:22.46,0:22:25.51,Default,,0,0,0,,Олай болса, қош болыңыз.
Dialogue: 0,0:22:32.14,0:22:33.26,Default,,0,0,0,,Йокогама Токионың бір бөлігі ғой!
Dialogue: 0,0:22:33.39,0:22:38.73,Default,,0,0,0,,Мен енді ешқашан демалысқа шықпаймын.
Dialogue: 0,0:23:06.00,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Михо Ичихара
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
