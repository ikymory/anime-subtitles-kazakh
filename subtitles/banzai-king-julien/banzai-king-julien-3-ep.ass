Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:43.41,0:00:45.75,Default,,0,0,0,,Бүгін Франктер күні!
Dialogue: 0,0:00:46.12,0:00:48.50,Default,,0,0,0,,Сіздерді Франктер күнімен құттықтаймыз!
Dialogue: 0,0:00:57.47,0:01:00.51,Default,,0,0,0,,Тед не сұрайды?
Dialogue: 0,0:01:00.64,0:01:03.68,Default,,0,0,0,,Былтырғыдай, жарқыраған бірдеңе
Dialogue: 0,0:01:03.81,0:01:06.39,Default,,0,0,0,,Мені «түсінікті адам» деп атаңыз.
Dialogue: 0,0:01:06.60,0:01:09.15,Default,,0,0,0,,Мен шығып кетемін!
Dialogue: 0,0:01:12.11,0:01:13.82,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:01:13.94,0:01:16.61,Default,,0,0,0,,Міне, көктемгі демалыс.
Dialogue: 0,0:01:18.28,0:01:19.28,Default,,0,0,0,,Морт ше?
Dialogue: 0,0:01:19.41,0:01:22.20,Default,,0,0,0,,Тілек – құпия
Dialogue: 0,0:01:22.33,0:01:24.16,Default,,0,0,0,,Бәрі жақсы. Ең болмағанда бұл жабайы аңдардың аумағы емес.
Dialogue: 0,0:01:28.29,0:01:30.71,Default,,0,0,0,,Бұл... құпияны сақтаңыз.
Dialogue: 0,0:01:36.76,0:01:39.14,Default,,0,0,0,,Мадагаскардағы барлық адамдар
Dialogue: 0,0:01:39.55,0:01:41.64,Default,,0,0,0,,Бүгін Франктер күні
Dialogue: 0,0:01:41.76,0:01:45.48,Default,,0,0,0,,Барлығының тілектерін себетке сал.
Dialogue: 0,0:01:45.56,0:01:50.06,Default,,0,0,0,,Құрметті аспан құдайы Франкке арналған.
Dialogue: 0,0:01:51.40,0:01:53.23,Default,,0,0,0,,Фрэнкті мадақтау
Dialogue: 0,0:01:54.57,0:01:56.15,Default,,0,0,0,,Ережені түсінесің бе?
Dialogue: 0,0:01:56.28,0:01:58.70,Default,,0,0,0,,Бір адамға бір тілек
Dialogue: 0,0:01:58.82,0:02:01.66,Default,,0,0,0,,Өйткені мен аңдып жүрдім.
Dialogue: 0,0:02:01.78,0:02:06.45,Default,,0,0,0,,Өз тілегіңіз жазылған бір ғана тасты қойыңыз.
Dialogue: 0,0:02:06.58,0:02:09.54,Default,,0,0,0,,Мен саған айтамын, Вилли.
Dialogue: 0,0:02:10.08,0:02:11.50,Default,,0,0,0,,Не?
Dialogue: 0,0:02:14.13,0:02:15.17,Default,,0,0,0,,Иә келесі!
Dialogue: 0,0:02:16.05,0:02:17.05,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:02:18.17,0:02:20.05,Default,,0,0,0,,Бұл да жақсы емес.
Dialogue: 0,0:02:23.93,0:02:25.22,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:02:25.35,0:02:28.06,Default,,0,0,0,,Қалауды шешу мүмкін емес
Dialogue: 0,0:02:28.18,0:02:29.56,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:02:29.69,0:02:32.02,Default,,0,0,0,,Жұмсақ жамбас буындары?
Dialogue: 0,0:02:32.15,0:02:34.65,Default,,0,0,0,,Көздер ажыратылған жоқ па?
Dialogue: 0,0:02:34.77,0:02:38.36,Default,,0,0,0,,Жоқ, шешу патшаның міндеті емес.
Dialogue: 0,0:02:38.49,0:02:40.20,Default,,0,0,0,,Фрэнк ойлансын
Dialogue: 0,0:02:40.32,0:02:44.33,Default,,0,0,0,,Сіз оны осылай жазсаңыз, түсінуіңіз керек
Dialogue: 0,0:02:40.32,0:02:44.33,Default,,0,0,0,,«Мені таң қалдыр»
Dialogue: 0,0:02:44.45,0:02:46.24,Default,,0,0,0,,«Мені таң қалдыр»?
Dialogue: 0,0:02:48.83,0:02:50.83,Default,,0,0,0,,Шар ұшып кетсін
Dialogue: 0,0:02:57.67,0:02:58.97,Default,,0,0,0,,Ол ұшты!
Dialogue: 0,0:03:01.84,0:03:04.80,Default,,0,0,0,,Король Джульен! Патша қиыншылықта
Dialogue: 0,0:03:06.64,0:03:08.56,Default,,0,0,0,,Барлығы өледі!
Dialogue: 0,0:03:08.68,0:03:11.06,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:03:11.19,0:03:13.69,Default,,0,0,0,,Естеліктер жанып тұрған шамдар сияқты...
Dialogue: 0,0:03:13.81,0:03:16.48,Default,,0,0,0,,Шынымды айтсам, бұл ең жақсы өмір болды
Dialogue: 0,0:03:16.86,0:03:18.15,Default,,0,0,0,,Маған тезірек көмектесіңіз
Dialogue: 0,0:03:18.28,0:03:21.07,Default,,0,0,0,,Менің басыма қан жиналып, жарылып кетті
Dialogue: 0,0:03:21.20,0:03:22.86,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:03:22.99,0:03:24.99,Default,,0,0,0,,Қаттылығы мен ылғалдылығы жақсы
Dialogue: 0,0:03:25.12,0:03:27.66,Default,,0,0,0,,Бұл қауіпті, сондықтан артта қалыңыз.
Dialogue: 0,0:03:34.71,0:03:37.21,Default,,0,0,0,,Ол құс бедеге ұқсайды.
Dialogue: 0,0:03:38.71,0:03:42.05,Default,,0,0,0,,Бостандық! Сізге рахмет...
Dialogue: 0,0:03:42.22,0:03:44.76,Default,,0,0,0,,Осыдан кейін не істеуім керек?
Dialogue: 0,0:03:48.18,0:03:49.18,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:03:49.31,0:03:51.14,Default,,0,0,0,,Мен оны қабылдауым керек
Dialogue: 0,0:03:51.27,0:03:53.44,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:03:53.56,0:03:55.23,Default,,0,0,0,,Ей, ол қайда? Денесі қайда?!
Dialogue: 0,0:03:55.36,0:03:57.94,Default,,0,0,0,,Маған кел
Dialogue: 0,0:04:00.40,0:04:01.44,Default,,0,0,0,,Сіз қауіпсізсіз.
Dialogue: 0,0:04:01.57,0:04:04.28,Default,,0,0,0,,Мен бақыттырақ болар едім
Dialogue: 0,0:04:04.41,0:04:06.12,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:04:06.24,0:04:10.33,Default,,0,0,0,,Құдай мені мазақ еткендей
Dialogue: 0,0:04:11.25,0:04:14.33,Default,,0,0,0,,Бұл күлкілі әзіл, Құдайым.
Dialogue: 0,0:04:14.75,0:04:17.21,Default,,0,0,0,,Құдайдың қатысы жоқ сияқты
Dialogue: 0,0:04:17.34,0:04:19.42,Default,,0,0,0,,Мен бұл шырмауықты бұрын ешқашан көрген емеспін.
Dialogue: 0,0:04:19.55,0:04:21.38,Default,,0,0,0,,Патшалық емес.
Dialogue: 0,0:04:21.51,0:04:27.97,Default,,0,0,0,,Біреу менің жанымды алу үшін аяғыма шырмауық байлады ма?
Dialogue: 0,0:04:31.06,0:04:32.85,Default,,0,0,0,,Сіз не үшін тұрсыз?
Dialogue: 0,0:04:32.98,0:04:37.56,Default,,0,0,0,,Франксгивинг іс-шарасы Су слайды!
Dialogue: 0,0:04:41.94,0:04:44.15,Default,,0,0,0,,Көңілді сияқты
Dialogue: 0,0:04:45.78,0:04:47.16,Default,,0,0,0,,Тезірек!
Dialogue: 0,0:04:57.79,0:04:59.75,Default,,0,0,0,,Менің басым жерге батып кетті.
Dialogue: 0,0:04:59.88,0:05:02.55,Default,,0,0,0,,Бассейнде су болған жоқ па?
Dialogue: 0,0:05:02.67,0:05:04.51,Default,,0,0,0,,Бұл кеше болды.
Dialogue: 0,0:05:04.63,0:05:07.47,Default,,0,0,0,,Шардан кейін біртүрлі.
Dialogue: 0,0:05:07.59,0:05:11.01,Default,,0,0,0,,Бұл құпия ма? Маған да айтыңыз
Dialogue: 0,0:05:11.18,0:05:13.47,Default,,0,0,0,,Мен біреуді ренжіттім бе?
Dialogue: 0,0:05:15.98,0:05:18.60,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:05:20.61,0:05:22.94,Default,,0,0,0,,Бұл жолы не істедің?
Dialogue: 0,0:05:23.07,0:05:25.36,Default,,0,0,0,,Ештеңе емес, мен танымалмын.
Dialogue: 0,0:05:25.53,0:05:31.03,Default,,0,0,0,,Ең көп сатылатын 10 кітаптың барлығы мен туралы.
Dialogue: 0,0:05:31.16,0:05:32.58,Default,,0,0,0,,``Джулианның сүйісі'' Авторы: Морт
Dialogue: 0,0:05:32.70,0:05:34.29,Default,,0,0,0,,``Джулианның махаббаты'' Авторы: Морт
Dialogue: 0,0:05:34.41,0:05:35.71,Default,,0,0,0,,``Джулианның шынайы келбеті'' Авторы: Морт
Dialogue: 0,0:05:37.25,0:05:39.71,Default,,0,0,0,,Барлығы менің жанкүйерім
Dialogue: 0,0:05:39.83,0:05:42.42,Default,,0,0,0,,Мен уайымдап сенің жаныңдамын.
Dialogue: 0,0:05:42.50,0:05:46.09,Default,,0,0,0,,Кешіріңіз, бірақ маған қарап тұрған ұнамайды.
Dialogue: 0,0:05:46.63,0:05:49.84,Default,,0,0,0,,Морис әлсіз болып саналады, сондықтан да келме.
Dialogue: 0,0:05:49.93,0:05:50.64,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:50.72,0:05:54.02,Default,,0,0,0,,Ұстамаңыз. Мен қазір душқа түсемін.
Dialogue: 0,0:05:54.14,0:05:58.52,Default,,0,0,0,,Мерекенің ішін балшық басып, рахаттана алмайсың.
Dialogue: 0,0:05:58.64,0:06:01.56,Default,,0,0,0,,Бұл болады деп айтудың пайдасы жоқ.
Dialogue: 0,0:06:01.69,0:06:04.73,Default,,0,0,0,,Сіз өз әлеміңізге кірген кезде
Dialogue: 0,0:06:04.86,0:06:08.36,Default,,0,0,0,,Қауіпсіз екеніне сенімді болмайынша, мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:06:08.49,0:06:13.74,Default,,0,0,0,,Король өзінің күзетшісі деп санамайтын адамды бекітіңіз.
Dialogue: 0,0:06:16.70,0:06:17.96,Default,,0,0,0,,Балшық
Dialogue: 0,0:06:19.17,0:06:23.92,Default,,0,0,0,,Морт патшаға бірдеңе болса, біз қиындыққа тап боламыз.
Dialogue: 0,0:06:24.05,0:06:26.30,Default,,0,0,0,,Иә! мен патшаны жақсы көремін
Dialogue: 0,0:06:26.42,0:06:30.76,Default,,0,0,0,,Содан кейін Патшаның соңынан еріп, оны бақылаңыз.
Dialogue: 0,0:06:30.89,0:06:33.93,Default,,0,0,0,,Бірақ бұл құпия. Сіз құпияның не екенін білесіз бе?
Dialogue: 0,0:06:34.10,0:06:37.93,Default,,0,0,0,,Сізді ешкім тоқтата алмайтынын түсінгенше...
Dialogue: 0,0:06:38.06,0:06:41.02,Default,,0,0,0,,Жоспарларды шетте қалдыру
Dialogue: 0,0:06:41.15,0:06:44.48,Default,,0,0,0,,Ал... Менің ойымша, бұл дұрыс.
Dialogue: 0,0:06:50.61,0:06:51.70,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:06:55.45,0:06:58.29,Default,,0,0,0,,Морт, маған жасырын келме
Dialogue: 0,0:06:58.45,0:06:59.54,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:01.75,0:07:03.46,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:07:14.89,0:07:15.72,Default,,0,0,0,,Патша!
Dialogue: 0,0:07:16.56,0:07:18.77,Default,,0,0,0,,Морт не істейді?
Dialogue: 0,0:07:18.89,0:07:20.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:20.31,0:07:24.77,Default,,0,0,0,,Мен жеміс улы болуы мүмкін деп қорқамын.
Dialogue: 0,0:07:24.90,0:07:25.77,Default,,0,0,0,,Улы?
Dialogue: 0,0:07:25.90,0:07:31.15,Default,,0,0,0,,Сіз Кловер мен Мориспен бірдеңе туралы сөйлесіп тұрдыңыз.
Dialogue: 0,0:07:31.32,0:07:35.20,Default,,0,0,0,,Ешкім мені нысанаға алып жатқан жоқ.
Dialogue: 0,0:07:36.83,0:07:41.41,Default,,0,0,0,,Әуелі дәмін татып көр.
Dialogue: 0,0:07:45.29,0:07:46.42,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:07:47.46,0:07:49.17,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:08:01.64,0:08:04.73,Default,,0,0,0,,Кловер және басқалар айтқандай ма?
Dialogue: 0,0:08:05.65,0:08:07.02,Default,,0,0,0,,Мен тексеруім керек
Dialogue: 0,0:08:12.78,0:08:16.99,Default,,0,0,0,,Қысқа аяқтарыңыз жете алатындай жерге түсіңіз.
Dialogue: 0,0:08:17.74,0:08:19.58,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:08:29.63,0:08:30.38,Default,,0,0,0,,Морт?
Dialogue: 0,0:08:33.38,0:08:35.34,Default,,0,0,0,,Патша, амансың ба?
Dialogue: 0,0:08:35.47,0:08:39.56,Default,,0,0,0,,Мен біртүрлі нәрсе туралы тым көп ойладым деп ойлаймын.
Dialogue: 0,0:08:39.68,0:08:42.77,Default,,0,0,0,,Мені көздегендер...
Dialogue: 0,0:08:49.98,0:08:50.98,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:08:53.24,0:08:55.91,Default,,0,0,0,,Бұл шынымен қауіпсіз бе?
Dialogue: 0,0:08:56.03,0:08:58.99,Default,,0,0,0,,Мен нысанаға алынғаныма сенімдімін.
Dialogue: 0,0:08:59.12,0:09:01.83,Default,,0,0,0,,Олай болса менің кезегім
Dialogue: 0,0:09:01.95,0:09:04.75,Default,,0,0,0,,Эскорт – маңызды миссия
Dialogue: 0,0:09:07.50,0:09:09.42,Default,,0,0,0,,Дәл және сенімді -
Dialogue: 0,0:09:09.54,0:09:12.09,Default,,0,0,0,,Және мұны ақылмен орындаңыз
Dialogue: 0,0:09:12.21,0:09:14.47,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:09:15.51,0:09:18.55,Default,,0,0,0,,Бөлме қауіпсіз. Тағы не?
Dialogue: 0,0:09:18.68,0:09:22.93,Default,,0,0,0,,Менің ұйықтағым келеді, шығыңыз.
Dialogue: 0,0:09:23.06,0:09:26.06,Default,,0,0,0,,Ертең менің маңызды жұмысым бар.
Dialogue: 0,0:09:26.19,0:09:29.36,Default,,0,0,0,,Менде бәрі жақсы!
Dialogue: 0,0:09:29.48,0:09:30.27,Default,,0,0,0,,Беде
Dialogue: 0,0:09:30.40,0:09:31.44,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:09:40.91,0:09:43.41,Default,,0,0,0,,Ақыры сені кездестірдім.
Dialogue: 0,0:09:45.16,0:09:46.21,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:46.33,0:09:50.88,Default,,0,0,0,,Мен сені көптен бері іздеп жүрмін.
Dialogue: 0,0:09:51.50,0:09:53.80,Default,,0,0,0,,Менің ар-ұжданым?
Dialogue: 0,0:09:53.96,0:09:56.13,Default,,0,0,0,,Сәби кезімде жоғалып кетті
Dialogue: 0,0:09:56.26,0:09:58.72,Default,,0,0,0,,«Семіз» деп атағандықтан ба?
Dialogue: 0,0:10:01.47,0:10:05.85,Default,,0,0,0,,Сіздің күлкіңіз соншалықты қатты болды ма?
Dialogue: 0,0:10:06.14,0:10:09.77,Default,,0,0,0,,Айқайлауды кейінге қалдырыңыз.
Dialogue: 0,0:10:09.90,0:10:13.69,Default,,0,0,0,,Мен сені ренжіткім келмейді, мен сенің жанкүйерлеріңмін.
Dialogue: 0,0:10:13.82,0:10:15.40,Default,,0,0,0,,Мен Карлмын
Dialogue: 0,0:10:15.53,0:10:20.11,Default,,0,0,0,,Неге менің ар-ұжданым болдың?
Dialogue: 0,0:10:20.24,0:10:21.70,Default,,0,0,0,,Менің істерім
Dialogue: 0,0:10:22.62,0:10:23.66,Default,,0,0,0,,Не?
Dialogue: 0,0:10:23.78,0:10:26.70,Default,,0,0,0,,Мен сені бұрын сынап көрдім.
Dialogue: 0,0:10:26.83,0:10:31.75,Default,,0,0,0,,Норомаға қақпанды тексеруге мүмкіндік берді.
Dialogue: 0,0:10:31.88,0:10:36.13,Default,,0,0,0,,Морт - шіркін емес, ол - сикофан.
Dialogue: 0,0:10:36.26,0:10:40.34,Default,,0,0,0,,Мен сіздің мақсатыңыз не екенін білмеймін.
Dialogue: 0,0:10:40.47,0:10:43.64,Default,,0,0,0,,Маған баратын болсаң, күндіз...
Dialogue: 0,0:10:43.76,0:10:47.18,Default,,0,0,0,,Тағдыр күтпейді
Dialogue: 0,0:10:47.68,0:10:49.94,Default,,0,0,0,,Біз ұқсаспыз, бірақ
Dialogue: 0,0:10:50.06,0:10:53.11,Default,,0,0,0,,Бұл жарық пен қараңғылық.
Dialogue: 0,0:10:53.23,0:10:55.19,Default,,0,0,0,,Мен жарық болсам ше?
Dialogue: 0,0:10:55.32,0:10:59.15,Default,,0,0,0,,Керісінше, оның мока түсі мен әдемі жолақтары бар.
Dialogue: 0,0:10:59.28,0:11:01.66,Default,,0,0,0,,Мен оны тыңдай бердім.
Dialogue: 0,0:11:01.99,0:11:04.99,Default,,0,0,0,,Лемур патшасы – данышпан.
Dialogue: 0,0:11:08.37,0:11:12.58,Default,,0,0,0,,Аңыз бойынша ол Фоссадан да ақылды.
Dialogue: 0,0:11:13.04,0:11:19.05,Default,,0,0,0,,Таудай үлкен болады дейді.
Dialogue: 0,0:11:19.17,0:11:24.89,Default,,0,0,0,,Аузыңнан отты дем ал, көзіңнен мұз жебелерін ат.
Dialogue: 0,0:11:27.52,0:11:29.18,Default,,0,0,0,,Мен онымен кездескім келеді
Dialogue: 0,0:11:29.85,0:11:32.52,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:11:32.65,0:11:33.65,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:11:33.85,0:11:37.23,Default,,0,0,0,,Иә, сені сынаған мен болдым.
Dialogue: 0,0:11:37.36,0:11:38.98,Default,,0,0,0,,Бұл тым қауіпті! Біз Сантананы өлтіруіміз керек.
Dialogue: 0,0:11:39.61,0:11:40.95,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:41.99,0:11:46.03,Default,,0,0,0,,Күтілгендей, сізде әзіл-оспақ бар.
Dialogue: 0,0:11:46.16,0:11:48.87,Default,,0,0,0,,Сен менің қарсыласым бола аласың
Dialogue: 0,0:11:48.99,0:11:53.08,Default,,0,0,0,,Бірақ Мадагаскарға бір ғана данышпан керек.
Dialogue: 0,0:11:53.21,0:11:55.46,Default,,0,0,0,,Сіз жеңілдіңіз.
Dialogue: 0,0:11:55.58,0:11:59.13,Default,,0,0,0,,Қауіптер маған әсер етпейді.
Dialogue: 0,0:11:59.26,0:12:01.55,Default,,0,0,0,,Бұл мені қорқытатын жігіт, солай ма?
Dialogue: 0,0:12:01.67,0:12:06.64,Default,,0,0,0,,Мен ашуланғанша жоғалып кетпесең, көзіңнен оқ атармын...
Dialogue: 0,0:12:06.76,0:12:08.10,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:12:08.51,0:12:12.94,Default,,0,0,0,,Кейінірек орындағыңыз келетін нәрсені сақтаңыз.
Dialogue: 0,0:12:13.44,0:12:16.61,Default,,0,0,0,,Енді жақсылап демалыңыз
Dialogue: 0,0:12:26.03,0:12:28.99,Default,,0,0,0,,Маған біреу көмектессін!
Dialogue: 0,0:12:30.83,0:12:33.75,Default,,0,0,0,,Оның мақсаты қандай?
Dialogue: 0,0:12:33.87,0:12:36.21,Default,,0,0,0,,Аузыңыздан от жұту...
Dialogue: 0,0:12:36.33,0:12:39.21,Default,,0,0,0,,Менің ұлылығымды жақсы білген.
Dialogue: 0,0:12:39.34,0:12:40.05,Default,,0,0,0,,Ум...
Dialogue: 0,0:12:40.46,0:12:44.05,Default,,0,0,0,,Қауіп кеткенше дәретхананы жалғыз қалдырыңыз
Dialogue: 0,0:12:44.18,0:12:47.26,Default,,0,0,0,,Дәретханаға емес, Карлға еріңіз
Dialogue: 0,0:12:47.39,0:12:49.14,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:12:49.26,0:12:53.14,Default,,0,0,0,,Қауіпті адамдарды өзімнен аулақ ұстау...
Dialogue: 0,0:12:53.31,0:12:55.31,Default,,0,0,0,,Бұл сіздің жұмысыңыз болуы керек.
Dialogue: 0,0:12:55.44,0:12:57.27,Default,,0,0,0,,Жаттығу мінсіз
Dialogue: 0,0:12:59.65,0:13:02.99,Default,,0,0,0,,Сіз тек тісіңізбен 45 жолмен өлтіре аласыз.
Dialogue: 0,0:13:03.11,0:13:04.86,Default,,0,0,0,,45 жол?
Dialogue: 0,0:13:04.99,0:13:08.74,Default,,0,0,0,,Осы уақытқа дейін оны менен жасырып келдің.
Dialogue: 0,0:13:09.16,0:13:10.83,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:10.95,0:13:15.37,Default,,0,0,0,,Бұйраларды тістеріңізбен қатайтыңыз
Dialogue: 0,0:13:32.81,0:13:37.94,Default,,0,0,0,,Патша келмей, көмекшілерін жіберсе ше?
Dialogue: 0,0:13:38.06,0:13:40.36,Default,,0,0,0,,Жарайсың Чонси
Dialogue: 0,0:13:40.48,0:13:43.53,Default,,0,0,0,,Сыйлық ретінде тамақ қалдықтарын беріңіз
Dialogue: 0,0:13:43.65,0:13:47.82,Default,,0,0,0,,Кловер туралы көбірек айтып беріңізші.
Dialogue: 0,0:13:48.49,0:13:50.53,Default,,0,0,0,,Шынымен бе? Күн сайын таңертең?
Dialogue: 0,0:13:50.66,0:13:53.49,Default,,0,0,0,,Ол өте қызық әйел.
Dialogue: 0,0:13:58.17,0:13:59.50,Default,,0,0,0,,«Қиын екен.»
Dialogue: 0,0:13:59.63,0:14:05.26,Default,,0,0,0,,Мына беде саған жасырын жақындап келеді...
Dialogue: 0,0:14:05.38,0:14:06.38,Default,,0,0,0,,Сәлем Кловер
Dialogue: 0,0:14:06.51,0:14:09.05,Default,,0,0,0,,Неліктен менің атым?
Dialogue: 0,0:14:09.18,0:14:11.51,Default,,0,0,0,,Мен сізді жақсы білемін.
Dialogue: 0,0:14:11.64,0:14:15.89,Default,,0,0,0,,Сіз жалғыз тұрып, роман жазасыз, солай ма?
Dialogue: 0,0:14:16.02,0:14:19.81,Default,,0,0,0,,Басты кейіпкер - лемур жауынгері Тайсандер
Dialogue: 0,0:14:19.94,0:14:21.86,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,0:14:23.02,0:14:25.48,Default,,0,0,0,,Мен кереметмін
Dialogue: 0,0:14:30.66,0:14:33.70,Default,,0,0,0,,Ол тісімен күресуге шебер сияқты.
Dialogue: 0,0:14:33.83,0:14:37.25,Default,,0,0,0,,Бұл тістер өте күшті көрінеді.
Dialogue: 0,0:14:46.71,0:14:49.68,Default,,0,0,0,,Менің жарақаттау ниетім жоқ.
Dialogue: 0,0:14:49.80,0:14:51.59,Default,,0,0,0,,Кейінірек үшін сақтау
Dialogue: 0,0:14:51.76,0:14:54.51,Default,,0,0,0,,Көбірек көңілді басталады
Dialogue: 0,0:14:57.35,0:14:58.23,Default,,0,0,0,,Міне, біз тағы да келдік
Dialogue: 0,0:14:58.93,0:15:00.73,Default,,0,0,0,,Неге қайта келдің?
Dialogue: 0,0:15:00.85,0:15:04.36,Default,,0,0,0,,Мен сіздің сынақтан өттім.
Dialogue: 0,0:15:04.48,0:15:06.82,Default,,0,0,0,,Беде ұстады
Dialogue: 0,0:15:07.36,0:15:11.57,Default,,0,0,0,,Қай беде? Толық айтып беріңізші
Dialogue: 0,0:15:13.07,0:15:16.45,Default,,0,0,0,,Уайымдамаңыз, мен ештеңе істеп жатқан жоқпын.
Dialogue: 0,0:15:16.58,0:15:19.16,Default,,0,0,0,,Менің саған сыйлығым бар Чонси!
Dialogue: 0,0:15:20.62,0:15:24.96,Default,,0,0,0,,Мен оған бұйрық бермесем, бұл жігіт ештеңе істемейді.
Dialogue: 0,0:15:25.59,0:15:29.38,Default,,0,0,0,,Бұл менің Неджироға картасы бар шақыру.
Dialogue: 0,0:15:29.51,0:15:34.72,Default,,0,0,0,,Әріптер де мен әзірлеген «Карл Бетика» қаріпі.
Dialogue: 0,0:15:34.85,0:15:36.64,Default,,0,0,0,,Бұл бірегей.
Dialogue: 0,0:15:36.76,0:15:41.31,Default,,0,0,0,,Мен сенің үйіңе барғым келеді.
Dialogue: 0,0:15:41.44,0:15:45.27,Default,,0,0,0,,Менің кейбір жынды жігітке баруға уақытым жоқ.
Dialogue: 0,0:15:45.40,0:15:47.82,Default,,0,0,0,,Мәселені шешейік
Dialogue: 0,0:15:47.94,0:15:49.90,Default,,0,0,0,,Тест аяқталды.
Dialogue: 0,0:15:52.24,0:15:53.95,Default,,0,0,0,,Ол қалай жоғалып кетті?
Dialogue: 0,0:15:55.28,0:15:59.04,Default,,0,0,0,,Кловерді жіберуге жауапты
Dialogue: 0,0:15:59.16,0:16:00.33,Default,,0,0,0,,Маған көмек керек
Dialogue: 0,0:16:00.45,0:16:02.62,Default,,0,0,0,,Мен Кловерді бірден қуамын.
Dialogue: 0,0:16:02.75,0:16:09.25,Default,,0,0,0,,Осындай шешім қабылдау арқылы сіз нағыз патша бола аласыз.
Dialogue: 0,0:16:09.38,0:16:11.17,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:11.30,0:16:13.30,Default,,0,0,0,,Мен сәттілік тілеп дұға етемін
Dialogue: 0,0:16:17.35,0:16:18.81,Default,,0,0,0,,Морис тұтқынға алынды
Dialogue: 0,0:16:18.93,0:16:21.77,Default,,0,0,0,,Қазірдің өзінде? Сосын шешіп алайық
Dialogue: 0,0:16:21.89,0:16:24.23,Default,,0,0,0,,Ал, тынышталыңыз.
Dialogue: 0,0:16:24.35,0:16:27.86,Default,,0,0,0,,Сіз маған төсекке қайта барып, тынышталыңыз дейсіз бе?
Dialogue: 0,0:16:27.98,0:16:31.07,Default,,0,0,0,,Анау тарақан да шаңды.
Dialogue: 0,0:16:33.07,0:16:37.74,Default,,0,0,0,,Кловер мен Морис жай ғана бұйрықты орындауда.
Dialogue: 0,0:16:37.87,0:16:41.29,Default,,0,0,0,,Себебі сен мені сүйесің
Dialogue: 0,0:16:41.41,0:16:45.87,Default,,0,0,0,,Сен де мені жақсы көресің, Чонси.
Dialogue: 0,0:16:48.38,0:16:51.84,Default,,0,0,0,,Бұл жиіркенішті. Мұны қоқыс жәшігінде жасаңыз.
Dialogue: 0,0:16:52.17,0:16:55.22,Default,,0,0,0,,Осы екеуін кездестіргіңіз келсе, осында келіңіз.
Dialogue: 0,0:16:57.72,0:16:59.85,Default,,0,0,0,,Иә? сәтсіз аяқталды
Dialogue: 0,0:17:02.35,0:17:07.73,Default,,0,0,0,,Сиқыр немесе бір нәрсе ме? Мен таң қалдым
Dialogue: 0,0:17:09.52,0:17:10.98,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:17:11.11,0:17:13.61,Default,,0,0,0,,Мен осындамын, король
Dialogue: 0,0:17:13.74,0:17:15.65,Default,,0,0,0,,Иә, мен жалғызбын.
Dialogue: 0,0:17:16.45,0:17:22.79,Default,,0,0,0,,Тағдыр мені ұстады, ешқашан жібермейді.
Dialogue: 0,0:17:22.91,0:17:26.58,Default,,0,0,0,,Бірақ тағдыр, сіз сынға түсесіз.
Dialogue: 0,0:17:26.71,0:17:28.25,Default,,0,0,0,,Досыңа көмектес
Dialogue: 0,0:17:28.38,0:17:33.88,Default,,0,0,0,,Патша туралы аңыздың өтірік емес екенін дәлелдеймін.
Dialogue: 0,0:17:34.01,0:17:37.47,Default,,0,0,0,,Негізі бұл өтірік, бірақ жақсы өтірік
Dialogue: 0,0:17:39.09,0:17:41.81,Default,,0,0,0,,Данышпандардың түйісу жолы қатал.
Dialogue: 0,0:17:42.68,0:17:46.14,Default,,0,0,0,,Сәлеметсіңдер ме, тұтқын екеуің.
Dialogue: 0,0:17:47.52,0:17:51.52,Default,,0,0,0,,Менің қарсыласым, ақылды король Джульен,
Dialogue: 0,0:17:51.65,0:17:55.40,Default,,0,0,0,,Біз бір-бірімізбен кездесуге келеміз.
Dialogue: 0,0:17:55.53,0:17:58.24,Default,,0,0,0,,«Зерек Джулиан»?
Dialogue: 0,0:17:58.36,0:18:01.33,Default,,0,0,0,,Сенің де тағдырың шешілді.
Dialogue: 0,0:18:01.45,0:18:05.95,Default,,0,0,0,,Соңын ашқаным үшін кешірім сұраймын, бірақ жеңілген ол.
Dialogue: 0,0:18:06.83,0:18:10.50,Default,,0,0,0,,Карта бойынша біз жақын арада боламыз.
Dialogue: 0,0:18:10.63,0:18:13.42,Default,,0,0,0,,Неге мені байладың?
Dialogue: 0,0:18:13.55,0:18:17.05,Default,,0,0,0,,Карлдың бомбасын анықтау.
Dialogue: 0,0:18:17.17,0:18:20.39,Default,,0,0,0,,Иә! Мен алаяқпын!
Dialogue: 0,0:18:21.55,0:18:23.39,Default,,0,0,0,,Міне, Морт.
Dialogue: 0,0:18:28.77,0:18:31.06,Default,,0,0,0,,Ол әлі жарылды ма?
Dialogue: 0,0:18:31.19,0:18:33.77,Default,,0,0,0,,Сабырлы бол, асықпа.
Dialogue: 0,0:18:39.20,0:18:41.16,Default,,0,0,0,,Король жарылды
Dialogue: 0,0:18:41.28,0:18:46.58,Default,,0,0,0,,Уайымдама, мен оны қайта жинаймын.
Dialogue: 0,0:18:52.08,0:18:54.09,Default,,0,0,0,,Король Джульен қош келдіңіз
Dialogue: 0,0:18:56.38,0:19:00.43,Default,,0,0,0,,Сіз бұл керемет дирижабль деп ойлайсыз, солай ма?
Dialogue: 0,0:19:00.80,0:19:02.30,Default,,0,0,0,,Сізге ұқсайды
Dialogue: 0,0:19:02.43,0:19:06.35,Default,,0,0,0,,Қорқынышты және сәл ессіз
Dialogue: 0,0:19:06.47,0:19:10.23,Default,,0,0,0,,Алтын ғасырдағы дирижабль.
Dialogue: 0,0:19:10.35,0:19:13.52,Default,,0,0,0,,Күндердің күнінде осымен көкте ұшамын
Dialogue: 0,0:19:13.65,0:19:18.32,Default,,0,0,0,,Ұсқынсыз жануарларға мен қараймын
Dialogue: 0,0:19:18.44,0:19:21.53,Default,,0,0,0,,Жарты жолға дейін тыңдамадым.
Dialogue: 0,0:19:21.66,0:19:23.49,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:19:23.62,0:19:26.08,Default,,0,0,0,,Осы уақыттан ләззат алыңыз
Dialogue: 0,0:19:26.37,0:19:29.71,Default,,0,0,0,,Карл, маған досымды қайтар.
Dialogue: 0,0:19:31.58,0:19:33.79,Default,,0,0,0,,Осы сәттен ләззат алыңыз
Dialogue: 0,0:19:34.33,0:19:35.29,Default,,0,0,0,,Қашанға дейін...
Dialogue: 0,0:19:35.84,0:19:36.67,Default,,0,0,0,,Ләззат алыңыз
Dialogue: 0,0:19:37.30,0:19:38.34,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:19:38.88,0:19:40.72,Default,,0,0,0,,Тек ләззат алыңыз.
Dialogue: 0,0:19:43.22,0:19:46.14,Default,,0,0,0,,Ұнату Бұл ең жақсы уақыт
Dialogue: 0,0:19:46.26,0:19:50.14,Default,,0,0,0,,Енді не істейміз, Карл?
Dialogue: 0,0:19:50.48,0:19:52.81,Default,,0,0,0,,Сіз күреспен айналыспайсыз ба?
Dialogue: 0,0:19:52.94,0:19:54.73,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:19:54.86,0:20:00.36,Default,,0,0,0,,Мақсатыңыз мені жалықтыру болса, сіз жетістікке жеттіңіз.
Dialogue: 0,0:20:00.49,0:20:06.41,Default,,0,0,0,,Цивиттер арасында да мен кішкентаймын, мазақ қылатынмын.
Dialogue: 0,0:20:06.53,0:20:11.25,Default,,0,0,0,,Тіпті менің ата-анам үлкен ағам Брюсті жақсы көретін.
Dialogue: 0,0:20:11.41,0:20:13.29,Default,,0,0,0,,Мына блюзге қараңыз
Dialogue: 0,0:20:13.42,0:20:17.25,Default,,0,0,0,,Кофе дәндерін жеу және нәжіс шығару.
Dialogue: 0,0:20:17.42,0:20:19.38,Default,,0,0,0,,Тек қымбат кофе дайындаңыз
Dialogue: 0,0:20:20.51,0:20:26.26,Default,,0,0,0,,Тәжік кофе жасау менің жұмысым ба?
Dialogue: 0,0:20:26.39,0:20:33.35,Default,,0,0,0,,Мен Мадагаскардың ең жақсы королі болғым келеді.
Dialogue: 0,0:20:33.48,0:20:36.40,Default,,0,0,0,,Мен сені сол үшін ұрамын.
Dialogue: 0,0:20:37.44,0:20:38.52,Default,,0,0,0,,Джулиан?
Dialogue: 0,0:20:39.27,0:20:42.40,Default,,0,0,0,,Джулиан!
Dialogue: 0,0:20:43.61,0:20:44.78,Default,,0,0,0,,Мен берілмеймін
Dialogue: 0,0:20:44.91,0:20:46.74,Default,,0,0,0,,Патша көмекке келеді.
Dialogue: 0,0:20:46.87,0:20:51.79,Default,,0,0,0,,Кинг Карлды жеңе алмайды деп ойлаймын.
Dialogue: 0,0:20:51.91,0:20:56.88,Default,,0,0,0,,Енді мені біреу мазақ қылған жоқ па?
Dialogue: 0,0:20:57.00,0:20:58.59,Default,,0,0,0,,Король Джулиен?
Dialogue: 0,0:20:58.71,0:20:59.59,Default,,0,0,0,,Карл ше?
Dialogue: 0,0:20:59.71,0:21:02.46,Default,,0,0,0,,Ол бірдеңеге шағымданады.
Dialogue: 0,0:21:02.63,0:21:05.80,Default,,0,0,0,,Мен өзімшіл адамдарды ұнатпаймын.
Dialogue: 0,0:21:05.93,0:21:09.64,Default,,0,0,0,,Сен мені шақырдың, ал сен мені елемедің.
Dialogue: 0,0:21:09.76,0:21:13.48,Default,,0,0,0,,Жеткілікті демалғаннан кейін үйге қайтайық.
Dialogue: 0,0:21:15.77,0:21:18.48,Default,,0,0,0,,Бәрі менің қолымда.
Dialogue: 0,0:21:19.02,0:21:20.32,Default,,0,0,0,,Король?
Dialogue: 0,0:21:21.82,0:21:24.95,Default,,0,0,0,,Бөлшектерге бөлінген
Dialogue: 0,0:21:26.41,0:21:27.61,Default,,0,0,0,,Мойын!
Dialogue: 0,0:21:28.53,0:21:30.62,Default,,0,0,0,,Кешіріңіз патша
Dialogue: 0,0:21:30.74,0:21:33.95,Default,,0,0,0,,Мен сіздің денеңіздің қалған бөлігін міндетті түрде табамын.
Dialogue: 0,0:21:34.08,0:21:38.96,Default,,0,0,0,,Патшаның денесі шіріп кетсе де, мен оны жібермеймін.
Dialogue: 0,0:21:39.08,0:21:40.00,Default,,0,0,0,,Морт
Dialogue: 0,0:21:40.50,0:21:43.42,Default,,0,0,0,,Мені бұл жерден алып кетіңіз.
Dialogue: 0,0:21:43.55,0:21:47.34,Default,,0,0,0,,Мойын сөйледі! Бұл керемет
Dialogue: 0,0:21:48.26,0:21:50.35,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,0:21:51.64,0:21:54.10,Default,,0,0,0,,Мен таң қалдым, король.
Dialogue: 0,0:21:54.22,0:21:58.85,Default,,0,0,0,,Жеке өміріңіз туралы айту жақсы қадам.
Dialogue: 0,0:21:58.98,0:22:03.15,Default,,0,0,0,,Сіз бұл туралы рұқсатсыз айтқан шығарсыз. Менің уақытым бар, сондықтан мен үйге барамын.
Dialogue: 0,0:22:03.28,0:22:05.94,Default,,0,0,0,,Айтылмай орындалу
Dialogue: 0,0:22:06.07,0:22:08.78,Default,,0,0,0,,Бұл үнсіз әрекет пе?
Dialogue: 0,0:22:08.91,0:22:13.37,Default,,0,0,0,,Соңғы кеңесіңізді есте сақтаңыз.
Dialogue: 0,0:22:13.49,0:22:15.66,Default,,0,0,0,,Сіз патшаны қорқытқыңыз келе ме?
Dialogue: 0,0:22:18.67,0:22:21.96,Default,,0,0,0,,Мазасыздықты кейінге қалдырыңыз
Dialogue: 0,0:22:22.09,0:22:25.63,Default,,0,0,0,,Бұл сіз туралы болғандықтан, бұл бір нәрсе болуы керек...
Dialogue: 0,0:22:32.76,0:22:33.89,Default,,0,0,0,,«Мені таң қалдыр»
Dialogue: 0,0:22:34.10,0:22:35.56,Default,,0,0,0,,Тілек орындалды
Dialogue: 0,0:22:36.35,0:22:40.40,Default,,0,0,0,,Рақмет сізге Фрэнк! Барлығы таң қалды
Dialogue: 0,0:23:06.17,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Акико Комори
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
