Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.54,0:00:09.92,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.38,0:00:15.22,Default,,0,0,0,,Кеш!
Dialogue: 0,0:00:15.34,0:00:16.97,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:17.10,0:00:18.56,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:20.43,0:00:23.64,Default,,0,0,0,,Сіз кіммен бірге отырасыз? Король Джулиен!
Dialogue: 0,0:00:23.77,0:00:25.19,Default,,0,0,0,,Патша кім? Король Джулиен!
Dialogue: 0,0:00:25.31,0:00:27.31,Default,,0,0,0,,Түн ешқашан бітпейді
Dialogue: 0,0:00:27.44,0:00:29.15,Default,,0,0,0,,Бұл Джулиан стилі
Dialogue: 0,0:00:34.24,0:00:35.91,Default,,0,0,0,,Патша кім?
Dialogue: 0,0:00:38.03,0:00:39.95,Default,,0,0,0,,Банзай! патша Джулиан
Dialogue: 0,0:00:42.58,0:00:43.58,Default,,0,0,0,,Патша
Dialogue: 0,0:00:45.37,0:00:47.38,Default,,0,0,0,,Маңызды хабарландыру
Dialogue: 0,0:00:47.75,0:00:49.13,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:00:49.42,0:00:50.59,Default,,0,0,0,,О
Dialogue: 0,0:00:50.71,0:00:52.67,Default,,0,0,0,,Торттың уақыты келді.
Dialogue: 0,0:00:52.80,0:00:54.38,Default,,0,0,0,,Ал...
Dialogue: 0,0:00:54.51,0:00:56.26,Default,,0,0,0,,Мен осы сәтті күттім
Dialogue: 0,0:00:56.38,0:00:58.72,Default,,0,0,0,,Ол тіпті ән жазды.
Dialogue: 0,0:00:58.85,0:01:00.60,Default,,0,0,0,,«Торт уақыты рок»
Dialogue: 0,0:01:00.72,0:01:01.93,Default,,0,0,0,,ＤＪ！
Dialogue: 0,0:01:02.06,0:01:06.44,Default,,0,0,0,,DJ Киракира Джилли осында.
Dialogue: 0,0:01:06.56,0:01:09.61,Default,,0,0,0,,Күлкілі соққы берейік
Dialogue: 0,0:01:10.65,0:01:14.53,Default,,0,0,0,,«КДж сағат нешеде?» деп сұрайды адамдар.
Dialogue: 0,0:01:14.65,0:01:16.53,Default,,0,0,0,,сағат нешеде?
Dialogue: 0,0:01:16.95,0:01:18.66,Default,,0,0,0,,Торт уақыты келді
Dialogue: 0,0:01:18.78,0:01:20.70,Default,,0,0,0,,Құлыптау уақыты
Dialogue: 0,0:01:20.83,0:01:22.91,Default,,0,0,0,,Қант шокын алайық
Dialogue: 0,0:01:23.04,0:01:24.62,Default,,0,0,0,,Шок! шок!
Dialogue: 0,0:01:24.79,0:01:26.62,Default,,0,0,0,,Торт уақыты
Dialogue: 0,0:01:26.79,0:01:28.96,Default,,0,0,0,,Аяқ киім мен шұлықты ауыстырыңыз
Dialogue: 0,0:01:29.08,0:01:30.67,Default,,0,0,0,,Шұлықтар! шұлық!
Dialogue: 0,0:01:30.88,0:01:32.63,Default,,0,0,0,,Тек бір жағы
Dialogue: 0,0:01:32.75,0:01:34.80,Default,,0,0,0,,Иә, бір ғана.
Dialogue: 0,0:01:34.92,0:01:36.59,Default,,0,0,0,,Себебі мен сені жақсы көремін
Dialogue: 0,0:01:36.72,0:01:38.68,Default,,0,0,0,,Торт уақыты
Dialogue: 0,0:01:40.18,0:01:42.60,Default,,0,0,0,,Бұл осы аптадағы үшінші торт әні.
Dialogue: 0,0:01:42.72,0:01:45.48,Default,,0,0,0,,Менің атым «Пісіру»
Dialogue: 0,0:01:45.60,0:01:48.02,Default,,0,0,0,,Себебі мен тортты жақсы көремін!
Dialogue: 0,0:01:48.60,0:01:50.27,Default,,0,0,0,,Сіз білесіз бе? Торт уақыты
Dialogue: 0,0:01:50.52,0:01:53.15,Default,,0,0,0,,Шамдарды сөндірейік
Dialogue: 0,0:01:53.27,0:01:54.28,Default,,0,0,0,,Оны өшірейік!
Dialogue: 0,0:01:54.40,0:01:56.74,Default,,0,0,0,,Өйткені біз
Dialogue: 0,0:01:56.86,0:01:58.45,Default,,0,0,0,,үшін торт туралы
Dialogue: 0,0:01:58.57,0:01:59.41,Default,,0,0,0,,Иә.
Dialogue: 0,0:01:59.53,0:02:00.74,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:02:00.87,0:02:03.58,Default,,0,0,0,,Қазір торт уақыты емес
Dialogue: 0,0:02:03.70,0:02:07.62,Default,,0,0,0,,Тарих патшаларымен таныстыру
Dialogue: 0,0:02:07.75,0:02:09.67,Default,,0,0,0,,Патшалар қайда?
Dialogue: 0,0:02:09.79,0:02:11.67,Default,,0,0,0,,Бөксесі таза ма?
Dialogue: 0,0:02:12.34,0:02:14.38,Default,,0,0,0,,Патша осында.
Dialogue: 0,0:02:14.84,0:02:17.09,Default,,0,0,0,,Патша шежіресі
Dialogue: 0,0:02:17.22,0:02:19.59,Default,,0,0,0,,«Тайсандер Пландерхорс...»
Dialogue: 0,0:02:21.30,0:02:23.39,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:24.22,0:02:25.89,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:02:26.02,0:02:30.23,Default,,0,0,0,,Бұл Джулиен патшаның өмірбаяны.
Dialogue: 0,0:02:30.60,0:02:32.15,Default,,0,0,0,,Патшалар шежіресі!
Dialogue: 0,0:02:32.94,0:02:36.99,Default,,0,0,0,,Міне, мен не үшін істеп жатырмын
Dialogue: 0,0:02:37.11,0:02:39.20,Default,,0,0,0,,Сіз неге агрессивтісіз?
Dialogue: 0,0:02:39.32,0:02:41.20,Default,,0,0,0,,Роман жоқ…
Dialogue: 0,0:02:42.66,0:02:44.12,Default,,0,0,0,,Айтпа
Dialogue: 0,0:02:44.53,0:02:49.21,Default,,0,0,0,,Мен бұл кітапқа дейін ештеңе емеспін
Dialogue: 0,0:02:51.71,0:02:52.92,Default,,0,0,0,,Құнсыз
Dialogue: 0,0:02:53.29,0:02:56.17,Default,,0,0,0,,Жетеді ме?
Dialogue: 0,0:02:56.67,0:03:00.51,Default,,0,0,0,,Бұл кітапта барлық патшалардың өмірі қамтылған.
Dialogue: 0,0:03:00.63,0:03:04.01,Default,,0,0,0,,Патшаның жетістіктерін зерттеңіз
Dialogue: 0,0:03:04.14,0:03:07.18,Default,,0,0,0,,Олардың сөздері де
Dialogue: 0,0:03:07.31,0:03:10.56,Default,,0,0,0,,Ұлы істердегі шытырман патшаның сөзі?
Dialogue: 0,0:03:10.69,0:03:15.32,Default,,0,0,0,,Жазылғанын неге айтпадың?
Dialogue: 0,0:03:15.44,0:03:18.07,Default,,0,0,0,,Сен солай айттың ба?
Dialogue: 0,0:03:18.19,0:03:22.74,Default,,0,0,0,,Патшалардың әңгімелерін оқып көрейік.
Dialogue: 0,0:03:22.86,0:03:25.78,Default,,0,0,0,,Менің миым шықты
Dialogue: 0,0:03:26.58,0:03:30.16,Default,,0,0,0,,Бірінші болып король Джулиен I.
Dialogue: 0,0:03:30.29,0:03:34.42,Default,,0,0,0,,«Әлемдегі барлық адамдарға бақыт әкелген адам...»
Dialogue: 0,0:03:34.54,0:03:38.76,Default,,0,0,0,,«Бұл патшаның әдемі жертөлесі болатын».
Dialogue: 0,0:03:38.88,0:03:42.34,Default,,0,0,0,,Мен бұл нені білдіретінін білмеймін, бірақ мына бөксеге қараңыз.
Dialogue: 0,0:03:42.47,0:03:45.76,Default,,0,0,0,,Керемет! Ата-бабам күткендей
Dialogue: 0,0:03:45.93,0:03:48.26,Default,,0,0,0,,Король Джулиен II.
Dialogue: 0,0:03:48.39,0:03:52.27,Default,,0,0,0,,«Осы дана патшаның ең үлкен жетістігі...»
Dialogue: 0,0:03:52.39,0:03:56.15,Default,,0,0,0,,«Сиырға үйлену»
Dialogue: 0,0:03:56.27,0:03:58.94,Default,,0,0,0,,«Ал күнәкар ма?»
Dialogue: 0,0:03:59.07,0:04:02.45,Default,,0,0,0,,«Рәсімнен кейін стейк ұсынылды».
Dialogue: 0,0:04:03.61,0:04:07.62,Default,,0,0,0,,Мына патша өз әйелін жеді ме?
Dialogue: 0,0:04:09.20,0:04:11.29,Default,,0,0,0,,Жынды болған жақсы.
Dialogue: 0,0:04:11.45,0:04:13.33,Default,,0,0,0,,12-ші сөздер
Dialogue: 0,0:04:13.46,0:04:18.80,Default,,0,0,0,,«Лемурдың қайғылы өлімі алтынмен бірдей».
Dialogue: 0,0:04:18.92,0:04:21.21,Default,,0,0,0,,«Ваха вахахаха»
Dialogue: 0,0:04:21.67,0:04:22.76,Default,,0,0,0,,Қызықты
Dialogue: 0,0:04:22.88,0:04:25.84,Default,,0,0,0,,Қарттың күлгеніне ұқсас
Dialogue: 0,0:04:25.97,0:04:27.47,Default,,0,0,0,,Бұл менің ағам.
Dialogue: 0,0:04:27.60,0:04:30.18,Default,,0,0,0,,Бұл күлкі болды.
Dialogue: 0,0:04:30.31,0:04:31.22,Default,,0,0,0,,Міне
Dialogue: 0,0:04:34.31,0:04:36.77,Default,,0,0,0,,үшін кішкентай болды
Dialogue: 0,0:04:36.90,0:04:40.11,Default,,0,0,0,,Ол көңілді емес, ол ақымақ.
Dialogue: 0,0:04:43.36,0:04:46.99,Default,,0,0,0,,Не? Осы жерден бастап бәрі ақ
Dialogue: 0,0:04:47.12,0:04:52.87,Default,,0,0,0,,Ол бос. Патша тегі бұзылды!
Dialogue: 0,0:04:53.33,0:04:54.21,Default,,0,0,0,,Болашақ жоқ
Dialogue: 0,0:04:54.33,0:04:57.96,Default,,0,0,0,,Жоқ, оны Кинг жазды.
Dialogue: 0,0:04:58.08,0:05:01.34,Default,,0,0,0,,«Король Джулиан XIII» қараңыз
Dialogue: 0,0:05:01.46,0:05:03.42,Default,,0,0,0,,Бұл сіздің парақшаңыз
Dialogue: 0,0:05:03.55,0:05:06.34,Default,,0,0,0,,Тиісті жайлылық...
Dialogue: 0,0:05:06.47,0:05:09.51,Default,,0,0,0,,Күте тұрыңыз, бұл менің парақшам ба?
Dialogue: 0,0:05:12.02,0:05:13.85,Default,,0,0,0,,Мен күткеннен де жұмсақ
Dialogue: 0,0:05:15.39,0:05:19.19,Default,,0,0,0,,Мен күні бойы бұйра ұйықтай аламын.
Dialogue: 0,0:05:19.31,0:05:21.86,Default,,0,0,0,,Жоқ, менің бір ісім бар.
Dialogue: 0,0:05:21.98,0:05:26.28,Default,,0,0,0,,Бұл бетті мен толтыруым керек.
Dialogue: 0,0:05:26.61,0:05:31.58,Default,,0,0,0,,Мен өз оқиғамды жазамын
Dialogue: 0,0:05:31.70,0:05:35.41,Default,,0,0,0,,«Замандардың ең жақсысы және ең нашар уақыт»
Dialogue: 0,0:05:39.04,0:05:41.00,Default,,0,0,0,,Маған қаріп өлшемі ұнамайды.
Dialogue: 0,0:05:41.46,0:05:43.25,Default,,0,0,0,,Амелия, бұған ше?
Dialogue: 0,0:05:43.38,0:05:47.18,Default,,0,0,0,,«Ең алдымен...» Жоқ, бұл жұмыс істемейді.
Dialogue: 0,0:05:50.68,0:05:53.56,Default,,0,0,0,,«Мен кішкентай кезімде...»
Dialogue: 0,0:05:53.89,0:05:55.73,Default,,0,0,0,,Бірдеңе дұрыс емес пе? амелия
Dialogue: 0,0:05:58.81,0:06:00.06,Default,,0,0,0,,У.А. орта мектебі, 1-курс А және Б сыныптары—
Dialogue: 0,0:06:00.44,0:06:02.98,Default,,0,0,0,,Жарайды, мен жазамын.
Dialogue: 0,0:06:20.25,0:06:21.46,Default,,0,0,0,,Сіз оны жаза алдыңыз ба?
Dialogue: 0,0:06:21.58,0:06:24.55,Default,,0,0,0,,Савагуна беде
Dialogue: 0,0:06:24.80,0:06:27.92,Default,,0,0,0,,Жоқ, шабыт кетті.
Dialogue: 0,0:06:28.05,0:06:30.18,Default,,0,0,0,,Мына пудинг неге ұқсайды?
Dialogue: 0,0:06:30.30,0:06:32.93,Default,,0,0,0,,Маған жазу үшін керек.
Dialogue: 0,0:06:33.05,0:06:35.10,Default,,0,0,0,,Бұл жазушылар үшін қарапайым түсінік.
Dialogue: 0,0:06:35.22,0:06:37.81,Default,,0,0,0,,Негізі мен де жазушымын...
Dialogue: 0,0:06:37.93,0:06:39.56,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:06:39.69,0:06:42.90,Default,,0,0,0,,Бұғатталған болса жазбаңыз.
Dialogue: 0,0:06:43.02,0:06:47.19,Default,,0,0,0,,Қайтадан бастасаң, сөздер саған келеді.
Dialogue: 0,0:06:47.32,0:06:50.07,Default,,0,0,0,,Алдымен ұйықтап ал
Dialogue: 0,0:06:51.24,0:06:54.20,Default,,0,0,0,,Таза ақ және таза бет
Dialogue: 0,0:06:55.79,0:06:57.83,Default,,0,0,0,,Осы жерге жаза алсам...
Dialogue: 0,0:06:57.95,0:07:00.25,Default,,0,0,0,,Кішкене ғана.
Dialogue: 0,0:07:06.21,0:07:10.84,Default,,0,0,0,,Патшаға бәрібір. Қош бол пудинг.
Dialogue: 0,0:07:13.64,0:07:16.64,Default,,0,0,0,,Жақсы көрінеді, мүмкін данышпан
Dialogue: 0,0:07:18.14,0:07:19.93,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:07:22.02,0:07:25.90,Default,,0,0,0,,Мен бүгін бір ғажайып нәрсе жазуым керек...
Dialogue: 0,0:07:26.02,0:07:28.07,Default,,0,0,0,,Бұл не? Морис!
Dialogue: 0,0:07:28.19,0:07:29.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:29.19,0:07:30.86,Default,,0,0,0,,Кітаптағы хаттар!
Dialogue: 0,0:07:30.99,0:07:34.16,Default,,0,0,0,,Менің кітабымда жазылған сөздер бар
Dialogue: 0,0:07:34.28,0:07:35.37,Default,,0,0,0,,Өте рахмет. Енді барамын.
Dialogue: 0,0:07:35.58,0:07:38.74,Default,,0,0,0,,Мәселе неде?
Dialogue: 0,0:07:38.87,0:07:41.00,Default,,0,0,0,,Мен оны жазған жоқпын.
Dialogue: 0,0:07:41.12,0:07:44.00,Default,,0,0,0,,Бірақ онда жазылған әріптер бар
Dialogue: 0,0:07:44.13,0:07:47.09,Default,,0,0,0,,Және олар бір-бірінің қасында
Dialogue: 0,0:07:47.21,0:07:49.59,Default,,0,0,0,,Бұл «жазу» деп аталады
Dialogue: 0,0:07:49.71,0:07:52.34,Default,,0,0,0,,«Мәтін»? Бұл жақсы дыбыс
Dialogue: 0,0:07:52.47,0:07:55.72,Default,,0,0,0,,Сонда бұл сөйлем не дейді?
Dialogue: 0,0:07:55.85,0:07:59.43,Default,,0,0,0,,«Король Юлиан XIII туралы даңқты жазба»
Dialogue: 0,0:07:59.56,0:08:04.23,Default,,0,0,0,,«Ол батыл оқиғалар мен батыл істердің патшасы».
Dialogue: 0,0:08:04.81,0:08:06.69,Default,,0,0,0,,«Ерлік» екі рет
Dialogue: 0,0:08:06.81,0:08:09.78,Default,,0,0,0,,«Осы дүниеде 13-ші пайда болған кезде...»
Dialogue: 0,0:08:09.90,0:08:12.90,Default,,0,0,0,,«Менің бұлшық еттерім өте бұлшықет»
Dialogue: 0,0:08:13.03,0:08:17.28,Default,,0,0,0,,«Оның денесі маймен жарқырап, бір мүйізді мүйізге мініп кетті».
Dialogue: 0,0:08:17.62,0:08:20.16,Default,,0,0,0,,Бір мүйізділердің бұлшық еттері бар ма?
Dialogue: 0,0:08:20.29,0:08:22.37,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:08:22.54,0:08:26.17,Default,,0,0,0,,Бұл мен ғана. Тағы не?
Dialogue: 0,0:08:26.29,0:08:29.38,Default,,0,0,0,,«Патшаның құлағы өте өткір».
Dialogue: 0,0:08:29.50,0:08:31.59,Default,,0,0,0,,«Мен айқайларды бірден естідім.»
Dialogue: 0,0:08:31.71,0:08:36.89,Default,,0,0,0,,«Адамдардың бөкселері судың сырғыған мұзымен қатып қалғанда».
Dialogue: 0,0:08:37.14,0:08:41.56,Default,,0,0,0,,«Патша күнді жасап, оны аспанға лақтырды».
Dialogue: 0,0:08:41.68,0:08:45.06,Default,,0,0,0,,«Ол халықтың түбін жылытты».
Dialogue: 0,0:08:45.90,0:08:49.40,Default,,0,0,0,,«Түйме қыздырғыш»? Бұл таңқаларлық.
Dialogue: 0,0:08:49.52,0:08:51.57,Default,,0,0,0,,Күнді жаратуға болмайды
Dialogue: 0,0:08:51.69,0:08:56.49,Default,,0,0,0,,Мен білмеймін. Мүмкін мен ұйықтап жатқанда жасадым.
Dialogue: 0,0:08:56.61,0:08:59.20,Default,,0,0,0,,Менің әңгімем әлі де солай
Dialogue: 0,0:08:59.33,0:09:01.12,Default,,0,0,0,,Мұның бәрі өтірік, солай ма?
Dialogue: 0,0:09:01.24,0:09:07.00,Default,,0,0,0,,Жарайды, Морис, мұны Құдай жазған болса ше?
Dialogue: 0,0:09:07.12,0:09:09.38,Default,,0,0,0,,Құдай солай айтып тұрған шығар
Dialogue: 0,0:09:09.50,0:09:13.92,Default,,0,0,0,,«Джулиан, сен үлкен ерлік жасадың».
Dialogue: 0,0:09:14.09,0:09:15.76,Default,,0,0,0,,«Бұл мен бе?»
Dialogue: 0,0:09:15.93,0:09:18.39,Default,,0,0,0,,Құдайдың жауабы: «Иә».
Dialogue: 0,0:09:18.51,0:09:22.35,Default,,0,0,0,,«Бірақ ұйықтап жатқанда не болғанын есіңе түсірмейсің».
Dialogue: 0,0:09:22.64,0:09:25.56,Default,,0,0,0,,«Сондықтан мен оны кітапқа жаздым».
Dialogue: 0,0:09:25.69,0:09:30.77,Default,,0,0,0,,«Ұлы істеріңді халыққа айт».
Dialogue: 0,0:09:30.90,0:09:33.40,Default,,0,0,0,,«Түсіндім» деймін.
Dialogue: 0,0:09:33.53,0:09:35.32,Default,,0,0,0,,«Мен мұны істеймін»
Dialogue: 0,0:09:36.15,0:09:40.58,Default,,0,0,0,,Кингтің өмірбаянын насихаттау - үлкен жұмыс.
Dialogue: 0,0:09:41.16,0:09:45.87,Default,,0,0,0,,Болашақтың құралдарын жасауға ат басын бұрдым.
Dialogue: 0,0:09:46.00,0:09:48.54,Default,,0,0,0,,...
Dialogue: 0,0:09:53.71,0:09:56.13,Default,,0,0,0,,Бұл жазудың рөлі.
Dialogue: 0,0:09:56.26,0:09:59.51,Default,,0,0,0,,Менің істерімді халыққа таныт
Dialogue: 0,0:09:59.64,0:10:03.35,Default,,0,0,0,,Бұл кітаптың атауы шешілді.
Dialogue: 0,0:10:03.47,0:10:08.39,Default,,0,0,0,,«Лемур патшалығының патшасы ~ Жартылай өмір және оның істері»
Dialogue: 0,0:10:08.94,0:10:11.98,Default,,0,0,0,,Күлгенде солай ма? Жаман
Dialogue: 0,0:10:12.11,0:10:13.32,Default,,0,0,0,,Кітапханада жәндіктер ұяласып жатыр ма? Бұл өте қорқынышты.
Dialogue: 0,0:10:13.44,0:10:17.49,Default,,0,0,0,,Толығырақ оқыдыңыз ба? Жақсы жаздыңыз, солай емес пе?
Dialogue: 0,0:10:17.61,0:10:19.53,Default,,0,0,0,,Мен сіздің ойыңызды білгім келеді.
Dialogue: 0,0:10:19.66,0:10:22.66,Default,,0,0,0,,Корольдің шытырман оқиғалары туралы, әрине.
Dialogue: 0,0:10:23.41,0:10:26.33,Default,,0,0,0,,Кел, оқы.
Dialogue: 0,0:10:26.45,0:10:30.04,Default,,0,0,0,,Король Юлиан XIII өмір тарихы.
Dialogue: 0,0:10:30.17,0:10:32.04,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:10:32.17,0:10:34.55,Default,,0,0,0,,үшін оқысын!
Dialogue: 0,0:10:34.67,0:10:36.38,Default,,0,0,0,,Демек, бұл… иллюзия.
Dialogue: 0,0:10:36.51,0:10:38.05,Default,,0,0,0,,“KJ13-ші –”
Dialogue: 0,0:10:38.17,0:10:42.85,Default,,0,0,0,,«Бұлшық етті қолдарыңызбен қолдарыңызды соғыңыз».
Dialogue: 0,0:10:42.97,0:10:45.77,Default,,0,0,0,,«Цунамиді жойды»
Dialogue: 0,0:10:45.89,0:10:48.23,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:10:48.35,0:10:50.44,Default,,0,0,0,,«Көзден лазерлер»
Dialogue: 0,0:10:50.56,0:10:52.56,Default,,0,0,0,,«Екі сиқыршы...»
Dialogue: 0,0:10:52.77,0:10:55.61,Default,,0,0,0,,«Мен оны көзіммен көрдім»
Dialogue: 0,0:10:55.73,0:10:59.90,Default,,0,0,0,,«Содан кейін ол лазер сәулесін түсірді».
Dialogue: 0,0:11:00.03,0:11:04.53,Default,,0,0,0,,«KJ13-тің құпия қаруы - оның сиқырлы бөксесі».
Dialogue: 0,0:11:04.66,0:11:08.29,Default,,0,0,0,,«Зұлым сиқыршы жойылды»
Dialogue: 0,0:11:10.87,0:11:11.71,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:11:11.83,0:11:16.30,Default,,0,0,0,,Маған Құдай жазған шынайы оқиғалар ұнайды.
Dialogue: 0,0:11:16.42,0:11:17.59,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:11:17.71,0:11:19.88,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:11:20.51,0:11:22.30,Default,,0,0,0,,Аня нәжіске батты.
Dialogue: 0,0:11:28.56,0:11:32.52,Default,,0,0,0,,Баршаңызға, бұл жаңа әңгіме.
Dialogue: 0,0:11:32.65,0:11:37.23,Default,,0,0,0,,Бұл «Лемур патшалығының патшасы: оның өмірі мен істерінің» жалғасы
Dialogue: 0,0:11:37.36,0:11:42.86,Default,,0,0,0,,Бұл жолы сиқыршы туралы емес, көрнекі кей патша туралы әңгіме.
Dialogue: 0,0:11:42.99,0:11:45.28,Default,,0,0,0,,...
Dialogue: 0,0:11:45.41,0:11:50.66,Default,,0,0,0,,«Ол қараңғы, жарқыраған көздерімен жауға қарады».
Dialogue: 0,0:11:50.79,0:11:54.08,Default,,0,0,0,,«Жарқыраған және қараңғы визуалды kei KJ»
Dialogue: 0,0:11:54.21,0:11:56.13,Default,,0,0,0,,«көп секірді»
Dialogue: 0,0:11:56.54,0:11:58.55,Default,,0,0,0,,«Қараңғы визуалды соққы!»
Dialogue: 0,0:11:58.67,0:12:02.63,Default,,0,0,0,,«Алып шаяндар - қорқынышты құбыжықтар».
Dialogue: 0,0:12:02.76,0:12:06.05,Default,,0,0,0,,«Тепкі оның тікелей бетіне тиді».
Dialogue: 0,0:12:06.18,0:12:11.81,Default,,0,0,0,,Мына ұсқынсыз құбыжық сәбилерді жейді.
Dialogue: 0,0:12:11.93,0:12:15.31,Default,,0,0,0,,Ал басына жаялық киіп алған.
Dialogue: 0,0:12:15.44,0:12:16.94,Default,,0,0,0,,Қолданылған
Dialogue: 0,0:12:17.06,0:12:22.57,Default,,0,0,0,,Жаялық киген шаян балаларды жейді?
Dialogue: 0,0:12:22.70,0:12:25.78,Default,,0,0,0,,Мен сәбиді бір рет қана жедім.
Dialogue: 0,0:12:25.91,0:12:28.87,Default,,0,0,0,,Бірақ мен тек осы туралы айтамын
Dialogue: 0,0:12:28.99,0:12:30.58,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:12:30.70,0:12:33.41,Default,,0,0,0,,Бұл дүние өтірікке толы
Dialogue: 0,0:12:33.54,0:12:35.96,Default,,0,0,0,,Джулиан, есіңде болсын.
Dialogue: 0,0:12:38.63,0:12:41.05,Default,,0,0,0,,«Кітап клубының» уақыты келді
Dialogue: 0,0:12:41.17,0:12:45.18,Default,,0,0,0,,Мен бірнеше ыстық кітаптарды бұрыннан таныстырдым.
Dialogue: 0,0:12:45.30,0:12:47.97,Default,,0,0,0,,Міне, мен бүгін таныстырғым келеді
Dialogue: 0,0:12:48.14,0:12:54.27,Default,,0,0,0,,«Лемур патшалығының патшасы – оның жарты өмірі мен істері»
Dialogue: 0,0:12:54.39,0:12:59.02,Default,,0,0,0,,Жанкүйерлер өздерінің сүйікті кейіпкерлері туралы екіге бөлінеді
Dialogue: 0,0:12:59.15,0:13:00.98,Default,,0,0,0,,Сиқырлы Батт Кинг фракциясы?
Dialogue: 0,0:13:01.15,0:13:03.28,Default,,0,0,0,,Сиқырлы бөксеге дауыс беріңіз!
Dialogue: 0,0:13:03.40,0:13:06.07,Default,,0,0,0,,Visual Kei King мектебі?
Dialogue: 0,0:13:06.20,0:13:08.62,Default,,0,0,0,,Визуалды Кей Кинг
Dialogue: 0,0:13:08.74,0:13:10.49,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:13:10.62,0:13:15.75,Default,,0,0,0,,Кингке назар аударыңыз, келесіде қандай оқиға шығатынын көріңіз.
Dialogue: 0,0:13:19.00,0:13:20.71,Default,,0,0,0,,Ол әлі де таза ақ па?
Dialogue: 0,0:13:20.84,0:13:23.76,Default,,0,0,0,,Құдай қашан жазады?
Dialogue: 0,0:13:23.88,0:13:25.80,Default,,0,0,0,,Бұрын қалай болды?
Dialogue: 0,0:13:25.93,0:13:29.35,Default,,0,0,0,,Сіз мұны мен ұйықтап жатқанда жаздыңыз.
Dialogue: 0,0:13:29.47,0:13:33.31,Default,,0,0,0,,Жүр, мен ұйықтайын деп жатырмын. Қайырлы түн.
Dialogue: 0,0:13:33.85,0:13:35.02,Default,,0,0,0,,Мен ұйықтап қалдым
Dialogue: 0,0:13:35.85,0:13:37.98,Default,,0,0,0,,Құдай өтінемін
Dialogue: 0,0:13:38.10,0:13:40.69,Default,,0,0,0,,Менің шытырман оқиғаларымды жаз
Dialogue: 0,0:13:40.81,0:13:44.19,Default,,0,0,0,,Егер мен шынымен ұйықтасам, жаза алар едім.
Dialogue: 0,0:13:44.36,0:13:45.24,Default,,0,0,0,,Не?
Dialogue: 0,0:13:45.36,0:13:51.99,Default,,0,0,0,,үшін бөлмеден шықса, Алла жазатын шығар.
Dialogue: 0,0:13:52.12,0:13:54.37,Default,,0,0,0,,Өйткені мен ұялшақпын
Dialogue: 0,0:13:54.50,0:13:55.54,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:55.91,0:13:57.50,Default,,0,0,0,,үшін шығыңыз!
Dialogue: 0,0:13:58.71,0:14:01.71,Default,,0,0,0,,Мен Құдайдың күзетшісімін
Dialogue: 0,0:14:06.09,0:14:07.84,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:14:07.97,0:14:10.26,Default,,0,0,0,,Жақсы жұмыс.
Dialogue: 0,0:14:11.97,0:14:13.47,Default,,0,0,0,,Беде?
Dialogue: 0,0:14:15.98,0:14:19.65,Default,,0,0,0,,Мен әкелерді қорлаған аналарды көргім келмейді.
Dialogue: 0,0:14:21.98,0:14:24.36,Default,,0,0,0,,Морис Кингке
Dialogue: 0,0:14:24.48,0:14:25.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:27.95,0:14:29.15,Default,,0,0,0,,Мен емес
Dialogue: 0,0:14:29.28,0:14:33.37,Default,,0,0,0,,Сонда біздің туу белгілеріміз қандай?
Dialogue: 0,0:14:33.49,0:14:35.37,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз.
Dialogue: 0,0:14:35.49,0:14:38.83,Default,,0,0,0,,Неліктен шежірені жазып жатырсыз?
Dialogue: 0,0:14:38.96,0:14:40.46,Default,,0,0,0,,Түсінбейсің бе?
Dialogue: 0,0:14:40.92,0:14:43.46,Default,,0,0,0,,Беде құдай ма?
Dialogue: 0,0:14:43.59,0:14:44.84,Default,,0,0,0,,Алдау
Dialogue: 0,0:14:44.96,0:14:48.17,Default,,0,0,0,,Беде — беде
Dialogue: 0,0:14:48.30,0:14:51.05,Default,,0,0,0,,Ол жазды.
Dialogue: 0,0:14:55.35,0:15:00.85,Default,,0,0,0,,Сонда бұл миф пе? Мүмкін ұмытып бара жатқан шығармын
Dialogue: 0,0:15:00.98,0:15:03.40,Default,,0,0,0,,Кешіріңіз патша
Dialogue: 0,0:15:03.65,0:15:05.02,Default,,0,0,0,,Тоқтамаңыз
Dialogue: 0,0:15:05.94,0:15:09.36,Default,,0,0,0,,Көпшілікке өтірік айтқаны үшін
Dialogue: 0,0:15:09.49,0:15:11.20,Default,,0,0,0,,үшін сенеді
Dialogue: 0,0:15:11.32,0:15:14.87,Default,,0,0,0,,Бұл әңгіме халықтың жүрегіне тірек.
Dialogue: 0,0:15:14.99,0:15:18.83,Default,,0,0,0,,Мен сізден көбірек сұрауым керек.
Dialogue: 0,0:15:18.95,0:15:22.21,Default,,0,0,0,,Мен де өзімнің шытырман оқиғаларымды білгім келеді.
Dialogue: 0,0:15:22.33,0:15:24.79,Default,,0,0,0,,«Жалғастыру»
Dialogue: 0,0:15:25.29,0:15:28.05,Default,,0,0,0,,«Король Джулиен»
Dialogue: 0,0:15:29.01,0:15:32.13,Default,,0,0,0,,«Менің бөксем сенікі»
Dialogue: 0,0:15:33.47,0:15:35.47,Default,,0,0,0,,«Король Джулиеннің жүрек белгісі...»
Dialogue: 0,0:15:35.60,0:15:36.39,Default,,0,0,0,,Джулиан!
Dialogue: 0,0:15:38.93,0:15:40.81,Default,,0,0,0,,Сіз оны білесіз бе?
Dialogue: 0,0:15:40.94,0:15:43.19,Default,,0,0,0,,Мен қауесетті естідім.
Dialogue: 0,0:15:43.31,0:15:46.23,Default,,0,0,0,,Бұл Фред атты алып шаян.
Dialogue: 0,0:15:46.36,0:15:50.57,Default,,0,0,0,,Әңгімені жазғанда үлгі ретінде пайдаланған болармын.
Dialogue: 0,0:15:50.69,0:15:54.78,Default,,0,0,0,,Сіздің әңгімеңізді оқу менің өмірімді өзгертті.
Dialogue: 0,0:15:54.91,0:15:58.45,Default,,0,0,0,,Сонда да сен мен туралы өтірік айттың ба?
Dialogue: 0,0:15:58.58,0:16:00.00,Default,,0,0,0,,Ал мұнда?
Dialogue: 0,0:16:00.12,0:16:03.46,Default,,0,0,0,,Бұл мен кітаптардан оқығандай патшалық емес.
Dialogue: 0,0:16:03.58,0:16:07.50,Default,,0,0,0,,Сіз визуалды емессіз де, бұлшықетсізсіз.
Dialogue: 0,0:16:07.63,0:16:09.67,Default,,0,0,0,,Мен өзімді сатқындықпен сезінемін
Dialogue: 0,0:16:09.80,0:16:14.97,Default,,0,0,0,,Мен туралы әңгімелердің өтірік екенін барлығына айт.
Dialogue: 0,0:16:15.22,0:16:16.72,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:16:16.85,0:16:19.81,Default,,0,0,0,,Шындықты айтайық
Dialogue: 0,0:16:20.52,0:16:24.10,Default,,0,0,0,,Король KJ13-мен әдепсіз сөйлеспе.
Dialogue: 0,0:16:24.23,0:16:27.52,Default,,0,0,0,,Ол үлкен істер атқарған адам.
Dialogue: 0,0:16:27.65,0:16:30.15,Default,,0,0,0,,Сиқырлы бөкселер ең жақсысы
Dialogue: 0,0:16:30.28,0:16:33.03,Default,,0,0,0,,Тед, оны сол жерде қалдырыңыз.
Dialogue: 0,0:16:33.15,0:16:37.16,Default,,0,0,0,,Тед дұрыс айтады, сен қорқынышты емессің.
Dialogue: 0,0:16:37.28,0:16:40.83,Default,,0,0,0,,Кинг өз көзінен лазер түсіре алады.
Dialogue: 0,0:16:40.95,0:16:42.66,Default,,0,0,0,,Бір мүйізді мінуге болады
Dialogue: 0,0:16:42.79,0:16:43.71,Default,,0,0,0,,Сіз білесіз...
Dialogue: 0,0:16:43.87,0:16:47.25,Default,,0,0,0,,Патша менің кейіпкерім
Dialogue: 0,0:16:51.38,0:16:53.80,Default,,0,0,0,,Бұл Фред пе?
Dialogue: 0,0:16:53.92,0:16:57.80,Default,,0,0,0,,Халық бұл оқиғаны жақсы көреді.
Dialogue: 0,0:16:57.93,0:17:00.85,Default,,0,0,0,,Сондықтан мазмұнды өзгерту мүмкін емес.
Dialogue: 0,0:17:05.10,0:17:06.69,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:17:06.90,0:17:11.86,Default,,0,0,0,,Олай болса, мен саған да өзіңе ұнайтын іспен айналысуға рұқсат етемін.
Dialogue: 0,0:17:12.78,0:17:13.82,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:17:13.94,0:17:15.07,Default,,0,0,0,,Нигеро
Dialogue: 0,0:17:15.20,0:17:15.78,Default,,0,0,0,,Нигасан
Dialogue: 0,0:17:15.78,0:17:16.57,Default,,0,0,0,,Нигасан
Dialogue: 0,0:17:15.78,0:17:16.57,Default,,0,0,0,,«Қоңыр Джульен»
Dialogue: 0,0:17:16.57,0:17:17.36,Default,,0,0,0,,«Қоңыр Джульен»
Dialogue: 0,0:17:17.36,0:17:18.16,Default,,0,0,0,,«Қоңыр Джульен»
Dialogue: 0,0:17:17.36,0:17:18.16,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:17:18.16,0:17:18.57,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:17:21.70,0:17:22.75,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:17:23.08,0:17:26.71,Default,,0,0,0,,Мен кітапты жақсы көргендіктен өлемін!
Dialogue: 0,0:17:32.84,0:17:35.17,Default,,0,0,0,,Мен шешуім керек
Dialogue: 0,0:17:35.30,0:17:36.34,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:17:37.89,0:17:39.30,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:17:39.43,0:17:42.22,Default,,0,0,0,,Сіз мұны істегіңіз келе ме? Алыңыз.
Dialogue: 0,0:17:46.85,0:17:49.06,Default,,0,0,0,,Мұны да жеңіз
Dialogue: 0,0:17:55.61,0:17:57.32,Default,,0,0,0,,Сіз оны көрдіңіз бе? Мен жасадым
Dialogue: 0,0:17:57.70,0:17:58.61,Default,,0,0,0,,Құйрықты шабуыл!
Dialogue: 0,0:18:04.24,0:18:06.83,Default,,0,0,0,,Мен мұны мүлдем істемедім.
Dialogue: 0,0:18:12.04,0:18:13.67,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:13.80,0:18:19.13,Default,,0,0,0,,Әңгімедегі Патша оған қалағанын жасауға рұқсат бермейді.
Dialogue: 0,0:18:19.26,0:18:25.02,Default,,0,0,0,,Күшті патшалар тек әңгімелерде болады.
Dialogue: 0,0:18:25.14,0:18:26.18,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:18:29.14,0:18:31.23,Default,,0,0,0,,Көпшілікті хабардар ету керек
Dialogue: 0,0:18:31.36,0:18:32.02,Default,,0,0,0,,Фред
Dialogue: 0,0:18:32.40,0:18:35.73,Default,,0,0,0,,Тыңда, сен жеңесің.
Dialogue: 0,0:18:35.86,0:18:37.19,Default,,0,0,0,,Мен сізге шындықты айтайын
Dialogue: 0,0:18:37.32,0:18:42.28,Default,,0,0,0,,Сен туралы емес мен туралы бәрі өтірік.
Dialogue: 0,0:18:42.41,0:18:47.41,Default,,0,0,0,,Бұл Кловер ойлап тапқан ойдан шығарылған әңгіме.
Dialogue: 0,0:18:50.67,0:18:54.55,Default,,0,0,0,,Жоқ деп айтыңыз, патша.
Dialogue: 0,0:18:54.67,0:18:56.84,Default,,0,0,0,,Жоқ, Тед, бұл рас.
Dialogue: 0,0:18:56.96,0:18:58.17,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:58.30,0:19:02.39,Default,,0,0,0,,Енді өмір сүрудің мәні жоқ, болашақта тас қараңғы.
Dialogue: 0,0:19:02.51,0:19:03.93,Default,,0,0,0,,Бітті
Dialogue: 0,0:19:04.39,0:19:08.23,Default,,0,0,0,,Мұның бәрі өтірік пе? Одан да жаман
Dialogue: 0,0:19:08.35,0:19:12.90,Default,,0,0,0,,Өмірімді өзгерткен оқиғаның өтірік екені өте өкінішті
Dialogue: 0,0:19:13.02,0:19:14.77,Default,,0,0,0,,Мен жындымын
Dialogue: 0,0:19:16.48,0:19:17.78,Default,,0,0,0,,Мен оларды кешіре алмаймын!
Dialogue: 0,0:19:17.90,0:19:19.95,Default,,0,0,0,,Фред, тыныштал.
Dialogue: 0,0:19:20.07,0:19:23.53,Default,,0,0,0,,Неге сонша ашуланасың? Тынышталыңыз.
Dialogue: 0,0:19:23.99,0:19:27.91,Default,,0,0,0,,Тыныш мінезім менің кінәм. Терең тыныс алыңыз.
Dialogue: 0,0:19:28.95,0:19:31.42,Default,,0,0,0,,１ ２ ３ ４
Dialogue: 0,0:19:31.54,0:19:34.50,Default,,0,0,0,,Жарайды, біраз тынышталды.
Dialogue: 0,0:19:34.63,0:19:36.21,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:19:36.34,0:19:38.71,Default,,0,0,0,,үшінң тыңдаңдар.
Dialogue: 0,0:19:38.84,0:19:41.34,Default,,0,0,0,,Келіңіз де, алдыңызға отырыңыз
Dialogue: 0,0:19:43.51,0:19:47.72,Default,,0,0,0,,Менің әңгімемнің барлығына ұнайтыны...
Dialogue: 0,0:19:47.85,0:19:50.23,Default,,0,0,0,,Бұл басты кейіпкер болғандықтан.
Dialogue: 0,0:19:50.39,0:19:54.35,Default,,0,0,0,,Бұл әңгіме өтірік болса да, бәрібір.
Dialogue: 0,0:19:54.48,0:19:58.19,Default,,0,0,0,,үшінның не сезгені маңызды.
Dialogue: 0,0:19:58.32,0:20:00.78,Default,,0,0,0,,Иә, Кинг дұрыс айтады.
Dialogue: 0,0:20:01.28,0:20:04.87,Default,,0,0,0,,Фредтің тілегін орындайық
Dialogue: 0,0:20:05.16,0:20:08.79,Default,,0,0,0,,«үшін Джулиан XIII патшаны жақсы көреді»
Dialogue: 0,0:20:08.91,0:20:15.38,Default,,0,0,0,,«Мен оянсам, визуалды кейде сиқырлы бөкселер бар екен».
Dialogue: 0,0:20:15.50,0:20:18.88,Default,,0,0,0,,«Менің бөксем ісіп кетті».
Dialogue: 0,0:20:21.26,0:20:27.18,Default,,0,0,0,,«Келесі бір нәрсе, Кинг ғарыш кемесінде зұлым адамдармен қоршалған...»
Dialogue: 0,0:20:27.30,0:20:31.18,Default,,0,0,0,,«Маған лазерлік мылтық бағытталды»
Dialogue: 0,0:20:31.48,0:20:34.48,Default,,0,0,0,,«Бұл жаман, біз өте қиын жағдайдамыз».
Dialogue: 0,0:20:34.73,0:20:38.19,Default,,0,0,0,,«Біреу маған көмектесе алады ма?»
Dialogue: 0,0:20:38.32,0:20:40.11,Default,,0,0,0,,«Бірақ тым кеш»
Dialogue: 0,0:20:40.28,0:20:43.24,Default,,0,0,0,,«Кингке лазерлік мылтық атылды»
Dialogue: 0,0:20:49.95,0:20:53.96,Default,,0,0,0,,«Сол кезде Фред Кингтің алдынан ұшып кетті».
Dialogue: 0,0:20:55.29,0:21:00.92,Default,,0,0,0,,«Мен Фредпін, ғарышта ұшатын шаянмын».
Dialogue: 0,0:21:01.05,0:21:04.93,Default,,0,0,0,,«Егер мен және Кинг бірігсек, қорқатын ештеңе жоқ».
Dialogue: 0,0:21:05.05,0:21:06.84,Default,,0,0,0,,«Қарсы шабуыл басталды»
Dialogue: 0,0:21:06.97,0:21:08.97,Default,,0,0,0,,«Бұл кескілескен шайқас».
Dialogue: 0,0:21:11.18,0:21:13.35,Default,,0,0,0,,«Біреуге көмектес!
Dialogue: 0,0:21:13.43,0:21:15.06,Default,,0,0,0,,Алға патша!
Dialogue: 0,0:21:15.73,0:21:21.15,Default,,0,0,0,,«Бірақ Фред пен КДж13 бұрышта қалды».
Dialogue: 0,0:21:22.78,0:21:26.53,Default,,0,0,0,,«Сол кезде Фред маған бөксемді қолдан деп айқайлады».
Dialogue: 0,0:21:27.57,0:21:28.74,Default,,0,0,0,,Мен?
Dialogue: 0,0:21:28.87,0:21:33.66,Default,,0,0,0,,«KJ13-тің бөкселері және Фредтің қатты дауысы»
Dialogue: 0,0:21:33.83,0:21:38.46,Default,,0,0,0,,«Олар жаман жігітті сәтті жеңді».
Dialogue: 0,0:21:47.59,0:21:52.68,Default,,0,0,0,,«Осылайша алып шаян Фредтің шытырман оқиғасы аяқталды».
Dialogue: 0,0:21:52.81,0:21:56.18,Default,,0,0,0,,«Айтпақшы, нәресте тек бір рет тамақтанды».
Dialogue: 0,0:21:56.35,0:21:57.39,Default,,0,0,0,,«Соңы»
Dialogue: 0,0:21:58.85,0:22:01.19,Default,,0,0,0,,Керемет, Фред.
Dialogue: 0,0:22:01.32,0:22:02.69,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:22:02.82,0:22:04.82,Default,,0,0,0,,Мен жақсырақпын
Dialogue: 0,0:22:04.94,0:22:07.95,Default,,0,0,0,,Алып шаян Фред
Dialogue: 0,0:22:08.41,0:22:10.57,Default,,0,0,0,,Қолтаңба ала аламын ба?
Dialogue: 0,0:22:10.70,0:22:12.49,Default,,0,0,0,,...
Dialogue: 0,0:22:20.63,0:22:22.13,Default,,0,0,0,,Бұл әзіл
Dialogue: 0,0:22:22.38,0:22:26.84,Default,,0,0,0,,Мына бала тамақ ішпейді, мен оны мазақтадым.
Dialogue: 0,0:22:35.93,0:22:38.02,Default,,0,0,0,,Ол қызық жігіт.
Dialogue: 0,0:22:38.14,0:22:40.27,Default,,0,0,0,,Тодды тез алыңыз.
Dialogue: 0,0:23:06.13,0:23:09.30,Default,,0,0,0,,Жапон субтитрлері Акико Комори
Dialogue: 0,0:23:10.80,0:23:16.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
