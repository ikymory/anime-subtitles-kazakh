Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.88,0:00:15.51,Default,,0,0,0,,Әке, бір апта Чизукоға қамқорлық жасаңыз.
Dialogue: 0,0:00:16.14,0:00:18.39,Default,,0,0,0,,Қозғалыстың асығы басылғаннан кейін
Dialogue: 0,0:00:18.47,0:00:20.56,Default,,0,0,0,,Мен сені жақында алып кетемін.
Dialogue: 0,0:00:21.89,0:00:23.60,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:24.15,0:00:25.56,Default,,0,0,0,,Бұл қызықсыз болуы керек
Dialogue: 0,0:00:25.65,0:00:28.52,Default,,0,0,0,,Түнде қалып, паромға мінейік.
Dialogue: 0,0:00:29.07,0:00:31.99,Default,,0,0,0,,Сіз орта мектепте оқып жүрген кезіңізде әлі қызықсыз ба және көңіл көтеруді қалайсыз ба?
Dialogue: 0,0:00:32.07,0:00:33.28,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:33.36,0:00:35.32,Default,,0,0,0,,Бұл қыз.
Dialogue: 0,0:00:35.41,0:00:37.62,Default,,0,0,0,,Менің жасыма біртүрлі суық.
Dialogue: 0,0:00:37.70,0:00:39.41,Default,,0,0,0,,Мен ештеңеге мән бермеймін.
Dialogue: 0,0:00:43.71,0:00:46.88,Default,,0,0,0,,«Маған бәрібір».
Dialogue: 0,0:00:46.96,0:00:49.13,Default,,0,0,0,,Сондықтан мені жалғыз қалдырғаныңыз дұрыс.
Dialogue: 0,0:00:49.21,0:00:52.17,Default,,0,0,0,,Оған да мән бермеймін.
Dialogue: 0,0:01:09.98,0:01:12.15,Default,,0,0,0,,(салынып жатқан тиын дыбысы)
Dialogue: 0,0:01:12.23,0:01:13.24,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:01:25.12,0:01:28.17,Default,,0,0,0,,Маған Жапон теңізі өрескел толқындар сияқты әсер қалдырды.
Dialogue: 0,0:01:28.96,0:01:30.50,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:01:33.21,0:01:35.05,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:01:35.13,0:01:36.09,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:01:37.47,0:01:39.35,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:01:40.26,0:01:41.68,Default,,0,0,0,,Иә, ата
Dialogue: 0,0:01:41.76,0:01:43.14,Default,,0,0,0,,О
Dialogue: 0,0:01:43.22,0:01:45.94,Default,,0,0,0,,Бала зейінді адамды картаға түсіріңіз
Dialogue: 0,0:01:46.02,0:01:48.02,Default,,0,0,0,,Онда мен оны осында қалдырамын.
Dialogue: 0,0:01:48.98,0:01:52.57,Default,,0,0,0,,Жарайды, жолға шығайық.
Dialogue: 0,0:02:00.12,0:02:02.28,Default,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:02:02.37,0:02:05.29,Default,,0,0,0,,Менің жеңіл жүк көлігімде Чизуконы алып жүру
Dialogue: 0,0:02:05.87,0:02:06.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:07.04,0:02:09.04,Default,,0,0,0,,Мен сені көруге келе алмаймын.
Dialogue: 0,0:02:09.12,0:02:11.46,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:11.92,0:02:15.17,Default,,0,0,0,,Мама, сіз бос емес сияқтысыз.
Dialogue: 0,0:02:15.26,0:02:16.30,Default,,0,0,0,,Иә
Dialogue: 0,0:02:16.38,0:02:20.47,Default,,0,0,0,,Сіз жоғарылатылған сияқтысыз және бәрі қиын болады.
Dialogue: 0,0:02:20.55,0:02:21.39,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:27.56,0:02:30.23,Default,,0,0,0,,Әй, ақырында, ақырында, ақырында
Dialogue: 0,0:02:30.31,0:02:33.44,Default,,0,0,0,,Сен де бүгін қиналып жүрсің.
Dialogue: 0,0:02:34.48,0:02:38.28,Default,,0,0,0,,Қоңыр... адам?
Dialogue: 0,0:02:38.36,0:02:39.61,Default,,0,0,0,,Косплей?
Dialogue: 0,0:02:39.70,0:02:43.45,Default,,0,0,0,,Мен болғанша кешкі ас сатып алғыңыз келе ме?
Dialogue: 0,0:02:43.53,0:02:46.33,Default,,0,0,0,,Сіз не жегіңіз келеді? карта бала
Dialogue: 0,0:02:47.29,0:02:48.71,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:49.29,0:02:51.75,Default,,0,0,0,,Жарайды, мен бүгін жетемін.
Dialogue: 0,0:02:51.83,0:02:54.00,Default,,0,0,0,,Мен саған бір апта қараймын.
Dialogue: 0,0:02:54.09,0:02:55.09,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:02:56.13,0:02:58.67,Default,,0,0,0,,Мен Чизуко Датемін
Dialogue: 0,0:02:59.22,0:03:01.30,Default,,0,0,0,,Анамның жұмысына байланысты.
Dialogue: 0,0:03:01.39,0:03:05.76,Default,,0,0,0,,Мен атамның үйінде бір апта ғана боламын.
Dialogue: 0,0:03:06.35,0:03:08.64,Default,,0,0,0,,N префектурасы Нанига қаласы
Dialogue: 0,0:03:09.35,0:03:12.94,Default,,0,0,0,,Жақын жерде тыныш теңізі бар жақсы жер.
Dialogue: 0,0:03:13.02,0:03:14.90,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:14.98,0:03:16.90,Default,,0,0,0,,(Хроманың айқайы)
Dialogue: 0,0:03:16.98,0:03:20.82,Default,,0,0,0,,Аз уақыт болса да көмегіңіз үшін рахмет.
Dialogue: 0,0:03:32.71,0:03:34.42,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:35.00,0:03:37.59,Default,,0,0,0,,Атам ас әзірлеуге шебер.
Dialogue: 0,0:03:37.67,0:03:40.38,Default,,0,0,0,,Мен саған кез келген нәрседе көмектесемін~
Dialogue: 0,0:03:40.47,0:03:41.76,Default,,0,0,0,,Иә
Dialogue: 0,0:03:41.84,0:03:43.43,Default,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:03:52.65,0:03:54.15,Default,,0,0,0,,Сәлем Чизуко
Dialogue: 0,0:03:54.23,0:03:56.48,Default,,0,0,0,,Ас үй осында.
Dialogue: 0,0:03:56.57,0:03:57.57,Default,,0,0,0,,Иә
Dialogue: 0,0:04:02.61,0:04:03.61,Default,,0,0,0,,О
Dialogue: 0,0:04:08.08,0:04:10.08,Default,,0,0,0,,О~
Dialogue: 0,0:04:11.00,0:04:13.12,Default,,0,0,0,,Ептілік
Dialogue: 0,0:04:13.67,0:04:14.75,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:04:14.83,0:04:17.21,Default,,0,0,0,,Мен шыққан перде
Dialogue: 0,0:04:17.29,0:04:19.21,Default,,0,0,0,,Бірақ дәмді көрінеді
Dialogue: 0,0:04:22.97,0:04:23.84,Default,,0,0,0,,Миллионың костюмі сол жігіттің шашынан алынған арнайы талшықтан жасалған.
Dialogue: 0,0:04:23.93,0:04:26.30,Default,,0,0,0,,Иә? Бұл қалыпты жағдай
Dialogue: 0,0:04:27.81,0:04:30.68,Default,,0,0,0,,Мына картадағы кішкентай бала
Dialogue: 0,0:04:31.43,0:04:35.15,Default,,0,0,0,,Өте жақсы өсті...
Dialogue: 0,0:04:35.23,0:04:36.23,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:36.31,0:04:38.40,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:04:38.86,0:04:42.19,Default,,0,0,0,,Қызықты бағдарлама көруге бола ма?
Dialogue: 0,0:04:42.65,0:04:43.99,Default,,0,0,0,,Соңғы жаңалықтар
Dialogue: 0,0:04:44.07,0:04:46.82,Default,,0,0,0,,Ниши Уордтың шетінде берілген құбыжық туралы ескерту
Dialogue: 0,0:04:46.91,0:04:49.03,Default,,0,0,0,,Ол ертерек сәтті шығарылды.
Dialogue: 0,0:04:49.03,0:04:49.58,Default,,0,0,0,,Ол ертерек сәтті шығарылды.
Dialogue: 0,0:04:49.03,0:04:49.58,Default,,0,0,0,,Менің ойымша, миринді көбірек қолдансам болар еді.
Dialogue: 0,0:04:49.58,0:04:49.66,Default,,0,0,0,,Менің ойымша, мен аздап миринді қолданар едім.
Dialogue: 0,0:04:49.66,0:04:52.79,Default,,0,0,0,,Меніңше, миринді көбірек қолдансам болар еді.
Dialogue: 0,0:04:49.66,0:04:52.79,Default,,0,0,0,,Алдымен көрермендер жіберген бейнероликке назар аударайық.
Dialogue: 0,0:04:52.79,0:04:53.33,Default,,0,0,0,,Алдымен көрермендер жіберген бейнероликке назар аударайық.
Dialogue: 0,0:05:24.78,0:05:26.66,Default,,0,0,0,,1 апта...
Dialogue: 0,0:05:27.20,0:05:31.37,Default,,0,0,0,,Ұзын сияқты Қысқа сияқты
Dialogue: 0,0:05:43.84,0:05:46.09,Default,,0,0,0,,Чичико ше?
Dialogue: 0,0:05:46.18,0:05:48.93,Default,,0,0,0,,Мұнда барлығын сатады.
Dialogue: 0,0:05:49.01,0:05:51.89,Default,,0,0,0,,Бір күннен кейін де жалықпаймын
Dialogue: 0,0:05:51.97,0:05:54.89,Default,,0,0,0,,Иә, көңілді көрінеді.
Dialogue: 0,0:05:55.39,0:05:57.52,Default,,0,0,0,,Покер беті!
Dialogue: 0,0:05:57.60,0:05:59.90,Default,,0,0,0,,Тым қаталсың, немерем.
Dialogue: 0,0:05:59.98,0:06:03.61,Default,,0,0,0,,(хабарламаны қабылдау дыбысы)
Dialogue: 0,0:06:04.07,0:06:05.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:05.11,0:06:06.36,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:06:06.45,0:06:08.32,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:06:09.49,0:06:14.04,Default,,0,0,0,,Менің Go досым Сато-сан бір күні арқасын ауыртты.
Dialogue: 0,0:06:14.12,0:06:18.29,Default,,0,0,0,,Ауруханаға барғың келсе, сені апарып беремін деп уәде бердім.
Dialogue: 0,0:06:18.37,0:06:21.50,Default,,0,0,0,,Автобуста жалғыз жүруге болмайды.
Dialogue: 0,0:06:21.59,0:06:23.05,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:06:24.59,0:06:28.13,Default,,0,0,0,,Мен жақсы боламын, сондықтан жай жүр.
Dialogue: 0,0:06:29.01,0:06:30.22,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:06:30.68,0:06:31.68,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:06:31.76,0:06:35.47,Default,,0,0,0,,Мен өз ісімді аяқтаған кезде қайтамын.
Dialogue: 0,0:06:39.48,0:06:42.56,Default,,0,0,0,,Мен бұрын болған қалада сауда орталығы бар еді.
Dialogue: 0,0:06:42.65,0:06:47.36,Default,,0,0,0,,Кешіріңіз ата, бірақ бұл жаңалық емес.
Dialogue: 0,0:06:50.61,0:06:51.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:51.87,0:06:53.28,Default,,0,0,0,,Кеше көргенім сол еді.
Dialogue: 0,0:06:54.33,0:06:57.41,Default,,0,0,0,,Таңқаларлық танымал... солай емес пе?
Dialogue: 0,0:06:57.50,0:06:59.29,Default,,0,0,0,,Ол мүлде азайған жоқ.
Dialogue: 0,0:06:59.37,0:07:00.96,Default,,0,0,0,,Әй, анау бала, сен неге қарапайым киім киіп жүрсің?
Dialogue: 0,0:07:01.04,0:07:02.04,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:07:02.13,0:07:03.84,Default,,0,0,0,,Сен мектепке бармайсың ба?
Dialogue: 0,0:07:07.88,0:07:09.01,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,0:07:09.09,0:07:10.63,Default,,0,0,0,,Сізден сұралды, солай ма? ток
Dialogue: 0,0:07:10.72,0:07:11.80,Default,,0,0,0,,Мм... Иә, мүмкін.
Dialogue: 0,0:07:11.80,0:07:12.85,Default,,0,0,0,,Мм... Иә, мүмкін.
Dialogue: 0,0:07:11.80,0:07:12.85,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:12.85,0:07:13.55,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:14.22,0:07:16.10,Default,,0,0,0,,Тағы қайда?
Dialogue: 0,0:07:16.60,0:07:20.52,Default,,0,0,0,,Анамды ауыстырғандықтан, елдің түкпір-түкпірінде тұрдық.
Dialogue: 0,0:07:20.60,0:07:25.32,Default,,0,0,0,,Еш жерде ұзақ қалмадым, тіпті...
Dialogue: 0,0:07:31.20,0:07:32.36,Default,,0,0,0,,Ик!
Dialogue: 0,0:07:32.45,0:07:33.32,Default,,0,0,0,,Ах
Dialogue: 0,0:07:36.29,0:07:38.70,Default,,0,0,0,,Ня...ня~
Dialogue: 0,0:07:38.79,0:07:40.96,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,0:07:41.04,0:07:43.63,Default,,0,0,0,,Бірақ мысық? Жаман емес пе?
Dialogue: 0,0:07:45.00,0:07:46.00,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:07:46.59,0:07:49.09,Default,,0,0,0,,Бір нәрсе... жоқ.
Dialogue: 0,0:07:49.59,0:07:50.88,Default,,0,0,0,,Маширо!
Dialogue: 0,0:07:50.97,0:07:52.34,Default,,0,0,0,,Табылды
Dialogue: 0,0:07:56.93,0:07:58.35,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:59.39,0:08:00.77,Default,,0,0,0,,Сіздің мысық?
Dialogue: 0,0:08:00.85,0:08:01.98,Default,,0,0,0,,Иә
Dialogue: 0,0:08:02.06,0:08:03.98,Default,,0,0,0,,Мен адасып, іздедім.
Dialogue: 0,0:08:04.06,0:08:05.40,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:05.48,0:08:08.11,Default,,0,0,0,,Кешіріңіз, мен де сізді басып кете жаздадым.
Dialogue: 0,0:08:08.90,0:08:10.44,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:08:10.53,0:08:12.36,Default,,0,0,0,,Бұл өте пайдалы болды.
Dialogue: 0,0:08:12.45,0:08:13.41,Default,,0,0,0,,Эй
Dialogue: 0,0:08:14.24,0:08:16.07,Default,,0,0,0,,N... nyaa
Dialogue: 0,0:08:24.00,0:08:27.88,Default,,0,0,0,,Мен бұрын біртүрлі дауыс естідім...
Dialogue: 0,0:08:27.96,0:08:29.46,Default,,0,0,0,,Ик!
Dialogue: 0,0:08:49.40,0:08:54.32,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:09:01.12,0:09:03.54,Default,,0,0,0,,Келесі қай қалаға барасыз?
Dialogue: 0,0:09:03.62,0:09:07.04,Default,,0,0,0,,Шулы жер болмаса, кез келген жер жақсы.
Dialogue: 0,0:09:07.13,0:09:07.96,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:09:07.96,0:09:09.54,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:09:07.96,0:09:09.54,Default,,0,0,0,,Эй, бұл дыбыс...
Dialogue: 0,0:09:10.80,0:09:11.80,Default,,0,0,0,,Не?
Dialogue: 0,0:09:11.88,0:09:13.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:09:13.80,0:09:14.72,Default,,0,0,0,,Не?
Dialogue: 0,0:09:18.51,0:09:20.39,Default,,0,0,0,,Бұл адам косплей...
Dialogue: 0,0:09:22.89,0:09:24.39,Default,,0,0,0,,Фосса Магна командирі!
Dialogue: 0,0:09:25.06,0:09:27.15,Default,,0,0,0,,Сіз тағы бірдеңені дұрыс істемейсіз.
Dialogue: 0,0:09:27.23,0:09:29.82,Default,,0,0,0,,Хмф, иә, сағ
Dialogue: 0,0:09:29.90,0:09:31.15,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:09:31.23,0:09:33.65,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:09:41.16,0:09:43.04,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:09:45.58,0:09:48.21,Default,,0,0,0,,(Хроманың айқайы)
Dialogue: 0,0:09:49.13,0:09:50.17,Default,,0,0,0,,Аю?
Dialogue: 0,0:09:50.63,0:09:51.55,Default,,0,0,0,,Бол...
Dialogue: 0,0:09:51.63,0:09:53.01,Default,,0,0,0,,Қош келдіңіз (Кума құбыжық) Аю...
Dialogue: 0,0:09:56.63,0:09:59.39,Default,,0,0,0,,Не?!
Dialogue: 0,0:09:59.97,0:10:03.27,Default,,0,0,0,,Аю аю аю аю...
Dialogue: 0,0:10:03.72,0:10:04.85,Default,,0,0,0,,Бау!
Dialogue: 0,0:10:07.14,0:10:08.19,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:10:13.23,0:10:14.69,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:10:16.65,0:10:17.57,Default,,0,0,0,,(Хроманың айқайы)
Dialogue: 0,0:10:17.57,0:10:20.57,Default,,0,0,0,,(Хроманың айқайы)
Dialogue: 0,0:10:17.57,0:10:20.57,Default,,0,0,0,,Бұл маңызды нәрсе.
Dialogue: 0,0:10:20.57,0:10:21.20,Default,,0,0,0,,(Хроманың айқайы)
Dialogue: 0,0:10:42.39,0:10:45.60,Default,,0,0,0,,және... қымбат
Dialogue: 0,0:10:52.86,0:10:56.40,Default,,0,0,0,,Бұл қандай толқу?
Dialogue: 0,0:11:01.91,0:11:02.57,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:11:02.57,0:11:03.66,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:11:02.57,0:11:03.66,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:11:03.66,0:11:04.16,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:11:04.87,0:11:06.62,Default,,0,0,0,,Иә
Dialogue: 0,0:11:07.45,0:11:08.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:08.83,0:11:10.29,Default,,0,0,0,,Суланған...
Dialogue: 0,0:11:10.37,0:11:12.67,Default,,0,0,0,,Тіпті қатты жаңбыр жауды ма?
Dialogue: 0,0:11:12.75,0:11:15.92,Default,,0,0,0,,Ата, мен осында тұра аламын ба?
Dialogue: 0,0:11:16.00,0:11:16.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:17.05,0:11:19.17,Default,,0,0,0,,Мен таптым
Dialogue: 0,0:11:19.63,0:11:24.01,Default,,0,0,0,,Е... Мен бұған мүлдем қарсы емеспін.
Dialogue: 0,0:11:26.97,0:11:29.43,Default,,0,0,0,,Мен таптым
Dialogue: 0,0:11:29.52,0:11:34.40,Default,,0,0,0,,Басқа ешбір қалада кездеспейтін көңіліңді көтеретін нәрсе
Dialogue: 0,0:11:35.07,0:11:38.44,Default,,0,0,0,,Иә, осы қалада
Dialogue: 0,0:11:39.15,0:11:41.41,Default,,0,0,0,,Сиқырлы қыз бар
Dialogue: 0,0:11:41.49,0:11:45.28,Default,,0,0,0,,Мен сенің қуанышты дауысыңды бірінші рет естіп тұрмын
Dialogue: 0,0:11:45.37,0:11:48.45,Default,,0,0,0,,Мен мұны жаман деп айта алмаймын.
Dialogue: 0,0:11:49.45,0:11:50.75,Default,,0,0,0,,Ура!
Dialogue: 0,0:11:50.75,0:11:51.79,Default,,0,0,0,,Ура!
Dialogue: 0,0:11:50.75,0:11:51.79,Default,,0,0,0,,О~
Dialogue: 0,0:11:51.79,0:11:52.29,Default,,0,0,0,,О~
Dialogue: 0,0:11:52.83,0:11:54.63,Default,,0,0,0,,Менің өмірім
Dialogue: 0,0:11:55.38,0:11:58.00,Default,,0,0,0,,Қазір басталып жатқан сияқты!
Dialogue: 0,0:12:01.51,0:12:05.76,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:12:05.85,0:12:08.97,Default,,0,0,0,,Eh Қызметкерлер бөлмесінен шұғыл хабарлама
Dialogue: 0,0:12:09.06,0:12:11.81,Default,,0,0,0,,Ниши Уордта құбыжық туралы ескерту жарияланды.
Dialogue: 0,0:12:11.89,0:12:12.77,Default,,0,0,0,,Қайталау: Қызметкерлер бөлмесінен шұғыл хабарлама
Dialogue: 0,0:12:12.77,0:12:13.69,Default,,0,0,0,,Қайталау: Қызметкерлер бөлмесінен шұғыл хабарлама
Dialogue: 0,0:12:12.77,0:12:13.69,Default,,0,0,0,,Көңілсіз…
Dialogue: 0,0:12:13.69,0:12:14.52,Default,,0,0,0,,Қайталау: Қызметкерлер бөлмесінен шұғыл хабарлама
Dialogue: 0,0:12:14.52,0:12:15.23,Default,,0,0,0,,Қайталау: Қызметкерлер бөлмесінен шұғыл хабарлама
Dialogue: 0,0:12:14.52,0:12:15.23,Default,,0,0,0,,Матака?
Dialogue: 0,0:12:15.23,0:12:15.31,Default,,0,0,0,,Матака?
Dialogue: 0,0:12:15.31,0:12:15.81,Default,,0,0,0,,Матака?
Dialogue: 0,0:12:15.31,0:12:15.81,Default,,0,0,0,,Ниши Уордта құбыжық туралы ескерту жарияланды.
Dialogue: 0,0:12:15.81,0:12:17.23,Default,,0,0,0,,Ниши Уордта құбыжық туралы ескерту жарияланды.
Dialogue: 0,0:12:17.32,0:12:19.90,Default,,0,0,0,,Сіз караокеге бара алмайсыз.
Dialogue: 0,0:12:20.49,0:12:22.32,Default,,0,0,0,,Жаман шықты.
Dialogue: 0,0:12:26.66,0:12:28.91,Default,,0,0,0,,Ах... анау Дата-сан.
Dialogue: 0,0:12:29.79,0:12:31.71,Default,,0,0,0,,Бағыты бірдей, солай емес пе?
Dialogue: 0,0:12:31.79,0:12:33.92,Default,,0,0,0,,Менімен бірге үйге барғың келе ме?
Dialogue: 0,0:12:34.00,0:12:35.67,Default,,0,0,0,,Өйткені менің бір ісім бар.
Dialogue: 0,0:12:36.38,0:12:37.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:47.47,0:12:48.81,Default,,0,0,0,,Асығу керек
Dialogue: 0,0:12:49.26,0:12:51.89,Default,,0,0,0,,Оқиға орнына тез жетуіміз керек.
Dialogue: 0,0:12:57.73,0:13:00.19,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:13:00.28,0:13:02.28,Default,,0,0,0,,Уақытында емес
Dialogue: 0,0:13:03.03,0:13:06.62,Default,,0,0,0,,Көрермен жіберген кадрларды мына жерден қараңыз.
Dialogue: 0,0:13:08.12,0:13:10.54,Default,,0,0,0,,Ааааааааааааа...
Dialogue: 0,0:13:10.62,0:13:11.87,Default,,0,0,0,,Ол шықты.
Dialogue: 0,0:13:11.95,0:13:13.50,Default,,0,0,0,,Қаланы басып алған зұлымдық
Dialogue: 0,0:13:13.58,0:13:15.79,Default,,0,0,0,,Бұл жидек гүлі мені кешірмейді!
Dialogue: 0,0:13:16.37,0:13:19.29,Default,,0,0,0,,Иә, ол Берри гүлі.
Dialogue: 0,0:13:19.38,0:13:23.05,Default,,0,0,0,,Ол осы N префектурасын, Нанига қаласын қорғайтын сиқырлы қыз.
Dialogue: 0,0:13:23.13,0:13:26.05,Default,,0,0,0,,Ал бұл менмін
Dialogue: 0,0:13:26.13,0:13:29.01,Default,,0,0,0,,Берри Блоссомның ынталы жанкүйері
Dialogue: 0,0:13:29.10,0:13:31.43,Default,,0,0,0,,Жидек гүлі
Dialogue: 0,0:13:31.52,0:13:33.81,Default,,0,0,0,,Бұл өте керемет
Dialogue: 0,0:13:34.85,0:13:36.10,Default,,0,0,0,,Ах
Dialogue: 0,0:13:36.19,0:13:38.40,Default,,0,0,0,,Зұлым қолбасшы Хрома пайда болады
Dialogue: 0,0:13:38.40,0:13:39.90,Default,,0,0,0,,Зұлым қолбасшы Хрома пайда болады
Dialogue: 0,0:13:38.40,0:13:39.90,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:13:40.40,0:13:41.65,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:13:41.73,0:13:44.61,Default,,0,0,0,,Мен сізге жақын арада нұсқау беремін.
Dialogue: 0,0:13:44.69,0:13:46.82,Default,,0,0,0,,Жүр, құбыжық аю!
Dialogue: 0,0:13:47.28,0:13:49.12,Default,,0,0,0,,Фу (Кума құбыжығы) Аю
Dialogue: 0,0:13:49.20,0:13:50.37,Default,,0,0,0,,Эй (Кума құбыжығы) Аю
Dialogue: 0,0:13:53.91,0:13:56.08,Default,,0,0,0,,(Хроманың айқайы)
Dialogue: 0,0:13:56.62,0:13:59.08,Default,,0,0,0,,Жарнамадан кейін ауа райы бұрышы бар.
Dialogue: 0,0:14:01.63,0:14:03.05,Default,,0,0,0,,Жағымсыз
Dialogue: 0,0:14:03.13,0:14:06.05,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:14:06.13,0:14:09.97,Default,,0,0,0,,Біріншіден, сол фронтальды серпіліс сезімі?
Dialogue: 0,0:14:10.05,0:14:12.64,Default,,0,0,0,,Тосын шабуылдармен көбірек шабуыл жасағаныңызды қалаймын.
Dialogue: 0,0:14:12.72,0:14:14.60,Default,,0,0,0,,Бірдеңе тапсырыс берші
Dialogue: 0,0:14:14.68,0:14:17.31,Default,,0,0,0,,Біріншіден, стратегия жоқ па?
Dialogue: 0,0:14:17.39,0:14:21.23,Default,,0,0,0,,Бұл оның соққыға жығылуы табиғи нәрсе. Қарауға тұрарлық емес.
Dialogue: 0,0:14:21.31,0:14:25.36,Default,,0,0,0,,Зұлымдық болса, оны күшейт, оған қарсы күрес!
Dialogue: 0,0:14:25.99,0:14:27.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:27.49,0:14:29.53,Default,,0,0,0,,Айтпақшы, эвакуациялауға бола ма?
Dialogue: 0,0:14:29.61,0:14:32.37,Default,,0,0,0,,Не? Жарайды
Dialogue: 0,0:14:32.45,0:14:34.54,Default,,0,0,0,,Ескерту болса, баяғыда...
Dialogue: 0,0:14:35.37,0:14:37.29,Default,,0,0,0,,Әрине, ол жойылды
Dialogue: 0,0:14:37.37,0:14:39.21,Default,,0,0,0,,Сіз сондай бейшарасыз.
Dialogue: 0,0:14:39.67,0:14:41.29,Default,,0,0,0,,Жамандық болса, осында.
Dialogue: 0,0:14:44.71,0:14:45.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:45.63,0:14:47.51,Default,,0,0,0,,Зардап шеккен адамға...
Dialogue: 0,0:14:47.59,0:14:49.05,Default,,0,0,0,,Сенің есі дұрыс па?
Dialogue: 0,0:14:49.13,0:14:51.85,Default,,0,0,0,,Маған зұлымдық иесі айтты ма деп ойлаймын!
Dialogue: 0,0:14:51.93,0:14:53.68,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:14:54.26,0:14:58.44,Default,,0,0,0,,Мен сізге бағыт-бағдар беремін демей тұрып, үйге бару қиын.
Dialogue: 0,0:14:58.52,0:14:59.89,Default,,0,0,0,,Сіз нәзіксіз бе?
Dialogue: 0,0:15:00.35,0:15:04.44,Default,,0,0,0,,Үйге қайту қиын болғандықтан, мен өз-өзіме рефлексия жасап отырдым.
Dialogue: 0,0:15:05.15,0:15:07.61,Default,,0,0,0,,Кеңес Бұл өте пайдалы болды.
Dialogue: 0,0:15:07.69,0:15:09.95,Default,,0,0,0,,Неліктен орын ауыстырып, біраз сөйлеспейміз?
Dialogue: 0,0:15:10.03,0:15:11.70,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:15:12.16,0:15:14.91,Default,,0,0,0,,Сізге Берри гүлі ұнайды, солай ма?
Dialogue: 0,0:15:14.99,0:15:16.70,Default,,0,0,0,,Ал, олай айтпа.
Dialogue: 0,0:15:16.79,0:15:18.41,Default,,0,0,0,,Ғашықтар ше?
Dialogue: 0,0:15:26.13,0:15:28.05,Default,,0,0,0,,Ол жоғалды...
Dialogue: 0,0:15:29.42,0:15:32.30,Default,,0,0,0,,«Не болды?» Маған бір көзқарас берілді және менің денем өз жұмысын жасады ...
Dialogue: 0,0:15:32.93,0:15:36.06,Default,,0,0,0,,Бірақ сіз зұлымдықтың көсемі ұнайды дейсіз...
Dialogue: 0,0:15:36.72,0:15:39.56,Default,,0,0,0,,Бұл ол мен мен туралы естеліктер қоймасы.
Dialogue: 0,0:15:39.64,0:15:42.31,Default,,0,0,0,,Бірдеңе айтыла бастады~
Dialogue: 0,0:15:42.40,0:15:44.44,Default,,0,0,0,,Бұл қашан болды?
Dialogue: 0,0:15:44.52,0:15:46.78,Default,,0,0,0,,Мен бұл қалаға басып кіре бастағанда...
Dialogue: 0,0:15:49.36,0:15:52.32,Default,,0,0,0,,Жаман істердің нысанасы ретінде осы жерді таңдадым.
Dialogue: 0,0:15:57.12,0:15:58.24,Default,,0,0,0,,қиындық
Dialogue: 0,0:15:58.75,0:16:01.87,Default,,0,0,0,,Міне, Фосса Магна!
Dialogue: 0,0:16:03.00,0:16:06.00,Default,,0,0,0,,Дүкен төсенішін аударыңыз ба?
Dialogue: 0,0:16:06.09,0:16:07.25,Default,,0,0,0,,О
Dialogue: 0,0:16:07.34,0:16:10.42,Default,,0,0,0,,Мен де бірінші рет жамандық жасадым.
Dialogue: 0,0:16:10.51,0:16:13.47,Default,,0,0,0,,Мен қаланы алғаш рет қорғадым.
Dialogue: 0,0:16:13.55,0:16:15.68,Default,,0,0,0,,Еш нәрсеге үйренбегенде қиын.
Dialogue: 0,0:16:15.76,0:16:16.76,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:16:16.85,0:16:19.64,Default,,0,0,0,,Сонда да мен оны бұрышқа тығыдым
Dialogue: 0,0:16:20.43,0:16:22.64,Default,,0,0,0,,Қазір ойлап қарасам, бұл кездейсоқтық сияқты.
Dialogue: 0,0:16:25.48,0:16:26.77,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:26.86,0:16:30.74,Default,,0,0,0,,Мен мұның бәрі болды деп ойлаған кезде...
Dialogue: 0,0:16:30.82,0:16:33.11,Default,,0,0,0,,Жүгіріп келемін! Мықтап ұста!
Dialogue: 0,0:16:34.20,0:16:35.74,Default,,0,0,0,,Рааааааааа!
Dialogue: 0,0:16:35.82,0:16:37.62,Default,,0,0,0,,Буфу…
Dialogue: 0,0:16:37.70,0:16:40.95,Default,,0,0,0,,Не!?
Dialogue: 0,0:16:41.87,0:16:43.29,Default,,0,0,0,,Хааа~
Dialogue: 0,0:16:43.37,0:16:46.92,Default,,0,0,0,,Иә, ол шектен асып түсті.
Dialogue: 0,0:16:47.00,0:16:50.42,Default,,0,0,0,,Менің санамда мен білдім
Dialogue: 0,0:16:50.51,0:16:52.76,Default,,0,0,0,,Төтенше шабуылдан жеңілген —
Dialogue: 0,0:16:52.84,0:16:54.34,Default,,0,0,0,,Сол ләззат
Dialogue: 0,0:16:54.43,0:16:56.72,Default,,0,0,0,,Сіз не үшін ояусыз?
Dialogue: 0,0:16:56.80,0:16:59.93,Default,,0,0,0,,Берри гүлін ұнатсаңыз, сіз бұзықсыз ба?
Dialogue: 0,0:17:00.01,0:17:02.60,Default,,0,0,0,,Жеңілгенде қуаныш табатын адам түрі.
Dialogue: 0,0:17:04.56,0:17:08.57,Default,,0,0,0,,Бірақ сіз оның күрескенін қалайсыз, солай емес пе?
Dialogue: 0,0:17:08.65,0:17:09.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:09.65,0:17:12.82,Default,,0,0,0,,Оған әрең қараған кезде ештеңе сезбесеңіз ше?
Dialogue: 0,0:17:17.62,0:17:18.83,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:18.91,0:17:21.83,Default,,0,0,0,,Ал... Маған бұл ұнайды.
Dialogue: 0,0:17:21.91,0:17:22.83,Default,,0,0,0,,Иә
Dialogue: 0,0:17:22.91,0:17:25.29,Default,,0,0,0,,Қаланың тағдыры қыл үстінде тұрса да
Dialogue: 0,0:17:25.37,0:17:28.38,Default,,0,0,0,,Олар аздап күрескені дұрыс!
Dialogue: 0,0:17:28.88,0:17:30.13,Default,,0,0,0,,Куку…
Dialogue: 0,0:17:30.21,0:17:32.17,Default,,0,0,0,,Сен де сондайсың.
Dialogue: 0,0:17:32.26,0:17:36.93,Default,,0,0,0,,Соған қарамастан, сіз соңғы минутта қарсыласыңызбен шайқастасыз.
Dialogue: 0,0:17:38.34,0:17:41.56,Default,,0,0,0,,Иә, ол қазір өте күшті.
Dialogue: 0,0:17:41.64,0:17:44.14,Default,,0,0,0,,Жас болғандықтан, оның өсетін жері көп.
Dialogue: 0,0:17:44.68,0:17:47.27,Default,,0,0,0,,Жеңілу қызық емес
Dialogue: 0,0:17:47.35,0:17:51.15,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, Fossa Magna зұлым ұйымы болады
Dialogue: 0,0:17:51.23,0:17:53.65,Default,,0,0,0,,Жақында талқандалады
Dialogue: 0,0:17:56.57,0:17:58.16,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:17:58.24,0:18:01.20,Default,,0,0,0,,Орныңызды растаңыз.
Dialogue: 0,0:18:02.12,0:18:05.04,Default,,0,0,0,,Жарайды... бұл сенің кінәң, солай ма?
Dialogue: 0,0:18:05.12,0:18:08.54,Default,,0,0,0,,Саған не болатынын білмеймін...
Dialogue: 0,0:18:09.67,0:18:10.88,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:18:11.38,0:18:15.30,Default,,0,0,0,,Бол... Берриде жау болмаса, қиын болар еді.
Dialogue: 0,0:18:16.13,0:18:17.43,Default,,0,0,0,,Адал
Dialogue: 0,0:18:18.51,0:18:21.10,Default,,0,0,0,,Менің бір ұсынысым бар.
Dialogue: 0,0:18:21.18,0:18:24.56,Default,,0,0,0,,Менің және оның арасындағы күресті жалғастыру
Dialogue: 0,0:18:25.60,0:18:27.14,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:18:28.14,0:18:29.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:29.52,0:18:31.19,Default,,0,0,0,,Дәлірек айтсақ, И
Dialogue: 0,0:18:31.27,0:18:34.32,Default,,0,0,0,,Дәл қазір өзіңізді алданғандай сезінесіз бе?
Dialogue: 0,0:18:34.40,0:18:34.86,Default,,0,0,0,,Дөңгелек және дөңгелек хаха
Dialogue: 0,0:18:34.86,0:18:37.11,Default,,0,0,0,,Дөңгелек және дөңгелек хаха
Dialogue: 0,0:18:34.86,0:18:37.11,Default,,0,0,0,,Өйткені ол зұлымдықтың қолбасшысы.
Dialogue: 0,0:18:37.20,0:18:39.61,Default,,0,0,0,,Мұның бәрі өтірік болуы мүмкін
Dialogue: 0,0:18:39.70,0:18:42.12,Default,,0,0,0,,Менің күзетімді түсіруге қалай дәтің бардың...
Dialogue: 0,0:18:42.20,0:18:43.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:43.95,0:18:47.12,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:47.21,0:18:51.08,Default,,0,0,0,,Аххх...
Dialogue: 0,0:18:53.00,0:18:55.13,Default,,0,0,0,,Түсіндім, түсіндім.
Dialogue: 0,0:18:55.21,0:18:58.84,Default,,0,0,0,,Неліктен сіз мені алдауыңыздың пайдасын көре аласыз, өйткені мен Берри гүлін ұнатамын
Dialogue: 0,0:18:59.30,0:19:00.47,Default,,0,0,0,,Аю
Dialogue: 0,0:19:00.55,0:19:02.10,Default,,0,0,0,,Неліктен кенеттен қорқасың?
Dialogue: 0,0:19:02.18,0:19:04.10,Default,,0,0,0,,Басқаша айтқанда, адам ұрлау!
Dialogue: 0,0:19:04.18,0:19:07.93,Default,,0,0,0,,Сіз мені кепілге алып, Берримен төбелесуді жоспарлап отырсыз!
Dialogue: 0,0:19:08.94,0:19:11.35,Default,,0,0,0,,Не? Жоқ, олай емес
Dialogue: 0,0:19:11.81,0:19:13.86,Default,,0,0,0,,Бірақ мен көріп тұрмын, қолдың түрі
Dialogue: 0,0:19:14.65,0:19:16.65,Default,,0,0,0,,Куку... Уайымдама.
Dialogue: 0,0:19:16.73,0:19:18.28,Default,,0,0,0,,Адам ұрлау жоқ
Dialogue: 0,0:19:18.36,0:19:22.28,Default,,0,0,0,,Сонда да әннің тереңдігі мен мидың айналу жылдамдығы
Dialogue: 0,0:19:22.37,0:19:23.66,Default,,0,0,0,,Барған сайын қолайлы
Dialogue: 0,0:19:23.74,0:19:24.91,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:19:24.99,0:19:26.37,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:19:26.45,0:19:28.79,Default,,0,0,0,,Мен оны іздеп жүрмін
Dialogue: 0,0:19:28.87,0:19:30.92,Default,,0,0,0,,Қазіргі жағдайдан қалай шығуға болады
Dialogue: 0,0:19:31.00,0:19:32.92,Default,,0,0,0,,Және табылды
Dialogue: 0,0:19:33.00,0:19:35.84,Default,,0,0,0,,Ол жеткілікті жақсы стратегия ойлап табады.
Dialogue: 0,0:19:35.92,0:19:37.96,Default,,0,0,0,,Керемет адам ресурстарын жалдау
Dialogue: 0,0:19:38.51,0:19:40.01,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:19:40.09,0:19:41.93,Default,,0,0,0,,Бұл толығымен басқа адамдарға байланысты!
Dialogue: 0,0:19:42.01,0:19:43.93,Default,,0,0,0,,Аю құбыжығы
Dialogue: 0,0:19:45.35,0:19:46.85,Default,,0,0,0,,Бұл қорқақтық!
Dialogue: 0,0:19:46.93,0:19:48.06,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:48.14,0:19:50.85,Default,,0,0,0,,Мен сізді тағы шақырайын ба?
Dialogue: 0,0:19:50.94,0:19:52.23,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:19:52.31,0:19:54.65,Default,,0,0,0,,Ха, оны кім айтты?
Dialogue: 0,0:19:54.73,0:19:57.23,Default,,0,0,0,,Аузым жыртылып кетсе де, көнбеймін
Dialogue: 0,0:20:03.87,0:20:04.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:04.78,0:20:07.45,Default,,0,0,0,,Өйткені мен ересек адаммын.
Dialogue: 0,0:20:07.54,0:20:10.96,Default,,0,0,0,,Мен міндетті түрде қалағанымды алғым келеді.
Dialogue: 0,0:20:12.96,0:20:14.58,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:20:15.04,0:20:19.71,Default,,0,0,0,,Мен сіздің Фосса Магна штатының офицері болғаныңызды қалаймын.
Dialogue: 0,0:20:32.39,0:20:37.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:37.27,0:20:38.82,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:38.90,0:20:41.69,Default,,0,0,0,,Мен жай ғана Берри гүліне таңданғым келеді
Dialogue: 0,0:20:41.78,0:20:45.41,Default,,0,0,0,,Жамандық жолына түскім келмейді.
Dialogue: 0,0:20:45.49,0:20:47.20,Default,,0,0,0,,Ол сонда—сол жақта~
Dialogue: 0,0:20:51.25,0:20:51.66,Default,,0,0,0,,Ha
Dialogue: 0,0:20:51.66,0:20:52.25,Default,,0,0,0,,Ha
Dialogue: 0,0:20:51.66,0:20:52.25,Default,,0,0,0,,Әй, ұйықтама.
Dialogue: 0,0:20:52.25,0:20:54.50,Default,,0,0,0,,Эй, ұйықтама.
Dialogue: 0,0:20:54.58,0:20:55.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:54.58,0:20:55.58,Default,,0,0,0,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:20:55.58,0:20:56.38,Default,,0,0,0,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:20:56.38,0:20:58.46,Default,,0,0,0,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:20:56.38,0:20:58.46,Default,,0,0,0,,Өткен күнгі оқиғадан бері
Dialogue: 0,0:20:59.50,0:21:03.22,Default,,0,0,0,,Оның сөзі қорқынышты түс сияқты жоғалмайды
Dialogue: 0,0:21:03.30,0:21:05.39,Default,,0,0,0,,Жоқ, тыныштал, И
Dialogue: 0,0:21:09.93,0:21:13.39,Default,,0,0,0,,Бұл жай ғана арман болған шығар...
Dialogue: 0,0:21:21.07,0:21:23.90,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:21:25.70,0:21:27.66,Default,,0,0,0,,Бұл арман болған шығар
Dialogue: 0,0:21:30.87,0:21:34.25,Default,,0,0,0,,Жақсы, қандай қорқынышты түс.
Dialogue: 0,0:21:34.33,0:21:35.71,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:21:36.42,0:21:37.38,Default,,0,0,0,,Ha
Dialogue: 0,0:21:37.46,0:21:41.55,Default,,0,0,0,,Хауауауава~
Dialogue: 0,0:21:44.13,0:21:46.22,Default,,0,0,0,,Маған осылардың бірін беріңізші.
Dialogue: 0,0:21:46.30,0:21:47.30,Default,,0,0,0,,Иә
Dialogue: 0,0:21:48.01,0:21:49.43,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:21:50.72,0:21:52.27,Default,,0,0,0,,Бұл дауыс...
Dialogue: 0,0:21:53.77,0:21:56.23,Default,,0,0,0,,Аяғынан шалынған қыздар
Dialogue: 0,0:21:56.77,0:22:00.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:00.69,0:22:04.99,Default,,0,0,0,,Бұл арман емес еді!
Dialogue: 0,0:22:10.95,0:22:13.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.57,0:23:34.91,Default,,0,0,0,,～♪
