Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.62,0:00:02.87,Default,,0,0,0,,Бұл Чизуко күні.
Dialogue: 0,0:00:02.96,0:00:03.87,Default,,0,0,0,,Аю
Dialogue: 0,0:00:03.87,0:00:04.63,Default,,0,0,0,,Аю
Dialogue: 0,0:00:03.87,0:00:04.63,Default,,0,0,0,,Жамандықпен бір шаңырақ астында өмір сүру
Dialogue: 0,0:00:04.63,0:00:06.17,Default,,0,0,0,,Жамандықпен бір шаңырақ астында өмір сүру
Dialogue: 0,0:00:06.25,0:00:07.25,Default,,0,0,0,,Мен бұл күндері басқармаға құлықсыз кірдім.
Dialogue: 0,0:00:07.25,0:00:08.25,Default,,0,0,0,,Мен бұл күндері басқармаға құлықсыз кірдім.
Dialogue: 0,0:00:07.25,0:00:08.25,Default,,0,0,0,,Аю
Dialogue: 0,0:00:08.25,0:00:10.17,Default,,0,0,0,,Мен бұл күндері басқармаға құлықсыз кірдім.
Dialogue: 0,0:00:10.26,0:00:11.88,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:00:12.34,0:00:13.34,Default,,0,0,0,,Аю?
Dialogue: 0,0:00:16.39,0:00:19.97,Default,,0,0,0,,Қашуға болмайтын оқиға келе жатыр.
Dialogue: 0,0:00:20.06,0:00:21.56,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:00:21.64,0:00:23.39,Default,,0,0,0,,Маған көмектесші, ата
Dialogue: 0,0:00:23.48,0:00:24.94,Default,,0,0,0,,(Питбуль) Э? (Доберман) Э?
Dialogue: 0,0:00:26.19,0:00:27.57,Default,,0,0,0,,Хрома мырза
Dialogue: 0,0:00:27.65,0:00:31.49,Default,,0,0,0,,Кешіріңіз, бірақ мен жоқта маған қамқорлық жасаңыз.
Dialogue: 0,0:00:32.49,0:00:34.41,Default,,0,0,0,,Менің жоқтығыма сеніп тапсырылғандықтан.
Dialogue: 0,0:00:34.49,0:00:36.62,Default,,0,0,0,,Мен де бар күшімді саламын.
Dialogue: 0,0:00:36.70,0:00:38.62,Default,,0,0,0,,Уайымдама, Чизуко Дате.
Dialogue: 0,0:00:40.70,0:00:42.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:42.83,0:00:44.29,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:00:44.37,0:00:46.25,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:46.33,0:00:49.50,Default,,0,0,0,,Бұл – абыройлы жеңіс.
Dialogue: 0,0:00:49.59,0:00:51.96,Default,,0,0,0,,Аға немесе жиен болуды талап ету.
Dialogue: 0,0:00:52.05,0:00:53.67,Default,,0,0,0,,Жиен...
Dialogue: 0,0:00:53.76,0:00:55.80,Default,,0,0,0,,Уф... Мен үйге барғым келеді.
Dialogue: 0,0:00:55.89,0:00:58.55,Default,,0,0,0,,Иә? Сіз шынымен құлықсыз сияқтысыз.
Dialogue: 0,0:00:59.35,0:01:00.81,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:01:02.14,0:01:03.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:10.02,0:01:11.40,Default,,0,0,0,,Қоңырау шалыңыз
Dialogue: 0,0:01:11.48,0:01:13.15,Default,,0,0,0,,Қорқыту сезімі...
Dialogue: 0,0:01:14.11,0:01:15.70,Default,,0,0,0,,Сіз туыссыз ба?
Dialogue: 0,0:01:16.28,0:01:17.70,Default,,0,0,0,,Қызыл бейтаныс
Dialogue: 0,0:01:17.78,0:01:20.20,Default,,0,0,0,,Жарық жылдамдығымен жүрегім жарылып кетті
Dialogue: 0,0:01:20.28,0:01:22.58,Default,,0,0,0,,Сесе... Мұғалім, бұл кісі...
Dialogue: 0,0:01:23.41,0:01:24.41,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:01:25.00,0:01:27.21,Default,,0,0,0,,Мен оны қолданып көрдім.
Dialogue: 0,0:01:27.29,0:01:30.13,Default,,0,0,0,,Мен сені әрқашан білемін.
Dialogue: 0,0:01:30.21,0:01:31.05,Default,,0,0,0,,Не?
Dialogue: 0,0:01:31.63,0:01:34.59,Default,,0,0,0,,...
Dialogue: 0,0:01:34.67,0:01:37.55,Default,,0,0,0,,Зұлымдықтың көсемі деген осы ма?
Dialogue: 0,0:01:38.05,0:01:40.35,Default,,0,0,0,,О, қандай жақсы адам
Dialogue: 0,0:01:40.43,0:01:42.52,Default,,0,0,0,,Чизуко Дате, бұл адам кім?
Dialogue: 0,0:01:42.60,0:01:44.14,Default,,0,0,0,,Тынш, тыныш бол.
Dialogue: 0,0:01:44.23,0:01:45.48,Default,,0,0,0,,Көрмеңіз
Dialogue: 0,0:01:45.56,0:01:47.31,Default,,0,0,0,,Сіз өзіңізді әлі таныстырған жоқсыз.
Dialogue: 0,0:01:48.23,0:01:51.15,Default,,0,0,0,,Ниши орта мектебінің математика пәнінің мұғалімі
Dialogue: 0,0:01:51.23,0:01:55.49,Default,,0,0,0,,2 Сынып жетекшісі Йоко Масамунэ 37 жаста
Dialogue: 0,0:01:55.57,0:01:58.74,Default,,0,0,0,,Ол бір кездері Дате әулетінің асырап алған күйеу баласы болған.
Dialogue: 0,0:01:58.82,0:01:59.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:00.37,0:02:04.04,Default,,0,0,0,,Бұл Чизуко Датенің әкесі.
Dialogue: 0,0:02:04.75,0:02:06.58,Default,,0,0,0,,Түпнұсқа.
Dialogue: 0,0:02:10.00,0:02:14.76,Default,,0,0,0,,♪～
Dialogue: 0,0:03:37.30,0:03:39.92,Default,,0,0,0,,～♪
Dialogue: 0,0:03:41.01,0:03:43.18,Default,,0,0,0,,Не... әкем?
Dialogue: 0,0:03:43.26,0:03:45.43,Default,,0,0,0,,Не? Бұл рас па?
Dialogue: 0,0:03:45.51,0:03:47.22,Default,,0,0,0,,Онда мен сізді арттан сәл итермелеуге тура келеді —
Dialogue: 0,0:03:47.31,0:03:51.94,Default,,0,0,0,,Оны былай қойғанда, үш жақты кездесуді бастайық.
Dialogue: 0,0:03:52.02,0:03:53.35,Default,,0,0,0,,Мен өзімді ыңғайсыз сезінемін...
Dialogue: 0,0:03:54.23,0:03:57.02,Default,,0,0,0,,Атмосфера енді ондай емес.
Dialogue: 0,0:03:57.11,0:03:58.98,Default,,0,0,0,,Сізге қалай жақындауым керек?
Dialogue: 0,0:03:59.07,0:04:00.74,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:04:00.82,0:04:03.24,Default,,0,0,0,,Ұстазымның әкем екенін де білдім.
Dialogue: 0,0:04:03.32,0:04:05.82,Default,,0,0,0,,Алдыңғы үш жақты сұхбаттың басында
Dialogue: 0,0:04:06.33,0:04:08.83,Default,,0,0,0,,Уау, Масамуне-кун.
Dialogue: 0,0:04:08.91,0:04:11.21,Default,,0,0,0,,Мен сенің әкеңмін
Dialogue: 0,0:04:11.29,0:04:12.41,Default,,0,0,0,,Иә!?
Dialogue: 0,0:04:13.37,0:04:17.46,Default,,0,0,0,,Осы уақытқа дейін мен ол туралы ештеңе білмей күнде онымен араласатынмын.
Dialogue: 0,0:04:18.25,0:04:21.01,Default,,0,0,0,,Бұл не, кішкене сұмдық?
Dialogue: 0,0:04:21.09,0:04:22.93,Default,,0,0,0,,Ата-анасы ажырасқанда
Dialogue: 0,0:04:23.01,0:04:26.60,Default,,0,0,0,,Мен әлі өте жас едім, сондықтан ештеңе есімде жоқ.
Dialogue: 0,0:04:26.68,0:04:28.47,Default,,0,0,0,,Сіз мені кенеттен әке деп атасаңыз да...
Dialogue: 0,0:04:28.56,0:04:30.47,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:04:31.43,0:04:33.23,Default,,0,0,0,,Чизуко-сан (Чизуко) Эй... иә!
Dialogue: 0,0:04:33.31,0:04:36.15,Default,,0,0,0,,Қиындық тудыруы мүмкін ештеңе жасамаңыз.
Dialogue: 0,0:04:36.23,0:04:37.65,Default,,0,0,0,,Сізде жоқ, солай емес пе?
Dialogue: 0,0:04:38.57,0:04:39.78,Default,,0,0,0,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:04:39.86,0:04:41.69,Default,,0,0,0,,Мен зұлым ұйымның мүшесімін.
Dialogue: 0,0:04:41.78,0:04:43.49,Default,,0,0,0,,Жақсы азамат!
Dialogue: 0,0:04:43.57,0:04:46.41,Default,,0,0,0,,Жаман істерге серік болатын кездерім болады.
Dialogue: 0,0:04:47.87,0:04:49.12,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:49.20,0:04:50.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:50.54,0:04:52.00,Default,,0,0,0,,Уф... бұл қорқынышты
Dialogue: 0,0:04:52.08,0:04:54.21,Default,,0,0,0,,Олар ата-ана мен бала, бірақ мен олардың эмоцияларын оқи алмаймын.
Dialogue: 0,0:04:54.21,0:04:55.04,Default,,0,0,0,,Олар ата-ана мен бала, бірақ мен олардың эмоцияларын оқи алмаймын.
Dialogue: 0,0:04:54.21,0:04:55.04,Default,,0,0,0,,Дегенмен~
Dialogue: 0,0:04:55.04,0:04:55.12,Default,,0,0,0,,Дегенмен~
Dialogue: 0,0:04:55.12,0:04:55.96,Default,,0,0,0,,Дегенмен~
Dialogue: 0,0:04:55.12,0:04:55.96,Default,,0,0,0,,Ол маған үлкен үшбұрыш сызғышын тигізетін сияқты
Dialogue: 0,0:04:55.96,0:04:58.00,Default,,0,0,0,,Ол маған үлкен үшбұрыш сызғышын тигізетін сияқты
Dialogue: 0,0:04:59.34,0:05:01.63,Default,,0,0,0,,Мазасыздық жасау шектен шыққан.
Dialogue: 0,0:05:01.71,0:05:04.80,Default,,0,0,0,,Чизуко-сан, әділдік одақтастарын белсенді ету үшін
Dialogue: 0,0:05:04.88,0:05:07.76,Default,,0,0,0,,Ол менің қызметкерім ретінде жақсы жұмыс істейді.
Dialogue: 0,0:05:10.72,0:05:13.23,Default,,0,0,0,,Ақымақ, ақымақ, ақымақ, бәрін айттым.
Dialogue: 0,0:05:13.31,0:05:14.98,Default,,0,0,0,,Сізді төмен түсіру ниетімен...
Dialogue: 0,0:05:15.06,0:05:17.60,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:05:17.69,0:05:19.77,Default,,0,0,0,,Уф... Кешіріңіз, мұғалім.
Dialogue: 0,0:05:21.69,0:05:23.03,Default,,0,0,0,,Мен ең болмағанда алған ақшамды қайтарып бергім келеді.
Dialogue: 0,0:05:23.11,0:05:24.15,Default,,0,0,0,,Не?
Dialogue: 0,0:05:24.82,0:05:27.66,Default,,0,0,0,,Кешіріңіз, көңілім қалды.
Dialogue: 0,0:05:27.74,0:05:31.16,Default,,0,0,0,,Өзі сүйсінген адамның алдында қобалжыған сияқты.
Dialogue: 0,0:05:32.16,0:05:33.16,Default,,0,0,0,,Хрома мырза
Dialogue: 0,0:05:33.25,0:05:35.16,Default,,0,0,0,,А... мен?
Dialogue: 0,0:05:35.25,0:05:36.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:36.17,0:05:37.17,Default,,0,0,0,,Иә
Dialogue: 0,0:05:37.92,0:05:40.46,Default,,0,0,0,,Тумысынан ынта-жігерге бейім
Dialogue: 0,0:05:40.54,0:05:44.21,Default,,0,0,0,,Бәрінен айырылып, күйзелдім.
Dialogue: 0,0:05:44.97,0:05:48.93,Default,,0,0,0,,Сол кезде кездейсоқ жергілікті жаңалықтардың бір бұрышын көріп қалдым.
Dialogue: 0,0:05:49.01,0:05:49.80,Default,,0,0,0,,Хехе... Сиқырлы қыз.
Dialogue: 0,0:05:49.80,0:05:51.18,Default,,0,0,0,,Хехе... Сиқырлы қыз.
Dialogue: 0,0:05:49.80,0:05:51.18,Default,,0,0,0,,Жұмбақ жанжал бейне
Dialogue: 0,0:05:51.26,0:05:53.68,Default,,0,0,0,,Жазғы жәндік отқа ұшады, енді сен...
Dialogue: 0,0:05:53.77,0:05:54.68,Default,,0,0,0,,Ei
Dialogue: 0,0:05:54.77,0:05:56.14,Default,,0,0,0,,Ахххх
Dialogue: 0,0:05:56.23,0:05:59.19,Default,,0,0,0,,Жарайды... біз әлі әңгіменің ортасындамыз!
Dialogue: 0,0:05:59.27,0:05:59.94,Default,,0,0,0,,(Хроманың айқайы)
Dialogue: 0,0:05:59.94,0:06:02.44,Default,,0,0,0,,(Хроманың айқайы)
Dialogue: 0,0:05:59.94,0:06:02.44,Default,,0,0,0,,Зұлымдықтың қолбасшысы және әділдіктің одақтасы
Dialogue: 0,0:06:03.32,0:06:07.32,Default,,0,0,0,,Мен сізге көбірек ұқсайтынмын.
Dialogue: 0,0:06:08.20,0:06:09.87,Default,,0,0,0,,Әкем…
Dialogue: 0,0:06:11.20,0:06:14.04,Default,,0,0,0,,Мен ебедейсіз, мінезім нашар болса да.
Dialogue: 0,0:06:14.12,0:06:17.46,Default,,0,0,0,,Саған қарасам, таныс сезім пайда болады.
Dialogue: 0,0:06:17.54,0:06:19.08,Default,,0,0,0,,Әкем…
Dialogue: 0,0:06:19.17,0:06:20.71,Default,,0,0,0,,Қажет емес нәрселерді айту
Dialogue: 0,0:06:21.54,0:06:25.63,Default,,0,0,0,,Мен Чизуко-сан қиындық тудырып жатыр ма деп қорықтым.
Dialogue: 0,0:06:26.09,0:06:27.72,Default,,0,0,0,,Бұл негізсіз қорқыныш болды.
Dialogue: 0,0:06:28.22,0:06:29.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:29.84,0:06:33.81,Default,,0,0,0,,Түсіну қиын, бірақ сен қорқынышты адамға ұқсамайсың.
Dialogue: 0,0:06:33.89,0:06:35.93,Default,,0,0,0,,Өте ұқсас болмаса да
Dialogue: 0,0:06:36.02,0:06:37.77,Default,,0,0,0,,«Ол менің кім екенімді де білмейді»
Dialogue: 0,0:06:37.85,0:06:40.77,Default,,0,0,0,,Иә, ол анасына ұқсайды деп ойлаймын.
Dialogue: 0,0:06:40.85,0:06:41.86,Default,,0,0,0,,Бұл
Dialogue: 0,0:06:43.57,0:06:45.98,Default,,0,0,0,,Фотосуретті қалайсыз ба?
Dialogue: 0,0:06:46.07,0:06:47.24,Default,,0,0,0,,Өз қарқыныңызбен жүріңіз!
Dialogue: 0,0:06:47.74,0:06:48.99,Default,,0,0,0,,Маған қарсы емес...
Dialogue: 0,0:06:49.91,0:06:52.45,Default,,0,0,0,,Әрине, бұл жеке ләззат үшін.
Dialogue: 0,0:06:52.53,0:06:55.08,Default,,0,0,0,,Біз оны SNS жүйесіне жүктеп салмаймыз
Dialogue: 0,0:06:55.16,0:06:56.66,Default,,0,0,0,,Уау! Шынымен!
Dialogue: 0,0:06:56.75,0:07:00.46,Default,,0,0,0,,Жоқ, бұл фото...
Dialogue: 0,0:07:01.38,0:07:02.96,Default,,0,0,0,,1+1 деген не?
Dialogue: 0,0:07:03.04,0:07:04.67,Default,,0,0,0,,...
Dialogue: 0,0:07:04.67,0:07:05.96,Default,,0,0,0,,...
Dialogue: 0,0:07:04.67,0:07:05.96,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:05.96,0:07:06.59,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:06.59,0:07:07.46,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:06.59,0:07:07.46,Default,,0,0,0,,Бұл ынта тітіркендіреді.
Dialogue: 0,0:07:07.46,0:07:08.97,Default,,0,0,0,,Бұл ынта тітіркендіреді.
Dialogue: 0,0:07:09.05,0:07:09.84,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:09.84,0:07:10.30,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:09.84,0:07:10.30,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:07:10.30,0:07:11.34,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:07:11.80,0:07:13.72,Default,,0,0,0,,Бұл өте ұқсас.
Dialogue: 0,0:07:13.80,0:07:16.31,Default,,0,0,0,,Иә, ұқсас болды.
Dialogue: 0,0:07:18.02,0:07:20.81,Default,,0,0,0,,Мен үйге енді келдім~
Dialogue: 0,0:07:20.89,0:07:22.60,Default,,0,0,0,,Аю аю...
Dialogue: 0,0:07:22.69,0:07:24.11,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:24.19,0:07:26.86,Default,,0,0,0,,Елдің айналасындағы қабырғалар қалың және қалың.
Dialogue: 0,0:07:26.94,0:07:29.57,Default,,0,0,0,,Маған Go күші әлі жетіспеді.
Dialogue: 0,0:07:29.65,0:07:31.82,Default,,0,0,0,,Аю аю
Dialogue: 0,0:07:33.32,0:07:34.58,Default,,0,0,0,,Аю аю...
Dialogue: 0,0:07:35.41,0:07:36.62,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:07:36.70,0:07:37.91,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:07:38.00,0:07:39.20,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:07:41.17,0:07:43.58,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:07:44.84,0:07:48.26,Default,,0,0,0,,Бірақ үш жақты кездесу мен жоқта өтеді.
Dialogue: 0,0:07:48.34,0:07:50.26,Default,,0,0,0,,Мен мұны білмедім
Dialogue: 0,0:07:50.34,0:07:52.93,Default,,0,0,0,,Хрома-сан, саған қамқор болғаным үшін кешір.
Dialogue: 0,0:07:53.51,0:07:54.68,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:54.76,0:07:58.72,Default,,0,0,0,,Сізге рахмет, мен Читаго датасының жаңа қырын білдім.
Dialogue: 0,0:07:58.81,0:08:00.14,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:08:00.23,0:08:04.40,Default,,0,0,0,,Жаман адамдармен дос болсаң да, олардың жеке өміріне терең бойлама.
Dialogue: 0,0:08:04.48,0:08:06.61,Default,,0,0,0,,Енді не айтуым керек?
Dialogue: 0,0:08:07.07,0:08:08.36,Default,,0,0,0,,Бұл кәмпит өте дәмді.
Dialogue: 0,0:08:09.11,0:08:10.36,Default,,0,0,0,,Тағы бір бөлікті алыңыз.
Dialogue: 0,0:08:10.44,0:08:13.95,Default,,0,0,0,,А, енді ойлап қарасам, бұл менің пошта жәшігіме келді.
Dialogue: 0,0:08:14.03,0:08:15.45,Default,,0,0,0,,Ол Чисатоға арналған.
Dialogue: 0,0:08:16.24,0:08:17.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.83,0:08:20.08,Default,,0,0,0,,Хохо, ақыры келдіңіз бе?
Dialogue: 0,0:08:22.16,0:08:23.33,Default,,0,0,0,,Chroma
Dialogue: 0,0:08:23.87,0:08:25.92,Default,,0,0,0,,Не? бұл карта
Dialogue: 0,0:08:26.59,0:08:28.25,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:08:28.34,0:08:30.51,Default,,0,0,0,,Бұл сізге қызметкер ретінде.
Dialogue: 0,0:08:30.59,0:08:33.59,Default,,0,0,0,,Сиқырды пайдалану кезінде маңызды
Dialogue: 0,0:08:33.68,0:08:34.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:35.01,0:08:38.39,Default,,0,0,0,,Бұл карта күнделікті қалған сиқырлы қуат мөлшерін көрсетеді...
Dialogue: 0,0:08:38.47,0:08:39.60,Default,,0,0,0,,Бір нәрсе
Dialogue: 0,0:08:39.68,0:08:42.56,Default,,0,0,0,,Бұл өте ыңғайлы және бір қарағанда түсінуге оңай.
Dialogue: 0,0:08:42.64,0:08:43.48,Default,,0,0,0,,Хаха
Dialogue: 0,0:08:43.56,0:08:45.27,Default,,0,0,0,,Күлмеңіз және алдамаңыз
Dialogue: 0,0:08:45.35,0:08:46.98,Default,,0,0,0,,Түсіндірме Фува Фуа
Dialogue: 0,0:08:47.56,0:08:50.53,Default,,0,0,0,,Мен қолданбаларды басқара аламын, бірақ
Dialogue: 0,0:08:50.61,0:08:53.03,Default,,0,0,0,,Чизуко Дате смартфоны...
Dialogue: 0,0:08:53.11,0:08:55.61,Default,,0,0,0,,Бұл 5G қолдамайтын ескі үлгі.
Dialogue: 0,0:08:55.70,0:08:57.32,Default,,0,0,0,,Басқа таңдау жоқ.
Dialogue: 0,0:08:58.53,0:09:00.20,Default,,0,0,0,,Ашуланған
Dialogue: 0,0:09:01.16,0:09:02.96,Default,,0,0,0,,Сізде ұпай картасы бар ма?
Dialogue: 0,0:09:03.04,0:09:04.71,Default,,0,0,0,,Иә, ә...
Dialogue: 0,0:09:05.21,0:09:07.25,Default,,0,0,0,,Ал... мен қателесіппін.
Dialogue: 0,0:09:07.33,0:09:08.42,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:08.96,0:09:10.30,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:09:10.38,0:09:12.38,Default,,0,0,0,,Сізге үлкен рахмет~
Dialogue: 0,0:09:17.09,0:09:18.26,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:09:18.35,0:09:21.47,Default,,0,0,0,,Сол жұмбақ карта мені ұятқа қалдырды.
Dialogue: 0,0:09:23.02,0:09:26.27,Default,,0,0,0,,Бұл екінші құпия ма?
Dialogue: 0,0:09:26.35,0:09:28.27,Default,,0,0,0,,Мен қатты ашуландым.
Dialogue: 0,0:09:28.36,0:09:29.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:30.02,0:09:32.03,Default,,0,0,0,,Не… не болды? Сіз
Dialogue: 0,0:09:34.15,0:09:35.70,Default,,0,0,0,,Ол сүйкімді қыз.
Dialogue: 0,0:09:35.78,0:09:37.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:37.11,0:09:39.37,Default,,0,0,0,,Телефоным мен әмиянымды түсіріп алған соң
Dialogue: 0,0:09:39.45,0:09:41.87,Default,,0,0,0,,Мен адасып қалдым.
Dialogue: 0,0:09:41.95,0:09:44.25,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:09:44.96,0:09:46.62,Default,,0,0,0,,Мен саған телефон картамды беремін.
Dialogue: 0,0:09:47.25,0:09:48.83,Default,,0,0,0,,Телефон картасы?
Dialogue: 0,0:09:48.92,0:09:51.55,Default,,0,0,0,,Бұл қоғамдық телефондардан қоңырау шалуға болатын карта.
Dialogue: 0,0:09:51.63,0:09:55.26,Default,,0,0,0,,Апам оны менімен бірге төтенше жағдайға әкелді.
Dialogue: 0,0:09:55.34,0:09:57.13,Default,,0,0,0,,Қаласаңыз, пайдаланыңыз
Dialogue: 0,0:10:00.22,0:10:02.68,Default,,0,0,0,,Рахмет, әпке.
Dialogue: 0,0:10:02.76,0:10:03.89,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:10:03.97,0:10:06.64,Default,,0,0,0,,Қазіргі балалар күлкілі
Dialogue: 0,0:10:08.94,0:10:10.40,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:10:10.48,0:10:12.19,Default,,0,0,0,,Мен сені үйге шақырамын.
Dialogue: 0,0:10:12.27,0:10:13.65,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:10:13.73,0:10:14.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:18.24,0:10:19.45,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:10:20.62,0:10:21.62,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:10:22.99,0:10:25.04,Default,,0,0,0,,Ай тым кішкентай.
Dialogue: 0,0:10:25.87,0:10:29.25,Default,,0,0,0,,Дәл, Кокоа-сама.
Dialogue: 0,0:10:30.00,0:10:31.75,Default,,0,0,0,,Иә? Карта жоқ!
Dialogue: 0,0:10:32.59,0:10:34.00,Default,,0,0,0,,Chroma
Dialogue: 0,0:10:34.09,0:10:36.42,Default,,0,0,0,,Сіз мұнымен нақты не істей аласыз?
Dialogue: 0,0:10:36.51,0:10:39.80,Default,,0,0,0,,Жоооу!?
Dialogue: 0,0:10:41.22,0:10:42.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:42.64,0:10:45.31,Default,,0,0,0,,таң қалдырды
Dialogue: 0,0:10:45.39,0:10:46.56,Default,,0,0,0,,Уфуфу~
Dialogue: 0,0:10:46.56,0:10:48.19,Default,,0,0,0,,Уфуфу~
Dialogue: 0,0:10:46.56,0:10:48.19,Default,,0,0,0,,Осындай қызға!
Dialogue: 0,0:10:48.27,0:10:49.81,Default,,0,0,0,,Бұрынғы бала
Dialogue: 0,0:10:50.27,0:10:51.15,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:10:51.23,0:10:52.86,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,0:10:52.94,0:10:55.36,Default,,0,0,0,,Ниши орта мектебі 2 сынып А сыныбы
Dialogue: 0,0:10:55.44,0:10:58.61,Default,,0,0,0,,және Фосса Магна штабының офицері Данте
Dialogue: 0,0:10:59.49,0:11:01.11,Default,,0,0,0,,Чизуко күні
Dialogue: 0,0:11:02.78,0:11:04.08,Default,,0,0,0,,Бұл бала, мүмкін емес.
Dialogue: 0,0:11:04.16,0:11:07.12,Default,,0,0,0,,Зұлымдық штаб жіберген жаңа өлтіруші ме?
Dialogue: 0,0:11:07.75,0:11:09.71,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:11:13.59,0:11:16.00,Default,,0,0,0,,Сіз кімсіз? сен неге мұндасың
Dialogue: 0,0:11:16.09,0:11:17.21,Default,,0,0,0,,Хехехе
Dialogue: 0,0:11:17.30,0:11:19.17,Default,,0,0,0,,Бейқам бол, Чизуко-сан.
Dialogue: 0,0:11:19.26,0:11:20.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:20.55,0:11:25.06,Default,,0,0,0,,Карточка ұрланған және мекенжай мен жеке ақпарат ұрланған болуы мүмкін.
Dialogue: 0,0:11:25.14,0:11:28.93,Default,,0,0,0,,Сонымен, бұл баланың Фосса Магнамен туысы емес пе?
Dialogue: 0,0:11:29.02,0:11:31.44,Default,,0,0,0,,Менің атым Кокоа.
Dialogue: 0,0:11:31.52,0:11:32.85,Default,,0,0,0,,Кейінірек кездескенше
Dialogue: 0,0:11:33.52,0:11:36.57,Default,,0,0,0,,Айтпақшы, бұл таңқаларлық дәмді.
Dialogue: 0,0:11:37.03,0:11:40.45,Default,,0,0,0,,Мен қарапайым халықтың асын бірінші рет жеп отырмын.
Dialogue: 0,0:11:40.95,0:11:43.87,Default,,0,0,0,,Бұл жоғарғы шай бөлмесінде болды...
Dialogue: 0,0:11:43.95,0:11:45.66,Default,,0,0,0,,Бұл, әрине, жаман қадам.
Dialogue: 0,0:11:46.28,0:11:49.04,Default,,0,0,0,,Мен бұл туралы көптен бері қызықтырдым.
Dialogue: 0,0:11:49.12,0:11:51.92,Default,,0,0,0,,Нанига қаласын жұмбақ күш билейді.
Dialogue: 0,0:11:52.00,0:11:54.63,Default,,0,0,0,,Қызық, оны қандай адамдар пайдаланады?
Dialogue: 0,0:11:56.13,0:11:57.13,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:11:57.92,0:12:00.84,Default,,0,0,0,,Оның мұндай денесі болғанына сене алар емеспін!
Dialogue: 0,0:11:57.92,0:12:00.84,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:12:00.84,0:12:02.01,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:12:02.09,0:12:04.14,Default,,0,0,0,,Жауап беретін сөздер жоқ
Dialogue: 0,0:12:04.22,0:12:05.51,Default,,0,0,0,,Я...
Dialogue: 0,0:12:05.60,0:12:07.64,Default,,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:12:07.72,0:12:10.10,Default,,0,0,0,,Біз қазір бұл базаны аламыз.
Dialogue: 0,0:12:12.19,0:12:13.40,Default,,0,0,0,,Яба Яба Яба
Dialogue: 0,0:12:13.48,0:12:16.82,Default,,0,0,0,,Мен бұл бала сенен гөрі зұлымдықтың көсемі болуға лайықтырақ па, білмеймін.
Dialogue: 0,0:12:16.90,0:12:19.57,Default,,0,0,0,,Жоқ, доғар, Чизуко Дате.
Dialogue: 0,0:12:20.07,0:12:23.32,Default,,0,0,0,,Чизуко сенің айтып тұрғаныңды түсінгеніне қуаныштымын.
Dialogue: 0,0:12:23.41,0:12:26.53,Default,,0,0,0,,Олай болса, алдымен жидек гүлін ұсақтап алайық.
Dialogue: 0,0:12:26.62,0:12:27.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:27.74,0:12:29.04,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:12:29.54,0:12:30.79,Default,,0,0,0,,Өйткені мен
Dialogue: 0,0:12:30.87,0:12:34.46,Default,,0,0,0,,Мен Берри Блоссомды жеңу үшін келген жоқпын.
Dialogue: 0,0:12:34.96,0:12:35.83,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:12:35.92,0:12:36.84,Default,,0,0,0,,Иә
Dialogue: 0,0:12:36.92,0:12:39.46,Default,,0,0,0,,О? Мен оны түсінбеймін
Dialogue: 0,0:12:39.55,0:12:42.47,Default,,0,0,0,,Олай болса, екеуінің де кетуін сұраудан басқа амалымыз қалмайды.
Dialogue: 0,0:12:48.64,0:12:49.72,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:49.81,0:12:51.73,Default,,0,0,0,,Дата Чизуко, абай болыңыз
Dialogue: 0,0:12:51.81,0:12:52.81,Default,,0,0,0,,Бұл карта
Dialogue: 0,0:12:54.19,0:12:55.90,Default,,0,0,0,,Мекен-жайы мен атын білумен қатар
Dialogue: 0,0:12:55.98,0:12:58.44,Default,,0,0,0,,Тіпті сиқырлы күш иесін өзгертуге болады.
Dialogue: 0,0:12:58.52,0:13:01.57,Default,,0,0,0,,Мұның бәрін бір параққа біріктірмеңіз!
Dialogue: 0,0:13:01.65,0:13:04.45,Default,,0,0,0,,Менде осы күш болғанша
Dialogue: 0,0:13:04.53,0:13:07.57,Default,,0,0,0,,Сізде сиқырлы күш жоқ, бұл бұрылыс!
Dialogue: 0,0:13:08.91,0:13:10.70,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:13:11.79,0:13:14.92,Default,,0,0,0,,Сондықтан күшті күш иелері
Dialogue: 0,0:13:15.00,0:13:18.59,Default,,0,0,0,,Ештеңесі жоқ адамға шабуыл жасау шектен шығады.
Dialogue: 0,0:13:19.67,0:13:23.05,Default,,0,0,0,,Егер сізде сол күш болса
Dialogue: 0,0:13:23.13,0:13:26.47,Default,,0,0,0,,Мен де өзімді еркін сезінемін.
Dialogue: 0,0:13:28.18,0:13:29.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:30.31,0:13:32.60,Default,,0,0,0,,Сізге бұл енді қажет емес, солай ма?
Dialogue: 0,0:13:35.81,0:13:36.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.81,0:13:38.06,Default,,0,0,0,,Эй
Dialogue: 0,0:13:41.69,0:13:42.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:42.90,0:13:44.40,Default,,0,0,0,,О... есіңде болсын!
Dialogue: 0,0:13:44.99,0:13:47.91,Default,,0,0,0,,Келесі жолы сені көргенде, сен арзан коньки боласың.
Dialogue: 0,0:13:47.99,0:13:50.08,Default,,0,0,0,,Ай
Dialogue: 0,0:13:50.16,0:13:51.79,Default,,0,0,0,,А, аяқтадың ба?
Dialogue: 0,0:13:51.87,0:13:54.29,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:13:54.79,0:13:57.46,Default,,0,0,0,,Артқы қоймада көптеген қызықты нәрселер бар.
Dialogue: 0,0:13:57.54,0:13:59.79,Default,,0,0,0,,Ракон иттерге арналған тұзақтар болды.
Dialogue: 0,0:13:59.88,0:14:03.09,Default,,0,0,0,,Ууууууууууууууууууууууууууу...
Dialogue: 0,0:14:03.55,0:14:06.38,Default,,0,0,0,,Бағана. ➡
Dialogue: 0,0:14:06.47,0:14:08.09,Default,,0,0,0,,(Кокоаның айқайы)
Dialogue: 0,0:14:08.09,0:14:10.85,Default,,0,0,0,,(Кокоаның айқайы)
Dialogue: 0,0:14:08.09,0:14:10.85,Default,,0,0,0,,Күте тұрыңыз, Кокоа-сама!
Dialogue: 0,0:14:13.10,0:14:14.47,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:14:14.56,0:14:17.06,Default,,0,0,0,,Қыздың құдіретті болғаны сонша, оны жылатып жіберді.
Dialogue: 0,0:14:17.14,0:14:18.81,Default,,0,0,0,,Сіз орындадыңыз, командир.
Dialogue: 0,0:14:18.90,0:14:19.85,Default,,0,0,0,,Иә
Dialogue: 0,0:14:19.94,0:14:21.86,Default,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,0:14:22.36,0:14:24.86,Default,,0,0,0,,Мен саған шабуыл жасаған күні...
Dialogue: 0,0:14:29.95,0:14:31.70,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:14:32.41,0:14:33.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:33.74,0:14:37.00,Default,,0,0,0,,Терема, менде тәттілер таусылды.
Dialogue: 0,0:14:37.62,0:14:40.00,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:14:40.92,0:14:42.29,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:42.38,0:14:45.67,Default,,0,0,0,,NNTV N Префектурасы Нанига қалалық теледидары
Dialogue: 0,0:14:45.76,0:14:49.55,Default,,0,0,0,,Бүгін біз сізге күнделікті өмірде пайдалы болатын жергілікті ақпаратты ұсынамыз.
Dialogue: 0,0:14:49.63,0:14:51.51,Default,,0,0,0,,Біз мұны сізге жіберуге қуаныштымыз.
Dialogue: 0,0:14:52.26,0:14:53.68,Default,,0,0,0,,Бірінші бұрыш
Dialogue: 0,0:14:53.76,0:14:57.52,Default,,0,0,0,,Полицей иті жоғалған котятты табу үшін аянбай еңбек еткені туралы әңгіме
Dialogue: 0,0:14:58.27,0:15:00.90,Default,,0,0,0,,Куку... Менің қызметкерім Данте.
Dialogue: 0,0:15:00.98,0:15:03.44,Default,,0,0,0,,Бір адамға бір қорап жұмыртқа
Dialogue: 0,0:15:03.52,0:15:06.90,Default,,0,0,0,,Екеуміз сонда барып, екі бума сатып аламыз деп ойлайсыңдар ма?
Dialogue: 0,0:15:07.53,0:15:11.41,Default,,0,0,0,,Түсінікті болу үшін, бұл жаман емес, бұл өмірдегі даналық.
Dialogue: 0,0:15:11.49,0:15:14.66,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:14.74,0:15:15.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:16.70,0:15:17.95,Default,,0,0,0,,Кокоа-сама
Dialogue: 0,0:15:18.75,0:15:20.17,Default,,0,0,0,,Сіз...
Dialogue: 0,0:15:20.25,0:15:22.92,Default,,0,0,0,,Кішкентай, жылағаның несі бар?
Dialogue: 0,0:15:23.00,0:15:25.17,Default,,0,0,0,,Өткен күні қуат қайда болды?
Dialogue: 0,0:15:25.25,0:15:27.55,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:15:27.63,0:15:28.72,Default,,0,0,0,,Бяаааааааааа!
Dialogue: 0,0:15:28.72,0:15:30.47,Default,,0,0,0,,Бяаааааааа!
Dialogue: 0,0:15:28.72,0:15:30.47,Default,,0,0,0,,Бұл жерде күрсінбеңіз.
Dialogue: 0,0:15:30.55,0:15:32.97,Default,,0,0,0,,Немесе... Маңызды емес.
Dialogue: 0,0:15:33.05,0:15:34.30,Default,,0,0,0,,Ай
Dialogue: 0,0:15:34.39,0:15:36.39,Default,,0,0,0,,Дәл, Кокоа-сама.
Dialogue: 0,0:15:36.47,0:15:38.77,Default,,0,0,0,,Сүйікті тұлыпыңызды жоғалтып алдыңыз ба?
Dialogue: 0,0:15:38.85,0:15:40.60,Default,,0,0,0,,Оның оларға қатысы жоқ... (Шинья) Цуки!
Dialogue: 0,0:15:40.69,0:15:42.60,Default,,0,0,0,,Мен онсыз ұйықтай алмаймын
Dialogue: 0,0:15:42.69,0:15:45.44,Default,,0,0,0,,Ай! Мен бәрін айттым!
Dialogue: 0,0:15:45.52,0:15:47.82,Default,,0,0,0,,Сіз баласыз ба?
Dialogue: 0,0:15:47.90,0:15:49.32,Default,,0,0,0,,Ааааааааааа!
Dialogue: 0,0:15:49.40,0:15:51.07,Default,,0,0,0,,Сондықтан тоқтатыңыз.
Dialogue: 0,0:15:51.95,0:15:54.66,Default,,0,0,0,,Бұл маңызды, солай ма?
Dialogue: 0,0:15:56.99,0:16:00.00,Default,,0,0,0,,Бұл маңызды, бірақ... маңызды емес.
Dialogue: 0,0:16:00.66,0:16:01.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:01.62,0:16:02.92,Default,,0,0,0,,Тончика?
Dialogue: 0,0:16:03.00,0:16:05.75,Default,,0,0,0,,Әкең туралы... иә?
Dialogue: 0,0:16:06.59,0:16:08.25,Default,,0,0,0,,Менің жұмыс берушім
Dialogue: 0,0:16:08.34,0:16:10.80,Default,,0,0,0,,Мотой Кокоа-саманың әкесі
Dialogue: 0,0:16:10.88,0:16:14.76,Default,,0,0,0,,Жұмысқа байланысты үйге жете алмаймын.
Dialogue: 0,0:16:14.84,0:16:18.31,Default,,0,0,0,,Тұлыпты маған әкем берген.
Dialogue: 0,0:16:18.39,0:16:22.02,Default,,0,0,0,,Кокоа мырза оны аяқтай алмайтындай сезінеді.
Dialogue: 0,0:16:24.94,0:16:26.82,Default,,0,0,0,,Кішкентай, ол туралы ше?
Dialogue: 0,0:16:28.61,0:16:29.98,Default,,0,0,0,,Ах
Dialogue: 0,0:16:30.69,0:16:31.99,Default,,0,0,0,,Алайда желдің жоғары жылдамдықпен сығылуы кезінде пайда болатын үйкеліс пен жылу —
Dialogue: 0,0:16:34.03,0:16:36.37,Default,,0,0,0,,Қарғыс атсын... кішкентай күшік.
Dialogue: 0,0:16:36.45,0:16:38.83,Default,,0,0,0,,Менен жамандық жасама
Dialogue: 0,0:16:41.33,0:16:42.75,Default,,0,0,0,,Не? Ах
Dialogue: 0,0:16:42.83,0:16:44.50,Default,,0,0,0,,Ах! (Чизуко) Уау!
Dialogue: 0,0:16:46.17,0:16:47.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:48.00,0:16:49.71,Default,,0,0,0,,Өте тар жерде...
Dialogue: 0,0:16:49.80,0:16:52.09,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:16:52.17,0:16:54.05,Default,,0,0,0,,Жоқ... бұл жақсы.
Dialogue: 0,0:16:54.13,0:16:56.51,Default,,0,0,0,,Мен оны лақтырамын.
Dialogue: 0,0:16:57.01,0:16:58.01,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:16:58.10,0:16:59.85,Default,,0,0,0,,Аю құбыжығы
Dialogue: 0,0:16:59.93,0:17:01.02,Default,,0,0,0,,Аю
Dialogue: 0,0:17:01.10,0:17:03.44,Default,,0,0,0,,Арық қақпағын алыңыз.
Dialogue: 0,0:17:03.52,0:17:04.52,Default,,0,0,0,,Аю
Dialogue: 0,0:17:04.60,0:17:05.52,Default,,0,0,0,,Болу…
Dialogue: 0,0:17:05.60,0:17:08.02,Default,,0,0,0,,Аю~
Dialogue: 0,0:17:10.19,0:17:11.19,Default,,0,0,0,,Ах
Dialogue: 0,0:17:11.90,0:17:14.07,Default,,0,0,0,,Ал... күте тұрыңыз, менің...
Dialogue: 0,0:17:19.66,0:17:21.95,Default,,0,0,0,,Оның болғаны жақсы емес пе?
Dialogue: 0,0:17:22.04,0:17:24.46,Default,,0,0,0,,Босатпаңыз
Dialogue: 0,0:17:24.54,0:17:26.92,Default,,0,0,0,,Бұл медуза.
Dialogue: 0,0:17:28.04,0:17:30.59,Default,,0,0,0,,Бұл медуза емес, бұл медуза.
Dialogue: 0,0:17:31.13,0:17:33.84,Default,,0,0,0,,О, түсіндім. Мысықтың құлағы?
Dialogue: 0,0:17:34.42,0:17:36.84,Default,,0,0,0,,Әй... Рахмет айтпаймын.
Dialogue: 0,0:17:37.39,0:17:39.85,Default,,0,0,0,,Хатена? Әрине
Dialogue: 0,0:17:39.93,0:17:42.52,Default,,0,0,0,,Мен тек жамандық жасадым.
Dialogue: 0,0:17:43.85,0:17:44.77,Default,,0,0,0,,Хун
Dialogue: 0,0:17:44.85,0:17:47.40,Default,,0,0,0,,Мүмкін бір жерде тағы кездесерміз.
Dialogue: 0,0:17:47.48,0:17:48.98,Default,,0,0,0,,Командир...
Dialogue: 0,0:17:50.11,0:17:51.27,Default,,0,0,0,,О
Dialogue: 0,0:17:51.36,0:17:52.90,Default,,0,0,0,,Chroma...
Dialogue: 0,0:17:52.98,0:17:56.28,Default,,0,0,0,,Сіз Кокоа-чан үшін жолыңыздан шықтыңыз.
Dialogue: 0,0:17:56.36,0:17:57.99,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:17:58.07,0:18:01.24,Default,,0,0,0,,Жамандық деп, мұндай жамандық жасамас едім.
Dialogue: 0,0:18:02.04,0:18:04.20,Default,,0,0,0,,Бардың ба? Бардың ба?
Dialogue: 0,0:18:04.29,0:18:05.12,Default,,0,0,0,,Иә
Dialogue: 0,0:18:05.21,0:18:07.17,Default,,0,0,0,,Егер сіз оны жалғыз қалдырсаңыз, бұл өте қауіпті.
Dialogue: 0,0:18:07.25,0:18:09.04,Default,,0,0,0,,Тез арада бекіту керек, тек суағарда
Dialogue: 0,0:18:09.13,0:18:09.50,Default,,0,0,0,,Мен оны жөндей бастадым.
Dialogue: 0,0:18:09.50,0:18:10.67,Default,,0,0,0,,Мен оны жөндей бастадым.
Dialogue: 0,0:18:09.50,0:18:10.67,Default,,0,0,0,,Дереу!
Dialogue: 0,0:18:10.75,0:18:11.46,Default,,0,0,0,,Бірақ ауыр арықтар
Dialogue: 0,0:18:11.46,0:18:13.09,Default,,0,0,0,,Бірақ ауыр арықтар
Dialogue: 0,0:18:11.46,0:18:13.09,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен саған көмектесейін бе?
Dialogue: 0,0:18:13.09,0:18:13.17,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен саған көмектесейін бе?
Dialogue: 0,0:18:13.17,0:18:14.42,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен саған көмектесейін бе?
Dialogue: 0,0:18:13.17,0:18:14.42,Default,,0,0,0,,Дата картасы бала!
Dialogue: 0,0:18:14.51,0:18:14.92,Default,,0,0,0,,Е, ауыр
Dialogue: 0,0:18:14.92,0:18:15.80,Default,,0,0,0,,Е, ауыр
Dialogue: 0,0:18:14.92,0:18:15.80,Default,,0,0,0,,Аю?
Dialogue: 0,0:18:19.26,0:18:20.64,Default,,0,0,0,,Аю аю
Dialogue: 0,0:18:20.72,0:18:21.72,Default,,0,0,0,,Иә? (Кума монстры) Аю
Dialogue: 0,0:18:21.81,0:18:23.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:24.27,0:18:26.02,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:18:34.61,0:18:36.36,Default,,0,0,0,,Біраз адам келді.
Dialogue: 0,0:18:36.44,0:18:40.32,Default,,0,0,0,,Мен ғана келер ме деп едім.
Dialogue: 0,0:18:41.12,0:18:44.04,Default,,0,0,0,,Бұл құдайдың оқиғасы қандай?
Dialogue: 0,0:18:45.58,0:18:48.04,Default,,0,0,0,,Бұл ешкім келмейтін үлгі.
Dialogue: 0,0:18:48.12,0:18:50.79,Default,,0,0,0,,Сакура болып бірге көңіл көтерейік!
Dialogue: 0,0:18:51.33,0:18:54.50,Default,,0,0,0,,Жоқ. Сіз қате адамнан сұрап жатырсыз ба?
Dialogue: 0,0:18:54.59,0:18:56.59,Default,,0,0,0,,Мен бармаймын.
Dialogue: 0,0:19:01.09,0:19:03.97,Default,,0,0,0,,Соңында Хрома келмеді.
Dialogue: 0,0:19:04.06,0:19:07.35,Default,,0,0,0,,Егер бұлай болса, бұл қиынырақ емес пе?
Dialogue: 0,0:19:10.19,0:19:12.52,Default,,0,0,0,,А, Дантенің қызы?
Dialogue: 0,0:19:13.23,0:19:14.48,Default,,0,0,0,,Маширо мырза
Dialogue: 0,0:19:14.57,0:19:17.86,Default,,0,0,0,,Мына қалам шамы, өтінемін.
Dialogue: 0,0:19:17.94,0:19:19.57,Default,,0,0,0,,Не? А... аа
Dialogue: 0,0:19:20.24,0:19:23.24,Default,,0,0,0,,Әйтеуір, неге мұндай оқиға?
Dialogue: 0,0:19:23.32,0:19:26.20,Default,,0,0,0,,А, бұл не екеніне таңғаламын...
Dialogue: 0,0:19:26.29,0:19:28.45,Default,,0,0,0,,Шынымды айтсам, бұл менің эгоым ғана.
Dialogue: 0,0:19:29.21,0:19:32.00,Default,,0,0,0,,Сізді жақтайтын адамдар өте көп.
Dialogue: 0,0:19:32.08,0:19:34.88,Default,,0,0,0,,Мен Берриге айтқым келді.
Dialogue: 0,0:19:35.38,0:19:36.84,Default,,0,0,0,,Маширо-сан…
Dialogue: 0,0:19:36.92,0:19:40.26,Default,,0,0,0,,Дәлірек айтсақ, мен әлі де осы оқиғаны ойлап жүрмін.
Dialogue: 0,0:19:40.34,0:19:42.97,Default,,0,0,0,,Мен оған бұлай айта алмаймын.
Dialogue: 0,0:19:43.05,0:19:44.97,Default,,0,0,0,,Бұл жаман емес пе?
Dialogue: 0,0:19:43.05,0:19:44.97,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:19:45.05,0:19:48.93,Default,,0,0,0,,А, мен саған түрленіп, Ниши саябағына кел дедім ғой...
Dialogue: 0,0:19:49.02,0:19:50.52,Default,,0,0,0,,Маширо!
Dialogue: 0,0:19:50.60,0:19:52.19,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:52.27,0:19:54.69,Default,,0,0,0,,Абаба жидек гүлі!
Dialogue: 0,0:19:52.27,0:19:54.69,Default,,0,0,0,,(Питбуль) Э? (Доберман) Э?
Dialogue: 0,0:19:55.23,0:19:57.78,Default,,0,0,0,,Мен мүлде ештеңе түсінбеймін бе?
Dialogue: 0,0:19:58.28,0:19:59.82,Default,,0,0,0,,Бұл зұлым ұйым.
Dialogue: 0,0:19:59.90,0:20:02.28,Default,,0,0,0,,Мама аю құбыжық сүйкімді
Dialogue: 0,0:20:03.11,0:20:04.49,Default,,0,0,0,,Chroma?
Dialogue: 0,0:20:04.57,0:20:06.33,Default,,0,0,0,,Неге мұндасың...
Dialogue: 0,0:20:06.78,0:20:09.50,Default,,0,0,0,,Хмм, бұл орын ма?
Dialogue: 0,0:20:10.00,0:20:12.08,Default,,0,0,0,,Chroma...қол алысу...
Dialogue: 0,0:20:12.17,0:20:13.63,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:20:13.71,0:20:16.42,Default,,0,0,0,,Сізді шатастырып алғаным үшін кешіріңіз.
Dialogue: 0,0:20:16.50,0:20:18.05,Default,,0,0,0,,Маширо мырза, түсіндіріп беріңізші...
Dialogue: 0,0:20:18.55,0:20:19.51,Default,,0,0,0,,Уау
Dialogue: 0,0:20:19.59,0:20:22.05,Default,,0,0,0,,Өңдеу тым көп ақпаратқа байланысты қатып қалады!?
Dialogue: 0,0:20:22.84,0:20:25.09,Default,,0,0,0,,Қол алысу шарасы болды.
Dialogue: 0,0:20:25.18,0:20:26.01,Default,,0,0,0,,...
Dialogue: 0,0:20:26.10,0:20:28.01,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:20:28.10,0:20:31.64,Default,,0,0,0,,Олай болса, қолымды қысуға рұқсат ете аламын ба?
Dialogue: 0,0:20:31.73,0:20:33.65,Default,,0,0,0,,Егер істейтін болсаң, бері бер, байқап көр
Dialogue: 0,0:20:33.73,0:20:37.65,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:20:37.73,0:20:39.40,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:39.48,0:20:41.15,Default,,0,0,0,,Seaaaaaaaaaaaaaa!
Dialogue: 0,0:20:41.24,0:20:43.15,Default,,0,0,0,,Білек құлпы!?
Dialogue: 0,0:20:43.24,0:20:45.16,Default,,0,0,0,,Ой! ол аурады!
Dialogue: 0,0:20:45.82,0:20:48.16,Default,,0,0,0,,Хрома мырза, сіз күткендей келдіңіз.
Dialogue: 0,0:20:45.82,0:20:48.16,Default,,0,0,0,,Ааа, ауырып тұр!
Dialogue: 0,0:20:48.24,0:20:48.70,Default,,0,0,0,,Әй, білегім!
Dialogue: 0,0:20:48.70,0:20:50.29,Default,,0,0,0,,Әй, білегім!
Dialogue: 0,0:20:48.70,0:20:50.29,Default,,0,0,0,,Бұл көрініс шынымен де жігерлендіреді.
Dialogue: 0,0:20:50.29,0:20:50.37,Default,,0,0,0,,Бұл көрініс шынымен де жігерлендіреді.
Dialogue: 0,0:20:50.37,0:20:52.41,Default,,0,0,0,,Бұл көрініс шынымен де жігерлендіреді.
Dialogue: 0,0:20:50.37,0:20:52.41,Default,,0,0,0,,Ааааах!
Dialogue: 0,0:20:52.41,0:20:52.91,Default,,0,0,0,,Ааааах!
Dialogue: 0,0:20:53.00,0:20:53.46,Default,,0,0,0,,А, жоқ, енді жоқ!
Dialogue: 0,0:20:53.46,0:20:56.46,Default,,0,0,0,,А, жоқ, енді жоқ!
Dialogue: 0,0:20:53.46,0:20:56.46,Default,,0,0,0,,Хмф, сіздің денеңіз қандай?
Dialogue: 0,0:20:56.46,0:20:56.54,Default,,0,0,0,,А, жоқ, енді жоқ!
Dialogue: 0,0:20:56.54,0:20:57.17,Default,,0,0,0,,А, жоқ, енді жоқ!
Dialogue: 0,0:20:56.54,0:20:57.17,Default,,0,0,0,,Көңіліңізден шыққаныңызға қуаныштымын, Кокоа-сама.
Dialogue: 0,0:20:57.17,0:20:57.25,Default,,0,0,0,,Сенің бақытты болғаныңа қуаныштымын, Кокоа-сама.
Dialogue: 0,0:20:57.25,0:20:59.55,Default,,0,0,0,,Сенің бақытты болғаныңа қуаныштымын, Кокоа-сама.
Dialogue: 0,0:20:57.25,0:20:59.55,Default,,0,0,0,,Ах, керісінше... Ах
Dialogue: 0,0:20:59.55,0:21:00.55,Default,,0,0,0,,Ах, керісінше... Ах.
Dialogue: 0,0:21:00.63,0:21:01.88,Default,,0,0,0,,Айтатата!
Dialogue: 0,0:21:01.97,0:21:03.55,Default,,0,0,0,,Жоқ! Жоқ, жоқ, жоқ!
Dialogue: 0,0:21:03.63,0:21:05.22,Default,,0,0,0,,Уау... бұл ауырады
Dialogue: 0,0:21:05.30,0:21:06.80,Default,,0,0,0,,Беріңіз Бер бер!
Dialogue: 0,0:21:06.89,0:21:08.30,Default,,0,0,0,,Бұл сындырады Ол бұзылады!
Dialogue: 0,0:21:08.39,0:21:09.81,Default,,0,0,0,,Бұл шынымен бұзылады!
Dialogue: 0,0:21:09.89,0:21:12.60,Default,,0,0,0,,Жарайсың, әділдік одақтасы!
Dialogue: 0,0:21:14.10,0:21:16.52,Default,,0,0,0,,Хрома Неге келдің?
Dialogue: 0,0:21:16.60,0:21:18.31,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:21:18.40,0:21:22.19,Default,,0,0,0,,Мені шақырған сенің эгоың болды ма?
Dialogue: 0,0:21:22.28,0:21:24.36,Default,,0,0,0,,Иә, бұл эго.
Dialogue: 0,0:21:24.45,0:21:27.66,Default,,0,0,0,,Берри шараға ешкім келмегендіктен көңілі күйзелді.
Dialogue: 0,0:21:27.74,0:21:29.20,Default,,0,0,0,,Мен оны көргім келмеді
Dialogue: 0,0:21:29.28,0:21:30.95,Default,,0,0,0,,Жаман ба?
Dialogue: 0,0:21:35.67,0:21:36.92,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:21:39.25,0:21:42.38,Default,,0,0,0,,Маған өзімшіл ойлаудың түрі ұнайды.
Dialogue: 0,0:21:43.17,0:21:44.22,Default,,0,0,0,,Chroma...
Dialogue: 0,0:21:44.30,0:21:45.13,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:21:46.30,0:21:48.85,Default,,0,0,0,,Соңында сендермен қол алыса алмағаныма көңілім қалды.
Dialogue: 0,0:21:49.35,0:21:50.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:51.14,0:21:52.60,Default,,0,0,0,,Көңілсіз қалмаңыз
Dialogue: 0,0:21:52.68,0:21:54.64,Default,,0,0,0,,Мен мұны істеймін бе? қол алысу
Dialogue: 0,0:21:54.73,0:21:55.69,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:21:58.60,0:21:59.65,Default,,0,0,0,,Қайтару
Dialogue: 0,0:22:04.94,0:22:07.20,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.49,0:23:34.87,Default,,0,0,0,,～♪
