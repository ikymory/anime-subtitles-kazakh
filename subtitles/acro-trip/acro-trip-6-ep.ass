Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.42,0:00:04.79,Default,,0,0,0,,үшін үй тапсырмасын орындады ма?
Dialogue: 0,0:00:04.88,0:00:06.25,Default,,0,0,0,,Уа!
Dialogue: 0,0:00:06.88,0:00:08.88,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:00:09.34,0:00:12.47,Default,,0,0,0,,О? Хрома-кун, сен әлі осындасың ба?
Dialogue: 0,0:00:12.55,0:00:14.80,Default,,0,0,0,,Ертеңге дейін жазыңыз.
Dialogue: 0,0:00:16.05,0:00:17.68,Default,,0,0,0,,Болашақтың армандары...
Dialogue: 0,0:00:19.14,0:00:21.93,Default,,0,0,0,,Неліктен менің армандарым қазір орындала алмайды?
Dialogue: 0,0:00:22.02,0:00:24.85,Default,,0,0,0,,Мен болашақ туралы ойлауым керек.
Dialogue: 0,0:00:25.86,0:00:27.65,Default,,0,0,0,,Сәлем сен!
Dialogue: 0,0:00:27.73,0:00:29.86,Default,,0,0,0,,Бұл менің орным.
Dialogue: 0,0:00:29.94,0:00:31.53,Default,,0,0,0,,Кенеттен...
Dialogue: 0,0:00:31.61,0:00:33.49,Default,,0,0,0,,Жоқ, мен осы жолы шындап тұрмын! Жоғарғы қабатта өлі дене жатыр.
Dialogue: 0,0:00:33.57,0:00:35.95,Default,,0,0,0,,Көрмедім деуден аулақ бол!
Dialogue: 0,0:00:36.62,0:00:39.37,Default,,0,0,0,,Сен көрші сыныпта жалғызсың.
Dialogue: 0,0:00:40.24,0:00:41.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:41.33,0:00:43.71,Default,,0,0,0,,Ой, мен әлі жазған жоқпын.
Dialogue: 0,0:00:43.79,0:00:44.62,Default,,0,0,0,,Ақсақ
Dialogue: 0,0:00:45.12,0:00:48.13,Default,,0,0,0,,Қандай тамаша дүниелер жаздыңыз?
Dialogue: 0,0:00:49.75,0:00:50.76,Default,,0,0,0,,Мен оны… есептей алмаймын.
Dialogue: 0,0:00:52.05,0:00:53.30,Default,,0,0,0,,Өз баламды ешқашан қателеспес едім.
Dialogue: 0,0:00:55.68,0:00:58.22,Default,,0,0,0,,Кез келген нәрсені плагиат жасауға болады.
Dialogue: 0,0:00:58.30,0:01:01.81,Default,,0,0,0,,Өйткені менің денем үлкен
Dialogue: 0,0:01:02.43,0:01:04.35,Default,,0,0,0,,Уау...
Dialogue: 0,0:01:04.44,0:01:06.27,Default,,0,0,0,,Эй, мен сені естімеймін!
Dialogue: 0,0:01:06.35,0:01:08.77,Default,,0,0,0,,Сіз қатыгездікпен айтып тұрған сияқтысыз.
Dialogue: 0,0:01:08.86,0:01:12.57,Default,,0,0,0,,Зұлымдықтың көшбасшысы шындық емес, ойдан шығарылған...
Dialogue: 0,0:01:12.65,0:01:13.94,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:01:14.03,0:01:17.36,Default,,0,0,0,,Мен арманшыл балаға ұқсаймын ба?
Dialogue: 0,0:01:17.45,0:01:18.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:18.78,0:01:20.24,Default,,0,0,0,,Бар
Dialogue: 0,0:01:20.33,0:01:21.74,Default,,0,0,0,,Зұлым ұйым
Dialogue: 0,0:01:21.83,0:01:23.33,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:01:23.41,0:01:24.71,Default,,0,0,0,,А...
Dialogue: 0,0:01:24.79,0:01:27.17,Default,,0,0,0,,Уа, сен мені ұстап алдың.
Dialogue: 0,0:01:27.25,0:01:28.88,Default,,0,0,0,,Сіз мұны да білесіз бе?
Dialogue: 0,0:01:28.96,0:01:30.88,Default,,0,0,0,,Omizo Technica деп аталған компания.
Dialogue: 0,0:01:30.96,0:01:33.71,Default,,0,0,0,,Мен шынымен түсінбеймін. Бұл шағын бизнес емес пе?
Dialogue: 0,0:01:33.80,0:01:35.59,Default,,0,0,0,,Шамасы
Dialogue: 0,0:01:35.67,0:01:39.22,Default,,0,0,0,,Бірақ олар сахнаның артында көптеген зерттеулер жүргізеді деген қауесеттер бар.
Dialogue: 0,0:01:39.30,0:01:41.93,Default,,0,0,0,,Дүниені билейтін бір күні
Dialogue: 0,0:01:43.52,0:01:45.39,Default,,0,0,0,,Мен сонда кіремін
Dialogue: 0,0:01:45.48,0:01:47.44,Default,,0,0,0,,Кіріңіз де, барыңызды беріңіз.
Dialogue: 0,0:01:47.52,0:01:49.98,Default,,0,0,0,,Бұл зұлымдық болғанша!
Dialogue: 0,0:01:50.06,0:01:51.98,Default,,0,0,0,,Бас қолбасшы бол!
Dialogue: 0,0:01:52.44,0:01:53.44,Default,,0,0,0,,Және...
Dialogue: 0,0:01:53.53,0:01:54.36,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:55.40,0:01:57.24,Default,,0,0,0,,Бұл кезде
Dialogue: 0,0:01:57.70,0:02:00.03,Default,,0,0,0,,Біреу келіп тоқтай ма?
Dialogue: 0,0:02:01.37,0:02:04.37,Default,,0,0,0,,Маған қамқорлық жасауға келесің бе?
Dialogue: 0,0:02:05.83,0:02:07.08,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:02:07.16,0:02:09.08,Default,,0,0,0,,Сіз өте ынталысыз.
Dialogue: 0,0:02:09.17,0:02:11.34,Default,,0,0,0,,Мені өзіңе бағынышты қылсаң бәрібір...
Dialogue: 0,0:02:11.42,0:02:13.00,Default,,0,0,0,,Наранай (Машима) ше?
Dialogue: 0,0:02:13.46,0:02:14.59,Default,,0,0,0,,Ой
Dialogue: 0,0:02:15.38,0:02:17.72,Default,,0,0,0,,Мен саған бағынышты болмаймын.
Dialogue: 0,0:02:17.80,0:02:19.09,Default,,0,0,0,,Иә!?
Dialogue: 0,0:02:22.64,0:02:24.60,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:24.68,0:02:26.85,Default,,0,0,0,,Ма-кун, мен үйге бара жатырмын.
Dialogue: 0,0:02:26.93,0:02:28.98,Default,,0,0,0,,Тітіркендіргіш Ка Чан!
Dialogue: 0,0:02:29.06,0:02:31.44,Default,,0,0,0,,Енді кеттік!
Dialogue: 0,0:02:34.82,0:02:36.24,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:02:39.28,0:02:41.16,Default,,0,0,0,,Менің...
Dialogue: 0,0:02:41.78,0:02:42.87,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:02:43.78,0:02:45.24,Default,,0,0,0,,Менің арманым
Dialogue: 0,0:02:45.33,0:02:47.87,Default,,0,0,0,,Жамандықтың қожасы болу.
Dialogue: 0,0:02:49.08,0:02:51.04,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:02:52.59,0:02:56.13,Default,,0,0,0,,Сенің жүзіңді бірінші рет көруім.
Dialogue: 0,0:02:56.59,0:02:58.51,Default,,0,0,0,,Бірақ... Сәттілік.
Dialogue: 0,0:02:58.59,0:02:59.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:01.68,0:03:02.80,Default,,0,0,0,,Иә
Dialogue: 0,0:03:03.64,0:03:04.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:05.31,0:03:06.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:06.64,0:03:10.56,Default,,0,0,0,,Бұл, әрине, менің азғындығымның нәтижесі.
Dialogue: 0,0:03:11.19,0:03:12.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:12.69,0:03:17.94,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:18.03,0:03:22.57,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:03:24.78,0:03:28.04,Default,,0,0,0,,Хохо Сіз қайсысысыз?
Dialogue: 0,0:03:28.50,0:03:31.21,Default,,0,0,0,,Иә, бұл бұлшықет.
Dialogue: 0,0:03:32.00,0:03:36.75,Default,,0,0,0,,♪～
Dialogue: 0,0:04:59.29,0:05:01.88,Default,,0,0,0,,～♪
Dialogue: 0,0:05:03.05,0:05:03.80,Default,,0,0,0,,Иә
Dialogue: 0,0:05:03.80,0:05:04.17,Default,,0,0,0,,Иә
Dialogue: 0,0:05:03.80,0:05:04.17,Default,,0,0,0,,Бұл Чизуко күні.
Dialogue: 0,0:05:04.17,0:05:05.30,Default,,0,0,0,,Бұл Чизуко күні.
Dialogue: 0,0:05:05.38,0:05:05.93,Default,,0,0,0,,Жамандықтың кеңесшісі болсам да.
Dialogue: 0,0:05:05.93,0:05:07.05,Default,,0,0,0,,Жамандықтың кеңесшісі болсам да.
Dialogue: 0,0:05:05.93,0:05:07.05,Default,,0,0,0,,Иә
Dialogue: 0,0:05:07.05,0:05:07.47,Default,,0,0,0,,Жамандықтың кеңесшісі болсам да.
Dialogue: 0,0:05:07.55,0:05:08.60,Default,,0,0,0,,Тыңдау менің хоббиім емес...
Dialogue: 0,0:05:08.60,0:05:09.97,Default,,0,0,0,,Тыңдау менің хоббиім емес...
Dialogue: 0,0:05:08.60,0:05:09.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:09.97,0:05:10.81,Default,,0,0,0,,Тыңдау менің хоббиім емес...
Dialogue: 0,0:05:11.27,0:05:12.27,Default,,0,0,0,,Онда мен сізді арттан сәл итермелеуге тура келеді —
Dialogue: 0,0:05:12.85,0:05:15.85,Default,,0,0,0,,Біз кемшіліктерді толық білеміз.
Dialogue: 0,0:05:16.31,0:05:18.86,Default,,0,0,0,,Міндетті түрде...
Dialogue: 0,0:05:18.94,0:05:19.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:19.86,0:05:21.53,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:05:21.61,0:05:23.28,Default,,0,0,0,,Мен мұны әлі де істей аламын!
Dialogue: 0,0:05:24.15,0:05:29.03,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:05:29.12,0:05:31.45,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:05:31.54,0:05:32.70,Default,,0,0,0,,Бас кеңсе! Эхх штаб!
Dialogue: 0,0:05:32.70,0:05:34.41,Default,,0,0,0,,Штаб! Эхх штаб!
Dialogue: 0,0:05:32.70,0:05:34.41,Default,,0,0,0,,Жоқ...не істеуім керек?
Dialogue: 0,0:05:35.29,0:05:37.08,Default,,0,0,0,,Ум, Chroma...
Dialogue: 0,0:05:37.17,0:05:38.38,Default,,0,0,0,,Куку…
Dialogue: 0,0:05:38.46,0:05:41.09,Default,,0,0,0,,Бүгін тағы барып, қаланы қараңғылықпен қаптаймыз ба?
Dialogue: 0,0:05:41.17,0:05:42.96,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:05:43.05,0:05:45.01,Default,,0,0,0,,Сіз оның сырғып кетуіне жол беремін деп ойладыңыз ба?
Dialogue: 0,0:05:45.09,0:05:46.34,Default,,0,0,0,,Хун
Dialogue: 0,0:05:47.76,0:05:49.43,Default,,0,0,0,,Бұл – Зерттеу корпусы.
Dialogue: 0,0:05:49.51,0:05:52.22,Default,,0,0,0,,Айыптау тікелей штабтан қойылды.
Dialogue: 0,0:05:52.31,0:05:56.44,Default,,0,0,0,,Бұл оның сай келмейтінін білдіре ме...
Dialogue: 0,0:05:56.89,0:06:00.06,Default,,0,0,0,,Жамандықтың көсеміне ұқсамағандықтан ба?
Dialogue: 0,0:06:00.15,0:06:02.94,Default,,0,0,0,,Кана Кана Кана...
Dialogue: 0,0:06:03.03,0:06:05.57,Default,,0,0,0,,Мен оны сағындым, Чизуко Дате!
Dialogue: 0,0:06:05.65,0:06:08.03,Default,,0,0,0,,О, күте тұрыңыз... Chroma?
Dialogue: 0,0:06:08.11,0:06:11.20,Default,,0,0,0,,Бағана. ➡
Dialogue: 0,0:06:11.28,0:06:13.33,Default,,0,0,0,,Штабтан сөгіс
Dialogue: 0,0:06:14.24,0:06:18.08,Default,,0,0,0,,Мен оның бұл жолы қаланы тастап кетеді деп ойламаппын...
Dialogue: 0,0:06:19.50,0:06:21.00,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:06:21.09,0:06:24.30,Default,,0,0,0,,Жарайды, қарның ашқанда қайтасың.
Dialogue: 0,0:06:24.38,0:06:25.92,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:06:27.17,0:06:29.26,Default,,0,0,0,,Қазірдің өзінде? Ерте емес пе?
Dialogue: 0,0:06:29.97,0:06:31.43,Default,,0,0,0,,Қайта қош келдіңіз Куро…
Dialogue: 0,0:06:31.51,0:06:32.51,Default,,0,0,0,,Ма
Dialogue: 0,0:06:33.06,0:06:33.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:33.97,0:06:37.52,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:06:37.60,0:06:40.52,Default,,0,0,0,,Сіз қайсысысыз?
Dialogue: 0,0:06:40.60,0:06:44.19,Default,,0,0,0,,Мен жаңа командирмін, Хью.
Dialogue: 0,0:06:44.27,0:06:46.53,Default,,0,0,0,,Бұл ағынды қара реңк
Dialogue: 0,0:06:46.61,0:06:47.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:48.03,0:06:50.91,Default,,0,0,0,,Тікенектей лақап аты бар қауіпті адамдар бар.
Dialogue: 0,0:06:50.99,0:06:54.24,Default,,0,0,0,,Ойлағанның бәрін айтпа, қызым.
Dialogue: 0,0:06:54.33,0:06:55.87,Default,,0,0,0,,Тым адал
Dialogue: 0,0:06:55.95,0:06:57.37,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:57.91,0:06:59.79,Default,,0,0,0,,Не? Күте тұрыңыз
Dialogue: 0,0:06:59.87,0:07:02.38,Default,,0,0,0,,Жаңа командир дедіңіз бе?
Dialogue: 0,0:07:02.46,0:07:04.63,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:07:04.71,0:07:05.96,Default,,0,0,0,,Шынында да
Dialogue: 0,0:07:06.05,0:07:07.63,Default,,0,0,0,,Үлпілдек хромның орнына
Dialogue: 0,0:07:07.71,0:07:11.05,Default,,0,0,0,,Нанига қаласын, N префектурасын қорқынышпен басқару үшін.
Dialogue: 0,0:07:11.14,0:07:13.64,Default,,0,0,0,,Штабтан жіберілді.
Dialogue: 0,0:07:15.47,0:07:18.81,Default,,0,0,0,,Ақырында әлемді билеу үшін.
Dialogue: 0,0:07:18.89,0:07:20.39,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:07:20.48,0:07:22.10,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:07:20.48,0:07:22.10,Default,,0,0,0,,(Хью күлді)
Dialogue: 0,0:07:22.10,0:07:22.19,Default,,0,0,0,,(Хью күлді)
Dialogue: 0,0:07:22.19,0:07:24.77,Default,,0,0,0,,(Хьюдің күлкісі)
Dialogue: 0,0:07:22.19,0:07:24.77,Default,,0,0,0,,Бұл өте нашар ұйым болды.
Dialogue: 0,0:07:24.77,0:07:24.86,Default,,0,0,0,,(Хью күлкі)
Dialogue: 0,0:07:24.86,0:07:26.28,Default,,0,0,0,,(Хьюдің күлкісі)
Dialogue: 0,0:07:24.86,0:07:26.28,Default,,0,0,0,,Fossa Magna дегеніміз не?
Dialogue: 0,0:07:26.90,0:07:28.24,Default,,0,0,0,,Леди Эмилия
Dialogue: 0,0:07:28.32,0:07:30.95,Default,,0,0,0,,Штаб офицері ретінде жас қызға сенуге болмайды.
Dialogue: 0,0:07:31.03,0:07:33.78,Default,,0,0,0,,Осы бір Хью бәріне жетеді.
Dialogue: 0,0:07:33.87,0:07:35.99,Default,,0,0,0,,Олай болса, әлгі жігіт...
Dialogue: 0,0:07:36.08,0:07:38.54,Default,,0,0,0,,Бұл Chroma ұйымнан шығарылды дегенді білдіре ме?
Dialogue: 0,0:07:39.83,0:07:42.67,Default,,0,0,0,,Хе... кішкентай қыз.
Dialogue: 0,0:07:42.75,0:07:46.67,Default,,0,0,0,,Сіз менің қанатымның астына түсіп, бар күшіңізбен опасыздық жасайсыз ба?
Dialogue: 0,0:07:48.21,0:07:49.63,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:07:53.93,0:07:57.01,Default,,0,0,0,,Хью есімді жігіт өте жаман көрінеді.
Dialogue: 0,0:07:57.10,0:07:59.73,Default,,0,0,0,,Дүниетанымы мүлдем басқа.
Dialogue: 0,0:07:59.81,0:08:04.52,Default,,0,0,0,,Дәлірек айтсақ, Берри Блоссом соншалықты үлкен нәрсемен күреспек пе?
Dialogue: 0,0:08:09.19,0:08:10.03,Default,,0,0,0,,Ах
Dialogue: 0,0:08:24.12,0:08:25.46,Default,,0,0,0,,Пён Пион Пён…
Dialogue: 0,0:08:25.46,0:08:27.17,Default,,0,0,0,,Пён Пион Пён…
Dialogue: 0,0:08:25.46,0:08:27.17,Default,,0,0,0,,А, тоқта, қашпа!
Dialogue: 0,0:08:27.25,0:08:28.42,Default,,0,0,0,,Уау
Dialogue: 0,0:08:28.88,0:08:30.67,Default,,0,0,0,,Жолдан шыға алмаймын
Dialogue: 0,0:08:33.80,0:08:37.22,Default,,0,0,0,,Сіздің айтқаныңыз дұрыс деп ойлаймын.
Dialogue: 0,0:08:37.30,0:08:38.56,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:08:38.64,0:08:39.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:40.43,0:08:43.52,Default,,0,0,0,,Шынымды айтсам, мен зұлымдықтың басшысы болуға жарамаймын.
Dialogue: 0,0:08:44.39,0:08:47.86,Default,,0,0,0,,Бірақ мен бұрынғы армандарымды тастағым келмейді
Dialogue: 0,0:08:47.94,0:08:49.40,Default,,0,0,0,,Күрес
Dialogue: 0,0:08:51.24,0:08:54.24,Default,,0,0,0,,Егер мен жамандық жасасам, оларға бәрібір.
Dialogue: 0,0:08:54.32,0:08:56.37,Default,,0,0,0,,Бұл армандаған жұмыс, солай ма?
Dialogue: 0,0:08:57.24,0:08:59.08,Default,,0,0,0,,Мен оны аңсадым.
Dialogue: 0,0:09:03.41,0:09:08.34,Default,,0,0,0,,Шындығында ол жаман да, жақсы да бола алмайтын жарымжан адам.
Dialogue: 0,0:09:08.42,0:09:09.67,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:09:10.17,0:09:15.18,Default,,0,0,0,,Менің енді бұл қалада орным жоқ...
Dialogue: 0,0:09:15.26,0:09:16.93,Default,,0,0,0,,Әңгімелесейік! Уф...
Dialogue: 0,0:09:17.01,0:09:18.60,Default,,0,0,0,,Шулы Шулы!
Dialogue: 0,0:09:18.68,0:09:20.93,Default,,0,0,0,,Сенің жартылай жаман болсаң маған бәрібір!
Dialogue: 0,0:09:21.52,0:09:23.73,Default,,0,0,0,,Кем дегенде мен...
Dialogue: 0,0:09:24.52,0:09:25.77,Default,,0,0,0,,Chroma
Dialogue: 0,0:09:27.23,0:09:30.94,Default,,0,0,0,,Мен сенің осы қаланың қолбасшысы болғаныңды қалаймын.
Dialogue: 0,0:09:33.49,0:09:35.99,Default,,0,0,0,,Күн картасының баламасы…
Dialogue: 0,0:09:38.28,0:09:39.28,Default,,0,0,0,,Мен Берри Блоссомды жеңе алмаймын деп ойлаймын.
Dialogue: 0,0:09:39.28,0:09:40.66,Default,,0,0,0,,Мен Берри Блоссомды жеңе алмаймын деп ойлаймын.
Dialogue: 0,0:09:39.28,0:09:40.66,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:09:40.66,0:09:40.74,Default,,0,0,0,,Мен Берри Блоссомды жеңе алмаймын деп ойлаймын.
Dialogue: 0,0:09:40.74,0:09:42.74,Default,,0,0,0,,Мен Берри Блоссомды жеңе алмаймын деп ойлаймын.
Dialogue: 0,0:09:40.74,0:09:42.74,Default,,0,0,0,,Куку... Түсінемін.
Dialogue: 0,0:09:43.37,0:09:46.04,Default,,0,0,0,,Хмм... Түсінемін.
Dialogue: 0,0:09:46.12,0:09:50.04,Default,,0,0,0,,Олай десеңіз, мен бас тарта алмаймын!
Dialogue: 0,0:09:50.13,0:09:53.88,Default,,0,0,0,,Жаңа бас қолбасшы – үлкен іс!
Dialogue: 0,0:09:56.59,0:09:59.01,Default,,0,0,0,,...
Dialogue: 0,0:09:59.51,0:10:01.18,Default,,0,0,0,,Ақымақтар
Dialogue: 0,0:10:01.26,0:10:05.52,Default,,0,0,0,,Бұл жергілікті станцияны басып алған жаңа командир Хью.
Dialogue: 0,0:10:06.35,0:10:08.19,Default,,0,0,0,,Мен... уау...
Dialogue: 0,0:10:08.27,0:10:11.52,Default,,0,0,0,,Фосса Магнаның жаңа командирі өте жауыз.
Dialogue: 0,0:10:11.61,0:10:15.94,Default,,0,0,0,,Станция мен маған не болады?
Dialogue: 0,0:10:16.03,0:10:18.82,Default,,0,0,0,,Әрине, тек үмітсіздік бар.
Dialogue: 0,0:10:18.91,0:10:21.74,Default,,0,0,0,,Бұл студияда ары қарай не болады?
Dialogue: 0,0:10:21.83,0:10:24.54,Default,,0,0,0,,Бұл қаланың жақын болашағы деп ойлаймын.
Dialogue: 0,0:10:25.12,0:10:28.33,Default,,0,0,0,,Хухахахаха
Dialogue: 0,0:10:28.42,0:10:29.62,Default,,0,0,0,,«Қиын екен.»
Dialogue: 0,0:10:29.71,0:10:32.34,Default,,0,0,0,,Бұл не сұмдық?
Dialogue: 0,0:10:38.47,0:10:40.26,Default,,0,0,0,,Мен бұл қалада жамандыққа шыдамаймын.
Dialogue: 0,0:10:41.47,0:10:44.01,Default,,0,0,0,,Сиқырлы қыз жидек гүлі
Dialogue: 0,0:10:44.10,0:10:45.39,Default,,0,0,0,,Мынаны қара!
Dialogue: 0,0:10:46.10,0:10:49.85,Default,,0,0,0,,Теледидар көргенде зұлымдықтан қашық бол.
Dialogue: 0,0:10:49.94,0:10:51.65,Default,,0,0,0,,Кеттік, Маширо.
Dialogue: 0,0:10:51.73,0:10:53.48,Default,,0,0,0,,Иә!? Іске сәт!
Dialogue: 0,0:10:53.57,0:10:55.82,Default,,0,0,0,,Хью - ұйымдағы ең жақсы қуат түрі!
Dialogue: 0,0:10:56.40,0:10:58.65,Default,,0,0,0,,Егер басқа адам зұлым болса, оны істеуден басқа амалың жоқ.
Dialogue: 0,0:10:58.74,0:11:01.95,Default,,0,0,0,,Маған жұмбақ жау туралы мәлімет беруіңізді өтінгенім үшін кешіріңіз.
Dialogue: 0,0:11:02.03,0:11:03.28,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:03.87,0:11:05.66,Default,,0,0,0,,Күтіңіз Берри!
Dialogue: 0,0:11:05.74,0:11:08.41,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:11:05.74,0:11:08.41,Default,,0,0,0,,Жидек гүлі міндетті түрде пайда болады.
Dialogue: 0,0:11:08.41,0:11:08.50,Default,,0,0,0,,Жидек гүлі міндетті түрде пайда болады.
Dialogue: 0,0:11:08.50,0:11:08.91,Default,,0,0,0,,Жидек гүлі міндетті түрде пайда болады.
Dialogue: 0,0:11:08.50,0:11:08.91,Default,,0,0,0,,Леди Эмилия
Dialogue: 0,0:11:08.91,0:11:09.00,Default,,0,0,0,,Леди Эмилия
Dialogue: 0,0:11:09.00,0:11:09.58,Default,,0,0,0,,Леди Эмилия
Dialogue: 0,0:11:09.00,0:11:09.58,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:09.58,0:11:09.66,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:09.66,0:11:10.12,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:09.66,0:11:10.12,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:11:10.12,0:11:10.96,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:11:10.96,0:11:13.59,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:11:10.96,0:11:13.59,Default,,0,0,0,,Ол икемсіз.
Dialogue: 0,0:11:13.59,0:11:13.67,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:11:13.67,0:11:14.38,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:11:13.67,0:11:14.38,Default,,0,0,0,,Онда күтіңіз!
Dialogue: 0,0:11:14.38,0:11:15.63,Default,,0,0,0,,Онда күтіңіз!
Dialogue: 0,0:11:16.17,0:11:17.59,Default,,0,0,0,,Қараңызшы, шықты!
Dialogue: 0,0:11:17.67,0:11:19.22,Default,,0,0,0,,Уау~ О, жоқ!
Dialogue: 0,0:11:19.30,0:11:21.09,Default,,0,0,0,,Уау, неткен дүниетаным!
Dialogue: 0,0:11:21.18,0:11:24.60,Default,,0,0,0,,Енді мен осындамын, мен саған қалағаныңды істеуге рұқсат бермеймін!
Dialogue: 0,0:11:24.68,0:11:25.60,Default,,0,0,0,,Дайын бол...
Dialogue: 0,0:11:26.56,0:11:28.23,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:11:29.81,0:11:31.69,Default,,0,0,0,,Жоқ...не?
Dialogue: 0,0:11:31.77,0:11:35.73,Default,,0,0,0,,Заттарды елемеу тым моральдық тұрғыдан әдепсіздік емес пе?
Dialogue: 0,0:11:35.82,0:11:36.69,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:11:36.69,0:11:37.07,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:11:36.69,0:11:37.07,Default,,0,0,0,,Сенің зұлым адам ретінде санаң жеткіліксіз.
Dialogue: 0,0:11:37.07,0:11:37.15,Default,,0,0,0,,Сенің зұлым адам ретінде санаң жеткіліксіз.
Dialogue: 0,0:11:37.15,0:11:39.24,Default,,0,0,0,,Сенің зұлым адам ретінде санаң жеткіліксіз.
Dialogue: 0,0:11:37.15,0:11:39.24,Default,,0,0,0,,Тек мені тыңдаңыз!
Dialogue: 0,0:11:39.32,0:11:40.70,Default,,0,0,0,,Ha
Dialogue: 0,0:11:40.78,0:11:44.41,Default,,0,0,0,,Сиқырлы қыз қорқынышты емес
Dialogue: 0,0:11:44.49,0:11:47.24,Default,,0,0,0,,Соңғы үмітпен қоштасатын кез келді
Dialogue: 0,0:11:47.33,0:11:49.75,Default,,0,0,0,,Берри!
Dialogue: 0,0:11:50.33,0:11:52.96,Default,,0,0,0,,Мен саған мұны істеуге рұқсат бермеймін.
Dialogue: 0,0:11:53.42,0:11:56.04,Default,,0,0,0,,Хрома, сіз бармаймын десеңіз де.
Dialogue: 0,0:11:56.13,0:11:57.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:57.25,0:12:00.13,Default,,0,0,0,,Уау, мен қатты толқып тұрмын.
Dialogue: 0,0:12:01.59,0:12:04.14,Default,,0,0,0,,Не? Көмекке бару дұрыс па?
Dialogue: 0,0:12:04.22,0:12:08.43,Default,,0,0,0,,Өйткені... ол жаман ересек болса да?
Dialogue: 0,0:12:13.35,0:12:15.48,Default,,0,0,0,,Әділдіктің одақтасы болуы керек
Dialogue: 0,0:12:16.11,0:12:18.65,Default,,0,0,0,,Мен өзімнің қателіктерімді де білмеймін.
Dialogue: 0,0:12:18.73,0:12:19.86,Default,,0,0,0,,Иә
Dialogue: 0,0:12:21.28,0:12:22.74,Default,,0,0,0,,Кеттік, Данте.
Dialogue: 0,0:12:24.78,0:12:26.41,Default,,0,0,0,,Жоспар бар
Dialogue: 0,0:12:29.66,0:12:33.21,Default,,0,0,0,,Мен Хьюді командир ретінде жақсы білемін.
Dialogue: 0,0:12:33.71,0:12:35.63,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:12:35.71,0:12:37.25,Default,,0,0,0,,Мен артқы есікке барамын.
Dialogue: 0,0:12:43.51,0:12:44.93,Default,,0,0,0,,үшін жақсы
Dialogue: 0,0:12:45.01,0:12:46.93,Default,,0,0,0,,Неліктен? Мен кірсем ше?
Dialogue: 0,0:12:47.01,0:12:49.81,Default,,0,0,0,,Егер сен шынымен зұлым болсаң, бұлай тұрып қалмас едің.
Dialogue: 0,0:12:49.89,0:12:51.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:51.64,0:12:52.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:52.60,0:12:53.98,Default,,0,0,0,,Маширо мырза
Dialogue: 0,0:12:54.06,0:12:55.35,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:12:55.44,0:12:58.44,Default,,0,0,0,,Берри болмаса мен ит пен мысықтан артық емеспін, мен кіре алмаймын.
Dialogue: 0,0:12:58.52,0:12:59.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:59.94,0:13:02.57,Default,,0,0,0,,Оған тыйым салынбаған
Dialogue: 0,0:13:02.65,0:13:05.61,Default,,0,0,0,,Бұл әлі де сенім мәселесі ме?
Dialogue: 0,0:13:06.16,0:13:08.58,Default,,0,0,0,,Бұл не? бұл жағдай
Dialogue: 0,0:13:09.03,0:13:10.91,Default,,0,0,0,,Егер сіз Берримен бірге келген болсаңыз
Dialogue: 0,0:13:10.99,0:13:14.00,Default,,0,0,0,,Сиқырлы қыздың қызметшісі ретінде...
Dialogue: 0,0:13:14.08,0:13:15.37,Default,,0,0,0,,Ha
Dialogue: 0,0:13:15.46,0:13:17.13,Default,,0,0,0,,Эй... күте тұрыңыз.
Dialogue: 0,0:13:17.21,0:13:18.84,Default,,0,0,0,,Екеуіңді де тыңдаңдар.
Dialogue: 0,0:13:18.92,0:13:20.63,Default,,0,0,0,,Аа, ханым
Dialogue: 0,0:13:21.09,0:13:23.80,Default,,0,0,0,,Мен мына жігіттермен...
Dialogue: 0,0:13:23.88,0:13:26.22,Default,,0,0,0,,Сіздің жоспарыңыз бар сияқты.
Dialogue: 0,0:13:26.89,0:13:29.47,Default,,0,0,0,,Мен сенен сұрайын, Датечи...
Dialogue: 0,0:13:29.55,0:13:30.76,Default,,0,0,0,,Данте
Dialogue: 0,0:13:32.85,0:13:34.23,Default,,0,0,0,,Жаңа командир!
Dialogue: 0,0:13:34.31,0:13:35.69,Default,,0,0,0,,Бұл жұмбақ... не?
Dialogue: 0,0:13:35.77,0:13:37.27,Default,,0,0,0,,Ілмекті шешіңіз!
Dialogue: 0,0:13:37.35,0:13:39.19,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:13:39.27,0:13:40.77,Default,,0,0,0,,Пайдасыз заттар
Dialogue: 0,0:13:40.86,0:13:41.53,Default,,0,0,0,,Сіз қазір...
Dialogue: 0,0:13:41.53,0:13:42.48,Default,,0,0,0,,Сіз қазір...
Dialogue: 0,0:13:41.53,0:13:42.48,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:42.48,0:13:43.49,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:44.24,0:13:45.74,Default,,0,0,0,,Осы үш кадрды қайтадан қатар қойып көрсетіңізші.
Dialogue: 0,0:13:45.82,0:13:47.24,Default,,0,0,0,,Қандай нәрсе!
Dialogue: 0,0:13:52.24,0:13:55.91,Default,,0,0,0,,Сиқырлы қыз №2
Dialogue: 0,0:13:57.75,0:14:00.67,Default,,0,0,0,,№2? Ол кім?
Dialogue: 0,0:14:00.75,0:14:03.67,Default,,0,0,0,,Мұның бәрі сіз үшін...
Dialogue: 0,0:14:04.17,0:14:06.38,Default,,0,0,0,,Сіз күткендей, Данте.
Dialogue: 0,0:14:06.47,0:14:10.51,Default,,0,0,0,,Егер мен сиқырлы қыз болып киінсем және бұл жігіт маған еріп жүрсе,
Dialogue: 0,0:14:10.60,0:14:13.06,Default,,0,0,0,,Мен бәрі тамаша үйлесетініне қуаныштымын.
Dialogue: 0,0:14:13.14,0:14:14.81,Default,,0,0,0,,Мені бірден өлтіріңіз
Dialogue: 0,0:14:14.89,0:14:16.43,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:14:16.52,0:14:18.31,Default,,0,0,0,,Оны жағыңыз
Dialogue: 0,0:14:18.40,0:14:19.81,Default,,0,0,0,,Бос орындарға толы
Dialogue: 0,0:14:19.90,0:14:21.23,Default,,0,0,0,,(Pack) Иә, сонымен, артық зақымға келсек—
Dialogue: 0,0:14:23.36,0:14:24.36,Default,,0,0,0,,Ах
Dialogue: 0,0:14:24.44,0:14:26.61,Default,,0,0,0,,Мен байқамаймын деп ойлайсыз ба?
Dialogue: 0,0:14:28.32,0:14:29.45,Default,,0,0,0,,Бұған жол берме!
Dialogue: 0,0:14:29.53,0:14:30.95,Default,,0,0,0,,Гяаа
Dialogue: 0,0:14:31.03,0:14:32.20,Default,,0,0,0,,Маширо!
Dialogue: 0,0:14:33.08,0:14:35.58,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:14:35.66,0:14:37.83,Default,,0,0,0,,№2 қабылдау!
Dialogue: 0,0:14:40.71,0:14:42.88,Default,,0,0,0,,О... адамдар қандай ерекше!
Dialogue: 0,0:14:42.96,0:14:44.92,Default,,0,0,0,,Уайымдама, Маширо
Dialogue: 0,0:14:45.01,0:14:47.30,Default,,0,0,0,,Мен дұрыс айттым.
Dialogue: 0,0:14:47.38,0:14:49.13,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:14:49.72,0:14:53.89,Default,,0,0,0,,Уақытты анықтауды өз қызметкерлеріме қалдырамын.
Dialogue: 0,0:14:53.97,0:14:56.89,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:14:58.60,0:15:01.02,Default,,0,0,0,,Басқаларға қалдыр деп айтпайсың ба?
Dialogue: 0,0:15:03.36,0:15:04.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:04.69,0:15:06.36,Default,,0,0,0,,Жидек гүлі!
Dialogue: 0,0:15:06.44,0:15:08.74,Default,,0,0,0,,Сіз де сиқыр қолданасыз ба?
Dialogue: 0,0:15:08.82,0:15:10.61,Default,,0,0,0,,Мен бұрын шарт жасасқанмын.
Dialogue: 0,0:15:12.87,0:15:13.99,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:15:14.49,0:15:16.29,Default,,0,0,0,,Міне, Хью.
Dialogue: 0,0:15:16.37,0:15:19.29,Default,,0,0,0,,Мен саған жеңіл жүрмеймін.
Dialogue: 0,0:15:20.79,0:15:22.08,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:15:22.08,0:15:23.46,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:15:22.08,0:15:23.46,Default,,0,0,0,,Осы жерден айналып өтейік…
Dialogue: 0,0:15:23.54,0:15:25.09,Default,,0,0,0,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,0:15:28.09,0:15:28.92,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:15:30.47,0:15:32.93,Default,,0,0,0,,Маған қоңырау шалыңыз.
Dialogue: 0,0:15:33.01,0:15:34.43,Default,,0,0,0,,Зуру!
Dialogue: 0,0:15:35.01,0:15:36.89,Default,,0,0,0,,Уа, Құдайым!
Dialogue: 0,0:15:36.97,0:15:40.64,Default,,0,0,0,,Ол қайда жоғалып кетті? Қарапайым қызды кепілге алды.
Dialogue: 0,0:15:41.69,0:15:43.15,Default,,0,0,0,,Сол қыз...
Dialogue: 0,0:15:47.61,0:15:49.32,Default,,0,0,0,,Дата мырза?
Dialogue: 0,0:15:49.86,0:15:51.53,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:15:51.61,0:15:52.86,Default,,0,0,0,,Қалайсың, Хрома?
Dialogue: 0,0:15:52.95,0:15:55.28,Default,,0,0,0,,Тіпті сіз оған көмектесе алмайсыз.
Dialogue: 0,0:15:56.28,0:15:59.25,Default,,0,0,0,,Мен түсінемін, бұл рас.
Dialogue: 0,0:15:59.33,0:16:01.75,Default,,0,0,0,,Менің қолымнан ештеңе келмейді...
Dialogue: 0,0:16:02.46,0:16:04.17,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:16:04.25,0:16:05.92,Default,,0,0,0,,Бар!
Dialogue: 0,0:16:06.00,0:16:08.38,Default,,0,0,0,,Сәл күте тұрыңыз... Жоқ 2!?
Dialogue: 0,0:16:08.46,0:16:09.63,Default,,0,0,0,,Ах
Dialogue: 0,0:16:09.71,0:16:12.97,Default,,0,0,0,,Хахаха мен білемін, білемін.
Dialogue: 0,0:16:13.05,0:16:16.51,Default,,0,0,0,,Сіз дәл қазір сиқырды пайдалана алмайтын шығарсыз.
Dialogue: 0,0:16:16.60,0:16:18.06,Default,,0,0,0,,Кінә – кінәсіз мысықты сөмкеге салып, осы жерге тастап кеткен адамда.
Dialogue: 0,0:16:18.52,0:16:21.73,Default,,0,0,0,,Тіпті таяқ арқылы сиқырлы күшті босатып алсаңыз да
Dialogue: 0,0:16:21.81,0:16:25.44,Default,,0,0,0,,Сенің таяғың мына қызбен бірге.
Dialogue: 0,0:16:25.98,0:16:27.48,Default,,0,0,0,,Берри кешіріңіз
Dialogue: 0,0:16:27.57,0:16:29.90,Default,,0,0,0,,Мен бірдеңені дұрыс емес бастым
Dialogue: 0,0:16:29.98,0:16:33.41,Default,,0,0,0,,Эй, менде бұл коте бар.
Dialogue: 0,0:16:33.49,0:16:36.12,Default,,0,0,0,,Хухахахаха
Dialogue: 0,0:16:36.20,0:16:38.99,Default,,0,0,0,,Жақсы, жақсы, сол өрнек
Dialogue: 0,0:16:39.08,0:16:41.66,Default,,0,0,0,,Жарқыраған көріністі киіңіз
Dialogue: 0,0:16:41.75,0:16:45.29,Default,,0,0,0,,Бұл әйелдер мен балаларға арналған перде емес!
Dialogue: 0,0:16:45.38,0:16:47.54,Default,,0,0,0,,Егер сіз үндемей тыңдасаңыз...
Dialogue: 0,0:16:47.63,0:16:48.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:48.71,0:16:51.76,Default,,0,0,0,,Ууу...
Dialogue: 0,0:16:51.84,0:16:53.47,Default,,0,0,0,,А... уау
Dialogue: 0,0:16:54.13,0:16:54.97,Default,,0,0,0,,Уау
Dialogue: 0,0:16:55.80,0:16:56.55,Default,,0,0,0,,(үшін күңкілдейді)
Dialogue: 0,0:16:56.55,0:16:58.35,Default,,0,0,0,,(үшін күңкілдейді)
Dialogue: 0,0:16:56.55,0:16:58.35,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:16:58.35,0:16:59.56,Default,,0,0,0,,(үшін күңкілдейді)
Dialogue: 0,0:17:00.06,0:17:02.73,Default,,0,0,0,,Жидек гүлі туралы
Dialogue: 0,0:17:03.18,0:17:05.98,Default,,0,0,0,,Мені мазақ ет!
Dialogue: 0,0:17:10.78,0:17:12.61,Default,,0,0,0,,Кімге... Қаш!
Dialogue: 0,0:17:12.69,0:17:16.16,Default,,0,0,0,,Бұл да сол тікенекті кісінің ісі ме?
Dialogue: 0,0:17:16.24,0:17:17.62,Default,,0,0,0,,Шындығында, мен Сиқыршылар культіне қатысты бірнеше жаңа нәрсені түсіндім
Dialogue: 0,0:17:20.41,0:17:22.25,Default,,0,0,0,,Бұл жігіт жарық шығарады...
Dialogue: 0,0:17:24.33,0:17:26.04,Default,,0,0,0,,Қуатсыз ба?
Dialogue: 0,0:17:26.12,0:17:28.04,Default,,0,0,0,,Берри берілмейді
Dialogue: 0,0:17:28.13,0:17:30.88,Default,,0,0,0,,Құтқарылатын жан осында!
Dialogue: 0,0:17:32.59,0:17:33.92,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:17:34.01,0:17:37.14,Default,,0,0,0,,Ей, өзің шешпей-ақ қой!
Dialogue: 0,0:17:38.47,0:17:39.64,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:39.72,0:17:43.27,Default,,0,0,0,,Менің қолтығым шығар жол!
Dialogue: 0,0:17:46.85,0:17:47.98,Default,,0,0,0,,ешкімге достықты мәжбүрлеп таңушы емеспін.
Dialogue: 0,0:17:48.06,0:17:49.48,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз...
Dialogue: 0,0:17:51.69,0:17:52.65,Default,,0,0,0,,(Спидвагон) Ол сөйледі! Демек, ол соңында бәрін түсінеді екен
Dialogue: 0,0:17:51.69,0:17:52.65,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:17:52.65,0:17:53.07,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:17:54.03,0:17:56.11,Default,,0,0,0,,Сәлеметсіз бе, сіз фюрерсіз бе?
Dialogue: 0,0:17:56.20,0:17:58.28,Default,,0,0,0,,Хьюдің жігіті қолын сындырды.
Dialogue: 0,0:17:58.36,0:18:00.58,Default,,0,0,0,,Эй... сен!
Dialogue: 0,0:18:00.66,0:18:02.74,Default,,0,0,0,,Иә, бұл рас.
Dialogue: 0,0:18:02.83,0:18:05.16,Default,,0,0,0,,Қатты шайқастан кейін де емес
Dialogue: 0,0:18:05.87,0:18:07.87,Default,,0,0,0,,Қарапайым және үмітсіз түрде
Dialogue: 0,0:18:07.96,0:18:10.79,Default,,0,0,0,,Штабты мазаламаңыз!
Dialogue: 0,0:18:23.85,0:18:26.31,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:18:26.39,0:18:28.73,Default,,0,0,0,,Қару-жарақ
Dialogue: 0,0:18:29.77,0:18:33.98,Default,,0,0,0,,Мен шаруаға мән бермейтін адамдарды жек көремін дедім.
Dialogue: 0,0:18:34.07,0:18:35.49,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:18:35.57,0:18:38.20,Default,,0,0,0,,Мұндай нәрсені бірінші рет естіп тұрсыз ба?
Dialogue: 0,0:18:38.28,0:18:40.03,Default,,0,0,0,,Жоқ, жеткілікті
Dialogue: 0,0:18:40.11,0:18:40.95,Default,,0,0,0,,А...
Dialogue: 0,0:18:42.49,0:18:46.75,Default,,0,0,0,,Мен... Бұл Риппл! Ол Рипплді қолдануда!
Dialogue: 0,0:18:46.83,0:18:48.58,Default,,0,0,0,,Санкциялар
Dialogue: 0,0:18:49.58,0:18:51.38,Default,,0,0,0,,Уууу!
Dialogue: 0,0:18:51.46,0:18:55.96,Default,,0,0,0,,О... өтінемін, мені кешіріңіз!
Dialogue: 0,0:18:56.51,0:18:58.72,Default,,0,0,0,,Зұлым ұйымдарды жазалау
Dialogue: 0,0:18:58.80,0:19:00.55,Default,,0,0,0,,Жер бетінде не...
Dialogue: 0,0:19:01.26,0:19:04.64,Default,,0,0,0,,Ууу...
Dialogue: 0,0:19:09.19,0:19:11.56,Default,,0,0,0,,А, сен мен үшін не істедің!
Dialogue: 0,0:19:11.65,0:19:12.73,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:19:12.81,0:19:14.11,Default,,0,0,0,,Бұл сізге сәйкес келеді...
Dialogue: 0,0:19:14.19,0:19:15.69,Default,,0,0,0,,Боо... хахахаха
Dialogue: 0,0:19:15.78,0:19:18.65,Default,,0,0,0,,Неліктен екі бас...
Dialogue: 0,0:19:18.74,0:19:21.20,Default,,0,0,0,,Оны сүйкімді және дәрменсіз етіп көрсетіңіз
Dialogue: 0,0:19:21.28,0:19:23.41,Default,,0,0,0,,Қалай шығару керек
Dialogue: 0,0:19:23.49,0:19:25.91,Default,,0,0,0,,Бұл қорқынышты ұйым.
Dialogue: 0,0:19:25.99,0:19:28.37,Default,,0,0,0,,Бұл өте қорқақ!
Dialogue: 0,0:19:28.45,0:19:31.83,Default,,0,0,0,,Қолыңды тура маған қойыңыз, сен!
Dialogue: 0,0:19:31.92,0:19:33.88,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:19:37.34,0:19:39.26,Default,,0,0,0,,Мүмкіндігінше
Dialogue: 0,0:19:39.34,0:19:42.09,Default,,0,0,0,,Мен басқалардың күшімен өмір сүргім келеді
Dialogue: 0,0:19:42.18,0:19:45.22,Default,,0,0,0,,Мен сондаймын
Dialogue: 0,0:19:45.31,0:19:46.72,Default,,0,0,0,,Жаман
Dialogue: 0,0:19:46.81,0:19:49.68,Default,,0,0,0,,Не? Әй хрома!
Dialogue: 0,0:19:49.77,0:19:51.73,Default,,0,0,0,,Байқау өз еркіңізде.
Dialogue: 0,0:19:51.81,0:19:53.73,Default,,0,0,0,,Қарғыс атқыр... есіңде болсын!
Dialogue: 0,0:19:53.81,0:19:54.65,Default,,0,0,0,,Тоуууу
Dialogue: 0,0:19:54.73,0:19:56.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:58.61,0:19:59.74,Default,,0,0,0,,№ 2
Dialogue: 0,0:19:59.82,0:20:02.32,Default,,0,0,0,,Chroma жоқ
Dialogue: 0,0:20:04.41,0:20:07.70,Default,,0,0,0,,Неге маған көмектестің, жауым?
Dialogue: 0,0:20:09.33,0:20:11.58,Default,,0,0,0,,Менің атымды атама
Dialogue: 0,0:20:15.21,0:20:18.42,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:20:24.09,0:20:26.85,Default,,0,0,0,,Ол маңызды болмыс болғандықтан шешілді.
Dialogue: 0,0:20:26.93,0:20:28.77,Default,,0,0,0,,Наа...
Dialogue: 0,0:20:28.85,0:20:30.27,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:20:31.18,0:20:32.85,Default,,0,0,0,,Кенеттен не...
Dialogue: 0,0:20:32.94,0:20:34.35,Default,,0,0,0,,Уау~
Dialogue: 0,0:20:34.44,0:20:37.90,Default,,0,0,0,,Хе-хе... Сен бәрінен жақсы өткен сияқтысың.
Dialogue: 0,0:20:38.36,0:20:39.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:39.36,0:20:42.24,Default,,0,0,0,,Не болды!
Dialogue: 0,0:20:43.20,0:20:45.20,Default,,0,0,0,,Дегенмен, бұл аянышты көрініс әдемі
Dialogue: 0,0:20:46.57,0:20:49.70,Default,,0,0,0,,Ю... Сіз мені сақауымды түсіргіңіз келе ме!?
Dialogue: 0,0:20:49.79,0:20:52.75,Default,,0,0,0,,Ааааах!
Dialogue: 0,0:20:49.79,0:20:52.75,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:53.29,0:20:55.96,Default,,0,0,0,,Жоқ... неге?!
Dialogue: 0,0:20:58.34,0:21:01.59,Default,,0,0,0,,Chroma Мен сені кешіремін!
Dialogue: 0,0:21:02.05,0:21:04.72,Default,,0,0,0,,Әртүрлі із қалдырғанымен
Dialogue: 0,0:21:04.80,0:21:07.14,Default,,0,0,0,,Оқиға аяқталды
Dialogue: 0,0:21:08.05,0:21:09.10,Default,,0,0,0,,Иә
Dialogue: 0,0:21:09.56,0:21:10.56,Default,,0,0,0,,Иә
Dialogue: 0,0:21:11.52,0:21:13.52,Default,,0,0,0,,Мен... жалғастырамын!?
Dialogue: 0,0:21:14.56,0:21:15.98,Default,,0,0,0,,Командир!?
Dialogue: 0,0:21:16.06,0:21:18.94,Default,,0,0,0,,Иә! Мен сіздің үмітіңізді ақтаймын.
Dialogue: 0,0:21:19.02,0:21:20.02,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:21:20.11,0:21:22.44,Default,,0,0,0,,Не болар екен деп ойладым.
Dialogue: 0,0:21:22.90,0:21:25.57,Default,,0,0,0,,Бұл сізді жаман істерден сақтайды, солай емес пе?
Dialogue: 0,0:21:25.66,0:21:26.49,Default,,0,0,0,,Chroma
Dialogue: 0,0:21:27.41,0:21:31.37,Default,,0,0,0,,Жарайды, мен сенің тілегіңді орындағым келді.
Dialogue: 0,0:21:31.45,0:21:33.16,Default,,0,0,0,,Күн картасының баламасы
Dialogue: 0,0:21:41.17,0:21:43.80,Default,,0,0,0,,Ақылдан ада, абай бол, жау
Dialogue: 0,0:21:43.88,0:21:46.34,Default,,0,0,0,,Жаман қолбасшының сандырағы...
Dialogue: 0,0:21:46.43,0:21:49.97,Default,,0,0,0,,Қарғыс... Рух бірлігі Рух бірлігі
Dialogue: 0,0:21:50.05,0:21:52.97,Default,,0,0,0,,Мен сіздің сезімдеріңізді бағалаймын, бірақ...
Dialogue: 0,0:21:53.52,0:21:56.60,Default,,0,0,0,,Ол маңызды болмыс болғандықтан шешілді.
Dialogue: 0,0:21:56.69,0:21:58.48,Default,,0,0,0,,Уаа
Dialogue: 0,0:21:58.56,0:22:02.57,Default,,0,0,0,,Тітіркендіргіш~!
Dialogue: 0,0:22:05.03,0:22:07.28,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.57,0:23:34.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.45,0:23:42.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
