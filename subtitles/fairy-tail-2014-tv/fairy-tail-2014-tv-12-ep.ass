Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.83,0:00:02.45,Default,,0,0,0,,О!
Dialogue: 0,0:00:02.58,0:00:04.54,Default,,0,0,0,,Амансың ба? болашақ Люси
Dialogue: 0,0:00:04.66,0:00:06.54,Default,,0,0,0,,А, бұл қайда?
Dialogue: 0,0:00:06.66,0:00:07.66,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:00:07.87,0:00:10.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:10.88,0:00:12.17,Default,,0,0,0,,Терияа! Гуаа
Dialogue: 0,0:00:12.38,0:00:13.25,Default,,0,0,0,,Уаааа
Dialogue: 0,0:00:21.72,0:00:25.64,Default,,0,0,0,,Қуат айырмашылығын бір күнде жабу мүмкін емес.
Dialogue: 0,0:00:25.77,0:00:26.98,Default,,0,0,0,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:00:33.52,0:00:35.07,Default,,0,0,0,,Мына адамға қара.
Dialogue: 0,0:00:36.69,0:00:38.90,Default,,0,0,0,,Нацу Драгнил сияқты жақсы емес
Dialogue: 0,0:00:43.03,0:00:44.62,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:02:04.82,0:02:10.83,Default,,0,0,0,,~♪
Dialogue: 0,0:02:18.88,0:02:23.13,Default,,0,0,0,,Сол уақыт келгенше түрмеде болдық.
Dialogue: 0,0:02:23.26,0:02:24.84,Default,,0,0,0,,Сол кезде?
Dialogue: 0,0:02:25.72,0:02:31.02,Default,,0,0,0,,Мм... Люси неге болашақтан келді?
Dialogue: 0,0:02:31.14,0:02:33.48,Default,,0,0,0,,Ең нашар болашақты өзгерту
Dialogue: 0,0:02:33.60,0:02:34.73,Default,,0,0,0,,Ең нашар?
Dialogue: 0,0:02:35.15,0:02:39.27,Default,,0,0,0,,Сіздің болашақта не болды?
Dialogue: 0,0:02:42.69,0:02:45.28,Default,,0,0,0,,Алда үмітсіздік күтіп тұр
Dialogue: 0,0:02:45.70,0:02:50.12,Default,,0,0,0,,Бұл елге 10 000-нан астам айдаһар тобы шабуыл жасайды.
Dialogue: 0,0:02:50.91,0:02:54.25,Default,,0,0,0,,Қала өртенді, қамал құлады...
Dialogue: 0,0:02:54.79,0:02:58.13,Default,,0,0,0,,Көптеген өмірлер жоғалды
Dialogue: 0,0:03:02.96,0:03:04.34,Default,,0,0,0,,«Бақа»
Dialogue: 0,0:03:13.52,0:03:16.77,Default,,0,0,0,,10 000-нан астам айдаһар тобы...
Dialogue: 0,0:03:16.90,0:03:20.11,Default,,0,0,0,,Мен мұндай әңгімеге сену мүмкін емес.
Dialogue: 0,0:03:21.23,0:03:22.78,Default,,0,0,0,,Мен сенбеймін
Dialogue: 0,0:03:23.36,0:03:25.99,Default,,0,0,0,,Мен Ұлы жын шайқасының демонстрациясының нәтижелерін көргенше.
Dialogue: 0,0:03:33.16,0:03:35.46,Default,,0,0,0,,Ал...
Dialogue: 0,0:03:35.58,0:03:37.75,Default,,0,0,0,,Ой, ой!
Dialogue: 0,0:03:37.87,0:03:38.92,Default,,0,0,0,,Дауысыңыз қатты.
Dialogue: 0,0:03:39.21,0:03:41.34,Default,,0,0,0,,10 000-нан астам айдаһар
Dialogue: 0,0:03:41.80,0:03:43.30,Default,,0,0,0,,Неліктен бұлай...
Dialogue: 0,0:03:43.42,0:03:45.47,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:03:45.92,0:03:49.72,Default,,0,0,0,,Мүмкін оның Айдаһар моласына қатысы бар шығар?
Dialogue: 0,0:03:49.85,0:03:51.22,Default,,0,0,0,,Маған қызық
Dialogue: 0,0:03:51.35,0:03:52.72,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:03:52.85,0:03:55.06,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:03:55.18,0:03:56.18,Default,,0,0,0,,Шулы!
Dialogue: 0,0:03:56.64,0:03:58.52,Default,,0,0,0,,Ол қайдан шыққан?
Dialogue: 0,0:03:58.69,0:04:02.69,Default,,0,0,0,,Анықталмай жасыруға бола ма?
Dialogue: 0,0:04:03.11,0:04:04.90,Default,,0,0,0,,Қалай болғанда да, мен мұны істей алмаймын.
Dialogue: 0,0:04:05.03,0:04:06.19,Default,,0,0,0,,Ұрысқа дайындалу
Dialogue: 0,0:04:06.70,0:04:07.70,Default,,0,0,0,,Сіз ұрыспақсыз ба?
Dialogue: 0,0:04:07.82,0:04:09.87,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:04:09.99,0:04:10.74,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:04:11.41,0:04:13.20,Default,,0,0,0,,Маған сенесіз бе?
Dialogue: 0,0:04:13.62,0:04:14.66,Default,,0,0,0,,Бұл өтірік пе?
Dialogue: 0,0:04:14.79,0:04:17.04,Default,,0,0,0,,Жоқ! Бірақ...
Dialogue: 0,0:04:17.25,0:04:21.67,Default,,0,0,0,,Мұндай әңгімеге ешкім сенбей ме деп қорқамын.
Dialogue: 0,0:04:22.50,0:04:25.17,Default,,0,0,0,,Люсидің сөзіне неге күмәнданасыз?
Dialogue: 0,0:04:30.22,0:04:31.18,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:31.97,0:04:37.06,Default,,0,0,0,,Бұл менің болашақ өзім болсам да аянышты. Сіз достарыңызға көбірек сенуіңіз керек.
Dialogue: 0,0:04:37.18,0:04:38.98,Default,,0,0,0,,Өзіңізге уағыз айту?
Dialogue: 0,0:04:39.10,0:04:40.98,Default,,0,0,0,,Бірақ бұл дұрыс.
Dialogue: 0,0:04:44.36,0:04:45.69,Default,,0,0,0,,Енді біз қосылдық
Dialogue: 0,0:04:46.82,0:04:48.90,Default,,0,0,0,,Құлаған Меркурийлер
Dialogue: 0,0:04:49.03,0:04:50.91,Default,,0,0,0,,Құлыпта ән айт
Dialogue: 0,0:04:51.87,0:04:55.33,Default,,0,0,0,,Жоқ, бұл Люси жылап тұр.
Dialogue: 0,0:04:56.12,0:04:58.41,Default,,0,0,0,,Жылау? Неге...
Dialogue: 0,0:04:59.29,0:05:01.12,Default,,0,0,0,,Әй, айдаһар келгенде...
Dialogue: 0,0:05:01.25,0:05:04.80,Default,,0,0,0,,Бір сарайда болған бізге не болды?
Dialogue: 0,0:05:05.42,0:05:06.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:10.43,0:05:15.26,Default,,0,0,0,,Чарльз Болжауға рұқсат етіңіз. Мүмкін біз...
Dialogue: 0,0:05:15.39,0:05:17.39,Default,,0,0,0,,Мен... өлемін бе?
Dialogue: 0,0:05:17.52,0:05:18.68,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:18.93,0:05:22.15,Default,,0,0,0,,Балалар сендер өлесіңдер ме?
Dialogue: 0,0:05:23.56,0:05:26.61,Default,,0,0,0,,Себебі сен менімен болдың ба? Өкінішке орай...
Dialogue: 0,0:05:57.72,0:05:58.81,Default,,0,0,0,,Ах
Dialogue: 0,0:05:59.27,0:06:00.27,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:05.81,0:06:08.40,Default,,0,0,0,,Нацу? Нацу!
Dialogue: 0,0:06:12.70,0:06:14.99,Default,,0,0,0,,Қанша күн өткені есімде жоқ.
Dialogue: 0,0:06:15.99,0:06:20.12,Default,,0,0,0,,Мен оянғанда, Тұтылу есіме түсті.
Dialogue: 0,0:06:20.75,0:06:23.29,Default,,0,0,0,,Мен оны қалай бастарымды білмедім.
Dialogue: 0,0:06:23.92,0:06:26.21,Default,,0,0,0,,Есікті ашумен аштым.
Dialogue: 0,0:06:27.09,0:06:30.21,Default,,0,0,0,,Өткенге қайта оралу мүмкіндігіне сеніңіз
Dialogue: 0,0:06:35.34,0:06:36.39,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:06:36.97,0:06:39.26,Default,,0,0,0,,Мен шынымен өткенге оралдым.
Dialogue: 0,0:06:39.39,0:06:42.52,Default,,0,0,0,,4 шілдеде X791
Dialogue: 0,0:06:42.73,0:06:45.94,Default,,0,0,0,,Бұл жақында ғана емес пе?
Dialogue: 0,0:06:46.06,0:06:49.61,Default,,0,0,0,,Eclipse аз ғана өткенге бара ала ма?
Dialogue: 0,0:06:49.98,0:06:54.20,Default,,0,0,0,,Бірақ сіз 400 жыл артқа шегініп, Зерефті жеңесіз.
Dialogue: 0,0:06:54.57,0:06:56.20,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:06:56.41,0:07:00.16,Default,,0,0,0,,Бір бөлігі бұзылған, сондықтан да шығар.
Dialogue: 0,0:07:00.95,0:07:02.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:02.95,0:07:07.25,Default,,0,0,0,,Бұл ханшайымға кеңес берген жұмбақ болашақ адам болды ма?
Dialogue: 0,0:07:08.38,0:07:10.67,Default,,0,0,0,,Бірақ мен алаңдаймын.
Dialogue: 0,0:07:11.17,0:07:14.51,Default,,0,0,0,,Қалада керемет шайқас қойылымын түсіріп жатқан лакрима бар...
Dialogue: 0,0:07:14.63,0:07:16.76,Default,,0,0,0,,Барлық жерде орналастырылған
Dialogue: 0,0:07:17.26,0:07:20.64,Default,,0,0,0,,Мен сенің жер астына түсіп, Жерармен және басқалармен кездескеніңді қалаймын.
Dialogue: 0,0:07:20.76,0:07:21.56,Default,,0,0,0,,Жерар?
Dialogue: 0,0:07:22.31,0:07:24.39,Default,,0,0,0,,Мен оған бәрін айттым.
Dialogue: 0,0:07:24.81,0:07:27.81,Default,,0,0,0,,Олар қазір қарсы шараларды тұжырымдау керек.
Dialogue: 0,0:07:28.10,0:07:30.27,Default,,0,0,0,,Қарсы шараларды дайындау дегенді қалай түсінесіз?
Dialogue: 0,0:07:31.02,0:07:32.11,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:32.82,0:07:37.32,Default,,0,0,0,,Мен болашақтан шешім әкелген жоқпын.
Dialogue: 0,0:07:38.16,0:07:42.45,Default,,0,0,0,,Мен бұл жағдайдан қалай құтылуға болатынын білмеймін.
Dialogue: 0,0:07:48.46,0:07:50.00,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:07:54.97,0:07:57.59,Default,,0,0,0,,Ми... болашақтан?
Dialogue: 0,0:07:57.84,0:07:58.59,Default,,0,0,0,,Иә
Dialogue: 0,0:07:59.22,0:08:00.97,Default,,0,0,0,,деді
Dialogue: 0,0:08:01.22,0:08:03.68,Default,,0,0,0,,Eclipse қолданудың тағы бір жолы
Dialogue: 0,0:08:03.93,0:08:05.52,Default,,0,0,0,,Тұтылу 2
Dialogue: 0,0:08:05.64,0:08:08.02,Default,,0,0,0,,2? Бұл нақты не...
Dialogue: 0,0:08:08.65,0:08:12.02,Default,,0,0,0,,7 жыл бойы Ұлы Жын шайқасы демонстрациясын пайдаланып...
Dialogue: 0,0:08:12.19,0:08:15.19,Default,,0,0,0,,Бұл есікте сиқырлы күш жинақталған.
Dialogue: 0,0:08:16.40,0:08:18.78,Default,,0,0,0,,Жеті жыл бойы осылай жиналған сиқырлы күш...
Dialogue: 0,0:08:18.91,0:08:21.53,Default,,0,0,0,,Ол Этерионмен салыстырылатын сиқырлы күшке ие.
Dialogue: 0,0:08:21.95,0:08:26.33,Default,,0,0,0,,Жоқ! Сиқырлы кеңеске тиесілі қасиетті жарық...
Dialogue: 0,0:08:26.83,0:08:30.75,Default,,0,0,0,,Бүкіл елді жояды делінетін деңгеймен бірдей ме?
Dialogue: 0,0:08:31.29,0:08:34.67,Default,,0,0,0,,Оны айдаһарлар ордасына жіберіңіз.
Dialogue: 0,0:08:35.09,0:08:38.30,Default,,0,0,0,,Бұл тұтылу 2 жоспары
Dialogue: 0,0:08:44.35,0:08:45.60,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:08:46.43,0:08:49.89,Default,,0,0,0,,Сіз ханшайымға Тұтылу 2 туралы кеңес беруіңіз керек еді.
Dialogue: 0,0:08:50.19,0:08:52.86,Default,,0,0,0,,Ал 4-ші күні келгені өтірік.
Dialogue: 0,0:08:53.94,0:08:56.57,Default,,0,0,0,,Неліктен достарыңа өтірік айтасың?
Dialogue: 0,0:08:59.15,0:09:01.20,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:01.61,0:09:02.78,Default,,0,0,0,,Бұл мен-
Dialogue: 0,0:09:03.32,0:09:05.45,Default,,0,0,0,,Сен не үшін келдің?
Dialogue: 0,0:09:06.24,0:09:10.33,Default,,0,0,0,,Бүгінге дейін не істерімді білмей қаланы аралап жүрдім.
Dialogue: 0,0:09:13.21,0:09:13.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:14.54,0:09:16.05,Default,,0,0,0,,Біз бірдеңе істейміз
Dialogue: 0,0:09:16.46,0:09:17.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:25.97,0:09:30.44,Default,,0,0,0,,Біздің болашағымыз үшін рахмет.
Dialogue: 0,0:09:37.28,0:09:39.69,Default,,0,0,0,,Мен болашақты міндетті түрде өзгертемін
Dialogue: 0,0:09:48.04,0:09:50.66,Default,,0,0,0,,Барлығы дұрыс емес пе?
Dialogue: 0,0:09:50.91,0:09:54.75,Default,,0,0,0,,Бұл болашақ Люси өтірік айтады дегенді білдіре ме?
Dialogue: 0,0:09:54.88,0:09:56.38,Default,,0,0,0,,Неге әуре?
Dialogue: 0,0:09:56.92,0:09:59.05,Default,,0,0,0,,10 000-нан астам айдаһар
Dialogue: 0,0:09:59.55,0:10:01.88,Default,,0,0,0,,Тұтылу сиқыры
Dialogue: 0,0:10:02.18,0:10:04.93,Default,,0,0,0,,Кейбір мағынасы жоқ нәрселер бар.
Dialogue: 0,0:10:05.22,0:10:06.68,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:10:06.81,0:10:10.52,Default,,0,0,0,,Сіз болашақ туралы ақпаратты әдейі шатастырасыз ба?
Dialogue: 0,0:10:11.39,0:10:14.02,Default,,0,0,0,,Люсидің сөздері жалған ба?
Dialogue: 0,0:10:14.69,0:10:17.52,Default,,0,0,0,,Люсидің өзі ойдан шығарылған болмыс па?
Dialogue: 0,0:10:27.03,0:10:29.58,Default,,0,0,0,,Тағы бір рет айтшы, жарай ма?
Dialogue: 0,0:10:30.29,0:10:32.54,Default,,0,0,0,,Кім кім сияқты жақсы емес?
Dialogue: 0,0:10:37.46,0:10:38.59,Default,,0,0,0,,Алаяқ…
Dialogue: 0,0:10:39.34,0:10:41.76,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:10:41.88,0:10:42.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.09,0:10:46.18,Default,,0,0,0,,Мен бірте-бірте түсіне бастағандай болдым.
Dialogue: 0,0:10:47.01,0:10:49.89,Default,,0,0,0,,Неліктен Fairy Tail-ге қосылдыңыз?
Dialogue: 0,0:10:50.22,0:10:51.98,Default,,0,0,0,,(Баяндау) Бір күні адамсыз жүзуші кеме табылды.
Dialogue: 0,0:10:52.56,0:10:55.10,Default,,0,0,0,,Есіңде жоқ екені таңқаларлық емес.
Dialogue: 0,0:10:55.40,0:10:58.61,Default,,0,0,0,,Басымды қырған бала едім
Dialogue: 0,0:11:01.23,0:11:03.07,Default,,0,0,0,,Сіз болған гильдия
Dialogue: 0,0:11:03.24,0:11:07.24,Default,,0,0,0,,Мен Фантом Лордты сүйетін бала едім
Dialogue: 0,0:11:07.91,0:11:08.95,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:09.49,0:11:11.62,Default,,0,0,0,,Мен де өскенде...
Dialogue: 0,0:11:11.74,0:11:14.46,Default,,0,0,0,,Мен Фантом Лордқа қосылғым келді.
Dialogue: 0,0:11:15.46,0:11:19.46,Default,,0,0,0,,Алайда ол Fairy Tail-пен шайқаста жеңіліп қалды...
Dialogue: 0,0:11:19.92,0:11:21.63,Default,,0,0,0,,Гильдия таратылды
Dialogue: 0,0:11:22.59,0:11:24.80,Default,,0,0,0,,Қандай жағдай болмасын, сен...
Dialogue: 0,0:11:25.47,0:11:28.09,Default,,0,0,0,,жек көретін Fairy Tail тобына қосылды
Dialogue: 0,0:11:29.68,0:11:31.47,Default,,0,0,0,,Мен бұған сене алмадым.
Dialogue: 0,0:11:32.31,0:11:36.39,Default,,0,0,0,,I never thought I'd join the guild that crushed Phantom Lord.
Dialogue: 0,0:11:38.23,0:11:39.23,Default,,0,0,0,,Сіз —
Dialogue: 0,0:11:39.69,0:11:42.28,Default,,0,0,0,,Қандай да бір мағына болуы керек
Dialogue: 0,0:11:42.53,0:11:44.40,Default,,0,0,0,,Сенің ертегіде болуыңның мәні
Dialogue: 0,0:11:47.53,0:11:50.41,Default,,0,0,0,,Мен мұны түсіндім
Dialogue: 0,0:11:51.37,0:11:53.87,Default,,0,0,0,,Friends...right?
Dialogue: 0,0:11:56.54,0:11:59.46,Default,,0,0,0,,Сабретутта мұндай сана жоқ.
Dialogue: 0,0:12:00.75,0:12:03.34,Default,,0,0,0,,Біз Мастер сарбазымыз...
Dialogue: 0,0:12:03.55,0:12:04.76,Default,,0,0,0,,Пәрмен абсолютті-
Dialogue: 0,0:12:05.55,0:12:07.76,Default,,0,0,0,,Жеңіс абсолютті болды
Dialogue: 0,0:12:08.59,0:12:12.56,Default,,0,0,0,,If you're in a guild, cherish your friends.
Dialogue: 0,0:12:14.89,0:12:16.98,Default,,0,0,0,,Гильдия дегеніміз не?
Dialogue: 0,0:12:17.48,0:12:18.65,Default,,0,0,0,,Friends
Dialogue: 0,0:12:19.19,0:12:23.23,Default,,0,0,0,,Мен не үшін күресіп жатырмын?
Dialogue: 0,0:12:24.73,0:12:27.65,Default,,0,0,0,,Балалар, сендердің неге сонша күшті екендеріңді енді түсіндім.
Dialogue: 0,0:12:28.24,0:12:30.41,Default,,0,0,0,,Біз өз күшімізбен жеңе алмаймыз.
Dialogue: 0,0:12:31.41,0:12:34.04,Default,,0,0,0,,With a truly exceptionally strong young lady...
Dialogue: 0,0:12:34.54,0:12:38.12,Default,,0,0,0,,Except for Sting, who was awakened for Lecter.
Dialogue: 0,0:12:42.63,0:12:43.71,Default,,0,0,0,,Тұру
Dialogue: 0,0:12:45.34,0:12:47.67,Default,,0,0,0,,Сіз ештеңе түсінбейсіз
Dialogue: 0,0:12:50.34,0:12:51.09,Default,,0,0,0,,Gihi
Dialogue: 0,0:12:51.68,0:12:54.89,Default,,0,0,0,,Бақалар дос... иә?
Dialogue: 0,0:12:55.14,0:12:56.10,Default,,0,0,0,,Frog?
Dialogue: 0,0:12:56.77,0:12:58.85,Default,,0,0,0,,Ағын да солай ойлайды.
Dialogue: 0,0:12:59.19,0:13:00.77,Default,,0,0,0,,Frosch is a cat
Dialogue: 0,0:13:00.90,0:13:03.15,Default,,0,0,0,,Нақтырақ айтыңыз.
Dialogue: 0,0:13:03.27,0:13:03.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:05.90,0:13:06.90,Default,,0,0,0,,Не?
Dialogue: 0,0:13:15.49,0:13:18.75,Default,,0,0,0,,Иә, Фрош менің досым.
Dialogue: 0,0:13:21.33,0:13:22.92,Default,,0,0,0,,Алаяқ
Dialogue: 0,0:13:23.67,0:13:25.38,Default,,0,0,0,,I can't beat it.
Dialogue: 0,0:13:27.17,0:13:28.84,Default,,0,0,0,,Алаяқ
Dialogue: 0,0:13:33.22,0:13:34.64,Default,,0,0,0,,Алға қара
Dialogue: 0,0:13:35.68,0:13:39.52,Default,,0,0,0,,Жау әлі де алдыңызда тұр
Dialogue: 0,0:13:39.85,0:13:40.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:41.06,0:13:42.90,Default,,0,0,0,,Сіз кімсіз? Сен қайдасың?
Dialogue: 0,0:13:43.02,0:13:45.06,Default,,0,0,0,,А? Не болды?
Dialogue: 0,0:13:45.36,0:13:46.48,Default,,0,0,0,,Алаяқ
Dialogue: 0,0:13:47.36,0:13:49.32,Default,,0,0,0,,Kill Gajeel
Dialogue: 0,0:13:49.61,0:13:50.45,Default,,0,0,0,,Эй
Dialogue: 0,0:13:51.15,0:13:52.57,Default,,0,0,0,,Хи-хи
Dialogue: 0,0:13:52.99,0:13:55.66,Default,,0,0,0,,Бұл сенің тағдырың
Dialogue: 0,0:13:57.24,0:13:58.66,Default,,0,0,0,,Қайда!
Dialogue: 0,0:13:58.95,0:14:00.25,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:14:06.50,0:14:08.50,Default,,0,0,0,,I'm your shadow
Dialogue: 0,0:14:11.76,0:14:13.80,Default,,0,0,0,,Мен саған күшімді беремін
Dialogue: 0,0:14:14.59,0:14:16.60,Default,,0,0,0,,Kill Gajeel
Dialogue: 0,0:14:28.48,0:14:29.23,Default,,0,0,0,,Мұнда
Dialogue: 0,0:14:29.36,0:14:31.57,Default,,0,0,0,,Сіз бұл жолды жақсы білмейсіз.
Dialogue: 0,0:14:31.74,0:14:32.53,Default,,0,0,0,,Су Манасы, осы жанға ем бер.
Dialogue: 0,0:14:32.70,0:14:37.08,Default,,0,0,0,,Өйткені мен патшалық әскері барлығын тұтқынға алатын болашақтан аулақ болғым келді.
Dialogue: 0,0:14:37.24,0:14:38.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:38.58,0:14:40.91,Default,,0,0,0,,Жер асты зерттелді, солай ма?
Dialogue: 0,0:14:41.41,0:14:43.92,Default,,0,0,0,,Мен жақын арада сигналдық бомбаны көтергім келеді.
Dialogue: 0,0:14:44.17,0:14:46.83,Default,,0,0,0,,Барлығының уайымдағанына сенімдімін.
Dialogue: 0,0:14:52.26,0:14:53.13,Default,,0,0,0,,Біз көмектескіміз келеді, білесің бе.
Dialogue: 0,0:14:53.26,0:14:54.26,Default,,0,0,0,,Ол түрмеден қашқан адам.
Dialogue: 0,0:14:54.38,0:14:54.93,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,0:14:55.34,0:14:58.89,Default,,0,0,0,,Король әскері? Мен оның мұндай жерге қойылғанына сене алар емеспін.
Dialogue: 0,0:14:59.01,0:15:00.14,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:15:00.26,0:15:04.39,Default,,0,0,0,,Уайымдама, егер сиқырды қолдансаң, қолға түспейсің.
Dialogue: 0,0:15:04.52,0:15:05.40,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:15:05.52,0:15:07.06,Default,,0,0,0,,Әй, бұл!
Dialogue: 0,0:15:07.61,0:15:09.44,Default,,0,0,0,,Аркадиос мырза жоғалып кетті.
Dialogue: 0,0:15:09.57,0:15:10.90,Default,,0,0,0,,Юкино да жоқ.
Dialogue: 0,0:15:11.15,0:15:11.94,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:15:12.07,0:15:14.32,Default,,0,0,0,,Неліктен өзімшіл нәрсе жасайсың?
Dialogue: 0,0:15:16.74,0:15:20.28,Default,,0,0,0,,Сол рыцарьға қарамастан, мен Юкиноны жалғыз қалдыра алмаймын.
Dialogue: 0,0:15:20.70,0:15:22.33,Default,,0,0,0,,I'll be back
Dialogue: 0,0:15:22.87,0:15:23.54,Default,,0,0,0,,Мира!
Dialogue: 0,0:15:23.66,0:15:24.83,Default,,0,0,0,,Жоқ, бөлініңіз.
Dialogue: 0,0:15:25.29,0:15:27.08,Default,,0,0,0,,Барлығыңыз сақ болыңыздар.
Dialogue: 0,0:15:27.58,0:15:28.50,Default,,0,0,0,,Жоқ! Мен өлгім келмейді. Отбасымды көргім келеді.
Dialogue: 0,0:15:29.17,0:15:30.55,Default,,0,0,0,,We are here
Dialogue: 0,0:15:30.67,0:15:31.55,Default,,0,0,0,,О
Dialogue: 0,0:15:31.67,0:15:32.67,Default,,0,0,0,,Break through!
Dialogue: 0,0:15:33.09,0:15:35.26,Default,,0,0,0,,Мені ұстаңыз!
Dialogue: 0,0:15:35.97,0:15:38.09,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:15:38.34,0:15:39.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:42.18,0:15:42.77,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:43.14,0:15:44.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:46.73,0:15:47.85,Default,,0,0,0,,Mira-san
Dialogue: 0,0:15:48.56,0:15:49.69,Default,,0,0,0,,Юкино
Dialogue: 0,0:15:50.86,0:15:53.61,Default,,0,0,0,,Мен Чарльзды қорғаймын.
Dialogue: 0,0:15:54.28,0:15:55.70,Default,,0,0,0,,Бұл қобалжу сезімі...
Dialogue: 0,0:15:56.65,0:15:58.28,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:16:04.50,0:16:06.79,Default,,0,0,0,,Әй, кенет не болды?
Dialogue: 0,0:16:07.37,0:16:09.50,Default,,0,0,0,,Kill Gajeel
Dialogue: 0,0:16:10.17,0:16:11.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:11.92,0:16:13.88,Default,,0,0,0,,It's my destiny
Dialogue: 0,0:16:14.63,0:16:16.51,Default,,0,0,0,,Гррр...
Dialogue: 0,0:16:16.63,0:16:18.22,Default,,0,0,0,,Мықты болуың керек емес пе?
Dialogue: 0,0:16:18.89,0:16:20.80,Default,,0,0,0,,Мен саған күшімді беремін
Dialogue: 0,0:16:20.93,0:16:24.31,Default,,0,0,0,,Рұқсатсыз маған қарама.
Dialogue: 0,0:16:25.02,0:16:26.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:26.48,0:16:27.69,Default,,0,0,0,,Уау
Dialogue: 0,0:16:28.06,0:16:28.81,Default,,0,0,0,,Гаджил!
Dialogue: 0,0:16:29.73,0:16:30.94,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:16:31.06,0:16:33.23,Default,,0,0,0,,Мен сізді мазалаған бірдеңе айттым ба?
Dialogue: 0,0:16:34.23,0:16:35.32,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:16:39.95,0:16:41.53,Default,,0,0,0,,Кукукукукукукукку
Dialogue: 0,0:16:41.66,0:16:45.24,Default,,0,0,0,,Мен саған аз да болса күш беремін, Рог.
Dialogue: 0,0:16:45.95,0:16:46.66,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:16:47.16,0:16:48.33,Default,,0,0,0,,Бұл беделді Эден мектебі үшін сөзсіз ерекше қадам болды.
Dialogue: 0,0:16:48.87,0:16:52.67,Default,,0,0,0,,Тағдырды басқаратын көлеңке
Dialogue: 0,0:16:53.00,0:16:56.13,Default,,0,0,0,,Иә? Не айтып тұрсың...
Dialogue: 0,0:16:58.34,0:17:02.80,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ бұл бір-бірімізбен барынша күресуіміз керек дегенді білдіреді.
Dialogue: 0,0:17:03.26,0:17:04.10,Default,,0,0,0,,Егер мен солай істесем, Шукуна оны өзінің Инверсия формуласымен емдей алған болар еді.
Dialogue: 0,0:17:04.51,0:17:05.77,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:05.89,0:17:08.14,Default,,0,0,0,,Осы уақытқа дейін олар татуласқандай болды.
Dialogue: 0,0:17:08.27,0:17:10.85,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:17:10.98,0:17:12.61,Default,,0,0,0,,Гаджил, абай бол.
Dialogue: 0,0:17:12.98,0:17:14.61,Default,,0,0,0,,Темір айдаһар қылыш!
Dialogue: 0,0:17:17.69,0:17:18.86,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,0:17:19.86,0:17:21.99,Default,,0,0,0,,Көлеңкелі айдаһардың Ренякузені
Dialogue: 0,0:17:23.16,0:17:24.16,Default,,0,0,0,,Gajeel!
Dialogue: 0,0:17:24.28,0:17:25.49,Default,,0,0,0,,Rogue?
Dialogue: 0,0:17:31.96,0:17:33.00,Default,,0,0,0,,Who?
Dialogue: 0,0:17:33.33,0:17:35.80,Default,,0,0,0,,Қарғыс атқыр... қайда бардың?
Dialogue: 0,0:17:36.84,0:17:37.92,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:17:38.05,0:17:39.05,Default,,0,0,0,,​​О?
Dialogue: 0,0:17:39.30,0:17:40.88,Default,,0,0,0,,Көлеңке айдаһарының қиғаш соққысы!
Dialogue: 0,0:17:42.39,0:17:44.60,Default,,0,0,0,,Бірінші буын Бұл...
Dialogue: 0,0:17:44.72,0:17:47.01,Default,,0,0,0,,Бірдеңе иеленген сияқты
Dialogue: 0,0:17:47.18,0:17:48.14,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:17:48.27,0:17:49.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:50.31,0:17:54.02,Default,,0,0,0,,Иә? Бұрын көлеңкеге айналып кетсем де, мен сені әлі де ұстай алдым.
Dialogue: 0,0:17:54.15,0:17:56.11,Default,,0,0,0,,Сиқырдың сапасы өзгерді ме?
Dialogue: 0,0:17:56.52,0:17:59.28,Default,,0,0,0,,Өте зұлым...
Dialogue: 0,0:17:59.94,0:18:02.78,Default,,0,0,0,,Менің білімімде жоқ сиқырлы күш?
Dialogue: 0,0:18:02.91,0:18:03.91,Default,,0,0,0,,Уф…
Dialogue: 0,0:18:04.16,0:18:07.79,Default,,0,0,0,,Нацу Драгнил сияқты жақсы емес
Dialogue: 0,0:18:08.37,0:18:09.62,Default,,0,0,0,,Теме...
Dialogue: 0,0:18:09.75,0:18:11.87,Default,,0,0,0,,Бұл Нацу Драгниль де...
Dialogue: 0,0:18:12.46,0:18:15.79,Default,,0,0,0,,Ол қазір менің жауым емес.
Dialogue: 0,0:18:25.72,0:18:26.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.43,0:18:27.89,Default,,0,0,0,,Бұл сиқырлы күш...
Dialogue: 0,0:18:28.10,0:18:29.22,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:18:30.22,0:18:31.73,Default,,0,0,0,,Қаладан
Dialogue: 0,0:18:31.85,0:18:32.98,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:18:33.69,0:18:36.81,Default,,0,0,0,,Болашақ Люси шайқаста қалды.
Dialogue: 0,0:18:37.57,0:18:40.74,Default,,0,0,0,,Егер Нацу мен басқалары бірге болса, үрейленудің қажеті жоқ.
Dialogue: 0,0:18:41.19,0:18:42.45,Default,,0,0,0,,Түс, Люси.
Dialogue: 0,0:18:42.57,0:18:43.49,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:43.95,0:18:44.49,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:44.61,0:18:46.37,Default,,0,0,0,,Вааах!
Dialogue: 0,0:18:46.49,0:18:48.87,Default,,0,0,0,,Бұл балалар кішкентай болса да қаншалықты күшті?
Dialogue: 0,0:18:48.99,0:18:50.75,Default,,0,0,0,,Сиқырға қарсы жасақ шақырыңыз
Dialogue: 0,0:18:51.04,0:18:52.83,Default,,0,0,0,,Мен сені ары қарай жібермеймін!
Dialogue: 0,0:18:53.21,0:18:54.12,Default,,0,0,0,,Ei
Dialogue: 0,0:18:54.54,0:18:56.25,Default,,0,0,0,,О!
Dialogue: 0,0:18:56.63,0:18:57.84,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:18:59.88,0:19:00.92,Default,,0,0,0,,Гуах
Dialogue: 0,0:19:01.17,0:19:02.21,Default,,0,0,0,,Сіз белгіге жеттіңіз.
Dialogue: 0,0:19:02.34,0:19:04.09,Default,,0,0,0,,2-3-ші толқынды дайындау
Dialogue: 0,0:19:04.43,0:19:05.97,Default,,0,0,0,,Сиқыр?
Dialogue: 0,0:19:06.09,0:19:07.51,Default,,0,0,0,,Олар қандай?
Dialogue: 0,0:19:07.85,0:19:08.97,Default,,0,0,0,,Нацу!
Dialogue: 0,0:19:09.10,0:19:10.85,Default,,0,0,0,,Патшалықта сиқырлы бірлік те бар...
Dialogue: 0,0:19:11.22,0:19:14.85,Default,,0,0,0,,Уау, мен таң қалдым.
Dialogue: 0,0:19:14.98,0:19:17.77,Default,,0,0,0,,Сіздің нағыз жұмысыңыз ретінде осындай сиқырмен айналысуға ынтаңыз бар ма?
Dialogue: 0,0:19:18.61,0:19:19.52,Default,,0,0,0,,Жұмыс істемейді
Dialogue: 0,0:19:19.65,0:19:21.48,Default,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:19:21.61,0:19:22.15,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:19:23.28,0:19:25.61,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:19:25.99,0:19:26.70,Default,,0,0,0,,О, Корра
Dialogue: 0,0:19:26.82,0:19:27.91,Default,,0,0,0,,Мен күтпеймін
Dialogue: 0,0:19:28.03,0:19:30.16,Default,,0,0,0,,Өз бетімен шықпа
Dialogue: 0,0:19:30.28,0:19:31.54,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:32.08,0:19:33.83,Default,,0,0,0,,Ақыл-есіңді сақта.
Dialogue: 0,0:19:33.95,0:19:37.75,Default,,0,0,0,,Oh, me? Фиор патшалығының ең күшті сиқырлы сарбазы
Dialogue: 0,0:19:37.88,0:19:38.79,Default,,0,0,0,,Тым көп!
Dialogue: 0,0:19:39.34,0:19:42.17,Default,,0,0,0,,Не, мына жігіт сиқыршы ма?
Dialogue: 0,0:19:42.30,0:19:43.84,Default,,0,0,0,,Бұл аспан рухы емес пе?
Dialogue: 0,0:19:43.96,0:19:45.47,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:19:45.59,0:19:47.05,Default,,0,0,0,,Бұл жаза, ханшайым.
Dialogue: 0,0:19:47.51,0:19:52.10,Default,,0,0,0,,Әдемі Нефрит ханшайымы үшін мен бар күшімді саламын.
Dialogue: 0,0:19:52.22,0:19:52.89,Default,,0,0,0,,Ball!
Dialogue: 0,0:19:53.18,0:19:54.31,Default,,0,0,0,,Доп!
Dialogue: 0,0:19:54.43,0:19:56.31,Default,,0,0,0,,Гяаа!
Dialogue: 0,0:19:56.73,0:19:58.44,Default,,0,0,0,,Одақтастарды тарту
Dialogue: 0,0:19:58.56,0:20:00.52,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:20:00.65,0:20:02.32,Default,,0,0,0,,Көптеген жолдармен.
Dialogue: 0,0:20:06.11,0:20:08.24,Default,,0,0,0,,Бұл өте күшті, солай емес пе?
Dialogue: 0,0:20:08.36,0:20:10.78,Default,,0,0,0,,Мен өзімнің физикалық күшіме сенімдімін.
Dialogue: 0,0:20:10.91,0:20:12.66,Default,,0,0,0,,Мынау – әбігер.
Dialogue: 0,0:20:12.79,0:20:14.41,Default,,0,0,0,,Кешіріңіз, мүмкін емес.
Dialogue: 0,0:20:14.54,0:20:15.33,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:20:15.71,0:20:19.83,Default,,0,0,0,,Егер сіз өзіңізді ең күштімін деп атағыңыз келсе, оны бар күшіңізбен жасаңыз.
Dialogue: 0,0:20:20.17,0:20:23.67,Default,,0,0,0,,Жарайды, мен сіздің күшіңізді толық қабылдаймын.
Dialogue: 0,0:20:23.80,0:20:24.84,Default,,0,0,0,,Қаншама тер!
Dialogue: 0,0:20:25.59,0:20:27.34,Default,,0,0,0,,От айдаһарының темір жұдырығы!
Dialogue: 0,0:20:28.01,0:20:31.05,Default,,0,0,0,,Мен шаршадым!
Dialogue: 0,0:20:35.98,0:20:38.85,Default,,0,0,0,,Аға... гаха...
Dialogue: 0,0:20:39.65,0:20:43.44,Default,,0,0,0,,Фуфуфуфухаха Бұл Гаджил ба?
Dialogue: 0,0:20:44.28,0:20:45.78,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:20:45.90,0:20:46.86,Default,,0,0,0,,Гуга…
Dialogue: 0,0:20:47.19,0:20:49.49,Default,,0,0,0,,Тоқта, өлесің.
Dialogue: 0,0:20:49.74,0:20:51.45,Default,,0,0,0,,Гаджил!
Dialogue: 0,0:20:52.45,0:20:54.45,Default,,0,0,0,,Ағым Мен баруым керек
Dialogue: 0,0:20:55.87,0:20:58.50,Default,,0,0,0,,Маған Рогты қайтару керек.
Dialogue: 0,0:20:59.29,0:21:02.04,Default,,0,0,0,,Көлеңке сені тоздырады
Dialogue: 0,0:21:02.59,0:21:05.59,Default,,0,0,0,,Және мәңгілікке жоғалады.
Dialogue: 0,0:21:06.59,0:21:09.51,Default,,0,0,0,,Қараңғыда ұйықта
Dialogue: 0,0:21:10.18,0:21:10.84,Default,,0,0,0,,Гихи
Dialogue: 0,0:21:11.59,0:21:16.02,Default,,0,0,0,,Саламандер мұны істей алса, мен мұны істей алмаймын.
Dialogue: 0,0:21:17.27,0:21:18.73,Default,,0,0,0,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:21:22.19,0:21:22.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:23.06,0:21:25.36,Default,,0,0,0,,Гихихихихи
Dialogue: 0,0:21:25.65,0:21:26.90,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:21:27.28,0:21:29.86,Default,,0,0,0,,Сіз көлеңкені жедіңіз бе?
Dialogue: 0,0:21:29.99,0:21:32.70,Default,,0,0,0,,Күтілгендей, мен мұны істеймін.
Dialogue: 0,0:21:32.82,0:21:35.62,Default,,0,0,0,,Сонымен сіз көлеңке атрибутын сіңірдіңіз бе?
Dialogue: 0,0:21:36.12,0:21:40.54,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін, бірақ кет сол денеден.
Dialogue: 0,0:21:40.66,0:21:42.33,Default,,0,0,0,,Rogue-тен бе?
Dialogue: 0,0:21:42.46,0:21:46.13,Default,,0,0,0,,Оның есімі Rogue емес.
Dialogue: 0,0:21:47.05,0:21:50.38,Default,,0,0,0,,Бұл Райос, менің інім.
Dialogue: 0,0:21:51.88,0:21:54.55,Default,,0,0,0,,Сіз маған тамсанған жоқсыз, солай ма?
Dialogue: 0,0:21:55.47,0:21:58.68,Default,,0,0,0,,Менің ол кезде ондай жігіт болмағанымның себебі...
Dialogue: 0,0:21:58.81,0:22:00.81,Default,,0,0,0,,Мен жақсы білемін
Dialogue: 0,0:22:02.10,0:22:05.90,Default,,0,0,0,,Менен қорқып кеттің
Dialogue: 0,0:22:06.27,0:22:07.57,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:08.90,0:22:12.91,Default,,0,0,0,,Мен тағы бір рет еске саламын.
Dialogue: 0,0:22:13.91,0:22:15.91,Default,,0,0,0,,Менің қорқынышым
Dialogue: 0,0:22:17.08,0:22:18.37,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:19.29,0:22:21.04,Default,,0,0,0,,Темір көлеңкелі айдаһар?
Dialogue: 0,0:23:46.71,0:23:52.71,Default,,0,0,0,,~♪
Dialogue: 0,0:23:55.76,0:23:58.72,Default,,0,0,0,,Гаджил, ол көлеңкелерді жейді.
Dialogue: 0,0:23:58.84,0:24:02.35,Default,,0,0,0,,Сіз адамдар туралы айта аласыз ба? Тіпті Нацу отты жейді.
Dialogue: 0,0:24:02.56,0:24:04.56,Default,,0,0,0,,Иә? Көлеңке мен жалынның айырмашылығы бар.
Dialogue: 0,0:24:04.98,0:24:07.35,Default,,0,0,0,,От – тамақ, ол да дәмді.
Dialogue: 0,0:24:07.48,0:24:09.77,Default,,0,0,0,,Ах... бұл Нацуға қатысты.
Dialogue: 0,0:24:09.90,0:24:13.32,Default,,0,0,0,,Мен көлеңкені жейтін адамдарды түсінбеймін.
Dialogue: 0,0:24:13.44,0:24:16.03,Default,,0,0,0,,Маған екеуі де бірдей сияқты.
Dialogue: 0,0:24:16.61,0:24:18.32,Default,,0,0,0,,Келесі жолы «Гекирай!»
Dialogue: 0,0:24:18.45,0:24:21.45,Default,,0,0,0,,Келесі жолы мен Happy-ге өзім ұсынатын дәмді жалындарды үйретемін.
Dialogue: 0,0:24:21.58,0:24:24.33,Default,,0,0,0,,Нацу Жарайды.
Dialogue: 0,0:24:25.83,0:24:31.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory