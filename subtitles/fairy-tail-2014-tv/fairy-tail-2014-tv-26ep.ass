Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.20,0:00:08.45,Default,,0,0,0,,Мен келдім, қайтып келдім
Dialogue: 0,0:00:08.62,0:00:10.83,Default,,0,0,0,,Тез, барлығы осында, мында
Dialogue: 0,0:00:11.24,0:00:12.45,Default,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:00:12.62,0:00:14.33,Default,,0,0,0,,Барлығыңызға қош келдіңіздер
Dialogue: 0,0:00:14.75,0:00:16.08,Default,,0,0,0,,Барлығы
Dialogue: 0,0:00:16.25,0:00:18.42,Default,,0,0,0,,Ұлы жын шайқасында жеңіске жеткен гильдия-
Dialogue: 0,0:00:18.59,0:00:21.84,Default,,0,0,0,,Үлкен қошеметпен қарсы алайық.
Dialogue: 0,0:00:23.21,0:00:26.34,Default,,0,0,0,,Ертегінің салтанатты оралуы
Dialogue: 0,0:00:29.01,0:00:30.31,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:00:30.47,0:00:31.85,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:01:54.81,0:02:00.77,Default,,0,0,0,,~♪
Dialogue: 0,0:02:02.56,0:02:03.86,Default,,0,0,0,,Сіз жеңдіңіз!
Dialogue: 0,0:02:04.02,0:02:05.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:05.69,0:02:07.36,Default,,0,0,0,,Адамдардың таңғажайып саны
Dialogue: 0,0:02:07.53,0:02:10.57,Default,,0,0,0,,Магнолия маңынан адамдар келе жатқан сияқты.
Dialogue: 0,0:02:10.86,0:02:14.58,Default,,0,0,0,,Ия, жеңіс!
Dialogue: 0,0:02:14.87,0:02:17.33,Default,,0,0,0,,Мира-чан, мына жаққа қарашы.
Dialogue: 0,0:02:17.50,0:02:18.62,Default,,0,0,0,,Yes
Dialogue: 0,0:02:18.79,0:02:20.58,Default,,0,0,0,,Сен істедің, Лисанна.
Dialogue: 0,0:02:20.92,0:02:23.08,Default,,0,0,0,,Тоқта, Эльф-нии-чан.
Dialogue: 0,0:02:23.50,0:02:25.38,Default,,0,0,0,,О, бұл керемет
Dialogue: 0,0:02:25.55,0:02:27.34,Default,,0,0,0,,Біз ең жақсымыз
Dialogue: 0,0:02:27.67,0:02:30.59,Default,,0,0,0,,Қолдауларыңыз үшін барлығыңызға рахмет
Dialogue: 0,0:02:30.76,0:02:32.89,Default,,0,0,0,,Оны қытырлақ етіп жасаңыз
Dialogue: 0,0:02:33.05,0:02:35.10,Default,,0,0,0,,Бұл мерекелік сусын.
Dialogue: 0,0:02:35.26,0:02:37.35,Default,,0,0,0,,Уайымдама, Кана.
Dialogue: 0,0:02:50.28,0:02:51.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:01.46,0:03:02.21,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:19.02,0:03:20.27,Default,,0,0,0,,Мистер Грей
Dialogue: 0,0:03:20.68,0:03:21.93,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:03:25.77,0:03:27.73,Default,,0,0,0,,Люси, сен жақсы орындадың.
Dialogue: 0,0:03:27.90,0:03:29.82,Default,,0,0,0,,А, үй иесі, эй, Люси-чан.
Dialogue: 0,0:03:30.15,0:03:32.24,Default,,0,0,0,,Бірақ жалға алу басқа әңгіме.
Dialogue: 0,0:03:33.49,0:03:34.49,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:35.28,0:03:38.28,Default,,0,0,0,,Эрза-сан, Пандемониум керемет болды.
Dialogue: 0,0:03:38.45,0:03:39.91,Default,,0,0,0,,Жоқ, бұл Кагура шайқасы.
Dialogue: 0,0:03:40.08,0:03:41.83,Default,,0,0,0,,Иә? Бұл Минерваға қарсы шайқас.
Dialogue: 0,0:03:42.37,0:03:44.12,Default,,0,0,0,,Бұл сіз айта алатын нәрсе.
Dialogue: 0,0:03:44.29,0:03:45.83,Default,,0,0,0,,Барлығы қарап тұрды, солай ма?
Dialogue: 0,0:03:46.71,0:03:49.34,Default,,0,0,0,,Мен қаладағылардың бәріне жақсы нәрсе көрсетемін.
Dialogue: 0,0:03:50.05,0:03:51.34,Default,,0,0,0,,Яан
Dialogue: 0,0:03:51.63,0:03:53.22,Default,,0,0,0,,Патша тәжі?
Dialogue: 0,0:03:53.38,0:03:54.84,Default,,0,0,0,,Сіз оны алдыңыз ба?
Dialogue: 0,0:03:55.13,0:03:56.76,Default,,0,0,0,,А, бұл емес.
Dialogue: 0,0:03:56.93,0:03:59.31,Default,,0,0,0,,Сіз оны алдыңыз ба...
Dialogue: 0,0:04:00.35,0:04:04.02,Default,,0,0,0,,Жеңістің дәлелі: Испания кубогы!
Dialogue: 0,0:04:05.56,0:04:07.27,Default,,0,0,0,,Мен сене алар емеспін.
Dialogue: 0,0:04:07.44,0:04:09.61,Default,,0,0,0,,Біз жеңімпазбыз!
Dialogue: 0,0:04:09.77,0:04:12.15,Default,,0,0,0,,Біз әрқашан соңғы орында болдық.
Dialogue: 0,0:04:12.32,0:04:13.74,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:04:13.90,0:04:15.36,Default,,0,0,0,,Ия иә
Dialogue: 0,0:04:15.66,0:04:18.37,Default,,0,0,0,,Кел, Ромео, оны жоғары көтер.
Dialogue: 0,0:04:18.53,0:04:19.49,Default,,0,0,0,,О
Dialogue: 0,0:04:21.66,0:04:24.50,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:04:28.00,0:04:29.67,Default,,0,0,0,,«Сыйлық»
Dialogue: 0,0:04:35.05,0:04:38.47,Default,,0,0,0,,Мистер Грей, мен не болғанын білмеймін, бірақ...
Dialogue: 0,0:04:38.64,0:04:41.72,Default,,0,0,0,,Өзің солай көрінсең, бәріне жаман.
Dialogue: 0,0:04:45.06,0:04:46.14,Default,,0,0,0,,That's right.
Dialogue: 0,0:04:47.06,0:04:49.23,Default,,0,0,0,,Ол үшін қолымнан келгенше күлуім керек.
Dialogue: 0,0:04:50.73,0:04:51.65,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:52.07,0:04:55.40,Default,,0,0,0,,Жоқ, бұл өте керемет, бұл күлкілі.
Dialogue: 0,0:04:55.65,0:05:00.91,Default,,0,0,0,,Ал, Магнолия мэрі енді сізге естелік сыйлық сыйлайды.
Dialogue: 0,0:05:01.08,0:05:05.20,Default,,0,0,0,,Кәдесый? Сіз соншалықты қамқорлық жасасаңыз да
Dialogue: 0,0:05:05.83,0:05:08.67,Default,,0,0,0,,Құрметті Fairy Tail мүшелері, осы жерді басыңыз.
Dialogue: 0,0:05:08.83,0:05:09.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:09.58,0:05:10.21,Default,,0,0,0,,Уау
Dialogue: 0,0:05:10.67,0:05:13.34,Default,,0,0,0,,Ертегі біздің қаламыздың құрметі.
Dialogue: 0,0:05:13.50,0:05:16.92,Default,,0,0,0,,Сондықтан мен гильдияны жөндеп, сізге ұсынғым келеді.
Dialogue: 0,0:05:18.84,0:05:20.51,Default,,0,0,0,,Гильдия қалыпты жағдайға оралды.
Dialogue: 0,0:05:20.68,0:05:21.68,Default,,0,0,0,,Айса~
Dialogue: 0,0:05:22.01,0:05:24.68,Default,,0,0,0,,Әкім, сіз...
Dialogue: 0,0:05:34.44,0:05:39.20,Default,,0,0,0,,Мен бұл қаланы қатты жақсы көремін
Dialogue: 0,0:05:43.83,0:05:44.70,Default,,0,0,0,,Киккикки…
Dialogue: 0,0:05:45.62,0:05:47.83,Default,,0,0,0,,Кики…
Dialogue: 0,0:05:55.71,0:05:58.13,Default,,0,0,0,,Енді бүгін жұмысты қайта бастаңыз.
Dialogue: 0,0:05:58.30,0:06:02.01,Default,,0,0,0,,Ұлы жын шайқасында мен мүлдем жұмыс істей алмадым.
Dialogue: 0,0:06:02.18,0:06:03.72,Default,,0,0,0,,Ынталы болайық
Dialogue: 0,0:06:06.93,0:06:10.06,Default,,0,0,0,,Эй, тағы стейк қосыңызшы.
Dialogue: 0,0:06:10.39,0:06:11.60,Default,,0,0,0,,Бұл да ауыстыру
Dialogue: 0,0:06:11.77,0:06:14.73,Default,,0,0,0,,Иә, иә, екеуіңнің де тәбеттерің керемет.
Dialogue: 0,0:06:15.07,0:06:17.82,Default,,0,0,0,,Мен жұмыстан үйге келдім, қарным ашты.
Dialogue: 0,0:06:17.99,0:06:19.74,Default,,0,0,0,,Тамақ ішіп болған соң, мен қайтадан шығамын.
Dialogue: 0,0:06:23.53,0:06:27.70,Default,,0,0,0,,Бұл өте жанды, бұрынғыдан басқа гильдия сияқты.
Dialogue: 0,0:06:28.00,0:06:29.75,Default,,0,0,0,,Эрза мен Грей жоқ.
Dialogue: 0,0:06:30.12,0:06:32.92,Default,,0,0,0,,Олар Вэндимен жұмыс істемекші.
Dialogue: 0,0:06:33.04,0:06:34.09,Default,,0,0,0,,Чарльз да
Dialogue: 0,0:06:34.25,0:06:34.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:35.09,0:06:38.71,Default,,0,0,0,,Чарльз: Маған ештеңе айтпай кетіп қалдың ба?
Dialogue: 0,0:06:38.88,0:06:40.26,Default,,0,0,0,,Бұл оңай жұмыс болғандықтан...
Dialogue: 0,0:06:40.38,0:06:43.26,Default,,0,0,0,,Олар өз бетінше жеткілікті екенін айтты.
Dialogue: 0,0:06:43.43,0:06:46.10,Default,,0,0,0,,Біз де ұтыла алмаймыз. Барайық.
Dialogue: 0,0:06:48.77,0:06:50.56,Default,,0,0,0,,Сіз қандай жұмыс жасайсыз?
Dialogue: 0,0:06:50.73,0:06:54.36,Default,,0,0,0,,Мен жабайы болып, тойып жейтін жұмыс алғым келеді.
Dialogue: 0,0:06:54.73,0:06:58.32,Default,,0,0,0,,Хмм, бұл жақсы.
Dialogue: 0,0:07:00.03,0:07:01.65,Default,,0,0,0,,Мен бұл жұмысты аламын.
Dialogue: 0,0:07:02.41,0:07:05.62,Default,,0,0,0,,Мен түсіндім. Орналасқан жері - Дромерс ауылы.
Dialogue: 0,0:07:05.78,0:07:07.58,Default,,0,0,0,,Дромерлер ауылы?
Dialogue: 0,0:07:07.74,0:07:09.37,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:07:09.70,0:07:13.62,Default,,0,0,0,,Жер астын зерттеген дұрыс болар еді, өйткені ол жерде карталар мен материалдар бар.
Dialogue: 0,0:07:17.92,0:07:19.84,Default,,0,0,0,,Меңді жою жұмыстары?
Dialogue: 0,0:07:20.38,0:07:24.93,Default,,0,0,0,,Иә, меңдер жерді бұзып жатыр, мен қиналдым, сондықтан олардың жойылуын қалаймын.
Dialogue: 0,0:07:25.09,0:07:28.10,Default,,0,0,0,,Бұл жерден үш сағаттық күйме жол болды.
Dialogue: 0,0:07:28.26,0:07:30.06,Default,,0,0,0,,Ат арбасымен үш сағат?
Dialogue: 0,0:07:32.81,0:07:35.77,Default,,0,0,0,,Уф, жиіркенішті
Dialogue: 0,0:07:35.94,0:07:39.48,Default,,0,0,0,,Қозғалыс ауруымен бірдеңе жасауға болады ма деп ойлаймын.
Dialogue: 0,0:07:42.11,0:07:42.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:42.90,0:07:44.20,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:44.36,0:07:47.03,Default,,0,0,0,,Мен бірінші буын барын сезіндім.
Dialogue: 0,0:07:49.74,0:07:51.54,Default,,0,0,0,,Мен қателесіп жатырмын деп ойлаймын.
Dialogue: 0,0:08:01.17,0:08:03.84,Default,,0,0,0,,Қонақтар келді.
Dialogue: 0,0:08:04.47,0:08:05.84,Default,,0,0,0,,Не? Уау
Dialogue: 0,0:08:06.01,0:08:06.89,Default,,0,0,0,,Не? Мынау
Dialogue: 0,0:08:07.22,0:08:10.72,Default,,0,0,0,,Жер кенет лайланып кетті.
Dialogue: 0,0:08:10.89,0:08:14.94,Default,,0,0,0,,Вагон осы жерден келесі аялдамаға дейін айналма жолмен жүреді.
Dialogue: 0,0:08:15.10,0:08:17.27,Default,,0,0,0,,Ой... не болып жатыр? Бұл
Dialogue: 0,0:08:17.44,0:08:20.94,Default,,0,0,0,,Уау, өте қуаныштымын. Мұнда балық көп болуы керек, солай ма?
Dialogue: 0,0:08:21.11,0:08:23.90,Default,,0,0,0,,Жоқ, жоқ, бұл бастапқыда қарапайым жер.
Dialogue: 0,0:08:24.65,0:08:26.20,Default,,0,0,0,,Эй
Dialogue: 0,0:08:26.57,0:08:31.79,Default,,0,0,0,,Бұл ертегілер. Мен осы ауылдың ауыл бастығымын.
Dialogue: 0,0:08:35.16,0:08:37.46,Default,,0,0,0,,Бұл меңнің жұмысы ма?
Dialogue: 0,0:08:37.62,0:08:41.92,Default,,0,0,0,,Дұрыс, жерді бұзып, былай болып қалды.
Dialogue: 0,0:08:42.09,0:08:46.34,Default,,0,0,0,,Мең қазған шұңқыр жер асты суына соғылып, су атқылайды.
Dialogue: 0,0:08:46.51,0:08:50.22,Default,,0,0,0,,Меңдер жойылса, жер асты сулары табиғи түрде тоқтауы керек.
Dialogue: 0,0:08:50.39,0:08:52.77,Default,,0,0,0,,Мен мұндай далада жұмыс істей алмаймын.
Dialogue: 0,0:08:52.93,0:08:56.56,Default,,0,0,0,,Өтінемін, тітіркендіргіш меңнен құтылыңыз.
Dialogue: 0,0:08:56.94,0:08:59.31,Default,,0,0,0,,Түсіндім, маған қалдыр!
Dialogue: 0,0:09:04.65,0:09:07.74,Default,,0,0,0,,...Бірақ мең қайда?
Dialogue: 0,0:09:08.16,0:09:10.07,Default,,0,0,0,,Нацу, мұқият қарашы.
Dialogue: 0,0:09:10.53,0:09:13.83,Default,,0,0,0,,Жарайды, мең бетін көрсетсе, мен бірден айтамын.
Dialogue: 0,0:09:14.00,0:09:17.42,Default,,0,0,0,,Сіз бұл үлкен мең дедіңіз, бірақ ол қаншалықты үлкен?
Dialogue: 0,0:09:17.58,0:09:20.84,Default,,0,0,0,,Ал, мең - мең, сондықтан бұл үлкен мәселе емес...
Dialogue: 0,0:09:21.88,0:09:23.34,Default,,0,0,0,,Уау! не?
Dialogue: 0,0:09:31.64,0:09:32.72,Default,,0,0,0,,Бұл мең ме?
Dialogue: 0,0:09:32.89,0:09:34.60,Default,,0,0,0,,Бұл қайық тым кішкентай
Dialogue: 0,0:09:34.77,0:09:36.52,Default,,0,0,0,,Могу~
Dialogue: 0,0:09:37.35,0:09:39.48,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:09:40.44,0:09:41.69,Default,,0,0,0,,Жоқ, бұл лай
Dialogue: 0,0:09:41.86,0:09:43.36,Default,,0,0,0,,Нацу, маған көмектес!
Dialogue: 0,0:09:43.73,0:09:44.36,Default,,0,0,0,,​​Күте тұрыңыз!
Dialogue: 0,0:09:46.86,0:09:47.86,Default,,0,0,0,,Мас...
Dialogue: 0,0:09:48.11,0:09:49.20,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:09:49.53,0:09:51.37,Default,,0,0,0,,Мог~
Dialogue: 0,0:09:51.53,0:09:53.12,Default,,0,0,0,,Мог~ Вааааааааааааааааааааааааааааа
Dialogue: 0,0:09:53.33,0:09:54.45,Default,,0,0,0,,Мог~
Dialogue: 0,0:09:54.95,0:09:56.37,Default,,0,0,0,,Гяаааааааааааааааааааа
Dialogue: 0,0:09:57.04,0:09:59.58,Default,,0,0,0,,Тоңып, қашпа. Бөлшектеп қашасың!
Dialogue: 0,0:09:59.75,0:10:01.88,Default,,0,0,0,,Жарайды, сіз меңді адастырып жатырсыз.
Dialogue: 0,0:10:02.21,0:10:04.13,Default,,0,0,0,,Дәлірек айтқанда, эй, ол ұша алады.
Dialogue: 0,0:10:04.30,0:10:05.88,Default,,0,0,0,,А, мен ғана алдап жүрмін
Dialogue: 0,0:10:08.34,0:10:08.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:09.26,0:10:11.51,Default,,0,0,0,,Не, сен маған неге келе жатырсың?
Dialogue: 0,0:10:11.68,0:10:12.89,Default,,0,0,0,,Мог~
Dialogue: 0,0:10:13.76,0:10:15.35,Default,,0,0,0,,Ой...
Dialogue: 0,0:10:15.85,0:10:17.31,Default,,0,0,0,,Люси, мен қазір барамын.
Dialogue: 0,0:10:17.48,0:10:19.14,Default,,0,0,0,,Могу~
Dialogue: 0,0:10:21.69,0:10:23.73,Default,,0,0,0,,Хаа... Бұл көмектесті.
Dialogue: 0,0:10:23.90,0:10:26.61,Default,,0,0,0,,Нацу Люси Хаппи
Dialogue: 0,0:10:27.11,0:10:29.61,Default,,0,0,0,,Барлығына не болды?
Dialogue: 0,0:10:29.78,0:10:31.91,Default,,0,0,0,,Ондай жерде балшықта ойнап жүрсің бе?
Dialogue: 0,0:10:32.20,0:10:32.99,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:10:35.16,0:10:39.33,Default,,0,0,0,,Не туралы айтып тұрғаныңызды түсінеміз. Олай болса, өз көмегімізді береміз.
Dialogue: 0,0:10:39.50,0:10:42.37,Default,,0,0,0,,Дегенмен, сіз сыйлықтың бір бөлігін аласыз.
Dialogue: 0,0:10:42.54,0:10:45.88,Default,,0,0,0,,Ия, Эльза мен басқалары осында болса, меңді жеңе аламыз.
Dialogue: 0,0:10:46.17,0:10:49.22,Default,,0,0,0,,Сонда бұл шынымен мең ме?
Dialogue: 0,0:10:49.38,0:10:50.76,Default,,0,0,0,,Саана
Dialogue: 0,0:10:50.93,0:10:52.43,Default,,0,0,0,,Жұмыстан үйге келе жатырсыз ба?
Dialogue: 0,0:10:52.64,0:10:55.93,Default,,0,0,0,,Иә, мен қарақшыларды жою үшін түнеп жүрдім.
Dialogue: 0,0:10:56.14,0:10:59.31,Default,,0,0,0,,Салыстырмалы түрде сіз меңмен күресіп жатырсыз ба?
Dialogue: 0,0:10:59.48,0:11:02.19,Default,,0,0,0,,Ұлы шайқаста жеңіске жеткен гильдия есімі есте қалады.
Dialogue: 0,0:11:02.39,0:11:04.73,Default,,0,0,0,,Егер сіз шағымдансаңыз, үйге барыңыз.
Dialogue: 0,0:11:04.90,0:11:07.11,Default,,0,0,0,,«Мен саған көмектесемін» деген сөз бар ма?
Dialogue: 0,0:11:07.27,0:11:09.32,Default,,0,0,0,,Мен мұны сұраған жоқпын.
Dialogue: 0,0:11:09.49,0:11:10.95,Default,,0,0,0,,Ұрысты тоқтатыңыз!
Dialogue: 0,0:11:11.24,0:11:11.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:12.28,0:11:14.70,Default,,0,0,0,,Бірақ жер лай...
Dialogue: 0,0:11:14.87,0:11:17.70,Default,,0,0,0,,Мен бұл меңнің қайда жасырынып жатқанын білмеймін.
Dialogue: 0,0:11:18.20,0:11:20.45,Default,,0,0,0,,Жарайды, менде жақсы ой бар.
Dialogue: 0,0:11:21.50,0:11:25.17,Default,,0,0,0,,Сағат есігін ашыңыз Horologium
Dialogue: 0,0:11:28.38,0:11:31.09,Default,,0,0,0,,Бәріне сәлем, біраз уақыт өтті.
Dialogue: 0,0:11:34.39,0:11:36.18,Default,,0,0,0,,Нацу, қояйық~
Dialogue: 0,0:11:36.35,0:11:38.76,Default,,0,0,0,,Ақырын жүріңіз, абай болыңыз.
Dialogue: 0,0:11:38.93,0:11:42.64,Default,,0,0,0,,«Мен оны асыға күтемін».
Dialogue: 0,0:11:42.89,0:11:47.23,Default,,0,0,0,,Дегенмен, хоролог ретінде мен өзімді жайсыз сезінемін.
Dialogue: 0,0:11:49.07,0:11:51.74,Default,,0,0,0,,Бұл қиын болады, бірақ бар күшіңізді салыңыз.
Dialogue: 0,0:11:51.90,0:11:53.86,Default,,0,0,0,,Мен сені кейінірек жуамын.
Dialogue: 0,0:11:54.11,0:11:56.24,Default,,0,0,0,,Тохохо…
Dialogue: 0,0:12:05.75,0:12:07.84,Default,,0,0,0,,Уау, мен ештеңе көрмеймін.
Dialogue: 0,0:12:08.13,0:12:11.84,Default,,0,0,0,,Мен сезімталмын, сондықтан ең кішкентай дірілді де анықтай аламын.
Dialogue: 0,0:12:12.01,0:12:14.80,Default,,0,0,0,,Бірдеңе жақындаса, сізге хабарлаймыз.
Dialogue: 0,0:12:14.97,0:12:16.09,Default,,0,0,0,,Мен бірден келдім.
Dialogue: 0,0:12:16.68,0:12:18.60,Default,,0,0,0,,Бұл қайсысы оң жақта ма, сол жақта ма?
Dialogue: 0,0:12:18.76,0:12:21.85,Default,,0,0,0,,Мақсат тікелей сіздің алдыңызда.
Dialogue: 0,0:12:22.14,0:12:23.35,Default,,0,0,0,,Мог~
Dialogue: 0,0:12:23.60,0:12:26.27,Default,,0,0,0,,«Уау!»
Dialogue: 0,0:12:26.52,0:12:28.06,Default,,0,0,0,,Бір нәрсе есінен танып жатыр
Dialogue: 0,0:12:28.23,0:12:29.86,Default,,0,0,0,,Босатпаңыз
Dialogue: 0,0:12:30.19,0:12:31.19,Default,,0,0,0,,Бұл басталды ма?
Dialogue: 0,0:12:31.36,0:12:32.40,Default,,0,0,0,,Ол қайдан шыққан?
Dialogue: 0,0:12:32.69,0:12:34.11,Default,,0,0,0,,Вааааааааааааааааааааааааа
Dialogue: 0,0:12:34.40,0:12:35.36,Default,,0,0,0,,Мен оны ұстадым!
Dialogue: 0,0:12:39.91,0:12:42.12,Default,,0,0,0,,Кеттік, барлығы шабуыл жасайды.
Dialogue: 0,0:12:42.29,0:12:43.95,Default,,0,0,0,,Аспан айдаһарының айқайы
Dialogue: 0,0:12:44.33,0:12:46.50,Default,,0,0,0,,Мұздан жасалған найза
Dialogue: 0,0:12:47.63,0:12:48.96,Default,,0,0,0,,От айдаһарының айқайы
Dialogue: 0,0:12:51.63,0:12:52.96,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:12:54.88,0:12:55.97,Default,,0,0,0,,Мог~
Dialogue: 0,0:12:56.13,0:12:57.47,Default,,0,0,0,,Уау
Dialogue: 0,0:13:01.14,0:13:02.97,Default,,0,0,0,,Конняру
Dialogue: 0,0:13:03.22,0:13:04.35,Default,,0,0,0,,Уау
Dialogue: 0,0:13:05.68,0:13:07.65,Default,,0,0,0,,Ауырды, бейбақ.
Dialogue: 0,0:13:07.81,0:13:10.65,Default,,0,0,0,,Сәлем, мен мұндамын...
Dialogue: 0,0:13:10.81,0:13:13.28,Default,,0,0,0,,Қазір ұрысатын уақыт емес.
Dialogue: 0,0:13:13.44,0:13:14.49,Default,,0,0,0,,Мең қайда?
Dialogue: 0,0:13:14.78,0:13:15.99,Default,,0,0,0,,Мог~
Dialogue: 0,0:13:16.20,0:13:17.49,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:13:19.66,0:13:22.33,Default,,0,0,0,,Қысқасы, тек жоғары көтерілетін жер болса болғаны.
Dialogue: 0,0:13:23.99,0:13:25.33,Default,,0,0,0,,Барлығың көтеріліңдер!
Dialogue: 0,0:13:27.58,0:13:29.83,Default,,0,0,0,,Мен тайып бара жатырмын, тұра алмаймын.
Dialogue: 0,0:13:30.21,0:13:31.96,Default,,0,0,0,,Вендиді ұстаңыз
Dialogue: 0,0:13:34.92,0:13:36.47,Default,,0,0,0,,Мог~
Dialogue: 0,0:13:37.59,0:13:38.72,Default,,0,0,0,,(Рей) Уф~ Нұсқауларды мінсіз орындадым
Dialogue: 0,0:13:38.88,0:13:41.85,Default,,0,0,0,,Уф, күн суық. Менің кеудем суық.
Dialogue: 0,0:13:42.14,0:13:43.81,Default,,0,0,0,,Ысырапшыл болмаңыз
Dialogue: 0,0:13:43.97,0:13:45.89,Default,,0,0,0,,Бұл уақытта қайдан келеді?
Dialogue: 0,0:13:46.14,0:13:48.89,Default,,0,0,0,,Тым болмаса мен сені өзім қалаған жерге тартып алсам...
Dialogue: 0,0:13:49.06,0:13:50.94,Default,,0,0,0,,Сондай-ақ буксирлеуге болады.
Dialogue: 0,0:13:51.11,0:13:52.65,Default,,0,0,0,,Барлығы сақ болыңыз
Dialogue: 0,0:13:52.86,0:13:54.44,Default,,0,0,0,,Мен төменде, дәл төмендемін.
Dialogue: 0,0:13:54.78,0:13:55.40,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,0:13:57.74,0:13:58.65,Default,,0,0,0,,Осындай жерде?
Dialogue: 0,0:13:59.07,0:14:00.82,Default,,0,0,0,,От айдаһар темір жұдырығы
Dialogue: 0,0:14:02.53,0:14:04.28,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:14:06.12,0:14:07.54,Default,,0,0,0,,Бір сәт ойланыңыз.
Dialogue: 0,0:14:07.71,0:14:09.37,Default,,0,0,0,,Мен оны жаңа ғана кездестірдім.
Dialogue: 0,0:14:09.54,0:14:11.29,Default,,0,0,0,,Мог~
Dialogue: 0,0:14:12.71,0:14:13.34,Default,,0,0,0,,Mogut
Dialogue: 0,0:14:13.54,0:14:14.29,Default,,0,0,0,,Не?
Dialogue: 0,0:14:14.50,0:14:16.05,Default,,0,0,0,,Мен тағы да?
Dialogue: 0,0:14:16.21,0:14:16.84,Default,,0,0,0,,Ах
Dialogue: 0,0:14:19.93,0:14:20.68,Default,,0,0,0,,Мог~
Dialogue: 0,0:14:21.05,0:14:23.18,Default,,0,0,0,,Не... Уау.
Dialogue: 0,0:14:25.47,0:14:26.18,Default,,0,0,0,,Могу~
Dialogue: 0,0:14:26.43,0:14:27.68,Default,,0,0,0,,Тұрақты
Dialogue: 0,0:14:28.23,0:14:29.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:29.39,0:14:30.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:30.98,0:14:31.65,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:14:32.40,0:14:34.98,Default,,0,0,0,,Қызық сияқты, мен де жасап көруім керек.
Dialogue: 0,0:14:35.19,0:14:36.69,Default,,0,0,0,,Ойнамаңыз!
Dialogue: 0,0:14:36.86,0:14:37.78,Default,,0,0,0,,Люси
Dialogue: 0,0:14:37.94,0:14:39.19,Default,,0,0,0,,Мен қазір саған көмектесемін
Dialogue: 0,0:14:41.91,0:14:43.70,Default,,0,0,0,,Кяаааааааааааааааааааа
Dialogue: 0,0:14:43.95,0:14:45.20,Default,,0,0,0,,От айдаһарының айқайы
Dialogue: 0,0:14:45.70,0:14:47.08,Default,,0,0,0,,Мұздан жасалған найза
Dialogue: 0,0:14:47.29,0:14:49.37,Default,,0,0,0,,Аспан айдаһарының айқайы
Dialogue: 0,0:14:50.87,0:14:52.33,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,0:14:52.58,0:14:54.46,Default,,0,0,0,,Бұл мүлдем дұрыс емес.
Dialogue: 0,0:14:54.63,0:14:56.84,Default,,0,0,0,,Ауыздағы шаншу
Dialogue: 0,0:14:57.38,0:15:01.43,Default,,0,0,0,,Артық емес, неге жалғыз мені қуады?
Dialogue: 0,0:15:02.47,0:15:06.18,Default,,0,0,0,,Бұл ұзақ әңгіме болар еді, бірақ бастапқыда бұл мең...
Dialogue: 0,0:15:06.35,0:15:09.27,Default,,0,0,0,,Бұл осы ауылдың тұрғынының иелігіндегі үй жануары болды.
Dialogue: 0,0:15:09.43,0:15:10.35,Default,,0,0,0,,Үй жануарлары?
Dialogue: 0,0:15:11.02,0:15:15.19,Default,,0,0,0,,Ол кезде ол әлі кішкентай және сүйкімді мең еді.
Dialogue: 0,0:15:15.36,0:15:18.32,Default,,0,0,0,,Қожайын кенет алысқа көшуге мәжбүр...
Dialogue: 0,0:15:18.48,0:15:21.99,Default,,0,0,0,,Меңді ауылда қалдырудан басқа амалым қалмады.
Dialogue: 0,0:15:22.49,0:15:24.99,Default,,0,0,0,,Мең оны иесі тастап кетті деп ойлады...
Dialogue: 0,0:15:25.16,0:15:26.87,Default,,0,0,0,,Мен абдырап қалдым
Dialogue: 0,0:15:27.45,0:15:29.33,Default,,0,0,0,,Ауылдан қашып, жабайы бол
Dialogue: 0,0:15:29.75,0:15:33.00,Default,,0,0,0,,Мен білмей тұрып, ол өте үлкен болып өсті.
Dialogue: 0,0:15:33.62,0:15:37.13,Default,,0,0,0,,Демек, бұл мең адамдардан кек алып жатыр.
Dialogue: 0,0:15:37.50,0:15:39.09,Default,,0,0,0,,​​Бұл нені білдіреді?
Dialogue: 0,0:15:39.25,0:15:42.30,Default,,0,0,0,,Дәлірек айтсақ, сіз оны мең деп айтасыз.
Dialogue: 0,0:15:42.47,0:15:46.14,Default,,0,0,0,,Жағдайды енді түсініп, Моль мырзаны аяп отырмын.
Dialogue: 0,0:15:46.51,0:15:49.14,Default,,0,0,0,,Бірақ сен неге Люсиді ғана қуып жүрсің?
Dialogue: 0,0:15:49.97,0:15:54.02,Default,,0,0,0,,Қазір меңдердің көбею кезеңі, махаббат мезгілі.
Dialogue: 0,0:15:54.23,0:15:55.52,Default,,0,0,0,,Демек, ол жас әйел.
Dialogue: 0,0:15:55.69,0:15:58.15,Default,,0,0,0,,Менің ойымша, ол Люсиді қызықтырады.
Dialogue: 0,0:15:58.36,0:16:01.15,Default,,0,0,0,,Сондықтан ол Люсиге үйленгісі келеді.
Dialogue: 0,0:16:01.49,0:16:02.99,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:16:03.40,0:16:07.16,Default,,0,0,0,,Мен де жас әйелмін. Неліктен меңдер мені нысанаға алмайды?
Dialogue: 0,0:16:08.24,0:16:10.74,Default,,0,0,0,,Эльза сауыт киіп жүр.
Dialogue: 0,0:16:10.99,0:16:14.00,Default,,0,0,0,,Еркек пе, әйел ме, ажырата алмаса керек.
Dialogue: 0,0:16:14.16,0:16:18.59,Default,,0,0,0,,Жарайды, мен де жас қызбын.
Dialogue: 0,0:16:18.75,0:16:22.17,Default,,0,0,0,,Анау мең кеудесі үлкен әйелдерді ұнататын сияқты.
Dialogue: 0,0:16:23.59,0:16:24.76,Default,,0,0,0,,...аздап
Dialogue: 0,0:16:24.93,0:16:27.22,Default,,0,0,0,,Гаан!
Dialogue: 0,0:16:27.39,0:16:30.35,Default,,0,0,0,,Бірақ егер солай болса, сіз стратегияны ойлап таба аласыз.
Dialogue: 0,0:16:30.51,0:16:33.18,Default,,0,0,0,,Иә, меңді азғырудың жолы бар.
Dialogue: 0,0:16:33.39,0:16:35.19,Default,,0,0,0,,Тәңір
Dialogue: 0,0:16:35.52,0:16:38.27,Default,,0,0,0,,Не? сурет? Не айтқың келеді?
Dialogue: 0,0:16:43.86,0:16:45.20,Default,,0,0,0,,Осыны айтып тұрсың ба?
Dialogue: 0,0:16:47.41,0:16:49.16,Default,,0,0,0,,Люси керемет.
Dialogue: 0,0:16:49.32,0:16:52.66,Default,,0,0,0,,Меңдер мұнымен қуанады.
Dialogue: 0,0:16:52.83,0:16:55.29,Default,,0,0,0,,Люси, неге естелік суретке түспейсің?
Dialogue: 0,0:16:55.46,0:16:56.71,Default,,0,0,0,,Суретке түсейік пе?
Dialogue: 0,0:16:58.88,0:16:59.50,Default,,0,0,0,,Могу~
Dialogue: 0,0:16:59.63,0:17:00.25,Default,,0,0,0,,шықты
Dialogue: 0,0:17:01.30,0:17:05.05,Default,,0,0,0,,Тың сарайының есігін аш, Балго
Dialogue: 0,0:17:08.80,0:17:10.97,Default,,0,0,0,,Менен сұраңызшы, ханшайым.
Dialogue: 0,0:17:13.18,0:17:15.31,Default,,0,0,0,,Мен үйге барып душқа түскім келеді.
Dialogue: 0,0:17:15.48,0:17:17.31,Default,,0,0,0,,Жаңа ғана шыққан болуы керек!
Dialogue: 0,0:17:17.85,0:17:18.98,Default,,0,0,0,,Могу Могу~
Dialogue: 0,0:17:19.27,0:17:22.07,Default,,0,0,0,,Балго, меңді лайдан қуып жібер.
Dialogue: 0,0:17:22.23,0:17:24.69,Default,,0,0,0,,Сен жер қазуға шеберсің, солай ма?
Dialogue: 0,0:17:24.86,0:17:26.49,Default,,0,0,0,,Мен түсіндім, бірақ-
Dialogue: 0,0:17:26.99,0:17:29.24,Default,,0,0,0,,Алдымен ханшайымды қауіпсіз жерге апарайық.
Dialogue: 0,0:17:30.62,0:17:32.24,Default,,0,0,0,,Бұл мүлдем қауіпсіз емес!
Dialogue: 0,0:17:34.62,0:17:36.08,Default,,0,0,0,,Үлкен, бірақ жылдам
Dialogue: 0,0:17:36.25,0:17:38.83,Default,,0,0,0,,Мен Варгоның жылдамдығын жеңе алмаймын.
Dialogue: 0,0:17:39.00,0:17:40.25,Default,,0,0,0,,Хмм, мен мұны істей аламын!
Dialogue: 0,0:17:41.46,0:17:43.80,Default,,0,0,0,,Мен үшін уайымдаңыз!
Dialogue: 0,0:17:43.96,0:17:45.26,Default,,0,0,0,,Мұнда ханшайым
Dialogue: 0,0:17:46.34,0:17:47.26,Default,,0,0,0,,Гяаа
Dialogue: 0,0:17:47.55,0:17:48.51,Default,,0,0,0,,Mogut
Dialogue: 0,0:17:49.93,0:17:51.26,Default,,0,0,0,,Балго абай болыңыз
Dialogue: 0,0:17:51.64,0:17:53.97,Default,,0,0,0,,Енді шабуыл кезегіңіз.
Dialogue: 0,0:17:57.23,0:17:59.56,Default,,0,0,0,,Бұл ханшайымның бұйрығы. Мен сенің қашып кетуіңе жол бермеймін.
Dialogue: 0,0:18:01.15,0:18:01.77,Default,,0,0,0,,Могу?
Dialogue: 0,0:18:04.07,0:18:05.78,Default,,0,0,0,,Могуууууу
Dialogue: 0,0:18:06.11,0:18:07.28,Default,,0,0,0,,Барлығы, қазір.
Dialogue: 0,0:18:07.49,0:18:08.78,Default,,0,0,0,,От айдаһарының айқайы!
Dialogue: 0,0:18:09.40,0:18:10.99,Default,,0,0,0,,Tenryu's Roar!
Dialogue: 0,0:18:11.20,0:18:13.33,Default,,0,0,0,,Мұздан жасалған найза!
Dialogue: 0,0:18:15.74,0:18:18.00,Default,,0,0,0,,Мог гууууу
Dialogue: 0,0:18:18.79,0:18:19.75,Default,,0,0,0,,Мен кеттім, Эльза.
Dialogue: 0,0:18:21.54,0:18:23.25,Default,,0,0,0,,Аяқтау - менікі.
Dialogue: 0,0:18:23.46,0:18:24.25,Default,,0,0,0,,Тоаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:24.80,0:18:25.42,Default,,0,0,0,,Теряаа
Dialogue: 0,0:18:26.38,0:18:27.34,Default,,0,0,0,,Могу~
Dialogue: 0,0:18:34.22,0:18:37.18,Default,,0,0,0,,Бұл хит болды. Мен зардап шеккен жоқпын.
Dialogue: 0,0:18:39.18,0:18:41.02,Default,,0,0,0,,Мин-учи бұл...
Dialogue: 0,0:18:41.31,0:18:42.77,Default,,0,0,0,,А, жарай ма?
Dialogue: 0,0:18:43.44,0:18:45.52,Default,,0,0,0,,Мог~
Dialogue: 0,0:18:45.82,0:18:49.82,Default,,0,0,0,,Енді біз оны ұстадық, бірақ онымен не істеуіміз керек?
Dialogue: 0,0:18:50.03,0:18:53.03,Default,,0,0,0,,Меңді тастаған иесі кінәлі.
Dialogue: 0,0:18:53.45,0:18:56.79,Default,,0,0,0,,...Сағынып қалсам, тағы да қиналамын.
Dialogue: 0,0:18:57.20,0:19:01.12,Default,,0,0,0,,Эй Моль, сен шынымен әйел алғың келе ме?
Dialogue: 0,0:19:01.29,0:19:03.54,Default,,0,0,0,,Мог Мог
Dialogue: 0,0:19:03.83,0:19:07.71,Default,,0,0,0,,Бірақ мен адаммын, саған үйлене алмаймын.
Dialogue: 0,0:19:07.88,0:19:09.05,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:19:09.34,0:19:10.80,Default,,0,0,0,,Мог…
Dialogue: 0,0:19:10.97,0:19:13.01,Default,,0,0,0,,Ханшайым, мен енді оралдым.
Dialogue: 0,0:19:13.18,0:19:13.80,Default,,0,0,0,,Ах
Dialogue: 0,0:19:14.18,0:19:15.89,Default,,0,0,0,,Мог Мог
Dialogue: 0,0:19:16.05,0:19:16.81,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:19:17.22,0:19:17.85,Default,,0,0,0,,Балго?
Dialogue: 0,0:19:18.02,0:19:19.56,Default,,0,0,0,,Қандай тіршілік иесі?
Dialogue: 0,0:19:20.02,0:19:24.35,Default,,0,0,0,,Мен жерді тінтіп, аналық мең таптым.
Dialogue: 0,0:19:24.52,0:19:26.06,Default,,0,0,0,,Достарың болса, жазыларсыңдар.
Dialogue: 0,0:19:26.23,0:19:29.57,Default,,0,0,0,,Ауылға қиындық тудырмай қояды деп ойладым.
Dialogue: 0,0:19:29.86,0:19:33.32,Default,,0,0,0,,Бұл мең де емес, баяғы тіршілік иесі де емес.
Dialogue: 0,0:19:33.70,0:19:34.45,Default,,0,0,0,,Мог…
Dialogue: 0,0:19:34.62,0:19:35.74,Default,,0,0,0,,Мог…
Dialogue: 0,0:19:37.41,0:19:39.33,Default,,0,0,0,,Мог! Мог...
Dialogue: 0,0:19:39.79,0:19:42.08,Default,,0,0,0,,Әй, жақсы болатын сияқты.
Dialogue: 0,0:19:43.46,0:19:44.50,Default,,0,0,0,,Mogut
Dialogue: 0,0:19:44.67,0:19:47.34,Default,,0,0,0,,Мог Мог…
Dialogue: 0,0:19:47.50,0:19:48.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:48.50,0:19:49.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:49.59,0:19:53.34,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:56.43,0:19:59.35,Default,,0,0,0,,Мен ханшайымға көмектесе алғаныма қуаныштымын.
Dialogue: 0,0:20:05.73,0:20:08.61,Default,,0,0,0,,Мен бақытты емеспін!
Dialogue: 0,0:20:27.67,0:20:30.71,Default,,0,0,0,,Ақыр соңында, сіз Ұлы жын-шайтан Енбуды тамашалап отырдыңыз.
Dialogue: 0,0:20:31.13,0:20:31.84,Default,,0,0,0,,Зереф
Dialogue: 0,0:20:33.05,0:20:36.22,Default,,0,0,0,,Дауыс естілмеді, сурет көрінбейді
Dialogue: 0,0:20:36.59,0:20:38.43,Default,,0,0,0,,Бірақ мен түсіндім.
Dialogue: 0,0:20:39.01,0:20:41.56,Default,,0,0,0,,Сен барсың, Мэвис.
Dialogue: 0,0:20:42.47,0:20:45.85,Default,,0,0,0,,Жеті жыл бұрын сен менің қасымда болдың
Dialogue: 0,0:20:46.40,0:20:49.86,Default,,0,0,0,,Жеті жыл бұрын сен менің қасымда болдың
Dialogue: 0,0:20:50.73,0:20:53.86,Default,,0,0,0,,Сіз әлі өлетін жеріңізді іздеп жүрсіз бе?
Dialogue: 0,0:20:54.32,0:20:56.45,Default,,0,0,0,,Қайтыс болған жері шешілді.
Dialogue: 0,0:20:57.11,0:20:59.66,Default,,0,0,0,,Жүздеген жылдар бойы мен-
Dialogue: 0,0:21:00.03,0:21:02.37,Default,,0,0,0,,Мен бір дәуірдің аяқталуын бақылап жүрмін
Dialogue: 0,0:21:03.45,0:21:07.75,Default,,0,0,0,,Адамдар арасындағы ұрыс, өшпенділік, зұлым жүректер
Dialogue: 0,0:21:07.92,0:21:11.96,Default,,0,0,0,,Әрқашан жаңа дәуірде олардың тазаруын күтіңіз
Dialogue: 0,0:21:12.21,0:21:13.92,Default,,0,0,0,,Неше рет болды?
Dialogue: 0,0:21:14.34,0:21:18.39,Default,,0,0,0,,Адамдар қайталайды, бір қатені қайта-қайта жасайды.
Dialogue: 0,0:21:19.14,0:21:21.39,Default,,0,0,0,,Сонда да адамдар өмір сүре алады.
Dialogue: 0,0:21:21.64,0:21:24.64,Default,,0,0,0,,Тірі емес, шын мағынасында.
Dialogue: 0,0:21:25.31,0:21:28.90,Default,,0,0,0,,Адам деп атауға болатын асыл жаратылыстар қазірдің өзінде жойылып кеткен.
Dialogue: 0,0:21:31.36,0:21:33.57,Default,,0,0,0,,Сіз күтуді тоқтаттыңыз ба?
Dialogue: 0,0:21:33.90,0:21:37.90,Default,,0,0,0,,Иә, мен жеті жыл бойы ойланып, осындай қорытындыға келдім.
Dialogue: 0,0:21:38.66,0:21:43.91,Default,,0,0,0,,Дүние мені жоққа шығара берсе, мен бұл дүниені жоққа шығарамын
Dialogue: 0,0:21:44.49,0:21:47.41,Default,,0,0,0,,Fairy Tail бұл әлемді растайды.
Dialogue: 0,0:21:48.58,0:21:50.92,Default,,0,0,0,,Бұл менің сыйлығым
Dialogue: 0,0:21:51.17,0:21:53.92,Default,,0,0,0,,Дүниенің үйлесімділігі және қайта туылуы
Dialogue: 0,0:21:54.46,0:21:55.92,Default,,0,0,0,,Ұрыс бола ма?
Dialogue: 0,0:21:57.55,0:22:03.43,Default,,0,0,0,,Жоқ, бұл бір жақты жойылу болады. Ешкім тірі қалмайды.
Dialogue: 0,0:22:05.14,0:22:07.43,Default,,0,0,0,,Fairy Tail сізді тоқтатады
Dialogue: 0,0:22:07.60,0:22:09.44,Default,,0,0,0,,Өлетін сенсің.
Dialogue: 0,0:22:18.65,0:22:19.78,Default,,0,0,0,,Нацу...
Dialogue: 0,0:22:20.36,0:22:22.91,Default,,0,0,0,,Шешуші шайқастың уақыты жақындап қалды.
Dialogue: 0,0:23:48.91,0:23:54.87,Default,,0,0,0,,~♪
Dialogue: 0,0:23:55.96,0:23:57.92,Default,,0,0,0,,Нацу, Фрош қиыншылықта.
Dialogue: 0,0:23:58.09,0:24:00.42,Default,,0,0,0,,Фрош сабрет тіс бақасына ұқсайды ма?
Dialogue: 0,0:24:00.59,0:24:03.34,Default,,0,0,0,,Иә, бұл аяз жоғалып кетті.
Dialogue: 0,0:24:03.51,0:24:06.26,Default,,0,0,0,,Бақытты, егер сіз жай ғана жоғалған бала болсаңыз, үрейленудің қажеті жоқ.
Dialogue: 0,0:24:06.43,0:24:08.89,Default,,0,0,0,,Нацу: Фроштың қандай керемет екенін түсінбейсің.
Dialogue: 0,0:24:09.31,0:24:10.47,Default,,0,0,0,,Не? Бұл керемет.
Dialogue: 0,0:24:10.64,0:24:13.85,Default,,0,0,0,,Фрош ешқашан үйге жалғыз бара алмады.
Dialogue: 0,0:24:14.02,0:24:15.77,Default,,0,0,0,,Ол жоғалған балалардың патшасы.
Dialogue: 0,0:24:15.94,0:24:17.48,Default,,0,0,0,,Бұл басқаша таң қалдырады.
Dialogue: 0,0:24:18.11,0:24:19.98,Default,,0,0,0,,Келесі жолы «Қош келдіңіз Фрош»
Dialogue: 0,0:24:20.23,0:24:22.44,Default,,0,0,0,,Оған көмектесу мүмкін емес. Біз де барып іздейміз бе?
Dialogue: 0,0:24:22.61,0:24:23.90,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:24:25.40,0:24:31.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory