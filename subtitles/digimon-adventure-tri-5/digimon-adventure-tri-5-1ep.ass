Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:47.89,0:01:49.77,Default,,0,0,0,,Ой... аа~!
Dialogue: 0,0:01:54.86,0:01:56.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:57.57,0:01:58.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:58.78,0:02:02.28,Default,,0,0,0,,Енді мені босат! Әлемді жойыңыз!
Dialogue: 0,0:02:02.62,0:02:04.99,Default,,0,0,0,,Сенің кесіріңнен жолдасың өледі.
Dialogue: 0,0:02:05.12,0:02:05.66,Default,,0,0,0,,(Мешиннің ыңырсыуы)
Dialogue: 0,0:02:05.66,0:02:06.54,Default,,0,0,0,,(Мешиннің ыңырсыуы)
Dialogue: 0,0:02:05.66,0:02:06.54,Default,,0,0,0,,Хоора хоора
Dialogue: 0,0:02:06.54,0:02:08.29,Default,,0,0,0,,Хоора хоора
Dialogue: 0,0:02:09.04,0:02:10.63,Default,,0,0,0,,Хола
Dialogue: 0,0:02:10.83,0:02:13.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:13.38,0:02:15.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:15.38,0:02:18.55,Default,,0,0,0,,Сіз ешқашан туылмауыңыз керек еді
Dialogue: 0,0:02:19.30,0:02:23.76,Default,,0,0,0,,Мен туылмауым керек еді.
Dialogue: 0,0:02:45.45,0:02:48.08,Default,,0,0,0,,(қанатын қаққан қарға дыбысы)
Dialogue: 0,0:02:48.20,0:02:51.83,Default,,0,0,0,,Мэй-чан!
Dialogue: 0,0:02:59.47,0:03:03.34,Default,,0,0,0,,Мэй-чан... Мэй-чан!
Dialogue: 0,0:03:03.47,0:03:04.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:09.60,0:03:11.69,Default,,0,0,0,,(Жапырақтардың дірілдеген дыбысы)
Dialogue: 0,0:03:18.69,0:03:19.86,Default,,0,0,0,,мамыр…
Dialogue: 0,0:03:20.82,0:03:21.86,Default,,0,0,0,,Мэй-чан!
Dialogue: 0,0:03:22.07,0:03:24.45,Default,,0,0,0,,мамыр~!
Dialogue: 0,0:03:25.03,0:03:29.25,Default,,0,0,0,,Керемет! Мені уайымдаған қатерлі ісік
Dialogue: 0,0:03:29.66,0:03:31.08,Default,,0,0,0,,Бүгін керемет өтті
Dialogue: 0,0:03:32.79,0:03:34.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:35.79,0:03:38.84,Default,,0,0,0,,Уфуфуфу (Мейкомон) Мей
Dialogue: 0,0:03:39.92,0:03:41.38,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:03:47.76,0:03:49.89,Default,,0,0,0,,Мэй Чанның жүруі жақсы, бірақ...
Dialogue: 0,0:03:50.02,0:03:51.85,Default,,0,0,0,,Алысқа шықпау керек.
Dialogue: 0,0:03:52.19,0:03:55.61,Default,,0,0,0,,Мен сені анда-санда кең жерде ойнауға рұқсат еткім келді.
Dialogue: 0,0:03:55.73,0:03:56.77,Default,,0,0,0,,(душты өшіру дыбысы)
Dialogue: 0,0:03:57.23,0:03:59.36,Default,,0,0,0,,Әке, сіз ашулысыз ба?
Dialogue: 0,0:03:59.69,0:04:02.36,Default,,0,0,0,,Әзірше орындайық.
Dialogue: 0,0:04:03.70,0:04:04.86,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:05.20,0:04:07.12,Default,,0,0,0,,Мэй-чан да
Dialogue: 0,0:04:07.24,0:04:08.62,Default,,0,0,0,,...
Dialogue: 0,0:04:09.74,0:04:11.62,Default,,0,0,0,,Әй, Мешин.
Dialogue: 0,0:04:11.75,0:04:14.33,Default,,0,0,0,,Не? (Мешиннің анасы) Сіз әйтеуір ауырып қалдыңыз ба?
Dialogue: 0,0:04:15.12,0:04:17.21,Default,,0,0,0,,Жоқ, неге?
Dialogue: 0,0:04:17.33,0:04:19.46,Default,,0,0,0,,Қан емес пе? Бұл
Dialogue: 0,0:04:21.30,0:04:23.72,Default,,0,0,0,,Не? Сонымен, Мэй Чан?
Dialogue: 0,0:04:23.88,0:04:25.72,Default,,0,0,0,,Хе хе хе
Dialogue: 0,0:04:25.89,0:04:27.72,Default,,0,0,0,,Еш жерде, ештеңе
Dialogue: 0,0:04:28.01,0:04:29.47,Default,,0,0,0,,Согека
Dialogue: 0,0:04:31.18,0:04:33.98,Default,,0,0,0,,Мэй Чанды ғылыми-зерттеу институтына апаруым керек пе? ?
Dialogue: 0,0:04:34.06,0:04:35.23,Default,,0,0,0,,Иә
Dialogue: 0,0:04:35.35,0:04:39.73,Default,,0,0,0,,Ертең таңертең Токиодан ғылыми-зерттеу институтының адамдары келеді.
Dialogue: 0,0:04:40.98,0:04:43.78,Default,,0,0,0,,Бір-екі күн ғана.
Dialogue: 0,0:04:47.24,0:04:48.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:48.32,0:04:49.24,Default,,0,0,0,,
Dialogue: 0,0:04:49.24,0:04:52.25,Default,,0,0,0,,
Dialogue: 0,0:04:49.24,0:04:52.25,Default,,0,0,0,,Профессор! Деректер! (Профессор Мочизуки) Артқа қадам жасаңыз! Бұл қауіпті!
Dialogue: 0,0:04:52.25,0:04:53.33,Default,,0,0,0,,
Dialogue: 0,0:04:57.25,0:04:59.13,Default,,0,0,0,,Полиция шақырыңыз!
Dialogue: 0,0:04:59.67,0:05:00.75,Default,,0,0,0,,Полиция күтіп тұр
Dialogue: 0,0:05:00.84,0:05:02.80,Default,,0,0,0,,Уа~!
Dialogue: 0,0:05:02.92,0:05:04.26,Default,,0,0,0,,Мешин, қаш!
Dialogue: 0,0:05:04.42,0:05:05.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:07.43,0:05:08.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:11.89,0:05:13.27,Default,,0,0,0,,Негізгі… Мен…
Dialogue: 0,0:05:13.98,0:05:16.52,Default,,0,0,0,,Ах... Мэй-чан?
Dialogue: 0,0:05:18.86,0:05:20.02,Default,,0,0,0,,мамыр~!
Dialogue: 0,0:05:21.98,0:05:23.57,Default,,0,0,0,,Мэй-чан
Dialogue: 0,0:05:38.75,0:05:41.71,Default,,0,0,0,,Дагаан!
Dialogue: 0,0:05:48.13,0:05:52.26,Default,,0,0,0,,Сіз туылмауыңыз керек еді
Dialogue: 0,0:05:52.51,0:05:57.44,Default,,0,0,0,,Бірақ мен сенің туғаныңды күттім.
Dialogue: 0,0:06:08.70,0:06:09.91,Default,,0,0,0,,Сонымен, сетте алты ойынды бірінші жеңген адам жеңеді, иә?
Dialogue: 0,0:06:10.03,0:06:11.53,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:06:11.66,0:06:12.87,Default,,0,0,0,,Мен олай ойламаймын
Dialogue: 0,0:06:12.99,0:06:15.45,Default,,0,0,0,,Мен тек жаман сезімді айта аламын.
Dialogue: 0,0:06:15.58,0:06:16.45,Default,,0,0,0,,Міне!
Dialogue: 0,0:06:17.54,0:06:20.63,Default,,0,0,0,,Бұл... біздің әлем ме?
Dialogue: 0,0:06:20.75,0:06:22.46,Default,,0,0,0,,Дигимон ұшып кетеді
Dialogue: 0,0:06:26.38,0:06:28.93,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:06:34.72,0:06:36.10,Default,,0,0,0,,Мэй Чан?
Dialogue: 0,0:06:37.48,0:06:38.60,Default,,0,0,0,,Мэй-чан!
Dialogue: 0,0:06:39.52,0:06:40.35,Default,,0,0,0,,Га
Dialogue: 0,0:06:46.90,0:06:47.74,Default,,0,0,0,,мамыр!
Dialogue: 0,0:06:48.65,0:06:50.74,Default,,0,0,0,,Дагаан!
Dialogue: 0,0:07:01.50,0:07:02.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:07.34,0:07:09.17,Default,,0,0,0,,Ақымақ! Сіз өлесіз бе?
Dialogue: 0,0:07:09.30,0:07:12.76,Default,,0,0,0,,(Мейлакмонның тұрған дыбысы)
Dialogue: 0,0:07:13.09,0:07:14.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:30.45,0:07:31.90,Default,,0,0,0,,Мейкомон…
Dialogue: 0,0:07:32.32,0:07:34.78,Default,,0,0,0,,«Әлемді жоюдың кілті»
Dialogue: 0,0:07:34.91,0:07:36.78,Default,,0,0,0,,Дүниені жоюдың кілті?
Dialogue: 0,0:07:37.20,0:07:39.00,Default,,0,0,0,,Сол Геннай-сан...
Dialogue: 0,0:07:39.12,0:07:41.83,Default,,0,0,0,,Мен Мейкомон туралы осылай дедім.
Dialogue: 0,0:07:43.58,0:07:46.09,Default,,0,0,0,,«Мен туылмауым керек еді»
Dialogue: 0,0:07:46.88,0:07:48.59,Default,,0,0,0,,Ол осылай деді.
Dialogue: 0,0:07:50.42,0:07:52.22,Default,,0,0,0,,Дигимон туылмауы керек...
Dialogue: 0,0:07:52.34,0:07:53.59,Default,,0,0,0,,Оның болуы мүмкін емес!
Dialogue: 0,0:07:57.85,0:08:01.85,Default,,0,0,0,,Бірақ соншалықты жойқын күшке ие Мейкомон...
Dialogue: 0,0:08:01.98,0:08:04.40,Default,,0,0,0,,Егер сіз біздің әлемде көрінсеңіз...
Dialogue: 0,0:08:06.52,0:08:08.32,Default,,0,0,0,,Бұл да қауіпті көрінеді.
Dialogue: 0,0:08:08.44,0:08:09.03,Default,,0,0,0,,(Дигимонның айқайы)
Dialogue: 0,0:08:09.03,0:08:12.36,Default,,0,0,0,,(Дигимонның айқайы)
Dialogue: 0,0:08:09.03,0:08:12.36,Default,,0,0,0,,Дос болғандай емес, солай ма?
Dialogue: 0,0:08:12.45,0:08:18.37,Default,,0,0,0,,(Персонал шуы)
Dialogue: 0,0:08:20.12,0:08:22.37,Default,,0,0,0,,№6 көп мақсатты спутникпен байланыс үзілді!
Dialogue: 0,0:08:22.91,0:08:25.63,Default,,0,0,0,,Ақаулық бар ма? Толық бақылау тізімін тексеріңіз
Dialogue: 0,0:08:26.29,0:08:27.50,Default,,0,0,0,,№6 ғана емес
Dialogue: 0,0:08:27.63,0:08:30.63,Default,,0,0,0,,Ақпарат жинау №1 Жоқ, GPS сигналы да жоғалды.
Dialogue: 0,0:08:31.71,0:08:35.13,Default,,0,0,0,,Расталуы мүмкін барлық ішкі және халықаралық жерсеріктермен байланыс үзілді.
Dialogue: 0,0:08:35.72,0:08:37.68,Default,,0,0,0,,Қабылдаушы жағында проблема емес пе?
Dialogue: 0,0:08:37.80,0:08:39.14,Default,,0,0,0,,Нобейамамен тексеріңіз!
Dialogue: 0,0:08:39.76,0:08:41.39,Default,,0,0,0,,Катсуура мен Окинаваға хабарласыңыз!
Dialogue: 0,0:08:45.81,0:08:47.15,Default,,0,0,0,,Үзіліс
Dialogue: 0,0:08:47.52,0:08:51.07,Default,,0,0,0,,Цифрлық әлем... әлем...
Dialogue: 0,0:08:53.24,0:08:58.66,Default,,0,0,0,,Бұл жолы мені таңдайды
Dialogue: 0,0:08:59.16,0:09:03.79,Default,,0,0,0,,Бакумон Эй, сен қайдасың?
Dialogue: 0,0:09:03.91,0:09:05.92,Default,,0,0,0,,Біз әлемді құтқаруымыз керек
Dialogue: 0,0:09:06.25,0:09:10.92,Default,,0,0,0,,Бакумон Сізді құтқара алатын жалғыз адамдар - мен және сіз.
Dialogue: 0,0:09:12.80,0:09:15.80,Default,,0,0,0,,Біз ғана таңдалғандармыз.
Dialogue: 0,0:09:16.68,0:09:19.97,Default,,0,0,0,,Мен саған сенемін, Бакумон.
Dialogue: 0,0:09:20.10,0:09:24.68,Default,,0,0,0,,Сен менің серіктесімсің
Dialogue: 0,0:09:31.36,0:09:33.61,Default,,0,0,0,,Сіз сонда болдыңыз ба?
Dialogue: 0,0:09:40.62,0:09:44.04,Default,,0,0,0,,Ағымдағы ауа райының спутниктік ауытқулары және жер сілкінісін өлшейтін аспаптар
Dialogue: 0,0:09:44.16,0:09:46.04,Default,,0,0,0,,Сондай-ақ, апат туралы ескертудің дұрыс жұмыс істемеуі.
Dialogue: 0,0:09:46.16,0:09:47.54,Default,,0,0,0,,Жалған дабылдардың пайда болуына байланысты -
Dialogue: 0,0:09:47.67,0:09:50.21,Default,,0,0,0,,Кейбір аймақтарда шатастырмау үшін -
Dialogue: 0,0:09:50.29,0:09:51.88,Default,,0,0,0,,Эвакуация туралы бұйрық шығарылды
Dialogue: 0,0:09:52.59,0:09:55.01,Default,,0,0,0,,Дүние жүзінде пайда болған Дигимон...
Dialogue: 0,0:09:55.13,0:09:57.59,Default,,0,0,0,,Олардың бір түр екендігі туралы пікір айтылды.
Dialogue: 0,0:09:57.97,0:10:00.30,Default,,0,0,0,,Алайда оның пайда болған аймағы бекітілмеген.
Dialogue: 0,0:10:00.43,0:10:02.93,Default,,0,0,0,,Оның келесі жерде пайда болатыны туралы болжамдар да...
Dialogue: 0,0:10:03.06,0:10:04.60,Default,,0,0,0,,орындалу күйінде
Dialogue: 0,0:10:05.06,0:10:07.44,Default,,0,0,0,,Келесі кезекте Триумфа аркасы емес пе?
Dialogue: 0,0:10:07.56,0:10:10.10,Default,,0,0,0,,Сіз әлем бойынша саяхаттайсыз ба?
Dialogue: 0,0:10:10.48,0:10:11.23,Default,,0,0,0,,Иә
Dialogue: 0,0:10:11.36,0:10:15.61,Default,,0,0,0,,Біз келесі жерде қай жерде боламыз? Мен достарыммен болжам жасаймын.
Dialogue: 0,0:10:16.15,0:10:18.11,Default,,0,0,0,,Ой, күте тұр, не? Бұл
Dialogue: 0,0:10:21.53,0:10:23.24,Default,,0,0,0,,Мен тамақ ішпеймін, ұйықтамаймын...
Dialogue: 0,0:10:23.37,0:10:25.62,Default,,0,0,0,,Бұл өте тітіркендіргіш!
Dialogue: 0,0:10:35.21,0:10:39.26,Default,,0,0,0,,Адамдар... қызықсыз жаратылыстар
Dialogue: 0,0:10:39.38,0:10:41.80,Default,,0,0,0,,Төменгі жан.
Dialogue: 0,0:10:42.72,0:10:46.10,Default,,0,0,0,,Мен Химекаваның жоқ екенін білемін!
Dialogue: 0,0:10:46.22,0:10:50.52,Default,,0,0,0,,Бірақ неге мұнда ешқандай ақпарат түспейді?
Dialogue: 0,0:10:50.81,0:10:53.98,Default,,0,0,0,,Қазір цифрлық әлемде балалар...
Dialogue: 0,0:10:54.57,0:10:56.19,Default,,0,0,0,,Сәлеметсіз бе! (түйменің басылған дыбысы)
Dialogue: 0,0:10:56.32,0:10:57.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:58.36,0:11:00.03,Default,,0,0,0,,Ягами...
Dialogue: 0,0:11:13.29,0:11:15.54,Default,,0,0,0,,Дүние жүзінде пайда болған Дигимондар...
Dialogue: 0,0:11:15.75,0:11:19.05,Default,,0,0,0,,Қазіргі уақытта ол ешбір байқалатын қозғалыстарды көрсетпейді және орнында тұр.
Dialogue: 0,0:11:19.67,0:11:20.88,Default,,0,0,0,,Сондай-ақ, әртүрлі елдер сақтық шараларын қабылдау үшін полицияны жіберді.
Dialogue: 0,0:11:20.88,0:11:23.93,Default,,0,0,0,,Сондай-ақ, әртүрлі елдер сақтық шараларын қабылдау үшін полицияны жіберді.
Dialogue: 0,0:11:20.88,0:11:23.93,Default,,0,0,0,,
Dialogue: 0,0:11:24.22,0:11:25.10,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:11:25.10,0:11:28.47,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:11:25.10,0:11:28.47,Default,,0,0,0,,Көпфункциялы спутник №6 Қатынастарды басқару жүйесінде аномалия орын алды!
Dialogue: 0,0:11:29.02,0:11:30.64,Default,,0,0,0,,Жүйені тексеру Асығыңыз!
Dialogue: 0,0:11:30.77,0:11:31.94,Default,,0,0,0,,Жауап жоқ!
Dialogue: 0,0:11:32.06,0:11:34.44,Default,,0,0,0,,Реакция дөңгелегі Реакция жоқ!
Dialogue: 0,0:11:34.81,0:11:37.48,Default,,0,0,0,,Мынау да... Не болып жатыр?
Dialogue: 0,0:11:41.20,0:11:43.99,Default,,0,0,0,,Дигимонның мақсаты қандай?
Dialogue: 0,0:11:44.12,0:11:48.49,Default,,0,0,0,,Үкімет жауаптарды талқылау үшін министрлер кабинетінің төтенше отырыстарын өткізуде.
Dialogue: 0,0:11:48.70,0:11:51.50,Default,,0,0,0,,Тайчи Хикари…
Dialogue: 0,0:11:55.92,0:11:57.63,Default,,0,0,0,,Мен бәрі жақсы болатынына сенімдімін
Dialogue: 0,0:11:59.96,0:12:02.76,Default,,0,0,0,,Үйге келгенде қарныңыз ашылады.
Dialogue: 0,0:12:03.97,0:12:06.14,Default,,0,0,0,,Күріш Мен оны көп жасауым керек.
Dialogue: 0,0:12:10.77,0:12:11.85,Default,,0,0,0,,Үкіметке келетін болсақ-
Dialogue: 0,0:12:11.98,0:12:15.02,Default,,0,0,0,,Жағдай қазір төтенше жағдай болмаса да...
Dialogue: 0,0:12:15.56,0:12:18.02,Default,,0,0,0,,Болашақ жағдайды мұқият бақылай отырып...
Dialogue: 0,0:12:18.15,0:12:18.98,Default,,0,0,0,,Сарапшыларды қоса алғанда-
Dialogue: 0,0:12:19.11,0:12:21.94,Default,,0,0,0,,Біз жауапты талқылайтынымызды айттық.
Dialogue: 0,0:12:22.19,0:12:27.03,Default,,0,0,0,,Маңызды профессор Мочизукиге қоңырау шалмай, нені талқылап жатырсыз?
Dialogue: 0,0:12:27.91,0:12:32.96,Default,,0,0,0,,Профессор: Біз дағдарыс жағдайында емеспіз деп шынымен айта аламыз ба?
Dialogue: 0,0:12:33.08,0:12:34.75,Default,,0,0,0,,Бұл өте қорқынышты (Нишижима) А...
Dialogue: 0,0:12:35.12,0:12:39.09,Default,,0,0,0,,Дауыл алдындағы тыныштық... Ол да солай болды.
Dialogue: 0,0:12:39.21,0:12:40.05,Default,,0,0,0,,«Бұл»?
Dialogue: 0,0:12:40.80,0:12:42.76,Default,,0,0,0,,Бұл Мейкомон.
Dialogue: 0,0:12:43.38,0:12:46.51,Default,,0,0,0,,Сонымен, бұл ескерту.
Dialogue: 0,0:12:46.64,0:12:49.39,Default,,0,0,0,,Сандық барлық нәрсеге сенетін адамдарға
Dialogue: 0,0:12:49.51,0:12:51.81,Default,,0,0,0,,Ескерту... Кімнен?
Dialogue: 0,0:12:51.93,0:12:53.43,Default,,0,0,0,,Менің ойымша, оны табиғат-ана деп атауға болады.
Dialogue: 0,0:12:53.56,0:12:55.56,Default,,0,0,0,,Жарайды, бұл құдайдың аяны деп аталады.
Dialogue: 0,0:12:55.81,0:12:57.44,Default,,0,0,0,,Табиғат ескертуі...
Dialogue: 0,0:12:57.56,0:12:59.98,Default,,0,0,0,,Ол Digimon цифрлық символы ретінде пайда бола ма?
Dialogue: 0,0:13:00.11,0:13:02.74,Default,,0,0,0,,Бұл өте қызық емес пе?
Dialogue: 0,0:13:02.86,0:13:06.57,Default,,0,0,0,,Жақында болған кең ауқымды Дигимон толқуымен қалай байланысты?
Dialogue: 0,0:13:06.78,0:13:08.32,Default,,0,0,0,,Тотторидегі зертханада
Dialogue: 0,0:13:08.41,0:13:09.74,Default,,0,0,0,,Мейкомон бір рет...
Dialogue: 0,0:13:09.83,0:13:11.91,Default,,0,0,0,,Мен өте қатыгез болдым.
Dialogue: 0,0:13:12.33,0:13:15.92,Default,,0,0,0,,Алғашында қызым жоқ деп қорықтым...
Dialogue: 0,0:13:16.04,0:13:19.38,Default,,0,0,0,,Сонда да мен тұлыпты ұстап тұрғанымда, қызым берген...
Dialogue: 0,0:13:19.50,0:13:21.92,Default,,0,0,0,,Тыныш болды, бірақ-
Dialogue: 0,0:13:22.42,0:13:23.05,Default,,0,0,0,,Келесі сәт -
Dialogue: 0,0:13:23.17,0:13:27.76,Default,,0,0,0,,Мейкомон кенеттен жанартау сияқты магманы шашыратып жіберді.
Dialogue: 0,0:13:28.72,0:13:32.47,Default,,0,0,0,,Мейкомон деген не?
Dialogue: 0,0:13:32.60,0:13:34.18,Default,,0,0,0,,Бұл Дигимон ба?
Dialogue: 0,0:13:34.31,0:13:36.89,Default,,0,0,0,,Бұл Дигимон, бірақ...
Dialogue: 0,0:13:37.02,0:13:39.52,Default,,0,0,0,,Бұл тым көп күшке ие болмыс.
Dialogue: 0,0:13:39.52,0:13:40.69,Default,,0,0,0,,Бұл тым көп күшке ие болмыс.
Dialogue: 0,0:13:39.52,0:13:40.69,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:40.77,0:13:42.69,Default,,0,0,0,,Ах! (Нишижима) Хэкмон!
Dialogue: 0,0:13:43.03,0:13:43.98,Default,,0,0,0,,Hackmon?
Dialogue: 0,0:13:44.11,0:13:46.36,Default,,0,0,0,,Гомеостаз хабаршысы дейді.
Dialogue: 0,0:13:46.49,0:13:47.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:48.07,0:13:51.70,Default,,0,0,0,,Гомеостаз Мейкомонды қорғауға тырысады.
Dialogue: 0,0:13:51.87,0:13:53.74,Default,,0,0,0,,Гомеостаз қорғайды...
Dialogue: 0,0:13:53.87,0:13:55.96,Default,,0,0,0,,Бүкіл әлемнің үйлесімділігі
Dialogue: 0,0:13:56.25,0:13:59.58,Default,,0,0,0,,Ол үшін сізге Мейкомон керек емес пе?
Dialogue: 0,0:13:59.75,0:14:03.09,Default,,0,0,0,,Таразы пайда болғаннан бері бұзылды.
Dialogue: 0,0:14:03.50,0:14:06.09,Default,,0,0,0,,Таразы? (Нишижима) Мен Мейкомон туралы айтып отырмын.
Dialogue: 0,0:14:06.47,0:14:10.89,Default,,0,0,0,,Апокалимон деректерінің фрагменттері оның ішінде сақталады.
Dialogue: 0,0:14:11.01,0:14:11.93,Default,,0,0,0,,Былайша айтқанда-
Dialogue: 0,0:14:12.05,0:14:15.39,Default,,0,0,0,,Ол сандық әлемнің қараңғы жағын қамтыды.
Dialogue: 0,0:14:15.52,0:14:18.64,Default,,0,0,0,,Оның зор күші бар
Dialogue: 0,0:14:19.60,0:14:23.44,Default,,0,0,0,,Оның құдіреттілігі зор болғандықтан, одан аулақ болды.
Dialogue: 0,0:14:23.57,0:14:26.82,Default,,0,0,0,,Жоқ, мен қорықтым деп айтуым керек.
Dialogue: 0,0:14:27.24,0:14:29.20,Default,,0,0,0,,Серіктестің болуы -
Dialogue: 0,0:14:29.32,0:14:32.74,Default,,0,0,0,,Таразы күшімен тепе-теңдікті сақтай алдым.
Dialogue: 0,0:14:32.87,0:14:34.95,Default,,0,0,0,,Сіз Мешин Мочизуки туралы айтып отырсыз ба?
Dialogue: 0,0:14:35.24,0:14:36.20,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:36.33,0:14:39.42,Default,,0,0,0,,Қызымның қасында жүргенде... деген рас.
Dialogue: 0,0:14:39.54,0:14:41.46,Default,,0,0,0,,Мейкомон үнсіз қалды.
Dialogue: 0,0:14:41.54,0:14:44.09,Default,,0,0,0,,Сенің жаныңнан кеткісі келмеді
Dialogue: 0,0:14:44.17,0:14:49.26,Default,,0,0,0,,Қызым жоқта, мысалы, мектепке барғанда мен өзімді жалғыз сезіндім.
Dialogue: 0,0:14:51.59,0:14:53.35,Default,,0,0,0,,Серіктестің болуы -
Dialogue: 0,0:14:53.47,0:14:55.72,Default,,0,0,0,,Бұл біздің үмітіміз еді.
Dialogue: 0,0:14:55.85,0:14:59.64,Default,,0,0,0,,Бірақ басылған қуат...
Dialogue: 0,0:14:59.77,0:15:01.73,Default,,0,0,0,,Шұңқыр шыққанда...
Dialogue: 0,0:15:01.85,0:15:04.48,Default,,0,0,0,,Күтілгеннен көп қуат беретін шүмектер
Dialogue: 0,0:15:05.44,0:15:09.07,Default,,0,0,0,,Бір рет атқылаған инстинкт деп атауға болатын күштің алдында...
Dialogue: 0,0:15:09.19,0:15:13.32,Default,,0,0,0,,Серіктестік енді мағынасыз
Dialogue: 0,0:15:13.70,0:15:15.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:15.62,0:15:17.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:17.62,0:15:19.25,Default,,0,0,0,,Таразының күші -
Dialogue: 0,0:15:19.37,0:15:25.13,Default,,0,0,0,,Ол енді ұлы келісім мен тұрақтылықты бұзатын қауіпке айналды.
Dialogue: 0,0:15:26.09,0:15:28.34,Default,,0,0,0,,Қауіп?
Dialogue: 0,0:15:29.88,0:15:32.34,Default,,0,0,0,,Менің қызым... анау қыз...
Dialogue: 0,0:15:32.89,0:15:34.85,Default,,0,0,0,,Таңдаулы бала ретінде...
Dialogue: 0,0:15:34.97,0:15:37.85,Default,,0,0,0,,Мен тым көп жүк көтердім бе?
Dialogue: 0,0:15:38.52,0:15:41.35,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:15:45.61,0:15:47.36,Default,,0,0,0,,Иттай!
Dialogue: 0,0:15:47.48,0:15:49.65,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:49.78,0:15:54.62,Default,,0,0,0,,Кенет еңіске айналды, енді ғана аяғымның асты кенет батпаққа айналды.
Dialogue: 0,0:15:55.20,0:15:57.16,Default,,0,0,0,,Енді қайда және қалай жүгіру керек?
Dialogue: 0,0:15:57.28,0:15:58.62,Default,,0,0,0,,Менде ештеңе жоқ!
Dialogue: 0,0:15:59.04,0:16:00.87,Default,,0,0,0,,Мейкомонның болуы...
Dialogue: 0,0:16:01.00,0:16:04.17,Default,,0,0,0,,Мүмкін, қайта жүктеуден аман қалатын бірдеңе болып жатқан шығар.
Dialogue: 0,0:16:04.33,0:16:06.13,Default,,0,0,0,,Бұл Мейкомонды тоқтатуымыз керек дегенді білдіре ме?
Dialogue: 0,0:16:06.13,0:16:06.67,Default,,0,0,0,,Бұл біз Мейкомонды тоқтатуымыз керек дегенді білдіре ме?
Dialogue: 0,0:16:06.13,0:16:06.67,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:16:06.67,0:16:06.79,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:16:06.79,0:16:07.63,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:16:06.79,0:16:07.63,Default,,0,0,0,,Ах
Dialogue: 0,0:16:09.76,0:16:11.88,Default,,0,0,0,,(Доримогемонның шайқас айқайы)
Dialogue: 0,0:16:14.22,0:16:16.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:21.56,0:16:23.19,Default,,0,0,0,,Yamato! Осы уақытта қашыңыз!
Dialogue: 0,0:16:23.31,0:16:24.14,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:16:24.23,0:16:26.15,Default,,0,0,0,,(Тайчи мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:16:28.77,0:16:31.78,Default,,0,0,0,,Ах! Алақай! (Тайчи және басқалар) Ах!
Dialogue: 0,0:16:32.11,0:16:33.86,Default,,0,0,0,,Бұл не? бұл!
Dialogue: 0,0:16:36.16,0:16:37.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:38.08,0:16:39.45,Default,,0,0,0,,Ах... Рахмет, Биомон.
Dialogue: 0,0:16:39.58,0:16:41.37,Default,,0,0,0,,Жоқ! (бос) А
Dialogue: 0,0:16:45.00,0:16:46.13,Default,,0,0,0,,Хикари!
Dialogue: 0,0:16:53.30,0:16:54.47,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:16:55.18,0:16:57.18,Default,,0,0,0,,Амансың ба? (Коширо) Рахмет
Dialogue: 0,0:16:57.51,0:16:59.93,Default,,0,0,0,,Такеру Патамон рахмет
Dialogue: 0,0:17:00.22,0:17:02.93,Default,,0,0,0,,Хикари Сіз ауырып қалдыңыз ба? Иә
Dialogue: 0,0:17:03.14,0:17:05.39,Default,,0,0,0,,Биомон рахмет
Dialogue: 0,0:17:07.15,0:17:08.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:10.19,0:17:11.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:11.28,0:17:12.44,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:17:15.82,0:17:18.45,Default,,0,0,0,,Иә? Жол...!
Dialogue: 0,0:17:18.53,0:17:22.41,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:17:28.92,0:17:30.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:30.50,0:17:32.71,Default,,0,0,0,,Ауырсыну... жоқ
Dialogue: 0,0:17:32.80,0:17:34.92,Default,,0,0,0,,Мугю…
Dialogue: 0,0:17:35.67,0:17:37.55,Default,,0,0,0,,... Тез кет.
Dialogue: 0,0:17:37.68,0:17:39.05,Default,,0,0,0,,Ах... кешіріңіз!
Dialogue: 0,0:17:39.64,0:17:42.81,Default,,0,0,0,,Олар әзірге сіздің артыңыздан келмейтін сияқты.
Dialogue: 0,0:17:43.14,0:17:44.60,Default,,0,0,0,,және басқа да байланыс құралдарын—өшіріп, сол үстелге қойыңыз.
Dialogue: 0,0:17:44.73,0:17:47.10,Default,,0,0,0,,Тіпті мен цифрлық әлемге алғаш келгенімде...
Dialogue: 0,0:17:47.23,0:17:49.69,Default,,0,0,0,,Маған Кувагамон және басқалары бұрын...
Dialogue: 0,0:17:50.06,0:17:53.44,Default,,0,0,0,,Тіпті ормандағы өсімдіктерге де шабуыл жасалмаған.
Dialogue: 0,0:17:54.28,0:17:55.36,Default,,0,0,0,,Мен сені жек көремін
Dialogue: 0,0:17:55.65,0:17:56.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:57.53,0:18:03.16,Default,,0,0,0,,Сандық әлем бізді жек көреді
Dialogue: 0,0:18:03.87,0:18:05.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:07.04,0:18:09.08,Default,,0,0,0,,Менің ойымша, бұл жайсыздық
Dialogue: 0,0:18:14.92,0:18:18.18,Default,,0,0,0,,Сандық әлем бізді алаңдатады...
Dialogue: 0,0:18:18.30,0:18:19.59,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:18:22.10,0:18:26.77,Default,,0,0,0,,Сіз серіктесіңіздің күшімен енді ештеңе істей алмайтыныңызға сенімдісіз бе?
Dialogue: 0,0:18:27.39,0:18:29.02,Default,,0,0,0,,Әлі де үміт жоқ па?
Dialogue: 0,0:18:29.14,0:18:32.15,Default,,0,0,0,,Енді рақым жоқ
Dialogue: 0,0:18:32.73,0:18:35.07,Default,,0,0,0,,Үкім шығарылды
Dialogue: 0,0:18:41.37,0:18:45.20,Default,,0,0,0,,Сәл бұрын ғана жарық болды, бірақ кенет түн болды.
Dialogue: 0,0:18:45.54,0:18:48.71,Default,,0,0,0,,Бұл шынымен түн ме?
Dialogue: 0,0:18:52.25,0:18:53.75,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:18:53.88,0:18:58.13,Default,,0,0,0,,Бұлай болмаса, жұлдыздай аққан сұлу болар еді.
Dialogue: 0,0:18:58.26,0:19:01.59,Default,,0,0,0,,Аққан жұлдыз болса, үйге баруыңды өтінемін.
Dialogue: 0,0:19:01.97,0:19:03.97,Default,,0,0,0,,Мен қайтып оралуым керек.
Dialogue: 0,0:19:04.10,0:19:06.01,Default,,0,0,0,,Мейкомонды тоқтатыңыз
Dialogue: 0,0:19:06.14,0:19:10.02,Default,,0,0,0,,Коуширо: Бұрмаланған жерді тауып, үйге қайту мүмкін бе?
Dialogue: 0,0:19:10.39,0:19:13.98,Default,,0,0,0,,Мен бұрмалау орнын анықтауға тырыстым...
Dialogue: 0,0:19:14.23,0:19:14.98,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:19:14.98,0:19:15.40,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:19:14.98,0:19:15.40,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:15.40,0:19:16.02,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:19.40,0:19:24.28,Default,,0,0,0,,Мен Мэй Чанды тоқтата алмадым
Dialogue: 0,0:19:24.37,0:19:26.41,Default,,0,0,0,,Бұл Меймейдің кінәсі емес!
Dialogue: 0,0:19:26.95,0:19:30.29,Default,,0,0,0,,Мен Мэй Чанның серіктесімін.
Dialogue: 0,0:19:34.84,0:19:37.30,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:19:46.89,0:19:48.85,Default,,0,0,0,,Біз серіктес болғандықтан...
Dialogue: 0,0:19:48.97,0:19:50.81,Default,,0,0,0,,Барлығы ойлағандай бола бермейді.
Dialogue: 0,0:19:51.39,0:19:52.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:54.10,0:19:55.52,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:19:56.11,0:19:59.32,Default,,0,0,0,,Бір тарап біржақты түрде екінші жаққа бағынады...
Dialogue: 0,0:19:59.44,0:20:00.94,Default,,0,0,0,,Серіктес емес
Dialogue: 0,0:20:04.78,0:20:06.70,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:20:10.04,0:20:14.54,Default,,0,0,0,,Екеуіміздің де кемшіліктеріміз көп...
Dialogue: 0,0:20:14.67,0:20:17.92,Default,,0,0,0,,Бірақ бұл дұрыс деп ойлаймын.
Dialogue: 0,0:20:18.84,0:20:22.22,Default,,0,0,0,,Демек, біз серіктеспіз, солай ма?
Dialogue: 0,0:20:22.72,0:20:26.64,Default,,0,0,0,,I... Әр адамның өз серіктесімен байланысы
Dialogue: 0,0:20:26.76,0:20:28.22,Default,,0,0,0,,Мен көп нәрсені көрдім
Dialogue: 0,0:20:28.97,0:20:34.23,Default,,0,0,0,,Біздің қарым-қатынастарымыз әртүрлі болғанымен, бізді біріктіретін күшті байланыс бар.
Dialogue: 0,0:20:34.98,0:20:39.02,Default,,0,0,0,,Бұл менде және Мэйде бар ма?
Dialogue: 0,0:20:40.32,0:20:43.49,Default,,0,0,0,,Уууу, сен мені көруге келгенің ғой, солай ма? Әзірге
Dialogue: 0,0:20:43.86,0:20:46.95,Default,,0,0,0,,Мен сенің серігің болудан қашпаймын.
Dialogue: 0,0:20:47.07,0:20:48.49,Default,,0,0,0,,Не болса да
Dialogue: 0,0:20:48.91,0:20:53.25,Default,,0,0,0,,Бірақ мен келгеннен бері Мэй Чан солай көрінеді...
Dialogue: 0,0:20:53.58,0:20:54.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:54.79,0:20:56.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:56.42,0:20:58.63,Default,,0,0,0,,Бұл менің кінәм шығар.
Dialogue: 0,0:20:58.92,0:21:00.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:00.92,0:21:05.38,Default,,0,0,0,,Мен не үшін таңдалдым?
Dialogue: 0,0:21:05.84,0:21:07.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:08.01,0:21:09.76,Default,,0,0,0,,Ештеңе жасалмады
Dialogue: 0,0:21:09.89,0:21:12.89,Default,,0,0,0,,Керісінше, Мэй-чан...
Dialogue: 0,0:21:15.85,0:21:17.60,Default,,0,0,0,,Меймей...
Dialogue: 0,0:21:23.11,0:21:24.65,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:21:27.32,0:21:31.29,Default,,0,0,0,,Қолыңнан ештеңе келмесе, неге мені таңдадың?
Dialogue: 0,0:21:31.66,0:21:34.96,Default,,0,0,0,,Таңдалған адамдар көбірек болуы керек еді.
Dialogue: 0,0:21:35.21,0:21:39.71,Default,,0,0,0,,Ол мені таңдағандықтан, осылай болады...
Dialogue: 0,0:21:40.84,0:21:42.13,Default,,0,0,0,,Ах
Dialogue: 0,0:21:42.75,0:21:44.84,Default,,0,0,0,,Жалғызсың деме
Dialogue: 0,0:21:45.76,0:21:50.22,Default,,0,0,0,,Біз таңдалғандықтан, дос болдық, солай ма?
Dialogue: 0,0:21:50.47,0:21:52.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:52.51,0:21:55.73,Default,,0,0,0,,Біз қазір осылай біргеміз, солай ма?
Dialogue: 0,0:21:57.52,0:21:58.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:07.32,0:22:10.24,Default,,0,0,0,,Өзіңізді жалғыз қалдырмаңыз
Dialogue: 0,0:22:12.62,0:22:16.62,Default,,0,0,0,,Жалғыздық сезінгенде, Жүрегімде тікен пайда болады.
Dialogue: 0,0:22:18.21,0:22:21.34,Default,,0,0,0,,Мен де солай болдым.
Dialogue: 0,0:22:25.42,0:22:26.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:28.43,0:22:30.01,Default,,0,0,0,,Жарайды
Dialogue: 0,0:22:30.64,0:22:35.10,Default,,0,0,0,,Мейшин-санның сезімі Мейкомонға міндетті түрде жеткізіледі.
Dialogue: 0,0:22:36.48,0:22:40.98,Default,,0,0,0,,Сіз шынымен жеткізгіңіз келетін сезімдер міндетті түрде жеткізіледі.
Dialogue: 0,0:22:41.31,0:22:42.61,Default,,0,0,0,,Өйткені біз серіктеспіз.
Dialogue: 0,0:22:43.73,0:22:47.11,Default,,0,0,0,,Мен нені айтқым келеді...
Dialogue: 0,0:22:49.99,0:22:52.32,Default,,0,0,0,,мамыр~ Біртіндеп!
Dialogue: 0,0:22:55.99,0:22:58.41,Default,,0,0,0,,Серіктесіңізге сеніңіз
Dialogue: 0,0:22:58.54,0:23:02.75,Default,,0,0,0,,Ал серіктес болып сайланған Мешін.
Dialogue: 0,0:23:03.21,0:23:06.00,Default,,0,0,0,,Көңілге шыққалы тұрған жүрекке езілме.
Dialogue: 0,0:23:06.13,0:23:09.67,Default,,0,0,0,,Біз соншалықты әлсіз бола алмаймыз.
Dialogue: 0,0:23:09.80,0:23:14.47,Default,,0,0,0,,Жоқ, әлсіз болсам да, бәрі... достарым қасымда.
Dialogue: 0,0:23:15.14,0:23:19.89,Default,,0,0,0,,Мешин-сан үшін де, біз үшін де таңдалудың мағынасы бар.
Dialogue: 0,0:23:21.10,0:23:22.90,Default,,0,0,0,,Күшсіз...
Dialogue: 0,0:23:23.02,0:23:26.65,Default,,0,0,0,,Сіз серігіңізден қорқатын таңдаулы баласыз ба?
Dialogue: 0,0:23:26.78,0:23:28.15,Default,,0,0,0,,«Таңдалған бала» емес
Dialogue: 0,0:23:30.53,0:23:32.16,Default,,0,0,0,,«Таңдалған балалар»
Dialogue: 0,0:23:37.45,0:23:41.16,Default,,0,0,0,,Оны жалғыз алып жүрме, бізбен де бөліс
Dialogue: 0,0:23:42.17,0:23:45.17,Default,,0,0,0,,Нені бөлу керек? Маған да беріңіз!
Dialogue: 0,0:23:45.25,0:23:47.42,Default,,0,0,0,,Ұйықта, иә?
Dialogue: 0,0:23:48.09,0:23:49.76,Default,,0,0,0,,Агумон...
Dialogue: 0,0:23:50.26,0:23:52.93,Default,,0,0,0,,Сіз...
Dialogue: 0,0:23:53.30,0:23:56.18,Default,,0,0,0,,Ештеңе емес пе? Онда қайырлы түн
Dialogue: 0,0:23:56.47,0:23:58.93,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:23:59.06,0:24:01.94,Default,,0,0,0,,Егер адамдар біз туралы солай ойласа, ыңғайсыздық тудырар еді.
Dialogue: 0,0:24:02.14,0:24:05.94,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:24:06.02,0:24:08.94,Default,,0,0,0,,Кристалда жарық жүздеген миллион рет шағылады—
Dialogue: 0,0:24:09.23,0:24:12.53,Default,,0,0,0,,Бұл жолы Мейкомонның әбігеріне байланысты...
Dialogue: 0,0:24:12.65,0:24:14.95,Default,,0,0,0,,Менің ойымша, Дигимон тағы да сынға ұшырайды.
Dialogue: 0,0:24:23.33,0:24:25.96,Default,,0,0,0,,
Dialogue: 0,0:24:26.38,0:24:30.71,Default,,0,0,0,,Агумон және басқалары бізді осында қатты қорғады.
Dialogue: 0,0:24:32.92,0:24:36.34,Default,,0,0,0,,Біз оны қорғаймыз.
Dialogue: 0,0:24:37.72,0:24:39.06,Default,,0,0,0,,Сондай-ақ Мейкомон туралы!
Dialogue: 0,0:24:39.14,0:24:40.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:24:40.47,0:24:45.31,Default,,0,0,0,,Алдымызда қандай шындық болмасын, қашпа, біз бірге боламыз.
Dialogue: 0,0:24:45.77,0:24:46.94,Default,,0,0,0,,Иә
Dialogue: 0,0:24:47.69,0:24:48.82,Default,,0,0,0,,Иә
Dialogue: 0,0:24:49.40,0:24:50.65,Default,,0,0,0,,Хехе
Dialogue: 0,0:24:51.44,0:24:54.45,Default,,0,0,0,,Мейкомон да маңызды серіктес
Dialogue: 0,0:24:54.57,0:24:56.70,Default,,0,0,0,,Қандай формада болса да
Dialogue: 0,0:24:58.53,0:25:01.49,Default,,0,0,0,,Мейшин көмек күтуде.
Dialogue: 0,0:25:01.62,0:25:04.33,Default,,0,0,0,,Менің көмегім...
Dialogue: 0,0:25:04.75,0:25:07.08,Default,,0,0,0,,Мейкомонға көмектесейік
Dialogue: 0,0:25:09.96,0:25:11.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:11.71,0:25:14.42,Default,,0,0,0,,Гомеостаз жағдайды байыппен қабылдайды-
Dialogue: 0,0:25:14.55,0:25:16.34,Default,,0,0,0,,Таразыны жою туралы шешім қабылдады
Dialogue: 0,0:25:16.47,0:25:17.93,Default,,0,0,0,,Алып тастау…
Dialogue: 0,0:25:18.18,0:25:22.93,Default,,0,0,0,,Бұл Meicoomon өшірілетінін білдіре ме?
Dialogue: 0,0:25:23.60,0:25:24.89,Default,,0,0,0,,Тіпті қайта жүктеу кезінде де -
Dialogue: 0,0:25:25.02,0:25:27.52,Default,,0,0,0,,Мен оны баса алмағандықтан...
Dialogue: 0,0:25:27.65,0:25:29.94,Default,,0,0,0,,Оларды тікелей өз қолымызбен өлтіруден басқа амалымыз жоқ.
Dialogue: 0,0:25:30.86,0:25:32.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:25:33.07,0:25:35.86,Default,,0,0,0,,Таразылардың қорғаныс инстинкті болғандықтан...
Dialogue: 0,0:25:35.99,0:25:37.82,Default,,0,0,0,,Ол белгілі бір мутацияға ұшырады.
Dialogue: 0,0:25:37.95,0:25:39.03,Default,,0,0,0,,Мутация?
Dialogue: 0,0:25:39.16,0:25:40.99,Default,,0,0,0,,Бұл эволюция емес пе?
Dialogue: 0,0:25:41.12,0:25:42.62,Default,,0,0,0,,Ештеңе шығармайды.
Dialogue: 0,0:25:42.74,0:25:45.71,Default,,0,0,0,,Тек қирату әкелетін эволюция жоқ.
Dialogue: 0,0:25:47.08,0:25:48.96,Default,,0,0,0,,Оны қазір жоймасақ...
Dialogue: 0,0:25:49.54,0:25:51.80,Default,,0,0,0,,Болашақта қандай өзгерістер енгізесіз?
Dialogue: 0,0:25:51.92,0:25:52.88,Default,,0,0,0,,Мен тіпті елестете де алмаймын
Dialogue: 0,0:25:53.00,0:25:54.09,Default,,0,0,0,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,0:25:54.21,0:25:55.42,Default,,0,0,0,,Осы уақытқа дейін біз...
Dialogue: 0,0:25:55.55,0:25:57.88,Default,,0,0,0,,Мейкомонды қорғауға көшті.
Dialogue: 0,0:25:58.01,0:26:00.01,Default,,0,0,0,,Бұлай деңіз, себебі ол зорлық-зомбылық жасай бастады ...
Dialogue: 0,0:26:00.14,0:26:01.43,Default,,0,0,0,,Мен сені бұл жолы жоятыныма сене алар емеспін... (Ұялы телефонның рингтоны)
Dialogue: 0,0:26:01.55,0:26:02.85,Default,,0,0,0,,Иә? (Ұялы телефон жұмысының дыбысы)
Dialogue: 0,0:26:02.97,0:26:04.06,Default,,0,0,0,,Иә
Dialogue: 0,0:26:05.81,0:26:08.90,Default,,0,0,0,,Не? Сіз бұған сенімдісіз бе?
Dialogue: 0,0:26:10.06,0:26:11.44,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:26:14.07,0:26:15.57,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:26:16.57,0:26:17.99,Default,,0,0,0,,Не болды?
Dialogue: 0,0:26:18.36,0:26:23.54,Default,,0,0,0,,Өзін-өзі қорғау күштері орналастыруға дайындалып жатқан сияқты...
Dialogue: 0,0:26:23.87,0:26:27.00,Default,,0,0,0,,Олар бізді қолдауы керек.
Dialogue: 0,0:26:27.16,0:26:28.37,Default,,0,0,0,,Дұрыс, болды!
Dialogue: 0,0:26:28.50,0:26:31.50,Default,,0,0,0,,Үкіметпен келіссөздер жүргізілуде
Dialogue: 0,0:26:31.79,0:26:34.00,Default,,0,0,0,,Неге маған бұрын айтпадың?
Dialogue: 0,0:26:34.50,0:26:36.97,Default,,0,0,0,,Енді сіз не істей алатыныңызды білесіз бе?
Dialogue: 0,0:26:37.09,0:26:39.01,Default,,0,0,0,,Уф...қайтадан-
Dialogue: 0,0:26:39.88,0:26:43.51,Default,,0,0,0,,Біз дүниенің ақырын көріп тұрған жоқпыз ба?
Dialogue: 0,0:26:43.97,0:26:45.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:26:46.47,0:26:50.48,Default,,0,0,0,,Біз барлығында үйлесімділікті қалаймыз
Dialogue: 0,0:26:50.60,0:26:54.44,Default,,0,0,0,,Гармония сақталған жағдайда ғана мүмкін болады
Dialogue: 0,0:26:54.57,0:26:57.11,Default,,0,0,0,,Енді сіз алаңдаушы болдыңыз ...
Dialogue: 0,0:26:57.24,0:26:59.78,Default,,0,0,0,,Біз енді оны назардан тыс қалдыра алмаймыз.
Dialogue: 0,0:27:00.53,0:27:03.41,Default,,0,0,0,,Бөгде зат ретінде алып тастаңыз
Dialogue: 0,0:27:10.62,0:27:13.04,Default,,0,0,0,,Өз қалауым бойынша...
Dialogue: 0,0:27:14.04,0:27:18.84,Default,,0,0,0,,Сонда Ягами, Мочизуки және басқалары не үшін?
Dialogue: 0,0:27:18.97,0:27:19.80,Default,,0,0,0,,О
Dialogue: 0,0:27:20.68,0:27:23.05,Default,,0,0,0,,Оны қысқартудың орнына...
Dialogue: 0,0:27:23.39,0:27:25.47,Default,,0,0,0,,Неліктен оны таңдадыңыз?
Dialogue: 0,0:27:40.24,0:27:41.11,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:27:54.83,0:27:57.30,Default,,0,0,0,,(Макеракмонның шайқас айқайы)
Dialogue: 0,0:27:57.75,0:28:00.67,Default,,0,0,0,,Бұл зауыт жанартаулық геотермалдық жылуды пайдаланады.
Dialogue: 0,0:27:57.75,0:28:00.67,Default,,0,0,0,,
Dialogue: 0,0:28:01.09,0:28:01.88,Default,,0,0,0,,Жергілікті...
Dialogue: 0,0:28:02.01,0:28:05.89,Default,,0,0,0,,Кейбіреулер жақын маңдағы жанартаулық белсенділікті тудыруға алаңдайды.
Dialogue: 0,0:28:06.64,0:28:07.51,Default,,0,0,0,,кенеттен пайда болды-
Dialogue: 0,0:28:07.64,0:28:10.02,Default,,0,0,0,,Дигимонның осы жойқын әрекетіне байланысты...
Dialogue: 0,0:28:10.14,0:28:12.89,Default,,0,0,0,,Зақым жақын маңдағы ауылдарға таралу қаупі бар.
Dialogue: 0,0:28:12.98,0:28:16.44,Default,,0,0,0,,Үкіметтер әскер жіберу туралы шешім қабылдады
Dialogue: 0,0:28:17.19,0:28:21.82,Default,,0,0,0,,Біз өсімдік жойылғаннан кейін жоғалып кеткен дигимонды іздейміз.
Dialogue: 0,0:28:21.95,0:28:23.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:25.62,0:28:26.95,Default,,0,0,0,,Біз қазір-
Dialogue: 0,0:28:27.08,0:28:29.62,Default,,0,0,0,,Digimon пайда болуына байланысты сандық жабдықта ауытқулар―
Dialogue: 0,0:28:29.74,0:28:32.96,Default,,0,0,0,,Және табиғаттың сұмдығына ұшыраған.
Dialogue: 0,0:28:33.83,0:28:36.25,Default,,0,0,0,,Дигимондар біздің әлемде...
Dialogue: 0,0:28:36.38,0:28:38.96,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:28:43.63,0:28:45.30,Default,,0,0,0,,Бөтен заттар…
Dialogue: 0,0:28:55.31,0:28:57.40,Default,,0,0,0,,Қазір ғана күн ашық болса да
Dialogue: 0,0:28:57.52,0:28:58.86,Default,,0,0,0,,«Бұл өзгермелі».
Dialogue: 0,0:28:58.98,0:29:02.49,Default,,0,0,0,,Ол «әйел жүрегі және цифрлық әлемнің аспаны» деп аталады.
Dialogue: 0,0:29:02.61,0:29:04.65,Default,,0,0,0,,Сіз қиын сөздерді білесіз.
Dialogue: 0,0:29:13.58,0:29:15.58,Default,,0,0,0,,Хикари-чан?
Dialogue: 0,0:29:16.00,0:29:20.25,Default,,0,0,0,,Сіз цифрлық әлем бізді жек көреді деп айттыңыз, солай емес пе?
Dialogue: 0,0:29:22.96,0:29:24.67,Default,,0,0,0,,«Шығу» иә?
Dialogue: 0,0:29:25.09,0:29:28.89,Default,,0,0,0,,Мен мұны цифрлық әлем айтып тұрғандай сезінемін.
Dialogue: 0,0:29:29.76,0:29:33.02,Default,,0,0,0,,Аспан, жер, ауа...
Dialogue: 0,0:29:33.14,0:29:36.19,Default,,0,0,0,,Бізді ештеңе қабылдамайды.
Dialogue: 0,0:29:36.31,0:29:38.15,Default,,0,0,0,,Ешкім нәтижелерге сәйкес келмейді.
Dialogue: 0,0:29:41.44,0:29:45.15,Default,,0,0,0,,Біз Хикари мен басқаларды жек көрмейміз.
Dialogue: 0,0:29:45.28,0:29:47.66,Default,,0,0,0,,Иә, мен сенімен мәңгі бірге болғым келеді.
Dialogue: 0,0:29:47.91,0:29:50.53,Default,,0,0,0,,Иә, мен Мимиді және басқаларды жақсы көремін!
Dialogue: 0,0:29:50.66,0:29:52.41,Default,,0,0,0,,Пальмон Мен сені жақсы көремін!
Dialogue: 0,0:29:58.08,0:29:59.42,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:30:03.46,0:30:04.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:06.26,0:30:08.76,Default,,0,0,0,,Бірақ жағдайға қарап...
Dialogue: 0,0:30:08.89,0:30:13.10,Default,,0,0,0,,Сізге әлемнің өзі шабуыл жасап жатқандай сезіледі.
Dialogue: 0,0:30:13.22,0:30:16.68,Default,,0,0,0,,Олар бөгде затты жоюға тырысатын шығар.
Dialogue: 0,0:30:17.02,0:30:18.19,Default,,0,0,0,,Бөтен зат?
Dialogue: 0,0:30:18.56,0:30:21.65,Default,,0,0,0,,Бүгінгі цифрлық әлем үшін біз...
Dialogue: 0,0:30:21.77,0:30:24.69,Default,,0,0,0,,Оны вирусқа ұқсас нысан ретінде қарастыруға болады.
Dialogue: 0,0:30:24.94,0:30:27.36,Default,,0,0,0,,Вирус? Бұл қорқынышты!
Dialogue: 0,0:30:27.49,0:30:31.41,Default,,0,0,0,,Қазіргі цифрлық әлем алдыңғысынан айырмашылығы бар ма?
Dialogue: 0,0:30:31.53,0:30:32.70,Default,,0,0,0,,Қайта жүктеу себебі болып табылады ма?
Dialogue: 0,0:30:32.99,0:30:34.29,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:30:34.41,0:30:37.21,Default,,0,0,0,,Бірақ цифрлық әлемнен біз...
Dialogue: 0,0:30:37.33,0:30:39.79,Default,,0,0,0,,Мен бірдеңе өзгеретін сияқты...
Dialogue: 0,0:30:39.92,0:30:44.71,Default,,0,0,0,,Біз цифрлық әлемнен лақтырылатын боламыз
Dialogue: 0,0:30:45.13,0:30:47.72,Default,,0,0,0,,(Тайчидің айқайы)
Dialogue: 0,0:30:48.55,0:30:51.72,Default,,0,0,0,,Біз мазасызбыз
Dialogue: 0,0:30:54.89,0:30:55.72,Default,,0,0,0,,Неге...
Dialogue: 0,0:30:56.22,0:30:58.48,Default,,0,0,0,,Неліктен біз мазасызбыз?
Dialogue: 0,0:30:58.73,0:31:03.48,Default,,0,0,0,,Таңдаулы балалар болғандықтан шығар...?
Dialogue: 0,0:31:11.11,0:31:12.45,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:31:17.62,0:31:18.75,Default,,0,0,0,,Е...
Dialogue: 0,0:31:18.83,0:31:21.83,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:31:23.17,0:31:25.21,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:31:25.34,0:31:28.26,Default,,0,0,0,,Біз цифрлық әлемге алғаш келген кезде...
Dialogue: 0,0:31:28.63,0:31:30.76,Default,,0,0,0,,Мен Агумонмен кездескен жер
Dialogue: 0,0:31:42.94,0:31:48.86,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:31:51.20,0:31:54.16,Default,,0,0,0,,Келіңіз және өз көзіңізбен көріңіз
Dialogue: 0,0:31:54.95,0:32:00.29,Default,,0,0,0,,Ал біз бірге құрып кетейік.
Dialogue: 0,0:32:07.92,0:32:11.47,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:32:11.59,0:32:13.59,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:32:13.72,0:32:15.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:17.60,0:32:19.14,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:32:24.31,0:32:26.02,Default,,0,0,0,,Қайтып келдіңіз бе?
Dialogue: 0,0:32:26.15,0:32:28.23,Default,,0,0,0,,Шынайы ма? сәттілік!
Dialogue: 0,0:32:28.73,0:32:30.23,Default,,0,0,0,,Ах
Dialogue: 0,0:32:33.40,0:32:36.53,Default,,0,0,0,,Тайчи, бұл қайда? Мұнда қайда?
Dialogue: 0,0:32:36.66,0:32:38.74,Default,,0,0,0,,А, міне...
Dialogue: 0,0:32:39.20,0:32:40.50,Default,,0,0,0,,Біздің…
Dialogue: 0,0:32:40.62,0:32:42.04,Default,,0,0,0,,Аспан әлемі ме?
Dialogue: 0,0:32:42.16,0:32:43.25,Default,,0,0,0,,Бұл Дигимон!
Dialogue: 0,0:32:44.25,0:32:46.25,Default,,0,0,0,,(баланың жылауы)
Dialogue: 0,0:32:46.46,0:32:50.30,Default,,0,0,0,,Неге жылайсың? біз ештеңе істемедік
Dialogue: 0,0:32:50.42,0:32:52.09,Default,,0,0,0,,Бала болғандықтан емес пе?
Dialogue: 0,0:32:52.22,0:32:54.30,Default,,0,0,0,,Бұл қорғаныс инстинктінің бір түрі, солай емес пе?
Dialogue: 0,0:32:54.43,0:32:55.51,Default,,0,0,0,,Boei?
Dialogue: 0,0:32:55.68,0:32:57.76,Default,,0,0,0,,Біз соншалықты қауіптіміз бе?
Dialogue: 0,0:32:57.89,0:32:59.93,Default,,0,0,0,,О, шок!
Dialogue: 0,0:33:00.06,0:33:03.23,Default,,0,0,0,,Жарайды, Пальмон сүйкімді көрінеді!
Dialogue: 0,0:33:03.35,0:33:04.56,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:33:04.69,0:33:08.06,Default,,0,0,0,,Олай болса, сол балалармен достасайық.
Dialogue: 0,0:33:08.19,0:33:09.02,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:33:09.19,0:33:12.61,Default,,0,0,0,,Балалар сендерге не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:33:12.94,0:33:16.11,Default,,0,0,0,,Жарайды, мен әзілдеп едім.
Dialogue: 0,0:33:18.99,0:33:21.70,Default,,0,0,0,,Бұл... Дигимон болуы мүмкін бе?
Dialogue: 0,0:33:21.83,0:33:22.33,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:33:22.33,0:33:24.12,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:33:22.33,0:33:24.12,Default,,0,0,0,,Асығыңыз! (Мешін) Е...
Dialogue: 0,0:33:24.21,0:33:27.13,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:33:27.38,0:33:30.13,Default,,0,0,0,,Ах! Эй, сәл күте тұрыңыз!
Dialogue: 0,0:33:30.34,0:33:32.38,Default,,0,0,0,,Дигимоны бар күдікті балалар табылды
Dialogue: 0,0:33:32.51,0:33:34.63,Default,,0,0,0,,Маған шұғыл көмек керек. Орналасқан жері...
Dialogue: 0,0:33:34.72,0:33:37.26,Default,,0,0,0,,Бір үлгіде жүгіруден шаршадым!
Dialogue: 0,0:33:37.39,0:33:39.89,Default,,0,0,0,,Жалықтысың ба, жоқ па бәрібір!
Dialogue: 0,0:33:39.97,0:33:43.02,Default,,0,0,0,,Тайчи! Өйткені сен кенеттен қашып кеттің!
Dialogue: 0,0:33:43.14,0:33:44.89,Default,,0,0,0,,Шаршадым да жүгіре бастадым...
Dialogue: 0,0:33:45.14,0:33:47.90,Default,,0,0,0,,Бұл бізді күдікті етпейді!
Dialogue: 0,0:33:48.19,0:33:51.65,Default,,0,0,0,,Сіздің таңдауыңыз жоқ! Мен жүгіре бастадым!
Dialogue: 0,0:33:51.77,0:33:53.53,Default,,0,0,0,,Тору, менімен бірге жүр. (Ишикава) Ээ…
Dialogue: 0,0:33:53.99,0:33:55.65,Default,,0,0,0,,Сіз өзіңіз жүгіре аласыз!
Dialogue: 0,0:33:55.90,0:33:58.03,Default,,0,0,0,,А... жаман!
Dialogue: 0,0:33:59.03,0:34:01.66,Default,,0,0,0,,Полицей! Мұнда! Мен мындамын!
Dialogue: 0,0:34:06.08,0:34:07.25,Default,,0,0,0,,Биомон, қаш!
Dialogue: 0,0:34:07.37,0:34:08.67,Default,,0,0,0,,Аспанды артта қалдыруға болмайды!
Dialogue: 0,0:34:09.08,0:34:10.04,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:34:10.17,0:34:12.42,Default,,0,0,0,,Коуширо, Агумон және басқалары қашып кетсін.
Dialogue: 0,0:34:12.55,0:34:13.55,Default,,0,0,0,,Маған қашуға рұқсат етіңіз...
Dialogue: 0,0:34:13.67,0:34:16.38,Default,,0,0,0,,Бұл дүниеде компьютерлер жұмыс істемейді ме?
Dialogue: 0,0:34:16.51,0:34:17.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:25.31,0:34:27.23,Default,,0,0,0,,Күте тұрыңыз, ештеңе істемеңіз!
Dialogue: 0,0:34:27.35,0:34:29.19,Default,,0,0,0,,Бірақ осы қарқынмен...
Dialogue: 0,0:34:31.77,0:34:34.36,Default,,0,0,0,,Дау-дамай шығармаған дұрыс.
Dialogue: 0,0:34:37.44,0:34:39.15,Default,,0,0,0,,ашылды! Бұған!
Dialogue: 0,0:34:39.36,0:34:40.66,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:34:40.82,0:34:42.91,Default,,0,0,0,,Кіріңіз! (Аспан) Тезірек!
Dialogue: 0,0:34:43.16,0:34:44.41,Default,,0,0,0,,Такеру және басқалары ше?
Dialogue: 0,0:34:44.70,0:34:47.41,Default,,0,0,0,,Біз жақсы боламыз, сондықтан асығыңыз!
Dialogue: 0,0:34:49.54,0:34:51.38,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:34:54.92,0:34:57.88,Default,,0,0,0,,Бұл құпия есеп сияқты естіледі.
Dialogue: 0,0:34:58.01,0:35:00.22,Default,,0,0,0,,Осы тоқсанда қабылдау емтиханын тапсыру сізді уайымдады ма?
Dialogue: 0,0:35:00.34,0:35:02.43,Default,,0,0,0,,Енді қайтып келдің, бұл табиғи нәрсе.
Dialogue: 0,0:35:02.80,0:35:06.14,Default,,0,0,0,,Джо мырза, бір мағынада сіздің бейімделу қабілетіңіз зор.
Dialogue: 0,0:35:06.27,0:35:08.06,Default,,0,0,0,,мен мұндай Риппл қолданушыны еркін жібере алмаймын.
Dialogue: 0,0:35:10.73,0:35:13.69,Default,,0,0,0,,Сізбен бірге болған Дигимонға не болды?
Dialogue: 0,0:35:13.98,0:35:16.15,Default,,0,0,0,,Сіздердің Дигимонмен бірге болғандарыңыз...
Dialogue: 0,0:35:16.28,0:35:18.28,Default,,0,0,0,,Полиция қызметкерлері де куә болды
Dialogue: 0,0:35:18.40,0:35:20.11,Default,,0,0,0,,Мен жай ғана досыммен болдым.
Dialogue: 0,0:35:20.24,0:35:21.32,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:35:21.53,0:35:23.91,Default,,0,0,0,,Мен достарыммен бара алмаймын ба?
Dialogue: 0,0:35:24.33,0:35:27.33,Default,,0,0,0,,Дигимондар қазір қауіпті тіршілік иелері болып саналады.
Dialogue: 0,0:35:27.66,0:35:29.00,Default,,0,0,0,,Бұл қауіпті емес!
Dialogue: 0,0:35:29.12,0:35:32.08,Default,,0,0,0,,Иә, олар өте жақсы балалар!
Dialogue: 0,0:35:32.17,0:35:35.42,Default,,0,0,0,,Дигимонның кесірінен дәл қазір әлемде не болып жатыр?
Dialogue: 0,0:35:35.55,0:35:36.84,Default,,0,0,0,,Оны сендер де білесіңдер!
Dialogue: 0,0:35:37.09,0:35:37.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:37.92,0:35:38.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:39.09,0:35:41.59,Default,,0,0,0,,Дүние жүзінде? (Коширо) Сіз нені айтып тұрсыз?
Dialogue: 0,0:35:41.84,0:35:43.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:45.85,0:35:47.60,Default,,0,0,0,,
Dialogue: 0,0:35:50.14,0:35:50.73,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:35:50.73,0:35:51.14,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:35:50.73,0:35:51.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:35:51.14,0:35:51.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:35:51.85,0:35:54.61,Default,,0,0,0,,Осы балаларды өз қамқорлығына алғысы келетін адам бар.
Dialogue: 0,0:35:58.65,0:36:01.86,Default,,0,0,0,,Неліктен мемлекеттік мекеме сол балаларды таңдады?
Dialogue: 0,0:36:01.99,0:36:04.16,Default,,0,0,0,,Өйткені олар маңызды балалар.
Dialogue: 0,0:36:04.28,0:36:08.24,Default,,0,0,0,,«Иә, өтінемін» деп жай ғана тапсыруға болмайды.
Dialogue: 0,0:36:08.54,0:36:10.75,Default,,0,0,0,,Олар Дигимондарын алып қашып кетті ме?
Dialogue: 0,0:36:10.87,0:36:12.25,Default,,0,0,0,,Бір жерде жасырылған
Dialogue: 0,0:36:12.54,0:36:16.75,Default,,0,0,0,,Полиция келгенде, сіз досыңызды қорғауға тырысқан шығарсыз.
Dialogue: 0,0:36:16.92,0:36:18.38,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:36:18.50,0:36:21.26,Default,,0,0,0,,Сол балалар да айтты...
Dialogue: 0,0:36:21.38,0:36:25.26,Default,,0,0,0,,Жақсы ересек адамның Дигимонмен дос болуы күлкілі.
Dialogue: 0,0:36:26.10,0:36:27.22,Default,,0,0,0,,(Рион) Егер сұраса, олар әлемнің кез келген түкпіріне барады —
Dialogue: 0,0:36:27.60,0:36:31.06,Default,,0,0,0,,Ақпаратты өңдеу жөніндегі ұлттық агенттік, тәуелсіз әкімшілік агенттік
Dialogue: 0,0:36:31.18,0:36:35.27,Default,,0,0,0,,Мен Ақпаратты басқару кеңсесінің, Ақпараттық және коммуникациялық стратегиялар бөлімінің өкілімін.
Dialogue: 0,0:36:37.02,0:36:38.57,Default,,0,0,0,,Бұл қысым ма?
Dialogue: 0,0:36:38.98,0:36:41.49,Default,,0,0,0,,Қалағаныңызша қабылдай аласыз.
Dialogue: 0,0:36:41.61,0:36:44.86,Default,,0,0,0,,Алайда балалар бізде қалады.
Dialogue: 0,0:36:44.99,0:36:47.87,Default,,0,0,0,,Олар Дигимонды жасырып тұрғаны анық.
Dialogue: 0,0:36:47.99,0:36:50.33,Default,,0,0,0,,Ол қызықты адам ма...
Dialogue: 0,0:36:50.79,0:36:54.21,Default,,0,0,0,,Мұны бағалау сіздің қолыңызда емес.
Dialogue: 0,0:37:01.55,0:37:05.09,Default,,0,0,0,,Шаршаған шығарсың, мен сені үйге жеткізгім келеді...
Dialogue: 0,0:37:06.68,0:37:09.51,Default,,0,0,0,,Тасымалдағыш сіздің үйіңізге бекітілген.
Dialogue: 0,0:37:09.64,0:37:10.47,Default,,0,0,0,,Бұқаралық ақпарат құралдары! ?
Dialogue: 0,0:37:12.64,0:37:14.89,Default,,0,0,0,,Ақпарат тарап кеткен сияқты.
Dialogue: 0,0:37:16.90,0:37:19.48,Default,,0,0,0,,Сонда үйге бара алмайсың ба?
Dialogue: 0,0:37:19.61,0:37:21.86,Default,,0,0,0,,Жарайды, мен үйге бара аламын.
Dialogue: 0,0:37:21.98,0:37:23.49,Default,,0,0,0,,Бірақ қазір бұл мүмкін емес.
Dialogue: 0,0:37:23.90,0:37:27.28,Default,,0,0,0,,Әзірше мен саған қамқор боламын.
Dialogue: 0,0:37:27.66,0:37:29.49,Default,,0,0,0,,Отбасының да келісімі алынды.
Dialogue: 0,0:37:29.91,0:37:31.99,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:37:33.96,0:37:35.50,Default,,0,0,0,,Бұл Мейкомон.
Dialogue: 0,0:37:36.25,0:37:37.50,Default,,0,0,0,,Мэй-чан! ?
Dialogue: 0,0:37:40.63,0:37:44.01,Default,,0,0,0,,Суреттегі бұл Мейкомон, солай ма?
Dialogue: 0,0:37:49.05,0:37:53.02,Default,,0,0,0,,Дұрыс. Не істедің?
Dialogue: 0,0:37:55.02,0:37:57.02,Default,,0,0,0,,Толығырақ мен жеткенде айтамын.
Dialogue: 0,0:37:57.77,0:37:59.77,Default,,0,0,0,,Тәуелсіз үкімет қайда барады?
Dialogue: 0,0:38:00.11,0:38:02.90,Default,,0,0,0,,Жоқ, бұл ыңғайлырақ.
Dialogue: 0,0:38:03.03,0:38:06.78,Default,,0,0,0,,Қазір жазғы демалыс, айналада ешкім жоқ, сондықтан БАҚ-та да белгі жоқ.
Dialogue: 0,0:38:13.45,0:38:15.33,Default,,0,0,0,,Мектеп.
Dialogue: 0,0:38:16.37,0:38:17.62,Default,,0,0,0,,Өсімдік өрті -
Dialogue: 0,0:38:17.75,0:38:19.38,Default,,0,0,0,,Қазірдің өзінде 5 сағаттан астам уақыт өтті...
Dialogue: 0,0:38:19.50,0:38:21.29,Default,,0,0,0,,Баяулау белгілері жоқ
Dialogue: 0,0:38:22.71,0:38:26.01,Default,,0,0,0,,Мұны Мэй жасады ма?
Dialogue: 0,0:38:26.84,0:38:30.05,Default,,0,0,0,,Бұл Кувагамонмен бірдей.
Dialogue: 0,0:38:30.85,0:38:32.89,Default,,0,0,0,,Жағдай одан да нашар.
Dialogue: 0,0:38:33.47,0:38:36.02,Default,,0,0,0,,Тіпті бір Мейкомон тудырған жарылыс...
Dialogue: 0,0:38:36.14,0:38:37.56,Default,,0,0,0,,Осыншама шығын келтірілді.
Dialogue: 0,0:38:38.23,0:38:41.81,Default,,0,0,0,,Егер бұл Дигимондардың бәрі жабайы болса...
Dialogue: 0,0:38:45.32,0:38:49.57,Default,,0,0,0,,Жер бұрын-соңды болмаған дағдарысқа тап болды
Dialogue: 0,0:38:49.91,0:38:51.57,Default,,0,0,0,,Біз-
Dialogue: 0,0:38:51.99,0:38:54.91,Default,,0,0,0,,Бұл сіздің тамағыңызға бірдеңе итеріп жатқанын білдіре ме?
Dialogue: 0,0:38:55.20,0:38:57.66,Default,,0,0,0,,Оны тоқтату керек! Олардан құтылайық!
Dialogue: 0,0:38:57.96,0:38:58.83,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:38:58.96,0:39:01.13,Default,,0,0,0,,Не? Тайчи?
Dialogue: 0,0:39:01.96,0:39:04.96,Default,,0,0,0,,Соқыр төбелессек, Одайбамен бірдей боламыз.
Dialogue: 0,0:39:05.34,0:39:08.38,Default,,0,0,0,,Ештеңе істемей, қарап тұра берудің себебі осы ма?
Dialogue: 0,0:39:08.51,0:39:09.97,Default,,0,0,0,,Бұл дүниежүзілік дағдарыс!
Dialogue: 0,0:39:10.05,0:39:12.47,Default,,0,0,0,,Тіпті мен дәл қазір секіргім келеді
Dialogue: 0,0:39:15.31,0:39:18.56,Default,,0,0,0,,Бірақ сіз айтқандай...
Dialogue: 0,0:39:18.68,0:39:22.48,Default,,0,0,0,,Алдағы шайқас бүкіл әлемнің тағдырына әсер етеді.
Dialogue: 0,0:39:23.02,0:39:26.98,Default,,0,0,0,,Сол себепті біз бір нәрсені қайталай алмаймыз
Dialogue: 0,0:39:30.03,0:39:32.45,Default,,0,0,0,,Агумон және басқалар үшін...
Dialogue: 0,0:39:35.24,0:39:37.45,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:39:46.55,0:39:50.26,Default,,0,0,0,,Таку! Мейкомон жігіті мұны сен үшін жасайды.
Dialogue: 0,0:39:50.38,0:39:54.22,Default,,0,0,0,,Джоу мырза! (ұзындығы) Ах! Жоқ, бұл...
Dialogue: 0,0:39:54.35,0:39:55.39,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:39:57.47,0:40:02.14,Default,,0,0,0,,Бірақ соңында Мейкомон қайда кетті?
Dialogue: 0,0:40:02.27,0:40:04.77,Default,,0,0,0,,Ол алынып тасталған болуы мүмкін.
Dialogue: 0,0:40:07.36,0:40:08.19,Default,,0,0,0,,Алып тастау?
Dialogue: 0,0:40:08.61,0:40:11.20,Default,,0,0,0,,Сіз нені айтасыз? мұғалім
Dialogue: 0,0:40:16.08,0:40:19.20,Default,,0,0,0,,Гомеостаз Мейкомонды жояды?
Dialogue: 0,0:40:22.67,0:40:23.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:25.50,0:40:28.21,Default,,0,0,0,,Ешкім қаламайтын болмыс
Dialogue: 0,0:40:29.59,0:40:32.63,Default,,0,0,0,,Тумауы керек болмыс
Dialogue: 0,0:40:33.26,0:40:35.43,Default,,0,0,0,,Сосын мен де...
Dialogue: 0,0:40:37.97,0:40:41.23,Default,,0,0,0,,Ешкім қаламайтын серіктес
Dialogue: 0,0:40:41.31,0:40:43.14,Default,,0,0,0,,Жоқ, Мешин-сан!
Dialogue: 0,0:40:43.27,0:40:46.23,Default,,0,0,0,,Өзіңізді төмендетпеңіз! Бұл сонымен қатар Мейкомон туралы.
Dialogue: 0,0:40:48.15,0:40:49.23,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:40:49.94,0:40:52.82,Default,,0,0,0,,Адамнан талап етілетін нәрсе ме?
Dialogue: 0,0:40:53.20,0:40:54.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:54.86,0:40:58.33,Default,,0,0,0,,Мен тоқтай алмадым
Dialogue: 0,0:40:59.91,0:41:03.83,Default,,0,0,0,,Дәл қазір сені бәрінен де қатты қалайтын адам бар, солай ма?
Dialogue: 0,0:41:07.08,0:41:08.42,Default,,0,0,0,,Бұл Мейкомон.
Dialogue: 0,0:41:08.63,0:41:09.80,Default,,0,0,0,,Ах
Dialogue: 0,0:41:10.59,0:41:11.80,Default,,0,0,0,,Иә
Dialogue: 0,0:41:16.97,0:41:21.68,Default,,0,0,0,,Менің ойымша, біз және біздің серіктестер өзара үмітті.
Dialogue: 0,0:41:22.10,0:41:23.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:41:24.73,0:41:26.40,Default,,0,0,0,,Дұрыс, Меймей!
Dialogue: 0,0:41:26.52,0:41:31.65,Default,,0,0,0,,Сен... Жоқ, біз Мейкомонның үмітіміз!
Dialogue: 0,0:41:32.07,0:41:34.40,Default,,0,0,0,,Үміт міндетті түрде табылар
Dialogue: 0,0:41:34.82,0:41:38.16,Default,,0,0,0,,Үміт... Иә, иә.
Dialogue: 0,0:41:41.91,0:41:44.21,Default,,0,0,0,,Мен біраз қызықпын...
Dialogue: 0,0:41:44.83,0:41:48.88,Default,,0,0,0,,Неліктен Мейкомонды нысанаға алды?
Dialogue: 0,0:41:53.34,0:41:57.43,Default,,0,0,0,,Бұл дигимон Мейкомон пайда болғаннан кейін пайда болды.
Dialogue: 0,0:42:01.31,0:42:02.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:03.14,0:42:05.64,Default,,0,0,0,,Қозғалысты бастау үшін Digimon ауыстырыңыз
Dialogue: 0,0:42:06.02,0:42:07.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:07.69,0:42:11.69,Default,,0,0,0,,Егер бұл Мейкомон болса...
Dialogue: 0,0:42:11.77,0:42:15.28,Default,,0,0,0,,Бұл Мейкомонның неге нысанаға алынғанына жауап па?
Dialogue: 0,0:42:15.40,0:42:17.78,Default,,0,0,0,,Шынайы дүниенің күйреуі
Dialogue: 0,0:42:18.16,0:42:21.33,Default,,0,0,0,,Адамзаттың жойылуын қалайтын болмыс
Dialogue: 0,0:42:21.45,0:42:22.79,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:42:24.58,0:42:25.79,Default,,0,0,0,,Бұл Yggdrasil.
Dialogue: 0,0:42:29.25,0:42:32.50,Default,,0,0,0,,Олар бізді цифрлық әлемнен шығаруға тырысты...
Dialogue: 0,0:42:32.63,0:42:34.55,Default,,0,0,0,,Бұл Йггдрасилдің еркі болуы мүмкін.
Dialogue: 0,0:42:35.09,0:42:37.84,Default,,0,0,0,,Гомеостаз не істейді?
Dialogue: 0,0:42:37.97,0:42:39.05,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:42:39.68,0:42:42.56,Default,,0,0,0,,Сондықтан Мейкомонды жойыңыз...
Dialogue: 0,0:42:46.60,0:42:47.98,Default,,0,0,0,,Тайчи
Dialogue: 0,0:42:47.98,0:42:48.56,Default,,0,0,0,,Тайчи
Dialogue: 0,0:42:47.98,0:42:48.56,Default,,0,0,0,,Ах
Dialogue: 0,0:42:50.44,0:42:51.56,Default,,0,0,0,,Не болды?
Dialogue: 0,0:42:51.65,0:42:53.82,Default,,0,0,0,,Менің қарным ашты~
Dialogue: 0,0:42:54.07,0:42:56.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:57.28,0:42:57.78,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:42:57.78,0:42:59.82,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:42:57.78,0:42:59.82,Default,,0,0,0,,Қай жерде болсаңыз да, солай ма?
Dialogue: 0,0:43:00.07,0:43:02.12,Default,,0,0,0,,Қай жерде болсаңыз да, аштық сезінесіз!
Dialogue: 0,0:43:02.24,0:43:03.58,Default,,0,0,0,,Қарсылық жоқ!
Dialogue: 0,0:43:03.66,0:43:05.83,Default,,0,0,0,,Ахаха (аспан) Кешкі асқа не істеу керек?
Dialogue: 0,0:43:06.75,0:43:08.83,Default,,0,0,0,,Бірдеңе сатып алайық
Dialogue: 0,0:43:12.92,0:43:15.84,Default,,0,0,0,,(қапты ашу дыбысы)
Dialogue: 0,0:43:16.34,0:43:19.05,Default,,0,0,0,,Мына теңіз кірпі майосының дәмін алып, маған да беріңіз!
Dialogue: 0,0:43:19.38,0:43:20.59,Default,,0,0,0,,Сіз әлі тамақтанып жатырсыз ба?
Dialogue: 0,0:43:20.76,0:43:21.59,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:43:24.89,0:43:26.97,Default,,0,0,0,,Ах! Хехе
Dialogue: 0,0:43:27.68,0:43:30.06,Default,,0,0,0,,Хэхехехе~
Dialogue: 0,0:43:38.90,0:43:41.03,Default,,0,0,0,,Тыныш, иә.
Dialogue: 0,0:43:41.16,0:43:45.12,Default,,0,0,0,,Дүниеде сұмдық болып жатыр деген өтірік сияқты.
Dialogue: 0,0:43:46.91,0:43:48.12,Default,,0,0,0,,Жотаро, бұл сенің Стар Платинум.
Dialogue: 0,0:43:48.62,0:43:50.62,Default,,0,0,0,,Иә? қорықты ма?
Dialogue: 0,0:43:50.75,0:43:54.04,Default,,0,0,0,,Ақырында, айналаңызда бірдеңе болмаса...
Dialogue: 0,0:43:54.17,0:43:58.63,Default,,0,0,0,,Қандай жаман нәрсе болса да, біз оны сезіне алмаймыз.
Dialogue: 0,0:44:09.73,0:44:10.48,Default,,0,0,0,,(тоқтың өшіп жатқан дыбысы)
Dialogue: 0,0:44:10.60,0:44:12.31,Default,,0,0,0,,Не?
Dialogue: 0,0:44:12.44,0:44:14.73,Default,,0,0,0,,Барлығы осында жиналғандықтан...
Dialogue: 0,0:44:14.86,0:44:17.86,Default,,0,0,0,,Жазғы түндер мен мектеп туралы айтатын болсақ, бұл солай емес пе?
Dialogue: 0,0:44:17.98,0:44:18.98,Default,,0,0,0,,(қосу дыбысы)
Dialogue: 0,0:44:21.65,0:44:24.24,Default,,0,0,0,,Не? Неден басталады?
Dialogue: 0,0:44:24.53,0:44:25.45,Default,,0,0,0,,Елес оқиға?
Dialogue: 0,0:44:25.57,0:44:28.45,Default,,0,0,0,,Иә! Берілме! Тоқта!
Dialogue: 0,0:44:28.58,0:44:31.16,Default,,0,0,0,,Үлкен аға, сен таң қалдыратындай жамансың, солай емес пе?
Dialogue: 0,0:44:31.29,0:44:33.25,Default,,0,0,0,,Қараңғыдағы елес оқиғалары!
Dialogue: 0,0:44:33.67,0:44:35.67,Default,,0,0,0,,О... мен...
Dialogue: 0,0:44:35.79,0:44:38.50,Default,,0,0,0,,Егер сіз қазір осылай істеп жатсаңыз, мен олай емес деп айтамын.
Dialogue: 0,0:44:38.80,0:44:40.59,Default,,0,0,0,,Күте тұрыңыз…
Dialogue: 0,0:44:40.84,0:44:42.22,Default,,0,0,0,,Сен тыныш не істеп жатырсың?
Dialogue: 0,0:44:42.34,0:44:45.51,Default,,0,0,0,,Мен елестерден немесе басқалардан қорықпаймын.
Dialogue: 0,0:44:45.59,0:44:45.89,Default,,0,0,0,,(Дигимонның сыбырлары)
Dialogue: 0,0:44:45.89,0:44:47.55,Default,,0,0,0,,(Дигимонның сыбырлары)
Dialogue: 0,0:44:45.89,0:44:47.55,Default,,0,0,0,,Жоқ, өзіңізді мәжбүрлемеңіз...
Dialogue: 0,0:44:48.01,0:44:50.02,Default,,0,0,0,,Онда да сыбырлама!
Dialogue: 0,0:44:53.14,0:44:59.32,Default,,0,0,0,,Мен сыныпта жалғыз болдым, басқа ешкім болмады.
Dialogue: 0,0:44:59.61,0:45:03.20,Default,,0,0,0,,Мен естіген сынақтың нәтижелері...
Dialogue: 0,0:45:04.11,0:45:07.03,Default,,0,0,0,,Мұның салдары қорқынышты!
Dialogue: 0,0:45:07.37,0:45:09.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:10.66,0:45:13.08,Default,,0,0,0,,О, қазірдің өзінде! Ақыр соңында ол бар ма?
Dialogue: 0,0:45:13.21,0:45:14.54,Default,,0,0,0,,Егер сіз оны тастасаңыз не істейсіз?
Dialogue: 0,0:45:14.67,0:45:16.00,Default,,0,0,0,,Біздің таңдауымыз жоқ.
Dialogue: 0,0:45:16.13,0:45:17.67,Default,,0,0,0,,Мен сенен бір қорқынышты оқиғаны айтып беруіңді сұраймын.
Dialogue: 0,0:45:17.79,0:45:20.05,Default,,0,0,0,,Мен өз басымнан өткен оқиға.
Dialogue: 0,0:45:20.17,0:45:21.00,Default,,0,0,0,,Сіз істедіңіз деп ойлаймын!
Dialogue: 0,0:45:21.13,0:45:24.22,Default,,0,0,0,,Бұл Джо-сенпайдың жеке қорқынышы.
Dialogue: 0,0:45:24.34,0:45:25.18,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:45:25.30,0:45:27.05,Default,,0,0,0,,Бұл шынайырақ емес пе?
Dialogue: 0,0:45:27.39,0:45:28.97,Default,,0,0,0,,Бұл мүлдем қорқынышты емес.
Dialogue: 0,0:45:29.10,0:45:31.06,Default,,0,0,0,,Күлкі болса да, жарамайды.
Dialogue: 0,0:45:31.39,0:45:33.73,Default,,0,0,0,,Мұндағы ұпай да төмен.
Dialogue: 0,0:45:33.85,0:45:36.06,Default,,0,0,0,,Олай болса мен келесімін деп ойлаймын.
Dialogue: 0,0:45:37.23,0:45:40.07,Default,,0,0,0,,Бұл менің досым туралы әңгіме...
Dialogue: 0,0:45:40.15,0:45:44.40,Default,,0,0,0,,Аа, мен оны басынан бастап жасап қойған сияқтымын.
Dialogue: 0,0:45:44.53,0:45:46.57,Default,,0,0,0,,«Мен сені қорқытамын~» сияқты нәрсе
Dialogue: 0,0:45:46.82,0:45:49.32,Default,,0,0,0,,Ех! Мешин ше?
Dialogue: 0,0:45:49.45,0:45:50.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:50.49,0:45:52.83,Default,,0,0,0,,Сіз қандай қорқынышты оқиғаларды білесіз?
Dialogue: 0,0:45:52.91,0:45:54.83,Default,,0,0,0,,А, мен сұрадым!
Dialogue: 0,0:45:55.79,0:45:57.00,Default,,0,0,0,,Эххе
Dialogue: 0,0:45:58.04,0:46:01.34,Default,,0,0,0,,Ах... Уһ.
Dialogue: 0,0:46:03.26,0:46:05.34,Default,,0,0,0,,Тотториде елес туралы әңгімелер бар ма?
Dialogue: 0,0:46:06.01,0:46:07.38,Default,,0,0,0,,Мен... Мен шынымен...
Dialogue: 0,0:46:07.51,0:46:09.30,Default,,0,0,0,,Мен бұл туралы білмеймін ...
Dialogue: 0,0:46:09.43,0:46:12.14,Default,,0,0,0,,Мешин туралы бірдеңе айт.
Dialogue: 0,0:46:12.26,0:46:14.56,Default,,0,0,0,,Мен туралы айтып тұрсың ба?
Dialogue: 0,0:46:14.68,0:46:17.35,Default,,0,0,0,,Мен онша жақсы емеспін.
Dialogue: 0,0:46:17.44,0:46:19.52,Default,,0,0,0,,Сізге жақсы болу міндетті емес. Бұл дұрыс!
Dialogue: 0,0:46:19.61,0:46:20.44,Default,,0,0,0,,Иә
Dialogue: 0,0:46:22.98,0:46:26.45,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:46:27.45,0:46:30.24,Default,,0,0,0,,Бұл мен бастауыш мектепте оқып жүрген кезімде болды.
Dialogue: 0,0:46:30.37,0:46:32.45,Default,,0,0,0,,О, бұл шынайы.
Dialogue: 0,0:46:33.24,0:46:37.83,Default,,0,0,0,,Бірақ бұл жолда әдетте көше шамдары бар.
Dialogue: 0,0:46:37.96,0:46:41.71,Default,,0,0,0,,Бірақ ол сол күні ғана жоғалып кетті...
Dialogue: 0,0:46:42.54,0:46:45.42,Default,,0,0,0,,Өйткені бұл мен әрқашан жүретін жол...
Dialogue: 0,0:46:45.55,0:46:48.47,Default,,0,0,0,,Мен ерекше ештеңені ойламай жүрдім.
Dialogue: 0,0:46:48.80,0:46:53.64,Default,,0,0,0,,Сол кезде арт жақтан велосипед қоңырауының шырылдағанын естідім.
Dialogue: 0,0:46:53.76,0:46:58.77,Default,,0,0,0,,Сонымен, біреу велосипед мініп, менің жанымнан өтті.
Dialogue: 0,0:46:59.77,0:47:02.77,Default,,0,0,0,,Бірақ ол тек дыбыстар шығарады
Dialogue: 0,0:47:03.61,0:47:04.48,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:47:06.94,0:47:10.11,Default,,0,0,0,,Хмм...күте тұрыңыз, бұл оқиға әлі жалғасып жатыр ма?
Dialogue: 0,0:47:10.24,0:47:13.49,Default,,0,0,0,,Иә, бұл біртүрлі болады...
Dialogue: 0,0:47:15.87,0:47:20.96,Default,,0,0,0,,Мен алдыма қарап тұрдым, ал бұл жолы артыма...
Dialogue: 0,0:47:21.08,0:47:24.50,Default,,0,0,0,,Велосипед қоңырауы тағы соғылды...
Dialogue: 0,0:47:25.50,0:47:29.05,Default,,0,0,0,,Артымнан велосипед тоқтады.\NМен
Dialogue: 0,0:47:29.17,0:47:31.51,Default,,0,0,0,,
Dialogue: 0,0:47:32.09,0:47:34.76,Default,,0,0,0,,бұрылғанда...
Dialogue: 0,0:47:36.89,0:47:38.02,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:47:38.10,0:47:44.52,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:47:46.11,0:47:47.11,Default,,0,0,0,,(тоқтың қосылу дыбысы)
Dialogue: 0,0:47:47.69,0:47:51.15,Default,,0,0,0,,Не болды? Шамдарды өшіріңіз
Dialogue: 0,0:47:54.49,0:47:55.62,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:47:55.74,0:47:59.33,Default,,0,0,0,,Жоқ, мен сені жақында қонақүйге жіберейін деп жатырмын.
Dialogue: 0,0:47:59.45,0:48:02.33,Default,,0,0,0,,Қонақ үй? (Аспан) Үйге бара алмайсың ба?
Dialogue: 0,0:48:02.96,0:48:05.54,Default,,0,0,0,,Бұқаралық ақпарат құралдары әлі де оған жабысып тұрған сияқты.
Dialogue: 0,0:48:05.67,0:48:07.59,Default,,0,0,0,,Бүгін кешке мен сізге қонақүй дайындадым.
Dialogue: 0,0:48:07.88,0:48:10.05,Default,,0,0,0,,Бұл дұрыс па? Мектепте?
Dialogue: 0,0:48:10.17,0:48:12.80,Default,,0,0,0,,Ал, мен душ қабылдадым!
Dialogue: 0,0:48:12.93,0:48:14.89,Default,,0,0,0,,Клуб бөлмесінде душты пайдалануға болады.
Dialogue: 0,0:48:15.01,0:48:17.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:48:17.22,0:48:20.39,Default,,0,0,0,,Жарайды! Елестер туралы әңгімелер де танымал болды.
Dialogue: 0,0:48:20.52,0:48:21.89,Default,,0,0,0,,Көңілсіз!
Dialogue: 0,0:48:22.89,0:48:24.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:24.69,0:48:27.94,Default,,0,0,0,,Бауырым, қорықсаң қонақ үйге бар.
Dialogue: 0,0:48:28.07,0:48:29.99,Default,,0,0,0,,Уф, сен ақымақ нәрсе айтып тұрсың.
Dialogue: 0,0:48:30.11,0:48:30.90,Default,,0,0,0,,(Аспанның сыбырлары)
Dialogue: 0,0:48:30.90,0:48:33.53,Default,,0,0,0,,(Аспанның сыбырлары)
Dialogue: 0,0:48:30.90,0:48:33.53,Default,,0,0,0,,А, бар! Сыбырламаңыз!
Dialogue: 0,0:48:33.66,0:48:35.16,Default,,0,0,0,,Мұғалім, жақсы ма?
Dialogue: 0,0:48:35.53,0:48:37.41,Default,,0,0,0,,Не? Хмм
Dialogue: 0,0:48:37.53,0:48:40.16,Default,,0,0,0,,Эй, эй, мен әлі келіскен жоқпын.
Dialogue: 0,0:48:40.45,0:48:42.66,Default,,0,0,0,,Сонымен, сіз қонақүйге жалғыз барасыз ба?
Dialogue: 0,0:48:42.75,0:48:44.42,Default,,0,0,0,,Мм... Мен осында қаламын.
Dialogue: 0,0:48:44.54,0:48:47.17,Default,,0,0,0,,Үйге телефон соғудан басқа амалым жоқ.
Dialogue: 0,0:48:47.42,0:48:49.88,Default,,0,0,0,,Ойланып қарасам, мен саған хабарласпадым.
Dialogue: 0,0:48:50.01,0:48:53.30,Default,,0,0,0,,Мен абайсызда болдым. Мен уайымдап тұрмын.
Dialogue: 0,0:48:54.47,0:48:56.68,Default,,0,0,0,,Сізді қорқытқаным үшін кешіріңіз.
Dialogue: 0,0:49:33.55,0:49:36.05,Default,,0,0,0,,Иә... Иә...
Dialogue: 0,0:49:36.18,0:49:38.05,Default,,0,0,0,,Мен сенің ағаңды ауыстырамын.
Dialogue: 0,0:49:38.47,0:49:39.47,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:49:39.60,0:49:41.47,Default,,0,0,0,,Агу-чан мен басқалары жақсы ма?
Dialogue: 0,0:49:41.60,0:49:43.68,Default,,0,0,0,,Ұлыңызды уайымдау емес пе?
Dialogue: 0,0:49:43.81,0:49:45.27,Default,,0,0,0,,Сенде бәрі жақсы, солай ма?
Dialogue: 0,0:49:45.27,0:49:45.85,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:49:45.27,0:49:45.85,Default,,0,0,0,,Хехе
Dialogue: 0,0:49:46.14,0:49:48.27,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:49:48.40,0:49:51.86,Default,,0,0,0,,Хикари, Агу-чан және Тайл-чанға қамқорлық жасаңыз.
Dialogue: 0,0:49:52.07,0:49:54.74,Default,,0,0,0,,Аа... сонда
Dialogue: 0,0:49:54.86,0:49:56.32,Default,,0,0,0,,Тайчи
Dialogue: 0,0:49:56.41,0:49:57.86,Default,,0,0,0,,Көп уақыт өтті емес пе?
Dialogue: 0,0:49:57.99,0:49:58.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:59.24,0:50:01.83,Default,,0,0,0,,Неліктен жазғы демалысыңыз сонша қызық?
Dialogue: 0,0:50:02.66,0:50:04.71,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:50:06.87,0:50:08.38,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:50:14.21,0:50:15.34,Default,,0,0,0,,Фуфу
Dialogue: 0,0:50:15.51,0:50:17.76,Default,,0,0,0,,«Тірі»...
Dialogue: 0,0:50:18.34,0:50:19.34,Default,,0,0,0,,Біраз өсіп алғанша күтсеңші.
Dialogue: 0,0:50:19.47,0:50:21.35,Default,,0,0,0,,Таза ауа жұтып алайық
Dialogue: 0,0:50:24.31,0:50:25.18,Default,,0,0,0,,Иә...
Dialogue: 0,0:50:25.31,0:50:28.10,Default,,0,0,0,,Менен "жақсысың ба" деп көп сұрама?
Dialogue: 0,0:50:28.23,0:50:30.11,Default,,0,0,0,,Өйткені барлығы сонда болады
Dialogue: 0,0:50:30.52,0:50:34.07,Default,,0,0,0,,Мей-чан үшін кешірім сұраймын.
Dialogue: 0,0:50:35.19,0:50:39.95,Default,,0,0,0,,«Менің ойларым»... Мен білмеймін.
Dialogue: 0,0:50:40.07,0:50:42.58,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:50:43.66,0:50:45.25,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:50:50.54,0:50:52.13,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:50:53.30,0:50:56.47,Default,,0,0,0,,Мэй-чан, не істегенімді қалайсың?
Dialogue: 0,0:50:57.38,0:51:00.18,Default,,0,0,0,,Мен мұны естідім
Dialogue: 0,0:51:01.51,0:51:03.89,Default,,0,0,0,,«Мен туылмауым керек еді»...
Dialogue: 0,0:51:04.14,0:51:05.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:05.97,0:51:07.68,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:51:08.77,0:51:12.40,Default,,0,0,0,,Тек, ол бәріне қиындық туғыза ма?
Dialogue: 0,0:51:12.73,0:51:14.52,Default,,0,0,0,,Жабайы боласың ба?
Dialogue: 0,0:51:15.28,0:51:18.40,Default,,0,0,0,,Мен Мэй Чанды жақсы көремін.
Dialogue: 0,0:51:19.74,0:51:21.41,Default,,0,0,0,,Бар болғаны...
Dialogue: 0,0:51:21.74,0:51:25.79,Default,,0,0,0,,Бұл жай ғана көңілді болуы мүмкін емес пе?
Dialogue: 0,0:51:26.45,0:51:31.00,Default,,0,0,0,,Мэй Чан екеуміз не қалаймыз?
Dialogue: 0,0:51:31.92,0:51:34.42,Default,,0,0,0,,Мен Мэй Чанның қалауы болсам...
Dialogue: 0,0:51:34.92,0:51:37.34,Default,,0,0,0,,Неліктен бұл керемет?
Dialogue: 0,0:51:38.38,0:51:41.51,Default,,0,0,0,,Ешкім білмейді...
Dialogue: 0,0:51:41.89,0:51:44.72,Default,,0,0,0,,Ах Тайчи-сан
Dialogue: 0,0:51:44.85,0:51:48.73,Default,,0,0,0,,А... Тыңдап тыңдайын дегенім жоқ еді.
Dialogue: 0,0:51:50.81,0:51:55.07,Default,,0,0,0,,Қазіргі Тоттори диалектісі? Бұл жаңа піскен сияқты.
Dialogue: 0,0:51:58.78,0:51:59.61,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:51:59.74,0:52:01.24,Default,,0,0,0,,Өзіңізге қамқорлық жасамаңыз
Dialogue: 0,0:52:01.36,0:52:02.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:02.57,0:52:06.49,Default,,0,0,0,,А, мен: «Тайчи-сан жақсы адам» дедім.
Dialogue: 0,0:52:06.62,0:52:09.08,Default,,0,0,0,,Ах... Балалар.
Dialogue: 0,0:52:09.58,0:52:10.96,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:52:12.79,0:52:15.21,Default,,0,0,0,,Екеуің не туралы айтып тұрсыңдар?
Dialogue: 0,0:52:15.46,0:52:17.38,Default,,0,0,0,,Хикариге хабарлауым керек пе?
Dialogue: 0,0:52:17.50,0:52:19.76,Default,,0,0,0,,Аспанға айтайын ба?
Dialogue: 0,0:52:19.88,0:52:21.93,Default,,0,0,0,,Яматого айту керек, солай ма?
Dialogue: 0,0:52:22.05,0:52:24.64,Default,,0,0,0,,Неліктен бұл туралы барлығы хабарлай алмайды?
Dialogue: 0,0:52:24.76,0:52:26.22,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:52:26.30,0:52:29.72,Default,,0,0,0,,(Агумонның толқыған дауысы)
Dialogue: 0,0:52:31.39,0:52:32.73,Default,,0,0,0,,Міне.
Dialogue: 0,0:52:34.40,0:52:35.73,Default,,0,0,0,,Сіз мұны жиі айтасыз, солай ма?
Dialogue: 0,0:52:38.65,0:52:41.11,Default,,0,0,0,,Бала кезімде мен...
Dialogue: 0,0:52:41.24,0:52:44.74,Default,,0,0,0,,Өскенде көре алмайтын нәрселер бар...
Dialogue: 0,0:52:46.78,0:52:48.58,Default,,0,0,0,,Екінші жағынан, есейгенде...
Dialogue: 0,0:52:48.70,0:52:50.54,Default,,0,0,0,,Бала кезімде көре алмағаныма қуанғаным...
Dialogue: 0,0:52:50.66,0:52:52.41,Default,,0,0,0,,Сіз оны көресіз
Dialogue: 0,0:52:53.04,0:52:56.17,Default,,0,0,0,,Бірақ нені қарау керек?
Dialogue: 0,0:52:56.29,0:52:58.59,Default,,0,0,0,,Мен оны көруім керек пе?
Dialogue: 0,0:52:59.09,0:53:01.51,Default,,0,0,0,,Балалар мен ересектер нені көре алады
Dialogue: 0,0:53:01.63,0:53:03.84,Default,,0,0,0,,Шынымен де соншалықты айырмашылық бар ма?
Dialogue: 0,0:53:06.72,0:53:10.27,Default,,0,0,0,,Мен Агумонмен біраз уақыттан кейін бірінші рет кездескенімде...
Dialogue: 0,0:53:10.39,0:53:11.60,Default,,0,0,0,,«Ой, мына жігіт ше?»
Dialogue: 0,0:53:11.73,0:53:14.81,Default,,0,0,0,,«Менің ойымша, біз әрқашан байланыстымыз».
Dialogue: 0,0:53:15.31,0:53:17.44,Default,,0,0,0,,Менің ойымша, бұл шыншыл.
Dialogue: 0,0:53:17.56,0:53:19.40,Default,,0,0,0,,Олар серіктес болғандықтан?
Dialogue: 0,0:53:24.40,0:53:26.28,Default,,0,0,0,,«Мен туылмауым керек еді»
Dialogue: 0,0:53:26.41,0:53:28.49,Default,,0,0,0,,Олай десеңіз, Мейкомон...
Dialogue: 0,0:53:28.58,0:53:31.24,Default,,0,0,0,,Менің ойымша, сіз маған осылай дедіңіз.
Dialogue: 0,0:53:32.37,0:53:35.96,Default,,0,0,0,,Мен болмасам, сен мені жар етіп таңдамас едің.
Dialogue: 0,0:53:36.58,0:53:37.96,Default,,0,0,0,,Мей Чан ондай болмаса...
Dialogue: 0,0:53:38.08,0:53:39.00,Default,,0,0,0,,Мочизуки!
Dialogue: 0,0:53:39.21,0:53:40.42,Default,,0,0,0,,Ах
Dialogue: 0,0:53:42.42,0:53:43.76,Default,,0,0,0,,Нашар
Dialogue: 0,0:53:51.47,0:53:55.98,Default,,0,0,0,,Бірақ бұл басқаша, солай емес пе? Мұндай нәрсе
Dialogue: 0,0:54:01.61,0:54:03.44,Default,,0,0,0,,Мен ашуландым
Dialogue: 0,0:54:06.91,0:54:08.91,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:54:11.37,0:54:12.54,Default,,0,0,0,,Агумон!
Dialogue: 0,0:54:13.04,0:54:15.04,Default,,0,0,0,,Агумонды неге жібердің?
Dialogue: 0,0:54:15.41,0:54:18.04,Default,,0,0,0,,Сіздің серіктесіңіз Тайчиге еруі керек.
Dialogue: 0,0:54:18.17,0:54:20.54,Default,,0,0,0,,Жақсысың ба? Агумонда
Dialogue: 0,0:54:20.67,0:54:22.05,Default,,0,0,0,,Мен қатты уайымдаймын.
Dialogue: 0,0:54:22.59,0:54:24.51,Default,,0,0,0,,Мешін (Мешін) иә?
Dialogue: 0,0:54:25.05,0:54:27.05,Default,,0,0,0,,Сіздің қарныңыз ашты ма? (Мешин) А?
Dialogue: 0,0:54:27.22,0:54:28.30,Default,,0,0,0,,Даа~!
Dialogue: 0,0:54:28.43,0:54:29.55,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:54:29.89,0:54:32.72,Default,,0,0,0,,Жоқ, менің ішім тоқ.
Dialogue: 0,0:54:33.64,0:54:35.56,Default,,0,0,0,,Жай... Жай ғана?
Dialogue: 0,0:54:36.23,0:54:37.81,Default,,0,0,0,,Міне... мүмкін бе?
Dialogue: 0,0:54:38.10,0:54:39.56,Default,,0,0,0,,Сіздің кеудеңіз кішірейді ме?
Dialogue: 0,0:54:39.85,0:54:41.52,Default,,0,0,0,,Ол не деді?
Dialogue: 0,0:54:41.65,0:54:43.57,Default,,0,0,0,,Жаңа айтқаныңыз проблемалық.
Dialogue: 0,0:54:43.78,0:54:47.82,Default,,0,0,0,,Ухухуху, қызық екен, Агумон.
Dialogue: 0,0:54:48.15,0:54:49.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:49.28,0:54:51.99,Default,,0,0,0,,Мен Тайчи-санды қызғанамын.
Dialogue: 0,0:54:52.12,0:54:53.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:54.16,0:54:56.41,Default,,0,0,0,,Тайчи жалғыз емес
Dialogue: 0,0:54:56.54,0:55:01.21,Default,,0,0,0,,Сора-сан, Хикари-сан, Мими-сан, барлығы
Dialogue: 0,0:55:01.58,0:55:02.63,Default,,0,0,0,,Мешин?
Dialogue: 0,0:55:02.75,0:55:04.71,Default,,0,0,0,,Аа, бұрын болғаны үшін кешіріңіз.
Dialogue: 0,0:55:04.84,0:55:07.26,Default,,0,0,0,,Мен барлығын қорқыттым.
Dialogue: 0,0:55:08.01,0:55:10.59,Default,,0,0,0,,Мен мүлде қорықпадым
Dialogue: 0,0:55:24.73,0:55:26.86,Default,,0,0,0,,Білесің бе, Мешин?
Dialogue: 0,0:55:27.15,0:55:30.86,Default,,0,0,0,,Мен Мэй Чанды жақсы көремін.
Dialogue: 0,0:55:32.45,0:55:34.58,Default,,0,0,0,,Бұл Мешинге қатысты емес пе?
Dialogue: 0,0:55:36.49,0:55:37.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:38.00,0:55:39.29,Default,,0,0,0,,Хехе
Dialogue: 0,0:55:42.17,0:55:46.13,Default,,0,0,0,,Мэй Чанның да Мейшинді жақсы көретініне сенімдімін.
Dialogue: 0,0:55:47.42,0:55:49.51,Default,,0,0,0,,Жарайды ма? Бұл жақсы ма?
Dialogue: 0,0:55:49.63,0:55:52.47,Default,,0,0,0,,Тайчиге есеп беру керек пе? Неліктен?
Dialogue: 0,0:55:52.59,0:55:54.64,Default,,0,0,0,,Сораға есеп беруім керек пе?
Dialogue: 0,0:55:54.76,0:55:55.72,Default,,0,0,0,,Ямато ше?
Dialogue: 0,0:55:55.85,0:55:57.43,Default,,0,0,0,,Ұзындығы жақсы, солай ма?
Dialogue: 0,0:55:57.56,0:55:59.64,Default,,0,0,0,,Хикариге айтуым керек пе?
Dialogue: 0,0:55:59.77,0:56:01.69,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:56:06.94,0:56:08.32,Default,,0,0,0,,Хаа…
Dialogue: 0,0:56:08.90,0:56:10.45,Default,,0,0,0,,Тайчи (Тайчи) Ах.
Dialogue: 0,0:56:14.62,0:56:15.91,Default,,0,0,0,,Не болды?
Dialogue: 0,0:56:16.03,0:56:17.62,Default,,0,0,0,,Кім? (Тайчи) Қыз
Dialogue: 0,0:56:17.74,0:56:19.37,Default,,0,0,0,,Мен қарап тұрдым (Тайчи) Шынайысың ба?
Dialogue: 0,0:56:19.50,0:56:21.25,Default,,0,0,0,,Барлығы «Мен есеп беруім керек» дейді
Dialogue: 0,0:56:21.37,0:56:23.58,Default,,0,0,0,,Кімге? мінеки біз?
Dialogue: 0,0:56:23.71,0:56:25.42,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:56:25.79,0:56:28.13,Default,,0,0,0,,Не болды?
Dialogue: 0,0:56:28.25,0:56:29.46,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:56:29.59,0:56:32.76,Default,,0,0,0,,Сіз аштыңыз ба? (Тайчи) Хаха жоқ.
Dialogue: 0,0:56:33.97,0:56:38.72,Default,,0,0,0,,Хаа... Хикари осылай деді.
Dialogue: 0,0:56:39.14,0:56:42.73,Default,,0,0,0,,Айналаңызда болмаса, сіз оны сезе алмайсыз.
Dialogue: 0,0:56:44.27,0:56:47.32,Default,,0,0,0,,Сезімдерін бірге алып жүру...
Dialogue: 0,0:56:47.44,0:56:49.28,Default,,0,0,0,,Мүмкін мұны істеу мүмкін емес пе?
Dialogue: 0,0:56:50.40,0:56:51.90,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:56:52.03,0:56:56.07,Default,,0,0,0,,Мен оңай уайымдаймын, бірақ ештеңе істей алмаймын...
Dialogue: 0,0:56:56.87,0:57:01.00,Default,,0,0,0,,Бала кезімдегідей қалсам ғой...
Dialogue: 0,0:57:01.33,0:57:05.08,Default,,0,0,0,,Егер ол бұрынғыша үлкейсе, көбірек...
Dialogue: 0,0:57:05.96,0:57:07.00,Default,,0,0,0,,Сіз білесіз...
Dialogue: 0,0:57:07.13,0:57:11.30,Default,,0,0,0,,Қарным ашқанда міндетті түрде бірдеңе жеймін.
Dialogue: 0,0:57:13.22,0:57:17.76,Default,,0,0,0,,Тайчи Тайчи қалағанын істеуі керек.
Dialogue: 0,0:57:20.64,0:57:21.72,Default,,0,0,0,,Иә
Dialogue: 0,0:57:35.95,0:57:38.28,Default,,0,0,0,,Дагаан!
Dialogue: 0,0:57:38.70,0:57:39.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:40.24,0:57:42.00,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:57:42.25,0:57:43.37,Default,,0,0,0,,Мейкомон!
Dialogue: 0,0:57:45.21,0:57:47.88,Default,,0,0,0,,Дагаан!
Dialogue: 0,0:57:48.04,0:57:50.88,Default,,0,0,0,,Келіңіздер! Макемомон! (Мешин) Мэй-чан!
Dialogue: 0,0:57:51.38,0:57:53.47,Default,,0,0,0,,Дагаан!
Dialogue: 0,0:57:54.55,0:57:57.39,Default,,0,0,0,,Мей Чанның бұлай болғанына мен кінәлімін, солай ма?
Dialogue: 0,0:57:57.84,0:57:59.55,Default,,0,0,0,,Мені қорғауға тырысуда...
Dialogue: 0,0:57:59.64,0:58:01.76,Default,,0,0,0,,Дагаан!
Dialogue: 0,0:58:01.93,0:58:03.81,Default,,0,0,0,,Онда мені айыпта!
Dialogue: 0,0:58:05.85,0:58:09.31,Default,,0,0,0,,Серіктестік күші жетпегені үшін мені кінәлаңыз!
Dialogue: 0,0:58:09.65,0:58:12.28,Default,,0,0,0,,Мен бәрін аламын!
Dialogue: 0,0:58:13.07,0:58:14.61,Default,,0,0,0,,Мешин-сан
Dialogue: 0,0:58:15.86,0:58:21.33,Default,,0,0,0,,Әлде мен енді серіктес емеспін бе?
Dialogue: 0,0:58:21.41,0:58:22.74,Default,,0,0,0,,(Макеракмонның ырылдауы)
Dialogue: 0,0:58:22.87,0:58:24.16,Default,,0,0,0,,Уф!
Dialogue: 0,0:58:26.46,0:58:30.00,Default,,0,0,0,,Сен Мэй Чан қалағандай бола алмайсың ба?
Dialogue: 0,0:58:31.84,0:58:37.47,Default,,0,0,0,,Зауыт жарылған кезде айнала айналып тұрған сол нәрсе...
Dialogue: 0,0:58:37.55,0:58:39.05,Default,,0,0,0,,Агумон! Түсіндім!
Dialogue: 0,0:58:39.18,0:58:40.30,Default,,0,0,0,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:58:40.97,0:58:43.47,Default,,0,0,0,,Осы күйде Мейкомонға жақындаңыз...
Dialogue: 0,0:58:43.60,0:58:46.31,Default,,0,0,0,,Барлығы қайтадан жұқтырған жағдайда...
Dialogue: 0,0:58:46.43,0:58:48.48,Default,,0,0,0,,Міне! (Аспан) А...
Dialogue: 0,0:58:49.73,0:58:51.73,Default,,0,0,0,,Менің кетуім керек, о
Dialogue: 0,0:58:51.86,0:58:53.23,Default,,0,0,0,,Габумон...
Dialogue: 0,0:58:54.44,0:58:55.86,Default,,0,0,0,,Тайчи!
Dialogue: 0,0:59:18.30,0:59:21.43,Default,,0,0,0,,Агумон эволюциясы! Габумон эволюциясы!
Dialogue: 0,0:59:40.07,0:59:41.53,Default,,0,0,0,,Греймон Бирдрамон
Dialogue: 0,0:59:40.07,0:59:41.53,Default,,0,0,0,,Кабутеримон
Dialogue: 0,0:59:41.66,0:59:42.74,Default,,0,0,0,,Ангемон Тогемон
Dialogue: 0,0:59:42.87,0:59:44.66,Default,,0,0,0,,Гарурумон Иккакумон
Dialogue: 0,0:59:53.50,0:59:57.46,Default,,0,0,0,,Греймонның супер эволюциясы! Гарурумон супер эволюциясы!
Dialogue: 0,1:00:06.10,1:00:11.56,Default,,0,0,0,,MetalGreymon Weregarurumon
Dialogue: 0,1:00:18.40,1:00:21.24,Default,,0,0,0,,Өтінемін, Металл Греймон! барлығы!
Dialogue: 0,1:00:24.41,1:00:26.62,Default,,0,0,0,,Дагаан!
Dialogue: 0,1:00:26.99,1:00:28.08,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:28.54,1:00:32.54,Default,,0,0,0,,(қорқытып айқай)
Dialogue: 0,1:00:38.92,1:00:40.42,Default,,0,0,0,,мамыр…
Dialogue: 0,1:00:44.18,1:00:44.84,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:46.43,1:00:47.85,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:48.22,1:00:49.35,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:52.19,1:00:56.36,Default,,0,0,0,,Мэй-чан... жылап тұр
Dialogue: 0,1:00:56.73,1:00:58.36,Default,,0,0,0,,Е? Иә.
Dialogue: 0,1:00:59.03,1:01:00.78,Default,,0,0,0,,Мен қорқамын
Dialogue: 0,1:01:03.95,1:01:06.28,Default,,0,0,0,,Зудомон!
Dialogue: 0,1:01:08.58,1:01:13.25,Default,,0,0,0,,Мейкомонның айналасындағы бұрмалану барған сайын үлкейіп барады.
Dialogue: 0,1:01:13.75,1:01:18.42,Default,,0,0,0,,Қорқыныш Мейкомонның күшін күшейте ме?
Dialogue: 0,1:01:20.17,1:01:23.26,Default,,0,0,0,,Дугган!
Dialogue: 0,1:01:25.51,1:01:26.68,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:26.80,1:01:29.31,Default,,0,0,0,,Неге... неге!
Dialogue: 0,1:01:29.43,1:01:32.35,Default,,0,0,0,,Мен Мейкомонға көмектескім келді, бірақ бұл болды!
Dialogue: 0,1:01:32.73,1:01:33.85,Default,,0,0,0,,Анықтама…
Dialogue: 0,1:01:45.41,1:01:47.03,Default,,0,0,0,,Кираның қабілеті бір адамда ғана емес, бірнеше адамда болуы мүмкін.
Dialogue: 0,1:01:58.67,1:01:59.50,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,1:01:59.63,1:02:02.92,Default,,0,0,0,,Бұл гомеостаз жіберген дигимон!
Dialogue: 0,1:02:03.05,1:02:04.88,Default,,0,0,0,,Гомеостаз…
Dialogue: 0,1:02:08.22,1:02:09.39,Default,,0,0,0,,Джесмон
Dialogue: 0,1:02:12.31,1:02:13.60,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:02:13.98,1:02:17.69,Default,,0,0,0,,Дугган!
Dialogue: 0,1:02:18.40,1:02:22.48,Default,,0,0,0,,Хяхахахаха мен жасадым!
Dialogue: 0,1:02:22.61,1:02:26.49,Default,,0,0,0,,Мен оны тоқтатсам деп едім Рахмет гомеостаз
Dialogue: 0,1:02:26.82,1:02:28.99,Default,,0,0,0,,Хахаха қызық
Dialogue: 0,1:02:29.20,1:02:30.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:36.41,1:02:38.12,Default,,0,0,0,,Не? Сол күші
Dialogue: 0,1:02:38.25,1:02:41.25,Default,,0,0,0,,Бар болғаны жойылуға себеп болады...
Dialogue: 0,1:02:53.77,1:02:54.85,Default,,0,0,0,,Мэй-чан!
Dialogue: 0,1:02:55.02,1:02:56.43,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:02:56.56,1:02:59.48,Default,,0,0,0,,Сіз бізге Мейкомон туралы бірдеңе істеу керектігін айттыңыз, солай ма?
Dialogue: 0,1:02:59.65,1:03:01.23,Default,,0,0,0,,Гомеостаз!
Dialogue: 0,1:03:01.52,1:03:03.57,Default,,0,0,0,,Егер біз мұны істей алмайтынымызды білсек...
Dialogue: 0,1:03:03.69,1:03:06.90,Default,,0,0,0,,Сіз оны қиып алып, өзіңіз шешесіз бе?
Dialogue: 0,1:03:07.03,1:03:10.53,Default,,0,0,0,,Біз сандық әлемнен дерлік жойылдық...
Dialogue: 0,1:03:10.66,1:03:13.37,Default,,0,0,0,,Мен бұл Йггдрасилдің еркі деп ойладым, бірақ...
Dialogue: 0,1:03:13.49,1:03:16.25,Default,,0,0,0,,Шындығында, бұл гомеостаздың мақсаты...
Dialogue: 0,1:03:17.83,1:03:21.25,Default,,0,0,0,,Біздің жауымыз кім?
Dialogue: 0,1:03:26.76,1:03:31.51,Default,,0,0,0,,Біз немен күресіп жатырмыз?
Dialogue: 0,1:03:56.41,1:03:57.79,Default,,0,0,0,,Уф! Жүгіріп кету!
Dialogue: 0,1:04:03.63,1:04:05.55,Default,,0,0,0,,Мейшин-сан! (Мешин) Ах!
Dialogue: 0,1:04:14.68,1:04:16.76,Default,,0,0,0,,Енді Мейкомон...
Dialogue: 0,1:04:16.89,1:04:19.10,Default,,0,0,0,,Меймейді қорғадың ба?
Dialogue: 0,1:04:19.48,1:04:21.60,Default,,0,0,0,,Сіз жаңа ғана Джесмонға шабуыл жасадыңыз, солай ма?
Dialogue: 0,1:04:21.85,1:04:24.27,Default,,0,0,0,,Жоқ, мен оны қорғадым.
Dialogue: 0,1:04:24.40,1:04:26.11,Default,,0,0,0,,Иә! Мен сенімдімін!
Dialogue: 0,1:04:30.11,1:04:33.49,Default,,0,0,0,,Егер Мейкомон Мочизуки-санды қорғаған болса...
Dialogue: 0,1:04:33.61,1:04:34.70,Default,,0,0,0,,Маған көмек керек
Dialogue: 0,1:04:35.03,1:04:36.78,Default,,0,0,0,,Тайчи! Бұл Омегамон!
Dialogue: 0,1:04:36.91,1:04:37.91,Default,,0,0,0,,Мен білемін!
Dialogue: 0,1:04:38.04,1:04:39.20,Default,,0,0,0,,Металл Греймон
Dialogue: 0,1:04:39.29,1:04:42.62,Default,,0,0,0,,Мейкомонды әйтеуір теңізге бағыттаңыз!
Dialogue: 0,1:04:42.87,1:04:46.63,Default,,0,0,0,,Металл Греймонның соңғы эволюциясы!
Dialogue: 0,1:04:59.72,1:05:03.35,Default,,0,0,0,,Соғыс Греймон
Dialogue: 0,1:05:05.40,1:05:07.36,Default,,0,0,0,,Біз де кеттік!
Dialogue: 0,1:05:07.82,1:05:12.24,Default,,0,0,0,,Қасиетті Анжемонның соңғы эволюциясы!
Dialogue: 0,1:05:24.33,1:05:26.17,Default,,0,0,0,,Металл гарурумон
Dialogue: 0,1:05:26.29,1:05:28.17,Default,,0,0,0,,Серафимон
Dialogue: 0,1:05:28.29,1:05:29.84,Default,,0,0,0,,Роземон
Dialogue: 0,1:05:34.68,1:05:35.68,Default,,0,0,0,,Теңізге қарай!
Dialogue: 0,1:05:35.80,1:05:38.72,Default,,0,0,0,,(Хикаридің ауыр тыныс алуы)
Dialogue: 0,1:05:39.81,1:05:43.52,Default,,0,0,0,,Тоқта, Таңдалған балалар (Тайчи) Хикари?
Dialogue: 0,1:05:43.89,1:05:45.77,Default,,0,0,0,,Ақымақ істерді доғар
Dialogue: 0,1:05:46.23,1:05:47.61,Default,,0,0,0,,Гомеостаз?
Dialogue: 0,1:05:47.73,1:05:49.52,Default,,0,0,0,,«Ақылсыз еліктеу» дегенді қалай түсінесіңдер?
Dialogue: 0,1:05:50.02,1:05:53.53,Default,,0,0,0,,Ынтымақ пен тұрақтылыққа кедергі болса...
Dialogue: 0,1:05:53.61,1:05:56.03,Default,,0,0,0,,Мұның бәрі алып тастауға жатады.
Dialogue: 0,1:05:56.32,1:05:58.32,Default,,0,0,0,,Сонда сіз Мейкомонды өшіріп жатырсыз ба?
Dialogue: 0,1:05:58.49,1:06:00.08,Default,,0,0,0,,Мен мұны кешіре алмаймын!
Dialogue: 0,1:06:00.20,1:06:03.33,Default,,0,0,0,,Сіз жасай алмаған нәрсені біз жасаймыз.
Dialogue: 0,1:06:04.79,1:06:08.46,Default,,0,0,0,,Егер сіз кедергі келтіретін болсаңыз, мен сізді де алып тастаймын.
Dialogue: 0,1:06:08.58,1:06:09.84,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,1:06:10.50,1:06:15.09,Default,,0,0,0,,Бұл балалар мен серіктестер сіздің пешкаларыңыз емес!
Dialogue: 0,1:06:15.47,1:06:19.26,Default,,0,0,0,,Сіздің қазіргі әрекеттеріңіз үйлесімділікті бұзады.
Dialogue: 0,1:06:19.39,1:06:22.35,Default,,0,0,0,,Біз тек достарымызды қорғағымыз келеді!
Dialogue: 0,1:06:23.93,1:06:25.10,Default,,0,0,0,,Серіктер…
Dialogue: 0,1:06:31.61,1:06:34.61,Default,,0,0,0,,(Рагельмонның шайқас айқайы)
Dialogue: 0,1:06:35.19,1:06:37.74,Default,,0,0,0,,Ол адам тым күшті болып кетті.
Dialogue: 0,1:06:38.03,1:06:41.12,Default,,0,0,0,,Ынтымақтастық үшін кез келген нәрсені істеуге бола ма?
Dialogue: 0,1:06:41.24,1:06:42.79,Default,,0,0,0,,Құрбандық сөзсіз
Dialogue: 0,1:06:42.95,1:06:44.20,Default,,0,0,0,,Don't make it easy!
Dialogue: 0,1:06:44.45,1:06:45.75,Default,,0,0,0,,Бос сөз айтпа!
Dialogue: 0,1:06:46.08,1:06:47.71,Default,,0,0,0,,Не? шығу
Dialogue: 0,1:06:47.83,1:06:49.88,Default,,0,0,0,,Хикари...чан?
Dialogue: 0,1:06:50.54,1:06:53.00,Default,,0,0,0,,Қазір менің жанымнан кет!
Dialogue: 0,1:06:53.63,1:06:56.26,Default,,0,0,0,,Құрбандық қажет емес. Мүмкін емес!
Dialogue: 0,1:06:56.76,1:06:59.01,Default,,0,0,0,,Менің досым көңілсіз!
Dialogue: 0,1:06:59.72,1:07:03.76,Default,,0,0,0,,Мен мұны сіздің себептеріңіз үшін кешіре алмаймын!
Dialogue: 0,1:07:10.94,1:07:14.48,Default,,0,0,0,,Енді сіз ештеңе істей алмайсыз.
Dialogue: 0,1:07:15.36,1:07:19.95,Default,,0,0,0,,Үлкен суретке кедергі келтіретін жолдастықтан бас тартыңыз.
Dialogue: 0,1:07:26.12,1:07:27.79,Default,,0,0,0,,Ах! Мэй-чан!
Dialogue: 0,1:07:30.37,1:07:31.79,Default,,0,0,0,,Мочизуки!
Dialogue: 0,1:07:38.05,1:07:39.05,Default,,0,0,0,,Достар...
Dialogue: 0,1:07:39.34,1:07:42.55,Default,,0,0,0,,Достарыңды ойлаудың несі жаман?
Dialogue: 0,1:07:43.64,1:07:44.89,Default,,0,0,0,,Бұрмалау жоғалады!
Dialogue: 0,1:07:45.22,1:07:47.64,Default,,0,0,0,,Достарыңызды қорғаңыз! Ямато!
Dialogue: 0,1:07:47.77,1:07:48.98,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:49.73,1:07:51.40,Default,,0,0,0,,Ооооо!
Dialogue: 0,1:08:34.06,1:08:35.27,Default,,0,0,0,,Қасиетті жебе!
Dialogue: 0,1:08:39.86,1:08:42.20,Default,,0,0,0,,Сіз мені естисіз бе? Гомеостаз!
Dialogue: 0,1:08:43.36,1:08:46.28,Default,,0,0,0,,Маған дұрыс па, бұрыс па бәрібір!
Dialogue: 0,1:08:47.20,1:08:50.70,Default,,0,0,0,,Біз қымбат достарымызды қорғаймыз!
Dialogue: 0,1:08:51.41,1:08:53.04,Default,,0,0,0,,Міне!
Dialogue: 0,1:08:53.58,1:08:54.71,Default,,0,0,0,,Ах
Dialogue: 0,1:09:01.26,1:09:02.09,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:09.56,1:09:11.02,Default,,0,0,0,,Альфамон!
Dialogue: 0,1:09:11.22,1:09:12.35,Default,,0,0,0,,Yggdrasil?
Dialogue: 0,1:09:17.31,1:09:18.36,Default,,0,0,0,,Серафимон!
Dialogue: 0,1:09:59.98,1:10:04.99,Default,,0,0,0,,Ай!
Dialogue: 0,1:10:11.41,1:10:14.33,Default,,0,0,0,,Бакумон, кел
Dialogue: 0,1:10:23.88,1:10:25.63,Default,,0,0,0,,Алыс болыңыз
Dialogue: 0,1:10:25.76,1:10:30.30,Default,,0,0,0,,Маған тек Бакумон жақындай алады!
Dialogue: 0,1:10:32.97,1:10:36.60,Default,,0,0,0,,Неліктен? Неге келмейсің?
Dialogue: 0,1:10:36.77,1:10:38.27,Default,,0,0,0,,Бакумон
Dialogue: 0,1:10:39.31,1:10:42.27,Default,,0,0,0,,Әлем біздікі...
Dialogue: 0,1:10:46.45,1:10:47.28,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:52.99,1:10:54.04,Default,,0,0,0,,Мен...
Dialogue: 0,1:10:54.75,1:10:59.42,Default,,0,0,0,,Ақырында мен сені құтқара алмадым.
Dialogue: 0,1:11:04.21,1:11:09.30,Default,,0,0,0,,Біз не үшін таңдалдық?
Dialogue: 0,1:11:25.07,1:11:26.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:26.90,1:11:28.07,Default,,0,0,0,,Ерекшелеу?
Dialogue: 0,1:11:29.82,1:11:32.07,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,1:11:32.53,1:11:33.74,Default,,0,0,0,,Мейкомон!
Dialogue: 0,1:11:33.87,1:11:37.91,Default,,0,0,0,,Мешинді одан сайын мұңайтпа! өтінемін!
Dialogue: 0,1:11:38.04,1:11:42.00,Default,,0,0,0,,(Дигимон шайқасының дыбысы)
Dialogue: 0,1:11:45.38,1:11:46.76,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:49.30,1:11:50.59,Default,,0,0,0,,мамыр…
Dialogue: 0,1:11:53.26,1:11:56.47,Default,,0,0,0,,Мэй Чанды өлтіріңіз
Dialogue: 0,1:12:05.23,1:12:07.86,Default,,0,0,0,,Мейшин-сан! Меймей, сен не айтып тұрсың?
Dialogue: 0,1:12:10.86,1:12:14.16,Default,,0,0,0,,Енді жоқ...
Dialogue: 0,1:12:18.58,1:12:20.12,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,1:12:25.13,1:12:26.13,Default,,0,0,0,,Мен саған айттым ғой, солай ма?
Dialogue: 0,1:12:26.25,1:12:28.38,Default,,0,0,0,,Серіктестер бір-бірінің қалауы.
Dialogue: 0,1:12:28.80,1:12:31.97,Default,,0,0,0,,Бірақ бұл үмітсіздік емес пе?
Dialogue: 0,1:12:34.64,1:12:35.85,Default,,0,0,0,,Ха!
Dialogue: 0,1:12:37.31,1:12:41.73,Default,,0,0,0,,Содан кейін, Мейкомонды өлтіру ...
Dialogue: 0,1:12:41.85,1:12:44.69,Default,,0,0,0,,Мейшин-чанның ішіндегі үміттің жауабы осы ма?
Dialogue: 0,1:12:49.19,1:12:53.70,Default,,0,0,0,,Бұл... Бұл өте өкінішті!
Dialogue: 0,1:12:58.33,1:13:02.25,Default,,0,0,0,,Мен Мэй Чанды жақсы көремін.
Dialogue: 0,1:13:13.59,1:13:15.55,Default,,0,0,0,,Түсіндім, Тайчи! ?
Dialogue: 0,1:13:15.84,1:13:17.43,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,1:13:22.18,1:13:23.56,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,1:13:23.81,1:13:25.44,Default,,0,0,0,,Омегамон! Алыста!
Dialogue: 0,1:13:25.56,1:13:27.65,Default,,0,0,0,,Бұл Мейкомонды тоқтатудың жалғыз жолы!
Dialogue: 0,1:13:30.28,1:13:31.61,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:13:31.74,1:13:34.32,Default,,0,0,0,,Шынында да, Мейкомон барлық нәрсенің себебі.
Dialogue: 0,1:13:34.53,1:13:35.45,Default,,0,0,0,,Жо-сенпай!
Dialogue: 0,1:13:35.57,1:13:39.83,Default,,0,0,0,,Бірақ Мейкомон оның серіктесі!
Dialogue: 0,1:13:40.12,1:13:41.70,Default,,0,0,0,,Ауыстырылмайтын!
Dialogue: 0,1:13:41.83,1:13:46.83,Default,,0,0,0,,Тайчи! Бәрін Мейкомонға бер... арқасына арқалап жүрсін...
Dialogue: 0,1:13:47.21,1:13:49.63,Default,,0,0,0,,Сонымен мұның соңы бітті ме?
Dialogue: 0,1:13:49.75,1:13:53.47,Default,,0,0,0,,А, біз оны аяқтаймыз.
Dialogue: 0,1:13:54.55,1:13:58.39,Default,,0,0,0,,Сіз оларға қалаған нәрсені жасауға рұқсат бересіз бе?
Dialogue: 0,1:14:01.81,1:14:02.85,Default,,0,0,0,,(Рагельмонның айқайы)
Dialogue: 0,1:14:04.85,1:14:06.81,Default,,0,0,0,,Мейкомон дос.
Dialogue: 0,1:14:07.23,1:14:08.40,Default,,0,0,0,,Немесе бұл сәл қатігездік пе?
Dialogue: 0,1:14:09.69,1:14:11.86,Default,,0,0,0,,Достарыңыздың қайғысынан қашпаңыз!
Dialogue: 0,1:14:16.78,1:14:19.87,Default,,0,0,0,,Біз таңдаулы балалармыз!
Dialogue: 0,1:14:24.16,1:14:25.58,Default,,0,0,0,,Омегамон!
Dialogue: 0,1:14:27.50,1:14:29.17,Default,,0,0,0,,Ақымақ... ақымақ!
Dialogue: 0,1:14:29.17,1:14:29.46,Default,,0,0,0,,Бақа... ақымақ!
Dialogue: 0,1:14:29.17,1:14:29.46,Default,,0,0,0,,(Рагельмонның шайқас айқайы)
Dialogue: 0,1:14:29.46,1:14:31.21,Default,,0,0,0,,(Рагельмонның шайқас айқайы)
Dialogue: 0,1:14:40.68,1:14:42.06,Default,,0,0,0,,Мэй-чан...
Dialogue: 0,1:14:46.39,1:14:48.73,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,1:14:52.15,1:14:53.57,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:15:13.30,1:15:14.96,Default,,0,0,0,,Мочизуки мырза...
Dialogue: 0,1:15:15.09,1:15:16.51,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,1:15:17.13,1:15:20.72,Default,,0,0,0,,Достарын құрбан ету үміті болуы мүмкін бе? Тайчи!
Dialogue: 0,1:15:20.84,1:15:22.68,Default,,0,0,0,,Тоқтаңыз!
Dialogue: 0,1:15:22.80,1:15:25.56,Default,,0,0,0,,Түсінесіз бе? Ямато да!
Dialogue: 0,1:15:26.02,1:15:27.18,Default,,0,0,0,,Пә!
Dialogue: 0,1:15:35.03,1:15:37.95,Default,,0,0,0,,Ку… ah…
Dialogue: 0,1:15:39.40,1:15:41.74,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,1:15:41.87,1:15:43.45,Default,,0,0,0,,Yamato…
Dialogue: 0,1:15:47.00,1:15:48.58,Default,,0,0,0,,Рахмет
Dialogue: 0,1:15:52.04,1:15:53.42,Default,,0,0,0,,Мешин-сан?
Dialogue: 0,1:15:55.13,1:15:55.96,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:15:56.13,1:15:58.67,Default,,0,0,0,,Ақымақ! (Тайчи) Ямато!
Dialogue: 0,1:16:06.14,1:16:07.81,Default,,0,0,0,,Жоқ! мұғалім!
Dialogue: 0,1:16:07.93,1:16:09.23,Default,,0,0,0,,Осы жерде болыңыз!
Dialogue: 0,1:16:09.31,1:16:10.27,Default,,0,0,0,,Мэй-чан!
Dialogue: 0,1:16:10.39,1:16:11.73,Default,,0,0,0,,Мочизуки!
Dialogue: 0,1:16:16.48,1:16:17.73,Default,,0,0,0,,Жібер
Dialogue: 0,1:16:17.82,1:16:19.49,Default,,0,0,0,,Жібер!
Dialogue: 0,1:16:22.99,1:16:25.99,Default,,0,0,0,,Құйылмаған тіс!
Dialogue: 0,1:17:09.66,1:17:11.08,Default,,0,0,0,,Ямато!
Dialogue: 0,1:17:19.80,1:17:20.92,Default,,0,0,0,,Тайчи!
Dialogue: 0,1:17:32.23,1:17:33.19,Default,,0,0,0,,Омегамон!
Dialogue: 0,1:17:43.99,1:17:44.82,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:45.32,1:17:46.74,Default,,0,0,0,,Тайчи-сан!
Dialogue: 0,1:17:50.04,1:17:51.70,Default,,0,0,0,,Тайчи! Уф!
Dialogue: 0,1:17:56.46,1:17:57.33,Default,,0,0,0,,Ягами!
Dialogue: 0,1:18:10.26,1:18:11.81,Default,,0,0,0,,Тайчи…
Dialogue: 0,1:18:35.62,1:18:36.87,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,1:18:37.12,1:18:39.63,Default,,0,0,0,,Хикари! а! ?
Dialogue: 0,1:18:43.63,1:18:45.09,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,1:18:45.30,1:18:46.84,Default,,0,0,0,,Хикари!
Dialogue: 0,1:18:47.68,1:18:51.26,Default,,0,0,0,,Бауырым, неге?
Dialogue: 0,1:18:53.14,1:18:57.89,Default,,0,0,0,,Мен ағамның соңынан ермесем...
Dialogue: 0,1:18:58.98,1:19:00.40,Default,,0,0,0,,Хикари!
Dialogue: 0,1:19:05.57,1:19:06.40,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:09.61,1:19:12.24,Default,,0,0,0,,Хикари-чан, не болды?
Dialogue: 0,1:19:18.21,1:19:19.58,Default,,0,0,0,,Міне!
Dialogue: 0,1:19:23.25,1:19:26.76,Default,,0,0,0,,Үлкен аға, ақымақ...
Dialogue: 0,1:19:27.22,1:19:28.59,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:29.13,1:19:33.76,Default,,0,0,0,,Хикари… Мен…
Dialogue: 0,1:19:35.56,1:19:37.48,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,1:19:53.37,1:19:54.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:10.63,1:20:13.22,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,1:20:14.60,1:20:16.56,Default,,0,0,0,,Мейкомон...
Dialogue: 0,1:20:24.36,1:20:26.73,Default,,0,0,0,,Неғұрлым түзу және нәзік болса
Dialogue: 0,1:20:27.44,1:20:31.24,Default,,0,0,0,,Нәзік және оңай сынғыш Хехе...
Dialogue: 0,1:20:31.32,1:20:34.24,Default,,0,0,0,,Хикари-чан! Мықты болыңыз!
Dialogue: 0,1:20:45.09,1:20:49.01,Default,,0,0,0,,Алып кет... алып кет...
Dialogue: 0,1:21:04.31,1:21:05.77,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:21:12.32,1:21:13.49,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:45.56,1:21:47.44,Default,,0,0,0,,Қирау...
Dialogue: 0,1:21:51.23,1:21:55.78,Default,,0,0,0,,Жоғал... Бәрі де жоғалады.
Dialogue: 0,1:22:12.21,1:22:13.55,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:15.34,1:22:17.84,Default,,0,0,0,,Неден басталады?
Dialogue: 0,1:22:17.93,1:22:21.06,Default,,0,0,0,,Үйлесімділік бұзыла бастады.
Dialogue: 0,1:22:25.73,1:22:26.85,Default,,0,0,0,,(Големонның шайқас айқайы)
Dialogue: 0,1:22:41.12,1:22:43.83,Default,,0,0,0,,Йггдрасил ойлағандай болса...
Dialogue: 0,1:22:43.95,1:22:45.12,Default,,0,0,0,,Біздің әлем –
Dialogue: 0,1:22:46.16,1:22:49.63,Default,,0,0,0,,Сандық әлемге жұтылды
Dialogue: 0,1:22:55.26,1:22:56.47,Default,,0,0,0,,Достар...
Dialogue: 0,1:22:56.63,1:23:00.14,Default,,0,0,0,,Достарыңды ойлаудың несі жаман?
Dialogue: 0,1:23:00.93,1:23:02.51,Default,,0,0,0,,Ақымақ.
Dialogue: 0,1:23:03.39,1:23:05.39,Default,,0,0,0,,Барлығы орындарынан тұрыңдар!
Dialogue: 0,1:23:05.93,1:23:07.44,Default,,0,0,0,,Yamato…
Dialogue: 0,1:23:08.31,1:23:12.11,Default,,0,0,0,,Отырсаң не болады? Мен айқайласам не болады?
Dialogue: 0,1:23:12.65,1:23:14.48,Default,,0,0,0,,Ештеңені сақтау мүмкін емес!
Dialogue: 0,1:23:16.44,1:23:18.15,Default,,0,0,0,,Олай болса, тұр!
Dialogue: 0,1:23:19.78,1:23:20.66,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,1:23:21.66,1:23:23.41,Default,,0,0,0,,Кейінірек жыла!
Dialogue: 0,1:23:40.64,1:23:43.93,Default,,0,0,0,,Тайчи... Ал Тайчи ше?
Dialogue: 0,1:23:46.02,1:23:48.69,Default,,0,0,0,,Тайчи! Кел, Коромон!
Dialogue: 0,1:23:50.27,1:23:53.40,Default,,0,0,0,,Мен Тайчиді қорғауым керек.
Dialogue: 0,1:23:53.52,1:23:55.15,Default,,0,0,0,,Қорғау керек...
Dialogue: 0,1:23:55.28,1:23:56.86,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,1:23:57.69,1:23:59.82,Default,,0,0,0,,Мешин I...
Dialogue: 0,1:24:00.57,1:24:02.53,Default,,0,0,0,,Тайчи…
Dialogue: 0,1:24:04.45,1:24:06.20,Default,,0,0,0,,Кешіріңіз, кешірім сұрамаңыз
Dialogue: 0,1:24:06.58,1:24:10.50,Default,,0,0,0,,Бұл оның өз бетінше қабылдаған шешімі.
Dialogue: 0,1:24:14.88,1:24:16.50,Default,,0,0,0,,Yamato…
Dialogue: 0,1:24:16.63,1:24:17.88,Default,,0,0,0,,Кеттік
Dialogue: 0,1:24:46.41,1:24:51.41,Default,,0,0,0,,♪~
Dialogue: 0,1:28:41.85,1:28:46.86,Default,,0,0,0,,~♪
