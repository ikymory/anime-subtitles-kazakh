Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:21.85,0:00:27.86,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:00:28.48,0:00:30.36,Default,,0,0,0,,Әкем қоңырау шалып тұр.
Dialogue: 0,0:00:30.44,0:00:32.78,Default,,0,0,0,,«Зардап шегушілер ашу-ыза білдіреді»
Dialogue: 0,0:00:32.86,0:00:34.28,Default,,0,0,0,,Хмм…
Dialogue: 0,0:00:34.36,0:00:36.70,Default,,0,0,0,,Иә, Моури детектив агенттігі
Dialogue: 0,0:00:36.78,0:00:38.62,Default,,0,0,0,,Бұл Когоро Моури.
Dialogue: 0,0:00:38.70,0:00:41.12,Default,,0,0,0,,Иә, сіз қайсысысыз?
Dialogue: 0,0:00:41.20,0:00:43.00,Default,,0,0,0,,Белгілі бір жерге бомба қойылды.
Dialogue: 0,0:00:43.08,0:00:45.04,Default,,0,0,0,,- (Когоро) Не? бомба? - (Жүгіріп) А?
Dialogue: 0,0:00:45.12,0:00:47.17,Default,,0,0,0,,Жарылыс 15:30-да.
Dialogue: 0,0:00:47.25,0:00:50.63,Default,,0,0,0,,Жарылысты тоқтатқыңыз келсе, мен айтайын деп тұрған кодты ашыңыз.
Dialogue: 0,0:00:50.71,0:00:52.34,Default,,0,0,0,,Қарғыс атсын... Ақымақ болма!
Dialogue: 0,0:00:52.42,0:00:54.47,Default,,0,0,0,,Әзілге айналдыруға болмайтын нәрсені айтыңыз.
Dialogue: 0,0:00:54.55,0:00:55.84,Default,,0,0,0,,Мен полицияға хабарлаймын.
Dialogue: 0,0:00:55.93,0:00:57.34,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:00:57.43,0:00:58.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:00:58.80,0:01:00.31,Default,,0,0,0,,Терезеден қара
Dialogue: 0,0:01:01.18,0:01:02.10,Default,,0,0,0,,Терезенің сыртында?
Dialogue: 0,0:01:04.52,0:01:06.60,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:01:13.28,0:01:14.15,Default,,0,0,0,,А...
Dialogue: 0,0:01:14.74,0:01:15.61,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:01:15.70,0:01:16.61,Default,,0,0,0,,Соңында 300-ден астам оқ аттым
Dialogue: 0,0:01:16.70,0:01:20.53,Default,,0,0,0,,(өтіп бара жатқандардың шуы)
Dialogue: 0,0:01:25.62,0:01:30.63,Default,,0,0,0,,♪～
Dialogue: 0,0:01:42.64,0:01:44.56,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:46.98,0:01:49.77,Default,,0,0,0,,Мен орта мектептің детективімін, Шиничи Кудо
Dialogue: 0,0:01:50.36,0:01:52.32,Default,,0,0,0,,Бала күнгі досы және сыныптасы Ран Моримен
Dialogue: 0,0:01:52.40,0:01:54.11,Default,,0,0,0,,Ойын-сауық саябағына барыңыз
Dialogue: 0,0:01:54.19,0:01:55.57,Default,,0,0,0,,Қара киінген адам
Dialogue: 0,0:01:55.65,0:01:57.90,Default,,0,0,0,,Мен күдікті транзакцияның куәсі болдым.
Dialogue: 0,0:01:58.86,0:02:01.03,Default,,0,0,0,,Мен мәмілені қарауға берілгенмін.
Dialogue: 0,0:02:01.12,0:02:02.24,Default,,0,0,0,,Артынан жақындау—
Dialogue: 0,0:02:02.33,0:02:04.70,Default,,0,0,0,,Басқа серігін байқамадым.
Dialogue: 0,0:02:06.04,0:02:08.71,Default,,0,0,0,,Ол кісі маған у ішті.
Dialogue: 0,0:02:08.79,0:02:09.87,Default,,0,0,0,,Мен оянғанда...
Dialogue: 0,0:02:10.50,0:02:12.88,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:02:13.42,0:02:15.76,Default,,0,0,0,,Егер олар Шиничи Кудоның тірі екенін білсе ше?
Dialogue: 0,0:02:15.84,0:02:17.47,Default,,0,0,0,,Менің өміріме тағы бір қастандық
Dialogue: 0,0:02:17.55,0:02:19.13,Default,,0,0,0,,Айналаңыздағы адамдарға да қауіп төніп тұр.
Dialogue: 0,0:02:20.18,0:02:21.18,Default,,0,0,0,,Доктор Агасаның кеңесі бойынша
Dialogue: 0,0:02:21.26,0:02:23.05,Default,,0,0,0,,Мен өзімнің шынайы тұлғамды жасыруды шештім.
Dialogue: 0,0:02:23.14,0:02:24.31,Default,,0,0,0,,Ран менің атымды сұрады
Dialogue: 0,0:02:24.39,0:02:26.85,Default,,0,0,0,,Бірден өзін Эдогава Конан деп атады
Dialogue: 0,0:02:27.68,0:02:29.48,Default,,0,0,0,,Өз мәліметтерін алу
Dialogue: 0,0:02:29.56,0:02:32.90,Default,,0,0,0,,Ранның үйіне көшіп келді, оның әкесі детектив болып жұмыс істейді.
Dialogue: 0,0:02:36.78,0:02:38.82,Default,,0,0,0,,Кеш қалмаңыз, доктор.
Dialogue: 0,0:02:38.90,0:02:41.16,Default,,0,0,0,,Мен лицензиямды қайтадан таба алмаймын...
Dialogue: 0,0:02:41.24,0:02:42.66,Default,,0,0,0,,Әрқашан солай.
Dialogue: 0,0:02:42.74,0:02:44.12,Default,,0,0,0,,Бізге асығу керек...
Dialogue: 0,0:02:44.20,0:02:46.41,Default,,0,0,0,,Сіз Хиденің қолтаңбасын ала алмайсыз.
Dialogue: 0,0:02:46.49,0:02:49.08,Default,,0,0,0,,Лотерея ұтып алсам да~
Dialogue: 0,0:02:49.16,0:02:51.71,Default,,0,0,0,,Нағыз J Leaguer-мен кездесу мүмкіндігі қандай.
Dialogue: 0,0:02:51.79,0:02:53.04,Default,,0,0,0,,Сирек болса да...
Dialogue: 0,0:02:53.63,0:02:56.17,Default,,0,0,0,,Аюми Гента Мицухико
Dialogue: 0,0:02:56.25,0:02:59.09,Default,,0,0,0,,Менің қазіргі сыныптасым кішірейіп кетті.
Dialogue: 0,0:02:59.17,0:03:01.63,Default,,0,0,0,,Соңғы тренд J лигасы сияқты.
Dialogue: 0,0:03:01.72,0:03:02.89,Default,,0,0,0,,- (Агаса) Ахх... - (Мицухико) Ах!
Dialogue: 0,0:03:02.97,0:03:04.60,Default,,0,0,0,,шықты
Dialogue: 0,0:03:05.18,0:03:06.26,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:03:06.35,0:03:08.60,Default,,0,0,0,,Менің жүргізуші куәлігімді табу қиынға соғып жатыр.
Dialogue: 0,0:03:08.68,0:03:09.56,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:03:09.64,0:03:11.56,Default,,0,0,0,,- (Гента) Мүлдем - (Мицухико) Егер сіз дәрігер болсаңыз.
Dialogue: 0,0:03:11.64,0:03:13.52,Default,,0,0,0,,Оның аты доктор Агаса
Dialogue: 0,0:03:14.23,0:03:16.69,Default,,0,0,0,,Және Ай Хайбара
Dialogue: 0,0:03:17.28,0:03:20.15,Default,,0,0,0,,Ол менің шынайы болмысымды білетін санаулы адамдардың бірі.
Dialogue: 0,0:03:20.24,0:03:23.24,Default,,0,0,0,,Өзің не деп күбірлеп тұрсың?
Dialogue: 0,0:03:23.32,0:03:25.41,Default,,0,0,0,,Спорт алаңына барайық
Dialogue: 0,0:03:25.49,0:03:27.54,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,0:03:27.62,0:03:29.08,Default,,0,0,0,,Ах... ой
Dialogue: 0,0:03:29.16,0:03:30.37,Default,,0,0,0,,Мен ұмытып қалдым.
Dialogue: 0,0:03:30.46,0:03:31.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:31.54,0:03:33.37,Default,,0,0,0,,Қараңызшы, кәдімгі.
Dialogue: 0,0:03:33.46,0:03:34.42,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:03:35.13,0:03:37.42,Default,,0,0,0,,Кішірейсек те, миымыз бірдей
Dialogue: 0,0:03:37.50,0:03:39.55,Default,,0,0,0,,Лабиринті жоқ детектив
Dialogue: 0,0:03:40.42,0:03:44.01,Default,,0,0,0,,Әрқашан бір шындық бар! ～♪
Dialogue: 0,0:03:44.01,0:03:45.39,Default,,0,0,0,,～♪
Dialogue: 0,0:03:46.85,0:03:50.22,Default,,0,0,0,,J лигасының демеушісі: Nichiuri TV
Dialogue: 0,0:03:50.31,0:03:54.27,Default,,0,0,0,,16-шы футбол сыныбының басталуы
Dialogue: 0,0:03:54.35,0:03:56.23,Default,,0,0,0,,Бұл J Leaguer!
Dialogue: 0,0:03:56.86,0:03:58.36,Default,,0,0,0,,Эндо Конноға
Dialogue: 0,0:03:59.23,0:04:00.36,Default,,0,0,0,,Нарасакиге...
Dialogue: 0,0:04:00.44,0:04:02.20,Default,,0,0,0,,Накамура ойыншысы да бар.
Dialogue: 0,0:04:02.28,0:04:04.86,Default,,0,0,0,,Олай болса, осыны да бастайық.
Dialogue: 0,0:04:04.95,0:04:06.07,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:04:06.16,0:04:07.37,Default,,0,0,0,,Әй, 10 саны!
Dialogue: 0,0:04:07.45,0:04:08.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:09.29,0:04:12.96,Default,,0,0,0,,Kawasaki Frontale Kengo Nakamura
Dialogue: 0,0:04:13.75,0:04:15.58,Default,,0,0,0,,Не болды? Конан-кун
Dialogue: 0,0:04:15.67,0:04:19.25,Default,,0,0,0,,Ол маған үзіліс жасауымды айтты да, алдымен төртеуміз боламыз деді.
Dialogue: 0,0:04:19.34,0:04:22.17,Default,,0,0,0,,Кешіріңіз, бірақ сіз Когоро Моурисіз, солай ма?
Dialogue: 0,0:04:22.26,0:04:23.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:23.30,0:04:24.97,Default,,0,0,0,,I Nichiuri TV—
Dialogue: 0,0:04:25.05,0:04:27.97,Default,,0,0,0,,Менің атым Ямамори, Спорттық ақпарат бюросының директоры.
Dialogue: 0,0:04:28.05,0:04:29.47,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:29.56,0:04:33.85,Default,,0,0,0,,Уау, атақты детектив Мори-санмен кездескеніме өте қуаныштымын.
Dialogue: 0,0:04:33.94,0:04:35.31,Default,,0,0,0,,Кода-чан, суретке түсір.
Dialogue: 0,0:04:35.40,0:04:36.40,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:36.48,0:04:38.82,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:04:38.90,0:04:40.23,Default,,0,0,0,,Хаха... (ысырма дыбысы)
Dialogue: 0,0:04:40.32,0:04:41.94,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:04:42.03,0:04:45.03,Default,,0,0,0,,Ол Каору Кода, Nichiuri Shimbun газетінің фотографы.
Dialogue: 0,0:04:45.11,0:04:47.41,Default,,0,0,0,,Мен бұрын әлеуметтік мәселелер бөлімінде болдым.
Dialogue: 0,0:04:47.49,0:04:49.78,Default,,0,0,0,,Биылғы жылы мен спорттық ойын-сауық клубының таңдауына ие болдым.
Dialogue: 0,0:04:49.87,0:04:52.45,Default,,0,0,0,,Ямамори мырза, бұл жерде айтатын ештеңе жоқ...
Dialogue: 0,0:04:52.54,0:04:55.92,Default,,0,0,0,,Бірақ мен осы жерден бір шелек алсам.
Dialogue: 0,0:04:56.00,0:04:59.04,Default,,0,0,0,,Олар сізді әлеуметтік мәселелер бөліміне қайтарамыз деп жатыр.
Dialogue: 0,0:04:59.13,0:04:59.96,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:05:00.04,0:05:02.88,Default,,0,0,0,,Ал, мен сендерге сәттілік тілеймін.
Dialogue: 0,0:05:02.96,0:05:05.43,Default,,0,0,0,,Менен де артық, Ямамори мырза
Dialogue: 0,0:05:05.51,0:05:07.34,Default,,0,0,0,,Біз футбол трансляциялары үшін көрермендердің рейтингін арттыруымыз керек.
Dialogue: 0,0:05:07.43,0:05:09.80,Default,,0,0,0,,Мен сізді менеджер жұмыстан шығарады деп естідім.
Dialogue: 0,0:05:09.89,0:05:12.35,Default,,0,0,0,,Ха... Дұрыс.
Dialogue: 0,0:05:12.43,0:05:15.77,Default,,0,0,0,,Сізде жақсы идеялар бар ма? Моури мырза
Dialogue: 0,0:05:15.85,0:05:16.64,Default,,0,0,0,,Хмм, дұрыс...
Dialogue: 0,0:05:16.64,0:05:19.44,Default,,0,0,0,,Хмм, дұрыс...
Dialogue: 0,0:05:16.64,0:05:19.44,Default,,0,0,0,,Хахаха... Қариядан сұрау керек шығар?
Dialogue: 0,0:05:20.06,0:05:21.40,Default,,0,0,0,,Ой! Сонда бар!
Dialogue: 0,0:05:21.48,0:05:22.69,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:22.78,0:05:25.86,Default,,0,0,0,,Иә, мен Йоко-чанмен қонақта боламын.
Dialogue: 0,0:05:25.95,0:05:26.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.49,0:05:27.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.49,0:05:27.41,Default,,0,0,0,,Көрермендердің рейтингі өсетіні сөзсіз!
Dialogue: 0,0:05:27.41,0:05:27.49,Default,,0,0,0,,Көрермендердің рейтингі өсетіні сөзсіз!
Dialogue: 0,0:05:27.49,0:05:28.32,Default,,0,0,0,,Көрермендердің рейтингі өсетіні сөзсіз!
Dialogue: 0,0:05:27.49,0:05:28.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:28.32,0:05:28.82,Default,,0,0,0,,Көрермендердің рейтингі өсетіні сөзсіз!
Dialogue: 0,0:05:28.91,0:05:31.45,Default,,0,0,0,,Йоко-чан, ол желтоқсанда ма?
Dialogue: 0,0:05:31.53,0:05:32.49,Default,,0,0,0,,Shiodome Arena-дағы концертке дейін кесте толық.
Dialogue: 0,0:05:32.49,0:05:34.20,Default,,0,0,0,,Шиодоме Аренадағы концертке дейін кесте толық.
Dialogue: 0,0:05:32.49,0:05:34.20,Default,,0,0,0,,Әй, мынаны қара!
Dialogue: 0,0:05:34.29,0:05:37.21,Default,,0,0,0,,Бұл балалар әлдеқайда жақсы болды, солай емес пе?
Dialogue: 0,0:05:37.29,0:05:40.46,Default,,0,0,0,,Бұл рас! Біраз уақыт көрмесем де...
Dialogue: 0,0:05:42.34,0:05:43.42,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:05:43.50,0:05:46.72,Default,,0,0,0,,Күтілгендей, кәсіби маман үйреткен кезде тез жетілдіре аласыз.
Dialogue: 0,0:05:46.80,0:05:51.01,Default,,0,0,0,,Ойлап қарасам, Ран футболға онша қызықпайтын сияқты.
Dialogue: 0,0:05:51.10,0:05:52.56,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:05:52.64,0:05:54.60,Default,,0,0,0,,Мен Конанмен бірге теледидарды жиі көремін.
Dialogue: 0,0:05:54.68,0:05:56.02,Default,,0,0,0,,Бірақ мен мұны ешқашан жасаған емеспін.
Dialogue: 0,0:05:57.10,0:06:00.44,Default,,0,0,0,,Иә, бірақ бір рет, мен орта мектепте оқып жүрген кезімде.
Dialogue: 0,0:06:00.52,0:06:02.77,Default,,0,0,0,,Шиничи жіберіп алған доп...
Dialogue: 0,0:06:02.86,0:06:06.11,Default,,0,0,0,,Аа, дұрыс, анау жігіт, сол кезде...
Dialogue: 0,0:06:06.19,0:06:08.28,Default,,0,0,0,,Не? не болды? Орхидея
Dialogue: 0,0:06:08.36,0:06:09.70,Default,,0,0,0,,Жоқ... бұл ештеңе емес.
Dialogue: 0,0:06:11.66,0:06:12.95,Default,,0,0,0,,Иә? Ол адам...
Dialogue: 0,0:06:13.99,0:06:16.50,Default,,0,0,0,,Сөзсіз ғажайып бір топ
Dialogue: 0,0:06:16.58,0:06:18.37,Default,,0,0,0,,Казумаса Накаока.
Dialogue: 0,0:06:18.46,0:06:20.12,Default,,0,0,0,,«Ғажайып бір топ»?
Dialogue: 0,0:06:20.21,0:06:26.30,Default,,0,0,0,,А, Накаока мырза осыдан үш жыл бұрын Кайдо орта мектебін ұлттық чемпионатқа апарған.
Dialogue: 0,0:06:26.38,0:06:31.34,Default,,0,0,0,,Маған аруақтарға қосылу туралы ұсыныс ұсынылды, мен болашақ эйс кандидаты екенімді айтты...
Dialogue: 0,0:06:31.43,0:06:35.14,Default,,0,0,0,,Финалдан бір айдан кейін мен мотоциклмен апатқа ұшырадым.
Dialogue: 0,0:06:35.22,0:06:38.56,Default,,0,0,0,,Осыдан кейін ол футбол әлемінен жоғалып кетті.
Dialogue: 0,0:06:38.64,0:06:41.27,Default,,0,0,0,,Джага, мұнда болу дегеніміз...
Dialogue: 0,0:06:41.35,0:06:45.40,Default,,0,0,0,,А, футболға әлі де өкінетін шығармын.
Dialogue: 0,0:06:46.36,0:06:48.36,Default,,0,0,0,,Жақсы! Барлығы жақсарып келеді.
Dialogue: 0,0:06:48.44,0:06:49.32,Default,,0,0,0,,Кезек-кезек айтайық!
Dialogue: 0,0:06:49.40,0:06:50.99,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:06:51.57,0:06:53.28,Default,,0,0,0,,Сәлем! №10 бала!
Dialogue: 0,0:06:53.37,0:06:55.20,Default,,0,0,0,,Қарашы, мен сені шақырып жатырмын, Конан-кун.
Dialogue: 0,0:06:55.28,0:06:56.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:56.70,0:06:59.00,Default,,0,0,0,,Әй, менің кезегім келді.
Dialogue: 0,0:06:59.08,0:06:59.91,Default,,0,0,0,,Уф
Dialogue: 0,0:07:01.46,0:07:02.29,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:04.63,0:07:06.13,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:06.21,0:07:08.76,Default,,0,0,0,,-(Балалар) Уау~ -(Соноко) Жасайық!
Dialogue: 0,0:07:08.84,0:07:10.59,Default,,0,0,0,,Сәлем Моури-сенпай
Dialogue: 0,0:07:11.18,0:07:14.30,Default,,0,0,0,,Менің атым Риосуке Сакаки, мен Бейка университетінің студентімін...
Dialogue: 0,0:07:14.39,0:07:16.93,Default,,0,0,0,,Ах! Бұл Сакакидің өз голы!
Dialogue: 0,0:07:17.01,0:07:17.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:17.97,0:07:18.85,Default,,0,0,0,,Жеке гол?
Dialogue: 0,0:07:18.93,0:07:23.65,Default,,0,0,0,,Аа, бұл жігіт лиганың соңғы ойынында автогол соқты.
Dialogue: 0,0:07:23.73,0:07:28.15,Default,,0,0,0,,Сол себепті Бейка университеті соңғы бес жылда бірінші рет жеңіске жетуден құр қалды.
Dialogue: 0,0:07:28.23,0:07:30.07,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:34.16,0:07:36.74,Default,,0,0,0,,А, сен білдің...
Dialogue: 0,0:07:36.83,0:07:40.87,Default,,0,0,0,,Бұл таңқаларлық емес, мен ол ойынды трибунада қарап отырдым.
Dialogue: 0,0:07:41.75,0:07:43.25,Default,,0,0,0,,Бұл неше жыл бұрын болды?
Dialogue: 0,0:07:43.33,0:07:44.58,Default,,0,0,0,,10 жыл бұрын
Dialogue: 0,0:07:44.67,0:07:48.59,Default,,0,0,0,,Мен қатты күйзеліске түскенім сонша, кейде бұл туралы әлі де армандаймын.
Dialogue: 0,0:07:48.67,0:07:49.55,Default,,0,0,0,,Әке!
Dialogue: 0,0:07:49.63,0:07:52.55,Default,,0,0,0,,Сол ескі әңгімелерді қозғамасаң да...
Dialogue: 0,0:07:52.63,0:07:56.35,Default,,0,0,0,,А... а, енді?
Dialogue: 0,0:07:56.43,0:07:58.85,Default,,0,0,0,,Спорт залының нұсқаушысы болып жұмыс істегенде
Dialogue: 0,0:07:58.93,0:08:00.89,Default,,0,0,0,,Мен футболдан жастар жаттықтырушысымын.
Dialogue: 0,0:08:00.98,0:08:03.02,Default,,0,0,0,,Иә, бұл керемет емес пе?
Dialogue: 0,0:08:03.10,0:08:05.40,Default,,0,0,0,,Сондықтан бұл жолы Мори-сенпайға баруым керек болды.
Dialogue: 0,0:08:05.48,0:08:06.86,Default,,0,0,0,,Мен таныстырғым келетін біреу бар.
Dialogue: 0,0:08:06.94,0:08:07.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.90,0:08:09.82,Default,,0,0,0,,Ол кісі менің ағамның жанкүйері.
Dialogue: 0,0:08:10.49,0:08:12.28,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:08:12.36,0:08:13.99,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:08:14.07,0:08:17.91,Default,,0,0,0,,Рахмет. Мен сені бірден әкелемін.
Dialogue: 0,0:08:17.99,0:08:18.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:18.99,0:08:20.08,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:08:24.17,0:08:26.25,Default,,0,0,0,,Әке! Әке~!!
Dialogue: 0,0:08:28.75,0:08:29.63,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:08:29.71,0:08:30.84,Default,,0,0,0,,О...
Dialogue: 0,0:08:32.34,0:08:35.26,Default,,0,0,0,,А... Мен берілдім.
Dialogue: 0,0:08:35.34,0:08:39.01,Default,,0,0,0,,- (Аюми) Уау, бұл керемет - (Мицухико) Бұл керемет!
Dialogue: 0,0:08:39.10,0:08:42.85,Default,,0,0,0,,Ақыр аяғында, ол іште жай ғана футболшы бала.
Dialogue: 0,0:08:43.43,0:08:45.10,Default,,0,0,0,,Жақсы жұмыс Конан-кун
Dialogue: 0,0:08:45.19,0:08:46.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:46.60,0:08:47.73,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:47.81,0:08:49.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:49.86,0:08:52.28,Default,,0,0,0,,- (Соноко) Уау, әдемі! -(Хайбара) А...
Dialogue: 0,0:08:52.36,0:08:54.99,Default,,0,0,0,,Уау, бұл нағыз Хиго!
Dialogue: 0,0:08:55.07,0:08:56.24,Default,,0,0,0,,Шиничи Кудо
Dialogue: 0,0:08:56.32,0:08:57.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:58.66,0:08:59.53,Default,,0,0,0,,Соңғы кездері түн-түні оқып жүргендіктен.
Dialogue: 0,0:08:59.62,0:09:01.16,Default,,0,0,0,,Аа...
Dialogue: 0,0:09:01.24,0:09:04.66,Default,,0,0,0,,Шиничи туралы... Сіз Шиничи туралы білесіз бе?
Dialogue: 0,0:09:04.75,0:09:06.87,Default,,0,0,0,,Э? О, иә.
Dialogue: 0,0:09:06.96,0:09:11.38,Default,,0,0,0,,Мен оның ойынын бұрын барып көріп, сөйлескенмін.
Dialogue: 0,0:09:12.00,0:09:13.55,Default,,0,0,0,,Оған ұқсайды.
Dialogue: 0,0:09:14.30,0:09:16.18,Default,,0,0,0,,Бұл баланың тебу формасы...
Dialogue: 0,0:09:16.26,0:09:18.05,Default,,0,0,0,,Ал... бұл Шиничи-чанға арналған.
Dialogue: 0,0:09:18.14,0:09:20.47,Default,,0,0,0,,Менің ойымша, бұл маған футбол үйрететіндіктен.
Dialogue: 0,0:09:20.55,0:09:21.51,Default,,0,0,0,,Аха... ахаха...
Dialogue: 0,0:09:21.60,0:09:25.48,Default,,0,0,0,,Қарасам, сол жігіт мені оқытты.
Dialogue: 0,0:09:26.52,0:09:28.02,Default,,0,0,0,,Футбол, бар күшіңді сал
Dialogue: 0,0:09:28.10,0:09:28.98,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:29.56,0:09:30.61,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:32.19,0:09:33.94,Default,,0,0,0,,Керемет! (Аюми) Конан-кун
Dialogue: 0,0:09:34.03,0:09:35.65,Default,,0,0,0,,Хиго мені сипады!
Dialogue: 0,0:09:35.74,0:09:36.99,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,0:09:37.11,0:09:38.82,Default,,0,0,0,,Әзірге шашыңызды жууға болмайды...
Dialogue: 0,0:09:38.91,0:09:41.16,Default,,0,0,0,,Хехе, солай деп ойлаймын. Ауырады...
Dialogue: 0,0:09:42.83,0:09:44.16,Default,,0,0,0,,Уа... Эй, күте тұр...
Dialogue: 0,0:09:44.25,0:09:46.33,Default,,0,0,0,,А... Жуайын ба?
Dialogue: 0,0:09:46.91,0:09:48.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.08,0:09:49.54,Default,,0,0,0,,Хехе... Мен де сені еркелетемін.
Dialogue: 0,0:09:49.63,0:09:50.67,Default,,0,0,0,,Мен де!
Dialogue: 0,0:09:50.75,0:09:52.71,Default,,0,0,0,,Конан-кун, шашыңыз керемет.
Dialogue: 0,0:09:52.80,0:09:54.01,Default,,0,0,0,,Тоқтаңдар, балалар.
Dialogue: 0,0:09:54.09,0:09:56.42,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, Мори-сенпай.
Dialogue: 0,0:09:56.51,0:09:57.97,Default,,0,0,0,,- (Когоро) А? -(Сакаки) Кішкене қарсы боласыз ба?
Dialogue: 0,0:09:58.05,0:09:59.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:59.97,0:10:04.35,Default,,0,0,0,,Сіздерді Кавайто қаласындағы шағын зауыттың президентімен таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:10:05.14,0:10:08.85,Default,,0,0,0,,Бұл команда демеушісінің төрағасы Кейичиро Мотура.
Dialogue: 0,0:10:08.94,0:10:09.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:10.90,0:10:13.52,Default,,0,0,0,,Менің атым Мотура, мен көптен бері танымалмын...
Dialogue: 0,0:10:13.61,0:10:15.32,Default,,0,0,0,,Бұл үшін рахмет.
Dialogue: 0,0:10:15.40,0:10:19.74,Default,,0,0,0,,Мотура мырза менің үлкен ағамның жанкүйері, сондықтан мен оған оның осы орынға келетінін айттым.
Dialogue: 0,0:10:19.82,0:10:20.99,Default,,0,0,0,,Мен сенімен танысқым келеді...
Dialogue: 0,0:10:21.07,0:10:22.53,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:10:22.62,0:10:23.49,Default,,0,0,0,,Мори мырзаға
Dialogue: 0,0:10:23.58,0:10:26.29,Default,,0,0,0,,Менде сіздің көргіңіз келетін фотосурет бар...
Dialogue: 0,0:10:26.37,0:10:27.20,Default,,0,0,0,,Маған?
Dialogue: 0,0:10:27.87,0:10:30.17,Default,,0,0,0,,Иә, мен мұны қалаймын.
Dialogue: 0,0:10:30.25,0:10:31.79,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:31.88,0:10:33.42,Default,,0,0,0,,Оны Аюмиге және басқаларға көрсет!
Dialogue: 0,0:10:33.50,0:10:34.50,Default,,0,0,0,,Көрейік!
Dialogue: 0,0:10:34.59,0:10:36.71,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:10:36.80,0:10:39.34,Default,,0,0,0,,А... Иә? Сол адам
Dialogue: 0,0:10:39.43,0:10:41.39,Default,,0,0,0,,Бірге тамашалайық, Конан-кун.
Dialogue: 0,0:10:41.47,0:10:43.18,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:44.39,0:10:45.81,Default,,0,0,0,,Бұл қандай фотосурет?
Dialogue: 0,0:10:45.89,0:10:49.73,Default,,0,0,0,,Бұл менің ұлым Томодзи. Басқа фотоларды қараңыз.
Dialogue: 0,0:10:49.81,0:10:53.65,Default,,0,0,0,,Ах... күрсін... Көңілді көрінгеніне қуаныштымын.
Dialogue: 0,0:10:53.73,0:10:55.44,Default,,0,0,0,,Бүгін сіздің ұлыңыз да келе ме?
Dialogue: 0,0:10:55.52,0:10:58.99,Default,,0,0,0,,Бұл шын мәнінде Томодзи-кун.
Dialogue: 0,0:10:59.07,0:11:02.16,Default,,0,0,0,,Ағымдағы жылдың тамыз айында аурудан қайтыс болды.
Dialogue: 0,0:11:02.24,0:11:03.28,Default,,0,0,0,,А...
Dialogue: 0,0:11:03.37,0:11:05.08,Default,,0,0,0,,Мен бастауыш мектептің төртінші сыныбында оқыдым.
Dialogue: 0,0:11:05.16,0:11:06.45,Default,,0,0,0,,О, мен түсіндім...
Dialogue: 0,0:11:06.54,0:11:09.79,Default,,0,0,0,,Томодзи бастапқыда әлсіз болды.
Dialogue: 0,0:11:09.87,0:11:13.17,Default,,0,0,0,,Дәрігер маған ауыр жаттығулар жасамау керектігін айтты.
Dialogue: 0,0:11:13.25,0:11:15.59,Default,,0,0,0,,Бұл фото туралы не деуге болады?
Dialogue: 0,0:11:15.67,0:11:17.88,Default,,0,0,0,,Өйткені мен футбол ойнағым келеді
Dialogue: 0,0:11:17.96,0:11:21.68,Default,,0,0,0,,Мен жаттықтырушы Сакакиді командаға қосылуға мәжбүрледім.
Dialogue: 0,0:11:21.76,0:11:25.55,Default,,0,0,0,,Бұл суретті жаттықтырушының рұқсатымен ойында бір рет көрсетуге рұқсат етілді.
Dialogue: 0,0:11:25.64,0:11:27.60,Default,,0,0,0,,Бұл менің гол соққан кезім.
Dialogue: 0,0:11:27.68,0:11:29.77,Default,,0,0,0,,Бұл мақсатқа жету сәті.
Dialogue: 0,0:11:29.85,0:11:30.77,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:11:30.85,0:11:32.60,Default,,0,0,0,,Футбол жақсы болды, солай емес пе?
Dialogue: 0,0:11:32.69,0:11:34.52,Default,,0,0,0,,- (Аюми) Иә - (Мицухико) Бұл жақсы.
Dialogue: 0,0:11:34.61,0:11:36.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:36.11,0:11:37.07,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:38.86,0:11:40.70,Default,,0,0,0,,Бұл соңғы рет пе?
Dialogue: 0,0:11:40.78,0:11:43.61,Default,,0,0,0,,Айтпақшы, бұл фотоны маған не үшін бердіңіз?
Dialogue: 0,0:11:43.70,0:11:44.82,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:44.91,0:11:48.45,Default,,0,0,0,,Мен жай ғана Томоджидің тірі екендігінің дәлелін көргім келді.
Dialogue: 0,0:11:49.29,0:11:52.37,Default,,0,0,0,,Көңілді атмосфераны бұзғаным үшін кешірім сұраймын.
Dialogue: 0,0:11:53.17,0:11:55.38,Default,,0,0,0,,Дж.Лига ойыншылары
Dialogue: 0,0:11:55.46,0:11:56.29,Default,,0,0,0,,Бағдарламаның екінші жартысы басталады...
Dialogue: 0,0:11:56.88,0:11:59.17,Default,,0,0,0,,Бір нәрсе мені қынжылтты.
Dialogue: 0,0:11:59.26,0:12:00.80,Default,,0,0,0,,- (Аюми) Иә - (Гента) Ойланып қалды ма?
Dialogue: 0,0:12:00.88,0:12:03.09,Default,,0,0,0,,Олай болса, мұндай кездер ше?
Dialogue: 0,0:12:03.18,0:12:04.64,Default,,0,0,0,,- (Мицухико) Иә? -(Аюми) Жоқ...
Dialogue: 0,0:12:04.72,0:12:05.55,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:12:05.64,0:12:08.76,Default,,0,0,0,,Тұрақты викториналарымызбен көңілді және көңілді болайық!
Dialogue: 0,0:12:08.85,0:12:09.72,Default,,0,0,0,,Хаха…
Dialogue: 0,0:12:09.81,0:12:12.56,Default,,0,0,0,,Олай болса, бәрі бізге қосылсын!
Dialogue: 0,0:12:12.64,0:12:13.98,Default,,0,0,0,,Гохон
Dialogue: 0,0:12:14.06,0:12:16.31,Default,,0,0,0,,Футболшылардың көліктерінің ерекшеліктері қандай?
Dialogue: 0,0:12:16.40,0:12:17.98,Default,,0,0,0,,Футбол терминінен алынған
Dialogue: 0,0:12:18.65,0:12:20.99,Default,,0,0,0,,Есікті жақсы жабу керек дейді.
Dialogue: 0,0:12:21.07,0:12:24.74,Default,,0,0,0,,Мыналардың қайсысы бұл термин?
Dialogue: 0,0:12:34.54,0:12:36.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:36.33,0:12:39.59,Default,,0,0,0,,Бұл жолы сәл қиынырақ болды ма?
Dialogue: 0,0:12:40.34,0:12:41.80,Default,,0,0,0,,Конан-кун, түсіндің бе?
Dialogue: 0,0:12:41.88,0:12:43.34,Default,,0,0,0,,Ах... а, жауап...
Dialogue: 0,0:12:43.42,0:12:44.93,Default,,0,0,0,,- (Endo) 2-саны - (Балалар) Иә?
Dialogue: 0,0:12:45.01,0:12:47.05,Default,,0,0,0,,Менің ойымша, бұл ұстайтын қол.
Dialogue: 0,0:12:47.14,0:12:49.01,Default,,0,0,0,,Есік жақсы жабылады
Dialogue: 0,0:12:49.85,0:12:52.02,Default,,0,0,0,,Ашық есік жоқ дейсіз бе?
Dialogue: 0,0:12:56.27,0:12:57.69,Default,,0,0,0,,Бұл дұрыс!
Dialogue: 0,0:12:57.77,0:13:00.27,Default,,0,0,0,,- (Соноко) Керемет Эндо! -(Ендо) Аа...
Dialogue: 0,0:13:00.36,0:13:03.36,Default,,0,0,0,,Ол тек футболда ғана емес, ақылды да.
Dialogue: 0,0:13:03.44,0:13:05.24,Default,,0,0,0,,- (Эндо) Ахаха... - (Санада) Чиссу
Dialogue: 0,0:13:05.78,0:13:07.41,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:13:07.49,0:13:09.07,Default,,0,0,0,,Такадай! Кеш емес пе?
Dialogue: 0,0:13:09.16,0:13:11.24,Default,,0,0,0,,Мен ұйықтап қалдым...
Dialogue: 0,0:13:09.16,0:13:11.24,Default,,0,0,0,,А... ол аға кім?
Dialogue: 0,0:13:11.24,0:13:11.66,Default,,0,0,0,,А... ол аға кім?
Dialogue: 0,0:13:11.74,0:13:12.87,Default,,0,0,0,,Бұл Санада.
Dialogue: 0,0:13:13.58,0:13:17.79,Default,,0,0,0,,Мен Хигоның қосалқы мүшесімін, биылғы жылы жастар қатарынан шыққан және үздік ойыншылардың бірі.
Dialogue: 0,0:13:17.88,0:13:21.46,Default,,0,0,0,,Сізде бірінші таймды елемеуге жүйкеңіз болды.
Dialogue: 0,0:13:21.55,0:13:23.96,Default,,0,0,0,,Мен балаларға жақсы емеспін.
Dialogue: 0,0:13:24.05,0:13:25.09,Default,,0,0,0,,-(Санада) Әй, балалар -(Балалар) Уау!
Dialogue: 0,0:13:25.88,0:13:27.05,Default,,0,0,0,,-(Санада) Мен қосалқы боламын. -(Балалар) А?
Dialogue: 0,0:13:27.13,0:13:29.60,Default,,0,0,0,,Өте керемет! Есте сақта
Dialogue: 0,0:13:29.68,0:13:31.01,Default,,0,0,0,,Жарайды, Санада (Санада)...
Dialogue: 0,0:13:31.64,0:13:34.77,Default,,0,0,0,,Хиде-сан, мен сені өзіме қарсылас етіп алайын деп шештім.
Dialogue: 0,0:13:34.85,0:13:35.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:35.85,0:13:39.23,Default,,0,0,0,,Оны келесі матчта шешейік.
Dialogue: 0,0:13:39.31,0:13:42.90,Default,,0,0,0,,А... Оған дейін, мен алдымен ойын ойнауым керек шығар.
Dialogue: 0,0:13:42.98,0:13:43.82,Default,,0,0,0,,Әрине.
Dialogue: 0,0:13:43.90,0:13:44.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:44.99,0:13:47.70,Default,,0,0,0,,Соғыс жариялау. Қызық.
Dialogue: 0,0:13:47.78,0:13:49.03,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:13:49.11,0:13:52.79,Default,,0,0,0,,Осы маусымның Spirits және Big арасындағы соңғы ойыны біздің үйде көрсетіледі.
Dialogue: 0,0:13:52.87,0:13:55.12,Default,,0,0,0,,Біз оны одан әрі қызықты ете береміз.
Dialogue: 0,0:13:55.20,0:13:59.12,Default,,0,0,0,,Екеуіңе сәттілік тілеймін, иә?
Dialogue: 0,0:13:59.21,0:14:00.75,Default,,0,0,0,,Эй... қарама.
Dialogue: 0,0:14:00.84,0:14:02.21,Default,,0,0,0,,Хмм, неге? Хмм?
Dialogue: 0,0:14:02.29,0:14:03.34,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:14:03.42,0:14:05.30,Default,,0,0,0,,- А... Ах... - (Ямамори) Бұл не? Сен сондай сараңсың.
Dialogue: 0,0:14:05.38,0:14:06.38,Default,,0,0,0,,Егер мен оны бір нәрсеге айналдырсам, мен оны дұрыс хабарлаймын.
Dialogue: 0,0:14:06.38,0:14:07.76,Default,,0,0,0,,Егер мен оны бір нәрсеге айналдырсам, оны дұрыс хабарлаймын.
Dialogue: 0,0:14:06.38,0:14:07.76,Default,,0,0,0,,Қ.Қ... Не?
Dialogue: 0,0:14:07.76,0:14:08.47,Default,,0,0,0,,Қ.Қ... Не?
Dialogue: 0,0:14:08.55,0:14:10.68,Default,,0,0,0,,Жасырын, сен бірінші баруың керек емес пе еді?
Dialogue: 0,0:14:10.76,0:14:11.72,Default,,0,0,0,,- (Акаги) Әй, тозақ - А?
Dialogue: 0,0:14:11.80,0:14:13.31,Default,,0,0,0,,Бұл жаман, Санада.
Dialogue: 0,0:14:13.39,0:14:16.85,Default,,0,0,0,,Енді соңғы ойын, оны Тото стадионында ойнайық.
Dialogue: 0,0:14:18.10,0:14:20.44,Default,,0,0,0,,Жасыру Оның жүгіру жолы өте керемет!
Dialogue: 0,0:14:20.52,0:14:22.82,Default,,0,0,0,,Мен жүгіруге жақсы емеспін.
Dialogue: 0,0:14:22.90,0:14:23.90,Default,,0,0,0,,баллоннан ауа ағады.
Dialogue: 0,0:14:23.98,0:14:25.53,Default,,0,0,0,,Мен J Leaguer бола алмаймын.
Dialogue: 0,0:14:25.61,0:14:27.11,Default,,0,0,0,,- (Конно) Бұл дұрыс емес - (Балалар) Иә?
Dialogue: 0,0:14:27.78,0:14:29.24,Default,,0,0,0,,Баяу ойыншылар
Dialogue: 0,0:14:29.32,0:14:31.41,Default,,0,0,0,,J лигагерлерінің арасында көп адамдар бар.
Dialogue: 0,0:14:31.49,0:14:32.83,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:14:32.91,0:14:37.08,Default,,0,0,0,,Егер сіз баяу болсаңыз, басқа ойыншылардан бұрын жүгіруді бастаңыз.
Dialogue: 0,0:14:37.16,0:14:40.96,Default,,0,0,0,,Дегенмен, ол үшін ойынның ағымын оқи білу керек...
Dialogue: 0,0:14:41.04,0:14:42.79,Default,,0,0,0,,Сіз өз пікіріңізді жақсартуыңыз керек.
Dialogue: 0,0:14:43.25,0:14:48.17,Default,,0,0,0,,Иә, ең бастысы - ойлау жылдамдығын аяқтың жылдамдығынан жылдамырақ ету.
Dialogue: 0,0:14:48.26,0:14:51.89,Default,,0,0,0,,Мен баяу болғандықтан, мен осындай күшке ие болдым ...
Dialogue: 0,0:14:51.97,0:14:53.68,Default,,0,0,0,,Белсенді адамдар көп.
Dialogue: 0,0:14:53.76,0:14:54.81,Default,,0,0,0,,Иә
Dialogue: 0,0:14:54.89,0:14:57.43,Default,,0,0,0,,Басқаларға жағымсыз болып көрінетін мінезіңіз болса да
Dialogue: 0,0:14:57.52,0:15:00.89,Default,,0,0,0,,Егер сіз оны өз бетіңізше пайдаланудың жолын тапсаңыз
Dialogue: 0,0:15:00.98,0:15:03.65,Default,,0,0,0,,Жағымды өзгертуге болатын нәрселер көп.
Dialogue: 0,0:15:03.73,0:15:07.61,Default,,0,0,0,,Байқадым, кәсіби сөздерде коннотация бар.
Dialogue: 0,0:15:07.69,0:15:09.65,Default,,0,0,0,,О, жоқ~ хахаха...
Dialogue: 0,0:15:09.74,0:15:12.11,Default,,0,0,0,,Басқа сұрағыңыз келетін нәрсе бар ма?
Dialogue: 0,0:15:12.20,0:15:13.12,Default,,0,0,0,,-Иә! -(Endo) Иә.
Dialogue: 0,0:15:13.20,0:15:14.95,Default,,0,0,0,,Маған айып соққылары бойынша бірнеше кеңестер айтыңызшы.
Dialogue: 0,0:15:15.03,0:15:18.41,Default,,0,0,0,,Сәлем! Кішкентай болсаң да, намысқойсың.
Dialogue: 0,0:15:18.50,0:15:20.58,Default,,0,0,0,,- (Endo) Бұл маңызды емес. - (Когоро) Иә?
Dialogue: 0,0:15:21.29,0:15:24.50,Default,,0,0,0,,Бізде әлі біраз уақыт бар, оны байқап көрейік.
Dialogue: 0,0:15:24.59,0:15:26.25,Default,,0,0,0,,- (Гента) Шын айтасың ба? - Иә!
Dialogue: 0,0:15:33.39,0:15:35.26,Default,,0,0,0,,Алдынан тебу
Dialogue: 0,0:15:35.35,0:15:38.22,Default,,0,0,0,,Демек, тепкеннен гөрі ысқылаған сияқты.
Dialogue: 0,0:15:43.40,0:15:44.31,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:48.94,0:15:51.57,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:15:48.94,0:15:51.57,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:51.65,0:15:52.53,Default,,0,0,0,,Эндо керемет
Dialogue: 0,0:15:52.61,0:15:54.53,Default,,0,0,0,,Мен айып добын орындадым!
Dialogue: 0,0:15:54.62,0:15:57.49,Default,,0,0,0,,4 минут бірінші таймда Гамба Осака алға шығады!
Dialogue: 0,0:15:57.58,0:16:00.25,Default,,0,0,0,,Керемет! Бұл сіз маған үйреткен айып соққысымен бірдей!
Dialogue: 0,0:16:00.33,0:16:02.00,Default,,0,0,0,,Сәлем Конан!
Dialogue: 0,0:16:02.08,0:16:03.79,Default,,0,0,0,,Сіз қай жағын жақтайсыз?
Dialogue: 0,0:16:03.87,0:16:06.71,Default,,0,0,0,,Эдокко Осака командасын қолдамауы керек.
Dialogue: 0,0:16:06.79,0:16:08.30,Default,,0,0,0,,Е? Егер төбелескің келсе, мен саған қарсы шығамын.
Dialogue: 0,0:16:08.38,0:16:11.63,Default,,0,0,0,,Иә, оны киіп, рухтарды да қолда.
Dialogue: 0,0:16:11.72,0:16:13.34,Default,,0,0,0,,Не? Өйткені...
Dialogue: 0,0:16:13.43,0:16:15.47,Default,,0,0,0,,Жарайды, мен жаңасын сатып алдым.
Dialogue: 0,0:16:16.72,0:16:19.22,Default,,0,0,0,,Үлкен Осака? Сіз, ақыр соңында...
Dialogue: 0,0:16:19.31,0:16:21.89,Default,,0,0,0,,Мені қате түсінбеңіз, маған түс ұнайды.
Dialogue: 0,0:16:21.98,0:16:23.35,Default,,0,0,0,,...Сен мүлде адал емессің.
Dialogue: 0,0:16:31.03,0:16:32.86,Default,,0,0,0,,(Өтіп бара жатқандардың айқайы)
Dialogue: 0,0:16:32.95,0:16:34.28,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:16:34.36,0:16:35.36,Default,,0,0,0,,Соңында 300-ден астам оқ аттым
Dialogue: 0,0:16:35.45,0:16:37.57,Default,,0,0,0,,Жалғастырамыз ба?
Dialogue: 0,0:16:37.66,0:16:39.54,Default,,0,0,0,,Мен сізге айтайын деп тұрған кодты шешіңіз.
Dialogue: 0,0:16:39.62,0:16:40.54,Default,,0,0,0,,Не?
Dialogue: 0,0:16:41.20,0:16:43.87,Default,,0,0,0,,«Көк бала мен көк зебра»
Dialogue: 0,0:16:43.96,0:16:45.42,Default,,0,0,0,,«Жоғарыдан жауған жаңбыр»
Dialogue: 0,0:16:45.50,0:16:48.71,Default,,0,0,0,,«Сол жақтағы ағаш - төменнен адам сол қолымен көрсететін нәрсе».
Dialogue: 0,0:16:48.79,0:16:51.13,Default,,0,0,0,,Бір минут күтіңіз, сол жақта не бар?
Dialogue: 0,0:16:51.84,0:16:52.72,Default,,0,0,0,,«Сол қолмен»
Dialogue: 0,0:16:52.80,0:16:55.30,Default,,0,0,0,,«Сол жақтағы ағаш сол күйінде көрсетілген.»
Dialogue: 0,0:16:55.38,0:16:57.18,Default,,0,0,0,,«Сол жақтағы суретте...»
Dialogue: 0,0:16:57.26,0:16:58.14,Default,,0,0,0,,Бұл сурет емес, бұл «қол»!
Dialogue: 0,0:16:58.22,0:16:59.14,Default,,0,0,0,,Жоқ, күте тұрыңыз...
Dialogue: 0,0:16:59.22,0:17:01.35,Default,,0,0,0,,Бұл ұстайтын қол.
Dialogue: 0,0:17:01.43,0:17:05.77,Default,,0,0,0,,Ху... «Сол жақтағы ағаш сол қолыңмен меңзеп тұрған ағаш».
Dialogue: 0,0:17:05.85,0:17:08.69,Default,,0,0,0,,Енді ойын басталады.
Dialogue: 0,0:17:08.77,0:17:09.94,Default,,0,0,0,,Құрметті сіз!
Dialogue: 0,0:17:10.02,0:17:12.32,Default,,0,0,0,,Егер сіз осы ойынды ұтсаңыз
Dialogue: 0,0:17:12.40,0:17:14.11,Default,,0,0,0,,Көптеген құрбандар орын алады
Dialogue: 0,0:17:14.19,0:17:15.95,Default,,0,0,0,,Хмм... Мақсаты не?
Dialogue: 0,0:17:16.03,0:17:17.78,Default,,0,0,0,,Мақсатыңды айт!
Dialogue: 0,0:17:17.87,0:17:19.91,Default,,0,0,0,,А... тезірек түсінесіз.
Dialogue: 0,0:17:19.99,0:17:21.41,Default,,0,0,0,,Сәттілік тілеймін.
Dialogue: 0,0:17:21.49,0:17:23.83,Default,,0,0,0,,Күте тұрыңыз! Мен жай түсінбеймін!
Dialogue: 0,0:17:23.91,0:17:25.41,Default,,0,0,0,,Кеңес Маған кеңес беріңіз!
Dialogue: 0,0:17:25.50,0:17:26.33,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:17:26.42,0:17:27.88,Default,,0,0,0,,Хмм... уф...
Dialogue: 0,0:17:27.96,0:17:30.88,Default,,0,0,0,,«Келесі Бейка, келесі Бейка»
Dialogue: 0,0:17:30.96,0:17:32.76,Default,,0,0,0,,Күте тұрыңыз! Сәлем...
Dialogue: 0,0:17:32.84,0:17:34.17,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:17:34.26,0:17:35.13,Default,,0,0,0,,Әкем…
Dialogue: 0,0:17:37.38,0:17:39.09,Default,,0,0,0,,Тәтті, бұзылған...
Dialogue: 0,0:17:39.18,0:17:41.14,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:18:01.12,0:18:03.87,Default,,0,0,0,,«Көк бала мен көк зебра»
Dialogue: 0,0:18:03.95,0:18:05.79,Default,,0,0,0,,«Жоғарыдан жауған жаңбыр»
Dialogue: 0,0:18:05.87,0:18:10.71,Default,,0,0,0,,«Сол жақтағы ағаш - төменнен адам сол қолымен көрсететін нәрсе».
Dialogue: 0,0:18:11.29,0:18:12.75,Default,,0,0,0,,Және кеңес
Dialogue: 0,0:18:12.84,0:18:15.55,Default,,0,0,0,,«Келесі Бейка, келесі Бейка»
Dialogue: 0,0:18:15.63,0:18:18.13,Default,,0,0,0,,Қанша оқысам да мағынасын түсінбеймін.
Dialogue: 0,0:18:18.22,0:18:19.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:19.18,0:18:22.18,Default,,0,0,0,,Инспектор Мегуре Біз жарылғыш заттарды анықтадық.
Dialogue: 0,0:18:23.06,0:18:25.89,Default,,0,0,0,,Пластикалық бомбалар қолданылды.
Dialogue: 0,0:18:25.97,0:18:28.14,Default,,0,0,0,,Телефон жарылуға орнатылды.
Dialogue: 0,0:18:28.23,0:18:29.44,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:29.52,0:18:32.73,Default,,0,0,0,,Жеңіл жарақаттар болғаны бақытым деп айтуым керек...
Dialogue: 0,0:18:32.82,0:18:35.69,Default,,0,0,0,,Біз келесі жарылыста не болатынын білмейміз.
Dialogue: 0,0:18:36.32,0:18:39.57,Default,,0,0,0,,Қылмыскерді хабардар ету уақытына 1 сағат 5 минут қалды...
Dialogue: 0,0:18:39.66,0:18:42.87,Default,,0,0,0,,Осы уақытқа дейін біз бұл кодты бұзуымыз керек.
Dialogue: 0,0:18:42.95,0:18:44.95,Default,,0,0,0,,Иә? Түсіндім, түсіндім!
Dialogue: 0,0:18:45.04,0:18:48.00,Default,,0,0,0,,Бомба Кайдо саябағына қойылды!
Dialogue: 0,0:18:48.08,0:18:49.75,Default,,0,0,0,,- (Детективтер) Иә? -(Мегуре) Кайдо саябағы?
Dialogue: 0,0:18:50.79,0:18:52.38,Default,,0,0,0,,Анықтама – тұспал
Dialogue: 0,0:18:52.46,0:18:54.67,Default,,0,0,0,,«Келесі Бейка, келесі Бейка»
Dialogue: 0,0:18:54.75,0:18:56.55,Default,,0,0,0,,Нені айтып тұрсың, Моури?
Dialogue: 0,0:18:56.63,0:19:00.76,Default,,0,0,0,,Бұл Toto Loop желісіндегі Бейка станциясына дейін бір аялдама.
Dialogue: 0,0:19:00.84,0:19:04.64,Default,,0,0,0,,Басқаша айтқанда, ол Кавайто станциясын немесе Мидоридай станциясын көрсетеді.
Dialogue: 0,0:19:04.72,0:19:08.06,Default,,0,0,0,,Кавайто станциясына жақын орналасқан Кавайто саябағында,
Dialogue: 0,0:19:08.14,0:19:09.56,Default,,0,0,0,,Үлкен фонтан бар...
Dialogue: 0,0:19:09.64,0:19:12.52,Default,,0,0,0,,- (Такаги) Субұрқақ? -(Мегуре) Бұл «жоғарыдан жауған жаңбыр» ма?
Dialogue: 0,0:19:12.60,0:19:17.19,Default,,0,0,0,,Иә, сол субұрқақтың астында бала мен зебра мүсіні бар.
Dialogue: 0,0:19:17.28,0:19:19.74,Default,,0,0,0,,Бірақ басқа кодтар нені білдіреді?
Dialogue: 0,0:19:19.82,0:19:21.95,Default,,0,0,0,,Барған кезде білесің
Dialogue: 0,0:19:22.03,0:19:22.87,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:22.95,0:19:27.95,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:32.21,0:19:34.33,Default,,0,0,0,,- (Аюми) Ия! -(Мицухико) Бұл есептегіш.
Dialogue: 0,0:19:34.42,0:19:36.92,Default,,0,0,0,,- (Гента) Жүр! -Тамаша!
Dialogue: 0,0:19:39.97,0:19:41.18,Default,,0,0,0,,Мен – Соғысшылар корпусының капитаны Тео Магатпын.
Dialogue: 0,0:19:41.93,0:19:44.26,Default,,0,0,0,,Кет! Кешіріңіз, кетіңізші!
Dialogue: 0,0:19:44.34,0:19:45.68,Default,,0,0,0,,Кешіріңіз, өтуге рұқсат етіңіз!
Dialogue: 0,0:19:48.60,0:19:49.47,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:19:49.56,0:19:51.77,Default,,0,0,0,,- (Мегуре) Сөзсіз тас құрылым бар - (Такаги) Бірақ бұл...
Dialogue: 0,0:19:51.85,0:19:54.48,Default,,0,0,0,,Бұл зебра емес, есек, солай ма?
Dialogue: 0,0:19:54.56,0:19:57.36,Default,,0,0,0,,Хмм... кінәлі оны зебра деп ойлап қалды!
Dialogue: 0,0:19:57.44,0:19:58.86,Default,,0,0,0,,Бұл көк емес
Dialogue: 0,0:19:58.94,0:20:00.44,Default,,0,0,0,,Қылмыскерге көк болып көрінді!
Dialogue: 0,0:20:00.86,0:20:03.03,Default,,0,0,0,,- (Когоро) Тыңда, күт! -(Такаги) Ой, Моури-сан, не істеп жатырсың?
Dialogue: 0,0:20:03.11,0:20:04.45,Default,,0,0,0,,Мен бомбаны бірден табамын!
Dialogue: 0,0:20:04.53,0:20:05.41,Default,,0,0,0,,Әке!
Dialogue: 0,0:20:05.49,0:20:08.49,Default,,0,0,0,,Жарайды, біз саябақты дереу жабамыз.
Dialogue: 0,0:20:08.58,0:20:10.54,Default,,0,0,0,,Ішіндегілердің барлығын эвакуациялаңыз!
Dialogue: 0,0:20:10.62,0:20:11.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:12.08,0:20:14.67,Default,,0,0,0,,«Көк бала мен көк зебра»
Dialogue: 0,0:20:14.75,0:20:16.38,Default,,0,0,0,,«Жоғарыдан жауған жаңбыр» Иә?
Dialogue: 0,0:20:17.00,0:20:21.30,Default,,0,0,0,,«Сол жақтағы ағаш - төменнен адам сол қолымен көрсететін нәрсе».
Dialogue: 0,0:20:23.43,0:20:26.26,Default,,0,0,0,,Міне! Бомба сол жақта жатыр!
Dialogue: 0,0:20:27.05,0:20:28.72,Default,,0,0,0,,Сол ағаштың астында?
Dialogue: 0,0:20:28.81,0:20:33.06,Default,,0,0,0,,Жарайды, қалғанын бізге қалдырыңыз, Моури және басқалар, дереу сыртқа шығыңыз!
Dialogue: 0,0:20:33.64,0:20:34.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:35.94,0:20:38.07,Default,,0,0,0,,Қане, бір ұпайды артта қалдырған рухтар!
Dialogue: 0,0:20:38.15,0:20:40.03,Default,,0,0,0,,Уемура сол жаққа көтеріледі!
Dialogue: 0,0:20:40.11,0:20:41.49,Default,,0,0,0,,Доп ортаға!
Dialogue: 0,0:20:41.57,0:20:44.32,Default,,0,0,0,,Керемет крест! Акаги секіріп кетті!
Dialogue: 0,0:20:44.40,0:20:45.70,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:20:45.78,0:20:48.78,Default,,0,0,0,,Мақсат Мақсат Мақсат!
Dialogue: 0,0:20:48.87,0:20:53.50,Default,,0,0,0,,Спирттер Акаги мен Уемураның үйлесімі галстукке жетті!
Dialogue: 0,0:20:54.08,0:20:56.00,Default,,0,0,0,,- (Мицухико) Ия! -(Гента) Екеуміз де Эдоданбыз!
Dialogue: 0,0:20:56.08,0:20:59.42,Default,,0,0,0,,Күтілгендей, Хиде және Наоки алтыннан жасалған екі топ!
Dialogue: 0,0:21:00.09,0:21:01.38,Default,,0,0,0,,Бомба болған жоқ па?
Dialogue: 0,0:21:01.46,0:21:04.34,Default,,0,0,0,,Өкінішке орай, ол сол жақтағы ағаштың астында болмады.
Dialogue: 0,0:21:04.42,0:21:06.64,Default,,0,0,0,,Ал екіншісі ше? Оң жақтағы ағаш ше?
Dialogue: 0,0:21:06.72,0:21:08.60,Default,,0,0,0,,Мен сенімді болу үшін қазып көрдім.
Dialogue: 0,0:21:08.68,0:21:10.31,Default,,0,0,0,,Бомбаның көлеңкесі де, пішіні де болады...
Dialogue: 0,0:21:10.39,0:21:13.60,Default,,0,0,0,,Мен сені басқа ағаштардың астына қарап шығуды сұраймын.
Dialogue: 0,0:21:13.68,0:21:16.94,Default,,0,0,0,,Мүмкін шифрмен көрсетілген орын болды
Dialogue: 0,0:21:17.02,0:21:18.48,Default,,0,0,0,,Бұл жерде жоқ шығар
Dialogue: 0,0:21:18.56,0:21:20.90,Default,,0,0,0,,Хмм... Қандай ақымақ!
Dialogue: 0,0:21:23.44,0:21:25.03,Default,,0,0,0,,Ах, уф…!
Dialogue: 0,0:21:25.11,0:21:27.74,Default,,0,0,0,,Концессиялық трибуналар жартылай таймда шоғырланады.
Dialogue: 0,0:21:27.82,0:21:30.08,Default,,0,0,0,,Асықпасаңыз, екінші жартысы жақын арада басталады.
Dialogue: 0,0:21:30.16,0:21:33.66,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:21:33.75,0:21:36.04,Default,,0,0,0,,Ах... Бұл Раннан.
Dialogue: 0,0:21:36.62,0:21:38.38,Default,,0,0,0,,Нашар, мен ваннаға баруым керек.
Dialogue: 0,0:21:38.46,0:21:39.04,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:21:39.04,0:21:41.09,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:21:39.04,0:21:41.09,Default,,0,0,0,,Өтінемін, шығыңыз, Шиничи.
Dialogue: 0,0:21:41.17,0:21:42.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:42.09,0:21:43.59,Default,,0,0,0,,Иә, Кудо.
Dialogue: 0,0:21:43.67,0:21:44.76,Default,,0,0,0,,Мен қазір телефонға жауап бере алмаймын.
Dialogue: 0,0:21:44.84,0:21:45.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:45.97,0:21:46.01,Default,,0,0,0,,Тоннан кейін бізге не қажет екенін айтыңыз.
Dialogue: 0,0:21:46.01,0:21:48.76,Default,,0,0,0,,Тоннан кейін бізге не қажет екенін айтыңыз.
Dialogue: 0,0:21:46.01,0:21:48.76,Default,,0,0,0,,Неліктен әрқашан осылай болады?
Dialogue: 0,0:21:48.84,0:21:50.51,Default,,0,0,0,,Әдеттегідей, түссізді тек менде ғана. Уф.
Dialogue: 0,0:21:50.60,0:21:53.89,Default,,0,0,0,,Шиничи: Әкем телефон соғып, бомба туралы қоқан-лоққы жасады.
Dialogue: 0,0:21:53.97,0:21:56.77,Default,,0,0,0,,Бірақ мен кодты аша алмаймын және уақытым да жоқ.
Dialogue: 0,0:21:56.85,0:21:58.06,Default,,0,0,0,,Жүгіру Бұл менмін!
Dialogue: 0,0:21:58.15,0:21:59.06,Default,,0,0,0,,Шиничи?
Dialogue: 0,0:21:59.15,0:22:00.11,Default,,0,0,0,,Маған кодты үйретіңіз!
Dialogue: 0,0:22:00.19,0:22:01.98,Default,,0,0,0,,Иә, жарай ма? Мен айтайын
Dialogue: 0,0:22:02.07,0:22:03.23,Default,,0,0,0,,О
Dialogue: 0,0:22:06.61,0:22:10.28,Default,,0,0,0,,-де «Келесі Бейка, Келесі Бейка» деген анықтама берілген.
Dialogue: 0,0:22:10.37,0:22:12.49,Default,,0,0,0,,Бомба туралы қауіп 3:30-да айтылды.
Dialogue: 0,0:22:13.12,0:22:15.87,Default,,0,0,0,,Бар болғаны 40 минут қалды, Шиничи.
Dialogue: 0,0:22:15.95,0:22:18.42,Default,,0,0,0,,Жарайды, маған аз ғана уақыт беріңіз!
Dialogue: 0,0:22:19.25,0:22:21.75,Default,,0,0,0,,«Көк бала мен көк зебра»
Dialogue: 0,0:22:21.84,0:22:23.34,Default,,0,0,0,,«Жоғарыдан жауған жаңбыр»
Dialogue: 0,0:22:23.42,0:22:27.63,Default,,0,0,0,,«Сол жақтағы ағаш - төменнен адам сол қолымен көрсететін нәрсе».
Dialogue: 0,0:22:28.18,0:22:31.18,Default,,0,0,0,,Не? Мен бірдеңе ойлап тапқандай сезінемін
Dialogue: 0,0:22:32.01,0:22:34.97,Default,,0,0,0,,Қарғыс атсын, мен осында болдым...
Dialogue: 0,0:22:35.06,0:22:36.52,Default,,0,0,0,,Барлығы рухтар және Гамба -
Dialogue: 0,0:22:36.60,0:22:38.94,Default,,0,0,0,,Тұмар кейіпкерді білесің бе?
Dialogue: 0,0:22:39.02,0:22:41.31,Default,,0,0,0,,Рух Зебра-кун деп аталады!
Dialogue: 0,0:22:41.40,0:22:43.07,Default,,0,0,0,,Зебра теууге жақсы, солай ма?
Dialogue: 0,0:22:43.15,0:22:45.78,Default,,0,0,0,,Олай болса, сіз Гамба тұмарын білесіз бе?
Dialogue: 0,0:22:45.86,0:22:48.20,Default,,0,0,0,,Мен білемін, бұл көк!
Dialogue: 0,0:22:48.28,0:22:49.78,Default,,0,0,0,,Ол Гамба Бала деп аталады.
Dialogue: 0,0:22:49.86,0:22:52.95,Default,,0,0,0,,Керемет! Оны бәрі жақсы біледі
Dialogue: 0,0:22:53.03,0:22:54.95,Default,,0,0,0,,Gamba Boy жеңу үшін барын салады...
Dialogue: 0,0:22:55.04,0:22:58.29,Default,,0,0,0,,Зебра Гамбабой…
Dialogue: 0,0:22:59.00,0:23:00.33,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:23:06.63,0:23:07.51,Default,,0,0,0,,Міне!
Dialogue: 0,0:23:07.59,0:23:10.47,Default,,0,0,0,,«Көк бала мен көк зебра» дегеніміз не?
Dialogue: 0,0:23:10.55,0:23:11.47,Default,,0,0,0,,Гамба және спирттер —
Dialogue: 0,0:23:11.55,0:23:13.14,Default,,0,0,0,,Бұл тұмар кейіпкер туралы болды.
Dialogue: 0,0:23:13.22,0:23:17.14,Default,,0,0,0,,Ей, мен неге қарапайым нәрсені байқамадым?
Dialogue: 0,0:23:17.22,0:23:18.10,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:23:19.06,0:23:22.94,Default,,0,0,0,,Бомба осы стадионға қойылған ба?
Dialogue: 0,0:23:24.40,0:23:27.57,Default,,0,0,0,,Күте тұрыңыз, мен бір тұспал бар екеніне сенімдімін.
Dialogue: 0,0:23:29.65,0:23:32.41,Default,,0,0,0,,Иә, түсіндім!
Dialogue: 0,0:23:33.16,0:23:35.99,Default,,0,0,0,,«Жоғарыдан жауған жаңбыр» кәмпит тәжі
Dialogue: 0,0:23:36.08,0:23:38.37,Default,,0,0,0,,«Төменнен келген адамдар» - Ниннё
Dialogue: 0,0:23:38.45,0:23:40.46,Default,,0,0,0,,«Сол қол» дегенді білдіреді
Dialogue: 0,0:23:40.54,0:23:43.50,Default,,0,0,0,,«Болғанша көрсету» сол күйінде көрсету дегенді білдіреді.
Dialogue: 0,0:23:43.58,0:23:45.59,Default,,0,0,0,,«Сол жақтағы ағаш» - Кихен
Dialogue: 0,0:23:45.67,0:23:48.46,Default,,0,0,0,,Осы төрт радикалды пайдаланып әріптер құра
Dialogue: 0,0:23:48.55,0:23:50.13,Default,,0,0,0,,Көрсетілгенмен біріктірілген
Dialogue: 0,0:23:50.22,0:23:51.93,Default,,0,0,0,,«Электрондық хабарландыру тақтасы» болыңыз
Dialogue: 0,0:23:52.97,0:23:56.89,Default,,0,0,0,,Соның дәлелі ретінде «Келесі Бейка, Келесі Бейка» деген сөз
Dialogue: 0,0:23:56.97,0:24:01.60,Default,,0,0,0,,Ақпарат Toto Loop Line желісіндегі пойыз ішіндегі электронды хабарландыру тақтасында көрсетілген.
Dialogue: 0,0:24:01.69,0:24:04.48,Default,,0,0,0,,Бомба қойылғанына күмән жоқ.
Dialogue: 0,0:24:04.56,0:24:07.65,Default,,0,0,0,,Бұл Тото стадионындағы электронды хабарландыру тақтасы!
Dialogue: 0,0:24:07.73,0:24:10.49,Default,,0,0,0,,Бұл жаман. Мен оны тез тексеруім керек!
Dialogue: 0,0:24:10.57,0:24:13.53,Default,,0,0,0,,Солай болса да, кеш болды, Конан-кун.
Dialogue: 0,0:24:13.61,0:24:16.53,Default,,0,0,0,,Иә, мен адасып қалдым деп ойлаймын.
Dialogue: 0,0:24:17.08,0:24:18.58,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:24:18.66,0:24:20.45,Default,,0,0,0,,Дәрігер, көлігіңіздің кілтін беріңізші.
Dialogue: 0,0:24:20.54,0:24:21.58,Default,,0,0,0,,Конан-кун!
Dialogue: 0,0:24:21.66,0:24:22.87,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:24:22.96,0:24:24.42,Default,,0,0,0,,Жақында екінші жартысы басталады.
Dialogue: 0,0:24:24.50,0:24:26.38,Default,,0,0,0,,Жарайды, дәрігер, тезірек!
Dialogue: 0,0:24:26.46,0:24:27.88,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:24:27.96,0:24:28.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:31.13,0:24:32.59,Default,,0,0,0,,Енді екінші таймды бастау уақыты келді.
Dialogue: 0,0:24:33.51,0:24:37.14,Default,,0,0,0,,Таңғаларлығы, бірінші таймның қосымша уақытында «Спирттер» есепті теңестірді.
Dialogue: 0,0:24:37.22,0:24:39.10,Default,,0,0,0,,Екінші жартыжылдықта мүше өзгермейді
Dialogue: 0,0:24:39.18,0:24:42.02,Default,,0,0,0,,Бірінші таймның қарқынымен шабуылды жалғастыра аламыз ба?
Dialogue: 0,0:24:42.10,0:24:44.02,Default,,0,0,0,,Сонымен қатар, Гамба да ойыншыларды алмастырмайды.
Dialogue: 0,0:24:46.52,0:24:49.36,Default,,0,0,0,,Боқ... Мен көтерілетін жер жоқ па?
Dialogue: 0,0:24:54.20,0:24:55.41,Default,,0,0,0,,Иә? Міне бітті!
Dialogue: 0,0:25:00.20,0:25:01.58,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:25:04.41,0:25:06.71,Default,,0,0,0,,Кя! Ондай жерде бала!
Dialogue: 0,0:25:11.80,0:25:12.67,Default,,0,0,0,,Әй!
Dialogue: 0,0:25:13.42,0:25:14.51,Default,,0,0,0,,Жеткізу!
Dialogue: 0,0:25:15.68,0:25:17.05,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:25:17.14,0:25:18.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:20.06,0:25:20.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:22.52,0:25:24.39,Default,,0,0,0,,А... Бұл қауіпті.
Dialogue: 0,0:25:26.19,0:25:28.06,Default,,0,0,0,,Рафинья мен Кихара арасындағы матч!
Dialogue: 0,0:25:28.65,0:25:32.73,Default,,0,0,0,,Рафинья допты лақтырып жіберді, ал Эндо оны жағына кең жайды.
Dialogue: 0,0:25:32.82,0:25:35.49,Default,,0,0,0,,Такей... айқышты көтерді!
Dialogue: 0,0:25:35.57,0:25:37.03,Default,,0,0,0,,Мақсат алдында, тартысты бәсеке!
Dialogue: 0,0:25:37.11,0:25:39.99,Default,,0,0,0,,(қуаныш пен қобалжу)
Dialogue: 0,0:25:53.09,0:25:56.51,Default,,0,0,0,,Ешбір жерде емес. Яғни...
Dialogue: 0,0:25:59.93,0:26:03.47,Default,,0,0,0,,Енді Эндоны Акагидің дриблингінен қатты тексеріңіз!
Dialogue: 0,0:26:04.47,0:26:07.02,Default,,0,0,0,,Акаги: Қайтқанда, Кихарадан Шимура алға жылжиды!
Dialogue: 0,0:26:07.10,0:26:08.73,Default,,0,0,0,,Нагата жарысы!
Dialogue: 0,0:26:09.94,0:26:11.02,Default,,0,0,0,,Төгілген доппен бір-екі!
Dialogue: 0,0:26:11.11,0:26:14.11,Default,,0,0,0,,Акаги қорғанысты дриблингпен айналып өтеді!
Dialogue: 0,0:26:14.19,0:26:17.03,Default,,0,0,0,,Ішіне қара... тұр! Күзетші жұдырықтайды!
Dialogue: 0,0:26:23.62,0:26:24.49,Default,,0,0,0,,Әй!
Dialogue: 0,0:26:26.58,0:26:28.04,Default,,0,0,0,,Я...
Dialogue: 0,0:26:29.04,0:26:30.79,Default,,0,0,0,,А... А?
Dialogue: 0,0:26:31.79,0:26:32.67,Default,,0,0,0,,Не?
Dialogue: 0,0:26:34.75,0:26:38.05,Default,,0,0,0,,Ха, кездейсоқ, Кудо-кун?
Dialogue: 0,0:26:39.76,0:26:40.64,Default,,0,0,0,,Әй!
Dialogue: 0,0:26:45.43,0:26:47.52,Default,,0,0,0,,Уау, бұл ақылсыз! Ха!
Dialogue: 0,0:26:52.86,0:26:54.48,Default,,0,0,0,,Гах... гах...
Dialogue: 0,0:26:54.57,0:26:55.78,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:26:57.94,0:26:58.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:02.03,0:27:03.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:03.20,0:27:04.12,Default,,0,0,0,,О...
Dialogue: 0,0:27:04.20,0:27:05.33,Default,,0,0,0,,Не?
Dialogue: 0,0:27:07.29,0:27:10.50,Default,,0,0,0,,Spirits Eleven төрешіге қатты наразылық білдіреді, бірақ...
Dialogue: 0,0:27:10.58,0:27:12.83,Default,,0,0,0,,Чикусо бұл ПК емес пе?
Dialogue: 0,0:27:12.92,0:27:14.79,Default,,0,0,0,,Біз сол жерде бір-бірімізге соқтығысып қалдық!
Dialogue: 0,0:27:14.92,0:27:17.46,Default,,0,0,0,,Мүлдем! Хайбар мырза?
Dialogue: 0,0:27:19.76,0:27:20.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:21.38,0:27:23.85,Default,,0,0,0,,Енді допты орнатыңыз
Dialogue: 0,0:27:23.93,0:27:27.60,Default,,0,0,0,,Әрине оны тепкен адам Ясухито Эндо болды.
Dialogue: 0,0:27:33.86,0:27:34.73,Default,,0,0,0,,Әй!
Dialogue: 0,0:27:35.77,0:27:39.03,Default,,0,0,0,,2-ден 1-ге дейін шешілді! Гамба тағы да көш бастады!
Dialogue: 0,0:27:39.03,0:27:40.78,Default,,0,0,0,,2-ден 1-ге дейін шешілді! Гамба тағы да көш бастады!
Dialogue: 0,0:27:39.03,0:27:40.78,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:27:40.78,0:27:41.66,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:27:41.66,0:27:43.11,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:27:41.66,0:27:43.11,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:27:44.45,0:27:45.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:47.49,0:27:48.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:50.08,0:27:51.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:51.08,0:27:53.29,Default,,0,0,0,,Жақсы уақыт, Хайбара.
Dialogue: 0,0:27:53.38,0:27:55.46,Default,,0,0,0,,Кудо-кун, сен мұндай жерде не істеп жүрсің?
Dialogue: 0,0:27:55.54,0:27:57.17,Default,,0,0,0,,Гента мен басқалары жақын жерде емес пе?
Dialogue: 0,0:27:57.25,0:27:59.51,Default,,0,0,0,,Иә, бәрібір.
Dialogue: 0,0:28:00.26,0:28:01.13,Default,,0,0,0,,Не!
Dialogue: 0,0:28:02.51,0:28:03.39,Default,,0,0,0,,Бомба…
Dialogue: 0,0:28:03.47,0:28:05.93,Default,,0,0,0,,А, мен оны әлі растаған жоқпын.
Dialogue: 0,0:28:06.51,0:28:10.43,Default,,0,0,0,,Бұл стадионның электрондық хабарландыру тақтасы бұрмаланған болуы мүмкін...
Dialogue: 0,0:28:10.52,0:28:12.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:12.14,0:28:13.98,Default,,0,0,0,,Жаман Хайбара, қайта қоңырау шалыңыз!
Dialogue: 0,0:28:14.06,0:28:16.44,Default,,0,0,0,,Эй, Кудо-кун Кудо-кун!
Dialogue: 0,0:28:17.11,0:28:18.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:24.74,0:28:26.32,Default,,0,0,0,,Бұл күткендей болды!
Dialogue: 0,0:28:26.41,0:28:29.41,Default,,0,0,0,,Ал электронды хабарландыру тақтасы ілінетін тіректер дәл...
Dialogue: 0,0:28:29.49,0:28:32.41,Default,,0,0,0,,О, күте тұрыңыз, бұл дегеніміз...
Dialogue: 0,0:28:32.91,0:28:35.46,Default,,0,0,0,,Қылмыскердің мақсаты - бұл жігітті құлату.
Dialogue: 0,0:28:35.54,0:28:37.88,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:28:38.50,0:28:41.55,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:28:41.63,0:28:42.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:43.01,0:28:44.47,Default,,0,0,0,,Сәлеметсіз бе, Кудо-кун?
Dialogue: 0,0:28:44.55,0:28:46.43,Default,,0,0,0,,Иә? Шиничи!
Dialogue: 0,0:28:46.51,0:28:48.72,Default,,0,0,0,,Иә
Dialogue: 0,0:28:48.81,0:28:52.64,Default,,0,0,0,,Не! Тото стадионындағы электронды хабарландыру тақтасында бомба болды ма?
Dialogue: 0,0:28:52.73,0:28:54.10,Default,,0,0,0,,Тото стадионы!
Dialogue: 0,0:28:54.81,0:28:56.15,Default,,0,0,0,,Электрондық хабарландыру тақтасы?
Dialogue: 0,0:28:56.23,0:28:58.61,Default,,0,0,0,,Иә Бірден үй жағында—
Dialogue: 0,0:28:58.69,0:29:00.86,Default,,0,0,0,,Рухты қолдаушыларды эвакуациялаңыз!
Dialogue: 0,0:29:00.94,0:29:02.11,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:29:02.74,0:29:04.07,Default,,0,0,0,,Бұл бомба
Dialogue: 0,0:29:04.15,0:29:08.16,Default,,0,0,0,,Жасалуы оңай, бірақ барлығын ашуға уақытым жоқ.
Dialogue: 0,0:29:08.24,0:29:09.41,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:29:09.49,0:29:12.62,Default,,0,0,0,,Ойлан, әлі бірдеңе бар... Қолымыздан келетін нәрсе болуы керек!
Dialogue: 0,0:29:13.79,0:29:15.58,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:29:15.67,0:29:16.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:18.04,0:29:19.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:20.42,0:29:23.17,Default,,0,0,0,,Егер біз барлық бомбаларды тоқтата алмасақ...
Dialogue: 0,0:29:24.47,0:29:25.34,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:29:25.43,0:29:26.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:27.64,0:29:29.30,Default,,0,0,0,,Сәлем! Кенеттен кесіп алу деген нені білдіреді...
Dialogue: 0,0:29:29.39,0:29:31.97,Default,,0,0,0,,Нашар. Менің айтайын дегенімді мұқият тыңда.
Dialogue: 0,0:29:32.06,0:29:34.68,Default,,0,0,0,,Бомба күткендей қойылды.
Dialogue: 0,0:29:34.77,0:29:37.19,Default,,0,0,0,,Кінәлі 15:30-да.
Dialogue: 0,0:29:37.27,0:29:39.44,Default,,0,0,0,,Үй жағындағы рух қолдаушының басының үстінде
Dialogue: 0,0:29:39.52,0:29:41.02,Default,,0,0,0,,Мен электронды хабарландыру тақтасын тастаймын.
Dialogue: 0,0:29:41.11,0:29:44.49,Default,,0,0,0,,Болды... 30 минут қана қалды.
Dialogue: 0,0:29:44.57,0:29:48.53,Default,,0,0,0,,Ах, жақын арада жақтастарды эвакуациялауды бастау керек.
Dialogue: 0,0:29:48.62,0:29:51.49,Default,,0,0,0,,Гента мен оның достары бақылаудан шығып кетпеуі үшін оларды қадағалаңыз.
Dialogue: 0,0:29:51.58,0:29:53.16,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:29:53.24,0:29:54.79,Default,,0,0,0,,Кудо-кун, сен ше?
Dialogue: 0,0:29:54.87,0:29:58.00,Default,,0,0,0,,Электрондық хабарландыру тақтасының құлап кетуіне жол бермеңіз!
Dialogue: 0,0:29:58.08,0:30:00.46,Default,,0,0,0,,1-ші нүктені қайта қуып, Рух шабуылы
Dialogue: 0,0:30:00.54,0:30:02.59,Default,,0,0,0,,Шимура ішке кіреді...
Dialogue: 0,0:30:04.09,0:30:05.05,Default,,0,0,0,,Жарыс!
Dialogue: 0,0:30:05.13,0:30:08.01,Default,,0,0,0,,Итазава төгілген допты Уемураға лақтырды!
Dialogue: 0,0:30:08.09,0:30:09.97,Default,,0,0,0,,Мен жолақты соқтым!
Dialogue: 0,0:30:10.05,0:30:11.89,Default,,0,0,0,,Мен жинап жатқан адам тағы да Ақағы еді!
Dialogue: 0,0:30:11.97,0:30:13.31,Default,,0,0,0,,Акаги шешті, бүгін 2-ші пункт!
Dialogue: 0,0:30:13.31,0:30:14.22,Default,,0,0,0,,Акаги шешті, бүгін 2-ші пункт!
Dialogue: 0,0:30:13.31,0:30:14.22,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:30:14.31,0:30:15.81,Default,,0,0,0,,Рухтар байлаулы!
Dialogue: 0,0:30:15.89,0:30:17.48,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:30:17.56,0:30:19.81,Default,,0,0,0,,-(Аюми) Мен жасадым~ -(Гента) Мен жасадым, Мицухико!
Dialogue: 0,0:30:19.90,0:30:21.94,Default,,0,0,0,,Эй, Гента, ауырып тұр.
Dialogue: 0,0:30:22.02,0:30:23.27,Default,,0,0,0,,Иә? Бірдеңе дұрыс емес
Dialogue: 0,0:30:23.36,0:30:24.40,Default,,0,0,0,,Не болды?
Dialogue: 0,0:30:24.48,0:30:25.36,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:30:26.11,0:30:27.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:30:27.95,0:30:30.32,Default,,0,0,0,,Клуб қызметкерлері төрешіге бірдеңе түсіндіріп жатыр.
Dialogue: 0,0:30:30.41,0:30:31.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:30:31.95,0:30:33.33,Default,,0,0,0,,Ойын жүріп жатқанымен...
Dialogue: 0,0:30:33.41,0:30:34.62,Default,,0,0,0,,Әй, Хайбара-сан!
Dialogue: 0,0:30:34.70,0:30:37.29,Default,,0,0,0,,А, дұрыс көрдіңіз бе? сүңгуір басын жасыру
Dialogue: 0,0:30:37.87,0:30:39.04,Default,,0,0,0,,А... Ай-чан?
Dialogue: 0,0:30:39.12,0:30:40.83,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:30:40.92,0:30:44.55,Default,,0,0,0,,Құрметті келушілер, төтенше жағдай орын алды.
Dialogue: 0,0:30:44.63,0:30:45.13,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:30:45.13,0:30:46.05,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:30:45.13,0:30:46.05,Default,,0,0,0,,Рухтар жағында —
Dialogue: 0,0:30:46.13,0:30:48.34,Default,,0,0,0,,Қолдаушылардың орындық тұтынушылары
Dialogue: 0,0:30:46.13,0:30:48.34,Default,,0,0,0,,Оған Шиничидің қатысы бар шығар...
Dialogue: 0,0:30:48.34,0:30:48.42,Default,,0,0,0,,Оған Шиничидің қатысы бар шығар...
Dialogue: 0,0:30:48.42,0:30:49.01,Default,,0,0,0,,Оған Шиничидің қатысы бар шығар...
Dialogue: 0,0:30:48.42,0:30:49.01,Default,,0,0,0,,Қызметкерлер сізге бағыт-бағдар береді.
Dialogue: 0,0:30:49.01,0:30:50.09,Default,,0,0,0,,Қызметкерлер сізге бағыт-бағдар береді.
Dialogue: 0,0:30:50.09,0:30:50.59,Default,,0,0,0,,Қызметкерлер сізге бағыт-бағдар береді.
Dialogue: 0,0:30:50.09,0:30:50.59,Default,,0,0,0,,- (Ағаса) А? -(Хайбара) Бұл бомба.
Dialogue: 0,0:30:50.59,0:30:50.68,Default,,0,0,0,,- (Ағаса) Иә? -(Хайбара) Бұл бомба.
Dialogue: 0,0:30:50.68,0:30:52.30,Default,,0,0,0,,- (Ағаса) А? -(Хайбара) Бұл бомба.
Dialogue: 0,0:30:50.68,0:30:52.30,Default,,0,0,0,,Ойынға жылдам ауысыңыз
Dialogue: 0,0:30:52.30,0:30:52.39,Default,,0,0,0,,Ойынға жылдам ауысыңыз
Dialogue: 0,0:30:52.39,0:30:53.64,Default,,0,0,0,,Ойынға жылдам ауысыңыз
Dialogue: 0,0:30:52.39,0:30:53.64,Default,,0,0,0,,Кудо-кун электронды хабарландыру тақтасының бұрмаланғанын айтты...
Dialogue: 0,0:30:53.64,0:30:55.10,Default,,0,0,0,,Кудо-кун электронды хабарландыру тақтасының бұрмаланғанын айтты...
Dialogue: 0,0:30:55.18,0:30:56.98,Default,,0,0,0,,Не... не?
Dialogue: 0,0:30:57.06,0:30:58.31,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:30:58.39,0:31:01.40,Default,,0,0,0,,Аруақтар жағында қолдаушы орындары бар тұтынушылар үшін:
Dialogue: 0,0:31:01.48,0:31:03.23,Default,,0,0,0,,Қызметкерлер сізге бағыт береді...
Dialogue: 0,0:31:03.90,0:31:05.65,Default,,0,0,0,,Бірдеңе болды.
Dialogue: 0,0:31:05.73,0:31:07.44,Default,,0,0,0,,Бірақ бұл не екені маған қызық.
Dialogue: 0,0:31:07.53,0:31:09.99,Default,,0,0,0,,Жақын жерге барып, қарап шығуымыз керек пе?
Dialogue: 0,0:31:10.07,0:31:10.95,Default,,0,0,0,,- (Хайбара) Жоқ, - (Гента) Иә.
Dialogue: 0,0:31:11.53,0:31:13.24,Default,,0,0,0,,Эдогава-кун қайтып келгенше—
Dialogue: 0,0:31:13.32,0:31:15.66,Default,,0,0,0,,Тыныш бол және осында қал.
Dialogue: 0,0:31:15.74,0:31:17.91,Default,,0,0,0,,Ол бұл туралы бірдеңе жасайды.
Dialogue: 0,0:31:18.00,0:31:21.37,Default,,0,0,0,,Жарайды, қайтып келсем екен.
Dialogue: 0,0:31:23.42,0:31:24.29,Default,,0,0,0,,Жарайды
Dialogue: 0,0:31:25.88,0:31:29.42,Default,,0,0,0,,Иә, жоқ, бұл тым ұзаққа созылып жатыр.
Dialogue: 0,0:31:30.51,0:31:33.64,Default,,0,0,0,,Мен бұл бағананы қандай жағдайда да қорғауым керек.
Dialogue: 0,0:31:35.93,0:31:37.60,Default,,0,0,0,,Уақыт шегіне 10 минут қалды
Dialogue: 0,0:31:37.68,0:31:40.06,Default,,0,0,0,,Шүкір, уақытында жетеміз бе?
Dialogue: 0,0:31:40.14,0:31:42.15,Default,,0,0,0,,Мен сендерге осы орыннан жол көрсетемін.
Dialogue: 0,0:31:42.23,0:31:43.73,Default,,0,0,0,,Оны баяу қабылдаған дұрыс.
Dialogue: 0,0:31:43.81,0:31:46.52,Default,,0,0,0,,Сіз бен алдыңыздағы адам арасында бос орын қалдырмай жалғастырыңыз.
Dialogue: 0,0:31:46.61,0:31:50.70,Default,,0,0,0,,Нұсқауларды орындап, алаңның ортасына қауіпсіз жүріңіз.
Dialogue: 0,0:31:50.78,0:31:53.82,Default,,0,0,0,,Баяу жүруге болмайды. Алдыңыздағы адаммен араңызда бос орын қалдырмаңыз...
Dialogue: 0,0:31:53.91,0:31:55.53,Default,,0,0,0,,Не болды?
Dialogue: 0,0:31:55.62,0:31:58.20,Default,,0,0,0,,Білмеймін, бірақ қарапайым мәселе емес сияқты.
Dialogue: 0,0:31:58.29,0:31:59.50,Default,,0,0,0,,БАҚ
Dialogue: 0,0:31:59.58,0:32:01.58,Default,,0,0,0,,Ойынның ортасына қарай жылдам қозғалыңыз
Dialogue: 0,0:32:01.66,0:32:03.21,Default,,0,0,0,,Бірден мүмкін емес.
Dialogue: 0,0:32:03.29,0:32:04.33,Default,,0,0,0,,Жабдық ауыр.
Dialogue: 0,0:32:04.92,0:32:06.63,Default,,0,0,0,,Бұл қауіпті, сондықтан жүктеріңізді қалдырыңыз.
Dialogue: 0,0:32:06.71,0:32:07.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:08.13,0:32:09.71,Default,,0,0,0,,Ей, ақымақ болма.
Dialogue: 0,0:32:09.80,0:32:11.80,Default,,0,0,0,,Камераны артта қалдыруға мүмкіндік жоқ.
Dialogue: 0,0:32:11.88,0:32:13.59,Default,,0,0,0,,Нақты не болып жатыр?
Dialogue: 0,0:32:13.68,0:32:14.55,Default,,0,0,0,,Сол адам – бәрінен әлсіз
Dialogue: 0,0:32:14.64,0:32:16.51,Default,,0,0,0,,Аа, менде біраз қиналып жатыр, қайтып келіңізші.
Dialogue: 0,0:32:16.60,0:32:18.89,Default,,0,0,0,,Интернет! Оны қазір онлайн трансляциялаңыз!
Dialogue: 0,0:32:19.60,0:32:21.77,Default,,0,0,0,,Жарайды, мен барлық жауапкершілікті аламын.
Dialogue: 0,0:32:22.35,0:32:24.98,Default,,0,0,0,,Менің айтқанымды орындасаң болғаны!
Dialogue: 0,0:32:25.06,0:32:25.94,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:32:26.02,0:32:28.40,Default,,0,0,0,,А... Мен кете аламын!
Dialogue: 0,0:32:29.15,0:32:31.99,Default,,0,0,0,,Осы жерді басыңыз D3-D4 аймағы Эвакуация аяқталды
Dialogue: 0,0:32:32.07,0:32:34.20,Default,,0,0,0,,- (Күзетші) E орны расталды! -(Күзетші) F орын расталды!
Dialogue: 0,0:32:34.28,0:32:35.95,Default,,0,0,0,,G орындықты эвакуациялауды растау!
Dialogue: 0,0:32:36.03,0:32:36.95,Default,,0,0,0,,Барлығыңызды асығыңыз!
Dialogue: 0,0:32:37.03,0:32:37.95,Default,,0,0,0,,Тереңірек өтіңіз
Dialogue: 0,0:32:38.03,0:32:38.91,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:32:38.99,0:32:40.50,Default,,0,0,0,,Алға жылжуыңызды өтінемін
Dialogue: 0,0:32:40.58,0:32:42.04,Default,,0,0,0,,- (Күзетші) Тоқтамаңыз! -(Күзетші) Барлығың бірге болыңдар.
Dialogue: 0,0:32:42.12,0:32:44.21,Default,,0,0,0,,Балаңызды қараусыз қалдырмаңыз
Dialogue: 0,0:32:47.88,0:32:48.75,Default,,0,0,0,,Әй!
Dialogue: 0,0:32:49.42,0:32:50.30,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:32:50.38,0:32:52.72,Default,,0,0,0,,35 секунд қалды
Dialogue: 0,0:32:53.34,0:32:55.68,Default,,0,0,0,,Тағы бір нәрсе қалды, бірақ бәрі...
Dialogue: 0,0:32:56.72,0:32:58.89,Default,,0,0,0,,Өтінемін, маған беріңізші!
Dialogue: 0,0:33:07.36,0:33:08.23,Default,,0,0,0,,Әй!
Dialogue: 0,0:33:09.15,0:33:11.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:14.74,0:33:16.03,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:33:20.45,0:33:21.66,Default,,0,0,0,,Әй!
Dialogue: 0,0:33:38.59,0:33:39.60,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:33:39.68,0:33:42.52,Default,,0,0,0,,(Көрермендердің айқайы)
Dialogue: 0,0:33:42.60,0:33:43.98,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:33:44.06,0:33:45.48,Default,,0,0,0,,Сонымен... керемет!
Dialogue: 0,0:33:46.14,0:33:47.02,Default,,0,0,0,,Кудо-кун…
Dialogue: 0,0:33:48.40,0:33:50.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:50.31,0:33:53.69,Default,,0,0,0,,Хехе, енді сандар секіреді.
Dialogue: 0,0:33:53.78,0:33:55.57,Default,,0,0,0,,Эй, бұл керемет.
Dialogue: 0,0:33:55.65,0:33:57.57,Default,,0,0,0,,Электрондық хабарландыру тақтасы жарылды.
Dialogue: 0,0:33:57.66,0:33:59.12,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:33:59.20,0:34:02.03,Default,,0,0,0,,Ия, мен ақыры қолыма алдым.
Dialogue: 0,0:34:05.29,0:34:10.67,Default,,0,0,0,,Соқтығысайық!
Dialogue: 0,0:34:10.75,0:34:12.50,Default,,0,0,0,,Барлығыңыз тынышталыңыздар!
Dialogue: 0,0:34:12.59,0:34:14.63,Default,,0,0,0,,Баяу төмен түсіңіз. Баяу.
Dialogue: 0,0:34:14.71,0:34:15.80,Default,,0,0,0,,Баспаңыз!
Dialogue: 0,0:34:15.88,0:34:18.59,Default,,0,0,0,,Қазір бәрі жақсы. Жарылыс басылды.
Dialogue: 0,0:34:18.68,0:34:20.72,Default,,0,0,0,,Қауіпсіз эвакуациялау үшін
Dialogue: 0,0:34:20.80,0:34:24.02,Default,,0,0,0,,Біз сізді тәртіппен авариялық шығуға бағыттаймыз.
Dialogue: 0,0:34:24.10,0:34:27.64,Default,,0,0,0,,Сабыр сақтаңыз және қызметкерлердің нұсқауларын орындаңыз
Dialogue: 0,0:34:28.31,0:34:29.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:32.40,0:34:33.65,Default,,0,0,0,,Ол тоқтады ма?
Dialogue: 0,0:34:38.61,0:34:40.45,Default,,0,0,0,,Маған беруіңізді өтінемін!
Dialogue: 0,0:34:43.08,0:34:44.70,Default,,0,0,0,,Қауіпті, құлап жатыр...
Dialogue: 0,0:34:45.45,0:34:47.37,Default,,0,0,0,,Онда шығып, баспалдақпен жоғары өрмеле.
Dialogue: 0,0:34:47.46,0:34:49.04,Default,,0,0,0,,Әй, бұл не болды?
Dialogue: 0,0:34:49.12,0:34:50.83,Default,,0,0,0,,- (аудитория) Жарылып кете ме? - (Көрермендер) Жер сілкінісі болды ма?
Dialogue: 0,0:34:50.92,0:34:53.09,Default,,0,0,0,,Жарайды! Өтінемін, тынышталыңыз!
Dialogue: 0,0:34:53.17,0:34:54.59,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:34:54.67,0:34:55.55,Default,,0,0,0,,- (Көрермендер) Бірдеңе құлап жатыр - (Ивасада) А...
Dialogue: 0,0:35:02.60,0:35:04.01,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:35:04.10,0:35:05.97,Default,,0,0,0,,- (Мицухико) Бұл электронды хабарландыру тақтасы - (Аюми) Иә!
Dialogue: 0,0:35:06.52,0:35:08.98,Default,,0,0,0,,Бұл жаман, тез қашу керек!
Dialogue: 0,0:35:09.06,0:35:12.31,Default,,0,0,0,,Бұл мүмкін емес. Барлығы үрейленіп, қозғала алмай жатыр.
Dialogue: 0,0:35:20.36,0:35:22.03,Default,,0,0,0,,(Көрермендердің айқайы)
Dialogue: 0,0:35:29.62,0:35:31.50,Default,,0,0,0,,Шүкір, мен уақытында үлгермедім.
Dialogue: 0,0:35:31.58,0:35:33.00,Default,,0,0,0,,Шиничи…
Dialogue: 0,0:35:33.08,0:35:34.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:35:36.38,0:35:37.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:37.67,0:35:39.63,Default,,0,0,0,,Әй, тоқтады.
Dialogue: 0,0:35:39.72,0:35:41.43,Default,,0,0,0,,Уау, бұл керемет.
Dialogue: 0,0:35:45.81,0:35:47.60,Default,,0,0,0,,Кішкене ғана, бар күшіңді сал!
Dialogue: 0,0:35:49.52,0:35:51.39,Default,,0,0,0,,Жабу!
Dialogue: 0,0:36:00.11,0:36:02.41,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:36:10.29,0:36:15.17,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,0:36:23.80,0:36:25.01,Default,,0,0,0,,Я...
Dialogue: 0,0:36:36.86,0:36:40.11,Default,,0,0,0,,Сәлем, дүйсенбі, 21 қараша
Dialogue: 0,0:36:40.19,0:36:41.99,Default,,0,0,0,,«Миянея туралы ақпарат»
Dialogue: 0,0:36:42.07,0:36:44.57,Default,,0,0,0,,Кеше J лигасында қорқынышты нәрсе болды.
Dialogue: 0,0:36:44.66,0:36:47.74,Default,,0,0,0,,Бір дұрыс емес қозғалыс апатты жарылысқа әкелуі мүмкін.
Dialogue: 0,0:36:47.83,0:36:49.54,Default,,0,0,0,,Бұл матч кезінде болды...
Dialogue: 0,0:36:49.62,0:36:51.29,Default,,0,0,0,,Мына жерден қараңыз
Dialogue: 0,0:36:52.33,0:36:55.17,Default,,0,0,0,,Кешегі Tokyo Spirits пен Гамба Осака арасындағы матч кезінде.
Dialogue: 0,0:36:55.25,0:36:57.29,Default,,0,0,0,,Электронды тақта жарылып кетеді дейді.
Dialogue: 0,0:36:57.38,0:36:59.38,Default,,0,0,0,,Керемет оқиға болды.
Dialogue: 0,0:36:59.46,0:37:01.46,Default,,0,0,0,,Бақытымызға орай, зардап шеккендер жоқ.
Dialogue: 0,0:37:01.55,0:37:04.13,Default,,0,0,0,,Бәрі жақсы болды, бірақ... бұл жарылыс...
Dialogue: 0,0:37:04.22,0:37:06.14,Default,,0,0,0,,Сол атақты детектив Когоро Моури
Dialogue: 0,0:37:06.22,0:37:07.64,Default,,0,0,0,,Мен қатысқандықтан...
Dialogue: 0,0:37:07.72,0:37:09.26,Default,,0,0,0,,Кабинет алдында эстафеталық хабар бар.
Dialogue: 0,0:37:09.35,0:37:10.81,Default,,0,0,0,,Табета мырза
Dialogue: 0,0:37:10.89,0:37:13.14,Default,,0,0,0,,Иә, мұнда Мури детектив агенттігінің алдында
Dialogue: 0,0:37:13.23,0:37:15.10,Default,,0,0,0,,Менің атым Табета, мен тілшімін.
Dialogue: 0,0:37:15.19,0:37:17.40,Default,,0,0,0,,Қылмыскерден кодты сәтті ашты.
Dialogue: 0,0:37:17.48,0:37:19.44,Default,,0,0,0,,Детектив Моури Дж.Лиганы сақтап қалды.
Dialogue: 0,0:37:20.02,0:37:21.73,Default,,0,0,0,,Сол үлкен жарылыс алдында
Dialogue: 0,0:37:21.82,0:37:23.86,Default,,0,0,0,,Кеңсе алдындағы бұл жерді де қылмыскер...
Dialogue: 0,0:37:23.95,0:37:25.20,Default,,0,0,0,,Сәлеметсіз бе, инспектор.
Dialogue: 0,0:37:25.28,0:37:27.62,Default,,0,0,0,,Келгеніңіз үшін рахмет.
Dialogue: 0,0:37:27.70,0:37:31.62,Default,,0,0,0,,Ақыр соңында, сыртқа бір қадам бассаңыз да, ақпарат құралдары шу болады...
Dialogue: 0,0:37:31.70,0:37:33.41,Default,,0,0,0,,Сіз кодты бұздыңыз ба?
Dialogue: 0,0:37:33.50,0:37:36.04,Default,,0,0,0,,Мен мұны білмей тұрып Мори-сан болдым.
Dialogue: 0,0:37:36.12,0:37:38.00,Default,,0,0,0,,- (Когоро) Эхехе... - (Мегуре) Жарайды, әдеттегідей—
Dialogue: 0,0:37:38.08,0:37:40.50,Default,,0,0,0,,Кудо-кун маған оның атын беруімді өтінді.
Dialogue: 0,0:37:40.59,0:37:44.17,Default,,0,0,0,,Тұрып сөйлесудің қажеті жоқ, сондықтан орынға отырыңыз.
Dialogue: 0,0:37:44.26,0:37:45.84,Default,,0,0,0,,- (Мегуре) Иә, рахмет - Иә!
Dialogue: 0,0:37:45.93,0:37:46.80,Default,,0,0,0,,Әй, балақай!
Dialogue: 0,0:37:46.88,0:37:48.43,Default,,0,0,0,,- (Мегуре) Айтпақшы, Мори-кун - (Когоро) Хмм...
Dialogue: 0,0:37:48.51,0:37:49.85,Default,,0,0,0,,Кінәлі туралы
Dialogue: 0,0:37:49.93,0:37:52.01,Default,,0,0,0,,Сіз бірдеңе байқағаныңызды естідім бе?
Dialogue: 0,0:37:52.10,0:37:55.27,Default,,0,0,0,,Аға, мен емес байқадым.
Dialogue: 0,0:37:55.35,0:37:57.65,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:37:57.73,0:37:58.73,Default,,0,0,0,,Конан-кун?
Dialogue: 0,0:37:58.81,0:38:01.48,Default,,0,0,0,,Бұл жігіттің қылмыскердің телефон қоңырауы туралы.
Dialogue: 0,0:38:01.57,0:38:04.03,Default,,0,0,0,,Ол Ран екеумізден сұрай берді.
Dialogue: 0,0:38:04.11,0:38:05.19,Default,,0,0,0,,Эххехе…
Dialogue: 0,0:38:05.28,0:38:08.36,Default,,0,0,0,,Мен Шиничи-чанға айтқым келді.
Dialogue: 0,0:38:08.45,0:38:11.12,Default,,0,0,0,,Оған шынымен де мән берген сияқты.
Dialogue: 0,0:38:11.20,0:38:13.54,Default,,0,0,0,,Айтпақшы, не байқадың?
Dialogue: 0,0:38:13.62,0:38:16.46,Default,,0,0,0,,Бұл қылмыскердің қартқа айтқан сөздері...
Dialogue: 0,0:38:17.04,0:38:18.62,Default,,0,0,0,,Бұл сурет емес, бұл «қол»!
Dialogue: 0,0:38:18.71,0:38:20.54,Default,,0,0,0,,Бұл ұстайтын қол.
Dialogue: 0,0:38:21.13,0:38:23.50,Default,,0,0,0,,Мен бұл сөздерді бұрын естігенмін.
Dialogue: 0,0:38:24.26,0:38:25.67,Default,,0,0,0,,Конан-кун, түсіндің бе?
Dialogue: 0,0:38:25.76,0:38:27.30,Default,,0,0,0,,А... а, жауап...
Dialogue: 0,0:38:27.38,0:38:28.26,Default,,0,0,0,,- (Endo) 2-саны - (Балалар) Иә?
Dialogue: 0,0:38:28.84,0:38:30.18,Default,,0,0,0,,Қолды ұстау
Dialogue: 0,0:38:31.01,0:38:32.64,Default,,0,0,0,,Ол міндетті түрде ұстанады.
Dialogue: 0,0:38:32.72,0:38:34.72,Default,,0,0,0,,Әдетте «қолмен ұстау» деп аталады
Dialogue: 0,0:38:34.81,0:38:35.68,Default,,0,0,0,,Мен айтпаймын.
Dialogue: 0,0:38:35.77,0:38:36.81,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:38:36.89,0:38:38.85,Default,,0,0,0,,Қылмыскер қарттың жауабына тітіркенді.
Dialogue: 0,0:38:38.94,0:38:41.19,Default,,0,0,0,,Мен ойланбастан айттым.
Dialogue: 0,0:38:41.27,0:38:43.65,Default,,0,0,0,,Таныс сөз тіркестерін қолданыңыз
Dialogue: 0,0:38:43.73,0:38:45.65,Default,,0,0,0,,Олай болса, бұл қылмыскердің қателігі.
Dialogue: 0,0:38:45.74,0:38:46.57,Default,,0,0,0,,Иә
Dialogue: 0,0:38:46.65,0:38:49.91,Default,,0,0,0,,Сонымен, Эндоның сөзін қашан естідің?
Dialogue: 0,0:38:49.99,0:38:50.91,Default,,0,0,0,,Ечен
Dialogue: 0,0:38:51.57,0:38:54.04,Default,,0,0,0,,Сол кезде ойында болған J Leaguer-мен.
Dialogue: 0,0:38:54.12,0:38:56.41,Default,,0,0,0,,Бізден басқа 4 күдікті бар.
Dialogue: 0,0:38:57.33,0:38:58.50,Default,,0,0,0,,Синдзо Ямамори
Dialogue: 0,0:38:59.29,0:39:00.58,Default,,0,0,0,,Каору Кода
Dialogue: 0,0:39:01.17,0:39:02.50,Default,,0,0,0,,Риосуке Сакаки
Dialogue: 0,0:39:03.04,0:39:04.59,Default,,0,0,0,,Кейичиро Мотура
Dialogue: 0,0:39:05.25,0:39:10.05,Default,,0,0,0,,Жоғарыда аталған төрт адам менің тергеу барысында пайда болған күдіктілер.
Dialogue: 0,0:39:10.13,0:39:11.59,Default,,0,0,0,,- Тағы бір адам бар - (Когоро) Иә?
Dialogue: 0,0:39:11.68,0:39:14.01,Default,,0,0,0,,Сол кезде жақын жерде тағы бір адам отырды...
Dialogue: 0,0:39:14.97,0:39:16.85,Default,,0,0,0,,Казумаса Накаока сонда болды.
Dialogue: 0,0:39:17.39,0:39:20.85,Default,,0,0,0,,Ах, Казумаса Накаока, бұл Қарлы ұлттық саябақтан ба?
Dialogue: 0,0:39:21.44,0:39:22.69,Default,,0,0,0,,Такаги-кун, сен білесің бе?
Dialogue: 0,0:39:22.77,0:39:27.28,Default,,0,0,0,,Иә, үш жыл бұрын үлкен ұлым мені көруге шақырды.
Dialogue: 0,0:39:27.36,0:39:31.53,Default,,0,0,0,,Қалың қарға байланысты жоспарланған 2:05 басталу уақыты айтарлықтай кешіктірілді.
Dialogue: 0,0:39:31.61,0:39:34.83,Default,,0,0,0,,Егер есімде дұрыс болса, басталуы 3:40-та болды.
Dialogue: 0,0:39:34.91,0:39:37.87,Default,,0,0,0,,Ойын 0-0 есебімен овертаймға өтеді.
Dialogue: 0,0:39:37.95,0:39:40.75,Default,,0,0,0,,4 минут қалғанда пенальти сериясы аяқталды.
Dialogue: 0,0:39:40.83,0:39:43.21,Default,,0,0,0,,Накаока жеңіс голын соғады
Dialogue: 0,0:39:43.29,0:39:46.59,Default,,0,0,0,,Ол 6:10-ға дейін аяқталды.
Dialogue: 0,0:39:47.76,0:39:50.47,Default,,0,0,0,,Накаоканы қоссаңыз, 5 күдікті бар.
Dialogue: 0,0:39:50.55,0:39:55.01,Default,,0,0,0,,Жарайды, олардың бір сөзді кездейсоқ айтуы мүмкін емес.
Dialogue: 0,0:39:55.10,0:39:57.68,Default,,0,0,0,,Егер қылмыскердің мақсаты маған қарсы шығу болса ше?
Dialogue: 0,0:39:57.77,0:40:01.02,Default,,0,0,0,,Жақында қандай ерекше оқиғалар мен адамдарды кездестірдіңіз?
Dialogue: 0,0:40:01.10,0:40:03.15,Default,,0,0,0,,Тек сол футбол мектебі бар.
Dialogue: 0,0:40:03.23,0:40:07.78,Default,,0,0,0,,Жарайды, сол бес адам туралы тезірек білейік.
Dialogue: 0,0:40:07.86,0:40:10.19,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:40:21.37,0:40:23.42,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:40:29.84,0:40:32.55,Default,,0,0,0,,Конан-кун атап өткен бес адамға қатысты—
Dialogue: 0,0:40:32.63,0:40:34.14,Default,,0,0,0,,Мен оны бірден қарап шықтым.
Dialogue: 0,0:40:34.22,0:40:35.43,Default,,0,0,0,,Ширатори-кун
Dialogue: 0,0:40:35.51,0:40:39.14,Default,,0,0,0,,Иә, біріншіден, Ямамори мырза, осы жарылыс оқиғасына қатысты—
Dialogue: 0,0:40:39.85,0:40:41.56,Default,,0,0,0,,Бағдарлама аудиториясының рейтингі жоғарылайды
Dialogue: 0,0:40:41.64,0:40:43.85,Default,,0,0,0,,Сіз менеджер лауазымына төмендеу қиындығынан құтылған сияқтысыз.
Dialogue: 0,0:40:44.44,0:40:46.31,Default,,0,0,0,,Дәл солай болды.
Dialogue: 0,0:40:46.98,0:40:48.48,Default,,0,0,0,,Келесі, Кода мырза
Dialogue: 0,0:40:48.57,0:40:50.73,Default,,0,0,0,,Ол да кешегі фотосуретте
Dialogue: 0,0:40:50.82,0:40:53.32,Default,,0,0,0,,Әлеуметтік мәселелер бөліміне қайта оралуға бір қадам жақындаған сияқтымыз.
Dialogue: 0,0:40:53.40,0:40:55.99,Default,,0,0,0,,Бұл да оқиғаның арқасында.
Dialogue: 0,0:40:56.57,0:40:58.03,Default,,0,0,0,,Келесі, Сакаки мырза
Dialogue: 0,0:40:58.12,0:41:00.37,Default,,0,0,0,,Қазіргі уақытта, әсіресе Тото стадионында.
Dialogue: 0,0:41:00.45,0:41:02.20,Default,,0,0,0,,Жарылыс жасаудың себебі табылмады
Dialogue: 0,0:41:02.83,0:41:04.58,Default,,0,0,0,,Алайда қылмыскердің мотиві
Dialogue: 0,0:41:04.67,0:41:08.17,Default,,0,0,0,,Мори мырзаға қарсы арандатушылық әрекеттен басталғанын ескерсек...
Dialogue: 0,0:41:08.25,0:41:09.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:09.25,0:41:11.55,Default,,0,0,0,,Сакаки мырза университетте оқып жүрген кезінде автогол соқты.
Dialogue: 0,0:41:11.63,0:41:13.22,Default,,0,0,0,,Мен Моури-санның сені мазақ еткенін естідім.
Dialogue: 0,0:41:13.30,0:41:14.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:15.18,0:41:17.43,Default,,0,0,0,,Ах! Бұл Сакакидің өз голы!
Dialogue: 0,0:41:18.01,0:41:21.14,Default,,0,0,0,,Аа... мен сені мазақ етейін деген жоқпын...
Dialogue: 0,0:41:21.22,0:41:23.64,Default,,0,0,0,,Ол күлді.
Dialogue: 0,0:41:23.73,0:41:26.02,Default,,0,0,0,,Жарайды, жүзіңе күліп тұрсаң да, іштей
Dialogue: 0,0:41:26.10,0:41:28.27,Default,,0,0,0,,...Бұл рас.
Dialogue: 0,0:41:28.36,0:41:29.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:29.94,0:41:31.48,Default,,0,0,0,,Келесі, Мотура мырза
Dialogue: 0,0:41:31.57,0:41:34.45,Default,,0,0,0,,Менің жалғыз ұлым Чифуми осы жылдың тамыз айында келді.
Dialogue: 0,0:41:34.53,0:41:36.86,Default,,0,0,0,,J Лигасының ойыны Тото стадионында өтті.
Dialogue: 0,0:41:36.95,0:41:39.49,Default,,0,0,0,,Теледидардан Жұлдыздар ойынын көргеннен кейін
Dialogue: 0,0:41:39.58,0:41:40.41,Default,,0,0,0,,Ұстаманың болуы...
Dialogue: 0,0:41:40.49,0:41:41.20,Default,,0,0,0,,А...
Dialogue: 0,0:41:41.20,0:41:41.58,Default,,0,0,0,,А...
Dialogue: 0,0:41:41.20,0:41:41.58,Default,,0,0,0,,Мені жедел жәрдеммен Тото ауруханасына жеткізді.
Dialogue: 0,0:41:41.58,0:41:43.62,Default,,0,0,0,,Мені жедел жәрдеммен Тото ауруханасына жеткізді.
Dialogue: 0,0:41:44.25,0:41:46.58,Default,,0,0,0,,Емделмей қайтыс болғаны белгілі болды.
Dialogue: 0,0:41:47.33,0:41:48.29,Default,,0,0,0,,Хмм
Dialogue: 0,0:41:48.38,0:41:51.55,Default,,0,0,0,,Тото стадионындағы жедел жәрдем...
Dialogue: 0,0:41:51.63,0:41:53.84,Default,,0,0,0,,Иә? ше? Моури-кун
Dialogue: 0,0:41:53.92,0:41:56.01,Default,,0,0,0,,Жоқ, бірдеңе есіме түскендей...
Dialogue: 0,0:41:56.09,0:41:56.97,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:41:57.05,0:41:58.43,Default,,0,0,0,,Егер сіз әмияны да, оны да жібермесеңіз, мен қатты қиындыққа тап боламын.
Dialogue: 0,0:41:58.51,0:41:59.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:59.47,0:42:01.35,Default,,0,0,0,,Бұл болған сияқты, бірақ олай болмаған шығар.
Dialogue: 0,0:42:01.43,0:42:02.93,Default,,0,0,0,,Бұл менің қиялым ғана.
Dialogue: 0,0:42:03.02,0:42:03.89,Default,,0,0,0,,Ей!
Dialogue: 0,0:42:03.97,0:42:05.89,Default,,0,0,0,,Шатастырушы реакция
Dialogue: 0,0:42:03.97,0:42:05.89,Default,,0,0,0,,Жақсылап ойлан, әке!
Dialogue: 0,0:42:07.65,0:42:08.77,Default,,0,0,0,,Соңында, Накаока мырза
Dialogue: 0,0:42:09.77,0:42:11.15,Default,,0,0,0,,3 жыл бұрын ақпан
Dialogue: 0,0:42:11.23,0:42:12.78,Default,,0,0,0,,Мотоцикл апатынан кейін
Dialogue: 0,0:42:12.86,0:42:15.74,Default,,0,0,0,,Бірден ота жасалып, алты ай бойы реабилитациядан өтті.
Dialogue: 0,0:42:15.82,0:42:18.57,Default,,0,0,0,,Мен жалғастырдым, бірақ сол аяғым ешқашан бұрынғыдай болмады.
Dialogue: 0,0:42:18.66,0:42:20.74,Default,,0,0,0,,Ұсынысты Spirits жойды.
Dialogue: 0,0:42:20.82,0:42:21.70,Default,,0,0,0,,А...
Dialogue: 0,0:42:21.78,0:42:23.08,Default,,0,0,0,,Аруақтар үшін?
Dialogue: 0,0:42:23.16,0:42:27.67,Default,,0,0,0,,Иә, содан кейін мен футболды тастап, Оңтүстік Америкаға жалғыз бардым.
Dialogue: 0,0:42:27.75,0:42:29.54,Default,,0,0,0,,Бір жылдан кейін өткен жылдың тамыз айында Жапонияға оралды
Dialogue: 0,0:42:30.50,0:42:31.88,Default,,0,0,0,,Гунмадағы отбасылық үйге оралу
Dialogue: 0,0:42:31.96,0:42:34.21,Default,,0,0,0,,Мотоциклде қайталанатын ұқыпсыз әрекет және т.б.
Dialogue: 0,0:42:34.30,0:42:36.30,Default,,0,0,0,,Ол өрескел өмір кешкен сияқты.
Dialogue: 0,0:42:36.38,0:42:40.14,Default,,0,0,0,,Қорытындылай келе, Ямамори және Кода мырзалар
Dialogue: 0,0:42:40.22,0:42:43.18,Default,,0,0,0,,Тото стадионын жарып жіберудің басты себебі бар.
Dialogue: 0,0:42:43.26,0:42:45.27,Default,,0,0,0,,Мен бомбаны оңай қоя алатындай күйдемін.
Dialogue: 0,0:42:45.85,0:42:47.98,Default,,0,0,0,,Оны өз бетінше жасап, өзі орындағанын елестету қиын.
Dialogue: 0,0:42:48.06,0:42:51.27,Default,,0,0,0,,Сакаки мырзаны да өз мақсаты үшін мазақ етті.
Dialogue: 0,0:42:51.36,0:42:55.73,Default,,0,0,0,,Бұл Мори мырзаға бірден ренжітуге немесе сынауға әкелетінін елестету қиын.
Dialogue: 0,0:42:55.82,0:42:57.78,Default,,0,0,0,,Сондықтан мені мазақ етпе!
Dialogue: 0,0:42:58.45,0:42:59.99,Default,,0,0,0,,Мені одан да көп мазалайды
Dialogue: 0,0:43:00.66,0:43:03.49,Default,,0,0,0,,Мотура мырзаның ұлының талмасы болды.
Dialogue: 0,0:43:03.58,0:43:08.04,Default,,0,0,0,,Тото стадионында өткен J Лигасының ойынын көргеннен кейін...
Dialogue: 0,0:43:08.12,0:43:10.42,Default,,0,0,0,,Иә, мен де солай сезінемін.
Dialogue: 0,0:43:10.50,0:43:13.63,Default,,0,0,0,,Алайда бұл оның Дж.Лиганы жек көретінін білдіреді.
Dialogue: 0,0:43:13.71,0:43:14.96,Default,,0,0,0,,Бұл мүмкін емес еді
Dialogue: 0,0:43:15.05,0:43:17.76,Default,,0,0,0,,Оның ұлыңыздың өліміне қатысы жоқ.
Dialogue: 0,0:43:17.84,0:43:19.72,Default,,0,0,0,,Иә... иә...
Dialogue: 0,0:43:19.80,0:43:22.68,Default,,0,0,0,,, мәселе соңында Накаока мырза.
Dialogue: 0,0:43:22.76,0:43:26.10,Default,,0,0,0,,Гунма префектуралық полициясының инспекторы Ямамураның айғақтарына сәйкес...
Dialogue: 0,0:43:26.77,0:43:28.39,Default,,0,0,0,,Олай болса, абайсызда ұрысатын кез келді.
Dialogue: 0,0:43:28.48,0:43:29.85,Default,,0,0,0,,Сіз мұны мен үшін жасадыңыз.
Dialogue: 0,0:43:29.94,0:43:31.48,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:43:31.56,0:43:35.90,Default,,0,0,0,,Иә, өлетін жер іздеген жараланған қасқырдай...
Dialogue: 0,0:43:35.98,0:43:36.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:43:36.94,0:43:41.20,Default,,0,0,0,,Менің J Leaguer бола алмау себебім мотоциклімде апатқа ұшырадым.
Dialogue: 0,0:43:41.86,0:43:42.74,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:43:42.82,0:43:44.74,Default,,0,0,0,,Tokyo Spirits ұсыныстан бас тартты.
Dialogue: 0,0:43:44.83,0:43:47.16,Default,,0,0,0,,Сізге деген өшпенділік болуы әбден мүмкін.
Dialogue: 0,0:43:47.75,0:43:51.87,Default,,0,0,0,,Жоғарыда аталған себептерге байланысты мен Казумаса Накаоканы мұқият белгілеуді шештім.
Dialogue: 0,0:43:54.79,0:43:57.25,Default,,0,0,0,,Мына велосипед, тоқта!
Dialogue: 0,0:44:14.40,0:44:15.56,Default,,0,0,0,,Хмм, ах…
Dialogue: 0,0:44:16.44,0:44:18.40,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:44:19.61,0:44:21.74,Default,,0,0,0,,Сен неге менің артымнан келе жатырсың?
Dialogue: 0,0:44:21.82,0:44:23.53,Default,,0,0,0,,Мен сенің соңынан ерейін деп отырған жоқпын.
Dialogue: 0,0:44:23.61,0:44:24.53,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,0:44:25.20,0:44:27.91,Default,,0,0,0,,Олар түстен кейін дүкеннің алдында тұрды!
Dialogue: 0,0:44:27.99,0:44:28.99,Default,,0,0,0,,Мен не істедім?
Dialogue: 0,0:44:29.08,0:44:30.45,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:44:30.54,0:44:33.67,Default,,0,0,0,,Ештеңе жасамайтыныңызға көз жеткізу үшін.
Dialogue: 0,0:44:33.75,0:44:36.04,Default,,0,0,0,,Сатсу оны илеп жатыр!
Dialogue: 0,0:44:37.04,0:44:37.96,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:44:39.30,0:44:40.96,Default,,0,0,0,,Дааааа!
Dialogue: 0,0:44:41.59,0:44:42.55,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:44:43.30,0:44:44.72,Default,,0,0,0,,Казумаса Накаока
Dialogue: 0,0:44:44.80,0:44:49.22,Default,,0,0,0,,Шабуыл жасау және қызметтік міндеттерін орындауға кедергі жасау үшін қамауға алу
Dialogue: 0,0:44:52.18,0:44:54.27,Default,,0,0,0,,Не? Сіз Накаока мырзаны ұстадыңыз ба?
Dialogue: 0,0:44:54.35,0:44:56.19,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:44:56.27,0:45:01.19,Default,,0,0,0,,Мен оған жабысып тұрғанымда, ол қобалжыды да, мені ұра бастады.
Dialogue: 0,0:45:01.28,0:45:03.24,Default,,0,0,0,,Бүгін таңертең мен тынышталған кезде,
Dialogue: 0,0:45:03.32,0:45:04.66,Default,,0,0,0,,Мен сіздің әңгімеңізді естідім...
Dialogue: 0,0:45:05.28,0:45:08.91,Default,,0,0,0,,Аруақтарға кек жоқ сияқты.
Dialogue: 0,0:45:09.41,0:45:10.33,Default,,0,0,0,,Не?
Dialogue: 0,0:45:10.41,0:45:11.29,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:45:12.04,0:45:16.17,Default,,0,0,0,,Спирттермен жұмыс ұсынысынан бас тартуға келгенде...
Dialogue: 0,0:45:16.25,0:45:18.67,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:45:18.75,0:45:21.46,Default,,0,0,0,,Бұл мүлдем қате.
Dialogue: 0,0:45:21.55,0:45:25.05,Default,,0,0,0,,Аруақтарға алғыс айту керек, Кек сақтамаймын.
Dialogue: 0,0:45:25.13,0:45:26.84,Default,,0,0,0,,Өтірік айтпа!
Dialogue: 0,0:45:26.93,0:45:27.80,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:45:28.43,0:45:31.68,Default,,0,0,0,,Бұл тіпті БАҚ білмейтін нәрсе.
Dialogue: 0,0:45:31.77,0:45:33.98,Default,,0,0,0,,Спирттер жұмыс ұсынысынан бас тартқан шығар.
Dialogue: 0,0:45:34.81,0:45:38.44,Default,,0,0,0,,Менің өтінішім онсыз істеу еді.
Dialogue: 0,0:45:38.94,0:45:40.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:40.19,0:45:41.40,Default,,0,0,0,,Мотоцикл апатынан кейін
Dialogue: 0,0:45:42.44,0:45:46.70,Default,,0,0,0,,Операция және оңалту шығындары үшін төленген спирттер.
Dialogue: 0,0:45:46.78,0:45:50.87,Default,,0,0,0,,Ал менің сол аяғым толық қалпына келмеді.
Dialogue: 0,0:45:50.95,0:45:52.87,Default,,0,0,0,,Келісім-шартқа қол қоюға болатынын айтты.
Dialogue: 0,0:45:53.66,0:45:55.62,Default,,0,0,0,,15 минут болса да.
Dialogue: 0,0:45:55.71,0:45:58.17,Default,,0,0,0,,Ол оны алға басу ретінде пайдаланғысы келеді...
Dialogue: 0,0:45:58.25,0:45:59.71,Default,,0,0,0,,Сонда неге...
Dialogue: 0,0:45:59.79,0:46:02.00,Default,,0,0,0,,Менің мақтанышым рұқсат бермеді.
Dialogue: 0,0:46:02.71,0:46:05.63,Default,,0,0,0,,Алаңда 90 минут тұра алмайтындар үшін
Dialogue: 0,0:46:05.72,0:46:06.76,Default,,0,0,0,,Футбол ойнау...
Dialogue: 0,0:46:07.34,0:46:09.68,Default,,0,0,0,,Менің футбол ойнауға құқығым жоқ!
Dialogue: 0,0:46:09.76,0:46:12.89,Default,,0,0,0,,Әсіресе ол кәсіби J Leaguer болғандықтан.
Dialogue: 0,0:46:14.48,0:46:16.77,Default,,0,0,0,,Спирттер үшін расталған
Dialogue: 0,0:46:16.85,0:46:19.40,Default,,0,0,0,,Сондай-ақ, менің толық емес жұмыс орнының менеджерінен.
Dialogue: 0,0:46:19.48,0:46:20.90,Default,,0,0,0,,Мен мұны сенімен бірге сақтадым.
Dialogue: 0,0:46:22.73,0:46:25.74,Default,,0,0,0,,Бұл оның Оңтүстік Америкадан жіберген фотосы болса керек.
Dialogue: 0,0:46:25.82,0:46:26.74,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:46:27.32,0:46:30.99,Default,,0,0,0,,Бейне инспектор Ямамураның әңгімесінен мүлде басқаша.
Dialogue: 0,0:46:31.07,0:46:32.16,Default,,0,0,0,,Артқы жағындағы хабарлама
Dialogue: 0,0:46:36.71,0:46:38.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:46:38.37,0:46:40.79,Default,,0,0,0,,Адамдар өздері көрінетіндей емес
Dialogue: 0,0:46:40.88,0:46:45.05,Default,,0,0,0,,Мүмкін ол балалар мен футболды жақсы көретін жақсы жігіт шығар.
Dialogue: 0,0:46:46.80,0:46:50.72,Default,,0,0,0,,Бірақ егер Накаока мырза кінәлі болмаса ше?
Dialogue: 0,0:46:50.80,0:46:52.39,Default,,0,0,0,,Нақты кім?
Dialogue: 0,0:46:53.10,0:46:54.97,Default,,0,0,0,,Әй, қазір ойлап қарасам, сол кез!
Dialogue: 0,0:46:55.81,0:46:57.43,Default,,0,0,0,,«Сугинами спорт саябағы»
Dialogue: 0,0:46:58.60,0:47:00.90,Default,,0,0,0,,«К.К.
Dialogue: 0,0:47:01.65,0:47:03.90,Default,,0,0,0,,«Қ.Қ» деген кім?
Dialogue: 0,0:47:14.83,0:47:18.87,Default,,0,0,0,,Мен бәрібір мұнда келдім, бірақ...
Dialogue: 0,0:47:18.96,0:47:20.79,Default,,0,0,0,,«Қ.Қ»?
Dialogue: 0,0:47:20.87,0:47:21.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:29.17,0:47:31.09,Default,,0,0,0,,А, ол адам...
Dialogue: 0,0:47:31.84,0:47:33.85,Default,,0,0,0,,Қайырлы таң, ерте келдің, балам.
Dialogue: 0,0:47:34.39,0:47:36.27,Default,,0,0,0,,Ах... Қайырлы таң.
Dialogue: 0,0:47:38.18,0:47:42.23,Default,,0,0,0,,Қарасам, «Қ.Қ» – Казу патша!
Dialogue: 0,0:47:42.31,0:47:44.57,Default,,0,0,0,,Бұл Томойоши Миура туралы болды!
Dialogue: 0,0:47:46.48,0:47:48.03,Default,,0,0,0,,Ум... кешіріңіз!
Dialogue: 0,0:47:49.49,0:47:50.40,Default,,0,0,0,,Бұл не, бала?
Dialogue: 0,0:47:50.95,0:47:54.24,Default,,0,0,0,,Сіз Каору Коданы білесіз бе? Ничиури Шимбун
Dialogue: 0,0:47:54.91,0:47:57.08,Default,,0,0,0,,Каору Кода? Күндізгі сатылым ба?
Dialogue: 0,0:47:57.54,0:48:00.04,Default,,0,0,0,,А... қайдан іздедің?
Dialogue: 0,0:48:00.12,0:48:02.67,Default,,0,0,0,,Менің мұнда кейде өз бетімше жаттығатынымды білесіз бе?
Dialogue: 0,0:48:04.71,0:48:06.96,Default,,0,0,0,,Ол мен оның суретін түсіре аламын ба деп сұрады.
Dialogue: 0,0:48:07.50,0:48:09.01,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:48:09.09,0:48:10.42,Default,,0,0,0,,-Бірақ мен бас тарттым -Не?
Dialogue: 0,0:48:11.55,0:48:14.01,Default,,0,0,0,,Мен кәсіпқоймын, сондықтан мен...
Dialogue: 0,0:48:14.09,0:48:16.01,Default,,0,0,0,,Сіз матчта төбелесіп жатқаныңызды суретке түсіргенімді қалайсыз, солай ма?
Dialogue: 0,0:48:17.01,0:48:19.47,Default,,0,0,0,,Әсіресе мен гол соққанда.
Dialogue: 0,0:48:20.35,0:48:21.23,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:48:22.06,0:48:24.44,Default,,0,0,0,,Өйткені, оның оқиғаға еш қатысы жоқ.
Dialogue: 0,0:48:24.52,0:48:25.44,Default,,0,0,0,,-Иә! -Хмм?
Dialogue: 0,0:48:26.69,0:48:28.15,Default,,0,0,0,,Бала, сен футболды ұнатасың ба?
Dialogue: 0,0:48:28.23,0:48:29.11,Default,,0,0,0,,Иә
Dialogue: 0,0:48:29.19,0:48:31.78,Default,,0,0,0,,-Олай болса... -Ой...
Dialogue: 0,0:48:32.36,0:48:33.24,Default,,0,0,0,,Бірге орындаймыз ба?
Dialogue: 0,0:48:33.86,0:48:34.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:48:34.78,0:48:40.12,Default,,0,0,0,,♪～
Dialogue: 0,0:48:57.39,0:48:58.26,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:49:01.56,0:49:02.52,Default,,0,0,0,,Бұлай етпе, балам.
Dialogue: 0,0:49:03.19,0:49:05.90,Default,,0,0,0,,-Рахмет -Жарайды, жүгір!
Dialogue: 0,0:49:24.58,0:49:25.46,Default,,0,0,0,,Әй!
Dialogue: 0,0:49:28.09,0:49:29.46,Default,,0,0,0,,Келесі түсірілім!
Dialogue: 0,0:49:31.00,0:49:31.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:49:37.09,0:49:37.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:49:42.31,0:49:44.23,Default,,0,0,0,,Голассо! Керемет гол!
Dialogue: 0,0:49:44.31,0:49:45.81,Default,,0,0,0,,Хаха
Dialogue: 0,0:49:46.48,0:49:47.85,Default,,0,0,0,,Бұл жақсы соққы болды, балам.
Dialogue: 0,0:49:47.94,0:49:48.77,Default,,0,0,0,,Кешірім сұрау керек адам мен болар едім. Сіз жақсысыз ба?
Dialogue: 0,0:49:49.94,0:49:51.44,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:49:51.53,0:49:53.15,Default,,0,0,0,,Хехе... хехе...
Dialogue: 0,0:49:54.70,0:49:59.70,Default,,0,0,0,,～♪
Dialogue: 0,0:50:12.25,0:50:13.92,Default,,0,0,0,,Уф, суық...
Dialogue: 0,0:50:14.01,0:50:16.88,Default,,0,0,0,,...Конан-кун, қайда бардың?
Dialogue: 0,0:50:21.39,0:50:22.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:22.76,0:50:25.85,Default,,0,0,0,,Таңертең ерте не болды деп таң қаламын
Dialogue: 0,0:50:25.93,0:50:28.06,Default,,0,0,0,,Мүмкін басқа ескерту шығар?
Dialogue: 0,0:50:30.27,0:50:32.61,Default,,0,0,0,,Не, әкеңе пошта?
Dialogue: 0,0:50:32.69,0:50:33.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:34.99,0:50:35.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:37.28,0:50:38.82,Default,,0,0,0,,Бұл...
Dialogue: 0,0:50:39.41,0:50:40.28,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:50:41.16,0:50:42.41,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:50:43.79,0:50:45.00,Default,,0,0,0,,-Бала -Ах
Dialogue: 0,0:50:45.08,0:50:45.91,Default,,0,0,0,,- (Ит иесі) Уау... - Иә.
Dialogue: 0,0:50:46.58,0:50:49.46,Default,,0,0,0,,Бүгін таңертең маған көмектескеніңіз үшін, тәжірибелік әріптесім болғаныңыз үшін рахмет.
Dialogue: 0,0:50:49.54,0:50:51.33,Default,,0,0,0,,Оң қолымен теңдеулерді шешіп отыр
Dialogue: 0,0:50:51.42,0:50:52.29,Default,,0,0,0,,Оның мінезі соншалықты тартымды, және
Dialogue: 0,0:50:53.71,0:50:55.34,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:50:56.05,0:50:59.30,Default,,0,0,0,,Әй, білезік! рақмет сізге!
Dialogue: 0,0:50:59.89,0:51:01.85,Default,,0,0,0,,Ол екінші бала.
Dialogue: 0,0:51:01.93,0:51:04.60,Default,,0,0,0,,Менің ойымша, алдыңғы баланың қызыл білезігі бар еді.
Dialogue: 0,0:51:04.68,0:51:05.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:06.18,0:51:08.94,Default,,0,0,0,,Менің ойымша, бұл 14-15 жыл бұрын болды.
Dialogue: 0,0:51:09.02,0:51:12.15,Default,,0,0,0,,Мен өз жасымдағы баламен жаттықтым.
Dialogue: 0,0:51:12.56,0:51:14.61,Default,,0,0,0,,Ол бала да тамаша соққы жасады.
Dialogue: 0,0:51:15.19,0:51:17.65,Default,,0,0,0,,Бұл бала қазір J Leaguer ба?
Dialogue: 0,0:51:17.74,0:51:21.53,Default,,0,0,0,,Кел, мен сенің атыңды сұрамадым.
Dialogue: 0,0:51:21.62,0:51:25.83,Default,,0,0,0,,Егер мен әлі де футбол ойнайтын болсам, мен J Leaguer болуы мүмкін.
Dialogue: 0,0:51:26.58,0:51:28.41,Default,,0,0,0,,Олай болса үйге қайтқанда абай болыңыз.
Dialogue: 0,0:51:28.50,0:51:29.54,Default,,0,0,0,,Иә
Dialogue: 0,0:51:31.96,0:51:32.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:38.88,0:51:39.84,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:51:39.93,0:51:41.13,Default,,0,0,0,,- (Ямамори) Танысқаныма қуаныштымын - (Әріптес) Оу
Dialogue: 0,0:51:41.97,0:51:45.35,Default,,0,0,0,,А, күте тұрыңыз! Қайда қарап тұрсың? Ауырады...
Dialogue: 0,0:51:45.43,0:51:46.35,Default,,0,0,0,,- (Каору) Ах... - (Ямамори) Ауырды...
Dialogue: 0,0:51:46.43,0:51:48.06,Default,,0,0,0,,- (Каору) Ямамори мырза - (Ямамори) А?
Dialogue: 0,0:51:48.14,0:51:50.10,Default,,0,0,0,,Ах Каору-чан
Dialogue: 0,0:51:50.19,0:51:52.35,Default,,0,0,0,,Кешіріңіз, мен асығыс едім...
Dialogue: 0,0:51:52.44,0:51:55.52,Default,,0,0,0,,А...осы оқиғадан бері екеуміз де бос емеспіз.
Dialogue: 0,0:51:56.48,0:51:58.36,Default,,0,0,0,,Ямамори мырза сияқты жақсы емес.
Dialogue: 0,0:51:58.86,0:52:03.16,Default,,0,0,0,,Хехе, бұл жайбарақат күлімсіреу сенің бірдеңені қайтадан ұстап тұрғаныңды білдіреді.
Dialogue: 0,0:52:03.74,0:52:05.66,Default,,0,0,0,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,0:52:05.74,0:52:07.62,Default,,0,0,0,,Сізге сәттілік тілеймін.
Dialogue: 0,0:52:07.70,0:52:09.87,Default,,0,0,0,,Бірақ асықпау керек.
Dialogue: 0,0:52:09.96,0:52:12.46,Default,,0,0,0,,Мен білемін, бірақ мен асығыспын.
Dialogue: 0,0:52:12.54,0:52:13.42,Default,,0,0,0,,Қылышты қолына алғаннан кейін екі айдың ішінде-ақ қоғам тірегіне айналғандар да бар.
Dialogue: 0,0:52:14.33,0:52:17.38,Default,,0,0,0,,Цк, бұл әйел нені жоспарлап отыр?
Dialogue: 0,0:52:17.46,0:52:20.47,Default,,0,0,0,,Иә? Мен бұл дәптерге сенімдімін ...
Dialogue: 0,0:52:26.56,0:52:27.43,Default,,0,0,0,,О...
Dialogue: 0,0:52:28.68,0:52:29.56,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:52:32.64,0:52:34.48,Default,,0,0,0,,«Детектив Мориге»
Dialogue: 0,0:52:34.56,0:52:36.02,Default,,0,0,0,,«Менің ойымша, бұл соңы».
Dialogue: 0,0:52:36.11,0:52:38.82,Default,,0,0,0,,«Келесі жолы өткен жолғыдан көп адам болады»
Dialogue: 0,0:52:38.90,0:52:41.65,Default,,0,0,0,,«Мен жарылыс болған жерде куә болдым»
Dialogue: 0,0:52:41.74,0:52:44.20,Default,,0,0,0,,«Біз қорқыныш уақытын бөлісуіміз керек.»
Dialogue: 0,0:52:44.91,0:52:46.70,Default,,0,0,0,,«Толық нұсқаулар кейінірек беріледі»
Dialogue: 0,0:52:46.78,0:52:48.20,Default,,0,0,0,,«Олай болса, мен саған сәттілік тілеймін».
Dialogue: 0,0:52:48.87,0:52:50.37,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:52:51.00,0:52:55.08,Default,,0,0,0,,Бүгін таңертең кеңсенің пошта жәшігіне электрондық хат келді...
Dialogue: 0,0:52:55.17,0:52:57.38,Default,,0,0,0,,Оны шығарған кезде карта...
Dialogue: 0,0:52:57.46,0:52:59.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:52:59.09,0:53:00.05,Default,,0,0,0,,- (Жүгіріп) Мм... - (Мегуре) А?
Dialogue: 0,0:53:00.63,0:53:03.55,Default,,0,0,0,,Бұл шынымен қылмыскерден бе?
Dialogue: 0,0:53:03.63,0:53:05.51,Default,,0,0,0,,Бұл еркелік болуы мүмкін бе?
Dialogue: 0,0:53:06.09,0:53:09.01,Default,,0,0,0,,Жоқ, әрине.
Dialogue: 0,0:53:09.10,0:53:12.98,Default,,0,0,0,,Соңғы рет біз кодтың мазмұнын жария еттік.
Dialogue: 0,0:53:13.06,0:53:15.69,Default,,0,0,0,,Қылмыскердің соңғы сөзі жасырылды.
Dialogue: 0,0:53:16.23,0:53:19.02,Default,,0,0,0,,Соңғы сөздер... Ах!
Dialogue: 0,0:53:20.07,0:53:22.03,Default,,0,0,0,,Сізге сәттілік тілеймін.
Dialogue: 0,0:53:22.69,0:53:23.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:53:23.86,0:53:24.95,Default,,0,0,0,,«Сәттілік тілеймін»
Dialogue: 0,0:53:25.61,0:53:28.91,Default,,0,0,0,,Иә, және осы хабарламаның соңында...
Dialogue: 0,0:53:31.16,0:53:33.54,Default,,0,0,0,,Әттең, әзіл.
Dialogue: 0,0:53:33.62,0:53:36.29,Default,,0,0,0,,Бірақ бұл жолы код болмады.
Dialogue: 0,0:53:36.37,0:53:39.42,Default,,0,0,0,,Иә, бірақ бұл сізге кеңес береді.
Dialogue: 0,0:53:39.50,0:53:40.75,Default,,0,0,0,,Хабарламаның бұл бөлігі
Dialogue: 0,0:53:41.38,0:53:43.97,Default,,0,0,0,,«Келесі жолы өткен жолғыдан көп адам болады»
Dialogue: 0,0:53:44.05,0:53:47.26,Default,,0,0,0,,«Мен жарылыс болған жерде куә болдым» дегенді білдіреді
Dialogue: 0,0:53:47.84,0:53:50.97,Default,,0,0,0,,Келесі - көп адам жиналатын орын
Dialogue: 0,0:53:51.06,0:53:53.56,Default,,0,0,0,,Менің ойымша, бұл бомба қою дегенді білдіреді.
Dialogue: 0,0:53:54.14,0:53:55.14,Default,,0,0,0,,Хмм.
Dialogue: 0,0:53:55.23,0:53:58.86,Default,,0,0,0,,Соңғы рет Тото стадионына 80 000 адам жиналды.
Dialogue: 0,0:53:59.44,0:54:04.07,Default,,0,0,0,,...Бұл келесі орынға 80 000-нан астам адам жиналатынын білдіреді...
Dialogue: 0,0:54:04.15,0:54:05.32,Default,,0,0,0,,Ондай жер бар ма?
Dialogue: 0,0:54:06.03,0:54:07.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:54:07.99,0:54:10.49,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:54:11.41,0:54:12.45,Default,,0,0,0,,А, мінекей!
Dialogue: 0,0:54:13.08,0:54:14.00,Default,,0,0,0,,Чиба-кун қайда орналасқан?
Dialogue: 0,0:54:14.66,0:54:16.41,Default,,0,0,0,,Міне! Сол плакат!
Dialogue: 0,0:54:17.33,0:54:18.50,Default,,0,0,0,,3 желтоқсан
Dialogue: 0,0:54:18.58,0:54:20.34,Default,,0,0,0,,Shiodome Arena-да өтті
Dialogue: 0,0:54:20.42,0:54:22.46,Default,,0,0,0,,Танымал жас әншілер мен топтар өнер көрсетеді—
Dialogue: 0,0:54:22.55,0:54:24.38,Default,,0,0,0,,Әдетте «100 000 адамның концерті» ретінде белгілі
Dialogue: 0,0:54:24.46,0:54:26.68,Default,,0,0,0,,Иә? 3 желтоқсан?
Dialogue: 0,0:54:27.38,0:54:30.51,Default,,0,0,0,,Бір минут күтіңіз! Бұл концертке Йоко-чан да кіреді...
Dialogue: 0,0:54:30.60,0:54:31.89,Default,,0,0,0,,Иә, Йоко-чан...
Dialogue: 0,0:54:31.97,0:54:34.64,Default,,0,0,0,,Жоқ, Йоко Окино да шығады.
Dialogue: 0,0:54:34.72,0:54:36.85,Default,,0,0,0,,Бұл "мен пайда боламын" емес!
Dialogue: 0,0:54:36.94,0:54:39.31,Default,,0,0,0,,Жоқ, тіпті сен айтсаң да...
Dialogue: 0,0:54:39.40,0:54:43.28,Default,,0,0,0,,Мори мырзаға жақын Окино мырзаның өнер көрсететін концерттік орны бар.
Dialogue: 0,0:54:43.36,0:54:45.19,Default,,0,0,0,,Келесі жарылыс нысанасы
Dialogue: 0,0:54:45.28,0:54:46.78,Default,,0,0,0,,Менің ойымша, бұл кездейсоқтық емес.
Dialogue: 0,0:54:47.45,0:54:52.37,Default,,0,0,0,,Олай болса, кінәлі Мори-кунға өкпелі біреу болса керек.
Dialogue: 0,0:54:52.45,0:54:56.91,Default,,0,0,0,,Бірақ сол бес адамның ішінде Мори мырзаға өшпенділік бар сияқты...
Dialogue: 0,0:54:57.00,0:54:58.33,Default,,0,0,0,,- (Чиба) Мм... - (Сато/Мегуре) Иә?
Dialogue: 0,0:54:58.42,0:55:01.00,Default,,0,0,0,,Бұл менің Мори-санға деген өшпенділігіме еш қатысы жоқ.
Dialogue: 0,0:55:03.00,0:55:05.46,Default,,0,0,0,,Сол концертті ұйымдастырушы кім болды?
Dialogue: 0,0:55:05.55,0:55:09.34,Default,,0,0,0,,Ямамори мырза жұмыс істейтін Nichiuri теледидары
Dialogue: 0,0:55:09.43,0:55:10.84,Default,,0,0,0,,Сол күні кешке
Dialogue: 0,0:55:10.93,0:55:13.56,Default,,0,0,0,,Продюсері болып табылатын ақпараттық бағдарламада.
Dialogue: 0,0:55:13.64,0:55:15.97,Default,,0,0,0,,Оның бір бөлігі тікелей эфирде көрсетілуі керек.
Dialogue: 0,0:55:16.64,0:55:19.89,Default,,0,0,0,,Егер тікелей эфир кезінде жарылыс орын алса...
Dialogue: 0,0:55:21.40,0:55:23.23,Default,,0,0,0,,Көрермен рейтингі өсетіні сөзсіз
Dialogue: 0,0:55:23.82,0:55:27.15,Default,,0,0,0,,Ямамори, егер менен сұрасаң, ол жігіт...
Dialogue: 0,0:55:27.78,0:55:29.99,Default,,0,0,0,,Ал, мен сендерге сәттілік тілеймін.
Dialogue: 0,0:55:30.57,0:55:32.45,Default,,0,0,0,,Екеуіңе сәттілік тілеймін.
Dialogue: 0,0:55:33.12,0:55:35.41,Default,,0,0,0,,- (Когоро) Шит - (Мегуре) Көрдім.
Dialogue: 0,0:55:35.49,0:55:39.21,Default,,0,0,0,,Кәдімгі айтатын әдетім енді ғана шыққан шығар.
Dialogue: 0,0:55:39.29,0:55:42.46,Default,,0,0,0,,Сондай-ақ, бұл Кода-сан.
Dialogue: 0,0:55:42.54,0:55:44.59,Default,,0,0,0,,Мүмкін ол жеке-
Dialogue: 0,0:55:44.67,0:55:46.13,Default,,0,0,0,,Оның Окино мырзаға кек болуы мүмкін.
Dialogue: 0,0:55:46.21,0:55:48.42,Default,,0,0,0,,Не! Йоко-чан?
Dialogue: 0,0:55:49.13,0:55:51.30,Default,,0,0,0,,Әріптестерінің айтуы бойынша
Dialogue: 0,0:55:51.38,0:55:53.89,Default,,0,0,0,,Окино мырзаның шелегі көптен бері белгіленді.
Dialogue: 0,0:55:53.97,0:55:55.18,Default,,0,0,0,,Күзетші қатал
Dialogue: 0,0:55:55.26,0:55:57.81,Default,,0,0,0,,Біреуін де ала алмаймын деп налыды.
Dialogue: 0,0:55:57.89,0:55:59.98,Default,,0,0,0,,Енді ойлап қарасам, сол естелік...
Dialogue: 0,0:56:03.23,0:56:08.07,Default,,0,0,0,,Эй, мен футбол сабағында Каору-санның жазбасын көрдім.
Dialogue: 0,0:56:08.86,0:56:12.95,Default,,0,0,0,,Онда «O.Y 3rd December Shiodome Arena» деп жазылған.
Dialogue: 0,0:56:13.03,0:56:13.91,Default,,0,0,0,,Не?
Dialogue: 0,0:56:13.99,0:56:16.79,Default,,0,0,0,,«O.Y» Йоконың бас әріптері, солай ма?
Dialogue: 0,0:56:16.87,0:56:18.62,Default,,0,0,0,,Сәлем! Неліктен бұл осы уақытқа дейін соншалықты маңызды?
Dialogue: 0,0:56:18.62,0:56:20.79,Default,,0,0,0,,Сәлем! Неліктен бұл осы уақытқа дейін соншалықты маңызды?
Dialogue: 0,0:56:18.62,0:56:20.79,Default,,0,0,0,,Тоқта, әке.
Dialogue: 0,0:56:21.37,0:56:23.00,Default,,0,0,0,,Ал, Моури мырза.
Dialogue: 0,0:56:23.08,0:56:26.67,Default,,0,0,0,,Кода-санның кінәлі екені әлі анықталған жоқ.
Dialogue: 0,0:56:27.42,0:56:30.72,Default,,0,0,0,,Бірақ қазір екі адамға тағылған айыптар қалпына келтірілді.
Dialogue: 0,0:56:31.26,0:56:33.76,Default,,0,0,0,,Қалған күдікті адам...
Dialogue: 0,0:56:33.84,0:56:35.18,Default,,0,0,0,,Дұрыс, Ран Чан.
Dialogue: 0,0:56:35.26,0:56:36.81,Default,,0,0,0,,Қылмыскердің хабарлама картасы
Dialogue: 0,0:56:37.47,0:56:39.97,Default,,0,0,0,,Сіз оның пошта жәшігінде қашан болғанын білесіз бе?
Dialogue: 0,0:56:40.06,0:56:41.31,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:56:41.39,0:56:44.52,Default,,0,0,0,,Кеше кешке қарасам жоқ екен.
Dialogue: 0,0:56:44.60,0:56:47.07,Default,,0,0,0,,Содан кейін мен оны қойдым.
Dialogue: 0,0:56:47.15,0:56:49.90,Default,,0,0,0,,...Демек, Накаока кінәлі емес.
Dialogue: 0,0:56:49.98,0:56:51.74,Default,,0,0,0,,- (Сато) Иә - иә? Неліктен?
Dialogue: 0,0:56:51.82,0:56:55.20,Default,,0,0,0,,О, ол әлі түрмеде.
Dialogue: 0,0:56:55.28,0:56:57.53,Default,,0,0,0,,Ол бүгін түстен кейін босатылады, бірақ...
Dialogue: 0,0:56:57.62,0:56:58.95,Default,,0,0,0,,Хмм…
Dialogue: 0,0:57:00.41,0:57:04.42,Default,,0,0,0,,Айтпақшы, Ран, сізбен бірге келген пошта пакеті қандай болды?
Dialogue: 0,0:57:04.50,0:57:05.88,Default,,0,0,0,,А... иә
Dialogue: 0,0:57:06.58,0:57:09.80,Default,,0,0,0,,Пошта бүгін таңертең ерте келген сияқты.
Dialogue: 0,0:57:10.67,0:57:15.59,Default,,0,0,0,,«Tokyo Spirits қолдаушы еріктілерінен»
Dialogue: 0,0:57:15.68,0:57:20.01,Default,,0,0,0,,Ішінде әкеме деген алғыс хат пен галстук болды.
Dialogue: 0,0:57:20.10,0:57:21.52,Default,,0,0,0,,Хмм... О?
Dialogue: 0,0:57:22.23,0:57:23.56,Default,,0,0,0,,О, кешіріңіз.
Dialogue: 0,0:57:23.64,0:57:27.31,Default,,0,0,0,,Сол конверттің шетінен желім шығып тұрғандай болды.
Dialogue: 0,0:57:27.40,0:57:29.19,Default,,0,0,0,,О, маған бәрібір.
Dialogue: 0,0:57:30.90,0:57:32.44,Default,,0,0,0,,- (Мегуре) Рахмет - (Жүгіріп) Жоқ.
Dialogue: 0,0:57:32.53,0:57:34.24,Default,,0,0,0,,Жарайды, бәрібір.
Dialogue: 0,0:57:34.32,0:57:36.53,Default,,0,0,0,,Енді сіз J лигасына және Токио рухтарына қосыла аласыз.
Dialogue: 0,0:57:36.61,0:57:38.32,Default,,0,0,0,,Өкпе сызықтары жіңішкерді.
Dialogue: 0,0:57:39.03,0:57:43.50,Default,,0,0,0,,Синдзо Ямамори мен Каору Коданы тағы бір рет тексерейік!
Dialogue: 0,0:57:45.21,0:57:46.71,Default,,0,0,0,,Бірдеңе ұстап қалған сияқты.
Dialogue: 0,0:57:46.79,0:57:51.25,Default,,0,0,0,,А, бұл концерт 3 желтоқсанда болады.
Dialogue: 0,0:57:51.34,0:57:54.72,Default,,0,0,0,,А... J лигасының финалдық ойынымен бір күні ме?
Dialogue: 0,0:57:54.80,0:57:55.76,Default,,0,0,0,,Иә
Dialogue: 0,0:57:55.84,0:57:58.30,Default,,0,0,0,,Не? Сіз ұсталып қаласыз ба?
Dialogue: 0,0:57:58.39,0:57:59.93,Default,,0,0,0,,Ал неге кінәлі...
Dialogue: 0,0:58:00.93,0:58:02.77,Default,,0,0,0,,Осындай орынды анықтауға мүмкіндік беретін нәрсе
Dialogue: 0,0:58:02.85,0:58:04.31,Default,,0,0,0,,Сіз маған айтқан шығарсыз.
Dialogue: 0,0:58:05.02,0:58:07.27,Default,,0,0,0,,Осыған байланысты қауіпсіздік күшейтілуде.
Dialogue: 0,0:58:07.35,0:58:09.65,Default,,0,0,0,,Бұл қылмыс жасауды қиындатпай ма?
Dialogue: 0,0:58:09.73,0:58:11.40,Default,,0,0,0,,Егер солай десеңіз, онда иә.
Dialogue: 0,0:58:12.23,0:58:16.49,Default,,0,0,0,,Осындай қатаң қауіпсіздік жағдайында да қылмыскер бомба қояды.
Dialogue: 0,0:58:16.57,0:58:19.20,Default,,0,0,0,,Әлде оны әкелуге сеніміңіз бар ма?
Dialogue: 0,0:58:19.28,0:58:20.53,Default,,0,0,0,,Иә.
Dialogue: 0,0:58:20.62,0:58:23.37,Default,,0,0,0,,Мүмкін Shiodome Arena-дан басқа
Dialogue: 0,0:58:23.45,0:58:26.25,Default,,0,0,0,,80 мыңнан астам адам жиналатын орын бар ма?
Dialogue: 0,0:58:26.33,0:58:29.71,Default,,0,0,0,,Немесе кінәлі өтірік айтуы мүмкін.
Dialogue: 0,0:58:30.29,0:58:35.34,Default,,0,0,0,,Жоқ, қылмыстың бұл түрінің ерекшелігі – қылмыскердің өтірік айтпауы.
Dialogue: 0,0:58:35.42,0:58:38.22,Default,,0,0,0,,Мен мұны анық айта аламын, егер бар болса ...
Dialogue: 0,0:58:38.30,0:58:39.93,Default,,0,0,0,,- (Ағаса) Иә? -(Хайбара) Олай болса, бұл не болар еді?
Dialogue: 0,0:58:40.97,0:58:42.60,Default,,0,0,0,,Сөз айласымен—
Dialogue: 0,0:58:43.43,0:58:44.68,Default,,0,0,0,,жаңылыстыру
Dialogue: 0,0:58:46.77,0:58:48.39,Default,,0,0,0,,Спорт және ойын-сауық ақпараты
Dialogue: 0,0:58:48.48,0:58:49.60,Default,,0,0,0,,Біріншіден, J лигасы
Dialogue: 0,0:58:49.69,0:58:53.07,Default,,0,0,0,,Маусымның соңғы ойыны 3 желтоқсан, сенбі күні өтеді!
Dialogue: 0,0:58:53.15,0:58:55.49,Default,,0,0,0,,Жақында Тото стадионындағы жарылысқа жауап ретінде
Dialogue: 0,0:58:55.57,0:58:57.61,Default,,0,0,0,,Матчтан бас тарту туралы мәселе қаралды.
Dialogue: 0,0:58:57.70,0:58:59.20,Default,,0,0,0,,Бұрынғы J лигасының баспасөз конференциясында
Dialogue: 0,0:58:59.28,0:59:01.99,Default,,0,0,0,,Төраға Дайто оқиғаны ресми түрде жариялады.
Dialogue: 0,0:59:02.62,0:59:04.45,Default,,0,0,0,,J финалдық ойыны 3 желтоқсанда 15:30-да басталады!
Dialogue: 0,0:59:04.45,0:59:05.91,Default,,0,0,0,,J финалдық ойыны 3 желтоқсанда 15:30-да басталады!
Dialogue: 0,0:59:04.45,0:59:05.91,Default,,0,0,0,,(Степлер дыбысы)
Dialogue: 0,0:59:06.00,0:59:08.46,Default,,0,0,0,,Сондай-ақ 3-ші сенбіде шоу да 15:30-да басталады.
Dialogue: 0,0:59:08.54,0:59:10.42,Default,,0,0,0,,(Қаламмен жазу дыбысы)
Dialogue: 0,0:59:08.54,0:59:10.42,Default,,0,0,0,,Shiodome Arenaдағы музыканың күші!
Dialogue: 0,0:59:10.42,0:59:11.71,Default,,0,0,0,,Shiodome Arenaдағы музыканың күші!
Dialogue: 0,0:59:11.79,0:59:14.38,Default,,0,0,0,,Әдетте «100 000 адамның концерті» деп аталатын бұл оқиға...
Dialogue: 0,0:59:15.38,0:59:16.84,Default,,0,0,0,,Қонақтарымызға
Dialogue: 0,0:59:16.92,0:59:18.34,Default,,0,0,0,,Ах, жас ханым.
Dialogue: 0,0:59:18.84,0:59:19.80,Default,,0,0,0,,Қабылдау кезінде
Dialogue: 0,0:59:19.88,0:59:22.76,Default,,0,0,0,,Біз багажды тексеріп жатырмыз.
Dialogue: 0,0:59:22.85,0:59:25.31,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз, бірақ билетіңізді дайындаңыз.
Dialogue: 0,0:59:25.31,0:59:26.60,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз, бірақ билетіңізді дайындаңыз.
Dialogue: 0,0:59:25.31,0:59:26.60,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:59:26.68,0:59:29.69,Default,,0,0,0,,Тексеру қақпасының алдында екі қатарға тұрыңыз...
Dialogue: 0,0:59:30.35,0:59:33.11,Default,,0,0,0,,Кездескенше, Йоко-чан.
Dialogue: 0,0:59:33.19,0:59:34.86,Default,,0,0,0,,Сахнада сәттілік
Dialogue: 0,0:59:37.24,0:59:38.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:59:42.37,0:59:43.74,Default,,0,0,0,,Тікелей эфирге қалай дайындалу керек?
Dialogue: 0,0:59:43.83,0:59:44.70,Default,,0,0,0,,Иә
Dialogue: 0,0:59:44.78,0:59:46.41,Default,,0,0,0,,Күту режимі осы уақытқа дейін аяқталуы керек еді.
Dialogue: 0,0:59:47.00,0:59:49.12,Default,,0,0,0,,Себебі тікелей эфирде не болатынын ешқашан білмейсіз.
Dialogue: 0,0:59:49.75,0:59:51.58,Default,,0,0,0,,Айтыңызшы, ешқашан босаңсуға болмайды.
Dialogue: 0,0:59:51.67,0:59:52.54,Default,,0,0,0,,Иә
Dialogue: 0,0:59:56.00,0:59:57.09,Default,,0,0,0,,Сәлем, инспектор.
Dialogue: 0,0:59:57.17,1:00:00.84,Default,,0,0,0,,Шынымен де жарылып жатқан Shiodome Arena ма?
Dialogue: 0,1:00:00.93,1:00:01.76,Default,,0,0,0,,- (Мегуре) Иә? -(Сато) А?
Dialogue: 0,1:00:01.84,1:00:02.72,Default,,0,0,0,,Өйткені, қараңыз...
Dialogue: 0,1:00:02.80,1:00:04.55,Default,,0,0,0,,Енді не айтып тұрсың?
Dialogue: 0,1:00:04.64,1:00:07.77,Default,,0,0,0,,Өйткені 80 000-нан астам адамды тартатын басқа шара жоқ.
Dialogue: 0,1:00:07.85,1:00:10.02,Default,,0,0,0,,Шиодоме Арена болуға шешім қабылданды.
Dialogue: 0,1:00:10.10,1:00:13.15,Default,,0,0,0,,...Сондықтан мен саған Ранмен бірге киноға барайық дедім.
Dialogue: 0,1:00:13.90,1:00:16.82,Default,,0,0,0,,Сонымен, Конан-кун, сені бірдеңе уайымдап тұрған жоқ па?
Dialogue: 0,1:00:16.90,1:00:20.40,Default,,0,0,0,,Иә, бүгін J лигасының финалдық ойыны.
Dialogue: 0,1:00:20.49,1:00:23.20,Default,,0,0,0,,Концертпен бір күнде болғаны сізді алаңдатпай ма?
Dialogue: 0,1:00:23.99,1:00:25.41,Default,,0,0,0,,Мен, әрине, қызықпын.
Dialogue: 0,1:00:25.91,1:00:27.95,Default,,0,0,0,,Бұл кездейсоқтық! Бұл кездейсоқтық!
Dialogue: 0,1:00:28.04,1:00:31.21,Default,,0,0,0,,...Керексіз ештеңе айтып, тергеуге кедергі келтірме!
Dialogue: 0,1:00:31.29,1:00:32.17,Default,,0,0,0,,- (Мегуре) Жоқ... - (Когоро) А?
Dialogue: 0,1:00:32.79,1:00:37.75,Default,,0,0,0,,Біз сондай-ақ жағдайға байланысты қауіпсіздікті арттыруды сұрадық.
Dialogue: 0,1:00:37.84,1:00:41.55,Default,,0,0,0,,Финалдық матчтың басталуы сағат 15:30 болатынына сенімдімін.
Dialogue: 0,1:00:41.63,1:00:43.63,Default,,0,0,0,,Басталғалы жатыр.
Dialogue: 0,1:00:43.72,1:00:44.72,Default,,0,0,0,,Енді бұл сәйкестік.
Dialogue: 0,1:00:44.80,1:00:46.80,Default,,0,0,0,,Tokyo Spirits Егер сіз жеңсеңіз, сіз жеңесіз!
Dialogue: 0,1:00:46.89,1:00:49.89,Default,,0,0,0,,Екінші жағынан, Үлкен Осака жеңілсе, олар J2 тобына түседі!
Dialogue: 0,1:00:49.97,1:00:52.35,Default,,0,0,0,,Ешқайсымыз мүлдем жеңіле алмайтын шайқас.
Dialogue: 0,1:00:52.44,1:00:54.19,Default,,0,0,0,,Басталуы дәл 3:30-да!
Dialogue: 0,1:00:58.07,1:01:01.86,Default,,0,0,0,,О, мен істеп жатырмын! Мен істеп жатырмын! Бұл тек бастамасы
Dialogue: 0,1:01:02.65,1:01:05.78,Default,,0,0,0,,Эй Соноко, сен неге киноға барамын деп өтірік айттың?
Dialogue: 0,1:01:06.32,1:01:08.87,Default,,0,0,0,,Не? Ой кешір кешір
Dialogue: 0,1:01:08.95,1:01:10.83,Default,,0,0,0,,Мен футбол көремін дегенімде
Dialogue: 0,1:01:10.91,1:01:12.75,Default,,0,0,0,,Мен Ранның әкесі мені тоқтатады деп ойладым.
Dialogue: 0,1:01:13.46,1:01:17.50,Default,,0,0,0,,Бүгін біз Хиго-санның батыл жағын биыл соңғы рет көреміз.
Dialogue: 0,1:01:17.59,1:01:20.34,Default,,0,0,0,,Жүр! Сәттілік Хиго-сан!
Dialogue: 0,1:01:24.18,1:01:26.30,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,1:01:26.39,1:01:27.93,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:28.01,1:01:31.60,Default,,0,0,0,,Тексер, мені Хигоға қойды.
Dialogue: 0,1:01:33.39,1:01:35.94,Default,,0,0,0,,Аа, мен де бірдеңе жегім келеді.
Dialogue: 0,1:01:36.02,1:01:37.23,Default,,0,0,0,,Кішкене болса жақсы.
Dialogue: 0,1:01:37.31,1:01:40.27,Default,,0,0,0,,Не? Сонда, дүкенде ме?
Dialogue: 0,1:01:40.78,1:01:42.61,Default,,0,0,0,,Хиго, не болды?
Dialogue: 0,1:01:42.69,1:01:44.95,Default,,0,0,0,,Санымды ұстап... Аа~ құлап қалдым.
Dialogue: 0,1:01:45.53,1:01:47.41,Default,,0,0,0,,- (Аюми) Жақсысың ба? -(Хайбара) А...
Dialogue: 0,1:01:47.49,1:01:50.16,Default,,0,0,0,,Ах~ Хиго ауыстырылады ма?
Dialogue: 0,1:01:50.24,1:01:54.16,Default,,0,0,0,,Ойыншы неғұрлым жақсы болса, соғұрлым ол мақсатты болады.
Dialogue: 0,1:01:56.33,1:01:57.21,Default,,0,0,0,,Күтілгендей, жоқ
Dialogue: 0,1:01:57.29,1:01:58.13,Default,,0,0,0,,Иә!
Dialogue: 0,1:01:58.75,1:01:59.96,Default,,0,0,0,,Санада, дайындал.
Dialogue: 0,1:02:00.04,1:02:02.42,Default,,0,0,0,,Бұл әлдеқашан жасалған.
Dialogue: 0,1:02:02.51,1:02:04.26,Default,,0,0,0,,Жарайды, бір рет атыңыз!
Dialogue: 0,1:02:04.34,1:02:05.30,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:02:08.85,1:02:12.01,Default,,0,0,0,,Кешіріңіз, Такахиро, қалғанын сұрадым.
Dialogue: 0,1:02:12.10,1:02:13.06,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,1:02:13.81,1:02:16.52,Default,,0,0,0,,Қарттардың бір жыл демалыс алғаны дұрыс.
Dialogue: 0,1:02:16.60,1:02:18.35,Default,,0,0,0,,Ақымақ, тез жүр.
Dialogue: 0,1:02:18.44,1:02:19.52,Default,,0,0,0,,Хахаха…
Dialogue: 0,1:02:20.27,1:02:23.99,Default,,0,0,0,,Хигоның орнына Санада шықты.
Dialogue: 0,1:02:24.57,1:02:27.53,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:02:27.61,1:02:28.45,Default,,0,0,0,,Не?
Dialogue: 0,1:02:28.91,1:02:31.70,Default,,0,0,0,,Қалай болып жатыр? Бірдеңе өзгерді...
Dialogue: 0,1:02:31.78,1:02:32.66,Default,,0,0,0,,Бөлек
Dialogue: 0,1:02:33.16,1:02:36.25,Default,,0,0,0,,Мұнда 80 000 адам жиналғанына сене алар емеспін...
Dialogue: 0,1:02:36.33,1:02:37.46,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,1:02:37.87,1:02:42.55,Default,,0,0,0,,Бірақ, бір уақытта барлық 10 ойынды тамашалау керемет болар еді!
Dialogue: 0,1:02:42.63,1:02:43.50,Default,,0,0,0,,Иә
Dialogue: 0,1:02:43.59,1:02:45.76,Default,,0,0,0,,Барлығының бір уақытта толқуына сене алмаймын
Dialogue: 0,1:02:45.84,1:02:46.30,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,1:02:46.30,1:02:47.59,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,1:02:46.30,1:02:47.59,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:47.68,1:02:51.39,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз мұны естідіңіз бе, Эдогава-кун?
Dialogue: 0,1:02:51.47,1:02:54.10,Default,,0,0,0,,Бір уақытта жүрек соғысы...
Dialogue: 0,1:02:54.18,1:02:56.14,Default,,0,0,0,,Ал... қылмыскердің мақсаты не болды?
Dialogue: 0,1:02:56.23,1:02:57.44,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:02.90,1:03:04.07,Default,,0,0,0,,- (Азуса) Ах... - (Такаги) А...
Dialogue: 0,1:03:04.15,1:03:05.44,Default,,0,0,0,,Азуса-чан
Dialogue: 0,1:03:05.53,1:03:07.53,Default,,0,0,0,,Жарайды, бұл төменгі қабаттағы кофехананың қызы.
Dialogue: 0,1:03:07.61,1:03:08.78,Default,,0,0,0,,- (Такаги) Ах - (Азуса) Ум...
Dialogue: 0,1:03:08.86,1:03:11.28,Default,,0,0,0,,Дүкенде мені біртүрлі дауыс шақырды...
Dialogue: 0,1:03:11.37,1:03:12.20,Default,,0,0,0,,Не!
Dialogue: 0,1:03:12.87,1:03:14.79,Default,,0,0,0,,2-ші көшедегі телефон кабинасында
Dialogue: 0,1:03:14.87,1:03:17.00,Default,,0,0,0,,Сіз Моури-санға хабарлама қалдырдыңыз...
Dialogue: 0,1:03:17.58,1:03:18.46,Default,,0,0,0,,- (Когоро) Не? -(Мегур) Не?
Dialogue: 0,1:03:38.81,1:03:40.14,Default,,0,0,0,,«Ескерту»
Dialogue: 0,1:03:40.23,1:03:43.40,Default,,0,0,0,,«J1 лигасының 10 стадионына бомбалар қойылды»
Dialogue: 0,1:03:43.48,1:03:44.36,Default,,0,0,0,,Не!
Dialogue: 0,1:03:44.44,1:03:46.23,Default,,0,0,0,,Тәтті, мен солай ойлаймын.
Dialogue: 0,1:03:46.86,1:03:50.40,Default,,0,0,0,,«Бомба матчтың соңында жарылады».
Dialogue: 0,1:03:50.49,1:03:51.74,Default,,0,0,0,,«Тоқтап тұру жоқ»
Dialogue: 0,1:03:52.45,1:03:55.37,Default,,0,0,0,,«Бірақ ешбір мүмкіндік қызық емес».
Dialogue: 0,1:03:55.45,1:03:57.20,Default,,0,0,0,,«Бір мүмкіндікті қолданайық»
Dialogue: 0,1:03:57.29,1:04:00.33,Default,,0,0,0,,«Екінші таймда команда алаң иелерінің қақпасына шабуыл жасайды».
Dialogue: 0,1:04:00.41,1:04:02.42,Default,,0,0,0,,«Сіз спектакльді көрсетілгендей орындаған кезде...»
Dialogue: 0,1:04:03.13,1:04:05.50,Default,,0,0,0,,«Жарылысты тоқтатуға болады»
Dialogue: 0,1:04:05.59,1:04:09.67,Default,,0,0,0,,«Тоқтағанын дәлелдеу үшін электрондық хабарландыру тақтасын екі рет жыпылықтайық».
Dialogue: 0,1:04:09.76,1:04:11.88,Default,,0,0,0,,Е, тағы да электр хабарландыру тақтасы
Dialogue: 0,1:04:12.93,1:04:15.68,Default,,0,0,0,,«Алайда, сіз бұл нұсқауларды жеткізе аласыз.»
Dialogue: 0,1:04:15.76,1:04:18.93,Default,,0,0,0,,«Тек әр команданың менеджері және шабуылшысы»
Dialogue: 0,1:04:19.02,1:04:21.27,Default,,0,0,0,,«Басқа ойыншыларға хабар бермеңіз»
Dialogue: 0,1:04:21.98,1:04:24.23,Default,,0,0,0,,«Сәйкестік кезіндегі табиғи емес қозғалыстар...»
Dialogue: 0,1:04:24.31,1:04:28.23,Default,,0,0,0,,«Көрермендерді эвакуациялау, бомбаларды іздеу және т.б.»
Dialogue: 0,1:04:28.32,1:04:31.07,Default,,0,0,0,,«Бомбаны дереу жарыңыз»
Dialogue: 0,1:04:31.15,1:04:32.11,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:04:32.20,1:04:33.70,Default,,0,0,0,,«Аса шабуылшы үшін»
Dialogue: 0,1:04:33.78,1:04:36.95,Default,,0,0,0,,«Сол қолыңызға қызыл білезікті міндетті түрде тағыңыз».
Dialogue: 0,1:04:37.03,1:04:41.91,Default,,0,0,0,,«Енді, жарылысты тоқтататын жалғыз пьеса қандай?»
Dialogue: 0,1:04:43.54,1:04:45.46,Default,,0,0,0,,- (Когоро) Әй? -(Мегур) А? ше?
Dialogue: 0,1:04:46.75,1:04:50.42,Default,,0,0,0,,«Осы ескертуде қазірдің өзінде көрсетілген»
Dialogue: 0,1:04:50.51,1:04:51.72,Default,,0,0,0,,- Иә? -(Мегур) Не?
Dialogue: 0,1:04:51.80,1:04:52.63,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:53.26,1:04:56.64,Default,,0,0,0,,«Жарылыс болмаса да»
Dialogue: 0,1:04:56.72,1:05:00.81,Default,,0,0,0,,«Ойын аяқталғаннан кейін 35 минут ішінде бомбаны іздеуге тыйым салынады».
Dialogue: 0,1:05:00.89,1:05:04.40,Default,,0,0,0,,«Егер олар қорғалмаған болса, біз олардың өміріне кепілдік бермейміз».
Dialogue: 0,1:05:04.98,1:05:07.61,Default,,0,0,0,,"Моури Когоро! Мені тоқтатқыңыз келсе..."
Dialogue: 0,1:05:07.69,1:05:11.53,Default,,0,0,0,,«11-ші шабуылшы бол және маған кел!»
Dialogue: 0,1:05:11.61,1:05:13.36,Default,,0,0,0,,«Олай болса, мен саған сәттілік тілеймін».
Dialogue: 0,1:05:13.45,1:05:16.99,Default,,0,0,0,,Бітім, тағы да сол жол, қалжың.
Dialogue: 0,1:05:19.74,1:05:20.79,Default,,0,0,0,,Күтілгендей
Dialogue: 0,1:05:20.87,1:05:23.16,Default,,0,0,0,,Ауызша қулыққа байланысты жаңылыстырды ма?
Dialogue: 0,1:05:23.58,1:05:25.21,Default,,0,0,0,,Сізді ұрып-соқты.
Dialogue: 0,1:05:25.29,1:05:27.88,Default,,0,0,0,,Бүгінгі финалдық матчта барлық ойындар бір уақытта басталады.
Dialogue: 0,1:05:28.50,1:05:30.63,Default,,0,0,0,,Барлық көрермендер біріктірілді
Dialogue: 0,1:05:30.71,1:05:32.72,Default,,0,0,0,,80 000-нан астам адам.
Dialogue: 0,1:05:32.80,1:05:33.80,Default,,0,0,0,,Әрине
Dialogue: 0,1:05:33.88,1:05:36.84,Default,,0,0,0,,Ескертуде «бір жерде» деген жоқ.
Dialogue: 0,1:05:36.93,1:05:39.18,Default,,0,0,0,,Такаги: Ойын сағат нешеде аяқталады?
Dialogue: 0,1:05:39.26,1:05:42.06,Default,,0,0,0,,Мм, меніңше 5:15...
Dialogue: 0,1:05:42.14,1:05:45.69,Default,,0,0,0,,Уау! Бір сағаттай ғана қалды!
Dialogue: 0,1:05:45.77,1:05:50.52,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:06:01.45,1:06:02.37,Default,,0,0,0,,Уф...
Dialogue: 0,1:06:04.00,1:06:09.00,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:06:12.13,1:06:13.71,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,1:06:15.51,1:06:17.43,Default,,0,0,0,,Не болды? Сато мырза
Dialogue: 0,1:06:17.51,1:06:19.18,Default,,0,0,0,,Осы хабарламаның бірінші сөйлемі
Dialogue: 0,1:06:19.80,1:06:21.18,Default,,0,0,0,,Тек «ескерту»—
Dialogue: 0,1:06:21.26,1:06:25.10,Default,,0,0,0,,Қағазды бір-біріне қадағаннан кейін жазып отырған сияқтысыз.
Dialogue: 0,1:06:25.18,1:06:26.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:26.77,1:06:29.36,Default,,0,0,0,,Мұқият қарасаңыз, «су» таңбасы жазылған қызыл сияны көресіз.
Dialogue: 0,1:06:30.27,1:06:32.61,Default,,0,0,0,,Ол степлердің үстінде, солай ма?
Dialogue: 0,1:06:32.69,1:06:33.57,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:06:36.45,1:06:40.95,Default,,0,0,0,,Бірақ сұрақ мынада: неліктен әріптерді біріктіресіз?
Dialogue: 0,1:06:42.33,1:06:44.00,Default,,0,0,0,,Степлер
Dialogue: 0,1:06:44.08,1:06:47.62,Default,,0,0,0,,Ортаға әдейі қойылған қызыл сия...
Dialogue: 0,1:06:48.79,1:06:49.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:51.34,1:06:53.50,Default,,0,0,0,,Иә? Эй, сен не істеп жатырсың?
Dialogue: 0,1:06:53.59,1:06:55.38,Default,,0,0,0,,Мен көремін. Солай ма?
Dialogue: 0,1:06:56.51,1:06:59.72,Default,,0,0,0,,Түсіндім, қылмыскер сұрап отырған пьеса!
Dialogue: 0,1:06:59.80,1:07:01.64,Default,,0,0,0,,Не болды? Конан-кун
Dialogue: 0,1:07:01.72,1:07:02.93,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,1:07:03.01,1:07:07.44,Default,,0,0,0,,Эй, эй, бұл ескертуді қоршап тұрған төртбұрышты жақтау қандай?
Dialogue: 0,1:07:07.52,1:07:09.40,Default,,0,0,0,,Бұл футбол алаңына ұқсамайды ма?
Dialogue: 0,1:07:09.48,1:07:10.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:10.40,1:07:11.81,Default,,0,0,0,,Қандай бос сөз айтып тұрсың?
Dialogue: 0,1:07:12.73,1:07:13.90,Default,,0,0,0,,Бұл шаршы жақтау
Dialogue: 0,1:07:13.98,1:07:15.74,Default,,0,0,0,,Қадам болса, степлер
Dialogue: 0,1:07:15.82,1:07:16.78,Default,,0,0,0,,Бұл футбол голы.
Dialogue: 0,1:07:17.57,1:07:19.78,Default,,0,0,0,,Өйткені, қараңдаршы, степлер дегеніміз не?
Dialogue: 0,1:07:19.86,1:07:22.07,Default,,0,0,0,,Бұл дәл футбол голына ұқсайды, солай ма?
Dialogue: 0,1:07:22.16,1:07:23.24,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:23.33,1:07:24.70,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,1:07:24.79,1:07:26.87,Default,,0,0,0,,Содан кейін «S» әрпінің тік сызығы
Dialogue: 0,1:07:26.95,1:07:30.88,Default,,0,0,0,,Степлер мақсатына қарай өсіп жатқан жоқ па? Бұл...
Dialogue: 0,1:07:30.96,1:07:32.13,Default,,0,0,0,,Ату курсы
Dialogue: 0,1:07:32.88,1:07:37.13,Default,,0,0,0,,Сіз дәл қақпаның дәл ортасында соққы жасау керек деп айтасыз ба?
Dialogue: 0,1:07:37.21,1:07:38.63,Default,,0,0,0,,- (Сато) Күте тұрыңыз, инспектор - (Мегуре) Иә?
Dialogue: 0,1:07:38.72,1:07:43.22,Default,,0,0,0,,Оқ түсіру қақпаның аузынан өтуді білдіреді.
Dialogue: 0,1:07:43.30,1:07:47.27,Default,,0,0,0,,Олай болса, тік сызықтар қапсырмалар алдында сызылған.
Dialogue: 0,1:07:47.35,1:07:49.35,Default,,0,0,0,,Ол иненің үстінде болуы керек.
Dialogue: 0,1:07:49.44,1:07:52.98,Default,,0,0,0,,Бірақ шын мәнінде әріптер парақтар бір-біріне тігілгеннен кейін жазылған.
Dialogue: 0,1:07:53.06,1:07:55.44,Default,,0,0,0,,Тік сызық инеде тоқтайды
Dialogue: 0,1:07:56.03,1:07:57.57,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,1:07:57.65,1:08:00.82,Default,,0,0,0,,Степлердегі қызыл сия қай жерде
Dialogue: 0,1:08:00.91,1:08:04.24,Default,,0,0,0,,Футбол голында тіректің ортасы.
Dialogue: 0,1:08:04.33,1:08:06.62,Default,,0,0,0,,Сонымен, қылмыскер талап етіп отырған нәрсе
Dialogue: 0,1:08:06.70,1:08:09.54,Default,,0,0,0,,Бұл допты арқанның ортасына тигізу керек дегенді білдіреді.
Dialogue: 0,1:08:09.62,1:08:12.63,Default,,0,0,0,,Жақсы! Әрбір J League клубына дереу хабарласыңыз.
Dialogue: 0,1:08:12.71,1:08:14.17,Default,,0,0,0,,Иә!
Dialogue: 0,1:08:14.25,1:08:17.51,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:08:17.59,1:08:18.46,Default,,0,0,0,,Иә Megure
Dialogue: 0,1:08:18.55,1:08:20.05,Default,,0,0,0,,Бұл аққу.
Dialogue: 0,1:08:20.13,1:08:23.22,Default,,0,0,0,,Біз кінәлі деп анықтауға болатын адамды дерлік анықтадық.
Dialogue: 0,1:08:23.30,1:08:24.93,Default,,0,0,0,,Не? Сіз қылмыскерді анықтадыңыз ба?
Dialogue: 0,1:08:25.01,1:08:30.02,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:08:36.15,1:08:36.98,Default,,0,0,0,,Бомба!
Dialogue: 0,1:08:37.61,1:08:38.48,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:08:38.57,1:08:41.70,Default,,0,0,0,,Аа, мен полиция сізге ертерек хабарласты деп естідім.
Dialogue: 0,1:08:41.78,1:08:43.03,Default,,0,0,0,,Хмм...
Dialogue: 0,1:08:43.11,1:08:45.28,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз жасай аласыз ба?
Dialogue: 0,1:08:45.95,1:08:47.16,Default,,0,0,0,,Егер қолыңнан келмесе, маған хабарлаңыз.
Dialogue: 0,1:08:47.70,1:08:51.00,Default,,0,0,0,,Біреуден бас тартсаң, ешкім шағымданбайды...
Dialogue: 0,1:08:51.08,1:08:51.96,Default,,0,0,0,,Жоқ, бұл тек қана тәжірибе.
Dialogue: 0,1:08:52.04,1:08:53.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:54.04,1:08:57.84,Default,,0,0,0,,Тағы кімге рұқсат бересіз?
Dialogue: 0,1:08:58.84,1:09:02.55,Default,,0,0,0,,Кінәлі шабуылшы болды, солай ма?
Dialogue: 0,1:09:02.63,1:09:06.43,Default,,0,0,0,,Енді Хиго-сан құлады, оның эйс болғаны немесе болмағаны маңызды емес.
Dialogue: 0,1:09:06.51,1:09:09.56,Default,,0,0,0,,Мен ғана сені шабуылшы деп айта аламын ба?
Dialogue: 0,1:09:10.81,1:09:11.68,Default,,0,0,0,,Санада…
Dialogue: 0,1:09:12.89,1:09:15.10,Default,,0,0,0,,Әйтеуір жақсы болады.
Dialogue: 0,1:09:15.19,1:09:19.28,Default,,0,0,0,,Егер сіз оның жарылуын тоқтатсаңыз, сіз аз уақытта үлкен жұлдызға айналасыз, солай ма?
Dialogue: 0,1:09:19.36,1:09:22.24,Default,,0,0,0,,Қыздар арасында танымал болсам, не істеуім керек? Хухуфу…
Dialogue: 0,1:09:22.32,1:09:24.15,Default,,0,0,0,,-(Мацузаки) Санада... -(Санада) Ия...
Dialogue: 0,1:09:25.53,1:09:27.41,Default,,0,0,0,,Мұны сол қолыңызға қойыңыз
Dialogue: 0,1:09:29.87,1:09:33.21,Default,,0,0,0,,А, жоқ, жауынгер дірілдеп тұр. Жауынгер дірілдеп тұр.
Dialogue: 0,1:09:34.00,1:09:35.58,Default,,0,0,0,,Мен мұны сұрадым, Санада.
Dialogue: 0,1:09:38.13,1:09:39.34,Default,,0,0,0,,Бір, екі, үш.
Dialogue: 0,1:09:44.63,1:09:46.72,Default,,0,0,0,,Менің ойымша, жеңімпаз Tokyo Spirits.
Dialogue: 0,1:09:46.80,1:09:48.76,Default,,0,0,0,,Жоқ, бұл Кашива Рейсол.
Dialogue: 0,1:09:48.85,1:09:50.56,Default,,0,0,0,,Ойыншы шықты.
Dialogue: 0,1:09:50.64,1:09:52.73,Default,,0,0,0,,Бұл екінші жартысының басы.
Dialogue: 0,1:09:52.81,1:09:55.56,Default,,0,0,0,,Күтуден шаршадым
Dialogue: 0,1:09:55.64,1:09:57.77,Default,,0,0,0,,Мен де екінші жартымды асыға күтемін.
Dialogue: 0,1:09:57.86,1:09:58.73,Default,,0,0,0,,Иә.
Dialogue: 0,1:09:58.81,1:10:01.57,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:10:01.65,1:10:02.61,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:10:02.69,1:10:04.28,Default,,0,0,0,,Хайбара, мұқият тыңда.
Dialogue: 0,1:10:04.36,1:10:06.78,Default,,0,0,0,,Қылмыскердің мақсаты J лигасы болды.
Dialogue: 0,1:10:06.86,1:10:07.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:08.99,1:10:11.95,Default,,0,0,0,,Иә, Ace Striker үшін қызыл білезік.
Dialogue: 0,1:10:12.66,1:10:15.16,Default,,0,0,0,,Түсінікті. Егер ерекше нәрсе болса, мен сізге дереу хабарлаймын.
Dialogue: 0,1:10:15.25,1:10:18.17,Default,,0,0,0,,Өтінемін, бұдан былай мен кінәлі болып есептелемін... А!
Dialogue: 0,1:10:18.25,1:10:19.92,Default,,0,0,0,,Ой, жаман, мен саған қайта қоңырау шаламын!
Dialogue: 0,1:10:20.00,1:10:22.38,Default,,0,0,0,,Әй... Эй, Кудо-кун!
Dialogue: 0,1:10:20.00,1:10:22.38,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,1:10:26.34,1:10:27.47,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,1:10:27.55,1:10:29.80,Default,,0,0,0,,- (Мегуре) Хмм, қайда екенін естідім. - (Полиция қызметкері) Иә.
Dialogue: 0,1:10:31.06,1:10:32.18,Default,,0,0,0,,Сен міндің, Моури-кун.
Dialogue: 0,1:10:32.26,1:10:33.60,Default,,0,0,0,,- (Когоро) Не...? -(Мегур) А?
Dialogue: 0,1:10:33.68,1:10:35.68,Default,,0,0,0,,Неліктен сіз бортта жүрсіз?
Dialogue: 0,1:10:35.77,1:10:36.60,Default,,0,0,0,,Эххехе…
Dialogue: 0,1:10:36.69,1:10:38.31,Default,,0,0,0,,Менің кетуден басқа амалым жоқ.
Dialogue: 0,1:10:38.40,1:10:39.90,Default,,0,0,0,,А... иә
Dialogue: 0,1:10:43.11,1:10:44.49,Default,,0,0,0,,Не... бұл не?!
Dialogue: 0,1:10:44.57,1:10:46.57,Default,,0,0,0,,Доктор Шулы!
Dialogue: 0,1:10:46.65,1:10:48.45,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,1:10:49.11,1:10:52.49,Default,,0,0,0,,Сонымен әр команданың шабуылшысы кім?
Dialogue: 0,1:10:52.58,1:10:54.91,Default,,0,0,0,,Қызыл білезікке назар аударыңыз
Dialogue: 0,1:10:55.96,1:11:00.79,Default,,0,0,0,,Кудо мырзаның айтуынша, бомба қаупінің уақыты 5:15, ойынның аяқталуы.
Dialogue: 0,1:11:00.88,1:11:03.71,Default,,0,0,0,,Аудиторияны қандай да бір жолмен эвакуациялауға болады ма?
Dialogue: 0,1:11:03.80,1:11:08.01,Default,,0,0,0,,Мүмкін емес. Егер сіз мұны жасасаңыз, сіз қашықтан жарылып кетесіз.
Dialogue: 0,1:11:08.09,1:11:10.59,Default,,0,0,0,,Бізге J лигагерлерінен барын салуды сұрау керек сияқты.
Dialogue: 0,1:11:10.68,1:11:11.85,Default,,0,0,0,,Иә
Dialogue: 0,1:11:11.93,1:11:14.52,Default,,0,0,0,,Барлық стадиондардағы жанкүйерлердің тағдыры қыл үстінде.
Dialogue: 0,1:11:16.39,1:11:18.98,Default,,0,0,0,,Сол 10 ереуілшіге.
Dialogue: 0,1:11:20.31,1:11:21.19,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:11:28.82,1:11:29.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:11:31.66,1:11:32.62,Default,,0,0,0,,- Сіз жеңдіңіз! - (Когоро) Не?
Dialogue: 0,1:11:32.62,1:11:33.70,Default,,0,0,0,,- Сіз жеңдіңіз! - (Когоро) Не?
Dialogue: 0,1:11:32.62,1:11:33.70,Default,,0,0,0,,Sanada Post мені жек көрді!
Dialogue: 0,1:11:33.70,1:11:33.78,Default,,0,0,0,,Sanada Post мені жек көрді!
Dialogue: 0,1:11:33.78,1:11:35.41,Default,,0,0,0,,Sanada Post мені жек көрді!
Dialogue: 0,1:11:33.78,1:11:35.41,Default,,0,0,0,,Санада енді қақпа бағанасында!
Dialogue: 0,1:11:35.49,1:11:37.16,Default,,0,0,0,,Бұл рас па, Конан-кун?
Dialogue: 0,1:11:37.25,1:11:38.87,Default,,0,0,0,,Иә, мен де түсініктемеде айтып отырмын.
Dialogue: 0,1:11:38.96,1:11:41.58,Default,,0,0,0,,Жарайды, енді ұлттық үкімет құтқарылды.
Dialogue: 0,1:11:41.67,1:11:42.84,Default,,0,0,0,,Жоқ, мен әлі білмеймін.
Dialogue: 0,1:11:42.92,1:11:43.79,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:43.88,1:11:46.84,Default,,0,0,0,,Электрондық хабарландыру тақтасындағы күшін жою белгісі расталғаннан кейін
Dialogue: 0,1:11:46.92,1:11:49.72,Default,,0,0,0,,Маған осы көлікпен хабарласу бұйырылды.
Dialogue: 0,1:11:49.80,1:11:50.84,Default,,0,0,0,,Бұл әлі...
Dialogue: 0,1:11:52.22,1:11:53.93,Default,,0,0,0,,Не болды?
Dialogue: 0,1:11:55.81,1:11:56.64,Default,,0,0,0,,Сәлем Санада!
Dialogue: 0,1:11:56.72,1:11:58.56,Default,,0,0,0,,- (Санада) Ах - (Ойыншы) Тез қайт!
Dialogue: 0,1:11:58.64,1:11:59.52,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,1:12:00.64,1:12:04.61,Default,,0,0,0,,Сәлем, Санада! Не істеп жатырсың, епсіз адам?
Dialogue: 0,1:12:04.69,1:12:07.28,Default,,0,0,0,,Соноко, отыр!
Dialogue: 0,1:12:07.36,1:12:11.11,Default,,0,0,0,,Хиго-сан неліктен зардап шекті?
Dialogue: 0,1:12:11.20,1:12:13.45,Default,,0,0,0,,Менімен кездесуге келгеннің мәні жоқ.
Dialogue: 0,1:12:13.53,1:12:14.62,Default,,0,0,0,,Хаха...
Dialogue: 0,1:12:14.70,1:12:18.33,Default,,0,0,0,,Санада! Келесіде шешіп алсаң, қабылдамаймын!
Dialogue: 0,1:12:27.46,1:12:29.34,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:12:29.42,1:12:31.43,Default,,0,0,0,,(буу)
Dialogue: 0,1:12:31.51,1:12:35.60,Default,,0,0,0,,Не? Әрбір стадион - бұл тек тірек.
Dialogue: 0,1:12:35.68,1:12:37.72,Default,,0,0,0,,Мен гол соқпасам да.
Dialogue: 0,1:12:37.81,1:12:39.39,Default,,0,0,0,,Неге сонша бақыттысың?
Dialogue: 0,1:12:39.48,1:12:42.23,Default,,0,0,0,,Таңдалған шабуылшыдан күткендей.
Dialogue: 0,1:12:42.31,1:12:46.40,Default,,0,0,0,,Осы төтенше жағдайда олар бірінен соң бірі көлденең бағанаға соқты...
Dialogue: 0,1:12:46.48,1:12:48.82,Default,,0,0,0,,Иә, бұл өте керемет.
Dialogue: 0,1:12:49.53,1:12:51.95,Default,,0,0,0,,Инспектор: Сонымен қатар, Серезо мен Жубило —
Dialogue: 0,1:12:52.03,1:12:53.82,Default,,0,0,0,,Бомбаны залалсыздандыру расталды
Dialogue: 0,1:12:53.91,1:12:55.16,Default,,0,0,0,,Хмм, түсіндім.
Dialogue: 0,1:12:55.24,1:12:58.41,Default,,0,0,0,,Жарайсыңдар! Бар болғаны 4 қалды
Dialogue: 0,1:12:58.49,1:13:00.45,Default,,0,0,0,,- (Мегуре) Хмм - (Полиция қызметкері) А... Мен көрдім.
Dialogue: 0,1:13:05.00,1:13:06.42,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:06.50,1:13:08.34,Default,,0,0,0,,Сондай-ақ... Моури мырзаға дейін.
Dialogue: 0,1:13:08.42,1:13:11.72,Default,,0,0,0,,Не болды? Қаншама адамдармен
Dialogue: 0,1:13:13.93,1:13:16.05,Default,,0,0,0,,Менің уақытым аз, сондықтан мен тек негізгі ойларды айтамын.
Dialogue: 0,1:13:16.89,1:13:19.47,Default,,0,0,0,,Мен сіздің ұлыңыз Чифумимін.
Dialogue: 0,1:13:19.56,1:13:22.27,Default,,0,0,0,,Жедел жәрдеммен жеткізілген аурухана қайтыс болды
Dialogue: 0,1:13:22.35,1:13:26.27,Default,,0,0,0,,Күні кеше мен оның жарылған Тото стадионының қасында екеніне алаңдадым.
Dialogue: 0,1:13:26.36,1:13:27.86,Default,,0,0,0,,Мен біраз зерттеу жүргіздім.
Dialogue: 0,1:13:28.48,1:13:30.40,Default,,0,0,0,,Сол күні Тото стадионында
Dialogue: 0,1:13:30.48,1:13:33.49,Default,,0,0,0,,J League All-Star ойыны өтті.
Dialogue: 0,1:13:33.57,1:13:36.45,Default,,0,0,0,,Томофумиді алып бара жатқан жедел жәрдем
Dialogue: 0,1:13:36.53,1:13:39.45,Default,,0,0,0,,Стадионның жанынан өтпек болған кезде
Dialogue: 0,1:13:39.54,1:13:43.04,Default,,0,0,0,,Оның жолын толқыған жақтастары жауып тастады.
Dialogue: 0,1:13:43.12,1:13:45.46,Default,,0,0,0,,Жедел жәрдем біраз уақыт тұрып қалды.
Dialogue: 0,1:13:45.54,1:13:46.42,Default,,0,0,0,,- (Мегуре) А... - (Когоро) А?
Dialogue: 0,1:13:47.17,1:13:50.55,Default,,0,0,0,,Қолдаушылар жедел жәрдемді қолдарымен және мегафондарымен ұрды.
Dialogue: 0,1:13:50.63,1:13:52.80,Default,,0,0,0,,Мен сізді қатты шу шығарып жатқаныңызды естідім.
Dialogue: 0,1:13:52.88,1:13:55.59,Default,,0,0,0,,Ал сол жақтастарды басқарған адам...
Dialogue: 0,1:13:55.68,1:13:56.64,Default,,0,0,0,,Әй, есімде!
Dialogue: 0,1:13:57.18,1:13:59.10,Default,,0,0,0,,Иә, бұл Моури мырза еді.
Dialogue: 0,1:13:59.18,1:14:00.10,Default,,0,0,0,,Не?
Dialogue: 0,1:14:00.18,1:14:01.01,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:17.24,1:14:18.49,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:14:20.12,1:14:21.33,Default,,0,0,0,,Иә.
Dialogue: 0,1:14:21.41,1:14:25.08,Default,,0,0,0,,Сол күні ат бәйгесінде алысқа оқ тиіп, әбден мас болдым...
Dialogue: 0,1:14:25.16,1:14:28.33,Default,,0,0,0,,Шүкір, осы уақытқа дейін ұмытып кетіппін.
Dialogue: 0,1:14:28.42,1:14:29.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:14:29.54,1:14:33.92,Default,,0,0,0,,Сол жедел жәрдемде сіздің ұлыңыз болды ма?
Dialogue: 0,1:14:35.05,1:14:37.76,Default,,0,0,0,,Жедел жәрдем қанша уақыт қозғала алмады?
Dialogue: 0,1:14:37.84,1:14:39.89,Default,,0,0,0,,Менің ойымша, бұл бар болғаны екі минутты алды.
Dialogue: 0,1:14:40.68,1:14:45.06,Default,,0,0,0,,Сондықтан Томоджи соның кесірінен өлді деп айта алмаймыз.
Dialogue: 0,1:14:45.14,1:14:46.73,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:14:46.81,1:14:51.86,Default,,0,0,0,,Бірақ егер олардың еркеліктері болмаса, Томофуми аман қалуы мүмкін еді.
Dialogue: 0,1:14:51.94,1:14:53.53,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:53.61,1:14:57.95,Default,,0,0,0,,Мен де ұлым жақсы көретін футболды жақсы көремін.
Dialogue: 0,1:14:58.03,1:14:59.95,Default,,0,0,0,,Әрине J лигасы да
Dialogue: 0,1:15:00.03,1:15:05.70,Default,,0,0,0,,Бірақ Моури мырза мен сол жігіттер ғана мен кешіре алмаймын.
Dialogue: 0,1:15:09.88,1:15:12.96,Default,,0,0,0,,Бұл жанкүйерлер қай клубтан?
Dialogue: 0,1:15:13.05,1:15:15.63,Default,,0,0,0,,Білмеймін, өйткені мен сыртты көре алмадым.
Dialogue: 0,1:15:16.26,1:15:19.13,Default,,0,0,0,,«Тек Когоро Моури және оның жақтастары...»
Dialogue: 0,1:15:19.22,1:15:20.09,Default,,0,0,0,,«Мен қозғала алмаймын» деп айтыңыз
Dialogue: 0,1:15:20.80,1:15:21.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:15:22.05,1:15:24.77,Default,,0,0,0,,Қай клубты қолдайтыныңызды білмеймін.
Dialogue: 0,1:15:24.85,1:15:27.60,Default,,0,0,0,,Матчтар өтетін барлық стадиондарды бомбалаңыз
Dialogue: 0,1:15:27.68,1:15:28.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:28.77,1:15:30.06,Default,,0,0,0,,Мотура мырза
Dialogue: 0,1:15:30.15,1:15:34.27,Default,,0,0,0,,Біз кодтың жауабын ертерек шештік.
Dialogue: 0,1:15:34.36,1:15:37.86,Default,,0,0,0,,Мен директор Сакакиден тексеріп, көзім жетті.
Dialogue: 0,1:15:37.95,1:15:39.24,Default,,0,0,0,,Кінәлі сізсіз.
Dialogue: 0,1:15:39.32,1:15:41.45,Default,,0,0,0,,Е, кім кінәлі...
Dialogue: 0,1:15:42.03,1:15:44.91,Default,,0,0,0,,Томофуми соққан гол қандай соққы болды?
Dialogue: 0,1:15:44.99,1:15:46.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:46.29,1:15:49.54,Default,,0,0,0,,Жарайды... себебі доп көлденең бағананың ортасына тиді.
Dialogue: 0,1:15:49.62,1:15:50.87,Default,,0,0,0,,Мақсатқа...
Dialogue: 0,1:15:51.46,1:15:53.79,Default,,0,0,0,,Қылмыскердің кодталған жауабы да бірдей.
Dialogue: 0,1:15:54.59,1:15:57.84,Default,,0,0,0,,«Допты арқанның ортасына соғу».
Dialogue: 0,1:15:57.92,1:15:59.17,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:09.73,1:16:10.94,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:16:12.23,1:16:13.98,Default,,0,0,0,,Сіз нені айтасыз? Мотура мырза
Dialogue: 0,1:16:14.86,1:16:16.57,Default,,0,0,0,,Сондықтан мен талай рет айтқанымдай,
Dialogue: 0,1:16:16.65,1:16:18.94,Default,,0,0,0,,Жер бетіндегі кінәлілер мен кодтар қандай...
Dialogue: 0,1:16:19.86,1:16:24.91,Default,,0,0,0,,Мотура мырза, біз жоғарыда айтқан жедел жәрдем туралы әңгіме тағы да бар.
Dialogue: 0,1:16:24.99,1:16:25.87,Default,,0,0,0,,А...
Dialogue: 0,1:16:25.95,1:16:28.45,Default,,0,0,0,,Мори және жедел жәрдем көлігін тоқтатқан басқалар
Dialogue: 0,1:16:28.54,1:16:31.21,Default,,0,0,0,,Негізі мен адамдарға көмектесуге тырыстым.
Dialogue: 0,1:16:31.29,1:16:32.37,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:32.46,1:16:33.67,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,1:16:33.75,1:16:35.46,Default,,0,0,0,,Мен ол кезде болдым
Dialogue: 0,1:16:35.54,1:16:39.63,Default,,0,0,0,,Ыстықтан құлап қалған қарияға көмектесу үшін 911-ге хабарластым.
Dialogue: 0,1:16:39.72,1:16:45.05,Default,,0,0,0,,Алғашқы медициналық көмек көрсету кезінде жедел жәрдемнің келуін күттім.
Dialogue: 0,1:16:45.14,1:16:47.01,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:47.10,1:16:49.02,Default,,0,0,0,,Әй, сен келдіңіз бе?
Dialogue: 0,1:16:49.77,1:16:52.98,Default,,0,0,0,,Барлығың жолыңды босатыңдар! Жедел жәрдем келді.
Dialogue: 0,1:16:53.06,1:16:53.90,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:56.23,1:16:59.78,Default,,0,0,0,,Қарғыс атсын, әлгі жедел жәрдем көлігі дұрыс емес бұрылды.
Dialogue: 0,1:16:59.86,1:17:02.11,Default,,0,0,0,,Эй, мынау!
Dialogue: 0,1:17:03.78,1:17:04.82,Default,,0,0,0,,Содан кейін—
Dialogue: 0,1:17:04.91,1:17:09.29,Default,,0,0,0,,Мен шақырған жедел жәрдем жүгіріп келіп, қария әйтеуір аман қалды.
Dialogue: 0,1:17:09.37,1:17:10.66,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,1:17:11.25,1:17:13.04,Default,,0,0,0,,Бұл түсінбеушілік болса да—
Dialogue: 0,1:17:13.12,1:17:16.54,Default,,0,0,0,,Ұлыңыздың жедел жәрдем көлігін тоқтатқаным үшін кешіріңіз.
Dialogue: 0,1:17:16.63,1:17:18.75,Default,,0,0,0,,Жек көрсем де шағым айта алмаймын
Dialogue: 0,1:17:18.84,1:17:22.59,Default,,0,0,0,,Бірақ қатысы жоқ адамдарды тарту дұрыс емес.
Dialogue: 0,1:17:22.67,1:17:23.68,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:23.76,1:17:24.89,Default,,0,0,0,,- (Аққу) Мотура мырза - (Мотура) А...
Dialogue: 0,1:17:25.68,1:17:27.64,Default,,0,0,0,,Бомбаны қазір тоқтатыңыз
Dialogue: 0,1:17:27.72,1:17:29.18,Default,,0,0,0,,Мори айтқандай.
Dialogue: 0,1:17:29.26,1:17:31.06,Default,,0,0,0,,Сіз істеп жатқан нәрсе дұрыс емес
Dialogue: 0,1:17:31.14,1:17:33.64,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,1:17:33.73,1:17:34.90,Default,,0,0,0,,Бұл бұрыннан қандай?
Dialogue: 0,1:17:35.52,1:17:39.02,Default,,0,0,0,,Сіз емессіз бе? Стадионға бомбаны кім қойды?
Dialogue: 0,1:17:39.11,1:17:40.32,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:40.40,1:17:41.53,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:17:41.61,1:17:42.49,Default,,0,0,0,,Хмм...
Dialogue: 0,1:17:44.24,1:17:46.45,Default,,0,0,0,,Бұл не деген оғаш сезім...
Dialogue: 0,1:17:48.70,1:17:50.87,Default,,0,0,0,,Инспектор Ширатори сәл
Dialogue: 0,1:17:50.95,1:17:52.41,Default,,0,0,0,,Ах... ах
Dialogue: 0,1:17:57.38,1:18:00.30,Default,,0,0,0,,Іс осылай жалғаса берсе, іс ешқашан бітпейді.
Dialogue: 0,1:18:00.38,1:18:03.13,Default,,0,0,0,,Бұдан артық нақты дәлел жоқ па?
Dialogue: 0,1:18:03.22,1:18:05.76,Default,,0,0,0,,Уақыт шегіне дейін 10 минуттан аз уақыт қалды.
Dialogue: 0,1:18:05.84,1:18:09.22,Default,,0,0,0,,Ах... түсіндім. Бұл біртүрлі сезім...
Dialogue: 0,1:18:10.10,1:18:12.18,Default,,0,0,0,,Бұл адам күткендей...
Dialogue: 0,1:18:29.37,1:18:31.24,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:18:32.91,1:18:35.29,Default,,0,0,0,,Детектив, енді тоқталайық.
Dialogue: 0,1:18:35.37,1:18:38.46,Default,,0,0,0,,Мен бәріңнің маған не үшін келгендеріңді түсіндім.
Dialogue: 0,1:18:39.04,1:18:40.96,Default,,0,0,0,,Бірақ менің оған еш қатысым жоқ.
Dialogue: 0,1:18:41.04,1:18:42.63,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:42.71,1:18:44.97,Default,,0,0,0,,Мен де Мотур-санды кінәлі деп санамаймын.
Dialogue: 0,1:18:45.05,1:18:45.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:46.63,1:18:48.01,Default,,0,0,0,,Өйткені, егер бұл кінәлі болса...
Dialogue: 0,1:18:48.09,1:18:51.60,Default,,0,0,0,,Ойынның қашан аяқталатынын білмей қаласың, солай ма?
Dialogue: 0,1:18:51.68,1:18:52.89,Default,,0,0,0,,Дегенмен, Мотура мырза
Dialogue: 0,1:18:53.56,1:18:56.02,Default,,0,0,0,,Мен сағатыма қараған емеспін.
Dialogue: 0,1:18:56.10,1:18:58.23,Default,,0,0,0,,Инспекторлар қарамаған кезде де.
Dialogue: 0,1:18:58.94,1:19:00.15,Default,,0,0,0,,Бұл рас па, Конан-кун?
Dialogue: 0,1:19:00.23,1:19:02.65,Default,,0,0,0,,Иә, мен оны көптен бері қарап жүрмін.
Dialogue: 0,1:19:02.73,1:19:04.94,Default,,0,0,0,,- (Мегуре) Хмм... - (Когоро) А... а...
Dialogue: 0,1:19:05.53,1:19:06.95,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,1:19:07.03,1:19:09.24,Default,,0,0,0,,Бірақ жарылысты тоқтатудың жолы жоқ.
Dialogue: 0,1:19:09.32,1:19:11.83,Default,,0,0,0,,Бұл Томофумидің атуымен бірдей.
Dialogue: 0,1:19:11.91,1:19:14.83,Default,,0,0,0,,Бұл кездейсоқтық болуы мүмкін емес. Неге жер бетінде...
Dialogue: 0,1:19:15.41,1:19:17.71,Default,,0,0,0,,Боқ... мұнда кел де, басынан баста.
Dialogue: 0,1:19:17.79,1:19:19.00,Default,,0,0,0,,Инспектор!
Dialogue: 0,1:19:19.67,1:19:21.00,Default,,0,0,0,,- (Чиба) Тағы бір жер бар - (Мегуре) Не?
Dialogue: 0,1:19:21.96,1:19:25.46,Default,,0,0,0,,National Big vs. Spirits ойынында бомба тоқтаса, бәрі сол!
Dialogue: 0,1:19:25.55,1:19:28.55,Default,,0,0,0,,О, сен істедің!
Dialogue: 0,1:19:28.63,1:19:31.18,Default,,0,0,0,,Мотура мырза, теледидарды қоса аласыз ба?
Dialogue: 0,1:19:31.26,1:19:32.80,Default,,0,0,0,,Иә...
Dialogue: 0,1:19:32.89,1:19:34.64,Default,,0,0,0,,Бар болғаны бес минут қалды.
Dialogue: 0,1:19:34.72,1:19:37.60,Default,,0,0,0,,Үлкен шабуылшы Санада болғанына сенімдімін.
Dialogue: 0,1:19:37.68,1:19:39.64,Default,,0,0,0,,Бұл Хиго емес пе? Боқ...
Dialogue: 0,1:19:40.40,1:19:42.19,Default,,0,0,0,,Қалған уақытты ескере отырып
Dialogue: 0,1:19:42.27,1:19:44.65,Default,,0,0,0,,Санада-саннан бомбаны тоқтатуды сұраудан басқа амалым жоқ.
Dialogue: 0,1:19:45.36,1:19:46.82,Default,,0,0,0,,Мен қазір істей алатын нәрсе
Dialogue: 0,1:19:46.90,1:19:50.03,Default,,0,0,0,,Нағыз қылмыскерді тезірек табыңыз Ах...
Dialogue: 0,1:19:52.70,1:19:56.75,Default,,0,0,0,,Бұл Мотура-санның телефонындағы фотосурет.
Dialogue: 0,1:19:56.83,1:19:57.79,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:59.71,1:20:03.34,Default,,0,0,0,,Бұл Toshibumi камераға қарамайды.
Dialogue: 0,1:20:04.50,1:20:06.76,Default,,0,0,0,,Сіз кімге қол бұлғап тұрсыз?
Dialogue: 0,1:20:09.38,1:20:10.55,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,1:20:10.63,1:20:12.72,Default,,0,0,0,,Мына бейнені ұстаңыз, суреттегі кім?
Dialogue: 0,1:20:13.51,1:20:14.72,Default,,0,0,0,,Бұл Мотура-сан, солай ма?
Dialogue: 0,1:20:14.81,1:20:15.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:15.89,1:20:20.60,Default,,0,0,0,,Иә, мен видеоға түсірдім, сурет көшенің арғы жағындағы әйелім.
Dialogue: 0,1:20:21.23,1:20:24.56,Default,,0,0,0,,Бұл бейнекамера, солай ма? Мен оны көре аламын ба?
Dialogue: 0,1:20:25.19,1:20:26.48,Default,,0,0,0,,О, маңызды емес.
Dialogue: 0,1:20:26.57,1:20:27.73,Default,,0,0,0,,Рахмет
Dialogue: 0,1:20:29.03,1:20:31.15,Default,,0,0,0,,Менің пікірім дұрыс болса
Dialogue: 0,1:20:32.03,1:20:35.12,Default,,0,0,0,,Ол көрінетін болуы керек.
Dialogue: 0,1:20:35.20,1:20:37.62,Default,,0,0,0,,Міне болды! Бұл адам ба?
Dialogue: 0,1:20:37.70,1:20:39.83,Default,,0,0,0,,О! Бұзықтық емес пе?
Dialogue: 0,1:20:39.91,1:20:40.75,Default,,0,0,0,,Иә
Dialogue: 0,1:20:40.83,1:20:42.79,Default,,0,0,0,,Бұл тамаша орын.
Dialogue: 0,1:20:42.87,1:20:45.79,Default,,0,0,0,,Мотура мырза, дыбыс деңгейін көбірек көтеріңіз.
Dialogue: 0,1:20:45.88,1:20:47.55,Default,,0,0,0,,А, жақсы
Dialogue: 0,1:20:47.63,1:20:50.76,Default,,0,0,0,,Бұзушылық! Санада жеңілді!
Dialogue: 0,1:20:50.84,1:20:54.30,Default,,0,0,0,,Үлкен Осака айып добын жұлып алды!
Dialogue: 0,1:20:54.89,1:20:57.01,Default,,0,0,0,,2 минут қалғанда тамаша қалыпта айып соққысы!
Dialogue: 0,1:20:57.01,1:20:57.93,Default,,0,0,0,,Айып соққысы 2 минут қалғанда тамаша қалыпта!
Dialogue: 0,1:20:57.01,1:20:57.93,Default,,0,0,0,,Санада! Тыныштал, терең дем ал!
Dialogue: 0,1:20:57.93,1:20:58.56,Default,,0,0,0,,Санада! Тыныштал, терең дем ал!
Dialogue: 0,1:20:58.56,1:21:00.52,Default,,0,0,0,,Санада! Тыныштал, терең дем ал!
Dialogue: 0,1:20:58.56,1:21:00.52,Default,,0,0,0,,Санада тепкілеп жатқан сияқты.
Dialogue: 0,1:21:00.52,1:21:01.35,Default,,0,0,0,,Санада тепкілеп жатқан сияқты.
Dialogue: 0,1:21:01.43,1:21:04.77,Default,,0,0,0,,Бүгінгі Санада Мен осы уақытқа дейін мүмкіндіктерді пайдалана алмадым, бірақ...
Dialogue: 0,1:21:04.85,1:21:08.69,Default,,0,0,0,,Жартастың дәл шетінде. Үлкенді құтқаруға бола ма?
Dialogue: 0,1:21:14.32,1:21:15.32,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:17.58,1:21:18.54,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:20.41,1:21:22.79,Default,,0,0,0,,Шешілді!
Dialogue: 0,1:21:22.87,1:21:25.42,Default,,0,0,0,,Үлкен Осака!
Dialogue: 0,1:21:25.50,1:21:26.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:27.54,1:21:30.67,Default,,0,0,0,,- (Когоро) Қалай ойлайсың? -(Мегур) Дұрыс түсіндің бе?
Dialogue: 0,1:21:30.76,1:21:31.97,Default,,0,0,0,,Теледидардан айта алмайсың.
Dialogue: 0,1:21:32.05,1:21:33.22,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:21:33.30,1:21:35.59,Default,,0,0,0,,Тоқта...
Dialogue: 0,1:21:35.68,1:21:37.72,Default,,0,0,0,,Керісінше, рухтар ащы болды!
Dialogue: 0,1:21:37.80,1:21:41.18,Default,,0,0,0,,Сағат бойынша 90 минутқа жуық!
Dialogue: 0,1:21:41.27,1:21:42.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:42.68,1:21:45.44,Default,,0,0,0,,Бұл... соншалықты жаман болды ма?
Dialogue: 0,1:21:53.36,1:21:55.28,Default,,0,0,0,,Хабарландыру уақыты өтті.
Dialogue: 0,1:21:55.91,1:21:57.37,Default,,0,0,0,,Жарылыс неліктен...
Dialogue: 0,1:21:57.45,1:21:59.24,Default,,0,0,0,,Мүмкін бұл қылмыскердің қателігі шығар?
Dialogue: 0,1:21:59.33,1:22:02.20,Default,,0,0,0,,Жоқ, ол жарылған жоқ.
Dialogue: 0,1:22:02.29,1:22:05.33,Default,,0,0,0,,Бірінші соққан адам оны жойған болуы керек.
Dialogue: 0,1:22:05.42,1:22:08.46,Default,,0,0,0,,Менің ойымша, хабарландыру тақтасының жабдығы дұрыс жұмыс істемеді.
Dialogue: 0,1:22:09.09,1:22:11.17,Default,,0,0,0,,Қалай болғанда да жолың болды.
Dialogue: 0,1:22:11.25,1:22:12.21,Default,,0,0,0,,О
Dialogue: 0,1:22:12.30,1:22:15.09,Default,,0,0,0,,Кім кінәлі деген сұрақ қалады...
Dialogue: 0,1:22:15.18,1:22:17.76,Default,,0,0,0,,Сондықтан мен жоқ деймін!
Dialogue: 0,1:22:17.84,1:22:19.97,Default,,0,0,0,,Хмм...
Dialogue: 0,1:22:21.18,1:22:24.02,Default,,0,0,0,,Егер сол адам кінәлі болса
Dialogue: 0,1:22:24.10,1:22:26.27,Default,,0,0,0,,Кінәлі мен мына бала...
Dialogue: 0,1:22:26.90,1:22:28.23,Default,,0,0,0,,-Эй ағай-(Мотура) А?
Dialogue: 0,1:22:28.98,1:22:32.98,Default,,0,0,0,,Сізден Томофуми қайтыс болған уақыт туралы ешкім сұрамады ма?
Dialogue: 0,1:22:33.07,1:22:34.24,Default,,0,0,0,,Хмм.
Dialogue: 0,1:22:34.82,1:22:38.20,Default,,0,0,0,,Қазір ойлап қарасам, әйелімнің біреумен сөйлескенін естідім...
Dialogue: 0,1:22:38.28,1:22:40.95,Default,,0,0,0,,Бірақ басқа адам кім болды?
Dialogue: 0,1:22:41.03,1:22:43.83,Default,,0,0,0,,Бұл кінәлі ме?
Dialogue: 0,1:22:43.91,1:22:45.58,Default,,0,0,0,,Бірақ ол адамға...
Dialogue: 0,1:22:45.66,1:22:46.83,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:47.46,1:22:49.33,Default,,0,0,0,,Бұл құжатты да Чифуми жасаған...
Dialogue: 0,1:22:50.96,1:22:52.13,Default,,0,0,0,,Желім қабығы түсіп кетті...
Dialogue: 0,1:22:52.21,1:22:53.09,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:53.55,1:22:57.47,Default,,0,0,0,,Сол конверттің шетінен желім шығып тұрғандай болды.
Dialogue: 0,1:22:58.26,1:22:59.47,Default,,0,0,0,,Ха! Қарғыс атсын!
Dialogue: 0,1:23:00.18,1:23:03.01,Default,,0,0,0,,Ой, ой... бұл қауіпті!
Dialogue: 0,1:23:04.10,1:23:06.18,Default,,0,0,0,,Ол адам міндетті түрде кінәлі!
Dialogue: 0,1:23:06.27,1:23:09.06,Default,,0,0,0,,...Бұл бомбаның таймері әлі тоқтамағанын білдіреді!
Dialogue: 0,1:23:09.65,1:23:10.52,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,1:23:10.61,1:23:13.65,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:23:14.36,1:23:15.32,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:23:15.40,1:23:16.53,Default,,0,0,0,,Бұл Когоро Моури.
Dialogue: 0,1:23:16.61,1:23:17.90,Default,,0,0,0,,Күте тұрыңыз... мүмкін емес пе?
Dialogue: 0,1:23:17.99,1:23:18.91,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,1:23:18.99,1:23:22.20,Default,,0,0,0,,Қарғыс атқыр... Қазір қайдасың?
Dialogue: 0,1:23:22.28,1:23:23.41,Default,,0,0,0,,Фу…
Dialogue: 0,1:23:23.49,1:23:27.33,Default,,0,0,0,,Сіз маған жете алмайтын сияқтысыз.
Dialogue: 0,1:23:27.41,1:23:28.75,Default,,0,0,0,,Не…
Dialogue: 0,1:23:28.83,1:23:30.21,Default,,0,0,0,,Сізге
Dialogue: 0,1:23:30.29,1:23:33.09,Default,,0,0,0,,11-ші шабуылшыға құқығы жоқ
Dialogue: 0,1:23:33.17,1:23:34.71,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:23:35.92,1:23:38.43,Default,,0,0,0,,Міне, соңғы ысқырық!
Dialogue: 0,1:23:38.43,1:23:38.93,Default,,0,0,0,,Міне, соңғы ысқырық!
Dialogue: 0,1:23:39.01,1:23:43.14,Default,,0,0,0,,Биылғы жеңімпаз клуб - Кашива Рейсол!
Dialogue: 0,1:23:43.85,1:23:46.31,Default,,0,0,0,,Қарғыс атсын, бұл қарқынмен уақытында үлгермейміз!
Dialogue: 0,1:23:46.39,1:23:47.98,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:52.40,1:23:53.52,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,1:23:53.61,1:23:56.32,Default,,0,0,0,,О, одан да маңыздысы, сен мұнда неге келдің?
Dialogue: 0,1:23:56.40,1:23:58.53,Default,,0,0,0,,Мен доктордан бәрін естідім.
Dialogue: 0,1:23:58.61,1:24:00.53,Default,,0,0,0,,Жалғыз бару ұят.
Dialogue: 0,1:24:00.61,1:24:02.07,Default,,0,0,0,,Салқын болуға тырыспаңыз.
Dialogue: 0,1:24:02.66,1:24:03.62,Default,,0,0,0,,Балалар
Dialogue: 0,1:24:03.70,1:24:06.45,Default,,0,0,0,,Мен Конан-кунның қайда екенін бірден білемін.
Dialogue: 0,1:24:06.54,1:24:07.83,Default,,0,0,0,,- Иә? -(Аюми) Эй, Ай Чан.
Dialogue: 0,1:24:08.58,1:24:09.79,Default,,0,0,0,,Фу…
Dialogue: 0,1:24:09.87,1:24:13.88,Default,,0,0,0,,...Доктор. Тото стадионы! Асығыңыз!
Dialogue: 0,1:24:13.96,1:24:15.50,Default,,0,0,0,,Хааа~
Dialogue: 0,1:24:21.38,1:24:23.76,Default,,0,0,0,,Өтінемін, өткізіп жіберіңізші, доктор, уақытымыз аз...
Dialogue: 0,1:24:23.85,1:24:24.97,Default,,0,0,0,,Түсіну
Dialogue: 0,1:24:25.06,1:24:28.06,Default,,0,0,0,,Бірақ неге бұл қайтадан Тото стадионы?
Dialogue: 0,1:24:28.14,1:24:29.77,Default,,0,0,0,,Менің ойымша, бұл жер әлі жөндеуде.
Dialogue: 0,1:24:30.39,1:24:34.73,Default,,0,0,0,,Бұл оқиғаның шығу тегі және түпкі мақсаты осы болды.
Dialogue: 0,1:24:34.81,1:24:37.32,Default,,0,0,0,,Ах! Ран-сан және Соноко-сан
Dialogue: 0,1:24:37.40,1:24:38.36,Default,,0,0,0,,Не!
Dialogue: 0,1:24:38.44,1:24:41.91,Default,,0,0,0,,Мен маусымның аяқталу салтанатын тамашаладым.
Dialogue: 0,1:24:41.99,1:24:45.28,Default,,0,0,0,,Содан кейін Ұлттық стадионның көрермендер креслоларында...
Dialogue: 0,1:24:45.37,1:24:48.87,Default,,0,0,0,,Ран-онни-сан және басқалары ұлттық мектепке барды!
Dialogue: 0,1:24:48.95,1:24:51.92,Default,,0,0,0,,Жоқ, бұл жерде бәрі жақсы болуы керек.
Dialogue: 0,1:24:52.50,1:24:54.00,Default,,0,0,0,,Одан гөрі кінәлі...
Dialogue: 0,1:25:00.80,1:25:04.64,Default,,0,0,0,,Осы жерде қалып, қандай да бір күдікті адамдар шықса, абай болыңыз.
Dialogue: 0,1:25:04.72,1:25:06.18,Default,,0,0,0,,Мен бомба тауып келейін.
Dialogue: 0,1:25:06.26,1:25:07.64,Default,,0,0,0,,- (Аюми) Иә! -(Мицухико) Түсіндім!
Dialogue: 0,1:25:23.53,1:25:26.37,Default,,0,0,0,,Когороның ағасы болса, күтсең де келмейді!
Dialogue: 0,1:25:28.79,1:25:30.20,Default,,0,0,0,,Мен ғана келдім
Dialogue: 0,1:25:31.91,1:25:34.46,Default,,0,0,0,,Айтпақшы, есінен танып қалған күзетшілер
Dialogue: 0,1:25:34.54,1:25:36.21,Default,,0,0,0,,Мен барлығына қашып кетуге мүмкіндік бердім.
Dialogue: 0,1:25:36.29,1:25:39.00,Default,,0,0,0,,Жақында полиция келеді деп ойлаймын.
Dialogue: 0,1:25:39.59,1:25:43.72,Default,,0,0,0,,Мен пошта жәшігі картасының айласын таптым.
Dialogue: 0,1:25:43.80,1:25:47.68,Default,,0,0,0,,Карточка Тото стадионы жарылған күні салынған.
Dialogue: 0,1:25:47.76,1:25:50.72,Default,,0,0,0,,Когораның ағасын шақырмас бұрын
Dialogue: 0,1:25:50.81,1:25:55.48,Default,,0,0,0,,Мен оны пошта жәшігінің артқы жағына орналастырдым, сонда ол үстіңгі және астыңғы жағының арасына қыстырылды.
Dialogue: 0,1:25:56.60,1:25:59.02,Default,,0,0,0,,Осы пошта жәшігінің пішініне қарап
Dialogue: 0,1:25:59.11,1:26:03.03,Default,,0,0,0,,Егер сіз мұқият қарамасаңыз, артқы жағындағы карталарды көре алмайсыз.
Dialogue: 0,1:26:03.11,1:26:05.15,Default,,0,0,0,,Егер басқа пошта қосылған болса
Dialogue: 0,1:26:05.24,1:26:07.95,Default,,0,0,0,,Менің көзім соған ауып, картаны байқамай қалдым.
Dialogue: 0,1:26:08.62,1:26:12.62,Default,,0,0,0,,Ал сол күні кейінірек, рухтардың қолдаушысы болып көрінді.
Dialogue: 0,1:26:12.70,1:26:14.16,Default,,0,0,0,,Сіз оны пошта арқылы жіберген жоқсыз ба?
Dialogue: 0,1:26:15.08,1:26:19.25,Default,,0,0,0,,Оны пошта жәшігіне салуға болады, бірақ ол сыймайды.
Dialogue: 0,1:26:19.34,1:26:21.80,Default,,0,0,0,,Сонымен қатар, конверттің екі шетінен
Dialogue: 0,1:26:21.88,1:26:25.09,Default,,0,0,0,,Желім шығып тұратындай етіп жасалған пошта сөмкесі.
Dialogue: 0,1:26:25.18,1:26:26.26,Default,,0,0,0,,Хмм...
Dialogue: 0,1:26:26.76,1:26:32.06,Default,,0,0,0,,Әрине, затты жеткізіп жатқан адам қандай да бір тұзаққа түсіп қалмау үшін абай болу керек.
Dialogue: 0,1:26:32.14,1:26:35.18,Default,,0,0,0,,Поштаның артқы жағына тигенше пошта жәшігіне итеріңіз.
Dialogue: 0,1:26:35.77,1:26:38.69,Default,,0,0,0,,Артқы жағында еңкейіп тұрған картада
Dialogue: 0,1:26:38.77,1:26:41.32,Default,,0,0,0,,Пошта қалтасынан шығып тұрған желім жабысып қалады.
Dialogue: 0,1:26:41.40,1:26:44.24,Default,,0,0,0,,Пошта алынған кезде, карта келесідей болады
Dialogue: 0,1:26:44.32,1:26:48.49,Default,,0,0,0,,Пошта жәшігінің алдыңғы жағына жаңа келген сияқты жылжытыңыз.
Dialogue: 0,1:26:48.95,1:26:49.99,Default,,0,0,0,,Енді карта
Dialogue: 0,1:26:50.07,1:26:53.70,Default,,0,0,0,,Менің ойымша, оны бір күн бұрын пошта жәшігіне қараған соң қойды.
Dialogue: 0,1:26:53.79,1:26:56.71,Default,,0,0,0,,Әліби құрастыру аяқталды.
Dialogue: 0,1:26:57.37,1:27:02.46,Default,,0,0,0,,Керісінше, бұл жағдайда мінсіз әліби бар адам кінәлі болып табылады.
Dialogue: 0,1:27:02.55,1:27:03.42,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,1:27:04.17,1:27:07.34,Default,,0,0,0,,Осы уақытта оны полиция тұтқындап, қамауда отырды.
Dialogue: 0,1:27:07.43,1:27:09.93,Default,,0,0,0,,Менің алибим бар.
Dialogue: 0,1:27:10.01,1:27:13.43,Default,,0,0,0,,Кайдо орта мектебінің бұрынғы Эйс шабуылшысы
Dialogue: 0,1:27:13.51,1:27:15.85,Default,,0,0,0,,Казумаса Накаока
Dialogue: 0,1:27:15.93,1:27:20.15,Default,,0,0,0,,Бұл бала үшін үлкен мәселе. Оның аты кім еді?
Dialogue: 0,1:27:20.81,1:27:24.11,Default,,0,0,0,,Конан Эдогава детективі
Dialogue: 0,1:27:27.15,1:27:29.53,Default,,0,0,0,,- (Мицухико) Ешкім өтіп бара жатқан жоқ. - (Аюми) Иә.
Dialogue: 0,1:27:29.61,1:27:31.41,Default,,0,0,0,,Олай болса.
Dialogue: 0,1:27:31.49,1:27:34.66,Default,,0,0,0,,Мүмкін біз де бомбаны табуға көмектесуіміз керек пе?
Dialogue: 0,1:27:35.25,1:27:37.87,Default,,0,0,0,,Күмбезі кең...
Dialogue: 0,1:27:37.96,1:27:39.79,Default,,0,0,0,,Барлығымыз бірігіп іздесек, жылдамырақ болар еді.
Dialogue: 0,1:27:39.87,1:27:42.88,Default,,0,0,0,,Жоқ, күмбездің іші қауіпті.
Dialogue: 0,1:27:42.96,1:27:45.17,Default,,0,0,0,,Эдогава-кун қайтып келгенше... Ах...
Dialogue: 0,1:27:46.01,1:27:48.26,Default,,0,0,0,,- (Хайбара) Әй, балалар! -(Ағаса) Күте тұрыңдар, балалар!
Dialogue: 0,1:27:48.34,1:27:51.18,Default,,0,0,0,,Детектив балалар қозғалыста!
Dialogue: 0,1:27:51.26,1:27:52.22,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:27:52.72,1:27:55.31,Default,,0,0,0,,Егер қиын болса, мені дереу қайтарыңыз.
Dialogue: 0,1:27:55.39,1:27:56.64,Default,,0,0,0,,- (Хайбара) Дәрігер осында күтіп тұр - (Ағаса) А?
Dialogue: 0,1:27:56.72,1:27:59.06,Default,,0,0,0,,Балаларды маған қалдырыңыз
Dialogue: 0,1:27:59.14,1:28:00.73,Default,,0,0,0,,Егер кінәлі қашып кетсе, доктор.
Dialogue: 0,1:28:00.81,1:28:02.94,Default,,0,0,0,,Тез жету үшін қозғалтқышты іске қосыңыз!
Dialogue: 0,1:28:03.02,1:28:04.86,Default,,0,0,0,,А... а...
Dialogue: 0,1:28:06.40,1:28:09.74,Default,,0,0,0,,Сонымен? Чиши-кунды қашан кездестірдіңіз?
Dialogue: 0,1:28:10.82,1:28:14.33,Default,,0,0,0,,Ах... неге мен және Томодзи...
Dialogue: 0,1:28:14.41,1:28:17.20,Default,,0,0,0,,Мотура-сан түсірген бейнеде көрсетілді.
Dialogue: 0,1:28:18.25,1:28:22.21,Default,,0,0,0,,Мен Накаока мырзаның Томофумимен сигнал алмасып жатқанын көріп тұрмын.
Dialogue: 0,1:28:22.88,1:28:26.05,Default,,0,0,0,,Біз орта мектептің үшінші курсында танысқан шығармыз, солай ма?
Dialogue: 0,1:28:26.88,1:28:30.68,Default,,0,0,0,,Орналасқан жері Кайдо саябағының жері. Өз бетімен жаттығатын уақыт емес пе?
Dialogue: 0,1:28:30.76,1:28:33.14,Default,,0,0,0,,А... сен, неге?
Dialogue: 0,1:28:33.76,1:28:36.97,Default,,0,0,0,,Накаока мырза оқыған Кавайдо орта мектебінің жатақханасы
Dialogue: 0,1:28:37.06,1:28:39.02,Default,,0,0,0,,Кайдо саябағының жанында.
Dialogue: 0,1:28:39.10,1:28:43.31,Default,,0,0,0,,Ата-анамның үйі Гунмада екенін естідім, сондықтан олар жатақханада тұрады деп ойладым.
Dialogue: 0,1:28:43.94,1:28:48.23,Default,,0,0,0,,Накаока мырза, сіз жаттығуды бақылап тұрған Томофумиге қоңырау шалдыңыз, солай ма?
Dialogue: 0,1:28:49.44,1:28:53.66,Default,,0,0,0,,Накаока мырзаға баяғыда Кадзу жақындағандай.
Dialogue: 0,1:28:53.74,1:28:54.82,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:56.24,1:28:57.79,Default,,0,0,0,,Бала, сен футболды ұнатасың ба?
Dialogue: 0,1:28:58.41,1:28:59.41,Default,,0,0,0,,Иә!
Dialogue: 0,1:29:03.42,1:29:04.54,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:05.21,1:29:09.17,Default,,0,0,0,,Томофуми екеуміз алғаш рет орта мектептің үшінші жылының көктемінде кездестік.
Dialogue: 0,1:29:09.26,1:29:13.38,Default,,0,0,0,,Сіз айтқандай, мен Кайдо саябағында өз бетіммен жаттығатынмын.
Dialogue: 0,1:29:17.10,1:29:18.39,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:29:24.94,1:29:26.19,Default,,0,0,0,,​​О?
Dialogue: 0,1:29:26.27,1:29:28.61,Default,,0,0,0,,Уау~ хахаха...
Dialogue: 0,1:29:33.49,1:29:35.45,Default,,0,0,0,,Денесі әлсіз туылған
Dialogue: 0,1:29:35.53,1:29:38.45,Default,,0,0,0,,Томодзи ауыр жаттығулар жасай алмады.
Dialogue: 0,1:29:38.53,1:29:41.12,Default,,0,0,0,,Бірте-бірте менің тәжірибеме қатыса бастадыңыз.
Dialogue: 0,1:29:48.46,1:29:49.92,Default,,0,0,0,,А... а...
Dialogue: 0,1:29:50.00,1:29:51.09,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:52.30,1:29:54.80,Default,,0,0,0,,Мен және Томофумимен бірге жаттығыңыз
Dialogue: 0,1:29:54.88,1:29:57.05,Default,,0,0,0,,Сол жылдың қысына дейін созылды
Dialogue: 0,1:30:01.39,1:30:04.60,Default,,0,0,0,,Осы уақытта мен орта мектептің біріншілігін жеңіп алдым.
Dialogue: 0,1:30:04.69,1:30:08.48,Default,,0,0,0,,Мен ұлттық чемпионаттарда жеңіс голын соғып, Томодзимен бірге тойладым.
Dialogue: 0,1:30:08.98,1:30:11.94,Default,,0,0,0,,Иә! Мен мұны Томофумиге жасаймын.
Dialogue: 0,1:30:12.49,1:30:15.78,Default,,0,0,0,,Бір күні мен ойынға қатысып, гол соға аламын.
Dialogue: 0,1:30:15.86,1:30:17.28,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:30:20.87,1:30:24.46,Default,,0,0,0,,Бірақ ақпан айында Накаока мырза мотоциклмен апатқа ұшырады.
Dialogue: 0,1:30:25.21,1:30:27.88,Default,,0,0,0,,Менің ойымша, сіздің Томофумимен қарым-қатынасыңыз аяқталды.
Dialogue: 0,1:30:27.96,1:30:28.84,Default,,0,0,0,,О
Dialogue: 0,1:30:30.09,1:30:34.05,Default,,0,0,0,,Операциядан кейінгі алты айлық оңалту сәтсіз өтті.
Dialogue: 0,1:30:34.13,1:30:36.59,Default,,0,0,0,,Мен қашу үшін Оңтүстік Америкаға кеттім.
Dialogue: 0,1:30:36.68,1:30:39.01,Default,,0,0,0,,Осы жылдың маусым айы
Dialogue: 0,1:30:39.10,1:30:41.76,Default,,0,0,0,,Мен Кайдо саябағына біраз уақыттан кейін алғаш рет барғанымда...
Dialogue: 0,1:30:42.43,1:30:43.31,Default,,0,0,0,,Томоси!
Dialogue: 0,1:30:43.39,1:30:45.73,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,1:30:46.52,1:30:48.65,Default,,0,0,0,,Төртінші курста оқитын Томодзи
Dialogue: 0,1:30:48.73,1:30:51.23,Default,,0,0,0,,Ол Кавайто Таундағы футбол командасында болды.
Dialogue: 0,1:30:52.15,1:30:53.61,Default,,0,0,0,,Дене әлсіз болғандықтан
Dialogue: 0,1:30:53.69,1:30:56.45,Default,,0,0,0,,Ойын барысында мен жай ғана орындықта демалып отырдым.
Dialogue: 0,1:30:57.03,1:31:00.87,Default,,0,0,0,,Жаттықтырушы одан келесі ойында аздап ойнағың келе ме деп сұрады.
Dialogue: 0,1:31:01.83,1:31:05.20,Default,,0,0,0,,Егер Томодзимен сол ойында гол соқсам ше?
Dialogue: 0,1:31:05.29,1:31:07.71,Default,,0,0,0,,Мен саған тост беруге уәде бердім.
Dialogue: 0,1:31:09.79,1:31:14.92,Default,,0,0,0,,Және уәде еткендей, Томофуми матчта гол соқты.
Dialogue: 0,1:31:15.76,1:31:19.68,Default,,0,0,0,,Соны көргеннен кейін мен қайталап көрейін деп шештім.
Dialogue: 0,1:31:20.26,1:31:21.14,Default,,0,0,0,,Жылдам, ЖоЖоны әкел!
Dialogue: 0,1:31:37.36,1:31:38.45,Default,,0,0,0,,Сонымен
Dialogue: 0,1:31:38.53,1:31:40.99,Default,,0,0,0,,Когораның ағасы мен жақтастарына
Dialogue: 0,1:31:41.07,1:31:42.74,Default,,0,0,0,,Сен кек алғың келді.
Dialogue: 0,1:31:42.83,1:31:43.70,Default,,0,0,0,,О
Dialogue: 0,1:31:44.54,1:31:47.04,Default,,0,0,0,,Бомбаны қалай алдың?
Dialogue: 0,1:31:47.12,1:31:50.54,Default,,0,0,0,,Мен Оңтүстік Америкада кездестірген жігіттердің бірі осы істің кәсіби маманы болатын.
Dialogue: 0,1:31:51.17,1:31:54.75,Default,,0,0,0,,Сіз бұл бомбаларды тоғыз стадионға қойдыңыз.
Dialogue: 0,1:31:54.84,1:31:58.93,Default,,0,0,0,,Ал 10-шы стадион Ұлттық емес.
Dialogue: 0,1:31:59.01,1:32:01.34,Default,,0,0,0,,Бұл Тото стадионы болды.
Dialogue: 0,1:32:02.93,1:32:06.31,Default,,0,0,0,,Бұл ұлттық үкіметте орнатылған манекен сенсор емес пе?
Dialogue: 0,1:32:06.39,1:32:09.23,Default,,0,0,0,,Сол себепті мен Санаданың соққысына жауап бермедім.
Dialogue: 0,1:32:10.27,1:32:14.98,Default,,0,0,0,,Мен Накаока мырза үшін қасиетті орын болғандықтан, мен National дегенді алып тастадым.
Dialogue: 0,1:32:15.07,1:32:17.94,Default,,0,0,0,,Оның орнына Накаока мырза J Leaguer болады.
Dialogue: 0,1:32:18.03,1:32:20.15,Default,,0,0,0,,Мен алаңда болғым келді.
Dialogue: 0,1:32:20.24,1:32:22.57,Default,,0,0,0,,Осы Тото стадионына бомба қойылған.
Dialogue: 0,1:32:23.16,1:32:26.08,Default,,0,0,0,,Мен оны 5:50-де жарылуға қойдым.
Dialogue: 0,1:32:26.87,1:32:30.08,Default,,0,0,0,,Когоро ағасы кодты бұзып, осында келсе ше?
Dialogue: 0,1:32:30.16,1:32:32.00,Default,,0,0,0,,Бірге өлетіндей.
Dialogue: 0,1:32:34.50,1:32:36.50,Default,,0,0,0,,Бұл 5:50
Dialogue: 0,1:32:36.59,1:32:41.01,Default,,0,0,0,,Қарлы ұлттық саябақта Хаппо орта мектебі Жапониядағы ең үздік мектеп болған кез.
Dialogue: 0,1:32:41.09,1:32:42.43,Default,,0,0,0,,(Ойыншылар қолдайды)
Dialogue: 0,1:32:43.59,1:32:46.72,Default,,0,0,0,,Сондықтан «5:50-де» деп жазбаңыз.
Dialogue: 0,1:32:46.81,1:32:49.39,Default,,0,0,0,,Мен «ойын аяқталған кезде» деп жаздым.
Dialogue: 0,1:32:49.48,1:32:51.31,Default,,0,0,0,,Иә
Dialogue: 0,1:32:51.89,1:32:56.11,Default,,0,0,0,,Бұл финал мен үшін соңғы футбол матчы болды.
Dialogue: 0,1:32:56.19,1:32:58.23,Default,,0,0,0,,Менің соңым осы жерден басталады.
Dialogue: 0,1:32:58.90,1:33:00.49,Default,,0,0,0,,Накаока мырза
Dialogue: 0,1:33:00.57,1:33:04.03,Default,,0,0,0,,Алаңда 90 минут тұра алмайтындар үшін
Dialogue: 0,1:33:04.12,1:33:07.41,Default,,0,0,0,,Ол өзінің футбол ойнауға жарамды емес екенін айтты.
Dialogue: 0,1:33:07.49,1:33:08.62,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:33:08.70,1:33:09.58,Default,,0,0,0,,Не?
Dialogue: 0,1:33:10.16,1:33:15.08,Default,,0,0,0,,Физикалық тұрғыдан әлсіз және бірнеше матчқа ғана қатыса алатын Томодзиге.
Dialogue: 0,1:33:15.17,1:33:17.04,Default,,0,0,0,,Сіз футбол ойнауға жарамды емессіз бе?
Dialogue: 0,1:33:17.13,1:33:18.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:18.59,1:33:21.01,Default,,0,0,0,,Егер сіз алаңда тек 15 минут бола алсаңыз
Dialogue: 0,1:33:21.09,1:33:23.34,Default,,0,0,0,,Тек оны пайдаланудың жолын табыңыз.
Dialogue: 0,1:33:24.72,1:33:28.43,Default,,0,0,0,,Мм... Сендей бала не біледі?
Dialogue: 0,1:33:28.51,1:33:30.14,Default,,0,0,0,,Ендеше, енді біз сол орта мектепті тексереміз және—
Dialogue: 0,1:33:30.22,1:33:32.77,Default,,0,0,0,,Бірақ нағыз J Leaguer мұны айтқан болар еді.
Dialogue: 0,1:33:32.85,1:33:35.94,Default,,0,0,0,,Сіз нағыз футболды білмейсіз
Dialogue: 0,1:33:36.48,1:33:39.36,Default,,0,0,0,,Егер сіз оны өз жолыңызбен барынша пайдаланудың жолын тапсаңыз
Dialogue: 0,1:33:39.44,1:33:42.11,Default,,0,0,0,,Жағымды өзгертуге болатын нәрселер көп.
Dialogue: 0,1:33:42.24,1:33:43.07,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,1:33:43.15,1:33:44.41,Default,,0,0,0,,Және Накаока мырза
Dialogue: 0,1:33:44.49,1:33:46.70,Default,,0,0,0,,Сіз әлі де білмейтін нәрсе бар
Dialogue: 0,1:33:47.41,1:33:48.53,Default,,0,0,0,,Бұл...
Dialogue: 0,1:33:49.83,1:33:51.58,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:33:51.66,1:33:55.00,Default,,0,0,0,,Уау! Барлығына жақсы!
Dialogue: 0,1:33:55.08,1:33:57.50,Default,,0,0,0,,Shiodome Arena-ға не болды?
Dialogue: 0,1:33:57.59,1:33:59.30,Default,,0,0,0,,Иә!
Dialogue: 0,1:33:59.38,1:34:01.05,Default,,0,0,0,,Ештеңе шықпайды...
Dialogue: 0,1:34:01.13,1:34:03.38,Default,,0,0,0,,Ах, батарея бітті.
Dialogue: 0,1:34:04.63,1:34:06.97,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,1:34:07.05,1:34:10.72,Default,,0,0,0,,Когоро Моури және оның жақтастары адамдарға көмектесуге тырысты!
Dialogue: 0,1:34:11.31,1:34:12.48,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,1:34:12.56,1:34:13.60,Default,,0,0,0,,Бұл өтірік емес!
Dialogue: 0,1:34:13.68,1:34:16.23,Default,,0,0,0,,Бұл шындық, Накаока-сан.
Dialogue: 0,1:34:16.31,1:34:19.07,Default,,0,0,0,,Аа... Осындай ойдан шығарылған әңгімеге алданып қалған шығармын.
Dialogue: 0,1:34:19.15,1:34:20.73,Default,,0,0,0,,Ах... Жүр!
Dialogue: 0,1:34:20.82,1:34:23.53,Default,,0,0,0,,Сіз мұны істесеңіз де, Чифуми тек қайғылы болады.
Dialogue: 0,1:34:23.61,1:34:26.91,Default,,0,0,0,,Кешіріңіз, бірақ енді артқа жол жоқ.
Dialogue: 0,1:34:27.99,1:34:29.12,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:34:31.16,1:34:32.54,Default,,0,0,0,,Уф...
Dialogue: 0,1:34:33.16,1:34:34.25,Default,,0,0,0,,(Балалардың айқайы)
Dialogue: 0,1:34:35.08,1:34:36.46,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,1:34:36.54,1:34:37.42,Default,,0,0,0,,Бөліп, ізденейік
Dialogue: 0,1:34:37.50,1:34:38.46,Default,,0,0,0,,- (Мицухико) Әй... - (Гента) Ой!
Dialogue: 0,1:34:38.54,1:34:41.92,Default,,0,0,0,,Е, күте тұрыңыз... Гента-кун, Аюми-чан, күте тұрыңыз.
Dialogue: 0,1:34:43.05,1:34:46.38,Default,,0,0,0,,А, бұл жаман. Барлығын тез эвакуациялау керек.
Dialogue: 0,1:34:47.18,1:34:50.35,Default,,0,0,0,,Енді бомбаны тоқтатудың бір ғана жолы бар.
Dialogue: 0,1:34:51.39,1:34:53.31,Default,,0,0,0,,Электрондық хабарландыру тақтасына қараңыз
Dialogue: 0,1:34:53.89,1:34:57.52,Default,,0,0,0,,Бұл енді мағынасыз, бірақ Striker үшін сынақ ретінде.
Dialogue: 0,1:34:57.60,1:35:01.77,Default,,0,0,0,,Бұдан былай жарылыс минут сайын қайталанады.
Dialogue: 0,1:35:01.86,1:35:04.28,Default,,0,0,0,,Ақырында, егер бұл зат жарылып кетсе,
Dialogue: 0,1:35:05.07,1:35:08.66,Default,,0,0,0,,Әртүрлі жерге қойылған бомбалар жарылып, бәрі бітеді.
Dialogue: 0,1:35:09.41,1:35:12.62,Default,,0,0,0,,Сол қанішер детектив өз жақтастарымен бірге өледі.
Dialogue: 0,1:35:12.70,1:35:15.08,Default,,0,0,0,,А... Ағай мен оның жақтастары өледі ме?
Dialogue: 0,1:35:15.16,1:35:19.54,Default,,0,0,0,,Бала, сіздің пікіріңізде бір үлкен қателік бар.
Dialogue: 0,1:35:19.63,1:35:21.75,Default,,0,0,0,,Бұл жерде емес пе?
Dialogue: 0,1:35:21.84,1:35:23.21,Default,,0,0,0,,Иә
Dialogue: 0,1:35:23.30,1:35:26.72,Default,,0,0,0,,Бұл стадион қорқыту хатында айтылған стадионға кірмейді.
Dialogue: 0,1:35:27.47,1:35:28.38,Default,,0,0,0,,Сол кезде
Dialogue: 0,1:35:28.47,1:35:31.89,Default,,0,0,0,,Бұл Тото стадионына бомба қойылмаған.
Dialogue: 0,1:35:31.97,1:35:34.68,Default,,0,0,0,,Демек, бұл 10-шы стадион емес.
Dialogue: 0,1:35:34.77,1:35:37.14,Default,,0,0,0,,Бұл 11-ші стадион.
Dialogue: 0,1:35:37.23,1:35:39.10,Default,,0,0,0,,Сонда 10-шы стадион —
Dialogue: 0,1:35:39.85,1:35:41.56,Default,,0,0,0,,Ұлттық стадион!
Dialogue: 0,1:35:42.19,1:35:47.07,Default,,0,0,0,,Сонымен... Сондықтан ойын аяқталғаннан кейін 35 минут бойы бомба операцияларына тыйым салынады...
Dialogue: 0,1:35:47.15,1:35:50.20,Default,,0,0,0,,Бұл олардың ұлттық бомбаны табуына кедергі болды ма?
Dialogue: 0,1:35:50.28,1:35:53.41,Default,,0,0,0,,Иә, Ұлттық бомба - бұл сөмкедегі детонатор...
Dialogue: 0,1:35:53.49,1:35:55.08,Default,,0,0,0,,Бұл бір-бірімен байланысатын механизм.
Dialogue: 0,1:35:55.62,1:35:59.29,Default,,0,0,0,,Жарылыс ойын аяқталуға 4 минут қалғанда мен Ұлттық құрамаға гол соққанда болды.
Dialogue: 0,1:35:59.37,1:36:01.75,Default,,0,0,0,,Өйткені бұл мен өмірімді арнаған киелі жер...
Dialogue: 0,1:36:01.83,1:36:05.21,Default,,0,0,0,,Мен өмірімнің соңында оны жоғалтуды шештім.
Dialogue: 0,1:36:20.44,1:36:21.44,Default,,0,0,0,,Ах!
Dialogue: 0,1:36:25.11,1:36:26.65,Default,,0,0,0,,(Когоро мен оның достарының ауыр тыныс алуы)
Dialogue: 0,1:36:28.86,1:36:30.57,Default,,0,0,0,,Сен сенімдісің бе, Моури-кун?
Dialogue: 0,1:36:30.65,1:36:33.99,Default,,0,0,0,,Иә, кінәлі менімен мәмілені осы жерде шешеді.
Dialogue: 0,1:36:34.07,1:36:35.41,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:36:35.49,1:36:38.62,Default,,0,0,0,,Мен күзет бөлмесіндегі бақылау камерасына қараймын. Сіз осындасыз!
Dialogue: 0,1:36:38.70,1:36:39.58,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:36:39.66,1:36:42.04,Default,,0,0,0,,Кя! Хиго-сан өте керемет!
Dialogue: 0,1:36:42.12,1:36:44.38,Default,,0,0,0,,Хиго-сан, мен сені сүйемін~ Ах~! Мен мұны көрдім!
Dialogue: 0,1:36:44.38,1:36:47.46,Default,,0,0,0,,Хиго-сан, мен сені сүйемін~ Ах~! Мен мұны көрдім!
Dialogue: 0,1:36:44.38,1:36:47.46,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:36:50.47,1:36:52.64,Default,,0,0,0,,Аа, бұл кім болды екен деп ойлаймын.
Dialogue: 0,1:36:52.72,1:36:54.60,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:54.68,1:36:56.93,Default,,0,0,0,,Шүкір, неге бұзылады!
Dialogue: 0,1:36:57.01,1:36:57.93,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,1:36:59.23,1:37:01.69,Default,,0,0,0,,Өтінемін, жүгіріңіз, шығыңыз!
Dialogue: 0,1:37:01.77,1:37:03.56,Default,,0,0,0,,Автожауап берушіге қосылыңыз
Dialogue: 0,1:37:03.65,1:37:05.36,Default,,0,0,0,,Неге, Ран...
Dialogue: 0,1:37:05.44,1:37:08.53,Default,,0,0,0,,Тез қаш, балам, мен саған кек сақтамаймын.
Dialogue: 0,1:37:09.28,1:37:13.57,Default,,0,0,0,,Бомбаны тек 11-ші шабуылшы ғана тоқтата алады.
Dialogue: 0,1:37:13.66,1:37:16.24,Default,,0,0,0,,Бірақ ол шайқаста жеңіліп қалды және мұнда жоқ.
Dialogue: 0,1:37:17.16,1:37:19.16,Default,,0,0,0,,Кек екі минутта бітеді.
Dialogue: 0,1:37:19.25,1:37:21.91,Default,,0,0,0,,Осы арқылы Томоджидің өкініштері аздап жеңілдей түседі.
Dialogue: 0,1:37:22.00,1:37:23.67,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,1:37:23.75,1:37:27.71,Default,,0,0,0,,Арман бұзылды. Қашқаннан кейін олар Томоджидің өлімін пайдаланды.
Dialogue: 0,1:37:27.80,1:37:29.63,Default,,0,0,0,,Сіз ашуыңызды басқалардан шығарып жатырсыз!
Dialogue: 0,1:37:29.71,1:37:30.55,Default,,0,0,0,,Не!
Dialogue: 0,1:37:30.63,1:37:32.59,Default,,0,0,0,,Өз шектеулеріңізді ерікті түрде анықтау
Dialogue: 0,1:37:32.68,1:37:35.26,Default,,0,0,0,,Армандарынан бас тартқан қорқақ!
Dialogue: 0,1:37:35.34,1:37:37.68,Default,,0,0,0,,Мына бала, айтайын!
Dialogue: 0,1:37:37.76,1:37:40.10,Default,,0,0,0,,Бала Темеден!
Dialogue: 0,1:37:40.18,1:37:42.35,Default,,0,0,0,,Барлығына басқаларды кінәлау -
Dialogue: 0,1:37:42.43,1:37:46.36,Default,,0,0,0,,Сізге ыңғайсыз барлық нәрсені өтірік деп теріске шығарып, оны жоюға тырысыңыз.
Dialogue: 0,1:37:46.44,1:37:48.07,Default,,0,0,0,,Жоқ, сен өзімшіл баласың!
Dialogue: 0,1:37:48.65,1:37:51.99,Default,,0,0,0,,Түсінбейсіз бе? нені жоққа шығарып отырсың
Dialogue: 0,1:37:52.07,1:37:54.78,Default,,0,0,0,,Бұл Томофуми жақсы көретін футбол!
Dialogue: 0,1:37:55.41,1:37:58.83,Default,,0,0,0,,Сіз тіпті Томофумидің естеліктерін жоймақшысыз!
Dialogue: 0,1:37:58.91,1:38:01.29,Default,,0,0,0,,Сіз мұны әлі түсінбейсіз!
Dialogue: 0,1:38:01.37,1:38:04.04,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:38:05.71,1:38:07.25,Default,,0,0,0,,Рас, ағайын.
Dialogue: 0,1:38:07.33,1:38:09.46,Default,,0,0,0,,Ах! Томофуми…
Dialogue: 0,1:38:10.17,1:38:12.63,Default,,0,0,0,,Неге... неге ол білезікті тақтың?
Dialogue: 0,1:38:12.72,1:38:13.80,Default,,0,0,0,,А...
Dialogue: 0,1:38:13.88,1:38:16.76,Default,,0,0,0,,Мен Томоджиге осылай жасадым...
Dialogue: 0,1:38:16.84,1:38:19.60,Default,,0,0,0,,Жоқ, жоқ, бұл шындық болуы мүмкін емес!
Dialogue: 0,1:38:21.10,1:38:22.93,Default,,0,0,0,,Ешкім кінәлі емес.
Dialogue: 0,1:38:23.02,1:38:25.35,Default,,0,0,0,,Ендеше тоқтат, ағайын.
Dialogue: 0,1:38:25.44,1:38:27.10,Default,,0,0,0,,О... міне...
Dialogue: 0,1:38:27.19,1:38:30.07,Default,,0,0,0,,Мен қателесіп жатырмын дейсіз бе? Томофуми
Dialogue: 0,1:38:30.15,1:38:32.78,Default,,0,0,0,,Әй... Мен тұрамын.
Dialogue: 0,1:38:32.86,1:38:35.70,Default,,0,0,0,,Мен жай ғана сенің үйіңе барғым келді.
Dialogue: 0,1:38:35.78,1:38:40.24,Default,,0,0,0,,Бірақ неге сен, Томодзи, мені жоққа шығарасың?
Dialogue: 0,1:38:40.33,1:38:42.16,Default,,0,0,0,,Накаока мырза...
Dialogue: 0,1:38:42.24,1:38:43.45,Default,,0,0,0,,- (Накаока) Менің енді уақытым жоқ - Ах...
Dialogue: 0,1:38:44.12,1:38:46.42,Default,,0,0,0,,Томофуми, қаш.
Dialogue: 0,1:38:47.29,1:38:48.88,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:38:56.09,1:38:58.68,Default,,0,0,0,,Уф... шіркін...
Dialogue: 0,1:38:58.76,1:38:59.64,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:38:59.72,1:39:01.51,Default,,0,0,0,,Әзіл емес!
Dialogue: 0,1:39:03.89,1:39:05.98,Default,,0,0,0,,Сіз бас тартқыңыз келе ме?
Dialogue: 0,1:39:06.64,1:39:08.27,Default,,0,0,0,,Бұл мүмкін емес, бұл баланың күші!
Dialogue: 0,1:39:08.35,1:39:11.65,Default,,0,0,0,,Тоқта! Мен бомбаны міндетті түрде тоқтатамын!
Dialogue: 0,1:39:15.94,1:39:17.99,Default,,0,0,0,,Жүр!
Dialogue: 0,1:39:18.61,1:39:19.49,Default,,0,0,0,,Ах!
Dialogue: 0,1:39:22.45,1:39:24.12,Default,,0,0,0,,Осыншама қиналғаның үшін рахмет. Рақмет.
Dialogue: 0,1:39:29.25,1:39:30.50,Default,,0,0,0,,А...
Dialogue: 0,1:39:38.13,1:39:41.55,Default,,0,0,0,,Бұл... тек бір ғана доп болса да.
Dialogue: 0,1:39:42.35,1:39:45.52,Default,,0,0,0,,Жоқ, тіпті ауыстыру болса да, бұл...
Dialogue: 0,1:39:46.14,1:39:47.10,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:39:47.52,1:39:51.11,Default,,0,0,0,,Бұл үшінші жарылыс, яғни екі минуттан аз уақыт қалды.
Dialogue: 0,1:39:52.02,1:39:52.86,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:39:52.94,1:39:56.32,Default,,0,0,0,,Мен қоқыстардың кесірінен қақпа бағанын тура көздей алмаймын.
Dialogue: 0,1:39:57.07,1:39:57.99,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:39:58.07,1:40:00.82,Default,,0,0,0,,Менің қолымда доп та жоқ.
Dialogue: 0,1:40:00.91,1:40:02.24,Default,,0,0,0,,Не істеу керек...
Dialogue: 0,1:40:02.32,1:40:03.74,Default,,0,0,0,,Конан!
Dialogue: 0,1:40:03.83,1:40:04.87,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:40:05.95,1:40:06.79,Default,,0,0,0,,Аюми!
Dialogue: 0,1:40:06.87,1:40:08.12,Default,,0,0,0,,Мен көмектесуге келдім!
Dialogue: 0,1:40:08.21,1:40:11.04,Default,,0,0,0,,Тез қаш! Ол жарылып кетеді!
Dialogue: 0,1:40:11.13,1:40:12.58,Default,,0,0,0,,- (Гента) Конан! -(Мицухико) Конан!
Dialogue: 0,1:40:13.84,1:40:16.92,Default,,0,0,0,,- (Мицухико) Хахаха... -Мицухико! Гента!
Dialogue: 0,1:40:17.01,1:40:17.88,Default,,0,0,0,,Конан!
Dialogue: 0,1:40:17.97,1:40:20.72,Default,,0,0,0,,Балалар, тез қашыңдар!
Dialogue: 0,1:40:21.47,1:40:24.43,Default,,0,0,0,,Мен бомбаны тоқтатпақ болдым, бірақ допты енді таба алмадым!
Dialogue: 0,1:40:24.51,1:40:25.72,Default,,0,0,0,,Доп бар!
Dialogue: 0,1:40:25.81,1:40:27.68,Default,,0,0,0,,Жасыру добы!
Dialogue: 0,1:40:27.77,1:40:29.77,Default,,0,0,0,,Әйтеуір, мен түсінбеймін.
Dialogue: 0,1:40:29.85,1:40:32.23,Default,,0,0,0,,Егер бұл доп бомбаны тоқтатпаса
Dialogue: 0,1:40:32.31,1:40:33.94,Default,,0,0,0,,Кеттік, Мицухико!
Dialogue: 0,1:40:34.02,1:40:35.69,Default,,0,0,0,,Иә, жақсы ма? Сол доп...
Dialogue: 0,1:40:35.77,1:40:39.32,Default,,0,0,0,,Мұны байыппен қабылдаңыз! Алыңыз!
Dialogue: 0,1:40:39.40,1:40:40.24,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,1:40:41.70,1:40:42.57,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:40:43.37,1:40:46.24,Default,,0,0,0,,Аюми-чан, мына допты Конан-кунға беріңізші!
Dialogue: 0,1:40:46.33,1:40:47.16,Default,,0,0,0,,Иә!
Dialogue: 0,1:40:48.29,1:40:50.79,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:40:50.87,1:40:51.83,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:40:51.92,1:40:53.29,Default,,0,0,0,,Міне!
Dialogue: 0,1:40:53.38,1:40:55.50,Default,,0,0,0,,Күте тұрыңыз, мен түсіндім!
Dialogue: 0,1:40:55.59,1:40:57.67,Default,,0,0,0,,Жарайды, жарайды Аюми!
Dialogue: 0,1:40:57.76,1:40:59.80,Default,,0,0,0,,- (Мицухико) Тезірек, Конан-кун! -(Аюми) Иә!
Dialogue: 0,1:41:00.55,1:41:02.18,Default,,0,0,0,,А... бірақ мен не істеуім керек?
Dialogue: 0,1:41:02.26,1:41:04.80,Default,,0,0,0,,Аюми мұнша алысқа тепкілей алмайды.
Dialogue: 0,1:41:04.89,1:41:06.93,Default,,0,0,0,,Үйінділерден өте алсаңыз, бәрі жақсы болады!
Dialogue: 0,1:41:07.01,1:41:08.97,Default,,0,0,0,,Футбол сабағын есте сақтаңыз!
Dialogue: 0,1:41:09.06,1:41:10.27,Default,,0,0,0,,Иә!
Dialogue: 0,1:41:11.31,1:41:12.73,Default,,0,0,0,,Сәлем, балалар...
Dialogue: 0,1:41:13.73,1:41:15.40,Default,,0,0,0,,Кеттік, Конан-кун!
Dialogue: 0,1:41:16.90,1:41:17.78,Default,,0,0,0,,Иә!
Dialogue: 0,1:41:19.23,1:41:20.07,Default,,0,0,0,,Әй!
Dialogue: 0,1:41:23.41,1:41:24.53,Default,,0,0,0,,-Аа... а... -(Мицухико) А...
Dialogue: 0,1:41:24.62,1:41:26.45,Default,,0,0,0,,- (Гента) Уау... - (Аюми) Мынау... Бұл...
Dialogue: 0,1:41:29.45,1:41:33.12,Default,,0,0,0,,Сіз мені соңына дейін мазалайсыз.
Dialogue: 0,1:41:33.21,1:41:35.21,Default,,0,0,0,,- (Мицухико) Хайбара мырза! -(Гента) Ия!
Dialogue: 0,1:41:35.29,1:41:39.42,Default,,0,0,0,,Ай Чан, өтінемін! Бұл допты Конанға беріңіз!
Dialogue: 0,1:41:42.51,1:41:43.38,Default,,0,0,0,,Жарайды
Dialogue: 0,1:41:44.51,1:41:47.81,Default,,0,0,0,,Кудо-кун, мен саған әркімнің ойын сеніп тапсырамын.
Dialogue: 0,1:41:47.89,1:41:49.43,Default,,0,0,0,,Алыңыз!
Dialogue: 0,1:41:56.98,1:41:59.15,Default,,0,0,0,,Сендер жоғары деңгейдесіңдер, балалар.
Dialogue: 0,1:42:01.19,1:42:04.07,Default,,0,0,0,,Не... Бұл не? Бұл қандай жігіттер?
Dialogue: 0,1:42:04.99,1:42:06.28,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,1:42:06.37,1:42:09.83,Default,,0,0,0,,Сіз шынымен бомбаны тоқтата аламын деп ойлайсыз ба?
Dialogue: 0,1:42:21.92,1:42:23.42,Default,,0,0,0,,- (Гента) Уау - (Мицухико) Уау~
Dialogue: 0,1:42:23.51,1:42:27.30,Default,,0,0,0,,- (Аюми) Кя! -(Хайбара) Уақыт зымырап өтіп жатыр...
Dialogue: 0,1:42:29.93,1:42:33.48,Default,,0,0,0,,Жоқ... Жоқ, менің тағы бір минутым жоқ.
Dialogue: 0,1:42:38.86,1:42:39.73,Default,,0,0,0,,Хмм...
Dialogue: 0,1:42:41.48,1:42:44.19,Default,,0,0,0,,Үйінділердің кесірінен қақпа бағанын тура көздей алмайсыз.
Dialogue: 0,1:42:45.07,1:42:47.16,Default,,0,0,0,,Егер бұл атылған болса...
Dialogue: 0,1:42:51.16,1:42:52.41,Default,,0,0,0,,Операция ертеңгі күні таңертең өтеді.
Dialogue: 0,1:42:52.49,1:42:56.42,Default,,0,0,0,,Эндо мырза футбол сабағында үйренген айып соққысы!
Dialogue: 0,1:42:57.79,1:42:58.83,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,1:43:01.42,1:43:03.80,Default,,0,0,0,,Доптың алға соғуы
Dialogue: 0,1:43:06.26,1:43:07.89,Default,,0,0,0,,Тебуден гөрі
Dialogue: 0,1:43:10.72,1:43:12.01,Default,,0,0,0,,Оны ысқылағандай!
Dialogue: 0,1:43:14.68,1:43:15.56,Default,,0,0,0,,Соқ!
Dialogue: 0,1:43:20.36,1:43:22.27,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,1:43:23.44,1:43:24.32,Default,,0,0,0,,Хмм... бұл мүмкін емес.
Dialogue: 0,1:43:25.07,1:43:26.78,Default,,0,0,0,,Бұл бұрышта ол тым алыс...
Dialogue: 0,1:43:26.86,1:43:28.11,Default,,0,0,0,,Не!
Dialogue: 0,1:43:28.20,1:43:29.70,Default,,0,0,0,,Бұрылыңыз!
Dialogue: 0,1:43:32.16,1:43:33.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:43.67,1:43:45.55,Default,,0,0,0,,ол кеше ғана болғандай сезіледі.
Dialogue: 0,1:43:46.34,1:43:48.47,Default,,0,0,0,,- (Мицухико) Уф... - (Аюми) Уф... Ах...
Dialogue: 0,1:43:49.13,1:43:50.01,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,1:43:59.39,1:44:01.44,Default,,0,0,0,,Ах... хаха...
Dialogue: 0,1:44:01.52,1:44:04.15,Default,,0,0,0,,-（）～   -（）
Dialogue: 0,1:44:04.23,1:44:06.53,Default,,0,0,0,,Конан-кун Уау!
Dialogue: 0,1:44:09.66,1:44:10.49,Default,,0,0,0,,Фу…
Dialogue: 0,1:44:11.82,1:44:12.70,Default,,0,0,0,,Ах...
Dialogue: 0,1:44:13.99,1:44:15.66,Default,,0,0,0,,- (Накаока) Ол үлкен бала. - Аа...
Dialogue: 0,1:44:20.75,1:44:21.83,Default,,0,0,0,,Фу…
Dialogue: 0,1:44:21.92,1:44:22.83,Default,,0,0,0,,А...
Dialogue: 0,1:44:25.09,1:44:28.51,Default,,0,0,0,,Сіз 11-ші шабуылшы болдыңыз.
Dialogue: 0,1:44:29.84,1:44:30.97,Default,,0,0,0,,Конан Эдогава
Dialogue: 0,1:44:32.30,1:44:33.43,Default,,0,0,0,,Фу…
Dialogue: 0,1:44:34.10,1:44:39.10,Default,,0,0,0,,♪～
Dialogue: 0,1:48:52.48,1:48:57.48,Default,,0,0,0,,～♪
Dialogue: 0,1:48:57.57,1:49:03.07,Default,,0,0,0,,...бірақ біз тұрған стадионға бомба қойылды.
Dialogue: 0,1:49:03.16,1:49:04.45,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:49:04.53,1:49:06.33,Default,,0,0,0,,О, иә, бұл не болды?
Dialogue: 0,1:49:06.41,1:49:07.24,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:49:07.33,1:49:11.00,Default,,0,0,0,,Қараңдаршы, орта мектепте Шиничи допты өткізіп алды.
Dialogue: 0,1:49:11.08,1:49:12.67,Default,,0,0,0,,Бұған не болды...
Dialogue: 0,1:49:12.75,1:49:13.79,Default,,0,0,0,,Онда батарея бар—
Dialogue: 0,1:49:13.88,1:49:15.92,Default,,0,0,0,,Хиденің айып добы! Ах...
Dialogue: 0,1:49:16.00,1:49:16.92,Default,,0,0,0,,Ах!
Dialogue: 0,1:49:17.00,1:49:18.76,Default,,0,0,0,,-Рэн-ни-чан! -(Соноко) Ах!
Dialogue: 0,1:49:20.13,1:49:21.22,Default,,0,0,0,,Ах!
Dialogue: 0,1:49:24.09,1:49:24.97,Default,,0,0,0,,Әй!
Dialogue: 0,1:49:27.60,1:49:28.72,Default,,0,0,0,,Бұл ақ...
Dialogue: 0,1:49:28.81,1:49:29.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:49:31.89,1:49:33.23,Default,,0,0,0,,-Е! -(Мицухико) Иә?
Dialogue: 0,1:49:33.31,1:49:34.77,Default,,0,0,0,,Ядах Конан-кун
Dialogue: 0,1:49:34.85,1:49:35.81,Default,,0,0,0,,Біздің күштеріміздің бұйрығы бойынша, сені ұрлап әкетуге келдім
Dialogue: 0,1:49:35.90,1:49:37.52,Default,,0,0,0,,А... Гакинчо
Dialogue: 0,1:49:37.61,1:49:39.23,Default,,0,0,0,,Иә? Ақ...
Dialogue: 0,1:49:40.07,1:49:40.94,Default,,0,0,0,,Эрогаки
Dialogue: 0,1:49:41.03,1:49:43.41,Default,,0,0,0,,А, жоқ, бұл...
Dialogue: 0,1:49:43.49,1:49:44.41,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:49:44.49,1:49:45.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:49:46.37,1:49:49.04,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,1:49:49.12,1:49:50.41,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,1:49:50.50,1:49:53.83,Default,,0,0,0,,Бұл футбол, сондықтан оны артқа бұрыңыз.
Dialogue: 0,1:49:55.33,1:50:01.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory