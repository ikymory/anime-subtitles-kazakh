Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.18,Default,,0,0,0,,♪~
Dialogue: 0,0:01:22.97,0:01:28.97,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.44,0:01:33.32,Default,,0,0,0,,Сағатты сәл артқа орастырайық
Dialogue: 0,0:01:33.65,0:01:34.53,Default,,0,0,0,,Осы уақытта Джозеф пен басқалар—
Dialogue: 0,0:01:34.65,0:01:36.57,Default,,0,0,0,,Марияның шабуылында болғанда
Dialogue: 0,0:01:36.70,0:01:38.03,Default,,0,0,0,,Джотаро мен басқалар…
Dialogue: 0,0:01:38.16,0:01:40.58,Default,,0,0,0,,(Қыздар сыбырлап)
Dialogue: 0,0:01:41.08,0:01:42.37,Default,,0,0,0,,Иә, ханым
Dialogue: 0,0:01:42.54,0:01:43.62,Default,,0,0,0,,Бурбон вискісі—
Dialogue: 0,0:01:43.70,0:01:45.33,Default,,0,0,0,,содамен араластырылған, өтінемін
Dialogue: 0,0:01:45.75,0:01:46.71,Default,,0,0,0,,Өзіңізге қажетін алыңыз
Dialogue: 0,0:01:46.83,0:01:48.50,Default,,0,0,0,,Ой, қалай дәмді көрінеді
Dialogue: 0,0:01:49.50,0:01:51.46,Default,,0,0,0,,Глоп, глоп, глоп
Dialogue: 0,0:01:51.59,0:01:52.42,Default,,0,0,0,,Жақсы
Dialogue: 0,0:01:52.55,0:01:56.84,Default,,0,0,0,,Күніңізді осылай бастау қандай тамаша, ханым
Dialogue: 0,0:01:56.93,0:01:58.93,Default,,0,0,0,,Шынында да, бәрі жақсы
Dialogue: 0,0:01:59.05,0:02:02.81,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:02:02.93,0:02:03.81,Default,,0,0,0,,Хо хо хо хо
Dialogue: 0,0:02:04.22,0:02:06.77,Default,,0,0,0,,(1-қыз) Өзіңізге ұнағанша торт алыңыз
Dialogue: 0,0:02:06.89,0:02:09.52,Default,,0,0,0,,(2-қыз) О, өтінемін, өзіңізді міндетті сезінбеңіз, ханым
Dialogue: 0,0:02:09.65,0:02:10.48,Default,,0,0,0,,Хо хо хо
Dialogue: 0,0:02:10.98,0:02:14.28,Default,,0,0,0,,(Жан) Хе-хе-хе, балалар қаншалықты кінәсіз ғой, иә?
Dialogue: 0,0:02:14.40,0:02:16.07,Default,,0,0,0,,Сағат тоғызға таяп қалды, иә?
Dialogue: 0,0:02:18.57,0:02:20.99,Default,,0,0,0,,Қарт кісі мен Абдол — күткендей, қатты кешігіп қалды.
Dialogue: 0,0:02:21.33,0:02:22.28,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:22.83,0:02:24.75,Default,,0,0,0,,Айтпасаң да түсінікті — өзің көресің
Dialogue: 0,0:02:24.87,0:02:27.04,Default,,0,0,0,,Мүмкін, барып қарағаным жөн болар.
Dialogue: 0,0:02:27.16,0:02:29.54,Default,,0,0,0,,Ах, қандай қиындық.
Dialogue: 0,0:02:30.21,0:02:31.34,Default,,0,0,0,,Жүр, Игги
Dialogue: 0,0:02:32.59,0:02:33.63,Default,,0,0,0,,Ұф, ұф…
Dialogue: 0,0:02:33.75,0:02:37.84,Default,,0,0,0,,(Жан) Жарайды, жарайды. Ашсың ғой, иә? Мен де.
Dialogue: 0,0:02:38.09,0:02:39.68,Default,,0,0,0,,Ұф, ұф…
Dialogue: 0,0:02:39.80,0:02:42.26,Default,,0,0,0,,Ах, эй! Қайда барасың?
Dialogue: 0,0:02:42.39,0:02:44.10,Default,,0,0,0,,…Ұф, ақымақ ит.
Dialogue: 0,0:02:44.68,0:02:46.10,Default,,0,0,0,,(ДжоДжо) Кеттік. (Жан) Ах!
Dialogue: 0,0:02:51.06,0:02:52.36,Default,,0,0,0,,Эй
Dialogue: 0,0:02:52.73,0:02:55.78,Default,,0,0,0,,Мен де қосылайын
Dialogue: 0,0:02:55.90,0:02:58.07,Default,,0,0,0,,Сенің айтқаныңдай болмайды
Dialogue: 0,0:02:58.20,0:02:59.11,Default,,0,0,0,,Бу-ху
Dialogue: 0,0:02:59.24,0:03:00.78,Default,,0,0,0,,Мен оны айтпақшы емеспін… Аах!
Dialogue: 0,0:03:00.91,0:03:02.28,Default,,0,0,0,,(Қыздар) Аах!
Dialogue: 0,0:03:02.41,0:03:04.62,Default,,0,0,0,,Сағатты сәл артқа орастырайық
Dialogue: 0,0:03:04.74,0:03:05.58,Default,,0,0,0,,Ах
Dialogue: 0,0:03:10.29,0:03:11.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:20.38,0:03:22.09,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:03:22.39,0:03:23.55,Default,,0,0,0,,Хаа
Dialogue: 0,0:03:24.10,0:03:27.18,Default,,0,0,0,,Осы уақытта Джозеф пен басқалар—
Dialogue: 0,0:03:27.31,0:03:29.94,Default,,0,0,0,,Марияның шабуылында болғанда
Dialogue: 0,0:03:30.27,0:03:31.15,Default,,0,0,0,,Иә
Dialogue: 0,0:03:31.77,0:03:33.81,Default,,0,0,0,,Джотаро мен басқалар…
Dialogue: 0,0:03:36.11,0:03:40.99,Default,,0,0,0,,(Қыздар сыбырлап)
Dialogue: 0,0:03:41.28,0:03:43.87,Default,,0,0,0,,Иә, ханым
Dialogue: 0,0:03:45.12,0:03:46.20,Default,,0,0,0,,Бурбон вискісі—
Dialogue: 0,0:03:46.33,0:03:50.79,Default,,0,0,0,,содамен араластырылған, өтінемін
Dialogue: 0,0:03:50.91,0:03:52.67,Default,,0,0,0,,Өзіңізге қажетін алыңыз
Dialogue: 0,0:03:53.00,0:03:55.00,Default,,0,0,0,,Ой, қалай дәмді көрінеді
Dialogue: 0,0:03:55.38,0:03:56.92,Default,,0,0,0,,Глоп, глоп, глоп
Dialogue: 0,0:03:57.05,0:03:59.38,Default,,0,0,0,,Күніңізді осылай бастау қандай тамаша, ханым
Dialogue: 0,0:03:59.51,0:04:00.59,Default,,0,0,0,,Иә
Dialogue: 0,0:04:02.13,0:04:04.14,Default,,0,0,0,,Шынында да, бәрі жақсы
Dialogue: 0,0:04:04.26,0:04:08.02,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:04:08.14,0:04:10.06,Default,,0,0,0,,Хо хо хо хо
Dialogue: 0,0:04:10.18,0:04:14.19,Default,,0,0,0,,(1-қыз) Өзіңізге ұнағанша торт алыңыз
Dialogue: 0,0:04:14.31,0:04:16.36,Default,,0,0,0,,(2-қыз) О, өтінемін, өзіңізді міндетті сезінбеңіз, ханым
Dialogue: 0,0:04:16.48,0:04:18.32,Default,,0,0,0,,Хо хо хо
Dialogue: 0,0:04:18.44,0:04:20.36,Default,,0,0,0,,(Жан) Хе-хе-хе, балалар қаншалықты кінәсіз ғой, иә?
Dialogue: 0,0:04:20.49,0:04:22.82,Default,,0,0,0,,Сағат тоғызға таяп қалды, иә?
Dialogue: 0,0:04:22.95,0:04:25.07,Default,,0,0,0,,Қарт кісі мен Абдол — күткендей, қатты кешігіп қалды.
Dialogue: 0,0:04:25.20,0:04:26.24,Default,,0,0,0,,Хмф!
Dialogue: 0,0:04:28.29,0:04:32.00,Default,,0,0,0,,Ит!? Әрине, мүмкін емес—осы ит!?
Dialogue: 0,0:04:32.25,0:04:33.92,Default,,0,0,0,,Мүмкін, барып қарағаным жөн болар.
Dialogue: 0,0:04:34.04,0:04:37.13,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:04:37.29,0:04:38.71,Default,,0,0,0,,Олар күшті
Dialogue: 0,0:04:38.84,0:04:41.67,Default,,0,0,0,,Ах, қандай қиындық.
Dialogue: 0,0:04:42.01,0:04:45.51,Default,,0,0,0,,Жүр, Игги
Dialogue: 0,0:04:45.84,0:04:48.31,Default,,0,0,0,,Ұф, ұф…
Dialogue: 0,0:04:48.43,0:04:50.35,Default,,0,0,0,,(Жан) Жарайды, жарайды. Ашсың ғой, иә? Мен де.
Dialogue: 0,0:04:50.56,0:04:54.14,Default,,0,0,0,,Ұф, ұф…
Dialogue: 0,0:04:54.35,0:04:56.77,Default,,0,0,0,,Ах, эй! Қайда барасың?
Dialogue: 0,0:05:08.78,0:05:10.83,Default,,0,0,0,,Сен осы жолы сол тікұшаққа мінгің келмейтін шығар, иә?
Dialogue: 0,0:05:11.04,0:05:13.29,Default,,0,0,0,,…Ұф, ақымақ ит.
Dialogue: 0,0:05:20.17,0:05:21.21,Default,,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:05:21.55,0:05:24.05,Default,,0,0,0,,(ДжоДжо) Кеттік. (Жан) Ах!
Dialogue: 0,0:05:24.26,0:05:26.89,Default,,0,0,0,,Мен де қосылайын
Dialogue: 0,0:05:27.01,0:05:27.97,Default,,0,0,0,,Иә
Dialogue: 0,0:05:30.56,0:05:32.72,Default,,0,0,0,,Сенің айтқаныңдай болмайды
Dialogue: 0,0:05:33.14,0:05:34.14,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:35.10,0:05:35.94,Default,,0,0,0,,Қараңғы түсуге аз қалды.
Dialogue: 0,0:05:36.35,0:05:38.61,Default,,0,0,0,,Бу-ху
Dialogue: 0,0:05:39.11,0:05:39.94,Default,,0,0,0,,О
Dialogue: 0,0:05:51.54,0:05:53.29,Default,,0,0,0,,Мен оны айтпақшы емеспін… Аах!
Dialogue: 0,0:05:53.41,0:05:55.25,Default,,0,0,0,,(Қыздар) Аах!
Dialogue: 0,0:05:55.37,0:05:57.17,Default,,0,0,0,,Сағатты сәл артқа орастырайық
Dialogue: 0,0:05:57.62,0:05:59.54,Default,,0,0,0,,Осы уақытта Джозеф пен басқалар—
Dialogue: 0,0:05:59.96,0:06:01.21,Default,,0,0,0,,Марияның шабуылында болғанда
Dialogue: 0,0:06:01.38,0:06:02.71,Default,,0,0,0,,Джотаро мен басқалар…
Dialogue: 0,0:06:03.13,0:06:04.97,Default,,0,0,0,,(Қыздар сыбырлап)
Dialogue: 0,0:06:05.42,0:06:07.05,Default,,0,0,0,,Иә, ханым
Dialogue: 0,0:06:25.86,0:06:27.11,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:27.24,0:06:28.91,Default,,0,0,0,,Бурбон вискісі—
Dialogue: 0,0:06:29.57,0:06:31.45,Default,,0,0,0,,содамен араластырылған, өтінемін
Dialogue: 0,0:06:31.87,0:06:33.91,Default,,0,0,0,,Өзіңізге қажетін алыңыз
Dialogue: 0,0:06:34.70,0:06:36.25,Default,,0,0,0,,Ой, қалай дәмді көрінеді
Dialogue: 0,0:06:36.75,0:06:39.37,Default,,0,0,0,,Өзіңді тым биік ұстама! (Какиёин) Қойсаңшы енді!
Dialogue: 0,0:06:41.34,0:06:44.21,Default,,0,0,0,,Глоп, глоп, глоп
Dialogue: 0,0:06:44.71,0:06:47.47,Default,,0,0,0,,Күніңізді осылай бастау қандай тамаша, ханым
Dialogue: 0,0:06:48.72,0:06:51.85,Default,,0,0,0,,Шынында да, бәрі жақсы
Dialogue: 0,0:06:51.97,0:06:53.85,Default,,0,0,0,,Біз тек адамбыз; бәрі біз қалағандай бола бермейді.
Dialogue: 0,0:06:53.97,0:06:57.14,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:06:57.27,0:07:00.27,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:07:00.40,0:07:02.48,Default,,0,0,0,,Хо хо хо хо
Dialogue: 0,0:07:02.61,0:07:05.53,Default,,0,0,0,,Вертолёт шайқалғандықтан, ол сәл ашулы.
Dialogue: 0,0:07:13.66,0:07:14.83,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:07:14.95,0:07:16.79,Default,,0,0,0,,(1-қыз) Өзіңізге ұнағанша торт алыңыз
Dialogue: 0,0:07:28.05,0:07:29.38,Default,,0,0,0,,(2-қыз) О, өтінемін, өзіңізді міндетті сезінбеңіз, ханым
Dialogue: 0,0:07:30.76,0:07:31.80,Default,,0,0,0,,Уууу… Уф!
Dialogue: 0,0:07:33.93,0:07:36.10,Default,,0,0,0,,Хо хо хо
Dialogue: 0,0:07:36.22,0:07:38.02,Default,,0,0,0,,(Жан) Хе-хе-хе, балалар қаншалықты кінәсіз ғой, иә?
Dialogue: 0,0:07:38.14,0:07:40.98,Default,,0,0,0,,Сағат тоғызға таяп қалды, иә?
Dialogue: 0,0:07:41.10,0:07:43.94,Default,,0,0,0,,Қарт кісі мен Абдол — күткендей, қатты кешігіп қалды.
Dialogue: 0,0:07:44.06,0:07:48.69,Default,,0,0,0,,Мүмкін, барып қарағаным жөн болар.
Dialogue: 0,0:07:49.15,0:07:50.70,Default,,0,0,0,,Уууу… Уф!
Dialogue: 0,0:07:51.11,0:07:53.57,Default,,0,0,0,,Ах, қандай қиындық.
Dialogue: 0,0:07:53.99,0:07:54.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:54.95,0:07:58.41,Default,,0,0,0,,Жүр, Игги
Dialogue: 0,0:07:59.00,0:08:02.00,Default,,0,0,0,,Ұф, ұф…
Dialogue: 0,0:08:02.12,0:08:05.54,Default,,0,0,0,,(Жан) Жарайды, жарайды. Ашсың ғой, иә? Мен де.
Dialogue: 0,0:08:05.67,0:08:08.59,Default,,0,0,0,,Ұф, ұф…
Dialogue: 0,0:08:08.71,0:08:09.55,Default,,0,0,0,,Ах
Dialogue: 0,0:08:11.09,0:08:14.01,Default,,0,0,0,,Жоқ, мүмкіндігім болса қуана отырар едім, бірақ олар Стэнд қолданушылары емес.
Dialogue: 0,0:08:14.26,0:08:15.18,Default,,0,0,0,,Жарайды, кел.
Dialogue: 0,0:08:15.76,0:08:17.26,Default,,0,0,0,,Ах, эй! Қайда барасың?
Dialogue: 0,0:08:17.51,0:08:22.02,Default,,0,0,0,,…Ұф, ақымақ ит.
Dialogue: 0,0:08:22.64,0:08:23.81,Default,,0,0,0,,(ДжоДжо) Кеттік. (Жан) Ах!
Dialogue: 0,0:08:27.07,0:08:28.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:31.53,0:08:32.95,Default,,0,0,0,,Егер сен гүл болсаң—
Dialogue: 0,0:08:34.07,0:08:36.58,Default,,0,0,0,,Мен де қосылайын
Dialogue: 0,0:08:40.41,0:08:41.25,Default,,0,0,0,,Хун
Dialogue: 0,0:08:43.04,0:08:43.87,Default,,0,0,0,,Өл! Мен сенің төменгі ерініңді тіліп өтемін!
Dialogue: 0,0:08:44.29,0:08:45.33,Default,,0,0,0,,Сенің айтқаныңдай болмайды
Dialogue: 0,0:08:45.75,0:08:47.75,Default,,0,0,0,,Бу-ху
Dialogue: 0,0:08:47.88,0:08:49.71,Default,,0,0,0,,Мен оны айтпақшы емеспін… Аах!
Dialogue: 0,0:08:52.22,0:08:53.26,Default,,0,0,0,,(Бала 2) Егер маған чаевые бермесең, жұмаққа бара алмайсың, аға.
Dialogue: 0,0:08:53.88,0:08:54.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:55.84,0:08:57.64,Default,,0,0,0,,(Қыздар) Аах!
Dialogue: 0,0:08:57.76,0:08:59.18,Default,,0,0,0,,Сағатты сәл артқа орастырайық
Dialogue: 0,0:08:59.72,0:09:00.56,Default,,0,0,0,,Өл! Мен сенің төменгі ерініңді тіліп өтемін!
Dialogue: 0,0:09:05.06,0:09:06.86,Default,,0,0,0,,Осы уақытта Джозеф пен басқалар—
Dialogue: 0,0:09:06.98,0:09:09.15,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:09:09.73,0:09:10.94,Default,,0,0,0,,Марияның шабуылында болғанда
Dialogue: 0,0:09:11.74,0:09:13.24,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:09:13.36,0:09:15.11,Default,,0,0,0,,Джотаро мен басқалар…
Dialogue: 0,0:09:15.53,0:09:17.53,Default,,0,0,0,,(Қыздар сыбырлап)
Dialogue: 0,0:09:17.87,0:09:20.29,Default,,0,0,0,,Иә, ханым
Dialogue: 0,0:09:21.45,0:09:22.66,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:09:23.00,0:09:24.66,Default,,0,0,0,,Бурбон вискісі—
Dialogue: 0,0:09:24.79,0:09:26.63,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:09:28.04,0:09:32.05,Default,,0,0,0,,содамен араластырылған, өтінемін
Dialogue: 0,0:09:33.47,0:09:37.39,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:09:37.76,0:09:41.93,Default,,0,0,0,,Өзіңізге қажетін алыңыз
Dialogue: 0,0:09:42.14,0:09:44.18,Default,,0,0,0,,Ой, қалай дәмді көрінеді
Dialogue: 0,0:09:44.48,0:09:47.77,Default,,0,0,0,,Глоп, глоп, глоп
Dialogue: 0,0:09:48.23,0:09:50.86,Default,,0,0,0,,Күніңізді осылай бастау қандай тамаша, ханым
Dialogue: 0,0:09:50.98,0:09:55.40,Default,,0,0,0,,Шынында да, бәрі жақсы
Dialogue: 0,0:09:55.82,0:09:59.03,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:09:59.57,0:10:01.28,Default,,0,0,0,,Хо хо хо хо
Dialogue: 0,0:10:01.70,0:10:02.91,Default,,0,0,0,,(1-қыз) Өзіңізге ұнағанша торт алыңыз
Dialogue: 0,0:10:03.04,0:10:05.46,Default,,0,0,0,,(2-қыз) О, өтінемін, өзіңізді міндетті сезінбеңіз, ханым
Dialogue: 0,0:10:05.58,0:10:08.33,Default,,0,0,0,,Хо хо хо
Dialogue: 0,0:10:08.46,0:10:10.92,Default,,0,0,0,,(Жан) Хе-хе-хе, балалар қаншалықты кінәсіз ғой, иә?
Dialogue: 0,0:10:11.09,0:10:12.63,Default,,0,0,0,,Сағат тоғызға таяп қалды, иә?
Dialogue: 0,0:10:12.75,0:10:15.55,Default,,0,0,0,,Қарт кісі мен Абдол — күткендей, қатты кешігіп қалды.
Dialogue: 0,0:10:15.67,0:10:18.89,Default,,0,0,0,,Мүмкін, барып қарағаным жөн болар.
Dialogue: 0,0:10:19.01,0:10:19.89,Default,,0,0,0,,Жарақат салып жүріп, Магистрдің Қызына дәл ұқсайтын мүсін ойып тастапсың.
Dialogue: 0,0:10:21.39,0:10:23.72,Default,,0,0,0,,Ах, қандай қиындық.
Dialogue: 0,0:10:23.85,0:10:27.77,Default,,0,0,0,,Жүр, Игги
Dialogue: 0,0:10:27.89,0:10:30.61,Default,,0,0,0,,Ұф, ұф…
Dialogue: 0,0:10:30.73,0:10:32.61,Default,,0,0,0,,(Жан) Жарайды, жарайды. Ашсың ғой, иә? Мен де.
Dialogue: 0,0:10:32.73,0:10:35.61,Default,,0,0,0,,Ұф, ұф…
Dialogue: 0,0:10:35.74,0:10:36.74,Default,,0,0,0,,Ах, эй! Қайда барасың?
Dialogue: 0,0:10:36.86,0:10:38.45,Default,,0,0,0,,…Ұф, ақымақ ит.
Dialogue: 0,0:10:40.12,0:10:42.28,Default,,0,0,0,,(ДжоДжо) Кеттік. (Жан) Ах!
Dialogue: 0,0:10:42.41,0:10:46.37,Default,,0,0,0,,Мен де қосылайын
Dialogue: 0,0:10:47.21,0:10:48.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:50.75,0:10:51.79,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:10:52.17,0:10:53.13,Default,,0,0,0,,Ах
Dialogue: 0,0:11:05.06,0:11:08.39,Default,,0,0,0,,Сенің айтқаныңдай болмайды
Dialogue: 0,0:11:08.52,0:11:10.85,Default,,0,0,0,,Бу-ху
Dialogue: 0,0:11:14.61,0:11:15.78,Default,,0,0,0,,Мен оны айтпақшы емеспін… Аах!
Dialogue: 0,0:11:17.61,0:11:21.53,Default,,0,0,0,,(Қыздар) Аах!
Dialogue: 0,0:11:21.66,0:11:25.08,Default,,0,0,0,,Сағатты сәл артқа орастырайық
Dialogue: 0,0:11:32.83,0:11:34.84,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,0:11:35.42,0:11:36.50,Default,,0,0,0,,Осы уақытта Джозеф пен басқалар—
Dialogue: 0,0:11:36.92,0:11:39.38,Default,,0,0,0,,Марияның шабуылында болғанда
Dialogue: 0,0:11:39.51,0:11:41.09,Default,,0,0,0,,Джотаро мен басқалар…
Dialogue: 0,0:11:41.22,0:11:43.60,Default,,0,0,0,,(Қыздар сыбырлап)
Dialogue: 0,0:11:43.72,0:11:45.51,Default,,0,0,0,,Иә, ханым
