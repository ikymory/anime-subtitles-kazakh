Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.05,0:00:26.24,Default,,0000,0000,0000,,Сау бол~
Dialogue: 0,0:00:26.24,0:00:28.24,Default,,0000,0000,0000,,Ертең кездескенше.
Dialogue: 0,0:00:34.32,0:00:36.32,Default,,0000,0000,0000,,Бұл не? Не?
Dialogue: 0,0:00:47.12,0:00:51.12,Default,,0000,0000,0000,,Ааааааааааааааааааааааааа!
Dialogue: 0,0:00:59.24,0:01:01.26,Default,,0000,0000,0000,,Мен қазір үйге баруым керек
Dialogue: 0,0:01:01.26,0:01:03.11,Default,,0000,0000,0000,,Жарайды, бұл ұтыс ойыны.
Dialogue: 0,0:01:03.11,0:01:06.14,Default,,0000,0000,0000,,Қулық! Жеңетін боламыз...
Dialogue: 0,0:01:06.14,0:01:08.16,Default,,0000,0000,0000,,Балалар, беріліңдер.
Dialogue: 0,0:01:08.16,0:01:10.35,Default,,0000,0000,0000,,Иә! Бұл басымдыққа ие
Dialogue: 0,0:01:10.35,0:01:12.03,Default,,0000,0000,0000,,Бағыну деген не?
Dialogue: 0,0:01:12.03,0:01:14.22,Default,,0000,0000,0000,,Өйткені бұл басымдылыққа ие, солай ма?
Dialogue: 0,0:01:14.22,0:01:18.09,Default,,0000,0000,0000,,Ту алынбаса да, олардың берілуге ​​мүмкіндігі жоқ!
Dialogue: 0,0:01:18.09,0:01:20.28,Default,,0000,0000,0000,,Бұл ұтыс ойыны.
Dialogue: 0,0:01:20.28,0:01:23.14,Default,,0000,0000,0000,,Хабардар болу! Неліктен басқа адамның иығынан ұстап тұрсыз?
Dialogue: 0,0:01:23.14,0:01:26.17,Default,,0000,0000,0000,,Бұл ереже. Еш нәрсе істей алмайсың.
Dialogue: 0,0:01:26.17,0:01:28.36,Default,,0000,0000,0000,,Күннің бату уақыты аяқталды
Dialogue: 0,0:01:28.36,0:01:30.05,Default,,0000,0000,0000,,Күн әлі бар!
Dialogue: 0,0:01:30.05,0:01:32.23,Default,,0000,0000,0000,,Сіз оны тек осы жерден көре аласыз!
Dialogue: 0,0:01:32.23,0:01:35.26,Default,,0000,0000,0000,,Мария-чан, мен қазір үйге баруым керек.
Dialogue: 0,0:01:35.26,0:01:38.29,Default,,0000,0000,0000,,«Үйге қайт» дегенді естігенде бірден үйге бару керек
Dialogue: 0,0:01:38.29,0:01:40.31,Default,,0000,0000,0000,,Егер сіз берілсеңіз, сіз бірден үйге бара аласыз.
Dialogue: 0,0:01:40.31,0:01:44.19,Default,,0000,0000,0000,,Балалар... Эй! Сот!
Dialogue: 0,0:01:44.19,0:01:46.37,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:46.37,0:01:48.06,Default,,0000,0000,0000,,Иә? Мүмкін емес!
Dialogue: 0,0:01:48.06,0:01:50.25,Default,,0000,0000,0000,,Төреші тең ойын деп айтуы керек!
Dialogue: 0,0:01:50.25,0:01:52.27,Default,,0000,0000,0000,,Мені соттаңыз!
Dialogue: 0,0:01:52.27,0:01:54.12,Default,,0000,0000,0000,,Иә, бүгін ұтыс ойыны.
Dialogue: 0,0:01:54.12,0:01:56.31,Default,,0000,0000,0000,,Эй Шун!
Dialogue: 0,0:01:56.31,0:01:58.33,Default,,0000,0000,0000,,Біз қазір үйге барамыз.
Dialogue: 0,0:01:58.33,0:02:01.36,Default,,0000,0000,0000,,Күте тұрыңыз! Әлі біткен жоқ...
Dialogue: 0,0:02:01.36,0:02:03.21,Default,,0000,0000,0000,,Қайтарыңыз! Өйткені мысық дамаши шығады.
Dialogue: 0,0:02:03.21,0:02:06.21,Default,,0000,0000,0000,,Ерте маусым~! Біз де үйге барайық
Dialogue: 0,0:02:08.26,0:02:10.28,Default,,0000,0000,0000,,Сіз сол жерден көре аласыз ба?
Dialogue: 0,0:02:10.28,0:02:13.31,Default,,0000,0000,0000,,О... не?
Dialogue: 0,0:02:13.31,0:02:15.31,Default,,0000,0000,0000,,Миноширо
Dialogue: 0,0:02:16.34,0:02:18.19,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:02:18.19,0:02:21.19,Default,,0000,0000,0000,,Иә! Бұл сирек емес!
Dialogue: 0,0:03:29.05,0:03:32.08,Default,,0000,0000,0000,,Мен осы бұзылған ғибадатхананың діни қызметкерімін.
Dialogue: 0,0:03:32.08,0:03:33.27,Default,,0000,0000,0000,,Менің атым Муша.
Dialogue: 0,0:03:33.27,0:03:38.14,Default,,0000,0000,0000,,Ах... Бұл Саки Ватанабе.
Dialogue: 0,0:03:38.14,0:03:41.17,Default,,0000,0000,0000,,Мм, міне... міне?
Dialogue: 0,0:03:41.17,0:03:44.20,Default,,0000,0000,0000,,Бұл ғибадатхана Сейджози деп аталады.
Dialogue: 0,0:03:44.20,0:03:48.08,Default,,0000,0000,0000,,Мм... бұл Хакчо белгісінен тыс па?
Dialogue: 0,0:03:48.08,0:03:51.11,Default,,0000,0000,0000,,Дұрыс, өміріңізде бірінші рет
Dialogue: 0,0:03:51.11,0:03:54.31,Default,,0000,0000,0000,,Бұл сіздің Haccho белгісінен шығып кеткеніңізді білдіреді.
Dialogue: 0,0:03:54.31,0:03:58.18,Default,,0000,0000,0000,,Бұл оның ағасының қабылдау рәсімі ғой, иә?
Dialogue: 0,0:03:58.18,0:04:01.18,Default,,0000,0000,0000,,Өсу гомасын жағу
Dialogue: 0,0:04:15.01,0:04:19.23,Default,,0000,0000,0000,,Жердегі ең соңғы тілектерімізді өртейміз.
Dialogue: 0,0:04:19.23,0:04:22.23,Default,,0000,0000,0000,,Жалынға қараңыз
Dialogue: 0,0:04:24.28,0:04:29.15,Default,,0000,0000,0000,,Жалынды манипуляциялап көріңіз
Dialogue: 0,0:04:29.15,0:04:30.34,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,0:04:30.34,0:04:36.06,Default,,0000,0000,0000,,Жарайды, сенің қолыңнан келеді. Жалынды шайқап көріңіз.
Dialogue: 0,0:04:36.06,0:04:40.06,Default,,0000,0000,0000,,Солға, оңға, теңселіп...
Dialogue: 0,0:04:48.35,0:04:50.35,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:54.25,0:04:57.25,Default,,0000,0000,0000,,Кяах! Ха...
Dialogue: 0,0:05:00.31,0:05:03.34,Default,,0000,0000,0000,,Ерте маусым! Қазір бәрі жақсы!
Dialogue: 0,0:05:03.34,0:05:06.02,Default,,0000,0000,0000,,Бұл не...
Dialogue: 0,0:05:06.02,0:05:09.05,Default,,0000,0000,0000,,Құтты болсын! Ақыры саған келді
Dialogue: 0,0:05:09.05,0:05:10.24,Default,,0000,0000,0000,,Бұл?
Dialogue: 0,0:05:10.24,0:05:13.27,Default,,0000,0000,0000,,Бұл Сақидың да есейгенін білдіреді.
Dialogue: 0,0:05:13.27,0:05:18.14,Default,,0000,0000,0000,,Мен бүгін Вакиенді бітіремін және мен барлығын қамтитын сыныпқа түсемін.
Dialogue: 0,0:05:18.14,0:05:20.16,Default,,0000,0000,0000,,А, жақсы!
Dialogue: 0,0:05:20.16,0:05:23.16,Default,,0000,0000,0000,,Енді ештеңені уайымдаудың қажеті жоқ!
Dialogue: 0,0:05:28.25,0:05:30.25,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:05:36.33,0:05:39.19,Default,,0000,0000,0000,,Міне! Тоқта!
Dialogue: 0,0:05:39.19,0:-5:-14.-13,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:05:42.39,0:05:45.26,Default,,0000,0000,0000,,Бұл сіздің сиқырлы күшіңіз.
Dialogue: 0,0:05:45.26,0:05:48.11,Default,,0000,0000,0000,,Дүние қалауларыңнан бас тарт
Dialogue: 0,0:05:48.11,0:05:49.30,Default,,0000,0000,0000,,Азаттық үшін
Dialogue: 0,0:05:49.30,0:05:52.33,Default,,0000,0000,0000,,Барлығы бір рет таза отта
Dialogue: 0,0:05:52.33,0:05:56.19,Default,,0000,0000,0000,,Күйіп қалу керек
Dialogue: 0,0:05:56.19,0:05:59.23,Default,,0000,0000,0000,,Көктен алған қабілеттеріңізді құдайлар мен Буддаға қайтарыңыз.
Dialogue: 0,0:05:59.23,0:06:03.09,Default,,0000,0000,0000,,Бұдан былай сенің сиқырлы күшің
Dialogue: 0,0:06:03.09,0:06:06.12,Default,,0000,0000,0000,,Мен оны мына қуыршақтың ішіне мөрлеймін.
Dialogue: 0,0:06:06.12,0:06:09.33,Default,,0000,0000,0000,,Қуыршақты орнынан тұру үшін манипуляциялау.
Dialogue: 0,0:06:09.33,0:06:14.33,Default,,0000,0000,0000,,Барлық сезімдеріңізді сол қуыршаққа салыңыз.
Dialogue: 0,0:06:18.08,0:06:19.26,Default,,0000,0000,0000,,Саки Ватанабе!
Dialogue: 0,0:06:19.26,0:06:23.26,Default,,0000,0000,0000,,Сіздің сиқырлы күшіңіз осында бекітілген!
Dialogue: 0,0:06:24.31,0:06:26.31,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:06:30.37,0:06:32.23,Default,,0000,0000,0000,,Жердегі барлық тілектерді өртеңіз
Dialogue: 0,0:06:32.23,0:06:36.09,Default,,0000,0000,0000,,Күлдер шексіз шөл далаға оралуы керек.
Dialogue: 0,0:06:36.09,0:06:38.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:39.30,0:06:42.33,Default,,0000,0000,0000,,Сіздің сиқырлы күшіңіз жоғалып кетті.
Dialogue: 0,0:06:42.33,0:06:45.36,Default,,0000,0000,0000,,Жалынға қараңыз
Dialogue: 0,0:06:45.36,0:06:49.23,Default,,0000,0000,0000,,Сіз енді отты басқара алмайсыз.
Dialogue: 0,0:06:49.23,0:06:54.10,Default,,0000,0000,0000,,Сіз Құдайға және буддизмге қатты берілгенсіз.
Dialogue: 0,0:06:54.10,0:06:57.13,Default,,0000,0000,0000,,Қарғыс күшін өзім әкелдім.
Dialogue: 0,0:06:57.13,0:07:00.34,Default,,0000,0000,0000,,Содан кейін маған дұрыс мантраны беріңіз.
Dialogue: 0,0:07:00.34,0:07:03.19,Default,,0000,0000,0000,,Жаңа рухты шақыру
Dialogue: 0,0:07:03.19,0:07:06.19,Default,,0000,0000,0000,,Сиқырлы күшті қайта қосыңыз
Dialogue: 0,0:07:07.24,0:07:09.24,Default,,0000,0000,0000,,Мантра…
Dialogue: 0,0:07:36.03,0:07:38.90,Default,,0000,0000,0000,,Бүгіннен бастап мен сенің сыныптасың боламын.
Dialogue: 0,0:07:38.90,0:07:41.90,Default,,0000,0000,0000,,Бұл Саки Ватанабе.
Dialogue: 0,0:07:51.02,0:07:53.02,Default,,0000,0000,0000,,Тыныш, сендер!
Dialogue: 0,0:07:54.05,0:07:56.07,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:07:56.07,0:07:58.07,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:08:01.12,0:08:02.97,Default,,0000,0000,0000,,Біз 1-топпыз.
Dialogue: 0,0:08:02.97,0:08:05.16,Default,,0000,0000,0000,,Мамору - Юаиен
Dialogue: 0,0:08:05.16,0:08:07.18,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:08:07.18,0:08:09.03,Default,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:08:09.03,0:08:11.03,Default,,0000,0000,0000,,Кеш болды.
Dialogue: 0,0:08:13.24,0:08:16.27,Default,,0000,0000,0000,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:08:16.27,0:08:19.27,Default,,0000,0000,0000,,Бұл рас! Күтуден шаршадым
Dialogue: 0,0:08:20.14,0:08:22.16,Default,,0000,0000,0000,,Мен кеш гүлдеушімін.
Dialogue: 0,0:08:22.16,0:08:25.19,Default,,0000,0000,0000,,Ерте келген құтты рухтың жақсы болуы шарт емес.
Dialogue: 0,0:08:25.19,0:08:28.22,Default,,0000,0000,0000,,Вакиен-гуми болса да, жақсы.
Dialogue: 0,0:08:28.22,0:08:31.25,Default,,0000,0000,0000,,Не болса да, тым жайбарақат
Dialogue: 0,0:08:31.25,0:08:34.11,Default,,0000,0000,0000,,Тіпті Сатоси де көп өзгерген жоқ!
Dialogue: 0,0:08:34.11,0:08:35.96,Default,,0000,0000,0000,,Не? Билли?
Dialogue: 0,0:08:35.96,0:08:39.96,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Менен басқа адамдар болды ма?
Dialogue: 0,0:08:42.02,0:08:46.02,Default,,0000,0000,0000,,Мисогиді үйге әкеліңіз
Dialogue: 0,0:08:47.07,0:08:49.07,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:08:52.29,0:08:53.98,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:53.98,0:08:57.01,Default,,0000,0000,0000,,Барлығын қамтитын сынып тек академиялық бөлімдерді ғана қамтиды.
Dialogue: 0,0:08:57.01,0:08:59.19,Default,,0000,0000,0000,,Практикалық қабілеттілік тесті бар.
Dialogue: 0,0:08:59.19,0:09:03.07,Default,,0000,0000,0000,,Сіз білесіз бе? Мен толқындық интерференция бойынша сыныбымдағы ең үздік бомбардирмін.
Dialogue: 0,0:09:03.07,0:09:07.27,Default,,0000,0000,0000,,Соққы күшінің алмасуы мүлде жақсы емес.
Dialogue: 0,0:09:07.27,0:09:08.96,Default,,0000,0000,0000,,Дәл қазір бейнелеу маңыздырақ.
Dialogue: 0,0:09:08.96,0:09:11.15,Default,,0000,0000,0000,,Мұғалім осылай деді!
Dialogue: 0,0:09:11.15,0:09:14.18,Default,,0000,0000,0000,,Хаха... а
Dialogue: 0,0:09:14.18,0:09:16.20,Default,,0000,0000,0000,,Ах... Миохо фермасы.
Dialogue: 0,0:09:16.20,0:09:18.05,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:09:18.05,0:09:21.08,Default,,0000,0000,0000,,Мұндағы сол жерде ұқсас Қайда?
Dialogue: 0,0:09:21.08,0:09:24.08,Default,,0000,0000,0000,,Қараңдар, мен Уакиенді көруге бардым.
Dialogue: 0,0:09:29.16,0:09:31.16,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:09:39.09,0:09:41.11,Default,,0000,0000,0000,,Әй, бұл үкі қоңызы емес пе?
Dialogue: 0,0:09:41.11,0:09:44.14,Default,,0000,0000,0000,,Не? Бұл рас! Сөмке бар!
Dialogue: 0,0:09:44.14,0:09:46.14,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:47.17,0:09:50.20,Default,,0000,0000,0000,,Бұл ұқсас па? Сен не туралы айтып тұрсың?
Dialogue: 0,0:09:50.20,0:09:53.23,Default,,0000,0000,0000,,Атмосфера біршама ұқсас.
Dialogue: 0,0:09:53.23,0:09:55.25,Default,,0000,0000,0000,,Мен мағынасын түсінбеймін
Dialogue: 0,0:09:55.25,0:09:58.28,Default,,0000,0000,0000,,Ерте маусым! Екінші кезең – жындар мен жындар туралы сабақ.
Dialogue: 0,0:09:58.28,0:10:01.31,Default,,0000,0000,0000,,Иә... сіз мұны әлі жасайсыз ба?
Dialogue: 0,0:10:01.31,0:10:04.34,Default,,0000,0000,0000,,Маған бұл ұнамайды.
Dialogue: 0,0:10:04.34,0:10:07.21,Default,,0000,0000,0000,,Вакиендегі уақыттан айырмашылығы, бұл толық нұсқасы.
Dialogue: 0,0:10:07.21,0:10:09.21,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:10:10.24,0:10:13.27,Default,,0000,0000,0000,,Міне, бүгін мистер Акидзуки.
Dialogue: 0,0:10:13.27,0:10:15.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:10:15.12,0:10:18.15,Default,,0000,0000,0000,,Шамамен 500 жыл бұрын
Dialogue: 0,0:10:18.15,0:10:22.36,Default,,0000,0000,0000,,Бір бала тауда емдік шөп теріп жүрген.
Dialogue: 0,0:10:22.36,0:10:25.22,Default,,0000,0000,0000,,Іздеп жүргенімде
Dialogue: 0,0:10:25.22,0:10:29.26,Default,,0000,0000,0000,,Мен Шименаваның алдына, сегіз-чо бағдаршамына келдім.
Dialogue: 0,0:10:29.26,0:10:32.12,Default,,0000,0000,0000,,Мен кенет сыртқа қарасам,
Dialogue: 0,0:10:32.12,0:10:36.16,Default,,0000,0000,0000,,Дәрілік шөптердің әлі де көп екенін көрдім.
Dialogue: 0,0:10:36.16,0:10:40.37,Default,,0000,0000,0000,,Маған әрқашан Хакчо белгісінен шықпау керектігі айтылды.
Dialogue: 0,0:10:40.37,0:10:43.23,Default,,0000,0000,0000,,Оны ересек адам шегемен шаншып алған.
Dialogue: 0,0:10:43.23,0:10:45.09,Default,,0000,0000,0000,,Бұл өте қажет болғанда
Dialogue: 0,0:10:45.09,0:10:48.09,Default,,0000,0000,0000,,Сіз ересек адамның сүйемелдеуімен кетуіңіз керек.
Dialogue: 0,0:10:49.29,0:10:53.29,Default,,0000,0000,0000,,Мен арғы жақтан жын келе жатқанын көрдім.
Dialogue: 0,0:11:02.26,0:11:06.13,Default,,0000,0000,0000,,Жын оны ауылға апаруға тырысады.
Dialogue: 0,0:11:06.13,0:11:08.15,Default,,0000,0000,0000,,Ахахаха! Қандай қызық.
Dialogue: 0,0:11:08.15,0:11:11.18,Default,,0000,0000,0000,,Осылай жүріп, жынмен ауылға қайтсам,
Dialogue: 0,0:11:11.18,0:11:13.37,Default,,0000,0000,0000,,Ауыл жойылады
Dialogue: 0,0:11:13.37,0:11:16.40,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:11:16.40,0:11:19.26,Default,,0000,0000,0000,,Менің өміріме не болатыны маңызды емес.
Dialogue: 0,0:11:19.26,0:11:22.29,Default,,0000,0000,0000,,Жындарды ауылдан аулақ ұстаңыз.
Dialogue: 0,0:11:22.29,0:11:24.14,Default,,0000,0000,0000,,Содан бері бүгінгі күнге дейін
Dialogue: 0,0:11:24.14,0:11:26.14,Default,,0000,0000,0000,,Жын ешқашан пайда болған емес
Dialogue: 0,0:11:27.17,0:11:31.38,Default,,0000,0000,0000,,Жарайсың Иә! Ендеше бәріңіз бірінші бетке оралыңыздар...
Dialogue: 0,0:11:31.38,0:11:33.38,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:11:36.31,0:11:39.17,Default,,0000,0000,0000,,Мұқият қарап шығыңыз.
Dialogue: 0,0:11:39.17,0:11:43.17,Default,,0000,0000,0000,,Мәліметтерді мұқият визуализациялаңыз.
Dialogue: 0,0:11:44.39,0:11:48.26,Default,,0000,0000,0000,,Автордың ойының проекциясын көруге болады.
Dialogue: 0,0:11:48.26,0:11:50.28,Default,,0000,0000,0000,,Иә Иә
Dialogue: 0,0:11:50.28,0:11:53.31,Default,,0000,0000,0000,,Уау... Шун Бұл керемет.
Dialogue: 0,0:11:53.31,0:11:55.50,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:11:55.50,0:11:57.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:57.19,0:11:59.37,Default,,0000,0000,0000,,Оңай жеңіс!
Dialogue: 0,0:11:59.37,0:12:01.39,Default,,0000,0000,0000,,Ша! Иә Мамору!
Dialogue: 0,0:12:01.39,0:12:03.39,Default,,0000,0000,0000,,Иә, ә...
Dialogue: 0,0:12:08.30,0:12:10.48,Default,,0000,0000,0000,,Орындалды, Мария.
Dialogue: 0,0:12:10.48,0:12:12.48,Default,,0000,0000,0000,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:12:15.20,0:12:17.39,Default,,0000,0000,0000,,Иә, хмм, жақсы жұмыс.
Dialogue: 0,0:12:17.39,0:12:19.41,Default,,0000,0000,0000,,Соңғы Рейко
Dialogue: 0,0:12:19.41,0:12:21.26,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:12:21.26,0:12:24.29,Default,,0000,0000,0000,,Өтінемін, Рейко
Dialogue: 0,0:12:24.29,0:12:26.31,Default,,0000,0000,0000,,Иә, мен бар күшімді саламын...
Dialogue: 0,0:12:26.31,0:12:28.50,Default,,0000,0000,0000,,Ах! Аа ccha~
Dialogue: 0,0:12:28.50,0:12:30.35,Default,,0000,0000,0000,,Мен Иносукэні құтқарамын
Dialogue: 0,0:12:30.35,0:12:32.37,Default,,0000,0000,0000,,Уайымдайтын ештеңе жоқ.
Dialogue: 0,0:12:32.37,0:12:34.37,Default,,0000,0000,0000,,Басынан бастап қайталап көріңіз
Dialogue: 0,0:12:36.24,0:12:38.24,Default,,0000,0000,0000,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:12:42.30,0:12:44.32,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:12:44.32,0:12:46.51,Default,,0000,0000,0000,,Хехе…
Dialogue: 0,0:12:46.51,0:12:49.54,Default,,0000,0000,0000,,Мен жеңілмеймін...
Dialogue: 0,0:12:49.54,0:12:51.23,Default,,0000,0000,0000,,Неліктен қарқыныңды арттырмайсың?
Dialogue: 0,0:12:51.23,0:12:55.43,Default,,0000,0000,0000,,Жақсы жекпе-жек емес! Мен сенен жеңілмеймін, уайымдама.
Dialogue: 0,0:12:55.43,0:12:58.46,Default,,0000,0000,0000,,Ақымақ! Топ ішінде бәсекелесудің қажеті жоқ.
Dialogue: 0,0:12:58.46,0:13:00.32,Default,,0000,0000,0000,,Қара, 5-топ
Dialogue: 0,0:13:00.32,0:13:02.34,Default,,0000,0000,0000,,Мен өзімді жақсы сезінемін.
Dialogue: 0,0:13:02.34,0:13:06.34,Default,,0000,0000,0000,,Эйс әлі де жақсы жұмыс істейді.
Dialogue: 0,0:13:10.58,0:13:14.58,Default,,0000,0000,0000,,Бірақ ей, бізді ұстап тұрғандар бар.
Dialogue: 0,0:13:15.30,0:13:17.30,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:13:18.33,0:13:20.52,Default,,0000,0000,0000,,Иә... мм
Dialogue: 0,0:13:20.52,0:13:23.38,Default,,0000,0000,0000,,Иә? А... аа
Dialogue: 0,0:13:23.38,0:13:27.25,Default,,0000,0000,0000,,Рейко осында болғанша, біздің команда ешқашан жеңе алмайды.
Dialogue: 0,0:13:27.25,0:13:29.44,Default,,0000,0000,0000,,Иә? Рейко жақсы қыз!
Dialogue: 0,0:13:29.44,0:13:30.63,Default,,0000,0000,0000,,Мен өзімді жақсы сезінбеймін!
Dialogue: 0,0:13:30.63,0:13:33.31,Default,,0000,0000,0000,,Ақымақ болма! а?
Dialogue: 0,0:13:33.31,0:13:35.50,Default,,0000,0000,0000,,Кешіріңіз, шынымен кешіріңіз!
Dialogue: 0,0:13:35.50,0:13:37.52,Default,,0000,0000,0000,,Нашар Жаман Кешіріңіз кешіріңіз...
Dialogue: 0,0:13:37.52,0:13:40.52,Default,,0000,0000,0000,,Қалжыңдамаңыз! Кола! Мен қалжыңдамаймын!
Dialogue: 0,0:13:41.39,0:13:44.42,Default,,0000,0000,0000,,Эй, сен неге Рейконы шақырмадың?
Dialogue: 0,0:13:44.42,0:13:47.45,Default,,0000,0000,0000,,Қарастыру Қарастыру Қарастыру
Dialogue: 0,0:13:47.45,0:13:49.47,Default,,0000,0000,0000,,Осыдан кейін не болды?
Dialogue: 0,0:13:49.47,0:13:53.51,Default,,0000,0000,0000,,Екеуміз бірге қайтсақ, ол маған тоймайтын адам болады.
Dialogue: 0,0:13:53.51,0:13:55.53,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:13:55.53,0:13:58.56,Default,,0000,0000,0000,,Тым көп кешірім сұрасаң да, мен оны жек көре бастадым.
Dialogue: 0,0:13:58.56,0:14:00.42,Default,,0000,0000,0000,,Олай айтпа!
Dialogue: 0,0:14:00.42,0:14:02.44,Default,,0000,0000,0000,,Солай емес пе?
Dialogue: 0,0:14:02.44,0:14:03.62,Default,,0000,0000,0000,,Біздің бірінші топтың қабілеті жоғары.
Dialogue: 0,0:14:03.62,0:14:07.49,Default,,0000,0000,0000,,Шун да осында Эй Шун
Dialogue: 0,0:14:07.49,0:14:11.53,Default,,0000,0000,0000,,Жоқ, мен... олай емес.
Dialogue: 0,0:14:11.53,0:14:15.40,Default,,0000,0000,0000,,Иә! Рейко әрқашан сәтсіздікке ұшырайды
Dialogue: 0,0:14:15.40,0:14:18.43,Default,,0000,0000,0000,,Не болса да жеңе алмаймын. Барлығы солай ойлайды, солай ма?
Dialogue: 0,0:14:18.43,0:14:20.43,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:27.35,0:14:30.38,Default,,0000,0000,0000,,Эй, Вакиенді бітірме.
Dialogue: 0,0:14:30.38,0:14:34.59,Default,,0000,0000,0000,,Кейбір адамдар жолда жоғалып кетеді деп естідім...
Dialogue: 0,0:14:34.59,0:14:37.59,Default,,0000,0000,0000,,Ерте маусым Бұл жай ғана қауесет
Dialogue: 0,0:14:38.46,0:14:40.46,Default,,0000,0000,0000,,Бірақ келіңіз.
Dialogue: 0,0:14:41.49,0:14:43.51,Default,,0000,0000,0000,,Барлығына мән бермейді ме?
Dialogue: 0,0:14:43.51,0:14:45.36,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:14:45.36,0:14:49.57,Default,,0000,0000,0000,,Бұл жай ғана өсек, бірақ мен оны бұрын естігенмін.
Dialogue: 0,0:14:49.57,0:14:51.42,Default,,0000,0000,0000,,Мұғалімдер, келіңіздер.
Dialogue: 0,0:14:51.42,0:14:54.63,Default,,0000,0000,0000,,Сіз бұл есікті ашқанда ғана ауланы көре алмайсыз ба?
Dialogue: 0,0:14:54.63,0:14:59.50,Default,,0000,0000,0000,,Ол жерде молалар көп болды...
Dialogue: 0,0:14:59.50,0:15:02.53,Default,,0000,0000,0000,,Өтірік қорқынышты...
Dialogue: 0,0:15:02.53,0:15:05.56,Default,,0000,0000,0000,,Тағы бір биік ертегі? Бұл кімнің моласы?
Dialogue: 0,0:15:05.56,0:15:09.44,Default,,0000,0000,0000,,Сіз мұны білесіз бе? Қалай болғанда да, өте көп ...
Dialogue: 0,0:15:09.44,0:15:11.46,Default,,0000,0000,0000,,Неліктен мектеп ауласына бару қиынға түсті?
Dialogue: 0,0:15:11.46,0:15:14.49,Default,,0000,0000,0000,,Маған қабір жасау керек пе? Сен ақымақсың ба?
Dialogue: 0,0:15:14.49,0:15:17.52,Default,,0000,0000,0000,,Иә! Мен онша білмеймін!
Dialogue: 0,0:15:17.52,0:15:20.55,Default,,0000,0000,0000,,Бейіт болған жоқ па?
Dialogue: 0,0:15:20.55,0:15:22.40,Default,,0000,0000,0000,,Шун Көрдің бе?
Dialogue: 0,0:15:22.40,0:15:25.61,Default,,0000,0000,0000,,Бұрын үй тапсырмасына жауап ала алмаған кезім болды.
Dialogue: 0,0:15:25.61,0:15:31.49,Default,,0000,0000,0000,,Ғылымда еркін бақылау Мұғалімнен: ``Әр адамның ақпаратын жинақтап болған соң,
Dialogue: 0,0:15:31.49,0:15:35.53,Default,,0000,0000,0000,,Әкелші деді, мен әкімшілік ғимаратына кірдім...
Dialogue: 0,0:15:35.53,0:15:39.57,Default,,0000,0000,0000,,Мен ол жақтан ауланы көрдім, бірақ тізіліп тұрған нәрсе
Dialogue: 0,0:15:39.57,0:15:43.62,Default,,0000,0000,0000,,Ол кірпіштен жасалған қоймаға ұқсайды. Бұл бәрібір қабір емес еді.
Dialogue: 0,0:15:43.62,0:15:48.49,Default,,0000,0000,0000,,Шықты Шықты Ақыры, бұл Саторудың ұзын ертегісі еді.
Dialogue: 0,0:15:48.49,0:15:53.54,Default,,0000,0000,0000,,Мен мұны шынымен естідім! Вакиен туралы әлі де қорқынышты әңгімелер бар.
Dialogue: 0,0:15:53.54,0:15:56.57,Default,,0000,0000,0000,,Иә, иә, қорқынышты, қорқынышты, о, қорқынышты! Оны қазірдің өзінде тоқтатыңыз!
Dialogue: 0,0:15:56.57,0:15:58.43,Default,,0000,0000,0000,,Бұл не туралы?
Dialogue: 0,0:15:58.43,0:16:01.46,Default,,0000,0000,0000,,Қорғаңыз! Сіз оны енді естігіңіз келмейтінін айтып жатырсыз!
Dialogue: 0,0:16:01.46,0:16:02.64,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:16:02.64,0:16:06.64,Default,,0000,0000,0000,,Уакиенде қорқынышты нәрсені көрген тағы бір адам болды.
Dialogue: 0,0:16:11.39,0:16:14.42,Default,,0000,0000,0000,,Өте үлкен мысықтың көлеңкесі
Dialogue: 0,0:16:14.42,0:16:17.45,Default,,0000,0000,0000,,Бұл мысық па?
Dialogue: 0,0:16:17.45,0:16:20.48,Default,,0000,0000,0000,,Некодамаши мектепте жиі көрінетін сияқты.
Dialogue: 0,0:16:20.48,0:16:22.50,Default,,0000,0000,0000,,Неліктен? Ол қазірдің өзінде шешілді!
Dialogue: 0,0:16:22.50,0:16:23.69,Default,,0000,0000,0000,,Өйткені олар балаларға бағытталған!
Dialogue: 0,0:16:23.69,0:16:28.56,Default,,0000,0000,0000,,Маусым – күз... Олар кешке жиі шығады.
Dialogue: 0,0:16:28.56,0:16:32.43,Default,,0000,0000,0000,,Мен үйіңізге кейде келемін, бірақ әдетте түн ортасында...
Dialogue: 0,0:16:32.43,0:16:33.62,Default,,0000,0000,0000,,Ол – Лорд Широ.
Dialogue: 0,0:16:33.62,0:16:35.64,Default,,0000,0000,0000,,Ерте маусым?
Dialogue: 0,0:16:35.64,0:16:38.49,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:16:38.49,0:16:43.54,Default,,0000,0000,0000,,Эй, сен Уакиенді ерте бітіргенсің, бұл сенің керемет екеніңді білдірмейді.
Dialogue: 0,0:16:43.54,0:16:47.42,Default,,0000,0000,0000,,Оның сиқырдың күші мен сапасына еш қатысы жоқ.
Dialogue: 0,0:16:47.42,0:16:51.63,Default,,0000,0000,0000,,Сіз білесіз бе? Әкем екеуміз соншалықты жылдам емеспіз.
Dialogue: 0,0:16:51.63,0:16:53.65,Default,,0000,0000,0000,,Бұл соңғысы да емес еді, солай ма?
Dialogue: 0,0:16:53.65,0:16:56.68,Default,,0000,0000,0000,,Бұл дұрыс... бірақ...
Dialogue: 0,0:16:56.68,0:16:59.54,Default,,0000,0000,0000,,Оқуды бітірмесем ше?
Dialogue: 0,0:16:59.54,0:17:01.56,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:01.56,0:17:05.61,Default,,0000,0000,0000,,Оқуыңды бітірмесең сені Некодамаши алып кетуге келеді деген рас па?
Dialogue: 0,0:17:05.61,0:17:09.65,Default,,0000,0000,0000,,Ақымақ болма, бұл дүниеде мысық жоқ.
Dialogue: 0,0:17:09.65,0:17:13.51,Default,,0000,0000,0000,,Ересек болайын десем де.
Dialogue: 0,0:17:13.51,0:17:14.70,Default,,0000,0000,0000,,Осылай айтсаң маған күлесің.
Dialogue: 0,0:17:14.70,0:17:17.73,Default,,0000,0000,0000,,Ха...
Dialogue: 0,0:17:17.73,0:17:20.58,Default,,0000,0000,0000,,Бірақ мен көрдім
Dialogue: 0,0:17:20.58,0:17:23.58,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Бұл жай ғана елес.
Dialogue: 0,0:17:24.63,0:17:26.63,Default,,0000,0000,0000,,Мен оны көрдім.
Dialogue: 0,0:17:29.68,0:17:32.53,Default,,0000,0000,0000,,Ерте маусым? Ерте маусым?
Dialogue: 0,0:17:32.53,0:17:34.55,Default,,0000,0000,0000,,А, жақсысың ба?
Dialogue: 0,0:17:34.55,0:17:35.74,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:17:35.74,0:17:39.61,Default,,0000,0000,0000,,Сен ақымақсың. Бұл Уакиеннен бері әйгілі қауесетке айналды.
Dialogue: 0,0:17:39.61,0:17:41.63,Default,,0000,0000,0000,,Мен қазір қорқып кетсем не істеуім керек?
Dialogue: 0,0:17:41.63,0:17:44.66,Default,,0000,0000,0000,,Шулы! Үніңді жап, Сатору!
Dialogue: 0,0:17:44.66,0:17:47.69,Default,,0000,0000,0000,,Не... шынымен ашулысың ба?
Dialogue: 0,0:17:47.69,0:17:50.55,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:17:50.55,0:17:53.58,Default,,0000,0000,0000,,А... ештеңе жоқ.
Dialogue: 0,0:17:53.58,0:07:00.24,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:17:57.63,0:17:59.63,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:03.69,0:18:07.55,Default,,0000,0000,0000,,Мысықты кездестірсең де, білмейсің.
Dialogue: 0,0:18:07.55,0:18:08.74,Default,,0000,0000,0000,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:18:08.74,0:18:11.59,Default,,0000,0000,0000,,Әй, қарашы, жеп жатыр.
Dialogue: 0,0:18:11.59,0:18:12.61,Default,,0000,0000,0000,,Бастапқыда шабуыл жасамаймын деп айтпадың ба?
Dialogue: 0,0:18:12.61,0:18:14.80,Default,,0000,0000,0000,,Мен де естідім.
Dialogue: 0,0:18:14.80,0:18:17.48,Default,,0000,0000,0000,,Мұны кім айтты? Ол кім?
Dialogue: 0,0:18:17.48,0:18:18.67,Default,,0000,0000,0000,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:18:18.67,0:18:20.69,Default,,0000,0000,0000,,өзгерістен бұрынғы кейбір естеліктеріңді жоғалтқансыңдар.
Dialogue: 0,0:18:20.69,0:18:23.54,Default,,0000,0000,0000,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:18:23.54,0:18:25.54,Default,,0000,0000,0000,,Ерте маусым~!
Dialogue: 0,0:18:32.81,0:18:35.50,Default,,0000,0000,0000,,Уа, ерте маусымдағы барлығын қамтитын сынып ше?
Dialogue: 0,0:18:35.50,0:18:38.53,Default,,0000,0000,0000,,Иә, қызық... Менің ойымша?
Dialogue: 0,0:18:38.53,0:18:41.56,Default,,0000,0000,0000,,«Қана» нені білдіреді? Мен сенімді емеспін.
Dialogue: 0,0:18:41.56,0:18:44.76,Default,,0000,0000,0000,,Менің ойымша, сіз компанияға жаңадан қосылғаннан бері бұл туралы көп білмейсіз.
Dialogue: 0,0:18:44.76,0:18:46.76,Default,,0000,0000,0000,,Иә, бірақ жақсы
Dialogue: 0,0:18:50.82,0:18:52.82,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:56.72,0:18:59.75,Default,,0000,0000,0000,,Мен уайымдап отырмын... осылай қалса да...
Dialogue: 0,0:18:59.75,0:19:02.78,Default,,0000,0000,0000,,Ал, күте тұрыңыз, егер сіз соншалықты уайымдасаңыз ше?
Dialogue: 0,0:19:02.78,0:19:05.81,Default,,0000,0000,0000,,Керісінше кері әсер етеді
Dialogue: 0,0:19:05.81,0:19:08.84,Default,,0000,0000,0000,,Сіз қандай сабақтарды жүргізесіз?
Dialogue: 0,0:19:08.84,0:19:14.55,Default,,0000,0000,0000,,Карточкалар арқылы пирамидалар жасау... құмнан салынған суреттер т.б.
Dialogue: 0,0:19:14.55,0:19:17.76,Default,,0000,0000,0000,,Әкелеріңнің қасында болған кезден онша айырмашылығы жоқ.
Dialogue: 0,0:19:17.76,0:19:20.79,Default,,0000,0000,0000,,Әкем әзілдегенді ұнатады~
Dialogue: 0,0:19:20.79,0:19:23.82,Default,,0000,0000,0000,,Каяносзукури жұмыртқасымен мектеп мүсінін ұрыңыз.
Dialogue: 0,0:19:23.82,0:19:27.69,Default,,0000,0000,0000,,Мектеп директоры Муша Шонин мені қатты ұрысты.
Dialogue: 0,0:19:27.69,0:19:30.72,Default,,0000,0000,0000,,Сіз қашан туралы айтып отырсыз?
Dialogue: 0,0:19:30.72,0:19:32.74,Default,,0000,0000,0000,,Бірақ бұл осылай қала берсе...
Dialogue: 0,0:19:32.74,0:19:36.78,Default,,0000,0000,0000,,Әй, Білім кеңесінің әрекет ететін уақыты келді емес пе?
Dialogue: 0,0:19:36.78,0:19:38.80,Default,,0000,0000,0000,,Әрі қарай!
Dialogue: 0,0:19:38.80,0:19:41.83,Default,,0000,0000,0000,,Кітапханалардың мектеп кеңесіне әсер етуі қиын.
Dialogue: 0,0:19:41.83,0:19:44.86,Default,,0000,0000,0000,,Сіз шешім қабылдаушысыз
Dialogue: 0,0:19:44.86,0:19:46.72,Default,,0000,0000,0000,,Қаласаңыз, бірдеңе істей аласыз, солай ма?
Dialogue: 0,0:19:46.72,0:19:50.76,Default,,0000,0000,0000,,Комитет тәуелсіз және менің тергеу жүргізуге құқығым жоқ.
Dialogue: 0,0:19:50.76,0:19:54.63,Default,,0000,0000,0000,,Не керек, ерте балалық шақ әке ретінде менде осындай пікір бар...
Dialogue: 0,0:19:54.63,0:19:57.66,Default,,0000,0000,0000,,Мен басқа баладан айырылғым келмейді!
Dialogue: 0,0:19:57.66,0:19:59.85,Default,,0000,0000,0000,,Даусыңыз қатты!
Dialogue: 0,0:19:59.85,0:20:01.70,Default,,0000,0000,0000,,Өйткені Саки: «Мен арам мысық көрдім!» — деді.
Dialogue: 0,0:20:01.70,0:20:03.72,Default,,0000,0000,0000,,Мүмкін бұл менің қиялым шығар
Dialogue: 0,0:20:03.72,0:20:05.74,Default,,0000,0000,0000,,Егер бұл шындық болса, сен не істер едің?
Dialogue: 0,0:20:05.74,0:20:08.59,Default,,0000,0000,0000,,Ерте маусым Ерте маусым?
Dialogue: 0,0:20:08.59,0:20:09.78,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:20:09.78,0:20:12.64,Default,,0000,0000,0000,,Қасиетті рух аман-есен келіп, мен Сейджози храмына бардым.
Dialogue: 0,0:20:12.64,0:20:15.67,Default,,0000,0000,0000,,Барлық студенттерге арналған сабақтар да басталды...
Dialogue: 0,0:20:15.67,0:20:17.86,Default,,0000,0000,0000,,Анашым, мен жеңілдеп қалдым.
Dialogue: 0,0:20:17.86,0:20:20.55,Default,,0000,0000,0000,,«Мен өзімді жеңіл сезінемін»?
Dialogue: 0,0:20:20.55,0:20:23.58,Default,,0000,0000,0000,,Мен басқа баладан айырылғым келмейді!
Dialogue: 0,0:20:23.58,0:20:24.76,Default,,0000,0000,0000,,«Мен жеңілдедім» деген нені білдіреді?
Dialogue: 0,0:20:24.76,0:20:26.78,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:26.78,0:20:28.64,Default,,0000,0000,0000,,Жарайды, жеңілдеп қалу табиғи нәрсе.
Dialogue: 0,0:20:28.64,0:20:31.67,Default,,0000,0000,0000,,Әруақтарға бата беруде әкелер де баяу болды.
Dialogue: 0,0:20:31.67,0:20:34.70,Default,,0000,0000,0000,,Себебі ата-анам мен үшін алаңдады.
Dialogue: 0,0:20:34.70,0:20:39.75,Default,,0000,0000,0000,,Тыңдаңдар, біз адамдар сиқырлы күштерді пайдалана аламыз.
Dialogue: 0,0:20:39.75,0:20:41.77,Default,,0000,0000,0000,,Бірақ бұл аз ғана сома
Dialogue: 0,0:20:41.77,0:20:45.81,Default,,0000,0000,0000,,Сондықтан біз оны жақсы күтуіміз керек...
Dialogue: 0,0:20:45.81,0:20:47.83,Default,,0000,0000,0000,,Ас үшін рахмет
Dialogue: 0,0:20:47.83,0:20:49.83,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:20:56.92,0:10:04.24,Default,,0000,0000,0000,,Бірнеше күннен кейін
Dialogue: 0,0:21:01.63,0:21:03.63,Default,,0000,0000,0000,,мектептен хабарсыз кеткен
Dialogue: 0,0:22:35.90,0:22:38.93,Default,,0000,0000,0000,,Бала өзінің зеректігімен тым мақтанатын.
Dialogue: 0,0:22:38.93,0:22:41.93,Default,,0000,0000,0000,,Бәрін күлдірді.
Dialogue: 0,0:22:42.81,0:22:45.84,Default,,0000,0000,0000,,Тәкаппарлық зұлымдық тұқымын себеді.
Dialogue: 0,0:22:45.84,0:22:48.84,Default,,0000,0000,0000,,Жалғыздық карманың ұясына айналады
Dialogue: 0,0:30:07.57,0:30:11.45,Default,,0000,0000,0000,,Мәртебелі Ұлы қуаныш императоры, 5-ші император
Dialogue: 0,0:30:11.45,0:30:14.48,Default,,0000,0000,0000,,Таққа отыруыңызбен құттықтаймыз
Dialogue: 0,0:30:15.98,0:30:21.98,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
