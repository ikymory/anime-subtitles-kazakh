Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.72,0:00:18.18,Default,,0,0,0,,Сондықтан мен оны анамның будда құрбандық үстеліне ұсынамын.
Dialogue: 0,0:00:18.26,0:00:20.52,Default,,0,0,0,,Ол жоғары дәрежелі болуы керек.
Dialogue: 0,0:00:20.60,0:00:21.64,Default,,0,0,0,,Идиот
Dialogue: 0,0:00:21.73,0:00:25.02,Default,,0,0,0,,Әрқайсысы 500 иен тұратын су йокан яко
Dialogue: 0,0:00:25.10,0:00:28.15,Default,,0,0,0,,Кемпір сұраса, бас тартады.
Dialogue: 0,0:00:31.86,0:00:34.28,Default,,0,0,0,,О, Такуми, сыртқа шығасың ба?
Dialogue: 0,0:00:35.03,0:00:36.78,Default,,0,0,0,,Иә, жер
Dialogue: 0,0:00:39.16,0:00:42.37,Default,,0,0,0,,Такуми Мен мұны біраздан бері сұрайын деп жүр едім.
Dialogue: 0,0:00:42.87,0:00:44.71,Default,,0,0,0,,Бейсбол клубындағы оқиға
Dialogue: 0,0:00:44.79,0:00:47.50,Default,,0,0,0,,Саған бәрібір, солай ма?
Dialogue: 0,0:00:49.54,0:00:52.92,Default,,0,0,0,,Жарайды... Сұрасам да жауап бермейсің деп ойлаймын.
Dialogue: 0,0:00:53.01,0:00:55.59,Default,,0,0,0,,Неге қазір оны менен сұрап тұрсың?
Dialogue: 0,0:00:55.68,0:00:57.47,Default,,0,0,0,,Себебі өзіңізді жақсы сезінбейсіз.
Dialogue: 0,0:00:57.55,0:01:00.47,Default,,0,0,0,,Клуб іс-шаралары тоқтатылды, солай ма?
Dialogue: 0,0:01:01.77,0:01:05.19,Default,,0,0,0,,Дұрыс, егер мен сенен бейсболды алып тастасам.
Dialogue: 0,0:01:05.27,0:01:07.23,Default,,0,0,0,,Ештеңе қалмады
Dialogue: 0,0:01:07.77,0:01:08.61,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:01:08.69,0:01:11.36,Default,,0,0,0,,Сіз аздап арықтадыңыз, солай емес пе?
Dialogue: 0,0:01:12.57,0:01:14.32,Default,,0,0,0,,Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 0,0:01:15.70,0:01:17.03,Default,,0,0,0,,Оған қол тигізбеңіз!
Dialogue: 0,0:01:17.99,0:01:19.66,Default,,0,0,0,,Менің иығыма тиіспе
Dialogue: 0,0:01:19.74,0:01:21.16,Default,,0,0,0,,Такуми…
Dialogue: 0,0:01:21.99,0:01:25.04,Default,,0,0,0,,Түсіндім, енді ештеңе айтпаймын.
Dialogue: 0,0:01:25.12,0:01:26.29,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:01:26.87,0:01:29.21,Default,,0,0,0,,Жоқ, жоқ, бұл ұят болды, Макико.
Dialogue: 0,0:01:29.29,0:01:30.79,Default,,0,0,0,,Не?
Dialogue: 0,0:01:31.42,0:01:34.30,Default,,0,0,0,,Құмыраның иығына қол тигізбеңіз.
Dialogue: 0,0:01:34.38,0:01:36.63,Default,,0,0,0,,Мен жеткілікті сақ емеспін деп ойлаймын.
Dialogue: 0,0:01:36.72,0:01:39.97,Default,,0,0,0,,Мен ұлымның иығына қолымды тигіздім.
Dialogue: 0,0:01:40.05,0:01:45.06,Default,,0,0,0,,♪～
Dialogue: 0,0:03:04.51,0:03:09.52,Default,,0,0,0,,～♪
Dialogue: 0,0:03:12.02,0:03:14.98,Default,,0,0,0,,Жаңбыр жаумай тұрып орындайық.
Dialogue: 0,0:03:15.06,0:03:17.53,Default,,0,0,0,,Жаңбыр? Неліктен күн ашық?
Dialogue: 0,0:03:19.61,0:03:21.45,Default,,0,0,0,,Бұл келе ме?
Dialogue: 0,0:03:21.53,0:03:24.53,Default,,0,0,0,,Келме, күн ысып, дымқыл болып барады.
Dialogue: 0,0:03:25.95,0:03:27.79,Default,,0,0,0,,Алдымен, жеңілдеп, үйреніп ал.
Dialogue: 0,0:03:29.29,0:03:34.21,Default,,0,0,0,,(ойнап жатқан дыбыс)
Dialogue: 0,0:03:38.63,0:03:40.30,Default,,0,0,0,,Иә?қалай?
Dialogue: 0,0:03:41.47,0:03:42.34,Default,,0,0,0,,Артқа
Dialogue: 0,0:03:45.14,0:03:46.68,Default,,0,0,0,,Отомрай?
Dialogue: 0,0:03:48.35,0:03:50.10,Default,,0,0,0,,Мұғалім, у...
Dialogue: 0,0:03:50.81,0:03:52.19,Default,,0,0,0,,Маған аздап қарыз беріңізші
Dialogue: 0,0:03:52.85,0:03:54.15,Default,,0,0,0,,Иә
Dialogue: 0,0:03:54.23,0:03:56.19,Default,,0,0,0,,Харада мен оны аламын.
Dialogue: 0,0:03:56.27,0:03:57.52,Default,,0,0,0,,Оны лақтыр
Dialogue: 0,0:03:57.61,0:03:58.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:59.07,0:04:00.69,Default,,0,0,0,,Сіз не нәрсеге қанағаттанбайсыз?
Dialogue: 0,0:04:00.78,0:04:02.86,Default,,0,0,0,,Жоқ, жай...
Dialogue: 0,0:04:02.95,0:04:03.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:05.57,0:04:07.20,Default,,0,0,0,,Менің допты ұстай аласың ба?
Dialogue: 0,0:04:07.28,0:04:08.45,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:04:11.41,0:04:13.62,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:04:13.71,0:04:16.13,Default,,0,0,0,,Сіз бұрынғыдайсыз.
Dialogue: 0,0:04:17.04,0:04:18.25,Default,,0,0,0,,Такуми Ярия
Dialogue: 0,0:04:18.34,0:04:20.96,Default,,0,0,0,,Мен сізге оны әдеттегіден басқа жерде көруге рұқсат етемін.
Dialogue: 0,0:04:21.71,0:04:23.01,Default,,0,0,0,,Басқа орын?
Dialogue: 0,0:04:42.74,0:04:45.45,Default,,0,0,0,,Бұл Хараданың ең жақсы қадамы ма?
Dialogue: 0,0:04:45.53,0:04:47.20,Default,,0,0,0,,Бұлай емес.
Dialogue: 0,0:04:47.28,0:04:49.78,Default,,0,0,0,,Жоқ, ол жігіт...
Dialogue: 0,0:04:49.87,0:04:52.12,Default,,0,0,0,,Менің ойымша, сіз ұстанбауыңыз керек.
Dialogue: 0,0:04:52.62,0:04:55.75,Default,,0,0,0,,Мұғалім, келесіде Такуми добы.
Dialogue: 0,0:04:55.83,0:04:58.92,Default,,0,0,0,,Харада, сен мені сынадың ба?
Dialogue: 0,0:04:59.00,0:05:00.34,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:05:00.84,0:05:03.05,Default,,0,0,0,,Харада! Дәл ортаға кел
Dialogue: 0,0:05:03.13,0:05:06.34,Default,,0,0,0,,Ең жылдамды қараңыз.
Dialogue: 0,0:05:23.94,0:05:25.65,Default,,0,0,0,,-(Томура) Мынау доп па? -(Австралия) Дұрыс.
Dialogue: 0,0:05:27.95,0:05:30.16,Default,,0,0,0,,Дәл солай, 3 шар қалды!
Dialogue: 0,0:05:41.42,0:05:42.25,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:43.71,0:05:46.26,Default,,0,0,0,,Әдепті түрде жауап беріңіз.
Dialogue: 0,0:05:46.34,0:05:48.34,Default,,0,0,0,,Мынадай доп
Dialogue: 0,0:05:48.43,0:05:50.85,Default,,0,0,0,,Мен жай ғана күлуге тырыстым.
Dialogue: 0,0:05:52.10,0:05:54.27,Default,,0,0,0,,Харада жүгіріп келеді
Dialogue: 0,0:05:57.48,0:06:00.15,Default,,0,0,0,,Қызық, Харада матчқа қатыса ма?
Dialogue: 0,0:06:01.11,0:06:02.65,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:06:02.73,0:06:04.53,Default,,0,0,0,,Клуб жұмысына тыйым салынады
Dialogue: 0,0:06:04.61,0:06:08.03,Default,,0,0,0,,Ол ойнау былай тұрсын, көп жаттыға да алмаса керек.
Dialogue: 0,0:06:08.11,0:06:11.12,Default,,0,0,0,,Сіз қаншалықты әлсіз екеніңізді түсіндіңіз бе?
Dialogue: 0,0:06:11.20,0:06:12.03,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:06:12.12,0:06:14.04,Default,,0,0,0,,Шулы, үніңді жап, тыңда
Dialogue: 0,0:06:15.20,0:06:16.54,Default,,0,0,0,,Иә, Харада
Dialogue: 0,0:06:16.62,0:06:19.21,Default,,0,0,0,,Сіз әлі кіші мектеп оқушысысыз.
Dialogue: 0,0:06:19.29,0:06:22.29,Default,,0,0,0,,Егер сізге тыйым салынса, сіз бір ойынды дұрыс ойнай алмайсыз.
Dialogue: 0,0:06:22.88,0:06:25.38,Default,,0,0,0,,Бұл жай ғана екенін есте сақтаңыз.
Dialogue: 0,0:06:26.38,0:06:29.26,Default,,0,0,0,,Мұғалім, тоқтаңыз!
Dialogue: 0,0:06:32.72,0:06:34.81,Default,,0,0,0,,Сонымен, сіз ше, мұғалім?
Dialogue: 0,0:06:34.89,0:06:35.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:35.89,0:06:39.31,Default,,0,0,0,,Сіз бізге күлетіндей кереметсіз бе?
Dialogue: 0,0:06:39.81,0:06:41.56,Default,,0,0,0,,Менен бейсболды тартып алды.
Dialogue: 0,0:06:41.65,0:06:43.27,Default,,0,0,0,,Сен де солайсың, солай ма?
Dialogue: 0,0:06:45.32,0:06:47.19,Default,,0,0,0,,Таңқаларлық емес, Харада!
Dialogue: 0,0:06:47.28,0:06:49.28,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:06:49.36,0:06:52.16,Default,,0,0,0,,Бейсбол ойнағың келмеді ме?
Dialogue: 0,0:06:52.24,0:06:55.70,Default,,0,0,0,,Ойынды менеджер ретінде ойнағыңыз келмеді ме?
Dialogue: 0,0:06:55.79,0:06:57.58,Default,,0,0,0,,Сіз солай айттыңыз.
Dialogue: 0,0:06:57.66,0:07:00.21,Default,,0,0,0,,Турнирдің бірінші ойыны, мен бастаушымын.
Dialogue: 0,0:07:00.79,0:07:02.33,Default,,0,0,0,,Мен айтқанымдай, бұл рас.
Dialogue: 0,0:07:04.71,0:07:07.26,Default,,0,0,0,,Мен лақтырамын, Го оны ұстап алады.
Dialogue: 0,0:07:07.92,0:07:09.84,Default,,0,0,0,,Мен осындай ойынды жаттықтырғым келеді.
Dialogue: 0,0:07:10.47,0:07:12.34,Default,,0,0,0,,Сіз бұл туралы ешқашан ойламадыңыз ба?
Dialogue: 0,0:07:12.43,0:07:13.85,Default,,0,0,0,,Директор
Dialogue: 0,0:07:18.93,0:07:20.64,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:07:20.73,0:07:23.06,Default,,0,0,0,,Расында, сен сондай ақымақ бала екенсің.
Dialogue: 0,0:07:24.61,0:07:25.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:27.44,0:07:30.95,Default,,0,0,0,,Харада жақын арада клубтың қызметі қайта басталады
Dialogue: 0,0:07:31.03,0:07:32.70,Default,,0,0,0,,Денеңіздің түтіккеніне жол бермеңіз
Dialogue: 0,0:07:33.49,0:07:35.32,Default,,0,0,0,,Мен саған бұл жолы қалағаныңды істеуге рұқсат бермеймін
Dialogue: 0,0:07:35.41,0:07:36.74,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:07:38.08,0:07:41.00,Default,,0,0,0,,Бұл жолы мен сенің қалағаныңды істеуге міндетті түрде рұқсат етпеймін.
Dialogue: 0,0:07:44.63,0:07:48.09,Default,,0,0,0,,Сәлем, сен әлі білмейтін бірдеңе бар.
Dialogue: 0,0:07:48.17,0:07:49.01,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:07:49.01,0:07:50.47,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:07:49.01,0:07:50.47,Default,,0,0,0,,Бейсбол деп аталатын спорт түрі
Dialogue: 0,0:07:50.55,0:07:53.59,Default,,0,0,0,,Оның ішінде қаншалықты қызықты.
Dialogue: 0,0:07:54.39,0:07:55.80,Default,,0,0,0,,Байыптап көріңіз
Dialogue: 0,0:07:55.89,0:07:58.01,Default,,0,0,0,,Мұны өзіңіз үшін жасаңыз
Dialogue: 0,0:07:58.10,0:08:01.52,Default,,0,0,0,,Команда үшін ойнап көріңіз.
Dialogue: 0,0:08:02.10,0:08:04.06,Default,,0,0,0,,Нагакура Харада
Dialogue: 0,0:08:05.56,0:08:08.23,Default,,0,0,0,,Мен келесі жылы республикалық турнирге барамын.
Dialogue: 0,0:08:10.11,0:08:11.28,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:08:12.28,0:08:15.16,Default,,0,0,0,,Мен сені ұлттық құрылтайға апарамын.
Dialogue: 0,0:08:16.12,0:08:17.28,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:08:17.87,0:08:20.29,Default,,0,0,0,,Мен сені ел чемпионатында жеңіске жеткен жаттықтырушы етемін.
Dialogue: 0,0:08:22.29,0:08:24.29,Default,,0,0,0,,Өйткені сен маған үлкен соққы бердің
Dialogue: 0,0:08:24.37,0:08:27.63,Default,,0,0,0,,Мен сенің қалағаныңды дәл орындауыңды сұраймын.
Dialogue: 0,0:08:37.60,0:08:39.81,Default,,0,0,0,,Директор, менің сізден бір өтінішім бар.
Dialogue: 0,0:08:40.51,0:08:44.31,Default,,0,0,0,,Мен сені Йокоте 2-ші орта мектебінің директорымен жақын доссың деп естідім...
Dialogue: 0,0:08:44.39,0:08:45.77,Default,,0,0,0,,Не? Жақсы
Dialogue: 0,0:08:45.85,0:08:48.52,Default,,0,0,0,,Мен сәйкестікке өтініш бере аламын ба?
Dialogue: 0,0:08:48.61,0:08:50.32,Default,,0,0,0,,Йокоте бейсбол клубына
Dialogue: 0,0:08:50.40,0:08:51.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:53.49,0:08:55.45,Default,,0,0,0,,Йокоте 2-ші кіші орта мектебінің бейсбол клубы
Dialogue: 0,0:08:55.45,0:08:56.28,Default,,0,0,0,,Йокоте 2-ші кіші орта мектебінің бейсбол клубы
Dialogue: 0,0:08:55.45,0:08:56.28,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:08:56.28,0:08:56.70,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:08:56.78,0:08:58.41,Default,,0,0,0,,Префектуралық турнирдің финалы
Dialogue: 0,0:08:58.49,0:09:01.83,Default,,0,0,0,,Сіз 8-1 немесе бір нәрсе ұтқан жоқсыз ба?
Dialogue: 0,0:09:01.91,0:09:03.70,Default,,0,0,0,,9-1
Dialogue: 0,0:09:04.25,0:09:06.00,Default,,0,0,0,,Бұл мүмкін емес еді
Dialogue: 0,0:09:06.08,0:09:07.83,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:09:07.92,0:09:09.92,Default,,0,0,0,,Егер мен Йокотенің директоры болсам
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Мен бас тартамын.
Dialogue: 0,0:09:12.09,0:09:13.34,Default,,0,0,0,,Мен үшін бұл мүмкін емес.
Dialogue: 0,0:09:14.72,0:09:16.13,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз!
Dialogue: 0,0:09:16.22,0:09:18.59,Default,,0,0,0,,Мен тікелей келіссөздер жүргізуге тырыссам да...
Dialogue: 0,0:09:19.30,0:09:22.85,Default,,0,0,0,,Томура мырза, көп уайымдамаңыз.
Dialogue: 0,0:09:22.93,0:09:25.77,Default,,0,0,0,,Сіз не істеуіңіз керек
Dialogue: 0,0:09:25.85,0:09:27.77,Default,,0,0,0,,Бейсбол клубының салауатты қызметі
Dialogue: 0,0:09:27.85,0:09:29.90,Default,,0,0,0,,Нұсқау береді
Dialogue: 0,0:09:31.82,0:09:33.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:34.19,0:09:37.45,Default,,0,0,0,,Өз еркімен әрекет етуден аулақ болыңыз.
Dialogue: 0,0:09:37.53,0:09:39.74,Default,,0,0,0,,Бейсбол клубы сіздікі емес.
Dialogue: 0,0:09:39.82,0:09:43.20,Default,,0,0,0,,Бұл Нитта Хигаши орта мектебінен.
Dialogue: 0,0:09:43.83,0:09:44.79,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:09:49.79,0:09:53.88,Default,,0,0,0,,(Томура терең тыныс алады)
Dialogue: 0,0:09:55.72,0:09:57.38,Default,,0,0,0,,(телефонды көтерген дыбыс)
Dialogue: 0,0:09:58.05,0:10:00.39,Default,,0,0,0,,Такуми Кайондзи-кун
Dialogue: 0,0:10:01.55,0:10:02.89,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:10:02.97,0:10:06.89,Default,,0,0,0,,Директор ертең ашылу салтанатынан кейін сізбен сөйлеседі.
Dialogue: 0,0:10:06.98,0:10:08.39,Default,,0,0,0,,Артқы желінің алдына жиналыңыз
Dialogue: 0,0:10:08.98,0:10:09.90,Default,,0,0,0,,Не! Гваааах!
Dialogue: 0,0:10:09.98,0:10:12.40,Default,,0,0,0,,Бұл мен ертең клубтық іс-шараларды бастай аламын дегенді білдіре ме?
Dialogue: 0,0:10:12.48,0:10:14.28,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:10:14.36,0:10:16.99,Default,,0,0,0,,Күзгі жаңа ойыншылар жарысына уақытында үлгеруім мүмкін.
Dialogue: 0,0:10:17.49,0:10:21.37,Default,,0,0,0,,Шынымды айтсам, бірінші және екінші курс студенттері
Dialogue: 0,0:10:21.45,0:10:24.24,Default,,0,0,0,,Мен аздап қызғаншақпын.
Dialogue: 0,0:10:25.04,0:10:26.04,Default,,0,0,0,,Харада
Dialogue: 0,0:10:26.12,0:10:27.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:28.04,0:10:30.92,Default,,0,0,0,,Әрине, мен Нобуниши және т.б.
Dialogue: 0,0:10:31.00,0:10:32.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:32.63,0:10:33.96,Default,,0,0,0,,Не! Гваааах!
Dialogue: 0,0:10:34.05,0:10:35.92,Default,,0,0,0,,Мен Нобуниши-санды және басқаларды жек көремін.
Dialogue: 0,0:10:36.01,0:10:36.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:37.51,0:10:40.01,Default,,0,0,0,,Бірақ мен бейсбол ойнай алсам
Dialogue: 0,0:10:40.09,0:10:41.43,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:10:41.51,0:10:44.47,Default,,0,0,0,,Маған сенің не ұнайтыны не ұнамайтыны маңызды емес.
Dialogue: 0,0:10:44.56,0:10:47.77,Default,,0,0,0,,Егер команданың бәрі тәртіпсіз болмаса, онда бұл жақсы.
Dialogue: 0,0:10:47.85,0:10:48.68,Default,,0,0,0,,Иә
Dialogue: 0,0:10:48.77,0:10:49.81,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:10:53.73,0:10:54.69,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:10:54.77,0:10:56.94,Default,,0,0,0,,Ха ха ха... Такуми Орука!
Dialogue: 0,0:10:57.61,0:11:00.32,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,0:11:00.40,0:11:02.32,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:03.12,0:11:05.24,Default,,0,0,0,,Сіз мұны естідіңіз бе? Кайонджидің телефон қоңырауы
Dialogue: 0,0:11:05.33,0:11:06.45,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:11:06.54,0:11:09.62,Default,,0,0,0,,Керемет! Біз ертеңнен бастап бейсбол ойнай аламыз!
Dialogue: 0,0:11:09.71,0:11:11.46,Default,,0,0,0,,Уау... Го-чан!
Dialogue: 0,0:11:11.54,0:11:13.42,Default,,0,0,0,,О, Аонами
Dialogue: 0,0:11:14.04,0:11:16.21,Default,,0,0,0,,Сіз қатал болып бара жатырсыз.
Dialogue: 0,0:11:16.30,0:11:18.05,Default,,0,0,0,,Бұл сәл ауыр болды.
Dialogue: 0,0:11:18.13,0:11:21.51,Default,,0,0,0,,Шынымен бе? Бұл мен Джёсан, мен кешкі ас ішейін деп жатырмын.
Dialogue: 0,0:11:21.59,0:11:23.22,Default,,0,0,0,,Көкөністердің қалдықтары да бар.
Dialogue: 0,0:11:23.30,0:11:27.01,Default,,0,0,0,,Аонами... Го-кун келгенде, мен бұзылдым.
Dialogue: 0,0:11:27.10,0:11:29.27,Default,,0,0,0,,Өйткені Такуми маған қамқорлық жасамайды.
Dialogue: 0,0:11:29.35,0:11:30.98,Default,,0,0,0,,Сіз ренжідіңіз бе?
Dialogue: 0,0:11:31.06,0:11:32.48,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:11:32.56,0:11:34.98,Default,,0,0,0,,Хехехехехехехехехе
Dialogue: 0,0:11:40.82,0:11:42.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:45.03,0:11:47.83,Default,,0,0,0,,Мен бәріне қиындық туғыздым.
Dialogue: 0,0:11:47.91,0:11:50.33,Default,,0,0,0,,Тек директор және басқалар —
Dialogue: 0,0:11:50.41,0:11:52.87,Default,,0,0,0,,Мұғалімдердің түсінігімен
Dialogue: 0,0:11:52.96,0:11:56.04,Default,,0,0,0,,Мен ешқашан клуб жұмысын жалғастыра алмадым.
Dialogue: 0,0:11:56.88,0:11:57.96,Default,,0,0,0,,Харада
Dialogue: 0,0:11:58.71,0:12:00.38,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:12:00.46,0:12:01.38,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:04.43,0:12:05.26,Default,,0,0,0,,Директор
Dialogue: 0,0:12:05.34,0:12:07.72,Default,,0,0,0,,Мм... біз үшінші курс студенттеріміз
Dialogue: 0,0:12:07.81,0:12:10.27,Default,,0,0,0,,Бұл жерде зейнетке шығуға болады, солай ма?
Dialogue: 0,0:12:10.89,0:12:12.94,Default,,0,0,0,,Бір минут күте тұрыңыз Кайонжи
Dialogue: 0,0:12:13.44,0:12:16.48,Default,,0,0,0,,Үшінші курс студенттері осы уақытта зейнетке шығуы керек екені рас.
Dialogue: 0,0:12:16.56,0:12:20.36,Default,,0,0,0,,Бірақ балалар, осы жылы сәл ұзағырақ болыңдар деп үміттенемін.
Dialogue: 0,0:12:20.44,0:12:22.11,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:12:22.19,0:12:25.91,Default,,0,0,0,,Жаттығуларыңызды толыққанды матч пішіміне айналдырыңыз.
Dialogue: 0,0:12:26.53,0:12:29.08,Default,,0,0,0,,Ол сондай-ақ префектуралық турнирге қатысқан жоқ.
Dialogue: 0,0:12:29.16,0:12:32.91,Default,,0,0,0,,Мен сізді ас қорытусыз жібере алмаймын.
Dialogue: 0,0:12:33.00,0:12:34.71,Default,,0,0,0,,(клуб мүшелерінің музыкасы)
Dialogue: 0,0:12:34.79,0:12:36.83,Default,,0,0,0,,Маған сіріңке алуға рұқсат бересіз бе?
Dialogue: 0,0:12:36.92,0:12:38.29,Default,,0,0,0,,Менің айтқым келгені осы еді
Dialogue: 0,0:12:38.38,0:12:40.25,Default,,0,0,0,,Маған мұны қайда жасауға рұқсат бересіз?
Dialogue: 0,0:12:40.84,0:12:43.30,Default,,0,0,0,,Мен Йокоте 2-ші орта мектебімен ойнағым келеді.
Dialogue: 0,0:12:43.38,0:12:44.55,Default,,0,0,0,,Йокоте…
Dialogue: 0,0:12:46.68,0:12:48.43,Default,,0,0,0,,Орындаңыз директор
Dialogue: 0,0:12:48.51,0:12:51.85,Default,,0,0,0,,Егер Йокоте сіздің қарсыласыңыз болса, бұл жаттығу матчы немесе басқасы маңызды емес.
Dialogue: 0,0:12:51.93,0:12:52.77,Default,,0,0,0,,Эй?
Dialogue: 0,0:12:52.85,0:12:53.77,Default,,0,0,0,,О!
Dialogue: 0,0:12:54.27,0:12:57.31,Default,,0,0,0,,Алайда мектептен рұқсат алу мүмкін емес.
Dialogue: 0,0:12:57.40,0:12:59.77,Default,,0,0,0,,Маған іс басқаша екенін айтты.
Dialogue: 0,0:12:59.86,0:13:00.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:03.44,0:13:04.82,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:04.90,0:13:06.82,Default,,0,0,0,,Әңгімені үзгенім үшін кешіріңіз.
Dialogue: 0,0:13:06.91,0:13:08.57,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:13:08.66,0:13:10.78,Default,,0,0,0,,Мен мектепке уақытында келемін.
Dialogue: 0,0:13:11.74,0:13:12.83,Default,,0,0,0,,Және…
Dialogue: 0,0:13:12.91,0:13:16.04,Default,,0,0,0,,Мен мұны мұғалімге қалдырамын.
Dialogue: 0,0:13:16.12,0:13:17.21,Default,,0,0,0,,Тенсей
Dialogue: 0,0:13:19.34,0:13:21.38,Default,,0,0,0,,Сіз шынымен бас тартқыңыз келе ме?
Dialogue: 0,0:13:21.46,0:13:22.46,Default,,0,0,0,,Мен тоқтаймын
Dialogue: 0,0:13:22.55,0:13:24.05,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:24.67,0:13:26.47,Default,,0,0,0,,Мен ол жігітті жек көремін.
Dialogue: 0,0:13:28.05,0:13:30.10,Default,,0,0,0,,Бұл жалғыз себеп
Dialogue: 0,0:13:32.56,0:13:33.97,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:13:34.06,0:13:36.77,Default,,0,0,0,,Олай етпеуге қандай да бір себеп бар ма?
Dialogue: 0,0:13:36.85,0:13:39.98,Default,,0,0,0,,Бірінші сыныптың балапанынан қашасың ба?
Dialogue: 0,0:13:41.98,0:13:43.48,Default,,0,0,0,,Мен шынымен солаймын
Dialogue: 0,0:13:43.57,0:13:45.86,Default,,0,0,0,,Бұл топтық ойын, бұл топтық жұмыс.
Dialogue: 0,0:13:45.95,0:13:47.28,Default,,0,0,0,,Мен бұған жақсы емеспін.
Dialogue: 0,0:13:49.16,0:13:51.62,Default,,0,0,0,,Бірақ көңілді сезінген кездерім болды.
Dialogue: 0,0:13:52.45,0:13:54.79,Default,,0,0,0,,Мен қаншалықты жақсы ырылдағанымды түсіндім ...
Dialogue: 0,0:13:54.87,0:13:57.62,Default,,0,0,0,,Бірақ мен ұстандым.
Dialogue: 0,0:13:57.71,0:14:00.08,Default,,0,0,0,,Бейсбол осындай емес пе?
Dialogue: 0,0:14:00.17,0:14:03.21,Default,,0,0,0,,Біріншіден, бүкіл команда туралы ойлау маңызды.
Dialogue: 0,0:14:03.30,0:14:05.13,Default,,0,0,0,,Ұстаз, сіз маған сабақ бердіңіз.
Dialogue: 0,0:14:06.26,0:14:07.26,Default,,0,0,0,,Мүмкін, мен кенеттен үйленуге ұсыныс жасағандықтан шығар—
Dialogue: 0,0:14:07.34,0:14:09.89,Default,,0,0,0,,Сонымен, Харада ше?
Dialogue: 0,0:14:09.97,0:14:13.18,Default,,0,0,0,,Мұғалім Харада команда үшін бейсбол ойнап жүргенін айтты.
Dialogue: 0,0:14:13.26,0:14:15.02,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:14:15.10,0:14:17.18,Default,,0,0,0,,Сәлем Нобуниши мырза...
Dialogue: 0,0:14:22.94,0:14:24.32,Default,,0,0,0,,Сәлем Харада
Dialogue: 0,0:14:24.40,0:14:27.11,Default,,0,0,0,,Турнирде жеңіске жетуді қалайсыз ба?
Dialogue: 0,0:14:27.19,0:14:29.28,Default,,0,0,0,,Топ күшейсе
Dialogue: 0,0:14:29.36,0:14:31.28,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,0:14:31.37,0:14:32.99,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:14:33.49,0:14:35.87,Default,,0,0,0,,Бірақ бейсболды жалғыз ойнай алмайсың.
Dialogue: 0,0:14:35.95,0:14:37.20,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:14:37.96,0:14:41.04,Default,,0,0,0,,Менің ең жақсы қадамымды лақтыру үшін
Dialogue: 0,0:14:41.13,0:14:42.29,Default,,0,0,0,,Айтайын дегенім, мен істеп жатырмын...
Dialogue: 0,0:14:45.38,0:14:47.55,Default,,0,0,0,,Харада Мен сенбеймін.
Dialogue: 0,0:14:48.26,0:14:50.30,Default,,0,0,0,,Тек өзіңіз қалаған нәрсені жасаңыз
Dialogue: 0,0:14:50.38,0:14:51.64,Default,,0,0,0,,Қалағаныңды істе...
Dialogue: 0,0:14:51.72,0:14:53.80,Default,,0,0,0,,Бұл жұмыс істеуге мүмкіндік жоқ
Dialogue: 0,0:14:53.89,0:14:54.81,Default,,0,0,0,,Мен сенбеймін!
Dialogue: 0,0:14:57.31,0:14:58.85,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:59.35,0:15:00.69,Default,,0,0,0,,Көрме Батыс!
Dialogue: 0,0:15:01.27,0:15:04.57,Default,,0,0,0,,Біз мәңгі бірге болдық. Бұл мүмкін бе?
Dialogue: 0,0:15:06.03,0:15:07.03,Default,,0,0,0,,Нашар
Dialogue: 0,0:15:07.11,0:15:10.95,Default,,0,0,0,,Мен саған қатты ренжідім.
Dialogue: 0,0:15:11.03,0:15:12.53,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:19.79,0:15:21.04,Default,,0,0,0,,Тенсей
Dialogue: 0,0:15:21.12,0:15:23.58,Default,,0,0,0,,Қадағалау! Қазір бәрі жақсы
Dialogue: 0,0:15:23.67,0:15:25.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:25.46,0:15:27.96,Default,,0,0,0,,Мен әрқашан білетінмін
Dialogue: 0,0:15:28.05,0:15:28.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:29.76,0:15:31.80,Default,,0,0,0,,Әлгі жігіт өзін көп күштеп жатыр.
Dialogue: 0,0:15:31.88,0:15:33.30,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:15:34.47,0:15:37.43,Default,,0,0,0,,Бірақ команда үшін мен саған шыда деп айттым.
Dialogue: 0,0:15:38.64,0:15:39.48,Default,,0,0,0,,Жәкең
Dialogue: 0,0:15:40.23,0:15:42.23,Default,,0,0,0,,Мені босатыңызшы.
Dialogue: 0,0:15:46.44,0:15:49.19,Default,,0,0,0,,Қадағалау! Мен Йокоте туралы айтып отырмын...
Dialogue: 0,0:15:49.28,0:15:50.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:51.24,0:15:53.95,Default,,0,0,0,,Егер маған басқа жақтан өтініш келсе ше?
Dialogue: 0,0:15:54.03,0:15:55.28,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:15:57.70,0:15:59.87,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:15:59.95,0:16:03.75,Default,,0,0,0,,Меніңше, басыңды иіп, жақсылық сұраудың қажеті жоқ.
Dialogue: 0,0:16:03.83,0:16:05.63,Default,,0,0,0,,Басыңызды төмен түсіріңіз
Dialogue: 0,0:16:05.71,0:16:07.67,Default,,0,0,0,,Мен басқа команданың капитанымен жеке кездесемін.
Dialogue: 0,0:16:07.75,0:16:09.38,Default,,0,0,0,,Әңгімелеу
Dialogue: 0,0:16:09.46,0:16:11.13,Default,,0,0,0,,Бұл қақпаның жанында ма?
Dialogue: 0,0:16:11.22,0:16:13.51,Default,,0,0,0,,Тағы кім бар?
Dialogue: 0,0:16:13.59,0:16:17.01,Default,,0,0,0,,Олай болса, Кадоваки керемет жалқау болуы керек.
Dialogue: 0,0:16:17.51,0:16:20.14,Default,,0,0,0,,Қазірдің өзінде беделді орта мектептердің скауттары бізді көруге келеді.
Dialogue: 0,0:16:20.22,0:16:21.27,Default,,0,0,0,,Бұл қауесет
Dialogue: 0,0:16:21.89,0:16:24.65,Default,,0,0,0,,Сіз Кадовакиді білесіз бе?
Dialogue: 0,0:16:24.73,0:16:27.77,Default,,0,0,0,,Біз өткен жылы префектуралық турнирде кездесу туралы айтқан болатынбыз.
Dialogue: 0,0:16:27.86,0:16:30.28,Default,,0,0,0,,Сіз ойын ойнайсыз ба, әлде осыған ұқсас нәрсе ме?
Dialogue: 0,0:16:31.40,0:16:34.53,Default,,0,0,0,,Кадоваки бізге қарсы ойнағысы келеді.
Dialogue: 0,0:16:34.61,0:16:36.45,Default,,0,0,0,,Оны орнатып көріңіз
Dialogue: 0,0:16:36.53,0:16:38.53,Default,,0,0,0,,Мүмкін нәтиже шығар.
Dialogue: 0,0:16:38.62,0:16:39.91,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:16:39.99,0:16:41.37,Default,,0,0,0,,Харада
Dialogue: 0,0:16:41.45,0:16:42.41,Default,,0,0,0,,Иә
Dialogue: 0,0:16:42.50,0:16:45.92,Default,,0,0,0,,Сіз оны Кадовакиге лақтырып, соғыңыз.
Dialogue: 0,0:16:46.67,0:16:49.17,Default,,0,0,0,,Егер бұл мүмкін болса, Кадовакидің жеке басын ескере отырып,
Dialogue: 0,0:16:49.25,0:16:51.92,Default,,0,0,0,,Абсолютті жауап матч орнатылды
Dialogue: 0,0:16:52.01,0:16:54.22,Default,,0,0,0,,Қарсыласты бір жыл бойына соққы
Dialogue: 0,0:16:54.30,0:16:56.22,Default,,0,0,0,,Мен үндемейтін адам емеспін.
Dialogue: 0,0:16:56.93,0:16:58.93,Default,,0,0,0,,Онда мен сенімен сөйлесемін.
Dialogue: 0,0:17:01.06,0:17:03.39,Default,,0,0,0,,Ақылға сыймайтын Кайонжи
Dialogue: 0,0:17:03.48,0:17:06.10,Default,,0,0,0,,Харада: Бұл үлкен жауапкершілік.
Dialogue: 0,0:17:06.19,0:17:07.02,Default,,0,0,0,,Иә
Dialogue: 0,0:17:07.10,0:17:09.27,Default,,0,0,0,,Қарапайым тілмен айтқанда.
Dialogue: 0,0:17:09.82,0:17:13.32,Default,,0,0,0,,Кадоваки он жылда бір болатын талант деп аталады.
Dialogue: 0,0:17:14.53,0:17:16.82,Default,,0,0,0,,Кадоваки мырзаны өлтіргіңіз келсе, жарайды.
Dialogue: 0,0:17:21.03,0:17:22.45,Default,,0,0,0,,Такуми Ое
Dialogue: 0,0:17:22.54,0:17:24.20,Default,,0,0,0,,Бейсбол клубынан
Dialogue: 0,0:17:25.50,0:17:26.54,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:17:27.04,0:17:29.50,Default,,0,0,0,,Харада келесі күні сағат 17.00
Dialogue: 0,0:17:29.59,0:17:32.17,Default,,0,0,0,,Йокоте қаласындағы Орталық саябақта Кадовакимен кездесу
Dialogue: 0,0:17:32.25,0:17:33.09,Default,,0,0,0,,Иә
Dialogue: 0,0:17:33.80,0:17:36.34,Default,,0,0,0,,Директор сені көлікпен айдап береді.
Dialogue: 0,0:17:36.43,0:17:39.60,Default,,0,0,0,,Мен, Харада, Нагакура және мен бірге барамыз.
Dialogue: 0,0:17:39.68,0:17:40.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:40.80,0:17:42.85,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:42.93,0:17:45.98,Default,,0,0,0,,Бір минут күтіңіз! Оны естігің келмей ме?
Dialogue: 0,0:17:46.06,0:17:47.35,Default,,0,0,0,,Шындығында, 2-сыныпты үш тәжірибеші мен бір 1-сыныпты тәжірибеші қызмет барысында қаза тапты.
Dialogue: 0,0:17:47.44,0:17:50.65,Default,,0,0,0,,Кадовакиді қалай шығарып алдың?
Dialogue: 0,0:17:50.73,0:17:52.78,Default,,0,0,0,,Мен оған не дедім деп ойлайсың?
Dialogue: 0,0:17:53.32,0:17:54.86,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:17:54.94,0:17:58.32,Default,,0,0,0,,Цк... сен шынымен де дос емес адамсың.
Dialogue: 0,0:17:58.95,0:18:00.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:00.16,0:18:01.95,Default,,0,0,0,,140 кг жоғары тірі доппен
Dialogue: 0,0:18:02.03,0:18:04.33,Default,,0,0,0,,Мен сендерге жарысайық дедім.
Dialogue: 0,0:18:04.41,0:18:06.46,Default,,0,0,0,,Бұл шынымен де әсер етті.
Dialogue: 0,0:18:06.54,0:18:10.38,Default,,0,0,0,,Бірақ мен мұны әзіл ретінде айтқым келген жоқ.
Dialogue: 0,0:18:10.46,0:18:11.63,Default,,0,0,0,,(Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,0:18:28.19,0:18:29.02,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:18:29.81,0:18:30.77,Default,,0,0,0,,Йо
Dialogue: 0,0:18:33.48,0:18:34.53,Default,,0,0,0,,Бұл ол ма?
Dialogue: 0,0:18:34.61,0:18:36.03,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:18:36.11,0:18:37.69,Default,,0,0,0,,Жіңішке
Dialogue: 0,0:18:37.78,0:18:40.78,Default,,0,0,0,,Сіз ғажайып допты шынымен лақтырасыз ба?
Dialogue: 0,0:18:40.86,0:18:42.66,Default,,0,0,0,,Тек жылдам доп.
Dialogue: 0,0:18:43.53,0:18:46.41,Default,,0,0,0,,Менің мектебімде бізде күнде сынақ болады.
Dialogue: 0,0:18:47.08,0:18:49.92,Default,,0,0,0,,Үшінші курс студенттері емтихан режимінде.
Dialogue: 0,0:18:50.00,0:18:53.54,Default,,0,0,0,,Кадоваки міндетті түрде спортты ұсынады.
Dialogue: 0,0:18:54.09,0:18:55.55,Default,,0,0,0,,Емтихан маңызды емес.
Dialogue: 0,0:18:55.63,0:18:59.05,Default,,0,0,0,,Бірақ менің айналамдағы адамдар сабақты қатты оқып жатқан сияқты.
Dialogue: 0,0:18:59.13,0:19:01.64,Default,,0,0,0,,Бірдеңе қызықсыз болды.
Dialogue: 0,0:19:01.72,0:19:04.56,Default,,0,0,0,,Сол кезде маған Кайондзи телефон соқты.
Dialogue: 0,0:19:05.14,0:19:08.56,Default,,0,0,0,,Қызық болар деп ойлап, бортқа секірдім.
Dialogue: 0,0:19:08.64,0:19:11.19,Default,,0,0,0,,Сіз қызықсыз сапарға шықтыңыз ба?
Dialogue: 0,0:19:11.27,0:19:14.19,Default,,0,0,0,,Бұл әңгіменің жартысы ғана.
Dialogue: 0,0:19:14.27,0:19:15.44,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:19:17.03,0:19:19.03,Default,,0,0,0,,Нақты нәрсеге ұқсайды
Dialogue: 0,0:19:37.00,0:19:37.92,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:19:39.34,0:19:42.18,Default,,0,0,0,,Түсіндім, бұл рас.
Dialogue: 0,0:19:46.60,0:19:47.43,Default,,0,0,0,,Доп
Dialogue: 0,0:19:51.10,0:19:52.90,Default,,0,0,0,,Сәлем, Качер мырза.
Dialogue: 0,0:19:53.48,0:19:55.44,Default,,0,0,0,,...
Dialogue: 0,0:19:55.52,0:19:56.82,Default,,0,0,0,,Тонна лақтыру?
Dialogue: 0,0:19:56.90,0:19:58.23,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:19:58.32,0:20:00.78,Default,,0,0,0,,Бұл сәйкестік емес.
Dialogue: 0,0:20:00.86,0:20:03.32,Default,,0,0,0,,...
Dialogue: 0,0:20:03.41,0:20:06.33,Default,,0,0,0,,Сен маған ең жылдам допты лақтыра аласың ба?
Dialogue: 0,0:20:07.03,0:20:08.08,Default,,0,0,0,,Иә
Dialogue: 0,0:20:08.79,0:20:10.00,Default,,0,0,0,,(Митти соққан Go дыбысы)
Dialogue: 0,0:20:23.18,0:20:24.18,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:20:28.43,0:20:29.26,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:29.35,0:20:31.02,Default,,0,0,0,,-（）… -（）
Dialogue: 0,0:20:31.10,0:20:32.43,Default,,0,0,0,,Уақыт!
Dialogue: 0,0:20:35.31,0:20:37.31,Default,,0,0,0,,Бұл керемет доп!
Dialogue: 0,0:20:37.40,0:20:40.73,Default,,0,0,0,,...
Dialogue: 0,0:20:42.15,0:20:44.15,Default,,0,0,0,,Саусақтарыңыз дірілдеп тұр.
Dialogue: 0,0:20:45.57,0:20:47.49,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:20:48.58,0:20:50.16,Default,,0,0,0,,Келесі жолы бірдей доп...
Dialogue: 0,0:20:51.83,0:20:52.66,Default,,0,0,0,,Не?
Dialogue: 0,0:20:54.58,0:20:56.75,Default,,0,0,0,,Жоқ, түсіндім.
Dialogue: 0,0:21:07.43,0:21:08.60,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:09.26,0:21:10.60,Default,,0,0,0,,Үйге жүгіру…
Dialogue: 0,0:21:10.68,0:21:13.10,Default,,0,0,0,,Ол стендке жетті ме?
Dialogue: 0,0:21:13.18,0:21:14.77,Default,,0,0,0,,Жай ғана?
Dialogue: 0,0:21:13.18,0:21:14.77,Default,,0,0,0,,♪～
Dialogue: 0,0:21:14.77,0:21:18.86,Default,,0,0,0,,♪～
Dialogue: 0,0:21:18.94,0:21:19.86,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:20.69,0:21:22.23,Default,,0,0,0,,Такуми!
Dialogue: 0,0:22:50.99,0:22:55.99,Default,,0,0,0,,～♪
