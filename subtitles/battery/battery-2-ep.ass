Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.42,0:00:11.72,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:00:11.80,0:00:12.80,Default,,0,0,0,,О
Dialogue: 0,0:00:19.22,0:00:22.85,Default,,0,0,0,,(Көк толқында жүгірген аяқ дыбысы)
Dialogue: 0,0:00:23.64,0:00:24.85,Default,,0,0,0,,Не болды?
Dialogue: 0,0:00:26.02,0:00:27.90,Default,,0,0,0,,Бауырым, мен де барамын.
Dialogue: 0,0:00:27.98,0:00:29.02,Default,,0,0,0,,«Бару»...
Dialogue: 0,0:00:29.11,0:00:31.44,Default,,0,0,0,,Мен ғибадатханаға жүгіріп барамын.
Dialogue: 0,0:00:31.53,0:00:33.74,Default,,0,0,0,,Иә, Жәкен, менің де жүгіргім келеді.
Dialogue: 0,0:00:33.82,0:00:36.24,Default,,0,0,0,,Не, сен мені алдап тұрсың ба?
Dialogue: 0,0:00:36.32,0:00:37.53,Default,,0,0,0,,Үйге қайт
Dialogue: 0,0:00:38.12,0:00:39.24,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:00:39.33,0:00:42.12,Default,,0,0,0,,Аонами Бұл ойын емес.
Dialogue: 0,0:00:42.20,0:00:43.71,Default,,0,0,0,,Жәкен мен де солай істеймін
Dialogue: 0,0:00:44.41,0:00:47.13,Default,,0,0,0,,Сіздің ағаңыз бейсбол ойнауды төртінші сыныпта бастады, солай ма?
Dialogue: 0,0:00:47.21,0:00:49.00,Default,,0,0,0,,Мен мұны істей аламын
Dialogue: 0,0:00:49.09,0:00:51.46,Default,,0,0,0,,Мені және сені біріктірме.
Dialogue: 0,0:00:53.13,0:00:54.80,Default,,0,0,0,,Үйге барып, тыныш бол.
Dialogue: 0,0:00:54.88,0:00:55.93,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:00:56.84,0:00:58.14,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:00:58.72,0:01:00.10,Default,,0,0,0,,Себебі мен білмеймін
Dialogue: 0,0:01:01.14,0:01:03.27,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:01:08.73,0:01:10.52,Default,,0,0,0,,Ауырсынды ма?
Dialogue: 0,0:01:10.61,0:01:11.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:11.86,0:01:15.45,Default,,0,0,0,,Не? Сіз бейсбол ойнай алмайсыз.
Dialogue: 0,0:01:15.53,0:01:16.70,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:01:17.91,0:01:18.78,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:01:18.87,0:01:19.37,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:01:19.37,0:01:20.62,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:01:19.37,0:01:20.62,Default,,0,0,0,,Көк толқындар?
Dialogue: 0,0:01:21.12,0:01:22.79,Default,,0,0,0,,Қараңдаршы, бұл менің анам.
Dialogue: 0,0:01:22.87,0:01:25.29,Default,,0,0,0,,Мен уайымдап шықтым.
Dialogue: 0,0:01:26.00,0:01:27.33,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:01:29.96,0:01:30.79,Default,,0,0,0,,Аонами…
Dialogue: 0,0:01:32.84,0:01:34.17,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:01:36.42,0:01:38.59,Default,,0,0,0,,Менің ойымша, Аонами дұрыс.
Dialogue: 0,0:01:41.01,0:01:46.02,Default,,0,0,0,,♪～
Dialogue: 0,0:03:05.56,0:03:10.56,Default,,0,0,0,,～♪
Dialogue: 0,0:03:20.53,0:03:21.78,Default,,0,0,0,,Такуми-кун
Dialogue: 0,0:03:23.11,0:03:26.24,Default,,0,0,0,,Неге бара жатырсың? Осындай уақытта
Dialogue: 0,0:03:26.33,0:03:27.99,Default,,0,0,0,,Жүгіруге барыңыз
Dialogue: 0,0:03:28.08,0:03:29.08,Default,,0,0,0,,Не жүгіруде?
Dialogue: 0,0:03:29.16,0:03:30.33,Default,,0,0,0,,Сіз жүгіресіз бе?
Dialogue: 0,0:03:30.96,0:03:33.33,Default,,0,0,0,,Жүгіру десең, жүгіресің.
Dialogue: 0,0:03:36.96,0:03:38.63,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:36.96,0:03:38.63,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:03:38.63,0:03:39.42,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:03:39.51,0:03:40.34,Default,,0,0,0,,Жапон тілі
Dialogue: 0,0:03:40.42,0:03:43.89,Default,,0,0,0,,Хараданың қатты қуанғаны сонша, бұл керемет болды!
Dialogue: 0,0:03:43.97,0:03:46.89,Default,,0,0,0,,Мен бұл баланың қатты қуанғанын бірінші рет көруім.
Dialogue: 0,0:03:46.97,0:03:47.93,Default,,0,0,0,,Сәлем
Dialogue: 0,0:03:48.60,0:03:51.06,Default,,0,0,0,,Такуми-кун, сенен бір өтінішім бар.
Dialogue: 0,0:03:52.69,0:03:56.02,Default,,0,0,0,,Маған бейсбол ойнауды тоқтатуымды айта аласыз ба?
Dialogue: 0,0:03:56.11,0:03:57.69,Default,,0,0,0,,Нагакурада?
Dialogue: 0,0:03:58.69,0:04:00.78,Default,,0,0,0,,Бастапқыда мен орта мектепке келгенге дейін бейсбол ойнамадым.
Dialogue: 0,0:04:00.86,0:04:02.11,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:04:02.20,0:04:05.16,Default,,0,0,0,,Менің ойымша, Австралия да түсінеді.
Dialogue: 0,0:04:05.24,0:04:07.49,Default,,0,0,0,,Бейсбол ойнауды мәңгілікке жалғастырайық
Dialogue: 0,0:04:07.58,0:04:09.58,Default,,0,0,0,,Мен тіпті мектепті тастайтынымды айттым.
Dialogue: 0,0:04:09.66,0:04:11.00,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:04:11.08,0:04:14.00,Default,,0,0,0,,Жәкен, Такуми-кун мені сендіре ала ма деп едім.
Dialogue: 0,0:04:14.08,0:04:17.84,Default,,0,0,0,,Апай не айтар еді? Маған маңызды емес
Dialogue: 0,0:04:17.92,0:04:19.00,Default,,0,0,0,,Бұл маңызды.
Dialogue: 0,0:04:20.76,0:04:23.51,Default,,0,0,0,,Австралияның бейсбол ойнауды жалғастырғысы келетініне не себеп болды?
Dialogue: 0,0:04:23.59,0:04:25.43,Default,,0,0,0,,Бұл Такуми-кунның кінәсі.
Dialogue: 0,0:04:25.51,0:04:29.01,Default,,0,0,0,,Мен Харадамен батарея құрастыра алғаныма өте қуаныштымын.
Dialogue: 0,0:04:29.10,0:04:30.35,Default,,0,0,0,,Харада болса да
Dialogue: 0,0:04:30.43,0:04:33.18,Default,,0,0,0,,Бірге бейсбол ойнайық. Бұл біртүрлі.
Dialogue: 0,0:04:33.27,0:04:36.52,Default,,0,0,0,,Мен ғибадатханаға алға-артқа баруым керек.
Dialogue: 0,0:04:36.60,0:04:38.82,Default,,0,0,0,,Go-ға айтыңыз.
Dialogue: 0,0:04:38.90,0:04:41.36,Default,,0,0,0,,Сізде бейсболға талант жоқ. Тоқта.
Dialogue: 0,0:04:41.44,0:04:43.53,Default,,0,0,0,,-(Такуми) Ол талантты. -(Сецуко) А?
Dialogue: 0,0:04:44.24,0:04:46.78,Default,,0,0,0,,Нагакура көмегімен сіз батарея жасай аласыз.
Dialogue: 0,0:04:46.86,0:04:49.78,Default,,0,0,0,,Осындай сөздерді айтсаң, қиналып қаласың.
Dialogue: 0,0:04:50.45,0:04:53.33,Default,,0,0,0,,Мен өте көп оқимын деп ренжідім.
Dialogue: 0,0:04:53.41,0:04:55.83,Default,,0,0,0,,Осы уақытқа дейін мен оған бейсбол ойнауға рұқсат бердім.
Dialogue: 0,0:04:55.92,0:04:57.96,Default,,0,0,0,,Бұдан былай олай болмайды...
Dialogue: 0,0:04:58.04,0:04:59.79,Default,,0,0,0,,Не? Такуми-кун
Dialogue: 0,0:05:00.80,0:05:03.80,Default,,0,0,0,,Апай, маған бейсбол ойнауға рұқсат етпеңіз.
Dialogue: 0,0:05:03.88,0:05:05.51,Default,,0,0,0,,Иә, істеймін.
Dialogue: 0,0:05:21.23,0:05:22.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:23.69,0:05:24.53,Default,,0,0,0,,(тастың соғылған дыбысы)
Dialogue: 0,0:05:29.91,0:05:31.08,Default,,0,0,0,,Нагакура
Dialogue: 0,0:05:31.83,0:05:33.12,Default,,0,0,0,,Сіз түсе аласыз ба?
Dialogue: 0,0:05:33.20,0:05:35.12,Default,,0,0,0,,Мен түскенде не істеуім керек?
Dialogue: 0,0:05:36.71,0:05:38.62,Default,,0,0,0,,Қане, аулау ойынын ойнайық
Dialogue: 0,0:05:43.84,0:05:46.13,Default,,0,0,0,,Сәл ерте ояндың.
Dialogue: 0,0:05:46.22,0:05:46.72,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:05:46.72,0:05:47.63,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:05:46.72,0:05:47.63,Default,,0,0,0,,Мен мұнда жүгіруді ойлап кездейсоқ келдім.
Dialogue: 0,0:05:47.63,0:05:50.30,Default,,0,0,0,,Мен жүгіруді ойлап кездейсоқ келдім.
Dialogue: 0,0:05:50.39,0:05:52.72,Default,,0,0,0,,Сіз қолғаптарыңызбен жүгіруге барасыз ба?
Dialogue: 0,0:06:13.79,0:06:15.62,Default,,0,0,0,,Мен бұған байсалды қарауым керек пе?
Dialogue: 0,0:06:15.70,0:06:17.75,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасай алмайсыз.
Dialogue: 0,0:06:17.83,0:06:19.79,Default,,0,0,0,,Қараңғы, мен сені ұстай алмаймын.
Dialogue: 0,0:06:19.87,0:06:22.63,Default,,0,0,0,,Жарайды, 80% қуатпен, иә.
Dialogue: 0,0:06:23.75,0:06:24.63,Default,,0,0,0,,70%
Dialogue: 0,0:06:24.71,0:06:27.26,Default,,0,0,0,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:06:43.73,0:06:46.44,Default,,0,0,0,,(әтеш айқайлайды)
Dialogue: 0,0:06:47.03,0:06:48.78,Default,,0,0,0,,Бұл таңның белгісі
Dialogue: 0,0:06:48.86,0:06:49.99,Default,,0,0,0,,Соңғы доп
Dialogue: 0,0:06:50.49,0:06:51.36,Default,,0,0,0,,О
Dialogue: 0,0:06:51.45,0:06:54.24,Default,,0,0,0,,Дегенмен, толық қуат 100% құрайды.
Dialogue: 0,0:06:54.33,0:06:56.54,Default,,0,0,0,,Кесуді өткізіп алып, жараланып қалсаңыз, білмейсіз.
Dialogue: 0,0:07:11.80,0:07:14.01,Default,,0,0,0,,Бұл ең жақсы доп
Dialogue: 0,0:07:14.10,0:07:15.64,Default,,0,0,0,,Мен бұрыштарды қиған жоқпын.
Dialogue: 0,0:07:15.72,0:07:18.85,Default,,0,0,0,,Ойын кезінде осылайша допты қанша қашықтыққа лақтыруға болады?
Dialogue: 0,0:07:18.93,0:07:20.56,Default,,0,0,0,,Кез келген сома
Dialogue: 0,0:07:20.64,0:07:22.65,Default,,0,0,0,,Қарапайым тілмен айтқанда
Dialogue: 0,0:07:24.15,0:07:25.48,Default,,0,0,0,,Ертең кездескенше...
Dialogue: 0,0:07:25.57,0:07:26.86,Default,,0,0,0,,Жоқ, бүгін.
Dialogue: 0,0:07:37.29,0:07:38.12,Default,,0,0,0,,Ах
Dialogue: 0,0:07:38.79,0:07:39.33,Default,,0,0,0,,Ата
Dialogue: 0,0:07:39.33,0:07:39.91,Default,,0,0,0,,Ата
Dialogue: 0,0:07:39.33,0:07:39.91,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:07:39.91,0:07:41.12,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:07:41.21,0:07:43.25,Default,,0,0,0,,Неліктен дәл осы уақытта...
Dialogue: 0,0:07:43.33,0:07:46.75,Default,,0,0,0,,Қартайған сайын ерте оянасыз.
Dialogue: 0,0:07:46.84,0:07:49.42,Default,,0,0,0,,Сізге көбірек ұйықтау керек.
Dialogue: 0,0:07:49.51,0:07:50.80,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:07:52.88,0:07:54.51,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:07:55.14,0:07:58.01,Default,,0,0,0,,Сіз жеңіліске ұшырасаңыз да, допты өзіңіз қалағандай лақтыра аласыз.
Dialogue: 0,0:07:58.10,0:08:01.10,Default,,0,0,0,,Бұл тек күш-жігермен жасай алатын нәрсе емес.
Dialogue: 0,0:08:01.18,0:08:04.02,Default,,0,0,0,,Иә, маған талант берілді.
Dialogue: 0,0:08:06.23,0:08:09.03,Default,,0,0,0,,Бейсболды өзіңіз қалағандай мәңгілікке ойнаңыз
Dialogue: 0,0:08:09.11,0:08:10.78,Default,,0,0,0,,Сіз жасай алатын көп нәрсе бар.
Dialogue: 0,0:08:10.86,0:08:13.32,Default,,0,0,0,,Әр адамның қолында билік болса да
Dialogue: 0,0:08:13.40,0:08:16.99,Default,,0,0,0,,Белгілі бір себептермен біз топ болып ойында жеңіске жете алмаймыз.
Dialogue: 0,0:08:17.07,0:08:19.41,Default,,0,0,0,,Бейсболдың мәні осы.
Dialogue: 0,0:08:19.49,0:08:21.62,Default,,0,0,0,,Матчтан жеңілу
Dialogue: 0,0:08:21.70,0:08:23.92,Default,,0,0,0,,Сіз де ұтыласыз.
Dialogue: 0,0:08:24.00,0:08:27.63,Default,,0,0,0,,Мен атамның не айтып тұрғанын түсінбеймін.
Dialogue: 0,0:08:27.71,0:08:29.92,Default,,0,0,0,,Сен мені мақтаған жоқсың ба?
Dialogue: 0,0:08:30.00,0:08:32.67,Default,,0,0,0,,Мен де түсінбейтін нәрселер өте көп.
Dialogue: 0,0:08:32.76,0:08:36.18,Default,,0,0,0,,Сөзбен айтайын десем, быт-шыт болып қалады.
Dialogue: 0,0:08:36.26,0:08:37.89,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:53.74,0:08:56.70,Default,,0,0,0,,Такуми Бұл орта мектеп формасы.
Dialogue: 0,0:08:57.41,0:08:59.95,Default,,0,0,0,,Ұсқынсыз форма.
Dialogue: 0,0:09:00.74,0:09:03.12,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:09:03.20,0:09:04.21,Default,,0,0,0,,Не?
Dialogue: 0,0:09:04.29,0:09:07.25,Default,,0,0,0,,Кіші орта мектеп өте қиын сияқты.
Dialogue: 0,0:09:07.75,0:09:10.21,Default,,0,0,0,,Мен өзімнің шебер мінезіммен жүре аламын ба деп ойлаймын.
Dialogue: 0,0:09:10.29,0:09:11.71,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:09:12.30,0:09:14.72,Default,,0,0,0,,Мен үшін неге алаңдайсың?
Dialogue: 0,0:09:14.80,0:09:17.80,Default,,0,0,0,,Дәл солай айтасың.
Dialogue: 0,0:09:19.51,0:09:21.22,Default,,0,0,0,,Көк толқындар да.
Dialogue: 0,0:09:22.43,0:09:26.23,Default,,0,0,0,,Бұл бала қолында бейсболды ұстап ұйықтап жатыр, бұл маңызды сияқты.
Dialogue: 0,0:09:26.85,0:09:29.11,Default,,0,0,0,,Бейсбол ойнауға шындап қарайсыз ба?
Dialogue: 0,0:09:29.69,0:09:30.65,Default,,0,0,0,,Маған маңызды емес...
Dialogue: 0,0:09:30.73,0:09:32.23,Default,,0,0,0,,Бұл маңызды!
Dialogue: 0,0:09:32.32,0:09:34.11,Default,,0,0,0,,Такуми, айтшы.
Dialogue: 0,0:09:36.36,0:09:39.53,Default,,0,0,0,,Аонамиге бейсболдан бас тартуын айт.
Dialogue: 0,0:09:40.03,0:09:42.62,Default,,0,0,0,,Ол қыз саған әрқашан тәнті болды.
Dialogue: 0,0:09:44.75,0:09:46.62,Default,,0,0,0,,Сецуко да маған қоңырау шалды.
Dialogue: 0,0:09:47.21,0:09:49.88,Default,,0,0,0,,Го-кун туралы сұрағаныңызды естідім бе?
Dialogue: 0,0:09:49.96,0:09:52.38,Default,,0,0,0,,Бейсбол, маған бас тартуға рұқсат етіңіз
Dialogue: 0,0:09:52.46,0:09:54.63,Default,,0,0,0,,Мені қабылдамады деп жыладым.
Dialogue: 0,0:09:54.71,0:09:57.01,Default,,0,0,0,,Мен Аонами туралы білмеймін.
Dialogue: 0,0:09:57.68,0:09:58.97,Default,,0,0,0,,Бірақ Нагакура
Dialogue: 0,0:09:59.05,0:10:01.64,Default,,0,0,0,,Мен саған бейсболды таста десем де, тастамайтын шығарсың.
Dialogue: 0,0:10:01.72,0:10:03.64,Default,,0,0,0,,Мен де өзімді ауыр сезінемін.
Dialogue: 0,0:10:04.27,0:10:07.06,Default,,0,0,0,,Сецуко Го-кунның болашағын ойлап отыр.
Dialogue: 0,0:10:07.14,0:10:10.02,Default,,0,0,0,,Себебі мен оның бейсбол ойнауды доғарғанын қалаймын.
Dialogue: 0,0:10:10.10,0:10:12.15,Default,,0,0,0,,Сіз де бұл туралы ойланыңыз ба?
Dialogue: 0,0:10:12.86,0:10:15.28,Default,,0,0,0,,Такуми жақсы болса, кім ұстаушы екені маңызды емес.
Dialogue: 0,0:10:15.36,0:10:17.99,Default,,0,0,0,,Кошиенге немесе Цзингуға баруға болады.
Dialogue: 0,0:10:19.20,0:10:21.20,Default,,0,0,0,,Нагакура болмаса, бұл жақсы емес.
Dialogue: 0,0:10:22.28,0:10:23.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:24.49,0:10:26.33,Default,,0,0,0,,Бұл жақсы емес деу артықтау.
Dialogue: 0,0:10:27.00,0:10:29.33,Default,,0,0,0,,Менің жасым әлі 13-ке де толмаған.
Dialogue: 0,0:10:29.42,0:10:33.25,Default,,0,0,0,,Мұндай шешуші кездесу біртүрлі емес пе?
Dialogue: 0,0:10:35.55,0:10:36.84,Default,,0,0,0,,Мама, сен ақымақсың.
Dialogue: 0,0:10:36.92,0:10:37.97,Default,,0,0,0,,Не?
Dialogue: 0,0:10:38.05,0:10:41.84,Default,,0,0,0,,Менің анам да, Нагакураның тәтесі де ештеңе түсінбейді.
Dialogue: 0,0:10:41.93,0:10:44.85,Default,,0,0,0,,Такуми, сен... не істеп жатырсың?
Dialogue: 0,0:10:44.93,0:10:48.31,Default,,0,0,0,,Мен ғибадатханаға барамын, өйткені мен Нагакураға уәде бердім.
Dialogue: 0,0:11:02.03,0:11:04.87,Default,,0,0,0,,(ойнап жатқан дыбыс)
Dialogue: 0,0:11:04.95,0:11:08.04,Default,,0,0,0,,Аонами, сен көп күш жұмсап жатырсың.
Dialogue: 0,0:11:08.12,0:11:09.37,Default,,0,0,0,,Баяу лақтыруға тырысыңыз.
Dialogue: 0,0:11:09.46,0:11:10.54,Default,,0,0,0,,Иә
Dialogue: 0,0:11:12.33,0:11:13.50,Default,,0,0,0,,Осы жылдамдықпен
Dialogue: 0,0:11:29.10,0:11:32.56,Default,,0,0,0,,Мұндай көзі бар бала жақсы өседі.
Dialogue: 0,0:11:35.98,0:11:36.90,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:11:36.98,0:11:39.15,Default,,0,0,0,,Харада, келдің бе?
Dialogue: 0,0:11:40.65,0:11:42.82,Default,,0,0,0,,Мен Го Чанмен ойнағанда қатты толқып кеттім.
Dialogue: 0,0:11:42.91,0:11:44.66,Default,,0,0,0,,Менің допыммен
Dialogue: 0,0:11:44.74,0:11:47.16,Default,,0,0,0,,Бұл мен үшін өте жақсы келді.
Dialogue: 0,0:11:47.24,0:11:50.29,Default,,0,0,0,,Олай болса, Аонами де үлкен мәселе.
Dialogue: 0,0:11:50.37,0:11:52.92,Default,,0,0,0,,Мүмкін ағамнан да асып түсермін.
Dialogue: 0,0:11:53.00,0:11:56.21,Default,,0,0,0,,Нагакура Мұндай абайсызда сөйлеме.
Dialogue: 0,0:11:56.29,0:11:58.67,Default,,0,0,0,,Неге, неге ашуланасың?
Dialogue: 0,0:11:58.75,0:12:00.63,Default,,0,0,0,,Мен өз-өзімді өлтіруге тырыстым.
Dialogue: 0,0:12:00.72,0:12:02.17,Default,,0,0,0,,Аонами, қазір үйге қайт.
Dialogue: 0,0:12:02.26,0:12:04.89,Default,,0,0,0,,Әй, сен неге үйге бармайсың?
Dialogue: 0,0:12:04.97,0:12:07.72,Default,,0,0,0,,Анаң үйге баруыңды күтіп отыр.
Dialogue: 0,0:12:07.81,0:12:11.18,Default,,0,0,0,,Мен үйге бармаймын. Мен ағам мен Го Чанның мұны істегенін көремін.
Dialogue: 0,0:12:11.27,0:12:14.19,Default,,0,0,0,,Көк толқын болғаны маңызды емес.
Dialogue: 0,0:12:14.27,0:12:17.57,Default,,0,0,0,,Бұл тек сіздің айтуыңыз, маңызды емес.
Dialogue: 0,0:12:18.86,0:12:21.19,Default,,0,0,0,,Аонами, сен мұны істей алмайсың.
Dialogue: 0,0:12:21.78,0:12:24.45,Default,,0,0,0,,Қанша тырыссаң да мен бола алмайсың.
Dialogue: 0,0:12:24.53,0:12:27.95,Default,,0,0,0,,Мен ағамдай болғым келеді.
Dialogue: 0,0:12:28.03,0:12:29.95,Default,,0,0,0,,Мен жай ғана бейсбол ойнағым келеді
Dialogue: 0,0:12:31.16,0:12:33.21,Default,,0,0,0,,Мықты бол, Аонами
Dialogue: 0,0:12:33.79,0:12:34.96,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:12:37.17,0:12:39.46,Default,,0,0,0,,Мен атаммен қармақ ойнадым
Dialogue: 0,0:12:39.55,0:12:41.71,Default,,0,0,0,,Менен бейсбол ойнағым келе ме деп сұрады.
Dialogue: 0,0:12:41.80,0:12:45.05,Default,,0,0,0,,Мен таңғажайып нәрсе жасағым келеді десем, ол маған қолымнан келгеннің бәрін жасауымды айтты.
Dialogue: 0,0:12:45.13,0:12:46.47,Default,,0,0,0,,Ағамдай бола алмасам да
Dialogue: 0,0:12:46.55,0:12:48.97,Default,,0,0,0,,Мүмкін біз көңілді бейсбол ойнай аламыз.
Dialogue: 0,0:12:49.05,0:12:51.64,Default,,0,0,0,,Сен атаңмен қармақ ойнадың ба?
Dialogue: 0,0:12:51.72,0:12:54.69,Default,,0,0,0,,Иә, ағам жүгіруге кеткенде.
Dialogue: 0,0:12:54.77,0:12:56.23,Default,,0,0,0,,Ата
Dialogue: 0,0:12:58.94,0:13:02.32,Default,,0,0,0,,Идиот! Сіз бейсбол ойнай аласыз ба?
Dialogue: 0,0:13:02.82,0:13:04.74,Default,,0,0,0,,Бейсбол қызықты ма?
Dialogue: 0,0:13:04.82,0:13:06.99,Default,,0,0,0,,Біраз жүгіргеннен кейін де тынысым тарылады.
Dialogue: 0,0:13:07.07,0:13:08.74,Default,,0,0,0,,Мен бейсбол ойнай алмаймын.
Dialogue: 0,0:13:08.82,0:13:10.41,Default,,0,0,0,,Бірден ыстығың көтеріліп, ұйықтайсың.
Dialogue: 0,0:13:10.49,0:13:12.58,Default,,0,0,0,,Харада, тоқтат.
Dialogue: 0,0:13:12.66,0:13:13.75,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:13:13.83,0:13:16.87,Default,,0,0,0,,Өзіңізді барлық істе ең жақсымын деп ойламаңыз.
Dialogue: 0,0:13:16.96,0:13:18.79,Default,,0,0,0,,Бастық болмаңыз
Dialogue: 0,0:13:18.88,0:13:19.92,Default,,0,0,0,,Мен айта аламын
Dialogue: 0,0:13:20.00,0:13:22.13,Default,,0,0,0,,Оның ағама да, анама да қатысы жоқ.
Dialogue: 0,0:13:22.21,0:13:24.13,Default,,0,0,0,,Мен бейсбол ойнаймын.
Dialogue: 0,0:13:24.22,0:13:25.13,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:13:25.22,0:13:26.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:28.59,0:13:29.43,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:13:29.51,0:13:30.68,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:13:30.76,0:13:31.97,Default,,0,0,0,,Идиот!
Dialogue: 0,0:13:32.06,0:13:34.14,Default,,0,0,0,,Сіз тым көп істеп жатырсыз.
Dialogue: 0,0:13:41.15,0:13:42.65,Default,,0,0,0,,Жаман
Dialogue: 0,0:13:46.57,0:13:47.49,Default,,0,0,0,,(Аонамидің жылағаны)
Dialogue: 0,0:13:47.49,0:13:49.57,Default,,0,0,0,,(Аонамидің жылағаны)
Dialogue: 0,0:13:47.49,0:13:49.57,Default,,0,0,0,,Nitta Stars-те барлығына айтыңыз
Dialogue: 0,0:13:49.66,0:13:52.58,Default,,0,0,0,,Ертең бірге іздейміз, енді жылама.
Dialogue: 0,0:13:53.45,0:13:56.54,Default,,0,0,0,,Бәріміз іздеп жүріп таптық.
Dialogue: 0,0:13:56.62,0:13:58.62,Default,,0,0,0,,Сен мені ертең іздей аласың ба?
Dialogue: 0,0:13:58.71,0:14:02.13,Default,,0,0,0,,Мен сені іздеймін, Джейк, бүгін үйге қайт.
Dialogue: 0,0:14:03.30,0:14:04.13,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:14:05.01,0:14:06.13,Default,,0,0,0,,Иә
Dialogue: 0,0:14:06.72,0:14:07.97,Default,,0,0,0,,Саябаққа барайық
Dialogue: 0,0:14:09.72,0:14:13.14,Default,,0,0,0,,Осылай жалғыз келдің ғой, солай ма? Үйге қайт, Аонами
Dialogue: 0,0:14:15.14,0:14:16.89,Default,,0,0,0,,Шынымен, мен қазір үйге бара алмаймын.
Dialogue: 0,0:14:17.48,0:14:19.90,Default,,0,0,0,,Бұл жерде күн ерте батады.
Dialogue: 0,0:14:27.24,0:14:30.20,Default,,0,0,0,,Харада: Бұл өте көп.
Dialogue: 0,0:14:30.28,0:14:31.66,Default,,0,0,0,,Соншалықты табанды
Dialogue: 0,0:14:31.74,0:14:34.87,Default,,0,0,0,,Қалағаныңды айт, тым көп
Dialogue: 0,0:14:34.95,0:14:37.66,Default,,0,0,0,,Аонамидің сонша ақымақ болғаны үшін жаным ашиды.
Dialogue: 0,0:14:37.75,0:14:40.75,Default,,0,0,0,,Көк толқындар Көк толқындар шулы.
Dialogue: 0,0:14:48.26,0:14:49.17,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:14:49.26,0:14:50.09,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:14:59.60,0:15:00.44,Default,,0,0,0,,Я...
Dialogue: 0,0:15:01.52,0:15:05.44,Default,,0,0,0,,Ей, бұлай аулау ойынын доғарайық.
Dialogue: 0,0:15:05.52,0:15:07.23,Default,,0,0,0,,Мен тұншығып жатырмын
Dialogue: 0,0:15:07.32,0:15:09.45,Default,,0,0,0,,Өкпе сыйымдылығының болмауынан айырмашылығы бар ма?
Dialogue: 0,0:15:09.53,0:15:11.24,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:15:11.32,0:15:14.45,Default,,0,0,0,,Егер өтірік айтсаң, доптың күші әдеттегіден аз.
Dialogue: 0,0:15:15.16,0:15:16.83,Default,,0,0,0,,Оны байыппен тастамаңыз
Dialogue: 0,0:15:23.58,0:15:24.50,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:15:28.96,0:15:30.67,Default,,0,0,0,,- (Макико) Жалғыз ба? -(Такуми) Иә.
Dialogue: 0,0:15:30.76,0:15:33.22,Default,,0,0,0,,Аонами әлі оралған жоқ.
Dialogue: 0,0:15:33.30,0:15:35.18,Default,,0,0,0,,Мен біргеміз деп ойладым.
Dialogue: 0,0:15:35.26,0:15:36.35,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:15:45.02,0:15:46.36,Default,,0,0,0,,Мен сені іздеймін.
Dialogue: 0,0:15:46.44,0:15:48.15,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:15:59.12,0:15:59.95,Default,,0,0,0,,Нагакура!
Dialogue: 0,0:16:00.66,0:16:04.33,Default,,0,0,0,,Шынымды айтсам, Аонамидің велосипеді сол жерде еді.
Dialogue: 0,0:16:09.55,0:16:10.97,Default,,0,0,0,,Көк толқындар!
Dialogue: 0,0:16:11.59,0:16:15.47,Default,,0,0,0,,Орманды аралап, тоғанға түсейік.
Dialogue: 0,0:16:15.55,0:16:16.72,Default,,0,0,0,,Оның төмен түспеуінің себебі—
Dialogue: 0,0:16:17.43,0:16:18.93,Default,,0,0,0,,Көк толқындар!
Dialogue: 0,0:16:19.01,0:16:20.27,Default,,0,0,0,,Көк толқындар!
Dialogue: 0,0:16:20.93,0:16:23.35,Default,,0,0,0,,Егер сіз оны тоғанның жанынан таба алмасаңыз
Dialogue: 0,0:16:23.44,0:16:25.60,Default,,0,0,0,,Ересек адамға қоңырау шалмаңыз.
Dialogue: 0,0:16:27.40,0:16:30.36,Default,,0,0,0,,Аонами ақымақ! Жауап беріңіз!
Dialogue: 0,0:16:36.03,0:16:38.37,Default,,0,0,0,,Мұндай жерде көк толқын болмайды.
Dialogue: 0,0:16:38.45,0:16:40.37,Default,,0,0,0,,Сіз мұны түсінбейсіз.
Dialogue: 0,0:16:40.45,0:16:42.87,Default,,0,0,0,,Ол қатты қорқады.
Dialogue: 0,0:16:42.96,0:16:45.37,Default,,0,0,0,,Мен мұндай жерде жалғыз қала алмаймын.
Dialogue: 0,0:16:45.46,0:16:48.59,Default,,0,0,0,,Мен оның үйде екеніне сенімдімін.
Dialogue: 0,0:16:48.67,0:16:50.46,Default,,0,0,0,,Тамақты жеу...
Dialogue: 0,0:16:50.55,0:16:52.38,Default,,0,0,0,,- (Австралия) Велосипедіңізді қалдырдыңыз ба? -(Такуми) А...
Dialogue: 0,0:16:55.59,0:16:57.14,Default,,0,0,0,,Көк толқындар!
Dialogue: 0,0:16:57.72,0:16:58.89,Default,,0,0,0,,Көк толқындар!
Dialogue: 0,0:17:00.56,0:17:01.39,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:17:02.56,0:17:03.89,Default,,0,0,0,,Аонами сонда ма?
Dialogue: 0,0:17:04.48,0:17:06.90,Default,,0,0,0,,Тоған жағасында қозғалуға қорқамын
Dialogue: 0,0:17:06.98,0:17:08.56,Default,,0,0,0,,Бұл қайда!
Dialogue: 0,0:17:08.65,0:17:09.77,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:17:10.98,0:17:12.90,Default,,0,0,0,,Арғы жағындағы ағаштың астында
Dialogue: 0,0:17:14.28,0:17:15.40,Default,,0,0,0,,Қозғалма, ақымақ!
Dialogue: 0,0:17:15.49,0:17:17.28,Default,,0,0,0,,Құлап кетсем не істеуім керек?
Dialogue: 0,0:17:17.36,0:17:18.41,Default,,0,0,0,,Харада жүгірме
Dialogue: 0,0:17:18.49,0:17:19.53,Default,,0,0,0,,Бұл оңай-ақ болар, иә? Хех, хе-хех, хе
Dialogue: 0,0:17:19.62,0:17:20.91,Default,,0,0,0,,(жылжымалы дыбыс)
Dialogue: 0,0:17:26.00,0:17:27.42,Default,,0,0,0,,Харада!
Dialogue: 0,0:17:27.50,0:17:28.67,Default,,0,0,0,,Харада
Dialogue: 0,0:17:36.55,0:17:40.93,Default,,0,0,0,,(Такумидің ауыр тыныс алуы)
Dialogue: 0,0:17:42.18,0:17:44.68,Default,,0,0,0,,Идиот, сен қауіпті дедің.
Dialogue: 0,0:17:44.77,0:17:46.19,Default,,0,0,0,,Өлу
Dialogue: 0,0:17:46.69,0:17:47.69,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:17:47.77,0:17:51.19,Default,,0,0,0,,Аонами де қозғалмайды. Қазір барайық!
Dialogue: 0,0:18:08.50,0:18:10.46,Default,,0,0,0,,Неліктен ол жерге тап болдыңыз?
Dialogue: 0,0:18:10.54,0:18:13.30,Default,,0,0,0,,Допты іздесем, ол бейтаныс жерден шықты.
Dialogue: 0,0:18:13.38,0:18:14.96,Default,,0,0,0,,Енді үйге бара алмайсың
Dialogue: 0,0:18:15.55,0:18:17.97,Default,,0,0,0,,Мен қорықтым, бірақ орнында қалдым.
Dialogue: 0,0:18:18.05,0:18:19.89,Default,,0,0,0,,Дұрыс айттыңыз.
Dialogue: 0,0:18:19.97,0:18:22.89,Default,,0,0,0,,Мен нашар қимылдасам, ол аға сияқты әрекет ете бастады.
Dialogue: 0,0:18:24.22,0:18:25.97,Default,,0,0,0,,Бауырым, амансың ба?
Dialogue: 0,0:18:27.94,0:18:30.94,Default,,0,0,0,,Онда не істеп жүрсің, ақымақ?
Dialogue: 0,0:18:31.02,0:18:34.78,Default,,0,0,0,,Аонами керемет болды және қозғалыссыз қалды.
Dialogue: 0,0:18:34.86,0:18:37.24,Default,,0,0,0,,Адасқанда жасалатын негізгі әрекеттер
Dialogue: 0,0:18:37.32,0:18:40.24,Default,,0,0,0,,Ағаш түбінде тынықпай жатып ұйықтап қалдым.
Dialogue: 0,0:18:40.32,0:18:41.49,Default,,0,0,0,,Сіз ұйықтадыңыз ба?
Dialogue: 0,0:18:41.57,0:18:43.33,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:18:43.41,0:18:46.83,Default,,0,0,0,,Аонами сіз ойлағаннан әлдеқайда үлкен.
Dialogue: 0,0:18:46.91,0:18:47.75,Default,,0,0,0,,Хмм…
Dialogue: 0,0:18:47.83,0:18:50.62,Default,,0,0,0,,Ағам көбірек үрейленді.
Dialogue: 0,0:18:50.71,0:18:52.96,Default,,0,0,0,,Төбедегі мөлдір жүзден мүлде бөлек.
Dialogue: 0,0:18:53.79,0:18:55.00,Default,,0,0,0,,Мүмкін Харада...
Dialogue: 0,0:18:55.75,0:18:56.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:56.71,0:19:00.13,Default,,0,0,0,,Сіз ешқашан қайта-қайта соққы алған емессіз, солай ма?
Dialogue: 0,0:19:00.22,0:19:01.47,Default,,0,0,0,,және үшінші (Three) фильмде алғашқы болып өлген адамның немересі, және т.б.—
Dialogue: 0,0:19:01.55,0:19:03.80,Default,,0,0,0,,Шығулар жоқ, базалар жүктелді, сіз шымшусыз.
Dialogue: 0,0:19:03.89,0:19:05.81,Default,,0,0,0,,Сіз мұны ешқашан бастан өткермеген шығарсыз.
Dialogue: 0,0:19:05.89,0:19:07.47,Default,,0,0,0,,850 жылы адамзат алғаш рет Титаннан өз жерін қайтарып алды
Dialogue: 0,0:19:07.98,0:19:11.19,Default,,0,0,0,,Сіз шымшуда әлсіз болуыңыз керек.
Dialogue: 0,0:19:11.69,0:19:12.65,Default,,0,0,0,,Қайтару
Dialogue: 0,0:19:12.73,0:19:13.73,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:19:14.82,0:19:17.36,Default,,0,0,0,,Мені іздеп келгеніңізге рахмет.
Dialogue: 0,0:19:19.32,0:19:20.95,Default,,0,0,0,,Менің қолыма тиме
Dialogue: 0,0:19:21.74,0:19:23.24,Default,,0,0,0,,«Рахмет» деген не?
Dialogue: 0,0:19:23.82,0:19:25.74,Default,,0,0,0,,Мен сені уайымдамаймын.
Dialogue: 0,0:19:25.83,0:19:28.66,Default,,0,0,0,,Тоғанға батып, балыққа жем бол.
Dialogue: 0,0:19:28.75,0:19:30.75,Default,,0,0,0,,Әй, сен тағы да асырып жібердің.
Dialogue: 0,0:19:30.83,0:19:33.00,Default,,0,0,0,,Шулы, не бастық?
Dialogue: 0,0:19:33.08,0:19:36.00,Default,,0,0,0,,Бір шымшықта кім әлсіз? Өзіңізді мазақ етпеңіз.
Dialogue: 0,0:19:36.09,0:19:38.51,Default,,0,0,0,,Мен қысылмаймын.
Dialogue: 0,0:19:38.59,0:19:40.80,Default,,0,0,0,,сызып тастауға болмайды.
Dialogue: 0,0:19:40.88,0:19:42.97,Default,,0,0,0,,Шықпаған және жүктелген негіз не?
Dialogue: 0,0:19:44.68,0:19:45.76,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:19:45.85,0:19:49.27,Default,,0,0,0,,Шығуларсыз және тіректер жүктелген болса да, егер сіз шыбын допты ұстасаңыз, бәрі жақсы емес пе?
Dialogue: 0,0:19:51.64,0:19:53.10,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:19:53.19,0:19:55.44,Default,,0,0,0,,Содан кейін мүмкіндігінше үйге қайтыңыз
Dialogue: 0,0:19:56.36,0:19:57.27,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:19:57.36,0:19:59.82,Default,,0,0,0,,Менің ағам келе жатыр, түсіндім.
Dialogue: 0,0:19:59.90,0:20:01.28,Default,,0,0,0,,Мен көптен бері күттім
Dialogue: 0,0:20:01.95,0:20:04.07,Default,,0,0,0,,Күтіп жатып ұйықтап қалдым.
Dialogue: 0,0:20:07.37,0:20:09.37,Default,,0,0,0,,♪～
Dialogue: 0,0:20:09.37,0:20:12.75,Default,,0,0,0,,♪～
Dialogue: 0,0:20:09.37,0:20:12.75,Default,,0,0,0,,(Такумидің жылағаны)
Dialogue: 0,0:20:12.83,0:20:13.79,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:20:13.87,0:20:14.92,Default,,0,0,0,,Харада
Dialogue: 0,0:20:15.88,0:20:17.54,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:20:17.63,0:20:18.80,Default,,0,0,0,,Жақынбаңыз
Dialogue: 0,0:20:18.88,0:20:23.80,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:21:54.31,0:21:59.90,Default,,0,0,0,,～♪
Dialogue: 0,0:22:07.99,0:22:09.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:22:09.82,0:22:11.58,Default,,0,0,0,,Бауырым, ояусың ба?
Dialogue: 0,0:22:13.20,0:22:14.08,Default,,0,0,0,,Жақсы
Dialogue: 0,0:22:14.16,0:22:16.58,Default,,0,0,0,,Мама, аға, ояныңыз.
Dialogue: 0,0:22:23.17,0:22:24.25,Default,,0,0,0,,Такуми…
Dialogue: 0,0:22:24.34,0:22:25.71,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:22:25.80,0:22:27.34,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:22:28.22,0:22:29.34,Default,,0,0,0,,Ауыртпайды ма?
Dialogue: 0,0:22:31.93,0:22:34.22,Default,,0,0,0,,Есіңізде жоқ шығар, бірақ
Dialogue: 0,0:22:34.31,0:22:36.10,Default,,0,0,0,,Жапонияда қиын болды.
Dialogue: 0,0:22:36.68,0:22:38.94,Default,,0,0,0,,Доктор Нагакурадан үйге қоңырау шалуын сұраңыз.
Dialogue: 0,0:22:39.02,0:22:40.85,Default,,0,0,0,,Маған көктамыр ішіне тамшылатып жіберді...
Dialogue: 0,0:22:40.94,0:22:43.73,Default,,0,0,0,,Мұны қайталамауыңызды өтінемін.
Dialogue: 0,0:22:43.82,0:22:45.36,Default,,0,0,0,,Енді ешқашан
Dialogue: 0,0:22:45.44,0:22:47.24,Default,,0,0,0,,Жарайды
Dialogue: 0,0:22:47.32,0:22:49.86,Default,,0,0,0,,Бұл енді ешқашан болмайды
Dialogue: 0,0:22:51.36,0:22:57.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
