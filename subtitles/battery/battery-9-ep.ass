Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.84,Default,,0,0,0,,Көктемде қайталаңыз
Dialogue: 0,0:00:10.55,0:00:13.13,Default,,0,0,0,,Сізде сәйкестік бар ма?
Dialogue: 0,0:00:13.22,0:00:14.18,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:00:14.26,0:00:16.01,Default,,0,0,0,,Қайтадан жасайық
Dialogue: 0,0:00:16.51,0:00:17.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:18.35,0:00:20.64,Default,,0,0,0,,Мен сенімен дұрыс қарым-қатынас жасауым керек.
Dialogue: 0,0:00:20.72,0:00:23.85,Default,,0,0,0,,Мен бейсболдан орта мектеп бітіре алмаймын.
Dialogue: 0,0:00:23.94,0:00:26.90,Default,,0,0,0,,Мен ешкімнен ұтыла алмаймын
Dialogue: 0,0:00:26.98,0:00:28.86,Default,,0,0,0,,Жәкен ойыны
Dialogue: 0,0:00:28.94,0:00:32.15,Default,,0,0,0,,Сол кезде мен ең жақсы боламын
Dialogue: 0,0:00:32.24,0:00:34.57,Default,,0,0,0,,Өткен күндегідей, мистер.
Dialogue: 0,0:00:34.65,0:00:35.61,Default,,0,0,0,,Иә
Dialogue: 0,0:00:35.70,0:00:37.78,Default,,0,0,0,,Ха ха ха... ағайын
Dialogue: 0,0:00:39.33,0:00:40.49,Default,,0,0,0,,Го-чан, мұнда кел.
Dialogue: 0,0:00:44.96,0:00:46.08,Default,,0,0,0,,Йо
Dialogue: 0,0:00:46.71,0:00:48.13,Default,,0,0,0,,(Йосисаданың ысқырығы)
Dialogue: 0,0:00:48.21,0:00:49.21,Default,,0,0,0,,Бауырым, ойнайық
Dialogue: 0,0:00:49.29,0:00:50.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:50.21,0:00:52.34,Default,,0,0,0,,Мен Го-чанға және басқаларға уәде бердім.
Dialogue: 0,0:00:52.42,0:00:54.30,Default,,0,0,0,,Не? Мен оны тастай аламын ба?
Dialogue: 0,0:00:54.38,0:00:55.80,Default,,0,0,0,,Әй, сен не айтып тұрсың?
Dialogue: 0,0:00:55.88,0:00:59.35,Default,,0,0,0,,Құдай-ау, сен ханшайымның інісісің.
Dialogue: 0,0:00:59.43,0:01:00.60,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:01:00.68,0:01:01.89,Default,,0,0,0,,Бірге ойнағыларың келе ме?
Dialogue: 0,0:01:01.97,0:01:02.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:02.97,0:01:04.85,Default,,0,0,0,,Мен оны салайын ба?
Dialogue: 0,0:01:04.93,0:01:07.23,Default,,0,0,0,,Мына ағай да ойнай ма?
Dialogue: 0,0:01:08.61,0:01:11.27,Default,,0,0,0,,Ағай мені білдіреді ме?
Dialogue: 0,0:01:11.98,0:01:13.11,Default,,0,0,0,,Менің тамырларым жарылып кетеді?
Dialogue: 0,0:01:13.19,0:01:15.28,Default,,0,0,0,,Шуго, ағай, жасаңыз.
Dialogue: 0,0:01:13.19,0:01:15.28,Default,,0,0,0,,(Савагучидің күлкісі)
Dialogue: 0,0:01:15.28,0:01:15.36,Default,,0,0,0,,(Савагучи мен оның достары күледі)
Dialogue: 0,0:01:15.36,0:01:16.91,Default,,0,0,0,,(Савагучи мен оның достары күледі)
Dialogue: 0,0:01:15.36,0:01:16.91,Default,,0,0,0,,Күлме! Шун
Dialogue: 0,0:01:17.61,0:01:18.82,Default,,0,0,0,,Такуми
Dialogue: 0,0:01:18.91,0:01:19.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:20.53,0:01:21.91,Default,,0,0,0,,Сіз...
Dialogue: 0,0:01:23.62,0:01:24.91,Default,,0,0,0,,Го-чан, мені ұстап ал.
Dialogue: 0,0:01:25.00,0:01:26.41,Default,,0,0,0,,Аонами...
Dialogue: 0,0:01:26.50,0:01:28.29,Default,,0,0,0,,Сіз маған бұрын уәде бергенсіз.
Dialogue: 0,0:01:28.37,0:01:30.92,Default,,0,0,0,,Мен лақтырсам, ұстайсың дедің.
Dialogue: 0,0:01:31.00,0:01:32.59,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:01:33.21,0:01:35.17,Default,,0,0,0,,Сол қария да бірге жасайды.
Dialogue: 0,0:01:35.26,0:01:38.18,Default,,0,0,0,,Бір секунд күте тұрыңыз, маған үзіліс беріңіз.
Dialogue: 0,0:01:38.26,0:01:41.43,Default,,0,0,0,,Ағаң екеуміздің екі-ақ айырмашылығым бар.
Dialogue: 0,0:01:41.51,0:01:42.43,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:01:42.51,0:01:45.93,Default,,0,0,0,,Химе-санның інісі күткендей хахахаха
Dialogue: 0,0:01:46.02,0:01:48.35,Default,,0,0,0,,Мен бірінші базаны ойнаймын.
Dialogue: 0,0:01:48.44,0:01:50.69,Default,,0,0,0,,Харада сыртындағы Уротсуиторе аймағы
Dialogue: 0,0:01:54.32,0:01:56.19,Default,,0,0,0,,Такуми сен
Dialogue: 0,0:01:56.28,0:01:58.61,Default,,0,0,0,,Сіз бейсбол ойнадыңыз ба?
Dialogue: 0,0:02:01.03,0:02:02.16,Default,,0,0,0,,Осыншама ма?
Dialogue: 0,0:02:03.03,0:02:08.04,Default,,0,0,0,,♪～
Dialogue: 0,0:03:27.54,0:03:32.54,Default,,0,0,0,,～♪
Dialogue: 0,0:03:40.05,0:03:42.34,Default,,0,0,0,,Куриносуке, дайындал.
Dialogue: 0,0:03:42.43,0:03:44.80,Default,,0,0,0,,Райнер сізге келеді!
Dialogue: 0,0:03:44.89,0:03:46.47,Default,,0,0,0,,Хехе, келіңдер.
Dialogue: 0,0:03:46.55,0:03:49.06,Default,,0,0,0,,Шун, байыпты болма.
Dialogue: 0,0:03:50.39,0:03:51.60,Default,,0,0,0,,Лақтыру
Dialogue: 0,0:03:55.73,0:03:56.56,Default,,0,0,0,,О...
Dialogue: 0,0:03:57.44,0:03:59.23,Default,,0,0,0,,Кіші інісі Харада Иә!
Dialogue: 0,0:03:59.32,0:04:00.32,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:02.24,0:04:03.24,Default,,0,0,0,,Сиыр!
Dialogue: 0,0:04:04.24,0:04:06.37,Default,,0,0,0,,Иә шықты~
Dialogue: 0,0:04:06.45,0:04:09.49,Default,,0,0,0,,Бұндай нәрсе қуырылған, Мизугаки-сенпай.
Dialogue: 0,0:04:09.58,0:04:10.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:10.95,0:04:12.21,Default,,0,0,0,,Шынымен көңілсіз
Dialogue: 0,0:04:12.29,0:04:13.83,Default,,0,0,0,,Бұл не Куриносоке?
Dialogue: 0,0:04:13.92,0:04:17.00,Default,,0,0,0,,Кайонджи қандай білім берді?
Dialogue: 0,0:04:17.09,0:04:19.21,Default,,0,0,0,,Жылауға тырыспаңыз. Жылама.
Dialogue: 0,0:04:19.30,0:04:21.38,Default,,0,0,0,,Бірақ мұны істеу өте қиын.
Dialogue: 0,0:04:21.46,0:04:22.97,Default,,0,0,0,,Куриносуке?
Dialogue: 0,0:04:23.05,0:04:24.97,Default,,0,0,0,,Әлгі кішкентай жігіт
Dialogue: 0,0:04:25.05,0:04:27.64,Default,,0,0,0,,Допты дұрыс және төмен жинау
Dialogue: 0,0:04:30.22,0:04:31.39,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:04:34.06,0:04:37.65,Default,,0,0,0,,Нагакура: Сіз шыбындарды ұстауға шебер емессіз.
Dialogue: 0,0:04:37.73,0:04:39.44,Default,,0,0,0,,Кішкене тамашарақ жасайық
Dialogue: 0,0:04:39.52,0:04:40.53,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:04:40.61,0:04:42.78,Default,,0,0,0,,Үйірме жұмыстары басталған кезде нұсқаулық беріңіз.
Dialogue: 0,0:04:42.86,0:04:45.32,Default,,0,0,0,,Иә? «Маған жол көрсетіңізші»
Dialogue: 0,0:04:45.41,0:04:47.03,Default,,0,0,0,,Сіз тағы да аулаушы ойнап жатырсыз ба?
Dialogue: 0,0:04:50.54,0:04:51.66,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:51.74,0:04:53.41,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:04:53.50,0:04:55.67,Default,,0,0,0,,Қолыңнан келгенін істе, ағай!
Dialogue: 0,0:04:55.75,0:04:56.42,Default,,0,0,0,,(Мизугаки мен оның достары күледі)
Dialogue: 0,0:04:56.42,0:04:57.33,Default,,0,0,0,,(Мизугаки мен оның достары күледі)
Dialogue: 0,0:04:56.42,0:04:57.33,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:58.00,0:05:01.92,Default,,0,0,0,,Аонами: Доптың ортасын дұрыс ұстағаныңызға көз жеткізіңіз.
Dialogue: 0,0:05:04.17,0:05:05.17,Default,,0,0,0,,Иә
Dialogue: 0,0:05:05.26,0:05:07.18,Default,,0,0,0,,Қолыңнан келгенін істе, ағай!
Dialogue: 0,0:05:07.26,0:05:08.47,Default,,0,0,0,,Шун Урусее
Dialogue: 0,0:05:08.55,0:05:10.39,Default,,0,0,0,,Сен ақымақсың ба? Қазіргісі - Куриносуке.
Dialogue: 0,0:05:10.47,0:05:12.43,Default,,0,0,0,,Екеуі де бірдей, солай ма?
Dialogue: 0,0:05:13.02,0:05:16.06,Default,,0,0,0,,Мен саған төмен, бос допты соғуды үйретемін.
Dialogue: 0,0:05:16.14,0:05:17.19,Default,,0,0,0,,Иә
Dialogue: 0,0:05:21.27,0:05:22.32,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:05:23.40,0:05:24.32,Default,,0,0,0,,Такумиді басып алыңыз!
Dialogue: 0,0:05:33.37,0:05:34.66,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:05:34.75,0:05:35.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:36.00,0:05:37.67,Default,,0,0,0,,Өте жаман.
Dialogue: 0,0:05:37.75,0:05:39.92,Default,,0,0,0,,Өтірік айтпа, бұл қауіпсіз.
Dialogue: 0,0:05:40.00,0:05:41.71,Default,,0,0,0,,Шуго жаман
Dialogue: 0,0:05:41.79,0:05:45.42,Default,,0,0,0,,Мен негізгі жүгіруде өте нашармын, өйткені мен үйге жүгіруге үйреніп қалдым.
Dialogue: 0,0:05:45.51,0:05:48.05,Default,,0,0,0,,Бұл қабылданбаған хит болды.
Dialogue: 0,0:05:48.13,0:05:50.18,Default,,0,0,0,,Мен ешқашан мені тоқтатады деп ойламадым...
Dialogue: 0,0:05:50.26,0:05:53.43,Default,,0,0,0,,Өйткені, тек ханшайымдарға арналған әңгіме бар.
Dialogue: 0,0:05:53.51,0:05:56.27,Default,,0,0,0,,Оны жесең, оның дәмді екеніне таң қаласың...
Dialogue: 0,0:05:56.77,0:05:57.81,Default,,0,0,0,,Нагакура
Dialogue: 0,0:05:57.89,0:05:58.98,Default,,0,0,0,,Иә
Dialogue: 0,0:05:59.06,0:06:01.73,Default,,0,0,0,,Көктемге дейін Харада дәмін жоғалтпа
Dialogue: 0,0:06:01.81,0:06:04.90,Default,,0,0,0,,Оны ең жақсы етіп жасаңыз.
Dialogue: 0,0:06:05.40,0:06:08.95,Default,,0,0,0,,Бұл жолы мен төбеге еңкейіп жылаймын.
Dialogue: 0,0:06:09.03,0:06:10.78,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:06:10.87,0:06:12.33,Default,,0,0,0,,Менің ойымша, бұл мүмкін емес
Dialogue: 0,0:06:12.41,0:06:13.49,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:14.24,0:06:15.54,Default,,0,0,0,,Такумиді ұсақтайық
Dialogue: 0,0:06:16.45,0:06:18.08,Default,,0,0,0,,Үйіндіге еңкейіп отыру
Dialogue: 0,0:06:18.83,0:06:20.58,Default,,0,0,0,,Менің ойымша, мұны ешкім жасай алмайды.
Dialogue: 0,0:06:22.42,0:06:27.01,Default,,0,0,0,,Мүлдем... Сіз Шугодан да ауыр науқассыз.
Dialogue: 0,0:06:27.09,0:06:30.84,Default,,0,0,0,,Ал, иә, дайын бол.
Dialogue: 0,0:06:33.30,0:06:35.60,Default,,0,0,0,,Эй, мен оны дұрыс лақтырдым, солай ма?
Dialogue: 0,0:06:35.68,0:06:36.60,Default,,0,0,0,,О
Dialogue: 0,0:06:40.02,0:06:41.73,Default,,0,0,0,,Иә, бұл доп болды.
Dialogue: 0,0:06:43.86,0:06:44.73,Default,,0,0,0,,Иә
Dialogue: 0,0:06:49.20,0:06:50.11,Default,,0,0,0,,Такуми
Dialogue: 0,0:06:50.20,0:06:51.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:52.66,0:06:54.03,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:07:14.43,0:07:15.97,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:07:27.94,0:07:29.49,Default,,0,0,0,,- (Қария) Қайырлы таң - (Такуми) Иә.
Dialogue: 0,0:07:29.57,0:07:31.53,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:07:33.07,0:07:34.87,Default,,0,0,0,,Қар
Dialogue: 0,0:07:34.95,0:07:37.49,Default,,0,0,0,,Сен биыл ерте келдің.
Dialogue: 0,0:07:52.84,0:07:54.22,Default,,0,0,0,,Өйткені, Хараданы ұстаушы
Dialogue: 0,0:07:54.30,0:07:55.72,Default,,0,0,0,,Бұл Австралия емес.
Dialogue: 0,0:07:55.80,0:07:56.76,Default,,0,0,0,,Бұл өте жақсы болды
Dialogue: 0,0:07:56.85,0:08:01.02,Default,,0,0,0,,Сіз күнде бірдей сөздерді айтасыз.
Dialogue: 0,0:08:01.10,0:08:02.56,Default,,0,0,0,,Ұсталу аяқталды.
Dialogue: 0,0:08:02.64,0:08:05.19,Default,,0,0,0,,Менің ойымша, шынымен де солай.
Dialogue: 0,0:08:05.27,0:08:06.65,Default,,0,0,0,,Сәлем Хигаши
Dialogue: 0,0:08:06.73,0:08:08.52,Default,,0,0,0,,Дәл Сава айтқандай.
Dialogue: 0,0:08:08.61,0:08:10.57,Default,,0,0,0,,Бір кезде мен не болар екен деп ойладым.
Dialogue: 0,0:08:10.65,0:08:12.65,Default,,0,0,0,,Австралиядан күткендей.
Dialogue: 0,0:08:12.74,0:08:15.57,Default,,0,0,0,,Сіз не істеп жатқаныңызды білесіз.
Dialogue: 0,0:08:15.66,0:08:18.41,Default,,0,0,0,,Нитта Хигашидің батареясы қайта іске қосылады
Dialogue: 0,0:08:18.49,0:08:19.66,Default,,0,0,0,,Барымызды салайық
Dialogue: 0,0:08:19.74,0:08:23.79,Default,,0,0,0,,К-Савагучи мен Хигашитани, батарея туралы алаңдамас бұрын.
Dialogue: 0,0:08:23.87,0:08:27.00,Default,,0,0,0,,Тұрақты орынға ие бола аласыз ба деп уайымдамаңыз.
Dialogue: 0,0:08:27.08,0:08:29.88,Default,,0,0,0,,Мен үшінші командада әдеттегідей жаттығу жасамаймын.
Dialogue: 0,0:08:29.96,0:08:31.01,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:08:31.09,0:08:34.05,Default,,0,0,0,,Кімнің тұрақты екенін шешпеңіз.
Dialogue: 0,0:08:34.13,0:08:36.80,Default,,0,0,0,,Сен ақымақсың ба? үшін солай айтады.
Dialogue: 0,0:08:36.89,0:08:38.55,Default,,0,0,0,,Данышпан Йошисада-кунды артта қалдыру
Dialogue: 0,0:08:38.64,0:08:40.72,Default,,0,0,0,,Үшінші бола алатын ешкім жоқ.
Dialogue: 0,0:08:40.81,0:08:42.60,Default,,0,0,0,,Оны ешкім айта алмайды.
Dialogue: 0,0:08:42.68,0:08:44.60,Default,,0,0,0,,Хм
Dialogue: 0,0:08:49.57,0:08:52.44,Default,,0,0,0,,Мен тым қартайдым.
Dialogue: 0,0:08:52.53,0:08:55.86,Default,,0,0,0,,Мұндай жолдарды 20 жастан кейін ғана айта аласыз.
Dialogue: 0,0:08:55.95,0:08:58.57,Default,,0,0,0,,Сонда келесі жаз 3-ші жыл болады.
Dialogue: 0,0:08:58.66,0:08:59.87,Default,,0,0,0,,Біз зейнетке шығуымыз керек.
Dialogue: 0,0:08:59.95,0:09:02.45,Default,,0,0,0,,Сіз қабылдау емтиханына қатыса алмайсыз.
Dialogue: 0,0:09:02.54,0:09:06.46,Default,,0,0,0,,Маған ұнамайды. Мен бейсбол ойнағым келеді.
Dialogue: 0,0:09:08.54,0:09:11.25,Default,,0,0,0,,Сіз орта мектепте оқысаңыз да, мұны істеу керек.
Dialogue: 0,0:09:11.34,0:09:13.34,Default,,0,0,0,,Онда қазір қызық, солай ма?
Dialogue: 0,0:09:13.42,0:09:15.93,Default,,0,0,0,,- (Савагучи) Көз... - (Такуми) Савагучидің денесі тым қатты.
Dialogue: 0,0:09:16.01,0:09:17.97,Default,,0,0,0,,- (Такуми) Қараңдар, аяғыңды ашыңдар - (Савагучи) Итте, бұл ите~
Dialogue: 0,0:09:18.05,0:09:19.35,Default,,0,0,0,,Такуми
Dialogue: 0,0:09:21.22,0:09:23.68,Default,,0,0,0,,Капитан шақырады, кеттік.
Dialogue: 0,0:09:27.31,0:09:30.48,Default,,0,0,0,,Әй, біраз болды.
Dialogue: 0,0:09:30.57,0:09:33.40,Default,,0,0,0,,Кайондзи-сан, емтихан аяқталды.
Dialogue: 0,0:09:33.48,0:09:34.86,Default,,0,0,0,,Соңында
Dialogue: 0,0:09:34.94,0:09:36.49,Default,,0,0,0,,Сонымен Нономура
Dialogue: 0,0:09:36.57,0:09:38.78,Default,,0,0,0,,Бұл екеуі жақсы ма?
Dialogue: 0,0:09:38.86,0:09:39.99,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:40.07,0:09:43.37,Default,,0,0,0,,Олай болса мен сендерге келесі жаттығуды тапсырамын.
Dialogue: 0,0:09:43.95,0:09:44.83,Default,,0,0,0,,Полковник!
Dialogue: 0,0:09:44.91,0:09:45.41,Default,,0,0,0,,Ол капитанға ұқсайды.
Dialogue: 0,0:09:45.41,0:09:47.12,Default,,0,0,0,,Ол капитанға ұқсайды.
Dialogue: 0,0:09:45.41,0:09:47.12,Default,,0,0,0,,Иә
Dialogue: 0,0:09:47.21,0:09:48.96,Default,,0,0,0,,Ол өте білікті болды.
Dialogue: 0,0:09:49.04,0:09:49.92,Default,,0,0,0,,Иә
Dialogue: 0,0:09:50.54,0:09:53.63,Default,,0,0,0,,Наурыздың соңғы жексенбісі, оны жай қалдырыңыз.
Dialogue: 0,0:09:53.71,0:09:55.67,Default,,0,0,0,,Кайондзи-сан, бұл...
Dialogue: 0,0:09:55.76,0:09:58.26,Default,,0,0,0,,Иә, Йокотеге қарсы матч.
Dialogue: 0,0:09:58.76,0:10:00.39,Default,,0,0,0,,Біз бітірдік, бірақ
Dialogue: 0,0:10:00.47,0:10:03.10,Default,,0,0,0,,Біз алдыңғы ойындағыдай мүшелермен барамыз.
Dialogue: 0,0:10:04.22,0:10:06.39,Default,,0,0,0,,Жарайсыңдар, балалар.
Dialogue: 0,0:10:07.02,0:10:09.90,Default,,0,0,0,,Ол ешқашан өткен жолғыдай құламайды.
Dialogue: 0,0:10:10.56,0:10:12.11,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:10:12.90,0:10:15.44,Default,,0,0,0,,Балалар, сендер ешқашан қашпайсыңдар.
Dialogue: 0,0:10:16.53,0:10:18.86,Default,,0,0,0,,Жаттығу кезінде кедергі жасағаным үшін кешіріңіз.
Dialogue: 0,0:10:19.45,0:10:20.62,Default,,0,0,0,,Кайонжи храмы
Dialogue: 0,0:10:20.70,0:10:21.62,Default,,0,0,0,,Иә
Dialogue: 0,0:10:21.70,0:10:24.12,Default,,0,0,0,,Қамырға арналған қорапқа кіріңіз.
Dialogue: 0,0:10:24.20,0:10:25.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:25.75,0:10:27.50,Default,,0,0,0,,Мен осы жолмен келмеуім керек еді.
Dialogue: 0,0:10:27.58,0:10:30.96,Default,,0,0,0,,Мен соққыға жығылған сезімді басынан өткергеніме көп болды.
Dialogue: 0,0:10:31.04,0:10:34.80,Default,,0,0,0,,Бірақ мен көптен бері шындап жаттығу жасамадым...
Dialogue: 0,0:10:34.88,0:10:36.30,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:10:36.38,0:10:39.22,Default,,0,0,0,,Менің ойымша, мен мұны міндетті түрде орындадым.
Dialogue: 0,0:10:39.30,0:10:40.13,Default,,0,0,0,,Иә
Dialogue: 0,0:10:40.22,0:10:42.80,Default,,0,0,0,,Мен тірі допты соғамын
Dialogue: 0,0:10:42.89,0:10:44.31,Default,,0,0,0,,Мен оянамын
Dialogue: 0,0:10:51.06,0:10:52.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:52.19,0:10:53.23,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:10:57.07,0:10:58.36,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:11:00.07,0:11:01.11,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:11:04.16,0:11:04.99,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:11:10.29,0:11:13.75,Default,,0,0,0,,Нагакура Иә, дайындық аяқталды.
Dialogue: 0,0:11:13.83,0:11:16.34,Default,,0,0,0,,Кайондзи мырза, кеттік.
Dialogue: 0,0:11:26.10,0:11:27.01,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:11:30.94,0:11:31.89,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:11:34.19,0:11:37.78,Default,,0,0,0,,Оны әдейі алып тастайды деп ойламаймын.
Dialogue: 0,0:11:40.36,0:11:42.70,Default,,0,0,0,,Онда неге кірмейсің?
Dialogue: 0,0:11:42.78,0:11:44.70,Default,,0,0,0,,Сіз дұрыс дайындалдыңыз ба?
Dialogue: 0,0:11:57.29,0:11:58.30,Default,,0,0,0,,Такуми…
Dialogue: 0,0:12:07.22,0:12:08.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:12.60,0:12:15.02,Default,,0,0,0,,(Жер қозғалысының дыбысы)
Dialogue: 0,0:12:17.90,0:12:19.53,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:22.11,0:12:23.15,Default,,0,0,0,,Нономура
Dialogue: 0,0:12:23.24,0:12:25.41,Default,,0,0,0,,Мен оны Харадаға лақтыру үшін қиындық көрдім.
Dialogue: 0,0:12:25.49,0:12:27.32,Default,,0,0,0,,Барлық тұрақтылар соқсын
Dialogue: 0,0:12:27.41,0:12:28.33,Default,,0,0,0,,Иә
Dialogue: 0,0:12:29.12,0:12:30.16,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:12:30.24,0:12:31.62,Default,,0,0,0,,Жарық!
Dialogue: 0,0:12:33.04,0:12:35.75,Default,,0,0,0,,Директор: Бұл не?
Dialogue: 0,0:12:35.83,0:12:37.96,Default,,0,0,0,,Харада? Нагакура?
Dialogue: 0,0:12:38.04,0:12:39.25,Default,,0,0,0,,Екеуі де.
Dialogue: 0,0:12:39.75,0:12:41.76,Default,,0,0,0,,Осылайша Харада шатастырды...
Dialogue: 0,0:12:42.51,0:12:44.80,Default,,0,0,0,,Мүмкін сіз солай ойлайтын шығарсыз.
Dialogue: 0,0:12:44.88,0:12:47.60,Default,,0,0,0,,Мен төбемнен тұрғанда үнсіз қалдым.
Dialogue: 0,0:12:47.68,0:12:50.06,Default,,0,0,0,,Бұл жігітті түсіну оңай.
Dialogue: 0,0:12:50.14,0:12:52.18,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:52.27,0:12:54.77,Default,,0,0,0,,Өте жақсы бақылауға ие болған.
Dialogue: 0,0:12:54.85,0:12:57.06,Default,,0,0,0,,Неліктен ереуіл жоқ?
Dialogue: 0,0:12:57.15,0:12:57.98,Default,,0,0,0,,Және...
Dialogue: 0,0:12:58.06,0:13:00.90,Default,,0,0,0,,Мен ереуіл ақыры келді деп ойладым.
Dialogue: 0,0:13:00.98,0:13:03.07,Default,,0,0,0,,Бұл өте күшті болды.
Dialogue: 0,0:13:03.15,0:13:06.32,Default,,0,0,0,,Допты бұлай ешкім оңай соға алмас еді.
Dialogue: 0,0:13:07.66,0:13:09.74,Default,,0,0,0,,Жалпы айтқанда, Нагакура да біртүрлі.
Dialogue: 0,0:13:09.83,0:13:13.58,Default,,0,0,0,,Ереуіл алмаса, әдетте қорғанға барасың.
Dialogue: 0,0:13:13.66,0:13:17.08,Default,,0,0,0,,Негізі мен Нономурамен сөйлестім.
Dialogue: 0,0:13:17.17,0:13:20.42,Default,,0,0,0,,Сен келгенде, мен сенің жарғанатқа тұруыңды қалаймын.
Dialogue: 0,0:13:20.50,0:13:24.51,Default,,0,0,0,,Мен бұл батареяның шынымен жұмыс істейтінін анықтауға тырысамын.
Dialogue: 0,0:13:24.59,0:13:26.51,Default,,0,0,0,,Онда ол енді
Dialogue: 0,0:13:26.59,0:13:28.93,Default,,0,0,0,,Мен Нагакураның адасып кеткенін білемін.
Dialogue: 0,0:13:29.01,0:13:29.85,Default,,0,0,0,,Иә
Dialogue: 0,0:13:29.93,0:13:31.93,Default,,0,0,0,,Қорытынды емтихан аяқталғаннан кейін...
Dialogue: 0,0:13:32.01,0:13:33.77,Default,,0,0,0,,Күндізгі үйірме жұмыстары басталды
Dialogue: 0,0:13:33.85,0:13:35.60,Default,,0,0,0,,Ол қолғаптарын дұрыс киіп алды.
Dialogue: 0,0:13:36.56,0:13:39.48,Default,,0,0,0,,Біріншіден, бұл жер.
Dialogue: 0,0:13:39.56,0:13:42.61,Default,,0,0,0,,Дегенмен, бұл жолы біртүрлі болған Харада.
Dialogue: 0,0:13:42.69,0:13:44.86,Default,,0,0,0,,Сіз бұрын солай болғансыз.
Dialogue: 0,0:13:45.36,0:13:48.36,Default,,0,0,0,,Шынымды айтсам, мен де таң қалдым.
Dialogue: 0,0:13:48.45,0:13:52.62,Default,,0,0,0,,Харада өз допын басқара алмайды.
Dialogue: 0,0:13:52.70,0:13:55.20,Default,,0,0,0,,Бұл мүлдем жаман деп айтуға болмайды.
Dialogue: 0,0:13:55.29,0:13:57.41,Default,,0,0,0,,Мен оны жаңа ғана көрдім және шешілді.
Dialogue: 0,0:13:57.50,0:13:58.92,Default,,0,0,0,,Ал мына доп...
Dialogue: 0,0:13:59.00,0:14:02.67,Default,,0,0,0,,Бұл бұрынғыдан әлдеқайда күшті доп.
Dialogue: 0,0:14:02.75,0:14:03.63,Default,,0,0,0,,Иә
Dialogue: 0,0:14:03.71,0:14:06.26,Default,,0,0,0,,Басқаша айтқанда, Нагакура мен Харада
Dialogue: 0,0:14:06.34,0:14:08.63,Default,,0,0,0,,Батарея ретінде бәрі жақсы нәрселер туралы.
Dialogue: 0,0:14:08.72,0:14:10.34,Default,,0,0,0,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:14:10.43,0:14:11.85,Default,,0,0,0,,Бұл болмайды.
Dialogue: 0,0:14:11.93,0:14:13.64,Default,,0,0,0,,Оның себебі неде?
Dialogue: 0,0:14:13.72,0:14:14.89,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:14:14.97,0:14:18.10,Default,,0,0,0,,Жәкең, менде бұрылыс болды, бірақ үнсіз қалдым.
Dialogue: 0,0:14:18.19,0:14:21.77,Default,,0,0,0,,Бұл екеуінің бұрынғыдан айырмашылығы неде?
Dialogue: 0,0:14:21.86,0:14:23.52,Default,,0,0,0,,Өз ойларыңызды айтыңыз
Dialogue: 0,0:14:23.61,0:14:26.90,Default,,0,0,0,,Директор Сіз шынымен қиыншылыққа тап болдыңыз ба?
Dialogue: 0,0:14:26.99,0:14:28.40,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:14:28.49,0:14:32.07,Default,,0,0,0,,Нагакура Қалай болғанда да, Харада, оны қайда қолдануға болады?
Dialogue: 0,0:14:32.16,0:14:35.62,Default,,0,0,0,,Ол тек қорғанда ғана құнды.
Dialogue: 0,0:14:35.70,0:14:37.75,Default,,0,0,0,,Оны қолданбау ұят болар еді.
Dialogue: 0,0:14:41.75,0:14:43.54,Default,,0,0,0,,Харада…
Dialogue: 0,0:14:43.63,0:14:46.67,Default,,0,0,0,,Менің ойымша, сіз өз допыңызды міне алмайсыз.
Dialogue: 0,0:14:46.76,0:14:49.93,Default,,0,0,0,,Хараданың өзі жақсы болғандықтан, оны басқара алмайды.
Dialogue: 0,0:14:50.01,0:14:52.14,Default,,0,0,0,,Доптың күші кенет артты.
Dialogue: 0,0:14:52.22,0:14:53.85,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:14:53.93,0:14:55.26,Default,,0,0,0,,Бұл болжам.
Dialogue: 0,0:14:55.76,0:14:59.18,Default,,0,0,0,,Кайондзи, сен үлкен іссің.
Dialogue: 0,0:14:59.27,0:15:01.52,Default,,0,0,0,,Мен жай ғана жарғанақта тұрдым.
Dialogue: 0,0:15:02.06,0:15:04.94,Default,,0,0,0,,Нағыз үлкен мәміле сонда, солай емес пе?
Dialogue: 0,0:15:05.52,0:15:08.44,Default,,0,0,0,,Ол Хараданың добын жұлып алған, солай ма?
Dialogue: 0,0:15:09.32,0:15:11.41,Default,,0,0,0,,Себебі Нагакура ұстағыш.
Dialogue: 0,0:15:11.49,0:15:13.53,Default,,0,0,0,,Харада бар күшімен ойнай алады.
Dialogue: 0,0:15:23.46,0:15:25.63,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:15:31.59,0:15:32.84,Default,,0,0,0,,Кадоваки
Dialogue: 0,0:15:34.18,0:15:36.51,Default,,0,0,0,,Йо Кайонжи көптен бері көрмегелі
Dialogue: 0,0:15:36.60,0:15:38.27,Default,,0,0,0,,Мен мұны бұрын да айтқанмын.
Dialogue: 0,0:15:38.35,0:15:41.77,Default,,0,0,0,,Мойынға орамал салма, тоқтат, қариясың.
Dialogue: 0,0:15:41.85,0:15:44.56,Default,,0,0,0,,Мені жалғыз қалдырыңдар, балалар бірге.
Dialogue: 0,0:15:44.65,0:15:47.32,Default,,0,0,0,,Кайондзи кездесуге бару туралы шулы болып көрінеді.
Dialogue: 0,0:15:47.40,0:15:49.07,Default,,0,0,0,,Мен түскі асты жедім.
Dialogue: 0,0:15:49.15,0:15:51.95,Default,,0,0,0,,Маған да телефон соқсаңыз екен.
Dialogue: 0,0:15:52.03,0:15:54.53,Default,,0,0,0,,Кенет электрондық пошта арқылы шақырылды
Dialogue: 0,0:15:54.62,0:15:55.78,Default,,0,0,0,,Хитона
Dialogue: 0,0:15:55.87,0:15:59.29,Default,,0,0,0,,Шуго ня, мен саған тым әсерлі оқиға айттым.
Dialogue: 0,0:15:59.87,0:16:02.54,Default,,0,0,0,,Ынталандырушы әңгіме дегеніміз не?
Dialogue: 0,0:16:02.62,0:16:04.71,Default,,0,0,0,,Шуго тыңдамағаны жөн.
Dialogue: 0,0:16:04.79,0:16:08.09,Default,,0,0,0,,Қызғаныш жүрек талмасына әкелуі мүмкін.
Dialogue: 0,0:16:08.17,0:16:12.05,Default,,0,0,0,,Білесіз бе... сәл байыпты сөйлесе аламыз ба?
Dialogue: 0,0:16:12.63,0:16:15.51,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші рет жарғанатқа тұрдым.
Dialogue: 0,0:16:15.59,0:16:18.14,Default,,0,0,0,,Жай ғана Хараданың добын соққаныңызды айтыңыз.
Dialogue: 0,0:16:19.14,0:16:22.06,Default,,0,0,0,,Ереуіл жоқ.
Dialogue: 0,0:16:22.14,0:16:24.40,Default,,0,0,0,,Ереуіл болмайды деп кім айтады?
Dialogue: 0,0:16:24.48,0:16:26.81,Default,,0,0,0,,Біз қазір кім туралы айтып отырмыз?
Dialogue: 0,0:16:26.90,0:16:29.61,Default,,0,0,0,,Сенің ханшайымың екеніне сенімдімін.
Dialogue: 0,0:16:29.69,0:16:31.07,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:32.49,0:16:34.82,Default,,0,0,0,,Бірақ мені бірдеңе салқындатып жіберді.
Dialogue: 0,0:16:35.53,0:16:38.03,Default,,0,0,0,,Мен Кадовакиде үлкенді ұра алмаймын, бірақ
Dialogue: 0,0:16:38.12,0:16:40.54,Default,,0,0,0,,Сенімді түрде болжауға болады.
Dialogue: 0,0:16:40.62,0:16:43.33,Default,,0,0,0,,Мен жарғанақты қысқа ұстап, соқтым.
Dialogue: 0,0:16:43.41,0:16:45.42,Default,,0,0,0,,...Тіпті сызат болған жоқ па?
Dialogue: 0,0:16:45.50,0:16:49.09,Default,,0,0,0,,Қанша тырыссам да, бұл мен соғатын доп емес.
Dialogue: 0,0:16:49.17,0:16:51.59,Default,,0,0,0,,Бірақ мен қатты өкінемін
Dialogue: 0,0:16:51.67,0:16:54.09,Default,,0,0,0,,Неліктен сіз тіпті болжай алмайсыз?
Dialogue: 0,0:16:54.17,0:16:56.80,Default,,0,0,0,,Мен біреудің шағымымды тыңдауын қаладым.
Dialogue: 0,0:16:56.89,0:16:57.72,Default,,0,0,0,,Иә
Dialogue: 0,0:16:57.80,0:16:59.60,Default,,0,0,0,,Шуго ашуланады
Dialogue: 0,0:16:59.68,0:17:02.68,Default,,0,0,0,,Мына жігіт бізге арыздануға келді.
Dialogue: 0,0:17:02.77,0:17:06.06,Default,,0,0,0,,Менің ойымша, біз бұл көңілсіз сезімді түсіне аламыз.
Dialogue: 0,0:17:06.15,0:17:08.36,Default,,0,0,0,,Қандай ұят.
Dialogue: 0,0:17:08.44,0:17:09.57,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:09.65,0:17:12.48,Default,,0,0,0,,Харада да, Нагакура да мұны керемет деп ойлады.
Dialogue: 0,0:17:12.57,0:17:14.61,Default,,0,0,0,,Бұл жігіттер анық көрінетіндей әрекет етеді.
Dialogue: 0,0:17:14.70,0:17:15.86,Default,,0,0,0,,Мен оны лақтырып, ұстап алдым.
Dialogue: 0,0:17:16.61,0:17:19.37,Default,,0,0,0,,Бұл менмін. Сол кезде мен оған жалт қарадым.
Dialogue: 0,0:17:19.45,0:17:22.87,Default,,0,0,0,,Мен бұл екеуін жек көремін бе... Мен олай сезінбеймін...
Dialogue: 0,0:17:30.75,0:17:32.67,Default,,0,0,0,,Жасың нешеде?
Dialogue: 0,0:17:32.76,0:17:35.51,Default,,0,0,0,,Қазір 15-16 жаста өзіңді жек көресің бе?
Dialogue: 0,0:17:35.59,0:17:37.63,Default,,0,0,0,,Жастық шақ дегенді қалай түсінесіңдер?
Dialogue: 0,0:17:37.72,0:17:41.39,Default,,0,0,0,,Шуго екеуің де ақымақсыңдар, керемет!
Dialogue: 0,0:17:42.97,0:17:44.43,Default,,0,0,0,,Бұлай айту тым көп.
Dialogue: 0,0:17:44.52,0:17:47.10,Default,,0,0,0,,Айтпасам түсінбейсің, тентек.
Dialogue: 0,0:17:48.10,0:17:50.02,Default,,0,0,0,,Хехе, әрқашан солай.
Dialogue: 0,0:17:50.11,0:17:52.40,Default,,0,0,0,,Бұл сізге сергітетін спортшы келбетін береді.
Dialogue: 0,0:17:52.48,0:17:54.78,Default,,0,0,0,,Мені ханшайым ерсітіп жатыр.
Dialogue: 0,0:17:55.36,0:17:58.03,Default,,0,0,0,,Екеуің де өтірікші сияқтысыңдар.
Dialogue: 0,0:17:58.11,0:18:00.82,Default,,0,0,0,,Химе-сан өте зұлым әйел.
Dialogue: 0,0:18:00.91,0:18:02.79,Default,,0,0,0,,Сені жек көру жақсы емес пе?
Dialogue: 0,0:18:03.37,0:18:07.04,Default,,0,0,0,,Шуго түсінде бәрін өлтіріп жатқан жоқ па?
Dialogue: 0,0:18:07.12,0:18:08.75,Default,,0,0,0,,Мен сені өлтірмеймін
Dialogue: 0,0:18:08.83,0:18:10.25,Default,,0,0,0,,Сонымен, ұрып-соғып қалдың ба?
Dialogue: 0,0:18:10.33,0:18:13.30,Default,,0,0,0,,Әлде бұл сексуалды арман ба?
Dialogue: 0,0:18:13.38,0:18:14.84,Default,,0,0,0,,- (Кадоваки) Қаш! -(Кайондзи) Аа.
Dialogue: 0,0:18:18.59,0:18:20.76,Default,,0,0,0,,Қалағаныңызды қалдырмаңыз.
Dialogue: 0,0:18:20.84,0:18:23.51,Default,,0,0,0,,Сіз ашулысыз ба? Мүмкін бинго?
Dialogue: 0,0:18:23.60,0:18:25.52,Default,,0,0,0,,Мен саған бұлай ғашық бола алмас едім.
Dialogue: 0,0:18:25.60,0:18:28.52,Default,,0,0,0,,Сен... мені мазақ етейін деп жатырсың ба?
Dialogue: 0,0:18:29.48,0:18:31.65,Default,,0,0,0,,Саған қарасам тітіркенемін.
Dialogue: 0,0:18:32.27,0:18:35.61,Default,,0,0,0,,Ей, Шуго, шыныңды айт.
Dialogue: 0,0:18:35.69,0:18:37.40,Default,,0,0,0,,Сіз армандайсыз ба?
Dialogue: 0,0:18:37.49,0:18:39.66,Default,,0,0,0,,Сіз тіпті түсіңізде соққы жасадыңыз ба?
Dialogue: 0,0:18:39.74,0:18:41.91,Default,,0,0,0,,Ханшайым шынымен де қорқынышты ма?
Dialogue: 0,0:18:41.91,0:18:42.74,Default,,0,0,0,,Ханшайым шынымен де қорқынышты ма?
Dialogue: 0,0:18:41.91,0:18:42.74,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:18:44.24,0:18:45.37,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:18:46.95,0:18:48.37,Default,,0,0,0,,Кадовакиді тоқтатыңыз
Dialogue: 0,0:18:49.08,0:18:50.25,Default,,0,0,0,,(Түкіру дыбысы)
Dialogue: 0,0:18:50.33,0:18:53.21,Default,,0,0,0,,Бұл зорлық-зомбылық, Шуго.
Dialogue: 0,0:18:53.29,0:18:54.67,Default,,0,0,0,,Йокотедегі Кадоваки
Dialogue: 0,0:18:54.75,0:18:58.72,Default,,0,0,0,,Әріптесті біржақты жазалап, жарақаттады
Dialogue: 0,0:18:58.80,0:19:01.39,Default,,0,0,0,,Ұсыныс Ябонарудан айырмашылығы бар ма?
Dialogue: 0,0:19:01.47,0:19:02.72,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:02.80,0:19:04.68,Default,,0,0,0,,Неліктен төбелесті таңдау үшін өз жолыңыздан шығасыз?
Dialogue: 0,0:19:04.76,0:19:06.39,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:19:06.47,0:19:07.98,Default,,0,0,0,,Бөлек
Dialogue: 0,0:19:08.06,0:19:12.27,Default,,0,0,0,,Тек сен мені қорғауға тырысып жатырсың.
Dialogue: 0,0:19:12.35,0:19:14.11,Default,,0,0,0,,Бір ұрыс пааға айналады дейді.
Dialogue: 0,0:19:14.19,0:19:16.40,Default,,0,0,0,,Мен сізге айтайын деп ойладым.
Dialogue: 0,0:19:16.98,0:19:20.74,Default,,0,0,0,,Мәртебелі мектепте оқып, Қошиенде белсенді рөл атқарды...
Dialogue: 0,0:19:20.82,0:19:22.20,Default,,0,0,0,,Мұндай нәрсе үшін сіз
Dialogue: 0,0:19:22.28,0:19:24.45,Default,,0,0,0,,Сіз бейсбол ойнауға сонша тырысып жатырсыз ба, ақымақ?
Dialogue: 0,0:19:24.53,0:19:26.33,Default,,0,0,0,,Мұны кім айтты!
Dialogue: 0,0:19:26.41,0:19:28.58,Default,,0,0,0,,Мен сіздің айтқаныңызды түсіндім.
Dialogue: 0,0:19:28.66,0:19:32.12,Default,,0,0,0,,Ханшайымнан жеңіліп қалудан қорқасың ба?
Dialogue: 0,0:19:32.83,0:19:35.09,Default,,0,0,0,,Жеңілсең, сенімің артады
Dialogue: 0,0:19:35.17,0:19:37.13,Default,,0,0,0,,Сен одан қорқасың.
Dialogue: 0,0:19:39.76,0:19:42.38,Default,,0,0,0,,Түсінгендей сөйлейсің...
Dialogue: 0,0:19:43.14,0:19:46.18,Default,,0,0,0,,Ханшайымды жеңе алмайсың.
Dialogue: 0,0:19:46.26,0:19:48.39,Default,,0,0,0,,Қуат айырмашылығы жоқ
Dialogue: 0,0:19:48.47,0:19:51.02,Default,,0,0,0,,Ханшайым әлі белгісіз.
Dialogue: 0,0:19:51.10,0:19:54.02,Default,,0,0,0,,Күтудің немесе шу шығарудың қажеті жоқ
Dialogue: 0,0:19:54.73,0:19:57.40,Default,,0,0,0,,Арқаңызда тым көп зат алып жүрмеңіз.
Dialogue: 0,0:19:57.48,0:19:59.90,Default,,0,0,0,,Бұл жай бейсбол емес пе?
Dialogue: 0,0:19:59.99,0:20:03.36,Default,,0,0,0,,Сол кезде ойнағанды ​​ұнататын болсаңыз, иә.
Dialogue: 0,0:20:03.45,0:20:05.16,Default,,0,0,0,,Мұның бәрі бар.
Dialogue: 0,0:20:05.24,0:20:06.91,Default,,0,0,0,,Тоқта, Кадоваки!
Dialogue: 0,0:20:06.99,0:20:08.16,Default,,0,0,0,,(Мидзугаки мен Кадоваки құлаған дыбыс)
Dialogue: 0,0:20:08.83,0:20:11.16,Default,,0,0,0,,Ақымақ болып көрінсеңіз де, керемет ойнаңыз.
Dialogue: 0,0:20:11.25,0:20:15.42,Default,,0,0,0,,Кадоваки-кун ешқашан жеңілмеген лайықты адам.
Dialogue: 0,0:20:15.50,0:20:17.38,Default,,0,0,0,,Сіз ауырып тұрсыз.
Dialogue: 0,0:20:30.81,0:20:31.93,Default,,0,0,0,,Шуго
Dialogue: 0,0:20:32.52,0:20:35.65,Default,,0,0,0,,Мизугаки Енді сөйлеме.
Dialogue: 0,0:20:35.73,0:20:37.40,Default,,0,0,0,,Кадоваки, тезірек үйге қайтыңыз.
Dialogue: 0,0:20:37.48,0:20:38.98,Default,,0,0,0,,Догеза Сея
Dialogue: 0,0:20:42.99,0:20:46.53,Default,,0,0,0,,Егер сіз зорлық-зомбылық немесе жарақат туралы шу шығарғыңыз келмесе
Dialogue: 0,0:20:47.03,0:20:49.28,Default,,0,0,0,,Екі қолмен кешірім сұрау
Dialogue: 0,0:20:49.79,0:20:50.62,Default,,0,0,0,,Мизугаки!
Dialogue: 0,0:20:50.70,0:20:52.08,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:20:52.16,0:20:55.21,Default,,0,0,0,,Мен сені жерге тізе бүктіргім келді.
Dialogue: 0,0:20:55.29,0:20:57.96,Default,,0,0,0,,Мен әрқашан солай ойлайтынмын.
Dialogue: 0,0:20:58.04,0:21:01.46,Default,,0,0,0,,Сіз мұны байқамай да қалдыңыз.
Dialogue: 0,0:21:05.18,0:21:08.10,Default,,0,0,0,,Шуго, тағы бір сөз.
Dialogue: 0,0:21:08.18,0:21:10.60,Default,,0,0,0,,Сіз ханшайымға шын ғашықсыз ба?
Dialogue: 0,0:21:11.18,0:21:13.85,Default,,0,0,0,,Егер сен ханшайым болсаң, оны арқаңа көтеріп жүру керек.
Dialogue: 0,0:21:13.93,0:21:17.06,Default,,0,0,0,,Әркім осылай ойлайды деп жұлып алады.
Dialogue: 0,0:21:26.03,0:21:31.03,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.91,0:22:55.91,Default,,0,0,0,,～♪
