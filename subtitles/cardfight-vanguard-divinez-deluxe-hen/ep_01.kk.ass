Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.21,0:00:21.18,Default,,0,0,0,,Енді жауабыңызды тыңдауға рұқсат етіңіз.
Dialogue: 0,0:00:21.18,0:00:23.19,Default,,0,0,0,,Жасөспірім.
Dialogue: 0,0:00:47.24,0:00:49.21,Default,,0,0,0,,Авангард - бұл...!
Dialogue: 0,0:02:33.18,0:02:35.68,Default,,0,0,0,,Міне, осында.
Dialogue: 0,0:02:35.68,0:02:38.15,Default,,0,0,0,,Жауынгерлермен➡
Dialogue: 0,0:02:38.15,0:02:40.16,Default,,0,0,0,,Қайта ұрысуға болады.
Dialogue: 0,0:02:42.19,0:02:45.16,Default,,0,0,0,,Сондықтан мен қайтып келдім.
Dialogue: 0,0:03:03.71,0:03:07.18,Default,,0,0,0,,Фантомдық майдан жауынгері Кагецу Якумо.
Dialogue: 0,0:03:07.18,0:03:09.22,Default,,0,0,0,,Сізге де үміт артамыз➡
Dialogue: 0,0:03:09.22,0:03:12.19,Default,,0,0,0,,3-ші люкске қатысуыңызды қалаймын.
Dialogue: 0,0:03:20.66,0:03:23.23,Default,,0,0,0,,Бізде Vanguard Cafe➡ жұмыс істейді
Dialogue: 0,0:03:23.23,0:03:25.67,Default,,0,0,0,,Бұл карта ұрыстарынан ләззат алатын кафе~➡
Dialogue: 0,0:03:25.67,0:03:27.70,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:03:27.70,0:03:31.17,Default,,0,0,0,,Барлығыңызға, бүгін келгендеріңізге рахмет➡
Dialogue: 0,0:03:31.17,0:03:33.68,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:03:33.68,0:03:35.64,Default,,0,0,0,,A... басталды!
Dialogue: 0,0:03:36.68,0:03:40.18,Default,,0,0,0,,Әрине шықтым ба? ➡
Dialogue: 0,0:03:40.18,0:03:42.68,Default,,0,0,0,,Ән айту және би билеу...жоқ!
Dialogue: 0,0:03:42.68,0:03:45.15,Default,,0,0,0,,E~? Дәл қазір➡
Dialogue: 0,0:03:45.15,0:03:47.66,Default,,0,0,0,,Шағын тікелей эфир кешке басталады➡
Dialogue: 0,0:03:47.66,0:03:49.69,Default,,0,0,0,,Барлығыңыз, оны асыға күтіңіздер.
Dialogue: 0,0:03:49.69,0:03:51.69,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:51.69,0:03:54.16,Default,,0,0,0,,Өте сүйкімді Митан!
Dialogue: 0,0:03:54.16,0:03:57.20,Default,,0,0,0,,Менің Митаным!
Dialogue: 0,0:03:57.20,0:04:00.70,Default,,0,0,0,,Ендеше осы бұрыштан бастайық! ➡
Dialogue: 0,0:04:00.70,0:04:03.67,Default,,0,0,0,,Бачибоко авангард кезеңі!
Dialogue: 0,0:04:04.67,0:04:06.68,Default,,0,0,0,,Ендеше бастайық➡
Dialogue: 0,0:04:06.68,0:04:09.68,Default,,0,0,0,,Арнайы қонақ шақырайық! ➡
Dialogue: 0,0:04:09.68,0:04:12.68,Default,,0,0,0,,Кагадан шыққан кәсіби жауынгер➡
Dialogue: 0,0:04:12.68,0:04:15.22,Default,,0,0,0,,Бұл Кицүнэ Шиба Лейка!
Dialogue: 0,0:04:15.22,0:04:18.69,Default,,0,0,0,,Бұл Leica Kitsuneshiba. Рақмет сізге.
Dialogue: 0,0:04:18.69,0:04:21.66,Default,,0,0,0,,Менімен бірге сахнада Кицүнэ Шиба-санға➡
Dialogue: 0,0:04:21.66,0:04:24.66,Default,,0,0,0,,Бізде карта ұрысы болады!
Dialogue: 0,0:04:26.19,0:04:30.17,Default,,0,0,0,,Осыдан кейін барлығы картамен төбелеседі.
Dialogue: 0,0:04:30.17,0:04:32.67,Default,,0,0,0,,Бөлінген нөмірленген билеттері барлар➡
Dialogue: 0,0:04:32.67,0:04:34.67,Default,,0,0,0,,Оны асыға күтіңіз.
Dialogue: 0,0:04:35.74,0:04:38.67,Default,,0,0,0,,Менімен де күресуге болады, солай ма?
Dialogue: 0,0:04:38.67,0:04:40.68,Default,,0,0,0,,Барлығы күтеді, жарай ма?
Dialogue: 0,0:04:40.68,0:04:44.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:44.21,0:04:47.68,Default,,0,0,0,,Кент Мен Vanguard ойынын бүгін ғана бастадым.
Dialogue: 0,0:04:47.68,0:04:50.15,Default,,0,0,0,,Кагами - жанкүйер.
Dialogue: 0,0:04:51.15,0:04:53.16,Default,,0,0,0,,Хикари.
Dialogue: 0,0:04:53.16,0:04:56.16,Default,,0,0,0,,Е...? Бұл қандай көрініс➡
Dialogue: 0,0:04:56.16,0:04:59.66,Default,,0,0,0,,Жоқ! Олай айтпа.
Dialogue: 0,0:04:59.66,0:05:02.73,Default,,0,0,0,,Мен менмен болуым мүмкін, бірақ осыдан кейін мен мұны істеймін➡
Dialogue: 0,0:05:02.73,0:05:06.67,Default,,0,0,0,,Кент Такематсу модератор болады.
Dialogue: 0,0:05:06.67,0:05:10.17,Default,,0,0,0,,Олай болса...Соғысайық!
Dialogue: 0,0:05:10.17,0:05:12.14,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:05:17.21,0:05:19.68,Default,,0,0,0,,Менің де тез арада төбелескім келеді.
Dialogue: 0,0:05:26.19,0:05:29.66,Default,,0,0,0,,Күткеніңізге рахмет. Ұрыс….
Dialogue: 0,0:05:29.66,0:05:31.66,Default,,0,0,0,,Аха….
Dialogue: 0,0:05:31.66,0:05:34.16,Default,,0,0,0,,Ұрыс…. Мұны тоқтатамыз ба? ➡
Dialogue: 0,0:05:34.16,0:05:36.67,Default,,0,0,0,,Себебі бұл аздап қорқынышты... Ұрыс....
Dialogue: 0,0:05:36.67,0:05:38.67,Default,,0,0,0,,Куон-кун~. Un?
Dialogue: 0,0:05:38.67,0:05:40.67,Default,,0,0,0,,Мен ойнауға келдім. Ұрыс….
Dialogue: 0,0:05:40.67,0:05:43.67,Default,,0,0,0,,Рахмет, мен дүкен қызметкерлерімен күресе аламын➡
Dialogue: 0,0:05:43.67,0:05:46.17,Default,,0,0,0,,Маған қоңырау шалыңыз. Ұрыс….
Dialogue: 0,0:05:46.17,0:05:48.18,Default,,0,0,0,,A...бұл➡
Dialogue: 0,0:05:48.18,0:05:51.18,Default,,0,0,0,,Сізде де Йоцуги-кун бар ма?
Dialogue: 0,0:05:51.18,0:05:53.18,Default,,0,0,0,,Фа...Мен мұны істей аламын! Апыр-ай!
Dialogue: 0,0:05:53.18,0:05:56.18,Default,,0,0,0,,Қазір орындаңыз. Жарайсың!
Dialogue: 0,0:05:56.18,0:05:58.19,Default,,0,0,0,,Маған ұрысуға рұқсат етіңіз!
Dialogue: 0,0:05:58.19,0:06:00.66,Default,,0,0,0,,Күте тұрыңыз…әлі жоқ➡
Dialogue: 0,0:06:00.66,0:06:02.69,Default,,0,0,0,,Жүрегіңді дайында!
Dialogue: 0,0:06:02.69,0:06:05.66,Default,,0,0,0,,A...күте тұрыңыз! Мен қайта ораламын, Куон-кун!
Dialogue: 0,0:06:05.66,0:06:08.16,Default,,0,0,0,,Ахаха... Тағы кездескенше.
Dialogue: 0,0:06:08.16,0:06:11.17,Default,,0,0,0,,Неге?➡
Dialogue: 0,0:06:11.17,0:06:14.70,Default,,0,0,0,,Орындалды, Куон. Суо құймақтары➡
Dialogue: 0,0:06:14.70,0:06:17.67,Default,,0,0,0,,Тамаша пісірілгені үшін жақсы атаққа ие.
Dialogue: 0,0:06:17.67,0:06:21.68,Default,,0,0,0,,Соңғы кездері мен де тамақ дайындауға қызыға бастадым.
Dialogue: 0,0:06:21.68,0:06:23.68,Default,,0,0,0,,Мен…! ➡
Dialogue: 0,0:06:23.68,0:06:26.18,Default,,0,0,0,,Ум!
Dialogue: 0,0:06:26.18,0:06:28.15,Default,,0,0,0,,Асығыңыз.
Dialogue: 0,0:06:29.68,0:06:32.15,Default,,0,0,0,,Бұл сіз тапсырыс берген құймақ➡
Dialogue: 0,0:06:32.15,0:06:35.16,Default,,0,0,0,,Асыңыздан ләззат алыңыз.
Dialogue: 0,0:06:35.16,0:06:37.69,Default,,0,0,0,,Рахмет. Амал жоқ➡
Dialogue: 0,0:06:37.69,0:06:40.66,Default,,0,0,0,,Джинки мырза келеді деп күтпедім.
Dialogue: 0,0:06:40.66,0:06:43.70,Default,,0,0,0,,Өйткені мен фестивальдерді жақсы көремін!
Dialogue: 0,0:06:43.70,0:06:45.67,Default,,0,0,0,,Және шын мәнінде➡
Dialogue: 0,0:06:45.67,0:06:48.17,Default,,0,0,0,,Балалар, мен сендерге бір нәрсе бергім келеді.
Dialogue: 0,0:06:48.17,0:06:50.67,Default,,0,0,0,,Е...? Un?
Dialogue: 0,0:06:50.67,0:06:53.17,Default,,0,0,0,,Е...бұл➡
Dialogue: 0,0:06:53.17,0:06:55.71,Default,,0,0,0,,Deluxe шақыруы?
Dialogue: 0,0:06:55.71,0:06:59.71,Default,,0,0,0,,Иә, Deluxe – әлемде көпшіліктің назарын аударатын турнир➡
Dialogue: 0,0:06:59.71,0:07:03.69,Default,,0,0,0,,Сол шуақты сахнада қайта тудың➡
Dialogue: 0,0:07:03.69,0:07:05.65,Default,,0,0,0,,Эрика Миоджо есімді жауынгердің аты➡
Dialogue: 0,0:07:05.65,0:07:08.16,Default,,0,0,0,,Оны әлемге басып шығару.
Dialogue: 0,0:07:08.16,0:07:10.69,Default,,0,0,0,,Бірақ бұл шақыру бастапқыда ➡ болды
Dialogue: 0,0:07:10.69,0:07:12.66,Default,,0,0,0,,Тайзо-сан саған берді, солай ма?
Dialogue: 0,0:07:12.66,0:07:15.16,Default,,0,0,0,,Ал, Джинки Мукае➡ кім?
Dialogue: 0,0:07:15.16,0:07:17.17,Default,,0,0,0,,Мен сізге ертегіні айтып бердім.
Dialogue: 0,0:07:17.17,0:07:19.67,Default,,0,0,0,,Неліктен...? Сіз қазір➡
Dialogue: 0,0:07:19.67,0:07:22.67,Default,,0,0,0,,Мен Seizo Anchor Bolt➡ университетінің зерттеушісімін
Dialogue: 0,0:07:22.67,0:07:24.71,Default,,0,0,0,,Маңызды дос ретінде, күрескер ретінде➡
Dialogue: 0,0:07:24.71,0:07:27.68,Default,,0,0,0,,Мен сізге ең жақсы бірінші кезеңді дайындағым келеді➡
Dialogue: 0,0:07:27.68,0:07:29.68,Default,,0,0,0,,Президент ретінде бұл табиғи емес пе?
Dialogue: 0,0:07:30.68,0:07:32.65,Default,,0,0,0,,Тайзо мырза….
Dialogue: 0,0:07:33.68,0:07:35.68,Default,,0,0,0,,Рахмет➡
Dialogue: 0,0:07:35.68,0:07:39.19,Default,,0,0,0,,Мен алған бұл мүмкіндікті ешқашан босқа жібермеймін!
Dialogue: 0,0:07:39.19,0:07:41.16,Default,,0,0,0,,О, қолыңнан келгеннің бәрін істе➡
Dialogue: 0,0:07:41.16,0:07:43.16,Default,,0,0,0,,Мен сені тоқтатқаным өкінішті➡
Dialogue: 0,0:07:43.16,0:07:45.69,Default,,0,0,0,,Сен қазір Акина-кунмен кездесесің бе?
Dialogue: 0,0:07:45.69,0:07:47.70,Default,,0,0,0,,Ум! үлкен аға….
Dialogue: 0,0:07:47.70,0:07:51.20,Default,,0,0,0,,Мен Акина мектебінің мәдени фестиваліне барамын!
Dialogue: 0,0:07:52.70,0:07:54.67,Default,,0,0,0,,Екі адамның қабілеті➡
Dialogue: 0,0:07:54.67,0:07:57.17,Default,,0,0,0,,Мен оны өз көзіммен растадым.
Dialogue: 0,0:07:57.17,0:07:59.74,Default,,0,0,0,,Тағдыр патшасы ретінде Куон-кун сайланды➡
Dialogue: 0,0:07:59.74,0:08:02.18,Default,,0,0,0,,Сіздің қабілетіңіз шынайы➡
Dialogue: 0,0:08:02.18,0:08:04.21,Default,,0,0,0,,Су-кун жақында➡
Dialogue: 0,0:08:04.21,0:08:06.18,Default,,0,0,0,,Түрлі жауынгерлерге қарсы күресуге өтініш➡
Dialogue: 0,0:08:06.18,0:08:09.18,Default,,0,0,0,,Сіз жеңісті ұрлап жатқан сияқтысыз.
Dialogue: 0,0:08:09.18,0:08:12.19,Default,,0,0,0,,Мықты күрескермен жекпе-жек іздесеңіз➡
Dialogue: 0,0:08:12.19,0:08:15.19,Default,,0,0,0,,Менің ойымша, Deluxe ең жақсы орын.
Dialogue: 0,0:08:16.66,0:08:18.69,Default,,0,0,0,,Бүгінгі қонақ➡
Dialogue: 0,0:08:18.69,0:08:22.70,Default,,0,0,0,,Бұл Vanguard Fighter фильміндегі Сузунэ Рокуоин!
Dialogue: 0,0:08:22.70,0:08:25.20,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:08:25.20,0:08:29.20,Default,,0,0,0,,Рокуоин көптеген кәсіби жауынгерлерді шығарды➡
Dialogue: 0,0:08:29.20,0:08:33.17,Default,,0,0,0,,Рокуоиндер отбасының қызы, авангард әлеміндегі әйгілі отбасы➡
Dialogue: 0,0:08:33.17,0:08:35.71,Default,,0,0,0,,Райка Китсунешиба, жас үміт➡
Dialogue: 0,0:08:35.71,0:08:39.68,Default,,0,0,0,,Сенька Дингпен бірге сені Саннова деп атайды.
Dialogue: 0,0:08:40.68,0:08:42.72,Default,,0,0,0,,Кешіріңіз➡
Dialogue: 0,0:08:42.72,0:08:46.22,Default,,0,0,0,,Мен Рокуоиндер отбасының атына сай күрескер болғым келеді.
Dialogue: 0,0:08:46.22,0:08:49.22,Default,,0,0,0,,Рокуоиннің карта ұрысы туралы айту➡
Dialogue: 0,0:08:49.22,0:08:53.19,Default,,0,0,0,,Оның байсалды, байсалды және тиімді ұрыс стилі оған тән➡
Dialogue: 0,0:08:53.19,0:08:55.70,Default,,0,0,0,,Сіз әрқашан керемет әсер аласыз➡
Dialogue: 0,0:08:55.70,0:08:58.17,Default,,0,0,0,,Сіз ешқашан қобалжымайсыз ба? ➡
Dialogue: 0,0:08:58.17,0:09:01.67,Default,,0,0,0,,Мен жекпе-жек алдында қобалжыдым...
Dialogue: 0,0:09:01.67,0:09:04.17,Default,,0,0,0,,Ақыл ми арқылы жүреді➡
Dialogue: 0,0:09:04.17,0:09:07.18,Default,,0,0,0,,Бұл жай ғана электрлік сигнал. жұмысшы...?
Dialogue: 0,0:09:07.18,0:09:09.68,Default,,0,0,0,,Қажетсіз ақпаратты жою➡
Dialogue: 0,0:09:09.68,0:09:12.18,Default,,0,0,0,,Әрқашан дұрыс шешім қабылдаңыз➡
Dialogue: 0,0:09:12.18,0:09:15.18,Default,,0,0,0,,Мен осылай ұрысамын.
Dialogue: 0,0:09:26.69,0:09:28.66,Default,,0,0,0,,Мен….
Dialogue: 0,0:09:31.20,0:09:33.70,Default,,0,0,0,,Рокуоин Сузуне.
Dialogue: 0,0:09:35.67,0:09:38.17,Default,,0,0,0,,Оның ұрыстағы теңдесі жоқ дәлдігінен➡
Dialogue: 0,0:09:38.17,0:09:41.64,Default,,0,0,0,,Оның лақап аты - Авангард машинасы.
Dialogue: 0,0:09:42.68,0:09:44.68,Default,,0,0,0,,Бірақ➡
Dialogue: 0,0:09:44.68,0:09:48.18,Default,,0,0,0,,Жүрегіңде болса да сен машина емессің, солай ма?➡
Dialogue: 0,0:09:48.18,0:09:50.15,Default,,0,0,0,,Ол да адам ғой.
Dialogue: 0,0:09:51.65,0:09:53.66,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:09:55.19,0:09:58.66,Default,,0,0,0,,Күдікті Аяз атадан сыйлық!
Dialogue: 0,0:10:01.66,0:10:03.67,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:10:03.67,0:10:07.67,Default,,0,0,0,,Егер шын болса, келесің бе? Жоғары➡
Dialogue: 0,0:10:07.67,0:10:10.17,Default,,0,0,0,,Люкс жеңімпазының атауы➡
Dialogue: 0,0:10:10.17,0:10:12.17,Default,,0,0,0,,Өйткені ол Rokuoin үшін қолайлы.
Dialogue: 0,0:10:13.74,0:10:17.18,Default,,0,0,0,,Бұл не? Жүзіңіз мұңды, күш-қуатыңыз бар➡
Dialogue: 0,0:10:17.18,0:10:19.68,Default,,0,0,0,,Бірақ әлем үлкен! ➡
Dialogue: 0,0:10:19.68,0:10:22.65,Default,,0,0,0,,Қатты мамандар ғана емес, солай ма?
Dialogue: 0,0:10:23.69,0:10:26.15,Default,,0,0,0,,Мм... күзетші жоқ!
Dialogue: 0,0:10:26.15,0:10:28.26,Default,,0,0,0,,Мен жеңдім! ➡
Dialogue: 0,0:10:28.26,0:10:30.66,Default,,0,0,0,,Жарайды, күн жылып барады!
Dialogue: 0,0:10:30.66,0:10:32.66,Default,,0,0,0,,Көшбасшы күткендей➡
Dialogue: 0,0:10:32.66,0:10:34.66,Default,,0,0,0,,Blackout➡ өкілі ретінде
Dialogue: 0,0:10:34.66,0:10:36.66,Default,,0,0,0,,Deluxe Rampage және ашу!
Dialogue: 0,0:10:36.66,0:10:39.70,Default,,0,0,0,,Әрине, біз бұл жолы жеңеміз!
Dialogue: 0,0:10:39.70,0:10:42.20,Default,,0,0,0,,Өте шиеленіс.
Dialogue: 0,0:10:42.20,0:10:45.17,Default,,0,0,0,,Үшінші буын көшбасшысы Юйю чемпионатының кубогы➡
Dialogue: 0,0:10:45.17,0:10:48.68,Default,,0,0,0,,Бұл Yondaime оны қайтарып алатынын білдіреді!
Dialogue: 0,0:10:48.68,0:10:51.68,Default,,0,0,0,,Анта Тирнаног жастары да.
Dialogue: 0,0:10:51.68,0:10:55.18,Default,,0,0,0,,Әрине! Мен де Лейканың екінші рет қатарынан жеңіске жеткенін көргім келеді➡
Dialogue: 0,0:10:55.18,0:10:58.69,Default,,0,0,0,,Бірақ мен де Мегумидің жеңгенін қалаймын➡
Dialogue: 0,0:10:58.69,0:11:01.19,Default,,0,0,0,,A... Сондай-ақ Миллэй үшін!
Dialogue: 0,0:11:01.19,0:11:03.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:03.69,0:11:06.19,Default,,0,0,0,,Айтпақшы, Юйю төртінші көшбасшы➡
Dialogue: 0,0:11:06.19,0:11:08.16,Default,,0,0,0,,Мег-чан – бесінші ұрпақ.
Dialogue: 0,0:11:08.16,0:11:10.16,Default,,0,0,0,,E…Солай ма? ➡
Dialogue: 0,0:11:10.16,0:11:12.20,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:12.20,0:11:14.70,Default,,0,0,0,,Данжи-сан Туя-сан➡
Dialogue: 0,0:11:14.70,0:11:17.67,Default,,0,0,0,,Юйю-сан Мегуми-сан➡
Dialogue: 0,0:11:17.67,0:11:20.68,Default,,0,0,0,,Сонда... төртінші емес пе?
Dialogue: 0,0:11:20.68,0:11:24.18,Default,,0,0,0,,Түсіндім, бұрын сөйлескен жоқпыз ба?
Dialogue: 0,0:11:24.18,0:11:27.72,Default,,0,0,0,,Ым? Данджи➡ алдында бір адам тұрды
Dialogue: 0,0:11:27.72,0:11:31.69,Default,,0,0,0,,Блэкутты жасаған бірінші көшбасшы.
Dialogue: 0,0:11:33.69,0:11:36.16,Default,,0,0,0,,Джажан Нао келді!
Dialogue: 0,0:11:36.16,0:11:39.66,Default,,0,0,0,,Ха... бұл тез! Un?
Dialogue: 0,0:11:39.66,0:11:42.70,Default,,0,0,0,,Нао-чан, күте тұр...!
Dialogue: 0,0:11:42.70,0:11:45.70,Default,,0,0,0,,～
Dialogue: 0,0:11:46.70,0:11:49.67,Default,,0,0,0,,Жеңімпаз Китсунэ Шиба Лаика!
Dialogue: 0,0:11:49.67,0:11:53.68,Default,,0,0,0,,Ку~...және сәл ғана болды~!
Dialogue: 0,0:11:53.68,0:11:56.68,Default,,0,0,0,,Иә, қауіпті болды➡
Dialogue: 0,0:11:56.68,0:11:59.21,Default,,0,0,0,,Ұрыс үшін рахмет.
Dialogue: 0,0:11:59.21,0:12:01.68,Default,,0,0,0,,А...Көп рахмет.
Dialogue: 0,0:12:01.68,0:12:03.69,Default,,0,0,0,,Бұл тамаша жекпе-жек болды! ➡
Dialogue: 0,0:12:03.69,0:12:05.72,Default,,0,0,0,,Енді не болады, күту керек➡
Dialogue: 0,0:12:05.72,0:12:08.69,Default,,0,0,0,,Тапсырыс берушімен екі адам төбелеседі!
Dialogue: 0,0:12:09.69,0:12:12.69,Default,,0,0,0,,Түлкі Шиба Лейка керемет.
Dialogue: 0,0:12:12.69,0:12:15.66,Default,,0,0,0,,Ой, бұл жақсы жекпе-жек болды...
Dialogue: 0,0:12:17.17,0:12:20.67,Default,,0,0,0,,Мен сол Лайка-санмен күресе аламын деп ойлау үшін➡
Dialogue: 0,0:12:20.67,0:12:23.20,Default,,0,0,0,,Қауіпті... қалай айтамын➡
Dialogue: 0,0:12:23.20,0:12:27.21,Default,,0,0,0,,～
Dialogue: 0,0:12:27.21,0:12:31.71,Default,,0,0,0,,Vanguard кафесінде сіз қызметкерлермен күресуге болады, солай ма?
Dialogue: 0,0:12:31.71,0:12:35.22,Default,,0,0,0,,Қызу жаттығулары үшін ағамды ұрып-соғуға болады ма?
Dialogue: 0,0:12:35.22,0:12:39.19,Default,,0,0,0,,Мен сізге айтамын, оны қысқартатын қызмет жоқ, солай ма?
Dialogue: 0,0:12:40.66,0:12:42.66,Default,,0,0,0,,Мен қайтып келдім!
Dialogue: 0,0:12:42.66,0:12:44.73,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:12:44.73,0:12:47.66,Default,,0,0,0,,Куон мен Суохтың орын ауыстыратын уақыты келді емес пе?
Dialogue: 0,0:12:47.66,0:12:51.17,Default,,0,0,0,,Жекпе-жек...Кицунэ Шиба Райкамен жекпе-жек.
Dialogue: 0,0:12:51.17,0:12:53.67,Default,,0,0,0,,Мм...қалғаны өтінемін➡
Dialogue: 0,0:12:53.67,0:12:56.17,Default,,0,0,0,,Бос емес болғаным үшін кешіріңіз, Хикари-чан.
Dialogue: 0,0:12:56.17,0:12:58.14,Default,,0,0,0,,Жоқ...уайымдама!
Dialogue: 0,0:13:00.68,0:13:02.64,Default,,0,0,0,,Күресейік!
Dialogue: 0,0:13:06.68,0:13:08.65,Default,,0,0,0,,...
Dialogue: 0,0:13:13.15,0:13:15.16,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:13:18.16,0:13:20.66,Default,,0,0,0,,Ошируко дәмі….
Dialogue: 0,0:13:20.66,0:13:22.66,Default,,0,0,0,,Хаа….
Dialogue: 0,0:13:22.66,0:13:25.17,Default,,0,0,0,,Америкада мұндай жағдай жоқ.
Dialogue: 0,0:13:25.17,0:13:27.14,Default,,0,0,0,,болды. Маған бұл ұнамайды!
Dialogue: 0,0:13:28.64,0:13:30.64,Default,,0,0,0,,Мен….
Dialogue: 0,0:13:30.64,0:13:32.67,Default,,0,0,0,,Мұндай тағамды жай ғана жеме➡
Dialogue: 0,0:13:32.67,0:13:34.68,Default,,0,0,0,,Денеңізді күтіңіз.
Dialogue: 0,0:13:34.68,0:13:37.15,Default,,0,0,0,,Қайта құлап қалсам, әзіл болмас еді.
Dialogue: 0,0:13:39.15,0:13:41.15,Default,,0,0,0,,Мен қайтып келдім.
Dialogue: 0,0:13:41.15,0:13:43.18,Default,,0,0,0,,...
Dialogue: 0,0:13:43.18,0:13:46.65,Default,,0,0,0,,Сізді күтуге мәжбүрлегенім үшін кешіріңіз. Ха~….
Dialogue: 0,0:13:46.65,0:13:49.72,Default,,0,0,0,,Мен күткен жалғыз адам емес едім.
Dialogue: 0,0:13:49.72,0:13:52.66,Default,,0,0,0,,Авангард әлемдегі ең күшті жауынгер➡
Dialogue: 0,0:13:52.66,0:13:54.66,Default,,0,0,0,,Мичиру Маварима➡
Dialogue: 0,0:13:54.66,0:13:57.13,Default,,0,0,0,,Бүкіл әлем сені күтті.
Dialogue: 0,0:13:58.70,0:14:01.17,Default,,0,0,0,,Уақыт таяп қалды, Тайзо.
Dialogue: 0,0:14:01.17,0:14:03.14,Default,,0,0,0,,А...рахмет.
Dialogue: 0,0:14:06.64,0:14:09.18,Default,,0,0,0,,Мен сенің не айтқың келетінін білемін.
Dialogue: 0,0:14:09.18,0:14:12.65,Default,,0,0,0,,Бірақ дәл қазір бұл орын ең қажет➡
Dialogue: 0,0:14:12.65,0:14:15.15,Default,,0,0,0,,Бұл мен емес деп ойлаңыз.
Dialogue: 0,0:14:15.15,0:14:18.15,Default,,0,0,0,,Ол жай ғана... аңқау жігіт.
Dialogue: 0,0:14:18.15,0:14:20.15,Default,,0,0,0,,Күресейік, Киома.
Dialogue: 0,0:14:20.15,0:14:23.66,Default,,0,0,0,,Менің уақытым жоқ. Тек бір рет.
Dialogue: 0,0:14:23.66,0:14:25.66,Default,,0,0,0,,Мұны істеу керек!
Dialogue: 0,0:14:29.73,0:14:32.70,Default,,0,0,0,,Миоджо...Эрика.
Dialogue: 0,0:14:38.14,0:14:40.14,Default,,0,0,0,,Хехе.
Dialogue: 0,0:14:41.14,0:14:43.18,Default,,0,0,0,,Амми Дитанамен шабуыл.
Dialogue: 0,0:14:43.18,0:14:45.15,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:14:45.15,0:14:48.15,Default,,0,0,0,,Авангардқа Reel-Odium арқылы шабуыл жасаңыз.
Dialogue: 0,0:14:48.15,0:14:51.15,Default,,0,0,0,,Шеберлікпен үш еселік айдауды алыңыз!
Dialogue: 0,0:14:51.15,0:14:53.15,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:14:53.15,0:14:55.16,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:14:55.16,0:14:57.16,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:14:57.16,0:14:59.16,Default,,0,0,0,,Міне! триггерді тарту.
Dialogue: 0,0:14:59.16,0:15:01.66,Default,,0,0,0,,Анахроностың күші плюс 10 000!
Dialogue: 0,0:15:01.66,0:15:03.63,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:15:03.63,0:15:05.67,Default,,0,0,0,,Yahoo Critical Trigger! ➡
Dialogue: 0,0:15:05.67,0:15:09.64,Default,,0,0,0,,Анахроностың күші +10000 Критикалық +1!
Dialogue: 0,0:15:09.64,0:15:11.67,Default,,0,0,0,,A...жинақтар!
Dialogue: 0,0:15:11.67,0:15:15.68,Default,,0,0,0,,Енді, ағайын, соттайтын кез келді.
Dialogue: 0,0:15:15.68,0:15:19.15,Default,,0,0,0,,Кешегі бұқтырмада майдалап туралған балдыркөк бар еді➡
Dialogue: 0,0:15:19.15,0:15:21.15,Default,,0,0,0,,Оны сағынған мен емес!
Dialogue: 0,0:15:21.15,0:15:23.15,Default,,0,0,0,,Не... байқадыңыз?
Dialogue: 0,0:15:23.15,0:15:25.15,Default,,0,0,0,,Бірақ таңдаулы болу жақсы емес!
Dialogue: 0,0:15:25.15,0:15:27.69,Default,,0,0,0,,Маған ұнамайтын нәрсе ұнамайды!
Dialogue: 0,0:15:27.69,0:15:30.66,Default,,0,0,0,,Бұл жекпе-жекте жеңсем, бір апта бойы өзіме ұнайтын нәрсені ғана аламын➡
Dialogue: 0,0:15:30.66,0:15:32.69,Default,,0,0,0,,Мен оны сізге дайындаймын!
Dialogue: 0,0:15:32.69,0:15:35.20,Default,,0,0,0,,Га? Жеңіс - әлдеқайда әділ! ➡
Dialogue: 0,0:15:35.20,0:15:38.67,Default,,0,0,0,,Уақыт, бұрмалау... Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:15:39.67,0:15:42.14,Default,,0,0,0,,Қолыңыздан 2 картаны тастаңыз және осы айналым аяқталғаннан кейін➡
Dialogue: 0,0:15:42.14,0:15:44.17,Default,,0,0,0,,Менің кезегімді қайталаңыз.
Dialogue: 0,0:15:44.17,0:15:47.14,Default,,0,0,0,,Міне...! Анахроноспен шабуыл.
Dialogue: 0,0:15:47.14,0:15:49.68,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:15:49.68,0:15:52.18,Default,,0,0,0,,Бұрылудың соңы… және ➡
Dialogue: 0,0:15:52.18,0:15:54.15,Default,,0,0,0,,Тағы да менің кезегім!
Dialogue: 0,0:15:54.15,0:15:56.65,Default,,0,0,0,,Тұрыңыз және сурет салыңыз!
Dialogue: 0,0:15:56.65,0:15:59.65,Default,,0,0,0,,Регресс өлшегішіндегі лезде қиғаш сызық ➡
Dialogue: 0,0:15:59.65,0:16:01.66,Default,,0,0,0,,Колосстың шеберлігі іске қосылды! ➡
Dialogue: 0,0:16:01.66,0:16:04.16,Default,,0,0,0,,Түсірілімнен бір картаны алып, оны регресс өлшегіш ретінде пайдаланыңыз➡
Dialogue: 0,0:16:04.16,0:16:06.16,Default,,0,0,0,,Өзіңізге қоңырау шалыңыз➡
Dialogue: 0,0:16:06.16,0:16:08.66,Default,,0,0,0,,Reel Odium көмегімен Авангардқа шабуыл жасаңыз! ➡
Dialogue: 0,0:16:08.66,0:16:10.67,Default,,0,0,0,,Дағды іске қосылды! ➡
Dialogue: 0,0:16:10.67,0:16:14.64,Default,,0,0,0,,Distorted Bane-ді регресс өлшегішке айналдырып, үш еселік жетекке ие болыңыз! ➡
Dialogue: 0,0:16:14.64,0:16:18.14,Default,,0,0,0,,Және катушканың қуаты плюс 10 000!
Dialogue: 0,0:16:19.14,0:16:22.64,Default,,0,0,0,,Тым көп болса да... күзетші жоқ!
Dialogue: 0,0:16:22.64,0:16:24.65,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:16:24.65,0:16:26.68,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:16:26.68,0:16:29.68,Default,,0,0,0,,Әй, аға, бітті! сыни триггер.
Dialogue: 0,0:16:30.69,0:16:34.66,Default,,0,0,0,,Колостың күші +10000 катушканың критикалық +1!
Dialogue: 0,0:16:34.66,0:16:38.16,Default,,0,0,0,,Ух...бірақ аяқтауға әлі ерте!
Dialogue: 0,0:16:38.16,0:16:41.16,Default,,0,0,0,,Зақымдануды тексеру 1-тармақ➡
Dialogue: 0,0:16:41.16,0:16:43.13,Default,,0,0,0,,Екінші тармақ➡
Dialogue: 0,0:16:43.13,0:16:45.13,Default,,0,0,0,,Жарайсыңдар! сыни триггер.
Dialogue: 0,0:16:45.13,0:16:48.17,Default,,0,0,0,,Жоқ...! Ғажайып екінші келеді!
Dialogue: 0,0:16:48.17,0:16:51.14,Default,,0,0,0,,Триггер 6-зақымда пайда болған кезде➡
Dialogue: 0,0:16:51.14,0:16:53.14,Default,,0,0,0,,Зақымдануды қалпына келтіріңіз!
Dialogue: 0,0:16:53.14,0:16:55.18,Default,,0,0,0,,Му~!
Dialogue: 0,0:16:55.18,0:16:57.18,Default,,0,0,0,,Бірақ бәрібір менің кезегім.
Dialogue: 0,0:16:57.18,0:16:59.15,Default,,0,0,0,,Анахроноспен шабуыл.
Dialogue: 0,0:17:00.15,0:17:02.15,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:17:02.15,0:17:04.19,Default,,0,0,0,,Колосспен шабуыл.
Dialogue: 0,0:17:04.19,0:17:07.19,Default,,0,0,0,,2 картаны шеберлікпен шығарып, 1 картаны сал.
Dialogue: 0,0:17:08.16,0:17:10.16,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:17:10.16,0:17:12.16,Default,,0,0,0,,Бұрылыстың соңы….
Dialogue: 0,0:17:12.16,0:17:16.16,Default,,0,0,0,,Уау, бір ғана қадам қалды!
Dialogue: 0,0:17:16.16,0:17:18.13,Default,,0,0,0,,Келесі менің кезегім.
Dialogue: 0,0:17:18.13,0:17:20.70,Default,,0,0,0,,Жеңіске жетсем, бір апта➡
Dialogue: 0,0:17:20.70,0:17:23.64,Default,,0,0,0,,Нәрлі көкөніс мәзірі!
Dialogue: 0,0:17:23.64,0:17:25.64,Default,,0,0,0,,Хе...! Амал жоқ➡
Dialogue: 0,0:17:25.64,0:17:28.14,Default,,0,0,0,,Балдыркөк те? мм.
Dialogue: 0,0:17:29.18,0:17:31.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:31.18,0:17:33.18,Default,,0,0,0,,Ах...!
Dialogue: 0,0:17:33.18,0:17:35.65,Default,,0,0,0,,Тағдыр тілегі Уа, байлаушы патша! ➡
Dialogue: 0,0:17:35.65,0:17:38.65,Default,,0,0,0,,Өміріңді ақ қанатпен басқар!
Dialogue: 0,0:17:38.65,0:17:40.69,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:17:40.69,0:17:43.19,Default,,0,0,0,,Король Резаэль Витаның ғажайып тағдыры!
Dialogue: 0,0:17:43.19,0:17:47.16,Default,,0,0,0,,Осы шеберлікпен Novia Call Garugaon-ға қоңырау шалыңыз! ➡
Dialogue: 0,0:17:47.16,0:17:50.67,Default,,0,0,0,,Вармияны шақырыңыз...Шабуыл!
Dialogue: 0,0:17:50.67,0:17:52.63,Default,,0,0,0,,Күзетші! Кесу.
Dialogue: 0,0:17:52.63,0:17:54.67,Default,,0,0,0,,Шабуыл! күзетші!
Dialogue: 0,0:17:54.67,0:17:57.64,Default,,0,0,0,,Резаэль Витамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:57.64,0:17:59.67,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:17:59.67,0:18:02.71,Default,,0,0,0,,Екі Gigantech картасын тастап, Catellus-қа қоңырау шалыңыз! ➡
Dialogue: 0,0:18:02.71,0:18:05.68,Default,,0,0,0,,Сонымен қатар, Резаэлдің күші +10 000!
Dialogue: 0,0:18:06.65,0:18:09.15,Default,,0,0,0,,Геге! Қуаты тым жоғары болса да.
Dialogue: 0,0:18:09.15,0:18:12.15,Default,,0,0,0,,Мен мұнда триггер үшін дұға етіп жатырмын...
Dialogue: 0,0:18:12.15,0:18:14.16,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:18:14.16,0:18:16.16,Default,,0,0,0,,Зақымдануды тексеру➡
Dialogue: 0,0:18:16.16,0:18:18.16,Default,,0,0,0,,Триггер жоқ….
Dialogue: 0,0:18:18.16,0:18:20.16,Default,,0,0,0,,Gigantech-пен шабуыл!
Dialogue: 0,0:18:20.16,0:18:22.16,Default,,0,0,0,,Күзетсіз➡
Dialogue: 0,0:18:22.16,0:18:24.13,Default,,0,0,0,,Өкше, жүр...!
Dialogue: 0,0:18:24.13,0:18:26.13,Default,,0,0,0,,Зақымдануды тексеру!
Dialogue: 0,0:18:26.13,0:18:28.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:29.14,0:18:31.17,Default,,0,0,0,,Оша~!
Dialogue: 0,0:18:31.17,0:18:33.14,Default,,0,0,0,,Дұрыс...осыдан кейін➡
Dialogue: 0,0:18:33.14,0:18:35.14,Default,,0,0,0,,Менің уәдем бар еді➡
Dialogue: 0,0:18:35.14,0:18:37.14,Default,,0,0,0,,Кездескенше, ағайын.
Dialogue: 0,0:18:38.21,0:18:41.65,Default,,0,0,0,,Көкөністердің бір аптасы. Эй!
Dialogue: 0,0:18:41.65,0:18:44.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:44.65,0:18:46.65,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:18:46.65,0:18:49.66,Default,,0,0,0,,Өте жақсы істеп жатырсың ~ менің шәкіртім.
Dialogue: 0,0:18:49.66,0:18:52.19,Default,,0,0,0,,А...Нао-сенпай!
Dialogue: 0,0:18:52.19,0:18:55.66,Default,,0,0,0,,Сіз сонда болдыңыз ба? Жарайды, қызық жекпе-жек болды~➡
Dialogue: 0,0:18:55.66,0:18:57.67,Default,,0,0,0,,Акиндо кіші.
Dialogue: 0,0:18:57.67,0:19:00.17,Default,,0,0,0,,Ахахха... Сіздің іскерлік рухыңыз күшті сияқты.
Dialogue: 0,0:19:00.17,0:19:02.14,Default,,0,0,0,,Сәлем, қош келдіңіз!
Dialogue: 0,0:19:02.14,0:19:04.17,Default,,0,0,0,,Қалай болды? Каге-кун.
Dialogue: 0,0:19:04.17,0:19:06.64,Default,,0,0,0,,Менің Мана шәкіртімнің жекпе-жегі қандай?
Dialogue: 0,0:19:06.64,0:19:08.64,Default,,0,0,0,,Қызықты. а….
Dialogue: 0,0:19:08.64,0:19:11.75,Default,,0,0,0,,Бұл күшті карта күресі болды.
Dialogue: 0,0:19:11.75,0:19:14.65,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:14.65,0:19:18.12,Default,,0,0,0,,Бірақ... не? Мен қызықпын!
Dialogue: 0,0:19:19.15,0:19:22.19,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:22.19,0:19:25.16,Default,,0,0,0,,Бұл не? Сіз оны ойлаған жоқсыз ба?
Dialogue: 0,0:19:25.16,0:19:27.16,Default,,0,0,0,,Саған бірдеңе жетіспейді, Каге-кун.
Dialogue: 0,0:19:27.16,0:19:29.70,Default,,0,0,0,,Сәлем Танма! ойла.
Dialogue: 0,0:19:29.70,0:19:31.67,Default,,0,0,0,,《Осы екеуі➡
Dialogue: 0,0:19:31.67,0:19:33.73,Default,,0,0,0,,Қашықтық сезімі бар емес пе? ➡
Dialogue: 0,0:19:33.73,0:19:35.70,Default,,0,0,0,,Жоқ...? 》
Dialogue: 0,0:19:37.27,0:19:40.67,Default,,0,0,0,,《Нао-сенпай, өтінемін, Токиоға барыңыз.
Dialogue: 0,0:19:40.67,0:19:43.68,Default,,0,0,0,,Маған қалдырыңыз! Кага Самурай ханымы➡
Dialogue: 0,0:19:43.68,0:19:47.18,Default,,0,0,0,,Сіз өзіңіздің қабілеттеріңізді көрсеттіңіз! жоғары.
Dialogue: 0,0:19:47.18,0:19:50.68,Default,,0,0,0,,Турнир аяқталғаннан кейін бірден қайтасыз ба?
Dialogue: 0,0:19:50.68,0:19:53.69,Default,,0,0,0,,Хмм...Мен аздап айналма жолмен жүруім мүмкін.
Dialogue: 0,0:19:54.66,0:19:57.16,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші рет кездескім келетін адам бар.
Dialogue: 0,0:19:57.16,0:19:59.23,Default,,0,0,0,,E….
Dialogue: 0,0:19:59.23,0:20:02.23,Default,,0,0,0,,Мен сізге бір нәрсе айтқым келеді. 》
Dialogue: 0,0:20:04.23,0:20:06.63,Default,,0,0,0,,《Мен бұл адам екеніне сене алмадым...
Dialogue: 0,0:20:06.63,0:20:08.74,Default,,0,0,0,,Бірақ қандай қатынас?
Dialogue: 0,0:20:08.74,0:20:11.17,Default,,0,0,0,,Бұл ақымақ...Мен қызықпын! 》
Dialogue: 0,0:20:11.17,0:20:13.17,Default,,0,0,0,,Келесі жекпе-жектен кейін➡
Dialogue: 0,0:20:13.17,0:20:15.71,Default,,0,0,0,,Демалайық➡
Dialogue: 0,0:20:15.71,0:20:20.15,Default,,0,0,0,,Және! Түскі үзілістен кейін, менің кезегім! ➡
Dialogue: 0,0:20:20.15,0:20:23.15,Default,,0,0,0,,Микото-сама~! Менің сүйіктіммен күресіңіз➡
Dialogue: 0,0:20:23.15,0:20:27.15,Default,,0,0,0,,Өмірімде бір өкінішім жоқ!
Dialogue: 0,0:20:27.15,0:20:30.16,Default,,0,0,0,,Кент Сен көңілді жүрсің.
Dialogue: 0,0:20:30.16,0:20:32.13,Default,,0,0,0,,Мен де... ұрыс.
Dialogue: 0,0:20:33.16,0:20:35.63,Default,,0,0,0,,Ей, түрің қорқынышты~➡
Dialogue: 0,0:20:35.63,0:20:38.20,Default,,0,0,0,,Суудың нөмірі Әлі алыс емес пе?
Dialogue: 0,0:20:38.20,0:20:41.17,Default,,0,0,0,,Алдымен түскі асты жейміз бе? Ұрыс….
Dialogue: 0,0:20:42.14,0:20:44.17,Default,,0,0,0,,Сіз тапсырыс берген коламен ➡
Dialogue: 0,0:20:44.17,0:20:46.14,Default,,0,0,0,,Тороро ламинария сүтінен жасалған шай.
Dialogue: 0,0:20:46.14,0:20:48.14,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:20:48.14,0:20:50.18,Default,,0,0,0,,Жасөспірім. жоғары.
Dialogue: 0,0:20:50.18,0:20:53.18,Default,,0,0,0,,Сіздің сүйікті тағамыңыз қандай? жұмысшы….
Dialogue: 0,0:20:53.18,0:20:56.15,Default,,0,0,0,,Бұқтырылған тағам... Сіздің сүйікті тәттіңіз қандай?
Dialogue: 0,0:20:56.15,0:20:59.15,Default,,0,0,0,,Митараши данго... Менің ойымша.
Dialogue: 0,0:20:59.15,0:21:01.66,Default,,0,0,0,,Сізге қайсысы ұнайды, тау ма, әлде теңіз бе?
Dialogue: 0,0:21:01.66,0:21:03.66,Default,,0,0,0,,Теңіз... солай ма?
Dialogue: 0,0:21:03.66,0:21:05.69,Default,,0,0,0,,Сырттағы адам Жабық адам?
Dialogue: 0,0:21:05.69,0:21:08.66,Default,,0,0,0,,Бірдеңе болса, менің ойымша, бұл далада.
Dialogue: 0,0:21:08.66,0:21:10.66,Default,,0,0,0,,Атча~!
Dialogue: 0,0:21:10.66,0:21:14.14,Default,,0,0,0,,Эй, Кадж-кун, сен кенеттен маған сұрақтар қойып жатырсың➡
Dialogue: 0,0:21:14.14,0:21:17.64,Default,,0,0,0,,Тоқта. Ой кешір...
Dialogue: 0,0:21:17.64,0:21:20.67,Default,,0,0,0,,Бұл соңы! Сізге Vanguard ұнайды ма?
Dialogue: 0,0:21:20.67,0:21:22.64,Default,,0,0,0,,Әрине ұнайды!
Dialogue: 0,0:21:22.64,0:21:24.65,Default,,0,0,0,,Тағы бір нәрсе.
Dialogue: 0,0:21:24.65,0:21:26.68,Default,,0,0,0,,Бұл соңғы рет емес.
Dialogue: 0,0:21:26.68,0:21:30.15,Default,,0,0,0,,Сізде ұмытылмас жекпе-жек бар ма?
Dialogue: 0,0:21:31.15,0:21:33.15,Default,,0,0,0,,Жүрегімде қалады➡
Dialogue: 0,0:21:33.15,0:21:35.66,Default,,0,0,0,,Маңызды карта ұрысы.
Dialogue: 0,0:21:35.66,0:21:38.13,Default,,0,0,0,,Ұмытылмас...жекпе-жек.
Dialogue: 0,0:21:47.13,0:21:50.14,Default,,0,0,0,,Сәлем…бар!
Dialogue: 0,0:21:50.14,0:21:52.14,Default,,0,0,0,,Бұл Нао-сенпаймен төбелес!
Dialogue: 0,0:21:52.14,0:21:54.18,Default,,0,0,0,,A…. О...
Dialogue: 0,0:21:54.18,0:21:57.14,Default,,0,0,0,,Бала...мүмкін сен➡
Dialogue: 0,0:21:57.14,0:21:59.18,Default,,0,0,0,,Саған Нао Чан ұнай ма?
Dialogue: 0,0:21:59.18,0:22:02.15,Default,,0,0,0,,E? Ха~? Эй... Кейдж-кун!
Dialogue: 0,0:22:02.15,0:22:05.15,Default,,0,0,0,,Мм...
Dialogue: 0,0:22:06.65,0:22:09.66,Default,,0,0,0,,Гүлп…. А... менікі.
Dialogue: 0,0:22:09.66,0:22:11.66,Default,,0,0,0,,Пуха~! Тамақ үшін рахмет.
Dialogue: 0,0:22:11.66,0:22:13.66,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:22:13.66,0:22:15.63,Default,,0,0,0,,Қолыңыздан айырыласыз!
Dialogue: 0,0:22:15.63,0:22:17.67,Default,,0,0,0,,Өйткені Каге-кун ақымақ нәрселерді естиді, солай ма?
Dialogue: 0,0:22:17.67,0:22:20.17,Default,,0,0,0,,Идиот...! Сондай бала сияқты...
Dialogue: 0,0:22:24.14,0:22:27.14,Default,,0,0,0,,Сіз бұған сенімдісіз бе... Инабе Нао? ➡
Dialogue: 0,0:22:27.14,0:22:30.14,Default,,0,0,0,,Ах! Якумо Кагецу?
Dialogue: 0,0:22:31.71,0:22:34.15,Default,,0,0,0,,Күте тұрыңыз! Акикун.
Dialogue: 0,0:22:34.15,0:22:36.68,Default,,0,0,0,,Мм...сіз➡
Dialogue: 0,0:22:36.68,0:22:39.15,Default,,0,0,0,,Нао-сенпаймен қандай қарым-қатынастасың?
Dialogue: 0,0:22:39.15,0:22:41.12,Default,,0,0,0,,Хм...қызықсыз ба?
Dialogue: 0,0:22:43.16,0:22:46.73,Default,,0,0,0,,Бұл бәрібір.
Dialogue: 0,0:22:46.73,0:22:50.16,Default,,0,0,0,,[Бір кездері Мичиру-санмен үстемдік үшін бәсекеге түскен кәсіби жауынгер.
Dialogue: 0,0:22:50.16,0:22:54.17,Default,,0,0,0,,Авангардтың болашағын алып жүретін тұлғалардың бірі дейтін дарынды тұлға.
Dialogue: 0,0:22:55.14,0:22:57.64,Default,,0,0,0,,Бір жылдың ішінде кәсіби әлемнен➡
Dialogue: 0,0:22:57.64,0:22:59.64,Default,,0,0,0,,Үнсіз жоғалып кетті➡
Dialogue: 0,0:22:59.64,0:23:01.74,Default,,0,0,0,,Фантомдық майдан жауынгері ретінде➡
Dialogue: 0,0:23:01.74,0:23:03.68,Default,,0,0,0,,Бұл туралы бүгінге дейін айтылып келеді. 》
Dialogue: 0,0:23:03.68,0:23:06.65,Default,,0,0,0,,Ха! Акикун, қате түсінбе, жарай ма? ➡
Dialogue: 0,0:23:06.65,0:23:08.68,Default,,0,0,0,,Кэйдже-кун жай ғана бала күнгі досы➡
Dialogue: 0,0:23:08.68,0:23:12.65,Default,,0,0,0,,Менің авангард шеберім.
Dialogue: 0,0:23:12.65,0:23:15.69,Default,,0,0,0,,Сенпайдың...қожасы?
Dialogue: 0,0:23:15.69,0:23:18.66,Default,,0,0,0,,Бұл қауіпті, ұстаз, тоқтаңыз.
Dialogue: 0,0:23:19.66,0:23:21.66,Default,,0,0,0,,Мен Кагецумын.
Dialogue: 0,0:23:21.66,0:23:24.16,Default,,0,0,0,,Ол жай ғана Кагецу Якумо.
Dialogue: 0,0:23:24.16,0:23:27.17,Default,,0,0,0,,Танысқаныма қуаныштымын... Акина Мейдо.
Dialogue: 0,0:23:31.64,0:23:33.81,Default,,0,0,0,,Қош келдіңіз! Миллионға.
Dialogue: 0,0:23:33.81,0:23:37.68,Default,,0,0,0,,Дәл қазір мен сіздердің жүректеріңізге тікелей сөйлеп тұрмын...
Dialogue: 0,0:23:37.68,0:23:40.18,Default,,0,0,0,,Менің миссиям аяқталса да➡
Dialogue: 0,0:23:40.18,0:23:43.68,Default,,0,0,0,,Мен карталарды енгізу міндетін орындауым керек...
Dialogue: 0,0:23:43.68,0:23:47.25,Default,,0,0,0,,Сондықтан мен Cock Million➡ бағдарламасында қолданған әдістемені қолдандым
Dialogue: 0,0:23:47.25,0:23:50.22,Default,,0,0,0,,Мен бұл бұрышты жалғастырамын деп ойлаймын...
Dialogue: 0,0:23:51.19,0:23:54.16,Default,,0,0,0,,Ендеше келесі жолы лайықты қонақ шақырамын➡
Dialogue: 0,0:23:54.16,0:23:56.13,Default,,0,0,0,,Карталармен таныстыру!
Dialogue: 0,0:23:56.13,0:23:58.13,Default,,0,0,0,,Тағы кездескенше...!
Dialogue: 0,0:23:59.63,0:24:05.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory