Dialogue: 0,0:16:24.25,0:16:26.25,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:16:26.25,0:16:29.25,Default,,0,0,0,,Рокуоиннің жекпе-жегінде ешқандай мүмкіндік жоқ.
Dialogue: 0,0:16:29.25,0:16:31.72,Default,,0,0,0,,Бас жетекті тексеру.
Dialogue: 0,0:16:33.25,0:16:36.22,Default,,0,0,0,,Аранеяның шеберлігімен Лакруаны шегіндіріңіз➡
Dialogue: 0,0:16:36.22,0:16:38.23,Default,,0,0,0,,Ал бұрылыстың соңында➡
Dialogue: 0,0:16:38.23,0:16:40.73,Default,,0,0,0,,Nebula Voke құлпы ашылды.
Dialogue: 0,0:16:40.73,0:16:42.73,Default,,0,0,0,,Жақсы, бұл қиын жағдай➡
Dialogue: 0,0:16:42.73,0:16:44.77,Default,,0,0,0,,Төзгісіз жағдай➡
Dialogue: 0,0:16:44.77,0:16:48.24,Default,,0,0,0,,Қабырғадан өткен сайын, жанып кетем.
Dialogue: 0,0:16:48.24,0:16:50.24,Default,,0,0,0,,Көңілді сияқты.
Dialogue: 0,0:16:50.24,0:16:53.74,Default,,0,0,0,,Жарайды! Бұл өте қызық➡
Dialogue: 0,0:16:53.74,0:16:57.31,Default,,0,0,0,,Сіз де, солай ма? Рокуоин Сузуне!
Dialogue: 0,0:16:57.31,0:16:59.75,Default,,0,0,0,,Авангард көңіл көтеруді қажет етпейді➡
Dialogue: 0,0:16:59.75,0:17:01.78,Default,,0,0,0,,Тек жеңіс пен жеңіліс бар➡
Dialogue: 0,0:17:01.78,0:17:04.75,Default,,0,0,0,,Ал жеңе алмаған күрескердің құны жоқ.
Dialogue: 0,0:17:06.75,0:17:08.72,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:17:08.72,0:17:10.73,Default,,0,0,0,,Бұл соңы➡
Dialogue: 0,0:17:10.73,0:17:13.26,Default,,0,0,0,,Persona Ride Altisaria➡
Dialogue: 0,0:17:13.26,0:17:16.23,Default,,0,0,0,,Дағдыларды белсендіру Megalomania➡ жиынтығы
Dialogue: 0,0:17:16.23,0:17:18.23,Default,,0,0,0,,Тұмандықты құлыптау.
Dialogue: 0,0:17:21.27,0:17:25.24,Default,,0,0,0,,Артқы қорғанысты әр бұрылыста құлыптап, шабуылдар санын шектеудің орнына➡
Dialogue: 0,0:17:25.24,0:17:27.24,Default,,0,0,0,,Кесу үшін блоктау➡
Dialogue: 0,0:17:27.24,0:17:29.28,Default,,0,0,0,,Бұл сұмдық техника сияқты.
Dialogue: 0,0:17:29.28,0:17:32.78,Default,,0,0,0,,Сенька шабуылда да, қорғаныста да шектелген қозғалысын жалғастыруда➡
Dialogue: 0,0:17:32.78,0:17:35.75,Default,,0,0,0,,Бұл жекпе-жек... толығымен сол баланың қарқынында.
Dialogue: 0,0:17:36.75,0:17:39.75,Default,,0,0,0,,LeFle Lacroix➡ қоңырау шалыңыз
Dialogue: 0,0:17:39.75,0:17:43.26,Default,,0,0,0,,Жеңіс ырғағын соғуды жалғастырамын➡
Dialogue: 0,0:17:43.26,0:17:46.73,Default,,0,0,0,,Лакруамен шабуыл. Күзетші жоқ➡
Dialogue: 0,0:17:46.73,0:17:49.73,Default,,0,0,0,,Зақым алған кезде іске қосылғаннан асып кету➡
Dialogue: 0,0:17:49.73,0:17:52.73,Default,,0,0,0,,Инбалдионың күші плюс 5000!
Dialogue: 0,0:17:52.73,0:17:55.77,Default,,0,0,0,,Руфурмен шабуыл. Күзетші жоқ➡
Dialogue: 0,0:17:55.77,0:17:59.24,Default,,0,0,0,,Толығырақ! Жау неғұрлым күшті болса, соғұрлым көп
Dialogue: 0,0:17:59.24,0:18:02.74,Default,,0,0,0,,Менің қаным одан асып түседі! ➡
Dialogue: 0,0:18:02.74,0:18:06.75,Default,,0,0,0,,Инбалдионың күші +5000 артық!
Dialogue: 0,0:18:06.75,0:18:09.28,Default,,0,0,0,,Айқайласаңыз да ештеңе өзгермейді➡
Dialogue: 0,0:18:09.28,0:18:12.75,Default,,0,0,0,,Артисария 2 немесе одан да көп Ракушо картасы ➡ болғанда
Dialogue: 0,0:18:12.75,0:18:14.76,Default,,0,0,0,,Критикалық плюс 1 ➡
Dialogue: 0,0:18:14.76,0:18:17.26,Default,,0,0,0,,Альтисариядағы Авангардқа шабуыл жасау➡
Dialogue: 0,0:18:17.26,0:18:20.80,Default,,0,0,0,,Дағдыны белсендіру 2 Shadow Army картасына қоңырау шалыңыз➡
Dialogue: 0,0:18:20.80,0:18:24.73,Default,,0,0,0,,Әрбір 2 Rakusu картасы үшін алдыңғы қатардағы қуат +5000➡
Dialogue: 0,0:18:24.73,0:18:27.74,Default,,0,0,0,,Сонымен қатар, шегінген Лакруа шеберлігімен➡
Dialogue: 0,0:18:27.74,0:18:30.24,Default,,0,0,0,,Artisaria қуаты плюс 5000➡
Dialogue: 0,0:18:30.24,0:18:32.24,Default,,0,0,0,,Қорытынды әнді айтайық.
Dialogue: 0,0:18:37.75,0:18:40.21,Default,,0,0,0,,Маған рұқсат етіңіз... Күзетші!
Dialogue: 0,0:18:44.25,0:18:46.75,Default,,0,0,0,,Қос жетек➡
Dialogue: 0,0:18:46.75,0:18:48.72,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:18:48.72,0:18:50.73,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:18:50.73,0:18:52.83,Default,,0,0,0,,Критикалық триггер➡
Dialogue: 0,0:18:52.83,0:18:54.73,Default,,0,0,0,,Көлеңке армиясына қуат плюс 10 000➡
Dialogue: 0,0:18:54.73,0:18:56.76,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:18:56.76,0:18:59.73,Default,,0,0,0,,Хахаха...! Мен оны осында тартуым керек пе?
Dialogue: 0,0:18:59.73,0:19:02.90,Default,,0,0,0,,Бұл ең жақсы, Рокуоин Сузуне!
Dialogue: 0,0:19:02.90,0:19:06.41,Default,,0,0,0,,Көлеңке армиясымен Авангардқа үздіксіз шабуыл жасаңыз!
Dialogue: 0,0:19:32.23,0:19:36.24,Default,,0,0,0,,Жеңімпаз: Сузунэ Рокуоин!
Dialogue: 0,0:19:36.24,0:19:39.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:39.24,0:19:41.74,Default,,0,0,0,,Шайқас Сізге көп рахмет.
Dialogue: 0,0:19:41.74,0:19:44.25,Default,,0,0,0,,Хахаха...! а….
Dialogue: 0,0:19:44.25,0:19:46.25,Default,,0,0,0,,Жақсы...жақсы➡
Dialogue: 0,0:19:46.25,0:19:49.25,Default,,0,0,0,,Бұл түпкі жеңіліс, мына қорлық➡
Dialogue: 0,0:19:49.25,0:19:51.25,Default,,0,0,0,,Мені одан да күшті ет➡
Dialogue: 0,0:19:51.25,0:19:53.75,Default,,0,0,0,,Сондықтан мен Vanguard ойнауды қоя алмаймын.
Dialogue: 0,0:19:53.75,0:19:57.73,Default,,0,0,0,,Жеңілсең де бақыттысың ба?
Dialogue: 0,0:19:57.73,0:20:00.23,Default,,0,0,0,,Мен өмірдің басқа мақсатын таптым➡
Dialogue: 0,0:20:00.23,0:20:02.73,Default,,0,0,0,,Мен ешқашан мұндай бақытты болған емеспін.
Dialogue: 0,0:20:04.27,0:20:06.23,Default,,0,0,0,,Біртүрлі адам.
Dialogue: 0,0:20:07.23,0:20:09.24,Default,,0,0,0,,Ол шығып жатыр. Ха.
Dialogue: 0,0:20:13.81,0:20:16.28,Default,,0,0,0,,｟Маман болу арманым орындалды➡
Dialogue: 0,0:20:16.28,0:20:19.25,Default,,0,0,0,,Әрі қарай, біз алда не күтіп тұрғанын анықтауымыз керек.
Dialogue: 0,0:20:19.25,0:20:22.32,Default,,0,0,0,,Мен өмірдің басқа мақсатын таптым➡
Dialogue: 0,0:20:22.32,0:20:24.79,Default,,0,0,0,,Мен ешқашан мұндай бақытты болған емеспін. ｠
Dialogue: 0,0:20:25.82,0:20:29.26,Default,,0,0,0,,｟Мен неге Vanguard ойнаймын?➡
Dialogue: 0,0:20:29.26,0:20:32.29,Default,,0,0,0,,Себебі бұл қызық, өйткені маған жарыс ұнайды➡
Dialogue: 0,0:20:32.29,0:20:34.30,Default,,0,0,0,,Немесе басқа нәрсе... ｠
Dialogue: 0,0:20:37.30,0:20:40.73,Default,,0,0,0,,｟Жауабын осы турнирден тапқым келеді➡
Dialogue: 0,0:20:40.73,0:20:42.80,Default,,0,0,0,,Сол себепті де➡
Dialogue: 0,0:20:42.80,0:20:45.31,Default,,0,0,0,,Алдарыңыздағы жекпе-жекті бар күшіңізбен тартыңыз! ｠
Dialogue: 0,0:20:48.81,0:20:50.74,Default,,0,0,0,,｟Авангард – бәсекелестік әлемі➡
Dialogue: 0,0:20:50.74,0:20:53.81,Default,,0,0,0,,Күштен басқаның бәрі арам➡
Dialogue: 0,0:20:53.81,0:20:57.79,Default,,0,0,0,,Қуаныш пен мұң маған керек емес нәрсе. ｠
Dialogue: 0,0:20:59.32,0:21:01.79,Default,,0,0,0,,｟Бос ма➡
Dialogue: 0,0:21:01.79,0:21:03.79,Default,,0,0,0,,Ол да... ｠
Dialogue: 0,0:21:07.23,0:21:10.26,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Un? ➡
Dialogue: 0,0:21:10.26,0:21:14.24,Default,,0,0,0,,Куон Айкава Сіз мұндай жерде не істеп жүрсіз?
Dialogue: 0,0:21:14.24,0:21:17.74,Default,,0,0,0,,Мен Сенька мырзаға керемет шайқасы үшін алғыс айту үшін келдім.
Dialogue: 0,0:21:17.74,0:21:21.24,Default,,0,0,0,,Жақсы айттыңыз, бұл бәрі емес, солай ма?
Dialogue: 0,0:21:21.24,0:21:23.74,Default,,0,0,0,,Мен бір орында тұра алмаймын...
Dialogue: 0,0:21:23.74,0:21:27.25,Default,,0,0,0,,Қалай? Үлкен сахнада қобалжымайсыз ба?
Dialogue: 0,0:21:27.25,0:21:31.25,Default,,0,0,0,,Әйтеуір... Көпшілік алдына шығып үйреніп қалғанмын.
Dialogue: 0,0:21:31.25,0:21:33.25,Default,,0,0,0,,Бұл сүйкімді емес...
Dialogue: 0,0:21:33.25,0:21:37.26,Default,,0,0,0,,Бірақ көңіл-күйіңіз көтеріңкі сияқты.
Dialogue: 0,0:21:37.26,0:21:40.23,Default,,0,0,0,,Сіз шынымен ұрысқыңыз келген адаммен➡
Dialogue: 0,0:21:40.23,0:21:42.73,Default,,0,0,0,,Сіз шайқаса аласыз. а….
Dialogue: 0,0:21:42.73,0:21:44.73,Default,,0,0,0,,Хахаха! ➡
Dialogue: 0,0:21:44.73,0:21:47.23,Default,,0,0,0,,Сіз де солай көрінесіз!
Dialogue: 0,0:21:47.23,0:21:50.74,Default,,0,0,0,,А...Солай емес пе?
Dialogue: 0,0:21:52.27,0:21:56.24,Default,,0,0,0,,Тағдыр патшасы мен Тағдыр патшасы арасындағы шайқас➡
Dialogue: 0,0:21:56.24,0:21:58.21,Default,,0,0,0,,Әлі қосылмаған.
Dialogue: 0,0:21:59.71,0:22:05.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory