Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:29.29,0:00:32.29,Default,,0,0,0,,Сүзүне-сама, отағасы қолы бос емес➡
Dialogue: 0,0:00:32.29,0:00:35.76,Default,,0,0,0,,Ашылу салтанатына уақытында жетпейміз дейді➡
Dialogue: 0,0:00:35.76,0:00:38.30,Default,,0,0,0,,Сондай-ақ, менің сізге хабарым бар.
Dialogue: 0,0:00:38.30,0:00:40.34,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:00:40.34,0:00:43.34,Default,,0,0,0,,Үздіксіз жеңіс – бұл... ｟(Рокуоин Юрин) Рокуоиннің құрметі➡
Dialogue: 0,0:00:43.34,0:00:45.84,Default,,0,0,0,,Өз тегіңізге сай болу үшін күресіңіз. ｠
Dialogue: 0,0:00:46.78,0:00:49.28,Default,,0,0,0,,Сәлем анашым.
Dialogue: 0,0:02:23.27,0:02:27.28,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:27.28,0:02:29.78,Default,,0,0,0,,А тобы: Бірінші матчтың жеңімпазы➡
Dialogue: 0,0:02:29.78,0:02:31.75,Default,,0,0,0,,Бұл Мираи дәріге арналған сөмке!
Dialogue: 0,0:02:33.92,0:02:36.75,Default,,0,0,0,,Алдын ала ойындар айналымнан өтеді, кім өтеді➡
Dialogue: 0,0:02:36.75,0:02:38.75,Default,,0,0,0,,Мен әлі түсінбеймін!
Dialogue: 0,0:02:38.75,0:02:40.76,Default,,0,0,0,,Келесі - В тобы
Dialogue: 0,0:02:40.76,0:02:42.76,Default,,0,0,0,,Сәйкестік картасы...
Dialogue: 0,0:02:44.79,0:02:48.83,Default,,0,0,0,,Сенка Канаэ Сузунэ Рокуоинге қарсы!
Dialogue: 0,0:02:48.83,0:02:51.27,Default,,0,0,0,,📺 Авангард әлемінде керемет серпін көрсету ➡
Dialogue: 0,0:02:51.27,0:02:54.27,Default,,0,0,0,,Жаңа кәсіби жауынгерлер арасындағы кездесу! ➡
Dialogue: 0,0:02:54.27,0:02:56.77,Default,,0,0,0,,Бұл жігіттен көз алмайсың!
Dialogue: 0,0:02:57.77,0:03:00.78,Default,,0,0,0,,Хе! Бірдеңе жейтін сияқтымыз.
Dialogue: 0,0:03:00.78,0:03:02.84,Default,,0,0,0,,Хум!
Dialogue: 0,0:03:02.84,0:03:06.25,Default,,0,0,0,,📺Матч интервалдан кейін басталады!
Dialogue: 0,0:03:06.25,0:03:08.25,Default,,0,0,0,,Ым?
Dialogue: 0,0:03:11.75,0:03:13.76,Default,,0,0,0,,Фу….
Dialogue: 0,0:03:19.26,0:03:21.26,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:03:22.76,0:03:24.77,Default,,0,0,0,,Карамель.
Dialogue: 0,0:03:24.77,0:03:27.27,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:03:27.27,0:03:30.27,Default,,0,0,0,,Мен Мегуми Окурамын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:03:30.27,0:03:32.24,Default,,0,0,0,,Бұл Сузунэ Рокуоин.
Dialogue: 0,0:03:33.28,0:03:35.24,Default,,0,0,0,,Ам.
Dialogue: 0,0:03:36.28,0:03:38.75,Default,,0,0,0,,Ахаха...шынымен дәмді➡
Dialogue: 0,0:03:38.75,0:03:41.28,Default,,0,0,0,,Мына карамель.
Dialogue: 0,0:03:41.28,0:03:45.25,Default,,0,0,0,,Қантты жеген кезде миыңыз жақсы жұмыс істейді.
Dialogue: 0,0:03:45.25,0:03:47.76,Default,,0,0,0,,Иә, бірақ бәрі де➡
Dialogue: 0,0:03:47.76,0:03:49.76,Default,,0,0,0,,Дұрыс тамақтану?
Dialogue: 0,0:03:50.83,0:03:53.80,Default,,0,0,0,,Кешіріңіз, мен жекпе-жекке дайындалуым керек.
Dialogue: 0,0:03:55.76,0:03:58.23,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:03:59.77,0:04:01.74,Default,,0,0,0,,Аха….
Dialogue: 0,0:04:03.27,0:04:05.27,Default,,0,0,0,,Сонымен, кез келген турнир➡
Dialogue: 0,0:04:05.27,0:04:07.78,Default,,0,0,0,,Бұл маған кәсіпқой болудың қаншалықты қатал екенін жақсы түсінді.
Dialogue: 0,0:04:07.78,0:04:09.78,Default,,0,0,0,,Бұл керемет, Нао-сенпай➡
Dialogue: 0,0:04:09.78,0:04:11.78,Default,,0,0,0,,Маманға ұқсайды.
Dialogue: 0,0:04:11.78,0:04:13.75,Default,,0,0,0,,Сіз кәсіби маманмын дедіңіз ғой, солай ма?
Dialogue: 0,0:04:13.75,0:04:16.25,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:04:16.25,0:04:18.75,Default,,0,0,0,,Фу… Адалдық➡
Dialogue: 0,0:04:18.75,0:04:20.76,Default,,0,0,0,,Әзірше өзімді...➡ сезініп тұрмын
Dialogue: 0,0:04:20.76,0:04:23.26,Default,,0,0,0,,Бірақ мен толқуды тоқтата алмаймын.
Dialogue: 0,0:04:23.26,0:04:25.79,Default,,0,0,0,,Көңілді...?
Dialogue: 0,0:04:25.79,0:04:28.76,Default,,0,0,0,,Бұл ең мықтысы аман қалатын қорқынышты әлем➡
Dialogue: 0,0:04:28.76,0:04:30.80,Default,,0,0,0,,Бұл да өтірік болмайтын жер➡
Dialogue: 0,0:04:30.80,0:04:33.77,Default,,0,0,0,,Нағыз мықтылар ғана өмір сүре алады➡
Dialogue: 0,0:04:33.77,0:04:35.80,Default,,0,0,0,,Маман боламын деген арманым орындалды➡
Dialogue: 0,0:04:35.80,0:04:38.31,Default,,0,0,0,,Әрі қарай, біз алда не күтіп тұрғанын анықтауымыз керек.
Dialogue: 0,0:04:39.27,0:04:41.28,Default,,0,0,0,,Фу….
Dialogue: 0,0:04:41.28,0:04:43.78,Default,,0,0,0,,Өйткені, Нао-сенпай керемет!
Dialogue: 0,0:04:43.78,0:04:47.28,Default,,0,0,0,,Ехе, мен қанша жүрерімді білмеймін.
Dialogue: 0,0:04:47.28,0:04:51.25,Default,,0,0,0,,Ең күшті болуды мақсат тұтқан, басқа ештеңе мүмкін емес!
Dialogue: 0,0:04:51.25,0:04:54.29,Default,,0,0,0,,Қаншалықты ➡ болатыны туралы жылы сөз айтпаңыз
Dialogue: 0,0:04:54.29,0:04:57.33,Default,,0,0,0,,Инабе Нао! Сенка.
Dialogue: 0,0:04:57.33,0:05:01.26,Default,,0,0,0,,Мен соғыс жариялауға келдім. иә?
Dialogue: 0,0:05:01.26,0:05:03.77,Default,,0,0,0,,Тағдырлы шайқаста абайсызда ұсталдым➡
Dialogue: 0,0:05:03.77,0:05:05.77,Default,,0,0,0,,Бұл жолы олай болмайды➡
Dialogue: 0,0:05:05.77,0:05:08.27,Default,,0,0,0,,Мен сенен міндетті түрде асып түсемін.
Dialogue: 0,0:05:08.27,0:05:10.77,Default,,0,0,0,,Бұл бұрынғыдай қарапайым.
Dialogue: 0,0:05:10.77,0:05:13.78,Default,,0,0,0,,Өзіңізден биік қабырғаны бұзыңыз➡
Dialogue: 0,0:05:13.78,0:05:15.81,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:05:15.81,0:05:19.28,Default,,0,0,0,,Тек алға ұмтылу арқылы жеңуге болады деп ойламаймын ба?
Dialogue: 0,0:05:19.28,0:05:22.28,Default,,0,0,0,,Қуырылған жұмыртқаға майонез жағатындар сондықтан...
Dialogue: 0,0:05:22.28,0:05:25.82,Default,,0,0,0,,Жұмыртқаны жұмыртқаға дәмдеу мағынасы жоқ.
Dialogue: 0,0:05:25.82,0:05:29.76,Default,,0,0,0,,Менің ойымша, бұл Табасконы бәріне қоятын өте ащы маньяктан жақсы➡
Dialogue: 0,0:05:29.76,0:05:32.26,Default,,0,0,0,,А...дәм сезу сезімін тастадым?
Dialogue: 0,0:05:32.26,0:05:34.76,Default,,0,0,0,,А? Хмм?
Dialogue: 0,0:05:34.76,0:05:37.23,Default,,0,0,0,,Эй... ұрыс-керіс жоқ!
Dialogue: 0,0:05:39.27,0:05:41.30,Default,,0,0,0,,Күшті болған жақсы, бірақ➡
Dialogue: 0,0:05:41.30,0:05:43.77,Default,,0,0,0,,Бірінші матчқа назар аударған дұрыс емес пе?
Dialogue: 0,0:05:43.77,0:05:45.77,Default,,0,0,0,,Маған айтудың қажеті жоқ➡
Dialogue: 0,0:05:45.77,0:05:47.78,Default,,0,0,0,,Біріншіден, беделді Рокуо-ин храмынан тыс➡
Dialogue: 0,0:05:47.78,0:05:49.81,Default,,0,0,0,,Мен сізге серпін беремін.
Dialogue: 0,0:05:49.81,0:05:52.28,Default,,0,0,0,,Рокуоин атақты ма?
Dialogue: 0,0:05:53.28,0:05:56.28,Default,,0,0,0,,Рокуоин отбасы ұзақ уақыт бойы кәсіпқой авангард болды➡
Dialogue: 0,0:05:56.28,0:05:58.79,Default,,0,0,0,,Бұл көптеген шәкірттер шығарған беделді отбасы➡
Dialogue: 0,0:05:58.79,0:06:02.26,Default,,0,0,0,,Ұрпақтан ұрпаққа жалғасып келе жатқан ұрыс стилі дәлдігі жағынан теңдесі жоқ➡
Dialogue: 0,0:06:02.26,0:06:05.79,Default,,0,0,0,,Ол әлі күнге дейін Рокуоин деп аталады.
Dialogue: 0,0:06:05.79,0:06:07.76,Default,,0,0,0,,Күшті көрінеді...
Dialogue: 0,0:06:07.76,0:06:11.27,Default,,0,0,0,,Ха! Қарсыласыңыз үшін ешқандай кемшілік жоқ.
Dialogue: 0,0:06:11.27,0:06:13.27,Default,,0,0,0,,Фу….
Dialogue: 0,0:06:13.27,0:06:15.27,Default,,0,0,0,,Ым?
Dialogue: 0,0:06:24.31,0:06:27.25,Default,,0,0,0,,Мен әжетхана іздеп келдім, неге сырттасың?
Dialogue: 0,0:06:27.25,0:06:29.25,Default,,0,0,0,,Ішінде дәретхана болған жоқ.
Dialogue: 0,0:06:29.25,0:06:31.29,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:06:31.29,0:06:34.29,Default,,0,0,0,,Deluxe-де жеңіске жету - бұл жай ғана өту нүктесі.
Dialogue: 0,0:06:36.76,0:06:39.33,Default,,0,0,0,,Сюзунэ, сіздің талантыңыз➡
Dialogue: 0,0:06:39.33,0:06:42.80,Default,,0,0,0,,Ол Rokuoin тарихында ерекше көзге түседі➡
Dialogue: 0,0:06:42.80,0:06:46.77,Default,,0,0,0,,Дегенмен, бұл біздің ізашарлардың күш-жігерінің жинақталуының арқасында мүмкін болды➡
Dialogue: 0,0:06:46.77,0:06:49.27,Default,,0,0,0,,Сондықтан ол талант сіздікі емес➡
Dialogue: 0,0:06:49.27,0:06:52.27,Default,,0,0,0,,Рокуоин түсіндім.
Dialogue: 0,0:06:52.27,0:06:54.28,Default,,0,0,0,,Сәлем анашым.
Dialogue: 0,0:06:54.28,0:06:57.28,Default,,0,0,0,,Жеңіс – берілген, күресу мүмкін емес➡
Dialogue: 0,0:06:57.28,0:06:59.25,Default,,0,0,0,,Жеңіске жету.
Dialogue: 0,0:06:59.25,0:07:02.75,Default,,0,0,0,,Үздіксіз жеңіс - Рокуоиннің абыройы.
Dialogue: 0,0:07:02.75,0:07:05.25,Default,,0,0,0,,Дұрыс. Бар болғаны.
Dialogue: 0,0:07:12.76,0:07:14.76,Default,,0,0,0,,Бұл➡
Dialogue: 0,0:07:14.76,0:07:16.77,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:16.77,0:07:18.77,Default,,0,0,0,,Е...?
Dialogue: 0,0:07:18.77,0:07:20.77,Default,,0,0,0,,Бұл...қалай айтасыз?➡
Dialogue: 0,0:07:20.77,0:07:23.27,Default,,0,0,0,,Өйткені бұл ауыр көрінді.
Dialogue: 0,0:07:23.27,0:07:25.27,Default,,0,0,0,,Мен үшін... қиын ба?
Dialogue: 0,0:07:25.27,0:07:27.28,Default,,0,0,0,,Un.
Dialogue: 0,0:07:27.28,0:07:29.28,Default,,0,0,0,,Мүмкін емес➡
Dialogue: 0,0:07:29.28,0:07:31.25,Default,,0,0,0,,Авангард – бәсекелестік әлемі.
Dialogue: 0,0:07:32.25,0:07:35.28,Default,,0,0,0,,Күштен басқаның бәрі лас ➡
Dialogue: 0,0:07:35.28,0:07:38.79,Default,,0,0,0,,Қуаныш пен мұң – маған керегі жоқ нәрселер.
Dialogue: 0,0:07:40.26,0:07:42.26,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:47.26,0:07:49.26,Default,,0,0,0,,Күте тұрыңыз! ➡
Dialogue: 0,0:07:49.26,0:07:52.77,Default,,0,0,0,,В тобының ойыны енді басталады!
Dialogue: 0,0:07:52.77,0:07:56.77,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:56.77,0:07:59.77,Default,,0,0,0,,Болашақта пайда табу үшін күресуші➡
Dialogue: 0,0:07:59.77,0:08:02.28,Default,,0,0,0,,Ол жас ханым сияқты шайқасқа ұқсайды➡
Dialogue: 0,0:08:02.28,0:08:04.25,Default,,0,0,0,,Gap Moe дегеніміз не? ➡
Dialogue: 0,0:08:04.25,0:08:06.75,Default,,0,0,0,,Дұшпаннан асып түсетін сұмдық➡
Dialogue: 0,0:08:06.75,0:08:08.75,Default,,0,0,0,,Динг Сенка!
Dialogue: 0,0:08:09.78,0:08:13.25,Default,,0,0,0,,Бұл да супер жаңадан ойыншы➡
Dialogue: 0,0:08:13.25,0:08:15.76,Default,,0,0,0,,Беделді Rokuoin отбасы жасаған➡
Dialogue: 0,0:08:15.76,0:08:17.76,Default,,0,0,0,,Жоғары сапалы авангард машина➡
Dialogue: 0,0:08:17.76,0:08:19.76,Default,,0,0,0,,Рокуоин Сузуне!
Dialogue: 0,0:08:19.76,0:08:22.76,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:26.27,0:08:28.80,Default,,0,0,0,,Саннова➡
Dialogue: 0,0:08:28.80,0:08:31.77,Default,,0,0,0,,Бұл маған, сізге және Райка Китсунешибаға берілген лақап ат.
Dialogue: 0,0:08:32.77,0:08:35.28,Default,,0,0,0,,Бір уақытта танымалдыққа көтерілу➡
Dialogue: 0,0:08:35.28,0:08:37.81,Default,,0,0,0,,Саннова, өйткені бұл күту жұлдызы.
Dialogue: 0,0:08:37.81,0:08:41.82,Default,,0,0,0,,Шынымды айтсам, бұл тақырып мені қызықтырмады➡
Dialogue: 0,0:08:41.82,0:08:44.75,Default,,0,0,0,,Балалар, мені ұрып-соғып, мен бірінші жұлдызмын деп айтасыңдар➡
Dialogue: 0,0:08:44.75,0:08:46.76,Default,,0,0,0,,Оны дәлелдеу жаман емес.
Dialogue: 0,0:08:47.76,0:08:49.76,Default,,0,0,0,,Бұл мүмкін емес➡
Dialogue: 0,0:08:49.76,0:08:51.76,Default,,0,0,0,,Өйткені мен күштімін.
Dialogue: 0,0:08:51.76,0:08:54.30,Default,,0,0,0,,Хаха! Жоғары.
Dialogue: 0,0:08:54.30,0:08:57.77,Default,,0,0,0,,Өзімшілдікпен айналыс... Мен күштімін.
Dialogue: 0,0:08:57.77,0:08:59.77,Default,,0,0,0,,Аха….
Dialogue: 0,0:09:02.27,0:09:04.77,Default,,0,0,0,,Қазір…3-ші Deluxe➡
