Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.27,0:00:06.34,Default,,0,0,0,,Сен күшейдің, Нао-чан!
Dialogue: 0,0:00:06.34,0:00:08.77,Default,,0,0,0,,Жақында Кадж-кунды қуып жетесіз!
Dialogue: 0,0:00:08.77,0:00:11.34,Default,,0,0,0,,А... 100 жыл өте жылдам!
Dialogue: 0,0:00:11.34,0:00:13.81,Default,,0,0,0,,Менің мақсатым – ең мықты боксшы болу, солай ма?
Dialogue: 0,0:00:13.81,0:00:16.78,Default,,0,0,0,,Бұл мүмкін емес...себебі мен ең күшті боламын.
Dialogue: 0,0:00:16.78,0:00:18.78,Default,,0,0,0,,Енді сіз айтасыз➡
Dialogue: 0,0:00:18.78,0:00:21.28,Default,,0,0,0,,Ал... тағы бір жекпе-жек!
Dialogue: 0,0:00:21.28,0:00:23.25,Default,,0,0,0,,Ум! Хехе….
Dialogue: 0,0:00:38.77,0:00:40.77,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:41.94,0:00:44.41,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет төбелесіп отырып сөйлесейік.
Dialogue: 0,0:02:18.77,0:02:21.30,Default,,0,0,0,,Лобби болса жақсы болар еді.
Dialogue: 0,0:02:21.30,0:02:25.27,Default,,0,0,0,,Адамдардың естігенін қаламайтын бірдеңе айтатын шығарсың деп ойладым.
Dialogue: 0,0:02:25.27,0:02:27.28,Default,,0,0,0,,Айтыңыз➡
Dialogue: 0,0:02:27.28,0:02:30.28,Default,,0,0,0,,Каге-кун нені өзгертті?
Dialogue: 0,0:02:30.28,0:02:32.28,Default,,0,0,0,,Бұл сұраққа жауап беру үшін➡
Dialogue: 0,0:02:32.28,0:02:34.82,Default,,0,0,0,,Бір ғана карточкалық жекпе-жек➡
Dialogue: 0,0:02:34.82,0:02:37.79,Default,,0,0,0,,Бұл... менің тағдырымды өзгертті.
Dialogue: 0,0:02:39.25,0:02:41.26,Default,,0,0,0,,бастайық.
Dialogue: 0,0:02:41.26,0:02:43.76,Default,,0,0,0,,Тұрақты Авангард.
Dialogue: 0,0:02:45.83,0:02:48.76,Default,,0,0,0,,Мен Авангардты бастауыш мектепте оқып жүргенімде кездестірдім.
Dialogue: 0,0:02:48.76,0:02:51.80,Default,,0,0,0,,Осындай қызық ойын бар ма екен➡
Dialogue: 0,0:02:51.80,0:02:53.84,Default,,0,0,0,,Мен бірден байланып қалдым.
Dialogue: 0,0:02:53.84,0:02:56.77,Default,,0,0,0,,Мен күнде мәдениет үйіне және досымның үйіне барамын➡
Dialogue: 0,0:02:56.77,0:02:58.77,Default,,0,0,0,,Бұл Авангард Самадхи болатын.
Dialogue: 0,0:02:58.77,0:03:00.81,Default,,0,0,0,,Осындай қызықты нәрселер➡
Dialogue: 0,0:03:00.81,0:03:03.31,Default,,0,0,0,,Оны өзіме сақтап қалсам, ысырап болар еді.
Dialogue: 0,0:03:03.31,0:03:06.78,Default,,0,0,0,,Басқаларға айтыңыз, сонда Авангард шеңбері кеңейеді➡
Dialogue: 0,0:03:06.78,0:03:08.78,Default,,0,0,0,,Мен сондай бақытты болдым.
Dialogue: 0,0:03:09.82,0:03:12.25,Default,,0,0,0,,Бірте-бірте достарымның арасында ғана ұрыса бастадым➡
Dialogue: 0,0:03:12.25,0:03:14.26,Default,,0,0,0,,Мен көңілім толмайтын болды.
Dialogue: 0,0:03:16.26,0:03:18.79,Default,,0,0,0,,Күшті күрескер болыңыз➡
Dialogue: 0,0:03:18.79,0:03:22.30,Default,,0,0,0,,Мен көбірек қызықты жауынгерлермен танысқым келеді.
Dialogue: 0,0:03:22.30,0:03:25.30,Default,,0,0,0,,Мен кәсіби әлемге секіріп түстім.
Dialogue: 0,0:03:32.34,0:03:35.28,Default,,0,0,0,,((Ёши... Ең күштіні құлат!
Dialogue: 0,0:03:35.28,0:03:37.31,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:37.31,0:03:40.82,Default,,0,0,0,,Біз керемет тартыстың куәсі болдық! ➡
Dialogue: 0,0:03:40.82,0:03:45.25,Default,,0,0,0,,Ақтық жекпе-жекте кім жеңіп, чемпион атанған➡
Dialogue: 0,0:03:45.25,0:03:47.76,Default,,0,0,0,,Кагецу Якумо!
Dialogue: 0,0:03:49.79,0:03:52.86,Default,,0,0,0,,Керемет жекпе-жек болды➡
Dialogue: 0,0:03:52.86,0:03:55.26,Default,,0,0,0,,Мен сенімен одан бетер ұрысқым келеді.
Dialogue: 0,0:03:55.26,0:03:57.77,Default,,0,0,0,,Ой...келесі жолы жеңілмеймін!
Dialogue: 0,0:03:59.84,0:04:02.80,Default,,0,0,0,,Қазіргі уақытта мен өзімді уақыт адамындай сезінемін.
Dialogue: 0,0:04:02.80,0:04:05.77,Default,,0,0,0,,Енді сіз Мичиру Кайманы жеңдіңіз, сіздің жауларыңыз жоқ, солай ма?
Dialogue: 0,0:04:05.77,0:04:07.78,Default,,0,0,0,,Солай ма?➡
Dialogue: 0,0:04:07.78,0:04:10.78,Default,,0,0,0,,Карточка күресі терең.
Dialogue: 0,0:04:10.78,0:04:12.78,Default,,0,0,0,,Мен танымайтын мықты адамдар➡
Dialogue: 0,0:04:12.78,0:04:15.28,Default,,0,0,0,,Мен оның әлі де бір жерде екеніне сенімдімін.
Dialogue: 0,0:04:15.28,0:04:18.79,Default,,0,0,0,,Айтпақшы, Якумо бұл қауесетті біледі ме?
Dialogue: 0,0:04:18.79,0:04:20.76,Default,,0,0,0,,Хм...не?
Dialogue: 0,0:04:20.76,0:04:23.26,Default,,0,0,0,,Әр түнде ойын-сауық саябағында карточкалық төбелес➡
Dialogue: 0,0:04:23.26,0:04:25.29,Default,,0,0,0,,Жауынгерлердің эксцентрлік тобы.
Dialogue: 0,0:04:25.29,0:04:27.26,Default,,0,0,0,,Мен оны бірінші рет естідім.
Dialogue: 0,0:04:27.26,0:04:29.26,Default,,0,0,0,,А, солай емес пе? ➡
Dialogue: 0,0:04:29.26,0:04:31.27,Default,,0,0,0,,Команданы өшіру.
Dialogue: 0,0:04:31.27,0:04:35.27,Default,,0,0,0,,Иә! Ол жақта лидер өте күшті➡
Dialogue: 0,0:04:35.27,0:04:37.27,Default,,0,0,0,,Ең күшті деген қауесет бар.
Dialogue: 0,0:04:37.27,0:04:39.27,Default,,0,0,0,,Өшіру….
Dialogue: 0,0:04:39.27,0:04:41.78,Default,,0,0,0,,Түнде ойын-сауық саябағы!
Dialogue: 0,0:04:41.78,0:04:43.85,Default,,0,0,0,,Бір нәрсе➡
Dialogue: 0,0:04:43.85,0:04:45.81,Default,,0,0,0,,Қызық көрінеді! ))
Dialogue: 0,0:04:49.78,0:04:52.32,Default,,0,0,0,,Орманның арғы жағында➡
Dialogue: 0,0:04:52.32,0:04:55.29,Default,,0,0,0,,Мен жабық ойын-сауық саябағының бар екенін білдім.
Dialogue: 0,0:04:55.29,0:04:58.79,Default,,0,0,0,,Дәл осы жерде Блэкут қыдырып жүреді...
Dialogue: 0,0:05:00.30,0:05:03.83,Default,,0,0,0,,Ғажайып төбе.
Dialogue: 0,0:05:03.83,0:05:05.77,Default,,0,0,0,,((Қорқынышты!
Dialogue: 0,0:05:05.77,0:05:07.77,Default,,0,0,0,,Белгілі бір атмосфера бар...
Dialogue: 0,0:05:16.78,0:05:18.75,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:05:24.29,0:05:28.26,Default,,0,0,0,,Адамдар... солай ма?
Dialogue: 0,0:05:28.26,0:05:30.76,Default,,0,0,0,,Кекеке…. Уау!
Dialogue: 0,0:05:30.76,0:05:34.76,Default,,0,0,0,,Кек сақтама!
Dialogue: 0,0:05:34.76,0:05:36.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:38.27,0:05:40.27,Default,,0,0,0,,Уау...! Бұл не?
Dialogue: 0,0:05:40.27,0:05:42.27,Default,,0,0,0,,E?
Dialogue: 0,0:05:42.27,0:05:44.24,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:05:48.28,0:05:50.25,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:05:52.28,0:05:54.28,Default,,0,0,0,,Жоқ….
Dialogue: 0,0:05:54.28,0:05:56.28,Default,,0,0,0,,Blackout-қа қосылғыңыз келе ме?
Dialogue: 0,0:05:56.28,0:05:58.29,Default,,0,0,0,,E?
Dialogue: 0,0:05:58.29,0:06:00.29,Default,,0,0,0,,Келгеніңізге рахмет~➡
Dialogue: 0,0:06:00.29,0:06:02.76,Default,,0,0,0,,Қараңғылық келген адамға бас тартпайды➡
Dialogue: 0,0:06:02.76,0:06:04.76,Default,,0,0,0,,Баршаңызды шақырамыз!
Dialogue: 0,0:06:04.76,0:06:06.80,Default,,0,0,0,,Жоқ! мен...
Dialogue: 0,0:06:06.80,0:06:08.76,Default,,0,0,0,,Ойёо...бұл дұрыс емес пе?
Dialogue: 0,0:06:08.76,0:06:11.77,Default,,0,0,0,,Не? Сонда сіз бәсекелессіз бе?
Dialogue: 0,0:06:11.77,0:06:14.80,Default,,0,0,0,,Иә! Сіз де Blackout мүшесісіз бе?
Dialogue: 0,0:06:14.80,0:06:17.27,Default,,0,0,0,,Жақсы. Мен мұнда сен туралы өсек естігендіктен келдім.
Dialogue: 0,0:06:17.27,0:06:19.27,Default,,0,0,0,,Қызықты команда бар дейді.
Dialogue: 0,0:06:19.27,0:06:22.28,Default,,0,0,0,,Эхехе~ Онша емес.
Dialogue: 0,0:06:22.28,0:06:25.28,Default,,0,0,0,,Түнгі ойын-сауық саябағы➡
Dialogue: 0,0:06:25.28,0:06:28.28,Default,,0,0,0,,Олар осындай жерге жиналды.
Dialogue: 0,0:06:28.28,0:06:31.25,Default,,0,0,0,,Керемет емес пе? жұмысшы...? мм.
Dialogue: 0,0:06:32.25,0:06:34.76,Default,,0,0,0,,Мен ➡
Dialogue: 0,0:06:34.76,0:06:37.26,Default,,0,0,0,,Маған түн ұнайды➡
Dialogue: 0,0:06:37.26,0:06:40.76,Default,,0,0,0,,Түнде... бәрін қараңғылық жауып тұр.
Dialogue: 0,0:06:40.76,0:06:42.80,Default,,0,0,0,,Дүние ұйқыға кеткенде➡
Dialogue: 0,0:06:42.80,0:06:45.77,Default,,0,0,0,,Көлеңкедегілер де кезек алады.
Dialogue: 0,0:06:45.77,0:06:47.77,Default,,0,0,0,,Отендо-сама➡ астында
Dialogue: 0,0:06:47.77,0:06:49.77,Default,,0,0,0,,Тіпті жақсы күле алмайтындар да➡
Dialogue: 0,0:06:49.77,0:06:51.77,Default,,0,0,0,,Қараңғыда➡
Dialogue: 0,0:06:51.77,0:06:54.78,Default,,0,0,0,,Сіз басқалардың көзіне алаңдамай күле аласыз.
Dialogue: 0,0:06:54.78,0:06:57.28,Default,,0,0,0,,Біз сондай командамыз!
Dialogue: 0,0:06:57.28,0:06:59.28,Default,,0,0,0,,Міне➡
Dialogue: 0,0:06:59.28,0:07:01.75,Default,,0,0,0,,Біз қараңғымыз!
Dialogue: 0,0:07:05.29,0:07:07.79,Default,,0,0,0,,Мен... бұл жақсы команда екен.
Dialogue: 0,0:07:07.79,0:07:10.29,Default,,0,0,0,,Дұрыс? а….
Dialogue: 0,0:07:10.29,0:07:13.30,Default,,0,0,0,,Көз адамның жүрегін көрсетеді.
Dialogue: 0,0:07:14.26,0:07:16.26,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:16.26,0:07:19.27,Default,,0,0,0,,Сіз де «Авангардты» жақсы көресіз, солай емес пе?
Dialogue: 0,0:07:19.27,0:07:21.77,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз де кіргіңіз келе ме?
Dialogue: 0,0:07:21.77,0:07:23.81,Default,,0,0,0,,E….
Dialogue: 0,0:07:23.81,0:07:26.78,Default,,0,0,0,,Әр түнде «Авангард» ойыны адамдарды біріктіреді.
Dialogue: 0,0:07:26.78,0:07:28.78,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:07:28.78,0:07:30.78,Default,,0,0,0,,Мен мұны түсінемін!
Dialogue: 0,0:07:30.78,0:07:32.81,Default,,0,0,0,,Дұрыс...! мм.
Dialogue: 0,0:07:32.81,0:07:35.28,Default,,0,0,0,,Күшті болу үшін, бір-бірімізді түзейік...
Dialogue: 0,0:07:35.28,0:07:37.29,Default,,0,0,0,,Жоқ! иә?
Dialogue: 0,0:07:37.29,0:07:39.75,Default,,0,0,0,,Әлсіз болған дұрыс па?
Dialogue: 0,0:07:39.75,0:07:42.26,Default,,0,0,0,,Бұл дүниеде мықты болу керек➡
Dialogue: 0,0:07:42.26,0:07:44.29,Default,,0,0,0,,Бұл аздап шаршаған жоқ па?
Dialogue: 0,0:07:44.29,0:07:46.76,Default,,0,0,0,,Бірақ...Мен жеңу үшін бар күшімді саламын➡
Dialogue: 0,0:07:46.76,0:07:48.83,Default,,0,0,0,,«Авангард» қызықты емес пе?
Dialogue: 0,0:07:48.83,0:07:51.77,Default,,0,0,0,,Сондықтан мен көп жұмыс істеймін және жеңген кезде қызық болады➡
Dialogue: 0,0:07:51.77,0:07:53.77,Default,,0,0,0,,Мен мықты жігітпен төбелескім келеді➡
Dialogue: 0,0:07:53.77,0:07:56.27,Default,,0,0,0,,Мен жеңіске жету үшін күшті болғым келеді.
Dialogue: 0,0:07:56.27,0:07:59.27,Default,,0,0,0,,Сонда сіздің мақсатыңыз қандай?
Dialogue: 0,0:07:59.27,0:08:01.28,Default,,0,0,0,,Әрине➡
Dialogue: 0,0:08:01.28,0:08:03.28,Default,,0,0,0,,Ең күшті!
Dialogue: 0,0:08:03.28,0:08:06.78,Default,,0,0,0,,Бұл... сіздің авангардыңыз.
Dialogue: 0,0:08:06.78,0:08:08.78,Default,,0,0,0,,О... аа!
Dialogue: 0,0:08:08.78,0:08:11.29,Default,,0,0,0,,Маған ұнайды. Менің ойымша, бұл тамаша.
Dialogue: 0,0:08:11.29,0:08:13.86,Default,,0,0,0,,Бірақ...жеңілсем де➡
Dialogue: 0,0:08:13.86,0:08:15.76,Default,,0,0,0,,Қызықты тартыс болып жатыр.
Dialogue: 0,0:08:15.76,0:08:17.76,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:08:19.26,0:08:21.76,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:21.76,0:08:24.27,Default,,0,0,0,,Менің ойымша, бұл төбелес кезінде болды➡
Dialogue: 0,0:08:24.27,0:08:26.27,Default,,0,0,0,,Оны көргіңіз келе ме?
Dialogue: 0,0:08:28.27,0:08:30.27,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:08:38.28,0:08:41.78,Default,,0,0,0,,Данжи...Итер, итер, керемет! ➡
Dialogue: 0,0:08:41.78,0:08:44.29,Default,,0,0,0,,Таками қалай шығады?
Dialogue: 0,0:08:44.29,0:08:46.79,Default,,0,0,0,,Әлі алыс!
Dialogue: 0,0:08:46.79,0:08:48.76,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:08:48.76,0:08:50.76,Default,,0,0,0,,Иә, мен келуім керек! ➡
Dialogue: 0,0:08:50.76,0:08:52.76,Default,,0,0,0,,Қатты шабуыл жасайық!
Dialogue: 0,0:08:54.83,0:08:56.83,Default,,0,0,0,,((Жоғары деңгей➡
Dialogue: 0,0:08:56.83,0:08:58.83,Default,,0,0,0,,Екеуі де жақсы жауынгерлер. ))
Dialogue: 0,0:09:00.77,0:09:04.27,Default,,0,0,0,,Жеңімпаз Данжи Момояма!
Dialogue: 0,0:09:04.27,0:09:06.27,Default,,0,0,0,,Тынш!
Dialogue: 0,0:09:06.27,0:09:08.78,Default,,0,0,0,,Ku~! Магнолия қос жетегімен➡
Dialogue: 0,0:09:08.78,0:09:10.78,Default,,0,0,0,,Тек триггер шықса.
Dialogue: 0,0:09:10.78,0:09:13.28,Default,,0,0,0,,Ах! Шынымды айтсам, бұл бөлік қорқынышты болды.
Dialogue: 0,0:09:13.28,0:09:15.28,Default,,0,0,0,,Бұл жақсы жекпе-жек болды!
Dialogue: 0,0:09:15.28,0:09:17.29,Default,,0,0,0,,Рахмет! Мияко.
Dialogue: 0,0:09:17.29,0:09:19.25,Default,,0,0,0,,Миёко-сан, менімен жарысайық~!
Dialogue: 0,0:09:19.25,0:09:21.76,Default,,0,0,0,,Жоқ! Люк қазір➡
Dialogue: 0,0:09:21.76,0:09:23.76,Default,,0,0,0,,Менімен күрес~.
Dialogue: 0,0:09:23.76,0:09:25.76,Default,,0,0,0,,Маған ұнайды.
Dialogue: 0,0:09:25.76,0:09:27.76,Default,,0,0,0,,Де~мо! Койойха….
Dialogue: 0,0:09:29.76,0:09:31.77,Default,,0,0,0,,Ура! ➡
Dialogue: 0,0:09:31.77,0:09:34.27,Default,,0,0,0,,Сіздің кезегіңіз! Челленджер.
Dialogue: 0,0:09:34.27,0:09:36.77,Default,,0,0,0,,О...о!
Dialogue: 0,0:09:36.77,0:09:38.81,Default,,0,0,0,,Мен Кагецу Якумомын➡
Dialogue: 0,0:09:38.81,0:09:41.78,Default,,0,0,0,,Күшті деген қауесет тараған көшбасшыны сынағым келеді.
Dialogue: 0,0:09:41.78,0:09:45.28,Default,,0,0,0,,Өтінемін, менімен күрес!
Dialogue: 0,0:09:45.28,0:09:48.28,Default,,0,0,0,,Сізді шақырып жатыр ма? көшбасшы.
Dialogue: 0,0:09:48.28,0:09:50.79,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:09:50.79,0:09:52.75,Default,,0,0,0,,А... сен мұны айтпадың ба?
Dialogue: 0,0:09:52.75,0:09:54.79,Default,,0,0,0,,Көшбасшы➡
Dialogue: 0,0:09:54.79,0:09:56.76,Default,,0,0,0,,Бұл Рука Мияко➡
Dialogue: 0,0:09:56.76,0:09:58.79,Default,,0,0,0,,Бұл біраз кінәлі сезім емес пе?
Dialogue: 0,0:09:58.79,0:10:00.83,Default,,0,0,0,,E?
Dialogue: 0,0:10:00.83,0:10:03.30,Default,,0,0,0,,Ех! Ууууу…. ))
Dialogue: 0,0:10:03.30,0:10:06.27,Default,,0,0,0,,Сіз Blackout тобының бірінші жетекшісін кездестірдіңіз бе?
Dialogue: 0,0:10:06.27,0:10:08.30,Default,,0,0,0,,Ах.
Dialogue: 0,0:10:08.30,0:10:10.27,Default,,0,0,0,,Адамдарды өзіне тартатын сүйкімділігі бар➡
Dialogue: 0,0:10:10.27,0:10:12.27,Default,,0,0,0,,Ол жұмбақ қыз еді.
Dialogue: 0,0:10:12.27,0:10:14.78,Default,,0,0,0,,Сонымен... төбелестің бе?
Dialogue: 0,0:10:14.78,0:10:16.74,Default,,0,0,0,,Әрине.
Dialogue: 0,0:10:17.85,0:10:19.78,Default,,0,0,0,,((Сәлем, балалар!➡
Dialogue: 0,0:10:19.78,0:10:22.78,Default,,0,0,0,,Бүгінгі кештің басты оқиғасы сендерсіңдер!
Dialogue: 0,0:10:22.78,0:10:24.79,Default,,0,0,0,,Жаса! Мияко.
Dialogue: 0,0:10:24.79,0:10:26.79,Default,,0,0,0,,Мияко-сан! Біраз тамақ ішейік.
Dialogue: 0,0:10:26.79,0:10:30.76,Default,,0,0,0,,Ей, менің командаластарым қан көп.
Dialogue: 0,0:10:30.76,0:10:33.26,Default,,0,0,0,,Менің де ұтылатын ойым жоқ.
Dialogue: 0,0:10:33.26,0:10:35.80,Default,,0,0,0,,Жеңіске жету үшін бар күшімді саламын!
Dialogue: 0,0:10:35.80,0:10:38.80,Default,,0,0,0,,Керемет~Мен оның қаншалықты ыстық болғанын жақсы көремін.
Dialogue: 0,0:10:38.80,0:10:41.27,Default,,0,0,0,,Қызықты ма? ➡
Dialogue: 0,0:10:41.27,0:10:43.27,Default,,0,0,0,,Біздің...карта төбелесіміз.
Dialogue: 0,0:10:44.27,0:10:46.34,Default,,0,0,0,,Ах! Қанекей мынаны істейік.
Dialogue: 0,0:10:46.34,0:10:49.78,Default,,0,0,0,,Авангард тұр! ))
Dialogue: 0,0:10:49.78,0:10:52.25,Default,,0,0,0,,Сонымен...Кэдже-кун, сен жеңдің бе?
Dialogue: 0,0:10:54.28,0:10:56.28,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:10:56.28,0:10:58.75,Default,,0,0,0,,Бұл толық жеңіліс болды.
Dialogue: 0,0:10:58.75,0:11:00.79,Default,,0,0,0,,Ол жел.
Dialogue: 0,0:11:00.79,0:11:02.76,Default,,0,0,0,,Бос болыңыз➡
Dialogue: 0,0:11:02.76,0:11:04.76,Default,,0,0,0,,Ағынмен жүріңіз➡
Dialogue: 0,0:11:04.76,0:11:07.30,Default,,0,0,0,,Ол тіпті әлемді өзгертеді.
Dialogue: 0,0:11:07.30,0:11:10.30,Default,,0,0,0,,Тіпті жанып тұрған жалын түгел жұтылады.
Dialogue: 0,0:11:11.27,0:11:14.27,Default,,0,0,0,,Бұрын көрмеген адам түрі➡
Dialogue: 0,0:11:14.27,0:11:16.27,Default,,0,0,0,,Ол күрескер болған.
Dialogue: 0,0:11:19.34,0:11:22.78,Default,,0,0,0,,((Жеңімпаз...Мияко Рука!
Dialogue: 0,0:11:22.78,0:11:26.28,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:26.28,0:11:29.25,Default,,0,0,0,,Көңілді жекпе-жек болды. рахмет.
Dialogue: 0,0:11:30.42,0:11:32.85,Default,,0,0,0,,)
Dialogue: 0,0:11:32.85,0:11:34.79,Default,,0,0,0,,((Еркін және тамаша➡
Dialogue: 0,0:11:34.79,0:11:37.36,Default,,0,0,0,,Ең бастысы➡
Dialogue: 0,0:11:37.36,0:11:39.29,Default,,0,0,0,,Әдемі…. ))
Dialogue: 0,0:11:39.29,0:11:41.26,Default,,0,0,0,,Ым?
Dialogue: 0,0:11:41.26,0:11:43.26,Default,,0,0,0,,Эй, сен сондай мықтысың➡
Dialogue: 0,0:11:43.26,0:11:45.27,Default,,0,0,0,,Неге кәсіпқой болмайсың?
Dialogue: 0,0:11:45.27,0:11:48.27,Default,,0,0,0,,Хмм...себебі сізді қызықтырмайды?
Dialogue: 0,0:11:48.27,0:11:51.34,Default,,0,0,0,,Мен қалай өмір сүргім келсе, солай өмір сүремін!
Dialogue: 0,0:11:51.34,0:11:55.28,Default,,0,0,0,,Сенің мықтысың ба, жоқ па маңызды емес пе?
Dialogue: 0,0:11:55.28,0:11:57.31,Default,,0,0,0,,Ең маңыздысы➡
Dialogue: 0,0:11:57.31,0:12:00.28,Default,,0,0,0,,Сіз қандай карта жекпе-жегін өткізгіңіз келеді?
Dialogue: 0,0:12:01.28,0:12:04.29,Default,,0,0,0,,Сіз неге Vanguard ойнайсыз?
Dialogue: 0,0:12:05.85,0:12:07.82,Default,,0,0,0,,A…. ))
Dialogue: 0,0:12:07.82,0:12:12.79,Default,,0,0,0,,Мен бірден жауап беруім керек еді деген жауап таба алмадым.
Dialogue: 0,0:12:13.80,0:12:17.77,Default,,0,0,0,,Мен көңілді болдым.
Dialogue: 0,0:12:17.77,0:12:20.80,Default,,0,0,0,,Жеңілуім керек болса да, бұл менің өмірімдегі ең жақсысы болды➡
Dialogue: 0,0:12:20.80,0:12:22.77,Default,,0,0,0,,Бұл қызықты карта ұрысы болды.
Dialogue: 0,0:12:24.34,0:12:26.37,Default,,0,0,0,,((Жауабын бір күні маған хабарлаңыз➡
Dialogue: 0,0:12:26.37,0:12:29.34,Default,,0,0,0,,Біз әрқашан осы жерде ұрысамыз. ))
Dialogue: 0,0:12:41.86,0:12:46.36,Default,,0,0,0,,((Blackout Wonderhill Merry-Go-Round➡
Dialogue: 0,0:12:46.36,0:12:48.83,Default,,0,0,0,,Лука Мияко…. ))
Dialogue: 0,0:12:49.80,0:12:53.30,Default,,0,0,0,,Осыдан кейін менің бар ойым одан кек алу болды➡
Dialogue: 0,0:12:53.30,0:12:55.80,Default,,0,0,0,,Авангардқа кірді.
Dialogue: 0,0:12:55.80,0:13:00.81,Default,,0,0,0,,Мен күшейіп, онымен сол уақыттан асып түсетін жекпе-жек өткізгім келеді.
Dialogue: 0,0:13:02.31,0:13:07.82,Default,,0,0,0,,Сосын мен тағы да сол ойын-сауық саябағына бардым.
Dialogue: 0,0:13:08.78,0:13:11.32,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:11.32,0:13:14.29,Default,,0,0,0,,Ол жоқ еді.
Dialogue: 0,0:13:15.32,0:13:18.79,Default,,0,0,0,,Еркін қыз қараңғыдан секіріп шығады➡
Dialogue: 0,0:13:18.79,0:13:20.76,Default,,0,0,0,,Ол саяхатқа кеткен сияқты.
Dialogue: 0,0:13:21.83,0:13:26.27,Default,,0,0,0,,Менің қайда бара жатқанымды ешкім білмейді, мен олармен байланыса алмаймын.
Dialogue: 0,0:13:26.27,0:13:28.30,Default,,0,0,0,,Жел сияқты➡
Dialogue: 0,0:13:28.30,0:13:30.81,Default,,0,0,0,,Бір жерде еркін жоғалып кетті.
Dialogue: 0,0:13:32.84,0:13:37.38,Default,,0,0,0,,((Неге...
Dialogue: 0,0:13:37.38,0:13:39.35,Default,,0,0,0,,Неге! ))
Dialogue: 0,0:13:51.43,0:13:55.40,Default,,0,0,0,,)
Dialogue: 0,0:13:59.80,0:14:04.31,Default,,0,0,0,,Мен сол бір жарқын карт төбелесін ойымнан шығара алмадым.
Dialogue: 0,0:14:05.27,0:14:07.31,Default,,0,0,0,,Онымен реваншты асыға күтемін➡
Dialogue: 0,0:14:07.31,0:14:11.28,Default,,0,0,0,,Басқа жекпе-жектерге деген қызығушылығым жоғала бастады.
Dialogue: 0,0:14:11.28,0:14:13.31,Default,,0,0,0,,Бұл бос қабық сияқты.
Dialogue: 0,0:14:13.31,0:14:17.79,Default,,0,0,0,,Мен бұдан былай кәсіпқой ретінде жалғастыра алмайтынымды түсіндім.
Dialogue: 0,0:14:17.79,0:14:21.79,Default,,0,0,0,,Мен күрескер ретінде өлдім...
Dialogue: 0,0:14:31.33,0:14:36.34,Default,,0,0,0,,((үйге барасыз ба?
Dialogue: 0,0:14:36.34,0:14:38.84,Default,,0,0,0,,Ұрыспайсың ба? ))
Dialogue: 0,0:14:39.81,0:14:44.81,Default,,0,0,0,,Мен кәсіби әлемнен ешқашан үміт үзген емеспін.
Dialogue: 0,0:14:44.81,0:14:49.28,Default,,0,0,0,,Мичиру Маварима деген керемет данышпан бар.
Dialogue: 0,0:14:49.28,0:14:51.25,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:52.35,0:14:54.29,Default,,0,0,0,,((Мен үшін қазірдің өзінде ➡
Dialogue: 0,0:14:54.29,0:14:57.79,Default,,0,0,0,,Мен сенімен күресуге жарамсызмын.
Dialogue: 0,0:14:57.79,0:14:59.79,Default,,0,0,0,,Мені жақсы көретін карта күресі➡
Dialogue: 0,0:14:59.79,0:15:02.76,Default,,0,0,0,,Кәсіби әлемде жоқ.
Dialogue: 0,0:15:02.76,0:15:04.80,Default,,0,0,0,,Сонымен... ол қайда?
Dialogue: 0,0:15:04.80,0:15:09.30,Default,,0,0,0,,Каганың Блэкаут командасының аты қараңғылық.
Dialogue: 0,0:15:09.30,0:15:13.78,Default,,0,0,0,,Мен сүйсінген карта күресі болды.
Dialogue: 0,0:15:13.78,0:15:16.78,Default,,0,0,0,,Енді мен енді білмеймін...
Dialogue: 0,0:15:18.78,0:15:21.85,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:15:21.85,0:15:23.85,Default,,0,0,0,,Өшіру…. ))
Dialogue: 0,0:15:24.79,0:15:27.82,Default,,0,0,0,,Қалғанын өздеріңіз білесіздер.
Dialogue: 0,0:15:27.82,0:15:30.83,Default,,0,0,0,,Университетке түсіп, Токиоға көшіңіз➡
Dialogue: 0,0:15:30.83,0:15:33.83,Default,,0,0,0,,Өйткені маған карточкамен төбелесуді үйреткен ұнады➡
Dialogue: 0,0:15:33.83,0:15:36.76,Default,,0,0,0,,Тыныш қалада Авангард сыныбын ашыңыз➡
Dialogue: 0,0:15:36.76,0:15:39.27,Default,,0,0,0,,Дәл қазір сияқты.
Dialogue: 0,0:15:40.30,0:15:44.34,Default,,0,0,0,,Сол сәттен бастап менің уақытым тоқтады.
Dialogue: 0,0:15:44.34,0:15:47.31,Default,,0,0,0,,Міне, сондықтан да мен бұл туралы ойға шомып жүрмін.
Dialogue: 0,0:15:48.28,0:15:51.28,Default,,0,0,0,,Сол адамға қарсы жеңіске жету үшін күрес.
Dialogue: 0,0:15:51.28,0:15:55.78,Default,,0,0,0,,Көп рет...
Dialogue: 0,0:15:55.78,0:15:57.75,Default,,0,0,0,,Көп рет!
Dialogue: 0,0:16:01.29,0:16:03.76,Default,,0,0,0,,Енді...күресті жалғастырайық.
Dialogue: 0,0:16:04.79,0:16:08.30,Default,,0,0,0,,Persona Ride Veizroug➡
Dialogue: 0,0:16:08.30,0:16:10.26,Default,,0,0,0,,Ай қақпасын іске қосу.
Dialogue: 0,0:16:10.26,0:16:12.27,Default,,0,0,0,,Розтонирге➡ қоңырау шалыңыз
Dialogue: 0,0:16:12.27,0:16:14.84,Default,,0,0,0,,Тапсырыс аймағына бір картаны орналастырыңыз.
Dialogue: 0,0:16:14.84,0:16:18.81,Default,,0,0,0,,Сонымен қатар, Vazeroug шеберлігін пайдаланып, Ай қақпасын тағы бір рет іске қосыңыз.
Dialogue: 0,0:16:19.81,0:16:23.78,Default,,0,0,0,,Revnologue-ге қоңырау шалыңыз және тапсырыс аймағына бір картаны салыңыз.
Dialogue: 0,0:16:23.78,0:16:26.28,Default,,0,0,0,,Екі ревнологты шақырыңыз.
Dialogue: 0,0:16:26.28,0:16:29.32,Default,,0,0,0,,Ailift Gourmani пайдаланыңыз.
Dialogue: 0,0:16:29.32,0:16:33.32,Default,,0,0,0,,Осы бұрылыс кезінде Phantom Shinju-ға 5000 қуат қосыңыз.
Dialogue: 0,0:16:33.32,0:16:36.29,Default,,0,0,0,,Егер ол шеберлікпен көрінсе, тағы 5000 қосыңыз.
Dialogue: 0,0:16:36.29,0:16:39.29,Default,,0,0,0,,Розтонирмен Ракшаса мен Шуураға шабуыл жасаңыз.
Dialogue: 0,0:16:39.29,0:16:41.26,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:16:42.30,0:16:45.27,Default,,0,0,0,,Вазеругпен авангардқа шабуыл жасаңыз.
Dialogue: 0,0:16:45.27,0:16:47.27,Default,,0,0,0,,Дағдыны белсендіру.
Dialogue: 0,0:16:47.27,0:16:50.27,Default,,0,0,0,,Тапсырыс аймағынан Revnologue-ге қоңырау шалыңыз.
Dialogue: 0,0:16:50.27,0:16:52.31,Default,,0,0,0,,Әрі қарай….
Dialogue: 0,0:16:52.31,0:16:55.78,Default,,0,0,0,,Даусымды естісеңіз, ➡ жауап беріңіз
Dialogue: 0,0:16:55.78,0:16:57.78,Default,,0,0,0,,Екінші ата ретінде➡
Dialogue: 0,0:16:57.78,0:17:00.31,Default,,0,0,0,,Иллюзия жетекші патша ретінде.
Dialogue: 0,0:17:00.31,0:17:04.29,Default,,0,0,0,,Дүниені дүр сілкіндірген нағыз аң.
Dialogue: 0,0:17:04.29,0:17:06.29,Default,,0,0,0,,Қоңырау шалыңыз!
Dialogue: 0,0:17:06.29,0:17:08.32,Default,,0,0,0,,Екінші иллюзиондық аң➡
Dialogue: 0,0:17:08.32,0:17:11.29,Default,,0,0,0,,Сейсмикалық жылан патшасы Гардс Ормус!
Dialogue: 0,0:17:13.29,0:17:15.80,Default,,0,0,0,,Gards Ormus шеберлігін белсендіру.
Dialogue: 0,0:17:15.80,0:17:18.77,Default,,0,0,0,,Бұл карта сіздің қарсыласыңыздың келесі айналымының соңына дейін сақталады➡
Dialogue: 0,0:17:18.77,0:17:20.80,Default,,0,0,0,,Қарсыластың әсерімен таңдалмаған➡
Dialogue: 0,0:17:20.80,0:17:22.80,Default,,0,0,0,,Артқы қатардан шабуыл жасай алады.
Dialogue: 0,0:17:22.80,0:17:24.81,Default,,0,0,0,,Қосымша шабуыл? Мұнда...
Dialogue: 0,0:17:24.81,0:17:26.81,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:17:26.81,0:17:30.28,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:17:30.28,0:17:32.28,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:17:32.28,0:17:34.28,Default,,0,0,0,,Критикалық триггер.
Dialogue: 0,0:17:34.28,0:17:36.32,Default,,0,0,0,,Ревнологтың күші плюс 10 000.
Dialogue: 0,0:17:36.32,0:17:39.29,Default,,0,0,0,,Тағы бір Revnologue сыни +1.
Dialogue: 0,0:17:41.29,0:17:43.29,Default,,0,0,0,,Ревнологпен шабуыл.
Dialogue: 0,0:17:43.29,0:17:46.33,Default,,0,0,0,,Мұнда да толық күзет!
Dialogue: 0,0:17:46.33,0:17:49.26,Default,,0,0,0,,Гардс Ормус бұрылыс кезінде тапсырыс ➡ арқылы
Dialogue: 0,0:17:49.26,0:17:52.77,Default,,0,0,0,,Қуат плюс 15 000.
Dialogue: 0,0:17:52.77,0:17:56.27,Default,,0,0,0,,Гардс Ормуспен авангардқа шабуыл жасаңыз.
Dialogue: 0,0:17:57.31,0:18:01.81,Default,,0,0,0,,Бұл... менің елес нағыз аңдарымның ішіндегі ең күштісі.
Dialogue: 0,0:18:02.81,0:18:05.81,Default,,0,0,0,,Екінші ата, айдаһар және жылан.
Dialogue: 0,0:18:14.32,0:18:17.29,Default,,0,0,0,,Айдың сынағы Осымен сот процесі аяқталады.
Dialogue: 0,0:18:20.86,0:18:22.80,Default,,0,0,0,,((Шынымен күшті...
Dialogue: 0,0:18:22.80,0:18:25.83,Default,,0,0,0,,Тіпті кәсіпқой ретінде майданнан зейнеткерлікке шыққаннан кейін де➡
Dialogue: 0,0:18:25.83,0:18:27.84,Default,,0,0,0,,Ол әрқашан данышпан болып қала береді. ))
Dialogue: 0,0:18:30.27,0:18:32.34,Default,,0,0,0,,Каге-кун.
Dialogue: 0,0:18:32.34,0:18:35.31,Default,,0,0,0,,Сізден тағы бір рет сұрасам болады ма? Un?
Dialogue: 0,0:18:35.31,0:18:37.31,Default,,0,0,0,,Неліктен Deluxe-де шығуды шештіңіз?
Dialogue: 0,0:18:39.78,0:18:42.32,Default,,0,0,0,,Дұрыс, мен...
Dialogue: 0,0:18:42.32,0:18:45.79,Default,,0,0,0,,Мен жай ғана Акинаны жалғыз қалдыра алмадым.
Dialogue: 0,0:18:47.32,0:18:50.29,Default,,0,0,0,,Мүмкін мен онымен санадан тыс сәйкестенген шығармын.
Dialogue: 0,0:18:51.36,0:18:54.80,Default,,0,0,0,,Түсіндім... шеберлер туралы да көп нәрсе бар.
Dialogue: 0,0:18:54.80,0:18:57.80,Default,,0,0,0,,Сондықтан мен қожайыныма тоқта деп айттым.
Dialogue: 0,0:18:57.80,0:19:00.77,Default,,0,0,0,,Бірақ мен шеберге ұқсайтын бір нәрсені істеймін деп ойлаймын.
Dialogue: 0,0:19:00.77,0:19:02.77,Default,,0,0,0,,Хмм...не?
Dialogue: 0,0:19:02.77,0:19:04.77,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:04.77,0:19:07.27,Default,,0,0,0,,Мен оны Нао-чанға беремін.
Dialogue: 0,0:19:08.28,0:19:10.28,Default,,0,0,0,,​​Бұл….
Dialogue: 0,0:19:14.35,0:19:16.35,Default,,0,0,0,,((Кәсіби мансапты тастағаннан кейін де➡
Dialogue: 0,0:19:16.35,0:19:18.85,Default,,0,0,0,,Мен Авангардтан кете алмадым. ))
Dialogue: 0,0:19:18.85,0:19:22.29,Default,,0,0,0,,((Мен оған қойған сұрақ➡
Dialogue: 0,0:19:22.29,0:19:25.36,Default,,0,0,0,,Мияко Лукаға жауап бере алмаған сұраққа➡
Dialogue: 0,0:19:25.36,0:19:27.83,Default,,0,0,0,,Мен өзім жауап беруім керек. ))
Dialogue: 0,0:19:29.43,0:19:31.43,Default,,0,0,0,,)
Dialogue: 0,0:19:35.44,0:19:38.44,Default,,0,0,0,,)
Dialogue: 0,0:19:38.44,0:19:42.41,Default,,0,0,0,,)
Dialogue: 0,0:19:43.41,0:19:46.91,Default,,0,0,0,,)
Dialogue: 0,0:19:47.92,0:19:50.42,Default,,0,0,0,,)
Dialogue: 0,0:19:50.42,0:19:52.92,Default,,0,0,0,,)
Dialogue: 0,0:19:53.92,0:19:56.39,Default,,0,0,0,,)
Dialogue: 0,0:19:57.43,0:20:00.90,Default,,0,0,0,,)
Dialogue: 0,0:20:04.27,0:20:06.30,Default,,0,0,0,,Аз да болса жарық➡
Dialogue: 0,0:20:06.30,0:20:09.80,Default,,0,0,0,,Керемет тек қолын созғанға келеді...
Dialogue: 0,0:20:11.31,0:20:13.27,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:20:14.78,0:20:17.28,Default,,0,0,0,,Сәлем….
Dialogue: 0,0:20:17.28,0:20:19.78,Default,,0,0,0,,Акинамен күресейік.
Dialogue: 0,0:20:20.78,0:20:22.78,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:20:22.78,0:20:24.75,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:20:26.39,0:20:30.29,Default,,0,0,0,,((Кицуне Шиба Лайканың соңғы бір жылдағы ресми матчтарының кадрлары: ➡
Dialogue: 0,0:20:30.29,0:20:32.86,Default,,0,0,0,,Барлығы жатталған➡
Dialogue: 0,0:20:32.86,0:20:34.86,Default,,0,0,0,,Жеңіле берсең бітпейді! ))
Dialogue: 0,0:20:53.31,0:20:56.28,Default,,0,0,0,,2 ойында жеңілгеннен кейін финалдық турнирге шығу мүмкіндігіңіз қандай?➡
Dialogue: 0,0:20:56.28,0:20:58.29,Default,,0,0,0,,Өте аз➡
Dialogue: 0,0:20:58.29,0:21:00.29,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:21:00.29,0:21:03.29,Default,,0,0,0,,Қалай болғанда да, біз жеңмейінше ол басталмайды ➡
Dialogue: 0,0:21:03.29,0:21:05.83,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:21:05.83,0:21:09.76,Default,,0,0,0,,Сенің мүлде берілмегеніңе көңілім толды➡
Dialogue: 0,0:21:09.76,0:21:11.83,Default,,0,0,0,,Бұл сендіреді.
Dialogue: 0,0:21:11.83,0:21:14.77,Default,,0,0,0,,Deluxe мен үшін ерекше.
Dialogue: 0,0:21:14.77,0:21:16.84,Default,,0,0,0,,(Буши) «Маған қара!» (Эмими) «Маған қара!»
Dialogue: 0,0:21:16.84,0:21:20.31,Default,,0,0,0,,Өйткені мен бас тартуда әрқашан нашармын!
Dialogue: 0,0:21:21.31,0:21:24.78,Default,,0,0,0,,Іріктеу кезеңіне бір күн қалды.
Dialogue: 0,0:21:24.78,0:21:26.78,Default,,0,0,0,,Кагецу Якумо➡
Dialogue: 0,0:21:26.78,0:21:29.28,Default,,0,0,0,,Гай ол туралы не ойлайды?
Dialogue: 0,0:21:29.28,0:21:32.32,Default,,0,0,0,,Салыстыру үшін деректер аз болса да➡
Dialogue: 0,0:21:32.32,0:21:35.29,Default,,0,0,0,,Әрине, ол кәсіпқой ретінде әлемді жаулап алған уақыттан бері➡
Dialogue: 0,0:21:35.29,0:21:37.32,Default,,0,0,0,,әлдеқайда күшті.
Dialogue: 0,0:21:37.32,0:21:41.30,Default,,0,0,0,,Керемет...ұйқыдағы арыстанды ояттық.
Dialogue: 0,0:21:41.30,0:21:43.76,Default,,0,0,0,,Хехе...бірақ➡
Dialogue: 0,0:21:43.76,0:21:46.27,Default,,0,0,0,,Не болатынын білмеймін➡
Dialogue: 0,0:21:46.27,0:21:48.27,Default,,0,0,0,,Бұл Авангард.
Dialogue: 0,0:21:52.27,0:21:54.28,Default,,0,0,0,,Ақыры осында.
Dialogue: 0,0:21:55.78,0:21:58.28,Default,,0,0,0,,Жасайық...бала.
Dialogue: 0,0:22:06.79,0:22:09.29,Default,,0,0,0,,Жарайды….
Dialogue: 0,0:22:09.29,0:22:11.29,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:22:12.79,0:22:18.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory