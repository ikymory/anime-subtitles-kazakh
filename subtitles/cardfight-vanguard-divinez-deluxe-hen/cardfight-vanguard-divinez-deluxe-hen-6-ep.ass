Dialogue: 0,0:00:10.41,0:00:14.41,Default,,0,0,0,,)
Dialogue: 0,0:00:15.41,0:00:17.91,Default,,0,0,0,,)
Dialogue: 0,0:00:40.34,0:00:43.81,Default,,0,0,0,,((Осы дүниеде өмір сүру.
Dialogue: 0,0:00:43.81,0:00:46.34,Default,,0,0,0,,Мейдо Хикари емес➡
Dialogue: 0,0:00:46.34,0:00:48.34,Default,,0,0,0,,Эрика Миоджо ретінде. ))
Dialogue: 0,0:00:50.85,0:00:52.78,Default,,0,0,0,,((Сол себепті➡
Dialogue: 0,0:00:52.78,0:00:55.35,Default,,0,0,0,,Осы люксті ұтып алыңыз➡
Dialogue: 0,0:00:55.35,0:00:57.32,Default,,0,0,0,,Кәсіби маман болу. ))
Dialogue: 0,0:02:31.78,0:02:34.78,Default,,0,0,0,,Хмм….
Dialogue: 0,0:02:34.78,0:02:36.79,Default,,0,0,0,,Сіз не істеп жатырсыз? а….
Dialogue: 0,0:02:36.79,0:02:39.25,Default,,0,0,0,,Өйткені бұл Хикари емес еді...➡
Dialogue: 0,0:02:39.25,0:02:41.76,Default,,0,0,0,,Бұл Эрика мен Нао-сенпайдың ұрысы, солай ма?
Dialogue: 0,0:02:41.76,0:02:44.29,Default,,0,0,0,,Мен қай жағын қолдауым керек?
Dialogue: 0,0:02:44.29,0:02:46.26,Default,,0,0,0,,Екеуінің де болғаны жақсы емес пе?
Dialogue: 0,0:02:46.26,0:02:48.76,Default,,0,0,0,,Жарайды ма? Қалай болғанда да.
Dialogue: 0,0:02:48.76,0:02:52.27,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:02:53.77,0:02:55.77,Default,,0,0,0,,Ым?
Dialogue: 0,0:02:55.77,0:02:57.81,Default,,0,0,0,,Шындық осында.
Dialogue: 0,0:02:57.81,0:03:02.31,Default,,0,0,0,,Уайымдамаңыз, мен осы люксті ұтып алуды мақсат етемін.
Dialogue: 0,0:03:02.31,0:03:06.31,Default,,0,0,0,,Сіз кәсіби емтиханнан жартылай босатылу құқығын қалайсыз, солай ма?
Dialogue: 0,0:03:06.31,0:03:09.32,Default,,0,0,0,,Егер ірі ресми турнирде нәтиже болса➡
Dialogue: 0,0:03:09.32,0:03:12.29,Default,,0,0,0,,Сіздің кәсіби біліктілік алу мүмкіндігіңіз бірден артады.
Dialogue: 0,0:03:12.29,0:03:14.82,Default,,0,0,0,,Мен сіздің мотивацияңызды түсінемін➡
Dialogue: 0,0:03:14.82,0:03:18.26,Default,,0,0,0,,Ең алдымен үлкен сахнада тәжірибе жинақтау маңызды.
Dialogue: 0,0:03:18.26,0:03:20.76,Default,,0,0,0,,Сондықтан мен сізге шақыруды бердім➡
Dialogue: 0,0:03:20.76,0:03:23.30,Default,,0,0,0,,Көп уайымдамаңыз.
Dialogue: 0,0:03:23.30,0:03:27.34,Default,,0,0,0,,Біз біреудің мейіріміне мәңгі тәуелді бола алмаймыз.
Dialogue: 0,0:03:27.34,0:03:29.27,Default,,0,0,0,,Өз бетіңізше тез ақша табу мүмкіндігіне ие болыңыз➡
Dialogue: 0,0:03:29.27,0:03:31.27,Default,,0,0,0,,Тәуелсіз болуы керек.
Dialogue: 0,0:03:31.27,0:03:34.78,Default,,0,0,0,,Түсіндім...егер сіз қаласаңыз➡
Dialogue: 0,0:03:34.78,0:03:36.78,Default,,0,0,0,,Сіз барынша тырысуыңыз керек.
Dialogue: 0,0:03:36.78,0:03:40.78,Default,,0,0,0,,Сонымен қатар, Deluxe-дегі жеңіс менікі...
Dialogue: 0,0:03:40.78,0:03:43.79,Default,,0,0,0,,Ым? Жоқ... ештеңе.
Dialogue: 0,0:03:43.79,0:03:45.79,Default,,0,0,0,,Мен барамын.
Dialogue: 0,0:03:48.76,0:03:51.79,Default,,0,0,0,,Бастауды қалай дамыту керек➡
Dialogue: 0,0:03:51.79,0:03:55.76,Default,,0,0,0,,Мен оның матчтың бұрылысында жарымжан болғанын қаламаймын...
Dialogue: 0,0:03:55.76,0:03:58.30,Default,,0,0,0,,Хмм….
Dialogue: 0,0:03:58.30,0:04:02.30,Default,,0,0,0,,Хмм...сен мұнда не үшін келдің?
Dialogue: 0,0:04:02.30,0:04:04.81,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:04:04.81,0:04:06.81,Default,,0,0,0,,Ол қазірдің өзінде тамаша формада!
Dialogue: 0,0:04:06.81,0:04:09.81,Default,,0,0,0,,Каге-кун қазір сені жеңе алатын сияқты!
Dialogue: 0,0:04:09.81,0:04:13.28,Default,,0,0,0,,100 жыл Бұл тез. Оған шамамен 10 жыл беріңіз!
Dialogue: 0,0:04:13.28,0:04:15.78,Default,,0,0,0,,Ой!
Dialogue: 0,0:04:15.78,0:04:17.79,Default,,0,0,0,,...және шынымен бе?
Dialogue: 0,0:04:17.79,0:04:19.79,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:04:19.79,0:04:22.76,Default,,0,0,0,,Шынымды айтсам, мен қатты қобалжыдым.
Dialogue: 0,0:04:22.76,0:04:25.79,Default,,0,0,0,,Қорқынышты ма? Бұл қорқынышты.
Dialogue: 0,0:04:25.79,0:04:29.80,Default,,0,0,0,,Әуесқой кезімде жақсы нәтижеге қол жеткізгенде мені мақтады.➡
Dialogue: 0,0:04:29.80,0:04:33.30,Default,,0,0,0,,Нәтижесі нашар болғанда, оларға мән берілмеді.
Dialogue: 0,0:04:33.30,0:04:35.77,Default,,0,0,0,,Ашығын айтқанда, бұл өзімнің жаман ойыным➡
Dialogue: 0,0:04:35.77,0:04:38.31,Default,,0,0,0,,Бұл менің көрінуімнің қажеті жоқ дегенді де білдірді.
Dialogue: 0,0:04:38.31,0:04:41.31,Default,,0,0,0,,Бірақ кәсіби әлемде жақсы пьесалар да, жаман пьесалар да бар➡
Dialogue: 0,0:04:41.31,0:04:44.78,Default,,0,0,0,,Көп адамдар маған қарап, мен не қаласам, соны айтады.
Dialogue: 0,0:04:45.78,0:04:48.82,Default,,0,0,0,,Әрбір қимыл керемет ауыр.
Dialogue: 0,0:04:48.82,0:04:51.32,Default,,0,0,0,,Менің ойым шиеленіске байланысты тербеледі...
Dialogue: 0,0:04:52.82,0:04:56.76,Default,,0,0,0,,Бірақ бұл мен қалаған дүние➡
Dialogue: 0,0:04:56.76,0:04:59.76,Default,,0,0,0,,Бұл да өте қызық.
Dialogue: 0,0:04:59.76,0:05:02.30,Default,,0,0,0,,Аа... түсіндім➡
Dialogue: 0,0:05:02.30,0:05:04.77,Default,,0,0,0,,Олай болса көңіліңізден шыққанша ләззат алыңыз.
Dialogue: 0,0:05:04.77,0:05:07.27,Default,,0,0,0,,Ум! Мен одан ләззат аламын.
Dialogue: 0,0:05:09.77,0:05:11.77,Default,,0,0,0,,Сәлем! Жігіттер➡
Dialogue: 0,0:05:11.77,0:05:13.78,Default,,0,0,0,,Бұдан былай, Алдын ала A➡ тобы
Dialogue: 0,0:05:13.78,0:05:16.81,Default,,0,0,0,,Екінші ойынды бастайық!
Dialogue: 0,0:05:16.81,0:05:20.78,Default,,0,0,0,,Бұл жолы Seizo Anchor Bolt өкілі ретінде қатысатын адам➡
Dialogue: 0,0:05:20.78,0:05:23.82,Default,,0,0,0,,Амал жоқ, амал жоқ, асыл бала! ➡
Dialogue: 0,0:05:23.82,0:05:27.76,Default,,0,0,0,,Ірі компаниялардың құпия қаруы. Ол қаншалықты күшті?
Dialogue: 0,0:05:27.76,0:05:30.83,Default,,0,0,0,,Эрика Миоджо!
Dialogue: 0,0:05:30.83,0:05:35.26,Default,,0,0,0,,Оған қарсы өткен жылы кәсіби дебютін жасаған Рю! ➡
Dialogue: 0,0:05:35.26,0:05:37.77,Default,,0,0,0,,Кезінде вундеркинд бала атанған данышпан➡
Dialogue: 0,0:05:37.77,0:05:41.27,Default,,0,0,0,,Осы люкске өтініш беріңіз! ➡
Dialogue: 0,0:05:41.27,0:05:43.77,Default,,0,0,0,,Инбенбен Нао~!
Dialogue: 0,0:05:45.77,0:05:47.74,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:05:50.28,0:05:52.81,Default,,0,0,0,,Білесіз бе... Эрика-чан➡ үшін бір ғана нәрсе
Dialogue: 0,0:05:52.81,0:05:56.28,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім, жақсы ма?
Dialogue: 0,0:05:56.28,0:05:59.29,Default,,0,0,0,,Мм? Білетін шығарсыз ➡
Dialogue: 0,0:05:59.29,0:06:03.26,Default,,0,0,0,,Авангард Акиге мен үйреткенмін, солай ма?
Dialogue: 0,0:06:03.26,0:06:05.29,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:06:05.29,0:06:08.76,Default,,0,0,0,,Әрине, тағдырлас кездесуде Аки жеңіп, алға шықты➡
Dialogue: 0,0:06:08.76,0:06:11.30,Default,,0,0,0,,Өйткені Акидің өзі барын салды.
Dialogue: 0,0:06:11.30,0:06:14.30,Default,,0,0,0,,Мен оны сәл артқа итеріп жібердім.
Dialogue: 0,0:06:14.30,0:06:16.77,Default,,0,0,0,,Бірақ бәрібір➡
Dialogue: 0,0:06:16.77,0:06:19.31,Default,,0,0,0,,Эрика әлемінде не болды➡
Dialogue: 0,0:06:19.31,0:06:23.28,Default,,0,0,0,,Кейде мен де туыс емеспін бе деп ойлаймын.
Dialogue: 0,0:06:23.28,0:06:26.78,Default,,0,0,0,,Сондықтан мен оны әрқашан естігім келді.
Dialogue: 0,0:06:26.78,0:06:32.29,Default,,0,0,0,,Сен... мені жек көресің бе?
Dialogue: 0,0:06:32.29,0:06:34.29,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:06:34.29,0:06:36.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:36.29,0:06:39.76,Default,,0,0,0,,Бірақ мен ризашылығымды білдіретін нәрселер бар. жұмысшы?
Dialogue: 0,0:06:39.76,0:06:42.33,Default,,0,0,0,,Інім орта мектепке барған кезде➡
Dialogue: 0,0:06:42.33,0:06:46.33,Default,,0,0,0,,Ол маған толық емес жұмысқа кірісетінін айтқанда, мен алаңдадым.
Dialogue: 0,0:06:46.33,0:06:49.77,Default,,0,0,0,,Менің ағам қазірдің өзінде менімен және үймен айналысады➡
Dialogue: 0,0:06:49.77,0:06:51.81,Default,,0,0,0,,Егер жағдай қиындай түссе➡
Dialogue: 0,0:06:51.81,0:06:54.81,Default,,0,0,0,,Менде ақыл-ой кеңістігі жетіспейді деп қорқамын.
Dialogue: 0,0:06:56.28,0:07:00.28,Default,,0,0,0,,Сосын мен оның толық емес жұмыс күні туралы сұраған кезім болды➡
Dialogue: 0,0:07:00.28,0:07:02.28,Default,,0,0,0,,Сосын, үлкен аға➡
Dialogue: 0,0:07:02.28,0:07:05.32,Default,,0,0,0,,Менің толық емес жұмыс күнімдегі аға буыным керемет! Немесе ➡
Dialogue: 0,0:07:05.32,0:07:08.29,Default,,0,0,0,,Міне, мен бүгін білдім! Сол туралы сөйлесіңіз➡
Dialogue: 0,0:07:08.29,0:07:10.26,Default,,0,0,0,,Ол көңілді жүргендей көріне бастады.
Dialogue: 0,0:07:11.29,0:07:14.76,Default,,0,0,0,,Бәлкім, ағамның күлімсіреп, толық емес жұмыс күнін жалғастыруының себебі шығар➡
Dialogue: 0,0:07:14.76,0:07:16.80,Default,,0,0,0,,Наоға рахмет.
Dialogue: 0,0:07:16.80,0:07:18.83,Default,,0,0,0,,Эрика-чан...
Dialogue: 0,0:07:18.83,0:07:22.27,Default,,0,0,0,,Наоның мен туралы ескертулері болса➡
Dialogue: 0,0:07:22.27,0:07:24.27,Default,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:07:24.27,0:07:27.78,Default,,0,0,0,,Екеуміз де көздеген мақсат үшін күресейік.
Dialogue: 0,0:07:27.78,0:07:29.78,Default,,0,0,0,,Рахмет Эрика-чан➡
Dialogue: 0,0:07:29.78,0:07:31.81,Default,,0,0,0,,Мен өзімді сәл жақсы сезінемін.
Dialogue: 0,0:07:31.81,0:07:35.78,Default,,0,0,0,,Әрине, мен өзімді ұстамаймын! Ха….
Dialogue: 0,0:07:35.78,0:07:40.79,Default,,0,0,0,,Енді...Алдын ала А тобының 2-ші ойыны➡
Dialogue: 0,0:07:40.79,0:07:42.76,Default,,0,0,0,,Фай!
Dialogue: 0,0:07:46.76,0:07:49.26,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:07:49.26,0:07:51.80,Default,,0,0,0,,Сыбызғышы Бирниста.
Dialogue: 0,0:07:51.80,0:07:54.27,Default,,0,0,0,,Ыстық ауаның жүзі Алдато.
Dialogue: 0,0:07:54.27,0:07:56.77,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:07:56.77,0:07:59.77,Default,,0,0,0,,Адольфқа бару Бұрылыстың соңы.
Dialogue: 0,0:07:59.77,0:08:03.28,Default,,0,0,0,,Менің кезегім Блеззанбарға міну➡
Dialogue: 0,0:08:03.28,0:08:05.28,Default,,0,0,0,,Блэйз Занбармен шабуыл.
Dialogue: 0,0:08:05.28,0:08:07.78,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:08:07.78,0:08:11.29,Default,,0,0,0,,Менің кезегім Эльгенияға міну➡
Dialogue: 0,0:08:11.29,0:08:15.26,Default,,0,0,0,,2 картаны тарту және 1 картаны тастау дағдысын пайдаланыңыз.
Dialogue: 0,0:08:15.26,0:08:18.26,Default,,0,0,0,,Эльгенияға қоңырау шалу арқылы Гурагаонға шабуыл жасаңыз.
Dialogue: 0,0:08:18.26,0:08:21.26,Default,,0,0,0,,Күзетші. Гурагаонмен шабуыл.
Dialogue: 0,0:08:21.26,0:08:23.26,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:08:23.26,0:08:26.80,Default,,0,0,0,,Сіз оңай зиян келтірмейсіз бе?
Dialogue: 0,0:08:26.80,0:08:31.31,Default,,0,0,0,,Мен соңғы шабуыл жасадым, сондықтан олардың толық қуатын бірінші болып аламын➡
Dialogue: 0,0:08:31.31,0:08:34.28,Default,,0,0,0,,Қызық, мен осындай арзан шабуылдан аман шыға аламын ба?
Dialogue: 0,0:08:34.28,0:08:37.28,Default,,0,0,0,,Иә? Менің кезегім ➡
Dialogue: 0,0:08:37.28,0:08:39.28,Default,,0,0,0,,Боулдер балтасына міну➡
Dialogue: 0,0:08:39.28,0:08:41.28,Default,,0,0,0,,Блейз Занбарды шеберлікпен шақыр.
Dialogue: 0,0:08:41.28,0:08:43.28,Default,,0,0,0,,Боулдер балтасымен шабуыл!
Dialogue: 0,0:08:43.28,0:08:45.79,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:08:45.79,0:08:47.76,Default,,0,0,0,,Айтпақшы, Нао-сан➡
Dialogue: 0,0:08:47.76,0:08:49.76,Default,,0,0,0,,Менің де сізден сұрайын дегенім бар еді.
Dialogue: 0,0:08:49.76,0:08:51.79,Default,,0,0,0,,E...не?
Dialogue: 0,0:08:51.79,0:08:54.76,Default,,0,0,0,,Әйтеуір, Акинамен қарым-қатынасыңыз ілгерілей ме?
Dialogue: 0,0:08:54.76,0:08:56.77,Default,,0,0,0,,E! Егер мен Нао болсам➡
Dialogue: 0,0:08:56.77,0:08:58.77,Default,,0,0,0,,Мен мұны мойындау дұрыс деп ойлаймын.
Dialogue: 0,0:08:58.77,0:09:01.30,Default,,0,0,0,,Тоқта... кенет, сен не айтып тұрсың?
Dialogue: 0,0:09:01.30,0:09:03.77,Default,,0,0,0,,Міне, сіз айтып отырсыз.
Dialogue: 0,0:09:03.77,0:09:06.31,Default,,0,0,0,,Не... нені айтып тұрсың?
Dialogue: 0,0:09:06.31,0:09:09.78,Default,,0,0,0,,Саған ұнамаса, мен аламын.
Dialogue: 0,0:09:09.78,0:09:11.78,Default,,0,0,0,,Сен нені айтып тұрсың?
Dialogue: 0,0:09:11.78,0:09:15.78,Default,,0,0,0,,Хехехе...Мен әзілдеп тұрмын. Хмм….
Dialogue: 0,0:09:15.78,0:09:18.79,Default,,0,0,0,,Ху... карта ақымақтар мен ақкөңіл ақымақтар➡
Dialogue: 0,0:09:18.79,0:09:21.82,Default,,0,0,0,,Прогресс қиын ба? Un?
Dialogue: 0,0:09:21.82,0:09:25.79,Default,,0,0,0,,Кешіріңіз, уайымдамаңыз, мен тек қызықпын.
Dialogue: 0,0:09:25.79,0:09:29.76,Default,,0,0,0,,Өйткені бұдан былай тыныс алуға уақыт жоқ!
Dialogue: 0,0:09:29.76,0:09:31.80,Default,,0,0,0,,А…. Менің кезегім ➡
Dialogue: 0,0:09:31.80,0:09:35.30,Default,,0,0,0,,Болашаққа деген жігер қанаттары осында! ➡
Dialogue: 0,0:09:35.30,0:09:39.31,Default,,0,0,0,,Амортаның барабанына мініңіз, уақыт тағдыры!
Dialogue: 0,0:09:48.78,0:09:51.32,Default,,0,0,0,,Дағды бойынша тамшыдан 3 дана➡
Dialogue: 0,0:09:51.32,0:09:55.29,Default,,0,0,0,,Палубаның төменгі жағына қайтару арқылы 1 картаны салыңыз➡
Dialogue: 0,0:09:55.29,0:09:58.79,Default,,0,0,0,,Қоңырау тізбегі Осы дағдымен Идилусқа қоңырау шалыңыз➡
Dialogue: 0,0:09:58.79,0:10:00.76,Default,,0,0,0,,Истияға қоңырау шалыңыз.
Dialogue: 0,0:10:00.76,0:10:03.77,Default,,0,0,0,,Идилуспен шабуыл! күзетші.
Dialogue: 0,0:10:03.77,0:10:07.27,Default,,0,0,0,,Reel Amorta көмегімен авангардқа шабуыл жасаңыз! ➡
Dialogue: 0,0:10:07.27,0:10:10.81,Default,,0,0,0,,Дағдыны белсендіру Idylus➡ байланыстыру арқылы
Dialogue: 0,0:10:10.81,0:10:13.78,Default,,0,0,0,,Палубадан басқа Идилусқа қоңырау шалыңыз➡
Dialogue: 0,0:10:13.78,0:10:17.78,Default,,0,0,0,,Сонымен қатар, шеберлік Reel қуатына 5000 қосады.
Dialogue: 0,0:10:17.78,0:10:20.78,Default,,0,0,0,,Истия - стенд. Күзетші жоқ.
Dialogue: 0,0:10:20.78,0:10:24.29,Default,,0,0,0,,Кезекті түрде шабуыл. Күзетші жоқ.
Dialogue: 0,0:10:24.29,0:10:26.79,Default,,0,0,0,,Идилуспен шабуыл! күзетші!
Dialogue: 0,0:10:26.79,0:10:28.79,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:10:28.79,0:10:31.33,Default,,0,0,0,,Дем алуға уақыт жоқ па➡
Dialogue: 0,0:10:31.33,0:10:33.83,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:33.83,0:10:37.33,Default,,0,0,0,,Үкім шығарудағы бір сәт қателік өмір мен өлім арасындағы айырмашылықты білдіруі мүмкін➡
Dialogue: 0,0:10:37.33,0:10:40.30,Default,,0,0,0,,Ал, енді менің кезегім!
Dialogue: 0,0:10:40.30,0:10:42.34,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:10:42.34,0:10:45.84,Default,,0,0,0,,Ақ жарқыл, Қара Zankyo➡
Dialogue: 0,0:10:45.84,0:10:49.81,Default,,0,0,0,,Дүниедегі жеңілмейтін екі қолды қылыш! ➡
Dialogue: 0,0:10:49.81,0:10:53.31,Default,,0,0,0,,Жүр! Теңдесі жоқ тағдыр➡
Dialogue: 0,0:10:53.31,0:10:55.82,Default,,0,0,0,,Варга Драгрес!
Dialogue: 0,0:10:57.82,0:10:59.79,Default,,0,0,0,,Боулдер балтасын шеберлікпен шақырыңыз➡
Dialogue: 0,0:10:59.79,0:11:02.29,Default,,0,0,0,,Айдаһар Рокусейге➡ қоңырау шалыңыз
Dialogue: 0,0:11:02.29,0:11:05.29,Default,,0,0,0,,Дағдылардың көмегімен кедергілерді болдырмау➡
Dialogue: 0,0:11:05.29,0:11:08.86,Default,,0,0,0,,Боулдер балтасымен шабуыл. күзетші.
Dialogue: 0,0:11:08.86,0:11:12.30,Default,,0,0,0,,Егер Авангард Валга болса, Элюдингтің қуаты плюс 10000➡ болады
Dialogue: 0,0:11:12.30,0:11:14.34,Default,,0,0,0,,Қалқан +10000 ➡
Dialogue: 0,0:11:14.34,0:11:17.31,Default,,0,0,0,,Елудингпен шабуыл. күзетші.
Dialogue: 0,0:11:17.31,0:11:20.81,Default,,0,0,0,,Теңдесі жоқ қылыш енді жарқырап тұр! ➡
Dialogue: 0,0:11:20.81,0:11:23.85,Default,,0,0,0,,Вальга Драгреспен бірге Авангардқа шабуыл жасаңыз! ➡
Dialogue: 0,0:11:23.85,0:11:27.35,Default,,0,0,0,,Дағдыны белсендіру: Екі ойыншының да барлық алдыңғы қатарларынан шегініңіз➡
Dialogue: 0,0:11:27.35,0:11:31.32,Default,,0,0,0,,Меншікті қуат плюс 10000! Қарғыс атқыр... бұл қиын!
Dialogue: 0,0:11:31.32,0:11:33.82,Default,,0,0,0,,Ал Елюдинг шеберлікке байланысты➡
Dialogue: 0,0:11:33.82,0:11:37.83,Default,,0,0,0,,Қолға оралу. Күзетші жоқ.
Dialogue: 0,0:11:37.83,0:11:42.33,Default,,0,0,0,,Қос жетек! Бірінші тексеру Екінші тексеру➡
Dialogue: 0,0:11:42.33,0:11:45.33,Default,,0,0,0,,Триггерді тартыңыз! Варганың күші плюс 10 000.
Dialogue: 0,0:11:47.34,0:11:49.80,Default,,0,0,0,,Ұрыс соңында Валгаға тұрыңыз➡
Dialogue: 0,0:11:49.80,0:11:52.31,Default,,0,0,0,,Тағы да шабуыл!
Dialogue: 0,0:11:54.81,0:11:57.81,Default,,0,0,0,,Сақшылардың зақымдалуын тексеру жоқ➡
Dialogue: 0,0:11:57.81,0:12:01.82,Default,,0,0,0,,Critical Trigger Roel қуаты плюс 10 000!
Dialogue: 0,0:12:01.82,0:12:03.82,Default,,0,0,0,,Зақымдану триггері….
Dialogue: 0,0:12:05.79,0:12:07.79,Default,,0,0,0,,Құдайдың шеберлігі Мен не істеуім керек?
Dialogue: 0,0:12:09.32,0:12:11.29,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:11.29,0:12:14.33,Default,,0,0,0,,Сақтау...?
Dialogue: 0,0:12:14.33,0:12:17.37,Default,,0,0,0,,Қазірдің өзінде қолыңыздан екі картаны қолдануға мәжбүрлеу жеткілікті➡
Dialogue: 0,0:12:17.37,0:12:21.37,Default,,0,0,0,,Мұндағы зақым әлі 2, сондықтан асығудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:12:21.37,0:12:25.31,Default,,0,0,0,,Иә...Авангардқа келгенде Нао-санның IQ жоғары.
Dialogue: 0,0:12:25.31,0:12:27.31,Default,,0,0,0,,Хмм...бұл мақтау ма?
Dialogue: 0,0:12:27.31,0:12:29.81,Default,,0,0,0,,Әрине...бірақ➡
Dialogue: 0,0:12:29.81,0:12:32.81,Default,,0,0,0,,Мүмкін мен сенің басқа нәрседе ақылды болғаныңды қалаймын.
Dialogue: 0,0:12:32.81,0:12:34.82,Default,,0,0,0,,Мен сені мақтап тұрғаным жоқ!
Dialogue: 0,0:12:34.82,0:12:36.82,Default,,0,0,0,,Мен сізді шынымен мақтаймын➡
Dialogue: 0,0:12:36.82,0:12:39.82,Default,,0,0,0,,Себебі Нао кәсіби әлемде➡ тұрады
Dialogue: 0,0:12:39.82,0:12:42.32,Default,,0,0,0,,Өйткені бұл менің мақсатым.
Dialogue: 0,0:12:42.32,0:12:44.79,Default,,0,0,0,,Эрика-чан, мүмкін сен кәсіпқой боласың ба?
Dialogue: 0,0:12:44.79,0:12:48.83,Default,,0,0,0,,Бұл дүниеде өмір сүруге шешім қабылдағаннан кейін➡
Dialogue: 0,0:12:48.83,0:12:52.87,Default,,0,0,0,,Барлығының көмегінің арқасында мен қазір күн көремін.
Dialogue: 0,0:12:52.87,0:12:55.80,Default,,0,0,0,,Бірақ ол мейірімділікке мәңгілік сене алмайсың➡
Dialogue: 0,0:12:55.80,0:12:57.84,Default,,0,0,0,,Мен әрқашан осылай ойладым.
Dialogue: 0,0:12:57.84,0:13:02.38,Default,,0,0,0,,Мен өмір сүру үшін өз жерімді жасауым керек.
Dialogue: 0,0:13:02.38,0:13:06.85,Default,,0,0,0,,Сондықтан мақсатты әлемде тұрған Наоны жеңу ➡ болып табылады
Dialogue: 0,0:13:06.85,0:13:09.32,Default,,0,0,0,,Мен үшін бұл болашаққа сынақ!
Dialogue: 0,0:13:12.32,0:13:14.29,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе...!
Dialogue: 0,0:13:14.29,0:13:17.29,Default,,0,0,0,,Менің кезегім тұлғалық сапар➡
Dialogue: 0,0:13:17.29,0:13:19.29,Default,,0,0,0,,Reel Amorta!
Dialogue: 0,0:13:20.29,0:13:22.86,Default,,0,0,0,,Light Blade Knight Religial➡ деп атаңыз
Dialogue: 0,0:13:22.86,0:13:26.30,Default,,0,0,0,,Палубаның жоғарғы 7 картасынан дағдыларды белсендіру➡
Dialogue: 0,0:13:26.30,0:13:28.80,Default,,0,0,0,,Габриэлиусты қолыңызға қосыңыз!
Dialogue: 0,0:13:28.80,0:13:30.81,Default,,0,0,0,,Габутчи?
Dialogue: 0,0:13:30.81,0:13:33.81,Default,,0,0,0,,Енді бәріміз біртұтаспыз ➡
Dialogue: 0,0:13:33.81,0:13:36.31,Default,,0,0,0,,Сонымен бірге➡
Dialogue: 0,0:13:36.31,0:13:38.31,Default,,0,0,0,,Болашақты жең! ➡
Dialogue: 0,0:13:38.31,0:13:41.32,Default,,0,0,0,,Қасиетті Айдаһар Габуэлиусты шақырыңыз!
Dialogue: 0,0:13:53.26,0:13:55.76,Default,,0,0,0,,Гурагаонға➡ қоңырау шалыңыз
Dialogue: 0,0:13:55.76,0:13:58.23,Default,,0,0,0,,Қасиетті күш пен уақыт құдіреті➡
Dialogue: 0,0:13:58.23,0:14:01.24,Default,,0,0,0,,Қос спиральмен екі қылышты жаншып ал! ➡
Dialogue: 0,0:14:01.24,0:14:04.24,Default,,0,0,0,,Габриэлиуспен шабуыл! күзетші.
Dialogue: 0,0:14:04.24,0:14:07.78,Default,,0,0,0,,Reel Amorta көмегімен авангардқа шабуыл жасаңыз! ➡
Dialogue: 0,0:14:07.78,0:14:10.75,Default,,0,0,0,,Дағды іске қосылды! Габриэлиусты байлау➡
Dialogue: 0,0:14:10.75,0:14:13.28,Default,,0,0,0,,Басқа Габуэлийге➡ қоңырау шалыңыз
Dialogue: 0,0:14:13.28,0:14:17.25,Default,,0,0,0,,Дағды сізге палубаның жоғарғы жағына қарап, оны төменгі жағына қоюға мүмкіндік береді.
Dialogue: 0,0:14:17.25,0:14:19.25,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:14:19.25,0:14:22.26,Default,,0,0,0,,Бірінші тексеру Екінші тексеру➡
Dialogue: 0,0:14:22.26,0:14:25.76,Default,,0,0,0,,Критикалық триггер Габуэлиустың қуаты +10000➡
Dialogue: 0,0:14:25.76,0:14:28.26,Default,,0,0,0,,Critical Plus 1➡
Dialogue: 0,0:14:28.26,0:14:30.23,Default,,0,0,0,,Тағдырыңды басқаратын уақыт ағыны➡
Dialogue: 0,0:14:30.23,0:14:32.23,Default,,0,0,0,,Мәні өткенге секіру➡
Dialogue: 0,0:14:32.23,0:14:36.27,Default,,0,0,0,,Уақыт, артқа бұрыл! Құдайдың шеберлігін белсендіру➡
Dialogue: 0,0:14:36.27,0:14:39.27,Default,,0,0,0,,Ұрыс соңында жоғалған сол атау картасы➡
Dialogue: 0,0:14:39.27,0:14:43.31,Default,,0,0,0,,Амортаға барыңыз! Жүргізу минус 1.
Dialogue: 0,0:14:43.31,0:14:46.25,Default,,0,0,0,,Сіз осындасыз ба? Габриэлиуспен шабуыл➡
Dialogue: 0,0:14:46.25,0:14:49.25,Default,,0,0,0,,Дағды іске қосылды! Пауэр Plus 10000➡
Dialogue: 0,0:14:49.25,0:14:52.75,Default,,0,0,0,,Минус 1 жүргізіп, дискіні тексеруді орындаңыз.
Dialogue: 0,0:14:52.75,0:14:55.76,Default,,0,0,0,,Шыдай алмаймын...Толық күзет!
Dialogue: 0,0:14:55.76,0:14:58.76,Default,,0,0,0,,Дискіні тексеру триггер жоқ➡
Dialogue: 0,0:14:58.76,0:15:02.80,Default,,0,0,0,,Діни шабуыл. Күзетші жоқ.
Dialogue: 0,0:15:02.80,0:15:06.23,Default,,0,0,0,,Ұрыс соңында Гурагаонның шеберлігін пайдаланып, шабуылға қарсы әрекет етіңіз➡
Dialogue: 0,0:15:06.23,0:15:09.74,Default,,0,0,0,,Reel Amorta➡ көмегімен қайтадан шабуыл жасаңыз
Dialogue: 0,0:15:09.74,0:15:12.24,Default,,0,0,0,,Дағды іске қосылды! Діни байланыстыру➡
Dialogue: 0,0:15:12.24,0:15:14.81,Default,,0,0,0,,Басқа дінге қоңырау шалыңыз➡
Dialogue: 0,0:15:14.81,0:15:18.75,Default,,0,0,0,,Осы дағдымен қолыңызға Reel-Amorta қосыңыз.
Dialogue: 0,0:15:18.75,0:15:21.75,Default,,0,0,0,,Ролик сіздің қолыңызда... Күзет жоқ!
Dialogue: 0,0:15:21.75,0:15:24.25,Default,,0,0,0,,Дискіні тексеру сыни триггер➡
Dialogue: 0,0:15:24.25,0:15:26.79,Default,,0,0,0,,Діни қуат плюс 10000➡
Dialogue: 0,0:15:26.79,0:15:29.29,Default,,0,0,0,,Реелдің сыни плюс 1! О, жоқ!
Dialogue: 0,0:15:31.26,0:15:34.26,Default,,0,0,0,,Дінмен бірге авангардқа шабуыл жасаңыз!
Dialogue: 0,0:15:34.26,0:15:36.23,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:15:37.73,0:15:39.80,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:15:39.80,0:15:44.77,Default,,0,0,0,,Бұл жақын қоңырау болды...бірақ енді шабуыл кезегі бізге келді.
Dialogue: 0,0:15:44.77,0:15:47.81,Default,,0,0,0,,Жеңіске жете алмаймыз деп болжануда➡
Dialogue: 0,0:15:47.81,0:15:51.28,Default,,0,0,0,,Қолымды арттыру үшін дағдыларды қолдандым. Мен оның алдын аламын.
Dialogue: 0,0:15:52.31,0:15:54.75,Default,,0,0,0,,Жаңа жерге бейімделгендер➡
Dialogue: 0,0:15:54.75,0:15:57.29,Default,,0,0,0,,Жаңа дәуірді жасаңыз.
Dialogue: 0,0:15:57.29,0:16:01.29,Default,,0,0,0,,Ым? Сіздің күшіңіз немесе жағдайыңыз қандай болса да, оларға бейімделіңіз➡
Dialogue: 0,0:16:01.29,0:16:03.79,Default,,0,0,0,,Тек эволюция арқылы біз теңдесі жоқ бола аламыз.
Dialogue: 0,0:16:03.79,0:16:06.79,Default,,0,0,0,,Бұл кезең мен үшін де сынақ➡
Dialogue: 0,0:16:06.79,0:16:10.26,Default,,0,0,0,,Нәтижелері бар кәсіпқой болып қала беретініңізді дәлелдеңіз➡
Dialogue: 0,0:16:10.26,0:16:12.77,Default,,0,0,0,,Әлемді және өзіңді сынау.
Dialogue: 0,0:16:12.77,0:16:16.24,Default,,0,0,0,,Мен сізге өз мүмкіндігімді көрсетемін!
Dialogue: 0,0:16:16.24,0:16:19.24,Default,,0,0,0,,Кух…. Менің кезегім ➡
Dialogue: 0,0:16:19.24,0:16:21.78,Default,,0,0,0,,Ақ жын жалыны Қара тозақ➡
Dialogue: 0,0:16:21.78,0:16:24.28,Default,,0,0,0,,Зұлымдық денеде тұрады➡
Dialogue: 0,0:16:24.28,0:16:26.78,Default,,0,0,0,,Оны жеңілмейтіндіктің негізіне айналдыр!
Dialogue: 0,0:16:27.75,0:16:29.72,Default,,0,0,0,,Зұлым айдаһарды босатыңыз!
Dialogue: 0,0:16:31.25,0:16:33.25,Default,,0,0,0,,Теңдесі жоқ сиқырлы жүзді айдаһар➡
Dialogue: 0,0:16:33.25,0:16:35.22,Default,,0,0,0,,Варга Драгрес Ракшаса!
Dialogue: 0,0:16:37.76,0:16:40.80,Default,,0,0,0,,Күте тұрыңыз... ол карта неге сізде әлі бар?
Dialogue: 0,0:16:40.80,0:16:44.27,Default,,0,0,0,,Неге, картаның өзі жоғалып кетпеді➡
Dialogue: 0,0:16:44.27,0:16:48.27,Default,,0,0,0,,Бұл пайдалы емес пе? Бұл оңай...
Dialogue: 0,0:16:48.27,0:16:52.77,Default,,0,0,0,,Варга Драгрес түсінде менімен сөйлеседі➡
Dialogue: 0,0:16:52.77,0:16:55.74,Default,,0,0,0,,Ешбір қуатты жоққа шығармаңыз, оны толық пайдаланыңыз➡
Dialogue: 0,0:16:55.74,0:16:58.28,Default,,0,0,0,,Бұл теңдессіз болуы мүмкін.
Dialogue: 0,0:16:58.28,0:17:01.28,Default,,0,0,0,,Сондықтан мен бұл карта туралы ойладым ➡
Dialogue: 0,0:17:01.28,0:17:04.79,Default,,0,0,0,,Әрине, мен ойлайтын нәрселер бар, бірақ бәрібір ➡
Dialogue: 0,0:17:04.79,0:17:08.76,Default,,0,0,0,,Сол құдіретті алсам да, теңдесі жоқ болғым келеді!
Dialogue: 0,0:17:08.76,0:17:10.76,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:17:12.76,0:17:15.26,Default,,0,0,0,,Нао-сенпай...!
Dialogue: 0,0:17:15.26,0:17:17.23,Default,,0,0,0,,Міне келдік!
Dialogue: 0,0:17:17.23,0:17:19.23,Default,,0,0,0,,Twinpulsive➡ қоңырау шалыңыз
Dialogue: 0,0:17:19.23,0:17:21.74,Default,,0,0,0,,Сол шеберлікпен Шуураға қоңырау шалыңыз➡
Dialogue: 0,0:17:21.74,0:17:23.84,Default,,0,0,0,,Storm Slasher➡ шақыру
Dialogue: 0,0:17:23.84,0:17:25.77,Default,,0,0,0,,Twin Pulsive көмегімен шабуыл.
Dialogue: 0,0:17:25.77,0:17:28.24,Default,,0,0,0,,Күзетшілерді ұстау.
Dialogue: 0,0:17:28.24,0:17:31.31,Default,,0,0,0,,Шуурамен шабуыл. Күзетші жоқ.
Dialogue: 0,0:17:31.31,0:17:34.75,Default,,0,0,0,,Ракшасадағы бірінші қылыш Вальга Драгрес➡
Dialogue: 0,0:17:34.75,0:17:37.29,Default,,0,0,0,,Авангардқа шабуыл жасаңыз! ➡
Dialogue: 0,0:17:37.29,0:17:40.76,Default,,0,0,0,,Дағды іске қосылды! Алдыңғы қатардағы барлық артқы қорғаушыларды шегіндіріңіз➡
Dialogue: 0,0:17:40.76,0:17:43.29,Default,,0,0,0,,Меншікті қуат плюс 10000➡
Dialogue: 0,0:17:43.29,0:17:46.29,Default,,0,0,0,,Шуура қайтып келді! Мен жеңілмеймін! ➡
Dialogue: 0,0:17:46.29,0:17:52.73,Default,,0,0,0,,Guard Reel Amorta Шабуыл мұндай шеберлікпен соққы бермейді!
Dialogue: 0,0:17:52.73,0:17:56.77,Default,,0,0,0,,Бірінші тексеру Екінші тексеру➡
Dialogue: 0,0:17:56.77,0:17:59.74,Default,,0,0,0,,Критикалық триггер Вальганың Пауэр Plus 10000➡
Dialogue: 0,0:17:59.74,0:18:02.31,Default,,0,0,0,,Критикалық плюс 1! Қарғыс атқыр...
Dialogue: 0,0:18:02.31,0:18:06.25,Default,,0,0,0,,Ұрыс соңында артқы қатардағы барлық сақшыларды шегіндіріңіз➡
Dialogue: 0,0:18:06.25,0:18:09.78,Default,,0,0,0,,Вальга екінші қылышқа тұрыңыз➡
Dialogue: 0,0:18:09.78,0:18:12.79,Default,,0,0,0,,Вальга Драгрес Ракшасамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:14.76,0:18:17.29,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:18:17.29,0:18:20.80,Default,,0,0,0,,Екі сиқырлы жүз, енді тұтану уақыты! ➡
Dialogue: 0,0:18:20.80,0:18:24.77,Default,,0,0,0,,Теңдесі жоқ! Құдайдың шеберлігін белсендіру➡
Dialogue: 0,0:18:24.77,0:18:28.27,Default,,0,0,0,,Валга қайтадан тұрып, плюс 2 жүргізеді.
Dialogue: 0,0:18:28.27,0:18:30.81,Default,,0,0,0,,Кух…. Сан но Тачи➡
Dialogue: 0,0:18:30.81,0:18:34.74,Default,,0,0,0,,Вальга Драгрес Ракшасамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:34.74,0:18:37.31,Default,,0,0,0,,Күзетші! Триггер болады ма?
Dialogue: 0,0:18:37.31,0:18:39.78,Default,,0,0,0,,Сіз шығасыз ба? (2 адам) Шайқас!
Dialogue: 0,0:18:42.25,0:18:44.25,Default,,0,0,0,,Кішкене жарық болса да!
Dialogue: 0,0:18:44.25,0:18:46.75,Default,,0,0,0,,Тек қол ұшын созғандарға!
Dialogue: 0,0:18:46.75,0:18:49.76,Default,,0,0,0,,Керемет келе жатыр! ➡
Dialogue: 0,0:18:49.76,0:18:54.26,Default,,0,0,0,,Хаа~!
Dialogue: 0,0:18:54.26,0:18:56.26,Default,,0,0,0,,Мен оны ұстадым! ➡
Dialogue: 0,0:18:56.26,0:18:59.23,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:18:59.23,0:19:01.74,Default,,0,0,0,,Валганың күші плюс 10 000!
Dialogue: 0,0:19:08.28,0:19:10.24,Default,,0,0,0,,Сізді кесіп тастағаным үшін кешіріңіз!
Dialogue: 0,0:19:14.75,0:19:18.25,Default,,0,0,0,,Жеңімпаз Инабе Нао!
Dialogue: 0,0:19:18.25,0:19:22.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:24.76,0:19:27.29,Default,,0,0,0,,Эрика-чан. а….
Dialogue: 0,0:19:27.29,0:19:31.30,Default,,0,0,0,,Шайқас Сізге көп рахмет. Ха….
Dialogue: 0,0:19:33.73,0:19:35.74,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:19:35.74,0:19:39.47,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:39.47,0:19:42.24,Default,,0,0,0,,((Бұл не сезім➡
Dialogue: 0,0:19:42.24,0:19:45.28,Default,,0,0,0,,Ыстық, мен оған ештеңе істей алмаймын және шулы➡
Dialogue: 0,0:19:45.28,0:19:47.25,Default,,0,0,0,,Бұл сезім➡
Dialogue: 0,0:19:47.25,0:19:49.82,Default,,0,0,0,,Қалған жекпе-жектер де керемет болды➡
Dialogue: 0,0:19:49.82,0:19:51.82,Default,,0,0,0,,Бірақ бұл жолы ерекше...! ))
Dialogue: 0,0:19:53.25,0:19:56.29,Default,,0,0,0,,Мм? не болды. Ой жоқ➡
Dialogue: 0,0:19:56.29,0:20:00.80,Default,,0,0,0,,Бұл таңқаларлық. Ракшаса шыққанда таң қалдым.
Dialogue: 0,0:20:00.80,0:20:03.26,Default,,0,0,0,,Бұл да рас...➡
Dialogue: 0,0:20:03.26,0:20:05.27,Default,,0,0,0,,Енді кезек Сууға келді...
Dialogue: 0,0:20:05.27,0:20:07.77,Default,,0,0,0,,А, мен келе жатырмын.
Dialogue: 0,0:20:07.77,0:20:10.30,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:20:10.30,0:20:13.27,Default,,0,0,0,,Келіңіз, жеңіңіз! Әрине.
Dialogue: 0,0:20:15.24,0:20:17.24,Default,,0,0,0,,Жеңімпаз➡
Dialogue: 0,0:20:17.24,0:20:19.88,Default,,0,0,0,,Суо~!
Dialogue: 0,0:20:19.88,0:20:21.88,Default,,0,0,0,,)
Dialogue: 0,0:20:25.39,0:20:27.86,Default,,0,0,0,,)
Dialogue: 0,0:20:29.26,0:20:31.26,Default,,0,0,0,,Жеңімпаз➡
Dialogue: 0,0:20:31.26,0:20:34.30,Default,,0,0,0,,Кагецу Якумо!
Dialogue: 0,0:20:34.30,0:20:37.23,Default,,0,0,0,,Кух…. Соңғы рет мықтыны жеңген боксшы➡
Dialogue: 0,0:20:37.23,0:20:39.30,Default,,0,0,0,,Күштілігі бойынша➡
Dialogue: 0,0:20:39.30,0:20:42.27,Default,,0,0,0,,Егер менің жолым сәл бұрылып кетсе, қауіпті болар еді.
Dialogue: 0,0:20:46.31,0:20:48.81,Default,,0,0,0,,((Бірақ➡
Dialogue: 0,0:20:48.81,0:20:50.81,Default,,0,0,0,,Сол керемет... ))
Dialogue: 0,0:20:53.25,0:20:55.75,Default,,0,0,0,,Шайқас Сізге көп рахмет.
Dialogue: 0,0:20:55.75,0:20:58.22,Default,,0,0,0,,А... Сәлеметсіз бе.
Dialogue: 0,0:20:59.75,0:21:02.29,Default,,0,0,0,,Қиян-кескі шайқас аз ғана ➡ қалды
Dialogue: 0,0:21:02.29,0:21:05.26,Default,,0,0,0,,Осымен Deluxe Preliminaries➡ бірінші күні аяқталады
Dialogue: 0,0:21:05.26,0:21:09.23,Default,,0,0,0,,Ертеңгі жекпе-жекті жіберіп алмаңыз!
Dialogue: 0,0:21:09.23,0:21:12.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:14.27,0:21:16.27,Default,,0,0,0,,Керемет!
Dialogue: 0,0:21:16.27,0:21:19.27,Default,,0,0,0,,Бұл сіздің әдеттегі арзан қонақ үйіңіз емес!
Dialogue: 0,0:21:19.27,0:21:23.28,Default,,0,0,0,,Біз осы жерде соғыса аламыз ба? Менің ойымша, сіз мұны істей аласыз.
Dialogue: 0,0:21:23.28,0:21:26.25,Default,,0,0,0,,Хаа~! Эй Эрика! Кейінірек айналаға қарағың келе ме?
Dialogue: 0,0:21:26.25,0:21:28.25,Default,,0,0,0,,Өте қызық!
Dialogue: 0,0:21:29.25,0:21:32.25,Default,,0,0,0,,Жақсы. Ха….
Dialogue: 0,0:21:32.25,0:21:35.26,Default,,0,0,0,,Мм... Акина-кун? Un?
Dialogue: 0,0:21:35.26,0:21:38.26,Default,,0,0,0,,Мегуми-сан! Yaho~.
Dialogue: 0,0:21:38.26,0:21:41.26,Default,,0,0,0,,Мұндай жерде тоқтау ыңғайсыздық туғызса керек.
Dialogue: 0,0:21:41.26,0:21:44.23,Default,,0,0,0,,Қайырлы кеш. Ха….
Dialogue: 0,0:21:46.23,0:21:48.74,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:48.74,0:21:52.74,Default,,0,0,0,,Кел, маған қайта тірілген мықтыны көрсет➡
Dialogue: 0,0:21:52.74,0:21:55.24,Default,,0,0,0,,Мичиру Кайманың жекпе-жегі.
Dialogue: 0,0:21:55.24,0:21:57.24,Default,,0,0,0,,Un➡
Dialogue: 0,0:21:57.24,0:21:59.25,Default,,0,0,0,,Мен оны асыға күтпеймін.
Dialogue: 0,0:22:00.75,0:22:06.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory