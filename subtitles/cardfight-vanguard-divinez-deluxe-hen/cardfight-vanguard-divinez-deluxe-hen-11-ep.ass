Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:29.86,0:00:31.83,Default,,0,0,0,,Суо.
Dialogue: 0,0:00:36.77,0:00:38.77,Default,,0,0,0,,Әке….
Dialogue: 0,0:00:38.77,0:00:40.77,Default,,0,0,0,,Ана….
Dialogue: 0,0:00:40.77,0:00:44.24,Default,,0,0,0,,Suoh Сізге Vanguard әлі де ұнай ма?
Dialogue: 0,0:00:47.28,0:00:49.78,Default,,0,0,0,,Хмм...маған ұнайды➡
Dialogue: 0,0:00:49.78,0:00:52.25,Default,,0,0,0,,Мен оны жақсы көремін.
Dialogue: 0,0:00:52.25,0:00:54.25,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:54.25,0:00:56.75,Default,,0,0,0,,Кешіріңіз, Суо.
Dialogue: 0,0:00:57.75,0:01:00.26,Default,,0,0,0,,Мен көңілдімін.
Dialogue: 0,0:01:02.26,0:01:04.76,Default,,0,0,0,,Бұл ең қызықты уақыт екеніне сенімдімін➡
Dialogue: 0,0:01:04.76,0:01:07.26,Default,,0,0,0,,Сондықтан уайымдамаңыз.
Dialogue: 0,0:01:25.28,0:01:28.85,Default,,0,0,0,,Бірге барайық➡
Dialogue: 0,0:01:28.85,0:01:30.82,Default,,0,0,0,,Брагдомейер. ))
Dialogue: 0,0:01:44.27,0:01:46.27,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:03:24.73,0:03:27.74,Default,,0,0,0,,Алдыңғы матчтағы жеңіліс➡
Dialogue: 0,0:03:27.74,0:03:31.21,Default,,0,0,0,,Бұл Рокуоиндегі қателік сияқты.
Dialogue: 0,0:03:31.21,0:03:34.21,Default,,0,0,0,,Кешіріңіз, анашым.
Dialogue: 0,0:03:34.21,0:03:36.21,Default,,0,0,0,,Бүгін жеңіңіз➡
Dialogue: 0,0:03:36.21,0:03:38.71,Default,,0,0,0,,Сөзсіз.
Dialogue: 0,0:03:38.71,0:03:40.72,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:42.78,0:03:45.79,Default,,0,0,0,,((Бұл мен жасағым келетін карта күресі➡
Dialogue: 0,0:03:45.79,0:03:47.79,Default,,0,0,0,,Бұл менің сүйікті жекпе-жегім. ))
Dialogue: 0,0:03:49.73,0:03:53.73,Default,,0,0,0,,Бір ғана күш бар ма?
Dialogue: 0,0:03:53.73,0:03:56.73,Default,,0,0,0,,Сіз Рокуоинге күмәнданасыз ба?
Dialogue: 0,0:03:56.73,0:03:58.73,Default,,0,0,0,,Жоқ….
Dialogue: 0,0:03:58.73,0:04:01.24,Default,,0,0,0,,Шатасып қалдыңыз ба?➡
Dialogue: 0,0:04:01.24,0:04:04.21,Default,,0,0,0,,Рокуоин өзгеріссіз қалады➡
Dialogue: 0,0:04:04.21,0:04:06.21,Default,,0,0,0,,Оны тағы бір рет түсініңіз➡
Dialogue: 0,0:04:06.21,0:04:08.71,Default,,0,0,0,,Сіз кімсіз.
Dialogue: 0,0:04:11.21,0:04:14.72,Default,,0,0,0,,Үздіксіз жеңіс – Рокуоиннің құрметі➡
Dialogue: 0,0:04:14.72,0:04:18.22,Default,,0,0,0,,Авангард көңіл көтеруді қажет етпейді➡
Dialogue: 0,0:04:18.22,0:04:20.22,Default,,0,0,0,,Тек жеңіс пен жеңіліс бар.
Dialogue: 0,0:04:22.72,0:04:25.23,Default,,0,0,0,,Авангард – бәсекелестік әлемі➡
Dialogue: 0,0:04:25.23,0:04:28.73,Default,,0,0,0,,Күштен басқаның бәрі арам➡
Dialogue: 0,0:04:28.73,0:04:30.77,Default,,0,0,0,,Және….
Dialogue: 0,0:04:30.77,0:04:33.74,Default,,0,0,0,,Жеңіске жете алмаған күрескердің құны жоқ.
Dialogue: 0,0:04:39.71,0:04:41.71,Default,,0,0,0,,Іріктеу кезеңінің соңғы күні! ➡
Dialogue: 0,0:04:41.71,0:04:44.21,Default,,0,0,0,,Бұл басынан бастап қызықты! ➡
Dialogue: 0,0:04:44.21,0:04:46.72,Default,,0,0,0,,Жеңіске жеткен Мирей бола ма?➡
Dialogue: 0,0:04:46.72,0:04:49.22,Default,,0,0,0,,Немесе Нао Инабен!
Dialogue: 0,0:04:55.72,0:04:59.73,Default,,0,0,0,,Бұл жерде жақсы, мықты жауынгерлер көп➡
Dialogue: 0,0:04:59.73,0:05:01.73,Default,,0,0,0,,Сіз көп күресе аласыз.
Dialogue: 0,0:05:01.73,0:05:05.73,Default,,0,0,0,,Аа...Есімде ескі күндер➡
Dialogue: 0,0:05:05.73,0:05:08.74,Default,,0,0,0,,Мен теледидардан «Авангард» турнирін көрдім➡
Dialogue: 0,0:05:08.74,0:05:11.24,Default,,0,0,0,,Мен де Суох➡-де пайда боламын
Dialogue: 0,0:05:11.24,0:05:13.21,Default,,0,0,0,,Күшті жауынгерлерге қарсы күрес➡
Dialogue: 0,0:05:13.21,0:05:15.71,Default,,0,0,0,,Бұл керемет болды.
Dialogue: 0,0:05:15.71,0:05:17.71,Default,,0,0,0,,есімде жоқ.
Dialogue: 0,0:05:19.21,0:05:21.22,Default,,0,0,0,,көремін. Бірақ...
Dialogue: 0,0:05:21.22,0:05:23.22,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:05:23.22,0:05:26.22,Default,,0,0,0,,Мені бұрыннан еске алған адам➡
Dialogue: 0,0:05:26.22,0:05:28.72,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:05:31.23,0:05:33.20,Default,,0,0,0,,Бұл жеткілікті арзан.
Dialogue: 0,0:05:35.23,0:05:37.23,Default,,0,0,0,,Топтың 5-ші ойыны➡
Dialogue: 0,0:05:37.23,0:05:39.73,Default,,0,0,0,,Ақыры шешілді! ➡
Dialogue: 0,0:05:39.73,0:05:42.74,Default,,0,0,0,,Қиян-кескі шайқаста жеңіске жеткен – Мирей Оякубукуро! ➡
Dialogue: 0,0:05:42.74,0:05:44.71,Default,,0,0,0,,Күтпеген толық жеңіс! ➡
Dialogue: 0,0:05:44.71,0:05:46.71,Default,,0,0,0,,Күшті... тым күшті! ➡
Dialogue: 0,0:05:46.71,0:05:49.71,Default,,0,0,0,,Финалдық турнирге өту!
Dialogue: 0,0:05:49.71,0:05:52.25,Default,,0,0,0,,Ендігі кезек Сууға келді.
Dialogue: 0,0:05:52.25,0:05:55.25,Default,,0,0,0,,О, қараңызшы➡
Dialogue: 0,0:05:55.25,0:05:57.22,Default,,0,0,0,,Біздің эволюциямыз.
Dialogue: 0,0:06:03.23,0:06:06.23,Default,,0,0,0,,Сәлем, балалар! Сізді күткенім үшін кешіріңіз➡
Dialogue: 0,0:06:06.23,0:06:09.23,Default,,0,0,0,,Келесіде В тобындағы жекпе-жек! ➡
Dialogue: 0,0:06:09.23,0:06:12.23,Default,,0,0,0,,Авангард машинасы Rokuoin Suzune➡
Dialogue: 0,0:06:12.23,0:06:14.74,Default,,0,0,0,,Цуджикири жауынгеріне қарсы➡
Dialogue: 0,0:06:14.74,0:06:16.71,Default,,0,0,0,,Суоу Суу!
Dialogue: 0,0:06:24.25,0:06:28.25,Default,,0,0,0,,Рокуоин Сузуне Саған айтар сөзім бар.
Dialogue: 0,0:06:30.22,0:06:32.22,Default,,0,0,0,,Менімен дос бол.
Dialogue: 0,0:06:34.76,0:06:38.73,Default,,0,0,0,,Ах... Қалай айтсақ...
Dialogue: 0,0:06:38.73,0:06:41.20,Default,,0,0,0,,Сен шын айтасың ба, Суо?
Dialogue: 0,0:06:44.80,0:06:48.30,Default,,0,0,0,,((Рокуин-санмен дос болғыңыз келе ме?
Dialogue: 0,0:06:48.30,0:06:51.24,Default,,0,0,0,,Суохтың бұлай айтқанына сене алар емеспін.
Dialogue: 0,0:06:51.24,0:06:54.21,Default,,0,0,0,,Біртүрлі ма? Маған ұнамайды... біртүрлі емес пе? ➡
Dialogue: 0,0:06:54.21,0:06:56.24,Default,,0,0,0,,Суо шамамен бір жаста болғандықтан, ол қарама-қарсы жыныспен➡
Dialogue: 0,0:06:56.24,0:06:58.75,Default,,0,0,0,,Тірі заттардың бір-бірімен тіл табысқысы келетіні табиғи құбылыс➡
Dialogue: 0,0:06:58.75,0:07:00.72,Default,,0,0,0,,Сондықтан менде таңғаларлық ештеңе жоқ, әсіресе...!
Dialogue: 0,0:07:00.72,0:07:03.22,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:07:03.22,0:07:06.22,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:07:06.22,0:07:09.22,Default,,0,0,0,,Мен олардың ұқсастығын сезінемін➡
Dialogue: 0,0:07:09.22,0:07:12.73,Default,,0,0,0,,Бос болған кезде маған.
Dialogue: 0,0:07:12.73,0:07:14.73,Default,,0,0,0,,Суу….
Dialogue: 0,0:07:14.73,0:07:18.30,Default,,0,0,0,,Қажет болса хабарласқым келеді➡
Dialogue: 0,0:07:18.30,0:07:21.27,Default,,0,0,0,,Дәл Акина сияқты. ))
Dialogue: 0,0:07:23.24,0:07:26.21,Default,,0,0,0,,Менің ойымша, мен сізге тағы біраз кеңес беруім керек еді.
Dialogue: 0,0:07:26.21,0:07:28.74,Default,,0,0,0,,Мен әрине епсізмін➡
Dialogue: 0,0:07:28.74,0:07:30.71,Default,,0,0,0,,Мен оны қолдаймын!
Dialogue: 0,0:07:31.71,0:07:35.22,Default,,0,0,0,,Сіз доссыз ба? аа.
Dialogue: 0,0:07:35.22,0:07:38.75,Default,,0,0,0,,Біз бас тартамыз. Неліктен?
Dialogue: 0,0:07:38.75,0:07:41.22,Default,,0,0,0,,Авангард – бәсекелестік әлемі➡
Dialogue: 0,0:07:41.22,0:07:44.26,Default,,0,0,0,,Күштен басқаның бәрі арам➡
Dialogue: 0,0:07:44.26,0:07:47.76,Default,,0,0,0,,Достар маған керек емес нәрсе.
Dialogue: 0,0:07:48.76,0:07:51.73,Default,,0,0,0,,Бұл сізді байланыстырады ма?
Dialogue: 0,0:07:53.27,0:07:56.27,Default,,0,0,0,,3-ші Deluxe алдын ала В тобы
Dialogue: 0,0:07:56.27,0:07:58.74,Default,,0,0,0,,5-ойын Fai!
Dialogue: 0,0:08:03.24,0:08:06.25,Default,,0,0,0,,Тұрақты Авангард.
Dialogue: 0,0:08:06.25,0:08:08.78,Default,,0,0,0,,Үйілген сегіздік табақ.
Dialogue: 0,0:08:08.78,0:08:10.75,Default,,0,0,0,,Қуыстың мализиясы.
Dialogue: 0,0:08:10.75,0:08:13.79,Default,,0,0,0,,Менің кезегім Эстилаға барамын➡
Dialogue: 0,0:08:13.79,0:08:17.26,Default,,0,0,0,,Шеберлікпен қолыңызға Shaut in Shadow ойынын қосыңыз➡
Dialogue: 0,0:08:17.26,0:08:20.26,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім➡
Dialogue: 0,0:08:20.26,0:08:22.26,Default,,0,0,0,,Қуыс жыртқышқа мініңіз➡
Dialogue: 0,0:08:22.26,0:08:25.27,Default,,0,0,0,,Раптормен шабуыл. күзетші.
Dialogue: 0,0:08:25.27,0:08:28.27,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім ➡
Dialogue: 0,0:08:28.27,0:08:30.27,Default,,0,0,0,,Рейфельге бару➡
Dialogue: 0,0:08:30.27,0:08:33.24,Default,,0,0,0,,Мегаломанияны қолыңызға шеберлікпен қосыңыз➡
Dialogue: 0,0:08:33.24,0:08:35.24,Default,,0,0,0,,Luminoel➡ телефонына қоңырау шалыңыз
Dialogue: 0,0:08:35.24,0:08:37.75,Default,,0,0,0,,Көлеңке әскерін шеберлікпен шақырыңыз➡
Dialogue: 0,0:08:37.75,0:08:40.28,Default,,0,0,0,,Люминоэльмен шабуыл. күзетші.
Dialogue: 0,0:08:40.28,0:08:43.25,Default,,0,0,0,,Рейфельмен шабуыл. Күзетші жоқ.
Dialogue: 0,0:08:43.25,0:08:45.25,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:08:45.25,0:08:47.26,Default,,0,0,0,,Міне! көлеңкелі армия.
Dialogue: 0,0:08:47.26,0:08:49.26,Default,,0,0,0,,Сіз қалай жауап бересіз?
Dialogue: 0,0:08:49.26,0:08:51.26,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:08:51.26,0:08:53.26,Default,,0,0,0,,Бос азуға міну➡
Dialogue: 0,0:08:53.26,0:08:56.77,Default,,0,0,0,,Дағдыны қолданып, жанға 3 карта салып, 1 картаны салыңыз➡
Dialogue: 0,0:08:56.77,0:08:58.83,Default,,0,0,0,,Өңдеу шеберіне➡ қоңырау шалыңыз
Dialogue: 0,0:08:58.83,0:09:00.77,Default,,0,0,0,,Палубаның жоғарғы екі картасынан таңдау үшін дағдыларды қолданыңыз➡
Dialogue: 0,0:09:00.77,0:09:02.77,Default,,0,0,0,,Жанға 1 карта➡
Dialogue: 0,0:09:02.77,0:09:05.27,Default,,0,0,0,,Фангпен шабуыл. Күзетші жоқ.
Dialogue: 0,0:09:05.27,0:09:07.24,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:09:07.24,0:09:09.28,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:09:09.28,0:09:11.25,Default,,0,0,0,,Фанг сыни плюс 1.
Dialogue: 0,0:09:12.25,0:09:14.28,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:14.28,0:09:17.25,Default,,0,0,0,,Алдыңғы қатарға артқы күзетшіні қоймауға тырысасыз ба?
Dialogue: 0,0:09:17.25,0:09:20.26,Default,,0,0,0,,Құлыпқа байланысты қозғалу қиын болуы мүмкін.
Dialogue: 0,0:09:20.26,0:09:23.76,Default,,0,0,0,,Міне, менің кезегім➡
Dialogue: 0,0:09:23.76,0:09:26.26,Default,,0,0,0,,Өзгермейтін ырғақты ою➡
Dialogue: 0,0:09:26.26,0:09:29.23,Default,,0,0,0,,Rakuso жүйесін іске қосу….
Dialogue: 0,0:09:32.27,0:09:35.77,Default,,0,0,0,,Полифониялық Overdrive➡
Dialogue: 0,0:09:35.77,0:09:37.77,Default,,0,0,0,,Альтисарияға барыңыз!
Dialogue: 0,0:09:39.27,0:09:41.24,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:09:41.24,0:09:43.24,Default,,0,0,0,,Shadow режимін орнату➡
Dialogue: 0,0:09:43.24,0:09:45.78,Default,,0,0,0,,Осы дағдымен бір картаны салыңыз➡
Dialogue: 0,0:09:45.78,0:09:49.25,Default,,0,0,0,,Көлеңке армиясына Юикаға қоңырау шалыңыз➡
Dialogue: 0,0:09:49.25,0:09:52.29,Default,,0,0,0,,Люминоэльмен шабуыл. күзетші.
Dialogue: 0,0:09:52.29,0:09:55.76,Default,,0,0,0,,Юиканың Люминоэль шеберлігін қолына қайтарыңыз➡
Dialogue: 0,0:09:55.76,0:09:57.76,Default,,0,0,0,,Альтисариямен шабуыл➡
Dialogue: 0,0:09:57.76,0:10:00.26,Default,,0,0,0,,Көлеңке әскерін шеберлікпен шақыр.
Dialogue: 0,0:10:00.26,0:10:02.26,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:10:02.26,0:10:04.77,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:10:04.77,0:10:06.80,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:10:06.80,0:10:10.27,Default,,0,0,0,,Критикалық триггер! Shadow Army Пауэр Plus 10000➡
Dialogue: 0,0:10:10.27,0:10:12.74,Default,,0,0,0,,Артисарияның сыни плюс 1.
Dialogue: 0,0:10:14.24,0:10:17.25,Default,,0,0,0,,Көлеңке әскерімен шабуыл. күзетші.
Dialogue: 0,0:10:17.25,0:10:19.75,Default,,0,0,0,,Басқа көлеңкелі армиямен шабуыл.
Dialogue: 0,0:10:19.75,0:10:23.32,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:10:23.32,0:10:27.92,Default,,0,0,0,,Менің саған кеше айтқаным есіңде ме?
Dialogue: 0,0:10:27.92,0:10:30.89,Default,,0,0,0,,)
Dialogue: 0,0:10:33.76,0:10:36.26,Default,,0,0,0,,Сіздің ішіңізде ештеңе жоқ➡
Dialogue: 0,0:10:36.26,0:10:40.27,Default,,0,0,0,,Сіз нөлсіз.
Dialogue: 0,0:10:40.27,0:10:42.27,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:10:42.27,0:10:44.27,Default,,0,0,0,,Сен екеуміз ұқсаспыз➡
Dialogue: 0,0:10:44.27,0:10:47.28,Default,,0,0,0,,Сондықтан мен оны жалғыз қалдыра алмаймын.
Dialogue: 0,0:10:47.28,0:10:49.28,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:10:49.28,0:10:51.25,Default,,0,0,0,,Бұл болмысыңыз сізді жойылуға апарады.
Dialogue: 0,0:10:51.25,0:10:53.25,Default,,0,0,0,,Сақ болыңыз!
Dialogue: 0,0:10:53.25,0:10:55.25,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:10:55.25,0:10:57.25,Default,,0,0,0,,Мен білемін➡
Dialogue: 0,0:10:57.25,0:10:59.25,Default,,0,0,0,,Осылай болғандықтан➡
Dialogue: 0,0:10:59.25,0:11:02.26,Default,,0,0,0,,Болашақ болуы мүмкін барлық нәрсені жоғалтыңыз.
Dialogue: 0,0:11:02.26,0:11:05.26,Default,,0,0,0,,Ха…. Менің кезегім➡
Dialogue: 0,0:11:05.26,0:11:09.33,Default,,0,0,0,,Қараңызшы, бұл менің нөлім➡
Dialogue: 0,0:11:09.33,0:11:12.27,Default,,0,0,0,,Бастапқыға апаратын барлық заттардың жоқтығы➡
Dialogue: 0,0:11:12.27,0:11:14.34,Default,,0,0,0,,Атпен жүру.
Dialogue: 0,0:11:14.34,0:11:17.27,Default,,0,0,0,,Нөлдік тағдыр➡
Dialogue: 0,0:11:17.27,0:11:19.24,Default,,0,0,0,,Брагдомейер.
Dialogue: 0,0:11:24.25,0:11:26.75,Default,,0,0,0,,2 Бір соққымен Колосс➡
Dialogue: 0,0:11:26.75,0:11:28.72,Default,,0,0,0,,Өңдеу шеберіне қоңырау шалыңыз.
Dialogue: 0,0:11:29.72,0:11:31.75,Default,,0,0,0,,Кеттік! ➡
Dialogue: 0,0:11:31.75,0:11:34.22,Default,,0,0,0,,Брегедмейермен шабуыл➡
Dialogue: 0,0:11:34.22,0:11:36.22,Default,,0,0,0,,Дағдыларды белсендіру.
Dialogue: 0,0:11:39.23,0:11:42.76,Default,,0,0,0,,4 жанды төмен қаратып байлап, 1 картаны сал.
Dialogue: 0,0:11:42.76,0:11:47.24,Default,,0,0,0,,Содан кейін сіздің қарсыласыңыз екі артқы қорғаушыны төмен қаратып байлайды.
Dialogue: 0,0:11:47.24,0:11:49.24,Default,,0,0,0,,2 Көлеңке армиясы.
Dialogue: 0,0:11:49.24,0:11:52.74,Default,,0,0,0,,Сонымен қатар, Благдомьердің күші +10 000.
Dialogue: 0,0:11:52.74,0:11:55.24,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:11:55.24,0:11:57.75,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:11:57.75,0:12:00.25,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:12:00.25,0:12:02.25,Default,,0,0,0,,Критикалық триггер➡
Dialogue: 0,0:12:02.25,0:12:05.29,Default,,0,0,0,,Colossus қуаты плюс 10000 критикалық плюс 1.
Dialogue: 0,0:12:05.29,0:12:09.26,Default,,0,0,0,,Ұрыс соңында сиқыршының шеберлігі іске қосылады.
Dialogue: 0,0:12:09.26,0:12:12.23,Default,,0,0,0,,Қолыңызға 1 жанның қалыпты бірлігін қосыңыз➡
Dialogue: 0,0:12:12.23,0:12:14.73,Default,,0,0,0,,Сахна артында өзіңізді байлаңыз➡
Dialogue: 0,0:12:14.73,0:12:16.76,Default,,0,0,0,,Колосспен шабуыл.
Dialogue: 0,0:12:16.76,0:12:19.27,Default,,0,0,0,,Күзетші жоқ. Colossus дағдылары➡
Dialogue: 0,0:12:19.27,0:12:21.74,Default,,0,0,0,,Ұрыс соңында өзіңізді жанға қойыңыз➡
Dialogue: 0,0:12:21.74,0:12:24.77,Default,,0,0,0,,Содан кейін оны кері байлап, 1 картаны тартыңыз➡
Dialogue: 0,0:12:24.77,0:12:29.24,Default,,0,0,0,,Сонымен қатар, қолыңызға шебердің шеберлігінің бір картасын қосыңыз➡
Dialogue: 0,0:12:29.24,0:12:31.25,Default,,0,0,0,,Сахна артында өзіңізді байлаңыз➡
Dialogue: 0,0:12:31.25,0:12:33.25,Default,,0,0,0,,Колосспен шабуыл.
Dialogue: 0,0:12:33.25,0:12:36.22,Default,,0,0,0,,Күзет. Colossus дағдылары➡
Dialogue: 0,0:12:36.22,0:12:39.22,Default,,0,0,0,,Бетіңізді төмен қаратып байлаңыз және 1 картаны салыңыз➡
Dialogue: 0,0:12:39.22,0:12:41.72,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:41.72,0:12:44.73,Default,,0,0,0,,Жарайсың, Йоцуги-сенпай, дәмді!
Dialogue: 0,0:12:44.73,0:12:46.79,Default,,0,0,0,,Е...не?
Dialogue: 0,0:12:46.79,0:12:49.73,Default,,0,0,0,,Дағдылары бар тақтадан жоғалатын бірліктерді ғана пайдаланыңыз➡
Dialogue: 0,0:12:49.73,0:12:52.23,Default,,0,0,0,,Бұрылыс бірде-бір қорғаушысыз аяқталды!
Dialogue: 0,0:12:52.23,0:12:55.77,Default,,0,0,0,,Сонымен? Оны құлыптау мүмкін емес, себебі мақсат жоқ.
Dialogue: 0,0:12:55.77,0:12:59.74,Default,,0,0,0,,Енді сізге келесі кезекте шабуыл жасау шектелмейді!
Dialogue: 0,0:12:59.74,0:13:01.74,Default,,0,0,0,,Ал...білмеймін.➡
Dialogue: 0,0:13:01.74,0:13:04.25,Default,,0,0,0,,Жаса, Суо!
Dialogue: 0,0:13:04.25,0:13:06.75,Default,,0,0,0,,Тақтаны өшіру арқылы құлыптауды болдырмау➡
Dialogue: 0,0:13:06.75,0:13:10.25,Default,,0,0,0,,Әрине, бұл әдіс бұрыннан қабылданған.
Dialogue: 0,0:13:10.25,0:13:13.22,Default,,0,0,0,,Бірақ қозғалыс мәжбүр болған кезде➡
Dialogue: 0,0:13:13.22,0:13:16.26,Default,,0,0,0,,Көрінбейтін сиқырдың құрсауында қалу үшін де солай.
Dialogue: 0,0:13:16.26,0:13:18.23,Default,,0,0,0,,Менің күресім қайтпас.
Dialogue: 0,0:13:18.23,0:13:21.23,Default,,0,0,0,,Менің ұрысым...?
Dialogue: 0,0:13:21.23,0:13:23.77,Default,,0,0,0,,Өзгеріс жоқ Айырмашылығы жоқ бұл мен...
Dialogue: 0,0:13:23.77,0:13:26.23,Default,,0,0,0,,Жоқ! а….
Dialogue: 0,0:13:26.23,0:13:28.74,Default,,0,0,0,,Сіз өз сөзіңізде жоқсыз.
Dialogue: 0,0:13:28.74,0:13:30.77,Default,,0,0,0,,Бәрі де солай➡
Dialogue: 0,0:13:30.77,0:13:33.24,Default,,0,0,0,,Берілген сөздерді қайталасаңыз➡
Dialogue: 0,0:13:33.24,0:13:35.74,Default,,0,0,0,,Қуыршақтан айырмашылығы жоқ.
Dialogue: 0,0:13:35.74,0:13:37.75,Default,,0,0,0,,Нағыз сен қайдасың? ➡
Dialogue: 0,0:13:37.75,0:13:39.71,Default,,0,0,0,,Рокуоин Сузуне.
Dialogue: 0,0:13:43.25,0:13:46.72,Default,,0,0,0,,Қуыршақ болса да маңызды емес... а....
Dialogue: 0,0:13:46.72,0:13:49.26,Default,,0,0,0,,Жеңіске жете алмаған күрескердің құны жоқ➡
Dialogue: 0,0:13:49.26,0:13:53.23,Default,,0,0,0,,Жеңіске жету үшін мен болуым міндетті емес➡
Dialogue: 0,0:13:53.23,0:13:55.73,Default,,0,0,0,,Қуыршақ болуы мүмкін, бос болса да...
Dialogue: 0,0:13:59.73,0:14:01.74,Default,,0,0,0,,Маған өзімнің шынайы адамым керек емес➡
Dialogue: 0,0:14:01.74,0:14:03.74,Default,,0,0,0,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:14:03.74,0:14:05.74,Default,,0,0,0,,Он көлеңке техникасы
Dialogue: 0,0:14:05.74,0:14:08.24,Default,,0,0,0,,Rokuoin жақсы!
Dialogue: 0,0:14:08.24,0:14:10.75,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:14:10.75,0:14:13.25,Default,,0,0,0,,Persona Ride! Артисария.
Dialogue: 0,0:14:13.25,0:14:16.72,Default,,0,0,0,,Шеберлікпен айқайлауды көлеңкеде орнатыңыз➡
Dialogue: 0,0:14:16.72,0:14:20.22,Default,,0,0,0,,Сол дағдымен көлеңкелі әскерді шақырыңыз➡
Dialogue: 0,0:14:20.22,0:14:24.26,Default,,0,0,0,,Люминоэльге көлеңкелі армияны шеберлікпен шақырыңыз➡
Dialogue: 0,0:14:24.26,0:14:27.23,Default,,0,0,0,,Жеңіс ырғағын мәңгі сақта➡
Dialogue: 0,0:14:27.23,0:14:30.23,Default,,0,0,0,,Менің өмір сүруімнің жалғыз себебі осы.
Dialogue: 0,0:14:30.23,0:14:32.23,Default,,0,0,0,,Люминоэльмен шабуыл.
Dialogue: 0,0:14:32.23,0:14:36.24,Default,,0,0,0,,Күзетші. Luminoel-ді шеберлікпен қайтарыңыз➡
Dialogue: 0,0:14:36.24,0:14:38.74,Default,,0,0,0,,Көлеңке әскерімен шабуыл.
Dialogue: 0,0:14:38.74,0:14:41.24,Default,,0,0,0,,Күзетші жоқ. Артисарияда ➡
Dialogue: 0,0:14:41.24,0:14:43.24,Default,,0,0,0,,Авангардқа шабуыл жасаңыз.
Dialogue: 0,0:14:43.24,0:14:46.25,Default,,0,0,0,,2 Shadow Army картасын шақыру үшін шеберлікті пайдаланыңыз➡
Dialogue: 0,0:14:46.25,0:14:48.22,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 5000.
Dialogue: 0,0:14:58.73,0:15:01.23,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:15:01.23,0:15:03.77,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:15:03.77,0:15:05.77,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:15:05.77,0:15:09.74,Default,,0,0,0,,Критикалық триггер көлеңкелі армияның қуаты +10000➡
Dialogue: 0,0:15:09.74,0:15:11.74,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:15:11.74,0:15:14.24,Default,,0,0,0,,Көлеңке әскерімен шабуыл.
Dialogue: 0,0:15:14.24,0:15:16.24,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:15:16.24,0:15:19.25,Default,,0,0,0,,Міне, тағы бір көлеңкелі армия➡
Dialogue: 0,0:15:19.25,0:15:21.25,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:15:21.25,0:15:23.22,Default,,0,0,0,,Әлі жоқ... Күзетші!
Dialogue: 0,0:15:25.22,0:15:27.26,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:15:27.26,0:15:30.22,Default,,0,0,0,,Ол құлыпталмаған болса да...
Dialogue: 0,0:15:30.22,0:15:32.23,Default,,0,0,0,,Қолда 1 карта➡ қалды
Dialogue: 0,0:15:32.23,0:15:34.73,Default,,0,0,0,,Тақтаға келетін болсақ...
Dialogue: 0,0:15:34.73,0:15:36.73,Default,,0,0,0,,Бұл нөл...
Dialogue: 0,0:15:39.73,0:15:42.24,Default,,0,0,0,,Мен бұл көріністі көптен бері қарап жүрмін➡
Dialogue: 0,0:15:42.24,0:15:44.74,Default,,0,0,0,,Ештеңе, ешкім.
Dialogue: 0,0:15:44.74,0:15:46.71,Default,,0,0,0,,Нөл әлемі.
Dialogue: 0,0:15:49.74,0:15:51.75,Default,,0,0,0,,Мен бос өмір сүрдім➡
Dialogue: 0,0:15:51.75,0:15:54.25,Default,,0,0,0,,Мен ештеңе сезбейтін күндер ➡
Dialogue: 0,0:15:54.25,0:15:57.25,Default,,0,0,0,,Бұл тіпті ауыртпайды, бұл жоқтық.
Dialogue: 0,0:15:57.25,0:16:01.26,Default,,0,0,0,,Бірақ...Мен оны сезбедім➡
Dialogue: 0,0:16:01.26,0:16:03.72,Default,,0,0,0,,Бұл адам төзгісіз ауырсыну.
Dialogue: 0,0:16:03.72,0:16:06.23,Default,,0,0,0,,Эй! Эй!
Dialogue: 0,0:16:06.23,0:16:08.23,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:16:11.23,0:16:13.73,Default,,0,0,0,,Өзіңіздің шынайы тұлғаңызды табыңыз.
Dialogue: 0,0:16:15.24,0:16:17.24,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:16:17.24,0:16:19.24,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:19.24,0:16:21.71,Default,,0,0,0,,Мен үшін ештеңе...
Dialogue: 0,0:16:22.74,0:16:24.75,Default,,0,0,0,,Өйткені ештеңе жоқ...
Dialogue: 0,0:16:24.75,0:16:26.75,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:16:26.75,0:16:28.72,Default,,0,0,0,,E?
Dialogue: 0,0:16:28.72,0:16:30.82,Default,,0,0,0,,Рокуоин Сузуне➡
Dialogue: 0,0:16:30.82,0:16:34.22,Default,,0,0,0,,Мен бұрынғыдайсың, нөлде қаласың.
Dialogue: 0,0:16:34.22,0:16:36.29,Default,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,0:16:36.29,0:16:40.26,Default,,0,0,0,,Мен саяхатымды нөлден бастап, көп нәрсеге қол жеткіздім ➡
Dialogue: 0,0:16:40.26,0:16:43.26,Default,,0,0,0,,Брагдомьердің эволюциясы!
Dialogue: 0,0:16:43.26,0:16:45.73,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:16:45.73,0:16:51.24,Default,,0,0,0,,Жоқтан пайда болатын заттардың бірі.
Dialogue: 0,0:16:51.24,0:16:54.78,Default,,0,0,0,,Persona Ride! ➡
Dialogue: 0,0:16:54.78,0:17:00.25,Default,,0,0,0,,Нөлден жүретіндер, Blagdomyer Nexus!
Dialogue: 0,0:17:02.22,0:17:05.22,Default,,0,0,0,,Bragdomyer Nexus шеберлігін белсендіру.
Dialogue: 0,0:17:09.76,0:17:11.76,Default,,0,0,0,,4 жанды төмен қаратып байлау➡
Dialogue: 0,0:17:11.76,0:17:14.76,Default,,0,0,0,,Қарсылас екі артқы қорғаушыны төмен қаратып байлайды.
Dialogue: 0,0:17:18.77,0:17:23.24,Default,,0,0,0,,Артқы жағында байланған әрбір 2 карта үшін қуатыңызға 5000 қосыңыз➡
Dialogue: 0,0:17:23.24,0:17:26.74,Default,,0,0,0,,Байланыс - 12 карта, сондықтан қуат плюс 30 000!
Dialogue: 0,0:17:26.74,0:17:29.24,Default,,0,0,0,,Артқы жағынан әрі қарай➡
Dialogue: 0,0:17:29.24,0:17:31.75,Default,,0,0,0,,Ведрокке қоңырау шалыңыз!
Dialogue: 0,0:17:31.75,0:17:34.25,Default,,0,0,0,,Брагдомердің шеберлігімен...
Dialogue: 0,0:17:34.25,0:17:36.22,Default,,0,0,0,,Мен достарыма қоңырау шалдым!
Dialogue: 0,0:17:36.22,0:17:40.72,Default,,0,0,0,,Ведроктың шеберлігімен Жаннан Замугқа қоңырау шалыңыз➡
Dialogue: 0,0:17:40.72,0:17:43.26,Default,,0,0,0,,Zamoog шеберлігімен 1 картаны салыңыз➡
Dialogue: 0,0:17:43.26,0:17:45.23,Default,,0,0,0,,Шеберге➡ қоңырау шалыңыз
Dialogue: 0,0:17:45.23,0:17:47.73,Default,,0,0,0,,Және 2 хакерді шақырыңыз!
Dialogue: 0,0:17:49.73,0:17:52.73,Default,,0,0,0,,Ол нөл болуы керек еді...
Dialogue: 0,0:17:52.73,0:17:55.77,Default,,0,0,0,,Braggedmeyer Nexus➡ үшін қосымша дағдылар
Dialogue: 0,0:17:55.77,0:17:59.24,Default,,0,0,0,,Брегедмейердің жандағы құдайлық шеберлігін алыңыз➡
Dialogue: 0,0:17:59.24,0:18:02.78,Default,,0,0,0,,Алдыңғы қатардағы артқы қорғаныс қуаты плюс 5000.
Dialogue: 0,0:18:02.78,0:18:07.75,Default,,0,0,0,,Wizard's Boost Braggedmeyer Nexus көмегімен авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:07.75,0:18:11.22,Default,,0,0,0,,Бос деп ойлаған ішім де➡
Dialogue: 0,0:18:11.22,0:18:13.72,Default,,0,0,0,,Мен Авангардты ұнатқандай болдым.
Dialogue: 0,0:18:13.72,0:18:16.72,Default,,0,0,0,,Сізде де біреу болуы керек.
Dialogue: 0,0:18:16.72,0:18:19.23,Default,,0,0,0,,Өзін-өзі тануға ұмтылу➡
Dialogue: 0,0:18:19.23,0:18:21.26,Default,,0,0,0,,Өз сөзіңізбен сөйлеңіз➡
Dialogue: 0,0:18:21.26,0:18:23.76,Default,,0,0,0,,Өз аяғыммен жүруге талпыныс.
Dialogue: 0,0:18:23.76,0:18:26.73,Default,,0,0,0,,Бастауды алу үшін сізге➡ қажет
Dialogue: 0,0:18:26.73,0:18:29.74,Default,,0,0,0,,Нөлді біл!
Dialogue: 0,0:18:29.74,0:18:31.74,Default,,0,0,0,,Ха...!
Dialogue: 0,0:18:31.74,0:18:33.74,Default,,0,0,0,,Құдайдың шеберлігі➡
Dialogue: 0,0:18:33.74,0:18:35.74,Default,,0,0,0,,Өрнек.
Dialogue: 0,0:18:35.74,0:18:39.78,Default,,0,0,0,,Благдомейердің сыни плюс 1➡
Dialogue: 0,0:18:39.78,0:18:42.28,Default,,0,0,0,,Және қарсыласыңыздың келесі айналымының соңына дейін➡
Dialogue: 0,0:18:42.28,0:18:45.22,Default,,0,0,0,,Қарсыластың авангарды барлық қабілеттерін жоғалтады➡
Dialogue: 0,0:18:45.22,0:18:47.72,Default,,0,0,0,,Толық қорғанысты пайдалану мүмкін емес.
Dialogue: 0,0:18:49.72,0:18:51.73,Default,,0,0,0,,Бұл... нөл.
Dialogue: 0,0:18:51.73,0:18:53.73,Default,,0,0,0,,Рокуоин Сузуне➡
Dialogue: 0,0:18:53.73,0:18:55.73,Default,,0,0,0,,Тізбек….
Dialogue: 0,0:18:55.73,0:18:57.73,Default,,0,0,0,,Мен оны кесіп тастаймын!
Dialogue: 0,0:18:59.73,0:19:01.74,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:19:11.25,0:19:15.22,Default,,0,0,0,,Zamoog +5000 қуатпен шабуыл жасау шеберлігі➡
Dialogue: 0,0:19:15.22,0:19:17.72,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:19:17.72,0:19:19.72,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:19:20.76,0:19:22.72,Default,,0,0,0,,Бұл енді менмін!
Dialogue: 0,0:19:22.72,0:19:24.73,Default,,0,0,0,,Hacker Boost➡
Dialogue: 0,0:19:24.73,0:19:27.23,Default,,0,0,0,,Авангардқа Ведрокпен шабуыл жасаңыз!
Dialogue: 0,0:19:35.74,0:19:37.71,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:19:42.74,0:19:46.21,Default,,0,0,0,,Жоқ... күзетші.
Dialogue: 0,0:19:51.22,0:19:53.25,Default,,0,0,0,,Жеңімпаз! ➡
Dialogue: 0,0:19:53.25,0:19:55.26,Default,,0,0,0,,Үздіксіз Суоу!
Dialogue: 0,0:19:55.26,0:19:58.26,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:58.26,0:20:02.26,Default,,0,0,0,,Цуджикири жауынгері Шишидің ерлігі! ➡
Dialogue: 0,0:20:02.26,0:20:05.77,Default,,0,0,0,,Ең мықты болу үшін финалға өтіңіз!
Dialogue: 0,0:20:07.23,0:20:10.24,Default,,0,0,0,,Рокуоин Сузуне. жоғары.
Dialogue: 0,0:20:10.24,0:20:13.24,Default,,0,0,0,,Менімен дос бол.
Dialogue: 0,0:20:13.24,0:20:15.24,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:20:15.24,0:20:18.25,Default,,0,0,0,,Хэхе... Жақсы емес пе?
Dialogue: 0,0:20:18.25,0:20:21.25,Default,,0,0,0,,Карамель. а….
Dialogue: 0,0:20:21.25,0:20:23.22,Default,,0,0,0,,Сүйікті тағам➡
Dialogue: 0,0:20:23.22,0:20:25.22,Default,,0,0,0,,Карамель.
Dialogue: 0,0:20:25.22,0:20:27.22,Default,,0,0,0,,Фу….
Dialogue: 0,0:20:30.26,0:20:32.23,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:20:32.23,0:20:35.23,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:20:35.23,0:20:38.23,Default,,0,0,0,,Рокуоинде қалсаңыз, жеңе алмайсыз!
Dialogue: 0,0:20:38.23,0:20:42.74,Default,,0,0,0,,Рокуоинді осылай менсінбейсің!
Dialogue: 0,0:20:42.74,0:20:45.24,Default,,0,0,0,,Мен өзгерткім келеді.
Dialogue: 0,0:20:45.24,0:20:47.74,Default,,0,0,0,,Нағыз мықты жауынгерлер үшін➡
Dialogue: 0,0:20:47.74,0:20:50.24,Default,,0,0,0,,Мен ешқашан ауытқымайтын Мен бар екенін білдім➡
Dialogue: 0,0:20:50.24,0:20:53.75,Default,,0,0,0,,Менде де ондай жоқ.
Dialogue: 0,0:20:53.75,0:20:56.22,Default,,0,0,0,,Мен өзімді тапқым келеді.
Dialogue: 0,0:20:56.22,0:20:59.72,Default,,0,0,0,,Мен сөздің шын мағынасында күшті болғым келеді.
Dialogue: 0,0:20:59.72,0:21:01.72,Default,,0,0,0,,Мен бір➡ алдым
Dialogue: 0,0:21:01.72,0:21:04.73,Default,,0,0,0,,Сузунэ Рокуоин ең күшті➡
Dialogue: 0,0:21:04.73,0:21:06.73,Default,,0,0,0,,Мен дәлелдеймін!
Dialogue: 0,0:21:06.73,0:21:10.23,Default,,0,0,0,,Rokuoin-ге жаңа желім салсақ ше?
Dialogue: 0,0:21:10.23,0:21:12.23,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:21:14.74,0:21:16.70,Default,,0,0,0,,Қалағаныңды істе.
Dialogue: 0,0:21:21.71,0:21:25.25,Default,,0,0,0,,Рокуоиннің бай тарихы бар➡
Dialogue: 0,0:21:25.25,0:21:28.75,Default,,0,0,0,,Енді сіз резервуарыңызды кесіп тастадыңыз➡
Dialogue: 0,0:21:28.75,0:21:30.75,Default,,0,0,0,,Оны орындаңыз.
Dialogue: 0,0:21:32.22,0:21:34.22,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:21:34.22,0:21:36.22,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:46.27,0:21:49.24,Default,,0,0,0,,Толқу Мен оған тоймайтын сияқтымын.
Dialogue: 0,0:21:49.24,0:21:51.77,Default,,0,0,0,,Бұл тамаша жекпе-жек болды.
Dialogue: 0,0:21:51.77,0:21:54.28,Default,,0,0,0,,Біз де ұтыла алмаймыз! Мен келісемін!
Dialogue: 0,0:21:55.78,0:22:01.78,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory