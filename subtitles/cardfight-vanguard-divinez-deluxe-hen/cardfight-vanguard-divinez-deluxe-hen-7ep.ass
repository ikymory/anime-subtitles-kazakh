Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.33,0:00:05.30,Default,,0,0,0,,((мен жеңдім.
Dialogue: 0,0:00:11.74,0:00:14.78,Default,,0,0,0,,Енді, келесі.
Dialogue: 0,0:00:14.78,0:00:17.25,Default,,0,0,0,,Тұрақты Авангард.
Dialogue: 0,0:00:18.75,0:00:20.75,Default,,0,0,0,,Келесі.
Dialogue: 0,0:00:22.75,0:00:24.72,Default,,0,0,0,,Келесі.
Dialogue: 0,0:00:30.89,0:00:34.36,Default,,0,0,0,,)
Dialogue: 0,0:00:35.33,0:00:37.27,Default,,0,0,0,,((Дененің шектері➡
Dialogue: 0,0:00:37.27,0:00:39.74,Default,,0,0,0,,Ақылдың шегінен тыс➡
Dialogue: 0,0:00:39.74,0:00:41.77,Default,,0,0,0,,Авангардтың биіктігі➡
Dialogue: 0,0:00:41.77,0:00:44.31,Default,,0,0,0,,Әлі ешкім білмейтін жерге➡
Dialogue: 0,0:00:44.31,0:00:46.31,Default,,0,0,0,,жету үшін... ))
Dialogue: 0,0:00:47.41,0:00:50.75,Default,,0,0,0,,)
Dialogue: 0,0:00:50.75,0:00:52.75,Default,,0,0,0,,Фу….
Dialogue: 0,0:00:52.75,0:00:54.75,Default,,0,0,0,,Уақыт келді.
Dialogue: 0,0:01:00.26,0:01:02.26,Default,,0,0,0,,кеттік➡
Dialogue: 0,0:01:02.26,0:01:04.26,Default,,0,0,0,,Дораджуэлдо.
Dialogue: 0,0:01:31.25,0:01:34.76,Default,,0,0,0,,Әдептілік. Тәртіп... иә?
Dialogue: 0,0:01:36.29,0:01:39.26,Default,,0,0,0,,Бұл маған сол кездегі ең бөтен сөз болуы мүмкін.
Dialogue: 0,0:01:53.24,0:01:55.24,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:02:01.25,0:02:03.25,Default,,0,0,0,,Мичиру….
Dialogue: 0,0:02:03.25,0:02:05.25,Default,,0,0,0,,Ым?
Dialogue: 0,0:02:05.25,0:02:07.22,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:02:09.26,0:02:11.33,Default,,0,0,0,,Идиот➡
Dialogue: 0,0:02:11.33,0:02:13.33,Default,,0,0,0,,Кеш! ))
Dialogue: 0,0:03:49.26,0:03:51.29,Default,,0,0,0,,Ақыры ояндың➡
Dialogue: 0,0:03:51.29,0:03:53.76,Default,,0,0,0,,Ол сол виртуалды кеңістікте қалды➡
Dialogue: 0,0:03:53.76,0:03:56.30,Default,,0,0,0,,Баяғыда сияқты.
Dialogue: 0,0:03:56.30,0:03:58.23,Default,,0,0,0,,📱Бұл ұзақ болды.
Dialogue: 0,0:03:58.23,0:04:00.24,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:00.24,0:04:02.24,Default,,0,0,0,,Менімен хабарласқаныңызға рахмет➡
Dialogue: 0,0:04:02.24,0:04:04.24,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:04:06.24,0:04:08.24,Default,,0,0,0,,Хаа….
Dialogue: 0,0:04:10.25,0:04:12.75,Default,,0,0,0,,Жоғары➡
Dialogue: 0,0:04:12.75,0:04:14.75,Default,,0,0,0,,Түсінікті➡
Dialogue: 0,0:04:14.75,0:04:16.72,Default,,0,0,0,,Олай болса...сәлем.
Dialogue: 0,0:04:17.75,0:04:21.22,Default,,0,0,0,,Жақсы... шынымен!
Dialogue: 0,0:04:23.33,0:04:25.26,Default,,0,0,0,,((Мен міндетті түрде ➡
Dialogue: 0,0:04:25.26,0:04:28.73,Default,,0,0,0,,Мен сенен асып түсетін күрескер боламын!
Dialogue: 0,0:04:30.73,0:04:32.73,Default,,0,0,0,,Сол кәсіпқой ретінде➡
Dialogue: 0,0:04:32.73,0:04:34.80,Default,,0,0,0,,Қайта төбелесіп кездесейік.
Dialogue: 0,0:04:34.80,0:04:37.77,Default,,0,0,0,,Мен нәтиже шығаруды жалғастырамын, Мичиру-сан.
Dialogue: 0,0:04:38.81,0:04:41.31,Default,,0,0,0,,Мен сенімдімін...! ))
Dialogue: 0,0:04:44.75,0:04:47.25,Default,,0,0,0,,Сіз ауруханадан қазір шыға аласыз.
Dialogue: 0,0:04:47.25,0:04:49.75,Default,,0,0,0,,Әлі ерте емес пе?
Dialogue: 0,0:04:49.75,0:04:51.75,Default,,0,0,0,,Мен ауруханадан шаршадым.
Dialogue: 0,0:04:51.75,0:04:54.26,Default,,0,0,0,,Оңалту біраз уақытқа созылатын шығар.
Dialogue: 0,0:04:54.26,0:04:56.26,Default,,0,0,0,,Түсіндім...Мен бақыттымын➡
Dialogue: 0,0:04:56.26,0:04:58.76,Default,,0,0,0,,Осы уақытқа дейін сауыққаныңыз үшін рахмет.
Dialogue: 0,0:04:58.76,0:05:00.73,Default,,0,0,0,,Мичиру шынымен кешірім сұраймын➡
Dialogue: 0,0:05:00.73,0:05:03.27,Default,,0,0,0,,Сол кезде мен өзімді мәжбүрледім➡
Dialogue: 0,0:05:03.27,0:05:05.23,Default,,0,0,0,,Мен сені тоқтатуым керек еді.
Dialogue: 0,0:05:05.23,0:05:07.24,Default,,0,0,0,,Кешірім сұрайтын ештеңе жоқ➡
Dialogue: 0,0:05:07.24,0:05:09.74,Default,,0,0,0,,Мен оны өзім таңдадым.
Dialogue: 0,0:05:09.74,0:05:11.77,Default,,0,0,0,,Ол тіпті күнәларды да өтемейді➡
Dialogue: 0,0:05:11.77,0:05:14.78,Default,,0,0,0,,Мен сені оятудың жолын іздедім.
Dialogue: 0,0:05:14.78,0:05:17.75,Default,,0,0,0,,Мен озық медициналық көмек арқылы бірдеңе істей аламын деп ойладым➡
Dialogue: 0,0:05:17.75,0:05:20.28,Default,,0,0,0,,Мен оны американдық ауруханаға алып келдім➡
Dialogue: 0,0:05:20.28,0:05:24.25,Default,,0,0,0,,Ақырында қазіргі медицина жол таба алмады.
Dialogue: 0,0:05:24.25,0:05:26.76,Default,,0,0,0,,Дәрігерлердің өзі бастарын тырнап жатыр.
Dialogue: 0,0:05:26.76,0:05:28.76,Default,,0,0,0,,Неге ояндың?➡
Dialogue: 0,0:05:28.76,0:05:30.73,Default,,0,0,0,,Бұл керемет.
Dialogue: 0,0:05:31.76,0:05:33.73,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:05:33.73,0:05:35.73,Default,,0,0,0,,Өзіңізді әлі тым қатты итермеңіз.
Dialogue: 0,0:05:35.73,0:05:37.77,Default,,0,0,0,,бәрі жақсы.
Dialogue: 0,0:05:37.77,0:05:40.24,Default,,0,0,0,,Менің денем күңгірт, бірақ физикалық жағдайым біршама ➡
Dialogue: 0,0:05:40.24,0:05:42.24,Default,,0,0,0,,Бұрынғыдан жақсырақ.
Dialogue: 0,0:05:42.24,0:05:44.27,Default,,0,0,0,,Мен енді құламаймын.
Dialogue: 0,0:05:44.27,0:05:46.24,Default,,0,0,0,,Қайтып келгеннен бері өзімді әлдеқайда жақсы сезінемін.
Dialogue: 0,0:05:46.24,0:05:48.24,Default,,0,0,0,,Және➡
Dialogue: 0,0:05:48.24,0:05:50.25,Default,,0,0,0,,Әлем басқаша көрінеді.
Dialogue: 0,0:05:54.78,0:05:57.75,Default,,0,0,0,,Мен де ол үшін үнемі уайымдадым.
Dialogue: 0,0:05:57.75,0:06:00.79,Default,,0,0,0,,Саған жақсылық, Шабдалы тауы.
Dialogue: 0,0:06:00.79,0:06:04.26,Default,,0,0,0,,Енді сен маған күнде ұрысамын деп айқайлайсың...
Dialogue: 0,0:06:04.26,0:06:07.23,Default,,0,0,0,,Хаха...! Сіздің жақсы екеніңізді көру өте жақсы.
Dialogue: 0,0:06:07.23,0:06:10.27,Default,,0,0,0,,Мен жай ғана жақсы емеспін...
Dialogue: 0,0:06:10.27,0:06:12.27,Default,,0,0,0,,Ол шынымен де➡
Dialogue: 0,0:06:12.27,0:06:15.77,Default,,0,0,0,,Авангардтың биігіне жеткен соң қайтып келген шығар.
Dialogue: 0,0:06:16.74,0:06:19.24,Default,,0,0,0,,Бұрынғыдан күштірек пе? Ах➡
Dialogue: 0,0:06:19.24,0:06:22.24,Default,,0,0,0,,Ол бұрын да құбыжық болған➡
Dialogue: 0,0:06:22.24,0:06:24.75,Default,,0,0,0,,Енді бұл➡ сияқты
Dialogue: 0,0:06:24.75,0:06:26.72,Default,,0,0,0,,Басқа өлшемдегі болмыс сияқты сезіледі.
Dialogue: 0,0:06:28.25,0:06:30.25,Default,,0,0,0,,3-ші люкс➡
Dialogue: 0,0:06:30.25,0:06:32.25,Default,,0,0,0,,Біріншіден, бұл Мичиру.
Dialogue: 0,0:06:32.25,0:06:34.26,Default,,0,0,0,,Әрине.
Dialogue: 0,0:06:34.26,0:06:37.26,Default,,0,0,0,,Қалғаны... Ақыр аяғында бұлар болса керек.
Dialogue: 0,0:06:37.26,0:06:39.26,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:39.26,0:06:42.23,Default,,0,0,0,,Сіз шыға аласыз ба? Акина жігіттер.
Dialogue: 0,0:06:50.77,0:06:52.74,Default,,0,0,0,,Мен соңғы кездері осында көп болдым.
Dialogue: 0,0:06:52.74,0:06:55.24,Default,,0,0,0,,Мен мұнда жалғыз ойлағым келгенде келемін.
Dialogue: 0,0:06:55.24,0:06:58.25,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:06:58.25,0:07:00.25,Default,,0,0,0,,Жоқ, бірақ➡
Dialogue: 0,0:07:00.25,0:07:02.25,Default,,0,0,0,,Данжи мұнда қанша уақыт қалады?
Dialogue: 0,0:07:02.25,0:07:04.25,Default,,0,0,0,,Жасыру! ➡
Dialogue: 0,0:07:04.25,0:07:06.25,Default,,0,0,0,,Мен сенің қамқорыңмын!
Dialogue: 0,0:07:06.25,0:07:08.26,Default,,0,0,0,,Қайта оғаш ештеңе жасама➡
Dialogue: 0,0:07:08.26,0:07:10.26,Default,,0,0,0,,Маған сенің мені бақылап отыруың керек.
Dialogue: 0,0:07:10.26,0:07:13.73,Default,,0,0,0,,Өтінемін, бұрынғыдай өзіңізді мәжбүрлемеңіз.
Dialogue: 0,0:07:13.73,0:07:17.27,Default,,0,0,0,,Мен бұл мүмкін емес деп айтқым келген жоқ.
Dialogue: 0,0:07:17.27,0:07:20.77,Default,,0,0,0,,Барлық уақытыңызды Vanguard-да өткізіңіз.
Dialogue: 0,0:07:20.77,0:07:24.24,Default,,0,0,0,,Тек шын денемен қиын болды.
Dialogue: 0,0:07:24.24,0:07:26.24,Default,,0,0,0,,Әрине, ақымақ.
Dialogue: 0,0:07:26.24,0:07:28.74,Default,,0,0,0,,Мм, қазір бәрі жақсы.
Dialogue: 0,0:07:29.74,0:07:32.28,Default,,0,0,0,,Ол жақта қалай болды?
Dialogue: 0,0:07:32.28,0:07:35.28,Default,,0,0,0,,Сіз көздеген Авангардтың биіктігі➡
Dialogue: 0,0:07:35.28,0:07:38.25,Default,,0,0,0,,Сіз оған виртуалды кеңістікте қол жеткізе алдыңыз ба?
Dialogue: 0,0:07:38.25,0:07:40.29,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:07:40.29,0:07:42.26,Default,,0,0,0,,Гай мақсат еткен соңғы шайқас➡ болды
Dialogue: 0,0:07:42.26,0:07:44.29,Default,,0,0,0,,Шынымен де ең соңғы➡
Dialogue: 0,0:07:44.29,0:07:47.26,Default,,0,0,0,,Оған жалғыз адамның жете алатыны күмәнді.
Dialogue: 0,0:07:48.23,0:07:50.80,Default,,0,0,0,,Бірақ әдетте мүмкін емес➡
Dialogue: 0,0:07:50.80,0:07:53.74,Default,,0,0,0,,Мыңдаған, мыңдаған ұрыстардан кейін➡
Dialogue: 0,0:07:53.74,0:07:56.74,Default,,0,0,0,,Уақыт деген ұғымды да ұмытыңыз➡
Dialogue: 0,0:07:56.74,0:07:58.77,Default,,0,0,0,,Мен Авангардтың мәні сияқтымын➡
Dialogue: 0,0:07:58.77,0:08:02.24,Default,,0,0,0,,Мен осындай бір нәрсені байқап қалғандай болдым.
Dialogue: 0,0:08:02.24,0:08:05.28,Default,,0,0,0,,Олар бекер қайтып келмейді.
Dialogue: 0,0:08:05.28,0:08:08.25,Default,,0,0,0,,Қолыңыздан келгеннің барлығын сол жерде жасаған кезде➡
Dialogue: 0,0:08:08.25,0:08:10.75,Default,,0,0,0,,Мен тағы да бәрімен төбелескім келді.
Dialogue: 0,0:08:10.75,0:08:13.72,Default,,0,0,0,,Мен Данжимен болған жекпе-жек...
Dialogue: 0,0:08:14.76,0:08:16.76,Default,,0,0,0,,Тағы да.
Dialogue: 0,0:08:16.76,0:08:18.73,Default,,0,0,0,,…Таку! Сіз әрқашан➡
Dialogue: 0,0:08:18.73,0:08:20.73,Default,,0,0,0,,Айналасында тербеледі.
Dialogue: 0,0:08:20.73,0:08:22.76,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:22.76,0:08:24.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:24.73,0:08:26.74,Default,,0,0,0,,Фу….
Dialogue: 0,0:08:29.24,0:08:31.74,Default,,0,0,0,,Біраз уақыт болды, екеуің де.
Dialogue: 0,0:08:31.74,0:08:34.24,Default,,0,0,0,,О! Мен күттім.
Dialogue: 0,0:08:34.24,0:08:36.28,Default,,0,0,0,,Сен келдің... Тайзо.
Dialogue: 0,0:08:36.28,0:08:40.25,Default,,0,0,0,,Негізі мен сәл ертерек келгім келді.
Dialogue: 0,0:08:40.25,0:08:45.75,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:08:45.75,0:08:47.72,Default,,0,0,0,,Келіңіздер! Кейінірек.
Dialogue: 0,0:08:50.76,0:08:54.33,Default,,0,0,0,,Бұл шынымен жақсы ма? Осындай жерде.
Dialogue: 0,0:08:54.33,0:08:56.23,Default,,0,0,0,,Бұл ұрыс алаңы➡
Dialogue: 0,0:08:56.23,0:08:58.23,Default,,0,0,0,,Ол жұртшылық үшін ашық.
Dialogue: 0,0:08:58.23,0:09:00.24,Default,,0,0,0,,Хаха... бұл керемет.
Dialogue: 0,0:09:00.24,0:09:02.74,Default,,0,0,0,,Одан да...мені көруге келген адам➡
Dialogue: 0,0:09:02.74,0:09:04.74,Default,,0,0,0,,Бұл ұзақ әңгімелесу үшін емес, солай ма?
Dialogue: 0,0:09:06.24,0:09:08.24,Default,,0,0,0,,Аа... дұрыс➡
Dialogue: 0,0:09:08.24,0:09:10.75,Default,,0,0,0,,Біз жауынгерміз.
Dialogue: 0,0:09:10.75,0:09:12.75,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:09:12.75,0:09:15.22,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:09:19.72,0:09:21.72,Default,,0,0,0,,Джевелий Дракокид.
Dialogue: 0,0:09:21.72,0:09:24.73,Default,,0,0,0,,Блиц бойынша бас механик Бартон.
Dialogue: 0,0:09:24.73,0:09:26.73,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:09:26.73,0:09:28.76,Default,,0,0,0,,Зергерлік өзекке мініңіз➡
Dialogue: 0,0:09:28.76,0:09:31.73,Default,,0,0,0,,Энергия генераторын орнатыңыз және бұрылысты аяқтаңыз.
Dialogue: 0,0:09:31.73,0:09:33.74,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:09:33.74,0:09:35.70,Default,,0,0,0,,Стразаға барыңыз➡
Dialogue: 0,0:09:35.70,0:09:38.21,Default,,0,0,0,,Бір картаны шеберлікпен салыңыз және Стразамен шабуыл жасаңыз.
Dialogue: 0,0:09:38.21,0:09:40.71,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:40.71,0:09:44.21,Default,,0,0,0,,Бұрылыс соңы Қайтып келгеніңізге қуаныштымын➡
Dialogue: 0,0:09:44.21,0:09:46.75,Default,,0,0,0,,Шындығында сүйіспеншілік таусылды ма?➡
Dialogue: 0,0:09:46.75,0:09:48.72,Default,,0,0,0,,Шынымды айтсам, аздап ренжідім.
Dialogue: 0,0:09:48.72,0:09:50.75,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:09:50.75,0:09:54.22,Default,,0,0,0,,Тек осы дүниеде біз Авангардтың болашағын түсіне аламыз.
Dialogue: 0,0:09:54.22,0:09:56.19,Default,,0,0,0,,Болашақ осында.
Dialogue: 0,0:09:57.73,0:09:59.73,Default,,0,0,0,,Зергер Нилге міну➡
Dialogue: 0,0:09:59.73,0:10:02.73,Default,,0,0,0,,Жаннан асыл өзегін шеберлікпен ата.
Dialogue: 0,0:10:02.73,0:10:04.73,Default,,0,0,0,,Зергер Нилмен шабуыл.
Dialogue: 0,0:10:04.73,0:10:07.24,Default,,0,0,0,,Күзетші. Jewel Core көмегімен шабуыл.
Dialogue: 0,0:10:07.24,0:10:09.27,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:10:09.27,0:10:12.71,Default,,0,0,0,,Шайқастың соңында зергерлік өзегін жаныңызға салыңыз.
Dialogue: 0,0:10:12.71,0:10:14.71,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:10:15.78,0:10:17.71,Default,,0,0,0,,((Мичиру Маварима….)
Dialogue: 0,0:10:17.71,0:10:20.78,Default,,0,0,0,,Тіке, таза➡
Dialogue: 0,0:10:20.78,0:10:23.72,Default,,0,0,0,,Сондықтан ол басқалардан күшті. ))
Dialogue: 0,0:10:23.72,0:10:26.72,Default,,0,0,0,,Аа... бұл жүйкені жұқартады.
Dialogue: 0,0:10:26.72,0:10:29.26,Default,,0,0,0,,Менің кезегім: Юбаға➡ бар
Dialogue: 0,0:10:29.26,0:10:33.23,Default,,0,0,0,,Қолыңызға шабуылдаушы ұшатын Любезарды қосу дағдысын пайдаланыңыз➡
Dialogue: 0,0:10:33.23,0:10:35.23,Default,,0,0,0,,Орнату!
Dialogue: 0,0:10:35.23,0:10:37.23,Default,,0,0,0,,Түсіру комбайнын шақырыңыз➡
Dialogue: 0,0:10:37.23,0:10:39.23,Default,,0,0,0,,Бобал шахтасына қоңырау шалыңыз➡
Dialogue: 0,0:10:39.23,0:10:41.24,Default,,0,0,0,,Турмен шабуыл.
Dialogue: 0,0:10:41.24,0:10:43.20,Default,,0,0,0,,Күзетші. Юбамен шабуыл.
Dialogue: 0,0:10:43.20,0:10:45.21,Default,,0,0,0,,Любезарды дағдылармен басқарыңыз➡
Dialogue: 0,0:10:45.21,0:10:47.24,Default,,0,0,0,,1 картаны сал!
Dialogue: 0,0:10:47.24,0:10:50.21,Default,,0,0,0,,Күзетші жоқ. Комбайнмен шабуыл.
Dialogue: 0,0:10:50.21,0:10:52.21,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:10:52.21,0:10:54.28,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:10:54.28,0:10:57.22,Default,,0,0,0,,Саған да бірдеңе болды ма? Жарайды... дұрыс➡
Dialogue: 0,0:10:57.22,0:10:59.72,Default,,0,0,0,,Түсіндіру қиын нәрселер➡
Dialogue: 0,0:10:59.72,0:11:01.72,Default,,0,0,0,,Әртүрлі заттар.
Dialogue: 0,0:11:01.72,0:11:03.73,Default,,0,0,0,,Бұл өзгерді.
Dialogue: 0,0:11:03.73,0:11:06.23,Default,,0,0,0,,Жанның түсі бұрынғыдан...артық➡
Dialogue: 0,0:11:06.23,0:11:08.20,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:11:09.73,0:11:11.73,Default,,0,0,0,,Жан?
Dialogue: 0,0:11:11.73,0:11:13.77,Default,,0,0,0,,Мені не деп ойлайсың?
Dialogue: 0,0:11:13.77,0:11:15.70,Default,,0,0,0,,Мен адамдардың жан дүниесін көремін.
Dialogue: 0,0:11:15.70,0:11:18.74,Default,,0,0,0,,Уау... жаңа ғана таңғажайып нәрсе айттыңыз.
Dialogue: 0,0:11:18.74,0:11:21.28,Default,,0,0,0,,Барлығы жалын болып жанады.
Dialogue: 0,0:11:21.28,0:11:24.25,Default,,0,0,0,,Түсі әртүрлі немесе импульсі күшті➡
Dialogue: 0,0:11:24.25,0:11:27.28,Default,,0,0,0,,Адамға байланысты әр түрлі көрінеді.
Dialogue: 0,0:11:27.28,0:11:30.75,Default,,0,0,0,,Мүмкін бұл синестезия шығар?
Dialogue: 0,0:11:30.75,0:11:33.22,Default,,0,0,0,,Ым? Бұл не?
Dialogue: 0,0:11:33.22,0:11:36.22,Default,,0,0,0,,Синестезия...әріптерден түстер көру➡
Dialogue: 0,0:11:36.22,0:11:38.73,Default,,0,0,0,,Дыбыстардан иістерді сезіну➡
Dialogue: 0,0:11:38.73,0:11:41.23,Default,,0,0,0,,Бұл басқа сезім мүшелерімен қабылданатын нәрсе.
Dialogue: 0,0:11:41.23,0:11:43.23,Default,,0,0,0,,Көретін жан➡
Dialogue: 0,0:11:43.23,0:11:45.23,Default,,0,0,0,,Бес сезім мүшелерімен қабылданатын сезімдер➡
Dialogue: 0,0:11:45.23,0:11:47.24,Default,,0,0,0,,Бұл визуалды нәрсе болуы мүмкін.
Dialogue: 0,0:11:47.24,0:11:49.24,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:49.24,0:11:51.71,Default,,0,0,0,,Дәл осы сурет. Олай болса➡
Dialogue: 0,0:11:51.71,0:11:53.74,Default,,0,0,0,,Бұл саған қандай сезім береді деп ойлаймын.
Dialogue: 0,0:11:53.74,0:11:55.74,Default,,0,0,0,,Келіңіздер➡
Dialogue: 0,0:11:55.74,0:11:58.71,Default,,0,0,0,,Бірақ...бейне – күрескердің мамандығы.
Dialogue: 0,0:11:58.71,0:12:01.22,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:12:01.22,0:12:03.72,Default,,0,0,0,,Сиқырлы қазына Айдаһар Дораджуэлд➡
Dialogue: 0,0:12:03.72,0:12:05.72,Default,,0,0,0,,Жүр!
Dialogue: 0,0:12:12.73,0:12:15.23,Default,,0,0,0,,Дораджуэлд шеберлігімен жан заряды➡
Dialogue: 0,0:12:15.23,0:12:17.23,Default,,0,0,0,,1 картаны салыңыз➡
Dialogue: 0,0:12:17.23,0:12:19.77,Default,,0,0,0,,Шақыру шеберлігімен Зағанның жан заряды➡
Dialogue: 0,0:12:19.77,0:12:22.24,Default,,0,0,0,,Қолыңыздағы 4-сынып картасын ашу арқылы...
Dialogue: 0,0:12:22.24,0:12:24.74,Default,,0,0,0,,4-сынып...Қараған!
Dialogue: 0,0:12:24.74,0:12:28.71,Default,,0,0,0,,Сиқырлы тас Айдаһар Ридос Агурды Жаннан шақырыңыз.
Dialogue: 0,0:12:28.71,0:12:30.71,Default,,0,0,0,,Шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:12:30.71,0:12:32.71,Default,,0,0,0,,Ristalgalere қоңырау шалыңыз.
Dialogue: 0,0:12:35.72,0:12:37.72,Default,,0,0,0,,Ыстық~➡
Dialogue: 0,0:12:37.72,0:12:39.72,Default,,0,0,0,,Бұл сіздің карта төбелесіңіз бе?
Dialogue: 0,0:12:39.72,0:12:42.26,Default,,0,0,0,,Барайық? Лидос Агурмен шабуыл.
Dialogue: 0,0:12:42.26,0:12:45.73,Default,,0,0,0,,Күзетші. Dora Jeweled көмегімен Авангардқа шабуыл жасаңыз.
Dialogue: 0,0:12:45.73,0:12:48.26,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:12:48.26,0:12:51.77,Default,,0,0,0,,Жанды жағу арқылы әртүрлі дәрежедегі 4 карта➡
Dialogue: 0,0:12:51.77,0:12:54.74,Default,,0,0,0,,Қарсыласыңыздың авангардының күшін 1-ге дейін азайтыңыз.
Dialogue: 0,0:12:58.71,0:13:01.71,Default,,0,0,0,,Ридос Агурдың шеберлігі Өзің тұр.
Dialogue: 0,0:13:01.71,0:13:03.71,Default,,0,0,0,,Ку... күзетші жоқ.
Dialogue: 0,0:13:03.71,0:13:05.71,Default,,0,0,0,,Бірінші тексеру.
Dialogue: 0,0:13:07.72,0:13:10.28,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:13:10.28,0:13:13.25,Default,,0,0,0,,Триггер Ридос Агурдың қуатына плюс 10000 сызыңыз.
Dialogue: 0,0:13:14.72,0:13:17.23,Default,,0,0,0,,Ристалгалермен шабуыл.
Dialogue: 0,0:13:17.23,0:13:19.23,Default,,0,0,0,,Тоулды шеберлікпен шегіндіріңіз.
Dialogue: 0,0:13:19.23,0:13:22.23,Default,,0,0,0,,Күзетші. Лидос Агурмен шабуыл.
Dialogue: 0,0:13:22.23,0:13:24.27,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:13:24.27,0:13:27.74,Default,,0,0,0,,Бұрылыстың соңында Ридос Агурды жаныңызға салыңыз.
Dialogue: 0,0:13:27.74,0:13:31.24,Default,,0,0,0,,Мичиру Маварима…. Un?
Dialogue: 0,0:13:31.24,0:13:34.71,Default,,0,0,0,,Сіз Авангард биігіне ұмтылғаныңыздай...
Dialogue: 0,0:13:34.71,0:13:38.25,Default,,0,0,0,,Мен Авангард нысанасын көздеймін.
Dialogue: 0,0:13:38.25,0:13:40.21,Default,,0,0,0,,Сол себепті➡
Dialogue: 0,0:13:40.21,0:13:42.22,Default,,0,0,0,,Мен сені жеңу үшін келдім!
Dialogue: 0,0:13:42.22,0:13:44.22,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:13:44.22,0:13:46.72,Default,,0,0,0,,Сен мықтысың... сен мықтысың ➡
Dialogue: 0,0:13:46.72,0:13:48.72,Default,,0,0,0,,Мен білемін➡
Dialogue: 0,0:13:48.72,0:13:51.26,Default,,0,0,0,,Ол менен әлдеқайда жоғары.
Dialogue: 0,0:13:51.26,0:13:54.23,Default,,0,0,0,,Бір сәтке де тоқтамайтын кездер болады.
Dialogue: 0,0:13:54.23,0:13:56.23,Default,,0,0,0,,Алайда➡
Dialogue: 0,0:13:56.23,0:13:58.23,Default,,0,0,0,,Жоқ, сондықтан! ➡
Dialogue: 0,0:13:58.23,0:14:00.23,Default,,0,0,0,,Мен сенен асып түскім келеді!
Dialogue: 0,0:14:00.23,0:14:03.20,Default,,0,0,0,,Сен шынымен өзгердің...Тайзу.
Dialogue: 0,0:14:03.20,0:14:05.81,Default,,0,0,0,,А...мен де➡
Dialogue: 0,0:14:05.81,0:14:07.71,Default,,0,0,0,,Велстра да!
Dialogue: 0,0:14:07.71,0:14:09.74,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:14:09.74,0:14:13.72,Default,,0,0,0,,Мен зерттелмегенді ашу туралы шешімім!
Dialogue: 0,0:14:13.72,0:14:15.82,Default,,0,0,0,,Тағдыр белгісі➡
Dialogue: 0,0:14:15.82,0:14:17.75,Default,,0,0,0,,Velstra Blitz Arms➡
Dialogue: 0,0:14:17.75,0:14:19.72,Default,,0,0,0,,Жүр!
Dialogue: 0,0:14:19.72,0:14:22.22,Default,,0,0,0,,А...тағдыр?
Dialogue: 0,0:14:22.22,0:14:24.73,Default,,0,0,0,,Иә! Менің тағдырымды өзгертіңіз➡
Dialogue: 0,0:14:24.73,0:14:26.73,Default,,0,0,0,,Менің басқа эго!
Dialogue: 0,0:14:26.73,0:14:29.23,Default,,0,0,0,,Тамшыдан Фенриттаға қоңырау шалыңыз➡
Dialogue: 0,0:14:29.23,0:14:31.73,Default,,0,0,0,,Юбаның шеберлігі Палубадан➡
Dialogue: 0,0:14:31.73,0:14:33.77,Default,,0,0,0,,Максималды спутниктік қару Euriante және ➡
Dialogue: 0,0:14:33.77,0:14:37.21,Default,,0,0,0,,Қолыңызға Frayschutz Maxim мобильді бекінісін қосыңыз.
Dialogue: 0,0:14:37.21,0:14:39.74,Default,,0,0,0,,Ашық деп белгілеңіз!
Dialogue: 0,0:14:39.74,0:14:42.21,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:14:42.21,0:14:44.21,Default,,0,0,0,,Тәңірлік шеберлік?
Dialogue: 0,0:14:44.21,0:14:46.71,Default,,0,0,0,,Мен білмейтін күш!
Dialogue: 0,0:14:46.71,0:14:50.22,Default,,0,0,0,,Тапсырыс аймағына Euriante мен Максимді орнатыңыз.
Dialogue: 0,0:14:50.22,0:14:52.72,Default,,0,0,0,,және Maxim➡ іске қосыңыз
Dialogue: 0,0:14:52.72,0:14:54.72,Default,,0,0,0,,Ристалгалердің шегінуі.
Dialogue: 0,0:14:54.72,0:14:57.73,Default,,0,0,0,,Авангардтың күші минус 5000!
Dialogue: 0,0:14:57.73,0:14:59.76,Default,,0,0,0,,Толығырақ! ➡
Dialogue: 0,0:14:59.76,0:15:03.73,Default,,0,0,0,,Еврианте шеберлігі: 1 картаны сал, 3 картаны зарядта➡
Dialogue: 0,0:15:03.73,0:15:05.73,Default,,0,0,0,,Фенритта шеберлігін белсендіру➡
Dialogue: 0,0:15:05.73,0:15:07.77,Default,,0,0,0,,Максимді қайта іске қосыңыз! ➡
Dialogue: 0,0:15:07.77,0:15:10.74,Default,,0,0,0,,Заган авангардының күші минус 5000 шегініңіз!
Dialogue: 0,0:15:10.74,0:15:13.71,Default,,0,0,0,,Сіз қалай ойлайсыз? Артқы күзетшілер жойылды.
Dialogue: 0,0:15:13.71,0:15:15.74,Default,,0,0,0,,Мен мұны істеймін...
Dialogue: 0,0:15:15.74,0:15:17.71,Default,,0,0,0,,Фрайшуц Максимнің үздіксіз жұмысы.
Dialogue: 0,0:15:17.71,0:15:19.71,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:15:19.71,0:15:21.72,Default,,0,0,0,,Мықты болайық!
Dialogue: 0,0:15:21.72,0:15:24.75,Default,,0,0,0,,Құралды шақырыңыз Құралмен шабуыл жасаңыз!
Dialogue: 0,0:15:24.75,0:15:26.72,Default,,0,0,0,,Любезалды шеберлікпен басқарыңыз!
Dialogue: 0,0:15:26.72,0:15:28.76,Default,,0,0,0,,1 картаны сал.
Dialogue: 0,0:15:28.76,0:15:32.23,Default,,0,0,0,,Күзетші. Авангардқа Velstra арқылы шабуыл жасаңыз!
Dialogue: 0,0:15:32.23,0:15:34.23,Default,,0,0,0,,Қуат және дағдылары бар 10 000!
Dialogue: 0,0:15:34.23,0:15:36.23,Default,,0,0,0,,Максим қайтадан жұмысқа кірісті!
Dialogue: 0,0:15:36.23,0:15:39.23,Default,,0,0,0,,Қарсыластың авангардының күшін -5000➡ азайтады
Dialogue: 0,0:15:39.23,0:15:42.24,Default,,0,0,0,,Максимді артқы күзетші ретінде шақырыңыз.
Dialogue: 0,0:15:42.24,0:15:44.27,Default,,0,0,0,,Сорти!
Dialogue: 0,0:15:44.27,0:15:46.24,Default,,0,0,0,,Күзетші жоқ. Бірінші тексеру….
Dialogue: 0,0:15:47.71,0:15:50.21,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:15:50.21,0:15:53.75,Default,,0,0,0,,Критикалық триггер! Қуатты қосу 10000➡
Dialogue: 0,0:15:53.75,0:15:56.22,Default,,0,0,0,,Велстраның сыни плюс 1!
Dialogue: 0,0:15:58.22,0:16:01.22,Default,,0,0,0,,Фрайшуц Максиммен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:16:03.72,0:16:06.69,Default,,0,0,0,,Барлығы бірден!
Dialogue: 0,0:16:09.73,0:16:11.70,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:16:13.73,0:16:15.74,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:16:15.74,0:16:18.21,Default,,0,0,0,,Комбайнмен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:16:20.71,0:16:22.71,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:16:22.71,0:16:24.75,Default,,0,0,0,,К….
Dialogue: 0,0:16:24.75,0:16:27.75,Default,,0,0,0,,Максимді тапсырыс аймағына қайтарып, бұрылысты аяқтаңыз.
Dialogue: 0,0:16:29.22,0:16:31.32,Default,,0,0,0,,Тағдыр белгісі➡
Dialogue: 0,0:16:31.32,0:16:34.72,Default,,0,0,0,,Бұл сіздің жаңа күшіңіз.
Dialogue: 0,0:16:34.72,0:16:37.73,Default,,0,0,0,,А... 5-ке зақым келтіру үшін оны бұрышқа бұрдым.
Dialogue: 0,0:16:37.73,0:16:39.73,Default,,0,0,0,,Уақыт келді➡
Dialogue: 0,0:16:39.73,0:16:42.23,Default,,0,0,0,,Жаңа Маған өзіңдікін де көрсет.
Dialogue: 0,0:16:42.23,0:16:44.23,Default,,0,0,0,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:16:44.23,0:16:46.27,Default,,0,0,0,,Мен оны үнемі сезінемін➡
Dialogue: 0,0:16:46.27,0:16:49.24,Default,,0,0,0,,Бұрынғыдан өзгеше діріл бар сияқты.
Dialogue: 0,0:16:49.24,0:16:51.21,Default,,0,0,0,,Бұрын➡
Dialogue: 0,0:16:51.21,0:16:54.21,Default,,0,0,0,,Мен тек адамдардың жанын ғана көре алдым.
Dialogue: 0,0:16:54.21,0:16:57.25,Default,,0,0,0,,Бірақ оянғаннан кейін➡
Dialogue: 0,0:16:57.25,0:17:00.21,Default,,0,0,0,,Картаның жандары енді көрінеді.
Dialogue: 0,0:17:00.21,0:17:02.22,Default,,0,0,0,,Бұл➡
Dialogue: 0,0:17:02.22,0:17:04.22,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:17:04.22,0:17:06.25,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:17:06.25,0:17:08.76,Default,,0,0,0,,Енді...ояныңыз➡
Dialogue: 0,0:17:08.76,0:17:12.23,Default,,0,0,0,,Сиқырлы қазына Нағыз Айдаһар Дораджуэлд Игнис➡
Dialogue: 0,0:17:12.23,0:17:14.23,Default,,0,0,0,,Жүр!
Dialogue: 0,0:17:19.23,0:17:21.24,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:17:21.24,0:17:25.21,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:17:25.21,0:17:27.24,Default,,0,0,0,,Бифрондарға қоңырау шалыңыз.
Dialogue: 0,0:17:27.24,0:17:29.71,Default,,0,0,0,,Палубаның жоғарғы үш картасын көру үшін шеберлікті пайдаланыңыз➡
Dialogue: 0,0:17:29.71,0:17:31.75,Default,,0,0,0,,Қолда 1 карта➡
Dialogue: 0,0:17:31.75,0:17:33.71,Default,,0,0,0,,Жан 1 картасы 1 картаны тастаңыз.
Dialogue: 0,0:17:33.71,0:17:35.75,Default,,0,0,0,,Заганға қоңырау шалыңыз.
Dialogue: 0,0:17:35.75,0:17:38.75,Default,,0,0,0,,Жаннан Ридос Агурға қоңырау шалыңыз.
Dialogue: 0,0:17:38.75,0:17:40.72,Default,,0,0,0,,Сол дағдымен 1 картаны сал.
Dialogue: 0,0:17:40.72,0:17:42.72,Default,,0,0,0,,Лидос Агур деп те аталады.
Dialogue: 0,0:17:42.72,0:17:44.73,Default,,0,0,0,,Шеберлікпен 1 ​​картаны сал.
Dialogue: 0,0:17:44.73,0:17:47.86,Default,,0,0,0,,Вапураға қоңырау шалыңыз.
Dialogue: 0,0:17:47.86,0:17:50.23,Default,,0,0,0,,)
Dialogue: 0,0:17:50.23,0:17:52.73,Default,,0,0,0,,Дражуэль Игнис дағдылары➡
Dialogue: 0,0:17:52.73,0:17:55.24,Default,,0,0,0,,Тамшыдан 2 картаны жаныңызға салыңыз➡
Dialogue: 0,0:17:55.24,0:17:57.71,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 15 000.
Dialogue: 0,0:17:57.71,0:18:00.21,Default,,0,0,0,,Лидос Агурмен шабуыл!
Dialogue: 0,0:18:00.21,0:18:03.21,Default,,0,0,0,,Күзетші! Лидос Агурмен шабуыл.
Dialogue: 0,0:18:03.21,0:18:06.25,Default,,0,0,0,,Күзет... Кетіңіз!
Dialogue: 0,0:18:06.25,0:18:08.72,Default,,0,0,0,,Дражуэль Игниспен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:08.72,0:18:10.75,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:18:10.75,0:18:13.22,Default,,0,0,0,,Жаннан түрлі дәрежедегі 5 карточка➡
Dialogue: 0,0:18:13.22,0:18:15.76,Default,,0,0,0,,Жанды жағу арқылы➡
Dialogue: 0,0:18:15.76,0:18:18.23,Default,,0,0,0,,Қарсыластың артқы қатарындағы барлық артқы қорғаушыларды шегіндіріңіз➡
Dialogue: 0,0:18:18.23,0:18:20.26,Default,,0,0,0,,Өзіндік критикалық +1.
Dialogue: 0,0:18:20.26,0:18:23.23,Default,,0,0,0,,Сонымен қатар, алдыңғы қатардағы барлық қарсыластардың күшін арттырыңыз➡
Dialogue: 0,0:18:23.23,0:18:25.20,Default,,0,0,0,,Нөлге қойыңыз.
Dialogue: 0,0:18:27.27,0:18:30.24,Default,,0,0,0,,Өртенген...бес сырлы жан.
Dialogue: 0,0:18:36.21,0:18:38.25,Default,,0,0,0,,Ваапура дағдылары➡
Dialogue: 0,0:18:38.25,0:18:41.22,Default,,0,0,0,,Стендтік бифрондар.
Dialogue: 0,0:18:41.22,0:18:43.72,Default,,0,0,0,,Екі Ридос Агур да шеберлікпен тұр.
Dialogue: 0,0:18:43.72,0:18:46.22,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:18:46.22,0:18:48.22,Default,,0,0,0,,Хехе...бірінші тексеру.
Dialogue: 0,0:18:51.23,0:18:53.23,Default,,0,0,0,,Екінші тексеру.
Dialogue: 0,0:18:55.73,0:18:57.77,Default,,0,0,0,,Үшінші тексеру.
Dialogue: 0,0:18:57.77,0:19:00.74,Default,,0,0,0,,Критикалық триггер Ридос Агурдың Пауэр Plus 10000➡
Dialogue: 0,0:19:00.74,0:19:02.74,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:19:08.78,0:19:11.81,Default,,0,0,0,,((Менің қолымдағы қалған екі шабуылға төтеп бере алатын жалғыз карталар: ➡
Dialogue: 0,0:19:11.81,0:19:14.22,Default,,0,0,0,,Жоқ...! )) Лидос Агурда➡
Dialogue: 0,0:19:14.22,0:19:16.22,Default,,0,0,0,,Шабуыл.
Dialogue: 0,0:19:16.22,0:19:18.25,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:19:18.25,0:19:20.22,Default,,0,0,0,,Тағы ➡
Dialogue: 0,0:19:20.22,0:19:22.72,Default,,0,0,0,,Лидос Агурда➡
Dialogue: 0,0:19:22.72,0:19:24.73,Default,,0,0,0,,Авангардқа шабуыл жасаңыз.
Dialogue: 0,0:19:26.23,0:19:28.70,Default,,0,0,0,,Жоқ... күзетші.
Dialogue: 0,0:19:31.23,0:19:34.74,Default,,0,0,0,,Ха...жеңілдім➡
Dialogue: 0,0:19:34.74,0:19:37.24,Default,,0,0,0,,Жарты жолға барамын деп ойладым➡
Dialogue: 0,0:19:37.24,0:19:39.24,Default,,0,0,0,,Мен де, менде әлі алда көп.
Dialogue: 0,0:19:39.24,0:19:41.24,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:19:41.24,0:19:44.21,Default,,0,0,0,,Бұл шынымен де күшті болды. Келесі бұрылыс болса➡
Dialogue: 0,0:19:44.21,0:19:46.71,Default,,0,0,0,,Мен сізге керемет қонаққа бардым.
Dialogue: 0,0:19:46.71,0:19:48.72,Default,,0,0,0,,Бұған дейін жасалды.
Dialogue: 0,0:19:50.22,0:19:52.22,Default,,0,0,0,,Тағы да осы жігітпен➡
Dialogue: 0,0:19:52.22,0:19:54.22,Default,,0,0,0,,Маған қайта оқу керек.
Dialogue: 0,0:19:54.22,0:19:56.22,Default,,0,0,0,,Бірақ... бұл қызық болды!
Dialogue: 0,0:19:56.22,0:19:59.23,Default,,0,0,0,,Un Real карта ұрысы - ➡
Dialogue: 0,0:19:59.23,0:20:01.23,Default,,0,0,0,,Бұл қиялдан тыс.
Dialogue: 0,0:20:01.23,0:20:03.23,Default,,0,0,0,,Қызық!
Dialogue: 0,0:20:03.23,0:20:05.77,Default,,0,0,0,,«Қатты күресе бер» деп жиі айтамын.
Dialogue: 0,0:20:05.77,0:20:09.74,Default,,0,0,0,,Міне болды! Бұл тіпті сіздің қиялыңызға да сыймайды➡
Dialogue: 0,0:20:09.74,0:20:11.71,Default,,0,0,0,,Қызықты балалар.
Dialogue: 0,0:20:11.71,0:20:13.71,Default,,0,0,0,,Өшіру?
Dialogue: 0,0:20:13.71,0:20:15.71,Default,,0,0,0,,Жоқ...Мен жаңа біреумен таныстым.
Dialogue: 0,0:20:15.71,0:20:17.71,Default,,0,0,0,,Тағдырын өзгерткен жауынгерлер үшін.
Dialogue: 0,0:20:17.71,0:20:20.21,Default,,0,0,0,,Хе. Әсіресе ол➡
Dialogue: 0,0:20:20.21,0:20:22.72,Default,,0,0,0,,Ғажайыпты ұғатын бала.
Dialogue: 0,0:20:22.72,0:20:25.22,Default,,0,0,0,,Сізге ұнайды.
Dialogue: 0,0:20:25.22,0:20:28.22,Default,,0,0,0,,Керемет... un! ➡
Dialogue: 0,0:20:28.22,0:20:30.19,Default,,0,0,0,,Қызықты көрінеді.
Dialogue: 0,0:20:33.26,0:20:36.23,Default,,0,0,0,,Қаншама кескілескен ұрыстардан кейін В тобы бүгін бір күнде жеңілді➡
Dialogue: 0,0:20:36.23,0:20:38.27,Default,,0,0,0,,Барлық жекпе-жек аяқталды! ➡
Dialogue: 0,0:20:38.27,0:20:41.27,Default,,0,0,0,,Финалдық турнирге уақытынан бұрын қатысуға шешім қабылдаған жауынгерлер➡
Dialogue: 0,0:20:41.27,0:20:45.71,Default,,0,0,0,,Жапониядағы басқа жеңімпаздарға қосылыңыз!
Dialogue: 0,0:20:45.71,0:20:47.71,Default,,0,0,0,,Негізгі ойынға билет алдым➡
Dialogue: 0,0:20:47.71,0:20:49.71,Default,,0,0,0,,Бірінші адам ~!
Dialogue: 0,0:20:52.71,0:20:54.75,Default,,0,0,0,,Икки Тоусен: шайқаста шыңдалған! ➡
Dialogue: 0,0:20:54.75,0:20:57.75,Default,,0,0,0,,Теңдесі жоқ чемпион керемет оралды! ➡
Dialogue: 0,0:20:57.75,0:21:00.72,Default,,0,0,0,,Ол тірі аңыз!
Dialogue: 0,0:21:00.72,0:21:03.19,Default,,0,0,0,,Маварима~Мичиру~!
Dialogue: 0,0:21:04.26,0:21:08.76,Default,,0,0,0,,Алдын ала кезеңдегі барлық жеңістермен біз финалдық турнирге өтеміз!
Dialogue: 0,0:21:10.23,0:21:12.20,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:21:13.23,0:21:15.20,Default,,0,0,0,,Ал...екінші адам!
Dialogue: 0,0:21:18.21,0:21:21.71,Default,,0,0,0,,Қалай болды? Бұл елге оралғаннан кейінгі бірінші турнир.
Dialogue: 0,0:21:21.71,0:21:23.71,Default,,0,0,0,,Бұл жай ғана жақсы жекпе-жек болды.
Dialogue: 0,0:21:23.71,0:21:25.71,Default,,0,0,0,,Олардың барлығы мықты болды.
Dialogue: 0,0:21:25.71,0:21:27.75,Default,,0,0,0,,Және➡
Dialogue: 0,0:21:27.75,0:21:29.75,Default,,0,0,0,,Басқа жіктеуіш➡
Dialogue: 0,0:21:29.75,0:21:32.72,Default,,0,0,0,,Ол адам нағыз құбыжық.
Dialogue: 0,0:21:32.72,0:21:35.22,Default,,0,0,0,,Құбыжық?➡
Dialogue: 0,0:21:35.22,0:21:37.19,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:21:38.23,0:21:40.23,Default,,0,0,0,,Мен мұндай жауынгердің бар екеніне сене алмаймын➡
Dialogue: 0,0:21:40.23,0:21:43.23,Default,,0,0,0,,Дүние – үлкен орын.
Dialogue: 0,0:21:43.23,0:21:45.23,Default,,0,0,0,,Қайтып келгеніңізге қуаныштымын.
Dialogue: 0,0:21:45.23,0:21:47.23,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:21:47.23,0:21:49.24,Default,,0,0,0,,Бұдан былай мен көбірек күресе аламын.
Dialogue: 0,0:21:49.24,0:21:51.21,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:21:51.21,0:21:53.21,Default,,0,0,0,,Фу….
Dialogue: 0,0:21:54.24,0:21:56.21,Default,,0,0,0,,Үйге қайтайық➡
Dialogue: 0,0:21:56.21,0:21:58.21,Default,,0,0,0,,Жапонияға.
Dialogue: 0,0:21:59.71,0:22:05.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory