Dialogue: 0,0:18:02.71,0:18:04.71,Default,,0,0,0,,Критикалық триггер➡
Dialogue: 0,0:18:04.71,0:18:07.75,Default,,0,0,0,,Ревнологтың күші плюс 10 000.
Dialogue: 0,0:18:07.75,0:18:10.75,Default,,0,0,0,,Тағы бір Revnologue сыни плюс 1.
Dialogue: 0,0:18:12.22,0:18:14.22,Default,,0,0,0,,Гардс Ормуспен шабуыл.
Dialogue: 0,0:18:14.22,0:18:16.72,Default,,0,0,0,,Күзетші жоқ! Зақымдануды тексеру➡
Dialogue: 0,0:18:16.72,0:18:18.69,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:18:18.69,0:18:20.70,Default,,0,0,0,,Azensior қуаты плюс 10 000!
Dialogue: 0,0:18:22.23,0:18:24.20,Default,,0,0,0,,Revnologue көмегімен шабуыл.
Dialogue: 0,0:18:24.20,0:18:26.70,Default,,0,0,0,,Күзет... Тоқта!
Dialogue: 0,0:18:26.70,0:18:28.70,Default,,0,0,0,,Ревнологпен шабуыл.
Dialogue: 0,0:18:28.70,0:18:30.71,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:18:31.71,0:18:33.77,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:18:33.77,0:18:36.71,Default,,0,0,0,,((Кух...қандай ауыр шабуыл➡
Dialogue: 0,0:18:36.71,0:18:38.78,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:38.78,0:18:41.72,Default,,0,0,0,,Мен өзімді бұлай басып қалуға жол бере алмаймын! ))
