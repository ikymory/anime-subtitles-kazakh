Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.91,0:00:21.38,Default,,0,0,0,,)
Dialogue: 0,0:00:22.92,0:00:26.42,Default,,0,0,0,,)
Dialogue: 0,0:00:27.29,0:00:29.26,Default,,0,0,0,,Хаа….
Dialogue: 0,0:00:41.77,0:00:44.27,Default,,0,0,0,,Кагецу мырза.
Dialogue: 0,0:00:44.27,0:00:46.78,Default,,0,0,0,,Жас бала.
Dialogue: 0,0:00:46.78,0:00:49.78,Default,,0,0,0,,...жауап табылған сияқты.
Dialogue: 0,0:00:49.78,0:00:52.25,Default,,0,0,0,,Сәлем! Мен сені ұрыстырып аламын.
Dialogue: 0,0:00:56.79,0:00:58.79,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:02:38.75,0:02:42.22,Default,,0,0,0,,Кицунэ Шиба Лейка Айкава Куонға қарсы! ➡
Dialogue: 0,0:02:42.22,0:02:44.73,Default,,0,0,0,,Жақсы жетістіктерге қол жеткізетін жас мамандармен➡
Dialogue: 0,0:02:44.73,0:02:46.76,Default,,0,0,0,,Гений орта мектеп оқушысы! ➡
Dialogue: 0,0:02:46.76,0:02:50.73,Default,,0,0,0,,Тыныштық пен құмарлықтың арасында өтетін екі күрескер арасындағы тартыс➡
Dialogue: 0,0:02:50.73,0:02:54.27,Default,,0,0,0,,Ақырында бір қорытындыға келе ме? ➡
Dialogue: 0,0:02:54.27,0:02:58.31,Default,,0,0,0,,Лаика ойыншысы: Revoldress-тен қуу!
Dialogue: 0,0:02:58.31,0:03:00.81,Default,,0,0,0,,((Себебі Infinite Eyes артқы қатарда➡
Dialogue: 0,0:03:00.81,0:03:03.75,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасай алмаймын, бірақ... ))
Dialogue: 0,0:03:03.75,0:03:06.25,Default,,0,0,0,,Авангардқа Exist арқылы шабуыл жасаңыз!
Dialogue: 0,0:03:06.25,0:03:08.22,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:03:08.22,0:03:10.25,Default,,0,0,0,,Дискіні➡ тексеріңіз
Dialogue: 0,0:03:10.25,0:03:13.26,Default,,0,0,0,,Алдыңғы триггер! Алдыңғы қатардағы қуат плюс 10 000.
Dialogue: 0,0:03:14.72,0:03:17.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:17.73,0:03:19.73,Default,,0,0,0,,Әлі емес...! ➡
Dialogue: 0,0:03:19.73,0:03:21.73,Default,,0,0,0,,Даудрикпен шабуыл!
Dialogue: 0,0:03:21.73,0:03:23.73,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:03:23.73,0:03:26.74,Default,,0,0,0,,Басқа Даудрикпен шабуыл!
Dialogue: 0,0:03:26.74,0:03:29.24,Default,,0,0,0,,Левидрас шеберлігі іске қосылды! ➡
Dialogue: 0,0:03:29.24,0:03:31.74,Default,,0,0,0,,Шексіз көздерді қоспағанда➡
Dialogue: 0,0:03:31.74,0:03:33.74,Default,,0,0,0,,Артқы қорғаныс қуаты минус 10000!
Dialogue: 0,0:03:36.24,0:03:38.21,Default,,0,0,0,,Содан кейін бір картаны салыңыз.
Dialogue: 0,0:03:39.78,0:03:42.22,Default,,0,0,0,,((Шексіз көздерге рахмет➡
Dialogue: 0,0:03:42.22,0:03:44.22,Default,,0,0,0,,Қарсыластың күші төмендейді➡
Dialogue: 0,0:03:44.22,0:03:47.72,Default,,0,0,0,,Дегенмен, қалқан мәні әлі де жеткіліксіз...
Dialogue: 0,0:03:47.72,0:03:50.26,Default,,0,0,0,,Менің бұл жерден тартудан басқа амалым жоқ➡
Dialogue: 0,0:03:50.26,0:03:52.76,Default,,0,0,0,,Жоқ, артқа тарт! ➡
Dialogue: 0,0:03:52.76,0:03:54.80,Default,,0,0,0,,Бір ойынды ұтпай аяқтау мүмкін емес➡
Dialogue: 0,0:03:54.80,0:03:57.77,Default,,0,0,0,,Сіз де, солай ма? Левидрас! ))
Dialogue: 0,0:03:59.23,0:04:01.24,Default,,0,0,0,,Ұтыс!
Dialogue: 0,0:04:01.24,0:04:03.74,Default,,0,0,0,,Аа... а….
Dialogue: 0,0:04:03.74,0:04:06.74,Default,,0,0,0,,3 бөліктен тұратын күзет!
Dialogue: 0,0:04:06.74,0:04:08.74,Default,,0,0,0,,Қарғыс атсын...! ➡
Dialogue: 0,0:04:08.74,0:04:10.75,Default,,0,0,0,,Жаныңызды қалпына келтіру үшін мініңіз➡
Dialogue: 0,0:04:10.75,0:04:13.22,Default,,0,0,0,,Exist байланысты.
Dialogue: 0,0:04:13.22,0:04:15.25,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:04:15.25,0:04:17.25,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:17.25,0:04:20.26,Default,,0,0,0,,Алдын алды! Куон күткендей.
Dialogue: 0,0:04:20.26,0:04:23.29,Default,,0,0,0,,Менің жеребе кезегім!
Dialogue: 0,0:04:23.29,0:04:26.76,Default,,0,0,0,,Мен сізге шексіз күшімізді көрсетейін!
Dialogue: 0,0:04:29.23,0:04:32.23,Default,,0,0,0,,Тағдырлы ойларды байлаған патша! ➡
Dialogue: 0,0:04:32.23,0:04:35.24,Default,,0,0,0,,Әлемді мәңгілік нұрмен нұрландыр!
Dialogue: 0,0:04:35.24,0:04:37.21,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:04:40.28,0:04:44.75,Default,,0,0,0,,Шексіз тағдыр патшасы Левидрас Эмпирио!
Dialogue: 0,0:04:48.25,0:04:51.25,Default,,0,0,0,,Кеңейту...шексіз көздер➡
Dialogue: 0,0:04:51.25,0:04:54.72,Default,,0,0,0,,Левидрас Эмпирео шеберлігі іске қосылды!
Dialogue: 0,0:04:54.72,0:04:56.73,Default,,0,0,0,,Екі шексіз көзді орналастырыңыз.
Dialogue: 0,0:05:00.73,0:05:03.23,Default,,0,0,0,,Кларенс Панзерардқа қоңырау шалыңыз!
Dialogue: 0,0:05:03.23,0:05:06.20,Default,,0,0,0,,Левидрас Эмпиреомен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:05:07.24,0:05:09.27,Default,,0,0,0,,Фоксил шеберлігімен➡
Dialogue: 0,0:05:09.27,0:05:11.77,Default,,0,0,0,,Балвираторға артқы қатардан шабуыл жасауға мүмкіндік береді!
Dialogue: 0,0:05:21.22,0:05:23.72,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:05:23.72,0:05:26.76,Default,,0,0,0,,Бұл жақсы мүмкіндік... жіберіп алмаңыз! ➡
Dialogue: 0,0:05:26.76,0:05:28.72,Default,,0,0,0,,Балвиратормен шабуыл!
Dialogue: 0,0:05:29.79,0:05:33.73,Default,,0,0,0,,((Тағы төрт шабуыл...
Dialogue: 0,0:05:33.73,0:05:36.80,Default,,0,0,0,,Бұл қолмен күзетуге болмайды.
Dialogue: 0,0:05:36.80,0:05:39.23,Default,,0,0,0,,Содан кейін зақым триггеріне ставка жасаңыз...! ))
Dialogue: 0,0:05:39.23,0:05:41.24,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:05:41.24,0:05:43.24,Default,,0,0,0,,Зақымдануды тексеріңіз➡
Dialogue: 0,0:05:43.24,0:05:45.21,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:05:46.74,0:05:48.74,Default,,0,0,0,,Анот Гастермен шабуыл! ➡
Dialogue: 0,0:05:48.74,0:05:51.71,Default,,0,0,0,,Левидрастың шеберлігі 10 000 қуат қосады!
Dialogue: 0,0:05:52.71,0:05:54.72,Default,,0,0,0,,Күзетші жоқ! ➡
Dialogue: 0,0:05:54.72,0:05:56.72,Default,,0,0,0,,Зақымдануды тексеріңіз....
Dialogue: 0,0:06:01.22,0:06:03.23,Default,,0,0,0,,Жоқ…триггер. а….
Dialogue: 0,0:06:06.26,0:06:09.23,Default,,0,0,0,,Жеңімпаз... Айкава Куон!
Dialogue: 0,0:06:10.27,0:06:14.74,Default,,0,0,0,,Данышпан мектеп оқушысы алдыңғы чемпионды жеңді!
Dialogue: 0,0:06:14.74,0:06:17.74,Default,,0,0,0,,Уау, мен жасадым...!
Dialogue: 0,0:06:17.74,0:06:19.74,Default,,0,0,0,,Браво!
Dialogue: 0,0:06:19.74,0:06:21.74,Default,,0,0,0,,Мен Кицүнэ Шиба-санды жеңгеніме сене алар емеспін...
Dialogue: 0,0:06:21.74,0:06:23.75,Default,,0,0,0,,Куон мырза күткендей!
Dialogue: 0,0:06:23.75,0:06:25.75,Default,,0,0,0,,Бұл керемет болды! Quon.
Dialogue: 0,0:06:25.75,0:06:27.72,Default,,0,0,0,,А, ол күшті.
Dialogue: 0,0:06:28.82,0:06:31.25,Default,,0,0,0,,((мен менмен немесе немқұрайлы емес едім➡
Dialogue: 0,0:06:31.25,0:06:33.26,Default,,0,0,0,,Мен де дайындап қойдым➡
Dialogue: 0,0:06:33.26,0:06:36.29,Default,,0,0,0,,Бірақ басқа адамға да солай болады➡
Dialogue: 0,0:06:36.29,0:06:39.26,Default,,0,0,0,,Жеңіске жетіп, нәтиже шығара берсеңіз, сізді зерттейді➡
Dialogue: 0,0:06:39.26,0:06:43.30,Default,,0,0,0,,Дайын болу және шара қолдану табиғи нәрсе➡
Dialogue: 0,0:06:43.30,0:06:45.77,Default,,0,0,0,,Дегенмен, жеңетін кәсіпқойлар. ))
Dialogue: 0,0:06:49.30,0:06:51.24,Default,,0,0,0,,((Бұл➡
Dialogue: 0,0:06:51.24,0:06:53.24,Default,,0,0,0,,Бұл сіз бұрыннан қарап жүрген пейзаж➡
Dialogue: 0,0:06:53.24,0:06:55.24,Default,,0,0,0,,Мичиру-сан➡
Dialogue: 0,0:06:55.24,0:06:57.25,Default,,0,0,0,,Бұл әлі алыс➡
Dialogue: 0,0:06:57.25,0:06:59.28,Default,,0,0,0,,Бірақ бір күні, сөзсіз➡
Dialogue: 0,0:06:59.28,0:07:01.28,Default,,0,0,0,,Мен сенен асып түсемін! ))
Dialogue: 0,0:07:02.22,0:07:04.22,Default,,0,0,0,,Куон Айкава.
Dialogue: 0,0:07:07.22,0:07:09.72,Default,,0,0,0,,Шайқас Сізге көп рахмет.
Dialogue: 0,0:07:09.72,0:07:11.73,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:07:22.24,0:07:24.21,Default,,0,0,0,,Quon.
Dialogue: 0,0:07:25.24,0:07:27.24,Default,,0,0,0,,Суо.
Dialogue: 0,0:07:27.24,0:07:29.24,Default,,0,0,0,,Бұл жақсы жекпе-жек болды.
Dialogue: 0,0:07:29.24,0:07:31.71,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:07:31.71,0:07:34.25,Default,,0,0,0,,Келесіде Суохпен төбелескенше➡
Dialogue: 0,0:07:34.25,0:07:36.22,Default,,0,0,0,,Мен саған күшті екенімді көрсетемін.
Dialogue: 0,0:07:36.22,0:07:38.72,Default,,0,0,0,,А...Мен де күшейемін.
Dialogue: 0,0:07:41.72,0:07:43.73,Default,,0,0,0,,E?
Dialogue: 0,0:07:43.73,0:07:45.73,Default,,0,0,0,,Қазір жасаңыз!
Dialogue: 0,0:07:45.73,0:07:47.73,Default,,0,0,0,,Маған үзіліс беріңіз.
Dialogue: 0,0:07:48.86,0:07:51.73,Default,,0,0,0,,모⚟Келесі – А тобының финалдық ойыны➡
Dialogue: 0,0:07:51.73,0:07:55.74,Default,,0,0,0,,Жігіт Эрика Миоджоға қарсы!
Dialogue: 0,0:07:58.74,0:08:03.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:03.24,0:08:05.71,Default,,0,0,0,,Сен...сен бәрібір мықтысың~➡
Dialogue: 0,0:08:05.71,0:08:07.72,Default,,0,0,0,,Жекпе-жекке шыққаныма қуаныштымын!
Dialogue: 0,0:08:07.72,0:08:09.75,Default,,0,0,0,,U….
Dialogue: 0,0:08:09.75,0:08:13.22,Default,,0,0,0,,Жеңіс тепе-теңдігі екі жаққа да өзгеруі мүмкін.
Dialogue: 0,0:08:13.22,0:08:15.72,Default,,0,0,0,,Ах... Міне, міне, нақты нәрсе.
Dialogue: 0,0:08:17.29,0:08:20.76,Default,,0,0,0,,Мен бұл дүниеде өмір сүремін!
Dialogue: 0,0:08:21.73,0:08:23.73,Default,,0,0,0,,Осы мақсатта➡
Dialogue: 0,0:08:23.73,0:08:26.23,Default,,0,0,0,,Мен енді ешқашан жеңіле алмаймын!
Dialogue: 0,0:08:26.23,0:08:28.24,Default,,0,0,0,,Уақыт, бұрыл! ➡
Dialogue: 0,0:08:28.24,0:08:30.24,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:08:39.75,0:08:42.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:42.22,0:08:44.25,Default,,0,0,0,,Жеңімпаз➡
Dialogue: 0,0:08:44.25,0:08:46.72,Default,,0,0,0,,Эрика Миоджо!
Dialogue: 0,0:08:46.72,0:08:49.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:49.72,0:08:52.73,Default,,0,0,0,,Ах! Бірақ қызық болды.
Dialogue: 0,0:08:52.73,0:08:54.76,Default,,0,0,0,,Ой! ➡
Dialogue: 0,0:08:54.76,0:08:59.23,Default,,0,0,0,,Енді А тобында үш кездесуде де жеңіске жеткен Мирей Оякубукуродан басқа ойыншылар бар➡
Dialogue: 0,0:08:59.23,0:09:02.24,Default,,0,0,0,,Эрика Миоджо ойыншы жігіт➡
Dialogue: 0,0:09:02.24,0:09:04.74,Default,,0,0,0,,Ал үш ойыншы, Инабе Нао➡
Dialogue: 0,0:09:04.74,0:09:07.21,Default,,0,0,0,,Олардың әрқайсысы бір жеңіспен тең!
Dialogue: 0,0:09:09.24,0:09:12.78,Default,,0,0,0,,Сонымен, алдын ала айтқанымдай➡
Dialogue: 0,0:09:12.78,0:09:16.25,Default,,0,0,0,,Финалдық турнирге өту олардың үшеуіне қауіп төндірді➡
Dialogue: 0,0:09:16.25,0:09:18.22,Default,,0,0,0,,Біз сізді лотереяға қатысуға шақырамыз! ➡
Dialogue: 0,0:09:18.22,0:09:21.22,Default,,0,0,0,,Кім жеңеді➡
Dialogue: 0,0:09:21.22,0:09:23.76,Default,,0,0,0,,Тағдырлы көлікті тексеру! ➡
Dialogue: 0,0:09:23.76,0:09:25.73,Default,,0,0,0,,Бірақ бұл ~➡
Dialogue: 0,0:09:25.73,0:09:28.76,Default,,0,0,0,,Барлық іріктеу жекпе-жегі аяқталғаннан кейін! ➡
Dialogue: 0,0:09:28.76,0:09:32.23,Default,,0,0,0,,Соңына дейін сақтығыңызды төмендетпеңіз!
Dialogue: 0,0:09:34.24,0:09:36.24,Default,,0,0,0,,Бұл лотерея ма?
Dialogue: 0,0:09:36.24,0:09:38.77,Default,,0,0,0,,Нао, ақымақтық жасап тұрсың.
Dialogue: 0,0:09:38.77,0:09:41.24,Default,,0,0,0,,А? Енді бірінші мен барамын➡
Dialogue: 0,0:09:41.24,0:09:43.24,Default,,0,0,0,,Финалға өту туралы шешім қабылдау➡
Dialogue: 0,0:09:43.24,0:09:45.71,Default,,0,0,0,,Мен сізге қатты қысым жасаймын➡
Dialogue: 0,0:09:45.71,0:09:47.72,Default,,0,0,0,,Мұқият қараңыз! ➡
Dialogue: 0,0:09:47.72,0:09:50.22,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:09:50.22,0:09:52.22,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:09:53.25,0:09:56.76,Default,,0,0,0,,Маған қарағанда өзіңді көбірек уайымдауың керек.
Dialogue: 0,0:09:56.76,0:09:59.26,Default,,0,0,0,,Ха~!
Dialogue: 0,0:09:59.26,0:10:02.73,Default,,0,0,0,,Хахаха...! Жақсы, көбірек кел➡
Dialogue: 0,0:10:02.73,0:10:05.23,Default,,0,0,0,,Мені толғандырыңыз!
Dialogue: 0,0:10:05.23,0:10:08.24,Default,,0,0,0,,Сол ыстықты ұнатамын➡
Dialogue: 0,0:10:08.24,0:10:10.71,Default,,0,0,0,,Бірақ...Мен жеңемін!
Dialogue: 0,0:10:16.24,0:10:18.75,Default,,0,0,0,,А... жол тым көп.
Dialogue: 0,0:10:18.75,0:10:21.25,Default,,0,0,0,,Велосипедпен сәл жылдамырақ жүруге болады.
Dialogue: 0,0:10:21.25,0:10:23.22,Default,,0,0,0,,Данжи Тезірек жүр.
Dialogue: 0,0:10:23.22,0:10:25.22,Default,,0,0,0,,E…oi! Мичиру➡
Dialogue: 0,0:10:25.22,0:10:27.26,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:10:27.26,0:10:30.26,Default,,0,0,0,,Жеңімпаз Мегуми Окура!
Dialogue: 0,0:10:31.76,0:10:36.23,Default,,0,0,0,,Қараңғы аң Берсеркерді тістеп алды!
Dialogue: 0,0:10:36.23,0:10:38.73,Default,,0,0,0,,Нәтижесінде Мегуми Окура ➡
Dialogue: 0,0:10:38.73,0:10:40.74,Default,,0,0,0,,Финалға өту шешілді!
Dialogue: 0,0:10:43.30,0:10:45.74,Default,,0,0,0,,Хаа…. Хахаха! ➡
Dialogue: 0,0:10:45.74,0:10:48.78,Default,,0,0,0,,Авангард әлі де қызық➡
Dialogue: 0,0:10:48.78,0:10:51.71,Default,,0,0,0,,Асатын тағы бір мақсат бар➡
Dialogue: 0,0:10:51.71,0:10:53.75,Default,,0,0,0,,Мегуми Окура➡
Dialogue: 0,0:10:53.75,0:10:55.75,Default,,0,0,0,,Мен бұл қарызды міндетті түрде өтеймін➡
Dialogue: 0,0:10:55.75,0:10:58.75,Default,,0,0,0,,Келесі жолы мен бұл тістерді сындырамын!
Dialogue: 0,0:10:58.75,0:11:00.72,Default,,0,0,0,,Кез келген уақытта жақсы➡
Dialogue: 0,0:11:00.72,0:11:03.22,Default,,0,0,0,,Барлығын Blackout-қа шақырамыз!
Dialogue: 0,0:11:04.26,0:11:09.23,Default,,0,0,0,,Енді, ұзақ алдын ала жекпе-жектерден кейін келесі финалдық жекпе-жек! ➡
Dialogue: 0,0:11:09.23,0:11:12.20,Default,,0,0,0,,Бір секундты жіберіп алмаңыз!
Dialogue: 0,0:11:18.74,0:11:21.24,Default,,0,0,0,,Керемет өрнек! Сәлем, мына жаққа қара.
Dialogue: 0,0:11:21.24,0:11:23.24,Default,,0,0,0,,A…. иә? ➡
Dialogue: 0,0:11:23.24,0:11:25.21,Default,,0,0,0,,Саусақ осылай?
Dialogue: 0,0:11:25.21,0:11:27.25,Default,,0,0,0,,Эхехе….
Dialogue: 0,0:11:27.25,0:11:29.72,Default,,0,0,0,,Мені суретке түсіру қызық емес.
Dialogue: 0,0:11:29.72,0:11:32.22,Default,,0,0,0,,А...байқамайсың ба? ➡
Dialogue: 0,0:11:32.22,0:11:34.26,Default,,0,0,0,,Аки-кун, шынымен де қызық, солай емес пе?
Dialogue: 0,0:11:34.26,0:11:36.22,Default,,0,0,0,,E~? Хехе….
Dialogue: 0,0:11:38.79,0:11:42.26,Default,,0,0,0,,Сіз қобалжымайтын сияқтысыз. Сәлем, бұл тамаша!
Dialogue: 0,0:11:42.26,0:11:45.27,Default,,0,0,0,,Сәтсіздіктен қорықпа және алға ұмтыл!
Dialogue: 0,0:11:45.27,0:11:48.24,Default,,0,0,0,,Хмм! Бұл жақсы~ Акисаме алдыңғы кіші.
Dialogue: 0,0:11:48.24,0:11:50.27,Default,,0,0,0,,Жоқ, бұл ұзақ!
Dialogue: 0,0:11:50.27,0:11:53.24,Default,,0,0,0,,Мен одан ешқашан жалықпаймын. Мен ешқашан жалықпаймын!
Dialogue: 0,0:11:53.24,0:11:55.24,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:11:57.25,0:11:59.75,Default,,0,0,0,,Эй... бұрыл.
Dialogue: 0,0:11:59.75,0:12:01.72,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:12:05.25,0:12:08.26,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:12:08.26,0:12:11.23,Default,,0,0,0,,Сәттілік... Аки-кун.
Dialogue: 0,0:12:11.23,0:12:13.23,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:12:14.23,0:12:16.23,Default,,0,0,0,,Келіңіздер! Апыр-ай!
Dialogue: 0,0:12:17.23,0:12:19.23,Default,,0,0,0,,Ым?
Dialogue: 0,0:12:19.23,0:12:21.24,Default,,0,0,0,,Нао-сенпай...
Dialogue: 0,0:12:25.74,0:12:27.71,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:12:30.75,0:12:33.25,Default,,0,0,0,,Алдын ала финалдық жекпе-жек➡
Dialogue: 0,0:12:33.25,0:12:37.75,Default,,0,0,0,,C тобы Кагецу Якумо қарсы Акина Мейдо~!
Dialogue: 0,0:12:37.75,0:12:41.76,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:41.76,0:12:44.76,Default,,0,0,0,,Екі ашулы жеңіспен кенеттен оралу➡
Dialogue: 0,0:12:44.76,0:12:48.80,Default,,0,0,0,,Финалға шығуды шешіп қойған Кагецуге қарсы➡
Dialogue: 0,0:12:48.80,0:12:51.23,Default,,0,0,0,,Акинада 1 жеңіс және 1 жеңіліс бар➡
Dialogue: 0,0:12:51.23,0:12:53.90,Default,,0,0,0,,Жеңіске жетсеңіз, финалға өтесіз➡
Dialogue: 0,0:12:53.90,0:12:58.27,Default,,0,0,0,,Егер біз жеңілетін болсақ, С тобы да бір-бірден жеңіске жетеді! ➡
Dialogue: 0,0:12:58.27,0:13:02.24,Default,,0,0,0,,Біз жеңіп, шешеміз бе? Жаңа хаос туа ма?➡
Dialogue: 0,0:13:02.24,0:13:04.75,Default,,0,0,0,,Көптен күткен шайқас! ➡
Dialogue: 0,0:13:04.75,0:13:06.75,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:13:08.72,0:13:10.72,Default,,0,0,0,,Эй...эй➡
Dialogue: 0,0:13:10.72,0:13:12.72,Default,,0,0,0,,Сіздің қарсыласыңыз финалды шешіп қойған, солай ма? ➡
Dialogue: 0,0:13:12.72,0:13:15.26,Default,,0,0,0,,Олай болса, олар бұрыштарын қиюы мүмкін...
Dialogue: 0,0:13:15.26,0:13:17.26,Default,,0,0,0,,Джи….
Dialogue: 0,0:13:17.26,0:13:19.29,Default,,0,0,0,,Бұған себеп жоқ!
Dialogue: 0,0:13:19.29,0:13:22.73,Default,,0,0,0,,Жарайды, мен Ақина-сенпайды бар күшіммен қолдаймын!
Dialogue: 0,0:13:22.73,0:13:24.73,Default,,0,0,0,,Ум! О!
Dialogue: 0,0:13:24.73,0:13:26.77,Default,,0,0,0,,Сіз финалдық жекпе-жекке уақытында жеттіңіз.
Dialogue: 0,0:13:26.77,0:13:30.24,Default,,0,0,0,,Кагецу Якумо... Мен оның тағы да жекпе-жекке шыққанын күтемін➡
Dialogue: 0,0:13:30.24,0:13:32.74,Default,,0,0,0,,Қайтып келгеніңізге қуаныштымын.
Dialogue: 0,0:13:32.74,0:13:35.24,Default,,0,0,0,,Қарсылас... Акина Мейдо➡
Dialogue: 0,0:13:35.24,0:13:37.21,Default,,0,0,0,,Мен оны бірінші рет көріп тұрмын.
Dialogue: 0,0:13:40.28,0:13:43.25,Default,,0,0,0,,Ол... ғажайыпты ұстайтын бала.
Dialogue: 0,0:13:44.22,0:13:46.25,Default,,0,0,0,,Сонымен...! ➡
Dialogue: 0,0:13:46.25,0:13:49.26,Default,,0,0,0,,Алдын ала С тобының 6-матчы~➡
Dialogue: 0,0:13:49.26,0:13:51.23,Default,,0,0,0,,Фай!
Dialogue: 0,0:13:55.23,0:13:58.73,Default,,0,0,0,,Енді сіздің жауабыңызды тыңдауға рұқсат етіңіз. ➡
Dialogue: 0,0:13:58.73,0:14:00.70,Default,,0,0,0,,Жасөспірім.
Dialogue: 0,0:14:04.24,0:14:06.24,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:08.21,0:14:10.71,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:14:10.71,0:14:12.71,Default,,0,0,0,,Lunar Messenger Repsolt.
Dialogue: 0,0:14:12.71,0:14:15.22,Default,,0,0,0,,Амбиция қанаттары Соел!
Dialogue: 0,0:14:15.22,0:14:17.72,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:14:17.72,0:14:19.72,Default,,0,0,0,,Френельде жүру➡
Dialogue: 0,0:14:19.72,0:14:21.72,Default,,0,0,0,,Ай қақпасын шеберлікпен орнатыңыз➡
Dialogue: 0,0:14:21.72,0:14:23.69,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:14:23.69,0:14:26.73,Default,,0,0,0,,Менің кезегім: Бентестаға мініңіз➡
Dialogue: 0,0:14:26.73,0:14:28.73,Default,,0,0,0,,Брэди Аркқа➡ қоңырау шалыңыз
Dialogue: 0,0:14:28.73,0:14:33.20,Default,,0,0,0,,Палубаның жоғарғы картасына қарап, оны төменгі жағына қою үшін шеберлікті пайдаланыңыз➡
Dialogue: 0,0:14:33.20,0:14:35.20,Default,,0,0,0,,Қуат плюс 2000!
Dialogue: 0,0:14:35.20,0:14:38.71,Default,,0,0,0,,Хоу…. Бентестамен шабуыл!
Dialogue: 0,0:14:38.71,0:14:40.71,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:14:40.71,0:14:43.24,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:14:43.24,0:14:46.71,Default,,0,0,0,,Триггер Брэди Арктың қуатын +10000 сызыңыз!
Dialogue: 0,0:14:48.72,0:14:50.72,Default,,0,0,0,,Брэди Аркпен шабуыл!
Dialogue: 0,0:14:50.72,0:14:53.22,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:14:53.22,0:14:55.22,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:14:55.22,0:14:57.23,Default,,0,0,0,,Лумсденге бару➡
Dialogue: 0,0:14:57.23,0:15:00.70,Default,,0,0,0,,Қолыңызға бір фантом шынайы аңды шеберлікпен қосыңыз➡
Dialogue: 0,0:15:00.70,0:15:03.70,Default,,0,0,0,,Бір картаны тапсырыс аймағына қойыңыз.
Dialogue: 0,0:15:05.20,0:15:08.74,Default,,0,0,0,,Коул Рамсденмен бірге шабуыл ревнологы.
Dialogue: 0,0:15:08.74,0:15:10.71,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:15:10.71,0:15:12.71,Default,,0,0,0,,Ревнологпен шабуыл.
Dialogue: 0,0:15:12.71,0:15:15.21,Default,,0,0,0,,Күзетші! Соңына бұрылу.
Dialogue: 0,0:15:16.78,0:15:19.28,Default,,0,0,0,,((Менің жеке жекпе-жегім болады ...
Dialogue: 0,0:15:19.28,0:15:21.22,Default,,0,0,0,,Басынан бастайық! ))
Dialogue: 0,0:15:21.22,0:15:23.22,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:15:23.22,0:15:25.22,Default,,0,0,0,,Азенсиорға барыңыз! ➡
Dialogue: 0,0:15:25.22,0:15:27.22,Default,,0,0,0,,Бентестаға шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:15:27.22,0:15:29.19,Default,,0,0,0,,Екі Novia картасына қоңырау шалыңыз.
Dialogue: 0,0:15:29.19,0:15:31.19,Default,,0,0,0,,Novia-мен шабуыл!
Dialogue: 0,0:15:31.19,0:15:33.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:15:33.23,0:15:35.20,Default,,0,0,0,,Азеншиормен шабуыл!
Dialogue: 0,0:15:35.20,0:15:38.20,Default,,0,0,0,,Күзетші. Novia-мен шабуыл жасаңыз!
Dialogue: 0,0:15:38.20,0:15:40.20,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:15:40.20,0:15:42.24,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:15:42.24,0:15:45.24,Default,,0,0,0,,Қазір... бұл мен айды екінші рет сынап көруім.
Dialogue: 0,0:15:45.24,0:15:48.21,Default,,0,0,0,,Содан бері не ойладың?➡
Dialogue: 0,0:15:48.21,0:15:50.21,Default,,0,0,0,,Қалай өсті➡
Dialogue: 0,0:15:50.21,0:15:52.18,Default,,0,0,0,,Маған көрсетейін.
Dialogue: 0,0:15:58.22,0:16:00.22,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:16:00.22,0:16:02.76,Default,,0,0,0,,Жолда тұрған алтын жұлдыз➡
Dialogue: 0,0:16:02.76,0:16:05.23,Default,,0,0,0,,Геншин Басқа әлемнің ізбасары➡
Dialogue: 0,0:16:05.23,0:16:08.23,Default,,0,0,0,,Абайлаңыз...Ай сынағы➡
Dialogue: 0,0:16:08.23,0:16:10.70,Default,,0,0,0,,Бастайық...Мін!
Dialogue: 0,0:16:12.70,0:16:16.20,Default,,0,0,0,,Айдың қақпашысы Веизрург!
Dialogue: 0,0:16:18.21,0:16:20.21,Default,,0,0,0,,Ай қақпасы іске қосылды!
Dialogue: 0,0:16:21.74,0:16:25.75,Default,,0,0,0,,Даусымды естісеңіз, ➡ жауап беріңіз
Dialogue: 0,0:16:25.75,0:16:30.22,Default,,0,0,0,,Алғашқы ата, өсиет азу, елес➡
Dialogue: 0,0:16:30.22,0:16:32.72,Default,,0,0,0,,Аспанда ұшатын нағыз аң➡
Dialogue: 0,0:16:32.72,0:16:35.22,Default,,0,0,0,,Қоңырау шалу….
Dialogue: 0,0:16:35.22,0:16:37.19,Default,,0,0,0,,Бірінші иллюзиондық аң➡
Dialogue: 0,0:16:37.19,0:16:39.19,Default,,0,0,0,,Тенкай Гару Розтонир!
Dialogue: 0,0:16:39.19,0:16:41.70,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:16:45.23,0:16:47.20,Default,,0,0,0,,Веизруг дағдылары➡
Dialogue: 0,0:16:47.20,0:16:49.70,Default,,0,0,0,,Ай қақпасын қайта іске қосыңыз.
Dialogue: 0,0:16:49.70,0:16:51.71,Default,,0,0,0,,Revnologue➡ қоңырау шалыңыз
Dialogue: 0,0:16:51.71,0:16:53.71,Default,,0,0,0,,Тапсырыс аймағына 2 картаны орналастырыңыз.
Dialogue: 0,0:16:54.71,0:16:57.71,Default,,0,0,0,,Жарқырай бер, алтын жұлдыз! ➡
Dialogue: 0,0:16:57.71,0:16:59.71,Default,,0,0,0,,Тапсырыс картасы➡
Dialogue: 0,0:16:59.71,0:17:01.72,Default,,0,0,0,,Ailift Gourmani пайдаланыңыз!
Dialogue: 0,0:17:03.75,0:17:06.75,Default,,0,0,0,,Иллюзиондық аң барлық қуат плюс 5000➡
Dialogue: 0,0:17:06.75,0:17:09.69,Default,,0,0,0,,Егер бұл қабілет ретінде көрінсе, тағы 5000 қосыңыз.
Dialogue: 0,0:17:09.69,0:17:13.19,Default,,0,0,0,,Розтонирдегі Азенсиор мен Новияға➡
Dialogue: 0,0:17:13.19,0:17:15.23,Default,,0,0,0,,Бір мезгілде шабуыл!
Dialogue: 0,0:17:15.23,0:17:17.23,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:17:17.23,0:17:19.20,Default,,0,0,0,,Вейсрогпен авангардқа шабуыл жасаңыз.
Dialogue: 0,0:17:19.20,0:17:21.74,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:17:21.74,0:17:25.74,Default,,0,0,0,,Даусымды естісеңіз, ➡ жауап беріңіз
Dialogue: 0,0:17:25.74,0:17:30.21,Default,,0,0,0,,Екінші ата және жетекші патша, Иллюзия➡
Dialogue: 0,0:17:30.21,0:17:33.71,Default,,0,0,0,,Дүниені дүр сілкіндірген нағыз хайуан➡
Dialogue: 0,0:17:33.71,0:17:36.72,Default,,0,0,0,,Қоңырау➡
Dialogue: 0,0:17:36.72,0:17:38.72,Default,,0,0,0,,Екінші иллюзиондық аң➡
Dialogue: 0,0:17:38.72,0:17:41.22,Default,,0,0,0,,Сейсмикалық жылан патшасы Гардс Ормус!
Dialogue: 0,0:17:43.19,0:17:46.26,Default,,0,0,0,,Gards Ormus шеберлігін белсендіру➡
Dialogue: 0,0:17:46.26,0:17:49.23,Default,,0,0,0,,Бұл картаға артқы қатардан шабуыл жасауға болады.
Dialogue: 0,0:17:49.23,0:17:51.70,Default,,0,0,0,,А...Күзетші!
Dialogue: 0,0:17:51.70,0:17:54.20,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:17:54.20,0:17:56.24,Default,,0,0,0,,Емдеу триггері➡
Dialogue: 0,0:17:56.24,0:17:58.21,Default,,0,0,0,,Gards Ormus қуаты плюс 10000➡
Dialogue: 0,0:17:58.21,0:18:00.71,Default,,0,0,0,,Зиянды қалпына келтіру.
