Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.26,0:00:04.80,Default,,0,0,0,,Келесі С тобының бірінші матчы➡
Dialogue: 0,0:00:04.80,0:00:08.77,Default,,0,0,0,,Акина Мейдо Куон Айкаваға қарсы!
Dialogue: 0,0:00:08.77,0:00:11.31,Default,,0,0,0,,Жақсы! Менің кезегім.
Dialogue: 0,0:00:11.31,0:00:13.31,Default,,0,0,0,,Бала! а….
Dialogue: 0,0:00:25.29,0:00:27.36,Default,,0,0,0,,Әмиян Бұл күту залы еді...
Dialogue: 0,0:00:27.36,0:00:29.36,Default,,0,0,0,,Атча~. а….
Dialogue: 0,0:00:30.76,0:00:33.26,Default,,0,0,0,,Жарайды. О?
Dialogue: 0,0:00:33.26,0:00:35.26,Default,,0,0,0,,Мен қатты қобалжыдым➡
Dialogue: 0,0:00:35.26,0:00:38.27,Default,,0,0,0,,Мен одан да қатты толқып тұрмын.
Dialogue: 0,0:00:38.27,0:00:40.77,Default,,0,0,0,,Мен байқап көргім келетін нәрселер бар.
Dialogue: 0,0:00:48.78,0:00:50.78,Default,,0,0,0,,Жасөспірім. а….
Dialogue: 0,0:00:51.78,0:00:53.75,Default,,0,0,0,,Мен саған дұрыс қарап тұрмын.
Dialogue: 0,0:00:55.28,0:00:57.25,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:35.78,0:02:38.79,Default,,0,0,0,,｟Тағдырлы шайқастан кейін➡
Dialogue: 0,0:02:38.79,0:02:42.29,Default,,0,0,0,,Біз өз өмірімізге оралдық. ｠
Dialogue: 0,0:02:47.30,0:02:49.80,Default,,0,0,0,,Сонымен не? Менімен сөйлес.
Dialogue: 0,0:02:51.23,0:02:53.74,Default,,0,0,0,,Азаматты жеңгеніңіз үшін рахмет!
Dialogue: 0,0:02:53.74,0:02:55.74,Default,,0,0,0,,Е! Рас болса➡
Dialogue: 0,0:02:55.74,0:02:58.74,Default,,0,0,0,,Мен оны жеңуім керек еді, бірақ...!
Dialogue: 0,0:02:58.74,0:03:00.74,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:00.74,0:03:02.74,Default,,0,0,0,,Мен мұны істемесем, мен бақытты болмаймын!
Dialogue: 0,0:03:02.74,0:03:04.71,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:03:07.25,0:03:09.22,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:03:11.72,0:03:13.72,Default,,0,0,0,,Суу….
Dialogue: 0,0:03:13.72,0:03:16.22,Default,,0,0,0,,Оның орнына ұрысайық.
Dialogue: 0,0:03:16.22,0:03:18.23,Default,,0,0,0,,Е...!
Dialogue: 0,0:03:18.23,0:03:20.73,Default,,0,0,0,,Сізбен жекпе-жек қызу болды. а….
Dialogue: 0,0:03:22.23,0:03:24.23,Default,,0,0,0,,Мен мұны қайталағым келеді.
Dialogue: 0,0:03:24.23,0:03:26.74,Default,,0,0,0,,Суу….
Dialogue: 0,0:03:26.74,0:03:28.70,Default,,0,0,0,,Не болды? Тезірек жасайық.
Dialogue: 0,0:03:31.24,0:03:33.21,Default,,0,0,0,,Фу….
Dialogue: 0,0:03:37.25,0:03:39.25,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:03:39.25,0:03:42.22,Default,,0,0,0,,Крей планетасына барыңыз➡
Dialogue: 0,0:03:42.22,0:03:44.72,Default,,0,0,0,,Менің ойымша, бұл жақсы арман.
Dialogue: 0,0:03:44.72,0:03:46.72,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:03:46.72,0:03:48.72,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:03:49.73,0:03:52.73,Default,,0,0,0,,Сонымен, тағы да...
Dialogue: 0,0:03:53.73,0:03:56.23,Default,,0,0,0,,Ым?
Dialogue: 0,0:03:56.23,0:03:58.73,Default,,0,0,0,,Мен соған жетуді ойлап отырмын.
Dialogue: 0,0:03:58.73,0:04:01.24,Default,,0,0,0,,Түсіндім...сен үшін тамырласпын.
Dialogue: 0,0:04:02.74,0:04:04.77,Default,,0,0,0,,Мен де сені қолдаймын.
Dialogue: 0,0:04:04.77,0:04:07.74,Default,,0,0,0,,Досымның балшықты көздеп отырғаны ғажап.
Dialogue: 0,0:04:07.74,0:04:09.75,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:04:09.75,0:04:11.71,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:04:13.25,0:04:15.72,Default,,0,0,0,,Рахмет... Акина Суоу!
Dialogue: 0,0:04:16.75,0:04:19.79,Default,,0,0,0,,Маған Куон туралы көбірек айтып беріңізші.
Dialogue: 0,0:04:19.79,0:04:21.79,Default,,0,0,0,,Өткен оқиғалар. ｠
Dialogue: 0,0:04:24.79,0:04:28.26,Default,,0,0,0,,｟Мен қайтадан зерттеуді бастадым.
Dialogue: 0,0:04:28.26,0:04:30.77,Default,,0,0,0,,Бұл жолы екеумізге де арман болмақ.
Dialogue: 0,0:04:32.23,0:04:34.74,Default,,0,0,0,,Менің барлығымен өткізетін уақытым көп➡
Dialogue: 0,0:04:34.74,0:04:36.74,Default,,0,0,0,,Кездейсоқ нәрсеге толқу➡
Dialogue: 0,0:04:36.74,0:04:39.74,Default,,0,0,0,,Мен Авангардқа ғашық болдым...
Dialogue: 0,0:04:39.74,0:04:41.78,Default,,0,0,0,,Олармен өткен уақыт➡
Dialogue: 0,0:04:41.78,0:04:44.25,Default,,0,0,0,,Бұл мен үшін ыңғайлы болды.
Dialogue: 0,0:04:54.29,0:04:56.29,Default,,0,0,0,,Бірақ... ｠
Dialogue: 0,0:05:01.73,0:05:04.73,Default,,0,0,0,,Quon. а….
Dialogue: 0,0:05:04.73,0:05:06.74,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе.
Dialogue: 0,0:05:08.74,0:05:10.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:11.77,0:05:15.28,Default,,0,0,0,,Алдын ала C тобының бірінші матчы! ➡
Dialogue: 0,0:05:15.28,0:05:19.75,Default,,0,0,0,,Deluxe-де белгісіз кен қандай құйын тудырады? ➡
Dialogue: 0,0:05:19.75,0:05:22.72,Default,,0,0,0,,Керемет жекпе-жек өткізіңіз!
Dialogue: 0,0:05:22.72,0:05:24.72,Default,,0,0,0,,...
Dialogue: 0,0:05:24.72,0:05:26.76,Default,,0,0,0,,Қарсы! ➡
Dialogue: 0,0:05:26.76,0:05:29.72,Default,,0,0,0,,Көптеген мақалалар жариялаған данышпан мектеп оқушысы➡
Dialogue: 0,0:05:29.72,0:05:32.76,Default,,0,0,0,,Тіпті Vanguard ойынында өзіңіздің талантыңызды ашыңыз! ➡
Dialogue: 0,0:05:32.76,0:05:36.73,Default,,0,0,0,,Сұр ми жасушалары қазірдің өзінде белсенді➡
Dialogue: 0,0:05:36.73,0:05:38.87,Default,,0,0,0,,Куон Айкава!
Dialogue: 0,0:05:38.87,0:05:43.24,Default,,0,0,0,,Акина, қолыңнан келгенін істе! Куон-сан, барыңды сал!
Dialogue: 0,0:05:43.24,0:05:45.24,Default,,0,0,0,,Un? ➡
Dialogue: 0,0:05:45.24,0:05:47.74,Default,,0,0,0,,Акина-сенпай мен Айкава-сенпай➡
Dialogue: 0,0:05:47.74,0:05:50.25,Default,,0,0,0,,Сіз қай жағын қолдау керектігін ойлап жүрсіз бе?
Dialogue: 0,0:05:50.25,0:05:53.75,Default,,0,0,0,,Жоқ... Мен екеуін де қолдағым келеді➡
Dialogue: 0,0:05:53.75,0:05:55.72,Default,,0,0,0,,Екеуін де қолдау➡
Dialogue: 0,0:05:55.72,0:05:58.22,Default,,0,0,0,,２～
Dialogue: 0,0:05:59.22,0:06:01.22,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе.
Dialogue: 0,0:06:06.76,0:06:08.73,Default,,0,0,0,,Сізге қызық па?
Dialogue: 0,0:06:08.73,0:06:11.23,Default,,0,0,0,,Бұл қызықты кездесу емес пе?
Dialogue: 0,0:06:11.23,0:06:13.77,Default,,0,0,0,,Тағдыр патшасы және Тағдыр патшасы➡
Dialogue: 0,0:06:13.77,0:06:17.24,Default,,0,0,0,,Бұл кездесу тағдырдың шешуші шайқасында өткен жоқ.
Dialogue: 0,0:06:17.24,0:06:19.74,Default,,0,0,0,,Бұл шын қорытынды ма?
Dialogue: 0,0:06:19.74,0:06:22.21,Default,,0,0,0,,～
Dialogue: 0,0:06:23.25,0:06:25.28,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:06:25.28,0:06:28.22,Default,,0,0,0,,Мен қобалжып, өзімді дұрыс орындай алмасам ше?➡
Dialogue: 0,0:06:28.22,0:06:31.25,Default,,0,0,0,,Мен солай ойладым... бірақ менің қорқынышым негізсіз болған сияқты.
Dialogue: 0,0:06:31.25,0:06:34.26,Default,,0,0,0,,А... екеуміз де барымызды салайық!
Dialogue: 0,0:06:35.22,0:06:37.23,Default,,0,0,0,,Әрине.
Dialogue: 0,0:06:37.23,0:06:40.73,Default,,0,0,0,,Сонымен...! Іріктеу С тобындағы 1-матч ➡
Dialogue: 0,0:06:40.73,0:06:42.73,Default,,0,0,0,,Фай!
Dialogue: 0,0:06:47.74,0:06:50.74,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:06:50.74,0:06:53.24,Default,,0,0,0,,Амбицияның қанаттары Соел!
Dialogue: 0,0:06:53.24,0:06:55.24,Default,,0,0,0,,...
Dialogue: 0,0:06:55.24,0:06:57.75,Default,,0,0,0,,Менің кезегім…Бентеста➡ жүріңіз
Dialogue: 0,0:06:57.75,0:06:59.75,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:06:59.75,0:07:02.72,Default,,0,0,0,,Менің кезегім Скорпионға міну➡
Dialogue: 0,0:07:02.72,0:07:04.75,Default,,0,0,0,,➡
Dialogue: 0,0:07:04.75,0:07:06.72,Default,,0,0,0,,...
Dialogue: 0,0:07:06.72,0:07:08.72,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:07:08.72,0:07:10.73,Default,,0,0,0,,Кларенспен шабуыл.
Dialogue: 0,0:07:10.73,0:07:13.23,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:07:13.23,0:07:16.26,Default,,0,0,0,,Мен оны көптен күттім➡
Dialogue: 0,0:07:16.26,0:07:19.23,Default,,0,0,0,,Мен сенімен бұл күні бар күш-жігеріммен күресемін.
Dialogue: 0,0:07:19.23,0:07:22.24,Default,,0,0,0,,Мен де... менің кезегім➡
Dialogue: 0,0:07:22.24,0:07:24.24,Default,,0,0,0,,Азенсиорға бару➡
Dialogue: 0,0:07:24.24,0:07:26.24,Default,,0,0,0,,Бентестаға шеберлікпен қоңырау шалыңыз! ➡
Dialogue: 0,0:07:26.24,0:07:29.74,Default,,0,0,0,,Cadwalla Aerial телефонына қоңырау шалуды жалғастырыңыз.
Dialogue: 0,0:07:29.74,0:07:31.75,Default,,0,0,0,,Кадвалламен шабуыл!
Dialogue: 0,0:07:31.75,0:07:34.75,Default,,0,0,0,,Күзетші. Кадвалланың шеберлігін белсендіру➡
Dialogue: 0,0:07:34.75,0:07:37.22,Default,,0,0,0,,Палубаның жоғарғы 3 картасынан➡
Dialogue: 0,0:07:37.22,0:07:40.22,Default,,0,0,0,,Резаэль Витаны қолыңызға қосыңыз.
Dialogue: 0,0:07:40.22,0:07:42.72,Default,,0,0,0,,Тағдыр патшасы….
Dialogue: 0,0:07:42.72,0:07:44.73,Default,,0,0,0,,Азеншиормен шабуыл!
Dialogue: 0,0:07:44.73,0:07:46.73,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:07:46.73,0:07:48.73,Default,,0,0,0,,Бентестамен шабуыл.
Dialogue: 0,0:07:48.73,0:07:50.73,Default,,0,0,0,,Күзет. Соңына бұрылу.
Dialogue: 0,0:07:50.73,0:07:53.23,Default,,0,0,0,,А... мен де➡
Dialogue: 0,0:07:53.23,0:07:55.24,Default,,0,0,0,,Мен ұтыла алмаймын.
Dialogue: 0,0:07:55.24,0:07:57.24,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:07:57.24,0:07:59.31,Default,,0,0,0,,Мантикаға мініңіз! ➡
Dialogue: 0,0:07:59.31,0:08:02.24,Default,,0,0,0,,Panzelard Foxil➡ қоңырау шалыңыз
Dialogue: 0,0:08:02.24,0:08:04.25,Default,,0,0,0,,Мантицизамен шабуыл!
Dialogue: 0,0:08:04.25,0:08:06.25,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:06.25,0:08:08.25,Default,,0,0,0,,Панзелардпен шабуыл!
Dialogue: 0,0:08:08.25,0:08:10.29,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:10.29,0:08:13.25,Default,,0,0,0,,Ұрыс соңында Панзерадтың шеберлігі белсендіріледі! ➡
Dialogue: 0,0:08:13.25,0:08:17.23,Default,,0,0,0,,Зейнетке шығып, палубаның жоғарғы 7 картасынан бастаңыз➡
Dialogue: 0,0:08:17.23,0:08:19.73,Default,,0,0,0,,Левидрасты қолыңызға қосыңыз.
Dialogue: 0,0:08:19.73,0:08:21.73,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:08:21.73,0:08:23.77,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:08:23.77,0:08:26.23,Default,,0,0,0,,Құтқарылу қанаттары көктен!
Dialogue: 0,0:08:26.23,0:08:28.24,Default,,0,0,0,,Ғажайып тағдыр Резаелге➡
Dialogue: 0,0:08:28.24,0:08:30.21,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:35.74,0:08:37.75,Default,,0,0,0,,Novia телефонына қоңырау шалыңыз➡
Dialogue: 0,0:08:37.75,0:08:40.25,Default,,0,0,0,,Осы дағдымен Нилбериске қоңырау шалыңыз➡
Dialogue: 0,0:08:40.25,0:08:42.25,Default,,0,0,0,,Нилбериспен шабуыл!
Dialogue: 0,0:08:42.25,0:08:44.25,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:08:44.25,0:08:46.25,Default,,0,0,0,,Резаэльмен шабуыл.
Dialogue: 0,0:08:46.25,0:08:49.22,Default,,0,0,0,,Кадвалла мен Саврусты шеберлікпен шақырыңыз.
Dialogue: 0,0:08:49.22,0:08:51.73,Default,,0,0,0,,Саврус шеберлігін белсендіру➡
Dialogue: 0,0:08:51.73,0:08:54.23,Default,,0,0,0,,Алдыңғы қатардағылардың барлығына қуат плюс 5000!
Dialogue: 0,0:08:54.23,0:08:56.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:56.23,0:08:58.73,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:08:58.73,0:09:00.77,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:09:00.77,0:09:03.74,Default,,0,0,0,,Емдеу триггері! Novia қуаты плюс 10 000.
Dialogue: 0,0:09:03.74,0:09:05.71,Default,,0,0,0,,Зиянды қалпына келтіру!
Dialogue: 0,0:09:07.24,0:09:09.24,Default,,0,0,0,,Кадвалламен шабуыл!
Dialogue: 0,0:09:09.24,0:09:11.75,Default,,0,0,0,,Күзетші. Ұрыстың соңында ➡
Dialogue: 0,0:09:11.75,0:09:15.22,Default,,0,0,0,,Нилберисті қолыңызға шеберлікпен қосыңыз.
Dialogue: 0,0:09:15.22,0:09:17.22,Default,,0,0,0,,Sables Boost➡
Dialogue: 0,0:09:17.22,0:09:19.22,Default,,0,0,0,,Novia-мен шабуыл!
Dialogue: 0,0:09:19.22,0:09:21.26,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:21.26,0:09:24.23,Default,,0,0,0,,Ұрыс соңында Саврустың шеберлігі іске қосылады➡
Dialogue: 0,0:09:24.23,0:09:27.23,Default,,0,0,0,,Өзіңді байлап, 1 картаны сал.
Dialogue: 0,0:09:27.23,0:09:29.26,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:29.26,0:09:31.23,Default,,0,0,0,,Сіз шынымен кереметсіз.
Dialogue: 0,0:09:31.23,0:09:33.74,Default,,0,0,0,,Тағдыр соғысында Сууды құтқарыңыз➡
Dialogue: 0,0:09:33.74,0:09:36.74,Default,,0,0,0,,Тағдырлы шайқаста Цивилтті жеңді.
Dialogue: 0,0:09:36.74,0:09:38.74,Default,,0,0,0,,Мен үшін мұның ешқайсысы мүмкін емес еді.
Dialogue: 0,0:09:38.74,0:09:41.28,Default,,0,0,0,,Бір нәрсеге қол жеткізген сайын➡
Dialogue: 0,0:09:41.28,0:09:44.28,Default,,0,0,0,,Менің ішімде түрлі эмоциялар пайда болады.
Dialogue: 0,0:09:44.28,0:09:47.75,Default,,0,0,0,,A…. Сізге, кім жайлы дос болуы керек➡
Dialogue: 0,0:09:47.75,0:09:50.22,Default,,0,0,0,,Бұл сезім менде➡
Dialogue: 0,0:09:50.22,0:09:52.72,Default,,0,0,0,,Қызғаныш...Төмендік ➡
Dialogue: 0,0:09:52.72,0:09:54.72,Default,,0,0,0,,Қызғаныш➡
Dialogue: 0,0:09:54.72,0:09:56.72,Default,,0,0,0,,Қанша ойласам да жауап таба алмаймын.
Dialogue: 0,0:09:56.72,0:09:58.73,Default,,0,0,0,,Куон…. Бірақ➡
Dialogue: 0,0:09:58.73,0:10:00.73,Default,,0,0,0,,Мен сенен асып түссем➡
Dialogue: 0,0:10:00.73,0:10:02.73,Default,,0,0,0,,Бізде жауап бар шығар!
Dialogue: 0,0:10:02.73,0:10:05.23,Default,,0,0,0,,Сондықтан мен сенен асып түсемін! ➡
Dialogue: 0,0:10:05.23,0:10:07.24,Default,,0,0,0,,Бұл менің шешімім болды➡
Dialogue: 0,0:10:07.24,0:10:09.24,Default,,0,0,0,,Жаңа тағдыр!
Dialogue: 0,0:10:09.24,0:10:11.24,Default,,0,0,0,,Ах...!
Dialogue: 0,0:10:11.24,0:10:13.74,Default,,0,0,0,,Тағдырлы ойларды байлаған патша➡
Dialogue: 0,0:10:13.74,0:10:17.25,Default,,0,0,0,,Әлемді мәңгілік нұрмен нұрландыр!
Dialogue: 0,0:10:17.25,0:10:19.21,Default,,0,0,0,,Жүр!
Dialogue: 0,0:10:21.25,0:10:24.25,Default,,0,0,0,,Шексіз тағдыр патшасы➡
Dialogue: 0,0:10:24.25,0:10:26.72,Default,,0,0,0,,Левидрас Эмпирио!
Dialogue: 0,0:10:27.72,0:10:29.72,Default,,0,0,0,,U….
Dialogue: 0,0:10:29.72,0:10:33.23,Default,,0,0,0,,Кеңейту...шексіз көздер➡
Dialogue: 0,0:10:33.23,0:10:36.23,Default,,0,0,0,,Левидрас Эмпирео шеберлігін белсендіру! ➡
Dialogue: 0,0:10:36.23,0:10:39.23,Default,,0,0,0,,Левидрасты қолыңыздан жаныңызға салу арқылы➡
Dialogue: 0,0:10:39.23,0:10:41.74,Default,,0,0,0,,3 шексіз көзді орналастырыңыз.
Dialogue: 0,0:10:47.74,0:10:50.25,Default,,0,0,0,,Шексіз... Ояну!
Dialogue: 0,0:10:50.25,0:10:52.21,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:10:53.25,0:10:57.22,Default,,0,0,0,,Сондай-ақ әрқайсысына бір Шексіз көзді қойыңыз➡
Dialogue: 0,0:10:57.22,0:10:59.22,Default,,0,0,0,,Levidras қуаты плюс 10000➡
Dialogue: 0,0:10:59.22,0:11:01.22,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:11:01.22,0:11:03.76,Default,,0,0,0,,Балвиратор Фулиге қоңырау шалыңыз!
Dialogue: 0,0:11:03.76,0:11:06.29,Default,,0,0,0,,Панзерадқа шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:11:06.29,0:11:09.73,Default,,0,0,0,,Осы дағдымен сіз және Балвиратордың күші 5000-ға артады!
Dialogue: 0,0:11:09.73,0:11:13.23,Default,,0,0,0,,Левидрас Импереомен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:11:14.24,0:11:16.27,Default,,0,0,0,,Фоксил шеберлігімен➡
Dialogue: 0,0:11:16.27,0:11:19.74,Default,,0,0,0,,Балвираторға артқы қатардан шабуыл жасауға мүмкіндік береді.
Dialogue: 0,0:11:19.74,0:11:22.24,Default,,0,0,0,,4 қатарынан шабуыл...
Dialogue: 0,0:11:22.24,0:11:24.75,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:11:24.75,0:11:27.75,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:11:27.75,0:11:29.72,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:11:29.72,0:11:33.22,Default,,0,0,0,,Критикалық триггер! Фулидің қуаты плюс 10000➡
Dialogue: 0,0:11:33.22,0:11:35.22,Default,,0,0,0,,Critical Plus 1➡
Dialogue: 0,0:11:35.22,0:11:37.26,Default,,0,0,0,,Панзелардпен шабуыл!
Dialogue: 0,0:11:37.26,0:11:40.23,Default,,0,0,0,,Және Infinite Eyes жүйесіндегі бірлік шабуыл жасағанда➡
Dialogue: 0,0:11:40.23,0:11:42.23,Default,,0,0,0,,Қуат плюс 10 000!
Dialogue: 0,0:11:43.23,0:11:45.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:45.23,0:11:47.24,Default,,0,0,0,,Балвиратормен шабуыл!
Dialogue: 0,0:11:47.24,0:11:49.74,Default,,0,0,0,,Күзетсіз…Зақымды тексеру➡
Dialogue: 0,0:11:49.74,0:11:51.81,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:11:51.81,0:11:54.78,Default,,0,0,0,,｟Елестік аңдар иелерінің жүрегін сынайды➡
Dialogue: 0,0:11:54.78,0:11:57.81,Default,,0,0,0,,Жауабын тапсаңыз➡
Dialogue: 0,0:11:57.81,0:11:59.78,Default,,0,0,0,,Мен олардың жауап беретініне сенімдімін. ｠
Dialogue: 0,0:12:03.72,0:12:05.72,Default,,0,0,0,,Барлығын шабу➡
Dialogue: 0,0:12:05.72,0:12:07.72,Default,,0,0,0,,Фулимен шабуыл!
Dialogue: 0,0:12:07.72,0:12:09.72,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:12:09.72,0:12:11.73,Default,,0,0,0,,Кесу!
Dialogue: 0,0:12:12.73,0:12:15.73,Default,,0,0,0,,Бұрылыстың соңы. сіздің жылуыңыз➡
Dialogue: 0,0:12:15.73,0:12:17.73,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:12:17.73,0:12:19.73,Default,,0,0,0,,Буца➡
Dialogue: 0,0:12:19.73,0:12:22.27,Default,,0,0,0,,Сіз мені керемет деп айтасыз➡
Dialogue: 0,0:12:22.27,0:12:24.77,Default,,0,0,0,,Сіз де кереметсіз. а….
Dialogue: 0,0:12:24.77,0:12:27.24,Default,,0,0,0,,Клей планетасына баратын зерттеулер➡
Dialogue: 0,0:12:27.24,0:12:29.21,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:12:30.28,0:12:33.25,Default,,0,0,0,,Сондай-ақ Суды➡ құтқарған мен емес едім
Dialogue: 0,0:12:33.25,0:12:35.75,Default,,0,0,0,,Авангард!
Dialogue: 0,0:12:35.75,0:12:37.72,Default,,0,0,0,,Ал маған Vanguard➡ ұнайды
Dialogue: 0,0:12:37.72,0:12:39.75,Default,,0,0,0,,Суохтың ішінде не қалды➡
Dialogue: 0,0:12:39.75,0:12:42.22,Default,,0,0,0,,Менің ойымша, Куонның қатысуы да маңызды болды.
Dialogue: 0,0:12:42.22,0:12:44.76,Default,,0,0,0,,A…. Сіз кереметсіз➡
Dialogue: 0,0:12:44.76,0:12:47.26,Default,,0,0,0,,Біз керемет достармыз! Сондықтан➡
Dialogue: 0,0:12:47.26,0:12:50.77,Default,,0,0,0,,Мен жоғалтқым келмейтіндей сезінемін!
Dialogue: 0,0:12:50.77,0:12:53.77,Default,,0,0,0,,Ха! Кеттік, Куон! Менің кезегім.
Dialogue: 0,0:12:55.74,0:12:58.77,Default,,0,0,0,,Тағдырдың тілегін байлаған патша➡
Dialogue: 0,0:12:58.77,0:13:01.74,Default,,0,0,0,,Өміріңді ақ қанатпен басқар!
Dialogue: 0,0:13:02.74,0:13:04.75,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:13:04.75,0:13:06.71,Default,,0,0,0,,Тағдырдың ғажайып патшасы...
Dialogue: 0,0:13:09.72,0:13:11.72,Default,,0,0,0,,Резаэль Вита!
Dialogue: 0,0:13:21.20,0:13:23.20,Default,,0,0,0,,Келдің бе➡
Dialogue: 0,0:13:23.20,0:13:25.20,Default,,0,0,0,,Тағдыр патшасы!
Dialogue: 0,0:13:25.20,0:13:27.20,Default,,0,0,0,,Novia➡ телефонына қоңырау шалыңыз
Dialogue: 0,0:13:27.20,0:13:29.70,Default,,0,0,0,,Гаругаонды шеберлікпен шақыр.
Dialogue: 0,0:13:29.70,0:13:31.71,Default,,0,0,0,,Нилбериске➡ қоңырау шалыңыз
Dialogue: 0,0:13:31.71,0:13:33.71,Default,,0,0,0,,Нилбериспен шабуыл!
Dialogue: 0,0:13:34.71,0:13:37.21,Default,,0,0,0,,Левидрас шеберлігі іске қосылды!
Dialogue: 0,0:13:37.21,0:13:39.71,Default,,0,0,0,,Шексіз көздерді қоспағанда➡
Dialogue: 0,0:13:39.71,0:13:41.72,Default,,0,0,0,,Артқы қорғаныс қуаты минус 10000➡
Dialogue: 0,0:13:41.72,0:13:43.72,Default,,0,0,0,,1 картаны сал!
Dialogue: 0,0:13:43.72,0:13:45.72,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:13:45.72,0:13:47.79,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:13:47.79,0:13:50.79,Default,,0,0,0,,｟Infinite Eyes шабуылын тежеу.
Dialogue: 0,0:13:50.79,0:13:52.69,Default,,0,0,0,,Бұл күшті... ｠
Dialogue: 0,0:13:52.69,0:13:54.70,Default,,0,0,0,,Новиямен шабуыл!
Dialogue: 0,0:13:54.70,0:13:57.70,Default,,0,0,0,,Мен саған рұқсат бермеймін! Тағы да шексіз көздер➡
Dialogue: 0,0:13:57.70,0:14:00.70,Default,,0,0,0,,Қуат минус 10000!
Dialogue: 0,0:14:00.70,0:14:03.71,Default,,0,0,0,,Және... күзетші!
Dialogue: 0,0:14:04.74,0:14:08.21,Default,,0,0,0,,Резаэль Витамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:14:08.21,0:14:10.21,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:14:10.21,0:14:12.21,Default,,0,0,0,,Резаелді қолыңыздан жаныңызға салу арқылы➡
Dialogue: 0,0:14:12.21,0:14:15.25,Default,,0,0,0,,Drop Nilberis Aerial➡
Dialogue: 0,0:14:15.25,0:14:18.72,Default,,0,0,0,,Novia-ға қоңырау шалыңыз және олардың қуатына 5000 қосыңыз!
Dialogue: 0,0:14:18.72,0:14:20.72,Default,,0,0,0,,Және Новияның шеберлігімен➡
Dialogue: 0,0:14:20.72,0:14:23.73,Default,,0,0,0,,Қолыңызға палладий құлшынысын қосыңыз.
Dialogue: 0,0:14:23.73,0:14:26.19,Default,,0,0,0,,Толық күзет….
Dialogue: 0,0:14:26.19,0:14:28.70,Default,,0,0,0,,Бұл... күзетші!
Dialogue: 0,0:14:28.70,0:14:31.20,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:14:31.20,0:14:33.74,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:14:33.74,0:14:35.74,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:14:35.74,0:14:39.71,Default,,0,0,0,,Нилберистің қуаты плюс 10000 критикалық плюс 1!
Dialogue: 0,0:14:39.71,0:14:41.71,Default,,0,0,0,,Нилбериспен шабуыл!
Dialogue: 0,0:14:41.71,0:14:44.21,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:14:44.21,0:14:46.25,Default,,0,0,0,,Нилберис дағдылары➡
Dialogue: 0,0:14:46.25,0:14:48.72,Default,,0,0,0,,Бір картаны салыңыз және палубаның жоғарғы жағына қараңыз➡
Dialogue: 0,0:14:48.72,0:14:51.72,Default,,0,0,0,,Үстіне қойыңыз.
Dialogue: 0,0:14:51.72,0:14:53.72,Default,,0,0,0,,Novia-мен шабуыл!
Dialogue: 0,0:14:53.72,0:14:55.72,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:14:55.72,0:14:57.76,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:14:57.76,0:15:01.20,Default,,0,0,0,,Резаэль мен Арт қорғаушы дағдыларын қолданатын тактика.
Dialogue: 0,0:15:01.20,0:15:03.20,Default,,0,0,0,,Сіз бәрібір кереметсіз.
Dialogue: 0,0:15:06.70,0:15:08.70,Default,,0,0,0,,Мен үшін де солай.
Dialogue: 0,0:15:08.70,0:15:11.74,Default,,0,0,0,,Мен сізді соншалықты керемет деп ойлаймын➡
Dialogue: 0,0:15:11.74,0:15:15.21,Default,,0,0,0,,Жеңіске деген ұмтылыс шексіз өседі.
Dialogue: 0,0:15:15.21,0:15:17.21,Default,,0,0,0,,Түсіндім! ➡
Dialogue: 0,0:15:17.21,0:15:19.71,Default,,0,0,0,,Ақыры түсіндім➡
Dialogue: 0,0:15:19.71,0:15:22.68,Default,,0,0,0,,Мен сенен жеңілгім келмейді!
Dialogue: 0,0:15:23.72,0:15:25.69,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:15:27.22,0:15:29.22,Default,,0,0,0,,Менің де жеңілгім келмейді!
Dialogue: 0,0:15:29.22,0:15:31.73,Default,,0,0,0,,Мен жеңгім келеді! Ха….
Dialogue: 0,0:15:31.73,0:15:34.20,Default,,0,0,0,,Мен тағы да мәлімдеймін➡
Dialogue: 0,0:15:34.20,0:15:36.70,Default,,0,0,0,,Мен бұл күреске қатысамын➡
Dialogue: 0,0:15:36.70,0:15:38.70,Default,,0,0,0,,Сіз міндетті түрде жеңесіз!
Dialogue: 0,0:15:39.70,0:15:42.20,Default,,0,0,0,,Дұрыс...еркін ұшыңыз➡
Dialogue: 0,0:15:42.20,0:15:44.24,Default,,0,0,0,,Біздің патша.
Dialogue: 0,0:15:44.24,0:15:47.74,Default,,0,0,0,,Қалауыңызша. Жабайы жүр!
Dialogue: 0,0:15:47.74,0:15:51.25,Default,,0,0,0,,Мені тістеп алшы! жалғастыра бер! Куон мырза.
Dialogue: 0,0:15:52.21,0:15:54.18,Default,,0,0,0,,Барыңыз...! Quon.
Dialogue: 0,0:15:55.72,0:15:57.72,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:15:57.72,0:16:00.72,Default,,0,0,0,,Persona Ride! ➡
Dialogue: 0,0:16:00.72,0:16:02.72,Default,,0,0,0,,Левидрас Эмпирио!
Dialogue: 0,0:16:02.72,0:16:06.23,Default,,0,0,0,,Фулиге Анотгастерге шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:16:06.23,0:16:08.20,Default,,0,0,0,,Panzelard➡ қоңырау шалыңыз
Dialogue: 0,0:16:08.20,0:16:10.70,Default,,0,0,0,,Левидрас Эмпирионың дағдылары➡
Dialogue: 0,0:16:10.70,0:16:13.20,Default,,0,0,0,,3 шексіз көзді орналастырыңыз.
Dialogue: 0,0:16:18.21,0:16:20.21,Default,,0,0,0,,Тағдыр патшасы және Тағдыр патшасы➡
Dialogue: 0,0:16:20.21,0:16:22.71,Default,,0,0,0,,Екі адам қатар тұрады➡
Dialogue: 0,0:16:22.71,0:16:25.71,Default,,0,0,0,,Корольдік жолды тек жеңімпаздар алады!
Dialogue: 0,0:16:25.71,0:16:27.72,Default,,0,0,0,,Левидрас Эмпириода➡
Dialogue: 0,0:16:27.72,0:16:30.22,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:16:35.72,0:16:37.73,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:16:37.73,0:16:40.19,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:16:40.19,0:16:43.20,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:16:43.20,0:16:46.20,Default,,0,0,0,,Емдеу триггері! Анотгастердің қуаты плюс 10000➡
Dialogue: 0,0:16:46.20,0:16:48.70,Default,,0,0,0,,Зиянды қалпына келтіру.
Dialogue: 0,0:16:48.70,0:16:50.74,Default,,0,0,0,,Итеруді жалғастырыңыз!
Dialogue: 0,0:16:50.74,0:16:52.71,Default,,0,0,0,,Панзелардпен шабуыл!
Dialogue: 0,0:16:52.71,0:16:54.71,Default,,0,0,0,,Егер сіз оны алғыңыз келсе, мына жерді басыңыз!
Dialogue: 0,0:16:54.71,0:16:57.71,Default,,0,0,0,,Күзетші жоқ! Зақымдануды тексеру➡
Dialogue: 0,0:16:57.71,0:16:59.75,Default,,0,0,0,,Триггерді тартыңыз!
Dialogue: 0,0:16:59.75,0:17:02.75,Default,,0,0,0,,1 картаны салыңыз да, Резаэлдің қуатына плюс 10000 алыңыз.
Dialogue: 0,0:17:04.22,0:17:06.72,Default,,0,0,0,,Нилберисте расталған карталар➡
Dialogue: 0,0:17:06.72,0:17:08.76,Default,,0,0,0,,Бірақ содан кейін➡
Dialogue: 0,0:17:08.76,0:17:12.23,Default,,0,0,0,,Шексіз даналыққа ие болған досымды тоқтата аламын ба?
Dialogue: 0,0:17:13.69,0:17:16.20,Default,,0,0,0,,Балвиратормен шабуыл!
Dialogue: 0,0:17:17.20,0:17:19.20,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:17:19.20,0:17:21.20,Default,,0,0,0,,Хооримен шабуыл!
Dialogue: 0,0:17:22.20,0:17:24.71,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:17:26.21,0:17:28.71,Default,,0,0,0,,Анот Гастермен шабуыл!
Dialogue: 0,0:17:29.71,0:17:31.78,Default,,0,0,0,,Толық➡
Dialogue: 0,0:17:31.78,0:17:33.78,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:17:34.72,0:17:37.18,Default,,0,0,0,,Бұрылыс соңы...Шеше алмай жүрсіз бе?
Dialogue: 0,0:17:38.22,0:17:40.72,Default,,0,0,0,,Сізге рахмет, мен барлық карталарымды ойнап үлгердім➡
Dialogue: 0,0:17:40.72,0:17:43.22,Default,,0,0,0,,Келесі жолы жоқ...сондықтан➡
Dialogue: 0,0:17:43.22,0:17:45.73,Default,,0,0,0,,Бұл кезек нәтижені шешеді!
Dialogue: 0,0:17:45.73,0:17:48.20,Default,,0,0,0,,Мен саған оңайлықпен рұқсат бермеймін➡
Dialogue: 0,0:17:48.20,0:17:50.73,Default,,0,0,0,,Менің зияным 3➡
Dialogue: 0,0:17:50.73,0:17:52.73,Default,,0,0,0,,Сондай-ақ Шексіз Көздер➡ бар
Dialogue: 0,0:17:52.73,0:17:55.24,Default,,0,0,0,,Мен сіздің шабуылыңыздан қорғануға дайындалып жатырмын.
Dialogue: 0,0:17:56.20,0:17:58.24,Default,,0,0,0,,Келетін уақыт➡
Dialogue: 0,0:17:58.24,0:18:00.21,Default,,0,0,0,,Ғажайыптар жасаудың жолы бар.
Dialogue: 0,0:18:00.21,0:18:02.24,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:18:02.24,0:18:04.25,Default,,0,0,0,,Триггерді палубаға қалай қайтаруға болады және ➡
Dialogue: 0,0:18:04.25,0:18:07.72,Default,,0,0,0,,Палубадан триггерлерден басқа карталарды қалай алып тастауға болады.
Dialogue: 0,0:18:07.72,0:18:09.75,Default,,0,0,0,,U….
Dialogue: 0,0:18:09.75,0:18:12.72,Default,,0,0,0,,Ұрыс кезінде мен мүмкіндігінше картаны қолдануға тырысамын➡
Dialogue: 0,0:18:12.72,0:18:15.72,Default,,0,0,0,,Палубадан тартылды.
Dialogue: 0,0:18:15.72,0:18:17.76,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:18:17.76,0:18:20.19,Default,,0,0,0,,Мен Резаелдің құдайлық шеберлігін әлі пайдаланған жоқпын!
Dialogue: 0,0:18:20.19,0:18:22.20,Default,,0,0,0,,Қазір….
Dialogue: 0,0:18:22.20,0:18:24.70,Default,,0,0,0,,Осы сәтте!
Dialogue: 0,0:18:24.70,0:18:26.70,Default,,0,0,0,,Ғажайып келу!
Dialogue: 0,0:18:26.70,0:18:29.74,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:18:29.74,0:18:32.71,Default,,0,0,0,,Барлық түсірілген маңызды триггерлерді палубаға қайтарыңыз➡
Dialogue: 0,0:18:32.71,0:18:35.71,Default,,0,0,0,,Rezael's Drive Plus 1!
Dialogue: 0,0:18:35.71,0:18:37.71,Default,,0,0,0,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:18:37.71,0:18:40.21,Default,,0,0,0,,Жеті маңызды карта қайтарылды.
Dialogue: 0,0:18:40.21,0:18:43.22,Default,,0,0,0,,Енді жәннәт бақытының қай жаққа қарай итерілетіні.
Dialogue: 0,0:18:43.22,0:18:45.22,Default,,0,0,0,,Сенпай, жүр!
Dialogue: 0,0:18:45.22,0:18:48.22,Default,,0,0,0,,Үлкен аға, жеңілме!
Dialogue: 0,0:18:48.22,0:18:50.26,Default,,0,0,0,,Сіздің қолыңызда кереметтер.
Dialogue: 0,0:18:50.26,0:18:52.23,Default,,0,0,0,,Бар күшіңмен мені ұр!
Dialogue: 0,0:18:52.23,0:18:54.70,Default,,0,0,0,,Бар... Акина!
Dialogue: 0,0:18:54.70,0:18:56.70,Default,,0,0,0,,Қанаттарыңды соға...Тағдыр патшасы!
Dialogue: 0,0:18:58.20,0:19:02.20,Default,,0,0,0,,Резаэль Витамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:02.20,0:19:05.21,Default,,0,0,0,,Savirus Gigantech шеберлігі бойынша➡
Dialogue: 0,0:19:05.21,0:19:07.21,Default,,0,0,0,,Габриэлиусқа қоңырау шалыңыз!
Dialogue: 0,0:19:07.21,0:19:09.21,Default,,0,0,0,,Габриэлиус дағдылары➡
Dialogue: 0,0:19:09.21,0:19:11.21,Default,,0,0,0,,Палубаның жоғарғы жағына қараңыз➡
Dialogue: 0,0:19:11.21,0:19:13.71,Default,,0,0,0,,Қою➡
Dialogue: 0,0:19:13.71,0:19:15.72,Default,,0,0,0,,Қосымша Саблс дағдылары➡
Dialogue: 0,0:19:15.72,0:19:17.72,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 5000!
Dialogue: 0,0:19:17.72,0:19:19.75,Default,,0,0,0,,Және әуе дағдылары➡
Dialogue: 0,0:19:19.75,0:19:23.22,Default,,0,0,0,,Есептегіш заряд пен қуат плюс 2000!
Dialogue: 0,0:19:26.26,0:19:28.20,Default,,0,0,0,,｟Бұл үш жетек➡
Dialogue: 0,0:19:28.20,0:19:30.73,Default,,0,0,0,,Іске қосу жылдамдығы 12/24...
Dialogue: 0,0:19:30.73,0:19:33.73,Default,,0,0,0,,Олардың ішінде 8-і сыни.
Dialogue: 0,0:19:33.73,0:19:36.74,Default,,0,0,0,,Барлық шабуылдардың алдын алу үшін маржа жеткіліксіз.
Dialogue: 0,0:19:38.21,0:19:41.71,Default,,0,0,0,,Бірақ...бір маңызды картаға дейін алуға болады.
Dialogue: 0,0:19:41.71,0:19:44.78,Default,,0,0,0,,Менде әлі де артықшылық бар.
Dialogue: 0,0:19:44.78,0:19:47.72,Default,,0,0,0,,Жарысқа түскің келсе, бұл жалғыз орын! ｠
Dialogue: 0,0:19:47.72,0:19:49.72,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:19:49.72,0:19:52.25,Default,,0,0,0,,Кеттік! махаббат!
Dialogue: 0,0:19:52.25,0:19:55.22,Default,,0,0,0,,Тағдырға... Шешіңіз!
Dialogue: 0,0:19:55.22,0:19:57.22,Default,,0,0,0,,Үш жетек! ➡
Dialogue: 0,0:19:57.22,0:19:59.23,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:19:59.23,0:20:01.70,Default,,0,0,0,,Критикалық триггер! тоғыз….
Dialogue: 0,0:20:01.70,0:20:04.20,Default,,0,0,0,,Резаэльдің сыни +1.
Dialogue: 0,0:20:04.20,0:20:06.20,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:20:06.20,0:20:08.74,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:20:08.74,0:20:10.70,Default,,0,0,0,,Үшінші тексеру….
Dialogue: 0,0:20:19.71,0:20:22.72,Default,,0,0,0,,Критикалық триггерді алыңыз!
Dialogue: 0,0:20:22.72,0:20:24.72,Default,,0,0,0,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:20:24.72,0:20:27.22,Default,,0,0,0,,Резаэльдің сыни ➡
Dialogue: 0,0:20:27.22,0:20:29.22,Default,,0,0,0,,Плюс 1!
Dialogue: 0,0:20:47.71,0:20:49.71,Default,,0,0,0,,Жеңімпаз! ➡
Dialogue: 0,0:20:49.71,0:20:52.71,Default,,0,0,0,,Акина Мейдо~!
Dialogue: 0,0:20:52.71,0:20:55.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:55.22,0:20:57.22,Default,,0,0,0,,Мен жеңдім...
Dialogue: 0,0:20:57.22,0:20:59.72,Default,,0,0,0,,Ғажайыпқа қол созу ғана емес➡
Dialogue: 0,0:20:59.72,0:21:02.22,Default,,0,0,0,,Жасау...?
Dialogue: 0,0:21:03.72,0:21:06.19,Default,,0,0,0,,Мен Кагецу мырзаны жаңа ғана көшіріп жатырмын.
Dialogue: 0,0:21:09.20,0:21:12.70,Default,,0,0,0,,Бұл менің бүгінгі жоғалтуым.
Dialogue: 0,0:21:12.70,0:21:15.20,Default,,0,0,0,,Бірақ➡
Dialogue: 0,0:21:15.20,0:21:17.20,Default,,0,0,0,,Мен келесі жолы жеңемін!
Dialogue: 0,0:21:19.21,0:21:21.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:21.21,0:21:23.21,Default,,0,0,0,,Қайтадан жасайық!
Dialogue: 0,0:21:24.21,0:21:27.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:27.21,0:21:30.72,Default,,0,0,0,,Ең жақсы! Екеуі де жеңеді деп үміттенемін, солай ма?
Dialogue: 0,0:21:30.72,0:21:32.72,Default,,0,0,0,,Үлкен аға, сен істедің!
Dialogue: 0,0:21:32.72,0:21:34.72,Default,,0,0,0,,Куон-сан да күшті болды.
Dialogue: 0,0:21:34.72,0:21:36.72,Default,,0,0,0,,Тағдыр патшасы….
Dialogue: 0,0:21:36.72,0:21:38.73,Default,,0,0,0,,Тағдыр патшасы….
Dialogue: 0,0:21:38.73,0:21:41.20,Default,,0,0,0,,Екеуі де керемет болды!
Dialogue: 0,0:21:42.20,0:21:44.20,Default,,0,0,0,,Бұл жақсы жекпе-жек болды.
Dialogue: 0,0:21:44.20,0:21:46.73,Default,,0,0,0,,Біріншіден, бір жеңіс... дұрыс па?
Dialogue: 0,0:21:46.73,0:21:50.24,Default,,0,0,0,,Жарайды, шебер де ұтыла алмайды!
Dialogue: 0,0:21:51.71,0:21:54.71,Default,,0,0,0,,Хаа….
Dialogue: 0,0:21:54.71,0:21:57.21,Default,,0,0,0,,Келесі...
Dialogue: 0,0:21:57.21,0:21:59.18,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:22:00.68,0:22:06.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory