Dialogue: 0,0:00:05.53,0:00:12.53,Default,,0000,0000,0000,,(Құстардың әні)
Dialogue: 0,0:00:14.21,0:00:17.11,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,0:00:21.98,0:00:31.66,Default,,0000,0000,0000,,Мен оны жер асты дәліздерінде миллион рет көрдім.
Dialogue: 0,0:00:31.66,0:00:34.36,Default,,0000,0000,0000,,Бұл газ қаруы.
Dialogue: 0,0:00:34.36,0:00:38.00,Default,,0000,0000,0000,,Бұл газ менің жұлын сұйықтығымды қамтиды.
Dialogue: 0,0:00:38.00,0:00:40.80,Default,,0000,0000,0000,,Оны тіпті ең аз мөлшерде де жұтқан кез келген адам
Dialogue: 0,0:00:38.00,0:00:40.80,Default,,0000,0000,0000,,—«Ймир халқы»—
Dialogue: 0,0:00:40.80,0:00:46.68,Default,,0000,0000,0000,,бірден қатып қалады
Dialogue: 0,0:00:40.80,0:00:46.68,Default,,0000,0000,0000,,Олар денелеріне толық бақылауды жоғалтып, есінен танып қалады.
Dialogue: 0,0:00:46.68,0:00:49.01,Default,,0000,0000,0000,,Содан кейін мен тек бұйрық беруім керек
Dialogue: 0,0:00:49.01,0:00:53.31,Default,,0000,0000,0000,,«Жол» арқылы,
Dialogue: 0,0:00:49.01,0:00:53.31,Default,,0000,0000,0000,,және Титан күші Координаттарға жіберіледі.
Dialogue: 0,0:00:55.92,0:01:00.59,Default,,0000,0000,0000,,Сондықтан сол ауылдағы Титан
Dialogue: 0,0:00:55.92,0:01:00.59,Default,,0000,0000,0000,,дәл мен бұйырғандай қозғалады.
Dialogue: 0,0:01:00.59,0:01:04.06,Default,,0000,0000,0000,,Бұл «сол ауыл» емес,
Dialogue: 0,0:01:00.59,0:01:04.06,Default,,0000,0000,0000,,Бұл – «Лагако ауылы».
Dialogue: 0,0:01:04.06,0:01:06.96,Default,,0000,0000,0000,,Сен қырған ауыл,
Dialogue: 0,0:01:04.06,0:01:06.96,Default,,0000,0000,0000,,Солай емес пе?
Dialogue: 0,0:01:06.96,0:01:08.96,Rubi,,0000,0000,0000,,Ах… біз екеумізге айтып жеткізуге тым көп нәрсе жиналған…
Dialogue: 0,0:01:06.96,0:01:08.96,Default,,0000,0000,0000,,Есіңде болсын, сақалды жексұрын.
Dialogue: 0,0:01:08.96,0:01:12.40,Default,,0000,0000,0000,,Ах... Мен де,
Dialogue: 0,0:01:08.96,0:01:12.40,Default,,0000,0000,0000,,оны болдырмауға тырысқым келді...
Dialogue: 0,0:01:12.40,0:01:14.97,Default,,0000,0000,0000,,Бірақ мен оны жасамаса,
Dialogue: 0,0:01:12.40,0:01:14.97,Default,,0000,0000,0000,,менің шынайы ниеттерім —
Dialogue: 0,0:01:14.97,0:01:17.04,Default,,0000,0000,0000,,мен Елдияны қалпына келтіру үшін күресіп жатқаным —
Dialogue: 0,0:01:14.97,0:01:17.04,Default,,0000,0000,0000,,әшкере болар еді,
Dialogue: 0,0:01:17.04,0:01:21.28,Default,,0000,0000,0000,,және осы аралға үміт әкелу
Dialogue: 0,0:01:17.04,0:01:21.28,Rubi,,0000,0000,0000,,Кана
Dialogue: 0,0:01:17.04,0:01:21.28,Default,,0000,0000,0000,,ешқашан мүмкін болмас еді.
Dialogue: 0,0:01:21.28,0:01:26.11,Default,,0000,0000,0000,,Мен дәл осыны айттым
Dialogue: 0,0:01:21.28,0:01:26.11,Default,,0000,0000,0000,,біз осы аралға қонған бойда, иә?
Dialogue: 0,0:01:26.11,0:01:28.78,Default,,0000,0000,0000,,Неге мені қайта-қайта қайталауға мәжбүрлейсің?
Dialogue: 0,0:01:28.78,0:01:33.62,Default,,0000,0000,0000,,Сенде кінә сезімінің бір тамшысы да жоқ екені анық.
Dialogue: 0,0:01:28.78,0:01:33.62,Default,,0000,0000,0000,,Шынымен-ақ Эльдияны құтқарғың келетінін білмеймін,
Dialogue: 0,0:01:33.62,0:01:36.59,Default,,0000,0000,0000,,бірақ…
Dialogue: 0,0:01:33.62,0:01:36.59,Default,,0000,0000,0000,,адам өміріне мүддең жоқ екені анық.
Dialogue: 0,0:01:36.59,0:01:40.40,Default,,0000,0000,0000,,Қыздар арасында сен аса танымал емессің ғой?
Dialogue: 0,0:01:40.40,0:01:42.73,Default,,0000,0000,0000,,｡
Dialogue: 0,0:01:42.73,0:01:46.67,Default,,0000,0000,0000,,Барма
Dialogue: 0,0:01:42.73,0:01:46.67,Default,,0000,0000,0000,,басқа адамдардың қалай сезінетінін білетініңді ойлама.
Dialogue: 0,0:01:46.67,0:01:49.24,Default,,0000,0000,0000,,Мен білемін…
Dialogue: 0,0:01:49.24,0:01:52.04,Default,,0000,0000,0000,,Бұрын мен танымал болғанмын.
Dialogue: 0,0:01:52.04,0:01:54.51,Default,,0000,0000,0000,,Аа, солай ма? Сонымен…
Dialogue: 0,0:01:54.51,0:01:58.05,Default,,0000,0000,0000,,Эрен мен қашан кездесіп, тәжірибені бастаймыз?
Dialogue: 0,0:01:54.51,0:01:58.05,Default,,0000,0000,0000,,Бұл мен шешетін нәрсе емес.
Dialogue: 0,0:01:58.05,0:02:01.92,Default,,0000,0000,0000,,｡
Dialogue: 0,0:01:58.05,0:02:01.92,Default,,0000,0000,0000,,Біз Бас штабтан бұйрық күтіп отырмыз.
Dialogue: 0,0:02:01.92,0:02:06.59,Default,,0000,0000,0000,,Егер сіздерде уақыт көп деп ойласаңыздар,
Dialogue: 0,0:02:01.92,0:02:06.59,Default,,0000,0000,0000,,оларға қателескендерін айтыңыздар.
Dialogue: 0,0:02:06.59,0:02:09.79,Default,,0000,0000,0000,,Сол бір ғана нәрседе біз келісеміз.
Dialogue: 0,0:02:06.59,0:02:09.79,Default,,0000,0000,0000,,Капитан Леви!!
Dialogue: 0,0:02:11.96,0:02:15.43,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:02:11.96,0:02:15.43,Default,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:02:15.43,0:02:42.09,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:42.09,0:02:45.69,Default,,0000,0000,0000,,・'Қараңғылықтан жаңа өмір бастайық'
Dialogue: 0,0:02:42.09,0:02:45.69,Default,,0000,0000,0000,,from the darkness
Dialogue: 0,0:02:45.69,0:02:48.93,Default,,0000,0000,0000,,・'Жарық соңын көрсеткенше'
Dialogue: 0,0:02:48.93,0:02:52.57,Default,,0000,0000,0000,,・'Зұлым жүздер, өсіп жатқан қарғыстар'
Dialogue: 0,0:02:52.57,0:02:56.14,Default,,0000,0000,0000,,・'Бұл менің соңғы соғысым'
Dialogue: 0,0:02:56.14,0:03:02.91,Default,,0000,0000,0000,,・'Жындар бейнесіндегі періштелер'
Dialogue: 0,0:02:56.14,0:03:02.91,Default,,0000,0000,0000,,шайтан бейнесінде'
Dialogue: 0,0:03:02.91,0:03:09.55,Default,,0000,0000,0000,,даналығын сығып шығарады'
Dialogue: 0,0:03:02.91,0:03:09.55,Default,,0000,0000,0000,,squeezing out their wisdom
Dialogue: 0,0:03:09.55,0:03:16.19,Default,,0000,0000,0000,,・'Жасырын түрде жоспар құрған періштелер
Dialogue: 0,0:03:09.55,0:03:16.19,Default,,0000,0000,0000,,шайтан бейнесінде'
Dialogue: 0,0:03:16.19,0:03:22.76,Default,,0000,0000,0000,,・'Балалар өздерінің
Dialogue: 0,0:03:16.19,0:03:22.76,Default,,0000,0000,0000,,соңғы тиындарына жабысып қалады'
Dialogue: 0,0:03:22.76,0:03:29.10,Default,,0000,0000,0000,,・'Құрту мен жаңғыру
Dialogue: 0,0:03:22.76,0:03:29.10,Default,,0000,0000,0000,,Сен – нағыз жаусың'
Dialogue: 0,0:03:29.10,0:03:43.60,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:51.46,0:03:55.10,Default,,0000,0000,0000,,Қандай керемет ғимарат!
Dialogue: 0,0:03:51.46,0:03:55.10,Default,,0000,0000,0000,,Мен мұнда алғаш рет келіп тұрмын…
Dialogue: 0,0:03:55.10,0:03:58.60,Default,,0000,0000,0000,,Мен де…
Dialogue: 0,0:03:55.10,0:03:58.60,Default,,0000,0000,0000,,Сендердің бақтарың бар екен.
Dialogue: 0,0:03:58.60,0:04:02.00,Default,,0000,0000,0000,,Бүгін тойып ал.
Dialogue: 0,0:03:58.60,0:04:02.00,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:04:02.00,0:04:04.91,Default,,0000,0000,0000,,…Не болды, Миа? Сен әбден қобалжып тұрсың.
Dialogue: 0,0:04:04.91,0:04:06.91,Default,,0000,0000,0000,,…! Ә, жоқ…
Dialogue: 0,0:04:06.91,0:04:09.08,Default,,0000,0000,0000,,Сен тым қобалжып кеткенсің, Миа.
Dialogue: 0,0:04:09.08,0:04:11.75,Default,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:04:09.08,0:04:11.75,Default,,0000,0000,0000,,Қайдан келдің сен, шалғай ауылдан ма әлде!
Dialogue: 0,0:04:11.75,0:04:14.08,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:04:11.75,0:04:14.08,Default,,0000,0000,0000,,Ж-жоқ…! Кая!
Dialogue: 0,0:04:14.08,0:04:17.55,Default,,0000,0000,0000,,Шынымен мұндай жерде
Dialogue: 0,0:04:14.08,0:04:17.55,Default,,0000,0000,0000,,Маре тұтқындары жұмыс істейді ме?
Dialogue: 0,0:04:17.55,0:04:19.99,Default,,0000,0000,0000,,Шынында да, сондықтан
Dialogue: 0,0:04:17.55,0:04:19.99,Default,,0000,0000,0000,,сенімді бол!
Dialogue: 0,0:04:19.99,0:04:22.02,Default,,0000,0000,0000,,Бұл орын
Dialogue: 0,0:04:19.99,0:04:22.02,Default,,0000,0000,0000,,әскерилер жиі
Dialogue: 0,0:04:22.02,0:04:25.72,Default,,0000,0000,0000,,келетін орын.
Dialogue: 0,0:04:22.02,0:04:25.72,Default,,0000,0000,0000,,Марлиден келген бірнеше адаммен танысу
Dialogue: 0,0:04:27.53,0:04:30.47,Default,,0000,0000,0000,,өзі-ақ сенімділік береді.
Dialogue: 0,0:04:27.53,0:04:30.47,Default,,0000,0000,0000,,Мистер Блауз,
Dialogue: 0,0:04:30.47,0:04:33.07,Default,,0000,0000,0000,,Шақырғаның үшін рахмет.
Dialogue: 0,0:04:38.07,0:04:41.94,Rubi,,0000,0000,0000,,Бос емеспін.
Dialogue: 0,0:04:38.07,0:04:41.94,Default,,0000,0000,0000,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:04:41.94,0:04:44.38,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:04:44.38,0:04:47.22,Default,,0000,0000,0000,,Әйтеуір, тегін ғой. Кешір.
Dialogue: 0,0:04:47.22,0:04:51.02,Default,,0000,0000,0000,,Жоқ… бүгін маған қалдыр.
Dialogue: 0,0:04:47.22,0:04:51.02,Default,,0000,0000,0000,,Жарайды, өзін еркін ұста.
Dialogue: 0,0:04:51.02,0:04:55.62,Default,,0000,0000,0000,,Әке, мен қатты ашпын!
Dialogue: 0,0:04:51.02,0:04:55.62,Default,,0000,0000,0000,,Түсінемін, түсінемін.
Dialogue: 0,0:04:55.62,0:04:58.99,Default,,0000,0000,0000,,Мисс Блузды шақырған сол адам ғой—
Dialogue: 0,0:04:55.62,0:04:58.99,Default,,0000,0000,0000,,Мареден келген мырза Николао…
Dialogue: 0,0:04:58.99,0:05:01.23,Default,,0000,0000,0000,,Неге одан көмек сұрамайсың?
Dialogue: 0,0:05:01.23,0:05:05.97,Default,,0000,0000,0000,,Мисс Блуз тіпті әскер де емес—
Dialogue: 0,0:05:01.23,0:05:05.97,Default,,0000,0000,0000,,неге оны мұнда шақырды?
Dialogue: 0,0:05:05.97,0:05:09.94,Default,,0000,0000,0000,,Менің үлкен әпкем – мисс Блуздың қызы еді
Dialogue: 0,0:05:05.97,0:05:09.94,Default,,0000,0000,0000,,және ол бұрын сарбаз болған.
Dialogue: 0,0:05:09.94,0:05:12.41,Default,,0000,0000,0000,,Қабірге келген мырза Никола...
Dialogue: 0,0:05:12.41,0:05:16.68,Default,,0000,0000,0000,,үлкен әпкеме арналған тамақты
Dialogue: 0,0:05:12.41,0:05:16.68,Default,,0000,0000,0000,,өзіне бере ала ма деп сұрады...
Dialogue: 0,0:05:16.68,0:05:20.65,Default,,0000,0000,0000,,Дегенмен, меніңше, олар екеуі
Dialogue: 0,0:05:16.68,0:05:20.65,Default,,0000,0000,0000,,жұп болған.
Dialogue: 0,0:05:20.65,0:05:22.75,Default,,0000,0000,0000,,Мен сені капитанға шағымданамын!!
Dialogue: 0,0:05:25.52,0:05:28.09,Default,,0000,0000,0000,,Бен! Не болды?
Dialogue: 0,0:05:28.09,0:05:30.59,Default,,0000,0000,0000,,Асқазаның ауырды ма, әлде бірдеңе ме?
Dialogue: 0,0:05:28.09,0:05:30.59,Default,,0000,0000,0000,,Ах… жоқ…!
Dialogue: 0,0:05:35.53,0:05:38.73,Rubi,,0000,0000,0000,,иығыңа көтергеніңе бір жыл болды.
Dialogue: 0,0:05:35.53,0:05:38.73,Default,,0000,0000,0000,,Бұл керемет!! Мен бұрын-соңды осындай дәмді тамақ жеген емеспін!!
Dialogue: 0,0:05:41.90,0:05:45.20,Default,,0000,0000,0000,,Әлі де жалғасады!!
Dialogue: 0,0:05:41.90,0:05:45.20,Default,,0000,0000,0000,,Негізгі тағам әлі келген жоқ!!
Dialogue: 0,0:05:47.68,0:05:51.68,Default,,0000,0000,0000,,Николао, саған қонақ келген екен.
Dialogue: 0,0:05:47.68,0:05:51.68,Default,,0000,0000,0000,,Мұндай уақытта мұнда кім келуі мүмкін...
Dialogue: 0,0:05:53.35,0:05:55.68,Default,,0000,0000,0000,,Бұл – Зерттеу корпусы.
Dialogue: 0,0:05:55.68,0:06:00.26,Default,,0000,0000,0000,,Сіздер ме... Не болды? Өте маңызды ма?
Dialogue: 0,0:06:00.26,0:06:03.29,Default,,0000,0000,0000,,Мен қазір
Dialogue: 0,0:06:00.26,0:06:03.29,Default,,0000,0000,0000,,маңызды қонақты қарсы алумен айналысып жатырмын.
Dialogue: 0,0:06:03.29,0:06:06.63,Default,,0000,0000,0000,,А...
Dialogue: 0,0:06:03.29,0:06:06.63,Default,,0000,0000,0000,,Әрине, жұмысыңызға қайта оралуға боссыз.
Dialogue: 0,0:06:06.63,0:06:10.50,Default,,0000,0000,0000,,Тек... кейінірек
Dialogue: 0,0:06:06.63,0:06:10.50,Default,,0000,0000,0000,,Шақырғаның үшін рахмет.
Dialogue: 0,0:06:10.50,0:06:13.50,Default,,0000,0000,0000,,Бос емеспін.
Dialogue: 0,0:06:13.50,0:06:17.34,Default,,0000,0000,0000,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:06:17.34,0:06:19.97,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:06:17.34,0:06:19.97,Default,,0000,0000,0000,,Әйтеуір, тегін ғой. Кешір.
Dialogue: 0,0:06:19.97,0:06:22.74,Default,,0000,0000,0000,,Жоқ… бүгін маған қалдыр.
Dialogue: 0,0:06:19.97,0:06:22.74,Default,,0000,0000,0000,,Жарайды, өзін еркін ұста.
Dialogue: 0,0:06:22.74,0:06:24.74,Default,,0000,0000,0000,,Әке, мен қатты ашпын!
Dialogue: 0,0:06:27.08,0:06:29.02,Default,,0000,0000,0000,,Түсінемін, түсінемін.
Dialogue: 0,0:06:29.02,0:06:31.92,Default,,0000,0000,0000,,Мисс Блузды шақырған сол адам ғой—
Dialogue: 0,0:06:31.92,0:06:34.76,Default,,0000,0000,0000,,Мареден келген мырза Николао…
Dialogue: 0,0:06:34.76,0:06:36.69,Default,,0000,0000,0000,,Неге одан көмек сұрамайсың?
Dialogue: 0,0:06:36.69,0:06:39.59,Rubi,,0000,0000,0000,,(Есік ашылу дыбысы)
Dialogue: 0,0:06:36.69,0:06:39.59,Default,,0000,0000,0000,,Мисс Блуз тіпті әскер де емес—
Dialogue: 0,0:06:39.59,0:06:42.63,Default,,0000,0000,0000,,неге оны мұнда шақырды?
Dialogue: 0,0:06:39.59,0:06:42.63,Default,,0000,0000,0000,,Менің үлкен әпкем – мисс Блуздың қызы еді
Dialogue: 0,0:06:42.63,0:06:45.97,Default,,0000,0000,0000,,және ол бұрын сарбаз болған.
Dialogue: 0,0:06:42.63,0:06:45.97,Default,,0000,0000,0000,,Қабірге келген мырза Никола...
Dialogue: 0,0:06:45.97,0:06:50.61,Default,,0000,0000,0000,,үлкен әпкеме арналған тамақты
Dialogue: 0,0:06:45.97,0:06:50.61,Default,,0000,0000,0000,,өзіне бере ала ма деп сұрады...
Dialogue: 0,0:06:50.61,0:06:53.11,Default,,0000,0000,0000,,Дегенмен, меніңше, олар екеуі
Dialogue: 0,0:06:50.61,0:06:53.11,Default,,0000,0000,0000,,жұп болған.
Dialogue: 0,0:06:53.11,0:06:56.48,Default,,0000,0000,0000,,Ха, ха…
Dialogue: 0,0:06:53.11,0:06:56.48,Default,,0000,0000,0000,,Бен! Не болды?
Dialogue: 0,0:06:56.48,0:06:58.78,Default,,0000,0000,0000,,Асқазаның ауырды ма, әлде бірдеңе ме?
Dialogue: 0,0:06:58.78,0:07:00.78,Default,,0000,0000,0000,,Ах… жоқ…!
Dialogue: 0,0:07:02.48,0:07:05.39,Default,,0000,0000,0000,,Бұл керемет!! Мен бұрын-соңды осындай дәмді тамақ жеген емеспін!!
Dialogue: 0,0:07:02.48,0:07:05.39,Default,,0000,0000,0000,,Әлі де жалғасады!!
Dialogue: 0,0:07:05.39,0:07:07.62,Default,,0000,0000,0000,,Негізгі тағам әлі келген жоқ!!
Dialogue: 0,0:07:05.39,0:07:07.62,Default,,0000,0000,0000,,Николао, саған қонақ келген екен.
