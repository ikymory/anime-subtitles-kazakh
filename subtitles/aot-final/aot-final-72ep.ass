Dialogue: 0,0:19:15.82,0:19:19.39,Rubi,,0000,0000,0000,,Жарайды, өзін еркін ұста.
Dialogue: 0,0:19:15.82,0:19:19.39,Default,,0000,0000,0000,,Әке, мен қатты ашпын!
Dialogue: 0,0:19:19.39,0:19:24.23,Default,,0000,0000,0000,,Түсінемін, түсінемін.
Dialogue: 0,0:19:19.39,0:19:24.23,Default,,0000,0000,0000,,Мисс Блузды шақырған сол адам ғой—
Dialogue: 0,0:19:24.23,0:19:26.29,Default,,0000,0000,0000,,Мареден келген мырза Николао…
Dialogue: 0,0:19:26.29,0:19:29.13,Rubi,,0000,0000,0000,,Елдіандықтар маған бұйрық беріп тұр ма?
Dialogue: 0,0:19:26.29,0:19:29.13,Default,,0000,0000,0000,,Неге одан көмек сұрамайсың?
Dialogue: 0,0:19:29.13,0:19:31.73,Default,,0000,0000,0000,,Мисс Блуз тіпті әскер де емес—
Dialogue: 0,0:19:31.73,0:19:36.44,Default,,0000,0000,0000,,неге оны мұнда шақырды?
Dialogue: 0,0:19:31.73,0:19:36.44,Default,,0000,0000,0000,,Менің үлкен әпкем – мисс Блуздың қызы еді
Dialogue: 0,0:19:31.73,0:19:36.44,Default,,0000,0000,0000,,Түннің осы уақытында қайда барасың?
Dialogue: 0,0:19:36.44,0:19:39.44,Default,,0000,0000,0000,,және ол бұрын сарбаз болған.
Dialogue: 0,0:19:36.44,0:19:39.44,Default,,0000,0000,0000,,(аяқ дыбыстары)
Dialogue: 0,0:19:41.18,0:19:43.18,Default,,0000,0000,0000,,Қабірге келген мырза Никола...
Dialogue: 0,0:19:45.41,0:19:47.38,Default,,0000,0000,0000,,үлкен әпкеме арналған тамақты
Dialogue: 0,0:19:47.38,0:19:50.25,Default,,0000,0000,0000,,өзіне бере ала ма деп сұрады...
Dialogue: 0,0:19:47.38,0:19:50.25,Default,,0000,0000,0000,,Дегенмен, меніңше, олар екеуі
Dialogue: 0,0:19:50.25,0:19:54.09,Default,,0000,0000,0000,,жұп болған.
Dialogue: 0,0:19:50.25,0:19:54.09,Default,,0000,0000,0000,,Бен! Не болды?
Dialogue: 0,0:19:54.09,0:19:57.09,Default,,0000,0000,0000,,Асқазаның ауырды ма, әлде бірдеңе ме?
Dialogue: 0,0:19:54.09,0:19:57.09,Default,,0000,0000,0000,,Ах… жоқ…!
Dialogue: 0,0:19:57.09,0:19:59.56,Default,,0000,0000,0000,,Бұл керемет!! Мен бұрын-соңды осындай дәмді тамақ жеген емеспін!!
Dialogue: 0,0:19:59.56,0:20:03.53,Default,,0000,0000,0000,,Әлі де жалғасады!!
Dialogue: 0,0:19:59.56,0:20:03.53,Default,,0000,0000,0000,,Негізгі тағам әлі келген жоқ!!
Dialogue: 0,0:20:03.53,0:20:09.57,Default,,0000,0000,0000,,Николао, саған қонақ келген екен.
Dialogue: 0,0:20:03.53,0:20:09.57,Default,,0000,0000,0000,,Мұндай уақытта мұнда кім келуі мүмкін...
Dialogue: 0,0:20:09.57,0:20:12.21,Default,,0000,0000,0000,,Бұл – Зерттеу корпусы.
Dialogue: 0,0:20:12.21,0:20:14.48,Default,,0000,0000,0000,,Сіздер ме... Не болды? Өте маңызды ма?
Dialogue: 0,0:20:14.48,0:20:20.01,Default,,0000,0000,0000,,Мен қазір
Dialogue: 0,0:20:14.48,0:20:20.01,Default,,0000,0000,0000,,маңызды қонақты қарсы алумен айналысып жатырмын.
Dialogue: 0,0:20:20.01,0:20:22.72,Default,,0000,0000,0000,,Әрине, жұмысыңызға қайта оралуға боссыз.
Dialogue: 0,0:20:22.72,0:20:27.55,Default,,0000,0000,0000,,Тек... кейінірек
Dialogue: 0,0:20:22.72,0:20:27.55,Default,,0000,0000,0000,,Шақырғаның үшін рахмет.
Dialogue: 0,0:20:27.55,0:20:30.02,Default,,0000,0000,0000,,Бос емеспін.
Dialogue: 0,0:20:30.02,0:20:33.06,Default,,0000,0000,0000,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:20:33.06,0:20:35.60,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:20:35.60,0:20:40.30,Default,,0000,0000,0000,,Әйтеуір, тегін ғой. Кешір.
Dialogue: 0,0:20:35.60,0:20:40.30,Default,,0000,0000,0000,,Жоқ… бүгін маған қалдыр.
