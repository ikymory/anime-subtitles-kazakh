Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.01,0:00:17.93,Default,,0,0,0,,(ер адамның қатты тыныс алуы)
Dialogue: 0,0:00:18.01,0:00:20.39,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:00:20.47,0:00:25.40,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:00:28.11,0:00:28.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:29.02,0:00:29.90,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:00:30.90,0:00:33.57,Default,,0,0,0,,Бір күні мұндай күн келеді деп ойламаппын.
Dialogue: 0,0:00:33.65,0:00:34.90,Default,,0,0,0,,Сіз мұны ақырында орындадыңыз.
Dialogue: 0,0:00:34.99,0:00:36.03,Default,,0,0,0,,Детектив Такаги
Dialogue: 0,0:00:36.11,0:00:39.12,Default,,0,0,0,,Бірақ, бұл кенеттен шешілді.
Dialogue: 0,0:00:39.20,0:00:40.58,Default,,0,0,0,,- (Хайбара) Иә, иә - Иә...
Dialogue: 0,0:00:41.58,0:00:43.08,Default,,0,0,0,,Сіз шынымен келе жатырсыз ба?
Dialogue: 0,0:00:43.16,0:00:46.62,Default,,0,0,0,,Бұл анонимді кеңес. Үміт аз.
Dialogue: 0,0:00:46.71,0:00:48.08,Default,,0,0,0,,Бұл жігіт, солай ма?
Dialogue: 0,0:00:48.17,0:00:51.09,Default,,0,0,0,,Фуруя мырзаның синхрондау...
Dialogue: 0,0:00:52.59,0:00:54.30,Default,,0,0,0,,Артық кеткені үшін кешірім сұраймыз.
Dialogue: 0,0:00:54.38,0:00:56.09,Default,,0,0,0,,- (Амуро) Мен кептеліп қалдым. - (Казами) А?
Dialogue: 0,0:00:56.18,0:00:58.18,Default,,0,0,0,,Бомбаларды білу
Dialogue: 0,0:00:58.26,0:01:01.10,Default,,0,0,0,,Қашу жоспарын құрастыруға және орындауға күш-қуатыңыз болуы.
Dialogue: 0,0:01:01.18,0:01:03.35,Default,,0,0,0,,Менің ойымша, бұл адамда жоқ.
Dialogue: 0,0:01:03.43,0:01:04.60,Default,,0,0,0,,Мен оларға мүлде қызықпаймын—
Dialogue: 0,0:01:04.68,0:01:05.52,Default,,0,0,0,,Ах
Dialogue: 0,0:01:06.02,0:01:06.85,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:06.94,0:01:07.77,Default,,0,0,0,,Ах
Dialogue: 0,0:01:07.85,0:01:09.81,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:01:09.81,0:01:11.90,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:01:09.81,0:01:11.90,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:01:11.90,0:01:11.98,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:01:11.98,0:01:12.86,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:01:11.98,0:01:12.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:12.86,0:01:13.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:15.15,0:01:17.91,Default,,0,0,0,,Детектив Сато Өте әдемі
Dialogue: 0,0:01:17.99,0:01:19.53,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:01:21.58,0:01:23.41,Default,,0,0,0,,Мен де бір күні Ранмен бірге боламын...
Dialogue: 0,0:01:23.50,0:01:25.83,Default,,0,0,0,,Иә? Не болды? Конан-кун
Dialogue: 0,0:01:25.91,0:01:28.75,Default,,0,0,0,,Иә! А... бұл ештеңе емес.
Dialogue: 0,0:01:28.83,0:01:30.21,Default,,0,0,0,,Мына жырау
Dialogue: 0,0:01:30.29,0:01:32.71,Default,,0,0,0,,Сіз Ранның сіздің әйеліңіз болғанын қаламайсыз ба?
Dialogue: 0,0:01:32.80,0:01:33.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:33.71,0:01:35.88,Default,,0,0,0,,Жоқ, хехехе...
Dialogue: 0,0:01:35.97,0:01:37.38,Default,,0,0,0,,Біздің Yotsuba тобымыздың әрі қарай өсуі мен дамуы үшін,
Dialogue: 0,0:01:38.51,0:01:39.93,Default,,0,0,0,,Хаха...
Dialogue: 0,0:01:45.02,0:01:46.85,Default,,0,0,0,,Ватару Такаги
Dialogue: 0,0:01:46.94,0:01:49.35,Default,,0,0,0,,Сіз Мивако-санды өміріңіздің соңына дейін қорғайсыз.
Dialogue: 0,0:01:49.35,0:01:50.23,Default,,0,0,0,,Сіз Мивако-санды өміріңіздің соңына дейін қорғайсыз.
Dialogue: 0,0:01:49.35,0:01:50.23,Default,,0,0,0,,Уаааа
Dialogue: 0,0:01:50.23,0:01:51.06,Default,,0,0,0,,Сіз Мивако-санды өміріңіздің соңына дейін қорғайсыз.
Dialogue: 0,0:01:51.15,0:01:54.69,Default,,0,0,0,,Күліп жүріңіз, өзіңізді бақытты етіңіз
Dialogue: 0,0:01:54.78,0:01:56.19,Default,,0,0,0,,Сіз ант бересіз бе?
Dialogue: 0,0:01:56.28,0:01:58.20,Default,,0,0,0,,Иә, ант етемін!
Dialogue: 0,0:02:00.49,0:02:02.37,Default,,0,0,0,,Мивако-сан
Dialogue: 0,0:02:02.45,0:02:03.12,Default,,0,0,0,,Сіз әрқашан
Dialogue: 0,0:02:03.12,0:02:04.58,Default,,0,0,0,,Сіз әрқашан
Dialogue: 0,0:02:03.12,0:02:04.58,Default,,0,0,0,,Маған көмектесіңізші...
Dialogue: 0,0:02:04.66,0:02:06.25,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:04.66,0:02:06.25,Default,,0,0,0,,Ватару-санға өмір бойы қолдау көрсету —
Dialogue: 0,0:02:06.25,0:02:07.21,Default,,0,0,0,,Ватару-санға өмір бойы қолдау көрсету —
Dialogue: 0,0:02:07.21,0:02:08.75,Default,,0,0,0,,Ватару-санға өмір бойы қолдау көрсету —
Dialogue: 0,0:02:07.21,0:02:08.75,Default,,0,0,0,,Ах, аа... (электрондық дыбыс)
Dialogue: 0,0:02:08.83,0:02:12.21,Default,,0,0,0,,Сіз сүюді жалғастыруға уәде бересіз бе?
Dialogue: 0,0:02:17.26,0:02:18.84,Default,,0,0,0,,Мивако!
Dialogue: 0,0:02:18.93,0:02:22.30,Default,,0,0,0,,Егер сен осылай біреуге үйленсең, мен сені өлтіремін!
Dialogue: 0,0:02:22.39,0:02:23.93,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:02:24.89,0:02:26.60,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,0:02:27.93,0:02:28.94,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:29.02,0:02:29.85,Default,,0,0,0,,Ағай
Dialogue: 0,0:02:29.94,0:02:31.15,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:02:31.94,0:02:33.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:33.40,0:02:34.57,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:34.65,0:02:35.86,Default,,0,0,0,,Уау
Dialogue: 0,0:02:36.44,0:02:37.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:37.53,0:02:39.11,Default,,0,0,0,,Итеттете... Ей, тентек!
Dialogue: 0,0:02:39.20,0:02:40.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:40.91,0:02:41.74,Default,,0,0,0,,Ах
Dialogue: 0,0:02:42.41,0:02:43.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:43.58,0:02:44.70,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:02:44.78,0:02:46.62,Default,,0,0,0,,Дұрыс емес аяқ киім!
Dialogue: 0,0:02:48.54,0:02:49.75,Default,,0,0,0,,Уф
Dialogue: 0,0:02:50.62,0:02:51.79,Default,,0,0,0,,Флюгер! Кетіңіз
Dialogue: 0,0:02:51.88,0:02:52.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:52.83,0:02:54.75,Default,,0,0,0,,Маған көмектесіңізші...
Dialogue: 0,0:02:58.38,0:02:59.22,Default,,0,0,0,,Уау
Dialogue: 0,0:03:02.72,0:03:05.97,Default,,0,0,0,,Қарғыс атқыр... жақсысың ба? Жел... Уф
Dialogue: 0,0:03:06.06,0:03:07.27,Default,,0,0,0,,Ах
Dialogue: 0,0:03:09.93,0:03:11.31,Default,,0,0,0,,Әй
Dialogue: 0,0:03:13.44,0:03:14.48,Default,,0,0,0,,Казами…
Dialogue: 0,0:03:15.23,0:03:17.48,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:03:17.57,0:03:18.57,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:18.65,0:03:20.36,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:21.24,0:03:22.11,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:22.20,0:03:23.82,Default,,0,0,0,,Гухаа
Dialogue: 0,0:03:24.53,0:03:25.91,Default,,0,0,0,,- (Такаги) Уф - (Сато) Такаги-кун!
Dialogue: 0,0:03:28.33,0:03:30.21,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:03:30.29,0:03:31.75,Default,,0,0,0,,Жаттығу аяқталды!
Dialogue: 0,0:03:31.83,0:03:32.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:32.75,0:03:35.17,Default,,0,0,0,,- (Детектив) А? Сіз соққы алдыңыз ба? - (Детектив) Шынайысың ба?
Dialogue: 0,0:03:35.25,0:03:38.67,Default,,0,0,0,,Сіз не істеп жатырсыз? Күйеу жігіт атылды!
Dialogue: 0,0:03:35.25,0:03:38.67,Default,,0,0,0,,Ах, аа... а...
Dialogue: 0,0:03:38.76,0:03:40.88,Default,,0,0,0,,Қауіпсіздік жүйесін қайта қарау керек!
Dialogue: 0,0:03:40.97,0:03:44.59,Default,,0,0,0,,Аа, бояуы кетпейді, солай ма?
Dialogue: 0,0:03:44.68,0:03:45.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:46.14,0:03:47.68,Default,,0,0,0,,Не болды? Сато мырза
Dialogue: 0,0:03:47.76,0:03:51.23,Default,,0,0,0,,А... бұл ештеңе емес.
Dialogue: 0,0:03:51.85,0:03:53.77,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:03:53.85,0:03:55.65,Default,,0,0,0,,Мен оны түсінбеймін.
Dialogue: 0,0:03:55.73,0:03:57.40,Default,,0,0,0,,Бұл детектив Такаги мен детектив Сатоның үйлену тойы емес пе еді?
Dialogue: 0,0:03:57.40,0:03:59.15,Default,,0,0,0,,Бұл детектив Такаги мен детектив Сатоның үйлену тойы емес пе еді?
Dialogue: 0,0:03:57.40,0:03:59.15,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:03:59.23,0:04:02.99,Default,,0,0,0,,Жоқ, кешіріңіз, кешіріңіз. Бұл нағыз жаттығу сабағы сияқты.
Dialogue: 0,0:04:03.07,0:04:05.53,Default,,0,0,0,,Мен саған ештеңе айтқан жоқпын.
Dialogue: 0,0:04:05.62,0:04:06.91,Default,,0,0,0,,- (Аюми және т.б.) Иә... - Эй, эй...
Dialogue: 0,0:04:06.99,0:04:11.41,Default,,0,0,0,,Шын мәнінде, бұрынғы басшы Цутому Муранака үйленеді.
Dialogue: 0,0:04:12.00,0:04:16.08,Default,,0,0,0,,Тойдың күзетіне Морикун екеуміз жауапты боламыз.
Dialogue: 0,0:04:16.17,0:04:17.67,Default,,0,0,0,,Әке, сіз білесіз бе?
Dialogue: 0,0:04:17.75,0:04:19.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:17.75,0:04:19.38,Default,,0,0,0,,Сол себепті тез алға шықтыңыз ба?
Dialogue: 0,0:04:19.38,0:04:20.42,Default,,0,0,0,,Сол себепті тез алға шықтыңыз ба?
Dialogue: 0,0:04:20.51,0:04:24.05,Default,,0,0,0,,Менің ойымша, бұрынғы бас инспектор Муранака инспектор-дононың замандасы болды.
Dialogue: 0,0:04:24.13,0:04:26.05,Default,,0,0,0,,Әй, мен бірінші көтерілдім.
Dialogue: 0,0:04:26.64,0:04:29.51,Default,,0,0,0,,Бірнеше жыл бұрын мен ауыр жарақат алып, зейнеткерлікке шықтым.
Dialogue: 0,0:04:29.60,0:04:32.56,Default,,0,0,0,,Мен ауруханада жатқанда тағдырлы кездесу болған сияқты.
Dialogue: 0,0:04:33.48,0:04:37.06,Default,,0,0,0,,Мен зейнеткерлікке шыққаннан кейін хабарласпады деп уайымдадым.
Dialogue: 0,0:04:37.15,0:04:39.11,Default,,0,0,0,,Шынымды айтсам, таң қалдым.
Dialogue: 0,0:04:39.19,0:04:43.07,Default,,0,0,0,,Бірақ неге бірінші тергеу бөлімі тойдағы қауіпсіздікке жауапты?
Dialogue: 0,0:04:43.15,0:04:46.45,Default,,0,0,0,,Мұранакаға қорқытқан хат келеді.
Dialogue: 0,0:04:46.53,0:04:49.83,Default,,0,0,0,,Белсенді жылдары ол көптеген қылмыскерлерді ұстады.
Dialogue: 0,0:04:49.91,0:04:52.04,Default,,0,0,0,,Көптеген адамдар әлі күнге дейін кек сақтайды
Dialogue: 0,0:04:52.12,0:04:53.87,Default,,0,0,0,,Бұл өшпенділік дегенді білдіре ме?
Dialogue: 0,0:04:53.96,0:04:56.75,Default,,0,0,0,,Иә, сондықтан мен оны күзетуге рұқсат беруін өтіндім.
Dialogue: 0,0:04:56.83,0:04:59.38,Default,,0,0,0,,Мен жоғарғы басшылыққа өтініш жасадым.
Dialogue: 0,0:04:59.46,0:05:03.55,Default,,0,0,0,,Біз Муранака тұтқындалған адамдардың да жүздерін білеміз.
Dialogue: 0,0:05:03.63,0:05:07.39,Default,,0,0,0,,Мен бірдеңе бола қалса, оны жеңе аламын деп ойладым.
Dialogue: 0,0:05:07.47,0:05:10.43,Default,,0,0,0,,Амансың ба? Мивако, мен саған су әкелемін.
Dialogue: 0,0:05:10.51,0:05:12.14,Default,,0,0,0,,3 жыл болды.
Dialogue: 0,0:05:12.22,0:05:14.52,Default,,0,0,0,,Бұл сіз болдыңыз ба?
Dialogue: 0,0:05:14.60,0:05:17.02,Default,,0,0,0,,Қашып кетсеңіз, мен шығамын.
Dialogue: 0,0:05:17.69,0:05:19.52,Default,,0,0,0,,Менің ойымша, сіз оны осылай оқыдыңыз.
Dialogue: 0,0:05:20.90,0:05:23.03,Default,,0,0,0,,Не болды? Детектив Сато
Dialogue: 0,0:05:23.11,0:05:26.61,Default,,0,0,0,,Конан-кун... бұл ештеңе емес.
Dialogue: 0,0:05:26.70,0:05:29.66,Default,,0,0,0,,Бірақ сіз оны бірден көресіз.
Dialogue: 0,0:05:30.49,0:05:33.66,Default,,0,0,0,,Такаги-кун бұрын құлаған кезде
Dialogue: 0,0:05:35.37,0:05:38.21,Default,,0,0,0,,Мен мұны тағы көрдім.
Dialogue: 0,0:05:39.50,0:05:42.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:39.50,0:05:42.63,Default,,0,0,0,,Хмм... Уф
Dialogue: 0,0:05:42.71,0:05:44.30,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:05:44.30,0:05:45.13,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:05:44.30,0:05:45.13,Default,,0,0,0,,Мен Такаги-кунды өзіммен бірге алып кетейін деп жатырмын.
Dialogue: 0,0:05:45.13,0:05:47.63,Default,,0,0,0,,Такаги-кунды өзіммен бірге алып кетейін деп жатырмын.
Dialogue: 0,0:05:47.72,0:05:49.18,Default,,0,0,0,,Өлім Құдайы
Dialogue: 0,0:05:49.26,0:05:54.27,Default,,0,0,0,,♪~
Dialogue: 0,0:06:03.11,0:06:05.69,Default,,0,0,0,,Мен Шиничи Кудомын, орта мектептің детективімін.
Dialogue: 0,0:06:05.78,0:06:09.66,Default,,0,0,0,,Мен бала күнгі досым және сыныптасым Ран Моримен ойын-сауық саябағына бардым.
Dialogue: 0,0:06:09.74,0:06:14.29,Default,,0,0,0,,Мен қара киінген адамның күдікті мәмілесінің куәсі болдым.
Dialogue: 0,0:06:14.37,0:06:16.50,Default,,0,0,0,,Мен транзакцияны қарауға берілгенмін.
Dialogue: 0,0:06:16.58,0:06:19.37,Default,,0,0,0,,Артынан келе жатқан басқа серігін байқамадым.
Dialogue: 0,0:06:22.21,0:06:25.34,Default,,0,0,0,,Ол кісі маған у ішті.
Dialogue: 0,0:06:25.42,0:06:27.34,Default,,0,0,0,,Мен оянғанда...
Dialogue: 0,0:06:31.72,0:06:34.64,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:06:34.72,0:06:37.48,Default,,0,0,0,,Егер олар Шиничи Кудоның тірі екенін білсе ше?
Dialogue: 0,0:06:37.56,0:06:41.23,Default,,0,0,0,,Сонымен қатар сіздің өміріңізге қауіп төніп, айналаңыздағы адамдарға да зиян тиеді.
Dialogue: 0,0:06:42.15,0:06:45.82,Default,,0,0,0,,Доктор Агасаның кеңесі бойынша мен өзімнің шынайы тұлғамды жасыруды шештім.
Dialogue: 0,0:06:45.90,0:06:49.07,Default,,0,0,0,,Ран менің атымды сұрағанда, мен бірден айттым
Dialogue: 0,0:06:49.15,0:06:51.45,Default,,0,0,0,,Конан Эдогава деп аталған
Dialogue: 0,0:06:51.53,0:06:53.32,Default,,0,0,0,,Олар туралы мәлімет алу
Dialogue: 0,0:06:53.41,0:06:54.91,Default,,0,0,0,,Менің әкем детектив.
Dialogue: 0,0:06:54.99,0:06:56.99,Default,,0,0,0,,Ранның үйіне кіріп кетті
Dialogue: 0,0:06:59.25,0:07:02.67,Default,,0,0,0,,Бұл жігіттер Гента Мицухико Аюми
Dialogue: 0,0:07:02.75,0:07:05.25,Default,,0,0,0,,Бұл менің кішірейіп кеткен сыныптасым.
Dialogue: 0,0:07:06.13,0:07:07.63,Default,,0,0,0,,Ол Ай Хайбара
Dialogue: 0,0:07:07.71,0:07:10.51,Default,,0,0,0,,Қара ұйымның ғалымы және улы дәрі.
Dialogue: 0,0:07:10.59,0:07:13.39,Default,,0,0,0,,APTX4869 әзірлеушісі
Dialogue: 0,0:07:13.47,0:07:15.60,Default,,0,0,0,,Бірақ менің әпкем өлтірілгеннен бері
Dialogue: 0,0:07:15.68,0:07:16.85,Default,,0,0,0,,Ұйымға қарсы
Dialogue: 0,0:07:16.93,0:07:19.18,Default,,0,0,0,,Ол есірткіні өз өмірін аяқтау үшін қабылдаған.
Dialogue: 0,0:07:19.27,0:07:21.23,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:07:21.31,0:07:23.06,Default,,0,0,0,,Енді олардың көздерінен құтылу үшін
Dialogue: 0,0:07:23.15,0:07:24.77,Default,,0,0,0,,Доктор Агасаның үйінде тұрады
Dialogue: 0,0:07:27.86,0:07:29.99,Default,,0,0,0,,Сол қара ұйымның бір мүшесі
Dialogue: 0,0:07:30.07,0:07:32.86,Default,,0,0,0,,Бұл адам Тору Амуро
Dialogue: 0,0:07:32.95,0:07:36.37,Default,,0,0,0,,Бірақ оның шынайы ерекшелігі - ол қоғамдық қауіпсіздік полициясына бұйрық береді.
Dialogue: 0,0:07:36.45,0:07:40.66,Default,,0,0,0,,Ұлттық полиция агенттігінің Қауіпсіздік бюросының «Нөл» құпия ұйымына жататын полиция қызметкері.
Dialogue: 0,0:07:40.75,0:07:42.62,Default,,0,0,0,,Шын есімі - Рей Фуруя
Dialogue: 0,0:07:42.71,0:07:45.54,Default,,0,0,0,,Ұйымның ішкі жұмысын білу үшін оған ену
Dialogue: 0,0:07:46.17,0:07:49.42,Default,,0,0,0,,Детектив Сатодан бір мерзім бұрын детектив Такагимен танысады
Dialogue: 0,0:07:49.51,0:07:51.88,Default,,0,0,0,,Полиция академиясын бітірген студенттер
Dialogue: 0,0:07:51.97,0:07:54.80,Default,,0,0,0,,Шамасы, тағы төрт бұзық дос болды...
Dialogue: 0,0:07:54.89,0:07:56.10,Default,,0,0,0,,Сәлем Конан!
Dialogue: 0,0:07:56.18,0:07:58.01,Default,,0,0,0,,Әй, сен көп сөйлейсің.
Dialogue: 0,0:07:58.10,0:08:00.73,Default,,0,0,0,,Түсінікті болу үшін бұл спойлер!
Dialogue: 0,0:08:00.81,0:08:03.56,Default,,0,0,0,,Тездетіп, әрқашан жасайтын нәрсені айт.
Dialogue: 0,0:08:03.64,0:08:05.35,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:08:05.94,0:08:08.52,Default,,0,0,0,,Кішірейсең де, миың сол күйінде қалады
Dialogue: 0,0:08:08.61,0:08:11.24,Default,,0,0,0,,Лабиринті жоқ детектив
Dialogue: 0,0:08:11.32,0:08:14.95,Default,,0,0,0,,Әрқашан бір ақиқат бар!
Dialogue: 0,0:08:29.30,0:08:34.30,Default,,0,0,0,,~♪
Dialogue: 0,0:08:36.39,0:08:38.60,Default,,0,0,0,,Мазда… Цзиньпэй
Dialogue: 0,0:08:38.68,0:08:39.93,Default,,0,0,0,,А…?
Dialogue: 0,0:08:46.85,0:08:48.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:50.15,0:08:51.82,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:08:51.90,0:08:54.95,Default,,0,0,0,,Той жегім келді.
Dialogue: 0,0:08:51.90,0:08:54.95,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:08:55.03,0:08:58.16,Default,,0,0,0,,Мен бұл жаттығу екенін білмедім.
Dialogue: 0,0:08:58.24,0:09:01.24,Default,,0,0,0,,Бірақ детектив Сато әдемі еді, солай емес пе?
Dialogue: 0,0:09:02.62,0:09:05.71,Default,,0,0,0,,Өйткені қалыңдық көйлектері әйелдер үшін ерекше.
Dialogue: 0,0:09:05.79,0:09:10.38,Default,,0,0,0,,Эдогава-кун да біреудің қалыңдығы болуды қиялдаған сияқты.
Dialogue: 0,0:09:10.46,0:09:11.50,Default,,0,0,0,,-Ех... -(Аюми) Ех!
Dialogue: 0,0:09:11.59,0:09:12.80,Default,,0,0,0,,Біреу кім?
Dialogue: 0,0:09:12.88,0:09:13.71,Default,,0,0,0,,Жоқ, бұл тек қана тәжірибе.
Dialogue: 0,0:09:13.80,0:09:15.59,Default,,0,0,0,,Кобаяши мырза?
Dialogue: 0,0:09:15.68,0:09:16.59,Default,,0,0,0,,...Неге?
Dialogue: 0,0:09:17.30,0:09:19.47,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:19.55,0:09:21.68,Default,,0,0,0,,Бұл Хэллоуинге арналған косплей костюмі.
Dialogue: 0,0:09:21.76,0:09:23.39,Default,,0,0,0,,Мынаны киіп, бірге көңіл көтер
Dialogue: 0,0:09:23.47,0:09:25.98,Default,,0,0,0,,Хехе, әрине Конан мен Хайбара да.
Dialogue: 0,0:09:26.06,0:09:27.73,Default,,0,0,0,,Иә! Эй, сәл күте тұрыңыз.
Dialogue: 0,0:09:26.06,0:09:27.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:27.81,0:09:28.90,Default,,0,0,0,,Мен сондаймын...
Dialogue: 0,0:09:28.98,0:09:30.61,Default,,0,0,0,,Уау
Dialogue: 0,0:09:31.19,0:09:32.69,Default,,0,0,0,,Не ол?
Dialogue: 0,0:09:32.78,0:09:33.86,Default,,0,0,0,,- (Гента) Уау - (Конан/Мицухико) Уау!
Dialogue: 0,0:09:33.94,0:09:36.40,Default,,0,0,0,,Тотттттттттттттттттттттттттт...
Dialogue: 0,0:09:36.49,0:09:37.95,Default,,0,0,0,,Уф
Dialogue: 0,0:09:38.03,0:09:39.99,Default,,0,0,0,,Не... Бұл қандай тесік?
Dialogue: 0,0:09:41.03,0:09:42.24,Default,,0,0,0,,- (Ағаса) Әйтете... - Дәрігер!
Dialogue: 0,0:09:42.95,0:09:45.75,Default,,0,0,0,,Жоқ, кешіріңіз, кешіріңіз, мен сізді таң қалдырдым.
Dialogue: 0,0:09:45.83,0:09:48.37,Default,,0,0,0,,Бұл жолы не істеп жүрсің?
Dialogue: 0,0:09:48.46,0:09:49.50,Default,,0,0,0,,Міне
Dialogue: 0,0:09:49.58,0:09:52.63,Default,,0,0,0,,Конанның добы шығатын белбеу ме?
Dialogue: 0,0:09:52.71,0:09:56.63,Default,,0,0,0,,Қазір біз оны өте үлкен допты атқылай алатындай етіп жетілдіру үстіндеміз.
Dialogue: 0,0:09:56.72,0:09:58.26,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:09:58.34,0:10:01.05,Default,,0,0,0,,Аяқтауға жақын.
Dialogue: 0,0:10:01.14,0:10:04.77,Default,,0,0,0,,Егер беттің серпімділігі мен беріктігі арасындағы тепе-теңдікті реттесеңіз...
Dialogue: 0,0:10:04.85,0:10:07.31,Default,,0,0,0,,Сіз құлап, жарақат алуыңыз мүмкін еді!
Dialogue: 0,0:10:07.31,0:10:07.94,Default,,0,0,0,,Сіз құлап, жарақат алуыңыз мүмкін еді!
Dialogue: 0,0:10:07.31,0:10:07.94,Default,,0,0,0,,А…?
Dialogue: 0,0:10:07.94,0:10:08.02,Default,,0,0,0,,А…?
Dialogue: 0,0:10:08.02,0:10:08.56,Default,,0,0,0,,А…?
Dialogue: 0,0:10:08.02,0:10:08.56,Default,,0,0,0,,Ах хаха кешіріңіз, жақсысыз ба?
Dialogue: 0,0:10:08.56,0:10:10.31,Default,,0,0,0,,Аа хаха кешіріңіз, жақсысыз ба?
Dialogue: 0,0:10:10.40,0:10:12.98,Default,,0,0,0,,Мен сені кешірмеймін! Маған жыланбалық жеуге рұқсат етіңіз!
Dialogue: 0,0:10:13.07,0:10:15.57,Default,,0,0,0,,Бұл аздап көңілсіздеу.
Dialogue: 0,0:10:15.65,0:10:17.19,Default,,0,0,0,,Аха…
Dialogue: 0,0:10:15.65,0:10:17.19,Default,,0,0,0,,Сол жерде сені бірден тамақтандыратын біреу бар.
Dialogue: 0,0:10:17.19,0:10:18.49,Default,,0,0,0,,Сені бірден тамақтандыратын біреу бар.
Dialogue: 0,0:10:18.57,0:10:19.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:22.45,0:10:23.33,Default,,0,0,0,,Я...
Dialogue: 0,0:10:23.41,0:10:24.83,Default,,0,0,0,,Қалжың емес!
Dialogue: 0,0:10:24.91,0:10:28.21,Default,,0,0,0,,Мен неге бұл жігіттерді емдеуім керек!
Dialogue: 0,0:10:28.29,0:10:30.37,Default,,0,0,0,,Жарайды, жарайды, кейде.
Dialogue: 0,0:10:30.46,0:10:32.04,Default,,0,0,0,,Бұл мереке болады!
Dialogue: 0,0:10:32.13,0:10:33.79,Default,,0,0,0,,Кешегі сабаққа қатысты тексеру.
Dialogue: 0,0:10:33.88,0:10:35.05,Default,,0,0,0,,Елордалық полиция бөлімі мен барамын.
Dialogue: 0,0:10:35.13,0:10:36.34,Default,,0,0,0,,Түскі асты осы жерде ішейік.
Dialogue: 0,0:10:36.42,0:10:37.63,Default,,0,0,0,,Жаңа ғана айттым!
Dialogue: 0,0:10:37.72,0:10:40.63,Default,,0,0,0,,Сондықтан бәрі бірге жесе дәмді болады.
Dialogue: 0,0:10:40.72,0:10:42.43,Default,,0,0,0,,- (Мицухико) Мен темпура жегім келеді! - (Когоро) Хмм?
Dialogue: 0,0:10:42.51,0:10:43.39,Default,,0,0,0,,Мен де!
Dialogue: 0,0:10:43.47,0:10:46.39,Default,,0,0,0,,Мен жыланбалықпын! Жылан балық күрішін жеңіз
Dialogue: 0,0:10:46.47,0:10:46.97,Default,,0,0,0,,Хаха, бұл жақсы.
Dialogue: 0,0:10:46.97,0:10:47.77,Default,,0,0,0,,Хаха, бұл жақсы.
Dialogue: 0,0:10:46.97,0:10:47.77,Default,,0,0,0,,Эй, уайымдама.
Dialogue: 0,0:10:47.77,0:10:48.64,Default,,0,0,0,,Эй, уайымдама.
Dialogue: 0,0:10:48.64,0:10:49.69,Default,,0,0,0,,Эй, уайымдама.
Dialogue: 0,0:10:48.64,0:10:49.69,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:49.77,0:10:50.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:50.85,0:10:54.02,Default,,0,0,0,,О, эй, мен оны тастадым.
Dialogue: 0,0:10:54.11,0:10:55.40,Default,,0,0,0,,О...
Dialogue: 0,0:11:04.08,0:11:05.28,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:11:05.95,0:11:06.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:08.75,0:11:10.92,Default,,0,0,0,,-(Офицер) Уау! -(Хайбара) Ой!
Dialogue: 0,0:11:11.50,0:11:12.54,Default,,0,0,0,,- (Барлығы) Уф... - Хайбара!
Dialogue: 0,0:11:12.63,0:11:13.46,Default,,0,0,0,,Әй, әке...
Dialogue: 0,0:11:14.67,0:11:15.80,Default,,0,0,0,,
Dialogue: 0,0:11:16.63,0:11:17.46,Default,,0,0,0,,Уф
Dialogue: 0,0:11:18.21,0:11:19.09,Default,,0,0,0,,Ha
Dialogue: 0,0:11:20.84,0:11:22.05,Default,,0,0,0,,Ағай! Хайбар!
Dialogue: 0,0:11:22.13,0:11:22.97,Default,,0,0,0,,Ағай, берік болыңыз, аға!
Dialogue: 0,0:11:22.97,0:11:24.14,Default,,0,0,0,,Ағай, берік болыңыз, аға!
Dialogue: 0,0:11:22.97,0:11:24.14,Default,,0,0,0,,Хайбара
Dialogue: 0,0:11:24.14,0:11:24.68,Default,,0,0,0,,Ағай, берік болыңыз, аға!
Dialogue: 0,0:11:24.76,0:11:27.56,Default,,0,0,0,,Менде бәрі жақсы, бірақ...
Dialogue: 0,0:11:27.64,0:11:29.35,Default,,0,0,0,,Ағай!
Dialogue: 0,0:11:29.43,0:11:30.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:30.77,0:11:33.02,Default,,0,0,0,,Ран-ничан! Жедел жәрдем шақырыңыз!
Dialogue: 0,0:11:33.10,0:11:34.56,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:11:35.90,0:11:36.73,Default,,0,0,0,,Ha
Dialogue: 0,0:11:40.07,0:11:40.90,Default,,0,0,0,,Ах
Dialogue: 0,0:11:40.99,0:11:41.95,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:11:42.03,0:11:43.91,Default,,0,0,0,,Ей! сәуле! сәуле!
Dialogue: 0,0:11:43.99,0:11:45.28,Default,,0,0,0,,Оны тез өшіріңіз!
Dialogue: 0,0:11:43.99,0:11:45.28,Default,,0,0,0,,(Жедел жәрдем сигналы)
Dialogue: 0,0:11:45.28,0:11:45.37,Default,,0,0,0,,(Жедел жәрдем сигналы)
Dialogue: 0,0:11:45.37,0:11:46.91,Default,,0,0,0,,(Жедел жәрдем сигналы)
Dialogue: 0,0:11:45.37,0:11:46.91,Default,,0,0,0,,Шүкір, мен жақындай алмаймын!
Dialogue: 0,0:11:52.71,0:11:55.17,Default,,0,0,0,,...
Dialogue: 0,0:11:55.25,0:11:57.42,Default,,0,0,0,,Мен доктор Агасада тұрамын.
Dialogue: 0,0:11:57.50,0:11:58.63,Default,,0,0,0,,Иә
Dialogue: 0,0:12:01.22,0:12:04.47,Default,,0,0,0,,...
Dialogue: 0,0:12:04.55,0:12:05.39,Default,,0,0,0,,Иә
Dialogue: 0,0:12:05.47,0:12:10.06,Default,,0,0,0,,...
Dialogue: 0,0:12:10.14,0:12:13.64,Default,,0,0,0,,...
Dialogue: 0,0:12:13.73,0:12:16.23,Default,,0,0,0,,Сізде сол кезде әңгіме болды ма?
Dialogue: 0,0:12:16.31,0:12:17.90,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:12:17.98,0:12:20.36,Default,,0,0,0,,«Алғаныңызға рахмет».
Dialogue: 0,0:12:20.44,0:12:23.90,Default,,0,0,0,,“ ”
Dialogue: 0,0:12:23.99,0:12:25.28,Default,,0,0,0,,Орыс тілінде айтты.
Dialogue: 0,0:12:25.36,0:12:25.91,Default,,0,0,0,,Маңызды ескерту...
Dialogue: 0,0:12:25.91,0:12:27.78,Default,,0,0,0,,Маңызды ескерту...
Dialogue: 0,0:12:25.91,0:12:27.78,Default,,0,0,0,,Керемет! Сіз орысша түсінесіз бе?
Dialogue: 0,0:12:27.78,0:12:27.87,Default,,0,0,0,,Керемет! Сіз орысша түсінесіз бе?
Dialogue: 0,0:12:27.87,0:12:28.41,Default,,0,0,0,,Керемет! Сіз орысша түсінесіз бе?
Dialogue: 0,0:12:27.87,0:12:28.41,Default,,0,0,0,,Ең болмағанда қара киінген ұйым
Dialogue: 0,0:12:28.41,0:12:28.49,Default,,0,0,0,,Ең болмағанда қара киінген ұйым
Dialogue: 0,0:12:28.49,0:12:29.74,Default,,0,0,0,,Ең болмағанда қара киінген ұйым
Dialogue: 0,0:12:28.49,0:12:29.74,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:12:29.83,0:12:32.54,Default,,0,0,0,,Олар Хайбарды көздеген сияқты емес.
Dialogue: 0,0:12:32.62,0:12:36.33,Default,,0,0,0,,Мен мұны кездейсоқ немесе табиғи құбылыс деп елестете алмаймын.
Dialogue: 0,0:12:36.42,0:12:38.04,Default,,0,0,0,,Қылмыс жәбірленушіге бағытталған болуы керек.
Dialogue: 0,0:12:38.13,0:12:41.55,Default,,0,0,0,,Менің ойымша, оның қолындағы планшеті жарылыс көзі болды.
Dialogue: 0,0:12:42.13,0:12:43.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:43.09,0:12:44.84,Default,,0,0,0,,Әй, сөмкеңнің қалтасында.
Dialogue: 0,0:12:44.93,0:12:46.05,Default,,0,0,0,,Ішінде бірдеңе бар.
Dialogue: 0,0:12:46.14,0:12:48.55,Default,,0,0,0,,Иә? Әрине
Dialogue: 0,0:12:48.64,0:12:50.97,Default,,0,0,0,,Визиткаға ұқсайды.
Dialogue: 0,0:12:51.06,0:12:52.56,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:12:53.14,0:12:55.27,Default,,0,0,0,,Мен оқиғаны толық естідім.
Dialogue: 0,0:12:55.35,0:12:57.27,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:12:57.35,0:12:59.11,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:12:59.19,0:13:00.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:00.11,0:13:01.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:01.73,0:13:03.28,Default,,0,0,0,,Сонымен... бұл
Dialogue: 0,0:13:04.20,0:13:05.78,Default,,0,0,0,,...
Dialogue: 0,0:13:05.86,0:13:08.45,Default,,0,0,0,,Бұрынғы Токио қалалық полиция департаментінің қылмыстық іздестіру бөлімі 1
Dialogue: 0,0:13:08.53,0:13:10.78,Default,,0,0,0,,Мәжбүрлі қылмыстар үшін үшінші бөлімдегі детектив
Dialogue: 0,0:13:10.87,0:13:15.54,Default,,0,0,0,,Үш жыл бұрын бір оқиғаға байланысты мені бірінші тергеу бөліміне ауыстырды.
Dialogue: 0,0:13:15.62,0:13:18.04,Default,,0,0,0,,Сериялық жарылыстарды тергеу
Dialogue: 0,0:13:18.13,0:13:22.05,Default,,0,0,0,,Қылмыскер жасаған бомба жарылып, ол қызметтік міндетін атқару кезінде қаза тапты.
Dialogue: 0,0:13:23.63,0:13:26.80,Default,,0,0,0,,Визит карточкасында жазылған мүшелік бірінші тергеу бөлімі болып табылады.
Dialogue: 0,0:13:26.88,0:13:30.80,Default,,0,0,0,,Менің ойымша, ол бірінші дивизионда бір апта ғана болды.
Dialogue: 0,0:13:30.89,0:13:34.56,Default,,0,0,0,,Жәбірленуші визит карточкасын қашан және қайдан алды?
Dialogue: 0,0:13:34.64,0:13:36.31,Default,,0,0,0,,Бұл шынымен де сіздің алдыңызда.
Dialogue: 0,0:13:36.39,0:13:38.06,Default,,0,0,0,,Полицияға наразылық білдіру?
Dialogue: 0,0:13:38.15,0:13:39.40,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:13:39.48,0:13:42.82,Default,,0,0,0,,...
Dialogue: 0,0:13:43.94,0:13:47.66,Default,,0,0,0,,Сондықтан жәбірленушінің кім екені белгісіз.
Dialogue: 0,0:13:47.74,0:13:51.70,Default,,0,0,0,,…
Dialogue: 0,0:13:51.78,0:13:55.58,Default,,0,0,0,,Сіз жәбірленушінің құлап кеткені туралы жазбаны көрмедіңіз бе?
Dialogue: 0,0:13:55.66,0:13:56.83,Default,,0,0,0,,Оның жану жолы
Dialogue: 0,0:13:56.91,0:14:00.08,Default,,0,0,0,,Жаднама да өрт кезінде жойылған болуы мүмкін.
Dialogue: 0,0:14:00.17,0:14:04.09,Default,,0,0,0,,Әзірге жалғыз анықтама осы визитка.
Dialogue: 0,0:14:04.17,0:14:07.17,Default,,0,0,0,,...
Dialogue: 0,0:14:07.26,0:14:09.43,Default,,0,0,0,,көремін. Чиба-кунның тағайындалуы...
Dialogue: 0,0:14:09.51,0:14:11.72,Default,,0,0,0,,Бұл Мацуда қызметтік міндетін орындау кезінде қайтыс болғаннан кейін болды.
Dialogue: 0,0:14:11.80,0:14:15.31,Default,,0,0,0,,Көзіңді жапсаң, Такаги-санға ұқсайтының рас.
Dialogue: 0,0:14:15.39,0:14:16.23,Default,,0,0,0,,О
Dialogue: 0,0:14:16.85,0:14:20.98,Default,,0,0,0,,Такаги-кун тінту кезінде бетперде киген кезде, ол Мацуда-санға ұқсайды.
Dialogue: 0,0:14:21.06,0:14:22.73,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:14:22.82,0:14:25.40,Default,,0,0,0,,Күнделікті сол кездегі есепті де алып келдім.
Dialogue: 0,0:14:25.48,0:14:29.49,Default,,0,0,0,,...
Dialogue: 0,0:14:29.57,0:14:31.49,Default,,0,0,0,,Сіз бірдеңе ойлап таба аласыз ба?
Dialogue: 0,0:14:31.57,0:14:32.58,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:32.66,0:14:36.91,Default,,0,0,0,,Егер мен визиткамды шетелдікке берсем, олар оны есте сақтайды деп ойлаймын...
Dialogue: 0,0:14:37.00,0:14:39.42,Default,,0,0,0,,Сұрақ қоюды басқа біреуге қалдырыңыз
Dialogue: 0,0:14:39.50,0:14:42.13,Default,,0,0,0,,Бір уақытта не болғанын есте сақтауға тырысыңыз.
Dialogue: 0,0:14:42.21,0:14:43.59,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:52.89,0:14:54.56,Default,,0,0,0,,Мен байқамадым деп ойладың ба?
Dialogue: 0,0:14:54.64,0:14:56.43,Default,,0,0,0,,Жақсы... жақсы...
Dialogue: 0,0:14:56.52,0:14:59.98,Default,,0,0,0,,...Менің ойымша, олар сіз туралы болғандықтан тыңдап отырды.
Dialogue: 0,0:15:00.06,0:15:00.89,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:15:00.98,0:15:02.19,Default,,0,0,0,,Кіріңіз
Dialogue: 0,0:15:03.27,0:15:08.03,Default,,0,0,0,,Мен мұндай ештеңе көрмесем де, онымен өткізген аптаның көп бөлігін әлі есімде сақтаймын.
Dialogue: 0,0:15:08.11,0:15:09.65,Default,,0,0,0,,Такаги-кунға айтпа.
Dialogue: 0,0:15:09.74,0:15:11.91,Default,,0,0,0,,Ол тамаша детектив еді, солай емес пе?
Dialogue: 0,0:15:11.99,0:15:13.37,Default,,0,0,0,,Детектив Мацуда
Dialogue: 0,0:15:13.45,0:15:17.41,Default,,0,0,0,,Иә, мінезі үлкен, аузы нашар.
Dialogue: 0,0:15:18.20,0:15:19.04,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:20.21,0:15:23.00,Default,,0,0,0,,Қарсы болмасаңыз, айта аласыз ба?
Dialogue: 0,0:15:23.08,0:15:24.13,Default,,0,0,0,,Детектив Мацуда туралы
Dialogue: 0,0:15:24.21,0:15:25.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:25.88,0:15:29.05,Default,,0,0,0,,Әңгімелескенде бірдеңе есіңе түсіп қалар, солай ма?
Dialogue: 0,0:15:30.26,0:15:31.43,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:32.34,0:15:33.55,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:34.35,0:15:36.60,Default,,0,0,0,,Бірінші тергеу бөліміне тағайындалды
Dialogue: 0,0:15:36.68,0:15:38.97,Default,,0,0,0,,3 жыл бұрын 1 қараша
Dialogue: 0,0:15:39.06,0:15:42.10,Default,,0,0,0,,Бұл Хэллоуиннен кейінгі күн болғандықтан есімде.
Dialogue: 0,0:15:42.19,0:15:45.23,Default,,0,0,0,,Бірақ мен кенеттен ауысқандықтан, визиткамды уақытында ала алмадым.
Dialogue: 0,0:15:46.23,0:15:48.98,Default,,0,0,0,,Мен оны 4 қараша күні таңертең бере алдым.
Dialogue: 0,0:15:49.07,0:15:51.36,Default,,0,0,0,,Бұл мерекеден кейін болғандықтан да есімде.
Dialogue: 0,0:15:51.45,0:15:54.91,Default,,0,0,0,,Детектив Мацуда 7 қарашада қызметтік міндетін атқару кезінде қайтыс болды.
Dialogue: 0,0:15:54.99,0:15:58.29,Default,,0,0,0,,Соңғы төрт күнде визиткамды тапсыруға мүмкіндік болды.
Dialogue: 0,0:15:58.37,0:16:00.70,Default,,0,0,0,,Бірақ мен 4-ші күні күні бойы жұмыс істеуге тура келді.
Dialogue: 0,0:16:00.79,0:16:04.83,Default,,0,0,0,,Жолсерік миссиясының 5-ші күні уақытша ұстау изоляторы мен уақытша ұстау изоляторы арасында барумен аяқталды.
Dialogue: 0,0:16:04.92,0:16:09.76,Default,,0,0,0,,7-ші күні мен сериялық бомбалаушыны ол қайтыс болғанға дейін қуып жүрдім...
Dialogue: 0,0:16:09.84,0:16:12.55,Default,,0,0,0,,...Бұл менің визиткамды тапсыруға мүмкіндігім болғанын білдіреді.
Dialogue: 0,0:16:12.63,0:16:15.05,Default,,0,0,0,,Иә, тек 6 қарашада
Dialogue: 0,0:16:15.68,0:16:19.81,Default,,0,0,0,,Бірақ сіз оны ауысымнан кейін біреуге берген болуыңыз мүмкін емес пе?
Dialogue: 0,0:16:19.89,0:16:23.64,Default,,0,0,0,,Менің бөліміме келгеніне бір апта болды жатақханаға қайтып келмеді.
Dialogue: 0,0:16:23.73,0:16:25.56,Default,,0,0,0,,Мен кеңседе қалдым.
Dialogue: 0,0:16:25.65,0:16:27.23,Default,,0,0,0,,Қазір бұл туралы ойлану
Dialogue: 0,0:16:27.31,0:16:30.07,Default,,0,0,0,,Менің ойымша, сіз сериялық бомбалау оқиғасын зерттеп жатырсыз.
Dialogue: 0,0:16:30.73,0:16:34.74,Default,,0,0,0,,Бірақ ерекше ештеңе болғаны есімде жоқ.
Dialogue: 0,0:16:34.82,0:16:36.41,Default,,0,0,0,,Қарақшыны ұстаңыз
Dialogue: 0,0:16:36.41,0:16:36.87,Default,,0,0,0,,Қарақшыны ұстаңыз
Dialogue: 0,0:16:36.41,0:16:36.87,Default,,0,0,0,,Иә
Dialogue: 0,0:16:36.87,0:16:36.95,Default,,0,0,0,,Иә
Dialogue: 0,0:16:36.95,0:16:37.41,Default,,0,0,0,,Иә
Dialogue: 0,0:16:36.95,0:16:37.41,Default,,0,0,0,,Сіз автобустың басқарудан шығып бара жатқанын тоқтаттыңыз.
Dialogue: 0,0:16:37.41,0:16:38.28,Default,,0,0,0,,Сіз автобусты басқарудан шығып қалған кезде тоқтаттыңыз.
Dialogue: 0,0:16:38.28,0:16:39.12,Default,,0,0,0,,Сіз автобусты басқара алмай тоқтадыңыз.
Dialogue: 0,0:16:38.28,0:16:39.12,Default,,0,0,0,,Е...
Dialogue: 0,0:16:39.20,0:16:41.29,Default,,0,0,0,,Сонымен қатар, тежегіш секіргіштер
Dialogue: 0,0:16:41.29,0:16:41.87,Default,,0,0,0,,Сонымен қатар, тежегіш секіргіштер
Dialogue: 0,0:16:41.29,0:16:41.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.87,0:16:41.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.95,0:16:42.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.95,0:16:42.45,Default,,0,0,0,,Таңертең солай болды ма деп ойлаймын.
Dialogue: 0,0:16:42.45,0:16:44.08,Default,,0,0,0,,Таңертең солай болды ма деп ойлаймын.
Dialogue: 0,0:16:44.16,0:16:45.21,Default,,0,0,0,,Аха…
Dialogue: 0,0:16:45.75,0:16:48.21,Default,,0,0,0,,Түстен кейін мен жауапты болған іс бойынша сұхбат алдым.
Dialogue: 0,0:16:48.29,0:16:51.46,Default,,0,0,0,,Әй, ертерек сендіру әдісі не болды?
Dialogue: 0,0:16:52.05,0:16:53.76,Default,,0,0,0,,Сізге көмектесе алғаныма қуаныштымын.
Dialogue: 0,0:16:53.84,0:16:56.18,Default,,0,0,0,,Кез келген сәтте есеңгіреп, секіремін бе деп ойлаймын.
Dialogue: 0,0:16:56.26,0:16:57.34,Default,,0,0,0,,Мен қорықтым.
Dialogue: 0,0:16:58.30,0:17:00.81,Default,,0,0,0,,Мені біраз тыңда
Dialogue: 0,0:17:01.35,0:17:03.23,Default,,0,0,0,,Электрондық пошта? Бұл тез
Dialogue: 0,0:17:03.31,0:17:06.35,Default,,0,0,0,,А, менің саусақ ұшым адамнан да епті.
Dialogue: 0,0:17:06.44,0:17:08.27,Default,,0,0,0,,Мүмкін ол ол шығар?
Dialogue: 0,0:17:08.36,0:17:10.69,Default,,0,0,0,,Жоқ, мен оны қарағымға жаздым.
Dialogue: 0,0:17:10.77,0:17:13.32,Default,,0,0,0,,Жіберсем де алмайтын ең жақын досыма
Dialogue: 0,0:17:13.40,0:17:15.24,Default,,0,0,0,,Иә? Сіз оны қабылдамайсыз ба?
Dialogue: 0,0:17:15.95,0:17:18.82,Default,,0,0,0,,Бұл төрт жыл бұрын желге ұшып кеткен.
Dialogue: 0,0:17:18.91,0:17:20.33,Default,,0,0,0,,Не? (Сымсыз қабылдау дыбысы)
Dialogue: 0,0:17:20.41,0:17:23.04,Default,,0,0,0,,Бейкачо 3-чомеде кісі өлтіру оқиғасы болды
Dialogue: 0,0:17:23.12,0:17:25.08,Default,,0,0,0,,Қылмыскер мотоциклмен қашып барады
Dialogue: 0,0:17:25.16,0:17:27.25,Default,,0,0,0,,Түсінген бақылау
Dialogue: 0,0:17:28.08,0:17:31.50,Default,,0,0,0,,Бұл қала қалыпты емес.
Dialogue: 0,0:17:32.09,0:17:35.05,Default,,0,0,0,,Іс шамамен сағат 15.00-ге дейін қаралды.
Dialogue: 0,0:17:35.13,0:17:37.43,Default,,0,0,0,,Осыдан кейін мен Сакурадамонға оралдым.
Dialogue: 0,0:17:37.51,0:17:41.14,Default,,0,0,0,,Эй, тыңда, сен детектив Мацудамен емтихан тапсырдың ба?
Dialogue: 0,0:17:41.22,0:17:43.31,Default,,0,0,0,,Жоқ, бөлек. Ах...
Dialogue: 0,0:17:45.39,0:17:46.98,Default,,0,0,0,,Сізді күтуге мәжбүрлегенім үшін кешіріңіз.
Dialogue: 0,0:17:47.06,0:17:50.31,Default,,0,0,0,,Сіз қайда болдыңыз? Сағат 6-дан асып кетті.
Dialogue: 0,0:17:50.40,0:17:51.69,Default,,0,0,0,,Аздап
Dialogue: 0,0:17:52.98,0:17:54.44,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:54.53,0:17:55.82,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:55.90,0:17:57.32,Default,,0,0,0,,Жаңа есіме түсті
Dialogue: 0,0:17:57.40,0:18:00.07,Default,,0,0,0,,Мацуда-кун, сенің қалтаңда тәспі бар еді.
Dialogue: 0,0:18:00.16,0:18:01.49,Default,,0,0,0,,Намаз моншақтары?
Dialogue: 0,0:18:01.58,0:18:05.50,Default,,0,0,0,,Әй, бұрын детектив Мацуда хат жазысқан адам...
Dialogue: 0,0:18:05.58,0:18:08.96,Default,,0,0,0,,Мүмкін ол өзімен бір уақытта жарылғыш заттарды залалсыздандыру отрядының мүшесі болған шығар.
Dialogue: 0,0:18:09.83,0:18:11.54,Default,,0,0,0,,Кенджи Хагивара
Dialogue: 0,0:18:11.63,0:18:13.00,Default,,0,0,0,,Жеті жыл бұрын
Dialogue: 0,0:18:13.09,0:18:15.34,Default,,0,0,0,,Ол қызметтік міндетін атқару кезінде бомбаны залалсыздандыру кезінде қаза тапқанға ұқсайды.
Dialogue: 0,0:18:15.42,0:18:16.72,Default,,0,0,0,,Адамның қайтыс болған күні неше жыл?
Dialogue: 0,0:18:17.63,0:18:20.14,Default,,0,0,0,,Сол жігітпен бір күн, 7 қараша!
Dialogue: 0,0:18:20.22,0:18:24.31,Default,,0,0,0,,Оның өлімінің 7-ші күні сериялық бомбалаушы маған хабарласқан күні болды.
Dialogue: 0,0:18:24.39,0:18:28.64,Default,,0,0,0,,Детектив Мацуда сол хабарламаны алғанша бас кеңседе болды, солай ма?
Dialogue: 0,0:18:28.73,0:18:31.10,Default,,0,0,0,,Яғни, сол күні бейітке баруға болмайды.
Dialogue: 0,0:18:31.90,0:18:33.98,Default,,0,0,0,,Сол үшін 6-ға барған жоқсың ба?
Dialogue: 0,0:18:34.07,0:18:37.99,Default,,0,0,0,,Хагивара мырзаның моласы Шибуяның дәл қасындағы ғибадатхана болса керек.
Dialogue: 0,0:18:39.74,0:18:41.70,Default,,0,0,0,,Уа, не болды? Сато мырза
Dialogue: 0,0:18:41.78,0:18:43.24,Default,,0,0,0,,Әй, мұны істеңіз!
Dialogue: 0,0:18:43.33,0:18:45.49,Default,,0,0,0,,- (Такаги) Жарайды... күте тұрыңыз! - (Чиба) А, Такаги-сан!
Dialogue: 0,0:18:45.58,0:18:48.50,Default,,0,0,0,,Сұхбат сағат 15.00-де аяқталды.
Dialogue: 0,0:18:49.04,0:18:52.71,Default,,0,0,0,,Тіпті мен Шибуядағы ғибадатханаға сыныптастарымның бейіттерін зиярат етуге барсам да.
Dialogue: 0,0:18:52.79,0:18:54.88,Default,,0,0,0,,Үйге кешкі 6-дан кейін кім келеді?
Dialogue: 0,0:18:54.96,0:18:57.92,Default,,0,0,0,,Қанша уақыт кетсе де
Dialogue: 0,0:18:58.01,0:19:00.51,Default,,0,0,0,,Осы үш сағатта не болды...
Dialogue: 0,0:19:00.59,0:19:02.68,Default,,0,0,0,,Сен мұнда не үшін келдің? Конан-кун
Dialogue: 0,0:19:02.76,0:19:04.89,Default,,0,0,0,,Ачача... Әй?
Dialogue: 0,0:19:05.60,0:19:06.89,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:19:06.97,0:19:10.14,Default,,0,0,0,,Менің есімде олар өте жақсы.
Dialogue: 0,0:19:10.23,0:19:13.11,Default,,0,0,0,,Осыдан бірнеше жыл бұрын осында төртеуіміз келдік.
Dialogue: 0,0:19:13.19,0:19:14.02,Default,,0,0,0,,Төрт адам?
Dialogue: 0,0:19:14.11,0:19:18.40,Default,,0,0,0,,Барлығы Хагивара-санның сыныптастары екенін айтты.
Dialogue: 0,0:19:18.49,0:19:21.49,Default,,0,0,0,,Үш жыл бұрын келгеніңіз есіңізде ме?
Dialogue: 0,0:19:21.57,0:19:22.78,Default,,0,0,0,,Сіз сағат нешеде келдіңіз?
Dialogue: 0,0:19:22.87,0:19:26.54,Default,,0,0,0,,Менің ойымша, жыл сайын күндізгі сағат 3-тер шамасында болатын.
Dialogue: 0,0:19:26.62,0:19:31.08,Default,,0,0,0,,Алайда, неге екені белгісіз, соңғы кездері қасиетті орынға келушілер саны азайып барады.
Dialogue: 0,0:19:31.17,0:19:34.88,Default,,0,0,0,,Өткен жылы мен жалғыз болдым... Мен сондай жалғызбын.
Dialogue: 0,0:19:34.96,0:19:37.96,Default,,0,0,0,,Сіз соңғысының атын білесіз бе?
Dialogue: 0,0:19:38.05,0:19:39.63,Default,,0,0,0,,Менің ойымша, аты...
Dialogue: 0,0:19:39.72,0:19:44.01,Default,,0,0,0,,Иә, бұл Фуруя мырза еді деп ойлаймын.
Dialogue: 0,0:19:49.93,0:19:50.93,Default,,0,0,0,,Ах
Dialogue: 0,0:19:51.02,0:19:52.02,Default,,0,0,0,,Иә? Ооо
Dialogue: 0,0:19:52.10,0:19:54.52,Default,,0,0,0,,Фуруя Рэй…
Dialogue: 0,0:19:58.48,0:20:00.90,Default,,0,0,0,,Қанша қарасаң да осындай.
Dialogue: 0,0:20:00.99,0:20:03.82,Default,,0,0,0,,Сіз шынымен де сондасыз ба? Фуруя деген жігіт
Dialogue: 0,0:20:03.91,0:20:06.03,Default,,0,0,0,,Мацуда-кунның сыныптасы болған адам.
Dialogue: 0,0:20:06.12,0:20:09.66,Default,,0,0,0,,Сіз полиция қызметінен кеткен болсаңыз да, деректеріңіз сонда болуы керек.
Dialogue: 0,0:20:09.75,0:20:12.25,Default,,0,0,0,,Сержант Такаги лейтенант Сатоға
Dialogue: 0,0:20:12.33,0:20:13.33,Default,,0,0,0,,Иә? Эх...
Dialogue: 0,0:20:13.42,0:20:14.83,Default,,0,0,0,,Сіз сенімдісіз бе...
Dialogue: 0,0:20:14.92,0:20:18.96,Default,,0,0,0,,Бұл Токио қалалық полиция департаментінің қоғамдық қауіпсіздік бөлімінің қызметкері Казами. Сіз мұны қалайсыз ба деп сұрай аламын ба?
Dialogue: 0,0:20:21.13,0:20:22.97,Default,,0,0,0,,Тергеуді тоқтатуымыз керек пе?
Dialogue: 0,0:20:23.05,0:20:26.22,Default,,0,0,0,,Бұл іспен біздің қоғамдық қауіпсіздік департаменті айналысады.
Dialogue: 0,0:20:26.30,0:20:29.22,Default,,0,0,0,,Ақылсыз сөз айтпа! бұл біздің яма
Dialogue: 0,0:20:29.31,0:20:32.48,Default,,0,0,0,,Сізге ұнайтын нәрсені айтуға құқығыңыз жоқ.
Dialogue: 0,0:20:32.56,0:20:34.85,Default,,0,0,0,,Бұл сұрау емес, бұйрық.
Dialogue: 0,0:20:36.56,0:20:37.81,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,0:20:37.90,0:20:38.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:42.90,0:20:44.36,Default,,0,0,0,,Мен қалжыңдамаймын!
Dialogue: 0,0:20:44.45,0:20:46.95,Default,,0,0,0,,Мен мұндай озбырлықты қабылдай алмаймын!
Dialogue: 0,0:20:47.03,0:20:49.03,Default,,0,0,0,,Жарайды, назар аударыңыздар
Dialogue: 0,0:20:49.12,0:20:52.12,Default,,0,0,0,,Бұл көңілсіз, бірақ біз бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:20:52.20,0:20:54.87,Default,,0,0,0,,Мен сабырлымын, оғаш ештеңе айтпа!
Dialogue: 0,0:20:54.96,0:20:56.38,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:57.00,0:20:58.21,Default,,0,0,0,,Жоғарыда айтылғандармен аздап әрекеттеседі.
Dialogue: 0,0:20:58.29,0:21:00.50,Default,,0,0,0,,Аа, Сато мырза!
Dialogue: 0,0:21:02.13,0:21:03.01,Default,,0,0,0,,Я...
Dialogue: 0,0:21:03.09,0:21:05.51,Default,,0,0,0,,Оның сонша ыстық болуының себебі...
Dialogue: 0,0:21:05.59,0:21:07.43,Default,,0,0,0,,Өйткені бұл іске Мацуда мырза қатысты
Dialogue: 0,0:21:07.51,0:21:09.01,Default,,0,0,0,,Ол сабырлы емес
Dialogue: 0,0:21:09.10,0:21:10.06,Default,,0,0,0,,Ширатори мырза
Dialogue: 0,0:21:10.97,0:21:13.43,Default,,0,0,0,,...Сенің түрің сондай.
Dialogue: 0,0:21:13.52,0:21:15.52,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:21:16.02,0:21:18.94,Default,,0,0,0,,Мацуда мырзаның визиткасына қарап, Сато мырза
Dialogue: 0,0:21:19.02,0:21:21.07,Default,,0,0,0,,Мен айналамдағыны көре алмайтындай сезінемін
Dialogue: 0,0:21:22.90,0:21:25.20,Default,,0,0,0,,Ширатори мырза, мен мұны бұрын да айтқанмын.
Dialogue: 0,0:21:25.28,0:21:28.45,Default,,0,0,0,,Ол детектив Мацуданы сүйреп апарғанша.
Dialogue: 0,0:21:28.53,0:21:30.41,Default,,0,0,0,,Олар біздің жеңу мүмкіндігіміз жоқ дейді.
Dialogue: 0,0:21:30.49,0:21:33.08,Default,,0,0,0,,Ах, бірақ бұл қате болды.
Dialogue: 0,0:21:33.16,0:21:34.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:34.41,0:21:37.87,Default,,0,0,0,,Жеңіске жетуге мүмкіндігім жоқ жалғыз мен болдым, солай ма?
Dialogue: 0,0:21:37.96,0:21:39.63,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:21:39.71,0:21:43.17,Default,,0,0,0,,Бірақ бұл мен үшін әлі де жақсы емес.
Dialogue: 0,0:21:43.26,0:21:45.92,Default,,0,0,0,,Бірақ сіз де ұзақ жолдан өттіңіз.
Dialogue: 0,0:21:46.01,0:21:47.76,Default,,0,0,0,,Шу… жарнамасы?
Dialogue: 0,0:21:47.84,0:21:51.72,Default,,0,0,0,,Өз өмірін қатерге тігіп, талай адамның өмірін сақтап қалған аты аңызға айналған детектив.
Dialogue: 0,0:21:51.81,0:21:53.18,Default,,0,0,0,,Себебі мен қызғанамын
Dialogue: 0,0:21:53.27,0:21:55.02,Default,,0,0,0,,Жоқ, мен қызғанбаймын...
Dialogue: 0,0:21:55.10,0:21:57.60,Default,,0,0,0,,Детектив Мацуданың бұған еш қатысы жоқ.
Dialogue: 0,0:21:57.69,0:22:00.77,Default,,0,0,0,,Егер іс ұрланған болса, оны қайтарып алуға болады.
Dialogue: 0,0:22:01.57,0:22:04.90,Default,,0,0,0,,Егер сіз асықпасаңыз, Сато-сан, сіз қоғамдық қауіпсіздікке өзіңіз шығасыз.
Dialogue: 0,0:22:04.99,0:22:08.95,Default,,0,0,0,,Ах... Кешіріңіз... Сізге көп рахмет!
Dialogue: 0,0:22:10.28,0:22:12.12,Default,,0,0,0,,Ал, сіздің махаббат жолыңыз
Dialogue: 0,0:22:12.20,0:22:12.95,Default,,0,0,0,,Мен көп қиындыққа тап болдым. Мен өзімді кінәлі сезінемін.
Dialogue: 0,0:22:12.95,0:22:15.08,Default,,0,0,0,,Мен көп қиындыққа тап болдым. Мен өзімді кінәлі сезінемін.
Dialogue: 0,0:22:12.95,0:22:15.08,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:22:15.08,0:22:16.62,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:22:16.71,0:22:18.58,Default,,0,0,0,,Әй, Кобаяши мырза!
Dialogue: 0,0:22:20.67,0:22:24.84,Default,,0,0,0,,Сүйегі сынбады, бірақ басымды қатты соққандай болдым.
Dialogue: 0,0:22:24.92,0:22:29.22,Default,,0,0,0,,Ертең мені басқа ауруханаға ауыстырып, егжей-тегжейлі тексеруден өтемін.
Dialogue: 0,0:22:29.30,0:22:30.64,Default,,0,0,0,,Ағай...
Dialogue: 0,0:22:30.72,0:22:31.97,Default,,0,0,0,,Ах
Dialogue: 0,0:22:32.05,0:22:33.64,Default,,0,0,0,,Иә
Dialogue: 0,0:22:34.89,0:22:37.18,Default,,0,0,0,,А, сен қайсысысың?
Dialogue: 0,0:22:37.27,0:22:39.31,Default,,0,0,0,,Менің атым Цутому Муранака.
Dialogue: 0,0:22:39.39,0:22:40.77,Default,,0,0,0,,Бұл менің күйеуімнің...
Dialogue: 0,0:22:40.85,0:22:42.73,Default,,0,0,0,,Мен Кристин Ричардпын.
Dialogue: 0,0:22:43.32,0:22:46.03,Default,,0,0,0,,Муранака мырзаға, Кристин мырзаға...
Dialogue: 0,0:22:46.11,0:22:48.07,Default,,0,0,0,,Ах, кешегі тренинг!
Dialogue: 0,0:22:48.15,0:22:48.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:51.36,0:22:52.74,Default,,0,0,0,,Мегур осындай нәрсе жасады...
Dialogue: 0,0:22:53.45,0:22:56.87,Default,,0,0,0,,Сізге келтірілген ыңғайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:22:56.95,0:22:59.00,Default,,0,0,0,,А, жоқ, бұл туралы алаңдамаңыз.
Dialogue: 0,0:22:59.08,0:23:01.71,Default,,0,0,0,,Мен сәл таң қалдым.
Dialogue: 0,0:23:01.79,0:23:03.50,Default,,0,0,0,,Мен де кешірім сұраймын.
Dialogue: 0,0:23:03.59,0:23:05.30,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:23:05.38,0:23:07.67,Default,,0,0,0,,Аа, сен жапон тілін жақсы білесің.
Dialogue: 0,0:23:07.76,0:23:10.05,Default,,0,0,0,,Менің ата-анам да француз.
Dialogue: 0,0:23:10.13,0:23:13.14,Default,,0,0,0,,Мен 20 жасымнан бастап Жапонияда тұрамын.
Dialogue: 0,0:23:13.22,0:23:15.76,Default,,0,0,0,,Мен оны ауруханада кездестірдім.
Dialogue: 0,0:23:15.85,0:23:18.18,Default,,0,0,0,,Иық жарақатымен ауруханаға түскенімде
Dialogue: 0,0:23:18.27,0:23:20.89,Default,,0,0,0,,Медициналық картамды жоғалтып алып, қиындыққа тап болсам ше?
Dialogue: 0,0:23:20.98,0:23:22.94,Default,,0,0,0,,Ол маған тапты.
Dialogue: 0,0:23:23.02,0:23:25.77,Default,,0,0,0,,Әй, бұл тағдырлы кездесу болды.
Dialogue: 0,0:23:25.86,0:23:28.19,Default,,0,0,0,,Міне, солай деп ойлаймын.
Dialogue: 0,0:23:28.28,0:23:30.82,Default,,0,0,0,,Бүгін мұнда не үшін келдің?
Dialogue: 0,0:23:30.90,0:23:35.33,Default,,0,0,0,,Негізінде мен детектив Мориден қабылдауда сөз сөйлеуін өтіндім.
Dialogue: 0,0:23:35.41,0:23:38.62,Default,,0,0,0,,Менің қызым да, мен де Немури но Когороның жанкүйерлеріміз.
Dialogue: 0,0:23:38.70,0:23:40.21,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:23:40.29,0:23:43.96,Default,,0,0,0,,Мен сізді детектив Мориді нысанаға алғаныңызды мүлдем кешіре алмаймын.
Dialogue: 0,0:23:44.04,0:23:47.59,Default,,0,0,0,,А, жоқ, менің әкем нысанаға алынған жоқ.
Dialogue: 0,0:23:47.67,0:23:50.59,Default,,0,0,0,,Баланы бомба жарылуынан қорғауға тырысу...
Dialogue: 0,0:23:50.67,0:23:51.97,Default,,0,0,0,,Не...
Dialogue: 0,0:23:52.05,0:23:55.05,Default,,0,0,0,,Бала жәбірленушінің жоғалған затын байқап, оны алады.
Dialogue: 0,0:23:55.14,0:23:57.97,Default,,0,0,0,,Мен оны берейін десем, жалынға оранды.
Dialogue: 0,0:23:58.06,0:24:00.18,Default,,0,0,0,,Әкем көмектесуге тырысты...
Dialogue: 0,0:24:00.27,0:24:03.85,Default,,0,0,0,,Сонымен, Когоро ұйықтап жатқанда баланы құтқарған батыр болды.
Dialogue: 0,0:24:03.94,0:24:05.61,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:24:05.69,0:24:08.57,Default,,0,0,0,,Қиын сәтте саған араласқаным үшін кешірім сұраймын.
Dialogue: 0,0:24:08.65,0:24:11.70,Default,,0,0,0,,Оянған кезде детектив Мориге де сәлем айтыңыз.
Dialogue: 0,0:24:11.78,0:24:12.61,Default,,0,0,0,,Иә
Dialogue: 0,0:24:14.20,0:24:15.37,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:24:15.45,0:24:18.87,Default,,0,0,0,,Қазір ойлап қарасам, біз салтанатты рәсімді өткізген жеріміз өте жақсы болды.
Dialogue: 0,0:24:18.95,0:24:19.91,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:24:20.00,0:24:22.87,Default,,0,0,0,,Мен Шибуя қаласын түгел көріп, бір көргеннен шешім қабылдадым.
Dialogue: 0,0:24:22.96,0:24:25.92,Default,,0,0,0,,А... кеше ауа райы нашар болды...
Dialogue: 0,0:24:26.00,0:24:28.63,Default,,0,0,0,,Бұл тұман болды, сіз анық көре алмадыңыз.
Dialogue: 0,0:24:28.71,0:24:29.84,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:24:29.92,0:24:32.80,Default,,0,0,0,,Олай болса, ертең бәріңіз келіп көргіңіз келе ме?
Dialogue: 0,0:24:32.88,0:24:35.51,Default,,0,0,0,,Эй, детектив Мори, осындай уақытта...
Dialogue: 0,0:24:35.59,0:24:38.93,Default,,0,0,0,,Уау, Хэллоуиннің әшекейлері өте керемет.
Dialogue: 0,0:24:39.01,0:24:41.10,Default,,0,0,0,,Көре алмағаныма өкінемін.
Dialogue: 0,0:24:41.18,0:24:42.27,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:24:42.35,0:24:45.40,Default,,0,0,0,,Олай десеңіз...
Dialogue: 0,0:24:45.48,0:24:47.69,Default,,0,0,0,,- (Жүгіріп) Рахмет - Ахаха...
Dialogue: 0,0:24:49.27,0:24:51.40,Default,,0,0,0,,Сіз, Басшының орынбасары, қазір тергеу штабында қанша адам қалғанын білесіз ғой.
Dialogue: 0,0:24:54.32,0:24:55.86,Default,,0,0,0,,Әкем айтты
Dialogue: 0,0:24:55.95,0:24:58.70,Default,,0,0,0,,Муранака мырза бұрын өте қатал адам болған.
Dialogue: 0,0:24:58.78,0:25:01.70,Default,,0,0,0,,Олардан «жын ауылының тұрғындары» деп қорқатын болса керек.
Dialogue: 0,0:25:01.79,0:25:03.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:25:03.16,0:25:06.21,Default,,0,0,0,,Мен оны қазіргі Мұранака мырзадан елестете алмаймын.
Dialogue: 0,0:25:06.29,0:25:09.59,Default,,0,0,0,,Кристиннің арқасында мейірімді болғаныңызға сенімдімін.
Dialogue: 0,0:25:10.75,0:25:14.59,Default,,0,0,0,,Аа, бұл өте ұзақ. Тезірек үйге баруымыз керек пе?
Dialogue: 0,0:25:15.93,0:25:19.85,Default,,0,0,0,,Ран-ничан, мен доктор Агасамен бірге боламын.
Dialogue: 0,0:25:19.93,0:25:21.97,Default,,0,0,0,,Бүгін ағаңның қасында бол.
Dialogue: 0,0:25:22.06,0:25:23.43,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:25:23.52,0:25:25.60,Default,,0,0,0,,Мен өзім жақсымын.
Dialogue: 0,0:25:26.60,0:25:29.36,Default,,0,0,0,,Рахмет, онда сақ болыңыз.
Dialogue: 0,0:25:29.44,0:25:30.65,Default,,0,0,0,,Иә
Dialogue: 0,0:25:37.57,0:25:40.49,Default,,0,0,0,,Сіз сондасыз ба? Менен бірдеңе керек пе?
Dialogue: 0,0:25:40.58,0:25:42.91,Default,,0,0,0,,Ух... мм...
Dialogue: 0,0:25:47.00,0:25:48.29,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:25:48.38,0:25:49.42,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:25:54.92,0:25:57.01,Default,,0,0,0,,Мен... мен де көмектесемін.
Dialogue: 0,0:25:57.09,0:25:58.84,Default,,0,0,0,,Өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:25:58.93,0:26:00.85,Default,,0,0,0,,Мен өзімді мәжбүрлеп жатқан жоқпын.
Dialogue: 0,0:26:05.18,0:26:06.94,Default,,0,0,0,,- (Сато) Өлім құдайы - (Такаги) Иә?
Dialogue: 0,0:26:07.52,0:26:09.69,Default,,0,0,0,,Сол сериялы бомбалау оқиғасы сияқты
Dialogue: 0,0:26:09.77,0:26:12.69,Default,,0,0,0,,Соңғы уақытта өлім құдайы жыпылықтай бастады...
Dialogue: 0,0:26:12.77,0:26:16.53,Default,,0,0,0,,Сонымен, сіз айтқандай, қызып кеткен шығар.
Dialogue: 0,0:26:16.61,0:26:17.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:26:17.78,0:26:18.70,Default,,0,0,0,,Сато мырза...
Dialogue: 0,0:26:18.78,0:26:22.99,Default,,0,0,0,,Егер сіз осылай сезінетін болсаңыз, детектив ретінде жұмысыңызды тастаңыз.
Dialogue: 0,0:26:23.08,0:26:25.16,Default,,0,0,0,,Мен Такаги-кунның әйелі болуым керек пе?
Dialogue: 0,0:26:25.25,0:26:26.50,Default,,0,0,0,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,0:26:27.00,0:26:29.04,Default,,0,0,0,,Өтінемін, мұндай қайғылы сөздерді айтпа.
Dialogue: 0,0:26:29.12,0:26:29.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:30.04,0:26:33.46,Default,,0,0,0,,Детектив істі тоқтатып, жұмыстан кетемін десе ше?
Dialogue: 0,0:26:33.55,0:26:34.88,Default,,0,0,0,,Бұл шығын емес пе?
Dialogue: 0,0:26:34.96,0:26:35.96,Default,,0,0,0,,Такаги-кун…
Dialogue: 0,0:26:36.05,0:26:39.72,Default,,0,0,0,,Мен Сато мырзаның жеңілгенін көргім келмейді.
Dialogue: 0,0:26:39.80,0:26:40.89,Default,,0,0,0,,Мен сені жақсы көремін...
Dialogue: 0,0:26:41.64,0:26:43.31,Default,,0,0,0,,Менің аңсағаным
Dialogue: 0,0:26:44.06,0:26:46.98,Default,,0,0,0,,Ол Мивако Сато, детектив!
Dialogue: 0,0:26:47.06,0:26:48.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:48.69,0:26:52.98,Default,,0,0,0,,Дұрыс, Ватару.
Dialogue: 0,0:26:53.06,0:26:54.07,Default,,0,0,0,,А, бірақ бұл басқа әңгіме.
Dialogue: 0,0:26:54.07,0:26:56.65,Default,,0,0,0,,А, бірақ бұл басқа әңгіме.
Dialogue: 0,0:26:54.07,0:26:56.65,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:26:56.65,0:26:56.74,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:26:56.74,0:26:57.69,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:26:56.74,0:26:57.69,Default,,0,0,0,,Сонымен… бұл…
Dialogue: 0,0:26:57.69,0:26:59.24,Default,,0,0,0,,Сонымен… бұл…
Dialogue: 0,0:26:59.32,0:27:01.36,Default,,0,0,0,,Сен менің әйелім боласың...
Dialogue: 0,0:27:01.45,0:27:03.12,Default,,0,0,0,,…Ондай нәрсе жоқ!
Dialogue: 0,0:27:06.12,0:27:08.87,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:27:11.63,0:27:12.63,Default,,0,0,0,,Түсіңіз.
Dialogue: 0,0:27:32.94,0:27:37.86,Default,,0,0,0,,(кеңейтім рингтоны)
Dialogue: 0,0:27:37.94,0:27:38.99,Default,,0,0,0,,Иә
Dialogue: 0,0:27:39.07,0:27:43.11,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:27:44.12,0:27:47.24,Default,,0,0,0,,Мені осында әкелу дегеніңіз не?
Dialogue: 0,0:27:47.33,0:27:48.95,Default,,0,0,0,,Амуро мырза
Dialogue: 0,0:27:50.41,0:27:52.25,Default,,0,0,0,,Менің ойымша, сіз мұны бәрібір білетін шығарсыз.
Dialogue: 0,0:27:52.33,0:27:55.71,Default,,0,0,0,,Елордалық полиция департаментінің алдында шетелдіктің өртеніп кеткен өлімін тергеу
Dialogue: 0,0:27:55.79,0:27:58.46,Default,,0,0,0,,Мен оны тоқтатты деп естідім.
Dialogue: 0,0:27:58.55,0:28:02.80,Default,,0,0,0,,Не үлкен күшке ие біреу осындай нәрсені істей алар еді, немесе...
Dialogue: 0,0:28:02.88,0:28:04.18,Default,,0,0,0,,Қоғамдық қауіпсіздік
Dialogue: 0,0:28:04.84,0:28:09.06,Default,,0,0,0,,Бұл іске қызметтік міндетін атқару кезінде қаза тапқан детектив Мацуда қатысты.
Dialogue: 0,0:28:09.14,0:28:12.31,Default,,0,0,0,,Сіз оның полиция академиясында курстасы болдыңыз.
Dialogue: 0,0:28:12.39,0:28:17.07,Default,,0,0,0,,Сонымен қатар, бірінші тергеу бөлімінің детективтері Сато мен Такаги бұл мәселе бойынша әрекет ете бастады.
Dialogue: 0,0:28:17.15,0:28:20.24,Default,,0,0,0,,Жағдайды ойласаңыз, жауап көп ұзамай келеді.
Dialogue: 0,0:28:20.32,0:28:23.45,Default,,0,0,0,,Осы уақытқа дейін оқығаннан кейін мен әдейі жалғыз қалдым.
Dialogue: 0,0:28:23.53,0:28:26.49,Default,,0,0,0,,Біздің ұсталуымызға мүмкіндік туғызды.
Dialogue: 0,0:28:27.83,0:28:30.75,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:28:30.83,0:28:32.21,Default,,0,0,0,,Иә
Dialogue: 0,0:28:32.29,0:28:35.00,Default,,0,0,0,,Одан басқа бұл қандай нысан?
Dialogue: 0,0:28:35.08,0:28:38.04,Default,,0,0,0,,Қоғамдық қауіпсіздікке тиесілі жерасты баспанасы
Dialogue: 0,0:28:38.13,0:28:41.51,Default,,0,0,0,,Сен екеумізді бөліп тұрған шыны - ерекше шыңдалған шыны.
Dialogue: 0,0:28:41.59,0:28:43.26,Default,,0,0,0,,Сондай-ақ радиотолқындарды блоктайды
Dialogue: 0,0:28:43.34,0:28:46.64,Default,,0,0,0,,Бұл жерде үлкен жарылыс болса да, сіз зиянсыз боласыз.
Dialogue: 0,0:28:47.30,0:28:49.89,Default,,0,0,0,,Мұны жер бетінде ешкім байқамайды.
Dialogue: 0,0:28:49.97,0:28:52.43,Default,,0,0,0,,Әлгі жаға тәрізді нәрсе...
Dialogue: 0,0:28:52.52,0:28:54.56,Default,,0,0,0,,Иә, бұл бомба.
Dialogue: 0,0:28:54.64,0:28:57.44,Default,,0,0,0,,Оның уақыты белгіленген түрі немесе сымсыз түрі екені белгісіз.
Dialogue: 0,0:28:57.52,0:28:59.44,Default,,0,0,0,,Мен оны қалай бөлшектеу керектігін де білмеймін.
Dialogue: 0,0:28:59.52,0:29:02.15,Default,,0,0,0,,Кешіріңіз, бірақ кешіріңіз.
Dialogue: 0,0:29:02.24,0:29:06.66,Default,,0,0,0,,Бірінші тергеу бөлімінің детективтері менімен кездескісі келетінін білемін.
Dialogue: 0,0:29:06.74,0:29:09.74,Default,,0,0,0,,Бірақ біз бұлай кездесе алмаймыз, солай ма?
Dialogue: 0,0:29:09.83,0:29:10.74,Default,,0,0,0,,Және...
Dialogue: 0,0:29:10.83,0:29:14.66,Default,,0,0,0,,Оларға бетіңді жоғалтсаң, жасырын тергеу ісі бұзылады.
Dialogue: 0,0:29:14.75,0:29:18.17,Default,,0,0,0,,Пуаро да толық емес жұмыс күнін тастауға мәжбүр болады.
Dialogue: 0,0:29:18.75,0:29:20.75,Default,,0,0,0,,Сол үшін мені шақырдыңыз
Dialogue: 0,0:29:20.84,0:29:23.72,Default,,0,0,0,,Мен білетін барлық ақпаратты айтып беремін.
Dialogue: 0,0:29:23.80,0:29:26.43,Default,,0,0,0,,Сондықтан бірінші бөлімнің тергеуімен ынтымақтасуларыңызды қалаймын.
Dialogue: 0,0:29:26.51,0:29:29.18,Default,,0,0,0,,...3 жыл бұрын 6 қарашада
Dialogue: 0,0:29:29.26,0:29:32.35,Default,,0,0,0,,Амуро мырза детектив Мацуданы кездестірді, солай ма?
Dialogue: 0,0:29:32.43,0:29:34.06,Default,,0,0,0,,А, мен сені кездестірдім.
Dialogue: 0,0:29:34.14,0:29:36.94,Default,,0,0,0,,4 адаммен бірге болғанымызға біраз болды.
Dialogue: 0,0:29:46.15,0:29:47.53,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:29:47.61,0:29:48.99,Default,,0,0,0,,Сіз кешіктіңіз.
Dialogue: 0,0:29:49.07,0:29:50.91,Default,,0,0,0,,Мен сені келмейді деп ойладым.
Dialogue: 0,0:29:50.99,0:29:51.95,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:29:52.04,0:29:53.08,Default,,0,0,0,,жаман жаман
Dialogue: 0,0:29:53.16,0:29:55.83,Default,,0,0,0,,Оқиға Оқиғаға байланысты қашып құтыла алмаймын.
Dialogue: 0,0:29:55.91,0:29:59.63,Default,,0,0,0,,Мен сіздің Соичиге көшкеніңізді естідім. Өзіңізді қалай сезінесіз?
Dialogue: 0,0:29:59.71,0:30:01.34,Default,,0,0,0,,Сонымен.
Dialogue: 0,0:30:01.42,0:30:04.71,Default,,0,0,0,,Мен де келесі айдан бастап қалалық полиция департаментіне тағайындалдым.
Dialogue: 0,0:30:04.80,0:30:07.68,Default,,0,0,0,,Өтінемін, жаман қимыл жасап, қуып кетпе, сенпай.
Dialogue: 0,0:30:07.76,0:30:11.93,Default,,0,0,0,,Барса: Детектив ретінде сіз менің ағам шығарсыз.
Dialogue: 0,0:30:12.01,0:30:15.93,Default,,0,0,0,,Бірақ Хагивара да Мацуданың келгеніне қуанышты.
Dialogue: 0,0:30:16.02,0:30:17.60,Default,,0,0,0,,Оның келмеуі мүмкін емес.
Dialogue: 0,0:30:18.23,0:30:20.86,Default,,0,0,0,,Мен бұл жігіттің жауын алуға уәде беремін.
Dialogue: 0,0:30:23.44,0:30:25.61,Default,,0,0,0,,Өйткені мен оны әлі орындаған жоқпын.
Dialogue: 0,0:30:26.57,0:30:30.11,Default,,0,0,0,,Келесі күні мұндай оқиға болғанына сене алар емеспін...
Dialogue: 0,0:30:30.78,0:30:31.95,Default,,0,0,0,,Бұл бәрі емес, солай емес пе?
Dialogue: 0,0:30:32.03,0:30:32.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:32.95,0:30:35.41,Default,,0,0,0,,Осыдан кейін бірдеңе болған жоқ па?
Dialogue: 0,0:30:35.50,0:30:37.54,Default,,0,0,0,,Бомбаларға қатысты істер
Dialogue: 0,0:30:37.62,0:30:39.12,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:30:39.21,0:30:41.04,Default,,0,0,0,,Мен кішкене зерттеу жүргіздім.
Dialogue: 0,0:30:41.13,0:30:43.88,Default,,0,0,0,,Қабір орналасқан ғибадатхана Шибуяға жақын жерде болды, солай ма?
Dialogue: 0,0:30:43.96,0:30:46.97,Default,,0,0,0,,Сол күні үш жыл бұрын, Шибуядағы көп пәтерлі үйде.
Dialogue: 0,0:30:47.05,0:30:48.63,Default,,0,0,0,,Газдың ағу оқиғасы болды.
Dialogue: 0,0:30:49.43,0:30:52.64,Default,,0,0,0,,Сіз ойлағандай, сол күні...
Dialogue: 0,0:30:54.22,0:30:55.64,Default,,0,0,0,,Мені Шибуя станциясына қалдырыңыз.
Dialogue: 0,0:30:55.72,0:30:57.89,Default,,0,0,0,,Осыдан кейін мен үйге жалғыз барамын.
Dialogue: 0,0:30:57.98,0:31:00.48,Default,,0,0,0,,Кешіріңіз, мен оны вокзалдың алдына ғана жібере аламын.
Dialogue: 0,0:31:00.56,0:31:02.44,Default,,0,0,0,,Иә, Моробуси сияқты
Dialogue: 0,0:31:02.52,0:31:05.40,Default,,0,0,0,,Көпшіліктің көз алдында тұра алмайтын күйде болдым.
Dialogue: 0,0:31:05.48,0:31:08.57,Default,,0,0,0,,Бұл сіздің жұмысыңыз сияқты, детектив.
Dialogue: 0,0:31:08.65,0:31:10.91,Default,,0,0,0,,...Қандай күн!
Dialogue: 0,0:31:11.49,0:31:14.03,Default,,0,0,0,,Мацуда екеуміз сонда барып, әңгіме тыңдағанымызда,
Dialogue: 0,0:31:14.12,0:31:17.08,Default,,0,0,0,,Біреу қараусыз қалған ғимаратқа жасырын кіріп кеткен сияқты.
Dialogue: 0,0:31:17.16,0:31:19.29,Default,,0,0,0,,Ол зорлық-зомбылық жасап жатқан сияқты екенін айтты.
Dialogue: 0,0:31:19.37,0:31:22.67,Default,,0,0,0,,Мен осыған дейін қасымда болған жігіттерді мені қолдауға шақырдым.
Dialogue: 0,0:31:22.75,0:31:26.13,Default,,0,0,0,,Олар келгенге дейін Мацуда екеуміз ғана қалдық.
Dialogue: 0,0:31:26.21,0:31:28.80,Default,,0,0,0,,Мен іште не болып жатқанын көруді жөн көрдім.
Dialogue: 0,0:31:31.76,0:31:33.18,Default,,0,0,0,,Хмм
Dialogue: 0,0:31:36.01,0:31:38.18,Default,,0,0,0,,Ол есінен танып қалған сияқты.
Dialogue: 0,0:31:38.27,0:31:40.06,Default,,0,0,0,,Сіз жапон емессіз.
Dialogue: 0,0:31:40.14,0:31:41.14,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:31:41.23,0:31:43.90,Default,,0,0,0,,Уф... аааа аааа
Dialogue: 0,0:31:43.98,0:31:46.77,Default,,0,0,0,,Сабыр ет, біз детективпіз.
Dialogue: 0,0:31:46.86,0:31:49.24,Default,,0,0,0,,Тек детектив
Dialogue: 0,0:31:49.32,0:31:50.86,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:31:51.95,0:31:52.78,Default,,0,0,0,,Әй?
Dialogue: 0,0:31:52.86,0:31:55.28,Default,,0,0,0,,Бұл орысша. Бұл саған қашып кет деп жатыр.
Dialogue: 0,0:31:55.37,0:31:56.37,Default,,0,0,0,,Алдымен төмен түсіңіз.
Dialogue: 0,0:31:56.45,0:32:00.37,Default,,0,0,0,,Егер сізді полиция тоқтатса, оларға осы визит картасын көрсетіңіз.
Dialogue: 0,0:32:00.46,0:32:05.71,Default,,0,0,0,,(орыс)
Dialogue: 0,0:32:06.71,0:32:07.88,Default,,0,0,0,,Ах
Dialogue: 0,0:32:07.96,0:32:10.13,Default,,0,0,0,,(шу)
Dialogue: 0,0:32:10.21,0:32:13.09,Default,,0,0,0,,Клиенттер әлі де бар сияқты.
Dialogue: 0,0:32:20.22,0:32:23.69,Default,,0,0,0,,Күткендей, қоғамдық қауіпсіздікте бәрі бар.
Dialogue: 0,0:32:25.48,0:32:26.31,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:32:34.91,0:32:36.82,Default,,0,0,0,,- (Мацуда) Бұл жаман - (Амуро) Не?
Dialogue: 0,0:32:36.91,0:32:39.04,Default,,0,0,0,,Оның артында бомба бар.
Dialogue: 0,0:32:39.12,0:32:41.33,Default,,0,0,0,,Егер сіз нашар атсаңыз, жарылыс болуы мүмкін.
Dialogue: 0,0:32:41.41,0:32:45.08,Default,,0,0,0,,Бұл өлшемде, егер сіз осы ғимаратта болсаңыз, бірінші рет Одабутсуды көресіз.
Dialogue: 0,0:32:45.17,0:32:46.63,Default,,0,0,0,,Оны тоқтатуға бола ма?
Dialogue: 0,0:32:46.71,0:32:48.71,Default,,0,0,0,,- (Мацуда) Оны тоқтата алмаймын деп ойлайсың ба? -(Амуро) Иә.
Dialogue: 0,0:32:49.34,0:32:50.21,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,0:32:51.80,0:32:52.80,Default,,0,0,0,,Тс!
Dialogue: 0,0:32:55.89,0:32:57.51,Default,,0,0,0,,Хмм... күте тұрыңыз!
Dialogue: 0,0:33:00.68,0:33:03.27,Default,,0,0,0,,Мен оны қуып келемін. Мацуда, бомбаны тез таста!
Dialogue: 0,0:33:03.35,0:33:05.48,Default,,0,0,0,,Әй, менің сұрайтыным осы.
Dialogue: 0,0:33:05.56,0:33:06.77,Default,,0,0,0,,Иә
Dialogue: 0,0:33:11.90,0:33:13.99,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:33:15.78,0:33:17.24,Default,,0,0,0,,Уф
Dialogue: 0,0:33:30.34,0:33:32.34,Default,,0,0,0,,Сіз төмен түстіңіз бе? Ха…
Dialogue: 0,0:33:32.42,0:33:34.59,Default,,0,0,0,,Нашар, нысана Мацуда!
Dialogue: 0,0:33:34.67,0:33:36.01,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:33:36.09,0:33:37.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:38.59,0:33:43.06,Default,,0,0,0,,Эй... қызық, қызық, біз бомбаны бөлшектеп жатсақ та.
Dialogue: 0,0:33:43.14,0:33:44.43,Default,,0,0,0,,Мазалама!
Dialogue: 0,0:33:46.81,0:33:47.90,Default,,0,0,0,,Бөлімше басшысы!
Dialogue: 0,0:33:47.98,0:33:50.48,Default,,0,0,0,,Қарусыз, мылтығы бар адамнан бас тартпа!
Dialogue: 0,0:33:55.49,0:33:57.16,Default,,0,0,0,,- (Мацуда) Хиро! -(Моробуши) Нөл қауіпсіз бе?
Dialogue: 0,0:33:57.24,0:33:59.07,Default,,0,0,0,,Кешіріңіз, мен құтқарылдым.
Dialogue: 0,0:33:59.16,0:34:01.58,Default,,0,0,0,,Маған ол бұзған көліктің есігін әкел.
Dialogue: 0,0:34:01.66,0:34:03.37,Default,,0,0,0,,Дұрыс айттыңыз.
Dialogue: 0,0:34:06.87,0:34:08.08,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:34:08.17,0:34:09.25,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:34:13.59,0:34:14.96,Default,,0,0,0,,Тәтті... Тәтті!
Dialogue: 0,0:34:15.05,0:34:16.84,Default,,0,0,0,,Екеуіңізден де қашыңыз!
Dialogue: 0,0:34:16.92,0:34:18.09,Default,,0,0,0,,Мен сенің қашуыңа жол бермеймін
Dialogue: 0,0:34:25.98,0:34:26.98,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:34:27.06,0:34:28.14,Default,,0,0,0,,Тс!
Dialogue: 0,0:34:28.23,0:34:30.27,Default,,0,0,0,,Бөлімше басшысы! сұраңыз!
Dialogue: 0,0:34:30.35,0:34:32.19,Default,,0,0,0,,Мм, шын!
Dialogue: 0,0:34:32.27,0:34:33.57,Default,,0,0,0,,Әй!
Dialogue: 0,0:34:45.20,0:34:47.21,Default,,0,0,0,,Бұл абайсызда болды
Dialogue: 0,0:34:47.29,0:34:48.50,Default,,0,0,0,,Хиро! Топ басшысы!
Dialogue: 0,0:34:48.58,0:34:51.17,Default,,0,0,0,,Бұл жігіттің достары әлі жасырынып жүрген болуы мүмкін.
Dialogue: 0,0:34:51.25,0:34:52.13,Default,,0,0,0,,Мацуданы сұраңыз!
Dialogue: 0,0:34:52.21,0:34:53.25,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:34:53.34,0:34:54.96,Default,,0,0,0,,Сіз де абай болыңыз!
Dialogue: 0,0:34:55.05,0:34:55.92,Default,,0,0,0,,О
Dialogue: 0,0:34:56.01,0:34:58.76,Default,,0,0,0,,Топ жетекшісі, мен Нөлді қолдаймын.
Dialogue: 0,0:34:58.84,0:35:02.76,Default,,0,0,0,,Ол қарапайым адам емес, мен онымен жалғыз күресу қиын деп ойлаймын.
Dialogue: 0,0:35:02.85,0:35:04.81,Default,,0,0,0,,Жарайды, өтінемін.
Dialogue: 0,0:35:04.89,0:35:06.14,Default,,0,0,0,,О
Dialogue: 0,0:35:27.66,0:35:29.96,Default,,0,0,0,,Мм, граната!
Dialogue: 0,0:35:31.87,0:35:33.08,Default,,0,0,0,,...
Dialogue: 0,0:35:33.71,0:35:34.67,Default,,0,0,0,,Әй!
Dialogue: 0,0:35:35.84,0:35:37.34,Default,,0,0,0,,Сіз әлі қашып жүрсіз бе?
Dialogue: 0,0:35:37.42,0:35:39.59,Default,,0,0,0,,Менің достарым бар шығар.
Dialogue: 0,0:35:39.67,0:35:41.09,Default,,0,0,0,,- (Мацуда) Эй, - (Күн) А?
Dialogue: 0,0:35:41.18,0:35:44.10,Default,,0,0,0,,Сен болсаң, мені өлтіруге қайтып келмес едің.
Dialogue: 0,0:35:44.18,0:35:45.60,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:35:45.68,0:35:48.85,Default,,0,0,0,,Аа, бастық, сізде сағыз бар ма?
Dialogue: 0,0:35:49.43,0:35:51.14,Default,,0,0,0,,Шайнау зейінді жинақтауға көмектеседі
Dialogue: 0,0:35:51.23,0:35:52.85,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:35:52.94,0:35:55.61,Default,,0,0,0,,Мен енді топ басшысы емеспін.
Dialogue: 0,0:35:55.69,0:35:56.73,Default,,0,0,0,,Уф
Dialogue: 0,0:36:07.83,0:36:08.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:36:14.71,0:36:15.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:36:18.34,0:36:20.13,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:36:21.67,0:36:22.51,Default,,0,0,0,,Ха…
Dialogue: 0,0:36:25.05,0:36:29.89,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:36:30.56,0:36:32.52,Default,,0,0,0,,Хаха...
Dialogue: 0,0:36:32.60,0:36:34.27,Default,,0,0,0,,Нөл Жақсысың ба?
Dialogue: 0,0:36:34.35,0:36:36.23,Default,,0,0,0,,Сәлем... Хиро...
Dialogue: 0,0:36:36.31,0:36:37.52,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:36:38.11,0:36:40.07,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:36:40.57,0:36:44.57,Default,,0,0,0,,Күте тұрыңыз, Хиро, ол жарақат алды. Қалғанын қолдауға қалдырайық.
Dialogue: 0,0:36:44.66,0:36:47.49,Default,,0,0,0,,Эй... жақсысың ба? нөл
Dialogue: 0,0:36:47.58,0:36:50.24,Default,,0,0,0,,А, бұл пайдалы, Хиро.
Dialogue: 0,0:36:50.33,0:36:53.12,Default,,0,0,0,,Егер сіз оны сәл шайқасаңыз немесе еңкейтсеңіз
Dialogue: 0,0:36:53.21,0:36:55.54,Default,,0,0,0,,Сұйықтық сыртқа ағып, соққы естіледі.
Dialogue: 0,0:36:55.63,0:36:57.63,Default,,0,0,0,,Кешіріңіз, мен оны өткізіп алдым.
Dialogue: 0,0:36:57.71,0:36:59.50,Default,,0,0,0,,Әй, жақсысың ба? нөл
Dialogue: 0,0:36:59.59,0:37:01.92,Default,,0,0,0,,Уайымдама Жағдай қандай?
Dialogue: 0,0:37:02.01,0:37:03.63,Default,,0,0,0,,Бұл да жақсы емес.
Dialogue: 0,0:37:04.26,0:37:07.64,Default,,0,0,0,,Бұл жерді маған қалдырыңыз және айналаңыздағы адамдарды эвакуациялаңыз.
Dialogue: 0,0:37:07.72,0:37:09.72,Default,,0,0,0,,- (Моробуши) Бірақ... - (Мацуда) Жақсы, жүр.
Dialogue: 0,0:37:09.81,0:37:10.89,Default,,0,0,0,,Үш минут қалды.
Dialogue: 0,0:37:10.97,0:37:14.85,Default,,0,0,0,,Газдың шығуына немесе басқа себептерге байланысты осы ғимараттың айналасындағы аумақты эвакуациялаңыз.
Dialogue: 0,0:37:14.85,0:37:15.44,Default,,0,0,0,,Газдың шығуына немесе басқа себептерге байланысты осы ғимараттың айналасындағы аумақты көшіріңіз.
Dialogue: 0,0:37:14.85,0:37:15.44,Default,,0,0,0,,(кесу сымының дыбысы)
Dialogue: 0,0:37:15.44,0:37:15.52,Default,,0,0,0,,(кесу сымының дыбысы)
Dialogue: 0,0:37:15.52,0:37:16.10,Default,,0,0,0,,(кесу өткізгішінің дыбысы)
Dialogue: 0,0:37:15.52,0:37:16.10,Default,,0,0,0,,Жарайды, кеттік, Хиро.
Dialogue: 0,0:37:16.10,0:37:17.40,Default,,0,0,0,,Жарайды, кеттік, Хиро.
Dialogue: 0,0:37:17.48,0:37:18.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:18.48,0:37:19.69,Default,,0,0,0,,Топ басшысы да
Dialogue: 0,0:37:19.77,0:37:22.11,Default,,0,0,0,,Цк, түсіндім.
Dialogue: 0,0:37:22.19,0:37:23.40,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:37:23.49,0:37:24.90,Default,,0,0,0,,астында
Dialogue: 0,0:37:25.61,0:37:26.66,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:37:26.74,0:37:28.41,Default,,0,0,0,,Иә
Dialogue: 0,0:37:28.49,0:37:30.45,Default,,0,0,0,,Мен ешқандай уәде бере алмаймын.
Dialogue: 0,0:37:30.53,0:37:31.91,Default,,0,0,0,,Қазір кет!
Dialogue: 0,0:37:58.40,0:38:01.94,Default,,0,0,0,,Я... бұл өте жаман
Dialogue: 0,0:38:05.03,0:38:06.99,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:38:09.62,0:38:11.74,Default,,0,0,0,,Қарғыс атсын, бұл алыс!
Dialogue: 0,0:38:14.08,0:38:17.00,Default,,0,0,0,,Осындай кезде ол хаги болса не істер еді...
Dialogue: 0,0:38:17.08,0:38:18.75,Default,,0,0,0,,Цзиньпэй-чан, қоңырау шал!
Dialogue: 0,0:38:18.83,0:38:20.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:38:25.21,0:38:27.59,Default,,0,0,0,,(Түрту дыбысы)
Dialogue: 0,0:38:32.76,0:38:33.97,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:38:34.06,0:38:36.10,Default,,0,0,0,,Күткендей, бауырым суып кетті.
Dialogue: 0,0:38:36.77,0:38:38.35,Default,,0,0,0,,Хаги Рахмет
Dialogue: 0,0:38:39.02,0:38:42.36,Default,,0,0,0,,Кенеттен бұрын не істегеніңізді еске түсіріңіз.
Dialogue: 0,0:38:45.94,0:38:49.24,Default,,0,0,0,,Мен оны бірден сынап көрдім және ол жұмыс істеді.
Dialogue: 0,0:38:49.32,0:38:50.49,Default,,0,0,0,,Фу…
Dialogue: 0,0:38:50.57,0:38:53.16,Default,,0,0,0,,Бейітті зиярат еткеніңіз үшін рахмет деп ойлаймын.
Dialogue: 0,0:39:04.80,0:39:06.26,Default,,0,0,0,,Міне, біз төртеуміз—
Dialogue: 0,0:39:06.34,0:39:09.01,Default,,0,0,0,,Соңғы күні не болды
Dialogue: 0,0:39:10.22,0:39:13.10,Default,,0,0,0,,Яғни, сол кездегі құрбан...
Dialogue: 0,0:39:13.18,0:39:14.26,Default,,0,0,0,,Сөз жоқ.
Dialogue: 0,0:39:15.01,0:39:18.27,Default,,0,0,0,,Бірақ ол кісінің кім екенін білмеймін.
Dialogue: 0,0:39:18.35,0:39:21.52,Default,,0,0,0,,Оқиға туралы ешқашан хабарланбаған.
Dialogue: 0,0:39:21.60,0:39:24.48,Default,,0,0,0,,Газдың ағып кетуіне байланысты кәдеге жаратылған
Dialogue: 0,0:39:24.57,0:39:25.82,Default,,0,0,0,,Қоғамдық қауіпсіздік араласады
Dialogue: 0,0:39:25.90,0:39:28.61,Default,,0,0,0,,Барлық ақпаратты басшылар мөрмен жауып тастады.
Dialogue: 0,0:39:28.69,0:39:31.07,Default,,0,0,0,,Табылған бомбаға не болды?
Dialogue: 0,0:39:31.16,0:39:32.16,Default,,0,0,0,,Ах
Dialogue: 0,0:39:32.24,0:39:33.41,Default,,0,0,0,,Бұл...
Dialogue: 0,0:39:33.49,0:39:35.12,Default,,0,0,0,,Талдау үшін бомба
Dialogue: 0,0:39:35.20,0:39:37.16,Default,,0,0,0,,Баспаналардың біріне әкелінді
Dialogue: 0,0:39:37.75,0:39:41.50,Default,,0,0,0,,Бірақ біз ингредиенттерді талдамас бұрын, жұмбақ жарылыс болды.
Dialogue: 0,0:39:41.58,0:39:44.46,Default,,0,0,0,,Қатысқандардың барлығы қайтыс болды.
Dialogue: 0,0:39:44.54,0:39:45.54,Default,,0,0,0,,Ах
Dialogue: 0,0:39:45.63,0:39:47.34,Default,,0,0,0,,Тергеу үшін қажет болуы мүмкін
Dialogue: 0,0:39:47.42,0:39:50.59,Default,,0,0,0,,Казамидің байланыс ақпаратын тек осы жолы пайдалануға болады.
Dialogue: 0,0:39:50.67,0:39:55.26,Default,,0,0,0,,Сондай-ақ, сол кезде Мацуда бөлшектеп жатқан бомбаның фотосы мен құрылымы.
Dialogue: 0,0:39:55.35,0:39:58.60,Default,,0,0,0,,Мен саған төрт әріптесімнің суретін де жіберемін.
Dialogue: 0,0:39:59.10,0:40:03.44,Default,,0,0,0,,Сол жақтан: Моробуши, Мацуда, Дата және мен, Хагивара.
Dialogue: 0,0:40:03.52,0:40:04.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:04.98,0:40:06.86,Default,,0,0,0,,Бұл адам бір жерде...
Dialogue: 0,0:40:06.94,0:40:09.36,Default,,0,0,0,,Қоштасатын уақыт та қалған сияқты.
Dialogue: 0,0:40:09.44,0:40:12.32,Default,,0,0,0,,Жау сіз ойлағаннан да қауіпті және қорқынышты.
Dialogue: 0,0:40:12.40,0:40:14.57,Default,,0,0,0,,Сенің де білгеніңді қалаймын.
Dialogue: 0,0:40:14.66,0:40:17.33,Default,,0,0,0,,Мен бұлай қозғала алмаймын.
Dialogue: 0,0:40:17.41,0:40:19.25,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:40:21.71,0:40:23.87,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:40:23.96,0:40:28.38,Default,,0,0,0,,Өткен жолы ауа-райы қолайсыз болып, көзімді жақсы көрмей қалдым.
Dialogue: 0,0:40:28.46,0:40:30.17,Default,,0,0,0,,А, бар!
Dialogue: 0,0:40:30.26,0:40:32.63,Default,,0,0,0,,Мен дәмді көрінетін нәрсе сататын дүкенді көріп тұрмын.
Dialogue: 0,0:40:32.72,0:40:33.76,Default,,0,0,0,,Е, ол қайда?
Dialogue: 0,0:40:33.84,0:40:36.35,Default,,0,0,0,,- (Гента) Мына жерде. - (Жүгіріп) Шу үшін кешіріңіз.
Dialogue: 0,0:40:36.43,0:40:38.31,Default,,0,0,0,,Бұл жанды және жақсы.
Dialogue: 0,0:40:38.39,0:40:40.72,Default,,0,0,0,,Детектив Моридің жағдайы қалай?
Dialogue: 0,0:40:40.81,0:40:44.90,Default,,0,0,0,,Мен ес жидым және бүгін таңертең жақын маңдағы ауруханаға ауыстырылдым.
Dialogue: 0,0:40:44.98,0:40:47.15,Default,,0,0,0,,Жарайсыңдар~!
Dialogue: 0,0:40:47.23,0:40:49.07,Default,,0,0,0,,Бірдеңе істе!
Dialogue: 0,0:40:49.15,0:40:52.74,Default,,0,0,0,,Бұл біртүрлі. Анестезия осы уақытқа дейін күшіне енуі керек еді.
Dialogue: 0,0:40:52.82,0:40:54.28,Default,,0,0,0,,Ол да төзімді ме?
Dialogue: 0,0:40:54.36,0:40:57.91,Default,,0,0,0,,Ауруды басатын дәрі тозып, балаша шулап жатырмын.
Dialogue: 0,0:40:57.99,0:40:59.45,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:40:59.54,0:41:00.91,Default,,0,0,0,,Қараңдаршы!
Dialogue: 0,0:41:01.00,0:41:02.62,Default,,0,0,0,,Тікұшақ жақын жерде!
Dialogue: 0,0:41:02.71,0:41:06.13,Default,,0,0,0,,Хикари төбесінде тікұшақ алаңы да бар.
Dialogue: 0,0:41:06.21,0:41:08.09,Default,,0,0,0,,Қабылдау аяқталғаннан кейін
Dialogue: 0,0:41:08.17,0:41:09.59,Default,,0,0,0,,Біз Токио үстінен тікұшақпен ұшуды жоспарлап отырмыз.
Dialogue: 0,0:41:09.59,0:41:11.38,Default,,0,0,0,,Біз Токионың үстінен тікұшақпен ұшуды жоспарлап отырмыз.
Dialogue: 0,0:41:09.59,0:41:11.38,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:41:11.38,0:41:11.46,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:41:11.46,0:41:13.55,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:41:11.46,0:41:13.55,Default,,0,0,0,,- (Жүгіріп) Ху - (Аюми) О, керемет!
Dialogue: 0,0:41:13.55,0:41:13.63,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:41:13.63,0:41:15.89,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:41:13.63,0:41:15.89,Default,,0,0,0,,Бұл романтикалық, солай емес пе?
Dialogue: 0,0:41:15.97,0:41:17.51,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:41:17.60,0:41:18.64,Default,,0,0,0,,Иә, не болды?
Dialogue: 0,0:41:19.39,0:41:20.47,Default,,0,0,0,,Иә
Dialogue: 0,0:41:21.31,0:41:25.19,Default,,0,0,0,,Не? Осыдан кейін кездесуім бар...
Dialogue: 0,0:41:25.27,0:41:27.40,Default,,0,0,0,,Сәлеметсіз бе? сәлем?
Dialogue: 0,0:41:27.98,0:41:29.06,Default,,0,0,0,,Қарт әже, кіріп келемін.
Dialogue: 0,0:41:29.15,0:41:32.19,Default,,0,0,0,,Менің досым маған бірдеңе бергісі келеді.
Dialogue: 0,0:41:32.28,0:41:34.45,Default,,0,0,0,,Ол Шибуяда және сенің келгеніңді қалайды.
Dialogue: 0,0:41:34.53,0:41:35.91,Default,,0,0,0,,Бұл проблема болар еді.
Dialogue: 0,0:41:36.49,0:41:39.45,Default,,0,0,0,,Осыдан кейін модератормен кездесуім бар...
Dialogue: 0,0:41:39.53,0:41:39.99,Default,,0,0,0,,Мен осылай дедім...
Dialogue: 0,0:41:39.99,0:41:40.91,Default,,0,0,0,,Мен осылай дедім...
Dialogue: 0,0:41:39.99,0:41:40.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:41:41.58,0:41:43.29,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:41:43.37,0:41:44.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:44.29,0:41:46.00,Default,,0,0,0,,Бұл жақын жерде, солай ма?
Dialogue: 0,0:41:46.08,0:41:47.08,Default,,0,0,0,,«қаһарман» мамандығы пайда болды
Dialogue: 0,0:41:47.17,0:41:48.58,Default,,0,0,0,,бірақ мен әлемді өзгерту үшін өзім кісі өлтірушіге айналар едім деп ойламаймын
Dialogue: 0,0:41:48.67,0:41:51.05,Default,,0,0,0,,Мен баламын деп мені бағалама
Dialogue: 0,0:41:51.13,0:41:53.26,Default,,0,0,0,,Біз кез келген сұрауды қабылдаймыз.
Dialogue: 0,0:41:53.34,0:41:56.63,Default,,0,0,0,,Біз ең мықты бірінші сынып оқушыларымыз
Dialogue: 0,0:41:57.34,0:42:00.35,Default,,0,0,0,,Детектив жігіттер осында!
Dialogue: 0,0:42:00.43,0:42:01.47,Default,,0,0,0,,Сіз қай кезде мықты болдыңыз?
Dialogue: 0,0:42:01.47,0:42:02.72,Default,,0,0,0,,Сіз қай кезде мықты болдыңыз?
Dialogue: 0,0:42:01.47,0:42:02.72,Default,,0,0,0,,А…?
Dialogue: 0,0:42:02.72,0:42:03.27,Default,,0,0,0,,Сіз қай кезде мықты болдыңыз?
Dialogue: 0,0:42:03.35,0:42:05.39,Default,,0,0,0,,Мен сізге бір жақсылық сұрасам болады ма?
Dialogue: 0,0:42:05.48,0:42:08.35,Default,,0,0,0,,Мен жаңа ғана пошта арқылы карта алдым, сондықтан мен оны қағазға саламын.
Dialogue: 0,0:42:08.44,0:42:09.90,Default,,0,0,0,,Уа!
Dialogue: 0,0:42:09.98,0:42:11.19,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:42:11.27,0:42:12.73,Default,,0,0,0,,Барлығына жарай ма?
Dialogue: 0,0:42:12.82,0:42:16.99,Default,,0,0,0,,Менің де барғым келеді, бірақ ауруханаға қайта баруым керек.
Dialogue: 0,0:42:17.07,0:42:19.32,Default,,0,0,0,,Таңғы асқа дейін қанша уақыт қалды?
Dialogue: 0,0:42:19.41,0:42:21.08,Default,,0,0,0,,Иә, бұл карта
Dialogue: 0,0:42:21.16,0:42:22.53,Default,,0,0,0,,Рахмет
Dialogue: 0,0:42:22.62,0:42:23.95,Default,,0,0,0,,Конан-кун да...
Dialogue: 0,0:42:24.04,0:42:24.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:24.95,0:42:27.29,Default,,0,0,0,,Қайда бара жатырсың? Конан-кун Ай-чан
Dialogue: 0,0:42:27.37,0:42:28.25,Default,,0,0,0,,Кінә – кінәсіз мысықты сөмкеге салып, осы жерге тастап кеткен адамда.
Dialogue: 0,0:42:33.75,0:42:36.26,Default,,0,0,0,,Мм, міне, осы.
Dialogue: 0,0:42:36.34,0:42:37.51,Default,,0,0,0,,Ммм
Dialogue: 0,0:42:38.84,0:42:42.51,Default,,0,0,0,,А... бірдеңе мен ойлағандай емес.
Dialogue: 0,0:42:42.60,0:42:46.39,Default,,0,0,0,,Бірақ бұл 6-қабат екеніне күмәнім жоқ...
Dialogue: 0,0:42:46.48,0:42:48.56,Default,,0,0,0,,Жарайды, бәрібір кеттік.
Dialogue: 0,0:42:48.64,0:42:49.85,Default,,0,0,0,,Иә...
Dialogue: 0,0:42:54.73,0:42:55.69,Default,,0,0,0,,Ах
Dialogue: 0,0:42:57.61,0:42:59.36,Default,,0,0,0,,Міне.
Dialogue: 0,0:43:01.24,0:43:02.91,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:43:02.99,0:43:04.87,Default,,0,0,0,,Кристиннің атынан
Dialogue: 0,0:43:04.95,0:43:07.41,Default,,0,0,0,,Мен мұнда сыйлық алуға келдім, бірақ...
Dialogue: 0,0:43:07.50,0:43:10.12,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:43:11.13,0:43:13.46,Default,,0,0,0,,Ешкімнен белгі жоқ.
Dialogue: 0,0:43:13.96,0:43:16.55,Default,,0,0,0,,«Сыйлық жабылған матада»
Dialogue: 0,0:43:16.63,0:43:18.30,Default,,0,0,0,,Әй, сен бұл туралы айтып тұрған жоқсың ба?
Dialogue: 0,0:43:18.38,0:43:19.97,Default,,0,0,0,,Бұл үлкен.
Dialogue: 0,0:43:20.05,0:43:22.76,Default,,0,0,0,,Мен барамын, сендер осында күтіңдер.
Dialogue: 0,0:43:22.85,0:43:25.72,Default,,0,0,0,,- (Аюми) Ух... иә - (Мицухико) Сақ болыңыз.
Dialogue: 0,0:43:29.48,0:43:30.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:32.69,0:43:34.48,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:43:36.32,0:43:37.82,Default,,0,0,0,,- (Аюми) Бұл сыйлық па? -(Хайбара) А...
Dialogue: 0,0:43:37.90,0:43:39.03,Default,,0,0,0,,Не? ол
Dialogue: 0,0:43:39.11,0:43:39.99,Default,,0,0,0,,Бұл...
Dialogue: 0,0:43:41.45,0:43:43.20,Default,,0,0,0,,Бұл бомба! Қазір қашып кет!
Dialogue: 0,0:43:43.28,0:43:44.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:45.49,0:43:45.99,Default,,0,0,0,,Ах
Dialogue: 0,0:43:45.99,0:43:46.54,Default,,0,0,0,,Ах
Dialogue: 0,0:43:45.99,0:43:46.54,Default,,0,0,0,,Әй, есік өздігінен ашылады!
Dialogue: 0,0:43:46.54,0:43:46.62,Default,,0,0,0,,Әй, есік өздігінен ашылады!
Dialogue: 0,0:43:46.62,0:43:47.75,Default,,0,0,0,,Әй, есік өздігінен ашылады!
Dialogue: 0,0:43:46.62,0:43:47.75,Default,,0,0,0,,Бұл толық тұзақ болды.
Dialogue: 0,0:43:47.75,0:43:47.83,Default,,0,0,0,,Бұл толық тұзақ болды.
Dialogue: 0,0:43:47.83,0:43:48.58,Default,,0,0,0,,Бұл толық тұзақ болды.
Dialogue: 0,0:43:47.83,0:43:48.58,Default,,0,0,0,,Ашылмайды!
Dialogue: 0,0:43:48.58,0:43:48.66,Default,,0,0,0,,Ашылмайды!
Dialogue: 0,0:43:48.66,0:43:49.37,Default,,0,0,0,,Ашылмайды!
Dialogue: 0,0:43:48.66,0:43:49.37,Default,,0,0,0,,Жарылысқа 2 минуттан аз уақыт қалды!
Dialogue: 0,0:43:49.37,0:43:50.12,Default,,0,0,0,,Жарылысқа 2 минуттан аз уақыт қалды!
Dialogue: 0,0:43:50.21,0:43:53.04,Default,,0,0,0,,Мен әйтеуір қашуға тырысамын, сондықтан алдымен төмен түсіңіз!
Dialogue: 0,0:43:53.13,0:43:55.75,Default,,0,0,0,,- (Аюми) Бірақ... - Жарайды, тез жүр!
Dialogue: 0,0:43:56.25,0:43:57.84,Default,,0,0,0,,- (Хайбара) Кеттік - (Мицухико және т.б.) Иә?
Dialogue: 0,0:43:57.92,0:43:59.80,Default,,0,0,0,,Міне... сен Конанды тастап кетесің бе?
Dialogue: 0,0:43:59.88,0:44:02.80,Default,,0,0,0,,Дәл қазір Эдогава-кунның айтқанына сенуден басқа амалым жоқ.
Dialogue: 0,0:44:02.89,0:44:04.68,Default,,0,0,0,,Асығыңыз! Менің уақытым жоқ
Dialogue: 0,0:44:04.76,0:44:05.60,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:44:05.68,0:44:07.97,Default,,0,0,0,,Конан-кун, міндетті түрде қашып кет.
Dialogue: 0,0:44:08.06,0:44:08.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:10.85,0:44:12.14,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:44:14.19,0:44:15.90,Default,,0,0,0,,Ааа
Dialogue: 0,0:44:19.44,0:44:21.53,Default,,0,0,0,,Осы құбыр арқылы өтсе, әйтеуір...
Dialogue: 0,0:44:21.61,0:44:23.03,Default,,0,0,0,,Ах
Dialogue: 0,0:44:26.20,0:44:28.66,Default,,0,0,0,,Бомбаның құрылымы дерлік бірдей...
Dialogue: 0,0:44:28.74,0:44:29.58,Default,,0,0,0,,Бара аласыз ба!
Dialogue: 0,0:44:29.66,0:44:32.21,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:44:32.87,0:44:33.92,Default,,0,0,0,,Эдогава-кун…
Dialogue: 0,0:44:34.00,0:44:34.83,Default,,0,0,0,,Ах
Dialogue: 0,0:44:34.92,0:44:36.50,Default,,0,0,0,,Не?
Dialogue: 0,0:44:36.59,0:44:38.09,Default,,0,0,0,,Бір нәрсе құлады.
Dialogue: 0,0:44:39.84,0:44:41.34,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:44:42.97,0:44:44.89,Default,,0,0,0,,Барлығына! Өтінемін, ынтымақтастықта болыңыз!
Dialogue: 0,0:44:44.97,0:44:47.64,Default,,0,0,0,,- (Аюми) Конан-кун! -(Гента) Не айтып тұрсың?
Dialogue: 0,0:44:47.72,0:44:48.56,Default,,0,0,0,,Кәстрөл?
Dialogue: 0,0:44:48.64,0:44:49.93,Default,,0,0,0,,- (Хайбара) Оны жылжытыңыз! -(Мицухико) Иә?
Dialogue: 0,0:44:50.02,0:44:51.93,Default,,0,0,0,,Сізге тек сол мата керек.
Dialogue: 0,0:44:55.52,0:44:57.61,Default,,0,0,0,,Не айтсаң да, сен—
Dialogue: 0,0:44:58.48,0:45:01.19,Default,,0,0,0,,Эдогава-кун, мүмкіндігінше төмен түс!
Dialogue: 0,0:45:01.28,0:45:04.28,Default,,0,0,0,,Ол биікте ұстасам да құтқармайды!
Dialogue: 0,0:45:04.36,0:45:05.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:45:05.45,0:45:06.57,Default,,0,0,0,,Ол жарылып кетеді
Dialogue: 0,0:45:05.45,0:45:06.57,Default,,0,0,0,,- (Мицухико) Өтінемін, асығыңыз - (Хайбара) Тезірек!
Dialogue: 0,0:45:06.57,0:45:07.28,Default,,0,0,0,,- (Мицухико) Өтінемін, асығыңыз - (Хайбара) Тезірек!
Dialogue: 0,0:45:07.37,0:45:08.45,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:45:08.53,0:45:09.03,Default,,0,0,0,,(Мицухико және оның достарының әбігері)
Dialogue: 0,0:45:09.03,0:45:12.04,Default,,0,0,0,,(Мицухико және оның достарының әбігері)
Dialogue: 0,0:45:09.03,0:45:12.04,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:45:12.04,0:45:14.54,Default,,0,0,0,,(Мицухико және оның достарының әбігері)
Dialogue: 0,0:45:15.87,0:45:16.96,Default,,0,0,0,,Иә
Dialogue: 0,0:45:17.04,0:45:18.21,Default,,0,0,0,,Эдогава-кун!
Dialogue: 0,0:45:18.29,0:45:19.75,Default,,0,0,0,,Ахх... уф
Dialogue: 0,0:45:21.80,0:45:24.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:24.09,0:45:26.43,Default,,0,0,0,,Уау...
Dialogue: 0,0:45:26.51,0:45:27.47,Default,,0,0,0,,Конан!
Dialogue: 0,0:45:27.55,0:45:28.80,Default,,0,0,0,,- (Хайбара) Мына жерде! -(Мицухико) Ах!
Dialogue: 0,0:45:28.89,0:45:31.77,Default,,0,0,0,,Ууууууууууууууууу...
Dialogue: 0,0:45:32.60,0:45:33.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:36.31,0:45:37.65,Default,,0,0,0,,Күте тұрыңыз, осылайша.
Dialogue: 0,0:45:37.73,0:45:40.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:40.11,0:45:41.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:41.86,0:45:43.32,Default,,0,0,0,,Жоқ, мен осы жолы шындап тұрмын! Жоғарғы қабатта өлі дене жатыр.
Dialogue: 0,0:45:43.40,0:45:45.40,Default,,0,0,0,,Хммм Уау
Dialogue: 0,0:45:45.49,0:45:46.32,Default,,0,0,0,,тармақ...
Dialogue: 0,0:45:46.41,0:45:47.95,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:45:48.03,0:45:50.08,Default,,0,0,0,,Ах... рахмет.
Dialogue: 0,0:45:50.16,0:45:50.99,Default,,0,0,0,,Уау
Dialogue: 0,0:45:51.08,0:45:53.54,Default,,0,0,0,,- (Хайбара) Тезірек! Мен қашамын – (Мицухико)... Иә.
Dialogue: 0,0:45:54.25,0:45:56.17,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:45:56.25,0:45:59.67,Default,,0,0,0,,
Dialogue: 0,0:46:01.25,0:46:03.42,Default,,0,0,0,,Ха... бұл қауіпті болды.
Dialogue: 0,0:46:03.51,0:46:05.01,Default,,0,0,0,,Бұл жақын қоңырау болды.
Dialogue: 0,0:46:05.09,0:46:07.68,Default,,0,0,0,,Конан-кун, сенің аман болғаныңа қуаныштымын.
Dialogue: 0,0:46:07.76,0:46:09.80,Default,,0,0,0,,Конан-кун, бәріңе!
Dialogue: 0,0:46:09.89,0:46:11.56,Default,,0,0,0,,Ран-ничан
Dialogue: 0,0:46:12.26,0:46:14.18,Default,,0,0,0,,Сіз жарақат алдыңыз ба? Барлығы қауіпсіз бе?
Dialogue: 0,0:46:14.27,0:46:15.56,Default,,0,0,0,,Иә, әйтеуір.
Dialogue: 0,0:46:15.64,0:46:18.19,Default,,0,0,0,,Бомба қойылғаны рас па?
Dialogue: 0,0:46:18.27,0:46:19.56,Default,,0,0,0,,- (Гента) Бұл рас - (Аюми) Бұл рас.
Dialogue: 0,0:46:19.65,0:46:22.02,Default,,0,0,0,,- (Мицухико) Мен оны анық көрдім - (Гента) Таймер болды...
Dialogue: 0,0:46:22.57,0:46:24.90,Default,,0,0,0,,Әй, бірден сөйлеме.
Dialogue: 0,0:46:24.99,0:46:26.03,Default,,0,0,0,,Әр адамды бір-бірден мұқият тыңдаймын.
Dialogue: 0,0:46:26.03,0:46:27.28,Default,,0,0,0,,Әр адамды бір-бірден мұқият тыңдаймын.
Dialogue: 0,0:46:26.03,0:46:27.28,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:46:27.28,0:46:28.99,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:46:37.83,0:46:39.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:43.71,0:46:45.63,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға өте қуаныштымын.
Dialogue: 0,0:46:46.34,0:46:49.97,Default,,0,0,0,,Өртенген ғимарат сіз бара жатқан ғимарат екенін естігенде.
Dialogue: 0,0:46:50.05,0:46:51.89,Default,,0,0,0,,Бұл менің қанымды суытып жіберді.
Dialogue: 0,0:46:51.97,0:46:55.18,Default,,0,0,0,,Қорқынышты болды, бірақ мен су төгетін құбырға түстім.
Dialogue: 0,0:46:55.27,0:46:56.64,Default,,0,0,0,,Күрсін, бұл таңқаларлық.
Dialogue: 0,0:46:56.73,0:46:58.39,Default,,0,0,0,,Менен де батылдық бар.
Dialogue: 0,0:46:58.48,0:46:59.90,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:46:59.98,0:47:00.81,Default,,0,0,0,,Ах
Dialogue: 0,0:46:59.98,0:47:00.81,Default,,0,0,0,,(Кристинаның жылағаны)
Dialogue: 0,0:47:00.81,0:47:01.40,Default,,0,0,0,,(Кристинаның жылағаны)
Dialogue: 0,0:47:01.40,0:47:02.82,Default,,0,0,0,,(Кристинаның жылағаны)
Dialogue: 0,0:47:01.40,0:47:02.82,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:47:02.90,0:47:04.61,Default,,0,0,0,,Кристин
Dialogue: 0,0:47:04.69,0:47:08.07,Default,,0,0,0,,Бізде бәрі жақсы болады, сондықтан көп уайымдамаңыз
Dialogue: 0,0:47:08.70,0:47:09.70,Default,,0,0,0,,Рахмет
Dialogue: 0,0:47:09.78,0:47:12.03,Default,,0,0,0,,Конан-кунның әңгімесі бойынша
Dialogue: 0,0:47:12.12,0:47:14.54,Default,,0,0,0,,Таймер түріндегі бомба кенет сөнеді.
Dialogue: 0,0:47:14.62,0:47:15.91,Default,,0,0,0,,Бөлменің есігі жабылған кезде
Dialogue: 0,0:47:15.91,0:47:16.75,Default,,0,0,0,,Бөлменің есігі жабылған кезде
Dialogue: 0,0:47:15.91,0:47:16.75,Default,,0,0,0,,Иә
Dialogue: 0,0:47:16.83,0:47:18.04,Default,,0,0,0,,Кірген адам
Dialogue: 0,0:47:18.12,0:47:20.46,Default,,0,0,0,,Ол міндетті түрде оны өлтірмек болған болуы керек.
Dialogue: 0,0:47:20.54,0:47:21.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:21.58,0:47:26.05,Default,,0,0,0,,Сонымен Кристинмен хабарласқан шақырушы кім?
Dialogue: 0,0:47:26.13,0:47:30.13,Default,,0,0,0,,Мен тексердім, бірақ мұндай байланыс жасағаным есімде жоқ.
Dialogue: 0,0:47:30.22,0:47:32.84,Default,,0,0,0,,Біз сізден сайттың айналасы туралы сұраймыз.
Dialogue: 0,0:47:32.93,0:47:36.89,Default,,0,0,0,,Бомба әкелген адамды біреу бақылап тұрған болуы мүмкін.
Dialogue: 0,0:47:36.97,0:47:38.48,Default,,0,0,0,,Онда бәрібір.
Dialogue: 0,0:47:38.56,0:47:40.73,Default,,0,0,0,,Чиба мұны істеп жатыр
Dialogue: 0,0:47:40.81,0:47:44.94,Default,,0,0,0,,Шибуя деп аталса да, бұл жерде адам көп емес...
Dialogue: 0,0:47:45.02,0:47:47.23,Default,,0,0,0,,Куәгерлер үмітсіз бе?
Dialogue: 0,0:47:48.24,0:47:50.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:50.11,0:47:53.20,Default,,0,0,0,,Не? Е... жақсысың ба?
Dialogue: 0,0:47:53.28,0:47:54.87,Default,,0,0,0,,Аа уф
Dialogue: 0,0:47:55.83,0:47:58.29,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:48:00.46,0:48:01.62,Default,,0,0,0,,Әй!
Dialogue: 0,0:48:01.71,0:48:03.50,Default,,0,0,0,,Келесі аптаның қолжазбасын аяқтауға тек екі бет қана қалды.
Dialogue: 0,0:48:03.58,0:48:05.17,Default,,0,0,0,,Уф
Dialogue: 0,0:48:05.75,0:48:07.50,Default,,0,0,0,,А... аа
Dialogue: 0,0:48:07.59,0:48:08.42,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:48:08.51,0:48:10.17,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:48:17.18,0:48:18.39,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:48:18.47,0:48:21.48,Default,,0,0,0,,Егер тағы бірдеңе білсеңіз, маған хабарлаңыз.
Dialogue: 0,0:48:22.02,0:48:25.77,Default,,0,0,0,,Мегур: Кешіріңіз, бірақ қазір үйге баруға рұқсат бере аласыз ба?
Dialogue: 0,0:48:26.36,0:48:28.19,Default,,0,0,0,,Ол қатты ренжіді
Dialogue: 0,0:48:28.28,0:48:31.32,Default,,0,0,0,,О, бұл үшін кешіріңіз.
Dialogue: 0,0:48:31.40,0:48:34.20,Default,,0,0,0,,А... үйге барсаң да болады.
Dialogue: 0,0:48:34.28,0:48:35.12,Default,,0,0,0,,Иә
Dialogue: 0,0:48:35.20,0:48:37.37,Default,,0,0,0,,Қойылған бомба...
Dialogue: 0,0:48:37.45,0:48:42.12,Default,,0,0,0,,Бұл Амуро-сан және басқалары үш жыл бұрын шығарғанға өте ұқсас болды.
Dialogue: 0,0:48:42.21,0:48:42.92,Default,,0,0,0,,Бомбалар оны жасаған адамның болмысын көрсетеді дейді.
Dialogue: 0,0:48:42.92,0:48:45.25,Default,,0,0,0,,Бомбалар оны жасаған адамның болмысын көрсетеді дейді.
Dialogue: 0,0:48:42.92,0:48:45.25,Default,,0,0,0,,- (Мұранака) Олай болса - (Мегуре) Ах.
Dialogue: 0,0:48:45.25,0:48:45.33,Default,,0,0,0,,Бомбалар оны жасаған адамның болмысын көрсетеді дейді.
Dialogue: 0,0:48:45.33,0:48:46.25,Default,,0,0,0,,Бомбалар оны жасаған адамның болмысын көрсетеді дейді.
Dialogue: 0,0:48:45.33,0:48:46.25,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:48:46.25,0:48:46.34,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:48:46.34,0:48:47.04,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:48:46.34,0:48:47.04,Default,,0,0,0,,Екі оқиғаның бір қылмыс болуы ықтималдығы жоғары.
Dialogue: 0,0:48:47.04,0:48:49.63,Default,,0,0,0,,Екі оқиғаның бір қылмыс болуы ықтималдығы жоғары.
Dialogue: 0,0:48:49.71,0:48:51.47,Default,,0,0,0,,Оған психикалық күтім қажет болуы мүмкін.
Dialogue: 0,0:48:51.47,0:48:53.05,Default,,0,0,0,,Оған психологиялық көмек қажет болуы мүмкін.
Dialogue: 0,0:48:51.47,0:48:53.05,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:48:53.05,0:48:53.13,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:48:53.13,0:48:54.38,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:48:53.13,0:48:54.38,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:48:54.47,0:48:56.51,Default,,0,0,0,,Бұл Чиба-куннан. Сәлем.
Dialogue: 0,0:48:57.93,0:48:58.76,Default,,0,0,0,,Ха…
Dialogue: 0,0:48:58.85,0:49:00.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:02.39,0:49:05.60,Default,,0,0,0,,Мен тағы да айтамын: Детектив Чиба қамауда.
Dialogue: 0,0:49:06.27,0:49:09.98,Default,,0,0,0,,Егер сіз оның үйіне аман-есен оралғанын қаласаңыз, онымен бірге детектив Цзиньпэй Мацуданы әкеліңіз.
Dialogue: 0,0:49:10.07,0:49:11.32,Default,,0,0,0,,Детектив Мацуда?
Dialogue: 0,0:49:11.40,0:49:12.49,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:49:12.57,0:49:15.07,Default,,0,0,0,,Чибаның жағдайы жақсы деп үміттенемін.
Dialogue: 0,0:49:15.16,0:49:16.32,Default,,0,0,0,,Мен сізге қайта хабарласамын
Dialogue: 0,0:49:16.41,0:49:17.49,Default,,0,0,0,,(Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,0:49:17.57,0:49:18.87,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:49:19.45,0:49:21.66,Default,,0,0,0,,Оны өзімен бірге алып кеткісі келсе де...
Dialogue: 0,0:49:21.75,0:49:24.21,Default,,0,0,0,,Қылмыскердің мақсаты қандай?
Dialogue: 0,0:49:24.29,0:49:25.87,Default,,0,0,0,,Детектив Мацуданы неге қазір шақырып жатырсыз?
Dialogue: 0,0:49:26.63,0:49:28.13,Default,,0,0,0,,Шынында да, бұл жарылыс оқиғасы
Dialogue: 0,0:49:28.21,0:49:31.09,Default,,0,0,0,,Полиция қызметкерінің қызметтік міндетін атқару кезінде қаза тапқаны туралы хабарланғандықтан
Dialogue: 0,0:49:31.17,0:49:34.38,Default,,0,0,0,,Детектив Мацуда Жеке тұлғаның аты-жөні көпшілікке жарияланған жоқ.
Dialogue: 0,0:49:34.47,0:49:38.18,Default,,0,0,0,,Екінші жағынан, оның өлімі белгілі болса...
Dialogue: 0,0:49:38.26,0:49:40.14,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:49:40.22,0:49:42.68,Default,,0,0,0,,Бұлай жалғаса берсе, Чиба-кунның өмірі жойылады...
Dialogue: 0,0:49:42.77,0:49:44.39,Default,,0,0,0,,- (Такаги) Мм... - (2 адам) А?
Dialogue: 0,0:49:44.48,0:49:47.65,Default,,0,0,0,,Менде бір ой бар...
Dialogue: 0,0:49:48.27,0:49:50.69,Default,,0,0,0,,Бірінші тергеу бөлімінің детективін қалай ұрлауға болады?
Dialogue: 0,0:49:50.77,0:49:52.65,Default,,0,0,0,,Бұл күтпеген жағдай болды.
Dialogue: 0,0:49:52.73,0:49:56.07,Default,,0,0,0,,Оны Конан есімді бала алды.
Dialogue: 0,0:49:56.15,0:49:59.91,Default,,0,0,0,,Көріп отырғаныңыздай, ол үш жыл бұрынғы бомбаға қатты ұқсайды.
Dialogue: 0,0:49:59.99,0:50:02.16,Default,,0,0,0,,Бұл оның бірдей қылмыс екенін білдіре ме?
Dialogue: 0,0:50:02.24,0:50:04.91,Default,,0,0,0,,Ол туралы әлі ақпарат бар ма?
Dialogue: 0,0:50:05.00,0:50:09.17,Default,,0,0,0,,Жоғары басшылық тарапынан қажырлы еңбегіңіз үшін рахмет. Жаңа ғана келді.
Dialogue: 0,0:50:09.88,0:50:12.34,Default,,0,0,0,,Конан қандай сұйық мылтық жинады?
Dialogue: 0,0:50:12.42,0:50:13.80,Default,,0,0,0,,Қазіргі уақытта талдау жүргізілуде
Dialogue: 0,0:50:13.88,0:50:17.55,Default,,0,0,0,,Ол аяқталған бойда біз бейтараптандырғышты жасай бастаймыз.
Dialogue: 0,0:50:17.63,0:50:20.30,Default,,0,0,0,,Ол өз өмірін қатерге тігіп, маған жинады.
Dialogue: 0,0:50:20.39,0:50:22.31,Default,,0,0,0,,Босауға болмайды
Dialogue: 0,0:50:22.39,0:50:24.18,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:50:24.27,0:50:25.85,Default,,0,0,0,,1-бөліммен бірлесіп
Dialogue: 0,0:50:25.93,0:50:28.65,Default,,0,0,0,,Ұрланған детективті аман-есен қайтарыңыз.
Dialogue: 0,0:50:28.73,0:50:32.32,Default,,0,0,0,,Бізде бар кез келген ақпаратты жария ете аламыз.
Dialogue: 0,0:50:32.40,0:50:33.32,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:50:35.94,0:50:38.32,Default,,0,0,0,,Мен де қазір қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:50:38.41,0:50:41.95,Default,,0,0,0,,Енді қалай қозғаласыз?
Dialogue: 0,0:50:42.03,0:50:43.16,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:50:43.24,0:50:44.45,Default,,0,0,0,,Тым қауіпті!
Dialogue: 0,0:50:44.54,0:50:46.46,Default,,0,0,0,,Мен тәуекелдерді білемін.
Dialogue: 0,0:50:46.54,0:50:49.25,Default,,0,0,0,,Сонымен қатар жасырын микрофон мен таратқышты қосыңыз.
Dialogue: 0,0:50:49.33,0:50:51.75,Default,,0,0,0,,Бірдеңе болып қалса, біз бірден сонда боламыз...
Dialogue: 0,0:50:51.84,0:50:54.30,Default,,0,0,0,,Уақытында үлгере алмасаңыз, не істейсіз?
Dialogue: 0,0:50:55.05,0:50:56.97,Default,,0,0,0,,Үш жыл бұрынғыдай қайталанса...
Dialogue: 0,0:50:57.05,0:50:57.92,Default,,0,0,0,,Сато-кун!
Dialogue: 0,0:50:59.43,0:51:00.68,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:51:01.30,0:51:03.68,Default,,0,0,0,,Менің жолым өте нашар.
Dialogue: 0,0:51:04.81,0:51:07.27,Default,,0,0,0,,Мұндай жағдайда Чибаға кім көмектесе алады?
Dialogue: 0,0:51:08.02,0:51:09.52,Default,,0,0,0,,Бұл мен ғана
Dialogue: 0,0:51:10.48,0:51:14.52,Default,,0,0,0,,Жаңа ғана маған Казами-куннан қоғамдық қауіпсіздік департаментінен тергеумен ынтымақтастық туралы ұсыныс түсті.
Dialogue: 0,0:51:14.61,0:51:17.78,Default,,0,0,0,,Бұдан былай қоғамдық қауіпсіздікпен бірлесе жұмыс істейтін боламыз.
Dialogue: 0,0:51:17.86,0:51:20.82,Default,,0,0,0,,Қандай жағдай болмасын, біз Чибаны аман-есен қайтарамыз!
Dialogue: 0,0:51:20.91,0:51:22.57,Default,,0,0,0,,Иә! кеттік
Dialogue: 0,0:51:22.66,0:51:23.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:51:23.78,0:51:26.66,Default,,0,0,0,,Мен сенің өлуіңе ешқашан жол бермеймін
Dialogue: 0,0:51:26.75,0:51:28.12,Default,,0,0,0,,- Эй детектив Сато - (Сато) Иә?
Dialogue: 0,0:51:28.75,0:51:32.33,Default,,0,0,0,,Бұл қалалық полиция департаментінің алдында болған жарылыстың дәлелі ме?
Dialogue: 0,0:51:32.42,0:51:33.29,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:51:33.38,0:51:36.30,Default,,0,0,0,,Олар оны кейінірек бұталардан тапты.
Dialogue: 0,0:51:36.38,0:51:38.05,Default,,0,0,0,,Бұл қандай да бір естелік ме деп ойлаймын.
Dialogue: 0,0:51:38.13,0:51:41.80,Default,,0,0,0,,«Бұл мен біреуге жеткізгім келетін өте маңызды естелік.»
Dialogue: 0,0:51:42.43,0:51:46.72,Default,,0,0,0,,Бұл мен детектив Мацудаға көрсеткім келген хабарлама...
Dialogue: 0,0:51:48.27,0:51:51.81,Default,,0,0,0,,(Орыс әйелдері)
Dialogue: 0,0:51:54.02,0:52:00.99,Default,,0,0,0,,(Орыс әйелдері)
Dialogue: 0,0:52:01.95,0:52:02.91,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:52:02.99,0:52:05.08,Default,,0,0,0,,Осындай жерге жиналған бұл адамдарды не істеуіміз керек?
Dialogue: 0,0:52:05.16,0:52:06.83,Default,,0,0,0,,Ақпарат алмасу
Dialogue: 0,0:52:06.91,0:52:10.50,Default,,0,0,0,,Эй, сен маған Фуруя деген адамды кездестіруге рұқсат бересің бе?
Dialogue: 0,0:52:10.58,0:52:11.96,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:52:12.04,0:52:14.75,Default,,0,0,0,,Ол қазір оқшауланған мекемеде.
Dialogue: 0,0:52:14.84,0:52:16.59,Default,,0,0,0,,Өйткені оның мойнында бомба бар.
Dialogue: 0,0:52:16.67,0:52:17.50,Default,,0,0,0,,Ах
Dialogue: 0,0:52:21.26,0:52:24.72,Default,,0,0,0,,Сіз кеше ұстаған сериялық бомбалаушы
Dialogue: 0,0:52:24.80,0:52:26.97,Default,,0,0,0,,Біреудің нұсқауымен қашты
Dialogue: 0,0:52:27.56,0:52:31.43,Default,,0,0,0,,Осы кісіні қуып келе жатқанда Фуруяға біреу шабуыл жасайды.
Dialogue: 0,0:52:31.52,0:52:33.85,Default,,0,0,0,,Жаға тәрізді бомба бекітілген
Dialogue: 0,0:52:33.94,0:52:35.73,Default,,0,0,0,,Сонда кім қашып кетті?
Dialogue: 0,0:52:35.81,0:52:40.32,Default,,0,0,0,,Фуруя жалғанған бомбамен бірдей бомба жарылып, оны өлтірді.
Dialogue: 0,0:52:40.40,0:52:41.24,Default,,0,0,0,,Бұл...
Dialogue: 0,0:52:41.32,0:52:45.57,Default,,0,0,0,,Бұл қозғалыстар тізбегі біреудің құрған тұзағы деп есептейміз.
Dialogue: 0,0:52:45.66,0:52:47.12,Default,,0,0,0,,Фуруяны азғыру
Dialogue: 0,0:52:47.87,0:52:50.25,Default,,0,0,0,,Талдау нәтижелері Жағалы бомбалар бар
Dialogue: 0,0:52:50.33,0:52:54.58,Default,,0,0,0,,Екі компонентті арнайы жарылғыш зат қолданылғаны анықталды.
Dialogue: 0,0:52:54.67,0:52:58.13,Default,,0,0,0,,Осыған ұқсас бомба үш жыл бұрын болған оқиғада қолданылған.
Dialogue: 0,0:52:58.71,0:53:01.09,Default,,0,0,0,,Хмм...сонда сен кімсің?
Dialogue: 0,0:53:01.76,0:53:03.51,Default,,0,0,0,,Балалар, сендер оны түсіндіңдер, солай ма?
Dialogue: 0,0:53:03.59,0:53:05.47,Default,,0,0,0,,Белгісіз өлтіруші.
Dialogue: 0,0:53:05.55,0:53:09.10,Default,,0,0,0,,Ұлты Жыныс Жасы Барлығы белгісіз
Dialogue: 0,0:53:09.18,0:53:12.73,Default,,0,0,0,,Біз бүкіл әлем бойынша жұмыс істейміз, бірақ біздің жұмыс базамыз Ресейде.
Dialogue: 0,0:53:12.81,0:53:14.73,Default,,0,0,0,,Прамьяға қоңырау шалып, қорқып кетті
Dialogue: 0,0:53:14.81,0:53:18.86,Default,,0,0,0,,Эй, Прамья орысша «жалын» дегенді білдіреді ғой, солай ма?
Dialogue: 0,0:53:18.94,0:53:23.07,Default,,0,0,0,,Ол қолданатын жарылғыш заттар жарылғанда қандай сезімде болады?
Dialogue: 0,0:53:23.15,0:53:26.24,Default,,0,0,0,,Баланы да осында әкелдің бе?
Dialogue: 0,0:53:26.32,0:53:28.87,Default,,0,0,0,,Мен екі рет күдікті бомбаларды көрдім.
Dialogue: 0,0:53:28.95,0:53:31.20,Default,,0,0,0,,Мен оны өзіммен бірге алып келсем, тезірек болар деп ойладым.
Dialogue: 0,0:53:31.29,0:53:32.12,Default,,0,0,0,,Фу…
Dialogue: 0,0:53:32.20,0:53:34.79,Default,,0,0,0,,Сонымен, бомба қандай болады?
Dialogue: 0,0:53:34.87,0:53:37.88,Default,,0,0,0,,Жану да, жарылыс күші де өте күшті.
Dialogue: 0,0:53:37.96,0:53:41.88,Default,,0,0,0,,Сұйықтар араласқан сәтте олар жарылып, жалын бірден таралады.
Dialogue: 0,0:53:43.09,0:53:46.80,Default,,0,0,0,,Бұл шетелдіктермен көргенімізге өте ұқсас.
Dialogue: 0,0:53:46.89,0:53:48.60,Default,,0,0,0,,Ол қалалық полиция бөлімінің алдында өлтірілді ме?
Dialogue: 0,0:53:48.68,0:53:49.51,Default,,0,0,0,,Иә
Dialogue: 0,0:53:49.60,0:53:52.35,Default,,0,0,0,,Бірақ сен неге елордалық полиция бөлімінің алдында тұрып қиналдың?
Dialogue: 0,0:53:52.43,0:53:55.85,Default,,0,0,0,,Қазір ойлап қарасам, жәбірленуші елордалық полиция бөліміне не үшін келді?
Dialogue: 0,0:53:55.94,0:53:57.02,Default,,0,0,0,,Белгісіз болып қалады
Dialogue: 0,0:53:57.10,0:53:58.31,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:53:58.40,0:54:00.02,Default,,0,0,0,,Бұл визит карточкасы емес пе?
Dialogue: 0,0:54:00.11,0:54:01.86,Default,,0,0,0,,Мацуда-кун?
Dialogue: 0,0:54:01.94,0:54:03.23,Default,,0,0,0,,Сол шетелдік
Dialogue: 0,0:54:03.32,0:54:05.15,Default,,0,0,0,,Детектив Мацуданы көруге келмедің бе?
Dialogue: 0,0:54:05.78,0:54:09.41,Default,,0,0,0,,Детектив Мацуданың ынтымақтастығы, тіпті қауіп төнген жағдайда да қажет болды.
Dialogue: 0,0:54:09.49,0:54:11.20,Default,,0,0,0,,Яғни...
Dialogue: 0,0:54:11.28,0:54:14.62,Default,,0,0,0,,Сол құрбан және бұл жолы Чибаны ұрлап кеткен қылмыскерлер
Dialogue: 0,0:54:14.70,0:54:16.29,Default,,0,0,0,,Байланыстың қандай да бір түрі
Dialogue: 0,0:54:16.37,0:54:17.33,Default,,0,0,0,,Иә
Dialogue: 0,0:54:17.42,0:54:19.29,Default,,0,0,0,,Бүгінгі көп пәтерлі ғимараттағы жарылыс оқиғасы
Dialogue: 0,0:54:19.96,0:54:22.25,Default,,0,0,0,,Сонымен қатар, Прамья қолданған арнайы бомба бар.
Dialogue: 0,0:54:22.34,0:54:24.80,Default,,0,0,0,,Қолдану мүмкіндігі жоғары.
Dialogue: 0,0:54:25.47,0:54:27.47,Default,,0,0,0,,Конан және басқалары келді
Dialogue: 0,0:54:27.55,0:54:30.18,Default,,0,0,0,,Бұл тіпті Прамья үшін де күтпеген жағдай болды.
Dialogue: 0,0:54:30.26,0:54:32.68,Default,,0,0,0,,Негізінде, Мұранака мырза мен ханым сонда болды...
Dialogue: 0,0:54:32.76,0:54:35.81,Default,,0,0,0,,Үйлену тойында қорқытқан хат болды.
Dialogue: 0,0:54:35.89,0:54:39.15,Default,,0,0,0,,Күтілгендей, Прамьяның мақсаты - Муранака мырза мен ханым.
Dialogue: 0,0:54:39.23,0:54:42.57,Default,,0,0,0,,Дегенмен, шетелдіктердің жанып жатқан өлімі және Чибадағы ұрлау
Dialogue: 0,0:54:42.65,0:54:45.44,Default,,0,0,0,,Мен оның қалай қатысатынын әлі білмеймін.
Dialogue: 0,0:54:45.53,0:54:46.99,Default,,0,0,0,,Және Прамья
Dialogue: 0,0:54:47.07,0:54:50.16,Default,,0,0,0,,Мен тіпті Фуруя деген адамның қайда екенін білемін.
Dialogue: 0,0:54:50.24,0:54:54.16,Default,,0,0,0,,Детектив Мацуданың қызметтік міндетін атқару кезінде қайтыс болғанынан хабардар екеніңізге сенімдімін...
Dialogue: 0,0:54:54.24,0:54:59.54,Default,,0,0,0,,Ей, Фуруяның төрт замандасы дүниеден өтті ғой?
Dialogue: 0,0:54:59.62,0:55:03.42,Default,,0,0,0,,Жарылғыш заттарды залалсыздандыру отрядының детективі Мацуда мен Хагивара
Dialogue: 0,0:55:03.50,0:55:04.67,Default,,0,0,0,,Бомбаны залалсыздандыру кезінде
Dialogue: 0,0:55:04.75,0:55:06.92,Default,,0,0,0,,Детектив Дата жол-көлік оқиғасына ұшырады.
Dialogue: 0,0:55:07.01,0:55:09.38,Default,,0,0,0,,Моробуси қандай болды?
Dialogue: 0,0:55:09.47,0:55:10.43,Default,,0,0,0,,Моробуши?
Dialogue: 0,0:55:10.51,0:55:13.81,Default,,0,0,0,,Кешіріңіз, бірақ бұл өте құпия.
Dialogue: 0,0:55:13.89,0:55:15.56,Default,,0,0,0,,Сіз бұрынғыдай құпиясыз.
Dialogue: 0,0:55:15.64,0:55:19.56,Default,,0,0,0,,Мен мынаны ғана айта аламын: Оның бұл оқиғаға еш қатысы жоқ.
Dialogue: 0,0:55:19.64,0:55:21.27,Default,,0,0,0,,Менің сенгенімді қалайсың ба?
Dialogue: 0,0:55:21.35,0:55:24.94,Default,,0,0,0,,Күте тұрыңыз, Чиба-кунды құтқару дәл қазір басты міндет.
Dialogue: 0,0:55:25.03,0:55:29.45,Default,,0,0,0,,Такаги-кун, мына бомбаны қалай бөлшектеу керектігін есіңе түсір.
Dialogue: 0,0:55:29.53,0:55:30.95,Default,,0,0,0,,Сіз оны талдап жатырсыз ба?
Dialogue: 0,0:55:31.03,0:55:32.57,Default,,0,0,0,,Материалдарды дереу дайындаңыз
Dialogue: 0,0:55:32.66,0:55:35.08,Default,,0,0,0,,Мен... түсінемін.
Dialogue: 0,0:55:35.16,0:55:37.08,Default,,0,0,0,,Мен айтқым келеді...
Dialogue: 0,0:55:37.16,0:55:40.46,Default,,0,0,0,,Негізі мен ғылымда да, инженерияда да жақсы емеспін.
Dialogue: 0,0:55:40.54,0:55:42.88,Default,,0,0,0,,Оның үстіне мен ебедейсізмін.
Dialogue: 0,0:55:42.96,0:55:45.88,Default,,0,0,0,,Сондықтан мен Мацуда-кун боламын деп жиі ойлайтынмын...
Dialogue: 0,0:55:45.96,0:55:48.38,Default,,0,0,0,,Мм... әсіресе Мацуда мырза.
Dialogue: 0,0:55:48.47,0:55:50.38,Default,,0,0,0,,Ол қандай болды?
Dialogue: 0,0:55:50.47,0:55:53.68,Default,,0,0,0,,Хмм... жабайы, бірақ таңқаларлық мейірімді.
Dialogue: 0,0:55:53.76,0:55:55.56,Default,,0,0,0,,Шиба Ину мен Доберманды қосу
Dialogue: 0,0:55:55.64,0:55:57.06,Default,,0,0,0,,Менің ойымша, бұл 2-ге бөлінген сияқты.
Dialogue: 0,0:55:57.14,0:55:57.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:58.06,0:55:58.77,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:55:58.77,0:55:59.60,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:55:58.77,0:55:59.60,Default,,0,0,0,,Ах
Dialogue: 0,0:55:59.60,0:56:02.48,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:56:02.48,0:56:03.56,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:56:02.48,0:56:03.56,Default,,0,0,0,,Иә
Dialogue: 0,0:56:03.56,0:56:04.15,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:56:04.77,0:56:05.77,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:56:05.86,0:56:06.86,Default,,0,0,0,,Мацуда ауыстырылды
Dialogue: 0,0:56:06.94,0:56:10.03,Default,,0,0,0,,Бұған дейін дауысыңызды естуге рұқсат ете аласыз ба, Чиба-кун?
Dialogue: 0,0:56:10.11,0:56:11.91,Default,,0,0,0,,Мацуданың орнына бірінші
Dialogue: 0,0:56:11.99,0:56:15.99,Default,,0,0,0,,Егер сіз әбігерге түссеңіз, бұл детективтің даусын ешқашан ести алмайсыз.
Dialogue: 0,0:56:17.83,0:56:19.08,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:56:19.16,0:56:21.62,Default,,0,0,0,,Бұдан былай мен сенен айтқанымды орындауды сұраймын.
Dialogue: 0,0:56:21.71,0:56:25.59,Default,,0,0,0,,Бірден MIYASHITA PARK алдына барыңыз және қайта қоңырау шалыңыз.
Dialogue: 0,0:56:25.67,0:56:26.88,Default,,0,0,0,,(Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,0:56:27.50,0:56:28.96,Default,,0,0,0,,Кеттік
Dialogue: 0,0:56:29.05,0:56:31.63,Default,,0,0,0,,Бетіңіз жарылып кету қаупі бар.
Dialogue: 0,0:56:31.72,0:56:34.89,Default,,0,0,0,,Біз ізімізден өту үшін қоғамдық қауіпсіздік тергеушілерін пайдаланамыз.
Dialogue: 0,0:56:34.97,0:56:39.89,Default,,0,0,0,,Сержант Такагиден басқалардың барлығы алыстан мониторды тексеруі керек.
Dialogue: 0,0:56:42.98,0:56:44.90,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:56:44.98,0:56:46.73,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:56:52.82,0:56:55.53,Default,,0,0,0,,Сіз қалай ойлайсыз? Күдікті біреу бар ма?
Dialogue: 0,0:56:55.62,0:56:58.16,Default,,0,0,0,,Жоқ, әзірше ештеңе жоқ.
Dialogue: 0,0:56:58.24,0:56:59.91,Default,,0,0,0,,Сақ бол.
Dialogue: 0,0:56:59.99,0:57:02.41,Default,,0,0,0,,Мен ол кісінің кім екенін, қанша адам екенін білмеймін.
Dialogue: 0,0:57:02.50,0:57:04.17,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:57:04.25,0:57:06.42,Default,,0,0,0,,Трик немесе Treat
Dialogue: 0,0:57:06.50,0:57:08.67,Default,,0,0,0,,Трик немесе Treat
Dialogue: 0,0:57:08.75,0:57:10.92,Default,,0,0,0,,Трик немесе Treat
Dialogue: 0,0:57:11.01,0:57:13.30,Default,,0,0,0,,Трик немесе Treat
Dialogue: 0,0:57:13.38,0:57:17.97,Default,,0,0,0,,Трик немесе трюк
Dialogue: 0,0:57:18.05,0:57:19.18,Default,,0,0,0,,Не?
Dialogue: 0,0:57:19.26,0:57:20.47,Default,,0,0,0,,Хэллоуин оқиғасы?
Dialogue: 0,0:57:20.56,0:57:24.35,Default,,0,0,0,,Алдау немесе емдеу!
Dialogue: 0,0:57:24.44,0:57:25.60,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:57:25.69,0:57:27.44,Default,,0,0,0,,Уау, тәттілер.
Dialogue: 0,0:57:27.52,0:57:28.48,Default,,0,0,0,,Маған беріңіз
Dialogue: 0,0:57:28.57,0:57:30.53,Default,,0,0,0,,Ах, бұл жаңа өнім.
Dialogue: 0,0:57:30.61,0:57:31.65,Default,,0,0,0,,Мен оны тегін ала аламын ба?
Dialogue: 0,0:57:33.74,0:57:35.41,Default,,0,0,0,,Бұл Хэллоуин оқиғасы ма?
Dialogue: 0,0:57:35.49,0:57:36.32,Default,,0,0,0,,Сіз тыңдамайсыз!
Dialogue: 0,0:57:36.41,0:57:37.53,Default,,0,0,0,,Тезірек тоқтатыңыз!
Dialogue: 0,0:57:37.62,0:57:39.45,Default,,0,0,0,,Көп нәрсе құлап жатыр
Dialogue: 0,0:57:39.53,0:57:40.45,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,0:57:40.54,0:57:42.20,Default,,0,0,0,,Дәмді~
Dialogue: 0,0:57:43.54,0:57:44.37,Default,,0,0,0,,Ха…
Dialogue: 0,0:57:45.83,0:57:47.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:49.75,0:57:50.59,Default,,0,0,0,,Ах
Dialogue: 0,0:57:50.67,0:57:52.42,Default,,0,0,0,,Сіз не істеп жатырсыз? Тез өт!
Dialogue: 0,0:57:52.51,0:57:54.92,Default,,0,0,0,,Бұл... тым көп адам.
Dialogue: 0,0:57:55.01,0:57:57.05,Default,,0,0,0,,Асығыңыз! Мен сені жоғалтамын!
Dialogue: 0,0:57:58.51,0:57:59.43,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:58:00.35,0:58:01.18,Default,,0,0,0,,Ах
Dialogue: 0,0:58:11.19,0:58:14.57,Default,,0,0,0,,Сонымен, сіз шараға көмектесу үшін толық емес жұмыс күнімен жұмыс істеуге дайынсыз ба деп ойладым.
Dialogue: 0,0:58:14.65,0:58:19.03,Default,,0,0,0,,Иә, мен біраз ақша табамын, сондықтан менімен біраз уақыт қызметтес болыңыз.
Dialogue: 0,0:58:19.12,0:58:20.83,Default,,0,0,0,,Лейтенант Сато
Dialogue: 0,0:58:21.58,0:58:22.70,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:58:22.79,0:58:25.33,Default,,0,0,0,,Оны сержант Такаги киген.
Dialogue: 0,0:58:25.91,0:58:26.87,Default,,0,0,0,,Ах
Dialogue: 0,0:58:29.38,0:58:32.00,Default,,0,0,0,,Иісті бақылау үшін полиция итін әкеліңіз.
Dialogue: 0,0:58:32.63,0:58:34.46,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:58:34.55,0:58:35.38,Default,,0,0,0,,О
Dialogue: 0,0:58:55.19,0:58:56.40,Default,,0,0,0,,Фу…
Dialogue: 0,0:58:57.61,0:58:59.61,Default,,0,0,0,,Уф (құлаған дыбыс)
Dialogue: 0,0:59:07.46,0:59:08.54,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:59:10.88,0:59:13.42,Default,,0,0,0,,Жер асты су қоймасы... Ах.
Dialogue: 0,0:59:18.01,0:59:19.34,Default,,0,0,0,,Бас киіміңізді шешіңіз
Dialogue: 0,0:59:20.72,0:59:21.84,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:59:21.93,0:59:24.31,Default,,0,0,0,,Қандай Хэллоуин!
Dialogue: 0,0:59:25.14,0:59:27.85,Default,,0,0,0,,Шиба Ину және Доберман Шиба Ину және Доберман
Dialogue: 0,0:59:27.93,0:59:29.85,Default,,0,0,0,,Детектив Мацуда.
Dialogue: 0,0:59:29.94,0:59:32.36,Default,,0,0,0,,- (Такаги) Чибаның аман-есен екеніне көз жеткізейін... - Мұнда кел.
Dialogue: 0,0:59:35.23,0:59:36.36,Default,,0,0,0,,Уф
Dialogue: 0,0:59:36.44,0:59:39.78,Default,,0,0,0,,Сізді наркоз немесе бір нәрсе ұйықтатып жатыр ма?
Dialogue: 0,0:59:39.86,0:59:41.74,Default,,0,0,0,,Уф... Жарайды, түсіндім.
Dialogue: 0,0:59:42.41,0:59:43.99,Default,,0,0,0,,Жарайды, мен сенен бірнәрсе сұрайын.
Dialogue: 0,0:59:44.08,0:59:47.41,Default,,0,0,0,,Неге мені бұлай атадың?
Dialogue: 0,0:59:47.50,0:59:49.29,Default,,0,0,0,,Қатал әрекет еткеніме менің кінәм болды.
Dialogue: 0,0:59:49.37,0:59:50.25,Default,,0,0,0,,Кешірім сұрау
Dialogue: 0,0:59:50.33,0:59:54.00,Default,,0,0,0,,Хаддеканы ұрлады деп қай ауыз айтар екенін білмеймін.
Dialogue: 0,0:59:54.09,0:59:57.26,Default,,0,0,0,,Детектив Мацуда, мен сенен түсінуіңді сұрамаймын.
Dialogue: 0,0:59:57.34,1:00:01.01,Default,,0,0,0,,Бірақ бізде осы ғана қалды.
Dialogue: 0,1:00:02.80,1:00:05.93,Default,,0,0,0,,(орыс)
Dialogue: 0,1:00:07.93,1:00:10.85,Default,,0,0,0,,Мен Еленика Лаврентьевамын
Dialogue: 0,1:00:10.94,1:00:14.36,Default,,0,0,0,,Прамядан кейін Ресейден Жапонияға келді
Dialogue: 0,1:00:21.65,1:00:22.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:00:22.57,1:00:27.49,Default,,0,0,0,,Осылай алысқа барса, сенің айтқаныңды тыңдамасқа амалым жоқ.
Dialogue: 0,1:00:28.54,1:00:29.75,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,1:00:30.50,1:00:32.37,Default,,0,0,0,,Көп адам жиналды
Dialogue: 0,1:00:32.46,1:00:34.00,Default,,0,0,0,,Тәттілердің иісі мені мазалайды...
Dialogue: 0,1:00:34.08,1:00:35.92,Default,,0,0,0,,Біз мүмкіндігінше тезірек жетуіміз керек.
Dialogue: 0,1:00:35.92,1:00:37.25,Default,,0,0,0,,Біз мүмкіндігінше тезірек жетуіміз керек.
Dialogue: 0,1:00:35.92,1:00:37.25,Default,,0,0,0,,Ах
Dialogue: 0,1:00:37.34,1:00:39.17,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,1:00:39.26,1:00:41.51,Default,,0,0,0,,Мен орынды таптым. Бұл жер астындағы су қоймасы.
Dialogue: 0,1:00:41.59,1:00:42.76,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,1:00:42.84,1:00:44.68,Default,,0,0,0,,Дерек көзі белгісіз.
Dialogue: 0,1:00:44.76,1:00:47.68,Default,,0,0,0,,Кенет бақылау экранында бейнелер пайда болды.
Dialogue: 0,1:00:47.76,1:00:50.43,Default,,0,0,0,,Прамя арнайы сұйық мылтықты пайдаланады.
Dialogue: 0,1:00:50.52,1:00:52.19,Default,,0,0,0,,Ол қорқынышты террорист.
Dialogue: 0,1:00:52.27,1:00:55.90,Default,,0,0,0,,Оның қолынан көптеген адамдар қаза тапты.
Dialogue: 0,1:00:56.56,1:00:59.44,Default,,0,0,0,,Менің отбасымды да ол өлтірді.
Dialogue: 0,1:01:00.19,1:01:03.45,Default,,0,0,0,,Мұндағылардың бәрі сол бомбадан қаза тапты.
Dialogue: 0,1:01:03.53,1:01:06.20,Default,,0,0,0,,Отбасы мен жақындары қаза тапқандар.
Dialogue: 0,1:01:06.78,1:01:09.70,Default,,0,0,0,,Прамьядан кек алуға ант берді.
Dialogue: 0,1:01:09.79,1:01:12.21,Default,,0,0,0,,Біз бірге тұрған жолдастармыз.
Dialogue: 0,1:01:16.54,1:01:18.42,Default,,0,0,0,,(Григоридің орысшасы)
Dialogue: 0,1:01:25.97,1:01:29.89,Default,,0,0,0,,Біз Прамьяны өз бетінше бақылап жатырмыз.
Dialogue: 0,1:01:29.97,1:01:31.97,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,1:01:32.06,1:01:33.89,Default,,0,0,0,,Олар бейбіт тұрғындар тобы
Dialogue: 0,1:01:34.48,1:01:37.11,Default,,0,0,0,,Сондықтан қолжетімді ақпарат шектеулі.
Dialogue: 0,1:01:37.19,1:01:39.40,Default,,0,0,0,,Мен детектив Мацуданың қызметтік міндетін орындау кезінде қайтыс болғанын білмедім.
Dialogue: 0,1:01:39.48,1:01:41.44,Default,,0,0,0,,Мен жағдайды түсінемін.
Dialogue: 0,1:01:41.53,1:01:43.40,Default,,0,0,0,,...Ал сен менің не істегенімді қалайсың?
Dialogue: 0,1:01:43.49,1:01:47.49,Default,,0,0,0,,Мен Прамья жасаған бомба туралы білгім келеді.
Dialogue: 0,1:01:47.57,1:01:49.08,Default,,0,0,0,,Сіз 3 жыл бұрын
Dialogue: 0,1:01:49.16,1:01:51.66,Default,,0,0,0,,Ғимаратта орнатылған бомбаны залалсыздандыру.
Dialogue: 0,1:01:51.74,1:01:55.42,Default,,0,0,0,,Сол бомбаның құрылымын айтып берулеріңізді сұраймын.
Dialogue: 0,1:01:55.50,1:01:56.42,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:01:56.50,1:01:57.83,Default,,0,0,0,,Сипаттамаларды түсінсеңіз
Dialogue: 0,1:01:57.92,1:02:01.05,Default,,0,0,0,,Қай жерге отырғызатынын алдын ала болжай алады
Dialogue: 0,1:02:01.13,1:02:04.17,Default,,0,0,0,,Сонда біз оны ұстап алармыз.
Dialogue: 0,1:02:06.05,1:02:08.55,Default,,0,0,0,,Сіз полициямен ынтымақтасуды жоспарламайсыз ба?
Dialogue: 0,1:02:08.64,1:02:10.93,Default,,0,0,0,,Полицияға сенуге болмайды
Dialogue: 0,1:02:11.01,1:02:12.14,Default,,0,0,0,,Хмм
Dialogue: 0,1:02:12.93,1:02:15.48,Default,,0,0,0,,Елордалық полиция басқармасының алдында қайтыс болған шетелдік
Dialogue: 0,1:02:15.56,1:02:18.06,Default,,0,0,0,,Ол да сенің достарыңның бірі ме?
Dialogue: 0,1:02:18.90,1:02:21.07,Default,,0,0,0,,Ол менің ағам Олег.
Dialogue: 0,1:02:21.15,1:02:22.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:22.15,1:02:24.32,Default,,0,0,0,,Прамьяның бір ережесі бар.
Dialogue: 0,1:02:24.40,1:02:28.61,Default,,0,0,0,,Жарылыс жасамас бұрын дайындық үшін пайдаланылған жасырынған жерді өртеу.
Dialogue: 0,1:02:28.70,1:02:30.32,Default,,0,0,0,,Дәлелдемелерді жою
Dialogue: 0,1:02:30.41,1:02:33.58,Default,,0,0,0,,Осыдан бірнеше ай бұрын ағам жасырынған жерді тапты.
Dialogue: 0,1:02:34.41,1:02:36.08,Default,,0,0,0,,Мен жалғыз бардым
Dialogue: 0,1:02:36.16,1:02:37.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:39.17,1:02:42.34,Default,,0,0,0,,Менің ағам планшетті өзімен бірге ала алды.
Dialogue: 0,1:02:39.17,1:02:42.34,Default,,0,0,0,,Хаха...
Dialogue: 0,1:02:43.13,1:02:46.22,Default,,0,0,0,,Бомбаның сызбасына ұқсайтын бірдеңе болды.
Dialogue: 0,1:02:46.30,1:02:49.59,Default,,0,0,0,,Токиоға қатысты бірдеңе көрсетілсе керек.
Dialogue: 0,1:02:49.68,1:02:52.10,Default,,0,0,0,,Бірақ экран бірнеше секундтан кейін жоғалып кетті.
Dialogue: 0,1:02:52.18,1:02:55.35,Default,,0,0,0,,Ол содан бері жауап беруді мүлдем тоқтатқанын айтты.
Dialogue: 0,1:02:56.14,1:02:59.85,Default,,0,0,0,,Сондықтан Токиодағы адамдардан Токио туралы сұраған дұрыс деп ойлаймын.
Dialogue: 0,1:02:59.94,1:03:02.36,Default,,0,0,0,,Мен елордалық полиция бөліміне бардым.
Dialogue: 0,1:03:02.44,1:03:04.03,Default,,0,0,0,,Сонымен, планшет
Dialogue: 0,1:03:04.11,1:03:05.61,Default,,0,0,0,,Аздап күйіп қалды ма?
Dialogue: 0,1:03:06.28,1:03:10.36,Default,,0,0,0,,Бірақ оны өлтірген бомба сол планшетке орнатылған.
Dialogue: 0,1:03:10.45,1:03:15.37,Default,,0,0,0,,Басқаша айтқанда, бұл ұрлауға арналған тұзақ болды.
Dialogue: 0,1:03:15.45,1:03:17.46,Default,,0,0,0,,Мен жағдайды түсінемін.
Dialogue: 0,1:03:17.54,1:03:21.33,Default,,0,0,0,,Бірақ сенің ағаң да осыдан үш жыл бұрын оқиға орнында болған.
Dialogue: 0,1:03:21.42,1:03:23.13,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:03:23.21,1:03:25.88,Default,,0,0,0,,Бұл біз жасаған стратегия болды.
Dialogue: 0,1:03:26.46,1:03:28.38,Default,,0,0,0,,Прамьядан ғимаратты жаруды сұраңыз.
Dialogue: 0,1:03:28.47,1:03:31.64,Default,,0,0,0,,Мен оны оқиға орнында ұстауды ойладым.
Dialogue: 0,1:03:31.72,1:03:34.68,Default,,0,0,0,,Бірақ мен сәтсіздікке ұшырадым және қашып кеттім.
Dialogue: 0,1:03:34.76,1:03:38.18,Default,,0,0,0,,Сонда біз олардың бөксесін сүртуге мәжбүр болдық па?
Dialogue: 0,1:03:38.27,1:03:40.14,Default,,0,0,0,,Ағам үнемі айтатын
Dialogue: 0,1:03:40.23,1:03:43.19,Default,,0,0,0,,«Мен Мацуда есімді детективпен тағы кездескім келеді».
Dialogue: 0,1:03:43.27,1:03:47.40,Default,,0,0,0,,«Ол Прамьяның бомбасын тоқтатты, біз мұны істей алмадық».
Dialogue: 0,1:03:47.49,1:03:50.45,Default,,0,0,0,,Сонымен, біз сізді зерттедік.
Dialogue: 0,1:03:50.53,1:03:54.24,Default,,0,0,0,,Адамның бетінің ескі фотосуреті сияқты шағын ақпарат алды.
Dialogue: 0,1:03:54.33,1:03:57.04,Default,,0,0,0,,Мен сені осында шақырдым.
Dialogue: 0,1:03:57.12,1:03:58.54,Default,,0,0,0,,Бұл құрмет.
Dialogue: 0,1:03:59.58,1:04:02.79,Default,,0,0,0,,Мен үшін өмірімнен де қымбат болған отбасым өлтірілді.
Dialogue: 0,1:04:03.46,1:04:04.71,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,1:04:06.00,1:04:08.46,Default,,0,0,0,,Осымен әңгіме аяқталды. Тез сызып алайық.
Dialogue: 0,1:04:10.09,1:04:12.09,Default,,0,0,0,,- (Такаги) Мен оны тартқым келмейді - Әй...
Dialogue: 0,1:04:12.18,1:04:15.85,Default,,0,0,0,,Мен сіздің жеке кекіңізбен айналысқым келмейді.
Dialogue: 0,1:04:21.52,1:04:24.81,Default,,0,0,0,,Детектив Мацуда Сіздің таңдауыңыз жоқ.
Dialogue: 0,1:04:24.90,1:04:27.44,Default,,0,0,0,,Детектив Чибаға не болғаны маңызды ма?
Dialogue: 0,1:04:27.53,1:04:30.36,Default,,0,0,0,,Мен саған ауыр жүк екеніңді айтып тұрмын.
Dialogue: 0,1:04:30.44,1:04:31.03,Default,,0,0,0,,Уф...
Dialogue: 0,1:04:31.03,1:04:31.95,Default,,0,0,0,,Уф...
Dialogue: 0,1:04:31.03,1:04:31.95,Default,,0,0,0,,Мен сенің оны ұстап, жазалауыңды қадағалаймын.
Dialogue: 0,1:04:31.95,1:04:33.61,Default,,0,0,0,,Мен сенің оны ұстап, жазалауыңды қадағалаймын.
Dialogue: 0,1:04:33.61,1:04:34.53,Default,,0,0,0,,Мен сенің оны ұстап, жазалауыңды қадағалаймын.
Dialogue: 0,1:04:33.61,1:04:34.53,Default,,0,0,0,,Әй?
Dialogue: 0,1:04:34.62,1:04:37.20,Default,,0,0,0,,Мен саған полицияға қалдыр дедім!
Dialogue: 0,1:04:38.83,1:04:41.08,Default,,0,0,0,,Ал... Мацуда мырза?
Dialogue: 0,1:04:41.16,1:04:42.92,Default,,0,0,0,,Өтірік! Мен өлдім бе?
Dialogue: 0,1:04:43.00,1:04:43.92,Default,,0,0,0,,Өлді ме?
Dialogue: 0,1:04:44.00,1:04:46.38,Default,,0,0,0,,Әй, өйткені Мацуда мырза баяғыда қызмет бабында қайтыс болды...
Dialogue: 0,1:04:46.46,1:04:49.38,Default,,0,0,0,,Идиот! Чиба... аааа
Dialogue: 0,1:04:54.47,1:04:56.47,Default,,0,0,0,,Полиция! Барлығы, ол жаққа көшпеңдер!
Dialogue: 0,1:04:56.55,1:04:57.64,Default,,0,0,0,,Тс!
Dialogue: 0,1:04:59.93,1:05:01.77,Default,,0,0,0,,- (Дмитрий) Уф - Ха...
Dialogue: 0,1:05:01.85,1:05:04.02,Default,,0,0,0,,Неліктен бұлай қалдырмасқа?
Dialogue: 0,1:05:04.10,1:05:08.27,Default,,0,0,0,,Ұрысқандардың барлығынан көп пайда көретін адам - ​​Прамья.
Dialogue: 0,1:05:08.36,1:05:10.03,Default,,0,0,0,,-Ах-(Сато) Конан-кун
Dialogue: 0,1:05:10.11,1:05:12.53,Default,,0,0,0,,Сонымен, бұрынғы бейнеде сіз десіз бе?
Dialogue: 0,1:05:19.58,1:05:20.41,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:05:21.87,1:05:24.08,Default,,0,0,0,,Бұл балаларға арналған орын емес.
Dialogue: 0,1:05:24.17,1:05:25.25,Default,,0,0,0,,Хмм
Dialogue: 0,1:05:30.80,1:05:31.63,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:05:31.71,1:05:32.55,Default,,0,0,0,,- (Қоғамдық қауіпсіздік) Бұл не? - (Казами) Не?
Dialogue: 0,1:05:32.63,1:05:34.34,Default,,0,0,0,,Жарықты қазір дайындаңыз!
Dialogue: 0,1:05:34.43,1:05:35.43,Default,,0,0,0,,(Амон) Нагачика? (Хайд) Ах, Амон-сан.
Dialogue: 0,1:05:35.51,1:05:38.05,Default,,0,0,0,,- (Детектив) Жоғары! Мен жоғарыға шықтым! - (Детектив) Мені қу!
Dialogue: 0,1:05:41.18,1:05:42.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:05:43.43,1:05:47.23,Default,,0,0,0,,(орысша Еленика)
Dialogue: 0,1:05:47.69,1:05:48.52,Default,,0,0,0,,Ха…
Dialogue: 0,1:05:49.19,1:05:51.28,Default,,0,0,0,,- (Детектив) Қуат көзін табыңыз! - (Детектив) Тезірек!
Dialogue: 0,1:05:51.36,1:05:53.94,Default,,0,0,0,,- (Детектив) Кепілдегілер аман ба? - (Детектив) Эй!
Dialogue: 0,1:05:55.78,1:05:57.62,Default,,0,0,0,,Міне
Dialogue: 0,1:05:57.70,1:05:59.74,Default,,0,0,0,,Такаги-кун! Сенімен бәрі жақсы ма?
Dialogue: 0,1:05:59.83,1:06:02.75,Default,,0,0,0,,Уф... иә, қалай болғанда да
Dialogue: 0,1:06:02.83,1:06:07.38,Default,,0,0,0,,Жарты жолға дейін мен бұл Макадами сыйлығын алған спектакль деп ойладым.
Dialogue: 0,1:06:07.46,1:06:09.50,Default,,0,0,0,,Соңында...
Dialogue: 0,1:06:10.00,1:06:11.88,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:06:11.96,1:06:13.38,Default,,0,0,0,,Хмм...
Dialogue: 0,1:06:14.22,1:06:15.88,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:06:15.97,1:06:17.89,Default,,0,0,0,,Рахмет
Dialogue: 0,1:06:17.97,1:06:21.39,Default,,0,0,0,,(орысша Еленика)
Dialogue: 0,1:06:22.14,1:06:23.64,Default,,0,0,0,,Ұлы…
Dialogue: 0,1:06:26.48,1:06:28.40,Default,,0,0,0,,Ах... аха...
Dialogue: 0,1:06:29.65,1:06:32.40,Default,,0,0,0,,Мен уайымдадым!
Dialogue: 0,1:06:32.48,1:06:33.07,Default,,0,0,0,,Не... күте тұрыңыз... Наэко-чан
Dialogue: 0,1:06:33.07,1:06:34.69,Default,,0,0,0,,Не... күте тұрыңыз... Наэко-чан
Dialogue: 0,1:06:33.07,1:06:34.69,Default,,0,0,0,,(Микенің айқайы)
Dialogue: 0,1:06:34.69,1:06:34.78,Default,,0,0,0,,(Микенің айқайы)
Dialogue: 0,1:06:34.78,1:06:36.49,Default,,0,0,0,,(Микенің айқайы)
Dialogue: 0,1:06:34.78,1:06:36.49,Default,,0,0,0,,Өйткені мен жақсымын... Ах...
Dialogue: 0,1:06:36.49,1:06:36.57,Default,,0,0,0,,(Мике жылайды)
Dialogue: 0,1:06:36.57,1:06:37.99,Default,,0,0,0,,(Мике жылайды)
Dialogue: 0,1:06:36.57,1:06:37.99,Default,,0,0,0,,(флюгер)
Dialogue: 0,1:06:37.99,1:06:38.07,Default,,0,0,0,,(Мике жылайды)
Dialogue: 0,1:06:38.07,1:06:40.03,Default,,0,0,0,,(Микенің айқайы)
Dialogue: 0,1:06:38.07,1:06:40.03,Default,,0,0,0,,Не... Мен бір нәрсеге өкінемін.
Dialogue: 0,1:06:40.03,1:06:40.62,Default,,0,0,0,,Не... Кешіріңіз.
Dialogue: 0,1:06:40.70,1:06:41.91,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:06:42.66,1:06:45.50,Default,,0,0,0,,Сонымен қашып кеткен топқа не болды?
Dialogue: 0,1:06:45.58,1:06:47.25,Default,,0,0,0,,Мен оны қууға бар күшімді салып жатырмын, бірақ...
Dialogue: 0,1:06:48.50,1:06:52.00,Default,,0,0,0,,Рәсімнен бас тартайық. Әр адамның қауіпсіздігі бірінші орында.
Dialogue: 0,1:06:52.09,1:06:56.26,Default,,0,0,0,,Бірақ Прамя міндетті түрде сенің соңынан ереді.
Dialogue: 0,1:06:56.34,1:06:57.38,Default,,0,0,0,,Бұдан былай екеуінің қауіпсіздігін қамтамасыз етеміз.
Dialogue: 0,1:06:57.38,1:06:58.51,Default,,0,0,0,,Бұдан былай екеуінің қауіпсіздігін қамтамасыз етеміз.
Dialogue: 0,1:06:57.38,1:06:58.51,Default,,0,0,0,,А…?
Dialogue: 0,1:06:58.59,1:07:00.01,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,1:07:00.09,1:07:01.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:01.76,1:07:04.22,Default,,0,0,0,,Сіз, бұл хабар
Dialogue: 0,1:07:04.31,1:07:05.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:10.35,1:07:11.40,Default,,0,0,0,,А…?
Dialogue: 0,1:07:11.48,1:07:14.15,Default,,0,0,0,,«Құрбандар көбірек болады».
Dialogue: 0,1:07:14.23,1:07:16.69,Default,,0,0,0,,- (Барлығы) Не? - (Мегур) Не?
Dialogue: 0,1:07:18.36,1:07:20.78,Default,,0,0,0,,Той жасаймыз ғой, солай ма?
Dialogue: 0,1:07:20.87,1:07:23.33,Default,,0,0,0,,Иә, енді мұны істеуден басқа амалым жоқ.
Dialogue: 0,1:07:23.41,1:07:26.41,Default,,0,0,0,,Бірақ мен Прамьяға өзіне ұнайтын нәрсені істеуге рұқсат бермеймін.
Dialogue: 0,1:07:26.50,1:07:27.83,Default,,0,0,0,,Мен сені міндетті түрде ұстаймын.
Dialogue: 0,1:07:27.91,1:07:31.08,Default,,0,0,0,,Неліктен? Прамя неге бұлай жасады?
Dialogue: 0,1:07:31.17,1:07:34.38,Default,,0,0,0,,Мұранака мырзаның тойы өтпей қалса да.
Dialogue: 0,1:07:34.46,1:07:36.84,Default,,0,0,0,,Тек басқа жерге көздеңіз.
Dialogue: 0,1:07:36.92,1:07:39.59,Default,,0,0,0,,Неліктен үйлену тойына мән бересің?
Dialogue: 0,1:07:40.38,1:07:42.76,Default,,0,0,0,,Не болды? Конан-кун, сен қорқынышты көрінесің.
Dialogue: 0,1:07:42.85,1:07:43.55,Default,,0,0,0,,А... бұл ештеңе емес.
Dialogue: 0,1:07:43.55,1:07:44.56,Default,,0,0,0,,А... бұл ештеңе емес.
Dialogue: 0,1:07:43.55,1:07:44.56,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:07:44.56,1:07:44.64,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:07:44.64,1:07:47.98,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:07:44.64,1:07:47.98,Default,,0,0,0,,Аа... мен телефондамын. Мен үйге барамын.
Dialogue: 0,1:07:47.98,1:07:48.06,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:07:48.06,1:07:49.19,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:07:48.06,1:07:49.19,Default,,0,0,0,,Үйге қайтқанда абай болыңыз.
Dialogue: 0,1:07:49.19,1:07:49.27,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:07:49.27,1:07:50.10,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:07:49.27,1:07:50.10,Default,,0,0,0,,Иә
Dialogue: 0,1:07:51.81,1:07:54.48,Default,,0,0,0,,Мен сенен хабарласады деп ойламадым.
Dialogue: 0,1:07:54.57,1:07:57.36,Default,,0,0,0,,Мен сізге тезірек айтқым келеді.
Dialogue: 0,1:07:57.44,1:08:00.86,Default,,0,0,0,,Мен Прамьяны қуып келе жатқан ұйым туралы ақпарат таптым.
Dialogue: 0,1:08:01.49,1:08:04.20,Default,,0,0,0,,Ұйымның атауы – «Нада Юнититожити»
Dialogue: 0,1:08:04.28,1:08:07.20,Default,,0,0,0,,Ресейден Еуропаға дейін желісі бар
Dialogue: 0,1:08:07.29,1:08:09.75,Default,,0,0,0,,Олар Прамьяны өз бетімен аңдып жүрген сияқты.
Dialogue: 0,1:08:09.83,1:08:11.96,Default,,0,0,0,,Нада Юничитожити…
Dialogue: 0,1:08:12.04,1:08:13.79,Default,,0,0,0,,«Біз тыныс алуды тоқтатуымыз керек».
Dialogue: 0,1:08:13.88,1:08:15.84,Default,,0,0,0,,Прамья өмірінің тамыры...
Dialogue: 0,1:08:15.92,1:08:18.01,Default,,0,0,0,,Жетекші - Еленика есімді әйел.
Dialogue: 0,1:08:18.71,1:08:20.76,Default,,0,0,0,,Бетінде күйік іздері бар.
Dialogue: 0,1:08:20.84,1:08:24.26,Default,,0,0,0,,Прамяға әртүрлі елдердегі полицияның тұрақсыз жауабы
Dialogue: 0,1:08:24.35,1:08:29.27,Default,,0,0,0,,Олар ашуланып, кек алу үшін ұйым құрды.
Dialogue: 0,1:08:29.35,1:08:32.19,Default,,0,0,0,,Алайда, ол жеке ұйым болса да,
Dialogue: 0,1:08:32.27,1:08:34.86,Default,,0,0,0,,Ол Прамья үшін өте жағымсыз қарсылас.
Dialogue: 0,1:08:34.94,1:08:39.28,Default,,0,0,0,,Олар дүниенің түкпір-түкпірінде мені аңдып, жұмысыма кедергі жасайды.
Dialogue: 0,1:08:39.36,1:08:43.11,Default,,0,0,0,,Жапониядағы жарылыс оқиғасы да байланысты болуы мүмкін.
Dialogue: 0,1:08:43.20,1:08:46.24,Default,,0,0,0,,Шетелдіктер көп пәтерлі үйлерде өртеніп, бомбалар жарылды
Dialogue: 0,1:08:46.33,1:08:49.04,Default,,0,0,0,,Ғимараттағы бомба туралы біраз абдырап қалдым.
Dialogue: 0,1:08:49.12,1:08:52.33,Default,,0,0,0,,Мен уақыттық әдістің орнына сымсыз әдісті қолданар едім.
Dialogue: 0,1:08:52.41,1:08:54.29,Default,,0,0,0,,Бұл сенімдірек.
Dialogue: 0,1:08:54.38,1:08:59.13,Default,,0,0,0,,Бұл жолы олар полицияға хабарласу үшін барын салды.
Dialogue: 0,1:08:59.21,1:09:01.55,Default,,0,0,0,,Прамьяның қандай да бір ниеті болуы керек.
Dialogue: 0,1:09:01.63,1:09:06.01,Default,,0,0,0,,Тағы бір нәрсе: Амуро мырзаға не үшін жағалы бомба қойғанын білмеймін.
Dialogue: 0,1:09:06.10,1:09:08.01,Default,,0,0,0,,3 жыл бұрынғы үшін кек алғыңыз келсе
Dialogue: 0,1:09:08.10,1:09:11.10,Default,,0,0,0,,Сіз мені азғырған жерде өлтіруіңіз керек, солай ма?
Dialogue: 0,1:09:11.18,1:09:14.06,Default,,0,0,0,,Мен де бұл туралы ойладым.
Dialogue: 0,1:09:14.14,1:09:16.40,Default,,0,0,0,,Өртену оқиғасының айғақтарының жадынамасын көрдіңіз бе?
Dialogue: 0,1:09:16.48,1:09:17.31,Default,,0,0,0,,О
Dialogue: 0,1:09:17.40,1:09:20.82,Default,,0,0,0,,Мен бұл нені білдіретінін әлі білмеймін.
Dialogue: 0,1:09:20.90,1:09:22.70,Default,,0,0,0,,Бірақ тойға дейін уақыт қалды...
Dialogue: 0,1:09:22.78,1:09:24.95,Default,,0,0,0,,Менің досым айтты
Dialogue: 0,1:09:25.57,1:09:28.45,Default,,0,0,0,,Сабырсыздық - ең үлкен тұзақ
Dialogue: 0,1:09:28.91,1:09:32.45,Default,,0,0,0,,Сіз мұндай дағдарыстарды талай рет еңсердіңіз, солай емес пе?
Dialogue: 0,1:09:33.71,1:09:35.71,Default,,0,0,0,,Сәттілік (ажырасу дыбысы)
Dialogue: 0,1:09:35.79,1:09:36.71,Default,,0,0,0,,Хмм...
Dialogue: 0,1:09:39.04,1:09:40.21,Default,,0,0,0,,Кеш болды.
Dialogue: 0,1:09:40.84,1:09:43.47,Default,,0,0,0,,Мен күткендей, мұнда болудан шаршадым.
Dialogue: 0,1:09:43.55,1:09:46.72,Default,,0,0,0,,Мен мұны сұрадым, Казами.
Dialogue: 0,1:09:47.85,1:09:50.72,Default,,0,0,0,,Ал үйлену күні
Dialogue: 0,1:09:57.06,1:09:59.11,Default,,0,0,0,,Хэллоуин мерекесі құтты болсын!
Dialogue: 0,1:10:09.45,1:10:13.12,Default,,0,0,0,,(Дмитрий орыс)
Dialogue: 0,1:10:25.76,1:10:26.93,Default,,0,0,0,,(орысша Еленика)
Dialogue: 0,1:10:36.81,1:10:41.44,Default,,0,0,0,,Кирилл! Уау...
Dialogue: 0,1:10:45.24,1:10:48.95,Default,,0,0,0,,(Елениканың айқайы)
Dialogue: 0,1:10:51.95,1:10:52.79,Default,,0,0,0,,Уф
Dialogue: 0,1:11:00.75,1:11:02.92,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:03.00,1:11:05.92,Default,,0,0,0,,(Дмитрийдің жөтелі)
Dialogue: 0,1:11:07.76,1:11:10.80,Default,,0,0,0,,Бір қорқынышты нәрсе болды.
Dialogue: 0,1:11:10.89,1:11:12.39,Default,,0,0,0,,Иә...
Dialogue: 0,1:11:12.47,1:11:14.06,Default,,0,0,0,,Той Мұранака мырзамен болды.
Dialogue: 0,1:11:14.14,1:11:16.31,Default,,0,0,0,,Кристин-сан мұны жалғыз жасамақшы.
Dialogue: 0,1:11:16.39,1:11:17.94,Default,,0,0,0,,Мен...
Dialogue: 0,1:11:18.02,1:11:21.31,Default,,0,0,0,,Ерекше той, бірақ сені аяймын.
Dialogue: 0,1:11:21.40,1:11:24.07,Default,,0,0,0,,
Dialogue: 0,1:11:24.15,1:11:26.53,Default,,0,0,0,,Бұл алаңсыз.
Dialogue: 0,1:11:26.61,1:11:28.95,Default,,0,0,0,,Иә? Бұл не меморандум?
Dialogue: 0,1:11:29.03,1:11:33.12,Default,,0,0,0,,Не? О, Токио қалалық полиция департаментінің алдында жарылыс болған кезде.
Dialogue: 0,1:11:33.20,1:11:35.41,Default,,0,0,0,,Алдыма түскен жадыны еске түсіру
Dialogue: 0,1:11:35.49,1:11:36.33,Default,,0,0,0,,Мен аздап жаздым
Dialogue: 0,1:11:36.41,1:11:38.08,Default,,0,0,0,,Ран-ничан, сіз жазбаны көрдіңіз бе?
Dialogue: 0,1:11:38.16,1:11:40.96,Default,,0,0,0,,Көрсем де, бұл жай ғана бір шолақ.
Dialogue: 0,1:11:41.04,1:11:43.84,Default,,0,0,0,,Бұл ағылшынша емес сияқты, сондықтан мен оны түсінбеймін.
Dialogue: 0,1:11:43.92,1:11:46.96,Default,,0,0,0,,Мен әкем оянғанда сұрайын деп ойладым...
Dialogue: 0,1:11:47.51,1:11:51.89,Default,,0,0,0,,Бұл пішін шеңбер белгісі емес еді, бір жерде...
Dialogue: 0,1:11:53.26,1:11:54.10,Default,,0,0,0,,Ах
Dialogue: 0,1:11:54.81,1:11:55.76,Default,,0,0,0,,Уф
Dialogue: 0,1:11:55.85,1:11:56.77,Default,,0,0,0,,Конан-кун?
Dialogue: 0,1:11:57.68,1:11:59.56,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:12:00.14,1:12:01.40,Default,,0,0,0,,Уф
Dialogue: 0,1:12:03.23,1:12:05.94,Default,,0,0,0,,Мұранакаға қорқытқан хат келеді.
Dialogue: 0,1:12:06.03,1:12:10.65,Default,,0,0,0,,«Бұл мен біреуге жеткізгім келетін өте маңызды естелік.»
Dialogue: 0,1:12:11.57,1:12:14.03,Default,,0,0,0,,Мен оны ауруханада кездестірдім.
Dialogue: 0,1:12:14.12,1:12:15.45,Default,,0,0,0,,Иық жарақатымен ауруханаға түскенде
Dialogue: 0,1:12:15.53,1:12:18.04,Default,,0,0,0,,Әй, бұл тағдырлы кездесу болды.
Dialogue: 0,1:12:18.12,1:12:19.46,Default,,0,0,0,,Міне, солай деп ойлаймын.
Dialogue: 0,1:12:19.54,1:12:22.46,Default,,0,0,0,,Бала жәбірленушінің жоғалған затын байқап, оны алады.
Dialogue: 0,1:12:22.54,1:12:24.75,Default,,0,0,0,,Мен оны берейін десем, жалынға оранды.
Dialogue: 0,1:12:24.84,1:12:28.05,Default,,0,0,0,,Менің досым маған бірдеңе бергісі келеді...
Dialogue: 0,1:12:28.13,1:12:30.80,Default,,0,0,0,,Детектив Мацудаға көрсеткіңіз келген хабарлама осы ма?
Dialogue: 0,1:12:30.88,1:12:32.63,Default,,0,0,0,,Конан және басқалары келді
Dialogue: 0,1:12:32.72,1:12:34.93,Default,,0,0,0,,Бұл тіпті Прамья үшін де күтпеген жағдай болды.
Dialogue: 0,1:12:35.01,1:12:36.51,Default,,0,0,0,,Негізінде Муранака мырза мен ханым сонда болды...
Dialogue: 0,1:12:36.60,1:12:38.77,Default,,0,0,0,,Прамьядан кек алуға ант беру
Dialogue: 0,1:12:38.85,1:12:41.02,Default,,0,0,0,,Біз бірге тұрған жолдастармыз.
Dialogue: 0,1:12:41.10,1:12:44.48,Default,,0,0,0,,«Той жоспарланғандай өтуі керек»
Dialogue: 0,1:12:44.56,1:12:46.57,Default,,0,0,0,,«Егер бас тартылса»
Dialogue: 0,1:12:47.82,1:12:51.15,Default,,0,0,0,,«Құрбандар көбірек болады».
Dialogue: 0,1:12:54.20,1:12:57.74,Default,,0,0,0,,Міне... міне, жауап.
Dialogue: 0,1:12:57.83,1:12:59.75,Default,,0,0,0,,Конан-кун! Ах
Dialogue: 0,1:12:59.83,1:13:01.41,Default,,0,0,0,,Не болды? Бірге
Dialogue: 0,1:13:01.50,1:13:02.62,Default,,0,0,0,,-Мынаны қарашы-(Жүгіріп) А?
Dialogue: 0,1:13:02.71,1:13:04.08,Default,,0,0,0,,Хэллоуин күні
Dialogue: 0,1:13:04.17,1:13:05.63,Default,,0,0,0,,Бұл көлік қозғалысы шектелген аймақ.
Dialogue: 0,1:13:05.71,1:13:07.96,Default,,0,0,0,,Догензака астындағы Y-қиылысынан
Dialogue: 0,1:13:08.05,1:13:10.34,Default,,0,0,0,,Жол Миямасузака бағытында созылады, солай ма?
Dialogue: 0,1:13:10.42,1:13:11.26,Default,,0,0,0,,Иә
Dialogue: 0,1:13:11.34,1:13:13.63,Default,,0,0,0,,Алдымен Цзингу көшесі сол жерден қиылысады.
Dialogue: 0,1:13:13.72,1:13:17.43,Default,,0,0,0,,Шибуя станциясындағы күзетшіден өтіп, Мэйдзи Дориді де қиып өтеді.
Dialogue: 0,1:13:17.51,1:13:19.89,Default,,0,0,0,,Осыны 90 градусқа айналдыру
Dialogue: 0,1:13:19.97,1:13:21.98,Default,,0,0,0,,Бұл иендік белгі болады.
Dialogue: 0,1:13:22.06,1:13:23.98,Default,,0,0,0,,Мен көрген күйдірілген жазба
Dialogue: 0,1:13:24.06,1:13:25.94,Default,,0,0,0,,Бұл жердегі желі өртеніп кетті.
Dialogue: 0,1:13:26.02,1:13:28.27,Default,,0,0,0,,Мен оны иен белгісімен қателестім.
Dialogue: 0,1:13:28.36,1:13:31.65,Default,,0,0,0,,Бірақ Муранакалардың үйлену тойын өткізіп жатқан Хикари,
Dialogue: 0,1:13:31.74,1:13:33.03,Default,,0,0,0,,Ол Шибуяда.
Dialogue: 0,1:13:33.11,1:13:36.37,Default,,0,0,0,,Мұндай суретті салудың қажеті жоқ...
Dialogue: 0,1:13:36.45,1:13:38.28,Default,,0,0,0,,Жоқ, бұл жай ғана Хикари емес.
Dialogue: 0,1:13:38.37,1:13:41.29,Default,,0,0,0,,Мүмкін тіпті айнала...
Dialogue: 0,1:13:43.12,1:13:46.08,Default,,0,0,0,,Конан-кун, сен Шиничи сияқты сөздер айтасың.
Dialogue: 0,1:13:46.17,1:13:47.50,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:47.58,1:13:49.63,Default,,0,0,0,,...Шиничи-нии-чан осылай деді.
Dialogue: 0,1:13:49.71,1:13:52.38,Default,,0,0,0,,Оқиға туралы Шиничимен тағы да кеңестіңіз бе?
Dialogue: 0,1:13:52.46,1:13:53.55,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:13:53.63,1:13:56.80,Default,,0,0,0,,Тағы бір жұмбақ шешкенін айтты.
Dialogue: 0,1:13:57.47,1:14:00.35,Default,,0,0,0,,Ғимараттың жарылысы мен ұсталып қала жаздадым
Dialogue: 0,1:14:00.43,1:14:03.43,Default,,0,0,0,,Бұл Мұранака мырзаға бағытталған емес еді.
Dialogue: 0,1:14:03.52,1:14:04.89,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:14:04.98,1:14:07.56,Default,,0,0,0,,Бұл бізді басынан бастап нысанаға алды.
Dialogue: 0,1:14:07.65,1:14:11.19,Default,,0,0,0,,Осы айғақтар меморандумына куә болған кез келген адамды анықтаңыз.
Dialogue: 0,1:14:11.28,1:14:13.24,Default,,0,0,0,,Кінәлі оны өшірмек болды.
Dialogue: 0,1:14:13.32,1:14:15.45,Default,,0,0,0,,Әй, тоқта, неге кінәлі?
Dialogue: 0,1:14:15.53,1:14:18.20,Default,,0,0,0,,Балалардың көп пәтерлі үйге бара жатқанын білесіз бе?
Dialogue: 0,1:14:18.28,1:14:20.74,Default,,0,0,0,,Бомба таймер түрі болды, солай ма?
Dialogue: 0,1:14:20.83,1:14:23.54,Default,,0,0,0,,Мен оны алдын ала орнатқанын естідім.
Dialogue: 0,1:14:24.04,1:14:27.21,Default,,0,0,0,,Барлығын сонда баруға мәжбүрлеген адам жоқ па?
Dialogue: 0,1:14:27.29,1:14:32.05,Default,,0,0,0,,Иә? Мен кездесуім бар дедім...
Dialogue: 0,1:14:32.13,1:14:36.09,Default,,0,0,0,,«Қылмыскер бетін өзгертіп, Жапонияда жасырынып жүр».
Dialogue: 0,1:14:36.18,1:14:38.22,Default,,0,0,0,,Қоғамдық қауіпсіздік детективі осылай деді.
Dialogue: 0,1:14:38.30,1:14:40.26,Default,,0,0,0,,Бұл проблема болар еді.
Dialogue: 0,1:14:40.35,1:14:44.10,Default,,0,0,0,,Осыдан кейін модератормен кездесуім бар...
Dialogue: 0,1:14:44.73,1:14:46.98,Default,,0,0,0,,Сіздің нақты тұлғаңыз Цутому Муранака ма?
Dialogue: 0,1:14:48.02,1:14:51.86,Default,,0,0,0,,Егер сіз зейнеткерлікке шыққан және біраз уақыт зейнеткерлікке шыққан адам болсаңыз,
Dialogue: 0,1:14:51.94,1:14:54.57,Default,,0,0,0,,Орын ауыстыруға мүмкіндік болған шығар, бірақ
Dialogue: 0,1:14:54.65,1:14:56.49,Default,,0,0,0,,Мен бұрынғы полиция қызметкерімін.
Dialogue: 0,1:14:56.57,1:14:59.82,Default,,0,0,0,,Бала жәбірленушінің жоғалған затын байқап, оны алады.
Dialogue: 0,1:14:59.91,1:15:00.74,Default,,0,0,0,,Мен оны саған бергім келеді...
Dialogue: 0,1:15:00.82,1:15:01.95,Default,,0,0,0,,Ха…
Dialogue: 0,1:15:02.03,1:15:04.12,Default,,0,0,0,,Себебі мен сол кезде сөйледім...
Dialogue: 0,1:15:04.70,1:15:08.04,Default,,0,0,0,,Ол кезде Ранни баланың атын атамаған.
Dialogue: 0,1:15:08.12,1:15:11.34,Default,,0,0,0,,Сонымен қай бала көтергенін білмедік.
Dialogue: 0,1:15:11.42,1:15:14.96,Default,,0,0,0,,Осылайша олар барлығын бомбамен өлтірмек болды.
Dialogue: 0,1:15:15.05,1:15:17.30,Default,,0,0,0,,...Бұл Шиничи-нии-чанның теориясы.
Dialogue: 0,1:15:17.38,1:15:18.38,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,1:15:19.01,1:15:20.14,Default,,0,0,0,,Осы хат қана қалды
Dialogue: 0,1:15:20.76,1:15:22.89,Default,,0,0,0,,Бұл ағылшын тілі емес, орыс тілі.
Dialogue: 0,1:15:22.97,1:15:24.31,Default,,0,0,0,,Жоғарыда айтылғандар...
Dialogue: 0,1:15:24.39,1:15:26.89,Default,,0,0,0,,Пуля «оқ» дегенді білдіреді
Dialogue: 0,1:15:26.98,1:15:29.90,Default,,0,0,0,,Төмендегі бұл не? 40 саны...
Dialogue: 0,1:15:29.98,1:15:30.90,Default,,0,0,0,,Ах
Dialogue: 0,1:15:30.98,1:15:34.07,Default,,0,0,0,,Ран-ничан! Мен бұл туралы бәріне хабарлаймын
Dialogue: 0,1:15:34.15,1:15:35.11,Default,,0,0,0,,Сол жігіт осы сапарға қосыла алмайды!
Dialogue: 0,1:15:35.19,1:15:39.11,Default,,0,0,0,,Сонымен, бұл Муранака мырзаның өз өліміне қауіп төндіретінін білдіре ме?
Dialogue: 0,1:15:39.20,1:15:42.62,Default,,0,0,0,,Шиничи не айтты? Конан-кун!
Dialogue: 0,1:15:46.66,1:15:48.12,Default,,0,0,0,,- (Сато) Жақсысың ба? -(Кристина) О.
Dialogue: 0,1:15:48.79,1:15:52.04,Default,,0,0,0,,Шынымды айтсам, қорқамын.
Dialogue: 0,1:15:52.13,1:15:54.17,Default,,0,0,0,,Біз сізді міндетті түрде қорғаймыз.
Dialogue: 0,1:15:54.25,1:15:57.17,Default,,0,0,0,,Сіз Жапонияда екі адамды өлтірдіңіз, солай ма?
Dialogue: 0,1:15:57.26,1:16:00.22,Default,,0,0,0,,Ал бомба сол ғимаратқа қойылған...
Dialogue: 0,1:16:00.30,1:16:04.51,Default,,0,0,0,,Уайымдама, мен саған Прамьяға тиісуге рұқсат бермеймін.
Dialogue: 0,1:16:07.60,1:16:09.18,Default,,0,0,0,,- (Ер) Уау - (Ер) Маған қауіп төніп тұр.
Dialogue: 0,1:16:13.77,1:16:14.94,Default,,0,0,0,,Міне, Шибуяда
Dialogue: 0,1:16:15.02,1:16:17.65,Default,,0,0,0,,Көптеген адамдар биыл тағы да Хэллоуинді тамашалауға жиналып жатыр.
Dialogue: 0,1:16:17.65,1:16:19.49,Default,,0,0,0,,Көптеген адамдар биыл тағы да Хэллоуинді тамашалауға жиналып жатыр.
Dialogue: 0,1:16:17.65,1:16:19.49,Default,,0,0,0,,Хэллоуин болса да
Dialogue: 0,1:16:19.49,1:16:19.57,Default,,0,0,0,,Хэллоуин болса да
Dialogue: 0,1:16:19.57,1:16:19.90,Default,,0,0,0,,Хэллоуин болса да
Dialogue: 0,1:16:19.57,1:16:19.90,Default,,0,0,0,,Барлығы көңілді ме?
Dialogue: 0,1:16:19.90,1:16:19.99,Default,,0,0,0,,Барлығы көңілді ме?
Dialogue: 0,1:16:19.99,1:16:21.20,Default,,0,0,0,,Барлығы көңілді ме?
Dialogue: 0,1:16:19.99,1:16:21.20,Default,,0,0,0,,Дәрігер, сіз қызықсыз.
Dialogue: 0,1:16:21.20,1:16:21.28,Default,,0,0,0,,Дәрігер, сіз қызықсыз.
Dialogue: 0,1:16:21.28,1:16:23.20,Default,,0,0,0,,Дәрігер, сіз қызықсыз.
Dialogue: 0,1:16:21.28,1:16:23.20,Default,,0,0,0,,Иә!
Dialogue: 0,1:16:23.28,1:16:26.70,Default,,0,0,0,,Аю, Аюми де Шибуяға барғысы келді.
Dialogue: 0,1:16:26.79,1:16:28.29,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,1:16:28.37,1:16:30.91,Default,,0,0,0,,Біз ол жаққа жалғыз бара алмаймыз.
Dialogue: 0,1:16:31.00,1:16:34.29,Default,,0,0,0,,Үлкендер онша қарсы емес сияқты.
Dialogue: 0,1:16:34.38,1:16:35.92,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,1:16:36.00,1:16:38.13,Default,,0,0,0,,Джажан! гало гало Хэллоуин
Dialogue: 0,1:16:38.21,1:16:39.97,Default,,0,0,0,,Көңілді викторина
Dialogue: 0,1:16:40.05,1:16:41.47,Default,,0,0,0,,- (Гента) Мен мұндамын - (Мицухико) А...
Dialogue: 0,1:16:41.55,1:16:43.26,Default,,0,0,0,,Вахаха...
Dialogue: 0,1:16:43.34,1:16:45.72,Default,,0,0,0,,Зәулім ғимараттарға толы үлкен қала
Dialogue: 0,1:16:45.80,1:16:50.68,Default,,0,0,0,,Сол түні көріністі қорғау үшін ортада полиция жұмыс істейді.
Dialogue: 0,1:16:50.77,1:16:53.35,Default,,0,0,0,,Төмендегілердің қайсысы?
Dialogue: 0,1:17:00.57,1:17:03.70,Default,,0,0,0,,Менің қазір викториналарды шешуге көңіл-күйім жоқ.
Dialogue: 0,1:17:03.78,1:17:05.99,Default,,0,0,0,,Басы Қолдансаң, аш боласың.
Dialogue: 0,1:17:06.07,1:17:08.49,Default,,0,0,0,,Мен Шибуяға барғым келді.
Dialogue: 0,1:17:08.58,1:17:10.75,Default,,0,0,0,,О, Аюми-чан, дұрыс айтасың.
Dialogue: 0,1:17:10.83,1:17:12.50,Default,,0,0,0,,Жауап…
Dialogue: 0,1:17:13.46,1:17:16.00,Default,,0,0,0,,Өйткені ортасында «Якей» бар
Dialogue: 0,1:17:16.08,1:17:17.92,Default,,0,0,0,,- (Гента) Маған бәрібір - (Хайбара) Әй...
Dialogue: 0,1:17:18.00,1:17:18.55,Default,,0,0,0,,Мен бұл туралы ойлануға уақыт тапсам да.
Dialogue: 0,1:17:18.55,1:17:20.51,Default,,0,0,0,,Мен бұл туралы ойлануға уақыт тапсам да.
Dialogue: 0,1:17:18.55,1:17:20.51,Default,,0,0,0,,А…?
Dialogue: 0,1:17:20.59,1:17:22.97,Default,,0,0,0,,Иә, иә, не?
Dialogue: 0,1:17:23.05,1:17:23.68,Default,,0,0,0,,Не? Не? Жоқ, бірақ бәрібір...
Dialogue: 0,1:17:23.68,1:17:24.97,Default,,0,0,0,,Не? Не? Жоқ, бірақ бәрібір...
Dialogue: 0,1:17:23.68,1:17:24.97,Default,,0,0,0,,А…?
Dialogue: 0,1:17:24.97,1:17:26.39,Default,,0,0,0,,Не? Не? Жоқ, бірақ бәрібір...
Dialogue: 0,1:17:26.47,1:17:28.43,Default,,0,0,0,,Не болды? дәрігер
Dialogue: 0,1:17:28.51,1:17:31.39,Default,,0,0,0,,Электрондық пошта кімнен? О, мүмкін Конан-кун?
Dialogue: 0,1:17:31.48,1:17:33.60,Default,,0,0,0,,Жоқ, а... жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,1:17:33.69,1:17:36.40,Default,,0,0,0,,Бірақ... оны қалай айтуым керек? Хахаха...
Dialogue: 0,1:17:36.48,1:17:39.23,Default,,0,0,0,,Сіз бірдеңені жасырып тұрсыз ба?
Dialogue: 0,1:17:39.73,1:17:44.74,Default,,0,0,0,,(үйлену тойындағы музыка)
Dialogue: 0,1:18:06.76,1:18:08.05,Default,,0,0,0,,(Григоридің орысшасы)
Dialogue: 0,1:18:10.14,1:18:11.43,Default,,0,0,0,,Ха…
Dialogue: 0,1:18:10.14,1:18:11.43,Default,,0,0,0,,Хаха...
Dialogue: 0,1:18:11.43,1:18:12.06,Default,,0,0,0,,Хаха...
Dialogue: 0,1:18:12.06,1:18:12.93,Default,,0,0,0,,Хаха...
Dialogue: 0,1:18:12.06,1:18:12.93,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:18:13.77,1:18:15.27,Default,,0,0,0,,Сіз мұны қайдан білдіңіз?
Dialogue: 0,1:18:15.35,1:18:18.27,Default,,0,0,0,,Артыңыздағы адамды бас киіммен ұрғанда, аздап.
Dialogue: 0,1:18:18.36,1:18:19.19,Default,,0,0,0,,Ах
Dialogue: 0,1:18:20.32,1:18:21.86,Default,,0,0,0,,Сол кезде...
Dialogue: 0,1:18:21.94,1:18:24.11,Default,,0,0,0,,Мен сенімен сөйлесуім керек, Еленика.
Dialogue: 0,1:18:27.91,1:18:31.83,Default,,0,0,0,,Бүгін түнде бұл жерде қауіпті. Қазір үйге бар.
Dialogue: 0,1:18:32.95,1:18:33.87,Default,,0,0,0,,Ах
Dialogue: 0,1:18:33.95,1:18:35.71,Default,,0,0,0,,(Григоридің орысшасы)
Dialogue: 0,1:18:35.79,1:18:36.58,Default,,0,0,0,,(үйлену музыкасы)
Dialogue: 0,1:18:36.58,1:18:39.21,Default,,0,0,0,,(үйлену музыкасы)
Dialogue: 0,1:18:36.58,1:18:39.21,Default,,0,0,0,,Енді сақиналарды алмастырайық.
Dialogue: 0,1:18:39.21,1:18:40.38,Default,,0,0,0,,(үйлену музыкасы)
Dialogue: 0,1:18:49.26,1:18:50.18,Default,,0,0,0,,Баршаңыз, енді уақыты келді!
Dialogue: 0,1:18:50.26,1:18:51.85,Default,,0,0,0,,Инспектор: Бұл қиын! Сізге келісім жасап жатқан банда бар.
Dialogue: 0,1:18:51.85,1:18:53.47,Default,,0,0,0,,Инспектор: Бұл қиын! Сізге келісім жасап жатқан банда бар.
Dialogue: 0,1:18:51.85,1:18:53.47,Default,,0,0,0,,(Радио шуы)
Dialogue: 0,1:18:53.47,1:18:53.56,Default,,0,0,0,,(Радио шуы)
Dialogue: 0,1:18:53.56,1:18:55.56,Default,,0,0,0,,(Радио шуы)
Dialogue: 0,1:18:53.56,1:18:55.56,Default,,0,0,0,,Баланы кепілге алу...
Dialogue: 0,1:18:55.64,1:18:56.69,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:18:57.60,1:18:58.81,Default,,0,0,0,,Прамя, өзіңді дайында.
Dialogue: 0,1:19:00.02,1:19:00.94,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,1:19:01.52,1:19:03.19,Default,,0,0,0,,Баланың басы ұшып кетеді.
Dialogue: 0,1:19:03.28,1:19:04.44,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:19:04.53,1:19:05.36,Default,,0,0,0,,Бұл жігітті шын мәнінде өлтіру керек.
Dialogue: 0,1:19:06.90,1:19:09.36,Default,,0,0,0,,Мұны істеу арқылы нені айтасыз?
Dialogue: 0,1:19:09.45,1:19:11.70,Default,,0,0,0,,Прамьяның шынайы тұлғасы ашылды.
Dialogue: 0,1:19:11.78,1:19:13.20,Default,,0,0,0,,Не?
Dialogue: 0,1:19:14.08,1:19:16.25,Default,,0,0,0,,Алдында екі адам, алыстаңыз.
Dialogue: 0,1:19:16.96,1:19:20.25,Default,,0,0,0,,Артыңыздағы детектив кіреберіс есігін жауып, құлыптауы керек.
Dialogue: 0,1:19:20.33,1:19:21.17,Default,,0,0,0,,Ммм
Dialogue: 0,1:19:25.17,1:19:26.17,Default,,0,0,0,,(Құлыптау дыбысы)
Dialogue: 0,1:19:36.02,1:19:37.18,Default,,0,0,0,,әлемнің бәрі қастандық жасап жатқандай
Dialogue: 0,1:19:38.23,1:19:39.06,Default,,0,0,0,,Прамя
Dialogue: 0,1:19:39.14,1:19:40.06,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:19:40.15,1:19:43.19,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Ол нысанаға алынған!
Dialogue: 0,1:19:43.27,1:19:44.15,Default,,0,0,0,,Уф
Dialogue: 0,1:19:45.78,1:19:46.61,Default,,0,0,0,,Уф
Dialogue: 0,1:19:46.69,1:19:48.82,Default,,0,0,0,,А... сен кінәлісің бе?
Dialogue: 0,1:19:48.90,1:19:52.49,Default,,0,0,0,,Жоқ... жоқ! Неге мен өзімді қорқытам?
Dialogue: 0,1:19:52.57,1:19:53.70,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,1:19:53.78,1:19:57.75,Default,,0,0,0,,Келін де, күйеу де, қолдарыңды тез көтеріңдер.
Dialogue: 0,1:20:00.96,1:20:02.33,Default,,0,0,0,,Не болды? қалыңдық
Dialogue: 0,1:20:03.13,1:20:04.84,Default,,0,0,0,,Қолдарыңызды да көтеріңіз.
Dialogue: 0,1:20:06.00,1:20:10.01,Default,,0,0,0,,Күте тұрыңыз, ол үш жыл бұрын болған жол-көлік оқиғасының зардаптарынан зардап шегеді.
Dialogue: 0,1:20:10.09,1:20:11.68,Default,,0,0,0,,Оң иығымды көтере алмаймын.
Dialogue: 0,1:20:11.76,1:20:13.47,Default,,0,0,0,,Жол-көлік оқиғасы?
Dialogue: 0,1:20:13.55,1:20:17.64,Default,,0,0,0,,Ху... 3 жыл бұрын мені жапон детективі атып тастады.
Dialogue: 0,1:20:17.72,1:20:19.35,Default,,0,0,0,,Оң қолыңызды көтере алмайсыз, солай ма?
Dialogue: 0,1:20:19.43,1:20:22.48,Default,,0,0,0,,Сәлем Кристин Ричард
Dialogue: 0,1:20:22.56,1:20:25.57,Default,,0,0,0,,Жоқ, Прамя!
Dialogue: 0,1:20:26.11,1:20:28.36,Default,,0,0,0,,Мен... кінәлі мен бе?
Dialogue: 0,1:20:28.44,1:20:31.74,Default,,0,0,0,,Уайымдамаңыз! Неліктен ол кінәлі?
Dialogue: 0,1:20:31.82,1:20:33.74,Default,,0,0,0,,Уа, бұл не?
Dialogue: 0,1:20:33.82,1:20:35.16,Default,,0,0,0,,Металл іздегіш.
Dialogue: 0,1:20:35.74,1:20:39.54,Default,,0,0,0,,Прамьяның иығына оқ көмілген.
Dialogue: 0,1:20:40.12,1:20:42.08,Default,,0,0,0,,Егер сіз оны жақындатсаңыз, ол әрекет етуі керек.
Dialogue: 0,1:20:42.17,1:20:43.21,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,1:20:43.29,1:20:45.67,Default,,0,0,0,,Операция арқылы металл болт салынды.
Dialogue: 0,1:20:45.75,1:20:46.67,Default,,0,0,0,,- (Кристина) Сонымен... - (Сато) Ойланып қарашы.
Dialogue: 0,1:20:46.75,1:20:48.51,Default,,0,0,0,,Сіз бұрын күту залында болдыңыз.
Dialogue: 0,1:20:48.59,1:20:50.67,Default,,0,0,0,,Прамя екі адамды өлтіргенін айтты.
Dialogue: 0,1:20:50.76,1:20:53.68,Default,,0,0,0,,Қашып кеткен сериялы бомбалаушыны өлтіру
Dialogue: 0,1:20:54.26,1:20:56.76,Default,,0,0,0,,Бұл мәселе ресми түрде жарияланбағанымен.
Dialogue: 0,1:20:56.85,1:20:57.68,Default,,0,0,0,,Неліктен екі адам?
Dialogue: 0,1:20:57.76,1:20:59.06,Default,,0,0,0,,Саған не болды!
Dialogue: 0,1:20:59.14,1:21:03.73,Default,,0,0,0,,Толық қауіпсіздікпен тойымызды қорғағыңыз келмей ме?
Dialogue: 0,1:21:03.81,1:21:06.82,Default,,0,0,0,,Бірақ олар кіруге оңай жол берді.
Dialogue: 0,1:21:06.90,1:21:08.65,Default,,0,0,0,,Қылмыскер ретінде қаралды
Dialogue: 0,1:21:08.73,1:21:11.07,Default,,0,0,0,,Үйлену тойы дау-дамай!
Dialogue: 0,1:21:11.15,1:21:15.57,Default,,0,0,0,,Кешіріңіз Кристин, өте шуақты күн болды...
Dialogue: 0,1:21:15.66,1:21:19.58,Default,,0,0,0,,Хе... хе хе хе хе хе...
Dialogue: 0,1:21:19.66,1:21:21.50,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,1:21:22.29,1:21:26.08,Default,,0,0,0,,Сенің маған істегенің соңғы ісің болды.
Dialogue: 0,1:21:26.17,1:21:28.00,Default,,0,0,0,,Кристин, сен не дедің...
Dialogue: 0,1:21:32.38,1:21:34.89,Default,,0,0,0,,Ах... шулы шулы
Dialogue: 0,1:21:34.97,1:21:35.89,Default,,0,0,0,,Крис...
Dialogue: 0,1:21:35.97,1:21:39.81,Default,,0,0,0,,Балалар сендер тітіркендіргіш шыбын сияқтысыңдар.
Dialogue: 0,1:21:39.89,1:21:40.89,Default,,0,0,0,,Ха…
Dialogue: 0,1:21:41.64,1:21:42.52,Default,,0,0,0,,Әй
Dialogue: 0,1:21:45.73,1:21:46.56,Default,,0,0,0,,Иә!
Dialogue: 0,1:21:47.81,1:21:48.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:21:50.40,1:21:52.53,Default,,0,0,0,,-Аа -Бәрі тез тығылып ал!
Dialogue: 0,1:21:52.61,1:21:53.90,Default,,0,0,0,,- (Такаги) Конан-кун? -Асықшы!
Dialogue: 0,1:21:53.99,1:21:56.03,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,1:21:56.91,1:21:59.91,Default,,0,0,0,,Менің шынайы болмысымды білетіндер
Dialogue: 0,1:22:00.79,1:22:03.33,Default,,0,0,0,,Ешкімді құтқару мүмкін емес!
Dialogue: 0,1:22:05.50,1:22:06.88,Default,,0,0,0,,Уф
Dialogue: 0,1:22:06.96,1:22:09.21,Default,,0,0,0,,- (Кристина) Хахахаха... - (Мұранака) Тоқта!
Dialogue: 0,1:22:09.29,1:22:10.67,Default,,0,0,0,,Кристин!
Dialogue: 0,1:22:13.26,1:22:14.67,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:22:14.76,1:22:16.18,Default,,0,0,0,,Муранака!
Dialogue: 0,1:22:16.26,1:22:17.39,Default,,0,0,0,,Уау
Dialogue: 0,1:22:17.47,1:22:18.43,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:22:18.51,1:22:21.77,Default,,0,0,0,,Инспектор Мегур, жақсысың ба? Тезірек осында жасырын
Dialogue: 0,1:22:21.85,1:22:22.68,Default,,0,0,0,,Уф
Dialogue: 0,1:22:34.40,1:22:36.70,Default,,0,0,0,,Келін кінәлі. Екінші қабаттағы дәлізде...
Dialogue: 0,1:22:36.70,1:22:37.57,Default,,0,0,0,,Келін кінәлі. Екінші қабаттағы дәлізде...
Dialogue: 0,1:22:36.70,1:22:37.57,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:22:37.66,1:22:39.57,Default,,0,0,0,,Хахаха...
Dialogue: 0,1:22:39.66,1:22:41.99,Default,,0,0,0,,Мен басқа кіреберістен барамын.
Dialogue: 0,1:22:39.66,1:22:41.99,Default,,0,0,0,,(Кристинаның күлкісі)
Dialogue: 0,1:22:41.99,1:22:42.66,Default,,0,0,0,,(Кристинаның күлкісі)
Dialogue: 0,1:22:42.74,1:22:44.41,Default,,0,0,0,,Мұранака, берік бол!
Dialogue: 0,1:22:44.50,1:22:48.33,Default,,0,0,0,,Мегуре... Кешіріңіз, мен шынымен ақымақпын.
Dialogue: 0,1:22:48.42,1:22:51.80,Default,,0,0,0,,Ақымақ, бұл жаңалық емес.
Dialogue: 0,1:22:51.88,1:22:54.01,Default,,0,0,0,,Мен қазір не туралы алаңдауым керек?
Dialogue: 0,1:22:54.09,1:22:56.55,Default,,0,0,0,,Дене ақылдан бұрын интуиция негізінде қозғалады
Dialogue: 0,1:22:56.63,1:22:58.55,Default,,0,0,0,,Жын ауылы!
Dialogue: 0,1:22:58.64,1:23:00.39,Default,,0,0,0,,Мегур…
Dialogue: 0,1:23:01.05,1:23:01.89,Default,,0,0,0,,Сато мырза!
Dialogue: 0,1:23:01.97,1:23:03.35,Default,,0,0,0,,Сато-кун!
Dialogue: 0,1:23:04.60,1:23:05.89,Default,,0,0,0,,Уф
Dialogue: 0,1:23:06.77,1:23:07.85,Default,,0,0,0,,Қауіпті!
Dialogue: 0,1:23:07.94,1:23:09.60,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:23:14.28,1:23:15.99,Default,,0,0,0,,...
Dialogue: 0,1:23:16.07,1:23:18.03,Default,,0,0,0,,Такаги-кун, мен сені қуамын!
Dialogue: 0,1:23:18.11,1:23:18.95,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,1:23:19.03,1:23:20.78,Default,,0,0,0,,Ол шатырға бет алған болуы керек.
Dialogue: 0,1:23:20.87,1:23:22.99,Default,,0,0,0,,Ол тікұшақпен қашуды жоспарлап отыр ма?
Dialogue: 0,1:23:23.08,1:23:25.54,Default,,0,0,0,,Үйлену тойына біз жалдаған тікұшақ.
Dialogue: 0,1:23:25.62,1:23:27.12,Default,,0,0,0,,Бізге асығу керек
Dialogue: 0,1:23:49.19,1:23:51.35,Default,,0,0,0,,Цк, кешігіп қалдыңыз.
Dialogue: 0,1:23:51.44,1:23:54.36,Default,,0,0,0,,Менің ойымша, жай ғана бас тартқан дұрыс.
Dialogue: 0,1:23:56.15,1:23:58.03,Default,,0,0,0,,Кристин
Dialogue: 0,1:24:01.28,1:24:05.37,Default,,0,0,0,,Менің ойымша, сізді Прамья деп атаған дұрыс болар еді.
Dialogue: 0,1:24:05.45,1:24:08.25,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,1:24:08.33,1:24:10.46,Default,,0,0,0,,Конан Эдогава
Dialogue: 0,1:24:11.17,1:24:12.25,Default,,0,0,0,,Детектив
Dialogue: 0,1:24:15.25,1:24:16.17,Default,,0,0,0,,Уф
Dialogue: 0,1:24:16.25,1:24:17.96,Default,,0,0,0,,Өтірік Ашық емес
Dialogue: 0,1:24:18.05,1:24:19.05,Default,,0,0,0,,Детектив?
Dialogue: 0,1:24:19.13,1:24:21.55,Default,,0,0,0,,Жоспарыңыз орындалмады.
Dialogue: 0,1:24:21.63,1:24:24.93,Default,,0,0,0,,Олардың барлығын бірге өлтіру жоспары.
Dialogue: 0,1:24:25.01,1:24:28.14,Default,,0,0,0,,Еленика және басқалар, Нада Юнититожити
Dialogue: 0,1:24:28.22,1:24:30.94,Default,,0,0,0,,Дүниенің кез келген жерінде саған ердім.
Dialogue: 0,1:24:31.52,1:24:33.98,Default,,0,0,0,,Тіпті Прамьяның өзі бұрышта қалды.
Dialogue: 0,1:24:34.06,1:24:36.44,Default,,0,0,0,,Сондықтан мен өзімді тірілту үшін жоспар құрдым.
Dialogue: 0,1:24:37.19,1:24:41.70,Default,,0,0,0,,Оларды бір жерге жинап, арнайы бомбамен жарып жіберіңіз.
Dialogue: 0,1:24:41.78,1:24:43.91,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,1:24:43.99,1:24:46.70,Default,,0,0,0,,Күтілгендей, өзіңізді детектив деп атасаңыз жеткілікті.
Dialogue: 0,1:24:46.79,1:24:49.20,Default,,0,0,0,,Дұрыс айтасың, балам.
Dialogue: 0,1:24:49.95,1:24:53.17,Default,,0,0,0,,Алдымен мен зейнеткерлікке шығамын деп қауесет таратты.
Dialogue: 0,1:24:53.25,1:24:55.42,Default,,0,0,0,,Сосын ауылға жақындадық.
Dialogue: 0,1:24:55.50,1:24:59.71,Default,,0,0,0,,Мен біреу Мұранака мырзаны нысанаға алып жатыр деген әңгіме құрастырдым.
Dialogue: 0,1:24:59.80,1:25:03.84,Default,,0,0,0,,Егер Прамья араласса, олар келуге қуанышты болады.
Dialogue: 0,1:25:03.93,1:25:07.47,Default,,0,0,0,,Бұл сенің мені ұстап алудың соңғы мүмкіндігің деп қорқамын.
Dialogue: 0,1:25:07.56,1:25:10.52,Default,,0,0,0,,Сізде басқа мақсат болды.
Dialogue: 0,1:25:10.60,1:25:11.98,Default,,0,0,0,,Куәларды жою
Dialogue: 0,1:25:12.06,1:25:13.10,Default,,0,0,0,,(Өрт сөндіргіштің есікке соғылған дыбысы)
Dialogue: 0,1:25:13.10,1:25:15.81,Default,,0,0,0,,(Өрт сөндіргіштің есікке соғылған дыбысы)
Dialogue: 0,1:25:13.10,1:25:15.81,Default,,0,0,0,,Сіз өзіңізді Прамья ретінде көрдіңіз.
Dialogue: 0,1:25:15.81,1:25:15.90,Default,,0,0,0,,(Өрт сөндіргіштің есікке соғылған дыбысы)
Dialogue: 0,1:25:15.90,1:25:18.36,Default,,0,0,0,,(Өрт сөндіргіштің есікке соғылған дыбысы)
Dialogue: 0,1:25:15.90,1:25:18.36,Default,,0,0,0,,Мен олардың бәрін өлтірдім, бірақ...
Dialogue: 0,1:25:18.44,1:25:22.74,Default,,0,0,0,,Иә, мен Жапонияда бір рет қорлауды бастан өткердім.
Dialogue: 0,1:25:24.57,1:25:27.24,Default,,0,0,0,,Сол төрт полиция қызметкері
Dialogue: 0,1:25:27.33,1:25:29.20,Default,,0,0,0,,Мақсат...
Dialogue: 0,1:25:29.29,1:25:30.25,Default,,0,0,0,,Танымал жауаптар
Dialogue: 0,1:25:30.33,1:25:34.83,Default,,0,0,0,,Елордалық полиция департаментінде жүргізілген терең тергеу Мацуданың қызметтік міндетін атқару кезінде қайтыс болғанын анықтады.
Dialogue: 0,1:25:34.92,1:25:37.00,Default,,0,0,0,,Күні де жол апатынан қайтыс болды.
Dialogue: 0,1:25:37.09,1:25:40.80,Default,,0,0,0,,Нөл және Хиро деп аталған екеуі ғана қалды.
Dialogue: 0,1:25:40.88,1:25:44.05,Default,,0,0,0,,Мен Моробуси Фуруя есімін ғана білдім.
Dialogue: 0,1:25:44.13,1:25:45.47,Default,,0,0,0,,Қанша зерттесең де
Dialogue: 0,1:25:45.55,1:25:49.01,Default,,0,0,0,,Сол екі адам туралы ақпарат шықпайды.
Dialogue: 0,1:25:49.10,1:25:52.89,Default,,0,0,0,,Онда олар қызметтік міндетін орындау кезінде детектив Мацуданы өлтірген бомбалаушыны пайдаланды.
Dialogue: 0,1:25:52.98,1:25:54.27,Default,,0,0,0,,Сіз мені еліктірмек болдыңыз, солай емес пе?
Dialogue: 0,1:25:54.35,1:25:57.40,Default,,0,0,0,,Иә, егер мен ол кісінің қашып кетуіне жол берсем.
Dialogue: 0,1:25:57.48,1:25:59.90,Default,,0,0,0,,Шұңқырдан асығыс шықты.
Dialogue: 0,1:25:59.98,1:26:04.40,Default,,0,0,0,,Күтілгендей, Фуруя пайда болып, бомбаны сәтті орнатады.
Dialogue: 0,1:26:04.49,1:26:07.99,Default,,0,0,0,,Егер сіз осы уақытқа дейін жетсеңіз, міндетті түрде тағы біреуі болады.
Dialogue: 0,1:26:08.07,1:26:09.33,Default,,0,0,0,,Мен осылай оқыдым.
Dialogue: 0,1:26:09.41,1:26:12.16,Default,,0,0,0,,Осы уақытқа дейін тырыссаңыз да, ол бәрібір шықпайды.
Dialogue: 0,1:26:12.83,1:26:14.16,Default,,0,0,0,,Ол өлді, солай ма?
Dialogue: 0,1:26:15.37,1:26:18.17,Default,,0,0,0,,Планшет Елениканың ағасы Олегке тиесілі
Dialogue: 0,1:26:18.79,1:26:20.17,Default,,0,0,0,,Бұл да тұзақ болды, солай ма?
Dialogue: 0,1:26:20.25,1:26:24.17,Default,,0,0,0,,Дұрыс, ол әдейі ұрлаған планшетпен.
Dialogue: 0,1:26:24.26,1:26:27.39,Default,,0,0,0,,Егер достарына қайтып келсе, оны сол жерде жарып жіберіңіз.
Dialogue: 0,1:26:27.47,1:26:29.93,Default,,0,0,0,,Нада Уничитожитиді ұшырып жібере алады.
Dialogue: 0,1:26:30.01,1:26:32.39,Default,,0,0,0,,Бірақ ол өзінің серіктерін ешқашан кездестірмеген.
Dialogue: 0,1:26:32.47,1:26:34.43,Default,,0,0,0,,Жалғыз әрекет етуді жалғастырыңыз
Dialogue: 0,1:26:35.10,1:26:37.94,Default,,0,0,0,,Осылайша мен Мацуданы кездестіріп, оған бәрін айтып беруге тырыстым.
Dialogue: 0,1:26:38.02,1:26:40.82,Default,,0,0,0,,Мацуда әлдеқашан өлген болса да.
Dialogue: 0,1:26:40.90,1:26:42.11,Default,,0,0,0,,Сонымен
Dialogue: 0,1:26:42.19,1:26:45.07,Default,,0,0,0,,Сіз оны планшетте орнатылған GPS арқылы белгіледіңіз.
Dialogue: 0,1:26:45.15,1:26:49.07,Default,,0,0,0,,Сіз бомбаны елордалық полиция бөліміне жеткізілмес бұрын іске қостыңыз.
Dialogue: 0,1:26:49.16,1:26:51.03,Default,,0,0,0,,Мен оны планшетте сақтадым.
Dialogue: 0,1:26:51.12,1:26:53.08,Default,,0,0,0,,Токио түйінді сөзі
Dialogue: 0,1:26:53.16,1:26:56.58,Default,,0,0,0,,Нада Уничитожитидің жігіттері жақсы тамақтанып отырды.
Dialogue: 0,1:26:56.66,1:26:57.58,Default,,0,0,0,,Уф! Ха! Уф!
Dialogue: 0,1:26:57.58,1:26:59.08,Default,,0,0,0,,Уф! Ха! Уф!
Dialogue: 0,1:26:57.58,1:26:59.08,Default,,0,0,0,,Бірақ бұл адам
Dialogue: 0,1:26:59.08,1:26:59.17,Default,,0,0,0,,Уф! Ха! Уф!
Dialogue: 0,1:26:59.17,1:27:01.13,Default,,0,0,0,,Уф! Ха! Уф!
Dialogue: 0,1:26:59.17,1:27:01.13,Default,,0,0,0,,Иығымдағы оқ туралы білгендеріне де сене алар емеспін.
Dialogue: 0,1:27:01.13,1:27:02.25,Default,,0,0,0,,Тіпті иығымдағы оқты да тапты.
Dialogue: 0,1:27:02.25,1:27:02.71,Default,,0,0,0,,Иығымдағы оқ туралы білгендеріне де сене алар емеспін.
Dialogue: 0,1:27:02.25,1:27:02.71,Default,,0,0,0,,Ах!
Dialogue: 0,1:27:02.71,1:27:02.80,Default,,0,0,0,,Ах!
Dialogue: 0,1:27:02.80,1:27:04.01,Default,,0,0,0,,Ах!
Dialogue: 0,1:27:02.80,1:27:04.01,Default,,0,0,0,,Бұл қате есептеу болды.
Dialogue: 0,1:27:04.09,1:27:07.01,Default,,0,0,0,,Мен мұны Олегтің қалдырған жазбасынан байқадым.
Dialogue: 0,1:27:07.09,1:27:08.84,Default,,0,0,0,,Оқ пен иық
Dialogue: 0,1:27:08.93,1:27:11.76,Default,,0,0,0,,Үш жыл бұрын Прамьяның иығына оқ тиген.
Dialogue: 0,1:27:11.85,1:27:14.60,Default,,0,0,0,,Алайын десең жүйкеңді зақымдайды.
Dialogue: 0,1:27:14.68,1:27:17.27,Default,,0,0,0,,Маған қолымның қозғалысына әсер ететінін айтты.
Dialogue: 0,1:27:17.35,1:27:21.52,Default,,0,0,0,,Күрделі бомбаларды жасайтындар үшін бұл өлімге әкеледі.
Dialogue: 0,1:27:21.61,1:27:23.78,Default,,0,0,0,,Сондықтан мен оны шығарудан бас тарттым.
Dialogue: 0,1:27:23.86,1:27:25.36,Default,,0,0,0,,Өз кезегінде
Dialogue: 0,1:27:25.44,1:27:28.78,Default,,0,0,0,,Оң қолымды енді көтере алмайтыным рас па?
Dialogue: 0,1:27:28.86,1:27:31.20,Default,,0,0,0,,Сіз қойған бомба қайда?
Dialogue: 0,1:27:31.28,1:27:33.28,Default,,0,0,0,,Мұны білген соң не істейсің?
Dialogue: 0,1:27:33.37,1:27:37.46,Default,,0,0,0,,Сіздің шынайы тұлғаңыз полиция мен Нада Бірлігін қамтиды.
Dialogue: 0,1:27:37.54,1:27:39.42,Default,,0,0,0,,көптеген адамдарға белгілі болды
Dialogue: 0,1:27:39.50,1:27:41.79,Default,,0,0,0,,Оны жарып жіберудің қажеті жоқ!
Dialogue: 0,1:27:42.84,1:27:43.80,Default,,0,0,0,,Ах
Dialogue: 0,1:27:43.88,1:27:45.30,Default,,0,0,0,,Мен мұны ертерек айтуым керек еді.
Dialogue: 0,1:27:45.38,1:27:49.55,Default,,0,0,0,,Менің шынайы болмысымды білетін адам аман қала алмайды.
Dialogue: 0,1:27:50.93,1:27:53.55,Default,,0,0,0,,Бұл жігіттердің бәрі ақымақ.
Dialogue: 0,1:27:53.64,1:27:55.27,Default,,0,0,0,,Хэллоуин мерекесін жандандыру
Dialogue: 0,1:27:55.35,1:27:57.89,Default,,0,0,0,,Менің ойымша, сіз оны тек әшекей деп ойлайсыз.
Dialogue: 0,1:27:57.98,1:27:58.81,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:27:59.85,1:28:01.06,Default,,0,0,0,,Мына шам!
Dialogue: 0,1:28:01.65,1:28:03.56,Default,,0,0,0,,Сұйық мылтық, оның ішінде муляждар
Dialogue: 0,1:28:03.65,1:28:07.07,Default,,0,0,0,,Догензака, Миямасузака және т.б.
Dialogue: 0,1:28:07.15,1:28:09.57,Default,,0,0,0,,Сұйықтық ең төменгі нүктеде
Dialogue: 0,1:28:09.65,1:28:13.57,Default,,0,0,0,,Басқаша айтқанда, ол шиеленіс қиылысына қарай төмен ағады.
Dialogue: 0,1:28:13.66,1:28:17.33,Default,,0,0,0,,Мен түсінемін, сондықтан олар Шибуядағы биіктік айырмашылығын пайдаланды.
Dialogue: 0,1:28:18.91,1:28:20.42,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:28:20.50,1:28:23.08,Default,,0,0,0,,Аралас сұйық бомбалардың көп мөлшері
Dialogue: 0,1:28:23.17,1:28:27.01,Default,,0,0,0,,Бұрын-соңды болмаған жарылыс болады.
Dialogue: 0,1:28:32.47,1:28:37.43,Default,,0,0,0,,Ал менің шынайы болмысымды білетіндердің бәрі бұл дүниеден ғайып болады.
Dialogue: 0,1:28:37.52,1:28:39.77,Default,,0,0,0,,Хехехе...
Dialogue: 0,1:28:39.85,1:28:44.11,Default,,0,0,0,,Ахахха... ахахха...
Dialogue: 0,1:28:44.19,1:28:46.11,Default,,0,0,0,,Менің де естігім келгені осы еді.
Dialogue: 0,1:28:46.19,1:28:47.73,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,1:28:47.82,1:28:48.94,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,1:28:49.74,1:28:53.53,Default,,0,0,0,,Ааа... уф
Dialogue: 0,1:28:53.61,1:28:55.66,Default,,0,0,0,,Сіз...
Dialogue: 0,1:28:56.83,1:28:58.41,Default,,0,0,0,,Фуруя нөл!
Dialogue: 0,1:28:58.49,1:29:02.42,Default,,0,0,0,,Мен сені ұстағым келсе, мен оны кез келген уақытта істей аламын.
Dialogue: 0,1:29:02.50,1:29:07.21,Default,,0,0,0,,Мен оны бомбаның орнын анықтау үшін әдейі осы күнге дейін жүзуге мәжбүр еттім.
Dialogue: 0,1:29:07.30,1:29:10.67,Default,,0,0,0,,Міне, мен сол белгі бар диаграммаға сүйене отырып, шамамен болжам жасадым.
Dialogue: 0,1:29:10.76,1:29:12.18,Default,,0,0,0,,Мен қабілетті жігітпін!
Dialogue: 0,1:29:12.26,1:29:13.84,Default,,0,0,0,,- (Такаги) Уау - (Сато) Прамя!
Dialogue: 0,1:29:13.93,1:29:15.22,Default,,0,0,0,,Енді қаша алмайсың!
Dialogue: 0,1:29:17.72,1:29:18.60,Default,,0,0,0,,Уф (буындардың жарылған дыбысы)
Dialogue: 0,1:29:18.68,1:29:21.93,Default,,0,0,0,,Хаха...
Dialogue: 0,1:29:22.02,1:29:23.90,Default,,0,0,0,,Мен де осындамын ба?
Dialogue: 0,1:29:23.98,1:29:26.65,Default,,0,0,0,,Жүр, қолыңды көтер.
Dialogue: 0,1:29:26.73,1:29:28.40,Default,,0,0,0,,Оны бастың артына бұраңыз
Dialogue: 0,1:29:29.40,1:29:30.23,Default,,0,0,0,,О
Dialogue: 0,1:29:30.99,1:29:33.91,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:29:33.99,1:29:35.87,Default,,0,0,0,,- (Амуро) Қарғыс атсын - (Кристина) Хахаха...
Dialogue: 0,1:29:35.95,1:29:38.70,Default,,0,0,0,,Егер бұл орын алса, сізбен кем дегенде бір адам болады!
Dialogue: 0,1:29:38.79,1:29:40.33,Default,,0,0,0,,Тс!
Dialogue: 0,1:29:43.08,1:29:44.08,Default,,0,0,0,,Уф
Dialogue: 0,1:29:45.67,1:29:49.71,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,1:29:55.89,1:29:57.30,Default,,0,0,0,,- (Такаги) Ах - (Сато) Мен сағындым!
Dialogue: 0,1:29:57.39,1:29:58.30,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,1:30:04.14,1:30:05.44,Default,,0,0,0,,Жеңіске жет!
Dialogue: 0,1:30:05.52,1:30:07.44,Default,,0,0,0,,Отшашу шары!
Dialogue: 0,1:30:10.61,1:30:13.49,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,1:30:13.57,1:30:15.24,Default,,0,0,0,,Ах!
Dialogue: 0,1:30:18.57,1:30:19.95,Default,,0,0,0,,Я...
Dialogue: 0,1:30:21.66,1:30:23.29,Default,,0,0,0,,О, тозақ!
Dialogue: 0,1:30:23.37,1:30:24.21,Default,,0,0,0,,Уф
Dialogue: 0,1:30:25.50,1:30:28.33,Default,,0,0,0,,Қауіпсіздік жағында болу үшін, қосалқы қалдырыңыз.
Dialogue: 0,1:30:28.33,1:30:29.46,Default,,0,0,0,,Қауіпсіз болу үшін, бос орын қалдырыңыз.
Dialogue: 0,1:30:28.33,1:30:29.46,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:30:29.54,1:30:33.59,Default,,0,0,0,,Хехехе... Мен сені алдыңда о дүниеге жіберемін.
Dialogue: 0,1:30:33.67,1:30:35.59,Default,,0,0,0,,Сол жағалы бомбамен
Dialogue: 0,1:30:35.68,1:30:37.84,Default,,0,0,0,,Хахаха...
Dialogue: 0,1:30:37.93,1:30:41.26,Default,,0,0,0,,Мен де басқара аламын. Мен де басқара аламын
Dialogue: 0,1:30:41.35,1:30:44.23,Default,,0,0,0,,Мен де басқара аламын. Мен де басқара аламын
Dialogue: 0,1:30:44.31,1:30:45.60,Default,,0,0,0,,Иә
Dialogue: 0,1:30:47.94,1:30:49.11,Default,,0,0,0,,Не!
Dialogue: 0,1:30:49.19,1:30:54.11,Default,,0,0,0,,Мен осындай нәрсе болуы мүмкін деп ойлап, сыйлығыңызды қайтардым.
Dialogue: 0,1:30:56.03,1:30:57.11,Default,,0,0,0,,Әй!
Dialogue: 0,1:31:00.07,1:31:01.24,Default,,0,0,0,,Манекен туралы не деуге болады?
Dialogue: 0,1:31:01.33,1:31:02.37,Default,,0,0,0,,Иә
Dialogue: 0,1:31:02.99,1:31:06.37,Default,,0,0,0,,Бомба сұйықтығын толығымен талдап, бейтараптандырғышты дайындау керек.
Dialogue: 0,1:31:06.46,1:31:07.87,Default,,0,0,0,,Мен одан аулақ болдым.
Dialogue: 0,1:31:08.50,1:31:09.96,Default,,0,0,0,,Менің тамаша бағыныштым бойынша.
Dialogue: 0,1:31:09.96,1:31:11.13,Default,,0,0,0,,Менің тамаша бағыныштым бойынша.
Dialogue: 0,1:31:09.96,1:31:11.13,Default,,0,0,0,,Я...
Dialogue: 0,1:31:11.21,1:31:13.96,Default,,0,0,0,,Сұйықтық осында жасалған.
Dialogue: 0,1:31:14.05,1:31:15.80,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,1:31:15.88,1:31:16.92,Default,,0,0,0,,Фуруя!
Dialogue: 0,1:31:25.02,1:31:26.31,Default,,0,0,0,,Төменде күтіңіз!
Dialogue: 0,1:31:26.39,1:31:27.48,Default,,0,0,0,,Амуро-сан!
Dialogue: 0,1:31:27.56,1:31:29.02,Default,,0,0,0,,Нвааах!
Dialogue: 0,1:31:32.11,1:31:32.94,Default,,0,0,0,,Әй
Dialogue: 0,1:31:34.15,1:31:35.28,Default,,0,0,0,,Әй
Dialogue: 0,1:31:35.36,1:31:37.78,Default,,0,0,0,,Бұл жолы қашып кетуге жол бермеймін
Dialogue: 0,1:31:38.36,1:31:40.20,Default,,0,0,0,,Мен табанды еркектерді жек көремін!
Dialogue: 0,1:31:41.03,1:31:41.87,Default,,0,0,0,,Га
Dialogue: 0,1:31:41.95,1:31:42.78,Default,,0,0,0,,Ха!
Dialogue: 0,1:31:46.62,1:31:47.96,Default,,0,0,0,,Қандай шектен шыққан
Dialogue: 0,1:31:48.04,1:31:51.00,Default,,0,0,0,,Тікұшақпен секіріп, қылмыскермен күресу.
Dialogue: 0,1:31:51.08,1:31:52.54,Default,,0,0,0,,Конан-кун, бір-біріңді танисыңдар ма?
Dialogue: 0,1:31:52.63,1:31:54.80,Default,,0,0,0,,Мен қылмыскердің артына жасырынғандықтан, оны көре алмадым.
Dialogue: 0,1:31:54.88,1:31:56.42,Default,,0,0,0,,-Төмен түсейік! -(Сато) О, сәл күте тұрыңыз.
Dialogue: 0,1:31:57.05,1:31:59.09,Default,,0,0,0,,Бұл ұшқыш кім?
Dialogue: 0,1:31:59.18,1:32:01.59,Default,,0,0,0,,- (Ер адам) А? Шынайы ма? -(Әйел) Жаман емес пе?
Dialogue: 0,1:32:17.49,1:32:18.44,Default,,0,0,0,,Уф
Dialogue: 0,1:32:17.49,1:32:18.44,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:32:18.44,1:32:19.90,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:32:19.90,1:32:21.11,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:32:19.90,1:32:21.11,Default,,0,0,0,,Әй
Dialogue: 0,1:32:21.11,1:32:21.20,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:32:21.20,1:32:22.16,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:32:21.20,1:32:22.16,Default,,0,0,0,,Әй
Dialogue: 0,1:32:22.16,1:32:22.91,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:32:22.99,1:32:24.03,Default,,0,0,0,,Әй
Dialogue: 0,1:32:25.20,1:32:26.66,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:32:27.54,1:32:28.62,Default,,0,0,0,,Иә!
Dialogue: 0,1:32:31.17,1:32:32.00,Default,,0,0,0,,Уф
Dialogue: 0,1:32:32.08,1:32:33.75,Default,,0,0,0,,
Dialogue: 0,1:32:33.83,1:32:35.38,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:32:38.71,1:32:40.26,Default,,0,0,0,,Уф...
Dialogue: 0,1:32:40.34,1:32:42.84,Default,,0,0,0,,Жібер... бейбақ.
Dialogue: 0,1:32:42.93,1:32:45.26,Default,,0,0,0,,Сіздің үміттеріңіз енді орындалмайды.
Dialogue: 0,1:32:45.35,1:32:46.89,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,1:32:46.97,1:32:47.81,Default,,0,0,0,,Ах
Dialogue: 0,1:32:47.89,1:32:51.44,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,1:32:54.90,1:32:58.57,Default,,0,0,0,,
Dialogue: 0,1:32:58.65,1:33:01.07,Default,,0,0,0,,Тезірек Шибуядан кетіңіз!
Dialogue: 0,1:33:01.15,1:33:04.32,Default,,0,0,0,,Терроризм болуы мүмкін. Дереу эвакуациялаңыз!
Dialogue: 0,1:33:04.41,1:33:06.58,Default,,0,0,0,,Станциядан мүмкіндігінше алыс болыңыз!
Dialogue: 0,1:33:06.66,1:33:07.58,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:33:10.04,1:33:12.87,Default,,0,0,0,,(Когороның қорылдауы)
Dialogue: 0,1:33:12.96,1:33:14.46,Default,,0,0,0,,Бұл не туралы?
Dialogue: 0,1:33:18.05,1:33:20.46,Default,,0,0,0,,Бұл жағдайда жүру жылдамырақ болар еді.
Dialogue: 0,1:33:20.55,1:33:22.43,Default,,0,0,0,,Конан-кунның электрондық поштасында
Dialogue: 0,1:33:22.51,1:33:24.93,Default,,0,0,0,,Шибуя қиылысының ортасында күтіңіз.
Dialogue: 0,1:33:25.01,1:33:26.22,Default,,0,0,0,,Бұл жазылған, солай ма?
Dialogue: 0,1:33:26.30,1:33:27.72,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,1:33:27.81,1:33:29.72,Default,,0,0,0,,Дәрігер, жарай ма?
Dialogue: 0,1:33:29.81,1:33:31.77,Default,,0,0,0,,А... а...
Dialogue: 0,1:33:34.02,1:33:36.15,Default,,0,0,0,,Менің жүгіруден басқа амалым жоқ!
Dialogue: 0,1:33:36.23,1:33:37.48,Default,,0,0,0,,- (Мицухико) Иә! -(Аюми) Иә!
Dialogue: 0,1:33:36.23,1:33:37.48,Default,,0,0,0,,О!
Dialogue: 0,1:33:37.57,1:33:40.90,Default,,0,0,0,,Өте сақ болыңыз.
Dialogue: 0,1:33:43.07,1:33:43.90,Default,,0,0,0,,Уф
Dialogue: 0,1:33:45.74,1:33:48.41,Default,,0,0,0,,Бұл жарылыстың алдын ала ма?
Dialogue: 0,1:33:49.83,1:33:50.66,Default,,0,0,0,,Ах
Dialogue: 0,1:33:52.54,1:33:54.17,Default,,0,0,0,,Сіз үшін...
Dialogue: 0,1:33:55.12,1:33:59.42,Default,,0,0,0,,Менің жоспарларым сенің кесіріңнен бұзылды!
Dialogue: 0,1:33:59.50,1:34:00.67,Default,,0,0,0,,Уф...
Dialogue: 0,1:34:02.51,1:34:04.43,Default,,0,0,0,,(Тодороки) Камино… (Камино) Жарайды, алдым.
Dialogue: 0,1:34:04.51,1:34:05.84,Default,,0,0,0,,Ах
Dialogue: 0,1:34:07.47,1:34:08.47,Default,,0,0,0,,Уф...
Dialogue: 0,1:34:10.60,1:34:11.43,Default,,0,0,0,,Ха…
Dialogue: 0,1:34:12.06,1:34:16.19,Default,,0,0,0,,Бұрынғы детектив ретінде мен қылмыстарды елеусіз қалдыра алмаймын.
Dialogue: 0,1:34:16.27,1:34:17.44,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,1:34:17.52,1:34:19.40,Default,,0,0,0,,Бұл жерден тез кету керек.
Dialogue: 0,1:34:19.48,1:34:20.32,Default,,0,0,0,,Иә?
Dialogue: 0,1:34:20.40,1:34:22.78,Default,,0,0,0,,Мен осында қалсам жаман болмай ма?
Dialogue: 0,1:34:22.86,1:34:24.57,Default,,0,0,0,,Сіз қоғамдық қауіпсіздік қызметкерісіз, солай ма?
Dialogue: 0,1:34:24.65,1:34:25.78,Default,,0,0,0,,Неге олай...
Dialogue: 0,1:34:25.86,1:34:28.24,Default,,0,0,0,,Мен ұзақ уақыт тергеуші болып жұмыс істедім.
Dialogue: 0,1:34:28.32,1:34:30.08,Default,,0,0,0,,Мен түйсік арқылы білемін.
Dialogue: 0,1:34:30.16,1:34:34.33,Default,,0,0,0,,Міне, бұл болжам менің күйеуіме әсер етпеген сияқты.
Dialogue: 0,1:34:34.41,1:34:38.13,Default,,0,0,0,,Жарайды, мен Мегуреден және басқалардан аузымды жұмамын.
Dialogue: 0,1:34:38.21,1:34:39.17,Default,,0,0,0,,Тірі болса ғой.
Dialogue: 0,1:34:39.25,1:34:40.09,Default,,0,0,0,,Ах
Dialogue: 0,1:35:14.75,1:35:15.83,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:35:15.91,1:35:17.16,Default,,0,0,0,,Ах
Dialogue: 0,1:35:17.67,1:35:19.46,Default,,0,0,0,,Атпа, Еленика.
Dialogue: 0,1:35:19.54,1:35:22.67,Default,,0,0,0,,Жолдан кет, балам, жолыма түссең мен де сені атып тастаймын.
Dialogue: 0,1:35:22.75,1:35:26.01,Default,,0,0,0,,Прамьяны атсаң да, ұлың қайтып келмейді.
Dialogue: 0,1:35:26.09,1:35:26.92,Default,,0,0,0,,Ах
Dialogue: 0,1:35:27.01,1:35:29.30,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,1:35:29.39,1:35:33.43,Default,,0,0,0,,Менің ұлым да, күйеуім де, ағам да оның қолынан қаза тапты.
Dialogue: 0,1:35:33.51,1:35:36.10,Default,,0,0,0,,Мен бұрынғы өміріме орала алмаймын.
Dialogue: 0,1:35:36.18,1:35:38.19,Default,,0,0,0,,Мен де көп жамандық жасадым.
Dialogue: 0,1:35:38.27,1:35:40.27,Default,,0,0,0,,Оны өлтіру
Dialogue: 0,1:35:40.35,1:35:43.19,Default,,0,0,0,,Мен мұнда жету үшін бәрін құрбан еттім.
Dialogue: 0,1:35:43.27,1:35:46.03,Default,,0,0,0,,Мен сені осы қолдармен өлтірмесем, көңілім толмайды.
Dialogue: 0,1:35:46.11,1:35:47.90,Default,,0,0,0,,Жолдан кет! бала
Dialogue: 0,1:35:47.99,1:35:49.07,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:52.07,1:35:54.83,Default,,0,0,0,,Неліктен оны өлтіру керек болды?
Dialogue: 0,1:35:54.91,1:35:56.45,Default,,0,0,0,,Күйеуі полиция қызметкері
Dialogue: 0,1:35:56.54,1:36:00.96,Default,,0,0,0,,Мен жаңа ғана саясаткердің баласы болған кісі өлтірген күдіктіні ұстадым.
Dialogue: 0,1:36:01.04,1:36:04.13,Default,,0,0,0,,Мен бұл туралы сотта куәгер болайын десем, ол жойылды.
Dialogue: 0,1:36:04.21,1:36:06.21,Default,,0,0,0,,Ұлымен бірге
Dialogue: 0,1:36:06.30,1:36:09.38,Default,,0,0,0,,Менің күйеуім мен ұлым бірдеңе дұрыс істемеді ме?
Dialogue: 0,1:36:09.88,1:36:11.93,Default,,0,0,0,,Әй, айтшы... Ах.
Dialogue: 0,1:36:12.47,1:36:14.89,Default,,0,0,0,,Уф...
Dialogue: 0,1:36:14.97,1:36:20.23,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:36:20.31,1:36:24.98,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:36:26.32,1:36:28.74,Default,,0,0,0,,Бұл адам жазалануы керек.
Dialogue: 0,1:36:28.82,1:36:32.24,Default,,0,0,0,,Сондықтан жапон полициясына сенулеріңізді қалаймын.
Dialogue: 0,1:36:33.82,1:36:35.99,Default,,0,0,0,,Еленика, ынтымақтасуыңызды өтінемін.
Dialogue: 0,1:36:36.08,1:36:38.50,Default,,0,0,0,,Қайғылы оқиғалардың алдын алу
Dialogue: 0,1:36:38.58,1:36:40.62,Default,,0,0,0,,Бізге сіздің көмегіңіз қажет.
Dialogue: 0,1:36:46.71,1:36:48.13,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:36:48.21,1:36:51.09,Default,,0,0,0,,- (Гента) Конан! -(Мицухико) Қайдасың?
Dialogue: 0,1:36:51.18,1:36:52.01,Default,,0,0,0,,Ах!
Dialogue: 0,1:36:52.09,1:36:53.93,Default,,0,0,0,,Балалар, мұнда неге келдіңдер?
Dialogue: 0,1:36:54.01,1:36:56.89,Default,,0,0,0,,Мен әңгімені дәрігерге қалдырдым, иә.
Dialogue: 0,1:36:56.97,1:36:58.22,Default,,0,0,0,,Бұл жаңа белдік
Dialogue: 0,1:36:58.31,1:36:59.14,Default,,0,0,0,,Рахмет
Dialogue: 0,1:37:00.73,1:37:02.69,Default,,0,0,0,,Боқ... Менің енді уақытым жоқ
Dialogue: 0,1:37:02.77,1:37:04.94,Default,,0,0,0,,А, бұл да!
Dialogue: 0,1:37:05.44,1:37:06.94,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,1:37:07.02,1:37:09.86,Default,,0,0,0,,Мен сіз докторға жіберген электрондық хатты көрдім. Сіз мұны істей аласыз ба?
Dialogue: 0,1:37:09.94,1:37:13.11,Default,,0,0,0,,Иә, мен мына аспалардың ұштарынан ұстап жүгіремін.
Dialogue: 0,1:37:13.20,1:37:16.37,Default,,0,0,0,,Оны қоршауға немесе бағдаршамға байлаңыз, солай ма?
Dialogue: 0,1:37:16.45,1:37:17.87,Default,,0,0,0,,Бұл оңай жеңіс.
Dialogue: 0,1:37:17.95,1:37:21.00,Default,,0,0,0,,Байланғаннан кейін детектив белгісімен Эдогаваға белгі қойыңыз.
Dialogue: 0,1:37:21.08,1:37:22.12,Default,,0,0,0,,Жарайсың ба? Барлығы
Dialogue: 0,1:37:22.21,1:37:23.54,Default,,0,0,0,,- (Мицухико) Иә - (Аюми) Иә.
Dialogue: 0,1:37:22.21,1:37:23.54,Default,,0,0,0,,О
Dialogue: 0,1:37:26.09,1:37:29.46,Default,,0,0,0,,(Еленика орыс)
Dialogue: 0,1:37:46.23,1:37:47.82,Default,,0,0,0,,- (Мегуре) Муранака! -(Муранака) Мегуре
Dialogue: 0,1:37:47.90,1:37:49.36,Default,,0,0,0,,Сіз дұрыс жерге келдіңіз
Dialogue: 0,1:37:49.44,1:37:50.40,Default,,0,0,0,,Сіз оны ұстадыңыз ба?
Dialogue: 0,1:37:50.48,1:37:51.94,Default,,0,0,0,,Әй, қалғаны өзіңе байланысты.
Dialogue: 0,1:37:52.03,1:37:53.86,Default,,0,0,0,,- (Мегуре) На - (Муранака) Менің де кетуім керек.
Dialogue: 0,1:37:53.95,1:37:55.57,Default,,0,0,0,,Қайда?
Dialogue: 0,1:37:55.66,1:37:57.20,Default,,0,0,0,,Иә
Dialogue: 0,1:38:02.66,1:38:04.62,Default,,0,0,0,,Ток жылдам, асығыңыз!
Dialogue: 0,1:38:04.71,1:38:06.13,Default,,0,0,0,,Ммм
Dialogue: 0,1:38:06.21,1:38:08.34,Default,,0,0,0,,Аз ғана қалды...
Dialogue: 0,1:38:08.42,1:38:09.88,Default,,0,0,0,,- (Аюми) Ах - мен саған көмектесемін.
Dialogue: 0,1:38:09.96,1:38:11.63,Default,,0,0,0,,- (Аюми) Иә? -Онда байлауым керек пе?
Dialogue: 0,1:38:14.84,1:38:16.26,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,1:38:16.34,1:38:18.26,Default,,0,0,0,,Дайын!
Dialogue: 0,1:38:18.35,1:38:19.60,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:38:33.15,1:38:34.57,Default,,0,0,0,,Иә, иә. Не болды? Сабыр, сабыр.
Dialogue: 0,1:38:43.08,1:38:44.16,Default,,0,0,0,,Конан-кун...
Dialogue: 0,1:38:44.25,1:38:45.08,Default,,0,0,0,,Ах
Dialogue: 0,1:38:45.16,1:38:47.46,Default,,0,0,0,,Біз осы нүктеге жеттік...
Dialogue: 0,1:38:47.54,1:38:49.42,Default,,0,0,0,,Бірақ бұл бәрін айқын көрсетті.
Dialogue: 0,1:38:49.50,1:38:50.96,Default,,0,0,0,,Бұл тек Шигараки Томира басқаратын Зұлымдар Альянсы ғана емес.
Dialogue: 0,1:38:53.05,1:38:54.55,Default,,0,0,0,,Хмм...
Dialogue: 0,1:38:54.63,1:38:55.84,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:38:57.55,1:38:58.39,Default,,0,0,0,,Аюми!
Dialogue: 0,1:38:59.01,1:39:01.14,Default,,0,0,0,,Уау, уау!
Dialogue: 0,1:39:01.93,1:39:02.81,Default,,0,0,0,,Уф
Dialogue: 0,1:39:03.35,1:39:06.52,Default,,0,0,0,,Аюми Күтіңіз! Уф
Dialogue: 0,1:39:07.10,1:39:08.65,Default,,0,0,0,,Ах!
Dialogue: 0,1:39:09.23,1:39:10.27,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:39:10.94,1:39:11.77,Default,,0,0,0,,Ах
Dialogue: 0,1:39:12.86,1:39:14.65,Default,,0,0,0,,...
Dialogue: 0,1:39:16.11,1:39:19.28,Default,,0,0,0,,Ауыр жарақат. Неге үндемедің?
Dialogue: 0,1:39:19.37,1:39:22.24,Default,,0,0,0,,Мен қазір бұл жерден кете алмаймын...
Dialogue: 0,1:39:22.33,1:39:24.79,Default,,0,0,0,,Мен мұны басуым керек... Уау.
Dialogue: 0,1:39:24.87,1:39:26.37,Default,,0,0,0,,Енді мен білемін!
Dialogue: 0,1:39:26.46,1:39:27.54,Default,,0,0,0,,Эдогава-кун
Dialogue: 0,1:39:27.62,1:39:29.67,Default,,0,0,0,,Үлкенірек болса жаман болар еді.
Dialogue: 0,1:39:29.75,1:39:32.67,Default,,0,0,0,,Маған оны күштірек тірекке қайта байлау керек.
Dialogue: 0,1:39:32.75,1:39:35.17,Default,,0,0,0,,Біз мұны жалғыз жасай алмаймыз.
Dialogue: 0,1:39:35.26,1:39:38.30,Default,,0,0,0,,Қат! Бізге көбірек адам керек
Dialogue: 0,1:39:38.38,1:39:40.05,Default,,0,0,0,,Уф...
Dialogue: 0,1:39:40.14,1:39:41.10,Default,,0,0,0,,- (Аюми) Детектив Такаги - (Сато) Такаги-кун
Dialogue: 0,1:39:41.18,1:39:43.60,Default,,0,0,0,,Барлығы эвакуацияланды, ешкім қалмады.
Dialogue: 0,1:39:44.22,1:39:46.35,Default,,0,0,0,,Бұлай жалғаса берсе, Шибуя от теңізіне айналады...
Dialogue: 0,1:39:47.10,1:39:47.94,Default,,0,0,0,,Жүгірдім!
Dialogue: 0,1:39:48.02,1:39:48.85,Default,,0,0,0,,Ах
Dialogue: 0,1:39:49.56,1:39:50.85,Default,,0,0,0,,Шиничи?
Dialogue: 0,1:39:52.19,1:39:54.61,Default,,0,0,0,,Мықты бол, Такаги-кун!
Dialogue: 0,1:39:54.69,1:39:57.44,Default,,0,0,0,,Хмм...
Dialogue: 0,1:39:57.53,1:39:58.45,Default,,0,0,0,,Уф
Dialogue: 0,1:39:58.53,1:40:00.07,Default,,0,0,0,,(Сергейдің орысшасы)
Dialogue: 0,1:40:00.16,1:40:01.07,Default,,0,0,0,,Ах
Dialogue: 0,1:40:02.87,1:40:05.29,Default,,0,0,0,,(ер орыс)
Dialogue: 0,1:40:10.54,1:40:11.79,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:23.26,1:40:25.93,Default,,0,0,0,,Ой-оу.
Dialogue: 0,1:40:31.19,1:40:33.11,Default,,0,0,0,,Қазір жақсы болуы керек.
Dialogue: 0,1:40:33.19,1:40:35.11,Default,,0,0,0,,Мен де осыны қайталадым.
Dialogue: 0,1:40:35.19,1:40:36.48,Default,,0,0,0,,Керемет
Dialogue: 0,1:40:36.57,1:40:37.99,Default,,0,0,0,,Тапсырма аяқталды.
Dialogue: 0,1:40:41.03,1:40:42.87,Default,,0,0,0,,Рахмет балалар
Dialogue: 0,1:40:46.70,1:40:48.58,Default,,0,0,0,,Сіз кімсіз? Сол қыз
Dialogue: 0,1:40:48.66,1:40:52.75,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:40:57.09,1:41:01.93,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,1:41:02.59,1:41:03.43,Default,,0,0,0,,Уф
Dialogue: 0,1:41:07.51,1:41:08.72,Default,,0,0,0,,Ха…
Dialogue: 0,1:41:14.40,1:41:15.36,Default,,0,0,0,,Ах
Dialogue: 0,1:41:15.44,1:41:17.36,Default,,0,0,0,,Пами
Dialogue: 0,1:41:21.11,1:41:23.74,Default,,0,0,0,,(Пойыздың тежегішінің дыбысы)
Dialogue: 0,1:41:27.62,1:41:29.29,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:41:29.37,1:41:33.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:35.88,1:41:38.09,Default,,0,0,0,,Мұндай жігіт шабуыл жасағанда…
Dialogue: 0,1:41:39.63,1:41:41.80,Default,,0,0,0,,А... тоқтады.
Dialogue: 0,1:41:42.42,1:41:47.55,Default,,0,0,0,,
Dialogue: 0,1:41:59.32,1:42:00.94,Default,,0,0,0,,Сен мұнда болғансың ғой.
Dialogue: 0,1:42:01.03,1:42:02.32,Default,,0,0,0,,Бірдеңе болатын сияқты ма?
Dialogue: 0,1:42:02.40,1:42:03.86,Default,,0,0,0,,Иә
Dialogue: 0,1:42:03.95,1:42:07.49,Default,,0,0,0,,Шамасы, оны шамамен бір сағатта толығымен бейтараптандыруға болады.
Dialogue: 0,1:42:07.57,1:42:10.12,Default,,0,0,0,,Қоғамдық қауіпсіздік күткендей, жұмыс жылдам.
Dialogue: 0,1:42:10.20,1:42:12.08,Default,,0,0,0,,Күтілгендей, бұл сізсіз.
Dialogue: 0,1:42:12.16,1:42:13.00,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:13.08,1:42:15.54,Default,,0,0,0,,Мен бұл қимыл туралы жиі ойлайтынмын.
Dialogue: 0,1:42:15.62,1:42:17.17,Default,,0,0,0,,Біреу маған түсініктеме берді.
Dialogue: 0,1:42:17.17,1:42:18.09,Default,,0,0,0,,Біреу маған түсініктеме берді.
Dialogue: 0,1:42:17.17,1:42:18.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:18.17,1:42:21.21,Default,,0,0,0,,Бұл баяғыда болды, бірақ...
Dialogue: 0,1:42:21.80,1:42:24.09,Default,,0,0,0,,(Жас орхидеяның айқайы)
Dialogue: 0,1:42:24.17,1:42:27.59,Default,,0,0,0,,Өйткені Шиничи допты бейтаныс жерден соқты.
Dialogue: 0,1:42:27.68,1:42:30.35,Default,,0,0,0,,Жылама, Ран, жарайды.
Dialogue: 0,1:42:30.43,1:42:31.27,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:42:31.35,1:42:33.56,Default,,0,0,0,,- (Жас Шиничи) Ах, боқ - (Жас Ран) Ах...
Dialogue: 0,1:42:33.64,1:42:35.56,Default,,0,0,0,,- (Хагивара) Бұл монах - (Жас Шиничи) Иә?
Dialogue: 0,1:42:36.81,1:42:39.06,Default,,0,0,0,,Мені жылатпа, қыз.
Dialogue: 0,1:42:39.15,1:42:41.36,Default,,0,0,0,,Иә? Эх...
Dialogue: 0,1:42:42.53,1:42:43.61,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:42:45.15,1:42:46.66,Default,,0,0,0,,Тоқтатылды!
Dialogue: 0,1:42:46.74,1:42:47.57,Default,,0,0,0,,Ах
Dialogue: 0,1:42:47.66,1:42:49.07,Default,,0,0,0,,Иә
Dialogue: 0,1:42:49.66,1:42:51.95,Default,,0,0,0,,Хаги сен не істеп жатырсың?
Dialogue: 0,1:42:52.04,1:42:54.37,Default,,0,0,0,,Цзиньпэй-чан, қоңырау шал! Су шаруашылығы бюросы
Dialogue: 0,1:42:54.45,1:42:55.58,Default,,0,0,0,,А? неге?
Dialogue: 0,1:42:57.17,1:42:59.08,Default,,0,0,0,,Кенет есіме түсті.
Dialogue: 0,1:42:59.17,1:43:03.42,Default,,0,0,0,,Олар егер мен бұл қолды пайдалансам, жарылысты тоқтата алатынымды айтты.
Dialogue: 0,1:43:03.51,1:43:07.68,Default,,0,0,0,,Бұл адам Хагивараға ұқсайды, солай ма?
Dialogue: 0,1:43:07.76,1:43:08.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:43:10.01,1:43:11.10,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,1:43:12.56,1:43:15.27,Default,,0,0,0,,Жоқ... шынымен емес.
Dialogue: 0,1:43:17.52,1:43:20.31,Default,,0,0,0,,Иә? Мен бір сәт бұрын сонда болдым
Dialogue: 0,1:43:20.40,1:43:22.48,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,1:43:22.57,1:43:25.36,Default,,0,0,0,,Біз сол адамдардың арқасында құтқарылдық!
Dialogue: 0,1:43:25.44,1:43:28.95,Default,,0,0,0,,Егер ол сонда болмағанда, Шибуя осы уақытқа дейін отты теңізге айналар еді.
Dialogue: 0,1:43:29.03,1:43:29.87,Default,,0,0,0,,Хмм...
Dialogue: 0,1:43:31.12,1:43:32.87,Default,,0,0,0,,Такаги-кун! Абайлаңыз
Dialogue: 0,1:43:32.95,1:43:35.12,Default,,0,0,0,,Ах... Сато мырза
Dialogue: 0,1:43:35.20,1:43:37.54,Default,,0,0,0,,Эй, мұнда маған көмектес!
Dialogue: 0,1:43:37.62,1:43:38.54,Default,,0,0,0,,Иә
Dialogue: 0,1:43:38.62,1:43:40.08,Default,,0,0,0,,Сато мырза...
Dialogue: 0,1:43:40.17,1:43:44.63,Default,,0,0,0,,Менің ойымша, осыдан кейін операция жасау керек шығар.
Dialogue: 0,1:43:44.71,1:43:45.88,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,1:43:45.96,1:43:49.47,Default,,0,0,0,,Маған жұмыс істеу үшін заклинание беріңіз...
Dialogue: 0,1:43:49.55,1:43:50.39,Default,,0,0,0,,Заклинание?
Dialogue: 0,1:43:54.89,1:43:56.18,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,1:43:56.27,1:43:58.89,Default,,0,0,0,,Егер сізде осындай энергия болса, менің ойымша, сізде бәрі жақсы болады.
Dialogue: 0,1:43:58.98,1:44:01.40,Default,,0,0,0,,Сато... Са...
Dialogue: 0,1:44:01.48,1:44:05.40,Default,,0,0,0,,- (Аюми/Мицухико) Ооо~ - (Гента) Маза...
Dialogue: 0,1:44:06.15,1:44:11.16,Default,,0,0,0,,♪~
Dialogue: 0,1:48:57.36,1:49:02.36,Default,,0,0,0,,~♪
Dialogue: 0,1:49:02.91,1:49:07.83,Default,,0,0,0,,(Сутра оқу)
Dialogue: 0,1:49:09.91,1:49:11.54,Default,,0,0,0,,Уф...
Dialogue: 0,1:49:16.04,1:49:17.09,Default,,0,0,0,,Такаги!
Dialogue: 0,1:49:17.17,1:49:20.42,Default,,0,0,0,,Не, сен өліп қалдың ғой! Ақымақ!
Dialogue: 0,1:49:20.51,1:49:22.55,Default,,0,0,0,,Ууууах!
Dialogue: 0,1:49:22.63,1:49:23.84,Default,,0,0,0,,Оны қорғаңыз!
Dialogue: 0,1:49:25.43,1:49:27.26,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,1:49:30.56,1:49:31.60,Default,,0,0,0,,Қаскөй!
Dialogue: 0,1:49:31.69,1:49:33.02,Default,,0,0,0,,Эй!
Dialogue: 0,1:49:33.10,1:49:36.15,Default,,0,0,0,,Барыңыз! Жарайды, бар!
Dialogue: 0,1:49:37.61,1:49:40.90,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:49:40.99,1:49:44.28,Default,,0,0,0,,Мен ауруханада біраз ұйықтадым, енді ше?
Dialogue: 0,1:49:44.36,1:49:46.03,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,1:49:46.12,1:49:49.62,Default,,0,0,0,,Келесі жолы олар аудан бастығының әжесінің жерлеуіне шабуыл жасайды.
Dialogue: 0,1:49:49.70,1:49:51.33,Default,,0,0,0,,Хабарлама болды!
Dialogue: 0,1:49:51.41,1:49:53.08,Default,,0,0,0,,Жаттығу деп босаңсуға болмайды!
Dialogue: 0,1:49:53.16,1:49:54.62,Default,,0,0,0,,Иә!
Dialogue: 0,1:49:55.54,1:49:59.92,Default,,0,0,0,,Мм... Менің бұлай киінуімнің мәні бар ма?
Dialogue: 0,1:50:00.01,1:50:01.26,Default,,0,0,0,,Эй!
Dialogue: 0,1:50:01.34,1:50:03.05,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:50:04.55,1:50:10.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory