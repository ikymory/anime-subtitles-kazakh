Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:09.94,0:02:13.54,Default,,0,0,0,,Синбад Синбад
Dialogue: 0,0:02:18.14,0:02:21.35,Default,,0,0,0,,Не болды, Элли Синдбад?
Dialogue: 0,0:02:21.35,0:02:24.55,Default,,0,0,0,,Жағада атаны су шайып кетті.
Dialogue: 0,0:03:08.79,0:03:11.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:11.23,0:03:13.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:16.94,0:03:20.31,Default,,0,0,0,,Сіз қалай ойлайсыз? Иә бәрібір
Dialogue: 0,0:03:20.31,0:03:22.51,Default,,0,0,0,,Алли, маған қол ұшын беріңіз.
Dialogue: 0,0:03:25.51,0:03:27.68,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:03:27.68,0:03:30.32,Default,,0,0,0,,Қайда?
Dialogue: 0,0:03:30.32,0:03:32.45,Default,,0,0,0,,Бұл Басар порты.
Dialogue: 0,0:03:32.45,0:03:35.25,Default,,0,0,0,,Жарайсың, ата.
Dialogue: 0,0:03:35.25,0:03:39.79,Default,,0,0,0,,Сіз көп қиындық тудырдыңыз.
Dialogue: 0,0:03:39.79,0:03:43.40,Default,,0,0,0,,Мен сенің көңіліңді көтеруге тырысамын. Өтінемін, мықты болыңыз.
Dialogue: 0,0:03:43.40,0:03:45.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:45.70,0:03:50.10,Default,,0,0,0,,Бұл енді маған жақсы емес
Dialogue: 0,0:03:56.18,0:04:02.38,Default,,0,0,0,,Балалар сендерге де кеме ұнайтын сияқты.
Dialogue: 0,0:04:05.35,0:04:09.49,Default,,0,0,0,,Дұрыс, мен қайыққа мінгім келеді, ата.
Dialogue: 0,0:04:09.49,0:04:12.36,Default,,0,0,0,,Мен керемет теңізші болғым келеді.
Dialogue: 0,0:04:12.36,0:04:15.26,Default,,0,0,0,,Менің қайтыс болған әкем сияқты
Dialogue: 0,0:04:15.26,0:04:18.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:18.53,0:04:22.97,Default,,0,0,0,,Мен де сіздің жасыңызда болдым.
Dialogue: 0,0:04:22.97,0:04:25.07,Default,,0,0,0,,Мен теңізге шықтым.
Dialogue: 0,0:04:27.11,0:04:30.41,Default,,0,0,0,,Мен қандай да бір қауіпке тап болсам да,
Dialogue: 0,0:04:30.41,0:04:36.21,Default,,0,0,0,,Өйткені, ол тек теңізшілер үшін жұмақ болған.
Dialogue: 0,0:04:38.38,0:04:40.68,Default,,0,0,0,,Мен теңізді сағындым
Dialogue: 0,0:04:42.69,0:04:45.76,Default,,0,0,0,,Ер адамның аяқ киімі
Dialogue: 0,0:04:45.76,0:04:48.86,Default,,0,0,0,,Себебі менің арманым бар
Dialogue: 0,0:04:51.13,0:04:54.60,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:04:54.60,0:05:00.70,Default,,0,0,0,,Мен сендерге ерекше оқиға айтып берейін.
Dialogue: 0,0:05:07.25,0:05:11.95,Default,,0,0,0,,Бұл баяғыда болды
Dialogue: 0,0:05:11.95,0:05:15.75,Default,,0,0,0,,Бұл белгілі бір оңтүстік арал туралы.
Dialogue: 0,0:05:17.86,0:05:23.36,Default,,0,0,0,,Аспанда біртүрлі оқиға болды.
Dialogue: 0,0:05:26.87,0:05:32.60,Default,,0,0,0,,Оны ешкім көрмеген сияқты.
Dialogue: 0,0:05:32.60,0:05:38.21,Default,,0,0,0,,Сол аралға жұлдыз түсті
Dialogue: 0,0:05:38.21,0:05:44.71,Default,,0,0,0,,Аралда біртүрлі жарылыс болды.
Dialogue: 0,0:05:46.79,0:05:50.59,Default,,0,0,0,,Демек, аралдың пішіні
Dialogue: 0,0:05:50.59,0:05:54.36,Default,,0,0,0,,Толығымен өзгертілді
Dialogue: 0,0:05:54.36,0:05:56.83,Default,,0,0,0,,Кейбір аңғарлар т.б.
Dialogue: 0,0:05:56.83,0:06:02.13,Default,,0,0,0,,Жарқыраған тастармен бүгілген
Dialogue: 0,0:06:02.13,0:06:06.67,Default,,0,0,0,,Ал асыл тас
Dialogue: 0,0:06:06.67,0:06:12.98,Default,,0,0,0,,Қорқынышты құбыжықтармен қорғалған
Dialogue: 0,0:06:12.98,0:06:16.52,Default,,0,0,0,,Бұл қазірдің өзінде...
Dialogue: 0,0:06:16.52,0:06:19.62,Default,,0,0,0,,Уу-у...
Dialogue: 0,0:06:29.86,0:06:31.86,Default,,0,0,0,,Ата ата
Dialogue: 0,0:06:57.42,0:07:01.66,Default,,0,0,0,,Иә! Ия хахаха
Dialogue: 0,0:07:01.66,0:07:04.83,Default,,0,0,0,,Эй, мен үйсізбін.
Dialogue: 0,0:07:04.83,0:07:07.17,Default,,0,0,0,,Сен онда күнде не істеп жүрсің?
Dialogue: 0,0:07:07.17,0:07:09.17,Default,,0,0,0,,Ол қайыққа мінгісі келеді.
Dialogue: 0,0:07:09.17,0:07:13.21,Default,,0,0,0,,Хаха, хмм, бұл мүмкін емес.
Dialogue: 0,0:07:13.21,0:07:15.81,Default,,0,0,0,,Мен кішкентай баламын.
Dialogue: 0,0:07:15.81,0:07:18.31,Default,,0,0,0,,Бұл жігіт! сәуле!
Dialogue: 0,0:07:18.31,0:07:20.31,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:07:20.31,0:07:23.78,Default,,0,0,0,,Иә! Ия ия
Dialogue: 0,0:07:23.78,0:07:26.28,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:07:28.82,0:07:32.02,Default,,0,0,0,,Ей! Мұнда! не істеу керек
Dialogue: 0,0:07:32.02,0:07:34.32,Default,,0,0,0,,Ах! Ия
Dialogue: 0,0:07:42.33,0:07:45.43,Default,,0,0,0,,Алли, көңіл көтер.
Dialogue: 0,0:08:22.04,0:08:24.04,Default,,0,0,0,,Сәлеметсіз бе аға
Dialogue: 0,0:08:27.91,0:08:30.48,Default,,0,0,0,,Мм, капитан ше?
Dialogue: 0,0:08:30.48,0:08:32.48,Default,,0,0,0,,Мына жерде.
Dialogue: 0,0:08:34.75,0:08:36.75,Default,,0,0,0,,Капитан
Dialogue: 0,0:08:38.76,0:08:41.06,Default,,0,0,0,,Бұл не, балалар?
Dialogue: 0,0:08:41.06,0:08:43.06,Default,,0,0,0,,Сәлем, капитан.
Dialogue: 0,0:08:43.06,0:08:46.00,Default,,0,0,0,,Бізді осы кемеде пайдаланыңыз.
Dialogue: 0,0:08:46.00,0:08:49.90,Default,,0,0,0,,Жоқ, балалар әлі істей алмайсыңдар.
Dialogue: 0,0:08:49.90,0:08:52.54,Default,,0,0,0,,Бұған орын жоқ.
Dialogue: 0,0:08:52.54,0:08:55.94,Default,,0,0,0,,Жоқ? О
Dialogue: 0,0:08:55.94,0:08:57.94,Default,,0,0,0,,Бас тарту.
Dialogue: 0,0:09:13.93,0:09:17.63,Default,,0,0,0,,Желкенге шығуға дайын!
Dialogue: 0,0:09:17.63,0:09:20.73,Default,,0,0,0,,Ұшуға дайындық
Dialogue: 0,0:09:45.92,0:09:48.92,Default,,0,0,0,,Желкенді жібер!
Dialogue: 0,0:10:22.76,0:10:27.77,Default,,0,0,0,,О, сағыныш порты, қош бол
Dialogue: 0,0:10:27.77,0:10:33.37,Default,,0,0,0,,Ғұн, менің қыздарым сонша, артымда қалдырғым келмейді.
Dialogue: 0,0:10:33.37,0:10:36.07,Default,,0,0,0,,Хахаха, қате жоқ.
Dialogue: 0,0:10:46.95,0:10:49.55,Default,,0,0,0,,Алла Ұлы
Dialogue: 0,0:10:49.55,0:10:56.43,Default,,0,0,0,,Алладан басқаға құлшылық етпеуге ант етемін.
Dialogue: 0,0:10:56.43,0:11:00.63,Default,,0,0,0,,Бейбіт сапарыңыз болады деп үміттенемін.
Dialogue: 0,0:11:15.15,0:11:18.25,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:18.25,0:11:21.99,Default,,0,0,0,,Бітті, жарайды.
Dialogue: 0,0:11:21.99,0:11:24.89,Default,,0,0,0,,Аз ғана.
Dialogue: 0,0:11:27.96,0:11:29.96,Default,,0,0,0,,Кимоноым шаңмен кірленді.
Dialogue: 0,0:11:36.77,0:11:39.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:46.28,0:11:49.35,Default,,0,0,0,,Бұл не, мысық?
Dialogue: 0,0:11:49.35,0:11:52.45,Default,,0,0,0,,Бастық болмаңыз
Dialogue: 0,0:11:52.45,0:11:54.45,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:11:59.56,0:12:02.53,Default,,0,0,0,,Я... Ясым, кел.
Dialogue: 0,0:12:02.53,0:12:04.96,Default,,0,0,0,,Уф…
Dialogue: 0,0:12:04.96,0:12:06.97,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:06.97,0:12:08.97,Default,,0,0,0,,Мен жартылай ұйықтап қалдым
Dialogue: 0,0:12:18.64,0:12:20.94,Default,,0,0,0,,Міне, Ясым.
Dialogue: 0,0:12:25.25,0:12:27.25,Default,,0,0,0,,Әке, мен кеттім!
Dialogue: 0,0:12:34.93,0:12:37.13,Default,,0,0,0,,Не?
Dialogue: 0,0:12:37.13,0:12:39.63,Default,,0,0,0,,Бұл жігіт күндізгі бөбек емес пе?
Dialogue: 0,0:12:42.17,0:12:44.17,Default,,0,0,0,,Кешіріңіз, ағай.
Dialogue: 0,0:12:44.17,0:12:48.37,Default,,0,0,0,,Мен бұл бейбақты шошытып, теңізге лақтырамын!
Dialogue: 0,0:12:48.37,0:12:51.24,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:12:51.24,0:12:53.84,Default,,0,0,0,,Не, саған әлі де ұнамай ма?
Dialogue: 0,0:13:01.39,0:13:05.16,Default,,0,0,0,,Жарақаттары салыстырмалы түрде жеңіл болған Тодороки…
Dialogue: 0,0:13:05.16,0:13:07.83,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:13:07.83,0:13:13.03,Default,,0,0,0,,Капитан, мына бейбақтар біздің жүгімізге тығылып, бізді емдеді.
Dialogue: 0,0:13:13.03,0:13:16.07,Default,,0,0,0,,Сіз не істейсіз? капитан
Dialogue: 0,0:13:16.07,0:13:18.07,Default,,0,0,0,,Өзін көрсету үшін теңізге бару...
Dialogue: 0,0:13:18.07,0:13:20.07,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:13:27.71,0:13:30.75,Default,,0,0,0,,Балалар, сендер қалай болдыңдар?
Dialogue: 0,0:13:30.75,0:13:33.79,Default,,0,0,0,,Шын мәнінде кілемде
Dialogue: 0,0:13:33.79,0:13:38.59,Default,,0,0,0,,Ах, ақыры төтенше шара.
Dialogue: 0,0:13:38.59,0:13:41.29,Default,,0,0,0,,Иә, кешіріңіз, капитан.
Dialogue: 0,0:13:49.67,0:13:53.67,Default,,0,0,0,,Хахаха мен сендерден жеңіліп қалдым.
Dialogue: 0,0:14:02.21,0:14:06.59,Default,,0,0,0,,Балалар, мына екеуін жақсы жаттықтырыңдар.
Dialogue: 0,0:14:06.59,0:14:09.09,Default,,0,0,0,,Өйткені бастама маңызды
Dialogue: 0,0:14:09.09,0:14:12.29,Default,,0,0,0,,Эй, мұны маған қалдырыңыз, капитан.
Dialogue: 0,0:15:01.97,0:15:03.98,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:15:03.98,0:15:06.95,Default,,0,0,0,,Пеппи, сен мұны істедің.
Dialogue: 0,0:15:06.95,0:15:09.65,Default,,0,0,0,,Сәлем! Жалқау болмаңыз
Dialogue: 0,0:15:24.96,0:15:28.50,Default,,0,0,0,,Иә, сен керексіз баласың.
Dialogue: 0,0:15:28.50,0:15:30.80,Default,,0,0,0,,Менің не істеп жатқаныма мұқият қараңыз.
Dialogue: 0,0:15:37.81,0:15:41.11,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,0:15:43.98,0:15:45.98,Default,,0,0,0,,Айтатата!
Dialogue: 0,0:15:45.98,0:15:49.22,Default,,0,0,0,,Хе хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи
Dialogue: 0,0:15:49.22,0:15:54.13,Default,,0,0,0,,Хмф, сізде мұндай жағдайға жол бермеу үшін абай болу керек.
Dialogue: 0,0:15:54.13,0:15:56.23,Default,,0,0,0,,Иә, доктор Абдаллах.
Dialogue: 0,0:16:00.73,0:16:02.87,Default,,0,0,0,,Синдбад
Dialogue: 0,0:16:02.87,0:16:06.07,Default,,0,0,0,,Ішіңіздегі күшпен өрмелеңіз.
Dialogue: 0,0:16:10.44,0:16:12.74,Default,,0,0,0,,Сәлем! төмен қарама
Dialogue: 0,0:16:19.28,0:16:21.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:30.30,0:16:33.50,Default,,0,0,0,,Эй Синдбад, тыныштал.
Dialogue: 0,0:16:33.50,0:16:35.60,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:16:52.92,0:16:59.16,Default,,0,0,0,,Осы теңіздің түбінде
Dialogue: 0,0:16:59.16,0:17:05.36,Default,,0,0,0,,Жұмбақ бар
Dialogue: 0,0:17:05.36,0:17:11.40,Default,,0,0,0,,Толқындардың астында
Dialogue: 0,0:17:11.40,0:17:17.24,Default,,0,0,0,,Сағыныш бар
Dialogue: 0,0:17:17.24,0:17:23.68,Default,,0,0,0,,Бәріміз кеттік.
Dialogue: 0,0:17:23.68,0:17:30.59,Default,,0,0,0,,Барлығымыз кеттік...
Dialogue: 0,0:17:30.59,0:17:36.66,Default,,0,0,0,,Ай сәулесінде
Dialogue: 0,0:17:36.66,0:17:45.16,Default,,0,0,0,,Жұлдыздардың көлеңкесінде
Dialogue: 0,0:18:05.96,0:18:08.59,Default,,0,0,0,,Синдбад
Dialogue: 0,0:18:08.59,0:18:10.83,Default,,0,0,0,,Не, Алли?
Dialogue: 0,0:18:10.83,0:18:13.63,Default,,0,0,0,,Мұнда келе жатырмын
Dialogue: 0,0:18:16.50,0:18:20.51,Default,,0,0,0,,Ах, бұл кит баласы.
Dialogue: 0,0:18:20.51,0:18:22.51,Default,,0,0,0,,Не, не, не, не?
Dialogue: 0,0:18:22.51,0:18:24.81,Default,,0,0,0,,А, бұл араланған акула.
Dialogue: 0,0:18:29.68,0:18:31.98,Default,,0,0,0,,Абдаллах Бұл гарпун Бұл гарпун
Dialogue: 0,0:18:31.98,0:18:33.98,Default,,0,0,0,,Жарайды, міне келді.
Dialogue: 0,0:18:43.80,0:18:47.53,Default,,0,0,0,,Кит баласына қауіп төніп тұр, Синдбад.
Dialogue: 0,0:18:47.53,0:18:51.23,Default,,0,0,0,,Жолдан кет, қолыма қара.
Dialogue: 0,0:18:53.94,0:18:57.21,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:57.21,0:18:59.21,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:19:07.02,0:19:09.95,Default,,0,0,0,,Жарайды, бейбақ.
Dialogue: 0,0:19:09.95,0:19:13.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:13.29,0:19:15.96,Default,,0,0,0,,Жаман
Dialogue: 0,0:19:15.96,0:19:18.63,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:18.63,0:19:20.93,Default,,0,0,0,,Ей! Жақсы, дәмді
Dialogue: 0,0:19:27.14,0:19:30.18,Default,,0,0,0,,Бұл керемет, Синдбад.
Dialogue: 0,0:19:30.18,0:19:32.81,Default,,0,0,0,,Әдемі әзіл айтып жатырсың ғой, солай ма?
Dialogue: 0,0:19:32.81,0:19:36.61,Default,,0,0,0,,Хун, менің дайындығыма қалай қарайсың?
Dialogue: 0,0:19:40.62,0:19:43.52,Default,,0,0,0,,Саған жақсы, Кит-кун.
Dialogue: 0,0:19:50.09,0:19:52.39,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:20:17.89,0:20:20.46,Default,,0,0,0,,Жарақаттары салыстырмалы түрде жеңіл болған Тодороки…
Dialogue: 0,0:20:20.46,0:20:23.16,Default,,0,0,0,,Жақындап барады
Dialogue: 0,0:20:23.16,0:20:25.23,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:20:25.23,0:20:28.63,Default,,0,0,0,,Руль!
Dialogue: 0,0:20:28.63,0:20:31.73,Default,,0,0,0,,Руль
Dialogue: 0,0:20:56.76,0:21:03.90,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:21:03.90,0:21:11.04,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:21:11.04,0:21:18.32,Default,,0,0,0,,Үйдің тіректері де
Dialogue: 0,0:21:18.32,0:21:25.36,Default,,0,0,0,,Әдемі бақ
Dialogue: 0,0:21:25.36,0:21:32.36,Default,,0,0,0,,Барлық сұр
Dialogue: 0,0:21:32.36,0:21:39.50,Default,,0,0,0,,Қараңғыда жабық
Dialogue: 0,0:21:39.50,0:21:46.91,Default,,0,0,0,,Менің жүрегім
Dialogue: 0,0:21:46.91,0:21:55.25,Default,,0,0,0,,Қалың тұманда
Dialogue: 0,0:21:55.25,0:21:59.26,Default,,0,0,0,,Патша, сіз қоңырау шалып жатырсыз ба?
Dialogue: 0,0:21:59.26,0:22:01.56,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:22:01.56,0:22:05.16,Default,,0,0,0,,Ханшайым қайта-қайта жүрген сияқты.
Dialogue: 0,0:22:05.16,0:22:09.13,Default,,0,0,0,,Иә, мен ханшайымға дайынмын.
Dialogue: 0,0:22:09.13,0:22:13.07,Default,,0,0,0,,Хехехе, сен қолыңды күйдірдім дейсің бе?
Dialogue: 0,0:22:13.07,0:22:15.64,Default,,0,0,0,,Иә, сен таптың.
Dialogue: 0,0:22:15.64,0:22:19.04,Default,,0,0,0,,Хмм, әлі де бар.
Dialogue: 0,0:22:19.04,0:22:21.31,Default,,0,0,0,,Әйел алғыңыз келе ме?
Dialogue: 0,0:22:21.31,0:22:24.31,Default,,0,0,0,,Сонымен қатар...
Dialogue: 0,0:22:26.25,0:22:28.25,Default,,0,0,0,,Хо хо хо хо
Dialogue: 0,0:23:04.99,0:23:09.23,Default,,0,0,0,,Ертеде Түркия патшасы
Dialogue: 0,0:23:09.23,0:23:13.20,Default,,0,0,0,,Сыбызғыны үрлеп, айтты
Dialogue: 0,0:23:13.20,0:23:17.07,Default,,0,0,0,,Әйелдер тіпті қарағысы да келмейді.
Dialogue: 0,0:23:17.07,0:23:21.01,Default,,0,0,0,,Мен тамақтан шаршадым
Dialogue: 0,0:23:21.01,0:23:25.14,Default,,0,0,0,,Маған әдемі кимоно керек
Dialogue: 0,0:23:25.14,0:23:29.58,Default,,0,0,0,,Ешкімде жоқ кимоно
Dialogue: 0,0:23:29.58,0:23:33.65,Default,,0,0,0,,Бұл менің қызметшім
Dialogue: 0,0:23:33.65,0:23:37.05,Default,,0,0,0,,Сіз де жақындаңыз.
Dialogue: 0,0:23:37.05,0:23:41.26,Default,,0,0,0,,Біршама біраз
Dialogue: 0,0:23:41.26,0:23:45.96,Default,,0,0,0,,Сіз де жақындаңыз.
Dialogue: 0,0:23:58.88,0:24:02.38,Default,,0,0,0,,Синдбад, оны маған қарызға бер.
Dialogue: 0,0:24:02.38,0:24:05.18,Default,,0,0,0,,Мені одан бетер не нәрсеге айналдыратынын тыңдауға рұқсат етіңіз.
Dialogue: 0,0:24:08.65,0:24:10.69,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:24:10.69,0:24:13.89,Default,,0,0,0,,Құлағыңызды мұқият таңдап, тыңдаңыз.
Dialogue: 0,0:24:22.37,0:24:25.54,Default,,0,0,0,,Енді, бұл жұмбақ гитара
Dialogue: 0,0:24:25.54,0:24:30.68,Default,,0,0,0,,Мен теңізші едім, бір күні шағын қайықтың рульінде болдым.
Dialogue: 0,0:24:30.68,0:24:34.05,Default,,0,0,0,,Теңізге шығу кезінде
Dialogue: 0,0:24:34.05,0:24:37.01,Default,,0,0,0,,О, арал бар.
Dialogue: 0,0:24:37.01,0:24:40.22,Default,,0,0,0,,Егер сіз зәкірді соққымен лақтырсаңыз
Dialogue: 0,0:24:40.22,0:24:43.82,Default,,0,0,0,,Қандай тосын, бұл арал емес!
Dialogue: 0,0:24:43.82,0:24:47.09,Default,,0,0,0,,Бұл үлкен кит болды
Dialogue: 0,0:24:47.09,0:24:49.66,Default,,0,0,0,,Аспанға биікте самғау
Dialogue: 0,0:24:49.66,0:24:53.70,Default,,0,0,0,,Ах! Мені кит жұтып қойды, бірақ
Dialogue: 0,0:24:53.70,0:24:56.67,Default,,0,0,0,,Ақырында мен бұл дүниеге қайтамын.
Dialogue: 0,0:24:56.67,0:25:00.30,Default,,0,0,0,,Сол кезде киттің қарнынан
Dialogue: 0,0:25:00.30,0:25:03.74,Default,,0,0,0,,Мен бұл гитараны өзіммен бірге алып келдім.
Dialogue: 0,0:25:03.74,0:25:06.71,Default,,0,0,0,,Оны ойнаған бойда
Dialogue: 0,0:25:06.71,0:25:10.38,Default,,0,0,0,,Алдарыңызда алтын, күміс, гауһар тастар
Dialogue: 0,0:25:10.38,0:25:13.55,Default,,0,0,0,,Бұл гитара қаншалықты жұмбақ?
Dialogue: 0,0:25:13.55,0:25:16.65,Default,,0,0,0,,Қандай жұмбақ гитара...
Dialogue: 0,0:25:16.65,0:25:18.65,Default,,0,0,0,,Бұл гитара
Dialogue: 0,0:25:31.50,0:25:34.97,Default,,0,0,0,,Хмм
Dialogue: 0,0:25:34.97,0:25:37.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:37.28,0:25:39.74,Default,,0,0,0,,Ммм
Dialogue: 0,0:25:39.74,0:25:41.74,Default,,0,0,0,,Хмм
Dialogue: 0,0:25:56.49,0:25:59.89,Default,,0,0,0,,Оохохохо оххохохо
Dialogue: 0,0:26:14.55,0:26:16.85,Default,,0,0,0,,Король
Dialogue: 0,0:26:16.85,0:26:19.45,Default,,0,0,0,,Бұл не, министр?
Dialogue: 0,0:26:19.45,0:26:24.09,Default,,0,0,0,,Негізі мен тағы бір жұмбақ қазына таптым.
Dialogue: 0,0:26:24.09,0:26:27.22,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:26:27.22,0:26:29.72,Default,,0,0,0,,Иә? Жақында көрсет
Dialogue: 0,0:26:37.37,0:26:43.11,Default,,0,0,0,,Министр: Бұл сиқырлы гитара ма? иә?
Dialogue: 0,0:26:43.11,0:26:45.11,Default,,0,0,0,,Қош бол
Dialogue: 0,0:26:45.11,0:26:47.58,Default,,0,0,0,,Жоқ, мүлде емес.
Dialogue: 0,0:26:47.58,0:26:51.85,Default,,0,0,0,,Өтірік айтсаң... Әй, күт, күт.
Dialogue: 0,0:26:51.85,0:26:55.55,Default,,0,0,0,,Оны шерткен соң, алтын-күміс қазыналарды табасың.
Dialogue: 0,0:26:55.55,0:26:59.46,Default,,0,0,0,,Өз қалауыңыз бойынша емес пе?
Dialogue: 0,0:26:59.46,0:27:01.56,Default,,0,0,0,,Оны бірден ойнайық
Dialogue: 0,0:27:15.64,0:27:19.38,Default,,0,0,0,,Әй, министр, ештеңе болып жатқан жоқ па?
Dialogue: 0,0:27:19.38,0:27:23.15,Default,,0,0,0,,Патша, бұл жалған ән болса керек.
Dialogue: 0,0:27:23.15,0:27:26.05,Default,,0,0,0,,Жоқ, қай әнді айтсам да, солай...
Dialogue: 0,0:27:26.05,0:27:30.09,Default,,0,0,0,,Дұрыс. Бұл жай ғана гитара.
Dialogue: 0,0:27:30.09,0:27:33.52,Default,,0,0,0,,Қатты өтірік айтсаң, мен сені босқа жібермеймін.
Dialogue: 0,0:27:33.52,0:27:36.62,Default,,0,0,0,,Бір қорқынышты нәрсе болды.
Dialogue: 0,0:27:49.17,0:27:51.44,Default,,0,0,0,,Министр
Dialogue: 0,0:27:51.44,0:27:54.31,Default,,0,0,0,,Жазықсызды кінәлама
Dialogue: 0,0:27:54.31,0:27:58.78,Default,,0,0,0,,Сіз айтқандай, бұл ханшайымның пайда болуы үшін перде емес.
Dialogue: 0,0:27:58.78,0:28:01.42,Default,,0,0,0,,Министр, жеткілікті.
Dialogue: 0,0:28:01.42,0:28:04.62,Default,,0,0,0,,Жоқ, тағы да жауап алайық.
Dialogue: 0,0:28:34.02,0:28:37.35,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:28:37.35,0:28:39.35,Default,,0,0,0,,Әй, әуре болма.
Dialogue: 0,0:28:44.30,0:28:46.30,Default,,0,0,0,,Иә
Dialogue: 0,0:28:51.94,0:28:54.31,Default,,0,0,0,,Бізбен не істемексің?
Dialogue: 0,0:28:54.31,0:28:56.37,Default,,0,0,0,,Хехехе
Dialogue: 0,0:28:56.37,0:28:58.37,Default,,0,0,0,,Жоғары мәртебелі
Dialogue: 0,0:29:01.75,0:29:04.28,Default,,0,0,0,,Мен баланы таба алмай жатырмын
Dialogue: 0,0:29:04.28,0:29:07.48,Default,,0,0,0,,Иә, бұл ақымақ, бірақ мен мұқият іздеймін.
Dialogue: 0,0:29:17.46,0:29:19.46,Default,,0,0,0,,Хун
Dialogue: 0,0:29:42.65,0:29:46.15,Default,,0,0,0,,Куппи, сен қайда ойнадың?
Dialogue: 0,0:29:52.43,0:29:54.43,Default,,0,0,0,,Не болды? Кубок
Dialogue: 0,0:29:56.67,0:29:58.77,Default,,0,0,0,,Жақсы
Dialogue: 0,0:29:58.77,0:30:00.87,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:30:00.87,0:30:02.87,Default,,0,0,0,,Тыныш
Dialogue: 0,0:30:10.45,0:30:13.85,Default,,0,0,0,,Бұл қызықты естіледі.
Dialogue: 0,0:30:13.85,0:30:17.76,Default,,0,0,0,,Олардың барлығы жақсы адамдар.
Dialogue: 0,0:30:17.76,0:30:20.99,Default,,0,0,0,,Мен қызғанамын. Мен сенімен барғым келеді...
Dialogue: 0,0:30:20.99,0:30:22.99,Default,,0,0,0,,О, «екі ел арасындағы неке жақын арада болады» дедің бе?
Dialogue: 0,0:30:32.50,0:30:35.21,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:30:35.21,0:30:37.78,Default,,0,0,0,,Сіз ұл баланы білесіз бе?
Dialogue: 0,0:30:37.78,0:30:41.55,Default,,0,0,0,,Жоқ, білмеймін.
Dialogue: 0,0:30:41.55,0:30:43.85,Default,,0,0,0,,Егер сіз жасырсаңыз...
Dialogue: 0,0:30:48.82,0:30:52.39,Default,,0,0,0,,(жөтел жөтел)\NМен бұл
Dialogue: 0,0:30:52.39,0:30:55.19,Default,,0,0,0,,Хехехе
Dialogue: 0,0:30:55.19,0:30:57.19,Default,,0,0,0,,деп ойладым
Dialogue: 0,0:31:00.80,0:31:05.14,Default,,0,0,0,,Бала, шық! Жоқ, жоқ, кеттік.
Dialogue: 0,0:31:05.14,0:31:07.34,Default,,0,0,0,,Адал мойындау
Dialogue: 0,0:31:07.34,0:31:09.34,Default,,0,0,0,,Мен айтайын. Мен айтайын.
Dialogue: 0,0:31:11.41,0:31:13.88,Default,,0,0,0,,Білесіз бе, хмм.
Dialogue: 0,0:31:13.88,0:31:18.32,Default,,0,0,0,,Бұл оңтүстікке дейін.
Dialogue: 0,0:31:18.32,0:31:21.52,Default,,0,0,0,,Хмм, жұмбақ аралда.
Dialogue: 0,0:31:21.52,0:31:23.52,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:31:27.86,0:31:30.46,Default,,0,0,0,,Әй, балақай, күте тұр.
Dialogue: 0,0:31:30.46,0:31:33.43,Default,,0,0,0,,Менің қашып кетуіме жол берме. Мені қу!
Dialogue: 0,0:31:33.43,0:31:35.80,Default,,0,0,0,,Тоқта, балақай, күт!
Dialogue: 0,0:31:35.80,0:31:39.60,Default,,0,0,0,,Күте тұрыңыз! Күте тұрыңыз, күтіңіз
Dialogue: 0,0:31:39.60,0:31:43.41,Default,,0,0,0,,Дүрбелеңге салынбаңыз. Бұл біртүрлі. Қайда бардың? Ана жерде? Бұл жолмен?
Dialogue: 0,0:31:43.41,0:31:47.04,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:31:47.04,0:31:49.04,Default,,0,0,0,,Уф, мына жігіт!
Dialogue: 0,0:31:54.25,0:31:56.75,Default,,0,0,0,,Әй, кішкентай бала!
Dialogue: 0,0:33:00.99,0:33:03.19,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:33:32.95,0:33:35.05,Default,,0,0,0,,Уау...
Dialogue: 0,0:33:40.22,0:33:42.82,Default,,0,0,0,,А, бұл не?
Dialogue: 0,0:33:55.44,0:33:57.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:10.69,0:34:14.09,Default,,0,0,0,,Уау, бұл керемет
Dialogue: 0,0:34:26.44,0:34:30.24,Default,,0,0,0,,Не? Қазірдің өзінде бітті ме?
Dialogue: 0,0:34:30.24,0:34:33.01,Default,,0,0,0,,Әйтете!
Dialogue: 0,0:34:33.01,0:34:37.38,Default,,0,0,0,,Ақша? Менде ақша жоқ
Dialogue: 0,0:34:37.38,0:34:39.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:23.03,0:35:25.03,Default,,0,0,0,,Рахмет Куппи
Dialogue: 0,0:35:27.97,0:35:30.70,Default,,0,0,0,,Не? Элли?
Dialogue: 0,0:35:30.70,0:35:34.07,Default,,0,0,0,,Ол үшін Эллиге көмектесіңіз.
Dialogue: 0,0:35:34.07,0:35:36.07,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:35:44.08,0:35:50.05,Default,,0,0,0,,А-а-а-а-а-а
Dialogue: 0,0:35:50.05,0:35:54.02,Default,,0,0,0,,Қарғыс атсын! Маған қалағаныңызша беріңізші.
Dialogue: 0,0:35:54.02,0:35:56.72,Default,,0,0,0,,Шулы, тыныш бол
Dialogue: 0,0:36:00.16,0:36:03.96,Default,,0,0,0,,Сен мүлде жақсы емессің, боқтық ән айтып тұрсың.
Dialogue: 0,0:36:10.04,0:36:12.08,Default,,0,0,0,,Аллиге не болды?
Dialogue: 0,0:36:12.08,0:36:15.35,Default,,0,0,0,,Ол жылдам жігіт.
Dialogue: 0,0:36:15.35,0:36:17.35,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:36:25.49,0:36:29.49,Default,,0,0,0,,Еңбегіңізге рахмет, міне, ханшайым.
Dialogue: 0,0:36:29.49,0:36:33.19,Default,,0,0,0,,Мен сізге сыйлық беруді ойлап отырмын.
Dialogue: 0,0:36:35.50,0:36:37.70,Default,,0,0,0,,Кешіріңіз, ханшайым.
Dialogue: 0,0:37:00.02,0:37:02.06,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:37:02.06,0:37:04.93,Default,,0,0,0,,Рахмет
Dialogue: 0,0:37:04.93,0:37:06.93,Default,,0,0,0,,Аулада жылқы бар
Dialogue: 0,0:37:23.78,0:37:27.25,Default,,0,0,0,,Кеттік
Dialogue: 0,0:37:27.25,0:37:30.35,Default,,0,0,0,,Жарайды, иә! Айтата
Dialogue: 0,0:37:32.26,0:37:34.26,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:37:48.07,0:37:50.07,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,0:37:55.28,0:37:57.28,Default,,0,0,0,,Күтіңіз, тоқтаңыз
Dialogue: 0,0:37:59.35,0:38:01.45,Default,,0,0,0,,Күте тұрыңыз! Күте тұрыңыз
Dialogue: 0,0:38:03.39,0:38:08.09,Default,,0,0,0,,Ал, мен қазір жүзуім керек.
Dialogue: 0,0:38:32.42,0:38:34.42,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:38:48.90,0:38:53.50,Default,,0,0,0,,Сәлем Синбад Синбад!
Dialogue: 0,0:38:53.50,0:38:55.80,Default,,0,0,0,,Синдбад!
Dialogue: 0,0:39:41.32,0:39:43.92,Default,,0,0,0,,А... аа!
Dialogue: 0,0:39:58.17,0:40:01.17,Default,,0,0,0,,Ой, қош бол
Dialogue: 0,0:40:04.17,0:40:06.61,Default,,0,0,0,,Бұл бала, бұл бала, ана жерде ұшып келеді.
Dialogue: 0,0:40:06.61,0:40:08.61,Default,,0,0,0,,Бұл сиқырлы қауырсын.
Dialogue: 0,0:40:15.09,0:40:17.99,Default,,0,0,0,,Иә, қарғыс атқыр бала.
Dialogue: 0,0:40:22.26,0:40:25.86,Default,,0,0,0,,Олардың барлығы жақсы адамдар.
Dialogue: 0,0:40:34.07,0:40:36.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:36.57,0:40:41.04,Default,,0,0,0,,Ханшайым, мен сіздің теңізшілерді қашуға рұқсат еткеніңізді естідім.
Dialogue: 0,0:40:41.04,0:40:46.52,Default,,0,0,0,,Өйткені, әке, министр қатты ашуланды.
Dialogue: 0,0:40:46.52,0:40:50.02,Default,,0,0,0,,Сенің әкең менің де әкем. Мұндай министрге қалай сенуге болады?
Dialogue: 0,0:40:54.06,0:40:57.46,Default,,0,0,0,,О, өте өрескел көрінеді.
Dialogue: 0,0:41:06.34,0:41:09.24,Default,,0,0,0,,Эй
Dialogue: 0,0:41:09.24,0:41:11.24,Default,,0,0,0,,Эй, бұл Элли.
Dialogue: 0,0:41:11.24,0:41:15.05,Default,,0,0,0,,Бұл жақсы нәрсе, уайымдама.
Dialogue: 0,0:41:15.05,0:41:17.95,Default,,0,0,0,,Менің дайындығым қалай?
Dialogue: 0,0:41:26.42,0:41:30.72,Default,,0,0,0,,Жарайды, жүзуге дайын!
Dialogue: 0,0:42:22.41,0:42:27.32,Default,,0,0,0,,Патша, бұл үлкен мәселе. Мен ханшайымды көре алмаймын.
Dialogue: 0,0:42:27.32,0:42:29.99,Default,,0,0,0,,Не? Ханшайым бар емес пе?
Dialogue: 0,0:42:29.99,0:42:32.26,Default,,0,0,0,,Біз не істеуіміз керек, министр?
Dialogue: 0,0:42:32.26,0:42:35.46,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:42:41.83,0:42:44.43,Default,,0,0,0,,Синбад Ах
Dialogue: 0,0:42:46.77,0:42:48.77,Default,,0,0,0,,Сіз Самир ханшайымсыз
Dialogue: 0,0:43:01.62,0:43:05.59,Default,,0,0,0,,Неге келдің, өтінемін?
Dialogue: 0,0:43:05.59,0:43:09.46,Default,,0,0,0,,Мені өзіңізбен бірге алып кетіңіз, ә?
Dialogue: 0,0:43:09.46,0:43:11.46,Default,,0,0,0,,Сен маған үйге барайын деп тұрсың ба?
Dialogue: 0,0:43:31.82,0:43:35.25,Default,,0,0,0,,Хмм.
Dialogue: 0,0:43:35.25,0:43:38.05,Default,,0,0,0,,Иә? Бұл не жігіт?
Dialogue: 0,0:43:41.59,0:43:44.29,Default,,0,0,0,,Сәлем
Dialogue: 0,0:43:46.40,0:43:48.80,Default,,0,0,0,,Хмф, сіз оны уақытында орындамайсыз.
Dialogue: 0,0:44:01.18,0:44:04.51,Default,,0,0,0,,О, министр мырза, не болды? қиын бет жасау
Dialogue: 0,0:44:04.51,0:44:06.92,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл менің стилім жақсы емес пе?
Dialogue: 0,0:44:06.92,0:44:09.22,Default,,0,0,0,,Иә, бұл сізге көрінетін перде емес.
Dialogue: 0,0:44:13.22,0:44:15.66,Default,,0,0,0,,Иә, бұл жігіт кім?
Dialogue: 0,0:44:15.66,0:44:17.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:27.84,0:44:30.14,Default,,0,0,0,,О, тек сен үшін
Dialogue: 0,0:44:34.71,0:44:38.52,Default,,0,0,0,,Иә, бүгіннен бастап сен менің қызметшімсің.
Dialogue: 0,0:44:38.52,0:44:41.02,Default,,0,0,0,,Аты - Hellbat
Dialogue: 0,0:44:44.92,0:44:48.29,Default,,0,0,0,,Жақын кел
Dialogue: 0,0:44:48.29,0:44:51.29,Default,,0,0,0,,Мен ханшайымның соңынан еріп, оны қадағалаймын. Бұл жақсы ма?
Dialogue: 0,0:44:53.36,0:44:55.36,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:45:08.91,0:45:13.12,Default,,0,0,0,,Алла ең ұлы
Dialogue: 0,0:45:13.12,0:45:19.39,Default,,0,0,0,,Мәңгілік Алланың атымен
Dialogue: 0,0:45:19.39,0:45:22.03,Default,,0,0,0,,Бүгінгі күн де тыныш және қауіпсіз...
Dialogue: 0,0:45:22.03,0:45:24.23,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:45:28.87,0:45:30.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:45:37.21,0:45:40.11,Default,,0,0,0,,Енді өз бөліміңізге барыңыз.
Dialogue: 0,0:45:48.42,0:45:53.52,Default,,0,0,0,,Егер сіз осы теңізге шығып, оңтүстікке қарай жүрсеңіз,
Dialogue: 0,0:45:53.52,0:45:56.63,Default,,0,0,0,,Бес түсті әдемі арал бар дейді.
Dialogue: 0,0:45:56.63,0:46:01.00,Default,,0,0,0,,Дәмді жеміс Суық көктем Мм
Dialogue: 0,0:46:01.00,0:46:04.40,Default,,0,0,0,,Сирек кездесетін гүлдер мен құстар, үлкен гауһар тастар
Dialogue: 0,0:46:04.40,0:46:06.40,Default,,0,0,0,,Хо
Dialogue: 0,0:46:06.40,0:46:09.74,Default,,0,0,0,,Жоқ, мен айналма жолмен жүре алмаймын.
Dialogue: 0,0:46:09.74,0:46:13.08,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:46:13.08,0:46:15.08,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:46:42.71,0:46:46.81,Default,,0,0,0,,Бағытты өзгертуге дайындал!
Dialogue: 0,0:46:49.91,0:46:52.88,Default,,0,0,0,,Капитан, қайда барасыз?
Dialogue: 0,0:46:52.88,0:46:55.59,Default,,0,0,0,,Қазына аралы
Dialogue: 0,0:46:55.59,0:46:59.69,Default,,0,0,0,,Рульдер көп!
Dialogue: 0,0:47:25.98,0:47:29.82,Default,,0,0,0,,Көңілді бол
Dialogue: 0,0:47:29.82,0:47:33.62,Default,,0,0,0,,Жағымды серік.
Dialogue: 0,0:47:42.27,0:47:46.04,Default,,0,0,0,,Алли, сен сонда барып ойнауың керек.
Dialogue: 0,0:47:46.04,0:47:48.44,Default,,0,0,0,,Маған осы жер ұнайды.
Dialogue: 0,0:47:53.18,0:47:55.78,Default,,0,0,0,,Ей, мен де саған қосылайын.
Dialogue: 0,0:48:11.73,0:48:16.23,Default,,0,0,0,,Мен ханшайымдарға жақсы емеспін.
Dialogue: 0,0:48:20.37,0:48:23.27,Default,,0,0,0,,Неге бәрі менен қашады?
Dialogue: 0,0:48:29.21,0:48:31.21,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:48:33.22,0:48:35.22,Default,,0,0,0,,Айттым ғой, мен тек жұмысымды істеп жүрмін...
Dialogue: 0,0:48:46.83,0:48:49.93,Default,,0,0,0,,О, сен қайттың, Хеллбат?
Dialogue: 0,0:48:54.50,0:48:58.64,Default,,0,0,0,,Не? Ханшайым Таста ма?
Dialogue: 0,0:48:58.64,0:49:01.44,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:49:01.44,0:49:04.95,Default,,0,0,0,,Оңтүстік қазына аралы?
Dialogue: 0,0:49:04.95,0:49:07.65,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:49:07.65,0:49:11.96,Default,,0,0,0,,Патша, мен ханшайымның қайда екенін білемін.
Dialogue: 0,0:49:11.96,0:49:16.49,Default,,0,0,0,,Не? Түсінді ме? Ол қайда?
Dialogue: 0,0:49:16.49,0:49:20.03,Default,,0,0,0,,Иә, бұл кеме...
Dialogue: 0,0:49:20.03,0:49:22.43,Default,,0,0,0,,Сәлем! Не ойлап отырсың?
Dialogue: 0,0:49:22.43,0:49:24.63,Default,,0,0,0,,Мен сені алып кету үшін ерте кетейін бе?
Dialogue: 0,0:49:27.00,0:49:29.00,Default,,0,0,0,,Хун
Dialogue: 0,0:49:37.01,0:49:39.02,Default,,0,0,0,,Одақтас
Dialogue: 0,0:49:39.02,0:49:41.62,Default,,0,0,0,,Тез түс.
Dialogue: 0,0:49:53.90,0:49:56.10,Default,,0,0,0,,Желкендерді түсіріңіз
Dialogue: 0,0:50:08.75,0:50:11.15,Default,,0,0,0,,Сіз не істеп жатырсыз? Сіз кептеліп қалдыңыз.
Dialogue: 0,0:50:14.65,0:50:17.05,Default,,0,0,0,,А, жоқ, жоқ, жоқ.
Dialogue: 0,0:50:26.26,0:50:29.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:29.80,0:50:31.80,Default,,0,0,0,,Жарайды, қазір барайық.
Dialogue: 0,0:50:34.00,0:50:36.00,Default,,0,0,0,,Ол әлі тірі ғана емес, сонымен бірге Уэсато орта мектебінде болуы ықтимал.
Dialogue: 0,0:50:39.11,0:50:41.44,Default,,0,0,0,,Сіз оны тез түсіре аласыз ба?
Dialogue: 0,0:50:41.44,0:50:45.68,Default,,0,0,0,,Мен ештеңе істей алмаймын, капитан!
Dialogue: 0,0:50:45.68,0:50:48.48,Default,,0,0,0,,Капитан, тапсырманы қабыл алыңыз. Жақсы.
Dialogue: 0,0:50:50.45,0:50:52.45,Default,,0,0,0,,Жүр, маған қарызға бер.
Dialogue: 0,0:51:01.96,0:51:03.96,Default,,0,0,0,,Ах! Самер ханшайым
Dialogue: 0,0:51:10.14,0:51:14.21,Default,,0,0,0,,Сәлем! Асықшы!
Dialogue: 0,0:51:14.21,0:51:16.61,Default,,0,0,0,,Кеме құлап қалады.
Dialogue: 0,0:51:22.92,0:51:25.29,Default,,0,0,0,,Алли, қылышыңды маған бер.
Dialogue: 0,0:51:25.29,0:51:27.29,Default,,0,0,0,,Иә
Dialogue: 0,0:51:32.96,0:51:37.26,Default,,0,0,0,,Әй, Синдбад! Қатты Синбад
Dialogue: 0,0:51:41.97,0:51:44.64,Default,,0,0,0,,Ах... Синдбад
Dialogue: 0,0:51:44.64,0:51:46.94,Default,,0,0,0,,Төменге қарамаңыз
Dialogue: 0,0:51:46.94,0:51:49.14,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:51:52.08,0:51:54.08,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:52:13.20,0:52:16.04,Default,,0,0,0,,Эй, Боулдер әлі бар ма?
Dialogue: 0,0:52:16.04,0:52:18.54,Default,,0,0,0,,Га, әлі мүлдем жоқ
Dialogue: 0,0:52:31.42,0:52:34.02,Default,,0,0,0,,Ах, кит-кун
Dialogue: 0,0:52:44.07,0:52:46.07,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:52:51.54,0:52:55.24,Default,,0,0,0,,Пеппи, сен маған кәдесый ала аласың.
Dialogue: 0,0:53:02.02,0:53:05.09,Default,,0,0,0,,Кит-кун, сен қазір үйдесің.
Dialogue: 0,0:53:05.09,0:53:07.09,Default,,0,0,0,,Мама сені күтіп отыр.
Dialogue: 0,0:53:35.69,0:53:39.49,Default,,0,0,0,,Жақсы! Кубок
Dialogue: 0,0:53:39.49,0:53:42.29,Default,,0,0,0,,Келгеніңізге рахмет.
Dialogue: 0,0:53:42.29,0:53:45.93,Default,,0,0,0,,Одақтас, аспанға қарашы.
Dialogue: 0,0:53:45.93,0:53:49.73,Default,,0,0,0,,Ах! Бұл әдемі
Dialogue: 0,0:55:35.04,0:55:39.48,Default,,0,0,0,,Анашым, сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:55:39.48,0:55:43.58,Default,,0,0,0,,Бірақ Самир, мен қазір өте қуаныштымын.
Dialogue: 0,0:55:43.58,0:55:45.95,Default,,0,0,0,,Қайықпен саяхаттау керемет.
Dialogue: 0,0:55:45.95,0:55:47.95,Default,,0,0,0,,Сондай-ақ тамаша достар.
Dialogue: 0,0:55:47.95,0:55:50.89,Default,,0,0,0,,Уху-ху
Dialogue: 0,0:55:50.89,0:55:53.19,Default,,0,0,0,,Ал, мына бала.
Dialogue: 0,0:55:53.19,0:55:56.29,Default,,0,0,0,,Күні кеше қатты дауылға тап болдық.
Dialogue: 0,0:55:56.29,0:55:59.30,Default,,0,0,0,,Не? Үлкен дауыл? Жоқ, жарайды
Dialogue: 0,0:55:59.30,0:56:02.03,Default,,0,0,0,,Синдбад маған көмектесті.
Dialogue: 0,0:56:02.03,0:56:04.67,Default,,0,0,0,,Синдбад? Хмм
Dialogue: 0,0:56:04.67,0:56:08.90,Default,,0,0,0,,Бірақ Самир, мен сенің әкеңнің түрін көргім келді.
Dialogue: 0,0:56:08.90,0:56:11.80,Default,,0,0,0,,Иә? Хахахаха
Dialogue: 0,0:56:15.95,0:56:20.38,Default,,0,0,0,,Сол аспан астында
Dialogue: 0,0:56:20.38,0:56:24.95,Default,,0,0,0,,Бақытқа толы
Dialogue: 0,0:56:24.95,0:56:29.16,Default,,0,0,0,,Сол бұлттың соңында
Dialogue: 0,0:56:29.16,0:56:33.23,Default,,0,0,0,,Үмітке толы
Dialogue: 0,0:56:33.23,0:56:37.83,Default,,0,0,0,,Барлығымыз кеттік.
Dialogue: 0,0:56:37.83,0:56:42.94,Default,,0,0,0,,Кеттік, бәріміз...
Dialogue: 0,0:56:42.94,0:56:47.28,Default,,0,0,0,,Сол аспан астында
Dialogue: 0,0:56:47.28,0:56:53.68,Default,,0,0,0,,Сол бұлттардың соңына дейін
Dialogue: 0,0:57:10.87,0:57:13.97,Default,,0,0,0,,Күлкілі ыстық, солай емес пе?
Dialogue: 0,0:57:13.97,0:57:16.64,Default,,0,0,0,,Яшым
Dialogue: 0,0:57:16.64,0:57:19.18,Default,,0,0,0,,Жасай бер, мен білмеймін.
Dialogue: 0,0:57:19.18,0:57:22.18,Default,,0,0,0,,Су қорқақ
Dialogue: 0,0:57:22.18,0:57:25.41,Default,,0,0,0,,Дауыл болады деп үміттенемін, капитан.
Dialogue: 0,0:57:25.41,0:57:28.45,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:57:28.45,0:57:31.19,Default,,0,0,0,,Бұл су, Синдбад.
Dialogue: 0,0:57:31.19,0:57:34.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:57:34.76,0:57:36.76,Default,,0,0,0,,Бұл Самирден.
Dialogue: 0,0:57:38.76,0:57:42.26,Default,,0,0,0,,Хохохохо хохохохо хохо
Dialogue: 0,0:57:58.28,0:58:01.78,Default,,0,0,0,,Ал, не болды? Қызықты
Dialogue: 0,0:58:01.78,0:58:03.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:25.01,0:58:27.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:36.29,0:58:38.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:43.03,0:58:47.23,Default,,0,0,0,,сэр, Хеллбат қайтып келді.
Dialogue: 0,0:58:51.73,0:58:54.20,Default,,0,0,0,,О, тозақ
Dialogue: 0,0:58:54.20,0:58:56.51,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:58:56.51,0:58:59.51,Default,,0,0,0,,Иә? Иә иә
Dialogue: 0,0:59:01.48,0:59:05.11,Default,,0,0,0,,Жарайды, бақылауды назардан тыс қалдырмаңыз.
Dialogue: 0,0:59:05.11,0:59:07.72,Default,,0,0,0,,Қазір Синдбад
Dialogue: 0,0:59:07.72,0:59:12.02,Default,,0,0,0,,Мәртебелі, соңында ханшайым мен қазына.
Dialogue: 0,0:59:12.02,0:59:15.22,Default,,0,0,0,,Нхахахаха!
Dialogue: 0,0:59:27.40,0:59:30.57,Default,,0,0,0,,Аспан біртүрлі көрінеді, капитан.
Dialogue: 0,0:59:30.57,0:59:33.68,Default,,0,0,0,,О, капитан
Dialogue: 0,0:59:33.68,0:59:36.58,Default,,0,0,0,,Теңіздің түсі өзгерді
Dialogue: 0,0:59:40.15,0:59:44.52,Default,,0,0,0,,Жақсы ма? Бұл біртүрлі
Dialogue: 0,0:59:44.52,0:59:46.52,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:59:49.79,0:59:53.29,Default,,0,0,0,,А, капитан, бұл мәселе. Бұл үлкен балдырлар.
Dialogue: 0,1:00:19.72,1:00:22.46,Default,,0,0,0,,Сіз өзіңізді әлсіз сезінесіз, капитан.
Dialogue: 0,1:00:22.46,1:00:26.40,Default,,0,0,0,,Мен қай жерде дұрыс емес курсты таңдадым?
Dialogue: 0,1:00:26.40,1:00:29.80,Default,,0,0,0,,Бұл біртүрлі теңіз, Синдбад.
Dialogue: 0,1:00:29.80,1:00:32.50,Default,,0,0,0,,Бұл мен естіген жын теңізі.
Dialogue: 0,1:00:34.54,1:00:39.41,Default,,0,0,0,,Мен шыға алмаймын деп ойлаймын.
Dialogue: 0,1:00:39.41,1:00:41.78,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,1:00:41.78,1:00:43.98,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,1:00:51.05,1:00:53.05,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,1:01:01.60,1:01:03.60,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:01:15.01,1:01:18.41,Default,,0,0,0,,Капитан Бұл елес кеме. Бұл елес кеме!
Dialogue: 0,1:02:42.30,1:02:44.30,Default,,0,0,0,,Мен өзімді әлсіз сезінемін.
Dialogue: 0,1:03:05.45,1:03:07.45,Default,,0,0,0,,Кеме қозғалуда.
Dialogue: 0,1:03:09.99,1:03:14.59,Default,,0,0,0,,Жарайды, әркім өз орындарына отыр.
Dialogue: 0,1:03:31.08,1:03:33.88,Default,,0,0,0,,Ах, кит-кун
Dialogue: 0,1:03:33.88,1:03:36.58,Default,,0,0,0,,Сіз маған көмектестіңіз.
Dialogue: 0,1:03:41.32,1:03:43.63,Default,,0,0,0,,Рахмет
Dialogue: 0,1:03:43.63,1:03:45.83,Default,,0,0,0,,(5-сынып оқушысы 5) Сүтсіз. (4-сынып оқушысы 4) Жырт.
Dialogue: 0,1:03:51.30,1:03:56.10,Default,,0,0,0,,Мырза, мен кеменің бағытында шағын кемені көріп тұрмын!
Dialogue: 0,1:03:58.14,1:04:01.38,Default,,0,0,0,,Жарайды, сағатыңызды елеусіз қалдырмаңыз.
Dialogue: 0,1:04:01.38,1:04:03.51,Default,,0,0,0,,Га
Dialogue: 0,1:04:03.51,1:04:08.15,Default,,0,0,0,,Капитан, тұман пайда болды.
Dialogue: 0,1:04:08.15,1:04:10.49,Default,,0,0,0,,О
Dialogue: 0,1:04:10.49,1:04:12.89,Default,,0,0,0,,Бұл қорқынышты тұман.
Dialogue: 0,1:04:15.22,1:04:17.33,Default,,0,0,0,,Бұл біртүрлі тұман, капитан.
Dialogue: 0,1:04:17.33,1:04:19.60,Default,,0,0,0,,О, абай бол.
Dialogue: 0,1:04:19.60,1:04:23.07,Default,,0,0,0,,Мен енді ештеңе көре алмаймын
Dialogue: 0,1:04:23.07,1:04:26.37,Default,,0,0,0,,Жарайды, түс.
Dialogue: 0,1:04:26.37,1:04:28.47,Default,,0,0,0,,Иә
Dialogue: 0,1:04:39.98,1:04:41.98,Default,,0,0,0,,Қауіпті Синдбад
Dialogue: 0,1:04:41.98,1:04:43.98,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:00.47,1:05:02.80,Default,,0,0,0,,Бұл арал, капитан.
Dialogue: 0,1:05:02.80,1:05:05.50,Default,,0,0,0,,А, мүмкін.
Dialogue: 0,1:05:08.74,1:05:11.65,Default,,0,0,0,,Уау, қандай керемет арал
Dialogue: 0,1:05:11.65,1:05:14.35,Default,,0,0,0,,Жақсы, тамаша.
Dialogue: 0,1:05:14.35,1:05:17.85,Default,,0,0,0,,Зәкірді түсіріңіз!
Dialogue: 0,1:05:24.09,1:05:27.96,Default,,0,0,0,,Сосын мен сендерден сұрадым.
Dialogue: 0,1:05:27.96,1:05:30.06,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,1:05:42.95,1:05:45.45,Default,,0,0,0,,Мен сізге сирек сувенир әкелемін, капитан.
Dialogue: 0,1:05:49.28,1:05:51.28,Default,,0,0,0,,Мені де алыңыз
Dialogue: 0,1:05:58.76,1:06:01.86,Default,,0,0,0,,Сіз менімен қаласыз.
Dialogue: 0,1:06:14.01,1:06:16.61,Default,,0,0,0,,Бұл қазына аралы ма?
Dialogue: 0,1:06:16.61,1:06:19.72,Default,,0,0,0,,Ақыры келдіңіз, Синдбад.
Dialogue: 0,1:06:19.72,1:06:21.82,Default,,0,0,0,,Бұл керемет арал, мен сенімдімін.
Dialogue: 0,1:06:24.15,1:06:27.06,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:27.06,1:06:30.13,Default,,0,0,0,,Бұл қорқынышты құс.
Dialogue: 0,1:06:30.13,1:06:32.13,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:53.48,1:06:56.32,Default,,0,0,0,,Самир Али!
Dialogue: 0,1:06:56.32,1:06:59.42,Default,,0,0,0,,Синдбад! синбад
Dialogue: 0,1:07:54.34,1:07:57.68,Default,,0,0,0,,Самир
Dialogue: 0,1:07:57.68,1:07:59.68,Default,,0,0,0,,Алли!
Dialogue: 0,1:08:02.62,1:08:05.15,Default,,0,0,0,,Самир
Dialogue: 0,1:08:05.15,1:08:07.15,Default,,0,0,0,,Одақтас
Dialogue: 0,1:08:13.73,1:08:15.73,Default,,0,0,0,,Уау!
Dialogue: 0,1:08:34.45,1:08:36.55,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,1:08:36.55,1:08:40.29,Default,,0,0,0,,Маған да ішуге рұқсат етпе.
Dialogue: 0,1:08:40.29,1:08:42.29,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:47.26,1:08:49.96,Default,,0,0,0,,Ясим, маған көмектес!
Dialogue: 0,1:08:54.80,1:08:56.80,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,1:09:09.18,1:09:11.19,Default,,0,0,0,,Қазына аралы дегеніміз не?
Dialogue: 0,1:09:11.19,1:09:13.49,Default,,0,0,0,,Эй, кешіріңіз.
Dialogue: 0,1:09:34.81,1:09:36.81,Default,,0,0,0,,Иә!
Dialogue: 0,1:09:50.23,1:09:52.23,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:24.89,1:10:26.89,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:11:31.39,1:11:35.36,Default,,0,0,0,,Мен енді мұны істей алмаймын
Dialogue: 0,1:11:35.36,1:11:37.76,Default,,0,0,0,,Кел, Алли, әрекетіңді жина.
Dialogue: 0,1:11:42.80,1:11:45.87,Default,,0,0,0,,Жарайды, оны тапқан бойда кесіп таста.
Dialogue: 0,1:11:45.87,1:11:47.87,Default,,0,0,0,,Га
Dialogue: 0,1:11:53.92,1:11:56.02,Default,,0,0,0,,Самир
Dialogue: 0,1:12:00.32,1:12:02.32,Default,,0,0,0,,Одақтас
Dialogue: 0,1:12:09.86,1:12:13.57,Default,,0,0,0,,Синдбад
Dialogue: 0,1:12:13.57,1:12:17.37,Default,,0,0,0,,Синдбад!
Dialogue: 0,1:12:21.84,1:12:23.91,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,1:12:23.91,1:12:26.41,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,1:12:26.41,1:12:28.75,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,1:12:28.75,1:12:30.95,Default,,0,0,0,,Уайымдамаңыз, асығыңыз
Dialogue: 0,1:13:14.56,1:13:16.56,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,1:13:24.31,1:13:26.31,Default,,0,0,0,,Синдбад
Dialogue: 0,1:13:34.65,1:13:37.19,Default,,0,0,0,,Ал, а
Dialogue: 0,1:13:37.19,1:13:41.89,Default,,0,0,0,,Бұл атаның айтқан асылы.
Dialogue: 0,1:13:41.89,1:13:45.26,Default,,0,0,0,,Алли, біз Синдбадты тез табуымыз керек.
Dialogue: 0,1:13:45.26,1:13:48.60,Default,,0,0,0,,Иә, Синдбад
Dialogue: 0,1:13:48.60,1:13:51.80,Default,,0,0,0,,Синдбад
Dialogue: 0,1:13:51.80,1:13:55.67,Default,,0,0,0,,Ханшайым, мен сені бейтаныс жерде кездестіремін.
Dialogue: 0,1:13:55.67,1:13:59.01,Default,,0,0,0,,Ханшайыммен не істейміз?
Dialogue: 0,1:13:59.01,1:14:02.58,Default,,0,0,0,,Хахахаха Синдбад
Dialogue: 0,1:14:02.58,1:14:04.58,Default,,0,0,0,,Синдбад
Dialogue: 0,1:14:09.28,1:14:11.72,Default,,0,0,0,,Иә
Dialogue: 0,1:14:11.72,1:14:15.09,Default,,0,0,0,,Мына бала, күте тұр!
Dialogue: 0,1:14:15.09,1:14:18.73,Default,,0,0,0,,Ах Синбад Синбад
Dialogue: 0,1:14:18.73,1:14:20.90,Default,,0,0,0,,Алли, ханшайымды тез әкел.
Dialogue: 0,1:14:20.90,1:14:23.00,Default,,0,0,0,,Иә, асығыңыз да, қуып жетіңіз.
Dialogue: 0,1:14:32.04,1:14:34.04,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:14:36.14,1:14:38.14,Default,,0,0,0,,Ах
Dialogue: 0,1:14:43.35,1:14:45.35,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:14:50.26,1:14:52.26,Default,,0,0,0,,А, бұл ханшайым.
Dialogue: 0,1:14:57.77,1:14:59.93,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,1:14:59.93,1:15:02.04,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,1:15:02.04,1:15:04.41,Default,,0,0,0,,Бұл баланы Синдбад
Dialogue: 0,1:15:04.41,1:15:07.21,Default,,0,0,0,,Синдбад! Иә, шулы!
Dialogue: 0,1:15:07.21,1:15:09.21,Default,,0,0,0,,Жібер!
Dialogue: 0,1:16:30.26,1:16:33.96,Default,,0,0,0,,О
Dialogue: 0,1:16:33.96,1:16:37.90,Default,,0,0,0,,Балалар, тездетіп әшекейлеріңді сөмкеге салыңдар.
Dialogue: 0,1:16:37.90,1:16:39.90,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:16:42.14,1:16:45.34,Default,,0,0,0,,Самир Али
Dialogue: 0,1:17:03.79,1:17:06.69,Default,,0,0,0,,Бұл керемет
Dialogue: 0,1:17:06.69,1:17:08.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:41.70,1:17:43.80,Default,,0,0,0,,А, тезірек!
Dialogue: 0,1:18:26.14,1:18:28.54,Default,,0,0,0,,Самир Али
Dialogue: 0,1:18:35.38,1:18:37.38,Default,,0,0,0,,О, ханшайым
Dialogue: 0,1:18:44.99,1:18:46.99,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:05.78,1:19:09.65,Default,,0,0,0,,Ах... Ханшайым
Dialogue: 0,1:19:09.65,1:19:11.65,Default,,0,0,0,,Ах
Dialogue: 0,1:19:14.36,1:19:17.29,Default,,0,0,0,,Синбад Симба... аа...
Dialogue: 0,1:19:17.29,1:19:20.63,Default,,0,0,0,,Самир Али
Dialogue: 0,1:19:20.63,1:19:22.63,Default,,0,0,0,,Синдбад
Dialogue: 0,1:19:29.40,1:19:32.97,Default,,0,0,0,,Мейірімді Алла, Алла
Dialogue: 0,1:19:32.97,1:19:36.77,Default,,0,0,0,,Мына екі адамды құтқарыңызшы.
Dialogue: 0,1:20:56.22,1:21:00.63,Default,,0,0,0,,Мен кез келген асыл тастардан да үлкен қазына таптым.
Dialogue: 0,1:21:00.63,1:21:03.26,Default,,0,0,0,,Иә? Бұл туралы ше?
Dialogue: 0,1:21:03.26,1:21:06.16,Default,,0,0,0,,Бұл сізсіз, Самир ханшайымы.
Dialogue: 0,1:21:07.66,1:21:13.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory