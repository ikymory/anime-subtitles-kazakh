Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:06.00,Default,,0,0,0,,- Ысырма жылдамдығы Әйтпесе, бұл түн қараңғы
Dialogue: 0,0:00:06.00,0:00:11.00,Default,,0,0,0,,- Күш рыцарына көбірек ысырма жылдамдығы
Dialogue: 0,0:00:11.00,0:00:12.00,Default,,0,0,0,,- Schatzl
Dialogue: 0,0:00:12.00,0:00:23.00,Default,,0,0,0,,- Күш рыцарына ысырма жылдамдығы
Dialogue: 0,0:00:23.00,0:00:28.00,Default,,0,0,0,,- Сіздің қасыңызда мақтанатын нәрсе
Dialogue: 0,0:00:28.00,0:00:33.00,Default,,0,0,0,,- Сіз бірдеңе таба аласыз ба?
Dialogue: 0,0:00:33.00,0:00:39.00,Default,,0,0,0,,- Көлеңкеңізді алға жылжыту
Dialogue: 0,0:00:39.00,0:00:45.00,Default,,0,0,0,,- Таң қалдырғаны сонша, мен оған таңданамын
Dialogue: 0,0:00:45.00,0:00:56.00,Default,,0,0,0,,- Есік ашылып, ұя салынған.
Dialogue: 0,0:00:56.00,0:01:05.00,Default,,0,0,0,,- Жоғалғанға ұқсайтын силуэт
Dialogue: 0,0:01:06.00,0:01:08.00,Default,,0,0,0,,- Ысырма жылдамдығы Олай етпеңіз.
Dialogue: 0,0:01:08.00,0:01:13.00,Default,,0,0,0,,- Ақырын қолыңызды созыңыз Оқу арманы еді
Dialogue: 0,0:01:13.00,0:01:15.00,Default,,0,0,0,,- Мен бөліскім келетін қорқыныштар
Dialogue: 0,0:01:15.00,0:01:21.00,Default,,0,0,0,,- Ысырма жылдамдығы Әйтпесе, бұл түн қараңғы
Dialogue: 0,0:01:21.00,0:01:27.00,Default,,0,0,0,,- Көбірек ысырма жылдамдығы мені қаптамағанын мойындайды
Dialogue: 0,0:01:27.00,0:01:37.00,Default,,0,0,0,,- Ысырма жылдамдығы Ысырма жылдамдығы
Dialogue: 0,0:01:37.00,0:01:40.00,Default,,0,0,0,,- Бұл өте қажет сынақ.
Dialogue: 0,0:01:40.00,0:01:44.00,Default,,0,0,0,,- Жас келіншек дәріні жеңіп, мана жинады.
Dialogue: 0,0:01:44.00,0:01:48.00,Default,,0,0,0,,- Біз сіздің денеңізде бірдеңе дұрыс емес болуы мүмкіндігін жоққа шығара алмаймыз.
Dialogue: 0,0:01:50.00,0:01:52.00,Default,,0,0,0,,- көк үшін келесі
Dialogue: 0,0:01:57.00,0:01:59.00,Default,,0,0,0,,- көк үшін
Dialogue: 0,0:02:02.00,0:02:04.00,Default,,0,0,0,,- Мұғалім дегеніміз не?
Dialogue: 0,0:02:04.00,0:02:10.00,Default,,0,0,0,,- Менің қыз екенімді мүлде түсінбейсің.
Dialogue: 0,0:02:10.00,0:02:15.00,Default,,0,0,0,,- Бұл дұрыс емес, мен де ұялып тұрмын.
Dialogue: 0,0:02:15.00,0:02:18.00,Default,,0,0,0,,- Мен өз эмоциямды көрсетпеу үшін өзімді жаттықтырамын.
Dialogue: 0,0:02:18.00,0:02:23.00,Default,,0,0,0,,- Егер сіз шынымен ұялып жатсаңыз, неге бұлай етесіз?
Dialogue: 0,0:02:23.00,0:02:26.00,Default,,0,0,0,,- Жаңа ғана айтқаным біртүрлі көрінуі мүмкін, бірақ
Dialogue: 0,0:02:26.00,0:02:30.00,Default,,0,0,0,,- Мен жас ханымға көңіл бөлемін.
Dialogue: 0,0:02:31.00,0:02:35.00,Default,,0,0,0,,- Мен бірдеңе істегенім екіталай болса,
Dialogue: 0,0:02:35.00,0:02:39.00,Default,,0,0,0,,- Егер жас ханымның денесі жарақаттанса ше?
Dialogue: 0,0:02:39.00,0:02:43.00,Default,,0,0,0,,- Өте қорқынышты, түнде ұйықтай алмаймын
Dialogue: 0,0:02:44.00,0:02:47.00,Default,,0,0,0,,- Мен қазір бір ғана нәрсені қалаймын
Dialogue: 0,0:02:47.00,0:02:52.00,Default,,0,0,0,,- Қызыңыздың дені сау болсын деп тілеймін.
Dialogue: 0,0:02:53.00,0:02:54.00,Default,,0,0,0,,- Иә?
Dialogue: 0,0:02:58.00,0:03:00.00,Default,,0,0,0,,- Кешіріңіз мырза
Dialogue: 0,0:03:00.00,0:03:04.00,Default,,0,0,0,,- Егер сізге бірдеңе керек болса, оны ұстаңыз.
Dialogue: 0,0:03:05.00,0:03:07.00,Default,,0,0,0,,- Рахмет
Dialogue: 0,0:03:09.00,0:03:13.00,Default,,0,0,0,,- Айтпақшы, мен сізге тағы бір маңызды нәрсені айтуым керек.
Dialogue: 0,0:03:13.00,0:03:15.00,Default,,0,0,0,,- Иә?
Dialogue: 0,0:03:15.00,0:03:21.00,Default,,0,0,0,,- Өкінішке орай, жас ханым алған сынып Паладин емес.
Dialogue: 0,0:03:21.00,0:03:22.00,Default,,0,0,0,,- Иә?
Dialogue: 0,0:03:23.00,0:03:25.00,Default,,0,0,0,,- Олай болса...
Dialogue: 0,0:03:26.00,0:03:29.00,Default,,0,0,0,,- Самурай, дәл мен сияқты.
Dialogue: 0,0:03:29.00,0:03:31.00,Default,,0,0,0,,- Самурай…
Dialogue: 0,0:03:34.00,0:03:39.00,Default,,0,0,0,,- Иә, паладин бола алмағаныма біраз көңілім қалды.
Dialogue: 0,0:03:40.00,0:03:43.00,Default,,0,0,0,,- Мұғалім екеуіңнің сәйкес келгеніне қуаныштымын.
Dialogue: 0,0:03:43.00,0:03:46.00,Default,,0,0,0,,- Сіздің көңіліңізден шыққаныңызға қуаныштымын.
Dialogue: 0,0:03:46.00,0:03:52.00,Default,,0,0,0,,- Менің ойымша, мұны әзірге барлығынан құпия ұстаған дұрыс.
Dialogue: 0,0:03:52.00,0:03:54.00,Default,,0,0,0,,- Неліктен?
Dialogue: 0,0:03:54.00,0:03:59.00,Default,,0,0,0,,- Оташиба сарайы Өйткені жаман қауесет тарататын адам әрқашан пайда болады.
Dialogue: 0,0:04:02.00,0:04:06.00,Default,,0,0,0,,- Бұл табиғи нәтиже, өйткені мен мананы бердім.
Dialogue: 0,0:04:06.00,0:04:11.00,Default,,0,0,0,,- Дегенмен, жас ханым рыцарь корольдік отбасына лайықты адам болып саналады.
Dialogue: 0,0:04:11.00,0:04:14.00,Default,,0,0,0,,- Сізге тек рекорд орнату керек
Dialogue: 0,0:04:15.00,0:04:20.00,Default,,0,0,0,,- Бұл менің және жас ханымның аман қалуының жалғыз жолы.
Dialogue: 0,0:04:20.00,0:04:23.00,Default,,0,0,0,,- Мұғалім айтса, мен орындаймын.
Dialogue: 0,0:04:24.00,0:04:26.00,Default,,0,0,0,,- Еңбектеріңіз үшін рахмет
Dialogue: 0,0:04:26.00,0:04:31.00,Default,,0,0,0,,- Дененің ішінде немесе сыртында ешқандай кейінгі әсерлер жоқ.
Dialogue: 0,0:04:31.00,0:04:33.00,Default,,0,0,0,,- Жақсы
Dialogue: 0,0:04:37.00,0:04:39.00,Default,,0,0,0,,- Мұғалім?
Dialogue: 0,0:04:40.00,0:04:43.00,Default,,0,0,0,,- Мен мұғалімнің шәкірті бола аламын ба?
Dialogue: 0,0:04:45.00,0:04:50.00,Default,,0,0,0,,- Жас ханым қазірдің өзінде менің мақтан тұтатын шәкіртім.
Dialogue: 0,0:04:54.00,0:04:57.00,Default,,0,0,0,,- Мен мектепке баруды асыға күтемін.
Dialogue: 0,0:04:57.00,0:05:01.00,Default,,0,0,0,,- Қазір менде мана және жақсы сынып бар.
Dialogue: 0,0:05:01.00,0:05:03.00,Default,,0,0,0,,- Мектептегі басқалардан еш айырмашылығы жоқ
Dialogue: 0,0:05:03.00,0:05:05.00,Default,,0,0,0,,- Мен айтуды ұмытып кетіппін
Dialogue: 0,0:05:05.00,0:05:08.00,Default,,0,0,0,,- Бүгіннен бастап бір аптадан кейінгі көпшілік матчқа дейін
Dialogue: 0,0:05:08.00,0:05:12.00,Default,,0,0,0,,- Менімен сабақтан тыс уақытта кез келген мананы пайдалануға тыйым салынады.
Dialogue: 0,0:05:12.00,0:05:13.00,Default,,0,0,0,,- Иә?
Dialogue: 0,0:05:16.00,0:05:18.00,Default,,0,0,0,,- Жақында көпшілікке арналған матч.
Dialogue: 0,0:05:18.00,0:05:20.00,Default,,0,0,0,,- Ой, мен қатты қобалжыдым.
Dialogue: 0,0:05:20.00,0:05:23.00,Default,,0,0,0,,- Бірақ бәрі жақсы, өйткені Нерва осында.
Dialogue: 0,0:05:25.00,0:05:26.00,Default,,0,0,0,,- Әй
Dialogue: 0,0:05:27.00,0:05:30.00,Default,,0,0,0,,- Сіз бұл кітапты оқығыңыз келді, солай ма?
Dialogue: 0,0:05:33.00,0:05:35.00,Default,,0,0,0,,- Не, жарай ма?
Dialogue: 0,0:05:35.00,0:05:38.00,Default,,0,0,0,,- Біз доспыз
Dialogue: 0,0:05:38.00,0:05:42.00,Default,,0,0,0,,- Жүр, Мерида, тез киініп, жаттығуға барайық.
Dialogue: 0,0:05:43.00,0:05:45.00,Default,,0,0,0,,- Мен...
Dialogue: 0,0:05:46.00,0:05:47.00,Default,,0,0,0,,- Иә
Dialogue: 0,0:05:47.00,0:05:49.00,Default,,0,0,0,,- Жақсы.
Dialogue: 0,0:05:49.00,0:05:52.00,Default,,0,0,0,,- Рахмет, менде жүк аз.
Dialogue: 0,0:05:52.00,0:05:57.00,Default,,0,0,0,,- Мерида мұғаліммен өткізген сабақтар достарынан гөрі маңыздырақ екенін айтады.
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,- Бұл үстел үстіндегі адам.
Dialogue: 0,0:06:01.00,0:06:03.00,Default,,0,0,0,,- Бұл үстел үстіндегі адам.
Dialogue: 0,0:06:12.00,0:06:15.00,Default,,0,0,0,,- Енді мен мананы пайдалана аламын
Dialogue: 0,0:06:15.00,0:06:18.00,Default,,0,0,0,,- Жас келіншек енді ғана оянды.
Dialogue: 0,0:06:18.00,0:06:20.00,Default,,0,0,0,,- Бұл толық емес күй.
Dialogue: 0,0:06:20.00,0:06:22.00,Default,,0,0,0,,- Мен білемін
Dialogue: 0,0:06:22.00,0:06:24.00,Default,,0,0,0,,- Тағдырлы күнге бір апта қалды
Dialogue: 0,0:06:24.00,0:06:28.00,Default,,0,0,0,,- Оған дейін тіл мамандары қате түсінсін.
Dialogue: 0,0:06:28.00,0:06:33.00,Default,,0,0,0,,- Олай болса, бұрын-соңды болмаған кереметтің куәсі болады.
Dialogue: 0,0:06:33.00,0:06:35.00,Default,,0,0,0,,- Иә мырза
Dialogue: 0,0:06:35.00,0:06:37.00,Default,,0,0,0,,- Айтпақшы
Dialogue: 0,0:06:37.00,0:06:42.00,Default,,0,0,0,,- Ішке қарап отырғандар үшін, жас ханымға бірдеңе алғыңыз келе ме?
Dialogue: 0,0:06:42.00,0:06:45.00,Default,,0,0,0,,- Е... Эхехе... Сәлем.
Dialogue: 0,0:06:46.00,0:06:48.00,Default,,0,0,0,,- Элли…
Dialogue: 0,0:06:48.00,0:06:50.00,Default,,0,0,0,,- Мм, өткен күні...
Dialogue: 0,0:06:55.00,0:06:57.00,Default,,0,0,0,,- Сізбен қайта танысқаныма қуаныштымын, мырза мырза.
Dialogue: 0,0:06:58.00,0:07:00.00,Default,,0,0,0,,- Сіз болдыңыз ба?
Dialogue: 0,0:07:00.00,0:07:02.00,Default,,0,0,0,,- Хэхе...
Dialogue: 0,0:07:02.00,0:07:05.00,Default,,0,0,0,,- Сол мұғалім...
Dialogue: 0,0:07:05.00,0:07:07.00,Default,,0,0,0,,- Танысқаныма қуаныштымын
Dialogue: 0,0:07:07.00,0:07:12.00,Default,,0,0,0,,- Менің атым Розетти Прикетт, мен Элиза ханымның тәрбиешісімін.
Dialogue: 0,0:07:12.00,0:07:17.00,Default,,0,0,0,,- Розетти... Бұл Розетти Прикетт пе?
Dialogue: 0,0:07:17.00,0:07:21.00,Default,,0,0,0,,- Уау, мен өзімді атақты адамдай сезінемін.
Dialogue: 0,0:07:21.00,0:07:25.00,Default,,0,0,0,,- Жай ғана емес, шын мәнінде әйгілі.
Dialogue: 0,0:07:25.00,0:07:30.00,Default,,0,0,0,,- Виртуалды алып хайуанаттар ауданында дүниеге келгеніне қарамастан, жас кезінде мана оянған.
Dialogue: 0,0:07:30.00,0:07:34.00,Default,,0,0,0,,- Ол Крест Легионына қосылған ең жасы ғана емес
Dialogue: 0,0:07:34.00,0:07:39.00,Default,,0,0,0,,- Мәртебелі Король маған Тасымалдаушы Маркизді ерекше түсіндірді.
Dialogue: 0,0:07:39.00,0:07:42.00,Default,,0,0,0,,- Көп нәрсе асыра айтылған.
Dialogue: 0,0:07:42.00,0:07:46.00,Default,,0,0,0,,- Уайымдамаңыз, мені Розетти, Белида-сама деп атаңыз.
Dialogue: 0,0:07:46.00,0:07:48.00,Default,,0,0,0,,- Иә
Dialogue: 0,0:07:50.00,0:07:53.00,Default,,0,0,0,,- Мен де Элиза-самадан сіз туралы біраз естідім.
Dialogue: 0,0:07:53.00,0:07:55.00,Default,,0,0,0,,- Куфа Вампир мырза
Dialogue: 0,0:07:56.00,0:08:02.00,Default,,0,0,0,,- Біз екеуіміз де Періштелер отбасының қызметшілеріміз және тәрбиешілеріміз, сондықтан бұдан былай жақсы араласамыз деп үміттенемін.
Dialogue: 0,0:08:08.00,0:08:12.00,Default,,0,0,0,,- Кешіріңіз, бірақ біз дос бола алмаймыз.
Dialogue: 0,0:08:12.00,0:08:14.00,Default,,0,0,0,,- Жоқ... неге?
Dialogue: 0,0:08:14.00,0:08:20.00,Default,,0,0,0,,- Сіз сияқты жеңілтек әйел Мерида ханшайымның білім алуына кері әсер етеді.
Dialogue: 0,0:08:20.00,0:08:25.00,Default,,0,0,0,,- Шаранпоран дегеніміз не? Сізбен соңғы кездескенімде сондай ақкөңіл, ақкөңіл едіңіз.
Dialogue: 0,0:08:25.00,0:08:30.00,Default,,0,0,0,,- Жас ханымды ғана емес, мұғалімді де жұртшылықпен салыстырып жатыр.
Dialogue: 0,0:08:34.00,0:08:36.00,Default,,0,0,0,,- Қоғамдық матчты есте сақтау
Dialogue: 0,0:08:36.00,0:08:40.00,Default,,0,0,0,,- Менің жас ханым сіздің Меридаңызды Кечхон Кечхонға сеніп тапсырады.
Dialogue: 0,0:08:40.00,0:08:42.00,Default,,0,0,0,,- Мен түсінемін.
Dialogue: 0,0:08:43.00,0:08:45.00,Default,,0,0,0,,- Мұғалім мұғалім
Dialogue: 0,0:08:46.00,0:08:49.00,Default,,0,0,0,,- Үйге қайтайық, жас ханым.
Dialogue: 0,0:08:50.00,0:08:52.00,Default,,0,0,0,,- Мұғалім мұғалім
Dialogue: 0,0:08:59.00,0:09:02.00,Default,,0,0,0,,- Ақыры күн келді.
Dialogue: 0,0:09:03.00,0:09:09.00,Default,,0,0,0,,- Мұғалім мен қорқамын. Мен қашып кеткім келеді.
Dialogue: 0,0:09:10.00,0:09:14.00,Default,,0,0,0,,- Жарайды, мен бүгінге дейін қатты жаттығып келдім.
Dialogue: 0,0:09:14.00,0:09:17.00,Default,,0,0,0,,- Бірақ көп адамдар
Dialogue: 0,0:09:21.00,0:09:24.00,Default,,0,0,0,,- Әке
Dialogue: 0,0:09:42.00,0:09:45.00,Default,,0,0,0,,- Мен өзіме сенімді емеспін.
Dialogue: 0,0:09:45.00,0:09:49.00,Default,,0,0,0,,- Ханым, мен трибунаға барайын деп жатырмын.
Dialogue: 0,0:09:50.00,0:09:56.00,Default,,0,0,0,,- Не болып жатыр? Мен өз күшімнің жартысын бұлай пайдалана алмаймын.
Dialogue: 0,0:09:56.00,0:09:58.00,Default,,0,0,0,,- О, Мерида
Dialogue: 0,0:09:58.00,0:10:03.00,Default,,0,0,0,,- Мен сені Юфиннің бөлімшесі алып кеткенін естідім.
Dialogue: 0,0:10:03.00,0:10:05.00,Default,,0,0,0,,- Е...иә
Dialogue: 0,0:10:06.00,0:10:09.00,Default,,0,0,0,,- Мен де сенің отбасыңды аяймын.
Dialogue: 0,0:10:09.00,0:10:16.00,Default,,0,0,0,,- Көпшіліктің алдында өзіңді көрсетіп, олардың күлгенін көру керек.
Dialogue: 0,0:10:16.00,0:10:21.00,Default,,0,0,0,,- Шынымды айтсам, біздің академияда неге сіздей адамдар бар?
Dialogue: 0,0:10:21.00,0:10:25.00,Default,,0,0,0,,- Дос ретінде көру тым шіркін.
Dialogue: 0,0:10:26.00,0:10:28.00,Default,,0,0,0,,- Мерида
Dialogue: 0,0:10:29.00,0:10:33.00,Default,,0,0,0,,- Мен сенен бір нәрсе сұрайын деп қорқамын.
Dialogue: 0,0:10:33.00,0:10:37.00,Default,,0,0,0,,- Әй, мырза, не қаласаңыз, соны айтыңызшы.
Dialogue: 0,0:10:37.00,0:10:40.00,Default,,0,0,0,,- Олай болса рахмет.
Dialogue: 0,0:10:40.00,0:10:46.00,Default,,0,0,0,,- Құлағым шіріп кете ме деп қорқамын, үніңді жапшы, маймыл ұрғашы.
Dialogue: 0,0:10:46.00,0:10:50.00,Default,,0,0,0,,- Сен маған не істеп жатырсың?
Dialogue: 0,0:10:50.00,0:10:53.00,Default,,0,0,0,,- Сіз Мерида-сама туралы ештеңе білмейсіз...
Dialogue: 0,0:10:53.00,0:10:58.00,Default,,0,0,0,,- Қызық, бейтаныс ақсүйек императорлық әулеттің қызметшісі болып рахаттанып жүр ме?
Dialogue: 0,0:10:59.00,0:11:06.00,Default,,0,0,0,,- Сіз жеке оқытушы болсаңыз да, сіз жай ғана суретті кітаптарды оқып, жалақы аласыз.
Dialogue: 0,0:11:11.00,0:11:13.00,Default,,0,0,0,,- Ол ең жақсы мұғалім!
Dialogue: 0,0:11:13.00,0:11:16.00,Default,,0,0,0,,- Мені мазақ еткеніңізді ешқашан кешірмеймін.
Dialogue: 0,0:11:16.00,0:11:19.00,Default,,0,0,0,,- Мен сені матчта жынды қыламын!
Dialogue: 0,0:11:21.00,0:11:27.00,Default,,0,0,0,,- Айттым ғой, сабақты тастап кетсең асыға күтемін.
Dialogue: 0,0:11:27.00,0:11:31.00,Default,,0,0,0,,- Жоқ! Не істеу керек?
Dialogue: 0,0:11:31.00,0:11:35.00,Default,,0,0,0,,- Жас ханым өзі үшін емес сияқты.
Dialogue: 0,0:11:35.00,0:11:39.00,Default,,0,0,0,,- Өзінің күшін басқаларға көрсете алатын бала сияқты.
Dialogue: 0,0:11:40.00,0:11:44.00,Default,,0,0,0,,- Қараңызшы, Фергусангел де осында.
Dialogue: 0,0:11:44.00,0:11:48.00,Default,,0,0,0,,- Көрші адам - ​​Мортра.
Dialogue: 0,0:11:48.00,0:11:51.00,Default,,0,0,0,,- Тағы барайық
Dialogue: 0,0:11:51.00,0:11:53.00,Default,,0,0,0,,- Кеттік
Dialogue: 0,0:11:53.00,0:11:55.00,Default,,0,0,0,,- Кеттік
Dialogue: 0,0:11:57.00,0:11:58.00,Default,,0,0,0,,- Лорд Улдру?
Dialogue: 0,0:11:58.00,0:12:01.00,Default,,0,0,0,,- Атасы, Мериданыкі
Dialogue: 0,0:12:01.00,0:12:05.00,Default,,0,0,0,,- Аа, мананы қолдануға болмайды деген қауесет бар.
Dialogue: 0,0:12:10.00,0:12:14.00,Default,,0,0,0,,- Экстремалды теория Осы матчтың нәтижесінен төмен
Dialogue: 0,0:12:14.00,0:12:18.00,Default,,0,0,0,,- Жас ханым екеуміз бірге жойылуымыз мүмкін.
Dialogue: 0,0:12:18.00,0:12:23.00,Default,,0,0,0,,- Сізде көп бос уақыт жоқ, Харагуроесшинши мырза.
Dialogue: 0,0:12:23.00,0:12:24.00,Default,,0,0,0,,- Бұл Прикеттс мырза емес пе?
Dialogue: 0,0:12:24.00,0:12:26.00,Default,,0,0,0,,- Өйткені бұл Прикеттс!
Dialogue: 0,0:12:26.00,0:12:28.00,Default,,0,0,0,,- Сізге бірдеңе керек пе?
Dialogue: 0,0:12:30.00,0:12:34.00,Default,,0,0,0,,- Менің қызым Элиза Мерида үшін алаңдады.
Dialogue: 0,0:12:34.00,0:12:39.00,Default,,0,0,0,,- Меридаға ештеңе істеудің қажеті жоқ, оны бізге қалдырыңыз.
Dialogue: 0,0:12:40.00,0:12:42.00,Default,,0,0,0,,- О, бұл
Dialogue: 0,0:12:48.00,0:12:52.00,Default,,0,0,0,,- Бұдан былай, Фридесвиде қыздар академиясы
Dialogue: 0,0:12:52.00,0:12:56.00,Default,,0,0,0,,- Музыкалық аспаптардың алғашқы көпшілік матчтары басталады.
Dialogue: 0,0:12:58.00,0:12:59.00,Default,,0,0,0,,- Міне!
Dialogue: 0,0:13:04.00,0:13:05.00,Default,,0,0,0,,- Мерида?
Dialogue: 0,0:13:10.00,0:13:13.00,Default,,0,0,0,,- Мұғалім, қараңызшы!
Dialogue: 0,0:13:13.00,0:13:17.00,Default,,0,0,0,,- Мені көруге келгеніңізге қуаныштымын!
Dialogue: 0,0:13:17.00,0:13:20.00,Default,,0,0,0,,- Егер сіз соншалықты ерекше болғыңыз келсе, мен сізге көмектесемін!
Dialogue: 0,0:13:20.00,0:13:24.00,Default,,0,0,0,,- Біліксіз бірінші және соңғы кезең!
Dialogue: 0,0:13:24.00,0:13:29.00,Default,,0,0,0,,- Қол-аяғыңды ауыртып, беліңді сындырамын, байқамай!
Dialogue: 0,0:13:43.00,0:13:44.00,Default,,0,0,0,,- Не?
Dialogue: 0,0:13:53.00,0:13:55.00,Default,,0,0,0,,- Мерида Ангел...
Dialogue: 0,0:13:55.00,0:13:56.00,Default,,0,0,0,,- Манао!
Dialogue: 0,0:13:58.00,0:14:00.00,Default,,0,0,0,,- Мерида-сама - Манао!
Dialogue: 0,0:14:01.00,0:14:05.00,Default,,0,0,0,,- Бұл сіз түкке тұрғысыз деп атаған ойыншы.
Dialogue: 0,0:14:07.00,0:14:09.00,Default,,0,0,0,,- Сіз қалай ойлайсыз?
Dialogue: 0,0:14:09.00,0:14:13.00,Default,,0,0,0,,- Сәби тек құралдарды пайдалануды үйреніп қана қойған жоқ!
Dialogue: 0,0:14:16.00,0:14:18.00,Default,,0,0,0,,- Басқа адамның қаруы болғандықтан
Dialogue: 0,0:14:18.00,0:14:21.00,Default,,0,0,0,,- Міндетті түрде сізге қарумен шабуыл жасауымды сұрамаңыз.
Dialogue: 0,0:14:22.00,0:14:24.00,Default,,0,0,0,,- Қарғыс атсын!
Dialogue: 0,0:14:34.00,0:14:38.00,Default,,0,0,0,,- Бұл мен ... бұл мен ...
Dialogue: 0,0:14:39.00,0:14:40.00,Default,,0,0,0,,- Боқ...
Dialogue: 0,0:14:40.00,0:14:43.00,Default,,0,0,0,,- Мерида Ангел болса да...
Dialogue: 0,0:14:43.00,0:14:45.00,Default,,0,0,0,,- Мерида Ангел болса да!
Dialogue: 0,0:14:45.00,0:14:47.00,Default,,0,0,0,,- Мерида Ангел болса да!
Dialogue: 0,0:14:47.00,0:14:49.00,Default,,0,0,0,,- Мерида Ангел болса да!!
Dialogue: 0,0:14:55.00,0:14:58.00,Default,,0,0,0,,- Гаррик Форн!
Dialogue: 0,0:15:09.00,0:15:11.00,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:15:20.00,0:15:27.00,Default,,0,0,0,,күрсіну. Бәлкім, жаңадан үйренуді үйренген нәресте үшін ынталандыру тым күшті болды.
Dialogue: 0,0:15:29.00,0:15:37.00,Default,,0,0,0,,Бірақ біз доспыз, ал көбейту туралы айтатын болсақ, мен сені одан әрі аямаймын.
Dialogue: 0,0:15:38.00,0:15:46.00,Default,,0,0,0,,Иә, не үшін өкінесіз? Мен ештеңе естімеймін.
Dialogue: 0,0:15:48.00,0:15:53.00,Default,,0,0,0,,Мен сенен медициналық кабинетте көбірек сұраймын.
Dialogue: 0,0:15:57.00,0:16:02.00,Default,,0,0,0,,Мұғалімнің шабуылы қорқыныштырақ екенін айтты.
Dialogue: 0,0:16:07.00,0:16:10.00,Default,,0,0,0,,Бұл ауыруы керек, солай ма?
Dialogue: 0,0:16:11.00,0:16:17.00,Default,,0,0,0,,Мүмкін бұл менің осы уақытқа дейін сезінген азаппен салыстырғанда ештеңе емес шығар.
Dialogue: 0,0:16:22.00,0:16:27.00,Default,,0,0,0,,Алғашқыда мұндай қабілетсіздік
Dialogue: 0,0:16:27.00,0:16:30.00,Default,,0,0,0,,Ааа
Dialogue: 0,0:16:30.00,0:16:33.00,Default,,0,0,0,,me
Dialogue: 0,0:16:37.00,0:16:41.00,Default,,0,0,0,,бар
Dialogue: 0,0:16:42.00,0:16:48.00,Default,,0,0,0,,Мұғалімге мініңіз
Dialogue: 0,0:16:49.00,0:16:51.00,Default,,0,0,0,,me
Dialogue: 0,0:16:52.00,0:16:56.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:56.00,0:16:59.00,Default,,0,0,0,,me
Dialogue: 0,0:16:59.00,0:17:04.00,Default,,0,0,0,,Мұғалімнің шабуылы қорқынышты болды ма?
Dialogue: 0,0:17:04.00,0:17:09.00,Default,,0,0,0,,Сабырлы бол. Мен шынымен қорқамын, солай ма?
Dialogue: 0,0:17:09.00,0:17:14.00,Default,,0,0,0,,Кімге қарсы болғаныңа өкініп жыла!
Dialogue: 0,0:17:14.00,0:17:19.00,Default,,0,0,0,,Мен қорықпаймын. Мұғаліммен салыстыруға болмайды!
Dialogue: 0,0:17:19.00,0:17:25.00,Default,,0,0,0,,Мерида болса да, Мерида болса да!
Dialogue: 0,0:17:26.00,0:17:30.00,Default,,0,0,0,,Неліктен сіз қазір мананы оятып жатырсыз?
Dialogue: 0,0:17:37.00,0:17:40.00,Default,,0,0,0,,Сіз біліксіз жалдаушысыз.
Dialogue: 0,0:17:42.00,0:17:48.00,Default,,0,0,0,,Мана болмаса да жарайды. Мен сенің мәңгілік досың боламын.
Dialogue: 0,0:17:50.00,0:17:52.00,Default,,0,0,0,,Мен бақыттымын! Рахмет сізге!
Dialogue: 0,0:17:53.00,0:17:57.00,Default,,0,0,0,,Мәңгі осылай қалса екен.
Dialogue: 0,0:17:57.00,0:18:01.00,Default,,0,0,0,,Менің досым болғаныңды қалаймын!
Dialogue: 0,0:18:01.00,0:18:06.00,Default,,0,0,0,,Сен сондай жақсы жігіт едің!
Dialogue: 0,0:18:12.00,0:18:16.00,Default,,0,0,0,,Мен сенің енді қасықты да көтере алмайтыныңды тексеремін.
Dialogue: 0,0:18:16.00,0:18:18.00,Default,,0,0,0,,Галик көтеріл!
Dialogue: 0,0:18:19.00,0:18:21.00,Default,,0,0,0,,Генто жарқылы!
Dialogue: 0,0:18:22.00,0:18:24.00,Default,,0,0,0,,Каземару!
Dialogue: 0,0:18:39.00,0:18:41.00,Default,,0,0,0,,Бұл Гентодзюцу!
Dialogue: 0,0:18:41.00,0:18:44.00,Default,,0,0,0,,Менің шеберлігіме бір қарап,
Dialogue: 0,0:18:44.00,0:18:47.00,Default,,0,0,0,,Ол жасырын түрде жаттығады ма?
Dialogue: 0,0:18:49.00,0:18:50.00,Default,,0,0,0,,Мен оны қарызға аламын!
Dialogue: 0,0:18:51.00,0:18:52.00,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:55.00,0:18:56.00,Default,,0,0,0,,Бар, Мерида Ангел!
Dialogue: 0,0:18:56.00,0:18:59.00,Default,,0,0,0,,Біз сені бұл жерге жібермейміз!
Dialogue: 0,0:19:01.00,0:19:02.00,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:19:02.00,0:19:04.00,Default,,0,0,0,,Бар, Эмберида!
Dialogue: 0,0:19:14.00,0:19:16.00,Default,,0,0,0,,Эмберида Ангел
Dialogue: 0,0:19:25.00,0:19:26.00,Default,,0,0,0,,Мұғалім!
Dialogue: 0,0:19:27.00,0:19:28.00,Default,,0,0,0,,Сіз қарап тұрдыңыз ба?
Dialogue: 0,0:19:29.00,0:19:31.00,Default,,0,0,0,,Мен, гах!
Dialogue: 0,0:19:33.00,0:19:35.00,Default,,0,0,0,,Жарайсың, жас ханым.
Dialogue: 0,0:19:35.00,0:19:37.00,Default,,0,0,0,,Нәтижелер менің күткенімнен де асып түсті.
Dialogue: 0,0:19:37.00,0:19:41.00,Default,,0,0,0,,Дәрігер, мен енді бала емеспін.
Dialogue: 0,0:19:45.00,0:19:48.00,Default,,0,0,0,,Әке?
Dialogue: 0,0:19:50.00,0:19:51.00,Default,,0,0,0,,Әке!
Dialogue: 0,0:19:51.00,0:19:56.00,Default,,0,0,0,,Мен жеңдім. Мен бірінші рет жеңдім!
Dialogue: 0,0:19:57.00,0:19:58.00,Default,,0,0,0,,Мен қарап отырдым.
Dialogue: 0,0:19:59.00,0:20:02.00,Default,,0,0,0,,Бір рет жеңіске жетіп, қатты қуанбаңыз.
Dialogue: 0,0:20:03.00,0:20:09.00,Default,,0,0,0,,Мұндай есеп мектеп басқа мектептерге қарсы сыртқы ойындарда жақсара алған соң ғана жасалуы мүмкін.
Dialogue: 0,0:20:14.00,0:20:21.00,Default,,0,0,0,,О, ханым, бұл керемет болды.
Dialogue: 0,0:20:22.00,0:20:25.00,Default,,0,0,0,,Бұл өте жақсы емес.
Dialogue: 0,0:20:29.00,0:20:31.00,Default,,0,0,0,,Ойланып көріңізші.
Dialogue: 0,0:20:31.00,0:20:35.00,Default,,0,0,0,,Бүгін жас ханым күйеуімен сөйлесу үшін батылдыққа ие болды.
Dialogue: 0,0:20:35.00,0:20:41.00,Default,,0,0,0,,Күйеуі де жас ханымға жауап берді, бірақ ол күткен сөз емес.
Dialogue: 0,0:20:41.00,0:20:43.00,Default,,0,0,0,,Бұл үлкен қадам.
Dialogue: 0,0:20:45.00,0:20:46.00,Default,,0,0,0,,Мұғалім!
Dialogue: 0,0:20:47.00,0:20:49.00,Default,,0,0,0,,Мерида Ангел!
Dialogue: 0,0:20:49.00,0:20:50.00,Default,,0,0,0,,Мелма?
Dialogue: 0,0:20:55.00,0:20:58.00,Default,,0,0,0,,Мен оны оқып қойғанмын, сондықтан қайтарамын.
Dialogue: 0,0:21:00.00,0:21:01.00,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:21:10.00,0:21:13.00,Default,,0,0,0,,Ең бастысы, келесі матч басталғалы тұрған жоқ па?
Dialogue: 0,0:21:14.00,0:21:15.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:24.00,0:21:26.00,Default,,0,0,0,,Элиза-сама күткендей!
Dialogue: 0,0:21:26.00,0:21:28.00,Default,,0,0,0,,Бұл өтірік, бар болғаны 13 секундқа созылды.
Dialogue: 0,0:21:29.00,0:21:31.00,Default,,0,0,0,,Баладиннің күші осы ма?
Dialogue: 0,0:21:37.00,0:21:38.00,Default,,0,0,0,,Элли?
Dialogue: 0,0:21:44.00,0:21:45.00,Default,,0,0,0,,Элли?
Dialogue: 0,0:21:49.00,0:21:50.00,Default,,0,0,0,,Элли?
Dialogue: 0,0:21:52.00,0:21:53.00,Default,,0,0,0,,Элли?
Dialogue: 0,0:21:55.00,0:21:56.00,Default,,0,0,0,,Элли?
