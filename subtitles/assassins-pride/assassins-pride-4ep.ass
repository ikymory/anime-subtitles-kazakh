Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:01.00,Default,,0,0,0,,Шағын кеңістік!
Dialogue: 0,0:00:20.00,0:00:25.00,Default,,0,0,0,,Ана/сама- көрініс
Dialogue: 0,0:00:25.00,0:00:27.00,Default,,0,0,0,,Бір нәрсенің физикалық қасиеттерін табыңыз!
Dialogue: 0,0:00:27.00,0:00:29.00,Default,,0,0,0,,Эллиден аулақ болыңыз!
Dialogue: 0,0:00:37.00,0:00:38.00,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:00:39.00,0:00:41.00,Default,,0,0,0,,Жарайды, Элли.
Dialogue: 0,0:00:50.00,0:00:53.00,Default,,0,0,0,,Сонша тұрып қалсаң, жүру қиын.
Dialogue: 0,0:00:53.00,0:00:54.00,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:00:54.00,0:00:56.00,Default,,0,0,0,,Элли шынымен бұзылған бала.
Dialogue: 0,0:00:57.00,0:00:59.00,Default,,0,0,0,,Жақында біз екінші сыныпта боламыз.
Dialogue: 0,0:01:00.00,0:01:03.00,Default,,0,0,0,,Мен сыныптасымның үлкен әпкесі боламын, сондықтан мен көп еңбекқор болуым керек.
Dialogue: 0,0:01:04.00,0:01:06.00,Default,,0,0,0,,Сізге қажеті жоқ
Dialogue: 0,0:01:06.00,0:01:09.00,Default,,0,0,0,,Эллиде мана бар, солай ма?
Dialogue: 0,0:01:09.00,0:01:10.00,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:01:10.00,0:01:12.00,Default,,0,0,0,,Мен Ританың мәңгі қарындасы болғым келеді.
Dialogue: 0,0:01:13.00,0:01:14.00,Default,,0,0,0,,Эй, жарайды, солай ма?
Dialogue: 0,0:01:15.00,0:01:16.00,Default,,0,0,0,,Элли...
Dialogue: 0,0:01:24.00,0:01:25.00,Default,,0,0,0,,...
Dialogue: 0,0:01:54.00,0:01:59.00,Default,,0,0,0,,Мақтанатын нәрсе
Dialogue: 0,0:01:59.00,0:02:04.00,Default,,0,0,0,,Сіз бірдеңе таба аласыз ба?
Dialogue: 0,0:02:04.00,0:02:10.00,Default,,0,0,0,,Сіздің көлеңкеңіз алға жылжуда
Dialogue: 0,0:02:10.00,0:02:16.00,Default,,0,0,0,,Таң қалдырғаны сонша, мен саған тәнтімін
Dialogue: 0,0:02:17.00,0:02:26.00,Default,,0,0,0,,Есік ашылғанда салынған саңылау
Dialogue: 0,0:02:26.00,0:02:34.00,Default,,0,0,0,,Жоғалған аспан сұлбасы
Dialogue: 0,0:02:34.00,0:02:38.00,Default,,0,0,0,,Шутерроктар
Dialogue: 0,0:02:38.00,0:02:45.00,Default,,0,0,0,,Жоғалған аспан сұлбасы
Dialogue: 0,0:02:45.00,0:02:48.00,Default,,0,0,0,,Shutterrocks-қа бармаңыз
Dialogue: 0,0:02:48.00,0:02:50.00,Default,,0,0,0,,Қолыңызды ақырын созыңыз
Dialogue: 0,0:02:50.00,0:02:53.00,Default,,0,0,0,,Мен тырмалауды армандадым
Dialogue: 0,0:02:53.00,0:02:56.00,Default,,0,0,0,,Сіз бөліскіңіз келетін мұғалімдер
Dialogue: 0,0:02:56.00,0:02:57.00,Default,,0,0,0,,Тығыздағыштар
Dialogue: 0,0:02:57.00,0:02:58.00,Default,,0,0,0,,Түсіндім, түн
Dialogue: 0,0:02:58.00,0:03:01.00,Default,,0,0,0,,Қараңғы түн беті
Dialogue: 0,0:03:01.00,0:03:02.00,Default,,0,0,0,,Барған сайын
Dialogue: 0,0:03:02.00,0:03:04.00,Default,,0,0,0,,Тығыздағыштар
Dialogue: 0,0:03:04.00,0:03:07.00,Default,,0,0,0,,Мені сырт киімсіз мойындаңыз.
Dialogue: 0,0:03:08.00,0:03:10.00,Default,,0,0,0,,Табылды
Dialogue: 0,0:03:10.00,0:03:14.00,Default,,0,0,0,,Тығыздағыштар
Dialogue: 0,0:03:14.00,0:03:17.00,Default,,0,0,0,,Енді сонша тұрып қалсаң, жүру қиын.
Dialogue: 0,0:03:17.00,0:03:19.00,Default,,0,0,0,,Себебі мен бақыттымын.
Dialogue: 0,0:03:19.00,0:03:22.00,Default,,0,0,0,,Мен бүгіннен бастап бір апта бойы Рита мен Судың қасында боламын.
Dialogue: 0,0:03:22.00,0:03:24.00,Default,,0,0,0,,Мен де бұған қуаныштымын.
Dialogue: 0,0:03:25.00,0:03:29.00,Default,,0,0,0,,Бұл ханымдармен нағыз ойын сияқты.
Dialogue: 0,0:03:29.00,0:03:32.00,Default,,0,0,0,,Иә, бірақ бұл не?
Dialogue: 0,0:03:34.00,0:03:36.00,Default,,0,0,0,,Сіз мұны бірнеше рет айттыңыз.
Dialogue: 0,0:03:36.00,0:03:39.00,Default,,0,0,0,,Сіз және мен негізгі отбасы мен салалық отбасының тәрбиешілеріміз.
Dialogue: 0,0:03:39.00,0:03:42.00,Default,,0,0,0,,Олар бәсекелес.
Dialogue: 0,0:03:42.00,0:03:44.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:44.00,0:03:47.00,Default,,0,0,0,,Барлық ханымдар осындай жақсы достар.
Dialogue: 0,0:03:47.00,0:03:49.00,Default,,0,0,0,,Тіпті егер
Dialogue: 0,0:03:49.00,0:03:52.00,Default,,0,0,0,,Бұл клиент не ойлайтыны туралы.
Dialogue: 0,0:03:52.00,0:03:55.00,Default,,0,0,0,,Ең болмағанда отакудың бас қызметшісі
Dialogue: 0,0:03:55.00,0:03:57.00,Default,,0,0,0,,Сіз олай ойламайтын сияқтысыз.
Dialogue: 0,0:03:57.00,0:04:02.00,Default,,0,0,0,,Қонақтар тізіміне өзінің атын мәжбүрлеп енгізген сияқты.
Dialogue: 0,0:04:02.00,0:04:05.00,Default,,0,0,0,,Сен маған жалғыз сене алмайсың
Dialogue: 0,0:04:05.00,0:04:09.00,Default,,0,0,0,,Тағы бір қызықты апта болатын сияқты.
Dialogue: 0,0:04:09.00,0:04:11.00,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:04:12.00,0:04:14.00,Default,,0,0,0,,Тіпті егер
Dialogue: 0,0:04:14.00,0:04:16.00,Default,,0,0,0,,Біздің міндетіміз біреу
Dialogue: 0,0:04:17.00,0:04:21.00,Default,,0,0,0,,Жас қыздың мектептегі қызықты өмірін қорғау
Dialogue: 0,0:04:23.00,0:04:26.00,Default,,0,0,0,,Биылғы үміткерлер кімдер?
Dialogue: 0,0:04:26.00,0:04:29.00,Default,,0,0,0,,Әрине, бұл сөзсіз Төраға Криста.
Dialogue: 0,0:04:29.00,0:04:33.00,Default,,0,0,0,,Осы жылы сіз Лунаның Заосына жақындай аласыз.
Dialogue: 0,0:04:33.00,0:04:35.00,Default,,0,0,0,,Екіншісі де шешілді.
Dialogue: 0,0:04:35.00,0:04:38.00,Default,,0,0,0,,Өткен жылғы патшайым Цуцуко Чиба
Dialogue: 0,0:04:38.00,0:04:41.00,Default,,0,0,0,,Екеуің қандай сүйкімдісіңдер.
Dialogue: 0,0:04:41.00,0:04:45.00,Default,,0,0,0,,Saferiedesweede мақтанышы, сіздің есімдеріңіз сонда.
Dialogue: 0,0:04:45.00,0:04:48.00,Default,,0,0,0,,Бұл жолы да менде Лунаның Заосы бар.
Dialogue: 0,0:04:48.00,0:04:52.00,Default,,0,0,0,,Бауырлас мектептермен жарыс ойындары қызықты жағдайлар болып табылады.
Dialogue: 0,0:04:52.00,0:04:56.00,Default,,0,0,0,,Үміткерлер жоғары сынып оқушыларының арасынан іріктелетін сияқты.
Dialogue: 0,0:04:57.00,0:04:59.00,Default,,0,0,0,,Менің бөлімшеге
Dialogue: 0,0:04:59.00,0:05:02.00,Default,,0,0,0,,Жоқ, менің ойымша, жоқ.
Dialogue: 0,0:05:02.00,0:05:04.00,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:05:04.00,0:05:07.00,Default,,0,0,0,,Мен және Элли арасындағы демалыста тым көп айырмашылық бар.
Dialogue: 0,0:05:07.00,0:05:10.00,Default,,0,0,0,,Нақты қабілет
Dialogue: 0,0:05:10.00,0:05:12.00,Default,,0,0,0,,Бірақ егер
Dialogue: 0,0:05:12.00,0:05:16.00,Default,,0,0,0,,Мен Эллимен бірге жекпе-жек өткізсем тамаша болар еді.
Dialogue: 0,0:05:22.00,0:05:24.00,Default,,0,0,0,,Қайырлы таң Мери.
Dialogue: 0,0:05:26.00,0:05:28.00,Default,,0,0,0,,Қайырлы таң Нелл
Dialogue: 0,0:05:32.00,0:05:34.00,Default,,0,0,0,,Баршаңызға қайырлы таң.
Dialogue: 0,0:05:35.00,0:05:36.00,Default,,0,0,0,,Кеттік Элли
Dialogue: 0,0:05:37.00,0:05:43.00,Default,,0,0,0,,Биылғы Луна Люмьерді іріктеу байқауы бүгіннен бастап аяқталады.
Dialogue: 0,0:05:43.00,0:05:49.00,Default,,0,0,0,,Өздеріңіз білетіндей, Луна Люмьер іріктеу турнирі мектебіміздің бауырлас мектебі болып табылады.
Dialogue: 0,0:05:49.00,0:05:53.00,Default,,0,0,0,,Бұл Сент Дортрих қыздар мектебімен бірлескен іс-шара болады.
Dialogue: 0,0:05:53.00,0:05:59.00,Default,,0,0,0,,Екі мектепті де білдіретін үміткерлер Ай құдайы Луна Люмьер атағы үшін таласады.
Dialogue: 0,0:05:59.00,0:06:01.00,Default,,0,0,0,,Өзіңізді ауыр сынаққа шақырыңыз
Dialogue: 0,0:06:01.00,0:06:03.00,Default,,0,0,0,,Луна Люмьер таңдау матчы
Dialogue: 0,0:06:03.00,0:06:07.00,Default,,0,0,0,,Анықтама: 4 оқушы, әр мектептен 2 оқушы
Dialogue: 0,0:06:07.00,0:06:13.00,Default,,0,0,0,,Сонымен қатар, іріктеу матчы өтетін апта ішінде сыртқы әлеммен барлық байланыс үзіледі.
Dialogue: 0,0:06:13.00,0:06:18.00,Default,,0,0,0,,Үміткерлер тапсыратын сынақ іріктеу конкурсының соңғы күні өтеді.
Dialogue: 0,0:06:18.00,0:06:21.00,Default,,0,0,0,,Дегенмен, жеңіс пен жеңілісті осының өзі анықтамайды.
Dialogue: 0,0:06:21.00,0:06:26.00,Default,,0,0,0,,Кампустағы мінез-құлық және алдағы 7 күндегі күш-жігер
Dialogue: 0,0:06:26.00,0:06:30.00,Default,,0,0,0,,Олардың барлығы сараптамаға жатады
Dialogue: 0,0:06:30.00,0:06:34.00,Default,,0,0,0,,Сынақ нәтижелері және сіздің дауыстарыңыз
Dialogue: 0,0:06:34.00,0:06:39.00,Default,,0,0,0,,Нәтижесінде ең көп ұпай жинаған үміткер болады
Dialogue: 0,0:06:39.00,0:06:43.00,Default,,0,0,0,,Бір кездері мен Луна Люмьердің құрметіне ие боламын.
Dialogue: 0,0:06:46.00,0:06:49.00,Default,,0,0,0,,Таңқалдың ба, Сараша?
Dialogue: 0,0:06:49.00,0:06:51.00,Default,,0,0,0,,...
Dialogue: 0,0:06:51.00,0:06:54.00,Default,,0,0,0,,Валькири бұл шыны сарайды қорғайды.
Dialogue: 0,0:06:54.00,0:06:58.00,Default,,0,0,0,,Ешкімге рұқсатсыз ғимаратқа кіруге болмайды.
Dialogue: 0,0:06:58.00,0:07:03.00,Default,,0,0,0,,Кіргіңіз келсе, рұқсаттың дәлелін көрсетіңіз.
Dialogue: 0,0:07:03.00,0:07:05.00,Default,,0,0,0,,Қызық болар еді
Dialogue: 0,0:07:09.00,0:07:11.00,Default,,0,0,0,,Куира Эспада
Dialogue: 0,0:07:11.00,0:07:14.00,Default,,0,0,0,,Төменде Сейдо Торичу қыздар академиясының мектебі берілген.
Dialogue: 0,0:07:14.00,0:07:17.00,Default,,0,0,0,,Менің рұқсатым бар, өтуге рұқсат етіңіз.
Dialogue: 0,0:07:20.00,0:07:23.00,Default,,0,0,0,,Сіз кешірілген сияқтысыз.
Dialogue: 0,0:07:23.00,0:07:26.00,Default,,0,0,0,,Енді достарымызды қарсы алайық
Dialogue: 0,0:07:32.00,0:07:36.00,Default,,0,0,0,,Өйткені, Кира-сама Дортричтегі орта мектеп оқушысы.
Dialogue: 0,0:07:36.00,0:07:38.00,Default,,0,0,0,,Дортрих ханшайымы
Dialogue: 0,0:07:38.00,0:07:39.00,Default,,0,0,0,,Жаныңда кім бар?
Dialogue: 0,0:07:39.00,0:07:41.00,Default,,0,0,0,,Бірінші курстан жоғары студенттер
Dialogue: 0,0:07:41.00,0:07:43.00,Default,,0,0,0,,Ойланып қарасам, естігенмін.
Dialogue: 0,0:07:43.00,0:07:45.00,Default,,0,0,0,,Бірінші курстың таңғажайып студенттері бар.
Dialogue: 0,0:07:45.00,0:07:47.00,Default,,0,0,0,,Сен сүйкімдісің.
Dialogue: 0,0:07:54.00,0:07:58.00,Default,,0,0,0,,Енді әрі қарай жүріп, мектебіміздің үміткерлерін жария етейік.
Dialogue: 0,0:07:58.00,0:08:00.00,Default,,0,0,0,,Кандидат
Dialogue: 0,0:08:09.00,0:08:14.00,Default,,0,0,0,,Үміткерлер - Merida Angel Elise Angel
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:16.00,0:08:17.00,Default,,0,0,0,,Солай болуы керек.
Dialogue: 0,0:08:17.00,0:08:19.00,Default,,0,0,0,,Данжоға арналған бизнес атауы
Dialogue: 0,0:08:19.00,0:08:21.00,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:08:21.00,0:08:24.00,Default,,0,0,0,,Қазір бізде екі мектептен де үміткерлер бар.
Dialogue: 0,0:08:24.00,0:08:27.00,Default,,0,0,0,,Әрі қарай, біз сынақтар туралы хабарландыруға көшеміз.
Dialogue: 0,0:08:27.00,0:08:32.00,Default,,0,0,0,,Есте қаларлық 50-ші Луна Лу Миэль іріктеу матчының сынақтары
Dialogue: 0,0:08:32.00,0:08:36.00,Default,,0,0,0,,Бұл Грасмонд сарайында өтеді.
Dialogue: 0,0:08:36.00,0:08:38.00,Default,,0,0,0,,Сот процесі
Dialogue: 0,0:08:38.00,0:08:40.00,Default,,0,0,0,,Бірінші сыныпта,
Dialogue: 0,0:08:40.00,0:08:42.00,Default,,0,0,0,,Екінші сыныпта,
Dialogue: 0,0:08:42.00,0:08:44.00,Default,,0,0,0,,Үшінші сыныпта,
Dialogue: 0,0:08:44.00,0:08:46.00,Default,,0,0,0,,4-сыныпта,
Dialogue: 0,0:08:46.00,0:08:48.00,Default,,0,0,0,,5-сыныпта
Dialogue: 0,0:08:48.00,0:08:50.00,Default,,0,0,0,,Сынақтар үміткер жетекші ретінде өткізіледі.
Dialogue: 0,0:08:50.00,0:08:55.00,Default,,0,0,0,,Үш студентпен бірге роял ойыны
Dialogue: 0,0:08:55.00,0:08:56.00,Default,,0,0,0,,Уақыт шегінде,
Dialogue: 0,0:08:56.00,0:08:59.00,Default,,0,0,0,,Бұл медаль әр кеудеге,
Dialogue: 0,0:08:59.00,0:09:03.00,Default,,0,0,0,,Кім көп сызық сызады, сол жеңімпаз.
Dialogue: 0,0:09:03.00,0:09:04.00,Default,,0,0,0,,Енді көп ұзамай,
Dialogue: 0,0:09:04.00,0:09:09.00,Default,,0,0,0,,Студенттерден сынақтарын бөлісу үшін екі түлек ұсынуды сұраңыз.
Dialogue: 0,0:09:09.00,0:09:12.00,Default,,0,0,0,,Мерида Ангел, сізден
Dialogue: 0,0:09:13.00,0:09:15.00,Default,,0,0,0,,Жекпе-жекке кім серік болады?
Dialogue: 0,0:09:16.00,0:09:18.00,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:09:21.00,0:09:22.00,Default,,0,0,0,,Мерида-сан
Dialogue: 0,0:09:23.00,0:09:24.00,Default,,0,0,0,,өзінің нағыз Кира екенін дәлелдеуге бағытталған алдын ала ойластырылған кісі өлтіру
Dialogue: 0,0:09:32.00,0:09:34.00,Default,,0,0,0,,Сосын екіншісі маған
Dialogue: 0,0:09:34.00,0:09:35.00,Default,,0,0,0,,Мен!
Dialogue: 0,0:09:44.00,0:09:45.00,Default,,0,0,0,,Мен сізге айтамын,
Dialogue: 0,0:09:45.00,0:09:48.00,Default,,0,0,0,,Мен бұрынғы Көк адамдар ретінде жауапкершілікті өз мойныма алдым.
Dialogue: 0,0:09:48.00,0:09:50.00,Default,,0,0,0,,Танысқаныма қуаныштымын, Мерида
Dialogue: 0,0:09:51.00,0:09:52.00,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:09:53.00,0:09:57.00,Default,,0,0,0,,Биылғы сынақтарға қатысатын үміткерлер мен бөлімшелер жиналды.
Dialogue: 0,0:09:57.00,0:10:01.00,Default,,0,0,0,,Бұдан былай іріктеу матчы басталады.
Dialogue: 0,0:10:02.00,0:10:03.00,Default,,0,0,0,,Жасау!
Dialogue: 0,0:10:12.00,0:10:15.00,Default,,0,0,0,,Мүмкін болмайтын экстракция қорғаныс жүйесі екені өте таңқаларлық.
Dialogue: 0,0:10:15.00,0:10:17.00,Default,,0,0,0,,Төраға Гурушитаның жағымды әңгімесі,
Dialogue: 0,0:10:17.00,0:10:19.00,Default,,0,0,0,,Қарау өте ауыр болды.
Dialogue: 0,0:10:19.00,0:10:21.00,Default,,0,0,0,,Керемет нәрсе болуы керек
Dialogue: 0,0:10:21.00,0:10:23.00,Default,,0,0,0,,Иә, мен витражды ауыстырдым.
Dialogue: 0,0:10:23.00,0:10:24.00,Default,,0,0,0,,Ой...
Dialogue: 0,0:10:24.00,0:10:26.00,Default,,0,0,0,,Мен, бұл мен емес!
Dialogue: 0,0:10:27.00,0:10:28.00,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:30.00,0:10:31.00,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:10:32.00,0:10:34.00,Default,,0,0,0,,Бүкіл әлем күмәнданса да,
Dialogue: 0,0:10:34.00,0:10:36.00,Default,,0,0,0,,Мен ғана сенің жаныңдамын
Dialogue: 0,0:10:37.00,0:10:38.00,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:10:39.00,0:10:40.00,Default,,0,0,0,,Сондықтан, жас ханым,
Dialogue: 0,0:10:41.00,0:10:42.00,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,0:10:43.00,0:10:45.00,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:10:47.00,0:10:48.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:48.00,0:10:50.00,Default,,0,0,0,,Гаррик Хамо!
Dialogue: 0,0:10:51.00,0:10:52.00,Default,,0,0,0,,Сынақ семсерін алып тастау!
Dialogue: 0,0:10:57.00,0:10:59.00,Default,,0,0,0,,Қылышты суару уақыты нашар.
Dialogue: 0,0:11:00.00,0:11:01.00,Default,,0,0,0,,Сәлем,
Dialogue: 0,0:11:01.00,0:11:05.00,Default,,0,0,0,,Тым болмаса мына қаруды жеңілдете алмайсың ба?
Dialogue: 0,0:11:06.00,0:11:09.00,Default,,0,0,0,,Егер Мерида жарақат алса, біз қиындыққа тап боламыз.
Dialogue: 0,0:11:09.00,0:11:10.00,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:11:11.00,0:11:12.00,Default,,0,0,0,,Біздің қаруымыз,
Dialogue: 0,0:11:12.00,0:11:13.00,Default,,0,0,0,,Ең болмағанда үзіліс жасаңыз
Dialogue: 0,0:11:13.00,0:11:15.00,Default,,0,0,0,,Мен де сізден бір жақсылық сұрайын деп едім.
Dialogue: 0,0:11:15.00,0:11:16.00,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:11:17.00,0:11:18.00,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:11:19.00,0:11:20.00,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:11:20.00,0:11:22.00,Default,,0,0,0,,Қысқа үзіліс
Dialogue: 0,0:11:23.00,0:11:24.00,Default,,0,0,0,,Иә
Dialogue: 0,0:11:28.00,0:11:29.00,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:11:29.00,0:11:30.00,Default,,0,0,0,,Біздің қару-жарақ,
Dialogue: 0,0:11:31.00,0:11:32.00,Default,,0,0,0,,Біздің қару-жарақ,
Dialogue: 0,0:11:33.00,0:11:34.00,Default,,0,0,0,,Біздің қару-жарақ,
Dialogue: 0,0:11:35.00,0:11:36.00,Default,,0,0,0,,Біздің қару-жарақ,
Dialogue: 0,0:11:37.00,0:11:38.00,Default,,0,0,0,,Біздің қару-жарақ,
Dialogue: 0,0:11:38.00,0:11:39.00,Default,,0,0,0,,Міне.
Dialogue: 0,0:11:39.00,0:11:41.00,Default,,0,0,0,,Эллимен тең дәрежеде күресу керемет.
Dialogue: 0,0:11:44.00,0:11:45.00,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:11:45.00,0:11:46.00,Default,,0,0,0,,Мерида Ангел
Dialogue: 0,0:11:53.00,0:11:56.00,Default,,0,0,0,,Фридес Виденің біліксіз үй иесі
Dialogue: 0,0:11:57.00,0:11:58.00,Default,,0,0,0,,Атақты
Dialogue: 0,0:11:58.00,0:12:00.00,Default,,0,0,0,,Отағасы мен әскери отбасы, екеуі де
Dialogue: 0,0:12:01.00,0:12:04.00,Default,,0,0,0,,Фридес Виденің біліксіз үй иесі
Dialogue: 0,0:12:04.00,0:12:05.00,Default,,0,0,0,,Атақты
Dialogue: 0,0:12:06.00,0:12:07.00,Default,,0,0,0,,Отағасы және әскери отбасы,
Dialogue: 0,0:12:07.00,0:12:09.00,Default,,0,0,0,,Періштелер отбасының екі ханымы
Dialogue: 0,0:12:10.00,0:12:12.00,Default,,0,0,0,,Бұл екеуі үміткер болады.
Dialogue: 0,0:12:12.00,0:12:13.00,Default,,0,0,0,,Бұл өте ирониялық.
Dialogue: 0,0:12:16.00,0:12:18.00,Default,,0,0,0,,Император әулетінің дұрыс тегі болуы,
Dialogue: 0,0:12:19.00,0:12:20.00,Default,,0,0,0,,Көпшілікке көрсету үшін.
Dialogue: 0,0:12:21.00,0:12:23.00,Default,,0,0,0,,Сіз жеңуіңіз керек
Dialogue: 0,0:12:23.00,0:12:24.00,Default,,0,0,0,,Элиза Ангелге
Dialogue: 0,0:12:25.00,0:12:26.00,Default,,0,0,0,,Менің айтайын дегенім осы ма?
Dialogue: 0,0:12:27.00,0:12:28.00,Default,,0,0,0,,Егер сізде күш болса,
Dialogue: 0,0:12:28.00,0:12:29.00,Default,,0,0,0,,Жоғалмаңыз
Dialogue: 0,0:12:30.00,0:12:31.00,Default,,0,0,0,,Тек мынаны көрсету арқылы,
Dialogue: 0,0:12:31.00,0:12:33.00,Default,,0,0,0,,Адамдар сізге сенеді
Dialogue: 0,0:12:33.00,0:12:34.00,Default,,0,0,0,,Егер сіз бірдеңені орындағыңыз келсе,
Dialogue: 0,0:12:34.00,0:12:37.00,Default,,0,0,0,,Егер сізде бұл күш бар екенін дәлелдемейінше
Dialogue: 0,0:12:40.00,0:12:42.00,Default,,0,0,0,,Дәлелдеу күші
Dialogue: 0,0:12:45.00,0:12:46.00,Default,,0,0,0,,Мен сені сүйем.
Dialogue: 0,0:12:47.00,0:12:48.00,Default,,0,0,0,,Мерида-чан
Dialogue: 0,0:12:48.00,0:12:49.00,Default,,0,0,0,,О, бұл
Dialogue: 0,0:12:56.00,0:12:57.00,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:12:58.00,0:12:59.00,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:12:59.00,0:13:00.00,Default,,0,0,0,,Қазіргі студенттеріңіз кім?
Dialogue: 0,0:13:01.00,0:13:02.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:03.00,0:13:04.00,Default,,0,0,0,,Даутрих
Dialogue: 0,0:13:06.00,0:13:09.00,Default,,0,0,0,,Мен сенің атыңды сұрауды ұмытып кетіппін.
Dialogue: 0,0:13:23.00,0:13:25.00,Default,,0,0,0,,Дәлелдерді түннің бір уағында қалай жоюға болады?
Dialogue: 0,0:13:25.00,0:13:26.00,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:13:30.00,0:13:32.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:33.00,0:13:34.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:38.00,0:13:39.00,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:13:40.00,0:13:41.00,Default,,0,0,0,,На
Dialogue: 0,0:13:44.00,0:13:45.00,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:13:45.00,0:13:47.00,Default,,0,0,0,,Бұл витраждың бөлігі ме?
Dialogue: 0,0:13:48.00,0:13:49.00,Default,,0,0,0,,Сізбен бірге болған адам,
Dialogue: 0,0:13:49.00,0:13:51.00,Default,,0,0,0,,Бұл өте абайсызда.
Dialogue: 0,0:13:51.00,0:13:52.00,Default,,0,0,0,,Бұлай болмауы керек.
Dialogue: 0,0:13:52.00,0:13:54.00,Default,,0,0,0,,Бүгін таңертең дұрыстап тексеруім керек еді.
Dialogue: 0,0:13:54.00,0:13:55.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:55.00,0:13:56.00,Default,,0,0,0,,Не ауыстырылды
Dialogue: 0,0:13:56.00,0:13:57.00,Default,,0,0,0,,Кеше түн болды ма?
Dialogue: 0,0:13:58.00,0:14:00.00,Default,,0,0,0,,Бұл туралы айту өте жаман.
Dialogue: 0,0:14:01.00,0:14:02.00,Default,,0,0,0,,Бұл шыны бөлігі
Dialogue: 0,0:14:02.00,0:14:04.00,Default,,0,0,0,,Мен пайдаланған витраж емес
Dialogue: 0,0:14:04.00,0:14:06.00,Default,,0,0,0,,Мен оны дайындадым.
Dialogue: 0,0:14:07.00,0:14:08.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:14:08.00,0:14:09.00,Default,,0,0,0,,Ханымдар
Dialogue: 0,0:14:10.00,0:14:11.00,Default,,0,0,0,,Отелло мырза
Dialogue: 0,0:14:12.00,0:14:13.00,Default,,0,0,0,,Леди Элиза
Dialogue: 0,0:14:13.00,0:14:14.00,Default,,0,0,0,,Мен жай ғана
Dialogue: 0,0:14:14.00,0:14:15.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:15.00,0:14:16.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:17.00,0:14:19.00,Default,,0,0,0,,Әрине жас ханым үшін.
Dialogue: 0,0:14:20.00,0:14:22.00,Default,,0,0,0,,Үлкен рөлде бәсекеге түссең, қарсы тұра алмайсың.
Dialogue: 0,0:14:22.00,0:14:25.00,Default,,0,0,0,,Қайсысы Періште болуға лайықты екенін анықтайық.
Dialogue: 0,0:14:25.00,0:14:26.00,Default,,0,0,0,,Содан кейін,
Dialogue: 0,0:14:26.00,0:14:28.00,Default,,0,0,0,,Ханымдарды тікелей ұрысуға мәжбүр ету
Dialogue: 0,0:14:28.00,0:14:29.00,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:14:29.00,0:14:31.00,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:31.00,0:14:33.00,Default,,0,0,0,,Мен енді шыдай алмаймын.
Dialogue: 0,0:14:33.00,0:14:35.00,Default,,0,0,0,,Ондағы ең қабілетсіз қыз
Dialogue: 0,0:14:35.00,0:14:37.00,Default,,0,0,0,,Леди Элизамен қатар тұру және т.б.
Dialogue: 0,0:14:37.00,0:14:39.00,Default,,0,0,0,,Әрбір батылдықпен танысыңыз
Dialogue: 0,0:14:39.00,0:14:41.00,Default,,0,0,0,,Картасыз жүгіру
Dialogue: 0,0:14:41.00,0:14:42.00,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:14:43.00,0:14:44.00,Default,,0,0,0,,Элли және мен
Dialogue: 0,0:14:44.00,0:14:47.00,Default,,0,0,0,,Ауыстырылмайтын байланыс арқылы жалғанған
Dialogue: 0,0:14:49.00,0:14:51.00,Default,,0,0,0,,Егер сіз бірдеңені шығарғыңыз келсе
Dialogue: 0,0:14:51.00,0:14:54.00,Default,,0,0,0,,Егер сізде мұндай күш бар екенін мойындамасаңыз
Dialogue: 0,0:14:55.00,0:14:57.00,Default,,0,0,0,,Сондықтан мойындаңыз
Dialogue: 0,0:14:57.00,0:14:58.00,Default,,0,0,0,,Егер
Dialogue: 0,0:14:58.00,0:15:00.00,Default,,0,0,0,,Мен сотта Эллиді жеңсем
Dialogue: 0,0:15:01.00,0:15:03.00,Default,,0,0,0,,Егер сіз қабілетсіз екеніңізді дәлелдей алсаңыз
Dialogue: 0,0:15:03.00,0:15:06.00,Default,,0,0,0,,Маған Эллимен бірлік құруға рұқсат етіңіз.
Dialogue: 0,0:15:10.00,0:15:11.00,Default,,0,0,0,,Риттер
Dialogue: 0,0:15:19.00,0:15:21.00,Default,,0,0,0,,Сіз бұрын жақсы жұмыс істедіңіз.
Dialogue: 0,0:15:26.00,0:15:29.00,Default,,0,0,0,,Ол кезде мен жынды едім.
Dialogue: 0,0:15:29.00,0:15:31.00,Default,,0,0,0,,Сондықтан сен менің шәкіртімсің.
Dialogue: 0,0:15:31.00,0:15:33.00,Default,,0,0,0,,Қарсыластың алшақтығын пайдалану
Dialogue: 0,0:15:33.00,0:15:35.00,Default,,0,0,0,,Күтпеген жерден соққы беру
Dialogue: 0,0:15:35.00,0:15:37.00,Default,,0,0,0,,Өте жақсы орындалған
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:15:42.00,0:15:45.00,Default,,0,0,0,,Ал, автобиографиялық батадан кесілген ені
Dialogue: 0,0:15:45.00,0:15:47.00,Default,,0,0,0,,Мен мұны анық шешсем деп едім.
Dialogue: 0,0:15:47.00,0:15:49.00,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:15:50.00,0:15:52.00,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:15:52.00,0:15:54.00,Default,,0,0,0,,Қайырлы түн, мұғалім.
Dialogue: 0,0:15:59.00,0:16:01.00,Default,,0,0,0,,-
Dialogue: 0,0:16:11.00,0:16:13.00,Default,,0,0,0,,Осеро-сан болады деп ойламадым.
Dialogue: 0,0:16:13.00,0:16:15.00,Default,,0,0,0,,Мен бұлайша бақылаудан шығады деп күтпедім.
Dialogue: 0,0:16:20.00,0:16:22.00,Default,,0,0,0,,Сондай ащы жас келіншек
Dialogue: 0,0:16:22.00,0:16:24.00,Default,,0,0,0,,бәлкім, осы ғана шығар
Dialogue: 0,0:16:29.00,0:16:31.00,Default,,0,0,0,,-
Dialogue: 0,0:16:38.00,0:16:40.00,Default,,0,0,0,,Ақ түннің хабаршысы
Dialogue: 0,0:16:43.00,0:16:45.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:53.00,0:16:56.00,Default,,0,0,0,,Бұл сенсің, Блэк Мэдью.
Dialogue: 0,0:16:59.00,0:17:01.00,Default,,0,0,0,,-
Dialogue: 0,0:17:10.00,0:17:12.00,Default,,0,0,0,,Элли
Dialogue: 0,0:17:12.00,0:17:14.00,Default,,0,0,0,,Мұнда не үшін келдің?
Dialogue: 0,0:17:21.00,0:17:23.00,Default,,0,0,0,,Мен оны сол күйінде хабарлағанша
Dialogue: 0,0:17:23.00,0:17:25.00,Default,,0,0,0,,Ешқандай күдік жоқ
Dialogue: 0,0:17:30.00,0:17:32.00,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:17:44.00,0:17:46.00,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:17:46.00,0:17:48.00,Default,,0,0,0,,Мен қазір Періштелер отбасының қызметшісімін.
Dialogue: 0,0:17:48.00,0:17:50.00,Default,,0,0,0,,Лауазымға қауіп төндіретін әрекеттерді жасауға болмайды.
Dialogue: 0,0:17:54.00,0:17:56.00,Default,,0,0,0,,Мен сол Одақтың әрбір сорлысының миын шағып тастаймын!
Dialogue: 0,0:18:00.00,0:18:02.00,Default,,0,0,0,,-
Dialogue: 0,0:18:14.00,0:18:16.00,Default,,0,0,0,,Енді мен ханымның қызметшісімін
Dialogue: 0,0:18:16.00,0:18:18.00,Default,,0,0,0,,Өз міндеттерін орындау
Dialogue: 0,0:18:25.00,0:18:27.00,Default,,0,0,0,,Әдейі жеңілу деген нені білдіреді?
Dialogue: 0,0:18:27.00,0:18:29.00,Default,,0,0,0,,Мен айтқанымдай.
Dialogue: 0,0:18:29.00,0:18:31.00,Default,,0,0,0,,Мен сотта Ритадан жеңілдім.
Dialogue: 0,0:18:31.00,0:18:33.00,Default,,0,0,0,,Сонда Осеро-сан болады
Dialogue: 0,0:18:33.00,0:18:35.00,Default,,0,0,0,,Ританың қабілетін мойындауым керек.
Dialogue: 0,0:18:35.00,0:18:37.00,Default,,0,0,0,,Бұл менің қабілетім емес.
Dialogue: 0,0:18:37.00,0:18:39.00,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:18:39.00,0:18:41.00,Default,,0,0,0,,Бұлай көріну маңызды
Dialogue: 0,0:18:43.00,0:18:45.00,Default,,0,0,0,,Элли, сен
Dialogue: 0,0:18:49.00,0:18:51.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:51.00,0:18:53.00,Default,,0,0,0,,-
Dialogue: 0,0:18:55.00,0:18:57.00,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:19:03.00,0:19:05.00,Default,,0,0,0,,Розетти мырза
Dialogue: 0,0:19:05.00,0:19:07.00,Default,,0,0,0,,Мен мектеп директорларына хабарладым.
Dialogue: 0,0:19:07.00,0:19:09.00,Default,,0,0,0,,Мен саған мұнда келудің қажеті жоқ дедім.
Dialogue: 0,0:19:09.00,0:19:11.00,Default,,0,0,0,,Бұлай болуы мүмкін емес, солай ма?
Dialogue: 0,0:19:11.00,0:19:13.00,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:19:13.00,0:19:15.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:19.00,0:19:21.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:21.00,0:19:23.00,Default,,0,0,0,,Жоқ, жарайды.
Dialogue: 0,0:19:23.00,0:19:25.00,Default,,0,0,0,,Мектеп тыныштығын бұзғандарға шара қолдануыңызды сұраймын.
Dialogue: 0,0:19:29.00,0:19:31.00,Default,,0,0,0,,Жасалған қарулар
Dialogue: 0,0:19:37.00,0:19:39.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:39.00,0:19:41.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:43.00,0:19:45.00,Default,,0,0,0,,-
Dialogue: 0,0:19:45.00,0:19:47.00,Default,,0,0,0,,-
Dialogue: 0,0:19:47.00,0:19:49.00,Default,,0,0,0,,-
Dialogue: 0,0:19:49.00,0:19:51.00,Default,,0,0,0,,-
Dialogue: 0,0:19:51.00,0:19:53.00,Default,,0,0,0,,-
Dialogue: 0,0:19:53.00,0:19:55.00,Default,,0,0,0,,Мұның бәрі ойынға арналған
Dialogue: 0,0:19:55.00,0:19:57.00,Default,,0,0,0,,-
Dialogue: 0,0:19:57.00,0:19:59.00,Default,,0,0,0,,-
Dialogue: 0,0:19:59.00,0:20:01.00,Default,,0,0,0,,-
Dialogue: 0,0:20:01.00,0:20:03.00,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:20:03.00,0:20:05.00,Default,,0,0,0,,Доши-чан қайда?
Dialogue: 0,0:20:05.00,0:20:07.00,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:20:07.00,0:20:09.00,Default,,0,0,0,,Сіз ешкімнің назарын аударғыңыз келмейді.
Dialogue: 0,0:20:09.00,0:20:11.00,Default,,0,0,0,,Бір жаққа қойыңыз
