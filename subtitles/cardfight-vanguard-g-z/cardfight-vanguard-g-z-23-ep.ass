Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.39,0:01:06.89,Default,,0,0,0,,Дүние
Dialogue: 0,0:01:08.76,0:01:11.06,Default,,0,0,0,,Үндемеңіз
Dialogue: 0,0:01:13.27,0:01:17.57,Default,,0,0,0,,Мен алып келем
Dialogue: 0,0:01:30.60,0:01:33.59,Default,,0,0,0,,Ол қайтадан көбейіп жатыр...
Dialogue: 0,0:01:33.59,0:01:36.61,Default,,0,0,0,,Мен сені жеңсем де, оның шегі жоқ!
Dialogue: 0,0:01:36.61,0:01:38.99,Default,,0,0,0,,Еш қағыспа
Dialogue: 0,0:01:38.99,0:01:41.26,Default,,0,0,0,,Біздің ойымыз сізге міндетті түрде жетеді
Dialogue: 0,0:01:41.26,0:01:43.27,Default,,0,0,0,,Крей планетасында
Dialogue: 0,0:01:43.27,0:01:46.27,Default,,0,0,0,,Реликтермен Куроно мен оның достарына қарсы күрес!
Dialogue: 0,0:01:50.27,0:01:54.26,Default,,0,0,0,,Мен бас тартуым керек пе? Казума мен басқалары қайтып келгенше.
Dialogue: 0,0:01:54.26,0:01:56.29,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:01:56.29,0:01:59.60,Default,,0,0,0,,Мен де саған көмектесейін, Казуми-кун.
Dialogue: 0,0:01:59.60,0:02:02.60,Default,,0,0,0,,Ол да сенің күшің болғысы келеді.
Dialogue: 0,0:02:04.60,0:02:08.02,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:02:08.02,0:02:10.72,Default,,0,0,0,,Біз бірміз!
Dialogue: 0,0:02:13.26,0:02:15.95,Default,,0,0,0,,＜ｳﾞｧﾝｶﾞｰﾄﾞ
Dialogue: 0,0:02:15.95,0:02:18.93,Default,,0,0,0,,Екі дүниенің тағдырын басқар→
Dialogue: 0,0:02:18.93,0:02:23.27,Default,,0,0,0,,Бұл карта ойыны алмастырылмайтын байланыстарды дамытты→
Dialogue: 0,0:02:23.27,0:02:26.66,Default,,0,0,0,,Әрқашан адамдарды орнынан тұрғызу→
Dialogue: 0,0:02:26.66,0:02:30.46,Default,,0,0,0,,Сансыз аңыздар жасадық＞
Dialogue: 0,0:02:33.62,0:02:36.27,Default,,0,0,0,,＜ Енді сол тарихта →
Dialogue: 0,0:02:36.27,0:02:39.87,Default,,0,0,0,,Жаңа ғажайыптың ойылуы алда>
Dialogue: 0,0:05:52.26,0:05:54.95,Default,,0,0,0,,Келіңіздер... келіңіздер!!
Dialogue: 0,0:05:54.95,0:05:58.35,Default,,0,0,0,,Біз... жеңілмейміз!
Dialogue: 0,0:06:00.34,0:06:02.94,Default,,0,0,0,,Біз сізге фургон-гвардияны көрсетеміз!
Dialogue: 0,0:06:22.93,0:06:25.43,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:06:33.36,0:06:36.27,Default,,0,0,0,,Әлі емес...
Dialogue: 0,0:06:36.27,0:06:40.93,Default,,0,0,0,,Бұл бітпейді... Өйткені мен...
Dialogue: 0,0:06:40.93,0:06:43.93,Default,,0,0,0,,Бізде әлі бәрі жоқ.
Dialogue: 0,0:06:43.93,0:06:48.32,Default,,0,0,0,,Оны келесі бұрылысқа жіберме! Оны ұстайтын менмін!!
Dialogue: 0,0:06:48.32,0:06:51.92,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｻﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:06:55.26,0:06:58.58,Default,,0,0,0,,Өлмейтін қасиетті қылыш Фидес!
Dialogue: 0,0:06:58.58,0:07:00.60,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ
Dialogue: 0,0:07:00.60,0:07:03.67,Default,,0,0,0,,Редонның шеберлігі. Қуат плюс 3000!
Dialogue: 0,0:07:03.67,0:07:07.91,Default,,0,0,0,,Сырғанау шеберлігі. Ferex үшін қуат плюс 3000!
Dialogue: 0,0:07:07.91,0:07:11.28,Default,,0,0,0,,Қоңырау шалу. Тағы да сол шеберлік!
Dialogue: 0,0:07:11.28,0:07:13.95,Default,,0,0,0,,Мен жетілмегенмін
Dialogue: 0,0:07:13.95,0:07:19.58,Default,,0,0,0,,Мен тәкаппар әрі сараңмын, қалағанымның бәрін алуға күшім жетпейді.
Dialogue: 0,0:07:19.58,0:07:22.30,Default,,0,0,0,,Сондықтан мен оны қазір аламын!
Dialogue: 0,0:07:22.30,0:07:24.94,Default,,0,0,0,,Жетіспейтін бөлік неғұрлым үлкен болса→
Dialogue: 0,0:07:24.94,0:07:27.93,Default,,0,0,0,,Сіз салуға болатын заттар да үлкенірек болады!
Dialogue: 0,0:07:27.93,0:07:29.94,Default,,0,0,0,,ﾌﾞﾚｲﾌﾞ!!
Dialogue: 0,0:07:29.94,0:07:31.93,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:07:31.93,0:07:34.37,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:07:34.37,0:07:39.29,Default,,0,0,0,,Сын қызыл. Қуат - бұл миль!
Dialogue: 0,0:07:39.29,0:07:41.67,Default,,0,0,0,,Менің жетілмегендігім →
Dialogue: 0,0:07:41.67,0:07:44.37,Default,,0,0,0,,Бұл менің мүмкіндігім!
Dialogue: 0,0:07:53.28,0:07:55.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:55.32,0:07:57.36,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:07:57.36,0:07:59.92,Default,,0,0,0,,Мұның бәрі Анджо Токоха үшін→
Dialogue: 0,0:07:59.92,0:08:02.93,Default,,0,0,0,,Бас тартпаңыз!
Dialogue: 0,0:08:02.93,0:08:05.60,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:08:05.60,0:08:09.02,Default,,0,0,0,,(Кёко) Жинап қойған сол таратылым қағаздарды лақтырып жібересің ғой?
Dialogue: 0,0:08:09.02,0:08:11.42,Default,,0,0,0,,Сіз осындасыз
Dialogue: 0,0:08:13.27,0:08:17.27,Default,,0,0,0,,Ұрпақ қорғаушысы. Күзетші мушкетер Антеро!
Dialogue: 0,0:08:20.28,0:08:24.93,Default,,0,0,0,,Авангардпен бірге қазір және мәңгі
Dialogue: 0,0:08:24.93,0:08:27.93,Default,,0,0,0,,Иллюзиониялық Рананкулалар Ашердің шеберлігі
Dialogue: 0,0:08:31.34,0:08:33.64,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:08:36.26,0:08:39.60,Default,,0,0,0,,Төрт мезгіл гүлі ханшайымы Вальгемина!
Dialogue: 0,0:08:39.60,0:08:43.25,Default,,0,0,0,,Буын үзілісінің алдыңғы бөлігі. Алдыңғы қатардағы барлық тыл сақшылары үшін →
Dialogue: 0,0:08:43.25,0:08:47.71,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ5000｡ ｸﾘﾃｨｶﾙﾌﾟﾗｽ１
Dialogue: 0,0:08:47.71,0:08:51.71,Default,,0,0,0,,Авангардқа Ultima арқылы шабуыл жасаңыз
Dialogue: 0,0:08:56.83,0:08:59.33,Default,,0,0,0,,Сіз ештеңесіз
Dialogue: 0,0:09:04.61,0:09:07.59,Default,,0,0,0,,Егер мен Авангардты кездестірмесем→
Dialogue: 0,0:09:07.59,0:09:11.01,Default,,0,0,0,,Ештеңені ұға алмайтын қуыс болмыс
Dialogue: 0,0:09:11.01,0:09:13.95,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:09:13.95,0:09:16.95,Default,,0,0,0,,Авангардтан... Барлығынан
Dialogue: 0,0:09:16.95,0:09:19.65,Default,,0,0,0,,Болашақты түсінуге барлық күш!\NЕгер бұл
Dialogue: 0,0:09:21.61,0:09:24.31,Default,,0,0,0,,болса, жауап беруден басқа амалыңыз қалмайды!
Dialogue: 0,0:09:32.58,0:09:37.27,Default,,0,0,0,,Бұдан былай қандай жағдай болса да, жүрегіңді биік ұстап, өміріңді толықтай өткіз!
Dialogue: 0,0:09:37.27,0:09:39.64,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:09:39.64,0:09:43.68,Default,,0,0,0,,Бұл сізге өтеу үшін қолымнан келгеннің ең жақсысы!
Dialogue: 0,0:09:43.68,0:09:46.61,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ！
Dialogue: 0,0:09:46.61,0:09:50.00,Default,,0,0,0,,Мен басынан бастап білдім
Dialogue: 0,0:09:50.00,0:09:53.59,Default,,0,0,0,,Сіз міндетті түрде керемет жауынгер боласыз.
Dialogue: 0,0:09:53.59,0:09:56.91,Default,,0,0,0,,Тек алға! түзу
Dialogue: 0,0:09:56.91,0:09:59.58,Default,,0,0,0,,Сіз таңдаған жол!
Dialogue: 0,0:09:59.58,0:10:01.93,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:01.93,0:10:04.95,Default,,0,0,0,,Қазір сізді қолдайтын көптеген амигостар бар.
Dialogue: 0,0:10:04.95,0:10:07.99,Default,,0,0,0,,Сіз мұның бәрін өзіңіз ұстадыңыз.
Dialogue: 0,0:10:07.99,0:10:12.94,Default,,0,0,0,,Avangard Fighter - бұл сынақ! Жүрек айтқандай құмар болыңыз!
Dialogue: 0,0:10:12.94,0:10:16.59,Default,,0,0,0,,Төбелесте адамға қатысты барлық нәрсе көрінеді.
Dialogue: 0,0:10:16.59,0:10:21.28,Default,,0,0,0,,Қазір күрессең, болашағың міндетті түрде жолға түседі.
Dialogue: 0,0:10:21.28,0:10:23.94,Default,,0,0,0,,Тез тазалап, қайтып кел.
Dialogue: 0,0:10:23.94,0:10:26.94,Default,,0,0,0,,Біздің болашағымыз алда
Dialogue: 0,0:10:26.94,0:10:31.33,Default,,0,0,0,,Мені бұған сендірген сенің жекпе-жегің болды.
Dialogue: 0,0:10:31.33,0:10:34.60,Default,,0,0,0,,Куроно мырза! Іске сәт!!
Dialogue: 0,0:10:34.60,0:10:38.28,Default,,0,0,0,,Сіз оны көре аласыз ба? Токими…
Dialogue: 0,0:10:38.28,0:10:41.28,Default,,0,0,0,,Болашақты ұлымыз алады
Dialogue: 0,0:10:43.25,0:10:45.71,Default,,0,0,0,,Chronojet Dragon Z дағдылары
Dialogue: 0,0:10:45.71,0:10:49.94,Default,,0,0,0,,Қадам құнына дейін зодиак уақытының 3-сынып аймағын төмендетіңіз
Dialogue: 0,0:10:49.94,0:10:54.35,Default,,0,0,0,,Қазір көрсет! Мен шынымен қалайтын әлем!!
Dialogue: 0,0:10:54.35,0:10:58.29,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:10:58.29,0:11:02.89,Default,,0,0,0,,ｸﾛﾉﾊﾞｲｻﾞｰ･ﾍﾘﾃｰｼﾞ！
Dialogue: 0,0:11:06.94,0:11:10.64,Default,,0,0,0,,Маған жол көрсеткеніңіз үшін рахмет
Dialogue: 0,0:11:12.60,0:11:15.97,Default,,0,0,0,,Маған болашақ сыйлағаныңыз үшін рахмет
Dialogue: 0,0:11:15.97,0:11:19.29,Default,,0,0,0,,Мен үшін рахмет→
Dialogue: 0,0:11:19.29,0:11:21.89,Default,,0,0,0,,Өз өмірің үшін күрескені үшін
Dialogue: 0,0:11:24.93,0:11:26.93,Default,,0,0,0,,ｶｽﾞﾏ
Dialogue: 0,0:11:28.92,0:11:30.92,Default,,0,0,0,,ｸﾛﾉ…
Dialogue: 0,0:11:30.92,0:11:33.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:33.60,0:11:36.96,Default,,0,0,0,,Үйге қайтайық! Касума!!
Dialogue: 0,0:11:36.96,0:11:40.01,Default,,0,0,0,,Барлығы бізді күтуде!
Dialogue: 0,0:11:40.01,0:11:43.05,Default,,0,0,0,,Авангардқа мұрамен шабуыл жасаңыз!
Dialogue: 0,0:11:43.05,0:11:44.95,Default,,0,0,0,,ﾄﾞｷﾄﾞｷ･ﾜｰｶｰ！
Dialogue: 0,0:11:44.95,0:11:48.35,Default,,0,0,0,,Гяаах!
Dialogue: 0,0:11:51.32,0:11:53.32,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:11:56.59,0:11:58.93,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:11:58.93,0:12:01.60,Default,,0,0,0,,Мұра дағдыларын белсендіру
Dialogue: 0,0:12:01.60,0:12:04.29,Default,,0,0,0,,1 қосымша айналымға ие болыңыз
Dialogue: 0,0:12:04.29,0:12:08.79,Default,,0,0,0,,Жүріс қадамын өткізіп, мұра арқылы қадам басыңыз!
Dialogue: 0,0:12:10.78,0:12:13.78,Default,,0,0,0,,Тағы да менің кезегім!!
Dialogue: 0,0:12:16.60,0:12:19.28,Default,,0,0,0,,Жүр! Қызыл!
Dialogue: 0,0:12:19.28,0:12:21.28,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:12:26.27,0:12:28.27,Default,,0,0,0,,ｱﾙﾄﾏｲﾙ！
Dialogue: 0,0:12:39.37,0:12:43.67,Default,,0,0,0,,Бұл оңай. Тек өз мүмкіндігіңізге сеніңіз.
Dialogue: 0,0:12:46.26,0:12:48.26,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:12:50.25,0:12:52.93,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:12:52.93,0:12:54.92,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:12:54.92,0:12:56.95,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:12:56.95,0:12:58.95,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:13:00.94,0:13:03.59,Default,,0,0,0,,ﾌﾞﾙｰﾑ！
Dialogue: 0,0:13:03.59,0:13:06.28,Default,,0,0,0,,Гяаах!
Dialogue: 0,0:13:06.28,0:13:08.93,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:13:08.93,0:13:10.93,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:13:13.60,0:13:17.90,Default,,0,0,0,,Енді біздің болашағымыз гүлдейді
Dialogue: 0,0:13:32.79,0:13:36.26,Default,,0,0,0,,Chrono Dran Z шеберлігі. Палубадан 5 картаны қараңыз→
Dialogue: 0,0:13:36.26,0:13:40.93,Default,,0,0,0,,1 немесе 3 сыныптың бір бірлігіне дейін ашып, оны қолыңызға қосыңыз.
Dialogue: 0,0:13:40.93,0:13:43.94,Default,,0,0,0,,Сонымен қатар, Chrono Dran Z шеберлігі
Dialogue: 0,0:13:43.94,0:13:46.37,Default,,0,0,0,,Бұл картаны қолыңызға қайтарыңыз
Dialogue: 0,0:13:46.37,0:13:49.97,Default,,0,0,0,,Қоңырау шалыңыз! Kurono Doran Z's Boost!
Dialogue: 0,0:13:51.94,0:13:56.01,Default,,0,0,0,,Авангардқа мұрамен шабуыл жасаңыз!
Dialogue: 0,0:13:56.01,0:13:58.01,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:14:00.60,0:14:02.60,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:14:04.66,0:14:07.66,Default,,0,0,0,,Қазір кеттік... Касума!
Dialogue: 0,0:14:09.94,0:14:12.43,Default,,0,0,0,,Жаңа болашақ бұл→
Dialogue: 0,0:14:12.43,0:14:15.13,Default,,0,0,0,,Осы жерден басталады!
Dialogue: 0,0:14:21.27,0:14:23.57,Default,,0,0,0,,ｸﾛﾉ…
Dialogue: 0,0:14:30.18,0:14:32.98,Default,,0,0,0,,ｶｽﾞﾏ～!!
Dialogue: 0,0:14:44.93,0:14:47.33,Default,,0,0,0,,Ааа, кеш болды.
Dialogue: 0,0:14:50.60,0:14:52.60,Default,,0,0,0,,Міне, Аня-чанның бәрі осы екен-ау?
Dialogue: 0,0:14:54.64,0:14:56.94,Default,,0,0,0,,Рақмет.
Dialogue: 0,0:15:08.94,0:15:11.34,Default,,0,0,0,,Ештіктің кеңеюі тоқтады!
Dialogue: 0,0:15:13.59,0:15:15.59,Default,,0,0,0,,Аспан қайтып келеді
Dialogue: 0,0:15:15.59,0:15:18.60,Default,,0,0,0,,Олар мұны істеді!
Dialogue: 0,0:15:18.60,0:15:20.60,Default,,0,0,0,,ｶｽﾞﾏ…
Dialogue: 0,0:15:20.60,0:15:22.90,Default,,0,0,0,,Ах... Касума!
Dialogue: 0,0:15:26.59,0:15:28.61,Default,,0,0,0,,ｶｽﾞﾏ！
Dialogue: 0,0:15:28.61,0:15:31.31,Default,,0,0,0,,ｶｽﾞﾏ！ ｶｽﾞﾏ…
Dialogue: 0,0:15:33.68,0:15:35.70,Default,,0,0,0,,Nii…san?
Dialogue: 0,0:15:35.70,0:15:45.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:45.34,0:15:47.38,Default,,0,0,0,,Касума мырза!
Dialogue: 0,0:15:47.38,0:15:54.38,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:58.25,0:16:00.25,Default,,0,0,0,,(Дабыл сигналы)
Dialogue: 0,0:16:00.25,0:16:03.61,Default,,0,0,0,,Реликсте бос энергияның ультра жоғары концентрациясы расталды!
Dialogue: 0,0:16:03.61,0:16:06.93,Default,,0,0,0,,Гравитация өрісі құрылды! Массалық өсу!
Dialogue: 0,0:16:06.93,0:16:09.28,Default,,0,0,0,,≪Бұл тоқтамайды! (Дабыл сигналы)
Dialogue: 0,0:16:09.28,0:16:11.95,Default,,0,0,0,,Бұл... жаман.
Dialogue: 0,0:16:11.95,0:16:18.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:18.92,0:16:21.28,Default,,0,0,0,,ｸﾘｽ？
Dialogue: 0,0:16:21.28,0:16:24.63,Default,,0,0,0,,Қаздар жеңілгеннен кейін құлаған Реликске➡
Dialogue: 0,0:16:24.63,0:16:27.68,Default,,0,0,0,,Өте үлкен гравитациялық өріс пайда болады
Dialogue: 0,0:16:27.68,0:16:29.70,Default,,0,0,0,,[ТЕЛ] (Ибуки) Сіз нені айтып тұрсыз?
Dialogue: 0,0:16:29.70,0:16:32.62,Default,,0,0,0,,Бұл дүниеге құйылған энергия➡
Dialogue: 0,0:16:32.62,0:16:35.97,Default,,0,0,0,,Айналаңыздағы барлық кеңістікті бақылауды жоғалтыңыз➡
Dialogue: 0,0:16:35.97,0:16:38.04,Default,,0,0,0,,Мен жұта бастадым.
Dialogue: 0,0:16:38.04,0:16:41.28,Default,,0,0,0,,Осылай жалғаса берсе, біздің әлем де сорылады➡
Dialogue: 0,0:16:41.28,0:16:43.26,Default,,0,0,0,,жоғалады
Dialogue: 0,0:16:43.26,0:16:48.56,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:33.59,0:18:35.63,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:18:35.63,0:18:38.30,Default,,0,0,0,,Кроно мен оның достары Қазды жеңді, солай ма?
Dialogue: 0,0:18:38.30,0:18:42.62,Default,,0,0,0,,Қаздар мен Мәсіх Жоқтық пен жаратылыстың арасындағы шайқастың өзі ➡
Dialogue: 0,0:18:42.62,0:18:47.27,Default,,0,0,0,,Шайқас Авангард шайқасы арқылы шешілді. Бірақ...
Dialogue: 0,0:18:47.27,0:18:49.61,Default,,0,0,0,,Реликс➡ деп аталатын сына ретінде
Dialogue: 0,0:18:49.61,0:18:53.66,Default,,0,0,0,,Бұл әлемге бос энергияның үлкен мөлшері құйылды➡
Dialogue: 0,0:18:53.66,0:18:56.70,Default,,0,0,0,,Оның күйреу энергиясы➡
Dialogue: 0,0:18:56.70,0:18:59.27,Default,,0,0,0,,Айналадағы кеңістік оны көтере алмайды.
Dialogue: 0,0:18:59.27,0:19:03.92,Default,,0,0,0,,≪Толық күйреуге дейінгі есептік уақыт шамамен 500 секунд!
Dialogue: 0,0:19:03.92,0:19:09.59,Default,,0,0,0,,Біздің әлем ғана емес, сонымен бірге тағдыры бір жалғанған Крей планетасы➡
Dialogue: 0,0:19:09.59,0:19:11.60,Default,,0,0,0,,Осы жылдамдықпен➡
Dialogue: 0,0:19:11.60,0:19:14.58,Default,,0,0,0,,Құлаған кеңістікке жұтылып, бәрі жоғалады...
Dialogue: 0,0:19:14.58,0:19:17.27,Default,,0,0,0,,Бұл... бұл дұрыс емес!
Dialogue: 0,0:19:17.27,0:19:21.27,Default,,0,0,0,,Біз жеңсек те, бәрі бітті ме?
Dialogue: 0,0:19:21.27,0:19:23.67,Default,,0,0,0,,Жоқ... әлі жоқ!
Dialogue: 0,0:19:23.67,0:19:32.67,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:41.59,0:19:43.96,Default,,0,0,0,,Бұл шынымен де соңғы рет
Dialogue: 0,0:19:43.96,0:19:47.03,Default,,0,0,0,,Мені және сені байланыстырған байланыс жолы➡
Dialogue: 0,0:19:47.03,0:19:51.73,Default,,0,0,0,,Шектеу және екі дүниені тікелей байланыстыру
Dialogue: 0,0:19:54.26,0:19:57.93,Default,,0,0,0,,Кеттік! Бұл нағыз соңғы жекпе-жек!
Dialogue: 0,0:19:57.93,0:20:08.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:08.92,0:20:13.27,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:20:13.27,0:20:16.66,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:16.66,0:20:19.26,Default,,0,0,0,,Генерация аймағы шығарылды!
Dialogue: 0,0:20:19.26,0:20:29.32,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:29.32,0:20:34.26,Default,,0,0,0,,Қазір бізге шынымен қалайтын әлемді көрсететін уақыт!
Dialogue: 0,0:20:34.26,0:20:38.93,Default,,0,0,0,,ﾃﾞｨﾒﾝｼｮﾅﾙｵｰﾊﾞｰｽﾄﾗｲﾄﾞ！
Dialogue: 0,0:20:38.93,0:21:06.96,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:06.96,0:21:09.93,Default,,0,0,0,,SS деңгейінде уақыт-кеңістік бұрмалануы орын алады!
Dialogue: 0,0:21:09.93,0:21:12.62,Default,,0,0,0,,Үш өте жоғары тазалық қадам күші!
Dialogue: 0,0:21:12.62,0:21:15.62,Default,,0,0,0,,Гравитациялық өрістің центріне қарай жүріңіз!
Dialogue: 0,0:21:18.02,0:21:20.02,Default,,0,0,0,,Үш-үш...
Dialogue: 0,0:21:22.26,0:21:24.28,Default,,0,0,0,,Мен оны сезінемін. Ах...
Dialogue: 0,0:21:24.28,0:21:26.95,Default,,0,0,0,,Реликтерде қалған жоқтың күші➡
Dialogue: 0,0:21:26.95,0:21:30.94,Default,,0,0,0,,Бүкіл қоршаған кеңістік сол бір нүктеге жақындайды.
Dialogue: 0,0:21:30.94,0:21:34.37,Default,,0,0,0,,Бұған дейін ол бізге сеніп тапсырылған➡
Dialogue: 0,0:21:34.37,0:21:36.61,Default,,0,0,0,,Мәсіхтің күшімен!
Dialogue: 0,0:21:36.61,0:21:39.96,Default,,0,0,0,,Бәрін құртып жіберсең жақсы!
Dialogue: 0,0:21:39.96,0:22:06.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:06.34,0:22:09.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:09.24,0:22:11.24,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:22:11.24,0:22:13.59,Default,,0,0,0,,Аа, осыншама...
Dialogue: 0,0:22:13.59,0:22:15.95,Default,,0,0,0,,Бірден барайық!
Dialogue: 0,0:22:15.95,0:22:19.60,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:19.60,0:22:21.79,Default,,0,0,0,,О!
Dialogue: 0,0:22:21.79,0:22:35.32,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:35.32,0:22:37.32,Default,,0,0,0,,Бұл күйреу орталығы!
Dialogue: 0,0:22:39.39,0:22:42.39,Default,,0,0,0,,Бізге сеніп тапсырылған барлық ойлармен!
Dialogue: 0,0:22:44.26,0:22:47.56,Default,,0,0,0,,Мен саған біздің болашағымызды бұзуға жол бермеймін!
Dialogue: 0,0:22:49.93,0:22:52.93,Default,,0,0,0,,Болашақты жаса!
Dialogue: 0,0:22:52.93,0:22:57.60,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:57.60,0:23:01.60,Default,,0,0,0,,Иә!!
Dialogue: 0,0:23:09.60,0:23:12.60,Default,,0,0,0,,((Бұл аяқталғаннан кейін кеңістік-уақыттың барлық жолдары ➡ болады)
Dialogue: 0,0:23:12.60,0:23:14.96,Default,,0,0,0,,толығымен жойылады
Dialogue: 0,0:23:14.96,0:23:22.36,Default,,0,0,0,,Туған жер, Стридегеттің тыртықтары және сіз бен менің ерекшелігіміз
Dialogue: 0,0:23:22.36,0:23:26.28,Default,,0,0,0,,Бастапқыда менің күшім жоқ еді.
Dialogue: 0,0:23:26.28,0:23:30.58,Default,,0,0,0,,Ол жай ғана Авангард жауынгері, ол барлық жерде...))
Dialogue: 0,0:23:42.43,0:23:46.92,Default,,0,0,0,,Реликтерде барлық құрылымдардың жоғалуын растаңыз
Dialogue: 0,0:23:46.92,0:23:50.29,Default,,0,0,0,,Кеңістік-уақыт бұрмалануы Қалдық жоқ
Dialogue: 0,0:23:50.29,0:23:53.63,Default,,0,0,0,,Гравитация деңгейі Барлық қалыпты мәндер
Dialogue: 0,0:23:53.63,0:23:55.70,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:23:55.70,0:24:04.59,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:04.59,0:24:07.29,Default,,0,0,0,,Олар мұны істеді.
Dialogue: 0,0:24:09.26,0:24:11.28,Default,,0,0,0,,Иә
Dialogue: 0,0:24:11.28,0:24:14.26,Default,,0,0,0,,Бүгін Тек осы күні көрінеді ➡
Dialogue: 0,0:24:14.26,0:24:16.27,Default,,0,0,0,,Метеорлық жауын...
Dialogue: 0,0:24:16.27,0:24:19.92,Default,,0,0,0,,Енді кез келген тілек орындалатын сияқты.
Dialogue: 0,0:24:19.92,0:24:21.94,Default,,0,0,0,,Жүрекке...
Dialogue: 0,0:24:21.94,0:24:24.34,Default,,0,0,0,,ｷﾀｰ！
Dialogue: 0,0:24:26.31,0:24:34.60,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:34.60,0:24:36.90,Default,,0,0,0,,ｸﾛﾉ～！
Dialogue: 0,0:24:39.02,0:24:43.61,Default,,0,0,0,,Рахмет Шион Токоха Куроно!
Dialogue: 0,0:24:43.61,0:24:47.26,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:24:47.26,0:24:50.70,Default,,0,0,0,,ｸﾛﾉ！
Dialogue: 0,0:24:50.70,0:24:53.94,Default,,0,0,0,,Біз бейнеде әрқашан біргеміз!
Dialogue: 0,0:24:53.94,0:25:13.59,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:13.59,0:25:15.59,Default,,0,0,0,,Бітті.
Dialogue: 0,0:25:15.59,0:25:17.89,Default,,0,0,0,,Жоқ, бұл тек бастамасы.
Dialogue: 0,0:25:19.93,0:25:25.32,Default,,0,0,0,,Кибаның атын әлемге танытайық. Әрине, мен де жеке.
Dialogue: 0,0:25:25.32,0:25:29.92,Default,,0,0,0,,Авангард семсерлесу... Барлығына өз атымды ойып жазамын
Dialogue: 0,0:25:29.92,0:25:31.93,Default,,0,0,0,,шықты
Dialogue: 0,0:25:31.93,0:25:34.26,Default,,0,0,0,,Сіз елеулі іспен айналысатын сияқтысыз.
Dialogue: 0,0:25:34.26,0:25:36.25,Default,,0,0,0,,Өйткені біз де жеңілмейміз
Dialogue: 0,0:25:36.25,0:25:39.27,Default,,0,0,0,,Еуро лигадан бастаңыз➡
Dialogue: 0,0:25:39.27,0:25:42.64,Default,,0,0,0,,Мен жоғары орынды алып, жеңіспен ораламын!
Dialogue: 0,0:25:42.64,0:25:44.66,Default,,0,0,0,,Бұл кенеттен еуро ма?
Dialogue: 0,0:25:44.66,0:25:46.69,Default,,0,0,0,,Тек өте күшті жаулар бар.
Dialogue: 0,0:25:46.69,0:25:49.28,Default,,0,0,0,,Өйткені ұрғанда өсетін түрі.
Dialogue: 0,0:25:49.28,0:25:51.28,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:25:51.28,0:25:54.92,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:25:54.92,0:25:57.35,Default,,0,0,0,,Куроно барады, солай ма?
Dialogue: 0,0:25:57.35,0:25:59.35,Default,,0,0,0,,Ах
Dialogue: 0,0:26:01.27,0:26:05.28,Default,,0,0,0,,Өз күшіммен, өз аяғыммен➡
Dialogue: 0,0:26:05.28,0:26:08.28,Default,,0,0,0,,Мен оларды қайтадан көремін!
Dialogue: 0,0:26:12.92,0:26:15.59,Default,,0,0,0,,Әйтеуір, қазір үйге қайтайық.
Dialogue: 0,0:26:15.59,0:26:17.59,Default,,0,0,0,,Біздің әлемге
Dialogue: 0,0:26:17.59,0:26:20.27,Default,,0,0,0,,Мәсіхтің қорғанысы жойылмай тұрып.
Dialogue: 0,0:26:20.27,0:26:22.26,Default,,0,0,0,,Ах
Dialogue: 0,0:26:22.26,0:26:24.26,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:30:36.28,0:30:40.78,Default,,0,0,0,,Біз мұны істедік пе?
Dialogue: 0,0:30:40.78,0:30:43.27,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:30:43.27,0:30:46.29,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:30:46.29,0:30:49.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:49.29,0:30:54.29,Default,,0,0,0,,Ия, иә, иә!
Dialogue: 0,0:30:55.79,0:31:01.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory