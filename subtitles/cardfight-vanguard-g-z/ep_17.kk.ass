Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:06.70,0:01:09.94,Default,,0,0,0,,Мен сенің Валеосты жеңгеніңді естідім.
Dialogue: 0,0:01:09.94,0:01:13.32,Default,,0,0,0,,Ах, мен Мегаланиканың нөлдік айдаһарын алдым.
Dialogue: 0,0:01:13.32,0:01:15.34,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:01:15.34,0:01:18.44,Default,,0,0,0,,Біз де қазір бұл туралы бірдеңе істеуіміз керек.
Dialogue: 0,0:01:18.44,0:01:25.60,Default,,0,0,0,,Ғажайып күштері бар басқа әлемнен жауынгерлер шыққан өлке...?
Dialogue: 0,0:01:25.60,0:01:29.94,Default,,0,0,0,,((Егер ол жаққа барсаңыз, G-Zone-ді қайтара аласыз.
Dialogue: 0,0:01:29.94,0:01:32.59,Default,,0,0,0,,[TEL] (Ибуки) Дұрыс, орын арқылы➡
Dialogue: 0,0:01:32.59,0:01:35.96,Default,,0,0,0,,Егер мен Куроно Доранмен байланысқа түссем.
Dialogue: 0,0:01:35.96,0:01:38.00,Default,,0,0,0,,Тацунаги➡ бойынша
Dialogue: 0,0:01:38.00,0:01:41.08,Default,,0,0,0,,Болашақ мүмкіндіктерді қалай түсінуге болады➡
Dialogue: 0,0:01:41.08,0:01:45.10,Default,,0,0,0,,Маған Gear Chronic көмегі керек))
Dialogue: 0,0:01:45.10,0:01:47.16,Default,,0,0,0,,Қаздарды жеңу үшін➡
Dialogue: 0,0:01:47.16,0:01:51.43,Default,,0,0,0,,G-аймағын және менің болашақ мүмкіндіктерімді қалпына келтіру
Dialogue: 0,0:01:51.43,0:01:53.63,Default,,0,0,0,,Мұнда
Dialogue: 0,0:05:04.60,0:05:06.94,Default,,0,0,0,,Рас! Фидес қайта жанданған кезде ➡
Dialogue: 0,0:05:06.94,0:05:08.99,Default,,0,0,0,,Шионның батыл келбеті!
Dialogue: 0,0:05:08.99,0:05:11.59,Default,,0,0,0,,Әсер Толқу Жаңбыр!
Dialogue: 0,0:05:11.59,0:05:14.76,Default,,0,0,0,,Мен сізге көрсеткім келді!
Dialogue: 0,0:05:14.76,0:05:16.77,Default,,0,0,0,,Қазірге рахмет➡
Dialogue: 0,0:05:16.77,0:05:19.67,Default,,0,0,0,,Бұдан жаман ештеңе болған жоқ.
Dialogue: 0,0:05:21.64,0:05:23.94,Default,,0,0,0,,Қаздар қайта жанданғандықтан➡
Dialogue: 0,0:05:23.94,0:05:26.93,Default,,0,0,0,,Бірдеңе болғанша уақыт мәселесі.
Dialogue: 0,0:05:26.93,0:05:30.91,Default,,0,0,0,,Мен Мегидтің картасын нұсқау бойынша Солтүстік Америка филиалына жеткіздім.
Dialogue: 0,0:05:30.91,0:05:32.93,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:05:32.93,0:05:36.75,Default,,0,0,0,,Ондағы жабдық кеңейтім қауымдастығына тиесілі болса да➡
Dialogue: 0,0:05:36.75,0:05:38.92,Default,,0,0,0,,Жоғары санатқа ие
Dialogue: 0,0:05:38.92,0:05:41.77,Default,,0,0,0,,Ең мықты құрам сонда құрылды.
Dialogue: 0,0:05:41.77,0:05:47.93,Default,,0,0,0,,Елшілерді алып, шайқаста жеңіске жетіп, оларды Клэй планетасына қайтарыңыз.
Dialogue: 0,0:05:47.93,0:05:53.13,Default,,0,0,0,,Енді олардың жемді алуын күту керек.
Dialogue: 0,0:06:05.58,0:06:07.63,Default,,0,0,0,,Бұл шыққан жер ме?
Dialogue: 0,0:06:07.63,0:06:10.44,Default,,0,0,0,,Осы жерде нұсқаулықты күтіңіз.
Dialogue: 0,0:06:10.44,0:06:12.44,Default,,0,0,0,,<<Сізді осында көргеніме қуаныштымын.
Dialogue: 0,0:06:30.61,0:06:32.61,Default,,0,0,0,,ﾌｯ…
Dialogue: 0,0:06:34.59,0:06:37.65,Default,,0,0,0,,Куроно мен ағамның уақыты келді деп ойлаймын
Dialogue: 0,0:06:37.65,0:06:42.08,Default,,0,0,0,,Қолыңнан келгенін істе, жақсы емес әке
Dialogue: 0,0:06:42.08,0:06:46.46,Default,,0,0,0,,Мұнда шамамен 15 ғасырда обсерватория салынды➡
Dialogue: 0,0:06:46.46,0:06:49.59,Default,,0,0,0,,Жұлдыздардың қозғалысын бақылаған
Dialogue: 0,0:06:49.59,0:06:51.59,Default,,0,0,0,,15 ғасыр
Dialogue: 0,0:06:51.59,0:06:54.10,Default,,0,0,0,,Дөрекі сөзбен айтқанда, бұл Муромачи кезеңі.
Dialogue: 0,0:06:54.10,0:06:56.58,Default,,0,0,0,,Ибуки бұрын осында болатын➡
Dialogue: 0,0:06:56.58,0:07:00.14,Default,,0,0,0,,Белгілі бір қираған туралы аңызды естіді.
Dialogue: 0,0:07:00.14,0:07:04.76,Default,,0,0,0,,Бір түнде аспан бұрмаланып, жеті түске бөленді➡
Dialogue: 0,0:07:04.76,0:07:07.41,Default,,0,0,0,,Асыл рыцарь түседі➡
Dialogue: 0,0:07:07.41,0:07:11.78,Default,,0,0,0,,Ол алты зұлым айдаһарды жою үшін сапарға шыққанын айтты.
Dialogue: 0,0:07:11.78,0:07:13.93,Default,,0,0,0,,Яғни...
Dialogue: 0,0:07:13.93,0:07:17.94,Default,,0,0,0,,Ах, менің ойымша, бұл Қылыш Сент-Фидес➡ туралы
Dialogue: 0,0:07:17.94,0:07:21.59,Default,,0,0,0,,Осы оқиғадан кейін Ибуки де осыны ойлап тапқан сияқты.
Dialogue: 0,0:07:21.59,0:07:26.00,Default,,0,0,0,,Олар маған қарап шығуымды өтінді.
Dialogue: 0,0:07:26.00,0:07:31.58,Default,,0,0,0,,Мен де Тацунагидің ақпаратымен салыстырдым, бірақ бұл хит болған сияқты.
Dialogue: 0,0:07:31.58,0:07:37.26,Default,,0,0,0,,Қылыш Әулие Фидес бұл жерге Мәсіхтің батасын алып келді.
Dialogue: 0,0:07:37.26,0:07:41.44,Default,,0,0,0,,Мен Zero Dragon картасын әртүрлі жерлерде жаптым!
Dialogue: 0,0:07:41.44,0:07:45.60,Default,,0,0,0,,Біз бәрін мөрлеп, Қиыр Шығысқа жеттік➡
Dialogue: 0,0:07:45.60,0:07:49.60,Default,,0,0,0,,Оның қуаты таусылған шығар, оны Қибаның ата-бабалары құтқарған.
Dialogue: 0,0:07:53.26,0:07:56.26,Default,,0,0,0,,Тағы біраз, бірақ шаршадыңыз ба?
Dialogue: 0,0:07:56.26,0:07:58.93,Default,,0,0,0,,А, жоқ, жақсы...
Dialogue: 0,0:07:58.93,0:08:00.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:00.93,0:08:03.42,Default,,0,0,0,,Мен ұшақта барлық уақытта ұйықтадым, сондықтан олай емес...
Dialogue: 0,0:08:03.42,0:08:05.42,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:21.23,0:08:24.44,Default,,0,0,0,,Уау! Бұл керемет!
Dialogue: 0,0:08:24.44,0:08:26.59,Default,,0,0,0,,Бұл табиғи собор сияқты.
Dialogue: 0,0:08:26.59,0:08:28.59,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:08:32.24,0:08:34.93,Default,,0,0,0,,Авангард шеңбері? Бұл дұрыс
Dialogue: 0,0:08:34.93,0:08:37.60,Default,,0,0,0,,Міне, Фидес келгенде уақыт пен кеңістіктің байланысы ➡
Dialogue: 0,0:08:37.60,0:08:39.60,Default,,0,0,0,,Кішкене болса да➡
Dialogue: 0,0:08:39.60,0:08:43.60,Default,,0,0,0,,Біздің дауысымыз Крей планетасына жетуі мүмкін.
Dialogue: 0,0:08:46.59,0:08:48.61,Default,,0,0,0,,Мен сізге жол көрсетемін
Dialogue: 0,0:08:48.61,0:08:51.91,Default,,0,0,0,,Сіз өзіңізді қатты бейнелеуіңіз керек. Мен түссіндім.
Dialogue: 0,0:09:06.93,0:09:08.91,Default,,0,0,0,,Доран, ол қайда!
Dialogue: 0,0:09:08.91,0:09:10.93,Default,,0,0,0,,Жауап беріңіз!
Dialogue: 0,0:09:10.93,0:09:14.59,Default,,0,0,0,,Сіз мені естімейсіз бе? менің дауысым
Dialogue: 0,0:09:14.59,0:09:16.94,Default,,0,0,0,,Маған жауап беріңізші!
Dialogue: 0,0:09:16.94,0:09:19.43,Default,,0,0,0,,ﾄﾞﾗﾝ！
Dialogue: 0,0:09:19.43,0:09:23.26,Default,,0,0,0,,Уф...｡ Жақсы емес.
Dialogue: 0,0:09:23.26,0:09:28.92,Default,,0,0,0,,Дүрбелеңге салынбаңыз, сіздің бірліктермен байланысыңызды реликтер бұзады➡
Dialogue: 0,0:09:28.92,0:09:31.27,Default,,0,0,0,,G аймағы да жоғалды.
Dialogue: 0,0:09:31.27,0:09:34.44,Default,,0,0,0,,Бұл оңай болмайды.
Dialogue: 0,0:09:34.44,0:09:36.61,Default,,0,0,0,,Түнде қайталап көрейік
Dialogue: 0,0:09:36.61,0:09:38.61,Default,,0,0,0,,Оның алдында тамақ ішейік.
Dialogue: 0,0:09:42.46,0:09:44.52,Default,,0,0,0,,Дайын бол
Dialogue: 0,0:09:44.52,0:09:47.52,Default,,0,0,0,,Балалар сендер демалуларың керек. Иә.
Dialogue: 0,0:09:49.59,0:09:51.59,Default,,0,0,0,,ｸｿ！
Dialogue: 0,0:09:51.59,0:09:54.14,Default,,0,0,0,,Мен мұны істеп жатқанда, Касума!
Dialogue: 0,0:09:54.14,0:09:58.25,Default,,0,0,0,,Сенің көңіл-күйіңді түсінемін, бірақ сәл тынышталу керек.
Dialogue: 0,0:09:58.25,0:10:00.60,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:10:00.60,0:10:05.59,Default,,0,0,0,,Әкеңмен неге біраз уақыт сөйлеспейсің?
Dialogue: 0,0:10:05.59,0:10:08.01,Default,,0,0,0,,Мен мұнда ол үшін келген жоқпын.
Dialogue: 0,0:10:08.01,0:10:11.26,Default,,0,0,0,,Бізбен бірге болыңыз!
Dialogue: 0,0:10:11.26,0:10:14.43,Default,,0,0,0,,Отбасымен тіл табыса алмайтындар үшін➡
Dialogue: 0,0:10:14.43,0:10:18.45,Default,,0,0,0,,Мен құрылғымен қайта қосыла алмаймын деп ойлаймын?
Dialogue: 0,0:10:18.45,0:10:24.61,Default,,0,0,0,,Өйткені мен қазір не айтарымды білмеймін...
Dialogue: 0,0:10:24.61,0:10:27.28,Default,,0,0,0,,Өзіңізді сөйлеуге мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:10:27.28,0:10:31.28,Default,,0,0,0,,Дұрыс, мұндай кездер болады емес пе?
Dialogue: 0,0:10:36.27,0:10:38.77,Default,,0,0,0,,Не болды? Хмм...
Dialogue: 0,0:10:43.41,0:10:45.81,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:10:45.81,0:10:48.35,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:10:48.35,0:11:05.25,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:05.25,0:11:07.27,Default,,0,0,0,,((Уау~
Dialogue: 0,0:11:07.27,0:11:10.94,Default,,0,0,0,,Әке, сен әлемдегі ең мықтысың, солай ма? ))
Dialogue: 0,0:11:10.94,0:11:13.74,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:19.58,0:11:22.08,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:11:22.08,0:11:24.08,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:11:24.08,0:11:26.10,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ｡ ｽﾀﾝﾄﾞｱｯﾌﾟ
Dialogue: 0,0:11:26.10,0:11:28.27,Default,,0,0,0,,ｳﾞｧﾝｶﾞｰﾄﾞ！ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:11:28.27,0:11:30.26,Default,,0,0,0,,Бұл туралы не деуге болады! (Тікелей эфир) Мен бұған жол бермеймін!
Dialogue: 0,0:11:30.26,0:11:33.94,Default,,0,0,0,,Жарайды, Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:11:33.94,0:11:35.93,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:11:35.93,0:11:38.80,Default,,0,0,0,,Жарайды, мен осы дискіні тексеру арқылы шешемін!
Dialogue: 0,0:11:38.80,0:11:41.83,Default,,0,0,0,,Тәтті! Ой, келесің бе?
Dialogue: 0,0:11:41.83,0:11:44.42,Default,,0,0,0,,Өйткені сен өте қамқорсың.
Dialogue: 0,0:11:44.42,0:11:47.09,Default,,0,0,0,,Мен аңқау болдым деп ойлаймын. Жақсы.
Dialogue: 0,0:11:47.09,0:11:50.09,Default,,0,0,0,,Бірақ біз осы уақытқа дейін жеттік➡
Dialogue: 0,0:11:50.09,0:11:52.78,Default,,0,0,0,,Сізге көмектескіңіз келмейді ме?
Dialogue: 0,0:11:52.78,0:11:55.18,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:59.75,0:12:02.69,Default,,0,0,0,,Дайынсың ба? Ах
Dialogue: 0,0:12:02.69,0:12:04.76,Default,,0,0,0,,Жарайды, бастайық.
Dialogue: 0,0:12:04.76,0:12:06.93,Default,,0,0,0,,Біз де көмектесе аламыз
Dialogue: 0,0:12:06.93,0:12:09.91,Default,,0,0,0,,Крей планетасымен байланыс мүмкіндігінше күшті болу үшін➡
Dialogue: 0,0:12:09.91,0:12:11.91,Default,,0,0,0,,Біз де бейнелейміз
Dialogue: 0,0:12:11.91,0:12:14.93,Default,,0,0,0,,Доранмен кездесу үшін.
Dialogue: 0,0:12:14.93,0:12:17.60,Default,,0,0,0,,Ой... Байқап көруге тұрарлық.
Dialogue: 0,0:12:17.60,0:12:20.96,Default,,0,0,0,,Екеуіңіз де өтінемін. (2 адам) Иә!
Dialogue: 0,0:12:20.96,0:12:25.24,Default,,0,0,0,,Оны елестетіңіз, ойыңызға елестетіңіз.
Dialogue: 0,0:12:25.24,0:12:27.93,Default,,0,0,0,,Екі дүниенің арасында туннель жасалады➡
Dialogue: 0,0:12:27.93,0:12:32.10,Default,,0,0,0,,Сіз бөлімшемен кездесу үшін сол жерден өтесіз.
Dialogue: 0,0:12:32.10,0:12:34.75,Default,,0,0,0,,Бұл ұзын, ұзын туннель.
Dialogue: 0,0:12:34.75,0:12:39.94,Default,,0,0,0,,《Токоха: Өтінемін, егер біздің дауысымызды естісеңіз, жауап беріңізші.》
Dialogue: 0,0:12:39.94,0:12:43.91,Default,,0,0,0,,《Шион: Крей планетасы және біздің әлем үшін》
Dialogue: 0,0:12:43.91,0:12:48.43,Default,,0,0,0,,《Мен саған және маған болашақты қайтарғым келеді, Доран! 》
Dialogue: 0,0:12:48.43,0:13:05.60,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:05.60,0:13:07.62,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:13:07.62,0:13:09.92,Default,,0,0,0,,Не!? Бұл!
Dialogue: 0,0:14:53.93,0:14:57.80,Default,,0,0,0,,Бұл қай жер? Доран осылай келді.
Dialogue: 0,0:14:57.80,0:15:00.58,Default,,0,0,0,,Олай болса, осы жолмен жүрсек, Доранмен кездесе аламыз ба?
Dialogue: 0,0:15:00.58,0:15:02.58,Default,,0,0,0,,Ах. Бірақ әлі емес➡
Dialogue: 0,0:15:02.58,0:15:04.59,Default,,0,0,0,,Біз Крей планетасына жеткен жоқпыз.
Dialogue: 0,0:15:04.59,0:15:06.59,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:15:06.59,0:15:08.97,Default,,0,0,0,,Бұл жерден қайда баруым керек?
Dialogue: 0,0:15:08.97,0:15:12.59,Default,,0,0,0,,Сол кезде мен жоғалған дронды шақырдым➡
Dialogue: 0,0:15:12.59,0:15:14.75,Default,,0,0,0,,Мен сені біздің әлемге апардым, бірақ
Dialogue: 0,0:15:14.75,0:15:16.92,Default,,0,0,0,,Енді ол жаққа өзіңіз барыңыз➡
Dialogue: 0,0:15:16.92,0:15:19.25,Default,,0,0,0,,Мен сонда жетуім керек.
Dialogue: 0,0:15:19.25,0:15:21.42,Default,,0,0,0,,Онда тек алға жылжымайсың ба?
Dialogue: 0,0:15:21.42,0:15:23.59,Default,,0,0,0,,Иә! О!
Dialogue: 0,0:15:23.59,0:15:26.93,Default,,0,0,0,,Уау! Эй, сен не істеп жатырсың!
Dialogue: 0,0:15:26.93,0:15:29.26,Default,,0,0,0,,Не болып жатыр? бұл!
Dialogue: 0,0:15:29.26,0:15:31.60,Default,,0,0,0,,Мені ұзақ қалдырмаңыз
Dialogue: 0,0:15:31.60,0:15:34.42,Default,,0,0,0,,Бұл дүниенің үсті мен асты жоқ па?
Dialogue: 0,0:15:34.42,0:15:36.59,Default,,0,0,0,,Кем дегенде еден бар.
Dialogue: 0,0:15:36.59,0:15:38.57,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:38.57,0:15:40.57,Default,,0,0,0,,А? О!
Dialogue: 0,0:15:40.57,0:15:42.57,Default,,0,0,0,,Уау! Болды! сурет?
Dialogue: 0,0:15:42.57,0:15:45.26,Default,,0,0,0,,Иә!? Бұл...
Dialogue: 0,0:15:45.26,0:15:49.75,Default,,0,0,0,,Бұл дүниені елестетсең, бәрін де істей алатын дүние сияқты.
Dialogue: 0,0:15:49.75,0:15:52.67,Default,,0,0,0,,Менің басымда солай ойладым➡
Dialogue: 0,0:15:52.67,0:15:55.92,Default,,0,0,0,,Бұл бәрі пішінде пайда болады дегенді білдіре ме? Ах
Dialogue: 0,0:15:55.92,0:15:59.58,Default,,0,0,0,,Екеуіңіз кездейсоқ біртүрлі нәрсе ойлап қалмаңыздар.
Dialogue: 0,0:15:59.58,0:16:01.93,Default,,0,0,0,,Олай десеңіз де, бұл мен ➡
Dialogue: 0,0:16:01.93,0:16:06.60,Default,,0,0,0,,Мен мұнда бірдеңе шығады деп ойладым...
Dialogue: 0,0:16:06.60,0:16:08.58,Default,,0,0,0,,ﾒｰｶﾞﾒｶﾞ
Dialogue: 0,0:16:08.58,0:16:11.10,Default,,0,0,0,,ﾒｶﾞﾒｶﾞ ﾒｶﾞﾒｶﾞ ﾒｶﾞ
Dialogue: 0,0:16:11.10,0:16:13.09,Default,,0,0,0,,ﾒｶﾞ！
Dialogue: 0,0:16:13.09,0:16:15.12,Default,,0,0,0,,Күте тұрыңыз, бұл неге?
Dialogue: 0,0:16:15.12,0:16:17.14,Default,,0,0,0,,Бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:16:17.14,0:16:19.16,Default,,0,0,0,,Өйткені ол менің басыма түсіп кетті
Dialogue: 0,0:16:19.16,0:16:21.26,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:16:21.26,0:16:23.27,Default,,0,0,0,,ﾒｶﾞｺﾛ！
Dialogue: 0,0:16:23.27,0:16:25.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:25.28,0:16:27.48,Default,,0,0,0,,ﾏｼﾞ？
Dialogue: 0,0:16:29.42,0:16:31.42,Default,,0,0,0,,ﾒｶﾞ！
Dialogue: 0,0:16:31.42,0:16:33.43,Default,,0,0,0,,Кя! Апыр-ай!
Dialogue: 0,0:16:33.43,0:16:35.44,Default,,0,0,0,,Түсіндім! Эй!
Dialogue: 0,0:16:35.44,0:16:38.26,Default,,0,0,0,,Не істеп жатырсың, Шион!
Dialogue: 0,0:16:38.26,0:16:40.76,Default,,0,0,0,,Маған күш бер!
Dialogue: 0,0:16:43.64,0:16:45.64,Default,,0,0,0,,О!
Dialogue: 0,0:16:49.09,0:16:51.94,Default,,0,0,0,,О! Алақай!
Dialogue: 0,0:16:51.94,0:16:55.96,Default,,0,0,0,,Түсінемін, егер сіз оны бейнелесеңіз, бәрі де болады... Қызық!
Dialogue: 0,0:16:55.96,0:16:57.96,Default,,0,0,0,,Мен де істеймін!
Dialogue: 0,0:17:00.04,0:17:02.75,Default,,0,0,0,,Кеттік! Мега!
Dialogue: 0,0:17:02.75,0:17:05.77,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:17:05.77,0:17:08.68,Default,,0,0,0,,ﾆｰ！
Dialogue: 0,0:17:08.68,0:17:11.18,Default,,0,0,0,,Досукой!
Dialogue: 0,0:17:16.59,0:17:19.76,Default,,0,0,0,,Хехехе. Сіз жасадыңыз.
Dialogue: 0,0:17:19.76,0:17:22.24,Default,,0,0,0,,Бұл ойнайтын уақыт емес.
Dialogue: 0,0:17:22.24,0:17:24.28,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:24.28,0:17:28.78,Default,,0,0,0,,Бірақ сіздің арқаңызда мен енді не істеу керектігін білемін.
Dialogue: 0,0:17:28.78,0:17:58.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:00.61,0:18:02.66,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:18:02.66,0:18:04.76,Default,,0,0,0,,Крей планетасы?
Dialogue: 0,0:18:13.08,0:18:15.76,Default,,0,0,0,,ﾄﾞﾗﾝ！
Dialogue: 0,0:18:15.76,0:18:18.60,Default,,0,0,0,,ﾄﾞﾗﾝ！ (ｸﾛﾉ･ﾄﾞﾗﾝ･Ｇ)ｸﾛﾉ！
Dialogue: 0,0:18:18.60,0:18:21.42,Default,,0,0,0,,ﾄﾞﾗｰﾝ！
Dialogue: 0,0:18:21.42,0:18:23.42,Default,,0,0,0,,ｸﾛﾉ！
Dialogue: 0,0:18:23.42,0:18:26.92,Default,,0,0,0,,ﾄﾞﾗﾝ！ ｸﾛﾉ！
Dialogue: 0,0:18:26.92,0:18:28.92,Default,,0,0,0,,Біз ақыры кездестік
Dialogue: 0,0:18:28.92,0:18:30.93,Default,,0,0,0,,Мен сені міндетті түрде келеді деп ойладым.
Dialogue: 0,0:18:30.93,0:18:32.93,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:18:32.93,0:18:36.42,Default,,0,0,0,,Маған әкем және мына балалар көмектесті.
Dialogue: 0,0:18:36.42,0:18:39.58,Default,,0,0,0,,Сәлеметсіз бе. Екеуіңізге рахмет.
Dialogue: 0,0:18:39.58,0:18:41.60,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:18:41.60,0:18:44.09,Default,,0,0,0,,Енді үшеуің осылай біргесіңдер➡
Dialogue: 0,0:18:44.09,0:18:47.59,Default,,0,0,0,,Бізді және сізді байланыстыратын байланыс екеніне сенімдімін➡
Dialogue: 0,0:18:47.59,0:18:51.61,Default,,0,0,0,,Бұл екі дүниенің арасында ағып жатқан тағдыр құдіретінің нұсқауы.
Dialogue: 0,0:18:51.61,0:18:54.91,Default,,0,0,0,,Тағдыр құдіреті? Иә
Dialogue: 0,0:18:57.19,0:19:00.61,Default,,0,0,0,,Крей планетасының жағдайы қандай?
Dialogue: 0,0:19:00.61,0:19:05.76,Default,,0,0,0,,Қазірдің өзінде әртүрлі жерлерде қаздар әскерімен кескілескен шайқастар жүріп жатыр.
Dialogue: 0,0:19:05.76,0:19:10.25,Default,,0,0,0,,Жаратылыстың Амалудасымен одақтас болған ниндзя айдаһары Ширанай➡
Dialogue: 0,0:19:10.25,0:19:14.70,Default,,0,0,0,,Төтенше жағдай туралы ескертудің арқасында біз тосын шабуылдың алдын алдық.
Dialogue: 0,0:19:14.70,0:19:18.09,Default,,0,0,0,,Біз қазір қарсы шараларды қолданып жатырмыз.
Dialogue: 0,0:19:18.09,0:19:20.09,Default,,0,0,0,,Бар күшімізбен күресеміз
Dialogue: 0,0:19:20.09,0:19:23.60,Default,,0,0,0,,Алайда, бұл жолы бұрынғы үлкен апаттың уақыты болды➡
Dialogue: 0,0:19:23.60,0:19:26.26,Default,,0,0,0,,Ол бірдей жұмыс істемейді
Dialogue: 0,0:19:26.26,0:19:29.08,Default,,0,0,0,,Өйткені, қаздар сіздің әлеміңізде➡
Dialogue: 0,0:19:29.08,0:19:34.76,Default,,0,0,0,,Өйткені ол физикалық денесі бар болмыс ретінде қайта тірілген.
Dialogue: 0,0:19:34.76,0:19:36.93,Default,,0,0,0,,Бұл да мәнге ие болды➡
Dialogue: 0,0:19:36.93,0:19:39.43,Default,,0,0,0,,Қаздармен күресетін кез болады➡
Dialogue: 0,0:19:39.43,0:19:41.43,Default,,0,0,0,,келуі мүмкін
Dialogue: 0,0:19:41.43,0:19:44.58,Default,,0,0,0,,Сіз нені айтасыз? Диффрид дегенді қалай түсінесіңдер?
Dialogue: 0,0:19:44.58,0:19:49.59,Default,,0,0,0,,Диффридте біз шынайы әлеуетімізді көрсете алмаймыз.
Dialogue: 0,0:19:49.59,0:19:52.26,Default,,0,0,0,,Тағы бір қадам жоғары➡
Dialogue: 0,0:19:52.26,0:19:56.93,Default,,0,0,0,,Сіздің әлеміңізде нақты жұмыс істеуге күші бар тіршілік иесі ретінде➡
Dialogue: 0,0:19:56.93,0:20:00.58,Default,,0,0,0,,Жерден түсіңіз. Бұл мүмкін бе?
Dialogue: 0,0:20:00.58,0:20:03.25,Default,,0,0,0,,Бұл қиын, бірақ біз мұны істеуіміз керек
Dialogue: 0,0:20:03.25,0:20:05.75,Default,,0,0,0,,Бұл жағдайда Куроно Кимиде бар➡
Dialogue: 0,0:20:05.75,0:20:09.76,Default,,0,0,0,,Даралықтың күшін қолданып көрейін.
Dialogue: 0,0:20:09.76,0:20:14.60,Default,,0,0,0,,Ал Мессия мен Гиахрониктің барлық бөлімдері бар күш-жігерін салды➡
Dialogue: 0,0:20:14.60,0:20:17.70,Default,,0,0,0,,Бізді өз әлеміңізге жіберіңіз
Dialogue: 0,0:20:24.59,0:20:29.61,Default,,0,0,0,,Gear Chronic Singularity Shindou Chrono
Dialogue: 0,0:20:29.61,0:20:34.02,Default,,0,0,0,,Фидес Шион Кибаның мұрагері
Dialogue: 0,0:20:34.02,0:20:37.92,Default,,0,0,0,,Бірлігіммен өлгеннен кейін де ешқашан жоғалмайтын байланыс орнаттым➡
Dialogue: 0,0:20:37.92,0:20:41.76,Default,,0,0,0,,Сирек кездесетін көшбасшы Токоха Анджо
Dialogue: 0,0:20:41.76,0:20:45.28,Default,,0,0,0,,Балалар, бәрі басталған Стридегейтке де бардыңдар➡
Dialogue: 0,0:20:45.28,0:20:48.91,Default,,0,0,0,,Томо Токайрин Казума, ол Geese-ден ерекшеленді➡
Dialogue: 0,0:20:48.91,0:20:51.27,Default,,0,0,0,,терең қатысты
Dialogue: 0,0:20:51.27,0:20:54.09,Default,,0,0,0,,Тағдырымыздың жол көрсетушісі бізбен бірге➡
Dialogue: 0,0:20:54.09,0:20:57.11,Default,,0,0,0,,Мен сенің қаздармен бір мәселені шешкеніңді қалаймын.
Dialogue: 0,0:20:57.11,0:21:00.96,Default,,0,0,0,,Міне, Geacronic-тің зодиак уақытының аңы осылай шығарды➡
Dialogue: 0,0:21:00.96,0:21:04.75,Default,,0,0,0,,Бұл оракул және консенсус.
Dialogue: 0,0:21:04.75,0:21:06.75,Default,,0,0,0,,Әу бастан-ақ ниетім осы болатын.
Dialogue: 0,0:21:06.75,0:21:10.12,Default,,0,0,0,,Геазды жеңіп, Касуманы қайтарыңыз!
Dialogue: 0,0:21:10.12,0:21:12.94,Default,,0,0,0,,Саусақтарыңызды аузыңызға салып қараудың қажеті жоқ дегенді білдіреді.
Dialogue: 0,0:21:12.94,0:21:14.94,Default,,0,0,0,,Өте жақсы.
Dialogue: 0,0:21:14.94,0:21:18.43,Default,,0,0,0,,Иә, біз де жай ғана жабылып, жойылғымыз келмейді.
Dialogue: 0,0:21:18.43,0:21:20.45,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:20.45,0:21:22.85,Default,,0,0,0,,Сіздің әлеміңіз және біздің әлем➡
Dialogue: 0,0:21:22.85,0:21:27.60,Default,,0,0,0,,Екі дүниенің арасында ағып жатқан тағдырдың құдіреті туралы білесіз бе?
Dialogue: 0,0:21:27.60,0:21:30.46,Default,,0,0,0,,Тағдырдың күші…｡ Иә.
Dialogue: 0,0:21:30.46,0:21:33.49,Default,,0,0,0,,((Касуми: Сіз, Vanguard Fighter таңдауы➡
Dialogue: 0,0:21:33.49,0:21:36.76,Default,,0,0,0,,Біздің әлемді өзгертіңіз))
Dialogue: 0,0:21:36.76,0:21:39.10,Default,,0,0,0,,Кейбір адамдарда түсінбеушілік бар сияқты➡
Dialogue: 0,0:21:39.10,0:21:44.24,Default,,0,0,0,,Бір жақтың біржақты ойынан тағдыр құдіреті ешқашан тумайды.
Dialogue: 0,0:21:44.24,0:21:46.76,Default,,0,0,0,,Біреу біреу туралы ойлағанда➡
Dialogue: 0,0:21:46.76,0:21:50.76,Default,,0,0,0,,Сіз ешқашан елестетпеген күшті көрсете аласыз ➡
Dialogue: 0,0:21:50.76,0:21:54.80,Default,,0,0,0,,Біреу күшті ерік-жігермен алға ұмтылғанда➡
Dialogue: 0,0:21:54.80,0:21:58.10,Default,,0,0,0,,Көрген адам да жігерленеді деп сенемін➡
Dialogue: 0,0:21:58.10,0:22:02.75,Default,,0,0,0,,Күшті бейне жауынгерлер мен бөлімшенің күшті бейнесі бірігіп жұмыс істейді➡
Dialogue: 0,0:22:02.75,0:22:06.78,Default,,0,0,0,,Біз резонанс тудырғанда, ойымыз бір-бірімен үндеседі➡
Dialogue: 0,0:22:06.78,0:22:12.25,Default,,0,0,0,,Ғаламның шындығын шайқайтын күшті күшті тудыратын сілтеме
Dialogue: 0,0:22:12.25,0:22:15.92,Default,,0,0,0,,Бұл Авангардтың басшылығымен жасалған керемет
Dialogue: 0,0:22:15.92,0:22:17.94,Default,,0,0,0,,Қандай тіс жоқ болса да➡
Dialogue: 0,0:22:17.94,0:22:24.28,Default,,0,0,0,,Екі дүниеде айналатын тағдырдың берілістері тоқтады.
Dialogue: 0,0:22:24.28,0:22:26.95,Default,,0,0,0,,Тағдырдың берілістерінің қозғалысы➡
Dialogue: 0,0:22:26.95,0:22:29.10,Default,,0,0,0,,Болашақтың мәңгілігін күзететін адам –➡
Dialogue: 0,0:22:29.10,0:22:37.52,Default,,0,0,0,,Gear Chronic Біз уақытты басқаратын зодиак уақытының жануарларымыз.
Dialogue: 0,0:22:37.52,0:22:40.76,Default,,0,0,0,,Осы нүктеге жету үшін тағдырымызды қадағаладық➡
Dialogue: 0,0:22:40.76,0:22:44.13,Default,,0,0,0,,Мен мұны сезіндім
Dialogue: 0,0:22:44.13,0:22:46.67,Default,,0,0,0,,Бәрін жоққа қайтаруға тырысатын Қаздарға➡
Dialogue: 0,0:22:46.67,0:22:49.10,Default,,0,0,0,,Қатты қуысқа қарсы тұратын жалғыз нәрсе – ➡
Dialogue: 0,0:22:49.10,0:22:52.59,Default,,0,0,0,,Өмірдің ең қарапайым әрекеттерінен туған➡
Dialogue: 0,0:22:52.59,0:22:54.61,Default,,0,0,0,,Қуаныш пен үміт➡
Dialogue: 0,0:22:54.61,0:23:00.28,Default,,0,0,0,,Алға ұмтылу, бұл байлау емес пе?
Dialogue: 0,0:23:00.28,0:23:03.63,Default,,0,0,0,,Біз сенімен тағдырдың құдіретіне сенеміз.
Dialogue: 0,0:23:03.63,0:23:06.17,Default,,0,0,0,,оған ставка жасаңыз
Dialogue: 0,0:23:06.17,0:23:10.76,Default,,0,0,0,,Кел, Куроно. Келешегімізді тағы бір рет қайтарайық!
Dialogue: 0,0:23:10.76,0:23:14.29,Default,,0,0,0,,Бірақ қалай? Бұл тағдырдың құдіреті
Dialogue: 0,0:23:14.29,0:23:17.79,Default,,0,0,0,,Тек сіз бен менің бейнелерімізді резонансқа айналдырыңыз
Dialogue: 0,0:23:21.77,0:23:25.09,Default,,0,0,0,,Біздің болашағымызды елестетіңіз
Dialogue: 0,0:23:25.09,0:23:28.26,Default,,0,0,0,,Мен қолға алғым келетін болашақ...
Dialogue: 0,0:23:28.26,0:23:58.25,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:58.25,0:24:01.12,Default,,0,0,0,,Ах! Доран!
Dialogue: 0,0:24:01.12,0:24:04.44,Default,,0,0,0,,Онда біз сіздің әлеміңізде➡
Dialogue: 0,0:24:04.44,0:24:06.94,Default,,0,0,0,,Келіңіздер, соғысу үшін мәміле жасайық
Dialogue: 0,0:24:09.93,0:24:11.93,Default,,0,0,0,,Иә!? Міне бітті!
Dialogue: 0,0:24:15.94,0:24:17.96,Default,,0,0,0,,ｱｰｼｬ！
Dialogue: 0,0:24:17.96,0:24:19.96,Default,,0,0,0,,Ах... Ахша!
Dialogue: 0,0:24:23.41,0:24:25.76,Default,,0,0,0,,ｱﾙﾄﾏｲﾙ
Dialogue: 0,0:24:25.76,0:24:27.76,Default,,0,0,0,,Я~
Dialogue: 0,0:24:29.80,0:24:33.37,Default,,0,0,0,,Осы арқылы біз бірге күресуге ант етеміз.
Dialogue: 0,0:24:33.37,0:24:36.76,Default,,0,0,0,,Бейнеден асқан болашақ сіздің қолыңызда!
Dialogue: 0,0:24:36.76,0:24:39.66,Default,,0,0,0,,ﾃﾞｨﾒﾝｼｮﾅﾙｵｰﾊﾞｰｽﾄﾗｲﾄﾞ！
Dialogue: 0,0:24:58.36,0:25:00.25,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:25:00.25,0:25:03.25,Default,,0,0,0,,Мүмкін Дран шығар? О
Dialogue: 0,0:25:03.25,0:25:06.14,Default,,0,0,0,,Куроно Доран З. Ху~
Dialogue: 0,0:25:06.14,0:25:08.16,Default,,0,0,0,,Таңқаларлық емес
Dialogue: 0,0:25:08.16,0:25:11.93,Default,,0,0,0,,Балалар, сендер тағы да берік байланыс орнадыңдар.
Dialogue: 0,0:25:11.93,0:25:13.93,Default,,0,0,0,,Иә
Dialogue: 0,0:25:19.82,0:25:21.85,Default,,0,0,0,,Мен осында қаламын
Dialogue: 0,0:25:21.85,0:25:23.92,Default,,0,0,0,,Бірдеңе болған жағдайда ➡
Dialogue: 0,0:25:23.92,0:25:27.24,Default,,0,0,0,,Бұл жерді қорғайтын біреу керек шығар.
Dialogue: 0,0:25:27.24,0:25:29.76,Default,,0,0,0,,Маған да сендердің қамқорлықтарың болды.
Dialogue: 0,0:25:29.76,0:25:32.41,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:25:32.41,0:25:35.90,Default,,0,0,0,,Бауырлар, абай болыңыздар. О.
Dialogue: 0,0:25:35.90,0:25:37.92,Default,,0,0,0,,Олай болса. Хроно
Dialogue: 0,0:25:37.92,0:25:39.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:39.92,0:25:44.58,Default,,0,0,0,,Бәрі шешілгеннен кейін, біз тағы ұрысамыз ба?
Dialogue: 0,0:25:44.58,0:25:47.93,Default,,0,0,0,,Бұл орын алғанда, жай оралыңыз. Хмм.
Dialogue: 0,0:25:47.93,0:25:50.75,Default,,0,0,0,,Микул мырзамен дұрыстап, кешірім сұраңыз.
Dialogue: 0,0:25:50.75,0:25:53.45,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:26:00.43,0:26:03.26,Default,,0,0,0,,Сен есейдің, солай емес пе? Ах.
Dialogue: 0,0:26:03.26,0:26:05.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:26:05.28,0:26:09.60,Default,,0,0,0,,Қайта шайқасу үшін қаздарды міндетті түрде жеңіңіз.
Dialogue: 0,0:26:09.60,0:26:11.60,Default,,0,0,0,,Ах. Иә.
Dialogue: 0,0:27:51.59,0:27:53.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:33.60,0:30:37.59,Default,,0,0,0,,Өткен күні мен өте танымал американдық суретшімен → таныстым
Dialogue: 0,0:30:37.59,0:30:41.11,Default,,0,0,0,,Фуканы барлау жүргізілді.
Dialogue: 0,0:30:41.11,0:30:45.09,Default,,0,0,0,,Қатты! Бұл теріс қате
Dialogue: 0,0:30:45.09,0:30:49.66,Default,,0,0,0,,Фуканың тамаша орындаушылығын баптаңыз
Dialogue: 0,0:30:49.66,0:30:53.92,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:30:53.92,0:30:55.94,Default,,0,0,0,,Ғажайып әуендер!
Dialogue: 0,0:30:55.94,0:30:57.94,Default,,0,0,0,,ﾚｯﾂ ﾐﾗｸﾙ！
Dialogue: 0,0:30:59.44,0:31:05.44,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory