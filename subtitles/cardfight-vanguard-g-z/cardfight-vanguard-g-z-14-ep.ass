Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.72,0:01:06.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:06.97,0:01:13.39,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:13.39,0:01:17.45,Default,,0,0,0,,Касума…｡ (Ноа) Айдаһар жойылу құдайы
Dialogue: 0,0:01:17.45,0:01:19.65,Default,,0,0,0,,Бұл қаздардың пайда болуы
Dialogue: 0,0:01:24.82,0:01:30.48,Default,,0,0,0,,Касума-сан Куроно-санды қорғауға тырысты...
Dialogue: 0,0:01:30.48,0:01:32.48,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:01:38.63,0:01:41.63,Default,,0,0,0,,Бұл... қызық
Dialogue: 0,0:04:59.65,0:05:01.64,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:01.64,0:05:03.66,Default,,0,0,0,,Оны естігісі келетін менмін.
Dialogue: 0,0:05:03.66,0:05:06.06,Default,,0,0,0,,[Монитор] Қалай болғанда да, бұл керемет сандар.
Dialogue: 0,0:05:06.06,0:05:07.98,Default,,0,0,0,,[Монитор] Қараңыз
Dialogue: 0,0:05:07.98,0:05:11.65,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:05:11.65,0:05:15.17,Default,,0,0,0,,Әлі де жақсы емес пе?
Dialogue: 0,0:05:15.17,0:05:18.97,Default,,0,0,0,,Синдо-кун Касума...
Dialogue: 0,0:05:22.66,0:05:27.81,Default,,0,0,0,,Ұрысқыңыз келе ме, қаз мырза...
Dialogue: 0,0:05:27.81,0:05:29.80,Default,,0,0,0,,Куроно мырза...
Dialogue: 0,0:05:29.80,0:05:34.32,Default,,0,0,0,,Казуманы Қаздар сөндірді, солай ма? иә
Dialogue: 0,0:05:34.32,0:05:38.16,Default,,0,0,0,,Онда мен мұны істеймін.
Dialogue: 0,0:05:38.16,0:05:40.14,Default,,0,0,0,,Касумадағы қаздар➡
Dialogue: 0,0:05:40.14,0:05:44.65,Default,,0,0,0,,Мен сені қуып жіберемін
Dialogue: 0,0:05:44.65,0:05:46.65,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:05:58.48,0:06:00.48,Default,,0,0,0,,Тұр. (Тұтынушы) Жиын
Dialogue: 0,0:06:00.48,0:06:02.48,Default,,0,0,0,,ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:06:02.48,0:06:05.13,Default,,0,0,0,,ｸﾛﾉ･ﾄﾞﾗﾝ･Ｇ！
Dialogue: 0,0:06:05.13,0:06:08.47,Default,,0,0,0,,ﾄﾞﾗｸﾞﾌﾟﾘﾝｽﾙｰﾄ
Dialogue: 0,0:06:08.47,0:06:11.02,Default,,0,0,0,,ﾗｲﾄﾞ｡ ﾗｲﾄﾞ！
Dialogue: 0,0:06:11.02,0:06:14.09,Default,,0,0,0,,ｸﾛﾉｴﾄｽ･ｼﾞｬｯｶﾙ！
Dialogue: 0,0:06:14.09,0:06:16.39,Default,,0,0,0,,ｺｰﾙ ｱﾀｯｸ！
Dialogue: 0,0:06:18.33,0:06:20.32,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:06:20.32,0:06:24.49,Default,,0,0,0,,Сіз шынымен Касумасыз ба?
Dialogue: 0,0:06:24.49,0:06:27.19,Default,,0,0,0,,ﾗｲﾄﾞ ｺｰﾙ
Dialogue: 0,0:06:29.99,0:06:32.49,Default,,0,0,0,,Сәлем! (Касума) Шабуыл
Dialogue: 0,0:06:36.50,0:06:39.80,Default,,0,0,0,,Оны шынымен қаздар басып алды ма?
Dialogue: 0,0:06:39.80,0:06:42.14,Default,,0,0,0,,Сіз неге ұрысасыз, қаз мырза?
Dialogue: 0,0:06:42.14,0:06:47.33,Default,,0,0,0,,Казума Токайринді ыдыс ретінде пайдаланып, Қаз-саманың дифридіне айналды.
Dialogue: 0,0:06:47.33,0:06:53.32,Default,,0,0,0,,Дегенмен, бұл бірлік осы жерге келетін дифридтен ерекшеленеді.
Dialogue: 0,0:06:53.32,0:06:56.85,Default,,0,0,0,,Құдайдың келуі, инкарнация.
Dialogue: 0,0:06:56.85,0:06:58.89,Default,,0,0,0,,Ммм
Dialogue: 0,0:06:58.89,0:07:02.83,Default,,0,0,0,,Салт - бұл Клей планетасы мен осы планетаны байланыстыратын тағдыр заңы➡
Dialogue: 0,0:07:02.83,0:07:05.96,Default,,0,0,0,,Vanguard Fight арқылы аяқталды
Dialogue: 0,0:07:05.96,0:07:07.98,Default,,0,0,0,,Жеңіспен➡
Dialogue: 0,0:07:07.98,0:07:12.48,Default,,0,0,0,,Қаз-сама бұл дүниеге шынымен түсе алады!
Dialogue: 0,0:07:12.48,0:07:15.99,Default,,0,0,0,,Екі жұлдызды қосатын есікті ашатын ерекшелік➡
Dialogue: 0,0:07:15.99,0:07:20.48,Default,,0,0,0,,Нағыз лайықты құрбандық.
Dialogue: 0,0:07:20.48,0:07:23.03,Default,,0,0,0,,Мені елемеңіз!
Dialogue: 0,0:07:23.03,0:07:25.08,Default,,0,0,0,,Жауап беріңіз!
Dialogue: 0,0:07:25.08,0:07:27.08,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:07:36.48,0:07:38.99,Default,,0,0,0,,Касума мырза...
Dialogue: 0,0:07:38.99,0:07:40.98,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:07:40.98,0:07:45.68,Default,,0,0,0,,Фалларды сүйреңіз. Жоқ...
Dialogue: 0,0:07:50.32,0:07:52.83,Default,,0,0,0,,Бұл кеңістік-уақыт бұрмалануының шынайы табиғаты
Dialogue: 0,0:07:52.83,0:07:55.83,Default,,0,0,0,,Куроно-кунмен де, Онимару-кунмен де байланысу мүмкін емес.
Dialogue: 0,0:07:58.31,0:08:02.30,Default,,0,0,0,,ﾄﾞﾗｸﾞﾌｫｰﾙﾙｱｰﾄﾞ…
Dialogue: 0,0:08:02.30,0:08:04.65,Default,,0,0,0,,Касума-санның басқа эго...
Dialogue: 0,0:08:04.65,0:08:10.16,Default,,0,0,0,,Ху... Ыдыстың эгосы толығымен жабылды.
Dialogue: 0,0:08:10.16,0:08:12.14,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:08:12.14,0:08:15.16,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:08:15.16,0:08:17.17,Default,,0,0,0,,(Барлығы) Ах… (Алтыншы Төменгі Ай) Ол қозғалды!
Dialogue: 0,0:08:17.17,0:08:21.49,Default,,0,0,0,,Біз Куроно-сан үшін бірдеңе жасағымыз келді...
Dialogue: 0,0:08:21.49,0:08:24.99,Default,,0,0,0,,Касума мырза Куроно мырзаны қорғау үшін күресті.
Dialogue: 0,0:08:24.99,0:08:28.16,Default,,0,0,0,,Үмітсіз. Бірақ...
Dialogue: 0,0:08:28.16,0:08:33.46,Default,,0,0,0,,Осыған байланысты Казума-санда төбе пайда болды және...
Dialogue: 0,0:08:38.95,0:08:43.14,Default,,0,0,0,,Драг Фэллардпен Авангардқа шабуыл
Dialogue: 0,0:08:43.14,0:08:46.13,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ ﾄﾞﾛｰﾄﾘｶﾞｰ
Dialogue: 0,0:08:46.13,0:08:49.13,Default,,0,0,0,,Қуат Қара қанатты қылыш сындырғышқа түседі
Dialogue: 0,0:08:53.57,0:08:56.07,Default,,0,0,0,,Уау! (Касума) Шабуыл
Dialogue: 0,0:08:59.96,0:09:01.94,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:09:01.94,0:09:03.96,Default,,0,0,0,,ｷﾞｰｾﾞ！
Dialogue: 0,0:09:03.96,0:09:06.85,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:09:06.85,0:09:08.90,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:09:08.90,0:09:11.80,Default,,0,0,0,,ｸﾛﾉｼﾞｪｯﾄ･ﾄﾞﾗｺﾞﾝ･Ｇ！
Dialogue: 0,0:09:11.80,0:09:14.94,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:09:14.94,0:09:20.95,Default,,0,0,0,,ﾒﾀﾊﾟﾙｻｰｱｳﾞﾆｰﾙ･ﾌｪﾆｯｸｽ！
Dialogue: 0,0:09:20.95,0:09:22.97,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:09:22.97,0:09:24.95,Default,,0,0,0,,ﾀｲﾑﾘｰﾌﾟ！
Dialogue: 0,0:09:24.95,0:09:28.29,Default,,0,0,0,,ｸﾛﾉﾌｧﾝｸﾞ･ﾀｲｶﾞｰ･Ｇ！
Dialogue: 0,0:09:28.29,0:09:30.62,Default,,0,0,0,,Сонымен қатар, Chrono Dran G шеберлігі!
Dialogue: 0,0:09:30.62,0:09:32.64,Default,,0,0,0,,ｺｰﾙ！
Dialogue: 0,0:09:32.64,0:09:34.68,Default,,0,0,0,,Бақытты pot дағдысы іске қосылды!
Dialogue: 0,0:09:34.68,0:09:38.46,Default,,0,0,0,,Пауэр Plus 3000 оң жақ хроно желдеткіште
Dialogue: 0,0:09:38.46,0:09:42.45,Default,,0,0,0,,Ол ыдыс ретінде пайдаланылса да, ол бәрібір дифрид болып табылады.
Dialogue: 0,0:09:42.45,0:09:44.47,Default,,0,0,0,,Ал егер!
Dialogue: 0,0:09:44.47,0:09:47.47,Default,,0,0,0,,Жеңіске жет!
Dialogue: 0,0:09:47.47,0:09:51.13,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ
Dialogue: 0,0:09:51.13,0:09:54.31,Default,,0,0,0,,Авангардқа Авенир Феникске шабуыл жасаңыз!
Dialogue: 0,0:09:54.31,0:09:56.31,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:09:58.32,0:10:01.20,Default,,0,0,0,,G аймағының алдыңғы жағындағы әрбір карта үшін➡
Dialogue: 0,0:10:01.20,0:10:04.70,Default,,0,0,0,,Зодиак уақытының 2-ге дейін хайуанаттарға жоғары қоңырау шалу!
Dialogue: 0,0:10:06.63,0:10:08.63,Default,,0,0,0,,Куроно Қарғаның шеберлігі!
Dialogue: 0,0:10:08.63,0:10:10.96,Default,,0,0,0,,Өзіңізге қуат плюс 5000!
Dialogue: 0,0:10:10.96,0:10:13.52,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:10:13.52,0:10:15.55,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:10:15.55,0:10:18.12,Default,,0,0,0,,Қуат оң жақ хроно желдеткіштен.
Dialogue: 0,0:10:18.12,0:10:20.97,Default,,0,0,0,,Маңызды мәселелер бойынша Авенир Феникске барыңыз!
Dialogue: 0,0:10:20.97,0:10:25.17,Default,,0,0,0,,Жеңіске жетіп, қаздарды кері айдаңыз!
Dialogue: 0,0:10:30.90,0:10:33.00,Default,,0,0,0,,Куроно тырнақтарымен шабуыл!
Dialogue: 0,0:10:33.00,0:10:35.34,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ
Dialogue: 0,0:10:35.34,0:10:39.04,Default,,0,0,0,,Drag Whisper Bronach дағдысын белсендіру
Dialogue: 0,0:10:41.19,0:10:44.30,Default,,0,0,0,,ｸﾛﾉﾌｧﾝｸﾞ！ (ｶｽﾞﾏ)ｶﾞｰﾄﾞ
Dialogue: 0,0:10:44.30,0:10:47.13,Default,,0,0,0,,Кух... Хронофангтың шеберлігі
Dialogue: 0,0:10:47.13,0:10:51.30,Default,,0,0,0,,Қылыш сынғышты палубаның төменгі жағына қойыңыз
Dialogue: 0,0:10:51.30,0:10:54.20,Default,,0,0,0,,Chronoetos байланыстыру
Dialogue: 0,0:10:58.98,0:11:01.18,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:11:06.13,0:11:08.93,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:11:18.33,0:11:21.03,Default,,0,0,0,,ﾄﾞﾗｸﾞｱﾋﾞｽﾙｱｰﾄﾞ
Dialogue: 0,0:11:24.80,0:11:27.70,Default,,0,0,0,,ﾄﾞﾗｸﾞｱﾋﾞｽﾙｱｰﾄﾞ…
Dialogue: 0,0:13:11.73,0:13:15.98,Default,,0,0,0,,G бірлікке дейін, қаздарға...
Dialogue: 0,0:13:15.98,0:13:17.98,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ
Dialogue: 0,0:13:17.98,0:13:23.64,Default,,0,0,0,,1 дәрежелі 1 немесе төменгі палубадан Superior Call
Dialogue: 0,0:13:23.64,0:13:26.83,Default,,0,0,0,,Өйткені абисал үкіде ырым бар➡
Dialogue: 0,0:13:26.83,0:13:30.73,Default,,0,0,0,,Бір бағанда бір қарсыластың артқы қорғаушысын шегіндіріңіз.
Dialogue: 0,0:13:33.47,0:13:35.97,Default,,0,0,0,,Abyssalard дағдыларын сүйреңіз
Dialogue: 0,0:13:38.32,0:13:41.49,Default,,0,0,0,,Бір артқы қорғаушыны шегіндіріңіз
Dialogue: 0,0:13:41.49,0:13:45.69,Default,,0,0,0,,2 Superior Call палубасынан 1-сынып карталары
Dialogue: 0,0:13:47.65,0:13:52.25,Default,,0,0,0,,Екі картаның да рәсімдері бар, сондықтан қарсыласыңыздың артқы күзетшілерінің бірін отставкаға жіберіңіз.
Dialogue: 0,0:13:55.30,0:13:59.29,Default,,0,0,0,,Лагерьді дайындау кезінде қарсыласыңызды жойыңыз!
Dialogue: 0,0:13:59.29,0:14:01.29,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:14:01.29,0:14:05.45,Default,,0,0,0,,Жақсы ритуал Қуат плюс 2000 өзіңізге
Dialogue: 0,0:14:05.45,0:14:09.47,Default,,0,0,0,,Абсал үкі салттық қарсы заряд
Dialogue: 0,0:14:09.47,0:14:11.47,Default,,0,0,0,,ｺｰﾙ
Dialogue: 0,0:14:13.64,0:14:19.51,Default,,0,0,0,,Drag Abyss Ritual Cross Drop аймағының 4 дана үшін 1 дәрежесі➡
Dialogue: 0,0:14:19.51,0:14:23.01,Default,,0,0,0,,Барлық алдыңғы қатарлар үшін қуат плюс 10000
Dialogue: 0,0:14:26.64,0:14:29.94,Default,,0,0,0,,G бірлігі – біздің болашағымыз
Dialogue: 0,0:14:32.97,0:14:37.13,Default,,0,0,0,,Жаңа мүмкіндіктерді меңгерген болашақ өзін
Dialogue: 0,0:14:37.13,0:14:41.48,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:14:41.48,0:14:44.78,Default,,0,0,0,,Авангардқа Drag Abyss Guard көмегімен шабуыл жасаңыз
Dialogue: 0,0:14:46.79,0:14:49.27,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:14:49.27,0:14:52.29,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:14:52.29,0:14:54.30,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:14:54.30,0:14:56.63,Default,,0,0,0,,Күш – морфеза
Dialogue: 0,0:14:56.63,0:14:59.13,Default,,0,0,0,,Есірткі тұңғиығына сыни өнер
Dialogue: 0,0:15:08.34,0:15:10.74,Default,,0,0,0,,ｶｽﾞﾏ～！
Dialogue: 0,0:15:13.75,0:15:15.85,Default,,0,0,0,,Жақсы, қаз мырза!
Dialogue: 0,0:15:18.64,0:15:21.66,Default,,0,0,0,,Сәттілік, Куроно-сан!
Dialogue: 0,0:15:21.66,0:15:24.66,Default,,0,0,0,,Касума-сан соңына дейін берілмеді.
Dialogue: 0,0:15:24.66,0:15:30.30,Default,,0,0,0,,Куроно-сан үшін мен тісімді қайрап, шарасыздан...
Dialogue: 0,0:15:30.30,0:15:33.67,Default,,0,0,0,,Сонымен... Куроно-сан!
Dialogue: 0,0:15:33.67,0:15:37.74,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:15:37.74,0:15:39.64,Default,,0,0,0,,ｶｽﾞﾏ…
Dialogue: 0,0:15:39.64,0:15:42.63,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:15:42.63,0:15:44.65,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:15:44.65,0:15:46.65,Default,,0,0,0,,Мәңгілік уақыт қызы Уруру!
Dialogue: 0,0:15:46.65,0:15:49.07,Default,,0,0,0,,Қалқан плюс 30 000 шеберлікпен!
Dialogue: 0,0:15:49.07,0:15:51.82,Default,,0,0,0,,Керемет шеберлік Морфессаның шегінуі
Dialogue: 0,0:15:51.82,0:15:54.49,Default,,0,0,0,,1 карта ұтысы
Dialogue: 0,0:15:54.49,0:15:56.79,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:16:00.98,0:16:03.00,Default,,0,0,0,,ｶｽﾞﾏ！
Dialogue: 0,0:16:03.00,0:16:07.32,Default,,0,0,0,,Менің болашағым... Мен оның барлық мүмкіндіктеріне тәуекел етемін→
Dialogue: 0,0:16:07.32,0:16:10.31,Default,,0,0,0,,Мен сені қайтарамын
Dialogue: 0,0:16:10.31,0:16:13.33,Default,,0,0,0,,Құны бойынша Vanguard картасымен бірдей
Dialogue: 0,0:16:13.33,0:16:17.33,Default,,0,0,0,,Осы күшпен, қаздар! Мен сені жеңемін!!
Dialogue: 0,0:16:19.30,0:16:21.32,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:16:21.32,0:16:23.72,Default,,0,0,0,,Маған қамқор болған сен бе? Рақмет…
Dialogue: 0,0:16:25.95,0:16:28.97,Default,,0,0,0,,Осы жекпе-жектен жеңілсем→
Dialogue: 0,0:16:28.97,0:16:31.98,Default,,0,0,0,,Generation Zone картасы ешқашан қайтарылмайды.
Dialogue: 0,0:16:31.98,0:16:37.05,Default,,0,0,0,,Менің болашағымды жеп, оны көрсет.
Dialogue: 0,0:16:37.05,0:16:40.64,Default,,0,0,0,,Даркзонның нөлдік айдаһары!
Dialogue: 0,0:16:40.64,0:16:43.17,Default,,0,0,0,,ｱﾙﾃｨﾒｯﾄｽﾄﾗｲﾄﾞ!!
Dialogue: 0,0:16:43.17,0:16:55.62,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:55.62,0:16:58.62,Default,,0,0,0,,Нөлдік айдаһар шаңының соңы!
Dialogue: 0,0:17:01.62,0:17:03.63,Default,,0,0,0,,《Мистер Куроно...》
Dialogue: 0,0:17:03.63,0:17:08.63,Default,,0,0,0,,Тіпті елші емес адам үшін Zero Dragon-ды қолдану өте әдепсіз!
Dialogue: 0,0:17:10.63,0:17:12.65,Default,,0,0,0,,Ох…
Dialogue: 0,0:17:12.65,0:17:15.25,Default,,0,0,0,,《Не істеу керек? Қаздар》
Dialogue: 0,0:17:17.29,0:17:21.64,Default,,0,0,0,,Мен Казуманы міндетті түрде құтқарамын. Шаң жинау дағдысы іске қосылды!
Dialogue: 0,0:17:21.64,0:17:25.00,Default,,0,0,0,,Қарсыластың барлық бөлімшелері қабілеттерін жоғалтады→
Dialogue: 0,0:17:25.00,0:17:27.63,Default,,0,0,0,,Баға мен қуат 1-ге айналады
Dialogue: 0,0:17:27.63,0:17:30.63,Default,,0,0,0,,Және Авангардқа 1 зиян!
Dialogue: 0,0:17:32.62,0:17:34.64,Default,,0,0,0,,1 зиян қалды...
Dialogue: 0,0:17:34.64,0:17:37.71,Default,,0,0,0,,ﾑｷｰｯ！
Dialogue: 0,0:17:37.71,0:17:40.31,Default,,0,0,0,,ｺｰﾙ｡ ｱﾀｯｸ！
Dialogue: 0,0:17:42.95,0:17:45.32,Default,,0,0,0,,ｶｽﾞﾏ…
Dialogue: 0,0:17:45.32,0:17:48.37,Default,,0,0,0,,((Мен мүмкіндігінше тезірек күрескім келеді.
Dialogue: 0,0:17:48.37,0:17:52.14,Default,,0,0,0,,Ешқандай қажетсіз ойларсыз басыңызды босатыңыз.
Dialogue: 0,0:17:52.14,0:17:56.01,Default,,0,0,0,,Олай болса мен жеңер едім))
Dialogue: 0,0:17:56.01,0:17:59.30,Default,,0,0,0,,Мен сенімен төбелескім келеді
Dialogue: 0,0:17:59.30,0:18:02.62,Default,,0,0,0,,Болашақта... Болашақта...
Dialogue: 0,0:18:02.62,0:18:05.69,Default,,0,0,0,,Көбірек... мәңгілікке!
Dialogue: 0,0:18:05.69,0:18:10.69,Default,,0,0,0,,Күзетші. Evil Refresher Dragon шеберлігін белсендіру
Dialogue: 0,0:18:13.13,0:18:15.46,Default,,0,0,0,,Зұлымдықты сергіту айдаһарының рециталі
Dialogue: 0,0:18:15.46,0:18:19.26,Default,,0,0,0,,Қалқан плюс 10000. Сондай-ақ күзет
Dialogue: 0,0:18:21.64,0:18:24.29,Default,,0,0,0,,Zero Dragon шабуылын тоқтатты!
Dialogue: 0,0:18:24.29,0:18:27.31,Default,,0,0,0,,Әлі жоқ. Үштік жетек
Dialogue: 0,0:18:27.31,0:18:30.70,Default,,0,0,0,,Емдеу триггері. Қуат шаңға кетеді
Dialogue: 0,0:18:30.70,0:18:33.98,Default,,0,0,0,,Критикалық триггер. Барлық әсерлер шаңға айналады.
Dialogue: 0,0:18:33.98,0:18:38.97,Default,,0,0,0,,Қос триггер! Егер сіз келесі жолы триггер болсаңыз, сіз өтесіз!
Dialogue: 0,0:18:38.97,0:18:41.27,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ
Dialogue: 0,0:18:53.28,0:18:55.64,Default,,0,0,0,,ﾉｰﾄﾘｶﾞｰ
Dialogue: 0,0:18:55.64,0:18:58.67,Default,,0,0,0,,Ой... әлі біткен жоқ!
Dialogue: 0,0:18:58.67,0:19:02.71,Default,,0,0,0,,Мен жетекті тексеруде Zodiac Time Beast 3 бағасын алдым, сондықтан →
Dialogue: 0,0:19:02.71,0:19:05.28,Default,,0,0,0,,Лугал Уре дағдыларын белсендіру
Dialogue: 0,0:19:05.28,0:19:09.62,Default,,0,0,0,,ﾀｲﾑﾘｰﾌﾟ！ ｸﾛﾉｼﾞｪｯﾄ･ﾄﾞﾗｺﾞﾝ･Ｇ！
Dialogue: 0,0:19:09.62,0:19:13.99,Default,,0,0,0,,Аяқтаймыз. Бұл жай ғана ұрыс емес.
Dialogue: 0,0:19:13.99,0:19:17.29,Default,,0,0,0,,Ақымақ және ақымақ нәрселер →
Dialogue: 0,0:19:17.29,0:19:19.98,Default,,0,0,0,,Толығырақ толтырыңыз.
Dialogue: 0,0:19:19.98,0:19:23.46,Default,,0,0,0,,Қарынымызды ұстап, күлдік, бір-бірімізбен әбден ақымақ болдық...
Dialogue: 0,0:19:23.46,0:19:26.66,Default,,0,0,0,,Бірақ ол сенімен емес!
Dialogue: 0,0:19:28.62,0:19:32.12,Default,,0,0,0,,Казумадан кет, қаздар!!
Dialogue: 0,0:19:34.13,0:19:37.03,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:19:37.03,0:19:40.32,Default,,0,0,0,,Хахахахахаха!
Dialogue: 0,0:19:40.32,0:19:45.30,Default,,0,0,0,,Нөлдік айдаһар – Крей планетасының алты ұлтына жататын элемент→
Dialogue: 0,0:19:45.30,0:19:48.67,Default,,0,0,0,,Қаздар жасаған керемет күш!
Dialogue: 0,0:19:48.67,0:19:52.64,Default,,0,0,0,,Мен қаз мырзаны жеңе алмаймын!!
Dialogue: 0,0:19:52.64,0:19:54.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:56.63,0:20:00.19,Default,,0,0,0,,Генерация аймағының картасы бұл...
Dialogue: 0,0:20:00.19,0:20:02.99,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:20:04.97,0:20:07.67,Default,,0,0,0,,Құнға дәрінің төмендеуін қосыңыз
Dialogue: 0,0:20:09.64,0:20:11.65,Default,,0,0,0,,Маған қамқор болған сен бе? Рақмет…
Dialogue: 0,0:20:11.65,0:20:15.32,Default,,0,0,0,,Біріккен ғибадатхананың нөлдік айдаһары
Dialogue: 0,0:20:15.32,0:20:18.32,Default,,0,0,0,,ｱﾙﾃｨﾒｯﾄｽﾄﾗｲﾄﾞ
Dialogue: 0,0:20:18.32,0:20:46.15,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:46.15,0:20:49.15,Default,,0,0,0,,Экстремалды аспан нөлдік айдаһар Ultima
Dialogue: 0,0:20:51.62,0:20:54.66,Default,,0,0,0,,Юнасанның нөлдік айдаһары...
Dialogue: 0,0:20:54.66,0:20:57.96,Default,,0,0,0,,Қарсыласта нөлдік айдаһар да бар...
Dialogue: 0,0:20:57.96,0:21:03.62,Default,,0,0,0,,Юнасанның «Нөлдік айдаһары» тұтқасыз жалғыз болды.
Dialogue: 0,0:21:03.62,0:21:07.97,Default,,0,0,0,,Мен оны бұлай қолданады деп ешқашан ойламаппын.
Dialogue: 0,0:21:07.97,0:21:11.02,Default,,0,0,0,,Күтпеген жерден Қасума Тоқайрин →
Dialogue: 0,0:21:11.02,0:21:14.63,Default,,0,0,0,,Бұл мүмкін болды, себебі ол Shadow Paraden қолданушысы болды.
Dialogue: 0,0:21:14.63,0:21:17.98,Default,,0,0,0,,Ал сол Қазума Тоқайрин →
Dialogue: 0,0:21:17.98,0:21:21.63,Default,,0,0,0,,Күтпеген жерден Қаз мырзаның ыдысына айналды
Dialogue: 0,0:21:21.63,0:21:25.30,Default,,0,0,0,,Қандай кездейсоқтық, қандай қажеттілік!
Dialogue: 0,0:21:25.30,0:21:28.46,Default,,0,0,0,,Барлығын Қаз-сама ретке келтірген
Dialogue: 0,0:21:28.46,0:21:32.26,Default,,0,0,0,,Дүниенің жойылғысы келетініне күмән жоқ!
Dialogue: 0,0:21:36.48,0:21:39.97,Default,,0,0,0,,Қасиетті…
Dialogue: 0,0:21:39.97,0:21:43.62,Default,,0,0,0,,Тілегіміз орындалды!
Dialogue: 0,0:21:43.62,0:21:47.29,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｽﾍﾟﾘｵﾙｺｰﾙ
Dialogue: 0,0:21:47.29,0:21:49.99,Default,,0,0,0,,Лугал Урені шегіндіріңіз
Dialogue: 0,0:21:55.30,0:21:58.29,Default,,0,0,0,,Өтінемін, Куроно мырза, жеңіңіз.
Dialogue: 0,0:21:58.29,0:22:02.62,Default,,0,0,0,,Касума-санға ұтыңыз... өтінемін!
Dialogue: 0,0:22:02.62,0:22:07.80,Default,,0,0,0,,Мүлдем... Мен жеңілуге ​​шамасы жоқ!
Dialogue: 0,0:22:07.80,0:22:09.80,Default,,0,0,0,,Ультима шеберлігі
Dialogue: 0,0:22:09.80,0:22:14.30,Default,,0,0,0,,Палубадан 4 картаны таңдап, оның 2-ін жоғарырақ деп атаңыз.
Dialogue: 0,0:22:14.30,0:22:17.31,Default,,0,0,0,,Қалған екі картаны палубаның үстіне қойыңыз.
Dialogue: 0,0:22:17.31,0:22:21.13,Default,,0,0,0,,Және осы айналым кезінде Авангардтың триггер әсері ➡ болады
Dialogue: 0,0:22:21.13,0:22:24.13,Default,,0,0,0,,Барлық бірліктерді алуға болады
Dialogue: 0,0:22:24.13,0:22:28.63,Default,,0,0,0,,Уау! Барлық блоктар үшін Пауэр Plus 5000!
Dialogue: 0,0:22:28.63,0:22:31.64,Default,,0,0,0,,Егер сіз стенд триггері болсаңыз, барлық қондырғылар орнынан тұрады➡
Dialogue: 0,0:22:31.64,0:22:36.66,Default,,0,0,0,,Егер бұл өте маңызды болса, барлық бөлімшелер келтірген залал екі есе артады!
Dialogue: 0,0:22:36.66,0:22:40.71,Default,,0,0,0,,Оның үстіне триггер пайда болатыны анық!
Dialogue: 0,0:22:40.71,0:22:42.95,Default,,0,0,0,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,0:22:42.95,0:22:46.97,Default,,0,0,0,,Сонда да ұтыла алмаймын... Не істесем де➡
Dialogue: 0,0:22:46.97,0:22:53.96,Default,,0,0,0,,Қандай жағдай болмасын, бұл жекпе-жек ешқашан...
Dialogue: 0,0:22:53.96,0:22:56.66,Default,,0,0,0,,ｶｽﾞﾏ!!
Dialogue: 0,0:23:01.80,0:23:04.20,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:23:06.65,0:23:08.65,Default,,0,0,0,,ｶｽﾞﾏ！
Dialogue: 0,0:23:18.97,0:23:23.27,Default,,0,0,0,,Уф... уф!!
Dialogue: 0,0:23:26.16,0:23:28.66,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:23:31.31,0:23:35.67,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:23:35.67,0:23:40.17,Default,,0,0,0,,Сіз дәл менің алдымда тұрсыз. Қолымды созсам, мен саған жете аламын.
Dialogue: 0,0:23:47.15,0:23:51.00,Default,,0,0,0,,Сондықтан мен ұтыла алмаймын...
Dialogue: 0,0:23:51.00,0:23:53.80,Default,,0,0,0,,ｶｽﾞﾏ～!!
Dialogue: 0,0:24:04.98,0:24:08.98,Default,,0,0,0,,Куроно мырза жеңіліп қалды...
Dialogue: 0,0:24:17.49,0:24:22.15,Default,,0,0,0,,Шинду Куроно, сенің болашағың жоғалды.
Dialogue: 0,0:24:22.15,0:24:24.15,Default,,0,0,0,,Және…
Dialogue: 0,0:24:26.15,0:24:29.15,Default,,0,0,0,,Дүние, үндеме.
Dialogue: 0,0:24:29.15,0:24:48.66,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:48.66,0:24:54.65,Default,,0,0,0,,Барлық алты ұлттың нөлдік айдаһарлары енді оянды!
Dialogue: 0,0:24:54.65,0:24:57.67,Default,,0,0,0,,Бұл... Нөлдік айдаһар!?
Dialogue: 0,0:24:57.67,0:25:02.27,Default,,0,0,0,,Бұрынғыдан өзгеше... Шиндо-кун! Касума!
Dialogue: 0,0:25:05.01,0:25:10.01,Default,,0,0,0,,Тәңіріме құрбан бол!
Dialogue: 0,0:25:15.80,0:25:18.20,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:25:20.82,0:25:23.72,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:25:37.99,0:25:41.19,Default,,0,0,0,,Кеттік, қаз мырза.
Dialogue: 0,0:27:23.89,0:27:29.32,Default,,0,0,0,,Синдо-кун, байқадың ба? Бұл қауіпсіз аурухана.
Dialogue: 0,0:27:29.32,0:27:31.52,Default,,0,0,0,,Аурухана…
Dialogue: 0,0:28:01.15,0:28:03.65,Default,,0,0,0,,ｶｽﾞﾏ…
Dialogue: 0,0:30:33.65,0:30:38.01,Default,,0,0,0,,Бұл қорқынышты! Бұл дүниеде жын патшасы пайда болды.
Dialogue: 0,0:30:38.01,0:30:41.14,Default,,0,0,0,,Оның аурасы өте жағымсыз.
Dialogue: 0,0:30:41.14,0:30:44.98,Default,,0,0,0,,Мен жоғалып кетті деп ойлаған жын патшасы қайта пайда болды→
Dialogue: 0,0:30:44.98,0:30:49.15,Default,,0,0,0,,Канонның кристалды әшекейі ұрланды
Dialogue: 0,0:30:49.15,0:30:53.04,Default,,0,0,0,,Өйткені бір кристалды әшекей жоқ →
Dialogue: 0,0:30:53.04,0:30:58.31,Default,,0,0,0,,Енді мен соңғы режимсіз күресуім керек.
Dialogue: 0,0:30:59.81,0:31:05.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory