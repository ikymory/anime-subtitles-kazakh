Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.91,0:01:09.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:09.84,0:01:12.50,Default,,0,0,0,,Chaos Breaker қашып кетті ме?
Dialogue: 0,0:01:12.50,0:01:17.01,Default,,0,0,0,,Жарайды, мен оның бетін ұрып-соғумен ғана қанағаттандым.
Dialogue: 0,0:01:17.01,0:01:21.85,Default,,0,0,0,,Оның жартысы олардың кінәсі.
Dialogue: 0,0:01:21.85,0:01:26.34,Default,,0,0,0,,≪(Камуи) Арата Макото! Сенімен бәрі жақсы ма!?
Dialogue: 0,0:01:26.34,0:01:29.35,Default,,0,0,0,,Мәртебелі! Сол жігіттер!
Dialogue: 0,0:01:29.35,0:01:33.01,Default,,0,0,0,,ﾁｰﾑＱ４
Dialogue: 0,0:01:33.01,0:01:35.01,Default,,0,0,0,,ｱﾗﾀ ﾏｺﾄ！
Dialogue: 0,0:01:35.01,0:01:39.16,Default,,0,0,0,,Жарайды. Менің ойымша, ол жай ғана ес-түссіз.
Dialogue: 0,0:01:39.16,0:01:41.67,Default,,0,0,0,,Бұл Темераның жұмысы ма?
Dialogue: 0,0:01:41.67,0:01:44.04,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:01:44.04,0:01:46.07,Default,,0,0,0,,Бұл менің жолым!
Dialogue: 0,0:01:46.07,0:01:48.86,Default,,0,0,0,,Мен жасаған жәдігерлер!
Dialogue: 0,0:01:48.86,0:01:52.84,Default,,0,0,0,,Қара бет. Ха! Хаха~
Dialogue: 0,0:01:52.84,0:01:54.86,Default,,0,0,0,,Вараваха Гредора
Dialogue: 0,0:01:54.86,0:01:59.67,Default,,0,0,0,,Қаздардың елшісі және Мегаколонияны басқаратын патшайым
Dialogue: 0,0:01:59.67,0:02:02.02,Default,,0,0,0,,Мен сен туралы естідім.
Dialogue: 0,0:02:02.02,0:02:05.17,Default,,0,0,0,,Қараңғы жүз ұясында➡
Dialogue: 0,0:02:05.17,0:02:08.84,Default,,0,0,0,,Ол көп жамандық жасаған сияқты.
Dialogue: 0,0:02:08.84,0:02:13.22,Default,,0,0,0,,Жамандық? Ха, бұл тазалау қатесі болуы керек.
Dialogue: 0,0:02:13.22,0:02:15.77,Default,,0,0,0,,Хун, жүзің жақсы екен.
Dialogue: 0,0:02:15.77,0:02:18.37,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:02:18.37,0:02:21.87,Default,,0,0,0,,Камюи.  Wood Camui
Dialogue: 0,0:05:33.87,0:05:39.22,Default,,0,0,0,,Мені іздеу қиындығынан құтқарды. Мен моксибус орнатуым керек.
Dialogue: 0,0:05:39.22,0:05:41.82,Default,,0,0,0,,Ол Арата мен Макотоға сұмдық жасады.
Dialogue: 0,0:05:41.82,0:05:44.33,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:05:44.33,0:05:46.34,Default,,0,0,0,,Тұр. (Градора) жинағы
Dialogue: 0,0:05:46.34,0:05:48.40,Default,,0,0,0,,ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:05:48.40,0:05:52.67,Default,,0,0,0,,Трактор басына Мехабаттай мін!
Dialogue: 0,0:05:52.67,0:05:55.87,Default,,0,0,0,,Көрнекті монстр промо әуесқойы
Dialogue: 0,0:06:05.85,0:06:09.20,Default,,0,0,0,,Ух...｡ (Мисаки) Жақсы.
Dialogue: 0,0:06:09.20,0:06:11.75,Default,,0,0,0,,Амансың ба? Мисаки мырза?
Dialogue: 0,0:06:11.75,0:06:15.49,Default,,0,0,0,,Біз жеңілдік... (Макото) Бірақ...
Dialogue: 0,0:06:15.49,0:06:17.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:17.84,0:06:19.98,Default,,0,0,0,,Камуи мырза!
Dialogue: 0,0:06:19.98,0:06:22.43,Default,,0,0,0,,Мечабатлер Горчқа➡
Dialogue: 0,0:06:22.43,0:06:24.83,Default,,0,0,0,,Мен мінемін!
Dialogue: 0,0:06:24.83,0:06:28.00,Default,,0,0,0,,ｺｰﾙ！
Dialogue: 0,0:06:28.00,0:06:30.34,Default,,0,0,0,,Уайымдамаңыз. Сіздің жауыңыз➡
Dialogue: 0,0:06:30.34,0:06:32.39,Default,,0,0,0,,Камуи оны сіз үшін алады.
Dialogue: 0,0:06:32.39,0:06:35.68,Default,,0,0,0,,Кешіріңіз. Мен толығымен жеңілдім.
Dialogue: 0,0:06:35.68,0:06:39.20,Default,,0,0,0,,Ол жігіт мықты екен.
Dialogue: 0,0:06:39.20,0:06:44.84,Default,,0,0,0,,Қараңдар, мен сендер үшін мына нәрсені ұрып-соғамын!
Dialogue: 0,0:06:44.84,0:06:46.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:46.84,0:06:50.34,Default,,0,0,0,,Әй, шырағым, жеңуге тырысу керек.
Dialogue: 0,0:06:50.34,0:06:52.34,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:06:52.34,0:06:54.53,Default,,0,0,0,,Алғы сөз қосуға рұқсат етіңіздер.
Dialogue: 0,0:06:54.53,0:06:58.00,Default,,0,0,0,,Жарылғыш жауынгерлік рух! Өте ыстық даңқ!
Dialogue: 0,0:06:58.00,0:07:04.17,Default,,0,0,0,,Мен шайқастағы Жеңіске мінемін!
Dialogue: 0,0:07:04.17,0:07:06.37,Default,,0,0,0,,Баттагилмен шабуыл!
Dialogue: 0,0:07:11.58,0:07:13.50,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:07:13.50,0:07:18.50,Default,,0,0,0,,Критикалық триггер. Барлық әсерлер Vanguard-да.
Dialogue: 0,0:07:18.50,0:07:20.51,Default,,0,0,0,,Енді оның шығыны 3
Dialogue: 0,0:07:20.51,0:07:23.51,Default,,0,0,0,,Бірақ триггер бортта және бұдан былай камминг жоқ➡
Dialogue: 0,0:07:23.51,0:07:26.34,Default,,0,0,0,,Мен енді шабуыл жасай алмаймын.
Dialogue: 0,0:07:26.34,0:07:28.64,Default,,0,0,0,,Не керек, алда келе жатқан нәрсе.
Dialogue: 0,0:07:30.70,0:07:32.70,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:07:35.85,0:07:39.95,Default,,0,0,0,,ｲﾋﾞﾙｶﾞﾊﾞﾅｰ･ﾀﾞｰｸﾌｪｲｽ･ｸﾞﾚﾄﾞｰﾗ
Dialogue: 0,0:07:42.49,0:07:44.51,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:07:44.51,0:07:46.51,Default,,0,0,0,,Сіз келесі кезексіз➡
Dialogue: 0,0:07:46.51,0:07:50.84,Default,,0,0,0,,Оң жақ бағанға бірлікті шақыра алмаймын. Не!?
Dialogue: 0,0:07:50.84,0:07:52.85,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:07:52.85,0:07:57.34,Default,,0,0,0,,Улы орақ құбыжық құдай Овервелм!
Dialogue: 0,0:07:57.34,0:08:00.30,Default,,0,0,0,,ｺｰﾙ
Dialogue: 0,0:08:00.30,0:08:04.15,Default,,0,0,0,,Қорқытатын құбыжық патшасы қара бет Альцидтің дағдылары
Dialogue: 0,0:08:04.15,0:08:07.35,Default,,0,0,0,,ﾊﾟﾗﾗｲｽﾞ！
Dialogue: 0,0:08:07.35,0:08:09.67,Default,,0,0,0,,Шамадан тыс шеберлік
Dialogue: 0,0:08:09.67,0:08:14.01,Default,,0,0,0,,Қарсыласыңыз демалып жатқан тыл сақшыларының санын анықтаңыз.
Dialogue: 0,0:08:14.01,0:08:16.01,Default,,0,0,0,,ｺｰﾙ
Dialogue: 0,0:08:16.01,0:08:18.00,Default,,0,0,0,,Менікімен бірдей.
Dialogue: 0,0:08:18.00,0:08:20.90,Default,,0,0,0,,Келесі айналым Сол қатарда тіректер бар➡
Dialogue: 0,0:08:20.90,0:08:23.50,Default,,0,0,0,,Оң жақ бағанды шақыруға болмайды.
Dialogue: 0,0:08:23.50,0:08:26.50,Default,,0,0,0,,Сонымен қатар, үш карта ойнатылды.
Dialogue: 0,0:08:26.50,0:08:29.67,Default,,0,0,0,,Енді көңіліңнен шыққанша жабайы жүр.
Dialogue: 0,0:08:29.67,0:08:34.83,Default,,0,0,0,,Құрметті сабан балалары
Dialogue: 0,0:08:34.83,0:08:38.52,Default,,0,0,0,,Құпия маневр. Пауэр Plus 10000
Dialogue: 0,0:08:38.52,0:08:41.85,Default,,0,0,0,,Сіз өзара әрекеттесе алмайсыз
Dialogue: 0,0:08:41.85,0:08:43.87,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:08:43.87,0:08:46.37,Default,,0,0,0,,ﾒﾃｵｶｲｻﾞｰﾕﾆｵｰﾙ！
Dialogue: 0,0:08:51.35,0:08:53.52,Default,,0,0,0,,《Оның да нөлдік айдаһары бар.
Dialogue: 0,0:08:53.52,0:08:57.19,Default,,0,0,0,,Мен оны кейін жарып жіберетініне сенімдімін.
Dialogue: 0,0:08:57.19,0:09:00.39,Default,,0,0,0,,Авангардқа шабуыл жасаңыз! Норгаард
Dialogue: 0,0:09:02.34,0:09:05.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:05.34,0:09:08.83,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:09:08.83,0:09:11.00,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:09:11.00,0:09:13.15,Default,,0,0,0,,Қуат мүйізге арналған➡
Dialogue: 0,0:09:13.15,0:09:15.85,Default,,0,0,0,,Авангардқа сын
Dialogue: 0,0:09:15.85,0:09:19.02,Default,,0,0,0,,Сіздің жұмысыңыз адалдық➡
Dialogue: 0,0:09:19.02,0:09:22.51,Default,,0,0,0,,Бұл ана патшайым➡
Dialogue: 0,0:09:22.51,0:09:26.93,Default,,0,0,0,,Көзіңе күйіп, жүрегіңе ойып ал.
Dialogue: 0,0:09:26.93,0:09:31.02,Default,,0,0,0,,Қауіпті мүйізбен Авангардқа шабуыл жасаңыз
Dialogue: 0,0:09:31.02,0:09:33.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:35.67,0:09:37.68,Default,,0,0,0,,Камуи мырза! Зақым 5!
Dialogue: 0,0:09:37.68,0:09:40.33,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:40.33,0:09:43.18,Default,,0,0,0,,Ол соншалықты жаман емес.
Dialogue: 0,0:09:43.18,0:09:46.00,Default,,0,0,0,,Мұны істеу өте оңай, солай емес пе?
Dialogue: 0,0:09:46.00,0:09:48.00,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:09:48.00,0:09:50.17,Default,,0,0,0,,Толық қуат! Оны тастаңыз!
Dialogue: 0,0:09:50.17,0:09:52.67,Default,,0,0,0,,Барлығы болашақтан алынған!
Dialogue: 0,0:09:52.67,0:09:56.33,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:09:56.33,0:09:59.63,Default,,0,0,0,,ｳｲﾆﾝｸﾞﾁｬﾝﾌﾟﾋﾞｸﾄｰﾙ！
Dialogue: 0,0:10:02.82,0:10:04.84,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ
Dialogue: 0,0:10:04.84,0:10:07.66,Default,,0,0,0,,1 картаны сал. Қолыңыздан 1 артқы қорғаушыны тартыңыз➡
Dialogue: 0,0:10:07.66,0:10:09.97,Default,,0,0,0,,ｽﾍﾟﾘｵﾙｺｰﾙ
Dialogue: 0,0:10:09.97,0:10:12.01,Default,,0,0,0,,Жеңімпаз чемпионатқа қарай➡
Dialogue: 0,0:10:12.01,0:10:16.16,Default,,0,0,0,,Шабуыл жасағанда бір Артқы қорғаушыға тұру мүмкіндігін береді!
Dialogue: 0,0:10:16.16,0:10:20.34,Default,,0,0,0,,Дағдыны белсендіру. Голшарх стенді
Dialogue: 0,0:10:20.34,0:10:22.32,Default,,0,0,0,,Жеңіс чемпионының дағдылары
Dialogue: 0,0:10:22.32,0:10:25.51,Default,,0,0,0,,Артқы қорғаушы тұрғанда, блокқа және өзіне➡
Dialogue: 0,0:10:25.51,0:10:27.66,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ5000！
Dialogue: 0,0:10:27.66,0:10:31.31,Default,,0,0,0,,Гольшачидің шапшаңдығы! Қуат плюс 7000!
Dialogue: 0,0:10:31.31,0:10:33.50,Default,,0,0,0,,Камуи-санның 18-ші асығы!
Dialogue: 0,0:10:33.50,0:10:36.15,Default,,0,0,0,,Салданған бөлімшеге тұрыңыз!
Dialogue: 0,0:10:36.15,0:10:38.84,Default,,0,0,0,,Бұл бәрі емес, оны күшейтіңіз
Dialogue: 0,0:10:38.84,0:10:40.82,Default,,0,0,0,,Bikthead дағдылары
Dialogue: 0,0:10:40.82,0:10:42.82,Default,,0,0,0,,Bikthead to Soul
Dialogue: 0,0:10:42.82,0:10:44.99,Default,,0,0,0,,1 карта ұтысы
Dialogue: 0,0:10:44.99,0:10:47.51,Default,,0,0,0,,Buttagill үшін Пауэр Plus 2000!
Dialogue: 0,0:10:47.51,0:10:49.53,Default,,0,0,0,,Темера жоқ Хокосо➡
Dialogue: 0,0:10:49.53,0:10:52.90,Default,,0,0,0,,Біздің әлемде сіз өте жарқыраған түрде жабайы боласыз, солай емес пе?
Dialogue: 0,0:10:52.90,0:10:57.40,Default,,0,0,0,,Енді менің кезегім! Дайын болыңыз!
Dialogue: 0,0:11:00.16,0:11:03.83,Default,,0,0,0,,Толық күзет. (Камуи) Үштік жетек
Dialogue: 0,0:11:03.83,0:11:06.98,Default,,0,0,0,,Триггерді салу. Күш Гольшачиге түседі
Dialogue: 0,0:11:06.98,0:11:09.65,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ ｻｰﾄﾞﾁｪｯｸ
Dialogue: 0,0:11:09.65,0:11:11.67,Default,,0,0,0,,Буттагилл шеберлігін белсендіру
Dialogue: 0,0:11:11.67,0:11:18.06,Default,,0,0,0,,Қуаты осы құрылғының күшінен төмен бір қарсыластың алдыңғы қатардағы артқы қорғаушысын шегіндіріңіз!
Dialogue: 0,0:11:18.06,0:11:20.48,Default,,0,0,0,,Мен кішкентай шабақ сияқтымын!
Dialogue: 0,0:11:20.48,0:11:23.48,Default,,0,0,0,,Бұрын қолданған дағдымен күшімді арттырдым.
Dialogue: 0,0:11:23.48,0:11:26.67,Default,,0,0,0,,Жоғалтқаныңыз үшін кешірім сұраймын. Ку~!
Dialogue: 0,0:11:26.67,0:11:29.50,Default,,0,0,0,,Жеңіске жеткен чемпиондық генерация үшінші үзіліс
Dialogue: 0,0:11:29.50,0:11:35.50,Default,,0,0,0,,Ұрыс аяқталғаннан кейін қарсыластың ең аз күші бар артқы қорғаушыларының бірін шегіндіріңіз.
Dialogue: 0,0:11:37.60,0:11:39.48,Default,,0,0,0,,1 карта ұтысы
Dialogue: 0,0:11:39.48,0:11:41.50,Default,,0,0,0,,Баттагилмен шабуыл!
Dialogue: 0,0:11:41.50,0:11:43.48,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:11:43.48,0:11:45.49,Default,,0,0,0,,Голшотпен шабуыл!
Dialogue: 0,0:11:45.49,0:11:47.51,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:11:47.51,0:11:51.83,Default,,0,0,0,,Буттагилмен бірге тұру. Rush арқылы қуат плюс 5000!
Dialogue: 0,0:11:51.83,0:11:54.68,Default,,0,0,0,,Чемпиондық шеберліктерін тағы да жеңу!
Dialogue: 0,0:11:54.68,0:11:57.20,Default,,0,0,0,,Мен ол патшайым ба, әлде елші ме➡ білмеймін
Dialogue: 0,0:11:57.20,0:12:00.24,Default,,0,0,0,,Мен саған ұнайтын нәрсені істеуге рұқсат бермеймін!
Dialogue: 0,0:12:00.24,0:12:04.34,Default,,0,0,0,,Авангардқа Голчарчпен шабуыл жасаңыз!
Dialogue: 0,0:12:04.34,0:12:07.64,Default,,0,0,0,,Баттагиллмен қауіпті мүйізге шабуыл жасаңыз!
Dialogue: 0,0:12:07.64,0:12:09.98,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ
Dialogue: 0,0:12:09.98,0:12:12.35,Default,,0,0,0,,Қанатты қабырға құбыжығы Құдай Морфосиан
Dialogue: 0,0:12:12.35,0:12:15.45,Default,,0,0,0,,Дағды плюс 10000
Dialogue: 0,0:12:18.20,0:12:20.76,Default,,0,0,0,,Ол келмеді ме?
Dialogue: 0,0:12:20.76,0:12:23.16,Default,,0,0,0,,Көретін жер көп емес пе?
Dialogue: 0,0:12:23.16,0:12:26.49,Default,,0,0,0,,Мегалониялық жауынгер сияқты жақсы
Dialogue: 0,0:12:26.49,0:12:28.51,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:12:28.51,0:12:31.07,Default,,0,0,0,,Бірақ сол мақтаншақ жауынгерлер де➡
Dialogue: 0,0:12:31.07,0:12:34.17,Default,,0,0,0,,Қаздар тірілсе, өледі.
Dialogue: 0,0:12:34.17,0:12:37.01,Default,,0,0,0,,Ол таяз.
Dialogue: 0,0:12:37.01,0:12:40.41,Default,,0,0,0,,Ей, көмектес! Оның алдыңғы тістерін жұлып ал—мен оларды тіс дәрігеріне апарамын!
Dialogue: 0,0:12:45.66,0:12:48.17,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:48.17,0:12:50.17,Default,,0,0,0,,Крей планетасы?
Dialogue: 0,0:12:50.17,0:12:52.37,Default,,0,0,0,,Міне
Dialogue: 0,0:12:54.34,0:12:59.21,Default,,0,0,0,,Бұл таңқаларлық. Мега колония сол орманның тереңінде.
Dialogue: 0,0:12:59.21,0:13:04.27,Default,,0,0,0,,Сабанды балалар ойнауға тым кішкентай.
Dialogue: 0,0:13:04.27,0:13:07.99,Default,,0,0,0,,Мықты балаларды тәрбиелеу үшін неғұрлым кең болса, соғұрлым жақсы.
Dialogue: 0,0:13:07.99,0:13:13.93,Default,,0,0,0,,Иә, мен мына жерден мына жерге дейін барлығын қалаймын.
Dialogue: 0,0:13:13.93,0:13:20.15,Default,,0,0,0,,Ол үшін біз оларды бір рет жойып, бір етіп жасауымыз керек.
Dialogue: 0,0:13:20.15,0:13:22.13,Default,,0,0,0,,Сондықтан мен шештім
Dialogue: 0,0:13:22.13,0:13:24.82,Default,,0,0,0,,Қаздар әкелген қирау және қирау
Dialogue: 0,0:13:24.82,0:13:28.97,Default,,0,0,0,,Осыдан кейін болатын жаңа жаратылыс әлемі➡
Dialogue: 0,0:13:28.97,0:13:32.84,Default,,0,0,0,,Мына сабан адам мені басқарады
Dialogue: 0,0:13:32.84,0:13:36.90,Default,,0,0,0,,Варава осы уақытқа дейін көп бала туды.
Dialogue: 0,0:13:36.90,0:13:40.49,Default,,0,0,0,,Әрі қарай, сол балалардың өмір сүруі үшін кең әлем жасаңыз➡
Dialogue: 0,0:13:40.49,0:13:44.17,Default,,0,0,0,,Оның үстіне барлық балалар қайтадан сонда туады.
Dialogue: 0,0:13:44.17,0:13:48.09,Default,,0,0,0,,Сол кезде мен Мегаколония жауынгері боламын➡
Dialogue: 0,0:13:48.09,0:13:52.48,Default,,0,0,0,,Саман балалары бүкіл ғаламды жаулап алады.
Dialogue: 0,0:13:52.48,0:13:55.67,Default,,0,0,0,,Тіпті Гастель мен Қаздар➡
Dialogue: 0,0:13:55.67,0:13:58.65,Default,,0,0,0,,Бұл тек осы мақсатқа арналған үстіңгі бөлік.
Dialogue: 0,0:13:58.65,0:14:03.15,Default,,0,0,0,,Қалай болғанда да, Катсура да солай ойлайтынына сенімдімін.
Dialogue: 0,0:14:06.33,0:14:08.83,Default,,0,0,0,,ﾊｧ ﾊｧ…
Dialogue: 0,0:14:08.83,0:14:11.50,Default,,0,0,0,,Мұны неге маған көрсеттің?
Dialogue: 0,0:14:11.50,0:14:13.84,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:14:13.84,0:14:18.84,Default,,0,0,0,,Менің күйеуім бол  Вуд Камуи
Dialogue: 0,0:15:59.89,0:16:04.66,Default,,0,0,0,,Менің күйеуім бол  Вуд Камуи
Dialogue: 0,0:16:04.66,0:16:07.35,Default,,0,0,0,,Бұл не?! (2 адам) Әй!
Dialogue: 0,0:16:07.35,0:16:09.82,Default,,0,0,0,,Біртүрлі болса да, маған ұнайды.
Dialogue: 0,0:16:09.82,0:16:11.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:11.85,0:16:14.26,Default,,0,0,0,,Мен сені өзіме серік еткім келеді.
Dialogue: 0,0:16:14.26,0:16:18.68,Default,,0,0,0,,Мен сені жеп, жаңа әлемде өмір сүретін бала жасаймын.
Dialogue: 0,0:16:18.68,0:16:21.85,Default,,0,0,0,,Баламыз мықты болсын
Dialogue: 0,0:16:21.85,0:16:24.52,Default,,0,0,0,,Жаман оқиға емес.
Dialogue: 0,0:16:24.52,0:16:29.90,Default,,0,0,0,,Жаңа әлемнің негізін қалаушы, сіз барлық нәрсенің әкесі бола аласыз.
Dialogue: 0,0:16:29.90,0:16:33.34,Default,,0,0,0,,Бас тартыңыз! Жиренішті әзілдерді доғар!
Dialogue: 0,0:16:33.34,0:16:35.68,Default,,0,0,0,,Мен, 4-ші ақымақ!
Dialogue: 0,0:16:35.68,0:16:37.70,Default,,0,0,0,,Сіз енді➡
Dialogue: 0,0:16:37.70,0:16:40.73,Default,,0,0,0,,Мен барлық Мегалония жауынгерлерін жау еттім!
Dialogue: 0,0:16:40.73,0:16:44.85,Default,,0,0,0,,Алданбаңыз! Менің жалғыз құдайым бар!
Dialogue: 0,0:16:44.85,0:16:46.85,Default,,0,0,0,,Не~!
Dialogue: 0,0:16:46.85,0:16:50.66,Default,,0,0,0,,Жарайды, біз мөлшермен ойнауымыз керек.
Dialogue: 0,0:16:50.66,0:16:53.34,Default,,0,0,0,,Гредора дағдылары
Dialogue: 0,0:16:53.34,0:16:58.23,Default,,0,0,0,,Зақымдалған аймақта бір картаны бетін жоғары қаратып қойыңыз.
Dialogue: 0,0:16:58.23,0:17:00.77,Default,,0,0,0,,Бұл қарсы заряд
Dialogue: 0,0:17:00.77,0:17:03.99,Default,,0,0,0,,ﾁｯ
Dialogue: 0,0:17:03.99,0:17:06.99,Default,,0,0,0,,Камуидің қарсы жарылысын сіңірді
Dialogue: 0,0:17:06.99,0:17:08.99,Default,,0,0,0,,Бұл жаман. Келіп жатыр.
Dialogue: 0,0:17:08.99,0:17:12.16,Default,,0,0,0,,Vanguard ➡ құнымен бірдей
Dialogue: 0,0:17:12.16,0:17:14.85,Default,,0,0,0,,Мен өз болашағыма бәс тігемін➡
Dialogue: 0,0:17:14.85,0:17:18.50,Default,,0,0,0,,Мақтаншақ жауынгерге соңғы демалыс!
Dialogue: 0,0:17:18.50,0:17:22.02,Default,,0,0,0,,Осы жекпе-жектен жеңілсем➡
Dialogue: 0,0:17:22.02,0:17:26.02,Default,,0,0,0,,Generation Zone картасы ешқашан қайтарылмайды.
Dialogue: 0,0:17:28.93,0:17:32.15,Default,,0,0,0,,Менің болашағымды жеп, оны көрсет!
Dialogue: 0,0:17:32.15,0:17:34.65,Default,,0,0,0,,Zu's Zero Dragon!
Dialogue: 0,0:17:34.65,0:17:37.59,Default,,0,0,0,,ｱﾙﾃｨﾒｯﾄ･ｽﾄﾗｲﾄﾞ！
Dialogue: 0,0:17:37.59,0:17:49.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:49.52,0:17:54.66,Default,,0,0,0,,Өлім бағы нөлдік айдаһар қалықтайды!
Dialogue: 0,0:17:54.66,0:17:58.34,Default,,0,0,0,,Бұл нөлдік айдаһар...
Dialogue: 0,0:17:58.34,0:18:01.33,Default,,0,0,0,,Соаның шеберлігі. 1 карта ұтысы
Dialogue: 0,0:18:01.33,0:18:03.35,Default,,0,0,0,,ｽﾍﾟﾘｵﾙｺｰﾙ
Dialogue: 0,0:18:03.35,0:18:06.53,Default,,0,0,0,,Бұл бірлік ешқандай әсер арқылы таңдалмаған➡
Dialogue: 0,0:18:06.53,0:18:08.50,Default,,0,0,0,,Сонымен қатар, бұл бірлік ➡
Dialogue: 0,0:18:08.50,0:18:11.94,Default,,0,0,0,,Авангардыңызға зақым келтіргенде...
Dialogue: 0,0:18:11.94,0:18:16.03,Default,,0,0,0,,Сіз жеңіліске ұшырайсыз. Не!?
Dialogue: 0,0:18:16.03,0:18:18.01,Default,,0,0,0,,ｺｰﾙ
Dialogue: 0,0:18:18.01,0:18:23.07,Default,,0,0,0,,Қара бет Құдіретіңді еске салайын.
Dialogue: 0,0:18:23.07,0:18:26.67,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:18:26.67,0:18:29.51,Default,,0,0,0,,Тәкаппар бол, қыңыр!
Dialogue: 0,0:18:29.51,0:18:34.01,Default,,0,0,0,,Мәртебелі қолында өлу құрметі!
Dialogue: 0,0:18:34.01,0:18:38.53,Default,,0,0,0,,Мен мәйітті алып кетемін.
Dialogue: 0,0:18:38.53,0:18:44.06,Default,,0,0,0,,Барлығы жойылып, Вараваның бақылауында болатын жаңа әлемде➡
Dialogue: 0,0:18:44.06,0:18:48.76,Default,,0,0,0,,Сіз Мегалонияның соңғы жауынгері ретінде қайта туылыңыз.
Dialogue: 0,0:18:51.33,0:18:53.33,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ
Dialogue: 0,0:18:53.33,0:18:56.22,Default,,0,0,0,,ﾒﾃｵｶｲｻﾞｰﾄﾞｶﾞﾝﾃｨﾀﾝ！
Dialogue: 0,0:18:56.22,0:18:58.85,Default,,0,0,0,,Қалқан плюс шеберлікпен 10 000!
Dialogue: 0,0:18:58.85,0:19:00.85,Default,,0,0,0,,Одан да сақ болыңыз!
Dialogue: 0,0:19:05.36,0:19:07.43,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:19:07.43,0:19:11.50,Default,,0,0,0,,Критикалық триггер. Барлық әсерлер терең мүйізге түседі.
Dialogue: 0,0:19:11.50,0:19:13.52,Default,,0,0,0,,ﾄﾞﾛｰﾄﾘｶﾞｰ
Dialogue: 0,0:19:13.52,0:19:16.55,Default,,0,0,0,,Қуат мүйізге түседі
Dialogue: 0,0:19:16.55,0:19:19.95,Default,,0,0,0,,1 картаны сал, міне, осы.
Dialogue: 0,0:19:21.84,0:19:26.00,Default,,0,0,0,,ｶﾞｰﾄﾞ ｲﾝﾀｰｾﾌﾟﾄ！
Dialogue: 0,0:19:26.00,0:19:28.52,Default,,0,0,0,,Тоқтатылды! (Қара жүз) Мәртебелі!?
Dialogue: 0,0:19:28.52,0:19:31.67,Default,,0,0,0,,Нөлдік айдаһар!?
Dialogue: 0,0:19:31.67,0:19:34.17,Default,,0,0,0,,Сіз Zero Dragon-ды жеңдіңіз бе?
Dialogue: 0,0:19:34.17,0:19:38.66,Default,,0,0,0,,Бірақ біз бұл патшайымды әлі жіберген жоқпыз.
Dialogue: 0,0:19:38.66,0:19:40.66,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:19:40.66,0:19:43.50,Default,,0,0,0,,Патшайым күткендей, сен мықтысың.
Dialogue: 0,0:19:43.50,0:19:47.50,Default,,0,0,0,,Бірақ мен де ұтыла алмаймын.
Dialogue: 0,0:19:47.50,0:19:50.39,Default,,0,0,0,,Бұл дүниеде менің достарым бар.
Dialogue: 0,0:19:50.39,0:19:54.18,Default,,0,0,0,,Мен Авангардты жақсы көремін, бос уақытым болса, онымен күресемін➡
Dialogue: 0,0:19:54.18,0:19:56.51,Default,,0,0,0,,Төбелесу және ақымақтық жасау
Dialogue: 0,0:19:56.51,0:19:58.53,Default,,0,0,0,,Әй, солай ма?➡
Dialogue: 0,0:19:58.53,0:20:02.83,Default,,0,0,0,,Мен оны саған жай ғана бере алмаймын!
Dialogue: 0,0:20:02.83,0:20:06.70,Default,,0,0,0,,Камуи карталарын сақтап, сол шабуылдан қорғана алды.
Dialogue: 0,0:20:06.70,0:20:10.86,Default,,0,0,0,,Гредора да осы айналымда қолын 8 картаға дейін көбейтті.
Dialogue: 0,0:20:10.86,0:20:14.85,Default,,0,0,0,,G-Zone-дан айырылсам да, осында аман қала алсам...
Dialogue: 0,0:20:14.85,0:20:18.18,Default,,0,0,0,,Иә, мен нәтижесін әлі білмеймін.
Dialogue: 0,0:20:18.18,0:20:22.67,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:20:22.67,0:20:26.59,Default,,0,0,0,,ﾌｪｲﾊﾞﾘｯﾄﾁｬﾝﾌﾟﾋﾞｸﾄｰﾙ！
Dialogue: 0,0:20:26.59,0:20:30.34,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｺｰﾙ！
Dialogue: 0,0:20:30.34,0:20:33.14,Default,,0,0,0,,Баттагилмен шабуыл!
Dialogue: 0,0:20:35.50,0:20:37.52,Default,,0,0,0,,Кішкентай шабақтарды күлдірмеңіз!
Dialogue: 0,0:20:37.52,0:20:40.87,Default,,0,0,0,,Сіз Мәртебеліге зиян тигізе алмайсыз!
Dialogue: 0,0:20:40.87,0:20:42.89,Default,,0,0,0,,ﾌﾝ
Dialogue: 0,0:20:42.89,0:20:44.93,Default,,0,0,0,,Голшотпен шабуыл
Dialogue: 0,0:20:44.93,0:20:47.34,Default,,0,0,0,,Stand Buttagill шеберлігін белсендіру
Dialogue: 0,0:20:47.34,0:20:51.00,Default,,0,0,0,,Dog Mechanic көмегімен күшейтіңіз!
Dialogue: 0,0:20:51.00,0:20:53.02,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:20:53.02,0:20:55.69,Default,,0,0,0,,Баттагиллмен тағы да шабуыл жасаңыз!
Dialogue: 0,0:20:55.69,0:20:57.89,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ
Dialogue: 0,0:20:59.84,0:21:03.51,Default,,0,0,0,,Не болды? Мен мұның соншалықты жаман екеніне сене алмаймын.
Dialogue: 0,0:21:03.51,0:21:08.52,Default,,0,0,0,,Енді нақты әрекет келеді. Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:21:08.52,0:21:10.52,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:21:13.82,0:21:16.36,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:21:16.36,0:21:18.33,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ
Dialogue: 0,0:21:18.33,0:21:21.75,Default,,0,0,0,,Триггерді салу. Қуат талшықтар шамында.
Dialogue: 0,0:21:21.75,0:21:24.01,Default,,0,0,0,,1 карта ұтысы
Dialogue: 0,0:21:24.01,0:21:26.33,Default,,0,0,0,,Иә, зиян 5!
Dialogue: 0,0:21:26.33,0:21:28.35,Default,,0,0,0,,Сүйікті дағдылар
Dialogue: 0,0:21:28.35,0:21:30.52,Default,,0,0,0,,Қолыңыздан бір картаны тастаңыз
Dialogue: 0,0:21:30.52,0:21:35.18,Default,,0,0,0,,G аймағының үстелінде қанша жеңген болса, сонша тыл сақшысын тұрыңыз.
Dialogue: 0,0:21:35.18,0:21:38.50,Default,,0,0,0,,Golschachi's Rush Пауэр Plus 7000!
Dialogue: 0,0:21:38.50,0:21:42.67,Default,,0,0,0,,Buttagil's Rush Пауэр Plus 5000!
Dialogue: 0,0:21:42.67,0:21:46.67,Default,,0,0,0,,Сонымен қатар, қолыңыздан 3 картаны тастап, Таңдаулы➡ күйінде тұрыңыз
Dialogue: 0,0:21:46.67,0:21:48.69,Default,,0,0,0,,ﾄﾞﾗｲﾌﾞﾏｲﾅｽ２！
Dialogue: 0,0:21:48.69,0:21:51.89,Default,,0,0,0,,Баттагилмен шабуыл! (Гредора) Күзетші
Dialogue: 0,0:21:54.50,0:21:56.50,Default,,0,0,0,,Голшотпен шабуыл!
Dialogue: 0,0:21:56.50,0:21:58.50,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:22:02.65,0:22:05.66,Default,,0,0,0,,Жақсы! Бұл Камуи-санның жеңісі!
Dialogue: 0,0:22:05.66,0:22:08.66,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:22:08.66,0:22:14.33,Default,,0,0,0,,Зақымдану 1 қалпына келтіру қуаты және Vanguard үшін 5000
Dialogue: 0,0:22:14.33,0:22:19.32,Default,,0,0,0,,Королева ретінде мен оңайлықпен беріле алмаймын.
Dialogue: 0,0:22:19.32,0:22:21.34,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:22:21.34,0:22:23.32,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:22:23.32,0:22:26.16,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:22:26.16,0:22:28.16,Default,,0,0,0,,Не!?
Dialogue: 0,0:22:28.16,0:22:31.33,Default,,0,0,0,,Мәртебелі, менің сүйікті ханшайымымды жеңе аламын деп ойладың ба?
Dialogue: 0,0:22:31.33,0:22:33.50,Default,,0,0,0,,Адам фузе... (Камуи) Әлі жоқ!
Dialogue: 0,0:22:33.50,0:22:35.50,Default,,0,0,0,,Мен жеңген адаммын!
Dialogue: 0,0:22:38.36,0:22:40.37,Default,,0,0,0,,ﾄﾞﾛｰﾄﾘｶﾞｰ！
Dialogue: 0,0:22:40.37,0:22:43.97,Default,,0,0,0,,Қуат Фейваритте. 1 карта ұтысы
Dialogue: 0,0:22:45.98,0:22:48.00,Default,,0,0,0,,Мен оны тарттым!
Dialogue: 0,0:22:48.00,0:22:50.03,Default,,0,0,0,,Қазір Камуи мырзаның қолында 4 карта бар!
Dialogue: 0,0:22:50.03,0:22:52.59,Default,,0,0,0,,Сүйікті дағдыларды тағы бір рет қабылдаңыз!
Dialogue: 0,0:22:52.59,0:22:56.17,Default,,0,0,0,,3 Тыл сақшылары мен Сүйікті де тұр!
Dialogue: 0,0:22:56.17,0:22:58.99,Default,,0,0,0,,Қарсылас қанша күшті болса да➡
Dialogue: 0,0:22:58.99,0:23:03.85,Default,,0,0,0,,Орныңыздан тұрып, қалағаныңызша күресіңіз! Мен сайын күшейемін!
Dialogue: 0,0:23:03.85,0:23:07.17,Default,,0,0,0,,Бұл менің Авангардым!
Dialogue: 0,0:23:07.17,0:23:10.49,Default,,0,0,0,,Камуи мырза! Ілгері жүру!
Dialogue: 0,0:23:10.49,0:23:13.89,Default,,0,0,0,,Кел, кел!
Dialogue: 0,0:23:17.83,0:23:21.83,Default,,0,0,0,,Өртен! Hachamecha әрекеті!
Dialogue: 0,0:23:21.83,0:23:25.93,Default,,0,0,0,,ｲﾝﾌｨﾆｯﾄｽﾗｯｼｭﾗｯｼｭ！
Dialogue: 0,0:23:33.18,0:23:36.03,Default,,0,0,0,,Иә! Камуи жеңді!
Dialogue: 0,0:23:36.03,0:23:39.93,Default,,0,0,0,,Нөлдік айдаһар және Мегалония ханшайымы бол!
Dialogue: 0,0:23:42.32,0:23:44.66,Default,,0,0,0,,Бұл өте қызықты шоу болды.
Dialogue: 0,0:23:44.66,0:23:47.34,Default,,0,0,0,,Менің толқығаныма көп болды.
Dialogue: 0,0:23:47.34,0:23:49.51,Default,,0,0,0,,Мәртебелі, сақ болыңыз!
Dialogue: 0,0:23:49.51,0:23:52.91,Default,,0,0,0,,Қара бет, сен тыныштал.
Dialogue: 0,0:23:55.17,0:23:57.52,Default,,0,0,0,,G аймағын жоғалту ➡ дегенді білдіреді
Dialogue: 0,0:23:57.52,0:24:03.61,Default,,0,0,0,,Бізді осы дүниемен байланыстыратын тағдырдың құдіреті үзілгенде де солай болады.
Dialogue: 0,0:24:03.61,0:24:08.85,Default,,0,0,0,,Маған бәрібір. Мен бұл дүниедегі рөлімді орындадым.
Dialogue: 0,0:24:08.85,0:24:10.85,Default,,0,0,0,,Рөл?
Dialogue: 0,0:24:10.85,0:24:14.27,Default,,0,0,0,,Ах...｡ (Гредора) Қара бет
Dialogue: 0,0:24:14.27,0:24:17.02,Default,,0,0,0,,Міне!
Dialogue: 0,0:24:17.02,0:24:19.87,Default,,0,0,0,,Бұл жерде бұдан әрі қалуға ешқандай себеп жоқ.
Dialogue: 0,0:24:19.87,0:24:22.18,Default,,0,0,0,,Біздің планетамызға оралу➡
Dialogue: 0,0:24:22.18,0:24:27.18,Default,,0,0,0,,Тым болмаса дүниенің рахатын көрейік.
Dialogue: 0,0:24:27.18,0:24:29.48,Default,,0,0,0,,Қалғанын сұрадым.
Dialogue: 0,0:24:33.49,0:24:36.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:24:36.66,0:24:39.49,Default,,0,0,0,,Ах! (Камминг) Эй, күте тұрыңыз!
Dialogue: 0,0:24:39.49,0:24:43.03,Default,,0,0,0,,Цк, картаңызды өзіңізбен бірге алдыңыз ба?
Dialogue: 0,0:24:43.03,0:24:45.03,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:24:49.17,0:24:54.33,Default,,0,0,0,,Жарайды, мен жай ғана ес-түссіз жатырмын. Хаа~
Dialogue: 0,0:24:54.33,0:24:56.51,Default,,0,0,0,,Камуи мырза! Жарайды?
Dialogue: 0,0:24:56.51,0:25:00.00,Default,,0,0,0,,Күрсін, мен шаршадым.
Dialogue: 0,0:25:00.00,0:25:03.17,Default,,0,0,0,,Сіз осы уақытқа дейін өте жақсы болдыңыз
Dialogue: 0,0:25:03.17,0:25:05.82,Default,,0,0,0,,Камуи мырза, тұрғыңыз келе ме?
Dialogue: 0,0:25:05.82,0:25:08.84,Default,,0,0,0,,Қанша рет болса да мені шула...
Dialogue: 0,0:25:08.84,0:25:12.19,Default,,0,0,0,,Маған біраз демалуға рұқсат етіңіз.
Dialogue: 0,0:25:12.19,0:25:16.19,Default,,0,0,0,,Осы арқылы мен бір елшіні Крей планетасына қайтара алдым.
Dialogue: 0,0:25:18.25,0:25:21.50,Default,,0,0,0,,Күте тұрыңыз, Нұх.
Dialogue: 0,0:25:21.50,0:25:25.49,Default,,0,0,0,,Кешірім мырза, кешірім мырза! Тек сендер!
Dialogue: 0,0:25:25.49,0:25:29.84,Default,,0,0,0,,4-топ Менің тамаша тұзақпен➡
Dialogue: 0,0:25:29.84,0:25:33.18,Default,,0,0,0,,Бұл сізді тозақпен өмір сүруге мәжбүр етеді!
Dialogue: 0,0:25:33.18,0:25:35.48,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:25:44.51,0:25:47.68,Default,,0,0,0,,Босатыңыз! Менің денем менікі!
Dialogue: 0,0:25:47.68,0:25:51.17,Default,,0,0,0,,Бұл жақсы нәрсе
Dialogue: 0,0:25:51.17,0:25:53.18,Default,,0,0,0,,Бірақ ақыры шаршаймын➡
Dialogue: 0,0:25:53.18,0:25:56.60,Default,,0,0,0,,Қанша тырыссам да, үмітім үзілді.
Dialogue: 0,0:25:56.60,0:26:01.01,Default,,0,0,0,,Мен сол кезді асыға күтемін.
Dialogue: 0,0:26:01.01,0:26:03.86,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:26:03.86,0:26:06.51,Default,,0,0,0,,Өйткені біз кездестік. Арата мен Макотоға
Dialogue: 0,0:26:06.51,0:26:10.02,Default,,0,0,0,,Екеуі туралы ойласам, кенеттен осындай сезім пайда болады.
Dialogue: 0,0:26:10.02,0:26:13.02,Default,,0,0,0,,Сіз түсінбейтін шығарсыз, бірақ
Dialogue: 0,0:26:15.02,0:26:18.84,Default,,0,0,0,,Сол үміт үзілді, саған бергенім.
Dialogue: 0,0:26:18.84,0:26:23.73,Default,,0,0,0,,Үмітке берік болған сайын, үмітсіздік тереңдей түседі.
Dialogue: 0,0:26:23.73,0:26:26.33,Default,,0,0,0,,Қаттырақ ұмтылып, қарсы тұр.
Dialogue: 0,0:26:26.33,0:26:30.82,Default,,0,0,0,,Сонда біз тағы кездесерміз.
Dialogue: 0,0:26:30.82,0:26:35.82,Default,,0,0,0,,Достарыңмен. иә!
Dialogue: 0,0:30:33.85,0:30:37.83,Default,,0,0,0,,Канон ойнайтын драманың түсірілімі басталды
Dialogue: 0,0:30:37.83,0:30:40.24,Default,,0,0,0,,Бірге түскен актриса➡
Dialogue: 0,0:30:40.24,0:30:42.32,Default,,0,0,0,,Сен Юки-санға ұқсайсың.
Dialogue: 0,0:30:42.32,0:30:45.84,Default,,0,0,0,,Бұл қиын! Сол актриса...
Dialogue: 0,0:30:45.84,0:30:49.16,Default,,0,0,0,,Бұл теріс қатеге айналды.
Dialogue: 0,0:30:49.16,0:30:53.83,Default,,0,0,0,,Біз бесеуміз күш біріктіріп, соңғы режимге келеміз.
Dialogue: 0,0:30:53.83,0:30:56.15,Default,,0,0,0,,Ғажайып әуендер!
Dialogue: 0,0:30:56.15,0:30:58.15,Default,,0,0,0,,ﾚｯﾂ ﾐﾗｸﾙ！
Dialogue: 0,0:30:59.65,0:31:05.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory