Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:05.07,0:01:07.13,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:01:07.13,0:01:12.20,Default,,0,0,0,,Gear Chronic бірегейлігі, Shindou Chrono ыдыс ретінде➡
Dialogue: 0,0:01:12.20,0:01:15.52,Default,,0,0,0,,Қаз-сама осы жерге түссін.
Dialogue: 0,0:01:15.52,0:01:18.87,Default,,0,0,0,,Кек алатын кез келді!
Dialogue: 0,0:01:18.87,0:01:24.53,Default,,0,0,0,,Мен Q4 тобын жек көретіндерді жылатамын және кешірім сұраймын!
Dialogue: 0,0:01:24.53,0:01:27.01,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:01:27.01,0:01:29.18,Default,,0,0,0,,Бұл олардың мазасын алады➡
Dialogue: 0,0:01:29.18,0:01:32.69,Default,,0,0,0,,Сол мүмкіндікті пайдаланып, біздің қолымызда ерекшелік болады...!
Dialogue: 0,0:01:32.69,0:01:36.01,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:01:36.01,0:01:39.19,Default,,0,0,0,,Одан да қызықты әдіс бар емес пе?
Dialogue: 0,0:01:39.19,0:01:44.18,Default,,0,0,0,,Мысалы, Синдо Куроно алдымызға өзі келеді➡
Dialogue: 0,0:01:44.18,0:01:49.08,Default,,0,0,0,,Менің шығудан басқа амалым жоқ сияқты...
Dialogue: 0,0:05:02.03,0:05:04.53,Default,,0,0,0,,Бірнеше күн бұрын жаһандық ауқымда➡
Dialogue: 0,0:05:04.53,0:05:08.43,Default,,0,0,0,,Елшілерге қатысты ақпараттың көп мөлшері хабарланды.
Dialogue: 0,0:05:08.43,0:05:12.02,Default,,0,0,0,,Негізгі орын және көру туралы ақпарат➡
Dialogue: 0,0:05:12.02,0:05:15.19,Default,,0,0,0,,Мазмұны кең ауқымды, оның ішінде мінез-құлық маршруттары.
Dialogue: 0,0:05:15.19,0:05:18.68,Default,,0,0,0,,Қазіргі уақытта оның түпнұсқалығын растау үшін әртүрлі жерлерде➡
Dialogue: 0,0:05:18.68,0:05:20.66,Default,,0,0,0,,Мен көшуіңізді сұраймын...
Dialogue: 0,0:05:20.66,0:05:23.03,Default,,0,0,0,,Диверсиялық операция болуы мүмкін.
Dialogue: 0,0:05:23.03,0:05:27.02,Default,,0,0,0,,Осыны қысқаша айтайық...
Dialogue: 0,0:05:27.02,0:05:30.02,Default,,0,0,0,,Сізге көздеу
Dialogue: 0,0:05:30.02,0:05:33.96,Default,,0,0,0,,Мен бұл туралы қазір ештеңе білмеймін, бірақ ол кезде➡
Dialogue: 0,0:05:33.96,0:05:36.26,Default,,0,0,0,,Ол пайда болды.
Dialogue: 0,0:05:41.35,0:05:43.52,Default,,0,0,0,,Біз де көрдік
Dialogue: 0,0:05:43.52,0:05:45.85,Default,,0,0,0,,Тіпті Гастиленің сөзінен➡
Dialogue: 0,0:05:45.85,0:05:48.91,Default,,0,0,0,,Елшілер сені Қаздарға арналған ыдыс ретінде қабылдайды➡
Dialogue: 0,0:05:48.91,0:05:52.51,Default,,0,0,0,,Сіз қол жеткізгіңіз келетін нәрседе ешқандай қате жоқ.
Dialogue: 0,0:05:52.51,0:05:56.37,Default,,0,0,0,,Бірақ керісінше, мен сені қорғасам да➡
Dialogue: 0,0:05:56.37,0:06:01.84,Default,,0,0,0,,Егер біз қалған үш елшіні Крей планетасына қайтара алсақ➡
Dialogue: 0,0:06:01.84,0:06:04.52,Default,,0,0,0,,Бұл жағдай аяқталды.
Dialogue: 0,0:06:04.52,0:06:08.18,Default,,0,0,0,,Біз жасай алатын бірдеңе бар ма?
Dialogue: 0,0:06:08.18,0:06:12.33,Default,,0,0,0,,Тіпті мен жай ғана қорғана алмаймын!
Dialogue: 0,0:06:12.33,0:06:14.37,Default,,0,0,0,,Сабыр ет!
Dialogue: 0,0:06:14.37,0:06:18.54,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін, бірақ мұны бізге қалдырыңыз.
Dialogue: 0,0:06:18.54,0:06:22.04,Default,,0,0,0,,Жаудың нысанасы сен, Куроно-кун.
Dialogue: 0,0:06:24.04,0:06:28.64,Default,,0,0,0,,Жарайды! Жақында бәрін бітіретініме сенімдімін.
Dialogue: 0,0:06:40.69,0:06:43.01,Default,,0,0,0,,Оның оққағары ретінде еріп жүрмесеңіз➡
Dialogue: 0,0:06:43.01,0:06:45.03,Default,,0,0,0,,Бұл қауіпсіз.
Dialogue: 0,0:06:45.03,0:06:48.02,Default,,0,0,0,,Мен Синдо-кунға қарыздармын.
Dialogue: 0,0:06:48.02,0:06:51.32,Default,,0,0,0,,Мен қаздардың қайтып келуіне ешқашан жол бермеймін.
Dialogue: 0,0:06:55.51,0:06:58.18,Default,,0,0,0,,Мұның бәрі оның арқасында.
Dialogue: 0,0:06:58.18,0:07:00.85,Default,,0,0,0,,Мен қайтадан Vanguard ойнай бастадым➡
Dialogue: 0,0:07:00.85,0:07:04.70,Default,,0,0,0,,Бұл маған ешқашан берілмейтін сезімді қалпына келтіруге де көмектесті➡
Dialogue: 0,0:07:04.70,0:07:09.29,Default,,0,0,0,,Мен сені құтқара алған себебім, ол сонда болды.
Dialogue: 0,0:07:09.29,0:07:13.34,Default,,0,0,0,,Бірақ мен оған әлі ештеңе қайтара алмадым.
Dialogue: 0,0:07:13.34,0:07:16.70,Default,,0,0,0,,Касума...｡ (Касума) Неге ол жігіт➡
Dialogue: 0,0:07:16.70,0:07:19.20,Default,,0,0,0,,Қаз сауытына ұқсас нәрсе!
Dialogue: 0,0:07:19.20,0:07:23.20,Default,,0,0,0,,Мен әрқашан сенің достарыңды қорғаймын.
Dialogue: 0,0:07:25.34,0:07:29.01,Default,,0,0,0,,Сенің жақсы достарың бар, Казума.
Dialogue: 0,0:07:29.01,0:07:31.01,Default,,0,0,0,,Е...
Dialogue: 0,0:07:39.03,0:07:43.02,Default,,0,0,0,,Қош келдіңіз! О? (есіктің ашылған дыбысы)
Dialogue: 0,0:07:43.02,0:07:45.69,Default,,0,0,0,,Менің күзетшім шынымен сен бе?
Dialogue: 0,0:07:45.69,0:07:49.34,Default,,0,0,0,,Мен емес, күзетші осында.
Dialogue: 0,0:07:49.34,0:07:51.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:51.33,0:07:54.35,Default,,0,0,0,,Касуми Онимару…
Dialogue: 0,0:07:54.35,0:07:56.50,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:07:56.50,0:07:58.69,Default,,0,0,0,,Бұл Касуми Онимару емес пе?
Dialogue: 0,0:07:58.69,0:08:02.52,Default,,0,0,0,,Шынайы ма? Неге мұндасың!? Керемет!
Dialogue: 0,0:08:02.52,0:08:04.69,Default,,0,0,0,,≪Сол жекпе-жекті сұрай аламын ба?
Dialogue: 0,0:08:04.69,0:08:06.70,Default,,0,0,0,,≪Ей, сен жасырынсың!
Dialogue: 0,0:08:06.70,0:08:08.86,Default,,0,0,0,,≪Менімен күресіңізші!
Dialogue: 0,0:08:08.86,0:08:12.52,Default,,0,0,0,,А-а, сонда мені қорғауға келдің бе?➡
Dialogue: 0,0:08:12.52,0:08:14.52,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:08:14.52,0:08:19.91,Default,,0,0,0,,Бұл қиындап барады, бірақ сізге шыдамдылық қажет.
Dialogue: 0,0:08:19.91,0:08:23.68,Default,,0,0,0,,Елшілердің бәрі жоғалып кетсе, болды.
Dialogue: 0,0:08:23.68,0:08:26.37,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:08:26.37,0:08:29.69,Default,,0,0,0,,Мен тез арада төбелескім келеді.
Dialogue: 0,0:08:29.69,0:08:33.84,Default,,0,0,0,,Ешқандай қажетсіз ойларсыз басыңызды босатыңыз.
Dialogue: 0,0:08:33.84,0:08:38.18,Default,,0,0,0,,Олай болса мен жеңемін.
Dialogue: 0,0:08:38.18,0:08:40.58,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:44.18,0:08:47.10,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,0:08:47.10,0:08:54.01,Default,,0,0,0,,Біз Реликтерде бірге болдық, сонда неге Куроно-сан жалғыз болды...
Dialogue: 0,0:08:54.01,0:08:59.20,Default,,0,0,0,,Тағы бірдеңе бар ма? Біз не істей аламыз
Dialogue: 0,0:08:59.20,0:09:03.55,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:09:03.55,0:09:07.11,Default,,0,0,0,,Мәселе мынада, біз оны жеңуіміз керек, солай ма?
Dialogue: 0,0:09:07.11,0:09:09.11,Default,,0,0,0,,Елшілер
Dialogue: 0,0:09:11.51,0:09:14.18,Default,,0,0,0,,Ол жігіт Синдомен бірге.
Dialogue: 0,0:09:14.18,0:09:17.35,Default,,0,0,0,,Апостолдар да оңайлықпен қолдарына түспеуі керек.
Dialogue: 0,0:09:17.35,0:09:19.85,Default,,0,0,0,,Мені күшпен шығара алмасаң➡
Dialogue: 0,0:09:19.85,0:09:23.51,Default,,0,0,0,,Тұзақ сияқты бірдеңе орнату... немесе бір нәрсе ме?
Dialogue: 0,0:09:23.51,0:09:29.16,Default,,0,0,0,,Синдо сізді оларға өзі баруға мәжбүр етеді.
Dialogue: 0,0:09:29.16,0:09:32.16,Default,,0,0,0,,Мысалы... Иә?
Dialogue: 0,0:09:39.09,0:09:44.03,Default,,0,0,0,,《Егер мен осында қалып, қаздарға ыдыс болып кетпесем➡
Dialogue: 0,0:09:44.03,0:09:46.86,Default,,0,0,0,,Елшілердің амбицияларына қол жеткізу мүмкін емес.
Dialogue: 0,0:09:46.86,0:09:51.93,Default,,0,0,0,,Енді барлығының елшіні жеңуін күту ғана қалды.
Dialogue: 0,0:09:51.93,0:09:54.35,Default,,0,0,0,,Бірақ…》
Dialogue: 0,0:09:54.35,0:09:58.51,Default,,0,0,0,,((Гастиле: Бірақ тағдырдың бұрылысы➡
Dialogue: 0,0:09:58.51,0:10:03.86,Default,,0,0,0,,Бұл дүние біртұтас
Dialogue: 0,0:10:03.86,0:10:07.36,Default,,0,0,0,,Геакрониканың ерекшелігіне байланысты))
Dialogue: 0,0:10:09.69,0:10:12.67,Default,,0,0,0,,ｾﾞﾛｽﾄﾞﾗｺﾞﾝ…
Dialogue: 0,0:10:12.67,0:10:15.56,Default,,0,0,0,,Бұл Даркзон ба? Иә.
Dialogue: 0,0:10:15.56,0:10:21.36,Default,,0,0,0,,Мен бұл жерде қорғанған дұрыс па деп ойлаймын.
Dialogue: 0,0:10:21.36,0:10:23.68,Default,,0,0,0,,Бастапқыда бұл мен болдым➡
Dialogue: 0,0:10:23.68,0:10:26.23,Default,,0,0,0,,Мүмкін мен бір бөлік қосу керек шығар...
Dialogue: 0,0:10:26.23,0:10:31.51,Default,,0,0,0,,Тісті шежіренің даралығы...?
Dialogue: 0,0:10:31.51,0:10:36.70,Default,,0,0,0,,Ширанайдың артында қалған естеліктерінде осындай оқиғалар болған.
Dialogue: 0,0:10:36.70,0:10:40.18,Default,,0,0,0,,Касума сені қатты уайымдады.
Dialogue: 0,0:10:40.18,0:10:48.36,Default,,0,0,0,,Таййо-кун және сіздің барлық достарыңыз бірдей сезінеді.
Dialogue: 0,0:10:48.36,0:10:51.03,Default,,0,0,0,,Оны жалғыз алып жүруге тырыспаңыз.
Dialogue: 0,0:10:51.03,0:10:56.01,Default,,0,0,0,,Енді менің кезегім... саған көмектесемін.
Dialogue: 0,0:10:56.01,0:10:58.18,Default,,0,0,0,,Онимару мырза
Dialogue: 0,0:10:58.18,0:11:01.54,Default,,0,0,0,,Не, ол көп ұзамай ыдырап қалады.
Dialogue: 0,0:11:01.54,0:11:04.64,Default,,0,0,0,,Өйткені бұл көп адам қозғалады.
Dialogue: 0,0:11:09.09,0:11:12.01,Default,,0,0,0,,Сенің осында екеніңді білемін, шық!
Dialogue: 0,0:11:12.01,0:11:14.68,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:11:14.68,0:11:18.54,Default,,0,0,0,,Су астындағы бірінші кезеңнен бері болды ма?
Dialogue: 0,0:11:18.54,0:11:23.86,Default,,0,0,0,,Хаос бұзушы айдаһар... Дәл мен ойлағандай болды.
Dialogue: 0,0:11:23.86,0:11:26.53,Default,,0,0,0,,Сіз осындай жерде серуендейсіз бе?
Dialogue: 0,0:11:26.53,0:11:29.36,Default,,0,0,0,,Көңілді орындар көп➡
Dialogue: 0,0:11:29.36,0:11:31.68,Default,,0,0,0,,Менімен бірге келгің келе ме?
Dialogue: 0,0:11:31.68,0:11:34.34,Default,,0,0,0,,Сосын бізді кепілге алды➡
Dialogue: 0,0:11:34.34,0:11:37.17,Default,,0,0,0,,Сіз Куроно мырзаға қоңырау шалмақшысыз ба?
Dialogue: 0,0:11:37.17,0:11:39.36,Default,,0,0,0,,А... Бұл ұрыс!
Dialogue: 0,0:11:39.36,0:11:42.16,Default,,0,0,0,,Оның сізге тиісуіне жол бермеңіз!
Dialogue: 0,0:11:44.30,0:11:48.80,Default,,0,0,0,,Мен сені ұрып-соғып, Крэй планетасына жіберемін!
Dialogue: 0,0:11:52.00,0:11:54.02,Default,,0,0,0,,Қарт әже, кіріп келемін.
Dialogue: 0,0:11:54.02,0:11:59.54,Default,,0,0,0,,Жоқ... әйтеуір Касума да, Таййо да маған хабарлама жібермеді.
Dialogue: 0,0:11:59.54,0:12:03.62,Default,,0,0,0,,Бір жерде төбелесіп жатыр ма деп ойлаймын...
Dialogue: 0,0:12:03.62,0:12:05.52,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:12:05.52,0:12:07.52,Default,,0,0,0,,ﾄﾞﾗｸﾞﾊｰﾄﾙｱｰﾄﾞ！
Dialogue: 0,0:12:10.02,0:12:12.41,Default,,0,0,0,,Осы уақытқа дейін мен қалағанның бәрін орындадың.
Dialogue: 0,0:12:12.41,0:12:15.84,Default,,0,0,0,,Бірақ бұл соңы!
Dialogue: 0,0:12:15.84,0:12:19.01,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ｡ ﾂｲﾝﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:12:19.01,0:12:22.61,Default,,0,0,0,,Триггерді сызу. Күш морфезада.
Dialogue: 0,0:12:25.39,0:12:28.17,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:12:28.17,0:12:30.86,Default,,0,0,0,,Дифференциалды қозғалысты босатыңыз➡
Dialogue: 0,0:12:30.86,0:12:33.66,Default,,0,0,0,,Мен сенің маған енді ешқашан тиіспеуіңді қамтамасыз етемін!
Dialogue: 0,0:12:36.21,0:12:40.04,Default,,0,0,0,,Бұл рух қанша уақытқа созылады?
Dialogue: 0,0:12:40.04,0:12:42.34,Default,,0,0,0,,Мен сені мұқият оқытамын.
Dialogue: 0,0:12:42.34,0:12:47.14,Default,,0,0,0,,Балалар, сендер қаншалықты дәрменсізсіңдер?
Dialogue: 0,0:12:50.53,0:12:52.88,Default,,0,0,0,,Кепілге алынған ба?
Dialogue: 0,0:12:52.88,0:12:55.88,Default,,0,0,0,,Бұл оған ұнайтын трюк.
Dialogue: 0,0:12:55.88,0:13:02.21,Default,,0,0,0,,Қалай болғанда да, Жұлдыздар қақпасының нөлдік айдаһарының оянуы да қажет.
Dialogue: 0,0:13:02.21,0:13:06.21,Default,,0,0,0,,Егер сізді Zeros Dragon ұрып-соғып, үмітсіздікті білсеңіз➡
Dialogue: 0,0:13:06.21,0:13:09.11,Default,,0,0,0,,Қарсыласу ерік-жігері де жоғалады.
Dialogue: 0,0:13:11.05,0:13:13.54,Default,,0,0,0,,Дифракция бізді көп тебірентті.
Dialogue: 0,0:13:13.54,0:13:15.94,Default,,0,0,0,,Мен мұны ақыры түсіндім деп ойлаған кезде...
Dialogue: 0,0:13:15.94,0:13:18.89,Default,,0,0,0,,Қалжың емес!
Dialogue: 0,0:13:18.89,0:13:21.89,Default,,0,0,0,,Мен сендерге Синдоны ешқашан бермеймін!
Dialogue: 0,0:13:29.03,0:13:35.67,Default,,0,0,0,,(ﾉｱ)ﾗｲﾄﾞ｡ ｽﾀｰﾍﾞｲﾀﾞｰ ｶｵｽﾌﾞﾚｲｶｰ･ｸﾛｳｽﾞ｡ ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:13:35.67,0:13:39.67,Default,,0,0,0,,ﾃﾞｽｽﾀｰﾍﾞｲﾀﾞｰ ｶｵｽﾕﾆﾊﾞｰｽ･ｱﾙｻｰﾆ
Dialogue: 0,0:13:45.37,0:13:48.35,Default,,0,0,0,,ｶｵｽﾕﾆﾊﾞｰｽ･ｱﾙｻｰﾆ…
Dialogue: 0,0:13:48.35,0:13:51.51,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｿｳﾙﾁｬｰｼﾞ
Dialogue: 0,0:13:51.51,0:13:55.83,Default,,0,0,0,,Морфессаны құлыптау. Алсанидің шеберлігі
Dialogue: 0,0:13:55.83,0:13:58.50,Default,,0,0,0,,Екі артқы қорғанысты бекітіңіз.
Dialogue: 0,0:13:58.50,0:14:02.68,Default,,0,0,0,,Аа, бір ғана. Қарғыс атқыр...
Dialogue: 0,0:14:02.68,0:14:06.71,Default,,0,0,0,,Мен 2 денені құлыптай алмадым, сондықтан мен 2 картаны тарттым.
Dialogue: 0,0:14:06.71,0:14:11.71,Default,,0,0,0,,Пауэр Plus 2000 Vanguard және Heliopose Dragon үшін
Dialogue: 0,0:14:15.51,0:14:21.02,Default,,0,0,0,,Фрэнк Драко Баланың шеберлігі Палубаның ең жақсы 7 картасын қараңыз➡
Dialogue: 0,0:14:21.02,0:14:24.01,Default,,0,0,0,,Қолыңызға хаос бұзушы қарғаларды салыңыз
Dialogue: 0,0:14:24.01,0:14:27.36,Default,,0,0,0,,Нөлдік айдаһардың құны...
Dialogue: 0,0:14:27.36,0:14:33.23,Default,,0,0,0,,Heliopose Dragon шеберлік жолы келесі Endface-те ашылмайды
Dialogue: 0,0:14:33.23,0:14:37.69,Default,,0,0,0,,Сонымен қатар, Heliopose үшін қуат плюс 3000
Dialogue: 0,0:14:37.69,0:14:40.04,Default,,0,0,0,,Қосымша қоңырау
Dialogue: 0,0:14:40.04,0:14:44.08,Default,,0,0,0,,Қанша тырыссаңдар да меннен жеңілдіңдер→
Dialogue: 0,0:14:44.08,0:14:47.36,Default,,0,0,0,,Синдо Курононы ұстау үшін жем ретінде пайдаланылады
Dialogue: 0,0:14:47.36,0:14:49.70,Default,,0,0,0,,Білу жақсы
Dialogue: 0,0:14:49.70,0:14:51.73,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:14:51.73,0:14:54.40,Default,,0,0,0,,Үміттің бәрін жоятын адам
Dialogue: 0,0:14:54.40,0:14:58.69,Default,,0,0,0,,Бұл менмін. Үмітсіздік қана қалады.
Dialogue: 0,0:14:58.69,0:15:02.68,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ｡ ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:15:02.68,0:15:06.60,Default,,0,0,0,,Критикалық триггер. Біртүрлі айдаһарға қуат
Dialogue: 0,0:15:06.60,0:15:09.02,Default,,0,0,0,,Авангард үшін сыни
Dialogue: 0,0:15:09.02,0:15:13.69,Default,,0,0,0,,Емдеу триггері. Күш біртүрлі айдаһарға түседі.
Dialogue: 0,0:15:13.69,0:15:16.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:16.36,0:15:19.68,Default,,0,0,0,,Біртүрлі айдаһармен Авангардқа шабуыл жасаңыз
Dialogue: 0,0:15:19.68,0:15:22.73,Default,,0,0,0,,Дағдыны белсендіру. Қуат плюс 5000
Dialogue: 0,0:15:22.73,0:15:24.78,Default,,0,0,0,,Үміт үзбе
Dialogue: 0,0:15:24.78,0:15:28.02,Default,,0,0,0,,Мен жеңсем, бұл шайқас бітеді!
Dialogue: 0,0:15:28.02,0:15:30.32,Default,,0,0,0,,ｸｲﾝﾃｯﾄｳｫｰﾙ！
Dialogue: 0,0:15:37.01,0:15:40.03,Default,,0,0,0,,Синдо әлемі қалайды...
Dialogue: 0,0:15:40.03,0:15:42.68,Default,,0,0,0,,Қызықсыз нәрселер туралы ойламаңыз→
Dialogue: 0,0:15:42.68,0:15:46.09,Default,,0,0,0,,Жекпе-жектен ләззат алатын әлем...
Dialogue: 0,0:15:46.09,0:15:49.36,Default,,0,0,0,,Біз оны орындаймыз! Мен аман қалдым...
Dialogue: 0,0:15:49.36,0:15:51.36,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:15:51.36,0:15:53.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:39.02,0:17:41.35,Default,,0,0,0,,Неге...
Dialogue: 0,0:17:41.35,0:17:44.35,Default,,0,0,0,,Бұл... әлі де...
Dialogue: 0,0:17:47.43,0:17:49.71,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:17:49.71,0:17:52.03,Default,,0,0,0,,Қаз-саманың жалғыз белгісі...
Dialogue: 0,0:17:52.03,0:17:54.70,Default,,0,0,0,,Әрекет ету...
Dialogue: 0,0:17:54.70,0:17:58.70,Default,,0,0,0,,Ол кісі көрсеткен жекпе-жек менің сыйлығым!
Dialogue: 0,0:17:58.70,0:18:01.37,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:18:01.37,0:18:05.04,Default,,0,0,0,,Хахаха... хаха... ахахха!
Dialogue: 0,0:18:05.04,0:18:09.36,Default,,0,0,0,,О, түсіндім. Бұл қаншалықты ирониялық?
Dialogue: 0,0:18:09.36,0:18:12.70,Default,,0,0,0,,Жоқ, бұл тағдырдың шешімі.
Dialogue: 0,0:18:12.70,0:18:15.69,Default,,0,0,0,,Не болды? Бұл не!
Dialogue: 0,0:18:15.69,0:18:19.34,Default,,0,0,0,,Сіз Қаз-саманың сауытына айналасыз.
Dialogue: 0,0:18:19.34,0:18:22.04,Default,,0,0,0,,Қасума Тоқайрин
Dialogue: 0,0:18:24.70,0:18:27.75,Default,,0,0,0,,Не... айт...
Dialogue: 0,0:18:27.75,0:18:32.69,Default,,0,0,0,,Темераның мақсаты синдо болуы керек! О
Dialogue: 0,0:18:32.69,0:18:36.04,Default,,0,0,0,,Бірақ сіз оны өзіңіз көрсеттіңіз.
Dialogue: 0,0:18:36.04,0:18:39.09,Default,,0,0,0,,Сіз де жасай аласыз.
Dialogue: 0,0:18:39.09,0:18:41.01,Default,,0,0,0,,Касума мырза...
Dialogue: 0,0:18:41.01,0:18:43.03,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:18:43.03,0:18:45.70,Default,,0,0,0,,Бізге қажет →
Dialogue: 0,0:18:45.70,0:18:49.05,Default,,0,0,0,,Қаз-саманы қабылдауға жеткілікті күшті біреу.
Dialogue: 0,0:18:49.05,0:18:54.11,Default,,0,0,0,,Ерекшелік Шинду Куроно жан түрмесінде Реликс →
Dialogue: 0,0:18:54.11,0:18:59.03,Default,,0,0,0,,Бұл ыдысқа ең жақын нәрсе болды. Бірақ...
Dialogue: 0,0:18:59.03,0:19:04.02,Default,,0,0,0,,Реликтерден алынған барлық деректер осында қалды.
Dialogue: 0,0:19:04.02,0:19:09.34,Default,,0,0,0,,Бірлікпен байланысты үзу, Қаз-сама екеуіңді жалғайтын жол
Dialogue: 0,0:19:09.34,0:19:13.34,Default,,0,0,0,,Осылайша, Реликстің өзі өте кішкентай өлшемге дейін қысылған.
Dialogue: 0,0:19:13.34,0:19:16.75,Default,,0,0,0,,Жаңа ғана көрсеткен қасиеттеріңізбен →
Dialogue: 0,0:19:16.75,0:19:19.68,Default,,0,0,0,,Қаз-саманы ұстауға жеткілікті!
Dialogue: 0,0:19:19.68,0:19:24.67,Default,,0,0,0,,Соғысты жалғастырыңыз. Сіз жеңілген сәттен бастап →
Dialogue: 0,0:19:24.67,0:19:28.37,Default,,0,0,0,,Қаз-сама әкелген жойылу басталды.
Dialogue: 0,0:19:30.35,0:19:34.03,Default,,0,0,0,,Бұл шын мәнінде тағдырға байланысты жекпе-жек.
Dialogue: 0,0:19:34.03,0:19:36.37,Default,,0,0,0,,Сіз қаз боласыз ба➡
Dialogue: 0,0:19:36.37,0:19:40.19,Default,,0,0,0,,Сізді менің Крэй планетама қайта жібересіз бе?
Dialogue: 0,0:19:40.19,0:19:43.09,Default,,0,0,0,,Касума мырза...
Dialogue: 0,0:19:45.03,0:19:47.08,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:19:47.08,0:19:52.18,Default,,0,0,0,,Жүректі тарту рәсімі! Қадам ұрпақ!
Dialogue: 0,0:19:52.18,0:19:57.74,Default,,0,0,0,,ﾄﾞﾗｸﾞｽﾄﾗｲﾀﾞｰﾙｱｰﾄﾞ！
Dialogue: 0,0:19:57.74,0:20:00.86,Default,,0,0,0,,Жеңілмесем, жарайды деп ойлаймын! Қоңырау шал!
Dialogue: 0,0:20:00.86,0:20:05.68,Default,,0,0,0,,Шиндо екеуміз, ешкім қазға айналмайды!
Dialogue: 0,0:20:05.68,0:20:07.68,Default,,0,0,0,,ﾘｱﾌｧﾙ！
Dialogue: 0,0:20:07.68,0:20:13.59,Default,,0,0,0,,Мен бәріңді Крэй планетасына жіберемін!
Dialogue: 0,0:20:13.59,0:20:17.51,Default,,0,0,0,,Бар, Касума-сан! Есірткі жүргізуші Ардтың рәсімі!
Dialogue: 0,0:20:17.51,0:20:20.35,Default,,0,0,0,,Қолыңыздан екі картаны тастаңыз...
Dialogue: 0,0:20:20.35,0:20:23.38,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ6000 ｸﾘﾃｨｶﾙﾌﾟﾗｽ１➡
Dialogue: 0,0:20:23.38,0:20:25.42,Default,,0,0,0,,ﾄﾞﾗｲﾌﾞﾌﾟﾗｽ１！
Dialogue: 0,0:20:25.42,0:20:30.36,Default,,0,0,0,,Егер сіздің қолыңыздағы карталар 1 немесе одан жоғары дәрежелі болса, бұл шабуылды қорғау мүмкін емес!
Dialogue: 0,0:20:30.36,0:20:32.84,Default,,0,0,0,,Жоғал!
Dialogue: 0,0:20:32.84,0:20:35.86,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ
Dialogue: 0,0:20:35.86,0:20:39.51,Default,,0,0,0,,Жарату машинасы Құдайдың өлімі Хаген!
Dialogue: 0,0:20:39.51,0:20:41.53,Default,,0,0,0,,Қосымша күзет
Dialogue: 0,0:20:41.53,0:20:44.52,Default,,0,0,0,,Төрттік жетек? Мұның бәрі триггерлер болса➡
Dialogue: 0,0:20:44.52,0:20:49.49,Default,,0,0,0,,Бұл күзетші бұзып өтеді. Касума мырза...
Dialogue: 0,0:20:49.49,0:20:53.01,Default,,0,0,0,,Кешіріңіз. Барайық!
Dialogue: 0,0:20:53.01,0:20:55.35,Default,,0,0,0,,Бірінші тексеру. 1 дана
Dialogue: 0,0:20:55.35,0:20:57.85,Default,,0,0,0,,Екінші тексеру. 2 дана
Dialogue: 0,0:20:57.85,0:20:59.83,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ
Dialogue: 0,0:20:59.83,0:21:01.85,Default,,0,0,0,,3 дана
Dialogue: 0,0:21:01.85,0:21:04.15,Default,,0,0,0,,ﾌｧｲﾅﾙﾁｪｯｸ！
Dialogue: 0,0:21:12.00,0:21:15.45,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:21:15.45,0:21:19.50,Default,,0,0,0,,Қашан қарасаң да, бар үміт үмітсіздікке айналады➡
Dialogue: 0,0:21:19.50,0:21:23.07,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:21:23.07,0:21:26.84,Default,,0,0,0,,Әлі жоқ. Әлі біткен жоқ!
Dialogue: 0,0:21:26.84,0:21:31.52,Default,,0,0,0,,Хехе... Ахахха!
Dialogue: 0,0:21:31.52,0:21:33.70,Default,,0,0,0,,Мен бүкіл болашағымды соған қоямын➡
Dialogue: 0,0:21:33.70,0:21:39.10,Default,,0,0,0,,Терең қуысты сынау, Батырға тәтті түңілу
Dialogue: 0,0:21:41.69,0:21:47.52,Default,,0,0,0,,Менің болашағымды жеп, оны көрсет! Stargate Zero Dragon!
Dialogue: 0,0:21:47.52,0:21:50.02,Default,,0,0,0,,ｱﾙﾃｨﾒｯﾄ･ｽﾄﾗｲﾄﾞ！
Dialogue: 0,0:21:50.02,0:21:54.02,Default,,0,0,0,,Жұлдызды жерлеу нөлдік айдаһар Старк!
Dialogue: 0,0:21:57.51,0:22:01.85,Default,,0,0,0,,Бұл Жұлдыздар қақпасының нөлдік айдаһары
Dialogue: 0,0:22:01.85,0:22:05.37,Default,,0,0,0,,Бір кездері менің алдымда көптеген жауынгерлер тұрды➡
Dialogue: 0,0:22:05.37,0:22:10.02,Default,,0,0,0,,Барлығы үміт артып, шайқасқа шықты.
Dialogue: 0,0:22:10.02,0:22:13.17,Default,,0,0,0,,Соның бәрін оратын менмін
Dialogue: 0,0:22:13.17,0:22:15.51,Default,,0,0,0,,Барлық үміттер орындалады➡
Dialogue: 0,0:22:15.51,0:22:19.35,Default,,0,0,0,,Үмітсіздіктің айқайы мен мұңы➡
Dialogue: 0,0:22:19.35,0:22:22.52,Default,,0,0,0,,Менің ең үлкен қуанышым!
Dialogue: 0,0:22:22.52,0:22:27.02,Default,,0,0,0,,Қарға шеберлігі құлау аймағына орналастырылды
Dialogue: 0,0:22:27.02,0:22:31.12,Default,,0,0,0,,Қолыңыздан бір картаны таңдап, оны құлыптап, сол жерге қойыңыз.
Dialogue: 0,0:22:34.70,0:22:36.85,Default,,0,0,0,,Шақыру дағдыларын белсендіру
Dialogue: 0,0:22:36.85,0:22:39.52,Default,,0,0,0,,Морфессаны құлыптау
Dialogue: 0,0:22:39.52,0:22:41.84,Default,,0,0,0,,Қосымша қоңырау
Dialogue: 0,0:22:41.84,0:22:46.17,Default,,0,0,0,,Темірдің шабуылы. (Касума) Күзет!
Dialogue: 0,0:22:46.17,0:22:50.18,Default,,0,0,0,,Авангардқа нөлдік айдаһар Старкпен шабуыл жасаңыз
Dialogue: 0,0:22:50.18,0:22:53.56,Default,,0,0,0,,Старк дағдылары Drive минус 2
Dialogue: 0,0:22:53.56,0:22:57.02,Default,,0,0,0,,Бұл бөлімше 3 рет шабуыл жасай алады.
Dialogue: 0,0:22:57.02,0:23:00.86,Default,,0,0,0,,Үш рет шабуыл жасалды!? Мен бас тартуым керек пе?
Dialogue: 0,0:23:00.86,0:23:03.41,Default,,0,0,0,,Ол маған айтты!
Dialogue: 0,0:23:03.41,0:23:08.01,Default,,0,0,0,,ﾌｧｰｽﾄｱﾀｯｸ
Dialogue: 0,0:23:08.01,0:23:11.68,Default,,0,0,0,,Соңына дейін шыдасаң, болашағың сонда ашылады!
Dialogue: 0,0:23:11.68,0:23:13.87,Default,,0,0,0,,ｾｶﾝﾄﾞｱﾀｯｸ
Dialogue: 0,0:23:13.87,0:23:20.06,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:20.06,0:23:22.69,Default,,0,0,0,,Мен ант бердім!
Dialogue: 0,0:23:22.69,0:23:25.18,Default,,0,0,0,,((Мен жақын арада күрескім келеді.
Dialogue: 0,0:23:25.18,0:23:30.70,Default,,0,0,0,,Ешқандай қажетсіз ойларсыз басыңызды босатыңыз))
Dialogue: 0,0:23:30.70,0:23:34.36,Default,,0,0,0,,Мен сіз шайқастан ләззат алатын әлемді қайтарамын!
Dialogue: 0,0:23:34.36,0:23:36.36,Default,,0,0,0,,Оған дейін➡
Dialogue: 0,0:23:36.36,0:23:38.36,Default,,0,0,0,,Ешқашан берілме!
Dialogue: 0,0:23:41.03,0:23:43.01,Default,,0,0,0,,ﾌｧｲﾅﾙｱﾀｯｸ
Dialogue: 0,0:23:43.01,0:23:45.35,Default,,0,0,0,,Касума мырза!
Dialogue: 0,0:23:45.35,0:23:48.67,Default,,0,0,0,,Мен... Синдо маған не берді➡
Dialogue: 0,0:23:48.67,0:23:51.69,Default,,0,0,0,,Мен әлі ештеңе алған жоқпын.
Dialogue: 0,0:23:51.69,0:23:53.69,Default,,0,0,0,,Мен бұлай жеңілуге шыдай алмаймын➡
Dialogue: 0,0:23:53.69,0:23:55.69,Default,,0,0,0,,Мен бармаймын!
Dialogue: 0,0:24:00.35,0:24:02.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:24:08.02,0:24:12.69,Default,,0,0,0,,Әлі жоқ. Мен... жеңілмеймін.
Dialogue: 0,0:24:12.69,0:24:15.09,Default,,0,0,0,,Синдо мақсаты үшін...
Dialogue: 0,0:24:20.33,0:24:22.35,Default,,0,0,0,,Касума мырза...
Dialogue: 0,0:24:22.35,0:24:25.05,Default,,0,0,0,,Дүние, үндеме!
Dialogue: 0,0:24:35.33,0:24:38.00,Default,,0,0,0,,Бұл...
Dialogue: 0,0:24:38.00,0:24:40.02,Default,,0,0,0,,ｾﾞﾛｽﾄﾞﾗｺﾞﾝ
Dialogue: 0,0:24:40.02,0:24:45.36,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:45.36,0:24:48.73,Default,,0,0,0,,Ақырында, бұл жолы...
Dialogue: 0,0:24:48.73,0:24:51.75,Default,,0,0,0,,Көптен күткен тілегіміз орындалады.
Dialogue: 0,0:24:51.75,0:24:55.70,Default,,0,0,0,,Қаздар, қиратушы айдаһар құдайы түседі!
Dialogue: 0,0:24:55.70,0:25:01.36,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:01.36,0:25:05.05,Default,,0,0,0,,Кеңістік-уақыттың керемет бұрмалануын тексеріңіз!
Dialogue: 0,0:25:05.05,0:25:08.73,Default,,0,0,0,,Бұл құбылыстың себебі неде?
Dialogue: 0,0:25:08.73,0:25:25.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:25.33,0:25:27.20,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:25:27.20,0:25:29.22,Default,,0,0,0,,Менің денемді алсаң да➡
Dialogue: 0,0:25:29.22,0:25:33.37,Default,,0,0,0,,Сіз оны ешқашан жеңе алмайсыз!
Dialogue: 0,0:25:33.37,0:25:39.38,Default,,0,0,0,,Әй, солай емес пе? Бұл оңай жеңіс...
Dialogue: 0,0:25:39.38,0:25:41.37,Default,,0,0,0,,ｸﾛﾉ…
Dialogue: 0,0:25:41.37,0:25:43.57,Default,,0,0,0,,А... Касума?
Dialogue: 0,0:25:43.57,0:25:45.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:47.54,0:25:49.54,Default,,0,0,0,,Бұл не!?
Dialogue: 0,0:25:55.71,0:25:57.70,Default,,0,0,0,,Күте тұрыңыз! Синдо-кун!
Dialogue: 0,0:25:57.70,0:26:00.13,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:26:00.13,0:26:02.13,Default,,0,0,0,,ｶｽﾞﾏ！
Dialogue: 0,0:26:05.06,0:26:07.06,Default,,0,0,0,,ｶｽﾞﾏ！
Dialogue: 0,0:26:09.03,0:26:11.45,Default,,0,0,0,,ﾀｲﾖｳ！
Dialogue: 0,0:26:11.45,0:26:16.05,Default,,0,0,0,,Сәттілік! Жақсысың ба, Таййо?
Dialogue: 0,0:26:16.05,0:26:19.35,Default,,0,0,0,,Куроно мырза... Касума мырза...
Dialogue: 0,0:26:19.35,0:26:34.05,Default,,0,0,0,,♪♪～
Dialogue: 0,0:30:34.01,0:30:36.51,Default,,0,0,0,,Ғажайып әуендер →
Dialogue: 0,0:30:36.51,0:30:40.05,Default,,0,0,0,,Гипер негативті тұлғаға айналу →
Dialogue: 0,0:30:40.05,0:30:44.02,Default,,0,0,0,,Жын патшасы жасаған құбыжық.
Dialogue: 0,0:30:44.02,0:30:48.71,Default,,0,0,0,,Қаһарлы жауларды бірінен соң бірі баптадым.
Dialogue: 0,0:30:48.71,0:30:51.71,Default,,0,0,0,,Бес кристалл әшекей бірге →
Dialogue: 0,0:30:51.71,0:30:56.51,Default,,0,0,0,,Miracle Tunes – соңғы режимді алған түйреуіш.
Dialogue: 0,0:30:56.51,0:31:00.42,Default,,0,0,0,,Ең соңында қалған дыбыстар →
Dialogue: 0,0:31:01.92,0:31:07.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory